  <book code="MAT" style="id">EN_MGLT mtq_Muong_ltr Tue Apr 23 2024 11:06:00 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Matthew</para>
  <para style="toc1">Phúc Âm Ma-thi-ơ</para>
  <para style="toc2">Ma-thi-ơ</para>
  <para style="toc3">Mat</para>
  <para style="mt">Ma-thi-ơ</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Pảng gia phả của Chùa Cừu Thề Giê-xu, xôn con Đa-vít, xôn con Áp-ra-ham: <verse eid="MAT 1:1" /><verse number="2" style="v" sid="MAT 1:2" />Áp-ra-ham teẻ Y-sác; Y-sác teẻ Gia-cốp; Gia-cốp teẻ Giu-đa ôộng ái ùn của ôông. <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />Giu-đa pởi Ta-ma teẻ Phê-rết ôộng Xê-ra; Phê-rết teẻ Hết-rôn; Hết-rôn teẻ A-ram; <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />A-ram teẻ A-mi-na-đáp; A-mi-na-đáp teẻ Na-ách-son; Na-ách-son teẻ Sanh-môn. <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />Sanh-môn pởi Ra-háp teẻ Bô-ô. Bô-ô pởi Ru-tơ teẻ Ô-bết. Ô-bết teẻ Gie-sê, <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />Gie-sê teẻ vua Đa-vít, Đa-vít pởi du của U-ri teẻ Sa-lô-môn.<verse eid="MAT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 1:7" />Sa-lô-môn teẻ Rô-bô-am; Rô-bô-am teẻ A-bi-gia; A-bi-gia teẻ A-sa; <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />A-sa teẻ Giô-sa-phát; Giô-sa-phát teẻ Giô-ram; Giô-ram teẻ Ô-xia. <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Ô-xia teẻ Giô-tam; Giô-tam teẻ A-cha; A-cha teẻ Ê-xê-chia; <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Ê-xê-chia teẻ Ma-na-se; Ma-na-se teẻ A-môn; A-môn teẻ Giô-si-a. <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Giô-si-a teẻ Giê-cô-nia ôộng ái ùn của nọ pao cuộc lưu đáy qua Ba-by-lôn.<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />Mân khâu cuộc lưu đáy qua Ba-by-lôn, Giê-cô-nia teẻ Sa-la-thi-ên. Sa-la-thi-ên teẻ Xô-rô-ba-bên; <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />Xô-rô-ba-bên teẻ A-bi-út; A-bi-út teẻ Ê-li-a-kim; Ê-li-a-kim teẻ A-xô. <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />A-xô teẻ Sa-đốc; Sa-đốc teẻ A-chim; A-chim teẻ Ê-li-út. <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Ê-li-út teẻ Ê-lê-a-xa; Ê-lê-a-xa teẻ Ma-than; Ma-than teẻ Gia-cốp. <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />Gia-cốp teẻ Giô-sép, chầu của Ma-ri, mà pởi mú, Chùa Giê-xu, Tầng àn hôổc là Chùa Cừu Thề, àn teẻ xa. <verse eid="MAT 1:16" /><verse number="17" style="v" sid="MAT 1:17" />Như xí, tẩt cả cảc thề hế pở Áp-ra-ham tềng Đa-vít là mưới pồn thề hế, pở Đa-vít tềng caá lưu đáy qua Ba-by-lôn là mưới pồn thề hế, ôộng pở cuộc lưu đáy qua Ba-by-lôn tềng Chùa Cừu Thề là mưới pồn thề hế.<verse eid="MAT 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Sứ giàng sinh của Chùa Cừu Thề Giê-xu là như xí ní: Khới Ma-ri, mế Ngái, tà đình hôn côống Giô-sép, mơi tlưởc khới maáng ăn ở côống phố, vaá pí phảt hiến cò chửa pởi Chùa Thành Linh. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Cón Giô-sép, chầu vaá, là moón côông chình, ôộng ví chăng moành côông khai pêu xầu vaá, rêng ái pú âm thấm ly hôn vaá. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />Mơi khới ái tang suy nghỉ vến cảc việc rì, xì hảy hẩu rạ, thiên sừ của Chùa hiến xa côống ái tloong chiêm pao, pảo: “Giô-sép, xôn con Đa-vít, ái má rưởi lế Ma-ri mấn du, ví con rẻt àn cò chửa tloong vaá rì là pởi Chùa Thành Linh. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Vaá rì sẻ teẻ mộch con từa, ôộng ái sẻ tệch xên con là Giê-xu, ví con rì sẻ cừu dân mếng xa khỏi xối lổi maáng." <verse eid="MAT 1:21" /><verse number="22" style="v" sid="MAT 1:22" />Tẩt cả cảc việc ní xảy xa tể àn ừng nghiếm cảc tiếu tà àn Chùa phàn qua tầng tiên tli, xí ní:<verse eid="MAT 1:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="MAT 1:23" />"Hảy hẩu rạ, trinh nử sẻ cò chửa ôộng teẻ mộch con từa, ôộng máng sẻ hôổc danh Ngái là Em-ma-nu-ên" - àn dịch là "Chùa Tlới ở côống tán ha."<verse eid="MAT 1:23" /></para>
  <para style="b" />
  <para style="m">
    <verse number="24" style="v" sid="MAT 1:24" />Rối khâu khới àn tành thửc khỏi cơn tảy, Giô-sép tà mấn chôồng như thiên sừ của Chùa tà truyến táy ôộng lế vaá rì mấn du mếng. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Mơi ái chăng ăn ở côống vaá rì cho tềng khới vaá teẻ mộch con từa. Rối ái hôổc xên con là Giê-xu.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Khâu khới Chùa Giê-xu tà àn teẻ xa ở Bết-lê-hem púng Giu-đê tloong tới vua Hê-rốt, xì hảy hẩu rạ, cò cảc hoọc giả pở táng tôông tềng ở Giê-ru-sa-lem, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />poi xí ní: “Tầng tà àn teẻ xa là Vua moón Do Thài ở noó? Ví tán tôi tà kỉa ngôi khao của Ngái ở táng tôông ôộng tềng tể tôn thớ Ngái.” <verse eid="MAT 2:2" /><verse number="3" style="v" sid="MAT 2:3" />Mơi khâu khới măng tiếu rì, vua Hê-rốt pí bồi rồi, mân cả thánh Giê-ru-sa-lem yý như ôông. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Rối khâu khới tập tlung tẩt cả cảc thấy tề lể cả ôộng cảc thấy táy luật tloong tán dân, ôông poi maáng: "Chùa Cừu Thề àn teẻ xa ở noó?" <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Maáng thưa côống vua: “Ở Bết-lê-hem púng Giu-đê, ví tà àn viểt như xí qua tầng tiên tli,<verse eid="MAT 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MAT 2:6" />'Mơi Bết-lê-hem, tẩt Giu-đa,</para>
  <para style="q" vid="MAT 2:6">dâu chăng phải là énh nhẩt tloong tán lảnh đáo của Giu-đa,</para>
  <para style="q" vid="MAT 2:6">ví pở dâu sẻ xa mộch Tầng cai tlí</para>
  <para style="q" vid="MAT 2:6">là Tầng sẻ chăn dân Y-sơ-ra-ên, dân Ho.'”<verse eid="MAT 2:6" /></para>
  <para style="b" />
  <para style="m">
    <verse number="7" style="v" sid="MAT 2:7" />Caá rì, khâu khới pì mật hôổc cảc hoọc giả tềng, Hê-rốt poi maáng thới điểm xuẩt hiến của ngôi khao. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Khới tà tể maáng ti tềng Bết-lê-hem, ôông pảo: "Khâu khới ti, cảc ôông hảy poi cho kỷ vến từa rẻt, rối khới cảc ôông tà xím kỉa, hảy pào cho ho tể ho yý tềng tôn thớ Ngái." <verse eid="MAT 2:8" /><verse number="9" style="v" sid="MAT 2:9" />Khâu khới tà măng vua, maáng àn lêng khà, ôộng hảy hẩu rạ, ngôi khao mà maáng tà hẩu kỉa ở táng tôông ti tlưởc maáng cho tềng khới tà tềng xì reé từng yên tlêng tược con rẻt ở. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Khới tà hẩu kỉa ngôi khao, maáng phần khởi tloong niếm phui rẩt nhiếu. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Khâu khới pao tloong nhá, maáng kỉa từa rẻt côống Ma-ri, mế Ngái. Rối caá tà quý xuồng xì maáng thớ phướng Ngái, ôộng khới tà vở bầu vật của mếng xa, maáng dơng cho Ngái cảc lể vật: váng, nhủ hương mân nhứa hơm. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Ôộng ví tà àn kẻnh pào má quay tlở lái côống Hê-rốt tloong mộch chiêm pao, maáng vến nưởc mếng pắng khà khảc.<verse eid="MAT 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Caá maáng tà ti rối, xì hảy hẩu rạ, mộch thiên sừ của Chùa hiến xa côống Giô-sép pởi mộch chiêm pao, phàn xí ní: "Khâu khới chể dấn, hảy tom con rẻt côống mế Ngái rối tlồn qua Ai Cập, hảy ở lái rì cho tềng khới ho pảo ái, ví Hê-rốt pú xím con rẻt tể giểt Ngái ti." <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Khới tà chể dấn rối, ôông tom con rẻt côống mế Ngái tlồn qua Ai Câp pao pan têm, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />ôộng ôông ở lái rì cho tềng khới Hê-rốt chểt, rì là tể àn ừng nghiếm tiếu tà àn phàn pởi Chùa qua tầng tiên tli xí ní: "Ho tà hôổc con Ho xa khỏi Ai Cập."<verse eid="MAT 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Caá rì, khới kỉa là mếng tà pí cảc hoọc giả chề giểu, Hê-rốt rẩt tửc giấn, khâu khới truyến tin ti, ôông giểt chểt tẩt cả cảc con rẻt từa pở han xuổi tlở xuồng ở Bết-lê-hem ôộng tloong hểt cả tẩt của púng rì, xeo như thới điểm mà ôông ha tà poi pở cảc hoọc giả. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Như xí là àn ừng nghiếm tiếu tà àn phàn qua tiên tli Giê-rê-mi, xí ní:<verse eid="MAT 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="MAT 2:18" />“Mộch xiềng rố àn măng kỉa tloong thánh Ra-ma,</para>
  <para style="q" vid="MAT 2:18">xiềng rên rỉ ôộng than thở thảm thiểt,</para>
  <para style="q" vid="MAT 2:18">Ra-chên nhám cho cảc con mếng,</para>
  <para style="q" vid="MAT 2:18">ôộng nọ chăng chíu àn yên ủi, ví phè chăng cón nửa."<verse eid="MAT 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Khới Hê-rốt tà chểt, xì hảy hẩu rạ, mộch thiên sừ của Chùa hiến xa côống Giô-sép tloong mộch chiêm pao ở Ai Cập, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />pảo xí ní: “Khới tà chể dấn, ái hảy tom con rẻt ôộng mế Ngái rối ti tềng tẩt Y-sơ-ra-ên, ví cảc moón xím giểt maáng khôồng của con rẻt tà chểt." <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />Ôộng khâu khới chể dấn, ôông tom con rẻt côống mế Ngái, rối pao tloong tẩt Y-sơ-ra-ên. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Mơi, khâu khới măng là A-chê-la-u tang cai tlí tlêng púng Giu-đê thay cho Hê-rốt, pồ mếng, ôông rưởi ti tềng rì. Mơi khới tà àn kẻnh pào qua chiêm pao, ôông ti vến púng Ga-li-lê, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />ôộng khới tà tềng rì rối, ôông khôồng tloong mộch thánh àn hôổc là Na-xa-rét, tể àn ừng nghiếm tiếu tà àn phàn qua cảc tiên tli, là Ngái sẻ àn hôổc là moón Na-xa-rét.<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Tloong cảc ngáy rì, Giăng Báp-tít tềng rao giảng tloong hoang mạc púng Giu-đê, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />xí ní: “Hảy ăn năn, ví vương quổc thiên đáng tà khênh.” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Ví ní là moón tà àn vé tềng pởi tiên tli Ê-sai, xí ní:</para>
  <para style="q" vid="MAT 3:3">“Cò xiềng moón rố naáy tloong hoang mạc:</para>
  <para style="q" vid="MAT 3:3">'Hảy roón khẳn khà của Chùa,</para>
  <para style="q" vid="MAT 3:3">hảy mấn pắng phẳng cảc táng Ngái'.”<verse eid="MAT 3:3" /></para>
  <para style="b" />
  <para style="m">
    <verse number="4" style="v" sid="MAT 3:4" />Giăng ní mặc tố pở lôông lạc đá, teo khái xẳt cố rôồng pắng ta quenh hông, cón tố ăn của ôông là chô chồ ôộng mật oong rứng. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Rối moón thánh Giê-ru-sa-lem, cả púng Giu-đê ôộng tẩt cả púng xung quenh khôông Giô-đanh tềng côống ôông, <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />ôộng khới tang xưng xối mếng, maáng àn ôông mấn báp-têm tìn khôông Giô-đanh. <verse eid="MAT 3:6" /><verse number="7" style="v" sid="MAT 3:7" />Khâu khới hẩu kỉa nhiếu moón Pha-ri-si ôộng Sa-đu-sê tềng ví phẻp báp-têm của mếng, ôông vé côống maáng: "Tán xôn con của xành tôộc kia! Ôông ay tà kẻnh pào tán pay chắn tlồn khỏi cơn phẩn nố pú tềng? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Xí rêng, hảy kểt tlày xừng đàng côống loóng ăn năn. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Ôộng cảc ôông yý má tưởng mà pảo phố: 'Tán ha cò tổ tiên Áp-ra-ham.' Ví tôi vé côống cảc ôông là Thiên Chùa cò thể mấn rêng xôn con cho Áp-ra-ham pở cảc hón phú ní. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Mơi cày ríu tà àn tệch khênh côổc câl rối. Cho rêng, tẩt cả cảc câl nều chăng xa tlày tổt xì pí chạch xuồng ôộng nèm pao lửa. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />Tôi mấn báp-tem vến sứ ăn năn cho ái ới ùn pắng rảc. Mơi Tầng tềng khâu tôi cò quyến năng hơn tôi, vến Tầng rì xì tôi là moón chăng xừng đàng tể xảch giáy của Ngái. Ngái sẻ mấn báp-têm cho ái ới ùn pắng Chùa Thành Linh ôộng pắng lửa; <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />cày chỉa của Ngái ở tloong xay Ngái, rối Ngái sẻ rê xật quang sân tập loó mếng ôộng gom loó của Ngái pao kho. Mơi Ngái sẻ tổch hểt rơm raá pắng lửa chăng caá noó dập xẳt àn."<verse eid="MAT 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Caá rì, Chùa Giê-xu ti pở púng Ga-li-lê tềng khôông Giô-đanh, tược của Giăng, tể àn ôông mấn báp-têm cho. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Mơi Giăng cừ kiên quyểt ngăn cản Ngái, xí ní: "Tôi mời cò nhu cấu àn Ngái mấn báp-têm cho, xí mà Ngái lái tềng côống tôi à?" <verse eid="MAT 3:14" /><verse number="15" style="v" sid="MAT 3:15" />Mơi khới tlả lới lái, Chùa Giê-xu vé côống ôông: "Caá ní, hảy mấn xí ti, ví như xí là phú hợp đồi côống tán ha tể mấn xoong tẩt cả việc côông chình." Rối Ngái tể ôông mấn. <verse eid="MAT 3:15" /><verse number="16" style="v" sid="MAT 3:16" />Caá ní, khâu khới mấn báp-têm rối, Chùa Giê-xu liến lêng khỏi rảc, ôộng hẩu rạ, cảc tấng tlới àn vở xa cho Ngái, rối Ngái hẩu kỉa Thành Linh của Thiên Chùa giàng xuồng chôồng như chim cú cu, tâấu tlêng Ngái, <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />ôộng hẩu rạ, mộch xiềng phàn pở cảc tấng tlới xí ní: "Ní là Con yêu dầu của Ho. Ho phưa loóng vến Con rì."<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Rối Chùa Giê-xu àn tưa pao hoang mạc pởi Thành Linh tể chíu ma quỷ càm dổ. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Khâu rì, caá tà kiêng ăn pồn mươi ngáy mân pồn mươi têm, xì Ngái tòi. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Khâu khới tềng khênh, xên càm dổ vé côống Ngái: "Nều ôông là Con Thiên Chùa, hảy xa lếnh tể cảc hón phú ní tlở rêng pènh ti." <verse eid="MAT 4:3" /><verse number="4" style="v" sid="MAT 4:4" />Mơi tlả lới lái, Ngái vé: "Cò lới àn chẻp: 'Con moón sẻ khôồng chăng phải pởi pènh mà rôi, mơi là pởi tẩt cả lới phảt xa pở ménh Thiên Chùa." <verse eid="MAT 4:4" /><verse number="5" style="v" sid="MAT 4:5" />Rối ma quỷ tom Ngái pao tloong thánh thành, cho Ngái từng ở tlêng tược cao nhẩt của tến thớ, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />ôộng vé côống Ngái: “Nều ôông là Con Chùa Tlới, hảy quăng mếng xuồng ti, ví Cò lới àn chẻp, xí ní:</para>
  <para style="q" vid="MAT 4:6">'Ngái sẻ truyến lếnh vến con cho cảc thiên sừ Ngái,'</para>
  <para style="p" vid="MAT 4:6">ôộng:</para>
  <para style="q" vid="MAT 4:6">'Maáng sẻ nơng con ở tlêng xay maáng,</para>
  <para style="q" vid="MAT 4:6">chăng là chó con cò thể vẩp pao hón phú'.”<verse eid="MAT 4:6" /></para>
  <para style="b" />
  <para style="m">
    <verse number="7" style="v" sid="MAT 4:7" />Chùa Giê-xu tlả lới lái reé: “Mặt khảc, cò lới àn chẻp: 'Con sẻ chăng thử Chùa, là Thiên Chùa của con.'" <verse eid="MAT 4:7" /><verse number="8" style="v" sid="MAT 4:8" />Mộch lấn nửa, ma quỷ tom Ngái lêng mộch ngón nùi rẩt cao mân cho Ngái hẩu tẩt cả cảc nưởc tlêng thề gian côống sứ huy hoáng của phè. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Ôộng reé vé côống Ngái: "Tôi sẻ cho ôông tẩt cả cảc xừ ní, nều ôông thớ láy tôi, pắng cảch khẩp mếng xuồng." <verse eid="MAT 4:9" /><verse number="10" style="v" sid="MAT 4:10" />Caá rì, Chùa Giê-xu phàn côống reé: "Sa-tan, hảy piền ti! Ví cò lới àn chẻp:</para>
  <para style="q" vid="MAT 4:10">‘Con sẻ thớ phướng Chùa, là Thiên Chùa của con, ôộng con sẻ phục vuú chỉ mộch mếng Ngái.'"<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Rối ma quỷ ti khỏi Ngái, ôộng hẩu rạ, cảc thiên sừ tềng ôộng pẳt tấu phục vuú Ngái.<verse eid="MAT 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Caá ní, khâu khới măng là Giăng tà pí pẳt, Ngái ti vến púng Ga-li-lê. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Khới tà ti khỏi Na-xa-rét, Ngái tềng khôồng ở thánh Ca-bê-na-um khênh piển, xuộc púng Sa-bu-lôn mân Nép-ta-li, <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />tể àn ừng nghiếm tiếu tà àn phàn qua tiên tli Ê-sai, xí ní:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“Tẩt Sa-bu-lôn ôộng tẩt Nép-ta-li,</para>
  <para style="q" vid="MAT 4:15">cày khà xa hường piển, táng kia khôông Giô-đanh,</para>
  <para style="q" vid="MAT 4:15">nghỉa là púng Ga-li-lê của cảc moón chăng phải Do Thài —<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />moón ngối tloong poòng xồn tà hẩu kỉa ènh tlàng náy, ôộng côống cảc moón ngối tloong púng tẩt ôộng poòng cày chểt, xì ènh tlàng tà chiều tlàng tlêng maáng."<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Pở caá rì, Chùa Giê-xu pẳt tấu rao giảng ôộng phàn: "Hảy ăn năn, ví vương quổc thiên đáng tà tềng khênh." <verse eid="MAT 4:17" /><verse number="18" style="v" sid="MAT 4:18" />Caá ní, khới tang ti pố khênh piển Ga-li-lê, Ngái hẩu kỉa han ái ùn, Si-môn, àn hôổc là Phi-e-rơ, ôộng Anh-rê, ùn ôông rì, tang tlởi lài xuồng piển ví maáng mấn nghế tành cà. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Ôộng Ngái pảo maáng: "Hảy ti xeo thấy, xì thấy sẻ mấn ái ùn rêng cảc xay tành lài moón." <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Ngay caá rì, khởi tà lảc lài mếng, maáng xeo Ngái. <verse eid="MAT 4:20" /><verse number="21" style="v" sid="MAT 4:21" />Khâu khới pở rì ti tiểp, Ngái kỉa han ái ùn khảc, là Gia-cơ con của Xê-bê-đê, ôộng Giăng, ùn ôông, tloong thuyến côống ôộng Xê-bê-đê, pồ của maáng, tang pà lài mếng ôộng Ngái hôổc maáng. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Rối ngay caá rì, khới tà lảc thuyến ôộng pồ mếng, maáng xeo Ngái.<verse eid="MAT 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Ôộng Ngái ti tược ní tược kia tloong khồm púng Ga-li-lê, táy dổ tloong cảc nhá hối của tán dân, rao giảng Tin Lénh vến vương quổc, yý chửa lénh tẩt cả pếng tật mân tẩt cả tâu ồm tloong tán dân. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Tin đốn vến Ngái vang xa cho tềng khồm cả púng Sy-ri, ôộng maáng tom tềng cho Ngái tẩt cả moón cò pếng, pí vẳc phải nhiếu kiểu pếng mân tâu nhửc khảc phố, pí quỷ ềm, tôống kinh, pái liệt ôộng Ngái chửa lénh cho maáng. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Cảc đoán dân khòm ti xeo Ngái pở Ga-li-lê, Đê-ca-bô-lơ, Giê-ru-sa-lem, Giu-đê ôộng táng kia khôông Giô-đanh.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Caá ní, khâu khới kỉa đoán dân, Ngái ti lêng tlêng nùi, ôộng khới Ngái tà ngối xuồng, cảc môn tố Ngái tềng côống Ngái. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Ngái vở méng taáy dổ maáng, xí ní:<verse eid="MAT 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MAT 5:3" />“Phưởc quà là cảc moón nghéo khò tloong tâm linh,</para>
  <para style="q2" vid="MAT 5:3">ví vương quổc thiên đáng là của maáng.<verse eid="MAT 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MAT 5:4" />Phưởc quà là cảc moón than nhám, ví maáng sẻ àn an ủi.<verse eid="MAT 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MAT 5:5" />Phưởc quà là cảc moón hiến lénh,</para>
  <para style="q2" vid="MAT 5:5">ví maáng sẻ hưởng àn tẩt.<verse eid="MAT 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MAT 5:6" />Phưởc quà là cảc moón tòi ôộng khảt sứ côông chình,</para>
  <para style="q2" vid="MAT 5:6">ví maáng sẻ àn thoả loóng.<verse eid="MAT 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MAT 5:7" />Phưởc quà cho cảc moón hay xương xỏt,</para>
  <para style="q2" vid="MAT 5:7">ví maáng sẻ àn xương xỏt.<verse eid="MAT 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MAT 5:8" />Phưởc quà là cảc moón thanh quang tloong tầm loóng,</para>
  <para style="q2" vid="MAT 5:8">ví maáng sẻ hẩu kỉa Chùa Tlới.<verse eid="MAT 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MAT 5:9" />Phưởc quà là cảc moón giải hoá,</para>
  <para style="q2" vid="MAT 5:9">ví maáng sẻ àn hôổc là cảc con của Chùa Tlới.<verse eid="MAT 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MAT 5:10" />Phưởc quà là cảc moón pí ngược đải pởi ví sứ côông chình,</para>
  <para style="q2" vid="MAT 5:10">ví vương quổc thiên đáng là của maáng.<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />Ái ới ùn cò phưởc khới maáng sỉ nhục ái ới ùn, côống ngược đải ôộng vé tẩt cả tiếu ảc vu khồng chồng lái ái ới ùn ví pởi thấy. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Hảy phui mứng ôộng sung sường, ví phấn thưởng của ái ới ùn rẩt náy tlêng thiên đáng, ví maáng tà ngược đải cảc tiên tli tlưởc ái ới ùn chôồng như xí.<verse eid="MAT 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />Ái ới ùn là vòi của tẩt. Mơi nều vòi pí vẩt chằm, xì reé sẻ àn mấn cho chằm pắng cày chi? Tlứ xa pí nèm xa vái tể pí giẩm tạp pởi maáng, xì reé chăng cò ỉch cho tiếu chi nửa. <verse eid="MAT 5:13" /><verse number="14" style="v" sid="MAT 5:14" />Ái ới ùn là ènh tlàng của thề giời, Mộch thánh phồ ở tlêng đỉnh tốn xì chăng thể pí che khuẩt àn. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Yý chăng ôông ay tổch tén ôộng tệch reé tìn cày thúng, mơi là tlêng chó tén, ôộng reé chiều tlàng cho tẩt cả moón tloong nhá. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Chôồng như xí, ènh tlàng của ái ới ùn hảy chiều xa tlưởc mặt maáng, xí noó cho maáng cò thể kỉa cảc việc lénh của ái ới ùn mân ngơới khen Cha của ái ới ùn tlêng thiên đáng.<verse eid="MAT 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />Má nghỉ là thấy tà tềng tể phà huỷ luật phảp hay cảc lới tiên tli. Thấy tà tềng chăng phải tể phà huỷ, mơi là tể mấn cho hoán thánh. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Ví xật sứ, thấy vé côống ái ới ùn, cho tềng khới tlới ôộng tẩt qua ti, xì mộch chầm hoặc mộch nẻt tloong luật phảp chẳc chằn chăng qua ti cho tềng caá noó tẩt cả àn hoán thánh. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Pởi xí, nều ôông ay huỷ ti mộch tloong cảc tiếu énh nhẩt của cảc tiếu răn ní ôộng táy maáng như xí xì sẻ pí hôổc là énh nhẩt tloong vương quổc thiên đáng. Mơi moón noó mấn xeo ôộng truyến táy phè, moón rì sẻ àn hôổc là náy tloong vương quổc thiên đáng. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Ví thấy vé côống ái ới ùn là nều sứ côông chình của ái ới ùn chăng tổt hơn sứ côông chình của cảc thấy táy luật ôộng moón Pha-ri-si, xì ái ới ùn chẳc chằn sẻ chăng pao tloong vương quổc thiên đáng.<verse eid="MAT 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />Ái ới ùn tà măng như xí, tiếu tà àn truyến cho moón ngáy hơ: 'Chăng àn giểt moón.' mơi 'Moón noó giểt moón xì sẻ phải chíu sứ phàn xẻt.' <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Mơi thấy vé côống ái ới ùn là tẩt cả moón rổi giấn côống ái ùn mếng sẻ chíu sứ phàn xẻt. Mà moón noón hôổc ái ùn mếng: 'Tố ngu!' xì sẻ chíu hối tôống xẻt xử. Cón moón noó xẻ: 'Tố ngu dổt!' xì sẻ chíu tlứng phạt ở hoả ngục. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />Pởi xí, nều ái ới ùn tang dơng tố lể mếng ở pán thớ rối tái rì, ái ới ùn căắn xa là mộch moón ái ùn của mếng cò tiếu chi rì pẩt hoá côống mếng, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />xì hảy tể lái tố lể mếng ở tlưởc pán thớ ôộng ti khỏi; tlưởc tiên hảy mấn hoá côống moón ái ùn của mếng rì, ôộng rối, khâu khới ti, hảy dơng tố lể mếng. <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />Hảy thoả thuấn tloong hoá pính côống moón kiến cào mếng xật là mâu nều khới noó ái ới ùn tang ở tlêng khà côống moón rì, chăng là moón kiến cào cò thể giao ái ới ùn cho quan toá, ôộng quan toá chuyển cho kẻnh binh, rối ái ới ùn sẻ pí nèm pao tú. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Xật sứ, thấy vé côống ái ới ùn, ái ới ùn chẳc chằn sẻ chăng xa khỏi rì cho tềng khới noó ái ới ùn cò thể tlả tôống xiến cuồi cúng.<verse eid="MAT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />Ái ới ùn tà măng như xí ní, lới tà àn truyến: 'Chăng àn phám xối ngoái tính.' <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Mơi thấy vé côống ái ới ùn là pẩt ký ôông hay hẩu mộch mú daá côống mục đỉch ham moành vaá rì, xì moón rì tà phám xối ngoái tính côống vaá rì tloong loóng mếng rối. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Mặt khảc, nều con mẳt khà chăm của ái ới ùn mấn mếng phám xối, hảy voỏc reé xa ôộng nèm giang khỏi ái ới ùn. Ví như xí là tổt hơn cho ái ới ùn khới mộch phấn tloong cảc pố phấn của ái ới ùn pí hoỏng ti, mơi tẩt cả pỏc mếng mếng chăng pí nèm pao hỏa ngục. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Ôộng nều xay chăm của ái ới ùn mấn mếng phám xối, hảy chạch reé ôộng quăng giang xa khỏi ái ới ùn. Ví như xí là tổt hơn cho ái ới ùn khới mộch phấn tloong cảc pố phấn của ái ới ùn pí huỷ ti, mơi tẩt cả pỏc mếng mếng chăng ti pao hỏa ngục. <verse eid="MAT 5:30" /><verse number="31" style="v" sid="MAT 5:31" />Cón lới tà àn truyến: 'Moón noó lảc du mếng, xì moón rì hảy tưa cho nọ mộch tớ chầy ly hôn.' <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Mơi thấy vé côống ái ới ùn là pẩt ký ôông ay ly hôn du mếng, mơi chăng cò cào puộc vến xối gian dâm, xì mấn cho nọ vẳc xối ngoái tính. Ôộng nều ôông ay cười moón tứng pí ly hôn xì phám xối ngoái tính.<verse eid="MAT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />Ái ới ùn lái tà măng như xí, lới tà àn truyến cho moón ngáy hơ: 'Chăng àn thế lẻo, mơi hảy mấn xoong lới thế của mếng côống Chùa.' <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Mơi thấy pảo ái ới ùn má thế cày chi cả, yý má chỉ tlới mà thế, ví rì là ngai của Chùa Tlới; <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />yý má chỉ tẩt mà thế, ví rì là pế tở của choó Ngái; yý má chỉ thánh Giê-ru-sa-lem mà thế, ví rì là thánh của Vua cao cả. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Ái ới ùn yý má chỉ tlổc mếng mà thế, ví ái ới ùn chăng cò khả năng tể mấn mộch khới xẳc tlở rêng tlằng hay dấm. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Mới lới của ái ới ùn hảy là 'Cò, là cò,' hay 'Chăng, là chăng.' Cón tiếu chi vượt quà việc ní là pở ma quỷ.<verse eid="MAT 5:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />Ái ới ùn tà măng như xí, lới tà àn truyến: 'Mẳt tến mẳt, ôộng xăng tến xăng.' <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Mơi, thấy pảo ái ới ùn má chồng lái moón ảc. Thay pao rì, pẩt cừ ôông ay pả ái ới ùn pao mà táng chăm, yý hảy tưa mà cón lái cho moón rì. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Đồi côống moón moành kiến cào ái ới ùn xa toá àn ôộng lế ti ào tloong của ái ới ùn, hảy tể moón rì lế luôn ào vái mếng. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Ôộng ôông ay sẻ ẻp puộc ái ới ùn ti mộch dắm khà, xì hảy ti côống moón rì han dắm. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Hảy cho moón poi cườn ái ới ùn, ôộng má quay mặt khỏi moón moành vay maánh pở ái ới ùn.<verse eid="MAT 5:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />Ái ới ùn tà măng như xí, lới tà àn truyến: 'Yêu moón ở khênh mếng ôộng khẻt keẻ thú mếng.' <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Mơi thấy pảo ái ới ùn hảy yêu xương keẻ thú mếng ôộng cấu nguyến thay cho moón ngược đải mếng, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />xí noó cho ái ới ùn cò thể àn tlở rêng con của Cha mếng tlêng thiên đáng. Rì là ví Ngái mấn mặt tlới của Ngái moọc tlêng moón ảc mân moón lénh, ôộng Ngái pan mưa tlêng moón côông nghỉa mân moón pẩt chình. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Ví nều ái ới ùn yêu xương ôông ay yêu xương mếng, xì ái ới ùn cò phấn thưởng chi? Chăng phải cảc moón thu thuề yý mấn chôồng như xí à? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Ôộng nều ái ới ùn chỉ tòn cháo cảc moón ái ùn mếng, xì ái ới ùn mấn vượt hơn tiếu chi? Chăng phải cảc moón chăng phải Do Thài yý mấn chôồng như xí à? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Xí, ái ới ùn sẻ phải toán hảo, chôồng như Cha tlêng tlới của ái ới ùn là toán hảo.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />Hảy cẩn thấn vến việc côông chình của mếng xí noó cho má mấn tlưởc mặt maáng tể àn maáng hẩu kỉa, mơi nều chăng phải xí, xì rưởi là ái ới ùn chăng cò phấn thưởng tloong sứ hiến diến của Cha mếng tlêng thiên đáng. <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />Pởi xí, caá ái ới ùn cho của pồ thì, má xổi kén tlưởc mặt mếng chôồng như cảc moón đáo đửc giả mấn tloong cảc nhá hối ôộng vái khà phồ, xí noó cho maáng àn khen ngơới pởi con moón. Xật sứ, thấy vé côống ái ới ùn, maáng cò tủ phấn thưởng của mếng. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Mơi khới ái ới ùn cho của pồ thì, má tể cho xay chiêu của ái ới ùn mẳt việc xay chăm mếng tang mấn, <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />xí noó cho việc pồ thì của ái ới ùn cò thể ở tloong tược kìn đào, ôộng Cha của ái ới ùn, Tầng hẩu kỉa tloong tược kìn đào, sẻ pan thưởng cho ái ới ùn.<verse eid="MAT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />Ôộng caá ái ới ùn cấu nguyến, xì má như moón đáo đửc giả, ví maáng ưa cấu nguyến khới tà từng tloong cảc nhá hối ôộng ở cảc goỏc khà, xí noó cho maáng cò thể àn maáng hẩu kỉa. Xật sứ, thấy vé côống ái ới ùn, maáng cò tủ phấn thưởng của mếng. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Cón ái ới ùn, khới ái ới ùn cấu nguyến, hảy pao tloong phoóng riêng của ái ới ùn, ôộng khới tà toòng cửa phoóng mếng lái, hảy cấu nguyến côống Cha mếng tloong tược kìn đào rì, ôộng Cha của ái ới ùn, Tầng hẩu kỉa tloong tược kìn đào, sẻ pan thưởng cho ái ới ùn. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />Ôộng tang khới cấu nguyến, ái ới ùn má vé ti vé lái kiểu vô ỉch như cảc moón chăng phải Do Thài, ví maáng tưởng là pởi việc khề nhiếu của mếng, maáng sẻ àn măng. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Pởi xí, ái ới ùn chăng rêng chôồng như maáng, ví Cha của ái ới ùn mẳt ái ới ùn cò nhu cấu chi tlưởc khới ái ới ùn cấu cườn Ngái. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />Rêng, ái ới ùn hảy cấu nguyến xí ní :</para>
  <para style="q" vid="MAT 6:9">'Láy Cha tán con tlêng thiên đáng,</para>
  <para style="q2" vid="MAT 6:9">Cườn Danh Ngái àn tôn thành.<verse eid="MAT 6:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="MAT 6:10" />Cườn vương quổc Ngái hảy tềng,</para>
  <para style="q2" vid="MAT 6:10">cườn ỳ moành Ngái àn xảy xa</para>
  <para style="q2" vid="MAT 6:10">tìn tẩt yý như tlêng tlới!<verse eid="MAT 6:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="MAT 6:11" />Cườn pan cho tán con hôm nay tố ăn mổi ngáy của tán con;<verse eid="MAT 6:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="MAT 6:12" />ôộng cườn tha thừ tán con vến cảc xối lổi của tán con</para>
  <para style="q2" vid="MAT 6:12">như tán con yý tà tha thừ cảc moón phám lổi côống tán con,<verse eid="MAT 6:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="MAT 6:13" />ôộng cườn má tom tán con pao càm dổ,</para>
  <para style="q2" vid="MAT 6:13">mơi cườn giải cừu tán con khỏi ma quỷ.’<verse eid="MAT 6:13" /></para>
  <para style="b" />
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14" />Ví nều ái ới ùn tha thừ cho maáng cảc vi phám của maáng, xì Cha tlêng tlới của ái ới ùn yý sẻ tha thừ cho ái ới ùn. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Cón nều ái ới ùn chăng tha thừ cho maáng, xì Cha của ái ới ùn yý sẻ chăng tha thừ cảc vi phám của ái ới ùn.<verse eid="MAT 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />Cón nửa, khới ái ới ùn kiêng ăn, má xa vẻ như cảc moón puốn rấu đáo đửc giả, ví maáng nhăn nhò mặt máy của mếng tể maáng cò thể páy tỏ cho maáng kỉa là tang kiêng ăn. Xật sứ, thấy vé côống ái ới ùn, maáng cò tủ phấn thưởng của mếng. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Cón ái ới ùn, khới kiêng ăn, hảy pôi dấu tlêng tlổc mếng ôộng xửa mặt mếng, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />xí noó cho ái ới ùn chăng cò thể tỏ cho maáng kỉa là tang kiêng ăn, mơi là cho Cha mếng tloong tược kìn đào; ôộng Cha của ái ới ùn, Tầng hẩu kỉa tloong tược kìn đào, sẻ pan thưởng cho ái ới ùn.<verse eid="MAT 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />Má mon cho chình mếng của cải tìn tẩt, là tược mà mồi moạch côống hoen rỉ huỷ hoái, yý là tược mà xên lốm lẻn pao ôộng ăn cẳp. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Mơi hảy mon cho mếng của cải tlêng tlới, là tược chăng cò mồi moạch hay hoen rỉ huỷ hoái, ôộng là tược mà xên lốm chăng lẻn pao hay ăn cẳp. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Ví của cải của ái ới ùn ở noó, xì loóng của ái ới ùn yý sẻ ở rì. <verse eid="MAT 6:21" /><verse number="22" style="v" sid="MAT 6:22" />Con mẳt là tén cúa pỏc mếng. Pởi xí, nều mẳt ái ới ùn là tổt, xì cả pỏc mếng ái ới ùn sẻ àn tlán ngập ènh tlàng. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Mơi nều con mẳt ái ới ùn là xầu, xì cả pỏc mếng ái ới ùn sẻ pí tlán tấy poòng xồn. Rêng, nều ènh tlàng tloong ái ới ùn là poòng xồn, xì poòng xồn rì xật náy mẳt cớ noó! <verse eid="MAT 6:23" /><verse number="24" style="v" sid="MAT 6:24" />Chăng ay cò thể phục vuú han chủ, ví moón rì hoặc sẻ khẻt chủ ní mà ưa chủ kia, hay sẻ hểt loóng côống chủ ní mơi khinh thướng chủ kia. Ái ới ùn chăng thể phục vuú Chùa Tlới ôộng xiến của àn. <verse eid="MAT 6:24" /><verse number="25" style="v" sid="MAT 6:25" />Pởi ví tiếu ní, thấy vé côống ái ới ùn, má lo lằng cho sứ khôồng của ái ới ùn, vến cày chi mếng ăn hay cày chi mếng oòng, hoặc cho pỏc mếng của ái ới ùn, vến cày chi mếng mặc. Chăng phải sứ khôồng xì già tlí hơn tố ăn, ôộng pỏc mếng già tlí hơn tố mặc tùng chăng? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Hảy hẩu xứ ở tán chim tlêng tlới, là phè chăng oải, yý chăng hài hay gom pao nhá kho, mơi Cha tlêng tlới của ái ới ùn ruôi phè. Ái ới ùn chăng cò già tlí vượt tlối hơn phè tùng chăng? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Mặt khảc, moón noó khừa voóng ái ới ùn khới lo lằng xì cò thể xêm mộch giây phủt pao xuổi tới của mếng? <verse eid="MAT 6:27" /><verse number="28" style="v" sid="MAT 6:28" />Ôộng xí noó ái ới ùn lo lằng vến quấn ào? Hảy iềng xử xật sứ vến loái hoa huế vái tôống, xí noó mà phè moọc lêng. Phè chăng lao nhoọc, yý chăng kèo chỉ. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Mơi thấy vé côống ái ới ùn là ngay cả vua Sa-lô-môn, tloong tẩt cả sứ sang tlóng của ôông, yý chăng mặc quấn ào cho mếng chôồng như mộch tloong sồ cảc hoa rì. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Cón nều Chùa Tlới mặc như xí cho cỏ vái tôống, là xừ nay cón, ôộng ngáy dao pí nèm pao ló lửa, xì cảc moón kèm đửc tin kia, xì Ngái chăng mấn àn nhiếu hơn hay chăng? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Pởi xí, ái ới ùn chăng rêng lo lằng mà vé: 'Tán ha ăn cày chi?' hay là 'Tán ha oòng cày chi?' hay là 'Tán ha mặc cày chi?' <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Ví cảc moón chăng phải Do Thài xím kiềm tẩt cả cảc xừ ní; ôộng ví Cha tlêng tlới của ái ới ùn mẳt là ái ới ùn cấn tẩt cả cảc tiếu rì. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Mơi tlưởc hểt hảy xím kiềm vương quổc ôộng sứ côông chình của Ngái xì tẩt cả cảc tiếu rì sẻ àn xêm pao cho ái ới ùn. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Pởi xí, ái ới ùn chăng rêng lo lằng vến ngáy dao, ví ngáy dao sẻ lo cho chình reé. Cò tủ cho mộch ngáy chuyến khò nhoọc của chình reé.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />Má xẻt đoàn, tể ái ới ùn chăng pí xẻt đoàn. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Ví tloong việc kểt àn mà ái ới ùn xẻt đoàn, ái ới ùn sẻ chíu xẻt đoàn, ôộng pởi khuôn phẻp mà ái ùn to lướng, khuôn phẻp rì sẻ àn to lướng đồi côống ái ới ùn. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />Mơi rêng noó ái ới ùn hẩu xa mẻnh dắm tloong mẳt moón ái ùn mếng, mơi ái ới ùn chăng phảt hiến tloong mẳt mếng? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Hay mấn xí noó mà ái ới ùn sẻ pảo moón ái ùn mếng: 'Hảy tể tôi lế mẻnh dắm xa khỏi mẳt ái,' mơi hẩu rạ, khủc câl tang ở tloong mẳt ái ới ùn? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Tán đáo đửc giả kia! Tlưởc tiên, hảy lế khủc câl ca khỏi mẳt mếng, xì khâu rì, ái ới ùn sẻ kỉa rỏ tể lế mẻnh dắm xa khỏi mẳt ái ùn mếng. <verse eid="MAT 7:5" /><verse number="6" style="v" sid="MAT 7:6" />Ái ới ùn má cho tán chò tố thành, yý má nèm ngoọc chai của mếng tlưởc mặt tán cùn. Chăng là phè sẻ giẩm tạp cảc xừ rì tìn choó phè, ôộng khâu khới quay lái xì phè cành xè ái ới ùn thánh tứng mảnh.<verse eid="MAT 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />Hảy cườn, ôộng tiếu rì sẻ àn pan cho ái ới ùn. Hảy xím, ôộng ái ới ùn sẻ tốn. Hảy gỏ, ôộng cửa sẻ àn vở cho ái ới ùn. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Ví pất ký ôông ay cườn xì àn; ôông ay xím xì tốn; ôộng, cửa sẻ àn vở cho ôông ay gỏ. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Hay cò ôông ay tloong voóng ái ới ùn, là moón mà con mếng cườn pènh - chăng lẻ moón rì sẻ cho từa con hón phú? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Hay từa con yý cườn cà - chăng lẻ moón rì sẻ cho reé xành? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Rêng, nều ái ới ùn, là xầu, mẳt cho con cài mếng cả cày tổt lénh, xì Cha của ái ới ùn tlêng thiên đáng sẻ pan cho ôông ay cườn Ngái nhiếu tiếu tổt lénh hơn mẳt cớ nó? <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />Xí rêng, tlong tẩt cả cảc việc, nều ái ới ùn moành pẩt ký tiếu chi maáng mấn cho mếng, xì ái ới ùn yý hảy mấn như xí cho maáng, ví rì là luật phảp mân cảc lới tiên tli.<verse eid="MAT 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Hảy ti pao qua côổng hẹp. Ví côổng rôống mân khà thênh thang tưa tềng sứ huỷ diệt, ôộng cò nhiếu moón ti pao qua rì. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Rì là pởi cửa hẹp mân khà àn mấn cho hẹp tưa tềng sứ khôồng, mà ét cò moón xím kỉa reé.<verse eid="MAT 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />Hảy tế phoóng vến cảc tiên tli giả, là cảc moón giả dáng chiên tềng côống ái ới ùn, mơi khà tloong, maáng là loái sòi cành xè. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Ái ới ùn sẻ hay àn maáng pở ở tlày của maáng. Maáng chăng lẻ cò hài nho pở púi khoóng, hay tlày pả pở cỏ hoang? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Chôồng như xí, tẩt cả câl tổt xì xa tlày tổt, cón câl xầu xì xa tlày xầu. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Câl tổt chăng thể xa tlày xầu, câl xầu yý chăng thể xa tlày tổt. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Tẩt cả cảc câl chăng xa tlày tổt xì pí chạch ôộng nèm pao lửa. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Xí rêng, ét xa xì ái ới ùn sẻ nhấn xa maáng pở ở tlày của maáng. <verse eid="MAT 7:20" /><verse number="21" style="v" sid="MAT 7:21" />Chăng phải tẩt cả moón vé côống thấy: 'Láy Chùa, láy Chùa', sẻ pao tloong vương quổc thiên đáng, mơi là cảc moón mấn xeo ỳ moành của Cha thấy tlêng thiên đáng. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Tloong ngáy rì, nhiếu moón sẻ thưa côống thấy: 'Láy Chùa, chăng phải, tán con tà nhân danh Ngái vé tiên tli, tà nhân danh Ngái tuổi quỷ ôộng nhân danh Ngái mấn nhiếu việc quyến năng à?' <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Ôộng caá rì, thấy sẻ tuyên pồ rổ côống maáng là: 'Ho chăng tứng mẳt tán pay caá nó! Tán mấn ảc kia, hảy piền ti khỏi Ho!'<verse eid="MAT 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />Pởi xí, mổi moón, nghỉa là pẩt cừ ôông ay măng cảc lời ní của thấy mân mấn xeo phè xì sẻ àn hẩu như mộch moón khôn ngoan, là moón xây nhá mếng tlêng tảng phú. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Mưa tuôn xuồng, rảc lụt vến, xò xổi ôộng xô tập pao nhá rì, mơi reé chăng sập ví reé tà an xây tlêng tảng phú. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Mân tẩt cả moón măng cảc lời ní của thấy mà chăng mấn xeo phè xì sẻ àn hẩu như mộch moón ngu dổt, là moón xây nhá mếng tlêng caảch. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Mưa tuôn xuồng, rảc lụt vến, xò xổi ôộng tập pao nhá rì, xì reé sập xuồng ôộng sứ phà huỷ của reé là rất nhiếu."<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Việc xảy xa rì là caá Chùa Giê-xu giảng xoong cảc lới ní, tán dân pí kinh ngạc pởi sứ táy dổ của Ngái, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Ví Ngái táy maáng như cò thẩm quyến, mà chăng chôồng cảc thấy táy luật của maáng.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Caá ní, khâu khới Ngái pở tlêng nùi ti xuồng, cảc đoán moón khòm ti xeo Ngái. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Hẩu rạ, mộch moón vẳc pếng phoong hủi khâu khới tiền tềng, tà quý tlưởc Ngái, thưa: "Láy Chùa, nều Ngài khẳn loóng, Ngái cò quyến tể mấn tôi àn quang." <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />Rối khới tà tưa xay xa, Ngái chám pao ái, pảo: "Tôi khẳn loóng. Hảy quang ti." Ngay caá rì, ái ha àn tẩy quang phoong hủi của mếng. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Chùa Giê-xu vé côống ái: “Hảy cẩn thấn, ái má rêng vé côống ôông ay, mơi hảy ti, trính diến chình mếng côống thấy tề lể mân dơng của lể mà Môi-se tà truyến táy, như mộch lới mấn chừng cho maáng.”<verse eid="MAT 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Caá ní, khâu khới Ngái ti pao tloong thánh Ca-bê-na-um, mộch viên đối tlưởng tà tềng côống Ngái, cấu khẩn Ngái <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />xí ní: “Láy Chùa, moón hấu của tôi tảy liệt ở nhá, chíu tâu tờn khủng khiểp lặm." <verse eid="MAT 8:6" /><verse number="7" style="v" sid="MAT 8:7" />Ngái vé côống ôông: "Khới tềng rối, tôi sẻ chửa lénh cho ái rì." <verse eid="MAT 8:7" /><verse number="8" style="v" sid="MAT 8:8" />Khới tlả lới lái, viên đối tlưởng thưa: "Láy Chùa, tôi xì chăng xừng đàng tể Ngái cò thể ti pao tìn mài nhá mếng, mơi cườn Ngái chỉ phàn mộch lới, xì moón hấu của tôi sẻ àn chửa lénh. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Ví tôi yý là mộch moón àn tệch tìn thẩm quyến, cò cảc binh lình ở tìn mếng. Tôi vé côống moón ní: 'Ti ti,' xì ái ha ti, côống moón khảc: 'Hảy tềng,' xì ái ha tềng, ôộng côống moón hấu mếng: 'Hảy mấn tiếu ní,' xì reé mấn." <verse eid="MAT 8:9" /><verse number="10" style="v" sid="MAT 8:10" />Mơi khâu khới măng xí, Chùa Giê-xu ngạc nhiên mân poi côống cảc moón tang ti xeo Ngái: "Xật sứ, thấy vé côống ái ới ùn, thấy chăng kỉa đửc tin náy như xí pở mộch moón noó tloong Y-sơ-ra-ên. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Ngược lái, thấy pảo ái ới ùn là nhiếu moón sẻ tềng pở táng tôông ôộng táng tây, rối maáng sẻ àn ngối ăn côống Áp-ra-ham, Y-sác ôộng Gia-cốp tloong vương quổc thiên đáng. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Mơi cảc con của vương quổc sẻ pí quăng pao tược xồn xăm khà vái, là tược sẻ cò sứ than nhám mân nghiền xăng." <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />Rối Chùa Giê-xu vé côống viên đối tlưởng: “Hảy ti ti! Như ôông tà tin, việc rì phải àn mấn rêng cho ôông." Ôộng moón hấu việc rì tà àn chửa lénh tloong giớ rì.<verse eid="MAT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Khâu khới Chùa Giê-xu pao tloong nhá của Phi-e-rơ, Ngái kỉa mế du của ôông tảy tlêng chớng mân tang pí sổt. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Ngái chám pao xay của mú, ôộng cơn sổt piền khỏi mú, rối mú ngối dấn mân pẳt tấu phục vuú Ngái. <verse eid="MAT 8:15" /><verse number="16" style="v" sid="MAT 8:16" />Caá ní, caá tà tềng khuống xồn, maáng tom tềng cho Ngái nhiếu moón pí quỷ ềm, Ngái tlục xuẩt cảc linh rì pắng mộch lới phàn ôộng chửa lénh cho tẩt cả ôông ay vẳc pếng, <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />xí nó cho việc rì àn ừng nghiếm lới tà àn vé pởi tiên tli Ê-sai, xí ní: "Chình Ngái tà vang lế cảc nổi tâu yều của tán ha mân tà tliêng lế cảc pếng tật của tán ha."<verse eid="MAT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Caá ní, caá hẩu kỉa tán moón chung quenh mếng, Chùa Giê-xu truyến lếnh lêng khà qua nâấm khà kia. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Rối mộch thấy táy luật, khâu khới tềng khênh, tà vé côống Ngái: "Thưa thấy, tôi sẻ xeo thấy dú thấy ti nó." <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" />Chùa Giê-xu vé côống ôông: “Cào cò hang, ôộng chim tlới cò ổ, mơi Con Moón chăng cò tược mà Ngái cò thể kềng tlổc." <verse eid="MAT 8:20" /><verse number="21" style="v" sid="MAT 8:21" />Xí rối, mộch moón khảc tloong cảc môn tố thưa côống Ngái: "Láy Chùa, cườn cho phẻp tôi tlưởc hểt là ti vến mân chôn pồ tôi." <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />Mơi Chùa Giê-xu vé côống ái: “Hảy xeo thấy, ôộng hảy tể moón chểt chôn moón chểt của maáng.”<verse eid="MAT 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Khới Ngài tà pao tloong thuyến, cảc môn tố của Ngái ti xeo Ngái. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Hẩu rạ, cò cơn pảo rất hung dử xảy xa tlêng piển, tềng nổi thuyến pí soòng pao phủ. Mơi Ngái tang tảy. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Rối khới lái khênh, maáng tành thửc Ngái, thưa: "Láy Chùa, cườn Ngái cừu giủp; tán ha pú chểt rối!" <verse eid="MAT 8:25" /><verse number="26" style="v" sid="MAT 8:26" />Ôộng Ngái vé côống maáng: "Mầy moón ét đửc tin kia, xí nó ái ùn rưởi!" Khâu rì, khới tà ngối dấn, Ngái quở xò ôộng piển, xì sứ tỉnh lắng vô cúng xảy xa. <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />Cón cảc moón rì kinh ngạc, pảo: "Moón ní là xí nó, vì tềng nổi xò ôộng piển tếu vơng lới nọ?"<verse eid="MAT 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Rối caá Ngái tà ti qua nâấm táng kia, tềng púng Ga-đa-ra, han moón pí quỷ ềm tà tềng tốn Ngái, khâu khới ti xa pở khu nghỉa tlang, maáng rẩt là hung dử tềng nổi chăng ôông ay tủ khửc tể păng qua cày khà rì. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Hẩu rạ, maáng rố lêng, xí ní: “Láy Con Thiên Chùa, tán tôi côống Ngái cò việc chi? Ngái tềng ní tể mấn khổ tán tôi tlưởc ý hán chăng?" <verse eid="MAT 8:29" /><verse number="30" style="v" sid="MAT 8:30" />Caá rì, cò mộch tán cùn khòm lặm tang ăn cảcch maáng mộch ét. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Xí rối, tán quỷ nái cườn Ngái, xí ní: "Nều Ngái tlục xuẩt tán tôi, cườn cho tán tôi nhập pao tán cùn rì." <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />Ngái pảo phè: "Ti xa!" Xí là khâu khới xa khỏi, tán phè nhập pao tán cùn; mân hảy hẩu rạ, cả tán lao xuồng cày choòng tưa xa piển, rối phè chểt tìn rảc. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Caá rì, cảc moón chăn cùn chắn ti, ôộng khâu khới vến tềng thánh, maáng kể lái tẩt cả cảc chuyến, kể cả cảc chuyến liên quan tềng mấy moón pí quỷ ềm. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Ôộng hảy hẩu rạ, cả thánh kèo xa tể tốn Chùa Giê-xu. Khới tà kỉa Ngái, maáng nái cườn Ngái xí nó cho Ngái ti xa khỏi púng tẩt của maáng.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Caá tà pao tloong thuyến, Ngái vượt piển ôộng vến tềng thánh của mếng. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Hẩu rạ, Maáng tom tềng cho Ngái mộch moón pí pái liệt tang tảy tlêng chiều. Khới Chùa Giê-xu kỉa đửc tin của maáng, Ngái pảo moón pí pái liệt: “Hớ con, hảy vửng loóng lêng. Cảc xối lổi con àn tha thừ." <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />Ôộng hẩu rạ, mộch sồ tloong cảc thấy táy luật vé côống phố: "Xên ní pàng pổ." <verse eid="MAT 9:3" /><verse number="4" style="v" sid="MAT 9:4" />Pởi tà mẳt cảc suy nghỉ của maáng, Chùa Giê-xu vé: "Cảc ôông ngẩm nghỉ xầu xa tloong loóng mếng tể mấn chi? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Ví tiếu nó là lời hơn tể vé: ‘Cảc xối lổi con àn tha thừ,' hay vé: 'Hảy từng dấn ô ộng pưởc ti'? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Mơi tể cảc ôông cò thể mẳt là Con Moón cò thẩm quyến ở tlêng tẩt tể tha xối ..." xì pao caá rì, Ngái pảo moón pí pái liệt: "Hảy từng dấn, cuồn chiều lái, ôộng ti vến nhá mếng." <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Ôộng khâu khới từng dấn, moón rì ti vến nhá mếng. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Xí là, khới kỉa xí, tán dân rưởi quà ôộng tôn vinh Thiên Chùa ví tà pan cho loái moón thẩm quyến như xí. <verse eid="MAT 9:8" /><verse number="9" style="v" sid="MAT 9:9" />Khới tà pở tược rì lêng khà, Chùa Giê-xu hẩu kỉa mộch moón xên Ma-thi-ơ tang ngối ở tlám thu thuề, rối Ngái pảo ôông: "Hảy xeo thấy." Ôộng khâu khới pật dấn, ôông ti xeo Ngái.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Việc xảy xa khới Ngái ngối ăn tloong nhá, xì hẩu rạ, nhiếu nhân viên thu thuề mân moón xối lổi ti tềng, tà ngối pao pán ăn côống Chùa Giê-xu mân cảc môn tố Ngái. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Khới hẩu kỉa xí, cảc moón Pha-ri-si vé côống cảc môn tố Ngái: "Pởi lỳ do chi mà thấy của cảc ái ăn chung côống tán thu thuề ô ộng moón xối lổi?" <verse eid="MAT 9:11" /><verse number="12" style="v" sid="MAT 9:12" />Mơi khâu khới măng xí, Ngái vé: "Moón nôống lăng chăng cò nhu cấu vến thấy xuổc, mơi là moón vẳc pếng. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Cón khâu khới ti khỏi, hảy hoọc hiểu câu ní là xí nó: 'Ho moành loóng xương xỏt, chăng phải tề lể.' Ví chăng phải tôi tềng tể hôổc moón côông chình, mơi là moón cò xối."<verse eid="MAT 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Caá rì, cảc môn tố của Giăng tềng tốn Ngái, thưa: "Rêng nó mà tán tôi ôộng cảc moón Pha-ri-si hay kiêng ăn, cón cảc môn tố của thấy xì chăng kiêng ăn?" <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />Chùa Giê-xu vé côống maáng: “Chăng lẻ cảc pán bé tham gia lể cười cò thể sấu thảm tloong thới gian khới nó mà chù rể ở côống maáng? Mơi sẻ tềng ngáy khới mà chù rể pí tom ti khỏi maáng, xì caá rì maáng sẻ kiêng ăn. <verse eid="MAT 9:15" /><verse number="16" style="v" sid="MAT 9:16" />Cón nửa, chăng ay pà mộch ménh pải mời chưa pí co rủt pao cày ào cù, ví ménh pà chắng rẻch khỏi khỏi cày ào rì, ôộng mộch tồ rẻch xầu hơn xuẩt hiến, <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Yý chăng ay tổ ráo mời pao pấu ta cù. Mơi nều chăng phải xí, xì rưởi là pấu ta pí rểch pể, ráo pí tổ xa ôộng pấu pí hoỏng. Thay pao rì, maáng tổ ráo mời pao pấu ta mời, ô ộng cả han àn pảo toán."<verse eid="MAT 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Tloong khới Chùa Giê-xu cón tang vé cảc lới rì côống maáng, xì hẩu rạ, mộch moón lảnh đáo nhá hối khâu khới lái khênh, tà quý xuồng tlưởc Ngái, thưa xí ní: "Con cài tôi phưa mời chểt, xí mơi caá tềng rì, cườn hảy tệch xay thấy tlêng reé, xì reé sẻ khôồng." <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Khâu khới từng dấn, Chùa Giê-xu ôộng cảc môn tố Ngái ti xeo ôông rì. <verse eid="MAT 9:19" /><verse number="20" style="v" sid="MAT 9:20" />Ôộng ẩu rạ, mộch phú nử chíu đứng cày pếng roong mầu suổt mưới han năm, khơi tiền tềng khà khâu Ngái rối, xì tà chám pao vạt ào của Ngái, <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Ví ới tứ nghỉ: “Nều mếng chỉ chám pao ào Ngái rôi, xì mếng sẻ àn lénh pếng.” <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />Mơi khâu khới quay lái ôộng kỉa ới, Chùa Giê-xu vé: "Con cài ới, hảy yên loóng; đửc tin con tà chửa lénh con." Ôộng moón phú nử rì àn lénh pếng pở giớ rì. <verse eid="MAT 9:22" /><verse number="23" style="v" sid="MAT 9:23" />Rối Chùa Giê-xu, khâu khới ti tềng nhá moón lảnh đáo nhá hối rì ôộng kỉa mầy moón xổi khào côống đàm tôông ốn áo, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />tà truyến: "Hảy lui xa, ví từa rẻt cài tà chăng chểt, mơi là tang tảy." Rối maáng cưới nháo Ngái. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Xí là, caá đàm tôông pí tuổi xa vái rối, xì khâu khới ti pao tloong, Ngái nằm xay từa rẻt, ôộng từa rẻt cài rì tứ ngối dấn. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Tin ní loan xa tloong khồm púng rì.<verse eid="MAT 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Tang khới Chùa Giê-xu pở tược rì lêng khà, xì han moón mú tà ti xeo Ngái, rố náy ôộng thưa: "Láy Con vua Đa-vít, cườn xương xỏt tán tôi!" <verse eid="MAT 9:27" /><verse number="28" style="v" sid="MAT 9:28" />Caá rì, khới pao tloong nhá rối, han moón mú tềng khênh Ngái ôộng Chùa Giê-xu vé côống maáng: "Cò phải cảc ái tin là tôi cò thể mấn việc rì?" Maáng vé côống Ngái: "Tùng rối, thưa Chùa." <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />Khâu rì, Ngái chám pao mẳt maáng, pảo: "Việc rì phải àn xảy xa cho cảc ái xeo như đửc tin của cảc ái." <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Mẳt maáng àn vở xa, ôộng Chùa Giê-xu kẻnh pào maáng, xí ní: "Hảy cẩn thấn, cảc ái má cho ôông ay hay." <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Mơi khâu khới xa vái, maáng vé lái việc rì tloong khồm púng ní.<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Caá ní, tang khới maáng ti xa, xì hẩu rạ, maáng tom tềng cho Ngái mộch moón câm pí quỷ ềm. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Caá quỷ pí tlục xuẩt rối, xì moón câm vé àn, ôộng tán dân kinh ngạc, vé: "Mộch việc như xí chưa caá nó àn páy tỏ tloong Y-sơ-ra-ên!" <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" />Mơi cảc moón Pha-ri-si tà pảo: “Ôông ha tuổi quỷ dứa pao chùa quỷ."<verse eid="MAT 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Chùa Giê-xu ti khồm hểt cả cảc thánh ôộng lúng láng, táy dổ tloong cảc nhá hối của tán dân, rao giảng Tin Lénh của vương quổc, ôộng chửa lénh mổi tật pếng côống tẩt cả tâu yều. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Caá ní, khới hẩu kỉa cảc tán dân khòm, Ngái cảm xương thay cho maáng, ví maáng tang pí quầy phàn ôộng chíu kẻnh tan lạc, như là chiên chăng cò moón chăn. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Khâu rì, Ngái vé côống cảc môn tố mếng: "Dú múa cảch xì náy, mơi thớ cảch xì ét. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Khâu rì hảy cấu khẩn Chủa của múa cảch, xí nó cho Ngái khai phài cảc thớ cảch pao tloong múa cảch của mếng."<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Khâu khới hôổc mưới han môn tố của mếng tềng, Ngái tà pan cho maáng thẩm quyển tlêng cảc ảc linh, tể tlục xuẩt phè ôộng chửa lénh mổi pếng tật côống tẩt cả tâu yều. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Xên của mưới han sừ tố là như xí ní: Đấu tiên, Si-môn (àn hôổc là Phi-e-rơ) ôộng Anh-rê, ùn từa ôông; Gia-cơ con của Xê-bê-đê ôộng Giăng, ùn từa ôông; <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Phi-líp ôộng Ba-thê-lê-mi; Thô-ma ôộng Ma-thi-ơ, nhân viên thu thuề; Gia-cơ con của A-phê, ôộng Tha-đê; <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Si-môn Xê-lốt, ôộng Giu-đa Ích-ca-ri-ốt, yý là moón tà phản Ngái.<verse eid="MAT 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Chùa Giê-xu tà khai mưới han moón ní ti, khâu khới truyến pảo maáng, xí ní: "Má ti tlêng cày khà của cảc dân ngoái quổc, yý má pao tloong thánh của moón Sa-ma-ri. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Mơi hảy tềng côống cảc con chiên lạc vẩt của nhá Y-sơ-ra-ên xì hơn. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Caá ní, khới ti khà, ái ùn hảy rao giảng, vé xí ní: 'Vương quổc thiên đáng tà tềng khênh.' <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Hảy chửa lénh moón tâu yều, mấn moón chểt khôồng lái, mấn quang moón phoong hủi ôộng tlục xuẩt cảc quỷ. Ái ùn tà àn nhấn miển phí, xì hảy cho miển phì. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Má tom xeo váng, hay pạc, hoặc xiến tloong khái xẳt côố rôồng của ái ùn. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />Chăng pao pí cho chuyền ti, hay han ào, hoặc giáy, hoặc câấy, ví moón mấn côông đàng àn phấn ăn mếng. <verse eid="MAT 10:10" /><verse number="11" style="v" sid="MAT 10:11" />Cón tloong thánh hoặc láng nó mà ái ùn ti pao, hảy xím hiểu ôông ay rì tloong tược ní là moón xừng đàng, hảy ở tái rì cho tềng khới nó ái ùn xa ti. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Caá ní, khới pao tloong nhá rì, hảy chủc pính an cho tược rì. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Mộch mặt, nều nhá rì là tược xừng đàng, xì sứ pính an của ái ùn phải tềng tlêng reé, mặt khảc, nều reé chăng phải là tược xừng đàng, xì sứ pính an của ái ùn phải àn tlở vến côống ái ùn. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Ôộng moón nó chăng tiểp tòn ái ùn, yý chăng măng xeo cảc lới của ái ùn, xì khới ti xa khỏi nhá hoặc thánh rì, hảy phủi pun tìn chó ái ùn. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Xật sứ, thấy vé côống ái ùn, sẻ là lời chíu cho tẩt Sô-đôm ôộng Gô-mô-rơ tloong ngáy phàn xẻt hơn là cho thánh rì.<verse eid="MAT 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />Hẩu rạ, thấy tang khai ái ùn ti như chiên ở khừa tán sòi, hảy tlở rêng khôn ngoan như xành ô ộng hiến lénh như chim cú cu. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Mơi hảy cẩn thấn vến maáng, ví maáng sẻ giao nộp ái ùn cho hối tôống xẻt xử, ôộng maáng sẻ tành ái ùn pắng roi tloong nhá hối của maáng; <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />rối ái ùn tềng nổi sẻ pí giải tềng tlưởc cảc thồng đổc ôộng cảc vua ví pởi thấy, tể như mộch lới mấn chừng cho maáng ôộng cho cảc moón chăng phải Do Thài. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Mơi caá maáng giao nộp ái ùn, má lo lằng vến cảch noó hoặc tiếu chi mếng cấn vé, ví tiếu mà ái ùn cấn vé sẻ àn pan cho ái ùn tloong giớ rì. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Ví chăng phải ái ùn là mòn vé, mơi là Thành Linh của Cha ái ùn vé tloong ái ùn. <verse eid="MAT 10:20" /><verse number="21" style="v" sid="MAT 10:21" />Cón nửa, ái sẻ nộp ùn pao cày chểt, ôộng pồ xì nộp con, mân con cài sẻ rổi dấn chồng nghịch pồ mế ôộng sẻ mấn maáng phải chểt. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Ôộng ái ùn sẻ pí tẩt cả cảc moón thú khẻt ví danh thấy, mơi moón nó chíu nổi tềng cuồi cúng, moón rì sẻ àn cừu. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Mơi khới nó maáng pửc hái ái ùn tloong thánh ní, xì hảy chắn qua thánh khảc, ví xật sứ, thấy vé côống ái ùn, chẳc chằn ái ùn chăng thể nó ti hểt cảc thánh của Y-sơ-ra-ên cho tềng tlỏng caá Con Moón tềng.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />Môn tố xì chăng hơn thấy, nô lế yý chăng hơn chủ mếng. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Đồi côống môn tố, xí nó cho moón rì cò thể àn như thấy mếng, ôộng moón hấu xì như chủ mếng, là tủ rối. Nều maáng tà hôổc chủ nhá là Bê-ên-xê-bun, xì moón nhá của chủ cón xầu hơn tềng cớ nó! <verse eid="MAT 10:25" /><verse number="26" style="v" sid="MAT 10:26" />Xí xì, má rưởi maáng, ví chăng cò tiếu chi pí che vẩt mà sẻ chăng àn tỏ xa, pí chù kìn mà sẻ chăng àn hay mẳt. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Tiếu thấy truyến pảo ái ùn ở tược xồn, hảy vé xa ở tược tlàng, ôộng tiếu ái ùn măng ở xai, hảy rao giảng tlêng noỏc nhá. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Má kinh rưởi tlưởc cảc moón giểt chểt pỏc mếng mơi chăng thể giểt chểt linh hốn. Mơi hảy kinh rưởi Tầng cò thể huỷ diệt cả linh hốn mân pỏc mếng tloong hoả ngục xì hơn. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Chăng phải han con chim ché khẻ paành côống già mộch xu à? Ôộng chăng mộch con nó tloong sồ phè sẻ rúng xuồng tẩt tlứ xa ỳ moành cảu Cha ái ùn. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Mà ngay cả xẳc tlêng tlổc ái ùn, tẩt cả là tà àn tềm rối. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Pởi xí, má rưởi; ái ùn quỳ già hơn nhiếu con chim ché khẻ. <verse eid="MAT 10:31" /><verse number="32" style="v" sid="MAT 10:32" />Xí rêng, mổi moón, nghỉa là pẩt cừ ôông ay sẻ tuyên xưng vến thấy tlưởc mặt maáng, xì thấy yý sẻ tuyên xưng vến moón rì tlưởc mặt Cha thấy tlêng thiên đáng. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Mơi pẩt ký moón nó tứ chồi thấy tlưởc mặt maáng, xì thấy yý sẻ tứ chồi moón rì tlưởc mặt Cha thấy tlêng thiên đáng.<verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />Má tưởng là thấy tềng tể tom pính an tlêng tẩt. Thấy chăng tềng tể tom pính an, mơi là gươm tao. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Ví thấy tềng tể mấn con từa chồng lái pồ mếng, con cài chồng lái mế mếng, con du chồng lái mế chầu mếng. <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />Ôộng keẻ thú của mộch moón là cảc moón tloong gia đính của moón rì. <verse eid="MAT 10:36" /><verse number="37" style="v" sid="MAT 10:37" />Ay yêu pồ hay mế hơn thấy xì chăng xừng đàng côống thấy; ay yêu con từa hay con cài hơn thấy xì yý chăng xừng đàng côống thấy. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Ôộng moón noó chăng vảc câl thập tứ mếng ôộng xeo khâu thấy xì chăng xừng đàng côống thấy. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Ay xím sứ khôồng mếng sẻ tành vẩt reé, mơi ay vẩt sứ khôồng mếng pởi ví thấy sẻ xím àn reé.<verse eid="MAT 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />Ay tiểp tòn ái ùn là tiểp tòn thấy, ôộng ay tiểp tòn thấy là tiểp tòn Tầng khai phài thấy. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Ay tiểp tòn mộch tiên tli pởi danh phấn ví tiên tli sẻ nhấn àn phấn thưởng của ví tiên tli, ôộng ôông ay tiểp tòn mộch moón côông chình pởi danh phấn moón côông chình sẻ nhấn àn phấn thưởng của moón côông chình. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Ôộng nều ôông ay cho mộch tloong cảc moón énh ní oòng mộch cổc rảc lénh chỉ pởi danh phấn môn tố, xì xật sứ, thấy vé côống ái ùn, moón rì chẳc chằn chăng vẩt phấn thưởng của mếng."<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Việc xảy xa khới Chùa Giê-xu tà truyến táy mưới han môn tố của mếng xoong, Ngái ti khỏi rì tể táy dổ ôộng rao giảng tloong cảc thánh của tán dân. <verse eid="MAT 11:1" /><verse number="2" style="v" sid="MAT 11:2" />Caá ní, Giăng, khâu khới pở tloong tú măng kể lái vến cảc việc mấn của Chùa Cừu Thề, xì pởi cảc môn tố mếng tà khai ti, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />tà thưa côống Ngái: "Thấy là Tầng phải tềng, hay tán tôi tang moong tới mộch Tầng khảc?" <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />Tể tlả lới lái, Chùa Giê-xu vé côống maáng: "Khâu khới ti khỏi, hảy vé lái cho Giăng cày chi ái ùn kỉa ôộng măng. <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Moón mú àn hẩu kỉa, moón qué pưởc ti, moón phoong hủi àn tẩy quang, moón tiểc măng hiểu, moón chểt àn mán khôồng lái mân moón nghéo khò àn giảng cho Tin Lénh. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Ôộng nều ôông ay chăng pí vẩp phám pởi ví thấy là moón àn phưởc."<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Caá ní, khới cảc moón rì lêng khà rối, Chùa Giê-xu pẳt tấu vé côống tán dân vến Giăng: "Ái ới ùn ti xa tược hoang mạc tể hẩu cày chi - câl pôông lau pí xò rung à? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Chăng phải xí xì ái ới ùn ti xa tể hẩu cày chi - mộch moón àn tlang phục tloong nhung gầm hay chăng? Hẩu rạ, moón mặc nhung gầm xì ở tloong cung vua. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Ngược lái, ái ới ùn ti xa tể hẩu cày chi - mộch tiên tli tùng chăng? Tôi vé côống ái ới ùn, tùng rối ôộng tềng nổi hơn cả mộch tiên tli. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Rì là vến nọ mà lới ní tà àn chẻp: 'Hẩu rạ, Ho tang khai sừ giả của Ho ti tlưởc mặt con, nọ sẻ roón khà của con tlưởc mặt con.'<verse eid="MAT 11:10" /></para>
  <para style="b" />
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />Xật sứ, tôi vé côống ái ới ùn, chăng ôông ay àn nơng lêng tloong cảc moón àn phú nử teẻ xa là cao tlóng hơn Giăng Báp-tít, mơi moón énh nhẩt tloong vương quổc thiên đáng xì cao tlóng hơn nọ. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Mơi, pở ngáy của Giăng Báp-tít cho tềng nay, vương quổc thiên đáng chíu đồi diến côống páo lực, mân cảc moón hung tán lế khửc mánh chiềm đoạt reé. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Ví tẩt cả cảc tiên tli ôộng luật phảp tà pào tlưởc cho tềng Giăng; <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />ôộng nều ái ới ùn khẳn loóng chẩp nhấn, thì ôông rì là Ê-li, moón phải tềng. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Ay cò xai tể tlằng, hảy tlằng. <verse eid="MAT 11:15" /><verse number="16" style="v" sid="MAT 11:16" />Mơi tôi sẻ so sành thề hế ní côống tiếu chi? Reé xì chôồng như tán rẻt ngối ở phồ chớ, mà phè rố hôổc phố, <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />xí ní: ‘Tán ho thổi khào cho tán pay, mơi tán pay chăng dảch mùa. Tán ho than vản mà tán pay chăng nhám.' <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />Ví Giăng tềng, chăng ăn yý chăng oòng, xì maáng pảo: 'Ôông ha pí quỷ ềm.' <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Con Moón tềng, ăn ôộng oòng, xì maáng vé: 'Hẩu ôông ha rạ, mộch moón xam ăn, mộch xên nghiến ráo, pán của tán thu thuề mân đàm moón xối lổi!' Mơi rối sứ khôn ngoan àn chừng minh pởi cảc con cài của nọ."<verse eid="MAT 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Khâu rì, Ngái pẳt tấu tlẻch vằng cảc thánh mà khênh hểt cảc phẻp lá của Ngái àn mấn xa ở cảc thánh rì, ví maáng tà chăng ăn năn. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />"Khồn nán cho dâu, Cô-ra-xin! Khồn nán cho dâu, Bết-sai-đa! Vi nều cảc việc quyến năng xảy xa khừa tán pay tà àn mấn xa ở Ty-rơ ôộng Si-đôn, xì chẳc là phè tà ăn năn tloong pải xô mân pun pụn pở lô rối. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Mơi, Ho vé côống tán pay, sẻ cò sứ lời chíu hơn cho Ty-rơ ôộng Si-đôn tloong ngáy phàn xẻt hơn là cho tán pay. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Cón dâu, Ca-bê-na-um, chăng lẻ dâu sẻ àn nơng cao tềng tlỏng tlới? Dâu sẻ ti xuồng tềng tlỏng âm phủ. Ví nều cảc việc quyến năng xảy xa tược dâu tàn àn xảy xa ở Sô-đôm, xì chẳc là thánh rì tà cón lái cho tềng ngáy nay. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Xí mơi, Ho vé côống tán pay, tloong ngáy phàn xẻt, tẩt cả sẻ lời chíu cho tẩt Sô-đôm hơn là cho tán pay.<verse eid="MAT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Pao caá rì, Chùa Giê-xu lêng xiềng thưa: "Láy Cha, là Chùa của tlới ôộng tẩt, con ngơới khen Cha, ví Cha tà chù kìn cảc tiếu ní khỏi moón khôn ngoan mân moón tli thửc, mơi páy tỏ phè cho con rẻt. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Vâng, thưa Cha, ví tiếu như xí là tiếu phưa ỳ tlưởc mặt Cha. <verse eid="MAT 11:26" /><verse number="27" style="v" sid="MAT 11:27" />Tẩt cả việc tà àn Cha tôi giao phò cho tôi; chăng ôông ay mẳt Con tlứ xa Cha, yý chăng ôông ay mẳt Cha tlứ xa Con mân ôông ay mà nều Con moành páy tỏ cho. <verse eid="MAT 11:27" /><verse number="28" style="v" sid="MAT 11:28" />Hảy tềng côống tôi, hớ tẩt cả ôông ay lao nhoọc mân chíu tliêng nắng, ôộng tôi sẻ cho ái ới ùn sứ yên nghỉ. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Hảy vang lế ẻch của tôi tlêng ái ới ùn mân hoọc pở ở tôi, ví tôi cò loóng nhu mí mân khiêm nhướng, rối ái ới ùn sẻ xím àn sứ yên nghỉ cho linh hốn mếng. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Ví ẻch tôi lời chíu ôộng tliêng tôi nhén nháng."<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Tloong khoảng thới gian rì, Chùa Giê-xu ti qua cảc kènh tôống loó pao ngáy Sa-bát, mơi cảc môn tố của Ngái tòi rêng maáng pẳt tấu pểch cảc pôông loó ôộng ăn. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Mơi khâu khới kỉa tiếu rì, cảc moón Pha-ri-si vé côống Ngái: "Hẩu rạ, cảc môn tố của thấy mấn chuyến chăng àn phẻp mấn tloong ngáy Sa-bát." <verse eid="MAT 12:2" /><verse number="3" style="v" sid="MAT 12:3" />Mơi, Ngái vé côống maáng: "Cảc ôông tà chăng toọc kỉa chuyến Đa-vít tà mấn tloong khới vua mân cảc moón ti côống mếng pí tòi hay chăng? - <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Xí nó vua tà pao tloong nhá của Thiên Chùa ôộng ăn pènh cung hiền, mơi pènh rì xì chăng cho phẻp vua mân cảc moón ti côống vua tể ăn, tlứ xa chỉ dánh cho thấy tề lể? <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Hay cảc ôông tà chăng toọc kỉa tloong luật phảp là pao ngáy Sa-bát, cảc thấy tề lể tloong tến thớ vi phám ngáy Sa-bát mà maáng xì chăng cò xối à? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Mơi tôi vé côống cảc ôông là mộch Tầng náy hơn tến thớ tang ở ní. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Mơi nều cảc ôông xì tà hay mẳt ỳ nghỉa câu ní là xí nó: 'Ho moành loóng xương xỏt mà chăng phải sinh tề.' xì chẳc là cảc ôông tà chăng lêng àn cảc moón chăng cò xối. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Ví Con Moón là Chùa của ngáy Sa-bát.<verse eid="MAT 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Ôộng khới tà ti khỏi rì, Ngái pao tloong nhá hối của maáng. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Hẩu rạ, mộch moón cò xay pí teo, ôộng maáng poi Chùa Giê-xu, xí ní: "Cò phải àn phẻp chửa pếng tloong ngáy Sa-bát?" tể cho maáng cò thể tồ cào Ngái. <verse eid="MAT 12:10" /><verse number="11" style="v" sid="MAT 12:11" />Mơi Ngái vé côống maáng: "Cò moón nó tloong cảc ôông, mà moón rì cò mộch con chiên, ôộng nều reé rúng xuồng hù pao ngáy Sa-bát, xì moón rì sẻ chăng nằm chặt lế reé mân kèo lêng chăng? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Ôộng rối con moón xì quỳ già hơn con chiên mẳt cớ nó! Xí rêng, àn phẻp mấn việc lénh pao ngáy Sa-bát." <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Khâu rì, Ngái vé côống moón rì: "Hảy duổi xay của ái xa." Moón rì duổi xay xa ôộng reé àn phục hối nôống lăng, chôồng như pán xay kia. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Mơi khâu khới ti xa, cảc moón Pha-ri-si lập mưu chồng lái Ngái xí nó cho maáng cò thể giểt Ngái.<verse eid="MAT 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Mơi ví tà mẳt như xí, Chùa Giê-xu ti khỏi tược rì. Nhiếu moón tà ti xeo Ngái, rối Ngái chửa lénh cho tẩt cả maáng. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Ôộng Ngái kẻnh pào maáng tể maáng má mấn cho Ngái lố diến, <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />tể cho lới tà àn phàn qua tiên tli Ê-sai àn ừng nghiếm, xí ní:<verse eid="MAT 12:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="MAT 12:18" />“Hẩu rạ, moón hấu Ho, Moón mà Ho tà chón;</para>
  <para style="q" vid="MAT 12:18">Moón yêu dầu của Ho, mà ở Nọ, linh hốn Ho hoán toán phưa loóng.</para>
  <para style="q" vid="MAT 12:18">Ho sẻ tệch thấn Ho tlêng Nọ,</para>
  <para style="q" vid="MAT 12:18">ôộng Nọ sẻ rao giảng sứ côông chình cho cảc moón ngoái quổc.<verse eid="MAT 12:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="MAT 12:19" />Nọ sẻ chăng cải phố hay rố lêng;</para>
  <para style="q" vid="MAT 12:19">yý chăng ay sẻ măng xiềng Nọ tlêng khà phồ.<verse eid="MAT 12:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="MAT 12:20" />Nọ sẻ chăng pẻ câl lâu tà pí giập;</para>
  <para style="q" vid="MAT 12:20">Nọ sẻ chăng dập xim tén khênh xẳt,</para>
  <para style="q" vid="MAT 12:20">Cho tềng khới nó Nọ tưa sứ côông chình tềng chiền thằng, <verse eid="MAT 12:20" /><verse number="21" style="v" sid="MAT 12:21" />ôộng cảc moón chăng phải Do Thài sẻ hy voóng ở danh Nọ."<verse eid="MAT 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Khâu rì, mộch moón mú ôộng câm pí quỷ ềm àn tom tềng cho Ngái, rối Ngái chửa lénh cho moón rì, tềng nổi moón câm ní vé àn ôộng hẩu kỉa. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Cả đoán dân tếu kinh ngạc ôộng vé: "Chăng lẻ moón ní là Con của Đa-vít?" <verse eid="MAT 12:23" /><verse number="24" style="v" sid="MAT 12:24" />Cón cảc moón Pha-ri-si, khâu khới măng chuyến ní, tà vé: "Ôông ha chăng tlục xuẩt àn quỷ nều chăng phải là pởi Bê-ên-xê-bun, nghỉa là chùa quỷ." <verse eid="MAT 12:24" /><verse number="25" style="v" sid="MAT 12:25" />Mơi ví tà mẳt ỳ nghỉ của maáng, Ngái vé côống maáng: "Tẩt cả vương quổc pí chia rẻ chồng lái chình mếng xì pí tan hoang, ôộng tẩt cả cảc thánh hay nhá pí chia rẻ nghịch côống chình reé xì sẻ chăng từng vửng. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Nều Sa-tan tlục xuẩt Sa-tan, xì reé pí chia rẻ chồng lái chình reé. Xí xì, mấn xí nó vương quổc reé sẻ từng vửng? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Ôộng nều tôi pởi Bê-ên-xe-bun tlục xuẩt cảc quỷ, xì con cảc ôông pởi ôông ay tlục xuẩt phè? Ví lỳ do ní, phè sẻ là cảc moón xẻt đoàn cảc ôông. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Mơi nều tôi tuổi quỷ pởi Thành Linh của Chùa Tlới, xí xì vương quổc Chùa Tlới tà tềng tlêng cảc ôông. <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />Hay mấn xí nó cò thể pao tloong nhá của moón nôống khửc ộng lốm tố của nọ nều tlưởc tiên moón rì chăng tlòi moón nôống khửc rì lái? Rối khâu rì, moón ní sẻ cưởp hểt nhá ái ha. <verse eid="MAT 12:29" /><verse number="30" style="v" sid="MAT 12:30" />Ay chăng ở côống tôi là chồng lái tôi, mân ai chăng nhòm hiệp chung côống tôi xì tan tảc. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Ví lỳ do ní, tôi vé côống cảc ôông, tẩt cả xối lổi mân lới phám thướng sẻ àn tha cho maáng, mơi lới phám tềng Thành Linh sẻ chăng àn tha. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Nều ay vé lới chồng nghịch Con Moón, xì moón rì sẻ àn tha thừ. Mơi nều moón nó vé nghịch côống Chùa Thành Linh, xì moón rì sẻ chăng àn tha thừ, cả tloong tới ní hay tloong tới pú tềng. <verse eid="MAT 12:32" /><verse number="33" style="v" sid="MAT 12:33" />Hay là, chăm câl tổt xì tlày reé tổt, hay chăm câl xầu xì tlày reé xầu, ví câl àn mẳt pởi tlày của reé. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Doóng dỏi xành lục kia, ví là ảc, cảc ôông mấn xí nó cò thể vé tiếu tổt? Ví mếng vé xa pở cày cò tấy tloong loóng. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Moón lénh, xuẩt phảt pở cày chẩt chừa tổt lénh của mếng teẻ xa tiếu lénh, mơi moón ảc, xuẩt phảt pở cày chẩt chừa gian ảc của mếng, teẻ xa tiếu ảc. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Mơi tôi vé côống cảc ôông là tẩt cả lới vô ỉch mà maáng vé, maáng sẻ tưa xa lới khai tlính vến reé tloong ngáy phàn xẻt. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Ví pở ở cảc lới khề của mếng, cảc ôông sẻ àn xưng côông chình, ôộng pở ở cảc lới khề của mếng, cảc ôông sẻ pí kểt àn.<verse eid="MAT 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Khâu rì, mộch sồ thấy táy luật mân moón Pha-ri-si tà vé côống Ngái, xí ní: "Thưa thấy, tán tôi moành kỉa ở thấy mộch dầu lá." <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />Mơi Chùa Giê-xu tlả lới lái, Ngái vé côống maáng: "Mộch thề hế gian ảc mân gian dâm xím kiềm mộch dầu lá, mơi chăng cò dầu lá nó sẻ àn pan cho reé, tlứ xa dầu lá của tiên tli Giô-na. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Vi Giô-na tà ở tloong tlống con cà náy pa ngáy ôộng pa têm xí nó, xì Con Moón sẻ ở pa ngáy ôộng pa têm tloong loóng tẩt xí rì. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Tloong ngáy phàn xẻt, dân Ni-ni-ve sẻ từng lêng côống thề hế ní ôộng sẻ lêng àn reé. Ví maáng tà ăn năn tlưởc lới rao giảng của Giô-na, mà hẩu ní, Tầng cao tlóng hơn Giô-na ở ní. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Tloong ngáy phàn xẻt, nử hoáng phương Nam sẻ từng lêng côống thề hế ní ôộng sẻ lêng àn reé, ví pở cảc tược tấn cúng của tẩt, mú tà tềng tể măng sứ khôn ngoan của Sa-lô-môn, mà hẩu ní, Tầng cao tlóng hơn Sa-lô-môn ở ní. <verse eid="MAT 12:42" /><verse number="43" style="v" sid="MAT 12:43" />Cón nửa, khới linh ô uề tà ti khỏi mộch moón, reé păng qua cảc tược khô hán, xím tược hơi mai mơi chăng kỉa. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Caá rì, reé pảo: 'Ho sẻ tlở lái tái nhá ho mà ho tà xa ti pở tược rì.' Khâu khới tềng, reé phảt hiến cày nhá rỏ, tà àn quẻt roón quang mân xểp tệch ngăn nẳp. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Khâu rì, reé ti ôộng tưa vến chung côống reé pảy linh khảc cón gian ảc hơn reé, ôộng khới tà pao tloong, cả tán khôồng ở rì. Rối kểt cục của moón rì tlở rêng tối tế hơn caá tấu. Chuyến yý sẻ là như xí đồi côống thề hế gian ảc ní."<verse eid="MAT 12:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Tloong khới Ngái vẩn cón tang vé côống tán dân, hẩu rạ, mế ôộng cảc ùn của Ngái xì tà từng khà vái, xím cảch tể khề chuyến côống Ngái. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Caá ní, mộch moón kia thưa côống Ngái: "Hẩu rạ, mế thấy ôộng cảc ùn của thấy tà từng khà vái, xím cảch tể khề chuyến côống thấy." <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />Mơi khới tlả lới, Ngái vé côống moón khề chuyến côống mếng: "Ôông ay là mế tôi mân ôông ay là cảc ùn của tôi?" <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Rối khâu khới tưa xay mếng hường vến cảc môn tố của mếng, Ngái vé: "Hẩu rạ, mế tôi mân cảc ùn của tôi ní! <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Ví nều moón nó mấn xeo ỳ moành của Cha tôi tlêng thiên đáng, xì moón rì là ùn từa, ùn cài mân mế của tôi."<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Tloong ngáy rì, khâu khới ti xa khỏi nhá, Chùa Giê-xu ngối khà nâấm piển. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Đoán dân rẩt khòm tà nhòm lái chung quenh Ngái. Tềng nổi, khâu khới pưởc lêng mộch cày thuyến, Ngái ngối xuồng, mơi cả tán dân xì từng tlêng nâấm. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Rối Ngái vé côống maáng nhiếu tiếu pắng ẩn dú, xí ní: "Hẩu ní, mộch moón oải giôồng ti xa tể oải. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Caá oải giôồng, mộch sồ hột rúng pêng khà, xì chim tlới tềng mân ăn hểt phè. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Mộch sồ khảc rúng tlêng tẩt phú sỏi, là tược chăng cò nhiếu tẩt xịt. Ngay caá rì, hột giôồng moọc mấm, ví lởp tẩt chăng cò khu. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Mơi khâu khới mặt tlới moọc lêng, reé tà pí xiêu tổch mân khô hèo ví chăng cò reè. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Cón mộch sồ khảc rúng khừa cảc câl khoóng, xì cảc câl khoóng náy lêng ôộng chén ẻp phè. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Mà sồ khảc nửa rúng tlêng tẩt tổt ôộng cho xa hoa mấu, hột xì mộch tlăm lấn nhiếu hơn, hột xì phầu chục, hột xì pa chục. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Ay cò xai, hảy tlằng.”<verse eid="MAT 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Rối cảc môn tố, khâu khới lái khênh, tà thưa côống Ngái: "Ví lỳ do chi mà thấy lái vé pắng cảc ẩn dú côống tán dân?" <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />Xí là, khới tlả lới, Ngái tà vé côống maáng xí ní: "Đồi côống ái ùn xì tà àn pan cho tể hay mẳt cảc mấu nhiếm vến vương quổc thiên đáng, cón đồi côống cảc moón rì xì chăng àn pan cho. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Pởi moón nó cò, xì vến phấn moón rì sẻ àn cho xêm, ôộng moón rì sẻ àn dư dả. Mơi moón nó chăng cò, xì sẻ pí lế ti khỏi nọ ngay cả tiếu moón rì tang cò. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Ví lỳ do ní, thấy vé côống maáng pắng ẩn dú; ví ngay cả cò hẩu, maáng chăng hay mẳt; ôộng ngay cả măng, maáng chăng măng àn, yý chăng hiểu àn. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />Ôộng ới tiên tli của Ê-sai àn ừng nghiếm vến maáng, xí ní:</para>
  <para style="q" vid="MAT 13:14">‘Đồi côống việc măng, cảc con sẻ lằng xai, mơi chẳc chằn cảc con sẻ chăng hiểu</para>
  <para style="q" vid="MAT 13:14">cón khới hẩu, cảc con sẻ iềng hẩu, mơi chẳc chằn cảc con sẻ chăng hẩu kỉa.<verse eid="MAT 13:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MAT 13:15" />Ví loóng dân ní tà tlở rêng ngu dổt;</para>
  <para style="q" vid="MAT 13:15">xai maáng tà măng rẩt khò khăn,</para>
  <para style="q" vid="MAT 13:15">ôộng maáng nhằm mẳt mếng,</para>
  <para style="q" vid="MAT 13:15">chăng rưởi maáng cò thể hẩu kỉa pắng mẳt,</para>
  <para style="q" vid="MAT 13:15">măng pắng xai,</para>
  <para style="q" vid="MAT 13:15">hiểu pắng tầm loóng</para>
  <para style="q" vid="MAT 13:15">rối quay tlở lái,</para>
  <para style="q" vid="MAT 13:15">ôộng Ho chửa lénh maáng.<verse eid="MAT 13:15" /></para>
  <para style="b" />
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />Mơi phưởc quà cho mẳt của ái ới ùn, ví kỉa àn, ôộng xai của ái ới ùn, ví măng àn. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Xật sứ, thấy vé côống ái ới ùn là nhiếu tiên tli ôộng moón côông chình moong ưởc tể kỉa cày chi ái ùn kỉa, mơi maáng tà chăng kỉa àn, ôộng tể măng cày chi ái ùn măng, mơi maáng tà chăng măng àn. <verse eid="MAT 13:17" /><verse number="18" style="v" sid="MAT 13:18" />Rêng, ái ùn hảy măng ẩn dú vến moón oải giôồng. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Tẩt cả moón măng đáo của vương quổc mà chăng hiểu, xì ma quỷ tềng ôộng cưởp ti tiếu tà àn oải tloong loóng moón rì. Ní là hột giôồng pí oải pêng khà. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Cón hột giôồng pí oải pao tẩt phú sỏi, rì là moón măng đáo ôộng liến nhấn lế đáo côống loóng hân hoan; <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />mơi moón rì chăng cò rè tloong mếng, chỉ là cò tám thới; xí rối khổ nán hoặc pửc hái xảy tềng pởi ví đáo, xì moón rì liến lảc loóng tin. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Cón hột giôồng pí oải khừa cảc câl khoóng, ní là moón măng đáo, mơi cảc lo lằng vến tới ní mân ảo tưởng của sứ chấu cò mấn cho đáo rì pí nghẹt mân reé tlở rêng chăng kểt tlày àn. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Mơi hột giôồng àn oải tlêng tẩt tổt, rì là moón măng đáo mân hiểu, moón rì xật kểt tlày mân teẻ xa mộch thánh mộch tlăm, mộch thánh phầu mươi, mộch thánh pa mươi."<verse eid="MAT 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Ngái páy xa tlưởc maáng mộch ẩn dú khảc, xí ní: "Vương quổc thiên đáng àn hẩu như mộch moón tà oải giôồng tổt tloong roóng mếng. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Mơi caá maáng tảy, keẻ thú của ôông rì tềng mân oải cỏ lúng xen pao khừa loó mí rối ti khỏi. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Khới câl loó náy lêng mân kểt hột, xì cỏ lúng yý pí lố xa. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Caá ní, cảc moón hấu của moón chủ rì, khâu khới tềng, tà vé côống ôông: 'Thưa ôông chủ, chăng phải ôông tà oải hột giôồng tổt tloong roóng mếng à? Xí, cỏ lúng pở nó mà cò?' <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Xí là ôông pảo maáng: 'Mộch moón thú địch tà mấn chuyến ní.' Rối cảc moón hấu thưa côống ôông: 'Xí, ôông cò moành khới xa rì, tán tôi dôổc hểt phè chăng?' <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Mơi chủ tlả lới; 'Má, rưởi là tang khới dôổc cỏ lúng, mầy ái cò thể dôổc loó mí chung ôộng phè. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Hảy tể cả han àn côống náy lêng cho tềng tlỏng ngáy thu hoạch, ôộng pao thới điểm thu hoạch, tôi sẻ pảo cảc thớ cảch: Tlưởc hểt, hảy gom cỏ lúng lái mân puộc phè thánh pò tể tổch phè ti, mơi hảy gom loó mí pao tloong kho của tôi'."<verse eid="MAT 13:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Ngái páy xa tlưởc maáng mộch ẩn dú khảc, xí ní: "Vương quổc thiên đáng xì chôồng như mộch hột cải mà khâu khới lế, mộch moón tà oải tloong roóng mếng; <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />mà hột giôồng rì tuy là énh nhẩt tloong tẩt cả cảc loái hột, mơi khới reé náy lêng, reé náy hơn cảc giôồng câl tloong vướn mân tlở rêng mộch cày câl, tềng nổi chim tlới tềng ôộng mấn ổ tlêng cảc kénh của reé." <verse eid="MAT 13:32" /><verse number="33" style="v" sid="MAT 13:33" />Ngái kể cho maáng mộch ẩn dú khảc: "Vương quổc thiên đáng xì chôồng như men mà khâu khới lế, moón phú nử tà tlốn côống pa tảng pột cho tềng khới cả tảng pột lêng men."<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Chùa Giê-xu tà vé tẩt cả cảc lới rì côống đoán dân pắng ẩn dú; ôộng Ngái chăng vé tiếu chi côống maáng mà chăng pắng ẩn dú. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Xí nó cho lới tà àn phàn qua ví tiên tli àn ừng nghiếm, xí ní: "Ho sẻ vở ménh Ho pắng cảc ẩn dú. Ho sẻ rao giảng cảc tiếu tứng àn chù kìn pở caá mấn rêng thề giời."<verse eid="MAT 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Khâu rì, khới tà ti khỏi đoán dân khòm, Ngái ti pao nhá. Cảc môn tố Ngái tềng khênh Ngái, thưa: "Cườn giải thỉch cho tán tôi ẩn dú vến cỏ lúng tloong roóng loó." <verse eid="MAT 13:36" /><verse number="37" style="v" sid="MAT 13:37" />Caá ní, khới tlả lới, Ngái vé: "Moón oải giôồng tổt là Con Moón, <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />mà roóng loó là thề gian, cón hột giôồng tổt - ní là con cài của vương quổc. Ngược lái, cỏ lúng là con cài của moón ảc, <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />mà keẻ thú, là keẻ tà oải phè, là ma quỷ. Cón múa cảch là thới ký tấn thề, mà cảc thớ cảch là thiên sừ. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Rêng, xí nó mà cỏ lúng àn gom lái mân pí tổch tloong lửa, xì việc yý sẻ xảy xa như xí pao ký tấn thề. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Con moón sẻ khai phài cảc thiên của mếng, ôộng maáng sẻ gom xa khỏi vương quổc Ngái tẩt cả cảc xừ mấn cho vẩp phém côống cảc moón mấn tiếu gian ảc. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Ôộng maáng sẻ nèm phè pao ló lửa, là tược sẻ cò sứ than nhám mân nghiền xăng. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Caá rì, cảc moón côông chình sẻ tlàng chòi như mặt tlới tloong vương quổc của Cha maáng. Ay cò xai, hảy măng.”<verse eid="MAT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />"Vương quổc thiên đáng xì chôồng như mộch kho bầu àn chù tloong kènh tôống kia, là xừ mà mộch moón tà chù ti khâu khới xím kỉa. Pởi ví niếm phui sường của mếng, moón rì lêng khà, paành hểt tẩt cả cảc xừ mếng cò mân mua kènh tôống rì. <verse eid="MAT 13:44" /><verse number="45" style="v" sid="MAT 13:45" />Cón nửa, vương quổc thiên đáng xì chôồng như mộch moón, là thương nhân, xím kiềm ngoọc châu quỳ già. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Xí rối, caá tà xím àn mộch viên ngoọc châu rẩt là quỳ già, xì khâu khới ti khỏi, ái tà paành hểt tẩt cả cảc xừ mếng cò ôộng mua reé.<verse eid="MAT 13:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />Cón nửa, vương quổc thiên đáng xì chôồng như mộch cày lài àn nèm xuồng piển ôộng pẳt lêng tủ muôn loái. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Mà caá lài tà tấy, maáng kèo pao nâấm, ôộng khâu khới ngối xuồng, maáng gom cảc vật tổt pao tloong giỏ tứng, cón mầy xừ chăng cò già tlí, maáng lảc xa vái. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Tẩt cả sẻ là như xí pao ký tấn thề: Cảc thiên sừ sẻ ti xa, mân sẻ phân chi tán gian ảc khỏi khừa cảc moón côông chình, <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />rối maáng sẻ nèm tán rì pao ló lửa, là tược sẻ cò sứ than nhám mân nghiền xăng.<verse eid="MAT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />“Ái ùn tà hiểu hểt tẩt cả cảc tiếu ní chưa?" Maáng thưa cô ống Ngái: "Dạ." <verse eid="MAT 13:51" /><verse number="52" style="v" sid="MAT 13:52" />Caá ní, Ngái vé côống maáng: "Ví lỳ do ní, mổi thấy táy luật tà àn táy cho vương quổc thiên đáng xì chôồng như mộch moón chủ nhá, là moón tom xa tố cù mân tố mời pở tloong kho bầu của mếng." <verse eid="MAT 13:52" /><verse number="53" style="v" sid="MAT 13:53" />Việc xảy xa rì là khới Chùa Giê-xu kểt thủc cảc ẩn dú ní, Ngái tà ti khỏi tược rì.<verse eid="MAT 13:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 13:54" />Ôộng khâu khới ti tềng quê nhá mếng, Ngái tà táy dổ tán dân tloong nhá hối của maáng, tềng nổi mấn maáng kinh ngạc ôộng vé: "Sứ khôn ngoan rì côống cảc phẻp lá pở ở moón ní xa pở nó? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Chăng phải moón ní là con từa ôông thớ mộc à? Chăng phải mế ôông rì àn hôổc là Ma-ri, mân cảc ùn từa của ôông ha là Gia-cơ, Giô-sép, Si-môn ôộng Giu-đa à? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Chăng phải tẩt cả cảc ùn cài của ôông ha tang ở côống tán ha à? Rêng, tẩt cả tiếu ní pởi ôông rì xa pở nó?" <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Maáng pí vẩp phám pởi Ngái. Mơi Chùa Giê-xu vé côống maáng: "Tiên tli chăng pí khinh thướng, tlứ xa ở quê nhá mếng ôộng tloong gia đính mếng." <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Ngái tà chăng mấn nhiếu phẻp lá ở rì ví loóng chăng tin của maáng.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Pao thới điểm rì, vua chư hấu Hê-rốt măng tin vến Chùa Giê-xu. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Vua vé côống cảc moón hấu mếng: "Rì là Giăng Báp-tít. Ôông rì tà àn mấn khôồng lái pở cày chểt, rêng pởi xí, cảc việc quyến năng tang mấn xa pở moón ní." <verse eid="MAT 14:2" /><verse number="3" style="v" sid="MAT 14:3" />Pởi Hê-rốt, khâu khới pẳt Giăng, tà cho xỉch ôông ôộng giam pao ngục, ví pởi Hê-rô-đia, du của Phi-líp, ùn từa vua. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Ví Giăng tà vé côống vua: "Vến phấn vua, chăng àn phẻp lế mú ha." <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Ôộng ngay cả moành giểt ôông rì ti, mơi vua rưởi tán dân, ví maáng hẩu Giăng như mộch tiên tli. <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />Mơi khới tềng tiệc sinh nhật của Hê-rốt, con cài của Hê-rô-đia daảch mùa ở khừa tiệc mân mấn phưa loóng Hê-rốt, <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />pởi xí, vua tà hừa côống mộch lới thế tể pan cho vaá pẩt ký tiếu chi mà vaá cườn. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Caá ní, khới tà pí xui giục tlưởc rì pởi mế mếng, vaá thưa: "Cườn cho con ngay ở ní, cày tlổc của Giăng Báp-tít ở tlêng vâm." <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Ôộng ngay cả puốn phiến, mơi ví pởi lới thế của mếng mân cảc quan khẻch côống ngối ăn, vua tà xa lếnh tể reé àn pan cho. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Khâu khới khai moón ti, vua cho chạch tlổc Giăng tloong ngục. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Tlổc của ôông àn tom tềng ở tlêng vâm rối àn tưa cho reé, ôộng reé tom cho mế mếng. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Khới tềng khênh àn rối, cảc môn tố của ôông lế xảc mân pầm reé. Ôộng caá tà ti tềng, maáng kể lái cho Chùa Giê-xu.<verse eid="MAT 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Caá ní, khới măng rối, Chùa Giê-xu ti khỏi rì tloong mộch cày thuyến hường tềng tược hoang vằng ở riêng mộch mếng. Ví hay àn như xí, cảc đoán dân pở cảc thánh ti pố xeo Ngái. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Ôộng khâu khới ti xa, Ngái kỉa mộch đoán moón khòm lặm, xì tôống loóng xương xỏt côống cảc moón dân ôộng Ngái chửa lénh cảc moón tâu yều của maáng. <verse eid="MAT 14:14" /><verse number="15" style="v" sid="MAT 14:15" />Caá ní, khới tềng khuống xồn, cảc môn tố tềng côống Ngái, thưa: "Tược ní xì hoang vằng, ôộng giớ ní xì muốn rối. Cườn thấy giải tàn tán dân tể khới ti tềng cảc láng rối, maáng cò thể mua thửc ăn cho mếng." <verse eid="MAT 14:15" /><verse number="16" style="v" sid="MAT 14:16" />Mơi Chùa Giê-xu vé côống maáng: "Maáng chăng cò nhu cấu ti vến. Ái ùn hảy cho maáng ăn." <verse eid="MAT 14:16" /><verse number="17" style="v" sid="MAT 14:17" />Caá rì, maáng thưa côống Ngái: "Ở ní tán tôi chăng cò cày chi tlứ xa răm cày pènh ôộng han con cà." <verse eid="MAT 14:17" /><verse number="18" style="v" sid="MAT 14:18" />Rối Ngái pảo: "Hảy tom phè tềng ní cho thấy." <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Ôộng khới truyến cho đoán dân ngối xuồng tlêng cỏ rối, caá cấm răm cày pènh ôộng han con cà, ngảc mặt lêng tlới, Ngái chủc tá, mân pẻ xa, Ngái tưa thửc ăn cho cảc môn tố, cón cảc môn tố phân phảt cho tán dân. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Tẩt cả tán dân tà ăn ôộng àn ro tlống. Rối maáng xón phấn thứa lái pở cảc ménh pẻ vún - àn mưới han giỏ tấy. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Caá ní, sồ moón ăn là khoảng răm nghín tán ôông, chưa tình phú nử mân con rẻt.<verse eid="MAT 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Ngay caá rì, Ngái hồi thủc môn tố pưởc pao tloong thuyến ôộng ti tlưởc Ngái qua nâấm táng kia, tloong caá Ngái giải tàn tán dân. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Caá tà cho tán dân vến, Ngái ti lêng tlêng nùi tể tứ cấu nguyến riêng. Tềng xồn, Ngái ở rì mộch mếng. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Cón cày thuyến ở khừa piển rối xò pí soòng tành nghiêng ngả ví xò ngược. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />Caá ní, pao kenh pồn têm rì, Ngái tềng côống maáng, khới ti pố tlêng piển. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Mơi khâu khới kỉa Ngái pưởc ti tlêng piển, cảc môn tố pí kinh hoảng, vé xí ní: "Rì là ma," rối maáng rố lêng tloong cơn kinh rưởi. <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />Xí là, Chùa Giê-xu liến lêng xiềng côống maáng xí ní: "Can đảm lêng! Là thấy ní. Má rưởi!" <verse eid="MAT 14:27" /><verse number="28" style="v" sid="MAT 14:28" />Caá ní, khới tlả lới lái Ngái, Phi-e-rơ thưa: "Láy Chùa, nều là thấy, cườn truyến cho tôi ti tlêng rảc tềng côống thấy." <verse eid="MAT 14:28" /><verse number="29" style="v" sid="MAT 14:29" />Rối Ngái truyến: "Hảy tềng ti." Ôộng khâu khới pưởc xa khỏi thuyến, Phi-e-rơ tà pưởc ti tlêng rảc tể tềng côống Chùa Giê-xu. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Mơi khới kỉa xò mánh, ôông rưởi, ôộng pẳt tấu chím xuồng, ôông rố lêng, xí ní: "Chùa ới, cườn cừu tôi!" <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />Ngay caá rì, khâu khới giơ xay xa, Chùa Giê-xu nằm lế Phi-e-rơ ôộng pảo ôông: "Hớ moón ét đửc tin, pởi lỳ do chi ái nghi ngớ?" <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />Caá maáng pưởc lêng tlêng thuyến rối, xò ngứng xổi. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Cón cảc moón tloong thuyến xì thớ láy Ngái, xí ní: "Xật sứ, thấy là con Thiên Chùa."<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Caá ti qua táng kia rối, maáng ti pao nâấm ở Ghê-nê-xa-rết. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Khâu khới nhấn xa Ngái, tán dân ở tược rì khai moón tưa tin khồm khu vực chung quenh rì, ôộng maáng tom tềng cho Ngái tẩt cả moón vẳc pếng. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Maáng cườn Ngái chỉ tể mếng cò thể chám pao vạt ào của Ngái, ôộng pẩt kể là ôông ay chám pao xì àn chửa lénh.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Khâu rì, cảc moón Pha-ri-si ôộng thấy táy luật pở Giê-ru-sa-lem tềng côống Chùa Giê-xu, vé xí ní: <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />"Rêng nó cảc môn tố của thấy vi phám cảc truyến thồng của cảc tlưởng lảo? Pởi tán maáng chăng xửa xay khới ăn pèng." <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />Mơi khới tlả lới lái, Ngái vé côống maáng: "Rêng nó cảc ôông lái vi phám tiếu răn của Thiên Chùa ví pởi cảc truyến thồng của mếng? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Pởi Thiên Chùa tà truyến táy, xí ní: "Hảy hiều kình pồ mế của con,' ôộng 'Moón nó phỉ pàng pồ hay mế, hảy giểt chểt moón rì.' <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Mơi cảc ôông pảo: ‘Ôông ay vé côống pồ hay mế mếng: ‘Pẩt cừ tiếu chi pở con cò thể ỉch lới cho pồ mế tếu là của lể dơng lêng Thiên Chùa rối,'" <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />xì moón rì hoán toán chăng phải hiều kình pồ mếng.' Như xí, cảc ôông tà huỷ ti lới Thiên Chùa ví pởi truyến thồng của mếng. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Tán đáo đửc giả kia! Ê-sai tà tiên pào rẩt tùng vến cảc ôông, xí ní:<verse eid="MAT 15:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MAT 15:8" />‘Dân ní tôn kình ho ở tấu môi chỏt lài,</para>
  <para style="q" vid="MAT 15:8">phè xì ở giang khỏi Ho.<verse eid="MAT 15:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MAT 15:9" />Mà phè thớ phướng Ho là vô ỉch,</para>
  <para style="q" vid="MAT 15:9">là cảc luật lế của con moón'.”<verse eid="MAT 15:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="MAT 15:10" />Rối khâu khới hôổc tán dân tềng, Ngái vé côống maáng: "Hảy măng ôộng hiểu: <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Chăng tiếu chi ti pao tloong ménh mấn cho ô uề mộch moón, mơi là tiếu pở ménh phảt xa, cày ní mấn cho ô uề moón rì." <verse eid="MAT 15:11" /><verse number="12" style="v" sid="MAT 15:12" />Khâu rì, khới tà tềng khênh, cảc môn tố thưa côống Ngái: "Thấy mẳt là cảc moón Pha-ri-si tà kỉa pí xủc phám khâu khới măng lới rì chăng?" <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />Mơi khới tlả lới, Ngái pảo: "Tẩt cả câl mà Cha tlêng tlới của thấy chăng tlôông sẻ pí dôổc cả côổc. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Tể mặc maáng! Maáng là cảc moón hường dẩn tun mú. Mà nều moón mú dẩn moón mú, xì cả han sẻ pổ xuồng hù." <verse eid="MAT 15:14" /><verse number="15" style="v" sid="MAT 15:15" />Caá ní khới tlả lới lái, Phi-e-rơ thưa côống Chùa: "Cườn giải thỉch cho tán tôi ẩn dú rì." <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />Mơi Ngái vé: "Ngay cả tềng caá ní, ái ùn yý chăng hiểu à? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Ái ùn chưa hiểu là tẩt cả cày ti pao tloong ménh xì ti xuồng tlống rối àn thải xa tloong hồ xì à? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Mơi cảc cày pật xa khỏi ménh pẳt tấu pở tầm loóng, ôộng phè mấn ô uề maáng. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Ví pở loóng phảt xa cảc suy nghỉ xầu xa, giểt moón, ngoái tính, gian dâm, lốm cẳp, mấn chừng lẻo ôộng cảc lới phỉ pàng. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Rì là cảc tiếu mấn cho ô uề moón, cón ăn pắng xay chưa xửa xì chăng mấn cho ô uề maáng."<verse eid="MAT 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Rối khâu khới ti xa khỏi rì, Chùa Giê-xu ti vến cảc khu vực của Ty-rơ ôộng Si-đôn. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Ôộng hẩu rạ, mộch phú nử moón Ca-na-an, khâu khới pở púng rì tềng, tà rố lêng, xí ní: "Láy Chùa, Con vua Đa-vít, cườn xương xỏt tôi! Con cài tôi pí quỷ ềm khồn khổ lặm." <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />Mơi Ngái chăng tlả lới lái vaá lới nó. Khâu khới tềng khênh Ngái, cảc môn tố cấu cườn Ngái, xí ní: "Cườn thấy pảo ới rì ti ti, ví ới ha cừ rố rêng khà khâu tán ha." <verse eid="MAT 15:23" /><verse number="24" style="v" sid="MAT 15:24" />Cón caá tlả lới, Ngái vé: "Thấy tà chăng àn khai tềng, nều chăng phải cho cảc chiên lạc của nhá Y-sơ-ra-ên." <verse eid="MAT 15:24" /><verse number="25" style="v" sid="MAT 15:25" />Mơi khâu khới tềng, vaá rì quý cổ cồn xuồng tlưởc Ngái, thưa: "Láy Chùa, cườn cừu giủp tôi." <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />Caá ní, khới tlả lới lái, Ngái vé: "Lế pènh của con cài rối nèm cho chò con là chăng tổt." <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />Mơi vaá rì thưa: "Láy Chùa, tùng xí, chỉ là ngay cả mầy con chò con xì àn ăn ở cảc ménh pènh vún rúng xuồng pở pán của chủ phè." <verse eid="MAT 15:27" /><verse number="28" style="v" sid="MAT 15:28" />Caá rì, tể tlả lới lái, Chùa Giê-xu vé côống vaá: "Hớ moón phú nử kia, đửc tin của ới náy rá. Việc phải àn rêng cho ới xeo như ới moành." Ôộng con cài của vaá àn chửa lénh pở giờ rì.<verse eid="MAT 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Khâu khới ti khỏi púng rì, Chùa Giê-xu ti doọc piển Ga-li-lê, ôộng caá lêng tlêng mộch ngón tốn rối, Ngái ngối tái rì. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Rối cảc đoán dân khòm ti lêng côống Ngái, cò cảc moón qué, moón mú, moón tán tật, moón câm, ôộng nhiếu moón khảc, côống ôộng maáng. Maáng tệch cảc moón rì ở chó Ngái ôộng Ngái chửa lénh cho maáng, <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />tềng nổi, đoán dân kinh ngạc khới kỉa moón câm vé àn, moón tán tật xì àn lénh, moón qué pưởc ti ôộng moón mú hẩu kỉa, rối maáng ngơới khen Thiên Chùa của Y-sơ-ra-ên.<verse eid="MAT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Caá ní, khâu khới hôổc cảc môn tố mếng lái, Chùa Giê-xu pảo: "Thấy cảm xương côống đoán dân, ví maáng tà cừ ở côống thấy pa ngáy rối mà chăng cò chi tể ăn. Thấy chăng moành cho maáng vến tlống tòi, rưởi là maáng cò thể pí ngẩt tlêng khà." <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />Cảc môn tố thưa côống Ngái: “Tloong hoang mạc xì pở nó xa nhiếu pèng như xí tể tán tôi cho tán dân khòm xí kia ăn ro?" <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />Chùa Giê-xu vé côống maáng: “Ái ùn cò cớ nó cày pèng?" Rối maáng tlả lới: “Pảy cày, ôộng mầy con cà énh." <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />Ôộng khâu khới truyến cho tán dân ngối xuồng tlêng tẩt, <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Ngái cấm pảy cày pènh côống mầy con cà, ôộng khâu khới tá ơn, Ngái pẻ xa tưa cho cảc môn tố, rối cảc môn tố phân phảt lái cho tán dân. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Tán dân tếu ăn ôộng àn ro tlống. Maáng thu pảy giỏ tấy phấn thứa của cảc pènh vún. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Caá ní, sồ moón ăn là pồn nghín moón tán ôông, chăng kể phú nử mân con rẻt. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Khới tà cho tán dân vến, Ngái pao tloong thuyến ôộng ti tềng púng Ma-ga-đan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Khâu khới tềng khênh, cảc moón Pha-ri-si ôộng Sa-đu-sê - ví thử Ngái - tà cườn Ngái tỏ cho maáng mộch dầu lá pở tlới. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Mơi caá tlả lới lái, Ngái vé côống maáng: "Khới tềng khuống xồn, cảc ôông pảo: 'Thới tiểt tổt, ví tlới tỏ.': <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />(Tlàng khờm ní xì pảo: 'thới tiểt cò pảo, ví tlới tỏ, u àm.' Tuy cảc ôông mẳt phân piệt sẳc tlới, mơi chăng cò khả năng vến cảc dầu hiếu của thới ký.) <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />"Mộch thề hế hung ảc ôộng gian dâm xím kiềm dấu lá, mơi dầu lá sẻ chăng àn pan cho reé, tlứ xa dầu lá của Giô-na." Ôộng caá lảc maáng lái rối, xì Ngái ti khỏi.<verse eid="MAT 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Cón cảc môn tố xì tà phêng tom xeo pènh, khâu khới ti tềng nâấm táng kia. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Caá ní, Chùa Giê-xu vé côống maáng: "Hảy cẩn thấn ôộng kẻnh giảc vến men của cảc moón Pha-ri-si ôộng Sa-đu-sê." <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />Xí mơi, maáng cừ tlanh luấn côống phố xí ní: "Rì là ví tán ha tà chăng tom xeo pènh." <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />Mơi khới mẳt tiếu ní, Chùa Giê-xu pảo: "Cảc moón ét đửc tin kia, xí nó ái ùn tlanh luấn côống phố rì là pởi mếng chăng cò pèng? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Ái ùn vẩn chưa hiểu ôộng yý chăng căắn răm cày pènh cho răm nghín moón rối ái ùn tà thu àm cớ nó giỏ à? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Hay pảy cày pèng cho pồn nghín moón, rối ái ùn tà thu àn cớ nó giỏ à? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Rêng nó mà ái ùn lái chăng hiểu àn là thấy tà chăng vé chi côống ái ùn vến pènh? Mơi hảy kẻnh vến giảc men của cảc moón Pha-ri-si ôộng Sa-đu-sê." <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Caá rì maáng hiểu xa là Ngái chăng pảo maáng kẻnh giảc men của pènh, mơi là vến giào huần của cảc moón Pha-ri-si ôộng Sa-đu-sê.<verse eid="MAT 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Caá ní, khâu khới ti tềng púng tẩt thánh Xê-sa-rê Phi-líp, Chùa Giê-xu tà poi cảc môn tố mếng, xí ní: "Maáng vé Con Moón là ôông ay?" <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />Rối maáng thưa: "Mộch sồ moón vé là Giăng Báp-tít; cón mộch sồ vé là Ê-li; mơi moón khảc xì vé là Giê-rê-mi hay mộch tloong cảc ví tiên tli." <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />Ngái vé côống maáng: "Cón ái ùn xì vé thấy là ôông ay?" <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />Xí là, khới tlả lới, Si-môn Phi-e-rơ thưa: "Thấy là Chùa Cừu Thề, Con Thiên Chùa luôn luôn khôồng." <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />Caá ní, khới tlả lới lái, Chùa Giê-xu vé côống ôông: "Si-môn, con Giô-na, ái cò phưởc quà, ví chăng phải xịt ôộng mầu tà páy tỏ cho ái, mơi là Cha của thấy tlêng thiên đáng. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Cón thấy yý vé côống ái là ái là Phi-e-rơ, ôộng tlêng tảng phú ní, thấy sẻ xây hối thành của thấy, ôộng cảc cửa của âm phủ sẻ chăng chồng lái àn hối rì. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Thấy sẻ giao cho ái cảc chía khòa của vương quổc thiên đáng, pẩt ký tiếu chi ái puộc tìn tẩt xì sẻ àn puộc tlêng thiên đáng, ôộng pẩt ký tiếu chi ái vở tìn tẩt xì sẻ àn vở tlêng thiên đáng." <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Khâu rì, Ngái nghiêm cầm cảc môn tố tể maáng chăng vé côống ôông ay là Ngái là Chùa Cừu Thề.<verse eid="MAT 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Pở thới điểm rì, Chùa Cừu Thề Giê-xu pẳt tấu cho cảc môn tố của mếng mẳt là Ngái cấn phải ti tềng Giê-ru-sa-lem, ôộng chíu nhiếu khổ nán pở ở cảc tlưởng lảo, cảc thấy tề lể thướng phẩm côống cảc thấy táy luật, rối pí giểt chểt ôộng àn mấn khô ồng lái pao ngáy xừ pa. <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />Ôộng khâu khới kèo Ngái qua mộch pêng, Phi-e-rơ pẳt tấu tlẻch Ngái, xí ní: "Chùa ới, Thiên Chùa tỏ loóng nhân tứ côống thấy. Chuyến rì sẻ chăng caá nó xảy tềng cho thấy." <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />Mơi xoay mếng lái, Ngái vé côống Phi-e-rơ: "Sa-tan kia, hảy ti khuẩt xa khà khâu Ho! Ái là hón phú mấn vẩp chó cho thấy, ví ái chăng lưu tâm tềng cảc việc của Thiên Chùa, mơi là cảc iệc của con moón." <verse eid="MAT 16:23" /><verse number="24" style="v" sid="MAT 16:24" />Khâu rì, Chùa Giê-xu vé côống cảc môn tố Ngái: "Nều ôông ay moành ti xeo thấy, xì moón rì phải tứ chồi chình mếng, côống vảc câl thập tứ của mếng ôộng xeo thấy. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Ví pẩt ký ôông ay moành cừu sứ khôồng mếng xì sẻ vẩt reé, cón moón nó vẩt sứ khôồng mếng ví pởi thấy xì sẻ xím àn reé. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Pởi mộch moón sẻ àn ỉch lới chi nều cò àn cả thề gian, mơi pí vẩt sứ khôồng mếng? Hoặc mộch moón sẻ cho ti tiếu chi tloong việc tổi lái sứ khôồng mếng? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Ví Con Moón pú tềng tloong vinh hiển của Cha Ngái côống ôộng cảc thiên sừ Ngái. Ôộng pao caá rì, Ngái sẻ tlả cho mổi moón tuý xeo việc mấn của maáng <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Xật sứ, thấy vé côống ái ùn là cò mấy moón tang từng ní, là cảc moón chẳc chằn sẻ chăng rềm qua cày chểt cho tềng khới nó maáng kỉa Con Moón tềng tloong vương quổc Ngái."<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Phầu ngáy khâu, Chùa Giê-xu tom xeo Phi-e-rơ, côống Gia-cơ ôộng Giăng, ùn ôông, rối Ngái tưa riêng maáng côống phố lêng tềng mộch ngón nùi cao. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Khà vái của Ngái àn piền hoà tlưởc mặt maáng, ôộng mặt Ngái chiều tlàng như mặt tlới, cón ào Ngái tlở rêng chòi loá như ènh tlàng. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Ôộng hẩu rạ, Môi-se cô ống Ê-li xuẩt hiến tlưởng maáng, duyên chuyến côống Ngái. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Caá ní, khới vở lới, Phi-e-rơ thưa côống Chùa Giê-xu: "Láy Chùa, xật là tổt cho tán ha tể ở tái ní. Nều thấy moành, tôi sẻ mấn ở ní pa cày lếu - mộch cho thấy, mộch cho Môi-se ôộng mộch cho Ê-li." <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" />Tloong caá ôông vẩn cón tang vé, xì hẩu rạ, mộch đàm mân tlàng rực pao phủ maáng, ôộng hẩu ní, mộch xiềng phàn pở tloong đàm mân, xí ní: "Ní là Con yêu dầu của Ho, mà Ho rẩt phưa loóng ở Con. Hảy măng xeo Con rì." <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />Khới măng rối, cảc môn tố pổ khẩp mặt ôộng rẩt là kinh rưởi. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Rối Chùa Giê-xu, khâu khới tềng khênh ôộng chám pao maáng, tà vé: "Hảy từng dấn ôộng má kinh rưởi." <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Mơi khới ngảc mẳt mếng lêng, maáng chăng kỉa ôông ay tlứ xa mộch mếng Chùa Giê-xu.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Tang khới maáng pở tlêng nùi ti xuồng, Chùa Giê-xu xa lếnh cho maáng, xí ní: "Má vé lái tiếu tà kỉa côống ôông ay cho tềng khới Con Moón tà pở cày chểt khôồng lái." <verse eid="MAT 17:9" /><verse number="10" style="v" sid="MAT 17:10" />Cảc môn tố rì poi Ngái là: “Rêng nó cảc thấy táy luật vé là Ê-li phải tềng tlưởc?” <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />Caá ní, khới tlả lới, Ngái vé: "Tuy Ê-li phải tềng ôộng sẻ khôi phục tẩt cả cảc việc. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Mơi thấy vé côống ái ùn là Ê-li tà tềng rối, ôộng maáng tà chăng nhấn xa ôông. Thay pao rì, maáng mấn tủ tẩt cả tiếu maáng moành côống ôông. Yý chôồng như xí, Con Moón pú phải chíu khổ pởi maáng." <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Caá rì, cảc môn tố hiểu là Ngái vé côống maáng vến Giăng Báp-tít.<verse eid="MAT 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Khới tà tềng côống đoán dân, mộch moón tán ôông tà lái khênh Ngái, quý cổ cồn xuồng tlưởc Ngái <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />ôộng thưa: “Chùa ới, cườn xương xỏt con từa tôi, ví reé vẳc pếng tôống kinh ôộng pí nắng lặm, pởi reé hay pổ pao lửa, ôộng hay lở xuồng rảc. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Tôi tà tom reé tềng cho cảc môn tố của Ngái, mơi maáng chăng cò khả năng chửa lénh cho reé." <verse eid="MAT 17:16" /><verse number="17" style="v" sid="MAT 17:17" />Caá ní, khới tlả lới lái, Chùa Giê-xu vé: "Thề hế chăng tin ôộng păng hoái kia, tôi sẻ ở côống tán pay cho tềng khới nó? Sẻ chíu đứng tán pay cho tềng pao lô? Hảy tom lấu rẻt tềng ní cho tôi." <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Chùa Giê-xu tlẻch vằng reé, xì quỷ ti xa khỏi lấu rẻt, ôộng lấu rẻt àn lénh pở giớ rì.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Tiểp xeo, khâu khới tốn riêng côống Chùa Giê-xu, cảc môn tố thưa: "Ví lỳ do chi tán tôi chăng thể tuổi reé xa àn?" <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />Rối Ngái vé côống maáng: "Pởi đửc tin kèm cỏi của ái ùn. Ví xật sứ, thấy vé côống ái ùn, nều ái ùn cò đửc tin như hột cải, xì ái ùn sẻ truyến cho ngón nùi ní: 'Hảy chuyển pở tược ní qua tược kia,' xì reé sẻ chuyển ti, ôộng sẻ chăng cò chi là chăng thể đồi côống ái ùn." <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />(Mơi xừ quỷ ní chăng pí tlục xuẩt nều chăng pắng sứ cấu nguyện ôộng kiêng ăn.)<verse eid="MAT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Caá ní, tloong khới maáng nhòm lái ở Ga-li-lê, Chùa Giê-xu vé côống maáng: "Con moón pú pí nộp pao xay maáng. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />Ôộng maáng sẻ giểt Ngái ti, rối pao ngáy xừ pa, Ngái sẻ àn mấn khôồng lái.” Cảc môn tố tlở rêng puốn lặm.<verse eid="MAT 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Caá rì, khới maáng tà ti tềng thánh Ca-bê-na-um, cảc moón thu thề tến thớ tềng côống Phi-e-rơ ôộng poi: "Thấy của ái chăng nộp thuề tến thớ à?" <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />Ông pảo: “Cò.” Ôộng caá pao tloong nhá rối, Chùa Giê-xu tà lêng xiềng côống ôông tlưởc, xí ní: "Si-môn, ái nghỉ chi xí? Cảc vua tlêng tẩt thu phì hay thuề pở ôông ay? Pở con cài maáng hay pở moón khảc?" <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />Khâu khới tlả lới: "Pở moón khảc", Chùa Giê-xu vé côống ôông: "Xí con cài xì àn miển. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Mơi tể tán ha chăng mấn vẩp phám cho maáng, xì caá ti xa piển, ái hảy tlởi câu ôộng kèo con cà lêng đấu tiên. Khâu khới vở ménh reé xa, ái sẻ kỉa mộch siếc-lơ. Lế àn xiến rì rối, hảy nộp cho maáng nộp cho phấn của thấy mân ái."<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Pao giớ rì, cảc môn tố tềng khênh Chùa Giê-xu, thưa: "Cuồi cúng xì ôông ay là náy hơn hểt tloong vương quổc thiên đáng?" <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />Rối khâu khới hôổc mộch từa rẻt tềng côống mếng, Ngái tệch reé ở khừa maáng <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />ôộng vé: “Xật sứ, thấy vé xật côống ái ùn, nều ái ùn chăng àn piền tổi ôộng tlở rêng như cảc từa rẻt, xì chẳc chằn ái ùn sẻ chăng ti pao tloong vương quổc thiên đáng. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Xí rêng, pẩt ký ôông ay há mếng xuồng chôồng như từa rẻt ní, xì moón rì là náy hơn hểt tloong vương quổc thiên đáng. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Nều ôông ay nhân danh thấy tiểp mộch từa rẻt như xí, xì moón rì tiểp rưởc thấy. <verse eid="MAT 18:5" /><verse number="6" style="v" sid="MAT 18:6" />Mơi moón nó mấn vẩp phám cho mộch tloong cảc enh con rẻt ní, nghỉa là cảc moón tin pao thấy, xì tiếu cấn thiểt cho moón rì chình là mộch cồn xay dénh cho lứa àn tleo quenh cổ reé, rối reé pí nhấn chìm xuồng piển khu.<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />Khồn nán quà cho thề gian ví pởi cảc cày mấn cho vẩp phám! Pởi ví cảc cày mấn cho vẩp phám phải tềng là tiếu đương nhiên, ngay cả như xí, khồn nán quà cho moón mà lỳ do mấn vẩp phám tềng qua moón rì! <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Mặt khảc, nều xay hay chó ái ùn mấn cho ái ùn vẩp phám, hảy chạch ti reé ôộng nèm xa khỏi ái ùn. Rì là tiếu tổt cho ái ùn tể pí cụt xay hoặc qué chó rối pao tloong sứ khôồng hơn là khới cò han xay hoặc han chó tể rối pí quăng pao lửa tới tới. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Nều mẳt ái ùn mấn cho ái ùn phám xối, hảy voỏc reé xa ôộng nèm khỏi ái ới ùn. Rì là tiếu tổt cho ái ùn tể chỉ cón mộch mẳt rối pao tloong sứ khôồng, hơn là khới cò han mẳt tể rối pí quăng pao hoả ngục. <verse eid="MAT 18:9" /><verse number="10" style="v" sid="MAT 18:10" />Hảy cẩn thấn, ái ùn má rêng khinh thướng mộch tloong cảc từa rẻt énh ní. Ví thấy vé côống ái ùn là cảc thiên sừ của phè tlêng tlới luôn luôn hẩu kỉa mặt Cha thấy tlêng thiên đáng. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />[Ví Con Moón tà tềng tể cừu moón pí hư voong.] <verse eid="MAT 18:11" /><verse number="12" style="v" sid="MAT 18:12" />Ái ùn nghỉ xí nó? Nều mộch moón kia cò mộch tlăm con chiên, mơi mộch tloong sồ phè pí lạc, xì chăng phải khâu khới tể lái chìn mươi chìn con tlêng tốn ôộng lêng khà, moón rì xím kiềm con chiên pí lạc à? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Nều moón rì cò thể xím kỉa reé, xì xật sứ, thấy vé côống ái ùn là moón rì sẻ phui mứng vến reé hơn là chìn mươi chìn con chiên chăng pí lạc. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Yý xí, ỳ moành tlưởc mặt Cha tlêng thiên đáng của ái ùn chăng phải là tể mộch tloong cảc enh con rẻt ní pí hư voong.<verse eid="MAT 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />Mặt khảc, nều mộch moón ai ơi ùn của ái ùn phám xối côống ái ùn, hảy ti, hảy khiển tlẻch nọ khừa ái ùn côống moón rì mà rôi. Nều moón rì măng xeo ái ùn, xì ái ùn àn lái moón ái ới ùn mếng. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Mơi nều moón rì chăng măng xeo, hảy tom xeo mếng mộch hoặc han moón nửa, tể cho pởi ménh của han hoặc pa moón mấn chừng xì tẩt cả lới cò thể àn xảc nhấn. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Cón nều moón rì tứ chồi măng xeo maáng, hảy tlính páy cho hối thành. Mơi nều moón rì yý tứ chồi măng xeo hối thành, xì đồi côống ái ới ùn, moón rì ngay cả phải như là dân ngoái quổc mân moón thu thuề. <verse eid="MAT 18:17" /><verse number="18" style="v" sid="MAT 18:18" />Xật sứ, thấy vé xật côống ái ùn, nều ái ùn puộc pẩt ký tiếu chi tìn tẩt, xì tiếu rì sẻ pí puộc tlêng tlới; ôộng nều ái ùn vở pẩt ký tiếu chi ở tìn tẩt, xì tiếu rì sẻ àn vở tlêng tlới. <verse eid="MAT 18:18" /><verse number="19" style="v" sid="MAT 18:19" />Mộch lấn nửa, xật sứ, thấy vé côống ái ùn là nều han moón tloong ái ùn tôống loóng côống phố tìn tẩt vến tẩt cả tiếu chi mà nều maáng cấu cườn, xì tiếu rì sẻ àn mấn rêng cho maáng pởi Cha thấy tlêng thiên đáng. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Ví ở nó cò han hoặc pa moón àn hiệp phố lái tloong danh thấy, xì thấy ở tược rì ngay khừa maáng."<verse eid="MAT 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Tiểp xeo, khâu khới tềng khênh, Phi-e-rơ thưa côống Ngái: "Láy Chùa, mộch mốn ái ùn tôi sẻ vẳc lổi nghịch côống tôi ôộng tôi sẻ tha thừ ái ha cớ nó lấn? Tềng cả pảy lấn chăng?" <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />Chùa Giê-xu vé côống ôông: “Thấy chăng vé côống ái tềng pảy lấn, mơi là tềng cả pảy mươi lấn pảy. <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />Pởi lỳ do ní, vương quổc thiên đáng cò thể àn so sành như mộch moón mấn vua, mà moón rì moành giải quyểt sổ sảch côống cảc nô lế mếng. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Caá ní, khới vua pẳt tấu tình sổ, mộch moón nớ mưới nghín ta-lâng àn giải tềng cho vua. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Mơi moón rì chăng cò khả năng tlả nớ, rêng vua tà xa lếnh cho ái ha phải pí paành, côống du, con ôộng tẩt cả cảc xừ mếng cò, rối tlả nớ. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Xí là khâu khới pổ lở xuồng, xên nô lế rì quý tlưởc vua, thưa: 'Chủ ới, cườn kiên nhẩn côống tôi, rối tôi sẻ tlả lái ngái tẩt cả.' <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Caá ní, pởi tôống loóng xương xỏt, chủ của xên nô lế rì tà tlởi xa mân tha nớ cho ái ha. <verse eid="MAT 18:27" /><verse number="28" style="v" sid="MAT 18:28" />Mơi caá ti xa vái rối, xên nô lế tốn mộch tloong cảc moón côống mấn nô lế côống mếng, là moón vẳc nớ reé mộch tlăm đơ-ni-ê, ôộng khâu khới nằm lế moón rì, reé pỏp cố ken, pảo: 'Dâu nớ cày chi xì tlả ti.' <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Xí là, khâu khới quý xuồng, moón côống mấn nô lế côống reé năn nỉ reé, xí ní: 'Cườn kiên nhẩn côống tôi, rối tôi sẻ tlả lái ái.' <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Mơi ái ha chăng chíu. Thay pao rì, khới lêng khà, reé cho giam moón kia pao tú cho tềng khới ái ha tlả sồ xiến nớ. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Xí là, khâu khới kỉa việc tà xảy xa, cảc moón côống mấn nô lế của reé rẩu tâu loóng. Khới ti tềng rối, maáng vé lái tấy tủ côống chủ mếng tẩt cả cảc chuyến tà xảy xa. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Tiểp xeo, khâu khới truyến cho xên nô lế rì tềng, chủ của reé vé côống reé: 'Xên nô lế gian ảc kia, ho tà tha hểt nớ rì cho ái ví ái tà nái cườn ho. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Việc yý cấn mấn dánh cho ái chăng phải là xương xỏt moón côống mấn nô lế côống mếng, yý như ho tà xương xỏt ái, tùng chăng?' <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Pởi pí choọc giấn như xí, chủ của reé tà giao reé cho tán tla tần cho tềng khới reé tlả hểt tẩt cả cảc xừ vẳc nớ. <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" />Cha tlêng tlới của thấy yý sẻ đồi xử côống ái ùn xeo cảch như xí, nều mổi moón tloong ái ùn chăng tha lổi cho moón ái ùn của mếng xuẩt phảt pở tầm loóng mếng."<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Việc xảy xa là khới Chùa Giê-xu tà kểt thủc cảc lới rì, Ngái ti khỏi Ga-li-lê ti tềng púng Giu-đê ở táng kia khôông Giô-đanh. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Cảc đoán moón khòm xeo Ngái ôộng Ngái chửa pếng cho maáng ở rì.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Mầy moón Pha-ri-si tềng khênh Ngái, thử Ngái ôộng thưa: "Cò hay chăng cho phẻp mộch tán ôông ly dí du mếng ví pẩt ký lỳ do nó? <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />Khới tlả lới, Ngái vé: “Cảc ôông chưa toọc là Tầng sàng táo pở caá pan tấu tà mấn rêng maáng, mộch moón từa mân mộch moón cài, <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />ôộng phàn: 'Pởi lỳ do rì, moón tán ôông sẻ lía pồ ôộng mế mà gằn pò mật thiểt côống du mếng, ôộng cả han sẻ là mộch xịt tùng chăng? <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Tềng nổi, maáng chăng cón là han, mơi là mộch xịt. Pởi xí, tiếu mà Thiên Chùa tà kểt hiệp lái, xì con moón chăng àn chia rẻ." <verse eid="MAT 19:6" /><verse number="7" style="v" sid="MAT 19:7" />Maáng thưa côống Ngái: “Xí xì, rêng nó Môi-se truyến táy phải tưa tớ chầy ly hôn rối lảc du ti?" <verse eid="MAT 19:7" /><verse number="8" style="v" sid="MAT 19:8" />Ngái pảo maáng xí ní: "Ví sứ cừng loóng của cảc ôông mà Môi-se tà cho phẻp cảc ôông ly dí du mếng, mơi pở pan tấu, tiếu rì chăng phải là như xí. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Mơi tôi vé côống cảc ôông hay là tlứ xa ví xối gian dâm, moón nó ly dí du mếng rối cười moón khảc xì phám xối ngoái tính; moón cười moón tà pí ly dí yý phám xối ngoái tính." <verse eid="MAT 19:9" /><verse number="10" style="v" sid="MAT 19:10" />Cảc môn tố thưa côống Ngái: “Nều cày việc của moón tán ôông côống du mếng là như xí, xì tổt hơn chăng lế du." <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />Mơi Ngái vé côống maáng: "Chăng phải tẩt cả cò thể tòn nhấn lới ní, mơi là dánh cho ôông ay mà chuyến rì àn pan cho. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Ví cò cảc moón hoán, là cảc moón àn teẻ xa pở tloong loóng mế tà như xí; cò cảc moón hoán mơi pí maáng mấn cho hoán; ôộng cò cảc moón hoán là cảc moón tứ hoán chình mếng ví pởi vương quổc thiên đáng. Ôông ay cò thể tiểp nhấn lới ní, moón rì hảy tiểp nhấn."<verse eid="MAT 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Khâu rì, cảc từa rẻt énh àn tom tềng cho Ngái tể Ngái tệch xay tlêng phè ôộng cấu nguyến, mơi cảc môn tố khiển tlẻch phè. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Mơi, Chùa Giê-xu pảo: “Hảy tể cho cảc con rẻt tềng côống thấy, má ngăn cầm phè, ví vương quổc thiên đán glà của ôông ay như xí." <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Khâu khới tệch xay lêng phè, Ngái pở rì lêng khà.<verse eid="MAT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Ôộng hẩu rạ, mộch moón kia khới tềng khênh Ngái, tà vé: "Thưa thấy, tôi phải mấn việc lénh chi tể tôi cò àn sứ khôồng tới tới?" <verse eid="MAT 19:16" /><verse number="17" style="v" sid="MAT 19:17" />Rối Ngái vé côống ái "Rêng nó ái poi tôi vến việc lénh? Chỉ mộch Tầng là thiến lénh, cón nều ái moành pao tloong sứ khôồng, xì hảy giử cảc tiếu răn." <verse eid="MAT 19:17" /><verse number="18" style="v" sid="MAT 19:18" />Moón rì thưa côống Ngái: "Cảc tiếu răn nó?" Rối Chùa Giê-xu pảo: "Má giểt moón, má phám xối gian dâm, má lốm cẳp, má mấn chừng lẻo, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />hảy hiều kình pồ ôộng mế, mân yêu xương moón ở khênh của ái như chình mếng." <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />Ái thanh niên rì thưa côống Ngái: “Tôi tà vâng giử tẩt cả cảc tiếu rì. Tôi cón xiều tiếu chi nửa?” <verse eid="MAT 19:20" /><verse number="21" style="v" sid="MAT 19:21" />Chùa Giê-xu vé côống ái: “Nều ái moành àn tlón vén, hảy ti, hảy paành cày chi mếng cò rối pồ thì cho moón nghéo, xì ái sẻ cò kho bầu tlêng thiên đáng; ôộng hảy xeo tôi rạ!" <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />Mơi khới măng lới rì xoong, ái thanh niên tà lảc ti ví puốn lặm, pởi ái ha tà tang cò rẩt nhiếu của cải.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Caá ní, Chùa Giê-xu vé côống cảc môn tố: “Xật sứ, thấy vé côống ái ùn xí ní: moón chấu sẻ pao tloong vương quổc thiên đáng rẩt là khò khăn. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Mà thấy lái vé côống ái ùn, tể con lạc đá chui qua lồ kim là tiếu lời hơn đồi côống moón chấu pao tloong vương quổc của Thiên Chùa." <verse eid="MAT 19:24" /><verse number="25" style="v" sid="MAT 19:25" />Caá ní, khâu khới măng xí, cảc môn tố rẩt kinh ngạc, thưa: "Xí xì ôông ay cò thể àn cừu?" <verse eid="MAT 19:25" /><verse number="26" style="v" sid="MAT 19:26" />Chăm chù hẩu maáng, Chùa Giê-xu vé côống maáng: "Côống con moón, việc ní là chăng thể, mơi côống Thiên Chùa, tẩt cả cảc việc là cò thể." <verse eid="MAT 19:26" /><verse number="27" style="v" sid="MAT 19:27" />Caá rì, tể tlả lới lái, Phi-e-rơ vé côống Ngái: "Thấy hẩu xứ, tán tôi tà lảc tẩt cả ôộng xeo thấy. Xí xì sẻ cò tiếu chi dánh cho tán tôi?" <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" />Rối Chùa Giê-xu vé côống maáng: “Xật sứ, thấy vé côống ái ùn, nghỉa là cảc moón tà xeo thấy, tloong ký tổi mời, khới Con Moón ngứ tlêng ngôi vinh hiển mếng, xì ái ùn yý sẻ ngối tlêng mưới han ngai, xẻt đoàn mưới han chi tộc Y-sơ-ra-ên. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Mổi moón, nghỉa là nều ôông ay tà lảc nhá cửa, ái ùn, ới ùn, pồ, mế, du, con hay tẩt roóng ví pởi danh của thấy, sẻ nhấn gẩp mộch tlăm lấn ôộng àn hưởng sứ khôồng tới tới. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Mơi nhiếu moón tấu sẻ tlở rêng cuồi, ôộng cảc moón cuồi sẻ tlở rêng tấu.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />Ví vương quổc thiên đáng xì chôồng như mộch moón chủ tẩt, là moón ti xa pao caá tlàng khờm tể thuê moón mấn xê cho roóng nho mếng. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Caá ní, khâu khới thoả thuấn côống cảc moón mấn xê côống mộch đơ-ni-ê cho mộch ngáy, ôông khai maáng pao roóng nho của mếng. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />Ôộng khới ti xa pao khoảng giớ xừ pa, ôông kỉa sồ khảc tang từng rỏ ở vái chớ. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Ôông vé côống maáng: 'Mầy ái yý hảy pao tloong roóng nho, ôộng xiến côông nó là xừng đàng, xì tôi sẻ tlả cho cảc ái.' <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Rối maáng ti xeo. Khâu khới lái ti xa pao khoảng giớ xừ phầu ôộng xừ chìn, ôông yý mấn như xí. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Xí rối, caá ti xa khoảng giớ xừ mưới mộch, ôông phảt hiến moón khảc tang từng, ôộng ôông vé côống maáng: "Rêng nó cảc ái từng rỏ cả ngáy ở ní?' <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />Maáng thưa côống ôông: 'Ví chăng ôông ay xê tán tôi.' Ôông vé côống maáng: 'Cảc ái yý hảy ti pao tloong roóng nho.' <verse eid="MAT 20:7" /><verse number="8" style="v" sid="MAT 20:8" />Rối tềng khuống xồn, chủ roóng nho pảo moón quản lỳ của mếng: ‘Hảy hôổc cảc moón mấn xê tềng ôộng tlả xiến côông cho maáng, pẳt tấu pở mầy moón cuồi cho tềng cảc moón tấu.' <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Khâu khới tiền tềng, cảc moón àn xê pao khoảng giớ xừ mưới mộch, mổi mốn nhấn àn mộch đơ-ni-ê. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Cón cảc moón mấn xê đấu tiên, caá tiền tềng, tà nghỉ là mếng sẻ nhấn nhiếu hơn, mơi maáng yý nhấn mộch đơ-ni-ê cho mổi moón. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Mơi khâu khới nhấn rối, maáng cắn nhắn vến moón chủ tẩt, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />xí ní: 'Mầy moón mấn xê khâu cuồi rì tà mấn việc mộch giớ, mà chủ tể maáng ngang pắng côống tán tôi, là cảc moón tà chíu cực nhoọc cả ngáy côống cày noóng xiêu tổch.' <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />Mơi tlả lới lái, moón chủ vé côống mộch moón tloong tán maáng: 'Hớ pán ới, tôi chăng cò đồi xử pẩt côông côống cảc ái. Chăng phải cảc ái tà tôống ỳ côống tôi mộch đơ-ni-ê à? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Hảy nhấn phấn của ái ôộng ti ti. Cón tôi xì moành tưa cho cảc moón cuồi ní yý chôồng như cho ái. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Hay chăng cò phẻp cho tôi tể mấn tiếu tôi moành côống cảc cày của mếng? Hay mẳt ái xì khò chíu ví tôi cò loóng tổt?' <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" />Chôồng như xí, moón cuồi sẻ tlở rêng tấu ôộng moón tấu tlở rêng cuồi.”<verse eid="MAT 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Tang khới ti lêng thánh Giê-ru-sa-lem, Chùa Giê-xu tom xeo mưới han môn tố riêng côống mếng, ôộng tlêng khà ti, Ngái vé côống maáng: <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“Hẩu rạ, tán ha tang ti lêng tềng thánh Giê-ru-sa-lem, ôộng Con Moón sẻ pí nộp cho cảc thấy tề lể cả ôộng cảc thấy táy luật, rối maáng sẻ kểt àn tử hính Ngái. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />Ôộng sẻ giao Ngái cho cảc moón ngoái quổc tể nháo pàng, tành tón, ôộng toòng tenh Ngái tlêng câl thập tứ. Rối pao ngáy xừ pa, Ngái sẻ khôồng lái."<verse eid="MAT 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Caá rì, mế của han con từa Xê-bê-đê côống cảc con mú tềng khênh Ngái, cùi láy ôộng cấu cườn mộch tiếu pở Ngái. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />Rối Ngái vé côống mú: "Vaá moành tiếu chi?" Mú thưa côống Ngái: "Cườn truyến xí nó cho han enh con từa ní của tôi, mộch enh cò thể ngối ở táng chăm, ôộng mộch enh ở táng chiêu thấy tloong vương quổc của thấy." <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />Mơi khới tlả lới lái, Chùa Giê-xu pảo: "Pa từa dâu chăng mẳt mếng tang cấu cườn tiếu chi nó. Han ái ùn cò thể oòng chèn mà thấy pú oòng chăng?" Maáng thưa côống Ngái: "Tán tôi cò thể." <verse eid="MAT 20:22" /><verse number="23" style="v" sid="MAT 20:23" />Ngái vé côống maáng: “Tuy ái ùn sẻ oòng chèn của thấy, mơi tể ngối ở táng chăm ôộng ở táng chiêu của thấy chăng phải là việc của thấy quyểt đính, mơi là dánh cho cảc moón tà àn chuẩn pí pởi Cha thấy." <verse eid="MAT 20:23" /><verse number="24" style="v" sid="MAT 20:24" />Khâu khới măng chuyến ní, mưới môn tố kia rổi giấn côống han ái ùn. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Mơi caá tà hôổc maáng tềng côống mếng, Chùa Giê-xu vé: "Ái ùn mẳt là cảc vua chùa của cảc moón ngoái quổc xì ảp chề dân, ôộng cảc moón mấn náy xì thể hiến quyến lực tlêng maáng. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Tloong ái ùn xì chăng như xí. Thay pao rì, nều ôông ay moành tlở rêng náy khừa voóng ái ùn, xì moón rì sẻ mấn moón phục vuú của ái ùn, <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />ôộng moón nó moành mấn tấu tloong ái ùn xì sẻ mấn moón hấu của ái ùn, <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />ngay cả như Con Moón tà chăng tềng tể àn phục vuú, mơi là tể phục vuú, ôộng tể dơng maáng khôồng mếng như già chuộc thay thề cho nhiếu moón."<verse eid="MAT 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Rối khới maáng pở thánh Giê-ri-cô ti xa, mộch đoán dân khòm ti xeo Ngái. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Ôộng hẩu rạ, han moón mú tang ngối ở pêng khà. Khâu khới măng là Chùa Giê-xu tang ti ngang qua, maáng rố lêng, xí ní: "Láy Chùa, Con vua Đa-vít, cườn xương xỏt tán tôi." <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />Mơi tán dân tlẻch vằng han ái, tể maáng im ti, xí mơi maáng tềng nổi rố náy hơn nửa, xí ní: "Láy Chùa, Con vua Đa-vít, cườn xương xỏt tán tôi." <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />Khới từng lái rối, Chùa Giê-xu hôổc maáng tềng ôộng vé: "Cảc ái moành tôi mấn chi cho cảc ái?" <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />Maáng thưa côống Ngái: “Láy Chùa, rì là cườn cho mẳt tán tôi àn hẩu kỉa." <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />Caá ní, ví tôống loóng xương xỏt, Chùa Giê-xu chám pao mẳt maáng, Ngay caá rì, maáng phục hối tlàng mẳt ôộng ti xeo Ngái.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Khới maáng khênh tềng thánh Giê-ru-sa-lem, ôộng ti tềng Bê-pha-giê, hường vến Núi Ô-liu, caá rì Chùa Giêu-xu khai han môn tố, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />pảo maáng: "Hảy ti pao cày láng tlưởc mặt ái ùn, rối ái ùn sẻ kỉa ngay mộch con lứa toóng pí puộc, côống mộch lứa con ở côống reé. Khâu khới vở khái puộc, hảy tom tềng cho thấy. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Ôộng nều mộch ôông ay rì pảo cày chi côống ái ùn, xì ái ùn sẻ vé xí ní: "Chùa cò nhu cấu sử dúng phè,' rối moón rì sẻ liến tể phè ti." <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />Mặt khảc, việc ní xảy xa tể cho lới tà àn phàn qua ví tiên tli cò thể àn ừng nghiếm, xí ní:<verse eid="MAT 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MAT 21:5" />“Hảy pảo con cài của Si-ôn:</para>
  <para style="q" vid="MAT 21:5">Hẩu rạ, Vua dâu tềng côống dâu,</para>
  <para style="q" vid="MAT 21:5">khiêm nhường ôộng cởi lứa –</para>
  <para style="q" vid="MAT 21:5">nghỉa là tlêng mộch lứa con, con của lứa toóng.”<verse eid="MAT 21:5" /></para>
  <para style="b" />
  <para style="m">
    <verse number="6" style="v" sid="MAT 21:6" />Caá ní, cảc môn tố, khâu khới ti ôộng mấn xeo chôồng như Chùa Giê-xu tà táy pảo maáng, <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />tà tom lứa toóng côống lứa con vến, ôộng tlải ào choáng của mếng tlêng phè, rối Ngái ngối tlêng rì. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Caá ní, khênh hểt tán dân tlải ào choáng của mếng tlêng khà, cón mộch sồ khảc xì chạch cảch nhènh câl ôộng tlải xa tlêng khà. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Xí rối, cảc đoán khòm ti tlưởc Ngái ôộng xeo khâu tà rố lêng, xí ní:</para>
  <para style="q" vid="MAT 21:9">“Hô-sa-na con vua Đa-vít!</para>
  <para style="q" vid="MAT 21:9">"Hô-sa-na Con vua Đa-vít! Đàng khen ngo ới Tầng tềng tloong danh Chùa!</para>
  <para style="q" vid="MAT 21:9">Hô-sa-na tlêng tược cao nhẩt!”<verse eid="MAT 21:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="MAT 21:10" />Khâu khới Ngái pao tloong thánh Giê-ru-sa-lem, cả thánh pí xôn xao, pảo: "Rì là ôông ay?" <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />Xí rối đoán dân tlả lới: "Rì là tiên tli Giê-xu, pở Na-xa-rét, púng Ga-li-lê.”<verse eid="MAT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Chùa Giê-xu ti pao tloong tến thớ, rối Ngái tuổi tẩt cả cảc moón mua paành tloong tến thớ, mân hẩt tổ pán của tán tổi xiến côống ghề của tán puôn cú cu. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Ngái vé côống maáng: “Lới tà àn chẻp: 'Nhá Ho sẻ àn hôổc là nhá cấu nguyến,' mơi cảc ôông tà piền reé thành hang lốm cẳp," <verse eid="MAT 21:13" /><verse number="14" style="v" sid="MAT 21:14" />Rối cảc moón mú ôộng moón qué tềng khênh Ngái tloong tến thớ, ôộng Ngái chửa lénh cho maáng. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Mơi cảc thấy tề lể cả mân cảc thấy táy luật, khâu khới kỉa cảc việc ký diếu mà Ngái tà mấn, ôộng kỉa tán rẻt tung hô tloong tến thớ, xí ní: "Hô-sa-na Con vua Đa-vít," xì maáng rổi giấn. <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Maáng vé côống Ngái: “Thấy cò măng phè vé cày chi chăng?" Mơi Chùa Giê-xu pảo maáng: "Cò! Cảc ôông chưa caá nó toọc là: 'Chùa tà chuẩn pí khẳn xiềng ca ngơ ới pở ménh của cảc con rẻt mân cảc rẻt tang ù,' à?" <verse eid="MAT 21:16" /><verse number="17" style="v" sid="MAT 21:17" />Khâu khới ti khỏi maáng, Ngái ti xa khỏi thánh tềng Bê-tha-ni ôộng hơi mai ở rì.<verse eid="MAT 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Tềng tlàng, tang khới ti pao thánh, xì Ngái tòi. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Khâu khới hẩu kỉa mộch câl vả pêng khà, Ngái ti tềng câl rì ôộng phảt hiến chăng cò chi tlêng reé tlứ xa là mà rôi. Ngái phàn côống reé: "Tlày chăng cón cò ở dâu nửa cho tềng tới tới," ôộng ngay caá rì, câl vả rì khô hèo. <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />Kỉa như xí rối, cảc môn tố kinh ngạc, pảo: "Mấn xí nó mà câl vả tà liến khô hèo?" <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />Rối khới tlả lới, Chùa Giê-xu vé côống maáng: "Xật sứ, thấy vé côống ái ùn, nều ái ùn cò đửc tin ôộng chăng nghi ngớ, xì ái ùn sẻ mấn àn chăng chỉ tiếu ní cho câl vả, mơi tềng nổi nều ái ùn pảo côống nùi ní: 'Hảy àn dôổc lêng mân pí quăng xuồng piển,' xì việc rì sẻ xảy xa. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Tẩt cả cảc tiếu, pẩt kể cảc tiếu nó ái ùn nái cườn tloong lới cấu nguyến, xì ái ùn sẻ nhấn àn khới tin."<verse eid="MAT 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Ôộng khới Ngái pao tloong tến thớ rối, cảc thấy tề lể thướng phẩm côống cảc tlưởng lảo tloong tán dân tà tềng tốn Ngái khới Ngái tang giảng táy, pảo: "Pởi thẩm quyến nó thấy mấn cảc việc ní, ôộng ôông ay tà cho thấy thẩm quyến rì?" <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />Mơi tể tlả lới, Chùa Giê-xu vé côống maáng: "Tôi yý sẻ poi cảc ôông mộch câu, mà nều cảc ôông cò thể tlả lới tôi, xì tôi yý sẻ vé cho cảc ôông mẳt tôi tang mấn cảc tiếu ní pởi thẩm quyến nó. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Phẻp báp-têm của Giăng - phẻp rì là pở nó? Pở tlới hay pở loái moón?" Xí rối, maáng tlanh luấn côống phố, xí ní: "Nều tán ha pảo: 'Pở tlới,' xì reé sẻ vé côống tán ha: 'Xí ví lỳ do chi mà cảc ôông chăng tin nọ?' <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Cón nều tán ha pảo: ‘Pở loái moón,’ xì tán ha lái rưởi tán dân, pởi tất cả maáng hẩu Giăng là mộch nhá tiên tli.” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Rêng khới tlả lới Chùa Giê-xu, maáng vé: "Tán tôi chăng mẳt." Ngái yý pảo maáng: "Tôi yý chăng cho cảc ôông mẳt tôi mấn cảc việc ní pởi thẩm quyến nó. <verse eid="MAT 21:27" /><verse number="28" style="v" sid="MAT 21:28" />Xí mơi, cảc ôông nghỉ xí nó? Mộch moón cò han con từa, ôộng khâu khới tềng côống từa xừ nhẩt, ôông pảo: 'Con à, hôm nay con hảy ti mấn việc ở roóng nho.' <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Mơi khới tlả lới lái, ái vé: 'Con chăng moành,' mơi khâu rì, khới tà tổi ỳ, xì ái ti. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Cón khâu khới tềng tốn từa xừ han, moón pồ vé chôồng như xí. Rối, khới tlả lới, ái vé: "Cò con, thưa pồ,' mơi ái ha chăng ti. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />Ôông ay tloong han con từa rì mấn xeo ỳ moành của pồ mếng?" Maáng tlả lới: "Từa xừ nhẩt." Chùa Giê-xu vé côống maáng: "Xật sứ, tôi pảo cảc ôông là cảc moón thu thuề mân cài điềm ti pao tloong vương quổc của Thiên Chùa tlưởc cảc ôông. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Ví Giăng tà tềng côống cảc ôông tloong táng khà côông chình, mơi cảc ôông chăng tin nọ. Cón cảc moón thu thuề mân cài điềm xì tin nọ. Mơi cảc ôông, ngay cả hẩu kỉa rối, tà chăng ăn năn khâu rì tể tin nọ.<verse eid="MAT 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Hảy tlằng mộch ẩn dú khảc. Cò mộch moón chủ tẩt, là moón tà tlôông mộch roóng nho, mấn háng ráo chung quenh vướn rì, táo hấm ẻp ráo tloong rì, xây thảp kenh ôộng cho tán tlô ông nho xê reé, rối ôông ti xa rảc vái. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Caá ní, pao caá múa thu hoạch pú tềng, ôông khai mầy moón hấu mếng tềng côống tán tlôông nho tể thu phấn hoa mấu của ôông. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Mơi khới pẳt giử tán moón hấu của chủ rối, tán tlôông nho tành từa ní, giểt từa kia, nèm phú từa khảc. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Ôông lái khai cảc moón hấu khảc tềng, khòm hơn nhòm tlưởc, mơi phè đồi xử maáng chôồng như xí. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Rối cuồi cúng, ôông khai chình con từa mếng tềng côống maáng, xí ní: 'Phè sẻ kiêng nể con từa mếng.' <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Mơi tán tlôông nho, khâu khới kỉa moón con rì, tà pán côống phố: 'Ní là từa thứa kề. Hớ, tán ha cấn giểt chểt reé rối chiềm lế sản nghiệp của reé.' <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Caá pẳt giử enh con rối, phè nèm ái ha xa khỏi roóng nho ôộng giểt ti. <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />Xí xì, khới moón chủ roóng nho tềng, ôông ha sẻ mấn chi côống tán tlôông nho rì?” <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />Maáng thưa côống Ngái: "Ôông rì sẻ tiêu diệt tán gian ảc kia xật thê thảm, rối sẻ cho cảc moón tlôông nho khảc xê roóng, là cảc moón sẻ nộp lái cho ôông phấn hoa mấu pao múa thu hoạch của maáng." <verse eid="MAT 21:41" /><verse number="42" style="v" sid="MAT 21:42" />Chùa Giê-xu vé côống maáng: “Chăng lẻ cảc ôông chưa caá nó toọc tloong Kinh Thành:</para>
  <para style="q" vid="MAT 21:42">‘Hón phú mà cảc thớ xây lảc ti,</para>
  <para style="q" vid="MAT 21:42">reé tà àn tlở rêng phú chình yều của goỏc nhá.</para>
  <para style="q" vid="MAT 21:42">Việc ní xảy tềng pở Chùa,</para>
  <para style="q" vid="MAT 21:42">ôộng reé xật là diếu ký tloong mắt tán ha’?<verse eid="MAT 21:42" /></para>
  <para style="b" />
  <para style="m">
    <verse number="43" style="v" sid="MAT 21:43" />Ví lỳ do ní, tôi vé côống cảc ôông là vương quổc của Thiên Chùa sẻ pí tom ti khỏi cảc ôông ôộng sẻ àn pan cho mộch dân kểt tlày của vương quổc rì. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Ay rúng pao hón phú ní sẻ pí pể raảch. Cón hón phú rúng phải moón nó, reé sẻ té raảch moón rì.” <verse eid="MAT 21:44" /><verse number="45" style="v" sid="MAT 21:45" />Khâu khới măng cảc ẩn dú của Ngái, cảc thấy tề lể thướng phẩm mân cảc moón Pha-ri-si hay mẳt là Ngái tang vé vến maáng. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Khới xím cảch pẳt Ngái, maáng lái rưởi đàm tôông, ví tán dân hẩu Ngái là mộch nhá tiên tli.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Ôộng tlả lới lái, Chùa Giê-xu mộch lấn nửa vé côống maáng pắng ẩn dú, xí ní: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />"Vương quổc thiên đáng àn vé như mộch moón là vua, mà vua rì chuẩn pí tiệc cười cho con từa mếng. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Vua khai cảc moón hấu của mếng ti tể hôổc cảc moón tà àn mới tềng tiệc cười, mơi maáng chăng moành tềng. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Vua lái khai cảc moón hấu khảc, xí ní: ‘Hảy vé côống tán moón tà àn mới: “Hẩu rạ, ho tà roón tiệc của ho. Cảc con pó mân moong pèo của ho tà àn mấn xịt, ôộng tẩt cả sẳn sáng rối. Hảy tềng dứ pừa tiệc."" <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Mơi maáng lảc ti ví chăng quan tâm, moón ní xa roóng mếng, moón kia hường tềng việc kinh doanh của mếng. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Mà sồ cón lái, khâu khới pẳt giử cảc moón hấu của vua, xì tà sỉ nhục ôộng giểt ti. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Xí rối, vua pí choọc giấn, rêng khâu khới khai lình mếng ti, ôông tà cho tiêu diệt tán giểt moón rì mân tổch thánh của phè. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Khâu rì, vua pảo cảc moón hấu của mếng: 'Tuy tiệc cười tà sẳn sáng, mơi cảc moón tứng àn mới rì xì chăng xừng đàng. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Rêng, hảy ti xa cảc khà cài, rối nều cảc ái tốn pẩt ký cớ nó moón, xì hảy mới tềng tiệc cười.' <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Ôộng cảc moón hấu rì, khâu khới ti xa ở cảc khà cài, tà tập tlung tẩt cả ôông ay mà maáng tốn, cả xầu mân tổt, rối pừa tiệc tà àn lẩp tấy pởi cảc moón khẻch. <verse eid="MAT 22:10" /><verse number="11" style="v" sid="MAT 22:11" />Mơi khới pao tể hẩu cảc khẻch ngối ăn, vua kỉa mộch moón kia chăng mặc tlang phục tiệc cười. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Vua pảo moón rì: ‘Pán ới, mấn xí nó ái pao ní khới chăng cò tlang phục tiệc cười?' Mơi moón rì pí cừng ménh. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Khâu rì, vua pảo cảc moón hấu: 'Hảy tlòi xay chó của xên ní lái rối nèm reé pao tược xồn xăm vái kia, tược sẻ cò sứ than nhám mân nghiền xăng.' <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />Ví nhiếu moón àn hôổc, mơi ét moón àn chón."<verse eid="MAT 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Caá rì, khâu khới ti khỏi, tán moón Pha-ri-si lập mưu tình kề xí nó cho maáng cò thể cái pẩy Ngái tloong lới khề. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Maáng khai cảc môn tố mếng, côống tán moón xuộc đảng Hê-rốt, tềng côống Ngái, vé: "Thưa thấy, tán tôi mẳt là thấy là moón ngay xật mân táy dổ táng khà của Thiên Chùa pắng chân lỳ, ôộng chăng cò sứ thiên ví tloong thấy vế pẩt ký ôông ay, ví thấy chăng hẩu ở khà vái của maáng. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Xí rêng, cườn cho tán tôi mẳt thấy nghỉ xí nó? Cò àn nộp thuề cho Xê-xa hay chăng?” <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />Mơi ví tà mẳt âm mưu gian ảc của maáng, Chùa Giê-xu pảo: “Tán moón đáo đửc giả kia, rêng nó tán pay thử tôi? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />“Hảy cho tôi hẩu tôống xiến nộp thuề.” Maáng tom cho Ngái mộch tôống đơ-ni-ê. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Ngái vé côống maáng: "Hính ôộng danh hiếu ní là của ay?” <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />Maáng tlả lới: “Của Xê-xa.” Caá rì, Ngái é côống maáng: "Xí xì, hảy tlả cho Xê-xa cày chi của Xê-xa, ôộng cho Thiên Chùa cày chi của Thiên Chùa." <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />Khâu khới măng như xí, maáng rẩt kinh ngạc, rối maáng rới ti, tể Ngái lái.<verse eid="MAT 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Pao hôm rì, mầy moón Sa-đu-sê tềng khênh Ngái, ví hay vé là chăng cò sứ khôồng lái, rêng maáng tà poi Ngái, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />xí ní: “Thưa Thấy, Môi-se cò vé: 'Nều mộch moón nó rì chểt mà chăng cò con, xì ùn từa moón rì sẻ lế du của ái ôộng teẻ con cho ái của mếng.’ <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Mơi khừa tán tôi cò pảy ái ùn từa, moón đấu tiên, khâu khới lế du, xì tà chểt. Ôộng ái tể lái du của ái cho ùn từa mếng, khới chăng cò con. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Moón xừ han rối moón xừ pa, cho tềng moón xừ pảy, yý như xí. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Rối cuồi cúng, moón phú nử chểt ti. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Xí xì, tloong sứ khôồng lái, ới sẻ là du của ôông ay tloong pảy ái ùn? Ví tẩt cả maáng tà lế ới. <verse eid="MAT 22:28" /><verse number="29" style="v" sid="MAT 22:29" />Mơi khới tlả lới, Chùa Giê-xu vé côống maáng: "Cảc ôông pí phảng rối, ví chăng mẳt Kinh Thành mân quyến phẻp của Thiên Chùa. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Ví tloong sứ khôồng lái, maáng chăng cười yý chăng àn gả ti mơi maáng xì chôồng như cảc thiên sừ tlêng tlới, <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Cón vến sứ khôồng lái của moón chểt, cảc ôông chưa toọc lới tà àn Thiên Chùa phàn côống mếng, xí ní: <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘Ho là Chùa Tlới của Áp-ra-ham, Chùa Tlới của Y-sác, Chùa Tlới của Gia-cốp?’ Thiên Chùa chăng phải là Thiên Chùa của moón chểt, mơi là của moón khôồng.” <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />Caá măng như xí, tán dân pí kinh ngạc vến lới táy của Ngái.<verse eid="MAT 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Cón cảc moón Pha-ri-si, khâu khới măng là Ngái tà mấn mầy moón Sa-đu-sê im ménh, xì tà tập tlung côống phố. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Mộch moón tloong sồ maáng, là thấy táy luật, tà poi tể xử Ngái — <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />"Thưa Thấy, tiếu răn nó là náy nhẩt tloong luật phảp?” <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />Rối Ngái vé côống ái ha: ""Hảy yêu mền Chùa, là Thiên Chùa của con, pắng tẩt cả tầm lóng con, côống tẩt cả linh hốn con ôộng tẩt cả tlì tuế con.' <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Rì là tiếu răn náy ôộng quan tlóng nhẩt. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Cón tiếu răn xừ han chôồng như tiếu rì - 'Hảy yêu xương moón ở khênh của con như chình mếng.' <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Tẩt cả luật phảp ôộng cảc tiên tli àn dứa xeo hai tiếu răn ní."<verse eid="MAT 22:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Caá ní, khâu khới mầy moón Pha-ri-si àn tập tlung côống phố, Chùa Giê-xu poi maáng, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />xí ní: "Cảc ôông nghỉ xí nó vến Chùa cừu thề? Ngái là con của ôông ay?” Maáng tlả lới Ngái: “Con vua Đa-vít.” <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />Ngái é côống maáng: "Rêng mấn xí nó mà Đa-vít, tloong Thành Linh, hôổc Ngái là Chùa, khới vé:<verse eid="MAT 22:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="MAT 22:44" />‘Chùa phàn côống Chùa tôi:</para>
  <para style="q" vid="MAT 22:44">“Hảy ngối khà chăm Ho,</para>
  <para style="q" vid="MAT 22:44">cho tềng khới nó Ho tệch cảc keẻ thú của con tìn chó con”.’<verse eid="MAT 22:44" /></para>
  <para style="b" />
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Xí nều Đa-vít hôổc Ngái là 'Chùa', xì mấn xí nó Ngái là con vua rì?" <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Chăng ay cò thể tlả lới lái Ngái mộch lới, yý chăng mộch moón nó dàm poi Ngái nửa kể pở ngáy hôm rì.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Khâu rì, Chùa Giê-xu vé côống tán dân mân cảc môn tố mếng, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />xí ní: “Cảc thấy táy luật ôộng moón Pha-ri-si ngối tlêng ghề của Môi-se. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Pởi xí, nều maáng truyến táy ái ới ùn pẩt kể tiếu chi, hảy mấn ôộng tuân xeo tẩt cả. Mơi má mấn xeo cảc việc mấn của maáng, ví maáng vé mơi chăng mấn. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Maáng puộc cảc tliêng nắng ôộng khò vang, rối chẩt lêng vai moón khảc, mơi chình maáng chăng moành chám ngòn xay mếng pao phè. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />Maáng mấn tẩt cả cảc việc của mếng tể àn con moón hẩu kỉa. Ví maáng mấn cảc hộp tứng kinh luật của mếng cho náy mân kểt cảc tua ào mếng cho dán. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Maáng ưa cảc tược quan tlóng nhẩt tloong đàm tiệc, ôộng cảc tược tôn kình nhẩt tloong nhá hối, <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />côống cảc lới cháo ở vái phồ chớ, mân àn tán dân hôổc là 'Ra-bi.’ <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Mơi ái ới ùn chăng rêng àn hôổc là 'Ra-bi', ví thấy của ái ới ùn chỉ cò mộch, cón tẩt cả ái ới ùn là enh ùn. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Ôộng ái ới ùn má hôổc pẩt ký ôông ay tlêng tẩt là 'cha' ví ái ới ùn chỉ cò mộch Cha tlêng tlới. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Yý má tể mếng àn hôổc là 'giào chủ,' ví giào chủ của ái ới ùn chỉ cò mộch - nghỉa là Chùa Cừu Thề. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Mơi moón náy nhẩt khừa voóng ái ới ùn sẻ là moón hấu ái ới ùn. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Cón ôông ay tứ tôn mếng lêng sẻ pí há xuồng; ôộng ôông ay tứ há mếng xuồng sẻ àn tôn lêng.<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />Mơi khồn nán cho cảc ôông, cảc thấy táy luật ôộng moón Pha-ri-si, tán đáo đửc giả kia! Pởi cảc ôông toòng vương quổc thiên đáng lái tlưởc mặt maáng. Ví cảc ôông xì chăng pao tloong, yý chăng tể cho ôông ay ti pao àn pưởc pao tloong. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />[Khồn nán cho cảc ôông, cảc thấy táy luật mân moón Pha-ri-si, tán đáo đửc giả kia! Pởi cảc ôông ăn roảch nhá cảc mú goà, mơi cấu nguyến xật dán doóng tloong sứ chả vớ.] Ví lỳ do rì, cảc ôông sẻ nhấn àn pản tuyên à nắng hơn. <verse eid="MAT 23:14" /><verse number="15" style="v" sid="MAT 23:15" />Khồn nán cho cảc ôông, cảc thấy táy luật ôộng moón Pha-ri-si, tán đáo đửc giả! Ví cảc ôông ti khồm piển cả mân tẩt liến tể mấn cho mộch moón xeo đáo, ôộng khới moón rì tà tlở rêng như xí, cảc ôông mấn cho moón rì rêng từa con của hoả ngục gẩp han lấn cảc ôông.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />Khồn nán cho cảc ôông, tán moón tun mú, nghỉa là cảc moón vé: 'Moón nó thế pởi tến thớ xì chăng xí nó. Mơi moón nó thế pởi váng của tến thớ xì rì là pẳt puộc.' <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Tán moón ngu dổt ôộng tán tun mú kia! Ví tiếu nó là quan tlóng hơn, váng hay tến thớ mấn váng àn thành? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Lái cón: 'Moón nó thế pởi pán thớ xì chăng xí nó. Mơi moón nó thế pởi của lể khà tlêng pán thớ xì rì là pẳt puộc.' <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Tán moón ngu dổt ôộng tun mú kia! Ví tiếu nó quan tlóng hơn, của lể hay pán thớ mấn của lể rêng thành? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Pởi xí, ay tà thế pởi pán thớ xì thế pởi pán thớ mân pởi tẩt cả cảc xừ khà tlêng rì. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Ay tà thế pởi tến thớ xì thế pởi tến thớ mân pởi Tầng ngứ tloong rì. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Ôộng ôông ay tà thế pởi tlới thì thế pởi ngôi của Thiên Chùa mân pởi Tầng ngứ tlêng rì.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />Khồn nán cho cảc ôông, cảc thấy táy luật ôộng moón Pha-ri-si, tán đáo đửc giả kia! Ví cảc ôông nộp phấn mưới pạc há, thí lá ôộng xâu cấn, mơi lái phêng ti cảc tiếu quan tlóng hơn của luật phảp - nghỉa là sứ côông chình, loóng xương xỏt mân sứ tlung tìn. Mặt khảc, rì là tiếu cấn thiểt tể mấn xeo cảc việc ní, ôộng chăng lảc ti cảc việc kia. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Tán tưa khà tun mú kia, nghỉa là cảc moón loọc xa mộch con ma cở rẩt énh, mơi roảch ti mộch con lạc đá!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />Khồn nán cho cảc ôông, cảc thấy táy luật ôộng moón Pha-ri-si, tán đáo đửc giả! Ví cảc ôông xửa quang khà vái của chèn ôộng tỉa, mơi khà tloong xì phè cò tấy sứ ăn cưởp mân puông thả. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Cảc moón Pha-ri-si tun mú kia! Tlưởc tiên, hảy xửa quang khà tloong chèn mân tỉa, tể khà vái của phè yý tlở rêng àn quang.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />Khồn nán cho cảc ôông cảc thấy táy luật ôộng moón Pha-ri-si, tán đảo đửc giả kia! Ví cảc ôông chôồng cảc cày mả àn tô tlằng, là cảc xừ tuy tỏ xa là oai khà vái, mơi khà tloong xì tấy xương moón chểt mân tủ xừ pẩn thỉu. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Yý chôồng như xí, tuy khà vái cảc ôông xa vẻ côông chình đồi côống maáng, mơi khà tloong cảc ôông xì tấy thòi giả hính ôộng chăng luật phảp.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />Khồn nán cho cảc ôông, cảc thấy táy luật ôộng moón Pha-ri-si, tán đáo đửc giả kia! Ví cảc ôông xây mả của cảc ví tiên tli mân tlang hoáng mố mả của cảc moón côông chình. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Cảc ôông pảo: ‘Nều tán tôi ở tloong thới của cảc tổ tiên mếng, xì chẳc là tán tôi tà chăng mấn cảc moón chung phấn côống maáng ở mầu của cảc ví tiên tli.' <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Xí rêng, cảc ôông tứ mấn chừng vến mếng là mếng là xôn con của cảc moón tà giểt cảc ví tiên tli, <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />ôộng cảc ôông hảy mấn cho tấy cày lướng xối ảc của tổ tiên mếng! <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Tán xành tô ộc kia, doóng dỏi của xành lục, cảc ôông sẻ chắn thoảt khỏi sứ đoàn phạt của hoả ngục như xí nó? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Ví lỳ do ní, hảy hẩu rạ, tôi khai phài cảc ví tiên tli, moón khôn ngoan mân thấy táy luật tềng côống cảc ôông. Pở khừa voóng maáng, cảc ôông sẻ tành tón tloong cảc nhá hối mếng ôộng truy tuổi pở thánh ní qua thánh khảc. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Xí nó cho cò thể tềng tlêng cảc ôông tẩt cả mầu côông chình pí tổ xa tlêng tẩt, pở mầu của A-bên, moón côông chình, cho tềng mầu của Xa-cha-ri, con từa Ba-ra-chi, moón mà cảc ôông tà giểt chểt khừa tến thớ mân pán thớ. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Xật sứ, tôi vé côống cảc ôông, tẩt cả việc rì sẻ xảy tềng tlêng thề hế ní.<verse eid="MAT 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />Giê-ru-sa-lem, Giê-ru-sa-lem, dâu tà giểt chểt cảc nhá tiên tli ôộng nèm phú cảc moón àn khai tềng côống dâu! Cớ nó lấn ho moành tập tlung xôn con của dâu lái, xeo cảch mà kha mài tập hợp con mếng tìn kènh, mơi dâu chăng moành! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Hẩu rạ, nhá của cảc ôông sẻ pí tể lái hoang vu cho cảc ôông. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Ví tôi vé côống cảc ôông, cảc ôông chẳc chằn sẻ chăng kỉa tôi pở caá ní cho tềng khới nó cảc ôông vé: 'Chủc túng Tầng tềng tloong danh Chùa!""<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Khâu khới xa khỏi tến thớ, Chùa Giê-xu tiểp tục chuyền ti. Rối cảc môn tố Ngái tềng khênh tể chỉ cho Ngái hẩu cảc côông tlính của tến thớ. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Mơi khới tlả lới lái, Ngái pảo maáng: "Ái ùn chăng hẩu kỉa tẩt cả xừ rì à? Xật sứ, thấy vé côống ái ùn, tược rì chẳc chằn sẻ chăng cón lái tảng phú ní tlêng tảng phú kia mà chăng pí phà tổ."<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Caá ní, khới Ngái tang ngối tlêng nùi Ô-liu, cảc môn tố tềng riêng khênh Ngái, thưa: "Cườn cho tán tôi mẳt khới nó cảc việc rì sẻ xảy xa, mân dầu hiếu sứ tềng của thấy mân của ký tấn thề là xí nó?" <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />Khới tlả lới, Chùa Giê-xu vé côống maáng: "Hảy cẩn thấn tể chăng ôông ay cò thể mấn cho ái ùn lấm lạc. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Ví nhiếu moón sẻ tềng tloong danh thấy, xưng: 'Ho là Chùa Cừu Thề,' ôộng sẻ mấn cho nhiếu moón lấm lạc. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Mặt khảc, ái ùn pú măng vến chiền tlanh mân cảc tin vến chiền tlanh. Ái ùn hảy cẩn thấn, má pí pồi rồi, ví việc rì cấn phải xảy xa, mơi vẩn chưa phải là cuồi cúng. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Ví dân ní sẻ rổi lêng chồng lái dân khảc, nưởc ní chồng lái nưởc kia, rối sẻ cò tòi kèm ôộng tôống tẩt ở nhiếu tược. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Mơi tẩt cả cảc việc ní là tiểm pẳt tấu của cảc cơn tâu teẻ. <verse eid="MAT 24:8" /><verse number="9" style="v" sid="MAT 24:9" />Khâu rì, maáng sẻ tẩy ái ùn pao kẻnh hoán nán rối giểt ái ùn ti, ôộng ái ùn sẻ pí tẩt cả cảc dân căm khẻt ví pởi danh thấy. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Rối nhiếu moón sẻ pí vẩp phám, phản bối phố ôộng thú khẻt phố. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Nhiếu tiên tli giả sẻ àn rổi lêng ôộng mấn cho nhiếu moón lấm lạc. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Vì tính tláng vô luật phảp sẻ pí tăng lêng, tính yêu của nhiếu moón sẻ pí phai nhạt. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Mơi ay pến loóng cho tềng cuồi cúng, moón rì sẻ àn cừu. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Tin Lénh ní vến vương quổc sẻ àn rao giảng khồm thề giời tể mấn mộch lới chừng cho muôn dân, ôộng rối sứ cuồi cũng sẻ tềng.<verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />Pởi xí, khới ái ùn hẩu kỉa tiếu kinh tởm của kẻnh hoang tán, là tiếu tà àn tiên tli Đa-ni-ên vé tềng, tệch tloong tược thành" (moón toọc phải hiểu), <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />"caá rì, ay ở tloong púng Giu-đê hảy chắn tlồn tềng púng nùi, <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />ay ở tlêng mài nhá, má ti xuồng tể lế cày chi khỏi nhá mếng, <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />ôộng ay ở vái tôống má tlở vến tể lế ào khoảc mếng. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Mơi xật khồn khổ cho phú nử cò chửa mân ôông ay tang cho con ù tloong cảc ngáy rì! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Mơi hảy cấu nguyến tể việc chắn tlồn của ái ùn chăng xảy xa pao múa tôông, hay pao ngáy Sa-bát. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Ví caá rì sẻ cò sứ hoán nán náy, chưa caá nó xảy xa chôồng như xí pở caá pẳt tấu thề giời cho tềng ngáy nay, ôộng chẳc chằn yý sẻ chăng cò. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Nều cảc ngáy rì chăng àn rủt pằn, xì chẳc là tẩt cả xảc xịt tà chăng àn cừu. Mơi ví pởi cảc moón àn chón, cảc ngáy rì sẻ àn giảm ti. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />Caá rì, nều cò ôông ay rì vé côống ái ùn: 'Hẩu rạ, Chùa Cừu Thề ở ní!' hay 'Ở rì!' xì ái ùn má tin. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Ví cảc cừu chùa giả côống cảc tiên tli giả sẻ àn nơng lêng mân tỏ xa cảc dầu hiếu côống cảc phẻp lá náy tềng nổi mấn cho lấm lạc, nều cò thể, xì ngay cả cảc moón àn chón. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Hẩu ní, thấy vé tlưởc cho ái ùn rối rá. <verse eid="MAT 24:25" /><verse number="26" style="v" sid="MAT 24:26" />Xí rêng, nều maáng vé côống ái ùn: ‘Hẩu rạ, Ngái tang ở vái hoang mạc,’ xì ái ùn chăng rêng ti xa rì. Hay 'Hẩu ní, ở cảc phoóng kìn,' xì ái ùn má cò tin. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Ví tia chởp phảt xa pở táng tôông rối vụt tlàng tềng tlỏng táng tây xí nó, xì sứ hiến tềng của Con Moón sẻ là như xí. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Nều xảc chểt ở tược nó, kến kến sẻ pu lái ở rì.<verse eid="MAT 24:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />Mơi ngay khâu cơn hoán nán của cảc ngáy rì, mặt tlới sẻ pí mấn cho xồn xăm, mặt tlăng sẻ chăng chiều ènh tlàng của reé, cảc ngôi khao sẻ pở tlới rúng xuồng, mân cảc quyến lực của cảc tấng tlới sẻ pí rung chuyển. <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />Caá rì, dầu hiếu vến Con Moón sẻ àn tỏ xa tlêng tlới, ôộng rối tẩt cả cảc dân tộc tlêng tẩt sẻ than nhám. Maáng sẻ kỉa Con Moón tềng tlêng cảc đàm mân tlới côống quyến phẻp mân vinh quang vỉ đaái. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Ngái sẻ khai phài cảc thiên sừ của Ngái côống xiềng kén náy, mân maáng sẻ tập tlung lái cảc moón àn chón của Ngái pở pồn phương, pở cuồi púng tlới ní tềng tlỏng cuồi púng tlới kia.<verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />Mặt khảc, hảy hoọc mẳt ẩn dú ní pở câl vả. Khới nhènh reé tlở rêng mếm mân xa là rối, xì ái ùn mẳt là múa hé khênh tềng. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Ýý xeo cảch rì, khới ái ùn kỉa tẩt cả tiếu ní, xì ái ùn mẳt là Ngái tang ở khênh, ngay tái cửa. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Xật sứ, thấy vé xật côống ái ùn, là thề hế ní chẳc chằn sẻ chăng qua ti cho tềng khới nó tẩt cả cảc tiếu rì tà xảy xa. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Tlới ôộng tẩt sẻ qua ti, mơi cảc lới của thấy chẳc chằn sẻ chăng qua ti. <verse eid="MAT 24:35" /><verse number="36" style="v" sid="MAT 24:36" />Cón liên quan tềng ngáy mân giớ rì xì chăng ay mẳt, kể cả cảc thiên sừ tlêng thiên đáng hay Con, tlứ xa Cha mà rôi. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Pởi thới Nô-ê như xí nó, xì sứ tềng của Con Moón sẻ là như xí rì. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Ví như tloong cảc ngáy tlưởc cơn rảc lụt, maáng tà ăn oòng, cười gả cho tềng ngáy Nô-ê pao tloong tấu, <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />ôộng maáng chăng nhấn xa cho tềng caá rảc lụt tềng mân cuồn maáng ti - sứ tềng của Con Moón yý sẻ là như xí. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Caá rì, han moón tán ôông tang ở vái tôống - mộch moón sẻ àn tom ti, mộch moón àn tể lái. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Han mú daá tang xay cồn - mộch moón sẻ àn tom ti, mộch moón àn tể lái. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />Pởi xí, hảy kẻnh giảc ví ái ùn chăng mẳt pao ngáy nó Chùa mếng sẻ tềng. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Mơi ái ùn hay àn việc ní, là nều chủ nhá tà mẳt moón lốm tềng pao giớ nó của têm, xì chẳc là ôông rì tà kẻnh giảc mân chẳc chăng tể cho nhá mếng pí đột nhập. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Ví lỳ do ní, ái ùn yý phải tlở rêng sẳn sáng, ví Con Moón sẻ tềng tloong giớ ái ùn chăng nghỉ tềng.<verse eid="MAT 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />Cho rêng, ay là moón hấu tlung tìn mân khôn ngoan mà chủ tệch chăm nom tlêng moón nhá của chủ tể cung cẩp tố ăn cho maáng pao tùng thới điểm? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Phưởc quà là moón hấu rì, là moón mà chủ của ái, khâu khới tềng, sẻ kỉa ái tang mấn như xí. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Xật sứ, thấy vé côống ái ùn là chủ sẻ tệch tể ái ha chăm nom tlêng tẩt cả xừ chủ cò. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Mơi nều xên moón hấu tôộc ảc rì vé tloong loóng mếng: 'Chủ ho tang pí muốn.' <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />Rối pẳt tấu tành tập cảc moón côống là moón hấu côống mếng, mơi ăn oòng côống tán phay ráo, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />xì moón chủ của moón hấu rì sẻ tềng pao ngáy mà reé chăng moong tới mân tloong giớ mà reé chăng mẳt. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Ôông rì sẻ tành xè reé rẩt nghiêm khẳc mân sẻ ần đính tược của reé chung côống tán đáo đửc giả; ở tược rì sẻ cò sứ than nhám mân nghiền xăng.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />rêng, vương quổc thiên đáng sẻ àn hẩu như mưới trinh nử, là cảc moón cấm tén mếng ti xa mân tềng tược tòn tiểp chù rể. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Mơi răm vaá tloong sồ maáng là ngu, mân răm vaá xì khôn. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Ví răm vaá ngu, khâu khới cấm tén của maáng ti, tà chăng tom dấu xeo côống mếng. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Mơi cảc vaá khôn xì tà tom dấu xeo tloong pính côống tén mếng. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Caá ní, ví chù rể lô tềng, tẩt cả maáng tà tlở rêng mủ mặt rối tảy phêng ti. <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />Mơi pao nửa têm, cò xiềng hô: 'Chù rể rạ! Hảy ti xa tềng rì tòn tiểp." <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />Caá rì, tẩt cả cảc trinh nử rì àn tành thửc mân chuẩn pí tén mếng. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Caá ní, cảc vaá ngu vé côống cảc vaá khôn: ‘Cườn cho tán tôi phấn dấu của cảc vaá, ví tén của tán tôi pú xẳt.' <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />Mơi khới tlả lới lái, cảc vaá khôn vé: 'Rưởi là sẻ chăng thể nó cò tủ cho tán tôi mân cảc ới. Thay pao rì, hảy ti tềng cảc moón puôn paành mà mua cho mếng.' <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Mơi, tloong khới maáng ti mua, chù rể tà tềng, ôộng ôông ay sẳn sáng côống chù rể xì pao tloong pừa tiệc cười, rối cửa àn toòng lái. <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" />Rối khâu rì, cảc trinh nử kia yý tềng, thưa: 'Chủ ới, chủ ới, cườn vở cửa cho tán tôi.' <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />Mơi khới tlả lới lái, chủ vé: 'Xật sứ, tôi vé côống cảc vaá, tôi chăng mẳt cảc vaá.' <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />Rêng, hảy tỉnh thửc, ví ái ùn chăng hay ngáy hay giớ.<verse eid="MAT 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />Ví chô ồng như mộch moón pú ti táng giang, ôông tà hôổc cảc moón hấu của mếng lái ôộng giao cho maáng tái sản của ôông. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Ôông cho moón ní răm ta-lâng, moón kia han ta-lâng, moón khảc nửa mộch ta-lâng - đồi côống mổi moón tuý xeo khả năng riêng. Rối ôông liến lêng khà ti táng giang. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Khới ôông ti rối, moón nhấn răm ta-lâng tà đấu tư pở phè mân kiếm àn răm ta-lâng khảc. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Ýy như xí, moón cò han ta-lâng yý kiềm àn han ta-lâng khảc. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Mơi moón tà nhấn mộch ta-lâng, khâu khới ti xa, tà táo tẩt mân chù xiến của chủ mếng. <verse eid="MAT 25:18" /><verse number="19" style="v" sid="MAT 25:19" />Caá ní, khâu mộch thới gian dán, chủ của cảc moón hấu rì tềng mân tình toàn sổ sảch côống maáng. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Khâu khới tềng khênh, moón nhấn răm ta-lâng tà tom răm ta-lâng khảc, vé xí ní: 'Thưa ôông chủ, ôông tà giao cho tôi răm ta-lâng. Mơi cườn hẩu ní, tôi tà mấn lới xêm răm ta-lâng.' <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />Chủ của ái vé côống ái: 'Tổt lặm, ái moón hấu ngay lénh mân tlung tìn! Ái tà tlung tìn tlêng mầy việc. Tôi sẻ lập ái chăm nom tlêng nhiếu việc. Hảy pao tloong niếm phui của chủ mếng.' <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />Moón cò han ta-lâng, khâu khới tềng khênh, yý tà vé: 'Thưa ôông chủ, ôông tà giao cho tôi han ta-lâng, mơi cườn hẩu ní, tôi tà mấn lới xêm han ta-lâng.' <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />Chủ của ái vé côống ái: ‘Tổt lặm, ái moón hấu ngay lénh mân tlung tìn! Ái tà tlung tìn tlêng mầy việc. Tôi sẻ lập ái chăm nom tlêng nhiếu việc. Hảy pao tloong niếm phui của chủ mếng.' <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />Cón moón nhấn mộch ta-lâng, yý tiền tềng, tà vé: 'Thưa ôông chủ, tôi mẳt ôông, là ôông là mộch moón nghiêm khẳc, gặt ở tược mếng chăng oải mân thu hoạch ở tược mếng chăng rải xa. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Ví măng rưởi, rêng khâu khới ti xa, tôi tà chù ta-lâng của ôông tìn tẩt. Cườn hẩu ní, ôông cò phấn của mếng.' <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />Mơi caá tlả lới lái, moón chủ của xên rì vé côống reé: 'Xên moón hấu gian ảc mân tlái kia! Ái xì tà mẳt là tôi gặt ở tược tôi chăng oải mân thu hoạch ở tược tôi chăng rải xa. <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Xí xì, tùng xa ái cấn phải tom tể xiến của tôi ở ngân háng, rối khâu khới tềng, xì chẳc là tôi tà nhấn lái vồn của tôi mân xiến lải. <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Xí rêng, hảy lế ta-lâng của xên ní ôộng tưa phè cho moón tang cò mưới ta-lâng. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Ví côống moón tang cò, xì tẩt cả sẻ àn pan cho - tềng nổi sẻ àn dư dả. Mơi đồi côống moón chăng cò, xì ngay cả tiếu reé cò sẻ pí lế ti khỏi reé. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Ôộng hảy nèm xên moón hấu vô ỉch rì pao tược xồn xăm khà vái, là tược sẻ cò sứ than nhám mân nghiền xăng.'<verse eid="MAT 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />Cón khới Con Moón tềng tloong vinh quang Ngái mân tẩt cả thiên sừ côống Ngái, xì khới rì, Ngái sẻ ngối tlêng ngôi vinh hiển mếng. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Tẩt cả cảc dân sẻ tập tlung tlưởc mặt Ngái, ôộng Ngái sẻ phân chia maáng côống phố, như là moón chăn phân chia chiên xa khỏi tê. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Ngái sẻ tể chiên ở khà chăm mếng, cón tê ở khà chiêu. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Khâu rì, Vua sẻ pảo ôông ay ở táng chăm mếng: 'Cảc moón tà àn Cha Ho pan phưởc, tềng ní rạ, hảy hưởng vương quổc tà àn chuẩn pí khẳn cho mếng pở caá mấn rêng thề giời. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Ví Ho tòi, xì cảc con cho Ho ăn; Ho khảt, xì cảc con cho Ho oòng; Ho là khẻch lá, xì cảc con tiểp tòn Ho; <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Ho ở lo, xì cảc con mặc cho Ho; Ho tâu ồm, xì cảc con chăm nom Ho; Ho ở tloong tú, xì cảc con tềng thăm Ho.' <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />Khới rì, cảc moón côông chình sẻ tlả lới Ngái: ‘Láy Chùa, tán con tà kỉa Ngái tòi mà cho ăn, hay là khảt mà cho oòng pao caá nó? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Rối tán con tà kỉa Ngái như khẻch lá mà tiểp đải, hay ở lo mà mặc cho pao caá nó? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Ôộng tán con tà kỉa Ngái tâu ồm hay ở tloong tú khới nó mà tềng côống Ngái? <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Khới tlả lới, Vua sẻ vé côống maáng: 'Xật sứ, Ho vé côống cảc con, tuý xeo tẩt cả cảc việc cảc con tà mấn cho mộch tloong cảc moón énh nhẩt cho cảc ái ới ùn ní của Ho, xì cảc con tà mấn cho Ho.' <verse eid="MAT 25:40" /><verse number="41" style="v" sid="MAT 25:41" />Tiểp xeo, Vua yý sẻ pảo cảc moón ở táng chiêu: 'Hảy ti xa khỏi Ho, cảc moón pí nguyến rủa kia, ti tềng lửa tới tới tà tể khẳn cho ma quỷ mân cảc quỳ sừ của reé. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />ví Ho tòi, tán pay chăng cho Ho ăn; ho khảt mà tán pay chăng cho Ho oòng; <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Ho là khẻch lá, mà tán pay chăng tiểp tòn Ho; ở lo xì tán pay chăng mặc cho Ho; tâu ồm mân ở tloong tú, xì tán pay chăng chăm nom Ho.' <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />Khới rì, maáng yý sẻ tlả lới, xí ní: 'Thưa Chùa, tán con tà kỉa Ngái tòi, hay khảt, hoặc như khẻch lá, hay ở lo, hoặc tâu ồm, hay ở tloong tú caá nó mà chăng phục vuú Ngái?' <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Xí rối, Vua sẻ tlả lới maáng, xí ní: 'Xật sứ, Ho vé côống tán pay, tuý xeo tẩt cả cảc việc tán pay tà chăng mấn cho mộch tloong cảc moón énh nhẩt cho cảc moón ní, xì tán pay tà chăng mấn cho Ho.' <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />Tán moón rì sẻ ti pao sứ hính phạt tới tới, cón cảc moón côông chình xì pao sứ khôồng tới tới.”<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Việc xảy xa khới Chùa Giê-xu tà kểt thủc tẩt cả cảc lới rì, Ngái pảo cảc môn tố mếng: <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />"Ái ùn hay là han ngáy nửa sẻ tềng lể Vượt Qua, ôộng Con Moón sẻ pí nộp tể chíu toòng tenh tlêng câl thập tứ.” <verse eid="MAT 26:2" /><verse number="3" style="v" sid="MAT 26:3" />Caá rì, cảc thấy tề lể thướng phẩm ôộng cảc tlưởng lảo tloong tán dân tà àn tập tlung tloong dinh của thấy cả thướng phẩm, xên là Cai-phe. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Maáng côống phố pán luấn tể maáng cò thể pắng mưu kề pẳt Chùa Giê-xu mân giểt Ngái ti. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Mơi maáng vé: "Chăng phải tloong dịp lể, tể páo loán chăng xảy xa khừa voóng tán dân."<verse eid="MAT 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Caá ní, khới Chùa Giê-xu tà ở Bê-tha-ni, tloong nhá Si-môn, moón pí phoong hủi, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />mộch phú nử tom cày pính ngoọc tứng loái dấu tẳt xiến lặm tềng khênh Ngái, mân ới tổ lêng tlổc Ngái, tang khới ngối ăn. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />Mơi khâu khới kỉa xí, cảc môn tố rổi giấn, pảo: "Lảng phì xí ní tể mấn chi? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Ví dấu ní cò thể paành àn nhiếu xiến mân pồ thì cho moón nghéo." <verse eid="MAT 26:9" /><verse number="10" style="v" sid="MAT 26:10" />Mơi mẳt tiếu ní, Chùa Giê-xu pảo maáng: "Rêng nó ái ùn mấn khò moón phú nử ní? Ví ới tà mấn mộch việc tổt cho thấy. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Pởi ái ùn luôn cò moón nghéo ở côống mếng, mơi chăng phải ái ùn luôn cò thấy. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Ví khới ới tổ dấu ní lêng thấy, ơi tà mấn xí cho việc chôn cẩt thấy. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Xật sứ, thấy vé côống ái ùn, pẩt ký tược nó Tin Lénh ní àn giảng xa tlêng khồm thề giời, xì việc ới ní tà mấn yý sẻ àn vé tềng tể mà că ắn tềng vến ới."<verse eid="MAT 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Caá rì, mộch tloong mưới han sừ tố, xên là Giu-đa ích-ca-ri-ốt ti, khâu khới tềng côống cảc thấy tể lể cả, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />tà vé: "Cảc ôông khẳn loóng tlả tôi cớ nó, rối tôi sẻ giao nộp moón rì cho cảc ôông?" Xí là, maáng cân cho reé pa mươi siếc-lơ pạc. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Ôộng pở thới điểm rì, reé pẳt tấu xím cơ hối tể cò thể giao nộp Ngái.<verse eid="MAT 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Caá ní, pao ngáy xừ nhẩt của lể Pènh Chăng Men, cảc môn tố tềng khênh Chùa Giê-xu, thưa: "Thấy moành tán tôi chuẩn pí cho thấy ăn lể Vượt Qua ở nó?" <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />Rối Ngái pảo: "Hảy ti pao thánh, tềng côống mộch moón kia ôộng vé côống ái ha: 'Thấy pảo: "Thới điểm của thấy xì tang khênh tềng; thấy mấn lể Vượt Qua ở nhá ái côống cảc môn tố thấy."" <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Cảc môn tố mấn như Chùa Giê-xu hường dẩn maáng, ôộng maáng chuẩn pí lể Vượt Qua.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Caá ní, khới puổi xồn tềng, Ngái ngối ăn côống mưới han sừ tố. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Khới maáng tang ăn, Ngái vé: “Xật sứ, thấy vé côống ái ùn là mộch moón tloong ái ùn sẻ phản thấy." <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />Ví puốn rấu quà, mổi mộch moón pẳt tấu thưa côống Ngái: "Chùa ới, chăng phải tôi vày?" <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />Mơi tể tlả lới, Ngái vé: "Moón tà chụ xay mếng pao tloong tìa chung côống thấy, moón rì sẻ phản thấy. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Tuy Con Moón sẻ xa ti, xeo như lới tà àn chẻp vến Ngái, mơi khồn nán quà cho moón rì, pởi reé mà Con Moón pí phản pối! Nều moón rì tà chăng àn teẻ xa xì tổt hơn cho reé." <verse eid="MAT 26:24" /><verse number="25" style="v" sid="MAT 26:25" />Mơi khới tlả lới lái, Giu-đa, xên phản Ngái, vé: "Ra-bi, chăng lẻ là tôi?" Ngái vé côống ôông: "Ái tà tứ vé rối."<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Caá ní, khới maáng tang ăn, caá lế pènh mân chủc tá rối, Chùa Giê-xu tà pẻ reé xa. Ôộng khâu khới tưa cho cảc môn tố, Ngái vé: "Hảy nhấn lế, ăn ti. Ní là pỏc mếng của tháy." <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />Ôộng caá lế chèn ôộng tá ơn rối, Ngái tà tưa cho maáng, pảo: "Tẩt cả hảy oòng ở chèn ní. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Ví ní là mầu giao ưởc của thấy àn tổ xa đồi côống nhiếu moón dánh cho sứ tha thừ xối lổi. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Mơi thấy vé côống ái ùn kể pở thới điểm ní, thấy chẳc chằn sẻ chăng oòng cày rảc nho ní cho tềng ngáy rì, là caá mà thấy oòng rảc nho mời chung côống ái ùn tloong vương quổc của Cha thấy."<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Khâu khới hảt thành ca, maáng xa ti lêng nùi Ô-liu. <verse eid="MAT 26:30" /><verse number="31" style="v" sid="MAT 26:31" />Caá rì, Chùa Giê-xu vé côống maáng: “Tloong chình têm ní, tẩt cả ái ùn sẻ pí vẩp phám ví thấy, ví lới tà àn chẻp:</para>
  <para style="q" vid="MAT 26:31">‘Ho sẻ tành moón chăn</para>
  <para style="q" vid="MAT 26:31">rối chiên của tán sẻ pí tan tảc.’<verse eid="MAT 26:31" /></para>
  <para style="b" />
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />Rối khâu khới thấy àn mấn khôồng lái, thấy sẻ ti tlưởc ái ùn tềng Ga-li-lê."<verse eid="MAT 26:32" /></para>
  <para style="b" />
  <para style="m">
    <verse number="33" style="v" sid="MAT 26:33" />Mơi Phi-e-rơ tlả thưa côống Ngái: "Dú tẩt cả sẻ pí vẩp phám pởi thấy, mơi tôi sẻ chăng caá nó pí vẩp phám." <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" />Chùa Giê-xu vé côống ôông: “Xật sứ, thấy vé côống ái, là tloong chình têm nay, tlưởc khới kha cằn,ái sẻ chồi thấy pa lấn." <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />Phi-e-rơ thưa côống Ngái: “Ngay cả nều pẳt tôi phải chểt côống thấy, tôi chẳc chằn sẻ chăng tứ chồi thấy." Ôộng tẩt cả cảc môn tố yý vé chôồng như xí.<verse eid="MAT 26:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Khâu rì, Chùa Giê-xu ti côống maáng tềng mộch tược àn hôổc là Ghết-sê-ma-nê, ôộng Ngái pảo cảc môn tố: “Hảy ngối ní tloong khới thấy tềng táng kia cấu nguyến.” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Khâu khới tom xeo Phi-e-rơ mân han con từa của Xê-bê-đê, Ngái pẳt tấu tâu puốn mân phiến nảo. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Caá rì, Ngái vé côống maáng: “Linh hốn thấy tang sấu nảo lặm cho tềng chểt. Hảy ở lái ní mân tỉnh thửc chung côống thấy." <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />Khới tà ti giang xêm mộch ét, Ngái khẩp mặt mếng xuồng, cấu nguyến ôộng thưa: "Cha của con ới, nều tiếu ní là cò thể, cườn cho chèn ní qua khỏi con. Ngay cả như xí, chăng như con moành, mơi là như Cha." <verse eid="MAT 26:39" /><verse number="40" style="v" sid="MAT 26:40" />Rối Ngái tềng côống cảc môn tố mân kỉa maáng tang tảy, xì Ngái vé côống Phi-e-rơ: "Xí là, ái ùn chăng thể tỉnh thửc côống thấy àn mộch giớ à? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Hảy tỉnh thửc ôộng cấu nguyến tể ái ùn khỏi sa pao càm dổ. Tuy tâm linh xì moành lặm, mơi xảc xịt xì yều đuồi." <verse eid="MAT 26:41" /><verse number="42" style="v" sid="MAT 26:42" />Mộch lấn nửa, khới ti khỏi pao lấn xừ han, Ngái cấu nguyến, xí ní: "Cha của con ới, nều chuyến ní chăng cò thể qua ti, tềng khới con oòng chèn rì, xì cườn ỳ Cha àn rêng." <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Khâu khới tềng lấn nửa, Ngái kỉa maáng tang tảy, ví mẳt maáng tà măng mủ mặt. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Ôộng mộch lấn nửa, khâu khới tể maáng lái rối ti, Ngái cấu nguyến pao lấn xừ pa, vé chôồng cảc lới như xí nửa. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Khâu rì, Ngái tềng côống cảc môn tố mân vé côống maáng: "Ái ùn cón tang tảy mân hơi mai à? Hẩu rạ, giớ tềng khênh rối, ôộng Con Moón tang pí nộp pao xay cảc moón xối lổi. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Hảy từng dấn, tán ha rêng ti rôi. Hẩu rạ, xên phản thấy ti tềng rối."<verse eid="MAT 26:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Khới Ngái vẩn cón tang vé, xì hẩu rạ, Giu-đa, mộch tloong mưới han sừ tố, tềng, ôộng chung côống reé là mộch đàm moón rẩt khòm côống gươm mân câấy, pở tược cảc thấy tề lể thướng phẩm mân cảc tlưởng lảo tloong tán dân. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Caá ní, xên phản Ngái tà cho maáng mộch dầu hiếu, xí ní: "Moón nó mà tôi hôn xì là moón rì. Hảy pẳt ôông rì." <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Ngay caá rì, khâu khới tềng khênh Chùa Giê-xu, reé vé: "Cháo Ra-bi!" rối reé hôn Ngái. <verse eid="MAT 26:49" /><verse number="50" style="v" sid="MAT 26:50" />Mơi Chùa Giê-xu vé côống reé: “Pán à, ví tiếu ní mà ái tềng ní." Tiểp xeo, khâu khới tềng khênh, maáng xa xay tlêng Chùa Giê-xu ôộng pẳt giử Ngái. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Ôộng hẩu rạ, mộch tloong cảc moón ti côống Chùa Giê-xu, khới giơ xay xa, tà rủt gươm mếng mân chèm xên moón hấu của thấy tề lể thướng phẩm, cảch tểch lồ xai của ái ní. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Caá rì, Chùa Giê-xu pảo moón rì: "Hảy mon gươm của ái vến tược của reé, ví tẩt cả ôông ay cấm gươm sẻ chểt pởi gươm. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Hay ái nghỉ là thấy chăng cò quyến cấu khẩn Cha thấy, rối Ngái sẻ khai tềng ngay cho thấy hơn mưới han đáo binh thiên sừ à? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Xí xì, mấn xí nó cảc lới Kinh Thành àn ừng nghiếm, là chuyến ní phải xảy xa như xí?" <verse eid="MAT 26:54" /><verse number="55" style="v" sid="MAT 26:55" />Pao giớ rì, Chùa Giê-xu vé côống đàm tôông: "Cảc ôông ti xa cô ống gươm mân câấy tể pẳt tôi như chồng lái mộch xên cưởp à? Mổi ngáy, tôi ngối giảng táy tloong tến thớ mơi cảc ôông tà chăng pẳt tôi. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Mơi tẩt cả cảc việc ní xảy xa tể lới chẻp của cảc nhá tiên tli cò thể àn ừng nghiếm." Caá rì, khới lảc Ngái lái rối, tẩt cả cảc môn tố tà chắn tlồn.<verse eid="MAT 26:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Caá ní, cảc moón pẳt Chùa Giê-xu tà tưa Ngái tềng cho thấy tề lể thướng phẩm Cai-phe, là tược mà cảc thấy táy luật mân cảc tlưởng lảo àn tập tlung côống phố. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Cón Phi-e-rơ ti xeo Ngái pở táng giang cho tềng sân của thấy cả thướng phẩm. Khới pao khà tloong rối, ôông ngối xuồng chung côống tán lình kenh tể hẩu kểt cục xa xí nó. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />Caá ní, cảc thấy tề lể thướng phẩm mân tẩt cả Hối Tôống tang xím chừng lẻo chồng lái Chùa Giê-xu, xí nó cho maáng cò thể kểt àn tử hính Ngái. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Ôộng maáng chăng xím àn cày chi, ngay cả nhiếu moón mấn chừng lẻo tà từng xa. Mơi khâu rì, han mốn kia tiền lêng, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />tà vé: "Moón ní tà tuyên pồ: 'Tôi cò thể phà huỷ tến thớ của Thiên Chùa mân xây lái tloong pa ngáy'." <verse eid="MAT 26:61" /><verse number="62" style="v" sid="MAT 26:62" />Khâu khới từng dấn, thấy tề lể thướng phẩm pảo Ngái: "Ái chăng tlả lới à? Cảc moón ní tang mấn chừng chồng lái ái chuyến chi xí rì?" <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Mơi Chùa Giê-xu im lắng. Thấy tề lể thướng phẩm vé côống Ngái: “Pởi Thiên Chùa luôn luôn khôồng, tôi puộc ái tể ái vé cho tán tôi mẳt là ái cò phải là Chùa Cừu Thề, Con Thiên Chùa, hay chăng?" <verse eid="MAT 26:63" /><verse number="64" style="v" sid="MAT 26:64" />Chùa Giê-xu vé côống ôông ha: "Chình ôông tà tứ vé như xí. Ngay cả xí, tôi vé cho cảc ôông mẳt, kể pở thới điểm ní, cảc ôông sẻ kỉa Con Moón ngối ở táng chăm của Tầng Quyến Năng, mân ngứ tềng tlêng cảc đàm mân tlới." <verse eid="MAT 26:64" /><verse number="65" style="v" sid="MAT 26:65" />Caá ní, thấy tề lể thướng phẩm tà xè ào dán mếng, pảo: "Reé phám thướng! Xí nó tán ha cón cấn nhân chừng nửa? Hẩu rạ, caá ní cảc ôông tà măng lới phám thướng rì rối. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Cảc ôông nghỉ xí nó?” Rối khới tlả lới, maáng vé: “Reé xật là đàng chểt." <verse eid="MAT 26:66" /><verse number="67" style="v" sid="MAT 26:67" />Khâu rì, maáng chù pao mặt Ngái, tành tập Ngái, rối tảt Ngái, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />xí ní: “Hớ Chùa Cừu Thề, vé tiên tli cho tán tôi ti. Ay là moón tà tành ôông?”<verse eid="MAT 26:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Caá ní, Phi-e-rơ tang ngối tloong sân khà vái, ôộng mộch moón hấu cài tềng khênh ôông, vé: "Ôông yý ở chung côống Giê-xu, moón Ga-li-lê." <verse eid="MAT 26:69" /><verse number="70" style="v" sid="MAT 26:70" />Mơi ôông tứ chồi tlưởc mặt tẩt cả tán moón, là: “Tôi chăng mẳt vaá tang vé cày chi.” <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />Rối khâu khới ti xa tềng côổng, mộch moón hấu cài khảc tà hẩu kỉa ôông mân vé côống cảc moón ở rì: "Xên ní ở chung côống Giê-xu, moón Na-xa-rét." <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />Ôộng ôông lái tứ chồi côống mộch lới thế, xí ní: "Tôi chăng mẳt moón rì!" <verse eid="MAT 26:72" /><verse number="73" style="v" sid="MAT 26:73" />Mơi mộch ét khâu, cảc moón tà từng rì, khâu khới tềng khênh, tà vé côống Phi-e-rơ: "Chẳc chằn ôông yý ở tloong sồ tán maáng, ví ngay cả kiểu khề chuyến của ôông mấn cho ôông lố tẩy." <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />Caá rì, ôông pẳt tấu rủa, ôộng thế là: "Tôi chăng mẳt moón rì," rối ngay caá rì, kha cằn. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Ôộng Phi-e-rơ căắn lái lới Chùa Giê-xu tà vé, xí ní: “Tlưởc khới kha cằn, ái sẻ tứ chồi thấy pa lấn.” Rối khới tà ti xa khà vái, ôông nhám rẩt căn tằng.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Caá ní, pao caá tlàng khờm, tẩt cả cảc thấy tề lể thướng phẩm mân cảc tlưởng lảo tloong tán dân tà lập mưu tình kề chồng lái Chùa Giê-xu tể giểt Ngái ti. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Khới tà tlòi Ngái lái, maáng tưa Ngái ti ôộng giao nộp cho quan thồng đổc Phi-lát.<verse eid="MAT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Caá rì, khâu khới Giu-đa, xên phản Ngái, kỉa là Ngái tà pí kểt àn, xì ví ân hấn, reé tà tlả lái pa mươi siếc-lơ pạc cho cảc thấy tề lể thướng phẩm mân cảc tlưởng lảo, <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />vé xí ní: "Tôi tà phám xối ví phản nộp mầu vô xối." Mơi maáng pảo: "Liên quan chi tềng tán tôi? Ái chíu lế." <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />Ôộng khâu khới nèm mầy siếc-lơ pạc pao tloong tến thớ, reé lui ti, ôộng khới ti xa rối, reé xẳt cố ken tứ tử. <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />Caá ní, khâu khới xón sồ siếc-lơ pạc lêng, cảc thấy tề lể thướng phẩm vé: "Tể sồ pạc ní pao kho của tến thớ là chăng phải ví rì là cày già của mầu." <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Mơi khới tà pán pạc rối, maáng tà mua kènh tôống của moón thớ gồm pắng sồ pạc rì dánh cho việc chôn cẩt cảc khẻch lá. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Pởi xí, kènh tôống rì àn hôổc là "Roóng Mầu" cho tềng ngáy nay. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Xí là, tiếu àn rao giảng pởi tiên tli Giê-rê-mi tà àn ừng nghiếm, xí ní: "Maáng lế pa mươi siếc-lơ pạc, là già của moón àn đính, là moón mà tà àn tình già pở con cài Y-sơ-ra-ên, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />ôộng maáng tà tưa sồ pạc rì tể lế kènh tôống của thớ gồm, chôồng như Chùa tà hường dẩn ho."<verse eid="MAT 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Caá ní, Chùa Giê-xu từng tlưởc mặt quan thồng đổc, mân viên quan rì tla khảo Ngái, xí ní: "Cò phải ái là Vua moón Do Thài?" Rối Chùa Giê-xu vé côống ôông ha: "Ôông tang vé rạ." <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />Ôộng tloong khới Ngái pí tồ cào pởi cảc thấy tề lể thướng phẩm mân cảc tlưởng lảo, xì Ngái chăng tlả lới tiếu chi. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Khâu rì, Phi-lát vé côống Ngái: "Ái chăng măng mẳt cớ nó tiếu maáng tang mấn chừng chồng lái ái à?" <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Ôộng Ngái tà chăng tlả lới ôông ha, ngay cả pắng mộch lới yý chăng, tềng nổi quan thồng đổc kỉa lá lặm. <verse eid="MAT 27:14" /><verse number="15" style="v" sid="MAT 27:15" />Caá ní, pao dịp lể, quan thồng đổc tà cò thông lế tlởi cho tán dân mộch xối phám mà maáng chón. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Mặt khảc, tloong thới điểm rì, maáng tang giam mộch xên tú khẻt xiềng àn hôổc là Ba-ra-ba. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Xí rêng, khâu khới maáng àn tập tlung, Phi-lát vé côống maáng: "Cảc ôông moành tôi tlởi ôông ay cho cảc ôông? Ba-ra-ba, hay Giê-xu, moón àn hôổc là Chùa Cừu Thề?" <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Ví ôông tà mẳt là maáng tà giao nộp Ngái cho ôông pởi loóng ghen khẻt. <verse eid="MAT 27:18" /><verse number="19" style="v" sid="MAT 27:19" />Caá ní, tloong caá ôông tang ngối tlêng ghề xử àn, du của ôông tà khai cởi lới nhằn tềng ôông, xí ní: "Moong là chăng chuyến chi xảy tềng cho ái mân cho moón côông chình rì. Ví hôm nay, ùn dáy vó quà pởi mộch chiêm pao vến moón ní." <verse eid="MAT 27:19" /><verse number="20" style="v" sid="MAT 27:20" />Cón cảc thấy tề lể thướng phẩm mân cảc tlưởng lảo thuyểt phục tán dân tể maáng yêu cấu tlởi Ba-ra-ba mà xử tử Chùa Giê-xu. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Mơi tể tlả lới lái, quan thồng đổc vé côống maáng: "Cảc ôông moành tôi tlởi ôông ay tloong han moón ní cho cảc ôông?" Rối maáng pảo: "Ba-ra-ba." <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />Phi-lát vé côống maáng: "Xí, tôi cấn mấn chi côống Giê-xu, moón àn hôổc là Chùa Cừu Thề?" Tẩt cả tán maáng tlả lới: "Reé phải pí toòng tenh tlêng câl thập tứ." <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />Mơi ôông vé: "Ví tiếu ảc nó mà ái rì tà phám?" Mơi, maáng cáng rố náy hơn, xí ní: "Reé phỉa pí toòng tenh tlêng câl thập tứ." <verse eid="MAT 27:23" /><verse number="24" style="v" sid="MAT 27:24" />Caá ní, Phi-lát, khâu khới kỉa là mếng chăng giủp àn chi, mơi thay pao rì, mộch cuộc páo loán tang pú tềng, xì caá cho lế rảc rối, ôông ha tà xửa xay mếng tlưởc mặt tán dân, vé: "Tôi chăng cò xối ở mầu của moón ní. Cảc ôông chíu lế." <verse eid="MAT 27:24" /><verse number="25" style="v" sid="MAT 27:25" />Ôộng khới tlả lới lái, tẩt cả tán dân vé: "Mầu của reé ở tlêng tán tôi mân tlêng xôn con tán tôi." <verse eid="MAT 27:25" /><verse number="26" style="v" sid="MAT 27:26" />Khâu rì, ôông ha tlởi Ba-ra-ba cho maáng, rối khới tà cho tành tón Chùa Giê-xu, ôông cho giải Ngái ti tể chíu toòng tenh tlêng câl thập tứ.<verse eid="MAT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Caá rì, khâu khới tom Chùa Giê-xu pao tloong dinh thồng đổc, cảc pinh lình của quan thồng đổc tà tập tlung lái tlưởc mặt Ngái tẩt cả tlung đối. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Khâu khới lột hểt Ngái, phè khoảc mộch cày ào choáng mấu tỏ tươi lêng Ngái. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Caá tanh mộch cày vương miến pắng khoóng rối, phè tệch lêng tlổc Ngái, côống câl lâu pao xay chăm Ngái, ôộng khâu khới quý xuồng tlưởc mặt Ngái, phè chề nháo Ngái, xí ní: "Kình láy Vua moón Do Thài!" <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Rối khâu khới khạc chù pao Ngái, phè lế câl lâu mân cừ tành lêng tlổc Ngái. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Khới phè chề nháo Ngái xoong, phè cởi ào choáng xa mân mặc pao cho Ngái ào của Ngái, rối lôi Ngái ti tể toòng tenh tlêng câl thập tứ.<verse eid="MAT 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Caá ní, tang khới ti xa, phè kỉa mộch moón pở Sy-ren, xên Si-môn, mà phè pẳt ẻp tể ôông vảc câl thập tứ già của Ngái. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Khâu khới ti tềng mộch tược àn hôổc là Gô-gô-tha, mà tược rì nghỉa là 'Cày Xoó," <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />phè cho Ngái oòng ráo àn pha côống mật tằng. Khới tà rềm thử, xì Ngái chăng chíu oòng. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Caá ní, khới toòng tenh Ngái tlêng câl thập tứ rối, phè chia phố cày ào của Ngái pắng cảch pẳt thăm, <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />ôộng phè kenh giử Ngái, khới ngối ở rì. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Khà tlêng tlổc Ngái, phè tể xêm pản àn của Ngái, àn viểt xí ní: "Ní là Giê-xu, Vua moón Do Thài." <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Caá rì, cò han xên cưởp pí toòng tenh côống Ngái, mộch xên ở khà chăm ôộng mộch xên ở khà chiêu. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Cảc moón ti ngang qua sỉ nhục Ngái, lẳc tlổc mếng <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />ôộng vé: "Cày xên huỷ phà tến thớ mân xây lái tloong pa ngáy kia, hảy tứ cừu mếng ti! Nều dâu là Con Thiên Chùa, xì hảy xuồng khỏi câl thập tứ!" <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />Yý chôồng như xí, cảc thấy tề lể thướng phẩm, côống cảc thấy táy luật mân cảc tlưởng lảo, khới nháo pàng Ngái, tà vé: <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />"Reé tà cừu cảc moón khảc; reé xì chăng cò khả năng tứ cừu mếng. Reé là Vua của Y-sơ-ra-ên. Caá ní, reé phải xuồng khỏi câl thập tứ, xì tán ha sẻ ti pao reé. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Reé tin tưởng pao Thiên Chùa, caá ní xì hảy tể Ngái giải cừu reé nều Ngái moành reé. Ví reé tà vé là: 'Tôi là Con Thiên Chùa'." <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Mặt khảc, chình mầy xên cưởp, là cảc moón pí toòng tenh côống Ngái, tán phè yý sỉ nhục Ngái.<verse eid="MAT 27:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Caá ní, pở giớ xừ phầu, poòng xồn xuẩt hiến tlêng khồm cả púng cho tềng giớ xừ chìn. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Rối khoảng giớ xừ chìn, Chùa Giê-xu rố mộch xiềng náy, xí ní: "Ê-li, Ê-li, la-ma-sa-bách-tha-ni?" nghỉa là "Thiên Chùa tôi ới, Thiên Chùa tôi ới, rêng nó Ngái lảc tôi?" <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />Mơi khâu khới măng xí, mầy moón tà từng rì vé là: "Reé hôổc Ê-li." <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Ngay caá rì, mộch moón tloong sồ maáng, khâu khới chắn ti mân lế ménh pọt piển, phưa thầm tấy giầm phưa gằn lêng câl lâu, tà tưa cho Ngái oòng. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Mơi cảc moón cón lái pảo: "Hảy tể mặc reé. Tán ha hẩu xứ Ê-li cò tềng cừu reé chăng." <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />Xí rối, khâu khới lái rố lêng mộch xiềng náy, Chùa Giê-xu xẳt thở. <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />Ôộng hẩu rạ, cày mán của tến thớ pí xè mấn han pở tlêng xuồng tìn, cón tẩt pí rung chuyển, mân phú náy pí pể xa. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Nhiếu mố mả vở xa pí vở toang mân nhiếu xảc của cảc moón thành tà tảy àn mấn khôồng lái. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Ôộng caá xa khỏi mả khâu sứ khôồng lái của Ngái, maáng tà pao tloong thánh thành mân xuẩt hiến cho nhiếu moón. <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />Caá ní, khâu khới kỉa tôống tẩt mân cảc việc xảy xa, viên đối tlưởng côống cảc moón tang kenh giử Chùa Giê-xu chung côống ôông tà pí rưởi khiểp quà rối, vé xí ní: "Vé xật, moón ní là Con Chùa Tlới." <verse eid="MAT 27:54" /><verse number="55" style="v" sid="MAT 27:55" />Cón cò nhiếu phú nử tái rì, hẩu chăm chăm pở giang, là cảc moón tà ti xeo Chùa Giê-xu, phục vu ú Ngái pở púng Ga-li-lê. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Tloong sồ maáng cò Ma-ri ma-đơ-len, Ma-ri mế Gia-cơ ôộng Giô-sép, côống mế của cảc con từa Xê-bê-đê.<verse eid="MAT 27:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Caá ní, khới tà tềng khuống xồn, mộch moón chấu tà tềng pở A-ri-ma-thê, xên là Giô-sép, mơi chình ôông yý chíu mấn môn tố xeo Chùa Giê-xu. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Khâu khới tềng tốn Phi-lát, ôông cườn xảc Chùa Giê-xu. Caá rì, Phi-lát xa lếnh tể xảc àn giao cho ôông. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Caá tà lế xảc, Giô-sép quần xảc rì lái tloong pải lanh quang, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />Rối tệch xảc pao cày mả mời của chình mếng mà ôông tà tục tloong hang phú. Khới lăn mộch hón phú náy chấn cửa mả rối, ôông ti vến. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Caá ní, Ma-ri ma-đơ-len ôộng Ma-ri khảc ở rì, ngối đồi diến côống cày mả.<verse eid="MAT 27:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Rối ngáy hôm khâu, nghỉa là khâu ngáy Chuẩn pí, cảc thấy tề lể thướng phẩm mân cảc moón Pha-ri-si tà àn tập tlung lái tlưởc Phi-lát, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />thưa xí ní: "Pẩm quan, tán tôi căắn là caá cón khôồng, xên lứa đảo kia tà vé: 'Khâu pa ngáy, xì tôi àn mấn khôồng lái.' <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Xí rêng, cườn xa lếnh tể cày mả àn pảo đảm an toán cho tềng ngáy xừ pa. Nều chăng, cảc môn tố của reé tềng rối, cò thể lốm xảc reé, ôộng vé côống tán dân: 'Ngái tà àn mấn khôồng lái pở cày chểt,' xì sứ lứa gạt caá khâu sẻ cón xầu hơn caá tấu." <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />Xí rối Phi-lát vé côống maáng: "Cảc ôông cò lình kenh. Ti ti, phải pảo đảm an toán như cảc ôông mẳt." <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Rối khâu khới ti, niêm phoong tảng phú côống lình kenh, maáng pảo đảm cày mả àn an toán.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Caá ní, khâu ngáy Sa-bát, caá pính minh ngáy xừ nhẩt tloong tuấn tang tềng, Ma-ri Ma-đơ-len mân mộch Ma-ri khảc tềng thăm mả. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Hẩu rạ, mộch cơn tôống tẩt náy tà xảy xa, ví mộch thiên sừ của Chùa, khâu khới pở tlới giàng xuồng ôộng tềng khênh, tà lăn tảng phú rối ngối tlêng rì. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Caá rì, hính dung của ví thiên sừ rì xì chôồng như chởp, cón ào của moón rì xì tlằng như tuyểt. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Xí rối, pởi kinh hoảng ví thiên sừ rì, tán lình kenh pí chần tôống mân tlở rêng như moón chểt. <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />Mơi khới vở lới, thiên sừ vé côống cảc moón phú nử: "Cảc ới má rưởi, ví tôi mẳt là cảc ới xím kiềm Giê-xu, Tầng tà pí toòng tenh. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Ngái chăng ở ní nó, ví Ngái àn mấn khôồng lái rối, tùng y như Ngái tà phàn. Tềng ní rạ, hảy hẩu xứ tược mà Ngái tà tảy. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Rối khâu khới mâu choòng lêng khà, hảy kể lái cho cảc môn tố Ngái là: 'Ngái tà àn mấn khôồng lái pở cày chểt. Ôộng hẩu rạ, Ngái tang ti tlưởc ái ùn tềng Ga-li-lê. Ở rì, ái ùn sẻ tốn Ngái.' Hẩu ní, tôi tà vé cho cảc ới mẳt rối rá." <verse eid="MAT 28:7" /><verse number="8" style="v" sid="MAT 28:8" />Pao caá mâu choòng ti khỏi cày mả côống sứ rưởi khiểp mân niếm phui mứng quà, maáng tà chắn ti tể pào cho cảc môn tố Ngái. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Hẩu ní. Chùa Giê-xu tốn maáng, vé: "Cháo cảc ới!" Rối khâu khới tềng khênh, maáng ôm choó Ngái mân thớ láy Ngái. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Khâu rì, Chùa Giê-xu vé côống maáng: "Má rưởi. Hảy ti, pào cho cảc ái ùn của thấy tể maáng cò thể lêng khà tềng Ga-li-lê, mân ở rì, maáng sẻ tốn thấy."<verse eid="MAT 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Caá ní, tang caá maáng ti khà, hẩu rạ, mầy moón tloong tán lình kenh, khâu khới pao tloong thánh, tà kể lái cho cảc thấy tề lể thướng phẩm tẩt cả việc tà xảy xa. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Ôộng caá tà àn tập tlung côống cảc tlưởng lảo, ôộng pẳt tấu pán pạc rối, maáng cho tán lình mộch sồ xiến đàng kể. <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />pảo xí ní: "Hảy vé: 'Khâu khới tềng pao pan têm, cảc môn tố của reé tà lốm xảc reé tloong caá tán tôi tang tảy.' <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Ôộng nều tin ní àn pào cho quan thồng đổc, tán tôi sẻ thuyểt phục ôông rì ôộng mấn cho cảc ái khỏi rẳc rồi. <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Xí rối, khâu khới nhấn xiến, tán rì mấn như tà àn pảo. Tin ní àn đốn xa khồm tược khừa moón Do Thài, tềng nổi cho tềng ngáy nay.<verse eid="MAT 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Caá ní, mưới mộch môn tố tà ti tềng Ga-li-lê, tềng cày nùi mà Chùa Giê-xu tà hường dẩn cho maáng. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Ôộng khới tà tốn Ngái, maáng thớ phướng Ngái, mơi mầy moón nghi ngớ. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Khâu khới tiền tềng khênh, Chùa Giê-xu duyên chuyến côống maáng, xí ní: "Tẩt cả thẩm quyến tlêng tlới mân tìn tẩt tà àn giao cho thấy. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Xí rêng, khới ti, ái ùn hảy môn tố hoà tẩt cả cảc dân, mấn báp-têm cho maáng tloong danh Cha, Con mân Chùa Thành Linh; <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />táy dổ maáng tể vơng giử tẩt cả tiếu mà thấy tà truyến cho ái ùn. Ôộng hẩu ní, thấy ở côống ái ùn tẩt cả cảc ngáy cho tềng tấn thề."<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>