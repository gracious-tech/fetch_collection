  <book code="PHP" style="id">EN_MGLT mtq_Muong_ltr Tue Apr 23 2024 11:06:35 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Philippians</para>
  <para style="toc1">Thư Phi-líp</para>
  <para style="toc2">Phi-líp</para>
  <para style="toc3">Php</para>
  <para style="mt">Phi-líp</para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />Phao-lô ôộng Ti-mô-thê, moón hấu của Chùa Cừu Thề Giê-xu, cởi cho tẩt cả thành tố tloong Chùa Cừu Thề Giê-xu, là cảc môn tố ở tloong thánh Phi-líp, côống cảc giàm mục ôộng chẩp sứ. <verse eid="PHP 1:1" /><verse number="2" style="v" sid="PHP 1:2" />Nguyến ân điển ôộng sứ pính an pở Thiên Chùa, là Cha ôộng Chùa tán ha, là Chùa Cừu Thề Giê-xu, ở tlêng ái ới ùn.<verse eid="PHP 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />Tôi cảm tá Thiên Chùa của tôi tloong tẩt cả kỷ niếm vến ái ới ùn, <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />tloong tẩt cả lới cấu nguyến của mếng cho tẩt cả ái ới ùn, luôn dơng lới cấu nguyến côống loóng phui mứng <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />ví pởi việc dứ phấn của ái ới ùn tloong Tin Lénh pở ngáy tấu cho tềng caá ní; <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />pởi tin chẳc vến chình tiếu ní, là Tầng tà pẳt tấu mấn việc lénh tloong ái ới ùn sẻ mấn tlón vén cho tềng ngáy của Chùa Cừu Thề Giê-xu; <verse eid="PHP 1:6" /><verse number="7" style="v" sid="PHP 1:7" />đồi côống tôi, xật là tiếu chình đàng tể nghỉ như xí vến tẩt cả ái ới ùn, ví tôi giử ái ới ùn tloong loóng mếng, tẩt cả ái ới ùn tếu là cảc pán mấn việc côống tôi pởi ân điển, cả tloong xiếng xỉch của tôi, ôộng tloong việc pêng vực ôộng mấn chừng cho Tin Lénh. <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />Ví Thiên Chùa là Tầng mấn chừng cho tôi, xí nó tôi tha thiểt moong moành tẩt cả ái ới ùn pắng tầm loóng yêu dầu của Chùa Cừu Thề Giê-xu. <verse eid="PHP 1:8" /><verse number="9" style="v" sid="PHP 1:9" />Ôộng tiếu tôi cấu nguyến rì là tính yêu xương của ái ới ùn tuôn tlán tấy, cừ xêm lêng hơn nửa tloong tli thửc côống tẩt cả sứ am hiểu, <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />tể ái ới ùn cò thể xảc đính tiếu nó là tổt nhẩt, tể cho ái ới ùn àn tinh khiểt ôộng chăng thể chê tlẻch cho tềng ngáy của Chùa Cừu Thề, <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />àn tấy dẩy pôông tlày của côông chình pởi Chùa Cừu Thề Giê-xu, hường tềng sứ vinh hiển ôộng sứ khen ngới Thiên Chùa.<verse eid="PHP 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />Thưa ái ới ùn, tôi moành ái ới ùn hay là cảc tiếu xảy tềng côống tôi xật xứ tà diển xa ví việc phảt tliển của Tin Lénh. <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" />Tềng nổi, voóng xiếng xỉch của tôi tloong Chùa Cừu Thề tà tlở rêng rỏ ráng ở khừa tẩt cả lình kenh dinh thồng đổc ôộng tẩt cả moón khảc. <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />ôộng rẩt nhiếu ái ới ùn, pởi voóng xiếng xỉch của tôi, tà vửng tin ở Chùa, cáng quyểt tâm tể rao giảng đáo Chùa mà chăng măng rưởi. <verse eid="PHP 1:14" /><verse number="15" style="v" sid="PHP 1:15" />Dú ngay cả mộch xồ moón rao giảng Chùa Cừu Thề ví ganh tí ôộng tlenh cải, mơi yý cò moón rao giảng côống ỳ tổt, <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />là cảc moón ví tính yêu xương, mẳt là tôi àn chỉ đính tể pảo vế Tin Lénh, <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />mơi cảc moón pởi ham moành ỉch kỉ, maáng rao giảng Chùa Cừu Thề kiểu chăng chân xật, tưởng tăng xêm khồn khổ pao voóng xiếng xỉch của tôi. <verse eid="PHP 1:17" /><verse number="18" style="v" sid="PHP 1:18" />Xí xì rêng nó? cho dú là pởi cảch nó – hoặc là giả tó hay là ngay xật – xì Chùa Cừu Thề àn rao giảng, ôộng tôi phui mứng vến tiếu rì. Mặt khảc, tôi yý sẻ àn mấn cho phui mứng, <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />ví tôi mẳt là tiếu ní sẻ tom sứ giải cừu tềng cho tôi, pởi sứ cấu nguyến của ái ới ùn ôộng sứ giủp đở pở Thành Linh của Chùa Cừu Thề Giê-xu, <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />xeo như việc hào hửc moong tới ôộng niếm hy voóng của tôi, ní là tôi sẻ chăng pí mấn cho xầu hổ tloong pẩt ký chuyến chi, mơi ca đảm tloong tẩt cả cảc việc, tể caá ní yý như pẩt ký caá nó, Chùa Cừu Thề sẻ àn tôn cao ở pỏc mếng tôi, chăng kể khôồng hay chểt. <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />Ví đồi côống tôi, khôồng là Chùa Cừu Thề, ôộng chểt là tiếu ỉch lới. <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />Mơi nều cón khôồng tloong xảc xịt, xì đồi côống tôi, ní là tiếu ỉch lới cho công tảc, xì tôi chăng mẳt mếng sẻ lứa chón táng nó. <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />Tôi pí ẻp khừa han táng, khới cò moong moành tể xa ti ôộng ở côống Chùa Cừu Thề, ví rị là tiếu tổt hơn rẩt nhiếu, <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />mơi cừ ở lái tloong xảc xịt là tiếu cấn hơn cho ái ới ùn. <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />Khới tà tin chẳc chằn tiếu rì, tôi mẳt là mếng sẻ ở lái ôộng cón ở tiểp tục côống tẩt cả ái ới ùn, ví việc tăng tlưởng ôộng niếm phui tloong đửc tin của ái ới ùn, <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />tể sứ hảnh diến của ái ới ùn tloong Chùa Cừu Thề Giê-xu vến tôi sẻ dơng tlán qua việc tôi tềng tốn ái ới ùn lấn nửa. <verse eid="PHP 1:26" /><verse number="27" style="v" sid="PHP 1:27" />Chỉ cò tiếu ái ới ùn phải khôồng xật xừng đàng côống Tin Lénh của Chùa Cừu Thề, tể dú khới tôi tềng ôộng xem xẻt ái ới ùn hay khới chăng cò mặt, xì tôi cò thể măng vến ái ới ùn là ái ới ùn từng vửng tloong mộch thấn linh, côống mộch tâm tlì mà chiền đầu ví đửc tin của Tin Lénh, <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />ôộng chăng pí cảc moón chôồng đồi mấn cho khiểp rưởi tloong pẩt ký tiếu chi. Ní là dầu hiếu vến sứ huỷ diệt tể cho maáng, mơi là dầu hiếu vến sứ cừu rổi của ái ới ùn – ôộng tiếu ní pở Thiên Chùa. <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />Ví pởi Chùa Cừu Thề, ơn phưởc tà àn pan cho ái ới ùn chăng chỉ tể tin pao Ngái, mơi yý tể chíu khổ ví Ngái, <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" />khới cò côống sứ chiền đầu mà ái ới ùn tà kỉa ở tôi, ôộng caá ní tang măng ở tôi.<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />Xí rêng, nều tloong Chùa Cừu Thề cò sứ khuyền khỉch nó, nều cò sứ yên ủi nó pởi tính yêu xương, nều cò mồi thôông côông nó tloong Thành Linh, nều cò loóng yêu mền ôộng sứ xương xỏt nó, <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />xì hảy mấn cho tlón vén niếm phui của tôi, rì là ái ới ùn cò chung tâm tlì, khới cò chung tính yêu xương, hiệp mộch tloong tâm hốn, suy nghỉ vến mộch hường. <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />Chăng mấn việc chi pởi loóng ỉch kỷ hay ví hư vinh, ngược lái, côống loóng khiêm nhướng, hẩu moón khảc tôn tlóng hơn mếng, <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />mổi moón chăng chỉ quan tâm tềng quyến lới riêng của mếng, mơi cón quyến lới của cảc moón khảc nửa. <verse eid="PHP 2:4" /><verse number="5" style="v" sid="PHP 2:5" />Hảy cò tâm tlì như xí tloong ái ới ùn, yý là tâm tlì tloong Chùa Cừu Thề Giê-xu,<verse eid="PHP 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PHP 2:6" />là Tầng hiến diến tloong hính dàng Thiên Chùa,</para>
  <para style="q1" vid="PHP 2:6">tà chăng hẩu tiếu cấn phải giử lế</para>
  <para style="q1" vid="PHP 2:6">là sứ pính đẳng côống Thiên Chùa.<verse eid="PHP 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PHP 2:7" />Thay pao rì,</para>
  <para style="q1" vid="PHP 2:7">Ngái tà tứ mấn cho mếng xa rỏ</para>
  <para style="q1" vid="PHP 2:7">khới mặc lế hính dàng moón hấu,</para>
  <para style="q1" vid="PHP 2:7">àn tẻ xa tloong hính ẻnh chôồng như loái moón,</para>
  <para style="q1" vid="PHP 2:7">ôộng àn hẩu kỉa tloong hính dàng như mộch con moón,<verse eid="PHP 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PHP 2:8" />Ngái tà tứ há mếng xuồng</para>
  <para style="q1" vid="PHP 2:8">khới chíu vơng phục cho tềng chểt,</para>
  <para style="q1" vid="PHP 2:8">tèng nổi chểt tlêng câl thập tứ.<verse eid="PHP 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PHP 2:9" />Pởi xí, Thiên Chùa yý tà tôn Ngái lêng rẩt cao</para>
  <para style="q1" vid="PHP 2:9">ôộng tà pan cho Ngái danh tlêng muôn danh,<verse eid="PHP 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PHP 2:10" />tể cho măng tềng danh Chùa Giê-xu,</para>
  <para style="q1" vid="PHP 2:10">tẩt cả cổ cồn tlêng tlới,</para>
  <para style="q1" vid="PHP 2:10">tìn tẩt, khà tìn tẩt, phải quý xuồng,<verse eid="PHP 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PHP 2:11" />ôộng tẩt cả lài tếu côông nhấn là</para>
  <para style="q1" vid="PHP 2:11">Chùa Cừu Thề Giê-xu là Chùa,</para>
  <para style="q1" vid="PHP 2:11">quy vinh quang xuộc Thiên Chùa là Cha.<verse eid="PHP 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />Xí rêng, cảc moón yêu dầu của tôi ời, xeo như cảch ái ới ùn tà luôn vơng lới, khới chăng chỉ ở tloong sứ hiến diến của tôi, mà caá ní cáng nhiếu hơn tloong việc chăng cò mặt của tôi, ái ới ùn cừ thực hánh ơn cừu rổi của mếng côống sứ kình rưởi ôộng run rẩy. <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />Ví Thiên Chùa là Tầng tang mấn việc tloong ái ới ùn tể phưa moành phưa mấn xeo ỳ tổt của Ngái. <verse eid="PHP 2:13" /><verse number="14" style="v" sid="PHP 2:14" />Hảy mấn tô việc mà chăng phán nán hay cải phố, <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />tể ái ới ùn àn tlở rêng cảc enh con chăng thể chê tlẻch ôộng tinh khiểt của Thiên Chùa, chăng tồ pẩn ở khừa mộch thề hế hư hoái ôộng sa đóa, mà ở rì ái ới ùn chiều tlàng như cảc ngón tén tloong thề gian, <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />khới giử vửng lới sứ khôồng, ví sứ hảnh diến của tôi tloong ngáy của Chùa Cừu Thề rì là mếng tà chăng chắn tloong vô ỉch, yý chăng lao nhoọc xật vô ỉch. <verse eid="PHP 2:16" /><verse number="17" style="v" sid="PHP 2:17" />Mơi ngay cả cho dú tôi pí tổ mầu xa tể xười tlêng vật hiền tề ôộng lể vật của đửc tin ái ới ùn, xì tôi vẩn hân hoan, ôộng chung phui côống tẩt cả ái ới ùn. <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />Ái ới ùn yý như xí, hảy hân hoan ôộng chung phui côống tôi.<verse eid="PHP 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />Tloong Chùa, là Chùa Giê-xu, tôi hy voóng khờm cởi Ti-mô-thê tềng thăm ái ới ùn, tể tôi yý àn phần khởi khới hay tin tửc vến ái ới ùn. <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />Ví tôi chăng cò ôông ay khảc côống tâm tính chôồng ái rì, là moón xật loóng lo nghỉ cảc lới ỉch đồi côống ái ới ùn, <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />ví cảc moón khảc tếu xím kiềm cảc ỉch lới riêng, chăng phải cảc tiếu xuộc vến Chùa Cừu Thề Giê-xu. <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />Mơi ái ới ùn hay phẩm hánh của ái rì, ví chôồng như con ôộng pồ, ái rì tà phục vú cho Tin Lénh côống tôi. <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />Cho rêng tôi hy voóng khai phài ái rì ngay khới tôi hay tính hính của mếng sẻ xí nó. <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />Mơi tôi tin chẳc ở Chùa là chình tôi yý sẻ khờm tềng thăm ái ới ùn. <verse eid="PHP 2:24" /><verse number="25" style="v" sid="PHP 2:25" />Caá ní, tôi nghỉ cấn phải cởi Ép-ba-phô-đích vến lái cho ái ới ùn, nọ là moón ái ùn ôộng pán côống mấn việc yý là pán chiền đầu của tôi, là sừ giả pở ái ới ùn ôộng là moón phục vú cho nhu cấu của tôi, <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />ví nhấn xa là ái hểt khửc moong moành àn ở côống tẩt cả ái ới ùn, ôộng kỉa pồi rồi ví ái ới ùn tà măng là ái rì pí pếng. <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />Ví tùng là ái rì tà pí pếng khênh chểt. Mơi Thiên Chùa tà xương xỏt ái rì, mà chăng chỉ ái rì nó, mơi cón tôi nửa, tể tôi khỏi chíu puốn rấu cáng xêm puốn rấu. <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />Cho rêng, tôi sổt roạch khai ái rì ti, tể khới tốn lái ái rì, ái ới ùn cò thể phui mứng, ôộng tôi yý àn pởt puốn rấu. <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />Pởi xí, hảy tiểp tòn ái rì tloong Chùa pắng tẩt cả phui mứng, ôộng hảy cò loóng tôn tlóng cảc moón như xí, <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />pởi ví côông việc của Chùa Cừu Thề mà ái rì tềng nổi khênh chểt, khới liếu maáng khôồng mếng tể cò thể mấn hoán thánh phấn cón xiều tloong sứ phục vú của ái ới ùn cho tôi.<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />Cuồi cúng, thưa ái ới ùn của tôi, hảy phui mứng tloong Chùa. Đồi côống tôi, chăng phiến há chi khới viểt lái côống cảc tiếu ní cho ái ới ùn, ví là sứ an toán dánh cho ái ới ùn. <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />Hảy cẩn thấn tán chò, hảy cẩn thấn cảc moón mấn côông gian ảc, hảy cẩn thấn phẻp xẻo ta giả. <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />Ví tán ha àn phẻp cảch ta xật – nghỉa là cảc moón thớ phướng pắng Thành Linh của Thiên Chùa, hảnh diến tloong Chùa Cừu Thề Giê-xu, ôộng chăng tin tưởng pao xảc xịt, <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />Mặc dú tôi yý cò lỳ do tin tưởng ở xảc xịt. Nều ôông ay khảc nghỉ cò lỳ do tể tin tưởng pao xảc xịt, xì tôi cón cò nhiếu hơn: <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" />Tôi chíu phẻp cảch ta pao ngáy xừ xàm, xuộc dân tộc Y-sơ-ra-ên, chi phài Bên-gia-min, moón Hê-bơ-rơ, con của moón Hê-bơ-rơ; vến luật phảp, là moón Pha-ri-si; <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" />vến loóng nhiệt thánh, xì ngược đải hối thành; vến sứ côông chình xeo luật phảp xì àn cho là chăng tược chê tlẻch. <verse eid="PHP 3:6" /><verse number="7" style="v" sid="PHP 3:7" />Mơi,pẩt cừ tiếu chi là lới ỉch đồi côống tôi, xì ví pởi Chùa Cừu Thề, tôi tà hẩu cảc xừ rì là lổ. <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />Mơi cón hơn xí nửa, tôi tềng nổi hẩu tẩt cả tếu là lổ ví pởi già tlí cao hơn hểt của việc hay mẳt vến Chùa Cừu Thề Giê-xu, Chùa của tôi, ví Ngái mà tôi tà chíu vẩt tẩt cả - xật, tôi hẩu cảc xừ rì như giảc - tể cho tôi àn Chùa Cừu Thề <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />ôộng àn xím kỉa tloong Ngái, chăng phải ví cò sứ côông chình ở pản xân mếng pở luật phảp mơi là sứ côông chình pởi đửc tin ở Chùa Cừu Thề – nghỉa là sứ côông chình tềng pở Thiên Chùa tlêng căn pản đửc tin – <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />tể mẳt Ngái ôộng quyến năng sứ khôồng lái của Ngái côống sứ thông côông tloong cảc khổ nán của Ngái, khới àn tom tềng tược chôồng như Ngái côống cày chểt của Ngái, <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />dú pắng phương phảp nó, xì tôi cò thể đạt tềng sứ khôồng lái pở cày chểt. <verse eid="PHP 3:11" /><verse number="12" style="v" sid="PHP 3:12" />Rì chăng phải là tôi tà àn giải rối, hay tà àn hoán hảo rối, mơi tôi tang xeo tuổi xí nó cho mếng cò thể nhấn lế giải mà ví pởi rì, tôi yý tà àn Chùa Cừu Thề Giê-xu nhấn lế. <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />Thưa ái ới ùn, tôi chăng cho là pản xân mếng tà nhấn àn. Mơi tôi cừ mấn mộch tiếu: khới phêng ti cảc cày chi khà khâu mà vươn tềng cảc tiếu khà tlưởc, <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />hường tềng mục tiêu, tôi tang xeo tuổi cho àn giải thưởng vến việc hôổc ở tlêng tlới của Thiên Chùa tloong Chùa Cừu Thề Giê-xu. <verse eid="PHP 3:14" /><verse number="15" style="v" sid="PHP 3:15" />Xí rêng, tẩt cả ôông ay tlưởng thánh tếu phải suy nghỉ như xí, cón nều như cò điểm nó ái ới ùn nghỉ cảch khảc piệt, Thiên Chùa yý sẻ páy tỏ tiếu rì cho ái ới ùn. <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />Xí mơi, tán ha tà đạt tềng cớ nó xì rêng pưởc ti xeo cớ rì.<verse eid="PHP 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />Thưa ái ới ùn, hảy tlở rêng cảc moón pẳt tlưởc tôi, ôộng hảy chăm chù hẩu cảc moón tang khôồng tloong mẩu mực rì, xeo như gương mẩu ái ới ùn kỉa ở tán tôi. <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />Ví cò nhiếu moón - là cảc moón mà tôi tà hay vé côống ái ới ùn, mơi caá ní tềng nổi tôi phải nhám mà vé - maáng tang khôồng như moón thú nghịch thập tứ già của Chùa Cừu Thề, <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />kểt cục của tán moón rì là diệt voong, chùa của maáng là cày tlống, ôộng vinh quang của maáng ở tloong việc mấn đàng xầu hổ của maáng, nghỉa là cảc moón chỉ nghỉ tềng cảc việc ở tìn tẩt. <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />Mơi ví quyến côông dân của tán ha khẳn cò tlêng tlới, mà pở tược rì tán ha hào hửc tới Tầng Giải Cừu, là Chùa, nghỉa là Cừu Thề Giê-xu, <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />là Tầng sẻ piền hòa poỏc mếng thẩp hén của tán ha tlở rêng chôồng như poỏc mếng vinh quang của Ngái, xeo như sứ vấn hánh năng quyến Ngái tể pẳt phục muôn vật cho mếng.<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />Xí xì, thưa ái ới ùn yêu quỳ ôộng mong mỏi của tôi, niếm phui ôộng vương miến của tôi, ái ới ùn yêu quỳ ới, hảy cừ từng vửng như xí tloong Chùa.<verse eid="PHP 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />Tôi nái khuyên Ê-vô-đi ôộng nái khuyên Sin-ty-cơ cò côống tâm tlì tloong Chùa. <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />Chẳc chằn là, tôi yý cườn ái, moón côống mấn việc chân xật ới, ái hảy giủp đở cảc vaá rì, maáng tà côống tôi chiền đầu cho Tin Lénh, côống Cơ-lê-măn ôộng cảc pán côống mấn việc khảc của tôi, mà xên của maáng ở tloong Sảch Sứ Khôồng.<verse eid="PHP 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4" />Hảy cừ luôn phui mứng tloong Chùa. Tôi sẻ vé nửa, hảy phui mứng lêng. <verse eid="PHP 4:4" /><verse number="5" style="v" sid="PHP 4:5" />Hảy tể tẩt cả cảc moón hay tình nểt hiến hóa của ái ới ùn. Chùa tà khênh rối. <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />Má lo lằng chi cả, thay pao rì, tloong tẩt cả cảc việc, pắng sứ cấu nguyến ôộng nái cườn côống sứ tá ơn, hảy dơng tlính cảc tiếu mếng cấu khẩn lêng Thiên Chùa, <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />ôộng sứ pính an của Thiên Chùa, là tiếu vượt quà tẩt cả tli thửc, sẻ giử gín loóng ái ới ùn ôộng tâm tlì ái ới ùn tloong Chùa Cừu Thề Giê-xu.<verse eid="PHP 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8" />Cuồi cúng, thưa ái ới ùn, nều tiếu chi là chân xật, nều tiêu chi đàng tôn quỳ, nều tiếu chi côông chình, nều tiếu chi thanh quang, nều tiếu chi đàng yêu, nều tiếu chi cò xiềng tổt, nều cò tiếu nó đáo đửc tổt ôộng nều cò tiếu nó đàng khen, xì ái ới ùn phải nghỉ tềng phè. <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />Cảc cày chi ái ới ùn tà hoọc àn, tà tiểp thu, tà măng ôộng tà kỉa ở tôi, xì hảy mấn xeo cảc tiếu rì, rối Thiên Chùa pính an sẻ ở côống ái ới ùn.<verse eid="PHP 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />Tôi rẩt phui mứng tloong Chùa ví caá cuồi cúng ái ới ùn lái quan tâm tềng tôi, xật xa, tloong chuyến ní, ái ới ùn xật xa tà quan tâm tềng tôi, mơi chăng cò cơ hối páy tỏ. <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />Rì chăng phải là tôi vé vến nhu cấu mếng, ví tôi tà hoọc phải thỏa loóng dú tôi ở tloong hoán kẻnh nó. <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />Tôi phưa mẳt pí nghéo nán, phưa mẳt cò dư dả. Tloong mổi piền cồ ôộng tloong tẩt cả hoán kẻnh, tôi tà hoọc cả caá àn ro ôộng khới chíu tòi, cả caá cò dư dả ôộng khới pí tùng xiều. <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />Tôi tủ khửc đồi diến tẩt cả pởi Tầng mấn cho tôi nôống khửc. <verse eid="PHP 4:13" /><verse number="14" style="v" sid="PHP 4:14" />Mơi, ái ới ùn tà mấn tổt khới tà côống chia sẻ khò khăn của tôi. <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />Thưa ái ới ùn thánh Phi-líp, ái ới ùn yý hay là tloong puổi tấu của Tin Lénh, khới tôi ti khỏi Ma-xê-đoan, chăng cò hối thành nó chia sẻ côống tôi tloong việc thu chi, tlứ xa mộch mếng ái ới ùn, <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" />ví ngay ở Tê-sa-lô-ni-ca, ái ới ùn tà mộch han lấn cởi tố cấn dúng cho tôi. <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />Rì chăng phải là tôi moong xím cày nom, mơi tôi moong xím kểt tlày xêm lêng dư dả pao phấn ỉch lới của ái ới ùn. <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />Tôi tang cò tủ tô xừ ôộng dư dả nửa. Tôi tà àn tấy tủ, khới nhấn ở Ép-ba-phô-đích cày nom tềng pở ái ới ùn, là hương xơm, là vật hiền tề àn chẩp nhấn, là tiếu phưa loóng Thiên Chùa. <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />Thiên Chùa của tôi sẻ cung cẩp tấy tủ tẩt cả nhu cấu của ái ới ùn xeo sứ chấu cò của Ngái tloong sứ vinh hiển ở Chùa Cừu Thề Giê-xu. <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />Nguyến vinh quang xuộc vến Thiên Chùa, Cha tán ha, cho tềng tới tới vỉnh cửu. Amen.<verse eid="PHP 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />Cườn poi thăm tẩt cả thành tố tloong Chùa Cừu Thề Giê-xu. Cảc ái ùn ở côống tôi poi thăm ái ới ùn. <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />Tẩt cả thành tố poi thăm ái ới ùn, mà đặc piệt là cảc moón xuộc nhá Xê-xa.<verse eid="PHP 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23" />Nguyến ân điển của Chùa, là Chùa Cừu Thề Giê-xu ở côống tâm linh ái ới ùn. A-men.<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>