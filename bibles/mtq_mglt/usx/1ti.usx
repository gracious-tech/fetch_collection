  <book code="1TI" style="id">EN_MGLT mtq_Muong_ltr Tue Apr 23 2024 11:03:45 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">1 Timothy</para>
  <para style="toc1">Thư Ti-mô-thê thứ nhất</para>
  <para style="toc2">1 Ti-mô-thê</para>
  <para style="toc3">1Ti</para>
  <para style="mt">1 Ti-mô-thê</para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />Phao-lô, sừ tố của Chùa Cừu Thề Giê-xu xeo mếnh lếnh của Thiên Chùa, Cừu Chùa tán ha, ôộng của Chùa, là Chùa Cừu Thề Giê-xu, niếm hy voóng của tán ha, <verse eid="1TI 1:1" /><verse number="2" style="v" sid="1TI 1:2" />cởi cho Ti-mô-thê, con xật của ho tloong đửc tin: Nguyến con àn ân điển, sứ xương xỏt, pính an pở Thiên Chùa, là Cha ôộng Chùa Cừu Thề Giê-xu, Chùa tán ha.<verse eid="1TI 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />Như caá lêng khà tềng Ma-xê-đoan, ho tà thủc giục con ở lái tloong Ê-phê-sô tể con cò thể răn pảo mầy moón rì chăng táy giào lỳ khảc, <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />yý má tể ỳ tềng mầy chuyến hoang đướng ôộng cảc pảng gia phả dán doóng, là cảc xừ tom tềng sứ cải phố, hơn là công tảc quản lỳ nhá Chùa Tlới, là công tảc pởi đửc tin. <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />Mơi mục tiêu của mếnh lếnh ní là tính yêu tềng pở loóng thanh quang ôộng lương tâm tổt côống đửc tin chăng giả táo, <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />mà mộch xồ moón, ví phảng mục tiêu, tà lảc ti tể hường tềng việc pán luấn ngu dổt. <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />moành mấn thấy táy luật, khới chăng hiểu chăng chỉ cảc lới mếng khề mơi cón vến cảc tiếu mếng chẳc chằn. <verse eid="1TI 1:7" /><verse number="8" style="v" sid="1TI 1:8" />Mơi, tán ha mẳt là luật phảp là tổt lénh nều maáng sử dúng reé xật chình đàng, <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />ví mẳt tiếu ní, rì là luật phảp chăng àn tệch xa cho moón côông chình, mơi cho moón phám phảp ôộng chồng nghịch, moón pẩt kình ôộng xối lổi, moón vô đáo ôộng pàng pổ, xên giểt pồ ôộng giểt mế, xên giểt moón, <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />moón gian dâm, moón đống tình luyền ài, moón pẳt coỏc puôn paành con moón, moón khề lẻo, moón mấn chừng lẻo, ôộng pẩt ký moón nó khảc chồng đồi côống sứ táy pảo chân xật, <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />tùng xeo Tin Lénh vinh hiển của Thiên Chùa phưởc hánh, là tiếu mà ho tà àn giao phò.<verse eid="1TI 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />Ho cảm tá Tầng pan năng lực cho ho, nghỉa là Chùa Cừu Thề Giê-xu, Chùa tán ha, ví Ngái tà xẻt ho là đàng tin, khới tệch ho pao chửc vuú, <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" />dú tlưởc rì ho là moón phám thướng, ngược đải ôộng hung dử, mơi ho tà àn xương xỏt ví tloong caá chăng hiểu àn, ho tà mấn xa tloong sứ chăng tin. <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />Mơi ân điển của Chùa tán ha là tuôn tlán dư dả côống đửc tin mân tính yêu xương tloong Chùa Cừu Thề Giê-xu. <verse eid="1TI 1:14" /><verse number="15" style="v" sid="1TI 1:15" />Sừ điệp ní là đàng tin ôộng đàng tòn nhấn hoán toán, rì là: "Chùa Cừu Thề Giê-xu tà tềng tloong thề gian tể cừu moón cò xối" – mà tloong rì ho là moón từng tấu. <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />Mơi, ho tà àn xương xỏt ví lỳ do ní, rì là tể Chùa Cừu thề Giê-xu cò thể chừng tỏ tẩt cả loóng nhẩn nhục tloong ho, moón xối lổi háng tấu, như mộch gương mẩu cho cảc moón sẻ tin pao Ngái tể àn sứ khôồng tới tới. <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />Nguyến sứ tôn quỳ ôộng vinh hiên xuộc vến Vua của muôn thới đái, là Thiên Chùa duy nhẩt pẩt diệt, vô hính, cho tềng tới tới mải mải. A-men.<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />Ti-mô-thê, con ho, ho giao phò mếnh lếnh ní cho con, xeo cảc lới tiên tli tlưởc ní vến con, tể pởi phè, con cò thể xông pha tloong cuộc chiền cao quỳ, <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />khới cấm giử đửc tin ôộng lương tâm tổt, mà mộch xồ moón, ví tứ chồi, tà mấn chím vẩt đửc tin mếng, <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />tloong sồ rì là Hy-mê-nê ôộng A-léc-xan-đơ, là cảc moón mà ho tà giao cho Sa-tan tể cho maáng cò thể àn táy pảo tể chăng phám thướng.<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />Xí rêng, tlưởc hểt, ho thủc giục cảc lới nái cườn, cấu nguyến, cấu thay, tá ơn cấn àn dơng lêng cho tô moón, <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />cho cảc vua ôộng tẩt cả ôông ay tang ở tloong tược quyến lực, tể tán ha cò thể khôồng cuộc tới pính an ôộng yên ổn côống tô sứ tin kình mân phẩm hánh. <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />Rì là tiếu tổt lénh ôộng chình đàng tlưởc mặt Thiên Chùa, Cừu Chùa tán ha, <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />là Tầng moành tô moón àn cừu ôộng ti tềng việc hay mẳt chân lỳ. <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />Ví chỉ cò mộch Chùa Tlới ôộng mộch Tầng tlung gian khừa Thiên Chùa ôộng loái moón — rì là Chùa Cừu Thề Giê-xu, mộch con moón, <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />Tầng tà phò chình mếng mấn già chuộc cho tô moón, như lới mấn chừng pao tùng thới điểm, <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" />pởi lới mấn chừng rì mà ho tà àn chón mấn moón giảng đáo ôộng sừ tố – ho vé xật tloong Chùa Cừu Thề, ho chăng khề lẻo – nghỉa là mấn giào sư cho cảc moón ngoái quổc vến đửc tin ôộng chân lỳ.<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />Pởi xí, ho moành tán ôông khồm tược phải cấu nguyến, tưa xay tinh khiểt lêng chăng kém xeo sứ giấn dử hay cải phố. <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" />chôồng như xí, cảc ới ùn phú nử phải mấn oai chình mếng tloong trang phục phú hợp côống loóng khiêm tồn ôộng tứ chủ, chăng phải pắng việc pùi xẳc côống váng hay ngoọc, hoặc quấn ào tẳt xiến, <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />mơi pắng tiếu phú hợp côống moón phú nử tuyên xưng loóng kình rưởi Chùa Tlới qua cảc việc lénh. <verse eid="1TI 2:10" /><verse number="11" style="v" sid="1TI 2:11" />Phú nử phải hoọc hỏi tloong yên lắng, tloong sứ vơng phục hoán toán. <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />Mặt khảc, ho chăng cho phẻp phú nử táy dổ hay cấm quyến tlêng tán ôông, mơi phải yên lắng. <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />Ví A-đam tà àn táo xa tlưởc, rối mời tềng Ê-va, <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />ôộng A-đam chăng pí lứa gạt, mơi moón nử, khới hoán toán pí dú dổ, tà ti tềng tược phám xối. <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />Mơi, moón nử sẻ àn cừu qua việc teẻ con, nều như maáng cừ ở tloong đửc tin, tính yêu xương ôộng sứ thành khiểt, côống tâm tlì lénh mánh.<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />Lới ní là đàng tin tưởng: "Nều ay rị moành mấn moón giàm mục, xì moón rì ưởc moành mộch việc cao quỳ." <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" />Xí rêng, moón giàm mục phải là moón chăng chê tlẻch àn, chầu của mộch du, cẩn tlóng, tứ chủ, nế nểp, hiều khẻch, cò khả năng táy dổ, <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />chăng nghiến ráo, chăng hay gây gổ, mơi phải hiến lénh, hóa nhả, chăng tham xiến, <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />quản lỳ tổt nhá mếng, cò con cài vơng phục côống tẩt cả loóng kình tlóng <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />(ví nều mộch moón chăng mẳt cảch quản lỳ nhá mếng, xì moón rì sẻ chăm nom Hối Thánh của Thiên Chùa như xí nó?), <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />chăng thể là moón mời tin, tể chăng ví pởi lêng mếng kiêu ngáo mà moón rì sa pao hính phạt như ma quỷ. <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />Ngược lái, moón giàm mục yý phải cò xiềng tổt pở moón vái Hối Thành, tể moón rì khỏi sa pao sứ sỉ nhục mân cày pẩy của ma quỷ. <verse eid="1TI 3:7" /><verse number="8" style="v" sid="1TI 3:8" />Chôồng như xí, cảc chẩp sứ phải nghiêm tlang, chăng vé han lới, chăng lám dúng ráo, chăng tham lam, <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />giử gín sứ mấu nhiếm của đửc tin pắng lương tâm thanh quang. <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />Mặt khảc, maáng yý phải àn thử luyến tlưởc, rối khâu rì hảy tể maáng phục vuú khới chăng pí chê tlẻch. <verse eid="1TI 3:10" /><verse number="11" style="v" sid="1TI 3:11" />Cảc moón mấn du yý xí, phải nghiêm tlang, chăng khề xầu, tiểt chề, tlung tìn tloong tẩt cả cảc việc. <verse eid="1TI 3:11" /><verse number="12" style="v" sid="1TI 3:12" />Cảc chẩp sứ phải là chầu của mộch du, quản lỳ tổt con cài ôộng cả nhá mếng. <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />Ví cảc moón phục vuú ngay lénh tom vến cho mếng đía ví tổt lénh ôộng nhiếu sứ mánh dán tloong đửc tin tloong Chùa Cừu Thề Giê-xu.<verse eid="1TI 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />Ho viểt mầy lới ní cho con, moong tềng thăm con xật khờm, <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />mơi nều ho lô tềng, xì con cò thể mẳt phải cư xử xí nó tloong nhá của Thiên Chùa, mà rì là Hối Thành của Thiên Chùa khôồng vỉnh cửu, tlú ôộng cột chồng đở của chân lỳ. <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />Mấu nhiếm vế sứ tin kình xật là vỉ đái chăng thể chồi cải, là:</para>
  <para style="q2" vid="1TI 3:16">“Tầng àn tỏ xa tloong xảc xịt,</para>
  <para style="q2" vid="1TI 3:16">àn kể là côông chình tloong Thành Linh,</para>
  <para style="q2" vid="1TI 3:16">àn hẩu kỉa pởi thiên sừ,</para>
  <para style="q2" vid="1TI 3:16">àn rao giảng khừa cảc dân,</para>
  <para style="q2" vid="1TI 3:16">àn tin tưởng tlêng thề giời</para>
  <para style="q2" vid="1TI 3:16">àn tom lêng tloong vinh hiển.”<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />Thành Linh phàn rỏ ráng là tloong thới ký khâu ní, nhiếu moón sẻ lảc đửc tin, ti xeo cảc linh lứa gạt ôộng đáo lỳ của ma quỷ, <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />pởi sứ đáo đửc giả của tán giả dồi, lương tâm của tán rì tà pí chai lí, <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />khới cầm đoàn cười gả, tói kiêng cảc tố ăn mà Thiên Chùa mấn rêng tể hưởng lế côống loóng tá ơn pởi moón tin tưởng ôộng hiểu àn chân lỳ. <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />Ví tẩt cả táo vật của Thiên Chùa là tổt lénh, ôộng chăng cò vật chi đàng lảc nều àn nhấn lế côống loóng tá ơn, <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />ví tố ăn àn thành hòa pởi lời Thiên Chùa ôộng lới cấu nguyến.<verse eid="1TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />Khới tệch cảc tiếu rì tlưởc mặt ái ới ùn, con sẻ là moón hấu việc tổt lénh của Chùa Cừu Thề Giê-xu, àn ruôi dưởng pởi lới của đửc tin ôộng giào huần tổt lénh mà con tà vơng xeo. <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />Mơi hảy tứ chồi cảc chuyến hảo huyến trấn tục của mầy mú rá. Thay pao rì, hảy rén luyến chình mếng cho sứ tin kình. <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />pởi "sứ rén luyến pỏc mếng xì ỉch lới tloong thới gian pằn, mơi rén luyến loóng tin kình xì ỉch lới cho tô việc, ví cò lời hừa cho tới ní ôộng tới khâu." <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />Lới rì là đàng tin tưởng ôộng đàng tòn nhấn hoán toán, <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />pởi tán ha lao nhoọc mân chiền đầu cho tiếu ní, ví tán ha tệch hy voóng pao Thiên Chùa khôồng muôn tới, Ngái là Cừu Chùa của tẩt cả cảc moón, nhẩt là của moón tin. <verse eid="1TI 4:10" /><verse number="11" style="v" sid="1TI 4:11" />Hảy răn pảo ôộng táy cảc tiếu rì. <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />Má tể ôông ay khinh thướng xuổi chẻ của con, mơi hảy tlở rêng gương mẩu cho cảc môn tố, tloong lới khề, tloong cảch cư xử, tloong tính yêu xương, tloong đửc tin, ôộng tloong sứ tinh quang. <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />Hảy chù tâm pao việc toọc sảch, khuyên răn, táy pảo cho tềng khới ho tềng. <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />Má phêng ti ơn ở tloong con, là ơn tà àn pan cho con qua lới tiên tli, cống việc tệch xay của cảc tlưởng lảo. <verse eid="1TI 4:14" /><verse number="15" style="v" sid="1TI 4:15" />Hảy rén luyến cảc việc rì, hảy chuyên tâm pao phè, tể sứ tiến pố của con tlở rêng rỏ ráng đồi côống maáng. <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />Hảy cẩn thấn chù ỳ chình mếng con ôộng sứ táy pảo. Hảy kiên tlí tloong cảc việc rì, ví mấn xí con sẻ cừu cả pản xân mếng ôộng cảc moón măng con.<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />Má tlẻch vằng côống tán ôông náy xuổi, mơi hảy khuyên nhủ moón rì như pồ, thanh niên xì như ái ùn, <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />cảc mú náy xuổi xì như mế, cảc xiều nử xì như ới ùn, tloong sứ thanh quang hoán toán. <verse eid="1TI 5:2" /><verse number="3" style="v" sid="1TI 5:3" />Hảy tôn tloóng cảc mú gòa – cảc mú gòa xật sứ. <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />Mơi nều mú goà nó cò con hay xôn, xì tlưởc tiên xôn con maáng phải hoọc tể tôn tlóng moón nhá của mếng, ôộng tỏ loóng pào đảp cho pậc ôông mú pồ mế rì, ví ní là tiếu phưa loóng tlưởc mặt Thiên Chùa. <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />Mơi, moón gòa xật xứ ôộng chỉ mộch xân mộch mếng, xì moong tới pao Thiên Chùa mân cừ kiên tlí tloong sứ nái cườn mân cấu nguyến têm ngáy. <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />Cón moón ham việc phui dôống xì tà chểt, ngay cả tang cón khôồng. <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />Yý hảy răn pảo cảc mếnh lếnh ní, tể maáng cò thể chăng tiếu chi đàng tlẻch. <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />Mơi nều ôông ay rì chăng chu cẩp cho ùn maáng mếng tặc piệt là moón nhá mếng, xì moón rì tà tứ chồi đửc tin ôộng là moón xầu hơn moón chăng tin. <verse eid="1TI 5:8" /><verse number="9" style="v" sid="1TI 5:9" />Mộch mú gòa cấn phải àn ghi danh xì chăng ét hơn 60 xuổi, là du của mộch chầu, <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />àn chừng nhấn qua cảc việc lénh: mú cò ruôi táy con cài chăng, mú cò tiểp tòn khẻch lá chăng, mú cò xửa chó cảc thành tố chăng, mú cò cừu giủp moón hoán nán chăng, mú cò hểt loóng côống tẩt cả việc lénh chăng. <verse eid="1TI 5:10" /><verse number="11" style="v" sid="1TI 5:11" />Mơi hảy tứ chồi cảc mú gòa cón tlẻ, ví khới ham moành nhục dục rổi lêng chồng lái Chùa Cừu Thề, xì maáng moành lế chầu lấn nửa, <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />nhấn lế sứ phàn xẻt ví maáng tà huỷ ti kểt ưởc tấu tiên của mếng <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />Yý như xí, maáng yý sẻ quen xòi tlái, cừ lê la hểt nhá ní qua nhá kia, mà chăng chỉ xòi tlái, mơi cón xòi vé nhảm ôộng ưa xen pao việc của moón khảc, vé cảc tiếu maáng chăng rêng vé. <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />Pởi xí, ho moành cảc mú gòa cón ét xuổi hảy lế chầu, teẻ con, chăm nom nhá mếng, tể chăng mấn cơ hối cho moón chồng đồi cò lới phê phàn. <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />Ví mộch xồ moón tà quay ti xeo Sa-tan rối. <verse eid="1TI 5:15" /><verse number="16" style="v" sid="1TI 5:16" />Nều môn tố nử nó cò mú gòa tloong nhá, xì hảy giủp đở maáng, ôộng má tể Hối Thành pí tliêng nắng, tể cho Hối Thành cò thể giủp đở cảc mú gòa xật sứ.<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />Cảc tlưởng lảo khèo cai tlí phải àn hẩu là đàng kình nể nhiếu hơn, tặc piệt là cảc moón lao khổ tloong Lới Chùa mân sứ táy dổ. <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />Ví Kinh Thành táy: "Dâu chăng rêng pịt ménh con pó tang khới reé tạp loó," ôộng "Moón mấn côông xừng đàng côống xiến côông mếng." <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />Má tiểp nhấn lới cào puộc chôồng lái mộch tlưởng lảo, tlứ caá nều căn cừ tlêng ét xa là han hay pa moón mấn chừng. <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />Hảy tlẻch vằng moón phám xối tlưởc mặt tẩt cả cảc moón tể cảc moón cón lái yý mẳt rưởi. <verse eid="1TI 5:20" /><verse number="21" style="v" sid="1TI 5:21" />Ho tha thiểt truyến pảo con tlưởc mặt Thiên Chùa ôộng Chùa Cừu Thề Giê-xu, côống cảc thiên sừ àn chón, là con phải giử cảc mếnh lếnh ní, chăng àn thiên ví, chăng mấn chi xeo loóng thiên ví. <verse eid="1TI 5:21" /><verse number="22" style="v" sid="1TI 5:22" />Má vối tệch xay tlêng ôông ay, yý má tham dứ pao xối lổi của moón khảc. Hảy giử mếng thanh quang. <verse eid="1TI 5:22" /><verse number="23" style="v" sid="1TI 5:23" />Con má rêng chỉ oòng rảc, mơi hảy oòng mộch ét ráo ví pởi dá dáy của con ôộng cảc chừng pếng hay cò. <verse eid="1TI 5:23" /><verse number="24" style="v" sid="1TI 5:24" />Xối của một xồ moón xì rỏ ráng, tưa tềng tược phàn xẻt, mơi yý cò cảc xối chỉ lố xa khâu khới xẻt xử. <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />Chôồng như xí, yý cò cảc việc lénh xì rỏ ráng, cón cảc việc lénh cò tình âm thấm xì chăng thể cừ àn chù kìn.<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />Pẩt cừ ôông ay tang ở tìn ẻch nô lế, phải hẩu chủ mếng là đàng hểt loóng tôn tlóng, tể danh Thiên Chùa ôộng sứ táy pảo chăng pí xủc phám. <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />Mặt khảc, cảc nô lế cò cảc moón chủ là môn tố chăng àn pởi lỳ do maáng là ái ùn mà khinh thướng, mơi phải phục vuú cáng hơn nửa, ví maáng là môn tố ôộng moón àn yêu mền, moón tham gia pao sứ phục vuú. Con hảy táy pảo ôộng khuyên dục cảc tiếu rì.<verse eid="1TI 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3" />Nều moón nó rao giảng khảc ti ôộng chăng chẩp nhấn cảc lới tổt lénh, nghỉa là lới của Chùa tán ha, là Chùa Cừu Thề Giê-xu, côống giào huần vến sứ tin kình, <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />xì moón rì là moón kiêu căng, chăng hiểu mẳt cày chi, mơi pí vẳc tật pếng hoán tloong việc cải phố ôộng tlenh đầu vến chừ nghỉa, pở rì mấn xa sứ ghen tý, xung đột, xủc phám, nghi ngớ xầu xa, <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />xung đột, khừa cảc moón pí hư hoái tloong tâm tlì ôộng pí xiều vẩt chân lỳ, hẩu sứ tin kình là cảch kiềm lới. <verse eid="1TI 6:5" /><verse number="6" style="v" sid="1TI 6:6" />Mơi sứ tin kình côống sứ thoả loóng là nguốn lới ỉch náy. <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />Ví tán ha tà chăng tom cày chi pao thề gian, rêng tán ha yý chăng cò thể tom cày chi ti àn. <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />Mặt khảc, khới cò cơm ăn, ào mặc, xì tán ha sẻ àn thoả loóng côống cảc tiếu rì. <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />Cón cảc moón moành tlở rêng chấu cò xì rúng pao càm dổ ôộng cám pẩy, côống nhiếu ham moành ngu xuẩn, nguy hái, nghỉa là cảc xừ nhấn chím maáng pao sứ huỷ diệt ôộng tiêu voong. <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />Ví côổc rè của tủ xừ tiếu ảc là tham xiến, mà mộch xồ moón, ví xém khảt reé, tà pí dú dổ xa khỏi đửc tin ôộng mấn tổn hái cho mếng côống nhiếu tâu khổ.<verse eid="1TI 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />Mơi con, moón của Thiên Chùa ới, hảy tlènh xa cảc tiếu rì, mà xeo tuổi sứ côông chình, tin kình, đửc tin, tính yêu xương, tình kiên tlí, hiến hóa. <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />Hảy chiền đầu tloong cuộc chiền tổt lénh của đửc tin, hảy giử vửng sứ khôồng tới tới, là tiếu mà con tà àn hôổc tềng ôộng tà tuyên thế lới xưng nhấn tổt lénh tlưởc nhiếu moón mấn chừng. <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" />Ho truyến lếnh cho con tlưởc mặt Thiên Chùa, Tầng mấn cho muôn vật àn khôồng, ôộng tlưởc mặt Chùa Cừu Thề Giê-xu, Tầng tưa xa lới tuyên xưng tổt lénh tlưởc Bôn-xơ Phi-lát, <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />là con phải vơng giử lới răn pảo ní xật chăng ô dơ, chăng tược chê tlẻch, cho tềng ngáy hiến xa của Chùa tán ha, là Chùa Cừu Thề Giê-xu, <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />là Tầng mà Thiên Chùa Chì Cao đàng tôn vinh ôộng duy nhẩt, là Vua của cảc vua ôộng Chùa của cảc chùa, sẻ páy tỏ pao tùng thới điểm; <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />chỉ mộch mếng Ngài cò sứ vỉnh cửu, ngứ tloong sứ tlàng chăng thể tềng khênh àn, là Tầng chăng ay tứng hẩu kỉa, yý chăng ay cò thể kỉa àn, nguyến sứ tôn kình ôộng quyến phẻp tới tới xuộc vến Ngái. A-men.<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />Hảy răn pảo moón chấu tloong tới ní má kiêu ngáo, yý má tệch hy voóng pao xiến của chăng chẳc chằn, mơi hy voóng pao Thiên Chùa, Tầng pan cho tán ha tẩt cả xật dư dả tể phui hưởng, <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />ôộng răn pảo maáng mấn tiếu lénh, dư dả tloong việc lénh, cò loóng háo phoòng, sẳn sáng chia sẻ, <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />tỉch luỷ cho chình mếng mộch nến tảng tổt lénh cho tiếu pú tềng, tể maáng cò thể giử chặt sứ khôồng xật.<verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />Ti-mô-thê ới, con hảy pảo vế tiếu àn giao phò cho con, tlènh ti mầy chuyến vô ỉch tlấn tục, ôộng cảc tlenh cải giả danh là tli thửc, <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />mà một sồ moón, ví tuyên pồ như xí tà ti phảng hường đửc tin.</para>
  <para style="p" vid="1TI 6:21">Nguyến ân điển ở côống cảc ái ới ùn.<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>