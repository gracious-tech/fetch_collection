  <para style="ide">UTF-8</para>
  <para style="h">2 Thessalonians</para>
  <para style="toc1">Thư Tê-sa-lô-ni-ca thứ nhì</para>
  <para style="toc2">2 Tê-sa-lô-ni-ca</para>
  <para style="toc3">2Th</para>
  <para style="mt">2 Tê-sa-lô-ni-ca</para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />Phao-lô, ôộng Sin-vanh, côống Ti-mô-thê, cởi cho hối thành Tê-sa-lô-ni-ca tloong Thiên Chùa, là Cha ôộng Chùa tán ha, là Chùa Cừu Thề Giê-xu. <verse eid="2TH 1:1" /><verse number="2" style="v" sid="2TH 1:2" />Nguyến ân điển ôộng sứ pính an pở Thiên Chùa, là Cha, ôộng Chùa, là Chùa Cừu Thề Giê-xu, ở tlêng ái ới ùn.<verse eid="2TH 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />Thưa ái ới ùn, tán tôi phải luôn cảm ơn Thiên Chùa vến ái ới ùn, như rì là tiếu xừng đàng, ví đửc tin ái ới ùn ngáy cáng tăng tlưởng, ôộng tính yêu xương của mỗi mộch moón tloong tẩt cả ái ới ùn đồi côống phố cừ xêm lêng; <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />Pởi xí, tán tôi tứ háo mếng vến ái ới ùn tloong voóng cảc hối thành của Thiên Chùa vến sứ kiên ltí của ái ới ùn ôộng đửc tin khừa tẩt cả sứ pẳt pờ của ái ới ùn, côống cảc hoán nán mà ái ới ùn tang phải chíu, <verse eid="2TH 1:4" /><verse number="5" style="v" sid="2TH 1:5" />rì là pắng chừng vến sứ phàn xẻt côông chình của Thiên Chùa cho ái ới ùn tể àn xẻt là xừng đàng côống vương quổc của Thiên Chùa, ví vương quổc rì mà ái ới ùn yý tang chíu khổ; <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />ví xật là côông pắng khới Thiên Chùa tlả lái sứ hoán nán tlêng cảc enh mấn xa hoán nán cho ái ới ùn, <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />ôộng pan cho ái ới ùn, là cảc moón chíu hoán nán, sứ nghỉ ngơi côống tán tôi khới việc tềng của Chùa Giê-xu hiến xa pở tlới côống cảc thiên sừ mánh mẻ của Ngái, <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />Tloong ngón lửa phứng, tom hính phạt tềng cho cảc enh chăng hay mẳt Thiên Chùa ôộng cho cảc enh chăng vâng phục Tin Lénh của Chùa tán ha, là Chùa Giê-xu, <verse eid="2TH 1:8" /><verse number="9" style="v" sid="2TH 1:9" />rì là cảc enh sẻ tliêng lế hính phạt — là sứ huỷ diệt tới tới, cảch giang mặt Thiên Chùa ôộng khỏi vinh quang của quyến năng Ngái, <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />Khới Ngái tềng tể àn tôn vinh pởi cảc thành tố của Ngái ôộng àn chiêm ngưởng khừa tẩt cả cảc moón tà tin, pởi lới chừng của tán tôi tềng côống ái ới ùn tloong ngáy rì tàn àn tin nhấn. <verse eid="2TH 1:10" /><verse number="11" style="v" sid="2TH 1:11" />Ví lì do rì, tán tôi vẩn luôn cấu nguyến cho ái ới ùn tể Thiên Chùa tán ha xẻt ái ới ùn là xừng đàng côống lới hôổc, ôộng tể Ngái mấn hoán thánh tẩt cả moong moành vến tiếu lénh ôộng côông việc của đửc tin pởi năng quyến, <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />tể cho danh của Chùa tán ha, là Chùa Giê-xu, àn tôn vinh ở ái ới ùn ôộng ái ới ùn àn vinh hiển ở Ngái, xeo ân điển của Thiên Chùa ôộng Chùa tán ha, là Chùa Cừu Thề Giê-xu.<verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />Thưa ái ới ùn, vến việc tềng của Chùa tán ha, là Chùa Cừu Thề Giê-xu, ôộng việc tập kểt của tán ha côống Ngái, tán tôi cườn ái ới ùn <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />là ái ới ùn má lời pí dao đống hay hoảng hổt tloong tâm tlì mếng, yý má pởi mộch linh, hoặc pởi mộch lới khề, hay pởi mộch là thơ chôồng như tềng pở tán tôi, khới vé là ngáy của Chùa tà tềng rối. <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />Nguyến chăng mộch ôông ay xeo pẩt ký cảch nó cò thể lứa gạt ái ới ùn, ví ngáy rì chăng tềng cho tềng khới việc bối đáo diển xa tlưởc tiên, ôộng con moón của sứ gian ảc àn tiểt lố, nghỉa là từa con của sứ huỷ diệt. <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />là enh chồng đồi ôộng tứ tôn mếng lêng chồng lái côống tẩt cả cảc tiếu àn hôổc là thấn hay là đồi tướng thớ phướng. Tềng nổi, reé ngối tloong tến thớ của Thiên Chùa, tuyên pồ là chình reé là Thiên Chùa. <verse eid="2TH 2:4" /><verse number="5" style="v" sid="2TH 2:5" />Ái ới ùn chăng căắn là, khới cón ở côống ái ới ùn, tôi tà cho ái ới ùn mẳt vến cảc việc ní rối à? <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />Ôộng caá ní ái ới ùn tà mẳt tiếu chi tang ngăn cản, tể reé chỉ àn xuẩt hiến pao tùng thới điểm của reé. <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />Ví tiếu pì ẩn của sứ gian ảc tang mấn việc rối, Tầng duy nhẩt tang ngăn cản reé caá ní vẩn cón cho tềng caá Tầng rì xa khỏi điểm ngăn cản chình khừa, <verse eid="2TH 2:7" /><verse number="8" style="v" sid="2TH 2:8" />Ôộng rối enh gian ảc sẻ àn lố diến, là enh mà Chùa Giê-xu sẻ tiêu diệt pắng hơi thở của ménh Ngái, ôộng Ngái sẻ mấn reé tlở rêng vô hiếu pởi vinh quang việc hiến tềng của Ngái, <verse eid="2TH 2:8" /><verse number="9" style="v" sid="2TH 2:9" />mơi việc xuẩt hiến của enh gian ảc rì là pởi việc mấn của Sa-tan pắng tẩt cả quyến năng côống dầu lá, yý như phẻp mấu giả táo, <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />ôộng tloong tẩt cả việc lứa dồi pẩt chình tể cho cảc enh hư vẩt, mơi maáng hư vẩt là ví maáng tà chăng tiểp nhấn tính yêu chân lỳ cho mếng tể àn cừu. <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />Ôộng ví lỳ do rì, Thiên Chùa giao phò maáng pao tảc đống của sứ lấm lạc tể maáng tin tiếu giả dồi, <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />tể cho tẩt cả maáng sẻ pí phàn xẻt, nghỉa là cảc enh chăng tin chân lỳ, mơi lái phui sường tloong việc pẩt chình.<verse eid="2TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />Mơi, thưa ái ới ùn, là cảc moón àn Chùa yêu, tán tôi phải luôn tá ơn Thiên Chùa vến ái ới ùn. Ví Thiên Chùa tà chón ái ới ùn như cảc tlày tấu múa tể hưởng ơn cừu rổi pởi sứ thành hoà của Thành Linh ôộng niếm tin ở chân lỳ. <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" />Ví tể hưởng ơn rì, Ngái tà hôổc ái ới ùn qua Tin Lénh của tán tôi, tềng côống việc thứa hưởng vinh quang của Chùa tán ha, là Chùa Cừu Thề Giê-xu. <verse eid="2TH 2:14" /><verse number="15" style="v" sid="2TH 2:15" />Pởi xí, thưa ái ới ùn, hảy từng vửng ôộng giử chặt cảc truyến thồng mà ái ới ùn tà àn táy pảo, pẩt luấn pắng lới khề hay pắng thơ của tán tôi.<verse eid="2TH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16" />Nguyến chình Chùa tán ha, là Chùa Cừu Thề Giê-xu, ôộng Thiên Chùa, Cha tán ha, Tầng yêu xương tán ha ôộng tà pan cho tán ha sứ an ủi tới tới côống niếm hy voóng tổt lénh pởi ân điển, <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />cườn Ngái khỉch lế ôộng mấn cho vửng mánh tầm loóng ái ới ùn tloong tẩt cả việc mấn côống lới khề tổt lénh.<verse eid="2TH 2:17" /></para>
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />Cuồi cúng, thưa ái ới ùn, cườn cấu nguyến cho tán tôi, tể lới của Chùa mâu lan truyến ôộng àn tôn vinh, yý như tà àn kỉa ở ái ới ùn, <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />ôộng tể tán tôi àn giải cừu khỏi cảc enh xầu xa ôộng gian ảc, ví chăng phải tẩt cả cảc moón tếu cò đửc tin. <verse eid="2TH 3:2" /><verse number="3" style="v" sid="2TH 3:3" />Mơi Chùa là đàng tin, Tầng sẻ mấn cho vửng mánh ôộng pảo vế ái ới ùn khỏi enh ảc. <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />Tán tôi tin chẳc chằn ở Chùa vến ái ới ùn là ái ới ùn tang mấn ôộng sẻ mấn cảc tiếu tán tôi răn pảo. <verse eid="2TH 3:4" /><verse number="5" style="v" sid="2TH 3:5" />Nguyến cườn Chùa hường dẩn loóng ái ới ùn hường vến tính yêu của Thiên Chùa ôộng tềng côống sứ kiên nhẩn của Chùa Cừu Thề.<verse eid="2TH 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />Mơi, thưa ái ới ùn, nhân danh Chùa tán ha là Chùa Cừu Thề Giê-xu, tán tôi răn pảo ái ới ùn, tể ái ới ùn tlènh giang tẩt cả môn tố khôồng chăng cò kỷ luật ôộng chăng xeo cảc truyến thồng mà ái ới ùn tà nhấn pở tán tôi. <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />Ví chình ái ới ùn mẳt cấn phải noi xeo gương tán tôi xa xí nó, pởi tán tôi tà chăng khôồng vô kỷ luật khừa ái ới ùn, <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />tán tôi yý chăng ăn rỏ tố ăn pở mộch moón nó, mơi têm ngáy mấn việc tloong sứ khò khăn vẩt vả tể chăng mấn tliêng nắng cho pẩt cừ ôông ay tloong ái ới ùn, <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />chăng phải ví tán tôi chăng cò quyến, mơi tể tán tôi tứ tệch mếng như tầm gương cho ái ới ùn tể pẳt tlưởc tán tôi. <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />Ví ngay cả khới tán tôi cón ở côống ái ới ùn, tán tôi tà răn pảo ái ới ùn tiếu ní, là: "Nều moón nó chăng moành mấn việc xì moón rì yý má ăn." <verse eid="2TH 3:10" /><verse number="11" style="v" sid="2TH 3:11" />Pởi tán tôi măng vé khừa voóng ái ới ùn cò mộch xồ moón khôồng chăng cò kỷ luật, chăng mấn việc mơi hay xen pao chuyến chăng phải của mếng. <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />Mơi tloong Chùa, là Chùa Cừu Thề Giê-xu, tán tôi răn pảo ôộng khuyền khỉch cảc moón như xí, tể cho maáng cò thể ăn tố ăn của mếng khới mấn việc côống sứ yên lắng. <verse eid="2TH 3:12" /><verse number="13" style="v" sid="2TH 3:13" />Cón ái ới ùn, ái ới ùn má nản loóng, khới mấn tiếu phải. <verse eid="2TH 3:13" /><verse number="14" style="v" sid="2TH 3:14" />Mặt khảc, nều moón nó chăng tuân giử lới tán tôi qua thơ ní, xì hảy lưu ỳ moón rì — tể chăng giao du côống máng, tể cho moón rì tứ kỉa xầu hổ. <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />Má hẩu moón rì như kẻ thú, mơi hảy răn pảo như mộch moón ái ới ùn.<verse eid="2TH 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />Cườn chình Chùa pính an pan cho ái ới ùn sứ pính an qua tẩt cả cảc việc tloong tẩt cả cảc phương diến. Nguyến Chùa ở côống tẩt cả ái ới ùn. <verse eid="2TH 3:16" /><verse number="17" style="v" sid="2TH 3:17" />Lới cháo ní pởi chình xay tôi — Phao-lô — rì là chừ kỳ tloong tẩt cả là thơ. Tôi hay viểt như xí. <verse eid="2TH 3:17" /><verse number="18" style="v" sid="2TH 3:18" />Nguyến ân điển của Chùa tán ha, là Chùa Cừu Thề Giê-xu, ở côống tẩt cả ái ới ùn.<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>