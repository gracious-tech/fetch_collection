<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ISA" style="id">- Ntrubo Old Testament Project</book>
  <para style="h">Yesaya</para>
  <para style="toc1">Yesaya Tɔne</para>
  <para style="toc2">Yesaya</para>
  <para style="toc3">Yes</para>
  <para style="mt1">Yesaya Tɔne</para>
  <chapter number="1" style="c" sid="ISA 1" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 1:1" />Amose bu Yesaya nombia ŋan ɔ be naa lee Yuda na Yerusalɛm wose man debaŋ keŋ Usiya na Yotame na Ahase na Hesekiya be dii gyoori Yuda nɛ yaa.<verse eid="ISA 1:1" /></para>
  <para style="b" />
  <para style="s1">Wurubuarɛ kewɔŋ ɔ balaŋ deŋele</para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 1:2" />Degbeŋgyoo kpa,</para>
  <para style="q2" vid="ISA 1:2">&lt;&lt;Nyaŋ adido nyii, Tɛɛle, tei,</para>
  <para style="q1" vid="ISA 1:2">Ma te kɛɛle bia be ta bee taŋ,</para>
  <para style="q2" vid="ISA 1:2">mɔna be ta koro seŋ tia maŋ.<verse eid="ISA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 1:3" />Nunkyue baale gyeŋ ɔ gbeŋgyoo</para>
  <para style="q2" vid="ISA 1:3">te afurum gyeŋ ɔ gbeŋgyoo weenɛɛ adakaa,</para>
  <para style="q1" vid="ISA 1:3">mɔna Iseraetena ba gyeŋ maŋ ya,</para>
  <para style="q2" vid="ISA 1:3">me balaŋ bee nyii nombia man ya.&gt;&gt;<verse eid="ISA 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 1:4" />Tɛɛle keŋ kɛɛ yɛɛ dukum nɛ dɛɛ laako,</para>
  <para style="q2" vid="ISA 1:4">balaŋ baŋ be fɔɔkedi boe,</para>
  <para style="q1" vid="ISA 1:4">nombia kumɛɛ yɛɛra bia,</para>
  <para style="q2" vid="ISA 1:4">bia baŋ bɔɔ wɔlɛɛ,</para>
  <para style="q1" vid="ISA 1:4">Ba te bɛɛ Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 1:4">ba te bɛɛ Iserae walaŋ Fereŋkyeŋte Ŋon.</para>
  <para style="q2" vid="ISA 1:4">be ta besena be wɔɔle tee e.<verse eid="ISA 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 1:5" />Woŋ dɔɔ te baa bese tuku ŋon bela?</para>
  <para style="q2" vid="ISA 1:5">Woŋ dɔɔ te ɛ gyakaa ɛ ne yɛɛ deŋele doŋ?</para>
  <para style="q1" vid="ISA 1:5">Nyee keŋ pou te gooli,</para>
  <para style="q2" vid="ISA 1:5">te konɔɔ keŋ pou ne nyii weeleŋ.<verse eid="ISA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 1:6" />Lee nyeeman mo kɔŋ nawɔɔtɛɛ,</para>
  <para style="q2" vid="ISA 1:6">be dana doŋ ya,</para>
  <para style="q1" vid="ISA 1:6">gyaŋtarɛɛ na gyamɛɛ kaageŋ,</para>
  <para style="q2" vid="ISA 1:6">na gyamɛɛ ŋan ŋee wii loŋse nɛ,</para>
  <para style="q1" vid="ISA 1:6">bɔɔ na nyekee yaa bake ŋa ya,</para>
  <para style="q2" vid="ISA 1:6">te bɔɔ na do ŋa tee ya.<verse eid="ISA 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 1:7" />Ɛ tɛɛle keŋ doo yakaa.</para>
  <para style="q2" vid="ISA 1:7">te ba too ɛ donɔɔse dinaana ŋan,</para>
  <para style="q1" vid="ISA 1:7">te ŋɔɔla te lɛo ɛ tɛɛlese,</para>
  <para style="q2" vid="ISA 1:7">ɛ siaman pɛɛ,</para>
  <para style="q1" vid="ISA 1:7">ŋgba mena keŋ ŋɔɔla ne wɔlɛɛ abɔɔ nɛ.<verse eid="ISA 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 1:8" />Be te tina Siyɔn bu alebu ŋon yela,</para>
  <para style="q2" vid="ISA 1:8">ŋgba gerepo wɔɔman kefɛɛ nɛ,</para>
  <para style="q1" vid="ISA 1:8">ŋgba kefɛɛ keŋ kyaa kukumba wɔɔman nɛ,</para>
  <para style="q2" vid="ISA 1:8">ŋgba donɔɔ dinaa keŋ kɔlara be tɔ wɔ do nɛ.<verse eid="ISA 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 1:9" />Na Degbeŋgyoo Dekpataakpere ŋon</para>
  <para style="q2" vid="ISA 1:9">kaasena daa balaŋ kyomii baale ya na,</para>
  <para style="q1" vid="ISA 1:9">nafɔ dɛɛ yɛɛ ŋgba Sodom nɛ,</para>
  <para style="q2" vid="ISA 1:9">nafɔ dɛɛ yɛɛ ŋgba Gomora nɛ.<verse eid="ISA 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 1:10" />Ɛmɛɛ Sodom siamantena,</para>
  <para style="q2" vid="ISA 1:10">ɛ nyii Degbeŋgyoo dei.</para>
  <para style="q1" vid="ISA 1:10">ɛmɛɛ Gomoratena,</para>
  <para style="q2" vid="ISA 1:10">ɛ tei Degbeŋgyoo nombia kawola.<verse eid="ISA 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 1:11" />Degbeŋgyoo kpa nyiaa,</para>
  <para style="q1" vid="ISA 1:11">&lt;&lt;Woŋ te ɛ kedeesase burum ŋan,</para>
  <para style="q2" vid="ISA 1:11">gyae ke yɛɛ fa maŋ?</para>
  <para style="q1" vid="ISA 1:11">Namense na ɛ wonembia nuŋse,</para>
  <para style="q2" vid="ISA 1:11">na katoo kedeesase te poro maŋ,</para>
  <para style="q1" vid="ISA 1:11">nunkyuese na namense na asoose fatabose bɛɛ gyɔ maŋ loo ya.<verse eid="ISA 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 1:12" />Nyi akpaa ɛ kɔŋ me siaman na,</para>
  <para style="q2" vid="ISA 1:12">amɔte yakona ŋon nyi,</para>
  <para style="q1" vid="ISA 1:12">yaa kɔŋ kaa sakatee ma akpaŋalaŋse man?<verse eid="ISA 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 1:13" />Ɛ na mo kedeesase ŋan be dana tɔnɔɔ ya nɛ kɔna maŋ ya.</para>
  <para style="q2" vid="ISA 1:13">Yɔ oliifi yɛɛ ma anekɔlaŋ.</para>
  <para style="q1" vid="ISA 1:13">Mɔɔ tale seŋ kɛɛ ɛ kegyaŋeese,</para>
  <para style="q2" vid="ISA 1:13">gyaalaŋ wɔle wee kedi na kefɛɛfowee na ɛ nɔɔkedise ŋaale ŋan be dana tɔnɔɔ nɛ ya.<verse eid="ISA 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 1:14" />Ma woo ne kɔla ɛ gyaalaŋ wɔle weekedi,</para>
  <para style="q2" vid="ISA 1:14">na debaŋ keŋ ɛ na mo di nɔɔkedise ŋaale nɛ.</para>
  <para style="q1" vid="ISA 1:14">Ŋa te kaa bese kasolɔ fa maŋ</para>
  <para style="q2" vid="ISA 1:14">te ma te kaana ŋa.<verse eid="ISA 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 1:15" />Nyi akpaa ɛ gyina ɛ nyiŋmaase ɛ ne fane nɛ,</para>
  <para style="q2" vid="ISA 1:15">maa lese me sia.</para>
  <para style="q1" vid="ISA 1:15">Nyi akpaa ɛ fane kyare koraŋ nɛ,</para>
  <para style="q2" vid="ISA 1:15">mɔɔ gyae maa tei ŋon ya.</para>
  <para style="b" vid="ISA 1:15" />
  <para style="q1" vid="ISA 1:15">nawolo nyi ɛ ta koe balaŋ.<verse eid="ISA 1:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ISA 1:16" />Ɛ sɔ na ɛ ke gberaa ɛ wose.</para>
  <para style="q2" vid="ISA 1:16">Ɛ lese ɛ nombiakumɛɛ keyɛɛ,</para>
  <para style="q1" vid="ISA 1:16">lee me siaman,</para>
  <para style="q2" vid="ISA 1:16">Ɛ tina nombia kumɛɛ keyɛɛ yela.<verse eid="ISA 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 1:17" />Ɛ kasee nombia kpaakpaa keyɛɛ, na ɛ ke kɛo nombia kedi kegbɛɛ dɔɔ,</para>
  <para style="q2" vid="ISA 1:17">na ɛ ke di baŋ bɔɔ ŋere wɔ do nɛ nombia fa wɔ.</para>
  <para style="q1" vid="ISA 1:17">Ɛ seŋ yoyolobiise wɔle</para>
  <para style="q2" vid="ISA 1:17">na ɛ ka sola fa liala.<verse eid="ISA 1:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ISA 1:18" />Degbeŋgyoo kpa nyiaa,</para>
  <para style="q2" vid="ISA 1:18">&lt;&lt;Nɛnɛɛ ɛ kɔŋ na dɛɛ mo nyeempɔ,</para>
  <para style="q1" vid="ISA 1:18">doo nyi ɛ dukum yɛɛ ŋgba kanyaŋ yayam koraŋ nɛ,</para>
  <para style="q2" vid="ISA 1:18">ke gyae ka wolose ŋgba dukurufa mpuu nɛ.</para>
  <para style="q1" vid="ISA 1:18">Nyi akpaa ŋe yasɛɛ ŋgba fatabo koraŋ na,</para>
  <para style="q2" vid="ISA 1:18">ŋe gyae ka wolose ŋgba akaralɛɛ nɛ.<verse eid="ISA 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 1:19" />Nyi akpaa ɛ gyae te ɛ nyii me dei na,</para>
  <para style="q2" vid="ISA 1:19">ɛ ke di tɛɛle keŋ dɔɔ abɔɔ kpaakpaa.<verse eid="ISA 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 1:20" />Mɔ nyi akpaa ɛ yɛɛ deŋele doŋ te ɛ seŋ tia maŋ na,</para>
  <para style="q2" vid="ISA 1:20">yoosila gyae ka koe ŋon.&gt;&gt;</para>
  <para style="q1" vid="ISA 1:20">Degbeŋgyoo yakola.<verse eid="ISA 1:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="ISA 1:21" />Kɛɛ mena keŋ donɔɔ dinaa keŋ kee di anokoare nɛ,</para>
  <para style="q2" vid="ISA 1:21">ka bese futoolite.</para>
  <para style="q1" vid="ISA 1:21">Nafɔ ɔ ne di nombia na kegbɛɛ,</para>
  <para style="q2" vid="ISA 1:21">Nafɔ ɔ tenɛɛ,</para>
  <para style="q1" vid="ISA 1:21">mɔna nɛnɛɛ awudiina te wulu ke man.<verse eid="ISA 1:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 1:22" />N kɔba wolom be dana tɔnɔɔ ya,</para>
  <para style="q2" vid="ISA 1:22">be ta mo loŋ kyakale n waen gyaagyi man.<verse eid="ISA 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 1:23" />N siamantena na koro seŋ tia maŋ,</para>
  <para style="q2" vid="ISA 1:23">be gyoona yɛna ŋmɛɛlatena,</para>
  <para style="q1" vid="ISA 1:23">be popou ne gyae abɔɔ kayo lɛɛ,</para>
  <para style="q2" vid="ISA 1:23">te be silana abɔɔkefa gbɛɛ.</para>
  <para style="q1" vid="ISA 1:23">Bɔɔ ne di yoyolobiise nombia fa wɔ ya,</para>
  <para style="q2" vid="ISA 1:23">te bɔɔ famenɛna liala nombia ya.<verse eid="ISA 1:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 1:24" />Mena dɔɔ Degbeŋgyoo, Degbeŋgyoo Dekpataakpere,</para>
  <para style="q2" vid="ISA 1:24">Iseraetena Doŋte ŋon kpa,</para>
  <para style="q1" vid="ISA 1:24">&lt;&lt;Maa lese me baŋ wola me kɔlara,</para>
  <para style="q2" vid="ISA 1:24">na maa tɔ me kɔlara kom.<verse eid="ISA 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 1:25" />Maa wɔŋ n deŋele nideli,</para>
  <para style="q2" vid="ISA 1:25">maa yalakee neŋ lese ayimɛɛ nideli,</para>
  <para style="q1" vid="ISA 1:25">na maa lese nya ayimɛɛ pou.<verse eid="ISA 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 1:26" />Maa bese see nombiadiira fa neŋ ŋgba gyaŋgba keŋ nɛ,</para>
  <para style="q2" vid="ISA 1:26">na siamantena ŋgba kewalaŋ keŋ nɛ.</para>
  <para style="q1" vid="ISA 1:26">Kenaŋ wɔle na baa baake neŋ nyi,</para>
  <para style="q2" vid="ISA 1:26">donɔɔ dinaa keŋ ka tenɛɛ,</para>
  <para style="q2" vid="ISA 1:26">na donɔɔ dinaa keŋ kee di anokoare.&gt;<verse eid="ISA 1:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="ISA 1:27" />Baa mo nombia kedina kegbɛɛ lɛɛ Siyɔn,</para>
  <para style="q2" vid="ISA 1:27">te baŋ bɔɔ kyɛɛkee lee be konɔɔse man nɛ, baa lɛɛ wɔ lee be katenɛɛ dɔɔ.<verse eid="ISA 1:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 1:28" />Baa wɔlɛɛ baŋ be dana deŋeledoŋ na nombiakumɛɛ yɛɛra,</para>
  <para style="q2" vid="ISA 1:28">te baŋ bɔɔ bɛɛ Degbeŋgyoo nɛ baa munu.<verse eid="ISA 1:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="ISA 1:29" />Desɛŋ gyae ke kyaŋ ŋon lee kpeli daase ŋan,</para>
  <para style="q2" vid="ISA 1:29">ɛ ne nyaŋee som nɛ dɔɔ.</para>
  <para style="q1" vid="ISA 1:29">Ɛ sia gyae ka yeŋ lee wɔɔsebia ŋan,</para>
  <para style="q2" vid="ISA 1:29">ɛ ba lese nɛ dɔɔ.<verse eid="ISA 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 1:30" />Ɛ ke yɛɛ ŋgba kpeli daŋ keŋ ke faareŋ be kpiisi nɛ,</para>
  <para style="q2" vid="ISA 1:30">ŋgba wɔɔbii keŋ loŋ be doo ke man ya nɛ.<verse eid="ISA 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 1:31" />Doŋte waa yɛɛ ŋgba faareŋ awolɛɛ nɛ,</para>
  <para style="q2" vid="ISA 1:31">te ɔ tom yɛɛ ŋgba boalaŋ katepɛɛpɛɛse nɛ,</para>
  <para style="q1" vid="ISA 1:31">ŋe popou gyae ke kpa,</para>
  <para style="q2" vid="ISA 1:31">keŋ ŋolo be tale ko ŋa ya.&gt;<verse eid="ISA 1:31" /></para>
  <chapter eid="ISA 1" />
  <chapter number="2" style="c" sid="ISA 2" />
  <para style="s1">Degbeŋgyoo Bula keŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 2:1" />Kei yɛna keŋ Amose bu Yesaya be naa lee Yuda na Yerusalɛm wose man,<verse eid="ISA 2:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="ISA 2:2" />Weeya ɔto nyiŋan man nɛ, Degbeŋgyoo ɔsom deni dinaa bula keŋ gyae ka seŋ,</para>
  <para style="q2" vid="ISA 2:2">ŋgba bula keŋ ka korɛɛ kela bulase pou nɛ,</para>
  <para style="q1" vid="ISA 2:2">baa gate ke adido kela bulasebia,</para>
  <para style="q2" vid="ISA 2:2">te tɛɛlese pou baa kaa wuu ke tɛɛ.<verse eid="ISA 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 2:3" />Balaŋ burum baa kɔŋ kaa yako nyiaa,</para>
  <para style="q1" vid="ISA 2:3">&lt;&lt;Ɛ kɔŋ dɛɛ gyeŋ gyu Degbeŋgyoo bula keŋ dɔɔ,</para>
  <para style="q2" vid="ISA 2:3">dee gyu Yakɔbe Wurubuarɛ ɔsom deni dinaa keŋ man.</para>
  <para style="q1" vid="ISA 2:3">waa wola daa ɔ gbɛɛneŋ,</para>
  <para style="q1" vid="ISA 2:3">na dee nyiŋ ta ɔ detɛe man.&gt;&gt;</para>
  <para style="q1" vid="ISA 2:3">Mmaraa keŋ gyae ka lee Siyɔn,</para>
  <para style="q2" vid="ISA 2:3">Degbeŋgyoo nombia gyae ka lee Yerusalɛm.<verse eid="ISA 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 2:4" />Waa di tɛɛlese nsana nombia,</para>
  <para style="q2" vid="ISA 2:4">na waa desina balaŋ burum nsana,</para>
  <para style="q1" vid="ISA 2:4">baa mo be yoosilase luu fara,</para>
  <para style="q2" vid="ISA 2:4">na ba apiase ka bese asosɔse,</para>
  <para style="q1" vid="ISA 2:4">Tɛɛle daale be gyae ke wɔŋ yoosila tia tɛɛle daale,</para>
  <para style="q2" vid="ISA 2:4">yaa baa desina ba wose fa yoo bela ya.<verse eid="ISA 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 2:5" />Yakɔbe duuluŋmantena, ɛ kɔŋ,</para>
  <para style="q2" vid="ISA 2:5">ɛ yela dɛɛ ta Degbeŋgyoo keŋmaŋee keŋ man.<verse eid="ISA 2:5" /></para>
  <para style="s1">Degbeŋgyoo wee keŋ</para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 2:6" />Nyaŋ Degbeŋgyoo, n te bɛɛ n balaŋ,</para>
  <para style="q2" vid="ISA 2:6">Yakɔbe duuluŋmantena,</para>
  <para style="q1" vid="ISA 2:6">nawolo nyi bɛɛ yɛɛ weese dɛɛlee amanberɛse,</para>
  <para style="q2" vid="ISA 2:6">bɛɛ gbale ŋgba Filisitena nɛ,</para>
  <para style="q2" vid="ISA 2:6">te be lɛɛ bɛɛneŋ amanberɛse do.<verse eid="ISA 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 2:7" />Kɔba wolom na kɔba yayam te wulu tɛɛle keŋ man,</para>
  <para style="q2" vid="ISA 2:7">ba abɔɔ analeeŋ koya boe nideli,</para>
  <para style="q1" vid="ISA 2:7">dɛɛkyɔŋse te wulu be tɛɛle,</para>
  <para style="q2" vid="ISA 2:7">be yookɔtase mɔ boe nideli.<verse eid="ISA 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 2:8" />Bɛɛneŋ te wulu be tɛɛle,</para>
  <para style="q2" vid="ISA 2:8">bɛɛ som abɔɔ ŋan baŋ gbagba be yɛɛ,</para>
  <para style="q" vid="ISA 2:8">2 ŋan bɔɔ mo be nyiŋbiise yɛɛ.<verse eid="ISA 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 2:9" />Mena dɔɔ baa kɔna balaŋ pou tɛɛle man,</para>
  <para style="q2" vid="ISA 2:9">na baa yɔkɔse ɔkamasɛ.</para>
  <para style="q2" vid="ISA 2:9">Naa mo kyɛɛ wɔ ya.<verse eid="ISA 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 2:10" />Ɛ gyoo kpanaŋse man, ɛ yo tɛɛle man,</para>
  <para style="q2" vid="ISA 2:10">ɛ yeu lee Degbeŋgyoo wose man gyakoloŋ,</para>
  <para style="q2" vid="ISA 2:10">na ɔ doŋ na ɔ gyoorobiiri keŋ dɔɔ.<verse eid="ISA 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 2:11" />Baa yɔkɔse agaŋtaŋtena,</para>
  <para style="q2" vid="ISA 2:11">deniwalaŋ wose kegate gyae ke kɔŋ tɛɛle man,</para>
  <para style="q1" vid="ISA 2:11">Degbeŋgyoo waageŋ te baa gate e adido wee kenaŋ.<verse eid="ISA 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 2:12" />Degbeŋgyoo Dekpataakpere ŋon ta lese wee daale see,</para>
  <para style="q2" vid="ISA 2:12">fa baŋ bɛɛ gate ba wose na agaŋtaŋtena,</para>
  <para style="q1" vid="ISA 2:12">na ŋan pou ŋɛɛ gate ŋa wose adido nɛ,</para>
  <para style="q2" vid="ISA 2:12">na baa yɔkɔse wɔ,<verse eid="ISA 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 2:13" />na Lebanɔn sida daase ŋan dana dɔɔloŋ na ŋan ŋa korɛɛ pou,</para>
  <para style="q2" vid="ISA 2:13">na Basan kpeli daase pou,<verse eid="ISA 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 2:14" />Na bulase ŋan pou korɛɛ,</para>
  <para style="q2" vid="ISA 2:14">na bulasebia ŋan pou ŋe dana dɔɔloŋ nɛ,<verse eid="ISA 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 2:15" />na dekagya kamasɛ keŋ ka korɛɛ,</para>
  <para style="q2" vid="ISA 2:15">na dekyaŋ kamasɛ keŋ bɔɔ maa kilisi ke.<verse eid="ISA 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 2:16" />na pantuu dinaana,</para>
  <para style="q2" vid="ISA 2:16">na ŋan ŋe dana kyeo nɛ.<verse eid="ISA 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 2:17" />Waa kɔna walaŋ agaŋtaŋ tɛɛle man,</para>
  <para style="q2" vid="ISA 2:17">na waa yɔkɔse walaŋ wose kegate,</para>
  <para style="q1" vid="ISA 2:17">Degbeŋgyoo waageŋ te baa gyina adido wee kenaŋ,<verse eid="ISA 2:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ISA 2:18" />Te bɛɛneŋ mɔ baa ŋaalaa korakora.<verse eid="ISA 2:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="ISA 2:19" />Akpaa Degbeŋgyoo da koro nyi waa wosi tɛɛle na,</para>
  <para style="q2" vid="ISA 2:19">balaŋ baa yekii kagyoo kpanaŋ bɔɔneŋ,</para>
  <para style="q1" vid="ISA 2:19">na tɛɛle bɔɔneŋ man,</para>
  <para style="q2" vid="ISA 2:19">lee ɔ wose gyakoloŋ na ɔ doŋ dekpataakpere keŋ ɔ ba lese wola dɔɔ.<verse eid="ISA 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 2:20" />Wee kenaŋ delii na balaŋ baa fuŋii,</para>
  <para style="q2" vid="ISA 2:20">be kɔba wolom bɛɛneŋ na kɔba yayam bɛɛneŋ,</para>
  <para style="q1" vid="ISA 2:20">ŋan bɔɔ yɛɛ nyi baa som ŋa nɛ,</para>
  <para style="q2" vid="ISA 2:20">fa gbegyagbegyase na kokyoŋoloŋse.<verse eid="ISA 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 2:21" />Akpaa Degbeŋgyoo da koro waa wosi tɛɛle nɛ,</para>
  <para style="q2" vid="ISA 2:21">balaŋ baa yekii kagyoo kpanaŋ bɔɔneŋ,</para>
  <para style="q1" vid="ISA 2:21">na akyoloŋkyoloŋse man,</para>
  <para style="q2" vid="ISA 2:21">lee ɔ wose gyakoloŋ na ɔ gyoorobiiri doŋ,</para>
  <para style="q2" vid="ISA 2:21">keŋ ɔ ba lese wola nɛ dɔɔ.<verse eid="ISA 2:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="ISA 2:22" />Tina n wose kamo lɔ denibalaŋ,</para>
  <para style="q2" vid="ISA 2:22">baŋ bɔɔ dana kolo kpuna weesɛɛ ya nɛ dɔɔ yela.</para>
  <para style="q2" vid="ISA 2:22">Woŋ tɔnɔɔ yaa be dana?<verse eid="ISA 2:22" /></para>
  <chapter eid="ISA 2" />
  <chapter number="3" style="c" sid="ISA 3" />
  <para style="s1">Nombia kedi Yerusalɛm na Yuda dɔɔ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 3:1" />Nɛnɛɛ kɛɛ, Debeŋgyoo</para>
  <para style="q2" vid="ISA 3:1">Degbeŋgyoo Dekpataakpere ŋon,</para>
  <para style="q1" vid="ISA 3:1">ne gyae waa lese kefa na kekyɔ pou,</para>
  <para style="q2" vid="ISA 3:1">weenɛɛ na loŋ kefa,<verse eid="ISA 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 3:2" />baalebu na yoonɔɔte,</para>
  <para style="q1" vid="ISA 3:2">nombiadiiri na Wurubuarɛ gbalare,</para>
  <para style="q2" vid="ISA 3:2">gbalare na kegyia.<verse eid="ISA 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 3:3" />yoonɔɔtena sɔŋola na kufu siamante, na obuo walaŋ,</para>
  <para style="q2" vid="ISA 3:3">na ŋon ɔ ne kolosido balaŋ na ŋon ɔ gyeŋ adao nyiŋmaa man tomse na ŋmeeseŋtena lee Yerusalɛm na Yuda.<verse eid="ISA 3:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 3:4" />&lt;&lt;Maa mo tewulɛɛbia yɛɛ be kyaarabia,</para>
  <para style="q2" vid="ISA 3:4">na bia kaa di be dɔɔ.&gt;<verse eid="ISA 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 3:5" />Balaŋ baa ŋere dɔŋa do,</para>
  <para style="q2" vid="ISA 3:5">baale waa seŋ tia baale, na dɔɔ ka seŋ tia dɔɔ.</para>
  <para style="q1" vid="ISA 3:5">Tewulɛɛ baa seŋ tia kegyiise,</para>
  <para style="q2" vid="ISA 3:5">walaŋ yakaate waa seŋ tia obuo walaŋ.<verse eid="ISA 3:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 3:6" />Baale waa lɔ kyaŋ ɔ naabu ŋolo,</para>
  <para style="q2" vid="ISA 3:6">be kya dekpaŋalaŋ man na waa yako nyiaa,</para>
  <para style="q1" vid="ISA 3:6">&lt;&lt;N dana baala kanyaŋ, nyaŋ yɛɛ de siamante,</para>
  <para style="q2" vid="ISA 3:6">na n keta de siaman wose kekyaŋ kei man.&gt;&gt;<verse eid="ISA 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 3:7" />Mɔna wee kenaŋ waa bɛɛ nyiaa,</para>
  <para style="q2" vid="ISA 3:7">&lt;&lt;Mɔɔ tale kyɔ ŋon ya,</para>
  <para style="q1" vid="ISA 3:7">Mɔɔ dana weenɛɛ yaa abɔɔ anadoŋ me dɛɛ ya,</para>
  <para style="q2" vid="ISA 3:7">mena dɔɔ ɛ naa mo maŋ yɛɛ balaŋ baŋ siamante ya.&gt;<verse eid="ISA 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 3:8" />Yerusalɛm ne kpaŋte,</para>
  <para style="q2" vid="ISA 3:8">Yuda ne yale,</para>
  <para style="q1" vid="ISA 3:8">be nɔɔwoya na ba ayɛɛsa ne tia Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 3:8">ba te yɛɛ deŋeledoŋ ɔ gyoorobiiri keŋ siaman.<verse eid="ISA 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 3:9" />Be siagbɛɛ ne di adansɛɛ tia wɔ,</para>
  <para style="q2" vid="ISA 3:9">bɛɛ lese be dukum debɔɔ ŋgba Sodomtena nɛ,</para>
  <para style="q2" vid="ISA 3:9">bɔɔ na weese ke ya.</para>
  <para style="q1" vid="ISA 3:9">Baa laako.</para>
  <para style="q2" vid="ISA 3:9">nawolo nyi be ta mo nombiikum lɔ ba wose dɔɔ.<verse eid="ISA 3:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 3:10" />Yako baŋ ba tenɛɛ nɛ nyi gyae ke de fa wɔ,</para>
  <para style="q2" vid="ISA 3:10">nawolo nyi baa di gyoŋ lee ba ayɛɛsa man.<verse eid="ISA 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 3:11" />Akpanyanyaŋtena baa laako,</para>
  <para style="q1" vid="ISA 3:11">nombiikum gyae ke yala wɔ,</para>
  <para style="q1" vid="ISA 3:11">Baa tɔ wɔ kom,</para>
  <para style="q2" vid="ISA 3:11">lee keŋ bɔɔ yɛɛ nɛ dɔɔ.<verse eid="ISA 3:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 3:12" />Tewulɛɛ ta ŋere me balaŋ do,</para>
  <para style="q2" vid="ISA 3:12">ala ne diina be dɔɔ.</para>
  <para style="q2" vid="ISA 3:12">Me balaŋ, ɛ siamantena te yele ɛ ta yo gbɛɛ,</para>
  <para style="q2" vid="ISA 3:12">bee yele ɛ ne kpase lee detɛe keŋ man.<verse eid="ISA 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="ISA 3:13" />Degbeŋgyoo te kyaa ɔ dekyae man nombia dedii man,</para>
  <para style="q2" vid="ISA 3:13">ɔ ta koro waa di balaŋ baŋ nombia.<verse eid="ISA 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 3:14" />Degbeŋgyoo te kɔŋ ɔ kaa di nombia,</para>
  <para style="q2" vid="ISA 3:14">tia ɔ balaŋ baŋ kegyiise na siamantena baŋ nyiaa,</para>
  <para style="q1" vid="ISA 3:14">&lt;&lt;Ɛmɛɛ wɔlɛɛna ma gerepo wɔɔ keŋ,</para>
  <para style="q2" vid="ISA 3:14">te ɛ kuu ayematena yooman abɔɔ wulu yaa akpaŋalaŋse,<verse eid="ISA 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 3:15" />Woŋ doŋ yaa ɛ dana te ɛ ne wuritii me balaŋ,</para>
  <para style="q2" vid="ISA 3:15">te ɛ na mo ayematena sia tiu tɛɛle?&gt;&gt;</para>
  <para style="q4" vid="ISA 3:15">Degbeŋgyoo kolosila, Degbeŋgyoo Dekpataakpere ŋon.<verse eid="ISA 3:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ISA 3:16" />Degbeŋgyoo kpa,</para>
  <para style="q2" vid="ISA 3:16">&lt;&lt;Siyɔn ala ne gate ba wose,</para>
  <para style="q1" vid="ISA 3:16">bɛɛ tɛɛ tenee be wɔŋese,</para>
  <para style="q2" vid="ISA 3:16">te bɛɛ mo be sia gyae baala,</para>
  <para style="q1" vid="ISA 3:16">be dɔŋ bee wosi ba mokɔɔse,</para>
  <para style="q2" vid="ISA 3:16">na ba doona man kegyaŋase ne wii kyakaakyakaa.<verse eid="ISA 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 3:17" />Mena dɔɔ Degbeŋgyoo waa yela gyamɛɛ kaa gyɔ Siyɔn ala nyeeya man,</para>
  <para style="q2" vid="ISA 3:17">Degbeŋgyoo waa yela ba nyeeya ke gbee kolikoli.&gt;&gt;<verse eid="ISA 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 3:18" />Mena wee kenaŋ nɛ Degbeŋgyoo waa lɛo be nawɔɔ man agbaraagbaraase na abuterese na wɔŋe man kegyaŋase, <verse eid="ISA 3:18" /><verse number="19" style="v" sid="ISA 3:19" />na asomdɛɛse na nyiŋmaa man kegyaŋase na kanyaŋbii keŋ bɛɛ mo wuu tɔ sia, <verse eid="ISA 3:19" /><verse number="20" style="v" sid="ISA 3:20" />na ala kotɔtɔɔ na kaboŋboŋ man kegyaŋase na wɔŋe man kanyaŋbii na lafenta porontiase na pɔɔlase,<verse eid="ISA 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 3:21" />na kɔɔla keŋ yele gyakaa ke dɔɔ na memɔɔ man kɔɔla,<verse eid="ISA 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 3:22" />na kegba wurikyim kpaakpaa nyiŋan na kanyaŋse na abɔsɔɔse, <verse eid="ISA 3:22" /><verse number="23" style="v" sid="ISA 3:23" />na diikuse na kegba keŋ bɔɔ mo ŋmeleŋ kpaakpaa loo na ala gyooro kotɔtɔɔ na baŋfela dɔɔ kanyaŋ.<verse eid="ISA 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 3:24" />Wɔŋ gyae kaa seŋ ofoŋ nawɔɔ man,</para>
  <para style="q2" vid="ISA 3:24">ŋmeleŋ gyae kaa seŋ keŋ ɔ na mo kpaŋ gyakaa wurikyim keŋ dɔɔ nɛ nawɔɔ man,</para>
  <para style="q1" vid="ISA 3:24">nyee kegbee gyae kaa seŋ nyeenyɔɔse burum nawɔɔ man,</para>
  <para style="q2" vid="ISA 3:24">titere gyae kaa seŋ kanyaŋ kpaakpaa nawɔɔ man,</para>
  <para style="q2" vid="ISA 3:24">desɛŋ gyae kaa seŋ ba kyeo nawɔɔ man.<verse eid="ISA 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 3:25" />N baala baa yala yoosila nɔɔman,</para>
  <para style="q2" vid="ISA 3:25">n yoonɔɔtena baa yala yoo man.<verse eid="ISA 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 3:26" />Siyɔn anaanɔɔse gyae ka toroŋ na kedi waraŋsa,</para>
  <para style="q2" vid="ISA 3:26">ke gyae ke doo yakaa na waa kyaa tɛɛle man.<verse eid="ISA 3:26" /></para>
  <chapter eid="ISA 3" />
  <chapter number="4" style="c" sid="ISA 4" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 4:1" />Wee kenaŋ ala nyetooro,</para>
  <para style="q2" vid="ISA 4:1">baa lɔ kyaŋ baale dokoloŋ,</para>
  <para style="q1" vid="ISA 4:1">na baa yako nyiaa, &lt;&lt;Daa gbagba dɛɛ kɛɛ de kedi,</para>
  <para style="q2" vid="ISA 4:1">na da abɔɔ anadoŋ man,</para>
  <para style="q1" vid="ISA 4:1">yela baa mo n yele gyakaa de dɔɔ bo,</para>
  <para style="q2" vid="ISA 4:1">na n ka lese da desɛŋ lee de dɔɔ.<verse eid="ISA 4:1" /></para>
  <para style="s1">Degbeŋgyoo wɔɔbii</para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 4:2" />Wee kenaŋ te Degbeŋgyoo wɔɔbii keŋ gyae ke yɛɛ kyeo na gyoorobiiri te tɛɛle keŋ dɔɔ daasebia gyae ke yɛɛ wose kegate na gyoorobiiri fa Iseraetena baŋ bɔɔ kaa be kyaa nɛ. <verse eid="ISA 4:2" /><verse number="3" style="v" sid="ISA 4:3" />Baa baake baŋ bɔɔ kaa Siyɔn na baŋ bɔɔ kaa Yerusalɛm nɛ nyi fereŋkyeŋ. Baŋ pou bɔɔ ŋmarase baa yela kpuna baŋ be kyaa Yerusalɛm nɛ. <verse eid="ISA 4:3" /><verse number="4" style="v" sid="ISA 4:4" />Degbeŋgyoo waa sɔ Siyɔn alo ŋon lese wa ayimɛɛ lee ɔ man, na waa mo nombia kedi feliŋ na boalaŋ feliŋ feefo fatabose ŋan be kpatee Yerusalɛm nɛ. <verse eid="ISA 4:4" /><verse number="5" style="v" sid="ISA 4:5" />Degbeŋgyoo waa yɛɛ debuŋta nyɔɔse wee na boalaŋ keŋ kɛɛ kpaa nɛ nelim wuu Siyɔn bula pou na baŋ pou bɔɔ yilaa nɛ. Ɔ gyoorobiiri gyae ke yɛɛ kefɛɛ wuu kpene kamasɛ. <verse eid="ISA 4:5" /><verse number="6" style="v" sid="ISA 4:6" />Ke gyae ke yɛɛ kefɛɛ na wuluŋ lee weese kenyakee man, na botɔɔ keŋ baa yeu kagyoo na dayoe lee feliŋ dinaa na ɔga man.<verse eid="ISA 4:6" /></para>
  <chapter eid="ISA 4" />
  <chapter number="5" style="c" sid="ISA 5" />
  <para style="s1">Gerepo wɔɔ keŋ wose man nɔɔneŋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 5:1" />Maa kpee nɔɔneŋ fa ŋon mɛɛ gyae nɛ,</para>
  <para style="q2" vid="ISA 5:1">ɔ gerepo wɔɔ keŋ man nɔɔneŋ.</para>
  <para style="q1" vid="ISA 5:1">Ŋon mɛɛ gyae nɛ dana gerepo wɔɔ,</para>
  <para style="q2" vid="ISA 5:1">bulabii tɛɛle kpaakpaa dɔɔ.<verse eid="ISA 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 5:2" />Ɔ pupui ke lese ka boya,</para>
  <para style="q2" vid="ISA 5:2">te ɔ duu gerepo kpaakpaa,</para>
  <para style="q1" vid="ISA 5:2">ɔ baŋa degyee dekagya ke man,</para>
  <para style="q2" vid="ISA 5:2">te ɔ wula botɔɔ keŋ bɛɛ ŋmaase gerepo mɔ,</para>
  <para style="q1" vid="ISA 5:2">na ɔ ne daa nyi ŋe gyae ka se gerepo bia kpaakpaa,</para>
  <para style="q2" vid="ISA 5:2">mɔna ŋa see bia awɔlɛɛsa bo.<verse eid="ISA 5:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 5:3" />&lt;&lt;Nɛnɛɛ ɛmɛɛ baŋ ɛ kyaa Yerusalɛm na Yuda,</para>
  <para style="q2" vid="ISA 5:3">ɛ di daa na me gerepo wɔɔ nombia fa daa.<verse eid="ISA 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 5:4" />Woŋ te kaboena nyi maa yɛɛ fa me gerepo wɔɔ</para>
  <para style="q2" vid="ISA 5:4">te ma te yɛɛ ya?</para>
  <para style="q1" vid="ISA 5:4">Weera dɔɔ te mɛɛ kɛɛ nyi maa nyiŋ gerepo kpaakpaa</para>
  <para style="q2" vid="ISA 5:4">te ŋa see bia awɔlɛɛsa bo?<verse eid="ISA 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 5:5" />Nɛnɛɛ maa yako ŋon,</para>
  <para style="q2" vid="ISA 5:5">keŋ maa yɛɛ me gerepo wɔɔ keŋ.</para>
  <para style="q1" vid="ISA 5:5">Maa lese keŋ mɔɔ mo gyee ke nɛ,</para>
  <para style="q2" vid="ISA 5:5">na maa wɔlɛɛ ke.</para>
  <para style="q1" vid="ISA 5:5">Maa tekerii ka dekyaŋ,</para>
  <para style="q2" vid="ISA 5:5">na baa sakatee ke<verse eid="ISA 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 5:6" />Maa yela ke ka bese depampaa,</para>
  <para style="q2" vid="ISA 5:6">keŋ ba te kpaase yaa fara ke ya,</para>
  <para style="q2" vid="ISA 5:6">te kpalamse na kpaŋkpaŋkorolose gyae ke tu ke man.</para>
  <para style="q1" vid="ISA 5:6">Maa tɔ ŋɔma gbɛɛ,</para>
  <para style="q2" vid="ISA 5:6">keŋ be yele ɔga ke ŋɛɛ woli ke ya.&gt;&gt;<verse eid="ISA 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 5:7" />Degbeŋgyoo Dekpataakpere gerepo wɔɔ,</para>
  <para style="q2" vid="ISA 5:7">yɛna Iserae tɛɛle keŋ,</para>
  <para style="q1" vid="ISA 5:7">te Yudatena mɔ yɛna gerepo keŋ ɔ ne gyae beiŋ,</para>
  <para style="q1" vid="ISA 5:7">ɔ ne kɛɛ nyi baa di nombia na kegbɛɛ mɔna balaŋ te bɛɛ koe.</para>
  <para style="q2" vid="ISA 5:7">Ɔ ne kɛo katenee mɔna waraŋase kewii te ɔ ne nyii.<verse eid="ISA 5:7" /></para>
  <para style="s1">Kayeyɛɛ na nombia kedi</para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 5:8" />Ɛmɛɛ baŋ ɛ dana akpaŋalaŋse te ɛ na peree ŋaale kpu,</para>
  <para style="q2" vid="ISA 5:8">te ɛ na peree tɛɛlese kpu ɛ tɛɛlese man,</para>
  <para style="q1" vid="ISA 5:8">kelii debaŋ keŋ ŋa be taŋ,</para>
  <para style="q2" vid="ISA 5:8">te ɛmɛɛ yaageŋ kyaala tɛɛle kei dɔɔ nɛ, ɛ laako.<verse eid="ISA 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 5:9" />Me nyiiwɔ Degbeŋgyoo Dekpataakpere ŋon torowɔ yako nyiaa,</para>
  <para style="q1" vid="ISA 5:9">&lt;&lt;Ampaŋ, akpaŋalaŋse dinaana ŋan gyae kaa yɛlɛɛ,</para>
  <para style="q2" vid="ISA 5:9">denɛɛ dinaana kyeokyeo ŋan gyae ke doo keŋ balaŋ be kyaa ŋe man ya.<verse eid="ISA 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 5:10" />Baa nyiŋ waen ogelese looro bo lee gerepo wɔɔ ŋmeeseŋ sɔŋonaara na kufu (10) man,</para>
  <para style="q2" vid="ISA 5:10">te ɛ duu bia burum na, ɛ ke kɔ kyomii bo.<verse eid="ISA 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 5:11" />Baŋ bɛɛ karatɛɛ nebo nebo,</para>
  <para style="q2" vid="ISA 5:11">te be silana soloŋ gbɛɛ,</para>
  <para style="q1" vid="ISA 5:11">te bɛɛ nyɔɔ menɛɛ dɛɛse,</para>
  <para style="q2" vid="ISA 5:11">kelii nelim kyeeŋ nɛ baa laako.<verse eid="ISA 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 5:12" />Nɔɔkedi tɛɛ na be dana Adolɛɛse na akyakaase,</para>
  <para style="q2" vid="ISA 5:12">na kefereese na akyakaase na waen,</para>
  <para style="q1" vid="ISA 5:12">mɔna bɔɔ na mo Degbeŋgyoo aneyɛŋ yɛɛ kolo,</para>
  <para style="q2" vid="ISA 5:12">yaa baa mo obuo fa ɔ nyiŋmaa man tom ya.<verse eid="ISA 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 5:13" />Mena dɔɔ baa kyaŋ me balaŋ ŋgba yoogbeŋa nɛ,</para>
  <para style="q2" vid="ISA 5:13">lee keŋ bɔɔ ne nyii nombia man ya dɔɔ,</para>
  <para style="q1" vid="ISA 5:13">tanam gyae ka koe baŋ be dana obuo nɛ,</para>
  <para style="q2" vid="ISA 5:13">na loŋboaneŋ mɔ ka ko be balaŋ yakaa nyibaŋ.<verse eid="ISA 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 5:14" />Mena dɔɔ woyadɛɛ te fɛlɛɛ ɔ nɔɔ,</para>
  <para style="q2" vid="ISA 5:14">te ɔ wola ɔ nɔɔ foo,</para>
  <para style="q1" vid="ISA 5:14">Yerusalɛm gyoorobia na ke balaŋ burum,</para>
  <para style="q2" vid="ISA 5:14">kpuna be yeesa na ba akelelee baa tisi gyoo ke man.<verse eid="ISA 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 5:15" />Mena dɔɔ baa kɔna balaŋ tɛɛle man,</para>
  <para style="q2" vid="ISA 5:15">na baa yɔkɔse ɔkamasɛ,</para>
  <para style="q2" vid="ISA 5:15">na baa yɔkɔse agaŋtaŋtena.<verse eid="ISA 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 5:16" />Mɔna baa gyina Degbeŋgyoo Dekpataakpere adido lee ɔ nombia kedina kegbɛɛ dɔɔ.</para>
  <para style="q2" vid="ISA 5:16">Baa lese wola nyi Wurubuarɛ Fereŋkyeŋte ŋon yɛɛ fereŋkyeŋ lee waa ayɛɛsa ŋan tenɛɛ nɛ man.<verse eid="ISA 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 5:17" />Namense baa dii botɔɔ ŋgba be deedii gbagba nɛ,</para>
  <para style="q2" vid="ISA 5:17">namense bia baa dii kɔbatena donɔɔse ŋan be yɛlɛɛ nɛ man.<verse eid="ISA 5:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ISA 5:18" />Baŋ bɔɔ mo dekara ŋmeleŋ kpaŋna dukum bɛɛ wɔm,</para>
  <para style="q2" vid="ISA 5:18">te bɔɔ mo anebiliŋiŋ ŋmeleŋ kpaŋna akpanyanyaŋ bɛɛ wɔm nɛ baa laako.<verse eid="ISA 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 5:19" />Baŋ bɛɛ yako nyi, &lt;&lt;Yela Wurubuarɛ ke yɛɛ ɔsaa,</para>
  <para style="q2" vid="ISA 5:19">yela e waa yɛɛ ɔ tom bileŋ,</para>
  <para style="q2" vid="ISA 5:19">na dɛɛ naa.</para>
  <para style="q1" vid="ISA 5:19">Yela Iserae fereŋkyeŋte ŋon nyeeman nombia,</para>
  <para style="q2" vid="ISA 5:19">ka benaa, yela ke ka lee debɔɔ,</para>
  <para style="q2" vid="ISA 5:19">na dee nyiŋ gyeŋ ke.&gt;&gt;<verse eid="ISA 5:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ISA 5:20" />Baŋ bɛɛ baake dukum nyi kpaakpaa,</para>
  <para style="q2" vid="ISA 5:20">te kpaakpaa nyi dukum,</para>
  <para style="q1" vid="ISA 5:20">te bɛɛ mo detiŋtɛɛ see keŋmaŋee nae man,</para>
  <para style="q2" vid="ISA 5:20">na keŋmaŋee fa detiŋtɛɛ,</para>
  <para style="q1" vid="ISA 5:20">te bɛɛ mo ŋan see fa gyoŋ,</para>
  <para style="q2" vid="ISA 5:20">na gyoŋ fa ŋan nɛ, baa laako.<verse eid="ISA 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="ISA 5:21" />Baŋ bɛɛ kɛɛ nyi be sia te kare,</para>
  <para style="q2" vid="ISA 5:21">te bɛɛ kɛɛ nyi ba gyeŋ nombia nɛ, baa laako.<verse eid="ISA 5:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="ISA 5:22" />Baŋ bɛɛ yɛɛ baalabiiri waen kenyɔɔ beiŋ man,</para>
  <para style="q2" vid="ISA 5:22">na baŋ bɔɔ lɛɛ yele soloŋ ke kyakale man nɛ, baa laako.<verse eid="ISA 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 5:23" />Bɛɛ yoo lɛɛ kolo na be ta mo deŋele kedi fa ŋon ɔ nombia be dei ya,</para>
  <para style="q2" vid="ISA 5:23">na be ta ŋere ŋon ɔ nombia dei nɛ do.<verse eid="ISA 5:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 5:24" />Mena dɔɔ ŋgba mena keŋ boalaŋ laakem ne kpa kaase,</para>
  <para style="q2" vid="ISA 5:24">na boalaŋ degyapaa te kpa ŋalese awolɛɛ dugudugu nɛ,</para>
  <para style="q2" vid="ISA 5:24">mena te ŋe lila gyae ke dala,</para>
  <para style="q2" vid="ISA 5:24">te feliŋ gyae ke gyɔ ŋa kyeŋkyeŋkɔɔse laŋ ŋgba akuŋkuŋ nɛ,</para>
  <para style="q1" vid="ISA 5:24">nawolo nyi ba te bɛɛ Degbeŋgyoo Dekpataakpere ŋon mmaraa,</para>
  <para style="q2" vid="ISA 5:24">te be bɛɛ Iserae Fereŋkyeŋte ŋon nombia.<verse eid="ISA 5:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 5:25" />Mena dɔɔ Degbeŋgyoo ta gyeŋ baŋ ɔ balaŋ dɔɔ,</para>
  <para style="q2" vid="ISA 5:25">ɔ te gyina ɔ nyiŋmaa te ɔ gyɔɔ wɔ lɔ.</para>
  <para style="q1" vid="ISA 5:25">Bulase wosiwɔ,</para>
  <para style="q2" vid="ISA 5:25">na woya doo ŋgba woŋsila doola abɔntere man nɛ.</para>
  <para style="b" vid="ISA 5:25" />
  <para style="q1" vid="ISA 5:25">Kɛŋa pou wɔle nɛ, ɔ te tinaata ɔ baŋ yela ya,</para>
  <para style="q2" vid="ISA 5:25">ɔ nyiŋmaa sɛɛ doo adido.<verse eid="ISA 5:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="ISA 5:26" />Waa gyina felage adido fa tɛɛlese ŋan kyaa lemlem,</para>
  <para style="q2" vid="ISA 5:26">ɔ wola weele baake baŋ be kyaa tɛɛle ɔto nɛ.</para>
  <para style="q1" vid="ISA 5:26">Kɛɛ be ta mo ɔsaa na kebarase</para>
  <para style="q2" vid="ISA 5:26">bɛɛ kɔŋ.<verse eid="ISA 5:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 5:27" />Be man ŋolo te kaa yaa waa sarakee ya,</para>
  <para style="q2" vid="ISA 5:27">ŋolo te deŋeli yaa waa doo ya.</para>
  <para style="q1" vid="ISA 5:27">ŋolo bɛlɛte te booli ɔ teŋa man ya,</para>
  <para style="q2" vid="ISA 5:27">te ŋolo nkyokota ŋmeleŋ te tiri ya.<verse eid="ISA 5:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 5:28" />Be baŋdaŋ nyeela na bee,</para>
  <para style="q2" vid="ISA 5:28">te ba te desina be baŋdaŋse.</para>
  <para style="q1" vid="ISA 5:28">Be dɛɛkyɔŋse awɔkatese wɔɛ ŋgba boe keŋ kɛɛ bee nɛ.</para>
  <para style="q2" vid="ISA 5:28">be yookɔta naawɔɔ yɛɛ ŋgba koloŋoloŋ nɛ.<verse eid="ISA 5:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 5:29" />Be kemuusu yɛɛ ŋgba dinaate wui nɛ,</para>
  <para style="q2" vid="ISA 5:29">bee muusu ŋgba dinaate bia nɛ,</para>
  <para style="q1" vid="ISA 5:29">bee muusu ke kyaŋ wonembu,</para>
  <para style="q1" vid="ISA 5:29">na be ta mo e laŋ keŋ ŋolo be tale lɛɛ e ya.<verse eid="ISA 5:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 5:30" />Mena wee kenaŋ nɛ, baa muusu woli ke,</para>
  <para style="q2" vid="ISA 5:30">ŋgba mena keŋ ɛpo ne muusu nɛ.</para>
  <para style="q1" vid="ISA 5:30">Nyi ŋolo de kɛɛ tɛɛle dɔɔ nɛ,</para>
  <para style="q2" vid="ISA 5:30">detiŋtɛɛ na kayeyɛɛ kaageŋ te waa naa,</para>
  <para style="q2" vid="ISA 5:30">debuŋta gyae ke yela weese ka gyoo detiŋtɛɛ.<verse eid="ISA 5:30" /></para>
  <chapter eid="ISA 5" />
  <chapter number="6" style="c" sid="ISA 6" />
  <para style="s1">Wurubuarɛ kalese Yesaya</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 6:1" />Kulutoo keŋ man gyoo Usiya ba yem nɛ, me naa Degbeŋgyoo na ɔ kyaa gyoorogbeli dinaa keŋ ka korɛɛ nɛ dɔɔ, te ɔ kegba wurikyim nɔɔse wuu ɔsom deni dinaa keŋ pou man. <verse eid="ISA 6:1" /><verse number="2" style="v" sid="ISA 6:2" />Serafimese seŋɛɛ ɔ gyaŋ, te be man ɔkamasɛ dana beŋkelɛɛ looro. Ba moo beŋkelɛɛ ala wuu be sia, te ba moo ala mɔ wuu be nawɔɔ, te ba moo ala bee furufu. <verse eid="ISA 6:2" /><verse number="3" style="v" sid="ISA 6:3" />Na bɛɛ bake dɔŋa nyiaa,</para>
  <para style="q1" vid="ISA 6:3">&lt;&lt;Fereŋkyeŋ, Fereŋkyeŋ, Fereŋkyeŋ yɛna Degbeŋgyoo Dekpataakpere ŋon,</para>
  <para style="q2" vid="ISA 6:3">ɔ gyoorobiiri te wuu tɛɛle pou.&gt;&gt;<verse eid="ISA 6:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="ISA 6:4" />Be yeesa yela anaanɔɔ daase na deni keŋ mokɔɔ wosiwɔ, te nyɔɔse wulu ɔsom deni dinaa keŋ pou. <verse eid="ISA 6:4" /><verse number="5" style="v" sid="ISA 6:5" />Te me yakowɔ nyiaa, &lt;&lt;Maa laako! Mɔ ɔto yaa! Nawolo nyi me nɔɔwoya pou yɛɛ dukum, te daa na baŋ be nɔɔwoya yɛɛ dukum nɛ kyaala debodokoloŋ, mɔna ma te naa gyoo ŋon, Degbeŋgyoo Dekpataakpere ŋon na me sia.&gt;&gt;<verse eid="ISA 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 6:6" />Te Serafimese baŋ man ŋolo furufuwɔ kɔŋ me gyaŋ na ɔ telana boalaŋ na nyewalaŋ keŋ ɔ ba mo gbɛŋgbɛŋ lese lee kedeesaboe keŋ man nɛ. <verse eid="ISA 6:6" /><verse number="7" style="v" sid="ISA 6:7" />Ɔ moo ke tina me nɔɔ te ɔ yakowɔ nyi, &lt;&lt;Kɛɛ, kei te tina n nɔɔ, be ta lese n fɔɔkedi te be tɔɔ n dukum kom.&gt;&gt;<verse eid="ISA 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 6:8" />Botɔɔ te me nyii Degbeŋgyoo woya nyiaa, &lt;&lt;Amɔte yaa maa kpila? Te amɔte ne gyae laa waa gyu fa daa?&gt;&gt;</para>
  <para style="p" vid="ISA 6:8">Te me yakowɔ nyiaa, &lt;&lt;Maŋ yaa. Kpila maŋ.&gt;&gt;<verse eid="ISA 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 6:9" />Ɔ yakowɔ nyi &lt;&lt;Gyu ke yako balaŋ kɛo nyiaa,</para>
  <para style="q1" vid="ISA 6:9">&lt;&lt;&lt;Kenyii dɔɔ ɛ ke nyii, mɔna ɛ be gyae ɛ ke nyii ke man ya.</para>
  <para style="q2" vid="ISA 6:9">kekɛɛ na ɛ ke kɛɛ, mɔna ɛ be gyae ɛ ke naa ke man nideli ya.<verse eid="ISA 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 6:10" />Yela balaŋ kɛwɔ konɔɔse keyɛɛ doŋ</para>
  <para style="q2" vid="ISA 6:10">yela ba deŋela ke yɛɛ wɔ gbirim</para>
  <para style="q2" vid="ISA 6:10">na n ke yela be sia ke yɛɛ wɔ tuum.</para>
  <para style="q1" vid="ISA 6:10">Na mena ya na baa mo be sia naa,</para>
  <para style="q2" vid="ISA 6:10">na baa mo ba deŋela nyii,</para>
  <para style="q2" vid="ISA 6:10">na baa mo be konɔɔ nyii ke man,</para>
  <para style="q1" vid="ISA 6:10">na baa kyɛɛkee na maa kyɔ wɔ.&gt;&gt;<verse eid="ISA 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 6:11" />Te me bɔɔsewɔ nyiaa, &lt;&lt;Degbeŋgyoo kelii debaŋ woŋti?&gt;&gt;</para>
  <para style="p" vid="ISA 6:11">Te ɔ tiranɔɔ nyiaa,</para>
  <para style="q1" vid="ISA 6:11">&lt;&lt;Kelii debaŋ keŋ donɔɔ dinaa keŋ be yɛlɛɛ</para>
  <para style="q2" vid="ISA 6:11">te ŋolo be kyaa ke man ya,</para>
  <para style="q1" vid="ISA 6:11">kelii debaŋ keŋ ŋolo be kyaa denɛɛ ŋan man ya</para>
  <para style="q2" vid="ISA 6:11">te be wɔɔse be wɔlɛɛ te ŋɔɔ bese awulaa.<verse eid="ISA 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 6:12" />Kelii debaŋ keŋ Degbeŋgyoo be gegi ɔkamasɛ gyu lemlem,</para>
  <para style="q2" vid="ISA 6:12">te bɔɔ wɔlɛɛ tɛɛle keŋ korakora.<verse eid="ISA 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 6:13" />Nyi kufu man dokoloŋ de kaa tɛɛle keŋ man koraŋ na,</para>
  <para style="q2" vid="ISA 6:13">ke gyae ke doo bo wɔlɛɛ,</para>
  <para style="q1" vid="ISA 6:13">ŋgba mena keŋ be tuŋ odum na kpeli daŋ</para>
  <para style="q2" vid="ISA 6:13">te ka mokɔɔ keŋ ne kaa tɛɛle man nɛ,</para>
  <para style="q2" vid="ISA 6:13">mena te daŋbii fereŋkyeŋ keŋ mɔ gyae ke yɛɛ mokɔɔ tɛɛle dɔɔ.&gt;&gt;<verse eid="ISA 6:13" /></para>
  <chapter eid="ISA 6" />
  <chapter number="7" style="c" sid="ISA 7" />
  <para style="s1">Imanuɛle kolo kalesewola</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 7:1" />Debaŋ keŋ Usiya bu Yotame bu Ahase ne di gyoori Yuda nɛ, Aram gyoo Resin na Remaliya bu Iserae gyoo Peka, gyuuwɔ ke yoo Yerusalɛm, mɔna ba te tale yoodi ke dɔɔ ya.<verse eid="ISA 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 7:2" />Ba ke yako Dawide dekpaŋalaŋmantena nyiaa, Aram te gyu ke yɛɛ nɔɔ na Ɛferayim, ke wosi Ahase na ɔ balaŋ konɔɔse ŋgba mena keŋ feliŋ ne wosi daase laa man nɛ.<verse eid="ISA 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 7:3" />Keŋte Degbeŋgyoo yako Yesaya nyiaa, &lt;&lt;Ɛmɛɛ na n bu Sɛare Yasube ɛ lee gyu ke gyaŋeena gyoo Ahase adoyenaŋ depaa keŋ ɔto, gbɛɛ keŋ ne gyu kanyaŋ faafore ŋon wɔɔ man nɛ. <verse eid="ISA 7:3" /><verse number="4" style="v" sid="ISA 7:4" />Yako e nyiaa, &lt;Kɛɛ nideli, n wɔe dɛɛ fɛɛ neŋ, te naa yee ya. Naa yele Resin na Aram na Remaliya bu baŋ kum keŋ ke lɔ neŋ n wɔe ya, nawolo nyi be bala yɛɛ ŋgba daakpee keŋ be kpaa taŋ nɛ nyɔɔse. <verse eid="ISA 7:4" /><verse number="5" style="v" sid="ISA 7:5" />Aram na Ɛferayim na Remaliya bu te bake n nyee man nyi baa wɔlɛɛ nyiaa, <verse eid="ISA 7:5" /><verse number="6" style="v" sid="ISA 7:6" />&lt;&lt;Ɛ yela de kaa yoo Yuda, ɛ yela de kaa naase e diyem, na dɛɛ mo ke kpala fa da wose na dee yela Tabeele bu kedi gyoori botɔɔ.&gt;&gt; <verse eid="ISA 7:6" /><verse number="7" style="v" sid="ISA 7:7" />Mɔna nnɛ yaa Degbeŋgyoo Doŋte Pou Nyee ne yako,</para>
  <para style="q1" vid="ISA 7:7">&lt;&lt;Ka be gyae ke yɛɛ mena ya,</para>
  <para style="q2" vid="ISA 7:7">ka be gyae ke kɔŋ mena ya,<verse eid="ISA 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 7:8" />nawolo nyi Aram nyee yɛna Damasekuse,</para>
  <para style="q2" vid="ISA 7:8">te Damasekɔse mɔ nyee yɛna Resin waageŋ.</para>
  <para style="q1" vid="ISA 7:8">Kulutooneŋ sɔŋotooro na anoŋ man nɛ,</para>
  <para style="q2" vid="ISA 7:8">baa wɔlɛɛ Ɛferayim korakora keŋ nyi balaŋ be gyae baa kyaa bela ya.<verse eid="ISA 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 7:9" />Ɛferayim nyee yɛna Samariya,</para>
  <para style="q2" vid="ISA 7:9">te Samaria mɔ nyee yɛna Remaliya bu waageŋ.</para>
  <para style="q1" vid="ISA 7:9">nyi ɛ ta sem ɛ kelɛɛdi man keŋkeŋ ya na,</para>
  <para style="q2" vid="ISA 7:9">ɛ be gyae ɛ ka seŋ korakora ya.&gt;&gt;&gt;<verse eid="ISA 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 7:10" />Degbeŋgyoo besewɔ kolosina Ahase nyiaa, <verse eid="ISA 7:10" /><verse number="11" style="v" sid="ISA 7:11" />&lt;&lt;Bɔɔse Degbeŋgyoo n Wurubuarɛ na waa yɛɛ kolo wola neŋ, lee woya dɛɛ kyilimkyilim yaa lee adido adido.&gt;&gt;<verse eid="ISA 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 7:12" />Mɔna Ahase yakowɔ nyiaa, &lt;&lt;Mɔɔ gyae maa bɔɔse ya, mɔɔ gyae maa kɛɛse Degbeŋgyoo kɛɛ ya.&gt;&gt;<verse eid="ISA 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 7:13" />Keŋte Yesaya yakowɔ nyiaa, &lt;Ɛmɛɛ Dawide dekpaŋalaŋmantena, nɛnɛɛ ɛ nyii maŋ, Diyem keŋ ɛ ne naase deniwalaŋ nɛ te kaboena ŋon yee? Ɛ ke naase me Wurubuarɛ mɔ diyem? <verse eid="ISA 7:13" /><verse number="14" style="v" sid="ISA 7:14" />Mena dɔɔ Degbeŋgyoo gbagba waa lese kolo wola ŋon. Alebu keteŋ waa kyaŋ fulu na waa lola bu baale, na baa bake e nyi Imanuɛle<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="ft" closed="false">Wurubuarɛ kpuɛna daa.</char></note> <verse eid="ISA 7:14" /><verse number="15" style="v" sid="ISA 7:15" />Miliki na teebɔɔ te waa di, kelii debaŋ keŋ waa gyeŋ dukum na waa bɛɛ ke, na waa lese debam, <verse eid="ISA 7:15" /><verse number="16" style="v" sid="ISA 7:16" />pɛ waa gyeŋ dukum kebɛɛ na waa lese debam na gyooneŋ bala baŋ ɛ ne yee nɛ tɛɛlese gyae ke wɔlɛɛ. <verse eid="ISA 7:16" /><verse number="17" style="v" sid="ISA 7:17" />Degbeŋgyoo waa yela kayeyɛɛ ke yala ɛmɛɛ na n balaŋ na n kya dekpaŋalaŋmantena. Weeya ŋenaŋ te kɔŋata see pɛnpɛŋ ya lee debaŋ keŋ Ɛferayim be kpase lee Yuda man, waa mo Asiriya gyoo kɔŋ ɛ dɔɔ.&gt;&gt;<verse eid="ISA 7:17" /></para>
  <para style="s1">Degbeŋgyoo waa mo Asiriya gyoo yɛɛ tom</para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 7:18" />Wee kenaŋ Degbeŋgyoo waa wola weele baake kyɔɔse lee Igyipite, na teebɔɔbiise lee Asiriya tɛɛle man. <verse eid="ISA 7:18" /><verse number="19" style="v" sid="ISA 7:19" />Baa kɔŋ kaa kyakee detaŋgyase na boya bɔɔneŋ na sɔɔse na wonembia dedii man. <verse eid="ISA 7:19" /><verse number="20" style="v" sid="ISA 7:20" />Mena wee kenaŋ nɛ Degbeŋgyoo waa bɔ ŋon ɔ ne tisi nyeeya nɛ paa lee Eferate boo keŋ wɔle, ŋon yɛna Asiriya gyoo na waa tisi ɛ nyeeya na ɛ nɔɔfatase na ɛ wose man wona pou. <verse eid="ISA 7:20" /><verse number="21" style="v" sid="ISA 7:21" />Wee kenaŋ walaŋ waa kɛɛle nunkyuebu, na namense bala bo. <verse eid="ISA 7:21" /><verse number="22" style="v" sid="ISA 7:22" />Keŋ baa nyiŋ miliki burum lee be man dɔɔ, baa nyiŋ miliki keŋ be kem nɛ di. Baŋ pou bɔɔ kaa tɛɛle keŋ man baa nyiŋ miliki keŋ be kem na teebɔɔ di. <verse eid="ISA 7:22" /><verse number="23" style="v" sid="ISA 7:23" />Mena wee kenaŋ nɛ, botɔɔse ŋan gerepose kakpoŋ (1,000) gyae ka lee koya kɔba wolombia kakpoŋ (1,000) nɛ, kpalamse na kpaŋkpaŋkorolose ne gyaela ke tu botɔɔ. <verse eid="ISA 7:23" /><verse number="24" style="v" sid="ISA 7:24" />Bakpaŋna baa mo baŋdaŋ na nyeela gyu botɔɔ, nawolo nyi kpaŋkpaŋkorolose na kpalamse te wuu tɛɛle keŋ dɔɔ. <verse eid="ISA 7:24" /><verse number="25" style="v" sid="ISA 7:25" />Bulasebia ŋan pou nafɔ bɔɔ fare ŋe dɔɔ na fare nɛ dɔɔ ŋolo be gyae waa gyu botɔɔ na kpaŋkpaŋkorolose na sɔɔse ŋan ka do e gyakoloŋ ya, ŋe gyae ka bese botɔɔse ŋan baa mo nunkyuese na namense gyu dedii.<verse eid="ISA 7:25" /></para>
  <chapter eid="ISA 7" />
  <chapter number="8" style="c" sid="ISA 8" />
  <para style="s">Yesaya na ɔ bia yɛna kolo kawola</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 8:1" />Degbeŋgyoo yako maŋ nyiaa, &lt;&lt;Mo tɔne dinaa na n ka mo pɛne ŋmarase ke dɔɔ nyiaa, yoo abɔɔ kuure, yɛɛ ɔsaa, abɔɔ ŋmaare barase. <verse eid="ISA 8:1" /><verse number="2" style="v" sid="ISA 8:2" />Mena dɔɔ me baake sae Uriya, na Yebɛrɛkeya bu Sakariya nyi be kaa di adansɛɛ fa maŋ.&gt;&gt;<verse eid="ISA 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 8:3" />Keŋte daana Wurubuarɛ gbalare alo ŋon doowɔ, te ɔ kyaŋa fulu te ɔ lola bu baale. Te Degbeŋgyoo yako maŋ nyiaa, &lt;&lt;Do e yele nyi Yooman abɔɔ kuure, yɛɛ ɔsaa, abɔɔ ŋmaare, barase. <verse eid="ISA 8:3" /><verse number="4" style="v" sid="ISA 8:4" />Nawolo nyi pɛ bu ŋon waa gyeŋ &lt;Taata&gt; yaa &lt;Nna&gt; kebaake nɛ, Asiriya gyoo waa kaa kuu Damasekuse agyapadɛɛse na Samariya yooman abɔɔ pou mo laŋ.<verse eid="ISA 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 8:5" />Degbeŋgyoo besewɔ kolosina maŋ nyiaa,<verse eid="ISA 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 8:6" />&lt;&lt;Keŋ balaŋ kɛwɔ be bɛɛ,</para>
  <para style="q2" vid="ISA 8:6">Siloa loŋ keŋ kɛɛ lam dɛɛdɛɛ,</para>
  <para style="q1" vid="ISA 8:6">te bɛɛ nyaŋee lee Resin</para>
  <para style="q" vid="ISA 8:6">na Remaliya bu dɔɔ nɛ,<verse eid="ISA 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 8:7" />kɛɛ, Degbeŋgyoo waa mo</para>
  <para style="q2" vid="ISA 8:7">Asiriya gyoo na ɔ yoonɔɔtena kaa wuu be dɔɔ.</para>
  <para style="q2" vid="ISA 8:7">baa wuu wɔ ŋgba Eferatese boo wuula nɛ.</para>
  <para style="q1" vid="ISA 8:7">Ke gyae ke waale</para>
  <para style="q2" vid="ISA 8:7">gbaa ke diŋgyiŋ, <verse eid="ISA 8:7" /><verse number="8" style="v" sid="ISA 8:8" />na ka ke waale kelii Yuda, yere gbaa ke</para>
  <para style="q2" vid="ISA 8:8">mo kelii ke wɔŋe man,</para>
  <para style="q1" vid="ISA 8:8">te ke beŋkelɛɛ gyae ke fɛlɛɛ wuu ɛ tɛɛle ɔto,</para>
  <para style="q2" vid="ISA 8:8">Ao! Imanuɛle.&gt;&gt;&gt;<verse eid="ISA 8:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 8:9" />Ɛmɛɛ tɛɛlese, ɛ mo yoo yeesa gyaŋee, mɔna gyakoloŋ gyae ka gyoo ŋon,</para>
  <para style="q2" vid="ISA 8:9">Ɛmɛɛ baŋ pou ɛ kyaana lem nɛ, ɛ tei.</para>
  <para style="q1" vid="ISA 8:9">Ɛ desina ɛ wose fa yoo, mɔna gyakoloŋ gyae ka gyoo ŋon!</para>
  <para style="q2" vid="ISA 8:9">Ɛ desina ɛ wose fa yoo, mɔna gyakoloŋ gyae ka gyoo ŋon!<verse eid="ISA 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 8:10" />Ɛ bake kolo ɛ nyeeman, mɔna be gyae ke de ya,</para>
  <para style="q2" vid="ISA 8:10">Ɛ yako nombia sɛɛ dɔŋa, mɔna gyae ke yɛɛ yakaa,</para>
  <para style="q2" vid="ISA 8:10">nawolo nyi Wurubuarɛ kpuɛna daa. (Imanuɛle)<verse eid="ISA 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 8:11" />Degbeŋgyoo ka mo ɔ nyiŋmaa doŋte gyakaa me dɔɔ nɛ, ɔ faree maŋ nideli nyi me naa sila balaŋ kɛɔ dinɔɔ ya.<verse eid="ISA 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 8:12" />&lt;&lt;Ɛ naa lɛɛ nyeeman kebake</para>
  <para style="q2" vid="ISA 8:12">kamasɛ keŋ balaŋ kɛɔ ne baake nyi nyeeman kebake nɛ do ya,</para>
  <para style="q1" vid="ISA 8:12">Ɛ naa yee keŋ bee yee nɛ ya,</para>
  <para style="q2" vid="ISA 8:12">te ɛ naa yele ke ka do ŋon gyakoloŋ ya.<verse eid="ISA 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 8:13" />Degbeŋgyoo Dekpataakpere ŋon te kaboena nyi yaa kɛɛ nyi ɔ yɛɛ fereŋkyeŋ,</para>
  <para style="q2" vid="ISA 8:13">ŋon te kaboena nyi yaa yee,</para>
  <para style="q2" vid="ISA 8:13">ŋon te kaboena nyi ɛ wɔe dɛɛ lɔ ŋon.<verse eid="ISA 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 8:14" />Waa yɛɛ dekyae fereŋkyeŋ,</para>
  <para style="q2" vid="ISA 8:14">fa Iserae na Yuda,</para>
  <para style="q1" vid="ISA 8:14">boe keŋ ne yele balaŋ ne gyɔ nae,</para>
  <para style="q2" vid="ISA 8:14">na kpanaŋ keŋ ne yele balaŋ ne yale.</para>
  <para style="q1" vid="ISA 8:14">Waa yɛɛ kɔta na dekpakalaa fa</para>
  <para style="q2" vid="ISA 8:14">Yerusalɛmtena.<verse eid="ISA 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 8:15" />Be man burum baa gyɔ be nae,</para>
  <para style="q2" vid="ISA 8:15">baa yala tekerii,</para>
  <para style="q2" vid="ISA 8:15">baa nyɔɔ wɔ kɔtase na baa kyaŋ wɔ.&gt;&gt;<verse eid="ISA 8:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ISA 8:16" />Bake kefaree adansɛɛ kei,</para>
  <para style="q2" vid="ISA 8:16">tɔ Wurubuarɛ nombii kawola kei nɔɔ me kaseela man.<verse eid="ISA 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 8:17" />Maa daa Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 8:17">ŋon ɔ ba mo ɔ sia weese Yakɔbe duuluŋmantena nɛ.</para>
  <para style="q1" vid="ISA 8:17">Maa mo ma wose lɔ ɔ dɔɔ.<verse eid="ISA 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 8:18" />Kɛɛ, daa na bia baŋ Degbeŋgyoo be fa maŋ nɛ yaa. Daa yɛna kagyene, na keŋ seŋɛɛ fa Iserae lee Degbeŋgyoo Dekpataakpere ŋon ɔ kyaa Siyɔn bula dɔɔ nɛ gyaŋ.<verse eid="ISA 8:18" /></para>
  <para style="s1">Detiŋtɛɛ ta bese keŋmaŋee</para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 8:19" />Nyi ŋolo de yako ŋon nyi yaa gyu gbalara na ŋmeeseŋtena baŋ bee kolosi adadawoya man te bɛɛ lɔkɔtee nɛ gyaŋ ke bɔɔse na, tekaboena nyi yaa gyu Wurubuarɛ gyaŋ ke bɔɔse yee? Weera dɔɔ te ɛ ne gyu woya gyaŋ ke gbala baŋ be kyaana be sia nɛ nyeeman? <verse eid="ISA 8:19" /><verse number="20" style="v" sid="ISA 8:20" />Ɛ tei Wurubuarɛ kawola na ɔ kefaree adansɛɛ keŋ. Nyi ŋolo te kolosi ŋgba mena keŋ nombii kei doo ya nɛ, kenaŋ na tɛɛ be gyae kena ɔtenate ya. <verse eid="ISA 8:20" /><verse number="21" style="v" sid="ISA 8:21" />Baa mo wosekekyaŋ na tanam kila tɛɛle keŋ dɔɔ. Tanam da yee wɔ na baa gyeŋ baŋ nideli, na baa kɛɛ adido na baa falaa be gyoo na be Wurubuarɛ. <verse eid="ISA 8:21" /><verse number="22" style="v" sid="ISA 8:22" />Baa gɔŋase kɛɛ tɛɛle, mɔna baa naa kayeyɛɛ na detiŋtɛɛ na kayeyɛɛ keŋ taŋ keyako ya, na baa gegi wɔ ka do detiŋtɛɛ tuum man.<verse eid="ISA 8:22" /></para>
  <chapter eid="ISA 8" />
  <chapter number="9" style="c" sid="ISA 9" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 9:1" />Mɔna baŋ be doo wosekekyaŋ man be gyae baa naa detiŋtɛɛ bela ya. Gyaŋgba keŋ na ɔ yɔkɔse Sebulɔn tɛɛle na Nafitali tɛɛle, mɔna wee daale waa kaa do Galelia keŋ yɛɛ ŋɔɔla tɛɛlese ŋan kyaa ɛpo gbɛɛ Yɔɔdan diŋgyiŋ nɛ obuo.<verse eid="ISA 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 9:2" />Balaŋ baŋ be dɔŋ detiŋtɛɛ man nɛ,</para>
  <para style="q2" vid="ISA 9:2">te naa keŋmaŋee dinaa daale,</para>
  <para style="q1" vid="ISA 9:2">keŋmaŋee te ŋmaŋee fa,</para>
  <para style="q2" vid="ISA 9:2">baŋ be kyaa detiŋtɛɛ tuum tɛɛle man nɛ.<verse eid="ISA 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 9:3" />N te yele tɛɛle keŋ te wuku,</para>
  <para style="q2" vid="ISA 9:3">te n yela be nyaŋeewɔ nideli,</para>
  <para style="q1" vid="ISA 9:3">bɛɛ nyaŋee n siaman,</para>
  <para style="q2" vid="ISA 9:3">ŋgba weenɛɛ kekɛrɛɛtɛɛ kenyaŋee nɛ,</para>
  <para style="q1" vid="ISA 9:3">ŋgba mena keŋ yoonɔɔtena ne nyaŋee</para>
  <para style="q2" vid="ISA 9:3">yooman abɔɔ kekpala man nɛ.<verse eid="ISA 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 9:4" />Ŋgba mena keŋ n be yɛɛ Midianetena ke yala yoo man nɛ,</para>
  <para style="q2" vid="ISA 9:4">n wɔlɛɛ,</para>
  <para style="q1" vid="ISA 9:4">kasolɔ keŋ na ŋere wɔ nɛ,</para>
  <para style="q2" vid="ISA 9:4">na nyeele keŋ gyakaa ba degbaŋgbaŋ dɔɔ nɛ,</para>
  <para style="q2" vid="ISA 9:4">na baŋ bɛɛ ŋere wɔ do nɛ gbutu.<verse eid="ISA 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 9:5" />Yoonɔɔte kamasɛ nkyokota keŋ ɔ ba doo gyu yoo,</para>
  <para style="q2" vid="ISA 9:5">na ba kegbase ŋan pou fatabo be kpatee ŋa nɛ,</para>
  <para style="q1" vid="ISA 9:5">kaboena nyi baa too ŋa,</para>
  <para style="q2" vid="ISA 9:5">kaboena nyi baa mo ŋa do boalaŋ.<verse eid="ISA 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 9:6" />Nawolo nyi be ta lola bu fa daa,</para>
  <para style="q2" vid="ISA 9:6">ba te fa daa bu baale,</para>
  <para style="q2" vid="ISA 9:6">ɔ gyoori gyakaa ɔ degbaŋgbaŋ dɔɔ.</para>
  <para style="q1" vid="ISA 9:6">Baa baake e nyi,</para>
  <para style="q2" vid="ISA 9:6">Gyakoloŋ Nombia, Kolosirefa, Wurubuarɛ Dekpataakpere,</para>
  <para style="q2" vid="ISA 9:6">Kya Kekpaakekpaa, Wosefɛɛreŋ Gyoo<verse eid="ISA 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 9:7" />Ɔ gyooridedii gyae ke fɛlɛɛ te ɔ wosefɛɛreŋ</para>
  <para style="q2" vid="ISA 9:7">be dana ɔto ya.</para>
  <para style="q1" vid="ISA 9:7">Waa di ɔ gyoori Dawide gyoorogbeli dɔɔ,</para>
  <para style="q2" vid="ISA 9:7">na gyoorobiiri keŋ man,</para>
  <para style="q1" vid="ISA 9:7">waa mo nombia kedina kegbɛɛ dɔɔ na katenee</para>
  <para style="q2" vid="ISA 9:7">desina ke baŋ,</para>
  <para style="q2" vid="ISA 9:7">lee debaŋ kenaŋ kelii kekpaakekpaa,</para>
  <para style="q1" vid="ISA 9:7">Degbeŋgyoo Dekpataakpere kegyae nideli keŋ,</para>
  <para style="q2" vid="ISA 9:7">ne gyaela ke yɛɛ kei.<verse eid="ISA 9:7" /></para>
  <para style="s1">Degbeŋgyoo ka gyeŋ baŋ tia Iserae</para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 9:8" />Degbeŋgyoo ta do tiila tia Yakɔbe,</para>
  <para style="q2" vid="ISA 9:8">ke gyae ke kɔŋ Iseraetena dɔɔ.<verse eid="ISA 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 9:9" />Balaŋ baŋ pou baa gyeŋ ke,</para>
  <para style="q2" vid="ISA 9:9">Ɛferayimtena na baŋ be kyaa Samariya,</para>
  <para style="q1" vid="ISA 9:9">baŋ bɛɛ mo wose kegate,</para>
  <para style="q1" vid="ISA 9:9">na agaŋtaŋ konɔɔ yako nyi, <verse eid="ISA 9:9" /><verse number="10" style="v" sid="ISA 9:10" />&lt;&lt;Birikisise ŋan te yale,</para>
  <para style="q2" vid="ISA 9:10">mɔna dɛɛ mo boya ŋan bɔɔ kpae nɛ bese baŋ ke,</para>
  <para style="q1" vid="ISA 9:10">ba te kɛrɛɛ fiigi daase ŋan lɔ,</para>
  <para style="q2" vid="ISA 9:10">mɔna dɛɛ mo sida daase see ŋe nawɔɔ man.&gt;&gt;<verse eid="ISA 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 9:11" />Mɔna Degbeŋgyoo ta do Resin kɔlara doŋ,</para>
  <para style="q2" vid="ISA 9:11">te ɔ yela be kɔlara korowɔ be dɔɔ.<verse eid="ISA 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 9:12" />Aramtena baŋ bɔɔ lee weese dɛɛlee na Filisitena baŋ bɔɔ lee weese dɛɛyalae nɛ,</para>
  <para style="q2" vid="ISA 9:12">te di Iserae dɔɔ.</para>
  <para style="b" vid="ISA 9:12" />
  <para style="q1" vid="ISA 9:12">Mɔ lee kɛŋa pou wɔle nɛ, ɔ te tinaata ɔ baŋ yela ya,</para>
  <para style="q2" vid="ISA 9:12">ɔ nyiŋmaa sɛɛ doo adido.<verse eid="ISA 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="ISA 9:13" />Mɔna balaŋ baŋ ta bese kɔŋ ŋon ɔ be tuku wɔ nɛ gyaŋ,</para>
  <para style="q2" vid="ISA 9:13">yaa baa kɛo Degbeŋgyoo Dekpataakpere ŋon ya.<verse eid="ISA 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 9:14" />Mena dɔɔ Degbeŋgyoo waa mo wee dokoloŋ kara Iserae nyee na ɔ gyuŋ,</para>
  <para style="q2" vid="ISA 9:14">ɔkɛɛ na moro pou.<verse eid="ISA 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 9:15" />Kegyiise na obuo balaŋ yɛna nyee keŋ,</para>
  <para style="q2" vid="ISA 9:15">te gbalara baŋ be kawola yɛɛ akɛrɛɛ nɛ yɛna gyuŋ keŋ.<verse eid="ISA 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 9:16" />Baŋ be dɔŋ balaŋ kɛwɔ siaman ta mo wɔ yooso,</para>
  <para style="q2" vid="ISA 9:16">te baŋ be silana wɔ nɛ ta yo gbɛɛ.<verse eid="ISA 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 9:17" />Mena dɔɔ tewulɛɛ nombia be gyae ka gyoo Degbeŋgyoo sia,</para>
  <para style="q2" vid="ISA 9:17">yaa waa wii yoyolobiise na liala ya.</para>
  <para style="q1" vid="ISA 9:17">nawolo nyi ɔkamasɛ bee yee Wurubuarɛ ya te be dana akpanyanyaŋ,</para>
  <para style="q2" vid="ISA 9:17">te nɔɔ kamasɛ ne kolosi kehuhoori nombia bo.</para>
  <para style="b" vid="ISA 9:17" />
  <para style="q1" vid="ISA 9:17">Kɛŋa pou wɔle koraŋ nɛ ɔ baŋ te fɛɛ e ya,</para>
  <para style="q2" vid="ISA 9:17">ɔ nyiŋmaa sɛɛ doo adido.<verse eid="ISA 9:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ISA 9:18" />Ampaŋ ba akpanyanyaŋ nombia ne kpaa ŋgba boalaŋ nɛ,</para>
  <para style="q2" vid="ISA 9:18">kɛɛ kpa kpaŋkpaŋkorolose na kpalamse,</para>
  <para style="q1" vid="ISA 9:18">kɛɛ kpa laa dinaana,</para>
  <para style="q2" vid="ISA 9:18">na ke nyɔɔse tuum ta gyem gyu adido.<verse eid="ISA 9:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 9:19" />Degbeŋgyoo Dekpataakpere ŋon baŋ,</para>
  <para style="q2" vid="ISA 9:19">te kpa tɛɛle keŋ,</para>
  <para style="q1" vid="ISA 9:19">te balaŋ baŋ baa yɛɛ ŋgba keŋ bɛɛ mo do boalaŋ nɛ,</para>
  <para style="q2" vid="ISA 9:19">bɔɔ gyae baa wii dɔŋa ya.<verse eid="ISA 9:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 9:20" />Bɛɛ ŋmaa weenɛɛ dunoluŋ dɔɔ</para>
  <para style="q2" vid="ISA 9:20">mɔna bɛɛ yeŋ tanam,</para>
  <para style="q1" vid="ISA 9:20">bee dii demena dɔɔ,</para>
  <para style="q2" vid="ISA 9:20">mɔna bɔɔ ne baa ya.</para>
  <para style="q" vid="ISA 9:20">2 Ɔkamasɛ waa tao ŋon gbagba bu.<verse eid="ISA 9:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="ISA 9:21" />Manase waa tao Ɛferayim, na Eferayim mɔ ke tao Manase,</para>
  <para style="q2" vid="ISA 9:21">be bala baa koro seŋ tia Yuda.</para>
  <para style="b" vid="ISA 9:21" />
  <para style="q1" vid="ISA 9:21">Mɔ kɛŋa pou wɔle na ɔ te tina ɔ baŋ keŋ yela ya,</para>
  <para style="q2" vid="ISA 9:21">ɔ nyiŋmaa sɛɛ doo adido.<verse eid="ISA 9:21" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="ISA 9" />
  <chapter number="10" style="c" sid="ISA 10" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 10:1" />Baŋ bɛɛ yɛɛ mmaraase ŋan be doona ŋe gbɛɛ ya,</para>
  <para style="q2" vid="ISA 10:1">na baŋ bɛɛ fa mmarase ŋan na ŋere balaŋ do nɛ, baa laako.<verse eid="ISA 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 10:2" />Bɛɛ yɛɛ ŋa mo tɔ ayematena nombia ŋan dei nɛ gbɛɛ,</para>
  <para style="q2" vid="ISA 10:2">te bɔɔ ne di nombia kegbɛɛ dɔɔ fa me balaŋ baŋ bɔɔ ŋere wɔ do nɛ ya,</para>
  <para style="q1" vid="ISA 10:2">na baa kuu liala,</para>
  <para style="q2" vid="ISA 10:2">na yoyolobiise abɔɔ.<verse eid="ISA 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 10:3" />Woŋ te ɛ ke yɛɛ akɔŋtaa wee keŋ,</para>
  <para style="q2" vid="ISA 10:3">nombiikum da lee lem kaa yala ŋon nɛ?</para>
  <para style="q1" vid="ISA 10:3">Amɔte gyaŋ yaa ɛ ke yeu gyu nyi waa kyɔ ŋon?</para>
  <para style="q2" vid="ISA 10:3">Aleŋ yaa ɛ ka mo ɛ wosekenyiŋ ŋan see?<verse eid="ISA 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 10:4" />Kolo be doona keyɛɛ ya mɔna ɛ ke yɔkɔse ɛ wose do yoogbeŋa man,</para>
  <para style="q2" vid="ISA 10:4">yaa ɛ ka yeŋ kpuna baŋ bɔɔ yale yoo man nɛ.</para>
  <para style="b" vid="ISA 10:4" />
  <para style="q1" vid="ISA 10:4">Mɔna lee kɛŋa pou wɔle na, ɔ te tinaata ɔ baŋ yela ya,</para>
  <para style="q2" vid="ISA 10:4">ɔ nyiŋmaa sɛɛ doo adido.<verse eid="ISA 10:4" /></para>
  <para style="s1">Wurubuarɛ waa di Asiriya nombia</para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 10:5" />&lt;&lt;Asiriya, me baŋ dambila,</para>
  <para style="q2" vid="ISA 10:5">ŋon me baŋ gbutu keŋ doo n nyiŋmaa man nɛ, laako.<verse eid="ISA 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 10:6" />Me kpila e balaŋ baŋ bɔɔ ne yee Wurubuarɛ ya nɛ gyaŋ,</para>
  <para style="q2" vid="ISA 10:6">me kpila e balaŋ baŋ bɛɛ do maŋ baŋ nɛ gyaŋ,</para>
  <para style="q1" vid="ISA 10:6">nyi waa lɛo ba abɔɔ na waa kuu be yooman abɔɔ,</para>
  <para style="q2" vid="ISA 10:6">na waa sakatee wɔ ŋgba abɔntere man apɛtɛɛ nɛ.<verse eid="ISA 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 10:7" />Mɔna na kei yɛna wa nyeempɔ ya,</para>
  <para style="q2" vid="ISA 10:7">na kei doola wa nyeempɔ man ya,</para>
  <para style="q1" vid="ISA 10:7">keŋ doo ɔ konɔɔ man yɛna nyi waa wɔlɛɛ,</para>
  <para style="q2" vid="ISA 10:7">na waa munu tɛɛlese burum.<verse eid="ISA 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 10:8" />Ɔ yakowɔ nyi, &lt;Me yoonɔɔtena kegyiise pou te yɛɛ gyooneŋwɔ yee?&gt;<verse eid="ISA 10:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="ISA 10:9" />&lt;Kaleno be yɛɛ ŋgba Karekemise yee?</para>
  <para style="q1" vid="ISA 10:9">Hamate be yɛɛ ŋgba Arepade,</para>
  <para style="q2" vid="ISA 10:9">te Samariya yɛɛ ŋgba Damasekuse yee?<verse eid="ISA 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 10:10" />Mena keŋ me nyiŋmaa be tina bɛɛneŋ gyooridediise ŋan,</para>
  <para style="q2" vid="ISA 10:10">na gyooridediise ŋan ŋe bɛɛneŋ kela Yerusalɛm na Samariya wui nɛ,<verse eid="ISA 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 10:11" />mɔɔ gyae maa yɛɛ Yerusalɛm na be bɛɛneŋ,</para>
  <para style="q2" vid="ISA 10:11">ŋgba mena keŋ mɔɔ yɛɛ Samariya na ɔ bɛɛneŋ yee?&gt;&gt;&gt;<verse eid="ISA 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 10:12" />Akpaa Degbeŋgyoo de yɛɛ ŋan pou ɔ kpa waa yɛɛ Siyɔn bula dɔɔ na Yerusalɛm taŋ nɛ, waa yako nyiaa, &lt;&lt;Maa wɔŋ Asiriya gyoo deŋele lee ɔ wose kegate na wa agaŋtaŋ sia dɔɔ. <verse eid="ISA 10:12" /><verse number="13" style="v" sid="ISA 10:13" />Nawolo nyi ɔ ne yako nyiaa,</para>
  <para style="q1" vid="ISA 10:13">&lt;&lt;&lt;Maŋ gbagba me doŋ man te me yɛɛ kei,</para>
  <para style="q2" vid="ISA 10:13">me nyansa man, nawolo nyi mee nyii nombia man.</para>
  <para style="q1" vid="ISA 10:13">Ma lese tɛɛlese wuluse,</para>
  <para style="q2" vid="ISA 10:13">me kuu ba agyapadɛɛse,</para>
  <para style="q2" vid="ISA 10:13">ŋgba doŋte nɛ, me yɔkɔse be gyooneŋ.<verse eid="ISA 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 10:14" />Mena keŋ bɛɛ do nyiŋmaa gyebu desaa man nɛ,</para>
  <para style="q2" vid="ISA 10:14">mena ke te ma doo me nyiŋmaa kuu tɛɛlese agyapadɛɛse,</para>
  <para style="q1" vid="ISA 10:14">mena keŋ balaŋ ne kuu gyebu wɔɔ ŋan ɔ be bɛɛ ŋa doo desaa man nɛ,</para>
  <para style="q2" vid="ISA 10:14">mena ke te me yilaa tɛɛlese ŋan pou.</para>
  <para style="q1" vid="ISA 10:14">Be man ŋolo te furufu</para>
  <para style="q2" vid="ISA 10:14">yaa waa wii ya.&gt;&gt;&gt;<verse eid="ISA 10:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ISA 10:15" />Debeŋa ne gate ka wose kela ŋon ɔ dana ke ɔ ne kare nɛ,</para>
  <para style="q2" vid="ISA 10:15">yaa saa waa tale wola ɔ wose kela ŋon ɔ na mo ke yɛɛ tom nɛ?</para>
  <para style="q1" vid="ISA 10:15">Dambila gyae ke tale tuku ŋon ɔ telana ke nɛ,</para>
  <para style="q2" vid="ISA 10:15">yaa gbutu gyae ke tale gyina ŋon ɔ te yɛɛ daŋ ya nɛ adido?<verse eid="ISA 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 10:16" />Mena dɔɔ Degbeŋgyoo, Degbeŋgyoo Dekpataakpere,</para>
  <para style="q2" vid="ISA 10:16">waa mo kaweekum kaa lɔ yoonɔɔtena gyanɛɛ baŋ dɔɔ.</para>
  <para style="q1" vid="ISA 10:16">Boalaŋ gyae ke kpa ɔ gyoorobiiri,</para>
  <para style="q2" vid="ISA 10:16">ŋgba boalaŋ degyapaa nɛ.<verse eid="ISA 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 10:17" />Iserae keŋmaŋee gyae ka bese boalaŋ,</para>
  <para style="q2" vid="ISA 10:17">ba fereŋkyeŋte ŋon waa bese boalaŋ laakem,</para>
  <para style="q1" vid="ISA 10:17">waa mo wee dokoloŋ kpa na waa nyakee</para>
  <para style="q2" vid="ISA 10:17">ɔ kpalamse na kpaŋkpaŋkorolose.<verse eid="ISA 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 10:18" />Mena keŋ kawee ne tale kaweete nideli nɛ,</para>
  <para style="q2" vid="ISA 10:18">mena ke te laaneŋ kyeo nyiŋan na tɛɛlese kpaakpaa nyiŋan,</para>
  <para style="q2" vid="ISA 10:18">gyae ke wɔlɛɛ kerekere.<verse eid="ISA 10:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 10:19" />Te laaman daase akaŋ ŋan gyae ke yɛɛ kyomii nɛ,</para>
  <para style="q2" vid="ISA 10:19">keŋ nyi biikyaa waa tale ŋmarase ŋe yaanɔɔle do tɔne man.<verse eid="ISA 10:19" /></para>
  <para style="s1">Iseraetena akaŋ baŋ</para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 10:20" />Mena wee kenaŋ nɛ, Iseraetena akaŋ</para>
  <para style="q2" vid="ISA 10:20">na Yakɔbe balaŋ baŋ be ta yem ya nɛ,</para>
  <para style="q1" vid="ISA 10:20">be gyae baa mo ba wose lɔ</para>
  <para style="q2" vid="ISA 10:20">ŋon ɔ be di be dɔɔ nɛ dɔɔ bela ya.</para>
  <para style="q1" vid="ISA 10:20">Mɔna baa mo ba wose pou lɔ Degbeŋgyoo</para>
  <para style="q2" vid="ISA 10:20">Iserae fereŋkyeŋte ŋon dɔɔ.<verse eid="ISA 10:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 10:21" />Baŋ bɔɔ kaa nɛ baa bese kɔŋ, Yakɔbe balaŋ akaŋ baŋ</para>
  <para style="q2" vid="ISA 10:21">baa bese kɔŋ Wurubuarɛ Dekpataakpere ŋon gyaŋ. <verse eid="ISA 10:21" /><verse number="22" style="v" sid="ISA 10:22" />Doo nyi n balaŋ Iseraetena boe ŋgba ɛpo nɔɔman aŋasa koraŋ nɛ,</para>
  <para style="q2" vid="ISA 10:22">kyomii ne gyaela baa bese kɔŋ.</para>
  <para style="q1" vid="ISA 10:22">Ɔ te bakesee nyi waa wɔlɛɛ ke,</para>
  <para style="q2" vid="ISA 10:22">te ke doo kegbɛɛ dɔɔ.<verse eid="ISA 10:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 10:23" />Degbeŋgyoo, Degbeŋgyoo Dekpaatakpere ŋon,</para>
  <para style="q2" vid="ISA 10:23">waa wɔlɛɛ wɔ lee tɛɛle keŋ pou dɔɔ ŋgba mena keŋ ɔ be bakesee nɛ.<verse eid="ISA 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 10:24" />Mena dɔɔ keŋ Degbeŋgyoo, Degbeŋgyoo Dekpaatakpere ŋon ne yako yaa,</para>
  <para style="q1" vid="ISA 10:24">&lt;&lt;Me balaŋ baŋ be kyaa Siyɔn,</para>
  <para style="q2" vid="ISA 10:24">ɛ naa yee Asiriyatena baŋ,</para>
  <para style="q1" vid="ISA 10:24">bɛɛ mo dambila tuku ŋon</para>
  <para style="q2" vid="ISA 10:24">te bɛɛ gate akpokpose ɛ dɔɔ ŋgba mena keŋ Igyipitetena be yɛɛ ŋon nɛ ya<verse eid="ISA 10:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 10:25" />Be gyae ke kyare ya me baŋ gyae ke fɛɛ ɛ dɔɔ,</para>
  <para style="q2" vid="ISA 10:25">na maa besena me baŋ beiŋ keŋ wɔlɛɛ wɔ.&gt;&gt;<verse eid="ISA 10:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="ISA 10:26" />Degbeŋgyoo Dekpataakpere waa mo dambila tuku wɔ,</para>
  <para style="q2" vid="ISA 10:26">ŋgba mena keŋ ɔ be tuku Midianetena Orebo kpanaŋ keŋ gyaŋ nɛ.</para>
  <para style="q1" vid="ISA 10:26">na waa gyina ɔ gbutu loŋse dɔɔ,</para>
  <para style="q2" vid="ISA 10:26">ŋgba mena keŋ ɔ be yɛɛ Igyipite nɛ.<verse eid="ISA 10:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 10:27" />Wee kenaŋ Degbeŋgyoo waa lese be kaale lee n degbaŋgbaŋ dɔɔ,</para>
  <para style="q2" vid="ISA 10:27">na be kasolɔ lee n wɔŋe dɔɔ,</para>
  <para style="q1" vid="ISA 10:27">baa wɔlɛɛ kasolɔ keŋ</para>
  <para style="q2" vid="ISA 10:27">lee keŋ n be doo nuŋ dɔɔ.<verse eid="ISA 10:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="ISA 10:28" />Ba gyoo Ayate,</para>
  <para style="q2" vid="ISA 10:28">ba moowɔ Migeron,</para>
  <para style="q2" vid="ISA 10:28">be tinaa ba abɔɔ yela Mikimase.<verse eid="ISA 10:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 10:29" />Be ka moowɔ bula gbɛɛ te be yakowɔ nyiaa,</para>
  <para style="q2" vid="ISA 10:29">&lt;&lt;dee doo Geba.&gt;&gt;</para>
  <para style="q1" vid="ISA 10:29">Ramatena sereewɔ,</para>
  <para style="q2" vid="ISA 10:29">Sɔɔl donɔɔ Gibeatena yekiiwɔ.<verse eid="ISA 10:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 10:30" />Galim alebu, lɔ nɔɔ,</para>
  <para style="q2" vid="ISA 10:30">Layesa, tei,</para>
  <para style="q2" vid="ISA 10:30">Anatɔtetena, ɛ tiranɔɔ.<verse eid="ISA 10:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 10:31" />Mademenatena ne yekii,</para>
  <para style="q2" vid="ISA 10:31">Gebimtena te yekii ka yo.<verse eid="ISA 10:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 10:32" />Gyɛŋ wee kei baa kaa dɔɔ Nɔbe,</para>
  <para style="q2" vid="ISA 10:32">baa goo ba akɔtase tee,</para>
  <para style="q1" vid="ISA 10:32">Siyɔn bu alebu bula keŋ,</para>
  <para style="q2" vid="ISA 10:32">Yerusalɛm bulabii keŋ dɔɔ.<verse eid="ISA 10:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="ISA 10:33" />Kɛɛ, Degbeŋgyoo, Degbeŋgyoo Dekpataakpere ŋon,</para>
  <para style="q2" vid="ISA 10:33">waa mo ɔ doŋ gyakoloŋ keŋ kɛrɛɛ daase tombia,</para>
  <para style="q1" vid="ISA 10:33">waa kɛrɛɛ ŋan ŋa korɛɛ nɛ,</para>
  <para style="q2" vid="ISA 10:33">na waa tisina ŋan ŋe dana dɔɔloŋ nɛ.<verse eid="ISA 10:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="ISA 10:34" />Waa mo debeŋa tuŋii laaman daase ŋan,</para>
  <para style="q2" vid="ISA 10:34">Lebanɔn waa yala Dekpataakpere ŋon siaman.<verse eid="ISA 10:34" /></para>
  <chapter eid="ISA 10" />
  <chapter number="11" style="c" sid="ISA 11" />
  <para style="s1">Tombii keŋ ba lee Yese man nɛ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 11:1" />Tombii daale gyae ka potee lee Yese daŋ duguŋ man,</para>
  <para style="q2" vid="ISA 11:1">tombii lee ɔ lila man gyae ka se bia.<verse eid="ISA 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 11:2" />Degbeŋgyoo feliŋ keŋ gyae ke gyakaa ɔ dɔɔ.</para>
  <para style="q2" vid="ISA 11:2">nyansa na nombia man kenyii feliŋ,</para>
  <para style="q2" vid="ISA 11:2">kekolosido na doŋ feliŋ,</para>
  <para style="q2" vid="ISA 11:2">nombia kagyeŋ na Degbeŋgyoo keyee feliŋ.<verse eid="ISA 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 11:3" />te Degbeŋgyoo keyee gyae ke yɛɛ e gyoŋ,</para>
  <para style="q1" vid="ISA 11:3">Ɔ be gyae waa bu fɔɔ lee keŋ ɔ ba mo ɔ sia naa,</para>
  <para style="q2" vid="ISA 11:3">yaa waa kulu nae lee keŋ ɔ be nyiina ɔ deŋele nɛ ya,<verse eid="ISA 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 11:4" />mɔna waa mo katenee di ayematena nombia,</para>
  <para style="q2" vid="ISA 11:4">nombia kedi na kegbɛɛ dɔɔ te waa mo di nombia fa tɛɛle keŋ dɔɔ ayematena.</para>
  <para style="q1" vid="ISA 11:4">Ɔ nɔɔman dambila te waa mo tuku tɛɛle,</para>
  <para style="q2" vid="ISA 11:4">Ɔ nɔɔman feliŋ te waa mo koe akpanyanyaŋtena.<verse eid="ISA 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 11:5" />Katenee gyae ke yɛɛ ɔ bɛlɛte,</para>
  <para style="q2" vid="ISA 11:5">na kelɛɛdi ke yɛɛ ɔ teŋa man kanyaŋ.<verse eid="ISA 11:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 11:6" />Gbougbou na nambu baa kyaa debodokoloŋ,</para>
  <para style="q2" vid="ISA 11:6">laamante na asoose baa doo,</para>
  <para style="q1" vid="ISA 11:6">nunkyue bia na dinaate bia baa di debodokoloŋ,</para>
  <para style="q2" vid="ISA 11:6">te biikyaa ne gyaela baa ta be siaman.<verse eid="ISA 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 11:7" />nunkyue waa di bomna mokɔɔte,</para>
  <para style="q2" vid="ISA 11:7">be bia baa doo debodokoloŋ,</para>
  <para style="q2" vid="ISA 11:7">dinaate waa tao ŋalese ŋgba nunkyue nɛ.<verse eid="ISA 11:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 11:8" />Bia buruburu baa yoi benaana wurale dedoi man,</para>
  <para style="q2" vid="ISA 11:8">biikyaa waa mo ɔ nyiŋmaa do dom keŋkeŋteŋte bɔɔ man.<verse eid="ISA 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 11:9" />Bɔɔ gyae baa yɛɛ dukum yaa wɔlɛɛ</para>
  <para style="q2" vid="ISA 11:9">me bulase fereŋkyeŋ ŋan pou dɔɔ ya,</para>
  <para style="q1" vid="ISA 11:9">nawolo nyi Degbeŋgyoo kagyeŋ gyae ke wulu tɛɛle keŋ dɔɔ,</para>
  <para style="q2" vid="ISA 11:9">ŋgba mena keŋ loŋ be wuu ɛpo nɛ.<verse eid="ISA 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 11:10" />Wee kenaŋ na Yese lili keŋ gyae ke yɛɛ felage fa balaŋ baŋ, tɛɛlese ŋan gyae kaa gyaŋee ɔ gyaŋ, te gyoorobiiri gyae ke doo ɔ dɛɛkyae fɛɛfo man. <verse eid="ISA 11:10" /><verse number="11" style="v" sid="ISA 11:11" />Wee kenaŋ te Degbeŋgyoo waa gate ɔ nyiŋmaa bolate lɛɛ ɔ balaŋ baŋ bɔɔ kaa nɛ lee Asiriya na Igyipite detaŋgya yenaŋ na Igyipite na Kuse na Elam na Babilɔn na Hamate na Meditereniya man tɛɛlese man kɔŋ ɔ gyaŋ.<verse eid="ISA 11:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 11:12" />Waa gate felage adido fa tɛɛlese ŋan,</para>
  <para style="q2" vid="ISA 11:12">na waa yilaa Iseraetena yoogbeŋa,</para>
  <para style="q1" vid="ISA 11:12">waa yilaa Yudatena baŋ bɔɔ yaasee,</para>
  <para style="q2" vid="ISA 11:12">gyu tɛɛle yenaase anaara ŋan man nɛ kɔŋ.<verse eid="ISA 11:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 11:13" />Ɛferayim nuŋkurili keŋ gyae ke ŋaalaa,</para>
  <para style="q2" vid="ISA 11:13">na baa munu Yuda kɔlara,</para>
  <para style="q1" vid="ISA 11:13">Eferayim be gyae waa yoo Yuda nuŋkurili,</para>
  <para style="q2" vid="ISA 11:13">yaa Yuda ke yɛɛ Eferayim akpanyanyaŋ ya.<verse eid="ISA 11:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 11:14" />Baa tisi bileŋ gyu Filisitena gyaŋ kelii weese dɛɛyalae yenaŋ,</para>
  <para style="q2" vid="ISA 11:14">na baa yoo kyaŋ balaŋ baŋ kelii weese dɛɛlee yenaŋ.</para>
  <para style="q1" vid="ISA 11:14">Baa ŋere Edom na Moabe do</para>
  <para style="q2" vid="ISA 11:14">na Amonitena mɔ kaa doo be tɛɛ.<verse eid="ISA 11:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 11:15" />Degbeŋgyoo waa yela</para>
  <para style="q2" vid="ISA 11:15">Igyipite ɛpo ka yo,</para>
  <para style="q1" vid="ISA 11:15">te Eferate boo dɔɔ waa mo,</para>
  <para style="q2" vid="ISA 11:15">feliŋ keŋ ke laŋɛɛ nɛ feefu ke dɔɔ.</para>
  <para style="q1" vid="ISA 11:15">Waa kpase ke yɛɛ boŋobiise nyetooro,</para>
  <para style="q2" vid="ISA 11:15">na ɔkamasɛ ke tale ta tɛɛle dowolo dɔɔ toŋ.<verse eid="ISA 11:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 11:16" />Botɔɔ gyae ke yɛɛ gbɛɛ dinaa fa ɔ balaŋ akaŋ baŋ,</para>
  <para style="q2" vid="ISA 11:16">bɔɔ lee Asiriya nɛ,</para>
  <para style="q1" vid="ISA 11:16">ŋgba mena keŋ be doo fa Iseraetena,</para>
  <para style="q2" vid="ISA 11:16">debaŋ keŋ bɔɔ lee Igyipite nɛ.<verse eid="ISA 11:16" /></para>
  <chapter eid="ISA 11" />
  <chapter number="12" style="c" sid="ISA 12" />
  <para style="s1">Yele kalese nɔɔneŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 12:1" />Wee kenaŋ nyaŋ ke yako nyiaa,</para>
  <para style="q1" vid="ISA 12:1">&lt;&lt;Maa lese n yele, Degbeŋgyoo</para>
  <para style="q2" vid="ISA 12:1">doo nyi n gyeŋa baŋ do maŋ,</para>
  <para style="q1" vid="ISA 12:1">n baŋ te yɔkɔse,</para>
  <para style="q2" vid="ISA 12:1">te n kyɔlɛɛ maŋ.<verse eid="ISA 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 12:2" />Ampaŋ Wurubuarɛ yɛna ma nyeekelɛɛ.</para>
  <para style="q2" vid="ISA 12:2">Maa mo ma wose lɔ ɔ dɔɔ, mɔɔ yee ya.</para>
  <para style="q1" vid="ISA 12:2">Degbeŋgyoo, Degbeŋgyoo gbagba yɛna me doŋ na me gyeere,</para>
  <para style="q2" vid="ISA 12:2">ɔ te kaa bese ma nyeekelɛɛ.&gt;&gt;<verse eid="ISA 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 12:3" />Ɛ ka mo kenyaŋee kyee loŋ,</para>
  <para style="q2" vid="ISA 12:3">lee nyeekelɛɛ detiribuŋ keŋ man.<verse eid="ISA 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 12:4" />Wee kenaŋ nyaŋ ke yako nyiaa,</para>
  <para style="q1" vid="ISA 12:4">&lt;&lt;Ɛ lese Degbeŋgyoo yele, ɛ gyɔ ɔ yele dekpeŋkpeŋ,</para>
  <para style="q2" vid="ISA 12:4">ɛ yela tɛɛlese ka gyeŋ keŋ ɔ be yɛɛ,</para>
  <para style="q2" vid="ISA 12:4">na ɛ ke gyɔ dekpeŋkpeŋ nyi, be te gyina ɔ yele adido.<verse eid="ISA 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 12:5" />Ɛ kpee nɔɔneŋ fa Degbeŋgyoo, nawolo nyi ɔ te yɛɛ gyakoloŋ nombia,</para>
  <para style="q2" vid="ISA 12:5">ɛ yela tɛɛlese pou ka gyeŋ ke.<verse eid="ISA 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 12:6" />Ɛ mɛɛ baŋ ɛ kyaa Siyɔn, ɛ fae yeesa keŋkeŋ na ɛ ke kpee kenyaŋee nɔɔneŋ,</para>
  <para style="q2" vid="ISA 12:6">nawolo nyi Iserae fereŋkyeŋte ŋon ɔ kpuɛna ŋon nɛ kerɛɛ.&gt;&gt;<verse eid="ISA 12:6" /></para>
  <chapter eid="ISA 12" />
  <chapter number="13" style="c" sid="ISA 13" />
  <para style="s1">Keyakosee tia Babilɔn</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 13:1" />Kei yɛna keyakosee tia Babilɔn keŋ Amose bu Yesaya be naa.<verse eid="ISA 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 13:2" />Ɛ gyina felage bulabii keŋ ke doo peŋteŋpereiŋ nɛ dɔɔ,</para>
  <para style="q2" vid="ISA 13:2">ɛ fae yeesa baake yoonɔɔtena,</para>
  <para style="q1" vid="ISA 13:2">Ɛ mo ɛ nyiŋmaa wola wɔ,</para>
  <para style="q2" vid="ISA 13:2">nyi baa gyoo gyoorobia anaanɔɔse ŋan man.<verse eid="ISA 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 13:3" />Ma te fae do baŋ mɔ desina fa yoo nɛ,</para>
  <para style="q2" vid="ISA 13:3">ma te baake me yoonɔɔtena nyi baa lese me baŋ wola,</para>
  <para style="q2" vid="ISA 13:3">baŋ bɛɛ nyaŋee ma keyoodi man nɛ.<verse eid="ISA 13:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 13:4" />Ɛ Tei, yeesa bulase dɔɔ,</para>
  <para style="q2" vid="ISA 13:4">ŋgba balaŋ burum nɛ.</para>
  <para style="q1" vid="ISA 13:4">Tei, gyooridediise ŋan ne wosi,</para>
  <para style="q2" vid="ISA 13:4">ŋgba tɛɛlese ne yilaala nɛ,</para>
  <para style="q1" vid="ISA 13:4">Degbeŋgyoo Dekpataakpere ŋon ne desinaana</para>
  <para style="q2" vid="ISA 13:4">yoonɔɔtena fa yoo.<verse eid="ISA 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 13:5" />Ba lee tɛɛlese lemlem,</para>
  <para style="q2" vid="ISA 13:5">lee Adidose ŋan ɔto.</para>
  <para style="q1" vid="ISA 13:5">Be kɔŋaana Degbeŋgyoo baŋ yoo abɔɔ,</para>
  <para style="q2" vid="ISA 13:5">na baa wɔlɛɛ tɛɛle keŋ pou.<verse eid="ISA 13:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 13:6" />Ɛ wii keŋkeŋ, nawolo nyi Degbeŋgyoo wee keŋ ta benaa.</para>
  <para style="q2" vid="ISA 13:6">ke gyae ke kɔŋ ŋgba kewɔlɛɛ nɛ lee Dekpataakpere ŋon gyaŋ.<verse eid="ISA 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 13:7" />Lee kei dɔɔ nyiŋmaase pou gyae ke yɔkɔse,</para>
  <para style="q2" vid="ISA 13:7">na gyakoloŋ ke yela konɔɔ kamasɛ ke yala koyololo.<verse eid="ISA 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 13:8" />Keŋeŋii gyae ka gyoo wɔ,</para>
  <para style="q2" vid="ISA 13:8">weeleŋ na kayeyɛɛ gyae ke yala wɔ,</para>
  <para style="q1" vid="ISA 13:8">baa keŋee ŋgba kadoŋee kyaŋana alo nɛ.</para>
  <para style="q2" vid="ISA 13:8">Baa kɛɛ dɔŋa siaman fee,</para>
  <para style="q2" vid="ISA 13:8">be sia gyae ke kyaŋee boalaŋ.<verse eid="ISA 13:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 13:9" />Kɛɛ, Degbeŋgyoo wee keŋ ne kɔŋ,</para>
  <para style="q2" vid="ISA 13:9">ke gyae ke yɛɛ weekum na baŋ na ayorɛ,</para>
  <para style="q1" vid="ISA 13:9">na waa yela tɛɛle keŋ ke doo yakaa,</para>
  <para style="q2" vid="ISA 13:9">na waa wɔlɛɛ nombiakumɛɛ yɛɛra lee ke man.<verse eid="ISA 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 13:10" />Adido kyolobiise na ŋa dikpii,</para>
  <para style="q2" vid="ISA 13:10">be gyae ke ŋmaŋee ya.</para>
  <para style="q1" vid="ISA 13:10">Weese de bɛɛ lee na gyae ke yɛɛ detiŋtɛɛ,</para>
  <para style="q2" vid="ISA 13:10">te gyaalaŋ be gyae waa fa keŋmaŋee ya.<verse eid="ISA 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 13:11" />Maa wɔŋ tɛɛle keŋ deŋele lee be nombiakumɛɛ dɔɔ,</para>
  <para style="q2" vid="ISA 13:11">na akpanyanyaŋtena lee be dukum dɔɔ.</para>
  <para style="q1" vid="ISA 13:11">maa mo Agaŋtaŋtena wose kegate kɔŋ ɔto,</para>
  <para style="q2" vid="ISA 13:11">na maa yɔkɔse tɔɔman ŋantena wose kegate.<verse eid="ISA 13:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 13:12" />Maa yela deniwalaŋ kena ke yɛɛ baŋ kela kɔba yayam,</para>
  <para style="q2" vid="ISA 13:12">gyae ke yɛɛ doŋ kela Ofire kɔba yayam.<verse eid="ISA 13:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 13:13" />Mena dɔɔ maa yela adido ke seree,</para>
  <para style="q2" vid="ISA 13:13">na tɛɛle ke wosi lee ka dedoi man,</para>
  <para style="q1" vid="ISA 13:13">lee Degbeŋgyoo Dekpataakpere baŋ keŋ dɔɔ,</para>
  <para style="q2" vid="ISA 13:13">ɔ baŋ beiŋ wee keŋ man.<verse eid="ISA 13:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ISA 13:14" />Ŋgba mena keŋ ɔkpaŋ na peŋlaa ŋaa nɛ,</para>
  <para style="q2" vid="ISA 13:14">ŋgba namense baŋ bɔɔ dana kɛɛlere ya nɛ,</para>
  <para style="q1" vid="ISA 13:14">be popou baa bese gyu baŋ gbagba balaŋ gyaŋ,</para>
  <para style="q1" vid="ISA 13:14">baa yekii gyu baŋ gbagba be tɛɛlese man.<verse eid="ISA 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 13:15" />Ɔkamasɛ ŋon be kyaŋ e na baa sɔɔ e ko,</para>
  <para style="q2" vid="ISA 13:15">baŋ be kyaŋ wɔ na, baa yala yoosila nɔɔman.<verse eid="ISA 13:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 13:16" />Baa fuŋii be bia ŋmeree tɛɛle be sia man,</para>
  <para style="q2" vid="ISA 13:16">baa ŋmɛɛle ba akpaŋalaŋse man abɔɔ, na baa ŋere be wɛɛla doona wɔ.<verse eid="ISA 13:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ISA 13:17" />Kɛɛ, maa feefudo Mediatena na baa seŋ tia wɔ,</para>
  <para style="q2" vid="ISA 13:17">baŋ bɔɔ famenɛna kɔba wolom ya,</para>
  <para style="q2" vid="ISA 13:17">te kɔba yayam bɛɛ gyoo be sia ya nɛ.<verse eid="ISA 13:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 13:18" />Be baŋdaŋse gyae ka koe be bia tewulɛɛ,</para>
  <para style="q2" vid="ISA 13:18">bɔɔ gyae baa wii kyokyoose waraŋase,</para>
  <para style="q2" vid="ISA 13:18">yaa baa wii bia ya.<verse eid="ISA 13:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 13:19" />Babilɔn, gyooridediise man kegyaŋa kpaakpaate,</para>
  <para style="q2" vid="ISA 13:19">Wurubuarɛ waa tu,</para>
  <para style="q1" vid="ISA 13:19">Babilɔntena wose kegate na be gyoorobiiri</para>
  <para style="q2" vid="ISA 13:19">ŋgba Sodom na Gomora nɛ.<verse eid="ISA 13:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 13:20" />Walaŋ be gyae waa kyaa ke man korakora,</para>
  <para style="q2" vid="ISA 13:20">yaa ŋolo ke kɔŋ kaa kyaa ke man kalola kegyakaare man ya.</para>
  <para style="q1" vid="ISA 13:20">Arabetena be gyae baa baŋee be kanyaŋ denɛɛ botɔɔ,</para>
  <para style="q2" vid="ISA 13:20">yaa namensekɛɛlera ke yela be namense na ba asoose ke fɛɛfo botɔɔ ya.<verse eid="ISA 13:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 13:21" />mɔna depampaa man wonembia ne gyaela baa doo botɔɔ,</para>
  <para style="q1" vid="ISA 13:21">gbougbouse baa wulu ɔ denɛɛ man,</para>
  <para style="q1" vid="ISA 13:21">botɔɔ te kpilimse baa kyaa,</para>
  <para style="q2" vid="ISA 13:21">te bakyueŋna ba toŋee botɔɔ.<verse eid="ISA 13:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 13:22" />Mokɔɔtese baa gbesi ka nyee keŋ man,</para>
  <para style="q2" vid="ISA 13:22">te gbougbouse mɔ baa mo ɔ gyooro dekpaŋalaŋ keŋ,</para>
  <para style="q1" vid="ISA 13:22">Ɔ debaŋ te lii,</para>
  <para style="q2" vid="ISA 13:22">te bɔɔ gyae baa kpu e weeya ya.<verse eid="ISA 13:22" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="ISA 13" />
  <chapter number="14" style="c" sid="ISA 14" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 14:1" />Wurubuarɛ waa wii Yakɔbe,</para>
  <para style="q2" vid="ISA 14:1">waa lese Iserae bela,</para>
  <para style="q2" vid="ISA 14:1">na waa yela baa baŋee lila baŋ gbagba be tɛɛle dɔɔ,</para>
  <para style="q1" vid="ISA 14:1">ŋɔɔla baa kaa kpuna wɔ,</para>
  <para style="q2" vid="ISA 14:1">na baŋ na Yakɔbe duluŋmantena ke yɛɛ nɔɔdokoloŋ.<verse eid="ISA 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 14:2" />Tɛɛlese baa mo wɔ,</para>
  <para style="q2" vid="ISA 14:2">na baa mo wɔ kɔŋ baŋ gbagba ba dekyae man.</para>
  <para style="q1" vid="ISA 14:2">Te Iserae waa mo tɛɛlese ŋenaŋ bese be wui,</para>
  <para style="q2" vid="ISA 14:2">na baa besena wɔ yɛɛ be gbeŋa ala na baala Degbeŋgyoo tɛɛle keŋ man.</para>
  <para style="q1" vid="ISA 14:2">Baa yela baŋ nafɔ bɔɔ di Iserae dɔɔ nɛ, kaa doo be tɛɛ</para>
  <para style="q2" vid="ISA 14:2">na baa di baŋ bɔɔ ŋere wɔ do nɛ dɔɔ.<verse eid="ISA 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 14:3" />Wee keŋ Degbeŋgyoo waa yela n ke fɛɛfo, lee n kaale na n weeleŋ na tom nedoŋ keŋ bɔɔ ŋere neŋ n be yɛɛ man nɛ, <verse eid="ISA 14:3" /><verse number="4" style="v" sid="ISA 14:4" />nyaŋ ka do Babilɔn gyoo ahiŋ nyiaa,</para>
  <para style="q1" vid="ISA 14:4">ŋon ɔ na ŋere balaŋ do nɛ ɔto yaa</para>
  <para style="q2" vid="ISA 14:4">te ɔ baŋ keŋ ɔto yaa!<verse eid="ISA 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 14:5" />Degbeŋgyoo te tekerii akpanyanyaŋte dambila,</para>
  <para style="q2" vid="ISA 14:5">na gyooro gbutu keŋ,<verse eid="ISA 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 14:6" />ɔ ba mo tuku balaŋ baŋ man,</para>
  <para style="q2" vid="ISA 14:6">keŋ be te tina yela ya,</para>
  <para style="q1" vid="ISA 14:6">baŋ beiŋ man te ba ŋere tɛɛlese do,</para>
  <para style="q2" vid="ISA 14:6">keŋ be gyakaa bɛɛ naase wɔ diyem.<verse eid="ISA 14:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 14:7" />Tɛɛlese ŋan dɔɔ pou te fɛɛ te ŋe doo wosefɛɛreŋ man,</para>
  <para style="q2" vid="ISA 14:7">te be lɔɔ nɔɔneŋ.<verse eid="ISA 14:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 14:8" />Kateenaa na sida daase ŋan kya Lebanɔn nɛ,</para>
  <para style="q2" vid="ISA 14:8">ne nyaŋee n dɔɔ te bɛɛ yako nyiaa,</para>
  <para style="q1" vid="ISA 14:8">&lt;&lt;Nɛnɛɛ keŋ bɔɔ yɔkɔse neŋ nɛ,</para>
  <para style="q2" vid="ISA 14:8">ŋolo be gyae waa kɔŋ kaa tuŋii daa lɔ ya.&gt;&gt;<verse eid="ISA 14:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 14:9" />Woya dɛɛ ne desina ka wose,</para>
  <para style="q2" vid="ISA 14:9">waa gyaŋeena neŋ,</para>
  <para style="q1" vid="ISA 14:9">woya baŋ ta koro baa do neŋ nɔɔ,</para>
  <para style="q2" vid="ISA 14:9">baŋ pou bɔɔ yɛɛ siamantena tɛɛle dɔɔ nɛ,</para>
  <para style="q1" vid="ISA 14:9">te yele be ta koro lee be gyoorogbelɛɛ dɔɔ,</para>
  <para style="q2" vid="ISA 14:9">baŋ pou bɔɔ di gyoori tɛɛlese dɔɔ nɛ.<verse eid="ISA 14:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 14:10" />Be popou baa kpa,</para>
  <para style="q2" vid="ISA 14:10">baa yako neŋ nyiaa,</para>
  <para style="q1" vid="ISA 14:10">&lt;&lt;Nyaŋ mɔ te yɔkɔse ŋgba daa nɛ,</para>
  <para style="q2" vid="ISA 14:10">n te yɛɛ ŋgba daa nɛ.&gt;&gt;<verse eid="ISA 14:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 14:11" />Nyɔ obuo pou te tisi kaa gyoo yebɔɔ man,</para>
  <para style="q2" vid="ISA 14:11">kpuna n keferee kewii,</para>
  <para style="q1" vid="ISA 14:11">be ta mo feelɛɛ lɔ neŋ dofoŋoŋ,</para>
  <para style="q2" vid="ISA 14:11">te taala yɛna kanyaŋ keŋ be wuu neŋ.<verse eid="ISA 14:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 14:12" />Sena yaa n yalawɔ lee adido mena,</para>
  <para style="q2" vid="ISA 14:12">nebo kyolobii, nebo nebo fuu tobaale.</para>
  <para style="q1" vid="ISA 14:12">Be te fuŋ neŋ lɔ tɛɛle man,</para>
  <para style="q2" vid="ISA 14:12">nyaŋ ŋon n be yɔkɔse tɛɛlese kaa laŋ nɛ!<verse eid="ISA 14:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 14:13" />N yakowɔ n konɔɔ man nyiaa,</para>
  <para style="q2" vid="ISA 14:13">&lt;&lt;Maa gyeŋ gyu adido.</para>
  <para style="q1" vid="ISA 14:13">Maa gyina me gyoorogbeli</para>
  <para style="q2" vid="ISA 14:13">gbaa Wurubuarɛ kyolobiise.</para>
  <para style="q1" vid="ISA 14:13">Maa kyaa me gyoorogbeli dɔɔ, be dɛɛgyaŋee bula keŋ dɔɔ,</para>
  <para style="q2" vid="ISA 14:13">Safon bula fereŋkyeŋ keŋ adido adido.<verse eid="ISA 14:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 14:14" />Maa gyeŋ gbaa gyu ŋɔma ŋan adido,</para>
  <para style="q2" vid="ISA 14:14">maa yɛɛ ma wose ŋgba Adidote ŋon nɛ&gt;&gt;<verse eid="ISA 14:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 14:15" />Mɔna be te tisina neŋ kɔŋ woya dɛɛ,</para>
  <para style="q2" vid="ISA 14:15">yebɔɔ kyilimkyilim keŋ man.<verse eid="ISA 14:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ISA 14:16" />Baŋ be naa neŋ ne kɛɛ neŋ fee,</para>
  <para style="q2" vid="ISA 14:16">bɛɛ gyueŋ n nombia nyiaa,</para>
  <para style="q1" vid="ISA 14:16">&lt;&lt;Na balee ŋon ɔ be wosi tɛɛle,</para>
  <para style="q2" vid="ISA 14:16">te ɔ be yele gyoorobiise be wosi,<verse eid="ISA 14:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 14:17" />baale ŋon ɔ ba besena tɛɛlese bese depampaa,</para>
  <para style="q2" vid="ISA 14:17">te ɔ be yɛlɛɛ ŋe donɔɔ dinaana,</para>
  <para style="q2" vid="ISA 14:17">te ɔ bɛɛ tina yoogbeŋa yela baa bese gyu be dɛɛse ya nɛ yaa yee?&gt;&gt;<verse eid="ISA 14:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ISA 14:18" />Tɛɛlese gyooneŋ pou doo be gyoorobiiri man,</para>
  <para style="q2" vid="ISA 14:18">ɔkamasɛ doo ɔ yebɔɔ man.<verse eid="ISA 14:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 14:19" />Mɔna nyaŋ dɔɔ be te fuŋ neŋ leki,</para>
  <para style="q2" vid="ISA 14:19">ŋgba tombii keŋ bɔɔ kare leki nɛ.</para>
  <para style="q1" vid="ISA 14:19">be ta mo baŋ bɔɔ koe nɛ wuu neŋ,</para>
  <para style="q2" vid="ISA 14:19">kpuna baŋ bɔɔ mo yoosila koe nɛ,</para>
  <para style="q2" vid="ISA 14:19">baŋ bɔɔ tisi gyoo boya bɔɔ man,</para>
  <para style="q1" vid="ISA 14:19">te be yɛɛ ŋgba woya baŋ bɔɔ sakatee nɛ.<verse eid="ISA 14:19" /></para>
  <para style="q2">
    <verse number="20" style="v" sid="ISA 14:20" />Bɔɔ gyae baa wuu neŋ ŋgba n tebia gyooneŋ ya,</para>
  <para style="q1" vid="ISA 14:20">nawolo nyi n te wɔlɛɛ n tɛɛle,</para>
  <para style="q2" vid="ISA 14:20">te n koe n balaŋ.</para>
  <para style="b" vid="ISA 14:20" />
  <para style="b" vid="ISA 14:20" />
  <para style="q1" vid="ISA 14:20">Be naa baake loŋtoro man,</para>
  <para style="q1" vid="ISA 14:20">ŋolo yele korakora ya.<verse eid="ISA 14:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 14:21" />Ɛ desina debo na ɛ ke kɛrɛɛ ɔ bia nyeeya,</para>
  <para style="q2" vid="ISA 14:21">lee dukum keŋ be naanaɔ be yɛɛ nɛ dɔɔ,</para>
  <para style="q1" vid="ISA 14:21">tekaboena nyi baa koro kaa di tɛɛle kei dɔɔ,</para>
  <para style="q2" vid="ISA 14:21">na be kaa kara donɔɔ dinaana tɛɛle keŋ dɔɔ ya.<verse eid="ISA 14:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="ISA 14:22" />Degbeŋgyoo Dekpataakpere ta toro yako nyiaa,</para>
  <para style="q2" vid="ISA 14:22">&lt;&lt;Maa koro seŋ tia wɔ,</para>
  <para style="q1" vid="ISA 14:22">maa feefo Babilɔn yele na baŋ bɔɔ kaa nɛ,</para>
  <para style="q2" vid="ISA 14:22">na be bia na be duluŋmantena yela&gt;&gt;</para>
  <para style="q4" vid="ISA 14:22">Degbeŋgyoo torola yako.<verse eid="ISA 14:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 14:23" />&lt;&lt;Maa besena e yɛɛ kpilimse dekyae</para>
  <para style="q2" vid="ISA 14:23">na depaa,</para>
  <para style="q1" vid="ISA 14:23">maa mo kewɔlɛɛ sembia gbee e leki.&gt;&gt;</para>
  <para style="q2" vid="ISA 14:23">Degbeŋgyoo Dekpataakpere ŋon torola yako.<verse eid="ISA 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 14:24" />Degbeŋgyoo Dekpataakpere ŋon te kaŋ ntam nyiaa,</para>
  <para style="q1" vid="ISA 14:24">&lt;&lt;Ampaŋ, keŋ mɔɔ bakesee nɛ, gyae ke yɛɛ mena,</para>
  <para style="q2" vid="ISA 14:24">te keŋ mɔɔ bake ma nyeeman nɛ, ke gyae ke kɔŋ mena.<verse eid="ISA 14:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 14:25" />Maa munu Asiriyatena lee me tɛɛle man,</para>
  <para style="q2" vid="ISA 14:25">me bula dɔɔ te maa sakatee wɔ.</para>
  <para style="q1" vid="ISA 14:25">Ɔ kaale gyae ka lee me balaŋ dɔɔ,</para>
  <para style="q2" vid="ISA 14:25">na baa lese ɔ kasolɔ lee ba agbaŋgbase dɔɔ.&gt;&gt;<verse eid="ISA 14:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="ISA 14:26" />Kei yɛna keŋ mɔɔ bakesee fa tɛɛle kei pou,</para>
  <para style="q2" vid="ISA 14:26">kei yɛna baam keŋ mɔɔ tenee tɛɛlese pou dɔɔ.<verse eid="ISA 14:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 14:27" />Nyi Degbeŋgyoo Dekpataakpere ŋon te bakesee na, amɔte ne gyaela waa tale tɔ gbɛɛ?</para>
  <para style="q2" vid="ISA 14:27">ɔ ta tenee ɔ baam, amɔte ne gyaela waa tale go ke?<verse eid="ISA 14:27" /></para>
  <para style="s1">Keyakosee keŋ ne tia Filisitena</para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 14:28" />Keyakosee kei kɔŋawɔ kulutoo keŋ gyoo Ahase ba yem nɛ man.<verse eid="ISA 14:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 14:29" />Ɛmɛɛ Filisitena, ɛ naa nyaŋee,</para>
  <para style="q2" vid="ISA 14:29">nyi gbutu keŋ bɛɛ mo tuku ŋon nɛ te tekeri ya,</para>
  <para style="q1" vid="ISA 14:29">Dom ŋonaŋ woŋ man te dom keŋkeŋteŋte waa lee,</para>
  <para style="q2" vid="ISA 14:29">waa kpala dom ŋon ɔ dana teekum te ɔ dana ɔsaa nɛ.<verse eid="ISA 14:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 14:30" />Ayematena man diyemte waa nyiŋ weenɛɛ di,</para>
  <para style="q2" vid="ISA 14:30">te ŋon ɔ be dana kolo ya nɛ waa doo keŋ ɔ be yee ya.</para>
  <para style="q1" vid="ISA 14:30">Mɔna n balaŋ dɔɔ maa mo tanam munu wɔ,</para>
  <para style="q2" vid="ISA 14:30">te ke gyae ka koe n balaŋ baŋ be kyaa nɛ.<verse eid="ISA 14:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="ISA 14:31" />Ao denaanɔɔ, lɔ nɔɔ! Ao donɔɔ dinaa, wii!</para>
  <para style="q2" vid="ISA 14:31">Ɛmɛɛ Filisitena pou, ɛ yela ɛ wɔe ke lɔ ŋon!</para>
  <para style="q1" vid="ISA 14:31">Ŋɔma nyɔɔse na lee bo ado yenaŋ,</para>
  <para style="q2" vid="ISA 14:31">te yoonɔɔte ŋolo be gyae waa wɔŋ ɔ wose lee wɔle ya.<verse eid="ISA 14:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 14:32" />Woŋ nɔɔ yaa baa tira fa,</para>
  <para style="q2" vid="ISA 14:32">kpilara baŋ bɔɔ lee Filisi kɔŋ nɛ?</para>
  <para style="q1" vid="ISA 14:32">&lt;&lt;Degbeŋgyoo te yele Siyɔn te kyaa gbeli,</para>
  <para style="q2" vid="ISA 14:32">ke man te ɔ balaŋ baŋ bɔɔ naase wɔ diyem nɛ baa yeu kagyoo.&gt;&gt;<verse eid="ISA 14:32" /></para>
  <chapter eid="ISA 14" />
  <chapter number="15" style="c" sid="ISA 15" />
  <para style="s1">Keyakosee tia Moabe</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 15:1" />Keyakosee tia Moabe,</para>
  <para style="q1" vid="ISA 15:1">ba te yɛlɛɛ Are keŋ kyaa Moabe,</para>
  <para style="q2" vid="ISA 15:1">nelim dokoloŋ te be wɔlɛɛ ke.</para>
  <para style="q1" vid="ISA 15:1">ba te yɛlɛɛ Kiri keŋ kyaa Moabe,</para>
  <para style="q2" vid="ISA 15:1">nelim dokoloŋ te be wɔlɛɛ ke.<verse eid="ISA 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 15:2" />Dibon ta gyem gyu wɔ ɔsom deni dinaa man,</para>
  <para style="q2" vid="ISA 15:2">ɔ te gyu ɔ bulasebia nyee dɔɔ ɔ kaa wii.</para>
  <para style="q2" vid="ISA 15:2">Moabe ne wii keŋkeŋ lee Nebo na Medeba dɔɔ.</para>
  <para style="q1" vid="ISA 15:2">be popou te gbee ba nyeeya,</para>
  <para style="q2" vid="ISA 15:2">te be gbee nɔɔfata kamasɛ.<verse eid="ISA 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 15:3" />Be wuu titirese abɔnterese man,</para>
  <para style="q2" vid="ISA 15:3">be popou lɔɔ nɔɔ,</para>
  <para style="q1" vid="ISA 15:3">be denɛɛ nyeeya dɔɔ na be dɛɛgyaŋeese man,</para>
  <para style="q2" vid="ISA 15:3">ba teneewɔ doo na bee wii.<verse eid="ISA 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 15:4" />Hɛsebon na Eleale ne lɔɔ nɔɔ,</para>
  <para style="q2" vid="ISA 15:4">ba woya ne lii naŋ Yahase.</para>
  <para style="q1" vid="ISA 15:4">Mena dɔɔ Moabe yoonɔɔtena ne lɔɔ nɔɔ keŋkeŋ,</para>
  <para style="q2" vid="ISA 15:4">te be wɔe lɔɔ wɔ.<verse eid="ISA 15:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 15:5" />Mee wii fa Moabe,</para>
  <para style="q2" vid="ISA 15:5">ɔ balaŋ te yekii kelii naŋ Soare,</para>
  <para style="q2" vid="ISA 15:5">menɛɛ kelii naŋ Egelate Selisiya.</para>
  <para style="q1" vid="ISA 15:5">Ba gyeŋawɔ gyu Luhite bula dɔɔ,</para>
  <para style="q2" vid="ISA 15:5">bee gyu na bee wii,</para>
  <para style="q1" vid="ISA 15:5">ba keta gbɛɛ bee gyu Horonayim nɛ,</para>
  <para style="q2" vid="ISA 15:5">ba toroŋwɔ lee mena keŋ bɔɔ wɔlɛɛ dɔɔ.<verse eid="ISA 15:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 15:6" />Nimerim loŋse ta yoo pou,</para>
  <para style="q2" vid="ISA 15:6">ŋe ŋalese pou ta boto,</para>
  <para style="q1" vid="ISA 15:6">ŋalese laŋ nyiŋan te taŋ,</para>
  <para style="q2" vid="ISA 15:6">te kolo laŋte te kaa ya.<verse eid="ISA 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 15:7" />Mena dɔɔ deediise ŋan bɔɔ nyim weese nɛ,</para>
  <para style="q2" vid="ISA 15:7">ba seele ŋa ka toŋ kateenaa daase boŋobii keŋ laŋ.<verse eid="ISA 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 15:8" />Be kewii yeesa lɛɛ Moabe tɛɛle wulu man,</para>
  <para style="q2" vid="ISA 15:8">be yeesa liiwɔ naŋ Egelayim,</para>
  <para style="q2" vid="ISA 15:8">be katoroŋ liiwɔ naŋ Bea Elim.<verse eid="ISA 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 15:9" />Fatabose te wulu,</para>
  <para style="q1" vid="ISA 15:9">Dimon booneŋ man,</para>
  <para style="q2" vid="ISA 15:9">maa bese mo abɔɔ ŋan kela kɛŋa kɔŋ Dimon</para>
  <para style="q1" vid="ISA 15:9">dinaate waa kɔŋ Moabetena baŋ bɔɔ yekii nɛ,</para>
  <para style="q2" vid="ISA 15:9">na baŋ bɔɔ kaa tɛɛle keŋ dɔɔ nɛ dɔɔ.<verse eid="ISA 15:9" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="ISA 15" />
  <chapter number="16" style="c" sid="ISA 16" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 16:1" />Ɛ mo namensebia ŋgba kefa nɛ,</para>
  <para style="q2" vid="ISA 16:1">lee Sela tana depampaa keŋ man,</para>
  <para style="q1" vid="ISA 16:1">ka mo Siyɔn alebu bula keŋ dɔɔ,</para>
  <para style="q2" vid="ISA 16:1">kefa ŋon ɔ ne di tɛɛle keŋ dɔɔ nɛ.<verse eid="ISA 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 16:2" />Mena keŋ be gegi gyebuse,</para>
  <para style="q2" vid="ISA 16:2">lee ba asaase man te bee furufu yeyɛɛ nɛ,</para>
  <para style="q1" vid="ISA 16:2">mena te Moabe ala,</para>
  <para style="q2" vid="ISA 16:2">baa yeyɛɛ be dɛɛ toŋae Anon boo keŋ.<verse eid="ISA 16:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 16:3" />Moabe kpa, &lt;&lt;Ɛ mo ya nyeempɔ,</para>
  <para style="q2" vid="ISA 16:3">ɛ wola daa keŋ dɛɛ yɛɛ.</para>
  <para style="q1" vid="ISA 16:3">Yela n wɔŋtaa ke yɛɛ ŋgba nelim nɛ,</para>
  <para style="q2" vid="ISA 16:3">weese gelegele.</para>
  <para style="q1" vid="ISA 16:3">Weese baŋ bɔɔ yekii nɛ,</para>
  <para style="q2" vid="ISA 16:3">Naa lese baŋ yoo be gegi wɔ nɛ fa ya.<verse eid="ISA 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 16:4" />Yela Moabetena baŋ bɔɔ gegi wɔ do ŋale ke kyaa n gyaŋ,</para>
  <para style="q2" vid="ISA 16:4">yela baa yo n gyaŋ lee wɔlɛɛre ŋon gyaŋ.&gt;&gt;</para>
  <para style="b" vid="ISA 16:4" />
  <para style="q1" vid="ISA 16:4">Kaŋeredote gyae ke kɔŋ ɔ to,</para>
  <para style="q2" vid="ISA 16:4">na kewɔlɛɛ ke tina yela,</para>
  <para style="q2" vid="ISA 16:4">baŋ bee yoo daa baa ŋaalaa tɛɛle keŋ dɔɔ.<verse eid="ISA 16:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 16:5" />Baa see gyoorogbeli kegyae man,</para>
  <para style="q2" vid="ISA 16:5">ŋolo waa kyaa ke dɔɔ anokoare kedi man,</para>
  <para style="q2" vid="ISA 16:5">waa lee Dawide dekpaŋalaŋ man,</para>
  <para style="q1" vid="ISA 16:5">waa di nombia kegbɛɛ dɔɔ,</para>
  <para style="q2" vid="ISA 16:5">waa kɛɛ nyi katenee nombia ke gyu bileŋbileŋ.<verse eid="ISA 16:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 16:6" />De nyii Moabe wose kegate,</para>
  <para style="q2" vid="ISA 16:6">mena keŋ ɔ ne yɛɛ agaŋtaŋ,</para>
  <para style="q1" vid="ISA 16:6">ɔ wose kawola na ɔ wose kegate na ɔ siadoŋ,</para>
  <para style="q2" vid="ISA 16:6">mɔna ɔ konɔɔ kegyɔ yɛɛ yakaa.<verse eid="ISA 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 16:7" />Mena dɔɔ Moabetena lɔɔ nɔɔ,</para>
  <para style="q2" vid="ISA 16:7">be yɛɛ dokoloŋ lɔɔ nɔɔ fa Moabe.</para>
  <para style="q1" vid="ISA 16:7">Ba toroŋwɔ te be mutiiwɔ,</para>
  <para style="q2" vid="ISA 16:7">lee Kire Haresete kyakpɛlɛbia dɔɔ.<verse eid="ISA 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 16:8" />Hɛsebon wɔɔse ta boto,</para>
  <para style="q2" vid="ISA 16:8">Sibema gerepo wɔɔse mɔ mena.</para>
  <para style="q1" vid="ISA 16:8">Baŋ bee di tɛɛlese dɔɔ,</para>
  <para style="q2" vid="ISA 16:8">te sakatee gerepo woŋse kpaakpaa nyiŋan,</para>
  <para style="q1" vid="ISA 16:8">ŋan nafɔ ŋee lii naŋ Yasere,</para>
  <para style="q2" vid="ISA 16:8">te be fɛlɛɛ kelii depampaa keŋ man nɛ.</para>
  <para style="q1" vid="ISA 16:8">ke tombia ne fɛlɛɛ,</para>
  <para style="q2" vid="ISA 16:8">kelii naŋ ɛpo nɔɔman.<verse eid="ISA 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 16:9" />Mena dɔɔ maa wii ŋgba mena keŋ Yasere,</para>
  <para style="q2" vid="ISA 16:9">ne wii fa Sibema gerepo woŋse nɛ.</para>
  <para style="q1" vid="ISA 16:9">Hɛsebon na Eleale,</para>
  <para style="q2" vid="ISA 16:9">maa mo siasaraŋ fɔ ŋon,</para>
  <para style="q1" vid="ISA 16:9">Kenyaŋee yeesa ŋan bɛɛ fae lee ɛ weenɛɛ bia ayɛɛ,</para>
  <para style="q2" vid="ISA 16:9">na ɛ weenɛɛ kekɛrɛɛ man te kaa dɔɔ.<verse eid="ISA 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 16:10" />Be ta lese kenyaŋee na gyoŋ kedi lee ɛ wɔɔse kpaakpaa man,</para>
  <para style="q2" vid="ISA 16:10">ŋolo bee kpee nɔɔneŋ, yaa waa fae yeesa gerepo wɔɔse ŋan man ya,</para>
  <para style="q1" vid="ISA 16:10">ŋolo bɛɛ ŋmaase gerepo lese waen be dɛɛ ŋmaasee keŋ man ya,</para>
  <para style="q2" vid="ISA 16:10">nawolo nyi ma te tɔ yeesa kefae gbɛɛ.<verse eid="ISA 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 16:11" />Me konɔɔ na toroŋ fa Moabe ŋgba adolɛɛ nɛ,</para>
  <para style="q2" vid="ISA 16:11">me tɔɔman ne kyoŋii maŋ fa Kire Haresete.<verse eid="ISA 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 16:12" />Nyi Moabe de gyu botɔɔ keŋ ɔ na som na,</para>
  <para style="q2" vid="ISA 16:12">ɔ ne naase ɔ wose diyem bo,</para>
  <para style="q1" vid="ISA 16:12">nyi ɔ gyu ɔ bane dɛɛ ɔ kaa fane na,</para>
  <para style="q2" vid="ISA 16:12">ke yɛɛ yakaa.<verse eid="ISA 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 16:13" />Kei yɛna nombii keŋ Degbeŋgyoo be wulaa kolosi kaalaŋ lee Moabe wose man. <verse eid="ISA 16:13" /><verse number="14" style="v" sid="ISA 16:14" />Mɔna nɛnɛɛ Degbeŋgyoo kpa, &lt;&lt;Kɛbo kulutooneŋ atooro wɔle ŋgba mena keŋ paate kulutooneŋ doo nɛ, baa do Moabe gyoorobiiri na ɔ balaŋ burum baŋ desɛŋ. Balaŋ kyomii ne gyaela baa ka, te bɔɔ gyae baa yɛɛ doŋ ya.&gt;&gt;<verse eid="ISA 16:14" /></para>
  <chapter eid="ISA 16" />
  <chapter number="17" style="c" sid="ISA 17" />
  <para style="s1">Keyakosee tia Damasekuse</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 17:1" />Keyakosee tia Damasekuse,</para>
  <para style="q1" vid="ISA 17:1">&lt;&lt;Kɛɛ, Damasekuse be gyae ke yɛɛ donɔɔ dinaa bela ya,</para>
  <para style="q2" vid="ISA 17:1">mɔna ke gyae ke yɛlɛɛ.<verse eid="ISA 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 17:2" />Baa bɛɛ Aroere donɔɔ dinaa keŋ,</para>
  <para style="q2" vid="ISA 17:2">na botɔɔ ka bese wonembia dedoi,</para>
  <para style="q2" vid="ISA 17:2">keŋ ŋolo be kyaa waa ŋmaase wɔ ya.<verse eid="ISA 17:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 17:3" />Dekyaŋ keŋ bɔɔ maa kilisi Ɛferayim donɔɔ dinaa keŋ,</para>
  <para style="q2" vid="ISA 17:3">na Damasekuse gyoori doŋ keŋ gyae ke ŋaalaa.</para>
  <para style="q1" vid="ISA 17:3">Aramtena akaŋ baŋ baa yɛɛ,</para>
  <para style="q2" vid="ISA 17:3">ŋgba Iseraetena gyoorobiiri nɛ,&gt;&gt;</para>
  <para style="q4" vid="ISA 17:3">Degbeŋgyoo Dekpataakpere ŋon torola yako.<verse eid="ISA 17:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 17:4" />Mena wee kenaŋ Yakɔbe gyoorobiiri gyae ke kɔɔkee,</para>
  <para style="q2" vid="ISA 17:4">na ɔ kekpare ke kɔɔkee.<verse eid="ISA 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 17:5" />Ke gyae ke yɛɛ ŋgba debaŋ keŋ bee tekerii wamela lee ŋe daase aseŋaŋ man,</para>
  <para style="q1" vid="ISA 17:5">te bɛɛ gɔɔtaa ŋa be nyiŋmaa man,</para>
  <para style="q1" vid="ISA 17:5">ŋgba debaŋ keŋ ŋolo ne gyalase wamela tɛɛle man,</para>
  <para style="q2" vid="ISA 17:5">Refayim detaŋgya man nɛ.<verse eid="ISA 17:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 17:6" />Mɔna ŋan bɛɛ gyalase tɛɛle man nɛ ŋaale gyae ke ka,</para>
  <para style="q2" vid="ISA 17:6">ŋgba mena keŋ be kɔ oliifi bia,</para>
  <para style="q1" vid="ISA 17:6">te bia ala yaa atooro ne kaa tombia ŋan doo adido adido man nɛ,</para>
  <para style="q2" vid="ISA 17:6">anaara yaa anoŋ ne dɔɔ nɔɔsebia apoteŋ wɔle ŋan man.&gt;&gt;</para>
  <para style="q4" vid="ISA 17:6">Degbeŋgyoo, Iserae Wurubuarɛ torola yako.<verse eid="ISA 17:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 17:7" />Wee kenaŋ balaŋ baa kɛɛ be yɛɛre gbɛɛ,</para>
  <para style="q2" vid="ISA 17:7">na baa besena be sia tee Iserae fereŋkyeŋte ŋon.<verse eid="ISA 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 17:8" />Bɔɔ gyae baa kɛɛ kedeesaboya,</para>
  <para style="q2" vid="ISA 17:8">ŋan bɔɔ mo be nyiŋmaase yɛɛ nɛ gbɛɛ ya,</para>
  <para style="q1" vid="ISA 17:8">te bɔɔ gyae baa mo bane alo Asera daase,</para>
  <para style="q2" vid="ISA 17:8">na oliifi kedeesaboya ŋan bɔɔ mo be nyiŋmaa yɛɛ nɛ yɛɛ kolo ya.<verse eid="ISA 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 17:9" />Wee kenaŋ be donɔɔse dinaana doŋ nyiŋaŋ ŋan bɔɔ tina yela lee Iseraetena dɔɔ nɛ, gyae ke yɛɛ ŋgba laaneŋ ŋan bɔɔ bɛɛ ŋa nɛ. Ŋe gyae ka bese donɔɔse ŋan be yɛlɛɛ.<verse eid="ISA 17:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 17:10" />N te wolee Wurubuarɛ n nyeelɛɛre,</para>
  <para style="q2" vid="ISA 17:10">n te tɔɔse n kpanaŋ na n gyeere ya.</para>
  <para style="q1" vid="ISA 17:10">Mena dɔɔ nyi n duu daase kpaakpaa nyiŋan,</para>
  <para style="q2" vid="ISA 17:10">te n kalaa gerepo woŋse lee tɛɛle wɔle man kaa duu,<verse eid="ISA 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 17:11" />nyi n yele ŋe de tuu wee keŋ n be buŋ ŋa,</para>
  <para style="q2" vid="ISA 17:11">te ŋe da lee kyeŋkyeŋkɔɔse nebo keŋ n be duu ŋa nɛ,</para>
  <para style="q1" vid="ISA 17:11">n be gyae n ke nyiŋ kɔ kekɛrɛɛtɛɛ ya,</para>
  <para style="q2" vid="ISA 17:11">ke ta bese kawee na weeleŋ keŋ taŋ kekyɔ ya wee.<verse eid="ISA 17:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 17:12" />Tɛɛlese burum ŋan ɛ ne muusu nɛ ɛ laako,</para>
  <para style="q2" vid="ISA 17:12">ŋɛɛ muusu ŋgba ɛpo kemuusu nɛ,</para>
  <para style="q1" vid="ISA 17:12">Balaŋ baŋ bee muusu nɛ baa laako,</para>
  <para style="q2" vid="ISA 17:12">bee muusu ŋgba booneŋ dinaana kemuusu nɛ.<verse eid="ISA 17:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 17:13" />Doo nyi balaŋ baŋ ne muusu ŋgba loŋse burum kemuusu koraŋ nɛ,</para>
  <para style="q2" vid="ISA 17:13">nyi ɔ kalena wɔ na baa yeu gyu lemlem,</para>
  <para style="q1" vid="ISA 17:13">ŋgba feliŋ ne gyɔɔna wurase bulasebia dɔɔ nɛ,</para>
  <para style="q2" vid="ISA 17:13">ŋgba koloŋoloŋ ne gyɔɔna ŋalese nɛ.<verse eid="ISA 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 17:14" />Balinɔɔ na gyakoloŋ na gyoo wɔ karatetee.</para>
  <para style="q2" vid="ISA 17:14">Tɛɛ kena na ba te lam.</para>
  <para style="q1" vid="ISA 17:14">Kei yɛna baŋ bɛɛ ŋmɛɛle daa nɛ wui dedii,</para>
  <para style="q2" vid="ISA 17:14">baŋ bee kuu da abɔɔ ne wui dedii.<verse eid="ISA 17:14" /></para>
  <chapter eid="ISA 17" />
  <chapter number="18" style="c" sid="ISA 18" />
  <para style="s1">Keyakosee tia Kuse</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 18:1" />Tɛɛle keŋ defeŋfeŋse beŋkelɛɛ be lɛɛ ke,</para>
  <para style="q2" vid="ISA 18:1">Kuse boo nɔɔman nɛ baa laako,<verse eid="ISA 18:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 18:2" />Bee kpila balaŋ ɛpo dɔɔ,</para>
  <para style="q2" vid="ISA 18:2">be doo morose agbelese man be dɔŋ loŋ dɔɔ.</para>
  <para style="b" vid="ISA 18:2" />
  <para style="q1" vid="ISA 18:2">kpilara ɔsaatena, ɛ ta,</para>
  <para style="q1" vid="ISA 18:2">gyu balaŋ baŋ be dana dɔɔloŋ te ba wose kyalasɛɛ nɛ gyaŋ,</para>
  <para style="q2" vid="ISA 18:2">gyu balaŋ baŋ bee yee wɔ lee lem na tiitii,</para>
  <para style="q1" vid="ISA 18:2">balaŋ baŋ be dana doŋ te bee di balaŋ dɔɔ,</para>
  <para style="q2" vid="ISA 18:2">baŋ booneŋ be kpase be tɛɛle nɛ gyaŋ.<verse eid="ISA 18:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 18:3" />Ɛmɛɛ tɛɛle kei dɔɔ balaŋ pou,</para>
  <para style="q2" vid="ISA 18:3">ɛmɛɛ baŋ ɛ kyaa tɛɛle kei dɔɔ,</para>
  <para style="q1" vid="ISA 18:3">nyi be gyina felage adido bula dɔɔ na,</para>
  <para style="q2" vid="ISA 18:3">ɛ ke naa ke,</para>
  <para style="q1" vid="ISA 18:3">ba wola kaberɛ mɔ na,</para>
  <para style="q2" vid="ISA 18:3">ɛ ke nyii ke.<verse eid="ISA 18:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 18:4" />Keŋ Degbeŋgyoo be yako maŋ yaa.</para>
  <para style="q2" vid="ISA 18:4">&lt;&lt;Maa kyaa ma dekyae man yididi na maa kɛɛ,</para>
  <para style="q1" vid="ISA 18:4">ŋgba weese kɛɛ gyɔɔ ŋarakee nɛ,</para>
  <para style="q2" vid="ISA 18:4">ŋgba weenɛɛ kekɛrɛɛtɛɛ obosuo kɛɛ yale lee debuŋta man nɛ.&gt;&gt;<verse eid="ISA 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 18:5" />Nawolo nyi pɛ weenɛɛ kekɛrɛɛ kelii, debaŋ keŋ kyeŋkyeŋkɔɔse be kpiisi,</para>
  <para style="q2" vid="ISA 18:5">na kyeŋkyeŋkɔɔse ŋan ka bese gerepo ayɛɛ nɛ,</para>
  <para style="q1" vid="ISA 18:5">waa mo ɔ sakawa kɛrɛɛ ŋan ba potee wɔlɛɛ nɛ,</para>
  <para style="q2" vid="ISA 18:5">na waa keretii tombia ŋan be kpase nɛ.<verse eid="ISA 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 18:6" />Baa tina ŋe popou yela fa gyebuse baŋ bɛɛ gyɔ wonembia,</para>
  <para style="q2" vid="ISA 18:6">na ŋale man wonembia,</para>
  <para style="q1" vid="ISA 18:6">gyebuse baa di ŋa degbututɛɛ pou,</para>
  <para style="q2" vid="ISA 18:6">na ŋale man wonembia ke di ŋa dekpaotɛɛ.<verse eid="ISA 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 18:7" />Debaŋ kenaŋ balaŋ baa mo abɔɔ kefa kɔŋa Degbeŋgyoo Dekpataakpere,</para>
  <para style="q1" vid="ISA 18:7">gyu balaŋ baŋ be dana dɔɔloŋ te ba wose kyalasɛɛ nɛ gyaŋ,</para>
  <para style="q2" vid="ISA 18:7">lee balaŋ baŋ bee yee wɔ lem na tiitii,</para>
  <para style="q1" vid="ISA 18:7">balaŋ baŋ be dana doŋ te bee di balaŋ dɔɔ,</para>
  <para style="q2" vid="ISA 18:7">te booneŋ be kpase be tɛɛle.</para>
  <para style="m" vid="ISA 18:7">Baa mo abɔɔkefa kɔŋ Siyɔn bula dɔɔ, botɔɔ keŋ Degbeŋgyoo Dekpataakpere ŋon yele doo nɛ.<verse eid="ISA 18:7" /></para>
  <chapter eid="ISA 18" />
  <chapter number="19" style="c" sid="ISA 19" />
  <para style="s1">Keyakosee tia Igyipite</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 19:1" />Keyakosee tia Igyipite,</para>
  <para style="q1" vid="ISA 19:1">Kɛɛ, Degbeŋgyoo dɔŋ debuŋta ɔsaate man,</para>
  <para style="q2" vid="ISA 19:1">ɔ ne kɔŋ Igyipite.</para>
  <para style="q1" vid="ISA 19:1">Igyipite bɛɛneŋ ne seree ɔ sia man,</para>
  <para style="q2" vid="ISA 19:1">te Igyipitetena woo te yeu lee gyakoloŋ dɔɔ.<verse eid="ISA 19:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="ISA 19:2" />&lt;&lt;Maa mo yoo do Igyipite na Igyipite nsana,</para>
  <para style="q2" vid="ISA 19:2">walaŋ na ɔ naabu baa yoo,</para>
  <para style="q2" vid="ISA 19:2">walaŋ na ɔ dɔɔ baa yoo,</para>
  <para style="q2" vid="ISA 19:2">donɔɔ dinaa na donɔɔ dinaa baa yoo,</para>
  <para style="q2" vid="ISA 19:2">gyooridedii na gyooridedii baa yoo.<verse eid="ISA 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 19:3" />Igyipitetena wose gyae ka yeŋ wɔ,</para>
  <para style="q2" vid="ISA 19:3">maa yela ba kebake ke yɛɛ yakaa,</para>
  <para style="q1" vid="ISA 19:3">baa gyu bɛɛneŋ na woya gyaŋ,</para>
  <para style="q2" vid="ISA 19:3">baa gyu gbale na baa baake woya.<verse eid="ISA 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 19:4" />Maa mo Igyipitetena baŋ do,</para>
  <para style="q2" vid="ISA 19:4">gbeŋgyoo tɔɔman ŋaŋte ŋolo nyiŋmaa man,</para>
  <para style="q1" vid="ISA 19:4">na gyoo nyeeman doŋte ŋolo ke di be dɔɔ.&gt;&gt;</para>
  <para style="q2" vid="ISA 19:4">Degbeŋgyoo Dekpataakpere ŋon torola yako.<verse eid="ISA 19:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 19:5" />Naele boo loŋse gyae ka yo,</para>
  <para style="q2" vid="ISA 19:5">na booneŋ ka yo wolo.<verse eid="ISA 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 19:6" />Boŋobiise gyae ka lee wɔŋ,</para>
  <para style="q2" vid="ISA 19:6">Igyipite boŋobiise gyae ke gyɔ aguŋ na ka yo.</para>
  <para style="q1" vid="ISA 19:6">ɔkpaŋ saboe na ŋalese gyae ka boto,<verse eid="ISA 19:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="ISA 19:7" />ŋalese ŋaale mɔ seŋɛɛ Naele nɔɔnɔɔ,</para>
  <para style="q2" vid="ISA 19:7">na boo keŋ nɔɔman,</para>
  <para style="q1" vid="ISA 19:7">wɔɔse ŋan bɔɔ fare Naele nɔɔnɔɔ,</para>
  <para style="q2" vid="ISA 19:7">gyae ka wolo, feliŋ gyae ke gyɔ ŋa na ŋa ke ŋaalaa.<verse eid="ISA 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 19:8" />Kpebia kyaŋara baa keketee na baa toroŋ,</para>
  <para style="q2" vid="ISA 19:8">baŋ bɛɛ lɔ darawaa Naele man,</para>
  <para style="q1" vid="ISA 19:8">na baŋ bɛɛ lɔ asawuse,</para>
  <para style="q2" vid="ISA 19:8">wose gyae ke kyaŋ wɔ nideli.<verse eid="ISA 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 19:9" />Baŋ bɛɛ mo dukurufa loo abɔɔ wose gyae ke tekerii wɔ,</para>
  <para style="q2" vid="ISA 19:9">baŋ bɛɛ mo akaralɛɛ loo abɔɔ loo gyae ka yeŋ wɔ.<verse eid="ISA 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 19:10" />Desɛŋ gyae ke kyaŋ kanyaŋ loora,</para>
  <para style="q2" vid="ISA 19:10">baŋ bɛɛ yɛɛ tomse te bɛɛ tɔ wɔ kom nɛ baa nyiŋ konɔɔ kawee.<verse eid="ISA 19:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 19:11" />Soan kyaarabia yɛɛ ayiŋtenawɔ,</para>
  <para style="q2" vid="ISA 19:11">Faaro nombia wolara ne kolosi diyiŋ nombia bo.</para>
  <para style="q1" vid="ISA 19:11">Sena te nyaŋ ke tale yako Faaro nyi,</para>
  <para style="q2" vid="ISA 19:11">&lt;&lt;Me yɛɛ siakaralatena baŋ man ŋolo e,</para>
  <para style="q2" vid="ISA 19:11">gyaŋgba gyooneŋ baŋ duuluŋ man bu&gt;&gt;?<verse eid="ISA 19:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 19:12" />Nɛnɛɛ nde n siakaralatena baŋ?</para>
  <para style="q2" vid="ISA 19:12">Yela baa lese keŋ,</para>
  <para style="q1" vid="ISA 19:12">Degbeŋgyoo Dekpataakpere ŋon,</para>
  <para style="q2" vid="ISA 19:12">be bake tia Igyipite nɛ wola neŋ<verse eid="ISA 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 19:13" />Soan kyaarabia te kaa bese ayiŋtena,</para>
  <para style="q2" vid="ISA 19:13">be ta beo Memefise siamantena,</para>
  <para style="q1" vid="ISA 19:13">ɔ balaŋ baŋ be yɛɛ kebɔtala man boya,</para>
  <para style="q2" vid="ISA 19:13">ta yooso Igyipite.<verse eid="ISA 19:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 19:14" />Degbeŋgyoo ta mo,</para>
  <para style="q2" vid="ISA 19:14">sia kebiri feliŋ do be man,</para>
  <para style="q1" vid="ISA 19:14">bee yele Igyipite ne kpaŋte lee ŋan pou ɔ ne yɛɛ nɛ man,</para>
  <para style="q2" vid="ISA 19:14">ŋgba mena keŋ soloŋ nyɔɔre ne kpaŋte ɔ tɔɔla man nɛ.<verse eid="ISA 19:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 19:15" />Kolo be doo keŋ Igyipite waa tale yɛɛ ya,</para>
  <para style="q2" vid="ISA 19:15">nyee yaa gyuŋ, ɔkɛɛ faareŋ yaa moro.<verse eid="ISA 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 19:16" />Wee kenaŋ Igyipitetena baa yɛɛ ŋgba ala nɛ. Gyakoloŋ gyae ka gyoo wɔ lee Degbeŋgyoo Dekpataakpere ŋon nyiŋmaa keŋ ɔ be gyina be dɔɔ nɛ dɔɔ. <verse eid="ISA 19:16" /><verse number="17" style="v" sid="ISA 19:17" />Yuda tɛɛle gyae ke yela gyakoloŋ ka gyoo Igyipitetena, walaŋ kamasɛ ŋon be baake Yuda yele ɔ gyaŋ na gyakoloŋ gyae ka gyoo e. Lee kpene keŋ Degbeŋgyoo Dekpataakpere ne bake tia wɔ nɛ dɔɔ.<verse eid="ISA 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 19:18" />Wee kenaŋ Igyipite donɔɔ dinaana anoŋ baa kolosi Kaana dei, na baa kaŋ ntam fa Degbeŋgyoo Dekpataakpere. Baa baake donɔɔ kenaŋ daale nyi, Weese donɔɔ dinaa.<verse eid="ISA 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 19:19" />Wee kenaŋ baa baŋ kedeesaboe Igyipite tɛɛle nsana nsana fa Degbeŋgyoo, na ketɔɔse boe ke wulu man fa Degbeŋgyoo. <verse eid="ISA 19:19" /><verse number="20" style="v" sid="ISA 19:20" />Ke gyae ke yɛɛ kagyene na adansɛɛ fa Degbeŋgyoo Dekpataakpere Igyipite tɛɛle man. Nyi be kɔlara da ŋere wɔ do te be wii baake Degbeŋgyoo na, waa lese nyeelɛɛre na gyeere fa wɔ na waa lɛɛ wɔ. <verse eid="ISA 19:20" /><verse number="21" style="v" sid="ISA 19:21" />Degbeŋgyoo waa lese ɔ wose wola Igyipitetena, na baa lɛɛ Degbeŋgyoo di wee kenaŋ na baa mo kedeesase na weenɛɛ kedeesase som. Baa kaŋ ntam fa Degbeŋgyoo na baa di ke dɔɔ. <verse eid="ISA 19:21" /><verse number="22" style="v" sid="ISA 19:22" />Degbeŋgyoo waa mo kaweekum lɔ Igyipite dɔɔ. Waa mo lɔ be dɔɔ na waa kyɔ wɔ. Baa bese kɔŋ Degbeŋgyoo gyaŋ na waa nyii be kasola na waa kyɔ wɔ be ka weese.<verse eid="ISA 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 19:23" />Wee kenaŋ gbɛɛ dinaa gyae ke doo lee Igyipite gyu Asiriya. Asiriyatena baa gyu Igyipite na Igyipitetena mɔ ke gyu Asiriya. Igyipitetena na Asiriyatena baa som debodokoloŋ. <verse eid="ISA 19:23" /><verse number="24" style="v" sid="ISA 19:24" />Wee kenaŋ Iserae ne gyaela ke yɛɛ donɔɔ dinaa atoorote gyakaa Igyipite na Asiriya dɔɔ. Be dɔɔ te Degbeŋgyoo waa ta hiraa tɛɛle kei pou. <verse eid="ISA 19:24" /><verse number="25" style="v" sid="ISA 19:25" />Degbeŋgyoo Dekpataakpere waa hiraa wɔ yako nyiaa, &lt;&lt;Me te hiraa ŋon me balaŋ Igyipite, me nyiŋmaa man tom Asiriya na me dedii Iserae.&gt;&gt;<verse eid="ISA 19:25" /></para>
  <chapter eid="ISA 19" />
  <chapter number="20" style="c" sid="ISA 20" />
  <para style="s1">Keyakosee tia Igyipite na Kuse</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 20:1" />Kulutoo keŋ Asiriya gyoo Saregɔn be kpila yoonɔɔte dinaa gyu ke yoo tia Asedode donɔɔ te ɔ ba mo ke nɛ, <verse eid="ISA 20:1" /><verse number="2" style="v" sid="ISA 20:2" />debaŋ kenaŋ te Degbeŋgyoo kolosiwɔ ta Amose bu Yesaya dɔɔ. Ɔ yako e nyiaa, &lt;&lt;Kpee titere keŋ lee n wose man na n ka kpee nyaŋ nkyokotase.&gt;&gt; Te ɔ yɛɛwɔ mena, na ɔ dɔŋ deteŋteli na naawɔɔ wolo.<verse eid="ISA 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 20:3" />Keŋte Degbeŋgyoo yakowɔ nyiaa, &lt;&lt;Mena keŋ me tobaale Yesaya be tɛɛ deteŋteli na nawɔɔ wolo kulutooneŋ atooro nɛ, keŋ yɛna kagyene te seŋɛɛfa keŋ ne tia Igyipite na Kuse, <verse eid="ISA 20:3" /><verse number="4" style="v" sid="ISA 20:4" />mena te Asiriya gyoo waa tina Igyipitetena baŋ ɔ be yoo kyaŋ na Kusetena baŋ be doo gbeŋiri man nɛ yela baa ta deteŋteli na ba mokɔɔse lekɛɛ, na naawɔɔ wolo. Be kegyiise na bia pou na ka mo do Igyipite desɛŋ. <verse eid="ISA 20:4" /><verse number="5" style="v" sid="ISA 20:5" />Baŋ bɛɛ mo ba wose lɔ Kuse dɔɔ te bɛɛ gyɔ be konɔɔ Igyipite dɔɔ nɛ, ba awoya gyae ke yɔkɔse wɔ na desɛŋ ke kyaŋ wɔ. <verse eid="ISA 20:5" /><verse number="6" style="v" sid="ISA 20:6" />Wee kenaŋ baŋ be kyaa boo nɔɔman nɛ baa yako nyiaa, &lt;Kɛɛ keŋ be kɔŋ baŋ dɔɔ mo da wose lɔ be dɔɔ nɛ dɔɔ, baŋ doo yeu ke tuŋ nyi baa kyɔ na baa lɛɛ daa lee Asiriya gyoo nyiŋmaa man nɛ. Nɛnɛɛ sena yaa dɛɛ yɛɛ na dɛɛ yeu lee ke man?&gt;&gt;&gt;<verse eid="ISA 20:6" /></para>
  <chapter eid="ISA 20" />
  <chapter number="21" style="c" sid="ISA 21" />
  <para style="s1">Keyakosee tia Babilɔn</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 21:1" />Keyakosee keŋ ne tia depampaa keŋ kyaa ɛpo nɔɔman nɛ.</para>
  <para style="q1" vid="ISA 21:1">Mena keŋ koloŋoloŋ ne gyɔɔ lee ata yenaŋ depampaa man kɔŋ nɛ,</para>
  <para style="q2" vid="ISA 21:1">mena te nombiikum na lee depampaa man kɔŋ,</para>
  <para style="q2" vid="ISA 21:1">kɛɛ lee tɛɛle keŋ ke dana gyakoloŋ nɛ man.<verse eid="ISA 21:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 21:2" />Ba lese gyakoloŋ nombii daale wola maŋ,</para>
  <para style="q2" vid="ISA 21:2">Ŋon ɔ ne ŋmaa abɔɔ ne ŋmaa, ŋon ɔ ne wɔlɛɛ ne wɔlɛɛ,</para>
  <para style="q1" vid="ISA 21:2">Elam, yoo! Media tɔ wɔ do!</para>
  <para style="q2" vid="ISA 21:2">Maa yela ɔ katoroŋ keŋ ɔ ba mo kɔŋ nɛ kekɔŋ ɔto.<verse eid="ISA 21:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 21:3" />Kei yela mee nyii weeleŋ,</para>
  <para style="q2" vid="ISA 21:3">mɛɛ keŋee ŋgba alo ŋon ɔ na doŋee nɛ.</para>
  <para style="q1" vid="ISA 21:3">Ma wose ta yeŋ maŋ lee keŋ mɔɔ nyii nɛ dɔɔ,</para>
  <para style="q2" vid="ISA 21:3">ma wose ne seree maŋ lee keŋ mɔɔ naa dɔɔ.<verse eid="ISA 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 21:4" />Ma nyeempɔ te yɛɛ maŋ ala ala,</para>
  <para style="q2" vid="ISA 21:4">gyakoloŋ te yele mee seree,</para>
  <para style="q2" vid="ISA 21:4">balinɔɔ keŋ mɛɛ kɛɛ ke gbɛɛ nɛ,</para>
  <para style="q2" vid="ISA 21:4">ta bese kolo ne ŋmaase maŋ.<verse eid="ISA 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 21:5" />Ba see tebuluse ŋan,</para>
  <para style="q2" vid="ISA 21:5">be lɔɔ afoŋoŋse tɛɛle man,</para>
  <para style="q1" vid="ISA 21:5">be diiwɔ, be nyɔɔwɔ!</para>
  <para style="q2" vid="ISA 21:5">Ɛmɛɛ kyaarabia, ɛ koro,</para>
  <para style="q1" vid="ISA 21:5">ɛ tiu ɛ yoo nyeela pampasaŋse ŋan nuŋ!<verse eid="ISA 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 21:6" />Kei yɛna keŋ Degbeŋgyoo be yako maŋ,</para>
  <para style="q1" vid="ISA 21:6">&lt;&lt;Gyu, ka lese gyeere see,</para>
  <para style="q2" vid="ISA 21:6">yela waa yako kpene keŋ ɔ be naa.<verse eid="ISA 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 21:7" />Akpaa ɔ naa dɛɛkyɔŋse</para>
  <para style="q2" vid="ISA 21:7">bala bala ne wɔŋee anebiliŋiŋse,</para>
  <para style="q1" vid="ISA 21:7">afurumse kyaara,</para>
  <para style="q2" vid="ISA 21:7">yaa kurumɔɔse kyaara nɛ,</para>
  <para style="q1" vid="ISA 21:7">waa see deŋele,</para>
  <para style="q2" vid="ISA 21:7">waa see deŋele nideli.&gt;&gt;<verse eid="ISA 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 21:8" />Keŋte gyeere ŋon fae yeesa nyiaa,</para>
  <para style="q1" vid="ISA 21:8">&lt;&lt;Me gbeŋgyoo, wee na wee na ma seŋɛɛ me dɛɛgyee keŋ,</para>
  <para style="q2" vid="ISA 21:8">nelim kamasɛ na ma seŋɛɛ ma tom man.<verse eid="ISA 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 21:9" />Kɛɛ, baale ŋolo kyaa anebiliŋiŋ dɔɔ,</para>
  <para style="q2" vid="ISA 21:9">kpuna dɛɛkyɔŋse kyaara bala bala ne kɔŋala nɛ.</para>
  <para style="q1" vid="ISA 21:9">Keŋte ɔ tiranɔɔ nyiaa,</para>
  <para style="q2" vid="ISA 21:9">&lt;Babilɔn te yɛlɛɛ, ka te yɛlɛɛ!</para>
  <para style="q1" vid="ISA 21:9">Ba te tekerii ɔ bɛɛneŋ pou,</para>
  <para style="q2" vid="ISA 21:9">lɔ tɛɛle man!&gt;&gt;<verse eid="ISA 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 21:10" />Ao, me balaŋ baŋ bɔɔ nam abɔɔ defeefui e ŋgba aboŋ nɛ,</para>
  <para style="q1" vid="ISA 21:10">me yako ŋon keŋ mɔɔ nyii,</para>
  <para style="q2" vid="ISA 21:10">lee Degbeŋgyoo Dekpataakpere ŋon gyaŋ,</para>
  <para style="q1" vid="ISA 21:10">lee Iseraetena Wurubuarɛ ŋon gyaŋ.<verse eid="ISA 21:10" /></para>
  <para style="s1">Keyakosee tia Edom</para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 21:11" />Nombii keŋ Wurubuarɛ be yako tia Duma nɛ yaa,</para>
  <para style="q1" vid="ISA 21:11">Ŋolo baake maŋ lee Seire bɔɔse nyiaa,</para>
  <para style="q2" vid="ISA 21:11">&lt;&lt;Gyeere, tɛɛ te naata yee?, Gyeere, tɛɛ te naata yee?&gt;&gt;<verse eid="ISA 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 21:12" />Gyeere ŋon tiranɔɔ nyiaa,</para>
  <para style="q2" vid="ISA 21:12">&lt;&lt;Teka kyomii na tɛɛ ke naa, mɔna tɛɛ gyae ka bese yuu bela.&gt;&gt;</para>
  <para style="q1" vid="ISA 21:12">Nyi akpaa ɛ ke bɔɔse na, ɛ bɔɔse</para>
  <para style="q2" vid="ISA 21:12">na ɛ ka bese kɔŋ.&gt;&gt;<verse eid="ISA 21:12" /></para>
  <para style="s1">Keyakosee tia Arabia</para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 21:13" />Keyakosee tia Arabia yaa,</para>
  <para style="q1" vid="ISA 21:13">Ɛmɛɛ Dedanetena dikpii,</para>
  <para style="q2" vid="ISA 21:13">baŋ ɛ be yilaa Arabia laa man,<verse eid="ISA 21:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 21:14" />ɛmɛɛ baŋ ɛ kyaa Tema,</para>
  <para style="q2" vid="ISA 21:14">ɛ mo loŋ kɔna baŋ loŋboaneŋ na ko wɔ,</para>
  <para style="q2" vid="ISA 21:14">ɛ mo weenɛɛ kɔna baŋ bɔɔ yeu lee yoo man.<verse eid="ISA 21:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 21:15" />Nawolo nyi be yeu yaa lee yoosilase nɔɔman,</para>
  <para style="q2" vid="ISA 21:15">lee yoosila keŋ bɔɔ wɔm nɛ nɔɔman,</para>
  <para style="q1" vid="ISA 21:15">lee baŋdaŋ keŋ bɔɔ wɔm,</para>
  <para style="q2" vid="ISA 21:15">na yoo keŋ ke nɔɔ dana doŋ nɛ nɔɔman.<verse eid="ISA 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 21:16" />Keŋ Degbeŋgyoo be yako maŋ yɛna nyiaa,</para>
  <para style="q1" vid="ISA 21:16">&lt;&lt;Kɛbo kulutoo dokoloŋ man, ŋgba mena keŋ paate ne kala ɔ weeya nɛ,</para>
  <para style="q2" vid="ISA 21:16">Kedare gyoorobiiri pou gyae ke kɔŋ ɔto.&gt;&gt; <verse eid="ISA 21:16" /><verse number="17" style="v" sid="ISA 21:17" />Degbeŋgyoo, Iseraetena Wurubuarɛ kpa, &lt;&lt;Baŋdaŋ tɔɔra na Kedare yoonɔɔtena doŋ nyibaŋ burum. baa ka kyomii bo.&gt;&gt;<verse eid="ISA 21:17" /></para>
  <chapter eid="ISA 21" />
  <chapter number="22" style="c" sid="ISA 22" />
  <para style="s1">Keyakosee lee Yerusalɛm wose man</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 22:1" />Kei yɛna keyakosee keŋ ne tia Kalesewola Detaŋgya keŋ.</para>
  <para style="q1" vid="ISA 22:1">Nɛnɛɛ woŋ ne yɛɛna ŋon,</para>
  <para style="q2" vid="ISA 22:1">te ɛ balaŋ pou gyeŋawɔ kekyaa deni nyee dɔɔ,<verse eid="ISA 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 22:2" />nyaŋ donɔɔ keŋ yeesa be wulu,</para>
  <para style="q2" vid="ISA 22:2">kekolosi na kenyaŋee donɔɔ dinaa?</para>
  <para style="q1" vid="ISA 22:2">Na yoosila te ba moowɔ koe n balaŋ ya,</para>
  <para style="q2" vid="ISA 22:2">te na yooman te ba yekeewɔ ya.<verse eid="ISA 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 22:3" />N siamantena pou te yɛɛ nɔɔ yekii,</para>
  <para style="q2" vid="ISA 22:3">na baŋdaŋ te ba moowɔ di be dɔɔ ya,</para>
  <para style="q1" vid="ISA 22:3">Keŋ na ba keyeu gyu lemlem koraŋ nɛ,</para>
  <para style="q2" vid="ISA 22:3">be tuŋa wɔ te be kyaŋa wɔ,<verse eid="ISA 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 22:4" />Mena dɔɔ me yakowɔ nyiaa, &lt;&lt;Ɛ lese ɛ sia lee me dɔɔ,</para>
  <para style="q2" vid="ISA 22:4">yela maa wii nideli,</para>
  <para style="q1" vid="ISA 22:4">Ɛ naa naase ɛ wose diyem nyi ɛ ke kyɔlɛɛ maŋ,</para>
  <para style="q2" vid="ISA 22:4">nyi be ta koe me balaŋ dɔɔ ya.&gt;&gt;<verse eid="ISA 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 22:5" />Degbeŋgyoo, Degbeŋgyoo Dekpataakpere dana wee,</para>
  <para style="q2" vid="ISA 22:5">keŋ kekolosi na kewɔlɛɛ na donɔɔ kesiŋii gyae kekɔŋ,</para>
  <para style="q1" vid="ISA 22:5">kalesewola detaŋgya keŋ man.</para>
  <para style="q2" vid="ISA 22:5">Wee keŋ baa tekerii akyaŋse lɔ,</para>
  <para style="q1" vid="ISA 22:5">na be kewii kelii bulase dɔɔ.<verse eid="ISA 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 22:6" />Elam baana baŋdaŋ na ke bɔɔlee,</para>
  <para style="q2" vid="ISA 22:6">kpuna baŋ be kyaa anebiliŋiŋse na dɛɛkyɔŋse dɔɔ bɛɛ kɔŋ,</para>
  <para style="q1" vid="ISA 22:6">te Kiri lese ɔ yoonyeele pampasaŋ debɔɔ.<verse eid="ISA 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 22:7" />Anebiliŋiŋse te wulu ɛ detaŋgyase kpaakpaa nyiŋan man,</para>
  <para style="q2" vid="ISA 22:7">te dɛɛkyɔŋ kyaara seŋɛɛ donɔɔ dinaa keŋ anaanɔɔse man.<verse eid="ISA 22:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 22:8" />Degbeŋgyoo ta lese keŋ ne gyee Yuda nɛ,</para>
  <para style="q2" vid="ISA 22:8">wee kenaŋ ɛ moo ɛ sia gyakaa</para>
  <para style="q2" vid="ISA 22:8">laa gyooro dekpaŋalaŋ keŋ yoo abɔɔ dɔɔ.<verse eid="ISA 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 22:9" />Ɛ naawɔ nyi ba te yɛlɛɛ</para>
  <para style="q2" vid="ISA 22:9">Dawide donɔɔ dinaa keŋ akyaŋse burum,</para>
  <para style="q1" vid="ISA 22:9">te ɛ tɔɔ atayenaŋ</para>
  <para style="q2" vid="ISA 22:9">loŋse ŋan gbɛɛ.<verse eid="ISA 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 22:10" />Ɛ kala Yerusalɛm denɛɛ ŋan,</para>
  <para style="q2" vid="ISA 22:10">te ɛ yɛlɛɛ akpaŋalaŋse nyi ɛ ka mo ŋa boya desina dekyaŋ keŋ.<verse eid="ISA 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 22:11" />Ɛ baŋa loŋ dɛɛlɛedo akyaŋse ala ŋan nsana,</para>
  <para style="q2" vid="ISA 22:11">na depaa bene keŋ loŋ kaa gyoo ke man,</para>
  <para style="q1" vid="ISA 22:11">mɔna ɛ te kɛɛ ŋon ɔ be yɛɛ ke ya,</para>
  <para style="q2" vid="ISA 22:11">ɛ ta mo obuo fa ŋon ɔ be bake ke see lee beneŋ beneŋ keŋ ya.<verse eid="ISA 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 22:12" />Degbeŋgyoo, Degbeŋgyoo Dekpataakpere ŋon,</para>
  <para style="q2" vid="ISA 22:12">baake ŋon wee kenaŋ</para>
  <para style="q1" vid="ISA 22:12">nyi yaa lɔ nɔɔ na ɛ ke wii,</para>
  <para style="q2" vid="ISA 22:12">nyi yaa gbee ɛ nyeenyɔɔse na ɛ ke wuu titerese.<verse eid="ISA 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 22:13" />Mɔna kɛɛ, yɛɛ ŋon gyoŋ te ɛ nyaŋeewɔ,</para>
  <para style="q2" vid="ISA 22:13">ɛ kɛrɛɛ nunkyuese nyeeya, te ɛ koo namense,</para>
  <para style="q1" vid="ISA 22:13">ɛ tao naane te ɛ nyɔɔ waen!</para>
  <para style="q2" vid="ISA 22:13">Ɛ yakowɔ nyiaa,&lt;&lt;Ɛ yela dee di na dɛɛ nyɔɔ,</para>
  <para style="q1" vid="ISA 22:13">nawolo nyi kyoo kaageŋ na de ta yem!&gt;&gt;<verse eid="ISA 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 22:14" />Mɔna Degbeŋgyoo Dekpataakpere ŋon, wɔɔna maŋ gela kei nyiaa, &lt;&lt;Bɔɔ gyae baa mo dukum kei kyɛɛ ŋon, kaboena ɛ ka mo yekee ya. Degbeŋgyoo Dekpataakpere ŋon torola yako.&gt;&gt;<verse eid="ISA 22:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="ISA 22:15" />Kei yɛna keŋ Degbeŋgyoo, Degbeŋgyoo Dekpataakpere ŋon ne yako,</para>
  <para style="q1" vid="ISA 22:15">&lt;&lt;Gyu, ke yako ŋon ɔ ne kɛɛ abɔɔ dɔɔ,</para>
  <para style="q2" vid="ISA 22:15">Sɛbena ŋon ɔ ne kɛɛ gyooro dekpaŋalaŋ keŋ dɔɔ nɛ nyiaa,<verse eid="ISA 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 22:16" />Woŋ yaa n ne yɛɛ kɛbo te amɔte faana neŋ gbɛɛ,</para>
  <para style="q2" vid="ISA 22:16">nyi nyaa lese n yebɔɔ kɛbo,</para>
  <para style="q1" vid="ISA 22:16">te n ne kara yebɔɔ botɔɔ keŋ korɛɛ,</para>
  <para style="q1" vid="ISA 22:16">te n ne kara n dɛɛfɛɛfoe kpanaŋ man?<verse eid="ISA 22:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 22:17" />Kɛɛ, nyaŋ walaŋ doŋte,</para>
  <para style="q2" vid="ISA 22:17">Degbeŋgyoo ne gyae waa lɔ kyaŋ neŋ,</para>
  <para style="q1" vid="ISA 22:17">na waa fuŋ neŋ lɔ.<verse eid="ISA 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 22:18" />Waa biliŋi neŋ ŋgba bɔɔlo nɛ,</para>
  <para style="q2" vid="ISA 22:18">na waa fuŋ neŋ kelɔ tɛɛle keŋ fɛlɛɛ nɛ dɔɔ,</para>
  <para style="q1" vid="ISA 22:18">botɔɔ te nyaŋ ka yeŋ,</para>
  <para style="q2" vid="ISA 22:18">botɔɔ te nya anebiliŋiŋse kpaakpaa nyiŋan, ŋan dɔɔ n ne yɛɛ agaŋtaŋ nɛ,</para>
  <para style="q1" vid="ISA 22:18">gyae ka bese desɛŋ kolo fa n gbeŋgyoo dekpaŋalaŋmantena.<verse eid="ISA 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 22:19" />Maa lese neŋ lee n gbeli dɔɔ,</para>
  <para style="q2" vid="ISA 22:19">na maa tisina neŋ lee n daseŋae man.<verse eid="ISA 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 22:20" />Mena wee kenaŋ maa baake me tobaale Eliyakim, ŋon ɔ kya yɛna Hilikiya nɛ.<verse eid="ISA 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 22:21" />Maa mo n kegba wurikyim do e, na maa mo keŋ n na mo kpaŋ gyakaa wurikyim keŋ dɔɔ nɛ kpaŋ e, na maa mo n doŋ keŋ do e ɔ nyiŋmaa man. Waa yɛɛ Yerusalɛmtena na Yudatena be kya. <verse eid="ISA 22:21" /><verse number="22" style="v" sid="ISA 22:22" />Maa mo Dawide dekpaŋalaŋ safowaa do e ɔ nyiŋmaa man, keŋ ɔ toro na ŋolo be tale tɔ ya, te ɔ tɔɔ na ŋolo be tale toro ya. <verse eid="ISA 22:22" /><verse number="23" style="v" sid="ISA 22:23" />Maa gyɔ e ŋgba tuula nɛ do botɔɔ keŋ dana doŋ, waa bese gbeli, obuo gyae keta ɔ dɔɔ bo kɔŋ ɔ kya dekpaŋalaŋ. <verse eid="ISA 22:23" /><verse number="24" style="v" sid="ISA 22:24" />Ɔ loŋtona pou baa yɛɛ kasolɔ ɔ dɔɔ. Baa yɛɛ ŋgba nyefalɛɛ na osuŋse ŋan wuluŋɛɛ tuula dɔɔ nɛ.<verse eid="ISA 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 22:25" />Degbeŋgyoo Dekpataakpere ŋon kpa nyiaa, &lt;&lt;Wee kenaŋ nɛ, tuula keŋ bɔɔ gyɔɔ do botɔɔ keŋ dana doŋ nɛ gyae ke gɛɛse na ke kulu, na kasolɔ keŋ wuluŋɛɛ ke dɔɔ nɛ ka lee yala.&gt;&gt; Degbeŋgyoo torola yako.<verse eid="ISA 22:25" /></para>
  <chapter eid="ISA 22" />
  <chapter number="23" style="c" sid="ISA 23" />
  <para style="s1">Keyakosee tia Tore</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 23:1" />Keyakosee keŋ ne tia Tiro nɛ yaa,</para>
  <para style="q1" vid="ISA 23:1">Ɛmɛɛ Taresisi agbelese dinaana, ɛ lɔ nɔɔ!</para>
  <para style="q2" vid="ISA 23:1">Nawolo nyi ba te wɔlɛɛ Tiro,</para>
  <para style="q2" vid="ISA 23:1">denɛɛ yaa agbelese dɛɛseŋae be doo ya,</para>
  <para style="q1" vid="ISA 23:1">Kipero tɛɛle man</para>
  <para style="q2" vid="ISA 23:1">te ba lese ke wola wɔ.<verse eid="ISA 23:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="ISA 23:2" />Ɛmɛɛ baŋ ɛ kyaa ɛpo nɔɔman,</para>
  <para style="q1" vid="ISA 23:2">na Sidɔn kebudiira</para>
  <para style="q2" vid="ISA 23:2">baŋ ɛpo dɔɔ kebudiira be yele ɛ be nyiŋ ɛ wose, ɛ yɛɛ yididi,<verse eid="ISA 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 23:3" />Ɛ kyaawɔ loŋse dɔɔ,</para>
  <para style="q2" vid="ISA 23:3">mo weenɛɛ lee Sihore,</para>
  <para style="q1" vid="ISA 23:3">Naele weenɛɛ akɛrɛɛŋ yɛna toto fa Tiro</para>
  <para style="q1" vid="ISA 23:3">te botɔɔ kaa bese tɛɛlese kebu dedii,<verse eid="ISA 23:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 23:4" />Sidɔn na ɛpo gyeere, desɛŋ dɛɛ kyaŋ ŋon,</para>
  <para style="q2" vid="ISA 23:4">nawolo nyi ɛpo te kolosi,</para>
  <para style="q1" vid="ISA 23:4">&lt;&lt;Me ta doŋeeta see, yaa maa lola see ya,</para>
  <para style="q2" vid="ISA 23:4">ma te kɛɛleta bia baala yaa bia ala see ya.&gt;&gt;<verse eid="ISA 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 23:5" />Akpaa Igyipitetena de nyii nombii kei nɛ,</para>
  <para style="q2" vid="ISA 23:5">gyae ke takaa wɔ nideli ŋgba bɔɔ nyii ke lee Tiro nɛ.<verse eid="ISA 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 23:6" />Ɛmɛɛ baŋ ɛ kyaa ɛpo nɔɔman,</para>
  <para style="q2" vid="ISA 23:6">ɛ gbaa gyu Taresisi na ɛ ke di waraŋsa,<verse eid="ISA 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 23:7" />Kei yɛna ɛ donɔɔ dinaa keŋ ɛ ne nyaŋee ke dɔɔ,</para>
  <para style="q2" vid="ISA 23:7">donɔɔ dinaa bene bene keŋ,</para>
  <para style="q1" vid="ISA 23:7">ke nawɔɔ ba mo ke gyu,</para>
  <para style="q2" vid="ISA 23:7">ke kyaa tɛɛle lem lem nɛ yaa?<verse eid="ISA 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 23:8" />Amɔte bakena mena nyeeman kei tia Tiro,</para>
  <para style="q2" vid="ISA 23:8">ŋon ɔ ne wuu balaŋ gyooro kotɔtɔɔse,</para>
  <para style="q2" vid="ISA 23:8">ɔ kebudiira yɛɛ gyoorobiawɔ,</para>
  <para style="q1" vid="ISA 23:8">baŋ bɛɛ lɛɛ wa abɔɔ dana yele tɛɛle dɔɔ.<verse eid="ISA 23:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 23:9" />Degbeŋgyoo Dekpataakpere te bake nyi,</para>
  <para style="q2" vid="ISA 23:9">waa yela agaŋtaŋtena wosekenyiŋ pou ke yɛɛ yakaa,</para>
  <para style="q2" vid="ISA 23:9">na waa yɔkɔse baŋ pou be dana yele tɛɛle dɔɔ.<verse eid="ISA 23:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 23:10" />Nyaŋ Taresisi bu alebu,</para>
  <para style="q2" vid="ISA 23:10">fara n tɛɛle fɛlɛɛ ŋgba Naele nɛ,</para>
  <para style="q2" vid="ISA 23:10">nawolo nyi kolo be kyaa ke tɔ neŋ gbɛɛ ya.<verse eid="ISA 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 23:11" />Degbeŋgyoo ta tenee ɔ nyiŋmaa tee ɛpo,</para>
  <para style="q2" vid="ISA 23:11">ɔ yela ke gyooridediise sereewɔ.</para>
  <para style="q1" vid="ISA 23:11">Ɔ te fa mmaraa lee Kaana wose man nyi,</para>
  <para style="q2" vid="ISA 23:11">baa wɔlɛɛ akyaŋse ŋan pou ne gyee e.<verse eid="ISA 23:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 23:12" />Ɔ yakowɔ nyiaa, &lt;&lt;N be gyae n ka tekaa nyaŋee ya,</para>
  <para style="q2" vid="ISA 23:12">Nyaŋ Sidɔn alebu keteŋ, ba te wɔlɛɛ neŋ!</para>
  <para style="b" vid="ISA 23:12" />
  <para style="q1" vid="ISA 23:12">Koro, gbaa gyu Kiperose,</para>
  <para style="q2" vid="ISA 23:12">botɔɔ koraŋ n wose be gyae ke fɛɛ neŋ ya.&gt;&gt;<verse eid="ISA 23:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 23:13" />Kɛɛ Babilɔntena tɛɛle keŋ,</para>
  <para style="q2" vid="ISA 23:13">nɛnɛɛ ka te yɛɛ tɛɛle ke ya!</para>
  <para style="q1" vid="ISA 23:13">Asiriyatena te yele ke ta bese</para>
  <para style="q2" vid="ISA 23:13">ŋale man wonembia dekyae,</para>
  <para style="q1" vid="ISA 23:13">be baŋee akagyase na baa mo yoona donɔɔ dinaa keŋ,</para>
  <para style="q1" vid="ISA 23:13">be tekerii botɔɔse ŋan ne gyee wɔ nɛ,</para>
  <para style="q2" vid="ISA 23:13">te be wɔlɛɛ dekyaŋ keŋ.<verse eid="ISA 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 23:14" />Ɛmɛɛ Taresisi pantuuse dinaana, ɛ lɔ nɔɔ,</para>
  <para style="q2" vid="ISA 23:14">ba te wɔlɛɛ ɛ dekyaŋ keŋ!<verse eid="ISA 23:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 23:15" />Debaŋ kenaŋ nɛ, baa wolee Tiro kulutooneŋ sɔŋotooro na kufu, keŋ yɛɛ gyoo ŋolo kulutooneŋ ŋan ɔ be dii nɛ. Mɔna kulutooneŋ sɔŋotooro na kufu kei wɔle nɛ, gyae ke yɛɛ Tiro ŋgba futooli alo ŋon nɔɔneŋ nyi,<verse eid="ISA 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 23:16" />&lt;&lt;Nyaŋ futooli alo ŋon bɔɔ wolee neŋ,</para>
  <para style="q2" vid="ISA 23:16">Mo nya adolɛɛ, kila donɔɔ dinaa keŋ man,,</para>
  <para style="q1" vid="ISA 23:16">gyɔ nya adolɛɛ keŋ nideli, kpee nɔɔneŋse burum,</para>
  <para style="q2" vid="ISA 23:16">na baa tɔɔse neŋ bela&gt;&gt;<verse eid="ISA 23:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 23:17" />Kulutooneŋ sɔŋotooro na kufu ŋan wɔle nɛ, Degbeŋgyoo waa kaa kɛɛ Tiro bela, waa bese yɛɛ ɔ futooli keŋ, na ŋon na tɛɛle kei dɔɔ gyooridediise ka bese di kebu tɛɛle keŋ dɔɔ. <verse eid="ISA 23:17" /><verse number="18" style="v" sid="ISA 23:18" />Mɔna baa lese ɔ tɔnɔɔ na ŋan waa nyiŋ pou see yenaŋ fa Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 23:18">bɔɔ gyae baa yilaa ŋa yaa baa mo ŋa weese fa e ya.</para>
  <para style="q1" vid="ISA 23:18">Baa nyiŋ weenɛɛ na kegbase burum lee ŋe man fa baŋ bɛɛ som Degbeŋgyoo nɛ.<verse eid="ISA 23:18" /></para>
  <chapter eid="ISA 23" />
  <chapter number="24" style="c" sid="ISA 24" />
  <para style="s1">Degbeŋgyoo waa wɔlɛɛ tɛɛle keŋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 24:1" />Kɛɛ, Degbeŋgyoo waa wɔlɛɛ tɛɛle keŋ,</para>
  <para style="q2" vid="ISA 24:1">waa yela ka ke doo yakaa,</para>
  <para style="q1" vid="ISA 24:1">waa wɔlɛɛ ke sia,</para>
  <para style="q2" vid="ISA 24:1">na waa yaasee baŋ be kyaa ke dɔɔ nɛ,<verse eid="ISA 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 24:2" />gyae ke yɛɛ mena,</para>
  <para style="q2" vid="ISA 24:2">fa sae na balaŋ</para>
  <para style="q2" vid="ISA 24:2">tobaale ŋgba ɔ gbeŋgyoo baale nɛ,</para>
  <para style="q1" vid="ISA 24:2">alebu ŋgba ɔ gbeŋgyoo alo nɛ,</para>
  <para style="q2" vid="ISA 24:2">abɔɔ lɛɛre ŋgba abɔɔ yɔɔre nɛ,</para>
  <para style="q1" vid="ISA 24:2">ŋon ɔ ne paa ŋgba ŋon ɔ ne pakee balaŋ nɛ,</para>
  <para style="q2" vid="ISA 24:2">ŋon ɔ dana kom na ŋon be dana e kom nɛ.<verse eid="ISA 24:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 24:3" />Baa wɔlɛɛ tɛɛle keŋ kerekere,</para>
  <para style="q2" vid="ISA 24:3">na baa ŋmaa ka abɔɔ pou,</para>
  <para style="q2" vid="ISA 24:3">Degbeŋgyoo yakona nombii kei.<verse eid="ISA 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 24:4" />Tɛɛle ne di waraŋsa te ke ta boto,</para>
  <para style="q2" vid="ISA 24:4">tɛɛle pou te kaa te ke ta boto,</para>
  <para style="q2" vid="ISA 24:4">adido na tɛɛle pou te kaa.<verse eid="ISA 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 24:5" />Baŋ be kyaa tɛɛle dɔɔ nɛ te walaa ke,</para>
  <para style="q2" vid="ISA 24:5">nawolo nyi be te di mmaraase ŋan dɔɔ ya,</para>
  <para style="q1" vid="ISA 24:5">ba te wɔlɛɛ kawolase ŋan,</para>
  <para style="q2" vid="ISA 24:5">te be wɔlɛɛ nɔɔkebakesee kekpaakekpaa keŋ.<verse eid="ISA 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 24:6" />Mena dɔɔ kefaala gyakaa tɛɛle keŋ dɔɔ,</para>
  <para style="q2" vid="ISA 24:6">te ke man balaŋ ne naa diyem lee be fɔɔkedi dɔɔ,</para>
  <para style="q1" vid="ISA 24:6">Baŋ be kyaa tɛɛle keŋ dɔɔ baa nyakee,</para>
  <para style="q2" vid="ISA 24:6">balaŋ kyomii ne gyaela baa ka.<verse eid="ISA 24:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 24:7" />Gerepo keŋ na wolo, te waen woŋse na boto,</para>
  <para style="q2" vid="ISA 24:7">baŋ bɛɛ nyaŋee nɛ pou baa keŋee.<verse eid="ISA 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 24:8" />Akyakaase ŋan kenyaŋee kewii te tina yela,</para>
  <para style="q2" vid="ISA 24:8">baŋ bɛɛ nyaŋee nɛ yeesa te kɔŋ ɔto,</para>
  <para style="q1" vid="ISA 24:8">adolɛɛ kenyaŋee kewii te yɛɛ yididi.<verse eid="ISA 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 24:9" />Bɔɔ na tekaa mo nɔɔneŋ kekpee nyɔɔ waen ya,</para>
  <para style="q2" vid="ISA 24:9">soloŋ doŋte dana ŋan fa soloŋ nyɔɔra.<verse eid="ISA 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 24:10" />Donɔɔ keŋ bɔɔ yɛlɛɛ ke nɛ doo yakaa,</para>
  <para style="q2" vid="ISA 24:10">ba te tɔ dekpaŋalaŋ kamasɛ denaanɔɔ keŋ ŋolo ba gyoo ya.<verse eid="ISA 24:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 24:11" />Be sia te yɛɛ bɛɛ kɛo waen abɔnterese man,</para>
  <para style="q2" vid="ISA 24:11">kenyaŋee pou te kɔŋ ɔto,</para>
  <para style="q1" vid="ISA 24:11">kenyaŋee yeesase pou ta yoo tɛɛle keŋ dɔɔ.<verse eid="ISA 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 24:12" />Ba te wɔlɛɛ donɔɔ dinaa keŋ,</para>
  <para style="q2" vid="ISA 24:12">te be tekerii ka anaanɔɔse pou,<verse eid="ISA 24:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 24:13" />Mena ne gyaela ke kɔŋ tɛɛle dɔɔ,</para>
  <para style="q2" vid="ISA 24:13">na tɛɛlese pou man,</para>
  <para style="q1" vid="ISA 24:13">ŋgba mena keŋ be kɔ oliifi bia taŋ,</para>
  <para style="q2" vid="ISA 24:13">yaa ŋgba mena keŋ be kɔ gerepo bia taŋ, te bɛɛ tɛɛ gyalase nɛ.<verse eid="ISA 24:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ISA 24:14" />Bee gyina ba woya, bɛɛ nyaŋee fae yeesa,</para>
  <para style="q2" vid="ISA 24:14">bɛɛ fae yeesa lee weese dɛɛgyoe yenaŋ lese Degbeŋgyoo gyoorobiiri wola.<verse eid="ISA 24:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 24:15" />Mena dɔɔ ɛmɛɛ baŋ ɛ kyaa weese dɛɛlee yenaŋ, ɛ mo gyoorobiiri fa Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 24:15">ɛ gyina Degbeŋgyoo, Iseraetena Wurubuarɛ ŋon yele adido,</para>
  <para style="q1" vid="ISA 24:15">ɛpo tɛɛlese ŋan loŋ be kilisi ŋa nɛ man.<verse eid="ISA 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 24:16" />Dee nyii nɔɔneŋse lee tɛɛle ɔto nyiaa,</para>
  <para style="q2" vid="ISA 24:16">&lt;&lt;Gyoorobiiri yɛɛ ŋon ɔ tenɛɛ nɛ wui.&gt;&gt;</para>
  <para style="b" vid="ISA 24:16" />
  <para style="q1" vid="ISA 24:16">Mɔna me yakowɔ nyiaa, &lt;&lt;Ma te taŋ, Ma te taŋ!</para>
  <para style="q2" vid="ISA 24:16">Maa laako!</para>
  <para style="q1" vid="ISA 24:16">Baŋ bɛɛ lese balaŋ fa ta lese man fa!</para>
  <para style="q2" vid="ISA 24:16">Baŋ bɛɛ kɛrɛɛ balaŋ nawɔɔtɛɛ ta lese maŋ fa!&gt;&gt;<verse eid="ISA 24:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 24:17" />Gyakoloŋ na dowokom na kɔta ne daa,</para>
  <para style="q2" vid="ISA 24:17">baŋ be kyaa tɛɛle dɔɔ nɛ.<verse eid="ISA 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 24:18" />Ŋon ɔ yeu lee keŋ ne ŋmaase e nɛ gyaŋ na,</para>
  <para style="q2" vid="ISA 24:18">waa yala gyoo dowokom man,</para>
  <para style="q1" vid="ISA 24:18">ŋon ɔ gyem lee dowokom man,</para>
  <para style="q2" vid="ISA 24:18">waa gyoo kɔta man.</para>
  <para style="b" vid="ISA 24:18" />
  <para style="q1" vid="ISA 24:18">Be ta toro adido loŋse gbɛɛneŋ,</para>
  <para style="q2" vid="ISA 24:18">te tɛɛle mokɔɔ kasee wosiwɔ.<verse eid="ISA 24:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 24:19" />Tɛɛle te bɛɛ,</para>
  <para style="q2" vid="ISA 24:19">tɛɛle te kpase</para>
  <para style="q1" vid="ISA 24:19">tɛɛle ne wosi keŋkeŋ.<verse eid="ISA 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 24:20" />Tɛɛle ne bɛɛle ŋgba ŋon ɔ be dɛɛse nɛ,</para>
  <para style="q2" vid="ISA 24:20">kee wosi ŋgba feliŋ ne gyɔna kefɛɛbii nɛ,</para>
  <para style="q1" vid="ISA 24:20">te ɔ dukum keyɛɛ ta bese kasolɔ ɔ dɔɔ,</para>
  <para style="q2" vid="ISA 24:20">ɔ te yale keŋ ɔ ba koro bela ya.<verse eid="ISA 24:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 24:21" />Mena wee kenaŋ Degbeŋgyoo waa wɔŋ</para>
  <para style="q2" vid="ISA 24:21">adido doŋse deŋele adido,</para>
  <para style="q2" vid="ISA 24:21">na tɛɛle dɔɔ gyooneŋ tɛɛle dɔɔ.<verse eid="ISA 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 24:22" />Baa yilaa be popou dokoloŋ</para>
  <para style="q2" vid="ISA 24:22">ŋgba baŋ bɔɔ kyaŋ tɔ deni keŋ doo bɔɔ man nɛ.</para>
  <para style="q1" vid="ISA 24:22">Baa tɔ wɔ do deni man,</para>
  <para style="q2" vid="ISA 24:22">weeya burum ŋaale wɔle na baa wɔŋ ba deŋele.<verse eid="ISA 24:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 24:23" />Gyaalaŋ wose gyae ke gbirisi e,</para>
  <para style="q2" vid="ISA 24:23">na desɛŋ ke kyaŋ weese,</para>
  <para style="q1" vid="ISA 24:23">nawolo nyi Degbeŋgyoo Dekpataakpere waa di gyoori,</para>
  <para style="q2" vid="ISA 24:23">Siyɔn bula dɔɔ na Yerusalɛm,</para>
  <para style="q1" vid="ISA 24:23">na waa lese ɔ gyoorobiiri wola be kegyiise siaman.<verse eid="ISA 24:23" /></para>
  <chapter eid="ISA 24" />
  <chapter number="25" style="c" sid="ISA 25" />
  <para style="s1">Ɛ lese Degbeŋgyoo yele</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 25:1" />Degbeŋgyoo, nyaŋ yɛna me Wurubuarɛ,</para>
  <para style="q1" vid="ISA 25:1">Maa gyina neŋ adido na maa lese n yele,</para>
  <para style="q2" vid="ISA 25:1">nawolo nyi n te yɛɛ gyakoloŋ nombia.</para>
  <para style="q2" vid="ISA 25:1">abɔɔ ŋan n be bake lee beneŋ beneŋ nɛ,</para>
  <para style="q2" vid="ISA 25:1">n te yɛɛ ŋa nideli anokoare gbɛɛ man.<verse eid="ISA 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 25:2" />N te yele donɔɔ dinaa keŋ ta bese boya ŋan bɔɔ yilaa,</para>
  <para style="q2" vid="ISA 25:2">donɔɔ keŋ bɔɔ baŋ dekyaŋ kilisi ke nɛ te yɛlɛɛ,</para>
  <para style="q1" vid="ISA 25:2">ŋɔɔla donɔɔ dinaa keŋ bɔɔ baŋ dekyaŋ kilisi ke te yɛlɛɛ,</para>
  <para style="q2" vid="ISA 25:2">bɔɔ gyae baa baŋ ke korakora ya.<verse eid="ISA 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 25:3" />Mena dɔɔ balaŋ baŋ be dana doŋ baa mo obuo fa neŋ,</para>
  <para style="q2" vid="ISA 25:3">tɔɔman ŋantena tɛɛlese baa yee neŋ.<verse eid="ISA 25:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 25:4" />Nyaŋ yɛna ayematena keyeu kagyoo,</para>
  <para style="q2" vid="ISA 25:4">baŋ bɔɔ dana kolo ya nɛ, keyeu kagyoo ba wose kekyaŋ man,</para>
  <para style="q1" vid="ISA 25:4">dayoe lee feliŋkum man,</para>
  <para style="q2" vid="ISA 25:4">weese kpalala man wuluŋ.</para>
  <para style="q1" vid="ISA 25:4">Tɔɔman ŋantena weesɛɛ,</para>
  <para style="q2" vid="ISA 25:4">yɛɛ ŋgba ɔga feliŋ ne gyɔɔna dekyaŋ nɛ.<verse eid="ISA 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 25:5" />ŋgba depampaa man duwulawula nɛ.</para>
  <para style="q2" vid="ISA 25:5">N te yɔkɔse ŋɔɔla yeesa,</para>
  <para style="q1" vid="ISA 25:5">mena keŋ ŋɔma ne yɔkɔse weese kegyɔ nɛ,</para>
  <para style="q2" vid="ISA 25:5">mena te n yɔkɔse tɔɔman ŋantena baŋ keyoodi nɔɔneŋ.<verse eid="ISA 25:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 25:6" />Degbeŋgyoo Dekpataakpere ŋon,</para>
  <para style="q2" vid="ISA 25:6">waa fa balaŋ pou siŋkiti weenɛɛ bula kei dɔɔ,</para>
  <para style="q2" vid="ISA 25:6">waa mo nɔɔkedi waen keŋ be pae see botɔɔ,</para>
  <para style="q2" vid="ISA 25:6">naane kpaakpaate na soloŋ kpaakpaate.<verse eid="ISA 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 25:7" />Bula kei dɔɔ te waa wɔlɛɛ,</para>
  <para style="q2" vid="ISA 25:7">yeŋ kanyaŋ keŋ wuɛ balaŋ baŋ pou dɔɔ,</para>
  <para style="q1" vid="ISA 25:7">na keŋ wuɛ tɛɛlese pou dɔɔ nɛ,<verse eid="ISA 25:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="ISA 25:8" />waa lila yeŋ kekpaakekpaa,</para>
  <para style="q1" vid="ISA 25:8">Degbeŋgyoo Doŋ Pou Nyee waa feefo siasaraŋ</para>
  <para style="q2" vid="ISA 25:8">lee sia pou man,</para>
  <para style="q1" vid="ISA 25:8">waa lese ɔ balaŋ desɛŋ</para>
  <para style="q2" vid="ISA 25:8">lee tɛɛle pou dɔɔ.</para>
  <para style="q4" vid="ISA 25:8">Degbeŋgyoo te kolosi.<verse eid="ISA 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 25:9" />Wee kenaŋ baa yako nyiaa,</para>
  <para style="q2" vid="ISA 25:9">&lt;&lt;De Wurubuarɛ yaa ampaŋ,</para>
  <para style="q1" vid="ISA 25:9">da moo da wose lɔ ɔ dɔɔ, te ɔ lɛɛ da nyee.</para>
  <para style="q2" vid="ISA 25:9">Degbeŋgyoo yaa da moo da wose lɔ ɔ dɔɔ,</para>
  <para style="q1" vid="ISA 25:9">ɛ yela dɛɛ nyaŋee na ke yɛ daa gyoŋ lee ɔ nyeekelɛɛ dɔɔ.&gt;&gt;<verse eid="ISA 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 25:10" />Degbeŋgyoo nyiŋmaa gyae ke gyakaa bula kei dɔɔ,</para>
  <para style="q2" vid="ISA 25:10">mɔna baa sakatee Moabe be tɛɛle man,</para>
  <para style="q1" vid="ISA 25:10">ŋgba mena keŋ bɛɛ sakatee woŋsila dufuŋ man nɛ.<verse eid="ISA 25:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 25:11" />Baa fɛlɛɛ be nyiŋmaase ke man,</para>
  <para style="q2" vid="ISA 25:11">ŋgba mena keŋ boo yɛlɛɛra ne fɛlɛɛ be nyiŋmaase yɛlɛɛ boo nɛ.</para>
  <para style="q1" vid="ISA 25:11">Wurubuarɛ waa yɔkɔse ba wose kegate,</para>
  <para style="q2" vid="ISA 25:11">na be nyiŋmaase man tomse ŋan bɛɛ mo adao yɛɛ nɛ.<verse eid="ISA 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 25:12" />Waa tekerii nya akyaŋse doŋ nyiŋan ŋan korɛɛ nɛ,</para>
  <para style="q2" vid="ISA 25:12">lɔ tɛɛle man,</para>
  <para style="q2" vid="ISA 25:12">na waa yɛlɛɛ ŋa kerekere</para>
  <para style="q2" vid="ISA 25:12">bese akuŋkuŋ.<verse eid="ISA 25:12" /></para>
  <chapter eid="ISA 25" />
  <chapter number="26" style="c" sid="ISA 26" />
  <para style="s1">Yele kalese nɔɔneŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 26:1" />Wee kenaŋ baa kpee nɔɔneŋ kei Yuda tɛɛle man nyiaa,</para>
  <para style="q1" vid="ISA 26:1">&lt;&lt;De dana donɔɔ dinaa doŋte,</para>
  <para style="q2" vid="ISA 26:1">Wurubuarɛ ta mo nyeekelɛɛ</para>
  <para style="q2" vid="ISA 26:1">yɛɛ ka akyaŋ mo kyaŋ ke.<verse eid="ISA 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 26:2" />Ɛ toro anaanɔɔse ŋan,</para>
  <para style="q2" vid="ISA 26:2">na tɛɛle keŋ ka tenɛɛ ke nyiŋ gyoo,</para>
  <para style="q2" vid="ISA 26:2">tɛɛle keŋ kɛɛ kyaŋ ka kelɛɛdi man nɛ.<verse eid="ISA 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 26:3" />Baŋ bɛɛ mo ba nyeempɔ gyakaa n dɔɔ nɛ,</para>
  <para style="q2" vid="ISA 26:3">n ke yela baa kyaa wosefɛɛreŋ gbagba man,</para>
  <para style="q2" vid="ISA 26:3">nawolo nyi be ta mo ba wose lɔ n dɔɔ.<verse eid="ISA 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 26:4" />Mo n wose lɔ Degbeŋgyoo dɔɔ kekpaakekpaa,</para>
  <para style="q2" vid="ISA 26:4">nawolo nyi Degbeŋgyoo, Degbeŋgyoo gbagba, yɛna kpanaŋ kekpaakekpaa.<verse eid="ISA 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 26:5" />Ɔ ne yɔkɔse baŋ be kyaa botɔɔ keŋ korɛɛ nɛ,</para>
  <para style="q2" vid="ISA 26:5">ɔ ne yɔkɔse donɔɔ dinaa keŋ korɛɛ nɛ,</para>
  <para style="q1" vid="ISA 26:5">ɔ ne yɔkɔse ke kyɛɛkyɛɛ tɛɛle man,</para>
  <para style="q2" vid="ISA 26:5">ɔ ne yɛlɛɛ ke yɛɛ akuŋkuŋ.<verse eid="ISA 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 26:6" />Nawɔɔ ne sakatee ke,</para>
  <para style="q2" vid="ISA 26:6">baŋ bɔɔ ŋere wɔ do nawɔɔ,</para>
  <para style="q2" vid="ISA 26:6">na ayematena nawɔɔ dabetee ne sakateena ke.<verse eid="ISA 26:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 26:7" />Ŋon ɔ tenɛɛ nɛ gbɛɛ doo tee,</para>
  <para style="q2" vid="ISA 26:7">nyaŋ ŋon n gbɛɛneŋ tenɛɛ nɛ yelela, ŋon ɔ tenɛɛ nɛ gbɛɛneŋ doo kyɛɛkyɛɛ.<verse eid="ISA 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 26:8" />Ayi, Degbeŋgyoo, de silana nyaŋ mmaraase ŋan,</para>
  <para style="q2" vid="ISA 26:8">dɛɛ daa neŋ,</para>
  <para style="q1" vid="ISA 26:8">n yele na n ketɔɔse,</para>
  <para style="q2" vid="ISA 26:8">yɛna keŋ de konɔɔse ne gyae.<verse eid="ISA 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 26:9" />Mɛɛ mo me konɔɔ pou kɛo neŋ nelim,</para>
  <para style="q2" vid="ISA 26:9">nebo na n ne gyɔ ma woo loo,</para>
  <para style="q1" vid="ISA 26:9">Akpaa n nombia kedi de kɔŋ tɛɛle dɔɔ na,</para>
  <para style="q2" vid="ISA 26:9">tɛɛle keŋ dɔɔ balaŋ ne kasee keŋ ka tenɛɛ.<verse eid="ISA 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 26:10" />Akpaa n boele akpanyanyaŋte na,</para>
  <para style="q2" vid="ISA 26:10">be bɛɛ kasee nombia ŋan tenɛɛ ya,</para>
  <para style="q1" vid="ISA 26:10">baŋ ba tenɛɛ tɛɛle dɔɔ koraŋ nɛ, be gyakaa bɛɛ yɛɛ nombia kumɛɛ,</para>
  <para style="q2" vid="ISA 26:10">te bɔɔ ne naa Degbeŋgyoo ɔkeereŋ ya.<verse eid="ISA 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 26:11" />Degbeŋgyoo, n te gyina n nyiŋmaa adido,</para>
  <para style="q2" vid="ISA 26:11">mɔna bɔɔ ne naa ke ya.</para>
  <para style="q1" vid="ISA 26:11">Yela baa gyeŋ mena keŋ n ne gyae n balaŋ nideli nɛ, na desɛŋ ke kyaŋ wɔ,</para>
  <para style="q1" vid="ISA 26:11">yela boalaŋ keŋ n be kaase see n kɔlara nɛ ke kpa wɔ.<verse eid="ISA 26:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 26:12" />Degbeŋgyoo, nyaŋ seena wosefɛɛreŋ mokɔɔ fa daa,</para>
  <para style="q2" vid="ISA 26:12">ŋan pou dɔɔ tale yɛɛ nɛ, nyaŋ yɛɛla fa daa.<verse eid="ISA 26:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 26:13" />Degbeŋgyoo de Wurubuarɛ, gbeŋgyoona baale te di de dɔɔ kaalaŋ,</para>
  <para style="q2" vid="ISA 26:13">mɔna n yele kaageŋ te dɛɛ mo obuo fa.<verse eid="ISA 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 26:14" />Nɛnɛɛ be ta yekee, bɔɔ tekaa kyaa bela ya,</para>
  <para style="q2" vid="ISA 26:14">ba woya bɛɛ fom ya,</para>
  <para style="q1" vid="ISA 26:14">n wɔŋa ba deŋele te n wɔlɛɛ wɔ,</para>
  <para style="q2" vid="ISA 26:14">ŋolo bɛɛ tɔɔse wɔ bela ya.<verse eid="ISA 26:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 26:15" />Degbeŋgyoo, n te yele n balaŋ baŋ te wuku,</para>
  <para style="q2" vid="ISA 26:15">n te yele n balaŋ te wuku,</para>
  <para style="q1" vid="ISA 26:15">n te nyiŋ gyoorobiiri fa n wose,</para>
  <para style="q2" vid="ISA 26:15">n te fɛlɛɛ tɛɛle keŋ pou wuluse.<verse eid="ISA 26:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ISA 26:16" />Degbeŋgyoo, be kɔŋawɔ n gyaŋ ba wose kekyaŋ man,</para>
  <para style="q2" vid="ISA 26:16">n ka tenee wɔ na,</para>
  <para style="q2" vid="ISA 26:16">ba te tale gyuusu nɔɔ fane fa ya.<verse eid="ISA 26:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 26:17" />Mena keŋ alo fulute na doŋee,</para>
  <para style="q2" vid="ISA 26:17">te ɔ ne nyii weeleŋ fae yeesa nɛ,</para>
  <para style="q2" vid="ISA 26:17">mena te de woɛ nyaŋ Degbeŋgyoo siaman.<verse eid="ISA 26:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 26:18" />De kyaŋa fulu, te da doŋeewɔ,</para>
  <para style="q2" vid="ISA 26:18">mɔna da lola feliŋ bo,</para>
  <para style="q1" vid="ISA 26:18">de ta mo nyeekelɛɛ kɔŋ tɛɛle keŋ dɔɔ ya,</para>
  <para style="q2" vid="ISA 26:18">te tɛɛle keŋ dɔɔ balaŋ te nyiŋ nyeedoŋ ya.<verse eid="ISA 26:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="ISA 26:19" />Mɔna n balaŋ ayeŋɛɛ baa nyiŋ nyeedoŋ, Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 26:19">baa bese foŋii,</para>
  <para style="q1" vid="ISA 26:19">yela baŋ be doo akuŋkuŋ man nɛ,</para>
  <para style="q2" vid="ISA 26:19">ke foŋ na baa fae kenyaŋee yeesa,</para>
  <para style="q1" vid="ISA 26:19">nyɔ obosuo yɛɛ ŋgba nebo obosuo nɛ,</para>
  <para style="q2" vid="ISA 26:19">tɛɛle gyae ka lola ka woya.<verse eid="ISA 26:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ISA 26:20" />Me balaŋ, ɛ ta, ɛ gyoo ɛ denɛɛ man,</para>
  <para style="q2" vid="ISA 26:20">na ɛ ke tɔ asima do ɛ wose,</para>
  <para style="q1" vid="ISA 26:20">ɛ weese ɛ wose kyomii,</para>
  <para style="q2" vid="ISA 26:20">kelii debaŋ keŋ ɔ baŋ gyae ke fɛɛ.<verse eid="ISA 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 26:21" />Kɛɛ, Degbeŋgyoo ta lee ɔ dekyae man ɔ ne kɔŋ,</para>
  <para style="q2" vid="ISA 26:21">ɔ kaa wɔŋ tɛɛle kei balaŋ deŋele lee ba dukum dɔɔ.</para>
  <para style="q1" vid="ISA 26:21">Tɛɛle gyae ka lese fatabo keŋ bɔɔ kyɛɛkee woli ke nɛ debɔɔ,</para>
  <para style="q2" vid="ISA 26:21">ka be gyae ke ka weese baŋ bɔɔ koo lɔ nɛ bela ya.<verse eid="ISA 26:21" /></para>
  <chapter eid="ISA 26" />
  <chapter number="27" style="c" sid="ISA 27" />
  <para style="s1">Iserae kelɛɛ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 27:1" />Wee kenaŋ nɛ,</para>
  <para style="q1" vid="ISA 27:1">Degbeŋgyoo waa mo ɔ yoosila,</para>
  <para style="q2" vid="ISA 27:1">keŋ kɛɛ bee, ka kerɛɛ te ke dana gyakoloŋ nɛ,</para>
  <para style="q1" vid="ISA 27:1">wɔŋ Lewiyatan, dom ŋon ɔ dana ɔsaa,</para>
  <para style="q2" vid="ISA 27:1">Lewiyatan, dom ŋon ɔ ne bɔɔ nɛ deŋele,</para>
  <para style="q2" vid="ISA 27:1">waa ko ɛpo man wonembukum ŋon.<verse eid="ISA 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 27:2" />Wee kenaŋ,</para>
  <para style="q1" vid="ISA 27:2">&lt;&lt;Ɛ kpee nɔɔneŋ lee gerepo wɔɔ keŋ kɛɛ se bia nɛ wose man nyiaa,<verse eid="ISA 27:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="ISA 27:3" />Maŋ, Degbeŋgyoo ne gyeena ke,</para>
  <para style="q2" vid="ISA 27:3">mɛɛ do ke loŋ debaŋ kamasɛ,</para>
  <para style="q1" vid="ISA 27:3">mɛɛ gyee ke nelim na ka weese,</para>
  <para style="q2" vid="ISA 27:3">na kolo be nyiŋ yɛɛ ke ya.<verse eid="ISA 27:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="ISA 27:4" />Me ta gyeŋ baŋ ya.</para>
  <para style="q1" vid="ISA 27:4">Nyi kpalamse na kpaŋkpaŋkorolose deŋ tuuwɔ ke man nɛ,</para>
  <para style="q2" vid="ISA 27:4">nafɔ maa mo yoo gyu botɔɔ,</para>
  <para style="q2" vid="ISA 27:4">maa too ŋa pou.<verse eid="ISA 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 27:5" />Na mena ya na baa yeu kaa gyoo maŋ,</para>
  <para style="q1" vid="ISA 27:5">na daa na wɔ ke kyaa wosefɛɛreŋ man,</para>
  <para style="q2" vid="ISA 27:5">ayi, daa na wɔ ke kyaa wosefɛɛreŋ man.&gt;&gt;<verse eid="ISA 27:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 27:6" />Debaŋ daale ne kɔŋ keŋ Yakɔbe waa baŋ lila,</para>
  <para style="q2" vid="ISA 27:6">Iserae waa lese tombia na waa yɛɛ kyeŋkyeŋkɔɔse,</para>
  <para style="q2" vid="ISA 27:6">na ke bia ke lɛɛ tɛɛle keŋ pou.<verse eid="ISA 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 27:7" />Degbeŋgyoo gyɔɔ Iserae,</para>
  <para style="q2" vid="ISA 27:7">ŋgba mena keŋ ɔ be gyɔ baŋ bɔɔ gyɔ wɔ nɛ?</para>
  <para style="q1" vid="ISA 27:7">Yaa ɔ koe wɔ</para>
  <para style="q2" vid="ISA 27:7">ŋgba mena keŋ ɔ ba koe baŋ bɔɔ koe wɔ nɛ?<verse eid="ISA 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 27:8" />N wɔŋa ba deŋele, yela be kyaŋa wɔ yoogbeŋa,</para>
  <para style="q2" vid="ISA 27:8">n moo baŋ gegi wɔ,</para>
  <para style="q2" vid="ISA 27:8">ŋgba weese dɛɛlee feliŋ kegyɔ wee nɛ.<verse eid="ISA 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 27:9" />Gbɛɛ kei dɔɔ te baa sola fa Yakɔbe dukum kamokyɛɛ,</para>
  <para style="q2" vid="ISA 27:9">keŋ gyae ka wola nyi be ta mo ɔ dukum pou kyɛɛ e yɛna nyi,</para>
  <para style="q1" vid="ISA 27:9">waa yɛlɛɛ kedeesaboya ŋan pou,</para>
  <para style="q2" vid="ISA 27:9">waa naŋ ŋa ŋgba hiree nɛ,</para>
  <para style="q1" vid="ISA 27:9">waa tekerii bane alo Asera daase, na oliifi kedeesaboya ŋan,</para>
  <para style="q2" vid="ISA 27:9">ŋɔɔ tekaa seŋ botɔɔ bela ya.<verse eid="ISA 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 27:10" />Donɔɔ dinaa keŋ bɔɔ baŋ dekyaŋ kilisi ke nɛ doo yakaa,</para>
  <para style="q2" vid="ISA 27:10">balaŋ dekyae ta bese donɔɔ keŋ bɔɔ tina ke yela, ba te bɛɛ ke ŋgba depampaa nɛ,</para>
  <para style="q1" vid="ISA 27:10">botɔɔ te nunkyue bia ne dii,</para>
  <para style="q2" vid="ISA 27:10">botɔɔ te bee tisi doo,</para>
  <para style="q2" vid="ISA 27:10">bɛɛ tao daase tombia ŋan kerekere.<verse eid="ISA 27:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 27:11" />Nyi ŋe tombia da wolo na, ŋee tekerii yala,</para>
  <para style="q2" vid="ISA 27:11">na ala te kaa tɔɔsee ŋa ka do boalaŋ.</para>
  <para style="q1" vid="ISA 27:11">Be yɛɛ balaŋ baŋ bɔɔ ne nyii nombia man ya,</para>
  <para style="q2" vid="ISA 27:11">mena dɔɔ ŋon ɔ be yɛɛ wɔ bee wii wɔ ya,</para>
  <para style="q2" vid="ISA 27:11">te ŋon ɔ be ma wɔ bɛɛ boele wɔ ya.<verse eid="ISA 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 27:12" />Wee kenaŋ Degbeŋgyoo waa tɔɔsee ɔ balaŋ lee Eferatese boo man kelii Igyipite boŋobii nɔɔman, na waa ta tɔɔse ɛmɛɛ Iseraetena dokoloŋ dokoloŋ.<verse eid="ISA 27:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 27:13" />Wee kenaŋ baa wola kaberɛ keŋkeŋ. Baŋ bɔɔ dɔɔ Asiriya bɛɛ kaa na baŋ be kyaa gbeŋiri man Igyipite nɛ baa kɔŋ kaa som Degbeŋgyoo bula fereŋkyeŋ keŋ dɔɔ Yerusalɛm.<verse eid="ISA 27:13" /></para>
  <chapter eid="ISA 27" />
  <chapter number="28" style="c" sid="ISA 28" />
  <para style="s1">Eferam na Yuda kegyiise baa laako</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 28:1" />Ɛferayim kyeŋkyeŋkɔɔ saboe, keŋ Eferayim soloŋ nyɔɔra na mo gate ba wose,</para>
  <para style="q2" vid="ISA 28:1">kyeŋkyeŋkɔɔ kyeote keŋ ke gyoorobiiri ne kpiisi,</para>
  <para style="q1" vid="ISA 28:1">te ke doo detaŋgya kpaakpaa keŋ nyeeman,</para>
  <para style="q2" vid="ISA 28:1">na baŋ waen be wɔlɛɛ wɔ donɔɔ dinaa keŋ man nɛ baa laako.<verse eid="ISA 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 28:2" />Kɛɛ, Degbeŋgyoo dana ŋon ɔ dana doŋ nideli,</para>
  <para style="q2" vid="ISA 28:2">ŋgba akpeleŋkpeleŋbia ŋan ne yale na feliŋ keŋ ne wɔlɛɛ abɔɔ nɛ,</para>
  <para style="q1" vid="ISA 28:2">waa mo doŋ tisina ke kɔŋ tɛɛle dɔɔ,</para>
  <para style="q2" vid="ISA 28:2">ŋgba ɔga dinaa keŋɛɛ keŋ na mo loŋ kewuu kɔŋ tɛɛle dɔɔ nɛ.<verse eid="ISA 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 28:3" />Baa sakatee kyeŋkyeŋkɔɔ saboe,</para>
  <para style="q2" vid="ISA 28:3">keŋ dɔɔ Ɛferayim soloŋ nyɔɔra ne gate ba wose nɛ.<verse eid="ISA 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 28:4" />Mena kyeŋkyeŋkɔɔ kyeote keŋ ke gyoorobiiri be kpiisi,</para>
  <para style="q2" vid="ISA 28:4">keŋ doo detaŋgya kpaakpaa keŋ nyeeman nɛ,</para>
  <para style="q1" vid="ISA 28:4">gyae ke yɛɛ ŋgba fiigi bia ŋan be taŋgbɛɛ yɛɛ pɛ weenɛɛ kekɛrɛɛ kelii nɛ,</para>
  <para style="q2" vid="ISA 28:4">balaŋ de naa ŋa pɛ na bɛɛ kɔ ŋa,</para>
  <para style="q2" vid="ISA 28:4">na be te di ŋa deboman.<verse eid="ISA 28:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 28:5" />Wee kenaŋ Degbeŋgyoo Dekpataakpere ŋon,</para>
  <para style="q2" vid="ISA 28:5">waa yɛɛ gyoorobiiri gyooro kotɔtɔɔ,</para>
  <para style="q1" vid="ISA 28:5">na kyeŋkyeŋkɔɔ saboe kyeote,</para>
  <para style="q2" vid="ISA 28:5">fa ɔ balaŋ baŋ bɔɔ kaa be kyaa.<verse eid="ISA 28:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 28:6" />Waa yɛɛ nombia kedi kegbɛɛ dɔɔ feliŋ,</para>
  <para style="q2" vid="ISA 28:6">fa ŋon waa kyaa di nombia,</para>
  <para style="q1" vid="ISA 28:6">na waa fa wɔ doŋ,</para>
  <para style="q2" vid="ISA 28:6">keŋ baa mo tɔ yoo nɔɔ donɔɔ dinaa keŋ denaanɔɔ man.<verse eid="ISA 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 28:7" />Gbalara na saese ne kpaŋte lee waen kenyɔɔ dɔɔ,</para>
  <para style="q2" vid="ISA 28:7">soloŋ doŋte te yele be dɔŋ wogbaa.</para>
  <para style="q1" vid="ISA 28:7">Bɛɛ bɛɛle lee soloŋ doŋte dɔɔ,</para>
  <para style="q2" vid="ISA 28:7">waen te wɔlɛɛ wɔ,</para>
  <para style="q1" vid="ISA 28:7">soloŋ doŋte te yele be dɔŋ wogbaa,</para>
  <para style="q2" vid="ISA 28:7">be naa nombia na, be sia ne yɛɛ wɔ moamoa,</para>
  <para style="q2" vid="ISA 28:7">be gyaŋee bɛɛ mo nyeempɔ na bee wuku.<verse eid="ISA 28:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 28:8" />Ba te tɔe wɔlɛɛ be tebuluse pou dɔɔ,</para>
  <para style="q2" vid="ISA 28:8">yenaŋ daale te kaa keŋ ayimɛɛ be doo ya.<verse eid="ISA 28:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 28:9" />&lt;&lt;Amɔte yaa ɔ ne gyae waa wola e nombia?</para>
  <para style="q2" vid="ISA 28:9">Amɔte yaa ɔ na lese ɔ nombia man waa fa?</para>
  <para style="q1" vid="ISA 28:9">Bia baŋ bɔɔ tira wɔ dide,</para>
  <para style="q2" vid="ISA 28:9">yaa baŋ bɔɔ lese dide lee be nɔɔman deboman?<verse eid="ISA 28:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 28:10" />Nawolo nyi ke yɛɛ,</para>
  <para style="q2" vid="ISA 28:10">Yɛɛ kei, yɛɛ kenaŋ,</para>
  <para style="q2" vid="ISA 28:10">kei wui mmaraa, kenaŋ wui mmaraa,</para>
  <para style="q2" vid="ISA 28:10">kɛbo kyomii, botɔɔ mɔ kyomii.&gt;&gt;<verse eid="ISA 28:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 28:11" />Ke gbagba na, Wurubuarɛ waa mo deise wɔlɛɛ, na baŋ bee wuku nɛ laakemse,</para>
  <para style="q2" vid="ISA 28:11">kolosi fa balaŋ kɛwɔ.<verse eid="ISA 28:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 28:12" />Ɔ yako wɔ nyiaa,</para>
  <para style="q2" vid="ISA 28:12">&lt;&lt;Kɛbo yɛna defɛɛfoe, ɛmɛɛ baŋ ɛ be kaa nɛ ɛ fɛɛfo,</para>
  <para style="q1" vid="ISA 28:12">kɛbo yɛna botɔɔ keŋ ɛ wose gyae ke fɛɛ ŋon,&gt;&gt;</para>
  <para style="q2" vid="ISA 28:12">mɔna be te nyii e ya.<verse eid="ISA 28:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 28:13" />Mena dɔɔ Wurubuarɛ nombia gyae kekɔŋ fa wɔ nyiaa,</para>
  <para style="q2" vid="ISA 28:13">Yɛɛ kei, yɛɛ kenaŋ,</para>
  <para style="q2" vid="ISA 28:13">kei wui mmaraa, kenaŋ wui mmaraa,</para>
  <para style="q2" vid="ISA 28:13">kɛbo kyomii, botɔɔ kyomii.&gt;&gt;</para>
  <para style="q1" vid="ISA 28:13">na nyi bee gyu na baa lee yala wɔlewɔle,</para>
  <para style="q2" vid="ISA 28:13">baa gooli na baa gyoo kɔta man na baa kyaŋ wɔ.<verse eid="ISA 28:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ISA 28:14" />Mena dɔɔ ɛmɛɛ baŋ ɛ ne kulu balaŋ,</para>
  <para style="q2" vid="ISA 28:14">te ɛ ne di balaŋ kɛwɔ dɔɔ Yerusalɛm nɛ, ɛ nyii Degbeŋgyoo nombia.<verse eid="ISA 28:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 28:15" />Ɛ na wola ɛ wose nyiaa, &lt;&lt;Daa na yeŋ te bakenɔɔsee,</para>
  <para style="q2" vid="ISA 28:15">daa na woyadɛɛ te bake sɛɛ dɔŋa,</para>
  <para style="q1" vid="ISA 28:15">nyi akpaa deŋele kewɔŋ kum de kɔŋ nɛ,</para>
  <para style="q2" vid="ISA 28:15">be gyae ke lii de gyaŋ ya,</para>
  <para style="q1" vid="ISA 28:15">nawolo nyi de ta mo dekara yɛɛ da keyeu kagyoo,</para>
  <para style="q2" vid="ISA 28:15">te da moo akɛrɛɛ yɛɛ de dayoe.&gt;&gt;<verse eid="ISA 28:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 28:16" />Mena dɔɔ Degbeŋgyoo Doŋ Pou Nyee kpa,</para>
  <para style="q1" vid="ISA 28:16">&lt;&lt;Kɛɛ, ma te baŋ boe daale Siyɔn, boe keŋ bɔɔ kɛɛse ke kɛɛ,</para>
  <para style="q2" vid="ISA 28:16">kebɔtala man boe koyadoŋte, fa mokɔɔ kasee keŋ seŋɛɛ keŋkeŋ,</para>
  <para style="q1" vid="ISA 28:16">ŋon ɔ mo ɔ wose lɔ ke dɔɔ nɛ,</para>
  <para style="q2" vid="ISA 28:16">ɔ wɔe be gyae kelɔ e korakora ya.<verse eid="ISA 28:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 28:17" />Maa mo nombia kedi kegbɛɛ dɔɔ yɛɛ kemaa ŋmeleŋ,</para>
  <para style="q2" vid="ISA 28:17">na maa mo katenee yɛɛ naetɔɔse,</para>
  <para style="q1" vid="ISA 28:17">akpeleŋkpeleŋbia gyae ke wɔlɛɛ ɛ dekara keyeu kagyoo keŋ,</para>
  <para style="q2" vid="ISA 28:17">na loŋ ke waale mo ɛ dayoe keŋ.<verse eid="ISA 28:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 28:18" />Ɛmɛɛ na yeŋ nɔɔkebakesee keŋ gyae ke wɔlɛɛ,</para>
  <para style="q2" vid="ISA 28:18">ɛmɛɛ na woyadɛɛ kebake sɛɛ dɔŋa be gyae ka seŋ ya.</para>
  <para style="q1" vid="ISA 28:18">Nyi deŋele kewɔŋkum keŋ de kɔŋ na,</para>
  <para style="q2" vid="ISA 28:18">ke gyae ke wɔlɛɛ ŋon pou.<verse eid="ISA 28:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 28:19" />Debaŋ kamasɛ keŋ ka de kɔŋ na gyae ka mo ŋon,</para>
  <para style="q2" vid="ISA 28:19">nawolo nyi nebo kamasɛ, wee man na nelim na,</para>
  <para style="q2" vid="ISA 28:19">ke gyae ke kɔŋ.&gt;&gt;</para>
  <para style="b" vid="ISA 28:19" />
  <para style="q1" vid="ISA 28:19">Nombii kei man kenyii,</para>
  <para style="q2" vid="ISA 28:19">gyae ka do ŋon gyakoloŋ.<verse eid="ISA 28:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 28:20" />Nawolo nyi dofoŋoŋ gyae ke yɛɛ duguŋ keŋ nyi n be tale tenee n wose ya,</para>
  <para style="q2" vid="ISA 28:20">kuŋtuŋ gyae ke yɛɛ peperee keŋ ba yee neŋ kewuu ya.<verse eid="ISA 28:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 28:21" />Degbeŋgyoo waa fokaa ɔ wose, ŋgba ɔ ke yɛɛ Perasim bula dɔɔ nɛ,</para>
  <para style="q2" vid="ISA 28:21">waa wosi ɔ wose ŋgba ɔ ke yɛɛ Gibeon detaŋgya man nɛ,</para>
  <para style="q1" vid="ISA 28:21">na waa yɛɛ ɔ tom, ɔ tom keŋ ke dana gyakoloŋ,</para>
  <para style="q2" vid="ISA 28:21">na waa yɛɛ ɔ tom, keŋ ke yɛɛ kpoo.<verse eid="ISA 28:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 28:22" />Nɛnɛɛ ɛ tina ɛ balaŋ kekulu yela,</para>
  <para style="q2" vid="ISA 28:22">na mena ya na ɛ kaale gyae ka bo kpu,</para>
  <para style="q1" vid="ISA 28:22">Degbeŋgyoo, Degbeŋgyoo Dekpataakpere te yako me te nyii,</para>
  <para style="q2" vid="ISA 28:22">kewɔlɛɛ keŋ ɔ bakesee lee tɛɛle kei pou wose man.<verse eid="ISA 28:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="ISA 28:23" />Ɛ tei na ɛ ke nyii ma woya,</para>
  <para style="q2" vid="ISA 28:23">ɛ see deŋele nideli na ɛ ke nyii keŋ mɛɛ yako.<verse eid="ISA 28:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 28:24" />Nyi wɔɔfarale de fara tɛɛle nyi waa duu abɔɔ na, ɔ na bese fara ke bela?</para>
  <para style="q2" vid="ISA 28:24">Nyi ɔ pupui tɛɛle nyi waa duu abɔɔ na, ɔ na bese pupui ke bela?<verse eid="ISA 28:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 28:25" />Akpaa ɔ tala tɛɛle keŋ taŋ nɛ,</para>
  <para style="q2" vid="ISA 28:25">ɔ ne duu kayigbe na nkaŋgyaa kpoo,</para>
  <para style="q1" vid="ISA 28:25">na ɔ te ŋmatee aboŋ na kameese kpoo,</para>
  <para style="q2" vid="ISA 28:25">na ɔ te duu wamela wɔɔ keŋ nɔɔnɔɔ.<verse eid="ISA 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 28:26" />Ɔ Wurubuarɛ na wolana e,</para>
  <para style="q2" vid="ISA 28:26">gbɛɛ kpaakpaa keŋ dɔɔ waa mo.<verse eid="ISA 28:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="ISA 28:27" />Bɔɔ na mo okpokpo tuku kayigbe,</para>
  <para style="q2" vid="ISA 28:27">yaa nyeele anefiileŋ nawɔɔ tuku nkaŋgyaa ya,</para>
  <para style="q1" vid="ISA 28:27">bɛɛ mo dambila tuku kayigbe bo,</para>
  <para style="q2" vid="ISA 28:27">gbutu te bɛɛ mo tuku nkaŋgyaa.<verse eid="ISA 28:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 28:28" />Bɛɛ naŋ wamela mo yɛɛ bodobodo,</para>
  <para style="q2" vid="ISA 28:28">mɔna ŋolo bee tuku ke kekpaakekpaa ya.</para>
  <para style="q1" vid="ISA 28:28">Baa tale mo nyeele anefiileŋ nawɔɔ ta ŋe dɔɔ,</para>
  <para style="q2" vid="ISA 28:28">mɔna bɔɔ na mo dɛɛkyɔŋse naŋ ke ya.<verse eid="ISA 28:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 28:29" />Kɛŋa pou lee Degbeŋgyoo Dekpataakpere ŋon gyaŋ,</para>
  <para style="q2" vid="ISA 28:29">ɔ nyeeman kebake dana gyakoloŋ,</para>
  <para style="q1" vid="ISA 28:29">te ɔ nyansa liiwɔ nideli.<verse eid="ISA 28:29" /></para>
  <chapter eid="ISA 28" />
  <chapter number="29" style="c" sid="ISA 29" />
  <para style="s1">Dawide donɔɔ dinaa dɛɛ laako</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 29:1" />Ao Ariɛle, Ariɛle,</para>
  <para style="q2" vid="ISA 29:1">donɔɔ dinaa keŋ man Dawide be kyaa, laako,</para>
  <para style="q1" vid="ISA 29:1">ɛ kyaa di ɛ kulutoo nɔɔkedi keŋ,</para>
  <para style="q2" vid="ISA 29:1">kulutoo kamasɛ.<verse eid="ISA 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 29:2" />Maa tɔ Ariɛle do,</para>
  <para style="q2" vid="ISA 29:2">waa di waraŋsa na waa muutii,</para>
  <para style="q2" vid="ISA 29:2">waa yɛɛ ŋgba kedeesa kosɔ nɛ me nyiŋmaa man.<verse eid="ISA 29:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 29:3" />Maa kilisi ɛ popou yenaŋ kamasɛ,</para>
  <para style="q2" vid="ISA 29:3">maa baŋ dekagyase kilisi ŋon,</para>
  <para style="q2" vid="ISA 29:3">na maa mo abɔɔ burum tɔ ŋon gbɛɛ.<verse eid="ISA 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 29:4" />Baa lɔ neŋ tɛɛle man, na n ke kolosi lee tɛɛle man,</para>
  <para style="q2" vid="ISA 29:4">akuŋkuŋ man te baa nyi n woya lee</para>
  <para style="q1" vid="ISA 29:4">baa nyii n woya lee tɛɛle man ŋgba woo nɛ,</para>
  <para style="q2" vid="ISA 29:4">n ke kolosi adadawoya man lee akuŋkuŋ man<verse eid="ISA 29:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 29:5" />N kɔlara burum baŋ baa yɛɛ ŋgba akuŋkuŋ nɛ,</para>
  <para style="q2" vid="ISA 29:5">nyeeman doŋtena burum baŋ baa yɛɛ ŋgba wura ŋan feliŋ ne gyɔɔ nɛ,</para>
  <para style="q1" vid="ISA 29:5">Nombii kei gyae ke kɔŋ karatetee deboman.<verse eid="ISA 29:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="ISA 29:6" />Degbeŋgyoo Dekpataakpere ŋon,</para>
  <para style="q1" vid="ISA 29:6">waa mo ɔga kefae na tɛɛle kewosi na yeesa dinaa,</para>
  <para style="q2" vid="ISA 29:6">na feliŋ kegyɔ na feliŋkum na boalaŋ degyapaa kɔŋ n gyaŋ.<verse eid="ISA 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 29:7" />Na tɛɛlese ŋan pou ne yoo Ariɛle,</para>
  <para style="q2" vid="ISA 29:7">baŋ bɔɔ koro seŋ tia ŋon na ɔ dekagyase te bɔɔ tɔ wɔ do nɛ,</para>
  <para style="q1" vid="ISA 29:7">baa yɛɛ ŋgba dosɛɛ,</para>
  <para style="q2" vid="ISA 29:7">yaa keŋ bɔɔ naa nɛ.<verse eid="ISA 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 29:8" />mena keŋ ŋon tanam na ko e de doosi nyi ɔ ne dii,</para>
  <para style="q2" vid="ISA 29:8">mɔna ɔ fom na tanam sɛɛ na ko e,</para>
  <para style="q1" vid="ISA 29:8">yaa ŋon loŋboaneŋ na ko e de doosi nyi ɔ ne nyɔɔ loŋ,</para>
  <para style="q2" vid="ISA 29:8">mɔna ɔ fom na ɔ ne gbalase, te loŋboaneŋ na ko e nɛ,</para>
  <para style="q1" vid="ISA 29:8">mena te tɛɛlese ŋan pou ne yoo,</para>
  <para style="q2" vid="ISA 29:8">Siyɔn bula nɛ baa yɛɛ.<verse eid="ISA 29:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 29:9" />Ɛ sia dɛɛ yɛɛ ŋon fulaa na gyakoloŋ ka gyoo ŋon,</para>
  <para style="q2" vid="ISA 29:9">ɛ kyaŋ ɛ sia wuu, na ɛ sia ke yɛlɛɛ,</para>
  <para style="q1" vid="ISA 29:9">ɛ dɛɛse, mɔna na waen kedɛɛse ya,</para>
  <para style="q2" vid="ISA 29:9">ɛ ta kpaŋte, mɔna na soloŋ doŋte wui ya.<verse eid="ISA 29:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 29:10" />Nawolo nyi Degbeŋgyoo ta mo kedooyeŋ do ɛ man,</para>
  <para style="q2" vid="ISA 29:10">Ɔ te tɔ ɛ sia, (gbalara baŋ),</para>
  <para style="q2" vid="ISA 29:10">ɔ te wuu ɛ nyeeya, (baŋ bɛɛ naa nɛ).<verse eid="ISA 29:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 29:11" />Nombiakena kɛŋa pou te kaa yɛɛ ŋon ŋgba tɔne keŋ bɔɔ tɔ ke nɔɔ nɛ man nombia. Nyi ba mo ke fa ŋon waa tale kala nyi, &lt;&lt;Waase kala ke,&gt;&gt; nɛ, waa yako nyiaa, &lt;&lt;Mɔɔ tale ya, ba te tɔ ke nɔɔ.&gt;&gt;<verse eid="ISA 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 29:12" />Te akpaa n mo tɔne keŋ fa ŋon ɔ be tale kala ya nyi, &lt;&lt;Waase kala ke,&gt;&gt; nɛ waa yako nyiaa, &lt;&lt;Mɔɔ gyeŋ kekala ya.&gt;&gt;<verse eid="ISA 29:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 29:13" />Degbeŋgyoo kpa nyiaa,</para>
  <para style="q1" vid="ISA 29:13">&lt;&lt;Balaŋ kɛwɔ na mo be nɔɔ bo kɔŋ me gyaŋ,</para>
  <para style="q2" vid="ISA 29:13">te bɛɛ mo be nɔɔwoya bo do maŋ obuo,</para>
  <para style="q2" vid="ISA 29:13">mɔna be konɔɔse dana lem lee me gyaŋ.</para>
  <para style="q1" vid="ISA 29:13">Bɔ ɔsom keŋ bɛɛ som maŋ nɛ,</para>
  <para style="q2" vid="ISA 29:13">yɛɛ keŋ bɔɔ kasee lee denibalaŋ gyaŋ te bɔɔ kyam do ba nyeeya man.<verse eid="ISA 29:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 29:14" />Mena dɔɔ maa bese yela balaŋ kɛwɔ wose ke gbirisi wɔ,</para>
  <para style="q2" vid="ISA 29:14">maa yɛɛ gyakoloŋ nombia gyakaa dɔŋa dɔɔ,</para>
  <para style="q1" vid="ISA 29:14">siakekara gyae ke kɔŋ ɔto,</para>
  <para style="q2" vid="ISA 29:14">nombia gyeŋara nombiaman kagyeŋ gyae ke ŋaalaa.<verse eid="ISA 29:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 29:15" />Baŋ bɛɛ mo ba nyeeman kebake</para>
  <para style="q2" vid="ISA 29:15">weese Degbeŋgyoo,</para>
  <para style="q1" vid="ISA 29:15">baŋ bɛɛ yɛɛ ba tom detiŋtɛɛ man te bɛɛ gyueŋ nyi,</para>
  <para style="q2" vid="ISA 29:15">&lt;&lt;Amɔte ne naana daa? Amɔte ne gyaela waa gyeŋ?&gt;&gt; nɛ baa laako<verse eid="ISA 29:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 29:16" />Ɛ ne tulii abɔɔ,</para>
  <para style="q2" vid="ISA 29:16">ɛ ne kɛɛ saabu maare ŋgba tɛɛle nɛ?</para>
  <para style="q1" vid="ISA 29:16">Kpene keŋ bɔɔ maa nɛ, gyae ke tale yako maare ŋon nyiaa</para>
  <para style="q2" vid="ISA 29:16">&lt;&lt;Na nyaŋ maana maŋ&gt;&gt; yee?</para>
  <para style="q1" vid="ISA 29:16">Saabu gyae ke tale yako maare ŋon nyiaa,</para>
  <para style="q2" vid="ISA 29:16">&lt;&lt;N ba gyaŋ daale&gt;&gt; yee?<verse eid="ISA 29:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ISA 29:17" />Be gyae kedi weeya ya, na Lebanɔn ka bese tɛɛle kpaakpaa,</para>
  <para style="q2" vid="ISA 29:17">na tɛɛle kpaakpaa keŋ ka bese laa yee?<verse eid="ISA 29:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 29:18" />Wee kenaŋ nɛ, deŋela atɔɔsatena baa nyii tɔne keŋ man nombia,</para>
  <para style="q2" vid="ISA 29:18">na siayɛlɛɛsatena ke naa,</para>
  <para style="q2" vid="ISA 29:18">botɔɔ keŋ yɛɛ fulaa na detiŋtɛɛ man.<verse eid="ISA 29:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 29:19" />Baŋ bɛɛ yɔkɔse ba wose nɛ baa nyaŋee Degbeŋgyoo man,</para>
  <para style="q2" vid="ISA 29:19">na baŋ bɔɔ dana kolo ya nɛ ke nyaŋee lee Iserae fereŋkyeŋte ŋon man.<verse eid="ISA 29:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 29:20" />Tɔɔman ŋantena baa ŋaalaa,</para>
  <para style="q2" vid="ISA 29:20">baŋ bee kulu balaŋ baa yo,</para>
  <para style="q2" vid="ISA 29:20">na baa lese baŋ bɛɛ bake nombiakumɛɛ nɛ pou.<verse eid="ISA 29:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 29:21" />Baŋ ne kɛrɛɛna balaŋ nɔɔse nombia dedii man,</para>
  <para style="q2" vid="ISA 29:21">baŋ ne nyɔɔna nombiadiiri kɔta nombia dedii man,</para>
  <para style="q2" vid="ISA 29:21">na be te di adansɛɛkum bu ŋon ɔ nombia dei nɛ fɔɔ.<verse eid="ISA 29:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 29:22" />Mena dɔɔ keŋ Degbeŋgyoo ŋon ɔ be lɛɛ Aberaham nyee be yako Yakɔbe duuluŋmantena yɛna nyiaa,</para>
  <para style="q1" vid="ISA 29:22">&lt;&lt;Desɛŋ be gyae ke kyaŋ Yakɔbe bela ya,</para>
  <para style="q2" vid="ISA 29:22">be sia be gyae ka yeŋ bela ya.<verse eid="ISA 29:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 29:23" />Akpaa be naa be bia,</para>
  <para style="q2" vid="ISA 29:23">baŋ mɔɔ mo me nyiŋmaa yɛɛ wɔ be man nɛ,</para>
  <para style="q1" vid="ISA 29:23">baa yɛɛ ma yele fereŋkyeŋ,</para>
  <para style="q2" vid="ISA 29:23">baa yɛɛ Yakɔbe fereŋkyeŋte ŋon fereŋkyeŋ,</para>
  <para style="q2" vid="ISA 29:23">na baa yee Iserae Wurubuarɛ ŋon.<verse eid="ISA 29:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 29:24" />Baŋ be yɛɛ behuhoonawɔ Wurubuarɛ Feliŋ man nɛ baa nyii nombia man,</para>
  <para style="q2" vid="ISA 29:24">te baŋ bɛɛ toroŋ nɛ baa lɛɛ nombia kawola do.&gt;&gt;<verse eid="ISA 29:24" /></para>
  <chapter eid="ISA 29" />
  <chapter number="30" style="c" sid="ISA 30" />
  <para style="s1">Tɛɛle keŋ ke dana deŋele doŋ nɛ dɛɛ laako</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 30:1" />Degbeŋgyoo kpa,</para>
  <para style="q2" vid="ISA 30:1">&lt;&lt;Baŋ bɛɛ koro seŋ tia balaŋ,</para>
  <para style="q1" vid="ISA 30:1">te bɛɛ bake kebake keŋ ta lee me gyaŋ ya,</para>
  <para style="q2" vid="ISA 30:1">bɛɛ yɛɛ nɔɔdokoloŋ keŋ me feliŋ be kpuɛna wɔ ya,</para>
  <para style="q2" vid="ISA 30:1">te bɛɛ mo dukum kpuna dukum nɛ baa laako,<verse eid="ISA 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 30:2" />bee tisi gyu Igyipite,</para>
  <para style="q2" vid="ISA 30:2">keŋ bɔɔ ne bɔɔse maŋ ya,</para>
  <para style="q1" vid="ISA 30:2">bee gyu Faaro gyaŋ ke gyae kegyee,</para>
  <para style="q2" vid="ISA 30:2">bee yeu kagyoo Igyipite wuluŋtɛɛ.<verse eid="ISA 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 30:3" />Mɔna Faaro kegyee keŋ gyae ka mo desɛŋ kɔna ŋon,</para>
  <para style="q2" vid="ISA 30:3">Igyipite wuluŋtɛɛ gyae ke yela ɛ sia ka yeŋ.<verse eid="ISA 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 30:4" />Doo nyi be dana kyaarabia Soan,</para>
  <para style="q2" vid="ISA 30:4">te be kpilara te kaa lii Hanese koraŋ nɛ,<verse eid="ISA 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 30:5" />desɛŋ gyae ke kyaŋ be man walaŋ kamasɛ,</para>
  <para style="q2" vid="ISA 30:5">lee balaŋ baŋ bɔɔ dana tɔnɔɔ fa wɔ ya,</para>
  <para style="q1" vid="ISA 30:5">te bɔɔ na mo kekyɔ na gbɛɛ kenyiŋ kɔna wɔ ya,</para>
  <para style="q2" vid="ISA 30:5">mɔna desɛŋ na siakayeŋ kaageŋ.&gt;&gt;<verse eid="ISA 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 30:6" />Keyakosee tia ata yenaŋ depampaa keŋ wonembia.</para>
  <para style="q1" vid="ISA 30:6">Ba moowɔ kaale na wosekekyaŋ tɛɛle,</para>
  <para style="q2" vid="ISA 30:6">keŋ dinaate baala na dinaate ala kyaa,</para>
  <para style="q2" vid="ISA 30:6">te gyakpatase na doma baŋ bee furufu kyaa nɛ man.</para>
  <para style="q1" vid="ISA 30:6">Ba moo ba wosekenyiŋ gyakaa afurumse maamase dɔɔ,</para>
  <para style="q2" vid="ISA 30:6">ba agyapadɛɛse gyakaa kurumɔɔse kebuse dɔɔ,</para>
  <para style="q1" vid="ISA 30:6">bee gyu tɛɛle keŋ bɔɔ nyiŋ tɔnɔɔ daale yɛ nɛ man.<verse eid="ISA 30:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="ISA 30:7" />Mɔna Igyipite kekyɔ be doo daale man ya,</para>
  <para style="q1" vid="ISA 30:7">mena dɔɔ mɛɛ baake e nyi,</para>
  <para style="q2" vid="ISA 30:7">Rahabe ohuhoo dekpataakpere ŋon.<verse eid="ISA 30:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 30:8" />Nɛnɛɛ gyu ke ŋmarase ke gyakaa boe papatalaa dɔɔ fa wɔ,</para>
  <para style="q2" vid="ISA 30:8">na n ke ŋmarase ke do tɔne man,</para>
  <para style="q1" vid="ISA 30:8">na ke yɛɛ adansɛɛ kekpaakekpaa,</para>
  <para style="q2" vid="ISA 30:8">fa weeya akaŋ ŋan ne kɔŋ nɛ.<verse eid="ISA 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 30:9" />Nawolo nyi be yɛɛ deŋele doŋtenawɔ, bia akɛrɛɛtena,</para>
  <para style="q2" vid="ISA 30:9">bia baŋ bɔɔ ne gyae nyi baa tei Degbeŋgyoo nombia kawola ya.<verse eid="ISA 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 30:10" />Bɛɛ yako baŋ bɛɛ naa nɛ nyi,</para>
  <para style="q2" vid="ISA 30:10">&lt;&lt;Ɛ na naa bela ya.&gt;&gt;</para>
  <para style="q1" vid="ISA 30:10">na ba te yako Wurubuarɛ gbalara baŋ nyi,</para>
  <para style="q2" vid="ISA 30:10">&lt;&lt;Ɛ naa tekaa naa anokoare nombia yako daa bela ya,</para>
  <para style="q1" vid="ISA 30:10">ɛ yako nombia ŋan dana daa gyoŋ,</para>
  <para style="q2" vid="ISA 30:10">na ɛ ke yako daa akɛrɛɛ gbale nombia.<verse eid="ISA 30:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 30:11" />Ɛ lee gbɛɛ kei dɔɔ,</para>
  <para style="q2" vid="ISA 30:11">ɛ lee detɛe kei man,</para>
  <para style="q1" vid="ISA 30:11">ɛ na mo Iserae fereŋkyeŋte ŋon,</para>
  <para style="q2" vid="ISA 30:11">nombia kaa tɔ daa deŋele bela ya.&gt;&gt;<verse eid="ISA 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 30:12" />Mena dɔɔ Iserae fereŋkyeŋte ŋon kpa,</para>
  <para style="q1" vid="ISA 30:12">&lt;&lt;Keŋ ɛ be bɛɛ nombii kei,</para>
  <para style="q2" vid="ISA 30:12">te ɛ ba mo ɛ wose lɔ balaŋ kaŋeredo,</para>
  <para style="q2" vid="ISA 30:12">na akɛrɛɛ kedi dɔɔ,<verse eid="ISA 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 30:13" />dukum kei gyae ke doo fa ŋon,</para>
  <para style="q2" vid="ISA 30:13">ŋgba dekyaŋ dakorosa keŋ ke dana kebɛɛlase te ne gyae ke yala nɛ,</para>
  <para style="q2" vid="ISA 30:13">ka keyala gyae ke kɔŋ debokenaŋ man karatetee dokoloŋ.<verse eid="ISA 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 30:14" />Ke gyae ke yɛlɛɛ bogobogo ŋgba saabu,</para>
  <para style="q2" vid="ISA 30:14">keŋ be yɛlɛɛ keŋ kolo te kaa ya,</para>
  <para style="q1" vid="ISA 30:14">keŋ bɔɔ nyiŋ ke yaalebii koraŋ,</para>
  <para style="q2" vid="ISA 30:14">na baa mo lese boalaŋ kosɔ man,</para>
  <para style="q2" vid="ISA 30:14">yaa baa mo kyee loŋ detiribuŋ man gba ya.&gt;&gt;<verse eid="ISA 30:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 30:15" />Nnɛ yaa Degbeŋgyoo Doŋ Pou Nyee, Iserae fereŋkyeŋte ŋon ne yako,</para>
  <para style="q1" vid="ISA 30:15">&lt;&lt;Ɛ kekyɛɛkee lee ɛ gbɛɛneŋ kumɛɛ man, na ɛ wose keyɔkɔse man te ɛ ke nyiŋ nyeekelɛɛ,</para>
  <para style="q2" vid="ISA 30:15">ɛ kekyaa yididi na ɛ loo ka mo gyakaa man te ɛ ke nyiŋ doŋ,</para>
  <para style="q2" vid="ISA 30:15">mɔna ɛ bɛɛ ŋe popou bo.<verse eid="ISA 30:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 30:16" />Te ɛ yakowɔ nyi, &lt;Koa, dɛɛ kyaa dɛɛkyɔŋse dɔɔ yeu.&gt;</para>
  <para style="q2" vid="ISA 30:16">Mena dɔɔ ɛ ke yeu ampaŋ ampaŋ,</para>
  <para style="q1" vid="ISA 30:16">Ɛ yakowɔ nyi, &lt;Dɛɛ kyaa dɛɛkyɔŋse baŋ be dana ɔsaa nɛ dɔɔ,</para>
  <para style="q2" vid="ISA 30:16">Mena dɔɔ baŋ bee gegi ŋon nɛ baa yɛɛ ɔsaa kela ŋon,<verse eid="ISA 30:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 30:17" />Balaŋ kakpoŋ baa yeu,</para>
  <para style="q2" vid="ISA 30:17">lee walaŋ dokoloŋ keŋmaase man,</para>
  <para style="q1" vid="ISA 30:17">nyi balaŋ banoŋ de ŋmaase ŋon na,</para>
  <para style="q2" vid="ISA 30:17">ɛ popou ɛ ke yeu</para>
  <para style="q1" vid="ISA 30:17">kelii debaŋ keŋ ɛ ke ka,</para>
  <para style="q2" vid="ISA 30:17">felage daŋ keŋ seŋɛɛ bula nyee dɔɔ,</para>
  <para style="q2" vid="ISA 30:17">ŋgba felage keŋ gyakaa bulabii dɔɔ nɛ.&gt;&gt;<verse eid="ISA 30:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 30:18" />Mɔna Degbeŋgyoo ne gyae nyi waa boele ŋon,</para>
  <para style="q2" vid="ISA 30:18">mena dɔɔ waa koro nyi waa wii ɛ waraŋase.</para>
  <para style="q1" vid="ISA 30:18">Nawolo nyi Degbeŋgyoo yɛɛ nombia kedi ke gbɛɛ dɔɔ Wurubuarɛ e.</para>
  <para style="q2" vid="ISA 30:18">Baŋ pou bɛɛ kɛɛ ɔ gbɛɛ nɛ, baŋna nyeebam.<verse eid="ISA 30:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 30:19" />Ɛmɛɛ Siyɔntena baŋ ɛ kyaa Yerusalɛm, ɛ be gyae ɛ ke wii bela ya. Nyi ɛ wii baake e nyi waa kyɔ ŋon na waa boele ŋon. Nyi ɔ nyii pɛ, waa kpa ŋon. <verse eid="ISA 30:19" /><verse number="20" style="v" sid="ISA 30:20" />Doo nyi Degbeŋgyoo ne fa ŋon wosekekyaŋ weenɛɛ, na kayeyɛɛ loŋ koraŋ nɛ, ɛ wolara be gyae baa tekaa mo ba wose weese bela ya, mɔna ɛmɛɛ gbagba ɛ ka mo ɛ sia naa wɔ. <verse eid="ISA 30:20" /><verse number="21" style="v" sid="ISA 30:21" />Nyi akpaa ɛ besena demena yaa dunoluŋ dɔɔ nɛ, ɛ deŋela gyae ke nyii woya ɛ wɔle nyiaa, &lt;&lt;Kei yɛna gbɛɛ keŋ, ɛ ta ke dɔɔ.&gt;&gt; <verse eid="ISA 30:21" /><verse number="22" style="v" sid="ISA 30:22" />Botɔɔ te ɛ ke waalaa ɛ bɛɛneŋ baŋ bɔɔ mo kɔba wolom gyilaa ŋa, na ŋe dinɔɔse ŋan bɔɔ mo kɔba yayam gyilaa ŋa nɛ. Ɛ ke fuŋii ŋa leki ŋgba abɔɔ ŋan ŋa wose dana ayimɛɛ nɛ, na ɛ ke yako ŋa nyiaa, &lt;&lt;Ɛ lee de gyaŋ!&gt;&gt;<verse eid="ISA 30:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 30:23" />Waa yela ɔga ke ŋɛɛ woli ya abɔɔ ŋan ɛ be duu wɔɔse man nɛ, te weenɛɛ ŋan gyae ka lee tɛɛle keŋ man kɔŋ gyae ke de te ŋe gyae ka bo. Mena wee kenaŋ nɛ, ɛ nunkyuese baa dii botɔɔse ŋan fɛlɛɛ nɛ. <verse eid="ISA 30:23" /><verse number="24" style="v" sid="ISA 30:24" />Nunkyue baala na afurumse baŋ bɛɛ yɛɛ tom nɛ, baa di weenɛɛ kpaakpaa ŋan bɔɔ mo fɔɔke na sɔɔfe saale ŋa nɛ. <verse eid="ISA 30:24" /><verse number="25" style="v" sid="ISA 30:25" />Wee keŋ baa koe balaŋ burum nɛ, dekagyase ŋan gyae ke yɛlɛɛ loŋse gyae ke puu lee bula kamasɛ keŋ korɛɛ na bulabii kamasɛ keŋ korɛɛ nɛ man. <verse eid="ISA 30:25" /><verse number="26" style="v" sid="ISA 30:26" />Nyi akpaa Degbeŋgyoo de bake ɔ balaŋ gyamɛɛ te ɔ kyɔ wɔ be gyamɛɛ ŋan ɔ ba doo wɔ nɛ, gyaalaŋ waa ŋalakee ŋgba weese nɛ, te weese kegyɔ gyae ke ŋalakee batabo nyetooro ŋgba weeya nyetooro keŋalakee nɛ.<verse eid="ISA 30:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 30:27" />Kɛɛ, Degbeŋgyoo Yele keŋ ta lee lemlem ne kɔŋ,</para>
  <para style="q2" vid="ISA 30:27">na baŋ keŋ kɛɛ kpaa na dubuŋta nyɔɔse tuum keŋ</para>
  <para style="q1" vid="ISA 30:27">baŋ te wulu ɔ nɔɔ,</para>
  <para style="q2" vid="ISA 30:27">te ɔ laakem yɛɛ boalaŋ keŋ kɛɛ kpaa abɔɔ.<verse eid="ISA 30:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 30:28" />Ɔ weesɛɛ yɛɛ ŋgba kakpela keŋ kɛɛ gyɔɔ nedoŋ</para>
  <para style="q2" vid="ISA 30:28">gyeŋ kelii wɔŋe man,</para>
  <para style="q1" vid="ISA 30:28">Ɔ na mo kewɔlɛɛ saano kyekyɛɛ tɛɛlese,</para>
  <para style="q2" vid="ISA 30:28">ɔ na mo dokɔŋ do balaŋ baŋ nɔɔse man,</para>
  <para style="q2" vid="ISA 30:28">na ka mo wɔ kpase gbɛɛ.<verse eid="ISA 30:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 30:29" />Ɛ ke kpee nɔɔneŋ ŋgba</para>
  <para style="q2" vid="ISA 30:29">nelim keŋ ɛ be di siŋkiti fereŋkyeŋ keŋ nɛ,</para>
  <para style="q1" vid="ISA 30:29">ɛ konɔɔse gyae ke nyaŋee,</para>
  <para style="q2" vid="ISA 30:29">ŋgba mena keŋ baŋ bɛɛ wola kefereese na gyem gyu,</para>
  <para style="q1" vid="ISA 30:29">Degbeŋgyoo bula dɔɔ,</para>
  <para style="q2" vid="ISA 30:29">gyu Iserae kpanaŋ keŋ gyaŋ.<verse eid="ISA 30:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 30:30" />Degbeŋgyoo waa yela balaŋ kenyii ɔ gyoorobiiri woya,</para>
  <para style="q2" vid="ISA 30:30">na ke yela baa naa ɔ nyiŋmaa ke tisina,</para>
  <para style="q1" vid="ISA 30:30">na baŋ doŋ na boalaŋ keŋ ne nyakee abɔɔ,</para>
  <para style="q2" vid="ISA 30:30">na ɔga dinaa na ɔga kefae na akpeleŋkpeleŋbia,<verse eid="ISA 30:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 30:31" />Degbeŋgyoo woya gyae ka do Asiriya gyakoloŋ,</para>
  <para style="q2" vid="ISA 30:31">waa mo ɔ dambila gyɔ wɔ lɔ.<verse eid="ISA 30:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 30:32" />Debaŋ kamasɛ keŋ Degbeŋgyoo da mo</para>
  <para style="q2" vid="ISA 30:32">deŋele kewɔŋ okpokpo gyɔ wɔ na,</para>
  <para style="q1" vid="ISA 30:32">gyae ke yɛɛ ŋgba akyakaase na akayase kegyɔ nɛ,</para>
  <para style="q2" vid="ISA 30:32">ŋgba mena keŋ ɔ be fuŋ ɔ nyiŋmaa dokɔta yooman nɛ.<verse eid="ISA 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ISA 30:33" />Be te wulaa desina dekpalaŋ see,</para>
  <para style="q2" vid="ISA 30:33">be desina ke see fa gyoo.</para>
  <para style="q1" vid="ISA 30:33">Be wula boalaŋ bɔɔ keŋ gyoo tɔɔman te ke fɛlɛɛ,</para>
  <para style="q2" vid="ISA 30:33">te boalaŋ na daase burum doo ke man.</para>
  <para style="q2" vid="ISA 30:33">Degbeŋgyoo weesɛɛ keŋ,</para>
  <para style="q1" vid="ISA 30:33">yɛɛ ŋgba kpatakpela anekpaaŋ nɛ,</para>
  <para style="q2" vid="ISA 30:33">gyae ke kpa ke.<verse eid="ISA 30:33" /></para>
  <chapter eid="ISA 30" />
  <chapter number="31" style="c" sid="ISA 31" />
  <para style="s1">Baŋ bɛɛ mo ba wose lɔ Igyipite dɔɔ nɛ baa laako</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 31:1" />Baŋ bee gyu Igyipite ke gyae kekyɔ,</para>
  <para style="q2" vid="ISA 31:1">baŋ bɛɛ mo be loo gyakaa dɛɛkyɔŋse dɔɔ,</para>
  <para style="q1" vid="ISA 31:1">te bɛɛ mo ba wose lɔ be yookɔtase burum,</para>
  <para style="q2" vid="ISA 31:1">na be dɛɛkyɔŋ kyaara doŋ dɔɔ,</para>
  <para style="q1" vid="ISA 31:1">te bɔɔ na mo be sia gyakaa Iserae fereŋkyeŋte ŋon dɔɔ,</para>
  <para style="q2" vid="ISA 31:1">yaa baa kɛo Degbeŋgyoo gbɛɛ ya nɛ, baa laako.<verse eid="ISA 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 31:2" />Mɔna ŋon mɔ yɛɛ siakaralate e keŋ waa tale mo nombiikum kɔŋ,</para>
  <para style="q2" vid="ISA 31:2">ɔ bɛɛ lee ɔ nombii wɔle ya,</para>
  <para style="q1" vid="ISA 31:2">waa seŋ tia akpanyanyaŋtena,</para>
  <para style="q2" vid="ISA 31:2">na baŋ bɛɛ sem nombiakumɛɛ yɛɛra wɔle nɛ.<verse eid="ISA 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 31:3" />Mɔna Igyipitetena yɛɛ denibalaŋwɔ, ba te yɛɛ Wurubuarɛ e ya,</para>
  <para style="q2" vid="ISA 31:3">be dɛɛkyɔŋse yɛɛ wosenaane ke, te ba te yɛɛ feliŋ ya.</para>
  <para style="q1" vid="ISA 31:3">Akpaa Degbeŋgyoo da tenee ɔ baam nɛ,</para>
  <para style="q1" vid="ISA 31:3">baŋ bɛɛ kyɔ balaŋ nɛ baa kpaŋte,</para>
  <para style="q2" vid="ISA 31:3">baŋ mɔ balaŋ ne kyɔ wɔ nɛ baa yala,</para>
  <para style="q2" vid="ISA 31:3">be popou baa munu.<verse eid="ISA 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 31:4" />Keŋ Degbeŋgyoo be yako maŋ yɛna nyiaa,</para>
  <para style="q1" vid="ISA 31:4">&lt;&lt;Mena keŋ dinaate,</para>
  <para style="q2" vid="ISA 31:4">dinaate de kyaŋ wonembu te ɔ ne muusu,</para>
  <para style="q1" vid="ISA 31:4">te be baake wonembia kɛɛlera burum,</para>
  <para style="q2" vid="ISA 31:4">kɔŋ koraŋ na be yeesa bɛɛ do e gyakoloŋ ya,</para>
  <para style="q1" vid="ISA 31:4">te ba agiŋgiŋ mɔ bɛɛ ŋmaase e ya nɛ,</para>
  <para style="q1" vid="ISA 31:4">mena te Degbeŋgyoo Dekpataakpere ŋon waa tisi kɔŋ,</para>
  <para style="q2" vid="ISA 31:4">na ɔ kaa yoo Siyɔn bula na ke bulasebia dɔɔ.<verse eid="ISA 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 31:5" />Mena keŋ gyebuse ne furufu gyu kɔŋ nɛ, mena te Degbeŋgyoo Dekpataakpere ŋon,</para>
  <para style="q2" vid="ISA 31:5">waa gyee Yerusalɛm,</para>
  <para style="q1" vid="ISA 31:5">waa gyee ke na waa lɛɛ ke,</para>
  <para style="q2" vid="ISA 31:5">waa gbaa ke na waa lɛɛ ke.<verse eid="ISA 31:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 31:6" />Oo Iseraetena, ɛ bese kɔŋ ŋon ɛ ba koro seŋ tia nideli nɛ gyaŋ. <verse eid="ISA 31:6" /><verse number="7" style="v" sid="ISA 31:7" />Nawolo nyi mena wee kenaŋ, ɛ man walaŋ kamasɛ waa fuŋ ɔ kɔba yayam na kɔba wolom bɛɛneŋ baŋ ɛ ba mo ɛ dukum nyiŋmaase yɛɛ nɛ leki.<verse eid="ISA 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 31:8" />Asiriyatena baa yala yoosila keŋ ka te yɛɛ denibalaŋ wui ya nɛ nɔɔman,</para>
  <para style="q2" vid="ISA 31:8">yoosila keŋ ka te yɛɛ denibalaŋ wui ya nɛ gyae ke wɔlɛɛ wɔ.</para>
  <para style="q1" vid="ISA 31:8">Baa yeu lee yoosila nɔɔman,</para>
  <para style="q2" vid="ISA 31:8">baa ŋere be tewulɛɛ yela baa yɛɛ tom nedoŋ.<verse eid="ISA 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 31:9" />Ba keyeu kagyoo gyae ka lee yala lee gyakoloŋ dɔɔ,</para>
  <para style="q2" vid="ISA 31:9">be yoonɔɔtena kegyiise de gyɔ sibii naa yoo keŋ na ba wose gyae ke seree wɔ,</para>
  <para style="q1" vid="ISA 31:9">Degbeŋgyoo ŋon ɔ boalaŋ doo Siyɔn,</para>
  <para style="q2" vid="ISA 31:9">te ɔ boalaŋ degyapaa doo Yerusalɛm nɛ,</para>
  <para style="q2" vid="ISA 31:9">torola yako.<verse eid="ISA 31:9" /></para>
  <chapter eid="ISA 31" />
  <chapter number="32" style="c" sid="ISA 32" />
  <para style="s1">Katenee Gyooridedii keŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 32:1" />Kɛɛ, gyoo ŋolo waa di gyoori katenee man,</para>
  <para style="q2" vid="ISA 32:1">na ɔ kyaarabia kedi nombia kegbɛɛ dɔɔ.<verse eid="ISA 32:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 32:2" />Ɔkamasɛ waa yɛɛ ŋgba dayoe nɛ lee feliŋ man,</para>
  <para style="q2" vid="ISA 32:2">na keyeu kagyoo lee feliŋkum man,</para>
  <para style="q1" vid="ISA 32:2">ŋgba depampaa boŋobiise man loŋse,</para>
  <para style="q2" vid="ISA 32:2">na tɛɛle dowolosa man kpanaŋ dinaa wuluŋ nɛ.<verse eid="ISA 32:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 32:3" />Kenaŋ na baŋ be sia ne naa nɛ sia be gyae ke wuu bela ya,</para>
  <para style="q2" vid="ISA 32:3">te baŋ ba deŋela ne nyii nɛ baa tei.<verse eid="ISA 32:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 32:4" />Baŋ bɛɛ barase yɛɛ abɔɔ nɛ baa gyoo ŋe man pɛ baa yɛɛ,</para>
  <para style="q2" vid="ISA 32:4">te baŋ bee wuku nɛ laakemse gyae ke kolosi nideli na ke doo ke gbɛɛ dɔɔ.<verse eid="ISA 32:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 32:5" />Bɔɔ teka baake diyiŋte nyi gyoorobu,</para>
  <para style="q2" vid="ISA 32:5">yaa baa baake ohuhoo nyi kyaarabu ya.<verse eid="ISA 32:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 32:6" />Nawolo nyi ayiŋtena ne kolosi diyiŋ nombia,</para>
  <para style="q2" vid="ISA 32:6">te bɛɛ gyueŋ nombiakumɛɛ.</para>
  <para style="q1" vid="ISA 32:6">Bɛɛ yɛɛ ŋan te yɛɛ Degbeŋgyoo kawola ya,</para>
  <para style="q2" vid="ISA 32:6">te bee kolosi akɛrɛɛ nombia lee Degbeŋgyoo wose man,</para>
  <para style="q1" vid="ISA 32:6">bɛɛ bɛɛse baŋ tanam na ko wɔ nɛ weenɛɛ,</para>
  <para style="q2" vid="ISA 32:6">te bɔɔ ne fa ŋon loŋboaneŋ na ko e nɛ loŋ ya.<verse eid="ISA 32:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 32:7" />Behuhoona na mo akpanyanyaŋ gbɛɛneŋ,</para>
  <para style="q2" vid="ISA 32:7">bɛɛ bake nombiakumɛɛ</para>
  <para style="q1" vid="ISA 32:7">nyi baa mo akɛrɛɛ wɔlɛɛ diyemte,</para>
  <para style="q2" vid="ISA 32:7">na baŋ bɔɔ dana kolo ya, akpaa be nombia doona ke gbɛɛ koraŋ na.<verse eid="ISA 32:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 32:8" />Mɔna gyoorobu ne yɛɛ nombia ŋan kaboena,</para>
  <para style="q2" vid="ISA 32:8">te nombia ŋan kaboena keyɛɛ dɔɔ te ba seŋɛɛ.<verse eid="ISA 32:8" /></para>
  <para style="s1">Yerusalɛm ala</para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 32:9" />Ɛmɛɛ ala baŋ ɛ wose be fɛɛ ŋon,</para>
  <para style="q2" vid="ISA 32:9">ɛ koro na ɛ ke tei maŋ.</para>
  <para style="q1" vid="ISA 32:9">ɛmɛɛ bia alebia baŋ ɛ be nyiŋ ɛ wose,</para>
  <para style="q2" vid="ISA 32:9">ɛ nyii keŋ maa yako.<verse eid="ISA 32:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 32:10" />Kɛbo kulutoo na weeya kyomii nɛ,</para>
  <para style="q2" vid="ISA 32:10">ɛmɛɛ baŋ ɛ be nyiŋ ɛ wose nɛ ɛ ke seree,</para>
  <para style="q1" vid="ISA 32:10">gerepo bia be gyae ka se ya,</para>
  <para style="q2" vid="ISA 32:10">te ɛ be gyae ɛ ke nyiŋ daasebia kɔ ya.<verse eid="ISA 32:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 32:11" />Ɛmɛɛ ala baŋ ɛ wose be fɛɛ ŋon, ɛ seree,</para>
  <para style="q2" vid="ISA 32:11">ɛmɛɛ bia alebia baŋ ɛ be nyiŋ ɛ wose, ɛ yeyɛɛ,</para>
  <para style="q1" vid="ISA 32:11">ɛ kpee ya abɔɔ kpaakpaa ŋan see,</para>
  <para style="q2" vid="ISA 32:11">na ɛ ka mo kakyeŋgbelaase kaa.<verse eid="ISA 32:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 32:12" />Ɛ yeyɛɛ lee tɛɛle kpaakpaa keŋ dɔɔ,</para>
  <para style="q2" vid="ISA 32:12">fa woŋse ŋan na see nideli nɛ dɔɔ,<verse eid="ISA 32:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 32:13" />na me balaŋ tɛɛle keŋ,</para>
  <para style="q2" vid="ISA 32:13">tɛɛle keŋ kpalamse na kpaŋkpaŋkorolose be tuu ke man nɛ,</para>
  <para style="q1" vid="ISA 32:13">ayi, ɛ di waraŋsa fa akpaŋalaŋ ŋan ne nyaŋee,</para>
  <para style="q2" vid="ISA 32:13">na donɔɔ dinaa kei keŋ kee di gyoŋ nɛ.<verse eid="ISA 32:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 32:14" />Baa bɛɛ degyee keŋ,</para>
  <para style="q2" vid="ISA 32:14">yeesa donɔɔ dinaa keŋ gyae ke doo yakaa,</para>
  <para style="q1" vid="ISA 32:14">donɔɔ dinaa keŋ bɔɔ gyee ke, na kegyee dekagya keŋ gyae ke doo yakaa kekpaakekpaa,</para>
  <para style="q2" vid="ISA 32:14">afurumse baa yoi botɔɔ, na ke ka bese wonembia dedii,<verse eid="ISA 32:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 32:15" />kelii debaŋ keŋ waa mo ɔ feliŋ lee adido kaa do de man,</para>
  <para style="q2" vid="ISA 32:15">na depampaa ka bese tɛɛle kpaakpaa,</para>
  <para style="q2" vid="ISA 32:15">na tɛɛle kpaakpaa ke yɛɛ ŋgba laa nɛ.<verse eid="ISA 32:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 32:16" />Degbeŋgyoo nombia kedi kegbɛɛ dɔɔ gyae ke doo depampaa keŋ man,</para>
  <para style="q2" vid="ISA 32:16">ɔ katenee kyaa tɛɛle kpaakpaa keŋ man.<verse eid="ISA 32:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 32:17" />Katenee kenaŋ bia gyae ke yɛɛ wosefɛɛreŋ,</para>
  <para style="q2" vid="ISA 32:17">keŋ gyae ka lee ke man yɛna kekyaa yididi na wose kamo lɔ kekpaakekpaa.<verse eid="ISA 32:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 32:18" />Me balaŋ baa kyaa wosefɛɛreŋ akyaese man,</para>
  <para style="q2" vid="ISA 32:18">wose kefɛɛ akpaŋalaŋse man,</para>
  <para style="q2" vid="ISA 32:18">na wɔe kefɛɛ akyaese man.<verse eid="ISA 32:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 32:19" />Doo nyi akpeleŋkpeleŋbia gyae ke wɔlɛɛ laa keŋ,</para>
  <para style="q2" vid="ISA 32:19">te gyae ke tala donɔɔ dinaa keŋ kerekere nɛ,<verse eid="ISA 32:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 32:20" />ɛmɛɛ baŋ ɛ ke duu abɔɔ booneŋ nɔɔman,</para>
  <para style="q2" vid="ISA 32:20">na ɛ ke yela ɛ nunkyuese na afurumse ke kila dii nɛ,</para>
  <para style="q2" vid="ISA 32:20">ɛmɛɛna nyeebam.<verse eid="ISA 32:20" /></para>
  <chapter eid="ISA 32" />
  <chapter number="33" style="c" sid="ISA 33" />
  <para style="s1">Kayeyɛɛ na kekyɔ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 33:1" />Nyaŋ wɔlɛɛre,</para>
  <para style="q2" vid="ISA 33:1">ŋon ba te wɔlɛɛ neŋ ya, laako!</para>
  <para style="q1" vid="ISA 33:1">Nyaŋ ŋon n na lese balaŋ fa,</para>
  <para style="q2" vid="ISA 33:1">te be ta lese neŋ fa ya nɛ, laako!</para>
  <para style="q1" vid="ISA 33:1">Akpaa n tina kewɔlɛɛ yela nɛ,</para>
  <para style="q2" vid="ISA 33:1">baa wɔlɛɛ neŋ,</para>
  <para style="q1" vid="ISA 33:1">Akpaa n tina kalesefa yela nɛ,</para>
  <para style="q2" vid="ISA 33:1">baa lese neŋ fa.<verse eid="ISA 33:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="ISA 33:2" />Degbeŋgyoo, boele daa,</para>
  <para style="q2" vid="ISA 33:2">nawolo nyi dɛɛ kɛo neŋ.</para>
  <para style="q1" vid="ISA 33:2">Yɛɛ de doŋ nebo kamasɛ,</para>
  <para style="q2" vid="ISA 33:2">da nyeekelɛɛ kayeyɛɛ man.<verse eid="ISA 33:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 33:3" />N faedo na balaŋ ne yekii,</para>
  <para style="q2" vid="ISA 33:3">n koro na tɛɛlese ne yaasee.<verse eid="ISA 33:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 33:4" />Be te yilaa n yooman abɔɔ ŋgba akpataanabia kee yilaa nɛ,</para>
  <para style="q2" vid="ISA 33:4">balaŋ ne wuu abɔɔ dɔɔ ŋgba akpataana dikpii nɛ.<verse eid="ISA 33:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 33:5" />Be te gyina Degbeŋgyoo, nawolo nyi ɔ kyaa adido adido,</para>
  <para style="q1" vid="ISA 33:5">ɔ nombia kedi kegbɛɛ dɔɔ na ɔ katenee gyae ke wuu Siyɔn.<verse eid="ISA 33:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 33:6" />Waa yɛɛ mokɔɔkasee doŋte ɛ debaŋ man,</para>
  <para style="q2" vid="ISA 33:6">nyeekelɛɛ na nyansa na nombia kagyeŋ gyae ka bo fa wɔ,</para>
  <para style="q1" vid="ISA 33:6">Degbeŋgyoo keyee yɛna ba wosekenyiŋ.<verse eid="ISA 33:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 33:7" />Kɛɛ, be baalabia ne wii keŋkeŋ abɔnterese man,</para>
  <para style="q2" vid="ISA 33:7">wosefɛɛreŋ kpilara ne wii moomoomoo.<verse eid="ISA 33:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 33:8" />Ba te bɛɛ gbɛɛneŋ dinaana ŋan,</para>
  <para style="q2" vid="ISA 33:8">gbɛɛtɛɛra bɛɛ tɛɛ gbɛɛneŋ ŋan dɔɔ ya.</para>
  <para style="q1" vid="ISA 33:8">Nɔɔkebakesee keŋ te wɔlɛɛ,</para>
  <para style="q2" vid="ISA 33:8">ba te bɛɛ adansɛɛ ŋan,</para>
  <para style="q2" vid="ISA 33:8">bɔɔ ne bu walaŋ na walaŋ ya.<verse eid="ISA 33:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 33:9" />Tɛɛle keŋ ta wolo te ka te wɔlɛɛ,</para>
  <para style="q2" vid="ISA 33:9">Lebanɔn sia ta yem te ke ta boto,</para>
  <para style="q1" vid="ISA 33:9">Saron yɛɛ ŋgba depampaa nɛ,</para>
  <para style="q2" vid="ISA 33:9">te Basan na Kamɛle te kpiisi faareŋse.<verse eid="ISA 33:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 33:10" />Degbeŋgyoo kpa nyiaa, &lt;&lt;Nɛnɛɛ maa koro,&gt;&gt;</para>
  <para style="q2" vid="ISA 33:10">&lt;&lt;Nɛnɛɛ maa gyina ma wose adido,</para>
  <para style="q2" vid="ISA 33:10">nɛnɛɛ maa gate ma wose adido.<verse eid="ISA 33:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 33:11" />Ɛ te kyaŋ wura fulu,</para>
  <para style="q2" vid="ISA 33:11">ɛ lola kaase,</para>
  <para style="q2" vid="ISA 33:11">ɛ weesɛɛ yɛna boalaŋ keŋ gyae ke kpa ŋon.<verse eid="ISA 33:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 33:12" />Balaŋ baŋ baa kpa bese tɔŋ,</para>
  <para style="q2" vid="ISA 33:12">baa do wɔ boalaŋ ŋgba sɔɔse ŋan bɔɔ kɛrɛɛ see nɛ.&gt;&gt;<verse eid="ISA 33:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="ISA 33:13" />Ɛmɛɛ baŋ ɛ kyaa lemlem, ɛ nyii kpene keŋ mɔɔ yɛɛ,</para>
  <para style="q2" vid="ISA 33:13">ɛmɛɛ baŋ ɛ benaa, ɛ gyene me wɔɔle.<verse eid="ISA 33:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 33:14" />Gyakoloŋ ta gyoo dukumyɛɛra baŋ be kyaa Siyɔn,</para>
  <para style="q2" vid="ISA 33:14">keseree ta gyoo baŋ bɔɔ ne yee Wurubuarɛ ya nɛ.</para>
  <para style="q1" vid="ISA 33:14">&lt;&lt;De man woŋti ne gyaela waa tale seŋ boalaŋ degyapaa keŋ nɔɔman?</para>
  <para style="q2" vid="ISA 33:14">De man woŋti ne gyaela waa tale kyaa boalaŋ keŋ kɛɛ kpaa kekpaakekpaa nɛ gyaŋ?&gt;&gt;<verse eid="ISA 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 33:15" />Baŋ ba keta man tenɛɛ,</para>
  <para style="q2" vid="ISA 33:15">te bee kolosi keŋ ke doona kegbɛɛ,</para>
  <para style="q1" vid="ISA 33:15">te bɛɛ bɛɛ kolo kenyiŋ lee gbɛɛkum man,</para>
  <para style="q2" vid="ISA 33:15">te bɛɛ bɛɛ kolo kayolɛɛ,</para>
  <para style="q1" vid="ISA 33:15">baŋ bɛɛ tɔ ba deŋela lee balaŋ kako nombia man,</para>
  <para style="q2" vid="ISA 33:15">te bee wuu be sia nyi bɔɔ kɛɛ dukum ya nɛ,<verse eid="ISA 33:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 33:16" />baŋ yɛna baŋ baa kyaa botɔɔ keŋ korɛɛ,</para>
  <para style="q2" vid="ISA 33:16">be keyeu kagyoo gyae ke yɛɛ bula dekagya keŋ.</para>
  <para style="q1" vid="ISA 33:16">Baa fa wɔ weenɛɛ,</para>
  <para style="q2" vid="ISA 33:16">te loŋ be gyae ke paŋ wɔ ya.<verse eid="ISA 33:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ISA 33:17" />Ɛ sia gyae ke naa gyoo ŋon ɔ gyoorobiiri man,</para>
  <para style="q2" vid="ISA 33:17">te ɛ ke kɛɛ tɛɛle keŋ fɛlɛɛ gyu lemlem.<verse eid="ISA 33:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 33:18" />Nyaŋ ka gyueŋ gyaŋgba gyakoloŋ nombia ŋan man nyiaa,</para>
  <para style="q2" vid="ISA 33:18">&lt;&lt;Nde ŋon ɔ ne kala abɔɔ nɛ?</para>
  <para style="q1" vid="ISA 33:18">Nde ŋon ɔ ne lɛɛ totose nɛ?</para>
  <para style="q2" vid="ISA 33:18">Nde ŋon ɔ ne kala dekagyase ŋan nɛ?&gt;&gt;<verse eid="ISA 33:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 33:19" />Ɛ ba tekaa naa agaŋtaŋtena benaŋ bela ya,</para>
  <para style="q2" vid="ISA 33:19">balaŋ baŋ bɛɛ lɔkɔtee,</para>
  <para style="q2" vid="ISA 33:19">baŋ bee kolosi dei keŋ ŋolo bee nyii ke man ya.<verse eid="ISA 33:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ISA 33:20" />Ɛ kɛɛ Siyɔn, de nɔɔkedi donɔɔ dinaa keŋ,</para>
  <para style="q2" vid="ISA 33:20">ɛ sia gyae kena Yerusalɛm,</para>
  <para style="q2" vid="ISA 33:20">wosefɛɛreŋ dekyae, kanyaŋ deni keŋ bɔɔ gyae baa lese ke ya,</para>
  <para style="q1" vid="ISA 33:20">bɔɔ gyae baa kulii ke tuulase,</para>
  <para style="q2" vid="ISA 33:20">yaa baa kɛrɛɛ ka ŋmeeseŋ ya.<verse eid="ISA 33:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 33:21" />Botɔɔ te Degbeŋgyoo waa yɛɛ de doŋte.</para>
  <para style="q2" vid="ISA 33:21">Botɔɔ gyae ke yɛɛ ŋgba booneŋ dinaana na boŋobiise dekyae,</para>
  <para style="q1" vid="ISA 33:21">bɔɔ gyae baa saa agbelese ŋe dɔɔ ya,</para>
  <para style="q2" vid="ISA 33:21">pantuuse be gyae baa ta ŋe dɔɔ ya.<verse eid="ISA 33:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 33:22" />Nawolo nyi Degbeŋgyoo yɛna de nombiadiiri,</para>
  <para style="q2" vid="ISA 33:22">Degbeŋgyoo ne faana daa mmaraase,</para>
  <para style="q1" vid="ISA 33:22">Degbeŋgyoo yɛna de gyoo,</para>
  <para style="q2" vid="ISA 33:22">ŋon yɛna ŋon waa lɛɛ da nyee.<verse eid="ISA 33:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="ISA 33:23" />N ŋmeeseŋ man te yɔkɔse,</para>
  <para style="q2" vid="ISA 33:23">be tale kyaŋ degbele daase ŋan keŋkeŋ ya,</para>
  <para style="q2" vid="ISA 33:23">bɛɛ tale fɛlɛɛ kanyaŋ keŋ man ya,</para>
  <para style="q1" vid="ISA 33:23">kenaŋ na baa kpala yooman abɔɔ burum ŋan,</para>
  <para style="q2" vid="ISA 33:23">ɔtakase koraŋ waa ŋmaa abɔɔ.<verse eid="ISA 33:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 33:24" />Ŋolo be kyaa Siyɔn keŋ waa yako nyi, &lt;&lt;Mɛɛ wee,&gt;&gt; ya,</para>
  <para style="q2" vid="ISA 33:24">te baa mo baŋ be kyaa botɔɔ nɛ dukum kyɛɛ wɔ.<verse eid="ISA 33:24" /></para>
  <chapter eid="ISA 33" />
  <chapter number="34" style="c" sid="ISA 34" />
  <para style="s1">Nombia kedi tia tɛɛlese ŋan</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 34:1" />Ɛmɛɛ tɛɛlese, ɛ tuu kɔŋ, na ɛ ke tei,</para>
  <para style="q2" vid="ISA 34:1">ɛmɛɛ balaŋ pou, ɛ see deŋele nideli.</para>
  <para style="q1" vid="ISA 34:1">Tɛɛle na baŋ pou be kyaa ke dɔɔ, ɛ nyii,</para>
  <para style="q2" vid="ISA 34:1">tɛɛle kei na ŋan pou na lee ke man.<verse eid="ISA 34:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 34:2" />Degbeŋgyoo ta gyeŋ baŋ do tɛɛlese pou,</para>
  <para style="q2" vid="ISA 34:2">ɔ ta gyeŋ baŋ do be yoonɔɔtena pou.</para>
  <para style="q1" vid="ISA 34:2">waa wɔlɛɛ wɔ pou,</para>
  <para style="q2" vid="ISA 34:2">ɔ te bu wɔ fɔɔ nyi baa ko wɔ.<verse eid="ISA 34:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 34:3" />Baa fuŋii be balaŋ baŋ bɔɔ yale yoo man nɛ leki,</para>
  <para style="q2" vid="ISA 34:3">be balaŋ ayeŋɛɛ baa lee wɔŋ kutukutu,</para>
  <para style="q1" vid="ISA 34:3">be fatabose gyae ke kyɔsee lee bulase dɔɔ.<verse eid="ISA 34:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 34:4" />Adido kyolobiise pou gyae ke ŋaalaa,</para>
  <para style="q2" vid="ISA 34:4">na adido ke bɔ ŋgba wonembu tɔne nɛ,</para>
  <para style="q1" vid="ISA 34:4">abɔɔ ŋan pou kyaa adido gyae ka lee yala,</para>
  <para style="q2" vid="ISA 34:4">ŋgba faareŋ awolɛɛ ne kpiisi lee waen woŋse man nɛ,</para>
  <para style="q2" vid="ISA 34:4">ŋgba fiigi bia ayɛɛ ne kpiisi lee fiigi daŋ man nɛ,<verse eid="ISA 34:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 34:5" />Me yoosila te nyɔɔ fatabo baa adido,</para>
  <para style="q2" vid="ISA 34:5">kɛɛ, ke gyae ke tisi kɔŋ Edom,</para>
  <para style="q2" vid="ISA 34:5">kaa di me balaŋ baŋ mɔɔ wɔlɛɛ wɔ kerekere nɛ nombia.<verse eid="ISA 34:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 34:6" />Fatabo te fɔ Degbeŋgyoo yoosila,</para>
  <para style="q2" vid="ISA 34:6">nuŋ te milii ke,</para>
  <para style="q1" vid="ISA 34:6">namensebia na asoose fatabo,</para>
  <para style="q2" vid="ISA 34:6">namense baala bembia nuŋse.</para>
  <para style="q1" vid="ISA 34:6">Nawolo nyi Degbeŋgyoo dana kedeesa Bosera,</para>
  <para style="q2" vid="ISA 34:6">ke yɛɛ wonembia kako dinaa ke Edom tɛɛle man.<verse eid="ISA 34:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 34:7" />Baŋ na ŋale man namense baa debodokoloŋ lee yala,</para>
  <para style="q2" vid="ISA 34:7">kpuna nunkyuebia na nunkyue baala dinaana,</para>
  <para style="q1" vid="ISA 34:7">Be tɛɛle gyae ke nyɔɔ fatabo baa,</para>
  <para style="q2" vid="ISA 34:7">na nuŋ ke wuu ba aŋasa pou dɔɔ.<verse eid="ISA 34:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 34:8" />Nawolo nyi Degbeŋgyoo dana wee keŋ waa wɔŋ deŋele tɔ kom,</para>
  <para style="q2" vid="ISA 34:8">na kulutoo keŋ waa di lɛɛ Siyɔn.<verse eid="ISA 34:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 34:9" />Edom boŋobiise gyae ka bese aŋɔɔ,</para>
  <para style="q2" vid="ISA 34:9">wa aŋasa gyae ka bese kpatakpela,</para>
  <para style="q2" vid="ISA 34:9">ɔ tɛɛle gyae ka bese tɛɛle keŋ ne kpaa.<verse eid="ISA 34:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 34:10" />Ka be gyae ka yeŋ nelim yaa ka weese ya,</para>
  <para style="q2" vid="ISA 34:10">ke nyɔɔse gyae ka koro kekpaakekpaa,</para>
  <para style="q1" vid="ISA 34:10">ke gyae ke doo yakaa lee kalola kegyakaare dɔɔ kelii kalola kegyakaare dɔɔ,</para>
  <para style="q2" vid="ISA 34:10">ŋolo na ŋolo be lam botɔɔ bela ya.<verse eid="ISA 34:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 34:11" />Ke gyae ka bese kekperekperese na samse dekyae,</para>
  <para style="q2" vid="ISA 34:11">kpilimse na awuluŋna baa loo ba asaase botɔɔ,</para>
  <para style="q1" vid="ISA 34:11">Wurubuarɛ waa wɔŋ ɔ kemaa ŋmeleŋ,</para>
  <para style="q2" vid="ISA 34:11">keŋ gyae ka mo kekolosi do be man nɛ,</para>
  <para style="q2" vid="ISA 34:11">do Edom dɔɔ na ka ke doo yakaa.<verse eid="ISA 34:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 34:12" />Ɔ gyoorobia be dana kpene keŋ baa baake nyi gyooridedii botɔɔ ya,</para>
  <para style="q2" vid="ISA 34:12">ɔ gyoobia pou baa ŋaalaa botɔɔ.<verse eid="ISA 34:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 34:13" />Sɔɔse gyae ke lɛɛ ɔ gyooro deeyeu e kayo,</para>
  <para style="q2" vid="ISA 34:13">koŋkolisɔɔse na kpeeligelase gyae ke lɛɛ ɔ dekagyase</para>
  <para style="q1" vid="ISA 34:13">Ke gyae ka bese gbougbouse,</para>
  <para style="q2" vid="ISA 34:13">na kpilimse dekyae.<verse eid="ISA 34:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 34:14" />Kefula man wonembia na mokɔɔte baa gyaŋee botɔɔ,</para>
  <para style="q2" vid="ISA 34:14">na laaman asoose ke wii baake dɔŋa,</para>
  <para style="q1" vid="ISA 34:14">nelim wonembia baa doo botɔɔ,</para>
  <para style="q2" vid="ISA 34:14">na baa nyiŋ defɛɛfoe.<verse eid="ISA 34:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 34:15" />Kpilim waa loo desaa botɔɔ na waa do wɔɔ,</para>
  <para style="q2" vid="ISA 34:15">waa kpala na waa kɛɛle wɔ,</para>
  <para style="q2" vid="ISA 34:15">ɔ beŋkelɛɛ wuluŋ tɛɛ,</para>
  <para style="q" vid="ISA 34:15">bapɛtɛɛna mɔ baa yilaa botɔɔ,</para>
  <para style="q2" vid="ISA 34:15">ɔkamasɛ na ɔ balate.<verse eid="ISA 34:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 34:16" />Ɛ kɛo Degbeŋgyoo tɔne keŋ man na ɛ ke kala,</para>
  <para style="q1" vid="ISA 34:16">ŋe man dokoloŋ be gyae ka yo ya,</para>
  <para style="q2" vid="ISA 34:16">be man ŋolo ɔ balate be gyae waa yo ya.</para>
  <para style="q1" vid="ISA 34:16">Nawolo nyi Degbeŋgyoo gyuusuna ɔ nɔɔ yako,</para>
  <para style="q2" vid="ISA 34:16">te ɔ feliŋ gyae ke yilaa wɔ debodokoloŋ.<verse eid="ISA 34:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 34:17" />Ŋon kpalana be dedii fa wɔ,</para>
  <para style="q2" vid="ISA 34:17">ɔ nyiŋmaa te ɔ moowɔ maa fa wɔ.</para>
  <para style="q1" vid="ISA 34:17">Baa mo ke bese be wui kekpaakekpaa,</para>
  <para style="q2" vid="ISA 34:17">na baa kyaa botɔɔ lee kalola kegyakaare dɔɔ kelii kalola kegyakaare dɔɔ.<verse eid="ISA 34:17" /></para>
  <chapter eid="ISA 34" />
  <chapter number="35" style="c" sid="ISA 35" />
  <para style="s1">Baŋ bɔɔ lɛɛ wɔ kenyaŋee</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 35:1" />Depampaa na tɛɛle dowolo baa di gyoŋ,</para>
  <para style="q2" vid="ISA 35:1">depampaa gyae ke nyaŋee na ka potee,</para>
  <para style="q1" vid="ISA 35:1">ŋgba dekpaotɛɛ kyeŋkyeŋkɔɔse nɛ, <verse eid="ISA 35:1" /><verse number="2" style="v" sid="ISA 35:2" />ke gyae ka lese kyeŋkyeŋkɔɔse,</para>
  <para style="q2" vid="ISA 35:2">ke gyae ke nyaŋee nideli na ke fae yeesa nyaŋee,</para>
  <para style="q1" vid="ISA 35:2">baa mo Lebanɔn gyoorobiiri fa e,</para>
  <para style="q2" vid="ISA 35:2">Kamɛle na Saron kyeo fa e,</para>
  <para style="q1" vid="ISA 35:2">baa naa Degbeŋgyoo gyoorobiiri,</para>
  <para style="q2" vid="ISA 35:2">na de Wurubuarɛ doŋ.<verse eid="ISA 35:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 35:3" />Ɛ do nyiŋmaase ŋan be yɔkɔse nɛ doŋ,</para>
  <para style="q2" vid="ISA 35:3">ɛ do doona ŋan ne seree nɛ doŋ,<verse eid="ISA 35:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 35:4" />Ɛ yako baŋ be wɔe ne lɔ wɔ nɛ nyiaa,</para>
  <para style="q2" vid="ISA 35:4">&lt;&lt;Ɛ seŋ keŋkeŋ, ɛ na yee ya,</para>
  <para style="q1" vid="ISA 35:4">ɛ Wurubuarɛ waa kɔŋ,</para>
  <para style="q2" vid="ISA 35:4">waa mo deŋele kewɔŋ kɔŋ,</para>
  <para style="q1" vid="ISA 35:4">kpuna ka komketɔ,</para>
  <para style="q2" vid="ISA 35:4">waa kɔŋ kaa lɛɛ ɛ nyee.<verse eid="ISA 35:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 35:5" />Kenaŋ na siayɛlɛɛsatena sia gyae ke gyuusu,</para>
  <para style="q2" vid="ISA 35:5">na deŋela atɔɔsatena deŋela ke nyii.<verse eid="ISA 35:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 35:6" />Botɔɔ te ɔtakasese baa toŋee ŋgba ŋaase nɛ,</para>
  <para style="q2" vid="ISA 35:6">na omumuuse laakem ke fae yeesa nyaŋee.</para>
  <para style="q1" vid="ISA 35:6">Loŋ gyae ke puu lee depampaa man,</para>
  <para style="q2" vid="ISA 35:6">na boŋobiise ka toro depampaa man.<verse eid="ISA 35:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 35:7" />Aŋasa ŋan ne kpaa gyae ka bese depaa,</para>
  <para style="q2" vid="ISA 35:7">na boŋobiise ke puu lee tɛɛle dowolo man,</para>
  <para style="q1" vid="ISA 35:7">botɔɔ keŋ nafɔ yɛɛ gbougbouse dedoi nɛ,</para>
  <para style="q2" vid="ISA 35:7">ŋalese na moro na apoŋfase gyae ke tu botɔɔ.<verse eid="ISA 35:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 35:8" />Gbɛɛ dinaa gyae ke doo botɔɔ,</para>
  <para style="q2" vid="ISA 35:8">baa baake ke nyi gbɛɛ fereŋkyeŋ,</para>
  <para style="q2" vid="ISA 35:8">ke gyae ke doo fa baŋ bɛɛ ta mena gbɛɛ kenaŋ nɛ,</para>
  <para style="q1" vid="ISA 35:8">baŋ ba wose dana ayimɛɛ be gyae baa ta ke dɔɔ ya,</para>
  <para style="q2" vid="ISA 35:8">ayiŋtena koraŋ be gyae baa yo ke dɔɔ ya.<verse eid="ISA 35:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 35:9" />Dinaate be gyae waa kyaa botɔɔ,</para>
  <para style="q2" vid="ISA 35:9">yaa wonembukum ŋolo ke kyaa botɔɔ ya,</para>
  <para style="q2" vid="ISA 35:9">bɔɔ gyae baa naa wɔ botɔɔ ya.</para>
  <para style="q1" vid="ISA 35:9">Mɔna baŋ bɔɔ lɛɛ wɔ baageŋ ne gyaela baa ta botɔɔ.<verse eid="ISA 35:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="ISA 35:10" />Baŋ Degbeŋgyoo be lɛɛ wɔ baa bese kɔŋ.</para>
  <para style="q1" vid="ISA 35:10">Baa mo nɔɔneŋ kekpee gyoo Siyɔn,</para>
  <para style="q2" vid="ISA 35:10">baa mo kenyaŋee kekpaakekpaa kotɔtɔɔ wuu ba nyeeya,</para>
  <para style="q1" vid="ISA 35:10">baa di gyoŋ na baa nyaŋee nideli,</para>
  <para style="q2" vid="ISA 35:10">baa wolee waraŋase kedi na kemutii.<verse eid="ISA 35:10" /></para>
  <chapter eid="ISA 35" />
  <chapter number="36" style="c" sid="ISA 36" />
  <para style="s1">Sanehɛribe keŋmaase Yerusalɛm</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 36:1" />Gyoo Hesekiya kedi gyoori kulutooneŋ kufu anaarate man nɛ, Asiriya gyoo Saneheribe ke yoo Yuda donɔɔse dinaana ŋan bɔɔ baŋ akyaŋse kilisi ŋa pou, te ɔ dii be dɔɔ. <verse eid="ISA 36:1" /><verse number="2" style="v" sid="ISA 36:2" />Keŋte Asiriya gyoo kpila ɔ yoonɔɔtena kegyia na yoonɔɔtena burum lee Lakisi gyu gyoo Hesekiya gyaŋ Yerusalɛm. Be kelii Yerusalɛm nɛ be ka seŋawɔ adogbɛɛ depaa keŋ doo gyu botɔɔ keŋ bɛɛ faafo abɔɔ nɛ. <verse eid="ISA 36:2" /><verse number="3" style="v" sid="ISA 36:3" />Keŋte Hilikiya bu Eliyakim ŋon ɔ ne kɛɛ gyooro dekpaŋalaŋ keŋ dɔɔ na be tɔne ŋmarasere Sɛbena na Asafe bu Yoa ŋon ɔ ne kyaŋ be nɔɔwoya see nɛ leewɔ gyu ɔ gyaŋ.<verse eid="ISA 36:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 36:4" />Keŋte yoonɔɔtena kegyia ŋon yako wɔ nyiaa, &lt;&lt;Ɛ yako Hesekiya nyiaa,</para>
  <para style="pm" vid="ISA 36:4">&lt;&lt;&lt;Nnɛ yaa Asiriya gyoo dinaa ŋon ne yako, woŋ kitii dɔɔ yaa n na mo n wose lɔ? <verse eid="ISA 36:4" /><verse number="5" style="v" sid="ISA 36:5" />N gyeŋ nyi nɔɔwoya yakaa yɛna yoo abɔɔ ŋan bɛɛ mo gyu yoo? Amɔte dɔɔ yaa n na mo n loo gyakaa te n na koro seŋ tia maŋ? <verse eid="ISA 36:5" /><verse number="6" style="v" sid="ISA 36:6" />Kɛɛ, ma gyeŋ nyi n na mo n wose lɔ Igyipite, moro keŋ be tekeri nɛ, keŋ ŋon ɔ teelina ke na gyae ke sɔɔ e ɔ nyiŋmaa nɛ dɔɔ! Mena te Igyipite gyoo Faaro doo fa baŋ bɛɛ mo be loo gyakaa ɔ dɔɔ nɛ. <verse eid="ISA 36:6" /><verse number="7" style="v" sid="ISA 36:7" />Mɔna akpaa ɛ yako maŋ nyi, &lt;&lt;Dɛɛ mo da wose lɔ Degbeŋgyoo de Wurubuarɛ dɔɔ&gt;&gt; nɛ, na bulasebia na ɔ kedeesaboya te gyoo Hesekiya wɔlɛɛwɔ te ɔ yako Yuda na Yerusalɛm nyiaa, &lt;&lt;Kedeesaboe kei siaman te kaboena nyi yaa som yee&gt;&gt;?<verse eid="ISA 36:7" /></para>
  <para style="pm">
    <verse number="8" style="v" sid="ISA 36:8" />&lt;&lt;&lt;Nɛnɛɛ kɔŋ na ɛmɛɛna me gbeŋgyoo Asiriya gyoo ke kolosi sɛɛ dɔŋa, nyi akpaa n ke nyiŋ baŋ baa tale kyaa dɛɛkyɔŋse na, maa fa neŋ dɛɛkyɔŋse kakpoŋse ala. <verse eid="ISA 36:8" /><verse number="9" style="v" sid="ISA 36:9" />Doo nyi n ta mo n wose lɔ Igyipite yookɔtase na dɛɛkyɔŋ kyaara dɔɔ, mɔna sena yaa n ke tale di me gbeŋgyoo yoonɔɔte ŋon ɔ be dana doŋ koraŋ ya nɛ dɔɔ? <verse eid="ISA 36:9" /><verse number="10" style="v" sid="ISA 36:10" />Agyakaŋ na, me kɔŋae me kaa yoo wɔlɛɛ donɔɔ kei keŋ Degbeŋgyoo be kpuɛ yee? Degbeŋgyoo gbagba yakona maŋ nyi, &lt;Gyu keyoo tɛɛle kei na n ke wɔlɛɛ ke.&gt;&gt;&gt;<verse eid="ISA 36:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 36:11" />Keŋte Eliyakim na Sɛbena na Yoa yako yoonɔɔtena kegyia ŋon nyiaa, &lt;&lt;Waaseda kolosi fa n tewulɛɛ Aram dei man nawolo nyi dee nyii ke. Naa kolosi fa daa Hiburu dei man, na baŋ be kyaa dekyaŋ keŋ dɔɔ nɛ kenyii ya.&gt;&gt;<verse eid="ISA 36:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 36:12" />Mɔna yoonɔɔtena kegyia ŋon tiranɔɔ fa wɔ nyiaa, &lt;&lt;Ɛmɛɛ na ɛ gbeŋgyoo yaageŋ gyaŋ yaa me gbeŋgyoo kpila maŋ nyi me kaa yako nombia kɛŋa fa? Balaŋ baŋ be kyaa dekyaŋ keŋ dɔɔ, keŋ baa kaa di baŋ gbagba pena na baa nyɔɔ ba foŋfoŋ ŋgba ɛmɛɛ nɛ be kpuɛ yee?&gt;&gt;<verse eid="ISA 36:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 36:13" />Keŋte yoonɔɔtena kegyia ŋon korowɔ seŋ te ɔ gyinaa ɔ woya kolosi Hiburu dei man nyiaa, &lt;&lt;Ɛ nyii gyoo dinaa ŋon nombia, Asiriya gyoo ŋon! <verse eid="ISA 36:13" /><verse number="14" style="v" sid="ISA 36:14" />Gyoo ŋon kpa nyiaa, ɛ naa yele Hesekiya ka beo ŋon ya. Ɔ be gyae waa tale lɛɛ ŋon ya! <verse eid="ISA 36:14" /><verse number="15" style="v" sid="ISA 36:15" />Ɛ naa yele Hesekiya ka beo ŋon nyi yaa mo ɛ wose lɔ Degbeŋgyoo dɔɔ, debaŋ keŋ ɔ be yako nyi, &lt;Kelɛɛ te Degbeŋgyoo waa lɛɛ daa, ɔ be gyae waa mo donɔɔ dinaa kei do Asiriya gyoo nyiŋmaa man ya.&gt;<verse eid="ISA 36:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 36:16" />&lt;&lt;Ɛ naa tei Hesekiya ya. Asiriya gyoo kpa nyiaa, ɛ yela dee kolosi wosefɛɛreŋ nombia na ɛ ka lee kɔŋ me gyaŋ. Kenaŋ na ɛ man ɔkamasɛ waa di ŋon gbagba waa abɔɔbia lee ke woŋ man, na fiigi daŋ man na waa nyɔɔ ŋon gbagba detiribuŋ man loŋ. <verse eid="ISA 36:16" /><verse number="17" style="v" sid="ISA 36:17" />Kelii debaŋ keŋ maa kɔŋ kaa mo ŋon gyu tɛɛle keŋ ke yɛɛ ŋgba ɛmɛɛ gbagba wui nɛ man. Tɛɛle keŋ wamela na waen wɔle kyaa, tɛɛle keŋ weenɛɛ na gerepo wɔɔse kyaa nɛ.<verse eid="ISA 36:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 36:18" />Ɛ naa yele Hesekiya ka beo ŋon nyiaa, &lt;Degbeŋgyoo waa lese daa&gt; ya. Tɛɛlese ŋaale kyaa keŋ be wurubuarɛse be tale lɛɛ be tɛɛlese lee Asiriya gyoo nyiŋmaa man? <verse eid="ISA 36:18" /><verse number="19" style="v" sid="ISA 36:19" />Hamate na Arepade wurubuarɛse kyaa aleŋ? Sefarewayim wurubuarɛse kyaa aleŋ? Be talewɔ lɛɛ Samariya lee me nyiŋmaa man? <verse eid="ISA 36:19" /><verse number="20" style="v" sid="ISA 36:20" />Donɔɔse kɛŋa pou man woŋti wurubuarɛse talela lɛɛ be tɛɛlese lee me nyiŋmaa man? Nɛnɛɛ sena te Degbeŋgyoo waa tale lɛɛ Yerusalɛm lee me nyiŋmaa man?&gt;&gt;<verse eid="ISA 36:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 36:21" />Mɔna balaŋ baŋ pou wuu be nɔɔse keŋ ba te yako kolo ya, nawolo nyi gyoo faree wɔ nyiaa, &lt;&lt;Ɛ naa tiranɔɔ fa e ya.&gt;&gt;<verse eid="ISA 36:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 36:22" />Keŋte Hilikiya bu Eliyakim ŋon ɔ ne kɛɛ gyooro dekpaŋalaŋ dɔɔ na be tɔne ŋmarasere Sɛbena na Asafe bu Yoa ŋon ɔ ne kyaŋ be nɔɔwoya see nɛ kyaŋa ba kegbase tirii te be gyuuwɔ Hesekiya gyaŋ ke yako e ŋan yoonɔɔtena kegyia ŋon be yako.<verse eid="ISA 36:22" /></para>
  <chapter eid="ISA 36" />
  <chapter number="37" style="c" sid="ISA 37" />
  <para style="s1">Ba ke yako nyi baa kaa lɛɛ Yerusalɛm</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 37:1" />Gyoo Hesekiya kenyii nombia kɛŋa nɛ, ɔ tirii ɔ kegbase te ɔ moo titere wuu te ɔ gyuuwɔ Degbeŋgyoo ɔsom deni dinaa keŋ man. <verse eid="ISA 37:1" /><verse number="2" style="v" sid="ISA 37:2" />Keŋte ɔ kpila Eliyakim ŋon ɔ ne kɛɛ gyoo dekpaŋalaŋ dɔɔ na be tɔne ŋmarasere Sɛbena na saese kegyiise, gyu Amose bu Wurubuarɛ gbalare Yesaya gyaŋ na be popou doona titere kegbase. <verse eid="ISA 37:2" /><verse number="3" style="v" sid="ISA 37:3" />Te be yako e nyiaa, &lt;&lt;Hesekiya kpa, Gyɛŋ wee kei yɛɛ wosekekyaŋ na kekalana na desɛŋ kado wee ke, ŋgba mena keŋ woo da do nyee te doŋ be doo baa lola e ya nɛ. <verse eid="ISA 37:3" /><verse number="4" style="v" sid="ISA 37:4" />Mberem na Degbeŋgyoo n Wurubuarɛ waa nyii nɔɔwoya ŋan yoonɔɔtena kegyia ŋon ɔ gbeŋgyoo Asiriya gyoo be kpili nyi waa mo tee Wurubuarɛ ŋon ɔ kyaa nɛ, na waa kalana e lee nɔɔwoya ŋan Degbeŋgyoo n Wurubuarɛ be nyii nɛ dɔɔ. Mena dɔɔ fane fa balaŋ baŋ bɔɔ kaa nɛ.&gt;&gt;<verse eid="ISA 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 37:5" />Gyoo Hesekiya kyalabia kekɔŋ Yesaya gyaŋ nɛ, <verse eid="ISA 37:5" /><verse number="6" style="v" sid="ISA 37:6" />Yesaya yako wɔ nyiaa, &lt;&lt;Ɛ yako ɛ gbeŋgyoo nyi, &lt;Nnɛ yaa Degbeŋgyoo ne yako: Ɛ naa yee nɔɔwoya ŋan ɛ be nyii keŋ Asiriya gyoo tewulɛɛ ba mo fulu maŋ nɛ ya. <verse eid="ISA 37:6" /><verse number="7" style="v" sid="ISA 37:7" />Ɛ tei maŋ! Maa mo feliŋ daale do ɔ maŋ na waa nyii nombia ŋaale keŋ gyae ke yela waa bese gyu ɔ donɔɔ man. Maa yela baa mo yoosila ko e botɔɔ.&gt;&gt;&gt;<verse eid="ISA 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 37:8" />Yoonɔɔtena kegyia ŋon kenyii nyi Asiriya gyoo ta lee Lakisi nɛ, ɔ besewɔ te ɔ ke naa gyoo ŋon ne yoona Libena.<verse eid="ISA 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 37:9" />Saneheribe nyiiwɔ nyi Kuse gyoo Tirehaka <note caller="+" style="fe"><char style="fr" closed="false">37:9 </char><char style="ft" closed="false">Naele ado gbɛɛ</char></note> ne kɔŋ ɔ kaa yoo e. Ɔ kenyii mena nɛ ɔ kpila balaŋ nyi baa gyu ke yako Hesekiya nyiaa, <verse eid="ISA 37:9" /><verse number="10" style="v" sid="ISA 37:10" />&lt;&lt;Yako Yuda gyoo Hesekiya nyiaa, Na yele wurubuarɛ ŋon n na mo n wose lɔ ɔ dɔɔ nɛ ka beo neŋ nyi &lt;bɔɔ gyae baa mo Yerusalɛm do Asiriya gyoo nyiŋmaa man ya.&gt; <verse eid="ISA 37:10" /><verse number="11" style="v" sid="ISA 37:11" />Kɛɛ, n nyii mena keŋ Asiriya gyooneŋ be yɛɛ tɛɛlese ŋan, be wɔlɛɛ ŋe popou kerekere. Te nyaŋ n ke nyiŋ kelɛɛ? <verse eid="ISA 37:11" /><verse number="12" style="v" sid="ISA 37:12" />Gosan na Haran na Rɛsɛfe tɛɛlese na Ɛdentena baŋ be kyaa Telasɛre keŋ me naanaɔ be wɔlɛɛwɔ nɛ, be wurubuarɛse talewɔ lɛɛ wɔ? <verse eid="ISA 37:12" /><verse number="13" style="v" sid="ISA 37:13" />Hamate gyoo yaa Arepade gyoo kyaa aleŋ? Layire na Sefarewayim na Hena na Iwa gyooneŋ kyaa aleŋ?<verse eid="ISA 37:13" /></para>
  <para style="s1">Hesekiya kefane</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 37:14" />Hesekiya lɛɛ tɔne keŋ lee kpilara baŋ nyiŋmaa man te ɔ kala ke. Keŋte ɔ gyuuwɔ Degbeŋgyoo ɔsom deni dinaa keŋ man te ɔ fɛlɛɛ ke lɔ Degbeŋgyoo siaman. <verse eid="ISA 37:14" /><verse number="15" style="v" sid="ISA 37:15" />Te Hesekiya fanewɔ fa Degbeŋgyoo nyiaa, <verse eid="ISA 37:15" /><verse number="16" style="v" sid="ISA 37:16" />&lt;&lt;Oo Degbeŋgyoo Dekpataakpere, Iserae Wurubuarɛ ŋon n kyaa Kerubise dɔɔ, nyaageŋ yɛna Wurubuarɛ tɛɛle kei gyooridediise pou dɔɔ. Nyaŋ yɛɛna adido na tɛɛle. <verse eid="ISA 37:16" /><verse number="17" style="v" sid="ISA 37:17" />Ao Degbeŋgyoo, see deŋele na n ke nyii, Degbeŋgyoo, gyuusu n sia na ke kɛɛ. Tei nombia ŋan pou Saneheribe ba mo yelee nyi waa mo kulu Wurubuarɛ ŋon ɔ kyaa kekpaakekpaa nɛ.<verse eid="ISA 37:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 37:18" />&lt;&lt;Ao Degbeŋgyoo, ke yɛɛ ampaŋ nyi Asiriya gyooneŋ wɔlɛɛ balaŋ kɛwɔ na be tɛɛle pou. <verse eid="ISA 37:18" /><verse number="19" style="v" sid="ISA 37:19" />Be fuŋa be wurubuarɛse do boalaŋ man te be wɔlɛɛ wɔ, nawolo nyi ba te yɛɛ wurubuarɛse ya mɔna be yɛɛ daase na boya ŋan denibalaŋ ba mo be nyiŋmaase yɛɛ. <verse eid="ISA 37:19" /><verse number="20" style="v" sid="ISA 37:20" />Nɛnɛɛ Degbeŋgyoo de Wurubuarɛ, lɛɛ daa lee ɔ nyiŋmaa man, na tɛɛle kei gyooridediise pou ka gyeŋ nyi nyaŋ Degbeŋgyoo nyaageŋ yɛna Wurubuarɛ.<verse eid="ISA 37:20" /></para>
  <para style="s1">Saneheribe keyala</para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 37:21" />Keŋte Amose bu Yesaya kpilawɔ gyu Hesekiya gyaŋ nyiaa, &lt;&lt;Nnɛ ya Degbeŋgyoo, Iserae Wurubuarɛ ne yako, &lt;&lt;Keŋ n be fane fa maŋ lee Asiriya gyoo Saneheribe wose man dɔɔ, <verse eid="ISA 37:21" /><verse number="22" style="v" sid="ISA 37:22" />kei yɛna nombii keŋ Degbeŋgyoo be kolosi tia e,</para>
  <para style="q1" vid="ISA 37:22">&lt;&lt;Siyɔn alebu keteŋ,</para>
  <para style="q2" vid="ISA 37:22">na mo n sia tiu tɛɛle na ɔ na boŋo neŋ,</para>
  <para style="q1" vid="ISA 37:22">Yerusalɛm bu alebu</para>
  <para style="q2" vid="ISA 37:22">ne kpiisi ɔ nyee n wɔle kulu neŋ.<verse eid="ISA 37:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 37:23" />Amɔte yaa n teewɔ te n fuluwɔ?</para>
  <para style="q2" vid="ISA 37:23">Amɔte dɔɔ yaa n gyinaa n woya tia,</para>
  <para style="q1" vid="ISA 37:23">te n gyinaa n siabia adido wose kegate man?</para>
  <para style="q2" vid="ISA 37:23">Tia maŋ Iserae fereŋkyeŋte ŋon!<verse eid="ISA 37:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 37:24" />N tɛɛwɔ n tewulɛɛ dɔɔ,</para>
  <para style="q2" vid="ISA 37:24">kulu Degbeŋgyoo,</para>
  <para style="q1" vid="ISA 37:24">te n yakowɔ nyiaa,</para>
  <para style="q2" vid="ISA 37:24">&lt;Maa mo ma anebiliŋiŋse burum,</para>
  <para style="q1" vid="ISA 37:24">Me ta gyem gyu bulase nyeeman,</para>
  <para style="q2" vid="ISA 37:24">Lebanɔn bula dɔɔloŋte nyeeman</para>
  <para style="q1" vid="ISA 37:24">ma te kɛrɛɛ sida daase dɔɔloŋ nyiŋan,</para>
  <para style="q2" vid="ISA 37:24">na kateenaa daase kpaakpaa nyiŋan,</para>
  <para style="q1" vid="ISA 37:24">me te lii ka nyeeman adido adido,</para>
  <para style="q2" vid="ISA 37:24">ke laa kpaakpaa keŋ man.<verse eid="ISA 37:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 37:25" />Me wula atiribuŋse tɛɛlese wɔlɛɛ man,</para>
  <para style="q2" vid="ISA 37:25">te me nyɔɔ ŋe man loŋ,</para>
  <para style="q1" vid="ISA 37:25">ma moo me nawɔɔtale,</para>
  <para style="q2" vid="ISA 37:25">yela Igyipite boŋobiise pou yoowɔ.<verse eid="ISA 37:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="ISA 37:26" />N te nyiita see yee?</para>
  <para style="q2" vid="ISA 37:26">Me wulaa yɛɛ ke lee beneŋ beneŋ,</para>
  <para style="q1" vid="ISA 37:26">Lee gyaŋgba gyaŋgba te me bake ke,</para>
  <para style="q2" vid="ISA 37:26">nɛnɛɛ te me yelaa ke kɔŋawɔ mena,</para>
  <para style="q1" vid="ISA 37:26">nyi n te yele donɔɔse ŋan bɔɔ baŋ akyaŋse kilisi ŋa nɛ</para>
  <para style="q2" vid="ISA 37:26">ta bese boya ŋan bɔɔ yilaa see.<verse eid="ISA 37:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 37:27" />Ke man balaŋ doŋ te taŋ,</para>
  <para style="q2" vid="ISA 37:27">ba wose te gbirisi wɔ te desɛŋ kyaŋa wɔ.</para>
  <para style="q1" vid="ISA 37:27">Be yɛɛ ŋgba ŋale man apoŋfase nɛ,</para>
  <para style="q2" vid="ISA 37:27">ŋgba ŋalese wɔlɛɛ ŋan ŋɔɔ potee nɛ,</para>
  <para style="q1" vid="ISA 37:27">ŋgba ŋalese na potee deni nyeedɔɔ,</para>
  <para style="q2" vid="ISA 37:27">na weese te nyakee ŋa nɛ.<verse eid="ISA 37:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="ISA 37:28" />&lt;&lt;Mɔna ma gyeŋ n kekyaabii man,</para>
  <para style="q2" vid="ISA 37:28">na n kee gyu na n kɛɛ kɔŋ,</para>
  <para style="q2" vid="ISA 37:28">na mena keŋ n ba koro seŋ tia maŋ.<verse eid="ISA 37:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 37:29" />Keŋ n ba koro seŋ tia maŋ,</para>
  <para style="q2" vid="ISA 37:29">na keŋ n wose kegate be lii ma deŋela man dɔɔ,</para>
  <para style="q1" vid="ISA 37:29">maa mo me darawaa do n memɔɔ man,</para>
  <para style="q2" vid="ISA 37:29">na maa mo me kɔla do n nɔɔ dokɔŋ,</para>
  <para style="q1" vid="ISA 37:29">na maa yela n ka bese</para>
  <para style="q2" vid="ISA 37:29">mo gbɛɛ keŋ n ba mo kɔŋ nɛ ta.&gt;<verse eid="ISA 37:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ISA 37:30" />&lt;&lt;Hesekiya, kei gyae ke yɛɛ kagyene fa neŋ,</para>
  <para style="q1" vid="ISA 37:30">&lt;&lt;Kulutoo kei ɛ ke di weenɛɛ ŋan be tuu ŋa wose dɔɔ,</para>
  <para style="q2" vid="ISA 37:30">kulutooneŋ alate man na ɛ ke di duwulu man weenɛɛ.</para>
  <para style="q1" vid="ISA 37:30">Mɔna kulutoo atoorote man na ɛ duu na ɛ ke kɔ,</para>
  <para style="q2" vid="ISA 37:30">ɛ fara gerepo wɔɔse na ɛ ke di ŋe bia.<verse eid="ISA 37:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 37:31" />Baŋ bɔɔ kaa Yuda tɛɛle man nɛ,</para>
  <para style="q2" vid="ISA 37:31">baa baŋ lila na baa se bia.<verse eid="ISA 37:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 37:32" />Balaŋ akaŋ baŋ baa lee Yerusalɛm,</para>
  <para style="q2" vid="ISA 37:32">na baŋ bɔɔ nyiŋ nyeedoŋ nɛ ka lee Siyɔn bula dɔɔ.</para>
  <para style="q1" vid="ISA 37:32">Degbeŋgyoo Dekpataakpere ŋon kegyae nideli,</para>
  <para style="q2" vid="ISA 37:32">gyae ke yɛɛ kei.<verse eid="ISA 37:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ISA 37:33" />Mena dɔɔ nnɛ yaa Degbeŋgyoo ne yako lee Asiriya gyoo wose man,</para>
  <para style="q1" vid="ISA 37:33">&lt;&lt;Ɔ be gyae waa gyoo donɔɔ dinaa kei man,</para>
  <para style="q2" vid="ISA 37:33">yaa waa tɔ baŋdaŋ kɛbo ya.</para>
  <para style="q1" vid="ISA 37:33">Ɔ be gyae waa mo nyeele pampasaŋ kɔŋ ke gyaŋ,</para>
  <para style="q2" vid="ISA 37:33">yaa waa tɔ wɔ do ya.<verse eid="ISA 37:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="ISA 37:34" />Gbɛɛ keŋ dɔɔ ɔ ba mo kɔŋ nɛ te waa bese mo ta,</para>
  <para style="q2" vid="ISA 37:34">ɔ be gyae waa gyoo donɔɔ dinaa kei man ya,&gt;&gt;</para>
  <para style="q4" vid="ISA 37:34">Degbeŋgyoo torola yako.<verse eid="ISA 37:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ISA 37:35" />&lt;&lt;Maa seŋ donɔɔ dinaa kei wɔle na maa lɛɛ ke,</para>
  <para style="q2" vid="ISA 37:35">lee daa na me tobaale Dawide dɔɔ!&gt;&gt;<verse eid="ISA 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ISA 37:36" />Keŋte Degbeŋgyoo kpilare ŋon leewɔ gyu ka koe balaŋ kakpoŋse sɔŋogyanaara na anoŋ (185,000) lee Asiriyatena baŋ deyilae kyaa man. Tɛɛ kena nebo ba kefoŋii nɛ, na woya baŋ dokiilaa. <verse eid="ISA 37:36" /><verse number="37" style="v" sid="ISA 37:37" />Mena dɔɔ Asiriya gyoo Saneheribe leewɔ be deyilae kyaa keŋ man. Ɔ besewɔ gyu Niniwe te ɔ ke kyaawɔ botɔɔ.<verse eid="ISA 37:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ISA 37:38" />Wee dokoloŋ ɔ kekyaa ɔ wurubuarɛ Niseroke deni man ɔ na som nɛ, ɔ bia tewulɛɛ bala Aderamɛlɛke na Sarɛsɛle moo yoosila kaa ko e, te be yeuwɔ gyu Ararate tɛɛle man. Te ɔ bu Esaradon kaa dii gyoori ɔ nawɔɔ man.<verse eid="ISA 37:38" /></para>
  <chapter eid="ISA 37" />
  <chapter number="38" style="c" sid="ISA 38" />
  <para style="s1">Hesekiya kawee</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 38:1" />Weeya ŋenaŋ man kawee gyɔɔ Hesekiya keŋ na ɔ ta yem taŋ. Keŋte Amose bu Wurubuarɛ gbalare Yesaya gyuuwɔ ke yako e nyiaa, &lt;&lt;Degbeŋgyoo kpa, desina n wɔle see nawolo nyi nyaŋ ka yeŋ. N be gyae n ka koro ya.&gt;&gt; <verse eid="ISA 38:1" /><verse number="2" style="v" sid="ISA 38:2" />Keŋte Hesekiya besena ɔ sia tee deni te ɔ fanewɔ fa Degbeŋgyoo nyiaa, <verse eid="ISA 38:2" /><verse number="3" style="v" sid="ISA 38:3" />&lt;&lt;Ao Degbeŋgyoo, tɔɔse mena keŋ mɔɔ mo me konɔɔ pou ta n siaman anokoare man, na mena keŋ mɔɔ yɛɛ nombia kpaakpaa n siaman.&gt;&gt; Keŋte Hesekiya wiiwɔ nideli. <verse eid="ISA 38:3" /><verse number="4" style="v" sid="ISA 38:4" />Keŋte Degbeŋgyoo yako Yesaya nyiaa, <verse eid="ISA 38:4" /><verse number="5" style="v" sid="ISA 38:5" />&lt;&lt;Gyu ke yako Hesekiya nyiaa, &lt;Nnɛ yaa Degbeŋgyoo n kya Dawide Wurubuarɛ ŋon ne yako, me te nyii n kefane te me naa n siasaraŋ. Maa mo kulutooneŋ kufu anoŋ (15) kpu n weeya man. <verse eid="ISA 38:5" /><verse number="6" style="v" sid="ISA 38:6" />Te maa lɛɛ ɛmɛɛ na donɔɔ dinaa kei lee Asiriya gyoo nyiŋmaa man. Maa gyee donɔɔ dinaa kei.<verse eid="ISA 38:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 38:7" />&lt;&lt;Kei yɛna kagyene lee Degbeŋgyoo gyaŋ nyi waa yɛɛ kpene keŋ ɔ be yakosee nɛ. <verse eid="ISA 38:7" /><verse number="8" style="v" sid="ISA 38:8" />Maa yela weese wɔŋtaa ka bese gyu ke wɔle Ahase ɔgyeŋdɔɔ gbɛɛ keŋ man nae kekulu kufu.&gt;&gt;&gt;Mena dɔɔ weese wɔŋtaa keŋ besewɔ kɔŋ wɔle nae kekulu kufu.<verse eid="ISA 38:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 38:9" />Keŋ Yuda gyoo Hesekiya be ŋmarase lee ɔ kawee na ɔ kawee koro wɔle yaa.<verse eid="ISA 38:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 38:10" />Me yakowɔ nyiaa, &lt;&lt;Me tobiiritɛɛ man na</para>
  <para style="q2" vid="ISA 38:10">maa moona yeŋ denaanɔɔ man,</para>
  <para style="q2" vid="ISA 38:10">na baa lɛo ma weeya akaŋ?&gt;&gt;<verse eid="ISA 38:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 38:11" />Ma besewɔ yako nyiaa, &lt;&lt;Mɔɔ gyae maa naa Degbeŋgyoo gbagba,</para>
  <para style="q2" vid="ISA 38:11">baŋ be kyaa tɛɛle kei dɔɔ nɛ man bela ya,</para>
  <para style="q1" vid="ISA 38:11">mɔɔ gyae maa naa balaŋ bela,</para>
  <para style="q2" vid="ISA 38:11">yaa maa kyaana baŋ be kyaa tɛɛle kei dɔɔ nɛ ya.<verse eid="ISA 38:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 38:12" />Ba te tekerii me deni lɔ,</para>
  <para style="q2" vid="ISA 38:12">ŋgba namensekɛɛlere kanyaŋ deni nɛ.</para>
  <para style="q1" vid="ISA 38:12">Ma te bɔ ma nyeedoŋ ŋgba loore nɛ,</para>
  <para style="q2" vid="ISA 38:12">te ɔ kara maŋ lee kanyaŋ loore daŋ keŋ man,</para>
  <para style="q2" vid="ISA 38:12">te n yela ma weeya kɔŋa ɔto wee dokoloŋ.<verse eid="ISA 38:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 38:13" />Me nyiŋa konɔɔ daa kelii tɛɛ kabee kena,</para>
  <para style="q2" vid="ISA 38:13">mɔna ɔ yɛlɛɛ me ŋɔɔ pou ŋgba dinaate nɛ,</para>
  <para style="q2" vid="ISA 38:13">te n yela ma weeya kɔŋa ɔto wee dokoloŋ.<verse eid="ISA 38:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 38:14" />Me wiiwɔ ŋgba akpelee yaa boo gyebu nɛ,</para>
  <para style="q2" vid="ISA 38:14">ma keketeewɔ ŋgba duwuluŋ nɛ,</para>
  <para style="q1" vid="ISA 38:14">me kɛɛ adido te me sia yɛɛwɔ fulaa,</para>
  <para style="q2" vid="ISA 38:14">Ao Degbeŋgyoo! Ma wose te kyaŋ maŋ, kɔŋ kaa lɛɛ maŋ.&gt;&gt;<verse eid="ISA 38:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ISA 38:15" />Mɔna woŋ te maa tale yako?</para>
  <para style="q2" vid="ISA 38:15">Ɔ te kolosi fa maŋ, te ŋon gbagba yɛɛna kei.</para>
  <para style="q1" vid="ISA 38:15">Maa yɔkɔse ma wose ma kekyaabii man pou,</para>
  <para style="q2" vid="ISA 38:15">nawolo nyi ma woo ne di waraŋsa.<verse eid="ISA 38:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 38:16" />Ao Degbeŋgyoo, lee kɛŋa dɔɔ te balaŋ kyaa,</para>
  <para style="q2" vid="ISA 38:16">te ma woo mɔ ne nyiŋ nyeedoŋ lee ŋe man.</para>
  <para style="q1" vid="ISA 38:16">Nyaŋ yelela ma wose yɛɛ maŋ doŋ,</para>
  <para style="q2" vid="ISA 38:16">te n yelaa me kyaa nyeedoŋ man.<verse eid="ISA 38:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 38:17" />Ampaŋ lee me deeli dɔɔ,</para>
  <para style="q2" vid="ISA 38:17">te me naa diyem nideli.</para>
  <para style="q1" vid="ISA 38:17">N kegyae man te n lɛɛ maŋ,</para>
  <para style="q2" vid="ISA 38:17">lee kewɔlɛɛ bɔɔ keŋ man,</para>
  <para style="q1" vid="ISA 38:17">n te fuŋ me dukum pou,</para>
  <para style="q2" vid="ISA 38:17">lɔ n wɔle.<verse eid="ISA 38:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 38:18" />Nawolo nyi yebɔɔ be tale lese n yele ya,</para>
  <para style="q2" vid="ISA 38:18">yeŋ be tale kpee nɔɔneŋ lese n yele ya,</para>
  <para style="q1" vid="ISA 38:18">baŋ bɔɔ tisi gyoo yebɔɔ man,</para>
  <para style="q2" vid="ISA 38:18">be tale gyakaa nya anokoare kedi loo ya.<verse eid="ISA 38:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 38:19" />Baŋ be kyaa, baŋ be kyaa, na lesena n yele,</para>
  <para style="q2" vid="ISA 38:19">ŋgba mena keŋ mɛɛ yɛɛ gyɛŋ nɛ,</para>
  <para style="q1" vid="ISA 38:19">lolala ne yako be bia,</para>
  <para style="q2" vid="ISA 38:19">lee nya anokoare kedi wose man.<verse eid="ISA 38:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ISA 38:20" />Degbeŋgyoo waa lɛɛ maŋ,</para>
  <para style="q2" vid="ISA 38:20">na dɛɛ mo adolɛɛse kegyɔ kpee nɔɔneŋ,</para>
  <para style="q1" vid="ISA 38:20">Degbeŋgyoo ɔsom deni dinaa keŋ man,</para>
  <para style="q2" vid="ISA 38:20">da kekyaabii man pou,<verse eid="ISA 38:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 38:21" />Yesaya yakowɔ nyiaa, &lt;&lt;Ɛ gyɔ fiigi degbaŋ na ɛ ka mo buraa seere keŋ na waa nyiŋ kawee kekyɔ.&gt;&gt;<verse eid="ISA 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 38:22" />Hesekiya bɔɔsewɔ nyiaa, &lt;&lt;Woŋ ne gyaela ke yɛɛ kagyene nyi maa gyu Degbeŋgyoo ɔsom deni dinaa keŋ man?&gt;&gt;<verse eid="ISA 38:22" /></para>
  <chapter eid="ISA 38" />
  <chapter number="39" style="c" sid="ISA 39" />
  <para style="s1">Kpilara kalee Babilɔn</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 39:1" />Mena debaŋ kenaŋ nɛ, Baladane bu Merodake Baladane ŋon ɔ yɛɛ Babilɔn gyoo e nɛ ŋmarase tɔne mo kpuna abɔɔ kefa gyina Hesekiya. Nawolo nyi ɔ nyii Hesekiya kawee na ɔ kawee koro. <verse eid="ISA 39:1" /><verse number="2" style="v" sid="ISA 39:2" />Hesekiya lɛɛ kpilara baŋ gyoŋ man te ɔ wola wɔ abɔɔ ŋan doo wa abɔɔ dɛɛsee man. Ɔ wola wɔ kɔba wolom na kɔba yayam na abɔɔ ofoŋnyiŋan na oliifi nuŋ kpaakpaate na ɔ yoo abɔɔ pou na kpene kamasɛ keŋ doo wa abɔɔ dɛɛsee man. Kolo be doo ɔ gyooro dekpaŋalaŋ man yaa ɔ gyooridedii man keŋ Hesekiya ta mo wola wɔ ya.<verse eid="ISA 39:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 39:3" />Keŋte Wurubuarɛ gbalare Yesaya gyuuwɔ gyoo Hesekiya gyaŋ ke bɔɔse e nyiaa, &lt;&lt;Woŋ nombii yaa balaŋ baŋ kaa yako neŋ, te aleŋ yaa ba leewɔ?&gt;&gt;</para>
  <para style="p" vid="ISA 39:3">Te Hesekiya tiranɔɔ nyiaa, &lt;&lt;Ba lee tɛɛle lemlem daale man. Ba lee Babilɔn baa kɔŋ me gyaŋ.&gt;&gt;<verse eid="ISA 39:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 39:4" />Te Wurubuarɛ gbalare ŋon bɔɔse e nyiaa, &lt;&lt;Woŋ te be naawɔ n gyooro dekpaŋalaŋ man?&gt;&gt;</para>
  <para style="p" vid="ISA 39:4">Te Hesekiya yakowɔ nyiaa, &lt;&lt;Be naa kpene kamasɛ me gyooro dekpaŋalaŋ man. Kolo be doo ma abɔɔ dɛɛsee man keŋ me ta mo wola wɔ ya.&gt;&gt;<verse eid="ISA 39:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 39:5" />Keŋte Yesaya yako Hesekiya nyiaa, &lt;&lt;Degbeŋgyoo Dekpataakpere ŋon kpa nyiaa, <verse eid="ISA 39:5" /><verse number="6" style="v" sid="ISA 39:6" />Debaŋ daale ne kɔŋ keŋ baa mo kpene kamasɛ keŋ doo n gyooro dekpaŋalaŋ man, na ŋan pou n naanaɔ be gyae see kaalii gyɛŋ nɛ gyu Babilɔn. Kolo na kolo be gyae keka ya. Degbeŋgyoo yakola. <verse eid="ISA 39:6" /><verse number="7" style="v" sid="ISA 39:7" />Baa mo n duuluŋ man balaŋ na nyaŋ gbagba n tɔɔman bia gyu, na be kaa lese wɔ saayɛ Babilɔn gyoo gyooro dekpaŋalaŋ man.<verse eid="ISA 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 39:8" />Keŋte Hesekiya yako Yesaya nyiaa, &lt;&lt;Degbeŋgyoo nombii keŋ ɔ be yako nɛ dei.&gt;&gt; Nawolo ɔ gyueŋwɔ nyi, &lt;&lt;Maa nyiŋ wosefɛɛreŋ na kegyee ma debaŋ man.&gt;&gt;<verse eid="ISA 39:8" /></para>
  <chapter eid="ISA 39" />
  <chapter number="40" style="c" sid="ISA 40" />
  <para style="s1">Wurubuarɛ balaŋ kekyɔlɛɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 40:1" />Ɛ kyɔlɛɛ, ɛ kyɔlɛɛ me balaŋ,</para>
  <para style="q2" vid="ISA 40:1">Ɛ Wurubuarɛ yakola.<verse eid="ISA 40:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 40:2" />Ɛ kolosi wɔe kefɛɛ nombia fa Yerusalɛm,</para>
  <para style="q2" vid="ISA 40:2">na ɛ ke yako e</para>
  <para style="q1" vid="ISA 40:2">nyi ɔ tom nedoŋ keyɛɛ te kɔŋ ɔto,</para>
  <para style="q2" vid="ISA 40:2">nyi ba te tɔ ɔ dukum kom,</para>
  <para style="q1" vid="ISA 40:2">nyi ɔ te nyiŋ ɔ dukum kom</para>
  <para style="q2" vid="ISA 40:2">akpeŋ ala lee Degbeŋgyoo nyiŋmaa man.<verse eid="ISA 40:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 40:3" />Ŋolo ne fae yeesa nyiaa,</para>
  <para style="q1" vid="ISA 40:3">&lt;&lt;Ɛ desina</para>
  <para style="q2" vid="ISA 40:3">gbɛɛ depampaa man fa Degbeŋgyoo,</para>
  <para style="q1" vid="ISA 40:3">ɛ tenee gbɛɛneŋ depampaa man fa de Wurubuarɛ.<verse eid="ISA 40:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 40:4" />Ɛ mo tɛɛle wulu detaŋgya kamasɛ,</para>
  <para style="q2" vid="ISA 40:4">ɛ yɛlɛɛ bulase na bulasebia pou,</para>
  <para style="q1" vid="ISA 40:4">ɛ tala tɛɛle keŋ be kyalasɛɛ ya nɛ.</para>
  <para style="q2" vid="ISA 40:4">ɛ tenee gbɛɛneŋ ŋan be gokii nɛ.<verse eid="ISA 40:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 40:5" />Na baa lese Degbeŋgyoo gyoorobiiri wola,</para>
  <para style="q2" vid="ISA 40:5">na balaŋ pou ke debodokoloŋ naa ke,</para>
  <para style="q4" vid="ISA 40:5">Nawolo nyi Degbeŋgyoo gyuusuna ɔ nɔɔ yako.&gt;&gt;<verse eid="ISA 40:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 40:6" />Woya ŋaale yakowɔ nyi, &lt;&lt;Gyɔ dekpeŋkpeŋ.&gt;&gt;</para>
  <para style="q2" vid="ISA 40:6">Te me bɔɔsewɔ nyi, &lt;&lt;Maa gyɔ dekpeŋkpeŋ sena?&gt;&gt;</para>
  <para style="b" vid="ISA 40:6" />
  <para style="q1" vid="ISA 40:6">&lt;&lt;Balaŋ pou yɛɛ ŋgba ŋale nɛ,</para>
  <para style="q2" vid="ISA 40:6">te ba weeya yɛɛ ŋgba ŋale man kyeŋkyeŋkɔɔse nɛ.<verse eid="ISA 40:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 40:7" />Ŋale na boto na kyeŋkyeŋkɔɔse te kpiisi,</para>
  <para style="q2" vid="ISA 40:7">nawolo nyi Degbeŋgyoo na lee ɔ weesɛɛ ŋe dɔɔ.</para>
  <para style="q2" vid="ISA 40:7">Ampaŋ denibalaŋ yɛɛ ŋale ke.<verse eid="ISA 40:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 40:8" />Ŋale na boto na kyeŋkyeŋkɔɔse te kpiisi,</para>
  <para style="q2" vid="ISA 40:8">mɔna de Wurubuarɛ nombii keŋ kyaa kekpaakekpaa.&gt;&gt;<verse eid="ISA 40:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 40:9" />Nyaŋ ŋon n na mo nombia kpaakpaa kɔŋ Siyɔn,</para>
  <para style="q2" vid="ISA 40:9">gyeŋ gyu bula dɔɔloŋ nyeeman,</para>
  <para style="q1" vid="ISA 40:9">Nyaŋ ŋon n na mo nombia kpaakpaa kɔŋ Yerusalɛm,</para>
  <para style="q2" vid="ISA 40:9">gyina n woya fae yeesa,</para>
  <para style="q1" vid="ISA 40:9">fae yeesa, naa yee ya,</para>
  <para style="q2" vid="ISA 40:9">yako Yuda donɔɔse nyiaa,</para>
  <para style="q2" vid="ISA 40:9">&lt;&lt;Ɛ Wurubuarɛ yaa.&gt;&gt;<verse eid="ISA 40:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 40:10" />Kɛɛ, Degbeŋgyoo Doŋ Pou Nyee ne kɔŋ na doŋ,</para>
  <para style="q2" vid="ISA 40:10">te waa mo ɔ baam doŋte keŋ di gyoori.</para>
  <para style="q1" vid="ISA 40:10">Kɛɛ, ɔ dana ɔ komketɔ,</para>
  <para style="q2" vid="ISA 40:10">te ɔ balaŋ baŋ ɔ be lɛɛ wɔ kpuɛna e.<verse eid="ISA 40:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 40:11" />Ɔ ne kɛɛ ɔ wonembia ŋgba namense kɛɛlere nɛ.</para>
  <para style="q2" vid="ISA 40:11">Ɔ na tela namensebia baŋ ɔ nyiŋmaase man,</para>
  <para style="q1" vid="ISA 40:11">na ɔ te gɔtaa wɔ kyaŋna ɔ konɔɔ,</para>
  <para style="q2" vid="ISA 40:11">ɔ ne tɛɛ namense talabose baŋ siaman dɛɛdɛɛ.<verse eid="ISA 40:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 40:12" />Amɔte moona ɔ nyiŋmaatɔɔ maa loŋ,</para>
  <para style="q2" vid="ISA 40:12">yaa waa mo ɔ nyiŋmaa maa adido see?</para>
  <para style="q1" vid="ISA 40:12">Amɔte moona tɛɛle kei dɔɔ aŋasa do doŋa man,</para>
  <para style="q2" vid="ISA 40:12">yaa waa mo sikeli maa bulase,</para>
  <para style="q2" vid="ISA 40:12">na waa mo bulasebia gyakaa sikeli dɔɔ?<verse eid="ISA 40:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 40:13" />Amɔte ne gyaela waa tale gyeŋ keŋ Degbeŋgyoo feliŋ<note caller="+" style="fe"><char style="fr" closed="false">40:13 </char><char style="ft" closed="false">Nyeempɔ</char></note> ŋon waa yɛɛ,</para>
  <para style="q2" vid="ISA 40:13">yaa waa tale wola Degbeŋgyoo nombia?<verse eid="ISA 40:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 40:14" />Amɔ gyaŋ te Degbeŋgyoo gyuuwɔ nyi waa lese nombia man fa e,</para>
  <para style="q2" vid="ISA 40:14">te amɔte wolana e gbɛɛ keŋ tenɛɛ?</para>
  <para style="q1" vid="ISA 40:14">Amɔte wolana e nombia kagyeŋ,</para>
  <para style="q2" vid="ISA 40:14">yaa wola e nombia man kenyii gbɛɛ?<verse eid="ISA 40:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ISA 40:15" />Ampaŋ tɛɛlese pou yɛɛ ŋgba loŋ ketɔ yala som man nɛ,</para>
  <para style="q2" vid="ISA 40:15">bɛɛ kɛɛ wɔ ŋgba akuŋkuŋ gyakaala sikeli dɔɔ nɛ.</para>
  <para style="q2" vid="ISA 40:15">Ɔ ne keri tɛɛlesebia ŋan loŋ be kilisi ŋa nɛ ŋgba ŋe yɛɛ akuŋkuŋ buu nɛ.<verse eid="ISA 40:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 40:16" />Lebanɔn daase ta boo fa kedeesa boalaŋ kado ya,</para>
  <para style="q2" vid="ISA 40:16">te ke man wonembia ta boo fa katoo kedeesa ya.<verse eid="ISA 40:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 40:17" />Ɔ siaman na tɛɛlese pou yɛɛ yakaa,</para>
  <para style="q2" vid="ISA 40:17">ɔ ne kɛɛ ŋa nyi ŋɔɔ taŋ tɔnɔɔ ya,</para>
  <para style="q2" vid="ISA 40:17">te ŋe yɛɛ yakaa.<verse eid="ISA 40:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ISA 40:18" />Amɔte yaa ɛ ka mo Wurubuarɛ maana?</para>
  <para style="q2" vid="ISA 40:18">Dinɔɔ woŋti yaa ɛ ka mo e maana?<verse eid="ISA 40:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 40:19" />Bane dɔɔ, nyeele luure yɛɛna ke,</para>
  <para style="q2" vid="ISA 40:19">te kɔba yayam luure mɔ moo kɔba yayam gyilaa ke,</para>
  <para style="q2" vid="ISA 40:19">te ɔ moo kɔba wolom agbaraagbaraase desina ke.<verse eid="ISA 40:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 40:20" />Diyemte ŋon ɔ be gyae waa tale yɛɛ kei ya nɛ,</para>
  <para style="q2" vid="ISA 40:20">ne gyae daŋ keŋ be gyae ke dala ya nɛ,</para>
  <para style="q1" vid="ISA 40:20">na ɔ te gyae ŋon ɔ gyeŋ nyiŋmaa man adao nideli nɛ,</para>
  <para style="q2" vid="ISA 40:20">na ɔ te yae bane ŋon ɔ be gyae waa yala ya nɛ fa e.<verse eid="ISA 40:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="ISA 40:21" />Ɛ ba gyeŋ yee?</para>
  <para style="q2" vid="ISA 40:21">Ɛ te nyii yee?</para>
  <para style="q1" vid="ISA 40:21">Ba te yako ŋon leenaŋ kewalaŋ yee?</para>
  <para style="q2" vid="ISA 40:21">Ɛ te nyii ke man leenaŋ tɛɛle kewalaŋ keŋ yee?<verse eid="ISA 40:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 40:22" />Ɔ kyaa ɔ gyooro gbeli dɔɔ adido,</para>
  <para style="q2" vid="ISA 40:22">te tɛɛle dɔɔ balaŋ yɛɛ ŋgba akpataana nɛ.</para>
  <para style="q1" vid="ISA 40:22">Ɔ ne fɛlɛɛ adido ŋgba kanyaŋ nɛ,</para>
  <para style="q2" vid="ISA 40:22">na ɔ te baŋ ke ŋgba kanyaŋ deni nɛ na baa kyaa ke man.<verse eid="ISA 40:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 40:23" />Ɔ ne yɔkɔse siamantena doŋnyibaŋ baŋ,</para>
  <para style="q2" vid="ISA 40:23">na ɔ te yele ba te yɛɛ yakaa.<verse eid="ISA 40:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 40:24" />Be ka betaa duu wɔ pɛ,</para>
  <para style="q2" vid="ISA 40:24">be ka betaa duu wɔ pɛ,</para>
  <para style="q2" vid="ISA 40:24">ŋe ka betaa nyiŋ lila tɛɛle man pɛ,</para>
  <para style="q1" vid="ISA 40:24">te ɔ lee weesɛɛ woli ŋa te ŋa botowɔ,</para>
  <para style="q2" vid="ISA 40:24">te koloŋoloŋ kuu ŋa laŋ ŋgba wura nɛ.<verse eid="ISA 40:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="ISA 40:25" />Fereŋkyeŋte ŋon kpa nyiaa, &lt;&lt;Amɔte yaa ɛ ka mo maŋ maana?</para>
  <para style="q2" vid="ISA 40:25">Daa na amɔte yɛɛla kyɛɛkyɛɛ?<verse eid="ISA 40:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 40:26" />Ɛ gyina ɛ sia na ɛ ke kɛɛ adido,</para>
  <para style="q2" vid="ISA 40:26">Amɔte yɛɛna abɔɔ kɛŋa pou?</para>
  <para style="q1" vid="ISA 40:26">Ŋon yɛɛna adido abɔɔ pou dokoloŋ dokoloŋ,</para>
  <para style="q2" vid="ISA 40:26">te ɔ doo be man kamasɛ yele baake e.</para>
  <para style="q1" vid="ISA 40:26">Lee ɔ doŋ keŋ ka dokoso be kyaa ya na ɔ wɔɔle dɔɔ,</para>
  <para style="q2" vid="ISA 40:26">be man dokoloŋ gba ta yoo ya.<verse eid="ISA 40:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="ISA 40:27" />Yakɔbe, weera te n na toroŋ?</para>
  <para style="q2" vid="ISA 40:27">Iserae, weera te n ne yako nyi,</para>
  <para style="q1" vid="ISA 40:27">&lt;&lt;Me gbɛɛ ta yoo lee Degbeŋgyoo gyaŋ,</para>
  <para style="q2" vid="ISA 40:27">te me Wurubuarɛ be famenɛna me nombia ya&gt;&gt;?<verse eid="ISA 40:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 40:28" />Ɛ ba gyeŋ ke yee?</para>
  <para style="q2" vid="ISA 40:28">Ɛ te nyii ke yee?</para>
  <para style="q1" vid="ISA 40:28">Degbeŋgyoo yɛna Wurubuarɛ kekpaakekpaa ŋon,</para>
  <para style="q2" vid="ISA 40:28">Ŋon yɛɛna tɛɛle pou.</para>
  <para style="q1" vid="ISA 40:28">Ɔ bɛɛ kaa ya te kolo bɛɛ takaa e ya,</para>
  <para style="q2" vid="ISA 40:28">te ŋolo be tale nyii ɔ nombia kenyii man ya.<verse eid="ISA 40:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 40:29" />Ɔ na do baŋ be takaa wɔ nɛ doŋ,</para>
  <para style="q2" vid="ISA 40:29">na ɔ te fa baŋ bɔɔ yɔkɔse nɛ doŋ kpu,<verse eid="ISA 40:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 40:30" />Nombia ne takaa tewulɛɛ na alebia na ba te yɔkɔse,</para>
  <para style="q2" vid="ISA 40:30">na tewulɛɛ te kpaŋte na ba te yale.<verse eid="ISA 40:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 40:31" />Mɔna baŋ be loo gyakaa Degbeŋgyoo dɔɔ nɛ,</para>
  <para style="q2" vid="ISA 40:31">baa nyiŋ doŋ wɔle.</para>
  <para style="q1" vid="ISA 40:31">Baa nyiŋ beŋkelɛɛ furufu ŋgba otolokuse nɛ,</para>
  <para style="q2" vid="ISA 40:31">baa yeu keŋ bɔɔ kaa ya,</para>
  <para style="q2" vid="ISA 40:31">baa ta keŋ ba wose be yɔkɔse wɔ ya.<verse eid="ISA 40:31" /></para>
  <chapter eid="ISA 40" />
  <chapter number="41" style="c" sid="ISA 41" />
  <para style="s1">Iserae kyɔɔre ŋon</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 41:1" />&lt;&lt;Ɛmɛɛ tɛɛlese ŋan loŋ be kilisi ŋon, ɛ wuu ɛ nɔɔ me siaman.</para>
  <para style="q2" vid="ISA 41:1">Ɛ yela tɛɛlese ka do ba wose doŋ wɔle.</para>
  <para style="q1" vid="ISA 41:1">Ɛ yela baa tuu kɔŋ na baa kolosi,</para>
  <para style="q2" vid="ISA 41:1">ɛ yela dɛɛ gyaŋee nombia dedii man.<verse eid="ISA 41:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="ISA 41:2" />&lt;&lt;Amɔte doona ŋon ɔ ba lee weese dɛɛlee man kakyeŋ,</para>
  <para style="q2" vid="ISA 41:2">te ɔ baake e katenee man fa ɔ tom keyɛɛ?</para>
  <para style="q1" vid="ISA 41:2">Ɔ ta mo tɛɛlese do ɔ nyiŋmaa man,</para>
  <para style="q2" vid="ISA 41:2">te ɔ yɔkɔse gyooneŋ ɔ siaman.</para>
  <para style="q1" vid="ISA 41:2">Ɔ ta mo ɔ yoosila yela be ta bese akuŋkuŋ,</para>
  <para style="q2" vid="ISA 41:2">ɔ baŋdaŋ ne yɛɛ wɔ ŋgba wura ŋan feliŋ ne gyɔɔ nɛ.<verse eid="ISA 41:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 41:3" />Ɔ ne kuu gyakaa be dɔɔ keŋ kolo bɛɛ yɛɛ e ya,</para>
  <para style="q2" vid="ISA 41:3">gbɛɛ keŋ ɔ ta moota ke dɔɔ see ya.<verse eid="ISA 41:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 41:4" />Amɔte yɛɛna kei te ɔ yɛɛ ke kelii ɔto,</para>
  <para style="q2" vid="ISA 41:4">te ɔ ne baake kalola kegyakaare leenaŋ kewalaŋ keŋ?</para>
  <para style="q1" vid="ISA 41:4">Maŋ, Degbeŋgyoo ŋon mɔɔ kyaana gyaŋgbatena baŋ</para>
  <para style="q2" vid="ISA 41:4">te me kyaana ɔtomantena nɛ, maŋ ŋonaŋ.&gt;&gt;<verse eid="ISA 41:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 41:5" />Baŋ be kyaa tɛɛlese ŋan loŋ be kilisi ŋa naawɔ te gyakoloŋ gyoo wɔ,</para>
  <para style="q2" vid="ISA 41:5">tɛɛlese ɔto sereewɔ.</para>
  <para style="q1" vid="ISA 41:5">Be tuuwɔ benaa te be kɔŋawɔ siaman.<verse eid="ISA 41:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="ISA 41:6" />Bɛɛ kyɔ dɔŋa,</para>
  <para style="q2" vid="ISA 41:6">na ba te yako dɔŋa nyiaa, &lt;&lt;Seŋ keŋkeŋ.&gt;&gt;<verse eid="ISA 41:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 41:7" />Nyeele tomyɛɛre na do kɔba yayam luure kakyeŋ,</para>
  <para style="q2" vid="ISA 41:7">te ŋon ɔ na mo hama kyalase nɛ,</para>
  <para style="q2" vid="ISA 41:7">na do ŋon ɔ ne gyɔ nyema do nɛ doŋ,</para>
  <para style="q1" vid="ISA 41:7">Ŋolo ne yako ŋon ɔ ne kyaŋ nyeela debodokoloŋ nɛ nyi, &lt;&lt;Ke dei.&gt;&gt;</para>
  <para style="q2" vid="ISA 41:7">Bɛɛ mo nyeelabia gyɔ kyaŋ bane ŋon na ɔ be tum yala ya.<verse eid="ISA 41:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 41:8" />&lt;&lt;Mɔna nyaŋ, me tobaale Iserae,</para>
  <para style="q2" vid="ISA 41:8">Yakɔbe ŋon mɔɔ lese,</para>
  <para style="q2" vid="ISA 41:8">nyaŋ me gyoo Aberaham duuluŋman balaŋ,<verse eid="ISA 41:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 41:9" />Ma moo neŋ leenaŋ tɛɛle ɔto,</para>
  <para style="q2" vid="ISA 41:9">te me baake neŋ lee ka kebɔtalase man.</para>
  <para style="q1" vid="ISA 41:9">Me yakowɔ nyi, &lt;Nyaŋ yɛna me tobaale,&gt;</para>
  <para style="q1" vid="ISA 41:9">Maŋ lesena neŋ, te ma te bɛɛ neŋ ya.<verse eid="ISA 41:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 41:10" />Mena dɔɔ naa yee ya, nawolo nyi me kpuɛna neŋ,</para>
  <para style="q2" vid="ISA 41:10">na yele n wɔe kelɔ neŋ ya, nawolo nyi maŋ yɛna n Wurubuarɛ.</para>
  <para style="q1" vid="ISA 41:10">Maa do neŋ doŋ na maa kyɔ neŋ,</para>
  <para style="q2" vid="ISA 41:10">Maa mo me katenee dunoluŋ nyiŋmaa keŋ lɔ kyaŋ neŋ.<verse eid="ISA 41:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 41:11" />Baŋ pou bɛɛ gyeŋ baŋ do neŋ,</para>
  <para style="q2" vid="ISA 41:11">sia gyae ka yeŋ na desɛŋ ke kyaŋ wɔ,</para>
  <para style="q1" vid="ISA 41:11">baŋ pou bɛɛ seŋ tia neŋ,</para>
  <para style="q2" vid="ISA 41:11">baa yɛɛ yakaa na baa munu.<verse eid="ISA 41:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 41:12" />Doo nyi n ne kɛo n kɔlara nɛ,</para>
  <para style="q2" vid="ISA 41:12">n be gyae n ke naa wɔ ya.</para>
  <para style="q1" vid="ISA 41:12">Baŋ bee yoo neŋ nɛ,</para>
  <para style="q2" vid="ISA 41:12">baa yɛɛ yakaa.<verse eid="ISA 41:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 41:13" />Nawolo nyi maŋ yɛna Degbeŋgyoo n Wurubuarɛ,</para>
  <para style="q2" vid="ISA 41:13">ŋon mɔɔ lɔ kyaŋ neŋ n dunoluŋ nyiŋmaa man,</para>
  <para style="q1" vid="ISA 41:13">te mɔɔ yako neŋ nyi, Naa yee ya,</para>
  <para style="q2" vid="ISA 41:13">maa kyɔ neŋ nɛ.<verse eid="ISA 41:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 41:14" />Naa yee ya, nyaŋ feelii Yakɔbe,</para>
  <para style="q2" vid="ISA 41:14">nyaŋ Iserae ŋon n ta boo ya,</para>
  <para style="q1" vid="ISA 41:14">nawolo nyi maŋ gbagba maa kyɔ neŋ,&gt;&gt; Degbeŋgyoo torola yako,</para>
  <para style="q2" vid="ISA 41:14">Maŋ yɛna n lɛɛre, Iserae Fereŋkyeŋte Ŋon.<verse eid="ISA 41:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 41:15" />Kɛɛ, maa yɛɛ neŋ amɔla ketuku kɔta,</para>
  <para style="q2" vid="ISA 41:15">wɔle keŋ kɛɛ bee te ke dana kela burum.</para>
  <para style="q1" vid="ISA 41:15">Nyaŋ ke yɛlɛɛ bulase na n ke wɔlɛɛ ŋa,</para>
  <para style="q2" vid="ISA 41:15">na n ke yela bulasebia ka bese wura,<verse eid="ISA 41:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 41:16" />Nyaŋ ke feefu ŋa, na feliŋ ka mo ŋa laŋ,</para>
  <para style="q2" vid="ISA 41:16">na feliŋkum ke yaasee ŋa,</para>
  <para style="q1" vid="ISA 41:16">Mɔna nyaŋ dɔɔ nyaŋ ke nyaŋee lee Degbeŋgyoo man,</para>
  <para style="q2" vid="ISA 41:16">na n ka lese Iserae Fereŋkyeŋte ŋon yele.<verse eid="ISA 41:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ISA 41:17" />&lt;&lt;Akpaa ayematena na baŋ bɔɔ dana kolo ya ne kɛo loŋ,</para>
  <para style="q2" vid="ISA 41:17">te be te nyim ya,</para>
  <para style="q2" vid="ISA 41:17">te be laakemse da wolo lee loŋboaneŋ dɔɔ nɛ,</para>
  <para style="q1" vid="ISA 41:17">maŋ Degbeŋgyoo maa kpa wɔ,</para>
  <para style="q2" vid="ISA 41:17">Maŋ, Iseraetena Wurubuarɛ ŋon be gyae maa bɛɛ wɔ ya.<verse eid="ISA 41:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 41:18" />Maa yela booneŋ ke bɛɛ lee bulase ŋan ŋale be doo ŋe dɔɔ ya nɛ nyeeman,</para>
  <para style="q2" vid="ISA 41:18">na boŋobiise ke bɛɛ lee detaŋgyase man.</para>
  <para style="q1" vid="ISA 41:18">Maa yela depampaase ka bese apaase,</para>
  <para style="q2" vid="ISA 41:18">na tɛɛle dowolo ka bese boŋobiise.<verse eid="ISA 41:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 41:19" />Maa yela sida na akasia na osibi na oliifi daase,</para>
  <para style="q2" vid="ISA 41:19">ka seŋ depampaa man,</para>
  <para style="q1" vid="ISA 41:19">maa yela kateenaa na daase doŋ nyiŋan ke tu,</para>
  <para style="q2" vid="ISA 41:19">tɛɛle dowolo dɔɔ,<verse eid="ISA 41:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 41:20" />na balaŋ kena na baa gyeŋ,</para>
  <para style="q2" vid="ISA 41:20">baa gyueŋ ke man na baa nyii ke man,</para>
  <para style="q1" vid="ISA 41:20">nyi Degbeŋgyoo nyiŋmaa yɛɛna kei,</para>
  <para style="q2" vid="ISA 41:20">nyi Iserae Fereŋkyeŋte Ŋon yɛɛna kei.<verse eid="ISA 41:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="ISA 41:21" />Degbeŋgyoo kpa,</para>
  <para style="q2" vid="ISA 41:21">&lt;&lt;Ɛ mo ɛ nombia kɔŋ,</para>
  <para style="q1" vid="ISA 41:21">Yakɔbe gyoo kpa,</para>
  <para style="q2" vid="ISA 41:21">&lt;&lt;Ɛ kaa lese ɛ nɔɔse,<verse eid="ISA 41:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 41:22" />&lt;&lt;Ɛmɛɛ bɛɛneŋ, ɛ yako daa,</para>
  <para style="q2" vid="ISA 41:22">woŋ ne gyaela ke kɔŋ.</para>
  <para style="q1" vid="ISA 41:22">Ɛ yako daa mena keŋ beneŋ abɔɔ wɔɛ,</para>
  <para style="q2" vid="ISA 41:22">na dee nyiŋ gyueŋ ŋa,</para>
  <para style="q2" vid="ISA 41:22">na dɛɛ gyeŋ ŋɔ ɔtoman.</para>
  <para style="q1" vid="ISA 41:22">Yaa ɛ yako daa abɔɔ ŋan gyae ke kɔŋ.<verse eid="ISA 41:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="ISA 41:23" />Ɛ yako daa keŋ gyae ke kɔŋ weedaale,</para>
  <para style="q2" vid="ISA 41:23">na dɛɛ gyeŋ nyi ɛ yɛɛ wurubuarɛsewɔ.</para>
  <para style="q1" vid="ISA 41:23">Ɛ yɛɛ kolo kpaakpaa yaa kolokum,</para>
  <para style="q2" vid="ISA 41:23">na da wose ke gbirisi daa na dee yee.<verse eid="ISA 41:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 41:24" />Kɛɛ, ɛ be doo daale man ya,</para>
  <para style="q2" vid="ISA 41:24">te ɛ tomse yɛɛ yakaa,</para>
  <para style="q2" vid="ISA 41:24">ɔkamasɛ ŋon ɔ lese ŋon na ɔ ta bese anekɔlaŋ!<verse eid="ISA 41:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="ISA 41:25" />&lt;&lt;Ma te baake ŋolo lee ado yenaŋ te ɔ ne kɔŋ,</para>
  <para style="q2" vid="ISA 41:25">ŋolo lee weese dɛɛlee keŋ ɔ ne baake ma yele.</para>
  <para style="q1" vid="ISA 41:25">Waa sakatee siamantena ŋgba tɛɛle nɛ,</para>
  <para style="q2" vid="ISA 41:25">ŋgba saabu maare ŋon ɔ ne buu tɛɛle nɛ.<verse eid="ISA 41:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 41:26" />Amɔte yakona kei lee kewalaŋ keŋ na dɛɛ gyeŋ,</para>
  <para style="q2" vid="ISA 41:26">yaa ɔ wulaa yako ke na dɛɛ yako nyi, &lt;&lt;Ɔ nombia doona kegbɛɛ&gt;&gt;?</para>
  <para style="q1" vid="ISA 41:26">Ŋolo te yako ke ya,</para>
  <para style="q2" vid="ISA 41:26">ŋolo te wulaa yako ke ya,</para>
  <para style="q2" vid="ISA 41:26">ŋolo te nyii nombia ŋaale lee n gyaŋ ya.<verse eid="ISA 41:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 41:27" />Maŋ taŋgbɛɛla yako Siyɔn nyi, &lt;Kɛɛ, baŋ yaa.&gt;</para>
  <para style="q2" vid="ISA 41:27">Maŋ faana Yerusalɛm kpilare ŋon ɔ ne kolosi nombia kpaakpaa.<verse eid="ISA 41:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 41:28" />Me kɛɛwɔ mɔna ŋolo be kyaa ya,</para>
  <para style="q2" vid="ISA 41:28">ŋolo be kyaa bɛɛneŋ baŋ man keŋ waa kolosido ya,</para>
  <para style="q2" vid="ISA 41:28">me bɔɔse wɔ nombia na, ŋolo be kyaa waa tiranɔɔ ya.<verse eid="ISA 41:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 41:29" />Kɛɛ, be popou be dana tɔnɔɔ ya.</para>
  <para style="q2" vid="ISA 41:29">Ba ayɛɛsa yɛɛ yakaa,</para>
  <para style="q2" vid="ISA 41:29">be bɛɛneŋ yɛɛ feliŋ na yakaa.<verse eid="ISA 41:29" /></para>
  <chapter eid="ISA 41" />
  <chapter number="42" style="c" sid="ISA 42" />
  <para style="s1">Degbeŋgyoo tobaale</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 42:1" />&lt;&lt;Ma somere ŋon mɔɔ do e doŋ nɛ yaa,</para>
  <para style="q2" vid="ISA 42:1">ŋon mɔɔ lese e te ɔ na gyoo me sia,</para>
  <para style="q1" vid="ISA 42:1">maa mo me feliŋ do ɔ man,</para>
  <para style="q2" vid="ISA 42:1">na waa mo nombia kedi ke gbɛɛdɔɔ fa tɛɛlese.<verse eid="ISA 42:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 42:2" />Ɔ be gyae waa fae yeesa yaa waa wii,</para>
  <para style="q2" vid="ISA 42:2">yaa baa nyii ɔ woya abɔnterese man ya.<verse eid="ISA 42:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 42:3" />Ɔ be gyae waa tekeri moro keŋ be gɔŋase nɛ ya,</para>
  <para style="q2" vid="ISA 42:3">te ɔ be gyae waa ko kanea keŋ ka ŋmeleŋ na lee nyɔɔse nɛ ya.</para>
  <para style="q1" vid="ISA 42:3">Waa mo anokoare di nombia ke gbɛɛdɔɔ,<verse eid="ISA 42:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="ISA 42:4" />ɔ wose be gyae ke tekerii e yaa ke yɔkɔse e ya,</para>
  <para style="q1" vid="ISA 42:4">kelii debaŋ keŋ waa baŋ nombia kedi ke gbɛɛdɔɔ nae tɛɛle dɔɔ.</para>
  <para style="q2" vid="ISA 42:4">Baŋ be kyaa tɛɛlese ŋan loŋ be kilisi ŋa man nɛ baa mo be loo gyakaa ɔ kawola dɔɔ.&gt;&gt;<verse eid="ISA 42:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 42:5" />Nnɛ yaa Degbeŋgyoo Wurubuarɛ,</para>
  <para style="q1" vid="ISA 42:5">ŋon ɔ be yɛɛ adido te ɔ be wɔŋ ke man,</para>
  <para style="q2" vid="ISA 42:5">te ɔ be fɛlɛɛ tɛɛle na abɔɔ ŋan pou be tuu ke man,</para>
  <para style="q2" vid="ISA 42:5">ŋon ɔ be fa ke balaŋ weesɛɛ,</para>
  <para style="q2" vid="ISA 42:5">te ɔ be fa baŋ bɛɛ tɛɛ ke dɔɔ nyeedoŋ nɛ ne yako,<verse eid="ISA 42:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 42:6" />&lt;&lt;Maŋ Degbeŋgyoo baakena neŋ katenee man.</para>
  <para style="q2" vid="ISA 42:6">Maa lɔ kyaŋ n nyiŋmaa,</para>
  <para style="q1" vid="ISA 42:6">maa kɛɛ n dɔɔ na maa yela,</para>
  <para style="q2" vid="ISA 42:6">n ke yɛɛ nɔɔkebakesee fa balaŋ baŋ,</para>
  <para style="q2" vid="ISA 42:6">na keŋmaŋee fa tɛɛlese,<verse eid="ISA 42:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 42:7" />na n ke gyuusu siayɛlɛɛsatena sia,</para>
  <para style="q2" vid="ISA 42:7">na n ka lese baŋ bɔɔ kyam tɔ deni,</para>
  <para style="q2" vid="ISA 42:7">na baŋ be doo bɔɔ kyilimkyilim man nɛ lee detiŋtɛɛ man.<verse eid="ISA 42:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 42:8" />&lt;&lt;Maŋ yɛna Degbeŋgyoo, ma yele kenaŋ!</para>
  <para style="q2" vid="ISA 42:8">Mɔɔ gyae maa mo me gyoorobiiri fa ŋolo,</para>
  <para style="q2" vid="ISA 42:8">yaa ma yele kalese fa bɛɛneŋ ya.<verse eid="ISA 42:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 42:9" />Kɛɛ, gyaŋgba nombia ŋan kɔŋawɔ mena,</para>
  <para style="q2" vid="ISA 42:9">te nɛnɛɛ mɛɛ toro nombia wɔlɛɛ yako,</para>
  <para style="q1" vid="ISA 42:9">pɛ ŋa ke kɔŋ na</para>
  <para style="q2" vid="ISA 42:9">ma te gyɔ ŋa dekpeŋkpeŋ fa ŋon,&gt;&gt;<verse eid="ISA 42:9" /></para>
  <para style="s1">Yele kalese nɔɔneŋ fa Debeŋgyoo</para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 42:10" />Ɛmɛɛ baŋ ɛ ne tisi gyu ɛpo man na ŋan pou doo ke man,</para>
  <para style="q2" vid="ISA 42:10">ɛmɛɛ tɛɛlese ŋan loŋ be kilisi ŋa na baŋ be kyaa ŋe man,</para>
  <para style="q1" vid="ISA 42:10">ɛ kpee nɔɔneŋ wɔle fa Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 42:10">ɛ lese ɔ yele lee tɛɛle ɔto,<verse eid="ISA 42:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 42:11" />Depampaa na donɔɔse ŋan kyaa ŋe man baa gyina ba woya,</para>
  <para style="q2" vid="ISA 42:11">donɔɔse ŋan man Kedare kyaa nɛ baa nyaŋee.</para>
  <para style="q1" vid="ISA 42:11">Baŋ be kyaa Sela baa kpee nɔɔneŋ nyaŋee,</para>
  <para style="q2" vid="ISA 42:11">Baa fae yeesa lee bulase nyeeya man.<verse eid="ISA 42:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 42:12" />Baa mo gyoorobiiri fa Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 42:12">na baa gyɔ ɔ yele kalese dekpeŋkpeŋ tɛɛlese ŋan loŋ be kilisi ŋa nɛ dɔɔ.<verse eid="ISA 42:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 42:13" />Degbeŋgyoo waa lee ŋgba baalebu nɛ,</para>
  <para style="q2" vid="ISA 42:13">waa wose ɔ wose ŋgba yoonɔɔte nɛ,</para>
  <para style="q1" vid="ISA 42:13">waa gyina ɔ woya fae yoo yeesa,</para>
  <para style="q2" vid="ISA 42:13">na waa yoodi ɔ kɔlara dɔɔ.<verse eid="ISA 42:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ISA 42:14" />&lt;&lt;Me wuu me nɔɔ te kyare,</para>
  <para style="q2" vid="ISA 42:14">me yɛɛwɔ yididi te me kyaŋa ma wose.</para>
  <para style="q1" vid="ISA 42:14">Mɔna nɛnɛɛ maa keŋee ŋgba alo ŋon ɔ na doŋee nɛ,</para>
  <para style="q2" vid="ISA 42:14">maa lɔ nɔɔ na maa lee weesɛɛ foofoofoo.<verse eid="ISA 42:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 42:15" />Maa yɛlɛɛ bulase na bulasebia,</para>
  <para style="q2" vid="ISA 42:15">na maa yela ŋe ŋalese laŋ pou ka yekee.</para>
  <para style="q1" vid="ISA 42:15">Maa yela booneŋ ka bese tɛɛlese ŋan loŋ be kilisi ŋa,</para>
  <para style="q2" vid="ISA 42:15">na maa yela apaase pou ka yoo.<verse eid="ISA 42:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 42:16" />Maa mo siayɛlɛɛsatena ta gbɛɛneŋ ŋan bɔɔ gyeŋ ya nɛ dɔɔ,</para>
  <para style="q2" vid="ISA 42:16">ta detɛese ŋan bɔɔ gyeŋ ya,</para>
  <para style="q1" vid="ISA 42:16">maa yela detiŋtɛɛ ka bese keŋmaŋee be siaman,</para>
  <para style="q2" vid="ISA 42:16">na maa kyalase botɔɔse ŋan be kyalasɛɛ ya nɛ.</para>
  <para style="q1" vid="ISA 42:16">Kɛŋa yɛna abɔɔ ŋan maa yɛɛ,</para>
  <para style="q2" vid="ISA 42:16">mɔɔ gyae maa yela wɔ ya.<verse eid="ISA 42:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 42:17" />Mɔna baŋ bɛɛ mo ba wose lɔ bɛɛneŋ dɔɔ,</para>
  <para style="q2" vid="ISA 42:17">te bɛɛ yako dinɔɔse nyi, &lt;Ɛmɛɛ yɛna de wurubuarɛse&gt; nɛ,</para>
  <para style="q2" vid="ISA 42:17">baa mo desɛŋ dinaa bese be wɔle.<verse eid="ISA 42:17" /></para>
  <para style="s1">Iserae sia keyɛlɛɛ na deŋela ketɔ</para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 42:18" />&lt;&lt;Ɛmɛɛ deŋela atɔɔsatena, ɛ nyii,</para>
  <para style="q2" vid="ISA 42:18">ɛmɛɛ siayɛlɛɛsatena, ɛ kɛɛ, na ɛ kena.<verse eid="ISA 42:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 42:19" />Amɔte sia yɛlɛɛla ŋgba ma somere nɛ,</para>
  <para style="q2" vid="ISA 42:19">te ɔ deŋela tɔɔwɔ ŋgba me kpilare ŋon mee kpili nɛ?</para>
  <para style="q1" vid="ISA 42:19">Amɔte sia yɛlɛɛla ŋgba ŋon daana e be bakenɔɔsee,</para>
  <para style="q2" vid="ISA 42:19">te ɔ sia be yɛlɛɛ ŋgba Degbeŋgyoo somere nɛ?<verse eid="ISA 42:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 42:20" />N naa abɔɔ burum, mɔna n ta mo ŋa yɛɛ kolo ya,</para>
  <para style="q2" vid="ISA 42:20">n see deŋele, mɔna n te tei ya.&gt;&gt;<verse eid="ISA 42:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 42:21" />Ka gyoo Degbeŋgyoo sia,</para>
  <para style="q2" vid="ISA 42:21">lee ɔ katenee dɔɔ,</para>
  <para style="q2" vid="ISA 42:21">nyi waa yela ɔ mmaraa ke lɛɛ yele na kenyiŋ obuo.<verse eid="ISA 42:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 42:22" />Mɔna kei yɛna balaŋ baŋ bɔɔ kuu te bɔɔ ŋmɛɛle ba abɔɔ,</para>
  <para style="q2" vid="ISA 42:22">be popou te dɔɔ bɔɔ man,</para>
  <para style="q2" vid="ISA 42:22">yaa ba yoɛ deni ketɔ man.</para>
  <para style="q1" vid="ISA 42:22">Be ta bese baŋ bɔɔ kuu wɔ laŋ,</para>
  <para style="q2" vid="ISA 42:22">keŋ ŋolo be kyaa waa lɛɛ wɔ ya,</para>
  <para style="q1" vid="ISA 42:22">ba te ŋmɛɛle wɔ laŋ,</para>
  <para style="q2" vid="ISA 42:22">keŋ ŋolo be kyaa waa yako nyi, &lt;&lt;Ɛ besena wɔ ta ya.&gt;&gt;<verse eid="ISA 42:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="ISA 42:23" />Ɛ man woŋti ne gyaela waa tei kei,</para>
  <para style="q2" vid="ISA 42:23">yaa waa see deŋele nideli debaŋ keŋ gyae kekɔŋ nɛ?<verse eid="ISA 42:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 42:24" />Amɔte moona Yakɔbe fa ŋgba ŋmɛɛleŋ abɔɔ,</para>
  <para style="q2" vid="ISA 42:24">na Iserae fa baŋ bee kuu balaŋ abɔɔ nɛ?</para>
  <para style="q1" vid="ISA 42:24">Na Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 42:24">ŋon dɔɔ yɛɛ dukum tia e nɛ yee?</para>
  <para style="q1" vid="ISA 42:24">Nawolo nyi be te sila ɔ gbɛɛneŋ ya,</para>
  <para style="q2" vid="ISA 42:24">be te di ɔ mmaraa dɔɔ ya.<verse eid="ISA 42:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 42:25" />Mena dɔɔ te ɔ lese ɔ baŋkum,</para>
  <para style="q2" vid="ISA 42:25">na yoo man kayeyɛɛ wola wɔ.</para>
  <para style="q1" vid="ISA 42:25">Ɔ yelaa boalaŋ laakemse kilisi wɔ, mɔna be te nyii ke man ya,</para>
  <para style="q2" vid="ISA 42:25">ke kpaa wɔ, mɔna be ta mo yɛɛ kolo ya.<verse eid="ISA 42:25" /></para>
  <chapter eid="ISA 42" />
  <chapter number="43" style="c" sid="ISA 43" />
  <para style="s">Iserae nyeelɛɛre dokoloŋ kooŋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 43:1" />Mɔna nɛnɛɛ nnɛ yaa Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 43:1">ŋon ɔ be yɛɛ nyaŋ Yakɔbe,</para>
  <para style="q2" vid="ISA 43:1">te ɔ be ma nyaŋ Iserae nɛ ne yako,</para>
  <para style="q1" vid="ISA 43:1">&lt;&lt;Naa yee ya, nawolo nyi ma te lɛɛ neŋ,</para>
  <para style="q2" vid="ISA 43:1">ma te lɔ n yele baake neŋ nyi, n yɛɛ me wui.<verse eid="ISA 43:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 43:2" />Nyi n moo loŋse man na,</para>
  <para style="q2" vid="ISA 43:2">me kpuɛna neŋ,</para>
  <para style="q1" vid="ISA 43:2">te n moo booneŋ man na,</para>
  <para style="q2" vid="ISA 43:2">be gyae ka mo neŋ laŋ.</para>
  <para style="q1" vid="ISA 43:2">Nyi n dɔŋ boalaŋ man na,</para>
  <para style="q2" vid="ISA 43:2">n be gyae n ke nyakee ya,</para>
  <para style="q2" vid="ISA 43:2">boalaŋ laakemse ŋan be gyae ke koolii neŋ ya.<verse eid="ISA 43:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 43:3" />Nawolo nyi maŋ yɛna Degbeŋgyoo n Wurubuarɛ,</para>
  <para style="q2" vid="ISA 43:3">Iserae Fereŋkyeŋte Ŋon, n nyeelɛɛre.</para>
  <para style="q1" vid="ISA 43:3">me ta mo Igyipite tɔ n nyeeman kom,</para>
  <para style="q2" vid="ISA 43:3">me ta mo Kuse<note caller="+" style="fe"><char style="fr" closed="false">43:3 </char><char style="ft" closed="false">Keŋ yɛna naele ado yenaŋ</char></note> na Seba see n nawɔɔ man.<verse eid="ISA 43:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 43:4" />Lee keŋ n na lee koya te n dana obuo me siaman,</para>
  <para style="q2" vid="ISA 43:4">na keŋ mɛɛ gyae neŋ dɔɔ,</para>
  <para style="q1" vid="ISA 43:4">maa mo balaŋ kyɛɛkee neŋ,</para>
  <para style="q2" vid="ISA 43:4">maa mo tɛɛlese kyɛɛkee lɛɛ n nyeedoŋ.<verse eid="ISA 43:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 43:5" />Naa yee ya, nawolo nyi me kpuɛna neŋ,</para>
  <para style="q2" vid="ISA 43:5">maa mo n bia lee weese dɛɛlee kɔŋ,</para>
  <para style="q2" vid="ISA 43:5">na maa yilaa ŋon lee weese dɛɛyalae.<verse eid="ISA 43:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 43:6" />Maa yako adoyenaŋ nyi, &lt;Tina wɔ yela.&gt;</para>
  <para style="q2" vid="ISA 43:6">na maa yako atayenaŋ nyi, &lt;Naa kyaŋ wɔ see ya.&gt;</para>
  <para style="q1" vid="ISA 43:6">Mo me bia tewulɛɛ lee lemlem,</para>
  <para style="q2" vid="ISA 43:6">na me bia alebia lee tɛɛle ɔto kɔŋ.<verse eid="ISA 43:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 43:7" />ɔkamasɛ ŋon bɔɔ mo ma yele baake e,</para>
  <para style="q2" vid="ISA 43:7">ŋon mɔɔ yɛɛ e fa me gyoorobiiri,</para>
  <para style="q2" vid="ISA 43:7">ŋon mɔɔ ma e te mɔɔ yɛɛ e nɛ.&gt;&gt;<verse eid="ISA 43:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 43:8" />Yilaa baŋ be dana sia mɔna be sia te yɛlɛɛ,</para>
  <para style="q2" vid="ISA 43:8">baŋ be dana deŋela mɔna ba deŋela te tɔɔ nɛ.<verse eid="ISA 43:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 43:9" />Tɛɛlese pou dɛɛ gyaŋee,</para>
  <para style="q2" vid="ISA 43:9">na balaŋ baŋ ke yilaa.</para>
  <para style="q1" vid="ISA 43:9">Be wurubuarɛse baŋ man woŋti yakona kei lee kewalaŋ,</para>
  <para style="q2" vid="ISA 43:9">te ɔ gyɔɔ abɔɔ ŋan be kɔŋ kaalaŋ nɛ dekpeŋkpeŋ fa daa?</para>
  <para style="q1" vid="ISA 43:9">Baa mo ba adansɛɛtena kɔŋ, na be kaa di adansɛɛ nyi be nombia doona kegbɛɛ,</para>
  <para style="q2" vid="ISA 43:9">na baale ke nyii na baa yako nyi, &lt;&lt;Ke yɛɛ ampaŋ.&gt;&gt;<verse eid="ISA 43:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 43:10" />Degbeŋgyoo kpa, &lt;&lt;Ɛmɛɛ yɛna ma adansɛɛtena,</para>
  <para style="q2" vid="ISA 43:10">na ma somere ŋon mɔɔ lese,</para>
  <para style="q1" vid="ISA 43:10">na ɛ ke nyiŋ gyeŋ na ɛ ke lɛɛ maŋ di,</para>
  <para style="q2" vid="ISA 43:10">na ɛ ke nyii ke man nyi maŋ ŋonaŋ.</para>
  <para style="q1" vid="ISA 43:10">Ba te yɛɛ wurubuarɛ ŋolo pɛte maŋ,</para>
  <para style="q2" vid="ISA 43:10">yaa ŋolo ke kɔŋ me wɔle ya.<verse eid="ISA 43:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 43:11" />Maŋ, maŋ yɛna Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 43:11">te maŋ wɔle na nyeelɛɛre ŋolo be kyaa ya.<verse eid="ISA 43:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 43:12" />Ma lesewɔ wola, te me lɛɛ walaŋ nyee, te me gyɔɔ ka dekpeŋkpeŋ,</para>
  <para style="q2" vid="ISA 43:12">Maŋ, na wurubuarɛ wɔle ŋolo ɛ man ya.</para>
  <para style="q1" vid="ISA 43:12">Degbeŋgyoo kpa, &lt;&lt;Ɛmɛɛ yɛna ma adansɛɛtena, nyi maŋ yɛna Wurubuarɛ.<verse eid="ISA 43:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="ISA 43:13" />Maŋ yɛna Wurubuarɛ leenaŋ beneŋ keŋ, maŋ ŋonaŋ.</para>
  <para style="q1" vid="ISA 43:13">Ŋolo be tale lɛo kolo lee me nyiŋmaa man ya,</para>
  <para style="q2" vid="ISA 43:13">Me yɛɛ kolo na, amɔte ne gyaela waa tale kyɛɛkee ke?&gt;&gt;<verse eid="ISA 43:13" /></para>
  <para style="s1">Wurubuarɛ waraŋase kewii na Iserae</para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 43:14" />Nnɛ yaa Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 43:14">ɛ Lɛɛre, Iserae Fereŋkyeŋte Ŋon ne yako,</para>
  <para style="q1" vid="ISA 43:14">&lt;&lt;Lee ɛmɛɛ dɔɔ maa kpila gyu Babilɔn,</para>
  <para style="q2" vid="ISA 43:14">na baa yoo mo Babilɔntena ŋgba yoogbeŋa nɛ<note caller="+" style="fe"><char style="fr" closed="false">43:14 </char><char style="ft" closed="false">Yaa Kalediyatena</char></note></para>
  <para style="q2" vid="ISA 43:14">na baa kuu wɔ do agbelese, ŋan dɔɔ bɛɛ gate ba wose nɛ man.<verse eid="ISA 43:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 43:15" />Maŋ yɛna Degbeŋgyoo, ɛ Fereŋkyeŋte Ŋon,</para>
  <para style="q2" vid="ISA 43:15">Iserae yɛɛre, ɛ Gyoo.&gt;&gt;<verse eid="ISA 43:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ISA 43:16" />Nnɛ yaa Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 43:16">ŋon ɔ ba do gbɛɛ ta ɛpo man,</para>
  <para style="q2" vid="ISA 43:16">te ɔ ba lese detɛe booneŋ dinaana man,<verse eid="ISA 43:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 43:17" />ŋon ɔ ne yele anebiliŋiŋse na dɛɛkyɔŋse,</para>
  <para style="q2" vid="ISA 43:17">yoonɔɔtena na baalabia,</para>
  <para style="q1" vid="ISA 43:17">ne yale keŋ bɔɔ na koro ya,</para>
  <para style="q2" vid="ISA 43:17">na be ta yem ŋgba kenea ŋmeleŋ nɛ ne yako,<verse eid="ISA 43:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 43:18" />&lt;&lt;Ɛ naa tɔɔse gyaŋgba nombia ya,</para>
  <para style="q2" vid="ISA 43:18">ɛ naa gyueŋ beneŋ nombia ŋan ya.<verse eid="ISA 43:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 43:19" />Kɛɛ, mɛɛ yɛɛ kolo wɔle!</para>
  <para style="q2" vid="ISA 43:19">Nɛnɛɛ te ka lese ka nyee, n bɛɛ naa ke yee?</para>
  <para style="q1" vid="ISA 43:19">Maa lese gbɛɛ depampaa man,</para>
  <para style="q2" vid="ISA 43:19">na boŋobiise tɛɛle kpakparakpaa man.<verse eid="ISA 43:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 43:20" />Ŋale man wonembia na mo obuo fa maŋ,</para>
  <para style="q2" vid="ISA 43:20">gbougbouse na kpilimse,</para>
  <para style="q1" vid="ISA 43:20">nawolo nyi ma te fa wɔ loŋ depampaa man,</para>
  <para style="q2" vid="ISA 43:20">te boŋobiise leewɔ tɛɛle dowolo man,</para>
  <para style="q1" vid="ISA 43:20">na maa fa me balaŋ baŋ mɔɔ lese nɛ loŋ baa nyɔɔ,<verse eid="ISA 43:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="ISA 43:21" />balaŋ baŋ mɔɔ yɛɛ fa ma wose,</para>
  <para style="q2" vid="ISA 43:21">na baa gyɔ ma yele kalese dekpeŋkpeŋ.<verse eid="ISA 43:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="ISA 43:22" />&lt;&lt;Mɔna Yakɔbe, n te baake maŋ ya,</para>
  <para style="q2" vid="ISA 43:22">Iserae<note caller="+" style="fe"><char style="fr" closed="false">43:22 </char><char style="ft" closed="false">Yaa Yakɔbe</char></note>, n ta mo n wose pou fa maŋ ya.<verse eid="ISA 43:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 43:23" />N ta mo n namense yɛɛ katoo kedeesa fa maŋ,</para>
  <para style="q2" vid="ISA 43:23">yaa n ka mo n kedeesase do maŋ obuo ya.</para>
  <para style="q1" vid="ISA 43:23">Me ta ŋere neŋ nyi nyaa mo n weenɛɛ deesi fa maŋ,</para>
  <para style="q2" vid="ISA 43:23">yaa nyaa mo oliifi som maŋ ya.<verse eid="ISA 43:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 43:24" />N te lɛɛ oliifi deesi fa maŋ,</para>
  <para style="q2" vid="ISA 43:24">yaa e n ka mo n kedeesa nuŋ fa maŋ beiŋ ya.</para>
  <para style="q1" vid="ISA 43:24">Mɔna n moo n dukum bese kasolɔ fa maŋ,</para>
  <para style="q2" vid="ISA 43:24">te n moo n nombiakumɛɛ naase maŋ diyem.<verse eid="ISA 43:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="ISA 43:25" />&lt;&lt;Maŋ, maŋ yɛna ŋon maa feefo,</para>
  <para style="q2" vid="ISA 43:25">n nombiakumɛɛ, lee maŋ gbagba dɔɔ,</para>
  <para style="q2" vid="ISA 43:25">keŋ mɔɔ gyae maa tɔɔse n dukum bela ya.<verse eid="ISA 43:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 43:26" />Tɔɔse maŋ gyaŋgba nombia,</para>
  <para style="q2" vid="ISA 43:26">yela daana neŋ ke di nombia,</para>
  <para style="q2" vid="ISA 43:26">yako n wui na ka wola nyi n nombia dei.<verse eid="ISA 43:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 43:27" />N naana gyaŋgbate yɛɛ dukum,</para>
  <para style="q2" vid="ISA 43:27">baŋ mɔɔ bɔɔ kpili nyi be kaa wola ŋon seŋawɔ tia maŋ,<verse eid="ISA 43:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 43:28" />Mena dɔɔ ma doo yɔ ɔsom deni dinaa man obuo balaŋ desɛŋ,</para>
  <para style="q2" vid="ISA 43:28">ma lese Yakɔbe fa nyi baa wɔlɛɛ e korakora<note caller="+" style="fe"><char style="fr" closed="false">43:28 </char><char style="ft" closed="false">43:28</char></note>,</para>
  <para style="q2" vid="ISA 43:28">te ma moo Iserae fa tubia.<verse eid="ISA 43:28" /></para>
  <chapter eid="ISA 43" />
  <chapter number="44" style="c" sid="ISA 44" />
  <para style="s1">Degbeŋgyoo Waageŋ Yɛna Wurubuarɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 44:1" />Nɛnɛɛ ɛ tei, ma somere Yakɔbe,</para>
  <para style="q2" vid="ISA 44:1">na Iserae ŋon mɔɔ lese.<verse eid="ISA 44:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 44:2" />Nnɛ yaa Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 44:2">ŋon ɔ be yɛɛ neŋ, te ɔ be ma neŋ do dokyɔa man,</para>
  <para style="q2" vid="ISA 44:2">te waa kyɔ neŋ nɛ ne yako,</para>
  <para style="q1" vid="ISA 44:2">Yakɔbe, ma somere,</para>
  <para style="q2" vid="ISA 44:2">Yesurun<note caller="+" style="fe"><char style="fr" closed="false">44:2 </char><char style="ft" closed="false">Ŋon ɔ gbɛɛ tenɛɛ nɛ</char></note> Ŋon mɔɔ lese, naa yee ya.<verse eid="ISA 44:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 44:3" />Nawolo nyi maa kyɛɛkee loŋ woli tɛɛle keŋ loŋboaneŋ na koo nɛ dɔɔ,</para>
  <para style="q2" vid="ISA 44:3">na boŋobiise ka lee tɛɛle dowolo dɔɔ,</para>
  <para style="q1" vid="ISA 44:3">maa mo me feliŋ do n bia man,</para>
  <para style="q2" vid="ISA 44:3">na maa hiraa n duuluŋ man balaŋ.<verse eid="ISA 44:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 44:4" />Baa potee ŋgba depaa man ŋalese,</para>
  <para style="q2" vid="ISA 44:4">ŋgba boo nɔɔman daase nɛ.<verse eid="ISA 44:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 44:5" />Ŋolo waa yako nyi, &lt;Me yɛɛ Degbeŋgyoo wui,&gt;</para>
  <para style="q2" vid="ISA 44:5">ŋolo waa mo Yakɔbe yele baake ɔ wose,</para>
  <para style="q1" vid="ISA 44:5">ŋolo mɔ waa ŋmarase gyakaa ɔ nyiŋmaa dɔɔ nyi, &lt;Degbeŋgyoo wui.&gt;</para>
  <para style="q2" vid="ISA 44:5">na waa mo Iserae yele do ɔ wose.<verse eid="ISA 44:5" /></para>
  <para style="s1">Degbeŋgyoo, na bɛɛneŋ ya</para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 44:6" />Nnɛ yaa Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 44:6">Iserae gyoo na lɛɛre, Degbeŋgyoo Dekpataakpere ŋon ne yako,</para>
  <para style="q1" vid="ISA 44:6">Maŋ yɛna gyaŋgbate, te maŋ yɛna ɔtomante,</para>
  <para style="q2" vid="ISA 44:6">lee maŋ wɔle na Wurubuarɛ ŋolo be kyaa ya.<verse eid="ISA 44:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 44:7" />Amɔta wɔela ŋgba maŋ nɛ? Waa gyɔ ka dekpeŋkpeŋ.</para>
  <para style="q2" vid="ISA 44:7">Waa toro ke yako na waa lese ke si maŋ me siaman</para>
  <para style="q1" vid="ISA 44:7">keŋ be kɔŋ leenaŋ debaŋ keŋ mɔɔ see me balaŋ gyaŋgba nyibaŋ,</para>
  <para style="q2" vid="ISA 44:7">na kpene keŋ gyae kekɔŋ,</para>
  <para style="q2" vid="ISA 44:7">Ayi, baa yako kpene keŋ gyae ke kɔŋ wee daale.<verse eid="ISA 44:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 44:8" />Ɛ naa seree ya, ɛ naa yee ya.</para>
  <para style="q2" vid="ISA 44:8">Me te wulaa gyɔ kei dekpeŋkpeŋ te me yako ke nombia lee beneŋ beneŋ yee?</para>
  <para style="q1" vid="ISA 44:8">Ɛmɛɛ yɛna ma adansɛɛtena. Wurubuarɛ ŋolo kyaa kpuna maŋ?</para>
  <para style="q2" vid="ISA 44:8">Koa, kpanaŋ ŋolo be kyaa ya. Mɔɔ gyeŋ ŋolo ya.&gt;&gt;<verse eid="ISA 44:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 44:9" />Baŋ pou bɛɛ yɛɛ bɛɛneŋ nɛ yɛɛ yakaa,</para>
  <para style="q2" vid="ISA 44:9">te abɔɔ ŋan bɛɛ mo obuo fa nɛ be dana tɔnɔɔ ya.</para>
  <para style="q1" vid="ISA 44:9">Baŋ baa kolosi fa wɔ nɛ sia te yɛlɛɛ,</para>
  <para style="q2" vid="ISA 44:9">bɔɔ gyeŋ kolo ya te desɛŋ gyae ke kyaŋ wɔ.<verse eid="ISA 44:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 44:10" />Amɔte ne yɛɛna wurubuarɛ ŋolo te ɔ ne yae bane,</para>
  <para style="q2" vid="ISA 44:10">keŋ taŋ tɔnɔɔ ya?<verse eid="ISA 44:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 44:11" />Kɛɛ, desɛŋ gyae ke kyaŋ baŋ pou bɛɛ yɛɛ mena nɛ,</para>
  <para style="q2" vid="ISA 44:11">baŋ bɛɛ mo adaose yɛɛ ŋa nɛ yɛɛ denibalaŋwɔ.</para>
  <para style="q1" vid="ISA 44:11">Be popou baa yilaa na baa lee kaa seŋ na dee di nombia,</para>
  <para style="q2" vid="ISA 44:11">gyakoloŋ na desɛŋ gyae ke kyaŋ wɔ.<verse eid="ISA 44:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 44:12" />Nyeele luure na mo nyeele,</para>
  <para style="q2" vid="ISA 44:12">do boalaŋ na nyewalaŋ man,</para>
  <para style="q1" vid="ISA 44:12">ɔ na mo hama gyɔ ke yɛɛ bane,</para>
  <para style="q2" vid="ISA 44:12">ɔ na mo ɔ baam doŋte keŋ yɛɛ ka wose man tom.</para>
  <para style="q1" vid="ISA 44:12">Tanam na ko e na ɔ te gbalase,</para>
  <para style="q2" vid="ISA 44:12">loŋboaneŋ na ko e na ɔ wose te yɔkɔse.<verse eid="ISA 44:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 44:13" />Daase yaere na mo ŋmeleŋ maa kolo,</para>
  <para style="q2" vid="ISA 44:13">na ɔ ta mo pɛnsele fee ke man,</para>
  <para style="q1" vid="ISA 44:13">ɔ na mo kyisele kyalase ke,</para>
  <para style="q2" vid="ISA 44:13">na ɔ ta mo kɔmepase do ke bɛɛlase.</para>
  <para style="q1" vid="ISA 44:13">Ɔ ne yɛɛ ke deniwalaŋ dinɔɔ man,</para>
  <para style="q2" vid="ISA 44:13">deniwalaŋ dinɔɔ na ɔ gyoorobiiri man,</para>
  <para style="q2" vid="ISA 44:13">na ka ke doo bane deni man.<verse eid="ISA 44:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 44:14" />Ɔ ne kara sida daase,</para>
  <para style="q2" vid="ISA 44:14">yaa daase kpaakpaa na kpeli daase.</para>
  <para style="q1" vid="ISA 44:14">Ɔ ne yele ŋɛɛ bee laaman daase man,</para>
  <para style="q2" vid="ISA 44:14">yaa ɔ ne duu pompo daŋ na ɔga te yele ke ta bee.<verse eid="ISA 44:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 44:15" />Bɛɛ mo daase ŋenaŋ do boalaŋ,</para>
  <para style="q2" vid="ISA 44:15">ɔ namo ŋaale do boalaŋ woli,</para>
  <para style="q2" vid="ISA 44:15">ɔ na mo ŋaale do boalaŋ wɔke bodobodo,</para>
  <para style="q1" vid="ISA 44:15">ɔ na mo ŋaale yɛɛ wurubuarɛ som e,</para>
  <para style="q2" vid="ISA 44:15">ɔ na mo ŋaale yɛɛ bane buŋ e.<verse eid="ISA 44:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 44:16" />Ɔ na mo daŋ keŋ yaale do boalaŋ,</para>
  <para style="q2" vid="ISA 44:16">ke dɔɔ te ɔ ne saa ɔ weenɛɛ,</para>
  <para style="q2" vid="ISA 44:16">ɔ ne wɔke ɔ naane ke dɔɔ tao baa.</para>
  <para style="q1" vid="ISA 44:16">Ɔ ne woli boalaŋ keŋ yako nyiaa,</para>
  <para style="q2" vid="ISA 44:16">&lt;&lt;Ao, ma wose te laŋe maŋ. Ma te naa boalaŋ keŋ.&gt;&gt;<verse eid="ISA 44:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 44:17" />Ɔ na mo akaŋ keŋ yɛɛ wurubuarɛ, ɔ bane,</para>
  <para style="q2" vid="ISA 44:17">ɔ ne buŋ na ɔ ta som ke.</para>
  <para style="q1" vid="ISA 44:17">Ɔ ne fane fa ke yako nyiaa,</para>
  <para style="q2" vid="ISA 44:17">&lt;&lt;Lɛɛ maŋ, nyaŋ yɛna me wurubuarɛ.&gt;&gt;<verse eid="ISA 44:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 44:18" />Bɔɔ gyeŋ kolo ya, bɔɔ ne nyii kolo man ya,</para>
  <para style="q2" vid="ISA 44:18">be te wuu be sia dɔɔ na bɔɔ nyiŋ naa ya,</para>
  <para style="q2" vid="ISA 44:18">ba te tɔ ba nyeempɔse na bɔɔ nyiŋ nyii nombia man ya.<verse eid="ISA 44:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 44:19" />Ŋolo bɛɛ gyueŋ ka wose man ya,</para>
  <para style="q2" vid="ISA 44:19">ŋolo be dana nombia man kagyeŋ yaa nombia man kenyii na waa yako nyi,</para>
  <para style="q1" vid="ISA 44:19">&lt;&lt;Ma moo ke yaale do boalaŋ,</para>
  <para style="q2" vid="ISA 44:19">me wɔke bodobodo ka nyewalaŋ dɔɔ,</para>
  <para style="q2" vid="ISA 44:19">me wɔke naane ke dɔɔ tao.</para>
  <para style="q1" vid="ISA 44:19">Maa mo akaŋ ŋan yɛɛ anekɔlaŋ?</para>
  <para style="q2" vid="ISA 44:19">Maa buŋ daŋ duguŋ?&gt;&gt;<verse eid="ISA 44:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 44:20" />Mena walaŋ ŋonaŋ silana tɔŋ, wa nyeempɔ ta beo e mo e yoo gbɛɛ,</para>
  <para style="q2" vid="ISA 44:20">ɔ be tale lɛɛ ɔ wose yaa waa yako nyi,</para>
  <para style="q2" vid="ISA 44:20">&lt;&lt;Keŋ doo me dunoluŋ nyiŋmaa man nɛ yɛɛ dekara ke yee?&gt;&gt;<verse eid="ISA 44:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="ISA 44:21" />&lt;&lt;Yakɔbe, tɔɔse nombia kɛŋa,</para>
  <para style="q2" vid="ISA 44:21">nawolo nyi nyaŋ, Iserae, n yɛɛ ma somere e.</para>
  <para style="q1" vid="ISA 44:21">Maŋ yɛɛna neŋ, n yɛɛ ma somere e,</para>
  <para style="q2" vid="ISA 44:21">Iserae, mɔɔ gyae maa wolee neŋ ya.<verse eid="ISA 44:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 44:22" />Me ta feefo n nombiakumɛɛ ŋgba debuŋta nɛ.</para>
  <para style="q2" vid="ISA 44:22">n dukum ŋgba obosuo nɛ,</para>
  <para style="q1" vid="ISA 44:22">Bese kɔŋ me gyaŋ,</para>
  <para style="q2" vid="ISA 44:22">nawolo nyi ma te lɛɛ neŋ.&gt;&gt;<verse eid="ISA 44:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 44:23" />Adido, ɛ kpee kenyaŋee nɔɔneŋ, nawolo nyi Degbeŋgyoo yɛɛna ke,</para>
  <para style="q2" vid="ISA 44:23">ɛmɛɛ tɛɛle ateta, ɛ fae yeesa keŋkeŋ.</para>
  <para style="q1" vid="ISA 44:23">Ɛmɛɛ bulase na laaneŋ na daase, ɛ kpee nɔɔneŋ,</para>
  <para style="q2" vid="ISA 44:23">nawolo nyi Degbeŋgyoo te lɛɛ Yakɔbe,</para>
  <para style="q2" vid="ISA 44:23">ɔ ta lese ɔ gyoorobiiri wola Iserae.<verse eid="ISA 44:23" /></para>
  <para style="s1">Yerusalɛm kekyaa</para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 44:24" />Nnɛ yaa Degbeŋgyoo n lɛɛre,</para>
  <para style="q2" vid="ISA 44:24">ŋon ɔ be yɛɛ neŋ n naa tɔɔman nɛ ne yako,</para>
  <para style="b" vid="ISA 44:24" />
  <para style="q1" vid="ISA 44:24">&lt;&lt;Maŋ yɛna Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 44:24">ŋon ɔ be yɛɛ abɔɔ pou,</para>
  <para style="q2" vid="ISA 44:24">maageŋ wɔŋana adido man,</para>
  <para style="q2" vid="ISA 44:24">te me fɛlɛɛ tɛɛle man,<verse eid="ISA 44:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 44:25" />Ŋon ne yelela baŋ bɛɛ gbale nɛ gyakoloŋ nombia ne yɛɛ yakaa,</para>
  <para style="q2" vid="ISA 44:25">te gbalara ne yɛɛ ayiŋtena,</para>
  <para style="q1" vid="ISA 44:25">mɛɛ leena siakaralatena nombia wɔle,</para>
  <para style="q2" vid="ISA 44:25">na ma te yele ke ta bese diyiŋ nombia.<verse eid="ISA 44:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 44:26" />Mee yele ma somera nombia na sem,</para>
  <para style="q2" vid="ISA 44:26">na ma te yele me kpilara nombia keyako te kɔŋ mena,</para>
  <para style="b" vid="ISA 44:26" />
  <para style="q1" vid="ISA 44:26">Me yako Yerusalɛm nyi, &lt;Balaŋ baa kyaa n man,&gt;</para>
  <para style="q2" vid="ISA 44:26">Yuda donɔɔse nyi, &lt;Baa bese baŋ ŋa,&gt;</para>
  <para style="q2" vid="ISA 44:26">na maa bese baŋ akyaŋse ŋan be tekerii nɛ,<verse eid="ISA 44:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 44:27" />me yako loŋse ateta nyi, &lt;Dɛɛ yo,</para>
  <para style="q2" vid="ISA 44:27">te maa yela n boŋobiise pou ka yo.&gt;<verse eid="ISA 44:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 44:28" />Me yako Korese nyi, &lt;Ŋon yɛna me namensekɛɛlere,</para>
  <para style="q2" vid="ISA 44:28">te waa yela ŋan mɛɛ gyae nɛ pou kekɔŋ mena,</para>
  <para style="q1" vid="ISA 44:28">me yako Yerusalɛm nyi, &lt;&lt;Baa bese baŋ ke,&gt;&gt;</para>
  <para style="q2" vid="ISA 44:28">te me yakowɔ lee ɔsom deni dinaa keŋ wose man nyi, &lt;&lt;Baa see ka mokɔɔ.&gt;&gt;&gt;<verse eid="ISA 44:28" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="ISA 44" />
  <chapter number="45" style="c" sid="ISA 45" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 45:1" />Kei yɛna keŋ Degbeŋgyoo be yako ɔ walaŋ ŋon ɔ be tiu e nuŋ nɛ,</para>
  <para style="q2" vid="ISA 45:1">fa Korese ŋon mɔɔ lɔ kyaŋ e ɔ dunoluŋ nyiŋmaa,</para>
  <para style="q1" vid="ISA 45:1">nyi maa yɔkɔse tɛɛlese ɔ siaman.</para>
  <para style="q2" vid="ISA 45:1">na maa booli gyooneŋ gbegyase,</para>
  <para style="q1" vid="ISA 45:1">na maa toro asima ɔ siaman,</para>
  <para style="q2" vid="ISA 45:1">na bɔɔ tɔe anaanɔɔse ya.<verse eid="ISA 45:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 45:2" />Maa ta n siaman,</para>
  <para style="q2" vid="ISA 45:2">na maa tala bulase,</para>
  <para style="q1" vid="ISA 45:2">maa tekerii kɔbere anaanɔɔse,</para>
  <para style="q2" vid="ISA 45:2">na maa kɛrɛɛ nyeela ŋan doo ŋe man.<verse eid="ISA 45:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 45:3" />Maa fa neŋ agyapadɛɛse ŋan weesɛɛ,</para>
  <para style="q2" vid="ISA 45:3">wosekenyiŋ ŋan bɔɔ mo see daweesee man,</para>
  <para style="q1" vid="ISA 45:3">na n ka gyeŋ nyi maŋ yɛna Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 45:3">Iserae Wurubuarɛ ŋon ɔ be lɔ yele baake neŋ.<verse eid="ISA 45:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 45:4" />Lee ma somere Yakɔbe,</para>
  <para style="q2" vid="ISA 45:4">na Iserae ŋon mɔɔ lese nɛ dɔɔ,</para>
  <para style="q1" vid="ISA 45:4">me lɔɔ yele baake neŋ,</para>
  <para style="q2" vid="ISA 45:4">doo nyi n ba gyeŋ maŋ ya,</para>
  <para style="q2" vid="ISA 45:4">mɔna me ta mo obuo fa neŋ<verse eid="ISA 45:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 45:5" />Maŋ yɛna Degbeŋgyoo, te ŋolo be kyaa ya,</para>
  <para style="q2" vid="ISA 45:5">maŋ wɔle na Wurubuarɛ ŋolo be kyaa ya.</para>
  <para style="q1" vid="ISA 45:5">doo nyi n ba gyeŋ maŋ ya,</para>
  <para style="q2" vid="ISA 45:5">mɔna maa do neŋ doŋ,<verse eid="ISA 45:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 45:6" />na balaŋ kenyiŋ gyeŋ nyi ŋolo be kyaa me wɔle,</para>
  <para style="q2" vid="ISA 45:6">lee weese dɛɛlee,</para>
  <para style="q1" vid="ISA 45:6">kelii weese dɛɛgyoe ya.</para>
  <para style="q2" vid="ISA 45:6">Maŋ yɛna Degbeŋgyoo, te ŋolo be kyaa bela ya.<verse eid="ISA 45:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 45:7" />Maŋ yɛɛna keŋmaŋee te me yɛɛ detiŋtɛɛ,</para>
  <para style="q2" vid="ISA 45:7">ma moo kede kɔŋ, te ma moo nombiikum kɔŋ,</para>
  <para style="q2" vid="ISA 45:7">Maŋ Degbeŋgyoo yɛɛna kɛŋa pou.<verse eid="ISA 45:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 45:8" />&lt;&lt;Ɛmɛɛ adido, ɛ kyɛɛkee me katenee lɔ tɛɛle dɔɔ,</para>
  <para style="q2" vid="ISA 45:8">debuŋta dɛɛ tisina ke woli tɛɛle.</para>
  <para style="q1" vid="ISA 45:8">Tɛɛle dee wola ke nɔɔ,</para>
  <para style="q2" vid="ISA 45:8">na nyeekelɛɛ ke bɛɛ lee kɔŋ,</para>
  <para style="q1" vid="ISA 45:8">katenee dɛɛ bee kpuna ke,</para>
  <para style="q2" vid="ISA 45:8">Maŋ Degbeŋgyoo yɛɛna ke.&gt;&gt;<verse eid="ISA 45:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 45:9" />Baŋ bɛɛ kalena be yɛɛre nɛ baa laako,</para>
  <para style="q2" vid="ISA 45:9">be yɛɛ yakaa ŋgba osuŋse nɛ,</para>
  <para style="q2" vid="ISA 45:9">ŋgba osuŋse ŋan bɛɛle doo ŋe man tɛɛle dɔɔ nɛ.</para>
  <para style="q1" vid="ISA 45:9">Tɛɛle ne bɔɔse osuŋ maare nyi,</para>
  <para style="q2" vid="ISA 45:9">&lt;woŋ yaa n ne maa?&gt;</para>
  <para style="q1" vid="ISA 45:9">N tom ne yako nyi,</para>
  <para style="q2" vid="ISA 45:9">&lt;Maare ŋon be dana nyiŋmaase yee&gt;?<verse eid="ISA 45:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 45:10" />Ŋon ɔ yako ɔ kya nyi,</para>
  <para style="q2" vid="ISA 45:10">&lt;Woŋ yaa n lolawɔ?&gt;</para>
  <para style="q1" vid="ISA 45:10">yaa ɔ naa nyi,</para>
  <para style="q2" vid="ISA 45:10">woŋ te n doŋeewɔ? nɛ waa laako.<verse eid="ISA 45:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 45:11" />Nnɛ yaa Degbeŋgyoo, Iserae fereŋkyeŋte ŋon,</para>
  <para style="q2" vid="ISA 45:11">na ɔ yɛɛre ne yako,</para>
  <para style="q1" vid="ISA 45:11">lee abɔɔ ŋan gyae kekɔŋ nɛ wose man.</para>
  <para style="q2" vid="ISA 45:11">Gbɛɛ doo nyi yaa bɔɔse maŋ kolo lee me bia wose man,</para>
  <para style="q2" vid="ISA 45:11">yaa ɛ ka wola maŋ keŋ maa yɛɛ lee me nyiŋmaa man tomse man?<verse eid="ISA 45:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 45:12" />Maŋ yɛɛna tɛɛle kei,</para>
  <para style="q2" vid="ISA 45:12">te me yɛɛ walaŋ see ke man.</para>
  <para style="q1" vid="ISA 45:12">Maŋ gbagba nyiŋmaase wɔŋana adido man,</para>
  <para style="q2" vid="ISA 45:12">te ma moo ka abɔɔ see ŋe daseŋae man.<verse eid="ISA 45:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 45:13" />Maŋ ne gyaela maa gyina Korese me katenee gbɛɛ man,</para>
  <para style="q2" vid="ISA 45:13">maŋ ne gyaela maa yela ɔ gbɛɛneŋ ka tenee.</para>
  <para style="q1" vid="ISA 45:13">Waa bese baŋ me donɔɔ dinaa keŋ,</para>
  <para style="q2" vid="ISA 45:13">na waa yela me yoogbeŋa ke nyiŋ ba wose,</para>
  <para style="q1" vid="ISA 45:13">keŋ ɔ be lɛɛ komketɔ yaa baa fa e kolo ya,</para>
  <para style="q2" vid="ISA 45:13">Degbeŋgyoo Dekpataakpere ŋon yakola.&gt;&gt;<verse eid="ISA 45:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 45:14" />Nnɛ yaa Degbeŋgyoo ne yako,</para>
  <para style="q1" vid="ISA 45:14">&lt;&lt;Igyipite dedii na Kuse kebu abɔɔ kenyiŋ<note caller="+" style="fe"><char style="fr" closed="false">45:14 </char><char style="ft" closed="false">Naele ado yenaŋ</char></note>,</para>
  <para style="q2" vid="ISA 45:14">Sebatena dɔɔloŋ nyibaŋ,</para>
  <para style="q1" vid="ISA 45:14">baa kɔŋ n gyaŋ,</para>
  <para style="q2" vid="ISA 45:14">na baa bese n wui,</para>
  <para style="q1" vid="ISA 45:14">baa lɔ baameŋse sila neŋ,</para>
  <para style="q2" vid="ISA 45:14">baa ta dikpii man kɔŋ n gyaŋ.</para>
  <para style="q1" vid="ISA 45:14">Baa kaa buŋ n siaman,</para>
  <para style="q2" vid="ISA 45:14">na baa waase neŋ nyiaa,</para>
  <para style="q1" vid="ISA 45:14">Ampaŋ Wurubuarɛ kpuɛna neŋ, te ŋolo be kyaa ya,</para>
  <para style="q2" vid="ISA 45:14">Wurubuarɛ ŋolo be kyaa ya.&gt;&gt;&gt;<verse eid="ISA 45:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ISA 45:15" />Ampaŋ nyaŋ yɛna Wurubuarɛ ŋon n na weese n wose,</para>
  <para style="q2" vid="ISA 45:15">Iserae Wurubuarɛ na ɔ nyeelɛɛre.<verse eid="ISA 45:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 45:16" />Baŋ pou bɛɛ yɛɛ bɛɛneŋ nɛ sia gyae ka yeŋ na desɛŋ ke kyaŋ wɔ,</para>
  <para style="q2" vid="ISA 45:16">desɛŋ gyae ke kyaŋ be popou.<verse eid="ISA 45:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 45:17" />Mɔna Degbeŋgyoo waa lɛɛ Iserae,</para>
  <para style="q2" vid="ISA 45:17">nyeekelɛɛ kekpaakekpaa,</para>
  <para style="q1" vid="ISA 45:17">n sia be gyae ka yeŋ yaa desɛŋ ke kyaŋ neŋ korakora ya,</para>
  <para style="q2" vid="ISA 45:17">kekpaakekpaa.<verse eid="ISA 45:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ISA 45:18" />Nnɛ yaa Degbeŋgyoo ne yako,</para>
  <para style="q1" vid="ISA 45:18">ŋon ɔ be yɛɛ adido,</para>
  <para style="q2" vid="ISA 45:18">ŋon yɛna Wurubuarɛ,</para>
  <para style="q1" vid="ISA 45:18">ŋon yɛɛna tɛɛle te ke kɔŋawɔ,</para>
  <para style="q2" vid="ISA 45:18">ŋon seena ka mokɔɔ,</para>
  <para style="q1" vid="ISA 45:18">ɔ te yɛɛ ke nyi ke dɛɛ doo yakaa ya,</para>
  <para style="q2" vid="ISA 45:18">mɔna ɔ yɛɛ ke na baa kyaa ke man,</para>
  <para style="q1" vid="ISA 45:18">ɔ kpa nyiaa,</para>
  <para style="q1" vid="ISA 45:18">&lt;&lt;Maŋ yɛna Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 45:18">ŋolo be kyaa bela ya.<verse eid="ISA 45:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 45:19" />Ma te kolosi weese,</para>
  <para style="q2" vid="ISA 45:19">tɛɛle kei yenaŋ daale keŋ detiŋtɛɛ doo nɛ ya,</para>
  <para style="q1" vid="ISA 45:19">ma te yako Yakɔbe duuluŋ man balaŋ nyi,</para>
  <para style="q2" vid="ISA 45:19">&lt;Ɛ kɛo maŋ yakaa ya.&gt;</para>
  <para style="q1" vid="ISA 45:19">Maŋ Degbeŋgyoo ne kolosi anokoare,</para>
  <para style="q2" vid="ISA 45:19">mɛɛ toro yako keŋ doona ke gbɛɛ.<verse eid="ISA 45:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ISA 45:20" />Ɛ yilaa na ɛ ke kɔŋ,</para>
  <para style="q2" vid="ISA 45:20">ɛmɛɛ baŋ ɛ be yekii gyu tɛɛlese man ɛ gyaŋee.</para>
  <para style="q1" vid="ISA 45:20">Baŋ be dɔŋ ba seelena daase bɛɛneŋ,</para>
  <para style="q2" vid="ISA 45:20">te bɛɛ fane fa wurubuarɛse baŋ bɔɔ tale lɛɛ wɔ ya nɛ, bɔɔ gyeŋ daale ya.<verse eid="ISA 45:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 45:21" />Ɛ toro ɛ nombia yako, na ɛ ka mo ŋa kɔŋ,</para>
  <para style="q2" vid="ISA 45:21">yela baa gyaŋee mo nyeempɔ.</para>
  <para style="q1" vid="ISA 45:21">Amɔte yakona kei lee gyaŋgba keŋ,</para>
  <para style="q2" vid="ISA 45:21">amɔte torona ke yako lee gyaŋgba gyaŋgba?</para>
  <para style="q1" vid="ISA 45:21">Na maŋ Degbeŋgyoo yee?</para>
  <para style="q2" vid="ISA 45:21">Wurubuarɛ ŋolo be kyaa kpuna maŋ ya,</para>
  <para style="q1" vid="ISA 45:21">Wurubuarɛ ŋon ɔ tenɛɛ te ɔ ne lɛɛ balaŋ nyee,</para>
  <para style="q2" vid="ISA 45:21">ŋolo be kyaa kpuna maŋ ya.<verse eid="ISA 45:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="ISA 45:22" />&lt;&lt;Ɛmɛɛ baŋ ɛ kyaa tɛɛle kei dɔɔ pou,</para>
  <para style="q2" vid="ISA 45:22">ɛ bese kɔŋ me gyaŋ na maa lɛɛ ɛ nyee,</para>
  <para style="q2" vid="ISA 45:22">nawolo nyi maŋ yɛna Wurubuarɛ te ŋolo be kyaa ya.<verse eid="ISA 45:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 45:23" />Ma te kaŋ ma wose ntam,</para>
  <para style="q2" vid="ISA 45:23">me nɔɔ te kolosi anokoare nombia,</para>
  <para style="q2" vid="ISA 45:23">nombia ŋan mɔɔ gyae maa kyɛɛkee ŋa ya.</para>
  <para style="q1" vid="ISA 45:23">Doona pou gyae ke buŋ maŋ,</para>
  <para style="q2" vid="ISA 45:23">laakem kamase gyae ke kaŋ ntam fa maŋ.<verse eid="ISA 45:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 45:24" />Baa yako nyi, &lt;Degbeŋgyoo waageŋ man,</para>
  <para style="q2" vid="ISA 45:24">te katenee na doŋ doo.&gt;&gt;&gt;</para>
  <para style="q1" vid="ISA 45:24">Baŋ pou bɔɔ gyeŋ baŋ do e nɛ,</para>
  <para style="q2" vid="ISA 45:24">baa kɔŋ ɔ gyaŋ na be sia ka yeŋ.<verse eid="ISA 45:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 45:25" />Mɔna Iserae duuluŋmantena pou,</para>
  <para style="q2" vid="ISA 45:25">baa nyiŋ katenee Degbeŋgyoo man,</para>
  <para style="q2" vid="ISA 45:25">na baa gate ba wose lee ŋon dɔɔ.<verse eid="ISA 45:25" /></para>
  <chapter eid="ISA 45" />
  <chapter number="46" style="c" sid="ISA 46" />
  <para style="s1">Babilɔn wurubuarɛse</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 46:1" />Bɛle te gɔŋase ɔ nyee, te Nebo buŋawɔ,</para>
  <para style="q2" vid="ISA 46:1">be bɛɛneŋ ta bese kasolɔse yuŋnyiŋan wonembia seelena,</para>
  <para style="q1" vid="ISA 46:1">be bɛɛneŋ dinɔɔse ŋan wonembia baŋ seelena nɛ dana yuŋ,</para>
  <para style="q2" vid="ISA 46:1">kasolɔse ŋan te takaa wɔ.<verse eid="ISA 46:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 46:2" />Baŋ na bɛɛneŋ baŋ ne debodokoloŋ tisi buŋ,</para>
  <para style="q2" vid="ISA 46:2">bɔɔ ne tale lɛɛ kasolɔse ŋan ya,</para>
  <para style="q2" vid="ISA 46:2">baŋ gbagba ne gyu yoogbeŋiri man.<verse eid="ISA 46:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 46:3" />&lt;&lt;Ɛmɛɛ Yakɔbe duuluŋman balaŋ,</para>
  <para style="q2" vid="ISA 46:3">ɛmɛɛ Iserae balaŋ akaŋ baŋ pou,</para>
  <para style="q1" vid="ISA 46:3">ɛmɛɛ baŋ mɔɔ tela ŋon leenaŋ ɛ fulu kekyaŋ man,</para>
  <para style="q2" vid="ISA 46:3">te mɔɔ do ŋon maama lee debaŋ keŋ bɔɔ lola ŋon, ɛ tei maŋ.<verse eid="ISA 46:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 46:4" />Kelii debaŋ keŋ ɛ ke ŋmɛ na ɛ nyee ka wolose nɛ,</para>
  <para style="q2" vid="ISA 46:4">Maŋ yɛna maŋ, maŋ yɛna ŋon maa kɛɛ ɛ dɔɔ.</para>
  <para style="q1" vid="ISA 46:4">Maŋ yɛɛna ŋon te maŋ ne gyaela maa tela ŋon,</para>
  <para style="q2" vid="ISA 46:4">maa kɛɛ ɛ dɔɔ na maa lɛɛ ŋon.<verse eid="ISA 46:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 46:5" />Amɔte yaa ɛ ka mo maŋ maana, yaa de yɛɛ kyɛɛkyɛɛ?</para>
  <para style="q2" vid="ISA 46:5">Ŋolo kyaa keŋ ɔ yɛɛ ŋgba man keŋ ɛ ka mo e maana maŋ?<verse eid="ISA 46:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 46:6" />Baale ne kyɛɛkee kɔba yayam lee be kotokuse man,</para>
  <para style="q2" vid="ISA 46:6">na ba te maa kɔba wolom sikelise dɔɔ,</para>
  <para style="q1" vid="ISA 46:6">bɛɛ bɔ nyeele luure paa nyi waa mo ke yɛɛ bane,</para>
  <para style="q2" vid="ISA 46:6">na be te bum som ke.<verse eid="ISA 46:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 46:7" />Bɛɛ gate ke gyakaa ba degbaŋgbaŋ dɔɔ,</para>
  <para style="q2" vid="ISA 46:7">mo ke kasee ka dedoi man na ke ta seŋ botɔɔ.</para>
  <para style="q2" vid="ISA 46:7">Kɔ ne tale kulu lee ke daseŋae kenaŋ man ya.</para>
  <para style="q1" vid="ISA 46:7">Nyi ŋolo ne fae yeesa baake e na, ɔ bɛɛ tale kpaa ya,</para>
  <para style="q2" vid="ISA 46:7">ɔ bɛɛ tale lɛɛ wɔ lee be kaalese man ya.<verse eid="ISA 46:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 46:8" />&lt;&lt;Ɛmɛɛ deŋele doŋtena, ɛ tɔɔse kei na ɛ ka gyueŋ ke man,</para>
  <para style="q2" vid="ISA 46:8">ke dee doo ɛ konɔɔse man.<verse eid="ISA 46:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 46:9" />Ɛ tɔɔse gyaŋgba abɔɔ ŋan, beneŋ beneŋ nombia ŋan.</para>
  <para style="q2" vid="ISA 46:9">Maŋ yɛna Wurubuarɛ te ŋolo be kyaa ya,</para>
  <para style="q2" vid="ISA 46:9">Maŋ yɛna Wurubuarɛ te ŋolo be wɔɛ ŋgba maŋ ya.<verse eid="ISA 46:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 46:10" />Lee kewalaŋ te mɛɛ yako ɔtoman nombia,</para>
  <para style="q2" vid="ISA 46:10">lee beneŋ beneŋ keŋ te mɛɛ yako keŋ gyae ke kɔŋ,</para>
  <para style="q1" vid="ISA 46:10">mɛɛ yako nyi, &lt;Ma kegyaebii gyae ka seŋ,</para>
  <para style="q2" vid="ISA 46:10">te maa yɛɛ ŋan pou na gyoo me sia.&gt;<verse eid="ISA 46:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 46:11" />Me baake kekperekpere lee weese dɛɛlee man,</para>
  <para style="q2" vid="ISA 46:11">baale ŋon waa yɛɛ ma kegyaebii lee tɛɛle lemlem.</para>
  <para style="q1" vid="ISA 46:11">Keŋ mɔɔ yako nɛ, keŋ te maa yela ka ke kɔŋ,</para>
  <para style="q2" vid="ISA 46:11">keŋ mɔɔ bake nɛ, keŋ te maa yɛɛ.<verse eid="ISA 46:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 46:12" />Ɛmɛɛ konɔɔyuŋtena, ɛ tei maŋ,</para>
  <para style="q2" vid="ISA 46:12">ɛmɛɛ baŋ ɛ dana lem lee me katenee gyaŋ.<verse eid="ISA 46:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 46:13" />Me ta mo me katenee benaa,</para>
  <para style="q2" vid="ISA 46:13">kɔɔ dana lem ya,</para>
  <para style="q2" vid="ISA 46:13">te ma nyeekelɛɛ be gyae ke dɔɔ wɔle ya.</para>
  <para style="q1" vid="ISA 46:13">Maa lɛɛ Siyɔn nyee,</para>
  <para style="q2" vid="ISA 46:13">maa lese me gyoorobiiri wola Iserae.<verse eid="ISA 46:13" /></para>
  <chapter eid="ISA 46" />
  <chapter number="47" style="c" sid="ISA 47" />
  <para style="s1">Babilɔn keyala</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 47:1" />Tisi gyu, ke kyaa akuŋkuŋ man,</para>
  <para style="q2" vid="ISA 47:1">Babilɔn alebu keteŋ,</para>
  <para style="q1" vid="ISA 47:1">kyaa tɛɛle man, keŋ gyoorogbeli be doo ya,</para>
  <para style="q2" vid="ISA 47:1">Babilɔn alagyoo donɔɔ dinaa<note caller="+" style="fe"><char style="fr" closed="false">47:1 </char><char style="ft" closed="false">Kaledeyan</char></note>,</para>
  <para style="q1" vid="ISA 47:1">Bɔɔ tekaa baake neŋ nyi,</para>
  <para style="q2" vid="ISA 47:1">kyeo yaa alebu ya.<verse eid="ISA 47:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 47:2" />Mo naŋboe na n ke naŋ biliŋ,</para>
  <para style="q2" vid="ISA 47:2">lese n siagbɛɛ kanyaŋbii keŋ,</para>
  <para style="q1" vid="ISA 47:2">gyina n kegba adido, lese n yiineŋ,</para>
  <para style="q2" vid="ISA 47:2">na n ka toŋ booneŋ.<verse eid="ISA 47:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 47:3" />N deteŋteli gyae ka lee debɔɔ,</para>
  <para style="q2" vid="ISA 47:3">na baa naa n desɛŋ.</para>
  <para style="q1" vid="ISA 47:3">Maa wɔŋ deŋele tɔ kom,</para>
  <para style="q2" vid="ISA 47:3">mɔɔ gyae maa tina ŋolo yela ya.&gt;&gt;<verse eid="ISA 47:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 47:4" />De lɛɛre yɛna Iserae Fereŋkyeŋte ŋon,</para>
  <para style="q2" vid="ISA 47:4">ɔ yele yɛna Degbeŋgyoo Dekpataakpere.<verse eid="ISA 47:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 47:5" />&lt;&lt;Nyaŋ Babilɔn alagyoo donɔɔ dinaa,</para>
  <para style="q2" vid="ISA 47:5">kyaa yididi na n ke gyu detiŋtɛɛ man,</para>
  <para style="q1" vid="ISA 47:5">bɔɔ tekaa baake neŋ nyi,</para>
  <para style="q2" vid="ISA 47:5">gyooridediise alagyoo bela ya.<verse eid="ISA 47:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 47:6" />Ma gyeŋa baŋ do me balaŋ,</para>
  <para style="q2" vid="ISA 47:6">me walaa me dedii,</para>
  <para style="q1" vid="ISA 47:6">ma moo wɔ do ɛ nyiŋmaa man,</para>
  <para style="q2" vid="ISA 47:6">te ɛ te wii be waraŋase ya.</para>
  <para style="q1" vid="ISA 47:6">Ba akpegyiina koraŋ,</para>
  <para style="q2" vid="ISA 47:6">ɛ moo kasolɔse ŋan dana yuŋ nideli gyakaa be dɔɔ.<verse eid="ISA 47:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 47:7" />N yakowɔ nyiaa,</para>
  <para style="q2" vid="ISA 47:7">&lt;Maa yɛɛ alagyoo kekpaakekpaa.&gt;</para>
  <para style="q1" vid="ISA 47:7">Mɔna n ta gyoo nombia kɛŋa man kɛɛ,</para>
  <para style="q2" vid="ISA 47:7">yaa n ka gyueŋ keŋ gyae ke kɔŋ man ya.<verse eid="ISA 47:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 47:8" />Nɛnɛɛ tei, nyaŋ ŋon n ne gyae gyoŋ kedi,</para>
  <para style="q2" vid="ISA 47:8">n kyaa wosefɛɛreŋ man,</para>
  <para style="q1" vid="ISA 47:8">te n ne yako n wose nyi,</para>
  <para style="q2" vid="ISA 47:8">&lt;Maŋ kyaala, ŋolo be kyaa me wɔle bela ya,</para>
  <para style="q1" vid="ISA 47:8">mɔɔ gyae maa kyaa lialo man,</para>
  <para style="q2" vid="ISA 47:8">yaa me bia ka yekee ya.&gt;<verse eid="ISA 47:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 47:9" />Abɔɔ ala kɛŋa gyae ke kɔŋ n dɔɔ,</para>
  <para style="q2" vid="ISA 47:9">deboman, wee dokoloŋ,</para>
  <para style="q2" vid="ISA 47:9">n bia baa yekee na n ke kyaa lialo.</para>
  <para style="q1" vid="ISA 47:9">Keŋ na n gbalara burum,</para>
  <para style="q2" vid="ISA 47:9">na n ŋmeeseŋ pou wɔle nɛ,</para>
  <para style="q2" vid="ISA 47:9">ŋe gyae ke kɔŋ n dɔɔ nideli.<verse eid="ISA 47:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 47:10" />N ta mo n wose lɔ nya akpanyanyaŋ keyɛɛ dɔɔ,</para>
  <para style="q2" vid="ISA 47:10">te n yakowɔ nyiaa, &lt;Ŋolo bɛɛ naa maŋ ya.&gt;</para>
  <para style="q1" vid="ISA 47:10">N nyansa na n nombia kagyeŋ beo neŋ,</para>
  <para style="q2" vid="ISA 47:10">te n yako n wose nyiaa,</para>
  <para style="q2" vid="ISA 47:10">&lt;Maŋ ŋonaŋ, ŋolo be kyaa kpuna maŋ ya.&gt;<verse eid="ISA 47:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 47:11" />Nombiikum gyae ke yala neŋ,</para>
  <para style="q2" vid="ISA 47:11">te n be gyae n ka gyeŋ mena keŋ n ke tɔ ke gbɛɛ ya.</para>
  <para style="q1" vid="ISA 47:11">Kayeyɛɛ gyae ke yala neŋ,</para>
  <para style="q2" vid="ISA 47:11">keŋ n be gyae n ke tale pataa ke ya,</para>
  <para style="q1" vid="ISA 47:11">kayeyɛɛ keŋ n loo be gyakaa ke dɔɔ ya,</para>
  <para style="q2" vid="ISA 47:11">gyae ke yala neŋ dɔɔ karatetee dokoloŋ.<verse eid="ISA 47:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 47:12" />Kyaŋ n magyigi,</para>
  <para style="q2" vid="ISA 47:12">na n ŋmeeseŋ burum ŋan,</para>
  <para style="q2" vid="ISA 47:12">n be kaa gyae lee n biatɛɛ nɛ man nideli.</para>
  <para style="q1" vid="ISA 47:12">Mberem gyae ke de fa neŋ,</para>
  <para style="q2" vid="ISA 47:12">mberem n ka mo ŋmaase baale.<verse eid="ISA 47:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 47:13" />Nyeempɔse ŋan pou n be lɛɛ nɛ te takaa neŋ.</para>
  <para style="q2" vid="ISA 47:13">Yela baŋ ba gyeŋ adido abɔɔ wose man nɛ ka lee kɔŋ,</para>
  <para style="q1" vid="ISA 47:13">baŋ bɛɛ gyene kyolobiise yako keŋ gyae kekɔŋ gyaalaŋ na gyaalaŋ nɛ,</para>
  <para style="q2" vid="ISA 47:13">yela baa lɛɛ n nyee lee keŋ gyae ke kɔŋ n dɔɔ nɛ man.<verse eid="ISA 47:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 47:14" />Kɛɛ, be yɛɛ ŋgba kaase nɛ,</para>
  <para style="q2" vid="ISA 47:14">boalaŋ gyae ke kpa wɔ.</para>
  <para style="q1" vid="ISA 47:14">Bɔɔ gyae baa tale lɛɛ ba wose,</para>
  <para style="q2" vid="ISA 47:14">lee boalaŋ laakemse ŋan man ya.</para>
  <para style="q1" vid="ISA 47:14">Ŋa te yɛɛ boalaŋ na nyewalaŋ keŋ baa woli ya,</para>
  <para style="q2" vid="ISA 47:14">ka te yɛɛ boalaŋ keŋ baa kyaa ke tɛɛ ya.<verse eid="ISA 47:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 47:15" />Mena te baŋ pou ɛmɛɛna wɔ be tɛɛ,</para>
  <para style="q2" vid="ISA 47:15">te ɛmɛɛna wɔ be kaa leenaŋ n biatɛɛ nɛ,</para>
  <para style="q2" vid="ISA 47:15">baa yɛɛ neŋ.</para>
  <para style="q1" vid="ISA 47:15">Walaŋ kamasɛ ta mo ɔ gbɛɛ,</para>
  <para style="q2" vid="ISA 47:15">ŋolo be kyaa keŋ waa tale lɛɛ neŋ ya.<verse eid="ISA 47:15" /></para>
  <chapter eid="ISA 47" />
  <chapter number="48" style="c" sid="ISA 48" />
  <para style="s1">Iserae konɔɔyuŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 48:1" />&lt;&lt;Ɛmɛɛ Yakɔbe duuluŋmantena, ɛ tei kei,</para>
  <para style="q2" vid="ISA 48:1">ɛmɛɛ baŋ bɔɔ mo Iserae yele baake ŋon,</para>
  <para style="q2" vid="ISA 48:1">te ɛ ba lee Yuda woŋ man,</para>
  <para style="q1" vid="ISA 48:1">ɛmɛɛ baŋ ɛ na mo Degbeŋgyoo yele kaŋ ntam,</para>
  <para style="q2" vid="ISA 48:1">te ɛ ne baake Iserae Wurubuarɛ yele,</para>
  <para style="q2" vid="ISA 48:1">mɔna na anokoare yaa katenee gbɛɛ man ya,<verse eid="ISA 48:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 48:2" />ɛmɛɛ baŋ ɛ ne baake ɛ wose nyi donɔɔ dinaa fereŋkyeŋ keŋ balaŋ,</para>
  <para style="q2" vid="ISA 48:2">te ɛ ne yɛɛ ŋgba ɛ na mo ɛ wose lɔ Iserae Wurubuarɛ dɔɔ,</para>
  <para style="q2" vid="ISA 48:2">Degbeŋgyoo Dekpataakpere yɛna ɔ yele.<verse eid="ISA 48:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 48:3" />Me wulaa yako gyaŋgba nombia ŋan benebene,</para>
  <para style="q2" vid="ISA 48:3">me gyɔ ŋa dekpeŋkpeŋ te me yelaa ɛ gyeŋawɔ,</para>
  <para style="q2" vid="ISA 48:3">me yɛɛ ke karatetee dokoloŋ te ŋe kɔŋawɔ mena.<verse eid="ISA 48:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 48:4" />Nawolo ma gyeŋ nyi ɛ dana konɔɔyuŋ</para>
  <para style="q2" vid="ISA 48:4">ɛ wɔŋe wolase yɛɛ nyeele bibiini ke,</para>
  <para style="q2" vid="ISA 48:4">ɛ tirinɔɔse yɛɛ kɔbere ke.<verse eid="ISA 48:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 48:5" />Mena dɔɔ me yako ŋon nombia kɛŋa lee beneŋ beneŋ,</para>
  <para style="q2" vid="ISA 48:5">me wulaa gyɔ ŋa dekpeŋkpeŋ fa ŋon pɛte ŋe lɔŋawɔ,</para>
  <para style="q1" vid="ISA 48:5">na ɛ be nyiŋ yako nyi,</para>
  <para style="q2" vid="ISA 48:5">&lt;Me bɛɛneŋ yelela ŋe kɔŋawɔ,</para>
  <para style="q2" vid="ISA 48:5">me bɛɛneŋ baŋ mɔɔ yae na me wurubuarɛ ŋon mɔɔ luu yelela ŋe kɔŋawɔ ya.<verse eid="ISA 48:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 48:6" />N te nyii nombia kɛŋa, kɛɛ ŋe popou.</para>
  <para style="q2" vid="ISA 48:6">N be lɛɛ ŋa do yee?</para>
  <para style="b" vid="ISA 48:6" />
  <para style="q1" vid="ISA 48:6">&lt;&lt;Lee nɛnɛɛ ne gyu maa yako neŋ nombia wɔlɛɛ,</para>
  <para style="q2" vid="ISA 48:6">nombia aweeseŋ ŋan n ba gyeŋ ya.<verse eid="ISA 48:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 48:7" />Nɛnɛɛ te be yɛɛ ŋa, ŋe ta lee gyaŋgba ya,</para>
  <para style="q2" vid="ISA 48:7">n te nyii ŋa see ŋgba gyɛŋ kei ya,</para>
  <para style="q1" vid="ISA 48:7">mena dɔɔ n be nyiŋ yako nyi,</para>
  <para style="q2" vid="ISA 48:7">&lt;Ayi, ma gyeŋ ŋa&gt; ya.<verse eid="ISA 48:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 48:8" />N te nyiita see yaa n ke nyii ke man ya,</para>
  <para style="q2" vid="ISA 48:8">lee gyaŋgba na n deŋela ta torota ya.</para>
  <para style="q1" vid="ISA 48:8">Ma gyeŋ nyi anokoare be doo n man ya,</para>
  <para style="q2" vid="ISA 48:8">be baake neŋ deŋele doŋte lee wee keŋ bɔɔ lola neŋ.<verse eid="ISA 48:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 48:9" />Lee ma yele dɔɔ te me wɔŋa me baŋ lee wɔle,</para>
  <para style="q2" vid="ISA 48:9">lee ma yele kalese dɔɔ te me wɔŋa ke lee wɔle lee n gyaŋ,</para>
  <para style="q2" vid="ISA 48:9">na mɔɔ nyiŋ wɔlɛɛ neŋ kerekere ya.<verse eid="ISA 48:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 48:10" />Kɛɛ, ma te kyalase neŋ, mɔna na ŋgba kɔba wolom ya.</para>
  <para style="q2" vid="ISA 48:10">Me te kɛɛse neŋ kɛɛ kaale boalaŋ degyapaa keŋ man.<verse eid="ISA 48:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 48:11" />Lee maŋ gbagba dɔɔ, lee maŋ gbagba dɔɔ, te me yɛɛ kei.</para>
  <para style="q2" vid="ISA 48:11">Woŋ dɔɔ te maa yela baa wɔlɛɛ ma yele?</para>
  <para style="q2" vid="ISA 48:11">Mɔɔ gyae maa mo me gyoorobiiri fa walaŋ ŋolo ya.<verse eid="ISA 48:11" /></para>
  <para style="s1">Iserae kenyiŋ ka wose</para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 48:12" />Yakɔbe, tei maŋ,</para>
  <para style="q2" vid="ISA 48:12">Iserae ŋon mɔɔ baake,</para>
  <para style="q1" vid="ISA 48:12">Maŋ ŋonaŋ,</para>
  <para style="q2" vid="ISA 48:12">Maŋ yɛna gyaŋgbate, te maŋ yɛna ɔtomante.<verse eid="ISA 48:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 48:13" />Maŋ gbagba moona me nyiŋmaase see tɛɛle kei mokɔɔ,</para>
  <para style="q2" vid="ISA 48:13">te me dunoluŋ nyiŋmaa fɛlɛɛ adido,</para>
  <para style="q1" vid="ISA 48:13">nyi me baake wɔ na,</para>
  <para style="q2" vid="ISA 48:13">be popou na koro seŋ.<verse eid="ISA 48:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ISA 48:14" />Ɛ popou ɛ kɔŋ kaa gyaŋee, na ɛ ke tei,</para>
  <para style="q2" vid="ISA 48:14">Bane woŋti wulaa yakona nombia kɛŋa?</para>
  <para style="q1" vid="ISA 48:14">Ŋon Degbeŋgyoo ba lese e nɛ,</para>
  <para style="q2" vid="ISA 48:14">waa yɛɛ keŋ ɔ kpa waa yɛɛ Babilɔn,</para>
  <para style="q2" vid="ISA 48:14">waa gyina ɔ baam tia Babilɔntena<note caller="+" style="fe"><char style="fr" closed="false">48:14 </char><char style="ft" closed="false">Kalediyatena </char></note><verse eid="ISA 48:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 48:15" />Maŋ, maŋ gbagba kolosila,</para>
  <para style="q2" vid="ISA 48:15">ayi, maŋ baakena e.</para>
  <para style="q1" vid="ISA 48:15">maa mo e kɔŋ,</para>
  <para style="q2" vid="ISA 48:15">na ɔ kpene kamasɛ keŋ waa yɛɛ ke de.<verse eid="ISA 48:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 48:16" />&lt;&lt;Ɛ tuu bena maŋ na ɛ ke tei nombii kei,</para>
  <para style="q1" vid="ISA 48:16">&lt;&lt;Lee kewalaŋ dekpeŋkpeŋ keŋ man nɛ, ma te kolosi nombii weese ya,</para>
  <para style="q2" vid="ISA 48:16">mena debaŋ kenaŋ na, me kyaa botɔɔ.&gt;&gt;</para>
  <para style="b" vid="ISA 48:16" />
  <para style="q1" vid="ISA 48:16">Nɛnɛɛ Degbeŋgyoo Doŋ Pou Nyee te kpila maŋ,</para>
  <para style="q2" vid="ISA 48:16">ɔ ta mo ɔ feliŋ do me man.<verse eid="ISA 48:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ISA 48:17" />Nnɛ yaa Degbeŋgyoo, n lɛɛre,</para>
  <para style="q2" vid="ISA 48:17">Iserae fereŋkyeŋte ŋon ne yako,</para>
  <para style="q1" vid="ISA 48:17">&lt;&lt;Maŋ yɛna Degbeŋgyoo n Wurubuarɛ,</para>
  <para style="q2" vid="ISA 48:17">ŋon ɔ na wola neŋ kpene keŋ dei nideli fa neŋ,</para>
  <para style="q2" vid="ISA 48:17">ŋon ɔ na wola neŋ gbɛɛ keŋ kaboena nyi nyaa mo.<verse eid="ISA 48:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 48:18" />Nyeŋ see n deŋele di maŋ mmaraase dɔɔ nɛ,</para>
  <para style="q2" vid="ISA 48:18">nafɔ n wosefɛɛreŋ gyae ke yɛɛ ŋgba boo nɛ,</para>
  <para style="q2" vid="ISA 48:18">na n kede ke yɛɛ ŋgba ɛpo feliŋ kegyɔ nɛ.<verse eid="ISA 48:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 48:19" />Nafɔ n duuluŋman balaŋ baa yɛɛ ŋgba aŋasa nɛ,</para>
  <para style="q2" vid="ISA 48:19">na n bia ke yɛɛ ŋgba ka boyabia nɛ,</para>
  <para style="q1" vid="ISA 48:19">bɔɔ gyae baa lese ba yela,</para>
  <para style="q2" vid="ISA 48:19">yaa baa wɔlɛɛ wɔ lee me siaman ya.&gt;&gt;<verse eid="ISA 48:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ISA 48:20" />Ɛ lee Babilɔn,</para>
  <para style="q2" vid="ISA 48:20">ɛ yeu lee Babilɔntena baŋ gyaŋ.</para>
  <para style="q1" vid="ISA 48:20">Ɛ mo kenyaŋee yeesa gyɔ kei dekpeŋkpeŋ,</para>
  <para style="q2" vid="ISA 48:20">na ka toro ke yako.</para>
  <para style="q1" vid="ISA 48:20">Ɛ yela ke kelii tɛɛle ɔto,</para>
  <para style="q2" vid="ISA 48:20">nyiaa, &lt;&lt;Degbeŋgyoo te lɛɛ ɔ somere Yakɔbe.&gt;&gt;<verse eid="ISA 48:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 48:21" />Ɔ moo wɔ ta depampaa man keŋ loŋboaneŋ ta ko wɔ ya,</para>
  <para style="q2" vid="ISA 48:21">ɔ yelaa loŋ leewɔ kpanaŋ man fa wɔ,</para>
  <para style="q1" vid="ISA 48:21">ɔ bɛɛse kpanaŋ man,</para>
  <para style="q2" vid="ISA 48:21">te loŋ leewɔ waale,<verse eid="ISA 48:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="ISA 48:22" />Degbeŋgyoo kpa, wosefɛɛreŋ be doo fa akpanyanyaŋte ya.&gt;&gt;<verse eid="ISA 48:22" /></para>
  <chapter eid="ISA 48" />
  <chapter number="49" style="c" sid="ISA 49" />
  <para style="s1">Degbeŋgyoo somere</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 49:1" />Ɛmɛɛ tɛɛlese ŋan loŋ be kilisi ŋon, ɛ tei maŋ,</para>
  <para style="q2" vid="ISA 49:1">ɛmɛɛ tɛɛlese ŋan ɛ kyaa lemlem, ɛ nyii maŋ.</para>
  <para style="q1" vid="ISA 49:1">Degbeŋgyoo baake man pɛte ba lola maŋ,</para>
  <para style="q2" vid="ISA 49:1">ɔ doo maŋ yele leenaŋ me naa tɔɔman.<verse eid="ISA 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 49:2" />Ɔ yɛɛ me nɔɔ ŋgba yoosila keŋ kɛɛ bee nɛ,</para>
  <para style="q2" vid="ISA 49:2">ɔ weese maŋ ɔ nyiŋmaa wuluŋ man,</para>
  <para style="q1" vid="ISA 49:2">ɔ moo maŋ yɛɛ baŋdaŋ nyeele keŋ kɛɛ bee,</para>
  <para style="q2" vid="ISA 49:2">te ɔ moo maŋ weese ɔ gbegya man.<verse eid="ISA 49:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 49:3" />Ɔ yako maŋ nyiaa, &lt;&lt;Iserae, n yɛɛ ma somere e,</para>
  <para style="q2" vid="ISA 49:3">N man te maa lɛɛ yele.&gt;&gt;<verse eid="ISA 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 49:4" />Mɔna me yakowɔ nyi, &lt;&lt;Ma te kaa leki,</para>
  <para style="q2" vid="ISA 49:4">ma te wɔlɛɛ me doŋ yakaa.</para>
  <para style="q1" vid="ISA 49:4">Mɔna keŋ yɛɛ me wui doo Degbeŋgyoo nyiŋmaa man,</para>
  <para style="q2" vid="ISA 49:4">te ma komketɔ kyaa Wurubuarɛ gyaŋ.&gt;&gt;<verse eid="ISA 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 49:5" />Te nɛnɛɛ Degbeŋgyoo kpa,</para>
  <para style="q2" vid="ISA 49:5">ŋon ɔ be yɛɛ maŋ me naa tɔɔman nyi maa yɛɛ ɔ somere,</para>
  <para style="q1" vid="ISA 49:5">na maa besena Yakɔbe kɔŋ ɔ gyaŋ,</para>
  <para style="q2" vid="ISA 49:5">na maa yilaa Iserae kɔna e.</para>
  <para style="q1" vid="ISA 49:5">Maa nyiŋ obuo Degbeŋgyoo siaman,</para>
  <para style="q2" vid="ISA 49:5">te me Wurubuarɛ yɛna me doŋ.<verse eid="ISA 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 49:6" />Ɔ kpa nyiaa,</para>
  <para style="q1" vid="ISA 49:6">&lt;&lt;Ta yee maŋ keyɛɛ nyi maa mo neŋ yɛɛ ma somere,</para>
  <para style="q2" vid="ISA 49:6">na n ke yela Yakɔbe ke kyaa gbeli,</para>
  <para style="q2" vid="ISA 49:6">na n ka besena Iseraetena baŋ mɔɔ kaase nɛ kɔŋ ya.</para>
  <para style="q1" vid="ISA 49:6">Maa mo neŋ yɛɛ keŋmaŋee fa baŋ ba te yɛɛ Yudatenawɔ ya nɛ,</para>
  <para style="q2" vid="ISA 49:6">na ma nyeekelɛɛ ke nyiŋ lii tɛɛle ɔto.&gt;&gt;<verse eid="ISA 49:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 49:7" />Nnɛ yaa Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 49:7">Lɛɛre na Iserae Fereŋkyeŋte ŋon ne yako,</para>
  <para style="q1" vid="ISA 49:7">fa ŋon tɛɛlese bɛɛ mo e yɛɛ kolo ya te bɔɔ bɛɛ e,</para>
  <para style="q2" vid="ISA 49:7">fa kegyiise somra baŋ nyiaa.</para>
  <para style="q1" vid="ISA 49:7">&lt;&lt;Gyooneŋ baa naa neŋ na baa koro seŋ,</para>
  <para style="q2" vid="ISA 49:7">gyoorobia baa naa na baa buŋ neŋ,</para>
  <para style="q1" vid="ISA 49:7">lee Degbeŋgyoo ŋon ɔ ne di anokoare nɛ dɔɔ,</para>
  <para style="q2" vid="ISA 49:7">Iserae fereŋkyeŋte ŋon ɔ ba lese neŋ dɔɔ.&gt;&gt;<verse eid="ISA 49:7" /></para>
  <para style="s1">Iserae kabese seŋ</para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 49:8" />Nnɛ yaa Degbeŋgyoo ne yako,</para>
  <para style="q1" vid="ISA 49:8">&lt;&lt;Me kaboele debaŋ de lii na, maa kpa neŋ,</para>
  <para style="q2" vid="ISA 49:8">te nyeekelɛɛ wee na, maa kyɔ neŋ,</para>
  <para style="q1" vid="ISA 49:8">maa kɛɛ n dɔɔ na maa yela,</para>
  <para style="q2" vid="ISA 49:8">n ka bese nɔɔkebakesee fa balaŋ baŋ,</para>
  <para style="q1" vid="ISA 49:8">na n ke desina tɛɛle keŋ seŋ,</para>
  <para style="q2" vid="ISA 49:8">na n ke kpala be deediise benɛɛ ŋan fa wɔ.<verse eid="ISA 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 49:9" />Na n ke yako yoogbeŋa nyiaa, &lt;Ɛ lee kɔŋ,&gt;</para>
  <para style="q2" vid="ISA 49:9">na baŋ be kyaa detiŋtɛɛ man nyi, &lt;Ɛ kɔŋ keŋmaŋee man.&gt;</para>
  <para style="b" vid="ISA 49:9" />
  <para style="q1" vid="ISA 49:9">&lt;&lt;Baa dii gbɛɛ nɔɔman,</para>
  <para style="q2" vid="ISA 49:9">na baa nyiŋ weenɛɛ bulasebia ŋan doo yakaa nɛ dɔɔ.<verse eid="ISA 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 49:10" />Tanam yaa loŋboaneŋ be gyae ka ko wɔ,</para>
  <para style="q2" vid="ISA 49:10">yaa depampaa duwulawula yaa weese ke nyakee wɔ ya.</para>
  <para style="q1" vid="ISA 49:10">Ŋon ɔ ne wii wɔ nɛ waa wola wɔ gbɛɛ,</para>
  <para style="q2" vid="ISA 49:10">na waa ta be siaman gyu loŋse deepue lee gyaŋ.<verse eid="ISA 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 49:11" />Maa yela me bulase pou ka bese gbɛɛneŋ,</para>
  <para style="q2" vid="ISA 49:11">na maa desina me gbɛɛneŋ dinaana.<verse eid="ISA 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 49:12" />Kɛɛ, baa lee lemlem kɔŋ,</para>
  <para style="q2" vid="ISA 49:12">baale baa lee adoyenaŋ, baale baa lee weese dɛɛyalae yenaŋ,</para>
  <para style="q2" vid="ISA 49:12">baale baa lee Sinim<note caller="+" style="fe"><char style="fr" closed="false">49:12 </char><char style="ft" closed="false">Asewa</char></note> tɛɛle man.<verse eid="ISA 49:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="ISA 49:13" />Ɛmɛɛ adido, ɛ fae yeesa nyaŋee,</para>
  <para style="q2" vid="ISA 49:13">nyaŋ tɛɛle, nyaŋee,</para>
  <para style="q2" vid="ISA 49:13">ɛmɛɛ bulase, ɛ kpee nɔɔneŋ!</para>
  <para style="q1" vid="ISA 49:13">Nawolo nyi Degbeŋgyoo waa kyɔlɛɛ ɔ balaŋ,</para>
  <para style="q2" vid="ISA 49:13">na waa wii ɔ balaŋ baŋ bɛɛ naa diyem nɛ.<verse eid="ISA 49:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ISA 49:14" />Mɔna Siyɔn kpa nyiaa, &lt;&lt;Degbeŋgyoo te bɛɛ maŋ,</para>
  <para style="q2" vid="ISA 49:14">Degbeŋgyoo te wolee maŋ.&gt;&gt;<verse eid="ISA 49:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ISA 49:15" />Alo waa tale wolee ɔ bu ŋon ɔ ne ŋmase,</para>
  <para style="q2" vid="ISA 49:15">te ɔ be wii bu ŋon ɔ ba lolo yee?</para>
  <para style="q1" vid="ISA 49:15">Nyi waa wolee e koraŋ nɛ,</para>
  <para style="q2" vid="ISA 49:15">maŋ be gyae maa wolee neŋ ya!<verse eid="ISA 49:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 49:16" />Kɛɛ, ma te kara n yele do me nyiŋmaatale man,</para>
  <para style="q2" vid="ISA 49:16">nya akyaŋse doo me siaman kekpaakekpaa,<verse eid="ISA 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 49:17" />N bia te yɛɛ ɔsaa bese kɔŋ,</para>
  <para style="q2" vid="ISA 49:17">te baŋ bɛɛ wɔlɛɛ neŋ baa gyu lemlem.<verse eid="ISA 49:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 49:18" />Gyina n sia na n ke kɛɛ gyaŋee,</para>
  <para style="q2" vid="ISA 49:18">n bia pou te yilaa ba wose bɛɛ kɔŋ n gyaŋ.</para>
  <para style="q1" vid="ISA 49:18">Degbeŋgyoo ta toro yako nyiaa, &lt;&lt;Maŋ nyiŋaa me kyaa nɛ,</para>
  <para style="q2" vid="ISA 49:18">nyaŋ ka do be popou ŋgba kegyaŋase kpaakpaa nyiŋan nɛ,</para>
  <para style="q2" vid="ISA 49:18">nyaŋ ke miaa ŋa ŋgba alowɔle nɛ.<verse eid="ISA 49:18" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="ISA 49:19" />&lt;&lt;Doo nyi be wɔlɛɛ neŋ te n doowɔ yakaa,</para>
  <para style="q2" vid="ISA 49:19">te n tɛɛle doowɔ yakaa koraŋ nɛ,</para>
  <para style="q1" vid="ISA 49:19">nɛnɛɛ n ke yɛɛ peperee beiŋ fa n balaŋ,</para>
  <para style="q2" vid="ISA 49:19">te baŋ bɔɔ wɔlɛɛ neŋ baa gyu lemlem.<verse eid="ISA 49:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 49:20" />Bia baŋ bɔɔ lolo n diyem kena debaŋ nɛ,</para>
  <para style="q2" vid="ISA 49:20">baa yako n ke nyii nyiaa,</para>
  <para style="q1" vid="ISA 49:20">&lt;Kɛbo ta boo fa daa ya,</para>
  <para style="q2" vid="ISA 49:20">gyae botɔɔ keŋ fɛlɛɛ fa daa dɛɛ kyaa.&gt;<verse eid="ISA 49:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 49:21" />Keŋte nyaŋ ke bɔɔse n wose nyiaa,</para>
  <para style="q2" vid="ISA 49:21">&lt;Amɔte lolana bia kɛwɔ fa maŋ?</para>
  <para style="q1" vid="ISA 49:21">me yɛɛ ɔlamanbo e te mee di waraŋsa,</para>
  <para style="q2" vid="ISA 49:21">be kyaŋa maŋ yoogbeŋi te be bɛɛ maŋ,</para>
  <para style="q2" vid="ISA 49:21">Amɔte kɛɛlena wɔ?</para>
  <para style="q1" vid="ISA 49:21">Be tinaa maŋ yela maageŋ,</para>
  <para style="q2" vid="ISA 49:21">mɔna aleŋ yaa ba leewɔ kɔŋ?<verse eid="ISA 49:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 49:22" />Nnɛ yaa Degbeŋgyoo Doŋ Pou Nyee ne yako,</para>
  <para style="q1" vid="ISA 49:22">&lt;&lt;Kɛɛ, maa gyina me nyiŋmaa adido wola tɛɛlese,</para>
  <para style="q2" vid="ISA 49:22">maa gyina ma felage wola balaŋ baŋ,</para>
  <para style="q1" vid="ISA 49:22">baa tela n bia baala be nyiŋmaase man kɔŋ,</para>
  <para style="q2" vid="ISA 49:22">na baa do n bia ala maama kɔŋ.<verse eid="ISA 49:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 49:23" />Gyooneŋ baa yɛɛ ɛ bia be kyaɔ,</para>
  <para style="q2" vid="ISA 49:23">na ba ala gyooneŋ ke fa wɔ dide.</para>
  <para style="q1" vid="ISA 49:23">Baa tisi buŋii ɛ naawɔɔtɛɛ mo be sia buŋ tɛɛle man,</para>
  <para style="q2" vid="ISA 49:23">baa deŋee ɛ naawɔɔtɛɛ akuŋkuŋ.</para>
  <para style="q1" vid="ISA 49:23">Na ɛ ka gyeŋ nyi maŋ yɛna Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 49:23">baŋ ba mo be loo gyakaa me dɔɔ na, desɛŋ be gyae ke kyaŋ wɔ ya.&gt;&gt;<verse eid="ISA 49:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="ISA 49:24" />Baa tale lɛo yooman abɔɔ lɛɛ yoonɔɔtena gyaŋ,</para>
  <para style="q2" vid="ISA 49:24">yaa baa lɛo yoogbeŋa lee doŋte gyaŋ?<verse eid="ISA 49:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 49:25" />Mɔna nnɛ yaa Degbeŋgyoo ne yako,</para>
  <para style="q1" vid="ISA 49:25">&lt;&lt;Ayi, baa lɛo yoogbeŋa lee yoonɔɔtena gyaŋ,</para>
  <para style="q2" vid="ISA 49:25">na baa lɛo yooman abɔɔ lee doŋtena gyaŋ,</para>
  <para style="q1" vid="ISA 49:25">Maa yoona baŋ bee yoona ŋon nɛ,</para>
  <para style="q2" vid="ISA 49:25">na maa lɛɛ ɛ bia nyee.<verse eid="ISA 49:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 49:26" />Maa yela baŋ bɛɛ ŋere ŋon do nɛ ke tao baŋ gbagba be naane,</para>
  <para style="q2" vid="ISA 49:26">baa nyɔɔ baŋ gbagba fatabo dɛɛse ŋgba waen nɛ.</para>
  <para style="q1" vid="ISA 49:26">Botɔɔ te balaŋ pou baa gyeŋ,</para>
  <para style="q2" vid="ISA 49:26">nyi maŋ, Degbeŋgyoo yɛna ɛ nyeelɛɛre,</para>
  <para style="q2" vid="ISA 49:26">ɛ lɛɛre, Yakɔbe doŋte ŋon.&gt;&gt;<verse eid="ISA 49:26" /></para>
  <chapter eid="ISA 49" />
  <chapter number="50" style="c" sid="ISA 50" />
  <para style="s1">Iserae dukum na somere ŋon dei kenyii</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 50:1" />Nnɛ yaa Degbeŋgyoo ne yako,</para>
  <para style="q1" vid="ISA 50:1">&lt;&lt;Ɛ naa yale kebɛɛ tɔne,</para>
  <para style="q2" vid="ISA 50:1">keŋ mɔɔ mo bɛɛ e nɛ de?</para>
  <para style="q1" vid="ISA 50:1">Yaa ma komte woŋti,</para>
  <para style="q2" vid="ISA 50:1">yaa me yɔɔ ŋon fa?</para>
  <para style="q1" vid="ISA 50:1">Kɛɛ, ɛ dukum dɔɔ te be yɔɔ ŋon,</para>
  <para style="q2" vid="ISA 50:1">ɛ nombiakumɛɛ dɔɔ te be bɛɛ ɛ naa.<verse eid="ISA 50:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 50:2" />Woŋ dɔɔ te me kɔŋawɔ na, ŋolo be kyaa ya?</para>
  <para style="q2" vid="ISA 50:2">Woŋ dɔɔ te me baakewɔ te ŋolo te kpaa ya?</para>
  <para style="q1" vid="ISA 50:2">Me baam yɛɛ duguŋ beiŋ keŋ be tale lese ŋon yee?</para>
  <para style="q2" vid="ISA 50:2">Yaa mɔɔ dana doŋ keŋ maa lɛɛ ŋon yee?</para>
  <para style="q1" vid="ISA 50:2">Me kalawɔna ɛpo bo te ka yoowɔ,</para>
  <para style="q2" vid="ISA 50:2">Me yelaa booneŋ bese depampaa,</para>
  <para style="q1" vid="ISA 50:2">ŋe kpebia yekeewɔ dala keŋ loŋ be doo ŋe man ya,</para>
  <para style="q2" vid="ISA 50:2">loŋboaneŋ yela ba yekeewɔ.<verse eid="ISA 50:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 50:3" />Maa mo detiŋtɛɛ kaa adido,</para>
  <para style="q2" vid="ISA 50:3">na maa mo titere wuu ɔ dɔɔ.<verse eid="ISA 50:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 50:4" />Degbeŋgyoo Doŋ Pou Nyee te fa maŋ kaseere laakem,</para>
  <para style="q2" vid="ISA 50:4">na maa gyeŋ nombii keŋ maa mo do ŋon nombia be takaa e nɛ doŋ.</para>
  <para style="q1" vid="ISA 50:4">Ɔ ne gyuusu maŋ nebo kamasɛ,</para>
  <para style="q2" vid="ISA 50:4">ɔ na toro ma deŋele na maa nyii ŋgba kaseere nɛ.<verse eid="ISA 50:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 50:5" />Degbeŋgyoo Doŋ Pou Nyee ta toro ma deŋela,</para>
  <para style="q2" vid="ISA 50:5">ma te yɛɛ deŋele doŋ ya.</para>
  <para style="q2" vid="ISA 50:5">me ta bese me wɔle ya<verse eid="ISA 50:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 50:6" />Ma besenaa me maama fa baŋ bee tuku maŋ nɛ,</para>
  <para style="q2" vid="ISA 50:6">me lakaase fa baŋ bɛɛ wɔŋee me nɔɔfata nɛ,</para>
  <para style="q1" vid="ISA 50:6">Me ta mo me sia weese,</para>
  <para style="q2" vid="ISA 50:6">lee balaŋ kekulu na nɔɔloŋ ketɔ woli ya.<verse eid="ISA 50:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 50:7" />Keŋ Degbeŋgyoo Doŋ Pou Nyee ne kyɔ maŋ dɔɔ,</para>
  <para style="q2" vid="ISA 50:7">desɛŋ be gyae ke kyaŋ maŋ ya.</para>
  <para style="q1" vid="ISA 50:7">Mena dɔɔ ma te sara me sia ŋgba boe keŋ kɛɛ bee nɛ,</para>
  <para style="q2" vid="ISA 50:7">te ma gyeŋ nyi me sia be gyae ka yeŋ ya.<verse eid="ISA 50:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 50:8" />Walaŋ ŋon waa fa maŋ deŋele kedi nɛ benaa.</para>
  <para style="q2" vid="ISA 50:8">Amɔte ne gyaela waa mo nombia gyakaa me dɔɔ?</para>
  <para style="q2" vid="ISA 50:8">Waa kɔŋ dɛɛ gyaŋee,</para>
  <para style="q1" vid="ISA 50:8">amɔte moona nombia gyakaa me dɔɔ?</para>
  <para style="q2" vid="ISA 50:8">Waa tuu benaa maŋ.<verse eid="ISA 50:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 50:9" />Degbeŋgyoo Doŋ Pou Nyee ne kyɔɔna maŋ,</para>
  <para style="q2" vid="ISA 50:9">Amɔte ne gyaela waa bu maŋ fɔɔ?</para>
  <para style="q1" vid="ISA 50:9">Baa lɔɔree ŋgba kanyaŋ nɛ,</para>
  <para style="q2" vid="ISA 50:9">paapaase baa tao wɔ.<verse eid="ISA 50:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 50:10" />Ɛ man woŋti ne yeena Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 50:10">te ɔ ne di ɔ somere nombia dɔɔ?</para>
  <para style="q1" vid="ISA 50:10">Amɔte dɔŋɛɛla detiŋtɛɛ man,</para>
  <para style="q2" vid="ISA 50:10">keŋ ɔ be taŋ keŋmaŋee ya,</para>
  <para style="q1" vid="ISA 50:10">waa mo ɔ wose lɔ Degbeŋgyoo yele dɔɔ,</para>
  <para style="q2" vid="ISA 50:10">na waa lɛɛ ɔ Wurubuarɛ di.<verse eid="ISA 50:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 50:11" />Nɛnɛɛ ɛmɛɛ baŋ pou ɛ na do boalaŋse,</para>
  <para style="q2" vid="ISA 50:11">te ɛ ne kyaa boalaŋ laakemse gyaŋ woli,</para>
  <para style="q1" vid="ISA 50:11">ɛ ta ɛ boalaŋse keŋmaŋee man,</para>
  <para style="q2" vid="ISA 50:11">na boalaŋ keŋ ɛ ne feefudo nɛ man.</para>
  <para style="q1" vid="ISA 50:11">Keŋ ɛ ke nyiŋ lee me nyiŋmaa man yɛna nyi,</para>
  <para style="q2" vid="ISA 50:11">ɛ ke tisi doo diyem kena man.<verse eid="ISA 50:11" /></para>
  <chapter eid="ISA 50" />
  <chapter number="51" style="c" sid="ISA 51" />
  <para style="s1">Siyɔn nyeekelɛɛ kekpaakekpaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 51:1" />Ɛmɛɛ baŋ ɛ silana katenee gbɛɛ,</para>
  <para style="q2" vid="ISA 51:1">te ɛ ne kɛo Degbeŋgyoo, ɛ tei maŋ</para>
  <para style="q1" vid="ISA 51:1">Ɛ kɛɛ kpanaŋ keŋ man bɔɔ kpae ŋon lee,</para>
  <para style="q2" vid="ISA 51:1">na boya deyɛɛlɛe keŋ man bɔɔ lese ŋon lee.<verse eid="ISA 51:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 51:2" />Ɛ kɛɛ ɛ naana Aberaham</para>
  <para style="q2" vid="ISA 51:2">na Sara ŋon ɔ ba lola ŋon.</para>
  <para style="q1" vid="ISA 51:2">Ɔ yɛɛ dokoloŋ te me baake e,</para>
  <para style="q2" vid="ISA 51:2">te me hiraa e te me yelaa ɔ lolee bia burum.<verse eid="ISA 51:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 51:3" />Degbeŋgyoo waa fɛɛ Siyɔn wɔe</para>
  <para style="q2" vid="ISA 51:3">na waa wii ɔ donɔɔ keŋ kɔɔ wɔlɛɛ nɛ waraŋase.</para>
  <para style="q1" vid="ISA 51:3">Waa besena ɔ depampaa keŋ yɛɛ Edɛn wɔɔbii,</para>
  <para style="q2" vid="ISA 51:3">na waa yɛɛ ɔ tɛɛle dowolo ŋgba Degbeŋgyoo wɔɔbii nɛ.</para>
  <para style="q1" vid="ISA 51:3">Baa naa kenyaŋee na gyoŋ ɔ man,</para>
  <para style="q2" vid="ISA 51:3">na baa nyii karaŋ kefa na nɔɔneŋ kekpee yeesa.<verse eid="ISA 51:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 51:4" />&lt;&lt;Me balaŋ, ɛ tei maŋ,</para>
  <para style="q2" vid="ISA 51:4">me tɛɛlese, ɛ nyii maŋ.</para>
  <para style="q1" vid="ISA 51:4">Me nombia kawola gyae ka lee me maŋ,</para>
  <para style="q2" vid="ISA 51:4">Me nombia kedi kegbɛɛ dɔɔ gyae ka bese keŋmaŋee fa tɛɛlese ŋan.<verse eid="ISA 51:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 51:5" />Me katenee ne kɔŋ bileŋbileŋ,</para>
  <para style="q2" vid="ISA 51:5">ma nyeekelɛɛ dɔŋ gbɛɛ dɔɔ ne kɔŋ,</para>
  <para style="q2" vid="ISA 51:5">te me doŋ gyae ka mo nombiakedi kegbɛɛ dɔɔ kɔna tɛɛlese.</para>
  <para style="q1" vid="ISA 51:5">Tɛɛlese ŋan loŋ be kilisi ŋa nɛ ne kɛɛ me siaman,</para>
  <para style="q2" vid="ISA 51:5">te be loo gyakaa me doŋ dɔɔ.<verse eid="ISA 51:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 51:6" />Ɛ gyina ɛ sia kɛɛ adido,</para>
  <para style="q2" vid="ISA 51:6">ɛ kɛɛ tɛɛle dɔɔ.</para>
  <para style="q1" vid="ISA 51:6">Adidose gyae ke ŋaalaa ŋgba nyɔɔse nɛ,</para>
  <para style="q2" vid="ISA 51:6">tɛɛle gyae ke tirii ŋgba kanyaŋ nɛ,</para>
  <para style="q2" vid="ISA 51:6">te baŋ be kyaa ke man nɛ baa yekee ŋgba kyɔɔse nɛ.</para>
  <para style="q1" vid="ISA 51:6">Mɔna ma nyeekelɛɛ gyae ke doo kekpaakekpaa,</para>
  <para style="q2" vid="ISA 51:6">te me katenee be gyae ke taŋ ya.<verse eid="ISA 51:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 51:7" />&lt;&lt; Ɛmɛɛ baŋ ɛ gyeŋ keŋ ke doona kegbɛɛ,</para>
  <para style="q2" vid="ISA 51:7">ɛmɛɛ balaŋ baŋ ɛ be lɛɛ me nombia kawola do ɛ konɔɔse man nɛ, ɛ nyii man.</para>
  <para style="q1" vid="ISA 51:7">Ɛ na yele deniwalaŋ ahiŋ nombia ka do ŋon gyakoloŋ,</para>
  <para style="q2" vid="ISA 51:7">yaa be tuubia ke yela ɛ ke seree ya.<verse eid="ISA 51:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 51:8" />Nawolo nyi paapaa waa tao wɔ ŋgba kanyaŋ nɛ,</para>
  <para style="q2" vid="ISA 51:8">feelii waa likii wɔ ŋgba dukurufa mpuu nɛ.</para>
  <para style="q1" vid="ISA 51:8">Mɔna me katenee gyae ke doo kekpaakekpaa,</para>
  <para style="q2" vid="ISA 51:8">ma nyeekelɛɛ doo kelii kalola kegyakaarese man.&gt;&gt;<verse eid="ISA 51:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 51:9" />Degbeŋgyoo doŋ, koro, koro</para>
  <para style="q2" vid="ISA 51:9">mo n doŋ kpaŋ!</para>
  <para style="q1" vid="ISA 51:9">Koro ŋgba weeya akaalaŋaŋ ŋan</para>
  <para style="q2" vid="ISA 51:9">ŋgba gyaŋgba keŋ nɛ.</para>
  <para style="q1" vid="ISA 51:9">Na nyaŋ keretiina Rahabe kpetekpete,</para>
  <para style="q2" vid="ISA 51:9">te n sɔɔ wonembukum ŋon ko yee?<verse eid="ISA 51:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 51:10" />Na nyaŋ yelela te ɛpo,</para>
  <para style="q2" vid="ISA 51:10">na loŋse ŋan dana lee nɛ yoowɔ</para>
  <para style="q1" vid="ISA 51:10">te n lese gbɛɛ ɛpo siiliŋ man</para>
  <para style="q2" vid="ISA 51:10">na baŋ n be lɛɛ wɔ nɛ ka toŋ yee?<verse eid="ISA 51:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 51:11" />Baŋ Degbeŋgyoo be lɛɛ wɔ nɛ baa bese kɔŋ.</para>
  <para style="q2" vid="ISA 51:11">Baa mo nɔɔneŋ gyoo Siyɔn.</para>
  <para style="q2" vid="ISA 51:11">Baa mo kenyaŋee kekpaakekpaa gyooro kotɔtɔɔ wuu ba nyeeya.</para>
  <para style="q1" vid="ISA 51:11">Baa di gyoŋ na baa nyaŋee,</para>
  <para style="q2" vid="ISA 51:11">te waraŋsa kedi na kemutii gyae ke yeu.<verse eid="ISA 51:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 51:12" />&lt;&lt;Maŋ, maŋ yɛna ŋon mɛɛ fɛɛ n wɔe.</para>
  <para style="q2" vid="ISA 51:12">Nyaŋ yɛna amɔte keŋ n ne yee deniwalaŋ,</para>
  <para style="q2" vid="ISA 51:12">deniwalaŋ baŋ be yɛɛ ŋgba ŋale nɛ,<verse eid="ISA 51:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 51:13" />te n wolee Degbeŋgyoo ŋon ɔ be yɛɛ neŋ,</para>
  <para style="q2" vid="ISA 51:13">ŋon ɔ be fɛlɛɛ adidose</para>
  <para style="q2" vid="ISA 51:13">te ɔ ba see tɛɛle mokɔɔ nɛ.</para>
  <para style="q1" vid="ISA 51:13">Te wee kamasɛ na n kyaa gyakoloŋ man</para>
  <para style="q2" vid="ISA 51:13">lee baŋ bɛɛ gyae baa wɔlɛɛ neŋ</para>
  <para style="q2" vid="ISA 51:13">te bɛɛ ŋere neŋ do nɛ baŋ dɔɔ?</para>
  <para style="q1" vid="ISA 51:13">Nde baŋ bɛɛ ŋere neŋ do nɛ baŋ keŋ?<verse eid="ISA 51:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="ISA 51:14" />Be gyae ke di weeya ya baa lese gyakoloŋtena baŋ bɔɔ tɔɔ do deni nɛ,</para>
  <para style="q1" vid="ISA 51:14">bɔɔ gyae baa yeŋ deni kyilimkyilim keŋ man,</para>
  <para style="q2" vid="ISA 51:14">yaa weenɛɛ kebɔ wɔ ya.<verse eid="ISA 51:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 51:15" />Nawolo nyi maŋ yɛna Degbeŋgyoo ɛ Wurubuarɛ,</para>
  <para style="q2" vid="ISA 51:15">ŋon ɔ ne saale ɛpo te kɛɛ gyɔ feliŋ nedoŋ.</para>
  <para style="q2" vid="ISA 51:15">ɔ yele yɛna Degbeŋgyoo Dekpataakpere.<verse eid="ISA 51:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 51:16" />Me ta mo me nombia do n nɔɔman,</para>
  <para style="q2" vid="ISA 51:16">te ma moo me nyiŋmaa wuluŋ wuu neŋ.</para>
  <para style="q1" vid="ISA 51:16">Maŋ yɛɛna adido see ka dedoi man,</para>
  <para style="q2" vid="ISA 51:16">maŋ seena tɛɛle mokɔɔ,</para>
  <para style="q1" vid="ISA 51:16">te me yako Siyɔn nyiaa, &lt;&lt;Ɛmɛɛ yɛna me balaŋ.&gt;&gt;&gt;<verse eid="ISA 51:16" /></para>
  <para style="s1">Degbeŋgyoo baŋ leenɔɔ</para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 51:17" />Foŋ! Foŋ!</para>
  <para style="q2" vid="ISA 51:17">O Yerusalɛm, koro.</para>
  <para style="q1" vid="ISA 51:17">nyaŋ ŋon n be nyɔɔ lee Degbeŋgyoo nyiŋmaa man</para>
  <para style="q2" vid="ISA 51:17">baŋ leenɔɔ keŋ man nɛ,</para>
  <para style="q1" vid="ISA 51:17">nyaŋ ŋon n be nyɔɔ ke kerekere,</para>
  <para style="q2" vid="ISA 51:17">lee leenɔɔ keŋ kee yele balaŋ ne kpaŋte man nɛ.<verse eid="ISA 51:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 51:18" />Ɔ bia baŋ pou ɔ ba lolo man nɛ,</para>
  <para style="q2" vid="ISA 51:18">ŋolo be kyaa keŋ waa wola e gbɛɛ ya,</para>
  <para style="q1" vid="ISA 51:18">bia baŋ pou ɔ be kɛɛle man nɛ,</para>
  <para style="q2" vid="ISA 51:18">ŋolo be kyaa keŋ waa kyaŋ ɔ nyiŋmaa man ya.<verse eid="ISA 51:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 51:19" />Mena kewɔlɛɛ ala kɛŋa yalala n dɔɔ,</para>
  <para style="q2" vid="ISA 51:19">amɔte ne gyaela waa tale fɛɛ n konɔɔ?</para>
  <para style="q1" vid="ISA 51:19">kayeyɛɛ na kewɔlɛɛ, tanam na yoosila,</para>
  <para style="q2" vid="ISA 51:19">amɔte ne gyaela waa tale kolosi do neŋ.<verse eid="ISA 51:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 51:20" />N bia te gbalase,</para>
  <para style="q2" vid="ISA 51:20">Be doo donɔɔ kebɔtala kamasɛ man,</para>
  <para style="q2" vid="ISA 51:20">ŋgba kpelee ŋon kɔta be kyam nɛ,</para>
  <para style="q1" vid="ISA 51:20">Degbeŋgyoo baŋ nedoŋ keŋ te wulu wɔ,</para>
  <para style="q1" vid="ISA 51:20">kpuna n Wurubuarɛ kekalana keŋ.<verse eid="ISA 51:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="ISA 51:21" />Mena dɔɔ nyaŋ ŋon n ne kaa,</para>
  <para style="q2" vid="ISA 51:21">te n be dɛɛse, mɔna n te nyɔɔ waen ya nɛ, nyii kɛbo.<verse eid="ISA 51:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 51:22" />Nnɛ yaa Degbeŋgyoo Doŋ Pou Nyee,</para>
  <para style="q2" vid="ISA 51:22">n Wurubuarɛ ŋon ɔ na seŋ ɔ balaŋ wɔle nɛ, ne yako</para>
  <para style="q1" vid="ISA 51:22">&lt;&lt;Kɛɛ, ma te lɛo</para>
  <para style="q2" vid="ISA 51:22">leenɔɔ keŋ ne yele n ne kpaŋte nɛ lee n nyiŋmaa man,</para>
  <para style="q1" vid="ISA 51:22">n ba tekaa nyɔɔ</para>
  <para style="q2" vid="ISA 51:22">lee me baŋ leenɔɔ keŋ man bela ya.<verse eid="ISA 51:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 51:23" />Maa mo ke do baŋ bɛɛ naase neŋ diyem nɛ nyiŋmaa man,</para>
  <para style="q2" vid="ISA 51:23">Amɔte yakona neŋ nyiaa,</para>
  <para style="q2" vid="ISA 51:23">&lt;Tenee doo tɛɛle man na dɛɛ ta n dɔɔ?&gt;</para>
  <para style="q1" vid="ISA 51:23">Te n yɛɛ n maama ŋgba tɛɛle nɛ,</para>
  <para style="q2" vid="ISA 51:23">ŋgba abɔntere keŋ bɛɛ ta ke dɔɔ nɛ.&gt;<verse eid="ISA 51:23" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="ISA 51" />
  <chapter number="52" style="c" sid="ISA 52" />
  <para style="s1">Wurubuarɛ waa lɛɛ Yerusalɛm</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 52:1" />Foŋ, foŋ, Siyɔn,</para>
  <para style="q2" vid="ISA 52:1">mo doŋ kaa!</para>
  <para style="q2" vid="ISA 52:1">Yerusalɛm, donɔɔ dinaa fereŋkyeŋ,</para>
  <para style="q1" vid="ISA 52:1">mo nyɔ obuo kegba do.</para>
  <para style="q" vid="ISA 52:1">Baŋ ba te kara be baalawose ya, na baŋ bɔɔ waalaa ba wose nɛ,</para>
  <para style="q2" vid="ISA 52:1">be gyae baa gyoo n man bela ya.<verse eid="ISA 52:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 52:2" />Kpiisi aŋasa lee n wose man,</para>
  <para style="q2" vid="ISA 52:2">Yerusalɛm, koro kyaa gyoorogbeli dɔɔ.</para>
  <para style="q1" vid="ISA 52:2">Siyɔn alebu ŋon n doo gbeŋiri man,</para>
  <para style="q2" vid="ISA 52:2">lese agbaragbarase ŋan lee n wɔŋe man.<verse eid="ISA 52:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 52:3" />Nawolo nyi nnɛ yaa Degbeŋgyoo ne yako,</para>
  <para style="q1" vid="ISA 52:3">&lt;&lt;Me yɔɔ ŋon keŋ ma te lɛɛ kolo ya,</para>
  <para style="q2" vid="ISA 52:3">Te na kɔba te maa mo lɛɛ ŋon ya.&gt;&gt;<verse eid="ISA 52:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 52:4" />Nnɛ yaa Degbeŋgyoo Doŋ Pou Nyee ne yako,</para>
  <para style="q1" vid="ISA 52:4">&lt;&lt;Gyaŋgba keŋ na me balaŋ gyuuwɔ ke kyaa Igyipite,</para>
  <para style="q2" vid="ISA 52:4">Kenaŋ wɔle te Asiriyatena ŋere wɔ do.<verse eid="ISA 52:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 52:5" />Te nɛnɛɛ woŋ te me dana kɛbo?&gt;&gt; Degbeŋgyoo torola yako.</para>
  <para style="q1" vid="ISA 52:5">&lt;&lt;Nawolo nyi be ta mo me balaŋ laŋ keŋ ba te yɛɛ kolo ya,</para>
  <para style="q2" vid="ISA 52:5">te baŋ bɛɛ di be dɔɔ nɛ ne kulu wɔ.&gt;&gt; Degbeŋgyoo torola yako.</para>
  <para style="q1" vid="ISA 52:5">&lt;&lt;Te wee kamasɛ na,</para>
  <para style="q2" vid="ISA 52:5">bee kolosi mmusuo nombia tia ma yele.<verse eid="ISA 52:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 52:6" />Mena dɔɔ me balaŋ baa gyeŋ ma yele,</para>
  <para style="q2" vid="ISA 52:6">Mena wee kenaŋ baa gyeŋ nyi,</para>
  <para style="q1" vid="ISA 52:6">maŋ yɛna ŋon mɔɔ kolosi ke see.</para>
  <para style="q2" vid="ISA 52:6">Ayi, ke yɛɛ maŋ.<verse eid="ISA 52:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 52:7" />Kɛɛ mena keŋ baŋ</para>
  <para style="q2" vid="ISA 52:7">bɛɛ mo nombia kpaakpaa kɔŋ nɛ naawɔ kyeo bula dɔɔ,</para>
  <para style="q1" vid="ISA 52:7">Baŋ bee kolosi wosefɛɛreŋ nombia,</para>
  <para style="q2" vid="ISA 52:7">baŋ bɛɛ yako nombia ŋan dei,</para>
  <para style="q2" vid="ISA 52:7">baŋ bɛɛ gyɔ nyeekelɛɛ dekpeŋkpeŋ,</para>
  <para style="q1" vid="ISA 52:7">baŋ bɛɛ yako Siyɔn nyiaa</para>
  <para style="q2" vid="ISA 52:7">&lt;&lt;N Wurubuarɛ ne diina gyoori!&gt;&gt;<verse eid="ISA 52:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 52:8" />Tei! N gyeera te gyina ba woya,</para>
  <para style="q2" vid="ISA 52:8">bɛɛ fae kenyaŋee yeesa.</para>
  <para style="q1" vid="ISA 52:8">Debaŋ keŋ Degbeŋgyoo waa bese kɔŋ Siyɔn nɛ,</para>
  <para style="q2" vid="ISA 52:8">baŋ gbagba baa naa ke na be sia.<verse eid="ISA 52:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 52:9" />Ɛ kpee kenyaŋee nɔɔneŋ,</para>
  <para style="q2" vid="ISA 52:9">ɛmɛɛ Yerusalɛm akyaŋse ŋan ɛ be yɛlɛɛ,</para>
  <para style="q1" vid="ISA 52:9">nawolo nyi Degbeŋgyoo te fɛɛ ɔ balaŋ wɔe,</para>
  <para style="q2" vid="ISA 52:9">ɔ te lɛɛ Yerusalɛm.<verse eid="ISA 52:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 52:10" />Degbeŋgyoo waa gyuusu ɔ nyiŋmaa fereŋkyeŋ keŋ see</para>
  <para style="q2" vid="ISA 52:10">tɛɛlese ŋan pou siaman</para>
  <para style="q1" vid="ISA 52:10">te tɛɛle ɔto pou gyae ke naa,</para>
  <para style="q2" vid="ISA 52:10">de Wurubuarɛ nyeekelɛɛ keŋ.<verse eid="ISA 52:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 52:11" />Ɛ lee, ɛ lee, ɛ lee botɔɔ,</para>
  <para style="q2" vid="ISA 52:11">ɛ naa tina abɔɔ ŋan dana ayimɛɛ ya.</para>
  <para style="q1" vid="ISA 52:11">Ɛmɛɛ baŋ ɛ na seele Degbeŋgyoo ɔsom deni man kuruwaase nɛ,</para>
  <para style="q2" vid="ISA 52:11">ɛ lee ke man na n wose kefaafo.</para>
  <para style="q" vid="ISA 52:11">1 <verse eid="ISA 52:11" /><verse number="12" style="v" sid="ISA 52:12" />Mɔna ɛ be gyae ɛ ke barase lee,</para>
  <para style="q2" vid="ISA 52:12">yaa ɛ ke yeu ya,</para>
  <para style="q1" vid="ISA 52:12">nawolo nyi Degbeŋgyoo waa ta ɛ siaman,</para>
  <para style="q2" vid="ISA 52:12">Iseraetena Wurubuarɛ ŋon waa gyee nideli ŋon.<verse eid="ISA 52:12" /></para>
  <para style="s1">Somere ŋon kaale na ɔ gyoorobiiri</para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 52:13" />Kɛɛ ma somere waa yɛɛ abɔɔ siakekara man<note caller="+" style="fe"><char style="fr" closed="false">52:13 </char><char style="ft" closed="false">Waa nyiŋ ɔ wose</char></note>,</para>
  <para style="q2" vid="ISA 52:13">Waa lɛɛ yele na obuo na maa gyina e adido nideli.<verse eid="ISA 52:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 52:14" />Mena keŋ lee ŋon dɔɔ balaŋ burum wose be gbirisi wɔ,</para>
  <para style="q2" vid="ISA 52:14">ɔ wose naane be wɔlɛɛ kela deniwalaŋ kamasɛ wui,</para>
  <para style="q1" vid="ISA 52:14">te ɔ ta lee deniwalaŋ kamasɛ ya nɛ,<verse eid="ISA 52:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 52:15" />mena dɔɔ, tɛɛlese burum nɔɔ gyae ke doo wɔ,<note caller="+" style="f"><char style="fr" closed="false">52:15 </char></note></para>
  <para style="q2" vid="ISA 52:15">te lee ŋon dɔɔ gyooneŋ baa wuu be nɔɔse.</para>
  <para style="q1" vid="ISA 52:15">Nawolo nyi baa naa keŋ ba te yako wɔ ya nɛ,</para>
  <para style="q2" vid="ISA 52:15">te keŋ be te nyii ya nɛ, baa nyii ke man.<verse eid="ISA 52:15" /></para>
  <para style="b" />
  <chapter eid="ISA 52" />
  <chapter number="53" style="c" sid="ISA 53" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 53:1" />Amɔte lɛɛna de nombia do,</para>
  <para style="q2" vid="ISA 53:1">amɔte te Degbeŋgyoo lese ɔ doŋ wola?<verse eid="ISA 53:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 53:2" />Ɔ beewɔ Degbeŋgyoo siaman ŋgba mena keŋ ŋaale wɔlɛɛ ne tuu nɛ,</para>
  <para style="q2" vid="ISA 53:2">ŋgba mena keŋ lili ne bɛɛ lee tɛɛle dowolo man nɛ.</para>
  <para style="q1" vid="ISA 53:2">Ɔ be dana kyeo yaa obuo na ke gyɔ daa loo ya,</para>
  <para style="q2" vid="ISA 53:2">te mena keŋ ɔ wɔɛ nɛ bɛɛ gyɔɔ daa loo na dɛɛ gyae e ya.<verse eid="ISA 53:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 53:3" />Balaŋ doo e desɛŋ te be bɛɛ e,</para>
  <para style="q2" vid="ISA 53:3">Ɔ yɛɛ baale ŋon ɔ be naa diyem te ɔ be nyii weeleŋ.</para>
  <para style="q1" vid="ISA 53:3">Ŋgba walaŋ ŋon balaŋ ba mo be sia weese e nɛ,</para>
  <para style="q2" vid="ISA 53:3">de bɛɛ e te de te bu e do kolo man ya.<verse eid="ISA 53:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 53:4" />Ampaŋ ɔ moo da weeleŋ,</para>
  <para style="q2" vid="ISA 53:4">te ɔ seele de kaale,</para>
  <para style="q1" vid="ISA 53:4">mɔna de kɛɛ e nyi Wurubuarɛ wɔŋana ɔ deŋele,</para>
  <para style="q1" vid="ISA 53:4">be tuku e te be naase e diyem.<verse eid="ISA 53:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 53:5" />Mɔna de dukum dɔɔ te ba doo e gyamɛɛ,</para>
  <para style="q2" vid="ISA 53:5">de nombiakumɛɛ dɔɔ be naŋa e nideli,</para>
  <para style="q1" vid="ISA 53:5">Ba moo deŋele kewɔŋ keŋ ba mo wosefɛɛreŋ kɔna daa nɛ gyakaa ɔ dɔɔ,</para>
  <para style="q2" vid="ISA 53:5">te ɔ gyamɛɛ man te de nyiŋa kawee kekyɔ.<verse eid="ISA 53:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 53:6" />De popou ta yoo gbɛɛ ŋgba namense nɛ,</para>
  <para style="q2" vid="ISA 53:6">de man walaŋ kamasɛ ta mo ɔ gbɛɛ,</para>
  <para style="q1" vid="ISA 53:6">te Degbeŋgyoo moo de</para>
  <para style="q2" vid="ISA 53:6">nombiakumɛɛ pou gyakaa ɔ dɔɔ.<verse eid="ISA 53:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 53:7" />Ba ŋere e do te be naase e diyem,</para>
  <para style="q2" vid="ISA 53:7">mɔna ɔ te gyuusu ɔ nɔɔ ya,</para>
  <para style="q1" vid="ISA 53:7">ba moo e ŋgba nambu ŋon bee gyu ba kaa ko nɛ,</para>
  <para style="q1" vid="ISA 53:7">ŋgba nam ŋon bɛɛ kɛrɛɛ ɔ wona na sem yididi nɛ,</para>
  <para style="q2" vid="ISA 53:7">mena te ɔ te gyuusu ɔ nɔɔ ya.<verse eid="ISA 53:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 53:8" />Ba ŋere do di ɔ nombia te ba moo e laŋ,</para>
  <para style="q2" vid="ISA 53:8">mɔna ɔ duuluŋman walaŋ ŋolo te famenɛna e ya.</para>
  <para style="q1" vid="ISA 53:8">Nawolo nyi be ta lese e gyu ka ko,</para>
  <para style="q2" vid="ISA 53:8">lee me balaŋ dukum dɔɔ be wɔŋa ɔ deŋele.<verse eid="ISA 53:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 53:9" />Be wula ɔ yebɔɔ kpuna akpanyanyaŋtena,</para>
  <para style="q2" vid="ISA 53:9">te be wuu e kpuna kɔbatena,</para>
  <para style="q1" vid="ISA 53:9">mɔna ɔ te yɛɛ dukum daale,</para>
  <para style="q2" vid="ISA 53:9">yaa dii dekara daale ya.<verse eid="ISA 53:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 53:10" />Mɔna ke yɛɛ Degbeŋgyoo kegyae ke nyi baa naŋ e na waa naa diyem,</para>
  <para style="q2" vid="ISA 53:10">Doo nyi Degbeŋgyoo moo e yɛɛ kedeesa fa dukum,</para>
  <para style="q1" vid="ISA 53:10">mɔna waa naa ɔ duuluŋman balaŋ na ɔ weeya ka bo,</para>
  <para style="q2" vid="ISA 53:10">te waa yɛɛ Degbeŋgyoo kegyaebii.<verse eid="ISA 53:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 53:11" />Ɔ kaale wɔle nɛ,</para>
  <para style="q2" vid="ISA 53:11">waa naa nyeedoŋ keŋmaŋee keŋ, te ɔ wɔe gyae ke fɛɛ e.</para>
  <para style="q1" vid="ISA 53:11">Ɔ nombia kagyeŋ man te ma somere ŋon ɔ tenɛɛ nɛ waa yela balaŋ burum kedi deŋele,</para>
  <para style="q2" vid="ISA 53:11">na waa lɛɛ be nombiakumɛɛ kasolɔ seele.<verse eid="ISA 53:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 53:12" />Mena dɔɔ maa fa e dekyae obuo balaŋ man,</para>
  <para style="q2" vid="ISA 53:12">te ŋon na balaŋ doŋtena baa kpala yoo abɔɔ.</para>
  <para style="q1" vid="ISA 53:12">nawolo nyi ɔ moo ɔ wose see fa yeŋ,</para>
  <para style="q2" vid="ISA 53:12">te be kala e kpuna dukum yɛɛra.</para>
  <para style="q1" vid="ISA 53:12">Nawolo nyi ɔ moo balaŋ nombiakumɛɛ seele,</para>
  <para style="q2" vid="ISA 53:12">te ɔ solawɔ fa balaŋkumɛɛ.<verse eid="ISA 53:12" /></para>
  <chapter eid="ISA 53" />
  <chapter number="54" style="c" sid="ISA 54" />
  <para style="s">Siyɔn wee daale gyoorobiiri</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 54:1" />&lt;&lt;O ɔlamanbo, kpee nɔɔneŋ,</para>
  <para style="q2" vid="ISA 54:1">Nyaŋ ŋon n ta lolo see ya,</para>
  <para style="q1" vid="ISA 54:1">gyoo nɔɔneŋ kekpee na n ke fae kenyaŋee yeesa,</para>
  <para style="q2" vid="ISA 54:1">nyaŋ ŋon n ta doŋee see ya,</para>
  <para style="q1" vid="ISA 54:1">nawolo nyi alo ŋon bɔɔ bɛɛ e nɛ bia boe,</para>
  <para style="q2" vid="ISA 54:1">kela alo ŋon ɔ dana baale,&gt;&gt;</para>
  <para style="q4" vid="ISA 54:1">Degbeŋgyoo yakola.<verse eid="ISA 54:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 54:2" />Fɛlɛɛ n kanyaŋ deni</para>
  <para style="q2" vid="ISA 54:2">wɔŋ n deniman patisanse fɛlɛɛ,</para>
  <para style="q2" vid="ISA 54:2">naa bɔ ke do ya</para>
  <para style="q1" vid="ISA 54:2">yela n ŋmeleŋ ke yɛɛ dɔɔloŋ</para>
  <para style="q2" vid="ISA 54:2">yela nya akparadaase ke yɛɛ doŋ.<verse eid="ISA 54:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 54:3" />Nawolo nyi n ke fɛlɛɛ gyu dunoluŋ na demena,</para>
  <para style="q2" vid="ISA 54:3">n duuluŋman balaŋ baa gegi tɛɛlese,</para>
  <para style="q1" vid="ISA 54:3">na baa kyaa be donɔɔse dinaana ŋan bɔɔ yɛlɛɛ nɛ man.<verse eid="ISA 54:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 54:4" />&lt;&lt;Na yee ya, desɛŋ be gyae kekyaŋ neŋ ya.</para>
  <para style="q2" vid="ISA 54:4">Na yee desɛŋ ya, bɔɔ gyae baa wuritii neŋ bela ya.</para>
  <para style="q1" vid="ISA 54:4">N ke wolee nyaŋ alebiiritɛɛ desɛŋ</para>
  <para style="q2" vid="ISA 54:4">te n be gyae n ke tɔɔse n wose kekyaŋ debaŋ keŋ n yɛɛ lialo e nɛ bela ya.<verse eid="ISA 54:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 54:5" />Nawolo nyi n yɛɛre yɛna n baale,</para>
  <para style="q2" vid="ISA 54:5">Degbeŋgyoo Dekpaatakpere yɛna ɔ yele,</para>
  <para style="q1" vid="ISA 54:5">n lɛɛre yɛna Iseraetena Fereŋkyeŋte ŋon,</para>
  <para style="q2" vid="ISA 54:5">ɔ yele yɛna tɛɛle pou Wurubuarɛ.<verse eid="ISA 54:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 54:6" />Degbeŋgyoo waa bese baake neŋ kɔŋ,</para>
  <para style="q2" vid="ISA 54:6">ŋgba alo yalale ŋon bɔɔ bɛɛ e, te wa awoya man be tekerii e nɛ,</para>
  <para style="q1" vid="ISA 54:6">ŋgba alebu ŋon bɔɔ yala e,</para>
  <para style="q2" vid="ISA 54:6">te ɔ baale be tina e yela nɛ&gt;&gt; N Wurubuarɛ yakola.<verse eid="ISA 54:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 54:7" />&lt;&lt;Me yela neŋ debaŋ kyomii,</para>
  <para style="q2" vid="ISA 54:7">mɔna maa mo me waraŋase kewii besena neŋ kɔŋ.<verse eid="ISA 54:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 54:8" />Me baŋkum keŋ man,</para>
  <para style="q2" vid="ISA 54:8">te ma moo me sia weese neŋ kyomii,</para>
  <para style="q1" vid="ISA 54:8">mɔna kegyae kekpaakekpaa keŋ dɔɔ</para>
  <para style="q2" vid="ISA 54:8">maa wii neŋ,&gt;&gt;</para>
  <para style="q2" vid="ISA 54:8">Degbeŋgyoo n lɛɛre ŋon yakola.<verse eid="ISA 54:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 54:9" />Kei ne yɛɛ maŋ ŋgba Nowa debaŋ keŋ nɛ,</para>
  <para style="q2" vid="ISA 54:9">keŋ mɔɔ kaŋ ntam nyi loŋ be gyae ka tekaa wuu tɛɛle bela ya nɛ.</para>
  <para style="q1" vid="ISA 54:9">Mena te me kaŋa ntam nyi mɔɔ gyae ma tekaa gyeŋ baŋ do neŋ ya,</para>
  <para style="q2" vid="ISA 54:9">mɔɔ gyae maa kalana neŋ bela ya.<verse eid="ISA 54:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 54:10" />Nyi akpaa bulase de wosi,</para>
  <para style="q2" vid="ISA 54:10">te bulasebia de kulii koraŋ nɛ,</para>
  <para style="q1" vid="ISA 54:10">ma kegyae keŋ taŋ ɔto ya nɛ be gyae ke wosi,</para>
  <para style="q" vid="ISA 54:10">yaa ma lese ma wosefɛɛreŋ nɔɔkebakesee keŋ ya.&gt;&gt;</para>
  <para style="q2" vid="ISA 54:10">Degbeŋgyoo ŋon ɔ ne wii neŋ nɛ yakola.<verse eid="ISA 54:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 54:11" />O donɔɔ dinaa keŋ n be naa diyem te feliŋ be gyɔ neŋ te ŋolo te fɛɛ n wɔe ya,</para>
  <para style="q2" vid="ISA 54:11">maa bese desina mo boya koyadoŋ nyiŋan <note caller="+" style="fe"><char style="fr" closed="false">54:11 </char><char style="ft" closed="false">Boya ŋenaŋ yele yɛna tɛkuise.</char></note> baŋ neŋ</para>
  <para style="q2" vid="ISA 54:11">na maa mo Lapise lasuli boe see n mokɔɔ<verse eid="ISA 54:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 54:12" />Maa mo boya yayama koyadoŋ nyiŋan ma n dekagya nyeeman,</para>
  <para style="q2" vid="ISA 54:12">maa mo boya ŋan ne ŋalakee nɛ yɛɛ nya anaanɔɔse,</para>
  <para style="q1" vid="ISA 54:12">na maa mo boya koyadoŋ nyiŋan baŋ nya akyaŋse.<verse eid="ISA 54:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 54:13" />N bia pou baa yɛɛ Degbeŋgyoo kaseera,</para>
  <para style="q2" vid="ISA 54:13">Te ba wosefɛɛreŋ gyae ka bo nideli.<verse eid="ISA 54:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 54:14" />N ka seŋ keŋkeŋ katenee man,</para>
  <para style="q2" vid="ISA 54:14">baŋ bɛɛ ŋere balaŋ do nɛ ba kyaa naŋ lem lee n gyaŋ.</para>
  <para style="q1" vid="ISA 54:14">n be gyae n ke yee kolo ya.</para>
  <para style="q2" vid="ISA 54:14">gyakoloŋ gyae ke kyaa naŋ lem,</para>
  <para style="q1" vid="ISA 54:14">ka be gyae kaa benaa neŋ ya.<verse eid="ISA 54:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 54:15" />Akpaa ŋolo de gyae neŋ kale na, na maŋ kpilana e ya.</para>
  <para style="q2" vid="ISA 54:15">ŋon ɔ gyae neŋ kale na, n ke di ɔ dɔɔ.<verse eid="ISA 54:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 54:16" />Kɛɛ, maŋ yɛɛna nyeelaluure,</para>
  <para style="q2" vid="ISA 54:16">ŋon ɔ ne feefu nyewalaŋ te kɛɛ kpaa,</para>
  <para style="q2" vid="ISA 54:16">te ɔ ne luu yoo abɔɔ ŋan ne hia fa ɔ tom,</para>
  <para style="q1" vid="ISA 54:16">Te maŋ yɛɛna wɔlɛɛre ŋon nyi waa wɔlɛɛ abɔɔ.<verse eid="ISA 54:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="ISA 54:17" />Yoo abɔɔ kamasɛ keŋ baa luu tia neŋ be gyae ke de ya,</para>
  <para style="q2" vid="ISA 54:17">te nyaŋ ke bu laakem kamasɛ keŋ gyae ka koro seŋ tia neŋ nombia dedii man nɛ fɔɔ.</para>
  <para style="q1" vid="ISA 54:17">Kei yɛna Degbeŋgyoo somera dedii,</para>
  <para style="q2" vid="ISA 54:17">te kei yɛna be deŋele kedi lee me gyaŋ.&gt;&gt; Degbeŋgyoo torola yako.<verse eid="ISA 54:17" /></para>
  <chapter eid="ISA 54" />
  <chapter number="55" style="c" sid="ISA 55" />
  <para style="s1">Ba kebaake baŋ loŋboaneŋ na ko wɔ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 55:1" />&lt;&lt;Ɛ kɔŋ, ɛmɛɛ baŋ pou loŋboaneŋ na ko ŋon,</para>
  <para style="q2" vid="ISA 55:1">ɛ kɔŋ loŋse ŋan gyaŋ,</para>
  <para style="q1" vid="ISA 55:1">ɛmɛɛ baŋ ɛ be dana kɔba ya,</para>
  <para style="q2" vid="ISA 55:1">ɛ kɔŋ kaa lɛɛ na ɛ ke di!</para>
  <para style="q1" vid="ISA 55:1">Ɛ kɔŋ kaa lɛɛ waen na miliki</para>
  <para style="q2" vid="ISA 55:1">bɔɔ na mo kɔba lɛɛ ya, te kɔɔ dana koya ya.<verse eid="ISA 55:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 55:2" />Weera dɔɔ te ɛ ne wɔlɛɛ kɔba abɔɔ ŋan te yɛɛ weenɛɛ ya nɛ dɔɔ,</para>
  <para style="q2" vid="ISA 55:2">te ɛ ne kaa lɛɛ abɔɔ ŋan be gyae ke baa ŋon ya?</para>
  <para style="q1" vid="ISA 55:2">Ɛ tei, ɛ tei maŋ na ɛ ke di weenɛɛ kpaakpaa,</para>
  <para style="q2" vid="ISA 55:2">te ɛ sia gyae ka gye nideli.<verse eid="ISA 55:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 55:3" />Ɛ see deŋele na ɛ ke kɔŋ me gyaŋ,</para>
  <para style="q2" vid="ISA 55:3">ɛ tei na ɛ ke nyiŋ nyeedoŋ.</para>
  <para style="q1" vid="ISA 55:3">Maa bakenɔɔ kekpaakekpaa na ŋon,</para>
  <para style="q2" vid="ISA 55:3">ma anokoare kegyae keŋ mɔɔ yakosee fa Dawide nɛ.<verse eid="ISA 55:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 55:4" />Kɛɛ, ma te yɛɛ e adansɛɛte fa balaŋ baŋ,</para>
  <para style="q2" vid="ISA 55:4">balaŋ baŋ siamante na yoonɔɔ siamante.<verse eid="ISA 55:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 55:5" />Kɛɛ, n ke yilaa tɛɛlese baŋ n ba gyeŋ wɔ ya nɛ,</para>
  <para style="q2" vid="ISA 55:5">te tɛɛlese ŋan n ba gyeŋ ya nɛ baa yeu kɔŋ n gyaŋ,</para>
  <para style="q1" vid="ISA 55:5">lee Degbeŋgyoo n Wurubuarɛ,</para>
  <para style="q2" vid="ISA 55:5">Iseraetena fereŋkyeŋte ŋon dɔɔ,</para>
  <para style="q2" vid="ISA 55:5">nawolo nyi ŋon faana neŋ wosekenyiŋ.&gt;&gt;<verse eid="ISA 55:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 55:6" />Ɛ kɛo Degbeŋgyoo debaŋ keŋ ɛ ke naa e,</para>
  <para style="q2" vid="ISA 55:6">ɛ baake e debaŋ keŋ ɔ benaa.<verse eid="ISA 55:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 55:7" />Akpanyanyaŋtena baa yela be gbɛɛneŋ,</para>
  <para style="q2" vid="ISA 55:7">na baŋ bɔɔ tenɛɛ ya nɛ ke kyɛɛkee ba nyeempɔ.</para>
  <para style="q1" vid="ISA 55:7">Baa bese kɔŋ Degbeŋgyoo gyaŋ na waa wii be waraŋase,</para>
  <para style="q2" vid="ISA 55:7">na de Wurubuarɛ gyaŋ, nawolo nyi waa mo kyɛɛ wɔ faa.<verse eid="ISA 55:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 55:8" />Nawolo nyi ma nyeempɔ te yɛɛ yaa nyeempɔ ya.</para>
  <para style="q2" vid="ISA 55:8">ɛ gbɛɛneŋ te yɛɛ me gbɛɛneŋ ya,&gt;&gt;</para>
  <para style="q4" vid="ISA 55:8">Degbeŋgyoo torola yako.<verse eid="ISA 55:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 55:9" />&lt;&lt;Mena keŋ adido korɛɛ kela tɛɛle nɛ,</para>
  <para style="q2" vid="ISA 55:9">mena ke te me gbɛɛneŋ kela ɛ gbɛɛneŋ</para>
  <para style="q1" vid="ISA 55:9">te ma nyeempɔ kela yaa nyeempɔ.<verse eid="ISA 55:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 55:10" />Mena keŋ ɔga na senoo</para>
  <para style="q2" vid="ISA 55:10">na lee adido kaa yala,</para>
  <para style="q1" vid="ISA 55:10">te ke bɛɛ bese gyu bela ya</para>
  <para style="q" vid="ISA 55:10">mɔna kɛɛ fɔ tɛɛle,</para>
  <para style="q" vid="ISA 55:10">na abɔɔ te tuu na ŋa te dee,</para>
  <para style="q2" vid="ISA 55:10">na ka see bia fa wɔɔ farale na weenɛɛ anediŋ fa diiri nɛ,<verse eid="ISA 55:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 55:11" />mena te nombia ŋan na lee me nɔɔman nɛ doo.</para>
  <para style="q2" vid="ISA 55:11">Ka be gyae ka bese kɔŋ me gyaŋ yakaa ya,</para>
  <para style="q1" vid="ISA 55:11">mɔna ke gyae ke yɛɛ keŋ mɛɛ gyae,</para>
  <para style="q2" vid="ISA 55:11">na ke yɛɛ keŋ dɔɔ mɔɔ kpila ke nɛ.<verse eid="ISA 55:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 55:12" />Ɛ ka mo kenyaŋee lee,</para>
  <para style="q2" vid="ISA 55:12">baa ta ɛ siaman wosefɛɛreŋ man,</para>
  <para style="q1" vid="ISA 55:12">bulase na bulasebia,</para>
  <para style="q2" vid="ISA 55:12">baa lɔ nɔɔneŋ ɛ siaman,</para>
  <para style="q1" vid="ISA 55:12">na ŋale man daase pou</para>
  <para style="q2" vid="ISA 55:12">ke gyɔ ŋe nyiŋmaase.<verse eid="ISA 55:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 55:13" />Yunipa daase gyae ke tuu kpaŋkpaŋkorolo naawɔ man,</para>
  <para style="q2" vid="ISA 55:13">te kpeli daase gyae ka seŋ kpalamse naawɔ man.</para>
  <para style="q1" vid="ISA 55:13">Kei gyae ke yɛɛ yele fa Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 55:13">na ka ke yɛɛ kagyene kekpaakekpaa,</para>
  <para style="q2" vid="ISA 55:13">keŋ ka be wɔlɛɛ korakora ya.&gt;&gt;<verse eid="ISA 55:13" /></para>
  <chapter eid="ISA 55" />
  <chapter number="56" style="c" sid="ISA 56" />
  <para style="s1">Baale nyeekelɛɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 56:1" />Nnɛ yaa Degbeŋgyoo ne yako,</para>
  <para style="q1" vid="ISA 56:1">&lt;&lt; Ɛ di nombia kegbɛɛ dɔɔ,</para>
  <para style="q2" vid="ISA 56:1">na ɛ ke yɛɛ keŋ doona kegbɛɛ,</para>
  <para style="q1" vid="ISA 56:1">nawolo nyi ma nyeekelɛɛ ta benaa</para>
  <para style="q2" vid="ISA 56:1">be gyae ke kyare ya maa lese me katenee wola.<verse eid="ISA 56:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 56:2" />Ŋon ɔ ne yɛɛ abɔɔ kɛŋa nɛ,</para>
  <para style="q1" vid="ISA 56:2">walaŋ ŋon ɔ dana ŋe man keŋkeŋ,</para>
  <para style="q2" vid="ISA 56:2">ŋon ɔ ne di ma kefɛɛfowee dɔɔ keŋ ɔ bɛɛ waalaa ke ya,</para>
  <para style="q1" vid="ISA 56:2">te ɔ nyiŋmaa bɛɛ yɛɛ dukum ya nɛ, ŋonna nyeebam.<verse eid="ISA 56:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 56:3" />Ŋɔɔle ŋon ɔ ba mo ɔ wose fa Degbeŋgyoo nɛ naa yako nyiaa,</para>
  <para style="q2" vid="ISA 56:3">&lt;&lt;Kalese te Degbeŋgyoo waa lese maŋ lee ɔ balaŋ man ya.&gt;&gt;</para>
  <para style="q1" vid="ISA 56:3">Saayɛte naa toroŋ nyiaa,</para>
  <para style="q2" vid="ISA 56:3">&lt;&lt;Me yɛɛ daŋ dowolo ke ya.&gt;&gt;<verse eid="ISA 56:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 56:4" />Nawolo nyi nnɛ yaa Degbeŋgyoo ne yako,</para>
  <para style="q1" vid="ISA 56:4">&lt;&lt;Saayɛtena baŋ be di ma kefɛɛfowee dɔɔ,</para>
  <para style="q2" vid="ISA 56:4">te ɔ ba lese keŋ na gyoo me sia,</para>
  <para style="q2" vid="ISA 56:4">te be di me nɔɔkebakesee dɔɔ nɛ,<verse eid="ISA 56:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 56:5" />maa fa wɔ ketɔɔse kolo na yele,</para>
  <para style="q2" vid="ISA 56:5">mɔ ɔsom deni dinaa keŋ man na ka akyaŋse dɔɔ,</para>
  <para style="q2" vid="ISA 56:5">keŋ dei kela bia alebia na bia tewulɛɛ.</para>
  <para style="q1" vid="ISA 56:5">Maa fa wɔ yele keŋ gyae ke doo kekpaakekpaa,</para>
  <para style="q2" vid="ISA 56:5">te ka be gyae ka yo ya.<verse eid="ISA 56:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 56:6" />Te ŋɔɔla baŋ bɔɔ mo ba wose lɔɔ Degbeŋgyoo dɔɔ,</para>
  <para style="q2" vid="ISA 56:6">nyi baa som e,</para>
  <para style="q1" vid="ISA 56:6">na baa gyae Degbeŋgyoo yele,</para>
  <para style="q2" vid="ISA 56:6">na baa yɛɛ ɔ somera nɛ,</para>
  <para style="q1" vid="ISA 56:6">baŋ pou bɛɛ di kefɛɛfowee keŋ dɔɔ keŋ bɔɔ ne waalaa ke ya,</para>
  <para style="q1" vid="ISA 56:6">te bɔɔ kyaŋ me nɔɔkebakesee keŋ man keŋkeŋ nɛ,<verse eid="ISA 56:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 56:7" />baŋ te maa mo kɔŋ me bula fereŋkyeŋ keŋ dɔɔ,</para>
  <para style="q2" vid="ISA 56:7">na maa fa wɔ kenyaŋee me kefane deni man,</para>
  <para style="q1" vid="ISA 56:7">Be katoo kedeesase na ba kedeesase</para>
  <para style="q2" vid="ISA 56:7">gyae ka gyoo me sia ma kedeesaboe keŋ dɔɔ.</para>
  <para style="q1" vid="ISA 56:7">nawolo nyi baa baake mɔ ɔsom deni dinaa keŋ nyi,</para>
  <para style="q2" vid="ISA 56:7">kefane deni fa tɛɛlese pou.&gt;&gt;<verse eid="ISA 56:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 56:8" />Degbeŋgyoo Doŋ Pou Nyee,</para>
  <para style="q2" vid="ISA 56:8">ŋon ɔ be yilaa Iserae yoogbeŋa nɛ ta toro yako nyiaa,</para>
  <para style="q1" vid="ISA 56:8">&lt;&lt;Maa bese yilaa baale fa wɔ,</para>
  <para style="q2" vid="ISA 56:8">mo kpuna baŋ mɔɔ wulaa yilaa nɛ.&gt;&gt;<verse eid="ISA 56:8" /></para>
  <para style="s1">Wurubuarɛ waa wɔŋ akpanyanyaŋtena deŋele</para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 56:9" />Ɛmɛɛ ŋale man wonembia pou, ɛ kɔŋ,</para>
  <para style="q2" vid="ISA 56:9">ɛmɛɛ laaman wonembia pou, ɛ kaa tao!<verse eid="ISA 56:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 56:10" />Iseraetena gyeera sia te yɛlɛɛ,</para>
  <para style="q2" vid="ISA 56:10">be popou ba gyeŋ nombia ya,</para>
  <para style="q1" vid="ISA 56:10">be popou yɛɛ babaase baŋ be nɔɔse be wuu,</para>
  <para style="q2" vid="ISA 56:10">bɔɔ ne tale gbesi ya,</para>
  <para style="q1" vid="ISA 56:10">bee doo doosi</para>
  <para style="q2" vid="ISA 56:10">dosoroŋ dana wɔ gyoŋ.<verse eid="ISA 56:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 56:11" />Be yɛɛ babaase baŋ be dana kedikum,</para>
  <para style="q2" vid="ISA 56:11">bɔɔ ne baa ya.</para>
  <para style="q1" vid="ISA 56:11">Be yɛɛ namensekɛɛlera baŋ bɔɔ ne nyii nombia man ya,</para>
  <para style="q2" vid="ISA 56:11">be popou te kpase mo be gbɛɛ,</para>
  <para style="q2" vid="ISA 56:11">ɔ kamasɛ ne gyae waageŋ wui bo.<verse eid="ISA 56:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 56:12" />Bɛɛ baake dɔŋa nyiaa, &lt;&lt;Ɛ kɔŋ na de kaa gyae waen!</para>
  <para style="q2" vid="ISA 56:12">Ɛ yela dɛɛ nyɔɔ soloŋ doŋte baa!</para>
  <para style="q1" vid="ISA 56:12">Kyoo gyae ke yɛɛ ŋgba gyɛŋ nɛ,</para>
  <para style="q2" vid="ISA 56:12">yaa gyae ke de kela koraŋ&gt;&gt;<verse eid="ISA 56:12" /></para>
  <chapter eid="ISA 56" />
  <chapter number="57" style="c" sid="ISA 57" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 57:1" />Ŋon ɔ tenɛɛ ne munu,</para>
  <para style="q2" vid="ISA 57:1">te ŋolo be famenɛ ya,</para>
  <para style="q1" vid="ISA 57:1">balaŋ kpaakpaa na yem,</para>
  <para style="q2" vid="ISA 57:1">te ŋolo bee nyii ke man,</para>
  <para style="q1" vid="ISA 57:1">nyi ŋon ɔ tenɛɛ na yem baa,</para>
  <para style="q2" vid="ISA 57:1">na ka lese e lee dukum man ya.<verse eid="ISA 57:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 57:2" />Baŋ be dɔŋ katenee gbɛɛ,</para>
  <para style="q2" vid="ISA 57:2">na gyoo wosefɛɛreŋ man,</para>
  <para style="q2" vid="ISA 57:2">nyi ba yem na, bee nyiŋ kefɛɛfo.<verse eid="ISA 57:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 57:3" />&lt;&lt;Mɔna ɛmɛɛ yola bia, ɛ kɔŋ</para>
  <para style="q2" vid="ISA 57:3">ɛmɛɛ kafoŋtena na futoolitena duuluŋman bia,<verse eid="ISA 57:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 57:4" />Amɔte yaa ɛ ne kulu?</para>
  <para style="q2" vid="ISA 57:4">te amɔte yaa ɛ wola ɛ nɔɔ tee,</para>
  <para style="q2" vid="ISA 57:4">te ɛ wɔŋa ɛ laakem lese mena?</para>
  <para style="q1" vid="ISA 57:4">Ɛ te yɛɛ baŋ bɛɛ koro seŋ tia balaŋ,</para>
  <para style="q2" vid="ISA 57:4">na akɛrɛɛtena duuluŋman biawɔ yee?<verse eid="ISA 57:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 57:5" />Ɛmɛɛ baŋ ɛ dana lookum, te ɛ ne doona dɔŋa kpeli daŋ</para>
  <para style="q2" vid="ISA 57:5">na daŋ keŋ ke dana wuluŋ nɛ tɛɛ,</para>
  <para style="q1" vid="ISA 57:5">ɛ na mo ɛ bia deesi detaŋgyase man,</para>
  <para style="q2" vid="ISA 57:5">na kpanaŋse tɛɛ<verse eid="ISA 57:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 57:6" />Ɛ dedii yɛna bɛɛneŋ baŋ be doo boya akyalasesa na detaŋgyase ŋan man nɛ,</para>
  <para style="q2" vid="ISA 57:6">ŋan yɛna ɛ dedii,</para>
  <para style="q1" vid="ISA 57:6">Ayi, baŋ te ɛ woli soloŋ fa,</para>
  <para style="q2" vid="ISA 57:6">te ɛ yɛɛ weenɛɛ kedeesa fa.</para>
  <para style="q2" vid="ISA 57:6">Kɛŋa pou wɔle na, maa nyiŋ konɔɔ?<verse eid="ISA 57:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 57:7" />N lɔɔ n dofoŋoŋ bulabii keŋ ka korɛɛ nɛ nyeeman,</para>
  <para style="q2" vid="ISA 57:7">botɔɔ te n gyeŋawɔ gyu ke yɛɛ n kedeesase.<verse eid="ISA 57:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 57:8" />N moo n bɛɛneŋ abɔɔ,</para>
  <para style="q2" vid="ISA 57:8">see nya asima na asima daase wɔle.</para>
  <para style="q1" vid="ISA 57:8">N te bɛɛ maŋ te n lese n wose deteŋteli,</para>
  <para style="q2" vid="ISA 57:8">n gyeŋawɔ doo ke dɔɔ te n fɛlɛɛ ke,</para>
  <para style="q1" vid="ISA 57:8">n yɛɛ nɔɔna baŋ n ne gyae wɔ dedoi nɛ,</para>
  <para style="q2" vid="ISA 57:8">te n mo n lookum kɛɛ be deteŋteli.<verse eid="ISA 57:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 57:9" />N moo nuŋ gyu <note caller="+" style="fe"><char style="fr" closed="false">57:9 </char><char style="ft" closed="false">Gyuuna gyoo</char></note>Molɛke</para>
  <para style="q2" vid="ISA 57:9">te n yelaa n nuŋ ofoŋnyiŋan boowɔ.</para>
  <para style="q1" vid="ISA 57:9">N kpila n kpilara gyu <note caller="+" style="fe"><char style="fr" closed="false">57:9 </char><char style="ft" closed="false">Bɛɛneŋ</char></note> lemlem,</para>
  <para style="q2" vid="ISA 57:9">te n tisiwɔ gyu keliinaŋ woya dɛɛ.<verse eid="ISA 57:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 57:10" />N tɛɛwɔ kyeŋgbeŋ mena dɔɔ n te kaa,</para>
  <para style="q2" vid="ISA 57:10">mɔna n te yako nyi,&lt;&lt;Kɔɔ dana tɔnɔɔ ya.&gt;&gt;</para>
  <para style="q1" vid="ISA 57:10">N ta bese nyiŋ wosedoŋ bela,</para>
  <para style="q2" vid="ISA 57:10">mena dɔɔ n te gbalase ya.<verse eid="ISA 57:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 57:11" />&lt;&lt;Amɔte ŋmaasena neŋ te n yeewɔ,</para>
  <para style="q2" vid="ISA 57:11">beiŋ keŋ n te yako maŋ anokoare ya,</para>
  <para style="q1" vid="ISA 57:11">te n te tɔɔse maŋ</para>
  <para style="q2" vid="ISA 57:11">yaa n ka gyueŋ me nombia ya?</para>
  <para style="q1" vid="ISA 57:11">Na keŋ mɔɔ yɛɛ yididi kyare dɔɔ</para>
  <para style="q2" vid="ISA 57:11">te n bee yee maŋ yee?<verse eid="ISA 57:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 57:12" />Maa lese n katenee na n tomse debɔɔ,</para>
  <para style="q2" vid="ISA 57:12">te ŋɔɔ gyae ke yɛɛ tɔnɔɔ fa neŋ ya.<verse eid="ISA 57:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 57:13" />Nyi akpaa n fae yeesa nyi baa kyɔ neŋ nɛ,</para>
  <para style="q2" vid="ISA 57:13">yela n bɛɛneŋ baŋ n be yilaa see nɛ kaa lɛɛ neŋ!</para>
  <para style="q1" vid="ISA 57:13">Feliŋ gyae kegyɔ mo wɔ pou laŋ,</para>
  <para style="q2" vid="ISA 57:13">weesɛɛ pampa gyae ka moo wɔ laŋ.</para>
  <para style="q1" vid="ISA 57:13">Mɔna ŋon ɔ yeu kaa gyoo maŋ na,</para>
  <para style="q2" vid="ISA 57:13">waa mo tɛɛle keŋ bese ɔ dedii,</para>
  <para style="q2" vid="ISA 57:13">na waa mo me bula fereŋkyeŋ keŋ bese ɔ wui.&gt;&gt;<verse eid="ISA 57:13" /></para>
  <para style="s1">Wɔe kefɛɛ fa ŋon ɔ dukum ba wee e</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 57:14" />Degbeŋgyoo waa yako nyiaa,</para>
  <para style="q1" vid="ISA 57:14">&lt;&lt;Ɛ fara, ɛ fara, ɛ desina gbɛɛ keŋ!</para>
  <para style="q2" vid="ISA 57:14">Ɛ lese abɔɔ ŋan ne tɔ gbɛɛ nɛ lee me balaŋ gbɛɛneŋ man.&gt;&gt;<verse eid="ISA 57:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 57:15" />Nawolo nyi nnɛ yaa ŋon ɔ kerɛɛ te bɔɔ gyina e adido nɛ ne yako,</para>
  <para style="q2" vid="ISA 57:15">ŋon ɔ kyaa kekpaakekpaa te ɔ yele yɛna Fereŋkyeŋ nɛ.</para>
  <para style="q1" vid="ISA 57:15">&lt;&lt;Me kyaa adido na botɔɔ keŋ yɛɛ Fereŋkyeŋ,</para>
  <para style="q2" vid="ISA 57:15">mɔna me kyaa kpuna ŋon ɔ dukum ba wee e, te ɔ be yɔkɔse ɔ wose nɛ.</para>
  <para style="q1" vid="ISA 57:15">nyi maa do ŋon ɔ be yɔkɔse ɔ wose nɛ doŋ,</para>
  <para style="q2" vid="ISA 57:15">na maa do baŋ be dukum ba wee wɔ nɛ doŋ bela.<verse eid="ISA 57:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 57:16" />Mɔɔ gyae maa kalana wɔ kekpaakekpaa,</para>
  <para style="q2" vid="ISA 57:16">yaa maa gyeŋ baŋ do wɔ debaŋ kamasɛ ya.</para>
  <para style="q1" vid="ISA 57:16">Na mena ya na balaŋ baŋ maŋ gbagba be yɛɛ nɛ</para>
  <para style="q2" vid="ISA 57:16">baa gbalase lee maŋ dɔɔ.<verse eid="ISA 57:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 57:17" />Ma gyeŋa baŋ do wɔ lee be sibiikum dɔɔ,</para>
  <para style="q1" vid="ISA 57:17">me wɔŋa ba deŋele te ma moo me sia weese wɔ lee me baŋ man.</para>
  <para style="q2" vid="ISA 57:17">mɔna be gyakaa be dɔŋ be gbɛɛneŋ kumɛɛ dɔɔ.<verse eid="ISA 57:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 57:18" />Maa te naa be gbɛɛneŋ, mɔna maa kyɔ wɔ be kaweese.</para>
  <para style="q2" vid="ISA 57:18">Maa wola wɔ gbɛɛ na maa bese fɛɛ Iseraetena baŋ bee di waraŋsa nɛ wɔe.<verse eid="ISA 57:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="ISA 57:19" />Maa mo yele kalese do be nɔɔse man.</para>
  <para style="q1" vid="ISA 57:19">Wosefɛɛreŋ, wosefɛɛreŋ dɛɛ kyaana baŋ ba benaa na baŋ be kyaa lemlem&gt;&gt;</para>
  <para style="q2" vid="ISA 57:19">Degbeŋgyoo yakola,</para>
  <para style="q1" vid="ISA 57:19">&lt;&lt;Na maa kyɔ wɔ be kaweese.&gt;&gt;<verse eid="ISA 57:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 57:20" />Mɔna akpanyanyaŋtena wɔɛ ŋgba ɛpo dɔɔ feliŋ,</para>
  <para style="q2" vid="ISA 57:20">keŋ be tale fɛɛfo ya,</para>
  <para style="q2" vid="ISA 57:20">te ke feliŋ ne gyɔɔ lese woŋsila na ayimɛɛ see yenaŋ nɛ.<verse eid="ISA 57:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 57:21" />Me Wurubuarɛ kpa nyiaa, &lt;&lt;Wosefɛɛreŋ be doo fa akpanyanyaŋte ya.&gt;&gt;<verse eid="ISA 57:21" /></para>
  <chapter eid="ISA 57" />
  <chapter number="58" style="c" sid="ISA 58" />
  <para style="s1">Nɔɔkebake kpaakpaate</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 58:1" />Degbeŋgyoo kpa nyiaa &lt;&lt;Baake keŋkeŋ, naa tina yela ya.</para>
  <para style="q1" vid="ISA 58:1">Gyina n woya ŋgba kaberɛ nɛ.</para>
  <para style="q1" vid="ISA 58:1">Toro me balaŋ deŋele doŋ nombia,</para>
  <para style="q2" vid="ISA 58:1">na Yakɔbe duuluŋman balaŋ dukum yako wɔ.<verse eid="ISA 58:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 58:2" />Bɛɛ kɛo maŋ wee kamasɛ,</para>
  <para style="q2" vid="ISA 58:2">bɛɛ yɛɛ ŋgba bɛɛ gyae baa gyeŋ me gbɛɛneŋ nɛ,</para>
  <para style="q1" vid="ISA 58:2">ŋgba tɛɛle keŋ kɛɛ yɛɛ keŋ ke doona kegbɛɛ,</para>
  <para style="q2" vid="ISA 58:2">te ba te bɛɛ be Wurubuarɛ mmaraase ya nɛ.</para>
  <para style="q1" vid="ISA 58:2">Bɛɛ gyae nombia kedi na kegbɛɛ dɔɔ lee me gyaŋ</para>
  <para style="q2" vid="ISA 58:2">te bɛɛ yɛɛ ŋgba bɛɛ gyae Wurubuarɛ ka benaa wɔ nɛ.<verse eid="ISA 58:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 58:3" />Bɛɛ yako nyiaa, &lt;Weera dɔɔ te de bake de nɔɔ,</para>
  <para style="q2" vid="ISA 58:3">te n te naa ya?</para>
  <para style="q1" vid="ISA 58:3">Woŋ dɔɔ te de yɔkɔse da wose,</para>
  <para style="q2" vid="ISA 58:3">te n ta gyene ya.&gt;</para>
  <para style="b" vid="ISA 58:3" />
  <para style="q1" vid="ISA 58:3">&lt;&lt; Mɔna wee keŋ ɛ be bake ɛ nɔɔ nɛ, ɛ ne yɛɛ keŋ ɛ ne gyae bo</para>
  <para style="q2" vid="ISA 58:3">te ɛ na ŋere ɛ tom yɛɛra pou do.<verse eid="ISA 58:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 58:4" />Kale na nombia kewɔŋee te ɛ na moo tɔ ɛ nɔɔkebake nɔɔ,</para>
  <para style="q2" vid="ISA 58:4">na akpanyanyaŋ akɔtase kegyɔ dɔŋa.</para>
  <para style="q1" vid="ISA 58:4">Ɛ be tale bake nɔɔ nnɛ</para>
  <para style="q2" vid="ISA 58:4">na baa nyii ɛ kefane adido ya.<verse eid="ISA 58:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 58:5" />Kei yɛna nɔɔkebake keŋ mɛɛ gyae,</para>
  <para style="q2" vid="ISA 58:5">nyi balaŋ ke yɔkɔse ba wose wee dokoloŋ pɛ?</para>
  <para style="q1" vid="ISA 58:5">Ke yɛɛ nyee kegɔŋase ke ŋgba moro nɛ</para>
  <para style="q2" vid="ISA 58:5">na titire kamo wuu wose na tɔŋ man kedoo ke?</para>
  <para style="q1" vid="ISA 58:5">Kei yaa ɛ ne baake nyi nɔɔkebake,</para>
  <para style="q2" vid="ISA 58:5">na wee keŋ na gyoo Degbeŋgyoo sia nɛ?<verse eid="ISA 58:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 58:6" />Na nɔɔkebake keŋ mɛɛ gyae yɛna nyi,</para>
  <para style="q1" vid="ISA 58:6">ɛ ka lese agbaragbarase ŋan ŋe bɛɛ di nombia kegbɛɛ dɔɔ ya nɛ,</para>
  <para style="q2" vid="ISA 58:6">na ɛ ke booli kasolɔse ŋmeeseŋ</para>
  <para style="q1" vid="ISA 58:6">na ɛ ke fa baŋ bɔɔ ŋere wɔ do nɛ wosefɛɛreŋ</para>
  <para style="q2" vid="ISA 58:6">na ɛ ke wɔlɛɛ kasolɔ kamasɛ yee?<verse eid="ISA 58:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 58:7" />Na keŋ yɛna nyi ɛ ke kpala ɛ weenɛɛ fa ŋon tanam na ko e nɛ,</para>
  <para style="q2" vid="ISA 58:7">na ɛ ke fa diyemte ŋon ɔ dɔŋ ɔ ne kili nɛ dedoi,</para>
  <para style="q1" vid="ISA 58:7">na ɛ ka do ŋon ɔ dɔŋ deteŋteli nɛ kegba,</para>
  <para style="q2" vid="ISA 58:7">na ɛ ke kɛɛ ɛmɛɛ gbagba ɛ loŋtona dɔɔ yee?<verse eid="ISA 58:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 58:8" />Botɔɔ te ɛ keŋmaŋee gyae ke bɛɛ lee ŋgba tɛɛ kena nɛ,</para>
  <para style="q2" vid="ISA 58:8">na ɛ ke nyiŋ kawee kekyɔ bileŋ</para>
  <para style="q1" vid="ISA 58:8">mena na ɛ katenee<note caller="+" style="fe"><char style="fr" closed="false">58:8 </char><char style="ft" closed="false">Yaa ŋon ɔ tenɛɛ nɛ</char></note> gyae ke ta ɛ siaman,</para>
  <para style="q2" vid="ISA 58:8">na Degbeŋgyoo gyoorobiiri ke gyee ŋon nideli.<verse eid="ISA 58:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 58:9" />Kenaŋ na ɛ ke baake Degbeŋgyoo, te waa kpa ŋon,</para>
  <para style="q2" vid="ISA 58:9">ɛ ke wii baake e nyi waa kyɔ ŋon, te waa yako nyiaa, Maŋ yaa.</para>
  <para style="b" vid="ISA 58:9" />
  <para style="q1" vid="ISA 58:9">&lt;&lt; Nyi akpaa ɛ lese baŋ bɔɔ ŋere wɔ do nɛ kasolɔse,</para>
  <para style="q2" vid="ISA 58:9">kpuna nyiŋmaase kamo wola balaŋ na balaŋ kewɔlɛɛ,<verse eid="ISA 58:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 58:10" />te akpaa ɛ mo ɛ weenɛɛ fa ŋon tanam na ko e,</para>
  <para style="q2" vid="ISA 58:10">te ɛ kyɔ baŋ bɔɔ ŋere wɔ do na,</para>
  <para style="q1" vid="ISA 58:10">kenaŋ na ɛ keŋmaŋee gyae ke bɛɛ lee detiŋtɛɛ man,</para>
  <para style="q2" vid="ISA 58:10">te ɛ nelim gyae ke yɛɛ ŋgba weese teŋteŋ nɛ.<verse eid="ISA 58:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 58:11" />Degbeŋgyoo waa wola neŋ gbɛɛ debaŋ kamasɛ,</para>
  <para style="q1" vid="ISA 58:11">waa yela ɛ ke nyiŋ keŋ ɛ ne gyae tɛɛle dowolo dɔɔ</para>
  <para style="q2" vid="ISA 58:11">na waa do n ŋɔɔ doŋ.</para>
  <para style="q1" vid="ISA 58:11">N ke yɛɛ ŋgba wɔɔbii keŋ bɛɛ do ke loŋ nideli nɛ,</para>
  <para style="q2" vid="ISA 58:11">ŋgba boŋobiinyee keŋ ke bɛɛ yoo ya nɛ.<verse eid="ISA 58:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 58:12" />Ɛ balaŋ baa desina be donɔɔse ŋan ŋɔɔ wɔlɛɛ nɛ</para>
  <para style="q2" vid="ISA 58:12">na baa bese baŋ gyakaa gyaŋgba mokɔɔse ŋan dɔɔ,</para>
  <para style="q1" vid="ISA 58:12">baa baake ŋon nyi Ŋon ɔ ne desina Akyaŋ ŋan ŋɔɔ tekeri</para>
  <para style="q2" vid="ISA 58:12">na ŋon ɔ ne desina lese gbɛɛneŋ balaŋ akyaese man nɛ.<verse eid="ISA 58:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 58:13" />Nyi akpaa n te waalaa ma kefɛɛfo wee keŋ ya</para>
  <para style="q2" vid="ISA 58:13">te n te yɛɛ n kegyae ma wee fereŋkyeŋ keŋ ya,</para>
  <para style="q1" vid="ISA 58:13">akpaa ma kefɛɛfowee keŋ da gyoo n sia,</para>
  <para style="q2" vid="ISA 58:13">te n mo obuo fa Degbeŋgyoo wee fereŋkyeŋ keŋ,</para>
  <para style="q1" vid="ISA 58:13">nyi n mo ɔ obuo fa ke te n te yɛɛ ke nyaŋ gbagba n gbɛɛ dɔɔ ya,</para>
  <para style="q2" vid="ISA 58:13">te n te yɛɛ ke mena keŋ n ne gyae yaa n te kolosi nɔɔwoya ŋan taŋ tɔnɔɔ ya nɛ,<verse eid="ISA 58:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 58:14" />kenaŋ na n ke nyaŋee Degbeŋgyoo man,</para>
  <para style="q1" vid="ISA 58:14">te maa yela n ke lɛɛ yele tɛɛle keŋ dɔɔ</para>
  <para style="q2" vid="ISA 58:14">na n ke di n kya Yakɔbe dedii.&gt;&gt;</para>
  <para style="q4" vid="ISA 58:14">Degbeŋgyoo kolosila.<verse eid="ISA 58:14" /></para>
  <chapter eid="ISA 58" />
  <chapter number="59" style="c" sid="ISA 59" />
  <para style="s1">Dukum na ketɔlɛɛ na kelɛɛ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 59:1" />Kɛɛ, Degbeŋgyoo bam be yɛɛ duguŋ keŋ ɔ be tale lɛɛ ŋon,</para>
  <para style="q2" vid="ISA 59:1">yaa ɔ deŋela te tɔɔ keŋ ɔ bee nyii ŋon ya.<verse eid="ISA 59:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 59:2" />Mɔna ɛ dukum tirana</para>
  <para style="q2" vid="ISA 59:2">ɛmɛɛ na ɛ Wurubuarɛ nsana.</para>
  <para style="q1" vid="ISA 59:2">Ɛ dukum te wuu ɔ sia lee ɛ dɔɔ,</para>
  <para style="q2" vid="ISA 59:2">nyi ɔ be nyii ŋon ya.<verse eid="ISA 59:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 59:3" />Nawolo nyi fatabo te kpatee ɛ nyiŋmaase,</para>
  <para style="q2" vid="ISA 59:3">ayimɛɛ doo ɛ nyimbiise man.</para>
  <para style="q1" vid="ISA 59:3">Ɛ nɔɔsebia te dii akɛrɛɛ</para>
  <para style="q2" vid="ISA 59:3">te ɛ laakem ne kolosi akpanyanyaŋ nombia.<verse eid="ISA 59:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 59:4" />Ŋolo bɛɛ baake nombia kedi kegbɛɛ dɔɔ ya,</para>
  <para style="q2" vid="ISA 59:4">ŋolo bee di nombia anokoare gbɛɛ ya.</para>
  <para style="q1" vid="ISA 59:4">Bɛɛ gyae aŋmaareŋ te bee dii akɛrɛɛ,</para>
  <para style="q2" vid="ISA 59:4">bɛɛ kyaŋ kayeyɛɛ fulu, na be ta lola nombiakumɛɛ<verse eid="ISA 59:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 59:5" />Bɛɛ kpala dom kum wɔɔ</para>
  <para style="q2" vid="ISA 59:5">na be ta loo akya gbelaa.</para>
  <para style="q1" vid="ISA 59:5">Ŋon ɔ tao be wɔɔ na waa yeŋ,</para>
  <para style="q2" vid="ISA 59:5">te dokoloŋ de yɛlɛɛ na, ne kpala dom bu.<verse eid="ISA 59:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 59:6" />Ba akya gbelaa ŋan bɔɔ loo nɛ be dei fa kanyaŋ ya,</para>
  <para style="q2" vid="ISA 59:6">bɔɔ gyae baa tale mo keŋ bɔɔ loo nɛ wuu ba wose ya.</para>
  <para style="q1" vid="ISA 59:6">Ba ayɛɛsa yɛɛ dukum,</para>
  <para style="q2" vid="ISA 59:6">te nombia nkaraŋkaraŋ keyɛɛ doo be nyiŋmaase man.<verse eid="ISA 59:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 59:7" />Be nawɔɔ ne barase ke yɛɛ dukum,</para>
  <para style="q2" vid="ISA 59:7">te bɛɛ yɛɛ ɔsaa ke kyɛɛkee fatabo keŋ dukum be doo ke man ya nɛ leki.</para>
  <para style="q1" vid="ISA 59:7">Bɛɛ gyueŋ nombia kumɛɛ,</para>
  <para style="q2" vid="ISA 59:7">nombia nkaraŋkaraŋ keyɛɛ doo be gbɛɛneŋ man.<verse eid="ISA 59:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 59:8" />Bɔɔ gyeŋ wosefɛɛreŋ gbɛɛ ya,</para>
  <para style="q2" vid="ISA 59:8">nombia kedi kegbɛɛ dɔɔ be doo be dɛɛtɛe man ya.</para>
  <para style="q1" vid="ISA 59:8">Ba te gokii be gbɛɛneŋ</para>
  <para style="q2" vid="ISA 59:8">ŋon waa ta ŋe dɔɔ laŋ be gyae waa gyeŋ wosefɛɛreŋ ya.<verse eid="ISA 59:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 59:9" />Mena dɔɔ nombia kedi kegbɛɛ dɔɔ dana lem lee de gyaŋ,</para>
  <para style="q2" vid="ISA 59:9">te katenee bee lii de gyaŋ ya.</para>
  <para style="q1" vid="ISA 59:9">Dɛɛ kɛo keŋmaŋee mɔna detiŋtɛɛ te kilisi daa,</para>
  <para style="q2" vid="ISA 59:9">dɛɛ kɛo tɛɛ keŋmaŋee, mɔna de dɔŋ detiŋtɛɛ tuum man.<verse eid="ISA 59:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 59:10" />De dana de nyiŋmaase dɛɛ lalaa dekyaŋ ŋgba siayɛlɛɛsate nɛ,</para>
  <para style="q2" vid="ISA 59:10">dɛɛ kɛo gbɛɛ ŋgba balaŋ baŋ bɔɔ dana sia ya nɛ.</para>
  <para style="q1" vid="ISA 59:10">Dɛɛ gyɔ de naawɔ weese teŋteŋ ŋgba de dɔŋ nelim bo nɛ,</para>
  <para style="q2" vid="ISA 59:10">de yɛɛ ŋgba balaŋ ayeŋɛɛ nɛ wosedoŋtena man.<verse eid="ISA 59:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 59:11" />De popou ne gbesi ŋgba mokɔɔte nɛ,</para>
  <para style="q2" vid="ISA 59:11">dɛɛ muusu ŋgba awuluŋna nɛ.</para>
  <para style="q2" vid="ISA 59:11">Dɛɛ kɛo nombia kedi kegbɛɛ dɔɔ, mɔna dɔɔ ne nyim ya,</para>
  <para style="q1" vid="ISA 59:11">dɛɛ kɛo kelɛɛ mɔna ke kyaana lem.<verse eid="ISA 59:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 59:12" />Nawolo nyi de nombiakumɛɛ boe n siaman,</para>
  <para style="q2" vid="ISA 59:12">te de dukum ne di adansɛɛ tia daa.</para>
  <para style="q1" vid="ISA 59:12">De nombiakumɛɛ doo de siaman,</para>
  <para style="q2" vid="ISA 59:12">te da gyeŋ de nombia nkaraŋkaraŋ.<verse eid="ISA 59:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 59:13" />De ta besena de nimboo tee de Degbeŋgyoo te de bɛɛ e,</para>
  <para style="q2" vid="ISA 59:13">da besena de wɔle tee de Wurubuarɛ,</para>
  <para style="q1" vid="ISA 59:13">dɛɛ seŋ tia balaŋ te dɛɛ ŋere wɔ do,</para>
  <para style="q2" vid="ISA 59:13">dee dii akɛrɛɛ ŋan dɔɔ gyueŋ de konɔɔse man nɛ.<verse eid="ISA 59:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 59:14" />Mena dɔɔ ɔ te gegi nombia kedi kegbɛɛ dɔɔ,</para>
  <para style="q2" vid="ISA 59:14">te katenee seŋɛɛ lemlem,</para>
  <para style="q1" vid="ISA 59:14">anokoare te gyɔ ɔ nae abɔntere man,</para>
  <para style="q2" vid="ISA 59:14">te anokoare kedi be tale gyoo ya.<verse eid="ISA 59:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 59:15" />Bɔɔ ne naa anokoare kedi yenaŋ daale ya,</para>
  <para style="q2" vid="ISA 59:15">te ɔkamasɛ ŋon ɔ ne kɔla dukum na, bɛɛ naase e diyem.</para>
  <para style="q1" vid="ISA 59:15">Degbeŋgyoo naawɔ, te ka te yɛɛ e gyoŋ ya,</para>
  <para style="q2" vid="ISA 59:15">nyi nombia kedi kegbɛɛ dɔɔ be kyaa ya.<verse eid="ISA 59:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 59:16" />Ɔ naawɔ nyi ŋolo be kyaa ya,</para>
  <para style="q2" vid="ISA 59:16">doo ɔ nɔɔ nyi ŋolo be kyaa waa kyɔ ya.</para>
  <para style="q1" vid="ISA 59:16">mena dɔɔ ɔ moo ŋon gbagba ɔ doŋ lɛɛ ɔ wose,</para>
  <para style="q2" vid="ISA 59:16">te ŋon gbagba ɔ katenee danaana e.<verse eid="ISA 59:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 59:17" />Ɔ moo katenee do ŋgba nyeele pampasaŋ nɛ,</para>
  <para style="q2" vid="ISA 59:17">te ɔ moo nyeekelɛɛ wuu ŋgba nyeele kotɔtɔɔ nɛ.</para>
  <para style="q1" vid="ISA 59:17">Ɔ doo deŋele kewɔŋ kom ketɔ ŋgba kegba nɛ,</para>
  <para style="q2" vid="ISA 59:17">te ɔ moo baŋ milii ɔ wose ŋgba kanyaŋ nɛ.<verse eid="ISA 59:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 59:18" />Waa wɔŋ deŋele tɔ kom,</para>
  <para style="q2" vid="ISA 59:18">ŋgba mena keŋ ba ayɛɛsa doo nɛ,</para>
  <para style="q1" vid="ISA 59:18">waa mo baŋ tɔ ɔ kɔlara kom,</para>
  <para style="q2" vid="ISA 59:18">na baŋ bɛɛ kɔla e nɛ,</para>
  <para style="q2" vid="ISA 59:18">waa tɔ baŋ be kyaa naŋ lem mɔ kom.<verse eid="ISA 59:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 59:19" />Balaŋ baa yee Degbeŋgyoo yele lee weese dɛɛyalae</para>
  <para style="q2" vid="ISA 59:19">na baa mo obuo fa ɔ gyoorobiiri lee weese dɛɛlee,</para>
  <para style="q1" vid="ISA 59:19">Nawolo nyi waa kɔŋ ŋgba boo kewuu waale,</para>
  <para style="q2" vid="ISA 59:19">keŋ Degbeŋgyoo weesɛɛ be gegi laŋ nɛ.<verse eid="ISA 59:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 59:20" />&lt;&lt;Nyeelɛɛre ŋon waa kɔŋ Siyɔn,</para>
  <para style="q2" vid="ISA 59:20">Yakɔbe dekpaŋalaŋmantena baŋ bɔɔ kyɛɛkee lee be dukum man nɛ gyaŋ,&gt;&gt;</para>
  <para style="q4" vid="ISA 59:20">Degbeŋgyoo torola yako.<verse eid="ISA 59:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 59:21" />Degbeŋgyoo kpa nyiaa,&lt;&lt;Maŋ dɔɔ kei yɛna me nɔɔkebakesee fa wɔ. Me feliŋ ŋon ɔ doo n man nɛ be gyae waa lee n man ya, debaŋ kamasɛ na me nombia ŋan mɔɔ mo do n nɔɔman nɛ gyae ke doo n nɔɔman na n bia nɔɔse man, na n duuluŋ man balaŋ nɔɔse man lee gyɛŋ kelii kekpaakekpaa, Degbeŋgyoo yakola.<verse eid="ISA 59:21" /></para>
  <chapter eid="ISA 59" />
  <chapter number="60" style="c" sid="ISA 60" />
  <para style="s1">Siyɔn gyoorobiiri</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 60:1" />&lt;&lt;Koro na n ke ŋalakee, nawolo nyi n keŋmaŋee te kɔŋ,</para>
  <para style="q2" vid="ISA 60:1">te Degbeŋgyoo gyoorobiiri ta lee n dɔɔ.<verse eid="ISA 60:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 60:2" />Kɛɛ, detiŋtɛɛ te wuu tɛɛle keŋ</para>
  <para style="q2" vid="ISA 60:2">te detiŋtɛɛ tuum te wuu balaŋ,</para>
  <para style="q1" vid="ISA 60:2">mɔna Degbeŋgyoo waa lee n dɔɔ,</para>
  <para style="q2" vid="ISA 60:2">na baa naa ɔ gyoorobiiri n dɔɔ.<verse eid="ISA 60:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 60:3" />Tɛɛlese baa kɔŋ n keŋmaŋee keŋ man,</para>
  <para style="q2" vid="ISA 60:3">na gyooneŋ kekɔŋ n tɛɛkena keŋalakee keŋ gyaŋ.<verse eid="ISA 60:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 60:4" />&lt;&lt;Gyina n sia na n ke kɛɛ kilisi,</para>
  <para style="q2" vid="ISA 60:4">be popou te yilaa te be kɔŋawɔ n gyaŋ.</para>
  <para style="q1" vid="ISA 60:4">N bia tewulɛɛ ta lee lemlem kɔŋ,</para>
  <para style="q2" vid="ISA 60:4">baa doona n bia alebia maama bɛɛ kɔŋ.<verse eid="ISA 60:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 60:5" />Botɔɔ te n ke kɛɛ na ke yɛɛ neŋ gyoŋ.</para>
  <para style="q2" vid="ISA 60:5">kenyaŋee gyae ke wulu n konɔɔ.</para>
  <para style="q1" vid="ISA 60:5">baa mo wosekenyiŋ keŋ gyakaa ɛpose dɔɔ nɛ kɔna neŋ,</para>
  <para style="q2" vid="ISA 60:5">tɛɛlese wose kenyiŋ gyae ke kɔŋ n gyaŋ.<verse eid="ISA 60:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 60:6" />Kurumɔɔse akpeŋ akpeŋ baa lɛɛ n tɛɛle dɔɔ,</para>
  <para style="q2" vid="ISA 60:6">kpuna Midiane na Efa kurumɔɔsebia.</para>
  <para style="q1" vid="ISA 60:6">Te Sebatena pou mɔ baa kɔŋ,</para>
  <para style="q2" vid="ISA 60:6">na ba seelena kɔba yayam na oliifi,</para>
  <para style="q2" vid="ISA 60:6">na bɛɛ lese Degbeŋgyoo yele.<verse eid="ISA 60:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 60:7" />Baa yilaa Kedare wonembia pou kɔna neŋ,</para>
  <para style="q1" vid="ISA 60:7">Nebayote namense baala baa som neŋ,</para>
  <para style="q2" vid="ISA 60:7">Baa lɛɛ wɔ ŋgba kedeesa nɛ ma kedeesaboe dɔɔ,</para>
  <para style="q2" vid="ISA 60:7">te maa do me gyoorobiiri ɔsom deni keŋ obuo.<verse eid="ISA 60:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 60:8" />&lt;&lt;Bomɔ ne furufulaa laŋ ŋgba ŋɔma,</para>
  <para style="q2" vid="ISA 60:8">ŋgba awuluŋna ne gyuulaa ba asaase man nɛ?<verse eid="ISA 60:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 60:9" />Ampaŋ, me siaman te tɛɛlese ŋan loŋ be kilisi ŋa nɛ ne kɛɛ,</para>
  <para style="q2" vid="ISA 60:9">te Taresisi pantuuse ŋan dɔŋ siaman<note caller="+" style="fe"><char style="fr" closed="false">60:9 </char><char style="ft" closed="false">Kebudiira agbele dinaana</char></note></para>
  <para style="q1" vid="ISA 60:9">be ta mo n bia baŋ be kyaanaŋ lem nɛ bɛɛ kɔŋ,</para>
  <para style="q2" vid="ISA 60:9">kpuna be kɔba wolom na kɔba yayam,</para>
  <para style="q1" vid="ISA 60:9">be kaa do Degbeŋgyoo n Wurubuarɛ</para>
  <para style="q2" vid="ISA 60:9">Iseraetena fereŋkyeŋte ŋon gyoorobiiri,</para>
  <para style="q2" vid="ISA 60:9">nawolo nyi ŋon faana neŋ wose kenyiŋ.<verse eid="ISA 60:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 60:10" />&lt;&lt;Ŋɔɔla baa desina nya akyaŋse ŋan baŋ,</para>
  <para style="q2" vid="ISA 60:10">na be gyooneŋ kaa som neŋ.</para>
  <para style="q1" vid="ISA 60:10">Doo nyi me tuku ŋon me baŋ man,</para>
  <para style="q2" vid="ISA 60:10">mɔna me deeli keyɛɛ dɔɔ maa wii ŋon.<verse eid="ISA 60:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 60:11" />Baa toro nya anaanɔɔse debaŋ kamasɛ,</para>
  <para style="q2" vid="ISA 60:11">bɔɔ gyae baa tɔ ŋa weese teŋteŋ yaa nelim ya,</para>
  <para style="q1" vid="ISA 60:11">na balaŋ kenyiŋ mo tɛɛlese agyapadɛɛse kɔna neŋ,</para>
  <para style="q2" vid="ISA 60:11">na be gyooneŋ ke lɔ baameŋse gaŋtee be siaman.<verse eid="ISA 60:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 60:12" />Nawolo nyi baa wɔlɛɛ tɛɛle yaa gyoorobiiri keŋ be gyae ke ka som neŋ ya nɛ.</para>
  <para style="q2" vid="ISA 60:12">Baa yɛlɛɛ ke pou.<verse eid="ISA 60:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="ISA 60:13" />&lt;&lt;Lebanɔn gyoorobiiri gyae ke kɔŋ n gyaŋ,</para>
  <para style="q2" vid="ISA 60:13">baa yilaa daase kpaakpaa nyiŋan,</para>
  <para style="q1" vid="ISA 60:13">kaa do mɔ ɔsom deni fereŋkyeŋ keŋ obuo,</para>
  <para style="q2" vid="ISA 60:13">na maa do me nae dɛɛsee gyoorobiiri.<verse eid="ISA 60:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 60:14" />Baŋ bɔɔ ŋere neŋ do nɛ bia baa kɔŋ kaa buŋ neŋ,</para>
  <para style="q2" vid="ISA 60:14">baŋ pou bɔɔ naase neŋ diyem nɛ baa kɔŋ kaa buŋ n naawɔ tɛɛ,</para>
  <para style="q1" vid="ISA 60:14">na baa baake neŋ nyi Degbeŋgyoo donɔɔ dinaa,</para>
  <para style="q2" vid="ISA 60:14">Iserae fereŋkyeŋte ŋon Siyɔn.<verse eid="ISA 60:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 60:15" />&lt;&lt;Doo nyi be bɛɛ neŋ te be kɔla neŋ,</para>
  <para style="q2" vid="ISA 60:15">te ŋolo na ŋolo ta mo n man laŋ ya nɛ,</para>
  <para style="q1" vid="ISA 60:15">maa yɛɛ neŋ obuo walaŋ kekpaakekpaa,</para>
  <para style="q2" vid="ISA 60:15">na kenyaŋee fa kalola kegyakaarese pou.<verse eid="ISA 60:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 60:16" />N ke nyɔɔ tɛɛlese miliki,</para>
  <para style="q2" vid="ISA 60:16">na n ke ŋmase gyooneŋ ade.</para>
  <para style="q1" vid="ISA 60:16">Botɔɔ te n ka gyeŋ nyi maŋ, Degbeŋgyoo, maŋ yɛna n nyeelɛɛre.<verse eid="ISA 60:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 60:17" />Maa mo kɔba yayam see kɔbere nae man fa neŋ,</para>
  <para style="q2" vid="ISA 60:17">na kɔba wolom ka seŋ nyeele nae man.</para>
  <para style="q1" vid="ISA 60:17">Maa mo kɔbere see daŋ nae man,</para>
  <para style="q2" vid="ISA 60:17">na nyeele ka seŋ boya nawɔɔ man.</para>
  <para style="q1" vid="ISA 60:17">Maa yela wosefɛɛreŋ ke yɛɛ n siamante,</para>
  <para style="q2" vid="ISA 60:17">na katenee ke di n dɔɔ.<verse eid="ISA 60:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 60:18" />Bɔɔ gyae baa tekaa nyii yoo yeesa n tɛɛle dɔɔ,</para>
  <para style="q2" vid="ISA 60:18">yaa abɔɔ kewɔlɛɛ yaa abɔɔ ketekerii n wulu man ya,</para>
  <para style="q1" vid="ISA 60:18">mɔna n ke baake nya akyaŋse nyi nyeekelɛɛ,</para>
  <para style="q2" vid="ISA 60:18">na nya anaanɔɔse nyi yele kalese.<verse eid="ISA 60:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 60:19" />Weese be gyae ke tekaa yɛɛ n ke ŋmaŋee weese teŋteŋ ya,</para>
  <para style="q2" vid="ISA 60:19">yaa gyaalaŋ ke ŋalakee n dɔɔ ya,</para>
  <para style="q1" vid="ISA 60:19">nawolo nyi Degbeŋgyoo waa yɛɛ n keŋmaŋee kekpaakekpaa,</para>
  <para style="q2" vid="ISA 60:19">na n Wurubuarɛ waa yɛɛ n gyoorobiiri.<verse eid="ISA 60:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 60:20" />N weese be gyae ka teka gyoo ya,</para>
  <para style="q2" vid="ISA 60:20">te n gyaalaŋ be gyae ka tekaa yeŋ ya,</para>
  <para style="q1" vid="ISA 60:20">Degbeŋgyoo waa yɛɛ n keŋmaŋee kekpaakekpaa,</para>
  <para style="q2" vid="ISA 60:20">te n waraŋsa weeya gyae kekɔŋ ɔto.<verse eid="ISA 60:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 60:21" />Botɔɔ te n balaŋ pou baa tenee,</para>
  <para style="q2" vid="ISA 60:21">na tɛɛle keŋ ke yɛɛ be wui kekpaakekpaa.</para>
  <para style="q1" vid="ISA 60:21">Baŋ yɛna daŋbii keŋ mɔɔ duu nɛ,</para>
  <para style="q2" vid="ISA 60:21">me nyiŋmaa man tom</para>
  <para style="q2" vid="ISA 60:21">na baa lese me gyoorobiiri wola.<verse eid="ISA 60:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 60:22" />Ŋon ɔ yɛɛ peperee ɛ man nɛ waa bese kakpoŋ,</para>
  <para style="q2" vid="ISA 60:22">te biikyaa waa bese tɛɛle dekpaatakpere.</para>
  <para style="q1" vid="ISA 60:22">Maŋ yɛna Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 60:22">maa yɛɛ ke bileŋ ka debaŋ man.&gt;&gt;<verse eid="ISA 60:22" /></para>
  <chapter eid="ISA 60" />
  <chapter number="61" style="c" sid="ISA 61" />
  <para style="s1">Degbeŋgyoo waraŋase kewii kulutoo</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 61:1" />Degbeŋgyoo Doŋ Pou Nyee ŋon feliŋ gyakaa me dɔɔ,</para>
  <para style="q2" vid="ISA 61:1">nawolo nyi ɔ te tiu maŋ nuŋ,</para>
  <para style="q2" vid="ISA 61:1">nyi maa gyɔ ɔ nombia kpaakpaa ŋan dekpeŋkpeŋ fa ayematena.</para>
  <para style="q1" vid="ISA 61:1">Ɔ te kpila maŋ nyi maa yakodo baŋ nombia be takaa wɔ nɛ,</para>
  <para style="q2" vid="ISA 61:1">na maa toro yako yoogbeŋa nyi be te nyiŋ ba wose,</para>
  <para style="q2" vid="ISA 61:1">na maa lese baŋ bɔɔ kyaŋ tɔ deni nɛ lee detiŋtɛɛ man.<verse eid="ISA 61:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 61:2" />Na maa gyɔ Degbeŋgyoo kaboele kulutoo keŋ dekpeŋkpeŋ,</para>
  <para style="q2" vid="ISA 61:2">na de Wurubuarɛ nombia kedi wee keŋ,</para>
  <para style="q1" vid="ISA 61:2">na ke fɛɛ baŋ bee di waraŋsa nɛ wɔe,<verse eid="ISA 61:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="ISA 61:3" />na maa fa baŋ be kyaa Siyɔn te bɛɛ mutii nɛ abɔɔ,</para>
  <para style="q1" vid="ISA 61:3">na maa wuu wɔ gyooro kotɔtɔɔ</para>
  <para style="q2" vid="ISA 61:3">na ka seŋ tɔŋ nae man,</para>
  <para style="q1" vid="ISA 61:3">kenyaŋee nuŋ</para>
  <para style="q2" vid="ISA 61:3">see waraŋsa nae man,</para>
  <para style="q1" vid="ISA 61:3">yele kalese kegba</para>
  <para style="q2" vid="ISA 61:3">see waraŋase kedi nae man.</para>
  <para style="q1" vid="ISA 61:3">Baa baake wɔ nyi katenee kpeli daase,</para>
  <para style="q2" vid="ISA 61:3">ŋan Degbeŋgyoo be duu,</para>
  <para style="q1" vid="ISA 61:3">na waa lese ɔ gyoorobiiri wola.<verse eid="ISA 61:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 61:4" />Baa desina baŋee gyaŋgba donɔɔse ŋan be yɛlɛɛ nɛ,</para>
  <para style="q2" vid="ISA 61:4">na baa besena botɔɔse ŋan be wɔlɛɛ beneŋ beneŋ nɛ seŋ,</para>
  <para style="q1" vid="ISA 61:4">baa desina donɔɔse dinaana ŋan be yɛlɛɛ nɛ,</para>
  <para style="q2" vid="ISA 61:4">na ŋan be wɔlɛɛ nɛ see kalola kegyakaarese.<verse eid="ISA 61:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 61:5" />Ŋɔɔla ne gyaela baa kɛɛle ɛ namense,</para>
  <para style="q2" vid="ISA 61:5">baŋ ne gyaela baa yɛɛ tom ɛ wɔɔse na gerepo wɔɔse man.<verse eid="ISA 61:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 61:6" />Mɔna baa baake ŋon nyi Degbeŋgyoo saese,</para>
  <para style="q2" vid="ISA 61:6">na baa do ŋon yele nyi Wurubuarɛ somera.</para>
  <para style="q1" vid="ISA 61:6">Ɛ kedi tɛɛlese agyapadɛɛse,</para>
  <para style="q2" vid="ISA 61:6">te ba wosekenyiŋ te ɛ ka mo gate ɛ wose.<verse eid="ISA 61:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 61:7" />Desɛŋ nae man nɛ,</para>
  <para style="q2" vid="ISA 61:7">ɛ ke nyiŋ dedii akpeŋ ala,</para>
  <para style="q1" vid="ISA 61:7">desɛŋ nombia nae man nɛ,</para>
  <para style="q2" vid="ISA 61:7">ɛ ke nyaŋee ɛ dedii keŋ man.</para>
  <para style="q1" vid="ISA 61:7">te ɛ ke nyiŋ ɛ tɛɛle akpeŋ ala,</para>
  <para style="q2" vid="ISA 61:7">na ɛ ke nyaŋee kekpaakekpaa.<verse eid="ISA 61:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 61:8" />&lt;&lt;Nawolo nyi maŋ, Degbeŋgyoo ne gyae nombia kedi kegbɛɛ dɔɔ,</para>
  <para style="q2" vid="ISA 61:8">mɛɛ kɔla abɔɔ kelɛo doŋ man na nombia kumɛɛ keyɛɛ.</para>
  <para style="q1" vid="ISA 61:8">Maa tɔ me balaŋ kom lee ma anokoare kedi man,</para>
  <para style="q2" vid="ISA 61:8">na daana wɔ ke yɛɛ nɔɔkebakesee kekpaakekpaa.<verse eid="ISA 61:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 61:9" />Be duuluŋman balaŋ baa lɛɛ yele tɛɛlese man,</para>
  <para style="q2" vid="ISA 61:9">na be bia balaŋ man.</para>
  <para style="q1" vid="ISA 61:9">Baŋ pou baa naa wɔ nɛ baa gyeŋ,</para>
  <para style="q2" vid="ISA 61:9">nyi be yɛɛ balaŋ baŋ Degbeŋgyoo be hiraa wɔ.&gt;&gt;<verse eid="ISA 61:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 61:10" />Me sia na gye nideli Degbeŋgyoo man,</para>
  <para style="q2" vid="ISA 61:10">ma woo ne nyaŋee me Wurubuarɛ man.</para>
  <para style="q1" vid="ISA 61:10">Nawolo nyi ɔ ta mo nyeekelɛɛ kegba do maŋ</para>
  <para style="q2" vid="ISA 61:10">te ɔ moo ɔ katenee kegba wurikyim do maŋ,</para>
  <para style="q1" vid="ISA 61:10">ŋgba mena keŋ alowɔle baale ne desina ɔ nyee ŋgba sae,</para>
  <para style="q2" vid="ISA 61:10">te alowɔle na mo wa agbaragbarase desina ɔ wose nɛ.<verse eid="ISA 61:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 61:11" />Nawolo nyi mena keŋ tɛɛle ne yele abɔɔbia ne tuu,</para>
  <para style="q2" vid="ISA 61:11">te wɔɔbii ne yele abɔɔbia na bee nɛ,</para>
  <para style="q1" vid="ISA 61:11">mena te Degbeŋgyoo Doŋ Pou Nyee waa yela ɔ katenee</para>
  <para style="q2" vid="ISA 61:11">na ɔ yele kalese ke bɛɛ lee tɛɛlese pou siaman.<verse eid="ISA 61:11" /></para>
  <chapter eid="ISA 61" />
  <chapter number="62" style="c" sid="ISA 62" />
  <para style="s1">Siyɔn yele wɔle</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 62:1" />Siyɔn dɔɔ mɔɔ gyae maa wuu me nɔɔ ya,</para>
  <para style="q2" vid="ISA 62:1">Yerusalɛm dɔɔ mɔɔ gyae maa yɛɛ yididi ya,</para>
  <para style="q1" vid="ISA 62:1">kelii debaŋ keŋ ɔ katenee gyae ke ŋalakee ŋgba nebo weese nɛ,</para>
  <para style="q2" vid="ISA 62:1">ɔ nyeekelɛɛ ŋgba kefulu keŋ bɔɔ kyaŋee nɛ.<verse eid="ISA 62:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 62:2" />Tɛɛlese baa naa n katenee,</para>
  <para style="q2" vid="ISA 62:2">Gyooneŋ pou baa naa n gyoorobiiri.</para>
  <para style="q1" vid="ISA 62:2">Baa baake neŋ yele wɔle</para>
  <para style="q1" vid="ISA 62:2">keŋ Degbeŋgyoo ba mo ɔ nɔɔ do neŋ.<verse eid="ISA 62:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 62:3" />N ke yɛɛ obuo kotɔtɔɔ Degbeŋgyoo nyiŋmaa man,</para>
  <para style="q2" vid="ISA 62:3">na gyooro kotɔtɔɔ n Wurubuarɛ nyiŋmaa man.<verse eid="ISA 62:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 62:4" />Bɔɔ gyae ba tekaa baake neŋ nyi ŋon bɔɔ bɛɛ e,</para>
  <para style="q2" vid="ISA 62:4">yaa baa do n tɛɛle yele nyi kebɛɛ ya.</para>
  <para style="q1" vid="ISA 62:4">Mɔna baa baake neŋ nyi, Hefesiba<note caller="+" style="fe"><char style="fr" closed="false">62:4 </char><char style="ft" closed="false">Keŋ nawolo nyi n nombia ta gyoo me sia</char></note></para>
  <para style="q2" vid="ISA 62:4">na baa baake n tɛɛle nyi, Biyula<note caller="+" style="fe"><char style="fr" closed="false">62:4 </char><char style="ft" closed="false">Keŋ nawolo nyi, ba te yala e</char></note>,</para>
  <para style="q1" vid="ISA 62:4">nawolo nyi n nombia gyae ka gyoo Degbeŋgyoo sia,</para>
  <para style="q2" vid="ISA 62:4">na baa yala n tɛɛle.<verse eid="ISA 62:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 62:5" />Mena keŋ tobaale ne yala alebu nɛ,</para>
  <para style="q2" vid="ISA 62:5">mena te n bia baa yala neŋ,</para>
  <para style="q1" vid="ISA 62:5">mena keŋ alowɔle baale ne nyaŋee alowɔle dɔɔ nɛ,</para>
  <para style="q2" vid="ISA 62:5">mena te n Wurubuarɛ waa nyaŋee n dɔɔ.<verse eid="ISA 62:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 62:6" />O Yerusalɛm, me ta see gyeera nya akyaŋse dɔɔ,</para>
  <para style="q2" vid="ISA 62:6">bɔɔ gyae baa wuu be nɔɔ nelim yaa weese teŋteŋ ya.</para>
  <para style="q1" vid="ISA 62:6">Ɛmɛɛ baŋ ɛ ne baake Degbeŋgyoo nɛ,</para>
  <para style="q2" vid="ISA 62:6">ɛ naa fɛɛfo ya,<verse eid="ISA 62:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 62:7" />te ɛ na yele waa fɛɛfo ya kelii debaŋ keŋ waa desina Yerusalɛm baŋ</para>
  <para style="q2" vid="ISA 62:7">na waa yɛɛ ke donɔɔ keŋ baa lese ka yele tɛɛle dɔɔ.<verse eid="ISA 62:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 62:8" />Degbeŋgyoo te kaŋ ɔ nyiŋmaa dunoluŋ ntam,</para>
  <para style="q2" vid="ISA 62:8">na ɔ baam dekpataakpere keŋ nyiaa,</para>
  <para style="q1" vid="ISA 62:8">&lt;&lt;Mɔɔ gyae maa tekaa mo ɛ wamela</para>
  <para style="q2" vid="ISA 62:8">fa ɛ kɔlara kedi bela ya,</para>
  <para style="q1" vid="ISA 62:8">te ŋɔɔla be gyae baa tekaa nyɔɔ waen wɔle,</para>
  <para style="q2" vid="ISA 62:8">keŋ ɛ be kaa ke dɔɔ nɛ ya.<verse eid="ISA 62:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 62:9" />mɔna baŋ bɔɔ kɛrɛɛ ke nɛ, ne gyaela baa di ke,</para>
  <para style="q2" vid="ISA 62:9">na baa lese Degbeŋgyoo yele,</para>
  <para style="q1" vid="ISA 62:9">te baŋ bɔɔ yilaa gerepose ŋan ne gyaela baa nyɔɔ ka soloŋ</para>
  <para style="q2" vid="ISA 62:9">ma dekpaŋalaŋ fereŋkyeŋ keŋ man.<verse eid="ISA 62:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 62:10" />Ɛ mo keman, ɛ mo anaanɔɔse ŋan man!</para>
  <para style="q2" vid="ISA 62:10">Ɛ desina gbɛɛ keŋ fa balaŋ baŋ.</para>
  <para style="q1" vid="ISA 62:10">Ɛ lese gbɛɛ, ɛ lese gbɛɛ dinaa keŋ,</para>
  <para style="q2" vid="ISA 62:10">Ɛ lese boya ŋan.</para>
  <para style="q1" vid="ISA 62:10">Ɛ gyina felage keŋ fa tɛɛlese ŋan.<verse eid="ISA 62:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 62:11" />Degbeŋgyoo te yele be te nyii</para>
  <para style="q2" vid="ISA 62:11">kelii tɛɛle ɔto nyiaa,</para>
  <para style="q1" vid="ISA 62:11">&lt;&lt;Ɛ yako Siyɔn alebu ŋon nyi,</para>
  <para style="q2" vid="ISA 62:11">&lt;Kɛɛ, n nyeelɛɛre ne kɔŋ!</para>
  <para style="q1" vid="ISA 62:11">Kɛɛ, ɔ kom ketɔ kpuɛna e,</para>
  <para style="q2" vid="ISA 62:11">te ɔ mpataa mɔ dɔŋ ɔ siaman.&gt;&gt;&gt;<verse eid="ISA 62:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 62:12" />Baa baake wɔ nyi balaŋ fereŋkyeŋ,</para>
  <para style="q2" vid="ISA 62:12">balaŋ baŋ Degbeŋgyoo be lɛɛ,</para>
  <para style="q1" vid="ISA 62:12">na baa baake neŋ nyi walaŋ ŋon bɛɛ kɛo e,</para>
  <para style="q2" vid="ISA 62:12">Bɔɔ tekaa bɛɛ donɔɔ dinaa keŋ ya.<verse eid="ISA 62:12" /></para>
  <chapter eid="ISA 62" />
  <chapter number="63" style="c" sid="ISA 63" />
  <para style="s1">Wurubuarɛ deŋele kewɔŋ kom ketɔ na kelɛɛ wee</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 63:1" />Amɔte yɛna kei ŋon ɔ ba lee Edom ɔ ne kɔŋ,</para>
  <para style="q2" vid="ISA 63:1">lee Bosera, te ɔ doona kegba keŋ kolo yayam be woli ke nɛ?</para>
  <para style="q1" vid="ISA 63:1">Amɔte yɛna kei, ŋon ɔ doona abɔɔ kyeokyeo,</para>
  <para style="q2" vid="ISA 63:1">te ɔ dɔŋɛɛ ɔ baalabiiri man nɛ?</para>
  <para style="q1" vid="ISA 63:1">&lt;&lt;Maŋ ne gyɔna katenɛɛ dekpeŋkpeŋ</para>
  <para style="q2" vid="ISA 63:1">maŋ danaana doŋ keŋ maa tale lɛɛ walaŋ.&gt;&gt;<verse eid="ISA 63:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="ISA 63:2" />Woŋ dɔɔ te ɛ kegbase yasewɔ,</para>
  <para style="q2" vid="ISA 63:2">ŋgba baŋ bɛɛ ŋmaase waen nɛ?<verse eid="ISA 63:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 63:3" />&lt;&lt;Maageŋ ŋmaasena waen be dɛɛ ŋmaasee waen man,</para>
  <para style="q2" vid="ISA 63:3">ŋolo ta lee tɛɛlese ŋan man kaa kyɔ maŋ ya.</para>
  <para style="q1" vid="ISA 63:3">Me sakatee wɔ me baŋ man,</para>
  <para style="q2" vid="ISA 63:3">te ma betee wɔ me baŋkum keŋ man.</para>
  <para style="q1" vid="ISA 63:3">Be fatabo ŋmateela gyoo ma kegba,</para>
  <para style="q2" vid="ISA 63:3">te ke wɔlɛɛ ma abɔɔ pou nɛ.<verse eid="ISA 63:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 63:4" />Ke yɛɛ ma deŋele kewɔŋ kom ketɔ wee ke,</para>
  <para style="q2" vid="ISA 63:4">ma kelɛɛ kulutoo keŋ te kɔŋ.<verse eid="ISA 63:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 63:5" />Me kɛowɔ, mɔna ŋolo be kyaa waa kyɔ maŋ ya.</para>
  <para style="q2" vid="ISA 63:5">Doo me nɔɔ nyi ŋolo te kaa kyɔ maŋ ya.</para>
  <para style="q1" vid="ISA 63:5">mena dɔɔ maŋ gbagba me baam lɛɛ maŋ,</para>
  <para style="q2" vid="ISA 63:5">te me baŋkum yelaa me talewɔ seŋ keŋkeŋ.<verse eid="ISA 63:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 63:6" />Me sakatee tɛɛlese ŋan me baŋ man,</para>
  <para style="q2" vid="ISA 63:6">me baŋkum man te me yela be dɛɛsewɔ,</para>
  <para style="q2" vid="ISA 63:6">te me kyɛɛkee be fatabo woli tɛɛle.&gt;&gt;<verse eid="ISA 63:6" /></para>
  <para style="s1">Yele kalese na kefane</para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 63:7" />Maa yako Degbeŋgyoo kegyae keŋ taŋ ɔto ya,</para>
  <para style="q2" vid="ISA 63:7">ŋan pou Degbeŋgyoo be yɛɛ fa daa nɛ dɔɔ,</para>
  <para style="q2" vid="ISA 63:7">kaboena nyi baa lese ɔ yele.</para>
  <para style="q1" vid="ISA 63:7">Ayi, abɔɔ kpaakpaa burum ŋan,</para>
  <para style="q2" vid="ISA 63:7">ɔ be yɛɛ fa Iseraetena,</para>
  <para style="q2" vid="ISA 63:7">lee ɔ kaboele na ɔ kegyae keŋ taŋ ɔto ya nɛ dɔɔ.<verse eid="ISA 63:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 63:8" />Degbeŋgyoo kpa nyiaa, &lt;&lt;Ampaŋ, be yɛɛ me balaŋwɔ,</para>
  <para style="q2" vid="ISA 63:8">bia baŋ bɔɔ gyae baa beo maŋ ya,&gt;&gt;</para>
  <para style="q2" vid="ISA 63:8">mena dɔɔ ɔ kaa bese ba nyeelɛɛre.<verse eid="ISA 63:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 63:9" />Ŋon mɔ kaawɔ kpuna wɔ be kaale kena pou man,</para>
  <para style="q2" vid="ISA 63:9">te Wurubuarɛ kpilare ŋon ɔ ne tɛɛ ɔ dɔɔ yɛɛ tom nɛ lɛɛ wɔ.</para>
  <para style="q1" vid="ISA 63:9">Ɔ kegyae na ɔ waraŋase kewii man te ɔ lɛɛ wɔ,</para>
  <para style="q2" vid="ISA 63:9">ɔ gyinaa wɔ adido te ɔ moo wɔ ta,</para>
  <para style="q2" vid="ISA 63:9">gyaŋgba ba keta pou man.<verse eid="ISA 63:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 63:10" />Mɔna be yɛɛ deŋele doŋ,</para>
  <para style="q2" vid="ISA 63:10">te be yelaa ɔ Feliŋ Fereŋkyeŋ ŋon yɛɛ waraŋase.</para>
  <para style="q1" vid="ISA 63:10">Mena dɔɔ ɔ kyɛɛkee wa nyeempɔ bese be kɔlare,</para>
  <para style="q2" vid="ISA 63:10">te ŋon gbagba yoo wɔ.<verse eid="ISA 63:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 63:11" />Botɔɔ te ɔ balaŋ tɔɔse gyaŋgba keŋ,</para>
  <para style="q2" vid="ISA 63:11">Mosesi na ɔ balaŋ debaŋ keŋ bɔɔse nyiaa,</para>
  <para style="q" vid="ISA 63:11">Nde namensekɛɛlere ŋon ɔ ba lese ɔ namense</para>
  <para style="q2" vid="ISA 63:11">te ɔ ba mo wɔ ta ɛpo man nɛ?</para>
  <para style="q1" vid="ISA 63:11">Nde ŋon ɔ be kpila</para>
  <para style="q2" vid="ISA 63:11">ɔ Feliŋ Fereŋkyeŋ ŋon kpuna wɔ nɛ,<verse eid="ISA 63:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 63:12" />ŋon ɔ be kpila ɔ gyoorobiiri baam doŋte keŋ,</para>
  <para style="q2" vid="ISA 63:12">nyi ke dɛɛ doo Mosesi dunoluŋ dɔɔ,</para>
  <para style="q1" vid="ISA 63:12">ŋon ɔ be kpala loŋse man be siaman</para>
  <para style="q2" vid="ISA 63:12">na ɔ yele kedoo kekpaakekpaa,<verse eid="ISA 63:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 63:13" />ŋon ɔ ba mo wɔ ta leeneŋ man nɛ de?</para>
  <para style="q1" vid="ISA 63:13">Be yɛɛ ŋgba dɛɛkyɔŋ ŋon ɔ doŋ ɔ ne kili depampaa man nɛ,</para>
  <para style="q2" vid="ISA 63:13">ba te gyɔ be nae ya,<verse eid="ISA 63:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 63:14" />Degbeŋgyoo Feliŋ ŋon yelaa be fɛɛfowɔ,</para>
  <para style="q2" vid="ISA 63:14">ŋgba nunkyue ŋon ɔ be gyu kefula man nɛ.</para>
  <para style="q1" vid="ISA 63:14">Nnɛ yaa n wola n balaŋ gbɛɛ,</para>
  <para style="q2" vid="ISA 63:14">na n ka mo lɛɛ gyoorobiiri yele fa n wose.<verse eid="ISA 63:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 63:15" />Tisina n nyee lee adido na n ke kɛɛ,</para>
  <para style="q2" vid="ISA 63:15">lee n gyooro dekyae fereŋkyeŋ keŋ korɛɛ nɛ.</para>
  <para style="q1" vid="ISA 63:15">Nde n kegyae nideli na n doŋ keŋ?</para>
  <para style="q2" vid="ISA 63:15">N ta mo n wɔe na n waraŋase kewii weese daa.<verse eid="ISA 63:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 63:16" />Mɔna nyaŋ yɛna de kya,</para>
  <para style="q2" vid="ISA 63:16">Doo nyi Aberaham ba gyeŋ daa,</para>
  <para style="q1" vid="ISA 63:16">yaa Iserae bɛɛ gyene daa ya,</para>
  <para style="q2" vid="ISA 63:16">nyaŋ, Degbeŋgyoo yɛna de kya,</para>
  <para style="q1" vid="ISA 63:16">N yele yɛna de lɛɛre leenaŋ gyaŋgba.<verse eid="ISA 63:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 63:17" />Ao Degbeŋgyoo, woŋ dɔɔ te n yelaa da yoowɔ lee n gbɛɛneŋ man</para>
  <para style="q2" vid="ISA 63:17">te de yɛɛ de konɔɔyuŋ na dɔɔ mo obuo fa neŋ ya?</para>
  <para style="q1" vid="ISA 63:17">Bese kɔŋ lee n somera dɔɔ</para>
  <para style="q2" vid="ISA 63:17">na nya akpaŋalaŋse ŋan ŋe yɛɛ n dedii nɛ dɔɔ.<verse eid="ISA 63:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 63:18" />N dekyae fereŋkyeŋ keŋ doowɔ n balaŋ nyiŋmaa man debaŋ kyomii,</para>
  <para style="q2" vid="ISA 63:18">mɔna nɛnɛɛ de kɔlara te sakatee n dekyae fereŋkyeŋ keŋ.<verse eid="ISA 63:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 63:19" />De yɛɛ n wui leenaŋ gyaŋgba,</para>
  <para style="q2" vid="ISA 63:19">mɔna baŋ dɔɔ n te di gyoori be dɔɔ ya,</para>
  <para style="q2" vid="ISA 63:19">ba te baake n yele gyakaa be dɔɔ ya.<verse eid="ISA 63:19" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="ISA 63" />
  <chapter number="64" style="c" sid="ISA 64" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 64:1" />Ao Degbeŋgyoo, kpase adido man na n ke tisi kɔŋ,</para>
  <para style="q2" vid="ISA 64:1">na bulase ke seree n siaman!<verse eid="ISA 64:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 64:2" />Mena keŋ daase ne kyaŋee boalaŋ</para>
  <para style="q2" vid="ISA 64:2">te ne yele loŋ ne fiu nɛ,</para>
  <para style="q1" vid="ISA 64:2">tisi kɔŋ na ke yela n kɔlara ka gyeŋ n yele,</para>
  <para style="q2" vid="ISA 64:2">na ke yela tɛɛlese ke wosi n siaman!<verse eid="ISA 64:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 64:3" />Nawolo nyi debaŋ keŋ n be yɛɛ gyakoloŋ nombia keŋ de loo be gyakaa ya nɛ,</para>
  <para style="q2" vid="ISA 64:3">n tisiwɔ kɔŋ te bulase wosiwɔ n siaman.<verse eid="ISA 64:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 64:4" />Lenaŋ gyaŋgba keŋ nɛ, ŋolo te nyii ya,</para>
  <para style="q2" vid="ISA 64:4">deŋele daale te nyii ya,</para>
  <para style="q1" vid="ISA 64:4">sibii daale te naa Wurubuarɛ ŋolo kpuna neŋ,</para>
  <para style="q2" vid="ISA 64:4">ŋon ɔ ne kyɔ baŋ be loo gyakaa ɔ dɔɔ nɛ ya.<verse eid="ISA 64:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 64:5" />N na mo kenyaŋee kyɔ baŋ bɛɛ yɛɛ keŋ doo kegbɛɛ dɔɔ,</para>
  <para style="q2" vid="ISA 64:5">baŋ bɛɛ tɔɔse n gbɛɛneŋ nɛ.</para>
  <para style="q1" vid="ISA 64:5">Mɔna debaŋ keŋ de gyakaa dɛɛ yɛɛ dukum tia wɔ nɛ,</para>
  <para style="q2" vid="ISA 64:5">n gyeŋa baŋ.</para>
  <para style="q1" vid="ISA 64:5">Nɛnɛɛ sena yaa dɛɛ yɛɛ na dɛɛ nyiŋ kelɛɛ?<verse eid="ISA 64:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 64:6" />De popou yɛɛ ŋgba balaŋ baŋ bɔɔ do ba wose ayimɛɛ nɛ,</para>
  <para style="q2" vid="ISA 64:6">te de katenee pou yɛɛ ŋgba kakyeŋgbelaa keŋ dana ayimɛɛ nɛ.</para>
  <para style="q1" vid="ISA 64:6">De popou ta wolo ŋgba faareŋ nɛ,</para>
  <para style="q2" vid="ISA 64:6">te de dukum te kuu daa laŋ ŋgba feliŋ nɛ.<verse eid="ISA 64:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 64:7" />Ŋolo bɛɛ baake n yele,</para>
  <para style="q2" vid="ISA 64:7">yaa do kakyeŋ lɔ kyaŋ neŋ ya,</para>
  <para style="q1" vid="ISA 64:7">nawolo nyi n ta mo n sia weese daa,</para>
  <para style="q2" vid="ISA 64:7">te n moo daa fa de dukum.<verse eid="ISA 64:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 64:8" />Mɔna Degbeŋgyoo, nyaŋ yɛna de kya.</para>
  <para style="q2" vid="ISA 64:8">Daa yɛɛ degbaŋtɛɛle ke, te nyaŋ yɛɛna maare ŋon,</para>
  <para style="q2" vid="ISA 64:8">de popou yɛɛ n nyiŋmaa man tomse ŋa.<verse eid="ISA 64:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 64:9" />Naa gyeŋ baŋ gbaa ya,</para>
  <para style="q2" vid="ISA 64:9">naa tɔɔse de dukum kekpaakekpaa ya,</para>
  <para style="q1" vid="ISA 64:9">Ao, dɛɛ sola neŋ bo, gɛɛse kɛɛ daa,</para>
  <para style="q2" vid="ISA 64:9">nawolo nyi de popou yɛɛ n balaŋwɔ.<verse eid="ISA 64:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 64:10" />N donɔɔ fereŋkyeŋ keŋ ta bese depampaa,</para>
  <para style="q2" vid="ISA 64:10">Siyɔn koraŋ yɛɛ depampaa ke, te Yerusalɛm doo yakaa.<verse eid="ISA 64:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 64:11" />Be ta too,</para>
  <para style="q2" vid="ISA 64:11">de obuo na ɔsom deni fereŋkyeŋ keŋ man de naanaɔ na lese n yele nɛ,</para>
  <para style="q2" vid="ISA 64:11">te da abɔɔ kpaakpaa ŋan pou te wɔlɛɛ.<verse eid="ISA 64:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 64:12" />Kɛŋa pou wɔle na Degbeŋgyoo, n ke wɔŋ n wose lee wɔle?</para>
  <para style="q2" vid="ISA 64:12">N ke wuu n nɔɔ na n ke wɔŋ da deŋele beiŋ?<verse eid="ISA 64:12" /></para>
  <chapter eid="ISA 64" />
  <chapter number="65" style="c" sid="ISA 65" />
  <para style="s1">Nombiakedi na Nyeekelɛɛ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 65:1" />&lt;&lt;Ma lese ma wose wola baŋ ba te bɔɔse me dɔɔ ya nɛ,</para>
  <para style="q2" vid="ISA 65:1">baŋ ba te kɛo maŋ ya nɛ naa maŋ.</para>
  <para style="q1" vid="ISA 65:1">Tɛɛle keŋ kɔɔ gyeŋ ma yele ya nɛ,</para>
  <para style="q2" vid="ISA 65:1">Me yakowɔ nyiaa,&lt;&lt;Maŋ yaa, maŋ yaa.&gt;&gt;<verse eid="ISA 65:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 65:2" />Ma te fɛlɛɛ me nyiŋmaase wee pou</para>
  <para style="q2" vid="ISA 65:2">fa deŋele doŋtena,</para>
  <para style="q1" vid="ISA 65:2">baŋ be dɔŋ gbɛɛneŋ ŋan be dei ya nɛ dɔɔ,</para>
  <para style="q2" vid="ISA 65:2">baŋ be silana keŋ ba gyueŋ na wola wɔ nɛ,<verse eid="ISA 65:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 65:3" />balaŋ baŋ be gyakaa bɛɛ do maŋ baŋ</para>
  <para style="q2" vid="ISA 65:3">me siaman pɛɛ nɛ,</para>
  <para style="q1" vid="ISA 65:3">bɛɛ yɛɛ kedeesase wɔɔsebia man.</para>
  <para style="q2" vid="ISA 65:3">te bɛɛ too oliifi birikisi kedeesboya dɔɔ.<verse eid="ISA 65:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 65:4" />Balaŋ baŋ bɛɛ kyaa yebɔɔse man,</para>
  <para style="q2" vid="ISA 65:4">te bɛɛ yoo yɛɛ abɔɔ nelim pou,</para>
  <para style="q1" vid="ISA 65:4">baŋ bɛɛ tao kekuirii naaneŋ,</para>
  <para style="q2" vid="ISA 65:4">te naaneŋ anekɔlaŋ keyoŋ be wulu be saabuse nɛ,<verse eid="ISA 65:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 65:5" />baŋ bɛɛ yako nyi, &lt;Lee kɛbo, naa benaa maŋ ya,</para>
  <para style="q2" vid="ISA 65:5">nawolo nyi, me yɛɛ fereŋkyeŋ beiŋ fa neŋ!&gt;</para>
  <para style="q1" vid="ISA 65:5">Mena balaŋ benaŋ yɛɛ nyɔɔse ke ma memɔɔse man,</para>
  <para style="q2" vid="ISA 65:5">boalaŋ keŋ kɛɛ kpaa wee pou.<verse eid="ISA 65:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 65:6" />&lt;&lt;Kɛɛ, ba te ŋmarase see me siaman kɛbo nyiaa,</para>
  <para style="q2" vid="ISA 65:6">mɔɔ gyae maa wuu me nɔɔ ya mɔna maa tɔ wɔ ka kom nideli,</para>
  <para style="q2" vid="ISA 65:6">maa tɔ wɔ ka kom be siaman,<verse eid="ISA 65:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 65:7" />Ɛ dukum na ɛ naanaɔ dukum,</para>
  <para style="q2" vid="ISA 65:7">Degbeŋgyoo yakola.</para>
  <para style="q1" vid="ISA 65:7">&lt;&lt;Nawolo nyi ba too kedeesase bulase dɔɔ</para>
  <para style="q2" vid="ISA 65:7">te be walaa maŋ bulasebia ŋan dɔɔ,</para>
  <para style="q1" vid="ISA 65:7">maa maa baa ayɛŋ fa wɔ</para>
  <para style="q2" vid="ISA 65:7">na maa tɔ wɔ ba kom pou.&gt;&gt;<verse eid="ISA 65:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 65:8" />Nnɛ yaa Degbeŋgyoo ne yako,</para>
  <para style="q2" vid="ISA 65:8">&lt;&lt;Mena keŋ waen doo gerepo saase man,</para>
  <para style="q1" vid="ISA 65:8">te balaŋ ne yako nyi, &lt;Naa wɔlɛɛ ke ya,</para>
  <para style="q2" vid="ISA 65:8">nhira sɛɛ doo ke man nɛ,</para>
  <para style="q1" vid="ISA 65:8">mena te maa yɛɛ lee ma somera dɔɔ,</para>
  <para style="q2" vid="ISA 65:8">mɔɔ gyae maa wɔlɛɛ wɔ pou ya.<verse eid="ISA 65:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 65:9" />Maa mo Yakɔbe na Yuda duuluŋman balaŋ,</para>
  <para style="q2" vid="ISA 65:9">baŋ baa mo me bulase ŋan yɛɛ baa dedii,</para>
  <para style="q1" vid="ISA 65:9">me balaŋ baŋ mɔɔ lese see nɛ ne gyaela baa di ŋa,</para>
  <para style="q2" vid="ISA 65:9">botɔɔ te me somera baa kyaa.<verse eid="ISA 65:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 65:10" />Saron gyae ka bese namense dedii,</para>
  <para style="q2" vid="ISA 65:10">te Akore detaŋgya keŋ gyae ka bese nunkyuese dɛɛfɛɛfoe,</para>
  <para style="q1" vid="ISA 65:10">fa me balaŋ baŋ bɛɛ kɛo maŋ nɛ.<verse eid="ISA 65:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 65:11" />&lt;&lt;Mɔ ɛmɛɛ baŋ ɛ be bɛɛ Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 65:11">te ɛ be wolee me bula fereŋkyeŋ keŋ,</para>
  <para style="q1" vid="ISA 65:11">ɛmɛɛ baŋ ɛ ne fa bane Nyeebam kedi,</para>
  <para style="q2" vid="ISA 65:11">te ɛ na do waen keŋ bɔɔ kyakale wulu tasase fa bane Leesa nɛ,<verse eid="ISA 65:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 65:12" />maa mo ɛ leesa fa yoosila,</para>
  <para style="q2" vid="ISA 65:12">na baa koe ŋon pou,</para>
  <para style="q1" vid="ISA 65:12">nawolo nyi me baake ŋon mɔna ɛ te kpaa ya,</para>
  <para style="q2" vid="ISA 65:12">me kolosiwɔ mɔna ɛ te tei ya.</para>
  <para style="q1" vid="ISA 65:12">Ɛ yɛɛ dukum me siaman,</para>
  <para style="q2" vid="ISA 65:12">te ɛ yɛɛ keŋ mɔ ne gyae ya.&gt;&gt;<verse eid="ISA 65:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 65:13" />Mena dɔɔ nnɛ yaa Degbeŋgyoo Doŋ Pou Nyee ne yako,</para>
  <para style="q1" vid="ISA 65:13">&lt;&lt;Ma somera baa di,</para>
  <para style="q2" vid="ISA 65:13">mɔna ɛmɛɛ ɛ keta tanam,</para>
  <para style="q1" vid="ISA 65:13">ma somera baa nyɔɔ</para>
  <para style="q2" vid="ISA 65:13">mɔna ɛmɛɛ dɔɔ loŋboaneŋ gyae ka ko ŋon,</para>
  <para style="q1" vid="ISA 65:13">ma somera baa nyaŋee,</para>
  <para style="q2" vid="ISA 65:13">mɔna ɛmɛɛ dɔɔ desɛŋ gyae ke kyaŋ ŋon.<verse eid="ISA 65:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 65:14" />Ma somera baa kpee nɔɔneŋ,</para>
  <para style="q2" vid="ISA 65:14">lee kenyaŋee keŋ doo be konɔɔse man nɛ,</para>
  <para style="q1" vid="ISA 65:14">mɔna ɛmɛɛ dɔɔ ɛ ka mo waraŋsa</para>
  <para style="q2" vid="ISA 65:14">wii lee ɛ konɔɔse man.</para>
  <para style="q2" vid="ISA 65:14">na ɛ ke lɔ nɔɔ lee ɛ kaale man.<verse eid="ISA 65:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 65:15" />Ɛ ke tina ɛ yele yela,</para>
  <para style="q2" vid="ISA 65:15">fa me balaŋ baŋ mɔɔ lese nɛ ka mo falaa.</para>
  <para style="q1" vid="ISA 65:15">Degbeŋgyoo Doŋ Pou Nyee waa koe ŋon,</para>
  <para style="q2" vid="ISA 65:15">mɔna ɔ somera dɔɔ waa fa wɔ yele wɔle.<verse eid="ISA 65:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 65:16" />Ɔkamasɛ ŋon waa hiraa ɔ wose tɛɛle keŋ dɔɔ nɛ,</para>
  <para style="q2" vid="ISA 65:16">waa yɛɛ ke bo lee Wurubuarɛ anokoarete ŋon yele man,</para>
  <para style="q1" vid="ISA 65:16">ɔkamasɛ ŋon waa kaŋ ntam na,</para>
  <para style="q2" vid="ISA 65:16">waa kaŋ ntam lee Wurubuarɛ anokoarete ŋon yele man.</para>
  <para style="q1" vid="ISA 65:16">Nawolo nyi baa wolee gyaŋgba kaalese ŋan,</para>
  <para style="q2" vid="ISA 65:16">na baa weese ŋa lee me siaman,<verse eid="ISA 65:16" /></para>
  <para style="s1">Adido wɔle na tɛɛle wɔle</para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 65:17" />&lt;&lt; Kɛɛ, maa yɛɛ</para>
  <para style="q2" vid="ISA 65:17">adido wɔle na tɛɛle wɔle.</para>
  <para style="q1" vid="ISA 65:17">Bɔɔ gyae baa tɔɔse gyaŋgba nombia ŋan,</para>
  <para style="q2" vid="ISA 65:17">yaa baa gyueŋ ŋa bela ya.<verse eid="ISA 65:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 65:18" />Mɔna dɛɛ yɛɛ ŋon gyoŋ na ɛ ke nyaŋee kekpaakekpaa,</para>
  <para style="q2" vid="ISA 65:18">lee keŋ maa yɛɛ nɛ dɔɔ,</para>
  <para style="q1" vid="ISA 65:18">nawolo nyi maa yɛɛ Yerusalɛm na ka ke yɛɛ sia kagye,</para>
  <para style="q2" vid="ISA 65:18">te ɔ balaŋ baa nyaŋee.<verse eid="ISA 65:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 65:19" />Maa nyaŋee lee Yerusalɛm dɔɔ</para>
  <para style="q2" vid="ISA 65:19">na me sia kagye lee ɔ balaŋ dɔɔ,</para>
  <para style="q1" vid="ISA 65:19">bɔɔ gyae baa tekaa nyii,</para>
  <para style="q2" vid="ISA 65:19">kewii na kayeyɛɛ yeesa be man bela ya.<verse eid="ISA 65:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ISA 65:20" />&lt;&lt;Bɔɔ gyae baa tekaa naa</para>
  <para style="q2" vid="ISA 65:20">biikyaa ŋon ɔ te kyaa kelii ɔ weeya ɔto,</para>
  <para style="q2" vid="ISA 65:20">yaa kegyia ŋon ɔ be gyae waa kyaa kelii ɔ kulutooneŋ ɔto ya.</para>
  <para style="q1" vid="ISA 65:20">Ŋon waa di kulutooneŋ sɔŋonoŋ pɛte waa yeŋ na,</para>
  <para style="q2" vid="ISA 65:20">baa kɛɛ e ŋgba biikyaa nɛ.</para>
  <para style="q1" vid="ISA 65:20">te ŋon ɔ te nyiŋ kulutooneŋ sɔŋonoŋ ya te ɔ yem na,</para>
  <para style="q2" vid="ISA 65:20">baa kɛɛ ɔ yeŋ kenaŋ ŋgba kefaala nɛ.<verse eid="ISA 65:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 65:21" />Baa baŋee denɛɛ na baa kyaa ŋe man,</para>
  <para style="q2" vid="ISA 65:21">baa fara gerepo wɔɔse na baa di ŋe bia.<verse eid="ISA 65:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 65:22" />Bɔɔ gyae baa tekaa baŋee denɛɛ na baale ke kyaa ŋe man,</para>
  <para style="q2" vid="ISA 65:22">yaa baa duu na baale ke di ya.</para>
  <para style="q1" vid="ISA 65:22">Nawolo nyi mena keŋ daŋ na seŋ kyare nɛ,</para>
  <para style="q2" vid="ISA 65:22">mena te me balaŋ baa kyaa kyare,</para>
  <para style="q1" vid="ISA 65:22">me balaŋ baŋ mɔɔ lese nɛ baa di</para>
  <para style="q2" vid="ISA 65:22">lee ba tomse man.<verse eid="ISA 65:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 65:23" />Be kaale be gyae ke yɛɛ yakaa,</para>
  <para style="q2" vid="ISA 65:23">yaa baa lola bia baŋ be dana nyeekum ya,</para>
  <para style="q1" vid="ISA 65:23">Nawolo nyi baa yɛɛ balaŋ baŋ Degbeŋgyoo be hiraa,</para>
  <para style="q2" vid="ISA 65:23">baŋna be duuluŋman balaŋ.<verse eid="ISA 65:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 65:24" />Maa kpa wɔ pɛ baa baake maŋ,</para>
  <para style="q2" vid="ISA 65:24">bɛɛ kolosi na me te wulaa nyii.<verse eid="ISA 65:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 65:25" />Gbougbou na nam baa di debodokoloŋ,</para>
  <para style="q2" vid="ISA 65:25">dinaate waa tao ŋale ŋgba nunkyue baale nɛ,</para>
  <para style="q2" vid="ISA 65:25">te tɛɛle gyae ke yɛɛ dom weenɛɛ.</para>
  <para style="q1" vid="ISA 65:25">Bɔɔ gyae baa yɛɛ kolo kum yaa baa wɔlɛɛ</para>
  <para style="q2" vid="ISA 65:25">me bula fereŋkyeŋ keŋ dɔɔ ya,&gt;&gt;</para>
  <para style="q4" vid="ISA 65:25">Degbeŋgyoo yakola.<verse eid="ISA 65:25" /></para>
  <chapter eid="ISA 65" />
  <chapter number="66" style="c" sid="ISA 66" />
  <para style="s1">Nombia kedi na loo kegyakaa</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 66:1" />Nnɛ yaa Degbeŋgyoo ne yako,</para>
  <para style="q1" vid="ISA 66:1">&lt;&lt;Adido yɛɛ me gyoorogbeli ke,</para>
  <para style="q2" vid="ISA 66:1">te tɛɛle yɛɛ me nae dabetee.</para>
  <para style="q1" vid="ISA 66:1">Nde dekpaŋalaŋ keŋ n ke baŋ fa maŋ?</para>
  <para style="q2" vid="ISA 66:1">Aleŋ yaa me dɛɛfɛɛfoe gyae ke doo?<verse eid="ISA 66:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 66:2" />Na me nyiŋmaase yɛɛna abɔɔ kɛŋa pou,</para>
  <para style="q2" vid="ISA 66:2">te ŋe kɔŋawɔ yee?&gt;&gt;</para>
  <para style="q4" vid="ISA 66:2">Degbeŋgyoo torola yako.</para>
  <para style="b" vid="ISA 66:2" />
  <para style="q1" vid="ISA 66:2">Kɛwɔ yɛna baŋ maa boele wɔ,</para>
  <para style="q2" vid="ISA 66:2">baŋ be dukum ba wee wɔ te bɔɔ yɔkɔse ba wose,</para>
  <para style="q2" vid="ISA 66:2">te ba wose ne seree wɔ lee me nombia ŋan dɔɔ nɛ.<verse eid="ISA 66:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 66:3" />Mɔ ɔkamasɛ ŋon ɔ mo nunkyue baale deesi nɛ,</para>
  <para style="q2" vid="ISA 66:3">wɔɛ ŋgba ŋon ɔ ba ko walaŋ nɛ,</para>
  <para style="q1" vid="ISA 66:3">te ɔkamasɛ ŋon ɔ mo nambu deesi nɛ,</para>
  <para style="q2" vid="ISA 66:3">wɔɛ ŋgba ŋon ɔ be tekeri babaa wɔŋe nɛ,</para>
  <para style="q1" vid="ISA 66:3">ɔkamasɛ ŋon ɔ yɛɛ weenɛɛ kedeesa,</para>
  <para style="q2" vid="ISA 66:3">wɔɛ ŋgba ŋon ɔ ba mo kekuirii fatabo kaa deesi nɛ,</para>
  <para style="q1" vid="ISA 66:3">te ŋon ɔ too ketɔɔse oliifi nɛ</para>
  <para style="q2" vid="ISA 66:3">wɔɛ ŋgba ŋon ɔ na som bane nɛ.</para>
  <para style="q1" vid="ISA 66:3">Be ta mo baŋ gbagba be gbɛɛneŋ,</para>
  <para style="q2" vid="ISA 66:3">te be sia na gye be duwaare ayɛɛsa man,<verse eid="ISA 66:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 66:4" />mena dɔɔ maŋ mɔ maa yɛɛ wɔ nyeeman doŋ,</para>
  <para style="q2" vid="ISA 66:4">na maa yela keŋ bee yee nɛ kekɔŋ be dɔɔ.</para>
  <para style="q1" vid="ISA 66:4">Nawolo nyi me baake wɔ, mɔna ŋolo te kpaa ya.</para>
  <para style="q2" vid="ISA 66:4">ma ke kolosi nɛ, ŋolo te tei ya.</para>
  <para style="q1" vid="ISA 66:4">Be yɛɛ dukum me siaman,</para>
  <para style="q2" vid="ISA 66:4">te be yɛɛ keŋ mɔɔ ne gyae ya nɛ.&gt;&gt;<verse eid="ISA 66:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 66:5" />Ɛmɛɛ baŋ ɛ ne yee Degbeŋgyoo nombia nɛ,</para>
  <para style="q2" vid="ISA 66:5">ɛ nyii Degbeŋgyoo nombia.</para>
  <para style="q1" vid="ISA 66:5">&lt;&lt; Ɛmɛɛ gbagba ɛ balaŋ baa kɔla ŋon,</para>
  <para style="q2" vid="ISA 66:5">na baa bɛɛ ŋon lee ma yele dɔɔ na baa yako nyiaa,</para>
  <para style="q1" vid="ISA 66:5">&lt;Ɛ mo gyoorobiiri fa Degbeŋgyoo,</para>
  <para style="q2" vid="ISA 66:5">na dɛɛ naa ɛ kenyaŋee!&gt;</para>
  <para style="q2" vid="ISA 66:5">Mɔna desɛŋ gyae ke kyaŋ wɔ.<verse eid="ISA 66:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 66:6" />Ɛ nyii woya keŋkeŋ ŋan ba lee donɔɔ dinaa keŋ man,</para>
  <para style="q2" vid="ISA 66:6">ɛ nyii yeesa ŋan ba lee ɔsom deni dinaa keŋ man.</para>
  <para style="q1" vid="ISA 66:6">Ke yɛɛ Degbeŋgyoo woya ŋa,</para>
  <para style="q2" vid="ISA 66:6">ɔ ne tɔ ɔ kɔlara kom ŋgba mena keŋ kaboena wɔ nɛ.<verse eid="ISA 66:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 66:7" />&lt;&lt;Pɛ waa doŋee na,</para>
  <para style="q2" vid="ISA 66:7">ɔ ta lolo.</para>
  <para style="q1" vid="ISA 66:7">Pɛ waa nyii weeleŋ keŋ na,</para>
  <para style="q2" vid="ISA 66:7">ɔ ta lola bu baale.<verse eid="ISA 66:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 66:8" />Amɔte nyiina mena nombia kɛŋa see?</para>
  <para style="q2" vid="ISA 66:8">Amɔte naana nombia ŋgba kei nɛ see?</para>
  <para style="q1" vid="ISA 66:8">Baa tale lola donɔɔ wee dokoloŋ,</para>
  <para style="q2" vid="ISA 66:8">yaa baa tale lola tɛɛle karatetee dokoloŋ?</para>
  <para style="q1" vid="ISA 66:8">Mɔna Siyɔn dɔɔ ɔ na doŋee pɛ,</para>
  <para style="q2" vid="ISA 66:8">na ɔ ta lola ɔ bia.<verse eid="ISA 66:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 66:9" />Maŋ maa yela baa toro dokyoa,</para>
  <para style="q2" vid="ISA 66:9">te mɔɔ yele baa lola yee?&gt;&gt; Degbeŋgyoo yakola.</para>
  <para style="q1" vid="ISA 66:9">&lt;&lt;Maŋ ŋon mee yele bɛɛ lolo nɛ,</para>
  <para style="q2" vid="ISA 66:9">maa tɔ lolo gbɛɛ?&gt;&gt;</para>
  <para style="q2" vid="ISA 66:9">N Wurubuarɛ yakola.<verse eid="ISA 66:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 66:10" />&lt;&lt; Ɛmɛɛ baŋ pou ɛ ne gyae Yerusalɛm nɛ,</para>
  <para style="q2" vid="ISA 66:10">ɛ nyaŋeena Yerusalɛm na ɛ sia kagye fa e,</para>
  <para style="q1" vid="ISA 66:10">ɛmɛɛ baŋ pou ɛ be wii waraŋsa fa e nɛ,</para>
  <para style="q2" vid="ISA 66:10">ɛ nyaŋee nideli kpuna e.<verse eid="ISA 66:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 66:11" />Nawolo nyi ɛ ke ŋmase ɔ wɔe kefɛɛ dide,</para>
  <para style="q2" vid="ISA 66:11">na ɛ ke baa,</para>
  <para style="q1" vid="ISA 66:11">ɛ ke ŋmase ke burum</para>
  <para style="q2" vid="ISA 66:11">te ɛ sia gyae kagye lee mena keŋ kɛɛ lee burum nɛ dɔɔ.&gt;&gt;<verse eid="ISA 66:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 66:12" />Nawolo nyi nnɛ yaa Degbeŋgyoo ne yako,</para>
  <para style="q1" vid="ISA 66:12">&lt;&lt; Maa yela wosefɛɛreŋ ke waale e ŋgba boo nɛ,</para>
  <para style="q2" vid="ISA 66:12">te donɔɔse dedii gyae kekɔŋ ɔ gyaŋ ŋgba boŋobii kewuu nɛ,</para>
  <para style="q1" vid="ISA 66:12">waa ŋmase na baa tela e nyiŋmaase man</para>
  <para style="q2" vid="ISA 66:12">na waa yoi ɔ yoolaase dɔɔ.<verse eid="ISA 66:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 66:13" />Mena keŋ naa ne fɛɛ ɔ bu wɔe nɛ,</para>
  <para style="q2" vid="ISA 66:13">mena te maa fɛɛ ɛ wɔe,</para>
  <para style="q2" vid="ISA 66:13">na maa fɛɛ ɛ wɔe Yerusalɛm.<verse eid="ISA 66:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ISA 66:14" />Nyi akpaa ɛ naa mena na ɛ ke nyaŋee ɛ konɔɔse man,</para>
  <para style="q2" vid="ISA 66:14">na ɛ ke nyiŋ ɛ wose ŋgba ŋale nɛ,</para>
  <para style="q1" vid="ISA 66:14">baa naa Degbeŋgyoo nyiŋmaa ɔ somera dɔɔ,</para>
  <para style="q2" vid="ISA 66:14">mɔna waa lese ɔ baŋkum keŋ wola ɔ kɔlara.<verse eid="ISA 66:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 66:15" />Kɛɛ Degbeŋgyoo ne kɔŋna boalaŋ</para>
  <para style="q2" vid="ISA 66:15">ɔ yookɔtase yɛɛ ŋgba koloŋoloŋ nɛ,</para>
  <para style="q1" vid="ISA 66:15">waa lese ɔ baŋ wola nideli,</para>
  <para style="q2" vid="ISA 66:15">te ɔ ke kalana kpuuna boalaŋ kekpa.<verse eid="ISA 66:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 66:16" />nawolo nyi Degbeŋgyoo waa mo boalaŋ,</para>
  <para style="q2" vid="ISA 66:16">na yoosila di balaŋ pou nombia,</para>
  <para style="q2" vid="ISA 66:16">te balaŋ burum yɛna baŋ Degbeŋgyoo waa koe.<verse eid="ISA 66:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 66:17" />&lt;&lt;Baŋ bɔɔ gberaa ba wose te bɔɔ desina ba wose na baa gyoo wɔɔbii keŋ man, te be silana ŋon ɔ dɔŋ baŋ bɛɛ tao kekuirii naane na kyakaa na abɔɔ ŋan dana ayimɛɛ siaman nɛ, baa wɔlɛɛ wɔ kpuna ŋon be silana nɛ.&gt;&gt; Degbeŋgyoo torola yako.<verse eid="ISA 66:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 66:18" />&lt;&lt;Te maŋ dɔɔ, lee keŋ bɔɔ gyueŋ te bɔɔ yɛɛ dɔɔ nɛ, mɛɛ gyae maa kɔŋ na me kaa yilaa tɛɛlese na deise, na baa kɔŋ na be kaa naa me gyoorobiiri.<verse eid="ISA 66:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 66:19" />&lt;&lt;Maa yɛɛ kagyene be man, na maa kpila baŋ be kyaa nɛ man baale gyu tɛɛlese gyaŋ. Maa kpila wɔ gyu Taresisitena na Libiatena na Lidiatena na Tubaletena na Gerisetena na baŋ be kyaa boo nɔɔnɔɔ, te be te nyiita me gyakoloŋ nombia yaa naa me gyoorobiiri ya nɛ gyaŋ. Baa gyɔ me gyoorobiiri keŋ dekpeŋkpeŋ tɛɛlese man. <verse eid="ISA 66:19" /><verse number="20" style="v" sid="ISA 66:20" />Te baa mo ɛ balaŋ pou lee tɛɛlese ŋan pou man kɔŋ, baa kyaa dɛɛkyɔŋse na yookɔtase, na gbeli anebakeŋ na kurumɔɔse na afurumse dɔɔ kɔŋ me bula fereŋkyeŋ keŋ ke kyaa Yerusalɛm nɛ, na ke yɛɛ kedeesa fa Degbeŋgyoo. Degbeŋgyoo yakola. Baa mo wɔ kɔŋ ŋgba mena keŋ Iseraetena na mo weenɛɛ kedeesa kɔŋ kaa do Degbeŋgyoo Ɔsom deni kuruwaase fereŋkyeŋ ŋan man nɛ. <verse eid="ISA 66:20" /><verse number="21" style="v" sid="ISA 66:21" />Maa lese be man baale yɛɛ saese na Lewitena,&gt;&gt; Degbeŋgyoo yakola.<verse eid="ISA 66:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 66:22" />&lt;&lt;Mena keŋ adido wɔle na tɛɛle wɔle keŋ mɔɔ yɛɛ gyae ke kyaa kekpaakekpaa nɛ, mena te n yele na n duuluŋ man balaŋ baa kyaa kekpaakekpaa. Degbeŋgyoo yakola. <verse eid="ISA 66:22" /><verse number="23" style="v" sid="ISA 66:23" />Lee gyaalaŋ wɔle kelii gyaalaŋ wɔle, lee kefɛɛfowee kelii kefɛɛfowee nɛ, denibalaŋ pou baa kɔŋ na be kaa buŋ maŋ.&gt;&gt; Degbeŋgyoo yakola. <verse eid="ISA 66:23" /><verse number="24" style="v" sid="ISA 66:24" />&lt;&lt;Baa gyu ke kɛo woya baŋ bɔɔ yɛɛ deŋele doŋ tia maŋ nɛ. Feelɛɛ baŋ bɔɔ gyoo wɔ nɛ be gyae baa yeŋ ya, te boalaŋ keŋ kɔɔ kpa wɔ be gyae ka yeŋ ya, te baa yɛɛ duwaare fa denibalaŋ pou.&gt;&gt;<verse eid="ISA 66:24" /></para>
  <chapter eid="ISA 66" />
</usx>