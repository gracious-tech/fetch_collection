<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Ntrubo Old Testament Project</book>
  <para style="h">Aduya</para>
  <para style="toc1">Aduya Tɔne</para>
  <para style="toc2">Aduya</para>
  <para style="toc3">Adu</para>
  <para style="mt1">Aduya Tɔne</para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="s">Aduya Na Lee Koya</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />Iserae gyoo Dawide bu Solomɔn aduya.<verse eid="PRO 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2" />Ŋɛɛ fa nyansa na nombia kawola,</para>
  <para style="q2" vid="PRO 1:2">na waa nyii nombia man nideli.<verse eid="PRO 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3" />Ŋɛɛ wola e na waa tela ɔ wose nideli,</para>
  <para style="q2" vid="PRO 1:3">waa yɛɛ keŋ tenɛɛ na nombia kedi kegbɛɛ dɔɔ, siaman kekɛɛ be doo ya,<verse eid="PRO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4" />na baa mo wola baŋ bɔɔ gyeŋ daale ya nɛ nyansa,</para>
  <para style="q2" vid="PRO 1:4">tewulɛɛ sia ne kare te bɛɛ gyeŋ nombia.<verse eid="PRO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5" />Siakaralate waa tei na waa mo kpuna keŋ ɔ gyeŋ,</para>
  <para style="q2" vid="PRO 1:5">na ke gyee ŋon ɔ ne nyii nombia nawolo nɛ.<verse eid="PRO 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6" />Fa aduya na alagyia,</para>
  <para style="q2" vid="PRO 1:6">na deboloose man.<verse eid="PRO 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7" />Degbeŋgyoo keyee yɛna nombia kagyeŋ kewalaŋ,</para>
  <para style="q2" vid="PRO 1:7">mɔna ayiŋtena bɛɛ mo nyansa na nombia kawola yɛɛ kolo ya.<verse eid="PRO 1:7" /></para>
  <para style="s1">Kefaree Lee Dukumyɛɛra Woseman</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8" />Me bu, tei n kya nombia kawola,</para>
  <para style="q2" vid="PRO 1:8">na bɛɛ n naa kawola ya.<verse eid="PRO 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9" />Ŋe yɛɛ akelegyi keŋ ne wuu n nyee,</para>
  <para style="q2" vid="PRO 1:9">na agbaraagbaraa keŋ ne mia n wɔŋe.<verse eid="PRO 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10" />Me bu, akpaa nombiakumɛɛ yɛɛra na beo neŋ nɛ,</para>
  <para style="q2" vid="PRO 1:10">na nyii wɔ ya.<verse eid="PRO 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11" />Akpaa be yako nyi, &lt;&lt;Kɔŋ dee gyu,</para>
  <para style="q2" vid="PRO 1:11">yela de kaa deke ŋon ɔ nombia dei,</para>
  <para style="q2" vid="PRO 1:11">yela de kaa yo ko ŋon ɔ te yɛɛ dukum ya,<verse eid="PRO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12" />yela dee lila wɔ sia fonɛɛ ŋgba yebɔɔ nɛ,</para>
  <para style="q2" vid="PRO 1:12">be dibiliŋ pou ŋgba baŋ bɛɛ tisi gyoo woyadɛɛ nɛ,<verse eid="PRO 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13" />dee nyiŋ abɔɔ ŋan na lee koya kpookpoo pou,</para>
  <para style="q2" vid="PRO 1:13">na dɛɛ mo yooman abɔɔ wulu da akpaŋalaŋse,<verse eid="PRO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14" />ɛ kpuna daa dɛɛ lɔ boe,</para>
  <para style="q2" vid="PRO 1:14">na dɛɛ kpala ŋmɛɛleŋ abɔɔ ŋan.&gt;&gt;<verse eid="PRO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15" />Me bu, na sila wɔ gyu ya,</para>
  <para style="q2" vid="PRO 1:15">na tɛɛ be dɛɛtɛe man ya.<verse eid="PRO 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16" />Nawolo nyi bɛɛ barase yɛɛ dukum,</para>
  <para style="q2" vid="PRO 1:16">be dana ɔsaa balaŋ kako man.<verse eid="PRO 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17" />Ke yɛɛ yakaa nyi n ke nyɔɔ kɔta peŋteŋpereiŋ man,</para>
  <para style="q2" vid="PRO 1:17">keŋ gyebu ŋon ne naa ke.<verse eid="PRO 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18" />Mena balaŋ kɛwɔ ne nyɔɔ baŋ gbagba wose kɔta bo,</para>
  <para style="q2" vid="PRO 1:18">baŋ gbagba ne gyaela baa gyoo ŋe man.<verse eid="PRO 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19" />Mena te baŋ pou bɛɛ mo gbɛɛkum gyae abɔɔ nɛ gbɛɛneŋ doo,</para>
  <para style="q2" vid="PRO 1:19">bɛɛ mo ba nyeedoŋ bo kyɛɛkena ŋa.<verse eid="PRO 1:19" /></para>
  <para style="s1">Nyansa Kekalana</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20" />Nyansa ne lɔ nɔɔ baake abɔntere man,</para>
  <para style="q2" vid="PRO 1:20">ɔ ne gyina ɔ woya balaŋ dɛɛgyaŋee man,<verse eid="PRO 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21" />ɔ ne lɔ nɔɔ baake lee denɛɛ nyeeya dɔɔ,</para>
  <para style="q2" vid="PRO 1:21">ɔ ne yako ɔ nombia donɔɔ dinaa keŋ denaanɔɔ man,<verse eid="PRO 1:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22" />&lt;&lt;Kelii woromɔ yaa ɛmɛɛ baŋ ɛ be doo daale man ya ɛ ke gyakaa ɛ diyiŋ nombia keyɛɛ dɔɔ?</para>
  <para style="q2" vid="PRO 1:22">Kelii woromɔ yaa baŋ bee kulu balaŋ nɛ baa nyaŋee lee balaŋ kekulu man,</para>
  <para style="q2" vid="PRO 1:22">na ayiŋtena ke kɔla nombia kagyeŋ?<verse eid="PRO 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23" />Me kalena ŋon na ɛ kyɛɛkee.</para>
  <para style="q2" vid="PRO 1:23">kenaŋ na maa lese ma nyeempɔ wola ŋon,</para>
  <para style="q2" vid="PRO 1:23">na maa yela ɛ ka gyeŋ me kawolase.<verse eid="PRO 1:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24" />Mɔna me baakewɔ te ɛ bɛɛwɔ ɛ te tei maŋ ya,</para>
  <para style="q2" vid="PRO 1:24">te ma tenee me nyiŋmaa mɔna ŋolo ta mo ke yɛɛ kolo ya,<verse eid="PRO 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25" />ɛ tɔɔ ɛ deŋela lee ma kekolosifa pou man,</para>
  <para style="q2" vid="PRO 1:25">te ɛ te lɛɛ ma kekalana ŋon keŋ do ya,<verse eid="PRO 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26" />nyi nombiikum de yala ŋon,</para>
  <para style="q2" vid="PRO 1:26">kayeyɛɛ de kɔŋ ɛ dɔɔ,<verse eid="PRO 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27" />nyi kayeyɛɛ de kɔŋ ɛ dɔɔ ŋgba feliŋkum,</para>
  <para style="q2" vid="PRO 1:27">yaa nombiikum de yala ŋon ŋgba koloŋoloŋ wuula ɛ dɔɔ,</para>
  <para style="q2" vid="PRO 1:27">yaa wose kekyaŋ na diyem de kɔŋ ɛ dɔɔ na maŋ mɔ maa boŋo ŋon na maa kulu ŋon.<verse eid="PRO 1:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28" />&lt;&lt;Kenaŋ na baa baake maŋ, mɔna mɔɔ gyae maa kpa wɔ ya,</para>
  <para style="q2" vid="PRO 1:28">baa kɛo maŋ mɔna bɔɔ gyae baa naa maŋ ya.<verse eid="PRO 1:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29" />Nawolo nyi be kɔla nombia kagyeŋ,</para>
  <para style="q2" vid="PRO 1:29">te ba te gyae nyi baa yee Degbeŋgyoo ya.<verse eid="PRO 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30" />Keŋ bɔɔ bɛɛ me nombia kekolosifa,</para>
  <para style="q2" vid="PRO 1:30">te be ta mo ma kekalana yɛɛ kolo ya,<verse eid="PRO 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31" />mena dɔɔ baa di be nombia ayɛɛsa bia,</para>
  <para style="q2" vid="PRO 1:31">na ba nyeeman kebake ke baa wɔ.<verse eid="PRO 1:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32" />Nawolo nyi baŋ bɔɔ gyeŋ daale ya kehuhoori gyae ka ko wɔ,</para>
  <para style="q2" vid="PRO 1:32">te ayiŋtena wose kelɛɛdi gyae ke munu wɔ.<verse eid="PRO 1:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33" />Mɔna ɔkamasɛ ŋon ɔ ne nyii me dei nɛ waa kyaa wɔe kefɛɛ man,</para>
  <para style="q2" vid="PRO 1:33">na waa kyaa deŋele kefɛɛ man keŋ ɔ be yee dukum ya.&gt;&gt;<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s1">Tɔnɔɔ Keŋ Doo Nyansa Man</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1" />Me bu, akpaa n lɛɛ me nombia do,</para>
  <para style="q2" vid="PRO 2:1">te n mo maŋ mmaraase do n konɔɔ man,<verse eid="PRO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2" />te n see deŋele tei nyansa,</para>
  <para style="q2" vid="PRO 2:2">te n mo nombia man kenyii do n konɔɔ man,<verse eid="PRO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3" />te n yase n sia gyoo ŋe man,</para>
  <para style="q2" vid="PRO 2:3">te n baake nombia man kenyii keŋkeŋ,<verse eid="PRO 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4" />te n kɛo ke ŋgba kɔba wolom,</para>
  <para style="q2" vid="PRO 2:4">te n yase sia kɛo ke ŋgba kolo kpaakpaa keŋ weesɛɛ nɛ,<verse eid="PRO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5" />kenaŋ na n ke nyii Degbeŋgyoo keyee nawolo,</para>
  <para style="q2" vid="PRO 2:5">na n kena Wurubuarɛ nombia kagyeŋ man.<verse eid="PRO 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6" />Nawolo nyi Degbeŋgyoo ne faana nyansa,</para>
  <para style="q2" vid="PRO 2:6">ɔ nɔɔman te nombia man kagyeŋ na nombia man kenyii na lee.<verse eid="PRO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7" />Ɔ ne desina kede see fa baŋ be gbɛɛneŋ tenɛɛ,</para>
  <para style="q2" vid="PRO 2:7">ŋon yɛna baŋ nombiikum be doo ba kekyaabii man ya nɛ yoo nyeele pampasaŋ.<verse eid="PRO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8" />Nawolo nyi ɔ ne gyee baŋ bee di nombia kegbɛɛ dɔɔ nɛ gbɛɛneŋ,</para>
  <para style="q2" vid="PRO 2:8">te ɔ ne kɛɛ baŋ bee di anokoare fa e nɛ keta man.<verse eid="PRO 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9" />Kenaŋ na nyaŋ ke nyii kpene keŋ doona kegbɛɛ, na nombia kedi ke gbɛɛ dɔɔ,</para>
  <para style="q2" vid="PRO 2:9">na keŋ siaman kekɛɛ be doo ya na gbɛɛ kpaakpaa kamasɛ.<verse eid="PRO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10" />Nawolo nyi nyansa gyae ka gyoo n konɔɔ man,</para>
  <para style="q2" vid="PRO 2:10">na nombia kagyeŋ ke yɛɛ neŋ gyoŋ nideli.<verse eid="PRO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11" />N nyeeman nombia kpaakpaa gyae ke kɛɛ n dɔɔ,</para>
  <para style="q2" vid="PRO 2:11">na nombia man kenyii ke gyee neŋ.<verse eid="PRO 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12" />Nyansa gyae ke lɛɛ n nyee lee akpanyanyaŋtena gbɛɛneŋ man,</para>
  <para style="q2" vid="PRO 2:12">lee baŋ bee tulii nombia nyiŋmaa man.<verse eid="PRO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13" />Baŋ bɔɔ tina gbɛɛneŋ ŋan tenɛɛ nɛ yela,</para>
  <para style="q2" vid="PRO 2:13">gyu be dɔŋ detiŋtɛɛ gbɛɛneŋ man.<verse eid="PRO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14" />Baŋ nombiakumɛɛ keyɛɛ na gyoo be sia,</para>
  <para style="q2" vid="PRO 2:14">te bɛɛ nyaŋee lee nombia nkaraŋkaraŋ keyɛɛ man.<verse eid="PRO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15" />Baŋ be gbɛɛneŋ be gɛɛse,</para>
  <para style="q2" vid="PRO 2:15">te bɔɔ ne di anokoare be gbɛɛneŋ man ya.<verse eid="PRO 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16" />Nyansa gyae ke lɛɛ n nyee lee alo ŋon ɔ ba mo ayimɛɛ wuu ɔ wose nɛ gyaŋ,</para>
  <para style="q2" vid="PRO 2:16">lee alo ohuhoo ŋon ɔ na mo nɔɔwoya gyoŋ nyiŋan beo balaŋ nɛ gyaŋ.<verse eid="PRO 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17" />Ŋon bɛɛna wa alebiiritɛɛ baale,</para>
  <para style="q2" vid="PRO 2:17">te ɔ bɛɛ nɔɔkebakesee keŋ ɔ be yɛɛ Wurubuarɛ siaman nɛ.<verse eid="PRO 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18" />Ampaŋ ɔ dekpaŋalaŋ ne gyu yeŋ man,</para>
  <para style="q2" vid="PRO 2:18">te ɔ gbɛɛneŋ ne gyu woyadɛɛ.<verse eid="PRO 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19" />Ŋolo bee gyu ɔ gyaŋ bese kɔŋ ya,</para>
  <para style="q2" vid="PRO 2:19">yaa waa nyiŋ nyeedoŋ bela ya.<verse eid="PRO 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20" />Mena dɔɔ ta balaŋ kpaakpaa gbɛɛneŋ man,</para>
  <para style="q2" vid="PRO 2:20">na n keta baŋ be gbɛɛneŋ tenɛɛ nɛ dɛɛtɛe man.<verse eid="PRO 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21" />Nawolo nyi baŋ be gbɛɛneŋ tenɛɛ nɛ ne gyaela baa kyaa tɛɛle keŋ dɔɔ,</para>
  <para style="q2" vid="PRO 2:21">na baŋ nombiikum be doo be man ya nɛ ke ka ke dɔɔ.<verse eid="PRO 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22" />Mɔna baa munu akpanyanyaŋtena lee tɛɛle keŋ dɔɔ,</para>
  <para style="q2" vid="PRO 2:22">na baa wɔlɛɛ baŋ bɔɔ ne di anokoare ya nɛ lee ke dɔɔ.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s1">Nyansa Na Mo Abɔɔ Kpaakpaa Kɔŋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1" />Me bu, na wolee me kawola ya,</para>
  <para style="q2" vid="PRO 3:1">mɔna mo ma mmaraase ŋan do n konɔɔ man.<verse eid="PRO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2" />Nawolo nyi ŋe gyae ke yela n kulutooneŋ ka bo,</para>
  <para style="q2" vid="PRO 3:2">na ka mo wosefɛɛreŋ kɔna neŋ.<verse eid="PRO 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3" />Na yele kegyae keŋ taŋ ɔto ya na anokoare kedi ke paŋ neŋ ya,</para>
  <para style="q2" vid="PRO 3:3">mo kpaŋna n wɔŋe,</para>
  <para style="q2" vid="PRO 3:3">ŋmarase ŋa gyakaa n konɔɔ dɔɔ.<verse eid="PRO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4" />Kenaŋ na waa boele neŋ na n ke nyiŋ yele kpaakpaa,</para>
  <para style="q2" vid="PRO 3:4">Wurubuarɛ na balaŋ siaman.<verse eid="PRO 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5" />Mo n konɔɔ pou lɔ Degbeŋgyoo dɔɔ,</para>
  <para style="q2" vid="PRO 3:5">na mo n wose lɔ nyaŋ gbagba n nombia man kenyii dɔɔ ya.<verse eid="PRO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6" />Yɔkɔse n wose fa e n kekyaabii man pou,</para>
  <para style="q2" vid="PRO 3:6">ŋon ne gyaela waa tenee n detɛe man.<verse eid="PRO 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7" />Na kɛɛ n wose nyi n sia te kare ya,</para>
  <para style="q2" vid="PRO 3:7">yee Degbeŋgyoo na n ke bɛɛ dukum keyɛɛ.<verse eid="PRO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8" />Kei gyae ka do n wose doŋ,</para>
  <para style="q2" vid="PRO 3:8">na ke desina n wose.<verse eid="PRO 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9" />Mo nya dedii,</para>
  <para style="q2" vid="PRO 3:9">na n weenɛɛ gyaŋgba nyiŋan pou do Degbeŋgyoo obuo.<verse eid="PRO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10" />Kenaŋ na n kpeese gyae ke wulu leki,</para>
  <para style="q2" vid="PRO 3:10">na waen wɔle ke wulu nyɔ osuŋse belebelebele.<verse eid="PRO 3:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11" />Me bu, nyi Degbeŋgyoo da tenee neŋ nɛ, na bɛɛ ke ya,</para>
  <para style="q2" vid="PRO 3:11">nyi ɔ kalena neŋ nɛ, na yele ke takaa neŋ ya.<verse eid="PRO 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12" />Nawolo nyi Degbeŋgyoo na tenee baŋ ɔ ne gyae wɔ,</para>
  <para style="q2" vid="PRO 3:12">ŋgba mena keŋ kya ne yɛɛ ɔ bu ŋon ɔ na gyoo ɔ sia nɛ.<verse eid="PRO 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13" />Baŋ ba gyeŋ nyansa,</para>
  <para style="q2" vid="PRO 3:13">na baŋ bee nyii nombia man nɛ, baŋna nyeebam.<verse eid="PRO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14" />Nawolo nyi ɔ dana tɔnɔɔ burum kela kɔba wolom,</para>
  <para style="q2" vid="PRO 3:14">te abɔɔ kpaakpaa na lee ɔ man kela kɔba yayam.<verse eid="PRO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15" />Ɔ na lee koya kela kegyaŋase kpaakpaa nyiŋan,</para>
  <para style="q2" vid="PRO 3:15">kpene keŋ ne gyɔ neŋ loo be maana e ya.<verse eid="PRO 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16" />Kabee kyare doo ɔ dunoluŋ nyiŋmaa man,</para>
  <para style="q2" vid="PRO 3:16">te wose kenyiŋ na obuo doo ɔ demena nyiŋmaa man.<verse eid="PRO 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17" />Ɔ gbɛɛneŋ na gyoo sia,</para>
  <para style="q2" vid="PRO 3:17">ɔ detɛe pou yɛɛ wosefɛɛreŋ.<verse eid="PRO 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18" />Ɔ yɛɛ nyeedoŋ daŋ ke fa baŋ bɛɛ kyaŋ e,</para>
  <para style="q2" vid="PRO 3:18">baa hiraa baŋ bɛɛ kyaŋ e keŋkeŋ nɛ.<verse eid="PRO 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19" />Nyansa te Degbeŋgyoo moowɔ see tɛɛle mokɔɔ,</para>
  <para style="q2" vid="PRO 3:19">nombia man kenyii te ɔ moowɔ see adido.<verse eid="PRO 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20" />Ɔ nombia kagyeŋ man te ɔ yela loŋse puuwɔ lee,</para>
  <para style="q2" vid="PRO 3:20">te debuŋta yela obosuo yalawɔ.<verse eid="PRO 3:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21" />Me bu, kyaŋ nyansa na nombia kenyii man,</para>
  <para style="q2" vid="PRO 3:21">na yele ŋe ka lee n nyiŋmaa man ya.<verse eid="PRO 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22" />Ŋe gyae ke yela n ka bee kyare,</para>
  <para style="q2" vid="PRO 3:22">na n ke nyiŋ obuo.<verse eid="PRO 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23" />Kenaŋ na nyaŋ ke ta n gbɛɛ wɔe kefɛɛ man,</para>
  <para style="q2" vid="PRO 3:23">te n be gyae n ke gyɔ n nae ya.<verse eid="PRO 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24" />Akpaa n tisi doo na, n be gyae n ke yee ya,</para>
  <para style="q2" vid="PRO 3:24">akpaa n tisi doo na, n dosoroŋ gyae ke yɛɛ gyoŋ.<verse eid="PRO 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25" />Nyi nombiikum de yale karatetee,</para>
  <para style="q2" vid="PRO 3:25">yaa kewɔlɛɛ de yala akpanyanyaŋtena nɛ na yee ya.<verse eid="PRO 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26" />Nawolo nyi Degbeŋgyoo waa kpuna neŋ,</para>
  <para style="q2" vid="PRO 3:26">keŋ ɔ be gyae waa yela n nae ka gyoo kɔta man ya.<verse eid="PRO 3:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27" />Akpaa gbɛɛ doo na,</para>
  <para style="q2" vid="PRO 3:27">na bɛɛ deeli keyɛɛ fa baŋ kaboena nyi nya yɛɛ fa wɔ ya.<verse eid="PRO 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28" />Na yako fa n dɔɔ nyi,</para>
  <para style="q2" vid="PRO 3:28">&lt;&lt;Gyu n ke kɔŋ kyoo na maa fa neŋ,&gt;&gt;</para>
  <para style="q2" vid="PRO 3:28">lee keŋ n dana kpene kenaŋ ya.<verse eid="PRO 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29" />N dɔɔ ŋon ɔ kyaa benaana neŋ te ɔ na mo ɔ wose lɔ n dɔɔ nɛ,</para>
  <para style="q2" vid="PRO 3:29">na bake ɔ nyeeman nombiikum,<verse eid="PRO 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30" />Na mo nombii gyakaa ŋolo dɔɔ yakaa,</para>
  <para style="q2" vid="PRO 3:30">lee keŋ ɔ te yɛɛ neŋ kolokum ya.<verse eid="PRO 3:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31" />Na yoo nyeemandoŋte ŋolo nuŋkurili,</para>
  <para style="q2" vid="PRO 3:31">yaa n ke yɛɛ wa abɔɔ ayɛɛsa ŋaale ya.<verse eid="PRO 3:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32" />Nawolo nyi Degbeŋgyoo ne kɔla nombiakumɛɛ yɛɛra,</para>
  <para style="q2" vid="PRO 3:32">mɔna loŋ bɛɛ lam ŋon na baŋ be gbɛɛneŋ tenɛɛ nɛ nsana ya.<verse eid="PRO 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33" />Degbeŋgyoo kefaala gyakaa akpanyanyaŋtena dekpaŋalaŋ dɔɔ,</para>
  <para style="q2" vid="PRO 3:33">mɔna ɔ ne hiraa baŋ be gbɛɛneŋ tenɛɛ nɛ denimantena.<verse eid="PRO 3:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34" />Ɔ ne kulu baŋ bee kulu balaŋ nɛ,</para>
  <para style="q2" vid="PRO 3:34">mɔna ɔ na boele baŋ bɛɛ yɔkɔse ba wose nɛ.<verse eid="PRO 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35" />Nyansatena baa nyiŋ obuo,</para>
  <para style="q2" vid="PRO 3:35">mɔna ayiŋtena baa di desɛŋ.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s1">Gyae Nyansa Gbɛɛ Kamasɛ Man</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1" />Me bia, ɛ tei ɛ kyaɔ nombia kawola,</para>
  <para style="q2" vid="PRO 4:1">ɛ tei ŋa nideli na ɛ ke nyii nombia man.<verse eid="PRO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2" />Nombia kpaakpaa yaa mɛɛ wola ŋon,</para>
  <para style="q2" vid="PRO 4:2">mena dɔɔ ɛ na bɛɛ me nombia kawola ya.<verse eid="PRO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3" />Nawolo nyi na maŋ mɔ yɛɛ bu e fa me kya,</para>
  <para style="q2" vid="PRO 4:3">me yɛɛ biikyaabii e te me naa ne gyae me nombia.<verse eid="PRO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4" />Keŋte ɔ wola maŋ te ɔ yako maŋ nyiaa,</para>
  <para style="q2" vid="PRO 4:4">&lt;&lt;Mo n konɔɔ pou kyaŋ me nɔɔwoya,</para>
  <para style="q2" vid="PRO 4:4">di ma mmaraase dɔɔ na n ke kyaa kyare.<verse eid="PRO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5" />Gyeŋ nyansa, nyii nombia man,</para>
  <para style="q2" vid="PRO 4:5">na wolee me nɔɔwoya yaa n ka lee ŋe wɔle ya.<verse eid="PRO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6" />Na bɛɛ nyansa ya, na waa gyee neŋ,</para>
  <para style="q2" vid="PRO 4:6">gyae e na waa kɛɛ n dɔɔ.<verse eid="PRO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7" />Nyansa kewalaŋ yaa, gyae nyansa,</para>
  <para style="q2" vid="PRO 4:7">mo ŋan pou n dana gyae nombia man kenyii.<verse eid="PRO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8" />Gyae e nideli, na waa gyina neŋ adido,</para>
  <para style="q2" vid="PRO 4:8">pukaa e na waa do neŋ obuo.<verse eid="PRO 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9" />Waa mo abotire kpaakpaate bake n nyee,</para>
  <para style="q2" vid="PRO 4:9">na waa mo gyooro kotɔtɔɔ kpaakpaate wuu neŋ.<verse eid="PRO 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10" />Me bu tei maŋ, na n ke lɛɛ keŋ maa yako neŋ nɛ do,</para>
  <para style="q2" vid="PRO 4:10">na n kulutooneŋ ka bo.<verse eid="PRO 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11" />Nyansa gbɛɛ yaa ma wola neŋ,</para>
  <para style="q2" vid="PRO 4:11">te ma moo neŋ ta gbɛɛneŋ tee dɔɔ.<verse eid="PRO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12" />Akpaa n dɔŋ na, kolo be tɔ n nawɔɔ kekulu gbɛɛ ya,</para>
  <para style="q2" vid="PRO 4:12">akpaa n yeu na, ne be gyɔ nae ya.<verse eid="PRO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13" />Kyaŋ nombia kawola man keŋkeŋ, na tina ke yela ya,</para>
  <para style="q2" vid="PRO 4:13">gyee ke nideli, nawolo nyi keŋ yɛna n nyeedoŋ.<verse eid="PRO 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14" />Na tɛɛ akpanyanyaŋtena dɛɛtɛe man,</para>
  <para style="q2" vid="PRO 4:14">yaa n ke ta nombiakumɛɛ yɛɛra gbɛɛneŋ man ya.<verse eid="PRO 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15" />Bɛɛ ke, na tɛɛ ke dɔɔ ya,</para>
  <para style="q2" vid="PRO 4:15">kpase lee ke dɔɔ na n ka mo n gbɛɛ laŋ.<verse eid="PRO 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16" />Nawolo nyi akpaa ba te yɛɛta dukum ya na bɔɔ ne doo ya,</para>
  <para style="q2" vid="PRO 4:16">nyi ba ta wɔŋ ŋolo lɔ ya na, be sibii bee wuu ya.<verse eid="PRO 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17" />Akpanyanyaŋ keyɛɛ yɛna be weenɛɛ anediŋ,</para>
  <para style="q2" vid="PRO 4:17">te nyeemandoŋ keyɛɛ yɛna ba soloŋ keŋ bɛɛ nyɔɔ.<verse eid="PRO 4:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18" />Baŋ be gbɛɛneŋ tenɛɛ detɛe yɛɛ ŋgba weese kebɛɛ nɛ,</para>
  <para style="q2" vid="PRO 4:18">kɛɛ ŋalakee menɛɛ kelii weese kabee.<verse eid="PRO 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19" />Mɔ akpanyanyaŋtena gbɛɛ yɛɛ ŋgba detiŋtɛɛ tuum nɛ,</para>
  <para style="q2" vid="PRO 4:19">bɔɔ gyeŋ botɔɔ keŋ baa gyɔ nae ya.<verse eid="PRO 4:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20" />Me bu, tei keŋ mɛɛ yako neŋ,</para>
  <para style="q2" vid="PRO 4:20">see deŋele nyii me nɔɔwoya.<verse eid="PRO 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21" />Na yele n sia ka lee ŋe dɔɔ ya,</para>
  <para style="q2" vid="PRO 4:21">mo ŋa do n konɔɔ man.<verse eid="PRO 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22" />Nawolo nyi baŋ be nyiŋ ŋa na bee nyiŋ nyeedoŋ,</para>
  <para style="q2" vid="PRO 4:22">na wosenaane pou doŋ.<verse eid="PRO 4:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23" />Kɛŋa pou wɔle na gyee n konɔɔ,</para>
  <para style="q2" vid="PRO 4:23">nawolo nyi ke man te n nyeedoŋ pou na lee.<verse eid="PRO 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24" />Lese n nɔɔ lee nombia ketulii man,</para>
  <para style="q2" vid="PRO 4:24">lese n nɔɔsebia lee nombia kekara gyakaa walaŋ dɔɔ man.<verse eid="PRO 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25" />Yela n sia ke kɛɛ n siaman tee,</para>
  <para style="q2" vid="PRO 4:25">kɛɛ n siaman fee.<verse eid="PRO 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26" />Kɛɛ n detɛe man nideli,</para>
  <para style="q2" vid="PRO 4:26">na n gbɛɛneŋ ke de fa neŋ.<verse eid="PRO 4:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27" />Na kpase gyu demena yaa dunoluŋ ya,</para>
  <para style="q2" vid="PRO 4:27">wɔŋ n nawɔɔ lee dukum keyɛɛ man.<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s1">Kefaree Lee Yale Kewɔlɛɛ Wose Man</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1" />Me bu, tei me nyansa nombia,</para>
  <para style="q2" vid="PRO 5:1">see deŋele nyii me nombia kenyii man,<verse eid="PRO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2" />yɛɛ abɔɔ nyansa man,</para>
  <para style="q2" vid="PRO 5:2">na n nɔɔ ke kyaŋ nombia kagyeŋ see.<verse eid="PRO 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3" />Nawolo nyi alo ŋon ɔ ba mo ayimɛɛ wuu ɔ wose nɔɔwoya yɛɛ ŋgba teebɔɔ nɛ,</para>
  <para style="q2" vid="PRO 5:3">te ɔ kekolosi dana yeliŋ ŋgba doosi nɛ.<verse eid="PRO 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4" />Mɔ kɔ ɔto na ke dana ŋgba ŋanŋanborɔ nɛ,</para>
  <para style="q2" vid="PRO 5:4">te kɛɛ bee ŋgba yoosila sia na wɔle nɛ.<verse eid="PRO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5" />Ɔ nawɔɔ ne tisi gyu yeŋ man,</para>
  <para style="q2" vid="PRO 5:5">ɔ nawɔɔ kekulu ne gyu bo yebɔɔ man.<verse eid="PRO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6" />Ɔ bɛɛ gyueŋ gbɛɛ keŋ ne fa nyeedoŋ ya,</para>
  <para style="q2" vid="PRO 5:6">ɔ dɔŋ bo ɔ ne kyeŋgbeŋ yakaa, mɔna ɔ ba gyeŋ ya.<verse eid="PRO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7" />Me bia, nɛnɛɛ ɛ tei maŋ,</para>
  <para style="q2" vid="PRO 5:7">ɛ na lee keŋ mɛɛ yako ŋon nɛ wɔle ya.<verse eid="PRO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8" />Ɛ wɔŋ ɛ wose lee ɔ gyaŋ gyu lem,</para>
  <para style="q2" vid="PRO 5:8">ɛ na benaa ɔ dekpaŋalaŋ denaanɔɔ gba ya.<verse eid="PRO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9" />na mena ya na nyɔ obuo gyae ka lee n nyiŋmaa man,</para>
  <para style="q2" vid="PRO 5:9">te n yele kelɛɛ mɔ gyae ka lee n nyiŋmaa man gyu nyeeman doŋte gyaŋ.<verse eid="PRO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10" />Na mena ya na ŋɔɔla baa di nya dedii,</para>
  <para style="q2" vid="PRO 5:10">na keŋ n be kaa nyiŋ nɛ ke gyu kedesina walaŋ wɔle dekpaŋalaŋ.<verse eid="PRO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11" />N yeŋ wee da benaa na nyaŋ ke mutii,</para>
  <para style="q2" vid="PRO 5:11">nawolo nyi n wose naane na n wose pou gyae ke nyɔe.<verse eid="PRO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12" />Nyaŋ ke yako nyiaa, &lt;&lt;Mena keŋ mɔɔ kɔla katenee.</para>
  <para style="q2" vid="PRO 5:12">mena keŋ me konɔɔ be bɛɛ kedesina.<verse eid="PRO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13" />Me te nyii ma wolara ya,</para>
  <para style="q2" vid="PRO 5:13">ma te tei baŋ bɛɛ wola maŋ nombia nɛ ya.<verse eid="PRO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14" />Kaa kyomii nafɔ ma wose te kyaŋ maŋ,</para>
  <para style="q2" vid="PRO 5:14">ba degyaŋee man.&gt;&gt;<verse eid="PRO 5:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15" />Nyɔɔ loŋ lee nyaŋ gbagba osuŋ man,</para>
  <para style="q2" vid="PRO 5:15">loŋ keŋ ne puu lee nyaŋ gbagba n detiribuŋ man.<verse eid="PRO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16" />N loŋse dɛɛlee gyae ke wuu abɔnterese man,</para>
  <para style="q2" vid="PRO 5:16">na n boŋobiise ke lɛɛ balaŋ dɛɛgyaŋee man?<verse eid="PRO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17" />Yela ŋe ka bese nyaŋ nyaageŋ wui,</para>
  <para style="q2" vid="PRO 5:17">ɛmɛɛ na ŋɔɔla na kpala ŋa korakora ya.<verse eid="PRO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18" />Baa hiraa n loŋse dɛɛbɛe e lee,</para>
  <para style="q2" vid="PRO 5:18">nyaŋee lee n tobiiritɛɛ wɛɛle dɔɔ.<verse eid="PRO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19" />Ɔ yɛɛ ɔkyueŋ ŋon ɔ dana kyeo, ŋaa ŋon ɔ ba lee aleebiri.</para>
  <para style="q2" vid="PRO 5:19">wa ade dɛɛ baa neŋ debaŋ kamasɛ,</para>
  <para style="q2" vid="PRO 5:19">ɔ kegyae dɛɛ dɛɛse neŋ debaŋ kamasɛ.<verse eid="PRO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20" />Me bu, weera ŋolo wɛɛle ne dɛɛse neŋ?</para>
  <para style="q2" vid="PRO 5:20">Weera n ne pukaa ohuhoo alo?<verse eid="PRO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21" />N gbɛɛneŋ pou doo Degbeŋgyoo siaman teŋteŋeleŋ,</para>
  <para style="q2" vid="PRO 5:21">ɔ sia gyakaa n dɛɛtɛe pou man.<verse eid="PRO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22" />Akpanyanyaŋte nombiakumɛɛ keyɛɛ ne kyaŋ e ŋgba kɔta nɛ,</para>
  <para style="q2" vid="PRO 5:22">ɔ nombiakumɛɛ ŋmeeseŋ ne miliina e.<verse eid="PRO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23" />Nyi walaŋ de bɛɛ katenee na ɔ na yem,</para>
  <para style="q2" vid="PRO 5:23">ŋon gbagba diyiŋ beiŋ ne yele ɔ na yo gbɛɛ.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s1">Kefaree Lee Diyiŋ Nombia Keyɛɛman</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1" />Me bu, nyi n sem n dɔɔ wɔle,</para>
  <para style="q2" vid="PRO 6:1">nyi n sem ŋɔɔle ŋolo kom nawɔɔ man nɛ,<verse eid="PRO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2" />na keŋ n be yako nɛ te nyɔɔ neŋ kɔta,</para>
  <para style="q2" vid="PRO 6:2">te n nɔɔman nombia te kyaŋ neŋ.<verse eid="PRO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3" />Me bu, yɛɛ kei na n ka mo lɛɛ n wose,</para>
  <para style="q2" vid="PRO 6:3">n be nyiŋ gyoo n dɔɔ nyiŋmaa man na,</para>
  <para style="q2" vid="PRO 6:3">gyu ɔ gyaŋ na n ke yɔkɔse n wose,</para>
  <para style="q2" vid="PRO 6:3">na n ke yase sia doo n dɔɔ ŋon teeree.<verse eid="PRO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4" />Na doo dosoroŋ ya,</para>
  <para style="q2" vid="PRO 6:4">te na deŋeli koraŋ gba ya.<verse eid="PRO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5" />Lɛo n wose ŋgba mena keŋ ŋaa ne lɛo ɔ wose lee ɔkpaŋ nyiŋmaa man,</para>
  <para style="q2" vid="PRO 6:5">ŋgba mena keŋ gyeebu ne lɛo ɔ wose lee kɔta nyɔɔre nyiŋmaa man nɛ.<verse eid="PRO 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6" />Nyaŋ kebɔŋalete, gyu kamelee gyaŋ,</para>
  <para style="q2" vid="PRO 6:6">kɛɛ ɔ gbɛɛneŋ na n ka gyeŋ nyansa.<verse eid="PRO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7" />Ɔ be dana siamante ya,</para>
  <para style="q2" vid="PRO 6:7">ɔ be dana ŋon ɔ ne kɛɛ ɔ dɔɔ yaa ŋon ɔ ne di ɔ dɔɔ ya.<verse eid="PRO 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8" />Mɔna ɔ na see ɔ weenɛɛ dugbututɛɛ,</para>
  <para style="q2" vid="PRO 6:8">te ɔ ne yilaa ɔ weenɛɛ ka kekɛrɛɛtɛɛ.<verse eid="PRO 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9" />Kebɔŋalete, nyaŋ ke doo kelii debaŋ woŋti?</para>
  <para style="q2" vid="PRO 6:9">Debaŋ woŋti yaa nyaŋ ke foŋ lee n dosoroŋ man?<verse eid="PRO 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10" />Dosoroŋ kyomii, kedeŋeli kyomii,</para>
  <para style="q2" vid="PRO 6:10">nyiŋmaase kamo do yoolaase man fɛɛfo kyomii na,<verse eid="PRO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11" />diyem gyae kaa futaa neŋ ŋgba ŋmɛɛlate nɛ,</para>
  <para style="q2" vid="PRO 6:11">te wose kekyaŋ ŋgba dekpaŋkpasare ŋmɛɛlate nɛ.<verse eid="PRO 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12" />Nombia gyaere na akpanyanyaŋte,</para>
  <para style="q2" vid="PRO 6:12">ŋon ɔ na mo nɔɔse ala ala ta kila dii akɛrɛɛ.<verse eid="PRO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 6:13" />Ɔ ne gyɔ ɔ sia kpabeekpabee,</para>
  <para style="q2" vid="PRO 6:13">mo ɔ nawɔɔ fatee,</para>
  <para style="q2" vid="PRO 6:13">te ɔ na mo ɔ nyimbia yɛɛ adao.<verse eid="PRO 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 6:14" />Adaote ŋon ɔ ne bake nombiakumɛɛ ɔ konɔɔ man,</para>
  <para style="q2" vid="PRO 6:14">ɔ ne loo do balaŋ debaŋ kamasɛ.<verse eid="PRO 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15" />Mena dɔɔ nombiikum gyae ke futaa e karatetee,</para>
  <para style="q2" vid="PRO 6:15">baa munu e debokenaŋ man keŋ ɔ be nyiŋ kekyɔ ya.<verse eid="PRO 6:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 6:16" />Abɔɔ looro kyaa keŋ Degbeŋgyoo ne kɔle,</para>
  <para style="q2" vid="PRO 6:16">nyetooro dana e duwaare.<verse eid="PRO 6:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="PRO 6:17" />Agaŋtaŋ sia,</para>
  <para style="q2" vid="PRO 6:17">dekara laakem,</para>
  <para style="q2" vid="PRO 6:17">nyiŋmaase ŋan na ko walaŋ ŋon ɔ nombia dei.<verse eid="PRO 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 6:18" />Konɔɔ keŋ ne bake akpanyanyaŋ nombia,</para>
  <para style="q2" vid="PRO 6:18">nawɔɔ ŋan ŋɛɛ barase yɛɛ dukum.<verse eid="PRO 6:18" /></para>
  <para style="q3">
    <verse number="19" style="v" sid="PRO 6:19" />Adansɛɛkumdiiri ŋon ɔ ne dii akɛrɛɛ,</para>
  <para style="q2" vid="PRO 6:19">na walaŋ ŋon ɔ ne loo nombia do balaŋ donɔɔ man.<verse eid="PRO 6:19" /></para>
  <para style="s1">Kefaare Lee Ayimɛɛ Kamo Wuu Wose Man</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20" />Me bu, di n kya mmaraase dɔɔ,</para>
  <para style="q2" vid="PRO 6:20">te na bɛɛ n naa kawola ya.<verse eid="PRO 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21" />Mo ŋa do nya nyeempɔ man debaŋ kamasɛ,</para>
  <para style="q2" vid="PRO 6:21">mo ŋa kpaŋna n nyiŋmaa.<verse eid="PRO 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22" />Nyi n dɔŋ na ŋe gyae ka wola neŋ gbɛɛ,</para>
  <para style="q2" vid="PRO 6:22">nyi n doo na ŋe gyae ke kɛɛ n dɔɔ,</para>
  <para style="q2" vid="PRO 6:22">nyi n fom na ŋe gyae ke kolosina neŋ.<verse eid="PRO 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23" />Nawolo nyi mmaraa kei yɛɛ kanea ke,</para>
  <para style="q2" vid="PRO 6:23">kawola kei yɛɛ keŋmaŋee ke,</para>
  <para style="q2" vid="PRO 6:23">kedesina na nombia kawola,</para>
  <para style="q2" vid="PRO 6:23">yɛna nyeedoŋ gbɛɛ.<verse eid="PRO 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24" />Na ka lese neŋ lee n dɔɔ wɛɛle nyiŋmaa man,</para>
  <para style="q2" vid="PRO 6:24">lee alo ohuhoo nɔɔwoya gyoŋ nyiŋan man.<verse eid="PRO 6:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25" />Na yele ɔ kyeo ke gyɔ neŋ loo n konɔɔ man,</para>
  <para style="q2" vid="PRO 6:25">yaa waa mo ɔ sia kyaŋ neŋ ya.<verse eid="PRO 6:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26" />Nawolo nyi baa tale mo bodobodo duguŋ nyiŋ futooli alo,</para>
  <para style="q2" vid="PRO 6:26">mɔna ŋolo wɛɛle waa tale wɔlɛɛ neŋ na n kpene kamasɛ.<verse eid="PRO 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27" />Ŋolo waa tale lese boalaŋ gyakaa ɔ yoo dɔɔ,</para>
  <para style="q2" vid="PRO 6:27">keŋ nyi ɔ kegbase be nyakee yee?<verse eid="PRO 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28" />Ŋolo waa tale ta boalaŋ na nyewalaŋ dɔɔ,</para>
  <para style="q2" vid="PRO 6:28">keŋ ɔ nawɔɔ be nyakee yee?<verse eid="PRO 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29" />Mena te baale ŋon ɔ ne gyae ɔ dɔɔ wɛɛle nɛ doo,</para>
  <para style="q2" vid="PRO 6:29">ŋolo be kyaa keŋ ɔ tina alo ŋonaŋ na bɔɔ wɔŋ ɔ deŋele ya.<verse eid="PRO 6:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30" />Nyi tanam na ko ŋmɛɛlate te ɔ ŋmɛɛle weenɛɛ di nɛ,</para>
  <para style="q2" vid="PRO 6:30">ŋolo bɛɛ do e desɛŋ ya.<verse eid="PRO 6:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31" />Mɔ nyi akpaa be kyaŋ e na, waa tɔ ka kom betabonyetooro,</para>
  <para style="q2" vid="PRO 6:31">waa mo ɔ dekpaŋalaŋ man abɔɔ pou yɔɔ tɔ kom.<verse eid="PRO 6:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32" />Mɔna baale ŋon ɔ mo ayimɛɛ wuu ɔ wose yɛɛ diyiŋte e,</para>
  <para style="q2" vid="PRO 6:32">ŋon ɔ yɛɛ mena na ɔ ne wɔlɛɛ ɔ wose.<verse eid="PRO 6:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33" />Ketuku na desɛŋ te waa nyiŋ,</para>
  <para style="q2" vid="PRO 6:33">te ɔ desɛŋ kenaŋ be gyae ka lee ɔ dɔɔ korakora ya.<verse eid="PRO 6:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34" />Nawolo nyi nuŋkurili ne yele alo ŋon baale na gyeŋ baŋ nideli,</para>
  <para style="q2" vid="PRO 6:34">waa tɔ neŋ ka kom keŋ ɔ be wii n waraŋase ya.<verse eid="PRO 6:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35" />Ɔ be gyae waa sɛɛ lɛɛ ayefaare kamasɛ ya,</para>
  <para style="q2" vid="PRO 6:35">nyi ba yoo fa e abɔɔ burum koraŋ na, ɔ be gyae waa lɛɛ ya.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="s1">Kefaree Lee Alo Ŋon Ɔ Ba Mo Ayimɛɛ Wuu Ɔ Wose Man</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1" />Me bu, di me nombia dɔɔ,</para>
  <para style="q2" vid="PRO 7:1">na n ka mo maŋ mmaraase do n konɔɔ man.<verse eid="PRO 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2" />Di maŋ mmaraase dɔɔ na n ke kyaa nyeedoŋ man,</para>
  <para style="q1" vid="PRO 7:2">gyee me kawolase ŋgba n sibiibii nɛ.<verse eid="PRO 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3" />Mo ŋa bake n nyiŋmaa,</para>
  <para style="q2" vid="PRO 7:3">mo ŋa do nya nyeempɔ man.<verse eid="PRO 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4" />Yako nyansa nyi, &lt;&lt;Nyaŋ yɛna me deesi,&gt;&gt;</para>
  <para style="q2" vid="PRO 7:4">na n ke yako nombia man kenyii nyi,&lt;&lt;Nyaŋ yɛna ma loŋto.&gt;&gt;<verse eid="PRO 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5" />Baa lɛɛ neŋ lee alo ŋon ɔ na mo ayimɛɛ wuu ɔ wose nɛ nyiŋmaa man,</para>
  <para style="q2" vid="PRO 7:5">lee alo ŋon ɔ na mo nɔɔwoya gyoŋ nyiŋan beo balaŋ nɛ nyiŋmaa man.<verse eid="PRO 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6" />Me ka seŋ ma dekpaŋalaŋ nfansere man nɛ,</para>
  <para style="q2" vid="PRO 7:6">ma doo me sibii kɛɛ debɔɔ man.<verse eid="PRO 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7" />Me naa baŋ bɔɔ gyeŋ daale ya,</para>
  <para style="q2" vid="PRO 7:7">ma gyene tewulɛɛ baŋ man,</para>
  <para style="q2" vid="PRO 7:7">me naa tobaale diyiŋte ŋolo.<verse eid="PRO 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8" />Ɔ moo gbɛɛ keŋ ne gyu alo ŋon kebɔtala man,</para>
  <para style="q2" vid="PRO 7:8">mo ɔ sia tee alo ŋon dɛɛ gbɛɛ.<verse eid="PRO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9" />Ke yɛɛ balinɔɔ keŋ tɛɛ ne biri,</para>
  <para style="q2" vid="PRO 7:9">tɛɛ kee yuu keŋ detiŋtɛɛ tuum ba gyoo nɛ.<verse eid="PRO 7:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10" />Keŋte alo ŋon leewɔ kaa gyaŋeena e,</para>
  <para style="q2" vid="PRO 7:10">ɔ doona abɔɔ ŋgba futooli alo nɛ na ke gyɔ e loo.<verse eid="PRO 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11" />Ɔ te lɛɛ ɔ wose te ɔ na wola ɔ wose,</para>
  <para style="q2" vid="PRO 7:11">ɔ bɛɛ kyaa ɔ mokɔɔ dɔɔ ya.<verse eid="PRO 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12" />kyomii na ɔ kyaa gbɛɛnɔɔ man, kyomii na ɔ kyaa balaŋ dɛɛgyaŋee man,</para>
  <para style="q2" vid="PRO 7:12">ɔ na yoo deke kebɔtala kamasɛ man.<verse eid="PRO 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13" />Ɔ kyaŋa tobaale ŋon te ɔ pukaa e,</para>
  <para style="q2" vid="PRO 7:13">ɔ moo kegyae sia kɛɛ e yako e nyiaa,<verse eid="PRO 7:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14" />&lt;&lt;Gyɛŋ ma te tɔ ma alaŋaŋ,</para>
  <para style="q2" vid="PRO 7:14">te me dana wosefɛɛreŋ kedeesa weenɛɛ me dɛɛ.<verse eid="PRO 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15" />Mena dɔɔ te ma leewɔ kaa gyaŋeena neŋ.</para>
  <para style="q2" vid="PRO 7:15">me kɛo neŋ te me naa neŋ.<verse eid="PRO 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16" />Me ta mo kanyaŋ keŋ bɔɔ mo Igyipite ŋmeeseŋ ŋan ŋa loŋse yɛɛ kpookpoo loo nɛ,</para>
  <para style="q2" vid="PRO 7:16">lɔ ma dofoŋoŋ dɔɔ.<verse eid="PRO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17" />Me ta mo lafenta ofoŋte,</para>
  <para style="q2" vid="PRO 7:17">keŋ bɔɔ mo adudo na pɛperɛ na sinamɔn yɛɛ nɛ ŋmatee ma dofoŋoŋ dɔɔ.<verse eid="PRO 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18" />Kɔŋ de kaa di gyoŋ naasetɛɛ,</para>
  <para style="q2" vid="PRO 7:18">dɛɛ mo kegyae pukaa dɔŋa nideli.<verse eid="PRO 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19" />Me baale be kyaa ya,</para>
  <para style="q2" vid="PRO 7:19">ɔ te lam gbɛɛ lemlem.<verse eid="PRO 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20" />Ɔ moo kɔba burum do ɔ kotoku man,</para>
  <para style="q2" vid="PRO 7:20">waa di gyaalaŋ dokoloŋ pɛte waa kɔŋ.&gt;&gt;<verse eid="PRO 7:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21" />Ɔ moo ɔ nɔɔwoya gyoŋ nyiŋan yela ɔ yoo gbɛɛ,</para>
  <para style="q2" vid="PRO 7:21">ɔ moo kekolosi gyoŋgyoŋ beo e.<verse eid="PRO 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22" />Debokenaŋ man te ɔ sila e,</para>
  <para style="q2" vid="PRO 7:22">ŋgba nunkyue baale ŋon bee gyu be kaa ko nɛ,</para>
  <para style="q1" vid="PRO 7:22">ŋgba ŋaa na gyoola kɔta man nɛ.<verse eid="PRO 7:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="PRO 7:23" />Kelii debaŋ keŋ baŋdaŋ nyeele be sɔɔ e gyoo ɔ wɔɔsa man,</para>
  <para style="q1" vid="PRO 7:23">ŋgba gyeebu barasela ka gyoo kɔta man nɛ,</para>
  <para style="q2" vid="PRO 7:23">na ɔ ba gyeŋ nyi gyae ka mo e gyu yeŋ man ya.<verse eid="PRO 7:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24" />Nɛnɛɛ ao me bia, ɛ tei maŋ,</para>
  <para style="q2" vid="PRO 7:24">ɛ nyii keŋ maa yako.<verse eid="PRO 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25" />Na yele n konɔɔ ke kyɛɛkee gyu ɔ gbɛɛneŋ man,</para>
  <para style="q2" vid="PRO 7:25">yaa n ke kpase mo ɔ detɛe man ya.<verse eid="PRO 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26" />Ɔ te yele balaŋ burum te yale,</para>
  <para style="q2" vid="PRO 7:26">ɔ ta koe balaŋ burum keŋ n be tale kala ya.<verse eid="PRO 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27" />Ɔ dekpaŋalaŋ yɛna yebɔɔ gbɛɛ dinaa,</para>
  <para style="q2" vid="PRO 7:27">keŋ na mo gyoo yeŋ deni tɔɔmante man.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s1">Nyansa Kebaake</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1" />Nyansa bee bololoo yee?</para>
  <para style="q2" vid="PRO 8:1">Nombia man kenyii bee gyina ɔ woya yee?<verse eid="PRO 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2" />Bulasebia nyee dɔɔ gbɛɛ man</para>
  <para style="q2" vid="PRO 8:2">gbaŋgbasese man te ɔ na sem,<verse eid="PRO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3" />disim dinaa keŋ na mo gyu donɔɔ dinaa keŋ man,</para>
  <para style="q2" vid="PRO 8:3">ka denaanɔɔ yenaŋ te ɔ ne fae yeesa.<verse eid="PRO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4" />&lt;&lt;Ɛmɛɛ balaŋ yaa mɛɛ baake,</para>
  <para style="q2" vid="PRO 8:4">mee gyina ma woya baake denibalaŋ pou.<verse eid="PRO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5" />Ɛmɛɛ baŋ ɛ ba gyeŋ daale ya, ɛ yela ɛ sia kekara,</para>
  <para style="q2" vid="PRO 8:5">ɛmɛɛ ayiŋtena, ɛ nyii nombia man.<verse eid="PRO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6" />Ɛ tei, nawolo nyi me dana nombia tuturu maa yako,</para>
  <para style="q2" vid="PRO 8:6">me te gyuusu me nɔɔ maa kolosi keŋ doona kegbɛɛ.<verse eid="PRO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7" />Me nɔɔ ne kolosi anokoare bo,</para>
  <para style="q2" vid="PRO 8:7">te me nɔɔsebia ne kɔla nombia akaraŋkaraŋ.<verse eid="PRO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8" />Me nɔɔman nombia pou tenɛɛ,</para>
  <para style="q2" vid="PRO 8:8">ŋe man daale te tulii yaa ke gɛɛse ya.<verse eid="PRO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9" />Ŋe popou doona ŋe gbɛɛ fa baŋ bee nyii nombia man,</para>
  <para style="q2" vid="PRO 8:9">ŋa tenɛɛ fa baŋ be dana nombia kagyeŋ.<verse eid="PRO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10" />Lese me nombia kawola tina kɔba wolom yela,</para>
  <para style="q2" vid="PRO 8:10">nombia kagyeŋ yela kɔba yayam kpaakpaate.<verse eid="PRO 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11" />Nawolo nyi nyansa na lee koya kela kegyaŋase kpaakpaa nyiŋan,</para>
  <para style="q2" vid="PRO 8:11">te kolo be kyaa keŋ n ne gyae keŋ n ke tale mo maana ke ya.<verse eid="PRO 8:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12" />&lt;&lt;Maŋ nyansa, na siakekara kyaala debodokoloŋ,</para>
  <para style="q2" vid="PRO 8:12">maŋ tee nombia kagyeŋ na nombia kedi kegbɛɛ dɔɔ.<verse eid="PRO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13" />Degbeŋgyoo keyee yɛna dukum kekɔla,</para>
  <para style="q1" vid="PRO 8:13">Mɛɛ kɔla wose kegyina na agaŋtaŋ,</para>
  <para style="q2" vid="PRO 8:13">dinɔɔkum na nombia kekolosi tulii.<verse eid="PRO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14" />Kekolosifa na nombia kedi nideli yɛɛ me wui,</para>
  <para style="q2" vid="PRO 8:14">Me dana nombia man kenyii, me dana doŋ.<verse eid="PRO 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15" />Me dɔɔ te gyooneŋ ne tɛɛ di gyoori,</para>
  <para style="q2" vid="PRO 8:15">te kegyiise ne fa kawolase ŋan doo ŋe gbɛɛ dɔɔ.<verse eid="PRO 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16" />Me dɔɔ te gyoorobia ne tɛɛ di gyoori,</para>
  <para style="q2" vid="PRO 8:16">na siamantena baŋ bee di tɛɛle dɔɔ nɛ.<verse eid="PRO 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17" />Mɛɛ gyae baŋ bɛɛ gyae maŋ nɛ,</para>
  <para style="q2" vid="PRO 8:17">te baŋ bɛɛ yase sia kɛo maŋ ne naa maŋ.<verse eid="PRO 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18" />Wose kenyiŋ na obuo,</para>
  <para style="q2" vid="PRO 8:18">dedii keŋ bɛɛ wɔlɛɛ ya, na kede yɛɛ me wui.<verse eid="PRO 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19" />Bii keŋ mɛɛ see dei kela kɔba yayam, kɔba yayam kpaakpaate gba,</para>
  <para style="q2" vid="PRO 8:19">keŋ na lee me man kela kɔba wolom kpaakpaate.<verse eid="PRO 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20" />Mɛɛ tɛɛ nombia ŋan tenɛɛ nɛ gbɛɛ dɔɔ,</para>
  <para style="q2" vid="PRO 8:20">na nombia kedi ke gbɛɛ dɔɔ detɛe man,<verse eid="PRO 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21" />na maa yela baŋ bɛɛ gyae maŋ nɛ kenyiŋ ba wose,</para>
  <para style="q2" vid="PRO 8:21">na ba abɔɔ dɛɛseese ke wulu.<verse eid="PRO 8:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22" />Degbeŋgyoo tomse man na maŋ te ɔ taŋgbɛɛwɔ yɛɛ,</para>
  <para style="q2" vid="PRO 8:22">pɛte ŋan ɔ be yɛɛ gyaŋgba gyaŋgba nɛ.<verse eid="PRO 8:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23" />Ɔ lese maŋ leenaŋ beneŋ beneŋ keŋ,</para>
  <para style="q2" vid="PRO 8:23">leenaŋ kewalaŋ keŋ pɛte ɔ yɛɛ tɛɛle.<verse eid="PRO 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24" />Debaŋ keŋ leeneŋ ŋan ŋe dana siiliŋ be kyaa ya nɛ, na be ta lola maŋ,</para>
  <para style="q2" vid="PRO 8:24">debaŋ keŋ booneŋ nyeeya ŋan loŋse ne puu lee be kyaa ya nɛ.<verse eid="PRO 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25" />Pɛte bulase kaa seŋ ŋe daseŋae man,</para>
  <para style="q2" vid="PRO 8:25">pɛte bulasebia kekɔŋ nɛ, na be ta lola maŋ.<verse eid="PRO 8:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26" />Pɛte waa yɛɛ tɛɛle kei yaa ke ŋalese man,</para>
  <para style="q2" vid="PRO 8:26">yaa tɛɛle dɔɔ aŋasa kamasɛ.<verse eid="PRO 8:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27" />Me kyaa botɔɔ pɛte ɔ moo adido see ka dedoi man,</para>
  <para style="q2" vid="PRO 8:27">debaŋ keŋ ɔ be kpase debuŋta keŋ gyakaa boo dinaana man nɛ.<verse eid="PRO 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28" />debaŋ keŋ ɔ ba see debuŋta mokɔɔ adido keŋkeŋ,</para>
  <para style="q2" vid="PRO 8:28">te ɔ see ɛpo nyee keŋkeŋ.<verse eid="PRO 8:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29" />debaŋ keŋ ɔ be fa ɛpo ke wulu,</para>
  <para style="q2" vid="PRO 8:29">na loŋse be nyiŋ yala ɔ mmaraa dɔɔ ya,</para>
  <para style="q1" vid="PRO 8:29">na debaŋ keŋ ɔ ba see tɛɛle mokɔɔ nɛ.<verse eid="PRO 8:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="PRO 8:30" />Na me kyaa ɔ yenaŋ ŋgba nyiŋmaa man tomyɛɛre kegyia nɛ,</para>
  <para style="q2" vid="PRO 8:30">na mee yele ɔ sia na gye wee na wee,</para>
  <para style="q2" vid="PRO 8:30">na mɛɛ nyaŋee ɔ siaman debaŋ kamase.<verse eid="PRO 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31" />Mɛɛ nyaŋee ɔ tɛɛle keŋ pou ɔ be yɛɛ nɛ man,</para>
  <para style="q2" vid="PRO 8:31">te denibalaŋ na gyoo me sia.<verse eid="PRO 8:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32" />&lt;&lt;Nɛnɛɛ me bia, ɛ tei maŋ,</para>
  <para style="q2" vid="PRO 8:32">baŋ be dɔŋ me gbɛɛneŋ man nɛ baŋna nyeebam.<verse eid="PRO 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33" />Ɛ tei me kawola na ɛ sia ke kara.</para>
  <para style="q1" vid="PRO 8:33">ɛ na bɛɛ ŋa ya.<verse eid="PRO 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34" />Baŋ bee tei maŋ,</para>
  <para style="q2" vid="PRO 8:34">te bee gyee ma anaanɔɔse wee kamasɛ,</para>
  <para style="q2" vid="PRO 8:34">te bɛɛ sem ma asima gbɛɛneŋ man nɛ baŋna nyeebam.<verse eid="PRO 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35" />Nawolo nyi baŋ be naa maŋ na be te nyiŋ nyeedoŋ,</para>
  <para style="q2" vid="PRO 8:35">te Degbeŋgyoo waa boele wɔ.<verse eid="PRO 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36" />Mɔna baŋ be bɛɛ nyi bɔɔ kɛo maŋ ya nɛ te di ba wose gyerebi,</para>
  <para style="q1" vid="PRO 8:36">baŋ pou bɛɛ kɔla maŋ ne gyae yeŋ baa.&gt;&gt;<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s1">Nyansa Na Diyiŋ Kebaake</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1" />Nyansa te baŋ ɔ deni,</para>
  <para style="q2" vid="PRO 9:1">ɔ te baŋ ke pilase nyetooro.<verse eid="PRO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2" />Ɔ ta teŋe ɔ naneŋ te ɔ kyakale ɔ soloŋse,</para>
  <para style="q2" vid="PRO 9:2">ɔ ta see ɔ tebulu mɔ.<verse eid="PRO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3" />Ɔ te kpilii wa alebia, te ɔ ne baake,</para>
  <para style="q2" vid="PRO 9:3">lee donɔɔ dinaa keŋ nyeeman nyiaa,<verse eid="PRO 9:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PRO 9:4" />&lt;&lt;Ɛmɛɛ baŋ ɛ ba gyeŋ daale ya nɛ ɛ kɔŋ me dɛɛ.&gt;&gt;</para>
  <para style="q1" vid="PRO 9:4">Te ɔ yako ayiŋtena nyiaa,<verse eid="PRO 9:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="PRO 9:5" />&lt;&lt;Ɛ kɔŋ, ɛ di me weenɛɛ,</para>
  <para style="q2" vid="PRO 9:5">na ɛ ke nyɔɔ ma soloŋ keŋ mɔɔ kyakale nɛ.<verse eid="PRO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6" />Ɛ tina ɛ nombia ŋan ɛ ba gyeŋ ya nɛ gbɛɛ yela na ɛ ke nyiŋ nyeedoŋ,</para>
  <para style="q2" vid="PRO 9:6">Ɛ ta nombia kagyeŋ gbɛɛ man.&gt;&gt;<verse eid="PRO 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7" />Ɔkamasɛ ŋon ɔ desina ŋon ɔ ne kulu balaŋ nɛ, bɛɛ tee e bo,</para>
  <para style="q2" vid="PRO 9:7">ɔkamasɛ ŋon ɔ kalena akpanyanyaŋte ne nyiŋ tuubia bo.<verse eid="PRO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8" />Na kalena ŋon ɔ ne kulu balaŋ ya, na mena ya na waa kɔla neŋ,</para>
  <para style="q2" vid="PRO 9:8">kalana siakaralate, na waa gyae neŋ.<verse eid="PRO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9" />Wola siakaralate nombia, na waa bese gyeŋ kpu,</para>
  <para style="q2" vid="PRO 9:9">wola ŋon ɔ gbɛɛneŋ tenɛɛ nɛ, na waa bese gyeŋ nombia kpu.<verse eid="PRO 9:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10" />Degbeŋgyoo keyee yɛna nyansa kewalaŋ,</para>
  <para style="q2" vid="PRO 9:10">te fereŋkyeŋte ŋon nombia kagyeŋ yɛna nombia man kenyii.<verse eid="PRO 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11" />Nawolo nyi lee maŋ dɔɔ te n weeya gyae ka bo burum,</para>
  <para style="q2" vid="PRO 9:11">na kulutooneŋ ke kpu n nyeedoŋ man.<verse eid="PRO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12" />Nyi n sia de kare nɛ, n nyansa gyae ke tɔ neŋ kom,</para>
  <para style="q2" vid="PRO 9:12">nyi n yɛɛ walaŋ kulure e na, nyaŋ kena diyem nyaageŋ.<verse eid="PRO 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13" />Alo diyiŋte ne tɔ balaŋ deŋela bo,</para>
  <para style="q2" vid="PRO 9:13">ɔ ba gyeŋ daale ya, te ɔ ba gyeŋ kolo ya.<verse eid="PRO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14" />Ɔ ne kyaa ɔ dekpaŋalaŋ denaanɔɔ man,</para>
  <para style="q2" vid="PRO 9:14">gbeli keŋ doo donɔɔ dinaa keŋ adogbɛɛ nɛ dɔɔ,<verse eid="PRO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15" />ɔ ne baake baŋ bɛɛ lam botɔɔ,</para>
  <para style="q2" vid="PRO 9:15">baŋ be dɔŋna be gbɛɛ tee bee gyu nɛ,<verse eid="PRO 9:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="PRO 9:16" />&lt;&lt;Baŋ pou bɔɔ gyeŋ daale ya nɛ ɛ kaa soo me dɛɛ.&gt;&gt;</para>
  <para style="q2" vid="PRO 9:16">ɔ ne yako ayiŋtena nyiaa,<verse eid="PRO 9:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="PRO 9:17" />&lt;&lt;Ŋmɛɛleŋ loŋ dana gyoŋ,</para>
  <para style="q2" vid="PRO 9:17">weenɛɛ ŋan bɛɛ yoo di nɛ dana gyoŋ nideli.&gt;&gt;<verse eid="PRO 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18" />Mɔna bɔɔ gyeŋ nyi woya kyaa botɔɔ ya,</para>
  <para style="q2" vid="PRO 9:18">nyi ɔ ŋɔɔla baŋ kyaa yeŋdɛɛ ya.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s1">Solomɔn Aduya</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />Solomɔn aduya yaa,</para>
  <para style="q1" vid="PRO 10:1">Bu siakaralate ne yele ɔ kya ne nyaŋee,</para>
  <para style="q2" vid="PRO 10:1">mɔna bu diyiŋte ne yele nombia ne takaa ɔ naa.<verse eid="PRO 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2" />Wose kenyiŋ lee gbɛɛkum man be dana tɔnɔɔ ya,</para>
  <para style="q2" vid="PRO 10:2">mɔna gbɛɛneŋ katenee na lese walaŋ lee yeŋ man.<verse eid="PRO 10:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3" />Degbeŋgyoo bee yele tanam ka ko ŋon ɔ gbɛɛneŋ tenɛɛ nɛ ya,</para>
  <para style="q2" vid="PRO 10:3">mɔna ɔ ne tɔ akpanyanyaŋte kegyaebii gbɛɛ.<verse eid="PRO 10:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4" />Kebɔŋale nyiŋmaase ne fa diyem,</para>
  <para style="q2" vid="PRO 10:4">mɔna kakyeŋ nyiŋmaase ne yele walaŋ ne nyiŋ ɔ wose.<verse eid="PRO 10:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5" />Ŋon ɔ ne yilaa weenɛɛ kekɛrɛɛtɛɛ nɛ yɛɛ bu siakaralate e,</para>
  <para style="q2" vid="PRO 10:5">mɔna ŋon ɔ ne doo weenɛɛ kekɛrɛɛtɛɛ nɛ na do ɔ wose desɛŋ.<verse eid="PRO 10:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6" />Nyeebam ne kɔŋ ŋon ɔ gbɛɛneŋ tenɛɛ nɛ dɔɔ,</para>
  <para style="q2" vid="PRO 10:6">mɔna nombiakumɛɛ te wulu akpanyanyaŋte.<verse eid="PRO 10:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7" />Bɛɛ mo ŋon ɔ gbɛɛneŋ tenɛɛ nɛ yele hiraa,</para>
  <para style="q2" vid="PRO 10:7">mɔna akpanyanyaŋte yele gyae ke yo.<verse eid="PRO 10:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8" />Ŋon ɔ sia be karae ɔ konɔɔ man ne lɛɛ mmaraase do,</para>
  <para style="q1" vid="PRO 10:8">mɔna diyiŋte ŋon ɔ ne kpee nɛ waa wɔlɛɛ.<verse eid="PRO 10:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9" />Ŋon nombiikum be doo ɔ kekyaabii man ya nɛ ne kyaa wɔe kefɛɛ man,</para>
  <para style="q2" vid="PRO 10:9">mɔna ŋon ɔ dɛɛtɛe be gɛɛse nɛ gyae ka lese e debɔɔ.<verse eid="PRO 10:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10" />Ŋon ɔ ne gyɔ sia kpabee kpabee nɛ na mo kayeyɛɛ kɔŋ,</para>
  <para style="q2" vid="PRO 10:10">te diyiŋte ŋon ɔ ne kpee nɛ ne wɔlɛɛ.<verse eid="PRO 10:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11" />Ŋon ɔ gbɛɛneŋ tenɛɛ nɔɔ yɛɛ nyeedoŋ detiribuŋ ke,</para>
  <para style="q2" vid="PRO 10:11">mɔna akpanyanyaŋte nɔɔ ne wuu nombiakumɛɛ.<verse eid="PRO 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12" />Kekɔla ne putii kale,</para>
  <para style="q2" vid="PRO 10:12">mɔna kegyae ne wuu nombiakumɛɛ pou dɔɔ.<verse eid="PRO 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13" />Nyansa doo ŋon ɔ ne nyii nombia man nɛ nɔɔman,</para>
  <para style="q2" vid="PRO 10:13">mɔna dambila kaboena diyiŋte maama man.<verse eid="PRO 10:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14" />Siakaralate ne kyaŋ nombia kagyeŋ see,</para>
  <para style="q2" vid="PRO 10:14">mɔna diyiŋte nɔɔwoya na mo kewɔlɛɛ bo kɔŋ.<verse eid="PRO 10:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15" />Kɔbate wosekenyiŋ yɛɛ ŋgba ɔ donɔɔ dinaa keŋ bɔɔ baŋ dekyaŋ kilisi ke,</para>
  <para style="q2" vid="PRO 10:15">mɔna diyemte diyem yɛna ɔ kewɔlɛɛ.<verse eid="PRO 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16" />Ŋon ɔ gbɛɛneŋ tenɛɛ kom ketɔ yɛna nyeedoŋ,</para>
  <para style="q2" vid="PRO 10:16">mɔna keŋ akpanyanyaŋte ne nyim yɛna yeŋ.<verse eid="PRO 10:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17" />Ŋon ɔ ne nyii katenee dɔŋ nyeedoŋ gbɛɛ,</para>
  <para style="q2" vid="PRO 10:17">mɔna ŋon ɔ bɛɛ kedesina na mo balaŋ yooso.<verse eid="PRO 10:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18" />Ŋon ɔ mo dekara nɔɔwoya wuu kekɔla dɔɔ,</para>
  <para style="q2" vid="PRO 10:18">te ɔ yaasee akɛrɛɛ yɛɛ diyiŋte e.<verse eid="PRO 10:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19" />Nɔɔwoya burum bɛɛ tɔ dukum gbɛɛ ya,</para>
  <para style="q2" vid="PRO 10:19">mɔna ŋon ɔ gyeŋ nombia na do ɔ laakem dokɔŋ.<verse eid="PRO 10:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20" />Ŋon ɔ gbɛɛneŋ tenɛɛ laakem yɛɛ kɔba wolom kpaakpaate ke,</para>
  <para style="q2" vid="PRO 10:20">mɔna akpanyanyaŋte konɔɔ bɛɛ lee koya ya.<verse eid="PRO 10:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21" />Ŋon ɔ gbɛɛneŋ tenɛɛ nɔɔwoya ne kɛɛle balaŋ burum,</para>
  <para style="q2" vid="PRO 10:21">mɔna ayiŋtena na yekee lee keŋ bɔɔ gyeŋ daale ya dɔɔ.<verse eid="PRO 10:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22" />Degbeŋgyoo kehiraa ne yele walaŋ ne nyiŋ dedii,</para>
  <para style="q2" vid="PRO 10:22">keŋ ɔ bɛɛ mo weeleŋ kpu ya.<verse eid="PRO 10:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23" />Diyiŋte sia na gyoo akpanyanyaŋ nombia keyɛɛ man,</para>
  <para style="q2" vid="PRO 10:23">mɔna ŋon ɔ ne nyii nombia man sia na gye lee nyansa man.<verse eid="PRO 10:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24" />Kpene keŋ akpanyanyaŋte ne yee nɛ keŋ ne kɔŋala ɔ dɔɔ,</para>
  <para style="q2" vid="PRO 10:24">mɔna ŋon ɔ gbɛɛneŋ tenɛɛ waa nyiŋ keŋ ɔ ne gyae.<verse eid="PRO 10:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25" />Akpaa feliŋ dinaa de gyɔɔ laŋ nɛ, ne kuu akpanyanyaŋtena laŋ,</para>
  <para style="q2" vid="PRO 10:25">mɔna baŋ be gbɛɛneŋ tenɛɛ na sem keŋkeŋ kekpaakekpaa.<verse eid="PRO 10:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26" />Mena keŋ soloŋ denyaŋesa ne yesi kela te nyɔɔse na gyoo sia nɛ,</para>
  <para style="q1" vid="PRO 10:26">mena te kebɔŋalete yɛɛ fa ŋon ɔ be kpila e nɛ.<verse eid="PRO 10:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27" />Degbeŋgyoo keyee ne fa kekyaa kyare,</para>
  <para style="q2" vid="PRO 10:27">mɔna baa kɔɔkee akpanyanyaŋte weeya.<verse eid="PRO 10:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28" />Ŋon ɔ gbɛɛneŋ tenɛɛ lookegyakaa yɛna kenyaŋee,</para>
  <para style="q2" vid="PRO 10:28">mɔna akpanyanyaŋtena lookegyakaa yɛɛ yakaa.<verse eid="PRO 10:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29" />Degbeŋgyoo gbɛɛneŋ yɛna keyeu kagyoo fa ŋon dukum be doo ɔ man ya,</para>
  <para style="q2" vid="PRO 10:29">mɔna ke yɛɛ kewɔlɛɛ fa baŋ bɛɛ yɛɛ nombia kumɛɛ nɛ.<verse eid="PRO 10:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30" />Bɔɔ gyae baa tale kulu ŋon ɔ gbɛɛneŋ tenɛɛ korakora ya,</para>
  <para style="q2" vid="PRO 10:30">mɔna akpanyanyaŋte be gyae waa kyaa tɛɛle dɔɔ ya.<verse eid="PRO 10:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31" />Ŋon ɔ gbɛɛneŋ tenɛɛ na lese nyansa nombia lee ɔ nɔɔman,</para>
  <para style="q2" vid="PRO 10:31">mɔna baa gyɔ dekara laakem duguŋ.<verse eid="PRO 10:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32" />Ŋon ɔ gbɛɛneŋ tenɛɛ nɔɔwoya na gyoo deŋele,</para>
  <para style="q2" vid="PRO 10:32">mɔna akpanyanyaŋte nɔɔ ne kolosi dekara bo.<verse eid="PRO 10:32" /></para>
  <para style="b" />
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1" />Degbeŋgyoo ne kɔla sikelise ŋan bɛɛ mo ŋere balaŋ do,</para>
  <para style="q2" vid="PRO 11:1">mɔna sikelise kpaakpaa nyiŋan na gyoo ɔ sia.<verse eid="PRO 11:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2" />Akpaa wose kegate de kɔŋ na, desɛŋ mɔ te kɔŋ,</para>
  <para style="q2" vid="PRO 11:2">mɔna nyansa ne kyaa bo baŋ bɛɛ yɔkɔse ba wose nɛ gyaŋ.<verse eid="PRO 11:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3" />Baŋ be gbɛɛneŋ tenɛɛ nɛ ba anokoare kedi ne gyee wɔ,</para>
  <para style="q2" vid="PRO 11:3">mɔna baŋ bɔɔ ne di anokoare ya nɛ ba akɛrɛɛ ne wɔlɛɛna wɔ.<verse eid="PRO 11:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4" />Baŋ wee na dedii yɛɛ yakaa,</para>
  <para style="q2" vid="PRO 11:4">mɔna gbɛɛ katenee na lese walaŋ lee yeŋ man.<verse eid="PRO 11:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5" />Baŋ nombiikum be doo be man ya gbɛɛneŋ katenee na teneena be dɛɛtɛe fa wɔ,</para>
  <para style="q2" vid="PRO 11:5">mɔna akpanyanyaŋte nombiakumɛɛ keyɛɛ na moona e lɔ.<verse eid="PRO 11:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6" />Baŋ be nombia doona ke gbɛɛ nɛ, be gbɛɛneŋ katenee ne lɛɛna wɔ,</para>
  <para style="q2" vid="PRO 11:6">mɔna baŋ bɔɔ ne di anokoare ya nɛ be lookum ne kyaŋana wɔ.<verse eid="PRO 11:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7" />Nyi walaŋkum da yem na ɔ lookegyakaa te taŋ,</para>
  <para style="q2" vid="PRO 11:7">na ŋan pou bɔɔ yakosee nɛ te yɛɛ yakaa.<verse eid="PRO 11:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8" />Baa lese ŋon ɔ gbɛɛneŋ tenɛɛ nɛ lee wose kekyaŋ man,</para>
  <para style="q2" vid="PRO 11:8">na ta ke yale akpanyanyaŋte dɔɔ.<verse eid="PRO 11:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9" />Ŋon ɔ bee yee Wurubuarɛ ya na mo ɔ nɔɔ wɔlɛɛ ɔ dɔɔ,</para>
  <para style="q2" vid="PRO 11:9">mɔna bɛɛ mo nombia kagyeŋ lese ŋon be gbɛɛneŋ tenɛɛ.<verse eid="PRO 11:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10" />Nyi ŋon ɔ gbɛɛneŋ tenɛɛ de nyiŋ ɔ wose nɛ, na donɔɔ dinaa keŋ balaŋ ne nyaŋee,</para>
  <para style="q2" vid="PRO 11:10">nyi akpanyanyaŋte de wɔlɛɛ na, balaŋ ne nyaŋee fae yeesa.<verse eid="PRO 11:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11" />Baŋ be gbɛɛneŋ tenɛɛ kehiraa ne yele donɔɔ dinaa keŋ ne gyu siaman,</para>
  <para style="q2" vid="PRO 11:11">mɔna akpanyanyaŋtena nɔɔwoya ne yele bɛɛ yɛlɛɛ ke.<verse eid="PRO 11:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12" />Ŋon ɔ ne wɔlɛɛ ɔ dɔɔ ba gyeŋ daale ya,</para>
  <para style="q2" vid="PRO 11:12">mɔna ŋon ɔ ne nyii nombia man na do ɔ nɔɔ dokɔŋ.<verse eid="PRO 11:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13" />Dekarate na lese nombia aweeseŋ debɔɔ,</para>
  <para style="q2" vid="PRO 11:13">mɔna ŋon bɛɛ mo wose lɔ ɔ dɔɔ na weese nombia.<verse eid="PRO 11:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14" />Nyi donɔɔ be dana gbɛɛ wolare ya na kɛɛ yɛlɛɛ,</para>
  <para style="q2" vid="PRO 11:14">mɔna nyi balaŋ burum ne kolosi fa e na kee yoodi.<verse eid="PRO 11:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15" />Ŋon ɔ sem fa ŋɔɔle waa naa diyem,</para>
  <para style="q2" vid="PRO 11:15">mɔna ŋon ɔ wɔŋ ɔ wose lee ke man wose ne fɛɛ e.<verse eid="PRO 11:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16" />Alo ŋon ɔ ne booli ɔ sia ne nyiŋ obuo,</para>
  <para style="q2" vid="PRO 11:16">mɔna baala nyeeman doŋtena ne nyiŋ dedii kaageŋ bo.<verse eid="PRO 11:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17" />Baŋ be dana wɔe nɛ yɛɛ deeli bo fa ba wose,</para>
  <para style="q2" vid="PRO 11:17">mɔna baŋ be dana nyeemanŋɔe ne di ba wose gyerebi.<verse eid="PRO 11:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18" />Akpanyanyaŋte ne nyiŋ kabeo komketɔ bo,</para>
  <para style="q2" vid="PRO 11:18">mɔna ŋon ɔ ne duu gbɛɛneŋ katenee ne nyiŋ komketɔ kpaakpaate.<verse eid="PRO 11:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19" />Ampaŋ ŋon ɔ gbɛɛneŋ tenɛɛ ne nyiŋ nyeedoŋ,</para>
  <para style="q2" vid="PRO 11:19">mɔna ŋon ɔ silana nombiakumɛɛ ne nyiŋ yeŋ.<verse eid="PRO 11:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20" />Degbeŋgyoo ne kɔla baŋ bɛɛ gyueŋ nombia kumɛɛ,</para>
  <para style="q2" vid="PRO 11:20">mɔna baŋ dukum be doo ba kekyaabii man ya na gyoo ɔ sia.<verse eid="PRO 11:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21" />Ke yɛɛ ampaŋ nyi, baa wɔŋ akpanyanyaŋte deŋele,</para>
  <para style="q2" vid="PRO 11:21">mɔna baŋ be gbɛɛneŋ tenɛɛ baa nyiŋ ba wose<verse eid="PRO 11:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22" />Alo kyeote ŋon ɔ bɛɛ yɛɛ kolo nyansa man ya nɛ,</para>
  <para style="q2" vid="PRO 11:22">yɛɛ ŋgba kɔba yayam kɔlabii ke kekuirii memɔɔ man.<verse eid="PRO 11:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23" />Keŋ ŋon ɔ gbɛɛneŋ tenɛɛ ne gyae yɛna deili keyɛɛ,</para>
  <para style="q2" vid="PRO 11:23">mɔna akpanyanyaŋte lookegyakaa yɛna baŋ.<verse eid="PRO 11:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24" />Ŋolo ne faa lee ɔ konɔɔ man, mɔna ɔ ne nyim kpu,</para>
  <para style="q2" vid="PRO 11:24">ŋolo mɔ ne yɛɛ nkyekye, mɔna ɔ ne di diyem.<verse eid="PRO 11:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25" />Ŋon ɔ ne yɛɛ wɔe ne dee,</para>
  <para style="q2" vid="PRO 11:25">ŋon ɔ ne kyɔ balaŋ nɛ, baa kyɔ ŋon mɔ.<verse eid="PRO 11:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26" />Balaŋ ne falaa ŋon ɔ ne tɔ wamela see,</para>
  <para style="q2" vid="PRO 11:26">mɔna bee hiraa ŋon ɔ ne yɔɔ ɔ wui.<verse eid="PRO 11:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27" />Ŋon ɔ ne gyae deeli ne nyiŋ bɛrɛɛ,</para>
  <para style="q2" vid="PRO 11:27">mɔna dukum ne kɔŋ ŋon ɔ ne gyae ke nɛ dɔɔ.<verse eid="PRO 11:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28" />Baŋ bɛɛ mo ba wose lɔ ba wosekenyiŋ dɔɔ ne yale,</para>
  <para style="q2" vid="PRO 11:28">mɔna baŋ be gbɛɛneŋ tenɛɛ ne nyiŋ ba wose ŋgba faareŋ laŋte nɛ.<verse eid="PRO 11:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29" />Ŋon ɔ ne naase ɔ dekpaŋalaŋmantena diyem bee nyiŋ kolo ya,</para>
  <para style="q2" vid="PRO 11:29">te diyiŋte waa bese siakaralate tobaale.<verse eid="PRO 11:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30" />Ŋon ɔ gbɛɛneŋ tenɛɛ kekyaabii yɛɛ ŋgba nyeedoŋ daŋ nɛ,</para>
  <para style="q2" vid="PRO 11:30">te ŋon ɔ sia be kare ne lɛɛ balaŋ nyee.<verse eid="PRO 11:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31" />Nyi bɛɛ tɔ ŋon ɔ gbɛɛneŋ tenɛɛ kom tɛɛle kei dɔɔ na,</para>
  <para style="q2" vid="PRO 11:31">kenaŋ na bɔɔ wɔŋ walaŋkum na dukumyɛɛre deŋele kela yee?<verse eid="PRO 11:31" /></para>
  <para style="b" />
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1" />Ŋon ɔ ne gyae katenee ne gyae nombia kagyeŋ,</para>
  <para style="q2" vid="PRO 12:1">mɔna ŋon ɔ ne kɔla kedesina yɛɛ diyiŋte e.<verse eid="PRO 12:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2" />Balaŋ kpaakpaa na gyoo Degbeŋgyoo sia,</para>
  <para style="q2" vid="PRO 12:2">mɔna ɔ ne bu baŋ bɛɛ yɛɛ akpanyanyaŋ nombia fɔɔ.<verse eid="PRO 12:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3" />Ŋolo be tale kyaa gbeli lee akpanyanyaŋ keyɛɛ man ya,</para>
  <para style="q2" vid="PRO 12:3">mɔna bɔɔ tale kulu ŋon ɔ gbɛɛneŋ tenɛɛ nɛ ya.<verse eid="PRO 12:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4" />Alo ŋon ɔ dana dinɔɔ kpaakpaa na do ɔ baale obuo,</para>
  <para style="q2" vid="PRO 12:4">mɔna alo ŋon ɔ ne yɛɛ desɛŋ nombia yɛɛ ŋgba kaweekum nɛ ɔ baale ŋɔɔ man.<verse eid="PRO 12:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5" />Ŋon ɔ gbɛɛneŋ tenɛɛ nyeeman nombia doona ke gbɛɛ,</para>
  <para style="q2" vid="PRO 12:5">mɔna akpanyanyaŋte kekolosifa yɛɛ kabeo ke.<verse eid="PRO 12:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6" />Akpanyanyaŋte nɔɔwoya yɛɛ balaŋ kako nombia ke,</para>
  <para style="q2" vid="PRO 12:6">mɔna ŋon ɔ gbɛɛneŋ tenɛɛ kekolosi ne lɛɛ wɔ.<verse eid="PRO 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7" />Be tu akpanyanyaŋte na ɔ wui te taŋ,</para>
  <para style="q2" vid="PRO 12:7">mɔna ŋon ɔ gbɛɛneŋ tenɛɛ dekpaŋalaŋ kyaa kekpaakekpaa.<verse eid="PRO 12:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8" />Walaŋ nombia kagyeŋ man te bɛɛ mo kɛlɛɛ e,</para>
  <para style="q2" vid="PRO 12:8">te bɔɔ ne kala ŋon ɔ dana Nyeempɔkum do kolo man ya.<verse eid="PRO 12:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9" />Ŋon ɔ be doo kolo man ya te ɔ dana tobaale nɛ,</para>
  <para style="q2" vid="PRO 12:9">dei kela ŋon ɔ ne gyɔ konɔɔ mɔna ɔ be dana weenɛɛ ya.<verse eid="PRO 12:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10" />Ŋon ɔ gbɛɛneŋ tenɛɛ ne kɛɛ ɔ wonembia dɔɔ nideli,</para>
  <para style="q2" vid="PRO 12:10">mɔna akpanyanyaŋte wɔe keyɛɛ yɛɛ nyeemandoŋ ke.<verse eid="PRO 12:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11" />Baŋ bɛɛ kyaŋ ba wose fara ne nyiŋ weenɛɛ burum,</para>
  <para style="q2" vid="PRO 12:11">mɔna baŋ be silana abɔɔ yakaa nyiŋan be dana nyee ya.<verse eid="PRO 12:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12" />Akpanyanyaŋte ne gyae abɔɔ ŋan nombiakumɛɛ yɛɛra be yilaa see nɛ,</para>
  <para style="q2" vid="PRO 12:12">mɔna ŋon ɔ tenɛɛ waa kyaa gbeli nideli.<verse eid="PRO 12:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13" />Nɔɔwoya kumɛɛ yɛɛ kɔta ke fa nombiakumɛɛ yɛɛra,</para>
  <para style="q2" vid="PRO 12:13">mɔna ŋon ɔ gbɛɛneŋ tenɛɛ ne yeu lee nombia man.<verse eid="PRO 12:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14" />Nombia ŋan na lee balaŋ nɔɔman na mo nombia kpaakpaa kɔna wɔ,</para>
  <para style="q2" vid="PRO 12:14">te be nyiŋmaa man tom na mo tɔnɔɔ kɔna wɔ.<verse eid="PRO 12:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15" />Diyiŋte gbɛɛneŋ dei fa ŋon gbagba,</para>
  <para style="q2" vid="PRO 12:15">mɔna siakaralate ne tei kekolosifa.<verse eid="PRO 12:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16" />Diyiŋte na lese ɔ baŋ wola karatetee dokoloŋ,</para>
  <para style="q2" vid="PRO 12:16">mɔna siakaralate bɛɛ mo tuubia yɛɛ kolo ya.<verse eid="PRO 12:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17" />Ŋon ɔ ne di anokoare adansɛɛ ne kolosi anokoare,</para>
  <para style="q2" vid="PRO 12:17">mɔna adansɛɛkumdiiri ne di akɛrɛɛ bo.<verse eid="PRO 12:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18" />Ŋon ɔ ne kolosi bo do nɛ nɔɔwoya ne sɔɔ ŋgba yoosila nɛ,</para>
  <para style="q2" vid="PRO 12:18">mɔna nyansate nɔɔwoya ne kyɔ kawee.<verse eid="PRO 12:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19" />Anokoare nɔɔwoya doo kekpaakekpaa,</para>
  <para style="q2" vid="PRO 12:19">mɔna dekara laakem bee di weeya ya.<verse eid="PRO 12:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20" />Dekara doo baŋ bɛɛ gyueŋ dukum nɛ konɔɔse man,</para>
  <para style="q2" vid="PRO 12:20">mɔna baŋ bɛɛ gyae wosefɛɛreŋ ne nyaŋee.<verse eid="PRO 12:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21" />Nombiikum bɛɛ tale yala ŋon ɔ tenɛɛ ya,</para>
  <para style="q2" vid="PRO 12:21">mɔna nombiakumɛɛ ne yala akpanyanyaŋtena debaŋ kamasɛ.<verse eid="PRO 12:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22" />Degbeŋgyoo ne kɔla akɛrɛɛtena,</para>
  <para style="q2" vid="PRO 12:22">mɔna baŋ bee di anokoare nɛ nombia na gyoo ɔ sia.<verse eid="PRO 12:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23" />Ŋon ɔ sia be kare na weese ɔ nombia kagyeŋ,</para>
  <para style="q2" vid="PRO 12:23">mɔna diyiŋte na lese ɔ diyiŋ nombia debɔɔ.<verse eid="PRO 12:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24" />Kakyeŋ doore nyiŋmaase gyae ke di gyoori,</para>
  <para style="q2" vid="PRO 12:24">mɔna kebɔŋale gyae ka mo neŋ do gbeŋiri man.<verse eid="PRO 12:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25" />Kayeyɛɛ ne yele walaŋ wose ne yɔkɔse e,</para>
  <para style="q2" vid="PRO 12:25">mɔna nɔɔwoya kpaakpaa na do e kakyeŋ.<verse eid="PRO 12:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26" />Ŋon ɔ tenɛɛ ne kɛɛ ɔ gyoo kalese man nideli,</para>
  <para style="q2" vid="PRO 12:26">mɔna akpanyanyaŋte kekyaabii man na mo e yooso.<verse eid="PRO 12:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27" />Kebɔŋalete bee nyiŋ ŋale man naane ŋasee ya,</para>
  <para style="q2" vid="PRO 12:27">mɔna kakyeŋte ne nyiŋ ŋale man naane.<verse eid="PRO 12:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28" />Nyeedoŋ doo katenee gbɛɛ man,</para>
  <para style="q2" vid="PRO 12:28">gbɛɛ kenaŋ bɛɛ mo walaŋ gyu yeŋ man ya.<verse eid="PRO 12:28" /></para>
  <para style="b" />
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1" />Bu siakaralate ne nyii ɔ kya kawola,</para>
  <para style="q2" vid="PRO 13:1">mɔna ŋon ɔ ne kulu balaŋ bɛɛ gyae kekalana ya.<verse eid="PRO 13:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2" />Walaŋ nɔɔman nombia man te ɔ ne nyiŋ abɔɔ kpaakpaa,</para>
  <para style="q2" vid="PRO 13:2">mɔna nombiakumɛɛ ne gyɔɔna baŋ bɔɔ ne di anokoare ya nɛ loo.<verse eid="PRO 13:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3" />Baŋ bɛɛ do be nɔɔ dokɔŋ nɛ ne gyee ba nyee,</para>
  <para style="q2" vid="PRO 13:3">mɔna baŋ bee kolosi safelalaa nɛ ne wɔlɛɛ ba wose.<verse eid="PRO 13:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4" />Kolo ne gyɔ kebɔŋalete loo, mɔ ɔ bee nyim ya,</para>
  <para style="q2" vid="PRO 13:4">mɔna ŋon ɔ na do kakyeŋ ne nyiŋ ŋan pou ɔ ne gyae.<verse eid="PRO 13:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5" />Ŋon ɔ tenɛɛ ne kɔla akɛrɛɛ nombia,</para>
  <para style="q2" vid="PRO 13:5">mɔna akpanyanyaŋtena ne yɛɛ duwaare nombia,</para>
  <para style="q2" vid="PRO 13:5">mo do ba wose desɛŋ.<verse eid="PRO 13:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6" />Gbɛɛneŋ katenee ne gyee ŋon ɔ nombia dei,</para>
  <para style="q2" vid="PRO 13:6">mɔna akpanyanyaŋ keyɛɛ na soo nombiakumɛɛ yɛɛre lɔ.<verse eid="PRO 13:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7" />Ŋolo na beo yɛɛ ŋgba ɔ dana ɔ wose, mɔna ɔ be dana kolo ya,</para>
  <para style="q2" vid="PRO 13:7">ŋolo mɔ na beo yɛɛ ŋgba ɔ yɛɛ diyemte e, mɔna ɔ dana ɔ wose nideli.<verse eid="PRO 13:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8" />Walaŋ wose kenyiŋ te ɔ na mo tɔ kom lɛɛ ɔ nyee,</para>
  <para style="q2" vid="PRO 13:8">mɔna ŋolo bɛɛ ŋmaase diyemte ya mena dɔɔ ɔ be dana kom waa tom ya.<verse eid="PRO 13:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9" />Ŋon ɔ tenɛɛ keŋmaŋee ne ŋmaŋee nideli,</para>
  <para style="q2" vid="PRO 13:9">mɔna akpanyanyaŋte kanea na yem.<verse eid="PRO 13:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10" />Wose kegate na mo kale bo kɔŋ,</para>
  <para style="q2" vid="PRO 13:10">mɔna baŋ be dana nyansa ne nyii kekolosifa.<verse eid="PRO 13:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11" />Kɔba kenyiŋ lee gbɛɛkum man ne taŋ bileŋ,</para>
  <para style="q2" vid="PRO 13:11">mɔna ŋon ɔ ne yilaa kyomii kyomii nɛ ne nyiŋ ke burum.<verse eid="PRO 13:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12" />Lookegyakaa keŋ ne dɔɔ wɔle na do konɔɔ kawee,</para>
  <para style="q2" vid="PRO 13:12">mɔna kegyaebii keŋ ne kɔŋ mena yɛɛ nyeedoŋ daŋ ke.<verse eid="PRO 13:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13" />Ŋon ɔ bɛɛ mo kawola yɛɛ kolo ya na mo ɔ wose do kayeyɛɛ man,</para>
  <para style="q2" vid="PRO 13:13">mɔna ŋon ɔ ne di mmaraa dɔɔ waa nyiŋ kom ketɔ.<verse eid="PRO 13:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14" />Siakaralate kawola yɛɛ nyeedoŋ lee ke,</para>
  <para style="q2" vid="PRO 13:14">keŋ na lese walaŋ lee yeŋ kɔta man.<verse eid="PRO 13:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15" />Nombia kedi nideli na gyoo sia,</para>
  <para style="q2" vid="PRO 13:15">mɔna ŋon ɔ bee di anokoare ya gbɛɛ na e wɔ gyu kewɔlɛɛ man.<verse eid="PRO 13:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16" />Baŋ be sia be kare ne yɛɛ ba abɔɔ nombia kagyeŋ man,</para>
  <para style="q2" vid="PRO 13:16">mɔna ayiŋtena na lese be diyiŋ nombia debɔɔ.<verse eid="PRO 13:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17" />Kpilare akpanyanyaŋte ne yele kayeyɛɛ ne kɔŋ,</para>
  <para style="q2" vid="PRO 13:17">mɔna kpilare anokoarete na mo wosefɛɛreŋ kɔŋ.<verse eid="PRO 13:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18" />Ŋon ɔ bɛɛ nyi be na tenee e ya nɛ diyem na desɛŋ ne kyaŋana e.</para>
  <para style="q2" vid="PRO 13:18">mɔna ŋon ɔ sɛɛ nyi baa desina e ne nyiŋ obuo.<verse eid="PRO 13:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19" />Nyi ŋolo de nyiŋ keŋ dɔɔ ɔ loo gyakaa na ne yɛɛ e gyoŋ nideli,</para>
  <para style="q2" vid="PRO 13:19">mɔna ayiŋtena ne kɔla nombiakumɛɛ man kalee.<verse eid="PRO 13:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20" />Ŋon ɔ mo ɔ wose dona siakaralatena na ɔ sia ne kare,</para>
  <para style="q2" vid="PRO 13:20">te ŋon ɔ mo ɔ wose dona ayiŋtena na ɔ ne naa diyem.<verse eid="PRO 13:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21" />kayeyɛɛ ne kuu gyakaa dukumyɛɛra dɔɔ,</para>
  <para style="q2" vid="PRO 13:21">mɔna bɛɛ mo abɔɔ kpaakpaa tɔ ŋon ɔ tenɛɛ nɛ kom.<verse eid="PRO 13:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22" />Walaŋ kpaakpaa ne tina wa abɔɔkedi yela see ɔ naanasebia,</para>
  <para style="q2" vid="PRO 13:22">mɔna bee yilaa dukumyɛɛre dedii see ŋon ɔ tenɛɛ nɛ.<verse eid="PRO 13:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23" />Diyemte ne nyiŋ weenɛɛ burum lee awulaa man,</para>
  <para style="q2" vid="PRO 13:23">mɔna baŋ bɔɔ ne di nombia kegbɛɛ dɔɔ ya ne kuu ŋa pou laŋ.<verse eid="PRO 13:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24" />Walaŋ ŋon ɔ bɛɛ gate dambila ya ne kɔla ɔ bu,</para>
  <para style="q2" vid="PRO 13:24">mɔna ŋon ɔ ne gyae ɔ bu na tenee e.<verse eid="PRO 13:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25" />Ŋon ɔ tenɛɛ ne nyiŋ weenɛɛ di baa nideli,</para>
  <para style="q2" vid="PRO 13:25">mɔna akpanyanyaŋte dɔŋ bo tɔɔ dekpake.<verse eid="PRO 13:25" /></para>
  <para style="b" />
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1" />Alo siakaralate ne baŋ ɔ dekpaŋalaŋ,</para>
  <para style="q2" vid="PRO 14:1">mɔna alo diyiŋte dɔɔ ŋon gbagba ne yɛlɛɛna ɔ wui.<verse eid="PRO 14:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2" />Ŋon ɔ gbɛɛneŋ tenɛɛ ne yee Degbeŋgyoo,</para>
  <para style="q2" vid="PRO 14:2">mɔna baŋ bɔɔ ne di anokoare be gbɛɛneŋ man ya nɛ bɛɛ mo e yɛɛ kolo ya.<verse eid="PRO 14:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3" />Diyiŋte nɔɔwoya yɛna dambila keŋ ne tuku wɔ,</para>
  <para style="q2" vid="PRO 14:3">mɔna siakaralate nɔɔwoya ne kɛɛ be dɔɔ.<verse eid="PRO 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4" />Botɔɔ keŋ nunkyue baala be kyaa ya na, weenɛɛ adakaa keŋ ne doo yakaa,</para>
  <para style="q2" vid="PRO 14:4">mɔna weenɛɛ burum kenyiŋ na lee bo nunkyue baale doŋ man.<verse eid="PRO 14:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5" />Adansɛɛ anokoarete bee di dekara ya,</para>
  <para style="q2" vid="PRO 14:5">mɔna dekara adansɛɛte ne di akɛrɛɛ.<verse eid="PRO 14:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6" />Ŋon ɔ ne kulu balaŋ nɛ ne kɛo nyansa mɔna ɔ bee nyim ya,</para>
  <para style="q2" vid="PRO 14:6">mɔna nombia kagyeŋ be dana ŋon ɔ ne nyii nombia nawolo nɛ baŋ ya.<verse eid="PRO 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7" />Wɔŋ n wose lee diyiŋte gyaŋ,</para>
  <para style="q2" vid="PRO 14:7">nawolo nyi n be gyae n ke nyii nombia kagyeŋ nombia ya.<verse eid="PRO 14:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8" />Siakaralate nyansa yɛna nyi waa gyeŋ ɔ keta man,</para>
  <para style="q2" vid="PRO 14:8">mɔna diyiŋte diyiŋ nombia yɛɛ kabeo ke.<verse eid="PRO 14:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9" />Ayiŋtena be famenɛ na dukum keŋ bɛɛ yɛɛ ya,</para>
  <para style="q2" vid="PRO 14:9">mɔna bɛɛ boele baŋ be gbɛɛneŋ tenɛɛ nɛ.<verse eid="PRO 14:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10" />Konɔɔ kamasɛ gyeŋ weeleŋ keŋ doo ke man,</para>
  <para style="q2" vid="PRO 14:10">te ŋolo be tale nyaŋee kpuna ke ya.<verse eid="PRO 14:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11" />Akpanyanyaŋte dekpaŋalaŋ gyae ke yɛlɛɛ,</para>
  <para style="q2" vid="PRO 14:11">mɔna ŋon ɔ gbɛɛneŋ tenɛɛ kanyaŋ deni gyae ka seŋ.<verse eid="PRO 14:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12" />Gbɛɛ daale doo keŋ ke yɛɛ ŋgba ke dei,</para>
  <para style="q2" vid="PRO 14:12">mɔna kɔ ɔto ne gyu yeŋ man.<verse eid="PRO 14:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13" />Boŋɛɛse man koraŋ na konɔɔ ne nyii weeleŋ,</para>
  <para style="q2" vid="PRO 14:13">te kenyaŋee ɔto gyae ke tale yɛɛ waraŋsa kedi.<verse eid="PRO 14:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14" />Baŋ bɔɔ ne lɛɛ di ya baa nyiŋ ba komketɔ pou lee be gbɛɛneŋ dɔɔ,</para>
  <para style="q2" vid="PRO 14:14">te balaŋ kpaakpaa mɔ baa nyiŋ be wui.<verse eid="PRO 14:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15" />Ŋon ɔ be doo daale man ya ne lɛɛ nombii kamasɛ di,</para>
  <para style="q2" vid="PRO 14:15">mɔna siakaralate ne kɛɛ ɔ keta man nideli.<verse eid="PRO 14:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16" />Siakaralate ne yee te ɔ ne wɔŋ ɔ wose lee dukum keyɛɛ man,</para>
  <para style="q2" vid="PRO 14:16">mɔna diyiŋte ne barase yɛɛ kolo keŋ ɔ bɛɛ gyueŋ ke man ya.<verse eid="PRO 14:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17" />Ŋon ɔ na gyeŋ baŋ bileŋbileŋ ne yɛɛ diyiŋ abɔɔ bo,</para>
  <para style="q2" vid="PRO 14:17">te bɛɛ kɔla ŋon ɔ ne yɛɛ nombia kumɛɛ adao man.<verse eid="PRO 14:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18" />Baŋ bɔɔ doo daale man ya ne di ayiŋtena abɔɔ bo,</para>
  <para style="q2" vid="PRO 14:18">mɔna nombia kagyeŋ yɛna siakaralate obuo.<verse eid="PRO 14:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19" />Nombiakumɛɛ yɛɛra baa buŋ balaŋ kpaakpaa,</para>
  <para style="q2" vid="PRO 14:19">te akpanyanyaŋtena baa buŋ baŋ ba tenɛɛ nɛ anaanɔɔse man.<verse eid="PRO 14:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20" />Diyemte dɔɔ ɔ dɔɔna gbagba koraŋ ne kɔla e,</para>
  <para style="q2" vid="PRO 14:20">mɔna kɔbate dana gyoona burum.<verse eid="PRO 14:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21" />Ŋon ɔ bɛɛ kala ɔ dɔɔ do kolo man ya na, ɔ yɛɛ dukum yɛɛre e,</para>
  <para style="q2" vid="PRO 14:21">mɔna ŋon ɔ ne wii ayematena na ŋonna nyeebam.<verse eid="PRO 14:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22" />Baŋ bɛɛ bake nombiakumɛɛ nɛ bɛɛ yo gbɛɛ yee?</para>
  <para style="q2" vid="PRO 14:22">Mɔna kegyae na anokoare kedi gyae ke sila baŋ bɛɛ gyueŋ nombia kpaakpaa nɛ.<verse eid="PRO 14:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23" />Tom keyɛɛ nedoŋ na mo tɔnɔɔ kɔŋ,</para>
  <para style="q2" vid="PRO 14:23">mɔna nɔɔwoya yakaa na mo diyem bo kɔŋ.<verse eid="PRO 14:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24" />Siakaralatena obuo yɛna ba wose kenyiŋ,</para>
  <para style="q2" vid="PRO 14:24">mɔna ayiŋtena diyiŋ nombia na mo diyiŋ kɔŋ.<verse eid="PRO 14:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25" />Anokoare adansɛɛte ne lɛɛ balaŋ nyee,</para>
  <para style="q2" vid="PRO 14:25">mɔna adansɛɛkum diiri na beo balaŋ.<verse eid="PRO 14:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26" />Ɔ kamasɛ ŋon ɔ ne yee Degbeŋgyoo na sem keŋkeŋ,</para>
  <para style="q2" vid="PRO 14:26">keŋ gyae ke yɛɛ keyeu kagyoo fa ɔ bia.<verse eid="PRO 14:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27" />Degbeŋgyoo keyee yɛɛ nyeedoŋ detiribuŋ ke,</para>
  <para style="q2" vid="PRO 14:27">kɛɛ lese walaŋ lee yeŋ kɔta man.<verse eid="PRO 14:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28" />Balaŋ booroŋ man te gyoo ne nyiŋ gyoorobiiri,</para>
  <para style="q2" vid="PRO 14:28">nyi balaŋ be kyaa ya na gyoori kedi bɛɛ sem ya.<verse eid="PRO 14:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29" />Ɔ kamasɛ ŋon ɔ ne nyiŋ konɔɔ ne nyii nombia man,</para>
  <para style="q2" vid="PRO 14:29">mɔna ŋon ɔ na gyeŋ baŋ bileŋbileŋ na lese ɔ diyiŋ debɔɔ.<verse eid="PRO 14:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30" />Wosefɛɛreŋ ne fa walaŋ nyeedoŋ,</para>
  <para style="q2" vid="PRO 14:30">mɔna nuŋkurili na do ŋɔɔ kaweekum.<verse eid="PRO 14:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31" />Ɔkamasɛ ŋon ɔ ŋere diyemte do na ɔ ta tee Wurubuarɛ,</para>
  <para style="q2" vid="PRO 14:31">mɔna ŋon ɔ wii diyemte na mo obuo fa Wurubuarɛ.<verse eid="PRO 14:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32" />Nyi nombiikum de kɔŋ nɛ, akpanyanyaŋtena ne yale ba dukum keyɛɛ man,</para>
  <para style="q2" vid="PRO 14:32">mɔna nyi yeŋ man koraŋ na baŋ ba tenɛɛ ne yeu gyoo Wurubuarɛ.<verse eid="PRO 14:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33" />Nyansa te wulu ŋon ɔ ne nyii nombia nawolo nɛ nyee man,</para>
  <para style="q2" vid="PRO 14:33">mɔna be doo mena ayiŋtena man ya.<verse eid="PRO 14:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34" />Katenee ne gyina tɛɛlese adido,</para>
  <para style="q2" vid="PRO 14:34">mɔna dukum na do walaŋ kamasɛ desɛŋ.<verse eid="PRO 14:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35" />Gyoo sia na gyoo tobaale ŋon ɔ sia be kare nɛ,</para>
  <para style="q2" vid="PRO 14:35">mɔna tobaale ŋon ɔ ne yɛɛ desɛŋ nombia na do gyoo baŋ.<verse eid="PRO 14:35" /></para>
  <para style="b" />
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1" />Nɔɔketira wose keyɔkɔse man ne fɛɛ wɔe,</para>
  <para style="q2" vid="PRO 15:1">mɔna nɔɔwoya kefuŋ lɔ na mo baŋ kɔŋ.<verse eid="PRO 15:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2" />Siakaralate laakem na lese nombia kagyeŋ wola,</para>
  <para style="q2" vid="PRO 15:2">mɔna diyiŋ nombia na lee bo diyiŋte nɔɔman.<verse eid="PRO 15:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3" />Degbeŋgyoo sia doo yenaŋ kamasɛ,</para>
  <para style="q2" vid="PRO 15:3">ne kɛɛ akpanyanyaŋtena na balaŋ kpaakpaa.<verse eid="PRO 15:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4" />Nɔɔwoya keyɔkɔse yɛɛ nyeedoŋ daŋ ke,</para>
  <para style="q2" vid="PRO 15:4">mɔna nɔɔwoya ketulii ne yɔkɔse awoya.<verse eid="PRO 15:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5" />Diyiŋte bɛɛ mo ɔ kya katenee yɛɛ kolo ya,</para>
  <para style="q2" vid="PRO 15:5">mɔna ŋon ɔ ne tei kedesina yɛɛ siakaralate e.<verse eid="PRO 15:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6" />Dedii burum doo ŋon ɔ tenɛɛ nɛ dɛɛ,</para>
  <para style="q2" vid="PRO 15:6">mɔna keŋ akpanyanyaŋte ne nyim yɛɛ kewɔlɛɛ ke.<verse eid="PRO 15:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7" />Siakaralate nɔɔ ne yaasee nombia kagyeŋ,</para>
  <para style="q2" vid="PRO 15:7">mɔna ayiŋtena konɔɔ ba tenɛɛ ya.<verse eid="PRO 15:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8" />Degbeŋgyoo ne kɔla akpanyanyaŋtena kedeesa,</para>
  <para style="q2" vid="PRO 15:8">mɔna baŋ ba tenɛɛ kefane na gyoo ɔ sia.<verse eid="PRO 15:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9" />Degbeŋgyoo ne kɔla akpanyanyaŋtena gbɛɛneŋ,</para>
  <para style="q2" vid="PRO 15:9">mɔna ɔ ne gyae baŋ be silana gbɛɛneŋ katenee.<verse eid="PRO 15:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10" />Deŋele kewɔŋ doŋte doo fa ŋon waa yo gbɛɛ,</para>
  <para style="q2" vid="PRO 15:10">ŋon ɔ bɛɛ kekalena na waa yeŋ.<verse eid="PRO 15:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11" />Nyi yeŋ na woyadɛɛ doo Degbeŋgyoo siaman teŋteŋeleŋ na,</para>
  <para style="q2" vid="PRO 15:11">kaa bɔɔse nyi deniwalaŋ konɔɔ man?<verse eid="PRO 15:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12" />Baŋ bee kulu balaŋ bɛɛ gyae nyi baa kalana wɔ ya,</para>
  <para style="q2" vid="PRO 15:12">mena dɔɔ bɔɔ ne gyu siakaralatena gyaŋ ya.<verse eid="PRO 15:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13" />De yɛɛ ŋolo gyoŋ ɔ konɔɔ man na ɔ ne booli ɔ sia,</para>
  <para style="q2" vid="PRO 15:13">mɔna nombia ketakaa ne yɔkɔse awoya.<verse eid="PRO 15:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14" />Konɔɔ keŋ ne nyii nombia man ne gyae nombia kagyeŋ,</para>
  <para style="q2" vid="PRO 15:14">mɔna diyiŋte nɔɔ ne kolosi diyiŋ nombia bo.<verse eid="PRO 15:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15" />Baŋ bɔɔ ŋere wɔ do nɛ weeya pou dana waraŋase,</para>
  <para style="q2" vid="PRO 15:15">mɔna ŋon ɔ sia na gye ne di ɔ nɔɔ wee kamasɛ.<verse eid="PRO 15:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16" />Kolo kyomii kenyiŋ keŋ Degbeŋgyoo keyee doo ke man,</para>
  <para style="q2" vid="PRO 15:16">dei kela dedii burum kenyiŋ keŋ kaale doo ke man.<verse eid="PRO 15:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17" />Faareŋ weenɛɛ kedi keŋ kegyae doo ke man,</para>
  <para style="q2" vid="PRO 15:17">dei kela nunkyuebu ŋon ɔ be doo nuŋ kedi keŋ kekɔla doo ke man.<verse eid="PRO 15:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18" />Baŋ kporokporo na mo kale kɔŋ,</para>
  <para style="q2" vid="PRO 15:18">mɔna konɔɔ kenyiŋ ne pataa kale.<verse eid="PRO 15:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19" />Sɔɔse te lɛɛ kebɔŋalete gbɛɛnaa man pou,</para>
  <para style="q2" vid="PRO 15:19">mɔna baŋ be gbɛɛneŋ tenɛɛ detɛe man doo teeŋ.<verse eid="PRO 15:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20" />Bu siakaralate ne yele ɔ kya ne nyaŋee,</para>
  <para style="q2" vid="PRO 15:20">mɔna bu diyiŋte na mo ɔ naa sia tiu tɛɛle.<verse eid="PRO 15:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21" />Diyiŋ na mo kenyaŋee kɔna ŋon ɔ ba gyeŋ nombia ya nɛ,</para>
  <para style="q2" vid="PRO 15:21">mɔna ŋon ɔ ne nyii nombia man keta man doo teeŋ.<verse eid="PRO 15:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22" />Nyi n te nyii kekolosifa ya na n nyeeman kebake bee dee ya,</para>
  <para style="q2" vid="PRO 15:22">mɔna balaŋ burum kekolosifa kpaakpaa ne yele abɔɔ ne gyu nideli fa wɔ.<verse eid="PRO 15:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23" />Nɔɔketira nideli na mo kenyaŋee kɔŋ,</para>
  <para style="q2" vid="PRO 15:23">nombii kekyako ka debaŋ man mɔ dei nideli.<verse eid="PRO 15:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24" />Siakaralate ne tɛɛ gbɛɛ keŋ gyae ka mo e gyu nyeedoŋ man bo,</para>
  <para style="q2" vid="PRO 15:24">na waa wɔŋ ɔ wose lee gbɛɛ keŋ gyae ka mo e gyu woyadɛɛ man.<verse eid="PRO 15:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25" />Degbeŋgyoo ne yɛlɛɛ baŋ bɛɛ gate ba wose nɛ akpaŋalaŋ,</para>
  <para style="q2" vid="PRO 15:25">mɔna ɔ na do lialo wuluse nideli.<verse eid="PRO 15:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26" />Degbeŋgyoo ne kɔla akpanyanyaŋtena nyeeman kebake,</para>
  <para style="q2" vid="PRO 15:26">mɔna nombia kpaakpaa kekolosi na gyoo ɔ sia.<verse eid="PRO 15:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27" />Ŋon ɔ sia ne yɛɛ abɔɔ ne wɔlɛɛ ɔ dekpaŋalaŋ,</para>
  <para style="q2" vid="PRO 15:27">mɔna ŋon ɔ ne kɔla abɔɔ kayolɛɛ waa nyiŋ nyeedoŋ.<verse eid="PRO 15:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28" />Ŋon ɔ tenɛɛ na gyueŋ nideli pɛte waa tira nombii nɔɔ,</para>
  <para style="q2" vid="PRO 15:28">mɔna akpanyanyaŋte nɔɔ ne kolosi nombiakumɛɛ bo lɔ.<verse eid="PRO 15:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29" />Degbeŋgyoo na akpanyanyaŋtena nsana dana lem,</para>
  <para style="q2" vid="PRO 15:29">mɔna ɔ ne nyii baŋ ba tenɛɛ nɛ kefane.<verse eid="PRO 15:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30" />Sia kebooli ne yele walaŋ ne nyaŋee ɔ konɔɔ man,</para>
  <para style="q2" vid="PRO 15:30">te nombia kpaakpaa kenyii ne yele walaŋ ŋɔɔman ne yɛɛ e doŋ.<verse eid="PRO 15:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31" />Walaŋ ŋon ɔ ne tei kedesina,</para>
  <para style="q2" vid="PRO 15:31">waa kyaa siakaralatena man.<verse eid="PRO 15:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32" />Baŋ bɔɔ ne gyae katenee ya ne yɛɛ ba wose,</para>
  <para style="q2" vid="PRO 15:32">mɔna ŋon ɔ ne gyae nyi baa desina e ne nyii nombia man.<verse eid="PRO 15:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33" />Nyansa kawola yɛna Degbeŋgyoo keyee,</para>
  <para style="q2" vid="PRO 15:33">te wose keyɔkɔse dɔŋ siaman fa obuo.<verse eid="PRO 15:33" /></para>
  <para style="b" />
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1" />Denibalaŋ ne bake ba nyeeman,</para>
  <para style="q2" vid="PRO 16:1">mɔna Degbeŋgyoo nɔɔketira yɛna kpaakpaate.<verse eid="PRO 16:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2" />Ne yɛɛ walaŋ nyi ɔ gbɛɛneŋ pou dei fa e,</para>
  <para style="q2" vid="PRO 16:2">mɔna Degbeŋgyoo na gyoona ŋe man kɛɛ.<verse eid="PRO 16:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3" />Mo n kpene kamasɛ do Degbeŋgyoo nyiŋmaa man,</para>
  <para style="q2" vid="PRO 16:3">na waa yela n nyeeman kebake pou ka seŋ.<verse eid="PRO 16:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4" />Degbeŋgyoo gyeŋ keŋ dɔɔ te ɔ ne yɛɛ kpene kamasɛ,</para>
  <para style="q2" vid="PRO 16:4">akpanyanyaŋte koraŋ ɔ te desina e fa nombiikum wee.<verse eid="PRO 16:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5" />Degbeŋgyoo ne kɔla baŋ pou be dana agaŋtaŋ.</para>
  <para style="q2" vid="PRO 16:5">Ke yɛɛ ampaŋ. De yɛɛ senaa waa wɔŋ ba deŋele.<verse eid="PRO 16:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6" />Kegyae taŋ ɔto ya na anokoare kedi te bɛɛ mo pataa dukum keyɛɛ,</para>
  <para style="q2" vid="PRO 16:6">Degbeŋgyoo keyee ne yelela walaŋ ne wɔŋ ɔ wose lee dukum man.<verse eid="PRO 16:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7" />Nyi ŋolo gbɛɛneŋ da gyoo Degbeŋgyoo sia nɛ,</para>
  <para style="q2" vid="PRO 16:7">ɔ ne yele ŋon na ɔ kɔlara ne kyaa wosefɛɛreŋ man.<verse eid="PRO 16:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8" />Kolo kyomii kenyiŋ lee katenee gbɛɛ man dei,</para>
  <para style="q2" vid="PRO 16:8">kela abɔɔ burum kenyiŋ lee nombia ketulii gbɛɛ man.<verse eid="PRO 16:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9" />Deniwalaŋ ne bake bo ɔ nyeeman,</para>
  <para style="q2" vid="PRO 16:9">mɔna Degbeŋgyoo na wolana ɔ nawɔɔ kekulu man.<verse eid="PRO 16:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10" />Gyoo kekolosi lee Wurubuarɛ gyaŋ,</para>
  <para style="q2" vid="PRO 16:10">te ɔ nɔɔ bee tulii keŋ doona ke gbɛɛ ya.<verse eid="PRO 16:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11" />Sikeli na abɔɔ kekeri kpaakpaate yɛɛ Degbeŋgyoo wui,</para>
  <para style="q2" vid="PRO 16:11">ŋon doona kasolɔse ŋan pou doo kotoku man nideli.<verse eid="PRO 16:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12" />Gyooneŋ ne kɔla nombiakumɛɛ keyɛɛ,</para>
  <para style="q2" vid="PRO 16:12">nawolo nyi ba see gyoorogbeli bo katenee gbɛɛ dɔɔ.<verse eid="PRO 16:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13" />Anokoare nombia kekolosi na gyoo gyooneŋ sia,</para>
  <para style="q2" vid="PRO 16:13">te bɛɛ gyae ŋon ɔ ne kolosi keŋ tenɛɛ.<verse eid="PRO 16:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14" />Gyoo baŋ yɛna yeŋ kpilare,</para>
  <para style="q2" vid="PRO 16:14">mɔna siakaralete ne fɛɛ ɔ wɔe.<verse eid="PRO 16:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15" />Nyi gyoo de booli ɔ sia nɛ, na mo nyeedoŋ kɔŋ,</para>
  <para style="q2" vid="PRO 16:15">ɔ bɛrɛɛ yɛɛ ŋgba weenɛɛ keduutɛɛ ɔga nɛ.<verse eid="PRO 16:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16" />Nyansa kenyiŋ dei kela kɔba yayam,</para>
  <para style="q2" vid="PRO 16:16">nombia man kagyeŋ dei kela kɔba wolom.<verse eid="PRO 16:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17" />Baŋ be gbɛɛneŋ tenɛɛ ne kɔla dukum keyɛɛ,</para>
  <para style="q2" vid="PRO 16:17">baŋ bɛɛ kɛɛ ba keta man ne gyee ba nyeedoŋ.<verse eid="PRO 16:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18" />Agaŋtaŋ na mo walaŋ gyu kewɔlɛɛ man,</para>
  <para style="q2" vid="PRO 16:18">wose kegyina ne yele walaŋ ne yale.<verse eid="PRO 16:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19" />Dei nyi nya yɔkɔse n wose kpuna baŋ bɛɛ ŋere wɔ do nɛ,</para>
  <para style="q2" vid="PRO 16:19">kela ɛmɛɛ na agaŋtaŋtena ke kpala yoo abɔɔ.<verse eid="PRO 16:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20" />Ɔkamasɛ ŋon ɔ ne tei nombia kawola nɛ abɔɔ ne dee fa e,</para>
  <para style="q2" vid="PRO 16:20">te ŋon ɔ na mo ɔ wose lɔ Degbeŋgyoo dɔɔ nɛ, ŋonna nyeebam.<verse eid="PRO 16:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21" />Bɛɛ yako nyi siakaralate ne nyii nombia man,</para>
  <para style="q2" vid="PRO 16:21">te nɔɔwoya gyoŋ nyiŋan na do walaŋ kakyeŋ na waa yɛɛ keŋ dei.<verse eid="PRO 16:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22" />Nyansa yɛna nyeedoŋ loŋ deepue lee fa ŋon ɔ dana nyansa,</para>
  <para style="q2" vid="PRO 16:22">mɔna diyiŋ nombia na mo deŋele kewɔŋ kɔna ayiŋtena.<verse eid="PRO 16:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23" />Siakaralate ne kɛɛ ɔ kekolosi man nideli,</para>
  <para style="q2" vid="PRO 16:23">te ne yele ɔ nɔɔwoya na do balaŋ kakyeŋ na baa yɛɛ keŋ dei.<verse eid="PRO 16:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24" />Nɔɔwoya gyoŋ nyiŋan yɛɛ ŋgba teebɔɔ nɛ,</para>
  <para style="q2" vid="PRO 16:24">dana walaŋ woo gyoŋ te ŋɛɛ kyɔ e kaweese.<verse eid="PRO 16:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25" />Gbɛɛ daale doo keŋ ne yɛɛ walaŋ nyi ka tenɛɛ,</para>
  <para style="q2" vid="PRO 16:25">mɔna kɔ ɔto ne gyu yeŋ man.<verse eid="PRO 16:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26" />Ne gyɔ paate loo nyi waa yɛɛ tom nedoŋ,</para>
  <para style="q2" vid="PRO 16:26">tanam ne tɛɛsena e do ke man.<verse eid="PRO 16:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27" />Ɔhuhoo ne bake dukum,</para>
  <para style="q2" vid="PRO 16:27">te ɔ nɔɔwoya yɛɛ ŋgba boalaŋ keŋ ne kpaa nɛ.<verse eid="PRO 16:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28" />Ŋon ɔ ne tulii nombia na mo kale kɔŋ,</para>
  <para style="q2" vid="PRO 16:28">te kelaberetaore ne tira dɔɔna nsana.<verse eid="PRO 16:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29" />Nyeeman detiŋtɛɛte na beo ɔ dɔɔ,</para>
  <para style="q2" vid="PRO 16:29">na ɔ ta mo e ta detɛekum man.<verse eid="PRO 16:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30" />Ɔkamasɛ ŋon ɔ ne gyɔ sia kpabeekpabee na gyueŋ nombia ketulii,</para>
  <para style="q2" vid="PRO 16:30">ɔkamasɛ ŋon ɔ ne tao ɔ kela na ɔ ne yɛɛ dukum.<verse eid="PRO 16:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31" />Keŋmɛ yɛɛ obuo ke,</para>
  <para style="q2" vid="PRO 16:31">katenee man te bee nyiŋ ke.<verse eid="PRO 16:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32" />Ŋon ɔ ne nyiŋ konɔɔ dei kela baalabiiri,</para>
  <para style="q2" vid="PRO 16:32">ŋon ɔ ne di ɔ wose dɔɔ dei kela ŋon ɔ ne lɛo donɔɔ dinaa.<verse eid="PRO 16:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33" />Bɛɛ lɔ boe mo kɛɛ nombia man,</para>
  <para style="q2" vid="PRO 16:33">mɔna Degbeŋgyoo gyeŋana keŋ gyae kekɔŋ gbagba.<verse eid="PRO 16:33" /></para>
  <para style="b" />
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1" />Weenɛɛ dekpake kedi wosefɛɛreŋ man,</para>
  <para style="q2" vid="PRO 17:1">dei kela nɔɔkedi dekpaŋalaŋ keŋ kale wolowolo.<verse eid="PRO 17:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2" />Gbeŋi ŋon ɔ sia be kare nɛ waa di bu desɛŋte dɔɔ,</para>
  <para style="q2" vid="PRO 17:2">te waa nyiŋ dedii ŋgba bia baŋ man ŋolo nɛ.<verse eid="PRO 17:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3" />Bɛɛ mo boalaŋ yalakee kɔba wolom na boalaŋ degyapaa yalakee kɔba yayam,</para>
  <para style="q2" vid="PRO 17:3">mena ke te Degbeŋgyoo ne kɛɛse konɔɔ man kɛɛ.<verse eid="PRO 17:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4" />Akpanyanyaŋte ne tei akpanyanyaŋ nombia,</para>
  <para style="q2" vid="PRO 17:4">dekarate mɔ ne tei akɛrɛɛ nombia.<verse eid="PRO 17:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5" />Ɔkamasɛ ŋon ɔ kulu diyemte na ɔ ta tee Wurubuarɛ,</para>
  <para style="q2" vid="PRO 17:5">ɔkamasɛ ŋon ɔ nyaŋee lee ŋolo nombiikum dɔɔ na baa wɔŋ ɔ deŋele.<verse eid="PRO 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6" />Kegyiise gyoorobiiri yɛna be naana doona,</para>
  <para style="q2" vid="PRO 17:6">te bia obuo yɛna ba lolala.<verse eid="PRO 17:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7" />Nombii kpaakpaa bɛɛ lee diyiŋte kekolosi man ya,</para>
  <para style="q2" vid="PRO 17:7">te dekara bɛɛ lee siamante nɔɔman ya.<verse eid="PRO 17:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8" />Kayofa yɛɛ ŋgba bɛrɛɛ nɛ fa ŋon ɔ ne faa,</para>
  <para style="q2" vid="PRO 17:8">bɛɛ gyueŋ nyi kede gyae ka lee ke man kɔŋ gbɛɛ kamasɛ man.<verse eid="PRO 17:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9" />Ŋon ɔ na mo dukum kyɛɛ na mo kegyae kɔŋ,</para>
  <para style="q2" vid="PRO 17:9">mɔna ŋon ɔ ne putii nombia ne tira gyoona nsana.<verse eid="PRO 17:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10" />Nyi be kalena ŋon ɔ ne nyii nombia man nɛ, na gyoo ɔ nyeeman,</para>
  <para style="q2" vid="PRO 17:10">kela baa tuku diyiŋte dembiise sɔŋonoŋ (100)<verse eid="PRO 17:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11" />Balaŋkumɛɛ kegyaebii yɛna nombia keloodo,</para>
  <para style="q2" vid="PRO 17:11">mena dɔɔ kpilare nyeeman doŋte waa kaa seŋ tia wɔ.<verse eid="PRO 17:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12" />Dei nyi nya gyaŋeena mokɔɔte ŋon bɔɔ gate ɔ bia,</para>
  <para style="q2" vid="PRO 17:12">kela diyiŋte ɔ diyiŋ nombia man.<verse eid="PRO 17:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13" />Ŋon ɔ na mo dukum tɔ deeli kom nɛ,</para>
  <para style="q2" vid="PRO 17:13">dukum be gyae ke paŋ ɔ dekpaŋalaŋ man ya.<verse eid="PRO 17:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14" />Kale kewalaŋ yɛɛ ŋgba detiribuŋ keŋ kɔɔ toro nɛ,</para>
  <para style="q2" vid="PRO 17:14">mena dɔɔ tina aŋmaareŋ yela pɛna ke kaa yɛɛ doŋ.<verse eid="PRO 17:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15" />Ŋon ɔ tina ŋon ɔ be di fɔɔ yela te ɔ bu ŋon ɔ nombia dei fɔɔ nɛ,</para>
  <para style="q2" vid="PRO 17:15">Degbeŋgyoo ne kɔla ŋe popou.<verse eid="PRO 17:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16" />Weera dɔɔ te diyiŋte na tela kɔba nyi waa lɛɛ nyansa,</para>
  <para style="q2" vid="PRO 17:16">debaŋ keŋ ɔ ba gyeŋ keŋ waa mo ke yɛɛ ya?<verse eid="PRO 17:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17" />Dɔɔ ne gyae debaŋ kamasɛ,</para>
  <para style="q2" vid="PRO 17:17">te loŋto dɔɔ waa kyɔ neŋ n wose kekyaŋ man.<verse eid="PRO 17:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18" />Walaŋ ŋon ɔ be dana nyansa ya na seŋala kom man,</para>
  <para style="q2" vid="PRO 17:18">te ɔ ne sɛɛ nyi waa tɔ ke fa ɔ dɔɔ.<verse eid="PRO 17:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19" />Ŋon ɔ ne gyae kale ne gyae dukum,</para>
  <para style="q2" vid="PRO 17:19">ŋon ɔ ne kolosi agaragara man ne gyae nombia fa ɔ wose.<verse eid="PRO 17:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20" />Ŋon ɔ na gyueŋ dukum ɔ konɔɔ man be gyae waa de ya,</para>
  <para style="q2" vid="PRO 17:20">ŋon ɔ dana laakemse ala ala ne yale nombia man.<verse eid="PRO 17:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21" />Bu diyiŋte kalola na mo mutii kɔŋ,</para>
  <para style="q2" vid="PRO 17:21">ɔ bee yele ɔ lolala ke nyaŋee korakora ya.<verse eid="PRO 17:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22" />Konɔɔ keŋ ne nyaŋee yɛɛ tee kpaakpaa ke,</para>
  <para style="q2" vid="PRO 17:22">mɔna wose ketekerii ne fa ŋɔɔ man kaweekum.<verse eid="PRO 17:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23" />Akpanyanyaŋte na yoo lɛɛ kolo detiŋtɛɛ man,</para>
  <para style="q2" vid="PRO 17:23">na waa nyiŋ tulii nombia kedi kegbɛɛ man.<verse eid="PRO 17:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24" />Ŋon ɔ ne nyii nombia man ne kɛo nyansa gbɛɛ,</para>
  <para style="q2" vid="PRO 17:24">mɔna diyiŋte sia ne kɛo bo ŋɔlɔŋɔlɔ yenaŋ kamasɛ.<verse eid="PRO 17:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25" />Bu diyiŋte na mo kemutii kɔna ɔ kya,</para>
  <para style="q2" vid="PRO 17:25">na weeleŋ kɔna ɔ naa ŋon ɔ ba lola e.<verse eid="PRO 17:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26" />Akpaa tekaboena nyi ba do ŋon ɔ nombia dei kom ya nɛ,</para>
  <para style="q2" vid="PRO 17:26">mena ke te tekaboena nyi baa tuku kegyia ŋon ɔ gbɛɛneŋ tenɛɛ ya.<verse eid="PRO 17:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27" />Ŋon ɔ gyeŋ nombia bee kolosi yakaayakaa ya,</para>
  <para style="q2" vid="PRO 17:27">te ɔkamasɛ ŋon ɔ ne nyii nombia man ne nyiŋ konɔɔ.<verse eid="PRO 17:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28" />Nyi diyiŋte de wuu ɔ nɔɔ na, bɛɛ kɛɛ nyi ɔ sia te kare,</para>
  <para style="q2" vid="PRO 17:28">nyi ɔ do ɔ laakem dokɔŋ na bɛɛ kɛɛ nyi ɔ gyeŋ nombia man.<verse eid="PRO 17:28" /></para>
  <para style="b" />
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1" />Ŋon ɔ bɛɛ mo ɔ wose dona balaŋ ya ne sila keŋ dei fa e bo,</para>
  <para style="q2" vid="PRO 18:1">te ɔ na sem tia nyeempɔ kpaakpaa kamasɛ.<verse eid="PRO 18:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2" />Nombia man kenyii bɛɛ gyoo ayiŋtena sia ya,</para>
  <para style="q2" vid="PRO 18:2">mɔna keŋ doo be man kaageŋ te bɛɛ lese yako.<verse eid="PRO 18:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3" />Akpanyanyaŋ na mo sia kamo tiu tɛɛle kɔŋ,</para>
  <para style="q2" vid="PRO 18:3">te desɛŋ na mo balaŋ kaboŋo kɔŋ.<verse eid="PRO 18:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4" />Siakaralate nɔɔwoya yɛɛ ŋgba ɛpo siiliŋ nɛ,</para>
  <para style="q2" vid="PRO 18:4">mɔna nyansa yɛɛ ŋgba boo keŋ ne lam nɛ.<verse eid="PRO 18:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5" />Tekaboena nyi baa seŋ akpanyanyaŋte wɔle,</para>
  <para style="q2" vid="PRO 18:5">na baa ŋere ŋon ɔ nombia dei nɛ do nombia kedi kegbɛɛ man ya.<verse eid="PRO 18:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6" />Diyiŋte nɔɔwoya na mo kale kɔŋ,</para>
  <para style="q2" vid="PRO 18:6">te ɔ kekolosi ne kɔna ketuku.<verse eid="PRO 18:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7" />Diyiŋte nɔɔwoya na moona e do nombia man.</para>
  <para style="q2" vid="PRO 18:7">te ɔ kekolosi ne nyɔɔna e kɔta.<verse eid="PRO 18:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8" />Kelaberetaore nɔɔwoya yɛɛ ŋgba weenɛɛ gyaagyi nɛ,</para>
  <para style="q2" vid="PRO 18:8">ŋɛɛ gyoo walaŋ debaa man nideli.<verse eid="PRO 18:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9" />Ŋon ɔ bɛɛ do kakyeŋ ɔ tom man ya nɛ,</para>
  <para style="q2" vid="PRO 18:9">ɔ loŋto yɛna abɔɔ wɔlɛɛre.<verse eid="PRO 18:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10" />Degbeŋgyoo yele yɛɛ dekagya doŋte ke,</para>
  <para style="q2" vid="PRO 18:10">baŋ ba tenɛɛ ne yeu gyu ke man kenyiŋ kegyee.<verse eid="PRO 18:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11" />Kɔbate nyeempɔ yɛna nyi wa dedii yɛna ɔ donɔɔ dinaa doŋte,</para>
  <para style="q2" vid="PRO 18:11">ɔ kɛɛ ke nyi ke yɛɛ dekyaŋ keŋ ka korɛɛ nideli.<verse eid="PRO 18:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12" />Wose kegate na mo keyala kɔŋ,</para>
  <para style="q2" vid="PRO 18:12">mɔna wose keyɔkɔse na mo obuo kɔŋ.<verse eid="PRO 18:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13" />Nombii nɔɔketira pɛte n ne tei ke nɛ,</para>
  <para style="q2" vid="PRO 18:13">yɛɛ diyiŋ na desɛŋ ke.<verse eid="PRO 18:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14" />Kakyeŋ kado ne yele walaŋ na sem kawee man,</para>
  <para style="q2" vid="PRO 18:14">mɔna amɔte ne gyaela waa tale seŋ wose ketekerii man?<verse eid="PRO 18:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15" />Ŋon ɔ ne nyii nombia man ne nyiŋ nombia kagyeŋ,</para>
  <para style="q2" vid="PRO 18:15">te siakaralate deŋela ne kɛo ke.<verse eid="PRO 18:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16" />Kefa na toro gbɛɛ,</para>
  <para style="q2" vid="PRO 18:16">na ta mo ŋon ɔ ne faa nɛ gyu kegyiise siaman.<verse eid="PRO 18:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17" />Nombia dedii man nɛ, bɛɛ kɛɛ kolosire gyaŋgbate nyi ɔ nombia dei,</para>
  <para style="q2" vid="PRO 18:17">kelii debaŋ keŋ ɔ dɔɔ ŋon waa kaa bɔɔse e nombia.<verse eid="PRO 18:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18" />Boe kelɔ ne yele kale ne fɛɛ,</para>
  <para style="q2" vid="PRO 18:18">te kɛɛ pataa doŋtena nsana.<verse eid="PRO 18:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19" />Loŋto ŋon bɔɔ yɛɛ e dukum dana doŋ nideli kela donɔɔ dinaa keŋ bɔɔ baŋ dekyaŋ kilisi ke,</para>
  <para style="q2" vid="PRO 18:19">kale yɛɛ ŋgba gyooro dekpaŋalaŋ keŋ bɔɔ do ke nyeele denaanɔɔ nɛ.<verse eid="PRO 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20" />Nombia ŋan na lee walaŋ nɔɔman ne wuluna ɔ tɔɔ,</para>
  <para style="q2" vid="PRO 18:20">keŋ na lee ɔ kekolosi man ne yelela ɔ ne baa.<verse eid="PRO 18:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21" />Nyeedoŋ na yeŋ doŋ doo laakem man,</para>
  <para style="q2" vid="PRO 18:21">ŋon ɔ ne gyae ke waa di ke bia.<verse eid="PRO 18:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22" />Ŋon ɔ nyiŋ alo kpaakpaa yala na ɔ te nyiŋ kolo kpaakpaa,</para>
  <para style="q2" vid="PRO 18:22">na Degbeŋgyoo boele e baa.<verse eid="PRO 18:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23" />Diyemte na mo kewaase bo kolosi,</para>
  <para style="q2" vid="PRO 18:23">mɔna kɔbate ne tiranɔɔ bo pataapataa.<verse eid="PRO 18:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24" />Ŋon ɔ dana dɔɔna baŋ bɔɔ na mo wose lɔ be dɔɔ ya ne tale wɔlɛɛ e,</para>
  <para style="q2" vid="PRO 18:24">mɔna dɔɔ ŋolo kyaa keŋ ɔ ne mataa kela loŋto.<verse eid="PRO 18:24" /></para>
  <para style="b" />
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1" />Diyemte ŋon nombiikum be doo ɔ keta man ya dei,</para>
  <para style="q2" vid="PRO 19:1">kela diyiŋte ŋon ɔ ne tulii ɔ nɔɔwoya.<verse eid="PRO 19:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2" />Nyi ŋolo bɛɛ gyae nombia kagyeŋ ya na be dei ya,</para>
  <para style="q2" vid="PRO 19:2">nawɔɔ ɔsaate na yo gbɛɛ.<verse eid="PRO 19:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3" />Walaŋ gbagba diyiŋ nombia ne wɔlɛɛna e,</para>
  <para style="q2" vid="PRO 19:3">te ɔ konɔɔ na koro tia Degbeŋgyoo.<verse eid="PRO 19:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4" />Wose kenyiŋ ne wɔŋ dɔɔna burum kɔŋ,</para>
  <para style="q2" vid="PRO 19:4">mɔna diyemte ɔ dɔɔ koraŋ ne bɛɛ e.<verse eid="PRO 19:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5" />Adansɛɛkumdiiri be nyiŋ ɔ wose nyi bɔɔ wɔŋ ɔ deŋele ya,</para>
  <para style="q2" vid="PRO 19:5">te dekarate be gyae waa nyiŋ gbɛɛ lɛɛ ɔ wose ya.<verse eid="PRO 19:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6" />Balaŋ burum na mo gbɛɛ daale nyi be nombia kagyoo kegyia sia,</para>
  <para style="q2" vid="PRO 19:6">te walaŋ kamasɛ na mo ŋon ɔ ne fa abɔɔ nɛ dɔɔre.<verse eid="PRO 19:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7" />Diyemte ɔ loŋtona pou ne kɔla e,</para>
  <para style="q2" vid="PRO 19:7">kaa bɔɔse nyi ɔ gyoona be wɔŋana ba wose lee ɔ gyaŋ yee?</para>
  <para style="b" vid="PRO 19:7" />
  <para style="q1" vid="PRO 19:7">Nyi ɔ yase sia waase wɔ koraŋ nɛ,</para>
  <para style="q2" vid="PRO 19:7">bɔɔ ne kɔŋ ya.<verse eid="PRO 19:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8" />Ŋon ɔ nyiŋ nyansa ne gyae ɔ wose,</para>
  <para style="q2" vid="PRO 19:8">ŋon nombia man kenyii na gyoo ɔ sia waa de.<verse eid="PRO 19:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9" />Adansɛɛkumdiiri be gyae waa nyiŋ ɔ wose nyi bɔɔ wɔŋ ɔ deŋele ya,</para>
  <para style="q2" vid="PRO 19:9">te ɔkamasɛ ŋon ɔ di dekara waa munu.<verse eid="PRO 19:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10" />Tekaboena nyi diyiŋte waa kyaa gyoŋ kedi man ya,</para>
  <para style="q2" vid="PRO 19:10">kaa bɔɔse nyi gbeŋi ke di gyoorobia dɔɔ.<verse eid="PRO 19:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11" />Ŋon ɔ gyeŋ nyansa ne nyiŋ konɔɔ,</para>
  <para style="q2" vid="PRO 19:11">nyi ŋolo da mo kolokum kyɛɛ na kɛɛ fa e obuo.<verse eid="PRO 19:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12" />Gyoo baŋ kagyeŋ yɛɛ ŋgba dinaate kemuusu nɛ,</para>
  <para style="q2" vid="PRO 19:12">mɔna ɔ bɛrɛɛ yɛɛ ŋgba ŋale dɔɔ obosuo nɛ.<verse eid="PRO 19:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13" />Bu diyiŋte yɛna ɔ kya kewɔlɛɛ,</para>
  <para style="q2" vid="PRO 19:13">te alo yalale kale gyaere yɛɛ ŋgba,</para>
  <para style="q2" vid="PRO 19:13">deni keŋ ne lilii debaŋ kamasɛ nɛ.<verse eid="PRO 19:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14" />Dekpaŋalaŋ na wosekenyiŋ yɛɛ dedii lee kyaɔ gyaŋ,</para>
  <para style="q2" vid="PRO 19:14">mɔna alo yalale nyansate lee Degbeŋgyoo gyaŋ.<verse eid="PRO 19:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15" />Kebɔŋale na mo kedoo yeŋ kɔŋ,</para>
  <para style="q2" vid="PRO 19:15">te wosegyoŋte na yeŋ tanam bo.<verse eid="PRO 19:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16" />Ɔkamasɛ ŋon ɔ di mmaraase dɔɔ ne nyiŋ nyeedoŋ,</para>
  <para style="q2" vid="PRO 19:16">mɔna ɔkamasɛ ŋon ɔ te kɛɛ ɔ gbɛɛ man nideli ya waa yeŋ.<verse eid="PRO 19:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17" />Ɔkamasɛ ŋon ɔ wii diyemte na mo baa paa Degbeŋgyoo,</para>
  <para style="q2" vid="PRO 19:17">te waa tɔ e keŋ ɔ be yɛɛ nɛ kom.<verse eid="PRO 19:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18" />Tenee n bia debaŋ keŋ lookegyakaa doo nɛ,</para>
  <para style="q2" vid="PRO 19:18">n te yɛɛ mena ya na n na ko wɔ baa.<verse eid="PRO 19:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19" />Ŋon ɔ dana baŋkum waa nyiŋ ka deŋele kewɔŋ,</para>
  <para style="q2" vid="PRO 19:19">nyi n lɛɛ e na, n ka bese lɛɛ e bela.<verse eid="PRO 19:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20" />Nyii kekolosifa na n ke lɛɛ katenee do,</para>
  <para style="q2" vid="PRO 19:20">ɔtoman na baa kala neŋ kpu siakaralatena man.<verse eid="PRO 19:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21" />Walaŋ ne bake nombia burum ɔ nyeeman,</para>
  <para style="q2" vid="PRO 19:21">mɔna Degbeŋgyoo kegyaebii na seŋala.<verse eid="PRO 19:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22" />Walaŋ kegyaebii yɛna baa di anokoare fa e,</para>
  <para style="q2" vid="PRO 19:22">te diyemte dei kela dekarate.<verse eid="PRO 19:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23" />Degbeŋgyoo keyee ne fa nyeedoŋ,</para>
  <para style="q2" vid="PRO 19:23">ŋon ɔ kyaŋ ke ne kyaa wɔekefɛɛ man keŋ nombiikum be yala e ya.<verse eid="PRO 19:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24" />Kebɔŋalete na mo ɔ nyiŋmaa takaa weenɛɛ nyefale man,</para>
  <para style="q2" vid="PRO 19:24">mɔna ɔ bɛɛ lese ke kaa do ɔ nɔɔman gba ya.<verse eid="PRO 19:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25" />Tuku ŋon ɔ ne kulu balaŋ, na ŋon ɔ ba gyeŋ daale ya ke kasee nyansa,</para>
  <para style="q2" vid="PRO 19:25">kalana ŋon ɔ ne nyii nombia man, na waa bese gyeŋ nombia kpu.<verse eid="PRO 19:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26" />Ɔkamasɛ ŋon ɔ naase ɔ kya diyem te ɔ tu ɔ naa nɛ,</para>
  <para style="q2" vid="PRO 19:26">ɔ yɛɛ bu ŋon ɔ na mo desɛŋ na desɛŋ nombia kɔŋ.<verse eid="PRO 19:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27" />Me bu nyi n bɛɛ nombia kawola nɛ,</para>
  <para style="q2" vid="PRO 19:27">n ke kpase lee nombia kagyeŋ gbɛɛ man.<verse eid="PRO 19:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28" />Dekara adansɛɛte ne kulu nombii na kegbɛɛ,</para>
  <para style="q2" vid="PRO 19:28">te akpanyanyaŋte nɔɔ ne kolosi nombia kumɛɛ.<verse eid="PRO 19:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29" />Deŋele kewɔŋ doo fa baŋ bee kulu balaŋ,</para>
  <para style="q2" vid="PRO 19:29">te ketuku doo fa ayiŋtena maamase dɔɔ.<verse eid="PRO 19:29" /></para>
  <para style="b" />
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1" />Waen ne kulu balaŋ, te soloŋ doŋte na mo kale kɔŋ,</para>
  <para style="q2" vid="PRO 20:1">ŋon ŋe da beo e na ɔ yɛɛ diyiŋte e.<verse eid="PRO 20:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2" />Gyoo baŋ kagyeŋ ne ŋmaase ŋgba dinaate kemuusu nɛ,</para>
  <para style="q2" vid="PRO 20:2">ŋon ɔ do e baŋ na ɔ ne nyiŋ yeŋ.<verse eid="PRO 20:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3" />Walaŋ obuo yɛna n ke wɔŋ n wose lee kale kegyae man,</para>
  <para style="q2" vid="PRO 20:3">mɔna diyiŋte kamasɛ ne gyae kale bo bileŋbileŋ.<verse eid="PRO 20:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4" />Kebɔŋalete bɛɛ fare kefaratɛɛ ya,</para>
  <para style="q2" vid="PRO 20:4">mena dɔɔ weenɛɛ da gyoo na ɔ bee nyiŋ kolo ya.<verse eid="PRO 20:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5" />Walaŋ nyeeman kebake yɛɛ ŋgba lee nɛ,</para>
  <para style="q2" vid="PRO 20:5">mɔna ŋon ɔ gyeŋ nombia man waa tale wɔŋ ke lee ke man.<verse eid="PRO 20:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6" />Balaŋ burum ne yɛɛ ŋgba be dana kegyae keŋ taŋ ɔto ya,</para>
  <para style="q2" vid="PRO 20:6">mɔna amɔte ne gyaela waa nyiŋ walaŋ anokoarete?<verse eid="PRO 20:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7" />Baŋ ba tenɛɛ nɛ nombiikum be doo ba kekyaabii man ya,</para>
  <para style="q2" vid="PRO 20:7">be wɔle na be bia baa yɛɛ nyeebam.<verse eid="PRO 20:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8" />Gyoo de kyaa ɔ gyoorogbeli dɔɔ waa di nombia nɛ,</para>
  <para style="q2" vid="PRO 20:8">ɔ na gyoo nombia ŋan pou man kɛɛ.<verse eid="PRO 20:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9" />Amɔte ne gyaela waa tale yako nyi, &lt;&lt;Me konɔɔ man dei,</para>
  <para style="q2" vid="PRO 20:9">ma te gberaa ma wose lee dukum pou man&gt;&gt;?<verse eid="PRO 20:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10" />Sikeli na temkuruwaa keŋ bɛɛ mo ŋere walaŋ do nɛ,</para>
  <para style="q2" vid="PRO 20:10">Degbeŋgyoo ne kɔla ŋe popou.<verse eid="PRO 20:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11" />Bia buruburu gba ba abɔɔ ayɛɛsa te bɛɛ mo naa be dinɔɔ,</para>
  <para style="q2" vid="PRO 20:11">nyi be dinɔɔ ŋenaŋ dei te ŋa tenɛɛ.<verse eid="PRO 20:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12" />Deŋela ŋan ne nyii na sia ŋan ne naa,</para>
  <para style="q2" vid="PRO 20:12">Degbeŋgyoo yɛɛna ŋa ala pou.<verse eid="PRO 20:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13" />Na gyae dosoroŋ ya, na mena ya nyaŋ ke di diyem,</para>
  <para style="q2" vid="PRO 20:13">na doo ya na n ke nyiŋ weenɛɛ burum.<verse eid="PRO 20:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14" />Abɔɔ lɛɛre ne yako nyiaa, &lt;&lt;Be dei ya, be dei ya,</para>
  <para style="q2" vid="PRO 20:14">nyi ɔ lam na ɔ ne kɛlɛɛ ɔ wose nyi ɔ te nyiŋ ke kafo.<verse eid="PRO 20:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15" />Kɔba yayam doo te kegyaŋase kpaakpaa nyiŋan boe burum,</para>
  <para style="q2" vid="PRO 20:15">mɔna nɔɔ keŋ ne kolosi nombia kagyeŋ nombia dei kela kegyaŋase kpaakpaa nyiŋan.<verse eid="PRO 20:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16" />Mo ŋon ɔ ba sem ŋɔɔle ŋolo kom nawɔɔ man kegba,</para>
  <para style="q2" vid="PRO 20:16">na n ka mo ke see kom keŋ nae.<verse eid="PRO 20:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17" />Weenɛɛ ŋan bɛɛ mo gbɛɛkum man nyiŋ dana gyoŋ,</para>
  <para style="q2" vid="PRO 20:17">mɔna kenaŋ wɔle na gyae ka bese aŋasa n nɔɔman.<verse eid="PRO 20:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18" />N nyii kekolosifa na n nyeeman kebake na sem,</para>
  <para style="q2" vid="PRO 20:18">nyi n ne gyu yoo na gyae gbɛɛ kawola.<verse eid="PRO 20:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19" />Kelabere ketao na lese nombia aweeseŋ debɔɔ,</para>
  <para style="q2" vid="PRO 20:19">mena dɔɔ wɔŋ n wose lee nkpee wose man.<verse eid="PRO 20:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20" />Nyi ŋolo de falaa ɔ kya yaa ɔ naa nɛ,</para>
  <para style="q2" vid="PRO 20:20">ɔ kanea gyae ka yeŋ detiŋtɛɛ tuum man.<verse eid="PRO 20:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21" />Dedii keŋ n peree nyiŋ ke bileŋ nɛ,</para>
  <para style="q2" vid="PRO 20:21">nhira be gyae ke doo ke man ɔtoman ya.<verse eid="PRO 20:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22" />Na yako nyi, &lt;&lt;Maa tɔ neŋ dukum kei kom,&gt;&gt; ya.</para>
  <para style="q2" vid="PRO 20:22">Daa Degbeŋgyoo, ŋon ne gyaela waa yoo fa neŋ.<verse eid="PRO 20:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23" />Degbeŋgyoo ne kɔla sikeli keŋ bɛɛ mo ŋere walaŋ do,</para>
  <para style="q2" vid="PRO 20:23">temkuruwaa keŋ bɛɛ mo ŋere walaŋ do bɛɛ gyoo ɔ sia ya.<verse eid="PRO 20:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24" />Degbeŋgyoo na wolana walaŋ nawɔɔ kekulu,</para>
  <para style="q2" vid="PRO 20:24">sena te ŋolo waa tale nyii ŋon gbagba gbɛɛneŋ man?<verse eid="PRO 20:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25" />Na barase sɛɛ kom pɛna n kaa gyueŋ ke man ya,</para>
  <para style="q2" vid="PRO 20:25">na mena ya na n te nyɔɔ n wose kɔta.<verse eid="PRO 20:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26" />Gyoo nyansate na lese akpanyanyaŋtena see yenaŋ,</para>
  <para style="q2" vid="PRO 20:26">te ɔ ne wɔŋ be deŋele nideli.<verse eid="PRO 20:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27" />Deniwalaŋ weesɛɛ yɛna Degbeŋgyoo kanea,</para>
  <para style="q2" vid="PRO 20:27">kɛɛ ŋmaŋee gyoo walaŋ wose man nideli.<verse eid="PRO 20:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28" />Kegyae keŋ taŋ ɔto ya na anokoare kedi ne gyee gyoo,</para>
  <para style="q2" vid="PRO 20:28">kegyae keŋ taŋ ɔto ya ne yele ɔ gyoorogbeli na sem nideli.<verse eid="PRO 20:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29" />Tewulɛɛ gyoorobiiri yɛna be doŋ,</para>
  <para style="q2" vid="PRO 20:29">te akpegyiina gyoorobiiri yɛna ba nyee kawolose.<verse eid="PRO 20:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30" />Ketuku kɛrɛɛ gyamɛɛ na lese dukum,</para>
  <para style="q2" vid="PRO 20:30">te ketuku da gyoo walaŋ wose man nideli na ne desina e.<verse eid="PRO 20:30" /></para>
  <para style="b" />
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1" />Gyoo konɔɔ doo Degbeŋgyoo nyiŋmaa man ŋgba boo nɛ,</para>
  <para style="q2" vid="PRO 21:1">botɔɔ keŋ ɔ ne gyae na te ɔ ne yele kɛɛ lam.<verse eid="PRO 21:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2" />Walaŋ ne kɛɛ nyi ɔ gbɛɛneŋ pou tenɛɛ fa e,</para>
  <para style="q2" vid="PRO 21:2">mɔna Degbeŋgyoo na gyoona konɔɔse man kɛɛ.<verse eid="PRO 21:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3" />N ke yɛɛ keŋ tenɛɛ na keŋ doo ke gbɛɛ dɔɔ,</para>
  <para style="q2" vid="PRO 21:3">na gyoo Degbeŋgyoo sia kela kedeesa.<verse eid="PRO 21:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4" />Wose kegate na agaŋtaŋ,</para>
  <para style="q2" vid="PRO 21:4">yɛna akpanyanyaŋtena awulaa, ke yɛɛ dukum ke.<verse eid="PRO 21:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5" />Kakyeŋ doore nyeeman kebake na mo tɔnɔɔ kɔŋ,</para>
  <para style="q2" vid="PRO 21:5">mɔna wose kaperee yɛɛ kolo na mo diyem kɔŋ.<verse eid="PRO 21:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6" />Wose kenyiŋ lee dekara kedi man,</para>
  <para style="q2" vid="PRO 21:6">yɛɛ ogyefeliŋ na yeŋ kegyae ke.<verse eid="PRO 21:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7" />Akpanyanyaŋtena nombiakumɛɛ ne wɔlɛɛna wɔ,</para>
  <para style="q2" vid="PRO 21:7">nawolo nyi ba te bɛɛ keŋ doona kegbɛɛ keyɛɛ.<verse eid="PRO 21:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8" />Dukumyɛɛre gbɛɛneŋ ba tenɛɛ ya,</para>
  <para style="q2" vid="PRO 21:8">mɔna ŋon ɔ nombia dei gbɛɛneŋ tenɛɛ.<verse eid="PRO 21:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9" />Debɔɔlɔɔ man kekyaa nyaageŋ dei,</para>
  <para style="q2" vid="PRO 21:9">kela ɛmɛɛ na alo kale gyaere ke kyaa dekpaŋalaŋ man.<verse eid="PRO 21:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10" />Nombia kumɛɛ ne gyɔ akpanyanyaŋtena loo,</para>
  <para style="q2" vid="PRO 21:10">bɔɔ ne wii be tebia waraŋase ya.<verse eid="PRO 21:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11" />Nyi be wɔŋ ŋon ɔ ne kulu balaŋ deŋele nɛ, ŋon ɔ ba gyeŋ daale ya na gyeŋ nyansa,</para>
  <para style="q2" vid="PRO 21:11">nyi be tei siakaralatena na bɛɛ gyeŋ nombia.<verse eid="PRO 21:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12" />Ŋon ɔ tenɛɛ nɛ na gyene akpanyanyaŋte dekpaŋalaŋ,</para>
  <para style="q2" vid="PRO 21:12">te ɔ na mo akpanyanyaŋte do kewɔlɛɛ man.<verse eid="PRO 21:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13" />Ɔkamasɛ ŋon ɔ tɔ ɔ deŋela nyi ɔ bee nyii ayematena kewii ya nɛ,</para>
  <para style="q2" vid="PRO 21:13">ŋon mɔ waa wii keŋ ŋolo be nyii e ya.<verse eid="PRO 21:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14" />Kolo kefa weese ne yɔkɔse baŋ,</para>
  <para style="q2" vid="PRO 21:14">te kolo kayofa keŋ bɔɔ mo kanyaŋ milii ke ne fɛɛ baŋkum.<verse eid="PRO 21:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15" />Nombia kedi kegbɛɛ dɔɔ ne yele ŋon ɔ tenɛɛ ne nyaŋee,</para>
  <para style="q2" vid="PRO 21:15">mɔna ne yele nombiakumɛɛ yɛɛra ne ŋeŋii.<verse eid="PRO 21:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16" />Ɔkamasɛ ŋon ɔ kpase lee nyansa gbɛɛ man nɛ,</para>
  <para style="q2" vid="PRO 21:16">waa kaa kpuna woyadɛɛ.<verse eid="PRO 21:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17" />Ɔkamasɛ ŋon ɔ ne gyae nɔɔkedi nɛ waa bese diyemte,</para>
  <para style="q2" vid="PRO 21:17">ɔkamasɛ ŋon ɔ ne gyae waen na lafenta koyadoŋte be gyae waa nyiŋ kɔba korakora ya.<verse eid="PRO 21:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18" />Baa mo akpanyanyaŋte tɔ ŋon ɔ tenɛɛ nɛ nyeeman kom,</para>
  <para style="q2" vid="PRO 21:18">te ŋon ɔ bee di anokoare ya nɛ fa ŋon ɔ gbɛɛneŋ tenɛɛ.<verse eid="PRO 21:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19" />Depampaa man kekyaa nyaageŋ dei,</para>
  <para style="q2" vid="PRO 21:19">kela alo kale gyaere na katoroŋte gyaŋ ke kyaa.<verse eid="PRO 21:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20" />Siakaralate ne yilaa weenɛɛ kpaakpaa na oliifi nuŋ see,</para>
  <para style="q2" vid="PRO 21:20">mɔna ayiŋtena ne di be wui pou munu.<verse eid="PRO 21:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21" />Ɔkamasɛ ŋon ɔ silana katenee na kegyae nɛ,</para>
  <para style="q2" vid="PRO 21:21">waa nyiŋ nyeedoŋ na kede na obuo.<verse eid="PRO 21:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22" />Siakaralate waa tale gyeŋ gyu ka seŋ tia doŋtena donɔɔ dinaa,</para>
  <para style="q2" vid="PRO 21:22">na ɔ te tekeri dekyaŋ keŋ bɔɔ mo ba wose lɔ ke dɔɔ nɛ lɔ.<verse eid="PRO 21:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23" />Ŋon ɔ na do ɔ nɔɔ na ɔ laakem dokɔŋ nɛ,</para>
  <para style="q2" vid="PRO 21:23">na lese ɔ wose lee nombiikum man.<verse eid="PRO 21:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24" />Agaŋtaŋte na ŋon ɔ ne gate ɔ wose nɛ yele yɛna Kulure,</para>
  <para style="q2" vid="PRO 21:24">ɔ ne yɛɛ wa abɔɔ bo konɔɔyuŋ man.<verse eid="PRO 21:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25" />Keŋ ne gyɔ kebɔŋalete loo ne gyaela ka mo e gyu yeŋ man,</para>
  <para style="q2" vid="PRO 21:25">nawolo nyi ɔ nyiŋmaase te bɛɛ tom keyɛɛ.<verse eid="PRO 21:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26" />Ɔ ne yase sia gyae burum debaŋ kamasɛ,</para>
  <para style="q2" vid="PRO 21:26">mɔna ŋon ɔ tenɛɛ ne faa lee ɔ konɔɔ man.<verse eid="PRO 21:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27" />Akpanyanyaŋte kedeesa yɛɛ kolo anekɔlaŋ ke,</para>
  <para style="q2" vid="PRO 21:27">kaa yela nyi waa mo Nyeempɔkum mo ke kɔŋ.<verse eid="PRO 21:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28" />Dekara adansɛɛdiiri waa munu,</para>
  <para style="q2" vid="PRO 21:28">mɔna ŋon ɔ ne tei nideli waa yako ke kegbɛɛ dɔɔ.<verse eid="PRO 21:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29" />Akpanyanyaŋte na beo booli ɔ sia,</para>
  <para style="q2" vid="PRO 21:29">mɔna ŋon ɔ gbɛɛneŋ tenɛɛ ne kɛɛ ɔ ketabii man.<verse eid="PRO 21:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30" />Nyansa na nombia man kenyii na nyeeman kebake daale be kyaa,</para>
  <para style="q2" vid="PRO 21:30">keŋ gyae ke tale seŋ Degbeŋgyoo siaman ya.<verse eid="PRO 21:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31" />Bee desina dɛɛkyɔŋ see fa yoo wee,</para>
  <para style="q2" vid="PRO 21:31">mɔna keyoodi na lee bo Degbeŋgyoo gyaŋ.<verse eid="PRO 21:31" /></para>
  <para style="b" />
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1" />Yele kpaakpaa dei kela wose kenyiŋ,</para>
  <para style="q2" vid="PRO 22:1">obuo dei kela kɔba wolom yaa kɔba yayam.<verse eid="PRO 22:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2" />Kolo dokoloŋ doola fa ŋon ɔ be nyiŋ ɔ wose na diyemte,</para>
  <para style="q2" vid="PRO 22:2">Degbeŋgyoo yɛɛna be popou.<verse eid="PRO 22:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3" />Siakaralate ne naa kayeyɛɛ keŋ ne kɔŋ na ɔ te yeu ka yo,</para>
  <para style="q2" vid="PRO 22:3">mɔna ŋon ɔ ba gyeŋ daale ya ne tɛɛ bo kagyoo ke man na ɔ te nyiŋ deŋele kewɔŋ.<verse eid="PRO 22:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4" />Wose keyɔkɔse yɛna Degbeŋgyoo keyee,</para>
  <para style="q2" vid="PRO 22:4">ka kom ketɔ yɛna wosekenyiŋ na obuo na nyeedoŋ.<verse eid="PRO 22:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5" />Kɔtase na sɔɔse doo akpanyaŋnyaŋte gbɛɛneŋ man,</para>
  <para style="q2" vid="PRO 22:5">mɔna ŋon ɔ ne gyee ɔ nyee ne wɔŋ ɔ wose lee ŋe gyaŋ gyu lemlem.<verse eid="PRO 22:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6" />Wola biikyaa gbɛɛ kpaakpaa keŋ waa mo kyaa,</para>
  <para style="q2" vid="PRO 22:6">akpaa ɔ bee na ɔ ba lee ke dɔɔ ya.<verse eid="PRO 22:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7" />Ŋon ɔ be nyiŋ ɔ wose ne di diyemte dɔɔ,</para>
  <para style="q2" vid="PRO 22:7">te ŋon ɔ ne paa kɔba nɛ yɛɛ gbeŋi fa ŋon ɔ be paa e nɛ.<verse eid="PRO 22:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8" />Ɔkamasɛ ŋon ɔ duu nombia ketulii kegbɛɛ dɔɔ ne kara kayeyɛɛ bo,</para>
  <para style="q2" vid="PRO 22:8">te ɔ baŋ gbutu gyae ke tekeri<verse eid="PRO 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9" />Baa hiraa ŋon ɔ ne gyae deeli keyɛɛ,</para>
  <para style="q2" vid="PRO 22:9">nawolo nyi ɔ ne kpɛlɛɛ ɔ weenɛɛ fa ayematena.<verse eid="PRO 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10" />Gegi ŋon ɔ ne kulu balaŋ na yoo ke fɛɛ,</para>
  <para style="q2" vid="PRO 22:10">na kale na tuubia ke taŋ.<verse eid="PRO 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11" />Ŋon ɔ ne gyae konɔɔ kpaakpaa te ɔ ne kekolosi bɛrɛɛ man nɛ,</para>
  <para style="q2" vid="PRO 22:11">gyoo waa mo e dɔɔre.<verse eid="PRO 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12" />Degbeŋgyoo sia gyakaa nombia kagyeŋ dɔɔ,</para>
  <para style="q2" vid="PRO 22:12">mɔna ɔ ne bɛɛ ŋon ɔ bee di anokoare ya nɛ nɔɔwoya.<verse eid="PRO 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13" />Kebɔŋalete ne yakola nyi &lt;&lt;Dinaate kyaa debɔɔman.</para>
  <para style="q2" vid="PRO 22:13">Waa ko maŋ gbɛɛnaa man.&gt;&gt;<verse eid="PRO 22:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14" />Alo ŋon ɔ na mo ayimɛɛ wuu ɔ wose nɔɔ yɛɛ bɔɔ kyilimkyilim ke,</para>
  <para style="q2" vid="PRO 22:14">baale ŋon Degbeŋgyoo baŋ gyakaa ɔ dɔɔ waa yala gyoo ke man.<verse eid="PRO 22:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15" />Diyiŋ nombia te milii biikyaa konɔɔ,</para>
  <para style="q2" vid="PRO 22:15">katenee dambila te bɛɛ mo booli ke.<verse eid="PRO 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16" />Ŋon ɔ na ŋere diyemte do na waa mo nyiŋ agyapadɛɛse,</para>
  <para style="q2" vid="PRO 22:16">na ŋon ɔ ne fa ŋon ɔ be nyiŋ ɔ wose abɔɔ nɛ, be popou na bese ayematena bo.<verse eid="PRO 22:16" /></para>
  <para style="ms1">Siakekara Nombia Saonakufu (30) Ayakoŋ.</para>
  <para style="s2">Keyako 1</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17" />See deŋele na n ke tei siakekara nombia,</para>
  <para style="q2" vid="PRO 22:17">gyueŋ me kawola man nideli.<verse eid="PRO 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18" />Kaboena nyi nya mo ŋa do n konɔɔ man,</para>
  <para style="q2" vid="PRO 22:18">na n ke tɔɔse ŋe popou n nɔɔwoya man.<verse eid="PRO 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19" />Keŋ n ka mo n wose lɔ Degbeŋgyoo dɔɔ,</para>
  <para style="q2" vid="PRO 22:19">dɔɔ te mɛɛ wola nyaŋ gbagba ŋa gyɛŋ.<verse eid="PRO 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20" />Ma te ŋmarase nombia saonakufu fa neŋ,</para>
  <para style="q2" vid="PRO 22:20">keŋ kekolosifa na nombia kagyeŋ doo ŋe man.<verse eid="PRO 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21" />Me ta wola neŋ nyi nya di anokoare na n ke kolosi anokoare,</para>
  <para style="q2" vid="PRO 22:21">na n ka mo anokoare nɔɔketira</para>
  <para style="q2" vid="PRO 22:21">gyina baŋ bɔɔ kpila neŋ nɛ yee?<verse eid="PRO 22:21" /></para>
  <para style="s2">Keyako 2</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22" />Na wurutii diyemte nyi keŋ ɔ yɛɛ diyemte e dɔɔ ya,</para>
  <para style="q2" vid="PRO 22:22">te na ŋere ŋon ɔ be dana kolo ya nɛ do nombia dedii man ya,<verse eid="PRO 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23" />nawolo nyi Degbeŋgyoo waa di be nombia fa wɔ,</para>
  <para style="q2" vid="PRO 22:23">na waa yɛɛ neŋ keŋ n be yɛɛ wɔ nɛ tɔ kom.<verse eid="PRO 22:23" /></para>
  <para style="s2">Keyako 3</para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24" />Na mo ŋon ɔ be dana konɔɔ ya nɛ dɔɔre ya,</para>
  <para style="q2" vid="PRO 22:24">te na mo n wose dona ŋon ɔ na gyeŋ baŋ bileŋbileŋ nɛ ya,<verse eid="PRO 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25" />na mena ya n ke kasee be gbɛɛneŋ,</para>
  <para style="q2" vid="PRO 22:25">na n ka mo n wose do kɔta man.<verse eid="PRO 22:25" /></para>
  <para style="s2">Keyako 4</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26" />Na sem ŋolo kom nawɔɔ man,</para>
  <para style="q2" vid="PRO 22:26">yaa n ka mo kolo see kom keŋ nae ya.<verse eid="PRO 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27" />Akpaa n te nyiŋ kolo tɔ kom keŋ ya na,</para>
  <para style="q2" vid="PRO 22:27">baa lɛo n dofoŋoŋ keŋ dɔɔ n doo nɛ gba.<verse eid="PRO 22:27" /></para>
  <para style="s2">Keyako 5</para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28" />Na kyɛɛkee wulu bene,</para>
  <para style="q2" vid="PRO 22:28">keŋ n naanaɔ ba doo nɛ ya.<verse eid="PRO 22:28" /></para>
  <para style="s2">Keyako 6</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29" />N ne naa nyiŋmaa man tomyɛɛre ŋon ɔ gyeŋ ɔ tom keyɛɛ nideli?</para>
  <para style="q2" vid="PRO 22:29">Waa som gyooneŋ,</para>
  <para style="q2" vid="PRO 22:29">ɔ be gyae waa som balaŋ baŋ bɔɔ dana dedii ya.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="s2">Keyako 7</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1" />Akpaa n kyaa nyi ɛmɛɛ na kegyia ŋolo ke di nɛ,</para>
  <para style="q2" vid="PRO 23:1">gyene kpene keŋ doo n siaman nɛ nideli,<verse eid="PRO 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2" />akpaa n yɛɛ diiri e na,</para>
  <para style="q2" vid="PRO 23:2">kyaŋ n wose.<verse eid="PRO 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3" />Na ŋmaa ɔ weenɛɛ gyoŋ nyiŋan ŋan ya,</para>
  <para style="q2" vid="PRO 23:3">nawolo nyi weenɛɛ ŋenaŋ na beo balaŋ.<verse eid="PRO 23:3" /></para>
  <para style="s2">Keyako 8</para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4" />Na naase n wose diyem nyi n ke nyiŋ n wose ya,</para>
  <para style="q2" vid="PRO 23:4">yela n sia kekrara na n ke tina mena dinɔɔ kenaŋ yela.<verse eid="PRO 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5" />N kaa gyɔ sibii naa na, ka te ŋaalaa,</para>
  <para style="q2" vid="PRO 23:5">nawolo nyi ke gyae ke tu beŋkelɛɛ,</para>
  <para style="q2" vid="PRO 23:5">furufu laŋ adido karatetee ŋgba otoloku nɛ.<verse eid="PRO 23:5" /></para>
  <para style="s2">Keyako 9</para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6" />Nkyekyete de baake neŋ nɛ na di ɔ weenɛɛ beiŋ ya,</para>
  <para style="q2" vid="PRO 23:6">na ŋmaa ɔ weenɛɛ gyoŋ nyiŋan ŋan ya.<verse eid="PRO 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7" />nawolo ɔ yɛɛ walaŋ ŋon nyi,</para>
  <para style="q2" vid="PRO 23:7">debaŋ kamasɛ na ɔ na gyueŋ ŋa koya,</para>
  <para style="q1" vid="PRO 23:7">waa beo yako neŋ nyi, &lt;&lt;Di na n ke nyɔɔ,&gt;&gt;</para>
  <para style="q2" vid="PRO 23:7">mɔna ta lee ɔ konɔɔ man ya.<verse eid="PRO 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8" />N ke tɔe kyomii keŋ n be dii nɛ,</para>
  <para style="q2" vid="PRO 23:8">na n te kɛlɛɛ e yakaa.<verse eid="PRO 23:8" /></para>
  <para style="s2">Keyako 10</para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9" />Na kolosi fa ayiŋtena ya,</para>
  <para style="q2" vid="PRO 23:9">nawolo nyi bɔɔ gyae baa lɛɛ n nombia kpaakpaa ŋan do ya.<verse eid="PRO 23:9" /></para>
  <para style="s2">Keyako 11</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10" />Na kyɛɛkee wulu bene,</para>
  <para style="q2" vid="PRO 23:10">yaa n ke lɛo yoyolobiise tɛɛlese ya.<verse eid="PRO 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11" />Nawolo nyi Wurubuarɛ ŋon ɔ seŋɛɛ be wɔle nɛ dana doŋ,</para>
  <para style="q2" vid="PRO 23:11">ŋon ne gyaela waa di be nombia fa wɔ.<verse eid="PRO 23:11" /></para>
  <para style="s2">Keyako 12</para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12" />Mo n konɔɔ sila kawola,</para>
  <para style="q2" vid="PRO 23:12">na n ke tei nombia kagyeŋ.<verse eid="PRO 23:12" /></para>
  <para style="s2">Keyako kufu atoorote</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13" />Na bɛɛ biikyaa katenee ya,</para>
  <para style="q2" vid="PRO 23:13">n mo dambila tuku e na, ɔ be gyae waa yeŋ ya.<verse eid="PRO 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14" />Mo dambila tuku e,</para>
  <para style="q2" vid="PRO 23:14">na n ke lɛɛ e lee yeŋ man.<verse eid="PRO 23:14" /></para>
  <para style="s2">Keyako 14</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15" />Me bu, nyi n sia de kare n konɔɔ man nɛ,</para>
  <para style="q2" vid="PRO 23:15">kenaŋ na me konɔɔ gyae ke fɛɛ maŋ nideli,<verse eid="PRO 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16" />Akpaa n kolosi keŋ tenɛɛ nɛ,</para>
  <para style="q2" vid="PRO 23:16">kenaŋ na ma woo waa nyaŋee.<verse eid="PRO 23:16" /></para>
  <para style="s2">15</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17" />Na yoo dukumyɛɛra nuŋkurili ya,</para>
  <para style="q2" vid="PRO 23:17">mɔna yee Degbeŋgyoo debaŋ kamasɛ.<verse eid="PRO 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18" />De yɛɛ senaa lookegyakaa doo fa neŋ wee daale,</para>
  <para style="q2" vid="PRO 23:18">te n lookegyakaa kenaŋ be gyae ke yɛɛ yakaa ya.<verse eid="PRO 23:18" /></para>
  <para style="s2">Keyako 16</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19" />Me bu, tei na n sia ke kara,</para>
  <para style="q2" vid="PRO 23:19">na n ka mo n konɔɔ sila detɛe keŋ tenɛɛ.<verse eid="PRO 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20" />Na mo n wose dona soloŋ nyɔɔra,</para>
  <para style="q2" vid="PRO 23:20">yaa kedikumtena ya,<verse eid="PRO 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21" />nawolo nyi soloŋ nyɔɔra na kedikumtena baa bese ayematena,</para>
  <para style="q2" vid="PRO 23:21">te kedi na kedoo gyae ka mo kakyeŋgbelaase wuu neŋ.<verse eid="PRO 23:21" /></para>
  <para style="s2">Keyako 17</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22" />Tei n kya ŋon ɔ ba lola neŋ,</para>
  <para style="q2" vid="PRO 23:22">te na lese n sia lee n naa dɔɔ ɔ degbanyaaretɛɛ ya.<verse eid="PRO 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23" />Lɛɛ anokoare te na yɔɔ ke ya,</para>
  <para style="q2" vid="PRO 23:23">lɛɛ nyansa na kawola na nombia man kagyeŋ mɔ.<verse eid="PRO 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24" />Kya ŋon ɔ bu gbɛɛneŋ tenɛɛ waa nyaŋee nideli,</para>
  <para style="q2" vid="PRO 23:24">kya ŋon ɔ bu sia be kare waa nyaŋee lee ɔ bu ŋonaŋ dɔɔ.<verse eid="PRO 23:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25" />Yela n kya na n naa ke nyaŋee,</para>
  <para style="q2" vid="PRO 23:25">yela n naa ŋon ɔ ba lola neŋ nyee ka koro e.<verse eid="PRO 23:25" /></para>
  <para style="s2">Keyako kufu gyanaarate</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26" />Me bu, mo nya nyeempɔ fa maŋ,</para>
  <para style="q2" vid="PRO 23:26">na n ke yela me gbɛɛneŋ ka gyoo n sia,<verse eid="PRO 23:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27" />nawolo nyi alo ŋon ɔ na mo ayimɛɛ wuu ɔ wose yɛɛ bɔɔ kyilimkyilim ke,</para>
  <para style="q2" vid="PRO 23:27">te alo ohuhoo yɛɛ bɔɔ bɔbɔkyee ke.<verse eid="PRO 23:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28" />Ɔ ne daa ŋgba ŋmɛɛlate nɛ,</para>
  <para style="q2" vid="PRO 23:28">te ɔ ne yele baala baŋ bɔɔ ne di anokoare ya ne wuku.<verse eid="PRO 23:28" /></para>
  <para style="s2">Keyako 19</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29" />Amɔte doola kaale maŋ? Amɔte ne nyiina weeleŋ?</para>
  <para style="q2" vid="PRO 23:29">Amɔte ne gyaena kale? Amɔte na toroŋla?</para>
  <para style="q2" vid="PRO 23:29">Amɔte ne lɛɛna gyamɛɛ yakaa? Amɔte sia yasela?<verse eid="PRO 23:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30" />Baŋ bɛɛ nyɔɔ waen beiŋ nɛ,</para>
  <para style="q2" vid="PRO 23:30">baŋ bɛɛ gyae waen keŋ bɔɔ kyakale kedakee kɛɛ nɛ.<verse eid="PRO 23:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31" />Na yele waen keŋ yasɛɛ,</para>
  <para style="q2" vid="PRO 23:31">te kee fiu kebia man,</para>
  <para style="q2" vid="PRO 23:31">te ne gyɔ neŋ loo nɛ ka beo neŋ ya.<verse eid="PRO 23:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32" />Ɔtoman na kɛɛ kyom ŋgba dom nɛ,</para>
  <para style="q2" vid="PRO 23:32">ke dana teekum ŋgba dom duguŋte nɛ.<verse eid="PRO 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33" />N kena gyakoloŋ nombia n sia dɔɔ,</para>
  <para style="q2" vid="PRO 23:33">te nyaŋ ke kolosi nombia ŋan taŋ nyee ya.<verse eid="PRO 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34" />Nyaŋ ke yɛɛ ŋgba ŋon ɔ doo degbele dinaa man ɛpo dɔɔ,</para>
  <para style="q2" vid="PRO 23:34">keŋ feliŋ dinaa ne gyɔ ke gyu gyɔ ke kɔŋ nɛ.<verse eid="PRO 23:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35" />N ke yako nyiaa, &lt;&lt;Ba ŋmera maŋ mɔna ma te gooli ya.</para>
  <para style="q2" vid="PRO 23:35">Be tuku maŋ, mɔna ta wee maŋ ya.</para>
  <para style="q1" vid="PRO 23:35">Debaŋ woŋti yaa maa foŋ,</para>
  <para style="q2" vid="PRO 23:35">na maa bese nyiŋ soloŋ daale nyɔɔ bela?&gt;&gt;<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="s2">Keyako 20</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1" />Na yoo akpanyaŋnyaŋte nuŋkurili ya,</para>
  <para style="q2" vid="PRO 24:1">te na lese e dɔɔre ya.<verse eid="PRO 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2" />nawolo nyi bɛɛ bake nombiakumɛɛ ba nyeempɔ man,</para>
  <para style="q2" vid="PRO 24:2">te be nɔɔwoya ne loo nombia kɔŋ.<verse eid="PRO 24:2" /></para>
  <para style="s2">Keyako 21</para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3" />Nyansa te bɛɛ mo ma deni,</para>
  <para style="q2" vid="PRO 24:3">te nombia man kenyii ne yelela kɛɛ sem.<verse eid="PRO 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4" />Nombia kagyeŋ ne yelela ɔ ne nyiŋ,</para>
  <para style="q2" vid="PRO 24:4">abɔɔ ŋan na lee koya te ŋɛɛ gyoo sia nɛ wulu denɛɛ.<verse eid="PRO 24:4" /></para>
  <para style="s2">Keyako 22</para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5" />Siakaralate dana doŋ nideli,</para>
  <para style="q2" vid="PRO 24:5">te ŋon ɔ gyeŋ nombia na lese ɔ doŋ wola.<verse eid="PRO 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6" />Kaboena nyi nya nyiŋ gbɛɛ kawola pɛ n ke gyu yoo,</para>
  <para style="q2" vid="PRO 24:6">te balaŋ burum kekolosifa ne fa keyoodi.<verse eid="PRO 24:6" /></para>
  <para style="s2">Keyako 23</para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7" />Nyansa korɛɛ nideli fa ayiŋtena,</para>
  <para style="q2" vid="PRO 24:7">bɔɔ ne gyuusu be nɔɔ balaŋ deyilae donɔɔ keŋ denaanɔɔ man ya.<verse eid="PRO 24:7" /></para>
  <para style="s2">Keyako 24</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8" />Ɔkamasɛ ŋon ɔ ne bake nombiakumɛɛ nɛ,</para>
  <para style="q2" vid="PRO 24:8">baa baake nyi tɛɛle yɛlɛɛre.<verse eid="PRO 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9" />Diyiŋte nyeeman kebake yɛɛ dukum,</para>
  <para style="q2" vid="PRO 24:9">te balaŋ ne kɔla ŋon ɔ ne kulu balaŋ.<verse eid="PRO 24:9" /></para>
  <para style="s2">Keyako 25</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10" />Nyi n wose de tekerii neŋ wose kekyaŋ man nɛ,</para>
  <para style="q2" vid="PRO 24:10">na n doŋ yɛɛ peperee.<verse eid="PRO 24:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11" />Lɛɛ baŋ bee gyu be kaa ko wɔ nɛ,</para>
  <para style="q2" vid="PRO 24:11">lɛo baŋ bee seree nyi bee gyu be kaa kara ba nyee nɛ.<verse eid="PRO 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12" />Akpaa n yako nyi, &lt;&lt;Kɛɛ, daa ba gyeŋ ke man daale ya nɛ,&gt;&gt;</para>
  <para style="q2" vid="PRO 24:12">Ŋon ɔ na gyoo konɔɔse man kɛɛ nɛ ba gyeŋ yee?</para>
  <para style="q1" vid="PRO 24:12">Ŋon ɔ ne gyee n woo nɛ ba gyeŋ yee?</para>
  <para style="q2" vid="PRO 24:12">Ɔ be gyae waa tɔ walaŋ kamasɛ kom ŋgba mena keŋ ɔ be yɛɛ ɔ tom nɛ yee?<verse eid="PRO 24:12" /></para>
  <para style="s2">Keyako 26</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13" />Me bu di teebɔɔ, nawolo nyi ke dei,</para>
  <para style="q2" vid="PRO 24:13">teebɔɔ keŋ ne kyɔsee lee afaŋalaŋ man nɛ dana neŋ gyoŋ.<verse eid="PRO 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14" />Gyeŋ mɔ nyiaa nyansa yɛɛ ŋgba teebɔɔ nɛ fa n woo.</para>
  <para style="q2" vid="PRO 24:14">Akpaa n nyiŋ ke na, n dana lookegyakaa wee daale,</para>
  <para style="q2" vid="PRO 24:14">te n lookegyakaa be gyae ke yɛɛ yakaa ya.</para>
  <para style="q2" vid="PRO 24:14">Keyako 27<verse eid="PRO 24:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15" />Na deke ŋon ɔ tenɛɛ dekpaŋalaŋ ŋgba akpanyanyaŋte nɛ,</para>
  <para style="q2" vid="PRO 24:15">na n kaa kuu wa abɔɔ ɔ dekpaŋalaŋ man ya.<verse eid="PRO 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16" />Nawolo nyi ŋon ɔ tenɛɛ de yale betabo nyetooro na waa koro bela,</para>
  <para style="q2" vid="PRO 24:16">mɔna kayeyɛɛ da mo akpanyanyaŋte lɔ na ɔ te yale kekpaa.<verse eid="PRO 24:16" /></para>
  <para style="s2">28</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17" />Nyi n kɔlare de yale nɛ, na yele ke yɛɛ neŋ gyoŋ ya,</para>
  <para style="q2" vid="PRO 24:17">nyi ɔ kpaŋte nɛ, na nyaŋee n konɔɔ man ya.<verse eid="PRO 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18" />Na mena ya Degbeŋgyoo waa naa te be gyae ke yɛɛ e gyoŋ ya,</para>
  <para style="q2" vid="PRO 24:18">na waa lese ɔ baŋ lee ɔ dɔɔ.<verse eid="PRO 24:18" /></para>
  <para style="s2">Keyako 29</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19" />Na naase n wose diyem nombiakumɛɛ yɛɛra dɔɔ,</para>
  <para style="q2" vid="PRO 24:19">yaa n ke yoo akpanyanyaŋte nuŋkurili ya,<verse eid="PRO 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20" />nawolo nyi nombiakumɛɛ yɛɛra be dana lookegyaa fa weedaale ya,</para>
  <para style="q2" vid="PRO 24:20">te akpanyanyaŋte kanea gyae ka yeŋ.<verse eid="PRO 24:20" /></para>
  <para style="s2">Keyako 30</para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21" />Me bu, yee Degbeŋgyoo na gyoo ŋon,</para>
  <para style="q2" vid="PRO 24:21">te na mo n wose dona baŋ bɛɛ seŋ tia wɔ nɛ ya,<verse eid="PRO 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22" />nawolo nyi kewɔlɛɛ gyae ka lee be bala gyaŋ karatetee kɔŋ be dɔɔ,</para>
  <para style="q2" vid="PRO 24:22">te amɔte gyeŋana kayeyɛɛ keŋ gyae ka lee be bala gyaŋ kɔŋ?<verse eid="PRO 24:22" /></para>
  <para style="ms">Siakekara Nombia Ŋaale Bela</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23" />Kɛŋa mɔ yɛɛ siakekara nombia keyako ŋa,</para>
  <para style="q1" vid="PRO 24:23">Walaŋ siaman kekɛɛ nombia kedi man be dei ya.<verse eid="PRO 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24" />Ɔkamasɛ ŋon ɔ yako ŋon ɔ be di fɔɔ nɛ nyi, &lt;&lt;N nombia dei,&gt;&gt; nɛ,</para>
  <para style="q2" vid="PRO 24:24">balaŋ baa falaa e na tɛɛlese balaŋ ke bɛɛ e.<verse eid="PRO 24:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25" />Mɔna gyae ke de fa baŋ bee bu ŋon ɔ nombia be dei ya fɔɔ nɛ,</para>
  <para style="q1" vid="PRO 24:25">na baa nyiŋ kehiraa nideli.<verse eid="PRO 24:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26" />Ŋon ɔ ne yako neŋ anokoare nɛ,</para>
  <para style="q2" vid="PRO 24:26">ŋon ne gyaena neŋ nideli.<verse eid="PRO 24:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27" />Yɛɛ n debɔɔman tomse,</para>
  <para style="q2" vid="PRO 24:27">na n ke fara n wɔɔ,</para>
  <para style="q2" vid="PRO 24:27">kenaŋ wɔle na n ke baŋ n dekpaŋalaŋ.<verse eid="PRO 24:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28" />Na di adansɛɛ tia n dɔɔ yakaa ya,</para>
  <para style="q2" vid="PRO 24:28">te na beo balaŋ ya.<verse eid="PRO 24:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29" />Na yako nyiaa, &lt;&lt;Maa yɛɛ e ŋgba mena keŋ ɔ be yɛɛ maŋ nɛ,</para>
  <para style="q2" vid="PRO 24:29">maa tɔ e keŋ ɔ be yɛɛ maŋ nɛ kom ya.&gt;&gt;<verse eid="PRO 24:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30" />Me tɛɛwɔ kebɔŋalete ŋolo wɔɔ man,</para>
  <para style="q2" vid="PRO 24:30">na diyiŋte ŋolo gerepo wɔɔ man.<verse eid="PRO 24:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31" />Kɛɛ, sɔɔse te lɛɛ wɔɔ keŋ pou,</para>
  <para style="q2" vid="PRO 24:31">te ŋalese wuu tɛɛle keŋ,</para>
  <para style="q2" vid="PRO 24:31">te boya dekyaŋ keŋ yɛlɛɛwɔ.<verse eid="PRO 24:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32" />Keŋte me kɛɛwɔ te ma gyueŋ ke man nideli,</para>
  <para style="q2" vid="PRO 24:32">te me kasee nombia lee keŋ mɔɔ naa nɛ man nyiaa,<verse eid="PRO 24:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33" />Dosoroŋ kyomii, kedeŋeli kyomii,</para>
  <para style="q2" vid="PRO 24:33">nyiŋmaase kamo do yoolaase man fɛɛfo kyomii nɛ,<verse eid="PRO 24:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34" />diyem gyae kaa futaa neŋ ŋgba ŋmɛɛlate nɛ,</para>
  <para style="q2" vid="PRO 24:34">te n wose gyae ke kyaŋ neŋ ŋgba dekpaŋkpasare ŋmɛɛlate ne kuu abɔɔ nɛ.<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="ms">1 Solomɔn Aduya ŋaale Bela</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 25:1" />Kɛŋa yɛna Solomɔn aduya ŋaale bela, ŋan Yuda gyoo Hesekiya balaŋ ba bese ŋmarase nɛ.<verse eid="PRO 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2" />Wurubuarɛ gyoorobiiri yɛna waa weese kolo,</para>
  <para style="q2" vid="PRO 25:2">gyooneŋ gyoorobiiri yɛna baa kɛo kolo man.<verse eid="PRO 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3" />Mena keŋ adido korɛɛ te tɛɛle dana siiliŋ nɛ,</para>
  <para style="q2" vid="PRO 25:3">mena te ŋolo be tale gyeŋ keŋ doo gyooneŋ konɔɔse man ya.<verse eid="PRO 25:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4" />Lese ayimɛɛ lee kɔba wolom man,</para>
  <para style="q2" vid="PRO 25:4">na kɔba wolom luure kenyiŋ kpaakpaate keŋ mo yɛɛ kuruwaase.<verse eid="PRO 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5" />Lese akpanyanyaŋ kegyiise lee gyoo siaman,</para>
  <para style="q2" vid="PRO 25:5">na ɔ gyoori ke kyaa gbeli katenee man.<verse eid="PRO 25:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6" />Na gate n wose gyoo siaman ya,</para>
  <para style="q2" vid="PRO 25:6">te na mo n wose maana ɔ kegyiise baŋ ya.<verse eid="PRO 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7" />Dei nyi waa yako neŋ nyi, &lt;&lt;Gyeŋ kɔŋ kɛbo,&gt;&gt;</para>
  <para style="q2" vid="PRO 25:7">kela waa do neŋ desɛŋ ɔ kegyiise siaman.</para>
  <para style="b" vid="PRO 25:7" />
  <para style="q1" vid="PRO 25:7">Keŋ n be naa na n sia nɛ, <verse eid="PRO 25:7" /><verse number="8" style="v" sid="PRO 25:8" />na barase mo gyu nombia dedii ya,</para>
  <para style="q1" vid="PRO 25:8">nawolo nyi akpaa n dɔɔ da do neŋ desɛŋ ɔto man na,</para>
  <para style="q2" vid="PRO 25:8">sena te n ke yɛɛ?<verse eid="PRO 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9" />Akpaa ɛmɛɛ na n dɔɔ de nyiŋ nombia na ɛ kyaa na ɛ ke desina ya nsana,</para>
  <para style="q2" vid="PRO 25:9">na mena ya ɛ ka lese ɛ nombia aweeseŋ debɔɔ,<verse eid="PRO 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10" />nyi ŋolo de nyii na waa do neŋ desɛŋ,</para>
  <para style="q2" vid="PRO 25:10">na ka te dɔɔ n dɔɔ.<verse eid="PRO 25:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11" />Nombii keŋ be yako ke ka debaŋ man nɛ,</para>
  <para style="q2" vid="PRO 25:11">yɛɛ ŋgba kɔba yayam kolo keŋ bɔɔ mo do kɔba wolom kolo man nɛ.<verse eid="PRO 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12" />Mena keŋ kɔba yayam desomdee yaa kɔba yayam kpaakpaate kolo doo nɛ,</para>
  <para style="q2" vid="PRO 25:12">mena te siakaralate de kalena deŋele keŋ ne nyii dei nɛ doo.<verse eid="PRO 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13" />Mena keŋ loŋ ne fɛɛ dugbututɛɛ nɛ,</para>
  <para style="q2" vid="PRO 25:13">mena te kpilare anokoarete doo ɔ kpilare ŋon gyaŋ,</para>
  <para style="q2" vid="PRO 25:13">ɔ ne fɛɛ ɔ gbeŋgyoo konɔɔ.<verse eid="PRO 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14" />Mena keŋ ŋɔma ne biri na feliŋ te ɔga bɛɛ ŋɛɛ ya nɛ,</para>
  <para style="q2" vid="PRO 25:14">mena te ŋon ɔ na wola ɔ wose nyi waa fa abɔɔ mɔna ɔ bɛɛ faa ya nɛ doo,<verse eid="PRO 25:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15" />Konɔɔ kenyiŋ te bɛɛ mo kyɔlɛɛ gyoo te ɔ ne kyɛɛkee wa nyeempɔ,</para>
  <para style="q2" vid="PRO 25:15">te laakem dawoosa ne tale yɛlɛɛ ŋɔe.<verse eid="PRO 25:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16" />N nyiŋ teebɔɔ nɛ, na di ke beiŋ ya,</para>
  <para style="q2" vid="PRO 25:16">n di ke gbaa n wose na nyaŋ ke tɔe ke.<verse eid="PRO 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17" />Na gyu n dɔɔ dɛɛ agbaatee agbaatee ya,</para>
  <para style="q2" vid="PRO 25:17">n nombia de poro e na waa kɔla neŋ.<verse eid="PRO 25:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18" />Ŋon ɔ ne di adansɛɛkum tia ɔ dɔɔ nɛ,</para>
  <para style="q2" vid="PRO 25:18">yɛɛ ŋgba ɔ moo okpokpo yaa yoosila yaa baŋdaŋ nyeele baa gyu ɔ dɔɔ nɛ.<verse eid="PRO 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19" />Wose ka mo lɔ ŋon ɔ bee di anokoare ya dɔɔ wose kekyaŋ wee nɛ,</para>
  <para style="q2" vid="PRO 25:19">yɛɛ ŋgba keli keŋ be kyakare ka mo tao kolo yaa nae keŋ be siŋii dɔɔ keta nɛ.<verse eid="PRO 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20" />Ŋon ɔ ne kpee nɔɔneŋ fa walaŋ ŋon ɔ ne mutii nɛ,</para>
  <para style="q2" vid="PRO 25:20">yɛɛ ŋgba ŋon ɔ ba kpee abɔɔ waaretɛɛ,</para>
  <para style="q2" vid="PRO 25:20">yaa ŋgba soloŋ denyaŋesa keŋ bɔɔ mo woli gyam dɔɔ nɛ.<verse eid="PRO 25:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21" />Nyi tanam na ko n kɔlare na fa e weenɛɛ waa di,</para>
  <para style="q2" vid="PRO 25:21">nyi loŋboaneŋ na ko e na fa e loŋ waa nyɔɔ.<verse eid="PRO 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22" />N yɛɛ mena na n ta do e desɛŋ nideli,</para>
  <para style="q2" vid="PRO 25:22">te Degbeŋgyoo waa tɔ neŋ ka kom.<verse eid="PRO 25:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23" />Mena keŋ ado yenaŋ feliŋ na mo ɔga kɔŋ nɛ,</para>
  <para style="q2" vid="PRO 25:23">mena te laakem dekarate ne yele walaŋ ne nyaŋe ɔ sia.<verse eid="PRO 25:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PRO 25:24" />Debɔɔlɔɔ man kekyaa nyaageŋ dei,</para>
  <para style="q2" vid="PRO 25:24">kela ɛmɛɛ na alo kale gyaere ke kyaa dekpaŋalaŋ man.<verse eid="PRO 25:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25" />Mena keŋ loŋ defɛɛsa na ko loŋboaneŋ nɛ,</para>
  <para style="q2" vid="PRO 25:25">mena te nombia kpaakpaa ŋan ba lee lem nɛ doo.<verse eid="PRO 25:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26" />Mena keŋ loŋ deepue lee de kutu yaa detiribuŋ man loŋ de wɔlɛɛ nɛ,</para>
  <para style="q2" vid="PRO 25:26">mena te ŋon ɔ gbɛɛneŋ tenɛɛ de yale akpanyanyaŋte kɔta man nɛ doo.<verse eid="PRO 25:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27" />Be dei nyi nya di teebɔɔ beiŋ ya,</para>
  <para style="q2" vid="PRO 25:27">mena mɔ te na gyae nyi baa kɛlɛɛ neŋ beiŋ ya.<verse eid="PRO 25:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28" />Walaŋ ŋon ɔ bɛɛ tale kyaŋ ɔ wose ya nɛ,</para>
  <para style="q2" vid="PRO 25:28">yɛɛ ŋgba donɔɔ dinaa keŋ bɔɔ tekerii ka akyaŋse nɛ.<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1" />Mena keŋ sonoo doo dugbututɛɛ, yaa ɔga doo weenɛɛ kekɛrɛɛtɛɛ nɛ,</para>
  <para style="q2" vid="PRO 26:1">mena te obuo tekaboena diyiŋte ya.<verse eid="PRO 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2" />Mena keŋ akpelee na koro kyaa yaa kamelegyagyaa ne furufu ɔ bɛɛ kyaa ya nɛ,</para>
  <para style="q2" vid="PRO 26:2">mena te kefaala yakaate mɔ ba sem ya.<verse eid="PRO 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3" />Dembila doo fa dɛɛkyɔŋ te dokɔŋ doo fa afurum,</para>
  <para style="q2" vid="PRO 26:3">mena te dembila mɔ doo fa diyiŋte maama man.<verse eid="PRO 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4" />Na tiranɔɔ fa diyiŋte ɔ diyiŋ kedoobii man ya,</para>
  <para style="q2" vid="PRO 26:4">na mena ya na nyaŋ ke yɛɛ ŋgba ŋon nɛ.<verse eid="PRO 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5" />Tiranɔɔ fa diyiŋte ɔ diyiŋ kedoobii man,</para>
  <para style="q2" vid="PRO 26:5">na ɔ be kɛɛ ɔ wose nyi ɔ sia te kare ya.<verse eid="PRO 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6" />Walaŋ ŋon ɔ do diyiŋte tiila nɛ,</para>
  <para style="q2" vid="PRO 26:6">na yɛɛ yaa ŋgba ɔ keretii ɔ nawɔɔbia yaa ɔ nyɔɔ teekum baa nɛ.<verse eid="PRO 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7" />Mena keŋ ɔtakase nawɔɔ wuluŋɛɛ nɛ,</para>
  <para style="q2" vid="PRO 26:7">mena te diyiŋte mɔ nɔɔman dudu doo.<verse eid="PRO 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8" />Nyi n mo obuo fa diyiŋte nɛ,</para>
  <para style="q2" vid="PRO 26:8">na yɛɛ yaa ŋgba boe kebake do taya man nɛ.<verse eid="PRO 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9" />Mena keŋ sɔɔse daŋ doo soloŋ nyɔɔre nyiŋmaa man nɛ,</para>
  <para style="q2" vid="PRO 26:9">mena te diyiŋte nɔɔman dudu doo.<verse eid="PRO 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10" />Mena keŋ baŋdaŋ tɔɔre ne tɔɔ do gooli walaŋ nɛ,</para>
  <para style="q2" vid="PRO 26:10">mena te ŋon ɔ ne bɔ diyiŋte yaa ŋon ɔ dɔŋ bo do paa nɛ doo.<verse eid="PRO 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11" />Mena keŋ babaa na bese di ɔ tɔɔla nɛ,</para>
  <para style="q2" vid="PRO 26:11">mena te diyiŋte na bese yɛɛ ɔ diyiŋ nombia.<verse eid="PRO 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12" />N te naa walaŋ ŋon ɔ ne kɛɛ ɔ wose nyi ɔ sia te kare?</para>
  <para style="q2" vid="PRO 26:12">Diyiŋte dana lookegyakaa kela walaŋ ŋonaŋ.<verse eid="PRO 26:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13" />Kebɔŋalete ne yako nyiaa, &lt;&lt;Dinaate kyaa gbɛɛnaa man. Dinaate baŋte kyaa debɔɔ man.&gt;&gt;<verse eid="PRO 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14" />Mena keŋ disim na besena ka wose ka nyeela man nɛ,</para>
  <para style="q2" vid="PRO 26:14">mena te kebɔŋalete na besena ɔ wose ɔ dofoŋoŋ dɔɔ.<verse eid="PRO 26:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15" />Kebɔŋalete na mo ɔ nyiŋmaa do weenɛɛ nyefale man,</para>
  <para style="q2" vid="PRO 26:15">mena keŋ waa lese ke do ɔ nɔɔman dana e kebɔŋale beiŋ.<verse eid="PRO 26:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16" />Kebɔŋalete ne kɛɛ ɔ wose nyi ɔ sia te kare beiŋ,</para>
  <para style="q2" vid="PRO 26:16">kela balaŋ nyetooro baŋ bɛɛ tiranɔɔ nyansa man.<verse eid="PRO 26:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17" />Ŋon ɔ na mo ɔ nɔɔ do kale keŋ te yɛɛ ɔ wui ya man nɛ,</para>
  <para style="q2" vid="PRO 26:17">yɛɛ ŋgba ŋon ɔ be kyaŋ babaa ŋon ɔ be kpem deŋele nɛ.<verse eid="PRO 26:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18" />Mena keŋ nyee dewɔlɛɛsate ne tɔ baŋdaŋ,</para>
  <para style="q2" vid="PRO 26:18">nyeela ŋan na bee koe balaŋ nɛ doo,<verse eid="PRO 26:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19" />mena te walaŋ ŋon ɔ na beo ɔ dɔɔ,</para>
  <para style="q2" vid="PRO 26:19">na ɔ kpa, &lt;&lt;Mɛɛ do neŋ nsendee bo&gt;&gt; nɛ doo.<verse eid="PRO 26:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20" />Nyi boalaŋ daase de taŋ na boalaŋ na yem,</para>
  <para style="q2" vid="PRO 26:20">nyi kelaberetaore be kyaa ya na kale be kyaa ya.<verse eid="PRO 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21" />Mena keŋ nyewalaŋ ne yele boalaŋ ne kyaŋee, te boalaŋ daase ne yele boalaŋ ne kpaa nɛ,</para>
  <para style="q2" vid="PRO 26:21">mena ke te kale gyaere na mo yoo kɔŋ.<verse eid="PRO 26:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22" />Kelaberetaore nɔɔwoya yɛɛ ŋgba weenɛɛ gyaagyi nɛ,</para>
  <para style="q2" vid="PRO 26:22">ŋɛɛ gyoo walaŋ debaa man nideli.<verse eid="PRO 26:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23" />Nɔɔwoya gyoŋ nyiŋan ŋan Nyeempɔkum silana ke nɛ,</para>
  <para style="q2" vid="PRO 26:23">yɛɛ ŋgba kɔba wolom ayimɛɛ keŋ bɔɔ mo gyilaa osuŋ nɛ,<verse eid="PRO 26:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24" />Kɔlare na beo mo ɔ nɔɔwoya desina ɔ wose,</para>
  <para style="q2" vid="PRO 26:24">mɔ wa nyeempɔ man na ɔ na gyueŋ kekɔla nombia.<verse eid="PRO 26:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25" />Doo nyi ɔ nɔɔwoya dana gyoŋ koraŋ nɛ na lɛɛ e di ya,</para>
  <para style="q2" vid="PRO 26:25">nawolo nyi nombiakumɛɛ te wulu ɔ konɔɔ man.<verse eid="PRO 26:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26" />Waa tale mo dekara wuu kekɔla dɔɔ,</para>
  <para style="q2" vid="PRO 26:26">mɔna wa akpanyanyaŋ nombia gyae ka lee debɔɔ balaŋ man.<verse eid="PRO 26:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27" />Ɔkamasɛ ŋon ɔ wula dowokom na waa yala gyoo ke man,</para>
  <para style="q2" vid="PRO 26:27">nyi ŋolo de biliŋi boe na, ke gyae ka bese biliŋi mo ɔ dɔɔ.<verse eid="PRO 26:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28" />Dekara laakem ne kɔla baŋ kɔ gooli wɔ nɛ,</para>
  <para style="q2" vid="PRO 26:28">te kabeo nɔɔwoya na mo kewɔlɛɛ kɔŋ.<verse eid="PRO 26:28" /></para>
  <para style="b" />
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1" />Na gyɔ n konɔɔ lee kyoo dɔɔ ya,</para>
  <para style="q2" vid="PRO 27:1">nawolo nyi n ba gyeŋ keŋ gyae ke kɔŋ kyoo ya.<verse eid="PRO 27:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2" />Yela ŋolo kpoo ke kɛlɛɛ neŋ, na nyaŋ gbagba ya,</para>
  <para style="q2" vid="PRO 27:2">yenaŋte, na lee nyaŋ gbagba nɔɔman ya.<verse eid="PRO 27:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3" />Boe dana yuŋ te aŋasa yɛɛ kasolɔ ke,</para>
  <para style="q2" vid="PRO 27:3">mɔna diyiŋte da gyeŋ baŋ na, ke dana yuŋ kela ŋa ala pou.<verse eid="PRO 27:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4" />Baŋ dana nyeeman ŋɔe na baŋkum,</para>
  <para style="q2" vid="PRO 27:4">mɔna amɔte ne gyaela waa tale seŋ nuŋkurili siaman?<verse eid="PRO 27:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5" />N kalena walaŋ na,</para>
  <para style="q2" vid="PRO 27:5">dei kela ɔ yɛɛ dukum na n ke kyaŋ n sia wuu.<verse eid="PRO 27:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6" />Nyi n gyoo da tenee neŋ na n ke tale mo n wose lɔ ɔ dɔɔ,</para>
  <para style="q2" vid="PRO 27:6">mɔna n kɔlare de pukaa neŋ na kɛɛ e nideli.<verse eid="PRO 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7" />Ŋon ɔ be baa nɛ teebɔɔ bɛɛ gyɔ e loo ya,</para>
  <para style="q2" vid="PRO 27:7">mɔna ŋon tanam na ko e nɛ, kolo ŋaŋte koraŋ dana e gyoŋ.<verse eid="PRO 27:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8" />Mena keŋ gyeebu be furufu lee ɔ desaa man nɛ,</para>
  <para style="q2" vid="PRO 27:8">mena te ŋon ɔ be yeu lee ɔ dɛɛ nɛ doo.<verse eid="PRO 27:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9" />Lafenta na oliifi ne yele walaŋ wɔe ne fɛɛ e,</para>
  <para style="q2" vid="PRO 27:9">mɔna gyoo kpaakpaa kekolosifa,</para>
  <para style="q2" vid="PRO 27:9">dei kela.<verse eid="PRO 27:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10" />Na bɛɛ n gyoo yaa n kya ɔ gyoo ya,</para>
  <para style="q2" vid="PRO 27:10">nyi nombii de yala neŋ nɛ na gyu n loŋto dɛɛ ya,</para>
  <para style="q2" vid="PRO 27:10">nawolo nyi n dɔɔ ŋon ɔ benaana neŋ dei kela n loŋto ŋon ɔ kyaa lem.<verse eid="PRO 27:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11" />Me bu, yela n sia ke kara na n ke yela maa nyaŋee me konɔɔ man,</para>
  <para style="q2" vid="PRO 27:11">na maa nyiŋ tale tiranɔɔ fa baŋ bee kulu maŋ nɛ.<verse eid="PRO 27:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12" />Siakaralate ne naa nombiikum na ɔ te yeu ka yo,</para>
  <para style="q2" vid="PRO 27:12">mɔna ŋon ɔ ba gyeŋ daale ya ne tɛɛ bo ka gyoo ke man, na ɔ te nyiŋ deŋele kewɔŋ.<verse eid="PRO 27:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13" />Mo ŋon ɔ ba sem ŋɔɔle ŋolo kom nawɔɔ man kegba,</para>
  <para style="q2" vid="PRO 27:13">na n ka mo ke see kom keŋ nae.<verse eid="PRO 27:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14" />Ŋon ɔ karatɛɛ nebo nebo mo yeesa hiraa ɔ dɔɔ nɛ,</para>
  <para style="q2" vid="PRO 27:14">baa mo ke nyi ke yɛɛ kefaala ke.<verse eid="PRO 27:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15" />Alo yalale kale gyaere yɛɛ ŋgba deni,</para>
  <para style="q2" vid="PRO 27:15">keŋ ne lilii dekpaotɛɛ nɛ.<verse eid="PRO 27:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16" />Ŋon ɔ kpa waa tɔ e gbɛɛ yɛɛ ŋgba ŋon ɔ ne tɔ feliŋ gbɛɛ,</para>
  <para style="q2" vid="PRO 27:16">yaa waa mo ɔ nyiŋmaa tee nuŋ nɛ.<verse eid="PRO 27:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17" />Mena keŋ nyeele ne sara nyeele nɛ,</para>
  <para style="q2" vid="PRO 27:17">mena te walaŋ mɔ na wola walaŋ.<verse eid="PRO 27:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18" />Ŋon ɔ ne gyee fiigi daŋ ne diina ke bia,</para>
  <para style="q2" vid="PRO 27:18">te ŋon ɔ ne gyee ɔ gbeŋgyoo nɛ baa do e obuo.<verse eid="PRO 27:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19" />Mena keŋ walaŋ ne naa ɔ siagbɛɛ loŋ man nɛ,</para>
  <para style="q2" vid="PRO 27:19">mena te walaŋ konɔɔ na lese ɔ dinɔɔ wola.<verse eid="PRO 27:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20" />Yeŋ na woyadɛɛ bɛɛ baa ya,</para>
  <para style="q2" vid="PRO 27:20">mena te walaŋ sibii mɔ bɛɛ baa ya.<verse eid="PRO 27:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21" />Bɛɛ mo boalaŋ gyene kɔba wolom te bɛɛ mo boalaŋ degyapaa gyene kɔba yayam,</para>
  <para style="q2" vid="PRO 27:21">mɔna walaŋ kekɛlɛɛ te bɛɛ mo gyeŋ mena keŋ ɔ doo.<verse eid="PRO 27:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22" />Nyi n sɔɔ diyiŋte soi man,</para>
  <para style="q2" vid="PRO 27:22">nyi n mo sɔɔdaŋ sɔɔ e ŋgba wamela koraŋ nɛ,</para>
  <para style="q2" vid="PRO 27:22">n be gyae n ke tale lese ɔ diyiŋ lee ɔ man ya.<verse eid="PRO 27:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23" />Kɛɛ nideli nyi n gyeŋ n namense kedoobii man,</para>
  <para style="q2" vid="PRO 27:23">tee n sia kɛɛ n nunkyuese nideli.<verse eid="PRO 27:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24" />Nawolo nyi wosekenyiŋ be gyae ke doo kekpaakekpaa ya,</para>
  <para style="q2" vid="PRO 27:24">te gyoorikedi mɔ be gyae ke doo fa kalola kegyakaarese pou ya.<verse eid="PRO 27:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25" />Nyi be kɛrɛɛ ŋalese te wɔlɛɛ de tuu,</para>
  <para style="q2" vid="PRO 27:25">te be yilaa ŋalese lee bulase dɔɔ nɛ,<verse eid="PRO 27:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26" />n namensebia baa fa neŋ wose man abɔɔ,</para>
  <para style="q2" vid="PRO 27:26">na nya asoose ke fa neŋ tɛɛle.<verse eid="PRO 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27" />N ke nyiŋ asoose dideloŋ burum kɛɛ ɛmɛɛ na n denimantena,</para>
  <para style="q2" vid="PRO 27:27">na nya alebia dɔɔ.<verse eid="PRO 27:27" /></para>
  <para style="b" />
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1" />Akpanyanyaŋtena ne yeu keŋ ŋolo bee gegi e ya,</para>
  <para style="q2" vid="PRO 28:1">mɔna baŋ be gbɛɛneŋ tenɛɛ dana konɔɔ ŋgba dinaate nɛ.<verse eid="PRO 28:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2" />Nyi tɛɛle daale bee di mmaraase dɔɔ ya nɛ, ne yele siamantena baŋ ne kyɛɛkee bileŋbileŋ,</para>
  <para style="q2" vid="PRO 28:2">mɔna siamante ŋon ɔ sia be kare te ɔ gyeŋ nombia ne kyaa gbeli kyare.<verse eid="PRO 28:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3" />Diyemte ŋon ɔ na ŋere ayematena do nɛ,</para>
  <para style="q2" vid="PRO 28:3">yɛɛ ŋgba ɔga ŋon ɔ ne wɔlɛɛ weenɛɛ nɛ.<verse eid="PRO 28:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4" />Baŋ bɔɔ ne di mmaraa dɔɔ ya nɛ ne kɛlɛɛ akpanyanyaŋtena,</para>
  <para style="q2" vid="PRO 28:4">mɔna baŋ bee di mmaraa dɔɔ na sem tia wɔ.<verse eid="PRO 28:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5" />Nombiakumɛɛ yɛɛra bee nyii keŋ doona ke gbɛɛ man ya,</para>
  <para style="q2" vid="PRO 28:5">mɔna baŋ bɛɛ kɛo Degbeŋgyoo ne nyii ke man nideli.<verse eid="PRO 28:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6" />Diyemte ŋon nombiikum be doo ɔ man ya dei,</para>
  <para style="q2" vid="PRO 28:6">kela kɔbate ŋon ɔ gbɛɛneŋ ba tenɛɛ ya.<verse eid="PRO 28:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7" />Bu ŋon ɔ ne nyii nombia man ne di mmaraase dɔɔ,</para>
  <para style="q2" vid="PRO 28:7">mɔna bu ŋon ɔ na mo ɔ wose dona kedikumtena na do ɔ kya desɛŋ.<verse eid="PRO 28:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8" />Ɔkamasɛ ŋon ɔ nyiŋ ɔ wose lee loŋ kelɛɛ gyakaa kɔba dɔɔ beiŋ man nɛ,</para>
  <para style="q2" vid="PRO 28:8">ɔ ne yilaa ŋa bo see fa ŋon waa wii diyemte waraŋase nɛ.<verse eid="PRO 28:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9" />Nyi ŋolo da besena ɔ nimboo tee nombia kawola ŋan nɛ,</para>
  <para style="q2" vid="PRO 28:9">ɔ kefane koraŋ yɛɛ anekɔlaŋ ke.<verse eid="PRO 28:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10" />Ɔkamasɛ ŋon ɔ beo ŋon ɔ gbɛɛneŋ tenɛɛ do dukum man nɛ,</para>
  <para style="q2" vid="PRO 28:10">waa yala ŋon gbagba bɔɔ man,</para>
  <para style="q2" vid="PRO 28:10">mɔna ŋon dukum be doo ɔ man ya waa nyiŋ dedii kpaakpaa.<verse eid="PRO 28:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11" />Kɔbate ne kɛɛ ɔ wose nyi ɔ sia te kare,</para>
  <para style="q2" vid="PRO 28:11">mɔna diyemte ŋon ɔ ne nyii nombia man ne naa ɔ mokɔɔ.<verse eid="PRO 28:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12" />Nyi ŋon ɔ tenɛɛ de dee na balaŋ ne nyaŋee,</para>
  <para style="q2" vid="PRO 28:12">mɔna nyi akpanyanyaŋte ne di balaŋ dɔɔ na balaŋ ne gyu ka yo.<verse eid="PRO 28:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13" />Ɔkamasɛ ŋon ɔ ne wuu ɔ dukum dɔɔ bee nyiŋ ɔ wose ya,</para>
  <para style="q2" vid="PRO 28:13">mɔna ŋon ɔ yako ɔ dukum te ɔ tina ka keyɛɛ yela na baa wii ɔ waraŋase.<verse eid="PRO 28:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14" />Ŋon ɔ ne yee Degbeŋgyoo debaŋ kamasɛ nɛ ŋonna nyeebam,</para>
  <para style="q2" vid="PRO 28:14">mɔna ɔkamasɛ ŋon ɔ yɛɛ konɔɔyuŋ na waa gyoo kayeyɛɛ man.<verse eid="PRO 28:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15" />Akpanyanyaŋte ŋon ɔ ne di ayematena dɔɔ nɛ,</para>
  <para style="q2" vid="PRO 28:15">yɛɛ ŋgba dinaate ŋon ɔ ne muusu yaa mokɔɔte ŋon ɔ sibii be yɛɛ nɛ.<verse eid="PRO 28:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16" />Gyoo ŋon ɔ bee nyii nombia man ya na ŋere balaŋ do,</para>
  <para style="q2" vid="PRO 28:16">mɔna ŋon ɔ ne kɔla gbɛɛkum ka mo nyiŋ wose nɛ waa kyaa kyare.<verse eid="PRO 28:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17" />Ŋon be bu e fɔɔ lee walaŋ kako dɔɔ nɛ,</para>
  <para style="q2" vid="PRO 28:17">ɔ na wula ŋon gbagba yebɔɔ baa,</para>
  <para style="q2" vid="PRO 28:17">ŋolo na lɛɛ e ya.<verse eid="PRO 28:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18" />Ŋon nombiikum be doo ɔ kekyaabii man ya waa nyiŋ kegyee,</para>
  <para style="q2" vid="PRO 28:18">mɔna ŋon ɔ gbɛɛneŋ be tulii waa yala gyoo bɔɔ man.<verse eid="PRO 28:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19" />Ŋon ɔ ne kyaŋ ɔ wose fara waa nyiŋ weenɛɛ burum,</para>
  <para style="q2" vid="PRO 28:19">mɔna ŋon ɔ silana abɔɔ ŋan taŋ tɔnɔɔ ya nɛ waa dɔɔ ɔ diyem man.<verse eid="PRO 28:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20" />Baa hiraa ŋon ɔ ne di anokoare nɛ nideli,</para>
  <para style="q2" vid="PRO 28:20">mɔna baa wɔŋ ŋon ɔ ne yase sia do wosekenyiŋ man nɛ deŋele.<verse eid="PRO 28:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21" />Walaŋ siaman kekɛɛ nombia kedi man be dei ya,</para>
  <para style="q2" vid="PRO 28:21">mɔna weenɛɛ kyomii dɔɔ walaŋ waa yɛɛ dukum.<verse eid="PRO 28:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22" />Nkyekyete ne yase ɔ sia nyi waa nyiŋ ɔ wose,</para>
  <para style="q2" vid="PRO 28:22">mɔna ɔ ba gyeŋ nyi diyem doo daana e ya.<verse eid="PRO 28:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23" />Ɔkamasɛ ŋon ɔ kalena walaŋ nɛ kɔ ɔto na baa boele e,</para>
  <para style="q2" vid="PRO 28:23">kela kabeo nɔɔwoyate.<verse eid="PRO 28:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24" />Ɔkamasɛ ŋon ɔ ŋmɛɛle ɔ kya yaa ɔ naa abɔɔ, te ɔ yako nyi &lt;&lt;Ka te yɛɛ dukum ya nɛ,&gt;&gt;</para>
  <para style="q2" vid="PRO 28:24">ɔ yɛɛ abɔɔwɔlɛɛre ɔ gyoo e.<verse eid="PRO 28:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25" />Ŋon ɔ sia ne yɛɛ abɔɔ na mo kale kɔŋ,</para>
  <para style="q2" vid="PRO 28:25">mɔna ŋon ɔ mo ɔ wose lɔ Degbeŋgyoo dɔɔ waa de.<verse eid="PRO 28:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26" />Ŋon ɔ ne lɛɛ ŋon gbagba wose di nɛ yɛɛ diyiŋte e,</para>
  <para style="q2" vid="PRO 28:26">mɔna ŋon ɔ ne tɛɛ nyansa man waa nyiŋ kegyee.<verse eid="PRO 28:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27" />Ŋon ɔ ne fa ayematena nɛ, ɔ wose be gyae ke kyaŋ e ya,</para>
  <para style="q2" vid="PRO 28:27">mɔna ŋon ɔ na besena ɔ nimboo tee wɔ nɛ waa nyiŋ kefaalase burum.<verse eid="PRO 28:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28" />Nyi akpanyanyaŋte ne di balaŋ dɔɔ na balaŋ ne gyu ka yo,</para>
  <para style="q2" vid="PRO 28:28">mɔna nyi akpanyanyaŋte de munu na baŋ ba tenɛɛ ne wuku.<verse eid="PRO 28:28" /></para>
  <para style="b" />
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1" />Ɔkamasɛ ŋon be kalena e agbaatee agbaatee te ɔ bee nyii ya nɛ,</para>
  <para style="q2" vid="PRO 29:1">waa wɔlɛɛ karatetee keŋ ɔ be gyae waa nyiŋ kekyɔ ya.<verse eid="PRO 29:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2" />Akpaa baŋ ba tenɛɛ ne wuku na balaŋ baŋ ne nyaŋee,</para>
  <para style="q2" vid="PRO 29:2">akpaa akpanyanyaŋtena ne di balaŋ dɔɔ na balaŋ baŋ na toroŋ.<verse eid="PRO 29:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3" />Ŋon ɔ ne gyae nyansa ne yele ɔ kya ne nyaŋee,</para>
  <para style="q2" vid="PRO 29:3">mɔna ŋon ɔ na mo ɔ wose dona futoolitena ne wɔlɛɛ ɔ wosekenyiŋ.<verse eid="PRO 29:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4" />Nombia kedi kegbɛɛ dɔɔ te gyoo na mo bake donɔɔ,</para>
  <para style="q2" vid="PRO 29:4">mɔna ŋon ɔ sia ne yɛɛ abɔɔ ka yo lɛɛ ne yɛlɛɛ ke.<verse eid="PRO 29:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5" />Ŋon ɔ na mo kabeo nɔɔwoya fa ɔ tebia nɛ,</para>
  <para style="q2" vid="PRO 29:5">ne nyɔɔ wɔ kɔtase be gbɛɛneŋ man baa.<verse eid="PRO 29:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6" />Nombiakumɛɛ yɛɛre gbagba dukum ne nyɔɔna kɔta,</para>
  <para style="q2" vid="PRO 29:6">mɔna ŋon ɔ tenɛɛ ne fae yeesa nyaŋee na te yɛɛ e gyoŋ.<verse eid="PRO 29:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7" />Ŋon ɔ tenɛɛ ne kɛɛ nyi baa di ayematena nombia ke gbɛɛ dɔɔ fa wɔ,</para>
  <para style="q2" vid="PRO 29:7">mɔna akpanyanyaŋte ŋon be famenɛna wɔ ya.<verse eid="PRO 29:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8" />Balaŋ kulura na mo yoo kɔŋ donɔɔ man,</para>
  <para style="q2" vid="PRO 29:8">mɔna siakaralate ne yele baŋ ne fɛɛ.<verse eid="PRO 29:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9" />Nyi siakaralate na diyiŋte de gyu nombia dedii man nɛ,</para>
  <para style="q2" vid="PRO 29:9">diyiŋte na boŋo bo fae yeesa tɔ deŋela.<verse eid="PRO 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10" />Awudiini ne kɔla walaŋ ŋon ɔ dana yele,</para>
  <para style="q2" vid="PRO 29:10">te ɔ ne gyae waa ko ŋon ɔ gbɛɛneŋ tenɛɛ.<verse eid="PRO 29:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11" />Diyiŋte na lese ɔ baŋ pou debɔɔ,</para>
  <para style="q2" vid="PRO 29:11">mɔna siakaralate ne nyiŋ konɔɔ.<verse eid="PRO 29:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12" />Akpaa gyoo de tei akɛrɛɛ nombia nɛ,</para>
  <para style="q2" vid="PRO 29:12">ɔ kyaarabia pou na bese akpanyanyaŋtena.<verse eid="PRO 29:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13" />Diyemte na ŋon ɔ na ŋere e do pou dana kolo dokoloŋ,</para>
  <para style="q2" vid="PRO 29:13">Degbeŋgyoo faana be bala nyeedoŋ.<verse eid="PRO 29:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14" />Nyi gyoo de di ayematena nombia kegbɛɛ dɔɔ nɛ,</para>
  <para style="q2" vid="PRO 29:14">ɔ gyoori ne kyaa gbeli kyare.<verse eid="PRO 29:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15" />Dembila na kekalana ne fa biikyaa nyansa,</para>
  <para style="q2" vid="PRO 29:15">mɔna biikyaa ŋon bɔɔ na tenee e ya na do ɔ naa desɛŋ.<verse eid="PRO 29:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16" />Nyi akpanyanyaŋtena ne wuku na dukum mɔ na boo,</para>
  <para style="q2" vid="PRO 29:16">mɔna baŋ ba tenɛɛ baa naa ba keyala man.<verse eid="PRO 29:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17" />Akpaa n tenee n bia nideli na baa fa neŋ wosefɛɛreŋ,</para>
  <para style="q2" vid="PRO 29:17">baa yela n ke nyiŋ keŋ n konɔɔ ne gyae.<verse eid="PRO 29:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18" />Nyi kalesewola be kyaa ya na balaŋ na yo gbɛɛ,</para>
  <para style="q2" vid="PRO 29:18">mɔna ŋon ɔ ne di nombia kawola dɔɔ nɛ ŋonna nyeebam.<verse eid="PRO 29:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19" />Bɔɔ na mo nɔɔwoya yakaa tenee gbeŋi ya,</para>
  <para style="q2" vid="PRO 29:19">akpaa ɔ nyii ke man koraŋ na ɔ be gyae waa di ke dɔɔ ya.<verse eid="PRO 29:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20" />N ne naa ŋon ɔ ne barase kolosi?</para>
  <para style="q2" vid="PRO 29:20">Diyiŋte dana lookegyakaa kela e.<verse eid="PRO 29:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21" />Nyi n do n gbeŋi lee ɔ kewalaŋ na,</para>
  <para style="q2" vid="PRO 29:21">wee daale waa kaa gyeŋ seŋ n nyeedɔɔ.<verse eid="PRO 29:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22" />Baŋte ne loo nombia kɔŋ,</para>
  <para style="q2" vid="PRO 29:22">te baŋ kporokporote ne yɛɛ nombiakumɛɛ burum.<verse eid="PRO 29:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23" />Wose kegate ne tisina walaŋ tɛɛle man,</para>
  <para style="q2" vid="PRO 29:23">mɔna wose keyɔkɔse ne fa obuo.<verse eid="PRO 29:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24" />Ŋon ɔ ne kyɔ ŋmɛɛlate bɛɛ gyae ɔ nyeedoŋ ya,</para>
  <para style="q2" vid="PRO 29:24">ɔ ne kaŋ ntam keŋ ɔ bɛɛ yako ya.<verse eid="PRO 29:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25" />Deniwalaŋ keyee yɛɛ kɔta ke,</para>
  <para style="q2" vid="PRO 29:25">mɔna ɔkamasɛ ŋon ɔ mo ɔ wose lɔ Degbeŋgyoo dɔɔ na waa nyiŋ kegyee.<verse eid="PRO 29:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26" />Balaŋ burum ne gyae nyi gyoo kaboele wɔ,</para>
  <para style="q2" vid="PRO 29:26">mɔna Degbeŋgyoo ne diina nombia kegbɛɛ dɔɔ.<verse eid="PRO 29:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27" />Ŋon ɔ tenɛɛ ne kɔla baŋ bɔɔ ne di anokoare ya,</para>
  <para style="q2" vid="PRO 29:27">akpanyanyaŋte ne kɔla ŋon ɔ tenɛɛ.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 30:1" />Yake bu Agure nɔɔwoya yaa,</para>
  <para style="q1" vid="PRO 30:1">Ɔ yako Itiele na Ukale nyi,<verse eid="PRO 30:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2" />Ampaŋ me yɛɛ diyiŋte e gbaa, keŋ ma te yɛɛ walaŋ e ya,</para>
  <para style="q2" vid="PRO 30:2">mɔɔ dana deniwalaŋ nombia man kenyii ya.<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />Ma te kasee nyansa ya,</para>
  <para style="q2" vid="PRO 30:3">te mɔɔ dana nombia man kagyeŋ lee Fereŋkyeŋte Ŋon wose man ya.<verse eid="PRO 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4" />Amɔte gyeŋala gyu adido te ɔ tisiwɔ kɔŋ?</para>
  <para style="q2" vid="PRO 30:4">Amɔte teena ɔ nyiŋmaa lɛɛ feliŋ?</para>
  <para style="q1" vid="PRO 30:4">Amɔte bakena loŋ do kanyaŋ man see?</para>
  <para style="q2" vid="PRO 30:4">Amɔte seena tɛɛle kei ɔto pou mokɔɔ?</para>
  <para style="q1" vid="PRO 30:4">Ɔ yele yɛna sena, te ɔ bu yele yɛna sena?</para>
  <para style="q2" vid="PRO 30:4">Ke yɛɛ ampaŋ n gyeŋ.<verse eid="PRO 30:4" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5" />Wurubuarɛ nombii kamasɛ doona ke gbɛɛ,</para>
  <para style="q2" vid="PRO 30:5">ŋon yɛna yoo nyeele pampasaŋ fa baŋ pou bee yeu kagyoo e nɛ.<verse eid="PRO 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6" />Na mo kolo kpu ɔ nombia man ya,</para>
  <para style="q2" vid="PRO 30:6">na mena ya na waa kalana neŋ na n ka bese dekarate.<verse eid="PRO 30:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7" />Degbeŋgyoo, abɔɔ ala te mɛɛ bɔɔse neŋ,</para>
  <para style="q2" vid="PRO 30:7">na bɛɛse maŋ ŋa pɛ maa yeŋ ya.<verse eid="PRO 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8" />Lese kabeo na dekara lee me man gyu lem,</para>
  <para style="q2" vid="PRO 30:8">na yɛɛ maŋ diyemte yaa kɔbate ya,</para>
  <para style="q2" vid="PRO 30:8">fa maŋ ma wee kamasɛ weenɛɛ bo.<verse eid="PRO 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9" />Na mena ya maa nyiŋ ma wose na maa bɛɛ neŋ,</para>
  <para style="q2" vid="PRO 30:9">na maa yako nyi, &lt;Amɔte yɛna Degbeŋgyoo?&gt;</para>
  <para style="q1" vid="PRO 30:9">Yaa maa di diyem na maa ŋmɛɛle,</para>
  <para style="q2" vid="PRO 30:9">na maa mo ayimɛɛ wuu me Wurubuarɛ yele ya.<verse eid="PRO 30:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10" />Na wɔlɛɛ ŋolo tobaale fa ɔ gbeŋgyoo ya,</para>
  <para style="q2" vid="PRO 30:10">na mena ya waa falaa neŋ na n kena diyem.<verse eid="PRO 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11" />Baale kyaa keŋ bɛɛ falaa be kyaɔ,</para>
  <para style="q2" vid="PRO 30:11">te bɔɔ ne hiraa be naɔ ya.<verse eid="PRO 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12" />Baale ne kɛɛ ba wose nyi be dei baŋ gbagba siaman,</para>
  <para style="q2" vid="PRO 30:12">mɔna bɔɔ ne gberaa ba ayimɛɛ leki ya.<verse eid="PRO 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13" />Baale kyaa keŋ bɛɛ gate ba wose,</para>
  <para style="q2" vid="PRO 30:13">te bɔɔ na mo walaŋ yɛɛ kolo ya.<verse eid="PRO 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14" />Be kela yɛɛ yoosilase ŋa,</para>
  <para style="q2" vid="PRO 30:14">te silase doo ba kedaase man,</para>
  <para style="q1" vid="PRO 30:14">na baa mo wɔlɛɛ ayematena lee tɛɛle dɔɔ,</para>
  <para style="q2" vid="PRO 30:14">na baŋ bɔɔ dana kolo ya nɛ lee balaŋ man.<verse eid="PRO 30:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15" />Desekpe dana bia alebia bala,</para>
  <para style="q2" vid="PRO 30:15">bɛɛ fae yeesa nyiaa, &lt;Fa maŋ, Fa maŋ,</para>
  <para style="b" vid="PRO 30:15" />
  <para style="q1" vid="PRO 30:15">Abɔɔ atooro kyaa keŋ ŋɔ ne baa ya,</para>
  <para style="q2" vid="PRO 30:15">abɔɔ anaara bɛɛ yako nyi, &lt;Tekaboe&gt; ya,<verse eid="PRO 30:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 30:16" />Woyadɛɛ na ɔlamanbo dokyoa,</para>
  <para style="q2" vid="PRO 30:16">tɛɛle keŋ loŋ bɛɛ baa ke ya,</para>
  <para style="q2" vid="PRO 30:16">na boalaŋ keŋ bɛɛ yako nyi, &lt;Tekaboe&gt;ya.<verse eid="PRO 30:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17" />Sibii keŋ ne kulu kya,</para>
  <para style="q2" vid="PRO 30:17">te ke bɛɛ kala naa do kolo man ya nɛ,</para>
  <para style="q1" vid="PRO 30:17">Kwaakwaadabise baa di ke,</para>
  <para style="q2" vid="PRO 30:17">na bapɛtɛɛna mɔ kaa di ke.<verse eid="PRO 30:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 30:18" />Abɔɔ atooro kyaa keŋ ŋe dana maŋ gyakoloŋ,</para>
  <para style="q2" vid="PRO 30:18">anaara te mɔɔ ne nyii ŋe man ya.<verse eid="PRO 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 30:19" />Otoloku ke furufu adido,</para>
  <para style="q2" vid="PRO 30:19">dom gbɛɛ kpanaŋ dɔɔ,</para>
  <para style="q1" vid="PRO 30:19">pantuu dinaa gbɛɛ loŋ dɔɔ,</para>
  <para style="q2" vid="PRO 30:19">na baale gbɛɛ alebu gyaŋ.<verse eid="PRO 30:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20" />Alo ŋon ɔ na mo ayimɛɛ wuu ɔ wose gbɛɛ yaa,</para>
  <para style="q2" vid="PRO 30:20">ɔ ne dii na ɔ ta feefo ɔ nɔɔ</para>
  <para style="q2" vid="PRO 30:20">na ɔ kpa nyiaa, &lt;Ma te yɛɛ kolokum ya.&gt;<verse eid="PRO 30:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 30:21" />Abɔɔ atooro tɛɛ te tɛɛle ne seree,</para>
  <para style="q2" vid="PRO 30:21">anaara te ɔ be tale seele ya.<verse eid="PRO 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 30:22" />Gbeŋi ŋon ɔ be kaa bese gyoo,</para>
  <para style="q2" vid="PRO 30:22">diyiŋte ŋon ɔ be dii baa nideli,<verse eid="PRO 30:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 30:23" />Alo ŋon ŋolo bɛɛ gyae e ya de nyiŋ baale,</para>
  <para style="q2" vid="PRO 30:23">na alebu ŋon ɔ be kaa lɛo ɔ gbeŋgyoo alo baale.<verse eid="PRO 30:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 30:24" />Abɔɔ anaara yɛna buruburu tɛɛle dɔɔ,</para>
  <para style="q2" vid="PRO 30:24">mɔna ŋe sia te kare nideli.<verse eid="PRO 30:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 30:25" />Kameleese be dana doŋ ya,</para>
  <para style="q2" vid="PRO 30:25">mɔna bɛɛ see be weenɛɛ dugbututɛɛ.<verse eid="PRO 30:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 30:26" />Gbegyagbegyase be dana doŋ ya,</para>
  <para style="q2" vid="PRO 30:26">mɔna bɛɛ yɛɛ ba adoise bo kpanaŋse man.<verse eid="PRO 30:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27" />Akpataana be dana gyoo ya,</para>
  <para style="q2" vid="PRO 30:27">mɔna bɛɛ tɛɛ akpiise man.<verse eid="PRO 30:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28" />Nyaŋ ke tale mo n nyiŋmaa kyaŋ denite,</para>
  <para style="q2" vid="PRO 30:28">mɔna gyooro dekpaŋalaŋ man te ɔ kyaa.<verse eid="PRO 30:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 30:29" />Abɔɔ atooro keta man dana kyeo,</para>
  <para style="q2" vid="PRO 30:29">anaara ne tɛɛ gyooro keta.<verse eid="PRO 30:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30" />Dinaate yɛna wonembia pou man doŋte,</para>
  <para style="q2" vid="PRO 30:30">ɔ bee yee kolo na kolo ya.<verse eid="PRO 30:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 30:31" />Kegyim baale, asoo baale,</para>
  <para style="q2" vid="PRO 30:31">na gyoo ŋon ɔ dɔŋ ɔ balaŋ siaman.<verse eid="PRO 30:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32" />Nyi n yɛɛ diyiŋ gyina n wose adido,</para>
  <para style="q2" vid="PRO 30:32">yaa n gyueŋ dukum,</para>
  <para style="q2" vid="PRO 30:32">mo n nyiŋmaa gyɔ n nɔɔ dɔɔ.<verse eid="PRO 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33" />Nyi n ŋmaase wonembu dide na nuŋ na lee,</para>
  <para style="q2" vid="PRO 30:33">nyi n boa n memɔɔ keŋkeŋ na fatabo na lee,</para>
  <para style="q2" vid="PRO 30:33">mena te n gyeŋ baŋ beiŋ na kale ne kɔŋ.<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="s1">Lemuele Nombia Keyako</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />Kɛŋa yɛna nombia ŋan Masa gyoo Lemuele ɔ naa ba wola e.<verse eid="PRO 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2" />Me bu, tei, me tɔɔman lolobu, tei,</para>
  <para style="q2" vid="PRO 31:2">me bu tei, nyaŋ yɛna ma kefane nɔɔketira.<verse eid="PRO 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3" />Na wɔlɛɛ n doŋ ala dɔɔ ya,</para>
  <para style="q2" vid="PRO 31:3">n doŋ ala baŋ bɛɛ wɔlɛɛ gyooneŋ nɛ dɔɔ ya.<verse eid="PRO 31:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4" />Lemuele, te yɛɛ gyooneŋ wui ya,</para>
  <para style="q2" vid="PRO 31:4">be dei nyi gyooneŋ baa nyɔɔ soloŋ ya,</para>
  <para style="q2" vid="PRO 31:4">gyooneŋ bɛɛ nyɔɔ soloŋ doŋte ya,<verse eid="PRO 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5" />na mena ya baa nyɔɔ na baa wolee kebakesee ŋan,</para>
  <para style="q2" vid="PRO 31:5">na baa tulii baŋ ba wose be kyaŋ wɔ nɛ nombia.<verse eid="PRO 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6" />Mo soloŋ doŋte fa ŋon ɔ ne wɔlɛɛ,</para>
  <para style="q2" vid="PRO 31:6">waen fa ŋon ɔ doo kayeyɛɛ man.<verse eid="PRO 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7" />Yela baa nyɔɔ na baa wolee ba diyem,</para>
  <para style="q2" vid="PRO 31:7">na bɔɔ tɔɔse ba diyem kena bela ya.<verse eid="PRO 31:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8" />Kolosi lɛɛ baŋ bɔɔ tale kolosi fa ba wose ya nɛ,</para>
  <para style="q2" vid="PRO 31:8">fa ayematena kenyiŋ keŋ kaboena wɔ.<verse eid="PRO 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9" />Gyuusu n nɔɔ di nombia kegbɛɛ dɔɔ,</para>
  <para style="q2" vid="PRO 31:9">di seŋ ayematena na baŋ bɔɔ dana kolo ya nɛ wɔle.<verse eid="PRO 31:9" /></para>
  <para style="s1">Alo Yalale Kpaakpaa</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10" />Wɛɛle kpaakpaa, amɔ ne gyaela waa nyiŋ?</para>
  <para style="q2" vid="PRO 31:10">Ɔ na lee koya kela kegyaŋase kpaakpaate.<verse eid="PRO 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11" />Ɔ baale na mo ɔ loo pou gyakaa ɔ dɔɔ,</para>
  <para style="q2" vid="PRO 31:11">keŋ kolo na kolo bee hia e ya.<verse eid="PRO 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12" />Alo ŋon kekyaabii man pou ɔ ne yɛɛ baale ŋon deeli,</para>
  <para style="q2" vid="PRO 31:12">ɔ bɛɛ yɛɛ e dukum ya.<verse eid="PRO 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13" />Ɔ na lese kuŋtuŋ na dukurufa,</para>
  <para style="q2" vid="PRO 31:13">na ɔ ta mo ɔ nyiŋmaase yɛɛ tom gyoŋ man.<verse eid="PRO 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14" />Ɔ yɛɛ ŋgba kebudiira pantuu dinaa nɛ,</para>
  <para style="q2" vid="PRO 31:14">ɔ na mo ɔ weenɛɛ lee lemlem kɔŋ.<verse eid="PRO 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15" />Ɔ ne karatɛɛ koro pɛ tɛɛ kena,</para>
  <para style="q2" vid="PRO 31:15">ɔ ne fa ɔ dekpaŋalaŋmantena weenɛɛ,</para>
  <para style="q2" vid="PRO 31:15">na ɔ te fa wa alebia tomse ŋan baa yɛɛ.<verse eid="PRO 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16" />Ɔ ne kɛo tɛɛle na ɔ te lɛɛ ke,</para>
  <para style="q2" vid="PRO 31:16">ɔ na mo keŋ ɔ be nyim nɛ fara gerepo wɔɔ.<verse eid="PRO 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17" />Ɔ ne kpaŋ abɔsɔɔ yɛɛ ɔ tom nedoŋ,</para>
  <para style="q2" vid="PRO 31:17">ɔ na do ɔ kakyeŋ yɛɛ tom.<verse eid="PRO 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18" />Ɔ ne kɛɛ nyi ɔ ne nyiŋ tɔnɔɔ ɔ kebu kedi man,</para>
  <para style="q2" vid="PRO 31:18">te ɔ kanea bɛɛ yem nelim ya.<verse eid="PRO 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19" />Ɔ dana ɔ dukurufadaŋ ɔ nyiŋmaa man,</para>
  <para style="q2" vid="PRO 31:19">na ɔ ta mo ɔ nyimbia kyaŋ dukurufa keŋ.<verse eid="PRO 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20" />Ɔ ne yɛɛ wɔe fa ayematena,</para>
  <para style="q2" vid="PRO 31:20">te ɔ ne kyɔ baŋ bɔɔ dana koo ya nɛ.<verse eid="PRO 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21" />Ɔ bee yee fa ɔ dekpaŋalaŋmantena waaretɛɛ ya,</para>
  <para style="q2" vid="PRO 31:21">nawolo nyi be popou ne wuu kuŋtuŋ.<verse eid="PRO 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22" />Ɔ ta loo kuŋtuŋ wuu ɔ dofoŋoŋ dɔɔ,</para>
  <para style="q2" vid="PRO 31:22">ɔ kaana kanyaŋ kpaakpaate na amɔlaloŋ kanyaŋse.<verse eid="PRO 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23" />Bee bu ɔ baale donɔɔ dinaa keŋ denaanɔɔ man,</para>
  <para style="q2" vid="PRO 31:23">botɔɔ keŋ ɔ ne gyu kekyaa tɛɛle keŋ kegyiise man nɛ.<verse eid="PRO 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24" />Ɔ ne ŋara kanyaŋ kpaakpaate abɔɔ yɔɔ,</para>
  <para style="q2" vid="PRO 31:24">te ɔ ne yɔɔ kanyaŋse ŋan bɛɛ mo kpaŋ teŋase man nɛ fa kebudiira.<verse eid="PRO 31:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25" />Yele kelɛɛ na doŋ yɛna ɔ kanyaŋse ŋan ɔ ne wuu,</para>
  <para style="q2" vid="PRO 31:25">ɔ bee yee weeya akaŋ ŋan ne kɔŋ nɛ ya.<verse eid="PRO 31:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26" />Ɔ ne kolosi nyansa man,</para>
  <para style="q2" vid="PRO 31:26">te anokoare nombia kawola gyakaa ɔ laakem dɔɔ.<verse eid="PRO 31:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27" />Ɔ sia gyakaa ɔ denimantena pou dɔɔ,</para>
  <para style="q2" vid="PRO 31:27">te ɔ be dana kebɔŋale ya.<verse eid="PRO 31:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28" />Ɔ bia na koro na ba te baake e nyi kehiraa,</para>
  <para style="q2" vid="PRO 31:28">ɔ baale mɔ mena, na ɔ ta lese ɔ yele.<verse eid="PRO 31:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29" />&lt;&lt;Ala burum ne yɛɛ ŋan kaboena,</para>
  <para style="q2" vid="PRO 31:29">mɔna nyaŋ kela be popou.&gt;&gt;<verse eid="PRO 31:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30" />Aleebiri yɛɛ kabeo ke, te kyeo yɛɛ yakaa,</para>
  <para style="q2" vid="PRO 31:30">mɔna kaboena nyi baa lese alo ŋon ɔ ne yee Degbeŋgyoo yele.<verse eid="PRO 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31" />Ɛ mo obuo fa e lee ŋan pou ɔ ba mo ɔ nyiŋmaase yɛɛ dɔɔ,</para>
  <para style="q2" vid="PRO 31:31">na ɔ tomse ka lese ɔ yele donɔɔ dinaa keŋ denaanɔɔ man.<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>