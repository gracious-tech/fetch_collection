<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Glavda</book>
  <para style="toc2">1CO</para>
  <para style="toc1">1CO</para>
  <para style="mt1">1CO</para>
  <chapter number="1" style="c" sid="1CO 1"/>
  <para style="s">Taa uussa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1"/>Bulus wa ɗahavant kiyava nǝg kǝ zǝr ɓǝlga Yesu Kǝristi dǝ naaga Daadamazhigǝl, ard zǝraabamiyam sastanis. <verse eid="1CO 1:1"/><verse number="2" style="v" sid="1CO 1:2"/>Da vak uudaha Daadamazhigǝl kwar ma kurinti, ard da vak lii ɗahavtǝrant kǝ gata Kǝristi Yesu, ǝmtad ɗǝ lii aandzu ta kwara kwar dzugazhǝgǝla ma ɗaaga yesu tlǝkatǝga yaazhigǝlamiyama, baz yaazhǝgilatǝra ard kǝmyam baɗǝmma. <verse eid="1CO 1:2"/><verse number="3" style="v" sid="1CO 1:3"/>Hɛrǝrra ard gabǝr vak Daadamazhigǝl Daadamiyam ard Yaazhigǝl Yesu Kǝristi da vakaruwa.<verse eid="1CO 1:3"/></para>
  <para style="s">Tagghartag nǝ Bulus kǝ uus kǝ Daadamazhigǝla</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4"/>Ən tagar uus kǝ Daadamazhigǝl ba kǝla hǝng kwakyarvad kuurama, aɗabad hɛrǝr vǝlakur nǝ iin tǝdvad Yesu Kǝristi. <verse eid="1CO 1:4"/><verse number="5" style="v" sid="1CO 1:5"/>Aɗaba tǝdvad iina, vǝlakurvǝlǝg nǝ uud kǝ hyahhǝr aandzu takwar kǝ gyaba, tǝdǝvad taa ghaiya ard sǝgasǝrgǝr baɗǝmma. <verse eid="1CO 1:5"/><verse number="6" style="v" sid="1CO 1:6"/>Bandkwa haiyavant nǝ shiidamnd tǝghǝr Kǝristi mataatakaruwa. <verse eid="1CO 1:6"/><verse number="7" style="v" sid="1CO 1:7"/>Mbakyarvad kwaha maay nǝ dǝgiti vǝlakurbi nǝ Daadamazhigǝl tǝdvad shǝkwan biya, bandkwam fa gyi nǝ uuram am paka saaya Yaazhigǝlamiyam Yesu Kǝristi. <verse eid="1CO 1:7"/><verse number="8" style="v" sid="1CO 1:8"/>Da fǝkurnaafǝg nǝ Yaazhigǝl kǝ ndzǝɗa tangw dat ghaala shifǝgaruwa, aɗaba am da nal kǝ lii maay dǝ haip ma sartǝn da saay nǝ Yaazhigǝl Kǝristi. <verse eid="1CO 1:8"/><verse number="9" style="v" sid="1CO 1:9"/>Daadamazhigǝl kwa ɗaahakurǝt da ɓa huɗir ǝmtad dǝ Zǝran Yesu Kǝristi Yaazhgǝlamiyama, uuda jiirjiir nǝ iina.<verse eid="1CO 1:9"/></para>
  <para style="s">Tagwazhatagwazha ma lii gatǝga</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10"/>Ən ghaalakuram zaarabahara, mbakyarvad ɗaaga Yaazhigǝl Yesu Kǝristi, haiyamanthaig dǝ zaraabaharuwa, aandz maay nǝ tagwazhatagwazh ma taatakaru biya, am dzant kǝ ghǝraru vak palla, dzamaghǝraru ndakwi vak palla. <verse eid="1CO 1:10"/><verse number="11" style="v" sid="1CO 1:11"/>Zaraabahara, aɗaba taghwatag nǝ lii ma hǝnyaha kuluwi taakiya, mǝng nǝ mbaɗaghai ma taatakaruwa. <verse eid="1CO 1:11"/><verse number="12" style="v" sid="1CO 1:12"/>Dǝgiti ǝn tlǝtlǝg nai, iin taakiya, ma kwararuwa taa dǝgaan shahha, kwan taakiya, “Ən dǝga Bulus naiya,” kwan taakiya,“Ən dǝga Afulus naiya, ” kwan taakiya “Ən dǝga Kefasa, ” kwan dlaɓa taakiya, “Ən dǝga Kǝristi naiya <verse eid="1CO 1:12"/><verse number="13" style="v" sid="1CO 1:13"/>Mbats tagwavǝmtagw nǝ tlǝkatǝg shahshaha? Əmtsaǝmtsǝg Bulus tǝ tlaɓa hǝrtǝg kwakyarvad kuurama? Nii ɓaga kuura dǝ ɗaaga Bulus ha nǝ-uud kǝ tsufǝgi? <verse eid="1CO 1:13"/><verse number="14" style="v" sid="1CO 1:14"/>Ən tagar uus kǝ Daadamazhigǝl ɓaganarai aandzu war makuuram kǝ tsufǝg biya, ba kiribus ard gayus. <verse eid="1CO 1:14"/><verse number="15" style="v" sid="1CO 1:15"/>Mbakyarvad kwaha maiy watag da tag takiya ɓagakuura dǝ ɗaagar nǝ uud kǝ tsuufǝg biya. <verse eid="1CO 1:15"/><verse number="16" style="v" sid="1CO 1:16"/>Dzamanadzamǝga ɓaganara ɓag ɗlab kǝ yaha istafanus kǝ tsuufǝga, ma juujǝg ba kǝ yaha Istafanusa maay nǝ uudahii tlǝr ɓagantǝra naiy biya. <verse eid="1CO 1:16"/><verse number="17" style="v" sid="1CO 1:17"/>Ɓǝlakutbi nǝ yesu mbakyarvad tsuufǝg biya, ɓǝlakut mbakyarvad taa ǝlbǝg marawa, ɗlaba dǝ dabariya uuda dǝg shig biya. Aɗaba aada pǝlwai nǝ nǝghǝgga ndangngǝra ǝmtsǝga yesu tǝ tlaɓa hǝrtǝg biya.<verse eid="1CO 1:17"/></para>
  <para style="s">Tlǝkatǝga ndzǝɗa Daadamazhigǝla ard dabariyana</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18"/>Əlbǝga hǝrtǝga, ǝlbǝga ghwaɗ nǝ iin vak lii gata duula ǝmtsǝga, aɗaba vaka miyamǝn katakiyamǝtkatǝg nǝ uudna,ǝlbǝga katǝga ndzǝɗa Daadamazhigǝla. <verse eid="1CO 1:18"/><verse number="19" style="v" sid="1CO 1:19"/>Aɗaba viinɗa viinɗan taakiya,“Ənda badzǝgaan kǝ dabariya lii taaki ar mǝng dǝ dabariya.” <verse eid="1CO 1:19"/><verse number="20" style="v" sid="1CO 1:20"/>Aitsa mǝr nǝ lii ɗǝ dabariyǝni? Ar mǝr nǝ lii taakiya ar tsaga adzahadzahi? Ar mǝr nǝ lii taakiya ar sǝrgasǝrg kǝ dǝgitah baɗǝmni? Mbats maradai nǝ Daadamazhigǝl taakiya, dyǝmdyǝma lii dǝ dabariya kwan kǝ duniya ba ɗlagǝr nǝ iina. <verse eid="1CO 1:20"/><verse number="21" style="v" sid="1CO 1:21"/>Aɗaba ma tag nǝ dabariya Daadamazhigǝla, uudaha duniya ar sǝrgai kǝ Daadamazhigǝl tǝdvad dabariya biya. Dlakulvakwaha, dzǝghakakadzǝrg nǝ Daadamazhigǝl kǝ lii da katǝg nǝ iin kwa fardǝghǝrtfǝg tǝ iin tǝdvad taa ǝlbǝg marawa kwa ma zharg nǝ uud maay nǝ tlǝrani. <verse eid="1CO 1:21"/><verse number="22" style="v" sid="1CO 1:22"/>Yahudaha ar na ma marvǝtǝrdan nǝ dǝga sǝrga, helenaha dlaɓa ar gata sǝrga dabariya. <verse eid="1CO 1:22"/><verse number="23" style="v" sid="1CO 1:23"/>Kǝm taa ǝlbǝg marawa tlǝkatǝga kwa ǝmtsan tǝ tlaɓa hǝrtǝga kwa nal kǝ ɗuula mbǝɗǝg kǝ yahudaha, ɗlaba dǝga dlagǝr vak lii ar yahudah biya. <verse eid="1CO 1:23"/><verse number="24" style="v" sid="1CO 1:24"/>Ndzǝɗa ard dabariya Daadamazhigǝl nǝ tlǝkatǝg da vak lii ar yahudaha ard kwa yahudah biya, <verse eid="1CO 1:24"/><verse number="25" style="v" sid="1CO 1:25"/>Adaɓa dǝgiti ma zharga nǝ uud mandki dlagǝr wa ɓaga nǝ Daadamazhigǝla, juujig kǝ dabariya uuda, dǝgiti ma tlatlǝg nǝ uud hǝtsalhǝtsǝg nǝ Daadamazhigǝla juujig nǝ iin kǝ ndzǝɗ uud baɗǝmma, <verse eid="1CO 1:25"/><verse number="26" style="v" sid="1CO 1:26"/>Dzamamnadzamǝg kǝ ndzǝganaru ma sartǝn ɗahakurt nǝ Daadamazhigǝla, ba kyǝkwah ma kuuram nǝ lii dǝ dyǝmdyǝma ma zharǝg nǝ uudaha, bakyǝkwah dlab makuuram nǝ lii hǝkya kwarǝg ɗyaka, bakyǝkwah nǝ zarha lii ɗyaɗyaka. <verse eid="1CO 1:26"/><verse number="27" style="v" sid="1CO 1:27"/>Kǝsghaakakǝsǝg nǝ Daadamazhigǝl kǝ dǝgiti tlatlǝg nǝ uud taakiya dlagǝra, adaba tsǝtǝra kǝ zhirw kǝ lii dǝ dabariya duniya, kǝsghaka kǝsǝg nǝ Daadamazhigǝl kǝ dǝgiti zharg nǝ uudah mandki hǝtsalhǝtsǝg nǝ iina, aɗaba tsǝtǝra ku zhiruw kǝ lii dǝ ndzǝɗa. <verse eid="1CO 1:27"/><verse number="28" style="v" sid="1CO 1:28"/>Dǝgiti kǝsghant nǝ uud mandki maay dǝ ndangbiya, aandzu maay tlǝraniya, aandzu kwa maay nǝ dǝgiti tukvakaibiya, iin wa ɓag nǝ Daadamazhigǝl kǝ tlǝr dǝvakai kiyava ɗlagnan kǝ dǝgiti zharg nǝ uud mandki mǝng tlǝrana. <verse eid="1CO 1:28"/><verse number="29" style="v" sid="1CO 1:29"/>Bagaɓag nǝ Daadamazhigǝl kwanahaan baɗǝmma haik naaghǝr kǝ uudaha dǝgshiga tǝvuukwa Daadamazhigǝla. <verse eid="1CO 1:29"/><verse number="30" style="v" sid="1CO 1:30"/>Daadamazhigǝl wa fafǝg kwa namal nǝ uuram kǝ dǝga tlǝkatǝg yesu, Daadamazhigǝl dlab wa haighant haig kǝ tlǝkatǝga nal kǝ dabariyamiyama. Tlǝyamkǝna tǝdvad iin nǝ miyam kǝ jira Daadamazhigǝla ard katǝgana. <verse eid="1CO 1:30"/><verse number="31" style="v" sid="1CO 1:31"/>Mbakyarvad kwaha, band kwa viindviidan ma kakaɗa Daadamazhigǝl taaki,“Baɗǝm dadda kwa tsa kusgha aa ɓag bat yaazhigǝla.”<verse eid="1CO 1:31"/></para>
  <chapter eid="1CO 1"/>
  <chapter number="2" style="c" sid="1CO 2"/>
  <para style="s">Əlbǝg tǝghǝr kǝ tlǝkatǝga kwa hǝrtavǝthǝrtǝga</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1"/>Ma sarta kwa danǝvnai da vakaru da tagakur ǝlbǝga Daadamazhigǝlǝn zaraabahaara, tagankur bi nai dǝ sǝrgasǝrgǝra ard markura dabari biya. <verse eid="1CO 2:1"/><verse number="2" style="v" sid="1CO 2:2"/>Adaba nguɗanant nguɗǝg ma ǝrvǝdmahudɗar taakiya, ma sartǝn ǝn da ndzǝga nai ǝmtad dǝ kuuramna, ǝn da maay tsagkur aandzu ndau biya, ba ǝlbǝg tǝghǝr kǝ yesu tlǝkatǝga,kwa hǝrtavǝt hǝrtǝga. <verse eid="1CO 2:2"/><verse number="3" style="v" sid="1CO 2:3"/>Sagawar ba zǝngw da vakaruuwa ǝn maay ndzǝd biya, tǝg nǝ vǝghara mbakyavad ɗlaɗlawura. <verse eid="1CO 2:3"/><verse number="4" style="v" sid="1CO 2:4"/>Əlbǝgara ard ǝlbǝg marawa dzavǝmbi nǝ iin dǝ pattakurama ma markuura dyǝmdyǝmǝr biya,bamma aa ndzǝvǝm dǝ ndzǝɗa shiɗkwa caccuwanacaccuwana, <verse eid="1CO 2:4"/><verse number="5" style="v" sid="1CO 2:5"/>Adaba haik fadghǝr kǝskuuram tǝ dabariya uudaha, bamma tǝ ndzǝɗa Daadamazhigǝla.<verse eid="1CO 2:5"/></para>
  <para style="s">Dabariya Daadamazhigǝla</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6"/>Bakǝvakwaha kǝm taa ǝlbǝg dǝ dabari kǝ lii ghubarara ghbarg ma fadghǝratǝra, iin wa dabariya hulfakwan kǝ zaman biya, ɗlaɓa dǝ dǝga hulfa lii kwara kwan kǝ zaman kwa da mǝng ghaala kwargatǝr biya. <verse eid="1CO 2:6"/><verse number="7" style="v" sid="1CO 2:7"/>Kǝm taa ǝlbǝga dabariya Daadamazhigǝl shǝɓashǝɓan, dabaritan kwa ndza shǝɓashǝɓan ba wura, iin dabariya Daadamazhigǝl kwa fa nǝ iin ba wurwura lakwti kǝ fazha duniya adaba fǝkiyamara nǝ uuda. <verse eid="1CO 2:7"/><verse number="8" style="v" sid="1CO 2:8"/>Ma lii kwara zaman ndakwana maay wa da nǝghǝgaka nǝghǝg kǝ dabariyan biya, akwama nǝgharaaka nǝ iitǝra, maa hǝrtarǝt bi kǝ yaazhǝgǝl ǝmkyadyǝk biya. <verse eid="1CO 2:8"/><verse number="9" style="v" sid="1CO 2:9"/>Band kwa viindaviindan taakiya,“Baɗǝm nǝ dǝgiti fatǝra nǝ Daadamazhigǝl kǝ lii waig nǝ iina maay nǝghanǝghǝg biya, maay nǝ daadakwa tapghani tapǝg kǝ cǝngacǝng biya , dlaɓa maay nǝ daadakwa tapghana kǝ dzamaghǝr tǝghǝr biya. <verse eid="1CO 2:9"/><verse number="10" style="v" sid="1CO 2:10"/>Marakiyamnda marǝg nǝ Daadamazhigǝl kǝ kwanahaan kǝ dǝgitah tǝdvad shidkwan cacuwana cacuwana, adaba shidkwa cacuwana cacuwanan wa gata shiga dǝgita,baz dǝgaha Daadamazhigǝl kwa ɗǝmɗǝm kǝ nǝghǝgaka nǝghǝga. <verse eid="1CO 2:10"/><verse number="11" style="v" sid="1CO 2:11"/>War wa sǝrgasǝrg kǝ dǝgiti ma ǝrvidmahuɗa uudan ma maay ba iin dǝ ghǝranbiyi? Bandkwah dlaɓa, maay wa nǝghǝgakanǝghǝg kǝ dzamaghǝra Daadamazhigǝl biya bama iin dǝ ghǝraana. <verse eid="1CO 2:11"/><verse number="12" style="v" sid="1CO 2:12"/>Cauwamnda shidkwa duunibi nǝmnd biya, cauwamnda shikwa cacuwana cacuwana vak Daadamazhigǝla, kiyava nǝghǝgakanǝghǝg kǝskǝmnd kǝ dǝgitahi vǝlakǝmnd ba gyagyaana. <verse eid="1CO 2:12"/><verse number="13" style="v" sid="1CO 2:13"/>Kǝm tagkur kwanaahaan kǝ dǝgitaha, dǝ ǝlbǝgahi tsagav dǝ dabariya uudbiya, kǝm tag dǝ shidkwa caccuwanacaccuwana, tǝdvad taa dǝgahaa shidkwa cacuwanacacuwan kǝ lii dǝgaha shidkwa caccuwanacaccuwana. <verse eid="1CO 2:13"/><verse number="14" style="v" sid="1CO 2:14"/>Daddakwa shidkwa Daadamazhigǝlbi wa ɓa tlǝr dǝvakai biya, maay cauwa dǝgaha shidkwa caccuwanacaccuwana Daadamazhigǝli, adaba ɗlagǝr wahiin vakana, da nǝghǝgaaka biya, adaba nǝghvaka tǝdvad shidkwa Daadamazhigǝl nǝ dǝgitaha, <verse eid="1CO 2:14"/><verse number="15" style="v" sid="1CO 2:15"/>Daddakwa shidkwa Daadamazhigǝl wa ɓa tlǝr dǝ iina, tlatlǝna tlatlǝg kǝ dǝgitaha baɗǝmma,maay wa tsagarnǝstsag biya. <verse eid="1CO 2:15"/><verse number="16" style="v" sid="1CO 2:16"/>“Warwa sǝrga sǝrgasǝrg kǝ dzamaghǝra yaazhigǝl kwa da tsagarutsagi?” Dzamaghǝramiiyam kǝskǝmyama dǝga tlǝkatǝga.<verse eid="1CO 2:16"/></para>
  <chapter eid="1CO 2"/>
  <chapter number="3" style="c" sid="1CO 3"/>
  <para style="s">Tsaghwaha ɓa tlǝra Daadamazhigǝla</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1"/>Zaraabahara, ǝn tagkur da bi nai kǝ ǝlbǝg band kwa ǝn tagtǝr nai kǝ lii dǝ shidkwa Daadamazhigǝl biya,bamma band uudaha duniya, band zarhah vuunj ma gata tlǝkatǝga, <verse eid="1CO 3:1"/><verse number="2" style="v" sid="1CO 3:2"/>Gǝlankur gǝlǝg nai dǝ ghwaya watla, dǝ kaffi kwa dǝk dǝk biya aɗaba tlamalbi kǝ zaa kaffi dǝk dǝk biya, bakǝvakwaha tlamalbiya. <verse eid="1CO 3:2"/><verse number="3" style="v" sid="1CO 3:3"/>Adaba gwastǝna am ba ɗlab ɓa dǝgiti naag nǝ vǝghǝgha, akwama am ba ɗlab ɓa shǝlgakava, am uushava dǝ zaraabaharuwa, mbats am ba ɗlab ɓa dǝgiti naag nǝ vǝghǝgha biya, adaba am ɓa tǝrahi naag nǝ vǝghǝgha. <verse eid="1CO 3:3"/><verse number="4" style="v" sid="1CO 3:4"/>Mbakyarvad kwaha akwama tagatag nǝ uudan taaki, “Ən dǝga Bulus naiy amaa,” kwatlǝrn ɗlaɓ taaki ,“ Ən dǝga Afullus amaa,” mbats tlǝra vǝghǝg wam marg nǝ uuram biya? <verse eid="1CO 3:4"/><verse number="5" style="v" sid="1CO 3:5"/>War nǝ Afullusini? War nǝ Bulusi? Mbats ba lii ɓa tlǝr kalti biya, kwa famdǝghǝrt nǝ uuram tǝdvad iitǝrya, ma kwaraatǝra bad hulfa tlǝri aa vǝlgar nǝ yaazhigǝlan biya? <verse eid="1CO 3:5"/><verse number="6" style="v" sid="1CO 3:6"/>Riiyanariig naiya, pǝdghar yu nǝ Afullusa, ba Daadamazhigǝl wa da fǝgara ghubarg kǝ dǝgiti aa riiva riiga. <verse eid="1CO 3:6"/><verse number="7" style="v" sid="1CO 3:7"/>Mbakyarvad kwaha daddakwa riiga dǝ riiga, ard daddakwa pǝdghar yuwa maay nǝ dǝgiti tuuk vakai nǝ iitǝr biya, bamma Daadamazhigǝl pall kwa fǝghara ghubarǝg kǝ dǝgiti aariivana. <verse eid="1CO 3:7"/><verse number="8" style="v" sid="1CO 3:8"/>Dadda riiga, ard dadda kwa pǝdghar yuwa ba tlǝraatǝr palla, aɗaba ma kwaratǝra da tlǝkǝnatlǝg kǝ dǝgshiga tlǝraana. <verse eid="1CO 3:8"/><verse number="9" style="v" sid="1CO 3:9"/>Adaba kǝm tsahwahaha ɓa tlǝra Daadamazhigǝl nǝmnda, kuurama am guuha Daadamazhigǝla dlaɓa ndǝrgaana. <verse eid="1CO 3:9"/><verse number="10" style="v" sid="1CO 3:10"/>Tǝdvad herǝrra Daadamazhigǝl kwa vǝlghwa nǝ iina, fanarzhafǝg kǝ ndǝrg band daddakwa dyaghǝ kǝ ndǝrga, kwatlǝrn dlaɓa ndǝrg tǝghǝraana. Barari kǝ dadda ndǝrg fa hyǝmiya tǝ hulfa ndǝgi kwa da fǝgara nǝ iin tǝghǝra. <verse eid="1CO 3:10"/><verse number="11" style="v" sid="1CO 3:11"/>Adaba maay nǝ dadda kwa da fǝgaraa kwatlǝr kǝ ndǝr shah kwa juujig kwa fǝvanǝn biya, kwa iin nǝ Yesu Tlǝkatǝga. <verse eid="1CO 3:11"/><verse number="12" style="v" sid="1CO 3:12"/>Akwama ndǝrandǝrg nǝ uudan da tǝghǝr kwa favarzhan dǝ adawanna, aandzu ma agwallela ma dǝ akurahi kwa ndanga, ma dǝ dakara ma dǝ kazhakwa aandzu dǝ ghuuva, <verse eid="1CO 3:12"/><verse number="13" style="v" sid="1CO 3:13"/>Da nǝghǝva nǝghǝga nǝ tlǝra aandzu kwar kǝ dadda ndǝrga, da marazha sagal daghuvalana, adaba da marava dǝ kara aandzu tlǝra wara, dlaɓa kaar wa da sǝra tlǝri ɓaga nǝ uudana. <verse eid="1CO 3:13"/><verse number="14" style="v" sid="1CO 3:14"/>Akwama ngǝrɗǝtbi nǝ ndǝrgǝn favara dat ghǝr kwa favarzhanǝn biya, daddakwa ɓaga kwan kǝ ndǝrga da tlǝkǝnatlǝg kǝ dǝgshigaana. <verse eid="1CO 3:14"/><verse number="15" style="v" sid="1CO 3:15"/>Akwama ngǝrɗǝt ngǝrɗǝg nǝ tlǝriina, daddakwa ndǝrgiina da huɓǝgan kǝ dlaɗa aandzu ba da tlǝkǝnatlǝg kǝ katǝga, band daddakwa dǝgal matataka kaara. <verse eid="1CO 3:15"/><verse number="16" style="v" sid="1CO 3:16"/>Mbats amm sǝrgai taaki am guda Daadamazhigǝl nǝ uuram biya, dlaba shidkwa Daadamazhigǝl wa ndzǝga makuuram biya? <verse eid="1CO 3:16"/><verse number="17" style="v" sid="1CO 3:17"/>Baɗǝm nǝ daddakwa badzǝda guda Daadamazhigǝla, da badzǝgaan dlab nǝ Daadamazhigǝl kǝ iina adaba guda Daadamazhigǝla cacuwana cacuwanan nǝ iina, ɗlaba kuuram nǝ gudiina. <verse eid="1CO 3:17"/><verse number="18" style="v" sid="1CO 3:18"/>Aa valdabi nǝ uudan kǝ ghǝrani, akwama tlǝtlǝgaan nǝ uudan ma ghǝran taaki dadda dabari nǝ iin hulkwa dǝvakai nǝ duniya, aa nǝdal nǝg kǝ ghǝran band dlaga mbakyarvad nal kǝ dadda dyǝmdyǝma. <verse eid="1CO 3:18"/><verse number="19" style="v" sid="1CO 3:19"/>Adaba dyǝmdyǝma kwan kǝ duniya dlagǝr vak Daadamazhigǝla, mbakyarvad viinda viindan taakiya, “viigan kǝ lii dǝ dabariya baz dyǝmdyǝmatǝra.” <verse eid="1CO 3:19"/><verse number="20" style="v" sid="1CO 3:20"/>Viindaviindan dlab ma kakkaɗa Daadamazhigǝl taakiya, “Sǝrgasǝrga nǝ yaazhǝgǝl kǝ dzamaghǝra yaa daddaha kwad dabariya taaki maay nǝ tlǝraani.” <verse eid="1CO 3:20"/><verse number="21" style="v" sid="1CO 3:21"/>Mbakyarvad kwaha aa tsibi nǝ uudan kǝ kushǝgh dǝ uud biya, adaba baɗǝm nǝ ba dǝgaruwa. <verse eid="1CO 3:21"/><verse number="22" style="v" sid="1CO 3:22"/>Aandzu Bulusa ma Afullusa ma Kǝfasa ma duniya ma shifǝga ma ǝmtsǝga ma dǝgitahi ndakwana aandzu kwa da tǝvuukwa baɗǝm ba dǝgaruu nǝ iina. <verse eid="1CO 3:22"/><verse number="23" style="v" sid="1CO 3:23"/>Adaba am dǝga tlǝkatǝg nǝ uurama, dlaɓa tlǝkatǝga dǝga Daadamazhigǝla,<verse eid="1CO 3:23"/></para>
  <chapter eid="1CO 3"/>
  <chapter number="4" style="c" sid="1CO 4"/>
  <para style="s">Lii ɓa tlǝra tlǝkatǝga</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1"/>Da sǝrkǝmnda ka ǝnkwan nǝ uud kǝm lii ɓatlǝra yaazhǝgǝla, kwavǝlatǝr nǝ Daadamazhigǝl kǝ langyi sǝrga jiirahan kwa shiɓashiɓanna, <verse eid="1CO 4:1"/><verse number="2" style="v" sid="1CO 4:2"/>Adabad kwaha baraari kǝ lii hǝkya langyi ar nal kǝ uudaha jirjiira <verse eid="1CO 4:2"/><verse number="3" style="v" sid="1CO 4:3"/>Dǝgit dyǝk bi vakar ma ba kuuram wam da fǝshakaiya, aandzu mada fǝshakai nǝ uud mat zharga ndzǝgana uud, kai bi wada fǝshaghǝrar biya. <verse eid="1CO 4:3"/><verse number="4" style="v" sid="1CO 4:4"/>Ən sǝrgabi nai mbatak ǝn mǝng dǝ haip biya, bakǝvakwaha nal bi taaki ǝn maay dǝ haip ba lǝngngi lǝng biya, yaazhǝgǝl wada fǝshakaiya. <verse eid="1CO 4:4"/><verse number="5" style="v" sid="1CO 4:5"/>Mbakyarvad kwaha ghudamarbi kǝ shari kǝ uud ma ɓagabi nǝ sart biya, pakamant pakǝga bamma sǝghawisǝg nǝ yaazhǝgǝla. Iin wada marda dǝgitahi shǝɓashǝɓan kwa ma gurtla, da tagdan dlaɓ kǝ dǝgiti tlatlǝg nǝ ǝrvǝdmahuɗuudaha, tǝhalakwah wada caug aandzu ma ba war kǝ kalkala dǝgshǝgaan vak Daadamazhigǝla. <verse eid="1CO 4:5"/><verse number="6" style="v" sid="1CO 4:6"/>Aici zaraabahara, ǝlbǝg tǝghǝr kwanahaana nandal kǝ garav tǝ ghǝrarra ard Afullusa mbakyarvad kǝ uurama, kiyava tsagan kǝskuuram kǝ ǝlbǝg taaga taakiya,“Dzǝvamabi kǝ dǝgiti viindaviivdan biya,” haik tsa kusgha kǝ palla ruwa dǝ kwa tsagu n iin tǝghǝr k uudana. <verse eid="1CO 4:6"/><verse number="7" style="v" sid="1CO 4:7"/>War wa tagaktag taaki juughujig kǝ kyalmahi? <verse eid="1CO 4:7"/><verse number="8" style="v" sid="1CO 4:8"/>Auwa agha dǝvakai nǝng kwa Daadamazhigǝl bi wa vǝlakakvǝlǝg biyi? Akwama bandkwah citsa,aujilbǝg agha naa ghǝr mandki aa vǝlǝk gyagyanbi nǝ uudti? <verse eid="1CO 4:8"/><verse number="9" style="v" sid="1CO 4:9"/>Adaba manzharg naiya, maradamarg nǝ Daadamazhigǝl bat ɓalaɓal taakiya kǝm lii ɓa tlǝra kǝm dǝga halla aandzu ma ƙǝ dǝgita, band lii ghudavtǝrdan sharia ǝmtsǝga, adaba namdalnǝg nǝg nǝmnd kǝ dǝgiti da fǝg nǝ duni kǝ gyi tǝvakai baɗǝm, baz zarha ɓǝlga Daadamazhǝgla ard uudaha. <verse eid="1CO 4:9"/><verse number="10" style="v" sid="1CO 4:10"/>Namdalnǝg kǝ ɗlag mbakyavad tlǝkatǝga, bakǝvakwaha am dǝ dabari nǝ uuram ma tlǝkatǝga! kǝm maay dǝ ndzǝɗ nǝmnd biya kuurama am dǝ ndzǝɗa! fa zhiruw nǝ uud tǝ kuurama, vǝlkǝmnd dlaɗ nǝ uuda! <verse eid="1CO 4:10"/><verse number="11" style="v" sid="1CO 4:11"/>Ndakwana njikǝmnd nǝ waiya ard andǝla, ǝm maay fahaa sǝɗav marawau biya, kalkǝmnd kalǝg nǝ uuda,dlaba kǝm maay dǝ hǝnyah biya. <verse eid="1CO 4:11"/><verse number="12" style="v" sid="1CO 4:12"/>Kǝm ɓa ba tlǝr dǝ ghǝramǝmnda, akwama ɗahakǝmvaɗahǝg nǝ uuda, kǝm fǝtǝra kǝ bark dlakulvana, akwama vǝlakǝmnd vǝlǝg nǝ uud kǝ dlaɗa, kǝm ba ɓǝsgaana. <verse eid="1CO 4:12"/><verse number="13" style="v" sid="1CO 4:13"/>Akwama tagaratag nǝ uudah kǝ dǝga bandza ɗaag tǝ kǝmnda, kǝm tagtǝrda kǝ ǝlbǝg bad ǝmtakǝra. Namndal nǝg nǝmnd band agagava,kwa naabi nǝ uudaha duni biya. <verse eid="1CO 4:13"/><verse number="14" style="v" sid="1CO 4:14"/>Viindankuura viindǝg nai kwana mbakyarvad ǝnfǝkuurdǝm dama zhiruw biya, viindan kuura mbakyavad ǝn ɓǝlkura kǝ magiya adaba am zarharr kwan waitǝr naiya. <verse eid="1CO 4:14"/><verse number="15" style="v" sid="1CO 4:15"/>Aandzu am bad lii tsaga dǝgit ma tlǝkatǝga kwa kǝdlǝvtǝrnabiya, am maay dǝ daadah dyak biya. Ba jijia nanalnǝg nai kǝ daad kǝskuuram ma tlǝkatǝga yesu tǝdvad lang kurda ǝlbǝg marawa. <verse eid="1CO 4:15"/><verse number="16" style="v" sid="1CO 4:16"/>Mbakyarvadkwaha, ǝn ghalaakuurama tsagamtsag dǝ kaiya. <verse eid="1CO 4:16"/><verse number="17" style="v" sid="1CO 4:17"/>Adabadkwaha ɓǝlanant ɓǝlǝg kǝ Timuti zǝrar da vakaruuwa kwan waig naiya, haiyananthaig nai dǝ iin ma yaazhǝgǝla, da dzamkurnǝs dzamǝg kǝ ɗuuli ǝn gatǝg naiy kǝ Tlǝkatǝg Yesu, ard ɗuuli ǝn tsagtǝr nai kǝ dlamakǝlaaa lii gatǝga. <verse eid="1CO 4:17"/><verse number="18" style="v" sid="1CO 4:18"/>Kǝsarantkǝsǝg nǝ kyalmaharu mandki ǝn da maay dagau davakaru biya, baz naa ghǝratǝr kǝ iitǝra. <verse eid="1CO 4:18"/><verse number="19" style="v" sid="1CO 4:19"/>Akwama haighant haig nǝ Yaazhǝgǝla ǝn da zǝlmabi kǝ dagau davakaru biya, ǝn da sǝran kǝ hulfa ndzǝɗi dǝ vakai nǝ lii naa ghǝraatǝrna, kwakyǝ ǝlbǝgahaatǝr biya. <verse eid="1CO 4:19"/><verse number="20" style="v" sid="1CO 4:20"/>Adaba tlǝkǝsa Daadamazhigǝla tǝvaghai biya, bamma tǝ ndzǝɗaana. <verse eid="1CO 4:20"/><verse number="21" style="v" sid="1CO 4:21"/>Aitsa, auwama kǝsgaka nǝ uurami,ǝn dagau davakaru dǝ kiiɓni, nii ǝn markurda kǝ wayakǝvǝrhi?<verse eid="1CO 4:21"/></para>
  <chapter eid="1CO 4"/>
  <chapter number="5" style="c" sid="1CO 5"/>
  <para style="s">Sharia kǝ lii ɓa gwaragwara</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1"/>Ciinganaciing taakiya mǝng nǝ lii ɓa gwaragwar makuurama, hulfa kwa maay ɓagav aandzu ma lii sǝrgai kǝ Daadamazhigǝl biya, mǝng nǝ daddakwa nadal uusa daddaan band uusaana. <verse eid="1CO 5:1"/><verse number="2" style="v" sid="1CO 5:2"/>Baz tǝɗa fǝɗaavǝgh kǝskuurama! mbats, kalkalanbi kǝskuuram un gda ǝrvǝdmahuɗa, am sǝdan kǝ daddakwa ɓa kwa nǝ iin ma kuuram biya? <verse eid="1CO 5:2"/><verse number="3" style="v" sid="1CO 5:3"/>Aandzu ba ǝn maay ǝmtaɗ dǝ kuuram ma ndzǝgana vǝghbiya, ǝn ba ǝmtaɗ dǝ kuuram ma shidkwa cacuwana cacuwana. Ghudanarda ghudǝg nai kǝ sharia kǝ dadda ɓa kwan kǝ dǝgita ma ɗaaga Tlǝkatǝg Yesu aandzu ban maay ǝmtaɗ dǝ kuuram biya. <verse eid="1CO 5:3"/><verse number="4" style="v" sid="1CO 5:4"/>Akwama dǝ dzahamvǝt dzahǝga ǝn ba ǝmtaɗ dǝ kuurama, ard ndzǝɗa Tlǝkatǝg Yes, <verse eid="1CO 5:4"/><verse number="5" style="v" sid="1CO 5:5"/>Am vǝlar kǝ shatanah kǝ uuda nǝ iina, aandzu ba badzada badzǝg nǝ shatanah kǝ vǝgha uuda nǝ iina, da katav nǝ shifǝgaan davala fachiya Tlǝkatǝga. <verse eid="1CO 5:5"/><verse number="6" style="v" sid="1CO 5:6"/>Tsa kushǝghǝn am ɓag nǝ uuramna dǝgit maraw biya, mbats am sǝrga biya, abi zǝr yist ba ǝnkyakwah wa fǝgara kuburǝg kǝ bruudiya? <verse eid="1CO 5:6"/><verse number="7" style="v" sid="1CO 5:7"/>Samdasǝg kǝmghura yista aa haipa kiyava nǝg kǝ daala bruudi, ba jirjira band kwaha. Aɗaba ɓagava ɓag nǝ kyulǝga Zǝra Mbakǝllaka kiyava hwaɗaga haara kǝssa ndzava hǝnyaha, iin nǝ Tlǝkatǝga. <verse eid="1CO 5:7"/><verse number="8" style="v" sid="1CO 5:8"/>Mbakyarvad kwaha ɓagiyamɓag kǝ hwaɗaga haara kǝssamiiyama, dǝ bruudi kwa dǝ ǝnghura yist ma vakai biya, kwa dǝga naiy kǝ uuda ard dǝga ɓa kǝladǝr biya, bamma dǝ bruudi kwal yista kwa iin ɓa jirjira ard haigant haiga. <verse eid="1CO 5:8"/><verse number="9" style="v" sid="1CO 5:9"/>Viindankura viindǝg ma wakitar taakiya haɗambi ghǝr dǝ lii ɓa gwaragwar biya, <verse eid="1CO 5:9"/><verse number="10" style="v" sid="1CO 5:10"/>Ən taa kǝ hulfa gwaragwara kwan kǝ duni biya, ma lii ɓa dlǝrmǝga, ma lii ɓa gǝlla, ma lii ɓagarnǝs kwatǝnahǝr ghǝllaha. Akwama bandkwaha barari am sagal ma tlǝra duniya. <verse eid="1CO 5:10"/><verse number="11" style="v" sid="1CO 5:11"/>Ən viindkur kwan nai taakiya haɗambi kǝ ghǝr aandzu kwar kǝ zǝraabi kwa gata Yesu ma ba ɓa gwaragwariya, aandzu dadda dlǝrmǝg biya, ma dadda ɓagar kwatǝnahǝr ghǝlla, ma daddakwa ɗavaɗava, ma dadda huɓa kya , ma dadda ɓa gǝlla, zambi kǝ kaf dǝ hulf kwan kǝ uudah biya. <verse eid="1CO 5:11"/><verse number="12" style="v" sid="1CO 5:12"/>Au lambar dǝ tǝtǝr shari kǝ lii ar dǝgamiiyambiyi? Am da tǝtǝr bak zaraabahamiyam lii gatǝg nǝ uuram kǝ shari biya? <verse eid="1CO 5:12"/><verse number="13" style="v" sid="1CO 5:13"/>Daadamazhigǝl wada tǝtǝr shari kǝ lii dǝgamiiyam biya, lagwamdalagw kǝ kǝlaadin makuurama.<verse eid="1CO 5:13"/></para>
  <chapter eid="1CO 5"/>
  <chapter number="6" style="c" sid="1CO 6"/>
  <para style="s">Aa ɗiiyar bi nǝ yaa dadda gatǝg kǝ ghuunja zaraabahatǝ biya</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1"/>Akwama mǝng ma kuuram kwa na da ɗiiya ghuunja zǝraabana, mbats, dǝga zhiruw bi kǝ iin langan da vaka taa shari kwar yaa dadda gatǝgǝn biya, ma marau lang davak yaa dadda gatǝg nǝ iin biya? <verse eid="1CO 6:1"/><verse number="2" style="v" sid="1CO 6:2"/>Mbats, am sǝrgabi taakiya yaa daddaha gatǝg nǝ lii da tǝtǝr shari kǝ duni biya? Akwama ba kuuram wada tǝgar shari kǝ duni tsautsa , am tǝgai kǝ shari tǝghǝr kǝ dǝgitahan ǝnkyǝkwahahaan biya? <verse eid="1CO 6:2"/><verse number="3" style="v" sid="1CO 6:3"/>Amm sǝrgabi taakiya kǝmyam wada tǝtǝr shari kǝ zǝrɓǝlgaha Daadamazhigǝl biya? Kyakaɗava dǝgitahi ma kwan kǝ duuniyi kaciya? <verse eid="1CO 6:3"/><verse number="4" style="v" sid="1CO 6:4"/>Akwama dzǝghadzǝg nǝ hulfa kwanahaan dǝ kuurama, aujibǝg am lang davak kwa yaa daddaha gatǝn biyi? <verse eid="1CO 6:4"/><verse number="5" style="v" sid="1CO 6:5"/>Taganɗatag nai kwana mbakyavad am dǝm dama zhiruwa, aitsa, maay aandzu pal makuuram nǝ daddakwa dǝ dabari kwada ɓadlǝna ɓadlǝg ndzǝgana zǝraaba ard zǝraab biya? <verse eid="1CO 6:5"/><verse number="6" style="v" sid="1CO 6:6"/>Aujibǝg kaci kǝ dadda gatǝg ɗiiya ghuunja zǝraaban da dama guda taa shari, kwa tǝvuukwa yaa daddaha gɑtǝg biyi! <verse eid="1CO 6:6"/><verse number="7" style="v" sid="1CO 6:7"/>Diiya ghuunja zaraabaha ruwǝn am ɓag nǝ uuram na, abi hǝtsamal hǝtsǝg nǝ uuram ǝndkwahiina, ngulǝm am fak kǝ huɗa zǝkuruu nǝ uud biya, dlaɓa am fa kǝ huuɗa aandzu ma hutsakurvahutsǝg nǝ uud kǝ dǝgahaaru biya? <verse eid="1CO 6:7"/><verse number="8" style="v" sid="1CO 6:8"/>Iin wan kwana, bakura kuurama am za dǝga zaraabaharuwa, am hǝkya dǝga uudaha, baz dǝga zaraabaharuwa! <verse eid="1CO 6:8"/><verse number="9" style="v" sid="1CO 6:9"/>mbats, am sǝrgai taakiya lii maay ɓa dǝga jirjir biya ar da dǝgaabi dama tlǝkǝsa Daadamazhigǝl biya? Aa valkurdabi nǝ uud biya adaba maay nǝ lii ɓa gǝlla, ard lii ɓagarnǝs kwatǝnahǝr kǝ ghǝlaha, ard lii ɓa gwaragwara, aadzu ghulvahi hǝnna dǝ zǝraabatǝr ghulva, <verse eid="1CO 6:9"/><verse number="10" style="v" sid="1CO 6:10"/>Ma gǝllaha, ma lii dlǝrmǝga, ma lii tsǝtǝr nǝ kya, ma lii ɗavaɗaava, ma lii pǝrɗa dǝguuda, maay aandzu pallatǝr kwa da daadama tsǝkǝsa Daadamazhigǝla. <verse eid="1CO 6:10"/><verse number="11" style="v" sid="1CO 6:11"/>Ndza bandkwaha nǝ kyalmaharu wurra, ndakwana barakuraka barǝg nǝ uuda, fakurafǝg nǝ uud ba cadlǝdlǝ tǝvuukwa Daadamazhigǝla, dlǝɓa ngǝdlakura ngǝdlǝg nu uud sagal ma haipahahu tǝvuukwa Daadamazhigǝla ma ɗaaga Yaazhǝgǝla Yesu Tlǝkatǝga, ard shidkwa Daadamazhigǝla miiyama.<verse eid="1CO 6:11"/></para>
  <para style="s">Galamgalǝg kǝ Daadamazhigǝl dǝ vǝgharuuwa</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12"/>“Haighwanthaig nǝ uud kǝ dǝgitsh baɗǝmma” dlaɓa baɗǝm bi nǝ dǝgitah kwa mǝng nǝ tlǝran biya, “Haighwanthaig nǝ uud, kǝ dǝgitah baɗǝmma”, ǝn nǝgalbi kǝ Eva aandzu ma bau biya. <verse eid="1CO 6:12"/><verse number="13" style="v" sid="1CO 6:13"/>“Tavatǝg nǝ kaffa mbakyarvad huuɗɗa, huuɗ dlaɓa mbakyarvad kaffa,” ba Daadamazhigǝl wa da ghyǝhtǝrghyǝhga ba bǝrkuɗa, ɓagava mbakyarvad gwaragwar nǝ vǝghǝ biya, mbagava mbakyǝ tlǝkatǝga, tlǝkatǝg dlaɓa mbakyarvad vǝghǝgha. <verse eid="1CO 6:13"/><verse number="14" style="v" sid="1CO 6:14"/>Ciighant ciig nǝ Daadamazhigǝl kǝ Yaazhǝgǝl ma gǝtlaha, bandkwah dlaɓ nǝ miiyama da ciikiyamciig nǝ uud tǝdvad ndzǝɗaana. <verse eid="1CO 6:14"/><verse number="15" style="v" sid="1CO 6:15"/>Mbats, am sǝrgabi taakiya vǝghǝghaharuwa uuɓiyaha tlǝkatǝg biya? Ən haigant biya, ǝn kǝsant kǝ uuɓiyaha tlǝkatǝga ǝn nǝdal kuuɓiya karuu biya. <verse eid="1CO 6:15"/><verse number="16" style="v" sid="1CO 6:16"/>Am sǝrgai taakiya baɗǝm daddakwa matlǝgant vǝghǝghan dǝ karuuwa naral nǝg kǝ vǝghǝ pall biya? Aɗaba viindaviindan ma kakkaɗa Daadamazhigǝl taaki, “Ba bǝrkuɗatǝra naralnǝg kǝ vǝghǝ palla.” <verse eid="1CO 6:16"/><verse number="17" style="v" sid="1CO 6:17"/>Baɗǝm nǝ daddakwa matlǝghant matlǝg kǝ ghǝran dǝ tlǝkatǝga naralnǝg kǝ ma shidkwa cacuwana cacuwananna. <verse eid="1CO 6:17"/><verse number="18" style="v" sid="1CO 6:18"/>Duwamars ɗuug kǝ ɓa gwaragwara! baɗǝm nǝ haipi ɓag nǝ uuda dzavǝmbi dǝ vǝghanbiya, aɗaba dada gwaragwara ɓagar haip kǝ ghǝraana. <verse eid="1CO 6:18"/><verse number="19" style="v" sid="1CO 6:19"/>Am sǝrga bi taakiya vǝghǝgharuwa guda shidkwa cacuwana cacuwananna kwa makurama , dlaɓa vak Daadamazhigǝl biya? Kuuram bi wam dǝ ndzǝɗ tǝ ghǝraruu biya. <verse eid="1CO 6:19"/><verse number="20" style="v" sid="1CO 6:20"/>Sǝgwara dǝ sǝɡw nǝ uuda pǝlavapǝlǝga. Mbakyarvad kwaha galamgalǝg kǝ Daadamazhigǝl dǝ vǝgharuwa.<verse eid="1CO 6:20"/></para>
  <chapter eid="1CO 6"/>
  <chapter number="7" style="c" sid="1CO 7"/>
  <para style="s">Dlad tǝghǝr kǝ kǝssa uusa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1"/>Aiciya, tǝghǝr kǝ dǝgiti viindama nǝ uurama, ɓagaɓag kǝ maraw ndzan nǝ uud kwal kǝssuusa. <verse eid="1CO 7:1"/><verse number="2" style="v" sid="1CO 7:2"/>Aɗaba haik ɓa gwaragwar kǝskuurama, ma kwar kǝ ghulva aa kǝssǝg kǝ uusaana, bandkwah dlaɓ nǝ uusa aa ndzandzǝg dǝ zhiilaana <verse eid="1CO 7:2"/><verse number="3" style="v" sid="1CO 7:3"/>Aa vǝlarvǝlǝg nǝ zhiil kǝ vǝghaan kǝ uussaana, bandkwah dlaɓ nǝ uusa aa vǝlarvǝlǝg kǝ vǝghaan kǝ zhiilaana. <verse eid="1CO 7:3"/><verse number="4" style="v" sid="1CO 7:4"/>Adaba maay nǝ uus dǝ ndzǝɗ tǝghǝr kǝ vǝghaan biya, bamma zhiilaana, bandkwah dlaɓ nǝ zhiila maay dǝ ndzǝɗ tǝghǝr kǝ vǝghaan biya bamma uussaana. <verse eid="1CO 7:4"/><verse number="5" style="v" sid="1CO 7:5"/>Aa piyardabi nǝ palaru kǝ uud pal biya, bamma am haigant nǝ uuram kǝ tsaha hǝng kiyava fa ndzǝɗ kǝskuuram ma ndzǝgwazhǝgǝla. Tǝhalakwaha am gwiya matlavva, aa valkurdabi nǝ shatanah akwama am maay fa huuɗ biya. <verse eid="1CO 7:5"/><verse number="6" style="v" sid="1CO 7:6"/>Shawari wan vǝlkurnaiya, barari biya. <verse eid="1CO 7:6"/><verse number="7" style="v" sid="1CO 7:7"/>Akwama baɗǝm nǝ uud band kaiya, ma bawara bad vǝlga sǝrgasǝrgi aa vǝlgar nǝ Daadamazhǝgǝlaana kwana vǝlava shah dǝ kwaha. <verse eid="1CO 7:7"/><verse number="8" style="v" sid="1CO 7:8"/>Ma ɓagaɓ kǝ marau maraa ndzan band kai nǝ lii kǝssarubi kǝ uusa ma zhiil biya, ard lii ǝtsahatǝraa nǝ zhiila. <verse eid="1CO 7:8"/><verse number="9" style="v" sid="1CO 7:9"/>Akwama ar fǝgabi kǝ huud biya, aa kǝssar kǝssǝga. <verse eid="1CO 7:9"/><verse number="10" style="v" sid="1CO 7:10"/>Lii kǝssaru kǝssǝga, ǝn tagkurtaga, kai bi wa tagan biya, Yaazhǝgǝl wa tagatag taakiya, aa tagwzha bi nǝ uus dǝ zhiilan biya. <verse eid="1CO 7:10"/><verse number="11" style="v" sid="1CO 7:11"/>Akwama tagwazha tagw dǝ vakaiya, aa gwiya kǝsbi kǝ zhiil biya, aa gwiya dǝg daa da vǝgya zhiilaana, aa gwiya lagw bi nǝ zhiil biya. <verse eid="1CO 7:11"/><verse number="12" style="v" sid="1CO 7:12"/>Tǝghǝr kǝ kyalmah dlaɓa, kai wa tagana, Yaazhǝgǝl biya, akwama mǝng nǝ zǝraab dadda gatǝg kwa dǝ uusi maay gata yaazhǝgǝl biya,haighanthaiga ndzǝrandzǝg ǝmtaɗa,aa lagwda biya. <verse eid="1CO 7:12"/><verse number="13" style="v" sid="1CO 7:13"/>Akwama mǝng dlaɓ nǝ uusa kwad zhiila maay gata Yesu biya, haighanthaig ndzǝra ndzǝg ǝmtaɗa, aa tagwzhabi dǝ vakai biya. <verse eid="1CO 7:13"/><verse number="14" style="v" sid="1CO 7:14"/>Tagandatag naiy ǝndkwaha, aɗaba zhiila kwa maay dǝ fadghǝr biya, ba cuwaɗaɗ nǝ iin tǝdvad ndzǝgan ǝmtaɗ dǝ uusaana, bandkwah dlaɓ nǝ uusi kwa maay dǝ fadghǝr biya ba cuwaɗaɗ nǝ iin tǝdvad ndzǝgan ǝmtaɗ dǝ zhiilaana, akwama maay ǝndkwah biya zarharuwa ar da maay cuwaɗaɗ biya, ndakwana ar da cacuwana cacuwana. <verse eid="1CO 7:14"/><verse number="15" style="v" sid="1CO 7:15"/>Akwamana tagwzh nǝ daddakwa maay gata Yesu dǝ kwa gata Yesu, aa tagwarkǝva tagwa, maay barariya ndzɡan ǝmtaɗ kǝ daddakwa gata Yesu ma ghulva ma uusa dǝ kwa maay gata Yesu biya, aɗaba ɗahakiyamit kiyava ndzǝgana lapiyǝr nǝ Daadamazhigǝla. <verse eid="1CO 7:15"/><verse number="16" style="v" sid="1CO 7:16"/>Kǝgh uusa, agha sǝrgasǝrg mbatak kǝgh wagha da kata zhiilaagha? Kǝgh zhiila, agha sǝrgasǝrg mbatak kǝgh wagha da kata uusaagha?<verse eid="1CO 7:16"/></para>
  <para style="s">Hulfa ndzǝgani naag nǝ Yaazhǝgǝla kǝ ɓagaana</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17"/>Ma bawara aa ɓag kǝ ndzǝgaanan band kwa naag nǝ Yaazhǝgǝla aandzu takwar kǝ ɗuula, kwa ɗaaghant nǝ Daadamazhigǝl kǝ ɓagaana. Adzahadzahi ǝn vǝltǝr naiy kǝ lii gata Yesu baɗǝmma. <verse eid="1CO 7:17"/><verse number="18" style="v" sid="1CO 7:18"/>Baɗǝm nǝ daddakwa ɗaagant nǝ Daadamazhigǝl, kwa ndza ɓagavara ɓag nǝ aghuvaca, agwiya gat bi nal band dadda kwa ɓagavara biya. Kwa ɗaaghant nǝ Daadamazhigǝla, kwa ndza ɓagavarabi nǝ ghuvac biya,aiciya, aa tag bi taaki bamma ɓagavara ɓag nǝ aghuvac biya, <verse eid="1CO 7:18"/><verse number="19" style="v" sid="1CO 7:19"/>Ɓagaɓagan nǝ aghuvaca, ɓagabi nǝ aghuvacbiya,maay nǝ dǝgiti tuukvakai nǝ iini, tsufa adzahadzaha Daadamazhigǝl wa marawa. <verse eid="1CO 7:19"/><verse number="20" style="v" sid="1CO 7:20"/>Ma bawara aa ndzandzǝg ba tǝ dǝgiti ɗahavant nǝ iina, <verse eid="1CO 7:20"/><verse number="21" style="v" sid="1CO 7:21"/>Akwama ndzagha Eva nǝg ma sartakwa ɗahakǝt nǝ uuda, ndavbiya. Magha ba tlǝkǝna tlǝg kǝ ɗuula kwara ghǝragha agha ɓagan kǝ dǝ vakaiya. <verse eid="1CO 7:21"/><verse number="22" style="v" sid="1CO 7:22"/>Baɗǝm nǝ daddakwa ndza Eva nǝ iin,ma sartakwa ɗahghant nǝ Tlǝkatǝga, madlabi nǝ iin Eva biya, dǝga tlǝkatǝg nu iina. Bandkwah dlaɓ nǝ daddakwa ndza ɗahavant ma sarta kwa tlǝkǝnatlǝg nǝ iin kǝ kwara ghǝra, nalnǝg nǝ iin ku Eva Tlǝkatǝga. <verse eid="1CO 7:22"/><verse number="23" style="v" sid="1CO 7:23"/>Sugwakuraa suug nǝ uud ba pǝrra, namal bi kǝ Eva uudah biya. <verse eid="1CO 7:23"/><verse number="24" style="v" sid="1CO 7:24"/>Aici zaraabahhara, ma hulfa kwar kǝ ndzɡan wa ndzamvakai nǝ uudan ma sartakwa ɗahavant nǝ iina, aa ndzandzǝg bandkwh ǝmtaɗ dǝ Daadamazhigǝla.<verse eid="1CO 7:24"/></para>
  <para style="s">Lii kǝsaruubi kǝ zhilla ard kwa rǝruuwa zaalahatǝra</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25"/>Əlbǝg tǝghǝr kǝmghwasahi kǝsaruubi kǝ zhiil biya, tag ghwabi nɪ Yaazhǝgǝl kǝlǝb tǝghǝr kǝ iitǝ biya, ǝn taa dǝgiti ma ghǝrar nai taakiya haiyakuthaig nu uud kǝskaiya, tǝdvad zhǝwaɗaala Yaazhǝgǝla. <verse eid="1CO 7:25"/><verse number="26" style="v" sid="1CO 7:26"/>Manzharg naiya ɓagaɓag kǝ marawa kǝ uudan ndzan bandkwaha kwal kǝsguu uusa, mbakyavad sarta dlaɗ wa ndakwana. <verse eid="1CO 7:26"/><verse number="27" style="v" sid="1CO 7:27"/>Akwama kǝsghuu kǝssǝg kǝ uusa, lagwbi dagal biya, akwama kǝssghuubi kǝ uus biya, kǝsbiya. <verse eid="1CO 7:27"/><verse number="28" style="v" sid="1CO 7:28"/>Adaba dadda kwama kǝssuukǝskǝg ku uusa, haip biya, dlaɓa akwama kǝssuu kǝssǝg nǝ dughwa kǝ zhiila, haip biya. Bakǝvakwaha, baɗǝm nǝ lii ɓagaraɓag kǝ auraiya ar da huɓa dlaɗa ma ndzǝganatǝra, mana naag nai ǝn ngǝkura sagal ma dlaɗa. <verse eid="1CO 7:28"/><verse number="29" style="v" sid="1CO 7:29"/>Dǝgiti ǝn tlatlǝg nai ǝndkwahiin zaraabahara, adaba hǝrz nǝ sart kǝ ghyǝnnga. Ciigǝt ndakwana,lii ɓagaraɓag kǝ auraiya aa nardalnǝg kǝ ghǝratǝr band lii ɓagarai kǝ aurai biya. <verse eid="1CO 7:29"/><verse number="30" style="v" sid="1CO 7:30"/>Lii dǝ badzǝga ǝrvǝdmahuɗa aa naralnǝg band lii ar maay dǝ badzǝga ǝrvǝdmahuɗ biya, lii ar hwaɗag aa naralnǝg band lii ar maay hwaɗag biya, dlaɓa lii sǝgwa dǝgita ar naralnǝg band lii maay aandzu ndaubiya, <verse eid="1CO 7:30"/><verse number="31" style="v" sid="1CO 7:31"/>Lii ɓatlǝr dǝ kadlanga duniya, aa farbi kǝ ghǝr dǝ iitǝr biya,adaba duuniina, da ghyǝngga. <verse eid="1CO 7:31"/><verse number="32" style="v" sid="1CO 7:32"/>Mana naag nai mamma ngǝdlan sagal ma ndzama dǝgitaha. Daddakwa kǝssuubi kǝ uusa nndzama ba ǝlbǝga Yaazhǝgǝl ba vaivaiya, kwa da ciinguciing nǝ Yaazhǝgǝl kǝmtakǝraana. <verse eid="1CO 7:32"/><verse number="33" style="v" sid="1CO 7:33"/>Adaba daddakwa kǝssuukssǝg kǝ uusa ndzamgan kǝ dǝgaha duniya, kwa da fǝgara uusaan kǝ ciinga ǝmtaƙǝraana. <verse eid="1CO 7:33"/><verse number="34" style="v" sid="1CO 7:34"/>Tagwazhztagw nǝ ghǝran hutsǝg buwa, Uusi kwa kǝssuubi kǝ zhiil biya, ma dughwa nǝ iina, ndzama ǝlbǝga Yaazhǝgǝla ba vaivaiya kwa da nǝgalnǝg nǝ iin kǝ cacuwana cacuwanan tǝdvad vǝgha ard gatǝga. Uusi kwad zhiila ndzama dǝgaha duunita, kwa da fǝgara zhiilan kǝ ciinga ǝmtakǝraana. <verse eid="1CO 7:34"/><verse number="35" style="v" sid="1CO 7:35"/>Naa tagkur kwana mbakyavad da mǝlkuru mǝlǝga, kwakyavad ǝn mbukurars biya, adaba ma nal nǝ ndzǝganaru kǝ marauwa, kiyava ɓagarnǝs kwatnahǝr kǝsskuram kǝ Yaazhǝgǝl kwa tagwzhatagw nǝ ghǝraaruuwa. <verse eid="1CO 7:35"/><verse number="36" style="v" sid="1CO 7:36"/>Akwama taatǝg nǝ uudan kǝ langyi dǝ dughwa kwa tlaltlǝg kǝssa zhiila, dlaɓa ma zharg nǝ iina ɓagharai kǝ dǝgit kalkal biya, tǝhalakwa kǝmgan nǝ iin ba vaivaiya, aa kǝssǝga. Ma nalnǝg ndkwaha, haip biya. <verse eid="1CO 7:36"/><verse number="37" style="v" sid="1CO 7:37"/>Ma ndzaghana ndzǝmǝg ma ǝrvǝdmahuɗan taakiya, barari bi kǝ iin kǝssǝgan biya, dlaɓa faɗǝm fǝg ma ǝrvǝdmahuɗan maay kǝssgaan biya, ba kalkalla. <verse eid="1CO 7:37"/><verse number="38" style="v" sid="1CO 7:38"/>Mbakyavad kwaha daddakwa kǝssguu dughwi kwa taa nǝ iin kǝ langyi kǝssgaana, ɓagaaɓag kalkalla. Daddakwa kǝssuubi ma juujig kǝ iina. <verse eid="1CO 7:38"/><verse number="39" style="v" sid="1CO 7:39"/>Aa tagwzabi nǝ uus dǝ zhiilan ma ba dǝ shifǝg biya, akwama ǝmtsaǝmtsǝga nǝ zhiilaana, kǝssgan kǝ zhiili naagant nǝ iin, bama dadda gata Yaazhǝgǝla. <verse eid="1CO 7:39"/><verse number="40" style="v" sid="1CO 7:40"/>Akwama tǝ naagara ,ma da ciinguu ǝnkwaha nǝ iin kǝmtakǝra ma ndzaandzǝg bandkwaha, adaba man zharg naiya ǝn dǝ shidkwa Daadamazhigǝla naiya.<verse eid="1CO 7:40"/></para>
  <chapter eid="1CO 7"/>
  <chapter number="8" style="c" sid="1CO 8"/>
  <para style="s">Dǝg zhǝga kwa vǝlvar kǝ ghǝllah</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1"/>Aiciya, tǝghǝr kǝ dǝg zhǝgi kwa vǝlvar kǝ ghǝlla, kǝyim sǝrgasǝrg baɗǝma miiyama kǝyam ba dǝmdǝmma, dǝmdǝmǝr wa fǝgara naa ghǝr kǝ uuda, wayaakǝvǝra fǝgara sǝrgasǝrgǝra. <verse eid="1CO 8:1"/><verse number="2" style="v" sid="1CO 8:2"/>Baɗǝm nǝ daddakwa zhara taakiya mandki sǝrgasǝrg kǝ dǝgitah baɗǝmma, bakǝvakwana sǝrgai kǝ dǝgiti marauwi biya. <verse eid="1CO 8:2"/><verse number="3" style="v" sid="1CO 8:3"/>Baɗǝm nǝ daddakwa waigan kǝ Daadamazhigǝla, sǝrgasǝrg nǝ Daadamazhigǝl kǝ iina. <verse eid="1CO 8:3"/><verse number="4" style="v" sid="1CO 8:4"/>Aiciya, tǝghǝr kǝ zaa dǝg zǝgi kwa vǝlvar kǝ ghǝlla, kiyam sǝrgasǝrg taakiya, baɗǝm ma duuniya , maay nǝ dǝgita tuukvakai nǝ ghǝllah biya, dlaɓa kiyam taakiya Daddamazhigǝl ba palla, maay nǝ watlǝrn biya. <verse eid="1CO 8:4"/><verse number="5" style="v" sid="1CO 8:5"/>Aandzu ba mǝng nǝ dǝgitahi ɗahvǝtǝr dǝ “daadamazhigǝlah”ma maghǝzhigǝla ard ma duuniya, aɗaba mǝng nǝ daadamazhigǝlaha ard yaazhigǝlah ba dyaka. <verse eid="1CO 8:5"/><verse number="6" style="v" sid="1CO 8:6"/>Bakǝvakwaha, ba pal nǝ Daadamazhigǝl kǝskǝmnda. Kwa iin Daadamazhigǝla Daada kwa baɗǝm nǝ dǝgitah dzǝghar ba vakaana, Kwa kiyam ndzǝgan nǝ miyam kwakyarvad iina, Yaazhǝgǝl ba palla, iin yesu tlǝkatǝga, kwa baɗǝm nǝ dǝgitaha dzǝghar tǝdvad iina, dlaɓa kiyam ndzǝgan tǝdvad iina. <verse eid="1CO 8:6"/><verse number="7" style="v" sid="1CO 8:7"/>Bakǝvakwaha baɗǝm bi nǝ lii sǝrgasǝrg kǝ kwan biya, adaba gwastan ba dlab nǝ lii narǝtnǝg kǝ ɓagarnǝs kwatǝnhǝr kǝ ghǝllaha ar tlatla taakiya dǝgzǝgi ar zǝg nǝ iitǝrna dǝga ghǝlla. Adaba ɓagara bi kǝ ndzǝɗ ndan biya, mar zharg nǝ iitǝra mbaɗarambǝg tǝdvad zaa dǝgzhǝga. <verse eid="1CO 8:7"/><verse number="8" style="v" sid="1CO 8:8"/>Sǝkiyamnda bi nǝ dǝg zǝg hǝrz da tǝvǝgh kǝ Daadamazhǝgǝl biya, aandzu ziyamuu biya, gulkiyama biya, aandzu ma ziyamuuziga fakiyamarna biya. <verse eid="1CO 8:8"/><verse number="9" style="v" sid="1CO 8:9"/>Famfǝg kǝ hyǝmiya aa nalbi nǝ kwara ghǝraru kǝ duula ɓa haip kǝ lii hǝtsahǝtsa nǝ fadghǝraatǝr biya. <verse eid="1CO 8:9"/><verse number="10" style="v" sid="1CO 8:10"/>Adaba ma nǝghǝkak nǝghǝg nǝ kyalma uudah kǝskǝghǝn agha sǝrgasǝrǝg kǝ dǝgitǝn agha zaa kaffa ma guda ghǝllaha, mbats da fǝtrabi kǝ ghǝravatǝr nǝ wan kǝ zaa dǝgzǝg kwa fǝvara kǝ ghǝllah, adaba hǝtsahǝtsan nǝ fadghǝraatǝra biya? <verse eid="1CO 8:10"/><verse number="11" style="v" sid="1CO 8:11"/>Tǝdvad kwaha, sǝrgasǝrgǝraghna da nǝg kǝ duula mbǝɗǝg kǝ zaraaba kwa ǝmtsan nǝ tlǝkatǝg mbakyarvad iina. <verse eid="1CO 8:11"/><verse number="12" style="v" sid="1CO 8:12"/>Akwama ɓagamtǝraɓag kǝ haip kǝ zaraabaharu tǝdvad fǝtǝra ɓa dǝgiti ghwaɗa, amaa ɓagar haip kǝ Tlǝkatǝga nǝ uurama. <verse eid="1CO 8:12"/><verse number="13" style="v" sid="1CO 8:13"/>Mbakyarvad kwaha akwama zaa dǝgzǝg wa da fǝgara zǝraabagh kǝ mbǝɗǝg tǝ duula, ǝn ɗugan kǝ zaa tlǝu haik kǝ mbǝɗǝg kǝ zǝraabar tǝ duula.<verse eid="1CO 8:13"/></para>
  <chapter eid="1CO 8"/>
  <chapter number="9" style="c" sid="1CO 9"/>
  <para style="s">Dǝgshiga lii ɓatlǝra</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1"/>Ən maay naiy dǝ kwara ghǝr biya? Nii ǝn dlakulva gyiya yesu bihi? Nǝghǝghanabi nai kǝ Yesu Yaazhǝl biya? Nii ɗǝg shɪgar ma Yaazhǝgǝl bihi? <verse eid="1CO 9:1"/><verse number="2" style="v" sid="1CO 9:2"/>Akwama ǝn dlakulva gyiya Yesu bi nai vak uudah biya, ǝn dlakulva gyiya Yesu nai vakaruwa adaɓa kuuram nǝ dǝga sǝrga taakiya ŋ dlakulva gyiya Yesu naiya. <verse eid="1CO 9:2"/><verse number="3" style="v" sid="1CO 9:3"/>Ən ngǝdlǝg ndkwah nai kǝ ghǝrar vak lii arna sǝrra ndzǝganara. <verse eid="1CO 9:3"/><verse number="4" style="v" sid="1CO 9:4"/>Mbats kǝm maay dǝ ndzǝɗ vǝlkǝmnd nǝ uud kǝ dǝg zhǝga ard yuwa hubǝg biya? <verse eid="1CO 9:4"/><verse number="5" style="v" sid="1CO 9:5"/>Kǝm maay dǝ ndzǝɗa gwiyav dǝ ǝmghwassahamǝnd band kwa ɓag nǝ kyalmaha lii ɓa tlǝri, ard zaraabah ma gata Yaazhǝgǝla, ard kefas biya? <verse eid="1CO 9:5"/><verse number="6" style="v" sid="1CO 9:6"/>Nii ba kaiya ard barnabas ha wa nalnǝg kǝ barari kǝskǝmnd ɓa tlǝr gǝlla ghayamǝndi? <verse eid="1CO 9:6"/><verse number="7" style="v" sid="1CO 9:7"/>War wa ɓatlǝra tlauja tǝhalakwaha iin wa gǝlla ghǝraani? War wa uusa ghuha inabi, kwal huɓgwibi kǝ yuwan biyi? War wa piiya almana, da pǝlarvan huɓa watli? ? <verse eid="1CO 9:7"/><verse number="8" style="v" sid="1CO 9:8"/>Ən taa kwana kwakyarvad dǝgiti naag nǝ uuda? Taagabi na adzahadzah muus ndkwahiin biya? <verse eid="1CO 9:8"/><verse number="9" style="v" sid="1CO 9:9"/>Adabb viinɗaviinɗan ma adzahadzaha muusa taakiya,“ mbusarbi kǝ ghai kǝ tlusǝg ma sarta buga hiya biya,” ba tlah pall wa fǝg nǝ Daadamazhigǝl kǝ hyǝmi tǝ iitǝra? <verse eid="1CO 9:9"/><verse number="10" style="v" sid="1CO 9:10"/>Tagav da mbakyarvad kǝmyam nǝ ǝlbǝgiin biya? Ba jirjiira, viindava mbakyarvad kǝmyamma. Abi kalkalan kǝ daada uusǝga ard dadda bugahiya fadghǝr kǝ tlǝkǝna dǝgshigaan matlra guuha. <verse eid="1CO 9:10"/><verse number="11" style="v" sid="1CO 9:11"/>Akwama riitamǝnd riig kǝlbǝga Daadamazhigǝl ma ǝrvǝdamahuɗaruwa, aiciya, dǝgit dyak vakamǝnd akwama ghudamǝnda ghudǝg tlǝraru kwa hulfa dǝga duniya biya? <verse eid="1CO 9:11"/><verse number="12" style="v" sid="1CO 9:12"/>Akwama tlǝkǝnatlǝg nǝ kyalmah kǝ ndzǝɗa ɓa kwaha, mbats, jamtǝrubi nǝmnd dǝ ɓa kwahiin biya? Bakǝvakwaha, ɓagamnd bi kǝ tlǝr dǝ ndzǝɗǝmǝnd biya, famǝnda fǝg kǝ huɗda ɓagamǝndbi kǝ dǝgiti da tsǝgarva taa ǝlbǝg marawa tlǝkatǝga. <verse eid="1CO 9:12"/><verse number="13" style="v" sid="1CO 9:13"/>Mbats, am sǝrgai taakiya lii ɓatllǝr ma guda Daadamazhigǝla ar tlǝkǝna ba vakwahiin kǝ ɗǝgzǝgaatǝr biya? Lii ɓatlǝra tǝ ɓagadiya, ar tlǝkǝna ba dǝga kyuulǝg nǝ iitǝr kǝ dǝgshigatǝr biya? <verse eid="1CO 9:13"/><verse number="14" style="v" sid="1CO 9:14"/>Bandkwah dlaɓa, tagadatag nǝ adzahadzaha Yaazhǝgǝl taakiya lii taa ǝlbǝg marawa ar da tlǝkǝna bavakwahiin kǝ dǝga pǝla puutatǝra <verse eid="1CO 9:14"/><verse number="15" style="v" sid="1CO 9:15"/>Ɓaganbi nai kǝ tlǝr aandzu dǝ pal ma kwanahaan kǝ kwara ghǝr biya, adaba ǝn viinda kwanǝn naiya mbakyavad ɓagwi nǝ band kwah biya, nggulǝm ǝn ǝmtsan nai tǝghǝr kwa da tsǝkwava nǝ uud kǝ tsa kuusghǝg dǝ kwanna. <verse eid="1CO 9:15"/><verse number="16" style="v" sid="1CO 9:16"/>Aandzu ban ɓa tlǝra taa ǝlbǝg marawa , nalbi adabanǝ wan kǝdǝga tsa kushǝg kǝskaiy biya, adaba barari kǝskai ɓatlǝra, dǝga zhuwadaal kǝskai akwam ǝn maay ɓatlǝr taa ǝlbǝg maraw biya. <verse eid="1CO 9:16"/><verse number="17" style="v" sid="1CO 9:17"/>Akwamana ɓag kwakyarvad naaga ghǝrarra naiya, ma pǝlgwapǝlǝg nǝuud kǝ dǝgshigara, adaba ǝn ɓag kwakyarvad nǝgha gyiya biya, vǝlghwa langyi nǝ Daadamazhigǝla. <verse eid="1CO 9:17"/><verse number="18" style="v" sid="1CO 9:18"/>Auci nǝdǝgshigari? Dǝgshigara, iin taa ǝlbǝg marawa, ǝn tagaan ba gyagyaana. Ən maay ɓa tlǝr dǝ kwara ghǝrǝn tlankǝna naiyin ma tlǝra taa ǝlbǝg maraw biya. <verse eid="1CO 9:18"/><verse number="19" style="v" sid="1CO 9:19"/>Bakǝvakwana ǝn Eva aandzu war naiy biya, nandalnǝg kǝ ghǝrar kǝ Eva aandzu ba wara, adaba ǝn tlǝkǝna kǝ uudah ba dyǝka. <verse eid="1CO 9:19"/><verse number="20" style="v" sid="1CO 9:20"/>Vak yahudaha, nanalnǝg band zhiil yahudah nai kiyava dzahdaan kǝ yahudaha. Kwar ma kwarǝg adzahadzaha musa, iin nǝdal kǝ ghǝrar band daddakwa kwarǝg na adzahadzaha, aandzu ba adzahadzahbi wa kwara kaiy biya, mbakyarvad ǝn dzahdaan kǝ lii kwarǝg nadzahadzaha. <verse eid="1CO 9:20"/><verse number="21" style="v" sid="1CO 9:21"/>Vak lii ar maay ma kwarǝga adzahadzaha muus biya,nanalnǝg nai band daddakwa maay ma kwarǝga adzahadzaha muus biya, kwakyarvad ǝn taaki maay na adzahadzaha Daadamazhigǝl ɓatlǝr dǝ kaibiya, ǝndkwah biya, ǝn mazhangǝl kǝ adzahadzaha tlǝkatǝg naiya, kiyava saa dǝ lii ar maay mazhangǝl kǝ adzahadzaha muus biya. <verse eid="1CO 9:21"/><verse number="22" style="v" sid="1CO 9:22"/>Lii hǝtsahǝtsan nǝ fadghǝraatǝra, nandalnǝg nai kǝ ghǝrar band daddakwa hǝtsahǝtsan ma fadghǝra kiyava saa dǝ iitǝra, dlaɓa nanalnǝg nai aandzu hulfa kwar kǝ dǝgita vak aandzu hulfa kwar kǝ uudaha adaba ma ɓagaba ndandara ǝn kattǝrt kǝ kyalmaha. <verse eid="1CO 9:22"/><verse number="23" style="v" sid="1CO 9:23"/>Ɓaganaɓag nai baɗǝm bandkwana mbakyarvad ǝlbǝg marawa, kiyava tlǝkǝnatlǝg kǝskai kǝ dǝgshigar ma barkaana. <verse eid="1CO 9:23"/><verse number="24" style="v" sid="1CO 9:24"/>Mbats am sǝrgabiya, vaka ɓa dǝrra ɓalla ǝmndǝrga, baɗǝm nǝ lii ɓalla ǝmndǝrga arɓa kǝlla ndzǝɗaatǝra ar jaara kǝ pallatǝra, ba pal miitǝr wada zaa firbiya? <verse eid="1CO 9:24"/><verse number="25" style="v" sid="1CO 9:25"/>Ar ndaigan nǝ lii ɓa dǝr kǝ ghǝraatǝr ma kwar kǝ dǝrra, ar ɓa kwana kwakyarvad ar tlǝkǝna kǝ dǝgshigaatǝr kwa da badzǝga, adaba dǝg shigamnda da maay badzǝg biya. <verse eid="1CO 9:25"/><verse number="26" style="v" sid="1CO 9:26"/>Mbakyarvad kwaha ɓalla ǝmndǝrgara da nǝgalbi gyan biya, tsa dǝmbara ǝn tsǝg ma fǝdbiya. <verse eid="1CO 9:26"/><verse number="27" style="v" sid="1CO 9:27"/>Adaba ǝn ndaiya vǝghara, nandalnǝg Evaara, mbakyarvad aa nalbi dlaɓ tǝhala taa ǝlbǝg maraw kǝkai kǝ kyalmaha, kai kata ghǝrarra da tsuwava nǝ uud kǝ tlǝkǝna zaa fiira.<verse eid="1CO 9:27"/></para>
  <chapter eid="1CO 9"/>
  <chapter number="10" style="c" sid="1CO 10"/>
  <para style="s">Ndaig tǝghǝr kǝ ɓagarnǝs kwatǝnah kǝ ghǝlla</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1"/>Aiciya, ǝn naagan am sran zaraabah taakiya, daadijahamiiyamma baɗǝma ndza hǝɗavtǝrdu da akumba tǝ ɗuula dagalla, baɗǝmmatǝra daral bama taataka yuwa haiya. <verse eid="1CO 10:1"/><verse number="2" style="v" sid="1CO 10:2"/>Ɓagavtǝra bama akumba ard yuwa haiy nǝ tsuufǝg kǝ iitǝr baɗǝm ma gata adzahadzaha musa. <verse eid="1CO 10:2"/><verse number="3" style="v" sid="1CO 10:3"/>Baɗǝmmatǝra zaruuzǝg kǝ dǝgzǝg aa shidkwa cacuwana cacuwana, <verse eid="1CO 10:3"/><verse number="4" style="v" sid="1CO 10:4"/>Baɗǝmmatǝra huɓaruu huɓǝg kǝ yuwa shidkwa caccuwanacaccuwana. Adaba huɓaruu yuwa ma akura shidkwa cacuwana, kwa da dagal ǝmtaɗ dǝ iitǝra,kwahiin kǝ akura iin tlǝkatǝga. <verse eid="1CO 10:4"/><verse number="5" style="v" sid="1CO 10:5"/>Bakǝvakwaha cǝngubi nǝ Daadamazhigǝl kǝmtakǝra kyamahatǝr biya, cǝɓavtǝra cǝɓǝga ma tǝghaala. <verse eid="1CO 10:5"/><verse number="6" style="v" sid="1CO 10:6"/>Ndakwana, nalnǝg nǝ wannahaan kǝ dǝgitah kǝ garava kǝskimyam haik ɓa dǝgiyah ghwaɗa bandkwa ɓag nǝ iitǝa. <verse eid="1CO 10:6"/><verse number="7" style="v" sid="1CO 10:7"/>Namalbi kǝ lii ar ɓargarnǝs kwatǝnahǝr kǝ ghǝllah band kwa naral nǝ kyalmah biya. Aɗaba viindaviinda makakkaɗa Daadamazhigǝl taakiya,“caahwarara caahwarǝg nǝ uudaha ar zǝgaana ar huɓgaana, baz shakalga ard gwaragwar biya. <verse eid="1CO 10:7"/><verse number="8" style="v" sid="1CO 10:8"/>Bagiiyambi kǝ gwaragwar bandkwa ɓag nǝ kyalmah biya, adaba ba daval palla ǝmtsahara ǝmtsahǝg nǝ uudah alfu kulbuwa. <verse eid="1CO 10:8"/><verse number="9" style="v" sid="1CO 10:9"/>Fishambi kǝ Yaazhǝgǝl band kwa ɓagar nǝ kyalmaha biya, baz ghwatǝraghwag nǝ ghavalaha ǝmtsahara ǝmtsahǝga. <verse eid="1CO 10:9"/><verse number="10" style="v" sid="1CO 10:10"/>Zavambi kǝ ghai band kwa ɓag nǝ kyalmah biya, adaba ciɓatǝraciɓǝg nǝ zarha ɓǝlga Daadamazhigǝla. <verse eid="1CO 10:10"/><verse number="11" style="v" sid="1CO 10:11"/>Dǝgitahan dzǝghardzǝgna dǝ iitǝr na garava, viinɗavaviinɗǝgga mbakyavad ɓǝlkiyama nǝ ndaiga, kǝskǝmyamǝn tlakiyama nǝ zamanna. <verse eid="1CO 10:11"/><verse number="12" style="v" sid="1CO 10:12"/>Mbakyavad kwaha, akwama agha tlatla taaikya baghabaag ku shiga,aiciya, fafǝg kǝ hǝnkala mbaɗabiya. <verse eid="1CO 10:12"/><verse number="13" style="v" sid="1CO 10:13"/>Maay nǝ fǝshigi tlakuratlǝg kwal dzǝgharbi dǝ uudah biya. Adaba Daadamazhigǝla uuda jirjir nǝ iina da dugharbi am dǝm damma fǝshig kwa juujig kǝ ndzaɗaru biya, akwama damǝmdǝg dat duula fǝshiga, da wurkurant wurg nǝ Daadmazhǝgǝl ngǝdlǝga kwam da ɓǝshǝg nǝ uurama. <verse eid="1CO 10:13"/><verse number="14" style="v" sid="1CO 10:14"/>Mbakyarvad kwaha, kuramǝm ǝn waikur naiyna, aɗuumarsɗug kǝ ɓagar kwatǝnahǝr kǝ ghǝllaha. <verse eid="1CO 10:14"/><verse number="15" style="v" sid="1CO 10:15"/>Ən tagkur kwana adaba am dǝ hǝnkal nǝ uurama, zharamzharg ba nǝ uuram kǝ dǝgiti ǝn tagkur naiya. <verse eid="1CO 10:15"/><verse number="16" style="v" sid="1CO 10:16"/>Kuwa langyi dǝga barka nǝ iina, kwa kiyam taa uus dǝvakiya, mbats ba iin wa fǝkiyama ndzǝgan pal ma avǝza tlǝkatǝg biya? Bruudiin kwa kiyam kalna nǝ miiyamǝn wa fǝkiyama ndzǝgan pal ma vǝgha tlǝkatǝg biya? <verse eid="1CO 10:16"/><verse number="17" style="v" sid="1CO 10:17"/>Aɗaba bruudiin ba palla, mbats kǝmyamǝn kiyam ba dyǝk na kiyam ba vǝgh palla, aɗaba baɗǝmma miyama kiyam zaa ba bruudi palla. <verse eid="1CO 10:17"/><verse number="18" style="v" sid="1CO 10:18"/>Zharamzharg kǝ uudaha israila. Mbats lii zaa dǝga kyuulǝga, ar ba pal nǝ iitǝr ma zaa dǝga kyuulǝg wa vǝlava kǝ Daadamazhigǝl tǝ bagadiya kyuulǝg biya? <verse eid="1CO 10:18"/><verse number="19" style="v" sid="1CO 10:19"/>Awa ǝn tlatlǝg nai vakwani? Dǝgiti hǝravara kǝ ghǝli ci nǝ dǝgit marawa? Nii ghǝlha ci nǝ dǝgit marawi? <verse eid="1CO 10:19"/><verse number="20" style="v" sid="1CO 10:20"/>Əndkwah biya,ǝn tlatla yaakiya, dǝga kyuulǝgi kwa vǝlǝg nǝ lii ɓagar kwatǝnah kǝ ghǝlla, ar vǝlga kǝ sgatanaha, kǝ Daadamazhigǝl biya. Ən naiy am nal band shatanah biya. <verse eid="1CO 10:20"/><verse number="21" style="v" sid="1CO 10:21"/>Ba gabi am huɓu ma kuwa langyi tlǝkatǝg biya, dlaɓa am zuu kǝ dǝga shatanah biya. <verse eid="1CO 10:21"/><verse number="22" style="v" sid="1CO 10:22"/>Kiyam pǝkya ghaya Yaazǝgǝl nii? Jiyamujig kǝ iin dǝ ndzǝɗ hi?<verse eid="1CO 10:22"/></para>
  <para style="s">Ɓag kǝ dǝgita kwakyarvad fǝvaran Daadamazhigǝla</para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23"/>“Baɗǝm nǝ dǝgita haiyakiyamanthaig nǝ uuda,”dlaɓa ba dǝmbi nǝ dǝgitah mǝng nǝ tlǝran biya, “baɗǝm nǝ dǝgitaha haighwanthaig nǝ uuda,”baɗǝmbi nǝ dǝgitahi kwa da mǝng tlǝran biya. <verse eid="1CO 10:23"/><verse number="24" style="v" sid="1CO 10:24"/>Ɓagarbi ba kǝ ghǝragh kǝ dǝgit maraw biya, ɓagarɓag baz zǝraabagha. <verse eid="1CO 10:24"/><verse number="25" style="v" sid="1CO 10:25"/>Zamzǝg baɗǝm kǝ hulfa dǝgiti valav vaka valla tluwa, bamam ndavna dǝ ndavǝg biya, mbakyarvad haik ndzamǝgan kǝskuuram ma ǝrvǝmahuɗaru kǝ vakavaki aa sǝgal dǝ tluwǝna. <verse eid="1CO 10:25"/><verse number="26" style="v" sid="1CO 10:26"/>Aɗaba tagatag nǝ ǝlbǝga Daadamazhigǝla taakiya, “Duni baɗǝmma baz dǝgiti ma vakaita ba dǝga Daadamazhigǝla,” <verse eid="1CO 10:26"/><verse number="27" style="v" sid="1CO 10:27"/>Akwama ɗahakurǝtɗahǝg nǝ daddakwa maay gata Yesu da za kaffa, ma haiyamanthaig kǝ dagauwa, zamzǝg baɗǝm ku hulfa dǝgiti vǝlkur nǝ iina, bamam ndavna dǝ ndavǝg biya,aɗaba haik dzamǝgan kǝskuuram ma ǝrvǝdmahuɗaru kǝ vakavaki aa sǝgal dǝ dǝgzǝgiina. <verse eid="1CO 10:27"/><verse number="28" style="v" sid="1CO 10:28"/>Akwama tagakuuratag nǝ uud taakiya ,“Aa hǝrva mbakyarvad ghǝlla,”zambiya, mbakyarvad zhara ndzǝgana uudǝraru dǝ dadda kwa tagkurataga, aɗaba haik kǝ haip tǝ ghǝraruwa. <verse eid="1CO 10:28"/><verse number="29" style="v" sid="1CO 10:29"/>Ən tlatla dǝgiti da dzamǝg nǝ iin ma ǝrvǝdmahuɗaana, dǝgaruu biya. Aiciya, da tagan nǝ uudaru pal taakiya“Aujibǝg kǝ dzamaghǝra uudan da tsǝkwava kǝ kwara ghǝrari? <verse eid="1CO 10:29"/><verse number="30" style="v" sid="1CO 10:30"/>Akwama taganaratag kǝ uus kǝ Daadamazhigǝla lakwti ǝn da zaa dǝgzǝga, aujibǝg da ghudgus ǝlbǝg nǝ uud tǝghǝr kǝ dǝgiti naa zǝg naiy tambar taganaratag kǝ uus kǝ Daadamazhǝgǝli? <verse eid="1CO 10:30"/><verse number="31" style="v" sid="1CO 10:31"/>Aiciya, baɗǝm nǝ dǝgiti am ɓag nǝ uurama, aandzu am zǝg dǝ zǝga, aandzu am huɓǝg dǝ huɓǝga, ɓagamɓag mbakyarvad galla Daadamazhigǝla. <verse eid="1CO 10:31"/><verse number="32" style="v" sid="1CO 10:32"/>Namalbi kǝ duula ɓa haip kǝ yahudah biya, aandzu ma lii ar yahudah biya, ma dlamakǝlaaa lii ar gata Daadamazhigǝl biya. <verse eid="1CO 10:32"/><verse number="33" style="v" sid="1CO 10:33"/>Ɓagamɓag band kwa ǝn ɓag naiya. Ən ɓa kǝla ndzǝɗar ma ciinguu aandzu ma ba war kǝmtakǝr dǝgitahi ǝn ɓag naiy baɗǝmma, kwakyarvad ghǝrar pal wan ɓag naiy biya,ǝn ɓag kwakyarvad uudah ba dyǝkka, aɗaba maraa tlǝkǝna kǝ katǝgga.<verse eid="1CO 10:33"/></para>
  <chapter eid="1CO 10"/>
  <chapter number="11" style="c" sid="1CO 11"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1"/>Gatamgatǝg kǝ garav dǝ kaiya, bandkwa ǝn gatǝg naiy kǝ garava tlǝkatǝga.<verse eid="1CO 11:1"/></para>
  <para style="s">Tsag tǝghǝr kǝ mbussa ghǝra</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2"/>Ən galakuuram naiy mbakyarvad am dzamkwadzamǝg aandzu ba mauwa, dlaɓa hǝkyamnahǝkyǝg kǝ dǝgiti tsagankuru naiy ba vaiyvaiya, ba kalkal dǝ kwa vǝlankur naiya. <verse eid="1CO 11:2"/><verse number="3" style="v" sid="1CO 11:3"/>Aɗaba ǝn naagan am sǝran taakiya, Tlǝkatǝg nǝ maal tǝghǝr kukwar kǝ uuda, Zhiila dlaɓa maal tǝghǝr kǝ uusaana, Daadamazhigǝl nǝ tǝghǝr Tlǝkatǝga. <verse eid="1CO 11:3"/><verse number="4" style="v" sid="1CO 11:4"/>Baɗǝm nǝ ghwalvi dzǝgwazhǝgǝl ma ɓa dǝga jappǝra mbuusambuusan ghǝraana fǝgharabi kǝ maalan biya. <verse eid="1CO 11:4"/><verse number="5" style="v" sid="1CO 11:5"/>Dlaɓa baɗǝm nǝ uusi dzǝgwazhǝgǝla ma ɓa dǝga jappǝr kwal ugwǝɗga dankwaliya, nenghana nennǝg kǝ zhiila, ba kalkal mandki aa uusǝvardan ghǝra. <verse eid="1CO 11:5"/><verse number="6" style="v" sid="1CO 11:6"/>Akwama lawalǝg nǝ uus kǝ ugwǝɗa ɗankwaliya, aa uusdauusǝg kǝ ghǝraana, aɗaba dǝga zhǝruu kǝ uus uusaghǝra, aa ugwǝɗǝg kǝ ɗankwaliya. <verse eid="1CO 11:6"/><verse number="7" style="v" sid="1CO 11:7"/>Kalkalanbi kǝ ghwalǝv mbuusa kǝ ghǝran biya, aɗaba garava Daadamazhigǝla ard ndanghǝraana, dlaɓa uusa mara ndanghǝra zhiilaana. <verse eid="1CO 11:7"/><verse number="8" style="v" sid="1CO 11:8"/>Savda ma vǝgha uusbi nǝ ghwalǝv biya, bamma uus wa savda ma vǝgha ghwalǝva. <verse eid="1CO 11:8"/><verse number="9" style="v" sid="1CO 11:9"/>Ɓagavabi nǝ ghwalǝv mbakyarvad uus biya, bamma uus wa ɓagava mbakyarvad ghwalǝva. <verse eid="1CO 11:9"/><verse number="10" style="v" sid="1CO 11:10"/>Mbakyarvad kwaha barari kǝ uus ugwǝɗa ɗankwaliya, mardan taakiya dǝ ndzǝɗ nǝ ghwalǝva, mbakyarvad zǝrɓǝlgaha Daadamazhigǝla. <verse eid="1CO 11:10"/><verse number="11" style="v" sid="1CO 11:11"/>Bakǝvakwaha, tagwabi nǝ uus dǝ ghwalǝv ma tlǝkatǝg biya, ghwalǝv dlaɓa tagwabi ɗǝ uus ma tlǝkatǝg biya. <verse eid="1CO 11:11"/><verse number="12" style="v" sid="1CO 11:12"/>Bandkwa sǝghal nǝ uus ma vǝgha ghwalǝva, uus dlaɓ wa yaa ghwalǝva, aɗaba baɗǝm nǝ dǝgita ɓaga ba Daadamazhigǝla. <verse eid="1CO 11:12"/><verse number="13" style="v" sid="1CO 11:13"/>Zharamzharg ba nǝ uuram dǝ ghǝraruwa, ɓagaɓag kǝ maraw nǝ uus dzǝgwazhǝgǝl kǝ Daadamazhigǝl kwal hǝɗǝna kǝ ghǝraana? <verse eid="1CO 11:13"/><verse number="14" style="v" sid="1CO 11:14"/>Tsagakurutsag nǝ dzǝganaru taakiya akwama ɗugharɗug nǝ ghwalǝv kǝ guuja ghǝraan ba fiikǝmma, dǝga zhǝruw nǝ iina. <verse eid="1CO 11:14"/><verse number="15" style="v" sid="1CO 11:15"/>Kiyava uusi dǝ guuja ghǝran dlaɗɗa, dǝga ndanghǝr vakaana, aɗaba vǝlavarvǝlǝg nǝ guuja kiyava hǝɗɗa ghǝraana. <verse eid="1CO 11:15"/><verse number="16" style="v" sid="1CO 11:16"/>Akwama mǝng nǝ daddakwa haighantbi kǝ kwa nǝ iin ya, kǝm sǝrgabi nǝmnd kwatlǝrn kadzahadzah biya, bandkwah dlab nǝ kyalma zaraabaha lii gatǝga.<verse eid="1CO 11:16"/></para>
  <para style="s">Dlaɗ vaka zaa jibiya Yaazhǝgǝla</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17"/>Tǝghǝr kǝ dǝgiti tagankur naiya, dlǝbankurǝt biya aɗaba dzahavaruwǝna ghwaɗɗa dǝga jirjir biya. <verse eid="1CO 11:17"/><verse number="18" style="v" sid="1CO 11:18"/>Bamma dzahavaru ba zuunga kwa dzahamvǝt nǝ uurama, cǝnganacǝng taakiya mǝng tagwazha tagwaz ma taatakaruwa, haiyananthaig nǝ dǝ ǝlbǝgiina. <verse eid="1CO 11:18"/><verse number="19" style="v" sid="1CO 11:19"/>Ba jirjiira tlǝvkǝnatlǝg nǝ tagwazha tagwazh ma taatakaruwa, aɗaba nǝghǝvakan nǝ uudaha jirjir ma taatakaruwa. <verse eid="1CO 11:19"/><verse number="20" style="v" sid="1CO 11:20"/>Mbats am dzahav kwakyarvad zaa jibiya Yaazhǝgǝl biya. <verse eid="1CO 11:20"/><verse number="21" style="v" sid="1CO 11:21"/>Aɗaba vaka zaa dǝgzǝga, ma bawara tsǝdi kǝ ghǝr vaka zaa dǝgaana, maay wa lǝhuud biya Ɗuuvars nǝ watlǝrn mbǝsha waiya, kwatlurna huɓuuhuɓǝga kǝ kya tsaatsǝga. <verse eid="1CO 11:21"/><verse number="22" style="v" sid="1CO 11:22"/>Am maay dǝ hǝnyahaaruwa kwam ndzǝga nuurama am zǝgaana am huɓǝgaan biya? Nii amaa nenna dlamakǝlaaa lii gata Daadamazhǝgǝlhi, am vǝltǝr dlaɗ kǝ lii ar maay dǝ dǝgith biya? Auci wan da tagkur naiyi, ǝn da dlǝba kuuram mbakyarvad kwan ciya? Bagabiya ǝn maay dlǝba kuurami.<verse eid="1CO 11:22"/></para>
  <para style="s">Zaa jibiya Yaazhǝgǝla</para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23"/>Dǝgitǝn caawana naiy vak Yaazhǝgǝl kwa tagankur naiy taakiya, ma huɗavǝɗa kwa vǝlavvǝt nǝ Yaazhǝgǝl Yesu, kǝssant kǝ bruudiya, <verse eid="1CO 11:23"/><verse number="24" style="v" sid="1CO 11:24"/>Tǝhala kwa taghar nǝ iin kǝ uus kǝ Daadamazhigǝla, kalna kǝ iina, aiyama,“Kwanna iin nǝ vǝghaara, kwa vǝlavda mbakyarvad kuurama. Ndza ba ɓagamɓag band kwana kiyava dzamkwadzamǝga.” <verse eid="1CO 11:24"/><verse number="25" style="v" sid="1CO 11:25"/>Bandkwah dlaɓa tǝhala zaa jibiya, kǝssant kǝ iin kǝ zǝr kuuwa amaa,“ Kwannǝ kǝ zǝr kuuwa iin daala langiya avzara, ɓagamɓag bandkwana ba tuuk sarti am huɓǝg nǝ uurama, kiyava dzamkwadzamǝg kǝskuurama.” <verse eid="1CO 11:25"/><verse number="26" style="v" sid="1CO 11:26"/>Ba tuuk sarti am zǝg nǝ uuram kǝ bruuiya, dlaɓa am huɓǝgan ma zǝrkuwa, am ɓǝla tlǝghǝga ǝmtsǝga Yaazhǝgǝl, tangw dama sarti da saay nǝ iina.<verse eid="1CO 11:26"/></para>
  <para style="s">Zaa jibiya Yaazhǝgǝl bad ǝrvǝdmahuɗ palla</para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 11:27"/>Mbakyarvad kwaha baɗǝm nǝ daddakwa zǝguu bruudiina, ma huɓǝguu ma zǝrkuwa Yaazhǝgǝl dǝ ǝrvǝdmahuɗ pall biya, ɓagharaɓag kǝ haip kǝ vǝgha Yesu ard avzaana, <verse eid="1CO 11:27"/><verse number="28" style="v" sid="1CO 11:28"/>Ma ba wara aa sǝrasǝrg kǝ ghǝraana, tǝhalakwaha ka zǝgan kǝ bruudiya ard huɓǝgaan ma zǝrkuwa. <verse eid="1CO 11:28"/><verse number="29" style="v" sid="1CO 11:29"/>Baɗǝm daddakwa zǝguu bruudiya, ma huɓǝguu ma zǝrkuwa kwal fǝgarafǝg kǝ vǝgha Yaazhǝgǝla, sǝghardasǝg kǝ dlaɗ kǝ ghǝraan tǝdvad zǝgaana ard huɓǝgani ɓaga nǝ iina. <verse eid="1CO 11:29"/><verse number="30" style="v" sid="1CO 11:30"/>Iin wa dzǝghardzǝg ma kuuram ba dyǝk nǝ lii dǝ maira ndzǝɗ ard yangbiyaha, kyalmah ndakwani ǝmtsahara ǝmtsahǝga. <verse eid="1CO 11:30"/><verse number="31" style="v" sid="1CO 11:31"/>Aɗaba akwama sǝryamasǝrg kǝ ghǝramiiyama ba marawa, da maay nǝ uud vǝlkiyam dlaɗ bia. <verse eid="1CO 11:31"/><verse number="32" style="v" sid="1CO 11:32"/>Akwama Yaazhǝgǝl wa da tǝkiyam sharia, kiyam ndaiya ghǝramiiyama haik vǝlkiyam dlaɗ kǝ uud ǝmtad dǝ uudaha duniya. <verse eid="1CO 11:32"/><verse number="33" style="v" sid="1CO 11:33"/>Mbakyarvad kwaha zaraabahara, akwama dzahamvǝtdzahǝg da zaa dǝgita, am pakant kǝ zaraabaharuwa. <verse eid="1CO 11:33"/><verse number="34" style="v" sid="1CO 11:34"/>Akwama mǝng nǝ daddakwa njǝkǝn waiy ma kuurama, aa zuuzǝg kǝ dǝgit sagal hǝnyaha, aa nalbi taakiya dzahavaruwǝnna da sǝkurda dlaɗ biya. Tǝghǝr kǝ kyalma dǝgitaha, akwama guyanagwig sagauwa ǝn da tagkurtaga.<verse eid="1CO 11:34"/></para>
  <chapter eid="1CO 11"/>
  <chapter number="12" style="c" sid="1CO 12"/>
  <para style="s">Vǝlgah shah shah vak shǝdkwa cacuwana</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1"/>Ndakwan ciya, zaraabahaara, tǝghǝr kǝ vǝlga shah shaha vak shǝdkwa cacuwana cacuwana, ǝn naiya am ndzan kwal sǝrgasǝrg biya. <verse eid="1CO 12:1"/><verse number="2" style="v" sid="1CO 12:2"/>Ma sarta kwa ndzam lii gata Daadamazhǝgǝlbi nuuram biya, sǝramsǝrg taakiya, valakurda dǝ valǝg nǝ uuda, ndzam ɓagarnǝs kwatǝnahǝr ghǝllaha kwar maay dǝ shiflug biya. <verse eid="1CO 12:2"/><verse number="3" style="v" sid="1CO 12:3"/>Aɗabad kwaha ǝn naagan am nǝghakan taakiya, maay nǝ daddakwa shǝdkwa Daadamazhigǝl wa ɓatlǝr dǝ iin da taakiya,“Tlafatlafan nǝ Yesu biya,!” dlaɓa maay nǝ wada tagdatag taakiya,“Yesu Yaazhǝgǝl nǝ iin biya,” bamma daddakwa shǝdkwa cacuwana cacuwanan wa ɓa tlǝr dǝ iina. <verse eid="1CO 12:3"/><verse number="4" style="v" sid="1CO 12:4"/>Mǝng nǝ vǝlgah shah shaha, ba shǝdkwa cacuwana cacuwanan pal wa vǝlgan baɗǝmma. <verse eid="1CO 12:4"/><verse number="5" style="v" sid="1CO 12:5"/>Mǝng nǝ duulah shah shah kǝ dǝga ɓa tlǝra, ba Yaazhǝgǝl pal wa ɓagvara. <verse eid="1CO 12:5"/><verse number="6" style="v" sid="1CO 12:6"/>Mǝng tlǝrah shah shaha, ba Daadamazhigǝl pal wa vǝlga aandzu ma bawar kǝ ndzǝɗa ɓagan baɗǝmma. <verse eid="1CO 12:6"/><verse number="7" style="v" sid="1CO 12:7"/>Vǝlghar vǝlg nǝ Daadamazhigǝl aandzu ma bawar kǝ shɗkwa cacuwana cacuwanan kiyava margar dǝgit marawa. <verse eid="1CO 12:7"/><verse number="8" style="v" sid="1CO 12:8"/>Kwatlǝrna vǝlavar nǝ dǝga tsaga dabariya tǝdvad shǝdkwa cacuwana cacuwananna, ƙwaklǝrn dlaɓa vǝlavar nǝ dǝga tsaga sǝrgasǝrga tǝdvad shǝdkwa. <verse eid="1CO 12:8"/><verse number="9" style="v" sid="1CO 12:9"/>Kwatlǝrn dlaɓa vǝlavar nǝ dǝga fadghǝra tǝdvad shǝdkwiina, kwatlǝrna vǝlavar nǝ dǝga mbahuuda tǝdvad shǝdkwa, <verse eid="1CO 12:9"/><verse number="10" style="v" sid="1CO 12:10"/>Kwatlǝrna vǝlavar nǝ dǝga ɓa tlǝraha jappǝrra, kwatlǝrna dǝga tlayangngǝra, kwatlǝrna dlaɓa dǝga tagwaaka ndzǝgana shǝdkwaha, kwatlǝrna dǝga sǝrga taa ghaiyah shahshaha, kwatlǝrn dlaɓa dǝga gwiiya ghaiyah shahshaha. <verse eid="1CO 12:10"/><verse number="11" style="v" sid="1CO 12:11"/>Baɗǝm nǝ wanahaana ba shǝdkw pal wa ɓagaana, dlaɓa biin wa tagwan aandzu war band kwa naagant nǝ iina.<verse eid="1CO 12:11"/></para>
  <para style="s">Baɗǝmamiiyama kiyam ba uuɓiiya vǝgh palla</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12"/>Bandkwa ba pal nǝ vǝgha, dlaɓa uuɓiiyah tǝvakai ba dyǝkka, aandzu ba mǝng nǝ uuɓiiyah ba dyǝkka, ar ba vǝghǝg palla. Bandkwah ci kǝ Tlǝkatǝga. <verse eid="1CO 12:12"/><verse number="13" style="v" sid="1CO 12:13"/>Aɗaba ɓaggakiyama ɓag nǝ uud kǝ tsuufǝg baɗǝmmamiiyam tǝdvad shǝdkwa palla damma vǝghǝgha palla, aandzu yahuudaha aandzu kwar yahuudah biya, ma Evva nǝ iina ma daddakwa kwara ghǝraana, baɗǝmmamiyama huɓɓiiyamuhuɓǝg bamma shǝdkw palla. <verse eid="1CO 12:13"/><verse number="14" style="v" sid="1CO 12:14"/>Vǝghǝgha uuɓii pal bi nǝ iin biya, uuɓiiyah ba dyǝk tǝ vakaiya, <verse eid="1CO 12:14"/><verse number="15" style="v" sid="1CO 12:15"/>Akwama tagatag nǝ shǝg taaki, “ Aɗaba ǝn dǝv bi naiyama, ǝn, maay naiy ma uuɓiiya vǝghǝg biyama,” atar ba tagda kwana tsǝgarvabi kǝ nǝg kǝ uuɓiiya vǝghǝg biya. <verse eid="1CO 12:15"/><verse number="16" style="v" sid="1CO 12:16"/>Bandkwah dlaɓ nǝ hyǝmiya akwam tagatag taakiya,“ǝn gyi bi naiy biya, aɗabad kwaha ǝn uuɓiiya vǝgh bi naiyama,” atar ba tagǝda ǝndkwaha tsǝgarvabi kǝ nǝg uuɓiiya vǝgh biya. <verse eid="1CO 12:16"/><verse number="17" style="v" sid="1CO 12:17"/>Akwama baɗǝm nǝ vǝgh ba gyiya, ma da ciingav ndandar nǝ ǝlbǝgi? Akwama baɗǝm nǝ vǝgh ba hyǝmiya, ma da shiyav ndandar nǝ dǝgiti? <verse eid="1CO 12:17"/><verse number="18" style="v" sid="1CO 12:18"/>Fahafahǝg nǝ Daadamazhigǝl kukwar kǝ uuɓiiya vǝgh band kwa naag nǝ iina. <verse eid="1CO 12:18"/><verse number="19" style="v" sid="1CO 12:19"/>Akwama baɗǝm nǝ vǝgh ba uuɓii palla, ma mǝr ha kǝ kyalma vǝghi? <verse eid="1CO 12:19"/><verse number="20" style="v" sid="1CO 12:20"/>Ii wan kwana mǝng nǝ uuɓiiyah ba dyakka, ba pal nǝ vǝgha. <verse eid="1CO 12:20"/><verse number="21" style="v" sid="1CO 12:21"/>Tagardabi nǝ gyi kǝ dǝv taakiya,“maay nǝ lamɓar dǝ kǝgh biyama,”aandzu ma ghǝr wa tagar kǝ shigah taakiya,“maay nǝ lamɓar dǝ kuuram biya.” <verse eid="1CO 12:21"/><verse number="22" style="v" sid="1CO 12:22"/>Əndkwah biya, uuɓiiyahi kwama zharav ar maay dǝ ndzǝɗ biya, iitǝr wa mǝng nǝ tlǝraatǝra. <verse eid="1CO 12:22"/><verse number="23" style="v" sid="1CO 12:23"/>Uuɓiiya vǝgghahi kwa kiyam zharag mandki darǝtbi dat kyalmah dǝ ndanghǝr biya, iin wa kiyam fǝtǝraa nǝ miiyamma. <verse eid="1CO 12:23"/><verse number="24" style="v" sid="1CO 12:24"/>Dlaɓa uuɓiiyaha vǝghahamiiyamǝn kwa maaraw kǝ zhargǝnna, ɓadlǝghani ɓadlǝg nǝ Daadamazhigǝl kǝ vǝgha fahǝt kǝ uuɓiiyah kwa maay ndang kiyava mǝng nǝ tlǝraana, <verse eid="1CO 12:24"/><verse number="25" style="v" sid="1CO 12:25"/>Aɗaba haik tlǝvkǝna tlǝg tagwazh tagwazh tǝ vǝgha, bamma uuɓiiyah war fa kyǝmiy tǝ ghǝraatǝra, kwa ba dǝgit palla. <verse eid="1CO 12:25"/><verse number="26" style="v" sid="1CO 12:26"/>Mbakyarvad kwaha akwama tlakǝnatlǝg nǝ uuɓii pal kǝ vǝvvǝra, baɗǝmmatra ar cǝngan kǝ njiigana, akwama dlǝbavant dlǝɓǝg nǝ uuɓii palla, baɗǝmmatǝra ar ba hwaɗaga ǝmtaɗa. <verse eid="1CO 12:26"/><verse number="27" style="v" sid="1CO 12:27"/>Baɗǝmmaruwa am vǝgha tlǝkatǝga, ma kwararuwa am uuɓiiyana. <verse eid="1CO 12:27"/><verse number="28" style="v" sid="1CO 12:28"/>Ma huɗa dlamakǝlaaa lii gatǝg Yesu, faafǝg nǝ Daadamazhigǝl kǝ lii ɓagar tlǝr kǝ Yesu kǝ dǝga zuungwa, dǝga buwa tlayanngaha, dǝga hǝkǝrɗa lii tsaga dǝgita, ka lii ɓa dǝgaha jappǝra, ka lii vǝlavtǝr vǝlga mbahuudaha, ard lii mǝlgaru kǝ uudaha, ard lii fakyǝmi tǝ tlǝra lii gatǝga, ard lii sǝrga taa ghaiyah shah shaha. <verse eid="1CO 12:28"/><verse number="29" style="v" sid="1CO 12:29"/>Baɗǝm nǝ uudah ba dlakulva gyia Yesuni? Ar baɗǝm ba tlayangahhi? Baɗǝmma ar ba lii tsaga dǝgit hi? Nii ar baɗǝma ar ba lii ɓa dǝgaha jappǝr hi? <verse eid="1CO 12:29"/><verse number="30" style="v" sid="1CO 12:30"/>Baɗǝmmatǝra ar ba dǝ vǝlga mba hǝ uudahhi? Ar baɗǝmma ar sǝrgasǝrg kǝ taa ghaiyah shahshaha? Nii baɗǝmmatǝr ha sǝrgasǝrg kǝ gwiya ghaiyahhi? <verse eid="1CO 12:30"/><verse number="31" style="v" sid="1CO 12:31"/>Gatamgatǝg kǝ vǝlgahi kwa juujig dǝ ndanghǝra, ǝnda markurmarg kǝ ɗuuli kwa juujig baɗǝm dǝ marawa.<verse eid="1CO 12:31"/></para>
  <chapter eid="1CO 12"/>
  <chapter number="13" style="c" sid="1CO 13"/>
  <para style="s">Wayakǝva</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1"/>Aandzu ba mana sǝrgasǝrg kǝ taa ghaiya uudaha shah shaha ard dǝga zǝrɓǝlgaha Daadamazhigǝla, akwama ǝn maay dǝ wayakǝvǝr biya, nanalnǝg band talenlenga kwa tlaav ba gyaagyanna, aandzu gangga kwa tlaav ba dyǝk dyǝkka, <verse eid="1CO 13:1"/><verse number="2" style="v" sid="1CO 13:2"/>Aandzu ba mana sǝrgasǝrg kǝ taa tlayangǝra, ǝn nǝghaakan kǝ dǝgitah shiɓashiɓan baɗǝmma, dlaɓa ǝn mǝng dǝ dyǝmdyǝma baɗǝmma, ard fadǝghǝr ba vaivaiya, kwan da gantgǝg kǝ aghwa, akwama ǝn maay dǝ wayaikǝvǝr biya, maay nǝ dǝgiti ǝn tuuk vakai naiy biya. <verse eid="1CO 13:2"/><verse number="3" style="v" sid="1CO 13:3"/>Aandzu ma vǝlandavǝlǝg kǝ dǝgiti ǝn dǝvakai nai baɗǝmma, ǝn vǝldan dlaɓ kǝ vǝghara hǝvara kaara, akwama ban maay dǝ wayakǝvǝr biya, ǝn maay dǝ dǝkshiga aandzu ndaw biya. <verse eid="1CO 13:3"/><verse number="4" style="v" sid="1CO 13:4"/>Waiyakǝvǝra fǝgara fa ǝrvǝdmahuɗa ard taa jir ƙǝ uuda, waiyakǝvǝra maay dǝ sǝlg biya, maay fǝgara tǝɗa fǝɗavgha ,ard ɗaaga ghǝr biya. <verse eid="1CO 13:4"/><verse number="5" style="v" sid="1CO 13:5"/>Waiyakǝvǝra Maay dǝ naa ghǝr biya, maay dlaɓa fa dagar ma uudah biya, maay pǝkya ghaiy biya maay hǝkya dǝgit ghwaɗ mahuɗ biya. <verse eid="1CO 13:5"/><verse number="6" style="v" sid="1CO 13:6"/>Naay nǝ waiyakǝvǝr kǝ ɓa dǝga kǝlaɗǝr biya, bamma naa ɓa dǝga jirjira, <verse eid="1CO 13:6"/><verse number="7" style="v" sid="1CO 13:7"/>Waiyakǝvǝra fǝgara fa ǝrvǝdmahuɗ kǝ uud, ard fadghǝra aandzu tauwa, ard pakka dǝgita, ard ɓǝshgaana aandzu ba ndara. <verse eid="1CO 13:7"/><verse number="8" style="v" sid="1CO 13:8"/>Maay ghyǝnng nǝ waiyakǝvǝra ba tangw dama zǝrazǝr biya, taa tlayanngǝra da dagal zamanana, taa ghayah dlaɓa zǝgga, dyǝmdyǝmǝra da ghyǝnnga. <verse eid="1CO 13:8"/><verse number="9" style="v" sid="1CO 13:9"/>Bak jirjira, dyǝmdyǝmǝra miiyama rǝghghǝt biya, taa tlayanngǝra miiyama rǝghghǝt biya. <verse eid="1CO 13:9"/><verse number="10" style="v" sid="1CO 13:10"/>Akwama da saahii sǝg nǝ daddakwa rǝghgha rǝghghana, tǝhalakwaha daddakwa rǝgha biya da nǝga. <verse eid="1CO 13:10"/><verse number="11" style="v" sid="1CO 13:11"/>Ma sartǝn zarhǝrara, ndzan taa ba ǝlbǝga zarhǝrra, ndzan dzamaghǝr band dǝga zarha, ndzan vǝla farwut band dǝga zarha. Ghubaranǝt ba naiya kal dugarsdug kǝskai kǝ hǝnkala zarhǝrra. <verse eid="1CO 13:11"/><verse number="12" style="v" sid="1CO 13:12"/>Aɗaba ndakwana kǝm zhara garava ma akwatǝrama band avǝɗvaavǝɗa, daghuvaliina kǝm da zharg ba ghwǝm dǝ gyiiya, aɗaba ndakwana sǝrgasǝrgara rǝghghǝt biya, daghuvalaana sǝrgasǝrgǝrra da rǝghghǝg ba dyǝkdyǝk band kwa fakwi nǝ Daadamazhigǝla. <verse eid="1CO 13:12"/><verse number="13" style="v" sid="1CO 13:13"/>Ndakwan ciya, dǝgitahaan hǝkǝrɗǝna mǝnga bak jiijira, fadghǝra, pakka dǝgita, ard waiyakǝvǝra, baɗǝm miitǝra ba waiyakǝvǝr wa dyǝkka.<verse eid="1CO 13:13"/></para>
  <chapter eid="1CO 13"/>
  <chapter number="14" style="c" sid="1CO 14"/>
  <para style="s">Vǝlga sǝrga ghaiy shahshaha ard taa tlayanngǝra</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1"/>Gatamgatǝg kǝ duula waiyakǝva, dlaɓa am gatǝgaan kǝ vǝlga sǝrgasǝrg vak shǝdkwa caccuwanacaccuwana, ndǝ dǝga taa tlayanngǝra. <verse eid="1CO 14:1"/><verse number="2" style="v" sid="1CO 14:2"/>Aɗaba daddakwa taa ghaiy shahshaha tag dǝ uudah biya, tag dǝ Daadamazhigǝla, aɗaba maay wa nǝghǝgaka nǝghǝg kǝ dǝgitahi tag nǝ iini, mbakyarvad taa dǝgitahi shiɓashiɓana tǝdvad ndzǝɗa shǝdkwa cacuwana cacuwana. <verse eid="1CO 14:2"/><verse number="3" style="v" sid="1CO 14:3"/>Daddakwa taa tlayanngǝra tagtǝr kǝ uudah kǝ ǝlbǝga kiyava mǝltǝrumǝlga fǝtǝrna kǝ ndzǝɗa, dlaɓa tagtǝra kǝ dzǝgwaggha. <verse eid="1CO 14:3"/><verse number="4" style="v" sid="1CO 14:4"/>Daddakwa taa ghai shahshaha mǝlgaru bak kǝ ghǝraana, aɗaba daddakwa taa tlayanngǝra mǝltǝru kǝ dlamakǝlaaa lii gatǝga. <verse eid="1CO 14:4"/><verse number="5" style="v" sid="1CO 14:5"/>Mana naag nai baɗǝmmaruwa mamma taa ghiy shahshaha, bakǝvakwana mat naagara mamma taa tlayanngǝra. Daddakwa taa tlayanngǝra juujig ku daddakwa taa ghai shahshaha, bama mǝng nǝ daddakwa sǝrgasǝrga kǝ gwiya ghaiyiina kiyava mǝlgaru kǝ dlamakǝlwa lii gatǝga. <verse eid="1CO 14:5"/><verse number="6" style="v" sid="1CO 14:6"/>Aici zaraabaharra, akwama danǝvdǝg da vakaruwa ǝn tagkura kǝ ǝlbǝg dǝ ghaiy shahshaha, auci wana mǝlkuru nai dǝvakai, akwama danǝvbi da vakaru dǝ ǝlbǝgaha ard dyǝmdyǝmǝr,ard tsaga ǝlbǝga Daadamazhigǝl biyi? <verse eid="1CO 14:6"/><verse number="7" style="v" sid="1CO 14:7"/>Bandkwah nǝ dǝgitahan kwa maay dǝ shifǝgi band faakǝlla ard kakanghya. Akwama cǝngalbi nǝ tlavatǝr ba vaivai biya, da sǝrga ndandar nǝ uudan kǝ dǝgiti tsava ard kwa fǝrtavvi? <verse eid="1CO 14:7"/><verse number="8" style="v" sid="1CO 14:8"/>Akwama fǝrtavantbi nǝ dǝrau ba vaivai kwa da cǝnngalcǝng biya, war wa da ɓadlava da ghwaavi? <verse eid="1CO 14:8"/><verse number="9" style="v" sid="1CO 14:9"/>Bandkwah dlaɓ kǝskuurama, akwama tagamatag kǝ ǝlbǝg dǝ ghaiya kwa nǝghvaaka biya, da sǝr vaaka ndandar nǝ dǝgiti am tag nǝ uurami?Ttagamatag kǝ ǝlbǝg ba gyagyaana. <verse eid="1CO 14:9"/><verse number="10" style="v" sid="1CO 14:10"/>Mǝng nǝ ghaiyah shahshah ma duniya, ma kwaratǝra ba tuuk kǝ ǝlbǝga. <verse eid="1CO 14:10"/><verse number="11" style="v" sid="1CO 14:11"/>Akwama ǝn cǝnngabi kǝ ghaiyin biya, nanalnǝg kǝ ghulab kǝ daddakwa ta ǝlbǝgiina. <verse eid="1CO 14:11"/><verse number="12" style="v" sid="1CO 14:12"/>Bandkwah dlaɓ kǝskuurama, ma bam hwaɗaaga tlǝkǝna vǝlg shahshah dǝga shǝdkwa caccuwanacaccuwana, ɓagamɓag kǝla ndzǝɗaruwa am ɓa tlǝr dǝ lii da fǝgara zaa vuuka kǝ dlamakǝwa lii gatǝga. <verse eid="1CO 14:12"/><verse number="13" style="v" sid="1CO 14:13"/>Mbakyarvad kwaha baɗǝm nǝ daddakwa taa ǝlbǝg dǝ kwatlǝr kǝ ghaiya, aa dzug kǝ zhǝgǝla vǝlvar nǝ sǝrgasǝrga gwiiya ghaiyiina. <verse eid="1CO 14:13"/><verse number="14" style="v" sid="1CO 14:14"/>Akwama dzǝgwanadzug kǝ zhǝgǝl ma ghaiyi tlǝrna, ba kai dǝ ghǝrar wa dzǝgwazhǝgǝla, hǝnkalara maay ǝmtaɗ dǝ kaiyi. <verse eid="1CO 14:14"/><verse number="15" style="v" sid="1CO 14:15"/>Auci, wan da ɓag naiyi? Ən da dzugazhǝgǝl bad ǝrvidmahuɗara, ǝn dǝgwadzug kǝ zhǝgǝl dlaɓ dǝ nǝghǝgakanǝghǝgara. Ən ɓǝlgaɓǝlg kǝ ngǝssa gala Daadamazhigǝl bad ghǝrarra, dlaɓa ǝn ɓǝlgaɓǝlg baz ma hǝnkalarra. <verse eid="1CO 14:15"/><verse number="16" style="v" sid="1CO 14:16"/>Akwama maay ǝndkwah biya, akwama taghartag kǝ́ uus kǝ Daadamazhigǝl ba maghǝragh kaltiya, da tag ndandar nǝ daddakwa cǝnngabi kǝ dǝgiti agha tag nǝng taaki, “Amin” tǝghǝr kǝ taa uusi agha tag nǝng, akwama sǝrgabi kǝ dǝgiti agha tag nǝng biyi? <verse eid="1CO 14:16"/><verse number="17" style="v" sid="1CO 14:17"/>Aaadzu ba tagharatag kǝ uus kǝ Daadamazhigǝl ba vaivaiya, mǝlgharuubi kǝ uuda nǝ iin biya. <verse eid="1CO 14:17"/><verse number="18" style="v" sid="1CO 14:18"/>Ən tagar uus kǝ Daadamazhigǝl ǝn tagatag kǝ ǝlbǝg dǝ ghai shahshah tǝghǝr kǝskuuram baɗǝmma. <verse eid="1CO 14:18"/><verse number="19" style="v" sid="1CO 14:19"/>Bakǝvakwaha ma dzahava dlamakǝlaaa lii gatǝga, mana naag nai ǝn tagda kǝ ǝlbǝg ba dlǝɓ dǝ dzamaghǝrar kiyava tsagturu kǝ kyalmaha, tǝghǝr kǝ tagda ǝlbǝgah ɗǝbu kǝlawa dǝ kwatlǝr kǝ ghaiya. <verse eid="1CO 14:19"/><verse number="20" style="v" sid="1CO 14:20"/>Zaraabahara, dzamambi kǝ dǝgit band zarhah biya, bamma tǝdvad ɓa dǝga kǝladǝra namalnǝg band zarhaha, kuurama aa nalnǝg nǝ dzamaghǝraru ba kǝ dǝga uudah maamala. <verse eid="1CO 14:20"/><verse number="21" style="v" sid="1CO 14:21"/>Viindaviindan ma kakaɗa Daadamazhigǝl taakiya, “Ən da tagan kǝ ǝlbǝg dǝ uudahah tǝdvad uudahi kwar taa ghaiy shahshaha, ard ghaiya ghulabaha, bakǝvakwaha ar maay cǝngwanacǝng biya, am nǝ Yaazhǝgǝla.” <verse eid="1CO 14:21"/><verse number="22" style="v" sid="1CO 14:22"/>Mbats, sǝrga taa ghaiy shahshaha mbakyarvad dǝga sǝrg kǝ yaa dadda gatǝg biya, bamma kǝ lii ar maay gata yesu biya. Taa tlayanngǝra mbakyarvad kǝ lii dǝ fadghǝra, kiyava lii maay dǝ fadghǝr biya. <verse eid="1CO 14:22"/><verse number="23" style="v" sid="1CO 14:23"/>Mbakyarvad kwaha, akwama dzaharvǝtdzahǝg nǝ dlɑmakǝlawa lii gatǝg baɗǝmma, ma kwarayǝra ar taa ǝlbǝg dǝ ghaiy shahshaha, ka sagau kǝ kyalma uudahi ar sǝrgabi kǝ dǝgiti ar tag nǝ iitǝr biya, ma lii ar maay gata Yesu biya, mbats, ar maay tagan taaki am valagah biya? <verse eid="1CO 14:23"/><verse number="24" style="v" sid="1CO 14:24"/>Akwama taaki baɗǝmmaruwa am taa tlayanngǝra, ma tlakuratlǝg nǝ daddakwa maay gata Yesu ard kwa sǝrgai kǝ dǝgiti tagav biya, kaa cǝnngan kǝ dǝgiti tagava, ngal ba pǝlla ghǝra. <verse eid="1CO 14:24"/><verse number="25" style="v" sid="1CO 14:25"/>Da kwaɗa sagal nǝ dǝgiti ma ǝrvǝdmahuɗaana, tǝdvadkwaha da mbuɗa dama haaya ɓagarnǝs kwatǝnahǝr kǝ Daadamazhigǝla, ngal taakiya, “Bak jirjira mǝng nǝ Daadamazhigǝl ma kuurama.”<verse eid="1CO 14:25"/></para>
  <para style="s">Aa ɓagav ɓag nǝ kwatǝnahǝr band kwa nahavva</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26"/>Wan nǝ dǝgiti ǝn tagkur naiy zaraabahaara, akwama da dzahamvǝtdzahǝga, kwana ɓǝla ngsa gala Daadamazhigǝla, kwana tsaga dǝgita, taa dǝgitaha, kwana taa ǝlbǝg dǝ kwatlǝr ghaiy shaha, kwana gwiiya ghaiya. Bagamɓag baɗumma mbakyarvad mǝlgaru kǝ dlamakǝlwa lii gatǝga. <verse eid="1CO 14:26"/><verse number="27" style="v" sid="1CO 14:27"/>Akwama mǝng nǝ lii taa ǝlbǝg dǝ kwatlǝr ghaiya, aa juubi ba kǝ uud buwa ma hǝkǝrɗ biya, aa ɓagarɓag ba tǝdǝv tǝdǝva, kwatlǝrna gwiiya dǝgiti tagava. <verse eid="1CO 14:27"/><verse number="28" style="v" sid="1CO 14:28"/>Akwama maay nǝ dadda gwiigan biya, aa ndzarandzǝg ba dǝw ma dzahava dlamakǝlaaa. Aa tagartag kǝ ǝlbǝg kǝ ghǝra ard Daadamazhigǝla. <verse eid="1CO 14:28"/><verse number="29" style="v" sid="1CO 14:29"/>Lii taa tlayanngǝra, aa tagartag ba nǝ uud buwa ma hǝkǝrɗ kǝ ǝlbǝga. Kyalmaha ar tsǝgwa hyǝmiya dǝgiti tagava. <verse eid="1CO 14:29"/><verse number="30" style="v" sid="1CO 14:30"/>Akwama taghartag nǝ Daadmazhǝgǝl kǝ ǝlbǝg kǝ uudani cǝghurga vakwahiina, daddakwa taa ghaiy ba zuungwna ghacaan kǝ taa ghaiya. <verse eid="1CO 14:30"/><verse number="31" style="v" sid="1CO 14:31"/>Baɗǝmmaruwa am tagatag kǝ ǝlbuga Daadamazhigǝla, ba da palla palla, kiyava tsagan kǝ uudaha, dlaɓa ar tlǝkǝna kǝ ndzǝɗa. <verse eid="1CO 14:31"/><verse number="32" style="v" sid="1CO 14:32"/>Lii vǝlavtǝr nǝ sǝrgasǝrga taa tlayanngura, ba iitǝr dǝ ghǝraatǝr wa tagaana. <verse eid="1CO 14:32"/><verse number="33" style="v" sid="1CO 14:33"/>Aɗaba Daadamazhigǝla miiyama Daadamazhigǝla ciya hǝnkal biya, Daadamazhǝgǝlaaa gabǝrra. Band kwaha vak dlamakǝlaaa lii gatǝga. <verse eid="1CO 14:33"/><verse number="34" style="v" sid="1CO 14:34"/>Ɓagaɓag kǝ marau ar ndza nǝmghwasah ba dǝw ma dzahava dlamakǝlaaa lii gatǝga, aɗaba vǝlavtǝrbi nǝ duula taa ghaiy biya, bama ar ɗaba dǝgiti tagaa nadzahadzaha muus taaki. <verse eid="1CO 14:34"/><verse number="35" style="v" sid="1CO 14:35"/>Akwama mǝng nǝ dǝgiti ar naa sǝrga nǝ iitǝra, aa ndavarndavǝg vak zhiilahatǝr ma hǝnyaha. Aɗaba dǝga zhǝrw kǝ ǝnghwasah taa ghaiy ma dlamakǝlaaa lii gatǝga. <verse eid="1CO 14:35"/><verse number="36" style="v" sid="1CO 14:36"/>Fǝgharzha bat kuuram nǝ ǝlbǝga Daadamazhigǝla, nii ba kuurama pal ha wa dal nǝ ǝlbugiin da vakaruwi? <verse eid="1CO 14:36"/><verse number="37" style="v" sid="1CO 14:37"/>Akwama mǝng nǝ daddakwa tlatla taaki tlayanng nǝ iina, aandzu ma vǝlavar nǝ sǝrgasǝrgǝra, aa nǝghakanǝghǝg taakiya, dǝgitahaan ǝn viindkurnaiyna ǝlbuga Yaazhǝgǝla. <verse eid="1CO 14:37"/><verse number="38" style="v" sid="1CO 14:38"/>Akwama lawalǝg nǝ uudan kǝ fa hyǝmiya tǝ kwanna, ghǝravan ndakwani da lǝvwalǝg nǝ uud kǝ fa hyǝmiy tǝ vakaiya. <verse eid="1CO 14:38"/><verse number="39" style="v" sid="1CO 14:39"/>Mbakyarvad kwaha zaraabahaara, nahamnahǝg kǝ taa ǝlbǝga Daadamazhigǝla, tsamarǝvbi dlaɓ kǝ uud kǝ taa ghaiy dǝ kwatlǝr kǝ ghaiyah biya. <verse eid="1CO 14:39"/><verse number="40" style="v" sid="1CO 14:40"/>Aa ɓagavɓag nǝ dǝgit bat duulan ba kalkalla, dlaɓa ɓadlǝvnanna.<verse eid="1CO 14:40"/></para>
  <chapter eid="1CO 14"/>
  <chapter number="15" style="c" sid="1CO 15"/>
  <para style="s">Ciiga tlǝkatǝg ma gǝtlaha</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1"/>Ndakwana, ǝn da dzamkurnǝsdzamǝg kǝ ǝlbug marawǝn kwa tagankur naiyiin zaarabahaara, kwa caawama nǝ uuramna, dlaɓa kwa famdǝghǝrǝt nǝ uurama. <verse eid="1CO 15:1"/><verse number="2" style="v" sid="1CO 15:2"/>Tǝdvad ǝlbug marawa wa tlakǝna nǝ uuram kǝ katǝga, akwama hǝkyamnahǝkyǝg kǝ ǝlbugǝn tagankur naiyiin ba matrawa, ma maay ndkwah biya, fadghǝraruwa ba gyagyaana. <verse eid="1CO 15:2"/><verse number="3" style="v" sid="1CO 15:3"/>Dǝgitiin marauwǝn tagankur naiya, iin wa caawana naiy, taakiya, ǝmtsaǝmtsǝg nǝ Tlǝkatǝg mbakyarvad haipahaamiiyama, band kwa viindaviindan ma kakkaɗa Daadamazhigǝla, <verse eid="1CO 15:3"/><verse number="4" style="v" sid="1CO 15:4"/>Taaki hǝɗavahǝɗǝgga, dlaɓa ciiyavantciig tǝ hǝng hǝkǝrɗa, band kwa viinɗaviinɗan ma kakkaɗa Daadamazhigǝla, <verse eid="1CO 15:4"/><verse number="5" style="v" sid="1CO 15:5"/>maradamarg kǝ ghǝran vak kefasa, ard kǝlawa tar buwa. <verse eid="1CO 15:5"/><verse number="6" style="v" sid="1CO 15:6"/>Tǝhalakwaha mardan kǝ ghǝraan vak kǝ uudah kwa juujig kǝ dǝrmǝk dlǝɓa ba daval palla, kyalmahaatǝra ar ba dlaɓa bad shifǝga, kyalmah dlaɓa ǝmtsaharaǝmtsahǝga. <verse eid="1CO 15:6"/><verse number="7" style="v" sid="1CO 15:7"/>Tǝhalakwaha maradamarg kǝ ghǝran vak yakuba, ard dlakulva gyi Yesu baɗǝmma. <verse eid="1CO 15:7"/><verse number="8" style="v" sid="1CO 15:8"/>Tǝhalatǝr baɗǝma, maradamarg kǝ ghǝran dlaɓ vakara, bakǝvakwaha aandzu ba ǝn uudi yaava tǝ duula jirjir biya. <verse eid="1CO 15:8"/><verse number="9" style="v" sid="1CO 15:9"/>Aɗaba kai wa hǝdiikǝn ma dlakulva gyiyaha Yesu, tlanalbi naiy kǝ ɗaakwa nǝ uud dǝ dlakulva gyiya Yesu biya, mbakyarvad kai wa vǝlantǝr dlaɗ kǝ dlamakǝlaaa lii gata Daadamazhigǝla. <verse eid="1CO 15:9"/><verse number="10" style="v" sid="1CO 15:10"/>Mbakyarvad herǝrra Daadamazhigǝl wa nanal naiy ǝndkwana, dlaɓa herǝrrǝn ɓagghwi nǝ iina ba gyagyaan biya, aɗaba januujig aandzu kwar kǝ dlakulvaha gyiya Yesu dǝ tlǝrra, bakǝvakwaha mbakyarvad sǝrgasǝrgar biya, mbakyarvad herǝrra Daadamazhǝgǝli kwa ǝmtaɗ dǝ kaiya. <verse eid="1CO 15:10"/><verse number="11" style="v" sid="1CO 15:11"/>Aiciya, ma kaiya, ma iitǝraha, baɗǝmmamǝnda kǝm taa ba ǝlbǝg marawa, famdǝghǝrt tǝdvad kwan nǝ uurama.<verse eid="1CO 15:11"/></para>
  <para style="s">Ciig ma gǝtlaha</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12"/>Akwama ba tagav nǝ ǝlbǝg marawa ciiga Tlǝkatǝg ma gǝtlaha, aujibǝg ka cii kǝ kyalmaharu ar taakiya maay nǝ ciig ma gǝtlah biyi? <verse eid="1CO 15:12"/><verse number="13" style="v" sid="1CO 15:13"/>Akwama maay nǝ ciig ma gǝtlah biya, mbats, ciiyiit bi nǝ Tlǝkɑtǝg ma gǝtlah bi ciya. <verse eid="1CO 15:13"/><verse number="14" style="v" sid="1CO 15:14"/>Akwama ciiyiit bi nǝ Tlǝkatǝg ma gǝtlah biya, mbats, taa ǝlbǝg marawamǝnda ba gyagyaana, fadghǝraru dlaɓa nalnǝg ba gyagyaana. <verse eid="1CO 15:14"/><verse number="15" style="v" sid="1CO 15:15"/>Nalnǝgtaaki, tagamǝnda fiid tǝghǝr kǝ Daadamazhigǝl ciya, aɗaba tagamǝnda tag kǝ ǝlbǝg tǝghǝr kǝ Daadamazhigǝl taakiya ciighantciig kǝ Tlǝkatǝga, akwama ba ciighantbi tsa, bakjirjira maay nǝ ciig ma gǝtlah biya. <verse eid="1CO 15:15"/><verse number="16" style="v" sid="1CO 15:16"/>Akwama maay nǝ ciig ma gǝtlah biya, mbats, ciiyavatbi ci nǝ tlǝkatǝg biya. <verse eid="1CO 15:16"/><verse number="17" style="v" sid="1CO 15:17"/>Akwama ba ciiyavantbi nǝ tlǝkatǝg biya,mbats, fadghǝraruwa ba gyaagyaana, ba kǝvakwana am ba ndzǝganan ba ma haipaharuwa <verse eid="1CO 15:17"/><verse number="18" style="v" sid="1CO 15:18"/>Mbats, lii ǝmtsaharaǝmtsahǝg tǝ duula gata Tlǝkatǝga,zaraazǝg ciya. <verse eid="1CO 15:18"/><verse number="19" style="v" sid="1CO 15:19"/>Akwama faaghǝra miiyam tǝ Tlǝkatǝga kwakyarvad ba kiyava ndzǝgan kaltiya, mbats jiiyamujiig aandzu ba war kǝ dǝga zhuwaɗaala. <verse eid="1CO 15:19"/><verse number="20" style="v" sid="1CO 15:20"/>Bakjirjira, ciiyavantciig nǝ Tlǝkatǝg ma gɪtlaha. Inn wa tǝghal ba zuungw ma lii ma gǝtlaha. Bakjirjira maradamarg taakiya da ciiyav nǝ kyalmaha lii ǝmtsaharaana. <verse eid="1CO 15:20"/><verse number="21" style="v" sid="1CO 15:21"/>Aandzu ba sǝghǝv tǝdvad uud nǝ ǝmtsǝg, bandkwah dlaɓ nǝ ciig ma gǝtlaha sǝghǝv tǝdvad uuda. <verse eid="1CO 15:21"/><verse number="22" style="v" sid="1CO 15:22"/>Bandkwa ǝmtsǝg nǝ uud baɗǝm mbakyarvad Adamu, da ciiyav nǝ uud baɗǝm mbakyarvad Tlǝkatǝga. <verse eid="1CO 15:22"/><verse number="23" style="v" sid="1CO 15:23"/>Da ciiyav aandzu ma ba wara ba tǝdǝv tǝdǝvaana, Tlǝkatǝg nǝ tǝghǝga zuungwa, tǝhalakwaha lii ar da dǝgan daghuvali da saay nǝ iina. <verse eid="1CO 15:23"/><verse number="24" style="v" sid="1CO 15:24"/>Kaa da sagau nǝ ghyǝnnga duniya, ma sarta kwa da gwiigarda nǝ Tlǝkatǝg kǝ tlǝksǝran kǝ Daadamazhigǝl Daada, tǝhalakwama da kǝsatǝrva kǝsǝg kǝ ndzǝɗ kǝ lii kwarǝga baz tlǝksǝraatǝr baɗǝmma. <verse eid="1CO 15:24"/><verse number="25" style="v" sid="1CO 15:25"/>Aɗaba barari kǝ Tlǝkatǝg da kwarǝga, bamma fatǝrɗǝmfǝg kǝ tlǝghumahaan baɗǝm da miizhangyǝl kǝ shigahaana. <verse eid="1CO 15:25"/><verse number="26" style="v" sid="1CO 15:26"/>Dadda tlǝghummi kwa dǝga halli da ghyǝhava, iin nǝ ǝmtsǝga. <verse eid="1CO 15:26"/><verse number="27" style="v" sid="1CO 15:27"/>Aɗaba tagaatag nǝ ǝlbǝga Daadamazhigǝl taaki,“faɗǝmfǝg nǝ Daadamazhigǝl kǝ dǝgitah baɗǝm miizhagyǝl kǝ kwargana.” <verse eid="1CO 15:27"/><verse number="28" style="v" sid="1CO 15:28"/>Akwama da nadalnǝg nǝ Daadamazhigǝl kǝ dǝgitah baɗǝm da miizhagyǝl kwarga tlǝkatǝga, da nal dlaɓ nǝ zǝran da miizhagyǝl kǝ kwarga Daadamazhigǝl kwa nadal dǝgitah baɗǝm da miizha gyǝl kǝ iina, aɗaba Daadamazhigǝl dǝgit baɗǝm baɗǝmma. <verse eid="1CO 15:28"/><verse number="29" style="v" sid="1CO 15:29"/>Akwama maay ǝndkwah biya, auwa da ɓag nǝ uudahaan, kwa ɓagavtǝra nǝ tsufǝg mbakyarvad lii ma gǝtlahi? Ma ba maay nǝ ciig ma gǝtlah biya, aujibǝg ka cii ɓagavtǝra nǝ tsufǝg kǝ uudah mbakyarvad lii ma gǝtlahi? <verse eid="1CO 15:29"/><verse number="30" style="v" sid="1CO 15:30"/>Aujǝlbɔg dlaɓ kiyam fa ghǝramiiyam ba kǝlahǝng tǝ duula ǝmtsǝgi? <verse eid="1CO 15:30"/><verse number="31" style="v" sid="1CO 15:31"/>Ən nǝghǝganǝghǝg kǝ ǝmtsǝg ba kǝlahǝng zaraabahaara, bak jiijiira ǝn tsa kushǝgh dǝ kuuram ma Tlǝkatǝg Yesu Yaazhǝgǝlamiiyama. <verse eid="1CO 15:31"/><verse number="32" style="v" sid="1CO 15:32"/>Akawama tǝ naaga uuda, ma ɓaganaɓag kǝ ghwav dǝ dǝktǝghal ma Afisa, auci nǝ dǝkghigari? Akwama ba da maay nǝ uud ciig ma gǝtlah biya. “Ba kiyam zǝgaana kiiyam huɓǝgana, aɗaba kiyam da ǝmtsǝg dlakadur biya?” <verse eid="1CO 15:32"/><verse number="33" style="v" sid="1CO 15:33"/>Aa valkurdai nǝ uud biya, “Aɗaba ndzǝgan dǝ kǝladaha badzǝgaan kǝ uuda jirjira.” <verse eid="1CO 15:33"/><verse number="34" style="v" sid="1CO 15:34"/>Asamasaas da tǝ duula jirjira, am duuwant kǝ ɓa haipa. Aɗaba kyalmaharuwa ar sǝrgabi kǝ Daadamazhigǝl biya. Na taakwan naiya mbakyarvad am dǝm dama zhǝrwa.<verse eid="1CO 15:34"/></para>
  <para style="s">Ciig ma vǝgha</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35"/>Ar da ndavǝgan nǝ kyalmah yaakiya, “Da ciig ndandar nǝ lii ǝmtsahara ǝmtsahǝg ma gǝtlahi? Ar da sagal dǝ huulfa kwar kǝ vǝghǝghi?” <verse eid="1CO 15:35"/><verse number="36" style="v" sid="1CO 15:36"/>Kǝgh dlagǝna! dǝgiti aghaa riiga nǝnga da maay sagal biya bamma ǝmtsaǝmtsǝga. <verse eid="1CO 15:36"/><verse number="37" style="v" sid="1CO 15:37"/>Dǝgiti agha riiga nǝnga, da sagal bandkwahiin biya, ba zǝraana, ma zǝra hiiya ma zǝra dǝgiti tlǝrna shaha. <verse eid="1CO 15:37"/><verse number="38" style="v" sid="1CO 15:38"/>Ba Daadamazhigǝl wa vǝlga dzakǝva vǝgh kǝ zǝra dǝgita band kwa naag nǝ iina, ma kwar kǝ zǝra dǝgita bad dzakǝva vǝghaana. <verse eid="1CO 15:38"/><verse number="39" style="v" sid="1CO 15:39"/>Baɗǝm nǝ tluwa ba dǝgit pall biya. Uudaha bad hulfa dǝgahaatǝra, almanaha bad hulfa dǝgahaatǝra, ɗiikaha bad hulfa dǝgahaatǝra. Kǝlfah dlaɓa bad hulfa dǝgahaatra. <verse eid="1CO 15:39"/><verse number="40" style="v" sid="1CO 15:40"/>Mǝng hulfa ndǝrga ghǝrazhigǝla, mǝng nǝ hulfa dǝga haaya. Ndangǝra dǝga ghǝrazhigǝla shaha, ndangǝra hulfa dǝga haaya shaha. <verse eid="1CO 15:40"/><verse number="41" style="v" sid="1CO 15:41"/>Ndangǝra faciya shahha, dǝga kyǝlla shahha, dǝga kwadladlah dlaɓa shahha, mǝng dlaɓ nǝ kwatlǝr kǝ kwadladla shah dǝ kwatlǝr kǝ kwadlad vaka ndangǝra. <verse eid="1CO 15:41"/><verse number="42" style="v" sid="1CO 15:42"/>Bandkwah dlaɓ tǝghǝr kǝ ciig ma gǝtlaha, dǝgiti aa riivariiga da ǝrtsǝga, dǝgiti aa ciivanta da maay ǝrtsǝg biya. <verse eid="1CO 15:42"/><verse number="43" style="v" sid="1CO 15:43"/>Riivariig nǝ iin bamma dlaɗa, ciivantciig ma ndangǝra, riivariig ma maira ndzǝɗa ciivantciig dlaɓ ma ndzǝɗǝra. <verse eid="1CO 15:43"/><verse number="44" style="v" sid="1CO 15:44"/>Riivariig ma vǝgha uuɗǝra, ciivantciig dlaɓ dǝ ndzǝgana vǝgha shǝdkwa caccuwanacaccuwana. Aɗaba mǝng nǝ vǝgha uuɗǝra, ba jirjira mǝng nǝ vǝgha shǝdkwa caccuwanacaccuwana. <verse eid="1CO 15:44"/><verse number="45" style="v" sid="1CO 15:45"/>Viindaviindan bandkwah taakiya,“Adamu nǝ uuda zǝnngwa, kwa nal kǝ uuda dǝ shifǝga.” Adamudǝga halla iin shǝdkwa kwa vǝlla shifǝga. <verse eid="1CO 15:45"/><verse number="46" style="v" sid="1CO 15:46"/>Dǝga zǝnngw bi nǝ shiɗkw biya, dǝga tluwa ard avz nǝ dǝga zǝnngw lakwti kǝ shidkwa. <verse eid="1CO 15:46"/><verse number="47" style="v" sid="1CO 15:47"/>Uuda zǝnngwa ndǝrava dǝ haaya, sal ma haaya. Dǝga buwa sahi ma ghǝrazhigǝla. <verse eid="1CO 15:47"/><verse number="48" style="v" sid="1CO 15:48"/>Bandkwa dǝga haaya nǝ uuda, ar bandkwah dlaɓ nǝ lii dǝga haaya. Lii ar dǝga ghǝrazhigǝla, ar da bandkwa sahii ma ghǝrazǝgǝla. <verse eid="1CO 15:48"/><verse number="49" style="v" sid="1CO 15:49"/>Bandkwa kiyam garava daddakwa ndǝrava dǝ haaya nǝ miiyama, kiyam da nǝg dlaɓ kǝ garava daddakwa sahi ma ghǝrazhigǝla. <verse eid="1CO 15:49"/><verse number="50" style="v" sid="1CO 15:50"/>Dǝgiti ǝn tagkur naiya wah zaraabaharra, aɗaba ɓagabi kiyam tlǝkǝna kǝ gwiig ma tlǝkǝsa ghǝrazhigǝl dǝ vǝgha miiyam kwa dǝga tluwa ard avz biya, bandkwah dlaɓ nǝ daddakwa da ǝrtsǝga da maay gwiiya daddakwa maay ǝrtsǝg biya. <verse eid="1CO 15:50"/><verse number="51" style="v" sid="1CO 15:51"/>Ciinngamciinga, ǝn tagkurtag kǝ dǝgiti shiɓashiɓana! kiyam da baɗǝm ǝmtsǝg biya, aiciya da gwiiyav nǝ garava miiyam baɗǝmma, <verse eid="1CO 15:51"/><verse number="52" style="v" sid="1CO 15:52"/>Ba daval palla, band kǝbǝkyǝga gyiiya, ma ciingavaciing nǝ vǝrta dǝrawa, da ciiyav nǝ lii ma gǝtlaha dǝ vǝgh hulfa kwa da maay ǝrtsǝg biya, da gwiiyav nǝ ndzǝgana garava miiyama. <verse eid="1CO 15:52"/><verse number="53" style="v" sid="1CO 15:53"/>Aɗaba barari nǝ vǝghǝn kwa ǝrtsǝgǝna da gwiiyav nal kwa maay ǝrtsǝg biya, vǝghǝghi kwa da ǝmtsǝga da gwiiyav nal kwa maay ǝmtsǝg biya. <verse eid="1CO 15:53"/><verse number="54" style="v" sid="1CO 15:54"/>Tǝhalakwama gwiiyavant gwiig nǝ vǝghǝn kwa ǝrtsǝgǝn dat kwa maay ǝrtsǝgǝn biya, dlaɓa vǝghǝn kwa dǝga ǝmtsǝgǝn nal kwa maay ǝmtsǝgǝn biya, da righǝg ma sartakwa nǝ, ǝlbǝgǝn viindava ma kakkaɗa Daadamazhigǝl taakiya,“Ghyǝhavna ghyǝhǝg nǝ ǝmtsǝga, zavuzǝg nǝ fiir tǝghǝra. <verse eid="1CO 15:54"/><verse number="55" style="v" sid="1CO 15:55"/>Kǝgh ǝmtsǝga, mǝr nǝ za fiiraghi? Kǝgh ǝmtsǝga mǝr nǝ guraghi?” <verse eid="1CO 15:55"/><verse number="56" style="v" sid="1CO 15:56"/>Abi haip nǝ gura ǝmtsǝga, tlakǝna tǝdvad shari nǝ ǝmtsǝg kǝ ndzǝɗa. <verse eid="1CO 15:56"/><verse number="57" style="v" sid="1CO 15:57"/>Tagiiyamartag kǝ uus kǝ Daadamazhigǝl kwa vǝl kiyam zaa fiir tǝdvad Yaazhǝgǝl Yesu Tlǝkatǝga! <verse eid="1CO 15:57"/><verse number="58" style="v" sid="1CO 15:58"/>Mbakyarvad kwah zaraabahara kwan waikur naiya, ghacaamaghaciig ba marawa, ba kǝlahǝnga am ɓagar tlǝr kǝ Tlǝkatǝga, aɗaba am sǝran taakiya dlaɗǝn am huɓǝg nǝ uuram mbakyarvad Yaazhǝgǝla ba gyagyaan biya.<verse eid="1CO 15:58"/></para>
  <chapter eid="1CO 15"/>
  <chapter number="16" style="c" sid="1CO 16"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1"/>Aiciya, ǝlɓǝga mǝltǝru kǝ yaa daddaha gatǝga, ɓagamɓag bandkwa taganter nai kǝ dlamakǝla lii gatǝga kwa ma Galatiya taaki aa ɓagarɓaga. <verse eid="1CO 16:1"/><verse number="2" style="v" sid="1CO 16:2"/>Ma kwar kǝ laada, am fǝgaan kǝ kwaɓa kalkala dǝgiti tlǝkǝna nǝ uudana, bamma ǝn sǝgǝv naiy lakwti am da dzaha dǝgiti kwa da mǝlvaru kǝ uud biya. <verse eid="1CO 16:2"/><verse number="3" style="v" sid="1CO 16:3"/>Akwama da danǝv dǝga, ǝn da ɓǝltǝrant kǝ lii haiyamant_haig nǝ uuram dǝ iitǝra, ǝmtad dǝ wakiita mara ghǝraatǝra. <verse eid="1CO 16:3"/><verse number="4" style="v" sid="1CO 16:4"/>Akwama ɓagaɓag kǝ maraw ǝn dǝv naiy ndakwani, bar da pughkwazhana.<verse eid="1CO 16:4"/></para>
  <para style="s">Ɓadlava dagalla</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5"/>Ən da dagau da vakaruwa da tagkur uusaa, tǝhalakwama gwayavagwaiga ma haaya makiduniya, aɗaba ǝn naagan kǝ dagal damma makiduniya. <verse eid="1CO 16:5"/><verse number="6" style="v" sid="1CO 16:6"/>Mbatak ǝn da zǝlmazǝlǝmǝg vakaruwa, ǝn da ghyǝnngǝna kǝ viiyaksa vaksruwa, aɗaba am da mǝlwad ba kǝla vakavaki ǝn da dagal naiya. <verse eid="1CO 16:6"/><verse number="7" style="v" sid="1CO 16:7"/>Dǝ naagarbi akwama nǝghankurnǝghǝg ǝn tsǝkura dǝ fǝt biya, mana naag nai ǝn ɓaga kǝ hǝngah vakaruwa, akwama haighant nǝ Yaazhǝgǝla. <verse eid="1CO 16:7"/><verse number="8" style="v" sid="1CO 16:8"/>Ən da ghacig ma Afisa ǝn da pakant kǝ sarta fentikus. <verse eid="1CO 16:8"/><verse number="9" style="v" sid="1CO 16:9"/>Aɗaba wurghwantwurg nǝ uud kǝ ɗuul ba banngang kiyava ɓa tlǝr marauwa, aandzu ba mǝng nǝ tlǝghumah ba ɗyǝka. <verse eid="1CO 16:9"/><verse number="10" style="v" sid="1CO 16:10"/>Akwama sǝghǝvsǝg nǝ timuti da vakaruwa, aa ɓalaɓalǝg nǝ ghǝraana aa gǝdzǝ biya, aɗaba iin ndakwani ɓa tlǝra Yaazhǝgǝl band kaiya. <verse eid="1CO 16:10"/><verse number="11" style="v" sid="1CO 16:11"/>Mbakyarvad kwaha aa nenne bi aandzu ma war biya, am mǝlaruwa dǝ dǝgita kiyava sagau da vakara, aɗaba gyiiyar ba tǝ duula kǝ paka ba iina ǝmtaɗ da zarabaha. <verse eid="1CO 16:11"/><verse number="12" style="v" sid="1CO 16:12"/>Əlbǝga zǝrabamiiyam Afullusa, ghalanghalǝg ma sǝv da vakaru ǝmtaɗ dǝ kyalma zarabaha, haighant bi kǝ dagau ndakwan biya, bamma da tlakǝnatlǝg kǝ sarta lakwti da dagauwa.<verse eid="1CO 16:12"/></para>
  <para style="s">Əlbǝga mbasumbasa</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13"/>Ɓadlamvaɓadlǝg ba marawa, am ghacan tǝ fadghǝraruwa ba vaivaiya, am ɓǝlgan kǝ magiya am fǝgab kǝ ndzǝɗa. <verse eid="1CO 16:13"/><verse number="14" style="v" sid="1CO 16:14"/>Baɗǝm nǝ dǝgiti am ɓag nǝ uurama, ɓagamɓag ba dǝ waiyakǝvǝra. <verse eid="1CO 16:14"/><verse number="15" style="v" sid="1CO 16:15"/>Aici, zarabahara, am sǝran taaki uudaha hǝnyaha Istafanus wa fararzhz ba zǝngw kǝ pǝlaghǝr ma haaya Akaya, vǝlardavǝlǝg kǝ ghǝraatǝr kiyava ɓa tlǝr kǝ ya dadda gatǝga. <verse eid="1CO 16:15"/><verse number="16" style="v" sid="1CO 16:16"/>Ən ghalakurama am faara kǝ hulfa kwanahaan kǝ uudaha, ba tsaghwaha ɓa tlǝramnd baɗǝmma kwa kǝm huɓa dlad dǝ iitǝra. <verse eid="1CO 16:16"/><verse number="17" style="v" sid="1CO 16:17"/>Cinganucing kǝmtakera sagauwa Istafanusa, Fartunatus, ard Akaikus, kwa nǝgal vakar mandki kuuram wa sǝgǝvsǝga. <verse eid="1CO 16:17"/><verse number="18" style="v" sid="1CO 16:18"/>Aɗaba ɓagarwiiɓag kǝ dǝgit maraw tǝrvidara, baz dǝgaruwa. Hulfa kwan kǝ uudaha kalkalan ma fǝfteraarana. <verse eid="1CO 16:18"/><verse number="19" style="v" sid="1CO 16:19"/>Araa tagkur uus nǝ dlamakǝlaaa lii gatǝg kwama haaya Asiya. Akila ard Biriskila, ǝmtaɗ dǝ dlamakǝlaaa lii gatǝg kwa dzaharvǝt ma hǝnyahaatǝra, ar tagkur uss ba vaivai ma ɗaaga Yaazhǝgǝla. <verse eid="1CO 16:19"/><verse number="20" style="v" sid="1CO 16:20"/>Baɗǝm nǝ zaraabaha ar tagkur uusa. Tagamartag kǝ uus kǝ kyalmaharuwa ǝmtaɗ dǝ bǝrhuga. <verse eid="1CO 16:20"/><verse number="21" style="v" sid="1CO 16:21"/>Ba kai Bulus dǝ ghǝrar wan viinda tagkur uusa. <verse eid="1CO 16:21"/><verse number="22" style="v" sid="1CO 16:22"/>Baɗǝm nǝ daddakwa maay waiya Yaazhǝgǝl biya tlafatlafana. Aseg, Yaazhǝgǝla! <verse eid="1CO 16:22"/><verse number="23" style="v" sid="1CO 16:23"/>Herǝrra Yaazhǝgǝla Yesu aa ndzandzǝg ǝmtaɗ dǝ kuurama. <verse eid="1CO 16:23"/><verse number="24" style="v" sid="1CO 16:24"/>Aa ndzandzǝg nǝ wayakǝvar tǝghǝr kǝskuuram ma ɗaag Tlǝkatǝg Yesu. Amin.<verse eid="1CO 16:24"/></para>
  <chapter eid="1CO 16"/>
</usx>
