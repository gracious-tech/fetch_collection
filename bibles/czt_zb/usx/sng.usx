<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="SNG" style="id">Baebu Thyaa</book>
  <para style="h">SOLOMON HLAW</para>
  <para style="toc1">Song of Solomon</para>
  <para style="toc2">SOLOMON HLAW</para>
  <para style="toc3">Sol</para>
  <para style="mt1">SOLOMON HLAW</para>
  <para style="mt2">Song of Solomon</para>
  <para style="imt">Byalaanmaw</para>
  <para style="ip">Solomon Hlaw cikuhpaw hynh Hlaw kyaze Ahoy huaccepaw Hlaw cite Hebru Baebu kya a um. Nopi te pise sungsakunaw byarui thua zah, Solomon nynh a phuapaw nynh thua cite a tua hae keiccuze Solomon Hlaw a ci hae.</para>
  <para style="ip">E hlaw hae hynh Judah hae nynh tuh Pachia te a ccungccaw hae laku ccuepekunaw a langsakuhpaw sakhung nynh thua cite ho hae zah, Khriccaaw hae nynh tuh Khri te khriccaawbuu laku ccuepekunaw a langsakuhpaw sakhung nynh thua a ci hae.</para>
  <para style="iot">Abyalupi hae</para>
  <para style="io1">Hlaw kheitnaw 1.1—2.7</para>
  <para style="io1">Hlaw ningnaw 2.8—3.5</para>
  <para style="io1">Hlaw thumnaw 3.6—5.1</para>
  <para style="io1">Hlaw palinaw 5.2—6.3</para>
  <para style="io1">Hlaw pangawnaw 6.4—8.4</para>
  <para style="io1">Hlaw taruhnaw 8.5-14</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hlaw hae kyaze ahoy huaccepaw Solomon hlaw.</para>
  <para style="b" />
  <para style="s1">Akaenung Liaccanung te A Ban hae<note caller="-" style="x"><char style="xo" closed="false">1.1: </char><char style="xt" closed="false"><ref loc="1KI 4:32">1Si 4.32</ref></char></note></para>
  <para style="q1">
    <verse number="2" style="v" />A mung te kae hynh</para>
  <para style="q2">yn myng sah!</para>
  <para style="q1">Pawccecize na sungsahnaw tuh</para>
  <para style="q2">misutui laeze athuahua,</para>
  <para style="q1">
    <verse number="3" style="v" />na thuhkupaw chitui tuh</para>
  <para style="q2">amynkhuh, na min tuh zimuin</para>
  <para style="q1">alaekuhpaw hawte amynkhuh;</para>
  <para style="q2">tukeiccuze liaccady hae nynh</para>
  <para style="q2">nang kha ae sungsah hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Kae hynh yn cciakhae lah,</para>
  <para style="q2">rangsakuh sih.</para>
  <para style="q1">Siapharan nynh a khaan</para>
  <para style="q2">lungkhu lang yn teekhae vae.</para>
  <para style="q1">Na kya kae lungtua cih zah</para>
  <para style="q2">kae lungpaw cih; na sungsahnaw kha</para>
  <para style="q1">misutui laeze kae thehoysah cih;</para>
  <para style="q2">nang kha ae sungsah ccaccing hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" />Pou Jerusalem ccanung hae,</para>
  <para style="q2">kae tuh Kedar bu hawte nynh ka thua,</para>
  <para style="q1">ka ngesaw tuh aman zemah</para>
  <para style="q2">Solomon inn kya-e</para>
  <para style="q2">zokhawpaw boei hawte ka puithya.</para>
  <para style="q1">
    <verse number="6" style="v" />Khuanin nynh phang yn e zah</para>
  <para style="q2">ka ngesaw aman keiccuze</para>
  <para style="q1">kae hynh yn dobung nan oh.</para>
  <para style="q2">Ka nung ccapaw hae nynh</para>
  <para style="q1">mih thin yn rianua hae,</para>
  <para style="q2">minmin nynh misu khokhu</para>
  <para style="q1">ngawtu lang yn nung hae,</para>
  <para style="q2">ka misu khokhu kha</para>
  <para style="q2">ka ngawkuh khyh!</para>
  <para style="q1">
    <verse number="7" style="v" />Ka hiinnaw nynh a sungsahpaw nang,</para>
  <para style="q2">na tuuphu na paeesakunaw te</para>
  <para style="q1">ninthu kya na ryasahnaw hae kha</para>
  <para style="q2">yn hopya tua; pawccemou</para>
  <para style="q1">kae tuh na ban hae tuuphu pe kya</para>
  <para style="q2">thuruh athuapaw hawte</para>
  <para style="q2">ka thua lanpaw tuh?</para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" />Pou nopi hae laku kyaze</para>
  <para style="q2">sungsah lan um huaccepaw,</para>
  <para style="q1">na ny khyh ze, tuuphu hae</para>
  <para style="q2">ccunoh kha zui lah,</para>
  <para style="q1">tuurin hae bu pe khe</para>
  <para style="q2">na tuutaw hae kha paeesakuh hae.</para>
  <para style="b" />
  <para style="s1">Zudy Ccangvaepaw, Ruiban hae, Akaenung</para>
  <para style="q1">
    <verse number="9" style="v" />Ka sungsahnung, nang hynh</para>
  <para style="q2">Faro marangle a sue hae paw laku e</para>
  <para style="q2">rangpinung te kae touse.</para>
  <para style="q1">
    <verse number="10" style="v" />Na byaki tuh ccaankunawpaw te</para>
  <para style="q2">kou puithya zah, na nging tuh</para>
  <para style="q2">aphutepaw lung suisi te kou puithya.</para>
  <para style="q1">
    <verse number="11" style="v" />Kaening nynh ngun te ccaankuhpaw</para>
  <para style="q2">suisi kha kae raepah ung cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" />Siapharan tuh a haungnaw vawlan</para>
  <para style="q2">a um lyakhe, ka zimuin myn tuh akhuh.</para>
  <para style="q1">
    <verse number="13" style="v" />Ka sungsah tuh ka hanlan</para>
  <para style="q2">ka by vawlan umpaw</para>
  <para style="q2">mura mynkhuh hawte nynh thua.</para>
  <para style="q1">
    <verse number="14" style="v" />Ka sungsah tuh ka hanlan</para>
  <para style="q2">En-gedi misu khokhu kya</para>
  <para style="q2">a pawpaw henna nge hawte nynh thua.</para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" />Pou ka sungsahnung,</para>
  <para style="q2">nang tuh na puithya;</para>
  <para style="q1">myarya na puithya;</para>
  <para style="q2">na mit tuh vahu te nynh aloku.</para>
  <para style="q1">
    <verse number="16" style="v" />Pou ka sungsahpaw,</para>
  <para style="q2">nang tuh na puithya;</para>
  <para style="q1">sungsah lan na um ccaccing.</para>
  <para style="q2">Aening iphae tuh ahinpaw zong nynh thua;</para>
  <para style="q1">
    <verse number="17" style="v" />aening inn kya-e</para>
  <para style="q2">atung accaw hae tuh sidar thing thua zah,</para>
  <para style="q1">aening inn kya dawkuhpaw tuh</para>
  <para style="q2">maeccaw ku nynh thua.</para>
  <para style="b" />
  <chapter number="2" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Kae tuh Sharon ramkaw e</para>
  <para style="q2">ningsi haetapaw,</para>
  <para style="q1">accya kya-e lili haetapaw hawte</para>
  <para style="q2">nynh ka thua.</para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" />Liaccaw hae lakuze</para>
  <para style="q2">ka sungsahnung tuh</para>
  <para style="q1">Hinpaw hae lakuze</para>
  <para style="q2">lili haetapaw hawte nynh thua,</para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" />Ccangvae hae lakuze</para>
  <para style="q2">ka sungsahpaw tuh</para>
  <para style="q1">tuthing hae lakuze</para>
  <para style="q2">epal ku hawte nynh thua.</para>
  <para style="q1">A mynlyh kyakhe ka haung zah</para>
  <para style="q2">myaryamaw ka lungrythuakhaekuh,</para>
  <para style="q2">a thae kha ka taangtua zah a e.</para>
  <para style="q1">
    <verse number="4" style="v" />Poituanaw inn kalan kae kha</para>
  <para style="q2">yn cciakhae zah,</para>
  <para style="q1">ka tungvaw a eenaw tuh</para>
  <para style="q2">sungsakunaw nynh thua.</para>
  <para style="q1">
    <verse number="5" style="v" />Misu thae aroupaw khate</para>
  <para style="q2">ka thawzung yn umsah,</para>
  <para style="q1">epal thae khate ka thaw bua yn saesah;</para>
  <para style="q2">pawccecize sungsakunaw keiccuze</para>
  <para style="q2">ka thawzung phe ting.</para>
  <para style="q1">
    <verse number="6" style="v" />A voilang kuih te yn kui sah lah,</para>
  <para style="q2">a ranglang kuih nynh yn pom sah!</para>
  <para style="q1">
    <verse number="7" style="v" />Pou Jerusalem ccanung hae,</para>
  <para style="q2">ka sungsahnung tuh</para>
  <para style="q1">amaw tho lan a tho mawlaezung</para>
  <para style="q2">na tho khyh nawlan oh,</para>
  <para style="q1">sazuh hae khyhze sazaw hae min phyate</para>
  <para style="q2">bya kae taw oh!</para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" />Ka sungsahpaw roi khaw!</para>
  <para style="q2">Dotua, aning tuh muapi hae te</para>
  <para style="q1">sangpyng hae vawlan</para>
  <para style="q2">thohkute yn cceih vae.</para>
  <para style="q1">
    <verse number="9" style="v" />Ka sungsahpaw tuh sazaw khyhze</para>
  <para style="q2">zuhnia taraw te nynh a loku.</para>
  <para style="q1">Dotua, thanlan-aw kyate</para>
  <para style="q2">a lungkhu lang riri dote,</para>
  <para style="q1">thanlan-aw a ua kyate dophite</para>
  <para style="q2">aening lungrua nulang khe a thadyn.</para>
  <para style="q1">
    <verse number="10" style="v" />Ka sungsahpaw nynh yn hopya:</para>
  <para style="q2">“Ka sungsahnung, puithyanung,</para>
  <para style="q2">thokuh lah, yn cciatua;</para>
  <para style="q1">
    <verse number="11" style="v" />atu tuh khuaccih athang vae,</para>
  <para style="q2">ccupi thang vae zah khuaa akan vae.</para>
  <para style="q1">
    <verse number="12" style="v" />Ramkaw kya haetapaw yn paw vae;</para>
  <para style="q2">pavaw sia ccyh thua vae zah,</para>
  <para style="q1">aening ram kya vahu roi thae lan um vae.</para>
  <para style="q1">
    <verse number="13" style="v" />Thaeku ku nynh athae kha voisah zah,</para>
  <para style="q2">misu paw mynkhuh tuh apaw vae;</para>
  <para style="q2">ka sungsahnung, puithyanung,</para>
  <para style="q1">thokuh lah, yn cciatua.</para>
  <para style="q1">
    <verse number="14" style="v" />Muihthya um leinaw lungkarung kya,</para>
  <para style="q2">chiapi lung hae laku kya-e ka vahu,</para>
  <para style="q1">na mitmae beih yn muihsakuh,</para>
  <para style="q2">na roi beih yn thaesah;</para>
  <para style="q1">pawccecize na roi tuh ngae ry um zah,</para>
  <para style="q2">na mitmae tuh sungsah lan kou um.</para>
  <para style="q1">
    <verse number="15" style="v" />Misu khokhu a rohpaw suizaw hae te</para>
  <para style="q2">suizaw taw hae kha kyng oh,</para>
  <para style="q1">pawccecize aening misu khokhu e</para>
  <para style="q2">misu hae tuh apaw paw cciamang hae,” a ci.</para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" />Ka sungsahpaw tuh ka kya-e thua zah,</para>
  <para style="q2">kae tuh a kya-e nynh ka thua;</para>
  <para style="q1">a tuuphu kha lili paw hae laku khe</para>
  <para style="q2">a paeesaku hae.</para>
  <para style="q1">
    <verse number="17" style="v" />Khuadae mawlaezung te</para>
  <para style="q2">mohnaw mynlyh a ccue mawlaezung,</para>
  <para style="q1">ka sungsahpaw Bether mua vawlan e</para>
  <para style="q2">sazaw hawte thuasah,</para>
  <para style="q1">sazuh taraw hawte thuasah yn kithui.</para>
  <para style="b" />
  <chapter number="3" style="c" />
  <para style="s1">Sungsahnung Maan</para>
  <para style="q1">
    <verse number="1" style="v" />Ka hiinnaw nynh a sungsahpaw kha</para>
  <para style="q2">khuazi kya ikhung vawlan khe ka ccung;</para>
  <para style="q1">amaw kha ka ccung zemah</para>
  <para style="q2">ka muih khyh; ka ko zemah</para>
  <para style="q2">yn oi khyh.</para>
  <para style="q1">
    <verse number="2" style="v" />“Atu ka thokuh cih zah</para>
  <para style="q2">khuapi lungkhu laanpi hae kya te</para>
  <para style="q1">laanpi atungkunaw hae kya</para>
  <para style="q2">ka khiakuh cih;</para>
  <para style="q1">ka hiinnaw nynh a sungsahpaw kha</para>
  <para style="q2">ka ccung cih,” ka ci zah,</para>
  <para style="q2">amaw kha ka ccung zemah ka muih khyh.</para>
  <para style="q1">
    <verse number="3" style="v" />Rhawviatu hae nynh</para>
  <para style="q2">khuapi lungkhu a khiaku lya hae khe,</para>
  <para style="q2">kae kha he yn muih hae tuh,</para>
  <para style="q1">“Ka hiinnaw nynh a sungsahpaw kha</para>
  <para style="q2">na muih oh tou?” cite ka khia hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Minmin kha ccapyhtari he ka lawe hae te,</para>
  <para style="q2">ka hiinnaw nynh a sungsahpaw kha ka muih.</para>
  <para style="q1">Ka nung nynh kae yn saahnaw khaan,</para>
  <para style="q2">ka nung inn lungkhu lang</para>
  <para style="q1">ka teekhae mawlaezung,</para>
  <para style="q2">amaw kha cciasah leite phang ka kyng.</para>
  <para style="q1">
    <verse number="5" style="v" />Pou Jerusalem ccanung hae,</para>
  <para style="q2">ka sungsahnung tuh</para>
  <para style="q1">amaw tho lan a tho mawlaezung</para>
  <para style="q2">na tho khyh nawlan oh,</para>
  <para style="q1">sazuh hae khyhze sazaw hae min phyate</para>
  <para style="q2">bya kae taw oh!</para>
  <para style="b" />
  <para style="s1">Hlaw Thumnaw</para>
  <para style="q1">
    <verse number="6" style="v" />Kungku hae kya-e</para>
  <para style="q2">mynkhuhpaw pungda hae ryte,</para>
  <para style="q1">mura te frankinsen zimuin khate</para>
  <para style="q2">amynkhuh khaekuhpaw,</para>
  <para style="q1">akhuhthungpaw maeekhuh hawte,</para>
  <para style="q2">ramkaw kyate yn poupaw tuh</para>
  <para style="q2">hummou athua?</para>
  <para style="q1">
    <verse number="7" style="v" />Dotua oh, Solomon a ikhung khuh!</para>
  <para style="q1">A pepan khe Israel kyaze</para>
  <para style="q2">athawsaepaw pise,</para>
  <para style="q2">pise athawsaepaw sung taruh a um hae,</para>
  <para style="q1">
    <verse number="8" style="v" />tuh-e hae balyn tuh</para>
  <para style="q2">thaloi ccyngkute,</para>
  <para style="q1">rhawtuk a thya hae paw nynh thua,</para>
  <para style="q2">khuazi vae ze thinphang</para>
  <para style="q1">a um keiccuze, mih phae kyakhe</para>
  <para style="q2">thaloi ccarou a saekuh hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Solomon Siapharan nynh</para>
  <para style="q2">Lebanon thing khate</para>
  <para style="q2">puihbiakunawpaw ikhung kha a raeku.</para>
  <para style="q1">
    <verse number="10" style="v" />Tuh-e ikhung atung kha</para>
  <para style="q2">ngun te rae zah, akawlan kha</para>
  <para style="q1">sui te a ccaan, haungnawpaw kha</para>
  <para style="q2">sephaphuhpaw te a rae;</para>
  <para style="q1">a lungkhu kha sungsakunaw te</para>
  <para style="q2">a ccaan hae.</para>
  <para style="q2">Jerusalem ccanung hae,</para>
  <para style="q1">
    <verse number="11" style="v" />yn pou oh.</para>
  <para style="q1">Pou Zion ccanung hae,</para>
  <para style="q2">a zudy poi nin kya,</para>
  <para style="q1">a lungpaw nin khe,</para>
  <para style="q2">a nung nynh a khungsahpaw</para>
  <para style="q1">bawilukhung a khungkuhpaw</para>
  <para style="q2">Solomon Siapharan khuh dotua oh.</para>
  <para style="b" />
  <chapter number="4" style="c" />
  <para style="s1">Zudy Ccangvaepaw nynh A Hothung</para>
  <para style="q1">
    <verse number="1" style="v" />Ka sungsahnung,</para>
  <para style="q2">paw na puithya baban,</para>
  <para style="q1">myaryamaw na puithya!</para>
  <para style="q2">Na mae na bongkupaw boei kaw</para>
  <para style="q1">a umpaw na mit tuh</para>
  <para style="q2">vahu mit te nynh aloku.</para>
  <para style="q1">Na sang tuh Gilead mua</para>
  <para style="q2">hary apannaw kya</para>
  <para style="q1">a cceihbung hae paw</para>
  <para style="q2">miaa phu te nynh aloku.</para>
  <para style="q1">
    <verse number="2" style="v" />Na haw tuh a ming ngo koute,</para>
  <para style="q2">tuisingkunaw kyate</para>
  <para style="q1">oun cceihthung hae paw</para>
  <para style="q2">tuuphu te nynh aloku,</para>
  <para style="q1">tuh-e tuu hae tuh abuabuate</para>
  <para style="q2">ataw than hae zah,</para>
  <para style="q2">sa kheit sanmah zo khyh hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Na mung tuh sebabipaw laaw te</para>
  <para style="q2">lokuh zah, na khalang tuh</para>
  <para style="q1">sungsah lan a um.</para>
  <para style="q2">Mae bongkupaw boei kaw</para>
  <para style="q1">a umpaw na byaki tuh</para>
  <para style="q2">apaekuapaw ccalee thae te nynh aloku.</para>
  <para style="q1">
    <verse number="4" style="v" />Na nging tuh zunghe ccakhungnawpaw</para>
  <para style="q2">David a rhawviainn te nynh aloku;</para>
  <para style="q2">tuin kyakhe abalyn mawte</para>
  <para style="q1">rhawkaw hae kya-e</para>
  <para style="q2">zunghe thong kheit a um.</para>
  <para style="q1">
    <verse number="5" style="v" />Na matei ccangning tuh</para>
  <para style="q2">lili paw hae laku</para>
  <para style="q1">a ae cciamang hae paw sazuh taw</para>
  <para style="q2">a phei hae paw te nynh aloku.</para>
  <para style="q1">
    <verse number="6" style="v" />Mohnaw zo zah</para>
  <para style="q2">khua adae mawkhe</para>
  <para style="q1">mura mua te frankinsen</para>
  <para style="q2">sangpyng hae kalan khe</para>
  <para style="q2">ka rangsakuh cih.</para>
  <para style="q1">
    <verse number="7" style="v" />Ka sungsahnung,</para>
  <para style="q2">na pyn balyn mawte na puithya;</para>
  <para style="q2">na kya hosianaw um khyh.</para>
  <para style="q1">
    <verse number="8" style="v" />Ka liaccanung taraw,</para>
  <para style="q2">Lebanon kyate kamaw ryte cceihbua;</para>
  <para style="q1">Lebanon kyate kamaw ryte cceihbua.</para>
  <para style="q2">Amana mua dung kyate thuasah,</para>
  <para style="q1">Senir mua dung te</para>
  <para style="q2">Hermon mua dung kyate thuasah,</para>
  <para style="q1">chindeih karung kyate thuasah,</para>
  <para style="q2">kaesing umnaw</para>
  <para style="q1">mua hae kyate thuasah pou ccavae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" />Ka ccianung, ka liaccanung taraw,</para>
  <para style="q2">ka thinlung phe nae cciakhae vae,</para>
  <para style="q1">aphutepaw si oikute,</para>
  <para style="q2">na mit te vaekheit phalah</para>
  <para style="q1">nae dopaw khate</para>
  <para style="q2">ka thinlung phe nae cciakhae vae.</para>
  <para style="q1">
    <verse number="10" style="v" />Ka ccianung, ka liaccanung taraw,</para>
  <para style="q2">na sungsahnaw tuh</para>
  <para style="q1">pawcih baban mou a e!</para>
  <para style="q2">Na sungsahnaw tuh misutui laeze</para>
  <para style="q1">pawcih baban mou thuahua zah,</para>
  <para style="q2">na chitui mynkhuhpaw tuh</para>
  <para style="q1">ccangpaw mynkhuhpaw laeze</para>
  <para style="q2">pawcih baban mou amynkhuhhua!</para>
  <para style="q1">
    <verse number="11" style="v" />Ka liaccanung taraw, na mung tuh</para>
  <para style="q2">haetapaw tui hawte accaw;</para>
  <para style="q1">na lae kaw kya khoilutui te</para>
  <para style="q2">mateitui a um;</para>
  <para style="q1">na boeining nynh amynkhuhpaw tuh</para>
  <para style="q2">Lebanon mynkhuhpaw te nynh aloku.</para>
  <para style="q1">
    <verse number="12" style="v" />Ka ccianung, ka liaccanung taraw tuh</para>
  <para style="q2">ccavyng khawpaw khokhu,</para>
  <para style="q1">ccavyng khawpaw tuidy,</para>
  <para style="q2">phang koihkhawpaw tuisung nynh thua.</para>
  <para style="q1">
    <verse number="13" style="v" />Thingthae khokhu kya</para>
  <para style="q2">um hae paw na thingku taraw hae tuh</para>
  <para style="q1">ahoypaw thae athaepaw ccalee ku,</para>
  <para style="q2">nard te pykuhpaw henna,</para>
  <para style="q1">
    <verse number="14" style="v" />nard te saffron, kalamus te sinamon,</para>
  <para style="q2">amynkhuhpaw thingku</para>
  <para style="q1">miakaw nynh thua hae, mura te aloes,</para>
  <para style="q2">mynkhuhhua hae paw miakaw a um hae.</para>
  <para style="q1">
    <verse number="15" style="v" />khokhu khe tuidy, aluapaw tui,</para>
  <para style="q2">Lebanon kyate yn luapaw</para>
  <para style="q1">vaw taraw a um.</para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" />Pou thahlang khisan, thoku tua,</para>
  <para style="q2">Pou deilang khisan, yn zawtua!</para>
  <para style="q1">Ka khokhu luki yn zaw lah,</para>
  <para style="q2">amynkhuhpaw kha</para>
  <para style="q1">asawnaw lang na mung cih.</para>
  <para style="q2">Ka sungsahpaw tuh</para>
  <para style="q1">a khokhu kalan yn thua sah lah,</para>
  <para style="q2">khokhu kya-e thingthae</para>
  <para style="q1">ahoy huaccepaw kha ae sah.</para>
  <para style="b" />
  <chapter number="5" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Ka ccianung, ka hawkunung,</para>
  <para style="q2">ka khokhu lang ka cceih;</para>
  <para style="q1">ka mura kha mynkhuhpaw te ka sueluaku,</para>
  <para style="q2">ka khoibaw te khoitui kha ka aede,</para>
  <para style="q1">ka misutui te mateitui kha ka niade.</para>
  <para style="q2">Ka ban hae, ae oh, neih oh lah,</para>
  <para style="q1">sungsakunaw khate phe byn oh.</para>
  <para style="b" />
  <para style="s1">Ccangpaw Maan</para>
  <para style="q1">
    <verse number="2" style="v" />Ka ih salamah ka thinlung tuh</para>
  <para style="q2">ngaw kho khyh.</para>
  <para style="q1">Ngaetua! Ka sungsahpaw nynh</para>
  <para style="q2">thuakaw khua zah,</para>
  <para style="q1">“Ka ccianung, ka sungsahnung,</para>
  <para style="q2">ka vahu, ka kya-e phe a ccingnung,</para>
  <para style="q1">thuakaw yn hungpah;</para>
  <para style="q2">pawccecize ka lu tuh dangtui te acia,</para>
  <para style="q1">ka sangtung tuh khuazi accahpaw</para>
  <para style="q2">dangtui keiccuze acia,” a ci.</para>
  <para style="q1">
    <verse number="3" style="v" />Ka boeining kha ka khahku;</para>
  <para style="q2">pawccemou boeining kha</para>
  <para style="q1">bua ka lawkuh kho ung cih?</para>
  <para style="q2">Ka ccu phe ka singku vae;</para>
  <para style="q2">pawccemou bua ka thusakuh ry ung cih?</para>
  <para style="q1">
    <verse number="4" style="v" />Ka sungsahpaw nynh a kuih kha</para>
  <para style="q2">thuakaw lungkhu lang</para>
  <para style="q2">a pu keiccuze ka lungkhu te ka ry.</para>
  <para style="q1">
    <verse number="5" style="v" />Ka sungsahpaw kha thuakaw</para>
  <para style="q2">hungpya lan he ka thokuh tuh,</para>
  <para style="q1">ka kuih kyate mura chitui accaw,</para>
  <para style="q2">ka kuih kyate muratui tuh</para>
  <para style="q2">thuakaccong vawlan khe accaw.</para>
  <para style="q1">
    <verse number="6" style="v" />Ka sungsahpaw kha</para>
  <para style="q2">thuakaw ka hungpya,</para>
  <para style="q1">thuasalama ka sungsahpaw tuh</para>
  <para style="q2">maekuh zah phe la cceih vae.</para>
  <para style="q1">Aning nynh bya he a ho tuh</para>
  <para style="q2">ka thawzung phe yn tingsah.</para>
  <para style="q1">Amaw kha ka ccung zahmah</para>
  <para style="q2">ka muih vae khyh;</para>
  <para style="q2">ka ko zahmah yn oi vae khyh.</para>
  <para style="q1">
    <verse number="7" style="v" />Khuapi lungkhu a khiakuh hae paw</para>
  <para style="q2">rhawviatu hae nynh yn muih hae;</para>
  <para style="q1">yn zia hae zah vaemaw yn muesah hae,</para>
  <para style="q2">khualungrua kya rhawviatu hae nynh</para>
  <para style="q1">ka mae bongkupaw kha</para>
  <para style="q2">ccaring yn lawpya hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Pou Jerusalem ccanung hae,</para>
  <para style="q2">ka sungsahpaw kha na muih oh ze,</para>
  <para style="q1">Ka sungsah keiccuze ka thawzya,</para>
  <para style="q2">a ci cite na la hopya nawlan oh</para>
  <para style="q1">bya kae taw oh.</para>
  <para style="b" />
  <para style="s1">Liaccanung taraw te Ruiban hae</para>
  <para style="q1">
    <verse number="9" style="v" />Pou nopi balyn laeze</para>
  <para style="q2">a puithya huanung,</para>
  <para style="q1">na sungsahpaw tuh sungsahpaw</para>
  <para style="q2">mingccangpaw laeze pawmou alaehua?</para>
  <para style="q1">Tuhcite kaening byatawsya lan ciate</para>
  <para style="q2">na sungsahpaw tuh sungsahpaw</para>
  <para style="q1">mingccangpaw laeze pawmou alaehua?</para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" />Ka sungsahpaw tuh a pynrua</para>
  <para style="q2">hoy zah a ngesaw raw,</para>
  <para style="q1">ccungccaw thong haw laku kya</para>
  <para style="q2">a langkuh hua.</para>
  <para style="q1">
    <verse number="11" style="v" />A lu tuh sui ccipaw te nynh aloku;</para>
  <para style="q2">a sangtung tuh khekuh zah,</para>
  <para style="q2">va-aw hawte aman.</para>
  <para style="q1">
    <verse number="12" style="v" />A mit tuh tuidy pe to zah</para>
  <para style="q2">mateitui te a singkuhpaw</para>
  <para style="q2">vahu te nynh aloku.</para>
  <para style="q1">
    <verse number="13" style="v" />A byaki tuh amynkhuh zah</para>
  <para style="q2">mynkhuhpaw a pousahpaw</para>
  <para style="q2">khokhu te nynh aloku.</para>
  <para style="q1">A mung tuh muratui abyasahpaw</para>
  <para style="q2">lili paw te nynh aloku.</para>
  <para style="q1">
    <verse number="14" style="v" />A kuih tuh sui te raekuhpaw,</para>
  <para style="q2">aphutepaw lung te</para>
  <para style="q1">ccaankuhpaw te nynh aloku;</para>
  <para style="q2">A pyn tuh nilar lung te ccaankuhpaw</para>
  <para style="q2">saepanua hawte nynh thua.</para>
  <para style="q1">
    <verse number="15" style="v" />A ccu tuh sui ccusy vawlan bingkuhpaw</para>
  <para style="q2">aphutepaw lung te nynh aloku.</para>
  <para style="q1">A muinsan tuh Lebanon mua te lokuh zah</para>
  <para style="q2">sidar thing hoypaw te nynh aloku.</para>
  <para style="q1">
    <verse number="16" style="v" />A byaho tuh myaryamaw e zah</para>
  <para style="q2">aning tuh abalyn mawte</para>
  <para style="q1">ry lan umpaw nynh thua.</para>
  <para style="q2">Jerusalem ccanung hae,</para>
  <para style="q1">e paw tuh ka sungsahpaw te</para>
  <para style="q2">ka banpaw nynh thua.</para>
  <para style="b" />
  <chapter number="6" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Nopi hae lakuze</para>
  <para style="q2">a puithya huacce nung,</para>
  <para style="q1">na sungsahpaw tuh</para>
  <para style="q2">teilangmou phe a ccia vae?</para>
  <para style="q1">Amaw kha aening nynh</para>
  <para style="q2">ah ccung oh ccaw, na sungsahpaw tuh</para>
  <para style="q1">tei laanpi lang mou phe a ccia vae?</para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" />Ka sungsahpaw tuh khokhu kya</para>
  <para style="q2">a sahiin phu kha paeesaku khylan te</para>
  <para style="q1">lili paw hae kha suelua khylan</para>
  <para style="q2">amynkhuhpaw khokhu lang nynh</para>
  <para style="q2">phe a cciabung vae.</para>
  <para style="q1">
    <verse number="3" style="v" />Kae tuh ka sungsahpaw kya-e</para>
  <para style="q2">ka thua zah, ka sungsahpaw tuh</para>
  <para style="q1">ka kya-e nynh thua; a sahiin hae kha</para>
  <para style="q2">lili paw hae laku khe a rin hae.</para>
  <para style="b" />
  <para style="s1">Liaccanung Puithyanaw</para>
  <para style="q1">
    <verse number="4" style="v" />Ka sungsahnung, nang tuh</para>
  <para style="q2">Tirzah khuapi hawte na puithya,</para>
  <para style="q1">Jerusalem hawte na puithya,</para>
  <para style="q2">rhawtukkunaw kya hawte ri lan na um.</para>
  <para style="q1">
    <verse number="5" style="v" />Ka kyate ccanglang hawitua,</para>
  <para style="q2">pawccecize na mit nynh phang yn kyng!</para>
  <para style="q1">Na sang tuh Gilead mua hary apannaw kya</para>
  <para style="q2">a cceihbung hae paw</para>
  <para style="q2">miaa phu te nynh aloku.</para>
  <para style="q1">
    <verse number="6" style="v" />Na haw tuh tuisingkunaw kyate</para>
  <para style="q2">oun cceihthung hae paw</para>
  <para style="q2">tuuphu te nynh aloku;</para>
  <para style="q1">tuh-e tuu hae tuh abuabuate</para>
  <para style="q2">ataw than hae zah,</para>
  <para style="q2">sa kheit sanmah zo khyh hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Na byaki tuh mae kya</para>
  <para style="q2">bongkupaw boei kaw a umpaw</para>
  <para style="q1">ccalee thae apaekuapaw te nynh</para>
  <para style="q2">aloku hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Siapharan zupi sung taruh,</para>
  <para style="q2">lovae sung tarya te</para>
  <para style="q2">riatae leipaw liaccaw hae a um.</para>
  <para style="q1">
    <verse number="9" style="v" />Ka vahu, phe a ccingnung</para>
  <para style="q2">ka kya-e tuh amaw rou nynh thua,</para>
  <para style="q1">a nung nynh myarya a sungsahnung,</para>
  <para style="q2">amaw tuh a saahtunung hanlan</para>
  <para style="q1">phe a ccingnung nynh thua.</para>
  <para style="q2">Liaccaw hae nynh amaw kha</para>
  <para style="q1">muih hae zah, lungtuanung cite</para>
  <para style="q2">a ko hae; siapharan zu hae te</para>
  <para style="q2">lovae hae nynh mah a thehoysah hae.</para>
  <para style="q1">
    <verse number="10" style="v" />“Khuadaetakaw hawte yn langkuh,</para>
  <para style="q2">sawpaw hawte a puithya,</para>
  <para style="q1">khuanin hawte aw zah</para>
  <para style="q2">rhawtukkunaw kya hawte ri lan umpaw</para>
  <para style="q1">hynh-e nopinung hynh hummou?”</para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" />Accya e thingku hae do khylan,</para>
  <para style="q2">misu ku atoih tou toih khyh tou</para>
  <para style="q1">cipaw do khylan te</para>
  <para style="q2">ccalee ku apaw paw tou</para>
  <para style="q1">paw khyh tou cipaw ny khylan</para>
  <para style="q2">khokhu lang ka cceihbung.</para>
  <para style="q1">
    <verse number="12" style="v" />Bua ka nyku mawkhe,</para>
  <para style="q2">lungkaw ka tuakunaw nynh</para>
  <para style="q1">ka siapharannung pe umpaw</para>
  <para style="q2">marangle lungkhu khe yn nung.</para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" />Pou Shulam nung, yn ki lou,</para>
  <para style="q2">yn ki lou!</para>
  <para style="q1">Nang kha kae muih kho ccaw</para>
  <para style="q2">yn ki lou, yn ki lou.</para>
  <para style="b" />
  <para style="q1">Rhawkaw phu ning malang</para>
  <para style="q2">a law hae paw kha do hawte,</para>
  <para style="q1">Shulam nung kha pawccemou na do cih?</para>
  <para style="b" />
  <chapter number="7" style="c" />
  <para style="s1">Thehoysahnaw Langsakunaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou siapharan ccanung,</para>
  <para style="q2">phanah nawkuhpaw na ccu tuh</para>
  <para style="q2">pawcih baban mou angaeku!</para>
  <para style="q1">Na phae tuh a kuihhae hoypaw nynh</para>
  <para style="q2">a raepaw aphutepaw lung te nynh aloku.</para>
  <para style="q1">
    <verse number="2" style="v" />Na laerui tuh misutui thenawpaw,</para>
  <para style="q2">tyty abeihpaw pakekhupaw te nynh aloku.</para>
  <para style="q1">Na vue tuh lili paw hae nynh</para>
  <para style="q2">a koihlu hae paw</para>
  <para style="q2">chanvuih apumkuhpaw te nynh aloku.</para>
  <para style="q1">
    <verse number="3" style="v" />Na matei ccangning tuh a phei hae paw</para>
  <para style="q2">sazuh taw hae sa ning te nynh aloku hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Na nging tuh saepanua te</para>
  <para style="q2">ccaankuhpaw rhawviainn te nynh aloku.</para>
  <para style="q1">Na mit tuh Heshbon khua e</para>
  <para style="q2">Bathrabbim koikua pe umpaw</para>
  <para style="q1">tuili te nynh aloku. Na naduh tuh</para>
  <para style="q1">Damaskas lang a hawipaw</para>
  <para style="q2">Lebanon rhawviainn te nynh aloku.</para>
  <para style="q1">
    <verse number="5" style="v" />Na lu tuh Karmel mua te lokuh zah,</para>
  <para style="q2">na sangtung tuh</para>
  <para style="q1">sephaphuhpaw te nynh aloku;</para>
  <para style="q2">siapharan thinlung tuh akhekuhpaw</para>
  <para style="q1">sang khate kyng kho athua.</para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" />Pou ka sungsahnung,</para>
  <para style="q2">ry lan umpaw liaccanung,</para>
  <para style="q1">pawcih baban mou na puithya zah</para>
  <para style="q2">ry lan na um!</para>
  <para style="q1">
    <verse number="7" style="v" />Na pynrua tuh ungcci ku hawte aly,</para>
  <para style="q2">na matei hae tuh ungcci ku ange kya-e</para>
  <para style="q2">athae hae te nynh aloku.</para>
  <para style="q1">
    <verse number="8" style="v" />Ungcci ku kya ka kae cih zah</para>
  <para style="q2">a karan hae kha ka kyng cih, ka ci.</para>
  <para style="q1">Na matei hae tuh misu nge kya-e</para>
  <para style="q2">athae te lokuh hae zah,</para>
  <para style="q1">amynkhuhpaw na hysue tuh</para>
  <para style="q2">epal myn te nynh aloku,</para>
  <para style="q1">
    <verse number="9" style="v" />nae myng vae ze,</para>
  <para style="q2">mung te haw vawlan</para>
  <para style="q1">nawpalya lan aluibungpaw</para>
  <para style="q2">misutui ahoy huaccepaw te nynh aloku.</para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" />Kae tuh ka sungsahpaw kya-e ka thua zah,</para>
  <para style="q2">a lungrynaw tuh ka hanlan nynh thua.</para>
  <para style="q1">
    <verse number="11" style="v" />Ka sungsahpaw, yn cciatua,</para>
  <para style="q2">khua taraw lang cceih sih lah,</para>
  <para style="q1">khua taraw hae kyakhe</para>
  <para style="q2">umkheih hin sih;</para>
  <para style="q1">
    <verse number="12" style="v" />misu ku atoih vae tou,</para>
  <para style="q2">misu paw apaw vae tou cipaw te</para>
  <para style="q1">ccalee paw apaw vae tou cipaw</para>
  <para style="q2">muih khylan awkhua takaw te</para>
  <para style="q2">misu khokhu lang cceih sih.</para>
  <para style="q1">Tuin kyakhe kae sungsahnaw kha</para>
  <para style="q2">nang kae pya cih.</para>
  <para style="q1">
    <verse number="13" style="v" />Mandarek tuh amynkhuh,</para>
  <para style="q2">Pou ka sungsahpaw, ah thuakaw pe khe</para>
  <para style="q1">ahoypaw thingthae phuin</para>
  <para style="q2">aryn athaw balyn kha</para>
  <para style="q1">na hanlan kae nungpya vae.</para>
  <chapter number="8" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Nang hynh ka nung matei a zupaw,</para>
  <para style="q2">ka upaw hawte na thua ravo nyn!</para>
  <para style="q1">Atolang ah tungku vae ze</para>
  <para style="q2">kae myng cih zah</para>
  <para style="q1">hum nynh sanmah kae kha</para>
  <para style="q2">yn theihrya lan khyh.</para>
  <para style="q1">
    <verse number="2" style="v" />Nang kha kae cciakhae cih zah</para>
  <para style="q2">ka nung inn lungkhu lang,</para>
  <para style="q1">kae yn saahnung a khaan lungkhu lang</para>
  <para style="q2">kae teekhae cih.</para>
  <para style="q1">Amynkhuhpaw misutui, ka ccaleethaetui kha</para>
  <para style="q2">nia lan kae pya cih.</para>
  <para style="q1">
    <verse number="3" style="v" />A voilang kuih kha ka ngya sah lah,</para>
  <para style="q2">a ranglang kuih nynh yn pom sah!</para>
  <para style="q1">
    <verse number="4" style="v" />Pou Jerusalem ccanung hae,</para>
  <para style="q2">ka sungsahnung tuh</para>
  <para style="q1">a inaw kyate amaw tho lan</para>
  <para style="q2">a tho maw na tho khyh nawlan oh,</para>
  <para style="q1">nanning kha bya kae taw oh!</para>
  <para style="b" />
  <para style="s1">Hlaw Taruhnaw</para>
  <para style="q1">
    <verse number="5" style="v" />A sungsahpaw kha ngeikute ramkaw kyate</para>
  <para style="q2">yn cceihthungpaw khuh hummou athua?</para>
  <para style="b" />
  <para style="q1">Epal ku kaw khe nang kha kae tho.</para>
  <para style="q1">Tuin kyakhe na nung tuh</para>
  <para style="q2">nang keiccuze neitangia a teing;</para>
  <para style="q1">tuin kyakhe nang ae saahnung tuh</para>
  <para style="q2">neitangia a teing.</para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" />Kae hynh na bung vawlan</para>
  <para style="q2">tazeih hawte yn khiaku tua,</para>
  <para style="q1">na kuihbaw kya tazeih hawte</para>
  <para style="q2">yn khiaku tua;</para>
  <para style="q1">pawccecize sungsakunaw tuh</para>
  <para style="q2">chinaw hawte a thawsae,</para>
  <para style="q1">eiungnaw tuh shawku hawte a rysawthah.</para>
  <para style="q1">Tuh-e tuh maeesoi te</para>
  <para style="q2">maeephu aruapaw nynh thua.</para>
  <para style="q1">
    <verse number="7" style="v" />Tui patae nynh sungsakunaw maee kha</para>
  <para style="q2">the kho khyh, tui alepaw nynh mah</para>
  <para style="q1">vu kho khyh.</para>
  <para style="q1">Lukhakheit nynh sungsakunaw hanlan</para>
  <para style="q2">a inn kya-e sisua balyn kha</para>
  <para style="q1">a pya lanze, saryanaw kha a ing cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" />Kaening nynh ccianung taraw</para>
  <para style="q2">lu kheit kae hoi,</para>
  <para style="q2">aning tuh a matei adih ung.</para>
  <para style="q1">Kae neitawnung oun dy nin hae khe,</para>
  <para style="q2">aning hanlan pawmou kae cyipah cih?</para>
  <para style="q1">
    <verse number="9" style="v" />Aning tuh khualungrua a la thua ze,</para>
  <para style="q2">kaening nynh a tungvaw kya</para>
  <para style="q1">maethe kawnaw a ua kha</para>
  <para style="q2">ngun te kae rae cih;</para>
  <para style="q1">thuasalama aning tuh</para>
  <para style="q2">thuakaw a la thua ze,</para>
  <para style="q2">sidar thing te kae khaw cih.</para>
  <para style="q1">
    <verse number="10" style="v" />Kae tuh khualungrua ka thua zah,</para>
  <para style="q2">ka matei hae tuh</para>
  <para style="q2">rhawviainn te nynh aloku hae;</para>
  <para style="q1">oute kae tuh a muihnaw kya</para>
  <para style="q2">daenaw a thuakhaepaw hawte nynh ka thua.</para>
  <para style="q1">
    <verse number="11" style="v" />Solomon tuh Baal-hamon kya</para>
  <para style="q2">misu khokhu a hoi; misu khokhu kha</para>
  <para style="q1">a ngawtu hae kalan a ap hae,</para>
  <para style="q2">a ngawtu lu kheit cci nynh</para>
  <para style="q1">thingthae mee lang ngunphua</para>
  <para style="q2">thong kheit cci a pya hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Ka hoipaw misu khokhu tuh</para>
  <para style="q2">kamaw hanlan nynh thua;</para>
  <para style="q1">Pou Solomon, nang nynh</para>
  <para style="q2">ngunphua thong kheit lawkuh lah,</para>
  <para style="q1">thingthae a ngawtu hae nynh</para>
  <para style="q2">za ning lawkuh hae sah!</para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" />Pou khokhu kya a umpaw nang,</para>
  <para style="q2">ka ban hae nynh na roi kha a ngae hae;</para>
  <para style="q1">kae mah yn thaesah bua.</para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" />Ka sungsahpaw, yn rangsakuh,</para>
  <para style="q2">amynkhuhpaw mua vawlan umpaw</para>
  <para style="q1">sazuh khyhze</para>
  <para style="q2">anopaw sazaw hawte yn cciatua!</para>
</usx>