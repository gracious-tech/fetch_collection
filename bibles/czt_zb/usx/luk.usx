<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="LUK" style="id">Baebu Thyaa</book>
  <para style="h">LUKA</para>
  <para style="toc1">Luke</para>
  <para style="toc2">LUKA</para>
  <para style="toc3">Luk</para>
  <para style="mt">LUKA</para>
  <para style="mt2">KYATE THEHOYPAW</para>
  <para style="mt2">Luke</para>
  <para style="imt">Byalaanmaw</para>
  <para style="im">
    <char style="bk">Luka Thehoypaw </char> nynh Jesu hynh Israel hae hanlan byakin typaw Khumtu te ccungccaw miakaw Khumtu athuanaw kha parouhte a langsaku. <char style="bk">Luka</char> nynh Jesu tuh “ryachi hae kalan Thehoypaw a phytu” lang (4.18), Bawipaw Muisaw nynh a kopaw te hynh-e Thehoypaw kyahin a hoboupaw ccungccaw hae hanlan asekunawte phe abeih. <char style="bk">Luka</char> lungkhu kya athonaw byaria hae kya Jesu a puinaw thuasah, athangnaw ze Jesu vaawlang a kaenaw thuasah, lungtuanaw kha abyapi lante a hangthung. Hynh-e ccauh a zeitupaw mamin hynh nynh Jesu vaawlang a kae koute Khriccaaw zynnaw a pungzaenaw te a kaethungnaw phungpaw kha <char style="bk">Locceihtu hae Ryalawnaw</char> ccauh kya bua oun hopya.</para>
  <para style="ip">Ccangpaw Thehoypaw kya a um leipaw kha <char style="bk">Luka </char> kya muih thua zah, tuh-e hae tuh Jesu a pui lyaze tuurin hae te vaaw hae nynh paeenaw kya hlaw a sah hae paw kong, a imua lya Beikinn lungkhu kya Jesu, Samaria Mihoypaw te Ccapaw Zopaw phungpaw hae nynh athua hae. Thehoypaw lungkhu kya balyn abyapi lante a langsahkupaw tuh sawsangnaw, Thyaa Muisaw, Jesu ryalawnaw kya nopi hae a byapinaw hae te Pachia kya-e seingaethyanaw kha nynh athua.</para>
  <para style="iot">Alungkhu Umpaw</para>
  <para style="io1">Byalaanmaw — 1.1-4</para>
  <para style="io1">Jesu te Baptisma pyatu Johan a puinaw hae te a imua lya hae — 1.5—2.52</para>
  <para style="io1">Baptisma pyatu Johan ryalawnaw — 3.1-20</para>
  <para style="io1">Jesu baptisma innaw te tuhounaw — 3.21—4.13</para>
  <para style="io1">Galilee kya Jesu nynh zapi kya ryalawnaw — 4.14—9.50</para>
  <para style="io1">Galilee kyate Jerusalem lang — 9.51—19.27</para>
  <para style="io1">Jerusalem pepan te Jerusalem kya nyathya lonaw — 19.28—23.56</para>
  <para style="io1">Bawipaw a thoothuinaw, a langkunaw hae te vaawlang a kaenaw — 24.1-53</para>
  <chapter number="1" style="c" />
  <para style="s1">Baptisma Pyatu Johan Puinaw</para>
  <para style="p">
    <verse number="1" style="v" />Ccungccaw patae nynh aening kya acyihkuhpaw konglang kha ccaw te zei lan a zuaku hae. <verse number="2" style="v" />Tuhawte atakaw lyaze mit te a muih hae paw ccaekia hae te thehoypaw a phytu hae nynh a ho hae thyhte a zei hae. <verse number="3" style="v" />Tukeiccuze sawtua lan kou umpaw Theofilas, kae mah atakaw te pawpaw balyn kha akaw-aleih ka thaethya koute, po akyngkuh lante na kalan zei lanze ahoy cih cite ka tua, <verse number="4" style="v" />tuhteze nynh ae ccangpya vae hae paw uccaw hae konglang ahmepaw kha na nyh cih.</para>
  <para style="p">
    <verse number="5" style="v" />Judea ram kya Herod Siapharan ccyh lyakhe Abijah ranpibawi aphu kya a um buapaw Zekhariah a ci hae paw ranpibawi lu kheit a um; a zu tuh Aaron ciihan thua zah a min tuh Elizabeth acikuh.<note caller="-" style="x"><char style="xo" closed="false">1.5: </char><char style="xt" closed="false"><ref loc="1CH 24:10">1Sh 24.10</ref></char></note> <verse number="6" style="v" />Minmin lu ning tuh Bawipaw kawbya hae te phung hae balyn kha ccaenaw um lei lan a zui hae paw thua zah Pachia malang parouh mawte a ding hae paw nynh thua. <verse number="7" style="v" />Elizabeth tuh a tiin keiccuze ccaawsaah khyh hae, parouh mawte myarya taw vae hae.</para>
  <para style="p">
    <verse number="8" style="v" />Vaekheih tuh Zekhariah nynh amaw a phu hae ryte atue nynh a phya thyhte Pachia malang ranpibawi rya a law lyakhe, <verse number="9" style="v" />ranpibawi ryalaw phung thyhte, ccungthydung hae zah aning tuh Bawipaw beikinnthyaa lungkhu lang tee lan zah mynkhuhpaw u lan accan. <verse number="10" style="v" />Mynkhuhpaw a u lyakhe ccungccaw hae balyn tuh atolang khe saw a sang hae. <verse number="11" style="v" />Bawipaw vaawpaw tuh a kya yn langkuh zah mynkhuhpaw unawpaw silawhang ranglang khe a thadyn. <verse number="12" style="v" />Zekhariah nynh he a muih tuh siikuh zah a rih. <verse number="13" style="v" />Thuasalama vaawpaw nynh, “Zekhariah, rih nan, pawccecize na sawsangnaw tuh thaepya athua, na zu Elizabeth nynh ccapaw ae saahpah cih zah a min tuh Johan cite na phu cih. <verse number="14" style="v" />Na lungtua cih zah na lungpaw cih; tuh-e ccapaw a pui keiccuze ccungccaw patae mah mih lungtua cih. <verse number="15" style="v" />Pawccecize aning tuh Bawipaw muihnaw kya a lesae cih. Misutui te ruithyapaw kha kharouh neih lan khyh; aning tuh a pui mawze Thyaa Muisaw te abeih cih.<note caller="-" style="x"><char style="xo" closed="false">1.15: </char><char style="xt" closed="false"><ref loc="NUM 6:3">Nam 6.3</ref></char></note> <verse number="16" style="v" />Israel ccungccaw patae kha Bawipaw mih Pachia kalan a kikhae cih hae. <verse number="17" style="v" />Bawipaw malang zeccuetu athua cih zah profeh Elijah hawte a thungpaw te huhan hoipaw athua cih. Paaw hae te ccaaw hae kha oun ccawsakuh thui cih hae zah kawngae lei hae paw kha miding hae hawnaw kalan oun kikhae cih hae. Bawipaw hanlan ccungccaw hae kha a paccyn ty cih,” a cipya.<note caller="-" style="x"><char style="xo" closed="false">1.17: </char><char style="xt" closed="false"><ref loc="MAL 4:5-6">Mal 4.5-6</ref></char></note> <verse number="18" style="v" />Zekhariah nynh vaawpaw kha, “Tuhte yn cyiku lanpaw tuh pawtemou ka nyh cih? Pawccecize kae tuh a taw vae paw ka thua zah, ka zu mah a kum phe tang vae,” a cipya. <verse number="19" style="v" />Vaawpaw nynh, “Kae tuh Gabriel nynh ka thua. Pachia malang a thadynpaw ka thua zah, aning nynh hynh-e thehoypaw hynh na kalan hopya lan te phypya lan yn saw.<note caller="-" style="x"><char style="xo" closed="false">1.19: </char><char style="xt" closed="false"><ref loc="DAN 8:16">Dan 8.16</ref>, <ref loc="DAN 9:21">9.21</ref></char></note> <verse number="20" style="v" />Nang nynh accyh yn zaw te accing cih paw ka bya hynh na zyn khyh keiccuze hynh-e uccaw hae accing makhia byaho kho leite na um cih zah bya na ho lan khyh,” a cipya.</para>
  <para style="p">
    <verse number="21" style="v" />Ccungccaw hae nynh Zekhariah kha phang ngaw hae zah beikinnthyaa lungkhu khaw aro keiccu mih ngaeangthua. <verse number="22" style="v" />Aning nynh he yn pou tuh byaho kho vae khyh zah, beikinn lungkhu kya vizin nynh a muih cih cite a tua hae; aning nynh a kuih te a tangpya hae, bya tuh ho kho vae khyh. <verse number="23" style="v" />Zekhariah tuh a ryalaw ccyh athang te a inn lang a ki.</para>
  <para style="p">
    <verse number="24" style="v" />Aro mawze a zu Elizabeth tuh ccaawpoi zah sawpaw sah pangaw lungkhu inn kya a khungkuh. <verse number="25" style="v" />Elizabeth nynh, “Ccungccaw hae laku kya ka teingpaw maethyanaw kha lawpya khylan Bawipaw nynh yn bawm zah, e hynh yn cyipya,” a ci.</para>
  <para style="s1">Jesu Pui lanpaw Hotynaw</para>
  <para style="p">
    <verse number="26" style="v" />Sawpaw sah taruhnaw lyakhe Pachia nynh vaawpaw Gabriel kha Galilee ram, Nazareth a ci hae paw khua kya umpaw liaccady<note caller="+" style="f"><char style="fr" closed="false">1.26 </char><char style="ft" closed="false">Liaccady: Pise te a ihkheih boi leipaw liaccaw.</char></note> kalan a saw, <verse number="27" style="v" />tuh-e liaccady tuh David ciihan athuapaw a min Josef a ci hae paw ccungccapaw elang a dypya vae hae paw thua zah a min tuh Mary acikuh.<note caller="-" style="x"><char style="xo" closed="false">1.27: </char><char style="xt" closed="false"><ref loc="MAT 1:18">Mat 1.18</ref></char></note> <verse number="28" style="v" />Vaawpaw nynh tuh-e nung kalan yn thua zah, “Maehoynaw a ccounung, na tungvaw hythuanaw um sah! Bawipaw tuh na kya a um,” a cipya. <verse number="29" style="v" />Mary nynh tuh-e bya a thae te, a lungriathae zah, e byabeihnaw hynh pawcihawpaw mou athua cite a tua. <verse number="30" style="v" />Vaawpaw nynh, “Mary, rih nan, pawccecize Pachia nynh nang kha maehoynaw ae pya. <verse number="31" style="v" />Ccaaw na poi cih zah Ccapaw na saah cih, a min tuh Jesu cite na phu cih.<note caller="-" style="x"><char style="xo" closed="false">1.31: </char><char style="xt" closed="false"><ref loc="MAT 1:21">Mat 1.21</ref></char></note> <verse number="32" style="v" />Aning tuh a lesaepaw athua cih zah Ahang Huaccepaw Pachia Ccapaw cite ko athua cih, Bawipaw Pachia nynh amaw tuh a minpaaw David kya-e bawitungkhung kha a pya cih.<note caller="-" style="x"><char style="xo" closed="false">1.32-33: </char><char style="xt" closed="false"><ref loc="2SA 7:12">2Sa 7.12</ref>, <ref loc="2SA 7:13">13</ref>, <ref loc="2SA 7:16">16</ref>; <ref loc="ISA 9:7">Isa 9.7</ref></char></note> <verse number="33" style="v" />Aning nynh Jakob ciihan kha zungzae a uk cih zah a peenaw tuh thang boi lan khyh,” a cipya. <verse number="34" style="v" />Mary nynh vaawpaw kha, “Kae tuh liaccady nynh ka thua, pawtemou tuh-e tuh athua kho cih?” a cipya. <verse number="35" style="v" />Vaawpaw nynh, “Thyaa Muisaw tuh na tungvaw yn thua cih zah Ahang Huaccepaw thungnaw tuh na tungvaw yn um cih; Tukeiccuze na saah lanpaw Ccapaw tuh athyaapaw athua cih zah Pachia Ccapaw cite ko athua cih. <verse number="36" style="v" />Dotua, na pui oh paw Elizabeth, a tiinnung a ci hae paw mah a taw vae mawte ccaawpoi zah atu hynh sawpaw sah taruh acih vae. <verse number="37" style="v" />Pawccecize Pachia nynh a cyi kho leipaw pawpaw mah um khyh,” a cipya.<note caller="-" style="x"><char style="xo" closed="false">1.37: </char><char style="xt" closed="false"><ref loc="GEN 18:14">Gen 18.14</ref></char></note> <verse number="38" style="v" />Mary nynh, “Kae tuh Bawipaw seenung nynh ka thua, na bya hawte ka tungvaw thua vae sah,” a ci. Te vaawpaw tuh Mary kyate phe a cceih.</para>
  <para style="s1">Mary nynh Elizabeth A Paebua</para>
  <para style="p">
    <verse number="39" style="v" />Tuin nin hae kyakhe Mary tuh thokuh zah Judea muaram kya a umpaw khua langkhe arangte a cceih, <verse number="40" style="v" />Zekhariah inn lang tee zah Elizabeth kha a beih. <verse number="41" style="v" />Mary nynh bya a beihpaw kha Elizabeth nynh he a thae tuh, a vue lungkhu e imua tuh a thohkuh. Elizabeth tuh Thyaa Muisaw te phe beih zah, <verse number="42" style="v" />aning nynh roi accae lante a hopaw tuh: “Nopi hae lakuze nang tuh hythua a ccounung nynh na thua, na vue kya-e imua mah hythua a ccoupaw nynh thua. <verse number="43" style="v" />Ka Bawipaw a nung nynh ka kalan paebua lan ciate pawccemou hynh-e maehoynaw hynh kae nynh ka mue? <verse number="44" style="v" />Pawccecize bya nae beihpaw roi ccahe ka thae te, ka vue lungkhu e imua tuh a lungtua zah a thohkuh. <verse number="45" style="v" />Bawipaw nynh a hopyapaw bya kha accing cih cite a zynpaw nopinung tuh hythua a ccounung nynh thua,” a ci.</para>
  <para style="s1">Mary Hlaw</para>
  <para style="p">
    <verse number="46" style="v" />Mary nynh,</para>
  <para style="q1">“Ka thinlung nynh Bawipaw kha</para>
  <para style="q2">the a hoysah,<note caller="-" style="x"><char style="xo" closed="false">1.46-55: </char><char style="xt" closed="false"><ref loc="1SA 2:1-10">1Sa 2.1-10</ref></char></note></para>
  <para style="q1">
    <verse number="47" style="v" />ka hiinnaw tuh yn Khumtu</para>
  <para style="q2">Pachia kya a lungtua.</para>
  <para style="q1">
    <verse number="48" style="v" />Pawccecize a seenung</para>
  <para style="q2">a nyaanaw kha ningpah khyh.</para>
  <para style="q1">Atu te she takyh kya</para>
  <para style="q2">hythua ccounung cite</para>
  <para style="q2">yn ko vae cih hae.<note caller="-" style="x"><char style="xo" closed="false">1.48: </char><char style="xt" closed="false"><ref loc="1SA 1:11">1Sa 1.11</ref></char></note></para>
  <para style="q1">
    <verse number="49" style="v" />Pawccecize Athungpaw Pachia nynh</para>
  <para style="q2">myarya lepaw uccaw hae kha</para>
  <para style="q1">ka hanlan yn cyipya vae;</para>
  <para style="q2">a min tuh athyaa.</para>
  <para style="q1">
    <verse number="50" style="v" />A thawccinaw tuh amaw raw</para>
  <para style="q2">a rih hae paw tungvaw kya</para>
  <para style="q2">she takyh atyn.</para>
  <para style="q1">
    <verse number="51" style="v" />A thungnaw khate</para>
  <para style="q2">a thawzung kha a langsah;</para>
  <para style="q1">mih thinlung kya</para>
  <para style="q2">a lysakuh hae paw kha</para>
  <para style="q1">pong a phiasaku hae.</para>
  <para style="q1">
    <verse number="52" style="v" />Athungpaw ccungccaw hae kha</para>
  <para style="q2">mih bawitungkhung kyate</para>
  <para style="q1">sahbung hae zah,</para>
  <para style="q2">a nyaa hae paw kha a hangthung hae.<note caller="-" style="x"><char style="xo" closed="false">1.52: </char><char style="xt" closed="false"><ref loc="JOB 5:11">Job 5.11</ref>, <ref loc="JOB 12:19">12.19</ref></char></note></para>
  <para style="q1">
    <verse number="53" style="v" />Mih vuelaw hae paw kha</para>
  <para style="q2">uccaw hoypaw te a kua hae,</para>
  <para style="q1">mihoi hae kha mih kuih ccakaete</para>
  <para style="q2">a cciasah hae.</para>
  <para style="q1">
    <verse number="54-55" style="v" />Ah minpaawhae kya,</para>
  <para style="q2">Abraham kya te</para>
  <para style="q1">a ciihan hae kya a hosya vae hawte,</para>
  <para style="q2">a ngaethya-umsahnaw kha liathui zah</para>
  <para style="q1">a seepaw Israel kha</para>
  <para style="q2">phe a bawm vae,” a ci.<note caller="-" style="x"><char style="xo" closed="false">1.55: </char><char style="xt" closed="false"><ref loc="GEN 17:7">Gen 17.7</ref></char></note></para>
  <para style="p">
    <verse number="56" style="v" />Mary tuh Elizabeth ryte sawpaw sah thum loukaw a umkheih kou hae te, a inn lang a ki.</para>
  <para style="s1">Baptisma Pyatu Johan Puinaw</para>
  <para style="p">
    <verse number="57" style="v" />Elizabeth tuh aninsaw yn kyh zah ccapaw yn saah. <verse number="58" style="v" />Bawipaw nynh Elizabeth tungvaw kya myarya lepaw a thawccinaw a langsahpyaku cipaw kha a innpaw hae te a vaeccaw hae nynh he a thae hae tuh, amaw ryte mih lung atua.</para>
  <para style="p">
    <verse number="59" style="v" />Nin taryanaw nin kya imua tuh vingdungaw lan a cciakhae hae, a paaw min kha kisah te Zekhariah cite a minphu lan a ci hae.<note caller="-" style="x"><char style="xo" closed="false">1.59: </char><char style="xt" closed="false"><ref loc="LEV 12:3">Lev 12.3</ref></char></note> <verse number="60" style="v" />Thuasalama a nung nynh, “Thua khyh, Johan cite a minphu lan,” a ci. <verse number="61" style="v" />Minmin nynh, “Na pui oh paw kya tuh-e min a phukuhpaw lu kheit san um boi khyh,” a ci hae. <verse number="62" style="v" />Tuinte minmin nynh a paaw kha pawtemou min na phu ry cite tangpyate a khia hae. <verse number="63" style="v" />A paaw nynh zei nawlan ccalung kha ngiakuh hae zah, “A min tuh Johan nynh thua,” cite a zei. Mih balynte mih ngaeang pong thua. <verse number="64" style="v" />Zekhariah tuh vaekheihmawte a munglae yn hoythui zah bya yn hothya, te Pachia kha the a hoysah. <verse number="65" style="v" />Mih innpaw hae balyn tuh a rih hae, tuh-e thongpang tuh Judea muaram balyn kya azeihkuh. <verse number="66" style="v" />A thae hae paw balyn nynh tuh-e tuh mih thinlung kya ccykekuh hae zah, “E imua hynh pawlang vema yn tang?” a ci hae. Pawccecize Bawipaw kuih nynh imuapaw kha a umkhae.</para>
  <para style="s1">Zekhariah nynh Profehbya Honaw</para>
  <para style="p">
    <verse number="67" style="v" />A paaw Zekhariah tuh Thyaa Muisaw te phe beih zah profehbya a ho:</para>
  <para style="q1">
    <verse number="68" style="v" />“Israel Pachia Bawipaw tuh</para>
  <para style="q2">thehoysah oh sih,</para>
  <para style="q1">pawccecize a ccungccaw hae kha</para>
  <para style="q2">bawm hae zah a shawkhaw hae.</para>
  <para style="q1">
    <verse number="69" style="v" />A seepaw David ciihan kyate</para>
  <para style="q2">aening hanlan athungpaw</para>
  <para style="q2">khumtu kha a langsaku vae.</para>
  <para style="q1">
    <verse number="70" style="v" />Langmawlya mawte</para>
  <para style="q2">athyaapaw a profeh hae</para>
  <para style="q2">munglae kyate a ho hawte,</para>
  <para style="q1">
    <verse number="71" style="v" />ah rhaw hae te oun huatu hae</para>
  <para style="q2">kuih kyate khum ah thua cih oh.</para>
  <para style="q1">
    <verse number="72" style="v" />Ah minpaaw hae kya</para>
  <para style="q2">bya a kinkupaw a thawccinaw kha</para>
  <para style="q1">langsah zah athyaapaw</para>
  <para style="q2">a byakinnaw kha a liathui vae,</para>
  <para style="q1">
    <verse number="73-74" style="v" />Ah minpaaw Abraham kyaze,</para>
  <para style="q2">‘Nae rhaw hae kyate</para>
  <para style="q1">kae luesah cih oh;</para>
  <para style="q2">rinaw hoi leite ka rya na lah cih oh,</para>
  <para style="q1">
    <verse number="75" style="v" />nae hiin lungkhu balyn</para>
  <para style="q2">ka malang khe adingpaw te</para>
  <para style="q1">athyaapaw lang na tang cih oh,’</para>
  <para style="q2">cite thyalawkute bya a kinku.</para>
  <para style="q1">
    <verse number="76" style="v" />Imuapaw, nang tuh</para>
  <para style="q2">Ahang Huaccepaw Pachia profeh</para>
  <para style="q1">cite ko na thua cih,</para>
  <para style="q2">pawccecize nang tuh</para>
  <para style="q1">Bawipaw laanpi kha paccynpya khylan</para>
  <para style="q2">amaw malang na cceih ty cih,<note caller="-" style="x"><char style="xo" closed="false">1.76: </char><char style="xt" closed="false"><ref loc="MAL 3:1">Mal 3.1</ref></char></note></para>
  <para style="q1">
    <verse number="77" style="v" />a ccungccaw hae kha,</para>
  <para style="q2">mih seinaw ngaethyanaw liate</para>
  <para style="q1">khumnaw kong nynaw</para>
  <para style="q2">pya khylan hae na cceih ty cih.</para>
  <para style="q1">
    <verse number="78" style="v" />Ah Pachia kya-e nevyalyapaw</para>
  <para style="q2">ngaethyaumsahnaw liate</para>
  <para style="q1">vaawlang e khuaninpaw nynh</para>
  <para style="q2">aening tungvaw yn thua cih,</para>
  <para style="q1">
    <verse number="79" style="v" />mohnaw te chinaw mynlyh kya</para>
  <para style="q2">a haung hae paw kha</para>
  <para style="q1">awnaw pya khylan,</para>
  <para style="q2">daenaw laanpi langkhe</para>
  <para style="q1">aening ccu kha cciakhae khylan</para>
  <para style="q2">nynh thua,” cite a ho.<note caller="-" style="x"><char style="xo" closed="false">1.79: </char><char style="xt" closed="false"><ref loc="ISA 9:2">Isa 9.2</ref></char></note></para>
  <para style="p">
    <verse number="80" style="v" />Imuapaw tuh lethung zah muisaw kya a thawsae, te Israel hae kalan a langku maw tuh ramkaw kya nynh a um.</para>
  <chapter number="2" style="c" />
  <para style="s1">Jesu Khri Puinaw</para>
  <para style="r">(<ref loc="MAT 1:18-25">Mat 1.18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Tuh ccyh lyakhe Siapharan Awkastas nynh ram pynpi balyn kya milu riaku athua cih cite kaw a tho. <verse number="2" style="v" />E milu rianaw hynh masaty milu rianaw thua zah Kuirinias nynh Siria ram a uk lya nynh thua. <verse number="3" style="v" />Ccungccaw hae balyn tuh milu riaku khylan mih khua raveih lang a cceih hae. <verse number="4" style="v" />Josef mah David ciihan athua keiccuze, Galilee ram Nazareth khua kyate Judea ram Bethlehem a ci hae paw David khua lang a cceih. <verse number="5" style="v" />A zu lang a dykupaw Mary ryte milu riaku lan a cceih hae; Mary tuh ccaawpoi zah, <verse number="6" style="v" />tuin kya a um lya hae khe, neitaw pui lan aninsaw akyh. <verse number="7" style="v" />Mary a ccatawccaw tuh yn pui zah nolung te a lung koute, vaetua looh-aenaw kua kya a isah; pawccecize minmin hanlan mikhia thuanaw inn kya akhaan um vae khyh.</para>
  <para style="s1">Tuurin hae te Vaaw hae</para>
  <para style="p">
    <verse number="8" style="v" />Tuin ram kya khuazi khe mih tuuphu kha rin hae zah ramkaw kya a um hae paw tuurin hae a um hae. <verse number="9" style="v" />Bawipaw vaawpaw nynh mih kalan yn thua zah Bawipaw phu-enaw tuh mih pepan phaephae a aw; te minmin tuh myarya a rih hae. <verse number="10" style="v" />Thuasalama vaawpaw nynh minmin kha, “Rih nan oh, pawccecize ccungccaw balyn hanlan myarya lungtua lan umpaw thongpang hoypaw kha kae thuakhaepya oh: <verse number="11" style="v" />Pawccecize atunin David khua kya nanning hanlan Khumtu Bawi Khri a pui vae. <verse number="12" style="v" />E hynh nanning hanlan syntawnaw athua cih: imua kha nolung te lung hae zah vaetua looh-aenaw kua kya a isah hae paw kha na la muih cih oh,” a cipya hae. <verse number="13" style="v" />Vaekheihmawte vaawpaw ryte vaaw rhawkawbuupi tuh oun langkuh hae zah Pachia kha a thehoysah hae zah,</para>
  <para style="q1">
    <verse number="14" style="v" />“Ahang huapaw vaawlang kya</para>
  <para style="q2">Pachia tuh phu-esah thua sah,</para>
  <para style="q1">a sungsah hae paw a umnaw hae</para>
  <para style="q2">lae vawlan hin daenaw um sah!” a ci hae.</para>
  <para style="p">
    <verse number="15" style="v" />Vaaw hae tuh mih kyate vaawlang he a cceih hae te, tuurin hae nynh, “Atu Bethlehem lang cceih oh sih lah Bawipaw nynh oun nysahpaw hynh-e uccaw acyihkuhpaw hynh dotua oh sih,” cite lu kheit te lu kheit a hoku hae. <verse number="16" style="v" />Minmin tuh arangte cceih hae zah Mary, Josef te vaetua looh-aenaw kua kya a ihpaw imua kha a muih hae. <verse number="17" style="v" />Tuurin hae nynh imua kha he a muih hae tuh, vaaw hae nynh imua konglang a hopya hae paw kha ccungccaw hae kya a ho pathy hae. <verse number="18" style="v" />Tuurin hae nynh a ho hae paw bya a thae hae paw balyn tuh mih ngaeangthua. <verse number="19" style="v" />Mary nynh tuh-e balyn tuh a thinlung kya ccykekuh zah thawte a tua. <verse number="20" style="v" />Tuurin hae tuh vaawpaw nynh a hopya hae thyhte, a thae hae paw te a muih hae paw balyn hanlan Pachia kha phu-esah hae zah thehoysah biate a ki hae.</para>
  <para style="s1">Beikinn kya Jesu Thuakhaenaw</para>
  <para style="p">
    <verse number="21" style="v" />Nin tarya ccing vae zah imua kha vingdungaw ccyh yn zaw tuh, Jesu cite min a phu hae, tuh-e min tuh a nung nynh a poi mawze vaawpaw nynh a phu ty vae paw min nynh thua.<note caller="-" style="x"><char style="xo" closed="false">2.21: </char><char style="xt" closed="false"><ref loc="LEV 12:3">Lev 12.3</ref>; <ref loc="LUK 1:31">Luk 1.31</ref></char></note></para>
  <para style="p">
    <verse number="22" style="v" />Moses kawbya thyhte, Mary te Josef elang thyaasahkunaw ccyh yn zaw tuh, minmin nynh imuapaw kha Bawipaw kalan thuakhae khylan Jerusalem lang a cciakhae hae,<note caller="-" style="x"><char style="xo" closed="false">2.22-24: </char><char style="xt" closed="false"><ref loc="LEV 12:6-8">Lev 12.6-8</ref></char></note> <verse number="23" style="v" />(Bawipaw Kawbya kyaze, “Ccatawccaw pise miakaw tuh Bawipaw kalan pya athua cih,” cite azeikuh);<note caller="-" style="x"><char style="xo" closed="false">2.23: </char><char style="xt" closed="false"><ref loc="EXO 13:2">Exo 13.2</ref>, <ref loc="EXO 13:12">12</ref></char></note> <verse number="24" style="v" />“vahu bua kheit, tuhkhyhze valaele anopaw sa ning te silawnaw na rae cih oh,” cite Bawipaw kawbya kya a um thyhte, minmin nynh silawnaw a rae hae.</para>
  <para style="s1">Simeon Anna nynh Thehoysah hae</para>
  <para style="p">
    <verse number="25" style="v" />A min Simeon a ci hae paw ccungccaw lu kheit tuh Jerusalem kya a um. Aning tuh adingpaw te beiknaw lang a zuakuhpaw nynh thua, Israel hae ngaengannaw kha a ngaehoipaw thua zah Thyaa Muisaw tuh amaw kya a um. <verse number="26" style="v" />Thyaa Muisaw nynh amaw kha, Bawipaw kya-e Messiah kha na muih makhia na chih lan khyh, cite a hopya. <verse number="27" style="v" />Muisaw nynh cciakhae zah Simeon tuh beikinn voidu kya a thua; imuapaw Jesu kha kawbya phung thyhte cyipya lan cite a nung te a paaw nynh he a teekhae hae tuh, <verse number="28" style="v" />Simeon nynh imua kha a kuih kya duate Pachia kha thehoysah zah,</para>
  <para style="q1">
    <verse number="29" style="v" />“Bawipaw, na bya thyhte</para>
  <para style="q2">atu na seepaw hynh</para>
  <para style="q2">daebabi lan yn cciasah ccavae;</para>
  <para style="q1">
    <verse number="30" style="v" />pawccecize na khumnaw kha</para>
  <para style="q2">ka mit te phe ka muih vae,</para>
  <para style="q1">
    <verse number="31" style="v" />tuh-e tuh ccungccaw balyn</para>
  <para style="q2">muihnaw kya na paccyn vae;</para>
  <para style="q1">
    <verse number="32" style="v" />tuh-e tuh Zenta hae</para>
  <para style="q2">a awsah cih paw awnaw te</para>
  <para style="q1">na ccungccaw Israel hae hanlan</para>
  <para style="q2">phu-enaw nynh thua,” cite a ho.</para>
  <para style="p">
    <verse number="33" style="v" />Simeon nynh imuapaw konglang a hopaw kha a thae hae tuh, Josef te a nung tuh mih ngaeangthua. <verse number="34" style="v" />Simeon nynh minmin kha hythuapya hae zah a nung Mary kha, “E imua tuh Israel hae patae khulia nawlan te tho nawlan Pachia nynh a popaw nynh thua. Amaw tuh ccungccaw hae nynh a thethyasah hae paw te Pachia kyate yn thuapaw syntawnaw athua cih zah, <verse number="35" style="v" />mih thinlung kya-e tuanaw balyn kha a langsahtu lang a tang cih. Thaloi nynh namaw na thinlung kha mah ae thuing cih,” a cipya.</para>
  <para style="p">
    <verse number="36" style="v" />Asher phin, Fanuel ccanung Anna a ci hae paw profehnung lu kheit a um. Aning tuh myarya taw vae, vawpaw a hoi koute kum sari cia a vawpaw ryte a umkheih hae. <verse number="37" style="v" />Sung tarya kum pali cia nomaenung lang a tang, khuazi khuadae sawsangte looh-ae sungte Pachia beik zah beikinn kyate papin pou khyh. <verse number="38" style="v" />Aning mah tuh ccyh lyakhe yn tee zah Pachia kha the a hoysah, te Jerusalem tuh shawkhaw athua cih cite a ngaehoi hae paw balyn kyakhe tuh-e imua kong kha a hopya hae.</para>
  <para style="s1">Nazareth lang A Ki hae</para>
  <para style="p">
    <verse number="39" style="v" />A nung te a paaw nynh Bawipaw kawbya thyhawte pawpaw balyn kha phe a cyih kou hae te, Galilee ram umpaw mih khua Nazareth langkhe a ki hae.<note caller="-" style="x"><char style="xo" closed="false">2.39: </char><char style="xt" closed="false"><ref loc="MAT 2:23">Mat 2.23</ref></char></note> <verse number="40" style="v" />Imua tuh yn lethung zah myarya a thung, hawnaw te beih zah Pachia thawccinaw tuh a tungvaw a um.</para>
  <para style="s1">Beikinn kya Imuapaw Jesu</para>
  <para style="p">
    <verse number="41" style="v" />A nung te a paaw tuh Kawtaw Poi ccyh kya kum takyhte Jerusalem lang leih a cceih hae.<note caller="-" style="x"><char style="xo" closed="false">2.41: </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">Exo 12.1-27</ref>; <ref loc="DEU 16:1-8">Deu 16.1-8</ref></char></note> <verse number="42" style="v" />Jesu tuh kum haw lae ning he acih te, Kawtaw Poi phung thyhawte Jerusalem lang a cceihthung hae. <verse number="43" style="v" />Poi nin he athang te a nung te a paaw tuh a ki hae, imuapaw Jesu tuh Jerusalem kya a umhy ung, Josef te a nung nynh tuh-e tuh nyh khyh hae. <verse number="44" style="v" />A kikheih hae paw kya nynh a umbua cih cite minmin nynh tua hae zah nin kheit laanccia cia a cceih vae hae; te mih vaeccaw hae te mih ban hae kya a ccung hae. <verse number="45" style="v" />Minmin nynh amaw kha a muih khyh hae keiccuze Jerusalem lang bua ki hae zah a ccung hae. <verse number="46" style="v" />Nin thum koute, minmin nynh amaw kha beikinn kya ccangpahtu hae laku haung zah mih bya kha ngae zah minmin bya a khia hae paw kha a muih hae. <verse number="47" style="v" />A bya a thae hae paw balyn nynh a hawzia te bya a khungzia kha mih ngaeangthua. <verse number="48" style="v" />A nung te a paaw nynh he a muih hae tuh, mih ngaeangthua zah, a nung nynh, “Ka ccapaw, pawccemou kaening hynh hynhte nae cyi? Dotua, na paaw te kae tuh thinphangte nang kha kae ccung,” a cipya. <verse number="49" style="v" />Jesu nynh minmin kha, “Pawccemou nae ccung oh? Ka Paaw inn kya ka um lanpaw nynh ka thua cipaw na nyh khyh oh tou?” a cipya hae. <verse number="50" style="v" />A hopya hae paw bya kha minmin nynh thaethya khyh hae. <verse number="51" style="v" />Te Jesu tuh a nung a paaw hae ryte cceihbung hae zah Nazareth khua a thua hae, aning nynh minmin kaw kha a ngae. A nung nynh e konglang balyn hynh a thinlung kya a ccykeku.</para>
  <para style="p">
    <verse number="52" style="v" />Jesu tuh pyn lante thuasah, hawnaw lante thuasah yn lethung zah, Pachia malang te ccungccaw malang maehoynaw a mue.<note caller="-" style="x"><char style="xo" closed="false">2.52: </char><char style="xt" closed="false"><ref loc="1SA 2:26">1Sa 2.26</ref>; <ref loc="PRO 3:4">Ptb 3.4</ref></char></note></para>
  <chapter number="3" style="c" />
  <para style="s1">Baptisma Pyatu Johan Phungho</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mat 3.1-12</ref>; <ref loc="MRK 1:1-8">Mar 1.1-8</ref>; <ref loc="JHN 1:19-28">Joh 1.19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Siapharan Tiberias nynh a uknaw kum haw lae pangaw lyakhe Pontias Pilat tuh Judea pee uktu thua zah Herod tuh Galilee pee uktu nynh thua; a neitaw Filip tuh Iturea pee te Trakhonitis pee kya uktu thua zah Lisanias tuh Abilene pee kya uktu nynh thua. <verse number="2" style="v" />Annas te Kaiafas tuh ranpibawi lupi thua hae zah, tuh ccyh lyakhe Pachia bya tuh ramkaw kyakhe Zekhariah ccapaw Johan kalan yn thua. <verse number="3" style="v" />Johan tuh Jordan vaw pepan umpaw ram balyn kalan khe cceih zah seinaw ngaethyanaw hanlan ngaesikunaw te asekuhpaw baptisma kong kha a ho. <verse number="4" style="v" />Profeh Isaiah bya kha ccauh kya azeiku thyhawte:<note caller="-" style="x"><char style="xo" closed="false">3.4-6: </char><char style="xt" closed="false"><ref loc="ISA 40:3-5">Isa 40.3-5</ref> (LXX)</char></note></para>
  <para style="q1">“Ramkaw kya a siapaw</para>
  <para style="q2">lukheitpaw roi nynh,</para>
  <para style="q1">‘Bawipaw laanpi kha</para>
  <para style="q2">paccynpah oh, a laanpi kha</para>
  <para style="q2">lawbabin lan raepah oh.</para>
  <para style="q1">
    <verse number="5" style="v" />Akhunaw miakaw kha</para>
  <para style="q2">bia athua cih zah mua te</para>
  <para style="q1">sangpyng miakaw kha</para>
  <para style="q2">tuphae athua cih;</para>
  <para style="q1">akoupaw laanpi kha</para>
  <para style="q2">lawbabin lan rae athua cih zah,</para>
  <para style="q1">karynkare a umpaw laanpi kha</para>
  <para style="q2">nginsah athua cih.</para>
  <para style="q1">
    <verse number="6" style="v" />Ccungccaw balyn nynh</para>
  <para style="q2">Pachia kya-e khumnaw kha</para>
  <para style="q1">a muih cih hae,’ a ci,” cite a ho.</para>
  <para style="p">
    <verse number="7" style="v" />Johan nynh amaw kya baptisma in lan oun cceih hae paw ccungccaw zapi kha, “Pou huparepaw ciihan hae, yn thua cih paw thinrianaw kyate ccue lan hum nynh mou raeringnaw ae pya oh?<note caller="-" style="x"><char style="xo" closed="false">3.7: </char><char style="xt" closed="false"><ref loc="MAT 12:34">Mat 12.34</ref>, <ref loc="MAT 23:33">23.33</ref></char></note> <verse number="8" style="v" />Ngaesikunaw te angaekuhpaw athae hae kha langsakuh oh; ‘Abraham tuh kae paaw nynh thua,’ cite tuakuh nan oh. Pawccecize Pachia tuh hynh-e lung hae kyate Abraham ccaaw hae kha a rae kho cipaw kae hopya oh.<note caller="-" style="x"><char style="xo" closed="false">3.8: </char><char style="xt" closed="false"><ref loc="JHN 8:33">Joh 8.33</ref></char></note> <verse number="9" style="v" />Atu mah thingku leihpaw kya hae tuh nungde athua vae, tukeiccuze ahoypaw athae thae leipaw thingku miakaw tuh nge thua zah maee lungkhu lang phung athua,” a ci.<note caller="-" style="x"><char style="xo" closed="false">3.9: </char><char style="xt" closed="false"><ref loc="MAT 7:19">Mat 7.19</ref></char></note></para>
  <para style="p">
    <verse number="10" style="v" />Ccungccaw zapi nynh Johan kha, “Tuhteze pawmou kae cyih cih?” cite a khia hae. <verse number="11" style="v" />Aning nynh minmin kha, “Angki zung ning a hoipaw nynh a hoi leipaw kha pyabua sah, looh a hoipaw nynh tuh-e hawte cyih sah,” a cipya hae. <verse number="12" style="v" />Ngunto khoi hae paw mah baptisma in lan oun thua hae zah, “Sazae, pawmou kae cyih cih,” cite a khia hae.<note caller="-" style="x"><char style="xo" closed="false">3.12: </char><char style="xt" closed="false"><ref loc="LUK 7:29">Luk 7.29</ref></char></note> <verse number="13" style="v" />Aning nynh, “Khoi lan a khya hae paw laeze alung lante la khoi nan oh,” a cipya hae. <verse number="14" style="v" />Tuhawte rhawkaw hae nynh mah, “Kaening nynh pawmou kae cyih cih,” cite khia hae zah, aning nynh, “Hum ccungccaw kya-e sanmah hurawte la luade nan oh, hum sanmah ahme lei lante seibe nan oh, na mue oh paw amee khate nae lungryachih sah,” a cipya hae.</para>
  <para style="p">
    <verse number="15" style="v" />Ccungccaw hae nynh Johan kha ngaehoi hae zah, mih thinlung kyakhe Messiah thua vema, thua khyh vema cite mih balynte a tua lya hae khe, <verse number="16" style="v" />Johan nynh minmin balyn kyakhe, “Kae nynh nanning kha tui te baptisma kae pya oh; thuasalama kae laeze athung huapaw lu kheit yn thua cih, tuh-e paw a phanah rui phoupya lan sanmah kae tuh ka ngaekuh khyh; aning nynh nanning kha Thyaa Muisaw te thuasah, maee te thuasah baptisma ae pya cih oh. <verse number="17" style="v" />A zawnawpaw paraw tuh a kuih kya um zah a huihmin kha thyaapaping lan a cciccae cih, te chanvuih kha a byng lungkhu lang a ruin cih, thuasalama asipaw tuh a chih kho leipaw maee te a soi cih,” a cipya hae.</para>
  <para style="p">
    <verse number="18" style="v" />Ccangpaw bya patae te thuihei hae zah thehoypaw kha ccungccaw hae kalan a hopya hae. <verse number="19" style="v" />Thuasalama ram uktu Herod kha a neitaw Filip zu Herodias konglang te Herod nynh a cyipaw hoyleinaw balyn keiccuze Johan nynh a pe,<note caller="-" style="x"><char style="xo" closed="false">3.19-20: </char><char style="xt" closed="false"><ref loc="MAT 14:3-4">Mat 14.3-4</ref>; <ref loc="MRK 6:17-18">Mar 6.17-18</ref></char></note> <verse number="20" style="v" />Herod nynh a seinaw balyn vawlan khe houh biachih zah Johan kha thong kya a saw.</para>
  <para style="s1">Jesu Baptisma Innaw</para>
  <para style="r">(<ref loc="MAT 3:13-17">Mat 3.13-17</ref>; <ref loc="MRK 1:9-11">Mar 1.9-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" />Ccungccaw hae balyn tuh baptisma a in hae, Jesu mah baptisma inbua zah saw a sang lyakhe vaawlang yn hungkuh zah, <verse number="22" style="v" />Thyaa Muisaw tuh vahu hawte pyn lante yn langkuh zah Jesu tungvaw yn ccuh; vaawlang te roi yn ccae zah, “Nang tuh ka sungsahpaw ka Ccapaw nynh na thua; na tungvaw kya ka lungry accing,” a ci.<note caller="-" style="x"><char style="xo" closed="false">3.22: </char><char style="xt" closed="false"><ref loc="GEN 22:2">Gen 22.2</ref>; <ref loc="PSA 2:7">Sam 2.7</ref>; <ref loc="ISA 42:1">Isa 42.1</ref>; <ref loc="MAT 3:17">Mat 3.17</ref>; <ref loc="MRK 1:11">Mar 1.11</ref>; <ref loc="LUK 9:35">Luk 9.35</ref></char></note></para>
  <para style="s1">Jesu Thokeinaw</para>
  <para style="r">(<ref loc="MAT 1:1-17">Mat 1.1-17</ref>)</para>
  <para style="p">
    <verse number="23" style="v" />Jesu nynh a ryalaw a thotakaw lya tuh kum sung thum loukaw acih vae. Ccungccaw hae nynh Josef ccapaw cite a tua hae; Josef tuh Heli ccapaw, <verse number="24" style="v" />Heli tuh Matthat ccapaw, Matthat tuh Levi ccapaw, Levi tuh Melkhi ccapaw, Melkhi tuh Jannai ccapaw, Jannai tuh Josef ccapaw, <verse number="25" style="v" />Josef tuh Mattathias ccapaw, Mattathias tuh Amos ccapaw, Amos tuh Nahum ccapaw, Nahum tuh Eshli ccapaw, Eshli tuh Naggai ccapaw, <verse number="26" style="v" />Naggai tuh Maath ccapaw, Maath tuh Mattathias ccapaw, Mattathias tuh Semein ccapaw, Semein tuh Josek ccapaw, Josek tuh Judah ccapaw, <verse number="27" style="v" />Judah tuh Joanan ccapaw, Joanan tuh Rhesa ccapaw, Rhesa tuh Zerubbabel ccapaw, Zerubbabel tuh Shealtiel ccapaw, Shealtiel tuh Neri ccapaw; <verse number="28" style="v" />Neri tuh Melkhi ccapaw, Melkhi tuh Addi ccapaw, Addi tuh Kosam ccapaw, Kosam tuh Elmadam ccapaw, Elmadam tuh Er ccapaw, <verse number="29" style="v" />Er tuh Joshua ccapaw, Joshua tuh Eliazar ccapaw, Eliazar tuh Jorim ccapaw, Jorim tuh Matthat ccapaw, Matthat tuh Levi ccapaw, <verse number="30" style="v" />Levi tuh Simeon ccapaw, Simeon tuh Judah ccapaw, Judah tuh Josef ccapaw, Josef tuh Jonam ccapaw, Jonam tuh Eliakim ccapaw, <verse number="31" style="v" />Eliakim tuh Melea ccapaw, Melea tuh Menan ccapaw, Menan tuh Mattatha ccapaw, Mattatha tuh Nathan ccapaw, Nathan tuh David ccapaw, <verse number="32" style="v" />David tuh Jessi ccapaw, Jessi tuh Obed ccapaw, Obed tuh Boaz ccapaw, Boaz tuh Salmon ccapaw, Salmon tuh Nahshon ccapaw; <verse number="33" style="v" />Nahshon tuh Amminadab ccapaw, Amminadab tuh Admin ccapaw, Admin tuh Arni ccapaw, Arni tuh Hezron ccapaw, Hezron tuh Perez ccapaw, Parez tuh Judah ccapaw, <verse number="34" style="v" />Judah tuh Jakob ccapaw, Jakob tuh Isak ccapaw, Isak tuh Abraham ccapaw, Abraham tuh Terah ccapaw, Terah tuh Nahor ccapaw, <verse number="35" style="v" />Nahor tuh Serug ccapaw, Serug tuh Reu ccapaw, Reu tuh Peleg ccapaw, Peleg tuh Eber ccapaw, Eber tuh Shelah ccapaw, <verse number="36" style="v" />Shelah tuh Kainan ccapaw, Kainan tuh Arphasad ccapaw, Arphasad tuh Shem ccapaw, Shem tuh Noah ccapaw, Noah tuh Lamek ccapaw, <verse number="37" style="v" />Lamek tuh Methuselah ccapaw, Methuselah tuh Enok ccapaw, Enok tuh Jared ccapaw, Jared tuh Mahalaleel ccapaw, Mahalaleel tuh Kainan ccapaw, <verse number="38" style="v" />Kainan tuh Enos ccapaw, Enos tuh Seth ccapaw, Seth tuh Adam ccapaw, Adam tuh Pachia ccapaw nynh thua.</para>
  <chapter number="4" style="c" />
  <para style="s1">Jesu Tuhounaw</para>
  <para style="r">(<ref loc="MAT 4:1-11">Mat 4.1-11</ref>; <ref loc="MRK 1:12-13">Mar 1.12-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Jesu tuh Thyaa Muisaw te beih zah Jordan vaw kyate a ki, te Muisaw nynh ramkaw langkhe a cciakhae. <verse number="2" style="v" />Nin sung pali cia Satan nynh a tuhou. Tuh ccyh lya balyn tuh pawpaw mah ae khyh, tuh-e ccyh he athang tuh a vue myarya law. <verse number="3" style="v" />Satan nynh Jesu kha, “Pachia Ccapaw na thua lanze e lung hynh sanlou lang a tang nawlan kawpya tua,” a cipya. <verse number="4" style="v" />Jesu nynh, “ ‘Ccungccaw tuh looh kyalya te hiin khyh,’ cite Ccathyaa kya azeikuh,” a cipya.<note caller="-" style="x"><char style="xo" closed="false">4.4: </char><char style="xt" closed="false"><ref loc="DEU 8:3">Deu 8.3</ref></char></note></para>
  <para style="p">
    <verse number="5" style="v" />Satan nynh Jesu kha ahangnaw lang cciakhae zah sosoh kya laephi peenaw hae balyn kha a muihsah. <verse number="6" style="v" />Satan nynh Jesu kha, “E kawhoinaw balyn te mih phu-enaw hynh kae pya cih; e hynh kamaw kalan pya athua vae keiccuze ka pya rypaw ccungccaw kha ka pya. <verse number="7" style="v" />Kae hynh nae beik lanze hynh-e hae balyn tuh na kya-e athua cih,” a cipya. <verse number="8" style="v" />Jesu nynh,</para>
  <para style="q1">“ ‘Bawipaw na Pachia kha</para>
  <para style="q2">na beik cih zah, amaw kyalya kha</para>
  <para style="q1">rya na lawpah cih,’ cite</para>
  <para style="q2">Ccathyaa kya azeikuh,” a cipya.<note caller="-" style="x"><char style="xo" closed="false">4.8: </char><char style="xt" closed="false"><ref loc="DEU 6:13">Deu 6.13</ref></char></note></para>
  <para style="p">
    <verse number="9" style="v" />Te Satan nynh Jesu kha Jerusalem lang cciakhae zah beikinn adungparyh kya nung zah, “Pachia Ccapaw na thua lanze hein kyate toiku tua. <verse number="10" style="v" />Pawccecize Ccathyaa kyaze,</para>
  <para style="q1">‘Nang kha thungkhaw khylan</para>
  <para style="q2">Pachia nynh a vaaw hae kha</para>
  <para style="q2">a naw cih hae,<note caller="-" style="x"><char style="xo" closed="false">4.10: </char><char style="xt" closed="false"><ref loc="PSA 91:11">Sam 91.11</ref></char></note></para>
  <para style="q1">
    <verse number="11" style="v" />na ccu kha lung kya</para>
  <para style="q2">na thuhku khyh nawlan</para>
  <para style="q1">minmin nynh mih kuih te</para>
  <para style="q2">ae dua cih hae,’ cite</para>
  <para style="q1">azeikuh,” a cipya.<note caller="-" style="x"><char style="xo" closed="false">4.11: </char><char style="xt" closed="false"><ref loc="PSA 91:12">Sam 91.12</ref></char></note></para>
  <para style="m">
    <verse number="12" style="v" />Jesu nynh, “ ‘Bawipaw na Pachia kha la syntawtua nan,’ cite Ccathyaa nynh a ho,” a cipya.<note caller="-" style="x"><char style="xo" closed="false">4.12: </char><char style="xt" closed="false"><ref loc="DEU 6:16">Deu 6.16</ref></char></note> <verse number="13" style="v" />Satan nynh tuhounaw miakaw kha he a thangsah te, ccyhhoy a mue makhia Jesu kha sosoh a cciataw.</para>
  <para style="s1">Galilee kya Jesu Ryalaw Thonaw</para>
  <para style="r">(<ref loc="MAT 4:12-17">Mat 4.12-17</ref>; <ref loc="MRK 1:14-15">Mar 1.14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" />Jesu tuh Muisaw thungnaw te beih zah Galilee lang a ki, tuin ram pepan balyn amaw the tuh po azeihkuh. <verse number="15" style="v" />Jesu nynh sinakok hae kyakhe ccangpah hae zah ccungccaw miakaw nynh a thehoysah hae.</para>
  <para style="s1">Nazareth kya Jesu A Vua hae</para>
  <para style="p">
    <verse number="16" style="v" />Jesu tuh a lethungnaw Nazareth khua thua zah, a cyimae hawte sabbath nin kya sinakok lang a cceih. Ccathyaa ria lan thadyn zah, <verse number="17" style="v" />profeh Isaiah ccakue kha amaw kalan a pya hae. Jesu nynh ccakue kha daw zah a muihpaw Ccathyaa tuh:</para>
  <para style="q1">
    <verse number="18" style="v" />“Bawipaw Muisaw tuh</para>
  <para style="q2">ka tungvaw a um,</para>
  <para style="q1">pawccecize ryachi hae kalan</para>
  <para style="q2">thehoypaw ho khylan kae kha</para>
  <para style="q1">chitui yn thuh vae;</para>
  <para style="q2">ccungccaw hae nynh</para>
  <para style="q1">a kyng hae paw kalan</para>
  <para style="q2">luenaw kong hopya khylan te</para>
  <para style="q1">mitmoh hae kha</para>
  <para style="q2">ngawmuihnaw kong hopya khylan,</para>
  <para style="q1">tuaasahnaw a teing hae paw kha</para>
  <para style="q2">luesah khylan,<note caller="-" style="x"><char style="xo" closed="false">4.18-19: </char><char style="xt" closed="false"><ref loc="ISA 61:1-2">Isa 61.1-2</ref> (LXX)</char></note></para>
  <para style="q1">
    <verse number="19" style="v" />Bawipaw thawccinaw ccyh kha</para>
  <para style="q2">hopya khylan kae hynh</para>
  <para style="q1">yn saw vae,” acikuh.</para>
  <para style="m">
    <verse number="20" style="v" />Jesu nynh ccakue kha kue zah a ccytupaw kha a pya koute a haung. Sinakok kya um hae paw balyn nynh Jesu kha mih mitvoh leite a do hae. <verse number="21" style="v" />Jesu nynh minmin kha, “E Ccathyaa tuh na thae oh hawte atunin accing vae,” a cipya hae. <verse number="22" style="v" />Ccungccaw balyn nynh a thehoy ho hae zah a munglae kyate a poupaw thawccinaw bya kha mih ngaeangthua. Minmin nynh, “E paw hynh Josef ccapaw thua khyh tou?” a ci hae. <verse number="23" style="v" />Jesu nynh minmin kha, “Nanning nynh, ‘Sibawipaw, namaw te namaw kha dansaku tua! Kapernaum khua kya na cyipaw kae thae hawkhate hynh-e namaw khua kya mah cyitua,’ cite e phungtangbya hynh ka kalan nae ho ccaccing cih oh,” a cipya hae. <verse number="24" style="v" />Jesu nynh, “Byaccaccing kae hopya oh, profeh hum sanmah amaw khua kya tuh maehoynaw mue boi khyh.<note caller="-" style="x"><char style="xo" closed="false">4.24: </char><char style="xt" closed="false"><ref loc="JHN 4:44">Joh 4.44</ref></char></note> <verse number="25" style="v" />Thuasalama thanccingte kae hopya oh, Elijah ccyh lya kum thum te sah taruh cia vaawlang thuakaw khaw thua zah loram balyn kya myarya ccakancci lya, Israel ram kya nomae hae patae a um hae.<note caller="-" style="x"><char style="xo" closed="false">4.25: </char><char style="xt" closed="false"><ref loc="1KI 17:1">1Si 17.1</ref></char></note> <verse number="26" style="v" />Thuasalama tuh-e hae lu kheit kalan san Elijah kha saw thua khyh, thuasalama Sidon ram e Zarefath khua kya umpaw nomaenung kalan rou nynh saw athua.<note caller="-" style="x"><char style="xo" closed="false">4.26: </char><char style="xt" closed="false"><ref loc="1KI 17:8-16">1Si 17.8-16</ref></char></note> <verse number="27" style="v" />Profeh Elisha ccyh lya Israel ram kya vaethyakaepaw patae a um hae, thuasalama Siria paw Naaman laelan hum sanmah thyaasah thua khyh,” a ci.<note caller="-" style="x"><char style="xo" closed="false">4.27: </char><char style="xt" closed="false"><ref loc="2KI 5:1-14">2Si 5.1-14</ref></char></note></para>
  <para style="p">
    <verse number="28" style="v" />Sinakok kya a um hae paw balyn nynh hynh-e bya hae kha he a thae hae tuh myarya mih thinria. <verse number="29" style="v" />Thokuh hae zah Jesu kha khua atolang dee hae zah tuh-e mih khua a umnaw mua adung, chia kalan khe dae tu lan cite a cciakhae hae. <verse number="30" style="v" />Thuasalama Jesu tuh mih laku kyate zya pou zah po a cceih.</para>
  <para style="s1">Ccungccaw Patae A Dansah</para>
  <para style="r">(<ref loc="MRK 1:21-28">Mar 1.21-28</ref>)</para>
  <para style="p">
    <verse number="31" style="v" />Galilee ram e Kapernaum khua lang cceihbung zah sabbath nin kya a ccangpya hae. <verse number="32" style="v" />Kawhoinaw te bya a ho keiccuze ccungccaw hae tuh a ccangpyanaw kha mih ngaeangthua.<note caller="-" style="x"><char style="xo" closed="false">4.32: </char><char style="xt" closed="false"><ref loc="MAT 7:28-29">Mat 7.28-29</ref></char></note> <verse number="33" style="v" />Sinakok kyakhe athyaa leipaw raerangsaro muisaw a bahkuhpaw lu kheit a um. Aning nynh, <verse number="34" style="v" />“Kae makhaete kae um sah! Nazareth paw Jesu, nang te kaening pawmou ah sekuh oh? Nang tuh kaening ro khylan tou nae thua? Nang tuh hum nynh na thua cipaw ka ny, Pachia kya-e Athyaapaw nynh na thua!” cite thawte a sia. <verse number="35" style="v" />Jesu nynh pe zah, “Yccae nan, khah-e paw lungkhu kyate pou!” a cipya. Raerangsaro nynh tuh-e paw tuh ccungccaw hae malang khe khuliasakuh zah maw muihsah leite a poutaw. <verse number="36" style="v" />Ccungccaw hae balyn tuh mih ngaeangthua zah, “E bya hynh pawtecihpaw bya mou! Pawccecize kawhoinaw te thungnaw khate athyaa leipaw muisaw hae kha kawpya zah minmin tuh a pou hae!” cite a hoku hae. <verse number="37" style="v" />Jesu kong tuh tuin ram pepan e khua takyh kya pong azeihkuh.</para>
  <para style="s1">Ccungccaw Patae A Dan hae</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mat 8.14-17</ref>; <ref loc="MRK 1:29-34">Mar 1.29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" />Jesu tuh sinakok kyate a pou koute Simon inn lang a tee. Simon a zu nung tuh myarya a nge so zah a cci keiccuze minmin nynh a hanlan Jesu kha a ngiapya hae. <verse number="39" style="v" />Jesu nynh tuh-e nung pe khe thadyn zah tuh-e ccinaw tuh a dan nawlan kaw he a pya tuh phe a dan. Tuh-e nung nynh vaekheihmawte thokuh zah minmin kha rya a lawpya hae.</para>
  <para style="p">
    <verse number="40" style="v" />Khuanin he ccah tuh ccinaw aphuinphuin te a ccih hae paw ngeccih hae balyn kha Jesu kalan oun cciakhae hae, Jesu nynh ngeccih miakaw tungvaw khe a kuih khang zah a dansah hae. <verse number="41" style="v" />Raerangsaro hae nynh mah, “Nang tuh Pachia Ccapaw nynh na thua!” cite sia hae zah ccungccaw patae kyate a pou hae. Jesu nynh minmin kha pe hae zah byahonaw kaw-ua khyh hae, pawccecize minmin nynh aning tuh Messiah nynh thua cipaw a ny hae.</para>
  <para style="s1">Sinakok kya Phung A Ho</para>
  <para style="r">(<ref loc="MRK 1:35-39">Mar 1.35-39</ref>)</para>
  <para style="p">
    <verse number="42" style="v" />Khua he yn dae tuh, Jesu tuh pou zah ramkaw langkhe a cceih. Ccungccaw hae nynh amaw kha ccung hae zah a kya he a thua hae te, minmin kyate a ccia khyh nawlan a kang hae. <verse number="43" style="v" />Jesu nynh minmin kha, “Pachia peenaw thehoypaw kha ccangpaw khua hae kalan mah ka ho hahe cih, pawccecize hynh-e khylan nynh kae hynh Pachia nynh yn saw,” a cipya hae. <verse number="44" style="v" />Tukeiccuze Judea ram e sinakok hae kyakhe phung a ho.</para>
  <chapter number="5" style="c" />
  <para style="s1">Masaty Jesu Zuitu hae Konaw</para>
  <para style="r">(<ref loc="MAT 4:18-22">Mat 4.18-22</ref>; <ref loc="MRK 1:16-20">Mar 1.16-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Nin kheit tuh Genesaret tuili kin kya Jesu a thadyn lyakhe ccungccaw hae nynh Pachia bya ngae khylan amaw kha a lungnuaku hae.<note caller="-" style="x"><char style="xo" closed="false">5.1-3: </char><char style="xt" closed="false"><ref loc="MAT 13:1-2">Mat 13.1-2</ref>; <ref loc="MRK 3:9-10">Mar 3.9-10</ref>, <ref loc="MRK 4:1">4.1</ref></char></note> <verse number="2" style="v" />Tuili kin varang langkhe kohlung ccangning kha a muih; ngasaw kyngtu hae tuh kohlung kyate pou hae zah mih mia hae kha a singkuh hae. <verse number="3" style="v" />Jesu tuh kohlung ccangning lakuze Simon kya-e kohlung kalan khe tee zah varang langte takyh nuesaku lan Simon kha a ngia. Te tuh-e kohlung kya haung zah ccungccaw hae kha a ccangpya hae. <verse number="4" style="v" />Bya a ho koute, Simon kha, “Tui akhunaw lang nue lah, ngasaw kyng khylan nae mia hae kha vuatua oh,” a cipya. <verse number="5" style="v" />Simon nynh, “Bawipaw, khuazi zidae kae vua zah ccangkheit san kae kyng khyh; thuasalama na bya thyhte mia ka vua cih,” a cipya.<note caller="-" style="x"><char style="xo" closed="false">5.5: </char><char style="xt" closed="false"><ref loc="JHN 21:3">Joh 21.3</ref></char></note> <verse number="6" style="v" />Minmin nynh tuhte mia kha he a vua hae tuh myarya alungpaw ngasaw hae kha bong hae zah mih mia tuh vyavya a pae vae.<note caller="-" style="x"><char style="xo" closed="false">5.6: </char><char style="xt" closed="false"><ref loc="JHN 21:6">Joh 21.6</ref></char></note> <verse number="7" style="v" />Minmin nynh ccangpaw kohlung kya um hae paw mia a vuakheih hae paw kha oun ccianua hae sah lah oun bawm hae sah cite mih kuih te a ko hae. Tuh-e hae tuh oun thua hae zah kohlung ccangning te tui kaw lang vyavya ccah lan ngasaw kha phe a bia hae. <verse number="8" style="v" />Simon Peter nynh tuh-e tuh he a muih te, Jesu ccukharu kyakhe bakhung zah, “Bawipaw, kae tuh misei nynh ka thua, beih yn cciataw!” a cipya. <verse number="9" style="v" />Pawccecize Simon te a umkheih hae paw balyn tuh a kyng hae paw ngasaw hae keiccuze mih ngaeangthua. <verse number="10" style="v" />Simon ryte a mungkuh hae paw Zebedi ccapaw hae James te Johan mah mih ngaeangthua. Jesu nynh Simon kha, “Rih nan, atu tetuh ccungccaw a kyngpaw lang na tang vae cih,” a cipya. <verse number="11" style="v" />Mih kohlung hae kha varang lang nung hae zah, pawpaw balyn kha cciatawte Jesu kha a zui hae.</para>
  <para style="s1">Vaethyakaepaw A Dansah</para>
  <para style="r">(<ref loc="MAT 8:1-4">Mat 8.1-4</ref>; <ref loc="MRK 1:40-45">Mar 1.40-45</ref>)</para>
  <para style="p">
    <verse number="12" style="v" />Vaekheihlya Jesu tuh khua khuakheit kya a um lyakhe vaethya ccinaw te phe a beihpaw lu kheit nynh Jesu kha he a muih tuh laekhu kya bakhung zah, “Bawipaw, na ry lan thua ze, kae hynh nae thyaasah kho,” cite a ngiaku. <verse number="13" style="v" />Jesu nynh a kuih dyng zah tuh-e paw tuh hae zah, “Ka ry, thyaa ccavae,” a cipya. Vaekheihmawte a vaethya ccinaw tuh athyaa vae. <verse number="14" style="v" />Jesu nynh, “E kong hynh hum ccungccaw san la hopah nan, thuasalama la cceih lah ranpibawi kha la muihsakuh; na thyaa vae keiccuze mih malang khe ccaekia lang Moses kawbya thyhawte silawkunaw kha la rae,” cite bya a tawsya.<note caller="-" style="x"><char style="xo" closed="false">5.14: </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">Lev 14.1-32</ref></char></note> <verse number="15" style="v" />Jesu the tuh houhouh thaan zah ccungccaw zapi nynh a bya thae khylan te mih ccinaw kyate dan khylan oun sueluakuh hae. <verse number="16" style="v" />Jesu tuh ramkaw langkhe cceih zah saw leih a sang.</para>
  <para style="s1">Kuihccu Chihpaw A Dansah</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mat 9.1-8</ref>; <ref loc="MRK 2:1-12">Mar 2.1-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" />Nin kheit tuh Jesu nynh a ccangpya lya hae khe Jerusalem te Judea pee te Galilee pee e khua hae balyn kyate oun thua hae paw Farasi hae te kawbya sazae hae tuh a haungbua hae; ngeccih dansah nawlan Bawipaw huhan tuh Jesu kya a um. <verse number="18" style="v" />Abang ccungccaw hae nynh a kuihccu chihpaw kha inawpaw te oun puih hae zah Jesu malang nung khylan teekhae lan a zuaku hae. <verse number="19" style="v" />Ccungccaw zapi keiccuze teekhaenaw laanpi muih khyh hae, tukeiccuze innccukaly lang kaekhae hae zah innccukaly kha kia hae zah ngeccih kha inawpaw ryte ccungccaw hae laku lang Jesu malang khe a sawbung hae. <verse number="20" style="v" />Jesu nynh mih zynnaw kha he a muih tuh, ngeccihpaw kha, “Ka ban, na seinaw tuh ngaethya athua vae,” a cipya. <verse number="21" style="v" />Kawbya sazae hae te Farasi hae nynh, “Pachia saryapaw bya a hopaw e paw tuh hummou? Pachia lu kheit laelan hummou seinaw a ngaethya kho?” cite a hoku hae. <verse number="22" style="v" />Jesu nynh mih tuanaw kha nyh zah minmin kyakhe, “Nae thinlung kya pawccemou tuhte na tua oh? <verse number="23" style="v" />‘Na seinaw tuh ngaethya athua vae,’ cipya tou azoihua, tuhkhyhze, ‘Thokuh lah cceih,’ cipya tou azoihua? <verse number="24" style="v" />Thuasalama Ccungccaw Ccapaw tuh laephi vawlan seinaw ngaethya lan kaw a hoi cipaw na ny nawlan oh,” cipah hae zah, kuihccu chihpaw kha, “Nang kae hopya, thokuh lah na iphae kha lawkuh lah na inn lang cceih ccavae,” a cipya. <verse number="25" style="v" />Tuh-e paw tuh mih malang khe vaekheihmawte thokuh zah a inawpaw kha lawkuh zah Pachia kha phu-esah te a inn lang a cceih. <verse number="26" style="v" />Ccungccaw hae balyn tuh mih ngaeangthua zah rinaw te phe beih hae zah, “Atunin ngaeang lan umpaw uccaw kha ah muih vae oh,” ci hae zah Pachia kha a phu-esah hae.</para>
  <para style="s1">Jesu nynh Levi A Ko</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mat 9.9-13</ref>; <ref loc="MRK 2:13-17">Mar 2.13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" />Tukoute Jesu tuh cceih zah ngunto khoinaw kya a haungpaw, ngunto khoitupaw Levi a ci hae paw kha a muih; Jesu nynh, “Kamaw yn zui,” a cipya. <verse number="28" style="v" />Aning nynh thokuh zah pawpaw balyn kha cciatawte Jesu kha a zui.</para>
  <para style="p">
    <verse number="29" style="v" />Levi nynh a inn kya Jesu elang poi pi a tuapya; tuin kya ngunto khoitu hae patae te mingccang hae um hae zah, Jesu te zuitu hae ryte aepaw a koihkheih hae. <verse number="30" style="v" />Kawbya sazae hae te Farasi hae nynh a zuitu hae kha, “Pawccemou ngunto khoitu hae te misei hae ryte na aekheih oh zah na niakheih oh?” cite a seisah hae.<note caller="-" style="x"><char style="xo" closed="false">5.30: </char><char style="xt" closed="false"><ref loc="LUK 15:1-2">Luk 15.1-2</ref></char></note> <verse number="31" style="v" />Jesu nynh, “A dan hae paw nynh sibawi peki khyh hae; a ccih hae paw nynh a peki hae. <verse number="32" style="v" />Kae tuh miding hae ko khylan kae thua khyh, misei hae nynh a ngaesiku ccaw hae cite nynh kae thua,” a cipya hae.</para>
  <para style="s1">Loohsungnaw Kong Byakhianaw</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mat 9.14-17</ref>; <ref loc="MRK 2:18-22">Mar 2.18-22</ref>)</para>
  <para style="p">
    <verse number="33" style="v" />Minmin nynh Jesu kha, “Johan zuitu hae te Farasi hae zuitu hae tuh atu te atu looh-ae sung hae zah saw leih a sang hae, thuasalama nang na zuitu hae tuh pawccemou a ae a nia hae?” cite a khia hae. <verse number="34" style="v" />Jesu nynh, “Zudy ccangvaepaw tuh zudy poi oun too hae paw kya a umbua lungkhu tuh tuh-e hae tuh looh-ae a sung cih hae zawtou? <verse number="35" style="v" />Thuasalama zudy ccangvaepaw kha minmin kyate lawpya ccyh yn thua cih, tuin ccyh vae tuh looh-ae oun sung vae cih hae,” a cipya hae. <verse number="36" style="v" />Minmin kha tousenaw phungpaw ccangkheit a hopya hae: “Hum nynh sanmah uccaw athawpaw kha awnua zah uccaw arynpaw kha bianah boi khyh, tuhte a bia lanze uccaw athawpaw tuh aseiikuh cih, bianawpaw athawpaw tuh uccaw arynpaw te ccawkuhthya khyh. <verse number="37" style="v" />Hum nynh sanmah misutui athawpaw kha arynpaw misutui-saphuabawng kya ruin boi khyh, tuhte a ruin lanze misutui athawpaw nynh misutui-saphuabawng kha phae pawsah cih zah misutui pong azu cih, te misutui-saphuabawng mah aroh cih. <verse number="38" style="v" />Misutui athawpaw tuh athawpaw misutui-saphuabawng kalan ruin lanpaw nynh thua, te nynh parouhte akhyn hae. <verse number="39" style="v" />Hum nynh sanmah arynpaw misutui kha a neih koute athawpaw misutui kha neih ry vae khyh, pawccecize, ‘Arynpaw misutui tuh athuahua,’ a ci,” cite a hopya hae.</para>
  <chapter number="6" style="c" />
  <para style="s1">Sabbath Kong Byakhianaw</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mat 12.1-8</ref>; <ref loc="MRK 2:23-28">Mar 2.23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Sabbath nin kya Jesu tuh loo kya po cceih zah, a zuitu hae nynh looh avui kha zukuh hae zah mih kuih te noi hae zah a ae hae.<note caller="-" style="x"><char style="xo" closed="false">6.1: </char><char style="xt" closed="false"><ref loc="DEU 23:25">Deu 23.25</ref></char></note> <verse number="2" style="v" />Farasi hae abang nynh minmin kha, “Sabbath nin kya kawbya nynh cyi lan a ua leipaw kha pawccemou na cyi oh?” a cipya hae. <verse number="3" style="v" />Jesu nynh, “David nynh a vuelaw lya amaw te a umkheih hae paw ryte a cyi hae paw kha na ria boi khyh oh tou?<note caller="-" style="x"><char style="xo" closed="false">6.3-4: </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1Sa 21.1-6</ref></char></note> <verse number="4" style="v" />Pachia inn lungkhu lang tee zah kawbya nynh ranpibawi laelan humhung mah ae lan a ua leipaw Nungpyapaw sanlou kha ae zah amaw ryte a umkheih hae paw kha mah a pyabua hae,” cite a khung hae.<note caller="-" style="x"><char style="xo" closed="false">6.4: </char><char style="xt" closed="false"><ref loc="LEV 24:9">Lev 24.9</ref></char></note> <verse number="5" style="v" />Jesu nynh minmin kha, “Ccungccaw Ccapaw tuh sabbath Bawipaw nynh thua,” a cipya hae.</para>
  <para style="s1">Sabbath Nin kya A Dansah hae</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mat 12.9-14</ref>; <ref loc="MRK 3:1-6">Mar 3.1-6</ref>)</para>
  <para style="p">
    <verse number="6" style="v" />Ccangpaw sabbath nin kya Jesu tuh sinakok lungkhu lang tee zah a ccangpya hae, tuin kya a ranglang kuih achihpaw lu kheit a um. <verse number="7" style="v" />Kawbya sazae hae te Farasi hae nynh Jesu tungvaw seibenaw ccungpya khylan sabbath nin kya ccinaw yn dansah ta, cite a dokhaw hae. <verse number="8" style="v" />Thuasalama Jesu nynh mih tuanaw kha nyh zah a kuih achihpaw ccungccapaw kha, “Yn cceih lah hein kya thadyn,” a cipya. Aning tuh thokuh zah tuin kya a thadyn. <verse number="9" style="v" />Jesu nynh minmin kha, “Bya kae khiatua oh sah: Sabbath nin kya ahoypaw cyi lan kawbya nynh a ua tou? Tuhkhyhze ahoy leipaw cyi lan tou a ua? Hiinnaw kha so khum lan a ua tou? Tuhkhyhze chia lan tou a ua?” cite a khia hae. <verse number="10" style="v" />Minmin balyn kha pong do hae zah, Jesu nynh tuh-e paw tuh, “Na kuih kha dyngtua,” a cipya. Aning nynh a kuih kha dyng zah voikheit lang hawte phe ahoy vae. <verse number="11" style="v" />Minmin tuh myarya mih thinria zah Jesu kha pawtemou cyi lan cipaw a hoku hae.</para>
  <para style="s1">Lu Haw lae Ning A Po hae</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mat 10.1-4</ref>; <ref loc="MRK 3:13-19">Mar 3.13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" />Tuh ccyh lyakhe Jesu tuh sawsang lan mua lang cceih zah Pachia kalan zidae saw a sang. <verse number="13" style="v" />Khua adae te a zuitu hae kha ko hae zah, lu haw lae ning kha a po hae, minmin kha locceihtu hae cite min a phu hae. <verse number="14" style="v" />Tuh-e hae tuh: Peter cite min a phupaw Simon te a neitaw Andru, James te Johan, Filip te Bartholomew, <verse number="15" style="v" />Matthai te Thomas, Alfeas ccapaw James te Zealot a ci hae paw Simon, <verse number="16" style="v" />James ccapaw Judas te Bawipaw a pheetupaw Judas Iskariot nynh thua hae.</para>
  <para style="s1">Jesu nynh A Ccangpya hae</para>
  <para style="r">(<ref loc="MAT 4:23-25">Mat 4.23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" />Jesu tuh minmin ryte mua kyate rungbung hae zah bialae khe a thadyn; amaw te a zui hae paw patae, Judea pee balyn kyate, Jerusalem kyate, rili kin umpaw Tair khua te Sidon khua kyate ccungccaw patae tuh tuin kya oun thua hae. <verse number="18" style="v" />Minmin tuh Jesu bya ngae khylan te mih ccinaw dan khylan oun cceih hae; athyaa leipaw muisaw hae nynh vawsaw a pya hae paw kha a dansah hae. <verse number="19" style="v" />Ccungccaw zapi balyn nynh Jesu kha hae lan a zuaku hae, pawccecize amaw kyate huhan pou zah ccungccaw balyn tuh a dan hae.</para>
  <para style="s1">Lungtua hae paw</para>
  <para style="r">(<ref loc="MAT 5:1-12">Mat 5.1-12</ref>)</para>
  <para style="p">
    <verse number="20" style="v" />Jesu nynh a zuitu hae kha do hae zah:</para>
  <para style="q2">“Ryachi hae paw nanning tuh</para>
  <para style="q1">lungtuapaw nynh na thua oh,</para>
  <para style="q2">pawccecize Pachia peenaw tuh</para>
  <para style="q2">nae kya-e nynh thua.</para>
  <para style="q1">
    <verse number="21" style="v" />Atu lya vuelaw hae paw nanning tuh</para>
  <para style="q2">lungtuapaw nynh na thua oh,</para>
  <para style="q1">pawccecize nae vue aso cih.</para>
  <para style="q2">Atu a rah hae paw nanning tuh</para>
  <para style="q1">lungtuapaw nynh na thua oh,</para>
  <para style="q2">pawccecize nae nuin cih oh.</para>
  <para style="p">
    <verse number="22" style="v" />“Ccungccaw Ccapaw keiccuze ccungccaw hae nynh ae hua oh ze thuasah, mih kyate ae phia oh ze thuasah, sarisarya ae nung oh ze thuasah, nae the ae thyasah vae oh ze thuasah nanning tuh lungtuapaw nynh na thua oh.<note caller="-" style="x"><char style="xo" closed="false">6.22: </char><char style="xt" closed="false"><ref loc="1PE 4:14">1Pe 4.14</ref></char></note> <verse number="23" style="v" />Tuin nin kya nae lungtua sah lah lungpawte thohkuh oh! Pawccecize vaawlang khua kya nae ryalaw mee tuh ale ccaccing; pawccecize mih minpaaw hae nynh mah profeh hae kha tuh-e hawte nynh a la cyi hae.<note caller="-" style="x"><char style="xo" closed="false">6.23: </char><char style="xt" closed="false"><ref loc="2CH 36:16">2Sh 36.16</ref>; <ref loc="ACT 7:52">Loc 7.52</ref></char></note></para>
  <para style="q1">
    <verse number="24" style="v" />“Thuasalama mihoi hae,</para>
  <para style="q2">nanning hanlan ngaethya lan kou um!</para>
  <para style="q1">Pawccecize nanning tuh</para>
  <para style="q2">naemaw kya-e hiin hoynaw kha</para>
  <para style="q1">phe na mue vae oh.</para>
  <para style="q1">
    <verse number="25" style="v" />Atu lya vueso hae paw nanning,</para>
  <para style="q2">nae hanlan ngaethya lan kou um!</para>
  <para style="q1">Pawccecize nae vuelaw cih.</para>
  <para style="q2">Atu lya a nuin hae paw nanning,</para>
  <para style="q1">nae hanlan ngaethya lan kou um!</para>
  <para style="q2">Pawccecize nae rah nae khui cih oh.</para>
  <para style="p">
    <verse number="26" style="v" />“Ccungccaw hae balyn nynh thehoy ae ho vae oh ze, nae hanlan ngaethya lan kou um! Pawccecize mih minpaaw hae nynh lingthya profeh hae kha tuhcite nynh a la cyi hae.</para>
  <para style="s1">Rhaw hae Sungsahnaw te Liarunaw</para>
  <para style="r">(<ref loc="MAT 5:38-48">Mat 5.38-48</ref>, <ref loc="MAT 7:12a">7.12a</ref>)</para>
  <para style="p">
    <verse number="27" style="v" />“Thuasalama ka bya a thae hae paw kae hopya oh, nae rhaw hae kha sungsah oh, nanning ae hua oh paw tungvaw kya hoynaw la rae oh. <verse number="28" style="v" />Nanning thya ae law oh paw kha hythuanaw la pya oh, nanning ae sarya oh paw kha saw la sangpah oh. <verse number="29" style="v" />Lukhakheit nynh na byaki ae bia ze, voihawlang kha mah la tuapakuh; lukhakheit nynh na angkile ae lawpyaku ze na angki kha mah la kang nan. <verse number="30" style="v" />Nang ae ngiakuhpaw ccungccaw miakaw kha la pya; lukhakheit nynh na uccaw ae lawpyaku ze, la ngiathui nan vae. <verse number="31" style="v" />Nae tungvaw kya cyih hae sah cite na ry oh hawte ming hae tungvaw kya la cyih oh.<note caller="-" style="x"><char style="xo" closed="false">6.31: </char><char style="xt" closed="false"><ref loc="MAT 7:12">Mat 7.12</ref></char></note></para>
  <para style="p">
    <verse number="32" style="v" />“Ae sungsah oh paw kyalya kha na sungsahru oh ze, pawtemou thanenaw tuh na mue cih oh? Misei hae nynh heize mimaw a sungsah hae paw kha a sungsahru hae khaw. <verse number="33" style="v" />Nae tungvaw hoynaw a rae hae paw tungvaw kyalya hoynaw na raeru oh ze, pawtemou thanenaw tuh na mue cih oh? Misei hae nynh heize tuh-e hawte a cyi hae khaw. <verse number="34" style="v" />Bua yn pyaru cih cite na ngaehoi oh paw ccungccaw hae kyalya kha na koiisaku oh ze, pawtemou thanenaw tuh na mue cih oh? Misei hae nynh heize patae bua mueru lan cite misei hae kha a koiisaku hae khaw. <verse number="35" style="v" />Nae rhaw hae kha sungsah oh lah, hoynaw raepah oh, pawpaw sanmah ngaehoi leite koiisakuh oh; te nae ryalaw mee tuh myarya ale cih zah Ahang Huaccepaw Pachia ccaaw hae na thua cih oh. Pawccecize Pachia tuh lungtuabya ho lan a nyhthya leipaw te ccungccaw hoylei hae tungvaw kya thawccinaw a hoipaw nynh thua. <verse number="36" style="v" />Tukeiccuze nae Paaw nynh ngaethyaumsahnaw a hoi hawte nanning mah ngaethyaumsahnaw hoi oh.</para>
  <para style="s1">Ming hae Byapianaw</para>
  <para style="r">(<ref loc="MAT 7:1-5">Mat 7.1-5</ref>)</para>
  <para style="p">
    <verse number="37" style="v" />“Ming hae kha byapia nan oh lah, naemaw kha byapia na thua lan khyh oh; ming hae kha seibe nan oh lah, naemaw kha seibe na thua lan khyh oh; ming hae seinaw kha ngaethya oh lah nae seinaw kha ngaethya athuaru cih. <verse number="38" style="v" />Ming hae kha pyabua oh lah, naemaw kha pyaru na thua cih oh; dydepyate, ryhpya biate, paepae leikuh lan nae by phe thua lan ae pyaru cih oh. Pawccecize na tounaw oh paw tounawpaw te naemaw kha toupya ru na thua cih oh,” a cipya hae.</para>
  <para style="p">
    <verse number="39" style="v" />Jesu nynh tousenaw phungpaw kha mah a hopya hae: “Mitmohpaw nynh mitmohpaw kha a cciakhae kho cih tou? Parouh mawte hunghua lungkhu lang ccah lan khyh hae tou?<note caller="-" style="x"><char style="xo" closed="false">6.39: </char><char style="xt" closed="false"><ref loc="MAT 15:14">Mat 15.14</ref></char></note> <verse number="40" style="v" />Siaimua tuh a sazae laeze thyahua khyh, thuasalama phe ccing lan ccangpya athuapaw siaimua miakaw tuh a sazae hawte athua cih.<note caller="-" style="x"><char style="xo" closed="false">6.40: </char><char style="xt" closed="false"><ref loc="MAT 10:24-25">Mat 10.24-25</ref>; <ref loc="JHN 13:16">Joh 13.16</ref>, <ref loc="JHN 15:20">15.20</ref></char></note> <verse number="41" style="v" />Namaw mit lungkhu umpaw thingthyh kha tuaku leite pawccemou na uno mit lungkhu umpaw athupaw taraw kha na dopya? <verse number="42" style="v" />Na mit kya umpaw thingthyh kha muihku leite, pawccemou na unopaw kha, ‘Ka ban, na mit lungkhu e athupaw taraw kha kae la khoipah,’ cite na hopya ngan? Pou thyaruhpaw, namaw mit lungkhu e thingthyh kha khoikuh ty lah te na unopaw mit lungkhu e athupaw taraw kha khoipya khylan ccaerarih lan na muihthya cih.</para>
  <para style="s1">Thingku te Athae</para>
  <para style="r">(<ref loc="MAT 7:16-20">Mat 7.16-20</ref>, <ref loc="MAT 12:33-35">12.33-35</ref>)</para>
  <para style="p">
    <verse number="43" style="v" />“Thingku hoypaw nynh thingthae hoyleipaw kha thae boi khyh, thingku hoyleipaw nynh mah thingthae hoypaw kha thae boi khyh. <verse number="44" style="v" />Thingku miakaw tuh athae te ny kho athua. Hinpaw ku kyate thaeku thae kha lo boi khyh hae, taty ku kyate mah misu thae kha lo boi khyh hae.<note caller="-" style="x"><char style="xo" closed="false">6.44: </char><char style="xt" closed="false"><ref loc="MAT 12:33">Mat 12.33</ref></char></note> <verse number="45" style="v" />Ccungccaw hoypaw nynh a thinlung kya umpaw sisua bawng kya-e ahoypaw kha a pousah, ccungccaw hoyleipaw nynh a thinlung kya umpaw ahoy leipaw sisua bawng kya-e ahoy leipaw kha a pousah; pawccecize thinlung kya phe abeihpaw kha mung nynh a ho.<note caller="-" style="x"><char style="xo" closed="false">6.45: </char><char style="xt" closed="false"><ref loc="MAT 12:34">Mat 12.34</ref></char></note></para>
  <para style="s1">Inn Saktu A Hawpaw te A Ngaeepaw</para>
  <para style="r">(<ref loc="MAT 7:24-27">Mat 7.24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" />“Ka hopaw kha na cyih lei oh pite, pawccemou ‘Bawipaw, Bawipaw,’ cite nae ko oh? <verse number="47" style="v" />Humhung zemah ka kalan yn cceih zah ka bya kha thae zah a cyihpaw tuh hum te mou aloku cipaw kae muihsah cih oh: <verse number="48" style="v" />Aning tuh phe khutheih lan tungkhu ccou zah lung vawlan tung bing zah inn a sakpaw te nynh aloku; tuileih tho zah tui nynh tuh-e inn tuh thawte asoh zemah hy khyh, pawccecize lung vawlan abingku keiccu nynh thua. <verse number="49" style="v" />Thuasalama ka bya kha thae zah a zui leipaw tuh tung bing leite laephi vawlan inn sakpaw hawte nynh aloku; tuh-e tuh tui nynh thawte he asoh tuh vaekheihmawte phe apu, te tuh-e inn tuh khaleih aroh,” a ci.</para>
  <chapter number="7" style="c" />
  <para style="s1">Rhawbawipaw Zynnaw</para>
  <para style="r">(<ref loc="MAT 8:5-13">Mat 8.5-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Jesu nynh ccungccaw hae thaenaw kya bya a hopaw balyn kha he a thangsah koute Kapernaum khua lungkhu lang a tee. <verse number="2" style="v" />Tuin khua kya-e rhawbawipaw a seepaw tuh ccih zah vyavya a chih, aning tuh a bawipaw nynh kou a sungsahpaw nynh thua. <verse number="3" style="v" />Rhawbawipaw nynh Jesu kong kha he a thae te, a seepaw kha ccianuate a dansah nawlan ngia khylan Judah piccan hae kha amaw kalan a saw hae. <verse number="4" style="v" />Minmin nynh Jesu kalan he thua hae te, “Aning tuh bawm lan accanpaw nynh thua. <verse number="5" style="v" />Pawccecize aning tuh kae minphuin hynh sungsah zah kaening elang sinakok oun sakpahpaw nynh thua,” cite Jesu kha thawte a ngia hae. <verse number="6" style="v" />Jesu tuh minmin ryte a cceihbua. Inn kyate asaw leinaw kya he a thua tuh rhawbawipaw nynh a ban hae kha Jesu kalan saw hae zah, “Bawipaw, vawsaw pyakuh nan; pawccecize nang nynh ka inn lang tee lante kae tuh ka ngaekuh khyh; <verse number="7" style="v" />tuhawte kamaw mah na kalan ccia lan ka ngaekuh cite ka tuakuh khyh, bya te kyalya kawpya lah ka ryalahtupaw tuh a dan cih. <verse number="8" style="v" />Pawccecize kae mah kawhoinaw zakaw a umpaw nynh ka thua, ka kuihkaw rhawkaw hae ka hoi zah lu kheit kha, ‘Cceih,’ ka ci ze a cceih; ccangpaw lu kheit kha, ‘Rang,’ ka ci ze yn thua; ka see kha, ‘E hynh cyih,’ ka ci ze a cyih,” cite a hosahpya hae. <verse number="9" style="v" />Tuh-e bya tuh Jesu nynh he a thae te, a ngaeangthua zah nulang maeleihkuh zah amaw a zui hae paw ccungccaw hae kha, “Nanning kae hopya oh, hynhcihawpaw zynnaw hynh Israel hae kya heize ka muih boi khyh,” a cipya hae. <verse number="10" style="v" />Rhawbawipaw nynh yn saw hae paw tuh inn lang ki hae zah a seepaw tuh a dan vae paw kha a muih hae.</para>
  <para style="s1">Nomaenung Ccapaw A Thoosah</para>
  <para style="p">
    <verse number="11" style="v" />Tukoute aro mawze Jesu tuh Nain a ci hae paw khua lang cceih zah a zuitu hae te ccungccaw patae nynh a zui hae. <verse number="12" style="v" />Jesu tuh khua koikua pe he a thua tuh, achihpaw lu kheit kha oun puih hae. Tuh-e michi tuh nomaenung ccapaw, lu kheit kyalyapaw nynh thua; khuaccaaw hae patae tuh nomaenung ryte oun cceih hae. <verse number="13" style="v" />Bawipaw nynh tuh-e nomaenung kha he a muih tuh ngaethyaumsah zah, “Rah nan,” a cipya. <verse number="14" style="v" />Jesu nynh ccianua zah taang kha hae zah a puih hae paw tuh a thadyn hae. Jesu nynh, “Ccangvaepaw, kae hopya, thokuh!” a ci. <verse number="15" style="v" />Achihpaw ccungccapaw tuh haung zah bya yn ho vae. Jesu nynh tuh-e paw tuh a nung kalan a pya. <verse number="16" style="v" />Mih balynte mih rikawthua zah Pachia kha the a hoysah hae. Abang nynh, “Aening laku alesaepaw profeh nynh yn langkuh vae! Pachia nynh a ccungccaw hae kha a bawm vae hae!” a ci hae. <verse number="17" style="v" />Jesu the tuh Judea ram te a pepan e ram hae balyn kya po azeihkuh.</para>
  <para style="s">Johan nynh Jesu A Khiasah hae</para>
  <para style="r">(<ref loc="MAT 11:2-19">Mat 11.2-19</ref>)</para>
  <para style="p">
    <verse number="18" style="v" />Tuh-e konglang balyn tuh Johan zuitu hae nynh Johan kha a hopya hae. Tukeiccuze Johan nynh a zuitu hae lu ning kha ko hae zah <verse number="19" style="v" />Jesu kalan saw hae zah, “Nang hynh yn thua cih paw tuh na thua tou? Tuhkhyhze mingccangpaw tou kae ngaw ung cih?” cite a khiasah hae. <verse number="20" style="v" />Tuh-e ccungccaw hae nynh Jesu kalan he a thua hae te, “Baptisma pyatu Johan nynh kaening hynh na kalan oun saw zah, ‘Nang hynh yn thua cih paw tuh na thua tou? Tuhkhyhze mingccangpaw tou kae la ngaw ung cih,’ cite bya oun khiasah,” a cipya hae. <verse number="21" style="v" />Tuh ccyh lyakhe Jesu nynh ccungccaw patae kha mih ccinaw aphuinphuin kyate thuasah, ahoy leipaw muisaw hae kyate thuasah dansah hae zah, mitmoh hae patae kha ngaw a muihsah hae. <verse number="22" style="v" />Jesu nynh minmin kha, “La cceih oh lah na muih oh paw te na thae oh paw kha Johan la hopah oh: Mitmoh hae nynh ngawmuih hae zah ccukhou hae nynh a cceih kho vae hae, vaethyakae hae paw a dan hae, nawpan hae nynh nawthae hae zah michi hae tuh thoosah athua hae, ryachi hae kalan thehoypaw tuh hopya athua.<note caller="-" style="x"><char style="xo" closed="false">7.22: </char><char style="xt" closed="false"><ref loc="ISA 35:5-6">Isa 35.5-6</ref>, <ref loc="ISA 61:1">61.1</ref></char></note> <verse number="23" style="v" />Kae ka keiccuze a lungroh leipaw ccungccaw tuh lungtuapaw nynh thua,” a cipya hae.</para>
  <para style="p">
    <verse number="24" style="v" />Johan nynh a saw hae paw he a cceih hae te, Jesu nynh Johan konglang kha ccungccaw zapi kya hynhte a ho: “Nanning nynh paw do khylan mou ramkaw langkhe na ccia oh? Khisan nynh a hepaw phaeku do khylan tou? <verse number="25" style="v" />Tuhkhyhze paw do khylan mou na ccia oh? Nebaleihpaw boeining a lawkuhpaw ccungccapaw do khylan tou? Dotua oh, lyccaccu lan uccaw lawkuh hae zah hiinhoyte um hae paw tuh siapharan inn kya nynh a um hae. <verse number="26" style="v" />Paw do khylan mou na ccia oh? Profeh lu kheit do khylan tou? Athua, kae hopya oh, profeh lu kheit lae heize alesae huapaw nynh thua. <verse number="27" style="v" />Ccathyaa kya,</para>
  <para style="q1">‘Dotua, na laanpi a paccyn cih paw</para>
  <para style="q2">ka zeccuetu kha na malang</para>
  <para style="q1">ka saw cih,’ cite azeikuhpaw kha</para>
  <para style="q2">tuh-e paw tuh nynh</para>
  <para style="q1">a honuathepaw athua.<note caller="-" style="x"><char style="xo" closed="false">7.27: </char><char style="xt" closed="false"><ref loc="MAL 3:1">Mal 3.1</ref></char></note></para>
  <para style="m">
    <verse number="28" style="v" />Pawccecize kae hopya oh, nopi hae nynh a saah hae paw ccungccaw hae kyaze Baptisma pyatu Johan laeze alesae huapaw lu kheit san um khyh; thuasalama Pachia peenaw kya adih huapaw ccungccaw tuh aning laeze a lesaehua,” a ci. <verse number="29" style="v" />(Tuh-e bya tuh ccungccaw hae balyn nynh a thae hae, minmin te ngunto khoitu hae tuh Pachia dingnaw a pom hae paw te Johan kya-e baptisma a in hae paw nynh athua hae.<note caller="-" style="x"><char style="xo" closed="false">7.29-30: </char><char style="xt" closed="false"><ref loc="MAT 21:32">Mat 21.32</ref>; <ref loc="LUK 3:12">Luk 3.12</ref></char></note> <verse number="30" style="v" />Thuasalama Farasi hae te kawbya thya hae paw tuh Pachia paccynnaw kha vua hae zah Johan kya-e baptisma kha in khyh hae.)</para>
  <para style="p">
    <verse number="31" style="v" />Jesu nynh, “Atu she e ccungccaw hae hynh pawtemou ka touse cih hae? Minmin hynh pawtemou aloku hae? <verse number="32" style="v" />Minmin tuh kungkunaw kya haung hae zah,</para>
  <para style="q1">‘Phyly kae tupah oh zah</para>
  <para style="q2">na law khyh oh,</para>
  <para style="q1">michi hlaw kae sahpah oh zahmah</para>
  <para style="q2">na rah khyh oh rei,’</para>
  <para style="m">cite mimaw te mimaw a hokuh hae paw imua hae te nynh aloku hae. <verse number="33" style="v" />Pawccecize Baptisma pyatu Johan tuh sanlou mah ae leite misutui mah nia leite yn thua zah nanning nynh, ‘Aning tuh raerangsaro bahkuhpaw nynh thua,’ na ci oh. <verse number="34" style="v" />Ccungccaw Ccapaw tuh aete niate yn thua zah nanning nynh, ‘Dotua oh, aemohpaw te misuripaw khuh! Misei hae te ngunto khoitu hae banpaw khuh!’ na ci oh. <verse number="35" style="v" />Thuasalama hawnaw tuh amaw a ccaaw hae balyn nynh a langsaku hae,” a ci.</para>
  <para style="s1">Miseinung nynh Chitui A Thuh</para>
  <para style="p">
    <verse number="36" style="v" />Farasipaw lu kheit nynh zerya mangkheih lan Jesu kha a ko. Jesu tuh Farasipaw inn lang cceih zah ae lan a haung. <verse number="37" style="v" />Tuin khua kya umpaw miseinung nynh Farasipaw inn kya ae lan Jesu a haung cipaw kha he a nyh tuh alabasta lung rawpaw te zimuin bawng kheit kha ccyng zah,<note caller="-" style="x"><char style="xo" closed="false">7.37-38: </char><char style="xt" closed="false"><ref loc="MAT 26:7">Mat 26.7</ref>; <ref loc="MRK 14:3">Mar 14.3</ref>; <ref loc="JHN 12:3">Joh 12.3</ref></char></note> <verse number="38" style="v" />Jesu nulang a cculeihpaw khe thadyn zah a rah, te a ccu kha a mitphi te ciasah zah a lu kya-e a sang te a hupya, a ccu kha myng zah chitui a thuh. <verse number="39" style="v" />Looh a kopahpaw Farasipaw nynh tuh-e tuh he a muih tuh, “E Ccungccapaw hynh profeh athua lanze amaw a haenung nopinung hynh hum nynh thua cipaw te pawcihawpaw nopi cipaw kha a nyh cih; pawccecize e nung tuh miseinung nynh thua,” cite a lungkaw te a tua. <verse number="40" style="v" />Jesu nynh, “Simon, kae hopya rypaw ccangkheit a um,” a cipya. Simon nynh, “Sazae, ho ccaleih,” a cipya. <verse number="41" style="v" />Jesu nynh, “Phuasawtupaw lu kheit la um zah a laebah umtu hae lu ning a um hae; lukheitpaw nynh denari phua za pangaw laebah um zah mingccangpaw tuh sung pangaw laebah a um. <verse number="42" style="v" />Minmin nynh a sang kho khyh hae keiccuze parouh mawte a ngaethya hae. Tukeiccuze yn hopya tua, tuh-e lu ning hae kyaze hum nynh mou phuasawtupaw kha a sungsahua cih?” cite a khia. <verse number="43" style="v" />Simon nynh, “Laebah alunghua a ngaethyapaw kha nynh athua cih cite ka tua,” a ci. Jesu nynh, “Phe na kyh,” a cipya. <verse number="44" style="v" />Jesu nynh nopinung kalan maeleihkuh zah Simon kha, “E nopinung hynh na muih tou? Kae tuh na inn lungkhu lang ka tee zah ka ccu singkunaw lanpaw tui nae pya khyh, thuasalama e nung nynh ka ccu hynh a mitphi te yn singpah zah a sang te yn hupya vae. <verse number="45" style="v" />Nang tuh kae hynh nae myng khyh, thuasalama e nung tuh inn lungkhu lang ka tee takaw te ka ccu hynh apaekuh lei lan po a myng. <verse number="46" style="v" />Nang tuh ka lu hynh chitui nae thuh khyh, thuasalama e nung nynh ka ccu hynh zimuin te phe yn thuhpya. <verse number="47" style="v" />Tukeiccuze kae hopya, e nung a seinaw patae kha ngaethya athua vae keiccuze aning nynh sungsahnaw patae kha a langsaku; thuasalama seinaw beihtaraw ngaethya athuapaw nynh tuh sungsahnaw ditaraw rou nynh a langsaku,” a cipya. <verse number="48" style="v" />Jesu nynh tuh-e nung kha, “Na seinaw hae tuh ngaethya athua vae,” a cipya. <verse number="49" style="v" />Amaw ryte looh a koihkheih hae paw nynh, “Seinaw a ngaethyatupaw hynh hum vema?” cite a hoku hae. <verse number="50" style="v" />Jesu nynh nopinung kha, “Na zynnaw nynh phe ae khum vae, ngaengante la cceih ccavae,” a cipya.</para>
  <chapter number="8" style="c" />
  <para style="s">Jesu Ryalaw Nopi hae Bawmnaw</para>
  <para style="p">
    <verse number="1" style="v" />Tukoute Jesu tuh Pachia peenaw kong thehoypaw kha hote khuapi te khua taraw hae kalan khua a ccong. Zuitu hae lu haw lae ning tuh amaw kya a mungkuh bua hae. <verse number="2" style="v" />Ahoy leipaw muisaw bahkunaw te ccihawnaw kyate a dan hae paw nopi hae abang mah a cceihbua hae: raerangsaro hae lu sari a depyapaw Magdalin a ci hae paw Mary,<note caller="-" style="x"><char style="xo" closed="false">8.2-3: </char><char style="xt" closed="false"><ref loc="MAT 27:55-56">Mat 27.55-56</ref>; <ref loc="MRK 15:40-41">Mar 15.40-41</ref>; <ref loc="LUK 23:49">Luk 23.49</ref></char></note> <verse number="3" style="v" />Herod kya-e synriatu Khuza a zu Joanna, Susanna te mih sisua hae khate Jesu te a zuitu hae a bawmtu ccangpaw nopi hae patae a umbua hae.</para>
  <para style="s1">Ccacii Vuatu Tousenaw</para>
  <para style="r">(<ref loc="MAT 13:1-9">Mat 13.1-9</ref>; <ref loc="MRK 4:1-9">Mar 4.1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" />Ccungccaw patae tuh khua takyh kyate Jesu kalan oun thua hae zah he sueluakuh hae tuh Jesu nynh tousenaw phungpaw ccangkheit a hopya hae. A hopaw tuh: <verse number="5" style="v" />“Ccacii vuatu lu kheit tuh a ccacii vua lan a cceih; ccacii kha vua zah abang tuh laanpi kin ccah zah ccu te syde thua zah vaawlang e pavaw hae nynh pong a tuh hae. <verse number="6" style="v" />Abang tuh lung vawlan ccah zah ccahe a po takaw mawte laedahpaw a um khyh keiccu karae arou. <verse number="7" style="v" />Abang tuh hinpaw hae laku ccah zah hinpaw hae ryte a pokheih hae, te hinpaw hae nynh lethin hae zah phang a lungde hae. <verse number="8" style="v" />Abang tuh lae hoy kya ccah zah a po, te leit za kheit athae a thae,” a ci. E kong he a ho koute, “Thaenaw nakaring a hoipaw miakaw tuh thae sah!” cite a sia.</para>
  <para style="s1">Tousenaw Asuilan</para>
  <para style="r">(<ref loc="MAT 13:10-17">Mat 13.10-17</ref>; <ref loc="MRK 4:10-12">Mar 4.10-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" />A zuitu hae nynh, “E tousenaw phungpaw asuilan tuh pawmou?” cite Jesu kha a khia hae. <verse number="10" style="v" />Jesu nynh, “Pachia peenaw kya-e byakhupaw kha ny lan pya na thua oh; thuasalama mingccang hae tuh,</para>
  <para style="q1">‘mang muih hae zah nyh khyh hae,</para>
  <para style="q2">mang thae hae zah thaethya khyh hae,’</para>
  <para style="m">tukeiccuze tousenaw phungpaw te hopya athua.<note caller="-" style="x"><char style="xo" closed="false">8.10: </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">Isa 6.9-10</ref> (LXX)</char></note></para>
  <para style="s1">Ccacii Vuatu Tousenaw Asuilan</para>
  <para style="r">(<ref loc="MAT 13:18-23">Mat 13.18-23</ref>; <ref loc="MRK 4:13-20">Mar 4.13-20</ref>)</para>
  <para style="p">
    <verse number="11" style="v" />“Tousenaw phungpaw tuh hynhte nynh thua: Ccacii tuh Pachia bya nynh thua. <verse number="12" style="v" />Laanpi kin a ccah hae paw tuh, Pachia bya a thaetu hae nynh thua; minmin nynh a zyn khyh nawlan hae te khumnaw a mue khyh nawlan hae cite Satan nynh yn cceih zah mih thinlung kya-e Pachia bya kha phe a lawpya hae. <verse number="13" style="v" />Lung vawlan a ccah hae paw tuh, Pachia bya kha he a thae hae te lungtuate a lawkuh hae paw nynh thua, thuasalama tharui hoi khyh hae, sosoh kyalya zyn hae zah tuhounaw nynh yn thuanua hae tuh phe a khuliakuh hae. <verse number="14" style="v" />Hinpaw laku a ccah hae paw tuh, Pachia bya kha a thae kou hae te cceih hae zah lungvawsawnaw, hoirumnaw te pynsaw hoysahnaw hae nynh varyng ve hae zah mih thae thae kho vae khyh hae. <verse number="15" style="v" />Thuasalama lae hoy kya a ccah hae paw tuh, Pachia bya kha he a thae hae te, athyaapaw te ahoypaw thinlung khate tynkaring lan ccykekuh hae zah lungsaenaw te athae thae hae paw kha nynh thua.</para>
  <para style="s1">Maeekhua Tousenaw</para>
  <para style="r">(<ref loc="MRK 4:21-25">Mar 4.21-25</ref>)</para>
  <para style="p">
    <verse number="16" style="v" />“Humhung nynh mah maeekhua kha aw zah kee te khong boi khyh, ikhung kaw lang mah nung khyh, oun tee hae paw nynh awnaw kha a muih ccaw hae cite maee awnawpaw vawlan nynh a khang.<note caller="-" style="x"><char style="xo" closed="false">8.16: </char><char style="xt" closed="false"><ref loc="MAT 5:15">Mat 5.15</ref>; <ref loc="LUK 11:33">Luk 11.33</ref></char></note> <verse number="17" style="v" />Pawccecize alangkuh lei lante thuruhpaw miakaw kha langsah athua cih zah, khongpaw miakaw kha hungpya athua cih.<note caller="-" style="x"><char style="xo" closed="false">8.17: </char><char style="xt" closed="false"><ref loc="MAT 10:26">Mat 10.26</ref>; <ref loc="LUK 12:2">Luk 12.2</ref></char></note> <verse number="18" style="v" />Tukeiccuze pawtemou na thae oh cipaw raeringkuh oh, pawccecize a hoipaw ccungccaw tuh pyachih athua cih zah, a hoi leipaw ccungccaw nynh beihtaraw ka hoi cite a tuakupaw kha heize lawpya athua cih,” bua a ci.<note caller="-" style="x"><char style="xo" closed="false">8.18: </char><char style="xt" closed="false"><ref loc="MAT 25:29">Mat 25.29</ref>; <ref loc="LUK 19:26">Luk 19.26</ref></char></note></para>
  <para style="s1">Jesu Vaeccaw hae Ccaccing</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mat 12.46-50</ref>; <ref loc="MRK 3:31-35">Mar 3.31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" />A nung te a neitaw hae nynh Jesu kalan oun cceih hae zah ccungccaw eih alung keiccuze a kalan naekuh kho khyh hae. <verse number="20" style="v" />“Na nung te na neitawpaw hae nynh nang kha ae tungkuh ry hae zah atolang nynh a thadyn hae,” cite a hopya hae. <verse number="21" style="v" />Jesu nynh minmin kha, “Pachia bya kha thae hae zah a zui hae paw tuh ka nung te ka neitaw hae nynh thua hae,” a cipya hae.</para>
  <para style="s1">Jesu nynh Khise Daesah</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mat 8.23-27</ref>; <ref loc="MRK 4:35-41">Mar 4.35-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" />Nin kheit tuh Jesu nynh a zuitu hae ryte kohlung lungkhu lang tee hae zah minmin kha, “Tuili khuraw lang khuin zua oh sih,” cipah hae zah kohlung te a cceih hae. <verse number="23" style="v" />A ccia lya hae khe Jesu tuh a ih. Tuili kyakhe khise yn tho zah kohlung tuh tui phe a bia keiccuze minmin tuh vawsaw a tung hae. <verse number="24" style="v" />Zuitu hae nynh amaw kha ccianuate tho hae zah, “Bawipaw, Bawipaw, aening ah chih vae cih oh!” cite a hopya hae. Jesu nynh thokuh zah khise te tuileih athopaw tuh kaw a pya; tuileih te khise tuh daebabi lan zya adae vae. <verse number="25" style="v" />Jesu nynh minmin kha, “Nae zynnaw tuh pawkyamou?” a cipya hae. Minmin tuh rih hae zah mih ngaeangthua; “E paw hynh pawtecihpaw ccungccaw mou! Khise te tuileih kha heize kawpya zah minmin nynh a kaw a ngae hae!” cite lu kheit te lu kheit a hoku hae.</para>
  <para style="s1">Raerangsaro Bahkuhpaw A Dansah</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mat 8.28-34</ref>; <ref loc="MRK 5:1-20">Mar 5.1-20</ref>)</para>
  <para style="p">
    <verse number="26" style="v" />Minmin tuh Galilee ram te arawsekuhpaw Garasene ram lang a thua hae. <verse number="27" style="v" />Jesu tuh varang lang a zua koute tuin khua e ccungccapaw, raerangsaro a bahkuhpaw nynh yn tungku. Aning tuh ccyh hynhsepi cia angki kiku leite, innvaw mah um leite, shawku kya leih umpaw nynh thua. <verse number="28" style="v" />Jesu kha he a muih tuh, a malang khe bakhung zah, “Ahang Huaccepaw Pachia Ccapaw Jesu, nang te kae tuh pawmou ah sekuh? Kae hynh vawsaw nae pya khyh nawlan kae ngiaku,” cite thawte a sia. <verse number="29" style="v" />Pawccecize Jesu nynh athyaa leipaw muisaw kha tuh-e paw kyate pou lan kaw phe a pya vae. Pawccecize tuh-e muisaw nynh amaw kha avae patae a la kyng; sivawrui te ccukhiinawpaw te khii hae zah khia kya a nung hae; thuasalama aning nynh a khiinaw hae paw kha thoh pae zah raerangsaro nynh ramkaw langkhe leih a dee. <verse number="30" style="v" />Jesu nynh, “Na min hummou?” cite a khia. Aning nynh, “Legion,” a ci; pawccecize raerangsaro hae patae tuh amaw lungkhu lang a tee hae keiccu nynh thua. <verse number="31" style="v" />Raerangsaro hae nynh Jesu kha, “Akhupaw laekarung kalan beih oun sah nan,” cite a ngiaku hae.</para>
  <para style="p">
    <verse number="32" style="v" />Tuin pe mua vawlan khe rampaeekuh hae paw voh hae tuh aphupi te a um hae, te minmin nynh tuh-e hae lungkhu lang tee lan kaw a ua nawlan hae ngiakuh hae zah Jesu nynh kaw a ua hae. <verse number="33" style="v" />Raerangsaro hae tuh ccungccapaw kyate pou hae zah voh hae lungkhu lang a tee hae; te voh phu tuh apannaw kyate tuili lungkhu lang thawmawte ccuebung hae zah pong a phungkuh hae.</para>
  <para style="p">
    <verse number="34" style="v" />Voh a rintu hae nynh tuh-e acyihkuhpaw tuh he a muih hae te, ccue hae zah tuh-e kong tuh khuapi te khua taraw hae kya a ho hae. <verse number="35" style="v" />Ccungccaw hae nynh acyihkuhpaw kha do khylan oun cceih hae zah Jesu kalan oun thua hae, te a kyate raerangsaro hae a poupaw ccungccapaw tuh Jesu cculeihpaw khe haung zah boeining lawkute a lung akyhpaw kha a muih hae tuh a rih hae. <verse number="36" style="v" />Raerangsaro bahkuhpaw ccungccapaw tuh pawcihte nynh a dan cipaw a muihpaw ccungccaw hae nynh oun thua hae paw kha a hopya bua hae. <verse number="37" style="v" />Garasene ram kya um hae paw ccungccaw zapi balyn nynh eih rih kaesy hae zah mih kyate a pou nawlan Jesu kha a ngia hae; tukeiccuze Jesu tuh kohlung lungkhu lang tee zah phe a ki. <verse number="38" style="v" />Raerangsaro nynh a poutawpaw ccungccapaw nynh Jesu kya umbua lan a ngiaku. Thuasalama Jesu nynh, <verse number="39" style="v" />“Na inn lang la ki lah Pachia nynh na hanlan ae cyipyapaw kong kha la ho,” cipah zah a kisah. Aning nynh cceih zah Jesu nynh a hanlan a cyipyapaw kong kha khuapi po lekuh lan a hopya hae.</para>
  <para style="s1">Jairas Ccanung te Jesu Boei Dung A Haenung</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mat 9.18-26</ref>; <ref loc="MRK 5:21-43">Mar 5.21-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" />Jesu tuh he a ki te, ccungccaw zapi nynh a cciadue hae, pawccecize minmin nynh amaw kha a ngaw hae keiccu nynh thua. <verse number="41" style="v" />Sinakok uktu Jairas a ci hae paw nynh yn thua zah Jesu cculeihpaw khe bakhung zah a inn lang ccia lan a ngia.</para>
  <para style="p">
    <verse number="42" style="v" />Pawccecize aning nynh kum haw lae ning loukaw acih vae paw, ccanung lu kheit kyalya hoi zah tuh-e nung tuh vyavya a chih. Jesu a ccia lyakhe ccungccaw hae nynh phang a lungnuaku hae. <verse number="43" style="v" />Kum haw lae ning cia chiilua ccinaw a hoinung lu kheit a um, aning nynh a hoipaw balyn kha sibawi hae kya marya thangkuh salamah humhung nynh mah dansah kho khyh. <verse number="44" style="v" />Jesu nulang te yn naekuh zah a boei dung kha zya a hae; tetuh vaekheihmawte a chii luapaw tuh phe akan. <verse number="45" style="v" />Jesu nynh, “Hummou yn hae?” cite a khia hae. Ccungccaw hae balyn nynh kae nyh khyh he a ci hae tuh Peter nynh, “Bawipaw, ccungccaw zapi nynh ae koihlu hae zah ae eihsei hae paw ngawrei,” cite a hopya. <verse number="46" style="v" />Jesu nynh, “Lukhakheit nynh yn hae, pawccecize ka kyate huhan a poupaw kha ka ny,” a ci. <verse number="47" style="v" />Nopinung nynh ka pheikuh kho vae lan khyh cipaw he a nyh tuh thyngkute cceih zah Jesu malang khe bakhung zah paw keiccu nynh ka hae cipaw te vaekheihmawte phe a dannawpaw kong kha ccungccaw balyn malang khe a hopya. <verse number="48" style="v" />Jesu nynh, “Ka ccanung, na zynnaw nynh ae dansah vae, ngaengante la cceih ccavae,” a cipya.</para>
  <para style="p">
    <verse number="49" style="v" />Tuhte a ho cciamang lyakhe sinakok uktupaw inn kyate ccungccaw lu kheit yn thua zah Jairas kha, “Na ccanung phe chih vae, sazaepaw kha vawsaw pya nan vae,” a cipya. <verse number="50" style="v" />Jesu nynh tuh-e tuh he a thae te Jairas kha, “Rih nan, zyn kyalya zyn lah na ccanung tuh a dan cih,” cite a hopya. <verse number="51" style="v" />Inn kya he a thua te Peter, James te Johan, te imuanung a nung te a paaw laelan hum sanmah inn lungkhu lang tee lan Jesu nynh ua khyh hae. <verse number="52" style="v" />Ccungccaw hae balyn tuh a rah a khui hae; thuasalama Jesu nynh, “Rah nan oh, imuanung tuh chih khyh, a ihpaw nynh thua,” a cipya hae. <verse number="53" style="v" />A chih cipaw phe ny hae paw thua zah minmin nynh Jesu kha a nuinse hae. <verse number="54" style="v" />Jesu nynh imuanung kha a kuih te kyng zah, “Imuanung, thokuh!” a cipya. <verse number="55" style="v" />A hiinnaw tuh yn kithui zah, vaekheihmawte po yn thokuh. Te Jesu nynh aepaw pya oh cite kaw a pya hae. <verse number="56" style="v" />A paaw te a nung tuh mih ngaeangthua, Jesu nynh tuh-e acyihkuhpaw kong tuh humhung kya mah la ho nan oh cite kaw a pya hae.</para>
  <chapter number="9" style="c" />
  <para style="s1">Locceihtu Lu Haw Lae Ning A Saw</para>
  <para style="r">(<ref loc="MAT 10:5-15">Mat 10.5-15</ref>; <ref loc="MRK 6:7-13">Mar 6.7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Jesu nynh a zuitu hae lu haw lae ning kha pynkheihlan ko hae zah raerangsaro hae balyn dee khonaw, ccinaw dansah khonaw huhan te kawhoinaw kha a pya hae. <verse number="2" style="v" />Aning nynh Pachia peenaw kong ho lan te ngeccih hae dansah khylan minmin kha saw hae zah, <verse number="3" style="v" />“Khua na ccongnaw oh kya pawpaw mah phukuh nan oh, hoitang, zaw, aepaw te phua kha phukuh nan oh, angki heize phukhykuh nan oh.<note caller="-" style="x"><char style="xo" closed="false">9.3-5: </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">Luk 10.4-11</ref>; <ref loc="ACT 13:51">Loc 13.51</ref></char></note> <verse number="4" style="v" />Pawtecihpaw inn kya na tee oh zemah tuin kyakhe la um oh lah tuh-e kyate la pou oh. <verse number="5" style="v" />Innccong ae doih oh ze, tuh-e khua kyate he na pou oh te minmin rawsenawpaw ccaekia lang nae ccu kya-e vuiping kha la khuanua sya oh,” cite a hopya hae. <verse number="6" style="v" />Minmin tuh pou hae zah thehoypaw kha hote ahmin takyh kya ngeccih dansah biate khua takyh lang khua a ccong hae.</para>
  <para style="s1">Baptisma Pyatu Johan A Lu Pae hae</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mat 14.1-12</ref>; <ref loc="MRK 6:14-29">Mar 6.14-29</ref>)</para>
  <para style="p">
    <verse number="7" style="v" />Jesu nynh a cyipaw balyn kha uktupaw Herod nynh a thae tuh a ngaeangthua, pawccecize ccungccaw abang nynh Johan tuh chinaw kyate a thoothui vae cite a ho hae.<note caller="-" style="x"><char style="xo" closed="false">9.7-8: </char><char style="xt" closed="false"><ref loc="MAT 16:14">Mat 16.14</ref>; <ref loc="MRK 8:28">Mar 8.28</ref>; <ref loc="LUK 9:19">Luk 9.19</ref></char></note> <verse number="8" style="v" />Abang nynh Elijah nynh yn langkuh vae a ci hae, mingccang hae nynh langmawlya e profeh hae lukhakheit nynh bua yn thoothui a ci hae. <verse number="9" style="v" />Herod nynh, “Johan tuh a lu phe ka paesah vae hae, thuasalama hynhcite a konglang ka thaepaw hynh hummou athua?” a ci. Tukeiccuze Jesu kha muih lan a zuaku.</para>
  <para style="s1">Thong Pangaw Loohdangnaw</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mat 14.13-21</ref>; <ref loc="MRK 6:30-44">Mar 6.30-44</ref>; <ref loc="JHN 6:1-14">Joh 6.1-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" />Locceihtu hae nynh he oun ki hae te, a cyi hae paw balyn kha Jesu a hopya hae. Jesu nynh minmin kha ko hae zah Bethsaida a ci hae paw khua langkhe mimaw lalouhte a cceih hae. <verse number="11" style="v" />Ccungccaw zapi nynh tuh-e tuh he a nyh hae tuh Jesu kha a zui hae, Jesu nynh minmin kha lehkhan hae zah Pachia peenaw kong kha a hopya hae, dansah ahopaw ccungccaw hae kha a dansah hae.</para>
  <para style="p">
    <verse number="12" style="v" />Khuanin yn nae tuh, zuitu lu haw lae ning nynh a kalan oun cceih hae zah, “Ccungccaw hae hynh hein pepan e khua hae te khua taraw hae kalan cciate ryanaw te aepaw a zahku ccaw hae cciasah hae; pawccecize ramkaw kya nynh ah um oh,” cite a hopya hae. <verse number="13" style="v" />Thuasalama Jesu nynh, “Naemaw nynh a ae lan hae paw tuh pya oh,” a cipya hae. Minmin nynh, “Kae cceih cih zah e ccungccaw hae balyn hanlan aepaw kae re khyh lanze, sanlou phe pangaw te ngasaw zaw ning laelan pawpaw mah kae hoi khyh,” a ci hae. <verse number="14" style="v" />Pawccecize tuin kya pise piccan hae thong pangaw loukaw a um hae. A zuitu hae kha, “Phu kheit ze sung pangaw ccite minmin kha haungsah oh,” a cipya hae. <verse number="15" style="v" />Zuitu hae nynh tuhcite cyih hae zah mih balynte a haungsah hae. <verse number="16" style="v" />Jesu nynh sanlou phe pangaw te ngasaw zaw ning kha lah zah vaawlang dothung zah lungtuabya a ho koute eih zah ccungccaw zapi malang nyapya lan a zuitu hae kha a pya hae. <verse number="17" style="v" />Mih balynte ae hae zah mih vue aso koute alaepaw a eihpaw kha kee haw lae ning a khuin hae.</para>
  <para style="s1">Peter nynh Jesu Kong A Ho</para>
  <para style="r">(<ref loc="MAT 16:13-19">Mat 16.13-19</ref>; <ref loc="MRK 8:27-30">Mar 8.27-30</ref>)</para>
  <para style="p">
    <verse number="18" style="v" />Vaekheih tuh Jesu nynh a makhaete saw a sang lyakhe a zuitu hae mah amaw pe a umbua hae; Jesu nynh minmin kyakhe, “Ccungccaw hae nynh kae hynh hum yn ci hae mou?” cite a khia hae. <verse number="19" style="v" />Minmin nynh, “Baptisma pyatu Johan ae ci hae, abang nynh Elijah ae ci hae, mingccang hae nynh langmawlya e profeh lukhakheit nynh yn thoothui ae ci hae,” cite a khung hae.<note caller="-" style="x"><char style="xo" closed="false">9.19: </char><char style="xt" closed="false"><ref loc="MAT 14:1-2">Mat 14.1-2</ref>; <ref loc="MRK 6:14-15">Mar 6.14-15</ref>; <ref loc="LUK 9:7-8">Luk 9.7-8</ref></char></note> <verse number="20" style="v" />Jesu nynh minmin kha, “Nanning so hum nae ci oh mou?” cite a khia hae. Peter nynh, “Nang tuh Pachia kya-e Messiah nynh na thua,” a ci.<note caller="-" style="x"><char style="xo" closed="false">9.20: </char><char style="xt" closed="false"><ref loc="JHN 6:68-69">Joh 6.68-69</ref></char></note></para>
  <para style="p">
    <verse number="21" style="v" />Jesu nynh tuh-e kong tuh hum kya sanmah a hopya khyh nawlan hae kawpya hae zah tynkaring lan bya a kin hae.</para>
  <para style="s1">A Chi lanpaw A Hoty</para>
  <para style="r">(<ref loc="MAT 16:21-28">Mat 16.21-28</ref>; <ref loc="MRK 8:31-9:1">Mar 8.31—9.1</ref>)</para>
  <para style="p">
    <verse number="22" style="v" />“Ccungccaw Ccapaw tuh myarya yn teing cih, piccan hae, ranpibawi lepaw hae te kawbya sazae hae nynh oun vua cih hae, oun theih cih hae, te nin thumnaw kya yn thoothui cih,” cite a hopya hae.</para>
  <para style="p">
    <verse number="23" style="v" />Mih balyn kyakhe, “Humhung zemah kae hynh yn zui ry ze, amaw te amaw kha vuakuh sah lah nin takyh a vaelantung kha puihkute yn zui sah.<note caller="-" style="x"><char style="xo" closed="false">9.23: </char><char style="xt" closed="false"><ref loc="MAT 10:38">Mat 10.38</ref>; <ref loc="LUK 14:27">Luk 14.27</ref></char></note> <verse number="24" style="v" />Pawccecize humhung zemah a hiinnaw kha a khumkuh rypaw tuh a hiinnaw kha a shung cih, thuasalama humhung zemah kae ka keiccuze a hiinnaw kha a shungpaw tuh a hiinnaw kha a khumkuh cih.<note caller="-" style="x"><char style="xo" closed="false">9.24: </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mat 10.39</ref>; <ref loc="LUK 17:33">Luk 17.33</ref>; <ref loc="JHN 12:25">Joh 12.25</ref></char></note> <verse number="25" style="v" />Pawccecize ccungccaw lu kheit nynh laephi pynpi hynh pong a ccou zeso a hiinnaw kha a shung ze, tuhkhyhze ro athua ze, a hanlan pawmou athane? <verse number="26" style="v" />Humhung zemah kae te ka bya kha a mae yn thyakhaepaw tuh Ccungccaw Ccapaw nynh zemah a phu-enaw, Paaw phu-enaw te vaaw mithyaa hae phu-enaw ryte he yn thua te a maethyakhae ru cih. <verse number="27" style="v" />Thuasalama byaccaccing kae hopya oh, Pachia peenaw kha a muih hae cia a chih cih lei hae paw ccungccaw abang tuh hein kya a thadyn hae,” cite a hopya hae.</para>
  <para style="s1">Jesu Muinsan Rulaekunaw</para>
  <para style="r">(<ref loc="MAT 17:1-13">Mat 17.1-13</ref>; <ref loc="MRK 9:2-13">Mar 9.2-13</ref>)</para>
  <para style="p">
    <verse number="28" style="v" />E bya a ho koute nin tarya loukaw he acih tuh Jesu nynh Peter, Johan te James kha hoeibua hae zah sawsang lan mua lang a kae hae.<note caller="-" style="x"><char style="xo" closed="false">9.28-35: </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2Pe 1.17-18</ref></char></note> <verse number="29" style="v" />Saw a sang cciamang lyakhe a maesue tuh rulaekuh zah a boeining tuh phaephae ak lan araw. <verse number="30" style="v" />Vaekheihmawte ccungccaw lu ning tuh Jesu ryte bya a hokuh hae; tuh-e hae tuh Moses te Elijah nynh thua hae. <verse number="31" style="v" />Minmin tuh phu-enaw te oun langkuh hae zah Jerusalem kya Jesu nynh a ccingsah cih paw a chi lanpaw kong kha a hoku hae. <verse number="32" style="v" />Peter te a ban hae tuh a ngawphukuh hae; he a thaekuh hae tuh, Jesu phu-enaw te amaw ryte a thadynkheih hae paw ccungccaw lu ning kha a muih hae. <verse number="33" style="v" />Tuh-e lu ning hae nynh he a cciataw hae te Peter nynh Jesu kha, “Bawipaw, hein kya ah um oh paw hynh myarya ahoy; kaening nynh bu buthum kae sak sah lah, nang na hanlan bu kheit, Moses hanlan bu kheit, te Elijah hanlan bu kheit,” cite paw nynh ka ho cipaw ny leite a hopya. <verse number="34" style="v" />Tuhte a ho cciamang lyakhe maeking yn zi zah minmin kha pong a khong hae, Moses te Elijah nynh maeking lungkhu lang he a tee hae tuh minmin tuh a rih hae. <verse number="35" style="v" />Maeking kyate roi yn ccae zah, “E paw tuh ka sungsahpaw ka Ccapaw nynh thua, a bya kha la ngae oh,” a ci.<note caller="-" style="x"><char style="xo" closed="false">9.35: </char><char style="xt" closed="false"><ref loc="ISA 42:1">Isa 42.1</ref>; <ref loc="MAT 3:17">Mat 3.17</ref>, <ref loc="MAT 12:18">12.18</ref>; <ref loc="MRK 1:11">Mar 1.11</ref>; <ref loc="LUK 3:22">Luk 3.22</ref></char></note> <verse number="36" style="v" />Roi he adae tuh Jesu makhae nynh a muih vae hae. Zuitu hae nynh tuh lyaze a muih hae paw konglang kha hum kya sanmah ho leite daebabi lan a um hae.</para>
  <para style="s1">Imuapaw A Dansah</para>
  <para style="r">(<ref loc="MAT 17:14-18">Mat 17.14-18</ref>; <ref loc="MRK 9:14-27">Mar 9.14-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" />Awkhualan khe minmin tuh mua kyate oun rungbung hae zah ccungccaw patae nynh Jesu kha oun tungku hae. <verse number="38" style="v" />Ccungccaw zapi laku te lukheitpaw nynh yn sia zah, “Sazae, ka ccapaw nae dopya nawlan kae ngiaku; amaw kyalya nynh ccaaw ka saah. <verse number="39" style="v" />Muisaw nynh bahkuh zah vaekheihmawte raerae leih a sia; a mung kyate taraphue phe thua lan karae leih a hosah, myarya ccih lan tuaa zah a kyate poutaw ry khyh. <verse number="40" style="v" />Tuh-e tuh deepya lan na zuitu hae ka ngia hae zah dee kho khyh hae,” a cipya. <verse number="41" style="v" />Jesu nynh, “Pou zynnaw hoi lei hae paw te a ccouseikuh hae paw ciihan hae, hohseciamou nae kya ka um ung cih zah kae ngaesangpah ung cih oh? Na ccapaw tuh hynhlang yn cciakhae,” a cipya. <verse number="42" style="v" />Imuapaw nynh a ccia lyakhe raerangsaro nynh laekhu kya khulia zah karae a hosah. Jesu nynh athyaa leipaw muisaw kha pe zah imuapaw kha a dansah, te a paaw kalan bua a pya.</para>
  <para style="s1">A Chi lanpaw Bua A Ho</para>
  <para style="r">(<ref loc="MAT 17:22-23">Mat 17.22-23</ref>; <ref loc="MRK 9:30-32">Mar 9.30-32</ref>)</para>
  <para style="p">
    <verse number="43" style="v" />Ccungccaw hae balyn tuh Pachia lesaenaw kha muih hae zah mih ngaeangthua. Jesu nynh a cyipaw miakaw kya ccungccaw miakaw mih ngaeangthua lyakhe, Jesu nynh a zuitu hae kha, <verse number="44" style="v" />“E bya hae hynh nae nakaring lungkhu lang tee sah, pawccecize Ccungccaw Ccapaw tuh ccungccaw hae kuih kya pya yn thua cih,” a cipya hae. <verse number="45" style="v" />Thuasalama minmin nynh tuh-e bya tuh thaethya khyh hae, bya asuilan kha thuruh thua zah nyhthya khyh hae; tuh-e bya konglang tuh amaw kha khia lan mah phe a rih hae.</para>
  <para style="s1">Hummou A Lesaehua</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mat 18.1-5</ref>; <ref loc="MRK 9:33-37">Mar 9.33-37</ref>)</para>
  <para style="p">
    <verse number="46" style="v" />Zuitu hae laku kya hummou alehua cipaw eikunaw a um.<note caller="-" style="x"><char style="xo" closed="false">9.46: </char><char style="xt" closed="false"><ref loc="LUK 22:24">Luk 22.24</ref></char></note> <verse number="47" style="v" />Jesu nynh mih tuanaw kha a ny keiccuze imua lu kheit kha lah zah a pe khe a nung, <verse number="48" style="v" />te minmin kyakhe, “Humhung zemah e imua taraw hynh ka min te leh a khanpaw tuh kae kha leh yn khanpaw nynh thua, te humhung zemah kae kha leh yn khanpaw tuh kae yn sawtupaw kha leh a khanpaw nynh thua. Pawccecize nanning balyn lakuze adih huapaw tuh alesae huapaw athua cih,” cite a hopya hae.<note caller="-" style="x"><char style="xo" closed="false">9.48: </char><char style="xt" closed="false"><ref loc="MAT 10:40">Mat 10.40</ref>; <ref loc="LUK 10:16">Luk 10.16</ref>; <ref loc="JHN 13:20">Joh 13.20</ref></char></note></para>
  <para style="s1">Jesu Min te Raerangsaro Deenaw</para>
  <para style="r">(<ref loc="MRK 9:38-40">Mar 9.38-40</ref>)</para>
  <para style="p">
    <verse number="49" style="v" />Johan nynh, “Bawipaw, lukheitpaw nynh na min te raerangsaro a deepaw kha kae muih zah kae khee, pawccecize aning tuh aening kya a zuikuh buapaw thua khyh,” a cipya. <verse number="50" style="v" />Jesu nynh, “Tuh-e paw tuh khee nan oh, pawccecize aening oun rawse leipaw tuh oun pankhaepaw nynh thua,” a cipya.</para>
  <para style="p">
    <verse number="51" style="v" />Jesu tuh vaawlang te lawthungnaw ccyh anae vae keiccuze Jerusalem lang ccia lan a noukuh. <verse number="52" style="v" />Zeccuetu hae kha a malang a saw hae; minmin nynh cceih hae zah amaw hanlan paccyn khylan Samaria hae khua khuakheit kya a tee hae. <verse number="53" style="v" />Jerusalem lang po sulue lan a nouku keiccuze tuh-e khuaccaaw hae nynh amaw kha thuasah khyh hae. <verse number="54" style="v" />A zuitu hae James te Johan nynh tuh-e tuh muih hae zah, “Bawipaw, hynh-e hae hynh marya maemih khylan vaawlang te maee ccawsah lan kaw nae pya ry tou?” cite a khia hae.<note caller="-" style="x"><char style="xo" closed="false">9.54: </char><char style="xt" closed="false"><ref loc="2KI 1:9-16">2Si 1.9-16</ref></char></note> <verse number="55" style="v" />Jesu nynh maenuakuh hae zah a pe hae.<note caller="+" style="f"><char style="fr" closed="false">9.55 </char><char style="ft" closed="false">Abang Ccathyaa hae kya tuh, ‘Nanning tuh pawcihawpaw muisaw kya-e nynh kae thua cipaw na nyhkuh khyh oh. Pawccecize Ccungccaw Ccapaw tuh ccungccaw hae hiinnaw ro khylan yn thua khyh, thuasalama khum khylan nynh yn thua,’ cite a bechih hae.</char></note> <verse number="56" style="v" />Tuinte minmin tuh ccangpaw khua lang a cceih hae.</para>
  <para style="s1">Jesu Zuitu Thuanaw Aruzia</para>
  <para style="r">(<ref loc="MAT 8:19-22">Mat 8.19-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" />Tuhcite minmin tuh laanpi kya a ccia lya hae khe ccungccaw lu kheit nynh, “Bawipaw, na ccianaw miakaw lang kae zui cih,” a cipya. <verse number="58" style="v" />Jesu nynh, “Suizaw hae nynh karung hoi hae zah vaawlang e pavaw hae nynh bu a hoi hae, thuasalama Ccungccaw Ccapaw tuh a lu nungnaw hmin sanmah hoi khyh,” a cipya. <verse number="59" style="v" />Jesu nynh mingccangpaw kha, “Yn zui,” a cipya. Thuasalama aning nynh, “Bawipaw, masaty ka la cceih sah lah ka paaw kha ka la uh hin sah,” a cipya. <verse number="60" style="v" />Jesu nynh, “Michi hae nynh mih michi hae kha la uh hae sah, nang tuh la cceih lah Pachia peenaw kong kha la ho,” a cipya. <verse number="61" style="v" />Mingccangpaw nynh mah, “Bawipaw, kae zui cih, thuasalama ka innbyn hae kha masaty ka la beihsya hin hae,” a cipya.<note caller="-" style="x"><char style="xo" closed="false">9.61: </char><char style="xt" closed="false"><ref loc="1KI 19:20">1Si 19.20</ref></char></note> <verse number="62" style="v" />Jesu nynh, “Hum zemah thuetung kha kyng zah nulang a hawipaw tuh Pachia peenaw hanlan ngaekuh khyh,” a cipya.</para>
  <chapter number="10" style="c" />
  <para style="s">Jesu nynh Sung Sari A Saw hae</para>
  <para style="p">
    <verse number="1" style="v" />Tukoute Bawipaw nynh ccangpaw sung sari kha mah khang hae zah amaw a cceih cihnaw khua te hmin takyh langkhe lu ning ccite a saw lalo hae. <verse number="2" style="v" />Minmin kha, “Loohrue lanpaw tuh myarya alung, thuasalama ryalahtu hae tuh azya. Tukeiccuze loohrue lanpaw a hoitu Bawipaw nynh a loohruenaw kalan ryalahtu hae a saw nawlan sawsang oh,” a cipya hae.<note caller="-" style="x"><char style="xo" closed="false">10.2: </char><char style="xt" closed="false"><ref loc="MAT 9:37-38">Mat 9.37-38</ref></char></note> <verse number="3" style="v" />Nanning la cceih oh; suizaw hae laku lang tuutaw hae saw hawte kae saw oh.<note caller="-" style="x"><char style="xo" closed="false">10.3: </char><char style="xt" closed="false"><ref loc="MAT 10:16">Mat 10.16</ref></char></note> <verse number="4" style="v" />Phuabu thuasah, sohrae thuasah, phanah thuasah phukuh nan oh; laanryng kya humhung mah bya la beih nan oh.<note caller="-" style="x"><char style="xo" closed="false">10.4-11: </char><char style="xt" closed="false"><ref loc="MAT 10:7-14">Mat 10.7-14</ref>; <ref loc="MRK 6:8-11">Mar 6.8-11</ref>; <ref loc="LUK 9:3-5">Luk 9.3-5</ref></char></note> <verse number="5" style="v" />Pawpaw inn kya na tee oh zemah, ‘E inn kya daenaw um sah!’ cite masaty la ho oh. <verse number="6" style="v" />Tuin kya daenaw a rypaw a um ze, na ho oh paw daenaw tuh a tungvaw a um cih, a um khyh ze nae kalan bua yn ki cih. <verse number="7" style="v" />Tuh-e inn kyakhe um oh lah ae pya oh paw kha la ae oh lah la neih oh, pawccecize ryalahtu nynh a ninro tuh a mue lanpaw nynh thua. Inn kheit kyate inn kheit kalan la nuekuh nan oh.<note caller="-" style="x"><char style="xo" closed="false">10.7: </char><char style="xt" closed="false"><ref loc="1CO 9:14">1Ko 9.14</ref>; <ref loc="1TI 5:18">1Ti 5.18</ref></char></note> <verse number="8" style="v" />Khua khuakheit kya na tee oh zah ae thuasah oh ze, nae malang ae nyapya oh paw kha la ae oh, <verse number="9" style="v" />tuin khua e ngeccih hae kha la dansah oh lah, ‘Pachia peenaw tuh nae kalan yn naekuh vae,’ cite la hopah oh. <verse number="10" style="v" />Thuasalama khua khuakheit kya na tee oh zah ae thuasah khyh oh ze, khualae e laanpi hae kalan po la cceih oh lah,<note caller="-" style="x"><char style="xo" closed="false">10.10-11: </char><char style="xt" closed="false"><ref loc="ACT 13:51">Loc 13.51</ref></char></note> <verse number="11" style="v" />‘Kae ccu kya abekuhpaw nae khua e vuiping hynh nanning rawsete kae khuanua oh, tuhzemah Pachia peenaw tuh nae kalan yn naekuh vae cipaw hynh la nyh oh,’ cite minmin kha la hopah oh. <verse number="12" style="v" />Kae hopya oh, byapia nin vae tuh tuh-e khua hanlan laeze Sodom khua hanlan ngaesang kho a umhua cih.<note caller="-" style="x"><char style="xo" closed="false">10.12: </char><char style="xt" closed="false"><ref loc="GEN 19:24-28">Gen 19.24-28</ref>; <ref loc="MAT 11:24">Mat 11.24</ref>, <ref loc="MAT 10:15">10.15</ref></char></note></para>
  <para style="s1">A Zyn leipaw Khua hae</para>
  <para style="r">(<ref loc="MAT 11:20-24">Mat 11.20-24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" />Khorazin khua, nang na hanlan ngaethya lan kou um! Bethsaida khua, nang na hanlan ngaethya lan kou um! Pawccecize nanning kya ka raepaw ngaeangnaw hae hynh Tair khua te Sidon khua kya ka la rae ze, minmin tuh buri boeining lawkute buhhaw kya haungte khawlya mawte a ngaesikuh vae cih hae.<note caller="-" style="x"><char style="xo" closed="false">10.13: </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">Isa 23.1-18</ref>; <ref loc="EZK 26:1-28:26">Eze 26.1—28.26</ref>; <ref loc="JOL 3:4-8">Joe 3.4-8</ref>; <ref loc="AMO 1:9-10">Amo 1.9-10</ref>; <ref loc="ZEC 9:2-4">Zek 9.2-4</ref></char></note> <verse number="14" style="v" />Byapianaw kya nanning hanlan laeze Tair khua te Sidon khua hanlan ngaesang kho a umhua cih. <verse number="15" style="v" />Kapernaum khua, nang tuh</para>
  <para style="q1">vaawlang cia hangthungku na ry ii?</para>
  <para style="q2">Hell lungkhu lang sawbung na thua cih.<note caller="-" style="x"><char style="xo" closed="false">10.15: </char><char style="xt" closed="false"><ref loc="ISA 14:13-15">Isa 14.13-15</ref></char></note></para>
  <para style="p">
    <verse number="16" style="v" />“Nae bya a ngaepaw tuh ka bya a ngaepaw nynh thua; nanning ae vua oh paw tuh kae kha yn vuapaw nynh thua, kae yn vuapaw tuh kae yn sawtupaw kha a vuapaw nynh thua,” cite a hopya hae.<note caller="-" style="x"><char style="xo" closed="false">10.16: </char><char style="xt" closed="false"><ref loc="MAT 10:40">Mat 10.40</ref>; <ref loc="MRK 9:37">Mar 9.37</ref>; <ref loc="LUK 9:48">Luk 9.48</ref>; <ref loc="JHN 13:20">Joh 13.20</ref></char></note></para>
  <para style="s">Sung Sari hae Kinaw</para>
  <para style="p">
    <verse number="17" style="v" />Sung sari hae tuh lungtuate bua oun ki hae zah, “Bawipaw, na min te raerangsaro hae nynh heize kae kaw a ngae hae!” cite a hopya hae. <verse number="18" style="v" />Jesu nynh, “Khozawlaekuhpaw hawte Satan tuh vaawlang te a ccawbungpaw kha ka muih. <verse number="19" style="v" />Dotua oh, nanning tuh hupaw hae te zekang hae syde kho nawlan te nae rhaw hae balyn kha tae kho nawlan kawhoinaw kae pya vae oh; pawpaw nynh mah nanning kha vaemaw ae muesah lan khyh oh.<note caller="-" style="x"><char style="xo" closed="false">10.19: </char><char style="xt" closed="false"><ref loc="PSA 91:13">Sam 91.13</ref></char></note> <verse number="20" style="v" />Tuhzemah muisaw hoylei hae paw nynh nae kaw ae ngae oh pawte nae lungtua nan sah; nae min tuh vaawlang kya zei athua keiccuze nae lungtuahua sah,” a cipya hae.</para>
  <para style="p">
    <verse number="21" style="v" />Tuh ccyh lyakhe Jesu tuh Thyaa Muisaw kya a lungtua zah, “Vaaw te laephi Bawipaw, pou Apang, nang nynh ahawpaw te athyapaw ccungccaw kyate e uccaw hae hynh na thuruh zah imua hae kya na phy vae keiccuze na kalan lungtuabya kae ho; Athua, Apang, hynhte acyikupaw hynh ahoypaw na rynaw nynh thua. <verse number="22" style="v" />Pawpaw balyn tuh Apang nynh kae kalan marya yn pya vae; Paaw laelan hum ccungccaw nynh sanmah Ccapaw hynh nyh khyh; Paaw hynh hum nynh thua cipaw kha Ccapaw te Ccapaw nynh a phypyapaw ccungccaw laelan hum nynh sanmah nyh khyh,” a ci.<note caller="-" style="x"><char style="xo" closed="false">10.22: </char><char style="xt" closed="false"><ref loc="JHN 3:35">Joh 3.35</ref>, <ref loc="JHN 10:15">10.15</ref></char></note></para>
  <para style="p">
    <verse number="23" style="v" />Jesu nynh a zuitu hae kalan maekuh zah, “Na muih oh paw uccaw hae kha a muihpaw mit hae tuh lungtua hae paw nynh thua. <verse number="24" style="v" />Pawccecize kae hopya oh, profeh hae patae te siapharan hae patae nynh na muih oh paw hynh a muih ry hae zemah muih khyh hae, na thae oh paw hynh a thae ry hae zemah thae khyh hae,” cite mih makhaete a hopya hae.</para>
  <para style="s1">Samaria Mihoypaw</para>
  <para style="p">
    <verse number="25" style="v" />Kawbya thyapaw lu kheit nynh thadyn zah, “Sazae, zungzae hiinnaw rho ccou khylan pawmou ka cyi cih?” cite Jesu kha a syntawtua.<note caller="-" style="x"><char style="xo" closed="false">10.25-28: </char><char style="xt" closed="false"><ref loc="MAT 22:35-40">Mat 22.35-40</ref>; <ref loc="MRK 12:28-34">Mar 12.28-34</ref></char></note> <verse number="26" style="v" />Jesu nynh, “Kawbya kya pawmou azeikuh? Pawtemou na ria?” a cipya. <verse number="27" style="v" />Tuh-e paw nynh, “ ‘Bawipaw na Pachia kha na thinlung balyn te, na hiinnaw balyn te, na thawzung balyn te, na tuanaw balyn te na sungsah cih; te na innpaw kha namaw toulou hawte na sungsah cih,’ acikuh,” a cipya.<note caller="-" style="x"><char style="xo" closed="false">10.27: </char><char style="xt" closed="false"><ref loc="LEV 19:18">Lev 19.18</ref>; <ref loc="DEU 6:5">Deu 6.5</ref></char></note> <verse number="28" style="v" />Jesu nynh, “Na hopaw tuh athua, tuhte la cyih lah na hiin cih,” a cipya.<note caller="-" style="x"><char style="xo" closed="false">10.28: </char><char style="xt" closed="false"><ref loc="LEV 18:5">Lev 18.5</ref></char></note></para>
  <para style="p">
    <verse number="29" style="v" />Thuasalama, aning nynh amaw te amaw kha thyaaccousaku ry zah Jesu kha, “Ka innpaw tuh hummou?” cite a khia. <verse number="30" style="v" />Jesu nynh, “Ccungccapaw lu kheit tuh Jerusalem kyate Jeriko khua lang cceihbung zah damiah hae kuih kya phe a phungkuh; damiah hae nynh a boeining kha phae hae zah vya chih lan a bua kou hae te a cciataw hae. <verse number="31" style="v" />Tuh-e laanpi kyakhe ranpibawi lu kheit cceihbung zah tuh-e paw tuh he a muih tuh ccanglang te phe a sibia. <verse number="32" style="v" />Tuhawte Levi phinpaw lu kheit nynh tuin kya he a thua te, tuh-e paw tuh muih zah ccanglang te sibia zah phe a cciataw. <verse number="33" style="v" />Thuasalama Samariapaw lu kheit tuh khuaccong zah tuh-e paw umnaw kya a thua te he a muih tuh ngaethya a umsah.<note caller="-" style="x"><char style="xo" closed="false">10.33-34: </char><char style="xt" closed="false"><ref loc="2CH 28:15">2Sh 28.15</ref></char></note> <verse number="34" style="v" />Te ccianua zah a vaemaw kha chitui te misutui thuhpah zah a heepya, te amaw a sahiin tungvaw khe ccisakuh zah mikhia-inn langkhe cciakhae zah a do-oih. <verse number="35" style="v" />Awkhualan tuh denari kia ning kha thuaakuh zah mikhia-inn ngawtupaw kha pya zah, ‘E paw hynh la do-oih lah tuhlae na thangpaw kha bua kae thua te kae pyaru cih,’ a cipya. <verse number="36" style="v" />Tuh-e lu thum hae lakuze damiah hae kuih kya a phungkuhpaw tuh-e ccungccapaw a innpaw tuh hummou athua cih cite na tua?” a cipya. <verse number="37" style="v" />Kawbya thyapaw nynh, “Tuh-e paw tungvaw ngaethyaumsahnaw a hoipaw nynh athua,” a ci. Jesu nynh, “La cceih lah nang mah tuh-e hawte la cyihbua,” a cipya.</para>
  <para style="s1">Martha te Mary</para>
  <para style="p">
    <verse number="38" style="v" />Tuhcite Jesu te a zuitu hae tuh khua a ccong lya hae khe, Jesu tuh khua khuakheit kya tee zah Martha a ci hae paw nopinung lu kheit nynh Jesu kha a inn lang a thuasah.<note caller="-" style="x"><char style="xo" closed="false">10.38-39: </char><char style="xt" closed="false"><ref loc="JHN 11:1">Joh 11.1</ref></char></note> <verse number="39" style="v" />Martha nynh Mary a ci hae paw a neitawnung lu kheit a hoi. Mary tuh Bawipaw cculeihpaw khe haung zah a bya kha a ngae. <verse number="40" style="v" />Martha tuh thohae ryasuh pawte a thinlung sokhaekuh zah Jesu kalan cceih zah, “Bawipaw, ka neitawnung nynh ka makhaete thohae rya miakaw pong yn ngaeccepaw hynh pawlang na ria khyh tou? Kae hynh yn bawm nawlan hopah,” a cipya. <verse number="41" style="v" />Bawipaw nynh, “Martha, Martha, nang tuh uccaw patae konglang na lungvawsaw zah na thinphang. <verse number="42" style="v" />Thuasalama ahoboupaw uccaw ccangkheit rou nynh a um; Mary nynh tuh-e ahoypaw uccaw tuh phe a poku vae, tuh-e tuh amaw kyate lawpya thua vae lan khyh,” a ci.</para>
  <chapter number="11" style="c" />
  <para style="s1">Bawipaw Sawsangnaw</para>
  <para style="r">(<ref loc="MAT 6:9-13">Mat 6.9-13</ref>, <ref loc="MAT 7:7-11">7.7-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Jesu tuh hmin san kheit kya sawsang zah he a thangsah te, a zuitu hae lakuze lu kheit nynh, “Bawipaw, Johan nynh a zuitu hae a ccangpya hae hawte, kaening hynh sawsangnaw oun ccangpah bua,” a cipya. <verse number="2" style="v" />Jesu nynh minmin kha, “Saw na sang vae oh ze:</para>
  <para style="q1">‘Apang, na min sawtuanaw um sah.</para>
  <para style="q2">Na peenaw thua ccavae sah.</para>
  <para style="q1">
    <verse number="3" style="v" />Nin takyh kae aepaw looh kha</para>
  <para style="q2">nin takyhte oun pya.</para>
  <para style="q1">
    <verse number="4" style="v" />Kae tungvaw</para>
  <para style="q2">a sei hae paw miakaw kha</para>
  <para style="q1">kae ngaethya hae keiccu</para>
  <para style="q2">kae seinaw kha</para>
  <para style="q1">oun la ngaethyabua.</para>
  <para style="q2">Tuhounaw lungkhu lang</para>
  <para style="q1">oun cciakhae nan,’<note caller="+" style="f"><char style="fr" closed="false">11.4 </char><char style="ft" closed="false">Ccangpaw Ccathyaa hae kya tuh, ‘mihoy leipaw kyate oun khumtua,’ cite a bechih hae.</char></note> cite</para>
  <para style="q2">la ho oh,” a cipya hae.</para>
  <para style="s1">Ziraccyng Sanlou Ngiatu</para>
  <para style="p">
    <verse number="5" style="v" />Jesu nynh minmin kha, “Nanning lakuze lukhakheit nynh ruiban hoi zah ziraccyng khe a banpaw kalan cceih zah, ‘Ka ban, sanlou phe thum kae la koiibua hin. <verse number="6" style="v" />Pawccecize ka banpaw lu kheit tuh khua a ccongnaw kyate yn thua zah looh dang lanpaw ka hoi khyh,’ a cipya. <verse number="7" style="v" />Innthung te a banpaw nynh, ‘Mithyhmitpaw yn nung nan vae; thuakaw ka tou vae zah ka ccaaw hae ryte phe kae ih vae, ka tho ry vae khyh zah kae pya kho vae khyh,’ cite a khung cih. <verse number="8" style="v" />Nanning kae hopya oh, tuh-e paw nynh tho leite um zah a pya khyh zemah, a banpaw athua keiccu lungthang leite a ngiaku keiccu tuh a tho cih zah ahobou zeihte a pya cih.</para>
  <para style="s1">Ngia, Ccung, Khua</para>
  <para style="r">(<ref loc="MAT 7:7-11">Mat 7.7-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" />“Tukeiccuze kae hopya oh, ngia oh lah ae pya cih oh; ccung oh lah na muih cih oh; khua oh lah thuakaw kha hungpya na thua cih oh. <verse number="10" style="v" />Pawccecize a ngiapaw miakaw tuh a mue, a ccungpaw tuh a muih, thuakaw a khuapaw tuh hungpya athua cih. <verse number="11" style="v" />Nanning lakuze nae ccaaw nynh ngasaw ae ngiaku oh ze ngasaw hanpaw huparepaw a pyapaw a um cih tou? <verse number="12" style="v" />Tuhkhyhze awtui kha a ngiaku ze zekang kha a pya cih tou? <verse number="13" style="v" />Ccungccaw hoy leipaw mang na thua oh pite nae ccaaw hae kha lasung hoypaw pya lan na ny oh ze, vaawlang umpaw nae Paaw nynh amaw kalan a ngiakuh hae paw kha Thyaa Muisaw tuh houh a pya cih hae!” cite a hopya hae.</para>
  <para style="s1">Jesu te Beelzebul</para>
  <para style="r">(<ref loc="MAT 12:22-30">Mat 12.22-30</ref>; <ref loc="MRK 3:20-27">Mar 3.20-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" />Bya a hosah kho leipaw raerangsaro kha Jesu nynh a dee. Raerangsaro he a pou te byaho kho leipaw tuh bya a ho vae, te ccungccaw zapi tuh mih ngaeangthua. <verse number="15" style="v" />Thuasalama ccungccaw abang nynh, “Aning nynh raerangsaro hae uktupaw Beelzebul liate nynh raerangsaro hae kha a dee,” a ci hae.<note caller="-" style="x"><char style="xo" closed="false">11.15: </char><char style="xt" closed="false"><ref loc="MAT 9:34">Mat 9.34</ref>, <ref loc="MAT 10:25">10.25</ref></char></note> <verse number="16" style="v" />Abang nynh Jesu kha syntawtua khylan vaawlang e muihsahnaw kha a ngia hae.<note caller="-" style="x"><char style="xo" closed="false">11.16: </char><char style="xt" closed="false"><ref loc="MAT 12:38">Mat 12.38</ref>, <ref loc="MAT 16:1">16.1</ref>; <ref loc="MRK 8:11">Mar 8.11</ref></char></note> <verse number="17" style="v" />Thuasalama Jesu nynh mih tuanaw kha phe nyh zah minmin kha, “Amaw te amaw aphiakuhpaw peenaw miakaw tuh aroh cih, te amaw te amaw aphiakuhpaw innbyn tuh a khuliakuh cih. <verse number="18" style="v" />Satan mah amaw te amaw a phiaku ze pawtemou a peenaw tuh atyn kho cih? Pawccecize nanning nynh kae kha Beelzebul liate nynh raerangsaro hae a dee nae ci oh. <verse number="19" style="v" />Kae nynh Beelzebul liate raerangsaro hae kha ka dee lanze, hum liate mou nae ccungccaw hae nynh minmin kha a dee hae? Tukeiccuze minmin tuh nanning bya ae piatu oh athua cih hae. <verse number="20" style="v" />Thuasalama kae nynh Pachia kuihdung liate raerangsaro hae kha ka dee lanze, Pachia peenaw tuh nae kya a thua ccaccing vae. <verse number="21" style="v" />A thawsaepaw ccungccaw nynh zunghe phe ccing lante a inn kha a ngaw lya tuh a uccaw hae akhyn. <verse number="22" style="v" />Thuasalama amaw laeze a thawsae huapaw nynh amaw kha a dou zetuh a tae cih, te a doliakupaw a zunghe balyn kha a lawpah cih zah a luapaw uccaw hae kha pong a nee cih. <verse number="23" style="v" />Kae yn pankhae leipaw tuh kae yn rawsepaw nynh thua, te ka kya a sueluakuh bua leipaw ccungccaw tuh a phiakuhpaw nynh thua.<note caller="-" style="x"><char style="xo" closed="false">11.23: </char><char style="xt" closed="false"><ref loc="MRK 9:40">Mar 9.40</ref></char></note></para>
  <para style="s1">Athyaa leipaw Muisaw Kithuinaw</para>
  <para style="r">(<ref loc="MAT 12:43-45">Mat 12.43-45</ref>)</para>
  <para style="p">
    <verse number="24" style="v" />“Athyaa leipaw muisaw nynh ccungccapaw kyate he a pou te, umnaw hmin zahku lan ramrou kalan a khiakuh, thuasalama muihkuh khyh. Tetuh aning nynh, ‘Ka poutawnaw ka inn lang ka ki cih,’ a ci. <verse number="25" style="v" />He a kithui tuh tuh-e inn tuh phe la phikuh zah ccynmamyh lan a ccawnghanpaw kha a muih. <verse number="26" style="v" />Tetuh aning nynh cceih zah amaw laeze houh athahhua hae paw ccangpaw muisaw lu sari kha a hoeibua hae, te minmin nynh tee hae zah tuh-e paw kya a um hae; te tuh-e ccungccapaw tuh nyalang e a cyisahnaw tuh langmaw a cyisahnaw laeze houh athahhua vae,” cite a hopya hae.</para>
  <para style="s1">Lungtuanaw Ccaccing</para>
  <para style="p">
    <verse number="27" style="v" />Jesu nynh tuh-e bya a ho cciamang lyakhe ccungccaw zapi laku te nopinung lu kheit nynh sia zah Jesu kha, “Nang ae poipaw vue te nang ae kuapaw matei tuh lungtuapaw nynh thua!” a cipya. <verse number="28" style="v" />Thuasalama Jesu nynh, “Pachia bya kha thae zah a zui hae paw hynh nynh lungtuapaw athuahua hae!” a ci.</para>
  <para style="s1">Jonah Muihsahnaw</para>
  <para style="r">(<ref loc="MAT 12:38-42">Mat 12.38-42</ref>)</para>
  <para style="p">
    <verse number="29" style="v" />Ccungccaw hae houhouh oun lungthung hae te, Jesu nynh, “E ccungccaw hae tuh ahoy leipaw ciihan nynh thua hae; minmin nynh muihsahnaw kha a ngia hae; thuasalama Jonah kya-e muihsahnaw laelan ccangpaw muihsahnaw kha pya thua vae lan khyh hae.<note caller="-" style="x"><char style="xo" closed="false">11.29: </char><char style="xt" closed="false"><ref loc="MAT 16:4">Mat 16.4</ref>; <ref loc="MRK 8:12">Mar 8.12</ref></char></note> <verse number="30" style="v" />Pawccecize Jonah tuh Nineveh hae hanlan muihsahnaw athua hawte, Ccungccaw Ccapaw mah e ccungccaw hae hanlan muihsahnaw athua cih.<note caller="-" style="x"><char style="xo" closed="false">11.30: </char><char style="xt" closed="false"><ref loc="JON 3:4">Jon 3.4</ref></char></note> <verse number="31" style="v" />Byapianaw kya Alia lang e siapharannung tuh e she kya-e ccungccaw hae ryte yn thadyn cih zah minmin kha yn seisah cih hae, pawccecize aning tuh laephi athangnaw langte Solomon hawnaw bya kha ngae khylan yn thua; te dotua, Solomon laeze alesae huapaw tuh hein kya mang um!<note caller="-" style="x"><char style="xo" closed="false">11.31: </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1Si 10.1-10</ref>; <ref loc="2CH 9:1-12">2Sh 9.1-12</ref></char></note> <verse number="32" style="v" />Nineveh khuaccaaw hae tuh e she kya-e ccungccaw hae ryte byapianaw kya oun thadyn cih hae zah, e she kya-e ccungccaw hae kha oun seisah cih hae, pawccecize minmin tuh Jonah phunghonaw kya a ngaesikuh hae, te dotua, Jonah laeze alesae huapaw tuh hein kya mang um!<note caller="-" style="x"><char style="xo" closed="false">11.32: </char><char style="xt" closed="false"><ref loc="JON 3:5">Jon 3.5</ref></char></note></para>
  <para style="s1">Pyn kya-e Maeekhua</para>
  <para style="r">(<ref loc="MAT 5:15">Mat 5.15</ref>, <ref loc="MAT 6:22-23">6.22-23</ref>)</para>
  <para style="p">
    <verse number="33" style="v" />“Humhung nynh mah maeekhua kha aw zah kee te khong boi khyh, oun tee hae paw nynh awnaw kha a muih ccaw hae cite maee awnawpaw vawlan nynh a nung.<note caller="-" style="x"><char style="xo" closed="false">11.33: </char><char style="xt" closed="false"><ref loc="MAT 5:15">Mat 5.15</ref>; <ref loc="MRK 4:21">Mar 4.21</ref>; <ref loc="LUK 8:16">Luk 8.16</ref></char></note> <verse number="34" style="v" />Pyn kya-e awnaw tuh mit nynh thua, tukeiccuze na mit ahoy ze na pyn balyn mah awnaw te abeih cih, thuasalama na mit ahoy khyh ze, na pyn balyn mah mohnaw te abeih cih. <verse number="35" style="v" />Tukeiccuze na kya umpaw awnaw tuh mohnaw athua khyh nawlan la raeringkuh. <verse number="36" style="v" />Na pyn balyn tuh mohnaw um leite awnaw te phe abia lanze, maeekhua a awpaw nynh awnaw ae pya hawte, na pyn balyn tuh awnaw te phe abeih cih,” a ci.</para>
  <para style="s1">Jesu nynh Farasi hae A Pe hae</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mat 23.1-36</ref>; <ref loc="MRK 12:38-40">Mar 12.38-40</ref>)</para>
  <para style="p">
    <verse number="37" style="v" />Tuhcite bya a ho lyakhe, Farasipaw lu kheit nynh Jesu kha aepaw a kopya; Jesu tuh cceih zah ae lan a haung. <verse number="38" style="v" />Zerya a ae mawze a kuih a singku ty khyhpaw kha Farasipaw nynh he a muih tuh a ngaeangthua. <verse number="39" style="v" />Bawipaw nynh, “Nanning Farasi hae tuh banang te pake kha avawlan kyalya nynh na sing oh, thuasalama nae lungkhu tuh karankunaw te hoyleinaw te nynh phe abia. <verse number="40" style="v" />Nanning mingaee hae! Avawlan a raetu nynh alungkhu kha mah raebia khyh tou? <verse number="41" style="v" />Tukeiccuze alungkhu umpaw uccaw hae kha ryachi hae pyabua oh lah, pawpaw balyn tuh nae hanlan athyaa cih.</para>
  <para style="p">
    <verse number="42" style="v" />“Thuasalama Farasi hae, nae hanlan ngaethya lan kou um! Pawccecize nanning nynh hangmae te pucinan te enaw phuin hae balyn kha pumhaw pumkheit na pya oh zah, Pachia byading te a sungsahnaw kha na sawphah oh; ccangpaw kha sawphah leite, hynh-e hae hynh mah na cyi lan oh paw nynh thua.<note caller="-" style="x"><char style="xo" closed="false">11.42: </char><char style="xt" closed="false"><ref loc="LEV 27:30">Lev 27.30</ref></char></note> <verse number="43" style="v" />Farasi hae, nae hanlan ngaethya lan kou um! Pawccecize nanning tuh sinakok kya ahoy huapaw haungnaw kha na ry oh zah kungkunaw kya sawtuate byabeihku na ry oh. <verse number="44" style="v" />Kawbya sazae hae te Farasi hae, thyaruh hae, nae hanlan ngaethya lan kou um! Pawccecize nanning tuh alang leipaw shawku hae te nynh na loku oh. Ccungccaw hae nynh tuh-e shawku hae kha nyh khyh hae zah avawlan khe a ccia hae,” a cipya.</para>
  <para style="p">
    <verse number="45" style="v" />Kawbya thya hae paw kyaze lukheitpaw nynh, “Sazae, tuhte he na ho tuh kaening hynh mah nae saryabua vae,” a cipya. <verse number="46" style="v" />Jesu nynh, “Nanning kawbya thya hae paw mah, nae hanlan ngaethya lan kou um! Pawccecize nanning nynh myarya ripaw phupaw kha ccungccaw hae tungvaw na khang oh zah naemaw tuh nae kuihdung te san na hae ry khyh oh. <verse number="47" style="v" />Nanning hanlan ngaethya lan kou um! Pawccecize nae minpaaw hae nynh a chia hae paw profeh hae elang shawku kha na raepya oh. <verse number="48" style="v" />Nae minpaaw hae nynh a cyi hae paw kha nae nawccah zah ccaekia na khan oh; pawccecize minmin nynh profeh hae kha theih hae zah nanning nynh mih shawku hae kha na raepya oh. <verse number="49" style="v" />Tukeiccuze Pachia Hawnaw nynh, ‘Minmin kalan profeh hae te locceihtu hae kha ka saw cih hae; minmin nynh abang kha a theih cih hae zah abang kha a tuaa a sah cih hae,’ a ci. <verse number="50" style="v" />Tukeiccuze laephi athonaw aleihpaw kyate aluapaw profeh hae chiise balyn mee kha hynh-e ciihan hae kya ngia athua cih. <verse number="51" style="v" />Abel chiise kyate tho zah silawhang te beikinnthyaa laku kya a chia hae paw Zekhariah chiise kyacia ngia athua cih hae. Byaccaccing kae hopya oh, tuh-e tuh e ccungccaw hae kya ngia athua cih.<note caller="-" style="x"><char style="xo" closed="false">11.51: </char><char style="xt" closed="false"><ref loc="GEN 4:8">Gen 4.8</ref>; <ref loc="2CH 24:20-21">2Sh 24.20-21</ref></char></note> <verse number="52" style="v" />Kawbya thya hae paw, nae hanlan ngaethya lan kou um! Pawccecize nanning nynh hawnaw tohccung kha na kyng oh zah, naemaw mah na tee khyh oh, a tee ry hae paw kha mah na khee oh,” a ci.</para>
  <para style="p">
    <verse number="53" style="v" />Tuin kyate Jesu tuh he a pou te, kawbya sazae hae te Farasi hae nynh bya patae yn hosei ccaw cite Jesu kha thinriasah khylan bya patae a khia hae. <verse number="54" style="v" />A munglae kyate yn toikuhpaw kha kyngpya lan zah seibe lan cite amaw kha phang a dokhaw hae.</para>
  <chapter number="12" style="c" />
  <para style="s1">Thyaruh hae Raeringnaw Pyanaw</para>
  <para style="p">
    <verse number="1" style="v" />Ccungccaw patae nynh lu kheit te lu kheit sydeku ciate athong athongte oun pumku lya hae khe, Jesu nynh a zuitu hae kha, “Farasi hae nynh a thyaruhnaw hae paw mih ransi kha la raeringkuh oh.<note caller="-" style="x"><char style="xo" closed="false">12.1: </char><char style="xt" closed="false"><ref loc="MAT 16:6">Mat 16.6</ref>; <ref loc="MRK 8:15">Mar 8.15</ref></char></note> <verse number="2" style="v" />Pawccecize alangkuh lei lante thuruhpaw miakaw kha langsah athua cih zah, khongpaw miakaw kha hungpya athua cih.<note caller="-" style="x"><char style="xo" closed="false">12.2: </char><char style="xt" closed="false"><ref loc="MRK 4:22">Mar 4.22</ref>; <ref loc="LUK 8:17">Luk 8.17</ref></char></note> <verse number="3" style="v" />Tukeiccuze amohnaw kya na ho oh paw byaru miakaw kha a awnaw kya thae athua cih; inn lungkhu thuakaw khawsungkute na hoku oh paw byaru miakaw kha innccukaly kyate siakhae athua cih.</para>
  <para style="s1">Hummou Ri lan</para>
  <para style="r">(<ref loc="MAT 10:28-33">Mat 10.28-33</ref>)</para>
  <para style="p">
    <verse number="4" style="v" />“Ka ban oh, kae hopya oh, pyn kha theih hae zah tukoute pawsang a cyih kho lei vae hae paw raw kha rih nan oh. <verse number="5" style="v" />Thuasalama hummou ri lan accan cipaw kae hopah cih oh; pyn a theih koute hell lungkhu lang vuanaw kaw a hoitupaw raw kha rih oh. Athua, amaw raw kha rih oh cite kae hopya oh! <verse number="6" style="v" />Rithya sa pangaw kha phuapia pia ning lang a zua hae khaw? Tuh-e rithya sa kheit sanmah Pachia nynh ning khyh. <verse number="7" style="v" />Nae lu kya-e nae sangrua heize marya ria athua. Tukeiccuze rih nan oh; nanning tuh rithya hae patae laeze na sunghua oh.</para>
  <para style="s1">Khri Kong Nawccawnaw te Einaw</para>
  <para style="r">(<ref loc="MAT 10:32-33">Mat 10.32-33</ref>, <ref loc="MAT 12:32">12.32</ref>, <ref loc="MAT 10:19-20">10.19-20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" />“Nanning kae hopya oh, humhung zemah ccungccaw hae malang kae kha ccaekia yn khanpaw tuh, Ccungccaw Ccapaw nynh Pachia vaaw hae malang khe tuh-e paw tuh ccaekia a khanru cih. <verse number="9" style="v" />Thuasalama ccungccaw hae malang kae kha yn vuapaw tuh Pachia vaaw hae malang khe vuaru athua cih. <verse number="10" style="v" />Humhung zemah Ccungccaw Ccapaw rawsete bya kaw kheit a hopaw tuh ngaethya athua cih; thuasalama Thyaa Muisaw kha rawsete a saryapaw ccungccaw tuh ngaethya thua lan khyh.<note caller="-" style="x"><char style="xo" closed="false">12.10: </char><char style="xt" closed="false"><ref loc="MAT 12:32">Mat 12.32</ref>; <ref loc="MRK 3:29">Mar 3.29</ref></char></note> <verse number="11" style="v" />Nanning kha sinakok hae, uktu hae te kawhoitu hae kalan ae thuakhae oh ze pawtemou ka khung cih, pawmou ka ho cih cipaw nae lungvawsaw nan sah.<note caller="-" style="x"><char style="xo" closed="false">12.11-12: </char><char style="xt" closed="false"><ref loc="MAT 10:19-20">Mat 10.19-20</ref>; <ref loc="MRK 13:11">Mar 13.11</ref>; <ref loc="LUK 21:14-15">Luk 21.14-15</ref></char></note> <verse number="12" style="v" />Pawccecize Thyaa Muisaw nynh tuh-e ccyh ccaccei kyakhe na ho lan oh paw kha ae ccangpah cih oh,” cite a hopya hae.</para>
  <para style="s1">Mihoipaw Tousenaw</para>
  <para style="p">
    <verse number="13" style="v" />Ccungccaw zapi kyate lukheitpaw nynh Jesu kha, “Sazae, rho yn neebua nawlan ka upaw hynh hopah,” a cipya. <verse number="14" style="v" />Jesu nynh, “Ccungccapaw, hum nynh mou kae hynh nanning laku kya byapiatu lang, tuhkhyhze rho neetu lang yn nung?” a cipya. <verse number="15" style="v" />Jesu nynh, “Karankunaw aphuinphuin kha raeringkuh oh lah sibia oh; pawccecize ccungccaw lu kheit hiinnaw tuh a hoipaw uccaw patae kyakhe um khyh,” a cipya hae. <verse number="16" style="v" />Jesu nynh minmin kha tousenaw phungpaw ccangkheit a hopya hae: “Mihoipaw lu kheit um zah a laephi kya looh myarya avoi. <verse number="17" style="v" />A thinlung kya tuakuh zah, ‘Pawmou ka cyih cih, ka looh nungnaw um vae khyh,’ a ciku. <verse number="18" style="v" />‘Hynhte ka cyih cih: ka ccung-inn hae kha ka phou cih zah alehua lante ka sak cih; tuin kya ka looh hae te ka uccaw hae balyn kha ka nung cih. <verse number="19" style="v" />Tuinte kamaw te kamaw kha, “Mihoipaw, nang tuh kum patae hanlan uccaw patae kha ccakhungpya na thua vae; hung um ccavae, ae lah neih, lungtua lungpawte um,” ka cikuh cih,’ a ci. <verse number="20" style="v" />Thuasalama Pachia nynh tuh-e paw tuh, ‘Mingaeepaw! Atu khuazi ccaccei maw na hiinnaw kha law athua cih; na ccakhungpaw uccaw hae kha hum elang mou a tang cih?’ a cipya. <verse number="21" style="v" />Tukeiccuze mimaw hanlan sisua ccakhungkuh hae salamah Pachia muihnaw kya a ryachi hae paw tuh tuh-e paw hawte nynh athua hae,” a ci.</para>
  <para style="s1">Lungvawsawnaw</para>
  <para style="r">(<ref loc="MAT 6:25-34">Mat 6.25-34</ref>)</para>
  <para style="p">
    <verse number="22" style="v" />Jesu nynh a zuitu hae kha, “Tukeiccuze kae hopya oh, pawmou ka ae cih cite thuasah, nae pyn hanlan paw boeining mou ka lawkuh cih cite thuasah nae hiinnaw hanlan nae lungvawsaw nan sah. <verse number="23" style="v" />Pawccecize hiinnaw tuh aepaw laeze sunghua zah pyn tuh boeining laeze asunghua. <verse number="24" style="v" />Va-aw hae kha tuatua oh: minmin tuh ccacii vuakuh khyh hae zah looh mah rue khyh hae, sisuainn thuasah, byng thuasah hoi khyh hae, thuasalama Pachia nynh minmin kha looh a dang hae, nanning tuh pavaw hae laeze patae na sunghua oh khaw! <verse number="25" style="v" />Nanning lakuze hummou a lungvawsawnaw liate a hiinnaw ccyh kha ccapyh san a saesakuh khopaw a um? <verse number="26" style="v" />Tuhcite adih huapaw uccaw san na cyihkuh kho khyh oh lanze, pawccemou ccangpaw uccaw hanlan nae lungvawsaw? <verse number="27" style="v" />Lili paw hae hynh pawcihte nynh a lethung hae cipaw kha tuatua oh; minmin tuh loopho khyh hae, laaw mah sukuh khyh hae; tuhzemah kae hopya oh, myarya a hoirumpaw Solomon nynh heize lili paw pawkheit tuhte apuithya lan ccaankuh kho khyh.<note caller="-" style="x"><char style="xo" closed="false">12.27: </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">1Si 10.4-7</ref>; <ref loc="2CH 9:3-6">2Sh 9.3-6</ref></char></note> <verse number="28" style="v" />Tukeiccuze, pou zyn zya hae, atunin hiin zah awkhualan takuamaee lungkhu lang phung athuapaw ramkaw e lonua kha heize Pachia nynh tuhte a ccaan lanze, nanning kha tuh-e laeze houh ae ccaan lan khyh oh tou! <verse number="29" style="v" />Pawmou kae ae cih, pawmou kae neih cih cite ccung nan oh; lungriathaete mah um nan oh. <verse number="30" style="v" />Pawccecize laephi vaw e minphuin hae nynh e uccaw hae balyn hynh leih a ccung hae, nae Paaw nynh e uccaw hae hynh nae hanlan aho cipaw phe a ny. <verse number="31" style="v" />Pachia peenaw kha ccung oh lah, e uccaw hae tuh pyachih na thua cih oh.</para>
  <para style="p">
    <verse number="32" style="v" />“Tuuphu taraw hae, rih nan oh; pawccecize peenaw kha nanning pya lanpaw tuh nae Paaw a lungrypaw nynh thua. <verse number="33" style="v" />Na hoi oh paw kha zua oh lah, ryachi hae kha pyabua oh, apue kho leipaw phuabu kha raekuh oh, miruh nynh a thuanua kho leinaw te laehaw nynh a ro kho leinaw vaawlang khua khe athang kho leipaw sisua kha ccykuh oh. <verse number="34" style="v" />Pawccecize nae sisua umnaw kya nae thinlung mah a umbua cih.</para>
  <para style="s1">A Raeringkuhpaw See hae</para>
  <para style="p">
    <verse number="35" style="v" />“Nae taeccia kha cciakuh oh lah, nae maeekhua kha awkuh oh.<note caller="-" style="x"><char style="xo" closed="false">12.35: </char><char style="xt" closed="false"><ref loc="MAT 25:1-13">Mat 25.1-13</ref></char></note> <verse number="36" style="v" />Zudy poi kyate mih bawipaw yn ki zah thuakaw he yn khua te, palou hungpya khylan a ngaw hae paw see hae hawte la um oh.<note caller="-" style="x"><char style="xo" closed="false">12.36: </char><char style="xt" closed="false"><ref loc="MRK 13:34-36">Mar 13.34-36</ref></char></note> <verse number="37" style="v" />Mih bawipaw tuh yn ki zah phang a ngaw hae paw see hae kha a muih ze, tuh-e see hae tuh lungtua hae paw nynh thua; byaccaccing kae hopya oh, mih bawipaw nynh taeccia a cciakuh cih zah minmin kha ccaboi kya a koihsah cih hae, te amaw ccaccei nynh looh a dang cih hae. <verse number="38" style="v" />Mih bawipaw tuh ziraccyng khyhze tuhlae nyathya lante zemah yn ki zah minmin kha tuhcite a muih hae ze, tuh-e see hae tuh lungtua hae paw nynh thua.</para>
  <para style="p">
    <verse number="39" style="v" />“Thuasalama e hynh nyh oh: inn hoitupaw nynh miruh yn thua lanpaw ccyh kha a nyty lanze a inn kha kiasah bia lan khyh.<note caller="-" style="x"><char style="xo" closed="false">12.39-40: </char><char style="xt" closed="false"><ref loc="MAT 24:43-44">Mat 24.43-44</ref></char></note> <verse number="40" style="v" />Nanning mah raeringkute um oh; pawccecize na tua khyh oh ccyh lyakhe Ccungccaw Ccapaw tuh yn thua cih,” a cipya hae.</para>
  <para style="s1">See Phuin Ning</para>
  <para style="r">(<ref loc="MAT 24:45-51">Mat 24.45-51</ref>)</para>
  <para style="p">
    <verse number="41" style="v" />Peter nynh, “Bawipaw, e tousenaw phungpaw hynh kaening hanlan tou na ho, tuhkhyhze ccungccaw miakaw hanlan tou?” cite a khia. <verse number="42" style="v" />Bawipaw nynh, “Accyh zaw vae ze mih hanpaw looh neesah lan te a see hae a uktu lang cite a bawipaw nynh a khang lanpaw a lungzipaw te a hawpaw synriatu tuh hummou athua? <verse number="43" style="v" />Tuhte rya a lawpaw kha a bawipaw nynh yn thua zah a muihpyapaw see tuh lungtuapaw nynh thua. <verse number="44" style="v" />Byaccaccing kae hopya oh, a bawipaw nynh tuh-e see tuh a uccaw balyn a do-oihtu lang a nung cih. <verse number="45" style="v" />Thuasalama tuh-e see nynh, ‘Ka bawipaw yn thuanaw ccyh tuh aro ung cih,’ cite a lungkaw te tua zah, ccangpaw see pise hae te nopi hae kha bua hae zah, aete niate a rui; <verse number="46" style="v" />tuh-e see nynh a tua khyh lya te a ny khyh lyakhe a bawipaw tuh yn thua lanze, tuh-e paw tuh thoh a pae cih zah mih lungzi lei hae paw ryte a nungkheih cih hae. <verse number="47" style="v" />A bawipaw rynaw kha mang a nyh pite a paccynkuh leipaw te a bawipaw rynaw a cyipah leipaw see tuh ccungbua patae a mue cih. <verse number="48" style="v" />Thuasalama a bawipaw rynaw kha ny leite, ccungbua mue lan accanpaw rya a lahseipaw see tuh ccungbua ccapyh nynh a mue cih. Pawccecize patae pya athuapaw ccungccaw tuh patae a sangru cih; patae a ccysah hae paw ccungccaw tuh patae a ngiaru cih hae.</para>
  <para style="s1">Daenaw, Phiakunaw</para>
  <para style="r">(<ref loc="MAT 10:34-36">Mat 10.34-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" />“Kae tuh laephi vawlan maee ruasah khylan nynh kae thua; atumaw maee rua ccavae sah ci nynh ka ry! <verse number="50" style="v" />Baptisma in lanpaw ka hoi ung, tuh-e accing mawlaezung tuh myarya ka lungriathae!<note caller="-" style="x"><char style="xo" closed="false">12.50: </char><char style="xt" closed="false"><ref loc="MRK 10:38">Mar 10.38</ref></char></note> <verse number="51" style="v" />Laephi vawlan daenaw thuakhae khylan nynh yn thua cite tou na tua oh? Nanning kae hopya oh, tuhte thua khyh; phiakunaw thuakhae khylan nynh kae thua! <verse number="52" style="v" />Atu ccyh kyate lu pangaw a um hae paw innbyn kya phiakunaw a um cih zah lu thum nynh lu ning kha a rawse cih zah, lu ning nynh lu thum kha a rawse cih.</para>
  <para style="q1">
    <verse number="53" style="v" />Paaw nynh ccapaw kha</para>
  <para style="q2">a rawse cih zah ccapaw nynh</para>
  <para style="q1">paaw kha a rawse cih;</para>
  <para style="q2">nung nynh ccanung kha</para>
  <para style="q1">a rawse cih zah ccanung nynh</para>
  <para style="q2">nung kha a rawse cih;</para>
  <para style="q1">ninnung nynh monung kha</para>
  <para style="q2">a rawse cih zah monung nynh</para>
  <para style="q1">ninnung kha a rawse cih,” a ci.<note caller="-" style="x"><char style="xo" closed="false">12.53: </char><char style="xt" closed="false"><ref loc="MIC 7:6">Mik 7.6</ref></char></note></para>
  <para style="s1">Ccyh Muihsahnaw</para>
  <para style="r">(<ref loc="MAT 16:1-4">Mat 16.1-4</ref>)</para>
  <para style="p">
    <verse number="54" style="v" />Jesu nynh ccungccaw zapi kha mah, “Niccaw langte maeking yn pouthungpaw kha na muih vae oh ze, ‘Khuaa yn rah cih,’ na ci oh zah khuaa arah sasaw. <verse number="55" style="v" />Alia langte khisan yn zawpaw kha na muih vae oh ze, ‘Khuanin yn so cih,’ na ci oh zah khuanin aso sasaw. <verse number="56" style="v" />Cyihruh hae! Vaawlui te laephi kha na do oh zah asuilan na thaethya oh; thuasalama pawccemou atu e ccyh umtuzia hynh na thaethya khyh oh?</para>
  <para style="s1">Nae Rhawpaw te Ccawkuh Oh</para>
  <para style="r">(<ref loc="MAT 5:25-26">Mat 5.25-26</ref>)</para>
  <para style="p">
    <verse number="57" style="v" />“Pawccemou naemaw ccaccei nynh ahmepaw kha cyi lan bya na paeku khyh oh? <verse number="58" style="v" />Nang ae rawsetupaw ryte byapiatu kalan na cciakheih lya oh laanpi kyakhe, ccawku kho nawlan thawte la zuakuh; tuhkhyhze tuh byapiatu kalan ae cciakhae cih zah byapiatu nynh thong uktu kalan ae ap cih, te thong uktu nynh thong ae saw cih. <verse number="59" style="v" />Nang kae hopya, na rung lanpaw phuapia kha phe ccing lan na pya mawlaezung thonginn kyate na pou lan khyh,” cite a hopya hae.</para>
  <chapter number="13" style="c" />
  <para style="s1">Ngaesikunaw</para>
  <para style="p">
    <verse number="1" style="v" />Tuh ccyh lyakhe abang ccungccaw hae nynh Jesu kyakhe Pilat nynh Galilee hae chiise kha si a lawnaw hae paw ryte pong a pydepaw kong kha a hopya hae. <verse number="2" style="v" />Jesu nynh, “Tuh-e Galilee hae tuh tuhte a teing hae keiccuze ccangpaw Galilee hae balyn laeze a seihua hae paw cite tou na tua oh? <verse number="3" style="v" />Seihua khyh hae, nanning kae hopya oh; na ngaesiku khyh oh ze, tuh-e hawte marya na chih cih oh. <verse number="4" style="v" />Tuhkhyhze, Siloam kya innhangpaw nynh tingthin hae zah a chih hae paw lu haw lae tarya hae kha ccangpaw Jerusalem khuaccaaw hae balyn laeze a seihua hae paw cite tou na tua oh? <verse number="5" style="v" />Seihua khyh hae, nanning kae hopya oh; na ngaesiku khyh oh ze, tuh-e hawte marya na chih cih oh,” a cipya hae.</para>
  <para style="s1">Athae leipaw Thaeku Tousenaw</para>
  <para style="p">
    <verse number="6" style="v" />Jesu nynh e tousenaw phungpaw hynh mah a ho: “Ccungccapaw lu kheit nynh a misu khokhu kyakhe thaeku ku kheit a lin; yn cceih zah tuh-e ku kya athae kha ccung zah muih khyh. <verse number="7" style="v" />Misu khokhu ngawtupaw kha, ‘Dotua, kum thum cia hynh-e thaeku ku kalan kae cceih zah athae ka ccung zah ka muih khyh; nge ccavae; pawlangmou laephi hynh a thangsah han?’ cite a hopya. <verse number="8" style="v" />Khokhu ngawtupaw nynh, ‘Sazae, kum kheit sankaw tuh hynhmawte um hin sah, a pepan kya laephi ka thualeihpah cih zah lae hoy ka pumnua ung cih. <verse number="9" style="v" />Khuavae kya athae yn thae ze ahoy; yn thae vae khyh ze na nge vae cih,’ a cipya,” a cipya.</para>
  <para style="s1">Sabbath Nin Nopinung A Dansah</para>
  <para style="p">
    <verse number="10" style="v" />Jesu nynh sabbath nin kya sinakok ccangkheit kyakhe a ccangpya hae. <verse number="11" style="v" />Tuin kyakhe muisaw hoyleipaw nynh kum haw lae tarya cia a ngoisahpaw nopinung lu kheit a um; tuh-e nung tuh a ke ky zah lawbabin lan umthya khyh. <verse number="12" style="v" />Jesu nynh tuh-e nung tuh he a muih te ko zah, “Nopinung, na ccinaw kyate na lue vae,” a cipya. <verse number="13" style="v" />Tuh-e nung tungvaw a kuih he a khang te, a ke tuh vaekheihmawte yn law zah Pachia kha the a hoysah. <verse number="14" style="v" />Tuhte Jesu nynh sabbath nin kya a dansah keiccuze sinakok uktupaw nynh a thinria zah ccungccaw hae kyakhe, “Ryalaw lawku nin nintaruh a um, tuh-e nin hae kyakhe oun cceih oh lah dannaw mue oh, sabbath nin kya tuh mue nan oh,” a cipya hae.<note caller="-" style="x"><char style="xo" closed="false">13.14: </char><char style="xt" closed="false"><ref loc="EXO 20:9-10">Exo 20.9-10</ref>; <ref loc="DEU 5:13-14">Deu 5.13-14</ref></char></note> <verse number="15" style="v" />Bawipaw nynh khung zah, “Thyaruh hae! Nanning lu kheit cci nynh sabbath nin kya nae tangnuapaw khyhze nae lann kha a inn kyate na supah oh zah tui nia lan na cciakhae khyh oh tou? <verse number="16" style="v" />Kum haw lae tarya cia Satan nynh phang a heepaw, Abraham ccanung athuapaw, e nopinung hynh hynh-e heenaw kyate sabbath nin kya luesah lan ccan khyh tou?” a cipya. <verse number="17" style="v" />Hynhte he a ho tuh, amaw a rawsetu hae balyn tuh maethya pong bongkuh hae; ccungccaw hae balyn tuh Jesu nynh a raepaw ngaeangnaw keiccuze mih lungtua.</para>
  <para style="s1">Mungngia Cii Tousenaw</para>
  <para style="r">(<ref loc="MAT 13:31-32">Mat 13.31-32</ref>; <ref loc="MRK 4:30-32">Mar 4.30-32</ref>)</para>
  <para style="p">
    <verse number="18" style="v" />Jesu nynh, “Pachia peenaw tuh pawtemou aloku? Pawtemou ka touse cih? <verse number="19" style="v" />Ccungccapaw lu kheit nynh lawkuh zah a khokhu lungkhu lang a vuapaw mungngia cii te nynh aloku; tuh-e acii tuh lethung zah akupi lang yn tang, te vaawlang e pavaw hae nynh aran hae kyakhe bu a luaku hae,” a ci.</para>
  <para style="s1">Ransi Tousenaw</para>
  <para style="r">(<ref loc="MAT 13:33">Mat 13.33</ref>)</para>
  <para style="p">
    <verse number="20" style="v" />Jesu nynh bua ho zah, “Pachia peenaw tuh pawtemou ka touse cih? <verse number="21" style="v" />Hynh-e te nynh aloku. Nopinung lu kheit nynh ransi kha lah zah vaepoi ke kethum kya a phing, tuh-e vaepoi a thosahpaw ransi te nynh aloku,” a ci.</para>
  <para style="s1">Abypaw Koikua</para>
  <para style="r">(Mat 7.13-14, 21-23)</para>
  <para style="p">
    <verse number="22" style="v" />Jesu nynh Jerusalem lang khua a ccong lyakhe khuapi hae te khua taraw hae kalan po cceihpaw zah a ccangpya hae. <verse number="23" style="v" />Ccungccaw lu kheit nynh, “Bawipaw, beihtaraw kyalya tou khumnaw a mue cih hae?” cite a khia. Jesu nynh minmin kha, <verse number="24" style="v" />“Abypaw koikua kyate tee lan zuakuh oh; pawccecize, kae hopya oh, ccungccaw patae nynh tuh-e kya tee lan oun zuakuh cih hae zah tee kho lan khyh hae. <verse number="25" style="v" />Inn hoitupaw nynh vaekheit thokuh zah thuakaw kha phe a khaw koute, nanning nynh atolang khe thadynte thuakaw kha na khua oh zah, ‘Bawipaw, thuakaw oun hungpah,’ na ci oh; aning nynh nanning kha, ‘Paw kyate nae thua oh paw cipaw kae nynh khyh oh,’ ae cipah cih oh. <verse number="26" style="v" />Nanning nynh, ‘Namaw ryte ah ae ah neihkheih oh paw khaw! Kae khua laanpi kya balyn nae ccangpah khaw!’ nae ci cih oh. <verse number="27" style="v" />Thuasalama aning nynh, ‘Paw kyate nae thua oh paw cipaw kae nyh khyh oh; nanning hoyleinaw a raetu hae, ka kyate cceih oh,’ ae cipah cih oh.<note caller="-" style="x"><char style="xo" closed="false">13.27: </char><char style="xt" closed="false"><ref loc="PSA 6:8">Sam 6.8</ref></char></note> <verse number="28" style="v" />Nanning nynh Abraham, Isak te Jakob te profeh hae balyn kha Pachia peenaw kya na muih oh zah naemaw tuh atolang dae vua na thua oh paw kha he nae muih oh te, rawkhuinaw te hawzynaw oun um cih.<note caller="-" style="x"><char style="xo" closed="false">13.28: </char><char style="xt" closed="false"><ref loc="MAT 22:13">Mat 22.13</ref>, <ref loc="MAT 25:30">25.30</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">13.28-29: </char><char style="xt" closed="false"><ref loc="MAT 8:11-12">Mat 8.11-12</ref></char></note> <verse number="29" style="v" />Ccungccaw hae tuh nithua, niccaw, thahlang, deilang te oun thua cih hae zah Pachia peenaw kya oun haung cih hae. <verse number="30" style="v" />Nyathya hae paw kha masaty hae paw oun thua cih hae zah, masaty hae kha nyathya hae paw oun thua cih hae,” a ci.<note caller="-" style="x"><char style="xo" closed="false">13.30: </char><char style="xt" closed="false"><ref loc="MAT 19:30">Mat 19.30</ref>, <ref loc="MAT 20:16">20.16</ref>; <ref loc="MRK 10:31">Mar 10.31</ref></char></note></para>
  <para style="s1">Jerusalem hanlan A Ngaethah</para>
  <para style="p">
    <verse number="31" style="v" />Tuh ccyh lyakhe Farasi hae abang oun thua hae zah Jesu kha, “Hein kyate toikuh lah pou, pawccecize Herod nynh chia lan ae ry,” a cipya hae. <verse number="32" style="v" />Jesu nynh minmin kha, “Nanning la cceih oh lah tuh-e suizaw tuh, ‘Atunin te awkhualan tuh raerangsaro hae kha ka de cih hae zah ngeccih hae kha ka dansah cih hae. Tuinte nin thumnaw kya ka ryalaw ka thangsah cih,’ a ci cite la hopah oh. <verse number="33" style="v" />Tuhzemah atunin, awkhualan te sarukheih tuh solei ka cceih ung cih; pawccecize profeh lu kheit nynh Jerusalem atolang kya a chi lanpaw tuh thua kho khyh. <verse number="34" style="v" />Pou Jerusalem, Jerusalem, profeh hae kha na theih hae zah na kalan oun saw hae paw ccungccaw hae kha lung te na deih hae; awpinung nynh a taw hae kha a sake kaw a suelua hae hawte na ccaaw hae kha pynkheihlan suelua lan palei ka ry zah nang nynh na ry khyh! <verse number="35" style="v" />Dotua oh, na inn tuh a muahanpaw lang a tang cih; nang kae hopya, ‘Bawipaw min te yn thuapaw tuh lungtuapaw nynh thua!’ cite na ho mawlaezung nae muih vae lan khyh,” a cipya.<note caller="-" style="x"><char style="xo" closed="false">13.35: </char><char style="xt" closed="false"><ref loc="PSA 118:26">Sam 118.26</ref>; <ref loc="JER 22:5">Jer 22.5</ref></char></note></para>
  <chapter number="14" style="c" />
  <para style="s1">Tui A Poipaw A Dansah</para>
  <para style="p">
    <verse number="1" style="v" />Sabbath nin kya Jesu nynh aepaw ae lan Farasi lupipaw lu kheit inn lungkhu lang he a tee tuh minmin nynh a dophi hae. <verse number="2" style="v" />Tui poipaw ccinaw a hoipaw lu kheit tuh Jesu malang khe a um. <verse number="3" style="v" />Jesu nynh tho zah kawbya thya hae paw te Farasi hae kha, “Sabbath nin kya dansah lan accan tou?” cite a khia hae. <verse number="4" style="v" />Minmin tuh yccae khyh hae. Jesu nynh tuh-e paw tuh ko zah a dansah koute a cciasah. <verse number="5" style="v" />Jesu nynh minmin kha, “Nanning lakuze a ccaaw tuhkhyhze a vaetua kha sabbath nin kya tuisung lungkhu lang a ccaw ze palou a thy leipaw a um cih tou?” cite a khia hae.<note caller="-" style="x"><char style="xo" closed="false">14.5: </char><char style="xt" closed="false"><ref loc="MAT 12:11">Mat 12.11</ref></char></note> <verse number="6" style="v" />Minmin nynh e bya hynh mah khung kho khyh hae.</para>
  <para style="s1">Zakawsangsakunaw</para>
  <para style="p">
    <verse number="7" style="v" />Kopaw ccungccaw hae nynh ahoy huapaw haungnaw a poku hae paw kha Jesu nynh he a muih tuh, tousenaw phungpaw a hopya hae: <verse number="8" style="v" />“Lukhakheit nynh zudy poi kalan ae ko ze ahoy huapaw haungnaw kya la haung nan, nang laeze sawtuahua lan umpaw kha a la kobua ze,<note caller="-" style="x"><char style="xo" closed="false">14.8-10: </char><char style="xt" closed="false"><ref loc="PRO 25:6-7">Ptb 25.6-7</ref></char></note> <verse number="9" style="v" />nanning parouhte ae kotu oh paw nynh na kalan yn cceih cih zah, ‘E paw hynh na haungnaw kha pya,’ ae cipya ze, nang tuh maethyate ane huanaw hmin kya um lan yn ccan vae cih. <verse number="10" style="v" />Thuasalama nang kha ae kobua hae ze, cceih lah ane huanaw kyakhe la haung; tuhteze nynh nang ae kotupaw he yn thua te, ‘Ka ban, ahang huanaw langkhe haung,’ ae cipah cih; tetuh na haungkheih oh paw malang khe sawtuanaw na mue vae cih. <verse number="11" style="v" />Pawccecize humhung zemah amaw te amaw a hangsakuhpaw tuh sawbung athua cih zah, amaw te amaw zakaw a sangsakuhpaw tuh hangthung athua cih,” a ci.<note caller="-" style="x"><char style="xo" closed="false">14.11: </char><char style="xt" closed="false"><ref loc="MAT 23:12">Mat 23.12</ref>; <ref loc="LUK 18:14">Luk 18.14</ref></char></note></para>
  <para style="p">
    <verse number="12" style="v" />Jesu nynh amaw a kotupaw kha mah, “Nang nynh awkhua loohdangkunaw tuhkhyhze zete loohdangkunaw na rae vae ze, na ban hae, na uno hae, na vaeccaw hae, a hoirumpaw innpaw hae kha la ko nan hae; tuhte na ko hae ze minmin nynh mah bua ae koru cih hae zah amee ae sangru cih hae. <verse number="13" style="v" />Thuasalama nang nynh poi na tua vae ze, ryachi hae, pyn kya-e accing lei hae paw, ccukhou hae te mitmoh hae kha la ko hae. <verse number="14" style="v" />Minmin nynh ae sangru kho lan khyh hae, tukeiccuze hythua ccoupaw na thua cih. Miding hae thoothuinaw kya amee sangru na thua cih,” a cipya.</para>
  <para style="s1">Loohdangkunaw Tousenaw</para>
  <para style="r">(<ref loc="MAT 22:1-10">Mat 22.1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" />Jesu ryte aenaw kya a haungkheih hae paw lu kheit nynh tuh-e bya tuh thae zah Jesu kha, “Pachia peenaw kya sanlou a ae cih paw ccungccaw tuh hythua ccoupaw nynh thua!” a cipya. <verse number="16" style="v" />Jesu nynh tuh-e paw tuh, “Ccungccapaw lu kheit nynh loohdangnaw poi pi tua zah ccungccaw patae a ko. <verse number="17" style="v" />Looh ae ccyh yn zaw te, a ko hae paw kalan a seepaw kha saw zah, ‘Rang ccavae oh, pawpaw balyn atu paccyn athua vae,’ cite a hosahpya hae. <verse number="18" style="v" />Thuasalama mih balyn te pong a seisah hae. Masaty e paw nynh, ‘Laekua kua kheit ka re zah do lan ka ccia aho ung, beih yn ngaethya hin,’ a cipya. <verse number="19" style="v" />Mingccangpaw nynh, ‘Tangnua toi pangaw ka re zah syntawtua lan ka la cceih ung cih, beih yn ngaethya hin,’ cite a ngiaku. <verse number="20" style="v" />Mingccangpaw nynh, ‘Atumaw khe zu ka hoi zah kae thuathya lan khyh,’ a ci. <verse number="21" style="v" />Tukeiccuze tuh-e seepaw nynh ki zah tuh-e tuh a bawipaw kya a hopya. Inn hoitupaw tuh a thinria zah a seepaw kha, ‘Khualae e laanluepi hae te laanpi dihpaw hae kalan khe la cceih kangmaw lah ryachi hae, pyn kya-e accing lei hae paw, ccukhou hae te mitmoh hae kha hynhlang oun cciakhae hae,’ a cipya. <verse number="22" style="v" />A seepaw nynh, ‘Bawipaw, kaw nae pya thyhte phe ka cyi vae, tuhzemah akhaan mang accawng ung,’ a cipya. <verse number="23" style="v" />A bawipaw nynh a seepaw kha, ‘Laanluepi te laanpi dihpaw hae kalan la cceih lah, ka inn kya phe abia ccaw, ccungccaw hae kha nangsete oun ko hae. <verse number="24" style="v" />Pawccecize nang kae hopya, kopaw ccungccaw hae lu kheit nynh sanmah ka zerya hynh taangtua lan khyh,’ a cipya,” cite a hopya.</para>
  <para style="s1">Zuitu Thuanaw Mee</para>
  <para style="p">
    <verse number="25" style="v" />Ccungccaw zapi patae tuh Jesu ryte a cceih hae. Jesu nynh maekuh zah minmin kyakhe, <verse number="26" style="v" />“Humhung zemah ka kalan yn cceih zah a paaw te a nung, a zu te a ccaaw hae, a uno hae te a ccia hae, te amaw a hiinnaw kha heize a hua khyh lanze ka zuitu lang tang kho lan khyh.<note caller="-" style="x"><char style="xo" closed="false">14.26: </char><char style="xt" closed="false"><ref loc="MAT 10:37">Mat 10.37</ref></char></note> <verse number="27" style="v" />Humhung zemah amaw a vaelantung kha puihku leite kae yn zuipaw tuh ka zuitu lang tang kho lan khyh.<note caller="-" style="x"><char style="xo" closed="false">14.27: </char><char style="xt" closed="false"><ref loc="MAT 10:38">Mat 10.38</ref>, <ref loc="MAT 16:24">16.24</ref>; <ref loc="MRK 8:34">Mar 8.34</ref>; <ref loc="LUK 9:23">Luk 9.23</ref></char></note> <verse number="28" style="v" />Pawccecize nanning lakuze lukhakheit nynh innhangpaw sak lan a paccynku ze, inn lynnaw lanpaw phua azaw lan a hoi tou, hoi khyh tou cipaw ny khylan masaty haungte amee tuatua lan khyh tou? <verse number="29" style="v" />Tuhte tuaty leite, innhangpaw tuh tungpi a bing koute a lyn kho khyh ze, a muih hae paw balyn nynh a sarya cih hae zah, <verse number="30" style="v" />‘E ccungccapaw nynh sak lan mang tho zah lyn kho vae khyh,’ cite a ho cih hae. <verse number="31" style="v" />Tuhkhyhze, siapharan lu kheit nynh ccangpaw siapharanpaw kha rhawtuk lan a nouku ze, ccungccaw thong kuin te yn thokuhpaw siapharanpaw kha ccungccaw thong haw te ka dou kho cih tou cipaw masaty haungte tuaku ty leite a um cih zawtou? <verse number="32" style="v" />A dou kho lan khyh ze, tuh-e siapharan tuh laan sawpi a um lyakhe, zeccuetu a saw cih zah ccawkunaw a ngiakuh cih. <verse number="33" style="v" />Tuhawte nanning laku e humhung zemah a hoipaw balyn kha marya a cciataw leipaw tuh ka zuitu lang tang kho lan khyh.</para>
  <para style="s1">A E leipaw Loi</para>
  <para style="r">(<ref loc="MRK 9:49-50">Mar 9.49-50</ref>)</para>
  <para style="p">
    <verse number="34" style="v" />“Loi tuh ahoy; thuasalama loi nynh a enaw kha azo lanze pawtemou esah kho athua ung cih? <verse number="35" style="v" />Tuh-e loi tuh laephi hanlan thuasah, athupaw pumnaw hanlan thuasah hoy vae khyh; ccungccaw hae nynh ccaring a vua vae hae. Thaenaw nakaring a hoipaw nynh thae sah,” a ci.</para>
  <chapter number="15" style="c" />
  <para style="s1">Azopaw Tuu</para>
  <para style="r">(<ref loc="MAT 18:11-14">Mat 18.11-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Ngunto khoitu hae te misei hae balyn nynh Jesu bya kha ngae khylan a kalan oun cceih hae.<note caller="-" style="x"><char style="xo" closed="false">15.1-2: </char><char style="xt" closed="false"><ref loc="LUK 5:29-30">Luk 5.29-30</ref></char></note> <verse number="2" style="v" />Farasi hae te kawbya sazae hae nynh ccohkuh hae zah, “E ccungccapaw hynh misei hae kha lehkhan hae zah minmin ryte a aekheih hae,” a ci hae.</para>
  <para style="p">
    <verse number="3" style="v" />Tukeiccuze Jesu nynh e tousenaw phungpaw hynh a hopya hae: <verse number="4" style="v" />“Nanning kya tuu za kheit a hoipaw ccungccaw nynh sa kheit kha a zosah lanze, sung takua sa takua kha ramkaw khe cciataw zah azopaw kha a muih makhia ccung khyh tou? <verse number="5" style="v" />Tuh-e tuu tuh he a muih te, lungtuate a raw vawlan a khangku. <verse number="6" style="v" />Innvaw he a thua tuh a ban hae te innpaw hae kha ko hae zah, ‘Lung oun tuakhae oh, pawccecize azopaw ka tuu kha phe ka muih vae,’ a cipya hae. <verse number="7" style="v" />Nanning kae hopya oh, tuhawte ngaesiku aho leipaw miding hae sung takua lu takua hanlan laeze a ngaesikuhpaw misei lu kheit hanlan vaawlang khua kya lungtuanaw a umhua.</para>
  <para style="s1">Phuapia Azopaw Tousenaw</para>
  <para style="p">
    <verse number="8" style="v" />“Tuhkhyhze, nopinung lu kheit nynh ngunphua pia haw hoi zah, pia kheit kha a zosah lanze maeekhua awkute inn kha phibia zah a muih mawlaezung pekite ccung khyh tou? <verse number="9" style="v" />He a muih te, a ban hae te innpaw hae kha ko hae zah, ‘Lung oun tuakhae oh, pawccecize ka zosahpaw phuapia kha phe ka muih vae,’ cite a hopya hae. <verse number="10" style="v" />Tuhawte, kae hopya oh, a ngaesikuhpaw misei lu kheit hanlan Pachia kya-e vaaw hae tuh mih lungtua,” a cipya hae.</para>
  <para style="s1">Ccapaw Zopaw Tousenaw</para>
  <para style="p">
    <verse number="11" style="v" />Jesu nynh, “Ccungccapaw lu kheit nynh ccapaw lu ning a hoi. <verse number="12" style="v" />Asoipaw nynh a paaw kha tho zah, ‘Apang, ka ccou lanpaw rho kha yn pya ccavae,’ a cipya. Tukeiccuze mih paaw nynh a hoipaw uccaw tuh minmin kha a nee hae. <verse number="13" style="v" />Aro mawze asoipaw nynh a uccaw balyn kha lawkuh zah asawnaw ram lang a cceih, tuin ram kyakhe a rythyte um zah a uccaw tuh pasupalah pong a mang. <verse number="14" style="v" />A hoipaw balyn marya a mang kou tuh, tuin ram kya myarya ccakanccih zah aning tuh myarya a ryachi vae. <verse number="15" style="v" />Tukeiccuze tuin ram e ccungccapaw lu kheit kalan a ryalawpya lan cceih zah, tuh-e paw nynh a voh rin lan a loo lang a cciasah. <verse number="16" style="v" />Aning tuh voh hae nynh a ae hae paw bia kaleih kha heize phe byn lan a ae ry vae, thuasalama hum nynh san looh pya vae khyh. <verse number="17" style="v" />Amaw te amaw yn nyhkuh zah, ‘Ka paaw kya vaeluakuh hae paw patae tuh sanlou aetae lei a hoi hae, thuasalama kae tuh hein kya vuelawte ka chih vae cih! <verse number="18" style="v" />Ka thokuh cih zah ka paaw kalan ka cceih cih zah, “Apang, Pachia malang te na malang phe ka sei vae. <verse number="19" style="v" />Kae tuh na ccapaw ci lan ka ngaekuh vae khyh, na kya vaeluakuhpaw lu kheit hawte yn nungbua,” ka cipah cih,’ cite a tuaku. <verse number="20" style="v" />Tukeiccuze thokuh zah a paaw kalan a cceih. Thuasalama laan sawpi yn thua lyakhe a paaw nynh muih zah ngaethya myarya a umsah; te ccuenua zah pom zah a myng. <verse number="21" style="v" />A ccapaw nynh, ‘Apang, Pachia malang te na malang phe ka sei vae, na ccapaw ci lan ka ngaekuh vae khyh,’ a cipya. <verse number="22" style="v" />Thuasalama a paaw nynh a see hae kha, ‘Ahoy huaccepaw boeining kha arangte oun lah oh lah lawsakuh oh, a kuih kya kuihpu pusah oh lah, a ccu kya phanah nawsah oh. <verse number="23" style="v" />Vaetua taraw athopaw kha hynhlang oun cciakhae oh lah theih oh; lungtuanaw poi tua oh sih lah, ae oh sih. <verse number="24" style="v" />Pawccecize e ka ccapaw tuh chih zah atu bua a hiinthui vae; aning tuh zo zah atu muihthui athua vae,’ a cipya hae. Te lungtuanaw poi tuh a tua hae.</para>
  <para style="p">
    <verse number="25" style="v" />“A ccapaw atawccapaw tuh loo kya a la um; yn cceih zah inn pe he a thua tuh tyngdaw te lawpaw roi kha a thae. <verse number="26" style="v" />See lu kheit kha ko zah tuh-e tuh pawmou cite a khia. <verse number="27" style="v" />Aning nynh, ‘Na neitawpaw kha phe yn thua vae, ngedante bua a muihthui keiccuze na paaw nynh athopaw vaetua taraw a chiapya,’ cite a hopya. <verse number="28" style="v" />Atawccapaw tuh a thinria zah inn lungkhu lang tee vae khyh, tukeiccuze a paaw nynh yn toinuakuh zah a soihbia. <verse number="29" style="v" />Aning nynh a paaw kha, ‘Ngaetua, kum hynhsepi cia see hawte rya kae lawpah zah, na kaw kae ei boi khyh, tuhzemah ka ban hae ryte lungtuanaw poi kae tuaku nawlan miaa taraw sa kheit san nae pya boi khyh. <verse number="30" style="v" />Thuasalama ohhuanung hae ryte na hoipaw uccaw marya a mangpaw e na ccapaw tuh he yn thua mawte, athopaw vaetua taraw kha na chiapya,’ cite a hopya. <verse number="31" style="v" />A paaw nynh, ‘Ka ccapaw, nang tuh ka kya tyty na um zah, ka hoipaw balyn tuh na kya-e nynh thua. <verse number="32" style="v" />Na neitawpaw tuh chih zah atu a hiinthui vae, zo zah atu ah muihthui vae oh; tukeiccuze aening tuh ah lungtua zah lungtuanaw poi tua lanpaw nynh thua,’ a cipya,” cite a ho.</para>
  <chapter number="16" style="c" />
  <para style="s1">Ahynhupaw Synriatu Tousenaw</para>
  <para style="p">
    <verse number="1" style="v" />Jesu nynh a zuitu hae kyakhe, “Mihoipaw lu kheit nynh synriatu lu kheit a hoi, tuh-e paw nynh a bawipaw uccaw hae kha phya a mang kou cite a bawipaw kha a hopya hae. <verse number="2" style="v" />A bawipaw nynh tuh-e paw tuh ko zah, ‘Na konglang ka thaepaw tuh pawtemou athua? Synriatu rya na lawnawpaw ccazing kha yn pya, pawccecize synriatu na thua kho vae lan khyh,’ a cipya. <verse number="3" style="v" />Synriatu nynh a lungkaw te, ‘Pawmou ka cyih vae cih? Ka bawipaw nynh ka ryalaw kyate phe yn phua vae, laephi thae lanze ka thae kho khyh, ngiaku lanze ka maethah. <verse number="4" style="v" />Ka ryalaw athang vae ze, ming hae nynh mih inn lang oun thuasah nawlan hae, pawte cyi lan cipaw ka nyku vae,’ a ciku. <verse number="5" style="v" />A bawipaw laebah um hae paw miakaw kha ko hae zah, masaty lukheitpaw kha, ‘Ka bawipaw kya hohzeihmou laebah na um?’ cite a khia. <verse number="6" style="v" />Aning nynh, ‘Chitui bath za kheit,’ a cipya. Aning nynh, ‘Na ccazing kha lawkuh lah arangte haung lah sung pangaw cite zeikuh,’ a cipya. <verse number="7" style="v" />Mingccangpaw kha, ‘Nang so hohzeihmou laebah na um?’ cite a khia. Tuh-e paw nynh, ‘Chanvuih kor za kheit,’ a cipya. Synriatu nynh, ‘Na ccazing kha lawkuh lah sung tarya cite zeikuh,’ a cipya. <verse number="8" style="v" />A hynhupaw synriatu nynh hawrarih lante a cyi keiccuze a bawipaw nynh the a hoysah. Pawccecize e laephi ccungccaw hae tuh mimaw she e ccungccaw hae te ccuepekunaw kya awnaw ccungccaw hae laeze a hawhua hae. <verse number="9" style="v" />Nanning kae hopya oh, atyn leipaw laephi sisua khate ruiban hae kha raekuh oh; tuhteze nynh tuh-e sisua he athang te, tuh-e ruiban hae nynh nanning kha zungzae tynpaw inn kya ae cciadue cih oh.</para>
  <para style="p">
    <verse number="10" style="v" />“Adihpaw uccaw kya a lungzipaw tuh alepaw uccaw kya mah a lungzi; adihpaw uccaw kya a hynpaw tuh alepaw kya mah a hynpaw nynh thua. <verse number="11" style="v" />Tukeiccuze atyn leipaw sisua kya nae lungzi khyh ze, ahmepaw hoirumnaw kha hum nynh mou ae pya cih oh? <verse number="12" style="v" />Ming hae uccaw kya nae lungzi khyh ze, naemaw na ccou lan oh paw uccaw thy tuh hum nynh mou ae pya ry cih oh? <verse number="13" style="v" />See lu kheit nynh bawi lu ning ryalawpah kho khyh; pawccecize bawi lu kheit kha a hua cih zah lu kheit kha a sungsah cih, tuhkhyhze lu kheit kalan a pan cih zah lu kheit kha pawlangria lan khyh. Nanning nynh Pachia te phuasui kha parouh na ryaa kho khyh oh,” a cipya hae.<note caller="-" style="x"><char style="xo" closed="false">16.13: </char><char style="xt" closed="false"><ref loc="MAT 6:24">Mat 6.24</ref></char></note></para>
  <para style="p">
    <verse number="14" style="v" />Phua a ry hae paw Farasi hae nynh tuh-e bya balyn tuh thae hae zah Jesu kha a nuinse hae. <verse number="15" style="v" />Jesu nynh minmin kha, “Nanning tuh ccungccaw hae malang naemaw te naemaw na dingsakuh oh paw nynh na thua oh; thuasalama Pachia nynh nae thinlung kha a ny; pawccecize ccungccaw nynh myarya aphute lante tuapaw uccaw tuh Pachia muihnaw kya anungsikuhpaw nynh thua.</para>
  <para style="p">
    <verse number="16" style="v" />“Kawbya te profeh hae ccauh tuh baptisma pyatu Johan kyacia hanlan nynh thua. Johan ccyh kyate vae tuh Pachia peenaw thehoypaw kha ho thua vae zah ccungccaw miakaw nynh tuh-e peenaw lungkhu lang thawte a tee vae hae.<note caller="-" style="x"><char style="xo" closed="false">16.16: </char><char style="xt" closed="false"><ref loc="MAT 11:12-13">Mat 11.12-13</ref></char></note> <verse number="17" style="v" />Kawbya kya-e ccapyh loihpaw ccaw ccangkheit azo laeze vaaw te lae zo nynh azoihua.<note caller="-" style="x"><char style="xo" closed="false">16.17: </char><char style="xt" closed="false"><ref loc="MAT 5:18">Mat 5.18</ref></char></note></para>
  <para style="p">
    <verse number="18" style="v" />“Humhung zemah a zu kha mah zah ccangpaw nopi kha zu lang a hoipaw tuh milae zu a seikhaepaw nynh thua; a vawpaw nynh a myapaw nopi kha zu lang a hoipaw tuh milae zu a seikhaepaw nynh thua.<note caller="-" style="x"><char style="xo" closed="false">16.18: </char><char style="xt" closed="false"><ref loc="MAT 5:32">Mat 5.32</ref>; <ref loc="1CO 7:10-11">1Ko 7.10-11</ref></char></note></para>
  <para style="s1">Lazaruh te Mihoipaw</para>
  <para style="p">
    <verse number="19" style="v" />“Sephaphuhpaw boeining te nebaleihpaw boeining kha lawkuh zah myarya hoysahte nin takyh leih umpaw mihoipaw lu kheit a um. <verse number="20" style="v" />Lazaruh a ci hae paw ryachipaw lu kheit a um, aning tuh a pyn balyn vaemaw te phe beih zah mihoipaw thuakaw zung khe phang a huekuh. <verse number="21" style="v" />Mihoipaw ccaboi kyate accahpaw loohmoi kha ae lan a ry; ui hae nynh oun cceih hae zah a vaemaw hae kha leih a lyapya hae. <verse number="22" style="v" />Tuh-e ryachipaw tuh chih zah vaaw hae nynh Abraham byvaw kalan a cciakhae hae. Mihoipaw mah chih zah a uu hae. <verse number="23" style="v" />Mihoipaw tuh Hell lungkhu kya myarya ccih lan teing zah, a dothung tuh asawnaw e Abraham te a pe umpaw Lazaruh kha a muih hae. <verse number="24" style="v" />Tetuh aning nynh sia zah, ‘Apang Abraham, thaw beih yn ccih lah Lazaruh kha beih yn sawpah, a kuihdung kha tui kya yn dungsah lah ka lae hynh yn kyaasah sah, pawccecize kae tuh hynh-e maeephu kya myarya ccih lan ka teing,’ a cipya. <verse number="25" style="v" />Thuasalama Abraham nynh, ‘Ka ccapaw, na hiin lyaze uccaw hoypaw hae kha na mue zah, Lazaruh tuh uccaw thahpaw hae kha a mue cipaw liathuitua; thuasalama atu aning tuh hein kya ngaengansah athua vae, nang tuh myarya ccih lan na teing vae. <verse number="26" style="v" />Tuhpiaze kaening te nanning laku kya myarya khupaw hunghuapi kha rae athua vae. Tukeiccuze hein kyate nae kalan a cceih ry hae paw nynh cceih kho khyh hae, khahlang te kaening kalan a cceih ry hae paw mah cceih kho khyh hae,’ a cipya. <verse number="27" style="v" />Mihoipaw nynh, ‘Tuhteze, apang, Lazaruh kha ka paaw inn lang nae la sawpya nawlan kae ngia. <verse number="28" style="v" />Pawccecize kae tuh uno lu pangaw ka hoi, minmin nynh hynh-e teingnaw hmin kalan oun thuabua khyh nawlan hae, aning nynh minmin kha raeringnaw la pya hae sah,’ a cipya. <verse number="29" style="v" />Abraham nynh, ‘Minmin tuh Moses te profeh hae mang a hoi hae, minmin bya kha la ngae hae sah,’ a cipya. <verse number="30" style="v" />Thuasalama aning nynh, ‘Apang Abraham, tuhte thua khyh; chinaw kyate lu kheit nynh thoothui zah mih kalan a ccia ze, minmin tuh a ngaesikuh cih hae,’ a cipya. <verse number="31" style="v" />Abraham nynh, ‘Minmin nynh Moses te profeh hae bya kha a ngae khyh hae ze lukhakheit nynh a chih hae paw kyate a tho zemah zyn lae vae lan khyh hae,’ a cipya,” cite a hopya hae.</para>
  <chapter number="17" style="c" />
  <para style="s1">Seinaw</para>
  <para style="r">(Mat 18.6-7, 21-22; <ref loc="MRK 9:42">Mar 9.42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Jesu nynh zuitu hae kha, “Seinaw lungkhu lang a ccawsahpaw uccaw hae tuh palei a um cih, thuasalama tuh-e uccaw hae a umsahtupaw hanlan ngaethya lan kou um! <verse number="2" style="v" />E imua taraw hae lukhakheit kha seinaw a raesah lae tuh a nging kyakhe mianawpaw lung kha sae lan zah rili lungkhu lang ccaring vua lanze amaw hanlan ahoyhua. <verse number="3" style="v" />La raeringkuh oh! Na uno nynh a sei ze la thuihei, a ngaesiku ze la ngaethya.<note caller="-" style="x"><char style="xo" closed="false">17.3: </char><char style="xt" closed="false"><ref loc="MAT 18:15">Mat 18.15</ref></char></note> <verse number="4" style="v" />Nin kheit lungkhu na tungvaw vae sari sei zah nin kheit lungkhu vae sari na kalan yn ki zah, ‘Ka ngaesikuh,’ ae cipya ze, na la ngaethya cih,” a cipya hae.</para>
  <para style="s1">Zynnaw</para>
  <para style="p">
    <verse number="5" style="v" />Locceihtu hae nynh Bawipaw kha, “Kae zynnaw hynh oun lesahthungpya tua,” a ci hae. <verse number="6" style="v" />Bawipaw nynh, “Nanning nynh mungngia cii cia zynnaw na hoi oh ze hynh-e thaeku ku hynh, ‘Na tharui kyate phohkuh lah rili lungkhu lang la bingkuh,’ na cipya oh ze, tuh-e nynh nae kaw phe ae ngae cih oh.</para>
  <para style="s1">See Ryalaw</para>
  <para style="p">
    <verse number="7" style="v" />“Nanning lakuze lukhakheit nynh see lu kheit hoi zah tuh-e see nynh lei a thue ze thuasah, tuhkhyhze tuu a rin ze thuasah, inn lang yn thua te, ‘Rang kangmaw lah, ae lan haung,’ cite hum nynh mou na ci cih oh? <verse number="8" style="v" />Tuh-e see kha, ‘Ka hanlan zerya yn hyngpah, anghyngnawpaw boeining kha lawkuh lah, ka ae ka nia lya yn ngawbia; tukoute nang tuh na ae na neih cih,’ cite na cipah lan khyh oh tou? <verse number="9" style="v" />Kaw na pya thyhte tuh-e see nynh a cyi keiccuze lungtuabya na hopah cih zawtou? <verse number="10" style="v" />Tuhawte nanning mah ryalaw ae naw oh paw balyn kha he na cyi vae oh ze, ‘Aening tuh angae-aduakuh leipaw see hae nynh ah thua oh, ah cyi lan oh paw rya kyalya nynh ah cyi oh!’ na ci cih oh,” cite a hopya hae.</para>
  <para style="s1">Lu Haw Dansahnaw</para>
  <para style="p">
    <verse number="11" style="v" />Jesu tuh Jerusalem lang a ccia lyakhe Samaria te Galilee laku kyate po a cceih. <verse number="12" style="v" />Khua khuakheit lungkhu lang a tee tuh, vaethya ccinaw a kae hae paw lu haw nynh amaw kha a cciadue hae. Asawnaw khe thadyn hae zah, <verse number="13" style="v" />“Bawipaw Jesu, kaening hynh ngaethya oun umsah!” cite a sia hae. <verse number="14" style="v" />Jesu nynh he a muih hae tuh minmin kha, “La cceih oh lah ranpibawi hae kha la dosakuh oh,” a cipya hae. Minmin nynh a ccia lya hae khe mih ccinaw tuh phe athyaa.<note caller="-" style="x"><char style="xo" closed="false">17.14: </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">Lev 14.1-32</ref></char></note> <verse number="15" style="v" />Minmin lakuze lukheitpaw nynh a dannaw kha he a muihkuh tuh, ki zah roi accae lante Pachia kha the a hoysah. <verse number="16" style="v" />Jesu cculeihpaw khe bakhung zah lungtuabya a ho; tuh-e paw tuh Samariapaw nynh thua. <verse number="17" style="v" />Jesu nynh, “Vaethya ccinaw a thyaa hae paw kha lu haw thua khyh tou? Lu takua hae so teimou a um hae? <verse number="18" style="v" />E minphuin ccangpaw holeite Pachia thehoysah lan yn kipaw lu kheit san um khyh tou?” a ci. <verse number="19" style="v" />Jesu nynh tuh-e paw tuh, “Thokuh, la cceih ccavae, na zynnaw nynh ae dansah vae,” a cipya.</para>
  <para style="s1">Hohtuhmou Peenaw Yn Thua Cih?</para>
  <para style="p">
    <verse number="20" style="v" />Farasi hae nynh Pachia peenaw tuh hohtuhmou yn thua cih cite Jesu kha a khia hae. Jesu nynh, “Pachia peenaw tuh muihpaw uccaw te yn thua khyh. <verse number="21" style="v" />‘Dotua, hein kya nynh a um!’ Tuhkhyhze, ‘Khuin kya nynh a um!’ cite mah oun ci lan khyh hae; pawccecize Pachia peenaw tuh nae lungkhu nynh a um,” a ci.</para>
  <para style="p">
    <verse number="22" style="v" />Jesu nynh zuitu hae kha, “Ccungccaw Ccapaw nin ninkheit kha muih na ry oh ccyh yn thua cih zah, na muih lan khyh oh. <verse number="23" style="v" />‘Hein kya nynh a um!’ Tuhkhyhze, ‘Khuin kya nynh a um!’ ae cipah cih oh; thuasalama la cceih nan oh, mih nulang la zuikuh nan oh. <verse number="24" style="v" />Pawccecize vaawlui san kheit kyate khozaw laekuh zah ccangpaw san kheit kalan a aw hawte Ccungccaw Ccapaw mah amaw nin kya tuhawte yn thua cih. <verse number="25" style="v" />Thuasalama aning tuh patae yn teing ty cih zah, e ciihan hae nynh oun vua cih hae. <verse number="26" style="v" />Noah ccyh lya a la cyiku hawte Ccungccaw Ccapaw ccyh kya mah yn cyihkuh cih.<note caller="-" style="x"><char style="xo" closed="false">17.26: </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">Gen 6.5-8</ref></char></note> <verse number="27" style="v" />Noah nynh sanphalung lungkhu lang a tee nin cia, ccungccaw hae tuh aete, niate, zudykute, zudypyakute a um hae, te tuipayn yn ynkuh zah mih balynte marya a ro hae.<note caller="-" style="x"><char style="xo" closed="false">17.27: </char><char style="xt" closed="false"><ref loc="GEN 7:6-24">Gen 7.6-24</ref></char></note> <verse number="28" style="v" />Tuhawte nynh Lot she lya mah a la cyiku; ccungccaw hae tuh aete, niate, uccaw reku zuakute, thingku ccoukute, inn sakkute a um hae.<note caller="-" style="x"><char style="xo" closed="false">17.28-29: </char><char style="xt" closed="false"><ref loc="GEN 18:20-19:25">Gen 18.20—19.25</ref></char></note> <verse number="29" style="v" />Thuasalama Lot nynh Sodom khua kyate a pou nin khe vaawlang te maee te kemaee khuaa yn rah zah mih balynte marya a ro hae. <verse number="30" style="v" />Ccungccaw Ccapaw yn langku nin mah tuhawte yn cyihkuh cih. <verse number="31" style="v" />Tuh-e nin kya, inn tungvaw umpaw ccungccaw nynh inn lungkhu umpaw a uccaw hae lawku khylan rungbung nan vae sah; tuhawte loo kya umpaw nynh mah inn lang ki nan vae sah.<note caller="-" style="x"><char style="xo" closed="false">17.31: </char><char style="xt" closed="false"><ref loc="MAT 24:17-18">Mat 24.17-18</ref>; <ref loc="MRK 13:15-16">Mar 13.15-16</ref></char></note> <verse number="32" style="v" />Lot a zu kha liathui oh.<note caller="-" style="x"><char style="xo" closed="false">17.32: </char><char style="xt" closed="false"><ref loc="GEN 19:26">Gen 19.26</ref></char></note> <verse number="33" style="v" />Humhung zemah a hiinnaw khumku lan a zuakuhpaw tuh a hiinnaw a shung cih, a hiinnaw a shungpaw tuh a hiinnaw a khyn cih.<note caller="-" style="x"><char style="xo" closed="false">17.33: </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mat 10.39</ref>, <ref loc="MAT 16:25">16.25</ref>; <ref loc="MRK 8:35">Mar 8.35</ref>; <ref loc="LUK 9:24">Luk 9.24</ref>; <ref loc="JHN 12:25">Joh 12.25</ref></char></note> <verse number="34" style="v" />Nanning kae hopya oh, tuh-e khuazi kya ikhung ccangkheit kya ccungccaw lu ning um hae paw kha lu kheit tuh law athua cih zah lu kheit kha cciataw athua cih. <verse number="35" style="v" />Sungsuhkheih hae paw nopi hae lu ning kha lu kheit tuh law athua cih zah lu kheit tuh cciataw athua cih. <verse number="36" style="v" />Loo kya a um hae paw lu ning kha lu kheit tuh law thua cih zah lu kheit tuh cciataw athua cih,” cite a hopya hae. <verse number="37" style="v" />Zuitu hae nynh, “Teilangmou law athua cih hae, Bawipaw?” cite a khia hae. Jesu nynh, “Achihpaw rhua a umnaw kya lantaw hae mah a pumkuh bua cih hae,” a cipya hae.</para>
  <chapter number="18" style="c" />
  <para style="s">Nomaenung te Byapiatu Tousenaw</para>
  <para style="p">
    <verse number="1" style="v" />Jesu nynh lungthang leite zungzae sawsang lan accan cipaw kong kha tousenaw phungpaw te minmin kha hynhte a hopya hae. <verse number="2" style="v" />“Khua khuakheit kya Pachia raw a rih leipaw te ccungccaw mae a do leipaw byapiatu lu kheit a um. <verse number="3" style="v" />Tuin khua kya nomaenung lu kheit a um, aning nynh byapiatupaw kalan atu te atu cceih zah, ‘Kae yn rhawtupaw te kae hoipaw byathan kha hmerarih lan yn piapah,’ a cipya. <verse number="4" style="v" />Aning nynh khaw cia cyipya leite a um; thuasalama nyalang tuh byapiatu nynh, ‘Pachia raw mah ka rih khyh zah ccungccaw mae mah a do leipaw ka thua zemah, <verse number="5" style="v" />e nomaenung nynh kaccohkale yn nung keiccuze a hanlan ahmete ka cyipah cih, tuhkhyhze tuh palei yn thua cih zah yn bangsah cih,’ cite a lungkaw te a tuaku,” a ci. <verse number="6" style="v" />Bawipaw nynh, “Ahme leipaw byapiatu nynh a hopaw kha thaetua oh. <verse number="7" style="v" />Pachia nynh amaw kalan khuazi khuadae a sia hae paw, amaw nynh a po hae paw kha ahmete cyipya leite a um cih hae zawtou? Minmin bawm lanpaw kha a thysung cih zawtou? <verse number="8" style="v" />Nanning kae hopya oh, minmin kha arangte hmerarih lan a cyipah cih hae. Thuasalama Ccungccaw Ccapaw he yn thua te, laephi vawlan zynnaw kha a muih vema?” a ci.</para>
  <para style="s1">Farasipaw te Ngunto Khoipaw Tousenaw</para>
  <para style="p">
    <verse number="9" style="v" />Mimaw kha miding lang riakuh hae zah mingccang hae a dothatheih hae paw kyakhe Jesu nynh e tousenaw phungpaw hynh a ho: <verse number="10" style="v" />“Ccungccaw lu ning tuh sawsang lan beikinn lang a cceihthung hae; lu kheit tuh Farasipaw thua zah lu kheit tuh ngunto khoitu nynh thua. <verse number="11" style="v" />Farasipaw nynh thadyn zah a makhaete hynhte saw a sang: ‘Pou Pachia, kae tuh milae hawte ming hae uccaw a ruhpaw, atazae leipaw, milae zu a seikhaepaw ka thua khyh zah, e ngunto khoipaw hawte mah ka thua khyh keiccuze kae luung. <verse number="12" style="v" />Lonaw naw kheit ze vae ning looh-ae ka sung, ka muepaw abalyn kya-e pumhaw pumkheit kha ka pya,’ a ci. <verse number="13" style="v" />Ngunto khoitupaw tuh asawnaw langkhe thadyn zah vaawlang dothung ngan leite a by kha tukuh zah, ‘Pou Pachia, miseipaw kae hynh ngaethya yn umsah!’ a ci. <verse number="14" style="v" />Nanning kae hopya oh, tuh-e paw tuh Farasipaw laeze thyaaccoute a inn lang a ki; pawccecize amaw te amaw a hangthungkuhpaw balyn tuh sawbung athua cih; thuasalama amaw te amaw zakaw a sangsakuhpaw tuh hangthung athua cih,” a ci.<note caller="-" style="x"><char style="xo" closed="false">18.14: </char><char style="xt" closed="false"><ref loc="MAT 23:12">Mat 23.12</ref>; <ref loc="LUK 14:11">Luk 14.11</ref></char></note></para>
  <para style="s1">Jesu te Imua hae</para>
  <para style="r">(<ref loc="MAT 19:13-15">Mat 19.13-15</ref>; <ref loc="MRK 10:13-16">Mar 10.13-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" />Ccungccaw hae nynh nosi hae kha Jesu kalan haesah khylan oun cciakhae hae; tuh-e tuh zuitu hae nynh he a muih hae tuh minmin kha a pe hae. <verse number="16" style="v" />Thuasalama Jesu nynh minmin kha ko hae zah, “Imua taraw hae kha ka kalan oun cceih hae sah, kang nan oh; pawccecize Pachia peenaw tuh khahcihawpaw ccungccaw hae kya-e nynh thua. <verse number="17" style="v" />Byaccaccing kae hopya oh, humhung zemah Pachia peenaw kha imua taraw hawte a lawkuh leipaw tuh tuh-e peenaw lungkhu lang tee lan khyh,” a ci.</para>
  <para style="s1">Mihoipaw Lu Kheit</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mat 19.16-30</ref>; <ref loc="MRK 10:17-31">Mar 10.17-31</ref>)</para>
  <para style="p">
    <verse number="18" style="v" />Uktupaw lu kheit nynh Jesu kha, “Sazae hoypaw, zungzae hiinnaw ka ccou nawlan pawmou ka cyih cih?” cite a khia. <verse number="19" style="v" />Jesu nynh, “Pawccemou kae hynh ahoypaw cite nae ko? Pachia lu kheit laelan ahoypaw hum sanmah um khyh. <verse number="20" style="v" />‘Milae zu milae vawpaw kya na sei lan khyh; ccungccaw na theih lan khyh; na ruh lan khyh; ahme leipaw ccaekia lang na tang lan khyh; na nung te na paaw kha sawtua hae,’ acikuhpaw kawbya hae kha na nyh khaw!” a cipya.<note caller="-" style="x"><char style="xo" closed="false">18.20: </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">Exo 20.12-16</ref>; <ref loc="DEU 5:16-20">Deu 5.16-20</ref></char></note> <verse number="21" style="v" />Aning nynh, “Tuh-e hae balyn tuh ka di lya mawte pong ka zui vae,” a ci. <verse number="22" style="v" />Jesu nynh tuh-e bya he a thae te, tuh-e paw tuh, “Ccangkheit na bou ung, na hoipaw balyn kha zua lah ryachi hae kha la nee hae, tetuh vaawlang khua kya sisua na hoi cih; tukoute yn cceih lah yn zui,” a cipya. <verse number="23" style="v" />Aning nynh tuh-e bya he a thae tuh myarya a ngaethah, pawccecize aning tuh myarya a hoipaw nynh thua. <verse number="24" style="v" />A ngaethyapaw kha Jesu nynh he a muih tuh, “Mihoi hae nynh Pachia peenaw lungkhu lang tee lanpaw tuh pawcihmou aru! <verse number="25" style="v" />Mihoipaw nynh Pachia peenaw kalan tee lae tuh kalauh nynh phynbang khu kya tee nynh azoihua,” a ci.</para>
  <para style="p">
    <verse number="26" style="v" />Tuh-e bya a thaepaw ccungccaw hae nynh, “Tuhteze hummou khumnaw a mue kho cih?” a ci hae. <verse number="27" style="v" />Jesu nynh, “Ccungccaw hanlan athua kho leipaw kha Pachia hanlan tuh athua kho,” a ci.</para>
  <para style="p">
    <verse number="28" style="v" />Peter nynh, “Dotua, kaening tuh pawpaw balyn marya kae cciataw zah namaw kha kae zui vae,” a ci. <verse number="29" style="v" />Jesu nynh, “Byaccaccing kae hopya oh, Pachia peenaw keiccuze inn thuasah, zu thuasah, uno thuasah, nungpaaw thuasah, ccaaw hae thuasah a cciatawpaw tuh, <verse number="30" style="v" />atu she kya aleit patae mue leite um lan khyh, yn thua cih paw she kya zungzae hiinnaw mue leite um lan khyh,” a cipya hae.</para>
  <para style="s1">A Chi lanpaw Bua A Ho</para>
  <para style="r">(<ref loc="MAT 20:17-19">Mat 20.17-19</ref>; <ref loc="MRK 10:32-34">Mar 10.32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" />Jesu nynh zuitu hae lu haw lae ning kha ccanglang cciakhae hae zah, “Dotua oh, aening tuh Jerusalem lang nynh ah cciathung oh, Ccungccaw Ccapaw konglang profeh hae nynh a zei hae paw balyn tuh marya yn ccing cih. <verse number="32" style="v" />Aning tuh Zenta hae kuih kalan pya yn thua cih zah saryanaw, dothatheihnaw te tuing te thoinaw kha a teing cih. <verse number="33" style="v" />A bua cih hae zah a theih cih hae, te nin thumnaw kya bua yn thoothui cih,” a cipya hae. <verse number="34" style="v" />Minmin nynh tuh-e bya tuh thaethya khyh hae, a hopaw kha minmin kyate thuruh thua zah, asuilan nyh khyh hae.</para>
  <para style="s1">Mitmohpaw A Dansah</para>
  <para style="r">(<ref loc="MAT 20:29-34">Mat 20.29-34</ref>; <ref loc="MRK 10:46-52">Mar 10.46-52</ref>)</para>
  <para style="p">
    <verse number="35" style="v" />Jesu tuh Jeriko khua te anaekunaw lang a thua lyakhe, mitmohpaw lu kheit tuh laanpi pe haung zah a ngiakuh hae. <verse number="36" style="v" />Ccungccaw zapi nynh a ccia hae paw siho kha thae zah, “Tuh-e tuh pawmou?” cite a khia hae. <verse number="37" style="v" />Minmin nynh, “Nazareth paw Jesu nynh yn cceih,” cite a hopya hae. <verse number="38" style="v" />Tetuh aning nynh, “David Ccapaw Jesu, kae hynh ngaethya yn umsah!” cite a sia. <verse number="39" style="v" />Malang a cceih hae paw nynh zya a dae ccaw cite tuh-e paw tuh a sianua hae, thuasalama aning nynh, “David Ccapaw, kae hynh ngaethya yn umsah!” cite houh a sia. <verse number="40" style="v" />Jesu nynh thadyn zah tuh-e paw tuh amaw kalan cciakhae lan kaw a pya hae, tuh-e paw tuh a pe lang he a thua te Jesu nynh, <verse number="41" style="v" />“Na hanlan pawmou nae cyisah ry?” cite a khia. Aning nynh, “Bawipaw, ngaw bua yn muih sah,” a cipya. <verse number="42" style="v" />Jesu nynh, “Ngawmuih ccavae, na zynnaw nynh ae dansah vae,” a cipya. <verse number="43" style="v" />Vaekheihmawte ngawmuihthui zah Pachia kha thehoysah biate Jesu kha a zui; ccungccaw hae balyn nynh tuh-e tuh muih hae zah Pachia kha the a hoysah hae.</para>
  <chapter number="19" style="c" />
  <para style="s1">Jesu te Zakia</para>
  <para style="p">
    <verse number="1" style="v" />Jesu tuh Jeriko khua lang tee zah khua lungkhu te po a cceih. <verse number="2" style="v" />Tuin kya Zakia a ci hae paw ccungccapaw lu kheit a um; aning tuh ngunto khoitu hae kyaze lupi thua zah myarya a hoi. <verse number="3" style="v" />Zakia nynh Jesu tuh hummou thua cite muih a ry; thuasalama ccungccaw lung zah aning tuh a ne keiccuze muih kho khyh. <verse number="4" style="v" />Tukeiccuze malang ccue khaw zah tuhlang yn cceih cih paw Jesu kha muih khylan thaeku ku kya a kae. <verse number="5" style="v" />Jesu nynh tuin kya he a thua te, dothung zah, “Zakia, arangte yn rung, atunin na inn ka thua cih,” a cipya. <verse number="6" style="v" />Zakia tuh arangte yn rungbung zah Jesu kha lungtuate a thuasah. <verse number="7" style="v" />Tuh-e a muih hae paw ccungccaw hae balyn nynh ccohkuh hae zah, “Miseipaw inn lang thua lan nynh a ccia,” a ci hae. <verse number="8" style="v" />Zakia nynh thadyn zah Bawipaw kha, “Bawipaw, dotua, ka uccaw hae angankuh kha ryachi hae ka pya hae; te lukhakheit kha ka ling zah hankhakheit ka lawkupaw a um ze, leit pali ka pyaru cih,” a cipya. <verse number="9" style="v" />Tetuh Jesu nynh, “E paw mah Abraham ccapaw athua keiccuze atunin hynh-e inn kya khumnaw a thua vae. <verse number="10" style="v" />Pawccecize Ccungccaw Ccapaw tuh azopaw ccung khylan te khum khylan nynh yn thua,” a ci.<note caller="-" style="x"><char style="xo" closed="false">19.10: </char><char style="xt" closed="false"><ref loc="MAT 18:11">Mat 18.11</ref></char></note></para>
  <para style="s1">Mina Phua Kia Haw Tousenaw</para>
  <para style="r">(<ref loc="MAT 25:14-30">Mat 25.14-30</ref>)</para>
  <para style="p">
    <verse number="11" style="v" />Ccungccaw hae nynh tuh-e bya a ngae lya hae khe, Jesu nynh tousenaw phungpaw ccangkheit a hopya chih hae. Pawccecize Jesu tuh Jerusalem lang vyavya a thua vae keiccuze Pachia peenaw tuh palou yn thua vae cih cite a tua hae. <verse number="12" style="v" />Tukeiccuze a hopaw tuh: “Bawi lu kheit tuh asawnaw ram lang ccia lan zah, tuin ram kya siapharan lang tang koute bua ki lan cite a paccynku. <verse number="13" style="v" />A ccia mawkhe, a see hae lu haw kha ko hae zah mina phua kia haw pya hae zah, ‘E hynhte bua kae thua cia kung la kunah oh,’ a cipya hae. <verse number="14" style="v" />Thuasalama a ram kya-e ccungccaw hae nynh amaw kha a hua hae keiccuze a nulang te ccungccaw saw hae zah, ‘E paw nynh ukku lan kae ry khyh,’ cite a hosahpya hae. <verse number="15" style="v" />Tuh-e bawi tuh siapharan lang a tang koute he yn ki tuh, phua a pyasya hae paw see hae nynh kungkunaw kyate hohzeihmou a mue hae cipaw ny khylan a kalan a kosah hae. <verse number="16" style="v" />Masatypaw nynh yn thua zah, ‘Bawipaw, nae pyapaw mina phua kia kheit te mina phua kia haw amia ka mue,’ a cipya. <verse number="17" style="v" />A bawipaw nynh, ‘Ahoy, see hoypaw! Nang tuh myarya dihpaw uccaw kya na lungzi keiccuze khuapi khua haw kha na uk cih,’ a cipya. <verse number="18" style="v" />Lu ningnawpaw nynh yn thua zah, ‘Bawipaw, nae pyapaw mina phua kia kheit te mina phua kia pangaw amia ka mue,’ a cipya. <verse number="19" style="v" />A bawipaw nynh, ‘Nang tuh khuapi khua pangaw na uk cih,’ a cipya. <verse number="20" style="v" />Ccangpaw lukheitpaw yn thua zah, ‘Bawipaw, hein kya na mina phua tuh a um. Pavua te ka tung zah ka ccy. <verse number="21" style="v" />Pawccecize nang tuh myarya a reipaw na thua zah kae rih; na ccyku leipaw kha na lawkuh zah na ccouku leipaw kha na ruekuhpaw nynh na thua,’ a cipya. <verse number="22" style="v" />A bawipaw nynh, ‘See thyapaw, namaw bya thyhte bya kae pia cih! Kae tuh ka ccyku leipaw kha ka lawkuh zah ka ccouku leipaw kha ka ruekuhpaw myarya ka reipaw cipaw mang na nyh pite, <verse number="23" style="v" />pawccemou ka phua tuh ban kya na nung khyh? He kae ki te, ka phua tuh ato ryte ka mue cih paw!’ a cipya. <verse number="24" style="v" />A pe a thadyn hae paw kyakhe, ‘A mina phua kha lah oh lah kia haw a hoitupaw kha pya oh,’ a cipya hae. <verse number="25" style="v" />Minmin nynh, ‘Bawipaw, aning tuh mina phua kia haw a hoi khaw tou!’ a ci hae. <verse number="26" style="v" />Mih bawipaw nynh, ‘Kae hopya oh, a hoipaw ccungccaw miakaw kha pyachih athua cih zah a hoi leipaw kya-e a hoi thypaw kha heize lawpya athua cih.<note caller="-" style="x"><char style="xo" closed="false">19.26: </char><char style="xt" closed="false"><ref loc="MAT 13:12">Mat 13.12</ref>; <ref loc="MRK 4:25">Mar 4.25</ref>; <ref loc="LUK 8:18">Luk 8.18</ref></char></note> <verse number="27" style="v" />Mih siapharan lang yn ry lei hae paw ka rhaw hae kha hynhlang oun cciakhae oh lah, ka malang maw hin theih oh,’ a cipya hae,” a ci.</para>
  <para style="s1">Jerusalem lang Jesu A Tee</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mat 21.1-11</ref>; <ref loc="MRK 11:1-11">Mar 11.1-11</ref>; <ref loc="JHN 12:12-19">Joh 12.12-19</ref>)</para>
  <para style="p">
    <verse number="28" style="v" />Jesu nynh tuh-e bya a ho koute Jerusalem lang ccia lan mih malang te a cceih.</para>
  <para style="p">
    <verse number="29" style="v" />Oliv Mua a ci hae paw mua pe umpaw Bethfake te Bethani khua pe a thua tuh, a zuitu hae lu ning kha saw hae zah, <verse number="30" style="v" />“Nae malang umpaw khua kalan la cceih oh lah tuh-e khua lungkhu lang he na tee oh te, hum nynh sanmah a cciku boi leipaw lann taraw a khii hae paw kha na la muih cih oh, tuh-e tuh oun supah oh lah hynhlang oun sue oh. <verse number="31" style="v" />Lukhakheit nynh, ‘Pawccemou na supya oh?’ cite ae khia oh ze, ‘Bawipaw nynh a peki,’ cite nae hopah cih oh,” a cipya hae. <verse number="32" style="v" />A saw hae paw ccungccaw hae tuh cceih hae zah Jesu nynh a hopya hae hawte a muih hae. <verse number="33" style="v" />Lann taraw kha he a supah hae tuh, a hoitu hae nynh, “Pawccemou lann taraw kha na supya oh?” a ci hae. <verse number="34" style="v" />Minmin nynh, “Bawipaw nynh a peki,” a cipya hae. <verse number="35" style="v" />Minmin nynh lann taraw kha Jesu kalan a sue hae, lann taraw tungvaw kya mih boei hae kha depah hae zah Jesu kha a ccisaku hae. <verse number="36" style="v" />Lann tungvaw ccikuh zah he a cceih tuh ccungccaw zapi nynh mih boei hae kha laanpi kya a phaepya hae. <verse number="37" style="v" />Oliv Mua kyate rungbungnaw kya he a thua tuh, a zui hae paw zapi balyn nynh a muih hae paw ngaeangnaw hae balyn hanlan lungtuate Pachia kha roi accae lante thehoysah hae zah,</para>
  <para style="q1">
    <verse number="38" style="v" />“Bawipaw min te yn thuapaw</para>
  <para style="q2">Siapharan tuh hythuaccou sah!</para>
  <para style="q1">Vaawlang khua kya</para>
  <para style="q2">daenaw um sah lah</para>
  <para style="q1">ahang huanaw vaawlang khua kya</para>
  <para style="q2">phu-enaw um sah!” cite a sia hae.<note caller="-" style="x"><char style="xo" closed="false">19.38: </char><char style="xt" closed="false"><ref loc="PSA 118:26">Sam 118.26</ref></char></note></para>
  <para style="m">
    <verse number="39" style="v" />Ccungccaw zapi laku e Farasi hae abang nynh Jesu kha, “Sazae, na zuitu hae hynh zya daesah hae,” cite a hopya hae. <verse number="40" style="v" />Jesu nynh tho zah, “Nanning kae hopya oh, e hae nynh zya a dae hae zemah lung hae nynh a sia cih hae,” cite a khung hae.</para>
  <para style="s1">Jerusalem elang Jesu A Rah</para>
  <para style="p">
    <verse number="41" style="v" />Jesu tuh Jerusalem pe thua zah khuapi kha a muih tuh, khuapi hanlan a rah: <verse number="42" style="v" />“Atunin kya daenaw elang pawmou abou cipaw na ny ze ahoy cih paw! Thuasalama atu tuh-e hae tuh na muih khyh nawlan thuruh athua. <verse number="43" style="v" />Na rhaw hae nynh na pepan kya rhawhohung ae sak khaw cih hae zah teitei langte balyn varyng ae koih hae ccyh yn thua cih. <verse number="44" style="v" />Namaw te na lungkhu e na ccaaw hae kha laephi kya ae noinae cih oh. Na kalan Pachia yn thua lanpaw ccyh kha na ny khyh keiccuze na kya lung ccangkheit vawlan ccangkheit akhangthykuh lei lan ciate ae cciataw cih hae,” a ci.</para>
  <para style="s1">Jesu nynh Beikinn A Ccikan</para>
  <para style="r">(<ref loc="MAT 21:12-17">Mat 21.12-17</ref>; <ref loc="MRK 11:15-19">Mar 11.15-19</ref>; <ref loc="JHN 2:13-22">Joh 2.13-22</ref>)</para>
  <para style="p">
    <verse number="45" style="v" />Beikinn lungkhu lang tee zah tuin kya uccaw a zuatu hae te a retu hae kha a dee hae; <verse number="46" style="v" />aning nynh, “Ccathyaa kyaze,</para>
  <para style="q1">‘Ka inn tuh sawsangnaw</para>
  <para style="q2">inn nynh thua,’ cite azeikuh;</para>
  <para style="q1">thuasalama nanning nynh</para>
  <para style="q2">miruh hae karung lang</para>
  <para style="q1">na rae vae oh,” a cipya hae.<note caller="-" style="x"><char style="xo" closed="false">19.46: </char><char style="xt" closed="false"><ref loc="ISA 56:7">Isa 56.7</ref>; <ref loc="JER 7:11">Jer 7.11</ref></char></note></para>
  <para style="p">
    <verse number="47" style="v" />Jesu nynh nin takyhte beikinn kya a ccangpya hae. Thuasalama ranpibawi lepaw hae te kawbya sazae hae te ccungccaw hae cciakhaetu hae nynh amaw chiathyanaw laanpi kha a ccung hae.<note caller="-" style="x"><char style="xo" closed="false">19.47: </char><char style="xt" closed="false"><ref loc="LUK 21:37">Luk 21.37</ref></char></note> <verse number="48" style="v" />Tuhzemah ccungccaw hae balyn nynh a bya kha myarya a ngae ry hae keiccuze chia khonaw ccyh muihkuh khyh hae.</para>
  <chapter number="20" style="c" />
  <para style="s1">Jesu Kawhoinaw A Khia hae</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mat 21.23-27</ref>; <ref loc="MRK 11:27-33">Mar 11.27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Nin kheit tuh Jesu nynh beikinn kya ccungccaw hae kha ccangpah hae zah thehoypaw a ho lyakhe, ranpibawi lepaw hae te kawbya sazae hae tuh piccan hae ryte oun thua hae zah, <verse number="2" style="v" />“Paw kawhoinaw te mou e uccaw hae hynh na cyi? Tuhkhyhze hum nynh mou hynh-e kawhoinaw hynh ae pya? Kaening oun hopya tua,” a ci hae. <verse number="3" style="v" />Jesu nynh, “Kae mah bya kaw kheit kae khia cih oh zah nae hopah cih oh. <verse number="4" style="v" />Johan kya-e baptisma kha vaawlang tetou yn thua? Tuhkhyhze ccungccaw hae kyate tou yn thua?” cite a khia hae. <verse number="5" style="v" />Minmin nynh mimaw te mimaw hokuh hae zah, “Aening nynh, ‘Vaawlang kyate’ ah ci oh ze, aning nynh, ‘Tuhteze pawccemou Johan kha na zyn khyh oh?’ oun ci cih. <verse number="6" style="v" />Thuasalama, ‘Ccungccaw hae kyate,’ ah ci oh ze, ccungccaw hae balyn nynh lung te oun deih cih hae, pawccecize minmin nynh Johan tuh profeh nynh thua cite a zyn hae,” a ciku hae. <verse number="7" style="v" />Tukeiccuze minmin nynh, “Paw kyate cipaw kae nyh khyh,” cite a khung hae. <verse number="8" style="v" />Jesu nynh, “Kae mah paw kawhoinaw te nynh e uccaw hae hynh ka cyi cipaw kae hopah lan khyh oh,” a cipya hae.</para>
  <para style="s1">Misu Khokhu Ryalahtu hae</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mat 21.33-46</ref>; <ref loc="MRK 12:1-12">Mar 12.1-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" />Jesu nynh ccungccaw hae kha hynh-e tousenaw phungpaw hynh a hopya hae: “Ccungccaw lu kheit nynh misu khokhu kha rae zah a hohtu kalan hohsakuh hae zah asawnaw ram lang khaw cia rote khua a ccong.<note caller="-" style="x"><char style="xo" closed="false">20.9: </char><char style="xt" closed="false"><ref loc="ISA 5:1">Isa 5.1</ref></char></note> <verse number="10" style="v" />Misu thae lo ccyh yn zaw tuh, a hohtu hae nynh amaw hanpaw khokhu kya-e misu thae kha yn pya ccaw hae cite a see lu kheit kha mih kalan a saw. Thuasalama minmin nynh tuh-e see tuh kyng hae zah a bua kou hae te, a kuih ccakaete a kisah hae. <verse number="11" style="v" />Ccangpaw see kha bua a saw, te minmin nynh tuh-e paw tuh mah bua hae zah maethyate a kuih ccakaete bua a kisah hae. <verse number="12" style="v" />Lu thumnaw kha bua a saw; minmin nynh tuh-e paw tuh mah vaemaw a muesah kou hae te dae a vua hae. <verse number="13" style="v" />Khokhu hoitupaw nynh, ‘Pawtepei ka cyih cih? Ka sungsahpaw ka ccapaw hynhsa ka saw vae; minmin nynh amaw hynh tuh saw a tua mamin cih hae,’ a ci. <verse number="14" style="v" />Thuasalama khokhu hohtu hae nynh amaw kha he a muih hae tuh, ‘E paw tuh rhoccoutu nynh thua; amaw kha theih oh sih lah a rho tuh ah uccaw lang a tang vae cih,’ cite mimaw te mimaw a hoku hae. <verse number="15" style="v" />Tukeiccuze minmin nynh amaw kha khokhu atolang khe vua hae zah a chia hae. Tukeiccuze khokhu hoitupaw nynh minmin kha pawtemou a cyih cih hae? <verse number="16" style="v" />Aning tuh yn cceih cih zah tuh-e khokhu hohtu hae kha a theih cih hae zah khokhu kha mingccang hae kalan a pya cih hae,” a ci. Ccungccaw hae nynh tuh-e bya tuh he a thae hae te, “Tuhte tuh thua nan sah!” a ci hae. <verse number="17" style="v" />Jesu nynh minmin kha do hae zah,</para>
  <para style="q1">“‘Inn sak hae paw nynh</para>
  <para style="q2">a nuee hae paw lung tuh</para>
  <para style="q1">inn saknaw kya abyapi huapaw</para>
  <para style="q2">apaki lang e lung lang</para>
  <para style="q1">yn tang,’</para>
  <para style="q2">cite azeikuhpaw Ccathyaa kha pawmou a ho ry?<note caller="-" style="x"><char style="xo" closed="false">20.17: </char><char style="xt" closed="false"><ref loc="PSA 118:22">Sam 118.22</ref></char></note></para>
  <para style="m">
    <verse number="18" style="v" />Humhung zemah tuh-e lung vawlan a ccahpaw tuh phe akingkuh cih; humhung zemah tuh-e lung nynh a ccawphupaw tuh palae tui cih,” a ci. <verse number="19" style="v" />Kawbya sazae hae te ranpibawi lepaw hae nynh tuh-e tousenaw phungpaw kha kaening nynh oun honua cipaw a nyku hae keiccuze tuin ccyh kya mawkhe amaw kha kyng lan a ry hae; tuhzemah minmin nynh ccungccaw hae raw a rih hae.</para>
  <para style="s1">Ngunto Khoinaw Kong Byakhianaw</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mat 22.15-22</ref>; <ref loc="MRK 12:13-17">Mar 12.13-17</ref>)</para>
  <para style="p">
    <verse number="20" style="v" />Tukeiccuze minmin nynh Jesu kha dokhaw hae zah a bya kha kyngpya khylan te ram uktu te kawhoitu kalan ap khylan, adingpaw hawte a umsakuh hae paw dophitu hae kha amaw kalan a sawnua hae. <verse number="21" style="v" />Dophitu hae nynh Jesu kha, “Sazae, nang tuh hmerarih lan na ho zah na ccangpya hae cipaw kae ny, ccungccaw laesahnaw na hoi khyh, Pachia laanpi kha hmerarih lan na ccangpya hae cipaw kae ny. <verse number="22" style="v" />Kaening nynh Sizar kalan ngunto pya lan accan tou? Ccan khyh tou?” cite a khia hae. <verse number="23" style="v" />Jesu nynh mih thyaruhnaw kha phe nyh zah, minmin kyakhe, <verse number="24" style="v" />“Denari kia kheit kha yn muihsah tua oh. Tuh-e kya hum muinsan te hum min mou a um?” a ci. Minmin nynh, “Sizar muinsan te min,” cite a khung hae. <verse number="25" style="v" />Jesu nynh, “Sizar uccaw kha Sizar pya oh lah Pachia uccaw kha Pachia pya oh,” a cipya hae. <verse number="26" style="v" />Minmin nynh a bya kha ccungccaw hae malang kyngpah kho khyh hae; a khungnaw hae paw bya kha mih ngaeangthua zah daebabi lan zya a um hae.</para>
  <para style="s1">Thoothuinaw Kong Byakhianaw</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mat 22.23-33</ref>; <ref loc="MRK 12:18-27">Mar 12.18-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" />Thoothuinaw um khyh cite a ho hae paw Sadusi hae abang nynh Jesu kalan oun cceih hae zah, <note caller="-" style="x"><char style="xo" closed="false">20.27: </char><char style="xt" closed="false"><ref loc="ACT 23:8">Loc 23.8</ref></char></note> <verse number="28" style="v" />“Sazae, ‘Ccungccapaw lu kheit nynh ccaawsaah leite a zu kha a chitaw ze, tuh-e paw a neitawpaw nynh tuh-e zu tuh a umkhae cih zah a upaw elang ccaaw a saahpah cih,’ cite Moses nynh kaening kha oun zeipya.<note caller="-" style="x"><char style="xo" closed="false">20.28: </char><char style="xt" closed="false"><ref loc="DEU 25:5">Deu 25.5</ref></char></note> <verse number="29" style="v" />Vaekheit tuh uno lu sari a um hae. Atawccapaw nynh zu hoi zah ccaawsaah leite phe a chih. <verse number="30" style="v" />Lu ningnaw nynh tuh-e nung tuh a zu lang umkhae zah ccaaw leite phe bua a chih. <verse number="31" style="v" />Lu thumnaw nynh tuh-e nung kha bua a umkhae, tuhawte lu sari mawte tuh-e nung tuh zu lang umkhae hae zah, ccaawsaah leite marya a chih hae. <verse number="32" style="v" />Nyathyakou tuh tuh-e nopinung mah a chihbua. <verse number="33" style="v" />Tukeiccuze thoothuinaw kya tuh-e nung tuh hum zu lang mou a tang cih? Pawccecize lu sari mawte tuh-e nung tuh zu lang a umkhae hae,” cite a khia hae.</para>
  <para style="p">
    <verse number="34" style="v" />Jesu nynh minmin kha, “Atu she e ccaaw hae tuh zuvaw tang hae zah zudypyakunaw a rae hae. <verse number="35" style="v" />Thuasalama nyalang e she kha thuasah, chinaw kyate thoothuinaw kha thuasah ccou lan angaekuh cite tua athua hae paw nynh tuh zuvaw tang ci um vae khyh, zu dypyaku ci mah um vae khyh. <verse number="36" style="v" />Minmin tuh vaaw hae te lokuh hae zah chih kho vae khyh hae, thoothuinaw ccaaw hae athua vae hae keiccuze Pachia ccaaw hae nynh athua vae hae. <verse number="37" style="v" />A chih hae paw kha thoothuisah athua hae cipaw tuh Moses nynh Bawipaw kha, ‘Abraham Pachia, Isak Pachia te Jakob Pachia’ cite thabu kya a ko lyakhe phe a langsaku vae.<note caller="-" style="x"><char style="xo" closed="false">20.37: </char><char style="xt" closed="false"><ref loc="EXO 3:6">Exo 3.6</ref></char></note> <verse number="38" style="v" />Pachia tuh a chih hae paw Pachia thua khyh, a hiin hae paw Pachia nynh thua, pawccecize ccungccaw balyn tuh amaw kya nynh a hiin hae,” a ci. <verse number="39" style="v" />Kawbya sazae hae abang nynh, “Sazae, na hopaw kou ahoy,” a ci hae. <verse number="40" style="v" />Tukoute tuh Jesu kha byakhia ngan vae khyh hae.</para>
  <para style="s1">David Ccapaw Kong Byakhianaw</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mat 22.41-46</ref>; <ref loc="MRK 12:35-37">Mar 12.35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" />Jesu nynh minmin kha, “Pawtemou kawbya sazae hae nynh, ‘Khri tuh David Ccapaw nynh thua,’ a ci kho hae? <verse number="42" style="v" />Sa Ccauh kyaze David amaw ccaccei nynh,</para>
  <para style="q1">‘Bawipaw nynh ka Bawipaw kha,<note caller="-" style="x"><char style="xo" closed="false">20.42-43: </char><char style="xt" closed="false"><ref loc="PSA 110:1">Sam 110.1</ref></char></note></para>
  <para style="q1">
    <verse number="43" style="v" />“Na rhaw hae kha na ccusy lang</para>
  <para style="q2">kae raepya makhia tuh,</para>
  <para style="q1">ka ranglang khe haung,” a cipya,’ a ci.</para>
  <para style="m">
    <verse number="44" style="v" />Tukeiccuze David nynh Messiah kha, ‘Bawipaw’ cite a ko lanze, pawtemou aning tuh a ccapaw athua kho cih?” cite a khia hae.</para>
  <para style="s1">Kawbya Sazae hae Seisahnaw</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mat 23.1-36</ref>; <ref loc="MRK 12:38-40">Mar 12.38-40</ref>)</para>
  <para style="p">
    <verse number="45" style="v" />Ccungccaw hae balyn nynh a thaenaw hae khe, Jesu nynh a zuitu hae kha, <verse number="46" style="v" />“Kawbya sazae hae kha la raeringkuh oh. Minmin tuh boeining ccuabalaepaw lawkute innlaepae ry hae zah kungkunaw kya sawtuate byabeihku a ry hae; sinakok kya tungkhung ahoy huaccepaw ry hae zah poi kya ahoy huanaw khe a um ry hae. <verse number="47" style="v" />Minmin tuh nomae hae inn kha luade hae zah ccungccaw hae nynh oun muih hae sah cite hynhsepi saw a sang hae; minmin tuh accih huapaw detahnaw kha a mue cih hae,” cite a hopya hae.</para>
  <chapter number="21" style="c" />
  <para style="s1">Nomaenung Lungsing</para>
  <para style="r">(<ref loc="MRK 12:41-44">Mar 12.41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Jesu nynh ngawdo zah mihoi hae nynh sisua bawng lungkhu lang mih lungsing a sang hae paw kha a muih. <verse number="2" style="v" />A ryachipaw nomaenung lu kheit nynh daw phuapia pia ning a sangpaw kha a muih. <verse number="3" style="v" />Jesu nynh, “Byaccaccing kae hopya oh, minmin balyn laeze hynh-e a ryachipaw nomaenung nynh alunghua a sang. <verse number="4" style="v" />Pawccecize minmin balyn tuh mih hoirumnaw patae kya-e kha a sang hae; thuasalama e nung tuh a ryachi pite a hiinnaw hanlan a hoipaw balyn kha marya a sang,” a ci.</para>
  <para style="s1">Beikinn A Ro lanpaw Hodaenaw</para>
  <para style="r">(<ref loc="MAT 24:1-2">Mat 24.1-2</ref>; <ref loc="MRK 13:1-2">Mar 13.1-2</ref>)</para>
  <para style="p">
    <verse number="5" style="v" />Ccungccaw abang nynh beikinn tuh apuithyapaw lung hae te thuasah, a hlu hae paw uccaw hae te thuasah ccaan athuapaw kong kha a ho hae; Jesu nynh, <verse number="6" style="v" />“Atu na muih oh paw hynh-e uccaw hae hynh lung ccangkheit vawlan ccangkheit san a khangthykuhpaw um vae leite, marya tingsah bung ccyh yn thua cih,” a ci.</para>
  <para style="s">Muihsahnaw te Vawsaw Pyanaw</para>
  <para style="r">(<ref loc="MAT 24:3-14">Mat 24.3-14</ref>; <ref loc="MRK 13:3-13">Mar 13.3-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" />Minmin nynh amaw kha, “Sazae, tuh-e tuh hohtuhmou yn cyihkuh cih? Tuh-e yn cyiku dyn kya paw muihsahnaw mou yn langkuh cih?” cite a khia hae. <verse number="8" style="v" />Jesu nynh, “Nanning kha ae ling khyh nawlan oh la raeringkuh oh, pawccecize ccungccaw patae nynh ka min te oun thua cih hae zah, ‘Kae tuh amaw nynh ka thua! Accyh a anae vae!’ oun ci cih hae; minmin nulang la zuikuh nan oh.</para>
  <para style="p">
    <verse number="9" style="v" />“Nanning nynh rhawtukkunaw kong te rhawtho lanpaw kong kha na thae vae oh ze la rih nan oh, pawccecize hynh-e uccaw hae tuh masaty yn thuaty cih, thuasalama athangnaw tuh palou thua loh lan khyh,” a ci. <verse number="10" style="v" />Jesu nynh minmin kha, “Minphuin phuin kheit te phuin kheit, ram kheit te ram kheit oun rhawkuh cih hae; <verse number="11" style="v" />myarya rupaw innry yn suekuh cih; ram takyh kya ccakan yn ccih cih zah shethya yn thua cih; vaawlang te ri lan umpaw syntawnaw te alepaw muihsahnaw yn langkuh cih.</para>
  <para style="p">
    <verse number="12" style="v" />“Thuasalama tuh-e hae balyn acyiku maw, kae ka min keiccuze ccungccaw hae nynh ae kyng cih oh zah ae tuaa ae sah cih oh, sinakok hae te thonginn hae kalan ae ap cih oh, siapharan hae te uktu hae malang ae thuakhae cih oh. <verse number="13" style="v" />Tuh-e tuh nae hanlan ccaekiakhan nawlan ccyhhoy athua cih. <verse number="14" style="v" />Tukeiccuze pawtemou kae khung cih hae cipaw na tuaku ty khyh nawlan oh la raeringkuh oh;<note caller="-" style="x"><char style="xo" closed="false">21.14-15: </char><char style="xt" closed="false"><ref loc="LUK 12:11-12">Luk 12.11-12</ref></char></note> <verse number="15" style="v" />pawccecize nanning ae rawse oh paw balyn nynh a ei kho lei hae paw te a khee kho lei hae paw hawnaw te hothyanaw kha kae pya cih oh. <verse number="16" style="v" />Nanning kha nungpaaw hae te uno hae, vaeccaw hae te ruiban hae nynh ae phee cih oh, minmin nynh nanning abang kha ae theih cih oh. <verse number="17" style="v" />Ka min keiccuze ccungccaw balyn nynh ae hua cih oh. <verse number="18" style="v" />Thuasalama nae lu kya-e nae sangrua ccangkheit sanmah zo lan khyh. <verse number="19" style="v" />Na ngaesangnaw oh liate nae hiinnaw kha na mue oh.</para>
  <para style="p">
    <verse number="20" style="v" />“Rhawkaw hae nynh Jerusalem khuapi a koih hae paw kha he na muih oh te, tuh-e ronaw tuh anae vae cipaw la nyh ccavae oh. <verse number="21" style="v" />Tetuh Judea ram kya a um hae paw nynh mua lang ccue hae sah, khuapi lungkhu a um hae paw nynh khuapi kha poutaw hae sah; ramkaw a um hae paw nynh khuapi lungkhu lang tee nan hae sah. <verse number="22" style="v" />Pawccecize Ccathyaa kya azeikuhpaw balyn accing nawlan tuh-e nin tuh detahnaw nin nynh thua.<note caller="-" style="x"><char style="xo" closed="false">21.22: </char><char style="xt" closed="false"><ref loc="HOS 9:7">Hos 9.7</ref></char></note> <verse number="23" style="v" />Tuin ccyh kya tuh ccaaw a poipaw nopi hae te matei zupaw nosi a hoipaw nopi hae hanlan ngaethya lan kou um! Pawccecize laephi vaw kya myarya ccihpaw riathaenaw yn um cih zah, e ccungccaw hae tungvaw Pachia bungpawnaw yn ccah cih. <verse number="24" style="v" />Minmin tuh ahepaw thaloi te chia athua cih hae zah minphuin balyn kalan see lang cciakhae athua cih hae; Jerusalem tuh Zenta hae ccyh athang mawlaezung Zenta hae nynh a syde cih hae.</para>
  <para style="s1">Ccungccaw Ccapaw Rungthuinaw</para>
  <para style="r">(<ref loc="MAT 24:29-31">Mat 24.29-31</ref>; <ref loc="MRK 13:24-27">Mar 13.24-27</ref>)</para>
  <para style="p">
    <verse number="25" style="v" />“Khuanin kya, sawpaw kya te awsi hae kya muihsahnaw yn langkuh cih, laephi vawlan minphuin hae tuh rili tuileih tho zah a siarua keiccuze lungthang ngaemyng te oun um cih hae.<note caller="-" style="x"><char style="xo" closed="false">21.25: </char><char style="xt" closed="false"><ref loc="ISA 13:10">Isa 13.10</ref>; <ref loc="EZK 32:7">Eze 32.7</ref>; <ref loc="JOL 2:31">Joe 2.31</ref>; <ref loc="REV 6:12-13">Bya 6.12-13</ref></char></note> <verse number="26" style="v" />Laephi vawlan oun cyihkuh lanpaw kong kha tuate ccungccaw hae tuh mih bungzou cih zah oun khuliakuh cih hae; pawccecize vaawlang e thungnaw huhan hae tuh yn hy cih. <verse number="27" style="v" />Minmin nynh Ccungccaw Ccapaw tuh alesaepaw phu-enaw te huhan ryte maeking kya yn rungpaw kha oun muih cih hae.<note caller="-" style="x"><char style="xo" closed="false">21.27: </char><char style="xt" closed="false"><ref loc="DAN 7:13">Dan 7.13</ref>; <ref loc="REV 1:7">Bya 1.7</ref></char></note> <verse number="28" style="v" />E uccaw hae he yn cyiku takaw vae ze thadyn oh lah dothung oh, pawccecize nanning shawkhawnaw tuh anae vae,” a cipya hae.</para>
  <para style="s1">Thaeku Ku Tousenaw</para>
  <para style="r">(<ref loc="MAT 24:32-35">Mat 24.32-35</ref>; <ref loc="MRK 13:28-31">Mar 13.28-31</ref>)</para>
  <para style="p">
    <verse number="29" style="v" />Jesu nynh minmin kha tousenaw phungpaw ccangkheit a hopya hae: “Thaeku ku te thingku hae balyn kha dotua oh. <verse number="30" style="v" />Anaw yn toihpaw kha na muih vae oh ze hawnin ccyh anae vae cipaw na ny oh. <verse number="31" style="v" />Tuhawte hynh-e uccaw hae yn cyikupaw kha nae muih vae oh ze, Pachia peenaw tuh anae vae cipaw kha la nyh ccavae oh. <verse number="32" style="v" />Byaccaccing kae hopya oh, hynh-e uccaw hae balyn acyiku kou makhia atu she e ccungccaw hae tuh zo lan khyh hae. <verse number="33" style="v" />Vaaw te lae tuh zo salamah ka bya tuh zo lan khyh.</para>
  <para style="s1">Raeringkute Ngaw Oh</para>
  <para style="p">
    <verse number="34" style="v" />“La raeringkuh oh, tuhkhyhze tuh hoysahnaw, zu-aenaw te hynh-e hiinnaw elang thinphangnaw khate nae thinlung tuh a vawsaw cih, te tualeipite tuh-e nin nynh ae thuanua cih oh. <verse number="35" style="v" />Pawccecize tuh-e nin tuh laephi pynpi kya ccungccaw balyn tungvaw khe kaang hawte yn thua cih. <verse number="36" style="v" />Yn thua cih paw uccaw balyn kyate na lue kho nawlan oh te Ccungccaw Ccapaw malang na thadyn kho nawlan oh raeringkute tyty um oh lah sawsang oh,” a ci.</para>
  <para style="p">
    <verse number="37" style="v" />Jesu nynh beikinn kya nin takyh a ccangpya hae, khuazi ccyh kya pou zah Oliv a ci hae paw mua kya a rya.<note caller="-" style="x"><char style="xo" closed="false">21.37: </char><char style="xt" closed="false"><ref loc="LUK 19:47">Luk 19.47</ref></char></note> <verse number="38" style="v" />Awkhua takaw te ccungccaw hae balyn nynh a bya kha ngae khylan beikinn lang oun cceih hae.</para>
  <chapter number="22" style="c" />
  <para style="s1">Jesu Chia lan Pheenaw</para>
  <para style="r">(Mat 26.1-5, 14-16; Mar 14.1-2, 10-11; <ref loc="JHN 11:45-53">Joh 11.45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Kawtaw Poi a ci hae paw, Ransi phing leipaw Sanlou Poi tuh anae vae.<note caller="-" style="x"><char style="xo" closed="false">22.1: </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">Exo 12.1-27</ref></char></note> <verse number="2" style="v" />Ranpibawi lepaw hae te kawbya sazae hae nynh ccungccaw hae raw a ri hae keiccuze Jesu chiathyanaw laanpi kha a ccung hae.</para>
  <para style="p">
    <verse number="3" style="v" />Satan nynh locceihtu lu haw lae ning kyaze lu kheit athua buapaw Judas Iskariot lungkhu langkhe a tee. <verse number="4" style="v" />Tuh-e paw nynh ranpibawi lepaw hae te beikinn ngawtu hae kalan cceih zah mih kuih kalan Jesu pya lanpaw kong kha a hokhae hae. <verse number="5" style="v" />Minmin tuh myarya mih lungtua zah phua pya lante mih nawccah. <verse number="6" style="v" />Judas nynh mah a nawccah zah ccungccaw zapi a um khyh lya hae khe Jesu kha mih kalan ap khylan ccyhhoypaw kha a ccungku vae.</para>
  <para style="s1">Kawtaw Poi Zerya Paccynnaw</para>
  <para style="r">(<ref loc="MAT 26:17-25">Mat 26.17-25</ref>; <ref loc="MRK 14:12-21">Mar 14.12-21</ref>; <ref loc="JHN 13:21-30">Joh 13.21-30</ref>)</para>
  <para style="p">
    <verse number="7" style="v" />Ransi phing leipaw Sanlou Poi tua nin thua zah Kawtaw Poi elang tuutaw chia nin yn thua vae. <verse number="8" style="v" />Jesu nynh Peter te Johan kha, “La cceih oh lah, aening ah ae lan oh paw Kawtaw Poi zerya kha la paccyn oh,” cite hopah hae zah a saw hae. <verse number="9" style="v" />Minmin nynh amaw kha, “Pawkyamou la paccyn hae sah ci nae ry?” cite a khia hae. <verse number="10" style="v" />Jesu nynh, “Ngaetua oh, khua lungkhu lang he na tee oh te, dawre te tui yn phupaw ccungccapaw lu kheit nynh ae la tungkuh cih oh, aning nynh a teenaw inn lungkhu lang la zuikuh bua oh lah, <verse number="11" style="v" />inn hoitu kha, ‘Sazaepaw nynh nang kha, “Ka zuitu hae ryte Kawtaw Poi zerya kae mangnaw lanpaw mikhia khaan tuh teisangmou a um?” ae ci,’ cite la hopah oh. <verse number="12" style="v" />Aning nynh a paccyn ty vae paw akopaw palung khaan kha ae la muihsah cih oh, tuin kyakhe aening hanlan la paccyn oh,” a cipya hae. <verse number="13" style="v" />Tukeiccuze minmin nynh cceih hae zah Jesu nynh a hopya hae hawte a muih hae, te minmin nynh Kawtaw Poi zerya kha a paccyn hae.</para>
  <para style="s">Bawipaw Zerya</para>
  <para style="r">(<ref loc="MAT 26:26-30">Mat 26.26-30</ref>; <ref loc="MRK 14:22-26">Mar 14.22-26</ref>; <ref loc="1CO 11:23-25">1Ko 11.23-25</ref>)</para>
  <para style="p">
    <verse number="14" style="v" />Accyh azawte Jesu tuh locceihtu hae ryte ccaboi kya a haung hae. <verse number="15" style="v" />Jesu nynh minmin kha, “Ka teing maw hin nanning ryte hynh-e Kawtaw Poi zerya hynh mangkheih lan myarya ka peki. <verse number="16" style="v" />Pawccecize kae hopya oh, Pachia peenaw kya Kawtaw Poi eenaw accing makhia, e poi hynh ka ae boi vae lan khyh,” a cipya hae. <verse number="17" style="v" />Banang kha lah zah lungtuabya a ho koute, “E banang hynh lawkuh oh lah neekuh oh. <verse number="18" style="v" />Pawccecize kae hopya oh, Pachia peenaw yn thua mawlaezung misutui hynh ka neih boi vae lan khyh,” a ci. <verse number="19" style="v" />Tukoute sanlou kha lah zah lungtuabya a ho koute eih zah minmin kha a pya hae; te, “E tuh nanning kae pya oh paw ka pyn nynh thua, kamaw liathui nawlan mang oh,” a ci. <verse number="20" style="v" />Tuhawte zerya a ae kou hae te, banang kha mah lah zah, “E banang tuh nanning hanlan ka laepaw ka chiise kya ka tynsahpaw byakin thawpaw nynh thua.<note caller="-" style="x"><char style="xo" closed="false">22.20: </char><char style="xt" closed="false"><ref loc="JER 31:31-34">Jer 31.31-34</ref></char></note> <verse number="21" style="v" />Thuasalama dotua oh, kae yn pheetupaw kuih tuh ccaboi kya kamaw te kae umkheih.<note caller="-" style="x"><char style="xo" closed="false">22.21: </char><char style="xt" closed="false"><ref loc="PSA 41:9">Sam 41.9</ref></char></note> <verse number="22" style="v" />Laerui-awde athua vae thyhawte Ccungccaw Ccapaw tuh a chih cih; thuasalama Ccungccaw Ccapaw a pheetupaw hanlan ngaethya lan kou um!” a ci. <verse number="23" style="v" />Zuitu hae nynh tuh-e uccaw tuh hum nynh mou yn cyih cih cipaw kha mimaw te mimaw laku a khiaku hae.</para>
  <para style="s1">Hummou Alehua?</para>
  <para style="p">
    <verse number="24" style="v" />Zuitu hae laku kya hummou ale huapaw lang nung lan cipaw eikunaw a um.<note caller="-" style="x"><char style="xo" closed="false">22.24: </char><char style="xt" closed="false"><ref loc="MAT 18:1">Mat 18.1</ref>; <ref loc="MRK 9:34">Mar 9.34</ref>; <ref loc="LUK 9:46">Luk 9.46</ref></char></note> <verse number="25" style="v" />Jesu nynh minmin kha, “Zenta siapharan hae nynh uknaw kaw te a uk hae, minmin a uktu hae paw kha hoynaw oun raepahtu cite a ko hae.<note caller="-" style="x"><char style="xo" closed="false">22.25-26: </char><char style="xt" closed="false"><ref loc="MAT 20:25-27">Mat 20.25-27</ref>; <ref loc="MRK 10:42-44">Mar 10.42-44</ref></char></note> <verse number="26" style="v" />Thuasalama nanning tuh tuhte na cyih lan khyh oh; nanning laku ale huapaw tuh adih huapaw hawte athua cih; cciakhaetu athuapaw nynh ryalawpatu hawte athua cih.<note caller="-" style="x"><char style="xo" closed="false">22.26: </char><char style="xt" closed="false"><ref loc="MAT 23:11">Mat 23.11</ref>; <ref loc="MRK 9:35">Mar 9.35</ref></char></note> <verse number="27" style="v" />Pawccecize aepaw a koihtupaw tou alehua? Tuhkhyhze a thohaepaw tou alehua? Aepaw a koihtupaw kha lehua khyh tou? Thuasalama kae tuh nanning laku kya a thohaepaw hawte nynh ka thua.<note caller="-" style="x"><char style="xo" closed="false">22.27: </char><char style="xt" closed="false"><ref loc="JHN 13:12-15">Joh 13.12-15</ref></char></note></para>
  <para style="p">
    <verse number="28" style="v" />“Nanning tuh tuhounaw ka tung lyaze ka kya po na umbua oh paw nynh na thua oh. <verse number="29" style="v" />Ka Paaw nynh peenaw kha yn pya hawte, kae nynh mah nanning kha peenaw kae pya oh. <verse number="30" style="v" />Ka peenaw lungkhu ka ccaboi kya na ae na neih cih oh zah, Israel phin haw lae ning kha byapiate bawitungkhung kya na haung cih oh,” a cipya hae.<note caller="-" style="x"><char style="xo" closed="false">22.30: </char><char style="xt" closed="false"><ref loc="MAT 19:28">Mat 19.28</ref></char></note></para>
  <para style="s1">Peter nynh A Vua lanpaw A Hoty</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mat 26.31-35</ref>; <ref loc="MRK 14:27-31">Mar 14.27-31</ref>; <ref loc="JHN 13:36-38">Joh 13.36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" />Bawipaw nynh, “Simon, Simon, ngaetua! Chanvuih kha pasaryh te ryh hawte nanning kha Satan nynh ryh lan ae peki oh. <verse number="32" style="v" />Thuasalama na zynnaw azo khyh nawlan saw kae sangpya; te ka kalan nae paleihku vae ze na uno hae kha thawzung na pya cih hae,” a cipya. <verse number="33" style="v" />Peter nynh, “Bawipaw, nang ryte tuh thonginn lang thuasah, chinaw kalan thuasah ccia lan paccynkute ka um!” a cipya. <verse number="34" style="v" />Bawipaw nynh, “Peter, nang kae hopya, nang nynh kae hynh ka nyh khyh cite vae thum nae vua maw, atunin aw khua lan khyh,” a cipya.</para>
  <para style="s1">Phuabu, Sohrae te Thaloi</para>
  <para style="p">
    <verse number="35" style="v" />Jesu nynh zuitu hae kha, “Phuabu, sohrae, phanah phuku leite kae saw lya oh kha, hankhakheit na ho na bou oh paw um tou?” cite a khia hae. Minmin nynh, “Um khyh, ccangkheit san um khyh,” a ci hae.<note caller="-" style="x"><char style="xo" closed="false">22.35: </char><char style="xt" closed="false"><ref loc="MAT 10:9-10">Mat 10.9-10</ref>; <ref loc="MRK 6:8-9">Mar 6.8-9</ref>; <ref loc="LUK 9:3">Luk 9.3</ref>, <ref loc="LUK 10:4">10.4</ref></char></note> <verse number="36" style="v" />Jesu nynh minmin kha, “Thuasalama atu tuh phuabu a hoipaw nynh phukuh sah lah sohrae a hoipaw mah vawkuh sah, te thaloi a hoi leipaw nynh a angkile kha zua sah lah thaloi kha rekuh sah. <verse number="37" style="v" />Pawccecize, kae hopya oh, ‘Aning tuh misei hae ryte riakheih athua,’ cite azeikuhpaw tuh ka tungvaw yn ccing cih, pawccecize ka konglang a zei hae paw kha accing lalia vae,” a cipya hae.<note caller="-" style="x"><char style="xo" closed="false">22.37: </char><char style="xt" closed="false"><ref loc="ISA 53:12">Isa 53.12</ref></char></note> <verse number="38" style="v" />Minmin nynh, “Bawipaw, dotua, hein kya thaloi zung ning a um,” a cipya hae. Jesu nynh minmin kha, “Azaw vae,” a cipya hae.</para>
  <para style="s1">Oliv Mua vawlan Jesu Sawsang</para>
  <para style="r">(<ref loc="MAT 26:36-46">Mat 26.36-46</ref>; <ref loc="MRK 14:32-42">Mar 14.32-42</ref>)</para>
  <para style="p">
    <verse number="39" style="v" />Jesu tuh yn pou zah leih a cyimae hawte, Oliv Mua lang cceih zah a zuitu hae nynh a zui hae. <verse number="40" style="v" />Tuin kya he a thua te minmin kha, “Tuhounaw lungkhu lang na ccaw khyh nawlan oh sawsang oh,” a cipya hae. <verse number="41" style="v" />Minmin kyate lung deih khin loukaw asawnaw langkhe cceih zah ccukharutungte saw a sangpaw tuh: <verse number="42" style="v" />“Apang, na rynaw athua ze, hynh-e banang hynh ka kyate yn lawpah; thuasalama kae ka rynaw hawte thua leite, na rynaw hawte thua sah,” a ci. <verse number="43" style="v" />Vaawlang te vaawpaw nynh a kalan yn langkuh zah thawzung a pya. <verse number="44" style="v" />Myarya a lungriathae pawte thawmawte saw houh a sang; a vaesaw tuh laekhu lang accawpaw chiise hawte nynh athua. <verse number="45" style="v" />Saw a sangnaw kyate thokuh zah a zuitu hae kalan he a thua tuh ngaethyate a ih hae paw kha a muih. <verse number="46" style="v" />Minmin kha, “Pawccemou na i oh? Tuhounaw lungkhu lang na ccaw khyh nawlan oh, tho oh lah sawsang oh,” a cipya hae.</para>
  <para style="s1">Jesu Kyngnaw</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mat 26.47-56</ref>; <ref loc="MRK 14:43-50">Mar 14.43-50</ref>; <ref loc="JHN 18:3-11">Joh 18.3-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" />Tuhte a ho cciamang lyakhe zuitu lu haw lae ning kyaze lu kheit athuapaw Judas nynh oun cciakhae hae paw ccungccaw zapi tuh oun thua vae hae, Judas nynh Jesu kha myng lan a naenuaku. <verse number="48" style="v" />Thuasalama Jesu nynh, “Judas, Ccungccaw Ccapaw hynh nang nynh myngte tou na phee?” a cipya. <verse number="49" style="v" />Jesu ryte a umkheih hae paw nynh yn cyihkuh lanpaw kha he a muih hae tuh, Jesu kha, “Bawipaw, thaloi te kae bae cih hae tou?” cite a khia hae. <verse number="50" style="v" />Lukheitpaw nynh ranpibawi a seepaw kha a ranglang nakua thoh pae lan a bae. <verse number="51" style="v" />Jesu nynh, “Azaw vae!” a ci. Jesu nynh tuh-e paw nakua kha hae zah a dansah. <verse number="52" style="v" />Jesu nynh amaw oun ccianua hae paw ranpibawi lepaw hae, beikinn ngawtu hae te piccan hae kha, “Kae hynh miruh hawte thaloi te tungbang te nae ccianua oh tou? <verse number="53" style="v" />Beikinn kya nanning ryte nin takyh ka um lyaze nae kuih nae hangnua khyh oh; thuasalama atu tuh nae ccyh te mohnaw huhan athung ccyh nynh thua,” a cipya hae.<note caller="-" style="x"><char style="xo" closed="false">22.53: </char><char style="xt" closed="false"><ref loc="LUK 19:47">Luk 19.47</ref>, <ref loc="LUK 21:37">21.37</ref></char></note></para>
  <para style="s1">Peter nynh Jesu A Vua</para>
  <para style="r">(Mat 26.57-58, 69-75; Mar 14.53-54, 66-72; Joh 18.12-18, 25-27)</para>
  <para style="p">
    <verse number="54" style="v" />Minmin nynh Jesu kha kyng hae zah ranpibawi lupi inn lang a cciakhae hae. Peter nynh asawnaw te a zui. <verse number="55" style="v" />Maepaw angaelung kya maeetua hae zah a haung lya hae khe Peter mah a haungbua. <verse number="56" style="v" />Peter nynh maee pe a haungpaw kha ryalawpatu liaccanung nynh he a muih tuh riri do zah, “E paw mah Jesu ryte a mungkuh hae paw nynh thua,” a ci. <verse number="57" style="v" />Peter nynh, “Nopinung, tuh-e paw tuh ka nyh khyh,” cite Jesu kha a vua. <verse number="58" style="v" />Khuekheih aro koute mingccangpaw nynh Peter kha muih zah, “Nang mah minmin kya a um buapaw nynh na thua,” a cipya. Peter nynh, “Ccungccapaw, ka thua khyh!” a ci. <verse number="59" style="v" />Suimilan ccangkheit loukaw aro koute mingccangpaw lu kheit nynh, “Thanccingte e paw mah Jesu ryte a mungkuh hae paw nynh thua, pawccecize aning tuh Galilee paw nynh thua,” cite tynkaring lan a ho. <verse number="60" style="v" />Peter nynh, “Ccungccapaw, paw nynh na ho cipaw ka nyh khyh!” a ci. Tuhte a ho cciamang lyakhe aw ccahe yn khua. <verse number="61" style="v" />Bawipaw nynh maeleihkuh zah Peter kha a do. Tetuh, ‘Atunin aw a khua mawze, vae thum nae vua cih,’ cite Bawipaw nynh a hopyapaw bya kha Peter nynh a liathui vae. <verse number="62" style="v" />Peter tuh atolang pou zah thawmawte a rah.</para>
  <para style="s1">Ranpibawi Lupi malang Jesu</para>
  <para style="r">(<ref loc="MAT 26:67-68">Mat 26.67-68</ref>; <ref loc="MRK 14:65">Mar 14.65</ref>)</para>
  <para style="p">
    <verse number="63" style="v" />Jesu kha a kyngtu hae nynh sarya hae zah a bua hae. <verse number="64" style="v" />Minmin nynh a mae kha phang bong hae zah a mae kha a bia hae, te “Hummou ae bua? Hotua!” cite a khia hae. <verse number="65" style="v" />Minmin nynh saryanaw bya patae a honua hae.</para>
  <para style="s1">Kungsi malang Jesu</para>
  <para style="r">(<ref loc="MAT 26:59-66">Mat 26.59-66</ref>; <ref loc="MRK 14:55-64">Mar 14.55-64</ref>; <ref loc="JHN 18:19-24">Joh 18.19-24</ref>)</para>
  <para style="p">
    <verse number="66" style="v" />Khua he adae tuh, piccan hae, ranpibawi lepaw hae te kawbya sazae hae nynh tungkuh hae zah Jesu kha kungsi malang poukhae hae zah, <verse number="67" style="v" />“Khri na thua ze kaening hynh oun hopya tua,” a ci hae. Jesu nynh, “Kae hopya oh zemah na zyn lan khyh oh; <verse number="68" style="v" />nanning kha bya kae khia oh zemah bya nae khunglae lan khyh oh. <verse number="69" style="v" />Thuasalama atu tetuh Ccungccaw Ccapaw tuh Pachia thungnaw ranglang khe a haung vae cih,” a cipya hae. <verse number="70" style="v" />Minmin balyn nynh, “Tuhteze, nang tuh Pachia Ccapaw tou?” a ci hae. Jesu nynh, “Na ho oh hawte ka thua,” a ci. <verse number="71" style="v" />Minmin nynh, “Ccangpaw ccaekia aho vae zawtou? Pawccecize a munglae kya-e bya kha ahmaw ccaccei nynh phe ah thae vae oh,” a ci hae.</para>
  <chapter number="23" style="c" />
  <para style="s1">Pilat malang Jesu</para>
  <para style="r">(Mat 27.1-2, 11-14; <ref loc="MRK 15:1-5">Mar 15.1-5</ref>; <ref loc="JHN 18:28-38">Joh 18.28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Ccungccaw zapi balyn nynh thokuh hae zah Jesu kha Pilat kalan a cciakhae hae. <verse number="2" style="v" />Minmin nynh Jesu kha seibe hae zah, “E paw nynh ah minphuin a cciakhae seipaw kha kae muih, te Sizar siapharan kalan ngunto pya lan a khee, amaw te amaw kha Khri a ci hae paw siapharan nynh ka thua a ciku,” cite a ho hae. <verse number="3" style="v" />Pilat nynh Jesu kha, “Nang hynh Judah hae Siapharan na thua tou?” cite a khia. Jesu nynh, “Na ho hawte nynh thua,” cite a khung. <verse number="4" style="v" />Pilat nynh ranpibawi lepaw hae te ccungccaw hae kha, “E ccungccapaw hynh a seinaw ka muih khyh,” a cipya hae. <verse number="5" style="v" />Minmin nynh houh sia hae zah, “Aning nynh Galilee kyate tho zah hynh-e hmin kyacia, Judea ram balyn po ccangpah hae zah ccungccaw hae kha mih lung a thosah,” a ci hae.</para>
  <para style="s1">Herod kalan Jesu Sawnaw</para>
  <para style="p">
    <verse number="6" style="v" />Pilat nynh tuh-e bya he a thae tuh, “Tuh-e paw tuh Galilee paw athua tou?” cite a khia. <verse number="7" style="v" />Herod nynh a ukpaw ram kya a umpaw nynh thua cipaw a nyh tuh, Jesu kha Herod kalan a saw; tuh ccyh lyatuin Herod tuh Jerusalem kya nynh a um. <verse number="8" style="v" />Herod nynh Jesu kha he a muih tuh myaryamaw a lungtua, pawccecize Jesu konglang kha palei thae zah muih a rynaw khaw asaw vae; Jesu nynh ngaeangnaw ccangkhakheit a raepaw kha muih lan a ngaehoi. <verse number="9" style="v" />Herod nynh Jesu kha bya patae a khia; thuasalama Jesu nynh kaw kheit san khung khyh. <verse number="10" style="v" />Ranpibawi lepaw hae te kawbya sazae hae nynh thadyn hae zah Jesu kha thawmawte sei a be hae. <verse number="11" style="v" />Herod te a rhawkaw hae nynh Jesu kha pawlangria leite a sarya hae; Herob nynh kou hoypaw boeining kha lawsakuh zah Pilat kalan bua a saw. <verse number="12" style="v" />Tuin nin ccaccei khe Pilat te Herod tuh ruiban lang a tang hae; tuh maw lya tuh a la rhawkuh hae paw nynh thua.</para>
  <para style="s1">Jesu Chia lan Byapia hae</para>
  <para style="r">(<ref loc="MAT 27:15-26">Mat 27.15-26</ref>; <ref loc="MRK 15:6-15">Mar 15.6-15</ref>; <ref loc="JHN 18:39-19:16">Joh 18.39—19.16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" />Pilat nynh ranpibawi lepaw hae, uktu hae te ccungccaw hae kha pynkheihlan ko hae zah, <verse number="14" style="v" />“Nanning nynh e ccungccapaw hynh ccungccaw hae a cciakhae seipaw hawte ka kalan nae cciakhae oh; na muihnaw oh kya akaw-aleih bya ka khia zah, sei na benaw oh paw kya a seinaw ccangkheit san ka muih khyh. <verse number="15" style="v" />Herod nynh mah a seinaw a muih khyh keiccuze kaening kalan bua yn saw; thanccingte, e paw nynh chi lan accan lan ciate seinaw ccangkheit san rae khyh. <verse number="16" style="v" />Tukeiccuze ka bua cih zah ka luesah cih,” a cipya hae. <verse number="17" style="v" />Pawccecize Kawtaw Poi kya thongccahpaw lukhakheit kha minmin hanlan leih a sawpya hae.</para>
  <para style="p">
    <verse number="18" style="v" />Minmin balyn nynh, “E ccungccapaw hynh theih lah, Barabbas kha oun sawpah!” cite ngingrarih lan a sia hae. <verse number="19" style="v" />Tuh-e Barabbas tuh khualae lungkhu rhawkunaw a raetu te ccungccaw a theihtu athua keiccuze thongccahpaw nynh thua. <verse number="20" style="v" />Pilat nynh Jesu kha a luesah ry keiccuze minmin kha bua a hopya hae. <verse number="21" style="v" />Thuasalama minmin nynh, “Vaelantung kya khiade, amaw kha khiade!” cite a sia hae. <verse number="22" style="v" />Pilat nynh vae thumnaw kya minmin kha, “Pawccemou? Paw hoyleinaw mou a rae? Chi lan accan lan ciate a tungvaw seinaw ka muih khyh, tukeiccuze ka bua cih zah ka saw cih,” a cipya hae. <verse number="23" style="v" />Thuasalama minmin nynh Jesu tuh vaelantung kya khiade lanpaw nynh thua cite roi accae lante thawmawte a ngia hae keiccuze minmin roi nynh phe a tae. <verse number="24" style="v" />Minmin nynh a ngia hae hawte thua sah cite Pilat nynh bya a pae. <verse number="25" style="v" />Khualae lungkhu rhawkunaw a pousah keiccu te ccungccaw a chia keiccuze thong a ccahpaw kha minmin nynh a ngia hae thyhte Pilat nynh a sawpya hae; thuasalama Jesu kha mih rynaw hawte cyi lan a pya hae.</para>
  <para style="s1">Vaelantung kya Khiadenaw</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mat 27.32-44</ref>; <ref loc="MRK 15:21-32">Mar 15.21-32</ref>; <ref loc="JHN 19:17-27">Joh 19.17-27</ref>)</para>
  <para style="p">
    <verse number="26" style="v" />Minmin nynh Jesu kha a cciakhae lya hae khe, Sairin khuapaw Simon, khua taraw langte yn cceihpaw kha kyng hae zah vaelantung kha puihsah hae zah Jesu nulang a zuisah hae. <verse number="27" style="v" />Ccungccaw aphupi nynh Jesu kha zui hae zah, tuh-e hae kyakhe amaw elang thinlungccite a rah a khui hae paw nopi hae mah a umbua hae. <verse number="28" style="v" />Thuasalama Jesu nynh mih kalan hawi zah, “Jerusalem ccanung hae, kae ka hanlan rah nan oh, naemaw te nae ccaaw hae hanlan palia rah oh. <verse number="29" style="v" />Pawccecize, ‘A tiin hae paw te ccaawsaah boi leipaw vue hae te imua nynh a zu boi leipaw matei hae tuh lungtua hae paw nynh thua,’ cite oun honaw hae ccyh tuh yn thua ccaccing cih. <verse number="30" style="v" />Minmin nynh mua hae kha, ‘Kaening hynh oun tingthin oh,’ oun cipah cih hae zah sangpyng hae kha, ‘Kaening hynh oun nethin oh,’ oun cipah cih hae.<note caller="-" style="x"><char style="xo" closed="false">23.30: </char><char style="xt" closed="false"><ref loc="HOS 10:8">Hos 10.8</ref>; <ref loc="REV 6:16">Bya 6.16</ref></char></note> <verse number="31" style="v" />Pawccecize minmin nynh ahinpaw thingku kya hynhte a cyi hae ze aroupaw thingku kya pawmou acyikuh cih?” a ci.</para>
  <para style="p">
    <verse number="32" style="v" />Jesu ryte misei hae lu ning kha mah chia lan a cciakhae bua hae. <verse number="33" style="v" />Kalvari a ci hae paw hmin kya a thua hae tuh, tuin kyakhe Jesu tuh vaelantung kya khiade hae zah, misei hae lu ning kha a ranglang lu kheit, a voilang lu kheit a khiade bua hae. <verse number="34" style="v" />Jesu nynh, “Apang, minmin hynh ngaethya hae; pawccecize paw nynh kae cyi cipaw nyh khyh hae,” a ci. Minmin nynh ccungthydung hae zah a boeining kha a neeku hae.<note caller="-" style="x"><char style="xo" closed="false">23.34: </char><char style="xt" closed="false"><ref loc="PSA 22:18">Sam 22.18</ref></char></note> <verse number="35" style="v" />Ccungccaw hae nynh thadyn hae zah phang a do hae; uktu hae nynh sarya hae zah, “Aning nynh ming hae kha a khum hae; aning tuh Pachia nynh a popaw Messiah athua lanze amaw te amaw kha khumkuh sah!” a ci hae.<note caller="-" style="x"><char style="xo" closed="false">23.35: </char><char style="xt" closed="false"><ref loc="PSA 22:7">Sam 22.7</ref></char></note> <verse number="36" style="v" />Rhawkaw hae nynh mah a saryabua hae, amaw kha oun ccianua hae zah misutui ariapaw kha pya hae zah, <note caller="-" style="x"><char style="xo" closed="false">23.36: </char><char style="xt" closed="false"><ref loc="PSA 69:21">Sam 69.21</ref></char></note> <verse number="37" style="v" />“Judah hae Siapharan na thua ze, namaw te namaw kha khumku tua!” a ci hae. <verse number="38" style="v" />A luki khe, “E paw tuh Judah hae Siapharan nynh thua,” cite a zei hae paw ccawkhia kha a taw hae.</para>
  <para style="p">
    <verse number="39" style="v" />Vaelantung kya a sae hae paw misei hae lu ning kyaze lu kheitpaw nynh sarya zah, “Messiah na thua ze namaw te namaw kha khumkuh lah, kaening hynh mah yn khumbua!” a cipya. <verse number="40" style="v" />Thuasalama lukheitpaw nynh tuh-e paw tuh pe zah, “E paw te alokuhpaw detahnaw kha mang na ing pite Pachia raw na rih khyh tou? <verse number="41" style="v" />Aening tuh ah cyisahnaw thyhte angaekuh lante hmerarih lan ah teingpaw nynh thua; thuasalama e paw tuh a cyiseipaw pawpaw mah um khyh,” a cipya. <verse number="42" style="v" />Te aning nynh, “Jesu, na peenaw lungkhu lang he na thua te, kae hynh yn ning nan vae ii,” a cipya. <verse number="43" style="v" />Jesu nynh, “Byaccaccing kae hopya, atunin nang tuh kamaw ryte Paradis kya na umbua vae cih,” a cipya.</para>
  <para style="s1">Jesu A Chih</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mat 27.45-56</ref>; <ref loc="MRK 15:33-41">Mar 15.33-41</ref>; <ref loc="JHN 19:28-30">Joh 19.28-30</ref>)</para>
  <para style="p">
    <verse number="44" style="v" />Tuh ccyh lya tuh ninthu suimilan haw lae ning loukaw thua zah zete suimilan ccangthum cia ram pynpi tuh pong amoh. <verse number="45" style="v" />Khuanin tuh phe amoh; beikinn lungkhu a zo hae paw boei tuh zung ning lang aseiikuh.<note caller="-" style="x"><char style="xo" closed="false">23.45: </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">Exo 26.31-33</ref></char></note> <verse number="46" style="v" />Jesu nynh thawte a sia koute, “Apang, ka muisaw hynh na kuih kya kae pya vae,” a ci. Tuhte a ho koute a hy athang.<note caller="-" style="x"><char style="xo" closed="false">23.46: </char><char style="xt" closed="false"><ref loc="PSA 31:5">Sam 31.5</ref></char></note> <verse number="47" style="v" />Acyihkuhpaw kha rhawbawipaw nynh he a muih tuh Pachia kha thehoysah zah, “Thanccingte, e paw tuh adingpaw ccungccaw nynh thua!” a ci. <verse number="48" style="v" />Tuh-e acyihkuhpaw tuh do khylan oun thua hae paw ccungccaw hae balyn nynh tuh-e tuh muih hae zah mih by tukute a ki hae. <verse number="49" style="v" />Amaw ryte a nyhkuh hae paw balyn te Galilee kyate amaw a zui hae paw nopi hae tuh asawnaw khe thadyn hae zah acyihkuhpaw kha a do hae.<note caller="-" style="x"><char style="xo" closed="false">23.49: </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">Luk 8.2-3</ref></char></note></para>
  <para style="s1">Jesu Rhua Ccynaw</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mat 27.57-61</ref>; <ref loc="MRK 15:42-47">Mar 15.42-47</ref>; <ref loc="JHN 19:38-42">Joh 19.38-42</ref>)</para>
  <para style="p">
    <verse number="50-51" style="v" />Judea ram kya Arimathea khuapaw Josef ci hae paw lu kheit a um. Aning tuh mihoypaw te midingpaw thua zah Pachia peenaw kha ngaehoite a ngawpaw nynh thua, aning tuh kungsi memba lu kheit athua zemah, kungsi memba hae mih khuakhannaw te mih cyisahnaw kha a nawccah leipaw nynh thua. <verse number="52" style="v" />E paw nynh Pilat kalan cceih zah Jesu rhua kha a ngiaku. <verse number="53" style="v" />Jesu rhua kha sahbung zah nebaleihpaw boei rawpaw te a lung, te lung a karyn hae paw, hum ccungccaw sanmah a uunaw boi lei hae paw shaw kyakhe a ccy. <verse number="54" style="v" />Tuin nin tuh Paccynku nin thua zah sabbath nin thuanaw anae vae. <verse number="55" style="v" />Galilee kyate amaw ryte oun cceihkheih hae paw nopi hae mah zuikuh bua hae zah a shawku kha thuasah, pawcihte nynh Jesu rhua a ccy hae cipaw kha thuasah a muihbua hae. <verse number="56" style="v" />Minmin tuh ki hae zah amynkhuhpaw te zimuin kha a paccyn hae. Sabbath nin kya tuh kawbya thyhte a haeung hae.<note caller="-" style="x"><char style="xo" closed="false">23.56: </char><char style="xt" closed="false"><ref loc="EXO 20:10">Exo 20.10</ref>; <ref loc="DEU 5:14">Deu 5.14</ref></char></note></para>
  <chapter number="24" style="c" />
  <para style="s1">Jesu Thoothuinaw</para>
  <para style="r">(<ref loc="MAT 28:1-10">Mat 28.1-10</ref>; <ref loc="MRK 16:1-8">Mar 16.1-8</ref>; <ref loc="JHN 20:1-9">Joh 20.1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Lonaw naw kheit kyaze masaty nin awkhua takaw khe nopi hae tuh a paccyn hae paw amynkhuhpaw kha ccyng hae zah shaw kalan a cceih hae. <verse number="2" style="v" />Minmin nynh shaw kyate lung a nuekuhpaw kha a muih hae. <verse number="3" style="v" />Minmin nynh shaw lungkhu lang tee hae zah Jesu rhua kha muih vae khyh hae. <verse number="4" style="v" />Minmin tuh tuh-e konglang myarya mih ngaeangthua lyakhe, phaephae akpaw boeining a lawkuh hae paw lu ning tuh mih pe khe oun thadyn hae. <verse number="5" style="v" />Nopi hae tuh rih hae zah laekhu kya a bakhung lya hae khe, tuh-e hae nynh, “Pawccemou a chih hae paw laku kya a hiinpaw kha na ccung oh? <verse number="6" style="v" />Aning tuh hein kya um vae khyh, phe a thoo vae! Galilee kya a um lyaze ae hopah oh zah,<note caller="-" style="x"><char style="xo" closed="false">24.6-7: </char><char style="xt" closed="false"><ref loc="MAT 16:21">Mat 16.21</ref>, <ref loc="MAT 17:22-23">17.22-23</ref>, <ref loc="MAT 20:18-19">20.18-19</ref>; <ref loc="MRK 8:31">Mar 8.31</ref>, <ref loc="MRK 9:31">9.31</ref>, <ref loc="MRK 10:33-34">10.33-34</ref>; <ref loc="LUK 9:22">Luk 9.22</ref>, <ref loc="LUK 18:31-33">18.31-33</ref></char></note> <verse number="7" style="v" />‘Ccungccaw Ccapaw tuh misei hae kuih kalan pya athua cih zah vaelantung kya khiade athua cih, te nin thumnaw kya yn thoothui cih,’ a cipaw kha liathuitua oh,” cite a hopya hae. <verse number="8" style="v" />Tetuh nopi hae nynh Jesu bya kha a liathui vae hae. <verse number="9" style="v" />Shaw kyate ki hae zah tuh-e kong balyn tuh lu haw lae kheit kya te tuhlaepaw zuitu hae balyn kyakhe a hopya hae. <verse number="10" style="v" />Locceihtu hae kya tuh-e kong a hopahtu hae tuh: Mary Magdalin, Joanna, James a nung Mary te minmin ryte a umkheih hae paw ccangpaw nopi hae nynh thua hae. <verse number="11" style="v" />Mih bya kha phungpaw huataw o-ang lante tua hae zah locceihtu hae nynh zyn khyh hae. <verse number="12" style="v" />Thuasalama Peter tuh thokuh zah shaw kalan khe a ccue; te bakhung zah he a do tuh boei rawpaw kyalya kha a muih, te acyihkuhpaw kha a ngaeangthua zah a inn lang a ki.</para>
  <para style="s1">Emmaus Laanpi kya Langkunaw</para>
  <para style="p">
    <verse number="13" style="v" />Tuin nin khe zuitu hae lu ning tuh Jerusalem kyate me sari loukaw asawnaw Emmaus a ci hae paw khua lang a cceih hae. <verse number="14" style="v" />Minmin nynh acyihkuhpaw konglang balyn kha a hoku hae. <verse number="15" style="v" />Tuhte a hoku lya hae khe, Jesu amaw ccaccei tuh yn naekuh zah mih kya a cceihbua. <verse number="16" style="v" />Thuasalama mih mit tuh phang khaw thua zah amaw kha nyh khyh hae. <verse number="17" style="v" />Jesu nynh minmin kha, “Na cceih lalia lan oh te, paw kong mou na hoku oh?” cite a khia hae. Tetuh minmin tuh ngaethyate phang thadyn hae. <verse number="18" style="v" />Minmin kyaze Kleopas a ci hae paw nynh khung zah, “Jerusalem khua umpaw mikhia mang na thua pite, atu loukaw tuin kya acyihkuhpaw konglang kha na nyh khyh tou?” a cipya. <verse number="19" style="v" />Jesu nynh minmin kha, “Paw konglang mou?” cite a khia hae. Minmin nynh, “Nazareth khuapaw Jesu kong nynh thua, aning tuh Pachia malang te ccungccaw balyn malang cyisahnaw te bya kya athungpaw profeh nynh thua, <verse number="20" style="v" />amaw kha ranpibawi lepaw hae te uktu bawi hae nynh a chi ccaw cite seibe khylan ap hae zah vaelantung kya a khiade hae. <verse number="21" style="v" />Aning tuh Israel hae kha oun shawkhaw cih paw nynh thua cite kaening nynh kae la ngaehoi; tuh-e hae kyalya thua leite, tuhte acyikunaw te atunin hynh nin thumnaw nynh thua. <verse number="22" style="v" />Tuhpiaze kaening kae phu kya-e nopi hae abang nynh kae ngaeang oun thuasah hae. Minmin tuh khuadaetakaw te shaw kalan cceih hae zah, <verse number="23" style="v" />a rhua kha muih vae khyh hae; te oun ki hae zah Jesu tuh phe hiin vae cite a hopah hae paw vaaw hae kya-e vizin kha mah kae muih cite oun hopya hae. <verse number="24" style="v" />Kae umkheih hae paw abang nynh shaw kalan cceih hae zah nopi hae nynh a ho hae hawkhate a muih hae; thuasalama Jesu tuh muih khyh hae,” cite a hopya hae. <verse number="25" style="v" />Tuinte Jesu nynh minmin kha, “Pou mingaee hae, profeh hae nynh a hosya hae paw balyn kha zyn lan myarya na rusah oh ii! <verse number="26" style="v" />Khri tuh hynh-e hae hynh a teing koute a phu-enaw lungkhu lang tee lan ccan khyh tou?” a cipya hae. <verse number="27" style="v" />Moses kyate tho zah Profeh hae balyn nynh amaw konglang a zei hae paw Ccathyaa balyn kha minmin kya ccaerarih lan a hopya hae.</para>
  <para style="p">
    <verse number="28" style="v" />A cceih cihnaw hae khua kya vyavya a thua hae tuh, Jesu tuh malang cceih zah po a sulue cih paw hawte a umsakuh. <verse number="29" style="v" />Thuasalama minmin nynh, “Kae kya umbua hin, khuanin vyavya nae vae, khua yn zi vae cih,” cite thawmawte a kang hae. Tukeiccuze minmin ryte ryakheih lan a teebua. <verse number="30" style="v" />Minmin ryte ccaboi kya he a koihkheih hae tuh, Jesu nynh sanlou kha lah zah hythua a pya koute eih zah a nee hae. <verse number="31" style="v" />Mih mit tuh oun ccae zah amaw kha a ny vae hae; te aning tuh mih muihnaw kyate phe azo. <verse number="32" style="v" />Minmin nynh, “Laanpi kya aning nynh bya oun hopya lya te Ccathyaa oun ccaesahpya lya kha ah thinlung kya maee nynh oun upaw hawte khaw athua?” cite a hoku hae. <verse number="33" style="v" />Tuh ccyh lyamawkhe minmin tuh thokuh hae zah Jerusalem lang a ki hae; zuitu lu haw lae kheit te mih ban hae a sueluakuh hae paw kha a muih hae. <verse number="34" style="v" />Tuh-e hae nynh, “Bawipaw tuh a thoothui ccaccing vae, Simon kya a langkuh vae!” a ci hae. <verse number="35" style="v" />Minmin nynh mah laanpi kya acyihkuhpaw konglang te sanlou a ia lya Bawipaw nynh thua cipaw a ny hae paw kong kha a hopya hae.</para>
  <para style="s1">Zuitu hae kya Langkunaw</para>
  <para style="p">
    <verse number="36" style="v" />Tuhte minmin nynh a ho lya hae khe Jesu tuh mih ngaelaku khe yn thadyn zah, “Nae kya daenaw um sah,” a cipya hae. <verse number="37" style="v" />Minmin nynh khozi nynh kae muih cite tua hae zah ohsiikuh hae zah a rih hae. <verse number="38" style="v" />Jesu nynh, “Pawccemou nae bungzou? Pawccemou nae thinlung kya lunghiinnaw a um? <verse number="39" style="v" />Ka kuih te ka ccu hynh dotua oh! Kamaw maw nynh ka thua, yn haetua oh lah yn dotua oh; pawccecize kae nynh ka hoipaw na muih oh paw ngesaw te ru kha khozi nynh tuh hoi khyh,” a cipya hae. <verse number="40" style="v" />Tuhte he a ho koute, a kuih te a ccu kha a dosah hae. <verse number="41" style="v" />Minmin tuh mih ngaeangthua zah mih lungtua keiccuze a zyn kho khyh lya hae khe, Jesu nynh, “Hein kya ae lanpaw hankhakheit na hoi oh tou?” cite a khia hae. <verse number="42" style="v" />Minmin nynh aruakuhpaw ngasaw pae kheit kha a pya hae. <verse number="43" style="v" />Jesu nynh lawkuh zah a muihnaw hae khe a ae.</para>
  <para style="p">
    <verse number="44" style="v" />Tukoute Jesu nynh, “Moses kawbya ccauh kya thuasah, profeh hae ccauh kya thuasah, Sam ccauh kya thuasah kae ka kong a zei hae paw miakaw tuh marya accing cih cite nanning ryte ka um lyaze kae hopya oh paw bya tuh hynh-e hae hynh nynh thua,” a cipya hae. <verse number="45" style="v" />Minmin nynh Ccathyaa kha a thaethya ccaw hae cite mih thinlung kha a uasah. <verse number="46" style="v" />Minmin kha, “Ccathyaa kya hynhte azeikuh, Messiah tuh a teing cih zah nin thumnaw kya a chih hae paw kyate a thoothui cih. <verse number="47" style="v" />Jerusalem kyate tho zah minphuin miakaw kalan ngaesikunaw te seingaethyanaw kong kha amaw min te ho athua cih. <verse number="48" style="v" />Nanning tuh hynh-e uccaw hae konglang ccaekia hae nynh na thua oh. <verse number="49" style="v" />Ka Paaw nynh bya a kinkupaw kha kamaw nynh nae tungvaw kya kae saw cih; thuasalama vaawlang te nae kya thungnaw yn thua mawlaezung Jerusalem khua kya la um hin oh,” a cipya hae.<note caller="-" style="x"><char style="xo" closed="false">24.49: </char><char style="xt" closed="false"><ref loc="ACT 1:4">Loc 1.4</ref></char></note></para>
  <para style="s1">Jesu Vaawlang Kaenaw</para>
  <para style="r">(<ref loc="MRK 16:19-20">Mar 16.19-20</ref>; <ref loc="ACT 1:9-11">Loc 1.9-11</ref>)</para>
  <para style="p">
    <verse number="50" style="v" />Jesu nynh zuitu hae kha Bethani khua cia a cciakhae hae, te a kuih kha hangthung zah hythua a pya hae.<note caller="-" style="x"><char style="xo" closed="false">24.50-51: </char><char style="xt" closed="false"><ref loc="ACT 1:9-11">Loc 1.9-11</ref></char></note> <verse number="51" style="v" />Tuhte hythua a pya lya hae khe mih kyate phiakuh zah vaawlang lawthung athua vae. <verse number="52" style="v" />Minmin nynh amaw kha beiksya hae zah lungtuanaw alepi te Jerusalem lang a ki hae. <verse number="53" style="v" />Beikinn kyakhe Pachia kha tyty a thehoysah hae.</para>
</usx>