<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="OBA" style="id">Baebu Thyaa</book>
  <para style="h">OBADIAH</para>
  <para style="toc1">Obadiah</para>
  <para style="toc2">OBADIAH</para>
  <para style="toc3">Oba</para>
  <para style="mt1">OBADIAH</para>
  <para style="mt2">Obadiah</para>
  <para style="imt">Byalaanmaw</para>
  <para style="ip">E ccauh taraw hynh BC 856 kum Jerusalem aroh koute yn poupaw nynh thua. Judah rhaw athua zungzaepaw Edom tuh Jerusalem aro keiccuze a lungtua kyalya thua leite Judah a vawsawnaw kha lunghoyria zah Jerusalem kha a thiingbua. Israel rhaw athua hae paw ramccang hae ryte Edom tuh detahnaw a ing cih zah a shung cih cite Obadiah nynh a hodae.</para>
  <para style="iot">Abyalupi hae</para>
  <para style="io1">Edom kha detahnaw 1-14</para>
  <para style="io1">Bawipaw Nin 15-21</para>
  <chapter number="1" style="c" />
  <para style="s1">Edom Detahnaw</para>
  <para style="p">
    <verse number="1" style="v" />Obadiah nynh a muihpaw vizin.</para>
  <para style="b" />
  <para style="q1">Edom ram konglang kha</para>
  <para style="q2">Bawipaw PACHIA nynh hynhte a ho:<note caller="-" style="x"><char style="xo" closed="false">vv.1-14: </char><char style="xt" closed="false"><ref loc="ISA 34:5-17">Isa 34.5-17</ref>, <ref loc="ISA 63:1-6">63.1-6</ref>; <ref loc="JER 49:7-22">Jer 49.7-22</ref>; <ref loc="EZK 25:12-14">Eze 25.12-14</ref>, <ref loc="EZK 35:1-15">35.1-15</ref>; <ref loc="AMO 1:11-12">Amo 1.11-12</ref>; <ref loc="MAL 1:2-5">Mal 1.2-5</ref></char></note></para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh minphuin hae kalan khe</para>
  <para style="q2">locceihtu kha saw zah:</para>
  <para style="q1">“Thoku tua oh! Edom kha</para>
  <para style="q2">rhawtuk khylan thonuakuh oh sih!”</para>
  <para style="q2">a cipaw bya kha ah thae vae oh.</para>
  <para style="q1">
    <verse number="2" style="v" />Nang kha minphuin hae laku kya</para>
  <para style="q2">adih huaccepaw lang kae rae ccaccing cih;</para>
  <para style="q2">nang tuh dothatheihpaw na thua cih.</para>
  <para style="q1">
    <verse number="3" style="v" />A lysakuhpaw na thinlung nynh</para>
  <para style="q2">nang kha ae ling vae,</para>
  <para style="q1">nang tuh lungtungpi hae laku khe na um zah,</para>
  <para style="q2">ahangpaw hmin hae kya na um.</para>
  <para style="q1">Na thinlung kyakhe,</para>
  <para style="q2">“Hum nynh mou laekhu lang</para>
  <para style="q2">yn sahbung kho cih?” na ciku.</para>
  <para style="q1">
    <verse number="4" style="v" />Nang tuh mosipi hawte</para>
  <para style="q2">na hangkuh thung zah,</para>
  <para style="q1">awsi hae laku khe bu na luaku zemah,</para>
  <para style="q2">tuin kyate kae sahbung cih, cite</para>
  <para style="qr">
    <char style="nd">Bawipaw </char> nynh a ci.</para>
  <para style="b" />
  <para style="s1">Edom kha Liarunaw</para>
  <para style="q1">
    <verse number="5" style="v" />Nang tuh pawcihtemou ro na thua!</para>
  <para style="q2">Miruh hae nynh na kalan</para>
  <para style="q1">oun thua hae ze thuasah,</para>
  <para style="q2">luadetu hae nynh khuazi khe</para>
  <para style="q1">oun thua hae ze thuasah,</para>
  <para style="q2">a ry hae paw kyalya kha</para>
  <para style="q1">ruh khyh hae tou?</para>
  <para style="q2">Misu thae lotu hae nynh</para>
  <para style="q1">na kalan oun thua hae ze,</para>
  <para style="q2">a lobang hae paw beihtaraw kha</para>
  <para style="q2">cciataw khyh hae tou?</para>
  <para style="q1">
    <verse number="6" style="v" />Esau uccaw kha phe luade vae hae,</para>
  <para style="q2">a thuruhpaw a sisua hae kha</para>
  <para style="q2">ccung hae zah a lua vae hae!</para>
  <para style="q1">
    <verse number="7" style="v" />Na hokuhbung oh paw balyn nynh</para>
  <para style="q2">nang kha ae ling vae hae,</para>
  <para style="q1">nang kha ramri langkhe ae dee vae hae;</para>
  <para style="q2">na vaeccawkuh oh paw nynh</para>
  <para style="q1">ae tae vae hae;</para>
  <para style="q2">na looh a ae hae paw nynh</para>
  <para style="q1">kaang ae syakhaw vae hae,</para>
  <para style="q2">tuh-e kong kha nythyanaw na hoi vae khyh.</para>
  <para style="q1">
    <verse number="8" style="v" />
    <char style="nd">Bawipaw </char> nynh a hopaw tuh,</para>
  <para style="q2">tuin nin vae tuh, Edom ram e</para>
  <para style="q1">a haw hae paw te Esau Mua e</para>
  <para style="q2">nythyanaw a hoi hae paw kha</para>
  <para style="q2">ka roh cih hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Pou Teman, na rhawkaw hae tuh</para>
  <para style="q2">mih bungzou cih,</para>
  <para style="q1">tuhteze nynh Esau Mua</para>
  <para style="q2">a um hae paw balyn kha</para>
  <para style="q1">chia athua cih hae.</para>
  <para style="s1">Edom nynh A Uno A Rawse</para>
  <para style="q1">
    <verse number="10" style="v" />Nang nynh na uno Jakob kha</para>
  <para style="q2">puathote na chia keiccuze</para>
  <para style="q1">maethyanaw na mue cih zah,</para>
  <para style="q2">phe thang lan chia na thua cih.</para>
  <para style="q1">
    <verse number="11" style="v" />Minphuin ccangpaw hae nynh</para>
  <para style="q2">a sisua kha a cciakhae lya hae khe,</para>
  <para style="q1">ramccang hae nynh a koikua lungkhu lang</para>
  <para style="q2">teenua hae zah, Jerusalem e</para>
  <para style="q1">uccaw hae kha ccungthydungte</para>
  <para style="q2">a neeku hae nin khe,</para>
  <para style="q1">nang tuh ccanglang khe</para>
  <para style="q2">namaw um lan zya na um nin kya,</para>
  <para style="q1">nang mah ramccang hae ryte</para>
  <para style="q2">nae lunglokuh bua.</para>
  <para style="q1">
    <verse number="12" style="v" />Na unopaw vethyanaw a tung nin khe,</para>
  <para style="q2">na unopaw tungvaw kya</para>
  <para style="q1">lunghoy na ria lan ccan khyh;</para>
  <para style="q2">Judah ccungccaw hae a ro nin hae khe,</para>
  <para style="q1">nang tuh lungpawte</para>
  <para style="q2">na um lan ccan khyh;</para>
  <para style="q1">riathaenaw a tung nin hae khe,</para>
  <para style="q2">nang tuh na pooku lan ccan khyh.</para>
  <para style="q1">
    <verse number="13" style="v" />Ka ccungccaw hae nynh</para>
  <para style="q2">shethya a tung lya hae khe,</para>
  <para style="q1">mih koikua lungkhu lang</para>
  <para style="q2">na tee lan oh ccan khyh.</para>
  <para style="q1">Judah nynh shethya a tung nin,</para>
  <para style="q2">aning a vawsaw nin kha</para>
  <para style="q1">lunghoy na ria lan ccan khyh;</para>
  <para style="q2">aning nynh shethya a tung nin khe,</para>
  <para style="q2">a uccaw kha na luade lan ccan khyh.</para>
  <para style="q1">
    <verse number="14" style="v" />Lue khylan a ccue hae paw kha chia khylan,</para>
  <para style="q2">laanpi a tungkunaw kya</para>
  <para style="q1">na thadyn khaw lan hae ccan khyh;</para>
  <para style="q2">mih vawsaw nin kya,</para>
  <para style="q1">a hiinhy hae paw kha rhaw hae kuih kya</para>
  <para style="q2">na ap lan hae ccan khyh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" />Minphuin hae balyn tungvaw kya</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> byapianaw nin tuh anae vae.</para>
  <para style="q1">Na cyi hawte na tungvaw cyi athua cih;</para>
  <para style="q2">na cyisahnaw tuh</para>
  <para style="q2">na lu vawlan accah cih.</para>
  <para style="q1">
    <verse number="16" style="v" />Nanning ka ccungccaw hae nynh</para>
  <para style="q2">athyaapaw ka mua vawlan</para>
  <para style="q1">na ae na la nia oh keiccuze</para>
  <para style="q2">nae pepan e minphuin hae balyn nynh</para>
  <para style="q1">a ae a neih cih hae;</para>
  <para style="q2">minmin nynh a neih cih hae,</para>
  <para style="q1">a due cih hae zah marya a zo cih hae.</para>
  <para style="s1">Israel kya-e Nyathyakou Taenaw</para>
  <para style="q1">
    <verse number="17" style="v" />Thuasalama Zion Mua vawlan khe</para>
  <para style="q2">a lue hae paw tuh a um cih hae zah,</para>
  <para style="q1">tuh-e hmin tuh hmin thyaa athua cih.</para>
  <para style="q2">Jakob ciihan hae nynh mih ram</para>
  <para style="q2">a la luatu hae kha a luaru cih hae.</para>
  <para style="q1">
    <verse number="18" style="v" />Jakob ciihan hae tuh</para>
  <para style="q2">maee athua cih hae zah,</para>
  <para style="q1">Josef ciihan hae tuh</para>
  <para style="q2">maeesoi athua cih hae,</para>
  <para style="q1">Esau ciihan hae tuh</para>
  <para style="q2">athupaw athua cih hae,</para>
  <para style="q1">maee te a soi cih hae zah</para>
  <para style="q2">minmin kha a u cih hae,</para>
  <para style="q1">Esau ciihan a hiinhypaw um lan khyh hae;</para>
  <para style="q2">pawccecize <char style="nd">Bawipaw </char> nynh phe a ho vae.</para>
  <para style="q1">
    <verse number="19" style="v" />Negeb kya um hae paw nynh</para>
  <para style="q2">Esau Mua kha a ccou cih hae,</para>
  <para style="q1">Shefelah kya um hae paw nynh</para>
  <para style="q2">Filistin ram kha a ccou cih hae,</para>
  <para style="q1">minmin nynh Efraim ram te</para>
  <para style="q2">Samaria ram kha a ccou cih hae,</para>
  <para style="q1">Benjamin ccungccaw hae nynh</para>
  <para style="q2">Gilead ram kha a ccou cih hae.</para>
  <para style="q1">
    <verse number="20" style="v" />Kyngte cciakhae thua hae zah</para>
  <para style="q2">Halah kya um hae paw Israel hae nynh</para>
  <para style="q1">Foenisia ram kha</para>
  <para style="q2">Zarefath khua kyacia a ccou cih hae;</para>
  <para style="q1">kyngte cciakhae thua hae zah</para>
  <para style="q2">Sefarad kya um hae paw</para>
  <para style="q1">Jerusalem khuaccaaw hae nynh</para>
  <para style="q2">Negeb ram kya um hae paw</para>
  <para style="q2">khua hae kha a ccou cih hae.</para>
  <para style="q1">
    <verse number="21" style="v" />Khum athua hae paw tuh</para>
  <para style="q2">Esau Mua kha uk khylan,</para>
  <para style="q1">Zion Mua lang a kaethung cih hae;</para>
  <para style="q2">te peenaw tuh <char style="nd">Bawipaw </char> peenaw athua cih.</para>
</usx>