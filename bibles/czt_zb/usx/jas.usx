<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="JAS" style="id">Baebu Thyaa</book>
  <para style="h">JAMES</para>
  <para style="toc1">James</para>
  <para style="toc2">JAMES</para>
  <para style="toc3">Jam</para>
  <para style="mt1">JAMES</para>
  <para style="mt2">CCAKY</para>
  <para style="mt2">James</para>
  <para style="imt">Byalaanmaw</para>
  <para style="ip">
    <char style="bk">James kyate Ccaky</char> hynh laephi vaw khua takyh lang a phiakuh hae paw Pachia ccungccaw hae kalan Khriccaaw ziazae ccangpyaku nawpaw sueluapaw nynh athua. Ccawzeitu nynh a ho rypaw kya Khriccaaw thinlung te cciakhaekunaw hanlan hawnaw te cciakhaeku nawlan kha tousenaw pataepi a mang. Khriccaaw konglang te a mangpaw abyalupi hae tuh: hoirumnaw te ryachinaw, munglae mangnaw, hawnaw, bya-eikunaw, lysakunaw te zakawsangsakunaw, ming hae byapianaw, pookunaw, lungsaenaw te sawsangnaw.</para>
  <para style="ip">Hynh-e ccaky nynh Khriccaaw beiknaw zia kya zynnaw tuh ryalawnaw nynh a zui cipaw abyapi lang a langsaku.</para>
  <para style="iot">Alungkhu Umpaw</para>
  <para style="io1">Byalaanmaw — 1.1</para>
  <para style="io1">Zynnaw te hawnaw — 1.2-8</para>
  <para style="io1">Ryachinaw te hoirumnaw — 1.9-11</para>
  <para style="io1">Syntawtuanaw te tuhounaw — 1.12-18</para>
  <para style="io1">Thaenaw te ryalawnaw — 1.19-27</para>
  <para style="io1">Laesakunaw te raeringnaw pyanaw — 2.1-13</para>
  <para style="io1">Zynnaw te ryalawnaw — 2.14-26</para>
  <para style="io1">Khriccaaw te byaho zia — 3.1-18</para>
  <para style="io1">Khriccaaw te laephi — 4.1—5.6</para>
  <para style="io1">Ccangpyanaw aphuinphuin — 5.7-20</para>
  <chapter number="1" style="c" />
  <para style="s1">Beihlangnaw</para>
  <para style="p">
    <verse number="1" style="v" />Pachia te Bawipaw Jesu Khri ryalahtu kae James nynh pong pazaekuh lan a phiakuh hae paw Israel phin haw lae ning kha kae beihlang oh.<note caller="-" style="x"><char style="xo" closed="false">1.1: </char><char style="xt" closed="false"><ref loc="MAT 13:55">Mat 13.55</ref>; <ref loc="MRK 6:3">Mar 6.3</ref>; <ref loc="ACT 15:13">Loc 15.13</ref>; <ref loc="GAL 1:19">Gal 1.19</ref></char></note></para>
  <para style="s1">Zynnaw te Hawnaw</para>
  <para style="p">
    <verse number="2" style="v" />Ka u te ka neitaw hae, syntawnaw aphuinphuin na tung vae oh ze, tuh-e tuh lungtua nawlan la ria oh; <verse number="3" style="v" />pawccecize nae zynnaw kha syntawnaw nynh ngaesangnaw kha a poukhae cipaw na ny oh. <verse number="4" style="v" />Nanning nynh pawsang hobounaw um lei lante khaleih a ccingpaw na thua nawlan oh, athangnaw cia la ngaesang oh.</para>
  <para style="p">
    <verse number="5" style="v" />Nanning lukhakheit nynh hawnaw abou ze, Pachia kha ngiakuh sah, pawccecize seibe leite ccungccaw balyn kha hysahte a pyatu Pachia nynh tuh-e paw tuh hawnaw a pya cih. <verse number="6" style="v" />Thuasalama lunghiinnaw hoi leite, zynnaw te ngiakuh sah, pawccecize lunghiinnaw a hoipaw tuh khisan nynh mung zah athekuhpaw rili tuileih te nynh aloku. <verse number="7" style="v" />Pawccecize tuhcihawpaw ccungccaw nynh tuh Bawipaw kyate ccangkhakheit ka mue cih cite tuakuh nan sah. <verse number="8" style="v" />Tuhcite thinlung apheipaw ccungccaw tuh a cyipaw miakaw kya atyn leipaw nynh thua.</para>
  <para style="s1">Ryachinaw te Hoirumnaw</para>
  <para style="p">
    <verse number="9" style="v" />Zakawsangpaw uno nynh tuh amaw kha hangthung athuanaw kyakhe a lungtua sah. <verse number="10" style="v" />Mihoipaw nynh tuh amaw kha sawbung athuanaw kyakhe a lungtua sah. Pawccecize aning tuh ramkaw e haetapaw hawte azo cih.<note caller="-" style="x"><char style="xo" closed="false">1.10-11: </char><char style="xt" closed="false"><ref loc="ISA 40:6-7">Isa 40.6-7</ref> (LXX)</char></note> <verse number="11" style="v" />Pawccecize khuanin nynh asopaw ryte he yn thuathung tuh lonua kha naansah zah tuh-e haetapaw tuh khuakuh zah a puithyanaw tuh azo; tuhawte mihoipaw mah a ryasuh cciamang lyakhe azo cih.</para>
  <para style="s1">Tuhounaw</para>
  <para style="p">
    <verse number="12" style="v" />Tuhounaw kha a ngaesangpaw ccungccaw tuh hythua ccoupaw nynh thua; pawccecize aning tuh syntaw he athua koute Bawipaw nynh amaw a sungsah hae paw elang bya a kinpyaku hae paw hiinnaw bawilukhung kha a mue cih. <verse number="13" style="v" />Tuhounaw kha a tung vae ze, “Pachia nynh kae tuh yn tuhou,” cite hum nynh sanmah ho nan sah; pawccecize hoyleinaw nynh Pachia kha tuhou kho khyh, amaw nynh mah hum sanmah tuhou boi khyh. <verse number="14" style="v" />Thuasalama ccungccaw tuh amaw a pynsaw rynaw nynh soih zah he a sue vae ze, aning tuh ling athua vae. <verse number="15" style="v" />Pynsaw rynaw nynh ccaawpoi zah seinaw kha a saah, seinaw nynh he ale tuh chinaw kha a thuakhae. <verse number="16" style="v" />Ka sungsahpaw uteno hae, la lingsakuh nan oh.</para>
  <para style="p">
    <verse number="17" style="v" />Ahoypaw lasung miakaw te accingpaw lasung miakaw tuh aluki langte, awnaw hae mih Paaw kyate nynh oun thua hae. Amaw kya tuh rulaekunaw um khyh zah apaleihkuhpaw mynlyh cipaw um boi khyh. <verse number="18" style="v" />Aening tuh amaw nynh a rae hae paw balyn kyaze masaty athae ah thua nawlan oh, amaw a rynaw thyhte byaccing kya-e bya khate aening kha oun rae.</para>
  <para style="s1">Bya Thaenaw te Zuinaw</para>
  <para style="p">
    <verse number="19" style="v" />Ka sungsahpaw uteno hae, ccungccaw miakaw tuh nawthae lan a thyrang sah, byaho lan te thinria lan a thysung sah. <verse number="20" style="v" />Pawccecize ccungccaw thinrianaw nynh Pachia kya-e dingnaw kha poukhae khyh. <verse number="21" style="v" />Tukeiccuze nungsikunaw balyn te paepae luipaw hoyleinaw kha vua oh lah, nae muisaw a khum khopaw, nae lungkhu kya sang athuapaw Pachia bya kha lungnenaw te lawkuh oh.</para>
  <para style="p">
    <verse number="22" style="v" />Naemaw te naemaw kha lingkute bya a thaetu hae kyalya thua nan oh. A bya a cyihtu hae la thua oh. <verse number="23" style="v" />Pawccecize lukhakheit nynh bya kha thae zah a cyi khyh ze, aning tuh a puikhaepaw a mae kha muinsado kya a dokuhpaw ccungccaw te nynh aloku. <verse number="24" style="v" />Pawccecize aning nynh amaw te amaw a dokuh koute po cceih zah a muinsan kha phe a ningku kangmaw. <verse number="25" style="v" />Thuasalama luenaw te asekuhpaw accingpaw kawbya kha do zah tuh-e kya po atynpaw ccungccaw tuh thae zah a ningthyapaw ccungccaw thua leite, rya a lahtu nynh thua; aning tuh a ryalaw kya hythua ccoupaw athua cih.</para>
  <para style="p">
    <verse number="26" style="v" />Nanning lukhakheit nynh beiknaw lante a zuakuhpaw nynh ka thua cite tuakuh zah a munglae a sungku khyh ze, aning tuh amaw a thinlung a lingkuhpaw nynh thua; tuh-e paw a beiknaw tuh accakaepaw nynh thua. <verse number="27" style="v" />Paaw Pachia malang athyaapaw te anungsikuh leipaw beiknaw tuh e hynh nynh thua: Ngawraw hae te nomae hae kha mih vawsawnaw kya do-oihpaw te ahmaw mah laephi vaw e anungsikuhpaw kya kalouhku leite umpaw kha nynh thua.</para>
  <chapter number="2" style="c" />
  <para style="s1">Laesakunaw Hoi Nan Oh</para>
  <para style="p">
    <verse number="1" style="v" />Ka u te ka neitaw hae, phu-enaw Bawipaw athuapaw, ah Bawipaw Jesu Khri zynnaw kya ccungccaw laesahnaw la hoi nan oh. <verse number="2" style="v" />Nanning na pumkunaw oh kalan ccungccaw lu kheit nynh sui kuihpu te apuithyapaw uccaw lawkute yn teebua zah, a ryachipaw mah anyaapaw uccaw lawkute yn teebua ze, <verse number="3" style="v" />apuithyapaw uccaw te yn ccaankuhpaw kha saw na tua oh zah, “E ahoypaw hmin kyahin haung,” na cipah oh zah, a ryachipaw kha, “Khuhlang khuin la thadyn, tuhkhyhze e ka ccu nungnaw kyahin yn haung,” na cipya oh lanze, <verse number="4" style="v" />naemaw te naemaw laku laesakunaw na hoi oh zah athahpaw tuanaw te bya a piatu hae khaw na thua oh? <verse number="5" style="v" />Ka sungsahpaw uteno hae, la ngaetua oh. Hynh-e laephi kya-e ryachi hae hynh zynnaw kya hoirum khylan thuasah, amaw a sungsah hae paw hanlan bya a kinpyaku vae hae paw, peenaw rho kha ccou khylan thuasah Pachia nynh po khyh hae tou? <verse number="6" style="v" />Thuasalama nanning nynh ryachi hae kha pawlang na ria khyh oh. A hoirum hae paw nynh nanning kha ae tuaa ae sah khyh oh tou? Byapianaw zung lang ae sue khyh oh tou? <verse number="7" style="v" />Nanning ae konaw oh paw, aphutepaw min kha minmin nynh thethya ho khyh hae tou?</para>
  <para style="p">
    <verse number="8" style="v" />“Na innpaw kha namaw hawkhate na sungsah cih,” acikuhpaw Ccathyaa thyhte alesaepaw kawbya kha na ccingsah ccaccing oh ze, kou hoy lan na cyi vae oh.<note caller="-" style="x"><char style="xo" closed="false">2.8: </char><char style="xt" closed="false"><ref loc="LEV 19:18">Lev 19.18</ref></char></note> <verse number="9" style="v" />Thuasalama mirymihua na po oh ze, a sei hae paw nynh na thua oh. Kawbya a lawe hae paw hawte kawbya nynh a sei cite a nysaku hae paw nynh na thua oh. <verse number="10" style="v" />Pawccecize humhung zemah Kawbya balyn kha marya zui salamah ccangkheit kya a mesei lanze, aning tuh kawbya marya a meseipaw nynh thua. <verse number="11" style="v" />Pawccecize, “Milae zu milae vawpaw kya sei nan,” cite a hotupaw nynh, “Ccungccaw theih nan,” cite mah a hobia. Nang tuh milae zu milae vawpaw kya na sei khyh zemah ccungccaw na chia ze, kawbya zui leipaw nynh na thua.<note caller="-" style="x"><char style="xo" closed="false">2.11: </char><char style="xt" closed="false"><ref loc="EXO 20:13">Exo 20.13</ref>, <ref loc="EXO 20:14">14</ref>; <ref loc="DEU 5:17">Deu 5.17</ref>, <ref loc="DEU 5:18">18</ref></char></note> <verse number="12" style="v" />Luenaw te asekuhpaw kawbya khate byapia athua cih hae paw hawte, nanning mah byaho oh lah tuhte cyih oh. <verse number="13" style="v" />Pawccecize ngaethyaumsahnaw a langsakuh leipaw ccungccaw tuh ngaethyaumsahnaw leite byapianaw kha a mue cih. Ngaethyaumsahnaw nynh byapianaw kha phe a tae.</para>
  <para style="s1">Cyisahnaw Um leipaw Zynnaw</para>
  <para style="p">
    <verse number="14" style="v" />Ka u te ka neitaw hae, ccungccaw lu kheit nynh zynnaw ka hoi a ci zemah cyisahnaw a hoi khyh ze pawmou athane? Tuh-e zynnaw nynh amaw kha a khum kho cih tou? <verse number="15" style="v" />Uno lu kheit tuhkhyhze ccianung lu kheit tuh boeining leite um zah nin takyh ae lanpaw looh hoi leite a um lanze, <verse number="16" style="v" />nanning lukhakheit nynh minmin kha, “Daebabi lan la cceih oh, nae khua la lung sah lah, nae vue la so sah,” cite hopah hae zah, pyn hanlan ahopaw uccaw hae kha a pya khyh hae ze, pawmou athane? <verse number="17" style="v" />Tuhawte zynnaw mah cyisahnaw um leite, a makhaete tuh achihpaw nynh thua.</para>
  <para style="p">
    <verse number="18" style="v" />Thuasalama ccungccaw lukhakheit nynh, “Nang tuh zynnaw na hoi zah, kae tuh cyisahnaw ka hoi, na cyisahnaw um leite na zynnaw tuh yn langsahpya tua; kae tuh ka zynnaw kha ka cyisahnaw hae liate kae langsahpah cih,” a ci ze a ci cih. <verse number="19" style="v" />Nang nynh Pachia ccangkheit nynh a um cite na zyn, kou ahoy. Raerangsaro hae nynh heize zyn hae zah a thyngkuh hae. <verse number="20" style="v" />Pou mingaeepaw! Cyisahnaw um leite zynnaw tuh a chih cipaw hynh na nyh ry tou? <verse number="21" style="v" />Ah minpaaw Abraham nynh silawhang vawlan a ccapaw Isak kha silawnaw lang he a pya tuh, cyisahnaw liate thyaaccou khyh tou?<note caller="-" style="x"><char style="xo" closed="false">2.21: </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">Gen 22.1-14</ref></char></note> <verse number="22" style="v" />A zynnaw tuh a cyisahnaw ryte ryalahkheih hae zah, cyisahnaw liate nynh zynnaw tuh accing cipaw kha na muih. <verse number="23" style="v" />“Abraham nynh Pachia kha zyn zah tuh-e a zynnaw tuh dingnaw lang a riapya,” acikuhpaw Ccathyaa tuh phe accing; aning tuh Pachia banpaw cite ko athua.<note caller="-" style="x"><char style="xo" closed="false">2.23: </char><char style="xt" closed="false"><ref loc="GEN 15:6">Gen 15.6</ref>; <ref loc="2CH 20:7">2Sh 20.7</ref>; <ref loc="ISA 41:8">Isa 41.8</ref></char></note> <verse number="24" style="v" />Ccungccaw tuh zynnaw kyalya te thua leite, cyisahnaw liate nynh thyaaccou athua cipaw kha na muih oh. <verse number="25" style="v" />Tuhawte ohhuanung Rahab kha mah, zeccuetu hae kha innccong ua hae zah ccangpaw laanpi kalan he a saw hae tuh, cyisahnaw liate aning tuh thyaaccou khyh tou?<note caller="-" style="x"><char style="xo" closed="false">2.25: </char><char style="xt" closed="false"><ref loc="JOS 2:1-21">Jos 2.1-21</ref></char></note> <verse number="26" style="v" />Pawccecize muisaw um leipaw pyn tuh a chih, tuhawte cyisahnaw um leipaw zynnaw mah achihpaw nynh thua.</para>
  <chapter number="3" style="c" />
  <para style="s1">Munglae Sungkunaw</para>
  <para style="p">
    <verse number="1" style="v" />Ka u te ka neitaw hae, sazae kae thuapaw kaening tuh aru huapaw byapianaw kha kae mue cih cipaw nyte, ccangpahtu lang patae la tang nan oh. <verse number="2" style="v" />Pawccecize aening balyn tuh patae ah mesei oh. Bya a honaw kya a mesei leipaw ccungccaw tuh a pyn balyn kha a taekuh khopaw thua zah accingpaw nynh thua. <verse number="3" style="v" />Marang hae nynh aening kaw a ngae ccaw hae cite mih mung kya rangtei ah teisah oh zah, mih pyn balyn kha ah mae kho oh. <verse number="4" style="v" />Sanphalung hae kha mah dotua oh, myarya le hae zah khisan arupaw nynh a mung kho zemah a mawngtupaw nynh ditaripaw maenawpaw khate a rynaw langkhe a mae.</para>
  <para style="p">
    <verse number="5" style="v" />Tuhawte lae tuh pyn kya-e ditaripaw athua zemah myarya a pookuh thya. Maee-ia taraw nynh myarya akopaw loram kha a u kho cipaw tuatua oh! <verse number="6" style="v" />Lae tuh maee nynh thua. Lae tuh pyn kya-e hae kyaze hoyleinaw asueluakunaw thua zah, pyn balyn kha a thusah; ccungccaw hiinnaw balyn kha phe ccung lan u zah, amaw kha mah hell maee nynh a u. <verse number="7" style="v" />Pawccecize ramsaw phuin miakaw, pavaw phuin, vue te a vawpaw phuin, rili kya umpaw ngasaw phuin kha ngaesah kho thua zah ccungccaw hae nynh phe a la ngaesah hae. <verse number="8" style="v" />Thuasalama lae tuh hum nynh sanmah ngaesah kho khyh, uk kho leipaw athahpaw uccaw thua zah, a chisah khopaw asy te nynh phe abia. <verse number="9" style="v" />Tuh-e lae te ah Paaw Pachia kha the ah hoysah oh; Pachia muinsan alo lante raepaw ccungccaw hae kha tuh-e lae te thya ah law oh.<note caller="-" style="x"><char style="xo" closed="false">3.9: </char><char style="xt" closed="false"><ref loc="GEN 1:26">Gen 1.26</ref></char></note> <verse number="10" style="v" />Khalang ccangkheit kyate hythuanaw te thyalawnaw kha yn pou. Ka u te ka neitaw hae, tuhte cyiku lan ccan khyh. <verse number="11" style="v" />Tuidy ccangkheit kyate tui epaw te tui khahpaw a pou boi tou? <verse number="12" style="v" />Ka u te ka neitaw hae, thaeku ku nynh oliv thae kha athae kho tou? Misu ku nynh thaeku thae kha athae kho tou? Tuhawte loituipaw nynh tuithuapaw kha pousah boi khyh.</para>
  <para style="s1">Hawnaw Phuin Ning</para>
  <para style="p">
    <verse number="13" style="v" />Nanning laku a hawpaw te a thaethyapaw hummou a um? Aning nynh hawnaw kya-e lungnenaw te ahoypaw a hiinnaw khate a ryalaw kha langsakuh sah. <verse number="14" style="v" />Thuasalama nae thinlung kya akhahpaw eiungnaw te karankunaw na hoi oh ze, pookuh nan oh lah byaccing kha rawsete hyn nan oh. <verse number="15" style="v" />Tuh-e hawnaw tuh luki langte yn thuapaw thua khyh, laephi hawnaw, pynsaw hawnaw te Satan hawnaw nynh thua. <verse number="16" style="v" />Pawccecize eiungnaw te karankunaw a umnaw tuh keisukeilae umnaw te hoyleinaw aphuinphuin a um. <verse number="17" style="v" />Thuasalama luki langte yn thuapaw hawnaw tuh masaty lan thyaararih, tukoute ccawkunaw te lungnenaw um zah soih lan azoi, ngaethyaumsahnaw te ahoypaw athae khate phe abeih, laesahkunaw te cyiruhnaw um khyh. <verse number="18" style="v" />Ccawkunaw a raetu hae nynh dingnaw ccacii kha daenaw te a vua hae.</para>
  <chapter number="4" style="c" />
  <para style="s1">Laephi te Vaeccawkunaw</para>
  <para style="p">
    <verse number="1" style="v" />Nanning laku rhawtukkunaw te pekunaw tuh paw kyate mou oun thua hae? Nae pyn kya-e hae kya rhaw a tukkuh hae paw nae pynsaw hoysahnaw kyate oun thua khyh hae tou? <verse number="2" style="v" />Na ry oh zah na hoi khyh oh keiccu ccungccaw na chia oh. Na duaa oh zah na mue khyh oh; tukeiccuze na buakuh oh zah rhaw na tukkuh oh. Na ngia khyh oh keiccu na mue khyh oh. <verse number="3" style="v" />Na ngia oh zemah na mue khyh oh; pawccecize naemaw hoysahnaw kya mang khylan na ngiasei oh. <verse number="4" style="v" />Zyn lan um leipaw ccungccaw hae! Laephi te vaeccawkunaw tuh Pachia ryte rhawkunaw nynh thua cipaw kha na nyh khyh oh tou? Tukeiccuze laephi te ruiban lang a tang rypaw tuh Pachia rhawpaw lang a raekuhpaw nynh thua. <verse number="5" style="v" />“Pachia nynh aening lungkhu a nungpaw muisaw tuh a eiungpaw rynaw te phe abeih,” cite Ccathyaa nynh a hopaw hynh accakaepaw nynh thua cite tou na tua oh? <verse number="6" style="v" />Thuasalama Pachia nynh houh ale huapaw thawccinaw kha oun pya. Tukeiccuze,</para>
  <para style="q1">“Pachia tuh a lysakuh hae paw kha</para>
  <para style="q2">rawse hae zah,</para>
  <para style="q1">zakawsangsakuh hae paw kha</para>
  <para style="q2">thaw a cci hae,” a ci.<note caller="-" style="x"><char style="xo" closed="false">4.6: </char><char style="xt" closed="false"><ref loc="PRO 3:34">Ptb 3.34</ref> (LXX)</char></note></para>
  <para style="m">
    <verse number="7" style="v" />Tukeiccuze Pachia rynaw kha zui oh. Satan kha dou oh lah, nanning kha ae ccuetaw cih oh. <verse number="8" style="v" />Pachia kalan naekuh oh lah, aning mah nae kalan a naekuh cih. Misei hae, nae kuih kha ccikankuh oh, thinlung aphei hae paw, nae thinlung kha thyaasakuh oh. <verse number="9" style="v" />Ngaethyate um oh, rawkhuite um oh lah rah oh. Nae nuinthuanaw kha rawkhuinaw lang tang sah oh lah, nae lungtuanaw kha ngaethyanaw lang tang sah oh. <verse number="10" style="v" />Bawipaw malang zakawsangsakuh oh lah, aning nynh ae hangthung cih oh.</para>
  <para style="s1">Na Uno kha Byapia Nan</para>
  <para style="p">
    <verse number="11" style="v" />Uteno hae, lu kheit te lu kheit thethya hokuh nan oh. A uno kha thethya ho zah bya a piapaw ccungccaw tuh kawbya kha thethya ho zah bya a piatu nynh thua. Nang nynh kawbya kha bya na pia ze, nang tuh kawbya a zuipaw thua leite bya a piatupaw nynh na thua. <verse number="12" style="v" />Kawbya pyatu te byapiatu lu kheit kyalya um zah, aning tuh a khum khopaw te a roh khopaw nynh thua. Mingccangpaw kha bya a piatupaw nang tuh hummou na thua?</para>
  <para style="s1">Awkhualan hanlan Pookunaw</para>
  <para style="p">
    <verse number="13" style="v" />“Atunin athua khyhze awkhualan kya tuhcihawpaw khahcihawpaw khua lang ccia lan zah tuin kya kum kheit um lan, kungku lan zah amia mue lan,” cite a ho hae paw nanning, atu ngaetua oh!<note caller="-" style="x"><char style="xo" closed="false">4.13-14: </char><char style="xt" closed="false"><ref loc="PRO 27:1">Ptb 27.1</ref></char></note> <verse number="14" style="v" />Awkhualan pawmou yn cyihkuh cih cipaw na nyh khyh oh. Nae hiinnaw tuh pawmou athua? Nanning tuh sosoh a langkuh koute phe avaepaw tuihu nynh na thua oh. <verse number="15" style="v" />“Bawipaw nynh a ry lanze, aening ah hiin cih oh zah, hynh-e khyhze tuh-e tuh ah cyih cih oh,” cite nynh na ho lan oh accan. <verse number="16" style="v" />Thuasalama atu nanning tuh na lysakuh oh zah na pookuh oh; khahcihawpaw pookunaw balyn tuh ahoy leipaw nynh thua. <verse number="17" style="v" />Tukeiccuze ahoypaw cyi lanpaw kha nyh zah a cyih leipaw tuh misei nynh thua.</para>
  <chapter number="5" style="c" />
  <para style="s1">Mihoi hae Raeringnaw Pyanaw</para>
  <para style="p">
    <verse number="1" style="v" />Mihoi hae, atu ngaetua oh! Nae tungvaw yn thua lanpaw vawsaw riathaenaw hanlan rawkhuite siatua oh. <verse number="2" style="v" />Nae hoirumnaw tuh baluh mawe vae, nae boeining tuh ripaw nynh a ae vae.<note caller="-" style="x"><char style="xo" closed="false">5.2-3: </char><char style="xt" closed="false"><ref loc="MAT 6:19">Mat 6.19</ref></char></note> <verse number="3" style="v" />Nae sui te nae ngun tuh chihhangkae zah, tuh-e chihhangkaepaw nynh nanning kha rawsete ccaekia lang a tang cih zah maee hawte nae ngesaw kha a ae cih. Nyathyakou e nin hae hanlan nynh sisua kha na ccakhungku oh. <verse number="4" style="v" />Ngaetua oh, nae leikua hae kya ccatan aw hae paw ryalahtu hae kha ryalaw mee pya leite na hynpah oh zah, mih ryalaw mee nynh a sia hae. Loohruetu hae siaruanaw tuh Vaaw Bawipaw nakaring kya phe a thua vae.<note caller="-" style="x"><char style="xo" closed="false">5.4: </char><char style="xt" closed="false"><ref loc="DEU 24:14-15">Deu 24.14-15</ref></char></note> <verse number="5" style="v" />Laephi vawlan hoysahnaw kya na hiin oh zah na hoysah oh. Chia nin hanlan nae thinlung kha thobaleih lan na thosahku vae oh. <verse number="6" style="v" />Midingpaw kha sei na be oh zah na chia oh; aning nynh nanning kha ae rawse ru khyh oh.</para>
  <para style="s1">Teingnaw kya Lungsaenaw</para>
  <para style="p">
    <verse number="7" style="v" />Tukeiccuze uteno hae, Bawipaw yn thua cia lungsaete la ngaw oh. Dotua oh, loophopaw nynh khuaatui te hawkhuaa kha a mue cia, laephi kya-e aphutepaw athae-apaw kha lungsaete phang a ngawdae. <verse number="8" style="v" />Nanning mah nae lungsae sah, nae thinlung kha tynsah oh; pawccecize Bawipaw yn thuanaw lanpaw tuh anae vae. <verse number="9" style="v" />Uteno hae, byapia na thua khyh nawlan oh, lu kheit te lu kheit ccohnuakuh nan oh; dotua oh, byapiatu tuh thuakaw malang phang a thadyn. <verse number="10" style="v" />Ka u te ka neitaw hae, Bawipaw min te bya a ho hae paw profeh hae kha vawsaw teingnaw te lungsaenaw hanlan dosuinkupaw lang la lawkuh oh. <verse number="11" style="v" />Dotua oh, a ngaesang kho hae paw tuh hythuaccou hae paw ah ci oh. Job nynh a ngaesangnaw kong te nyathyakou kya Bawipaw nynh a pyapaw kong kha na thae vae oh. Bawipaw tuh myarya thawccih thyapaw te ngaethyaumsah thyapaw nynh thua cipaw na ny vae oh.<note caller="-" style="x"><char style="xo" closed="false">5.11: </char><char style="xt" closed="false"><ref loc="JOB 1:21-22">Job 1.21-22</ref>, <ref loc="JOB 2:10">2.10</ref>; <ref loc="PSA 103:8">Sam 103.8</ref></char></note></para>
  <para style="p">
    <verse number="12" style="v" />Thuasalama ka u te ka neitaw hae, pawpaw balyn kya thyalawkuh nan oh; vaawlang te thuasah, laephi te thuasah, byakinkunaw ccangkhakheit te mah thuasah thyalawkuh nan oh. Thuasalama byapianaw lungkhu lang na phungku sei khyh nawlan oh, athuapaw kha “athua” ci oh lah, athua leipaw kha “thua khyh” ci oh.<note caller="-" style="x"><char style="xo" closed="false">5.12: </char><char style="xt" closed="false"><ref loc="MAT 5:34-37">Mat 5.34-37</ref></char></note></para>
  <para style="s1">Zynnaw Sawsangnaw</para>
  <para style="p">
    <verse number="13" style="v" />Nanning laku vawsaw a teingpaw a um tou? A um ze sawsang sah. A lungtuapaw a um tou? A um ze thehoysahnaw hlaw kha sah sah. <verse number="14" style="v" />Nanning laku ngeccih a um tou? A um ze khriccaawbuu kya-e pastor hae kha ko hae sah lah, minmin nynh Bawipaw min te chitui thuhpah hae sah lah, sawsangpah hae sah.<note caller="-" style="x"><char style="xo" closed="false">5.14: </char><char style="xt" closed="false"><ref loc="MRK 6:13">Mar 6.13</ref></char></note> <verse number="15" style="v" />Zynnaw kya-e sawsangnaw nynh ngeccih kha a khum cih zah, Bawipaw nynh tuh-e ngeccih tuh a thosah cih. Seinaw a la rae ze, aning tuh ngaethya athua cih. <verse number="16" style="v" />Tukeiccuze na cyisei oh paw kha lu kheit te lu kheit hopakuh oh lah, dansah na thua nawlan oh lu kheit te lu kheit sawsangpakuh oh. Midingpaw sawsangnaw tuh myarya a thawsae zah athane. <verse number="17" style="v" />Elijah tuh aening tahawpaw ccungccaw nynh thua; aning nynh khuaa araw khyh nawlan thawte saw a sang; te laephi vawlan kum thum te sawpaw sah taruh cia khuaarah khyh.<note caller="-" style="x"><char style="xo" closed="false">5.17: </char><char style="xt" closed="false"><ref loc="1KI 17:1">1Si 17.1</ref>, <ref loc="1KI 18:1">18.1</ref></char></note> <verse number="18" style="v" />Aning nynh saw bua sang zah vaawlang nynh khuaa a rawsah, te laephi nynh a thae a pousah.<note caller="-" style="x"><char style="xo" closed="false">5.18: </char><char style="xt" closed="false"><ref loc="1KI 18:42-45">1Si 18.42-45</ref></char></note></para>
  <para style="p">
    <verse number="19" style="v" />Uteno hae, nanning lakuze lukhakheit tuh byaccing kyate cceihsei zah, lukhakheit nynh amaw kha a paleihsaku lanze, <verse number="20" style="v" />miseipaw kha a cciaseinaw kyate a paleihsakuhpaw ccungccaw nynh tuh-e paw muisaw kha chinaw kyate a khum cih zah, seinaw patae kha a bongpah cih cipaw kha la nyh sah.<note caller="-" style="x"><char style="xo" closed="false">5.20: </char><char style="xt" closed="false"><ref loc="PRO 10:12">Ptb 10.12</ref>; <ref loc="1PE 4:8">1Pe 4.8</ref></char></note></para>
</usx>