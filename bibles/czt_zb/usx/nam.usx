<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="NAM" style="id">Baebu Thyaa</book>
  <para style="h">NAHUM</para>
  <para style="toc1">Nahum</para>
  <para style="toc2">NAHUM</para>
  <para style="toc3">Nah</para>
  <para style="mt1">NAHUM</para>
  <para style="mt2">Nahum</para>
  <para style="imt">Byalaanmaw</para>
  <para style="ip">Nahum ccauh hynh langmawlya Israel a tuaa a sahpaw rhaw, Assiria khuapi Nineveh khua a ronaw lungpawnaw hlaw nynh thua. BC 600 athang dyn kya Nineveh khua a ropaw hynh a rysawthahpaw te a lungkhungpaw minphuin kha Pachia nynh bya a pia cinawpaw nynh thua cite muih lan a um.</para>
  <para style="iot">Abyalupi hae</para>
  <para style="io1">Nineveh tungvaw byapianaw 1.1-15</para>
  <para style="io1">Nineveh ronaw 2.1—3.19</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Elkosh khuapaw Nahum nynh Nineveh khua konglang a muihpaw vizin ccauh.<note caller="-" style="x"><char style="xo" closed="false">1.1—3.19: </char><char style="xt" closed="false"><ref loc="ISA 10:5-34">Isa 10.5-34</ref>, <ref loc="ISA 14:24-27">14.24-27</ref>; <ref loc="ZEP 2:13-15">Zef 2.13-15</ref></char></note></para>
  <para style="b" />
  <para style="s1">Pachia Thinrianaw</para>
  <para style="q1">
    <verse number="2" style="v" />
    <char style="nd">Bawipaw </char> tuh a eiungpaw te</para>
  <para style="q2">phulaw a mangpaw Pachia nynh thua,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh phulah hae zah</para>
  <para style="q2">myarya a thinria;</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh amaw a rawsetu hae kha</para>
  <para style="q2">phulah hae zah,</para>
  <para style="q2">a rhaw hae tungvaw myarya a thinria.</para>
  <para style="q1">
    <verse number="3" style="v" />
    <char style="nd">Bawipaw </char> tuh a lungsae,</para>
  <para style="q2">thuasalama a huhan myarya ale,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh a sei hae paw kha</para>
  <para style="q2">detah leite cciasah lan khyh hae.</para>
  <para style="b" />
  <para style="q1">
    <char style="nd">Bawipaw </char> tuh khiccung te</para>
  <para style="q2">khise kya cceih zah, maeking hae tuh</para>
  <para style="q2">a ccukaw umpaw vuiping nynh thua hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Rili kha pe zah a rousah,</para>
  <para style="q2">vaw hae balyn kha</para>
  <para style="q1">a kansah hae;</para>
  <para style="q2">Bashan mua te Karmel mua tuh</para>
  <para style="q1">rou hae zah,</para>
  <para style="q2">Lebanon haetapaw hae tuh</para>
  <para style="q2">anaan hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Amaw malang khe mua hae tuh</para>
  <para style="q2">hy hae zah, sangpyng hae tuh</para>
  <para style="q1">atui hae; amaw malang khe</para>
  <para style="q2">laephi tuh hy zah,</para>
  <para style="q1">laephipi te a vawlan</para>
  <para style="q2">um hae paw balyn tuh ahy hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" />A thin-unaw malang khe</para>
  <para style="q2">hummou a thadyn kho cih?</para>
  <para style="q1">A thinrianaw kha hummou</para>
  <para style="q2">a ngaesang kho cih?</para>
  <para style="q1">A bungpawnaw tuh maee hawte rua zah,</para>
  <para style="q2">a malang khe lung hae tuh</para>
  <para style="q2">zoihtatyh lan akoi hae.</para>
  <para style="q1">
    <verse number="7" style="v" />
    <char style="nd">Bawipaw </char> tuh ahoy,</para>
  <para style="q2">vawsaw tung ccyh lya</para>
  <para style="q1">khynnaw hmin nynh thua;</para>
  <para style="q2">amaw kya a rekuh hae paw kha</para>
  <para style="q2">thungkhaw hae zah,</para>
  <para style="q1">
    <verse number="8" style="v" />tuileih athopaw kya mah</para>
  <para style="q2">a thungkhaw hae.</para>
  <para style="q1">Amaw a rawse hae paw kha</para>
  <para style="q2">khaleih a thangsah cih hae,</para>
  <para style="q1">a rhaw hae kha amohnaw langkhe</para>
  <para style="q2">a deehui cih hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Pawkeiccumou <char style="nd">Bawipaw </char> kha</para>
  <para style="q2">rawsete na paccynnuaku?</para>
  <para style="q1">Aning nynh nang kha ae thangsah cih;</para>
  <para style="q2">amaw a rawsetu hae tuh</para>
  <para style="q2">vae ning thokuh lan khyh hae.</para>
  <para style="q1">
    <verse number="10" style="v" />Hinpaw ku hawte khelekuh hae zah,</para>
  <para style="q2">samaw ruipaw hawte a rui hae;</para>
  <para style="q1">ccatanphue aroupaw hawte</para>
  <para style="q2">maee nynh phe ccung lan a u hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" />Pou Nineveh, <char style="nd">Bawipaw </char> kha rawsete</para>
  <para style="q2">ahoy leipaw a paccynnuakuhpaw,</para>
  <para style="q1">ahoy leipaw tuanaw pyatu kha</para>
  <para style="q2">na kyate a langkuh vae.</para>
  <para style="b" />
  <para style="s1">Judah hanlan Thehoypaw</para>
  <para style="q1">
    <verse number="12" style="v" />
    <char style="nd">Bawipaw </char> nynh hynhte a ho,</para>
  <para style="q1">“Assiria hae tuh thawzung te</para>
  <para style="q2">phe beih hae zah milu alung hae zemah,</para>
  <para style="q1">vua athua cih hae zah azo cih hae.</para>
  <para style="q2">Nanning kha vawsaw</para>
  <para style="q1">kae la teingsah oh zemah,</para>
  <para style="q2">atu te vawsaw kae pya vae lan khyh oh,” a ci.</para>
  <para style="q1">
    <verse number="13" style="v" />Assiria nynh ae puihsah oh paw</para>
  <para style="q2">a puihnawpaw ccong kha</para>
  <para style="q1">kae khyapah cih oh zah,</para>
  <para style="q2">ae heedenaw oh paw arui kha</para>
  <para style="q1">kae paepah cih oh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" />Nanning te asekuh lante</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh kaw a thopaw tuh:</para>
  <para style="q1">“Na min a tynsah lanpaw</para>
  <para style="q2">ciihan um vae lan khyh;</para>
  <para style="q1">na soiikupaw te na laeekupaw</para>
  <para style="q2">zohtuh hae kha</para>
  <para style="q1">na pachia hae inn kyate ka roh cih.</para>
  <para style="q2">Nang tuh ccungkiapaw na thua vae khyh,</para>
  <para style="q1">tukeiccuze shawku kae raepah cih,” a ci.</para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" />Thehoypaw yn phupaw te</para>
  <para style="q2">daenaw kong a phypaw</para>
  <para style="q1">mua vawlan e ccungccapaw ccu khuh</para>
  <para style="q2">dotua oh!</para>
  <para style="q1">Pou Judah, na poi kha tua lah,</para>
  <para style="q2">bya na kinkupaw kha ccingsah tua,</para>
  <para style="q1">pawccecize ccungccaw hoyleipaw nynh</para>
  <para style="q2">nang kha teenuate ae thiing vae lan khyh;</para>
  <para style="q1">minmin kha khaleih ro athua vae hae.<note caller="-" style="x"><char style="xo" closed="false">1.15: </char><char style="xt" closed="false"><ref loc="ISA 52:7">Isa 52.7</ref></char></note></para>
  <chapter number="2" style="c" />
  <para style="s1">Khuapi Hoyleipaw Ronaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou Nineveh, rohtupaw nynh</para>
  <para style="q2">nang kha ae ccianua thung vae.</para>
  <para style="q1">Na rhawlungrua hae kha phang rintua;</para>
  <para style="q2">laanpi kha phang ngaw lah,</para>
  <para style="q1">rhawtuk lan paccynku tua;</para>
  <para style="q2">na thawzung balyn kha thuatua.</para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" />(Pawccecize rohtu hae nynh minmin kha roh hae zah,</para>
  <para style="q2">mih karan hae kha a ro hae zemah</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh Israel lesaenaw hawte</para>
  <para style="q2">Jakob lesaenaw kha a pyathui vae.)</para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" />A rhawkaw hae tuh asepaw</para>
  <para style="q2">khawriaphua kha mang hae zah,</para>
  <para style="q1">sephaphuhpaw boeining kha</para>
  <para style="q2">a lawkuh hae.</para>
  <para style="q1">A rhawkaw hae kha ataruinte</para>
  <para style="q2">a thadynsah lya hae khe,</para>
  <para style="q1">marangle hae kya-e</para>
  <para style="q2">sivaw zunghe hae tuh</para>
  <para style="q2">phaephae ak hae;</para>
  <para style="q1">ccoi hae tuh valahvalah</para>
  <para style="q2">a hekuh hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Marangle hae tuh laanpi hae kya</para>
  <para style="q2">keisukeilae lante ccue hae zah,</para>
  <para style="q1">khualae lungkhu kya thawte</para>
  <para style="q2">a ccue bungthung hae;</para>
  <para style="q1">mih muinsan tuh maeesoitung te</para>
  <para style="q2">lokuh zah, khozawlaekuhpaw hawte</para>
  <para style="q2">myarya arang hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Rohtupaw nynh a kuihkaw e</para>
  <para style="q2">bawi hae kha a ko hae;</para>
  <para style="q1">minmin tuh khakhah pawkuh lan</para>
  <para style="q2">malang a cceih hae;</para>
  <para style="q1">khualungrua kalan khe</para>
  <para style="q2">arangte cceih hae zah,</para>
  <para style="q1">khualungrua kyakhe</para>
  <para style="q2">thungkhawkunawpaw</para>
  <para style="q1">khawriaphua khate</para>
  <para style="q2">a thungkhaw hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Vawkhu thuakaw hae kha</para>
  <para style="q2">hung thua zah, siapharan inn tuh a thyngkuh.</para>
  <para style="q1">
    <verse number="7" style="v" />Khuapi kha kyngte cciakhae</para>
  <para style="q2">athua cih cite kawtho athua vae,</para>
  <para style="q1">a seenung hae kha</para>
  <para style="q2">cciakhae athua cih hae,</para>
  <para style="q1">minmin tuh vahu hawte</para>
  <para style="q2">a khui cih hae zah,</para>
  <para style="q2">mih by a tukuh cih hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Nineveh khua tuh</para>
  <para style="q2">tui akanpaw kua te nynh aloku.</para>
  <para style="q1">“Thadyn oh! Thadyn oh!” cite</para>
  <para style="q2">a hopya hae zemah,</para>
  <para style="q1">lu kheit nynh sanmah</para>
  <para style="q2">nulang hawi khyh.</para>
  <para style="q1">
    <verse number="9" style="v" />Ngun kha luade oh,</para>
  <para style="q2">sui kha luade oh!</para>
  <para style="q1">Sisua tuh thangtae khyh!</para>
  <para style="q2">Aphutepaw uccaw phuin</para>
  <para style="q1">myarya alung!</para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" />Nineveh tuh aroh vae,</para>
  <para style="q2">ccungccaw daetedae zah,</para>
  <para style="q1">paw sanmah um vae khyh!</para>
  <para style="q2">Mih thinlung tuh a rawthah zah</para>
  <para style="q1">mih ccukharu a thyngkuh,</para>
  <para style="q2">mih thawthang zah,</para>
  <para style="q2">mih mae tuh dawkadae lan acih!</para>
  <para style="q1">
    <verse number="11" style="v" />Chindeih hae karung te</para>
  <para style="q2">chindeih taw hae nynh</para>
  <para style="q1">looh a aenaw hae hmin tuh</para>
  <para style="q2">pawlangmou a tang vae hae?</para>
  <para style="q1">Humhung nynh mah a risah</para>
  <para style="q2">kho lei hae paw chindeih tepaw,</para>
  <para style="q1">chindeih pinung te</para>
  <para style="q2">chindeih taw hae tuh</para>
  <para style="q2">teilangmou a ccia vae hae?</para>
  <para style="q1">
    <verse number="12" style="v" />Chindeih nynh a taw hae hanlan te</para>
  <para style="q2">chindeih pinung hanlan</para>
  <para style="q1">saw kha a teipya hae;</para>
  <para style="q2">a karung kha a teipaw saw hae khate</para>
  <para style="q1">phe a biasah.</para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" />Vaaw <char style="nd">Bawipaw </char> nynh a hopaw tuh, nang kha kae rawse, na marangle hae kha maeekhuh phe khuh lan maee te ka u cih zah, na chindeih taw hae kha thaloi te ka theih cih hae; na teipaw saw hae kha laephi kyate ka zosah cih zah, na locceihtu hae roi kha thae thua vae lan khyh.</para>
  <chapter number="3" style="c" />
  <para style="s1">Sibia Kho leipaw Ronaw</para>
  <para style="p">
    <verse number="1" style="v" />Chiise a luapaw khuapi,</para>
  <para style="q2">hynhunaw, luadepaw uccaw te</para>
  <para style="q1">phe beihpaw khuapi,</para>
  <para style="q2">luadenaw a thang kho leipaw</para>
  <para style="q2">khuapi hanlan ngaethya lan kou um!</para>
  <para style="q1">
    <verse number="2" style="v" />Ccungngue te buapaw roi,</para>
  <para style="q2">leccu miakuhpaw roi,</para>
  <para style="q1">marang ccukoh roi te</para>
  <para style="q2">marangle roi tuh ngaetua oh!</para>
  <para style="q1">
    <verse number="3" style="v" />Marang rhawkaw hae nynh</para>
  <para style="q2">a naangbia hae,</para>
  <para style="q1">thaloi hae tuh dalahdalah aw hae zah,</para>
  <para style="q2">ccoi hae tuh phaephae ak hae,</para>
  <para style="q1">a chih hae paw tuh</para>
  <para style="q2">patah pumkuh hae,</para>
  <para style="q1">michi rhua hae tuh riatae um khyh,</para>
  <para style="q2">tuh-e michi rhua hae vawlan khe</para>
  <para style="q2">a thy a pawkuh hae!</para>
  <para style="q1">
    <verse number="4" style="v" />Puithya zah ccungccaw a soihthyapaw,</para>
  <para style="q2">lunglawthyanaw khate thuasah,</para>
  <para style="q1">naaw a thyanaw khate thuasah</para>
  <para style="q2">minphuin hae te ccungccaw hae kha</para>
  <para style="q1">a see lang a tangsah hae paw</para>
  <para style="q2">ohhuanung nynh riatae lei</para>
  <para style="q2">a ohhuaku keiccuze,</para>
  <para style="q1">
    <verse number="5" style="v" />vaaw <char style="nd">Bawipaw </char> nynh a hopaw tuh,</para>
  <para style="q2">nang kha kae rawse zah,</para>
  <para style="q1">na boeipae kha na mae vawlan cia</para>
  <para style="q2">kae kalyng cih;</para>
  <para style="q1">na ccakaete na umpaw kha</para>
  <para style="q2">minphuin hae ka dosah cih hae zah,</para>
  <para style="q1">na maethyanaw kha</para>
  <para style="q2">peenaw hae ka dosah cih hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Anungsikuhpaw kha</para>
  <para style="q2">na tungvaw kae vuanua cih,</para>
  <para style="q1">pawlangria lei lante</para>
  <para style="q2">kae ccuepe cih zah,</para>
  <para style="q2">theihryate a do hae paw lang kae rae cih.</para>
  <para style="q1">
    <verse number="7" style="v" />Tetuh nang ae muih hae paw balyn tuh</para>
  <para style="q2">nulang a sihkuh cih hae zah,</para>
  <para style="q1">“Nineveh khua tuh aroh vae;</para>
  <para style="q2">hum nynh mou</para>
  <para style="q1">ngae a thyakhae cih?” cite a ho cih hae.</para>
  <para style="q2">Lungtangnaw ae pyatu kha</para>
  <para style="q1">pawkyamou kae ccungpah cih?</para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" />Nang tuh Nal vawpi pe umpaw</para>
  <para style="q2">Thebes khua laeze na hoyhua tou?</para>
  <para style="q1">Tuh-e khua tuh tui nynh po a koihlu,</para>
  <para style="q2">rili tuh atolang e</para>
  <para style="q1">rhawlungrua thua zah,</para>
  <para style="q2">tui tuh a khualungrua nynh thua.</para>
  <para style="q1">
    <verse number="9" style="v" />Ethiopia te Izip tuh</para>
  <para style="q2">a thawzung nynh thua hae,</para>
  <para style="q1">a thawzung tuh thangthya khyh;</para>
  <para style="q2">Put te Libia tuh</para>
  <para style="q1">aning a bawmtu hae nynh thua hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" />Tuhzemah Thebes khua kha</para>
  <para style="q2">rhaw hae nynh</para>
  <para style="q1">kyng hae zah a cciakhae hae,</para>
  <para style="q2">laanpi atungkunaw takyh kyakhe</para>
  <para style="q1">tuh-e khua kya-e imua taraw hae kha</para>
  <para style="q2">zoihtatyh lan a deihnaw hae;</para>
  <para style="q1">khua kya-e sawtuanaw</para>
  <para style="q2">a ccou hae paw kha</para>
  <para style="q1">ccungthydungte a neeku hae,</para>
  <para style="q2">alesaepaw bawi hae kha</para>
  <para style="q2">sivawrui te a khii hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Nineveh, nang mah</para>
  <para style="q2">aruipaw lang na tang cih zah</para>
  <para style="q1">zya na rekuh cih;</para>
  <para style="q2">rhaw kyate rekunaw hmin kha</para>
  <para style="q2">na ccungkuh cih.</para>
  <para style="q1">
    <verse number="12" style="v" />Na rhawlungrua hae balyn tuh</para>
  <para style="q2">masaty avoipaw</para>
  <para style="q1">thaeku thae hawte nynh athua hae,</para>
  <para style="q2">hybia lanze a aetu khalang</para>
  <para style="q2">lungkhu lang a ccah hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Na rhawkaw hae khuh dotua hae:</para>
  <para style="q2">na kya umpaw nopi</para>
  <para style="q1">hae te nynh aloku hae.</para>
  <para style="q2">Na ram kya-e koikua hae kha</para>
  <para style="q1">na rhaw hae hanlan</para>
  <para style="q2">ako lante hungpya athua hae;</para>
  <para style="q1">na koikua ccong hae kha</para>
  <para style="q2">maee nynh a u vae hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" />Rhaw nynh ae koih cih oh keiccuze</para>
  <para style="q2">tui thekuh oh,</para>
  <para style="q1">nae rhawlungrua hae kha tynsah oh;</para>
  <para style="q2">anglae kha syde oh lah,</para>
  <para style="q1">pung laephi kha sydete nonde oh,</para>
  <para style="q2">ohkhe raenawpaw kha ccyngkuh oh!</para>
  <para style="q1">
    <verse number="15" style="v" />Tuin kyakhe nanning kha</para>
  <para style="q2">maee nynh ae u cih oh,</para>
  <para style="q1">thaloi nynh phe pae lan ae bae cih oh.</para>
  <para style="q2">Tungkhipaw nynh</para>
  <para style="q2">looh a ae hawte ae ae cih oh.</para>
  <para style="b" />
  <para style="q1">Tungkhipaw hawte</para>
  <para style="q2">pungzae khylan zuakuh oh,</para>
  <para style="q1">khung-angroh hawte</para>
  <para style="q2">pungzae khylan zuakuh oh!</para>
  <para style="q1">
    <verse number="16" style="v" />Kungkupaw na ccungccaw hae kha</para>
  <para style="q2">vaawlang e awsi laeze</para>
  <para style="q1">na lungsah thung hae.</para>
  <para style="q2">Tungkhipaw hae tuh</para>
  <para style="q2">mih sake daw hae zah a zou hae.</para>
  <para style="q1">
    <verse number="17" style="v" />Na rhawviatu hae tuh</para>
  <para style="q2">tungkhipaw hae zeih lung hae zah,</para>
  <para style="q1">na kuihkaw e bawi hae tuh</para>
  <para style="q2">tungkhipaw phu zeih alung hae,</para>
  <para style="q1">khuacci lya tureih kya um hae zah,</para>
  <para style="q2">khuanin he thua te, a zou hae;</para>
  <para style="q1">teilangmou a zou hae cipaw kha</para>
  <para style="q2">humhung nynh mah nyh khyh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" />Pou Assiria siapharan,</para>
  <para style="q2">na tuurin hae tuh ih hae zah,</para>
  <para style="q1">asung-epaw na ccungccaw hae tuh</para>
  <para style="q2">marya ih hae.</para>
  <para style="q1">Na ccungccaw hae tuh</para>
  <para style="q2">mua hae vawlan khe</para>
  <para style="q1">phiariphiarae um hae zah,</para>
  <para style="q2">hum nynh sanmah suelua khyh hae.</para>
  <para style="q1">
    <verse number="19" style="v" />Na vaemaw tuh hoy kho khyh,</para>
  <para style="q2">chikhaeku khopaw</para>
  <para style="q1">vaemaw nynh thua.</para>
  <para style="q2">Na konglang a thaepaw balyn nynh</para>
  <para style="q1">mih kuih ae bianua cih hae.</para>
  <para style="q2">Pawccecize na rysawthyanaw kyate</para>
  <para style="q1">a luepaw hummou a um?</para>
</usx>