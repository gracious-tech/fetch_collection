<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="PRO" style="id">Baebu Thyaa</book>
  <para style="h">PHUNGTANGBYA</para>
  <para style="toc1">Proverbs</para>
  <para style="toc2">PHUNGTANGBYA</para>
  <para style="toc3">Ptb</para>
  <para style="mt1">PHUNGTANGBYA</para>
  <para style="mt2">Proverbs</para>
  <para style="imt">Byalaanmaw</para>
  <para style="ip">Phungtangbya ccauh hynh beiknaw lante thuasah, ziazae lante thuasah ccangpyanaw hae kha pydete byaphung te phungtangbya lang a ccakhung hae paw nynh thua. Alunghua tuh nin takyh ah hiinnaw kya ah tung oh paw te asekuhpaw ccangpyanaw nynh thua. “<char style="nd">Bawipaw </char> rawrinaw tuh hawnaw athonaw nynh thua,” (1.7) cikuhpaw kyate tho zah beiknaw lante ziazae kong kyalya thua leite mawtemaw nyku lanpaw hiinzia te ozia hoypaw kong kha mah a ho. Ahawpaw ccungccaw nynh byathan ccangkhakheit a tung lanze pawtemou rya a lah cih cipaw kong kha dyntarawpaw a byaphung hae patae mangte a ccangpyapaw hynh do lanze, langmawlya e Israel ccangpahtu hae hawnaw kha muih kho athua. E bya hae abang tuh innbyn ccuepekunaw te sekuh zah abang tuh kungkunaw kya ccuepekunaw te asekuh. Abang tuh ccungccaw zapi laku kya pawtemou um lan cipaw kong thua zah, abang tuh mawtemaw sungku kho ahonaw kong nynh thua. Zakawsangsakunaw, ngaesangnaw, ryachi hae sawtuanaw te ruiban hae tungvaw lungzinaw kong kha patae a ho.</para>
  <para style="iot">Abyalupi hae</para>
  <para style="io1">Hawnaw thehoysahnaw 1.1—9.18</para>
  <para style="io1">Solomon phungtangbya 10.1—29.27</para>
  <para style="io1">Agur bya 30.1-33</para>
  <para style="io1">Byaphung aphuinphuin 31.1-31</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Israel siapharan, David ccapaw Solomon phungtangbya:</para>
  <para style="s1">Byalaanmaw<note caller="-" style="x"><char style="xo" closed="false">1.1: </char><char style="xt" closed="false"><ref loc="1KI 4:32">1Si 4.32</ref></char></note></para>
  <para style="q1">
    <verse number="2" style="v" />Hawnaw te thuiheinaw kong</para>
  <para style="q2">ccangkunaw hanlan,</para>
  <para style="q2">akhupaw bya kha nythyanaw hanlan,</para>
  <para style="q1">
    <verse number="3" style="v" />dingnaw, byading te</para>
  <para style="q2">laesah leinaw hanlan te</para>
  <para style="q1">
    <verse number="4" style="v" />tuanaw a zya hae paw kha hawnaw,</para>
  <para style="q2">mino hae kha nynaw te tuathyanaw</para>
  <para style="q2">ccangpya khylan nynh thua.</para>
  <para style="q1">
    <verse number="5" style="v" />A haw hae paw nynh mah</para>
  <para style="q2">thae hae sah lah, houh haw hae sah,</para>
  <para style="q1">a thya hae paw nynh</para>
  <para style="q2">thyanaw houh mue hae sah,</para>
  <para style="q1">
    <verse number="6" style="v" />phungtangbya te tousenaw bya kha thuasah,</para>
  <para style="q2">mihaw hae bya te</para>
  <para style="q1">mih bya akhupaw kha thuasah</para>
  <para style="q2">a thaethya nawlan hae nynh thua.</para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" />
    <char style="nd">Bawipaw </char> rawrinaw tuh</para>
  <para style="q2">hawnaw athonaw nynh thua;</para>
  <para style="q1">mingaee hae nynh tuh hawnaw te</para>
  <para style="q2">thuiheinaw kha pawlangria khyh hae.<note caller="-" style="x"><char style="xo" closed="false">1.7: </char><char style="xt" closed="false"><ref loc="JOB 28:28">Job 28.28</ref>; <ref loc="PSA 111:10">Sam 111.10</ref>; <ref loc="PRO 9:10">Ptb 9.10</ref></char></note></para>
  <para style="b" />
  <para style="s1">Ruiban Hoy leipaw Raeringkunaw.</para>
  <para style="q1">
    <verse number="8" style="v" />Ka ccaaw, na paaw thuiheinaw kha ngae lah,</para>
  <para style="q2">na nung ccangpyanaw kha vua nan;</para>
  <para style="q1">
    <verse number="9" style="v" />pawccecize tuh-e hae tuh na lu hanlan</para>
  <para style="q2">apuithyapaw pungde athua cih zah,</para>
  <para style="q2">na nging hanlan si alungmung athua cih.</para>
  <para style="q1">
    <verse number="10" style="v" />Ka ccaaw, misei hae nynh ae soih hae ze,</para>
  <para style="q2">la oupah nan hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Minmin nynh, “Kae kya cceihbua,</para>
  <para style="q2">ccungccaw chia lan buhkhaw oh sih;</para>
  <para style="q1">seinaw a hoi lei hae paw kha</para>
  <para style="q2">akonglang um leite buhkhawte zia oh sih;</para>
  <para style="q1">
    <verse number="12" style="v" />Michi khua nynh a hiin pite</para>
  <para style="q2">mih pyn balynte</para>
  <para style="q1">ccungccaw a laang hae hawte,</para>
  <para style="q2">Hunghua lungkhu lang</para>
  <para style="q2">accah hae paw hawte po laang oh sih.</para>
  <para style="q1">
    <verse number="13" style="v" />Aphutepaw uccaw hae balyn kha</para>
  <para style="q2">luade lan zah, ah inn hae kha</para>
  <para style="q2">luadepaw uccaw te phe biasah lan.</para>
  <para style="q1">
    <verse number="14" style="v" />Kae kya yn mungkuh bua;</para>
  <para style="q2">phuabu ccangkheit kha</para>
  <para style="q2">hoibung lan,” a ci hae ze,</para>
  <para style="q1">
    <verse number="15" style="v" />ka ccaaw, minmin kya</para>
  <para style="q2">la cceihbua nan,</para>
  <para style="q2">mih laanpi kha la sihaekuh;</para>
  <para style="q1">
    <verse number="16" style="v" />pawccecize mih ccu tuh</para>
  <para style="q2">hoyleinaw kalan khe ccue zah,</para>
  <para style="q2">ccungccaw chia lan mih thyrang.</para>
  <para style="q1">
    <verse number="17" style="v" />Pavaw muihnaw kaang kya</para>
  <para style="q2">nungpyapaw loohtoi tuh alakaw;</para>
  <para style="q1">
    <verse number="18" style="v" />thuasalama ccungccaw hoylei hae paw nynh</para>
  <para style="q2">mimaw te mimaw kha</para>
  <para style="q1">chiaku lan a buhkhawku hae!</para>
  <para style="q2">mih hiinnaw kha zosaku lan</para>
  <para style="q2">a buhkhawku hae.</para>
  <para style="q1">
    <verse number="19" style="v" />Muenaw elang a karankuh</para>
  <para style="q2">hae paw laanpi tuh tuhcite nynh athua;</para>
  <para style="q1">tuh-e nynh mimaw hiinnaw kha a zosah.</para>
  <para style="b" />
  <para style="s1">Hawnaw nynh Kokunaw</para>
  <para style="q1">
    <verse number="20" style="v" />Hawnaw nynh laanpi kyakhe a sia;</para>
  <para style="q2">khualae lungkhu khe a roi kha a saw.<note caller="-" style="x"><char style="xo" closed="false">1.20-21: </char><char style="xt" closed="false"><ref loc="PRO 8:1-3">Ptb 8.1-3</ref></char></note></para>
  <para style="q1">
    <verse number="21" style="v" />Ccungccaw asuh huanaw laanpi kyakhe a sia;</para>
  <para style="q2">khualae teenaw koikua hae kyakhe bya a ho:</para>
  <para style="q1">
    <verse number="22" style="v" />“Pou mingaee hae,</para>
  <para style="q2">hohseciamou na ngaee ung cih oh?</para>
  <para style="q1">Ccungccaw a sarya hae paw nynh</para>
  <para style="q2">ccungccaw saryanaw kya</para>
  <para style="q1">hohseciamou mih lungrythuakhaekuh</para>
  <para style="q2">ung cih zah,</para>
  <para style="q1">mingaee hae nynh hawnaw kha</para>
  <para style="q2">hohseciamou a hua ung cih hae?</para>
  <para style="q1">
    <verse number="23" style="v" />Ka thuiheinaw bya hynh ngae oh;</para>
  <para style="q2">ka tuanaw kha kae pya cih oh;</para>
  <para style="q2">ka bya kha kae nysah cih oh.</para>
  <para style="q1">
    <verse number="24" style="v" />Kae ko oh zah na ei keiccu oh ze thuasah,</para>
  <para style="q2">ka kuih ka dyng zah hum nynh sanmah</para>
  <para style="q2">pawlang na ria khyh oh keiccu thuasah,</para>
  <para style="q1">
    <verse number="25" style="v" />tuanaw hoypaw kae pya oh paw</para>
  <para style="q2">balyn kha pawlangria leite,</para>
  <para style="q1">ka thuiheinaw kha</para>
  <para style="q2">na ngae khyh oh keiccu thuasah</para>
  <para style="q1">
    <verse number="26" style="v" />vawsawnaw na tung oh ze</para>
  <para style="q2">kae nuinseru cih oh;</para>
  <para style="q1">rinaw nynh ae thuanua oh ze</para>
  <para style="q2">kae sarya cih oh,</para>
  <para style="q1">
    <verse number="27" style="v" />vawsawnaw nynh khise hawte thuasah,</para>
  <para style="q1">rinaw nynh khiccung hawte thuasah</para>
  <para style="q2">ae thuanua oh zah,</para>
  <para style="q1">vawsawnaw te lungriathaenaw nynh</para>
  <para style="q2">he ae thuanua oh te, kae sarya cih oh.</para>
  <para style="q1">
    <verse number="28" style="v" />Tuinte tuh minmin nynh yn ko cih hae,</para>
  <para style="q2">thuasalama ka oi vae lan khyh hae;</para>
  <para style="q1">thawte yn ccung cih hae,</para>
  <para style="q2">thuasalama yn muih lan khyh hae.</para>
  <para style="q1">
    <verse number="29" style="v" />Minmin nynh nythyanaw kha hua hae zah,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> rawrinaw kha pokuh khyh hae,</para>
  <para style="q1">
    <verse number="30" style="v" />ka pya hae paw tuanaw hoypaw kha</para>
  <para style="q2">lawku leite, ka thuiheinaw balyn kha</para>
  <para style="q2">pawlangria khyh hae,</para>
  <para style="q1">
    <verse number="31" style="v" />tukeiccuze mih cyisahnaw athae kha</para>
  <para style="q2">a ae cih hae zah</para>
  <para style="q1">ahoy leipaw mih tuakunaw khate</para>
  <para style="q2">phe a byn cih hae.</para>
  <para style="q1">
    <verse number="32" style="v" />Pawccecize tuanaw a zya hae paw tuh</para>
  <para style="q2">laanpi a me keiccu hae ze chih hae zah,</para>
  <para style="q1">mingaee hae tuh a sawphahkunaw hae kha nynh</para>
  <para style="q2">mimaw kha a ro hae;</para>
  <para style="q1">
    <verse number="33" style="v" />thuasalama ka bya a ngae hae paw tuh</para>
  <para style="q2">a khyn cih hae zah,</para>
  <para style="q1">thinphang leite hiinhoyte</para>
  <para style="q2">a um cih hae,” a ci.</para>
  <para style="b" />
  <chapter number="2" style="c" />
  <para style="s1">Hawnaw Mee</para>
  <para style="q1">
    <verse number="1" style="v" />Ka ccaaw, ka bya kha lawkute</para>
  <para style="q2">ka kawbya hae kha</para>
  <para style="q2">na lungkhu kya na ccykekuh zah,</para>
  <para style="q1">
    <verse number="2" style="v" />hawnaw kalan na nakaring tuakute</para>
  <para style="q2">nythyanaw kalan na thinlung kha</para>
  <para style="q2">na pya ze thuasah,</para>
  <para style="q1">
    <verse number="3" style="v" />akhupaw bya kha na ko ccaccing zah,</para>
  <para style="q2">nythyanaw hanlan na roi na saw ze thuasah,</para>
  <para style="q1">
    <verse number="4" style="v" />hawnaw kha ngun hawte na ccung zah,</para>
  <para style="q2">thuruhpaw sisua hawte na ccung ze thuasah</para>
  <para style="q1">
    <verse number="5" style="v" />
    <char style="nd">Bawipaw </char> rawrinaw kha na nyh cih zah</para>
  <para style="q2">Pachia nynaw kha na muih cih.</para>
  <para style="q1">
    <verse number="6" style="v" />Pawccecize <char style="nd">Bawipaw </char> nynh tuh</para>
  <para style="q2">hawnaw kha a pya hae,</para>
  <para style="q1">nynaw te thaethyanaw tuh</para>
  <para style="q2">a khalang kyate nynh yn thua.</para>
  <para style="q1">
    <verse number="7" style="v" />Miding hae hanlan</para>
  <para style="q2">hawnaw hoypaw kha a ccakhungpya hae;</para>
  <para style="q1">ccaenaw um lei lante</para>
  <para style="q2">a cceih hae paw hanlan aning tuh</para>
  <para style="q2">khawriaphua nynh thua.</para>
  <para style="q1">
    <verse number="8" style="v" />Byading laanpi kha phang rin zah</para>
  <para style="q2">alungzipaw a ccungccaw hae laanpi kha</para>
  <para style="q2">a khynsahpya hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Tetuh dingnaw, byading,</para>
  <para style="q2">laesahku leinaw te</para>
  <para style="q2">laanpi hoypaw miakaw kha na nyh cih;</para>
  <para style="q1">
    <verse number="10" style="v" />pawccecize hawnaw tuh</para>
  <para style="q2">na thinlung kalan a tee cih zah,</para>
  <para style="q1">nynaw tuh na thinlung hanlan</para>
  <para style="q2">lungtuanaw athua cih.</para>
  <para style="q1">
    <verse number="11" style="v" />Hawnaw nynh ae rin cih zah</para>
  <para style="q2">nythyanaw nynh ae thungkhaw cih.</para>
  <para style="q1">
    <verse number="12" style="v" />Hoyleinaw laanpi,</para>
  <para style="q2">bya hoyleipaw a ho hae paw,</para>
  <para style="q1">
    <verse number="13" style="v" />mohnaw laanpi zui khylan</para>
  <para style="q2">laan dingpaw a vua hae paw,</para>
  <para style="q1">
    <verse number="14" style="v" />hoyleinaw raenaw kya</para>
  <para style="q2">mih lungpaw zah</para>
  <para style="q1">ahoy leipaw ccouseikunaw kya</para>
  <para style="q2">mih lungrythuapaw,</para>
  <para style="q1">
    <verse number="15" style="v" />mih laanpi tuh kou zah</para>
  <para style="q2">mih cyisahnaw kya</para>
  <para style="q1">a thyaruh hae paw balyn kyate</para>
  <para style="q2">nang kha ae khum cih.</para>
  <para style="q1">
    <verse number="16" style="v" />Nopi hoyleinung,</para>
  <para style="q2">nawpali lan byahothyapaw ohhuanung,</para>
  <para style="q1">
    <verse number="17" style="v" />a zawthaw lya-e</para>
  <para style="q2">a mungkuh hae paw kha vua zah</para>
  <para style="q1">a Pachia byakinnaw a ningpaw</para>
  <para style="q2">nopi kyate ae khum cih;</para>
  <para style="q1">
    <verse number="18" style="v" />pawccecize a laanpi<note caller="+" style="f"><char style="fr" closed="false">2.18 </char><char style="ft" closed="false">laanpi cikuhpaw hynh ‘inn’ cite mah leih kho athua.</char></note> tuh</para>
  <para style="q2">chinaw kalan khe cceih zah,</para>
  <para style="q1">a zuipaw laanpi tuh</para>
  <para style="q2">michi khua langkhe nynh a ccia;</para>
  <para style="q1">
    <verse number="19" style="v" />tuh-e nopinung kalan</para>
  <para style="q2">a cceih hae paw tuh papin ki vae khyh hae,</para>
  <para style="q1">hiinnaw laanpi kya mah</para>
  <para style="q2">thua vae khyh hae.</para>
  <para style="q1">
    <verse number="20" style="v" />Tukeiccuze ccungccaw hoypaw hae</para>
  <para style="q2">laanpi kya cceih lah,</para>
  <para style="q2">miding hae laanpi kha zuitua.</para>
  <para style="q1">
    <verse number="21" style="v" />Pawccecize miding hae tuh</para>
  <para style="q2">hynh-e ram kya khua a sah cih hae zah,</para>
  <para style="q1">seinaw hoi leipaw ccungccaw hae tuh</para>
  <para style="q2">e ram kya a um cih hae;</para>
  <para style="q1">
    <verse number="22" style="v" />thuasalama ccungccaw hoylei hae paw tuh</para>
  <para style="q2">ram kyate maemih athua cih hae zah,</para>
  <para style="q1">mih lungzi lei hae paw tuh</para>
  <para style="q2">ram kyate ccaring vua athua cih hae.</para>
  <chapter number="3" style="c" />
  <para style="s1">Mino hae Tuanaw Pyanaw</para>
  <para style="q1">
    <verse number="1" style="v" />Ka ccaaw, kae ccangpyanaw kha ning nan,</para>
  <para style="q2">na thinlung nynh</para>
  <para style="q2">ka kawbya hae hynh ccykekuh sah;</para>
  <para style="q1">
    <verse number="2" style="v" />pawccecize tuh-e hae nynh</para>
  <para style="q2">hiinshe saenaw te</para>
  <para style="q2">hiin hoynaw kha ae pya cih.</para>
  <para style="q1">
    <verse number="3" style="v" />Lungzinaw te zyn lan umnaw kha</para>
  <para style="q2">na kyate phiasakuh nan hae;</para>
  <para style="q1">tuh-e hae tuh na nging kyakhe</para>
  <para style="q2">oikuh hae lah,</para>
  <para style="q1">na thinlung lungphe kyakhe</para>
  <para style="q2">zeikuh hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Tuhteze tuh Pachia te</para>
  <para style="q2">ccungccaw mitmuihnaw kya</para>
  <para style="q1">maehoynaw te minhoynaw</para>
  <para style="q2">na mue cih.<note caller="-" style="x"><char style="xo" closed="false">3.4: </char><char style="xt" closed="false"><ref loc="LUK 2:52">Luk 2.52</ref></char></note></para>
  <para style="q1">
    <verse number="5" style="v" />
    <char style="nd">Bawipaw </char> kha na thinlung balyn te</para>
  <para style="q2">doliakuh lah,</para>
  <para style="q2">na hawnaw khate la rinkuh nan.</para>
  <para style="q1">
    <verse number="6" style="v" />Na ccianaw laanpi takyh kya</para>
  <para style="q2">amaw kha nyh lah,</para>
  <para style="q2">na laanpi kha ae lawsahpah cih.</para>
  <para style="q1">
    <verse number="7" style="v" />Amaw mitmuihnaw kya</para>
  <para style="q2">ahawsakuhpaw la thua nan;</para>
  <para style="p">
    <char style="nd">Bawipaw </char> kha rih lah,</para>
  <para style="q2">hoyleinaw kha maetawkuh.<note caller="-" style="x"><char style="xo" closed="false">3.7: </char><char style="xt" closed="false"><ref loc="ROM 12:16">Rom 12.16</ref></char></note></para>
  <para style="q1">
    <verse number="8" style="v" />Tuh-e tuh na ngesaw hanlan</para>
  <para style="q2">dannaw athua cih zah,</para>
  <para style="q2">na pyn hanlan isei athua cih.</para>
  <para style="q1">
    <verse number="9" style="v" />
    <char style="nd">Bawipaw </char> kha na sisua te</para>
  <para style="q2">na voisahpaw athae balyn kya-e</para>
  <para style="q2">thaety khate sawtuanaw pyatua;</para>
  <para style="q1">
    <verse number="10" style="v" />tuhteze tuh na ccung-inn hae tuh</para>
  <para style="q2">phe abeih cih hae zah,</para>
  <para style="q1">na misu mianawpaw akhu hae tuh</para>
  <para style="q2">misutui te aleikuh cih hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Ka ccaaw, <char style="nd">Bawipaw </char> thuiheinaw kha</para>
  <para style="q2">pawlangria leite um nan,</para>
  <para style="q2">ae thuihei ze na lungroh nan sah,<note caller="-" style="x"><char style="xo" closed="false">3.11: </char><char style="xt" closed="false"><ref loc="JOB 5:17">Job 5.17</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">3.11-12: </char><char style="xt" closed="false"><ref loc="HEB 12:5-6">Heb 12.5-6</ref></char></note></para>
  <para style="q1">
    <verse number="12" style="v" />pawccecize paaw nynh</para>
  <para style="q2">a lunglahpaw a ccapaw kha</para>
  <para style="q1">a thuihei hawte</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh a sungsahpaw kha a thuihei.<note caller="-" style="x"><char style="xo" closed="false">3.12: </char><char style="xt" closed="false"><ref loc="REV 3:19">Bya 3.19</ref></char></note></para>
  <para style="s1">Ahmepaw Hoirumnaw</para>
  <para style="q1">
    <verse number="13" style="v" />Hawnaw kha ccung zah</para>
  <para style="q2">a muihpaw tuh lungtuapaw nynh thua,</para>
  <para style="q2">nythyanaw a hoipaw mah a lungtuabua,</para>
  <para style="q1">
    <verse number="14" style="v" />pawccecize hawnaw kyate</para>
  <para style="q2">muepaw tuh ngun laeze hoyhua zah,</para>
  <para style="q1">hawnaw kya-e amia tuh</para>
  <para style="q2">sui laeze ahoyhua.</para>
  <para style="q1">
    <verse number="15" style="v" />Hawnaw tuh aphutepaw</para>
  <para style="q2">lung-awpaw laeze aphutehua zah,</para>
  <para style="q1">na rypaw balyn khate</para>
  <para style="q2">touse kho thua khyh.</para>
  <para style="q1">
    <verse number="16" style="v" />A ranglang kuih kyakhe</para>
  <para style="q2">hiinshe saenaw um zah,</para>
  <para style="q1">a voilang kuih kyakhe</para>
  <para style="q2">hoirumnaw te sawtuanaw a um.</para>
  <para style="q1">
    <verse number="17" style="v" />A laanpi tuh lungpawnaw laanpi thua zah,</para>
  <para style="q2">a laanpi balyn tuh daenaw nynh thua.</para>
  <para style="q1">
    <verse number="18" style="v" />Hawnaw a kyngkuh hae paw hanlan</para>
  <para style="q2">hawnaw tuh hiinnaw thingku nynh thua;</para>
  <para style="q1">hawnaw kha tynkaring lan</para>
  <para style="q2">a kyngkuh hae paw tuh</para>
  <para style="q1">lungtua hae paw nynh thua hae.</para>
  <para style="s1">Raenaw kya Pachia Hawnaw</para>
  <para style="q1">
    <verse number="19" style="v" />
    <char style="nd">Bawipaw </char> nynh hawnaw khate</para>
  <para style="q2">laephi kha rae zah,</para>
  <para style="q2">nythyanaw khate vaawlui kha a tynsah;</para>
  <para style="q1">
    <verse number="20" style="v" />a hawnaw khate tui akhupaw kha</para>
  <para style="q2">phiasakuh zah, maeking nynh</para>
  <para style="q2">dangtui kha a ccawsah.</para>
  <para style="q1">
    <verse number="21" style="v" />Ka ccaaw, hawnaw hoypaw te</para>
  <para style="q2">nythyanaw kha na muihnaw kyate</para>
  <para style="q2">zuasah nan,</para>
  <para style="q1">
    <verse number="22" style="v" />tuh-e hae tuh na muisaw elang</para>
  <para style="q2">hiinnaw athua cih hae zah,</para>
  <para style="q2">na nging hanlan ccaankunawpaw athua cih.</para>
  <para style="q1">
    <verse number="23" style="v" />Tetuh na laanpi kya</para>
  <para style="q2">khyndadyh lan na cceih cih zah,</para>
  <para style="q2">na ccu tuh thykuh lan khyh.</para>
  <para style="q1">
    <verse number="24" style="v" />Na haung ze rinaw na hoi lan khyh zah,</para>
  <para style="q2">na i ze na ithuathya cih.</para>
  <para style="q1">
    <verse number="25" style="v" />Vaekheitmawte yn thuapaw siikunaw te</para>
  <para style="q2">ccungccaw hoylei hae paw kya</para>
  <para style="q2">athopaw khise kha rih nan;</para>
  <para style="q1">
    <verse number="26" style="v" />pawccecize <char style="nd">Bawipaw </char> tuh</para>
  <para style="q2">na zynkunaw athua cih zah,</para>
  <para style="q1">na ccu kha kaangkaenaw kyate</para>
  <para style="q2">ae khynsah cih.</para>
  <para style="q1">
    <verse number="27" style="v" />Na kuih kya cyipya khonaw</para>
  <para style="q2">huhan a um ze, hoynaw cyipya lan</para>
  <para style="q1">accan hae paw kha cyipya leite</para>
  <para style="q2">la um nan hae.</para>
  <para style="q1">
    <verse number="28" style="v" />Pya lanpaw mang na hoi pite</para>
  <para style="q2">na innpaw kha,</para>
  <para style="q1">“La cceih ccavae, bua nae thua cih,</para>
  <para style="q2">awkhualan kae pya cih,” cite la cipah nan.</para>
  <para style="q1">
    <verse number="29" style="v" />Namaw doliakute na pe umpaw</para>
  <para style="q2">na innpaw tungvaw</para>
  <para style="q2">vawsawnaw pya lan la tuakuh nan.</para>
  <para style="q1">
    <verse number="30" style="v" />Na tungvaw hoyleinaw</para>
  <para style="q2">a rae khyh lanze,</para>
  <para style="q1">akonglang um leite humhung te mah</para>
  <para style="q2">la pekuh nan oh.</para>
  <para style="q1">
    <verse number="31" style="v" />A puathopaw ccungccaw tungvaw na eiung nan,</para>
  <para style="q2">a laanpi pawpaw kha mah la pokuh nan;</para>
  <para style="q1">
    <verse number="32" style="v" />pawccecize a ccouseikuhpaw tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> hanlan anungsikuhpaw nynh thua,</para>
  <para style="q1">thuasalama miding hae tuh <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">a zyn hae paw nynh thua.</para>
  <para style="q1">
    <verse number="33" style="v" />
    <char style="nd">Bawipaw </char> thyalawnaw tuh</para>
  <para style="q2">ccungccaw hoylei hae paw inn kya a um cih,</para>
  <para style="q1">thuasalama miding hae nynh</para>
  <para style="q2">a umnaw hae kha tuh hythua a pya.</para>
  <para style="q1">
    <verse number="34" style="v" />Ccungccaw dothatheih hae paw kha</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh dothatheih hae zah,</para>
  <para style="q2">zakawsangsakuh hae paw kha thaw a cci hae.<note caller="-" style="x"><char style="xo" closed="false">3.34: </char><char style="xt" closed="false"><ref loc="JAS 4:6">Jam 4.6</ref>; <ref loc="1PE 5:5">1Pe 5.5</ref></char></note></para>
  <para style="q1">
    <verse number="35" style="v" />Mihawpaw tuh sawtuanaw a ccou cih,</para>
  <para style="q2">thuasalama a lungkhungpaw mingaeepaw tuh</para>
  <para style="q1">maethyanaw kha a mue cih.</para>
  <chapter number="4" style="c" />
  <para style="s1">Nungpaaw Thuiheinaw</para>
  <para style="q1">
    <verse number="1" style="v" />Ccaaw hae, nae paaw</para>
  <para style="q2">thuiheinaw kha ngae oh lah,</para>
  <para style="q1">nythyanaw na hoi kho nawlan oh,</para>
  <para style="q2">hoyte ngae oh;</para>
  <para style="q1">
    <verse number="2" style="v" />pawccecize ahoypaw</para>
  <para style="q2">thuiheinaw kha kae pya oh,</para>
  <para style="q1">tukeiccuze kae ccangpyanaw oh kha</para>
  <para style="q2">vua nan oh.</para>
  <para style="q1">
    <verse number="3" style="v" />Ka paaw ccapaw ka la thua zah,</para>
  <para style="q2">ka nung mitmuihnaw kya</para>
  <para style="q1">nevyalyapaw te a sungsah huapaw</para>
  <para style="q2">ccapaw nynh ka la thua,</para>
  <para style="q1">
    <verse number="4" style="v" />ka paaw nynh yn ccangpah zah,</para>
  <para style="q1">“Ka bya hynh tynkaring lan kyngkuh;</para>
  <para style="q2">ka kawbya hae hynh zui lah hiintua.</para>
  <para style="q1">
    <verse number="5" style="v" />Hawnaw kha ccangku tua;</para>
  <para style="q2">nythyanaw kha ccangku tua;</para>
  <para style="q1">Ka khalang kya-e bya hynh ning nan lah,</para>
  <para style="q2">maetawkuh nan.</para>
  <para style="q1">
    <verse number="6" style="v" />Hawnaw kha vua nan lah,</para>
  <para style="q2">nang kha ae thungkhaw cih;</para>
  <para style="q1">hawnaw kha sungsah lah,</para>
  <para style="q2">nang kha ae rin cih.</para>
  <para style="q1">
    <verse number="7" style="v" />Masaty na ccangku lanpaw tuh</para>
  <para style="q2">hawnaw nynh thua;</para>
  <para style="q1">hawnaw kha ccangku tua,</para>
  <para style="q2">na ccangku lanpaw balyn kyaze</para>
  <para style="q2">nythyanaw kha ccangku tua.</para>
  <para style="q1">
    <verse number="8" style="v" />Hawnaw kha aphutesah lah,</para>
  <para style="q2">nang kha ae hangthung cih;</para>
  <para style="q1">tuh-e hawnaw tuh na pompaeku lanze</para>
  <para style="q2">sawtuanaw ae ccousah cih.</para>
  <para style="q1">
    <verse number="9" style="v" />Hawnaw nynh apuithyapaw</para>
  <para style="q2">haetapawsi kha na lu vawlan</para>
  <para style="q1">ae khungsah cih; apuithyapaw</para>
  <para style="q2">bawilukhung kha ae pya cih,”</para>
  <para style="q1">a cipya.</para>
  <para style="s1">Ahmepaw Laanpi Zuinaw</para>
  <para style="q1">
    <verse number="10" style="v" />Ka ccaaw, ka bya hynh ngae lah</para>
  <para style="q2">lawku tua, na hiinshe asae cih.</para>
  <para style="q1">
    <verse number="11" style="v" />Hawnaw laanpi kha</para>
  <para style="q2">kae ccangpah vae zah,</para>
  <para style="q1">dingnaw laanpi lang</para>
  <para style="q2">kae cciakhae vae.</para>
  <para style="q1">
    <verse number="12" style="v" />Na ccia ze, pawpaw nynh mah</para>
  <para style="q2">ae khaw lan khyh zah,</para>
  <para style="q1">na ccue ze thykute</para>
  <para style="q2">na khuliakuh lan khyh.</para>
  <para style="q1">
    <verse number="13" style="v" />Thuiheinaw kha</para>
  <para style="q2">phang kyngkuh lah saw nan;</para>
  <para style="q1">hoyte rintua, pawccecize tuh-e tuh</para>
  <para style="q2">na hiinnaw nynh thua.</para>
  <para style="q1">
    <verse number="14" style="v" />Ccungccaw hoylei hae paw</para>
  <para style="q2">laanpi kya tee nan lah,</para>
  <para style="q1">hoyleinaw a rae hae paw</para>
  <para style="q2">laanpi kya cceihbua nan.</para>
  <para style="q1">
    <verse number="15" style="v" />Tuh-e tuh sibia lah, zui nan;</para>
  <para style="q2">tuin kyate maekuh lah, po cciatawtua.</para>
  <para style="q1">
    <verse number="16" style="v" />Pawccecize minmin tuh</para>
  <para style="q2">seinaw rae leite ih kho khyh hae;</para>
  <para style="q1">lukhakheit kha khuliasaku leite</para>
  <para style="q2">ih kho khyh hae.</para>
  <para style="q1">
    <verse number="17" style="v" />Pawccecize minmin tuh</para>
  <para style="q2">hoyleinaw looh kha ae hae zah,</para>
  <para style="q2">puathonaw misutui kha a nia hae.</para>
  <para style="q1">
    <verse number="18" style="v" />Thuasalama miding hae laanpi tuh</para>
  <para style="q2">ninthu cia houhouh a awpaw</para>
  <para style="q2">awkhua takaw e awnaw te nynh aloku.</para>
  <para style="q1">
    <verse number="19" style="v" />Ccungccaw hoylei hae paw laanpi tuh</para>
  <para style="q2">marae mohpaw te nynh aloku;</para>
  <para style="q1">a khuliaku hae ze pawkyamou</para>
  <para style="q2">kae thyku cipaw nyh khyh hae.</para>
  <para style="q1">
    <verse number="20" style="v" />Ka ccaaw, ka bya hynh</para>
  <para style="q2">hoyte ngae lah,</para>
  <para style="q1">ka hopaw bya kalan hin</para>
  <para style="q2">na nakaring kha tuaku tua.</para>
  <para style="q1">
    <verse number="21" style="v" />Hynh-e hae hynh</para>
  <para style="q2">na mitmuihnaw kyate zosah nan;</para>
  <para style="q2">na thinlung kya ccykekuh hae.</para>
  <para style="q1">
    <verse number="22" style="v" />Pawccecize tuh-e tuh</para>
  <para style="q2">a muih hae paw hanlan hiinnaw thua zah,</para>
  <para style="q2">mih pynsaw balyn dannaw nynh thua.</para>
  <para style="q1">
    <verse number="23" style="v" />Na thinlung kha hoyte raeringtua,</para>
  <para style="q2">pawccecize tuin kyate nynh</para>
  <para style="q2">hiinnaw tuidy yn phyh.</para>
  <para style="q1">
    <verse number="24" style="v" />Hynbya kha na khalang kyate</para>
  <para style="q2">sungkuh lah, thyaruhnaw bya kha</para>
  <para style="q2">na kyate ccaring vuatua.</para>
  <para style="q1">
    <verse number="25" style="v" />Na mit nynh malang khe</para>
  <para style="q2">lawbabin lan dosah lah,</para>
  <para style="q1">na malang khe tahrarin lan</para>
  <para style="q2">phang dosah.</para>
  <para style="q1">
    <verse number="26" style="v" />Na ccu nynh a kawnaw laanpi kha</para>
  <para style="q2">hoyte dokuh lah,</para>
  <para style="q1">na laanccia balyn tuh hoyte</para>
  <para style="q2">na cceih kho cih.<note caller="-" style="x"><char style="xo" closed="false">4.26: </char><char style="xt" closed="false"><ref loc="HEB 12:13">Heb 12.13</ref></char></note></para>
  <para style="q1">
    <verse number="27" style="v" />Voilang ranglang maekuh nan,</para>
  <para style="q2">na ccu kha hoyleinaw kyate</para>
  <para style="q1">maeleih tua.</para>
  <para style="b" />
  <chapter number="5" style="c" />
  <para style="s1">Nopi Pise Seinaw Kong Raeringnaw Pyanaw</para>
  <para style="q1">
    <verse number="1" style="v" />Ka ccaaw, ka hawnaw hynh</para>
  <para style="q2">hoyte pekitua;</para>
  <para style="q1">Ka nythyanaw kalan khe</para>
  <para style="q2">na nakaring kha tuaku tua,</para>
  <para style="q1">
    <verse number="2" style="v" />tuhteze tuh tuathyanaw kha</para>
  <para style="q2">na hoi kho cih zah,</para>
  <para style="q1">na byaho nynh nynaw na hoipaw kha</para>
  <para style="q2">a langsakuh cih.</para>
  <para style="q1">
    <verse number="3" style="v" />Pawccecize nopi hoyleipaw munglae tuh</para>
  <para style="q2">khoitui hawte ccaw zah,</para>
  <para style="q2">a byaho tuh chitui laeze anawpali hua,</para>
  <para style="q1">
    <verse number="4" style="v" />thuasalama athangnaw kya tuh</para>
  <para style="q2">ekhahpaw hawte khah zah,</para>
  <para style="q2">kyng ning mawte ahepaw thaloi hawte ahe.</para>
  <para style="q1">
    <verse number="5" style="v" />A ccu tuh chinaw kalan cceihbung zah,</para>
  <para style="q2">a ccu a kawpaw tuh michi khua lang</para>
  <para style="q2">cceihpaw laanpi kha nynh a zui.</para>
  <para style="q1">
    <verse number="6" style="v" />Hiinnaw laanpi langkhe zui khyh;</para>
  <para style="q2">a laanpi tuh vaevui zah,</para>
  <para style="q1">aning nynh tuh-e tuh nyh khyh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" />Te atu, ka ccaaw, ka bya hynh ngae lah,</para>
  <para style="q2">ka khalang kya-e bya hae kha vua nan.</para>
  <para style="q1">
    <verse number="8" style="v" />Tuhcihawpaw nopi kha</para>
  <para style="q2">asawnaw te sibia lah,</para>
  <para style="q2">a inn thuakaw pe lang naekuh nan;</para>
  <para style="q1">
    <verse number="9" style="v" />tuhkhyhze tuh sawtuanaw</para>
  <para style="q2">na ccoupaw kha ming hae kalan</para>
  <para style="q1">na pya cih hae zah,</para>
  <para style="q2">na hiinnaw kha thawccinaw</para>
  <para style="q2">a hoi lei hae paw kalan na pya cih hae,</para>
  <para style="q1">
    <verse number="10" style="v" />te ramccang hae tuh</para>
  <para style="q2">nae hoirumnaw khate a byn cih hae zah,</para>
  <para style="q1">na ryalawnaw mee tuh</para>
  <para style="q2">ramccangpaw inn lang a cceih cih;</para>
  <para style="q1">
    <verse number="11" style="v" />te na hiinnaw athangnaw kya tuh</para>
  <para style="q2">daryndaryn na hawkhaekuh cih,</para>
  <para style="q2">na ngesaw te na pyn tuh he athang te,</para>
  <para style="q1">
    <verse number="12" style="v" />“Pawcce ccangpyanaw kha ka la hua zah,</para>
  <para style="q2">ka thinlung nynh thuiheinaw kha a la theihrya!</para>
  <para style="q1">
    <verse number="13" style="v" />Ka sazae hae bya kha</para>
  <para style="q2">ka la ngae khyh zah,</para>
  <para style="q2">yn ccangpahtu hae bya ka la ngae khyh.</para>
  <para style="q1">
    <verse number="14" style="v" />Atu tuh apumkuh hae paw</para>
  <para style="q2">zapi hae ngaelung kya</para>
  <para style="q1">ronaw phuinccing kya nynh</para>
  <para style="q2">ka um vae,” na ci cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" />Na tuidy kya-e tui,</para>
  <para style="q2">na tuisung kyate aphyhpaw tui kha neih.</para>
  <para style="q1">
    <verse number="16" style="v" />Na tuidy tuh atolang</para>
  <para style="q2">phiariphiarae phiasakute,</para>
  <para style="q1">vaw taraw hae tuh laanpi hae kya</para>
  <para style="q2">luasah lan accan zawtou?</para>
  <para style="q1">
    <verse number="17" style="v" />Tuh-e hae tuh na makhae hanlan thua sah lah,</para>
  <para style="q2">ming hae ryte bungku lanpaw thua nan sah.</para>
  <para style="q1">
    <verse number="18" style="v" />Na tuidy tuh hythuapya thuasah lah,</para>
  <para style="q2">na no lya-e na zu kyakhe hoysahte umtua,</para>
  <para style="q1">
    <verse number="19" style="v" />aning tuh ry lan umpaw sazuh,</para>
  <para style="q2">apuithyapaw sazuh pinung hawte nynh thua.</para>
  <para style="q1">A matei nynh accyh takyh kya</para>
  <para style="q2">na lungry ae ccingsah sah;</para>
  <para style="q2">a sungsahnaw khate zungzae la ruikhaekuh.</para>
  <para style="q1">
    <verse number="20" style="v" />Ka ccapaw, pawcce ccangpaw nopi khate</para>
  <para style="q2">na ruikhaekuh cih zah,</para>
  <para style="q2">a ccouseikuhpaw by kha na pom cih?</para>
  <para style="q1">
    <verse number="21" style="v" />Pawccecize ccungccaw laanpi hae tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> muihnaw kya um zah,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh a laanpi balyn kha</para>
  <para style="q2">akaw-aleih a do.</para>
  <para style="q1">
    <verse number="22" style="v" />Ccungccaw hoyleipaw tuh</para>
  <para style="q2">a hoyleinaw kha nynh amaw kha</para>
  <para style="q1">kaang a kaesah cih zah,</para>
  <para style="q2">a seinaw liarui hae khate</para>
  <para style="q2">amaw kha he athua cih.</para>
  <para style="q1">
    <verse number="23" style="v" />Aning tuh ccangpyanaw</para>
  <para style="q2">a um khyh keiccuze a chih cih zah,</para>
  <para style="q1">eih a ngaee keiccuze azo cih.</para>
  <chapter number="6" style="c" />
  <para style="s1">Hynbya Honaw Raeringnaw Pyanaw</para>
  <para style="q1">
    <verse number="1" style="v" />Ka ccaaw, na innpaw elang</para>
  <para style="q2">aamah na khanpyaku ze thuasah,</para>
  <para style="q1">milae hanlan byakinpyakute</para>
  <para style="q2">na kuihphe na bia ze thuasah,</para>
  <para style="q1">
    <verse number="2" style="v" />nang tuh na byaho keiccuze</para>
  <para style="q2">kaang na kae zah,</para>
  <para style="q2">na khalang kya-e bya nynh ae kyng vae.</para>
  <para style="q1">
    <verse number="3" style="v" />Tukeiccuze ka ccaaw,</para>
  <para style="q2">nang tuh na innpaw kuih kya</para>
  <para style="q1">phe na thua vae keiccuze</para>
  <para style="q2">namaw te namaw khumku khylan</para>
  <para style="q1">na cyi lanpaw tuh:</para>
  <para style="q2">arangte cceih lah, zakawsangsakute</para>
  <para style="q2">na innpaw kyakhe ngiakuh.</para>
  <para style="q1">
    <verse number="4" style="v" />Na mit kha isah nan lah,</para>
  <para style="q2">na mit masite na ithua nan sah;</para>
  <para style="q1">
    <verse number="5" style="v" />sawkawpaw kuih kyate</para>
  <para style="q2">sazuh a lue hawte thuasah,</para>
  <para style="q1">kaangsyatu kuih kyate</para>
  <para style="q2">pavaw a zua hawte thuasah</para>
  <para style="q1">namaw te namaw kha khumku tua.</para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" />Pou thawnawpaw,</para>
  <para style="q2">lungkhi kalan cceih lah,</para>
  <para style="q1">a umtuzia kha dokute</para>
  <para style="q2">hawnaw lawku tua.</para>
  <para style="q1">
    <verse number="7" style="v" />Lupi thuasah, bawi thuasah,</para>
  <para style="q2">uktu thuasah hoi lei mawte</para>
  <para style="q1">
    <verse number="8" style="v" />hawnin khe a looh kha paccynkuh zah,</para>
  <para style="q2">loohrue ccyh khe a looh kha</para>
  <para style="q2">a ccakhungku.</para>
  <para style="q1">
    <verse number="9" style="v" />Pou thawnawpaw,</para>
  <para style="q2">hohseciamou na ih ung cih?</para>
  <para style="q2">Na inaw kyate hohtuhmou na thokuh cih?</para>
  <para style="q1">
    <verse number="10" style="v" />Sosoh kae ikuh hin,</para>
  <para style="q2">sosoh kae ngawphuku hin,</para>
  <para style="q1">ka kuih tuh sosoh lepiakute</para>
  <para style="q2">kae haeung hin na ci lyakhe,<note caller="-" style="x"><char style="xo" closed="false">6.10-11: </char><char style="xt" closed="false"><ref loc="PRO 24:33-34">Ptb 24.33-34</ref></char></note></para>
  <para style="q1">
    <verse number="11" style="v" />ryachinaw nynh miruh hawte thuasah,</para>
  <para style="q2">hobounaw nynh zunghe</para>
  <para style="q1">ccyngkuhpaw hawte thuasah</para>
  <para style="q2">na tungvaw ae thuanua cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" />Ccungkia leipaw te</para>
  <para style="q2">ccungccaw hoyleipaw tuh</para>
  <para style="q2">hynhihynhupaw byahote a khiavuikuh,</para>
  <para style="q1">
    <verse number="13" style="v" />mit phalah masipyanaw,</para>
  <para style="q2">ccu te syntawnaw pyanaw te</para>
  <para style="q2">kuihdung te khipyanaw kha a rae,</para>
  <para style="q1">
    <verse number="14" style="v" />ccouseikunaw thinlung khate</para>
  <para style="q2">hoyleinaw kha rae zah,</para>
  <para style="q2">pekumaekunaw kha atu te atu a puisah;</para>
  <para style="q1">
    <verse number="15" style="v" />tukeiccuze vawsawnaw tuh</para>
  <para style="q2">a tungvaw khe vaekheitmawte</para>
  <para style="q1">yn ccah cih zah,</para>
  <para style="q2">dansah kho lei vae te a roh cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" />
    <char style="nd">Bawipaw </char> nynh a huapaw</para>
  <para style="q2">uccaw ccangtaruh um zah,</para>
  <para style="q2">anungsikuh a cipaw ccangsari a um:</para>
  <para style="q1">
    <verse number="17" style="v" />lysakunaw mit, ahynthyapaw lae,</para>
  <para style="q2">seinaw hoi leipaw</para>
  <para style="q2">ccungccaw a theihpaw kuih,</para>
  <para style="q1">
    <verse number="18" style="v" />hoyleinaw khua a khanpaw thinlung,</para>
  <para style="q2">hoyleinaw kalan arangte a ccuepaw ccu,</para>
  <para style="q1">
    <verse number="19" style="v" />ahme leipaw byahote</para>
  <para style="q2">ahynpaw ccaekia, te</para>
  <para style="q1">uteno laku pekumaekunaw</para>
  <para style="q2">a puisahpaw nynh thua.</para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" />Ka ccapaw, na paaw kawbya kha zui lah,</para>
  <para style="q2">na nung ccangpyanaw kha vua nan.</para>
  <para style="q1">
    <verse number="21" style="v" />Tuh-e hae tuh na thinlung kya</para>
  <para style="q2">zungzae ccykekuh lah,</para>
  <para style="q2">na nging kya oikuh.</para>
  <para style="q1">
    <verse number="22" style="v" />Na ccia vae ze, tuh-e hae nynh</para>
  <para style="q2">ae cciakhae cih hae;</para>
  <para style="q1">na i vae ze, phang ae rin cih hae zah,</para>
  <para style="q2">he na thaekuh te, bya ae hokhae cih hae.</para>
  <para style="q1">
    <verse number="23" style="v" />Pawccecize kawbya tuh</para>
  <para style="q2">maeekhua thua zah, ccangpyanaw tuh</para>
  <para style="q1">awnaw nynh thua, a seinaw</para>
  <para style="q2">phypya biate thuiheinaw tuh</para>
  <para style="q2">hiinnaw laanpi nynh thua.</para>
  <para style="q1">
    <verse number="24" style="v" />tuh-e thuiheinaw nynh</para>
  <para style="q2">nopi hoyleipaw kyate thuasah,</para>
  <para style="q1">a ccouseikuhpaw zu kya-e</para>
  <para style="q2">nawpalipaw bya kyate thuasah</para>
  <para style="q2">ae thungkhaw cih.</para>
  <para style="q1">
    <verse number="25" style="v" />Tuh-e nopinung puithyanaw kha</para>
  <para style="q2">na thinlung kya duaa nan lah,</para>
  <para style="q1">a mitdae nynh nang kha</para>
  <para style="q2">ae kyng nan sah;</para>
  <para style="q1">
    <verse number="26" style="v" />pawccecize ohhuanung mee tuh</para>
  <para style="q2">sanlou phe kheit kyalya nynh thua,</para>
  <para style="q1">thuasalama vawpaw mang a hoi pite</para>
  <para style="q2">pise a rypaw nynh tuh</para>
  <para style="q2">pisepaw hiinnaw aphutepaw kha a kyng ry.</para>
  <para style="q1">
    <verse number="27" style="v" />maee nynh boeining kha u leite</para>
  <para style="q2">by kya maee kha</para>
  <para style="q2">pompaeku kho athua tou?</para>
  <para style="q1">
    <verse number="28" style="v" />Tuhkhyhze maee nynh ccu kha u leite,</para>
  <para style="q2">maee-e vawlan a cceih khopaw a um tou?</para>
  <para style="q1">
    <verse number="29" style="v" />A innpaw zu kha a ikhaepaw tuh</para>
  <para style="q2">tuhawte nynh athua;</para>
  <para style="q1">tuh-e nopinung a typaw tuh</para>
  <para style="q2">detahnaw mue leite um lan khyh.</para>
  <para style="q1">
    <verse number="30" style="v" />A vuelaw keiccuze a vueso khylan</para>
  <para style="q2">aruhpaw miruh kha</para>
  <para style="q1">ccungccaw hae nynh</para>
  <para style="q2">a dothatheih mamin hae.</para>
  <para style="q1">
    <verse number="31" style="v" />Tuhzemah miruh tuh a kyng hae ze,</para>
  <para style="q2">miruh kha leit sari a rungsah cih hae;</para>
  <para style="q2">a inn e uccaw balyn kha a rung cih.</para>
  <para style="q1">
    <verse number="32" style="v" />Thuasalama milae zu kya</para>
  <para style="q2">a seipaw tuh tuanaw</para>
  <para style="q1">a hoi leipaw nynh thua;</para>
  <para style="q2">tuhte a cyihpaw tuh amaw te amaw kha a roku.</para>
  <para style="q1">
    <verse number="33" style="v" />Vaemaw te minthunaw kha a mue cih zah,</para>
  <para style="q2">a maethyanaw tuh zo lan khyh.</para>
  <para style="q1">
    <verse number="34" style="v" />Pawccecize a zu tungvaw</para>
  <para style="q2">zyn leinaw kha nynh a vawpaw</para>
  <para style="q1">thin kha riasah zah, a vawpaw nynh</para>
  <para style="q2">he a liaru te, synkuh vae khyh.</para>
  <para style="q1">
    <verse number="35" style="v" />A vawpaw nynh rungkupaw kha</para>
  <para style="q2">lawkuh lan khyh zah,</para>
  <para style="q1">lasung patae pya lan zemah</para>
  <para style="q2">phe a mah cih.</para>
  <para style="b" />
  <chapter number="7" style="c" />
  <para style="s1">Ohhuanung nynh Soihkunaw</para>
  <para style="q1">
    <verse number="1" style="v" />Ka ccaaw, ka bya hynh ccykekuh lah,</para>
  <para style="q2">ka kawbya hae hynh na kya ccykuh hae;</para>
  <para style="q1">
    <verse number="2" style="v" />ka kawbya hae hynh zui lah hiintua,</para>
  <para style="q2">ka ccangpyanaw hynh</para>
  <para style="q2">na mitlungdy hawte phang rintua;</para>
  <para style="q1">
    <verse number="3" style="v" />na kuihdung kyakhe heedekuh lah,</para>
  <para style="q2">na thinlung lungphe vawlan khe zeiku tua.</para>
  <para style="q1">
    <verse number="4" style="v" />Hawnaw kha, “Ka ccianung,” ci lah,</para>
  <para style="q2">nythyanaw kha ruiban hoypaw cite kotua.</para>
  <para style="q1">
    <verse number="5" style="v" />tuh-e hae nynh nopi hoyleipaw kyate thuasah,</para>
  <para style="q2">nawpali lan byahothyapaw</para>
  <para style="q1">a ccouseikuhpaw zu kyate thuasah</para>
  <para style="q2">ae thungkhaw cih.</para>
  <para style="q1">
    <verse number="6" style="v" />Ka inn thanlan-aw kyate</para>
  <para style="q2">ka do zah,</para>
  <para style="q1">
    <verse number="7" style="v" />tuanaw a zya hae paw mino hae laku khe,</para>
  <para style="q2">tuanaw a hoi leipaw ccangvaepaw</para>
  <para style="q2">lu kheit kha ka muih,</para>
  <para style="q1">
    <verse number="8" style="v" />aning tuh tuh-e ohhuanung a umnaw</para>
  <para style="q2">laanpi atungkunaw pe langkhe po a cceih,</para>
  <para style="q1">
    <verse number="9" style="v" />tuh lya tuh zetepakaw riryngmoh ccyh,</para>
  <para style="q2">khuazi amoh ccyh nynh thua.</para>
  <para style="q1">
    <verse number="10" style="v" />Tetuh ohhuanung hawte ccaankuh zah</para>
  <para style="q2">thinlung ahynthyapaw</para>
  <para style="q2">nopinung nynh amaw kha a cciadue.</para>
  <para style="q1">
    <verse number="11" style="v" />Tuh-e nopinung tuh a roi ccae zah,</para>
  <para style="q2">kawngae khyh;</para>
  <para style="q2">innvaw um leite a khiavuikuh;</para>
  <para style="q1">
    <verse number="12" style="v" />sosoh hin laanpi kya um zah,</para>
  <para style="q2">sosoh hin kungkunaw kya a um,</para>
  <para style="q1">te laanpi tungkunaw miakaw kyakhe</para>
  <para style="q2">ngawdo zah a um.</para>
  <para style="q1">
    <verse number="13" style="v" />Tuh-e ccangvaepaw kha kyng zah a myng,</para>
  <para style="q2">te maethya leite tuh-e ccangvaepaw kha,</para>
  <para style="q1">
    <verse number="14" style="v" />“Silawkunaw rae lanpaw ka hoi zah,</para>
  <para style="q2">atunin ka byakinkunaw kha</para>
  <para style="q2">ka ccingsah vae;</para>
  <para style="q1">
    <verse number="15" style="v" />tukeiccuze nang kha tungku khylan</para>
  <para style="q2">atu kae pou vae,</para>
  <para style="q1">nang kha lungthote kae ccung zah</para>
  <para style="q2">kae muih vae!</para>
  <para style="q1">
    <verse number="16" style="v" />Ka ikhung kha Izip ram e</para>
  <para style="q2">nebaleihpaw laaw te kuakuhpaw</para>
  <para style="q2">iphae apuithyapaw khate ka ccaan vae;</para>
  <para style="q1">
    <verse number="17" style="v" />amynkhuhpaw mura,</para>
  <para style="q2">aloes te sinnamon khate</para>
  <para style="q2">ka ikhung kha ka thuh vae.</para>
  <para style="q1">
    <verse number="18" style="v" />Yn cceih, awkhualan awkhua cia</para>
  <para style="q2">sungsakunaw te phe byn lan hoysah sih;</para>
  <para style="q2">sungsakunaw khate hoysah sih.</para>
  <para style="q1">
    <verse number="19" style="v" />Pawccecize ka vawpaw tuh</para>
  <para style="q2">innvaw um khyh;</para>
  <para style="q2">laansaw lang khua a ccong.</para>
  <para style="q1">
    <verse number="20" style="v" />Phua kha zaw zung kheit te phukuh zah</para>
  <para style="q2">sawpaw sahpynglyn cia</para>
  <para style="q2">innvaw yn thua lan khyh,” a cipya.</para>
  <para style="q1">
    <verse number="21" style="v" />Soihnawpaw bya patae khate soih zah,</para>
  <para style="q2">nawpalipaw a byaho khate a nangse.</para>
  <para style="q1">
    <verse number="22" style="v" />Tangnuapaw nynh saw theihtupaw kalan</para>
  <para style="q2">a ccia hawte thuasah,</para>
  <para style="q1">the nynh aring-akua</para>
  <para style="q2">a thuing mawlaezung</para>
  <para style="q2">
    <verse number="23" style="v" />sazuh nynh kaang kalan</para>
  <para style="q2">a ccia hawte thuasah</para>
  <para style="q1">tuh-e ccangvaepaw nynh</para>
  <para style="q2">tuh-e nopinung kha a zui.</para>
  <para style="q1">Tuh-e ccangvaepaw tuh a hiinnaw</para>
  <para style="q2">a zosah cih paw kaang kha ny leite</para>
  <para style="q1">kaang lungkhu lang arangte</para>
  <para style="q2">a teepaw pavaw te nynh aloku.</para>
  <para style="q1">
    <verse number="24" style="v" />Te atu, ka ccaaw hae,</para>
  <para style="q2">ka bya hynh ngae oh lah,</para>
  <para style="q2">ka mung kya-e bya hynh hoyte ngae oh.</para>
  <para style="q1">
    <verse number="25" style="v" />Tuh-e nopinung umnaw laanpi langkhe</para>
  <para style="q2">nae thinlung kha maesakuh nan oh;</para>
  <para style="q2">a laanpi langkhe zuisei nan oh.</para>
  <para style="q1">
    <verse number="26" style="v" />Pawccecize tuh-e nopinung nynh</para>
  <para style="q2">ccungccaw patae kha a khulia vae hae,</para>
  <para style="q2">te a chia hae paw tuh myarya alung vae.</para>
  <para style="q1">
    <verse number="27" style="v" />A inn tuh chinaw khaan lang rungbung zah,</para>
  <para style="q2">michi khua lang a cceihpaw laanpi nynh thua.</para>
  <para style="b" />
  <chapter number="8" style="c" />
  <para style="s1">Hawnaw Lasung</para>
  <para style="q1">
    <verse number="1" style="v" />Hawnaw nynh ko khyh zah</para>
  <para style="q2">nythyanaw nynh mah</para>
  <para style="q2">a roisaw khyh tou?<note caller="-" style="x"><char style="xo" closed="false">8.1-3: </char><char style="xt" closed="false"><ref loc="PRO 1:20-21">Ptb 1.20-21</ref></char></note></para>
  <para style="q1">
    <verse number="2" style="v" />Laanpi pe ahangnaw kya te</para>
  <para style="q2">laanpi atungkunaw kyakhe a thadyn;</para>
  <para style="q1">
    <verse number="3" style="v" />khua teenaw koikua pe,</para>
  <para style="q2">thuakaw pi kyakhe sia zah,</para>
  <para style="q1">
    <verse number="4" style="v" />“Pou ccungccaw hae,</para>
  <para style="q2">nanning kha kae ko oh,</para>
  <para style="q2">ccungccaw balyn kalan ka sia.</para>
  <para style="q1">
    <verse number="5" style="v" />Tuanaw a zya hae paw,</para>
  <para style="q2">hawnaw kha ccangkuh oh;</para>
  <para style="q1">mingaee hae, tuanaw hoypaw kha</para>
  <para style="q2">ccangkuh oh.</para>
  <para style="q1">
    <verse number="6" style="v" />Ngaetua oh, asung-epaw uccaw hae kha</para>
  <para style="q2">kae hopah cih oh,</para>
  <para style="q2">ka mung kyate ahmepaw bya a toikuh cih;</para>
  <para style="q1">
    <verse number="7" style="v" />ka khalang nynh byaccing kha a ho cih;</para>
  <para style="q2">hoyleinaw tuh ka mung hanlan</para>
  <para style="q2">anungsikuhpaw nynh thua.</para>
  <para style="q1">
    <verse number="8" style="v" />Ka khalang kya-e bya hae tuh</para>
  <para style="q2">kyh zah, hynhupaw bya te</para>
  <para style="q2">kathuhkaleihpaw bya um khyh.</para>
  <para style="q1">
    <verse number="9" style="v" />A nyhthyapaw hanlan tuh</para>
  <para style="q2">byadingpaw thua zah,</para>
  <para style="q1">nynaw a hoipaw hanlan</para>
  <para style="q2">akyhpaw bya nynh thua.</para>
  <para style="q1">
    <verse number="10" style="v" />Ka thuiheinaw kha ngunphua laeze</para>
  <para style="q2">lawkuh hua oh lah,</para>
  <para style="q1">nynaw kha sui hoypaw laeze</para>
  <para style="q2">lawkuh hua oh;</para>
  <para style="q1">
    <verse number="11" style="v" />pawccecize hawnaw tuh</para>
  <para style="q2">aphutepaw lung laeze hoyhua zah,</para>
  <para style="q1">na rynaw balyn tuh hawnaw te</para>
  <para style="q2">khinkhia kho thua khyh.</para>
  <para style="q1">
    <verse number="12" style="v" />Hawnaw athuapaw kae tuh</para>
  <para style="q2">tuathyanaw te kae umkheih zah,</para>
  <para style="q2">nynaw te thaethyanaw kha ka hoi.</para>
  <para style="q1">
    <verse number="13" style="v" />
    <char style="nd">Bawipaw </char> rawrinaw tuh</para>
  <para style="q2">hoyleinaw kha huapaw nynh thua.</para>
  <para style="q1">Lysakunaw, tansakunaw,</para>
  <para style="q2">ozia hoyleinaw te</para>
  <para style="q2">lingpaw bya kha ka hua.</para>
  <para style="q1">
    <verse number="14" style="v" />Tuanaw hoypaw te</para>
  <para style="q2">hawnaw hoypaw kha ka hoi;</para>
  <para style="q2">nythyanaw te thawzung kha mah ka hoi.</para>
  <para style="q1">
    <verse number="15" style="v" />Kamaw liate siapharan hae nynh</para>
  <para style="q2">uk hae zah, uktu hae nynh</para>
  <para style="q2">akyhpaw phunglang kha a rae hae;</para>
  <para style="q1">
    <verse number="16" style="v" />Uktu hae nynh kamaw liate uk hae zah,</para>
  <para style="q2">a sung-e hae paw, kyhrarih lante</para>
  <para style="q1">a uk hae paw balyn nynh mah</para>
  <para style="q2">kamaw liate nynh a uk hae.</para>
  <para style="q1">
    <verse number="17" style="v" />Yn sungsah hae paw kha</para>
  <para style="q2">ka sungsah hae zah,</para>
  <para style="q1">zuakute yn ccung hae paw tuh</para>
  <para style="q2">yn muih hae.</para>
  <para style="q1">
    <verse number="18" style="v" />Hoirumnaw te sawtuanaw tuh</para>
  <para style="q2">ka kya a um, atynpaw sisua te</para>
  <para style="q2">laansui-uanaw mah a um hae.</para>
  <para style="q1">
    <verse number="19" style="v" />Ka kyate na muepaw tuh</para>
  <para style="q2">sui laeze ahoyhua,</para>
  <para style="q1">sui ccipaw lae heize ahoyhua.</para>
  <para style="q2">ka thuakhaepaw tuh</para>
  <para style="q2">ngunphua hoypaw laeze ahoyhua.</para>
  <para style="q1">
    <verse number="20" style="v" />Dingnaw laanpi kyakhe ka cceih zah,</para>
  <para style="q2">byading laanpi thyhte ka cceih,</para>
  <para style="q1">
    <verse number="21" style="v" />kamaw yn sungsah hae paw kha</para>
  <para style="q2">hoirumnaw ka pya hae zah,</para>
  <para style="q2">mih sisua bawng kha ka biasahpya hae.</para>
  <para style="q1">
    <verse number="22" style="v" />
    <char style="nd">Bawipaw </char> nynh langmawlya</para>
  <para style="q2">a rae hae paw kyaze</para>
  <para style="q1">masaty a ryalaw atakaw khe</para>
  <para style="q2">kae kha yn rae.<note caller="-" style="x"><char style="xo" closed="false">8.22: </char><char style="xt" closed="false"><ref loc="REV 3:14">Bya 3.14</ref></char></note></para>
  <para style="q1">
    <verse number="23" style="v" />Laephi thotakaw maw, langmawlya</para>
  <para style="q2">masaty khe kae kha yn rae vae.</para>
  <para style="q1">
    <verse number="24" style="v" />Akhupaw rili a um maw,</para>
  <para style="q2">tui te phe beihpaw tuidy hae</para>
  <para style="q2">a um mawkhe kae tuh ka pui vae.</para>
  <para style="q1">
    <verse number="25" style="v" />Mua pi hae te mua taraw hae</para>
  <para style="q2">a rae maw, kae tuh ka pui vae,</para>
  <para style="q1">
    <verse number="26" style="v" />laephi te loram hae a rae maw,</para>
  <para style="q2">laephi kya-e masaty laenoi</para>
  <para style="q2">a rae mawkhe, kae kha yn rae vae.</para>
  <para style="q1">
    <verse number="27" style="v" />Vaawlui a tynsah lyakhe kae tuh</para>
  <para style="q2">tuin kya ka um zah, rilipi vawlan</para>
  <para style="q2">a synria mawkhe ka um vae,</para>
  <para style="q1">
    <verse number="28" style="v" />luki lang umpaw vaawlui kha</para>
  <para style="q2">tynkaring lan a rae lya,</para>
  <para style="q2">rilipi hae kha he a tynsah lya,</para>
  <para style="q1">
    <verse number="29" style="v" />tui nynh a kaw a ei khyh nawlan,</para>
  <para style="q2">rili kha a umnaw a khyapya lyate</para>
  <para style="q1">laephi athotakawnaw kha</para>
  <para style="q2">a syntaw lyakhe,</para>
  <para style="q1">
    <verse number="30" style="v" />kae tuh amaw pe khe</para>
  <para style="q2">ryalaw athyapaw hawte ka um;</para>
  <para style="q1">kae tuh nin takyh a lungrypaw</para>
  <para style="q2">ka thua zah, amaw malang khe</para>
  <para style="q2">ka lung zungzae tua,</para>
  <para style="q1">
    <verse number="31" style="v" />a laephipi kya ka lungtua zah,</para>
  <para style="q2">ccungccaw hae kya</para>
  <para style="q1">ka lungrythua.</para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" />Te atu, ka ccaaw hae,</para>
  <para style="q2">ka bya hynh ngae oh:</para>
  <para style="q1">ka laanpi a zui hae paw tuh</para>
  <para style="q2">lungtuapaw nynh athua hae.</para>
  <para style="q1">
    <verse number="33" style="v" />Thuiheinaw kha ngae oh lah</para>
  <para style="q2">hawtua oh,</para>
  <para style="q1">e bya hynh pawlangria leite</para>
  <para style="q2">um nan oh.</para>
  <para style="q1">
    <verse number="34" style="v" />Ka bya kha ngae zah,</para>
  <para style="q2">nin takyh ka koikua kya umte,</para>
  <para style="q1">ka thuakaw pe khe</para>
  <para style="q2">phang a ngawpaw tuh</para>
  <para style="q2">lungtuapaw nynh athua.</para>
  <para style="q1">
    <verse number="35" style="v" />Pawccecize kae yn muihpaw</para>
  <para style="q2">humhung zemah</para>
  <para style="q1">hiinnaw kha muih zah,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kyate maehoynaw kha a mue;</para>
  <para style="q1">
    <verse number="36" style="v" />thuasalama kae yn muih leipaw tuh</para>
  <para style="q2">amaw te amaw kha a vawsawsaku;</para>
  <para style="q1">kae yn huapaw balyn tuh</para>
  <para style="q2">chinaw kha a sungsah hae,” a ci.</para>
  <para style="b" />
  <chapter number="9" style="c" />
  <para style="s1">Hawnaw te Ngaeenaw</para>
  <para style="q1">
    <verse number="1" style="v" />Hawnaw nynh a kya-e</para>
  <para style="q2">tung tungsari kha suee zah,</para>
  <para style="q2">a inn kha a sakku vae.</para>
  <para style="q1">
    <verse number="2" style="v" />A sarangpaw hae kha theih zah,</para>
  <para style="q2">a misutui te a pyde vae,</para>
  <para style="q2">a ccaboi kha mah a phae vae.</para>
  <para style="q1">
    <verse number="3" style="v" />A ryalahtu nopi hae kha a saw vae hae,</para>
  <para style="q2">khua lungkhu ahang huanaw hmin</para>
  <para style="q2">kyate sia zah,</para>
  <para style="q1">
    <verse number="4" style="v" />“Tuanaw a zya hae paw nanning,</para>
  <para style="q2">hynhlang rang oh!” a ci.</para>
  <para style="q2">Tuanaw a hoi lei hae paw kalan khe,</para>
  <para style="q1">
    <verse number="5" style="v" />“Rang oh, ka sanlou hynh ae oh lah,</para>
  <para style="q2">ka pyde vae paw misutui hynh neih oh.</para>
  <para style="q1">
    <verse number="6" style="v" />Ngaeenaw kha cciataw oh lah,</para>
  <para style="q2">hiin ccavae oh,</para>
  <para style="q1">hawnaw laanpi kha zui oh,” a ci.</para>
  <para style="b" />
  <para style="s1">Ahawpaw te Angaeepaw Laesahnaw</para>
  <para style="q1">
    <verse number="7" style="v" />Ccungccaw a saryathyapaw kha</para>
  <para style="q2">a thuiheipaw tuh</para>
  <para style="q1">maethya a bongkuh cih;</para>
  <para style="q2">ccungccaw hoyleipaw kha</para>
  <para style="q2">a thuiheipaw tuh vaemaw a mue cih.</para>
  <para style="q1">
    <verse number="8" style="v" />Ccungccaw a saryathyapaw kha</para>
  <para style="q2">na thuihei zetuh,</para>
  <para style="q1">hung ae huahan cih;</para>
  <para style="q2">ccungccaw hawpaw kha</para>
  <para style="q2">thuihei lah, ae sungsah cih.</para>
  <para style="q1">
    <verse number="9" style="v" />Mihawpaw kha thuihei lah,</para>
  <para style="q2">houh a haw cih;</para>
  <para style="q1">midingpaw kha ccangpah lah,</para>
  <para style="q2">thyanaw houh a mue cih.</para>
  <para style="q1">
    <verse number="10" style="v" />
    <char style="nd">Bawipaw </char> rawrinaw tuh</para>
  <para style="q2">hawnaw athotakawnaw nynh thua,</para>
  <para style="q1">Athyaapaw Pachia kha nynaw tuh</para>
  <para style="q2">akhupaw nynaw nynh thua.<note caller="-" style="x"><char style="xo" closed="false">9.10: </char><char style="xt" closed="false"><ref loc="JOB 28:28">Job 28.28</ref>; <ref loc="PSA 111:10">Sam 111.10</ref>; <ref loc="PRO 1:7">Ptb 1.7</ref></char></note></para>
  <para style="q1">
    <verse number="11" style="v" />Pawccecize kamaw liate</para>
  <para style="q2">na hiinshe asae cih zah,</para>
  <para style="q1">na hiin kum kha</para>
  <para style="q2">biachih pya na thua cih.</para>
  <para style="q1">
    <verse number="12" style="v" />Na haw ze, namaw</para>
  <para style="q2">thanenaw hanlan athua cih;</para>
  <para style="q1">Ccungccaw na sarya ze,</para>
  <para style="q2">tuh-e tuh na makhaete na teing cih.</para>
  <para style="b" />
  <para style="s1">Ngaeenaw nynh Kokunaw te Byakinpyakunaw</para>
  <para style="q1">
    <verse number="13" style="v" />Angaeepaw nopi tuh a roi accae;</para>
  <para style="q2">a tuanaw zya zah,</para>
  <para style="q2">pawpaw mah nyh khyh.</para>
  <para style="q1">
    <verse number="14" style="v" />A inn thuakaw kya a haung,</para>
  <para style="q2">khua lungkhu ahangnaw hmin kya</para>
  <para style="q2">umpaw haungnaw kyakhe a haung,</para>
  <para style="q1">
    <verse number="15" style="v" />mih laanpi lawbabin lan</para>
  <para style="q2">a cceih hae paw kha ko hae zah,</para>
  <para style="q1">
    <verse number="16" style="v" />“Tuanaw a zya hae paw,</para>
  <para style="q2">hynhlang rang oh!” a cipya hae.</para>
  <para style="q2">Tuanaw a hoi lei hae paw kyakhe,</para>
  <para style="q1">
    <verse number="17" style="v" />“Rupaw tui tuh e zah,</para>
  <para style="q2">aruh lante aepaw sanlou tuh athua,”</para>
  <para style="q2">a cipya hae.</para>
  <para style="q1">
    <verse number="18" style="v" />Thuasalama tuin kyakhe</para>
  <para style="q2">michi hae um hae zah,</para>
  <para style="q1">a mikhia hae tuh akhupaw</para>
  <para style="q2">michi khua kya nynh</para>
  <para style="q1">a um hae cipaw kha</para>
  <para style="q2">minmin nynh nyh khyh hae.</para>
  <para style="b" />
  <chapter number="10" style="c" />
  <para style="s1">Solomon Hawnaw Bya</para>
  <para style="p">
    <verse number="1" style="v" />Solomon phungtangbya hae:</para>
  <para style="b" />
  <para style="q1">Ahawpaw ccaaw nynh</para>
  <para style="q2">a paaw lung kha a tuasah,</para>
  <para style="q1">thuasalama angaeepaw ccaaw nynh tuh</para>
  <para style="q2">a nung kha a ngaethyasah.</para>
  <para style="q1">
    <verse number="2" style="v" />Hoyleinaw liate muepaw</para>
  <para style="q2">sisua tuh amia um khyh,</para>
  <para style="q1">thuasalama dingnaw nynh tuh</para>
  <para style="q2">chinaw kyate a luesah.</para>
  <para style="q1">
    <verse number="3" style="v" />
    <char style="nd">Bawipaw </char> nynh miding kha</para>
  <para style="q2">a vuelawsah lan ua khyh,</para>
  <para style="q1">thuasalama ccungccaw hoylei</para>
  <para style="q2">hae paw kya-e ryduaanaw kha tuh</para>
  <para style="q2">a pingpya hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Thawnawpaw kuih nynh</para>
  <para style="q2">ryachinaw kha a thuasah,</para>
  <para style="q1">thuasalama zuakunaw kuih nynh tuh</para>
  <para style="q2">hoirumnaw kha a thuasah.</para>
  <para style="q1">
    <verse number="5" style="v" />Hawnin ccyh kya uccaw</para>
  <para style="q2">a ccakhungkuhpaw ccaaw tuh</para>
  <para style="q1">a hawpaw nynh thua.</para>
  <para style="q2">thuasalama loohrue ccyh lya</para>
  <para style="q1">a ihpaw ccaaw tuh</para>
  <para style="q2">maethyanaw kha a thuakhae.</para>
  <para style="q1">
    <verse number="6" style="v" />Hythuanaw tuh</para>
  <para style="q2">miding hae lu vawlan a um,</para>
  <para style="q1">thuasalama ccungccaw hoyleipaw</para>
  <para style="q2">mung nynh tuh puathonaw kha</para>
  <para style="q2">phe a thuruh.</para>
  <para style="q1">
    <verse number="7" style="v" />Midingpaw kha liathuinaw tuh</para>
  <para style="q2">hythuanaw nynh thua,</para>
  <para style="q1">thuasalama ccungccaw hoyleipaw</para>
  <para style="q2">min kha tuh azo cih.</para>
  <para style="q1">
    <verse number="8" style="v" />A hawpaw nynh tuh</para>
  <para style="q2">kawbya kha a ccykeku,</para>
  <para style="q1">thuasalama bya kathuhkaleih</para>
  <para style="q2">a hopaw tuh ronaw kalan</para>
  <para style="q2">a phungkuh cih.</para>
  <para style="q1">
    <verse number="9" style="v" />Dingnaw kya a cceihpaw tuh</para>
  <para style="q2">khyndadyh lan a cceihpaw nynh thua,</para>
  <para style="q1">thuasalama akoupaw laanpi</para>
  <para style="q2">a zuipaw tuh muihbia athua cih.</para>
  <para style="q1">
    <verse number="10" style="v" />Mit phalyh a masipahpaw tuh</para>
  <para style="q2">vawsawnaw kha a thuasah,</para>
  <para style="q1">thuasalama rawthungte</para>
  <para style="q2">a thuiheipaw tuh daenaw kha a rae.</para>
  <para style="q1">
    <verse number="11" style="v" />Midingpaw khalang tuh</para>
  <para style="q2">hiinnaw tuidy nynh thua,</para>
  <para style="q1">thuasalama ccungccaw hoyleipaw</para>
  <para style="q2">a khalang nynh tuh puathonaw kha</para>
  <para style="q2">zya a thuruh.</para>
  <para style="q1">
    <verse number="12" style="v" />Huakunaw nynh</para>
  <para style="q2">pekumaekunaw lang a tangsah,</para>
  <para style="q1">thuasalama sungsahnaw nynh</para>
  <para style="q2">meseinaw balyn kha pong a bong.<note caller="-" style="x"><char style="xo" closed="false">10.12: </char><char style="xt" closed="false"><ref loc="JAS 5:20">Jam 5.20</ref>; <ref loc="1PE 4:8">1Pe 4.8</ref></char></note></para>
  <para style="q1">
    <verse number="13" style="v" />Nythyanaw a hoipaw</para>
  <para style="q2">munglae kyakhe hawnaw kha</para>
  <para style="q1">muih athua,</para>
  <para style="q2">thuasalama ccungngue tuh</para>
  <para style="q1">tuanaw a hoi leipaw</para>
  <para style="q2">ke hanlan nynh thua.</para>
  <para style="q1">
    <verse number="14" style="v" />Mihawpaw nynh nynaw kha</para>
  <para style="q2">a ccakhungku,</para>
  <para style="q1">thuasalama mingaeepaw nynh</para>
  <para style="q2">kathuhkaleih a hopaw bya tuh</para>
  <para style="q2">ronaw te anaekuh.</para>
  <para style="q1">
    <verse number="15" style="v" />Mihoipaw hoirumnaw tuh</para>
  <para style="q2">a kya-e atynpaw khualungrua nynh thua,</para>
  <para style="q1">A ryachipaw kya-e ryachinaw tuh</para>
  <para style="q2">amaw ronaw nynh thua.</para>
  <para style="q1">
    <verse number="16" style="v" />Miding hae ryalaw mee nynh</para>
  <para style="q2">mimaw kha hiinnaw kalan</para>
  <para style="q1">a cciakhae hae,</para>
  <para style="q2">thuasalama ccungccaw hoylei</para>
  <para style="q1">hae paw kya-e amia nynh</para>
  <para style="q2">mimaw kha seinaw kalan</para>
  <para style="q2">a cciakhae hae.</para>
  <para style="q1">
    <verse number="17" style="v" />Thuiheinaw a ngaepaw tuh</para>
  <para style="q2">hiinnaw laanpi kya nynh a um,</para>
  <para style="q1">thuasalama thuiheinaw</para>
  <para style="q2">a vuapaw tuh laanpi kha a mesei.</para>
  <para style="q1">
    <verse number="18" style="v" />A hynpaw mung nynh</para>
  <para style="q2">huakunaw kha a thuruh,</para>
  <para style="q1">ccungccaw thethya a hopaw tuh</para>
  <para style="q2">a ngaeepaw nynh thua.</para>
  <para style="q1">
    <verse number="19" style="v" />Bya patae ho lanze,</para>
  <para style="q2">seinaw a umthya,</para>
  <para style="q1">mihawpaw tuh byahonaw kya</para>
  <para style="q2">a sungkuh.</para>
  <para style="q1">
    <verse number="20" style="v" />Miding hae munglae tuh</para>
  <para style="q2">ngunphua hoypaw hawte nynh thua;</para>
  <para style="q1">ccungccaw hoyleipaw</para>
  <para style="q2">a thinlung tuh amee azya.</para>
  <para style="q1">
    <verse number="21" style="v" />Midingpaw munglae nynh</para>
  <para style="q2">ccungccaw patae kha looh a dan,</para>
  <para style="q1">thuasalama mingaee hae tuh</para>
  <para style="q2">tuanaw a hoi khyh keiccu hae ze</para>
  <para style="q2">a chih hae.</para>
  <para style="q1">
    <verse number="22" style="v" />
    <char style="nd">Bawipaw </char> hythuanaw nynh</para>
  <para style="q2">hoirumnaw kha thuakhae zah,</para>
  <para style="q1">tuh-e hoirumnaw kyakhe</para>
  <para style="q2">ngaethyanaw kha pybia khyh.</para>
  <para style="q1">
    <verse number="23" style="v" />Cyiseinaw hynh angaeepaw hanlan</para>
  <para style="q2">lungpawnawpaw hawte nynh thua,</para>
  <para style="q1">thuasalama nythyanaw</para>
  <para style="q2">a hoipaw hanlan hawnaw tuh</para>
  <para style="q2">lungpawnaw nynh thua.</para>
  <para style="q1">
    <verse number="24" style="v" />Ccungccaw hoyleipaw nynh</para>
  <para style="q2">a ripyapaw uccaw tuh</para>
  <para style="q1">a tungvaw kya a thua cih,</para>
  <para style="q2">thuasalama midingpaw nynh tuh</para>
  <para style="q2">a rypaw kha a mue cih,</para>
  <para style="q1">
    <verse number="25" style="v" />Khise atho ze, ccungccaw hoylei</para>
  <para style="q2">hae paw tuh phe a zo hae,</para>
  <para style="q1">thuasalama miding hae tuh</para>
  <para style="q2">zungzae atyn hae.</para>
  <para style="q1">
    <verse number="26" style="v" />Haw hanlan misutui ariapaw hawte,</para>
  <para style="q2">mit hanlan maeekhuh hawte nynh</para>
  <para style="q1">a thawnawpaw tuh</para>
  <para style="q2">ryalaw a nawtupaw hanlan athua.</para>
  <para style="q1">
    <verse number="27" style="v" />
    <char style="nd">Bawipaw </char> rawrinaw nynh</para>
  <para style="q2">hiinshe a saesah,</para>
  <para style="q1">thuasalama ccungccaw hoyleipaw</para>
  <para style="q2">hiinshe tuh adyn cih.</para>
  <para style="q1">
    <verse number="28" style="v" />Midingpaw ngaehoinaw tuh</para>
  <para style="q2">lungtuanaw te nynh athang,</para>
  <para style="q1">thuasalama ccungccaw hoyleipaw</para>
  <para style="q2">ngaehoinaw tuh</para>
  <para style="q2">accakaepaw lang nynh a tang.</para>
  <para style="q1">
    <verse number="29" style="v" />
    <char style="nd">Bawipaw </char> laanpi tuh</para>
  <para style="q2">miding hanlan rekunaw nynh thua,</para>
  <para style="q1">thuasalama hoyleinaw</para>
  <para style="q2">a rae hae paw kha a ro hae.</para>
  <para style="q1">
    <verse number="30" style="v" />Miding hae kha</para>
  <para style="q2">papin vua thua lan khyh hae,</para>
  <para style="q1">thuasalama ccungccaw hoylei</para>
  <para style="q2">hae paw tuh laephi kya</para>
  <para style="q2">um lan khyh hae.</para>
  <para style="q1">
    <verse number="31" style="v" />Midingpaw khalang nynh</para>
  <para style="q2">hawnaw bya kha a ho,</para>
  <para style="q1">thuasalama ahoy leipaw lae kha tuh</para>
  <para style="q2">thoh pae lan aw athua cih.</para>
  <para style="q1">
    <verse number="32" style="v" />Midingpaw mung nynh</para>
  <para style="q2">nawccaw lan umpaw kha a ny,</para>
  <para style="q1">thuasalama ccungccaw hoyleipaw</para>
  <para style="q2">mung nynh tuh arawsekuhpaw bya kha a ho.</para>
  <chapter number="11" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Ahme leipaw zawccu tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> hanlan</para>
  <para style="q1">anungsikuhpaw nynh thua,</para>
  <para style="q2">thuasalama ahmepaw</para>
  <para style="q2">khinlung kha tuh a lungrythua,</para>
  <para style="q1">
    <verse number="2" style="v" />Lysakunaw a um lanze,</para>
  <para style="q2">maethyanaw a um;</para>
  <para style="q1">thuasalama hawnaw tuh</para>
  <para style="q2">zakaw a sangsakuhpaw kya a um.</para>
  <para style="q1">
    <verse number="3" style="v" />Dingnaw nynh miding hae kha</para>
  <para style="q2">a cciakhae hae,</para>
  <para style="q1">thuasalama thyaruhnaw nynh</para>
  <para style="q2">mihyn hae kha a ro hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Thinria ccyh lya tuh</para>
  <para style="q2">hoirumnaw hynh thane khyh,</para>
  <para style="q1">thuasalama dingnaw nynh</para>
  <para style="q2">chinaw kyate a khum,</para>
  <para style="q1">
    <verse number="5" style="v" />Dingnaw nynh ccaenaw um leipaw</para>
  <para style="q2">ccungccaw kha a laanpi a lawsahpya,</para>
  <para style="q1">thuasalama ccungccaw hoy</para>
  <para style="q2">leipaw tuh a hoyleinaw liate</para>
  <para style="q2">a khuliakuh.</para>
  <para style="q1">
    <verse number="6" style="v" />Dingnaw nynh miding hae kha</para>
  <para style="q2">a khum hae,</para>
  <para style="q1">thuasalama a lungzi leipaw tuh</para>
  <para style="q2">a karankunaw keiccuze kaang a kae.</para>
  <para style="q1">
    <verse number="7" style="v" />Ccungccaw hoyleipaw tuh</para>
  <para style="q2">he a chih te, a ngaehoinaw kha</para>
  <para style="q2">phe aroh,</para>
  <para style="q1">ccungccaw hoyleipaw</para>
  <para style="q2">ngaehoinaw tuh</para>
  <para style="q2">accakaepaw lang nynh a tang.</para>
  <para style="q1">
    <verse number="8" style="v" />Miding tuh vawsawnaw kyate</para>
  <para style="q2">luesah thua zah, amaw ccelang</para>
  <para style="q1">ccungccaw hoyleipaw nynh</para>
  <para style="q2">tuh-e vawsawnaw lungkhu lang</para>
  <para style="q2">a tee ru.</para>
  <para style="q1">
    <verse number="9" style="v" />Pachia pawlangria leipaw nynh</para>
  <para style="q2">a khalang khate a innpaw kha a ro,</para>
  <para style="q1">thuasalama miding kha tuh</para>
  <para style="q2">hawnaw liate luesah athua.</para>
  <para style="q1">
    <verse number="10" style="v" />Miding hae nynh hoynaw</para>
  <para style="q2">a mue hae ze,</para>
  <para style="q1">akhuapi te mih lungtua;</para>
  <para style="q2">ccungccaw hoylei hae paw nynh</para>
  <para style="q1">ronaw a mue hae ze,</para>
  <para style="q2">lungtuate a sia hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Miding hae kya-e hythuanaw liate</para>
  <para style="q2">khuapi tuh hangthung athua,</para>
  <para style="q1">thuasalama ccungccaw hoylei hae</para>
  <para style="q2">munglae keiccuze khua tuh ro athua.</para>
  <para style="q1">
    <verse number="12" style="v" />Mingaee nynh tuh</para>
  <para style="q2">a innpaw kha a dothatheih,</para>
  <para style="q1">thuasalama a hawpaw tuh</para>
  <para style="q2">daebabi lan a um.</para>
  <para style="q1">
    <verse number="13" style="v" />Ccungccaw thethya</para>
  <para style="q2">a hothyapaw tuh byaru kha a phy,</para>
  <para style="q1">thuasalama a lungzipaw nynh tuh</para>
  <para style="q2">a thinlung kya zya a thuruh.</para>
  <para style="q1">
    <verse number="14" style="v" />Cciakhaenaw a um leinaw tuh</para>
  <para style="q2">ram a khuliakuh,</para>
  <para style="q1">thuasalama tuanaw hoypaw pyatu</para>
  <para style="q2">alungnaw kya tuh khynnaw a um.</para>
  <para style="q1">
    <verse number="15" style="v" />A ny leipaw ccungccaw laebah hanlan</para>
  <para style="q2">bya a kinpakuhpaw tuh</para>
  <para style="q1">vawsawnaw a tung cih,</para>
  <para style="q2">thuasalama tuhcite byakinpyaku lan</para>
  <para style="q2">a eipaw tuh a khyn cih.</para>
  <para style="q1">
    <verse number="16" style="v" />Thawccithyapaw nopi tuh</para>
  <para style="q2">sawtuanaw a mue,</para>
  <para style="q1">thuasalama a ozia hoy leipaw</para>
  <para style="q2">nopi tuh maethyanaw nynh thua.</para>
  <para style="q1">Rawthyanaw tuh pawpaw sanmah</para>
  <para style="q2">hoi leinaw lang a tang,</para>
  <para style="q">thuasalama a rawhoypaw tuh</para>
  <para style="q2">hoirumnaw a mue.</para>
  <para style="q1">
    <verse number="17" style="v" />Thawccinaw a hoipaw tuh</para>
  <para style="q2">amaw te amaw kha hoynaw a pyaku,</para>
  <para style="q1">thuasalama thawccinaw</para>
  <para style="q2">a hoi leipaw tuh amaw te amaw kha</para>
  <para style="q2">vawsawnaw a pyaku.</para>
  <para style="q1">
    <verse number="18" style="v" />Ccungccaw hoyleipaw nynh tuh</para>
  <para style="q2">ahme leipaw ryalaw mee kha nynh a mue,</para>
  <para style="q1">thuasalama dingnaw ccacii</para>
  <para style="q2">a vua hae paw tuh</para>
  <para style="q2">ahmepaw ryalaw mee kha a mue hae.</para>
  <para style="q1">
    <verse number="19" style="v" />Dingnaw kya</para>
  <para style="q2">varyng atynpaw tuh a hiin cih,</para>
  <para style="q1">thuasalama hoyleinaw kya</para>
  <para style="q2">a ohleihkuhpaw tuh a chih cih.</para>
  <para style="q1">
    <verse number="20" style="v" />Thinlung thyaruhpaw tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> hanlan</para>
  <para style="q1">anungsikuhpaw nynh thua,</para>
  <para style="q2">thuasalama ccaenaw um leipaw</para>
  <para style="q1">laanpi kha a zui hae paw kya tuh</para>
  <para style="q2">a lungrythua.</para>
  <para style="q1">
    <verse number="21" style="v" />Ccungccaw hoyleipaw tuh</para>
  <para style="q2">detahnaw mue leite um lan khyh.</para>
  <para style="q1">thuasalama miding hae tuh</para>
  <para style="q2">a lue cih hae.</para>
  <para style="q1">
    <verse number="22" style="v" />A puithya zemah tuanaw-roihnaw</para>
  <para style="q2">a hoi leipaw nopi tuh</para>
  <para style="q1">voh naduh kya-e</para>
  <para style="q2">sui kuihpu te nynh aloku.</para>
  <para style="q1">
    <verse number="23" style="v" />Miding hae rynaw tuh</para>
  <para style="q2">hoynaw te rou nynh</para>
  <para style="q1">a thangkhaeku;</para>
  <para style="q2">ccungccaw hoyleipaw nynh</para>
  <para style="q1">a ngaehoinaw tuh</para>
  <para style="q2">thinrianaw te nynh a thangkhaeku.</para>
  <para style="q1">
    <verse number="24" style="v" />Ccungccaw abang nynh</para>
  <para style="q2">rythyte a pya hae zemah,</para>
  <para style="q1">houh a hoithung hae;</para>
  <para style="q2">mingccang hae tuh</para>
  <para style="q1">mih sithah zahmah,</para>
  <para style="q2">ahobounaw houh alung.</para>
  <para style="q1">
    <verse number="25" style="v" />A lung-uapaw ccungccaw tuh</para>
  <para style="q2">a hoirum cih zah,</para>
  <para style="q1">milae kha tui a pyapaw tuh</para>
  <para style="q2">amaw kha mah tui pyaru athua cih.</para>
  <para style="q1">
    <verse number="26" style="v" />Looh kha phang a byhpaw tuh</para>
  <para style="q2">ccungccaw hae nynh</para>
  <para style="q2">thya a law cih hae,</para>
  <para style="q1">thuasalama looh a zua hae paw lu</para>
  <para style="q2">vawlan khe hythuanaw a um cih.</para>
  <para style="q1">
    <verse number="27" style="v" />Hoynaw kha zuakute</para>
  <para style="q2">a ccungpaw tuh maehoynaw a mue cih,</para>
  <para style="q2">thuasalama hoyleinaw</para>
  <para style="q1">a ccungpaw tuh hoyleinaw nynh</para>
  <para style="q2">a thuanua cih.</para>
  <para style="q1">
    <verse number="28" style="v" />A hoirumnaw kha</para>
  <para style="q2">a doliakuhpaw tuh</para>
  <para style="q1">baleih anaan cih,</para>
  <para style="q2">thuasalama miding tuh thingnaw</para>
  <para style="q2">hinlalyhpaw hawte a hiin cih.</para>
  <para style="q1">
    <verse number="29" style="v" />A innbyn kya vawsawnaw</para>
  <para style="q2">a thuakhaepaw tuh khivae kha</para>
  <para style="q1">rho lang a ccou cih,</para>
  <para style="q2">A ngaeepaw nynh a hawpaw kha</para>
  <para style="q2">rya a lawpah cih.</para>
  <para style="q1">
    <verse number="30" style="v" />Miding nynh a thaepaw thae tuh</para>
  <para style="q2">hiinnaw thingku nynh thua,</para>
  <para style="q2">puathonaw nynh hiinnaw kha a ro.</para>
  <para style="q1">
    <verse number="31" style="v" />Miding nynh mah laephi vawlan hin</para>
  <para style="q2">a ryalaw mee kha a mue ze,</para>
  <para style="q1">ccungccaw hoyleipaw te</para>
  <para style="q2">miseipaw nynh pawcih alungpaw</para>
  <para style="q1">amee kha mou houh a mue cih?<note caller="-" style="x"><char style="xo" closed="false">11.31: </char><char style="xt" closed="false"><ref loc="1PE 4:18">1Pe 4.18</ref></char></note></para>
  <chapter number="12" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Thuiheikunaw a rypaw tuh</para>
  <para style="q2">hawnaw kha a ry,</para>
  <para style="q1">thuasalama thuiheikunaw kha</para>
  <para style="q2">a huapaw tuh mingaee nynh thua.</para>
  <para style="q1">
    <verse number="2" style="v" />Ccungccaw hoypaw tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kyate</para>
  <para style="q2">maehoynaw kha a mue,</para>
  <para style="q1">thuasalama hoyleinaw</para>
  <para style="q2">khua a khanpaw kha tuh de a tah.</para>
  <para style="q1">
    <verse number="3" style="v" />Ccungccaw hynh hoyleinaw liate</para>
  <para style="q2">khynkuh khyh,</para>
  <para style="q1">thuasalama miding tharui tuh</para>
  <para style="q2">nue kho thua khyh.</para>
  <para style="q1">
    <verse number="4" style="v" />Ahoypaw zu tuh</para>
  <para style="q2">a vawpaw bawilukhung nynh thua,</para>
  <para style="q2">thuasalama maethyanaw</para>
  <para style="q1">a thuakhaepaw zu tuh</para>
  <para style="q2">a vawpaw ru kya-e</para>
  <para style="q2">athuhpaw hawte nynh athua.</para>
  <para style="q1">
    <verse number="5" style="v" />Miding hae paccynnaw tuh akyh;</para>
  <para style="q2">ccungccaw hoylei hae paw nynh</para>
  <para style="q1">tuanaw pyakupaw tuh</para>
  <para style="q2">hynhupaw nynh thua.</para>
  <para style="q1">
    <verse number="6" style="v" />Ccungccaw hoylei hae paw</para>
  <para style="q2">bya nynh ccungccaw</para>
  <para style="q2">chia khylan a buhkhaw,</para>
  <para style="q1">thuasalama miding hae bya nynh tuh</para>
  <para style="q2">minmin kha a khum hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Ccungccaw hoylei hae paw tuh</para>
  <para style="q2">khuliakuh hae zah, phe a zo hae,</para>
  <para style="q1">thuasalama miding hae inn tuh</para>
  <para style="q2">tynkaring lan a thadyn cih.</para>
  <para style="q1">
    <verse number="8" style="v" />Ccungccaw tuh hawnaw thyhte</para>
  <para style="q2">thehoynaw ccou athua,</para>
  <para style="q1">thuasalama a thinlung</para>
  <para style="q2">hoyleipaw tuh a theihrya hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Aerua a hoi lei pite</para>
  <para style="q2">amaw te amaw a hangsakuhpaw laeze</para>
  <para style="q1">a dothatheih hae paw,</para>
  <para style="q2">amaw te amaw rya</para>
  <para style="q2">a lawkuhpaw tuh ahoyhua.</para>
  <para style="q1">
    <verse number="10" style="v" />Miding nynh tuh</para>
  <para style="q2">a sahiin-awvaw nynh</para>
  <para style="q1">ahobounaw kha a nypya,</para>
  <para style="q2">thuasalama ccungccaw</para>
  <para style="q1">hoylei hae paw kya-e</para>
  <para style="q2">thawccinaw tuh</para>
  <para style="q2">rysawthyanaw nynh thua.</para>
  <para style="q1">
    <verse number="11" style="v" />A laephi kya rya</para>
  <para style="q2">a lawkuhpaw tuh looh patae a hoi,</para>
  <para style="q1">thuasalama ccungkia leipaw ryalaw kya</para>
  <para style="q2">ccyh a thangsah hanpaw tuh</para>
  <para style="q2">mingaee nynh thua.</para>
  <para style="q1">
    <verse number="12" style="v" />Ccungccaw hoylei hae paw nynh</para>
  <para style="q2">a duaa hae paw tuh</para>
  <para style="q2">hoyleinaw raepaw kha nynh thua,</para>
  <para style="q1">thuasalama miding tharui nynh tuh</para>
  <para style="q2">thae kha a thae.</para>
  <para style="q1">
    <verse number="13" style="v" />Ccungccaw hoyleipaw tuh</para>
  <para style="q2">a munglae seinaw keiccuze</para>
  <para style="q2">kaang a kae,</para>
  <para style="q1">thuasalama miding tuh</para>
  <para style="q2">vawsawnaw kyate a lue.</para>
  <para style="q1">
    <verse number="14" style="v" />Ccungccaw tuh khalang kya-e</para>
  <para style="q2">thae liate ahoypaw</para>
  <para style="q1">uccaw hae khate vueso lan a um,</para>
  <para style="q2">ccungccaw tuh thawzung te</para>
  <para style="q2">rya a law mee kha a mue cih.</para>
  <para style="q1">
    <verse number="15" style="v" />Mingaee nynh tuh a cyipaw kha</para>
  <para style="q2">akyh cite a tua,</para>
  <para style="q1">thuasalama mihawpaw nynh tuh</para>
  <para style="q2">tuanaw pyapaw kha a lawku.</para>
  <para style="q1">
    <verse number="16" style="v" />Mingaee nynh tuh</para>
  <para style="q2">a thinrianaw kha palou a langsaku,</para>
  <para style="q2">thuasalama mihawpaw nynh tuh</para>
  <para style="q2">maethyanaw kha a khawsung.</para>
  <para style="q1">
    <verse number="17" style="v" />Byaccing a hopaw nynh tuh</para>
  <para style="q2">ahmepaw ccaekia kha a khan,</para>
  <para style="q1">thuasalama ahme leipaw</para>
  <para style="q2">ccaekia nynh tuh hynbya kha a ho.</para>
  <para style="q1">
    <verse number="18" style="v" />Tuase leite hopaw bya tuh</para>
  <para style="q2">ccezung te thuingpaw te nynh aloku,</para>
  <para style="q1">thuasalama mihawpaw bya nynh tuh</para>
  <para style="q2">dannaw kha a thuakhae.</para>
  <para style="q1">
    <verse number="19" style="v" />Zyn lan umpaw munglae tuh</para>
  <para style="q2">zungzae atyn,</para>
  <para style="q1">thuasalama ahynpaw munglae tuh</para>
  <para style="q2">sosoh rou nynh atyn.</para>
  <para style="q1">
    <verse number="20" style="v" />Hynbya tuh hoyleinaw</para>
  <para style="q2">khua a khan hae paw</para>
  <para style="q1">thinlung kya nynh a um,</para>
  <para style="q2">thuasalama daenaw elang</para>
  <para style="q1">tuanaw a pya hae paw tuh</para>
  <para style="q2">lungtuanaw a hoi hae.</para>
  <para style="q1">
    <verse number="21" style="v" />Miding hae tungvaw kya</para>
  <para style="q2">vawsawnaw thua khyh,</para>
  <para style="q1">thuasalama ccungccaw</para>
  <para style="q2">hoylei hae paw tuh</para>
  <para style="q2">vawsawnaw te abeih cih hae.</para>
  <para style="q1">
    <verse number="22" style="v" />Ahynpaw munglae tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> hanlan anungsikuh,</para>
  <para style="q2">thuasalama lungzinaw</para>
  <para style="q1">a hoi hae paw tungvaw kya</para>
  <para style="q2">a lungrythua.</para>
  <para style="q1">
    <verse number="23" style="v" />Mihawpaw tuh a hawnaw kha</para>
  <para style="q2">a thuruh,</para>
  <para style="q1">thuasalama mingaeepaw</para>
  <para style="q2">thinlung nynh tuh</para>
  <para style="q2">ngaeenaw kha a langsahku.</para>
  <para style="q1">
    <verse number="24" style="v" />Ryalaw a zuakuhpaw</para>
  <para style="q2">ccungccaw nynh a uk cih,</para>
  <para style="q1">a thawnawpaw tuh</para>
  <para style="q2">nangsekute ryalawnaw kya</para>
  <para style="q2">nung athua cih.</para>
  <para style="q1">
    <verse number="25" style="v" />Lungriathaenaw nynh</para>
  <para style="q2">ccungccaw lung kha tuasah khyh,</para>
  <para style="q1">thuasalama bya hoypaw nynh tuh</para>
  <para style="q2">ccungccaw lung a tuasah.</para>
  <para style="q1">
    <verse number="26" style="v" />Miding nynh tuh a ban hae kha</para>
  <para style="q2">tuanaw hoypaw a pya hae,</para>
  <para style="q1">thuasalama ccungccaw hoyleipaw</para>
  <para style="q2">laanpi nynh tuh a cciakhaesei hae.</para>
  <para style="q1">
    <verse number="27" style="v" />A thawnawpaw tuh saw dee zah</para>
  <para style="q2">a kaw zemah rangkuh boi khyh,</para>
  <para style="q1">thuasalama a zuakuhpaw tuh</para>
  <para style="q2">aphutepaw sisua kha a mue.</para>
  <para style="q1">
    <verse number="28" style="v" />Dingnaw laanpi kya hiinnaw a um,</para>
  <para style="q2">tuh-e laanpi zuinaw kya</para>
  <para style="q1">chinaw um khyh.</para>
  <chapter number="13" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Ahawpaw ccaaw tuh</para>
  <para style="q2">a paaw thuiheinaw kha a ngae,</para>
  <para style="q1">thuasalama ccungccaw</para>
  <para style="q2">a saryapaw nynh tuh</para>
  <para style="q2">thuiheinaw kha ngae khyh.</para>
  <para style="q1">
    <verse number="2" style="v" />Ccungccaw hoypaw nynh</para>
  <para style="q2">a bya kya-e athae athuapaw,</para>
  <para style="q1">ahoypaw uccaw kha a ae,</para>
  <para style="q2">thuasalama ahynpaw</para>
  <para style="q1">ccungccaw hae nynh tuh</para>
  <para style="q2">puathonaw kha a ry hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Munglae a raeringkuh hae paw tuh</para>
  <para style="q2">mih hiinnaw kha a khynsaku hae;</para>
  <para style="q1">raeringku leite bya a hopaw tuh</para>
  <para style="q2">amaw toulou kha a roku.</para>
  <para style="q1">
    <verse number="4" style="v" />A thawnawpaw nynh</para>
  <para style="q2">ccangkhakheit kha a ry zemah</para>
  <para style="q1">pawpaw sanmah mue khyh,</para>
  <para style="q2">a zuakuhpaw nynh tuh</para>
  <para style="q2">phe zaw lan a mue cih.</para>
  <para style="q1">
    <verse number="5" style="v" />Miding nynh tuh hynbya kha a hua,</para>
  <para style="q2">thuasalama ccungccaw hoyleipaw</para>
  <para style="q1">ryalaw tuh nungsikuh zah</para>
  <para style="q2">maethya lan a um.</para>
  <para style="q1">
    <verse number="6" style="v" />Dingnaw nynh laanding</para>
  <para style="q2">a zuipaw kha a thungkhaw,</para>
  <para style="q1">thuasalama hoyleinaw nynh</para>
  <para style="q2">misei hae kha a khulia hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Ccungccaw abang tuh</para>
  <para style="q2">pawpaw sanmah a hoi khyh hae zemah,</para>
  <para style="q1">mihoipaw hawte a umsaku hae,</para>
  <para style="q2">abang nynh tuh sisua</para>
  <para style="q1">patae a hoi hae zemah</para>
  <para style="q2">ryachi hawte a umsaku hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Hoirumnaw tuh mihoipaw hiinnaw kha</para>
  <para style="q2">shawkhawkunawpaw nynh thua,</para>
  <para style="q1">thuasalama a ryachipaw nynh tuh</para>
  <para style="q2">hurawnaw bya kha thae khyh.</para>
  <para style="q1">
    <verse number="9" style="v" />Miding hae awnaw tuh phaephae a ak,</para>
  <para style="q2">thuasalama ccungccaw hoylei hae paw</para>
  <para style="q2">maeekhua tuh a chih cih.</para>
  <para style="q1">
    <verse number="10" style="v" />Lysahkunaw nynh tuh</para>
  <para style="q2">pekumaekunaw kha a thuakhae,</para>
  <para style="q1">thuasalama hawnaw tuh</para>
  <para style="q2">tuanaw pyakupaw</para>
  <para style="q2">a lawkuh hae paw kyakhe a um.</para>
  <para style="q1">
    <verse number="11" style="v" />Arangte muepaw hoirumnaw tuh</para>
  <para style="q2">azyabung cih,</para>
  <para style="q1">thuasalama beihtararaw te sisua</para>
  <para style="q2">a tungkuh hae paw tuh</para>
  <para style="q2">a hoithung cih hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Ngaehoinaw tuh accyh aro ze,</para>
  <para style="q2">thinlung accih,</para>
  <para style="q1">thuasalama rynaw he accing tuh</para>
  <para style="q2">hiinnaw thingku nynh thua.</para>
  <para style="q1">
    <verse number="13" style="v" />Ccangpyanaw kha</para>
  <para style="q2">pawlang a ria leipaw tuh</para>
  <para style="q1">amaw toulou tungvaw</para>
  <para style="q2">ronaw a thuakhae,</para>
  <para style="q1">thuasalama kawbya kha</para>
  <para style="q2">saw a tuapaw tuh lasung a mue cih.</para>
  <para style="q1">
    <verse number="14" style="v" />Mihawpaw kya-e ccangpyanaw tuh</para>
  <para style="q2">chinaw kaang kha sibia nawlan</para>
  <para style="q2">hiinnaw tuidy nynh thua,</para>
  <para style="q1">
    <verse number="15" style="v" />Hawnaw hoypaw a hoipaw nynh</para>
  <para style="q2">maehoynaw kha a mue,</para>
  <para style="q1">thuasalama a lungzi leipaw</para>
  <para style="q2">laanpi tuh ronaw laanpi nynh thua.</para>
  <para style="q1">
    <verse number="16" style="v" />Mihawpaw tuh atyn-are kha</para>
  <para style="q2">hawnaw khate nynh a cyi,</para>
  <para style="q1">thuasalama mingaeepaw tuh</para>
  <para style="q2">a ngaeenaw kha a langsaku.</para>
  <para style="q1">
    <verse number="17" style="v" />Ahoy leipaw zeccuetu nynh</para>
  <para style="q2">vawsawnaw a thuakhae,</para>
  <para style="q1">thuasalama a lungzipaw locceihtu nynh</para>
  <para style="q2">dannaw kha a thuakhae.</para>
  <para style="q1">
    <verse number="18" style="v" />Thuiheinaw kha</para>
  <para style="q2">pawlangria leipaw tuh</para>
  <para style="q1">ryachinaw te maethyanaw nynh</para>
  <para style="q2">a thuanua,</para>
  <para style="q1">thuasalama thuiheinaw</para>
  <para style="q2">a ngaepaw tuh sawtuanaw a mue.</para>
  <para style="q1">
    <verse number="19" style="v" />Rypaw kha muepaw tuh</para>
  <para style="q2">lungpawnaw nynh thua,</para>
  <para style="q1">thuasalama hoyleinaw kyate</para>
  <para style="q2">maeleihkupaw tuh</para>
  <para style="q1">mingaee hae hanlan</para>
  <para style="q2">anungsikuhpaw nynh thua.</para>
  <para style="q1">
    <verse number="20" style="v" />Mihaw hae ryte</para>
  <para style="q2">a mungkuh hae paw tuh a haw cih,</para>
  <para style="q1">thuasalama mingaee hae ryte</para>
  <para style="q2">a mungkuh hae paw tuh</para>
  <para style="q2">vawsawnaw a tung cih.</para>
  <para style="q1">
    <verse number="21" style="v" />Misei hae kha</para>
  <para style="q2">vethyanaw nynh a deehui hae,</para>
  <para style="q1">thuasalama miding hae tuh</para>
  <para style="q2">hoynaw lasung a mue hae.</para>
  <para style="q1">
    <verse number="22" style="v" />Ccungccaw hoypaw nynh tuh</para>
  <para style="q2">a mintaw hae kyacia</para>
  <para style="q1">rho a nungpya sya hae,</para>
  <para style="q2">thuasalama miseipaw</para>
  <para style="q1">hoirumnaw kha</para>
  <para style="q2">miding hae hanlan suelua athua.</para>
  <para style="q1">
    <verse number="23" style="v" />Khomaw loo nynh</para>
  <para style="q2">ryachi hae hanlan</para>
  <para style="q1">looh patae a voipya hae,</para>
  <para style="q2">thuasalama tuh-e tuh</para>
  <para style="q2">dingleinaw keiccuze phe azo.</para>
  <para style="q1">
    <verse number="24" style="v" />Ccungngue a mang leipaw tuh</para>
  <para style="q2">a ccaaw a huapaw nynh thua,</para>
  <para style="q1">thuasalama a ccaaw</para>
  <para style="q2">a sungsahpaw tuh a ccaaw</para>
  <para style="q2">a di lya maw te hoyte a thuihei.</para>
  <para style="q1">
    <verse number="25" style="v" />Miding tuh ae lanpaw</para>
  <para style="q2">phe zaw lan a hoi,</para>
  <para style="q1">thuasalama ccungccaw</para>
  <para style="q2">hoylei hae paw tuh</para>
  <para style="q1">zungzae mih vuelaw.</para>
  <chapter number="14" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Ahawpaw nopi nynh</para>
  <para style="q2">a inn kha a sak,</para>
  <para style="q1">thuasalama angaeepaw nopi nynh tuh</para>
  <para style="q2">amaw kuih toulou khate</para>
  <para style="q2">a inn kha a phou.</para>
  <para style="q1">
    <verse number="2" style="v" />Dingnaw kya a cceih hae paw tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> raw a rih hae,</para>
  <para style="q1">thuasalama a thyaruh hae paw nynh tuh</para>
  <para style="q2">amaw kha pawlangria khyh hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Mingaeepaw nynh a hopaw bya tuh</para>
  <para style="q2">amaw ke hanlan</para>
  <para style="q2">ccungngue nynh thua,</para>
  <para style="q1">thuasalama mihaw hae munglae nynh tuh</para>
  <para style="q2">mimaw kha a thungkhaw hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Tangnuapaw um leinaw kya-e</para>
  <para style="q2">vaetua aenawpaw kua tuh</para>
  <para style="q1">thyaararih lan accawnghan,</para>
  <para style="q2">thuasalama vaetua thawzung liate</para>
  <para style="q2">looh patae avoi.</para>
  <para style="q1">
    <verse number="5" style="v" />Alungzipaw ccaekia tuh</para>
  <para style="q2">hynbya ho khyh,</para>
  <para style="q1">thuasalama ahme leipaw</para>
  <para style="q2">ccaekia nynh tuh hynbya a ho.</para>
  <para style="q1">
    <verse number="6" style="v" />Sarya a mangpaw nynh tuh</para>
  <para style="q2">hawnaw kha a ccung zemah alakaw,</para>
  <para style="q1">thuasalama a nyhthyapaw nynh tuh</para>
  <para style="q2">hawnaw kha zoikadeihte a mue.</para>
  <para style="q1">
    <verse number="7" style="v" />Mingaeepaw nynh</para>
  <para style="q2">a umnaw kha cciatawtua,</para>
  <para style="q1">pawccecize tuin kyakhe</para>
  <para style="q2">hawnaw bya na muih lan khyh.</para>
  <para style="q1">
    <verse number="8" style="v" />Mihawpaw hawnaw tuh</para>
  <para style="q2">a ccianaw laanpi kha a nyku,</para>
  <para style="q1">thuasalama mingaeepaw</para>
  <para style="q2">a ngaeenaw nynh tuh a cciakhaesei.</para>
  <para style="q1">
    <verse number="9" style="v" />Mingaee hae nynh</para>
  <para style="q2">seinaw kha pawtua-ungsah khyh hae,</para>
  <para style="q1">thuasalama miding tuh</para>
  <para style="q2">Pachia kya-e maehoynaw kyakhe a lungtua.</para>
  <para style="q1">
    <verse number="10" style="v" />Thinlung nynh</para>
  <para style="q2">amaw vawsawnaw kha a nyku,</para>
  <para style="q1">a lungtuanaw kha mah</para>
  <para style="q2">milae hae kya neethungbua khyh.</para>
  <para style="q1">
    <verse number="11" style="v" />Ccungccaw hoyleipaw inn tuh</para>
  <para style="q2">ro athua cih,</para>
  <para style="q1">thuasalama midingpaw bu tuh</para>
  <para style="q2">atyn cih.</para>
  <para style="q1">
    <verse number="12" style="v" />Ccungccaw nynh akyhpaw</para>
  <para style="q2">laanpi cite a tuapaw kha,</para>
  <para style="q1">athangnaw tuh chinaw lang</para>
  <para style="q2">a cceihpaw laanpi nynh thua.<note caller="-" style="x"><char style="xo" closed="false">14.12: </char><char style="xt" closed="false"><ref loc="PRO 16:25">Ptb 16.25</ref></char></note></para>
  <para style="q1">
    <verse number="13" style="v" />Ccungccaw tuh a nuin lyakhe heize</para>
  <para style="q2">a thinlung kya a ngaethah kho,</para>
  <para style="q1">lungtuanaw athangnaw tuh</para>
  <para style="q2">ngaethyanaw nynh thua.</para>
  <para style="q1">
    <verse number="14" style="v" />A ccouseikuhpaw ccungccaw tuh</para>
  <para style="q2">a hiinzia khate a vueso cih zah,</para>
  <para style="q1">ccungccaw hoypaw tuh</para>
  <para style="q2">a cyisahnaw khate a vueso cih.</para>
  <para style="q1">
    <verse number="15" style="v" />Tuanaw a zyapaw nynh tuh</para>
  <para style="q2">atyn-are kha a zyn,</para>
  <para style="q1">thuasalama a hawpaw nynh tuh</para>
  <para style="q2">a ccianaw laanpi kha hoyte a doku.</para>
  <para style="q1">
    <verse number="16" style="v" />Mihawpaw tuh</para>
  <para style="q2">raeringkute um zah</para>
  <para style="q1">hoyleinaw kha a sibia,</para>
  <para style="q2">thuasalama mingaeepaw nynh tuh</para>
  <para style="q2">synkuh khyh zah a sawphahkuh.</para>
  <para style="q1">
    <verse number="17" style="v" />A thindynpaw ccungccaw nynh tuh</para>
  <para style="q2">ngaeepaw rya kha a law,</para>
  <para style="q2">Ahoy leipaw</para>
  <para style="q1">paccynkunaw a hoipaw tuh</para>
  <para style="q2">ccungccaw hae nynh a hua hae.</para>
  <para style="q1">
    <verse number="18" style="v" />Tuanaw a zyapaw tuh</para>
  <para style="q2">ngaeenaw rho kha a ccou,</para>
  <para style="q1">thuasalama a hawpaw tuh</para>
  <para style="q2">hawnaw kha bawilukhung lang</para>
  <para style="q2">a khungku.</para>
  <para style="q1">
    <verse number="19" style="v" />Ccungccaw hoyleipaw tuh</para>
  <para style="q2">ccungccaw hoypaw malang khe</para>
  <para style="q2">a bakhung,</para>
  <para style="q1">ccungccaw hoyleipaw tuh</para>
  <para style="q2">miding hae koikua kyakhe</para>
  <para style="q2">a bakhung.</para>
  <para style="q1">
    <verse number="20" style="v" />A ryachipaw tuh</para>
  <para style="q2">a innpaw hae nynh heize</para>
  <para style="q2">a hua hae,</para>
  <para style="q1">thuasalama mihoipaw tuh</para>
  <para style="q2">ruiban patae a hoi.</para>
  <para style="q1">
    <verse number="21" style="v" />A innpaw kha a theihryapaw tuh</para>
  <para style="q2">misei nynh thua,</para>
  <para style="q1">thuasalama ryachi hae kha</para>
  <para style="q2">thaw a ccih hae paw tuh</para>
  <para style="q2">lungtua hae paw nynh thua.</para>
  <para style="q1">
    <verse number="22" style="v" />Ahoy leipaw paccynkunaw</para>
  <para style="q2">a hoi hae paw tuh</para>
  <para style="q1">sei khyh hae tou?</para>
  <para style="q2">Ahoypaw kha</para>
  <para style="q2">a paccyn hae paw tuh</para>
  <para style="q1">lungzinaw te zyn lan umnaw kha</para>
  <para style="q2">a mue cih hae.</para>
  <para style="q1">
    <verse number="23" style="v" />Ryalaw rupaw miakaw kya</para>
  <para style="q2">thanenaw a um,</para>
  <para style="q1">thuasalama bya kyalya</para>
  <para style="q2">honaw nynh tuh</para>
  <para style="q2">ryachinaw rou kha nynh athuakhae.</para>
  <para style="q1">
    <verse number="24" style="v" />Mihaw hae bawilukhung tuh</para>
  <para style="q2">mih hawnaw kha nynh thua,</para>
  <para style="q1">thuasalama ngaeenaw tuh</para>
  <para style="q2">mingaee hae kya-e</para>
  <para style="q2">haetapawsi nynh thua.</para>
  <para style="q1">
    <verse number="25" style="v" />Ahmepaw ccaekia nynh tuh</para>
  <para style="q2">ccungccaw hiinnaw kha a khum,</para>
  <para style="q1">thuasalama hynbya a hopaw tuh</para>
  <para style="q2">ccungccaw a pheepaw nynh thua.</para>
  <para style="q1">
    <verse number="26" style="v" />
    <char style="nd">Bawipaw </char> raw a rihpaw tuh</para>
  <para style="q2">zynkunaw varyng hoi zah,</para>
  <para style="q1">a ccaaw hae mah</para>
  <para style="q2">khynnaw a hoi cih hae.</para>
  <para style="q1">
    <verse number="27" style="v" />
    <char style="nd">Bawipaw </char> rawrinaw tuh</para>
  <para style="q2">chinaw kaang kha</para>
  <para style="q1">sibia khonawpaw</para>
  <para style="q2">hiinnaw tuidy nynh thua.</para>
  <para style="q1">
    <verse number="28" style="v" />Siapharan phu-enaw tuh</para>
  <para style="q2">ccungccaw zapi kya nynh a um,</para>
  <para style="q1">thuasalama ccungccaw zapi</para>
  <para style="q2">a um khyh lanze,</para>
  <para style="q2">uktu siapharan tuh aroh.</para>
  <para style="q1">
    <verse number="29" style="v" />A lungsaepaw tuh</para>
  <para style="q2">myarya hawpaw nynh thua,</para>
  <para style="q1">thuasalama a thindynpaw nynh tuh</para>
  <para style="q2">ngaeenaw kha a langsaku.</para>
  <para style="q1">
    <verse number="30" style="v" />Lungdaenaw nynh</para>
  <para style="q2">pynsaw kha a dansah,</para>
  <para style="q1">thuasalama eiungnaw nynh tuh</para>
  <para style="q2">ru kha a mueesah.</para>
  <para style="q1">
    <verse number="31" style="v" />Ryachi hae kha</para>
  <para style="q2">a tuaa a sah hae paw tuh</para>
  <para style="q1">minmin a Raetupaw kha</para>
  <para style="q2">a sarya hae paw nynh thua,</para>
  <para style="q2">thuasalama ryachi hae kha</para>
  <para style="q1">thaw a ccih hae paw tuh</para>
  <para style="q2">a Raetupaw kha</para>
  <para style="q2">saw a tua hae paw nynh thua.</para>
  <para style="q1">
    <verse number="32" style="v" />Ccungccaw hoyleipaw tuh</para>
  <para style="q2">ahoy leipaw cyisahnaw keiccuze</para>
  <para style="q2">a khuliakuh,</para>
  <para style="q1">thuasalama miding tuh</para>
  <para style="q2">chinaw kya heize khynnaw a hoi.</para>
  <para style="q1">
    <verse number="33" style="v" />Hawnaw tuh hawnaw</para>
  <para style="q2">a hoi hae paw tuanaw kyakhe a um,</para>
  <para style="q1">thuasalama mingaee hae thinlung kya</para>
  <para style="q2">a umpaw tuh a langkuh.</para>
  <para style="q1">
    <verse number="34" style="v" />Dingnaw nynh minphuin kha</para>
  <para style="q2">a hangthung,</para>
  <para style="q1">thuasalama seinaw tuh</para>
  <para style="q2">minphuin miakaw elang</para>
  <para style="q2">minthunaw nynh thua.</para>
  <para style="q1">
    <verse number="35" style="v" />Hawrarih lante</para>
  <para style="q2">ryalahpaw ryalahtu tuh</para>
  <para style="q1">siapharan kya maehoynaw a mue,</para>
  <para style="q2">thuasalama maethyanaw</para>
  <para style="q1">a thuakhaepaw ryalahtu tungvaw khe</para>
  <para style="q2">siapharan tuh a thinria.</para>
  <chapter number="15" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Byanepaw nynh thinrianaw kha a daesah,</para>
  <para style="q2">thuasalama bya repaw nynh tuh</para>
  <para style="q2">thinrianaw kha a thuakhae.</para>
  <para style="q1">
    <verse number="2" style="v" />Mihawpaw lae nynh</para>
  <para style="q2">ahoypaw nynaw kha a kosah,</para>
  <para style="q1">thuasalama mingaeepaw khalang nynh tuh</para>
  <para style="q2">ngaeenaw bya kha a ho.</para>
  <para style="q1">
    <verse number="3" style="v" />
    <char style="nd">Bawipaw </char> mit tuh</para>
  <para style="q2">hmin takyh kya um zah,</para>
  <para style="q1">ahoypaw te ahoy leipaw</para>
  <para style="q2">ccungccaw hae kha tyty a do hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Byanepaw tuh</para>
  <para style="q2">hiinnaw thingku nynh thua,</para>
  <para style="q1">thuasalama byarepaw nynh tuh</para>
  <para style="q2">thinlung a ccisah.</para>
  <para style="q1">
    <verse number="5" style="v" />Mingaee nynh tuh</para>
  <para style="q2">nungpaaw thuiheinaw kha</para>
  <para style="q1">pawlangria khyh,</para>
  <para style="q2">thuasalama thuiheinaw</para>
  <para style="q1">a ngaepaw tuh</para>
  <para style="q2">a hawpaw nynh thua.</para>
  <para style="q1">
    <verse number="6" style="v" />Miding inn kya tuh</para>
  <para style="q2">sisua patae a um,</para>
  <para style="q1">thuasalama ccungccaw hoyleipaw nynh</para>
  <para style="q2">a muepaw sisua tuh</para>
  <para style="q2">vawsawnaw nynh phe a zosah.</para>
  <para style="q1">
    <verse number="7" style="v" />Mihawpaw munglae nynh</para>
  <para style="q2">nynaw kha a pazaesahku;</para>
  <para style="q1">mingaee hae thinlung tuh</para>
  <para style="q2">tuhcite thua khyh.</para>
  <para style="q1">
    <verse number="8" style="v" />Ccungccaw hoylei hae paw</para>
  <para style="q2">silawnaw tuh <char style="nd">Bawipaw </char> hanlan</para>
  <para style="q1">anungsikuh.</para>
  <para style="q2">Thuasalama miding hae</para>
  <para style="q2">sawsangnaw kha tuh a lungrythua.</para>
  <para style="q1">
    <verse number="9" style="v" />Ccungccaw hoyleipaw laanpi tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> hanlan anungsikuh,</para>
  <para style="q1">thuasalama dingnaw laanpi</para>
  <para style="q2">a zui hae paw kha tuh</para>
  <para style="q2">a sungsah hae.</para>
  <para style="q1">
    <verse number="10" style="v" />Laanpi a meseipaw hanlan</para>
  <para style="q2">accihpaw thuiheinaw a um,</para>
  <para style="q1">thuasalama thuiheinaw kha</para>
  <para style="q2">a huapaw tuh a chih cih.</para>
  <para style="q1">
    <verse number="11" style="v" />Sheol te Abaddon ram tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> malang</para>
  <para style="q1">ccaerarih lan a lang hae,</para>
  <para style="q2">tuh-e hae laeze</para>
  <para style="q1">ccungccaw thinlung tuh</para>
  <para style="q2">alangkuh hua.</para>
  <para style="q1">
    <verse number="12" style="v" />Ccungccaw a saryapaw tuh</para>
  <para style="q2">thuiheiku ry khyh;</para>
  <para style="q2">mihaw hae kalan cceih boi khyh.</para>
  <para style="q1">
    <verse number="13" style="v" />A lungtuapaw thinlung nynh</para>
  <para style="q2">lungtuanaw mitmae kha a langsaku,</para>
  <para style="q1">thuasalama ngaethyanaw</para>
  <para style="q2">thinlung keiccuze lung aroh.</para>
  <para style="q1">
    <verse number="14" style="v" />Mihawpaw thinlung nynh tuh</para>
  <para style="q2">hawnaw kha a ccung,</para>
  <para style="q1">thuasalama mingaee hae</para>
  <para style="q2">khalang nynh tuh</para>
  <para style="q2">ngaeenaw kha nynh a dangku hae.</para>
  <para style="q1">
    <verse number="15" style="v" />Ryachi hae ninsaw balyn tuh</para>
  <para style="q2">arupaw nynh thua,</para>
  <para style="q1">thuasalama alungtuapaw thinlung tuh</para>
  <para style="q2">zungzae tuapaw poi nynh thua.</para>
  <para style="q1">
    <verse number="16" style="v" />
    <char style="nd">Bawipaw </char> rawrite</para>
  <para style="q2">beihtaraw hoi tuh</para>
  <para style="q1">sisua pataepi hoite thinphangte</para>
  <para style="q2">um laeze ahoyhua.</para>
  <para style="q1">
    <verse number="17" style="v" />Sungsahkunaw a umnaw kya</para>
  <para style="q2">enaw-eho te zerya aepaw tuh</para>
  <para style="q1">huakunaw a umnaw kya</para>
  <para style="q2">athopaw vaetua saw te</para>
  <para style="q2">aepaw laeze ahoyhua.</para>
  <para style="q1">
    <verse number="18" style="v" />A thindynpaw nynh</para>
  <para style="q2">pekunaw kha a puisah,</para>
  <para style="q1">thuasalama a lungsaepaw nynh tuh</para>
  <para style="q2">pekunaw kha a daesah.</para>
  <para style="q1">
    <verse number="19" style="v" />Thawnawpaw laanpi tuh</para>
  <para style="q2">hinpaw nynh pong a zithin,</para>
  <para style="q1">thuasalama miding laanpi tuh</para>
  <para style="q2">laanluepi nynh thua.</para>
  <para style="q1">
    <verse number="20" style="v" />Ahawpaw ccaaw nynh</para>
  <para style="q2">a paaw lung a tuasah,</para>
  <para style="q1">thuasalama angaeepaw ccaaw nynh tuh</para>
  <para style="q2">a nung kha a theihrya.</para>
  <para style="q1">
    <verse number="21" style="v" />Tuanaw a hoi leipaw hanlan</para>
  <para style="q2">ngaeenaw tuh lungtuanaw nynh thua,</para>
  <para style="q1">thuasalama mihawpaw nynh tuh</para>
  <para style="q2">ahmepaw kha a cyi.</para>
  <para style="q1">
    <verse number="22" style="v" />Tuanaw pyakunaw a um leite tuh,</para>
  <para style="q2">paccynkunaw aroh,</para>
  <para style="q1">thuasalama tuanaw pyatu</para>
  <para style="q2">alung zetuh paccynkunaw atyn.</para>
  <para style="q1">
    <verse number="23" style="v" />Ccungccaw tuh</para>
  <para style="q2">bya khungkupaw liate a lungtua,</para>
  <para style="q1">ccyh dosete hopaw bya tuh</para>
  <para style="q2">pawcih baban ahoy!</para>
  <para style="q1">
    <verse number="24" style="v" />Mihawpaw nynh</para>
  <para style="q2">a zuipaw hiinnaw laanpi tuh</para>
  <para style="q1">akaw lang e michi khua kha</para>
  <para style="q2">sibia khylan</para>
  <para style="q2">ahangnaw langkhe nynh a ccia.</para>
  <para style="q1">
    <verse number="25" style="v" />
    <char style="nd">Bawipaw </char> nynh alysakuhpaw kya-e</para>
  <para style="q2">inn kha a phoupya,</para>
  <para style="q1">thuasalama nomaenung</para>
  <para style="q2">umnaw kha tuh a tynsah.</para>
  <para style="q1">
    <verse number="26" style="v" />Ccungccaw hoyleipaw kya-e</para>
  <para style="q2">tuanaw tuh <char style="nd">Bawipaw </char> elang</para>
  <para style="q1">anungsikuhpaw nynh thua,</para>
  <para style="q2">thuasalama athyaapaw</para>
  <para style="q2">ccungccaw bya kha tuh a lungrythua.</para>
  <para style="q1">
    <verse number="27" style="v" />Ahme leipaw muenaw elang</para>
  <para style="q2">a karankuhpaw tuh a innbyn hanlan</para>
  <para style="q1">vawsawnaw a thuakhae,</para>
  <para style="q2">thuasalama pyaruh kha</para>
  <para style="q2">a huapaw tuh a hiinshe sae cih.</para>
  <para style="q1">
    <verse number="28" style="v" />Miding nynh tuh</para>
  <para style="q2">pawtemou horu lan cipaw kha</para>
  <para style="q1">a thinlung kya a tua,</para>
  <para style="q2">thuasalama ccungccaw</para>
  <para style="q1">hoyleipaw khalang nynh tuh</para>
  <para style="q2">bya hoyleipaw kha ruarua a ho.</para>
  <para style="q1">
    <verse number="29" style="v" />
    <char style="nd">Bawipaw </char> tuh</para>
  <para style="q2">ccungccaw hoyleipaw kyate</para>
  <para style="q1">asawkuh,</para>
  <para style="q2">thuasalama miding hae</para>
  <para style="q2">sawsangnaw kha a ngaepya hae.</para>
  <para style="q1">
    <verse number="30" style="v" />Mit awnaw nynh</para>
  <para style="q2">ccungccaw lungtuasah zah,</para>
  <para style="q1">thehoypaw nynh ru kha</para>
  <para style="q2">kintui te a biasah.</para>
  <para style="q1">
    <verse number="31" style="v" />Ahoypaw thuiheinaw kha</para>
  <para style="q2">hoyte a ngaepaw tuh</para>
  <para style="q2">mihaw hae laku a umbua cih.</para>
  <para style="q1">
    <verse number="32" style="v" />Thuiheinaw a ngae ry leipaw tuh</para>
  <para style="q2">amaw toulou kha</para>
  <para style="q1">pawlang a riakuh leipaw nynh thua,</para>
  <para style="q2">thuasalama thuiheinaw</para>
  <para style="q2">a ngaepaw tuh hawnaw a mue.</para>
  <para style="q1">
    <verse number="33" style="v" />
    <char style="nd">Bawipaw </char> rawrinaw tuh</para>
  <para style="q2">hawnaw te thuiheikupaw nynh thua,</para>
  <para style="q1">sawtuanaw a um mawze</para>
  <para style="q2">zakawsangsakunaw a umty.</para>
  <para style="b" />
  <chapter number="16" style="c" />
  <para style="nb">
    <verse number="1" style="v" />Ccungccaw nynh a thinlung kya</para>
  <para style="q2">khuakhankunaw kha a hoi,</para>
  <para style="q1">thuasalama lae nynh a hopaw tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kyate nynh thua.</para>
  <para style="q1">
    <verse number="2" style="v" />Ccungccaw nynh tuh</para>
  <para style="q2">a cyipaw balyn kha</para>
  <para style="q2">ahoy cite a muih,</para>
  <para style="q1">thuasalama <char style="nd">Bawipaw </char> nynh tuh</para>
  <para style="q2">thinlung kha a do.</para>
  <para style="q1">
    <verse number="3" style="v" />Na ryalaw kha</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kalan ap lah,</para>
  <para style="q2">na paccynkunaw hae tuh atyn cih hae.</para>
  <para style="q1">
    <verse number="4" style="v" />
    <char style="nd">Bawipaw </char> nynh atyn-are kha</para>
  <para style="q2">mimaw eenaw raveih hanlan a rae,</para>
  <para style="q1">ccungccaw hoylei hae paw heize</para>
  <para style="q2">vawsawnaw nin hanlan a rae hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Alysakuhpaw balyn tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> hanlan</para>
  <para style="q1">anungsikuh hae paw nynh thua;</para>
  <para style="q2">minmin tuh detahnaw</para>
  <para style="q2">mue leite um lan khyh hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Lungzinaw te zyn lan umnaw liate</para>
  <para style="q2">seinaw kha ngaethya athua,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> rawrinaw liate</para>
  <para style="q2">ccungccaw nynh hoyleinaw kha a sibia.</para>
  <para style="q1">
    <verse number="7" style="v" />Ccungccaw cyisahnaw nynh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha a lungry he thuasah te,</para>
  <para style="q1">a rhaw hae khate heize</para>
  <para style="q2">a ccawsaku hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Dingnaw te muepaw</para>
  <para style="q2">uccaw beihtaraw tuh</para>
  <para style="q1">dingleinaw te muepaw</para>
  <para style="q2">uccaw patae laeze ahoyhua.</para>
  <para style="q1">
    <verse number="9" style="v" />Ccungccaw nynh tuh</para>
  <para style="q2">a ccianaw lanpaw laanpi kha</para>
  <para style="q1">a thinlung kya khua a khanku,</para>
  <para style="q2">thuasalama laandy a hoeitu tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh thua.</para>
  <para style="q1">
    <verse number="10" style="v" />Pachia hopaw byapaenaw tuh</para>
  <para style="q2">siapharan munglae kya a um,</para>
  <para style="q1">bya a pianaw kya</para>
  <para style="q2">a khalang tuh sei khyh.</para>
  <para style="q1">
    <verse number="11" style="v" />Ahmepaw khinlung te zawccu tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kya-e nynh thua,</para>
  <para style="q1">zaw lungkhu umpaw</para>
  <para style="q2">khinlung balyn tuh</para>
  <para style="q2">amaw nynh a raepaw nynh thua.</para>
  <para style="q1">
    <verse number="12" style="v" />Hoyleinaw rae hynh</para>
  <para style="q2">siapharan hae elang</para>
  <para style="q1">anungsikuhpaw nynh thua,</para>
  <para style="q2">pawccecize bawi haungnaw tuh</para>
  <para style="q2">dingnaw liate tynsah athua.</para>
  <para style="q1">
    <verse number="13" style="v" />Adingpaw mung tuh</para>
  <para style="q2">siapharan nynh a rypaw thua zah,</para>
  <para style="q1">hmerarih lan a ho hae paw kha</para>
  <para style="q2">a sungsah hae.</para>
  <para style="q1">
    <verse number="14" style="v" />Siapharan thinrianaw tuh</para>
  <para style="q2">chinaw a zeccuetu nynh thua,</para>
  <para style="q1">te mihaw hae miakaw nynh tuh</para>
  <para style="q2">siapharan lung kha a hoysah hae.</para>
  <para style="q1">
    <verse number="15" style="v" />Siapharan maesue hoynaw kya</para>
  <para style="q2">hiinnaw a um, a thawccinaw tuh</para>
  <para style="q1">hawkhuaa a rawsahpaw</para>
  <para style="q2">maeking te nynh aloku.</para>
  <para style="q1">
    <verse number="16" style="v" />Hawnaw muepaw tuh</para>
  <para style="q2">sui muepaw laeze ahoyhua,</para>
  <para style="q1">nythyanaw muepaw tuh</para>
  <para style="q2">ngunphua muepaw laeze</para>
  <para style="q2">poku lanpaw nynh thua.</para>
  <para style="q1">
    <verse number="17" style="v" />Miding nynh a zuipaw</para>
  <para style="q2">laanpi tuh hoyleinaw kha a sibia;</para>
  <para style="q1">a laanpi kha hoyte a dokuhpaw tuh</para>
  <para style="q2">a hiinnaw kha a khynsaku.</para>
  <para style="q1">
    <verse number="18" style="v" />Lysakunaw tuh</para>
  <para style="q2">ronaw laeze laan a mawty,</para>
  <para style="q1">hangsahkunaw tuh</para>
  <para style="q2">ccawbungnaw laeze laan a mawty.</para>
  <para style="q1">
    <verse number="19" style="v" />Ryachi hae laku kya</para>
  <para style="q2">zakawsangsakute umpaw tuh</para>
  <para style="q1">a lysakuh hae paw ryte</para>
  <para style="q2">mungkute luadepaw uccaw</para>
  <para style="q2">neekupaw laeze ahoyhua.</para>
  <para style="q1">
    <verse number="20" style="v" />Ccangpyanaw kha hoyte</para>
  <para style="q2">a ngaepaw tuh hoynaw</para>
  <para style="q2">a mue cih,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> a doliakuh hae paw tuh</para>
  <para style="q2">lungtua hae paw nynh thua.</para>
  <para style="q1">
    <verse number="21" style="v" />Ahawpaw thinlung tuh</para>
  <para style="q2">uccaw a laesah thyapaw nynh thua,</para>
  <para style="q1">a-epaw bya nynh</para>
  <para style="q2">ccungccaw a soih kho.</para>
  <para style="q1">
    <verse number="22" style="v" />Hawnaw a hoipaw hanlan</para>
  <para style="q2">hawnaw tuh hiinnaw tuidy nynh thua,</para>
  <para style="q1">thuasalama mingaee hae kha</para>
  <para style="q2">mih ngaeenaw nynh de a tah hae.</para>
  <para style="q1">
    <verse number="23" style="v" />Mihawpaw thinlung nynh tuh</para>
  <para style="q2">a munglae kha thuihei zah</para>
  <para style="q1">a hopaw bya tuh</para>
  <para style="q2">soih khonaw houh a hoi.</para>
  <para style="q1">
    <verse number="24" style="v" />A-epaw bya tuh</para>
  <para style="q2">khoilutui te nynh aloku,</para>
  <para style="q1">muisaw hanlan e zah</para>
  <para style="q2">pyn hanlan dannaw nynh thua.</para>
  <para style="q1">
    <verse number="25" style="v" />Ccungccaw nynh ahmepaw</para>
  <para style="q2">laanpi cite tuapaw kha,</para>
  <para style="q1">athangnaw tuh chinaw lang</para>
  <para style="q2">a cceihpaw laanpi nynh thua.<note caller="-" style="x"><char style="xo" closed="false">16.25: </char><char style="xt" closed="false"><ref loc="PRO 14:12">Ptb 14.12</ref></char></note></para>
  <para style="q1">
    <verse number="26" style="v" />A vuelawpaw ryalahtu nynh</para>
  <para style="q2">amaw hanlan rya a lawku;</para>
  <para style="q1">a vuelawnaw nynh</para>
  <para style="q2">amaw hanlan ryalaw lan a tuhou.</para>
  <para style="q1">
    <verse number="27" style="v" />Ccungkia leipaw nynh tuh</para>
  <para style="q2">hoyleinaw kha aruh lante</para>
  <para style="q1">paccynkuh zah,</para>
  <para style="q2">a hopaw bya tuh</para>
  <para style="q2">aruapaw maee te nynh aloku.</para>
  <para style="q1">
    <verse number="28" style="v" />Thethya a hopaw nynh</para>
  <para style="q2">pekunaw kha pazaesakuh zah,</para>
  <para style="q1">lawtypaw bya a hopaw nynh</para>
  <para style="q2">ruiban hoy hae paw kha a phia hae.</para>
  <para style="q1">
    <verse number="29" style="v" />Apuathopaw ccungccaw nynh</para>
  <para style="q2">a innpaw hae kha soih hae zah,</para>
  <para style="q1">laanpi ahoy leipaw kalan</para>
  <para style="q2">a cciakhae hae.</para>
  <para style="q1">
    <verse number="30" style="v" />Mit a masipahpaw</para>
  <para style="q2">ccungccaw tuh hoyleinaw</para>
  <para style="q1">a paccynpaw nynh thua,</para>
  <para style="q2">a mung a supahpaw</para>
  <para style="q2">ccungccaw mah hoyleinaw</para>
  <para style="q2">a thuakhaepaw nynh thua.</para>
  <para style="q1">
    <verse number="31" style="v" />Sang apawpaw tuh</para>
  <para style="q2">phu-enaw bawilukhung nynh thua;</para>
  <para style="q1">adingpaw hiinnaw nynh</para>
  <para style="q2">tuh-e tuh a mue.</para>
  <para style="q1">
    <verse number="32" style="v" />A lungsaepaw tuh</para>
  <para style="q2">a thawsaepaw laeze ahoyhua,</para>
  <para style="q1">thindynnaw a synkuh khopaw tuh</para>
  <para style="q2">khuapi a taetupaw laeze ahoyhua.</para>
  <para style="q1">
    <verse number="33" style="v" />Ccungthydungnaw kha</para>
  <para style="q2">mih angkizaw lungkhu khe a rae hae,</para>
  <para style="q1">thuasalama byapaenaw tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kya-e nynh thua.</para>
  <chapter number="17" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Inn phe beihpaw</para>
  <para style="q2">poi tuanawpaw kha</para>
  <para style="q1">pekute ae laeze daebabi lante</para>
  <para style="q2">buhdangpaw lung kheit</para>
  <para style="q2">ae tuh ahoyhua.</para>
  <para style="q1">
    <verse number="2" style="v" />Ahawpaw see nynh</para>
  <para style="q2">maethyanaw a thuakhaepaw</para>
  <para style="q1">ccaaw kha a uk cih zah,</para>
  <para style="q2">uno lu kheit hawte</para>
  <para style="q2">rho a ccoubua cih.</para>
  <para style="q1">
    <verse number="3" style="v" />Sui te ngun tuh maee te</para>
  <para style="q2">syntawtua athua,</para>
  <para style="q1">thuasalama thinlung tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh a syntawtua.</para>
  <para style="q1">
    <verse number="4" style="v" />Hoyleinaw a raepaw nynh</para>
  <para style="q2">hoyleinaw bya kha a ngae;</para>
  <para style="q2">a hynpaw nynh hynbya kha a ngae.</para>
  <para style="q1">
    <verse number="5" style="v" />A ryachipaw kha a theihryapaw tuh</para>
  <para style="q2">a Raetupaw kha</para>
  <para style="q1">a saryapaw nynh thua, milae nynh</para>
  <para style="q2">vawsawnaw a tung ze,</para>
  <para style="q1">a lungtuapaw tuh detahnaw</para>
  <para style="q2">ing leite um lan khyh.</para>
  <para style="q1">
    <verse number="6" style="v" />Mintaw hae tuh</para>
  <para style="q2">ataw hae paw kya-e</para>
  <para style="q1">bawilukhung nynh athua hae,</para>
  <para style="q2">ccaaw hae phu-enaw tuh</para>
  <para style="q2">mih nung mih paaw hae kha nynh thua.</para>
  <para style="q1">
    <verse number="7" style="v" />Bya hoypaw tuh</para>
  <para style="q2">mingaee te ngaekuh khyh,</para>
  <para style="q1">hynpaw bya tuh uktu te</para>
  <para style="q2">ngaekuh ccaccing khyh.</para>
  <para style="q1">
    <verse number="8" style="v" />Pyaruh tuh a pyatupaw</para>
  <para style="q2">mitmuihnaw kya</para>
  <para style="q1">mitleih lung te nynh aloku,</para>
  <para style="q2">mih mae a hawinaw lang hae</para>
  <para style="q2">miakaw kya mih laan mih sui a ua.</para>
  <para style="q1">
    <verse number="9" style="v" />Milae cyiseinaw kha</para>
  <para style="q2">a khawsungpaw tuh</para>
  <para style="q1">sungsakunaw kha a tynsah,</para>
  <para style="q2">thuasalama milae thethya a hopaw tuh</para>
  <para style="q2">ruiban te phiakunaw kha a rae.</para>
  <para style="q1">
    <verse number="10" style="v" />Mingaeepaw kha</para>
  <para style="q2">vae za kheit buapaw laeze,</para>
  <para style="q1">mihawpaw kha vae kheit</para>
  <para style="q2">thuiheipaw tuh a thanehua.</para>
  <para style="q1">
    <verse number="11" style="v" />Ccungccaw hoyleipaw nynh</para>
  <para style="q2">rhawthonaw kyalya kha a ccung,</para>
  <para style="q1">a rysawthahpaw zeccuetu kha</para>
  <para style="q2">minmin kalan sawnua athua cih.</para>
  <para style="q1">
    <verse number="12" style="v" />Mingaeepaw a ngaee lyate</para>
  <para style="q2">tungku laeze,</para>
  <para style="q1">a taw zopaw vong te</para>
  <para style="q2">tungkupaw tuh ahoyhua.</para>
  <para style="q1">
    <verse number="13" style="v" />Ahoypaw kha athahpaw te</para>
  <para style="q2">a liarupaw ccungccaw tuh</para>
  <para style="q1">a inn kyate hoyleinaw</para>
  <para style="q2">phiakuh boi lan khyh.</para>
  <para style="q1">
    <verse number="14" style="v" />Pekunaw athotakawnaw tuh</para>
  <para style="q2">tui tungnawpaw avihpaw te nynh aloku;</para>
  <para style="q1">tukeiccuze pekunaw</para>
  <para style="q2">a um mawkhe zya umtaw.</para>
  <para style="q1">
    <verse number="15" style="v" />Ccungccaw hoyleipaw kha</para>
  <para style="q2">daangsahpaw te</para>
  <para style="q1">midingpaw kha seisahpaw tuh</para>
  <para style="q2">parouh mawte <char style="nd">Bawipaw </char> hanlan</para>
  <para style="q2">anungsikuhpaw nynh thua.</para>
  <para style="q1">
    <verse number="16" style="v" />Mingaee tuh hawnaw kha</para>
  <para style="q2">ccangku a ry leipaw thua zah,</para>
  <para style="q1">hawnaw renaw lanpaw amee kha</para>
  <para style="q2">a kuih kya pawccemou a mue cih?</para>
  <para style="q1">
    <verse number="17" style="v" />Ruiban nynh tuh</para>
  <para style="q2">sungsakunaw kha</para>
  <para style="q1">zungzae a langsaku,</para>
  <para style="q2">u te neitaw tuh vawsawnaw kha</para>
  <para style="q2">neethungku lan nynh apuiku.</para>
  <para style="q1">
    <verse number="18" style="v" />A innpaw hanlan aamahkhanpyakute</para>
  <para style="q2">bya a kinpakuhpaw tuh</para>
  <para style="q2">mingaee nynh thua.</para>
  <para style="q1">
    <verse number="19" style="v" />Cyiseinaw kha a sungsahpaw tuh</para>
  <para style="q2">pekunaw a sungsahpaw nynh thua,</para>
  <para style="q2">a thuakaw kha</para>
  <para style="q1">a hangsah thungpaw tuh</para>
  <para style="q2">ronaw a ccungpaw nynh thua.</para>
  <para style="q1">
    <verse number="20" style="v" />Thinlung akoupaw tuh</para>
  <para style="q2">hoynaw mue khyh,</para>
  <para style="q1">Ahynpaw ccungccaw tuh</para>
  <para style="q2">vawsawnaw lungkhu lang a ccah.</para>
  <para style="q1">
    <verse number="21" style="v" />Ccaaw angaeepaw</para>
  <para style="q2">a saahkuhpaw tuh</para>
  <para style="q1">vawsawnaw a tung;</para>
  <para style="q2">mingaeepaw a nung a paaw hae tuh</para>
  <para style="q2">lungpawnaw hoi khyh hae.</para>
  <para style="q1">
    <verse number="22" style="v" />Alungtuapaw thinlung tuh</para>
  <para style="q2">isei hoypaw nynh thua,</para>
  <para style="q1">thuasalama lungronaw nynh</para>
  <para style="q2">ru kha a rousah.</para>
  <para style="q1">
    <verse number="23" style="v" />Ccungccaw hoyleipaw nynh</para>
  <para style="q2">byading laanpi kha ro khylan</para>
  <para style="q2">pyaruh kha a lawku.</para>
  <para style="q1">
    <verse number="24" style="v" />Mihawpaw nynh tuh</para>
  <para style="q2">hawnaw kalan khe nynh a do,</para>
  <para style="q1">thuasalama mingaeepaw mit tuh</para>
  <para style="q2">laephi athangnaw langkhe nynh a do.</para>
  <para style="q1">
    <verse number="25" style="v" />Angaeepaw ccaaw hae tuh</para>
  <para style="q2">mih paaw hanlan</para>
  <para style="q1">ngaethyanaw thua zah,</para>
  <para style="q2">a saahtu hae paw mih nung elang</para>
  <para style="q2">lungriathaenaw nynh thua.</para>
  <para style="q1">
    <verse number="26" style="v" />Seinaw a hoi leipaw kha</para>
  <para style="q2">detah tuh hoy khyh;</para>
  <para style="q1">ccungccaw hoypaw kha</para>
  <para style="q2">a dingnaw tungvaw kya</para>
  <para style="q2">ziapaw tuh hoy khyh.</para>
  <para style="q1">
    <verse number="27" style="v" />Nythyanaw a hoipaw tuh</para>
  <para style="q2">byaho a synkuh,</para>
  <para style="q1">daebabi lan a umpaw tuh</para>
  <para style="q2">nythyanaw a hoipaw nynh thua.</para>
  <para style="q1">
    <verse number="28" style="v" />Mingaeepaw nynh heize</para>
  <para style="q2">yccae leite a um zetuh,</para>
  <para style="q1">mihawpaw lang a ria hae;</para>
  <para style="q2">a mung a myhpaw kha mah</para>
  <para style="q1">mihawpaw langte a tua hae.</para>
  <chapter number="18" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Milae te a mungkuh leipaw tuh</para>
  <para style="q2">amaw rynaw kyalya te</para>
  <para style="q2">a um rypaw nynh thua,</para>
  <para style="q1">ahoypaw hawnaw miakaw kha</para>
  <para style="q2">a nawccah khyh.</para>
  <para style="q1">
    <verse number="2" style="v" />Mingaee nynh tuh</para>
  <para style="q2">amaw tuanaw kyalya kha</para>
  <para style="q1">langsakuh zah, nythyanaw kyakhe</para>
  <para style="q2">a lungrythua khyh.</para>
  <para style="q1">
    <verse number="3" style="v" />Hoyleinaw he yn thua vae ze,</para>
  <para style="q2">dothatheihnaw mah athuabua;</para>
  <para style="q1">maethyanaw te thethyanaw tuh</para>
  <para style="q2">a thuakheih hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Ccungccaw khalang kya-e</para>
  <para style="q2">bya tuh akhupaw tui hawte thua zah,</para>
  <para style="q1">hawnaw tuidy tuh</para>
  <para style="q2">aluapaw vaw hawte nynh thua.</para>
  <para style="q1">
    <verse number="5" style="v" />Aseipaw ccungccaw kha</para>
  <para style="q2">maedopaw te byapianaw kyaze</para>
  <para style="q1">seinaw a hoi leipaw kha</para>
  <para style="q2">shungsahpaw tuh hme khyh.</para>
  <para style="q1">
    <verse number="6" style="v" />Mingaeepaw munglae nynh</para>
  <para style="q2">pekunaw a thuakhae,</para>
  <para style="q1">a munglae nynh</para>
  <para style="q2">ccungbua kha a ngiaku.</para>
  <para style="q1">
    <verse number="7" style="v" />Mingaeepaw khalang tuh</para>
  <para style="q2">amaw ronaw thua zah,</para>
  <para style="q1">a mung tuh amaw elang</para>
  <para style="q2">kaang nynh thua.</para>
  <para style="q1">
    <verse number="8" style="v" />Ccungccaw lawtypaw byaho tuh</para>
  <para style="q2">aepaw athuapaw te lokuh zah,</para>
  <para style="q2">pyn lungkhu lang po a tee.</para>
  <para style="q1">
    <verse number="9" style="v" />Ryalawnaw kya</para>
  <para style="q2">a thawnawpaw tuh amaw uccaw kha</para>
  <para style="q1">alakaw lan a rosahpaw ccungccaw te</para>
  <para style="q2">uno nynh athua hae.</para>
  <para style="q1">
    <verse number="10" style="v" />
    <char style="nd">Bawipaw </char> min tuh</para>
  <para style="q2">tynkarangpaw rhawviainn nynh thua;</para>
  <para style="q1">miding hae nynh tuh-e inn lungkhu lang</para>
  <para style="q2">ccue hae zah a khyn hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Mihoipaw nynh tuh a hoirumnaw kha</para>
  <para style="q2">atynpaw khuapi thua zah,</para>
  <para style="q1">ahangpaw khua hohung te nynh</para>
  <para style="q2">aloku cite a tua.</para>
  <para style="q1">
    <verse number="12" style="v" />Thinlung hangsahkunaw tuh</para>
  <para style="q2">ronaw laeze laan a mawty,</para>
  <para style="q1">zakawsangsakunaw tuh</para>
  <para style="q2">sawtuanaw laeze laan a mawty.</para>
  <para style="q1">
    <verse number="13" style="v" />Bya hoyte a thae mawze,</para>
  <para style="q2">bya a khungpaw ccungccaw tuh</para>
  <para style="q1">a ngaeepaw te maethya</para>
  <para style="q2">a lawkuhpaw nynh thua.</para>
  <para style="q1">
    <verse number="14" style="v" />Ccungccaw thinlung nynh</para>
  <para style="q2">ccinaw a e-ia kho;</para>
  <para style="q1">thuasalama lungronaw kha</para>
  <para style="q2">hummou a teing kho cih?</para>
  <para style="q1">
    <verse number="15" style="v" />Ahawpaw thinlung nynh tuh</para>
  <para style="q2">nynaw kha ccakhungkuh zah,</para>
  <para style="q1">mihawpaw nakaring nynh mah</para>
  <para style="q2">nynaw kha a ccung.</para>
  <para style="q1">
    <verse number="16" style="v" />Lasung nynh a pyatupaw elang</para>
  <para style="q2">laanpi kha a hungpya;</para>
  <para style="q1">alesaepaw ccungccaw kalan</para>
  <para style="q2">a thuakhae.</para>
  <para style="q1">
    <verse number="17" style="v" />Byapiazung kya bya a hotypaw tuh</para>
  <para style="q2">ahmepaw lo salamah,</para>
  <para style="q1">a innpaw paw nynh yn thua zah</para>
  <para style="q2">amaw kha bya a khialiathya.</para>
  <para style="q1">
    <verse number="18" style="v" />Ccungthydungnaw nynh</para>
  <para style="q2">eikunaw kha daesah zah,</para>
  <para style="q1">huhan hoi hae paw bya kha</para>
  <para style="q2">a paepya hae.</para>
  <para style="q1">
    <verse number="19" style="v" />U te neitaw bawmkupaw tuh</para>
  <para style="q2">atynpaw khuapi hawte nynh thua,</para>
  <para style="q1">thuasalama u te neitaw</para>
  <para style="q2">pekupaw tuh rhawhohung</para>
  <para style="q2">sakoihccaw te nynh aloku.</para>
  <para style="q1">
    <verse number="20" style="v" />Ccungccaw tuh khalang kyate</para>
  <para style="q2">apoupaw athae khate vue asokuh;</para>
  <para style="q1">munglae kyate apoupaw kha nynh</para>
  <para style="q2">vuesonaw kha a thuakhae.</para>
  <para style="q1">
    <verse number="21" style="v" />Lae nynh chinaw te</para>
  <para style="q2">hiinnaw kha a uk hae,</para>
  <para style="q1">lae a sungsahpaw tuh</para>
  <para style="q2">lae athae kha a ae cih.</para>
  <para style="q1">
    <verse number="22" style="v" />Zu a muekuhpaw tuh</para>
  <para style="q2">uccaw hoypaw</para>
  <para style="q1">a muekuhpaw thua zah,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kyate</para>
  <para style="q2">maehoynaw kha a mue.</para>
  <para style="q1">
    <verse number="23" style="v" />Ryachipaw nynh</para>
  <para style="q2">soihbiakunaw kha a mang,</para>
  <para style="q1">thuasalama mihoipaw nynh tuh</para>
  <para style="q2">rehahan lante a khung.</para>
  <para style="q1">
    <verse number="24" style="v" />Ruiban abang tuh</para>
  <para style="q2">ruiban huataw thua hae salamah,</para>
  <para style="q1">ruiban hoypaw tuh</para>
  <para style="q2">u te neitaw sasaw laeze a bekuh hua.</para>
  <chapter number="19" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Dingnaw laanpi</para>
  <para style="q2">a zuipaw ryachipaw tuh</para>
  <para style="q1">ccouseikunaw bya a hopaw</para>
  <para style="q2">mingaeepaw laeze ahoyhua.</para>
  <para style="q1">
    <verse number="2" style="v" />Nynaw um leite rynaw tuh hoy khyh,</para>
  <para style="q2">Rangsakute a cceihpaw tuh</para>
  <para style="q2">a laanpi a vaethya.</para>
  <para style="q1">
    <verse number="3" style="v" />Ccungccaw tuh a ngaeenaw nynh</para>
  <para style="q2">ronaw kalan a cciakhae,</para>
  <para style="q1">tuhzemah a thinlung kyakhe</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> tungvaw a thinria.</para>
  <para style="q1">
    <verse number="4" style="v" />Hoirumnaw nynh</para>
  <para style="q2">ruiban patae a thuakhae,</para>
  <para style="q1">thuasalama a ryachipaw tuh</para>
  <para style="q2">ruiban hoi khyh.</para>
  <para style="q1">
    <verse number="5" style="v" />Ahme leipaw ccaekia tuh</para>
  <para style="q2">detahnaw mue leite um lan khyh,</para>
  <para style="q2">hynbya a hopaw tuh lue lan khyh.</para>
  <para style="q1">
    <verse number="6" style="v" />Ccungccaw patae nynh</para>
  <para style="q2">a lung-uapaw ccungccaw kya</para>
  <para style="q1">maehoynaw kha a ccungku hae,</para>
  <para style="q2">humhung mah lasung</para>
  <para style="q1">a pyatupaw hanlan tuh</para>
  <para style="q2">ruiban nynh thua.</para>
  <para style="q1">
    <verse number="7" style="v" />A ryachipaw kha</para>
  <para style="q2">a uno hae nynh heize</para>
  <para style="q1">a hua hae ze, a ruiban hae nynh thytuh</para>
  <para style="q2">hohcihmou houh a sibia vae cih hae!</para>
  <para style="q1">A kohui hae zemah tuh-e hae tuh,</para>
  <para style="q2">tuin kya um vae khyh hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Hawnaw a muepaw tuh</para>
  <para style="q2">amaw te amaw a sungsakuhpaw nynh thua,</para>
  <para style="q1">nythyanaw a ccykekuhpaw tuh</para>
  <para style="q2">hoynaw a mue.</para>
  <para style="q1">
    <verse number="9" style="v" />Ahme leipaw ccaekia tuh</para>
  <para style="q2">detahnaw ing leite um lan khyh,</para>
  <para style="q2">a hynpaw tuh a roh cih.</para>
  <para style="q1">
    <verse number="10" style="v" />Mingaee tuh hiinhoyte</para>
  <para style="q2">um lan ngaekuh khyh,</para>
  <para style="q1">see nynh a bawipaw ukpaw tuh</para>
  <para style="q2">houh ngaekuh vae khyh.</para>
  <para style="q1">
    <verse number="11" style="v" />Mihaw hae tuh mih lungsae zah,</para>
  <para style="q2">milae seinaw kha ccuinpya leinaw tuh</para>
  <para style="q2">mih phu-enaw nynh thua.</para>
  <para style="q1">
    <verse number="12" style="v" />Siapharan thinrianaw tuh</para>
  <para style="q2">chindeih nynh a siapaw te nynh aloku,</para>
  <para style="q1">thuasalama a thawccinaw tuh</para>
  <para style="q2">lonua vawlan e dangtui te nynh aloku.</para>
  <para style="q1">
    <verse number="13" style="v" />Angaeepaw ccaaw tuh</para>
  <para style="q2">a paaw hanlan ronaw nynh thua,</para>
  <para style="q1">Peku a mangpaw zu tuh</para>
  <para style="q2">boubou accawpaw</para>
  <para style="q2">khuaaratui te nynh aloku.</para>
  <para style="q1">
    <verse number="14" style="v" />Inn te hoirumnaw tuh</para>
  <para style="q2">nungpaaw rho nynh thua,</para>
  <para style="q1">thuasalama ahawpaw zu tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kyate muepaw nynh thua.</para>
  <para style="q1">
    <verse number="15" style="v" />Thawnawnaw nynh</para>
  <para style="q2">ithuhnaw kha a thuakhae,</para>
  <para style="q2">a thawnawpaw tuh a vuelaw cih.</para>
  <para style="q1">
    <verse number="16" style="v" />Kawbya a zuipaw tuh a hiin cih;</para>
  <para style="q2">a zuipaw laanpi kha</para>
  <para style="q2">pawlangria leipaw tuh a chih cih.</para>
  <para style="q1">
    <verse number="17" style="v" />A ryachipaw tungvaw</para>
  <para style="q2">thawccinaw a hoipaw tuh</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha uccaw</para>
  <para style="q2">a koiisakuhpaw thua zah,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh phe ccing lan a sang cih.</para>
  <para style="q1">
    <verse number="18" style="v" />Ngaehoinaw a um lyakhe</para>
  <para style="q2">na ccaaw hae kha thuihei hae;</para>
  <para style="q1">a ro nawlan hae</para>
  <para style="q2">ngaethyaumsah nan hae.</para>
  <para style="q1">
    <verse number="19" style="v" />A thinthah zah</para>
  <para style="q2">a puathopaw ccungccaw tuh</para>
  <para style="q1">detahnaw a ing cih; amaw kha</para>
  <para style="q2">vae kheit na khum ze,</para>
  <para style="q2">tuhte bua na khum cih.</para>
  <para style="q1">
    <verse number="20" style="v" />Malang ccyh kya</para>
  <para style="q2">hawnaw na mue nawlan,</para>
  <para style="q1">tuanaw pyakupaw kha ngae lah,</para>
  <para style="q2">thuiheinaw kha lawkuh.</para>
  <para style="q1">
    <verse number="21" style="v" />Ccungccaw thinlung tuh</para>
  <para style="q2">khuakhankunaw patae a hoi kho,</para>
  <para style="q2">thuasalama <char style="nd">Bawipaw </char> khuakhannaw rou nynh atyn cih.</para>
  <para style="q1">
    <verse number="22" style="v" />Ccungccaw kya ry lanpaw tuh</para>
  <para style="q2">lungzinaw nynh thua,</para>
  <para style="q1">a ryachipaw lang tang tuh</para>
  <para style="q2">a hynpaw lang tang laeze ahoyhua.</para>
  <para style="q1">
    <verse number="23" style="v" />
    <char style="nd">Bawipaw </char> rawrinaw tuh</para>
  <para style="q2">hiinnaw ccaccing nynh thua;</para>
  <para style="q1">tuh-e rawrinaw a hoipaw tuh</para>
  <para style="q2">khyndadyh lan a um cih zah</para>
  <para style="q2">vawsawnaw tung lan khyh.</para>
  <para style="q1">
    <verse number="24" style="v" />A thawnawpaw tuh a kuih kha</para>
  <para style="q2">pake lungkhu lang pute,</para>
  <para style="q1">a khalang lungkhu lang</para>
  <para style="q2">bawku lan sanmah hua khyh.</para>
  <para style="q1">
    <verse number="25" style="v" />Ccungccaw a saryapaw kha zia lah,</para>
  <para style="q2">tuanaw a zyapaw nynh</para>
  <para style="q1">hawnaw a mue cih;</para>
  <para style="q2">mihawpaw kha na thuihei zetuh</para>
  <para style="q2">nythyanaw a mue cih.</para>
  <para style="q1">
    <verse number="26" style="v" />A paaw kha zia zah</para>
  <para style="q2">a nung kha a deepaw ccaaw tuh</para>
  <para style="q1">maethyanaw te thethyanaw</para>
  <para style="q2">a thuakhaepaw nynh thua.</para>
  <para style="q1">
    <verse number="27" style="v" />Ka ccaaw, hawnaw vua khylan</para>
  <para style="q2">thuiheikunaw bya kha ngae nan.</para>
  <para style="q1">
    <verse number="28" style="v" />Ccaekia hoyleipaw nynh</para>
  <para style="q2">byading kha pawlangria khyh,</para>
  <para style="q1">ccungccaw hoyleipaw khalang nynh</para>
  <para style="q2">hoyleinaw kha po a laang.</para>
  <para style="q1">
    <verse number="29" style="v" />Ccungccaw a sarya hae paw</para>
  <para style="q2">hanlan detahnaw,</para>
  <para style="q1">mingaee hae ke hanlan</para>
  <para style="q2">ziakunaw tuh paccyn ty athua vae.</para>
  <chapter number="20" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Misutui tuh saryanaw</para>
  <para style="q2">a thuakhaepaw thua zah,</para>
  <para style="q1">aruikuhpaw niapaw tuh</para>
  <para style="q2">pekunaw nynh thua,</para>
  <para style="q1">tuh-e liate a seipaw miakaw tuh</para>
  <para style="q2">a hawpaw thua khyh.</para>
  <para style="q1">
    <verse number="2" style="v" />Siapharan thinrianaw tuh</para>
  <para style="q2">chindeih nynh a siapaw te nynh aloku;</para>
  <para style="q1">a thin a riasahpaw tuh</para>
  <para style="q2">amaw te amaw kha hiinnaw</para>
  <para style="q2">a zosakuhpaw nynh thua.</para>
  <para style="q1">
    <verse number="3" style="v" />Pekunaw kha a daesahpaw tuh</para>
  <para style="q2">sawtua lan umpaw nynh thua,</para>
  <para style="q1">thuasalama angaeepaw miakaw nynh</para>
  <para style="q2">pekunaw kha a puisah.</para>
  <para style="q1">
    <verse number="4" style="v" />A thawnawpaw nynh</para>
  <para style="q2">leithue ccyh kya leithue khyh;</para>
  <para style="q1">tukeiccuze loohrue ccyh yn thua tuh,</para>
  <para style="q2">pawpaw mah mue vae khyh.</para>
  <para style="q1">
    <verse number="5" style="v" />Ccungccaw thinlung kya</para>
  <para style="q2">eenaw tuh akhupaw tui te nynh aloku;</para>
  <para style="q1">thuasalama mihawpaw nynh tuh</para>
  <para style="q2">khah-e tui kha a thekuh cih.</para>
  <para style="q1">
    <verse number="6" style="v" />Ccungccaw patae nynh</para>
  <para style="q2">a lungzipaw nynh ka thua cite</para>
  <para style="q1">mimaw te mimaw kha a hoku hae,</para>
  <para style="q2">thuasalama alungzipaw ccungccaw kha</para>
  <para style="q2">hum nynh mou a muih kho cih?</para>
  <para style="q1">
    <verse number="7" style="v" />Miding nynh dingnaw laanpi kya zui zah,</para>
  <para style="q2">a ccaaw a no hae tuh</para>
  <para style="q2">hythuanaw a ccou hae!</para>
  <para style="q1">
    <verse number="8" style="v" />Byapianaw bawitungkhung kya</para>
  <para style="q2">a haungpaw siapharan nynh</para>
  <para style="q1">hoyleinaw balyn kha</para>
  <para style="q2">a mit te pong a laesah thya.</para>
  <para style="q1">
    <verse number="9" style="v" />“Ka thinlung ka thyaasaku vae;</para>
  <para style="q2">ka seinaw kyate ka thyaa vae,”</para>
  <para style="q2">cite hummou a ho kho cih?</para>
  <para style="q1">
    <verse number="10" style="v" />Ahme leipaw khinlung te</para>
  <para style="q2">ahme leipaw tounawpaw tuh</para>
  <para style="q1">parouh mawte</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> hanlan</para>
  <para style="q2">anungsikuhpaw nynh thua.</para>
  <para style="q1">
    <verse number="11" style="v" />Imua nynh heize a cyipaw kha</para>
  <para style="q2">acci te cci khyh,</para>
  <para style="q1">ahme te hme khyh kha</para>
  <para style="q2">a cyisahnaw khate</para>
  <para style="q2">amaw toulou nynh a langsaku.</para>
  <para style="q1">
    <verse number="12" style="v" />Thaenawpaw nakaring te</para>
  <para style="q2">muihnawpaw mit hynh</para>
  <para style="q2">parouh mawte <char style="nd">Bawipaw </char> nynh a rae.</para>
  <para style="q1">
    <verse number="13" style="v" />Ipaw kha sungsah nan,</para>
  <para style="q2">tuhkhyhze tuh na ryachi cih;</para>
  <para style="q1">na mit kha na dae zetuh,</para>
  <para style="q2">looh patae na hoi cih.</para>
  <para style="q1">
    <verse number="14" style="v" />A retupaw nynh,</para>
  <para style="q2">“Hoy khyh, hoy khyh,” a cithya,</para>
  <para style="q2">oute cceih zah a poku.</para>
  <para style="q1">
    <verse number="15" style="v" />Sui a um, amee rupaw lung mah</para>
  <para style="q2">patae a um,</para>
  <para style="q1">thuasalama hawnaw bya tuh</para>
  <para style="q2">amee myarya rupaw nynh thua.</para>
  <para style="q1">
    <verse number="16" style="v" />Ny leipaw ccungccaw elang</para>
  <para style="q2">aamah a khanpakuhpaw kya-e</para>
  <para style="q1">boeining kha kyngpah;</para>
  <para style="q2">ny leipaw ccungccaw hanlan</para>
  <para style="q1">aamahkhan lante pya athuapaw</para>
  <para style="q2">ponpaw uccaw kha kyngpah.</para>
  <para style="q1">
    <verse number="17" style="v" />Hynhute muepaw looh tuh</para>
  <para style="q2">athua zemah,</para>
  <para style="q1">a aetu khalang kya</para>
  <para style="q2">lungpyng te phe abeih cih.</para>
  <para style="q1">
    <verse number="18" style="v" />Tuanaw pyakupaw kha lawku liate</para>
  <para style="q2">paccynkunaw tuh atyn;</para>
  <para style="q1">Ahawpaw cciakhaenaw</para>
  <para style="q2">a um ze kyalya rhaw na tho cih.</para>
  <para style="q1">
    <verse number="19" style="v" />Thanrynaw nynh byaru kha a phy;</para>
  <para style="q2">tukeiccuze bya kathuhkaleih</para>
  <para style="q1">a hothyapaw khate</para>
  <para style="q2">la mungkuh nan oh.</para>
  <para style="q1">
    <verse number="20" style="v" />A nung te a paaw kha</para>
  <para style="q2">thya a lawpaw tuh</para>
  <para style="q1">mohkaraepaw kyakhe</para>
  <para style="q2">a maeekhua tuh a chih cih.</para>
  <para style="q1">
    <verse number="21" style="v" />Arangte muepaw rho tuh</para>
  <para style="q2">athangnaw kya hythuanaw um lan khyh.</para>
  <para style="q1">
    <verse number="22" style="v" />“Hoyleinaw kha ka liaru cih,”</para>
  <para style="q2">cite la ho nan;</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha ngaw lah,</para>
  <para style="q2">amaw nynh ae bawm cih.</para>
  <para style="q1">
    <verse number="23" style="v" />Khinlung laesahnaw tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> hanlan</para>
  <para style="q1">anungsikuhpaw thua zah,</para>
  <para style="q2">ahme leipaw zawccu tuh hoy khyh.</para>
  <para style="q1">
    <verse number="24" style="v" />Ccungccaw a cciakhaetupaw tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh thua;</para>
  <para style="q2">ccungccaw nynh a laanpi kha</para>
  <para style="q2">pawtemou a nyh kho cih?</para>
  <para style="q1">
    <verse number="25" style="v" />“E tuh Pachia hanlan athyaa,”</para>
  <para style="q2">cite rangkhirangkhaete ho koute</para>
  <para style="q1">nyalangte bua tuaku thui tuh</para>
  <para style="q2">byakinkunaw a raetu hanlan</para>
  <para style="q2">kaang hawte nynh thua,</para>
  <para style="q1">
    <verse number="26" style="v" />Ahawpaw siapharan nynh tuh</para>
  <para style="q2">ccungccaw hoylei hae paw kha</para>
  <para style="q1">ccangkung vawte vaw hae zah,</para>
  <para style="q2">leccu te a tousah thin hae.</para>
  <para style="q1">
    <verse number="27" style="v" />Ccungccaw thinlung tuh</para>
  <para style="q2">pyn lungkhu umpaw balyn kha</para>
  <para style="q1">akaw-aleih a ccungpaw</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> maeekhua nynh thua.</para>
  <para style="q1">
    <verse number="28" style="v" />Lungzinaw te zyn lan umnaw nynh</para>
  <para style="q2">siapharan kha thungkhaw zah,</para>
  <para style="q1">dingnaw nynh</para>
  <para style="q2">a bawi haungnaw kha a tynsah.</para>
  <para style="q1">
    <verse number="29" style="v" />Mino hae phu-enaw tuh</para>
  <para style="q2">mih thawzung nynh thua,</para>
  <para style="q1">ataw hae paw puithyanaw tuh</para>
  <para style="q2">mih sangpaw kha nynh thua.</para>
  <para style="q1">
    <verse number="30" style="v" />Vaemaw kha accih lante</para>
  <para style="q2">singpya liate ahoy leipaw kha athyaa;</para>
  <para style="q1">ziaku buakunaw nynh mah</para>
  <para style="q2">pyn lungkhu e hae kha a thyaasah.</para>
  <chapter number="21" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Siapharan thinlung tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kuih kya umpaw</para>
  <para style="q1">vadungtui hawte thua zah,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh a rynaw</para>
  <para style="q2">miakaw langkhe a mae.</para>
  <para style="q1">
    <verse number="2" style="v" />Ccungccaw nynh tuh</para>
  <para style="q2">a cyipaw balyn kha akyh cite a muih,</para>
  <para style="q1">thuasalama <char style="nd">Bawipaw </char> nynh tuh</para>
  <para style="q2">thinlung kha akhin a sae.</para>
  <para style="q1">
    <verse number="3" style="v" />Silawnaw rae laeze</para>
  <para style="q2">dingnaw te byading rae kha</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh a ccou ryhua.</para>
  <para style="q1">
    <verse number="4" style="v" />Lysakunaw mitdae te</para>
  <para style="q2">tansakunaw thinlung,</para>
  <para style="q1">ccungccaw hoyleipaw kya-e</para>
  <para style="q2">maeekhua tuh seinaw nynh thua.</para>
  <para style="q1">
    <verse number="5" style="v" />Azuakuhpaw ccungccaw</para>
  <para style="q2">paccynkunaw nynh</para>
  <para style="q1">hoirumnaw kha a thuakhae cih,</para>
  <para style="q2">thuasalama rangkhirangkhaete</para>
  <para style="q1">a cyihpaw miakaw tuh</para>
  <para style="q2">ryachinaw a tung ccaccing cih.</para>
  <para style="q1">
    <verse number="6" style="v" />Hynhute muepaw sisua tuh</para>
  <para style="q2">akhuhthungpaw tuihu hawte thua zah</para>
  <para style="q2">chinaw kaang nynh thua.</para>
  <para style="q1">
    <verse number="7" style="v" />Ccungccaw hoylei hae paw tuh</para>
  <para style="q2">mih puathonaw nynh</para>
  <para style="q1">mimaw kha a roh cih hae,</para>
  <para style="q2">pawccecize ahmepaw kha</para>
  <para style="q2">cyih ry khyh hae.</para>
  <para style="q1">
    <verse number="8" style="v" />A seipaw ccungccaw laanpi tuh akou,</para>
  <para style="q2">thuasalama athyaapaw</para>
  <para style="q2">ccungccaw cyisahnaw tuh akyh.</para>
  <para style="q1">
    <verse number="9" style="v" />A ccohkuh thyapaw zu ryte</para>
  <para style="q2">inn lungkhu kya umlae tuh</para>
  <para style="q1">innccukaly apaki lang</para>
  <para style="q2">umpaw tuh ahoyhua.</para>
  <para style="q1">
    <verse number="10" style="v" />Ccungccaw hoyleipaw</para>
  <para style="q2">thinlung nynh tuh</para>
  <para style="q2">hoyleinaw kha a ry;</para>
  <para style="q1">a innpaw hae tungvaw</para>
  <para style="q2">thawccinaw hoi khyh.</para>
  <para style="q1">
    <verse number="11" style="v" />Ccungccaw a saryapaw nynh</para>
  <para style="q2">detahnaw he a ing te,</para>
  <para style="q1">tuanaw a zyapaw tuh</para>
  <para style="q2">hawnaw houh a mue;</para>
  <para style="q1">a hawpaw kha thuihei lanze,</para>
  <para style="q2">hawnaw houh a mue.</para>
  <para style="q1">
    <verse number="12" style="v" />A dingpaw nynh ccungccaw</para>
  <para style="q2">hoyleipaw inn kya</para>
  <para style="q1">a cyihkuhpaw kha hoyte a ny;</para>
  <para style="q2">ccungccaw hoyleipaw kha</para>
  <para style="q2">ronaw kalan a sawbung.</para>
  <para style="q1">
    <verse number="13" style="v" />Ryachipaw nynh a siaruapaw kha</para>
  <para style="q2">na nakaring na hutawku zetuh,</para>
  <para style="q1">namaw he na sia te,</para>
  <para style="q2">hum nynh sanmah</para>
  <para style="q2">ae thaepah lan khyh.</para>
  <para style="q1">
    <verse number="14" style="v" />Aruh lante pyapaw lasung nynh</para>
  <para style="q2">thinrianaw kha daesah zah,</para>
  <para style="q1">boei kaw te zya ccyngpaw</para>
  <para style="q2">pyaruh nynh</para>
  <para style="q2">myarya thinrianaw kha a daesah.</para>
  <para style="q1">
    <verse number="15" style="v" />Ahmete byapia athua zetuh,</para>
  <para style="q2">miding hae elang</para>
  <para style="q1">lungtuanaw nynh thua,</para>
  <para style="q2">thuasalama hoyleinaw</para>
  <para style="q1">a rae hae paw hanlan</para>
  <para style="q2">lungronaw nynh thua.</para>
  <para style="q1">
    <verse number="16" style="v" />Nythyanaw laanpi kyate</para>
  <para style="q2">a vaevuipaw tuh</para>
  <para style="q1">a chih hae paw phu kya</para>
  <para style="q2">a um cih hae.</para>
  <para style="q1">
    <verse number="17" style="v" />Hoysahnaw a rypaw tuh</para>
  <para style="q2">a ryachi cih; misutui te</para>
  <para style="q2">chitui a rypaw tuh hoirum lan khyh.</para>
  <para style="q1">
    <verse number="18" style="v" />Ccungccaw hoyleipaw tuh</para>
  <para style="q2">midingpaw hanlan</para>
  <para style="q1">shawkhawnawpaw thua zah,</para>
  <para style="q2">a lungzi leipaw tuh</para>
  <para style="q1">midingpaw hanlan</para>
  <para style="q2">shawkhawnawpaw nynh thua.</para>
  <para style="q1">
    <verse number="19" style="v" />A ccohkuhpaw te</para>
  <para style="q2">peku a rypaw zu ryte</para>
  <para style="q1">umkheih lae tuh</para>
  <para style="q2">laesia ram kya um ze a hoyhua.</para>
  <para style="q1">
    <verse number="20" style="v" />Mihawpaw inn kya tuh</para>
  <para style="q2">aphutepaw sisua te chitui a um,</para>
  <para style="q1">thuasalama mingaeepaw nynh tuh</para>
  <para style="q2">tuh-e sisua tuh phe a thangsah han.</para>
  <para style="q1">
    <verse number="21" style="v" />Dingnaw te thawccinaw kha</para>
  <para style="q2">a ccungpaw tuh</para>
  <para style="q2">hiinnaw te sawtuanaw kha a mue cih.</para>
  <para style="q1">
    <verse number="22" style="v" />Ahawpaw ccungccaw nynh tuh</para>
  <para style="q2">rhawkaw hae khuapi kha</para>
  <para style="q1">ccianua thung zah</para>
  <para style="q2">khuaccaaw hae nynh</para>
  <para style="q1">a doliakuh hae paw sihkakinpaw</para>
  <para style="q2">rhawhohung kha phe a ro kho.</para>
  <para style="q1">
    <verse number="23" style="v" />A mung te a lae a sungkuhpaw tuh</para>
  <para style="q2">vawsawnaw kha</para>
  <para style="q2">a sihaekuhpaw nynh thua.</para>
  <para style="q1">
    <verse number="24" style="v" />A lysakuhpaw, a tansakuhpaw te</para>
  <para style="q2">ccungccaw pawlangria leipaw tuh</para>
  <para style="q2">a min kha, “Saryatupaw,” a ci hae.</para>
  <para style="q1">
    <verse number="25" style="v" />A thawnawpaw tuh</para>
  <para style="q2">rya a law ry khyh keiccuze</para>
  <para style="q1">myarya a ryduaanaw nynh</para>
  <para style="q2">amaw kha a chisah kho.</para>
  <para style="q1">
    <verse number="26" style="v" />Ccungccaw hoyleipaw tuh</para>
  <para style="q2">ninlang a rynaw ale,</para>
  <para style="q1">thuasalama miding nynh tuh</para>
  <para style="q2">sithya leite a pya hae.</para>
  <para style="q1">
    <verse number="27" style="v" />Ccungccaw hoyleipaw nynh</para>
  <para style="q2">silawnaw a raepaw tuh</para>
  <para style="q1">anungsikuhpaw nynh thua;</para>
  <para style="q2">ahoy leipaw paccynnaw te</para>
  <para style="q2">yn ccyng zetuh</para>
  <para style="q2">hohcihmou houh anungsiku?</para>
  <para style="q1">
    <verse number="28" style="v" />Akyh leipaw ccaekia tuh a roh cih,</para>
  <para style="q2">thuasalama hoyte</para>
  <para style="q1">a ngaepahtupaw nynh tuh</para>
  <para style="q2">hmerarih lan ccaekia a khan cih.</para>
  <para style="q1">
    <verse number="29" style="v" />Ccungccaw hoyleipaw nynh tuh</para>
  <para style="q2">a rawthungpaw mitmae khate a umsaku,</para>
  <para style="q1">thuasalama miding nynh tuh</para>
  <para style="q2">a laanpi kha a paccynku.</para>
  <para style="q1">
    <verse number="30" style="v" />
    <char style="nd">Bawipaw </char> malang tuh</para>
  <para style="q2">hawnaw, nynaw te</para>
  <para style="q1">tuanaw pyakunaw hynh</para>
  <para style="q2">alakawpaw nynh thua.</para>
  <para style="q1">
    <verse number="31" style="v" />Rhawtuknaw nin hanlan</para>
  <para style="q2">marang kha paccyn athua vae,</para>
  <para style="q1">thuasalama taenaw tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kya-e nynh thua.</para>
  <chapter number="22" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Hoirumnaw patae laeze</para>
  <para style="q2">minhoynaw kha</para>
  <para style="q1">poku lanpaw nynh thua,</para>
  <para style="q2">maehoynaw tuh</para>
  <para style="q2">sui te ngun laeze ahoyhua.</para>
  <para style="q1">
    <verse number="2" style="v" />A hoirumpaw te a ryachipaw tuh</para>
  <para style="q2">a laenaw hae um khyh:</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> tuh tuh-e hae balyn</para>
  <para style="q2">a raetupaw nynh thua.</para>
  <para style="q1">
    <verse number="3" style="v" />Mihawpaw nynh vawsawnaw kha</para>
  <para style="q2">muih zah a retawku;</para>
  <para style="q2">thuasalama tuanaw</para>
  <para style="q1">a zyapaw nynh tuh po cceih zah,</para>
  <para style="q2">tuh-e vawsawnaw kha a teing.</para>
  <para style="q1">
    <verse number="4" style="v" />Zakawsangsahkunaw te</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> rawrinaw hanlan</para>
  <para style="q2">muepaw lasung tuh</para>
  <para style="q1">hoirumnaw, sawtuanaw te</para>
  <para style="q2">hiinnaw nynh thua.</para>
  <para style="q1">
    <verse number="5" style="v" />Ccungccaw hoyleipaw</para>
  <para style="q2">laanpi kya tuh hinpaw te</para>
  <para style="q1">kaang a um hae;</para>
  <para style="q2">a raeringkuhpaw nynh tuh</para>
  <para style="q2">tuh-e hae kyate a sihaeku.</para>
  <para style="q1">
    <verse number="6" style="v" />Imua nynh a zui lanpaw</para>
  <para style="q2">laan dingpaw kha ccangpah lah,</para>
  <para style="q1">he yn piccan te, tuin kyate</para>
  <para style="q2">cceihsei vae lan khyh.</para>
  <para style="q1">
    <verse number="7" style="v" />Mihoipaw nynh ryachipaw kha a uk,</para>
  <para style="q2">a koiitupaw tuh</para>
  <para style="q2">a koiisakuhtupaw see nynh thua.</para>
  <para style="q1">
    <verse number="8" style="v" />Ahme leipaw ccacii a vuapaw tuh</para>
  <para style="q2">vawsawnaw looh kha a rue cih,</para>
  <para style="q1">a thinrianaw ccungngue tuh</para>
  <para style="q2">amaw tungvaw accah cih.</para>
  <para style="q1">
    <verse number="9" style="v" />Hysahnaw thinlung hoi hae paw tuh</para>
  <para style="q2">hythuapya athua cih hae,</para>
  <para style="q1">pawccecize mih looh kha</para>
  <para style="q2">ryachi hae a neethung hae.</para>
  <para style="q1">
    <verse number="10" style="v" />Ccungccaw a saryapaw kha</para>
  <para style="q2">po dee lah, byalungnaw mah</para>
  <para style="q1">a toikuh cih; pekunaw te</para>
  <para style="q2">theihryanaw mah adae cih.</para>
  <para style="q1">
    <verse number="11" style="v" />Athyaapaw thinlung kha</para>
  <para style="q2">ry zah a byaho a-epaw tuh</para>
  <para style="q1">siapharan kha a ruiban lang</para>
  <para style="q2">a hoi cih.</para>
  <para style="q1">
    <verse number="12" style="v" />
    <char style="nd">Bawipaw </char> mit nynh</para>
  <para style="q2">nynaw kha phang a rin,</para>
  <para style="q1">thuasalama a hynhupaw</para>
  <para style="q2">bya kha tuh a vua.</para>
  <para style="q1">
    <verse number="13" style="v" />Thawnawpaw nynh,</para>
  <para style="q2">“Inn atolang chindeih a um!</para>
  <para style="q2">laanpi kya yn teisei cih!” a ci.</para>
  <para style="q1">
    <verse number="14" style="v" />Nopi hoyleipaw khalang tuh</para>
  <para style="q2">akhupaw hunghua nynh thua;</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh a thinrianuapaw</para>
  <para style="q2">ccungccaw tuh tuh-e hunghua</para>
  <para style="q2">lungkhu lang a ccah cih.</para>
  <para style="q1">
    <verse number="15" style="v" />Imuapaw thinlung kyakhe</para>
  <para style="q2">ngaeenaw tuh phang a um,</para>
  <para style="q1">thuasalama thuiheinawpaw</para>
  <para style="q2">ccungngue nynh</para>
  <para style="q2">tuh-e ngaeenaw kha ccaring a dee.</para>
  <para style="q1">
    <verse number="16" style="v" />Amaw hoirum khylan</para>
  <para style="q2">a ryachipaw kha a tuaa a sahpaw te</para>
  <para style="q1">mihoipaw kha a pyapaw tuh</para>
  <para style="q2">solei a ryachi cih.</para>
  <para style="b" />
  <para style="s1">Hawnaw Bya hae</para>
  <para style="q2">
    <verse number="17" style="v" />Hawnaw bya:</para>
  <para style="b" />
  <para style="q1">Na nakaring kha tuakuh lah,</para>
  <para style="q2">a haw hae paw bya kha ngaetua,</para>
  <para style="q1">te na thinlung kha</para>
  <para style="q2">ka ccangpyanaw kalan hin pyaku tua;</para>
  <para style="q1">
    <verse number="18" style="v" />pawccecize khah-e hae kha</para>
  <para style="q2">na lungkhu kya na ccykeku ze</para>
  <para style="q1">lungtuanaw a um cih,</para>
  <para style="q2">na mung kyakhe mah</para>
  <para style="q2">phe a um vae cih.</para>
  <para style="q1">
    <verse number="19" style="v" />
    <char style="nd">Bawipaw </char> kha na doliaku nawlan,</para>
  <para style="q2">atunin hynh-e bya hae hynh</para>
  <para style="q2">kae ccangpya.</para>
  <para style="q1">
    <verse number="20" style="v" />Hawnaw te tuanaw pyakunaw bya</para>
  <para style="q2">sung thum hynh na hanlan</para>
  <para style="q2">phe ka zei vae khaw?</para>
  <para style="q1">
    <verse number="21" style="v" />Tuh-e bya hae tuh</para>
  <para style="q2">nang ae sawtupaw kalan khe</para>
  <para style="q1">akyhpaw bya te</para>
  <para style="q2">na khung kho nawlan hae,</para>
  <para style="q1">adingpaw te akyhpaw</para>
  <para style="q2">langsaku nawlan nynh thua.</para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" />Ryachi hae kha</para>
  <para style="q2">mih rya a chi keiccuze</para>
  <para style="q2">luade nan hae,</para>
  <para style="q1">Riathae hae paw kha</para>
  <para style="q2">koikua lungkhu kya</para>
  <para style="q2">vawsaw pya nan hae;</para>
  <para style="q1">
    <verse number="23" style="v" />pawccecize <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">mih bya kha a pankhae cih hae zah</para>
  <para style="q1">mih uccaw a luatu hae paw kya-e</para>
  <para style="q2">hiinnaw kha a luaru cih hae.</para>
  <para style="q1">
    <verse number="24" style="v" />Thinria a mangpaw te ruiban lang</para>
  <para style="q2">la tang nan oh,</para>
  <para style="q1">a thindynpaw te la mungkuh nan oh,</para>
  <para style="q1">
    <verse number="25" style="v" />a laanpi kha na zuisei cih zah,</para>
  <para style="q2">namaw te namaw</para>
  <para style="q2">kaang na kaesakuh sei cih.</para>
  <para style="q1">
    <verse number="26" style="v" />Milae laebah hanlan</para>
  <para style="q2">aamahkhanpyaku lan</para>
  <para style="q2">bya la kinpakuh bua nan.</para>
  <para style="q1">
    <verse number="27" style="v" />Pya lanpaw na hoi khyh zetuh,</para>
  <para style="q2">na ikhung kha</para>
  <para style="q2">ae lawpah cih hae.</para>
  <para style="q1">
    <verse number="28" style="v" />Na minpaaw hae nynh</para>
  <para style="q2">la bing hae paw langmawlya e</para>
  <para style="q1">syntawnaw lungbing kha</para>
  <para style="q2">la nue nan.</para>
  <para style="q1">
    <verse number="29" style="v" />Amaw ryalaw kya</para>
  <para style="q2">athyapaw ccungccaw na muih tou?</para>
  <para style="q1">aning tuh ccungccaw huataw hanlan</para>
  <para style="q2">ryalawpya leite</para>
  <para style="q1">siapharan hanlan rya a lawpah cih.</para>
  <para style="b" />
  <chapter number="23" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Uktu bawi ryte aekheih lan</para>
  <para style="q2">he na haung ze,</para>
  <para style="q1">na malang umpaw kha</para>
  <para style="q2">hummou athua cipaw hoyte la do,</para>
  <para style="q1">
    <verse number="2" style="v" />eih a ae khopaw</para>
  <para style="q2">ccungccaw na thua ze,</para>
  <para style="q1">namaw te namaw kha</para>
  <para style="q2">na lohtharue kyakhe</para>
  <para style="q2">tangpaw kha nungde.</para>
  <para style="q1">
    <verse number="3" style="v" />Uktu bawi kya-e</para>
  <para style="q2">looh athuapaw kha duaa nan,</para>
  <para style="q1">pawccecize tuh-e looh tuh</para>
  <para style="q2">lingnawpaw looh nynh thua.</para>
  <para style="q1">
    <verse number="4" style="v" />Hoirum khylan</para>
  <para style="q2">eih reihkuh kaesy nan;</para>
  <para style="q2">umtaw thya nawlan hawsakuh.</para>
  <para style="q1">
    <verse number="5" style="v" />Na mit nynh hoirumnaw kha</para>
  <para style="q2">he a do tuh, phe azo vae;</para>
  <para style="q1">pawccecize vaawlui lang</para>
  <para style="q2">a zoupaw mosi hawte</para>
  <para style="q1">a sake kha daw kangmaw zah</para>
  <para style="q2">a zouthya.</para>
  <para style="q1">
    <verse number="6" style="v" />A sithahpaw kya-e looh kha ae nan,</para>
  <para style="q2">a looh athuapaw kha duaa nan;</para>
  <para style="q1">
    <verse number="7" style="v" />pawccecize na lohtharue kya</para>
  <para style="q2">sangrua hawte athua cih.</para>
  <para style="q1">“Ae lah niatua hei,” ae cipah cih;</para>
  <para style="q2">thuasalama tuhcite</para>
  <para style="q2">ae hopya rypaw thua khyh.</para>
  <para style="q1">
    <verse number="8" style="v" />Na ae vae paw looh</para>
  <para style="q2">beihtaraw kha bua na loh cih zah,</para>
  <para style="q1">na lungtuanaw bya kha</para>
  <para style="q2">alakaw lan a tang cih.</para>
  <para style="q1">
    <verse number="9" style="v" />Mingaee nynh a thaenaw khe</para>
  <para style="q2">byaho nan,</para>
  <para style="q1">na hopaw hawnaw bya kha</para>
  <para style="q2">pawlangria lan khyh.</para>
  <para style="q1">
    <verse number="10" style="v" />Langmawlya e syntawnaw</para>
  <para style="q2">lungbing kha la nue nan,</para>
  <para style="q1">ngawraw hae loo kha</para>
  <para style="q2">la lua nan hae,</para>
  <para style="q1">
    <verse number="11" style="v" />pawccecize minmin</para>
  <para style="q2">a shawkhawtupaw tuh</para>
  <para style="q1">a thawsaepaw thua zah,</para>
  <para style="q2">nang kha rawsete</para>
  <para style="q2">mih bya kha a pankhae cih hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Na thinlung kha</para>
  <para style="q2">ccangpyanaw kalan khe</para>
  <para style="q1">pyatua lah, na nakaring kha</para>
  <para style="q2">hawnaw bya kalan khe tuaku tua.</para>
  <para style="q1">
    <verse number="13" style="v" />Imua kha ccangpya leite um nan,</para>
  <para style="q2">ccungngue te na bua ze,</para>
  <para style="q2">chih lan khyh.</para>
  <para style="q1">
    <verse number="14" style="v" />Imua kha ccungngue te na bua ze,</para>
  <para style="q2">a hiinnaw kha michi khua kyate</para>
  <para style="q2">na khumpaw nynh thua.</para>
  <para style="q1">
    <verse number="15" style="v" />Ka ccaaw, na lunghaw zetuh,</para>
  <para style="q2">kae mah ka lungtua cih.</para>
  <para style="q1">
    <verse number="16" style="v" />Na mung nynh akyhpaw kha</para>
  <para style="q2">a ho zetuh, ka lungtua cih.</para>
  <para style="q1">
    <verse number="17" style="v" />Misei hae tungvaw</para>
  <para style="q2">na eiung nan sah,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> rawrite</para>
  <para style="q2">zungzae la um.</para>
  <para style="q1">
    <verse number="18" style="v" />Malang ccyh tuh</para>
  <para style="q2">a um ccaccing keiccuze,</para>
  <para style="q1">na ngaehoinaw kha</para>
  <para style="q2">la zosah nan.</para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" />Ka ccaaw, ngae lah hawsaku tua,</para>
  <para style="q2">na thinlung kha</para>
  <para style="q2">akyhpaw laanpi kya zuisah tua.</para>
  <para style="q1">
    <verse number="20" style="v" />Misutui myarya neih</para>
  <para style="q2">hae paw ryte thuasah,</para>
  <para style="q1">saw myarya ae kho</para>
  <para style="q2">hae paw ryte thuasah</para>
  <para style="q2">mungkuh nan oh;</para>
  <para style="q1">
    <verse number="21" style="v" />pawccecize eih a neihpaw te</para>
  <para style="q2">aepaw eih a ccopaw tuh</para>
  <para style="q1">a ryachi accih cih,</para>
  <para style="q2">myarya a ih khopaw tuh</para>
  <para style="q1">boeining apuepaw kha</para>
  <para style="q2">a lawkuh cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" />Nang ae saahpaw</para>
  <para style="q2">na paaw bya kha ngae lah,</para>
  <para style="q1">na nung kha he a taw vae ze</para>
  <para style="q2">la theihrya nan.</para>
  <para style="q1">
    <verse number="23" style="v" />Byaccing kha rekuh lah,</para>
  <para style="q2">zua nan vae;</para>
  <para style="q1">hawnaw, thuiheikunaw te</para>
  <para style="q2">nythyanaw kha rekuh hae.</para>
  <para style="q1">
    <verse number="24" style="v" />Midingpaw a paaw tuh</para>
  <para style="q2">myaryamaw a lungtua cih;</para>
  <para style="q1">ahawpaw ccapaw a saahkuhpaw tuh</para>
  <para style="q2">a ccapaw tungvaw kya</para>
  <para style="q2">a lungtua cih.</para>
  <para style="q1">
    <verse number="25" style="v" />Na nung te na paaw kha</para>
  <para style="q2">mih lungtuasah hae;</para>
  <para style="q1">nang ae saahkuhnung</para>
  <para style="q2">na nung kha a lungpawsah tua.</para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" />Ka ccaaw, na thinlung kha</para>
  <para style="q2">yn pya lah, na mit nynh ka laanpi hynh</para>
  <para style="q2">hoyte dokuhsah.</para>
  <para style="q1">
    <verse number="27" style="v" />Pawccecize ohhuanung tuh</para>
  <para style="q2">akhupaw hunghua nynh thua;</para>
  <para style="q1">a ccouseikuhpaw zu tuh</para>
  <para style="q2">abypaw tuisung nynh thua.</para>
  <para style="q1">
    <verse number="28" style="v" />Damiah hawte ccungccaw kha</para>
  <para style="q2">buhthya zah, a ccouseikuhpaw</para>
  <para style="q2">pise kha a lungsah thung.</para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" />Hummou lungvawsaw te a um?</para>
  <para style="q2">Hummou a ngaethah?</para>
  <para style="q1">Hummou a pekuh hae paw um?</para>
  <para style="q2">Hummou byalungnaw a hoi?</para>
  <para style="q1">Hummou akonglang um leite</para>
  <para style="q2">vaemaw a mue?</para>
  <para style="q2">Hummou a mit sedadae lang a um?</para>
  <para style="q1">
    <verse number="30" style="v" />Tuh-e hae tuh misutui khaw cia</para>
  <para style="q2">neih hae paw, amynkhuhpaw te</para>
  <para style="q1">pykuhpaw misutui a ccungpaw</para>
  <para style="q2">ccungccaw hae kha nynh thua hae.</para>
  <para style="q1">
    <verse number="31" style="v" />Banang lungkhu kya asepaw,</para>
  <para style="q2">awrarih lan aw zah,</para>
  <para style="q1">nawpali lan a luabungpaw</para>
  <para style="q2">misutui kha la do nan.</para>
  <para style="q1">
    <verse number="32" style="v" />Nyathyakou tuh hupaw hawte</para>
  <para style="q2">khyhthya zah,</para>
  <para style="q2">huparepaw hawte sy a hoi.</para>
  <para style="q1">
    <verse number="33" style="v" />Na mit nynh paleihpanawpaw</para>
  <para style="q2">uccaw kha a muih cih zah,</para>
  <para style="q1">na thinlung nynh</para>
  <para style="q2">tualitua-aepaw bya kha a ho cih.</para>
  <para style="q1">
    <verse number="34" style="v" />Nang tuh rili ngaelung a ihpaw,</para>
  <para style="q2">sanphalung kya boei zonawpaw</para>
  <para style="q1">tung adungparyh kya</para>
  <para style="q2">a ihpaw hawte na thua vae cih.</para>
  <para style="q1">
    <verse number="35" style="v" />“Minmin nynh yn bua hae,</para>
  <para style="q2">thuasalama ka ccisah khyh;</para>
  <para style="q1">kae kha yn thung hae zemah</para>
  <para style="q2">ka nyhkuh khyh.</para>
  <para style="q1">Hohtuhmou ka thaekuh cih?</para>
  <para style="q2">Ccangpaw niapaw kha</para>
  <para style="q1">bua ka ccungkuh cih,” cite na ho cih.</para>
  <chapter number="24" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Ccungccaw hoylei hae paw kha</para>
  <para style="q2">eiung nan hae,</para>
  <para style="q2">minmin ryte mungkuh ry nan,</para>
  <para style="q1">
    <verse number="2" style="v" />pawccecize mih thinlung nynh</para>
  <para style="q2">puathonaw kha tua zah,</para>
  <para style="q1">mih mung nynh ming hae</para>
  <para style="q2">vawsaw pyanaw bya kha a ho.</para>
  <para style="q1">
    <verse number="3" style="v" />Hawnaw liate inn tuh sak thua zah,</para>
  <para style="q2">nythyanaw liate inn tuh atyn;</para>
  <para style="q1">
    <verse number="4" style="v" />nynaw liate innkhaan hae tuh</para>
  <para style="q2">aphutepaw te apuithyapaw</para>
  <para style="q2">sisua hae khate phe a beih.</para>
  <para style="q1">
    <verse number="5" style="v" />Mihawpaw tuh</para>
  <para style="q2">a thawsaepaw laeze a thunghua,</para>
  <para style="q1">nynaw a hoipaw tuh thawzung</para>
  <para style="q2">a hoipaw laeze a thunghua;</para>
  <para style="q1">
    <verse number="6" style="v" />pawccecize a haw hae paw</para>
  <para style="q2">khuakhannaw liate</para>
  <para style="q1">rhaw kha na tuk kho zah</para>
  <para style="q2">tuanaw pyatu patae</para>
  <para style="q2">a umnaw kya taenaw a um.</para>
  <para style="q1">
    <verse number="7" style="v" />Mingaee hae hanlan</para>
  <para style="q2">hawnaw tuh myaryamaw ahang;</para>
  <para style="q1">khua koikua kya</para>
  <para style="q2">byaho ngan khyh hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Hoyleinaw rae lan</para>
  <para style="q2">a paccynkuhpaw tuh</para>
  <para style="q1">vawsawnaw a raetu cite</para>
  <para style="q2">ko athua cih.</para>
  <para style="q1">
    <verse number="9" style="v" />Ngaeepaw khuakhannaw tuh</para>
  <para style="q2">seinaw nynh thua,</para>
  <para style="q1">sarya a mangpaw tuh</para>
  <para style="q2">ccungccaw balyn hanlan</para>
  <para style="q2">anungsikuhpaw nynh thua.</para>
  <para style="q1">
    <verse number="10" style="v" />Vawsaw tung lya</para>
  <para style="q2">na rhawthya zetuh,</para>
  <para style="q2">na thawzung azya.</para>
  <para style="q1">
    <verse number="11" style="v" />Chia lan a cciakhae hae paw kha</para>
  <para style="q2">la luesah hae,</para>
  <para style="q1">chia lan a cciakhae hae paw kha</para>
  <para style="q2">la khum hae,</para>
  <para style="q1">
    <verse number="12" style="v" />tuhte cyi leite nang nynh,</para>
  <para style="q2">“E paw hynh ka nyh khyh,”</para>
  <para style="q1">na ci lanze, tuh-e tuh</para>
  <para style="q2">thinlung a nyhtupaw nynh</para>
  <para style="q2">thaethya lan khyh tou?</para>
  <para style="q1">tuh-e tuh nang kha</para>
  <para style="q2">phang ae rintupaw nynh</para>
  <para style="q1">nyh lan khyh tou?</para>
  <para style="q2">Aning tuh ccungccaw balyn kha</para>
  <para style="q1">mih cyisahnaw thyhte</para>
  <para style="q2">a sangru cih hae paw thua khyh tou?</para>
  <para style="q1">
    <verse number="13" style="v" />Ka ccaaw, khoitui kha niatua,</para>
  <para style="q2">athuapaw nynh thua,</para>
  <para style="q1">adaw kyate accawpaw khoitui tuh</para>
  <para style="q2">na khalang kya a-epaw nynh thua.</para>
  <para style="q1">
    <verse number="14" style="v" />Hawnaw tuh na hiinnaw hanlan</para>
  <para style="q2">tuh-e hawte nynh thua cipaw nyh;</para>
  <para style="q1">hawnaw na hoi zetuh,</para>
  <para style="q2">na hanlan malang ccyh</para>
  <para style="q1">ngaehoinaw a um cih zah,</para>
  <para style="q2">na ngaehoinaw tuh roh lan khyh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" />Ccungccaw hoyleipaw nynh</para>
  <para style="q2">midingpaw inn kha</para>
  <para style="q1">a dokhaw hawte la dokhaw nan;</para>
  <para style="q2">midingpaw nynh</para>
  <para style="q2">a umnawpaw hmin kha la ropah nan;</para>
  <para style="q1">
    <verse number="16" style="v" />pawccecize midingpaw tuh</para>
  <para style="q2">vae sari a khuliaku zemah</para>
  <para style="q1">bua a thokuh cih;</para>
  <para style="q2">thuasalama ccungccaw hoyleipaw tuh</para>
  <para style="q2">vawsawnaw keiccuze a khuliakuh cih.</para>
  <para style="q1">
    <verse number="17" style="v" />Na rhaw hae nynh a khuliaku hae ze,</para>
  <para style="q2">na lungtua nan sah,</para>
  <para style="q1">a thy a pawku hae zemah,</para>
  <para style="q2">na lungpaw nan sah,</para>
  <para style="q1">
    <verse number="18" style="v" />tuhkhyhze tuh <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">tuh-e tuh a muih cih zah</para>
  <para style="q1">a lunghoy lan khyh,</para>
  <para style="q2">te a thinrianaw kha minmin kyate</para>
  <para style="q2">a maeleihsei cih.</para>
  <para style="q1">
    <verse number="19" style="v" />Hoyleinaw a rae hae paw keiccuze</para>
  <para style="q2">na thinphang nan sah,</para>
  <para style="q1">ccungccaw hoylei hae paw kha</para>
  <para style="q2">eiung nan hae;</para>
  <para style="q1">
    <verse number="20" style="v" />pawccecize ccungccaw</para>
  <para style="q2">hoyleipaw tuh ngaehoi lanpaw</para>
  <para style="q1">malang ccyh hoi khyh,</para>
  <para style="q2">ccungccaw hoyleipaw</para>
  <para style="q2">maeekhua tuh a chih cih.</para>
  <para style="q1">
    <verse number="21" style="v" />Ka ccaaw, <char style="nd">Bawipaw </char> te</para>
  <para style="q2">siapharan raw kha ritua,</para>
  <para style="q2">minmin kaw kha la ngaetua;</para>
  <para style="q1">
    <verse number="22" style="v" />pawccecize minmin kyate</para>
  <para style="q2">ronaw tuh vaekheitmawte</para>
  <para style="q1">yn thua cih, minmin nynh</para>
  <para style="q2">a thuakhae kho hae paw</para>
  <para style="q2">ronaw tuh hummou a nyh?</para>
  <para style="s1">Tuhlaepaw Hawnaw Bya hae</para>
  <para style="q2">
    <verse number="23" style="v" />E hae hynh mah</para>
  <para style="q2">ahaw hae paw bya nynh thua:</para>
  <para style="b" />
  <para style="q1">Byapianaw kyaze maedo tuh hoy khyh.</para>
  <para style="q1">
    <verse number="24" style="v" />Ccungccaw hoyleipaw kha,</para>
  <para style="q2">“Nang tuh miding nynh na thua,”</para>
  <para style="q1">cite a hopaw tuh</para>
  <para style="q2">ccungccaw hae nynh</para>
  <para style="q1">thyalaw cih hae zah,</para>
  <para style="q2">minphuin nynh a hua cih;</para>
  <para style="q1">
    <verse number="25" style="v" />thuasalama ccungccaw</para>
  <para style="q2">hoyleipaw kha pe zah</para>
  <para style="q1">a thuiheipaw tuh a lungtua cih zah</para>
  <para style="q2">ahoypaw hythuanaw kha a ccou cih.</para>
  <para style="q1">
    <verse number="26" style="v" />Ahmepaw bya te khung tuh</para>
  <para style="q2">ruiban hoy ccaccing thuanaw kha</para>
  <para style="q2">a langsakuhpaw nynh thua.</para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" />Atolang khe na ryalaw kha</para>
  <para style="q2">paccynku tua,</para>
  <para style="q1">loo kyakhe namaw hanlan</para>
  <para style="q2">atyn-are kha paccyn tytua;</para>
  <para style="q1">tukoute na inn kha sakku tua.</para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" />Akonglang um lei pite</para>
  <para style="q2">na innpaw kha rawsete</para>
  <para style="q1">ccaekia lang tang nan,</para>
  <para style="q2">na mung te hynbya ho nan.</para>
  <para style="q1">
    <verse number="29" style="v" />“Milae nynh ka tungvaw</para>
  <para style="q2">a cyi hawte milae tungvaw</para>
  <para style="q1">ka cyihru cih; milae nynh</para>
  <para style="q2">a cyi thyhte ka liaru cih,”</para>
  <para style="q2">cite ho nan.</para>
  <para style="q1">
    <verse number="30" style="v" />A thawnawpaw ccungccaw loo pe te</para>
  <para style="q2">a ngaeepaw kya-e</para>
  <para style="q1">misu khokhu pe khe</para>
  <para style="q2">po ka cceih zah,</para>
  <para style="q1">
    <verse number="31" style="v" />hinpaw nynh pong a po thin hae paw,</para>
  <para style="q2">hinpaw ku nynh</para>
  <para style="q1">laephi pong a bongpaw te</para>
  <para style="q2">a lungrua atingpaw kha ka muih.</para>
  <para style="q1">
    <verse number="32" style="v" />Te khah-e ka muihpaw kong kha</para>
  <para style="q2">ka tua; ka do zah</para>
  <para style="q2">thuiheinaw kha ka mue.</para>
  <para style="q1">
    <verse number="33" style="v" />Sosoh na ih,</para>
  <para style="q2">sosoh na ngawphukuh zah</para>
  <para style="q1">kuih lepiakute sosoh</para>
  <para style="q2">na haeung lyakhe,<note caller="-" style="x"><char style="xo" closed="false">24.33-34: </char><char style="xt" closed="false"><ref loc="PRO 6:10-11">Ptb 6.10-11</ref></char></note></para>
  <para style="q1">
    <verse number="34" style="v" />ryachinaw tuh</para>
  <para style="q2">miruh hawte thuasah,</para>
  <para style="q1">hobounaw tuh zunghe ccyngkuhpaw</para>
  <para style="q2">rhawkawpaw hawte thuasah</para>
  <para style="q1">na tungvaw yn thua cih.</para>
  <para style="b" />
  <chapter number="25" style="c" />
  <para style="s1">Solomon kya-e Tuhlaepaw Phungtangbya</para>
  <para style="p">
    <verse number="1" style="v" />E hae hynh Judah siapharan Hezekiah</para>
  <para style="q2">a ccungccaw hae nynh</para>
  <para style="q1">a zei pathy hae paw</para>
  <para style="q2">Solomon phungtangbya nynh thua.</para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" />Pachia phu-enaw tuh</para>
  <para style="q2">uccaw hae thuruhpaw hynh nynh thua,</para>
  <para style="q1">thuasalama siapharan phu-enaw tuh</para>
  <para style="q2">uccaw hae a langsakunaw hynh nynh thua.</para>
  <para style="q1">
    <verse number="3" style="v" />Vaawlui tuh hang zah,</para>
  <para style="q2">laephi tuh akhu hawte,</para>
  <para style="q1">siapharan thinlung tuh</para>
  <para style="q2">akaw-aleih ny kho um khyh.</para>
  <para style="q1">
    <verse number="4" style="v" />Ngun kya-e a ia kha vua oh lah,</para>
  <para style="q2">sivawsuhpaw nynh banang</para>
  <para style="q2">rae nawlan uccaw a mue cih;</para>
  <para style="q1">
    <verse number="5" style="v" />siapharan malang kyate</para>
  <para style="q2">ccungccaw hoyleipaw kha</para>
  <para style="q1">cciakhae oh lah, a bawi haungnaw tuh</para>
  <para style="q2">dingnaw te atyn cih.</para>
  <para style="q1">
    <verse number="6" style="v" />Siapharan malang khe</para>
  <para style="q2">sawtuanaw la ccungkuh nan,</para>
  <para style="q1">alesaepaw ccungccaw hae nynh</para>
  <para style="q2">a umnaw hae kyakhe la thadyn nan;<note caller="-" style="x"><char style="xo" closed="false">25.6-7: </char><char style="xt" closed="false"><ref loc="LUK 14:8-10">Luk 14.8-10</ref></char></note></para>
  <para style="q1">
    <verse number="7" style="v" />pawccecize, “Hynhlang hin yn haung,”</para>
  <para style="q2">cikupaw tuh,</para>
  <para style="q1">“Nang laeze a piccan huapaw kha</para>
  <para style="q2">phiapakuh,” cipaw laeze ahoyhua.</para>
  <para style="q1">
    <verse number="8" style="v" />Na mit nynh a muihpaw kha</para>
  <para style="q2">byapiazung lang arangte thuakhae nan,</para>
  <para style="q1">pawccecize na innpaw nynh</para>
  <para style="q2">maethya ae law lanze</para>
  <para style="q2">athangnaw kya pawtemou na cyih cih?</para>
  <para style="q1">
    <verse number="9" style="v" />Na innpaw te byathan</para>
  <para style="q2">na hoi oh paw kha</para>
  <para style="q1">naemaw te naemaw ccawkunaw rae oh;</para>
  <para style="q2">milae byaru kha la phy nan;</para>
  <para style="q1">
    <verse number="10" style="v" />tuhkhyhze tuh aning nynh</para>
  <para style="q2">he a thae te, maethya ae lah cih zah,</para>
  <para style="q1">na thethyanaw tuh</para>
  <para style="q2">thang vae lan khyh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" />Ho lan accannaw kya hopaw bya tuh</para>
  <para style="q2">ngun abawng lungkhu</para>
  <para style="q2">umpaw sui athae te nynh aloku.</para>
  <para style="q1">
    <verse number="12" style="v" />Ahawpaw thuiheitu bya tuh</para>
  <para style="q2">a ngae rypaw hanlan</para>
  <para style="q1">sui kuihpu khyhze</para>
  <para style="q2">sui uccaw te nynh aloku.</para>
  <para style="q1">
    <verse number="13" style="v" />Alungzipaw zeccuetu tuh</para>
  <para style="q2">a sawtu hae hanlan</para>
  <para style="q1">loohrue ccyh e vuiraw</para>
  <para style="q2">akyaapaw te nynh aloku.</para>
  <para style="q1">
    <verse number="14" style="v" />Lasung kae pya cih cite</para>
  <para style="q2">pookuh zah a pya leipaw tuh</para>
  <para style="q1">khuaaratui a umbia leipaw</para>
  <para style="q2">maeking te khivae hawte nynh thua.</para>
  <para style="q1">
    <verse number="15" style="v" />Lungsaenaw nynh</para>
  <para style="q2">uktu bawi kha a soihbia kho,</para>
  <para style="q2">byanepaw nynh ru kha a khya kho.</para>
  <para style="q1">
    <verse number="16" style="v" />Khoitui na muih ze,</para>
  <para style="q2">na byn khin te kyalya neih,</para>
  <para style="q1">eih lung na nia ze,</para>
  <para style="q2">na luaphukuh cih.</para>
  <para style="q1">
    <verse number="17" style="v" />Na innpaw inn lang</para>
  <para style="q2">atu te atu paebua nan,</para>
  <para style="q1">tuhkhyhze tuh na innpaw nynh</para>
  <para style="q2">phe ae khin cih zah ae hua cih.</para>
  <para style="q1">
    <verse number="18" style="v" />A innpaw kha rawsete</para>
  <para style="q2">ahme leipaw ccaekia a khanpaw tuh</para>
  <para style="q1">tungbang, thaloi te</para>
  <para style="q2">ahepaw the te nynh aloku.</para>
  <para style="q1">
    <verse number="19" style="v" />Vawsaw tung lyaze</para>
  <para style="q2">alungzi leipaw ccungccaw kha</para>
  <para style="q1">doliaku tuh ahoy leipaw haw te</para>
  <para style="q2">akhoupaw ccu hawte nynh thua.</para>
  <para style="q1">
    <verse number="20" style="v" />A ngaethahpaw kha</para>
  <para style="q2">hlaw a sahpahpaw tuh</para>
  <para style="q1">khuacci lya uccaw a khahpaw te,</para>
  <para style="q2">vaemaw kya loi a thuhpaw te nynh aloku.</para>
  <para style="q1">
    <verse number="21" style="v" />Na rhawpaw kha a vuelaw ze,</para>
  <para style="q2">ae lanpaw looh la pya;</para>
  <para style="q2">a tuihaw ze, nia lanpaw tui la pya;<note caller="-" style="x"><char style="xo" closed="false">25.21-22: </char><char style="xt" closed="false"><ref loc="ROM 12:20">Rom 12.20</ref></char></note></para>
  <para style="q1">
    <verse number="22" style="v" />tuhte na cyi zetuh,</para>
  <para style="q2">a lu vawlan maee-e</para>
  <para style="q1">na pumpaw athua cih zah,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh lasung ae pya cih.</para>
  <para style="q1">
    <verse number="23" style="v" />Thahlang e khisan nynh</para>
  <para style="q2">khuaaratui kha yn thuakhae hawte,</para>
  <para style="q1">thethya a hopaw lae nynh</para>
  <para style="q2">thinrianaw kha a thuakhae.</para>
  <para style="q1">
    <verse number="24" style="v" />Accohkuh thyapaw zu ryte</para>
  <para style="q2">inn lungkhu umlae tuh</para>
  <para style="q1">innccukaly apaki lang</para>
  <para style="q2">umpaw tuh ahoyhua.</para>
  <para style="q1">
    <verse number="25" style="v" />Asawnaw ram kyate</para>
  <para style="q2">yn thuapaw thehoypaw tuh</para>
  <para style="q1">tui a hawpaw hanlan</para>
  <para style="q2">tui kyaapaw hawte nynh thua.</para>
  <para style="q1">
    <verse number="26" style="v" />Ccungccaw hoyleipaw malang</para>
  <para style="q2">a seipaw miding tuh</para>
  <para style="q1">anuihpaw tuisung,</para>
  <para style="q2">athupaw tuidy hawte nynh thua.</para>
  <para style="q1">
    <verse number="27" style="v" />Khoitui patae niapaw tuh hoy khyh,</para>
  <para style="q2">tuhawte sawtuakunaw</para>
  <para style="q2">eih ry kaesypaw tuh hoy khyh.</para>
  <para style="q1">
    <verse number="28" style="v" />A thinlung a sungkuh kho leipaw tuh</para>
  <para style="q2">koihlupaw lungrua ting zah</para>
  <para style="q1">uahalaepaw khua te nynh aloku.</para>
  <chapter number="26" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Hawnin ccyh e vuiraw hawte thuasah,</para>
  <para style="q2">loohrue ccyh e khuaaratui hawte thuasah,</para>
  <para style="q1">sawtuanaw tuh mingaee hanlan</para>
  <para style="q2">ngaekuh khyh.</para>
  <para style="q1">
    <verse number="2" style="v" />Rihthya tuh khiavuikuh zah,</para>
  <para style="q2">ccipae tuh a zou bungthung hawte,</para>
  <para style="q1">akonglang um leipaw</para>
  <para style="q2">thyalawnaw tuh pawlang tang khyh.</para>
  <para style="q1">
    <verse number="3" style="v" />Marang hanlan ccungngue,</para>
  <para style="q2">lann hanlan rangtei thua zah,</para>
  <para style="q1">mingaee ke hanlan tuh</para>
  <para style="q2">ccungngue nynh thua.</para>
  <para style="q1">
    <verse number="4" style="v" />Mingaee kha a ngaeenaw thyhte</para>
  <para style="q2">byakhung nan, tuhkhyhze tuh</para>
  <para style="q1">nang mah a ngaeepaw lang</para>
  <para style="q2">na tangsei cih.</para>
  <para style="q1">
    <verse number="5" style="v" />Mingaee kha a ngaeenaw thyhte</para>
  <para style="q2">bya la khung, tuhkhyhze tuh</para>
  <para style="q2">ka haw cite a tuakuh sei cih.</para>
  <para style="q1">
    <verse number="6" style="v" />Mingaee kha bya a tawpaw tuh</para>
  <para style="q2">amaw ccu kha thoh pae lan</para>
  <para style="q1">a baekuhpaw thua zah,</para>
  <para style="q2">vawsawnaw a tung cih.</para>
  <para style="q1">
    <verse number="7" style="v" />Mingaee khalang kya-e</para>
  <para style="q2">phungtangbya tuh</para>
  <para style="q1">asaekuh huatawpaw</para>
  <para style="q2">ccukhoupaw ccu te nynh aloku.</para>
  <para style="q1">
    <verse number="8" style="v" />Mingaee kha sawtuanaw pyapaw tuh</para>
  <para style="q2">zae kyakhe lungpyng kha</para>
  <para style="q2">kyngdepaw te nynh aloku.</para>
  <para style="q1">
    <verse number="9" style="v" />Mingaee khalang kya-e</para>
  <para style="q2">phungtangbya tuh</para>
  <para style="q1">aruipaw ccungccapaw kuih</para>
  <para style="q2">athuingpaw hinpaw te nynh thua.</para>
  <para style="q1">
    <verse number="10" style="v" />A pe po cceihpaw mingaee khyhze</para>
  <para style="q2">a ruipaw kha ryalaw lan</para>
  <para style="q2">a hohkuhpaw ccungccaw tuh</para>
  <para style="q1">ccungccaw miakaw vawsaw a tungsahpaw</para>
  <para style="q2">thekawthyapaw te nynh aloku.</para>
  <para style="q1">
    <verse number="11" style="v" />A ngaeenaw kha buabua</para>
  <para style="q2">a langsakuhpaw mingaee tuh,</para>
  <para style="q2">a lua a kinuapaw ui te nynh aloku.</para>
  <para style="q1">
    <verse number="12" style="v" />Amaw mitmuihnaw kya</para>
  <para style="q2">ka haw a cikuhpaw laeze</para>
  <para style="q1">mingaeepaw hanlan</para>
  <para style="q2">ngaehoinaw a umhua.</para>
  <para style="q1">
    <verse number="13" style="v" />Thawnawpaw nynh,</para>
  <para style="q2">“Inn atolang chindeih a um!</para>
  <para style="q2">laanpi kya chindeih a um!” a ci.</para>
  <para style="q1">
    <verse number="14" style="v" />Thuakaw nynh thuakawtung kya</para>
  <para style="q2">palei a miaku hawte</para>
  <para style="q1">thawnawpaw tuh a ikhung vawlan</para>
  <para style="q2">palei a paleihkuh bungthung.</para>
  <para style="q1">
    <verse number="15" style="v" />Thawnawpaw tuh a kuih kha</para>
  <para style="q2">pake lungkhu lang pu zah,</para>
  <para style="q1">a khalang lungkhu lang</para>
  <para style="q2">bawku lan sanmah hua khyh.</para>
  <para style="q1">
    <verse number="16" style="v" />Hawnawte bya a khung</para>
  <para style="q2">kho hae paw lu sari laeze,</para>
  <para style="q1">thawnawpaw tuh</para>
  <para style="q2">amaw tuanaw kya a hawhua.</para>
  <para style="q1">
    <verse number="17" style="v" />Milae pekunaw kya</para>
  <para style="q2">a thungkuh buapaw tuh</para>
  <para style="q1">amaw ccia lan cceihpaw</para>
  <para style="q2">ui nakua kha</para>
  <para style="q2">a kyngpaw te nynh aloku.</para>
  <para style="q1">
    <verse number="18-19" style="v" />A innpaw kha ling zah,</para>
  <para style="q2">“Kae ccyasahpaw khaw tou!”</para>
  <para style="q1">cite a hopaw tuh maee-e, the te</para>
  <para style="q2">chinawpaw zunghe khate</para>
  <para style="q1">a kawpaw a angaeepaw</para>
  <para style="q2">hawte nynh thua,</para>
  <para style="q1">
    <verse number="20" style="v" />Maeething a um khyh ze,</para>
  <para style="q2">maee a chi hawte,</para>
  <para style="q1">thanthya hokunaw a um khyh ze</para>
  <para style="q2">pekunaw adae.</para>
  <para style="q1">
    <verse number="21" style="v" />Maeehue nynh maee-e esah zah,</para>
  <para style="q2">maeething nynh maee a ruasah hawte,</para>
  <para style="q1">peku a mangpaw nynh</para>
  <para style="q2">pekunaw kha a thuakhae.</para>
  <para style="q1">
    <verse number="22" style="v" />Thanthya a hotupaw bya tuh</para>
  <para style="q2">looh athuapaw te nynh aloku;</para>
  <para style="q2">tuh-e bya tuh pyn lungkhu lang po a tee.</para>
  <para style="q1">
    <verse number="23" style="v" />Nawpali lan byahothya zah</para>
  <para style="q2">a thinlung hoyleipaw tuh</para>
  <para style="q1">asi thuhkuhpaw laephi ang</para>
  <para style="q2">te nynh aloku.</para>
  <para style="q1">
    <verse number="24" style="v" />Ccungccaw huanaw</para>
  <para style="q2">a hoipaw nynh tuh a bya kha</para>
  <para style="q1">kou a hosakuh thya,</para>
  <para style="q2">thuasalama a lungkhu kya</para>
  <para style="q1">ccungccaw lingnaw kha nynh</para>
  <para style="q2">phang a poi;</para>
  <para style="q1">
    <verse number="25" style="v" />aning nynh thawcci o-ang lante</para>
  <para style="q2">bya a ho ze la zyn nan,</para>
  <para style="q1">pawccecize a thinlung kya</para>
  <para style="q2">anungsikuhpaw uccaw ccangsari a um;</para>
  <para style="q1">
    <verse number="26" style="v" />A thinlung kya umpaw</para>
  <para style="q2">huakunaw kha hynnaw te</para>
  <para style="q1">phang a thuruh zemah,</para>
  <para style="q2">a hoyleinaw tuh ccungccaw zapi kya</para>
  <para style="q2">alangkuh mamin cih.</para>
  <para style="q1">
    <verse number="27" style="v" />Hunghua a karouhpaw tuh</para>
  <para style="q2">tuh-e hunghua lungkhu lang a ccah cih,</para>
  <para style="q1">lung a toupaw tuh tuh-e lung nynh</para>
  <para style="q2">amaw kha a tou thin cih.</para>
  <para style="q1">
    <verse number="28" style="v" />A hynthyapaw lae nynh tuh</para>
  <para style="q2">amaw nynh vawsaw</para>
  <para style="q1">a pya hae paw kha a hua hae,</para>
  <para style="q2">pookunaw bya a hothyapaw</para>
  <para style="q1">khalang nynh ronaw kha a thuakhae.</para>
  <chapter number="27" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Awkhualan kong hanlan pookuh nan,</para>
  <para style="q2">pawccecize tuh-e nin nynh</para>
  <para style="q1">pawmou yn thuakhae cih cipaw</para>
  <para style="q2">na nyh khyh.<note caller="-" style="x"><char style="xo" closed="false">27.1: </char><char style="xt" closed="false"><ref loc="JAS 4:13-16">Jam 4.13-16</ref></char></note></para>
  <para style="q1">
    <verse number="2" style="v" />Namaw khalang te pooku leite</para>
  <para style="q2">milae nynh ae poo hae sah,</para>
  <para style="q1">namaw mung te pooku leite</para>
  <para style="q2">khycce hae nynh ae poo hae sah.</para>
  <para style="q1">
    <verse number="3" style="v" />Lung te laesia tuh ari hae,</para>
  <para style="q2">thuasalama mingaee nynh</para>
  <para style="q1">yn thuakhaepaw thinrianaw tuh</para>
  <para style="q2">tuh-e phuin ning hae laeze arihua.</para>
  <para style="q1">
    <verse number="4" style="v" />Bungpawnaw tuh</para>
  <para style="q2">rysawthyanaw thua zah,</para>
  <para style="q1">thinrianaw tuh lungmohnaw nynh thua,</para>
  <para style="q2">thuasalama eiungnaw tuh</para>
  <para style="q2">hum nynh mou a taening kho cih?</para>
  <para style="q1">
    <verse number="5" style="v" />Phe alangkuh lante</para>
  <para style="q2">a seinaw phypyate thuiheipaw tuh</para>
  <para style="q2">aphirute sungsahpaw laeze ahoyhua.</para>
  <para style="q1">
    <verse number="6" style="v" />Ruiban hoypaw nynh</para>
  <para style="q2">vaemaw ae muesah zemah,</para>
  <para style="q1">sungsahnaw phang ae hoi,</para>
  <para style="q2">thuasalama na rhawpaw nynh</para>
  <para style="q1">ae myngpaw kha tuh</para>
  <para style="q2">ae lingpaw nynh thua.</para>
  <para style="q1">
    <verse number="7" style="v" />A byn vae paw nynh tuh</para>
  <para style="q2">khoitui kha heize ry vae khyh,</para>
  <para style="q1">thuasalama a kanmawpaw hanlan tuh</para>
  <para style="q2">akhahpaw kha heize phe a e.</para>
  <para style="q1">
    <verse number="8" style="v" />A inn kyate a khiavuikuhpaw</para>
  <para style="q2">ccungccaw tuh</para>
  <para style="q1">a bu kyate a khiavuikuhpaw</para>
  <para style="q2">pavaw te nynh aloku.</para>
  <para style="q1">
    <verse number="9" style="v" />Zimuin te amynkhuhpaw nynh</para>
  <para style="q2">lung a tuasah,</para>
  <para style="q1">thuasalama vawsawnaw nynh tuh</para>
  <para style="q2">thinlung kha a koisah.</para>
  <para style="q1">
    <verse number="10" style="v" />Na ruiban thuasah,</para>
  <para style="q2">na paaw ruiban thuasah la vua nan;</para>
  <para style="q1">vawsaw na tung lyakhe</para>
  <para style="q2">na puizia inn lang la cceih nan;</para>
  <para style="q1">Anaenaw umpaw innpaw tuh</para>
  <para style="q2">asawnaw umpaw</para>
  <para style="q2">puizia laeze ahoyhua.</para>
  <para style="q1">
    <verse number="11" style="v" />Ka ccaaw, hawsakuh lah</para>
  <para style="q2">ka lung yn tuasah tua,</para>
  <para style="q1">tuhteze nynh yn theihrya hae paw kha</para>
  <para style="q2">bya ka khung kho cih hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Mihawpaw nynh tuh</para>
  <para style="q2">vawsawnaw kha muih zah</para>
  <para style="q1">a retawku; thuasalama tuanaw</para>
  <para style="q2">a zyapaw nynh tuh ccianua zah,</para>
  <para style="q2">tuh-e vawsawnaw tuh a teing.</para>
  <para style="q1">
    <verse number="13" style="v" />Nyku leipaw ccungccaw hanlan</para>
  <para style="q2">aamah a khanpakuhpaw kya-e</para>
  <para style="q1">boeining kha la lawkuh,</para>
  <para style="q2">Ramccang ccungccaw hanlan</para>
  <para style="q1">aamahkhan lante a ponpaw</para>
  <para style="q2">uccaw kha la kyngpah.</para>
  <para style="q1">
    <verse number="14" style="v" />Awkhua takaw te tho zah</para>
  <para style="q2">a innpaw kha roi myarya</para>
  <para style="q1">ccae lante hythua a pyapaw tuh,</para>
  <para style="q2">thyalawnaw a raetupaw lang</para>
  <para style="q1">ria athua cih.</para>
  <para style="q1">
    <verse number="15" style="v" />Accohkuh thyapaw zu tuh</para>
  <para style="q2">khuaane nin ze pharyphary</para>
  <para style="q2">po arahpaw khuaa te nynh aloku;</para>
  <para style="q1">
    <verse number="16" style="v" />tuh-e nopi kha phang kheepaw tuh</para>
  <para style="q2">khivae kheepaw te nynh aloku,</para>
  <para style="q1">tuhkhyhze ranglang kuihphe te</para>
  <para style="q2">chitui phang huupaw te nynh aloku.</para>
  <para style="q1">
    <verse number="17" style="v" />Sivaw nynh sivaw kha a hesah,</para>
  <para style="q2">ccungccaw nynh ccangpaw</para>
  <para style="q2">ccungccaw hawnaw kha a hesah.</para>
  <para style="q1">
    <verse number="18" style="v" />Thaeku ku kha a do-oihpaw tuh</para>
  <para style="q2">a thae kha a ae cih,</para>
  <para style="q1">a bawipaw kha a do-oihpaw tuh</para>
  <para style="q2">minhoynaw a mue cih.</para>
  <para style="q1">
    <verse number="19" style="v" />Tui lungkhu khe na maee</para>
  <para style="q2">na muihku hawte,</para>
  <para style="q1">pawcihawpaw ccungccaw mou</para>
  <para style="q2">athua cipaw kha</para>
  <para style="q2">a thinlung nynh a langsah.</para>
  <para style="q1">
    <verse number="20" style="v" />Michi khua te Abaddon ram tuh</para>
  <para style="q2">a lungryccing khyh hawte,</para>
  <para style="q1">ccungccaw mit tuh</para>
  <para style="q2">a lungryccing boi khyh.</para>
  <para style="q1">
    <verse number="21" style="v" />Sui te ngun tuh maee te</para>
  <para style="q2">syntawtua athua,</para>
  <para style="q1">tuhawte ccungccaw tuh</para>
  <para style="q2">thehoynaw a ccoupaw khate</para>
  <para style="q2">syntawtua athua.</para>
  <para style="q1">
    <verse number="22" style="v" />Mingaee kha looh ryte</para>
  <para style="q2">sung kyakhe sungkae te</para>
  <para style="q1">phongde athua zemah,</para>
  <para style="q2">a ngaeenaw tuh amaw kyate</para>
  <para style="q2">phiakuh lan khyh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" />Na tuuphu konglang kha</para>
  <para style="q2">hoyte nyh lah,</para>
  <para style="q1">na vaetua phu kha</para>
  <para style="q2">hoyte pekitua;</para>
  <para style="q1">
    <verse number="24" style="v" />pawccecize hoirumnaw tuh</para>
  <para style="q2">zungzae tyn khyh,</para>
  <para style="q1">siapharan lukhung mah</para>
  <para style="q2">she takyh hanlan tyn khyh.</para>
  <para style="q1">
    <verse number="25" style="v" />Lonua tuh zo zah</para>
  <para style="q2">kinno thawpaw yn ccue,</para>
  <para style="q1">te mua vawlan e lonua hae tuh</para>
  <para style="q2">suelua he athua te,</para>
  <para style="q1">
    <verse number="26" style="v" />tuutaw nynh na boeining kha</para>
  <para style="q2">ae rin cih zah, miaa hae nynh</para>
  <para style="q2">na laephi mee kha ae rin cih;</para>
  <para style="q1">
    <verse number="27" style="v" />na looh lang thuasah,</para>
  <para style="q2">na innbyn looh lang thuasah,</para>
  <para style="q1">te na seenung hae looh lang thuasah</para>
  <para style="q2">miaa mateitui tuh phe azaw cih.</para>
  <chapter number="28" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Ccungccaw hoyleipaw tuh</para>
  <para style="q2">hum nynh san a dee khyh zemah</para>
  <para style="q1">a ccue, thuasalama miding tuh</para>
  <para style="q2">chindeih hawte a rawthung.</para>
  <para style="q1">
    <verse number="2" style="v" />Ram kya doukunaw</para>
  <para style="q2">he a um vae ze uktu patae a langkuh.</para>
  <para style="q1">thuasalama ahawpaw</para>
  <para style="q2">uktu liate ram tuh atyn.</para>
  <para style="q1">
    <verse number="3" style="v" />Ryachi hae kha</para>
  <para style="q2">a tuaa a sah hae paw uktu tuh</para>
  <para style="q1">looh marya a rohpaw</para>
  <para style="q2">khuaaratui te nynh aloku.</para>
  <para style="q1">
    <verse number="4" style="v" />Upadi a zui leipaw nynh</para>
  <para style="q2">ccungccaw hoyleipaw kha</para>
  <para style="q1">the a hoysah, thuasalama</para>
  <para style="q2">upadi a zuipaw nynh tuh</para>
  <para style="q2">ccungccaw hoyleipaw kha a rawse.</para>
  <para style="q1">
    <verse number="5" style="v" />Ccungccaw hoyleipaw nynh</para>
  <para style="q2">byading kha thaethya khyh,</para>
  <para style="q1">thuasalama <char style="nd">Bawipaw </char></para>
  <para style="q2">a ccung hae paw nynh tuh</para>
  <para style="q1">byading kha phe ccing lan</para>
  <para style="q2">a thaethya hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Dingnaw laanpi a zuipaw</para>
  <para style="q2">ryachipaw tuh, a hoirum zemah</para>
  <para style="q2">a thyaruhpaw laeze ahoyhua.</para>
  <para style="q1">
    <verse number="7" style="v" />Phungbya a zuipaw tuh</para>
  <para style="q2">ahawpaw ccaaw nynh thua,</para>
  <para style="q1">a zu-ae hae paw ryte</para>
  <para style="q2">a mungkuh hae paw tuh</para>
  <para style="q1">a nung te a paaw kha</para>
  <para style="q2">maethya a law hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Ato pataepi lawkute a hoirumnaw</para>
  <para style="q2">a kaethung sakuhpaw tuh</para>
  <para style="q1">ryachi hae kha thaw a ccihpaw</para>
  <para style="q2">ccungccaw hanlan</para>
  <para style="q2">a ccakhungpahpaw nynh thua.</para>
  <para style="q1">
    <verse number="9" style="v" />Phungbya kha a ngae ry khyh zetuh,</para>
  <para style="q2">a sawsangnaw kha mah</para>
  <para style="q2">anungsikuhpaw nynh thua.</para>
  <para style="q1">
    <verse number="10" style="v" />Miding hae kha ahoy leipaw</para>
  <para style="q2">laanpi lang a cciakhaesei hae paw tuh</para>
  <para style="q1">amaw nynh a thaepaw</para>
  <para style="q2">hunghua lungkhu langkhe a ccah cih,</para>
  <para style="q1">thuasalama ccaenaw um lei hae paw tuh</para>
  <para style="q2">hoynaw kha rho lang a ccou cih hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Mihoipaw nynh tuh ka haw cite a tuaku,</para>
  <para style="q2">thuasalama a nyhthyapaw</para>
  <para style="q1">ryachipaw nynh tuh</para>
  <para style="q2">tuh-e paw kha akaw-aleih a ny.</para>
  <para style="q1">
    <verse number="12" style="v" />Miding hae nynh taenaw</para>
  <para style="q2">a mue hae ze, myarya lepaw</para>
  <para style="q1">phu-enaw a um, thuasalama</para>
  <para style="q2">ccungccaw hoylei</para>
  <para style="q1">hae paw nynh a hangku hae ze,</para>
  <para style="q2">ccungccaw hae nynh a retawku hae.</para>
  <para style="q1">
    <verse number="13" style="v" />A cyiseimenaw kha a pheipaw tuh</para>
  <para style="q2">a laan a sui ua lan khyh,</para>
  <para style="q1">thuasalama a seinaw kha phykuh zah</para>
  <para style="q2">a vuapaw tuh thawccinaw a mue cih.</para>
  <para style="q1">
    <verse number="14" style="v" />
    <char style="nd">Bawipaw </char> raw a rih</para>
  <para style="q2">zungzaepaw tuh lungtuapaw nynh thua,</para>
  <para style="q1">thuasalama a thinlung</para>
  <para style="q2">a khungsakuhpaw tuh vawsawnaw</para>
  <para style="q2">lungkhu lang a ccah cih.</para>
  <para style="q1">
    <verse number="15" style="v" />Ryachi hae kha a uktupaw</para>
  <para style="q2">bawi hoyleipaw tuh</para>
  <para style="q1">a siapaw chindeih khyhze</para>
  <para style="q2">a khiavuikuhpaw vong te nynh aloku.</para>
  <para style="q1">
    <verse number="16" style="v" />Nythyanaw a hoi leipaw</para>
  <para style="q2">uktu bawi tuh myaryamaw</para>
  <para style="q1">are-aropaw nynh thua;</para>
  <para style="q2">thuasalama ahme lei lante</para>
  <para style="q1">muenaw kha a huapaw tuh</para>
  <para style="q2">a hiinshe sae cih.</para>
  <para style="q1">
    <verse number="17" style="v" />Ccungccaw hiinnaw kha</para>
  <para style="q2">a tuaa a sahpaw tuh</para>
  <para style="q1">hunghua lungkhu lang cia a ccue cih,</para>
  <para style="q2">humhung nynh mah bawm nan sah.</para>
  <para style="q1">
    <verse number="18" style="v" />Dingnaw laanpi a zuipaw tuh a khyn cih,</para>
  <para style="q2">thuasalama ahme leipaw laanpi</para>
  <para style="q1">a zuipaw tuh hunghua</para>
  <para style="q2">lungkhu lang a ccah cih.</para>
  <para style="q1">
    <verse number="19" style="v" />Loo a phokuhpaw tuh</para>
  <para style="q2">looh patae a hoi cih,</para>
  <para style="q1">thuasalama accakaepaw kha</para>
  <para style="q2">a deehuipaw tuh a ryachi myarya ccih cih.</para>
  <para style="q1">
    <verse number="20" style="v" />A lungzipaw ccungccaw tuh</para>
  <para style="q2">hythuanaw patae a mue cih,</para>
  <para style="q1">thuasalama arangte hoirum</para>
  <para style="q2">a rypaw tuh detahnaw</para>
  <para style="q2">mue leite um lan khyh.</para>
  <para style="q1">
    <verse number="21" style="v" />Mirymihua tuanaw tuh hoy khyh—</para>
  <para style="q2">tuhzemah ccungccaw tuh</para>
  <para style="q1">sanlou phe kheit hanlan</para>
  <para style="q2">hoyleinaw kha a rae kho.</para>
  <para style="q1">
    <verse number="22" style="v" />A karankuhpaw tuh</para>
  <para style="q2">hoirum khylan rangsakuh zah,</para>
  <para style="q1">ryachinaw nynh</para>
  <para style="q2">a thuanua lanpaw kha nyh khyh.</para>
  <para style="q1">
    <verse number="23" style="v" />A lae te ccungccaw</para>
  <para style="q2">a poothyapaw laeze,</para>
  <para style="q1">a seinaw phypyate a pepaw</para>
  <para style="q2">ccungccaw tuh nyalangte</para>
  <para style="q2">maehoynaw kha houh a mue cih.</para>
  <para style="q1">
    <verse number="24" style="v" />“Seinaw thua khyh,”</para>
  <para style="q2">cite a nung khyhze a paaw kha</para>
  <para style="q1">uccaw hankhakheit a luadepaw tuh</para>
  <para style="q2">damiahpaw te a mungkuh</para>
  <para style="q2">hae paw nynh thua.</para>
  <para style="q1">
    <verse number="25" style="v" />A karankuhpaw nynh</para>
  <para style="q2">pekunaw kha a puisah,</para>
  <para style="q1">thuasalama <char style="nd">Bawipaw </char></para>
  <para style="q2">a doliakuhpaw tuh a hoirum cih.</para>
  <para style="q1">
    <verse number="26" style="v" />Amaw tuanaw kha</para>
  <para style="q2">a doliakuhpaw tuh</para>
  <para style="q1">mingaee nynh thua;</para>
  <para style="q2">thuasalama hawnaw laanpi</para>
  <para style="q2">a zuipaw tuh a khyn cih.</para>
  <para style="q1">
    <verse number="27" style="v" />Ryachi hae kha a pyapaw tuh</para>
  <para style="q2">ahobounaw um lan khyh,</para>
  <para style="q1">thuasalama a mit a masipaw tuh</para>
  <para style="q2">thyalawnaw patae a mue cih.</para>
  <para style="q1">
    <verse number="28" style="v" />Ccungccaw hoylei hae paw nynh</para>
  <para style="q2">a hangku hae ze ccungccaw hae nynh</para>
  <para style="q1">a retawku hae; thuasalama</para>
  <para style="q2">minmin he a ro vae hae ze,</para>
  <para style="q1">miding hae tuh a hangkuh thung hae.</para>
  <chapter number="29" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Atu te atu thuihei zemah</para>
  <para style="q2">palei a lungkhung mamin paw tuh</para>
  <para style="q2">dan kho leite vaekheitmawte a roh cih.</para>
  <para style="q1">
    <verse number="2" style="v" />Miding hae nynh kawhoinaw kya</para>
  <para style="q2">he a um hae te, ccungccaw hae tuh</para>
  <para style="q1">mih lungtua; thuasalama</para>
  <para style="q2">ccungccaw hoyleipaw nynh he a uk te,</para>
  <para style="q2">ccungccaw hae tuh a hawkhaekuh hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Hawnaw a rypaw ccaaw nynh</para>
  <para style="q2">nungpaaw lung a tuasah,</para>
  <para style="q1">thuasalama ohhuanung hae ryte</para>
  <para style="q2">a mungkuh hae paw tuh</para>
  <para style="q2">hoirumnaw kha a zosah han.</para>
  <para style="q1">
    <verse number="4" style="v" />Siapharan nynh dingnaw liate</para>
  <para style="q2">ram kha a tynsah,</para>
  <para style="q1">thuasalama pyaruh patae</para>
  <para style="q2">a lawkuhpaw nynh tuh ram kha a ro.</para>
  <para style="q1">
    <verse number="5" style="v" />A innpaw kha a poopaw tuh</para>
  <para style="q2">a innpaw ccu kaangkae sah khylan</para>
  <para style="q2">mia kha a rawkhaw vae.</para>
  <para style="q1">
    <verse number="6" style="v" />Ccungccaw hoyleipaw</para>
  <para style="q2">a seinaw kyakhe kaang a um,</para>
  <para style="q1">thuasalama miding tuh</para>
  <para style="q2">lungtuate hlaw a sah.</para>
  <para style="q1">
    <verse number="7" style="v" />Miding nynh tuh ryachipaw</para>
  <para style="q2">dingnaw kha phe a ny;</para>
  <para style="q1">ccungccaw hoyleipaw nynh tuh</para>
  <para style="q2">tuhcihawpaw kha nyhthya khyh.</para>
  <para style="q1">
    <verse number="8" style="v" />Sarya a mang hae paw nynh</para>
  <para style="q2">khuapi kha maee a soi hae,</para>
  <para style="q1">thuasalama mihawpaw nynh tuh</para>
  <para style="q2">thinrianaw kha a daesah.</para>
  <para style="q1">
    <verse number="9" style="v" />Mihawpaw nynh mingaeepaw kha</para>
  <para style="q2">a kaethe lanze, mingaeepaw nynh</para>
  <para style="q1">a hu a raw zemah thuasah,</para>
  <para style="q2">a nuinse zemah thuasah</para>
  <para style="q2">daenaw umlae lan khyh.</para>
  <para style="q1">
    <verse number="10" style="v" />Ccungccaw a theih hae paw nynh tuh</para>
  <para style="q2">ccaenaw a hoi leipaw kha a hua hae,</para>
  <para style="q1">te miding hae nynh tuh tuh-e paw</para>
  <para style="q2">a hiinnaw kha a thungkhaw hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Mingaee nynh tuh</para>
  <para style="q2">a thinrianaw balyn kha a langsaku,</para>
  <para style="q1">thuasalama mihawpaw nynh tuh</para>
  <para style="q2">daebabi lan um zah a yhku.</para>
  <para style="q1">
    <verse number="12" style="v" />Uktu nynh hynbya kha a ngae zetuh,</para>
  <para style="q2">a kuihkaw e bawi hae balyn tuh</para>
  <para style="q1">ccungccaw hoyleipaw lang</para>
  <para style="q2">a tang cih hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Ryachipaw te amaw kha</para>
  <para style="q2">a tuaa a sahtupaw nynh</para>
  <para style="q1">a lokunaw hae tuh:</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh minmin</para>
  <para style="q2">parouh mawte mit awnaw a pya hae.</para>
  <para style="q1">
    <verse number="14" style="v" />Siapharan nynh ryachi hae kha</para>
  <para style="q2">laesah leite bya a pia hae zetuh,</para>
  <para style="q2">a bawi haungnaw tuh zungzae atyn cih.</para>
  <para style="q1">
    <verse number="15" style="v" />Ccungngue te zianaw nynh thuasah,</para>
  <para style="q2">bya te thuiheinaw nynh thuasah</para>
  <para style="q1">hawnaw kha a pya,</para>
  <para style="q2">thuasalama a rythyte umsahpaw</para>
  <para style="q1">imua nynh tuh a nung kha</para>
  <para style="q2">maethya a law.</para>
  <para style="q1">
    <verse number="16" style="v" />Ccungccaw hoyleipaw nynh</para>
  <para style="q2">kawhoinaw kya a um ze</para>
  <para style="q1">seinaw alungthung,</para>
  <para style="q2">thuasalama miding hae nynh tuh</para>
  <para style="q2">mimaw ronaw kha a muihku hae.</para>
  <para style="q1">
    <verse number="17" style="v" />Na ccaaw kha thuihei lah,</para>
  <para style="q2">ngaengannaw ae pya cih;</para>
  <para style="q2">na lung ae tuasah cih.</para>
  <para style="q1">
    <verse number="18" style="v" />Vizin a um leinaw kya tuh</para>
  <para style="q2">ccungccaw hae a roh hae,</para>
  <para style="q1">thuasalama phungbya</para>
  <para style="q2">a zui hae paw tuh</para>
  <para style="q2">lungtuapaw nynh athua hae.</para>
  <para style="q1">
    <verse number="19" style="v" />Bya kyalya te see kha</para>
  <para style="q2">thuihei kho thua khyh,</para>
  <para style="q1">pawccecize a thaethya zemah</para>
  <para style="q2">pawlangria lan khyh.</para>
  <para style="q1">
    <verse number="20" style="v" />Tuaku ty leite rangsakute</para>
  <para style="q2">bya a hopaw na muih tou?</para>
  <para style="q1">Tuhcihawpaw lukhakheit hanlan laeze</para>
  <para style="q2">mingaeepaw hanlan</para>
  <para style="q2">ngaehoinaw a umhua.</para>
  <para style="q1">
    <verse number="21" style="v" />See kha a ditaraw lyate</para>
  <para style="q2">a rythyte umsah lan zetuh,</para>
  <para style="q1">nyathyakou tuh</para>
  <para style="q2">ahoy leipaw lang a tang cih.</para>
  <para style="q1">
    <verse number="22" style="v" />A thinriapaw ccungccaw nynh</para>
  <para style="q2">pekunaw kha a puisah,</para>
  <para style="q1">a thindynpaw nynh</para>
  <para style="q2">seinaw patae a thuakhae.</para>
  <para style="q1">
    <verse number="23" style="v" />Ccungccaw tuh a lysahkunaw nynh</para>
  <para style="q2">amaw kha a nyaasah,</para>
  <para style="q1">thuasalama a thinlung</para>
  <para style="q2">zakaw a sangsakuhpaw tuh</para>
  <para style="q2">sawtuanaw a mue cih.</para>
  <para style="q1">
    <verse number="24" style="v" />Miruh te a mungkuh hae paw tuh</para>
  <para style="q2">a hiinnaw a huakuhpaw nynh thua;</para>
  <para style="q1">thyalawkunaw a rae zemah</para>
  <para style="q2">akyhpaw kha langsakuh lae khyh.</para>
  <para style="q1">
    <verse number="25" style="v" />Ccungccaw raw a rihpaw tuh</para>
  <para style="q2">kaang a syakhawkuhpaw nynh thua,</para>
  <para style="q1">thuasalama <char style="nd">Bawipaw </char></para>
  <para style="q2">a doliakuhpaw tuh a khyn cih.</para>
  <para style="q1">
    <verse number="26" style="v" />Ccungccaw patae nynh</para>
  <para style="q2">uktu kya-e maehoynaw kha</para>
  <para style="q1">a ccungku hae, thuasalama</para>
  <para style="q2">ccungccaw nynh byading kha</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kyate rou nynh a mue.</para>
  <para style="q1">
    <verse number="27" style="v" />Miding hae nynh a ding</para>
  <para style="q2">leipaw kha a hua hae,</para>
  <para style="q1">Ccungccaw hoyleipaw nynh</para>
  <para style="q2">midingpaw kha a hua.</para>
  <para style="b" />
  <chapter number="30" style="c" />
  <para style="s1">Agur Bya</para>
  <para style="p">
    <verse number="1" style="v" />Jakeh ccapaw Agur bya:</para>
  <para style="q1">Ccungccapaw nynh hynhte a ho:</para>
  <para style="q2">Pou Pachia, ka ria myarya thae,</para>
  <para style="q1">Pou Pachia, ka ria myarya thae.</para>
  <para style="q2">Pawtemou ka tae cih?</para>
  <para style="q1">
    <verse number="2" style="v" />Thanccingte, myaryamaw</para>
  <para style="q2">ka ngaee zah ccungccaw ka lo khyh;</para>
  <para style="q1">ccungccaw kya-e</para>
  <para style="q2">nythyanaw ka hoi khyh.</para>
  <para style="q1">
    <verse number="3" style="v" />Hawnaw kha ka ccangkuh khyh,</para>
  <para style="q2">Athyaapaw kya-e nynaw kha</para>
  <para style="q2">ka hoi khyh.</para>
  <para style="q1">
    <verse number="4" style="v" />Hummou vaawlang kae zah</para>
  <para style="q2">yn rungbung?</para>
  <para style="q1">Hummou a kuih te khivae a huh?</para>
  <para style="q2">Hummou boeining te tui a tung?</para>
  <para style="q1">Hummou laephi</para>
  <para style="q2">athangnaw balyn kha a tynsah?</para>
  <para style="q1">Tuh-e ccungccapaw min tuh hummou?</para>
  <para style="q2">A ccaaw min so hummou?</para>
  <para style="q1">Na nyh ccaccing khaw!</para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" />Pachia bya miakaw tuh akyh;</para>
  <para style="q2">amaw kya a rekuh hae paw hanlan</para>
  <para style="q2">aning tuh khawriaphua nynh thua.</para>
  <para style="q1">
    <verse number="6" style="v" />A bya kyakhe biachih nan,</para>
  <para style="q2">tuhkhyhze tuh ae pe cih zah</para>
  <para style="q1">mihynpaw na thuanaw kha</para>
  <para style="q2">a langsakuh cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" />Uccaw ccangning ngiaku kae ry;</para>
  <para style="q2">tuh-e hae tuh ka chi maw</para>
  <para style="q2">pya leite yn um nan:</para>
  <para style="q1">
    <verse number="8" style="v" />Hynbya ho te lingpaw bya hynh</para>
  <para style="q2">ka kyate asawnaw lang yn nuepah;</para>
  <para style="q1">ryachinaw kha yn pya nan lah,</para>
  <para style="q2">hoirumnaw kha mah yn pya nan;</para>
  <para style="q2">ka hanlan ahopaw looh khate yn dang,</para>
  <para style="q1">
    <verse number="9" style="v" />tuhkhyhze tuh phe beih lan ka hoi lanze,</para>
  <para style="q2">nang kha kae vuasei cih zah,</para>
  <para style="q1">“<char style="nd">Bawipaw </char> tuh hummou thua?”</para>
  <para style="q2">cite ka hosei cih,</para>
  <para style="q1">ka ryachi lanze ka ruhsei cih zah</para>
  <para style="q2">ka Pachia min kha</para>
  <para style="q2">the ka thyasahsei cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" />A bawipaw kyakhe</para>
  <para style="q2">a seepaw thethya la ho nan,</para>
  <para style="q1">tuhkhyhze tuh tuh-e seepaw nynh</para>
  <para style="q2">thya ae law cih zah</para>
  <para style="q2">seinaw mee na teingsei cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" />Mih paaw hae kha thyalaw hae zah</para>
  <para style="q2">mih nung hae kha</para>
  <para style="q2">hythua a pya lei hae paw a um hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Mimaw mitmuihnaw kya</para>
  <para style="q2">a thyaa hae zemah</para>
  <para style="q2">mih nungsikunaw</para>
  <para style="q2">athyaa lei hae paw a um hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Lysakunaw mitdae te a angthung</para>
  <para style="q2">hae paw mah a um hae,</para>
  <para style="q1">
    <verse number="14" style="v" />Ryachi hae kha laephi kyate</para>
  <para style="q2">po due khylan te ahobou hae paw kha</para>
  <para style="q2">ccungccaw hae kyate</para>
  <para style="q1">po due khylan, thaloi te</para>
  <para style="q2">alokuhpaw haw hoi zah</para>
  <para style="q1">ccezung te alokuhpaw haw</para>
  <para style="q2">a hoipaw ccungccaw a um hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" />Saeveih nynh a taw nopi</para>
  <para style="q2">sa ning a hoi; tuh-e hae nynh,</para>
  <para style="q2">“Oun pya, Oun pya,” cite a sia hae.</para>
  <para style="q1">Mih rynaw accing leipaw</para>
  <para style="q2">phuin thum a um hae;</para>
  <para style="q1">“Azaw vae,” cite a ho boi leipaw</para>
  <para style="q2">phuin pali a um hae,</para>
  <para style="q1">
    <verse number="16" style="v" />tuh-e hae tuh: michi khua Sheol, te</para>
  <para style="q2">atinpaw nopi vuebua,</para>
  <para style="q1">tui a byn leipaw laephi,</para>
  <para style="q2">“Azaw vae,” cite a ho</para>
  <para style="q2">boi leipaw maee nynh thua hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" />A paaw kha sarya zah</para>
  <para style="q2">a nung bya kha ngae leite</para>
  <para style="q1">pawlang a ria leipaw tuh</para>
  <para style="q2">accya kya umpaw va-aw hae nynh</para>
  <para style="q1">a mit kha a khoi cih hae zah</para>
  <para style="q2">lantaw hae nynh a ae cih hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" />Myaryamaw ka ngaeangthuapaw</para>
  <para style="q2">uccaw phuin thum a um;</para>
  <para style="q2">ka thaethya leipaw uccaw phuin pali tuh:</para>
  <para style="q1">
    <verse number="19" style="v" />vaawlui kya a zoupaw mosipi laanpi,</para>
  <para style="q2">lung vawlan a vawpaw hupaw laanpi,</para>
  <para style="q1">rili vawlan a cceihpaw sanphalung laanpi,</para>
  <para style="q2">te liaccanung ryte</para>
  <para style="q1">a cceihkheih hae paw pisepaw</para>
  <para style="q2">laanpi nynh thua hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" />A ohhuakuhpaw zu laanpi tuh</para>
  <para style="q2">hynhte nynh thua:</para>
  <para style="q1">ae zah a mung a hukuh koute,</para>
  <para style="q2">“Hoyleinaw ka rae khyh,” a ci.</para>
  <para style="q1">
    <verse number="21" style="v" />Laephi a thyngsakuhpaw</para>
  <para style="q2">uccaw phuin thum a um;</para>
  <para style="q1">laephi nynh a teing kho</para>
  <para style="q2">leipaw uccaw phuin pali tuh:</para>
  <para style="q1">
    <verse number="22" style="v" />siapharan lang a tangpaw see,</para>
  <para style="q2">aepaw phe a bynpaw mingaee,</para>
  <para style="q1">
    <verse number="23" style="v" />a vawpaw sungsahnaw</para>
  <para style="q2">a mue leipaw nopinung te</para>
  <para style="q1">a bawinung rho a ccoupaw</para>
  <para style="q2">ryalahtunung kha nynh thua hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" />Laephi vawlan adihpaw uccaw</para>
  <para style="q2">phuin pali a um,</para>
  <para style="q1">thuasalama tuh-e hae tuh</para>
  <para style="q2">myaryamaw a haw hae,</para>
  <para style="q1">
    <verse number="25" style="v" />tuh-e hae tuh: thawzung</para>
  <para style="q2">a hoi khyh hae zemah,</para>
  <para style="q1">hawnin ccyh kya mih looh</para>
  <para style="q2">a ccakhungkuh hae paw lungkhi hae,</para>
  <para style="q1">
    <verse number="26" style="v" />mih thawsae khyh zemah lung kya</para>
  <para style="q2">bu a raekuh hae paw saveih hae,</para>
  <para style="q1">
    <verse number="27" style="v" />siapharan a hoi khyh hae zemah</para>
  <para style="q2">mih balyn te ataruinte</para>
  <para style="q2">a nuekuh hae paw tungkhipaw hae,</para>
  <para style="q1">
    <verse number="28" style="v" />kuih te kyng kho athua zemah,</para>
  <para style="q2">siapharan inn kya</para>
  <para style="q1">muih athuapaw laedia nynh thua hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" />Mih laanccia apuithyapaw</para>
  <para style="q2">uccaw phuin thum a um;</para>
  <para style="q1">mih cciazia dopaw-umpaw</para>
  <para style="q2">phuin pali tuh:</para>
  <para style="q1">
    <verse number="30" style="v" />ramsaw kyaze athung huaccepaw</para>
  <para style="q2">thua zah pawpaw mah a kitaw</para>
  <para style="q2">leipaw chindeih,</para>
  <para style="q1">
    <verse number="31" style="v" />tangkarae lan a cceihpaw</para>
  <para style="q2">awkhungpaw, miaatepaw te</para>
  <para style="q1">a ccungccaw hae malang</para>
  <para style="q2">a cceihpaw siapharan nynh thua hae.</para>
  <para style="q1">
    <verse number="32" style="v" />Namaw te namaw kha</para>
  <para style="q2">pookute ngaeepaw rya kha</para>
  <para style="q2">na law ze thuasah,</para>
  <para style="q1">ahoy leipaw kha na tua ze thuasah</para>
  <para style="q2">na kuih khate na khalang kha</para>
  <para style="q2">phang huhkuh.</para>
  <para style="q1">
    <verse number="33" style="v" />Pawccecize samateitui kha</para>
  <para style="q2">palei hualeih lanze thawpah amuekuh,</para>
  <para style="q1">naduh kha me lanze chii apou,</para>
  <para style="q2">tuhawte thinrianaw kha</para>
  <para style="q1">palei tua lanze pekunaw apui.</para>
  <para style="b" />
  <chapter number="31" style="c" />
  <para style="s1">Siapharan Lemuel Nung nynh Ccangpyanaw</para>
  <para style="p">
    <verse number="1" style="v" />Siapharan Lemuel kalan</para>
  <para style="q2">a nung nynh a ccangpyapaw</para>
  <para style="q2">bya hae tuh hynhte nynh thua:</para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" />Nang tuh ka sungsahpaw ka ccapaw,</para>
  <para style="q2">ka sawsangnaw liate ka muepaw</para>
  <para style="q1">ka ccapaw nynh na thua,</para>
  <para style="q2">paw bya mou kae hopah cih?</para>
  <para style="q1">
    <verse number="3" style="v" />Na thawzung kha nopi hae kalan pya nan,</para>
  <para style="q2">siapharan a rohtu hae paw kalan khe</para>
  <para style="q1">na thawzung te na hoirumnaw kha</para>
  <para style="q2">la pya nan hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Pou Lemuel, e hynh</para>
  <para style="q2">siapharan hae elang thua khyh,</para>
  <para style="q1">siapharan nynh misutui kha</para>
  <para style="q2">nia lanpaw thua khyh,</para>
  <para style="q1">uktu bawi hae nynh ruithyapaw kha</para>
  <para style="q2">ry lanpaw thua khyh;</para>
  <para style="q1">
    <verse number="5" style="v" />Minmin nynh a nia hae ze</para>
  <para style="q2">phunglang kha phe ning hae zah,</para>
  <para style="q1">vawsawnaw a tung hae paw nynh</para>
  <para style="q2">a mue lan hae paw kha</para>
  <para style="q2">nypahthya vae khyh hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Vyavya chihpaw ccungccaw kha</para>
  <para style="q2">ruithyapaw pya oh lah,</para>
  <para style="q1">a lungriathaepaw ccungccaw kha</para>
  <para style="q2">misutui pya oh;</para>
  <para style="q1">
    <verse number="7" style="v" />minmin nynh neih hae sah lah,</para>
  <para style="q2">mih vawsawnaw kha ning hae sah,</para>
  <para style="q1">te mih lungriathaenaw kha</para>
  <para style="q2">liathui nan vae hae sah.</para>
  <para style="q1">
    <verse number="8" style="v" />Mimaw hanlan a hokuh</para>
  <para style="q2">kho lei hae paw elang hopah bua hae,</para>
  <para style="q1">inn lei loo lei aerua hoi lei</para>
  <para style="q2">hae paw balyn nynh mue lan</para>
  <para style="q2">a ccan hae paw kha la hokhae hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Minmin hanlan hopah bua hae lah,</para>
  <para style="q2">ahmete byapia hae,</para>
  <para style="q1">ryachi hae te ahobou hae paw nynh</para>
  <para style="q2">a mue lan hae paw kha hokhae hae.</para>
  <para style="b" />
  <para style="s1">Nopi Hoypaw Thehoysahnaw</para>
  <para style="q1">
    <verse number="10" style="v" />Zu hoypaw kha hummou</para>
  <para style="q2">a mue kho cih?</para>
  <para style="q1">Aning tuh aphutepaw</para>
  <para style="q2">lung laeze aphutehua.</para>
  <para style="q1">
    <verse number="11" style="v" />A vawpaw nynh tuh-e a zu tuh a zyn,</para>
  <para style="q2">te a vawpaw tuh a ryachi boi lan khyh.</para>
  <para style="q1">
    <verse number="12" style="v" />Tuh-e zu nynh a hiin lungkhu balyn</para>
  <para style="q2">a vawpaw tungvaw hoynaw rae zah,</para>
  <para style="q2">vawsawnaw pya khyh.</para>
  <para style="q1">
    <verse number="13" style="v" />Aning nynh tuuming te</para>
  <para style="q2">laphan kha ccung zah,</para>
  <para style="q2">lungthote a kuih te rya a law.</para>
  <para style="q1">
    <verse number="14" style="v" />Aning tuh kungkunawpaw</para>
  <para style="q2">sanphalung te nynh aloku,</para>
  <para style="q2">looh kha asawnaw langte yn thuakhae.</para>
  <para style="q1">
    <verse number="15" style="v" />Khua adae mawte tho zah</para>
  <para style="q2">a innbyn hae elang</para>
  <para style="q1">aepaw kha a paccynpya hae,</para>
  <para style="q2">te ryalawpahtu nopi hae kha</para>
  <para style="q2">ryalaw a nee hae.</para>
  <para style="q1">
    <verse number="16" style="v" />Hoyte tuase zah loo kha a re;</para>
  <para style="q2">a kuih te a muepaw phua khate</para>
  <para style="q2">misu khokhu kha a rae.</para>
  <para style="q1">
    <verse number="17" style="v" />Aning tuh ryalaw a zuakuhpaw,</para>
  <para style="q2">a thungpaw, te ryalaw</para>
  <para style="q2">a phihpaw nynh thua.</para>
  <para style="q1">
    <verse number="18" style="v" />A ryalawnaw tuh athane cipaw nyh zah,</para>
  <para style="q2">khuazi ccyh kya a maeekhua tuh</para>
  <para style="q2">chih boi khyh.</para>
  <para style="q1">
    <verse number="19" style="v" />Aning nynh a kuih te laaw kha sukuh zah</para>
  <para style="q2">boei a kua.</para>
  <para style="q1">
    <verse number="20" style="v" />Ryachi hae hanlan a lung-ua zah,</para>
  <para style="q2">ahobou hae paw hanlan</para>
  <para style="q2">a kuih kha a dyng.</para>
  <para style="q1">
    <verse number="21" style="v" />Vuiraw a ccaw lya mah</para>
  <para style="q2">a innbyn hae elang rih khyh,</para>
  <para style="q1">pawccecize a innbyn hae tuh</para>
  <para style="q2">khualungpaw boeining a hoi hae.</para>
  <para style="q1">
    <verse number="22" style="v" />Amaw ccaccei nynh boei kha a kua;</para>
  <para style="q2">a boeining tuh nebaleihpaw laaw te</para>
  <para style="q1">kuakuhpaw te sehahyhpaw</para>
  <para style="q2">boeining nynh thua.</para>
  <para style="q1">
    <verse number="23" style="v" />A vawpaw tuh ram lungkhu e</para>
  <para style="q2">piccan hae laku haungbua zah,</para>
  <para style="q1">khua koikua hae kyaze</para>
  <para style="q2">nypaw ccungccaw nynh thua.</para>
  <para style="q1">
    <verse number="24" style="v" />Aning nynh nebaleihpaw laaw te</para>
  <para style="q2">kuapaw boeining kha kua zah leih a zua;</para>
  <para style="q1">taeccia kha rae zah kungku hae kalan</para>
  <para style="q2">leih a zuapya hae.</para>
  <para style="q1">
    <verse number="25" style="v" />Thawzung te sawtuanaw tuh</para>
  <para style="q2">a boeining thua zah,</para>
  <para style="q2">yn thua cih paw ccyh kya a lungtua cih.</para>
  <para style="q1">
    <verse number="26" style="v" />Aning nynh hawnaw bya kha ho zah,</para>
  <para style="q2">a lae nynh thawccinaw kong kha</para>
  <para style="q2">a ccangpya.</para>
  <para style="q1">
    <verse number="27" style="v" />A innbyn hae umtu ziazae kha</para>
  <para style="q2">hoyte do zah, thawnawnawpaw</para>
  <para style="q2">looh kha ae khyh.</para>
  <para style="q1">
    <verse number="28" style="v" />A ccaaw hae nynh</para>
  <para style="q2">hythua nung cite ko hae zah;</para>
  <para style="q2">a vawpaw nynh mah thehoysah zah,</para>
  <para style="q1">
    <verse number="29" style="v" />“Nopi patae nynh</para>
  <para style="q2">kou hoy lan a cyi vae hae,</para>
  <para style="q1">thuasalama nang tuh</para>
  <para style="q2">minmin balyn laeze myaryamaw</para>
  <para style="q2">na hoyhua,” a ci.</para>
  <para style="q1">
    <verse number="30" style="v" />Ccungccaw lunglawnaw nynh</para>
  <para style="q2">ccungccaw kha a lingthya,</para>
  <para style="q1">puithyanaw tuh accakaepaw nynh thua,</para>
  <para style="q2">thuasalama <char style="nd">Bawipaw </char> raw a rihpaw</para>
  <para style="q2">nopi tuh thehoysah athua cih.</para>
  <para style="q1">
    <verse number="31" style="v" />A kuih te a cyipaw balyn hanlan</para>
  <para style="q2">amaw kha thehoysah oh,</para>
  <para style="q1">a ryalawnaw nynh amaw kha</para>
  <para style="q2">khua koikua hae kyakhe</para>
  <para style="q1">thehoysah sah.</para>
</usx>