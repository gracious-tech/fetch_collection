<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="LAM" style="id">Baebu Thyaa</book>
  <para style="h">RAWNAW HLAW</para>
  <para style="toc1">Lamentations</para>
  <para style="toc2">RAWNAW HLAW</para>
  <para style="toc3">Raw</para>
  <para style="mt1">RAWNAW HLAW</para>
  <para style="mt2">Lamentations</para>
  <para style="imt">Byalaanmaw</para>
  <para style="ip">Rawnaw Hlaw hynh BC 586 kum kya Jerusalem aro keiccuze a rawnaw hae paw byarui ccangpangaw kha a ccakhung hae paw nynh thua. E ccauh lungkhu alunghua tuh ngaethyanaw te rawnaw kong kyalya a um zemah Pachia doliakunaw te malang hanlan ngaehoinaw a um cipaw kha mah a langsah. Judah hae nynh BC 586 kum lyaze a tung hae paw minphuin pynpi ronaw kha liathui nawlan kum takyh looh-aesung te rawkhuinaw leih a rae nin hae kya a beik lya hae khe hynh-e byarui hae hynh a mang hae.</para>
  <para style="iot">Abyalupi hae</para>
  <para style="io1">Jerusalem a ngaethyanaw 1.1-22</para>
  <para style="io1">Jerusalem kha detahnaw 2.1-22</para>
  <para style="io1">Detahnaw te ngaehoinaw 3.1-66</para>
  <para style="io1">Jerusalem aroh 4.1-22</para>
  <para style="io1">Ngaethyaumsah nawlan sawsangnaw 5.1-22</para>
  <chapter number="1" style="c" />
  <para style="s1">Ccungccaw Adaepaw Khuapi</para>
  <para style="p">
    <verse number="1" style="v" />Vaekheih lyaze ccungccaw</para>
  <para style="q2">phe abeihpaw khuapi tuh</para>
  <para style="q1">a makhaete kharouh um vae rei!</para>
  <para style="q2">Minphuin hae lakuze alesaenung tuh</para>
  <para style="q1">nomaenung hawte phe thua vae rei!</para>
  <para style="q2">Ram hae kyaze ram uktunung</para>
  <para style="q1">a la thuapaw aning tuh</para>
  <para style="q2">see lang nynh a tang vae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" />Khuazi khe thawte rah zah</para>
  <para style="q2">a byaki kya a mitphi alua;</para>
  <para style="q1">amaw a sungsah hae paw</para>
  <para style="q2">balyn laku kya lungtangnaw</para>
  <para style="q1">a pyatu lu kheit san um khyh,</para>
  <para style="q2">a ruiban hae balyn tuh</para>
  <para style="q1">a tungvaw lungzinaw hoi leite,</para>
  <para style="q2">a rhaw hae lang nynh a tang vae hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" />Judah tuh ramccang lang</para>
  <para style="q2">sue thua zah, vawsawnaw te</para>
  <para style="q1">myarya ccihpaw seetangnaw kha</para>
  <para style="q2">a teing;</para>
  <para style="q1">minphuin hae laku khe khuasah zah,</para>
  <para style="q2">haeungnaw hmin muihkuh khyh;</para>
  <para style="q1">a lungriathae lyakhe</para>
  <para style="q2">a deehuitu hae balyn nynh a phya hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" />Poi kalan a cceihpaw</para>
  <para style="q2">lu kheit san a um khyh keiccuze</para>
  <para style="q1">Zion lang ccianaw laanpi tuh</para>
  <para style="q2">a rah a khui; a koikua balyn tuh</para>
  <para style="q1">ccungccaw phe adae,</para>
  <para style="q2">a ranpibawi hae tuh rawkhuite a um hae;</para>
  <para style="q1">a liaccaw hae tuh mih ngaethah,</para>
  <para style="q2">amaw mah myarya a thinlungccih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" />Aning te a rhawkuh hae paw tuh</para>
  <para style="q2">bawi lang tang hae zah,</para>
  <para style="q1">a rhaw hae tuh hoynaw a mue hae,</para>
  <para style="q2">pawccecize a cyiseimenaw alung keiccuze</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh aning kha de a tah;</para>
  <para style="q2">rhaw hae nynh a ccaaw hae kha</para>
  <para style="q1">kyng hae zah ccaring a cciakhae hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" />Ccanung Zion a lesaenaw balyn tuh</para>
  <para style="q2">azo vae.</para>
  <para style="q1">Jerusalem e bawi hae tuh</para>
  <para style="q2">rampaeenaw a muihkuh leipaw</para>
  <para style="q1">sazuh hae hawte nynh athua vae hae;</para>
  <para style="q2">minmin a deehuitu hae malang khe</para>
  <para style="q1">thawzung hoi leite a ccue hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" />Jerusalem nynh a riathae ccyh lyate</para>
  <para style="q2">a khiavuiku lyakhe</para>
  <para style="q1">langmawlya a la hoipaw</para>
  <para style="q2">aphutepaw uccaw balyn kha a liathui.</para>
  <para style="q1">A ccungccaw hae tuh</para>
  <para style="q2">rhaw hae kuih kya thua hae zah</para>
  <para style="q1">bawmtu lu kheit sanmah</para>
  <para style="q2">he a um khyh tuh,</para>
  <para style="q1">a rhaw hae nynh do hae zah</para>
  <para style="q2">a ccawbungpaw kha a nuinse hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" />Jerusalem tuh myarya a sei keiccuze</para>
  <para style="q2">nuinsepaw lang a tang vae;</para>
  <para style="q1">a tungvaw saw a la tua hae paw balyn nynh</para>
  <para style="q2">a sasete a umpaw kha</para>
  <para style="q1">a muih hae keiccuze</para>
  <para style="q2">a dothatheih vae hae;</para>
  <para style="q1">amaw mah rawkhuite um zah</para>
  <para style="q2">ccungccaw kha do ngan vae khyh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" />A boeipae kya athupaw abekuh;</para>
  <para style="q2">a malang ccyh kha tua khyh;</para>
  <para style="q1">a khuliakunaw tuh ri lan a um,</para>
  <para style="q2">lungtangnaw a pya lanpaw</para>
  <para style="q2">lu kheit san um khyh.</para>
  <para style="q1">“Pou <char style="nd">Bawipaw </char>, ka riathaenaw hynh</para>
  <para style="q2">yn muihpya tua,</para>
  <para style="q1">pawccecize ka rhaw hae nynh</para>
  <para style="q2">yn tae vae hae!” a ci.</para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" />Aphutepaw a uccaw kha</para>
  <para style="q2">rhaw hae nynh mih kuih a dyngnua hae;</para>
  <para style="q1">na ccungccaw zapi hae kalan</para>
  <para style="q2">tee lan na ua lei hae paw</para>
  <para style="q1">minphuin ccangpaw hae nynh</para>
  <para style="q2">a beikinnthyaa lungkhu lang</para>
  <para style="q1">a tee hae paw kha</para>
  <para style="q2">aning nynh a muih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" />A ccungccaw balyn tuh hawkhaekute</para>
  <para style="q2">looh a ccungkuh hae;</para>
  <para style="q1">mih thawzung a umthui nawlan</para>
  <para style="q2">mih sisua kha looh lang a zua hae.</para>
  <para style="q1">Pou <char style="nd">Bawipaw </char>, hohcihtemou</para>
  <para style="q2">ccungkia leipaw lang</para>
  <para style="q1">ka tang vae cipaw hynh</para>
  <para style="q2">yn do lah yn muihtua.</para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" />Laanpi kya a cceih hae paw</para>
  <para style="q2">nanning balyn, e hynh nanning hanlan</para>
  <para style="q1">accakaepaw tou athua?</para>
  <para style="q2">Do oh lah yn muihpya tua oh,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh myarya</para>
  <para style="q2">a thinria nin khe</para>
  <para style="q1">ka tungvaw thuasah zah</para>
  <para style="q2">yn teingsahpaw</para>
  <para style="q1">riathaenaw te alokuhpaw</para>
  <para style="q2">ccangpaw riathaenaw a um zawtou?</para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" />Ahangnaw kyate maee kha yn sah zah,</para>
  <para style="q2">ka ru lungkhu lang po a tee;</para>
  <para style="q1">ka ccu kha kaang yn syakhaw zah,</para>
  <para style="q2">nulang bua yn kisah;</para>
  <para style="q1">lungriathaete yn nung zah</para>
  <para style="q2">anin ninlang ka thawzung yn tingsah.</para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" />Ka cyiseimenaw kha taphu kyakhe</para>
  <para style="q2">a kuih te heede zah,</para>
  <para style="q1">ka nging kya yn khiide keiccuze</para>
  <para style="q2">ka thaw yn thangsah;</para>
  <para style="q1">Bawipaw nynh ka thadynnua</para>
  <para style="q2">kho lei hae paw</para>
  <para style="q1">ccungccaw hae kuih kalan</para>
  <para style="q2">kae kha yn ap.</para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" />Ka lungkhu umpaw arawthungpaw</para>
  <para style="q2">ka rhawkaw hae balyn kha</para>
  <para style="q1">Bawipaw nynh a vua vae hae;</para>
  <para style="q2">ka ccangvae hae kha ro khylan</para>
  <para style="q1">ccyh yn khyanua vae;</para>
  <para style="q2">misu mianaw khu kya</para>
  <para style="q1">miade hawte <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">ccanung liaccady Judah kha</para>
  <para style="q2">a syde vae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" />E uccaw hae keiccuze kae tuh</para>
  <para style="q2">ka rah; ka mit kyate mitphi tuh alua;</para>
  <para style="q1">ka thawzung bua yn umsahtu te</para>
  <para style="q2">lungtangnaw yn pyatu</para>
  <para style="q2">ka pepan um khyh;</para>
  <para style="q1">rhaw nynh a tae hae keiccuze</para>
  <para style="q2">ka ccaaw hae tuh a lanme vae hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" />Zion nynh a kuih kha</para>
  <para style="q2">dyngtua zahmah</para>
  <para style="q1">aning kha lungtangnaw</para>
  <para style="q2">a pyatu um khyh;</para>
  <para style="q1">Jakob innpaw hae kha</para>
  <para style="q2">Jakob rhaw lang tang khylan</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh kaw a pya vae hae;</para>
  <para style="q2">Jerusalem tuh minmin laku kya</para>
  <para style="q2">anungsikuhpaw lang a tang vae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" />
    <char style="nd">Bawipaw </char> tuh ading,</para>
  <para style="q2">a bya kha ka rawsesei vae;</para>
  <para style="q1">nanning minphuin hae balyn,</para>
  <para style="q2">ngaetua oh,</para>
  <para style="q2">ka teingnaw hynh yn muihpya tua oh;</para>
  <para style="q1">ka liaccaw hae te ka ccangvae hae kha</para>
  <para style="q2">kyng hae zah a cciakhae vae hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" />Yn sungsah hae paw kha</para>
  <para style="q2">ka ko hae zahmah</para>
  <para style="q1">kae kha yn ling hae;</para>
  <para style="q2">ka ranpibawi hae te ka piccan hae tuh</para>
  <para style="q1">mih thawzung a umthui nawlan</para>
  <para style="q2">looh a ccungku lya hae khe,</para>
  <para style="q1">khuapi lungkhu kya a chih hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" />Pou <char style="nd">Bawipaw </char>, pawcih baban mou</para>
  <para style="q2">ka lungriathae, beih yn dotua;</para>
  <para style="q1">ka vuepi tuh thawte a thyhleihkuh,</para>
  <para style="q2">ka lungkhu kya ka bung phe buleihkuh,</para>
  <para style="q1">nang kha kae la rawse keiccu nynh thua.</para>
  <para style="q2">Laanpi kya thaloi nynh</para>
  <para style="q1">chizo ngaethyanaw a umsah;</para>
  <para style="q2">inn lungkhu kya chinaw te</para>
  <para style="q1">alokuhpaw a um.</para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" />Lungtangnaw yn pyatu um leite,</para>
  <para style="q2">ka hawkhaekunaw kha</para>
  <para style="q1">minmin nynh a thae hae.</para>
  <para style="q2">Ka rhaw hae balyn nynh</para>
  <para style="q1">ka vawsawnaw kha a thae hae;</para>
  <para style="q2">na cyipaw hynh mih lungtua.</para>
  <para style="q1">Na khya vae paw accyh kha</para>
  <para style="q2">yn thuasah ccavae lah,</para>
  <para style="q1">kae hawte minmin mah</para>
  <para style="q2">tung hae sah.</para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" />Ahoy leipaw mih cyisahnaw balyn kha</para>
  <para style="q2">na malang thua vae sah;</para>
  <para style="q1">ka cyiseimenaw balyn keiccuze</para>
  <para style="q2">ka tungvaw na cyi hawte</para>
  <para style="q1">minmin kha mah cyih hae;</para>
  <para style="q2">pawccecize ka hawkhaekunaw tuh</para>
  <para style="q1">myarya lung zah,</para>
  <para style="q2">ka lungthawthang vae.</para>
  <para style="b" />
  <chapter number="2" style="c" />
  <para style="s1">Pachia nynh Raeringnaw Pyanaw Accing</para>
  <para style="p">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> nynh thinriate</para>
  <para style="q2">Zion ccanung kha maethya</para>
  <para style="q1">phe a law vae rei!</para>
  <para style="q2">Israel a lesaenaw kha</para>
  <para style="q1">vaawlang te laephi kalan</para>
  <para style="q2">a sawbung vae;</para>
  <para style="q1">a thinria nin kya a ccu</para>
  <para style="q2">a khangnawpaw kha</para>
  <para style="q">liathui vae khyh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" />Bawipaw nynh thawcci leite</para>
  <para style="q2">Jakob a umnaw hae balyn kha a ro vae;</para>
  <para style="q1">a thinria keiccuze ccanung Judah kya-e</para>
  <para style="q2">rhawlungrua hae kha a ting vae;</para>
  <para style="q1">peenaw te uktu hae kha thethyasahte</para>
  <para style="q2">laephi kalan a sawbung hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" />Myaryamaw a thinria zah</para>
  <para style="q2">Israel a thungnaw balyn kha</para>
  <para style="q1">phe a paepya; rhaw hae malang khe</para>
  <para style="q2">a ranglang kuih kha minmin kyate</para>
  <para style="q1">a khin vae, a pepan</para>
  <para style="q2">umpaw balyn kha pong a upaw</para>
  <para style="q1">maeesoi hawte Jakob kha a u vae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" />Rhaw hawte a li kha koi zah,</para>
  <para style="q2">rhaw hawte a ranglang kuih khate</para>
  <para style="q2">phang a nungde;</para>
  <para style="q1">Zion ccanung bu kya umpaw kaening nynh</para>
  <para style="q2">kae lungrythuakhaekupaw balyn kha</para>
  <para style="q1">aning nynh a chia vae hae;</para>
  <para style="q2">a thinrianaw kha maee hawte</para>
  <para style="q1">a ruasah vae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" />Bawipaw tuh rhaw hawte nynh athua vae;</para>
  <para style="q2">aning nynh Israel kha a ro vae;</para>
  <para style="q1">a siapharan inn balyn te</para>
  <para style="q2">a rhawlungrua hae kha roh zah,</para>
  <para style="q1">ccanung Judah kyakhe</para>
  <para style="q2">rawkhuinaw te</para>
  <para style="q1">ngaethyanaw kha a lungsah.</para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" />A umnaw bu kha khokhu hawte phou zah</para>
  <para style="q2">a beikbu kha a ro vae;</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh Zion kyakhe</para>
  <para style="q2">beiknaw poi te</para>
  <para style="q2">sabbath nin kha zosah zah,</para>
  <para style="q1">myaryamaw a thinria keiccuze</para>
  <para style="q2">siapharan te ranpibawi kha a vua hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" />Bawipaw nynh a silawhang kha sarya zah,</para>
  <para style="q2">a beikinnthyaa kha a vua vae;</para>
  <para style="q1">a siapharan inn hae kya-e pang hae kha</para>
  <para style="q2">rhaw hae kuih kalan a pya vae hae;</para>
  <para style="q1">poitua lya hawte <char style="nd">Bawipaw </char> inn kyakhe</para>
  <para style="q2">mih roi accae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" />
    <char style="nd">Bawipaw </char> nynh Zion ccanung kya-e</para>
  <para style="q2">khualungrua kha ro lan a tuaku;</para>
  <para style="q1">arui kha po a raw; ronaw kyate</para>
  <para style="q2">a kuih kha synkuh khyh;</para>
  <para style="q1">atolang asanpaw khualungrua te</para>
  <para style="q2">khualungruapi kha</para>
  <para style="q1">mih ngaethyasah hae zah,</para>
  <para style="q2">parouh mawte aroh hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" />A koikua hae tuh lae kaw lang</para>
  <para style="q2">accahbung hae;</para>
  <para style="q1">koikua hae kha roh hae zah</para>
  <para style="q2">accong hae kha a khya hae;</para>
  <para style="q1">a siapharan te a uktu bawi hae tuh</para>
  <para style="q2">minphuin ccangpaw hae</para>
  <para style="q1">laku kya nynh a um hae;</para>
  <para style="q2">phung ccangpyakunaw um vae khyh,</para>
  <para style="q1">a profeh hae nynh <char style="nd">Bawipaw </char> kyate</para>
  <para style="q2">vizin mue khyh hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" />Ccanung Zion kya-e piccan hae tuh</para>
  <para style="q2">laekhu kya daebabi lan a haung hae;</para>
  <para style="q1">mih lu kya vuiping phingkuh hae zah</para>
  <para style="q2">buriboei kha a zingku hae;</para>
  <para style="q1">Jerusalem liaccaw hae nynh mih lu kha</para>
  <para style="q2">laekhu lang a bakhung hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" />Ka rawnaw ze ka mit phe phing vae;</para>
  <para style="q2">ka vuepi tuh thawte a thyhleihkuh,</para>
  <para style="q1">ka ccungccaw hae tuh</para>
  <para style="q2">aro hae keiccuze,</para>
  <para style="q1">ka nyngkhaw atui tuh</para>
  <para style="q2">laekhu kya lae athua,</para>
  <para style="q1">pawccecize nosi hae te</para>
  <para style="q2">imua taraw hae tuh</para>
  <para style="q1">khuapi kya-e laanpi hae kya</para>
  <para style="q2">mih thawthang.</para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" />Khuapi kya-e laanpi hae kyakhe</para>
  <para style="q2">vaemaw a muepaw hawte</para>
  <para style="q1">mih thawthang lya te</para>
  <para style="q2">mih hiinnaw kha</para>
  <para style="q1">mih nung hae by vaw kya</para>
  <para style="q2">a nung lya hae khe,</para>
  <para style="q1">“Looh te misutui teimou a um?” cite</para>
  <para style="q2">mih nung hae kha a rawnua hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" />Pou ccanung Jerusalem,</para>
  <para style="q2">na hanlan pawmou</para>
  <para style="q1">ka ho kho cih zah, nang kha</para>
  <para style="q2">pawtemou kae khinkhia cih?</para>
  <para style="q1">Pou ccanung liaccady Zion,</para>
  <para style="q2">nang kha lungtangnaw pya khylan,</para>
  <para style="q1">pawtemou nang kha</para>
  <para style="q2">kae khinkhia kho cih?</para>
  <para style="q1">Na kya-e ronaw tuh rili hawte</para>
  <para style="q2">ale keiccuze nang kha</para>
  <para style="q1">hum nynh mou ae raethui kho cih?</para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" />Na profeh hae nynh akyh leipaw te</para>
  <para style="q2">lingnawpaw vizin hae kha</para>
  <para style="q1">na hanlan a muih vae hae;</para>
  <para style="q2">nang kha langmawlya hawte</para>
  <para style="q1">bua thuasah khylan,</para>
  <para style="q2">minmin nynh na hoyleinaw kha</para>
  <para style="q1">langsaku leite, akyh leipaw te</para>
  <para style="q2">cciaseinawpaw hawnaw bya kha</para>
  <para style="q1">a muih vae hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" />Laanpi kya a cceihpaw balyn nynh</para>
  <para style="q2">nang kha mih kuih ae bianua hae;</para>
  <para style="q1">ccanung Jerusalem kha</para>
  <para style="q2">saryanawpaw roisawnua hae zah,</para>
  <para style="q2">mih lu a thuhpya hae;</para>
  <para style="q1">“Puithyanaw phe accingpaw,</para>
  <para style="q2">laephi pynpi lungtuanawpaw, cite</para>
  <para style="q1">a ko hae paw khuapi tuh,</para>
  <para style="q2">e hynh tou athua?” a ci hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" />Na rhaw hae balyn nynh</para>
  <para style="q2">nang kha mih khalang ae awnua hae;</para>
  <para style="q1">saryanaw roi ae sawnua hae zah,</para>
  <para style="q2">mih haw ae zynua hae,</para>
  <para style="q1">“Aning kha phe ah laang vae oh!</para>
  <para style="q2">E nin hynh aening nynh</para>
  <para style="q1">ah ngaehoi oh paw nin thua zah,</para>
  <para style="q2">nyathyakou tuh ah muih</para>
  <para style="q1">vae oh!” cite a sia hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" />
    <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">a paccynkupaw kha a cyi vae,</para>
  <para style="q1">langmawlya a la ho thyhte</para>
  <para style="q2">a bya kha a ccingsah vae,</para>
  <para style="q1">thawcci leite a ro vae;</para>
  <para style="q2">na rhaw kha na tungvaw</para>
  <para style="q1">a lungtuasah zah,</para>
  <para style="q2">na rhaw thawzung kha</para>
  <para style="q1">a hangthung.</para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" />Pou Zion ccanung kya-e</para>
  <para style="q2">khualungrua,</para>
  <para style="q1">Bawipaw kalan thawte siatua!</para>
  <para style="q2">Mitphi tuh vawkhutui hawte</para>
  <para style="q1">khuazi khuadae lua sah!</para>
  <para style="q2">Haeungtaw nan,</para>
  <para style="q1">na mitphi tuh po lua sah!</para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" />Khuazi khe thokuh lah, siatua!</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> malang khe</para>
  <para style="q1">na thinlung kha tui hawte moh laetua!</para>
  <para style="q2">Mih vuelaw keiccuze</para>
  <para style="q1">mih thawthang zah</para>
  <para style="q2">laanpi atungkunaw takyh kya</para>
  <para style="q1">um hae paw</para>
  <para style="q2">na ccaaw hae hiinnaw hanlan</para>
  <para style="q1">amaw kalan na kuih hangtua.</para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" />Pou <char style="nd">Bawipaw </char>, beih dotua lah,</para>
  <para style="q2">hoyte tuatua!</para>
  <para style="q1">E hynh hum tungvaw mou na cyi?</para>
  <para style="q2">Nungpi hae nynh a saahku hae paw</para>
  <para style="q1">mih ccaaw hae kha</para>
  <para style="q2">ae lan accan zawtou?</para>
  <para style="q1">Ranpibawi hae te profeh hae kha</para>
  <para style="q2">Bawipaw beikinnthyaa kya</para>
  <para style="q1">chia lan accan hae zawtou?</para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" />Zawthaw hae te kum tang hae paw tuh</para>
  <para style="q2">laanpi kya laekhu khe a huekuh hae;</para>
  <para style="q1">ka liaccaw hae te ka ccangvae hae tuh</para>
  <para style="q2">thaloi te a chih vae hae;</para>
  <para style="q1">na thinria nin khe thawcci leite</para>
  <para style="q2">minmin kha na chia vae hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" />Poi lyaze ccungccaw ko hawte,</para>
  <para style="q2">ka pepan balyn kyate</para>
  <para style="q1">ka rhaw hae kha nae konua hae;</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> a thinria nin kya tuh</para>
  <para style="q1">lu kheit sanmah lue khyh zah hiin khyh;</para>
  <para style="q2">ka saahkuh hae zah</para>
  <para style="q1">ka kuaku hae paw ka ccaaw hae kha</para>
  <para style="q2">ka rhaw nynh a chia vae hae.</para>
  <para style="b" />
  <chapter number="3" style="c" />
  <para style="s1">Pachia Sungsahnaw Zungzae Atyn</para>
  <para style="p">
    <verse number="1" style="v" />Kae tuh Pachia thinrianaw</para>
  <para style="q2">ccungngue te riathaenaw</para>
  <para style="q2">a tung vae paw nynh ka thua;</para>
  <para style="q1">
    <verse number="2" style="v" />kae kha yn cciakhae zah</para>
  <para style="q2">awnaw papin a um leinaw</para>
  <para style="q2">mohnaw lungkhu langkhe yn saw;</para>
  <para style="q1">
    <verse number="3" style="v" />kae kyalya kha anin ninlang</para>
  <para style="q2">a kuih te atu te atu yn bia bungthung.</para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" />Ka ngesaw te ka ving kha</para>
  <para style="q2">phe yn zoihsah zah,</para>
  <para style="q2">ka ru hae kha yn khya vae;</para>
  <para style="q1">
    <verse number="5" style="v" />kae kha phang yn koihlu zah,</para>
  <para style="q2">teingnaw te vawsawnaw khate</para>
  <para style="q2">phang yn lungde;</para>
  <para style="q1">
    <verse number="6" style="v" />a chinaw asaw vae paw michi hawte</para>
  <para style="q2">kae kha mohnaw kya yn haungsah.</para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" />Ka pou kho khyh ccaw cite</para>
  <para style="q2">pang kha yn thungkhaw zah</para>
  <para style="q2">aripaw sivawrui te yn khii;</para>
  <para style="q1">
    <verse number="8" style="v" />bawmnaw mue khylan</para>
  <para style="q2">ka ko zah ka sia zemah</para>
  <para style="q2">ka sawsangnaw kha yn vuapya;</para>
  <para style="q1">
    <verse number="9" style="v" />ka laanpi kha a-awkuhpaw</para>
  <para style="q2">lungtungpi te yn pingpah zah</para>
  <para style="q1">ka ccianaw kha yn kousahpya.</para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" />Aning tuh kae yn buhkhawpaw vong,</para>
  <para style="q2">a rekuhpaw chindeih nynh thua;</para>
  <para style="q1">
    <verse number="11" style="v" />ka laanpi kyate yn cciasah sei zah</para>
  <para style="q2">zoihtatyh lan yn pae;</para>
  <para style="q2">kae kha yn vuasya;</para>
  <para style="q1">
    <verse number="12" style="v" />a li kha koi zah, kae kha</para>
  <para style="q2">a the nynh a tung lanpaw</para>
  <para style="q1">themuing lang yn taw.</para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" />A the bawng lungkhu e a the hae khate</para>
  <para style="q2">ka kin kha yn kaw;</para>
  <para style="q1">
    <verse number="14" style="v" />Kae tuh ka ccungccaw hae balyn kyaze</para>
  <para style="q2">nuinsepaw lang ka tang vae zah,</para>
  <para style="q1">anin ninlang mih hlawke</para>
  <para style="q2">a sahnua hae paw lang ka tang vae.</para>
  <para style="q1">
    <verse number="15" style="v" />Akhahpaw te phe yn bynsah zah,</para>
  <para style="q2">eccangkary khate phe yn ruisah vae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" />Lung vawlan khe ka haw kha</para>
  <para style="q2">yn king zah, buhhaw te yn phing.</para>
  <para style="q1">
    <verse number="17" style="v" />Ka hiinnaw tuh daenaw um khyh;</para>
  <para style="q2">lungtuanaw tuh pawmou</para>
  <para style="q2">athua cipaw phe ka ning vae;</para>
  <para style="q1">
    <verse number="18" style="v" />tukeiccuze, “Ka phu-enaw azo vae,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kyate</para>
  <para style="q1">ka la ngaehoipaw balyn tuh</para>
  <para style="q2">phe azo vae,” cite ka ho.</para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" />Ka lungriathaenaw te</para>
  <para style="q2">inn lei loo leite ka vaevuipaw hynh</para>
  <para style="q1">ka tua vae ze, eccangkary te</para>
  <para style="q2">sanyngkhaw khya hawte nynh akhya!</para>
  <para style="q1">
    <verse number="20" style="v" />Tuh-e tuh apaekuh lei lan ka tua zah,</para>
  <para style="q2">ka lungkhu kya ka ngaethah.</para>
  <para style="q1">
    <verse number="21" style="v" />Thuasalama e hynh</para>
  <para style="q2">ka tuathui keiccuze</para>
  <para style="q2">ngaehoinaw ka hoi.</para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" />
    <char style="nd">Bawipaw </char> sungsahnaw atynpaw tuh</para>
  <para style="q2">kharouh pae boi khyh,</para>
  <para style="q1">a thawccinaw tuh</para>
  <para style="q2">kharouh thang boi khyh;</para>
  <para style="q1">
    <verse number="23" style="v" />tuh-e a sungsahnaw te</para>
  <para style="q2">a thawccinaw tuh</para>
  <para style="q1">awkhua takyhte athaw hae;</para>
  <para style="q2">na lungzinaw tuh myarya ale.</para>
  <para style="q1">
    <verse number="24" style="v" />“<char style="nd">Bawipaw </char> tuh ka hanpaw nynh thua,</para>
  <para style="q2">tukeiccuze amaw kya</para>
  <para style="q1">ka ngaehoi cih,” cite</para>
  <para style="q2">ka muisaw nynh a ho.</para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" />
    <char style="nd">Bawipaw </char> tuh amaw</para>
  <para style="q2">a ngaehoikuh hae paw te</para>
  <para style="q2">amaw a ccung hae paw hanlan ahoy.</para>
  <para style="q1">
    <verse number="26" style="v" />
    <char style="nd">Bawipaw </char> khumnaw kha</para>
  <para style="q2">daebabi lan ngaw tuh ahoy.</para>
  <para style="q1">
    <verse number="27" style="v" />Ccungccaw nynh a zawthaw lyakhe</para>
  <para style="q2">puihnawpaw ccong kha</para>
  <para style="q2">a puih lanpaw nynh thua.</para>
  <para style="q1">
    <verse number="28" style="v" />Bawipaw nynh tuh-e</para>
  <para style="q2">puihnawpaw ccong kha</para>
  <para style="q1">a puihsah lyakhe</para>
  <para style="q2">a makhaete daebabi lan</para>
  <para style="q2">a haung ze ahoy,</para>
  <para style="q1">
    <verse number="29" style="v" />(ngaehoinaw a um kho cite tuate),</para>
  <para style="q2">a mung kha vuiping kya</para>
  <para style="q2">phang a nae ze ahoy,</para>
  <para style="q1">
    <verse number="30" style="v" />a biatu kalan khe</para>
  <para style="q2">a byaki kha tuakute</para>
  <para style="q1">saryanaw a teing ze ahoy.</para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" />Pawccecize Bawipaw nynh</para>
  <para style="q2">zungzaete vua lan khyh.</para>
  <para style="q1">
    <verse number="32" style="v" />A ngaethyasah zemah,</para>
  <para style="q2">zungzae tynpaw a sungsahnaw tuh</para>
  <para style="q2">myarya ale thyhte ngaethya a umsah cih;</para>
  <para style="q1">
    <verse number="33" style="v" />ccungccaw hynh ruaruate</para>
  <para style="q2">riathaesah ry khyh zah</para>
  <para style="q1">ngaethyasah ry khyh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" />Ram lungkhu e thongccah hae kha</para>
  <para style="q2">ccu te sydenaw,</para>
  <para style="q1">
    <verse number="35" style="v" />Ahang Huaccepaw Pachia malang khe</para>
  <para style="q2">ccungccaw nynh mue lan</para>
  <para style="q2">accanpaw kha muesah leite,</para>
  <para style="q1">
    <verse number="36" style="v" />lukhakheit byathan kha</para>
  <para style="q2">he a buleihpya hae ze,</para>
  <para style="q1">Bawipaw nynh muih khyh tou?</para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" />Bawipaw nynh kawpya khyh lanze,</para>
  <para style="q2">hum nynh mou kawpya kho zah</para>
  <para style="q2">khah-e kha a cyisakuh kho?</para>
  <para style="q1">
    <verse number="38" style="v" />Ahoypaw te athahpaw hynh</para>
  <para style="q2">Ahang Huaccepaw Pachia</para>
  <para style="q2">a munglae kyate yn toikuh khyh tou?</para>
  <para style="q1">
    <verse number="39" style="v" />Ahiinpaw lukhakheit nynh</para>
  <para style="q2">a seinaw keiccu detahnaw</para>
  <para style="q1">a muepaw kha</para>
  <para style="q2">pawccemou a bokhaeku?</para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" />Aening nynh ah laanpi kha</para>
  <para style="q2">dothuite syntawtua oh sih lah,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kalan ki oh sih.</para>
  <para style="q1">
    <verse number="41" style="v" />Vaawlang umpaw</para>
  <para style="q2">Pachia kalan khe</para>
  <para style="q1">ah kuih kyalya thua leite</para>
  <para style="q2">ah thinlung balyn kha</para>
  <para style="q2">hangthung oh sih.</para>
  <para style="q1">
    <verse number="42" style="v" />Kaening tuh kae sei vae zah</para>
  <para style="q2">kae dou vae, kae seinaw kha</para>
  <para style="q1">nae ngaethya vae khyh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" />Thinrianaw te phang na</para>
  <para style="q2">lungdekuh zah nae deehui,</para>
  <para style="q1">ngaethyaumsah leite</para>
  <para style="q2">kaening kha nae chia;</para>
  <para style="q1">
    <verse number="44" style="v" />kae sawsangnaw nynh</para>
  <para style="q2">po a zuake kho khyh ccaw cite,</para>
  <para style="q2">maeking khate phang na lungde.</para>
  <para style="q1">
    <verse number="45" style="v" />Minphuin hae laku khe kaening kha</para>
  <para style="q2">anungsikuhpaw te</para>
  <para style="q1">athupaw lang nae rae vae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" />Kae rhaw hae balyn nynh</para>
  <para style="q2">mih khalang kha oun awnua vae hae;</para>
  <para style="q1">
    <verse number="47" style="v" />rinaw, hunghua akhupaw,</para>
  <para style="q2">maemihnaw te ronaw nynh</para>
  <para style="q2">kae tungvaw oun thuanua vae.</para>
  <para style="q1">
    <verse number="48" style="v" />Ka ccungccaw hae tuh</para>
  <para style="q2">ronaw a tung hae keiccuze</para>
  <para style="q1">ka mitphi tuh vawpi hawte alua.</para>
  <para style="b" />
  <para style="q1">
    <verse number="49-50" style="v" />Vaawlang umpaw <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">yn dobung zah yn muih mawlaezung,</para>
  <para style="q1">ka mitphi tuh apaekuh lei lan</para>
  <para style="q2">dae leite po alua cih.</para>
  <para style="q1">
    <verse number="51" style="v" />Ka khua kya-e</para>
  <para style="q2">liaccaw hae tungvaw</para>
  <para style="q1">acyihkuhpaw kha</para>
  <para style="q2">ka muih zah ka ngaethah.</para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" />Akonglang um leite</para>
  <para style="q2">kae yn rhawtu hae nynh</para>
  <para style="q2">pavaw bi hawte bi hae;</para>
  <para style="q1">
    <verse number="53" style="v" />Ka hiin pite hunghua</para>
  <para style="q2">lungkhu lang yn vua hae zah,</para>
  <para style="q2">lung te yn nethin hae;</para>
  <para style="q1">
    <verse number="54" style="v" />ka lu kha tui nynh yn vu zah,</para>
  <para style="q2">“Ka chih vae,” ka ci.</para>
  <para style="b" />
  <para style="q1">
    <verse number="55" style="v" />Pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">akhunaw lungkhu te</para>
  <para style="q2">na min kha kae ko;</para>
  <para style="q1">
    <verse number="56" style="v" />“Bawmnaw mue khylan</para>
  <para style="q2">ka siaruanaw hynh</para>
  <para style="q1">na nakaring hutawku leite</para>
  <para style="q2">bawmnaw beih yn pyatua!” cite</para>
  <para style="q2">kae ngiakunaw kha nae thaepya.</para>
  <para style="q1">
    <verse number="57" style="v" />Nang kha kae koku vae ze,</para>
  <para style="q2">nae naenuakuh zah,</para>
  <para style="q2">“Rih nan!” nae cipya.</para>
  <para style="b" />
  <para style="q1">
    <verse number="58" style="v" />Pou Bawipaw, ka byathan kha</para>
  <para style="q2">ccaring nae lawpah zah,</para>
  <para style="q2">ka hiinnaw kha nae luesah vae.</para>
  <para style="q1">
    <verse number="59" style="v" />Pou <char style="nd">Bawipaw </char>, ahme leite</para>
  <para style="q2">ka tungvaw yn cyi hae paw kha</para>
  <para style="q1">nae muihpya vae;</para>
  <para style="q2">ka byathan hynh bya beih yn piapya tua.</para>
  <para style="q1">
    <verse number="60" style="v" />Kae yn rhawnaw hae balyn te</para>
  <para style="q2">aruh lante yn paccynnuaku</para>
  <para style="q1">hae paw balyn kha phe na muih vae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="61" style="v" />Pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">yn saryanaw hae te</para>
  <para style="q1">aruh lante yn paccynnuaku</para>
  <para style="q2">hae paw balyn kha</para>
  <para style="q2">phe na thae vae.</para>
  <para style="q1">
    <verse number="62" style="v" />Ka rhaw hae nynh</para>
  <para style="q2">anin ninlang ka thanhote</para>
  <para style="q2">kae kha yn rawse hae.</para>
  <para style="q1">
    <verse number="63" style="v" />A haung hae ze thuasah,</para>
  <para style="q2">a thadyn hae ze thuasah beih dotua hae,</para>
  <para style="q1">kae tuh saryanawpaw</para>
  <para style="q2">hlaw lang nynh yn sah hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="64" style="v" />Pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">mih kuih nynh rya a law thyhte</para>
  <para style="q2">mih cyisahnaw kha liaru hae!</para>
  <para style="q1">
    <verse number="65" style="v" />Lungriathaenaw pya hae lah,</para>
  <para style="q2">minmin kha thyalawtua hae!</para>
  <para style="q1">
    <verse number="66" style="v" />Thinriate minmin kha deehui hae lah,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> vaawlui zakaw kyate rotua hae.</para>
  <para style="b" />
  <chapter number="4" style="c" />
  <para style="s1">Zion kha Detahnaw</para>
  <para style="p">
    <verse number="1" style="v" />Sui tuh azong aleih vae,</para>
  <para style="q2">sui ccipaw tuh arulaekuh vae!</para>
  <para style="q1">Athyaapaw lung hae tuh</para>
  <para style="q2">laanpi atungkunaw takyh kya</para>
  <para style="q1">phiariphiarae a um hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" />Sui hoypaw hawte</para>
  <para style="q2">akhinccite amee um zah</para>
  <para style="q1">aphutepaw Zion ccaaw hae tuh</para>
  <para style="q2">ang raetu nynh a raepaw</para>
  <para style="q1">laephi ang lang nynh</para>
  <para style="q2">ria athua vae hae!</para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" />Suizaw hae nynh heize</para>
  <para style="q2">mih taw hae kha</para>
  <para style="q1">matei tuapakuh hae zah a zusah hae,</para>
  <para style="q2">thuasalama ka ccungccaw hae tuh</para>
  <para style="q1">ramkaw e kalauh pavaw hawte</para>
  <para style="q2">mih rysawthah vae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" />Nosi hae tuh mateitui kanmaw hae zah,</para>
  <para style="q2">mih lae tuh mih dankhaling kya abekuh vae;</para>
  <para style="q1">ccaaw hae nynh looh a ngiaku hae zemah</para>
  <para style="q2">humhung nynh mah</para>
  <para style="q1">ccapyh san pya khyh hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" />Looh athuathuapaw</para>
  <para style="q2">a la ae he hae paw tuh</para>
  <para style="q1">laanpi kya aroh vae hae;</para>
  <para style="q2">boeining hoypaw a la</para>
  <para style="q1">lawkuh he hae paw tuh</para>
  <para style="q2">buhhaw apumkuhpaw kya nynh</para>
  <para style="q1">a pum vae hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" />Kuih hangnua leite,</para>
  <para style="q2">vaekheihmawte Sodom khua kya</para>
  <para style="q1">accahpaw detahnaw laeze<note caller="-" style="x"><char style="xo" closed="false">4.6: </char><char style="xt" closed="false"><ref loc="GEN 19:24">Gen 19.24</ref></char></note></para>
  <para style="q2">ka ccungccaw hae tungvaw e</para>
  <para style="q1">detahnaw tuh alehua.</para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" />A bawi hae tuh vuiraw laeze</para>
  <para style="q2">thyaahua hae zah</para>
  <para style="q1">mateitui laeze arawhua hae;</para>
  <para style="q2">mih ngesaw tuh</para>
  <para style="q1">lung sepaw laeze asehua,</para>
  <para style="q2">mih sang tuh nilar lung te nynh aloku.</para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" />Atu vae tuh, mih mae tuh</para>
  <para style="q2">angmae laeze manhua zah,</para>
  <para style="q1">laanpi kya syntaw lan</para>
  <para style="q2">um vae khyh hae.</para>
  <para style="q1">mih ving tuh mih ru vawlan</para>
  <para style="q2">dawkadae lan cih zah,</para>
  <para style="q2">thing hawte nynh arou vae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" />Thaloi te a chih hae paw tuh</para>
  <para style="q2">kanmaw te a chih hae paw laeze</para>
  <para style="q1">lungtuapaw nynh athua hae.</para>
  <para style="q2">Loo kyate apoupaw looh hoi leite,</para>
  <para style="q1">mih hiinnaw tuh azo.</para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" />Thawccih thyapaw</para>
  <para style="q2">nungpi hae kuih nynh</para>
  <para style="q1">mih ccaaw hae toulou kha</para>
  <para style="q2">saw lang a thungku vae hae;<note caller="-" style="x"><char style="xo" closed="false">4.10: </char><char style="xt" closed="false"><ref loc="DEU 28:57">Deu 28.57</ref>; <ref loc="EZK 5:10">Eze 5.10</ref></char></note></para>
  <para style="q1">ka ccungccaw hae aro ccyh lya hae khe</para>
  <para style="q2">mih ccaaw hae tuh</para>
  <para style="q1">mih looh lang a tang hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" />
    <char style="nd">Bawipaw </char> nynh a thinrianaw kha</para>
  <para style="q2">khaleih a pousah;</para>
  <para style="q1">maee lang ruapaw</para>
  <para style="q2">a thinrianaw kha buu zah,</para>
  <para style="q1">Zion khua kha maee te a soi,</para>
  <para style="q2">te khua a thonaw aleihpaw cia</para>
  <para style="q1">phe ccung lan a u.</para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" />Rawsetu nynh thuasah,</para>
  <para style="q2">rhaw nynh thuasah</para>
  <para style="q1">Jerusalem koikua lungkhu lang</para>
  <para style="q2">a tee kho hae cipaw kha</para>
  <para style="q1">laephi siapharan hae te</para>
  <para style="q2">laephi ccungccaw</para>
  <para style="q1">lu kheit nynh sanmah zyn khyh hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" />Tuh-e tuh Jerusalem e</para>
  <para style="q2">profeh hae te ranpibawi hae</para>
  <para style="q1">hoyleinaw keiccu nynh thua,</para>
  <para style="q2">minmin nynh Jerusalem ngaelung khe</para>
  <para style="q1">miding hae chii kha a luasah hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" />Minmin tuh mingaee hae hawte</para>
  <para style="q2">laanpi kya a khiavuikuh hae,</para>
  <para style="q1">mih boeining tuh chiise te nungsikuh zah,</para>
  <para style="q2">hum nynh sanmah ty ngan khyh hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" />Ccungccaw hae nynh</para>
  <para style="q2">minmin kha, “Cceih oh!</para>
  <para style="q1">A thyaa lei hae paw!</para>
  <para style="q2">Ccaring cceih oh! Yn ty</para>
  <para style="q1">nan oh!” cite a sianua hae.</para>
  <para style="q2">Tuhcite minmin tuh a ccue hae paw te</para>
  <para style="q2">a khiavuikuh hae paw lang a tang hae;</para>
  <para style="q1">minphuin ccangpaw hae nynh,</para>
  <para style="q2">“Minmin tuh e kya khaw cia</para>
  <para style="q1">um vae lan khyh hae,” cite</para>
  <para style="q2">a hoku hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" />
    <char style="nd">Bawipaw </char> ccaccei maw nynh</para>
  <para style="q2">minmin kha phiariphiarae</para>
  <para style="q1">a nung vae hae,</para>
  <para style="q2">minmin kha pawlangria</para>
  <para style="q1">vae lan khyh hae;</para>
  <para style="q2">ccungccaw hae nynh</para>
  <para style="q1">ranpibawi hae kha</para>
  <para style="q2">sawtua vae khyh hae,</para>
  <para style="q1">cciakhaetu hae kha</para>
  <para style="q2">maedo vae khyh hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" />Bawmnaw mue khylan</para>
  <para style="q2">alakaw lan kae dohannaw ze</para>
  <para style="q1">kae mit phe ccih vae;</para>
  <para style="q2">kaening oun khum kho leipaw</para>
  <para style="q1">minphuin kha thawmuinte</para>
  <para style="q2">phang kae ngaw.</para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" />Kae laanpi kya</para>
  <para style="q2">kae ccia kho khyh nawlan,</para>
  <para style="q1">minmin nynh kae ccunoh kha</para>
  <para style="q2">oun zui hae; kae thangnaw ccyh</para>
  <para style="q1">anae vae; kae ccyh athang vae;</para>
  <para style="q2">kae thangnaw a thua vae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" />Kaening oun deehuitu hae tuh</para>
  <para style="q2">vaawlui e lantaw hae laeze</para>
  <para style="q1">aranghua hae;</para>
  <para style="q2">mua vawlan khe kaening kha</para>
  <para style="q1">oun ccung hae,</para>
  <para style="q2">ramkaw khe mah</para>
  <para style="q1">oun buhkhaw hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" />Kae hiinnaw hy athuapaw,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh chitui thuhpaw,</para>
  <para style="q1">ccangpaw minphuin hae laku kya</para>
  <para style="q2">amaw mynlyh kaw khe ah um cih oh,</para>
  <para style="q1">cite amaw kong kae la hokupaw kha</para>
  <para style="q2">rhaw hae nynh hunghua</para>
  <para style="q1">lungkhu lang a saw vae hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" />Pou ccanung Edom,</para>
  <para style="q2">lungtua lungpawte umtua,</para>
  <para style="q1">Uz ram kya um hae paw nanning,</para>
  <para style="q2">lungtua lungpawte um oh;</para>
  <para style="q1">thuasalama nang na kalan mah</para>
  <para style="q2">banang yn thua cih;</para>
  <para style="q1">na rui cih zah na boeining</para>
  <para style="q2">phaekute na sasete na um cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" />Pou Zion ccanung,</para>
  <para style="q2">na seinaw keiccu</para>
  <para style="q1">detahnaw tuh accing vae,</para>
  <para style="q2">kyngte ramccang lang</para>
  <para style="q1">cciakhae na thua vae lan khyh.</para>
  <para style="q2">Pou ccanung Edom,</para>
  <para style="q1">na seinaw keiccu de ae tah cih zah,</para>
  <para style="q2">na seinaw kha a langsakuh cih.</para>
  <para style="b" />
  <chapter number="5" style="c" />
  <para style="s1">Thawccinaw Ngiakunaw</para>
  <para style="p">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, kae tungvaw</para>
  <para style="q2">acyihkuhpaw hynh beih tuatua;</para>
  <para style="q1">kae thethyanaw hynh</para>
  <para style="q2">oun dotua lah, oun nytua!</para>
  <para style="q1">
    <verse number="2" style="v" />Kae rho athuapaw ram tuh</para>
  <para style="q2">minphuin ccang hae kalan</para>
  <para style="q1">pya thua vae zah, kae inn hae tuh</para>
  <para style="q2">ramccang hae kalan</para>
  <para style="q2">pya athua vae.</para>
  <para style="q1">
    <verse number="3" style="v" />Kaening tuh paaw hoi leipaw</para>
  <para style="q2">ngawraw hae lang kae tang vae;</para>
  <para style="q1">kae nung hae tuh</para>
  <para style="q2">nomae hae hawte nynh athua vae hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Kae niapaw tui mee kha pya aho vae;</para>
  <para style="q2">thing mah reku aho vae.</para>
  <para style="q1">
    <verse number="5" style="v" />Kae nging vawlan taphu khangte</para>
  <para style="q2">thawte rya oun reih hae;</para>
  <para style="q1">kae thawbang zemah</para>
  <para style="q2">oun haeungsah khyh hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Looh phe zaw lan mueku khylan</para>
  <para style="q2">Izip te Assiria hae ryte</para>
  <para style="q2">nawccawnaw kae rae vae.</para>
  <para style="q1">
    <verse number="7" style="v" />Kae minpaaw hae tuh</para>
  <para style="q2">la sei hae zah, atu tuh um vae khyh hae,</para>
  <para style="q1">te minmin hoyleinaw kha</para>
  <para style="q2">kaening nynh kae teing.</para>
  <para style="q1">
    <verse number="8" style="v" />See hae nynh kaening kha</para>
  <para style="q2">oun uk hae; mih kuih kyate</para>
  <para style="q1">oun luesah lanpaw</para>
  <para style="q2">lu kheit san um khyh.</para>
  <para style="q1">
    <verse number="9" style="v" />Ramkaw e thaloi rhaw keiccuze</para>
  <para style="q2">chi ze chi ci ciate</para>
  <para style="q2">looh kae ccungkuh.</para>
  <para style="q1">
    <verse number="10" style="v" />Maee lang ruapaw</para>
  <para style="q2">ccakanccinaw keiccuze</para>
  <para style="q1">kae ngesaw tuh</para>
  <para style="q2">lungthuh hawte aman.</para>
  <para style="q1">
    <verse number="11" style="v" />Zion khua kya nopi hae te</para>
  <para style="q2">Judah khua hae kya</para>
  <para style="q1">liaccady hae kha</para>
  <para style="q2">kyngdete a ikhae hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Bawi hae kha mih kuih te</para>
  <para style="q2">a saethung hae;</para>
  <para style="q1">cciakhaetu hae kha mah</para>
  <para style="q2">sawtua khyh hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Ccangvae hae kha nangsete</para>
  <para style="q2">looh a miasah hae,</para>
  <para style="q1">pise taraw hae tuh</para>
  <para style="q2">myarya ripaw thing puihte</para>
  <para style="q2">vyavya khuliakuh hae.</para>
  <para style="q1">
    <verse number="14" style="v" />Paawpi hae nynh</para>
  <para style="q2">khuapi koikua kha cciataw hae zah,</para>
  <para style="q1">ccangvae hae nynh</para>
  <para style="q2">mih tintang kha a cciataw vae hae.</para>
  <para style="q1">
    <verse number="15" style="v" />Kae lungtuanaw tuh</para>
  <para style="q2">zya adae vae; kae lawnaw tuh</para>
  <para style="q2">rawkhuinaw lang nynh a tang vae.</para>
  <para style="q1">
    <verse number="16" style="v" />Bawilukhung tuh</para>
  <para style="q2">kae lu kyate accah vae;</para>
  <para style="q1">kae sei vae keiccuze</para>
  <para style="q2">kaening hanlan ngaethya lan kou um!</para>
  <para style="q1">
    <verse number="17" style="v" />E keiccuze kae lungroh vae,</para>
  <para style="q2">e uccaw hae keiccuze</para>
  <para style="q1">kae mit tuh hoyte</para>
  <para style="q2">ngawmuih vae khyh:</para>
  <para style="q1">
    <verse number="18" style="v" />Zion Mua tuh</para>
  <para style="q2">ccungccaw adae vae keiccuze,</para>
  <para style="q1">a vawlan khe suizaw hae tuh</para>
  <para style="q2">a khiakuh bungthung hae.</para>
  <para style="q1">
    <verse number="19" style="v" />Thuasalama, pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">nang nynh zungzae na uk;</para>
  <para style="q1">na bawitungkhung tuh</para>
  <para style="q2">she takyh kya po atyn.</para>
  <para style="q1">
    <verse number="20" style="v" />Pawccemou kaening hynh</para>
  <para style="q2">kharouh nae ning vae?</para>
  <para style="q1">Pawccemou kaening hynh</para>
  <para style="q2">khaw cia nae vua?</para>
  <para style="q1">
    <verse number="21" style="v" />Pou <char style="nd">Bawipaw </char>, kaening nynh</para>
  <para style="q2">namaw kalan bua kae ki kho nawlan,</para>
  <para style="q1">namaw kalan beih oun kisah;</para>
  <para style="q2">langmawlya hawte</para>
  <para style="q2">kae ccyh hynh beih oun thawsahpah—</para>
  <para style="q1">
    <verse number="22" style="v" />tuhkhyhze kaening hynh</para>
  <para style="q2">khaleih nae vua vae cih tou?</para>
  <para style="q1">Tou kho lei lan ciate</para>
  <para style="q2">kae tungvaw na thinria cih tou?</para>
</usx>