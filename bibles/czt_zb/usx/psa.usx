<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="PSA" style="id">Baebu Thyaa</book>
  <para style="h">SAM</para>
  <para style="toc1">The Psalms</para>
  <para style="toc2">SAM</para>
  <para style="toc3">Sam</para>
  <para style="mt1">SAM</para>
  <para style="mt2">The Psalms</para>
  <para style="imt">Byalaanmaw</para>
  <para style="ip">Sam ccauh hynh Baebu lungkhu e hlaw ccauh te sawsangnaw ccauh nynh thua. Kum patae kya-e hlawphuatu hae te ccawzeitu hae nynh a phua hae paw nynh thua; e hlaw hae te sawsangnaw hae hynh Israel hae nynh suelua hae zah mih Pachia beiknaw kya a mang hae, nyathyakou tuh mih Ccathyaa kya a pybia hae.</para>
  <para style="ip">E beiknaw hlaw hynh aphuin patae a um: Pachia beiknaw te thehoysahnaw hlaw, bawmnaw, thungkhawnaw te khumnaw mue nawlan sawsangnaw, seingaethyanaw ngiakunaw, Pachia hythuanaw hanlan thehoysahnaw hlaw, rhaw tae nawlan sawsangnaw cite a um hae. E sawsangnaw hae hynh minphuin sawsangnaw te pyn raveih sawsangnaw nynh athua hae; e sawsangnaw abang hynh ccungccaw lu kheit nynh a thinlung akhu huanaw kya-e bya kha langsah zah, abang tuh Pachia ccungccaw hae balyn nynh a hobounaw hae te mih thinlung langsakunaw nynh thua.</para>
  <para style="ip">Sam hynh Jesu nynh mah mang zah Byakin Thaw a zeitu hae nynh mah a mang hae. Khriccaawbuu athotakaw lya mawte asung-epaw beiknaw ccauh nynh thua.</para>
  <para style="iot">Abyalupi hae</para>
  <para style="io1">Sam ccauh byaria 150 hynh uk pangaw lang phia kho athua:</para>
  <para style="io2">Sam 1—41</para>
  <para style="io2">Sam 42—72</para>
  <para style="io2">Sam 73—89</para>
  <para style="io2">Sam 90—106</para>
  <para style="io2">Sam 107—150</para>
  <chapter number="1" style="c" />
  <para style="ms">Uk 1</para>
  <para style="mr">(<ref loc="PSA 1-41">Sam 1—41</ref>)</para>
  <para style="d">David Hlaw</para>
  <para style="s1">Laanpi Ccangning</para>
  <para style="q1">
    <verse number="1" style="v" />Ccungccaw hoylei hae paw nynh</para>
  <para style="q2">tuanaw pyapaw kha lawku leite,</para>
  <para style="q1">misei hae laanpi kha mah zui leite,</para>
  <para style="q1">sarisarya acihthya hae paw</para>
  <para style="q2">mih umnaw kya mah</para>
  <para style="q2">a haungbua leipaw,</para>
  <para style="q1">
    <verse number="2" style="v" />
    <char style="nd">Bawipaw </char> kawbya kyakhe</para>
  <para style="q2">a lungrythua zah,</para>
  <para style="q1">tuh-e kawbya kha khuazi khuadae</para>
  <para style="q2">a tuapaw tuh lungtuapaw nynh thua.</para>
  <para style="q1">
    <verse number="3" style="v" />Aning tuh vawkhu pe linpaw,</para>
  <para style="q2">amaw accyh kya athae thae zah,</para>
  <para style="q1">anaw anaan leipaw</para>
  <para style="q2">thingku te nynh aloku.</para>
  <para style="q1">A cyipaw balyn kya</para>
  <para style="q2">a laan a sui a ua cih.<note caller="-" style="x"><char style="xo" closed="false">1.3: </char><char style="xt" closed="false"><ref loc="JER 17:8">Jer 17.8</ref></char></note></para>
  <para style="q1">
    <verse number="4" style="v" />Ccungccaw hoylei hae paw tuh</para>
  <para style="q2">tuhte thua khyh,</para>
  <para style="q1">khisan nynh a mungpaw</para>
  <para style="q2">vaekang te nynh aloku hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Tukeiccuze ccungccaw hoylei</para>
  <para style="q2">hae paw tuh byapianaw kya</para>
  <para style="q1">thadyn lan khyh hae, misei hae tuh</para>
  <para style="q2">miding hae pumkunaw kya</para>
  <para style="q2">umbua lan khyh hae;</para>
  <para style="q1">
    <verse number="6" style="v" />pawccecize <char style="nd">Bawipaw </char> nynh miding hae</para>
  <para style="q2">laanpi kha a do-oihpya hae,</para>
  <para style="q1">thuasalama ccungccaw hoylei</para>
  <para style="q2">hae paw laanpi tuh aroh cih.</para>
  <chapter number="2" style="c" />
  <para style="s1">Pachia nynh Popaw Siapharan</para>
  <para style="q1">
    <verse number="1" style="v" />Pawccemou minphuin hae nynh</para>
  <para style="q2">aruh lante doukunaw</para>
  <para style="q1">khuakhan hae zah,</para>
  <para style="q2">ccungccaw hae nynh accakaepaw kha</para>
  <para style="q2">a paccyn hae?<note caller="-" style="x"><char style="xo" closed="false">2.1-2: </char><char style="xt" closed="false"><ref loc="ACT 4:25-26">Loc 4.25-26</ref></char></note></para>
  <para style="q1">
    <verse number="2" style="v" />Laephi siapharan hae te</para>
  <para style="q2">uktu bawi hae nynh <char style="nd">Bawipaw </char> te</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh chitui a thuhpaw kha</para>
  <para style="q2">rawsete pynkheihlan khuakhankuh hae zah,</para>
  <para style="q1">
    <verse number="3" style="v" />“Oun heenaw hae paw kha</para>
  <para style="q2">thoh pae oh sih lah,</para>
  <para style="q1">mih liarui hae kha aening kyate</para>
  <para style="q2">vua oh sih,” a ciku hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Vaawram kya a haungpaw tuh a nuin;</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh minmin kha</para>
  <para style="q2">a sarya hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Oute thinriate minmin kha</para>
  <para style="q2">bya a hopah cih hae,</para>
  <para style="q2">a thinrianaw nynh mih thin a phangsah hae,</para>
  <para style="q1">
    <verse number="6" style="v" />“Ka siapharan kha athyaapaw</para>
  <para style="q2">ka Zion mua vawlan ka nung vae,” a ci.</para>
  <para style="q1">
    <verse number="7" style="v" />
    <char style="nd">Bawipaw </char> phunglang kha</para>
  <para style="q2">ka ho cih:</para>
  <para style="q1">Aning nynh kae kha, “Nang tuh</para>
  <para style="q2">ka ccapaw nynh na thua;</para>
  <para style="q2">atunin nang kha kae saah vae.<note caller="-" style="x"><char style="xo" closed="false">2.7: </char><char style="xt" closed="false"><ref loc="ACT 13:33">Loc 13.33</ref>; <ref loc="HEB 1:5">Heb 1.5</ref>, <ref loc="HEB 5:5">5.5</ref></char></note></para>
  <para style="q1">
    <verse number="8" style="v" />Yn ngiakuh lah, minphuin hae hynh</para>
  <para style="q2">na rho lang kae pya cih,</para>
  <para style="q2">laephi athangnaw cia na pee cih.</para>
  <para style="q1">
    <verse number="9" style="v" />Minmin kha sivaw hoitang te</para>
  <para style="q2">na uk cih hae zah,</para>
  <para style="q1">laephi ang hawte zoihtatyh lan</para>
  <para style="q2">na koi cih hae,” yn cipya.<note caller="-" style="x"><char style="xo" closed="false">2.9: </char><char style="xt" closed="false"><ref loc="REV 2:26-27">Bya 2.26-27</ref>, <ref loc="REV 12:5">12.5</ref>, <ref loc="REV 19:15">19.15</ref></char></note></para>
  <para style="q1">
    <verse number="10" style="v" />Pou siapharan hae, hawrarih lan</para>
  <para style="q2">umtua oh.</para>
  <para style="q1">Pou laephi uktu bawi hae,</para>
  <para style="q2">raeringnaw pyanaw hynh lawku tua oh.</para>
  <para style="q1">
    <verse number="11" style="v" />
    <char style="nd">Bawipaw </char> rya kha</para>
  <para style="q2">rawrinaw te lah oh lah,</para>
  <para style="q2">thyngkute <verse number="12" style="v" />a malang bakhung oh,</para>
  <para style="q1">tuhkhyhze tuh a thinria cih zah</para>
  <para style="q2">laanpi kya na roh cih oh;</para>
  <para style="q1">pawccecize a thinrianaw tuh</para>
  <para style="q2">maee lang palou arua.</para>
  <para style="q1">Amaw kya a rekuh hae paw balyn tuh</para>
  <para style="q2">lungtua hae paw nynh thua.</para>
  <chapter number="3" style="c" />
  <para style="s1">
    <note caller="-" style="x">
      <char style="xo" closed="false">3 Abyalu: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 15:13-17:22">2Sa 15.13—17.22</ref>
      </char>
    </note>Rhaw laku kya Pachia Doliakunaw<note caller="+" style="f"><char style="fr" closed="false">3 Abyalu: </char><char style="ft" closed="false">David nynh a ccapaw Absalom kyate a ccue lya a phuapaw hlaw.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, ka rhaw hae tuh</para>
  <para style="q2">paw alung hae baban! Kae kha rawsete</para>
  <para style="q2">yn thonuakuh hae paw myarya alung;</para>
  <para style="q1">
    <verse number="2" style="v" />“Pachia nynh bawm lan khyh,” cite</para>
  <para style="q2">ka konglang a hopaw patae a um hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Thuasalama, pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">nang tuh yn thungkhawpaw</para>
  <para style="q1">khawriaphua na thua zah,</para>
  <para style="q2">ka phu-enaw te ka lu</para>
  <para style="q2">yn hangthungpaw nynh na thua.</para>
  <para style="q1">
    <verse number="4" style="v" />
    <char style="nd">Bawipaw </char> kalan thawte</para>
  <para style="q2">ka sia zah,</para>
  <para style="q2">athyaapaw a mua kyate yn leih.</para>
  <para style="q1">
    <verse number="5" style="v" />
    <char style="nd">Bawipaw </char> nynh yn bawm keiccuze</para>
  <para style="q2">ka huekuh zah ka ihtheih; te bua ka tho.</para>
  <para style="q1">
    <verse number="6" style="v" />Kae kha yn rawse hae zah</para>
  <para style="q2">yn koihlu hae paw</para>
  <para style="q1">ccungccaw athong-asan hae kha</para>
  <para style="q2">ka rih khyh hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Pou <char style="nd">Bawipaw </char>, thoku tua!</para>
  <para style="q2">Pou ka Pachia, yn khumtua!</para>
  <para style="q1">Pawccecize ka rhaw hae balyn kha</para>
  <para style="q2">mih nakalia na bia hae zah,</para>
  <para style="q1">ccungccaw hoylei hae paw haw kha</para>
  <para style="q2">na khya hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Khumnaw tuh <char style="nd">Bawipaw </char> kya-e nynh thua;</para>
  <para style="q2">na hythuanaw tuh</para>
  <para style="q1">na ccungccaw hae tungvaw um sah!</para>
  <chapter number="4" style="c" />
  <para style="s1">Rhaw hae kyate Luenaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou yn dingsahtupaw ka Pachia,</para>
  <para style="q2">kae ko vae ze yn oitua!</para>
  <para style="q1">Ka lungvawsaw lyakhe</para>
  <para style="q2">ngaengannaw nae pya.</para>
  <para style="q1">Thaw yn ccih lah,</para>
  <para style="q2">ka sawsangnaw hynh yn ngaepya tua.</para>
  <para style="q1">
    <verse number="2" style="v" />Pou ccungccaw hae,</para>
  <para style="q2">hohseciamou ka phu-enaw kha</para>
  <para style="q1">maethya nae lah ung cih oh?</para>
  <para style="q2">Hohseciamou accakaepaw bya kha</para>
  <para style="q1">na ry cih oh zah,</para>
  <para style="q2">hynbya kha na ccung cih oh?</para>
  <para style="q1">
    <verse number="3" style="v" />
    <char style="nd">Bawipaw </char> nynh a lungzipaw kha</para>
  <para style="q2">amaw hanlan taetynte</para>
  <para style="q1">a nung vae cipaw nyh oh;</para>
  <para style="q2">ka ko ze <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">yn thaepya.</para>
  <para style="q1">
    <verse number="4" style="v" />Nae thin he aria ze,</para>
  <para style="q2">seinaw rae nan oh;</para>
  <para style="q1">e hynh nae ikhung kya</para>
  <para style="q2">daebabi lan um oh lah, tuatua oh.<note caller="-" style="x"><char style="xo" closed="false">4.4: </char><char style="xt" closed="false"><ref loc="EPH 4:26">Efe 4.26</ref></char></note></para>
  <para style="q1">
    <verse number="5" style="v" />Ahmepaw silawnaw kha rae oh lah,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha doliakuh oh.</para>
  <para style="q1">
    <verse number="6" style="v" />“Hum nynh mou ahoypaw kha</para>
  <para style="q2">oun langsapakuh cih?</para>
  <para style="q2">Pou <char style="nd">Bawipaw </char>, na mitmae awnaw kha</para>
  <para style="q1">kae tungvaw awtua sah!”</para>
  <para style="q2">cite a hopaw patae a um hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Looh te misutui patae hoi hae zah</para>
  <para style="q2">mih lungtuanaw laeze,</para>
  <para style="q1">ka thinlung kya lungtuanaw</para>
  <para style="q2">nae pyapaw tuh alehua.</para>
  <para style="q1">
    <verse number="8" style="v" />Ka huekuh cih zah daebabi lan</para>
  <para style="q2">ka ihtheih cih;</para>
  <para style="q1">pawccecize pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">nang rou nynh khyndadyh lan</para>
  <para style="q1">nae umsah.</para>
  <chapter number="5" style="c" />
  <para style="s1">Khynnaw elang <char style="nd">Bawipaw </char> Doliakunaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, ka bya hynh</para>
  <para style="q2">yn ngaepya tua lah,</para>
  <para style="q2">ka hawkhaekunaw roi hynh</para>
  <para style="q2">yn thaepya tua.</para>
  <para style="q1">
    <verse number="2" style="v" />Ka Siapharan te ka Pachia,</para>
  <para style="q2">na kalan saw ka sang zah,</para>
  <para style="q2">ka siapaw roi hynh yn ngaepya tua.</para>
  <para style="q1">
    <verse number="3" style="v" />Pou <char style="nd">Bawipaw </char>, awkhua ccyh kya</para>
  <para style="q2">ka roi kha na thae;</para>
  <para style="q1">awkhua ccyh kya kae ngia zah</para>
  <para style="q2">kae ngaw.</para>
  <para style="q1">
    <verse number="4" style="v" />Pawccecize nang tuh</para>
  <para style="q2">hoyleinaw raenaw kya</para>
  <para style="q1">a lungrythuapaw Pachia</para>
  <para style="q2">na thua khyh;</para>
  <para style="q1">ahoy leipaw tuh na kya</para>
  <para style="q2">umbua lan khyh.</para>
  <para style="q1">
    <verse number="5" style="v" />Alysakuhpaw tuh na malang</para>
  <para style="q2">thadyn lan khyh;</para>
  <para style="q1">ahoy leipaw a rae hae paw kha</para>
  <para style="q2">na hua hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Hynbya a ho hae paw kha na ro hae;</para>
  <para style="q2">ccungccaw a theih rypaw te</para>
  <para style="q1">ahyn-ahu hae paw kha</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh na hua hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Thuasalama kae tuh atynpaw</para>
  <para style="q2">na sungsahnaw alepaw liate</para>
  <para style="q1">na inn lungkhu lang ka tee cih,</para>
  <para style="q2">namaw rawrite athyaapaw</para>
  <para style="q2">na beikinn kyakhe kae beik cih.</para>
  <para style="q1">
    <verse number="8" style="v" />Pou <char style="nd">Bawipaw </char>, ka rhaw hae keiccuze</para>
  <para style="q2">na dingnaw kyakhe yn cciakhae;</para>
  <para style="q1">na laanpi kha ka malang</para>
  <para style="q2">yn lawsahpya tua.</para>
  <para style="q1">
    <verse number="9" style="v" />Ka rhaw hae khalang kya</para>
  <para style="q2">byaccing um khyh;</para>
  <para style="q2">mih thinlung tuh ronaw nynh thua;</para>
  <para style="q1">mih lotharue tuh ahungkuhpaw</para>
  <para style="q2">shaw nynh thua.</para>
  <para style="q1">mih lae khate nawpalya lan</para>
  <para style="q2">a lingthya hae.<note caller="-" style="x"><char style="xo" closed="false">5.9: </char><char style="xt" closed="false"><ref loc="ROM 3:13">Rom 3.13</ref></char></note></para>
  <para style="q1">
    <verse number="10" style="v" />Pou Pachia, mih seinaw mee kha</para>
  <para style="q2">ingsah hae;</para>
  <para style="q1">mih tuakunaw keiccu</para>
  <para style="q2">khuliakuh hae sah;</para>
  <para style="q1">mih cyiseimenaw alung keiccu thuasah,</para>
  <para style="q2">nang ae rawse keiccu hae thuasah</para>
  <para style="q1">minmin kha ccaring dee hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Na kya a rekuh hae paw balyn tuh</para>
  <para style="q2">mih lungtua sah;</para>
  <para style="q1">lungpawte hlawsah zungzae hae sah.</para>
  <para style="q2">Na min a sungsah hae paw tuh</para>
  <para style="q1">namaw liate mih lung atua nawlan,</para>
  <para style="q2">minmin kha thungkhaw hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Pou <char style="nd">Bawipaw </char>, adingpaw kha</para>
  <para style="q2">hythua na pya;</para>
  <para style="q1">na thawccinaw khate</para>
  <para style="q2">khawriaphua hawte na thungkhaw.</para>
  <chapter number="6" style="c" />
  <para style="s1">Vawsaw Ccyh lya Sawsangnaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, thinriate</para>
  <para style="q2">beih yn pe nan,</para>
  <para style="q2">thinsote beih yn thuihei nan.<note caller="-" style="x"><char style="xo" closed="false">6.1: </char><char style="xt" closed="false"><ref loc="PSA 38:1">Sam 38.1</ref></char></note></para>
  <para style="q1">
    <verse number="2" style="v" />Pou <char style="nd">Bawipaw </char>, ka thawzya keiccuze</para>
  <para style="q2">thaw beih yn ccih;</para>
  <para style="q1">Pou <char style="nd">Bawipaw </char>, ka ru hae tuh</para>
  <para style="q2">myarya rih hae zah,</para>
  <para style="q2">a thyngku hae keiccuze beih yn dansah.</para>
  <para style="q1">
    <verse number="3" style="v" />Ka hiinnaw mah myarya ri lanpaw kha a tung,</para>
  <para style="q2">Pou <char style="nd">Bawipaw </char> hohseciamou na um cih?</para>
  <para style="q1">
    <verse number="4" style="v" />Pou <char style="nd">Bawipaw </char>, yn ki lah,</para>
  <para style="q2">ka hiinnaw hynh yn khumtua;</para>
  <para style="q2">atynpaw na sungsahnaw te yn khumtua.</para>
  <para style="q1">
    <verse number="5" style="v" />Pawccecize chinaw kya tuh</para>
  <para style="q2">nang kha liathuinaw um khyh;</para>
  <para style="q1">Michi khua kya tuh hum nynh mou</para>
  <para style="q2">ae thehoysah kho cih?</para>
  <para style="q1">
    <verse number="6" style="v" />Hawkhaekute ka thaw myarya bang vae;</para>
  <para style="q2">zi takyh ka ikhung tuh mitphi te acia;</para>
  <para style="q2">ka iphae tuh ka mitphi te ka ciasah.</para>
  <para style="q1">
    <verse number="7" style="v" />Ngaethyanaw keiccuze</para>
  <para style="q2">ka mit tuh phin zah,</para>
  <para style="q1">ka rhaw hae balyn keiccuze</para>
  <para style="q2">ngaw ka muih kho khyh.</para>
  <para style="q1">
    <verse number="8" style="v" />Nanning hoyleinaw rya</para>
  <para style="q2">a lah hae paw balyn,</para>
  <para style="q1">ka kyate cceih oh,</para>
  <para style="q2">pawccecize <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">ka rawnaw roi kha a thae vae.<note caller="-" style="x"><char style="xo" closed="false">6.8: </char><char style="xt" closed="false"><ref loc="MAT 7:23">Mat 7.23</ref>; <ref loc="LUK 13:27">Luk 13.27</ref></char></note></para>
  <para style="q1">
    <verse number="9" style="v" />
    <char style="nd">Bawipaw </char> nynh bawmnaw</para>
  <para style="q2">ka ngiakupaw kha a thae vae;</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh ka sawsangnaw kha yn ccoupya.</para>
  <para style="q1">
    <verse number="10" style="v" />Ka rhaw hae balyn tuh</para>
  <para style="q2">mih maethah cih zah,</para>
  <para style="q1">myarya ri lanpaw kha a tung cih hae;</para>
  <para style="q2">a ccue cih hae zah, vaekheihmawte</para>
  <para style="q1">maethya a bongkuh cih hae.</para>
  <chapter number="7" style="c" />
  <para style="s1">Bawmnaw Ngiakunaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char> ka Pachia,</para>
  <para style="q2">namaw kya ka rekuh;</para>
  <para style="q1">yn deehuitu hae balyn kyate</para>
  <para style="q2">yn khum lah, yn luesah,</para>
  <para style="q1">
    <verse number="2" style="v" />tuhkhyhze tuh yn khum lanpaw um leite,</para>
  <para style="q2">kae kha dae yn sue cih hae,</para>
  <para style="q1">chindeih hawte kae kha</para>
  <para style="q2">zoihtatyh lan yn pae cih hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Pou <char style="nd">Bawipaw </char> ka Pachia,</para>
  <para style="q2">tuhcite ka cyi lanze thuasah,</para>
  <para style="q2">ka kuih kya cyiseinaw a um ze thuasah,</para>
  <para style="q1">
    <verse number="4" style="v" />ka ruiban tungvaw vawsawnaw pyate</para>
  <para style="q2">ka liaru ze thuasah,</para>
  <para style="q1">ka rhawpaw kha akonglang um leite</para>
  <para style="q2">ka luade ze thuasah,</para>
  <para style="q1">
    <verse number="5" style="v" />ka rhawpaw nynh yn dee sah lah,</para>
  <para style="q2">yn phah sah,</para>
  <para style="q1">ka hiinnaw hynh laephi kya</para>
  <para style="q2">yn syde sah lah,</para>
  <para style="q1">ka muisaw hynh laenoi kya</para>
  <para style="q2">yn nung sah.</para>
  <para style="q1">
    <verse number="6" style="v" />Pou <char style="nd">Bawipaw </char>, thinriate thoku tua;</para>
  <para style="q2">ka rhaw hae thinrianaw kha</para>
  <para style="q1">rawse khylan thawzung thuatua;</para>
  <para style="q2">Pou ka Pachia, kamaw hanlan</para>
  <para style="q2">thaekuh lah, byapianaw kha raetua.</para>
  <para style="q1">
    <verse number="7" style="v" />Ccungccaw zapi nynh sueluakute</para>
  <para style="q2">nang kha ae koihlu hae sah lah,</para>
  <para style="q2">ahangnaw kyate uk hae.</para>
  <para style="q1">
    <verse number="8" style="v" />
    <char style="nd">Bawipaw </char> nynh ccungccaw hae kha</para>
  <para style="q2">bya a pia hae;</para>
  <para style="q1">Pou <char style="nd">Bawipaw </char>, ka dingnaw thyhte thuasah,</para>
  <para style="q2">ka hoynaw thyhte thuasah</para>
  <para style="q2">bya yn piatua.</para>
  <para style="q1">
    <verse number="9" style="v" />Ccungccaw hoylei hae paw kya-e</para>
  <para style="q2">hoyleinaw kha thangsah lah,</para>
  <para style="q2">miding hae kha tynsah tua hae,</para>
  <para style="q1">Pou adingpaw Pachia,</para>
  <para style="q2">nang nynh tuh thinlung te</para>
  <para style="q2">tuanaw kha phe na do mamia.<note caller="-" style="x"><char style="xo" closed="false">7.9: </char><char style="xt" closed="false"><ref loc="REV 2:23">Bya 2.23</ref></char></note></para>
  <para style="q1">
    <verse number="10" style="v" />Pachia tuh ka khawriaphua nynh thua,</para>
  <para style="q2">thinlung a ding hae paw kha</para>
  <para style="q2">a khum hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Pachia tuh adingpaw byapiatu thua zah,</para>
  <para style="q2">ccungccaw hoyleipaw kha</para>
  <para style="q2">zungzae thin a rianua paw Pachia nynh thua.</para>
  <para style="q1">
    <verse number="12" style="v" />Lukhakheit tuh a ngaesiku khyh ze,</para>
  <para style="q2">Pachia nynh thaloi kha</para>
  <para style="q1">a tawnuakuh cih;</para>
  <para style="q2">a li kha sue zah, phang a ee;</para>
  <para style="q1">
    <verse number="13" style="v" />chianawpaw a zunghe hae kha</para>
  <para style="q2">a paccynku vae,</para>
  <para style="q2">a the kha maee lang a ruasah vae.</para>
  <para style="q1">
    <verse number="14" style="v" />Dotua oh, minmin nynh</para>
  <para style="q2">hoyleinaw kha a tuaku hae,</para>
  <para style="q1">ahoy leipaw paccynkunaw kha</para>
  <para style="q2">ccaaw lang poi hae zah,</para>
  <para style="q2">hynnaw kha ccaaw lang a saah hae.</para>
  <para style="q1">
    <verse number="15" style="v" />Hunghua kha myarya khu lan</para>
  <para style="q2">thae hae zah,</para>
  <para style="q1">a thae hae paw hunghua</para>
  <para style="q2">lungkhu langkhe mimaw tuh</para>
  <para style="q2">a ccah hae.</para>
  <para style="q1">
    <verse number="16" style="v" />Mih rysawthyanaw tuh</para>
  <para style="q2">mimaw lu kalan yn ki zah,</para>
  <para style="q1">mih puathonaw tuh</para>
  <para style="q2">mih lu vawlan khe accah.</para>
  <para style="q1">
    <verse number="17" style="v" />
    <char style="nd">Bawipaw </char> tuh a dingnaw keiccuze</para>
  <para style="q2">lungtuabya ka ho cih zah,</para>
  <para style="q1">Ahang Huaccepaw <char style="nd">Bawipaw </char> min kha</para>
  <para style="q2">hlaw te the ka hoysah cih.</para>
  <chapter number="8" style="c" />
  <para style="s1">Pachia Phu-enaw te Ccungccaw Sung-enaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, kae Bawipaw,</para>
  <para style="q2">na min tuh laephi vawlan balyn</para>
  <para style="q1">pawcih baban mou a lesae!</para>
  <para style="q1">Na phu-enaw kha vaawlui luki khe</para>
  <para style="q2">na nung vae.</para>
  <para style="q1">
    <verse number="2" style="v" />Rhaw hae te liarutu hae kha</para>
  <para style="q2">daesah khylan,</para>
  <para style="q1">na rhaw hae keiccuze imua taraw hae te</para>
  <para style="q2">nosi hae munglae kyakhe</para>
  <para style="q1">thungnaw kha na pya hae.<note caller="-" style="x"><char style="xo" closed="false">8.2: </char><char style="xt" closed="false"><ref loc="MAT 21:16">Mat 21.16</ref></char></note></para>
  <para style="q1">
    <verse number="3" style="v" />Na kuihdung nynh a raepaw vaawlui te</para>
  <para style="q2">na tynsah hae paw sawpaw te</para>
  <para style="q2">awsi hae kha he ka do tuh,</para>
  <para style="q1">
    <verse number="4" style="v" />ccungccaw hynh</para>
  <para style="q2">paw athua keiccu mou na peki?</para>
  <para style="q1">Ccungccaw maesae hung athuapaw hynh</para>
  <para style="q2">pawccemou na do-oih?<note caller="-" style="x"><char style="xo" closed="false">8.4: </char><char style="xt" closed="false"><ref loc="JOB 7:17-18">Job 7.17-18</ref>; <ref loc="PSA 144:3">Sam 144.3</ref>; <ref loc="HEB 2:6-8">Heb 2.6-8</ref></char></note></para>
  <para style="q1">
    <verse number="5" style="v" />Ccungccaw hynh vaawccungccaw hae laeze</para>
  <para style="q2">ccapyh anehua lante na rae vae,</para>
  <para style="q1">sawtuanaw te phu-enaw lukhung kha</para>
  <para style="q2">na khungsah.</para>
  <para style="q1">
    <verse number="6" style="v" />Na rae hae paw tungvaw</para>
  <para style="q2">a uktu lang na rae;<note caller="-" style="x"><char style="xo" closed="false">8.6: </char><char style="xt" closed="false"><ref loc="1CO 15:27">1Ko 15.27</ref>; <ref loc="EPH 1:22">Efe 1.22</ref>; <ref loc="HEB 2:8">Heb 2.8</ref></char></note></para>
  <para style="q1">
    <verse number="7" style="v" />tuu te vaetua,</para>
  <para style="q2">te ramkaw e ramsaw,</para>
  <para style="q1">
    <verse number="8" style="v" />vaawlang e pavaw hae,</para>
  <para style="q2">te rili kya-e ngasaw hae,</para>
  <para style="q1">rili lungkhu a umpaw miakaw,</para>
  <para style="q2">atyn-are balyn kha</para>
  <para style="q2">a ccu kaw kya na nung vae.</para>
  <para style="q1">
    <verse number="9" style="v" />Pou <char style="nd">Bawipaw </char>, kae Bawipaw,</para>
  <para style="q2">na min tuh laephi vaw balyn</para>
  <para style="q1">pawcih baban alesae!</para>
  <chapter number="9" style="c" />
  <para style="s1">Pachia Huhan te Dingnaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> kha ka thinlung balyn te</para>
  <para style="q2">ka thehoysah cih;</para>
  <para style="q1">ngaeang lan umpaw</para>
  <para style="q2">na raepaw balyn kha ka ho cih.</para>
  <para style="q1">
    <verse number="2" style="v" />Na tungvaw myarya ka lungtua cih;</para>
  <para style="q2">Pou Ahang Huaccepaw,</para>
  <para style="q1">na min kha thehoysahte</para>
  <para style="q2">hlaw ka sah cih.</para>
  <para style="q1">
    <verse number="3" style="v" />Ka rhaw hae tuh nulang</para>
  <para style="q2">he a ki hae te,</para>
  <para style="q1">na malang khe khuliakuh hae zah</para>
  <para style="q2">a chih hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Pawccecize kae kha pankhawte</para>
  <para style="q2">bya na pia vae;</para>
  <para style="q1">bawitungkhung kya na haung zah,</para>
  <para style="q2">adingpaw byapianaw kha na rae vae.</para>
  <para style="q1">
    <verse number="5" style="v" />Pachia beik leipaw minphuin hae kha</para>
  <para style="q2">na thuihei vae hae,</para>
  <para style="q1">ccungccaw hoylei hae paw kha</para>
  <para style="q2">na ro vae hae;</para>
  <para style="q1">mih min kha zungzae te</para>
  <para style="q2">zungzae cia na the vae.</para>
  <para style="q1">
    <verse number="6" style="v" />Rhaw hae tuh zungzae ronaw kya</para>
  <para style="q2">a zo vae hae;</para>
  <para style="q1">mih khuapi hae kha</para>
  <para style="q2">phe na ro mamia vae hae;</para>
  <para style="q1">minmin syntawnawpaw miakaw tuh</para>
  <para style="q2">azo vae.</para>
  <para style="q1">
    <verse number="7" style="v" />Thuasalama <char style="nd">Bawipaw </char> bawitungkhung tuh</para>
  <para style="q2">zungzae atyn;</para>
  <para style="q1">byapianaw hanlan a bawitungkhung kha</para>
  <para style="q2">a tynsah vae.</para>
  <para style="q1">
    <verse number="8" style="v" />Laephi kha dingnaw te bya a pia;</para>
  <para style="q2">ccungccaw hae kha laesah leite</para>
  <para style="q1">bya a pia hae.</para>
  <para style="q1">
    <verse number="9" style="v" />
    <char style="nd">Bawipaw </char> tuh tuaasahkunaw</para>
  <para style="q2">a teing hae paw hanlan</para>
  <para style="q1">rekunaw thua zah,</para>
  <para style="q2">vawsaw tung lya rekunaw nynh thua.</para>
  <para style="q1">
    <verse number="10" style="v" />Te na min a nyh hae paw nynh</para>
  <para style="q2">nang kha ae doliaku hae,</para>
  <para style="q1">pawccecize, pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">nang ae ccung hae paw kha</para>
  <para style="q1">na vua boi khyh hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Zion kya umpaw <char style="nd">Bawipaw </char> kha</para>
  <para style="q2">hlaw te thehoysah oh.</para>
  <para style="q1">a ryalaw kha minphuin hae kalan hopah oh.</para>
  <para style="q1">
    <verse number="12" style="v" />Pawccecize chiise a luasahtu hae kha</para>
  <para style="q2">tyty nyh hae zah,</para>
  <para style="q1">vawsaw a tung hae paw siaruanaw kha</para>
  <para style="q2">ningpah khyh hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Pou <char style="nd">Bawipaw </char>, thaw beih yn ccitua.</para>
  <para style="q2">Yn hua hae paw nynh</para>
  <para style="q1">yn teingsah hae paw hynh</para>
  <para style="q2">yn muihpya tua;</para>
  <para style="q1">nang tuh chinaw kyate</para>
  <para style="q2">yn luesahtu nynh na thua,</para>
  <para style="q1">
    <verse number="14" style="v" />tetuh na thehoynaw balyn kha</para>
  <para style="q2">Zion ccanung koikua hae kyakhe</para>
  <para style="q1">ka ho cih,</para>
  <para style="q2">nae khumnaw keiccuze ka lungtua cih.</para>
  <para style="q1">
    <verse number="15" style="v" />Pachia nyh leipaw minphuin hae tuh</para>
  <para style="q2">mimaw nynh a thae hae paw</para>
  <para style="q1">hunghua lungkhu lang a ccah vae hae;</para>
  <para style="q2">a sya hae paw kaang kyakhe</para>
  <para style="q2">mimaw ccu tuh a kae vae.</para>
  <para style="q1">
    <verse number="16" style="v" />
    <char style="nd">Bawipaw </char> nynh a byapianaw khate</para>
  <para style="q2">amaw toulou kha a langsaku vae;</para>
  <para style="q1">ccungccaw hoylei hae paw tuh</para>
  <para style="q2">mimaw kuih te a law hae paw</para>
  <para style="q1">ryalaw kyakhe kaang a kae hae.</para>
  <para style="q1">
    <verse number="17" style="v" />Ccungccaw hoylei hae paw te</para>
  <para style="q2">Pachia a ning hae paw</para>
  <para style="q1">minphuin hae balyn tuh</para>
  <para style="q2">michi khua lang a cceih cih hae.</para>
  <para style="q1">
    <verse number="18" style="v" />Ahoboupaw ccungccaw hae kha</para>
  <para style="q2">palei ning thua lan khyh zah,</para>
  <para style="q1">ryachi hae tuh ngaehoinaw hoi leite</para>
  <para style="q2">um zungzae lan khyh hae.</para>
  <para style="q1">
    <verse number="19" style="v" />Pou <char style="nd">Bawipaw </char>, thoku tua,</para>
  <para style="q2">ccungccaw nynh nang kha</para>
  <para style="q1">ae tae nan sah;</para>
  <para style="q2">minphuin hae tuh na malang khe</para>
  <para style="q2">byapianaw ing hae sah.</para>
  <para style="q1">
    <verse number="20" style="v" />Pou <char style="nd">Bawipaw </char>, minmin kha</para>
  <para style="q2">mih thinphangsah tua hae;</para>
  <para style="q1">ccungccaw nynh hung kae thua</para>
  <para style="q2">cipaw nyhkuh hae sah.</para>
  <chapter number="10" style="c" />
  <para style="s1">Lue khylan Sawsangnaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, pawccemou asawnaw kya na thadyn?</para>
  <para style="q2">Pawccemou vawsaw ccyh lya na reku?</para>
  <para style="q1">
    <verse number="2" style="v" />Ccungccaw hoy leipaw nynh</para>
  <para style="q2">lysakute a ryachipaw kha a tuaa a sah,</para>
  <para style="q1">a paccyn hae paw thyaruhnaw kyakhe</para>
  <para style="q2">kaangkae hae sah.</para>
  <para style="q1">
    <verse number="3" style="v" />ccungccaw hoy leipaw tuh</para>
  <para style="q2">a thinlung rynaw kyakhe a pookuh,</para>
  <para style="q1">a karankuhpaw ccungccaw nynh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha thyalaw zah a vua.</para>
  <para style="q1">
    <verse number="4" style="v" />Ccungccaw hoy leipaw nynh</para>
  <para style="q2">a lysaku keiccuze, “Pachia nynh</para>
  <para style="q1">muih lan khyh,” a ci;</para>
  <para style="q2">a tuapaw balyn tuh, “Pachia um khyh,”</para>
  <para style="q1">cipaw hynh nynh thua.</para>
  <para style="q1">
    <verse number="5" style="v" />A ryalaw tuh a laan a sui pei a ua;</para>
  <para style="q2">Pachia byapianaw kha thaethya kho khyh;</para>
  <para style="q2">a rhaw hae kha a sarya hae.</para>
  <para style="q1">
    <verse number="6" style="v" />A thinlung kyakhe,</para>
  <para style="q2">“Ka shung boi lan khyh;</para>
  <para style="q1">she takyh kya vawsawnaw</para>
  <para style="q2">ka tung boi lan khyh,” cite a tuaku.</para>
  <para style="q1">
    <verse number="7" style="v" />A khalang tuh thyalawnaw bya,</para>
  <para style="q2">hynbya te tuaasahnaw bya te nynh phe abia;</para>
  <para style="q1">a lae kya rysawthyanaw te</para>
  <para style="q2">hoyleinaw a um.<note caller="-" style="x"><char style="xo" closed="false">10.7: </char><char style="xt" closed="false"><ref loc="ROM 3:14">Rom 3.14</ref></char></note></para>
  <para style="q1">
    <verse number="8" style="v" />Khua kyaze rekunaw hmin kyakhe</para>
  <para style="q2">buh zah,</para>
  <para style="q1">a sei leipaw ccungccaw kha a chia.</para>
  <para style="q1">Bawmtu a hoi leipaw kha aruh lante</para>
  <para style="q2">zya a buhkhaw;</para>
  <para style="q1">
    <verse number="9" style="v" />chindeih hawte rekunaw hmin kyakhe</para>
  <para style="q2">ccungccaw kha a buh;</para>
  <para style="q1">a ryachipaw kha kyng khylan a buh;</para>
  <para style="q2">a ryachipaw kha kyng zah,</para>
  <para style="q1">a kaang kalan a sue.</para>
  <para style="q1">
    <verse number="10" style="v" />Tuhcite vawsaw a tungpaw tuh</para>
  <para style="q2">a huekuh,</para>
  <para style="q1">te bawmtu hoi leipaw tuh</para>
  <para style="q2">a thawsaepaw keiccuze a khuliakuh.</para>
  <para style="q1">
    <verse number="11" style="v" />A thawsaepaw nynh a thinlung kyakhe,</para>
  <para style="q2">“Pachia nynh phe a ning vae,</para>
  <para style="q1">a mae tuh ccanglang phe hawi vae,</para>
  <para style="q2">e hynh kharouh muih vae lan khyh,” cite a tuaku.</para>
  <para style="q1">
    <verse number="12" style="v" />Pou <char style="nd">Bawipaw </char>, pou Pachia,</para>
  <para style="q2">thoku tua lah, na kuih hangtua;</para>
  <para style="q1">tuaasahkunaw a teing hae paw kha</para>
  <para style="q2">ning nan hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Ccungccaw hoylei hae paw nynh</para>
  <para style="q2">Pachia kha maeleihtawku te,</para>
  <para style="q1">“Pachia nynh de oun tah lan khyh,”</para>
  <para style="q2">cite pawccemou mih thinlung kya</para>
  <para style="q1">a tuakuh cih hae?</para>
  <para style="q1">
    <verse number="14" style="v" />Thuasalama nang nynh tuh</para>
  <para style="q2">phe na muih! Mih vawsawnaw te</para>
  <para style="q1">mih ngaethyanaw kha na muih zah,</para>
  <para style="q2">bawm khylan na paccynkuh zungzae;</para>
  <para style="q1">bawmtu hoi leipaw nynh</para>
  <para style="q2">amaw toulou kha na kalan a pyaku;</para>
  <para style="q1">nang tuh ngawraw bawmtu nynh na thua.</para>
  <para style="q1">
    <verse number="15" style="v" />Ccungccaw hoy leipaw te</para>
  <para style="q2">misei hae kuih kha khyatua;</para>
  <para style="q1">mih hoyleinaw kha</para>
  <para style="q2">pong na muih makhia ccungpya tua hae.</para>
  <para style="q1">
    <verse number="16" style="v" />
    <char style="nd">Bawipaw </char> tuh zungzae te</para>
  <para style="q2">zungzae cia siapharan nynh thua;</para>
  <para style="q1">Pachia beik leipaw minphuin hae tuh</para>
  <para style="q2">a ram kyate ro athua cih hae.</para>
  <para style="q1">
    <verse number="17" style="v" />Pou <char style="nd">Bawipaw </char>, thinlung a nepaw nynh</para>
  <para style="q2">a rypaw kha na thaepah cih;</para>
  <para style="q2">mih lungthaw na saesah cih hae.</para>
  <para style="q1">
    <verse number="18" style="v" />Ccungccaw nynh a laephi kyate</para>
  <para style="q2">myarya ri lan umpaw kha</para>
  <para style="q1">bua a langsaku khyh nawlan,</para>
  <para style="q2">ngawraw te tuaasahnaw</para>
  <para style="q1">a teing hae paw hanlan</para>
  <para style="q2">dingnaw raepya khylan,</para>
  <para style="q1">a siaruanaw hae kha na thaepya hae.</para>
  <chapter number="11" style="c" />
  <para style="s1">
    <char style="nd">Bawipaw </char> Doliakunaw Hlaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> kya ka rekuh;</para>
  <para style="q2">“Pavaw hawte mua lang zoutua;</para>
  <para style="q1">
    <verse number="2" style="v" />pawccecize ccungccaw hoylei</para>
  <para style="q2">hae paw nynh</para>
  <para style="q1">ccungccaw hoypaw hae kha kaw khylan</para>
  <para style="q2">amohnaw khe mih li kha sue hae zah,</para>
  <para style="q2">mih the kha li kya a toikuh vae hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Aleihpaw tuh phe aro vae ze,</para>
  <para style="q2">ccungccaw hoypaw nynh</para>
  <para style="q1">pawmou a cyih kho vae cih?”</para>
  <para style="q2">cite pawtemou nae hopya kho.</para>
  <para style="q1">
    <verse number="4" style="v" />
    <char style="nd">Bawipaw </char> tuh a beikinnthyaa kya a um;</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kya-e bawitungkhung tuh</para>
  <para style="q1">vaawram kya a um.</para>
  <para style="q2">Ccungccaw hae kha do hae zah</para>
  <para style="q2">a cyi hae paw kha phe a ny mamia.</para>
  <para style="q1">
    <verse number="5" style="v" />
    <char style="nd">Bawipaw </char> nynh ccungccaw hoypaw te</para>
  <para style="q2">ccungccaw hoy leipaw kha</para>
  <para style="q1">a syntawtua hae,</para>
  <para style="q2">te a muisaw nynh puathonaw</para>
  <para style="q2">a rypaw kha a hua.</para>
  <para style="q1">
    <verse number="6" style="v" />Ccungccaw hoy leipaw tungvaw khe</para>
  <para style="q2">zaezae epaw maee-e te ke maee-e kha</para>
  <para style="q1">khuaa lang a rawsah;</para>
  <para style="q2">myarya sopaw khisan khate de a tah hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Pawccecize <char style="nd">Bawipaw </char> tuh</para>
  <para style="q2">adingpaw thua zah,</para>
  <para style="q1">adingpaw cyisahnaw kha a ry;</para>
  <para style="q2">adingpaw ccungccaw nynh</para>
  <para style="q1">amaw mitmae kha a muih cih.</para>
  <chapter number="12" style="c" />
  <para style="s1">Bawmnaw Ngianaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, beih yn bawmtua,</para>
  <para style="q2">pawccecize ccungccaw hoypaw</para>
  <para style="q1">um vae khyh;</para>
  <para style="q2">ccungccaw hae kya a lungzipaw</para>
  <para style="q2">phe zo vae hae.</para>
  <para style="q1">
    <verse number="2" style="v" />Lu kheit te lu kheit hynbya a hoku hae;</para>
  <para style="q2">nawpalipaw mung te</para>
  <para style="q1">thinlung apheipaw kha hoite bya a ho hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Nawpalipaw mung,</para>
  <para style="q2">myarya apookuhpaw lae,</para>
  <para style="q1">
    <verse number="4" style="v" />“Ah lae te ah tae cih oh;</para>
  <para style="q2">ah mung tuh ahmaw kya-e nynh thua,</para>
  <para style="q1">aening bawipaw tuh hummou?” cite</para>
  <para style="q2">a ho hae paw kha</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh vua hae sah.</para>
  <para style="q1">
    <verse number="5" style="v" />
    <char style="nd">Bawipaw </char> nynh, “Ryachi hae nynh</para>
  <para style="q2">tuaasahnaw teing hae zah,</para>
  <para style="q1">riathae hae paw nynh</para>
  <para style="q2">a hawkhaeku hae keiccuze,</para>
  <para style="q1">atu kae thokuh cih.</para>
  <para style="q2">Minmin nynh a ry hae paw</para>
  <para style="q1">khynnaw kyakhe minmin kha</para>
  <para style="q2">ka nung cih hae,” a ci.</para>
  <para style="q1">
    <verse number="6" style="v" />
    <char style="nd">Bawipaw </char> byakinpyakunaw tuh</para>
  <para style="q2">athyaapaw byakinpyakunaw thua zah,</para>
  <para style="q1">sosuhnawpaw maee kya</para>
  <para style="q2">vae sari cia soliate thyaasah athuapaw</para>
  <para style="q1">ngunphua te nynh aloku.</para>
  <para style="q1">
    <verse number="7" style="v" />Pou <char style="nd">Bawipaw </char>, nang nynh</para>
  <para style="q2">kaening kha nae thungkhaw cih;</para>
  <para style="q1">e minphuin kyate kaening hynh</para>
  <para style="q2">zungzae nae rin cih.</para>
  <para style="q1">
    <verse number="8" style="v" />Ccungccaw hae kyaze hoyleinaw kha</para>
  <para style="q2">hothung athua lyakhe,</para>
  <para style="q1">ccungccaw hoylei hae paw tuh</para>
  <para style="q2">pawpaw kya miakaw a khiavuikuh hae.</para>
  <chapter number="13" style="c" />
  <para style="s1">Bawmnaw hanlan Sawsangnaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, hohseciamou</para>
  <para style="q2">kae kha nae ning cih? Zungzae tou?</para>
  <para style="q1">Hohseciamou na mitmae kha</para>
  <para style="q2">nae retawkuh cih?</para>
  <para style="q1">
    <verse number="2" style="v" />Hohseciamou ka hiinnaw kya</para>
  <para style="q2">vawsaw ka teing cih?</para>
  <para style="q1">Hohseciamou ka thinlung hynh</para>
  <para style="q2">ngaethyanaw te a um cih?</para>
  <para style="q1">Hohseciamou ka rhaw hae nynh</para>
  <para style="q2">ka tungvaw kya kaw a hoi cih hae?</para>
  <para style="q1">
    <verse number="3" style="v" />Pou <char style="nd">Bawipaw </char> ka Pachia,</para>
  <para style="q2">yn do lah, yn leihtua!</para>
  <para style="q1">Ka mit yn awsah tua, tuhkhyhze tuh</para>
  <para style="q2">chinaw kya ka ih cih zah,</para>
  <para style="q1">
    <verse number="4" style="v" />kae yn rawsepaw nynh,</para>
  <para style="q2">“Phe ka tae vae,” a ci cih;</para>
  <para style="q1">ka shung keiccuze ka rhaw hae tuh</para>
  <para style="q2">mih lungtua cih.</para>
  <para style="q1">
    <verse number="5" style="v" />Thuasalama atynpaw na sungsahnaw kha</para>
  <para style="q2">ka doliaku; nae khumnaw kya</para>
  <para style="q2">ka thinlung tuh a lungtua cih.</para>
  <para style="q1">
    <verse number="6" style="v" />Ka tungvaw a hoy keiccuze</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha hlaw te</para>
  <para style="q1">the ka hoysah cih.</para>
  <chapter number="14" style="c" />
  <para style="s1">Ccungccaw Hoyleinaw<note caller="+" style="f"><char style="fr" closed="false">14 Abyalu: </char><char style="ft" closed="false">David hlaw</char></note></para>
  <para style="d">(Sam 53)</para>
  <para style="q1">
    <verse number="1" style="v" />Mingaee hae nynh mih thinlung kya,</para>
  <para style="q2">“Pachia um khyh,” a ci hae.</para>
  <para style="q1">Minmin tuh a roh hae,</para>
  <para style="q2">anungsikuhpaw rya kha a law hae;</para>
  <para style="q1">ahoypaw a cyihpaw</para>
  <para style="q2">lu kheit sanmah um khyh hae.<note caller="-" style="x"><char style="xo" closed="false">14.1-3: </char><char style="xt" closed="false"><ref loc="ROM 3:10-12">Rom 3.10-12</ref></char></note></para>
  <para style="q1">
    <verse number="2" style="v" />Ccungccaw hae kya a hawpaw te</para>
  <para style="q2">Pachia a ccungpaw lu kheit san</para>
  <para style="q1">a um tou, um khyh tou cipaw muih khylan</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh vaawlang te</para>
  <para style="q1">ccungccaw kha a dobung.</para>
  <para style="q1">
    <verse number="3" style="v" />Ccungccaw balyn tuh a cceihsei vae hae,</para>
  <para style="q2">mih balyn mawte phe lokuh lante</para>
  <para style="q1">accouseikuh hae;</para>
  <para style="q2">ahoypaw a cyihpaw hum san um khyh,</para>
  <para style="q1">lu kheit san um khyh.</para>
  <para style="q1">
    <verse number="4" style="v" />Sanlou ae hawte ka ccungccaw hae kha</para>
  <para style="q2">karyh ae hae zah,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kalan saw a sang lei hae paw,</para>
  <para style="q2">hoyleinaw a cyih hae paw balyn nynh</para>
  <para style="q1">nythyanaw hoi khyh hae tou?</para>
  <para style="q1">
    <verse number="5" style="v" />Te minmin tuh myaryamaw a rih cih hae,</para>
  <para style="q2">pawccecize Pachia tuh ading hae paw</para>
  <para style="q2">phu kya a um.</para>
  <para style="q1">
    <verse number="6" style="v" />Nanning nynh ryachipaw a khuakhannaw kha</para>
  <para style="q2">maethya na lah oh salamah,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> tuh aning a khynnaw nynh thua.</para>
  <para style="q1">
    <verse number="7" style="v" />Israel hae hanlan khumnaw tuh</para>
  <para style="q2">Zion kyate yn thua vae sah!</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh a ccungccaw hae kha</para>
  <para style="q2">hoynaw he a pyathui hae te,</para>
  <para style="q1">Jakob tuh a lungtua cih;</para>
  <para style="q2">Israel tuh a lungpaw cih.</para>
  <chapter number="15" style="c" />
  <para style="s1">Beikinnthyaa kya Hummou Um Cih?</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, hummou na bu thyaapaw kya a um cih?</para>
  <para style="q2">Hummou na mua thyaapaw</para>
  <para style="q1">vawlan a um cih?</para>
  <para style="q1">
    <verse number="2" style="v" />Ccaenaw um lei lante hiin zah,</para>
  <para style="q2">ahmepaw kha a cyihpaw,</para>
  <para style="q1">a thinlung kya-e byaccingpaw kha</para>
  <para style="q2">a hopaw,</para>
  <para style="q1">
    <verse number="3" style="v" />a munglae te ccungccaw thethya</para>
  <para style="q2">a ho leipaw, a ruiban hae tungvaw</para>
  <para style="q1">hoyleinaw a rae leipaw,</para>
  <para style="q2">a innpaw hae kha the a thyasah leipaw,</para>
  <para style="q1">
    <verse number="4" style="v" />ccungccaw hoy leipaw kha</para>
  <para style="q2">pawlangria leipaw,</para>
  <para style="q1">thuasalama <char style="nd">Bawipaw </char> raw a rih hae paw kha</para>
  <para style="q2">saw a tuapaw,</para>
  <para style="q1">vawsaw a tung zemah</para>
  <para style="q2">a byakinnaw a tynsahpaw,</para>
  <para style="q1">
    <verse number="5" style="v" />phua ato te a koiisakuh leipaw,</para>
  <para style="q2">seinaw a hoi leipaw kha rawsete</para>
  <para style="q1">pyaruh a lawkuh leipaw,</para>
  <para style="q1">hynh-e uccaw hae a cyihpaw</para>
  <para style="q2">ccungccaw tuh khuliakuh lan khyh.</para>
  <chapter number="16" style="c" />
  <para style="s1">Pachia Doliakunaw Hlaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou Pachia, na kya ka reku keiccuze</para>
  <para style="q2">yn thungkhawtua.</para>
  <para style="q1">
    <verse number="2" style="v" />“Nang tuh ka Bawipaw nynh na thua;</para>
  <para style="q2">Namaw kyate holeite hoynaw ka hoi khyh,”</para>
  <para style="q2">cite <char style="nd">Bawipaw </char> kha ka hopya.</para>
  <para style="q1">
    <verse number="3" style="v" />Ram kya umpaw athyaapaw</para>
  <para style="q2">ccungccaw hae tuh a sung-e hae,</para>
  <para style="q2">minmin kyakhe ka lungrythua.</para>
  <para style="q1">
    <verse number="4" style="v" />Ccangpaw pachia a pokuh hae paw tuh</para>
  <para style="q2">mih tungvaw kya ngaethyanaw patae</para>
  <para style="q1">a thuanuasaku hae.</para>
  <para style="q2">Minmin kya-e niapaw silawnawpaw</para>
  <para style="q1">chii kha ka pyapah lan khyh hae,</para>
  <para style="q2">mih pachia hae min kha ka ko lan khyh.</para>
  <para style="q1">
    <verse number="5" style="v" />
    <char style="nd">Bawipaw </char> tuh ka pokupaw</para>
  <para style="q2">ka hanpaw te ka rho nynh thua;</para>
  <para style="q2">ka hiinnaw tuh na kuih kya nynh a um.</para>
  <para style="q1">
    <verse number="6" style="v" />Ka hanlan ramri tuh</para>
  <para style="q2">ahoypaw hmin kya nynh a um;</para>
  <para style="q1">ahoypaw rho kha ka ccou vae.</para>
  <para style="q1">
    <verse number="7" style="v" />Tuanaw yn pyapaw <char style="nd">Bawipaw </char> kha</para>
  <para style="q2">the ka hoysah;</para>
  <para style="q1">khuazi ccyh zemah ka thinlung nynh</para>
  <para style="q2">raeringnaw yn pya.</para>
  <para style="q1">
    <verse number="8" style="v" />Bawipaw tuh ka mitmaevaw kya</para>
  <para style="q2">tyty a um;</para>
  <para style="q1">aning tuh ka ranglang khe a um keiccuze</para>
  <para style="q2">pawpaw nynh mah</para>
  <para style="q1">yn piasah kho lan khyh.<note caller="-" style="x"><char style="xo" closed="false">16.8-11: </char><char style="xt" closed="false"><ref loc="ACT 2:25-28">Loc 2.25-28</ref></char></note></para>
  <para style="q1">
    <verse number="9" style="v" />Tukeiccuze ka thinlung tuh a lungtua zah,</para>
  <para style="q2">ka muisaw mah a lungpaw.</para>
  <para style="q2">ka pyn mah khyndadyh lan ka um.</para>
  <para style="q1">
    <verse number="10" style="v" />Pawccecize Michi khua kya</para>
  <para style="q2">nae cciataw lan khyh zah,</para>
  <para style="q1">na tungvaw a lungzipaw tuh</para>
  <para style="q2">Hunghua lungkhu na nungsya lan khyh.<note caller="-" style="x"><char style="xo" closed="false">16.10: </char><char style="xt" closed="false"><ref loc="ACT 13:35">Loc 13.35</ref></char></note></para>
  <para style="q1">
    <verse number="11" style="v" />Kae kha hiinnaw laanpi nae muihsah.</para>
  <para style="q2">Na umnaw kya lungtuanaw ccing zah,</para>
  <para style="q1">na ranglang kuih kya</para>
  <para style="q2">hoysahnaw zungzae a um.</para>
  <chapter number="17" style="c" />
  <para style="s1">Lue khylan Sawsangnaw</para>
  <para style="d">David Sawsangnaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, adingpaw kae ngianaw hynh ngaetua;</para>
  <para style="q2">ka siaruanaw hynh yn thaepya tua;</para>
  <para style="q1">hynpaw bya athua leipaw</para>
  <para style="q2">ka sawsangnaw hynh yn ngaepya tua.</para>
  <para style="q1">
    <verse number="2" style="v" />Ka kalan te bya yn piapah lah,</para>
  <para style="q2">akyhpaw kha muihtua.</para>
  <para style="q1">
    <verse number="3" style="v" />Ka thinlung hynh akaw-aleih</para>
  <para style="q2">nae do ze thuasah, khuazi ccyh kya</para>
  <para style="q1">nae paebua ze thuasah,</para>
  <para style="q2">nae syntawtua ze thuasah</para>
  <para style="q2">ka tungvaw kya hoyleinaw kha</para>
  <para style="q1">na muih lan khyh;</para>
  <para style="q2">ka khalang tuh hosei khyh.</para>
  <para style="q1">
    <verse number="4" style="v" />Ming hae nynh a cyi hae hawte</para>
  <para style="q2">thua leite,</para>
  <para style="q1">na bya liate puathonaw laanpi kha</para>
  <para style="q2">ka sibia vae.</para>
  <para style="q1">
    <verse number="5" style="v" />Na laanpi kha tynkaring lan ka zui zah,</para>
  <para style="q2">ka ccu tuh thei khyh.</para>
  <para style="q1">
    <verse number="6" style="v" />Pou Pachia, kae kha</para>
  <para style="q2">nae thaepah cih keiccuze</para>
  <para style="q1">nang kha kae ko;</para>
  <para style="q2">na naw kha ka kalan</para>
  <para style="q1">beih yn tuakuh lah,</para>
  <para style="q2">ka bya hynh yn thaepya tua.</para>
  <para style="q1">
    <verse number="7" style="v" />Na kya a rekuh hae paw kha</para>
  <para style="q2">mih rhaw hae kyate</para>
  <para style="q1">na ranglang kuih te</para>
  <para style="q2">na khumtu hae paw Pou Khumtu,</para>
  <para style="q1">atynpaw na sungsahnaw kha</para>
  <para style="q2">ngaeang lan a um lante langsaku tua.</para>
  <para style="q1">
    <verse number="8-9" style="v" />Kae yn tuaa yn sah hae paw</para>
  <para style="q2">ccungccaw hoylei hae paw kyate thuasah,</para>
  <para style="q1">kae kha koihlute yn theih ry hae paw</para>
  <para style="q2">ka rhaw hae kyate thuasah</para>
  <para style="q1">na mitlungdy hawte yn rin lah,</para>
  <para style="q2">na sake mynlyh kyakhe yn resaku tua.</para>
  <para style="q1">
    <verse number="10" style="v" />Ngaethyaumsahnaw hoi leite,</para>
  <para style="q2">mih khalang te lysakunaw bya kha</para>
  <para style="q2">a ho hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Ka ccianaw takyh langkhe</para>
  <para style="q2">yn koihlu hae;</para>
  <para style="q1">kae kha laephi kya khulia khylan</para>
  <para style="q2">mih mit te phang yn buh hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Zoihtatyh lan pia khylan</para>
  <para style="q2">a zuakuhpaw chindeih hawte</para>
  <para style="q1">thua hae zah,</para>
  <para style="q2">arekunaw hmin kya phang a buhpaw</para>
  <para style="q2">chindeih anopaw te nynh aloku hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Pou <char style="nd">Bawipaw </char>, thoku tua,</para>
  <para style="q2">minmin kha hawilia hae lah,</para>
  <para style="q1">khuliatua hae!</para>
  <para style="q2">Ka hiinnaw hynh ccungccaw hoylei hae paw kyate</para>
  <para style="q2">na thaloi khate yn luesah tua.</para>
  <para style="q1">
    <verse number="14" style="v" />Pou <char style="nd">Bawipaw </char>, ccungccaw hae kyate thuasah,</para>
  <para style="q2">mih hiinnaw kya mih hanpaw tuh</para>
  <para style="q1">hynh-e laephi vawlan kyalya a umpaw</para>
  <para style="q2">ccungccaw hae kyate thuasah</para>
  <para style="q1">ka hiinnaw hynh na kuih khate</para>
  <para style="q2">yn luesah tua. Minmin hanlan</para>
  <para style="q1">na ccakhungpya hae paw khate</para>
  <para style="q2">mih vueso sah;</para>
  <para style="q1">mih ccaaw hae tuh</para>
  <para style="q2">a zaw hae laelan hoi hae sah;</para>
  <para style="q1">mih mintaw hae,</para>
  <para style="q2">mih mintasin hae hanlan mah</para>
  <para style="q2">ccangkhakheit nungsya hae sah.</para>
  <para style="q1">
    <verse number="15" style="v" />Kae nynh tuh na mae kha</para>
  <para style="q2">dingnaw kya ka muih cih;</para>
  <para style="q1">he ka thaekuh te, na muinsan kha</para>
  <para style="q2">muihte ka lungccing cih.</para>
  <chapter number="18" style="c" />
  <para style="s1">David kya-e Taenaw Hlaw<note caller="+" style="f"><char style="fr" closed="false">18 Abyalu: <char style="nd">Bawipaw </char> ryalahtu David tuh Saul te ccangpaw a rhaw hae balyn kyate <char style="nd">Bawipaw </char> nynh a khum nin khe David nynh <char style="nd">Bawipaw </char> kalan a sahpaw hlaw.</char></note></para>
  <para style="d">(2Sa 22.1-51)</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, ka thawzung</para>
  <para style="q2">na thuapaw nang kha kae sungsah.</para>
  <para style="q1">
    <verse number="2" style="v" />
    <char style="nd">Bawipaw </char> tuh ka lungpi,</para>
  <para style="q2">ka rhawlungrua, yn luesahtu,</para>
  <para style="q1">ka Pachia, ka khynnaw lungpi,</para>
  <para style="q2">ka khawriaphua,</para>
  <para style="q1">yn khumpaw saki te</para>
  <para style="q2">ka rekunaw nynh thua.</para>
  <para style="q1">
    <verse number="3" style="v" />Thehoysah lan angaekuhpaw</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha ka ko,</para>
  <para style="q1">tukeiccuze ka rhaw hae kyate</para>
  <para style="q2">khum ka thua cih.</para>
  <para style="q1">
    <verse number="4" style="v" />Chinaw arui nynh phang yn voi;</para>
  <para style="q2">ronaw tuithaw nynh yn luathin.</para>
  <para style="q1">
    <verse number="5" style="v" />Chinaw arui nynh phang yn khethinku;</para>
  <para style="q2">chinaw kaang nynh phang yn kaesah.</para>
  <para style="q1">
    <verse number="6" style="v" />Ka vawsaw lyakhe <char style="nd">Bawipaw </char> kha ka ko;</para>
  <para style="q2">ka Pachia kalan khe bawmnaw</para>
  <para style="q2">mue khylan ka sia.</para>
  <para style="q1">A beikinn kyate ka roi kha yn thaepah zah,</para>
  <para style="q2">amaw kalan ka sianaw tuh</para>
  <para style="q1">a nakaring kya phe a thua.</para>
  <para style="q1">
    <verse number="7" style="v" />Pachia a thinria keiccuze</para>
  <para style="q2">laephi tuh hy zah a thyngkuh;</para>
  <para style="q1">mua leihpaw hae mah</para>
  <para style="q2">ahy hae.</para>
  <para style="q1">
    <verse number="8" style="v" />A naduh kyate maeekhuh</para>
  <para style="q2">pouthung zah,</para>
  <para style="q1">a khalang kyate aruapaw maeesoi te</para>
  <para style="q2">zaezae epaw maeehue a pou.</para>
  <para style="q1">
    <verse number="9" style="v" />Vaawlui kha hung zah yn rungbung;</para>
  <para style="q2">marae zipingpaw mohnaw tuh</para>
  <para style="q2">a ccu kaw kya a um.</para>
  <para style="q1">
    <verse number="10" style="v" />Cherubim kha ccikuh zah a zou;</para>
  <para style="q2">khivae a sake vawlan khe arangte a zou.</para>
  <para style="q1">
    <verse number="11" style="v" />Amaw toulou kha mohnaw te a bongku,</para>
  <para style="q2">tui te marae mohkhaekuhpaw</para>
  <para style="q2">maeking nynh phang a bong.</para>
  <para style="q1">
    <verse number="12" style="v" />A malang e phaephae akpaw kyate</para>
  <para style="q2">phang zipingpaw maeking kya-e</para>
  <para style="q2">hya te maee-e a ccah hae.</para>
  <para style="q1">
    <verse number="13" style="v" />
    <char style="nd">Bawipaw </char> mah vaawlui khe</para>
  <para style="q2">kholung lang thyh zah,</para>
  <para style="q1">Ahang Huaccepaw Pachia nynh</para>
  <para style="q2">a roi a saw.</para>
  <para style="q1">
    <verse number="14" style="v" />Te a the kha kaw zah,</para>
  <para style="q2">rhaw hae kha a phiasaku hae;</para>
  <para style="q1">ria he a kawsah tuh,</para>
  <para style="q2">phiariphiarae a ccue vae hae.</para>
  <para style="q1">
    <verse number="15" style="v" />Pou <char style="nd">Bawipaw </char>, thinriate</para>
  <para style="q2">na pe hae zah,</para>
  <para style="q2">na naduh kyate hy he na saw tuh,</para>
  <para style="q1">rilipi kaw phe lang zah,</para>
  <para style="q2">laephi aleihpaw mah phe a lang.</para>
  <para style="q1">
    <verse number="16" style="v" />
    <char style="nd">Bawipaw </char> nynh ahangnaw kyate</para>
  <para style="q2">yn dyngnuakuh zah yn hoeilang;</para>
  <para style="q1">myarya khupaw tui lungkhu kyate</para>
  <para style="q2">po yn sue.</para>
  <para style="q1">
    <verse number="17" style="v" />Athungpaw ka rhaw hae kyate thuasah,</para>
  <para style="q2">kae yn hua hae paw kyate thuasah</para>
  <para style="q1">yn luesah;</para>
  <para style="q2">pawccecize minmin tuh ka hanlan</para>
  <para style="q2">myaryamaw a thung hae.</para>
  <para style="q1">
    <verse number="18" style="v" />Minmin nynh ka vawsaw ccyh lyakhe</para>
  <para style="q2">yn dou hae;</para>
  <para style="q1">thuasalama <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">yn bawm.</para>
  <para style="q1">
    <verse number="19" style="v" />Akopaw hmin lang yn cciakhae;</para>
  <para style="q2">Ka tungvaw a lungrythua keiccuze</para>
  <para style="q2">yn luesah.</para>
  <para style="q1">
    <verse number="20" style="v" />
    <char style="nd">Bawipaw </char> nynh ka dingnaw thyhte</para>
  <para style="q2">lasung yn pya;</para>
  <para style="q2">ka kuih a thyaa thyhte yn pyaru.</para>
  <para style="q1">
    <verse number="21" style="v" />Pawccecize <char style="nd">Bawipaw </char> laanpi kha</para>
  <para style="q2">ka zui zah, ka Pachia kyate</para>
  <para style="q2">seinaw raete ka phiakuh khyh.</para>
  <para style="q1">
    <verse number="22" style="v" />Pawccecize a phungzae hae balyn kha</para>
  <para style="q2">ka zui zah,</para>
  <para style="q2">a phungbya hae kha ka vua khyh.</para>
  <para style="q1">
    <verse number="23" style="v" />A malang ccaenaw um leipaw</para>
  <para style="q2">ka thua zah,</para>
  <para style="q2">hoyleinaw kha ka sibia.</para>
  <para style="q1">
    <verse number="24" style="v" />Tukeiccuze <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">ka dingnaw thyhte thuasah,</para>
  <para style="q1">a muihnaw kya ka kuih athyaa thyhte</para>
  <para style="q2">thuasah yn pyaru vae.</para>
  <para style="q1">
    <verse number="25" style="v" />A lungzipaw tungvaw kya</para>
  <para style="q2">lungzinaw kha na langsaku,</para>
  <para style="q1">ccaenaw a um leipaw kya</para>
  <para style="q2">ccae lan um leinaw kha na langsaku.</para>
  <para style="q1">
    <verse number="26" style="v" />Athyaapaw ccungccaw kya</para>
  <para style="q2">thyaanaw kha na langsaku;</para>
  <para style="q1">ccungccaw hoyleipaw kya</para>
  <para style="q2">rawsenaw kha na langsah.</para>
  <para style="q1">
    <verse number="27" style="v" />Zakaw a sangsakuhpaw</para>
  <para style="q2">ccungccaw kha na khum,</para>
  <para style="q1">thuasalama lysakunaw mitdae</para>
  <para style="q2">a dae hae paw kha na biabung hae.</para>
  <para style="q1">
    <verse number="28" style="v" />Pou <char style="nd">Bawipaw </char>, nang tuh</para>
  <para style="q2">ka maeekhua yn awsahpahtu nynh</para>
  <para style="q1">na thua;</para>
  <para style="q2">
    <char style="nd">Bawipaw </char>, ka Pachia nynh</para>
  <para style="q2">ka mohnaw kha a awsah.</para>
  <para style="q1">
    <verse number="29" style="v" />Namaw liate ka rhaw hae kha</para>
  <para style="q2">ka ro kho hae,</para>
  <para style="q1">ka Pachia liate khualungrua kha</para>
  <para style="q2">po ka zou kho.</para>
  <para style="q1">
    <verse number="30" style="v" />E Pachia tuh, a laanpi phe accing;</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> byakinpyakunaw nynh</para>
  <para style="q1">ahmepaw kha ccaekia a khan;</para>
  <para style="q2">Aning tuh amaw kya</para>
  <para style="q1">a rekuh hae paw balyn hanlan</para>
  <para style="q2">khawriaphua nynh thua.</para>
  <para style="q1">
    <verse number="31" style="v" />
    <char style="nd">Bawipaw </char> laelan</para>
  <para style="q2">hummou Pachia athua?</para>
  <para style="q1">aening Pachia laelan</para>
  <para style="q2">hummou lungpi athua?</para>
  <para style="q1">
    <verse number="32" style="v" />Aning tuh thawzung kha</para>
  <para style="q2">ka tae kya yn khiidepahtu thua zah,</para>
  <para style="q2">ka laanpi kha a khynsah.</para>
  <para style="q1">
    <verse number="33" style="v" />Ka ccu kha sazuh ccu hawte</para>
  <para style="q2">a liazawsah zah,</para>
  <para style="q2">ahangnaw khe khyndadyh lan yn nung.<note caller="-" style="x"><char style="xo" closed="false">18.33: </char><char style="xt" closed="false"><ref loc="HAB 3:19">Hab 3.19</ref></char></note></para>
  <para style="q1">
    <verse number="34" style="v" />Ka kuihbaw nynh sohin li kha</para>
  <para style="q2">a sue kho nawlan,</para>
  <para style="q1">ka kuih kha rhawtuk nawlan</para>
  <para style="q2">yn ccangpya.</para>
  <para style="q1">
    <verse number="35" style="v" />Na khumnaw khawriaphua kha</para>
  <para style="q2">nae pya vae zah,</para>
  <para style="q1">na ranglang kuih nynh yn bawm vae;</para>
  <para style="q2">nae bawmnaw nynh yn lesaesah vae.</para>
  <para style="q1">
    <verse number="36" style="v" />Ka ccusy hanlan laanpi akopaw kha</para>
  <para style="q2">nae pya zah,</para>
  <para style="q2">ka ccu tuh thei khyh.</para>
  <para style="q1">
    <verse number="37" style="v" />Ka rhaw hae kha ka deehui hae zah</para>
  <para style="q2">ka phya hae;</para>
  <para style="q1">ka maemih makhia hae</para>
  <para style="q2">ka kitaw khyh hae.</para>
  <para style="q1">
    <verse number="38" style="v" />A thokuh kho lei lan hae,</para>
  <para style="q2">ka bua hae zah,</para>
  <para style="q2">ka ccu kaw kya a khuliakuh hae.</para>
  <para style="q1">
    <verse number="39" style="v" />Pawccecize rhawtuknaw hanlan</para>
  <para style="q2">thawzung kha ka tae kya</para>
  <para style="q1">nae khiidepya;</para>
  <para style="q2">ka rhaw hae kha ka zakaw khe</para>
  <para style="q2">na bakhungsah hae.</para>
  <para style="q1">
    <verse number="40" style="v" />Ka rhaw hae kha ka kyate</para>
  <para style="q2">na maeleihsakuh hae zah,</para>
  <para style="q2">kae yn hua hae paw kha ka ro hae.</para>
  <para style="q1">
    <verse number="41" style="v" />Bawmnaw ngiakute a sia hae zemah,</para>
  <para style="q2">minmin a khum lan hae paw</para>
  <para style="q1">humhung mah um khyh;</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kalan a sia hae zemah</para>
  <para style="q2">leihru khyh hae.</para>
  <para style="q1">
    <verse number="42" style="v" />Khivae kya-e vuiping hawte,</para>
  <para style="q2">phe khui lan ka miade hae;</para>
  <para style="q1">laanpi kya-e tuiccua hawte,</para>
  <para style="q2">ka syde hae.</para>
  <para style="q1">
    <verse number="43" style="v" />Ccungccaw hae ryte</para>
  <para style="q2">rhawkunaw kyate nae luesah;</para>
  <para style="q1">minphuin hae uktu lang nae rae;</para>
  <para style="q2">ka ny boi leipaw ccungccaw hae nynh</para>
  <para style="q2">rya yn lawpya hae.</para>
  <para style="q1">
    <verse number="44" style="v" />Ka bya he a thae miakaw hae te,</para>
  <para style="q2">ka kaw a ngae hae;</para>
  <para style="q1">ramccang hae tuh bohkute</para>
  <para style="q2">ka kalan oun cceih hae.</para>
  <para style="q1">
    <verse number="45" style="v" />Ramccang hae tuh mih thawthah zah,</para>
  <para style="q2">mih rhawlungrua lungkhu te</para>
  <para style="q1">thyngkute oun pou hae.</para>
  <para style="q1">
    <verse number="46" style="v" />
    <char style="nd">Bawipaw </char> tuh a hiin!</para>
  <para style="q2">Ka lungpi tuh thehoyte um sah,</para>
  <para style="q1">Yn khumtupaw Pachia tuh</para>
  <para style="q2">hangthungte um sah.</para>
  <para style="q1">
    <verse number="47" style="v" />Pachia tuh phulawrunaw</para>
  <para style="q2">yn pyatu thua zah,</para>
  <para style="q1">ccungccaw hae kha ka zakaw</para>
  <para style="q2">a sangsahtu hae nynh thua;</para>
  <para style="q1">
    <verse number="48" style="v" />ka rhaw hae kyate</para>
  <para style="q2">yn luesahpaw nynh thua;</para>
  <para style="q1">kae yn rawsetu hae luki lang</para>
  <para style="q2">nae hangthung ccaccing;</para>
  <para style="q1">a puathopaw ccungccaw hae kyate</para>
  <para style="q2">nae luesah.</para>
  <para style="q1">
    <verse number="49" style="v" />Tukeiccuze, pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">minphuin hae laku kya</para>
  <para style="q1">kae thehoysah cih zah,</para>
  <para style="q2">na min thehoysahnaw hlaw kha</para>
  <para style="q2">ka sah cih.<note caller="-" style="x"><char style="xo" closed="false">18.49: </char><char style="xt" closed="false"><ref loc="ROM 15:9">Rom 15.9</ref></char></note></para>
  <para style="q1">
    <verse number="50" style="v" />Pachia nynh a siapharan kha</para>
  <para style="q2">taenaw alepaw a pya;</para>
  <para style="q1">chitui a thuhpaw David te</para>
  <para style="q2">a ciihan hae kya</para>
  <para style="q1">atynpaw sungsahnaw kha</para>
  <para style="q2">zungzae a langsahpya hae.</para>
  <chapter number="19" style="c" />
  <para style="s1">Raenaw kya Pachia Phu-enaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Vaawlui nynh Pachia phu-enaw kha</para>
  <para style="q2">ho zah,</para>
  <para style="q1">vaawlui kya adawkuhpaw nynh</para>
  <para style="q2">a kuihhae kha a langsah.</para>
  <para style="q1">
    <verse number="2" style="v" />Khuadae nynh khuadae kha</para>
  <para style="q2">hopah pathy zah,</para>
  <para style="q1">khuazi nynh khuazi kha</para>
  <para style="q2">a hopya pathy.</para>
  <para style="q1">
    <verse number="3" style="v" />Ho te mah ho khyh hae,</para>
  <para style="q2">bya te mah pousah khyh hae;</para>
  <para style="q2">mih roi kha thae lan um khyh;</para>
  <para style="q1">
    <verse number="4" style="v" />tuhzemah mih roi tuh</para>
  <para style="q2">laephi pynpi kya po zeihkuh zah,</para>
  <para style="q1">mih bya tuh laephi athangnaw cia</para>
  <para style="q2">phe a thua.</para>
  <para style="q1">Pachia nynh khuanin hanlan</para>
  <para style="q2">vaawlui kya bu a sakpya,<note caller="-" style="x"><char style="xo" closed="false">19.4: </char><char style="xt" closed="false"><ref loc="ROM 10:18">Rom 10.18</ref></char></note></para>
  <para style="q1">
    <verse number="5" style="v" />khuanin tuh a khaan lungkhu te</para>
  <para style="q2">yn poupaw zudy ccangvaepaw hawte thuasah,</para>
  <para style="q1">a laanpi kya lungtuate a ccuepaw</para>
  <para style="q2">ccungccapaw athungpaw</para>
  <para style="q2">hawte thuasah yn pou.</para>
  <para style="q1">
    <verse number="6" style="v" />Vaawlui athangnaw voikheit langte</para>
  <para style="q2">yn tho zah,</para>
  <para style="q1">voikheit lang athangnaw cia</para>
  <para style="q2">po a cceih;</para>
  <para style="q1">amaw asonaw kyate a rekuh khopaw</para>
  <para style="q2">pawpaw mah um khyh.</para>
  <para style="q1">
    <verse number="7" style="v" />
    <char style="nd">Bawipaw </char> phung tuh</para>
  <para style="q2">phe accingpaw thua zah,</para>
  <para style="q2">hiinnaw kha a thawsah;</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> phunglang tuh</para>
  <para style="q2">akyhpaw thua zah,</para>
  <para style="q2">a haw leipaw kha a hawsah.</para>
  <para style="q1">
    <verse number="8" style="v" />
    <char style="nd">Bawipaw </char> phungbya tuh</para>
  <para style="q2">ahmepaw thua zah,</para>
  <para style="q2">thinlung kha a lungtuasah;</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kawbya tuh</para>
  <para style="q2">ccaerarihpaw thua zah,</para>
  <para style="q2">mit kha a awsah.</para>
  <para style="q1">
    <verse number="9" style="v" />
    <char style="nd">Bawipaw </char> rawrinaw tuh</para>
  <para style="q2">athyaapaw thua zah,</para>
  <para style="q2">zungzae atyn;</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> phungzae hae tuh</para>
  <para style="q2">akyhpaw thua zah,</para>
  <para style="q2">zungzae adingpaw nynh thua.</para>
  <para style="q1">
    <verse number="10" style="v" />Hynh-e hae hynh sui laeze thuasah,</para>
  <para style="q2">sui ccipaw patae lae heize thuasah</para>
  <para style="q2">ry lan a umhua hae paw nynh thua;</para>
  <para style="q1">khoilutui laeze ehua zah,</para>
  <para style="q2">khoidaw kyate accawpaw</para>
  <para style="q1">khoitui laeze a ehua.</para>
  <para style="q1">
    <verse number="11" style="v" />Tuhpiaze, e phungzae hae nynh</para>
  <para style="q2">na ryalahtupaw kae kha</para>
  <para style="q1">raeringnaw yn pya hae;</para>
  <para style="q2">e phungzae hae zuinaw liate</para>
  <para style="q2">myarya lepaw lasung a um.</para>
  <para style="q1">
    <verse number="12" style="v" />Hummou amaw a cyiseinaw kha</para>
  <para style="q2">a muihkuh kho?</para>
  <para style="q1">Alangkuh leipaw cyiseinaw kyate</para>
  <para style="q2">kae kha yn thyaasah.</para>
  <para style="q1">
    <verse number="13" style="v" />Lungraroute seinaw kyate mah</para>
  <para style="q2">na ryalahtupaw kae hynh</para>
  <para style="q1">yn khyn sah lah,</para>
  <para style="q2">hynh-e seinaw hae nynh kae kha</para>
  <para style="q2">yn uk nan hae sah.</para>
  <para style="q1">Tetuh ccaenaw um leipaw</para>
  <para style="q2">ka thua cih zah,</para>
  <para style="q1">myarya lepaw seinaw kyate</para>
  <para style="q2">ka lue cih.</para>
  <para style="q1">
    <verse number="14" style="v" />Ka khalang kya-e bya te</para>
  <para style="q2">ka thinlung kya-e tuanaw tuh</para>
  <para style="q1">na nawccawpaw lang tang sah,</para>
  <para style="q2">Pou <char style="nd">Bawipaw </char>, ka lungpi te</para>
  <para style="q1">yn shawkhawtu.</para>
  <chapter number="20" style="c" />
  <para style="s1">Taenaw hanlan Sawsangnaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Vawsaw na tung ccyh lyakhe</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh nang kha</para>
  <para style="q1">ae thaepah vae sah!</para>
  <para style="q2">Jakob Pachia min nynh</para>
  <para style="q2">ae thungkhaw vae sah!</para>
  <para style="q1">
    <verse number="2" style="v" />A beikinnthyaa kyate</para>
  <para style="q2">bawmnaw ae pya vae sah,</para>
  <para style="q2">te Zion Mua kyate ae bawm vae sah!</para>
  <para style="q1">
    <verse number="3" style="v" />Si na lawnawpaw balyn kha</para>
  <para style="q2">ae liathuipah sah lah,</para>
  <para style="q1">Maee-ute si na lawnawpaw hae kha</para>
  <para style="q2">ae ccoupah vae sah.</para>
  <para style="q1">
    <verse number="4" style="v" />Na thinlung nynh a rypaw kha</para>
  <para style="q2">ae pya sah lah,</para>
  <para style="q1">na paccynkupaw balyn kha</para>
  <para style="q2">ae ccingsahpah vae sah.</para>
  <para style="q1">
    <verse number="5" style="v" />Na tae keiccuze lungtuate</para>
  <para style="q2">kae sia cih zah,</para>
  <para style="q1">kae Pachia min te taenaw poi</para>
  <para style="q2">kae tua cih.</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh na ngianaw balyn kha</para>
  <para style="q2">ae ccingsahpah vae sah.</para>
  <para style="q1">
    <verse number="6" style="v" />
    <char style="nd">Bawipaw </char> nynh chitui a thuhpaw kha</para>
  <para style="q2">a bawm cih cipaw ka ny;</para>
  <para style="q1">athyaapaw a vaawram kyate</para>
  <para style="q2">a thaepah cih zah,</para>
  <para style="q1">a ranglang kuih khate</para>
  <para style="q2">taenaw alepaw kha a pya cih.</para>
  <para style="q1">
    <verse number="7" style="v" />Ccungccaw abang nynh</para>
  <para style="q2">rhawtuknawpaw marangle hae kha</para>
  <para style="q1">a doliaku hae, abang nynh</para>
  <para style="q2">marang hae kha a doliaku hae,</para>
  <para style="q1">thuasalama aening tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> ah Pachia min kha</para>
  <para style="q2">ah doliaku oh.</para>
  <para style="q1">
    <verse number="8" style="v" />Minmin tuh a thy a pawkuh cih hae zah</para>
  <para style="q2">a khuliakuh cih hae,</para>
  <para style="q1">thuasalama aening tuh</para>
  <para style="q2">ah thokuh cih oh zah,</para>
  <para style="q1">tynkaring lan ah thadyn cih oh.</para>
  <para style="q1">
    <verse number="9" style="v" />Pou <char style="nd">Bawipaw </char>, siapharan kha</para>
  <para style="q2">taenaw pyatua;</para>
  <para style="q1">kaening nynh kae ko vae ze oun thaepya tua.</para>
  <chapter number="21" style="c" />
  <para style="s1">Taenaw hanlan Lungtuanaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, siapharan tuh</para>
  <para style="q2">na thawzung keiccu a lungtua zah,</para>
  <para style="q1">na bawmnaw liate</para>
  <para style="q2">pawcih baban mou a lungpaw!</para>
  <para style="q1">
    <verse number="2" style="v" />A rypaw kha na pya vae zah,</para>
  <para style="q2">a munglae te ae ngiakupaw kha</para>
  <para style="q2">na kang khyh.</para>
  <para style="q1">
    <verse number="3" style="v" />Hythuanaw patae khate na cciadue;</para>
  <para style="q2">a lu vawlan khe bawilukhung</para>
  <para style="q2">na khungsah.</para>
  <para style="q1">
    <verse number="4" style="v" />Hiinnaw kha ae ngia zah na pya;</para>
  <para style="q2">zungzae hiinshe saenaw kha na pya.</para>
  <para style="q1">
    <verse number="5" style="v" />Na bawmnaw liate a phu-enaw tuh</para>
  <para style="q2">myarya ale;</para>
  <para style="q2">minthaannaw te lesaenaw kha na pya.</para>
  <para style="q1">
    <verse number="6" style="v" />Hythuanaw kha na pya zungzae zah,</para>
  <para style="q2">Na umkhae keiccuze lungtuanaw te</para>
  <para style="q2">phe a beih.</para>
  <para style="q1">
    <verse number="7" style="v" />Pawccecize siapharan tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha doliakuh zah,</para>
  <para style="q1">Ahang Huaccepaw kya-e atynpaw</para>
  <para style="q2">sungsahnaw liate aning tuh</para>
  <para style="q2">atyn zungzae cih.</para>
  <para style="q1">
    <verse number="8" style="v" />Na kuih nynh na rhaw hae balyn kha</para>
  <para style="q2">a kyng cih hae;</para>
  <para style="q1">na ranglang kuih nynh</para>
  <para style="q2">nang ae hua hae paw kha</para>
  <para style="q2">a kyng cih hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Nang he nae langkuh te, minmin kha</para>
  <para style="q2">ezazaepaw maeephupi hawte</para>
  <para style="q2">na thuasah cih hae.</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh a thinrianaw khate</para>
  <para style="q2">a laang cih hae zah,</para>
  <para style="q1">maee nynh minmin kha</para>
  <para style="q2">phe ccung lan a u cih hae.</para>
  <para style="q1">
    <verse number="10" style="v" />Mih ciihan hae kha laephi kyate</para>
  <para style="q2">na maemih cih hae zah,</para>
  <para style="q1">mih ccaaw hae kha</para>
  <para style="q2">ccungccaw hae laku kyate</para>
  <para style="q2">na roh cih hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Nang kha rawsete hoyleinaw kha</para>
  <para style="q2">a paccynku hae ze thuasah,</para>
  <para style="q1">thyaruhnaw kha a tuaku hae ze thuasah,</para>
  <para style="q2">mih laan mih sui ua lan khyh.</para>
  <para style="q1">
    <verse number="12" style="v" />Mih mae kha na li te na ee cih hae zah,</para>
  <para style="q2">mih ke kha na maeleihsakuh cih hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Pou <char style="nd">Bawipaw </char>, na thawzung liate</para>
  <para style="q2">nang tuh hangthung na thua sah!</para>
  <para style="q1">Na thungnaw kha hlaw te</para>
  <para style="q2">kae sah cih zah, kae thehoysah cih.</para>
  <chapter number="22" style="c" />
  <para style="s1">Lue khylan Ngianaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Ka Pachia, ka Pachia,</para>
  <para style="q2">pawcce phe nae vua?</para>
  <para style="q1">Kae kha bawm lanpaw kyate thuasah,</para>
  <para style="q2">ka siaruanaw roi kyate thuasah</para>
  <para style="q2">pawccemou asawnaw lang nae umtaw?<note caller="-" style="x"><char style="xo" closed="false">22.1: </char><char style="xt" closed="false"><ref loc="MAT 27:46">Mat 27.46</ref>; <ref loc="MRK 15:34">Mar 15.34</ref></char></note></para>
  <para style="q1">
    <verse number="2" style="v" />Pou ka Pachia, khuadae ka sia zemah</para>
  <para style="q2">nae thaepah khyh;</para>
  <para style="q1">khuazi ka sia zemah lungdaenaw</para>
  <para style="q2">ka mue khyh.</para>
  <para style="q1">
    <verse number="3" style="v" />Tuhzemah nang tuh Israel hae nynh</para>
  <para style="q2">ae thehoysahnaw hae kya</para>
  <para style="q1">na haung zah,</para>
  <para style="q2">athyaapaw nynh na thua.</para>
  <para style="q1">
    <verse number="4" style="v" />Kae minpaaw hae nynh nang kha</para>
  <para style="q2">ae doliaku hae;</para>
  <para style="q1">nang kha ae doliakuh hae zah,</para>
  <para style="q2">na khum hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Na kalan sia hae zah,</para>
  <para style="q2">khumnaw a mue hae;</para>
  <para style="q1">nang kha ae doliakuh hae zah,</para>
  <para style="q2">maethyanaw mue khyh hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Thuasalama kae tuh ccungccaw thua leite</para>
  <para style="q2">tangkaria nynh ka thua;</para>
  <para style="q1">ming hae nynh a theihrya hae paw</para>
  <para style="q2">ka thua zah, ccungccaw hae nynh</para>
  <para style="q2">a dothatheih hae paw nynh ka thua.</para>
  <para style="q1">
    <verse number="7" style="v" />Yn muihpaw balyn nynh yn sarya hae;</para>
  <para style="q2">mih mung yn sunua hae zah,</para>
  <para style="q1">mih lu yn henua hae;<note caller="-" style="x"><char style="xo" closed="false">22.7: </char><char style="xt" closed="false"><ref loc="MAT 27:39">Mat 27.39</ref>; <ref loc="MRK 15:29">Mar 15.29</ref>; <ref loc="LUK 23:35">Luk 23.35</ref></char></note></para>
  <para style="q1">
    <verse number="8" style="v" />“Aning tuh <char style="nd">Bawipaw </char> kha</para>
  <para style="q2">a doliaku;</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh khum vae sah,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh a lungrythuapaw</para>
  <para style="q1">ccungccaw kha khum sah!” a ciku hae.<note caller="-" style="x"><char style="xo" closed="false">22.8: </char><char style="xt" closed="false"><ref loc="MAT 27:43">Mat 27.43</ref></char></note></para>
  <para style="q1">
    <verse number="9" style="v" />Tuhzemah ka nung vue kyate</para>
  <para style="q2">yn puisahpaw tuh nang nynh na thua;</para>
  <para style="q1">nosi ka thua lya khyndadyh lan</para>
  <para style="q2">nae do-oih.</para>
  <para style="q1">
    <verse number="10" style="v" />Ka pui takaw te nang kha</para>
  <para style="q2">kae doliaku;</para>
  <para style="q1">ka pui takaw te nang tuh</para>
  <para style="q2">ka Pachia nynh na thua.</para>
  <para style="q1">
    <verse number="11" style="v" />Kae te beih sawkuh nan,</para>
  <para style="q2">vawsawnaw nynh yn naenuakuh zah,</para>
  <para style="q1">yn bawm lanpaw hum sanmah</para>
  <para style="q2">um khyh.</para>
  <para style="q1">
    <verse number="12" style="v" />Tangnuapaw hae patae nynh</para>
  <para style="q2">yn koihlu hae,</para>
  <para style="q1">Bashan ram e athungpaw</para>
  <para style="q2">tangnuapaw hae nynh yn koihlu hae;</para>
  <para style="q1">
    <verse number="13" style="v" />A vue myarya law zah</para>
  <para style="q2">a siapaw chindeih hawte,</para>
  <para style="q1">mih khalang kha haehae yn awnua hae.</para>
  <para style="q1">
    <verse number="14" style="v" />Kae kha tui hawte yn lae hae zah,</para>
  <para style="q2">ka ru balyn tuh pong suhliakuh;</para>
  <para style="q1">ka thinlung tuh khoilung hawte nynh thua;</para>
  <para style="q2">ka by lungkhu kya palae atui;</para>
  <para style="q1">
    <verse number="15" style="v" />Ka thawzung tuh lae-ang akoinahpaw hawte</para>
  <para style="q2">karae rou zah,</para>
  <para style="q1">ka lae tuh ka dang kya phang bekuh;</para>
  <para style="q2">kae kha chinaw vuiping kya nae nung.</para>
  <para style="q1">
    <verse number="16" style="v" />Ui hae nynh yn koihlu hae;</para>
  <para style="q2">Ccungccaw hoylei hae paw phu nynh</para>
  <para style="q1">kae kha yn koihlu hae.</para>
  <para style="q2">Ka kuih te ka ccu kha yn bou hae.</para>
  <para style="q1">
    <verse number="17" style="v" />Ka ru balyn kha phe ka ria kho,</para>
  <para style="q2">Yn do hae zah mih lungrythuakhaekuh;</para>
  <para style="q1">
    <verse number="18" style="v" />ka boeining kha neekuh hae zah,</para>
  <para style="q2">ka boeining kha ccungthykhyate a dung hae.<note caller="-" style="x"><char style="xo" closed="false">22.18: </char><char style="xt" closed="false"><ref loc="MAT 27:35">Mat 27.35</ref>; <ref loc="MRK 15:24">Mar 15.24</ref>; <ref loc="LUK 23:34">Luk 23.34</ref>; <ref loc="JHN 19:24">Joh 19.24</ref></char></note></para>
  <para style="q1">
    <verse number="19" style="v" />Thuasalama, pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">kae te beih sawkuh nan!</para>
  <para style="q1">Pou yn bawmtu, kae kha bawm khylan</para>
  <para style="q2">arangte beih yn cceih!</para>
  <para style="q1">
    <verse number="20" style="v" />Ka hiinnaw hynh thaloi kyate thuasah,</para>
  <para style="q2">e ui hae kyate thuasah yn khumtua!</para>
  <para style="q1">
    <verse number="21" style="v" />Chindeih khalang kyate</para>
  <para style="q2">yn khumtua!</para>
  <para style="q1">Arepaw tangnuapaw ki kyate</para>
  <para style="q2">nae khum vae.</para>
  <para style="q1">
    <verse number="22" style="v" />Na min kha ka uno hae kya</para>
  <para style="q2">ka hopah cih hae;</para>
  <para style="q1">a pumkuh hae paw ngaelung kya</para>
  <para style="q2">nang kha kae thehoysah cih:<note caller="-" style="x"><char style="xo" closed="false">22.22: </char><char style="xt" closed="false"><ref loc="HEB 2:12">Heb 2.12</ref></char></note></para>
  <para style="q1">
    <verse number="23" style="v" />
    <char style="nd">Bawipaw </char> raw a rih hae paw,</para>
  <para style="q2">amaw kha thehoysah oh!</para>
  <para style="q1">Jakob ciihan hae balyn,</para>
  <para style="q2">amaw kha phu-esah oh;</para>
  <para style="q1">Israel ciihan hae balyn,</para>
  <para style="q2">amaw raw kha rih oh!</para>
  <para style="q1">
    <verse number="24" style="v" />Pawccecize vawsaw a tungpaw kya-e</para>
  <para style="q2">vawsawnaw kha</para>
  <para style="q1">pawlangria leite um khyh;</para>
  <para style="q2">tuh-e paw kyate a mae kha</para>
  <para style="q1">retawkuh khyh zah,</para>
  <para style="q2">amaw kalan he a sia ze a thaepya.</para>
  <para style="q1">
    <verse number="25" style="v" />A pumkuh hae paw zapi hae kyakhe</para>
  <para style="q2">kae thehoysah cih;</para>
  <para style="q1">namaw raw a rih hae paw malang khe</para>
  <para style="q2">bya ka kinkupaw kha ka ccingsah cih.</para>
  <para style="q1">
    <verse number="26" style="v" />Ryachi hae nynh a ae cih hae zah</para>
  <para style="q2">a byn cih hae;</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> a ccung hae paw nynh</para>
  <para style="q2">amaw kha a thehoysah cih hae.</para>
  <para style="q1">Nae thinlung tuh</para>
  <para style="q2">zungzae a lungtua vae sah!</para>
  <para style="q1">
    <verse number="27" style="v" />Laephi adianaw kya</para>
  <para style="q2">a um hae paw balyn nynh</para>
  <para style="q1">a liathui cih hae zah,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kalan</para>
  <para style="q2">a maeleihkuh cih hae;</para>
  <para style="q1">minphuin balyn nynh</para>
  <para style="q2">amaw kha a beik cih hae.</para>
  <para style="q1">
    <verse number="28" style="v" />Pawccecize uknaw tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kya-e thua zah,</para>
  <para style="q1">amaw nynh minphuin balyn kha</para>
  <para style="q2">a uk hae.</para>
  <para style="q1">
    <verse number="29" style="v" />Laephi vawlan a hoirum hae paw balyn tuh</para>
  <para style="q2">a ae cih hae zah amaw kha</para>
  <para style="q1">a beik cih hae,</para>
  <para style="q2">laenoi kalang a cceihbung hae paw balyn tuh</para>
  <para style="q1">amaw malang a bakhung cih hae.</para>
  <para style="q2">Kae tuh amaw hanlan ka hiin cih.</para>
  <para style="q1">
    <verse number="30" style="v" />Ccaawsenopaw hae nynh</para>
  <para style="q2">amaw rya a la lah cih hae;</para>
  <para style="q1">malang she e ccungccaw hae kha</para>
  <para style="q2">Bawipaw kong hopya athua cih hae,</para>
  <para style="q1">
    <verse number="31" style="v" />“<char style="nd">Bawipaw </char> nynh a ccungccaw hae kha</para>
  <para style="q2">a khum vae hae,” cite a pui loh leipaw</para>
  <para style="q1">ccungccaw hae kyakhe</para>
  <para style="q2">hopya athua cih hae.</para>
  <chapter number="23" style="c" />
  <para style="s1">Tuurinpaw <char style="nd">Bawipaw </char></para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> tuh ka tuurinpaw nynh thua,</para>
  <para style="q2">ka hobounaw um lan khyh.</para>
  <para style="q1">
    <verse number="2" style="v" />hinlalyhpaw ramno kya yn isah;</para>
  <para style="q2">ccirarihpaw tui aluanaw vaw kin khe</para>
  <para style="q2">yn cciakhae;<note caller="-" style="x"><char style="xo" closed="false">23.2: </char><char style="xt" closed="false"><ref loc="REV 7:17">Bya 7.17</ref></char></note></para>
  <para style="q1">
    <verse number="3" style="v" />thawzung thawpaw kha yn pya.</para>
  <para style="q2">Amaw min hanlan</para>
  <para style="q1">ahmepaw laanpi kya yn cciakhae.</para>
  <para style="q1">
    <verse number="4" style="v" />Amoh huaccepaw chinaw hunghua kya</para>
  <para style="q2">ka ccia zemah,</para>
  <para style="q2">vawsawnaw kha ka rih lan khyh;</para>
  <para style="q1">pawccecize nang nynh kae kha</para>
  <para style="q2">nae umkhae;</para>
  <para style="q1">na tungbang te na hoitang nynh</para>
  <para style="q2">ka ngae yn ngansah.</para>
  <para style="q1">
    <verse number="5" style="v" />Ka rhaw hae malang khe</para>
  <para style="q2">ccaboi nae phaepya;</para>
  <para style="q1">ka lu kha chitui nae thuh;</para>
  <para style="q2">ka banang tuh phe aleikuh.</para>
  <para style="q1">
    <verse number="6" style="v" />Ka hiin lungkhu balyn</para>
  <para style="q2">hoynaw te thawccinaw kha</para>
  <para style="q1">ka ccou cih zah,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> inn kya</para>
  <para style="q1">ka hiinshe balyn ka um cih.</para>
  <chapter number="24" style="c" />
  <para style="s1">Beikinn lungkhu lang Teenaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Laephi te a lungkhu umpaw balyn tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kya-e nynh thua,</para>
  <para style="q1">laephi te a vawlan a hiin hae paw balyn hynh</para>
  <para style="q2">amaw kya-e nynh thua,</para>
  <para style="q1">
    <verse number="2" style="v" />pawccecize laephi kha</para>
  <para style="q2">rili vawlan khe thadynsah zah,</para>
  <para style="q1">aleihpaw kha tui hae vawlan khe</para>
  <para style="q2">a tynsah.<note caller="-" style="x"><char style="xo" closed="false">24.2: </char><char style="xt" closed="false"><ref loc="1CO 10:26">1Ko 10.26</ref></char></note></para>
  <para style="q1">
    <verse number="3" style="v" />Hummou <char style="nd">Bawipaw </char> mua vawlan</para>
  <para style="q2">a kae cih?</para>
  <para style="q1">Hummou amaw kya-e athyaapaw hmin kya</para>
  <para style="q2">a thadyn cih?</para>
  <para style="q1">
    <verse number="4" style="v" />A kuih te a thinlung a thyaapaw,</para>
  <para style="q2">zohtuh a beik leipaw te</para>
  <para style="q1">hynhute bya a kinkuh leipaw nynh</para>
  <para style="q2">a kae cih zah a thadyn cih.<note caller="-" style="x"><char style="xo" closed="false">24.4: </char><char style="xt" closed="false"><ref loc="MAT 5:8">Mat 5.8</ref></char></note></para>
  <para style="q1">
    <verse number="5" style="v" />Aning nynh <char style="nd">Bawipaw </char> kyate</para>
  <para style="q2">hythuanaw kha thuasah,</para>
  <para style="q1">a khumtupaw Pachia kyate dingnaw kha</para>
  <para style="q2">thuasah a mue cih.</para>
  <para style="q1">
    <verse number="6" style="v" />Tuhcihawpaw ccungccaw tuh</para>
  <para style="q2">Pachia a ccungpaw phu,</para>
  <para style="q1">Jakob Pachia mae kha</para>
  <para style="q2">a ccungpaw nynh thua.</para>
  <para style="q1">
    <verse number="7" style="v" />Pou koikua hae, hungkuh oh!</para>
  <para style="q2">Pou zungzae a umpaw thuakaw hae,</para>
  <para style="q1">hungkuh oh!</para>
  <para style="q2">aphu-epaw Siapharan yn tee cih.</para>
  <para style="q1">
    <verse number="8" style="v" />A phu-epaw Siapharan tuh hummou?</para>
  <para style="q2">A thawsaepaw te a thungpaw <char style="nd">Bawipaw </char>,</para>
  <para style="q1">rhawtuknaw kya athungpaw</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh thua.</para>
  <para style="q1">
    <verse number="9" style="v" />Pou koikua hae, hungkuh oh!</para>
  <para style="q2">Pou zungzae a umpaw</para>
  <para style="q1">thuakaw hae, hungkuh oh!</para>
  <para style="q2">aphu-epaw Siapharan yn tee cih.</para>
  <para style="q1">
    <verse number="10" style="v" />A phu-epaw Siapharan tuh hummou?</para>
  <para style="q2">Aning tuh vaaw <char style="nd">Bawipaw </char>,</para>
  <para style="q1">a phu-epaw Siapharan nynh thua.</para>
  <chapter number="25" style="c" />
  <para style="s1">Luenaw hanlan Sawsangnaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, na kalan</para>
  <para style="q2">saw ka sang.</para>
  <para style="q1">
    <verse number="2" style="v" />Pou ka Pachia, nang kae doliaku;</para>
  <para style="q2">maethyanaw yn muesah nan;</para>
  <para style="q1">ka rhaw hae kha ka tungvaw</para>
  <para style="q2">mih lungtuasah nan hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Nang ae ngaehoikuh hae paw tuh</para>
  <para style="q2">maethyanaw mue nan hae sah;</para>
  <para style="q1">akonglang um leite</para>
  <para style="q2">lungzi lei hae paw tuh</para>
  <para style="q1">maethyanaw mue hae sah.</para>
  <para style="q1">
    <verse number="4" style="v" />Pou <char style="nd">Bawipaw </char>, na laanpi kha</para>
  <para style="q2">yn nysah tua;</para>
  <para style="q2">na laanpi kha yn ccangpya tua.</para>
  <para style="q1">
    <verse number="5" style="v" />Nang tuh yn khumtu na thua zah,</para>
  <para style="q2">anin ninlang kae ngaehoiku keiccuze</para>
  <para style="q1">na byaccing thyhte yn cciakhae lah,</para>
  <para style="q2">yn ccangpya tua.</para>
  <para style="q1">
    <verse number="6" style="v" />Pou <char style="nd">Bawipaw </char>, langmawpi te</para>
  <para style="q2">na langsaku vae paw</para>
  <para style="q1">na thawccinaw te atynpaw</para>
  <para style="q2">na sungsahnaw kha tuathui tua.</para>
  <para style="q1">
    <verse number="7" style="v" />Ka di lya-e ka seinaw te</para>
  <para style="q2">ka cyiseimenaw kha liathui nan vae,</para>
  <para style="q2">Pou <char style="nd">Bawipaw </char>, nang tuh na hoy zah,</para>
  <para style="q1">atynpaw na sungsahnaw liate</para>
  <para style="q2">kae kha yn ning nan!</para>
  <para style="q1">
    <verse number="8" style="v" />
    <char style="nd">Bawipaw </char> tuh hoy zah a ding;</para>
  <para style="q2">tukeiccuze misei hae kha</para>
  <para style="q1">a laanpi a ccangpya hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Zakawsangsakuh hae paw kha</para>
  <para style="q2">laan dingpaw kya cciakhae hae zah,</para>
  <para style="q1">zakawsangsakuh hae paw kha</para>
  <para style="q2">a laanpi a ccangpya hae.</para>
  <para style="q1">
    <verse number="10" style="v" />
    <char style="nd">Bawipaw </char> laanpi balyn tuh</para>
  <para style="q2">a byakinnaw te a phunglang</para>
  <para style="q1">a zui hae paw hanlan</para>
  <para style="q2">atynpaw sungsahnaw te</para>
  <para style="q1">lungzinaw nynh thua.</para>
  <para style="q1">
    <verse number="11" style="v" />Pou <char style="nd">Bawipaw </char>, ka seinaw tuh</para>
  <para style="q2">myarya alung keiccuze,</para>
  <para style="q2">na min liate yn ngaethya.</para>
  <para style="q1">
    <verse number="12" style="v" />
    <char style="nd">Bawipaw </char> raw a rih hae paw tuh</para>
  <para style="q2">hum hae mou?</para>
  <para style="q1">Minmin nynh a poku lan hae paw</para>
  <para style="q2">laanpi kha a ccangpah cih hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Minmin tuh hiinhoyte</para>
  <para style="q2">a um cih hae zah,</para>
  <para style="q1">mih ccaaw hae nynh ram kha</para>
  <para style="q2">a ccou cih hae.</para>
  <para style="q1">
    <verse number="14" style="v" />
    <char style="nd">Bawipaw </char> te vaeccawkunaw tuh</para>
  <para style="q2">amaw raw a rih hae paw hanlan</para>
  <para style="q1">thua zah, a byakinnaw kha a nysah hae.</para>
  <para style="q1">
    <verse number="15" style="v" />
    <char style="nd">Bawipaw </char> kalan khe tyty ka do,</para>
  <para style="q2">pawccecize aning nynh ka ccu kha</para>
  <para style="q1">kaang kyate yn luesah cih.</para>
  <para style="q1">
    <verse number="16" style="v" />Ka kalan yn hawi lah, thaw yn ccitua,</para>
  <para style="q2">pawccecize ka lanme zah,</para>
  <para style="q2">vawsawnaw yn pya hae.</para>
  <para style="q1">
    <verse number="17" style="v" />Ka lungvawsawnaw hynh</para>
  <para style="q2">yn daesah lah,</para>
  <para style="q2">ka lungriathaenaw kyate yn luesah tua.</para>
  <para style="q1">
    <verse number="18" style="v" />Ka teingnaw te ka vawsawnaw hynh</para>
  <para style="q2">yn tuapah lah,</para>
  <para style="q1">ka seinaw balyn kha yn ngaethya.</para>
  <para style="q1">
    <verse number="19" style="v" />Ka rhaw hae tuh hohcihmou lung hae zah,</para>
  <para style="q2">hohcihmou yn hua hae cipaw tuatua.</para>
  <para style="q1">
    <verse number="20" style="v" />Ka hiinnaw hynh yn rin lah,</para>
  <para style="q2">yn khumtua;</para>
  <para style="q1">na kya ka reku keiccuze</para>
  <para style="q2">maethya yn lah nan.</para>
  <para style="q1">
    <verse number="21" style="v" />Nang kha kae ngaehoiku keiccuze,</para>
  <para style="q2">hoynaw te dingnaw nynh</para>
  <para style="q1">yn thungkhaw vae sah.</para>
  <para style="q1">
    <verse number="22" style="v" />Pou Pachia, Israel hae hynh</para>
  <para style="q2">mih vawsawnaw balyn kyate</para>
  <para style="q1">luesah tua hae.</para>
  <chapter number="26" style="c" />
  <para style="s1">Ccungccaw Hoypaw Sawsangnaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">dingnaw laanpi kha ka zui zah,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha ka thinlung balyn te</para>
  <para style="q2">ka doliaku keiccuze,</para>
  <para style="q1">seinaw hoi leipaw ka thuanaw kha</para>
  <para style="q2">langsahpya tua hae.</para>
  <para style="q1">
    <verse number="2" style="v" />Pou <char style="nd">Bawipaw </char>, kae hynh</para>
  <para style="q2">yn veitua lah, yn syntawtua;</para>
  <para style="q1">ka thinlung te ka tuanaw hynh</para>
  <para style="q2">yn do mamiatua.</para>
  <para style="q1">
    <verse number="3" style="v" />Atynpaw na sungsahnaw kha</para>
  <para style="q2">tyty ka ccykekuh zah,</para>
  <para style="q2">na lungzinaw kyakhe ka cceih.</para>
  <para style="q1">
    <verse number="4" style="v" />Ccungkia lei hae paw ryte</para>
  <para style="q2">kae dahungkheih khyh zah,</para>
  <para style="q1">a thyaruh hae paw ryte</para>
  <para style="q2">kae ccuepekuh khyh.</para>
  <para style="q1">
    <verse number="5" style="v" />Hoyleinaw a rae hae paw phu kha</para>
  <para style="q2">ka hua zah,</para>
  <para style="q1">ccungccaw hoylei hae paw ryte</para>
  <para style="q2">kae mungkuh khyh.</para>
  <para style="q1">
    <verse number="6" style="v" />Pou <char style="nd">Bawipaw </char>, seinaw ka hoi khyhpaw kha</para>
  <para style="q2">langsaku khylan ka kuih</para>
  <para style="q1">ka singkuh zah,</para>
  <para style="q2">na silawhang pepan khe ka cceih,</para>
  <para style="q1">
    <verse number="7" style="v" />Lungtuanaw hlaw kha</para>
  <para style="q2">accae lante ka sah zah,</para>
  <para style="q1">ngaeang lan umpaw</para>
  <para style="q2">na cyipaw balyn kha ka ho.</para>
  <para style="q1">
    <verse number="8" style="v" />Pou <char style="nd">Bawipaw </char>, na umnaw inn te</para>
  <para style="q2">na phu-enaw a umnaw hmin kha ka ry.</para>
  <para style="q1">
    <verse number="9" style="v" />Misei hae ryte yn rohkheih nan lah,</para>
  <para style="q2">ccungccaw a theih hae paw ryte</para>
  <para style="q2">ka hiinnaw hynh yn rohkheih nan,</para>
  <para style="q1">
    <verse number="10" style="v" />mih kuih tuh ahoy leipaw</para>
  <para style="q2">cyinawpaw lang mang hae zah,</para>
  <para style="q1">mih ranglang kuih tuh</para>
  <para style="q2">pyaruh te phe abeih.</para>
  <para style="q1">
    <verse number="11" style="v" />Thuasalama kae tuh,</para>
  <para style="q2">dingnaw laanpi kha ka zui;</para>
  <para style="q1">kae kha yn shawkhaw lah,</para>
  <para style="q2">thaw yn ccih.</para>
  <para style="q1">
    <verse number="12" style="v" />Ka ccu tuh bialae khe ka thadyn zah,</para>
  <para style="q2">zapi pumkunaw kyakhe</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha ka thehoysah.</para>
  <chapter number="27" style="c" />
  <para style="s1">Thehoysahnaw Hlaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> tuh ka awnaw te</para>
  <para style="q2">kae yn khumtu nynh thua;</para>
  <para style="q2">Hum raw mou ka rih cih?</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> tuh ka hiinnaw</para>
  <para style="q2">a rekunaw nynh thua;</para>
  <para style="q1">Hummou ka ripah cih?</para>
  <para style="q1">
    <verse number="2" style="v" />Kae yn rawsepaw rhaw hae,</para>
  <para style="q2">ccungccaw hoylei hae paw nynh</para>
  <para style="q2">ka ngesaw kha ae lan</para>
  <para style="q1">he yn rawse hae tuh,</para>
  <para style="q2">thykuh hae zah a khuliakuh hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Rhawkaw phu nynh kae kha</para>
  <para style="q2">rawsete yn sannua hae zemah,</para>
  <para style="q2">ka thinlung tuh rih lan khyh;</para>
  <para style="q1">kae kha rawsete rhaw a tho hae zemah,</para>
  <para style="q2">zynkunaw ka hoi cih.</para>
  <para style="q1">
    <verse number="4" style="v" />
    <char style="nd">Bawipaw </char> kha uccaw ccangkheit ka ngiaku,</para>
  <para style="q2">tuh-e tuh ka ccungkuh ung cih:</para>
  <para style="q1">tuh-e tuh ka hiin lungkhu balyn</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> inn kya um khylan,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> puithyanaw muih khylan te</para>
  <para style="q2">amaw rynaw ccung khylan nynh thua.</para>
  <para style="q1">
    <verse number="5" style="v" />Pawccecize vawsaw ccyh lyakhe,</para>
  <para style="q2">kae kha a bu kya yn resakuh cih;</para>
  <para style="q1">a beikinn lungkhu kya yn resaku;</para>
  <para style="q2">lungpi ahangnaw vawlan yn khang.</para>
  <para style="q1">
    <verse number="6" style="v" />Atu ka pepan umpaw</para>
  <para style="q2">ka rhaw hae luki langkhe</para>
  <para style="q2">ka lu kha yn hangthung,</para>
  <para style="q1">lungtuanaw roisawte</para>
  <para style="q2">beikinn kya silawnaw ka rae cih;</para>
  <para style="q1">hlaw ka sah cih zah, <char style="nd">Bawipaw </char> kalan</para>
  <para style="q2">thehoysahnaw hlaw ka sah cih.</para>
  <para style="q1">
    <verse number="7" style="v" />Pou <char style="nd">Bawipaw </char>, ka siapaw roi kha</para>
  <para style="q2">yn thaepya tua,</para>
  <para style="q2">thaw yn ccih lah, yn leihtua!</para>
  <para style="q1">
    <verse number="8" style="v" />“Rang lah, <char style="nd">Bawipaw </char> mae kha</para>
  <para style="q2">ccungtua!” cite he na ho te,</para>
  <para style="q1">kae nynh, “<char style="nd">Bawipaw </char>, na mae kha</para>
  <para style="q2">kae ccung cih,” ka ci.</para>
  <para style="q1">
    <verse number="9" style="v" />Na mae kha yn retawkuh nan.</para>
  <para style="q1">Na ryalahtu hynh thinriate</para>
  <para style="q2">yn maeleihtawkuh nan,</para>
  <para style="q2">nang tuh yn bawmtu nynh na thua.</para>
  <para style="q1">Pou yn khumtu Pachia,</para>
  <para style="q2">yn cciataw nan lah, yn vua nan.</para>
  <para style="q1">
    <verse number="10" style="v" />Ka nung te ka paaw nynh</para>
  <para style="q2">phe yn vua hae zemah,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh yn hoeikuh cih.</para>
  <para style="q1">
    <verse number="11" style="v" />
    <char style="nd">Bawipaw </char>, na laanpi kha</para>
  <para style="q2">yn ccangpya tua;</para>
  <para style="q1">ka rhaw hae keiccuze</para>
  <para style="q2">alawpaw laanpi kyakhe</para>
  <para style="q2">yn cciakhae tua.</para>
  <para style="q1">
    <verse number="12" style="v" />Ahme leipaw ccaekia hae nynh</para>
  <para style="q2">rawsete yn thonuakuh hae zah,</para>
  <para style="q1">huakunaw hy kha thawte</para>
  <para style="q2">a sue hae keiccuze</para>
  <para style="q1">ka rhaw hae rynaw kalan yn ap nan.</para>
  <para style="q1">
    <verse number="13" style="v" />A hiin hae paw ram kyakhe</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> hoynaw kha</para>
  <para style="q2">ka muih cih cite ka zyn.</para>
  <para style="q1">
    <verse number="14" style="v" />
    <char style="nd">Bawipaw </char> kha ngaehoikuh oh;</para>
  <para style="q2">nae thawsaesakuh oh lah,</para>
  <para style="q1">rawthungnaw thinlung hoi oh;</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha ngaehoikuh oh!</para>
  <chapter number="28" style="c" />
  <para style="s1">Bawmnaw Mue khylan Sawsangnaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, nang kha kae ko;</para>
  <para style="q2">ka lungpi, ka roi thaepya leite</para>
  <para style="q2">yn um nan,</para>
  <para style="q1">pawccecize yccae leite na um zetuh,</para>
  <para style="q2">michi khua lang a cceihbung hae paw hawte</para>
  <para style="q2">ka thuasei cih.</para>
  <para style="q1">
    <verse number="2" style="v" />Athyaa huaccepaw</para>
  <para style="q2">na beikinnthyaa langkhe</para>
  <para style="q1">ka kuih hangthungte</para>
  <para style="q2">bawmnaw mue khylan ka sia zah,</para>
  <para style="q1">kae ngiakunawpaw roi kha</para>
  <para style="q2">yn thaepya tua.</para>
  <para style="q1">
    <verse number="3" style="v" />Mih thinlung kya rysawthyanaw</para>
  <para style="q2">mang a um pite, mih innpaw hae ryte</para>
  <para style="q2">daenaw bya a ho hae paw,</para>
  <para style="q1">hoyleinaw a rae hae paw</para>
  <para style="q2">ccungccaw hoylei hae paw ryte</para>
  <para style="q2">kae kha po yn suebua nan.</para>
  <para style="q1">
    <verse number="4" style="v" />Minmin kha mih ryalawnaw thyhte thuasah,</para>
  <para style="q2">ahoy leipaw mih cyisahnaw</para>
  <para style="q1">thyhte thuasah liaru hae;</para>
  <para style="q2">mih kuih nynh rya a law thyhte liaru hae;</para>
  <para style="q1">minmin nynh mue lan</para>
  <para style="q2">accan hae paw kha pya hae.<note caller="-" style="x"><char style="xo" closed="false">28.4: </char><char style="xt" closed="false"><ref loc="REV 22:12">Bya 22.12</ref></char></note></para>
  <para style="q1">
    <verse number="5" style="v" />
    <char style="nd">Bawipaw </char> ryalawnaw kha thuasah,</para>
  <para style="q2">a kuih te rya a lawpaw kha thuasah</para>
  <para style="q2">pawlang a ria khyh hae keiccuze,</para>
  <para style="q1">minmin kha a roh cih hae zah,</para>
  <para style="q2">thosakuh thui vae lan khyh hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Bawmnaw ka ngianawpaw roi kha</para>
  <para style="q2">a thae vae keiccuze</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha thehoysah oh.</para>
  <para style="q1">
    <verse number="7" style="v" />
    <char style="nd">Bawipaw </char> tuh ka thawzung te</para>
  <para style="q2">ka khawriaphua nynh thua;</para>
  <para style="q2">ka thinlung nynh amaw kha a doliaku;</para>
  <para style="q1">tukeiccuze kae kha yn bawm zah,</para>
  <para style="q2">ka thinlung tuh a lungtua,</para>
  <para style="q1">amaw kha ka hlaw te the ka hoysah.</para>
  <para style="q1">
    <verse number="8" style="v" />
    <char style="nd">Bawipaw </char> tuh a ccungccaw hae hanlan</para>
  <para style="q2">thawzung nynh thua;</para>
  <para style="q1">aning tuh amaw nynh chitui a thuhpaw kya-e</para>
  <para style="q2">khumnawpaw khynnaw nynh thua.</para>
  <para style="q1">
    <verse number="9" style="v" />Na ccungccaw hae kha khum hae lah,</para>
  <para style="q2">na rho ccungccaw hae kha</para>
  <para style="q1">hythuapya hae;</para>
  <para style="q2">nang tuh minmin hanlan</para>
  <para style="q1">tuurinpaw thua lah,</para>
  <para style="q2">zungzae do-oih hae.</para>
  <chapter number="29" style="c" />
  <para style="s1">Khise kya <char style="nd">Bawipaw </char> Roi</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou vaawccungccaw hae,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha thehoysah oh,</para>
  <para style="q1">a phu-enaw te a lesaenaw kha</para>
  <para style="q2">thehoysah oh.<note caller="-" style="x"><char style="xo" closed="false">29.1-2: </char><char style="xt" closed="false"><ref loc="PSA 96:7-9">Sam 96.7-9</ref></char></note></para>
  <para style="q1">
    <verse number="2" style="v" />
    <char style="nd">Bawipaw </char> a min phu-enaw kha</para>
  <para style="q2">thehoysah oh;</para>
  <para style="q1">athyaapaw ccaannaw khate</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha beik oh.</para>
  <para style="q1">
    <verse number="3" style="v" />
    <char style="nd">Bawipaw </char> roi tuh rili vawlan khe accae;</para>
  <para style="q2">phu-enaw Pachia tuh</para>
  <para style="q1">kholung hawte thyh zah,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> tuh myarya lungpaw</para>
  <para style="q2">tui vawlan khe a um.</para>
  <para style="q1">
    <verse number="4" style="v" />
    <char style="nd">Bawipaw </char> roi tuh huhan a hoi;</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> roi tuh lesaenaw te</para>
  <para style="q2">phe abeih.</para>
  <para style="q1">
    <verse number="5" style="v" />
    <char style="nd">Bawipaw </char> roi nynh</para>
  <para style="q2">sidar thingku hae kha a khya.</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh Lebanon e</para>
  <para style="q2">sidar ku hae kha a khya.</para>
  <para style="q1">
    <verse number="6" style="v" />Lebanon mua kha vaetuataw hawte</para>
  <para style="q2">thohsakuh zah,</para>
  <para style="q1">Sirion kha anopaw ccungtepaw hawte a thohsaku.</para>
  <para style="q1">
    <verse number="7" style="v" />
    <char style="nd">Bawipaw </char> roi nynh maeesoi kha</para>
  <para style="q2">a awsah.</para>
  <para style="q1">
    <verse number="8" style="v" />
    <char style="nd">Bawipaw </char> roi nynh ramkaw kha</para>
  <para style="q2">a hysah;</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh Kadesh ramkaw kha a hysah.</para>
  <para style="q1">
    <verse number="9" style="v" />
    <char style="nd">Bawipaw </char> roi nynh sazuh pinung kha</para>
  <para style="q2">ataw a thansah,</para>
  <para style="q1">thingnaw kha a khuasaku;</para>
  <para style="q2">te a beikinn kyakhe</para>
  <para style="q1">ccungccaw hae balyn nynh, “Phu-e sah!”</para>
  <para style="q2">a ci hae.</para>
  <para style="q1">
    <verse number="10" style="v" />
    <char style="nd">Bawipaw </char> tuh tuileih vawlan khe a haung;</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> tuh siapharan lante zungzae a haung.</para>
  <para style="q1">
    <verse number="11" style="v" />
    <char style="nd">Bawipaw </char> nynh a ccungccaw hae kha</para>
  <para style="q2">thawzung pya vae hae sah!</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh a ccungccaw hae kha</para>
  <para style="q2">daenaw te hythuapya vae hae sah!</para>
  <chapter number="30" style="c" />
  <para style="s1">Lungtua Sawsangnaw<note caller="+" style="f"><char style="fr" closed="false">30 Abyalu: </char><char style="ft" closed="false">David hlaw, Beikinn apnawpaw hlaw.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, kae thehoysah cih,</para>
  <para style="q2">pawccecize nae khum vae zah,</para>
  <para style="q1">ka rhaw hae kha kae ka keiccuze</para>
  <para style="q2">mih lung na tuasah khyh hae.</para>
  <para style="q1">
    <verse number="2" style="v" />Pou <char style="nd">Bawipaw </char> ka Pachia,</para>
  <para style="q2">na kalan bawmnaw ngiakute</para>
  <para style="q1">ka sia zah,</para>
  <para style="q2">kae kha nae dansah vae.</para>
  <para style="q1">
    <verse number="3" style="v" />Pou <char style="nd">Bawipaw </char>, ka muisaw kha</para>
  <para style="q2">michi khua kyate na lawthung,</para>
  <para style="q1">Hunghua lungkhu lang</para>
  <para style="q2">a rungbung hae paw kyate</para>
  <para style="q1">hiinnaw kha bua nae pya.</para>
  <para style="q1">
    <verse number="4" style="v" />Pou alungzipaw a mithyaa hae nanning,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha thehoysahnaw</para>
  <para style="q1">hlawsahpah oh,</para>
  <para style="q2">athyaapaw a min kha thehoysah oh.</para>
  <para style="q1">
    <verse number="5" style="v" />A thinrianaw tuh</para>
  <para style="q2">sosoh kyalya nynh thua,</para>
  <para style="q2">a hoynaw tuh shemazi hanlan nynh thua.</para>
  <para style="q1">Khuazi kya rawkhuinaw um salamah,</para>
  <para style="q2">awkhua kya vae tuh lungtuanaw yn thua.</para>
  <para style="q1">
    <verse number="6" style="v" />Hoynaw ka mue lya tuh,</para>
  <para style="q2">“Yn tae boi lan khyh hae,” ka ci.</para>
  <para style="q1">
    <verse number="7" style="v" />Pou <char style="nd">Bawipaw </char>, na hoynaw liate,</para>
  <para style="q2">tynkaringpaw mua hawte</para>
  <para style="q1">kae kha nae tynsah vae.</para>
  <para style="q2">na mitmae nae retawku vae ze,</para>
  <para style="q1">rinaw te phe ka beih.</para>
  <para style="q1">
    <verse number="8" style="v" />Pou <char style="nd">Bawipaw </char>, na kalan ka sia zah,</para>
  <para style="q2">bawmnaw kae ngiaku:</para>
  <para style="q1">
    <verse number="9" style="v" />Ka chih zah shawku langkhe</para>
  <para style="q2">hung ka ccia lanze,</para>
  <para style="q2">pawmou thanenaw a um?</para>
  <para style="q1">Laenoi nynh nang kha</para>
  <para style="q2">ae thehoysah cih tou?</para>
  <para style="q2">Na lungzinaw kong kha a ho cih tou?</para>
  <para style="q1">
    <verse number="10" style="v" />Pou <char style="nd">Bawipaw </char>, ka bya yn thaepah lah,</para>
  <para style="q2">thaw beih yn ccih!</para>
  <para style="q1">Pou <char style="nd">Bawipaw </char>, kae yn bawmtu thuatua!</para>
  <para style="q1">
    <verse number="11" style="v" />Ka raw ka khuinaw kha</para>
  <para style="q2">lawnaw lang nae paleihpya vae;</para>
  <para style="q1">ka raw ka khuinawpaw buriboei kha</para>
  <para style="q2">nae khahpah zah,</para>
  <para style="q2">lungtuanaw boei kha nae zingsaku.</para>
  <para style="q1">
    <verse number="12" style="v" />Tetuh ka muisaw tuh daebabi lan</para>
  <para style="q2">um lan khyh zah,</para>
  <para style="q1">nang kha ae thehoysah cih.</para>
  <para style="q2">Pou <char style="nd">Bawipaw </char> ka Pachia,</para>
  <para style="q1">nang kha zungzae kae thehoysah cih.</para>
  <chapter number="31" style="c" />
  <para style="s1">Pachia Doliakute Sawsangnaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, na kya ka rekuh;</para>
  <para style="q2">maethyate yn nung nan;</para>
  <para style="q2">na dingnaw te yn luesah tua.</para>
  <para style="q1">
    <verse number="2" style="v" />Na nakaring kha ka kalan</para>
  <para style="q2">yn tuaku tua lah,</para>
  <para style="q2">arangte beih yn khumtua.</para>
  <para style="q1">Nang tuh ka hanlan khynnaw</para>
  <para style="q2">lungpi thua lah,</para>
  <para style="q1">kae kha khum khylan sihkakinpaw</para>
  <para style="q2">rhawlungrua thuatua.</para>
  <para style="q1">
    <verse number="3" style="v" />Nang tuh ka lungpi te</para>
  <para style="q2">ka rhawlungrua nynh na thua ccaccing;</para>
  <para style="q1">pawccecize na min hanlan</para>
  <para style="q2">yn cciakhae lah, yn muihsah tua,</para>
  <para style="q1">
    <verse number="4" style="v" />yn syakhaw hae paw kaang kyate</para>
  <para style="q2">yn luesah tua,</para>
  <para style="q1">pawccecize nang tuh</para>
  <para style="q2">ka khynnaw nynh na thua.</para>
  <para style="q1">
    <verse number="5" style="v" />Ka muisaw hynh na kuih kya kae ap;</para>
  <para style="q2">Pou <char style="nd">Bawipaw </char>, alungzipaw Pachia,</para>
  <para style="q2">kae kha nae shawkhaw vae.<note caller="-" style="x"><char style="xo" closed="false">31.5: </char><char style="xt" closed="false"><ref loc="LUK 23:46">Luk 23.46</ref></char></note></para>
  <para style="q1">
    <verse number="6" style="v" />Ccungkia leipaw zohtuh</para>
  <para style="q2">a beik hae paw kha na hua hae,</para>
  <para style="q1">thuasalama kae tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha kae doliaku.</para>
  <para style="q1">
    <verse number="7" style="v" />Atynpaw na sungsahnaw liate</para>
  <para style="q2">ka lungtua cih zah ka lungpaw cih,</para>
  <para style="q1">pawccecize ka teingnaw kha</para>
  <para style="q2">nae muihpah zah</para>
  <para style="q2">ka vawsawnaw kha pe nae kipya vae,</para>
  <para style="q1">
    <verse number="8" style="v" />ka rhaw hae kuih kalan nae ap khyh;</para>
  <para style="q2">akonaw hmin kya nae cciasah.</para>
  <para style="q1">
    <verse number="9" style="v" />Pou <char style="nd">Bawipaw </char>, ka lungvawsaw keiccuze,</para>
  <para style="q2">thaw beih yn ccih;</para>
  <para style="q1">Ka rawnaw ze ka mit phin zah,</para>
  <para style="q2">ka pyn te ka muisaw mah phe roh vae.</para>
  <para style="q1">
    <verse number="10" style="v" />Ka hiinshe tuh ngaethyanaw te dyadya lia zah,</para>
  <para style="q2">ka kum hae tuh hawkhaekute accyh alia.</para>
  <para style="q1">Ka seinaw keiccuze</para>
  <para style="q2">ka thaw phe thang zah,</para>
  <para style="q1">ka ru hae mah phe mawe hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Ka rhaw hae balyn nynh yn sarya hae,</para>
  <para style="q2">ka innpaw hae nynh yn dothatheih hae,</para>
  <para style="q1">kae ccawkuh hae paw nynh yn ri hae;</para>
  <para style="q2">laanpi kya yn muih hae paw nynh</para>
  <para style="q2">yn ccuetaw hae.</para>
  <para style="q1">
    <verse number="12" style="v" />A nyhkuh leipaw a chihpaw hawte</para>
  <para style="q2">yn ning vae hae;</para>
  <para style="q2">ang koipaw hawte nynh ka thua vae.</para>
  <para style="q1">
    <verse number="13" style="v" />Ccungccaw patae nynh aruh lante</para>
  <para style="q2">ka thang yn ho hae paw kha ka thae,</para>
  <para style="q2">ka pepan balyn rinaw te phe abeih,</para>
  <para style="q1">kae kha rawsete pynkheihlan</para>
  <para style="q2">khua a khanku hae,</para>
  <para style="q1">kae kha chia lan cite</para>
  <para style="q2">yn paccynnuaku hae.</para>
  <para style="q1">
    <verse number="14" style="v" />Thuasalama, pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">nang kha kae doliaku;</para>
  <para style="q2">“Nang tuh ka Pachia nynh na thua,” ka ci.</para>
  <para style="q1">
    <verse number="15" style="v" />Ka ccyh tuh na kuih kya nynh a um;</para>
  <para style="q2">ka rhaw hae te yn tuaa yn sah hae paw</para>
  <para style="q2">kuih kyate yn luesah tua.</para>
  <para style="q1">
    <verse number="16" style="v" />Na ryalahtupaw tungvaw kya</para>
  <para style="q2">na mitmae tuh aw sah;</para>
  <para style="q2">atynpaw na sungsahnaw te yn khumtua.</para>
  <para style="q1">
    <verse number="17" style="v" />Pou <char style="nd">Bawipaw </char>, nang kha</para>
  <para style="q2">kae ko keiccuze,</para>
  <para style="q2">maethyate yn nung nan,</para>
  <para style="q1">ccungccaw hoylei hae paw tuh</para>
  <para style="q2">maethyanaw mue hae sah;</para>
  <para style="q1">Michi khua kya daetedae lan</para>
  <para style="q2">um hae sah.</para>
  <para style="q1">
    <verse number="18" style="v" />Lysaku, tansaku te miding hae kha</para>
  <para style="q2">rawsete sawtua leinaw byaho hae zah,</para>
  <para style="q1">ahynpaw munglae hae tuh zya dae hae sah.</para>
  <para style="q1">
    <verse number="19" style="v" />Na raw a rih hae paw hanlan</para>
  <para style="q2">na la ccakhungpaw hoynaw te</para>
  <para style="q1">ccungccaw miakaw muihnaw kyakhe,</para>
  <para style="q2">na kya a rekuh hae paw hanlan</para>
  <para style="q1">na paccynpaw hoynaw tuh</para>
  <para style="q2">pawcih baban mou ahoy!</para>
  <para style="q1">
    <verse number="20" style="v" />Ccungccaw nynh aruh lante paccynnaw kyate</para>
  <para style="q2">akhynpaw na umnaw kyakhe</para>
  <para style="q1">minmin kha na thuruh hae;</para>
  <para style="q2">pekunaw apuisahpaw bya kyate</para>
  <para style="q1">na umnaw kyakhe khyndadyh lan</para>
  <para style="q2">na nung hae.</para>
  <para style="q1">
    <verse number="21" style="v" />
    <char style="nd">Bawipaw </char> tuh thehoysah oh,</para>
  <para style="q2">pawccecize rhaw nynh a koihlupaw</para>
  <para style="q1">khuapi hawte kae kha he yn koihlu hae tuh,</para>
  <para style="q2">atynpaw a sungsahnaw kha</para>
  <para style="q1">ngaeangthua lan um lante</para>
  <para style="q2">yn langsapyaku vae.</para>
  <para style="q1">
    <verse number="22" style="v" />“Na muihnaw kyate</para>
  <para style="q2">ccaring nae dee vae,” cite</para>
  <para style="q1">thinphangte ka tuaku.</para>
  <para style="q2">Thuasalama bawmnaw mue khylan</para>
  <para style="q1">na kalan he ka sia tuh,</para>
  <para style="q2">kae ngiakunaw kha nae thaepya.</para>
  <para style="q1">
    <verse number="23" style="v" />Nanning a mithyaa hae balyn,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha sungsah oh.</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh mih lungzi hae paw kha</para>
  <para style="q2">a thungkhaw hae,</para>
  <para style="q1">thuasalama a lysakuh hae paw kha</para>
  <para style="q2">myarya ccih lante a liaru hae.</para>
  <para style="q1">
    <verse number="24" style="v" />
    <char style="nd">Bawipaw </char> a ngaehoikuh hae paw</para>
  <para style="q2">nanning balyn, nae thawsae sah lah,</para>
  <para style="q1">nae rawthung sah.</para>
  <chapter number="32" style="c" />
  <para style="s1">Seingaethyanaw te Lungtuanaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />A seinaw kha ngaethya athuapaw tuh</para>
  <para style="q2">lungtuapaw nynh thua,</para>
  <para style="q2">a seinaw kha bongpya athua vae.<note caller="-" style="x"><char style="xo" closed="false">32.1-2: </char><char style="xt" closed="false"><ref loc="ROM 4:7-8">Rom 4.7-8</ref></char></note></para>
  <para style="q1">
    <verse number="2" style="v" />
    <char style="nd">Bawipaw </char> nynh na sei khyh a cipaw,</para>
  <para style="q2">a thinlung kya lingnaw a um leipaw</para>
  <para style="q1">ccungccaw tuh lungtuapaw nynh thua.</para>
  <para style="q1">
    <verse number="3" style="v" />Ka seinaw phyku leite he ka um tuh,</para>
  <para style="q2">anin ninlang ka hawkhaeku keiccuze</para>
  <para style="q2">ka pynsaw phe voi.</para>
  <para style="q1">
    <verse number="4" style="v" />Pawccecize khuazi khuadae</para>
  <para style="q2">na kuih nynh phang yn ne;</para>
  <para style="q1">hawnin asopaw keiccuze karae arou hawte</para>
  <para style="q2">ka thawzung tuh karae rou.</para>
  <para style="q1">
    <verse number="5" style="v" />Tetuh ka cyiseimenaw kha</para>
  <para style="q2">na kya ka phykuh zah,</para>
  <para style="q1">ka hoyleinaw kha ka thuruh khyh;</para>
  <para style="q2">“Ka seimenaw kha <char style="nd">Bawipaw </char> kalan</para>
  <para style="q1">ka phykuh cih,” ka ci zah,</para>
  <para style="q2">ka seinaw kha nae ngaethya vae.</para>
  <para style="q1">
    <verse number="6" style="v" />Tukeiccuze mih lungzi hae paw balyn nynh</para>
  <para style="q2">vawsaw ccyh lya</para>
  <para style="q2">na kalan sawsang hae sah;</para>
  <para style="q1">tui lepaw nynh minmin kha</para>
  <para style="q2">thuanua lan khyh hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Nang tuh ka rekunaw hmin nynh na thua;</para>
  <para style="q2">vawsawnaw kyate nae thungkhaw;</para>
  <para style="q1">luenaw hlaw khate kae kha nae koihlu.</para>
  <para style="q1">
    <verse number="8" style="v" />Nang kha kae thuihei cih zah</para>
  <para style="q2">na zui lanpaw laanpi kha kae ccangpah cih;</para>
  <para style="q2">nang kha tuanaw pyate kae do-oih cih.</para>
  <para style="q1">
    <verse number="9" style="v" />Nythyanaw hoi leipaw marang te</para>
  <para style="q2">lann hae te lokuh nan oh,</para>
  <para style="q1">hynh-e hae tuh mih mung kya</para>
  <para style="q2">rangtei teisahte kia aho hae,</para>
  <para style="q1">tuhkhyhze tuh na pepan um lan khyh hae.</para>
  <para style="q1">
    <verse number="10" style="v" />Ccungccaw hoylei hae paw tuh</para>
  <para style="q2">vawsawnaw patae a tung hae,</para>
  <para style="q1">thuasalama <char style="nd">Bawipaw </char> a doliakuh hae paw tuh</para>
  <para style="q2">atynpaw sungsahnaw nynh a koihlu hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Pou miding hae, <char style="nd">Bawipaw </char> kya</para>
  <para style="q2">nae lungtua sah lah, nae lungpaw sah,</para>
  <para style="q1">thinlung a ding hae paw balyn,</para>
  <para style="q2">lungtuate sia oh.</para>
  <chapter number="33" style="c" />
  <para style="s1">Pachia Lesaenaw te Hoynaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou miding hae nanning,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kya nae lungtua sah,</para>
  <para style="q1">Thehoysahnaw tuh miding hae te</para>
  <para style="q2">angaekuhpaw nynh thua.</para>
  <para style="q1">
    <verse number="2" style="v" />
    <char style="nd">Bawipaw </char> kha tintang te</para>
  <para style="q2">thehoysah oh;</para>
  <para style="q1">arui ruihaw asuikuhpaw tintang te</para>
  <para style="q2">thehoysahnaw hlawsah oh.</para>
  <para style="q1">
    <verse number="3" style="v" />Amaw kalan hlaw thawpaw kha sah oh;</para>
  <para style="q2">kou hoy lan tintang khuakuh oh lah,</para>
  <para style="q1">kou ccae lan hlawsah oh.</para>
  <para style="q1">
    <verse number="4" style="v" />Pawccecize <char style="nd">Bawipaw </char> bya tuh ading,</para>
  <para style="q2">rya a lawpaw balyn tuh zyn lan a um.</para>
  <para style="q1">
    <verse number="5" style="v" />
    <char style="nd">Bawipaw </char> nynh dingnaw te</para>
  <para style="q2">byading kha a ry;</para>
  <para style="q1">laephi tuh atynpaw <char style="nd">Bawipaw </char></para>
  <para style="q2">sungsahnaw te phe abeih.</para>
  <para style="q1">
    <verse number="6" style="v" />Vaawlui tuh <char style="nd">Bawipaw </char> bya liate</para>
  <para style="q2">rae thua zah,</para>
  <para style="q1">vaawlui kya umpaw balyn tuh</para>
  <para style="q2">a khalang kya-e hy liate rae athua.</para>
  <para style="q1">
    <verse number="7" style="v" />Rili tui hae kha paling lungkhu e</para>
  <para style="q2">tui hawte san kheit kya a ccakhung hae;</para>
  <para style="q1">akhupaw rilipi hae kha</para>
  <para style="q2">ccakhungnaw inn kyakhe a ccakhung.</para>
  <para style="q1">
    <verse number="8" style="v" />Laephi pynpi nynh <char style="nd">Bawipaw </char> kha rih sah;</para>
  <para style="q2">laephipi kya-e ccungccaw hae balyn nynh</para>
  <para style="q2">amaw kha sawtua hae sah.</para>
  <para style="q1">
    <verse number="9" style="v" />Pawccecize <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">ho zah, laephi tuh yn um;</para>
  <para style="q1">kaw a pya thyhte tynkaring lan</para>
  <para style="q2">a thadyn.</para>
  <para style="q1">
    <verse number="10" style="v" />Minphuin hae nynh a paccynku hae paw kha</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh accakaepaw lang</para>
  <para style="q1">a tangsahpya hae;</para>
  <para style="q2">ccungccaw hae tuakunaw kha a ropya hae.</para>
  <para style="q1">
    <verse number="11" style="v" />
    <char style="nd">Bawipaw </char> paccynnaw tuh</para>
  <para style="q2">zungzae atyn,</para>
  <para style="q1">a thinlung kya-e a tuanaw hae tuh</para>
  <para style="q2">she takyh hanlan atyn.</para>
  <para style="q1">
    <verse number="12" style="v" />
    <char style="nd">Bawipaw </char> kha mih Pachia lang</para>
  <para style="q2">a hoi hae paw minphuin tuh</para>
  <para style="q1">lungtuapaw minphuin nynh thua,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh amaw a rho lang</para>
  <para style="q1">a poku hae paw ccungccaw hae tuh</para>
  <para style="q2">lungtuapaw nynh thua hae.</para>
  <para style="q1">
    <verse number="13" style="v" />
    <char style="nd">Bawipaw </char> nynh vaawram te</para>
  <para style="q2">dobung zah,</para>
  <para style="q2">ccungccaw miakaw kha a muih.</para>
  <para style="q1">
    <verse number="14" style="v" />A umnaw kyate laephi vaw e</para>
  <para style="q2">ahiinpaw balyn kha do zah,</para>
  <para style="q2">mih cyisahnaw balyn kha marya a muih,</para>
  <para style="q1">
    <verse number="15" style="v" />mih thinlung balyn kha rae zah,</para>
  <para style="q2">mih cyisahnaw balyn kha marya a muih.</para>
  <para style="q1">
    <verse number="16" style="v" />Siapharan tuh myarya lungpaw</para>
  <para style="q2">a rhawkaw phupi liate khum thua khyh;</para>
  <para style="q1">rhawkaw tuh a thawzung myarya</para>
  <para style="q2">a um liate luesah thua khyh.</para>
  <para style="q1">
    <verse number="17" style="v" />Rhawtuknawpaw marang tuh</para>
  <para style="q2">rhaw taenaw hanlan</para>
  <para style="q1">accakaepaw ngaehoinaw nynh thua,</para>
  <para style="q2">myarya lepaw a thungnaw nynh</para>
  <para style="q1">khum kho khyh.</para>
  <para style="q1">
    <verse number="18" style="v" />
    <char style="nd">Bawipaw </char> raw a rih hae paw te</para>
  <para style="q2">atynpaw a sungsahnaw</para>
  <para style="q2">a ngaehoikuh hae paw kha</para>
  <para style="q1">
    <verse number="19" style="v" />chinaw kyate luesah khylan te</para>
  <para style="q2">ccakan a cci lya mih hiinnaw kha</para>
  <para style="q1">khynsah khylan <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">tyty a do hae.</para>
  <para style="q1">
    <verse number="20" style="v" />Aening muisaw nynh <char style="nd">Bawipaw </char> kha</para>
  <para style="q2">a ngaehoiku;</para>
  <para style="q1">aning tuh aening oun bawmtu te</para>
  <para style="q2">ah khawriaphua nynh thua.</para>
  <para style="q1">
    <verse number="21" style="v" />A min thyaapaw kha</para>
  <para style="q2">ah doliaku oh keiccuze</para>
  <para style="q2">aening thinlung tuh amaw kya a lungtua.</para>
  <para style="q1">
    <verse number="22" style="v" />Pou <char style="nd">Bawipaw </char>, nang kha</para>
  <para style="q2">kae ngaehoiku thyhawte</para>
  <para style="q1">atynpaw na sungsahnaw tuh</para>
  <para style="q2">kae tungvaw um sah.</para>
  <chapter number="34" style="c" />
  <para style="s1">
    <note caller="-" style="x">
      <char style="xo" closed="false">34 Abyalu: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 21:13-15">1Sa 21.13-15</ref>
      </char>
    </note> Luesahnaw keiccuze Thehoysahnaw<note caller="+" style="f"><char style="fr" closed="false">34 Abyalu: </char><char style="ft" closed="false">David nynh Abimelek malang khe ngaeesakuh nyn zah Abimelek nynh ccaring a dee koute David nynh e hlaw hynh a phua.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> kha accyh takyh kya</para>
  <para style="q2">ka thehoysah cih;</para>
  <para style="q1">amaw thehoysahnaw kha</para>
  <para style="q2">ka mung te po ka ho cih.</para>
  <para style="q1">
    <verse number="2" style="v" />Ka muisaw tuh <char style="nd">Bawipaw </char> liate a pookuh;</para>
  <para style="q2">zakawsangsakuh hae paw nynh</para>
  <para style="q2">thae hae sah lah, mih lungtua sah.</para>
  <para style="q1">
    <verse number="3" style="v" />Kamaw ryte <char style="nd">Bawipaw </char> kha</para>
  <para style="q2">thehoysah oh sih lah,</para>
  <para style="q1">a min kha pynkheihlan</para>
  <para style="q2">hangthung oh sih.</para>
  <para style="q1">
    <verse number="4" style="v" />
    <char style="nd">Bawipaw </char> kha ka ccung zah</para>
  <para style="q2">yn leihru,</para>
  <para style="q2">ka rinaw balyn kyate yn luesah.</para>
  <para style="q1">
    <verse number="5" style="v" />Amaw kha do oh lah,</para>
  <para style="q2">awnaw na mue cih oh;</para>
  <para style="q2">maethyanaw kharouh na mue lan khyh oh.</para>
  <para style="q1">
    <verse number="6" style="v" />E anyaapaw ccungccaw nynh</para>
  <para style="q2">a siapaw roi kha <char style="nd">Bawipaw </char> nynh</para>
  <para style="q1">thaepah zah,</para>
  <para style="q2">vawsawnaw miakaw kyate a khum.</para>
  <para style="q1">
    <verse number="7" style="v" />
    <char style="nd">Bawipaw </char> raw a rih hae paw</para>
  <para style="q2">mih pepan khe a vaaw ccungccapaw nynh</para>
  <para style="q1">po voilu lan umnua hae zah</para>
  <para style="q2">minmin kha a luesah hae.</para>
  <para style="q1">
    <verse number="8" style="v" />
    <char style="nd">Bawipaw </char> a hoynaw kha</para>
  <para style="q2">taangtua oh lah, nytua oh;</para>
  <para style="q1">amaw kya a rekuh hae paw tuh</para>
  <para style="q2">lungtuapaw nynh thua hae.<note caller="-" style="x"><char style="xo" closed="false">34.8: </char><char style="xt" closed="false"><ref loc="1PE 2:3">1Pe 2.3</ref></char></note></para>
  <para style="q1">
    <verse number="9" style="v" />Pou a mithyaa hae nanning,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha rih oh,</para>
  <para style="q1">pawccecize amaw a rih hae paw tuh</para>
  <para style="q2">hobounaw hoi khyh hae.</para>
  <para style="q1">
    <verse number="10" style="v" />Chindeih ano hae paw tuh</para>
  <para style="q2">hobounaw hoi hae zah mih vuelaw,</para>
  <para style="q1">thuasalama <char style="nd">Bawipaw </char> a ccung hae paw tuh</para>
  <para style="q2">uccaw hoypaw pawpaw mah</para>
  <para style="q1">hobou khyh hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Pou imua hae, rang oh lah,</para>
  <para style="q2">ka bya hynh ngaetua oh;</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> rawrinaw kha</para>
  <para style="q2">kae ccangpah cih oh.</para>
  <para style="q1">
    <verse number="12" style="v" />Hummou hiinnaw kha ry zah,</para>
  <para style="q2">hiinhoyte she saenaw kha a duaa?<note caller="-" style="x"><char style="xo" closed="false">34.12-16: </char><char style="xt" closed="false"><ref loc="1PE 3:10-12">1Pe 3.10-12</ref></char></note></para>
  <para style="q1">
    <verse number="13" style="v" />Na lae kha hoyleinaw kyate</para>
  <para style="q2">la sungkuh lah,</para>
  <para style="q1">na mung kha hynbya honaw kyate</para>
  <para style="q2">la sungkuh.</para>
  <para style="q1">
    <verse number="14" style="v" />Hoyleinaw kha cciataw lah,</para>
  <para style="q2">hoynaw kha raetua;</para>
  <para style="q1">daenaw kha ccung lah, deehui tua.</para>
  <para style="q1">
    <verse number="15" style="v" />
    <char style="nd">Bawipaw </char> nynh miding hae kha</para>
  <para style="q2">do-oih hae zah,</para>
  <para style="q2">a siaruanaw hae kha a ngaepya hae.</para>
  <para style="q1">
    <verse number="16" style="v" />
    <char style="nd">Bawipaw </char> nynh hoyleinaw</para>
  <para style="q2">a raetu hae kha rawse hae zah,</para>
  <para style="q1">minmin liathuinaw kha laephi kyate</para>
  <para style="q2">zosah khylan a maemih hae.</para>
  <para style="q1">
    <verse number="17" style="v" />Miding hae nynh bawmnaw</para>
  <para style="q2">mue khylan a sia hae ze,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh thaepah hae zah,</para>
  <para style="q2">mih vawsawnaw balyn kyate</para>
  <para style="q2">a luesah hae.</para>
  <para style="q1">
    <verse number="18" style="v" />
    <char style="nd">Bawipaw </char> tuh thinlung</para>
  <para style="q2">a koipaw kalan naekuh zah,</para>
  <para style="q1">ngaehoinaw a hoi lei hae paw kha</para>
  <para style="q2">a khum hae.</para>
  <para style="q1">
    <verse number="19" style="v" />Miding tuh vawsawnaw</para>
  <para style="q2">patae a teing,</para>
  <para style="q1">thuasalama <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">khah-e vawsawnaw balyn kyate a luesah.</para>
  <para style="q1">
    <verse number="20" style="v" />
    <char style="nd">Bawipaw </char> nynh a ru balyn kha a do-oih;</para>
  <para style="q2">a ru ccangkheit sanmah khya lan khyh.<note caller="-" style="x"><char style="xo" closed="false">34.20: </char><char style="xt" closed="false"><ref loc="JHN 19:36">Joh 19.36</ref></char></note></para>
  <para style="q1">
    <verse number="21" style="v" />Hoyleinaw nynh ccungccaw hoyleipaw hanlan</para>
  <para style="q2">chinaw kha a thuakhaepya,</para>
  <para style="q1">miding kha a huapaw ccungccaw tuh</para>
  <para style="q2">detahnaw a mue cih.</para>
  <para style="q1">
    <verse number="22" style="v" />
    <char style="nd">Bawipaw </char> nynh a ryalahtu hae</para>
  <para style="q2">hiinnaw kha a shawkhaw hae;</para>
  <para style="q1">amaw kya a rekuhpaw tuh</para>
  <para style="q2">seibenaw mue lan khyh.</para>
  <chapter number="35" style="c" />
  <para style="s1">Luenaw hanlan Sawsangnaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, kae yn rawse hae paw kha rawse hae;</para>
  <para style="q2">kae kha rawsete rhaw yn tuk hae paw kha tuktua hae!</para>
  <para style="q1">
    <verse number="2" style="v" />Khawriaphua te rhawtuknawpaw</para>
  <para style="q2">zunghe kha lawkuh lah,</para>
  <para style="q2">kae kha bawm khylan thoku tua!</para>
  <para style="q1">
    <verse number="3" style="v" />Kae yn deehui hae paw kha rawsete</para>
  <para style="q2">ccoi kha thuaanuakuh hae.</para>
  <para style="q1">“Kae tuh nang ae khumtu nynh ka thua,”</para>
  <para style="q2">cite ka muisaw kha hopya tua.</para>
  <para style="q1">
    <verse number="4" style="v" />Ka hiinnaw yn hawkuh hae paw tuh</para>
  <para style="q2">maethyanaw te thethyanaw mue hae sah.</para>
  <para style="q1">Ka tungvaw hoyleinaw</para>
  <para style="q2">yn paccynnuakuh hae paw tuh</para>
  <para style="q2">mih lungmua sah lah, ki hae sah.</para>
  <para style="q1">
    <verse number="5" style="v" />
    <char style="nd">Bawipaw </char> vaaw ccungccapaw nynh</para>
  <para style="q2">minmin kha dee hae sah,</para>
  <para style="q1">khisan nynh a mung hae paw</para>
  <para style="q2">vaekang hawte thua hae sah.</para>
  <para style="q1">
    <verse number="6" style="v" />
    <char style="nd">Bawipaw </char> vaaw ccungccapaw nynh</para>
  <para style="q2">minmin kha dee hae sah,</para>
  <para style="q1">mih laanpi tuh moh sah lah,</para>
  <para style="q2">nawpalaepaw laanpi lang tang sah.</para>
  <para style="q1">
    <verse number="7" style="v" />Pawccecize akonglang um leite</para>
  <para style="q2">kaang yn syakhaw hae zah,</para>
  <para style="q1">akonglang um leite</para>
  <para style="q2">ka hiinnaw chia khylan</para>
  <para style="q1">akhupaw hunghua kha</para>
  <para style="q2">yn thaekhaw hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Ronaw nynh minmin kha</para>
  <para style="q2">tualeipite thuanua hae sah.</para>
  <para style="q1">Te mimaw nynh a sya hae paw</para>
  <para style="q2">kaang kyakhe kae hae sah;</para>
  <para style="q1">mimaw ronaw hunghu</para>
  <para style="q2">a lungkhu lang ccah hae sah.</para>
  <para style="q1">
    <verse number="9" style="v" />Tetuh ka muisaw tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kya a lungtua cih,</para>
  <para style="q2">yn luesah keiccuze ka lungpaw cih.</para>
  <para style="q1">
    <verse number="10" style="v" />Ka ru ka khua hae balyn nynh,</para>
  <para style="q2">“Pou <char style="nd">Bawipaw </char>, nang ae lopaw hummou a um?</para>
  <para style="q1">Anyaa hae paw kha athung hae paw kyate</para>
  <para style="q2">na luesah hae,</para>
  <para style="q1">ryachi hae te anyaa hae paw kha</para>
  <para style="q2">luade a mang hae paw kyate</para>
  <para style="q1">na luesah hae,” cite a ho cih hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Ahme leipaw ccaekia hae nynh</para>
  <para style="q2">yn thokuh hae zah,</para>
  <para style="q1">ka ny leipaw uccaw kong kha</para>
  <para style="q2">yn khia hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Minmin nynh ahoypaw kha</para>
  <para style="q2">athahpaw te yn liaru hae zah,</para>
  <para style="q2">ka lung phe thang.</para>
  <para style="q1">
    <verse number="13" style="v" />Thuasalama minmin tuh</para>
  <para style="q2">a cci vae hae ze,</para>
  <para style="q1">ngaethyanaw buriboei ka lawkuh zah,</para>
  <para style="q2">kamaw te kamaw taeekute</para>
  <para style="q2">looh-ae ka sung.</para>
  <para style="q1">Ka by vawlan ka lu bakhungte</para>
  <para style="q2">saw ka sang,</para>
  <para style="q1">
    <verse number="14" style="v" />ka ban hae te ka uno hae hanlan</para>
  <para style="q2">ka ngaethya hawte ka ngae athah;</para>
  <para style="q1">lukhakheit nynh a nung elang</para>
  <para style="q2">a raw a khui hawte,</para>
  <para style="q2">ka bakhung zah rawkhuite ka um.</para>
  <para style="q1">
    <verse number="15" style="v" />Thuasalama kae nynh he ka khuliakuh tuh,</para>
  <para style="q2">lungpawte a sueluakuh hae,</para>
  <para style="q2">kae kha rawsete a sueluakuh hae;</para>
  <para style="q1">ka ny lei hae paw a puatho hae paw nynh</para>
  <para style="q2">kae kha umtaw leite yn zia hae;</para>
  <para style="q1">
    <verse number="16" style="v" />kae kha houhouh yn sarya hae zah,</para>
  <para style="q2">mih haw kha yn zynua hae.</para>
  <para style="q1">
    <verse number="17" style="v" />Pou <char style="nd">Bawipaw </char>, hohseciamou</para>
  <para style="q2">phang nae do ung cih?</para>
  <para style="q1">Minmin nynh rokunaw kyate</para>
  <para style="q2">yn luesah lah,</para>
  <para style="q1">ka hiinnaw kha chindeih hae kyate</para>
  <para style="q2">yn luesah!</para>
  <para style="q1">
    <verse number="18" style="v" />Tetuh a pumkuh hae paw</para>
  <para style="q2">pataepi kyakhe kae thehoysah cih;</para>
  <para style="q1">ccungccaw pataepi kyakhe</para>
  <para style="q2">kae thehoysah cih.</para>
  <para style="q1">
    <verse number="19" style="v" />Ahynhupaw ka rhaw hae tuh</para>
  <para style="q2">ka tungvaw mih lungtua nan sah,</para>
  <para style="q1">kae yn hua hae paw tuh</para>
  <para style="q2">akonglang um leite</para>
  <para style="q2">mih mit masipakuh nan hae sah.<note caller="-" style="x"><char style="xo" closed="false">35.19: </char><char style="xt" closed="false"><ref loc="PSA 69:4">Sam 69.4</ref>; <ref loc="JHN 15:25">Joh 15.25</ref></char></note></para>
  <para style="q1">
    <verse number="20" style="v" />Pawccecize daenaw byaho leite,</para>
  <para style="q2">ram lungkhu kya daebabi lan</para>
  <para style="q1">um hae paw kha rawsete</para>
  <para style="q2">hynhupaw bya kha ho lan</para>
  <para style="q2">a paccynku hae.</para>
  <para style="q1">
    <verse number="21" style="v" />Mih khalang kha yn awnua hae zah,</para>
  <para style="q2">“Alei, Alei, na cyipaw kha</para>
  <para style="q2">kae mit te phe kae muih vae,” a ci hae.</para>
  <para style="q1">
    <verse number="22" style="v" />Pou <char style="nd">Bawipaw </char>, phe na muih vae,</para>
  <para style="q2">daebabi lan um nan!</para>
  <para style="q2">Pou <char style="nd">Bawipaw </char>, ka kyate beih sawkuh nan!</para>
  <para style="q1">
    <verse number="23" style="v" />Thotua! Kae hynh thungkhaw khylan</para>
  <para style="q2">namaw te namaw lungthosaku tua,</para>
  <para style="q1">ka Pachia te ka <char style="nd">Bawipaw </char>,</para>
  <para style="q2">ka hanlan yn cyipya tua!</para>
  <para style="q1">
    <verse number="24" style="v" />Pou <char style="nd">Bawipaw </char> ka Pachia,</para>
  <para style="q2">nang tuh adingpaw na thua thyhawte,</para>
  <para style="q1">seinaw a hoi leipaw nynh thua cite</para>
  <para style="q2">bya beih yn piatua,</para>
  <para style="q1">minmin tuh ka tungvaw</para>
  <para style="q2">mih lungtua nan sah.</para>
  <para style="q1">
    <verse number="25" style="v" />Mimaw te mimaw kha,</para>
  <para style="q2">“Alei, kae lungry phe ccing vae,”</para>
  <para style="q2">cite hokuh nan hae sah.</para>
  <para style="q1">Minmin nynh, “Nang kha</para>
  <para style="q2">phe kae laang vae,” cite</para>
  <para style="q1">ho nan hae sah.</para>
  <para style="q1">
    <verse number="26" style="v" />Hoyleinaw ka tung lyaze</para>
  <para style="q2">mih lungtuapaw balyn tuh</para>
  <para style="q1">maethyanaw mue hae sah lah,</para>
  <para style="q2">mih lungmua sah;</para>
  <para style="q1">kae kha rawsete mimaw te mimaw</para>
  <para style="q2">a hangsakuh hae paw tuh</para>
  <para style="q1">maethyanaw te thethyanaw kha</para>
  <para style="q2">mue hae sah.</para>
  <para style="q1">
    <verse number="27" style="v" />Seinaw ka hoi leinaw kha</para>
  <para style="q2">a ry hae paw tuh</para>
  <para style="q1">lungtuate sia hae sah lah,</para>
  <para style="q2">mih lungpaw sah,</para>
  <para style="q1">“A ryalahtu hae hoynaw kha</para>
  <para style="q2">a lungrythuapaw</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> tuh alesae,”</para>
  <para style="q2">cite palei ho hae sah.</para>
  <para style="q1">
    <verse number="28" style="v" />Oute ka munglae nynh</para>
  <para style="q2">na dingnaw kha a ho cih zah,</para>
  <para style="q1">anin ninlang kae thehoysah cih.</para>
  <chapter number="36" style="c" />
  <para style="s1">Ccungccaw Seinaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Seinaw nynh ccungccaw hoyleipaw</para>
  <para style="q2">a thinlung kyakhe bya a hopya;</para>
  <para style="q1">a mit kya Pachia rawrinaw</para>
  <para style="q2">um khyh.<note caller="-" style="x"><char style="xo" closed="false">36.1: </char><char style="xt" closed="false"><ref loc="ROM 3:18">Rom 3.18</ref></char></note></para>
  <para style="q1">
    <verse number="2" style="v" />Pachia nynh a hoyleinaw kha</para>
  <para style="q2">muih khyh zah hua khyh cite</para>
  <para style="q1">tuakuh zah,</para>
  <para style="q2">amaw te amaw kha a pooku.</para>
  <para style="q1">
    <verse number="3" style="v" />A khalang kya-e bya tuh ahoy leipaw</para>
  <para style="q2">te lingpaw bya nynh thua;</para>
  <para style="q1">hawrarih lante um khyh zah,</para>
  <para style="q2">hoynaw kha rae khyh.</para>
  <para style="q1">
    <verse number="4" style="v" />A ikhung vawlan a i lyakhe</para>
  <para style="q2">ahoy leipaw kha a tua;</para>
  <para style="q1">ahoy leipaw laanpi kha zui zah,</para>
  <para style="q2">hoyleinaw kha vua khyh.</para>
  <para style="q1">
    <verse number="5" style="v" />Pou <char style="nd">Bawipaw </char>, atynpaw</para>
  <para style="q2">na sungsahnaw tuh vaawlui</para>
  <para style="q1">phe phah zah, na lungzinaw tuh</para>
  <para style="q2">maeking kya phe aphah.</para>
  <para style="q1">
    <verse number="6" style="v" />Na dingnaw tuh mua pipi te lokuh zah,</para>
  <para style="q2">na byapianaw tuh akhupaw</para>
  <para style="q1">rili te nynh aloku;</para>
  <para style="q2">Pou <char style="nd">Bawipaw </char>, ccungccaw te</para>
  <para style="q2">sarangpaw kha phe lokuh lante</para>
  <para style="q2">na khum hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Pou Pachia, atynpaw na sungsahnaw tuh</para>
  <para style="q2">pawcih baban aphute!</para>
  <para style="q1">Ccungccaw balyn tuh</para>
  <para style="q2">na sake mynlyh kyakhe a rekuh cih hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Na inn kya-e myarya lungpaw</para>
  <para style="q2">looh kha ae hae zah,</para>
  <para style="q1">na lungrythuanaw vawkhu e</para>
  <para style="q2">tui kha nia lan na pya hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Pawccecize namaw kya</para>
  <para style="q2">hiinnaw tuidy a um;</para>
  <para style="q1">na awnaw kyakhe awnaw kha</para>
  <para style="q2">kae muih.</para>
  <para style="q1">
    <verse number="10" style="v" />Nang ae nyh hae paw kya</para>
  <para style="q2">atynpaw na sungsahnaw tuh</para>
  <para style="q1">zungzae tynsah tua lah,</para>
  <para style="q2">thinlung ading hae paw kya</para>
  <para style="q2">na khumnaw tuh zungzae tynsah tua!</para>
  <para style="q1">
    <verse number="11" style="v" />A lysakuh hae paw ccu nynh</para>
  <para style="q2">yn syde nan sah,</para>
  <para style="q1">ccungccaw hoylei hae paw nynh</para>
  <para style="q2">yn dee nan hae sah.</para>
  <para style="q1">
    <verse number="12" style="v" />Ccungccaw hoylei hae paw tuh</para>
  <para style="q2">tuin kya maw a khuliakuh hae;</para>
  <para style="q1">khuliasaku athua hae keiccuze,</para>
  <para style="q2">thokuh kho vae khyh hae.</para>
  <chapter number="37" style="c" />
  <para style="s1">David nynh A Doliakunaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Ccungccaw hoyleipaw keiccuze</para>
  <para style="q2">na thinphang nan sah;</para>
  <para style="q1">hoyleinaw a raetu hae tungvaw</para>
  <para style="q2">na eiung nan sah,</para>
  <para style="q1">
    <verse number="2" style="v" />pawccecize aro mawze lonua hawte</para>
  <para style="q2">a zo cih hae zah,</para>
  <para style="q1">ahinpaw aku anaan hawte</para>
  <para style="q2">anaan cih hae.</para>
  <para style="q1">
    <verse number="3" style="v" />
    <char style="nd">Bawipaw </char> kha doliakuh lah,</para>
  <para style="q2">hoynaw kha raetua;</para>
  <para style="q1">tetuh ram lungkhu kya na um cih zah,</para>
  <para style="q2">khyndadyh lan na lungtua cih.</para>
  <para style="q1">
    <verse number="4" style="v" />
    <char style="nd">Bawipaw </char> kya na lungryccing sah,</para>
  <para style="q2">na thinlung nynh a rypaw kha ae pya cih.</para>
  <para style="q1">
    <verse number="5" style="v" />Na hiinnaw kha <char style="nd">Bawipaw </char> kalan aptua,</para>
  <para style="q2">amaw kha doliakuh lah, ae cyipah cih.</para>
  <para style="q1">
    <verse number="6" style="v" />Na dingnaw kha awnaw hawte</para>
  <para style="q2">a awsah cih zah,</para>
  <para style="q1">ahmete na cyipaw kha</para>
  <para style="q2">ninthu hawte a awsah cih.</para>
  <para style="q1">
    <verse number="7" style="v" />
    <char style="nd">Bawipaw </char> malang daebabi lan um lah,</para>
  <para style="q2">amaw kha lungsaete ngawtua;</para>
  <para style="q1">mih hiinnaw kya mih laan mih sui</para>
  <para style="q2">ua hae paw, ahoy leipaw</para>
  <para style="q1">paccynnaw rya a lah hae paw keiccuze</para>
  <para style="q2">na thinphang nan sah.</para>
  <para style="q1">
    <verse number="8" style="v" />Thinrianaw kha sungkuh lah,</para>
  <para style="q2">thin-unaw kha vuatua.</para>
  <para style="q1">Thinphangte um nan, tuh-e nynh</para>
  <para style="q2">hoyleinaw kyalya kha a thuakhae.</para>
  <para style="q1">
    <verse number="9" style="v" />Ccungccaw hoylei hae paw kha</para>
  <para style="q2">vua athua cih hae,</para>
  <para style="q1">thuasalama <char style="nd">Bawipaw </char></para>
  <para style="q2">a ngaehoikuh hae paw tuh</para>
  <para style="q1">ram kha rho lang a ccou cih hae.</para>
  <para style="q1">
    <verse number="10" style="v" />Sosoh kyakhe, ccungccaw hoylei hae paw tuh</para>
  <para style="q2">um vae lan khyh hae;</para>
  <para style="q1">mih umnaw kha hoyte na do zemah,</para>
  <para style="q2">tuin kya na muih vae lan khyh hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Thuasalama thinlung ane hae paw tuh</para>
  <para style="q2">ram kha rho lang a ccou cih hae zah,</para>
  <para style="q1">myarya lepaw daenaw kyakhe</para>
  <para style="q2">mih lungry accing cih.<note caller="-" style="x"><char style="xo" closed="false">37.11: </char><char style="xt" closed="false"><ref loc="MAT 5:5">Mat 5.5</ref></char></note></para>
  <para style="q1">
    <verse number="12" style="v" />Ccungccaw hoyleipaw nynh</para>
  <para style="q2">midingpaw kha rawsete khuakhankuh zah,</para>
  <para style="q2">a haw kha a zynua;</para>
  <para style="q1">
    <verse number="13" style="v" />thuasalama <char style="nd">Bawipaw </char> nynh tuh</para>
  <para style="q2">ccungccaw hoylei hae paw kha a nuinse hae,</para>
  <para style="q1">pawccecize mih ccyh</para>
  <para style="q2">yn thua lanpaw kha a ny.</para>
  <para style="q1">
    <verse number="14" style="v" />Ccungccaw hoylei hae paw nynh ryachi hae te</para>
  <para style="q2">minyaa hae kha khulia khylan te,</para>
  <para style="q1">kyhrarih lan a hiin hae paw kha chia khylan,</para>
  <para style="q2">thaloi kha thuaakuh hae zah,</para>
  <para style="q2">mih li kha a sue hae;</para>
  <para style="q1">
    <verse number="15" style="v" />mih thaloi nynh mimaw bung kha</para>
  <para style="q2">a thuing cih zah,</para>
  <para style="q1">mih li hae kha khyapya athua cih.</para>
  <para style="q1">
    <verse number="16" style="v" />Miding nynh a hoipaw beihtaraw tuh</para>
  <para style="q2">ccungccaw hoyleipaw nynh</para>
  <para style="q2">a hoipaw patae laeze ahoyhua.</para>
  <para style="q1">
    <verse number="17" style="v" />Pawccecize ccungccaw hoyleipaw</para>
  <para style="q2">kuih tuh khya athua cih,</para>
  <para style="q1">thuasalama <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">midingpaw kha a thungkhaw cih.</para>
  <para style="q1">
    <verse number="18" style="v" />
    <char style="nd">Bawipaw </char> nynh ccaenaw</para>
  <para style="q2">um lei hae paw ccyh kha</para>
  <para style="q2">nyh zah, mih rho tuh zungzae atyn cih;</para>
  <para style="q1">
    <verse number="19" style="v" />ccyh hoyleipaw kya</para>
  <para style="q2">maethyanaw mue khyh hae,</para>
  <para style="q1">ccakan acci lya ae lanpaw kha</para>
  <para style="q2">alaelui lan a hoi hae.</para>
  <para style="q1">
    <verse number="20" style="v" />Thuasalama ccungccaw hoylei</para>
  <para style="q2">hae paw tuh a roh cih hae,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> rhaw hae tuh ramkaw e</para>
  <para style="q2">lonua phu-enaw te nynh aloku hae,</para>
  <para style="q1">maeekhuh hawte azo cih hae.</para>
  <para style="q1">
    <verse number="21" style="v" />Ccungccaw hoyleipaw nynh tuh</para>
  <para style="q2">laebah kha lah zah sangru khyh,</para>
  <para style="q1">thuasalama miding hae tuh</para>
  <para style="q2">hysahnaw hoi hae zah, leih a pya hae;</para>
  <para style="q1">
    <verse number="22" style="v" />
    <char style="nd">Bawipaw </char> hythuanaw</para>
  <para style="q2">a ccou hae paw nynh</para>
  <para style="q1">ram kha rho lang a ccou cih hae,</para>
  <para style="q2">thuasalama amaw nynh</para>
  <para style="q1">thya a law hae paw tuh vua athua cih hae.</para>
  <para style="q1">
    <verse number="23" style="v" />Ccungccaw nynh a ccianawpaw laanpi kha</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh a lungrythua ze,</para>
  <para style="q2">a laanpi kha a tynsah pya;</para>
  <para style="q1">
    <verse number="24" style="v" />a thyku zemah khuliakuh lan khyh,</para>
  <para style="q2">pawccecize <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">a kuih kha phang a kyng.</para>
  <para style="q1">
    <verse number="25" style="v" />Atu tuh ka taw vae zah ka no vae khyh,</para>
  <para style="q2">tuhzemah miding kha</para>
  <para style="q1">vua athuapaw ka muih boi khyh,</para>
  <para style="q2">a ccaaw hae nynh looh</para>
  <para style="q1">a ngiaku hae paw kha mah</para>
  <para style="q2">ka muih boi khyh.</para>
  <para style="q1">
    <verse number="26" style="v" />Aning nynh lung-uate</para>
  <para style="q2">leih pya zungzae hae zah,</para>
  <para style="q2">a koiisaku zungzae hae,</para>
  <para style="q1">te a ccaaw hae tuh hythuanaw</para>
  <para style="q2">a ccou hae paw lang a tang hae.</para>
  <para style="q1">
    <verse number="27" style="v" />Hoyleinaw kha cciataw lah,</para>
  <para style="q2">hoynaw kha raetua;</para>
  <para style="q2">tetuh zungzae na um vae cih.</para>
  <para style="q1">
    <verse number="28" style="v" />Pawccecize <char style="nd">Bawipaw </char> nynh byading kha a ry;</para>
  <para style="q2">alungzipaw a mithyaa hae kha</para>
  <para style="q1">vua lan khyh hae.</para>
  <para style="q1">Miding hae tuh zungzae khynsah athua cih hae,</para>
  <para style="q2">thuasalama ccungccaw hoyleipaw</para>
  <para style="q2">a ccaaw hae kha tuh vua athua cih hae.</para>
  <para style="q1">
    <verse number="29" style="v" />Miding hae nynh ram kha rho lang</para>
  <para style="q2">a ccou cih hae zah,</para>
  <para style="q1">tuin kya zungzae a um cih hae.</para>
  <para style="q1">
    <verse number="30" style="v" />Miding hae khalang nynh</para>
  <para style="q2">hawnaw bya kha ho zah,</para>
  <para style="q2">mih lae nynh byading kha a ho.</para>
  <para style="q1">
    <verse number="31" style="v" />Mih Pachia kawbya tuh</para>
  <para style="q2">mih thinlung kya a um;</para>
  <para style="q1">mih laanpi tuh naw khyh.</para>
  <para style="q1">
    <verse number="32" style="v" />Ccungccaw hoyleipaw nynh</para>
  <para style="q2">midingpaw kha buhkhaw zah,</para>
  <para style="q2">chia lan a ccung.</para>
  <para style="q1">
    <verse number="33" style="v" />Thuasalama <char style="nd">Bawipaw </char> nynh midingpaw kha</para>
  <para style="q2">ccungccaw hoyleipaw</para>
  <para style="q1">kuih kalan vua lan khyh,</para>
  <para style="q2">byapia lan a cciakhae hae ze,</para>
  <para style="q1">seibenaw ing lan khyh.</para>
  <para style="q1">
    <verse number="34" style="v" />
    <char style="nd">Bawipaw </char> kha ngaehoikuh lah,</para>
  <para style="q2">a laanpi kha zuitua,</para>
  <para style="q1">ram kha rho lang ccou khylan</para>
  <para style="q2">ae hangthung cih;</para>
  <para style="q1">ccungccaw hoylei hae paw tuh</para>
  <para style="q2">ro athua hae paw kha na muih cih.</para>
  <para style="q1">
    <verse number="35" style="v" />A rysawthahpaw ccungccaw hoyleipaw kha</para>
  <para style="q2">ka muih vae, aning tuh Lebanon e</para>
  <para style="q1">sidar thingku hawte</para>
  <para style="q2">ming hae laeze a hangsakuh hua.</para>
  <para style="q1">
    <verse number="36" style="v" />Nyalang a pepan</para>
  <para style="q2">bua ka cceih tuh, um vae khyh;</para>
  <para style="q1">ka ccung zahmah ka muih kho vae khyh.</para>
  <para style="q1">
    <verse number="37" style="v" />Ccaenaw um leipaw ccungccaw kha</para>
  <para style="q2">syntawnaw rae lah,</para>
  <para style="q2">midingpaw kha dotua,</para>
  <para style="q1">pawccecize daebabipaw ccungccaw tuh</para>
  <para style="q2">ccaawno a hoi.</para>
  <para style="q1">
    <verse number="38" style="v" />Thuasalama misei hae tuh</para>
  <para style="q2">khaleih ro athua cih hae;</para>
  <para style="q1">ccungccaw hoylei hae paw</para>
  <para style="q2">mih ccaawno hae tuh vua athua cih hae.</para>
  <para style="q1">
    <verse number="39" style="v" />Miding hae kya-e khumnaw tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kyate nynh yn thua;</para>
  <para style="q1">aning tuh vawsaw ccyh lya</para>
  <para style="q2">mih khynnaw nynh thua.</para>
  <para style="q1">
    <verse number="40" style="v" />
    <char style="nd">Bawipaw </char> nynh minmin kha</para>
  <para style="q2">bawm hae zah, a luesah hae;</para>
  <para style="q1">amaw kya a reku hae keiccuze,</para>
  <para style="q2">ccungccaw hoylei hae paw kyate</para>
  <para style="q1">luesah hae zah, a khum hae.</para>
  <chapter number="38" style="c" />
  <para style="s1">Vawsaw Tungpaw elang Sawsangnaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, thinriate</para>
  <para style="q2">yn pe nan,</para>
  <para style="q2">thin-ute yn thuihei nan.</para>
  <para style="q1">
    <verse number="2" style="v" />Pawccecize na the hae nynh</para>
  <para style="q2">ka lungkhu lang yn thuing zah,</para>
  <para style="q1">ka tungvaw na kuih nae sawnua vae.</para>
  <para style="q1">
    <verse number="3" style="v" />Na thinria keiccuze</para>
  <para style="q2">ka pyn kya dannaw um khyh;</para>
  <para style="q1">ka seinaw keiccuze</para>
  <para style="q2">ka ru kya dannaw um khyh.</para>
  <para style="q1">
    <verse number="4" style="v" />Ka seinaw nynh ka lu yn vu vae;</para>
  <para style="q2">tuh-e tuh phupaw ripaw hawte</para>
  <para style="q1">ka hanlan myaryamaw ari.</para>
  <para style="q1">
    <verse number="5" style="v" />Ka ngaeenaw keiccuze</para>
  <para style="q2">ka vaemaw tuh ccihthung zah</para>
  <para style="q2">anae akhua;</para>
  <para style="q1">
    <verse number="6" style="v" />baruh ka bakhung zah</para>
  <para style="q2">phe ka dawleihkuh;</para>
  <para style="q2">anin ninlang rawkhuite ka khiakuh.</para>
  <para style="q1">
    <verse number="7" style="v" />Ka tae tuh sozazaepaw vaemaw te</para>
  <para style="q2">phe bia keiccuze,</para>
  <para style="q2">ka pyn kya dannaw um khyh.</para>
  <para style="q1">
    <verse number="8" style="v" />Ka thawthang zah, phe ka kinkuh;</para>
  <para style="q2">ka lungriathae keiccuze</para>
  <para style="q1">ka hawkhaekuh.</para>
  <para style="q1">
    <verse number="9" style="v" />Pou <char style="nd">Bawipaw </char>, ka rypaw balyn tuh</para>
  <para style="q2">marya na ny;</para>
  <para style="q1">ka hawkhaekupaw roi tuh</para>
  <para style="q2">na kyate thuruh kho thua khyh.</para>
  <para style="q1">
    <verse number="10" style="v" />Ka bung tuh thyngkuh zah</para>
  <para style="q2">ka thawthang;</para>
  <para style="q2">ka mit tuh ngawmuih vae khyh.</para>
  <para style="q1">
    <verse number="11" style="v" />Ka ruiban hae te kae ccawkuh hae paw nynh</para>
  <para style="q2">ka vaemaw keiccuze yn sibia hae zah,</para>
  <para style="q1">ka innpaw hae nynh mah</para>
  <para style="q2">yn naekuh vae khyh hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Ka hiinnaw yn hawkuh hae paw nynh</para>
  <para style="q2">kaang yn syakhaw hae;</para>
  <para style="q1">Vawsawnaw pya yn ry hae paw nynh</para>
  <para style="q2">kae kha ro lanpaw byaho hae zah,</para>
  <para style="q1">anin ninlang ling lanpaw kha</para>
  <para style="q2">a paccyn hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Thuasalama kae tuh</para>
  <para style="q2">a nawpanpaw hawte</para>
  <para style="q1">ka thua zah, ka thae khyh;</para>
  <para style="q2">bya a ho kho leipaw hawte nynh ka thua.</para>
  <para style="q1">
    <verse number="14" style="v" />Naw a thae leipaw hawte</para>
  <para style="q2">ka thua ccaccing zah,</para>
  <para style="q2">bya a khung kho leipaw hawte nynh ka thua.</para>
  <para style="q1">
    <verse number="15" style="v" />Thuasalama, pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">nang kha kae ngaehoiku;</para>
  <para style="q1">Pou <char style="nd">Bawipaw </char> ka Pachia,</para>
  <para style="q2">nang tuh bya yn leihru cih paw nynh na thua.</para>
  <para style="q1">
    <verse number="16" style="v" />“Minmin tuh ka tungvaw</para>
  <para style="q2">mih lungtua nan sah,</para>
  <para style="q1">ka ccu a thei lyakhe kae kha</para>
  <para style="q2">rawsete yn poonuakuh nan hae sah,”</para>
  <para style="q1">cite saw ka sang.</para>
  <para style="q1">
    <verse number="17" style="v" />Pawccecize vyavya ka khuliakuh zah,</para>
  <para style="q2">ka ngesaw ccinaw tuh</para>
  <para style="q2">ka kya phang a um.</para>
  <para style="q1">
    <verse number="18" style="v" />Ka seinaw kha ka phyku;</para>
  <para style="q2">ka seinaw keiccuze ka ngaethah.</para>
  <para style="q1">
    <verse number="19" style="v" />Ka rhaw hae tuh akonglang</para>
  <para style="q2">um leite mih thawsae,</para>
  <para style="q1">asuilan um leite yn huapaw</para>
  <para style="q2">patae a um hae.</para>
  <para style="q1">
    <verse number="20" style="v" />Ahoypaw kha ka zui keiccuze</para>
  <para style="q2">hoynaw kha hoyleinaw te</para>
  <para style="q1">yn liaru hae paw tuh</para>
  <para style="q2">ka rhaw hae nynh thua hae.</para>
  <para style="q1">
    <verse number="21" style="v" />Pou <char style="nd">Bawipaw </char>, beih yn vua nan;</para>
  <para style="q2">Pou ka Pachia, kae te beih sawkuh nan;</para>
  <para style="q1">
    <verse number="22" style="v" />Yn khumtupaw, pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">rangsakute beih yn bawmtua.</para>
  <chapter number="39" style="c" />
  <para style="s1">Hawnaw hanlan Sawsangnaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />“Ka munglae te ka sei khyh nawlan</para>
  <para style="q2">ka cyisahnaw kha ka raeringkuh cih;</para>
  <para style="q1">ka umnaw kya ccungccaw hoyleipaw</para>
  <para style="q2">a um lungkhu tuh</para>
  <para style="q1">byaho leite ka khalang</para>
  <para style="q2">ka myh cih,” ka ci.</para>
  <para style="q1">
    <verse number="2" style="v" />Yccae leite zya ka dae;</para>
  <para style="q2">ahoypaw kong heize ka ho khyh;</para>
  <para style="q1">ka lungriathaenaw tuh houhouh alethung,</para>
  <para style="q2">
    <verse number="3" style="v" />ka lungkhu kya ka lungvawsaw.</para>
  <para style="q1">Ka tua cciamang lyakhe</para>
  <para style="q2">ka lungvawsawnaw tuh</para>
  <para style="q1">maee lang arua;</para>
  <para style="q2">tetuh ka munglae te,</para>
  <para style="q1">
    <verse number="4" style="v" />“<char style="nd">Bawipaw </char>, ka hiin ccyh athangnaw te</para>
  <para style="q2">ka hiinnaw ccyh kha beih yn nysah tua;</para>
  <para style="q1">ka hiinnaw hynh hohcihmou</para>
  <para style="q2">adyn cipaw beih yn nysah,” cite ka ho.</para>
  <para style="q1">
    <verse number="5" style="v" />Ka hiinnaw hynh zapae kyalya</para>
  <para style="q2">asae lante nae rae zah,</para>
  <para style="q1">ka hiinshe hynh na muihnaw kya</para>
  <para style="q2">accakaepaw hawte nynh thua.</para>
  <para style="q1">Thanccingte, ccungccaw miakaw hynh</para>
  <para style="q2">vaekheit hysuepaw</para>
  <para style="q2">khivae hawte nynh thua.</para>
  <para style="q1">
    <verse number="6" style="v" />Thanccingte, ccungccaw miakaw hynh</para>
  <para style="q2">mynlyh hawte nynh</para>
  <para style="q1">a ccia bungthung hae.</para>
  <para style="q2">Thanccingte, accakaepaw elang</para>
  <para style="q1">rya a suhsaku hae; sisua kha</para>
  <para style="q2">ccakhung hae zah, hum nynh</para>
  <para style="q1">a ccou cih cipaw nyh khyh hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Tuhte athua keiccuze, pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">kae nynh pawmou ka ngaehoi?</para>
  <para style="q1">Ka ngaehoinaw tuh</para>
  <para style="q2">namaw kya rou nynh a um.</para>
  <para style="q1">
    <verse number="8" style="v" />Ka cyiseimenaw balyn kyate yn luesah.</para>
  <para style="q2">Mingaee hae nynh</para>
  <para style="q1">a theihrya hae paw lang</para>
  <para style="q2">yn tangsah nan.</para>
  <para style="q1">
    <verse number="9" style="v" />Hynh-e a cyihtupaw hynh</para>
  <para style="q2">namaw na thua keiccuze,</para>
  <para style="q1">yccae leite zya ka um;</para>
  <para style="q2">bya kaw kheit san ka ho khyh.</para>
  <para style="q1">
    <verse number="10" style="v" />Yn zia yn bua nan; na kuihlung te</para>
  <para style="q2">nae thung keiccuze ka thawthang vae.</para>
  <para style="q1">
    <verse number="11" style="v" />Ccungccaw kha a seinaw keiccuze</para>
  <para style="q2">detahnaw te na thuihei,</para>
  <para style="q1">minmin nynh a ry hae paw kha</para>
  <para style="q2">laehaw hawte na ropya hae;</para>
  <para style="q1">thanccingte, ccungccaw miakaw tuh</para>
  <para style="q2">vaekheit hysuepaw</para>
  <para style="q1">khivae sasaw nynh thua hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Pou <char style="nd">Bawipaw </char>, ka sawsangnaw</para>
  <para style="q2">yn thaepah lah,</para>
  <para style="q1">ka siaruanaw yn ngaepya tua;</para>
  <para style="q2">ka mitphi lua lya daebabi lan</para>
  <para style="q1">yn umtaw nan.</para>
  <para style="q2">Ka minpaaw hae balyn hawte,</para>
  <para style="q1">kae tuh a cceih bungthungpaw</para>
  <para style="q2">na mikhia nynh ka thua.</para>
  <para style="q1">
    <verse number="13" style="v" />Ka chih zah ka zo maw hin,</para>
  <para style="q2">lungtuanaw bua ka mue nawlan,</para>
  <para style="q1">na mae kha ccanglang yn hawitaw tua.</para>
  <chapter number="40" style="c" />
  <para style="s1">Luenaw keiccuze Thehoysahnaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> kha lungsaete ka ngaw;</para>
  <para style="q2">yn ngaepah zah ka siapaw kha</para>
  <para style="q2">yn thaepya.</para>
  <para style="q1">
    <verse number="2" style="v" />Ri lan umpaw akhupaw lungkhu te thuasah,</para>
  <para style="q2">tuiccua lungkhu te thuasah</para>
  <para style="q2">kae kha poh yn thuaa,</para>
  <para style="q1">ka ccu kha lungpi vawlan khe</para>
  <para style="q2">yn khang zah,</para>
  <para style="q2">ka ccianaw kha yn khynsahpya.</para>
  <para style="q1">
    <verse number="3" style="v" />Ah Pachia thehoysahnaw hlaw,</para>
  <para style="q2">hlaw thawpaw kha yn sahsah.</para>
  <para style="q1">Ccungccaw patae nynh muihte</para>
  <para style="q2">a rih cih hae zah,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha a doliakuh cih hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Lysakunaw kalan maeleihkuh khyh zah,</para>
  <para style="q2">ahme leipaw pachia kalan cciasei leite,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha a doliakuhpaw tuh</para>
  <para style="q2">lungtuapaw nynh thua.</para>
  <para style="q1">
    <verse number="5" style="v" />Pou <char style="nd">Bawipaw </char> ka Pachia,</para>
  <para style="q2">kaening hanlan ngaeang lan umpaw</para>
  <para style="q1">na ryalaw hae te</para>
  <para style="q2">na khuakhannaw hae tuh</para>
  <para style="q1">myarya alung vae;</para>
  <para style="q2">nang te khinkhia lanpaw</para>
  <para style="q1">hum sanmah um khyh.</para>
  <para style="q2">tuh-e balyn tuh ka ho ka ria lanze,</para>
  <para style="q1">hotae riatae um lan khyh.</para>
  <para style="q1">
    <verse number="6" style="v" />Silawnaw te silawnaw uccaw kha</para>
  <para style="q2">na rypaw thua khyh,</para>
  <para style="q2">ka nakaring kha nae uasah vae.</para>
  <para style="q1">Maee-ute silawnaw te seishawnaw</para>
  <para style="q2">silawnaw kha nae ngiapaw thua khyh.<note caller="-" style="x"><char style="xo" closed="false">40.6-8: </char><char style="xt" closed="false"><ref loc="HEB 10:5-7">Heb 10.5-7</ref></char></note></para>
  <para style="q1">
    <verse number="7" style="v" />Tetuh kae nynh, “E kya mang ka um;</para>
  <para style="q2">ccauh akuekuhpaw kya ka hanlan</para>
  <para style="q2">na zeipaw mang a um.</para>
  <para style="q1">
    <verse number="8" style="v" />Pou ka Pachia, na rynaw rae tuh</para>
  <para style="q2">ka lungrythuakhaekuh;</para>
  <para style="q1">na ccangpyanaw tuh ka thinlung kya</para>
  <para style="q2">a um,” cite kae khung.</para>
  <para style="q1">
    <verse number="9" style="v" />Zapi pumkunaw kyakhe</para>
  <para style="q2">nae luesahnaw thehoypaw kha</para>
  <para style="q2">ka ho vae;</para>
  <para style="q1">Pou <char style="nd">Bawipaw </char>, tuh-e hopaw tuh</para>
  <para style="q2">ka umtaw lan khyh cipaw na ny.</para>
  <para style="q1">
    <verse number="10" style="v" />Nae khum zah nae bawmnaw kha</para>
  <para style="q2">ka thinlung kya ka thuruh khyh,</para>
  <para style="q1">Na lungzinaw te na khumnaw kha</para>
  <para style="q2">ka ho vae;</para>
  <para style="q1">atynpaw na sungsahnaw te</para>
  <para style="q2">na lungzinaw kha</para>
  <para style="q1">zapi pumkunaw kya ka phei khyh.</para>
  <para style="q1">
    <verse number="11" style="v" />Pou <char style="nd">Bawipaw </char>, na thawccinaw kha</para>
  <para style="q2">yn kang nan;</para>
  <para style="q1">atynpaw na sungsahnaw te</para>
  <para style="q2">na lungzinaw nynh</para>
  <para style="q1">zungzae yn khynsah sah.</para>
  <para style="s1">Bawmnaw Mue khylan Sawsang</para>
  <para style="r">(<ref loc="PSA 70">Sam 70</ref>)</para>
  <para style="q1">
    <verse number="12" style="v" />Pawccecize riatae um leipaw</para>
  <para style="q2">hoyleinaw nynh phang yn koihlu;</para>
  <para style="q1">ngaw ka muih kho lei lan ciate</para>
  <para style="q2">ka seinaw nynh phe yn phya vae;</para>
  <para style="q1">ka sangrua laeze lung zah,</para>
  <para style="q2">ka lungthaw phe azya.</para>
  <para style="q1">
    <verse number="13" style="v" />Pou <char style="nd">Bawipaw </char>, kae kha</para>
  <para style="q2">beih yn luesah rytua;</para>
  <para style="q1">Pou <char style="nd">Bawipaw </char>, arangte</para>
  <para style="q2">beih yn bawmtua.</para>
  <para style="q1">
    <verse number="14" style="v" />Kae kha chia lan</para>
  <para style="q2">yn paccynnuakuh hae paw balyn tuh</para>
  <para style="q1">maethyanaw mue hae sah lah,</para>
  <para style="q2">mih lungmua sah.</para>
  <para style="q1">vawsaw yn tungsah ry hae paw tuh</para>
  <para style="q2">mih nulang maekuh hae sah lah,</para>
  <para style="q2">thethyanaw mue hae sah.</para>
  <para style="q1">
    <verse number="15" style="v" />“Alei, Alei!” cite yn sarya hae paw tuh</para>
  <para style="q2">mih maethya keiccuze siikuh hae sah.</para>
  <para style="q1">
    <verse number="16" style="v" />Thuasalama nang ae</para>
  <para style="q2">ccung hae paw balyn tuh</para>
  <para style="q1">namaw kya mih lungtua sah lah,</para>
  <para style="q2">mih lungpaw sah.</para>
  <para style="q1">Na khumnaw a ry hae paw nynh,</para>
  <para style="q2">“<char style="nd">Bawipaw </char> tuh alesae!”</para>
  <para style="q2">cite palei ho hae sah.</para>
  <para style="q1">
    <verse number="17" style="v" />Kae tuh a ryachipaw te</para>
  <para style="q2">anyaapaw nynh ka thua,</para>
  <para style="q1">thuasalama Bawipaw nynh</para>
  <para style="q2">yn ning khyh.</para>
  <para style="q1">Nang tuh yn bawmtu te</para>
  <para style="q2">yn luesahtu nynh na thua,</para>
  <para style="q1">Pou ka Pachia, na thysung nan sah.</para>
  <chapter number="41" style="c" />
  <para style="s1">Dan khylan Ngianaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Ryachi hae hanlan a tua a roihpaw tuh</para>
  <para style="q2">lungtuapaw nynh thua,</para>
  <para style="q1">a vawsaw ccyh lya</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh a luesah cih.</para>
  <para style="q1">
    <verse number="2" style="v" />
    <char style="nd">Bawipaw </char> nynh a thungkhaw cih zah,</para>
  <para style="q2">a hiinnaw kha a khynsah cih;</para>
  <para style="q1">ram lungkhu kya lungtuate a umsah cih.</para>
  <para style="q2">Aning kha a rhaw hae rynaw kalan</para>
  <para style="q2">na ap lan khyh.</para>
  <para style="q1">
    <verse number="3" style="v" />Dan khyh zah a hueku lyakhe</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh a bawm cih;</para>
  <para style="q2">a ccinaw kyate bua a dansah cih.</para>
  <para style="q1">
    <verse number="4" style="v" />Kae nynh, “Pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">na tungvaw ka sei vae keiccuze</para>
  <para style="q2">thaw beih yn ccih lah, yn dansah,” ka ci.</para>
  <para style="q1">
    <verse number="5" style="v" />“Hohtuh vema a chih cih zah</para>
  <para style="q2">a min azo cih?” cite</para>
  <para style="q1">ka rhaw hae nynh mih eiung zah</para>
  <para style="q2">a hoku hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Kae kha muih khylan he yn ccia hae ze,</para>
  <para style="q2">accakaepaw bya kha ho hae zah,</para>
  <para style="q1">mih thinlung kya hoyleinaw kha</para>
  <para style="q2">a ccakhungku hae;</para>
  <para style="q1">he a pou hae te, tuh-e tuh teitei kya</para>
  <para style="q2">balyn a ho hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Kae yn hua hae paw balyn nynh</para>
  <para style="q2">ka konglang byaru a hoku hae;</para>
  <para style="q1">ka hanlan ahoy leipaw kha</para>
  <para style="q2">a paccyn hae.</para>
  <para style="q1">
    <verse number="8" style="v" />A chisah khopaw uccaw tuh</para>
  <para style="q2">a tungvaw phang bekuh vae zah,</para>
  <para style="q1">a huekunaw kyate bua thokuh vae lan</para>
  <para style="q2">khyh cite a tua hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Ka doliakupaw, ka looh a aepaw</para>
  <para style="q2">ka ban hoypaw nynh heize,</para>
  <para style="q2">kae kha rawsete a ccu yn hangnua vae.<note caller="-" style="x"><char style="xo" closed="false">41.9: </char><char style="xt" closed="false"><ref loc="MAT 26:23">Mat 26.23</ref>; <ref loc="MRK 14:18">Mar 14.18</ref>; <ref loc="LUK 22:21">Luk 22.21</ref>; <ref loc="JHN 13:18">Joh 13.18</ref></char></note></para>
  <para style="q1">
    <verse number="10" style="v" />Pou <char style="nd">Bawipaw </char>, minmin kha</para>
  <para style="q2">ka liaru kho nawlan hae,</para>
  <para style="q2">thaw yn ccih lah, yn thosahku tua.</para>
  <para style="q1">
    <verse number="11" style="v" />Tuhcite ka rhaw nynh</para>
  <para style="q2">yn tae khyh keiccuze,</para>
  <para style="q2">ka tungvaw na lungrythua cipaw ka ny.</para>
  <para style="q1">
    <verse number="12" style="v" />Ka ccingnaw keiccuze nae bawm zah,</para>
  <para style="q2">na kya zungzae nae umsah vae.</para>
  <para style="q1">
    <verse number="13" style="v" />
    <char style="nd">Bawipaw </char>, Israel Pachia kha</para>
  <para style="q2">zungzae te zungzae cia</para>
  <para style="q2">thehoysah oh sih. Amen, Amen.<note caller="-" style="x"><char style="xo" closed="false">41.13: </char><char style="xt" closed="false"><ref loc="PSA 106:48">Sam 106.48</ref></char></note></para>
  <chapter number="42" style="c" />
  <para style="ms">UK 2</para>
  <para style="mr">(<ref loc="PSA 42-72">Sam 42—72</ref>)</para>
  <para style="s1">Vawsaw Ccyh lya Sawsangnaw<note caller="+" style="f"><char style="fr" closed="false">42 Abyalu: </char><char style="ft" closed="false">Korah phin hae kya-e byarui.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Sazuh nynh vadungtui kha</para>
  <para style="q2">a ngae hawte,</para>
  <para style="q1">Pou Pachia, ka muisaw nynh</para>
  <para style="q2">nang kha ae ngae.</para>
  <para style="q1">
    <verse number="2" style="v" />Ka muisaw nynh Pachia,</para>
  <para style="q2">ahiinpaw Pachia kha</para>
  <para style="q1">tuihaw lan a haw.</para>
  <para style="q2">Hohtuhmou Pachia kalan</para>
  <para style="q2">ka cceih cih zah,</para>
  <para style="q1">a mae kha ka muih cih?</para>
  <para style="q1">
    <verse number="3" style="v" />Ccungccaw hae nynh, “Na Pachia tuh</para>
  <para style="q2">teimou um?” cite</para>
  <para style="q1">palei yn ci lya hae khe,</para>
  <para style="q2">khuazi khuadae ka mitphi tuh</para>
  <para style="q2">ka looh nynh thua vae.</para>
  <para style="q1">
    <verse number="4" style="v" />E uccaw hae hynh ka liathui,</para>
  <para style="q2">ka thinlung akoi:</para>
  <para style="q1">pawccecize ccungccaw patae ryte</para>
  <para style="q2">kae cceih zah,</para>
  <para style="q1">lungtuanaw roisawte,</para>
  <para style="q2">thehoysahnaw hlawsah biate,</para>
  <para style="q1">beiknaw poitua hae paw zapi hae kha</para>
  <para style="q2">Pachia inn lang ka cciakhae hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Pou ka muisaw, pawcce na ngaethya?</para>
  <para style="q2">Pawcce ka lungkhu kya</para>
  <para style="q1">na lungriathae?</para>
  <para style="q2">Pachia kha ngaehoikuh;</para>
  <para style="q1">yn bawmtu te ka Pachia kha</para>
  <para style="q2">bua ka thehoysah cih.</para>
  <para style="q1">
    <verse number="6" style="v" />Ka muisaw tuh ka lungkhu kya</para>
  <para style="q2">a ngaethah;</para>
  <para style="q1">tukeiccuze Jordan vahue te</para>
  <para style="q2">Hermon mua kyate thuasah,</para>
  <para style="q1">Mizar Mua kyate thuasah</para>
  <para style="q2">nang kha kae liathui.</para>
  <para style="q1">
    <verse number="7" style="v" />Na ngatoh hae roi accaepaw kyakhe,</para>
  <para style="q2">tui akhupaw nynh ccangpaw tui</para>
  <para style="q2">akhupaw kha a ko;</para>
  <para style="q1">na tuileih hae balyn nynh</para>
  <para style="q2">kae kha yn vu vae hae.</para>
  <para style="q1">
    <verse number="8" style="v" />
    <char style="nd">Bawipaw </char> nynh khuadae kya</para>
  <para style="q2">atynpaw a sungsahnaw kha yn pya,</para>
  <para style="q1">khuazi kya a hlaw kha ka sah zah,</para>
  <para style="q2">ka hiinnaw a Pachia kalan khe</para>
  <para style="q1">saw ka sang.</para>
  <para style="q1">
    <verse number="9" style="v" />Pachia, ka lungpi kalan khe,</para>
  <para style="q2">“Pawcce phe nae ning vae?</para>
  <para style="q1">Rhaw nynh yn tuaa yn sah keiccuze</para>
  <para style="q2">pawccemou rawkhuite</para>
  <para style="q2">palei ka um cih?” cite ka ci.</para>
  <para style="q1">
    <verse number="10" style="v" />Ka rhaw hae nynh, “Na Pachia tuh</para>
  <para style="q2">teimou um?” cite palei yn ci hae zah,</para>
  <para style="q1">ka pyn kya a chisah khopaw</para>
  <para style="q2">vaemaw hawte yn sarya hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Pou ka muisaw, pawcce na ngaethya?</para>
  <para style="q2">Pawcce ka lungkhu kya</para>
  <para style="q1">na lungriathae?</para>
  <para style="q2">Pachia kha ngaehoikuh;</para>
  <para style="q1">yn bawmtu te ka Pachia kha</para>
  <para style="q2">bua ka thehoysah cih.</para>
  <chapter number="43" style="c" />
  <para style="s1">Vawsaw Ccyh lya Sawsangnaw</para>
  <para style="r">(<ref loc="PSA 42">Sam 42</ref> piade)</para>
  <para style="q1">
    <verse number="1" style="v" />Pou Pachia, ka sei leinaw kha</para>
  <para style="q2">thaesah hae,</para>
  <para style="q1">Pachia nyh leipaw ccungccaw hae kyate</para>
  <para style="q2">yn thungkhaw; a hyn hae paw te</para>
  <para style="q1">ading lei hae paw kyate</para>
  <para style="q2">yn luesah tua!</para>
  <para style="q1">
    <verse number="2" style="v" />Nang tuh ka khynnaw</para>
  <para style="q2">Pachia nynh na thua;</para>
  <para style="q1">pawcce phe nae vua?</para>
  <para style="q2">Rhaw nynh yn tuaa yn sah keiccuze</para>
  <para style="q1">pawccemou rawkhuite</para>
  <para style="q2">palei ka um cih?</para>
  <para style="q1">
    <verse number="3" style="v" />Na awnaw te na byaccing kha</para>
  <para style="q2">saw hae lah,</para>
  <para style="q2">tuh-e hae nynh yn cciakhae hae sah;</para>
  <para style="q1">athyaapaw na mua te na umnaw kalan</para>
  <para style="q2">yn cciakhae hae sah.</para>
  <para style="q1">
    <verse number="4" style="v" />Tetuh Pachia silawhang kalan,</para>
  <para style="q2">myarya ka lung yn tuasahpaw</para>
  <para style="q2">Pachia kalan ka cceih cih;</para>
  <para style="q1">tintang te nang kha kae thehoysah cih,</para>
  <para style="q2">Pou Pachia, ka Pachia.</para>
  <para style="q1">
    <verse number="5" style="v" />Pou ka muisaw, pawcce na ngaethya?</para>
  <para style="q2">Pawcce ka lungkhu kya</para>
  <para style="q1">na lungriathae?</para>
  <para style="q2">Pachia kha ngaehoikuh;</para>
  <para style="q1">yn bawmtu te ka Pachia kha</para>
  <para style="q2">bua ka thehoysah cih.</para>
  <chapter number="44" style="c" />
  <para style="s1">Bawmnaw elang Sawsangnaw<note caller="+" style="f"><char style="fr" closed="false">44 Abyalu: </char><char style="ft" closed="false">Korah phin hae kya-e byarui.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Pou Pachia, langmawlya</para>
  <para style="q2">kae minpaaw hae she kya</para>
  <para style="q2">na la cyipaw kha</para>
  <para style="q1">minmin nynh yn hopah hae zah,</para>
  <para style="q2">kae nakaring te phe kae thae vae:</para>
  <para style="q1">
    <verse number="2" style="v" />minphuin hae kha na kuih te</para>
  <para style="q2">na dee hae zah,</para>
  <para style="q2">na ccungccaw hae kha na umsah hae;</para>
  <para style="q1">ccangpaw minphuin hae kha</para>
  <para style="q2">vawsaw na pya hae zah,</para>
  <para style="q2">na ccungccaw hae kha na luesah hae;</para>
  <para style="q1">
    <verse number="3" style="v" />mih thaloi liate ram kha tae khyh hae,</para>
  <para style="q2">mih kuih nynh taenaw pya khyh hae;</para>
  <para style="q1">mih tungvaw na lungrythua keiccuze,</para>
  <para style="q2">na ranglang kuih te na mitmae</para>
  <para style="q1">awnaw liate ram kha a tae hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Nang tuh ka Siapharan te</para>
  <para style="q2">ka Pachia nynh na thua;</para>
  <para style="q1">nang nynh Jakob phuin kha</para>
  <para style="q2">taenaw na pya.</para>
  <para style="q1">
    <verse number="5" style="v" />Namaw liate kae rhaw hae kha</para>
  <para style="q2">kae khulia hae;</para>
  <para style="q1">na min liate kae rhaw hae kha</para>
  <para style="q2">kae syde hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Ka li kha ka doliakuh khyh zah,</para>
  <para style="q2">ka thaloi nynh mah yn khum kho khyh.</para>
  <para style="q1">
    <verse number="7" style="v" />Thuasalama kae rhaw hae kyate</para>
  <para style="q2">nae khum vae zah,</para>
  <para style="q1">kaening oun hua hae paw kha</para>
  <para style="q2">mih mae na thyasah vae hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Kaening tuh Pachia kya</para>
  <para style="q2">palei kae pookuh zah,</para>
  <para style="q1">na min kha zungzae kae thehoysah cih.</para>
  <para style="q1">
    <verse number="9" style="v" />Thuasalama kaening kha</para>
  <para style="q2">phe nae vua vae zah,</para>
  <para style="q1">maethya nae law vae,</para>
  <para style="q2">kae rhawkaw hae kya</para>
  <para style="q2">na cceihbua vae khyh.</para>
  <para style="q1">
    <verse number="10" style="v" />Kaening kha rhaw hae malang khe</para>
  <para style="q2">nae ccuesah zah,</para>
  <para style="q1">kae rhaw hae nynh</para>
  <para style="q2">uccaw oun luade vae hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Kaening kha chia lanpaw tuu hawte</para>
  <para style="q2">nae nungde vae zah,</para>
  <para style="q1">minphuin ccangpaw hae laku kya</para>
  <para style="q2">phiariphiarae nae nung.</para>
  <para style="q1">
    <verse number="12" style="v" />Na ccungccaw hae kha</para>
  <para style="q2">amee beihtaraw lan nae zua zah,</para>
  <para style="q1">tuh-e amee tuhte amia na muelae khyh.</para>
  <para style="q1">
    <verse number="13" style="v" />Kaening kha kae innpaw hae nynh</para>
  <para style="q2">a sarya hae paw lang nae rae zah,</para>
  <para style="q1">kae pepan um hae paw nynh</para>
  <para style="q2">a theihrya hae paw te</para>
  <para style="q2">a nuinse hae paw lang nae rae.</para>
  <para style="q1">
    <verse number="14" style="v" />Minphuin hae laku kya</para>
  <para style="q2">theihryapaw minphuin lang</para>
  <para style="q1">nae rae zah,</para>
  <para style="q2">ccungccaw hae laku kya saryate</para>
  <para style="q2">nuinsepaw lang nae rae vae.</para>
  <para style="q1">
    <verse number="15-16" style="v" />Saryatu hae te thethyasahtu hae bya</para>
  <para style="q2">keiccu thuasah,</para>
  <para style="q2">rhaw te liarutu hae mitmae keiccu thuasah</para>
  <para style="q1">kae tuh thethyanaw palei ka mue zah,</para>
  <para style="q2">maethyanaw nynh ka mae phang yn bong.</para>
  <para style="q1">
    <verse number="17" style="v" />E hae balyn tuh kae tungvaw</para>
  <para style="q2">a thua ccaw zemah,</para>
  <para style="q1">kaening nynh nang kha kae ning khyh zah,</para>
  <para style="q2">na byakinnaw kha kae roh khyh.</para>
  <para style="q1">
    <verse number="18" style="v" />Kae thinlung tuh nulang sihkuh khyh,</para>
  <para style="q2">kae ccianaw tuh na laanpi kyate</para>
  <para style="q2">maekuh khyh,</para>
  <para style="q1">
    <verse number="19" style="v" />tuhzemah suizaw hae umnaw kyakhe</para>
  <para style="q2">kaening kha nae khya zah,</para>
  <para style="q1">marae zipaw mohnaw te</para>
  <para style="q2">phang nae bong.</para>
  <para style="q1">
    <verse number="20" style="v" />Kae Pachia min kha kae ning zah,</para>
  <para style="q2">ccangpaw pachia kalan khe</para>
  <para style="q2">kae kuih kae daw lanze,</para>
  <para style="q1">
    <verse number="21" style="v" />tuh-e tuh Pachia nynh</para>
  <para style="q2">langsakuh lan khyh tou?</para>
  <para style="q1">Pawccecize Pachia nynh thinlung kya</para>
  <para style="q2">thuruhpaw kha a ny.</para>
  <para style="q1">
    <verse number="22" style="v" />Nang keiccuze kaening tuh</para>
  <para style="q2">anin ninlang oun theih hae zah,</para>
  <para style="q1">chia lanpaw tuu lang nynh oun ria hae.<note caller="-" style="x"><char style="xo" closed="false">44.22: </char><char style="xt" closed="false"><ref loc="ROM 8:36">Rom 8.36</ref></char></note></para>
  <para style="q1">
    <verse number="23" style="v" />Pou <char style="nd">Bawipaw </char>, thoku tua!</para>
  <para style="q2">Pawcce na i?</para>
  <para style="q1">Thaekuh ccavae, kaening hynh</para>
  <para style="q2">zungzae yn vua nan!</para>
  <para style="q1">
    <verse number="24" style="v" />Pawcce na mae nae retawku?</para>
  <para style="q2">Kae teingnaw te oun tuaasahnaw hae hynh</para>
  <para style="q2">pawcce na ning?</para>
  <para style="q1">
    <verse number="25" style="v" />Laenoi te nae kalouh vae;</para>
  <para style="q2">kae pyn tuh laephi kya phang bekuh vae.</para>
  <para style="q1">
    <verse number="26" style="v" />Tho lah oun bawmtua.</para>
  <para style="q2">Atynpaw na sungsahnaw liate</para>
  <para style="q1">oun shawkhawtua.</para>
  <chapter number="45" style="c" />
  <para style="s1">Siapharan Zudynaw Hlaw<note caller="+" style="f"><char style="fr" closed="false">45 Abyalu: </char><char style="ft" closed="false">Korah phin hae kya-e byarui, sungsakunaw hlaw.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Ka thinlung tuh bya hoypaw te phe abeih,</para>
  <para style="q2">siapharan elang hlaw ka phua lyahin;</para>
  <para style="q1">ka lae tuh ccaw zeithyapaw</para>
  <para style="q2">bawpe te nynh aloku.</para>
  <para style="q1">
    <verse number="2" style="v" />Nang tuh pise hae lakuze</para>
  <para style="q2">pynrua apuithya</para>
  <para style="q2">huaccepaw nynh na thua;</para>
  <para style="q1">na munglae kya thawccinaw bya te</para>
  <para style="q2">phe abeih;</para>
  <para style="q1">tukeiccuze Pachia nynh nang kha</para>
  <para style="q2">zungzae hythua ae pya.</para>
  <para style="q1">
    <verse number="3" style="v" />Pou athungpaw siapharan,</para>
  <para style="q2">na phu-enaw te na lesaenaw</para>
  <para style="q1">na thaloi kha na phae kya saeku tua.</para>
  <para style="q1">
    <verse number="4" style="v" />Byaccing te dingnaw kha</para>
  <para style="q2">tynsah khylan</para>
  <para style="q1">na lesaenaw langsakute taenaw khate</para>
  <para style="q2">cciku tua.</para>
  <para style="q1">na ranglang kuih nynh ri lan umpaw</para>
  <para style="q2">ryalaw kha ae ccangpah sah.</para>
  <para style="q1">
    <verse number="5" style="v" />Na the tuh he zah,</para>
  <para style="q2">siapharan a rhaw hae bung kyacia</para>
  <para style="q1">a thuing hae;</para>
  <para style="q2">ccungccaw hae tuh na ccuphe kaw</para>
  <para style="q1">a khuliakuh hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Pou Pachia, na bawitungkhung tuh</para>
  <para style="q2">zungzae te zungzae cia atyn.</para>
  <para style="q1">Na ram kha dingnaw te na uk;<note caller="-" style="x"><char style="xo" closed="false">45.6-7: </char><char style="xt" closed="false"><ref loc="HEB 1:8-9">Heb 1.8-9</ref></char></note></para>
  <para style="q2">
    <verse number="7" style="v" />dingnaw kha na ry zah</para>
  <para style="q2">hoyleinaw kha na hua.</para>
  <para style="q1">Tukeiccuze na Pachia athuapaw Pachia nynh</para>
  <para style="q2">na ruiban hae laeze</para>
  <para style="q1">nang kha lungtuanaw chitui ae thuh vae;</para>
  <para style="q2">
    <verse number="8" style="v" />na angkiccuapaw tuh mura zimuin,</para>
  <para style="q1">aloes zimuin te kassia zimuin hae khate</para>
  <para style="q2">a myn akhuh.</para>
  <para style="q1">Saepaw nua te sakpaw siapharan inn hae kyate</para>
  <para style="q2">arui suikuhpaw khuakupaw uccaw hae nynh</para>
  <para style="q1">na lung ae pawsah hae;</para>
  <para style="q2">
    <verse number="9" style="v" />sawtua lan umpaw na nopi hae kyakhe</para>
  <para style="q1">siapharan ccanung hae mah a umbua hae;</para>
  <para style="q2">na ranglang khe Ofir sui hoypaw</para>
  <para style="q1">a lawkuhpaw siapharannung a thadyn.</para>
  <para style="q1">
    <verse number="10" style="v" />Pou ccanung, ngaetua, tuatua lah,</para>
  <para style="q2">na nakaring yn tuaku tua;</para>
  <para style="q1">na ccungccaw hae te</para>
  <para style="q2">na paaw inn kha ningtua,</para>
  <para style="q1">
    <verse number="11" style="v" />siapharan nynh na puithyanaw kha a ry cih.</para>
  <para style="q1">Aning tuh na bawipaw athua keiccuze</para>
  <para style="q2">amaw kha beiktua;</para>
  <para style="q1">
    <verse number="12" style="v" />Tair khua e ccungccaw hae nynh thuasah,</para>
  <para style="q2">a hoi huaccepaw ccungccaw hae nynh</para>
  <para style="q2">sisua aphuinphuin te thuasah,</para>
  <para style="q1">lasung khate namaw kya</para>
  <para style="q2">maehoynaw yn ccungkuh cih hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Siapharan ccanung tuh</para>
  <para style="q2">amaw khaan lungkhu khe</para>
  <para style="q1">sui law te kuakuhpaw boeining kha</para>
  <para style="q2">lawkute a um;</para>
  <para style="q1">
    <verse number="14" style="v" />myarya puithyapaw a boeining khate</para>
  <para style="q2">siapharan kalan a cciakhae hae;</para>
  <para style="q1">liaccady hae te a ruiban hae nynh</para>
  <para style="q2">a nulang te a zui hae.</para>
  <para style="q1">
    <verse number="15" style="v" />Lungtua lungpawte cciakhae hae zah,</para>
  <para style="q2">siapharan inn lang a tee hae.</para>
  <para style="q1">
    <verse number="16" style="v" />Pou siapharan, nang nynh</para>
  <para style="q2">na minpaaw hae ccelang,</para>
  <para style="q1">ccapaw hae kha na saah cih;</para>
  <para style="q2">minmin kha laephi pynpi kya</para>
  <para style="q2">uktu hae lang na tangsah cih hae.</para>
  <para style="q1">
    <verse number="17" style="v" />She takyh kya na min ka thaansah cih;</para>
  <para style="q2">tukeiccuze ccungccaw hae nynh</para>
  <para style="q1">zungzae te zungzae cia</para>
  <para style="q2">ae thehoysah cih hae.</para>
  <chapter number="46" style="c" />
  <para style="s1">Pachia Thungkhawnaw<note caller="+" style="f"><char style="fr" closed="false">46 Abyalu: </char><char style="ft" closed="false">Korah phin hae kya-e byarui.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Pachia tuh aening khynnaw te</para>
  <para style="q2">thawzung nynh thua,</para>
  <para style="q1">vawsaw ccyh lya zungzae</para>
  <para style="q2">oun bawmtu nynh thua.</para>
  <para style="q1">
    <verse number="2" style="v" />Tukeiccuze laephi tuh nuekuh zah,</para>
  <para style="q2">mua hae tuh hy hae zah</para>
  <para style="q1">rili lungkhu lang a ccaw hae zemah</para>
  <para style="q2">kae rih lan khyh;</para>
  <para style="q1">
    <verse number="3" style="v" />rili tuh tuileih thote aroi ccae zah</para>
  <para style="q2">a thyhleihku zemah,</para>
  <para style="q1">mua hae tuh a hy hae zemah,</para>
  <para style="q2">kae rih lan khyh.</para>
  <para style="q1">
    <verse number="4" style="v" />Ahang Huaccepaw kya-e</para>
  <para style="q2">athyaapaw umnaw,</para>
  <para style="q1">Pachia khualipi kha</para>
  <para style="q2">a lungtuasahpaw vawpi vakheit a um.</para>
  <para style="q1">
    <verse number="5" style="v" />Pachia tuh tuh-e khuapi lungkhu um zah,</para>
  <para style="q2">tuh-e tuh roh vae lan khyh;</para>
  <para style="q1">Pachia nynh tuh-e khuapi tuh</para>
  <para style="q2">awkhua takaw te a bawm cih.</para>
  <para style="q1">
    <verse number="6" style="v" />Minphuin hae tuh siarisiarae a um hae,</para>
  <para style="q2">peenaw hae tuh a hy hae;</para>
  <para style="q1">A roisaw zah laephi tuh</para>
  <para style="q2">tui lang a tang.</para>
  <para style="q1">
    <verse number="7" style="v" />Vaaw <char style="nd">Bawipaw </char> tuh</para>
  <para style="q2">aening kya a um;</para>
  <para style="q1">Jakob Pachia tuh</para>
  <para style="q2">aening khynnaw nynh thua.</para>
  <para style="q1">
    <verse number="8" style="v" />Rang oh, <char style="nd">Bawipaw </char> a ryalawnaw hynh</para>
  <para style="q2">dotua oh; laephi vawlan</para>
  <para style="q2">a thuakhaepaw ronaw hynh dotua oh.</para>
  <para style="q1">
    <verse number="9" style="v" />Laephi pynpi adianaw cia</para>
  <para style="q2">rhaw a daesah;</para>
  <para style="q1">li kha khya zah ccoi kha</para>
  <para style="q2">zoihtatyh lan a khya;</para>
  <para style="q2">khawriaphua hae kha maee te a u.</para>
  <para style="q1">
    <verse number="10" style="v" />“Zya dae oh, kae tuh Pachia nynh</para>
  <para style="q2">ka thua cipaw nyh oh!</para>
  <para style="q1">Minphuin hae kya kae tuh</para>
  <para style="q2">hangthung ka thua,</para>
  <para style="q2">laephi kya hangthung ka thua,” a ci.</para>
  <para style="q1">
    <verse number="11" style="v" />Vaaw <char style="nd">Bawipaw </char> tuh</para>
  <para style="q2">aening kya a um;</para>
  <para style="q1">Jakob Pachia tuh</para>
  <para style="q2">aening khynnaw nynh thua.</para>
  <chapter number="47" style="c" />
  <para style="s1">Minphuin hae tungvaw Pachia Uknaw<note caller="+" style="f"><char style="fr" closed="false">47 Abyalu: </char><char style="ft" closed="false">Korah phin hae hlaw.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Nanning, ccungccaw hae balyn,</para>
  <para style="q2">nae kuihbia oh;</para>
  <para style="q1">lungtuanaw hlaw te Pachia kalan</para>
  <para style="q2">accae lante sia oh.</para>
  <para style="q1">
    <verse number="2" style="v" />Pawccecize Ahang Huaccepaw</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> tuh ri lan umpaw,</para>
  <para style="q1">laephi pynpi a ukpaw,</para>
  <para style="q2">alesaepaw siapharan nynh thua.</para>
  <para style="q1">
    <verse number="3" style="v" />Ccungccaw hae kha</para>
  <para style="q2">aening zakaw nung hae zah,</para>
  <para style="q1">minphuin hae kha aening ccu kaw</para>
  <para style="q2">a nung hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Amaw nynh aening elang</para>
  <para style="q2">ah rho kha oun popya,</para>
  <para style="q1">tuh-e tuh a sungsahpaw Jakob</para>
  <para style="q2">a rykunawpaw nynh thua.</para>
  <para style="q1">
    <verse number="5" style="v" />Pachia tuh lungtua siaruanaw roi ryte a kae,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> tuh mungkae roi ryte a kae.</para>
  <para style="q1">
    <verse number="6" style="v" />Pachia kalan thehoysahnaw hlawsah oh,</para>
  <para style="q2">thehoysahnaw hlawsah oh;</para>
  <para style="q1">ah Siapharan kalan thehoysahnaw</para>
  <para style="q2">hlawsah oh, thehoysahnaw hlawsah oh.</para>
  <para style="q1">
    <verse number="7" style="v" />Pawccecize Pachia tuh laephi pynpi</para>
  <para style="q2">siapharan nynh thua;</para>
  <para style="q2">amaw kha hlaw te thehoysah oh.</para>
  <para style="q1">
    <verse number="8" style="v" />Pachia tuh minphuin hae</para>
  <para style="q2">a ukpaw siapharan nynh thua;</para>
  <para style="q1">Pachia tuh athyaapaw</para>
  <para style="q2">a bawitungkhung kya a haung.</para>
  <para style="q1">
    <verse number="9" style="v" />Minphuin hae kya-e uktu bawi hae tuh</para>
  <para style="q2">Abraham Pachia kya-e</para>
  <para style="q2">ccungccaw hae ryte a sueluakuh hae.</para>
  <para style="q1">Pawccecize laephi huhan tuh</para>
  <para style="q2">Pachia kya-e nynh thua;</para>
  <para style="q1">aning kha myarya ahang lante</para>
  <para style="q2">hangthung athua.</para>
  <chapter number="48" style="c" />
  <para style="s1">Zion Phu-enaw<note caller="+" style="f"><char style="fr" closed="false">48 Abyalu: </char><char style="ft" closed="false">Korah phin hae hlaw.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> tuh alesaepaw thua zah,</para>
  <para style="q2">ah Pachia khuapi kya,</para>
  <para style="q2">athyaapaw a mua vawlan khe</para>
  <para style="q1">alesae lante thehoysah lanpaw nynh thua.</para>
  <para style="q1">
    <verse number="2" style="v" />Hang zah apuithyapaw Zion Mua tuh,</para>
  <para style="q2">laephi pynpi lungtuanaw</para>
  <para style="q2">a pyapaw nynh thua,</para>
  <para style="q1">alesaepaw Siapharan khuapi tuh</para>
  <para style="q2">asawnaw thahlang nynh a um.<note caller="-" style="x"><char style="xo" closed="false">48.2: </char><char style="xt" closed="false"><ref loc="MAT 5:35">Mat 5.35</ref></char></note></para>
  <para style="q1">
    <verse number="3" style="v" />Tuh-e khuapi rhawlungrua</para>
  <para style="q2">a lungkhu kya tuh</para>
  <para style="q1">khynnaw a um cipaw kha</para>
  <para style="q2">Pachia nynh a langsaku vae.</para>
  <para style="q1">
    <verse number="4" style="v" />Tetuh siapharan hae tuh pumkuh hae zah,</para>
  <para style="q2">pynkheihlan oun cceih hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Zion Mua kha he a muih hae tuh</para>
  <para style="q2">myarya a rih hae;</para>
  <para style="q2">siikuh hae zah a ccue hae;</para>
  <para style="q1">
    <verse number="6" style="v" />minmin tuh tuin kya thyngkuh hae zah,</para>
  <para style="q2">neitangia a ccihpaw</para>
  <para style="q2">nopi hawte mih vawsaw,</para>
  <para style="q1">
    <verse number="7" style="v" />nithua lang e khisan nynh</para>
  <para style="q2">Tarshish sanphalung kha</para>
  <para style="q2">a ro lya hawte nynh athua hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Aening nynh ah thae vae oh hawte,</para>
  <para style="q2">vaaw <char style="nd">Bawipaw </char> khuapi kya,</para>
  <para style="q1">ah Pachia khuapi kya ah muih vae oh.</para>
  <para style="q2">Pachia nynh tuh-e khuapi tuh</para>
  <para style="q1">zungzae a tynsah cih.</para>
  <para style="q1">
    <verse number="9" style="v" />Pou Pachia, atynpaw na sungsahnaw kha</para>
  <para style="q2">na beikinn lungkhu khe kae tua.</para>
  <para style="q1">
    <verse number="10" style="v" />Pou Pachia, laephi adianaw cia</para>
  <para style="q2">ae thehoysah hae hawte,</para>
  <para style="q2">na min tuh athaan.</para>
  <para style="q1">Na ranglang kuih tuh taenaw te phe abeih.</para>
  <para style="q2">
    <verse number="11" style="v" />Bya na pianaw liate,</para>
  <para style="q1">Zion Mua tuh a lungtua sah lah,</para>
  <para style="q2">Judah ram e khua hae tuh</para>
  <para style="q1">mih lungtua sah.</para>
  <para style="q1">
    <verse number="12" style="v" />Zion khua kha voilute cceih oh lah,</para>
  <para style="q2">a rhawviainn hae kha riatua oh,</para>
  <para style="q1">
    <verse number="13" style="v" />rhawhohung hae kha</para>
  <para style="q2">hoyte dotua oh lah,</para>
  <para style="q2">rhawlungrua hae kha phe do mamia oh;</para>
  <para style="q1">tetuh she thawpaw kya-e</para>
  <para style="q2">ccungccaw hae kyakhe,</para>
  <para style="q1">
    <verse number="14" style="v" />“E Pachia tuh zungzae te zungzae cia</para>
  <para style="q2">ah Pachia nynh thua.</para>
  <para style="q1">Zungzae oun cciakhaepaw athua cih,”</para>
  <para style="q2">cite na hopah kho cih oh.</para>
  <chapter number="49" style="c" />
  <para style="s1">Hoirumnaw Doliaku tuh Ngaeenaw<note caller="+" style="f"><char style="fr" closed="false">49 Abyalu: </char><char style="ft" closed="false">Korah phin hae hlaw.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Nanning, ccungccaw hae balyn,</para>
  <para style="q2">e hynh thaetua oh,</para>
  <para style="q2">laephi kya a um hae paw balyn,</para>
  <para style="q1">
    <verse number="2" style="v" />a nepaw te a hangpaw parouhte,</para>
  <para style="q2">a hoirumpaw te a ryachipaw</para>
  <para style="q2">nae balyn te ngaetua oh.</para>
  <para style="q1">
    <verse number="3" style="v" />Ka khalang nynh hawnaw bya kha</para>
  <para style="q2">a ho cih;</para>
  <para style="q1">Ka thinlung tuh hawnaw te</para>
  <para style="q2">asekuhpaw kha nynh a tua.</para>
  <para style="q1">
    <verse number="4" style="v" />Ka nakaring kha phungtangbya kalan</para>
  <para style="q2">ka tuakuh cih;</para>
  <para style="q1">byakhupaw kha tintang khuakute</para>
  <para style="q2">ka ccaesah cih.</para>
  <para style="q1">
    <verse number="5-6" style="v" />Ccungccaw hoyleipaw ka rhaw hae,</para>
  <para style="q2">mih sisua doliakuh hae zah</para>
  <para style="q1">mih hoirumnaw patae khate</para>
  <para style="q2">a pookuh hae paw nynh</para>
  <para style="q1">yn koihlu hae zah ka vawsaw ccyh lyakhe</para>
  <para style="q2">pawcce ka rih cih?</para>
  <para style="q1">
    <verse number="7" style="v" />Thanccingte, ccungccaw lu kheit</para>
  <para style="q2">hiinnaw shawkhawnaw lanpaw</para>
  <para style="q1">pawpaw mah um khyh,</para>
  <para style="q2">hiinnaw hanlan Pachia kalan</para>
  <para style="q2">pya kho lanpaw amee um khyh.</para>
  <para style="q1">
    <verse number="8-9" style="v" />Pawccecize zungzae hiin nawlan te</para>
  <para style="q2">shawku kha kharouh muih khyh nawlan,</para>
  <para style="q1">hiinnaw shawkhawnawpaw tuh</para>
  <para style="q2">amee myarya ru zah zaw kho khyh.</para>
  <para style="q1">
    <verse number="10" style="v" />Mihawpaw tuh a chih;</para>
  <para style="q2">tuhawte mingaeepaw te</para>
  <para style="q1">tuanaw hoi leipaw mah chih hae zah,</para>
  <para style="q2">mih sisua hae tuh ming hae elang</para>
  <para style="q2">a cciatawpya hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Mih shawku tuh zungzaete</para>
  <para style="q2">mih inn nynh thua,</para>
  <para style="q1">loram hae kha mimaw min</para>
  <para style="q2">a la phu hae zemah,</para>
  <para style="q1">mih umnaw hmin hae tuh</para>
  <para style="q2">she takyh hanlan nynh thua.</para>
  <para style="q1">
    <verse number="12" style="v" />Ccungccaw tuh a lesaenaw kya</para>
  <para style="q2">tynkhaekuh khyh;</para>
  <para style="q1">a chihthyapaw sarangpaw te nynh a loku.</para>
  <para style="q1">
    <verse number="13" style="v" />Mimaw te mimaw a doliakuh hae paw,</para>
  <para style="q2">mih hoirumnaw te</para>
  <para style="q1">mih ngaengankhaekuh hae paw tuh</para>
  <para style="q2">mih tungvaw pawmou acyihkuh cih</para>
  <para style="q2">cipaw dotua oh.</para>
  <para style="q1">
    <verse number="14" style="v" />Minmin tuh tuu hae hawte</para>
  <para style="q2">michi khua hanlan</para>
  <para style="q2">nungdae athua hae paw nynh thua;</para>
  <para style="q1">Chinaw tuh mih tuurinpaw athua cih;</para>
  <para style="q2">shawku langkhe lawbabin lan</para>
  <para style="q2">rungbung hae zah,</para>
  <para style="q1">mih pyn tuh azo cih;</para>
  <para style="q2">Michi khua tuh mih inn athua cih.</para>
  <para style="q1">
    <verse number="15" style="v" />Thuasalama Pachia nynh kae kha</para>
  <para style="q2">yn ccou keiccuze</para>
  <para style="q1">ka muisaw kha Chinaw huhan kyate</para>
  <para style="q2">yn shawkhaw cih.</para>
  <para style="q1">
    <verse number="16" style="v" />Ccungccaw abang tuh</para>
  <para style="q2">oun hoirum hae zah,</para>
  <para style="q2">mih inn e sisua tuh</para>
  <para style="q1">he oun lungthung vae ze,</para>
  <para style="q2">na thinphang nan sah.</para>
  <para style="q1">
    <verse number="17" style="v" />Pawccecize he a chih hae te,</para>
  <para style="q2">pawpaw mah phukuh lan khyh hae;</para>
  <para style="q1">mih sisua tuh mih nulang</para>
  <para style="q2">zuikuh bua lan khyh.</para>
  <para style="q1">
    <verse number="18" style="v" />Mih hiin lungkhu khe</para>
  <para style="q2">mimaw te mimaw kha</para>
  <para style="q1">a lungtuapaw lang a riaku hae zemah,</para>
  <para style="q2">mimaw elang kou hoy lan</para>
  <para style="q2">rya a lawku hae ze mih thehoy zemah,</para>
  <para style="q1">
    <verse number="19" style="v" />awnaw a muihthui lei vae cih hae paw</para>
  <para style="q2">mih minpaaw hae phu kalan khe</para>
  <para style="q2">a cceihbua cih hae.</para>
  <para style="q1">
    <verse number="20" style="v" />Ccungccaw tuh a lesaenaw kya</para>
  <para style="q2">tynkhaekuh khyh;</para>
  <para style="q1">a chihthyapaw sarangpaw te nynh a loku.</para>
  <chapter number="50" style="c" />
  <para style="s1">Nawccaw lan umpaw Silawnaw</para>
  <para style="d">Asaf Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Alesaepaw <char style="nd">Bawipaw </char> Pachia nynh bya a ho,</para>
  <para style="q2">khuanin a thuanaw langte</para>
  <para style="q2">a ccawnaw lang cia laephi kha a ko.</para>
  <para style="q1">
    <verse number="2" style="v" />Puithyanaw phe accingnaw</para>
  <para style="q2">Zion mua kyate</para>
  <para style="q1">Pachia tuh khuanin hawte yn aw.</para>
  <para style="q1">
    <verse number="3" style="v" />Ah Pachia tuh yn cceih zah,</para>
  <para style="q2">daebabi lan um khyh,</para>
  <para style="q1">a malang khe arua cciamangpaw maee um zah,</para>
  <para style="q2">a pepan balyn khe a thawsaepaw khise atho.</para>
  <para style="q1">
    <verse number="4" style="v" />A ccungccaw hae kha byapia khylan</para>
  <para style="q2">ahangnaw vaaw te lae kha ko hae zah,</para>
  <para style="q1">
    <verse number="5" style="v" />“Silawnaw te kamaw ryte</para>
  <para style="q2">byakinnaw a rae hae paw,</para>
  <para style="q1">alungzipaw ka mithyaa hae,</para>
  <para style="q2">ka kalan oun sueluakuh oh!”</para>
  <para style="q2">a cipya hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Pachia amaw ccaccei hynh</para>
  <para style="q2">byapiatu athua keiccuze,</para>
  <para style="q1">vaawlui nynh a dingnaw kha a siakhae.</para>
  <para style="q1">
    <verse number="7" style="v" />“Pou ka ccungccaw hae,</para>
  <para style="q2">ngaetua oh, bya ka ho cih,</para>
  <para style="q1">Pou Israel, nang kha rawsete</para>
  <para style="q2">ccaekia ka khan cih.</para>
  <para style="q1">Kae tuh Pachia,</para>
  <para style="q2">na Pachia nynh ka thua.</para>
  <para style="q1">
    <verse number="8" style="v" />Ka malang si na law zungzaepaw</para>
  <para style="q2">maee-ute silawnaw te</para>
  <para style="q1">silawnaw aphuinphuin keiccu</para>
  <para style="q2">nang kha kae pe khyh.</para>
  <para style="q1">
    <verse number="9" style="v" />Na inn kya-e tangnuapaw thuasah,</para>
  <para style="q2">na miaa phu kya-e miaa hae thuasah</para>
  <para style="q2">ka ccou lan khyh.</para>
  <para style="q1">
    <verse number="10" style="v" />Pawccecize ramkaw e</para>
  <para style="q2">loramsaw miakaw te</para>
  <para style="q1">mua thong kheit vawlan umpaw</para>
  <para style="q2">sahiin hae tuh ka kya-e nynh thua.</para>
  <para style="q1">
    <verse number="11" style="v" />Vaawlang e pavaw hae balyn te</para>
  <para style="q2">ramkaw e apiathyapaw balyn tuh</para>
  <para style="q1">ka kya-e nynh thua.</para>
  <para style="q1">
    <verse number="12" style="v" />“Ka vuelaw ze, nang kha</para>
  <para style="q2">kae hopah lan khyh,</para>
  <para style="q1">pawccecize laephi te laephi kya</para>
  <para style="q2">umpaw balyn tuh ka kya-e nynh thua.</para>
  <para style="q1">
    <verse number="13" style="v" />Tangnuapaw saw kha ka ae tou?</para>
  <para style="q2">Miaa chii kha ka neih tou?</para>
  <para style="q1">
    <verse number="14" style="v" />Pachia kalan lungtua silawnaw kha</para>
  <para style="q2">rae oh lah,</para>
  <para style="q1">Ahang Huaccepaw kalan</para>
  <para style="q2">byakinnaw kha rae oh.</para>
  <para style="q1">
    <verse number="15" style="v" />Vawsaw ccyh lya kae kha oun ko oh;</para>
  <para style="q2">kae luesah cih oh zah,</para>
  <para style="q1">kae kha nae thehoysah cih oh,” a ci.</para>
  <para style="q1">
    <verse number="16" style="v" />Thuasalama Pachia nynh</para>
  <para style="q2">ccungccaw hoylei hae paw kha:</para>
  <para style="q1">“Pawcce ka phungbya hae kha</para>
  <para style="q2">nae khalang te na zaeku oh?</para>
  <para style="q1">Pawcce ka byakinnaw kha</para>
  <para style="q2">nae mung te na ho oh?</para>
  <para style="q1">
    <verse number="17" style="v" />Thuiheinaw kha na hua oh zah,</para>
  <para style="q2">ka bya kha nae nulang khe na vua oh.</para>
  <para style="q1">
    <verse number="18" style="v" />Miruh kha na muih oh ze,</para>
  <para style="q2">ruiban lang na raeku oh,</para>
  <para style="q1">milae zu milae vawpaw kha</para>
  <para style="q2">a seikhae hae paw ryte na mungku oh.</para>
  <para style="q1">
    <verse number="19" style="v" />“Nae khalang tuh hoyleinaw kha</para>
  <para style="q2">rythyte na hosah oh zah,</para>
  <para style="q2">nae lae nynh lingnaw bya kha a paccyn.</para>
  <para style="q1">
    <verse number="20" style="v" />Na haung oh zah nae uno hae</para>
  <para style="q2">rawsenaw bya kha na ho oh;</para>
  <para style="q1">nae nung a ccaaw kha</para>
  <para style="q2">a thethya na ho oh.</para>
  <para style="q1">
    <verse number="21" style="v" />E hae hynh na cyih oh zah,</para>
  <para style="q2">kae tuh daebabi lan ka um;</para>
  <para style="q1">tukeiccuze kae hynh</para>
  <para style="q2">naemaw tahawpaw lang nae ria oh.</para>
  <para style="q1">Thuasalama atu tuh kae pe vae cih oh zah,</para>
  <para style="q2">khah-e hae kha ccaerarih lan</para>
  <para style="q1">kae nysah vae cih oh.</para>
  <para style="q1">
    <verse number="22" style="v" />“Pachia a ning hae paw nanning,</para>
  <para style="q2">e hynh syntawkuh oh, tuhkhyhze tuh</para>
  <para style="q1">nanning kha zoihtatae lan</para>
  <para style="q2">kae pae cih oh zah,</para>
  <para style="q1">ae khum cih oh paw</para>
  <para style="q2">lu kheit san um lan khyh.</para>
  <para style="q1">
    <verse number="23" style="v" />Silawnaw raete ka kalan lungtuanaw</para>
  <para style="q2">a langsakuh hae paw tuh</para>
  <para style="q1">saw yn tua hae paw nynh thua;</para>
  <para style="q2">ahmepaw laanpi a zui hae paw kyakhe</para>
  <para style="q1">Pachia khumnaw kha</para>
  <para style="q2">ka langsakuh cih,” a ci.</para>
  <chapter number="51" style="c" />
  <para style="s1">
    <note caller="-" style="x">
      <char style="xo" closed="false">51 Abyalu: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 12:1-15">2Sa 12.1-15</ref>
      </char>
    </note> Seingaethyanaw hanlan Sawsangnaw<note caller="+" style="f"><char style="fr" closed="false">51 Abyalu: </char><char style="ft" closed="false">David nynh Bathsheba te sei hae zah Nathan nynh a pe koute a phuapaw hlaw.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Pou Pachia, atynpaw</para>
  <para style="q2">na sungsahnaw thyhte thaw yn ccitua;</para>
  <para style="q1">na thawccinaw alepaw liate</para>
  <para style="q2">ka cyiseimenaw kha</para>
  <para style="q2">yn thyaasahpya tua.</para>
  <para style="q1">
    <verse number="2" style="v" />Ka hoyleinaw kha marya yn singpah lah,</para>
  <para style="q2">ka seinaw kyate yn thyaasah tua.</para>
  <para style="q1">
    <verse number="3" style="v" />Pawccecize ka cyiseimenaw kha</para>
  <para style="q2">ka nyhkuh zah,</para>
  <para style="q2">ka seinaw tuh palei ka syntaw.</para>
  <para style="q1">
    <verse number="4" style="v" />Nang kha rawsete namaw kya</para>
  <para style="q2">ccaccei phe ka sei vae,</para>
  <para style="q1">na muihnaw kya hoyleinaw</para>
  <para style="q2">phe ka rae vae,</para>
  <para style="q1">tukeiccuze na byapaenaw tuh kyh zah,</para>
  <para style="q2">bya na pianaw kya ccaenaw um khyh.<note caller="-" style="x"><char style="xo" closed="false">51.4: </char><char style="xt" closed="false"><ref loc="ROM 3:4">Rom 3.4</ref></char></note></para>
  <para style="q1">
    <verse number="5" style="v" />Ka pui takaw mawte seinaw ka hoi,</para>
  <para style="q2">ka nung nynh yn poi lya mawte</para>
  <para style="q1">misei nynh ka thua.</para>
  <para style="q1">
    <verse number="6" style="v" />Adingpaw thinlung kha na ry,</para>
  <para style="q2">tukeiccuze ka thinlung kya</para>
  <para style="q2">hawnaw kha yn ccangpya tua.</para>
  <para style="q1">
    <verse number="7" style="v" />Hyssop khate yn thyaasah lah,</para>
  <para style="q2">ka thyaa cih;</para>
  <para style="q1">yn sing lah, vuiraw laeze</para>
  <para style="q2">ka rawhua cih.</para>
  <para style="q1">
    <verse number="8" style="v" />Lungtuanaw te lungpawnaw bya kha</para>
  <para style="q2">yn thaesah tua;</para>
  <para style="q1">tetuh nae khya vae paw ka ru hae tuh</para>
  <para style="q2">mih lungtua cih.</para>
  <para style="q1">
    <verse number="9" style="v" />Ka seinaw kyate na mae kha</para>
  <para style="q2">yn retawkuh lah,</para>
  <para style="q1">ka hoyleinaw balyn kha</para>
  <para style="q2">yn zosahpya tua.</para>
  <para style="q1">
    <verse number="10" style="v" />Pou Pachia, ka lungkhu kya</para>
  <para style="q2">athyaapaw thinlung kha raetua,</para>
  <para style="q1">athawpaw te akyhpaw tuanaw kha</para>
  <para style="q2">ka lungkhu kya yn sangtua.</para>
  <para style="q1">
    <verse number="11" style="v" />Na umnaw kyate yn dee nan lah,</para>
  <para style="q2">na thyaa muisaw kha</para>
  <para style="q2">ka kyate yn lawpah nan.</para>
  <para style="q1">
    <verse number="12" style="v" />Na khumnaw kyate yn thuapaw</para>
  <para style="q2">lungtuanaw kha bua yn pya lah,</para>
  <para style="q1">kawngaenaw thinlung kha yn hoisah.</para>
  <para style="q1">
    <verse number="13" style="v" />Tetuh na laanpi kha misei hae</para>
  <para style="q2">ka ccangpah cih hae zah,</para>
  <para style="q2">misei hae nynh na kalan yn ki cih hae.</para>
  <para style="q1">
    <verse number="14" style="v" />Pou Pachia, yn khumtu Pachia,</para>
  <para style="q2">ccungccaw chianaw kyate</para>
  <para style="q1">yn luesah lah,</para>
  <para style="q2">nae luesahnaw kha myarya ccae lante</para>
  <para style="q1">hlaw ka sah cih.</para>
  <para style="q1">
    <verse number="15" style="v" />Pou <char style="nd">Bawipaw </char>, ka munglae</para>
  <para style="q2">yn hungpah lah,</para>
  <para style="q1">ka khalang nynh na thehoynaw kha</para>
  <para style="q2">a siakhae cih.</para>
  <para style="q1">
    <verse number="16" style="v" />Silawnaw kha na lungrythua khyh;</para>
  <para style="q2">na lungry a la thua lanze,</para>
  <para style="q1">he kae pya cih paw,</para>
  <para style="q2">maee-ute silawnaw ka la rae lan zemah,</para>
  <para style="q2">na lungrythua lan khyh.</para>
  <para style="q1">
    <verse number="17" style="v" />Pachia nynh a rypaw silawnaw tuh</para>
  <para style="q2">akoipaw thinlung nynh thua;</para>
  <para style="q1">Pou Pachia, akoipaw te angaesikuhpaw</para>
  <para style="q2">thinlung kha na vua he khyh.</para>
  <para style="q1">
    <verse number="18" style="v" />Na thawccinaw liate Zion khe</para>
  <para style="q2">hoynaw raepya tua;</para>
  <para style="q2">Jerusalem khualungrua kha raethui tua,</para>
  <para style="q1">
    <verse number="19" style="v" />tetuh akyhpaw silawnaw,</para>
  <para style="q2">maee-ute silawnaw te</para>
  <para style="q1">apyn balyn maee-ute silawnaw kyakhe</para>
  <para style="q2">na lungry athua cih;</para>
  <para style="q1">tetuh na silawhang vawlan khe</para>
  <para style="q2">tangnuapaw hae khate</para>
  <para style="q1">silaw athua vae cih.</para>
  <chapter number="52" style="c" />
  <para style="s1">
    <note caller="-" style="x">
      <char style="xo" closed="false">52 Abyalu: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 22:9-10">1Sa 22.9-10</ref>
      </char>
    </note> Ahynpaw tungvaw Byapianaw<note caller="+" style="f"><char style="fr" closed="false">52 Abyalu: </char><char style="ft" closed="false">David tuh Ahimelek inn kya a thua, cite Edom ccungccaw Doeg nynh Saul kha a hopah koute David nynh a phuapaw hlaw.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Pou athungpaw ccungccapaw,</para>
  <para style="q2">Pachia a beik hae paw tungvaw</para>
  <para style="q1">rysawthyanaw kyakhe</para>
  <para style="q2">pawccemou na pooku?</para>
  <para style="q1">
    <verse number="2" style="v" />Anin ninlang ro lanpaw kha</para>
  <para style="q2">na paccynku.</para>
  <para style="q1">Na lae tuh ahepaw sangteih te</para>
  <para style="q2">lokuh zah, hynbya kha a ho.</para>
  <para style="q1">
    <verse number="3" style="v" />Ahoypaw laeze athahpaw kha</para>
  <para style="q2">na ryhua zah,</para>
  <para style="q2">byaccing laeze hynbya kha na ryhua.</para>
  <para style="q1">
    <verse number="4" style="v" />Pou ahynpaw lae, nang tuh</para>
  <para style="q2">ronaw bya balyn kha na sungsah.</para>
  <para style="q1">
    <verse number="5" style="v" />Tukeiccuze Pachia nynh</para>
  <para style="q2">zungzae ae roh cih;</para>
  <para style="q1">na bu kyate ccaring ae sue cih zah</para>
  <para style="q2">thoh ae pae cih;</para>
  <para style="q1">ahiin hae paw ram kyate</para>
  <para style="q2">dae ae thua cih.</para>
  <para style="q1">
    <verse number="6" style="v" />Miding hae nynh hoyleinaw</para>
  <para style="q2">a rae hae paw kha a muih cih hae zah</para>
  <para style="q2">a rih cih hae, te a nuinse cih hae zah,</para>
  <para style="q1">
    <verse number="7" style="v" />“Pachia kya reku leite,</para>
  <para style="q2">hoirumnaw patae kha doliakuh zah</para>
  <para style="q1">sisua kya khynnaw a ccungkuhpaw khuh</para>
  <para style="q2">dotua oh!” cite a ho cih hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Thuasalama kae tuh Pachia inn kya-e</para>
  <para style="q2">hinlalyhpaw oliv ku te nynh kae loku.</para>
  <para style="q1">Pachia sungsahnaw atynpaw kha</para>
  <para style="q2">zungzae te zungzae cia ka doliaku.</para>
  <para style="q1">
    <verse number="9" style="v" />Na cyipaw uccaw keiccuze</para>
  <para style="q2">na tungvaw ka lungtua zungzae cih.</para>
  <para style="q1">Na hoy keiccuze alungzipaw</para>
  <para style="q2">na ccungccaw hae a umnaw hae kyakhe</para>
  <para style="q1">na min kha ka siakhae cih.</para>
  <chapter number="53" style="c" />
  <para style="s1">Ccungccaw Hoyleinaw<note caller="+" style="f"><char style="fr" closed="false">53 Abyalu: </char><char style="ft" closed="false">David byarui.</char></note></para>
  <para style="r">(<ref loc="PSA 14">Sam 14</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" />Mingaee hae nynh mih thinlung kya,</para>
  <para style="q2">“Pachia um khyh,” a ci hae.</para>
  <para style="q1">Minmin tuh arohpaw thua hae zah,</para>
  <para style="q2">anungsikuhpaw hoyleinaw kha</para>
  <para style="q1">a rae hae;</para>
  <para style="q2">hoynaw a raepaw lu kheit san</para>
  <para style="q1">um khyh.<note caller="-" style="x"><char style="xo" closed="false">53.1-3: </char><char style="xt" closed="false"><ref loc="ROM 3:10-12">Rom 3.10-12</ref></char></note></para>
  <para style="q1">
    <verse number="2" style="v" />A hawpaw, Pachia a ccungpaw lu kheit san</para>
  <para style="q2">a um tou cipaw muih khylan</para>
  <para style="q1">Pachia nynh vaawlang te</para>
  <para style="q2">ccungccaw kha a dobung.</para>
  <para style="q1">
    <verse number="3" style="v" />Mih balyn te pong cceihsei hae,</para>
  <para style="q2">mih balyn mawte phe lokuh lante</para>
  <para style="q1">a ccouseikuh hae;</para>
  <para style="q2">ahoypaw a cyihpaw hum san um khyh,</para>
  <para style="q1">lu kheit san um khyh.</para>
  <para style="q1">
    <verse number="4" style="v" />Ka ccungccaw hae kha sanlou hawte</para>
  <para style="q2">ae hae zah,</para>
  <para style="q1">Pachia kalan saw a sang lei hae paw</para>
  <para style="q2">ccungccaw hoylei hae paw hynh</para>
  <para style="q1">nythyanaw hoi khyh hae tou?</para>
  <para style="q1">
    <verse number="5" style="v" />Minmin tuh myaryamaw a rih cih hae,</para>
  <para style="q2">a la hoi boi lei hae paw rikawnaw kha</para>
  <para style="q2">a hoi cih hae.</para>
  <para style="q1">Pawccecize Pachia nyh lei hae paw</para>
  <para style="q2">ru kha Pachia nynh phiariphiarae</para>
  <para style="q1">a nung cih hae;</para>
  <para style="q2">Pachia nynh a vua vae hae keiccuze</para>
  <para style="q1">maethyanaw a mue cih hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Israel hanlan khumnaw tuh</para>
  <para style="q2">Zion kyate yn thua vae sah!</para>
  <para style="q1">Pachia nynh a ccungccaw hae kha</para>
  <para style="q2">hoynaw he a pyathui hae te,</para>
  <para style="q1">Jakob tuh a lungtua cih;</para>
  <para style="q2">Israel tuh a lungpaw cih.</para>
  <chapter number="54" style="c" />
  <para style="s1">
    <note caller="-" style="x">
      <char style="xo" closed="false">54 Abyalu: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 23:19">1Sa 23.19</ref>, <ref loc="1SA 26:1">26.1</ref></char>
    </note> Khyn nawlan Sawsangnaw<note caller="+" style="f"><char style="fr" closed="false">54 Abyalu: </char><char style="ft" closed="false">David tuh kae ram kya a rekuh, cite Zif ccungccaw hae nynh Saul kha a hopah kou hae te David nynh a phuapaw hlaw.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Pou Pachia, na min te yn khum lah,</para>
  <para style="q2">na thungnaw te yn luesah tua.</para>
  <para style="q1">
    <verse number="2" style="v" />Pou Pachia, ka sawsangnaw</para>
  <para style="q2">yn thaepya tua;</para>
  <para style="q1">ka hopaw bya hynh yn ngaepya tua.</para>
  <para style="q1">
    <verse number="3" style="v" />Pawccecize a lysakuh hae paw tuh</para>
  <para style="q2">kae kha rawsete yn thokuh vae hae,</para>
  <para style="q1">mih rysawthah hae paw nynh</para>
  <para style="q2">chia khylan yn ccung hae;</para>
  <para style="q1">Pachia kha pawlangria khyh hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Thuasalama Pachia tuh</para>
  <para style="q2">kae yn bawmtu ccaccing nynh thua;</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> tuh ka hiinnaw</para>
  <para style="q2">yn thungkhawtu nynh thua.</para>
  <para style="q1">
    <verse number="5" style="v" />Ka rhaw hae kha mih seinaw hanlan</para>
  <para style="q2">a liaru cih hae.</para>
  <para style="q1">Zyn lan na um thyhte minmin kha</para>
  <para style="q2">roh hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Lungthote silawnaw thyhte</para>
  <para style="q2">na kalan silawnaw ka rae cih;</para>
  <para style="q1">Pou <char style="nd">Bawipaw </char>, nang tuh</para>
  <para style="q2">na hoy keiccuze na min kha</para>
  <para style="q2">kae thehoysah cih.</para>
  <para style="q1">
    <verse number="7" style="v" />Pawccecize ka vawsawnaw miakaw kyate</para>
  <para style="q2">yn luesah zah, ka rhaw hae nynh</para>
  <para style="q1">a shung hae paw kha ka muih vae.</para>
  <chapter number="55" style="c" />
  <para style="s1">Ruiban hanlan Sawsangpyanaw<note caller="+" style="f"><char style="fr" closed="false">55 Abyalu: </char><char style="ft" closed="false">David byarui.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Pou Pachia, ka sawsangnaw hynh</para>
  <para style="q2">yn thaepya tua;</para>
  <para style="q1">kae ngiakunaw hynh</para>
  <para style="q2">beih retawkuh nan.</para>
  <para style="q1">
    <verse number="2" style="v" />yn ngaepah lah, yn leihtua;</para>
  <para style="q2">ka lungriathae keiccuze</para>
  <para style="q2">myarya ka bang vae.</para>
  <para style="q1">
    <verse number="3" style="v" />Ka rhaw hae kya-e siarisiaraepaw</para>
  <para style="q2">roi keiccu thuasah,</para>
  <para style="q1">ccungccaw hoylei hae paw nynh</para>
  <para style="q2">siaruanaw keiccu thuasah</para>
  <para style="q1">ka lungriathae.</para>
  <para style="q2">Ka tungvaw vawsaw yn pya hae zah,</para>
  <para style="q1">thinriate yn hua hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Ka lungkhu kya ka thinlung tuh</para>
  <para style="q2">rinaw te phe abeih,</para>
  <para style="q2">chi rawrinaw tuh yn thuanua vae.</para>
  <para style="q1">
    <verse number="5" style="v" />Rinaw te thyngkunaw nynh</para>
  <para style="q2">yn thuanua zah,</para>
  <para style="q1">myarya lepaw rinaw nynh</para>
  <para style="q2">phang yn bong.</para>
  <para style="q1">
    <verse number="6" style="v" />“Vahu hawte sake ka la hoi sah lah!</para>
  <para style="q2">Asawnaw lang ka zou cih zah,</para>
  <para style="q2">zya ka haeung cih paw.</para>
  <para style="q1">
    <verse number="7" style="v" />Asawnaw lang ka ccue cih zah,</para>
  <para style="q2">ramkaw kya ka um cih;</para>
  <para style="q1">
    <verse number="8" style="v" />khisan zawpaw te khise thopaw kyate</para>
  <para style="q2">rekunaw hmin muihku khylan</para>
  <para style="q1">ka rangsakuh cih,” ka ci.</para>
  <para style="q1">
    <verse number="9" style="v" />Pou <char style="nd">Bawipaw </char>, mih lungmuasah hae lah,</para>
  <para style="q2">mih byaho kha tua-aesakuh hae;</para>
  <para style="q1">pawccecize khuapi lungkhu kya</para>
  <para style="q2">puathonaw te pekumaekunaw kha</para>
  <para style="q2">ka muih.</para>
  <para style="q1">
    <verse number="10" style="v" />Khua koihlukuhpaw rhawlungrua kyakhe</para>
  <para style="q2">khuazi khuadae a cceih bungthung hae,</para>
  <para style="q1">khuapi lungkhu khe hoyleinaw te</para>
  <para style="q2">vawsawnaw a um;</para>
  <para style="q1">
    <verse number="11" style="v" />khua ngaelung khe ronaw a um;</para>
  <para style="q2">tuaasahkunaw te lingkunaw tuh</para>
  <para style="q1">khua lungkhu e</para>
  <para style="q2">kungkunaw hmin hae kya phe abeih.</para>
  <para style="q1">
    <verse number="12" style="v" />Kae yn sarya hae paw hynh</para>
  <para style="q2">ka rhaw hae thua khyh hae,</para>
  <para style="q1">a la thua hae lanze,</para>
  <para style="q2">ka ngaesang kho cih;</para>
  <para style="q1">kae yn lysanuakuh hae paw hynh</para>
  <para style="q2">yn rhawtu hae paw thua khyh,</para>
  <para style="q2">a la thua hae ze, ka retawkuh kho cih hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Thuasalama tuhte a cyihtupaw tuh</para>
  <para style="q2">nang na thua zah,</para>
  <para style="q1">kae te phe ah lokuhpaw, ka banpaw,</para>
  <para style="q2">kae ccawkuhpaw ka ruiban nynh na thua.</para>
  <para style="q1">
    <verse number="14" style="v" />Lungtuate bya hoypaw kha</para>
  <para style="q2">ah hokuh oh zah,</para>
  <para style="q1">zapi hae ryte Pachia inn lang</para>
  <para style="q2">pynkheihlan ah cceih oh.</para>
  <para style="q1">
    <verse number="15" style="v" />Chinaw nynh mih tungvaw</para>
  <para style="q2">thuanua hae sah;</para>
  <para style="q1">mih hiin pite Michi khua lang</para>
  <para style="q2">cceih hae sah;</para>
  <para style="q1">pawccecize hoyleinaw tuh</para>
  <para style="q2">mih inn kya te mih thinlung kya a um.</para>
  <para style="q1">
    <verse number="16" style="v" />Kae tuh Pachia kha ka ko zah,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh yn khum cih.</para>
  <para style="q1">
    <verse number="17" style="v" />Zete, awkhua te ninthu ccyh khe</para>
  <para style="q2">bokhaekute ka hawkhaekuh zah,</para>
  <para style="q2">ka roi kha yn thaepah cih.</para>
  <para style="q1">
    <verse number="18" style="v" />Rhaw ka tuknaw kyate</para>
  <para style="q2">vaemaw mue leite</para>
  <para style="q1">kae kha yn shawkhaw cih,</para>
  <para style="q2">pawccecize ccungccaw patae tuh</para>
  <para style="q2">kae kha rawsete a um hae.</para>
  <para style="q1">
    <verse number="19" style="v" />Langmawlya mawte bawitungkhung kya</para>
  <para style="q2">a haungpaw Pachia nynh a thae cih zah,</para>
  <para style="q1">minmin kha zakaw a sangsah cih hae,</para>
  <para style="q2">a paleihku khyh keiccu hae ze,</para>
  <para style="q1">Pachia kha rih khyh hae.</para>
  <para style="q1">
    <verse number="20" style="v" />Ka banpaw nynh a banpaw kha</para>
  <para style="q2">a kuih hangnua zah,</para>
  <para style="q2">amaw byakin kha zui khyh,</para>
  <para style="q1">
    <verse number="21" style="v" />a bya tuh thawpah laeze</para>
  <para style="q2">anaw lante hothya salamah,</para>
  <para style="q1">rhawtukku rynaw thinlung a hoi;</para>
  <para style="q2">a bya tuh chitui laeze nehua salamah,</para>
  <para style="q1">poh thuaakuhpaw thaloi nynh thua.</para>
  <para style="q1">
    <verse number="22" style="v" />Na phupaw kha</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kya nung lah,</para>
  <para style="q2">nang kha ae bawm cih;</para>
  <para style="q1">miding kha shungnaw</para>
  <para style="q2">kharouh pya boi lan khyh.</para>
  <para style="q1">
    <verse number="23" style="v" />Thuasalama, pou Pachia,</para>
  <para style="q2">minmin kha akhu huaccepaw</para>
  <para style="q1">hunghua lungkhu lang</para>
  <para style="q2">na sahbung cih hae;</para>
  <para style="q1">ccungccaw theih hae paw te mihyn hae tuh</para>
  <para style="q2">mih hiinshe angankuh cia hiin lan khyh hae.</para>
  <para style="q1">Thuasalama kae tuh nang kha</para>
  <para style="q2">kae doliakuh cih.</para>
  <chapter number="56" style="c" />
  <para style="s1">
    <note caller="-" style="x">
      <char style="xo" closed="false">56 Abyalu: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 21:13-15">1Sa 21.13-15</ref>
      </char>
    </note> Pachia Doliakunaw<note caller="+" style="f"><char style="fr" closed="false">56 Abyalu: </char><char style="ft" closed="false">Filistin hae nynh Gath khua a lah kou hae te David nynh a phuapaw hlaw.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Pou Pachia, thaw beih yn ccitua,</para>
  <para style="q2">pawccecize ccungccaw hae nynh</para>
  <para style="q1">yn syde hae;</para>
  <para style="q2">rhaw hae nynh anin ninlang</para>
  <para style="q2">yn tuaa yn sah hae;</para>
  <para style="q1">
    <verse number="2" style="v" />ka rhaw hae nynh anin ninlang</para>
  <para style="q2">yn syde hae,</para>
  <para style="q1">ccungccaw patae nynh rawsete</para>
  <para style="q2">yn dou hae.</para>
  <para style="q1">Pou Ahang Huaccepaw, <verse number="3" style="v" />he ka ri vae ze,</para>
  <para style="q2">nang kha kae doliaku.</para>
  <para style="q1">
    <verse number="4" style="v" />Pachia bya kha the ka hoysah,</para>
  <para style="q2">Pachia kha ka doliaku keiccuze</para>
  <para style="q1">ka rih khyh;</para>
  <para style="q2">ccungccaw nynh pawmou</para>
  <para style="q1">yn cyih kho cih?</para>
  <para style="q1">
    <verse number="5" style="v" />Ka rhaw hae nynh ka cyipaw kyakhe</para>
  <para style="q2">anin ninlang vawsaw yn pya hae;</para>
  <para style="q1">mih tuanaw balyn tuh ka tungvaw</para>
  <para style="q2">hoyleinaw hanlan nynh thua.</para>
  <para style="q1">
    <verse number="6" style="v" />Pekumaekunaw kha puisah hae zah,</para>
  <para style="q2">buhkhawte ka ccianaw kha</para>
  <para style="q2">yn dokhaw hae.</para>
  <para style="q1">Ka hiinnaw chia khylan</para>
  <para style="q2">a ngaehoi lya hae khe,</para>
  <para style="q1">
    <verse number="7" style="v" />mih hoyleinaw keiccuze</para>
  <para style="q2">minmin kha liarutua hae;</para>
  <para style="q1">Pou Pachia, tuh-e ccungccaw hae kha</para>
  <para style="q2">thinriate khuliatua hae!</para>
  <para style="q1">
    <verse number="8" style="v" />Ka ngaethyanaw kha phe na ny vae;</para>
  <para style="q2">ka mitphi kha na tuihinbu lungkhu</para>
  <para style="q1">phe na ruin vae.</para>
  <para style="q2">Tuh-e hae tuh na ccauh kya</para>
  <para style="q2">na zei vae khaw?</para>
  <para style="q1">
    <verse number="9" style="v" />Oute nang kha he kae ko nin khe,</para>
  <para style="q2">ka rhaw hae tuh nulang a ki cih hae.</para>
  <para style="q2">Pachia tuh ka kalan a pan cipaw ka ny.</para>
  <para style="q1">
    <verse number="10" style="v" />Pachia bya kha the ka hoysah,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> bya kha the ka hoysah,</para>
  <para style="q1">
    <verse number="11" style="v" />Pachia kha ka doliaku keiccuze</para>
  <para style="q2">ka rih khyh.</para>
  <para style="q1">ccungccaw bali nynh pawmou</para>
  <para style="q2">yn cyih kho cih?</para>
  <para style="q1">
    <verse number="12" style="v" />Pou Pachia, na kya bya ka kinkupaw kha</para>
  <para style="q2">ka cyih hahe cih;</para>
  <para style="q1">na kalan lungtuanaw silawnaw kha</para>
  <para style="q2">ka rae cih.</para>
  <para style="q1">
    <verse number="13" style="v" />Pawccecize chinaw kyate</para>
  <para style="q2">ka hiinnaw kha nae luesah vae,</para>
  <para style="q1">Pachia malang, hiinnaw awnaw kya</para>
  <para style="q2">ka ccia kho nawlan,</para>
  <para style="q1">ka ccu kha khuliakunaw kyate</para>
  <para style="q2">nae luesah.</para>
  <chapter number="57" style="c" />
  <para style="s1">
    <note caller="-" style="x">
      <char style="xo" closed="false">57 Abyalu: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 22:1">1Sa 22.1</ref>, <ref loc="1SA 24:3">24.3</ref></char>
    </note>Bawmnaw elang Sawsangnaw<note caller="+" style="f"><char style="fr" closed="false">57 Abyalu: </char><char style="ft" closed="false">David nynh Saul kyate ccue zah lungkarung kya a rekuh koute a phuapaw hlaw.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Pou Pachia, ngaethya beih yn umsah,</para>
  <para style="q2">ngaethya yn umsah tua,</para>
  <para style="q1">pawccecize ka muisaw tuh</para>
  <para style="q2">namaw kya a rekuh;</para>
  <para style="q1">ronaw khise a dae mawlaezung,</para>
  <para style="q2">na sake mynlyh kaw khe ka rekuh cih.</para>
  <para style="q1">
    <verse number="2" style="v" />Ahang Huaccepaw Pachia kalan,</para>
  <para style="q2">ka hanlan a paccynnaw</para>
  <para style="q2">yn ccingsahpahpaw Pachia kalan ka sia.</para>
  <para style="q1">
    <verse number="3" style="v" />Vaawlang te yn saw cih hae zah</para>
  <para style="q2">yn khum cih, yn syde hae paw kha</para>
  <para style="q2">maethya a lah cih hae.</para>
  <para style="q1">Atynpaw a sungsahnaw te</para>
  <para style="q2">a lungzinaw kha yn sawpah cih.</para>
  <para style="q1">
    <verse number="4" style="v" />Karankute ccungccaw a teithyapaw</para>
  <para style="q2">chindeih hae laku khe ka ih;</para>
  <para style="q1">mih haw tuh ccoi te</para>
  <para style="q2">the hawte nynh thua hae.</para>
  <para style="q1">mih lae tuh ahepaw</para>
  <para style="q2">thaloi hawte nynh thua hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Pou Pachia, vaawlui luki cia</para>
  <para style="q2">thehoysah na thua vae.</para>
  <para style="q1">Na phu-enaw nynh laephi pynpi</para>
  <para style="q2">pong bong sah.</para>
  <para style="q1">
    <verse number="6" style="v" />Minmin nynh ka ccianaw kya</para>
  <para style="q2">kaang yn syakhaw hae;</para>
  <para style="q1">ka muisaw tuh lungriathaete a um.</para>
  <para style="q2">Ka ccianaw khe hunghua yn thaekhaw hae,</para>
  <para style="q1">thuasalama tuh-e hunghua lungkhu lang</para>
  <para style="q2">mimaw toulou a ccah hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Pou Pachia, ka thinlung tuh tynkaring,</para>
  <para style="q2">ka thinlung tuh tynkaring.</para>
  <para style="q1">Hlaw ka sah cih zah the kae hoysah cih.</para>
  <para style="q2">
    <verse number="8" style="v" />Ka muisaw, thotua!</para>
  <para style="q1">Pou tintang te phyly, thotua oh!</para>
  <para style="q2">Kae mah awkhua takaw te ka tho cih.</para>
  <para style="q1">
    <verse number="9" style="v" />Pou <char style="nd">Bawipaw </char>, ccungccaw hae laku kya</para>
  <para style="q2">kae thehoysah cih;</para>
  <para style="q1">minphuin hae laku kya</para>
  <para style="q2">nang thehoysahnaw hlaw ka sah cih.</para>
  <para style="q1">
    <verse number="10" style="v" />Pawccecize atynpaw na sungsahnaw tuh</para>
  <para style="q2">vaawlui cih ahang;</para>
  <para style="q1">na lungzinaw tuh</para>
  <para style="q2">maeking kyacia phe aphah.</para>
  <para style="q1">
    <verse number="11" style="v" />Pou Pachia, vaawlui luki cia</para>
  <para style="q2">thehoysah na thua vae.</para>
  <para style="q1">Na phu-enaw nynh laephi pynpi</para>
  <para style="q2">pong bong sah.</para>
  <chapter number="58" style="c" />
  <para style="s1">Liarunaw elang Sawsangnaw<note caller="+" style="f"><char style="fr" closed="false">58 Abyalu: </char><char style="ft" closed="false">David hlaw.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Pou uktu hae, hmerarih lante</para>
  <para style="q2">bya na pia ccaccing oh tou?</para>
  <para style="q1">Ccungccaw hae kha</para>
  <para style="q2">hoyte bya na pia oh tou?</para>
  <para style="q1">
    <verse number="2" style="v" />Na pia khyh oh, nae thinlung kya</para>
  <para style="q2">hoyleinaw kha na paccynku oh;</para>
  <para style="q1">laephi vawlan nae kuih nynh</para>
  <para style="q2">puathonaw rya kha a law.</para>
  <para style="q1">
    <verse number="3" style="v" />Ccungccaw hoyleipaw tuh</para>
  <para style="q2">a nung vue kyamawte a cceihsei vae;</para>
  <para style="q1">a pui takaw hae te hynbya hote</para>
  <para style="q2">a mesei hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Minmin tuh huparepaw sy te</para>
  <para style="q2">alokuhpaw sy a hoi hae,</para>
  <para style="q1">a nawpanpaw huparepaw hawte</para>
  <para style="q2">mih nakaring kha a huku hae,</para>
  <para style="q1">
    <verse number="5" style="v" />tetuh hupaw a soihthyapaw</para>
  <para style="q2">roi kha thuasah,</para>
  <para style="q1">a thyaruhpaw mitleihthyapaw</para>
  <para style="q2">roi kha thuasah thae vae khyh.</para>
  <para style="q1">
    <verse number="6" style="v" />Pou Pachia, mih khalang kya-e</para>
  <para style="q2">mih haw kha khya hae;</para>
  <para style="q1">Pou <char style="nd">Bawipaw </char>, chindeih ano hae paw</para>
  <para style="q2">nua kha pong khya!</para>
  <para style="q1">
    <verse number="7" style="v" />Minmin tuh aluapaw tui hawte</para>
  <para style="q2">zo hae sah;</para>
  <para style="q1">lonua hawte syde hae sah lah,</para>
  <para style="q2">naan hae sah.</para>
  <para style="q1">
    <verse number="8" style="v" />A ccia lyakhe palae tuipaw</para>
  <para style="q2">tangkaroh hawte thua hae sah;</para>
  <para style="q1">khuanin a muih boi leipaw</para>
  <para style="q2">ccaaw arohpaw hawte thua hae sah.</para>
  <para style="q1">
    <verse number="9" style="v" />Maee aruapaw hinpaw ku kya-e</para>
  <para style="q2">asopaw kha ang nynh a ny mawkhe,</para>
  <para style="q1">hinpaw ku ahinpaw thuasah,</para>
  <para style="q2">aroupaw thuasah Pachia nynh</para>
  <para style="q1">thyaararih lan phi vae hae sah!</para>
  <para style="q1">
    <verse number="10" style="v" />Tuh-e liarunaw kha miding hae nynh</para>
  <para style="q2">he a muih hae tuh mih lungtua cih;</para>
  <para style="q1">ccungccaw hoylei hae paw chii te</para>
  <para style="q2">mih ccu a singkuh cih hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Ccungccaw hae nynh,</para>
  <para style="q2">“Miding hae hanlan lasung</para>
  <para style="q1">a um ccaccing;</para>
  <para style="q2">laephi vawlan bya a piatupaw</para>
  <para style="q1">Pachia tuh a um ccaccing,” cite</para>
  <para style="q2">a ho cih hae.</para>
  <chapter number="59" style="c" />
  <para style="s1">
    <note caller="-" style="x">
      <char style="xo" closed="false">59 Abyalu: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 19:11">1Sa 19.11</ref>
      </char>
    </note>Luenaw elang Sawsangnaw<note caller="+" style="f"><char style="fr" closed="false">59 Abyalu: </char><char style="ft" closed="false">David kha chia khylan Saul nynh a inn kya ccungccaw a ngawsah koute David nynh a phuapaw hlaw.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Pou ka Pachia, ka rhaw hae kyate</para>
  <para style="q2">yn luesah tua; kae kha rawsete</para>
  <para style="q1">yn thonuakuh hae paw kyate</para>
  <para style="q2">yn thungkhawtua.</para>
  <para style="q1">
    <verse number="2" style="v" />Hoyleinaw rya a lah hae paw kyate</para>
  <para style="q2">yn luesah tua;</para>
  <para style="q1">ccungccaw a theih hae paw kyate</para>
  <para style="q2">yn khumtua.</para>
  <para style="q1">
    <verse number="3" style="v" />Atumaw heize ka hiinnaw chia khylan</para>
  <para style="q2">yn buhkhaw hae;</para>
  <para style="q1">athungpaw ccungccaw hae nynh</para>
  <para style="q2">pekumaeku yn hyy hae.</para>
  <para style="q1">Pou <char style="nd">Bawipaw </char>, ka cyiseinaw te</para>
  <para style="q2">ka seinaw keiccu thua khyh,</para>
  <para style="q1">
    <verse number="4" style="v" />ka cyiseinaw a um lei pite,</para>
  <para style="q2">yn ccuenua hae zah,</para>
  <para style="q1">yn paccynnuaku hae.</para>
  <para style="q1">Kae kha bawm khylan</para>
  <para style="q2">yn thokuh lah yn dotua.</para>
  <para style="q1">
    <verse number="5" style="v" />
    <char style="nd">Bawipaw </char> vaaw hae Pachia,</para>
  <para style="q2">nang tuh Israel Pachia nynh na thua.</para>
  <para style="q1">Minphuin balyn detah khylan thoku tua;</para>
  <para style="q2">a hynhupaw ccungccaw hoylei hae paw kha</para>
  <para style="q1">lu kheit sanmah haang nan hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Minmin tuh zete takyh oun ki hae zah,</para>
  <para style="q2">ui hawte siate khua lungkhu</para>
  <para style="q2">a khiavuikuh hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Mih khalang te thawte a sia hae,</para>
  <para style="q2">mih mung kyakhe thaloi hawte</para>
  <para style="q1">ahepaw bya um zah,</para>
  <para style="q2">“Hum nynh mou oun thae cih?” a ci hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Thuasalama, pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">minmin kha na nuinse hae;</para>
  <para style="q2">minphuin balyn kha na sarya hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Pou ka thawzung, nang kha</para>
  <para style="q2">kae ngaehoikuh cih;</para>
  <para style="q1">Pou Pachia, nang tuh</para>
  <para style="q2">ka rekunaw nynh na thua.</para>
  <para style="q1">
    <verse number="10" style="v" />Ka Pachia nynh atynpaw a sungsahnaw te</para>
  <para style="q2">kae kha yn tungkuh cih;</para>
  <para style="q1">ka Pachia nynh ka rhaw hae tungvaw</para>
  <para style="q2">taenaw yn muesah cih.</para>
  <para style="q1">
    <verse number="11" style="v" />Pou <char style="nd">Bawipaw </char>, kae khawriaphua,</para>
  <para style="q2">minmin kha theih nan hae,</para>
  <para style="q1">tuhkhyhze tuh ka ccungccaw hae nynh</para>
  <para style="q2">a ningsei cih hae;</para>
  <para style="q1">na huhan te minmin kha phia hae lah,</para>
  <para style="q2">nyaasah bung hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Mih khalang kya-e seinaw,</para>
  <para style="q2">mih munglae kya-e bya hae keiccuze,</para>
  <para style="q2">mih lysakunaw kya kaangkae hae sah.</para>
  <para style="q1">A ho hae paw thyalawnaw bya te</para>
  <para style="q2">hynbya keiccuze,</para>
  <para style="q1">
    <verse number="13" style="v" />thinriate minmin kha phe maemih hae;</para>
  <para style="q2">phe a zo lan hae cia, maemih hae.</para>
  <para style="q1">Tetuh Pachia nynh Jakob phuin kha uk zah,</para>
  <para style="q2">laephi athangnaw cia</para>
  <para style="q1">a uk cipaw a nyh cih hae.</para>
  <para style="q1">
    <verse number="14" style="v" />Minmin tuh zete takyh oun ki hae zah,</para>
  <para style="q2">ui hawte siaruate</para>
  <para style="q2">khua lungkhu a khiavuikuh hae.</para>
  <para style="q1">
    <verse number="15" style="v" />Looh ccungku khylan</para>
  <para style="q2">khiavuikuh hae zah,</para>
  <para style="q1">ae khin a mueku khyh hae ze,</para>
  <para style="q2">a ccohkuh hae.</para>
  <para style="q1">
    <verse number="16" style="v" />Thuasalama na thungnaw kha</para>
  <para style="q2">hlaw te ka sah cih;</para>
  <para style="q1">awkhua takaw khe atynpaw</para>
  <para style="q2">na sungsahnaw kha hlaw te</para>
  <para style="q2">ka siakhae cih.</para>
  <para style="q1">Pawccecize nang tuh ka rhawlungrua</para>
  <para style="q2">na thua vae zah,</para>
  <para style="q1">ka vawsaw ccyh lya</para>
  <para style="q2">ka khynnaw nynh na thua.</para>
  <para style="q1">
    <verse number="17" style="v" />Pou ka thawzung,</para>
  <para style="q2">na kalan thehoysahnaw hlaw ka sah cih,</para>
  <para style="q1">Pou Pachia, nang tuh</para>
  <para style="q2">ka rhawlungrua nynh na thua,</para>
  <para style="q1">atynpaw sungsahnaw yn langsapakuhpaw</para>
  <para style="q2">Pachia nynh na thua.</para>
  <chapter number="60" style="c" />
  <para style="s1">
    <note caller="-" style="x">
      <char style="xo" closed="false">60 Abyalu: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 8:13">2Sa 8.13</ref>; <ref loc="1CH 18:12">1Sh 18.12</ref></char>
    </note>Taenaw elang Sawsangnaw<note caller="+" style="f"><char style="fr" closed="false">60 Abyalu: </char><char style="ft" closed="false">Naharaim kya a umpaw te Zobah kya a umpaw Armenean ccungccaw hae kha tuk hae zah Joab nynh nulang maeleihkuh zah Edom hae thong haw lae ning kha Loi Accya kya a theih kou hae te David nynh ccangpya nawlan a phuapaw hlaw. </char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Pou Pachia, kaening kha nae vua vae zah,</para>
  <para style="q2">kae thungkhawkunawpaw kha</para>
  <para style="q1">nae khyapya vae;</para>
  <para style="q2">kae tungvaw na thinria vae,</para>
  <para style="q1">atu tuh kaening kalan</para>
  <para style="q2">beih yn maekuh ccavae!</para>
  <para style="q1">
    <verse number="2" style="v" />Laephi kha na hysah zah,</para>
  <para style="q2">haehae ua lan na koisah vae;</para>
  <para style="q1">laephi tuh a hy keiccuze a koinaw kha</para>
  <para style="q2">pingsah tua.</para>
  <para style="q1">
    <verse number="3" style="v" />Na ccungccaw hae kha</para>
  <para style="q2">vawsaw na teingsah hae;</para>
  <para style="q1">kaening oun ruisahpaw misutui kha</para>
  <para style="q2">nia lan nae pya vae.</para>
  <para style="q1">
    <verse number="4" style="v" />Namaw ae rih hae paw hanlan</para>
  <para style="q2">syntawnaw alan kha na saepya vae hae,</para>
  <para style="q1">tuh-e tuh the te li kyate</para>
  <para style="q2">a lue kho nawlan hae nynh thua.</para>
  <para style="q1">
    <verse number="5" style="v" />Na sungsah hae paw kha</para>
  <para style="q2">luesah athua nawlan hae,</para>
  <para style="q1">na ranglang kuih te taenaw oun pya lah,</para>
  <para style="q2">kae sawsangnaw kha oun thaepya tua.</para>
  <para style="q1">
    <verse number="6" style="v" />Pachia nynh a beikinnthyaa kyakhe,</para>
  <para style="q2">“Shekhem kha myarya lungtuate</para>
  <para style="q1">thoh ka phia cih,</para>
  <para style="q2">te Sukkoth Bialae kha ka nee cih hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Gilead ram tuh ka kya-e nynh thua,</para>
  <para style="q2">Manasseh mah ka kya-e nynh thua;</para>
  <para style="q1">Efraim tuh ka lukhung thua zah,</para>
  <para style="q2">Judah tuh ka ccoi nynh thua.</para>
  <para style="q1">
    <verse number="8" style="v" />Moab tuh tui ka singkunawpaw</para>
  <para style="q2">ka tuipung nynh thua;</para>
  <para style="q1">Edom tuh ka ccukoh te</para>
  <para style="q2">ka synaw nynh thua;</para>
  <para style="q1">Filistin ram kha taenaw roi te</para>
  <para style="q2">ka sia,” a ci.</para>
  <para style="q1">
    <verse number="9" style="v" />Hum nynh mou kae kha</para>
  <para style="q2">koihkhawpaw khuapi lungkhu lang</para>
  <para style="q1">yn teekhae cih?</para>
  <para style="q2">Hum nynh mou kae kha Edom lang</para>
  <para style="q2">yn cciakhae cih?</para>
  <para style="q1">
    <verse number="10" style="v" />Pou Pachia, kaening kha</para>
  <para style="q2">phe nae vua vae khyh tou?</para>
  <para style="q1">Pou Pachia, kae rhawkaw hae ryte</para>
  <para style="q2">na cceihkheih khyh oh tou?</para>
  <para style="q1">
    <verse number="11" style="v" />Kae rhaw hae kha rawsete</para>
  <para style="q2">kaening hynh bawmnaw beih oun pya,</para>
  <para style="q1">pawccecize ccungccaw</para>
  <para style="q2">bawmnaw tuh ccungkia khyh.</para>
  <para style="q1">
    <verse number="12" style="v" />Pachia liate rawthungte kae cyih cih;</para>
  <para style="q2">kae rhaw hae kha a syde cih paw tuh</para>
  <para style="q1">amaw nynh thua.</para>
  <chapter number="61" style="c" />
  <para style="s1">Pachia Thungkhawnaw<note caller="a" style="f"><char style="fr" closed="false">61.0 </char><char style="ft" closed="false">David hlaw</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Pou Pachia, ka sianaw roi kha</para>
  <para style="q2">yn thaepya tua;</para>
  <para style="q2">ka sawsangnaw kha yn ngaepya tua.</para>
  <para style="q1">
    <verse number="2" style="v" />Ka lungthaw he azya tuh,</para>
  <para style="q2">laephi athangnaw kyate</para>
  <para style="q1">nang kha kae ko.</para>
  <para style="q1">Kae laeze ahang huapaw lungpi kalan</para>
  <para style="q2">yn cciakhae tua;</para>
  <para style="q1">
    <verse number="3" style="v" />pawccecize nang tuh ka khynnaw,</para>
  <para style="q2">rhaw hae kha rawsenawpaw atynpaw</para>
  <para style="q1">rhawviainn ahangpaw nynh na thua.</para>
  <para style="q1">
    <verse number="4" style="v" />Na bu kya zungzae yn umsah,</para>
  <para style="q2">na sake adawkuhpaw kaw kya</para>
  <para style="q2">khynnaw kha yn muihsah.</para>
  <para style="q1">
    <verse number="5" style="v" />Pou Pachia, ka byakinnaw kha</para>
  <para style="q2">phe na thae vae;</para>
  <para style="q1">na min rawrih hae paw rho kha</para>
  <para style="q2">phe nae pya vae.</para>
  <para style="q1">
    <verse number="6" style="v" />Siapharan hiinshe kha saesah tua;</para>
  <para style="q2">amaw ccyh tuh zungzae la tyn vae sah.</para>
  <para style="q1">
    <verse number="7" style="v" />Pachia malang bawitungkhung kya</para>
  <para style="q2">zungzae haung vae sah;</para>
  <para style="q1">atynpaw na sungsahnaw te</para>
  <para style="q2">na lungzinaw nynh amaw kha</para>
  <para style="q1">la rin vae sah!</para>
  <para style="q1">
    <verse number="8" style="v" />Bya ka kinkupaw kha nin kheit koute</para>
  <para style="q2">nin kheit ka pya lalia lante</para>
  <para style="q1">na min thehoysahnaw hlaw kha</para>
  <para style="q2">ka sah zungzae cih.</para>
  <chapter number="62" style="c" />
  <para style="s1">Pachia kyalya Doliakunaw Hlaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Ka muisaw nynh Pachia rou kha</para>
  <para style="q2">daebabi lan a ngaehoi;</para>
  <para style="q2">ka khumnaw tuh amaw kyate nynh yn thua.</para>
  <para style="q1">
    <verse number="2" style="v" />Pachia rou hynh nynh ka lungpi,</para>
  <para style="q2">ka khumnaw te ka khynnaw athua;</para>
  <para style="q1">kae tuh yn piasah kho lan khyh hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Nanning nynh hohseciamou</para>
  <para style="q2">lu kheitpaw kha na rawse ung cih oh?</para>
  <para style="q1">Vyavya pupaw lungrua,</para>
  <para style="q2">vyavya khuliakuhpaw tureih hawte</para>
  <para style="q1">athuapaw amaw kha</para>
  <para style="q2">nae balyn te hohseciamou</para>
  <para style="q2">na rawse cih oh?</para>
  <para style="q1">
    <verse number="4" style="v" />Tuh-e paw kha phu-e a ccounaw kyate</para>
  <para style="q2">sawbung lan a paccynku hae.</para>
  <para style="q1">Minmin tuh hynbya kyakhe</para>
  <para style="q2">mih lungrythua;</para>
  <para style="q1">mih khalang te hythuapya hae salamah</para>
  <para style="q2">mih lungkhu kyate thya a law hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Ka muisaw nynh Pachia rou kha</para>
  <para style="q2">daebabi lan a ngaehoi,</para>
  <para style="q1">pawccecize ka ngaehoinaw tuh</para>
  <para style="q2">amaw kya rou nynh a um.</para>
  <para style="q1">
    <verse number="6" style="v" />Amaw rou hynh nynh ka lungpi,</para>
  <para style="q2">ka khumnaw te ka khynnaw athua;</para>
  <para style="q2">kae tuh yn piasah kho lan khyh hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Ka luenaw te ka sung-enaw tuh</para>
  <para style="q2">Pachia kya nynh a um;</para>
  <para style="q1">athungpaw ka lungpi,</para>
  <para style="q2">ka khynnaw tuh Pachia nynh thua.</para>
  <para style="q1">
    <verse number="8" style="v" />Pou ccungccaw hae, Pachia kha</para>
  <para style="q2">doliakuh zungzae oh;</para>
  <para style="q1">nae thinlung kha amaw malang khe</para>
  <para style="q2">hungpah oh;</para>
  <para style="q1">Pachia tuh aening khynnaw nynh thua.</para>
  <para style="q1">
    <verse number="9" style="v" />Anyaapaw ccungccaw hae tuh</para>
  <para style="q2">ccungkia leipaw nynh thua hae,</para>
  <para style="q1">aly-asaepaw ccungccaw hae tuh</para>
  <para style="q2">a hynhupaw nynh thua hae;</para>
  <para style="q1">akhin sae lan hae ze,</para>
  <para style="q2">zawbahaepaw nynh thua hae;</para>
  <para style="q2">minmin tuh hy laeze a zawhua hae.</para>
  <para style="q1">
    <verse number="10" style="v" />Puathonaw kha doliakuh nan oh,</para>
  <para style="q2">Luadenaw kha ngaehoikuh nan oh;</para>
  <para style="q1">a hoirum hae paw nynh</para>
  <para style="q2">a hoithung hae ze doliakuh nan hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Pachia nynh vaekheit a ho vae;</para>
  <para style="q2">vaeningnaw ho zah ka thaepaw tuh:</para>
  <para style="q2">huhan tuh Pachia kya-e nynh thua,</para>
  <para style="q1">
    <verse number="12" style="v" />Pou <char style="nd">Bawipaw </char>, atynpaw</para>
  <para style="q2">sungsahnaw tuh na kya-e nynh thua.</para>
  <para style="q1">Ccungccaw balyn kha</para>
  <para style="q2">mih ryalawnaw thyhte na pyaru hae.<note caller="-" style="x"><char style="xo" closed="false">62.12: </char><char style="xt" closed="false"><ref loc="JOB 34:11">Job 34.11</ref>; <ref loc="JER 17:10">Jer 17.10</ref>; <ref loc="MAT 16:27">Mat 16.27</ref>; <ref loc="ROM 2:6">Rom 2.6</ref>; <ref loc="REV 2:23">Bya 2.23</ref></char></note></para>
  <chapter number="63" style="c" />
  <para style="s1">
    <note caller="-" style="x">
      <char style="xo" closed="false">63 Abyalu: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 23:14">1Sa 23.14</ref>
      </char>
    </note> Pachia kha Tui lang Hawnaw<note caller="+" style="f"><char style="fr" closed="false">63 Abyalu: </char><char style="ft" closed="false">David nynh Judea ramrou kya a um lya a phuapaw hlaw.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Pou Pachia, nang tuh ka Pachia nynh</para>
  <para style="q2">na thua, nang kha kae ccung,</para>
  <para style="q2">tui a um leinaw laerou kya hawte,</para>
  <para style="q1">ka muisaw nynh nang kha</para>
  <para style="q2">tui lang ae haw;</para>
  <para style="q2">ka pynsaw nynh nang kha ae ngae.</para>
  <para style="q1">
    <verse number="2" style="v" />Na huhan te na phu-enaw kha</para>
  <para style="q2">muih khylan beikinnthyaa kyakhe</para>
  <para style="q2">nang kha kae beik vae.</para>
  <para style="q1">
    <verse number="3" style="v" />Atynpaw na sungsahnaw tuh</para>
  <para style="q2">hiinnaw laeze ahoyhua keiccuze</para>
  <para style="q1">ka munglae nynh nang kha</para>
  <para style="q2">ae thehoysah cih.</para>
  <para style="q1">
    <verse number="4" style="v" />Tuhcite ka hiin lungkhu balyn</para>
  <para style="q2">nang kha kae thehoysah cih,</para>
  <para style="q1">ka kuih ka hang cih zah</para>
  <para style="q2">na min kha kae ko cih.</para>
  <para style="q1">
    <verse number="5-6" style="v" />Ka ikhung vawlan khe</para>
  <para style="q2">namaw konglang ka tua zah,</para>
  <para style="q2">nang kha khuazi he kae tuathui te,</para>
  <para style="q1">loohdangkunaw kya vueso hawte,</para>
  <para style="q2">ka muisaw tuh a vueso cih zah,</para>
  <para style="q1">alungtuapaw ka munglae nynh</para>
  <para style="q2">nang kha ae thehoysah cih;</para>
  <para style="q1">
    <verse number="7" style="v" />pawccecize nang tuh yn bawmtu</para>
  <para style="q2">na thua vae zah,</para>
  <para style="q1">na sake mynlyh kyakhe</para>
  <para style="q2">lungtuanaw hlaw ka sah.</para>
  <para style="q1">
    <verse number="8" style="v" />Ka muisaw tuh</para>
  <para style="q2">namaw kya beekuh zah,</para>
  <para style="q1">na ranglang kuih nynh kae kha</para>
  <para style="q2">yn thungkhaw.</para>
  <para style="q1">
    <verse number="9" style="v" />Thuasalama ka hiinnaw ro khylan</para>
  <para style="q2">yn ccung hae paw tuh</para>
  <para style="q2">lae kaw lang a rungbung cih hae;</para>
  <para style="q1">
    <verse number="10" style="v" />minmin tuh thaloi te</para>
  <para style="q2">chia athua cih hae zah,</para>
  <para style="q2">suizaw hae looh athua cih hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Thuasalama siapharan tuh Pachia kya</para>
  <para style="q2">a lungpaw cih;</para>
  <para style="q1">Pachia min te bya a kinkuh hae paw tuh</para>
  <para style="q2">mih lungtua cih,</para>
  <para style="q1">pawccecize mihyn hae khalang tuh</para>
  <para style="q2">myhsah athua cih.</para>
  <chapter number="64" style="c" />
  <para style="s1">Thungkhawnaw elang Sawsangnaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou Pachia, vawsawnaw ka tung lya,</para>
  <para style="q2">ka sawsangnaw hynh yn thaepya tua;</para>
  <para style="q1">ri lan umpaw rhaw hae kyate</para>
  <para style="q2">ka hiinnaw hynh yn khynsah tua.</para>
  <para style="q1">
    <verse number="2" style="v" />Ccungccaw hoylei hae paw nynh</para>
  <para style="q2">aruh lante khuakhankunaw hae kyate thuasah,</para>
  <para style="q1">hoyleinaw a rae hae paw</para>
  <para style="q2">paccynkunaw kyate thuasah</para>
  <para style="q2">yn thuruhtua.</para>
  <para style="q1">
    <verse number="3" style="v" />tuh-e hae tuh mih lae kha</para>
  <para style="q2">thaloi hawte a taw hae,</para>
  <para style="q1">bya khahpaw kha the hawte</para>
  <para style="q2">a kawnaw ry hae,</para>
  <para style="q1">
    <verse number="4" style="v" />A buhkhawnaw hae kyate</para>
  <para style="q2">ccaenaw a um leipaw kha a kaw hae;</para>
  <para style="q2">ri leite palou a kaw hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Ahoy leipaw mih eenaw kha</para>
  <para style="q2">tynkaring lan a kyngku hae;</para>
  <para style="q1">aruh lante kaang syakhawnaw kong kha</para>
  <para style="q2">hokuh hae zah,</para>
  <para style="q1">“Hum nynh mou aening hynh oun muih?</para>
  <para style="q2">
    <verse number="6" style="v" />Hoyleinaw ah rae oh paw hynh</para>
  <para style="q2">hum nynh mou oun nyh kho cih?</para>
  <para style="q1">Athyaruhpaw paccynkunaw khua kha</para>
  <para style="q2">phe ah khan vae oh,” a ciku hae.</para>
  <para style="q1">Pawccecize ccungccaw thinlung te</para>
  <para style="q2">tuakunaw tuh kou akhu.</para>
  <para style="q1">
    <verse number="7" style="v" />Thuasalama Pachia nynh a the te</para>
  <para style="q2">minmin kha a kaw cih hae zah,</para>
  <para style="q2">vaemaw palou a mue cih hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Mih lae nynh mimaw kha ronaw kalan</para>
  <para style="q2">a cciakhae cih hae;</para>
  <para style="q1">minmin kha a muih hae paw balyn tuh</para>
  <para style="q2">rinaw te a thyngkuh cih hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Tetuh ccungccaw miakaw a rih cih hae;</para>
  <para style="q2">Pachia nynh a cyipaw kong kha</para>
  <para style="q1">minmin nynh a ho cih hae zah,</para>
  <para style="q2">a cyipaw kha a tua cih hae.</para>
  <para style="q1">
    <verse number="10" style="v" />Miding hae tuh <char style="nd">Bawipaw </char> kya</para>
  <para style="q2">mih lungtua sah lah,</para>
  <para style="q1">amaw kya rekuh hae sah.</para>
  <para style="q2">Miding balyn nynh mih thinlung te</para>
  <para style="q1">thehoysah hae sah.</para>
  <chapter number="65" style="c" />
  <para style="s1">Luungnaw te Thehoysahnaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou Pachia, Zion kya</para>
  <para style="q2">kae thehoysah cih;</para>
  <para style="q1">na kalan bya kae kinkupaw kha</para>
  <para style="q2">kae ccingsah cih,</para>
  <para style="q1">
    <verse number="2" style="v" />sawsangnaw a leihtupaw Pachia!</para>
  <para style="q2">Ccungccaw balyn tuh na kalan</para>
  <para style="q2">oun thua cih hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Ahoy leipaw cyisahnaw nynh</para>
  <para style="q2">kaening kha he oun tae tuh,</para>
  <para style="q2">kae cyiseimenaw kha nae ngaethya.</para>
  <para style="q1">
    <verse number="4" style="v" />Na voidu lungkhu um khylan</para>
  <para style="q2">na po hae zah, na naesaku hae paw</para>
  <para style="q1">ccungccaw hae tuh</para>
  <para style="q2">lungtua hae paw nynh thua.</para>
  <para style="q1">Athyaapaw na beikinn athuapaw</para>
  <para style="q2">na inn kya-e ahoypaw</para>
  <para style="q1">uccaw khate phe kae byn cih.</para>
  <para style="q1">
    <verse number="5" style="v" />Pou oun khumtupaw Pachia,</para>
  <para style="q2">ri lan umpaw cyisahnaw te</para>
  <para style="q1">kaening kha nae leih zah nae luesah;</para>
  <para style="q2">nang tuh laephi adianaw balyn kya te</para>
  <para style="q1">asaw huanaw rili kin kya um hae paw</para>
  <para style="q2">mih ngaehoinaw nynh na thua.</para>
  <para style="q1">
    <verse number="6" style="v" />Na thawzung te mua hae kha</para>
  <para style="q2">na tynsah hae; tuhcite nang tuh</para>
  <para style="q2">thungnaw te phe na beih.</para>
  <para style="q1">
    <verse number="7" style="v" />Rili a ccaepaw roi,</para>
  <para style="q2">tuileih a ccaepaw roi te</para>
  <para style="q1">ccungccaw hae nynh</para>
  <para style="q2">a siaruanaw hae kha na daesah.</para>
  <para style="q1">
    <verse number="8" style="v" />Laephi asaw huanaw kya um hae paw tuh</para>
  <para style="q2">na muihsahnaw hae keiccuze a rih hae;</para>
  <para style="q1">khuanin athuanaw kya te a ccawnaw kya</para>
  <para style="q2">lungtuate na siasah hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Laephi kha na do-oih zah</para>
  <para style="q2">khuaa na rawsahpya,</para>
  <para style="q2">myarya na hoirumsah;</para>
  <para style="q1">Pachia vawkhu tuh tui te phe abeih;</para>
  <para style="q2">ccungccaw hae kha looh te</para>
  <para style="q1">na bawm hae,</para>
  <para style="q2">tuh-e tuh na paccynpaw nynh thua.</para>
  <para style="q1">
    <verse number="10" style="v" />Athuekuh vae paw leikua kyakhe</para>
  <para style="q2">khuaa patae na rawsah,</para>
  <para style="q2">leikua kha na nginsah,</para>
  <para style="q1">laephi kha khuaatui te na nesah zah,</para>
  <para style="q2">apopaw ccacii kha hythua na pya.</para>
  <para style="q1">
    <verse number="11" style="v" />Na hoynaw khate kum kha</para>
  <para style="q2">looh na voisah;</para>
  <para style="q1">na ccianaw miakaw kya</para>
  <para style="q2">looh patae a um.</para>
  <para style="q1">
    <verse number="12" style="v" />Sahiin rampaeenaw patae a um,</para>
  <para style="q2">mua hae tuh lungtuanaw te</para>
  <para style="q2">phe abeih hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Ramnonaw miakaw kya tuu hae,</para>
  <para style="q2">miaa hae te phe abeih,</para>
  <para style="q1">abuenaw kyakhe ccathae te phe abeih,</para>
  <para style="q2">lungtuate sia hae zah</para>
  <para style="q1">pynkheihlan hlaw a sah hae.</para>
  <chapter number="66" style="c" />
  <para style="s1">Pachia Hoynaw Thehoysahnaw</para>
  <para style="d">Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Laephi ccungccaw hae balyn,</para>
  <para style="q2">Pachia kalan lungtuate sia oh;</para>
  <para style="q1">
    <verse number="2" style="v" />a min phu-esahnaw hlaw kha sah oh;</para>
  <para style="q2">aphu-epaw thehoysahnaw kha</para>
  <para style="q2">amaw kalan pya oh.</para>
  <para style="q1">
    <verse number="3" style="v" />Pachia kalan khe, “Na cyipaw uccaw hae hynh</para>
  <para style="q2">pawcih baban mou ngaeang lan a um!</para>
  <para style="q1">Na huhan tuh myarya ale keiccuze,</para>
  <para style="q2">na rhaw hae tuh na malang rawrite</para>
  <para style="q2">a bakhung hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Laephi ccungccaw hae balyn nynh</para>
  <para style="q2">nang kha ae beik hae;</para>
  <para style="q1">namaw thehoysahnaw hlaw kha</para>
  <para style="q2">a sah hae,</para>
  <para style="q1">na min thehoysahnaw hlaw kha</para>
  <para style="q2">a sah hae,” cite ho oh.</para>
  <para style="q1">
    <verse number="5" style="v" />Rang oh lah, Pachia nynh</para>
  <para style="q2">a cyipaw hynh dotua oh:</para>
  <para style="q1">ccungccaw hae kya a cyipaw balyn tuh</para>
  <para style="q2">ngaeangthua lan a um.</para>
  <para style="q1">
    <verse number="6" style="v" />Rili kha laerou lang a tangsah;</para>
  <para style="q2">ah minpaaw hae nynh vawpi kha</para>
  <para style="q2">mih ccu te a zua hae.</para>
  <para style="q1">Tuin kyakhe aening tuh</para>
  <para style="q2">amaw tungvaw ah lungtua,<note caller="-" style="x"><char style="xo" closed="false">66.6: </char><char style="xt" closed="false"><ref loc="EXO 14:21">Exo 14.21</ref>; <ref loc="JOS 3:14-17">Jos 3.14-17</ref></char></note></para>
  <para style="q1">
    <verse number="7" style="v" />a thungnaw liate zungzae a uk,</para>
  <para style="q2">a mit nynh minphuin hae kha riri a do hae,</para>
  <para style="q1">kaw-ei hae paw nynh mimaw te</para>
  <para style="q2">mimaw kha hokuhthung nan hae sah.</para>
  <para style="q1">
    <verse number="8" style="v" />Pou ccungccaw hae, ah Pachia kha</para>
  <para style="q2">thehoysah oh,</para>
  <para style="q1">amaw thehoysahnaw roi kha</para>
  <para style="q2">thae hae sah,</para>
  <para style="q1">
    <verse number="9" style="v" />amaw nynh a hiin hae paw laku kya</para>
  <para style="q2">oun do-oih zah,</para>
  <para style="q2">ah ccu kha theisah khyh.</para>
  <para style="q1">
    <verse number="10" style="v" />Pou Pachia, nang nynh</para>
  <para style="q2">kaening kha nae syntawtua;</para>
  <para style="q1">ngun kha maee te a syntawtua hae hawte</para>
  <para style="q2">kaening kha nae syntawtua vae.</para>
  <para style="q1">
    <verse number="11" style="v" />Kaening kha kaang nae kaesah vae;</para>
  <para style="q2">kae ke kya phupaw ripaw nae khang vae;</para>
  <para style="q1">
    <verse number="12" style="v" />ccungccaw hae kha kae lu vawlan</para>
  <para style="q2">na ccisaku vae hae;</para>
  <para style="q2">maee te tui kyakhe kae cceih;</para>
  <para style="q1">tuhzemah kaening kha</para>
  <para style="q2">hoirumnaw hmin kya nae thuasah vae.</para>
  <para style="q1">
    <verse number="13" style="v" />Maee-ute silawnaw kha ccyngte</para>
  <para style="q2">na inn lungkhu lang ka cceih cih;</para>
  <para style="q2">bya ka kinkupaw kha kae pya cih,</para>
  <para style="q1">
    <verse number="14" style="v" />Vawsawnaw ka tung lyaze</para>
  <para style="q2">ka mung nynh ho zah,</para>
  <para style="q1">ka khalang nynh bya a kinkupaw kha</para>
  <para style="q2">kae pya cih.</para>
  <para style="q1">
    <verse number="15" style="v" />Athopaw tuu hae kha</para>
  <para style="q2">mynkhuhpaw ryte</para>
  <para style="q1">namaw kalan maee-ute</para>
  <para style="q2">silawnaw ka rae cih;</para>
  <para style="q1">tangnuapaw te miaa hae khate</para>
  <para style="q2">silawnaw ka rae cih.</para>
  <para style="q1">
    <verse number="16" style="v" />Pachia rawrih hae paw balyn,</para>
  <para style="q2">rang oh lah, ngaetua oh,</para>
  <para style="q1">ka hanlan yn cyipyapaw kha</para>
  <para style="q2">kae hopah cih oh.</para>
  <para style="q1">
    <verse number="17" style="v" />Amaw kalan thawte ka sia zah,</para>
  <para style="q2">ka lae te amaw kha the ka hoysah.</para>
  <para style="q1">
    <verse number="18" style="v" />Ka thinlung kya hoyleinaw kha</para>
  <para style="q2">ka la tua ry lanze,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh yn ngaepah lan khyh.</para>
  <para style="q1">
    <verse number="19" style="v" />Thuasalama Pachia nynh</para>
  <para style="q2">yn ngaepya ccaccing;</para>
  <para style="q1">ka sawsangnaw roi kha yn ngaepya vae.</para>
  <para style="q1">
    <verse number="20" style="v" />Ka sawsangnaw kha yn vuapah khyh zah,</para>
  <para style="q2">atynpaw a sungsahnaw kha ka kyate</para>
  <para style="q1">a nue khyh keiccuze Pachia kha</para>
  <para style="q2">ka thehoysah.</para>
  <chapter number="67" style="c" />
  <para style="s1">Thehoysahnaw Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pachia nynh aening kha</para>
  <para style="q2">thaw oun ccih sah lah,</para>
  <para style="q1">hythua oun pya vae sah,</para>
  <para style="q2">te a mitmae tuh aening tungvaw</para>
  <para style="q2">awsah vae sah,</para>
  <para style="q1">
    <verse number="2" style="v" />tuhcite laephi ccungccaw hae nynh</para>
  <para style="q2">na laanpi kha a nyh cih hae zah,</para>
  <para style="q1">minphuin balyn nynh na khumnaw</para>
  <para style="q2">huhan kha a nyh cih hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Pou Pachia, ccungccaw hae nynh</para>
  <para style="q2">nang kha ae thehoysah hae sah;</para>
  <para style="q1">ccungccaw hae balyn nynh</para>
  <para style="q2">ae thehoysah hae sah.</para>
  <para style="q1">
    <verse number="4" style="v" />Minphuin hae tuh mih lungtua sah lah,</para>
  <para style="q2">lungtuate hlawsah hae sah,</para>
  <para style="q1">pawccecize ccungccaw hae kha</para>
  <para style="q2">dingnaw te bya na pia hae zah,</para>
  <para style="q1">laephi vawlan e minphuin hae kha</para>
  <para style="q2">laan na mawpya hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Pou Pachia, ccungccaw hae nynh</para>
  <para style="q2">nang kha ae thehoysah hae sah;</para>
  <para style="q1">ccungccaw hae balyn nynh</para>
  <para style="q2">ae thehoysah hae sah.</para>
  <para style="q1">
    <verse number="6" style="v" />Laephi nynh looh kha a pousah vae;</para>
  <para style="q2">Pachia, ah Pachia nynh</para>
  <para style="q2">hythua oun pya vae.</para>
  <para style="q1">
    <verse number="7" style="v" />Pachia nynh aening kha</para>
  <para style="q2">hythuanaw po oun pya vae sah.</para>
  <para style="q1">laephi adianaw cia um hae paw</para>
  <para style="q2">ccungccaw hae balyn nynh amaw kha</para>
  <para style="q1">sawtua hae sah.</para>
  <chapter number="68" style="c" />
  <para style="s1">Thehoysahnaw te Lungtuanaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pachia tuh thokuh sah lah,</para>
  <para style="q2">a rhaw hae tuh phiariphiarae um hae sah;</para>
  <para style="q1">amaw a hua hae paw tuh</para>
  <para style="q2">amaw malang khe ccue hae sah.</para>
  <para style="q1">
    <verse number="2" style="v" />Maeekhuh kha khisan nynh</para>
  <para style="q2">a mung hawte, minmin kha</para>
  <para style="q1">ccaring a mung hae;</para>
  <para style="q2">khoilung tuh maee malang</para>
  <para style="q2">palae atui hawte,</para>
  <para style="q1">ccungccaw hoylei hae paw tuh</para>
  <para style="q2">Pachia malang roh hae sah.</para>
  <para style="q1">
    <verse number="3" style="v" />Thuasalama miding hae tuh</para>
  <para style="q2">mih lungtua sah lah,</para>
  <para style="q1">Pachia malang mih lung myarya tua sah;</para>
  <para style="q2">lungtua lungpawte um hae sah.</para>
  <para style="q1">
    <verse number="4" style="v" />Pachia kalan hlawsah oh,</para>
  <para style="q2">amaw min kha thehoysahnaw hlawsah oh;</para>
  <para style="q1">maeking vawlan a ccikuhpaw kha</para>
  <para style="q2">hlawsahpah oh,<note caller="+" style="f"><char style="fr" closed="false">68.4 </char><char style="fq">ramkaw kya po a ccikuhpaw hanlan laanpi raepah oh</char> cite mah ci kho athua</note></para>
  <para style="q1">a min tuh <char style="nd">Bawipaw </char> nynh thua,</para>
  <para style="q2">amaw malang nae lungtua sah.</para>
  <para style="q1">
    <verse number="5" style="v" />Ngawraw hae paaw thua zah,</para>
  <para style="q2">nomae hae kha</para>
  <para style="q2">a thungkhaw hae paw tuh</para>
  <para style="q1">a beikinnthyaa kya a umpaw</para>
  <para style="q2">Pachia nynh thua.</para>
  <para style="q1">
    <verse number="6" style="v" />Pachia nynh vaevui zah</para>
  <para style="q2">a lanmepaw ccungccaw kha</para>
  <para style="q1">umnaw inn a pya;</para>
  <para style="q2">thongccah hae paw kha</para>
  <para style="q1">hoirumnaw kalan a cciakhae hae,</para>
  <para style="q2">thuasalama kaw-ei hae paw kha tuh</para>
  <para style="q1">ramrou kya a um hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Pou Pachia, na ccungccaw hae malang</para>
  <para style="q2">na cceih zah, ramkaw kya</para>
  <para style="q2">po he na cciakhae hae te,</para>
  <para style="q1">
    <verse number="8" style="v" />laephi tuh hy zah, vaawlui kyate</para>
  <para style="q2">khuaa arah,</para>
  <para style="q1">tuh-e tuh Sinai Pachia,</para>
  <para style="q2">Pachia a umnaw, Israel Pachia,</para>
  <para style="q2">Pachia a umnaw kya nynh thua.<note caller="-" style="x"><char style="xo" closed="false">68.8: </char><char style="xt" closed="false"><ref loc="EXO 19:18">Exo 19.18</ref></char></note></para>
  <para style="q1">
    <verse number="9" style="v" />Pou Pachia, khuaa patae na rawsah zah,</para>
  <para style="q2">na rho athuapaw ram arou vae paw kha</para>
  <para style="q2">ramnopaw lang bua na tangsah.</para>
  <para style="q1">
    <verse number="10" style="v" />tuin kyakhe na ccungccaw hae nynh</para>
  <para style="q2">umnaw a muihku hae;</para>
  <para style="q1">Pou Pachia, na hoynaw liate</para>
  <para style="q2">ryachi hae kha na bawm hae.</para>
  <para style="q1">
    <verse number="11" style="v" />
    <char style="nd">Bawipaw </char> nynh kaw a pya hae;</para>
  <para style="q2">tuh-e thongpang tuh nopi phu hae nynh</para>
  <para style="q2">cciakhae hae zah:</para>
  <para style="q1">
    <verse number="12" style="v" />“Rhawkaw hae mih siapharan hae tuh</para>
  <para style="q2">phe ccue hae!” a ci hae.</para>
  <para style="q1">Inn kya umpaw nopi hae nynh</para>
  <para style="q2">a luade hae paw uccaw hae kha</para>
  <para style="q1">a neeku hae,</para>
  <para style="q2">
    <verse number="13" style="v" />tuh-e uccaw hae tuh</para>
  <para style="q2">tuukhia lungkhu a um hae zemah,</para>
  <para style="q1">ngun te theikuhpaw vahu sake hawte</para>
  <para style="q2">thua hae zah,</para>
  <para style="q1">sui ahinpaw te theikuhpaw</para>
  <para style="q2">aming hawte mah athua hae.</para>
  <para style="q1">
    <verse number="14" style="v" />Athunghuapaw Pachia nynh</para>
  <para style="q2">siapharan hae he a phianaw hae tuh</para>
  <para style="q1">Zalmon Mua vawlan</para>
  <para style="q2">accahpaw vuiraw hawte nynh thua.</para>
  <para style="q1">
    <verse number="15" style="v" />Pou alesaepaw mua, Bashan mua,</para>
  <para style="q2">ahangpaw sangpyng patae</para>
  <para style="q2">a hoipaw mua, Bashan mua!</para>
  <para style="q1">
    <verse number="16" style="v" />Ahangpaw sangpyng patae</para>
  <para style="q2">a umpaw mua nynh,</para>
  <para style="q1">Pachia nynh um nawlan a rypaw mua,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh zungzae</para>
  <para style="q1">a umnaw lanpaw mua kha</para>
  <para style="q2">pawccemou na eiung?</para>
  <para style="q1">
    <verse number="17" style="v" />Athungpaw marangle athong-asan te</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> tuh Sinai Mua kyate</para>
  <para style="q2">hmin thyaa lungkhu lang a tee.</para>
  <para style="q1">
    <verse number="18" style="v" />
    <char style="nd">Bawipaw </char> tuh ahangnaw langkhe kae zah,</para>
  <para style="q2">kyngpaw ccungccaw hae kha</para>
  <para style="q1">ataruinte a cciakhae hae,</para>
  <para style="q2">ccungccaw hae kyate thuasah,</para>
  <para style="q1">amaw a dou hae paw kyate heize</para>
  <para style="q2">thuasah lasung a mue,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> Pachia tuh tuin kya</para>
  <para style="q2">a um cih.<note caller="-" style="x"><char style="xo" closed="false">68.18: </char><char style="xt" closed="false"><ref loc="EPH 4:8">Efe 4.8</ref></char></note></para>
  <para style="q1">
    <verse number="19" style="v" />Nin takyh aening phupaw oun phupahpaw</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> tuh thehoyte um sah;</para>
  <para style="q2">Pachia tuh aening khumnaw nynh thua.</para>
  <para style="q1">
    <verse number="20" style="v" />Ah Pachia tuh khumnaw Pachia nynh thua,</para>
  <para style="q2">chinaw kyate luenaw tuh PACHIA,</para>
  <para style="q1">Bawipaw kya-e nynh thua.</para>
  <para style="q1">
    <verse number="21" style="v" />Thuasalama Pachia nynh</para>
  <para style="q2">a rhaw hae lu kha thuasah,</para>
  <para style="q1">seinaw laanpi a zui hae paw lu kha thuasah</para>
  <para style="q2">a koi ccaccing cih hae.</para>
  <para style="q1">
    <verse number="22" style="v" />Bawipaw nynh,</para>
  <para style="q2">“Minmin kha Bashan kyate</para>
  <para style="q2">ka kikhae cih hae,</para>
  <para style="q1">minmin kha rili akhupaw kyate</para>
  <para style="q2">ka kikhae cih hae,</para>
  <para style="q1">
    <verse number="23" style="v" />tuhteze nynh na rhaw hae</para>
  <para style="q2">chii kyakhe na ke cih,</para>
  <para style="q1">na ui hae nynh mah mih ry zeihte</para>
  <para style="q2">a lya cih hae,” a ci.</para>
  <para style="q1">
    <verse number="24" style="v" />Pou Pachia, huhan te na cciapaw kha</para>
  <para style="q2">muih athua vae,</para>
  <para style="q1">ka Pachia, ka Siapharan nynh</para>
  <para style="q2">beikinnthyaa lungkhu lang</para>
  <para style="q2">a teepaw kha muih athua vae,</para>
  <para style="q1">
    <verse number="25" style="v" />malang te hlawsah hae paw,</para>
  <para style="q2">nulang te a khuathya hae paw,</para>
  <para style="q1">tuh-e hae laku khe tyng a khua hae paw</para>
  <para style="q2">nopi hae a cceih hae:</para>
  <para style="q1">
    <verse number="26" style="v" />“Ccungccaw zapi pumkunaw kyakhe</para>
  <para style="q2">Pachia kha thehoysah oh,</para>
  <para style="q1">Pou Israel ciihan hae, <char style="nd">Bawipaw </char> kha</para>
  <para style="q2">thehoysah oh!”</para>
  <para style="q1">
    <verse number="27" style="v" />Malang kou khe, minmin lakuze</para>
  <para style="q2">asoi huapaw Benjamin phin hae</para>
  <para style="q1">a cceih hae,</para>
  <para style="q2">te Judah phin cciakhaetu hae te</para>
  <para style="q1">mih ccungccaw hae,</para>
  <para style="q2">Zebulun phin cciakhaetu hae te</para>
  <para style="q2">Naftali phin cciakhaetu hae nynh a zui hae.</para>
  <para style="q1">
    <verse number="28" style="v" />Pou Pachia, na thungnaw kha</para>
  <para style="q2">langsaku tua;</para>
  <para style="q1">Pou Pachia, langmawlya kaening elang</para>
  <para style="q2">nae cyipya vae hawte,</para>
  <para style="q2">na thawzung kha langsaku tua.</para>
  <para style="q1">
    <verse number="29" style="v" />Jerusalem khua umpaw</para>
  <para style="q2">na Beikinnpi liate</para>
  <para style="q1">siapharan hae nynh na kalan</para>
  <para style="q2">lasung ae ccyngpya hae.</para>
  <para style="q1">
    <verse number="30" style="v" />Phaeku laku a umpaw</para>
  <para style="q2">ramsaw hae kha thuasah,</para>
  <para style="q1">vaetua anopaw phu kha</para>
  <para style="q2">minphuin hae kya-e vaetua</para>
  <para style="q1">ano hae paw kha thuasah thuihei hae.</para>
  <para style="q2">ngunphua myarya a duaa hae paw kha syde hae;</para>
  <para style="q1">rhawtuknaw kya mih lungrythuapaw</para>
  <para style="q2">minphuin hae kha phiariphiarae nung hae.</para>
  <para style="q1">
    <verse number="31" style="v" />Izip ram kyate sawpaw locceihtu hae</para>
  <para style="q2">oun thua cih hae;</para>
  <para style="q2">Ethiopia ccungccaw hae nynh</para>
  <para style="q1">Pachia kalan mih kuih kha</para>
  <para style="q2">arangte dyng hae sah.</para>
  <para style="q1">
    <verse number="32" style="v" />Pou laephi peenaw hae,</para>
  <para style="q2">Pachia kalan hlawsah oh;</para>
  <para style="q1">
    <verse number="33" style="v" />Pou vaawlui a ccikuhpaw,</para>
  <para style="q2">arynpaw vaawlui hae,</para>
  <para style="q1">Bawipaw kalan thehoysahnaw</para>
  <para style="q2">hlawsah oh;</para>
  <para style="q1">amaw roi, athungpaw roi a sawpaw kha</para>
  <para style="q2">ngaetua oh.</para>
  <para style="q1">
    <verse number="34" style="v" />Pachia huhan tuh ahoy cite hotua oh,</para>
  <para style="q2">a lesaenaw tuh Israel hae tungvaw a um;</para>
  <para style="q2">a huhan tuh vaawlui kya a um.</para>
  <para style="q1">
    <verse number="35" style="v" />Pachia, Israel Pachia tuh</para>
  <para style="q2">a beikinnthyaa kya</para>
  <para style="q1">ri lan umpaw nynh thua;</para>
  <para style="q2">a ccungccaw hae kha huhan te</para>
  <para style="q1">thawzung a pya hae.</para>
  <para style="q1">Pachia tuh thehoysah thua sah!</para>
  <chapter number="69" style="c" />
  <para style="s1">Luenaw hanlan Sawsangnaw<note caller="+" style="f"><char style="fr" closed="false">69 Abyalu: </char><char style="ft" closed="false">David nynh a phuapaw.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Pou Pachia, beih yn khumtua,</para>
  <para style="q2">pawccecize tui nynh ka nging kyacia</para>
  <para style="q2">yn vu vae.</para>
  <para style="q1">
    <verse number="2" style="v" />Ccusy um leinaw akhupaw tuiccua nynh</para>
  <para style="q2">yn sungkhaekuh zah,</para>
  <para style="q1">akhupaw tui lungkhu lang ka phungkuh,</para>
  <para style="q2">tuileih nynh yn thothin.</para>
  <para style="q1">
    <verse number="3" style="v" />Ka siaruanaw ze phe ka bang;</para>
  <para style="q2">ka lotharue phe rou vae.</para>
  <para style="q1">Ka Pachia ka dokhawnaw ze</para>
  <para style="q2">ka mit mah ngaw hoyte</para>
  <para style="q1">ka muih vae khyh.</para>
  <para style="q1">
    <verse number="4" style="v" />Akonglang um leite yn hua hae paw tuh</para>
  <para style="q2">ka lu kya-e ka sangrua laeze a lunghua hae,</para>
  <para style="q1">Kae kha ro lan yn ry hae paw tuh</para>
  <para style="q2">myarya a lung hae,</para>
  <para style="q1">ahme lei lante sei yn be hae paw</para>
  <para style="q2">ka rhaw hae tuh mih thaw asae.</para>
  <para style="q1">Ka ru leipaw uccaw kha</para>
  <para style="q2">ka rung hahe cih tou?<note caller="-" style="x"><char style="xo" closed="false">69.4: </char><char style="xt" closed="false"><ref loc="PSA 35:19">Sam 35.19</ref>; <ref loc="JHN 15:25">Joh 15.25</ref></char></note></para>
  <para style="q1">
    <verse number="5" style="v" />Pou Pachia, ka ngaeenaw kha</para>
  <para style="q2">phe na ny;</para>
  <para style="q1">ka la mesei hae paw kha na kyate</para>
  <para style="q2">thuruh kho thua khyh.</para>
  <para style="q1">
    <verse number="6" style="v" />Pou vaaw Bawipaw Pachia,</para>
  <para style="q2">nang ae ngaehoikuh hae paw tuh</para>
  <para style="q1">kae ka keiccuze maethyanaw</para>
  <para style="q2">mue nan hae sah;</para>
  <para style="q1">Pou Israel Pachia,</para>
  <para style="q2">nang ae ccung hae paw tuh</para>
  <para style="q1">kae ka keiccuze thethyanaw</para>
  <para style="q2">mue nan hae sah.</para>
  <para style="q1">
    <verse number="7" style="v" />Nang keiccuze saryanaw ka mue zah,</para>
  <para style="q2">maethyanaw nynh</para>
  <para style="q2">ka mae phang yn bong.</para>
  <para style="q1">
    <verse number="8" style="v" />Ka uno hae kya mikhiapaw lang</para>
  <para style="q2">ka tang vae zah,</para>
  <para style="q1">ka nung ccaaw hae kya</para>
  <para style="q2">ramccangpaw lang ka tang vae.</para>
  <para style="q1">
    <verse number="9" style="v" />Na inn elang ka lungzuanaw nynh</para>
  <para style="q2">kae kha phe yn ae;</para>
  <para style="q1">nang ae saryatu hae paw nynh</para>
  <para style="q2">ae saryanaw hae paw bya tuh</para>
  <para style="q2">ka tungvaw accah vae.<note caller="-" style="x"><char style="xo" closed="false">69.9: </char><char style="xt" closed="false"><ref loc="JHN 2:17">Joh 2.17</ref>; <ref loc="ROM 15:3">Rom 15.3</ref></char></note></para>
  <para style="q1">
    <verse number="10" style="v" />Looh-ae sungnaw te</para>
  <para style="q2">ka thinlung zakaw he ka sangsakuh tuh,</para>
  <para style="q2">minmin nynh yn theihrya vae hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Buriboei he ka zingkuh tuh,</para>
  <para style="q2">minmin nynh yn sarya hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Laanluepi kya ka thethya yn ho hae zah,</para>
  <para style="q2">a zu a ae hae paw nynh hlaw yn phua hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Thuasalama, pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">kae tuh namaw kalan saw ka sang.</para>
  <para style="q1">Pou Pachia, atynpaw na sungsahnaw</para>
  <para style="q2">alepaw khate,</para>
  <para style="q1">na ccansaku ccyh khe beih yn leih.</para>
  <para style="q2">A lungzipaw na bawmnaw khate,</para>
  <para style="q1">
    <verse number="14" style="v" />tuiccua lungkhu lang ccawnaw kyate</para>
  <para style="q2">beih yn khum;</para>
  <para style="q1">ka rhaw hae kyate thuasah,</para>
  <para style="q2">akhupaw tui kyate thuasah</para>
  <para style="q2">yn luesah.</para>
  <para style="q1">
    <verse number="15" style="v" />Tuileih nynh ka tungvaw</para>
  <para style="q2">yn thothin nan sah,</para>
  <para style="q1">akhupaw tui lungkhu lang ka ccah nan sah,</para>
  <para style="q2">Hunghua nynh a lungkhu kya</para>
  <para style="q1">kae kha yn huthin nan sah.</para>
  <para style="q1">
    <verse number="16" style="v" />Pou <char style="nd">Bawipaw </char>, atynpaw</para>
  <para style="q2">na sungsahnaw tuh</para>
  <para style="q2">ahoy keiccuze yn leihtua,</para>
  <para style="q1">myarya lepaw na thawccinaw thyhte</para>
  <para style="q2">ka kalan yn maeleihku tua.</para>
  <para style="q1">
    <verse number="17" style="v" />Na seepaw kyate na mae kha</para>
  <para style="q2">ccanglang yn hawitaw nan,</para>
  <para style="q1">pawccecize vawsawnaw ka tung,</para>
  <para style="q2">arangte yn leihtua.</para>
  <para style="q1">
    <verse number="18" style="v" />Ka kalan yn naekuh lah,</para>
  <para style="q2">yn shawkhawtua,</para>
  <para style="q1">ka rhaw hae kyate yn luesah tua.</para>
  <para style="q1">
    <verse number="19" style="v" />Ka teingpaw theihryanaw,</para>
  <para style="q2">maethyanaw te</para>
  <para style="q1">thethyanaw kha phe na ny;</para>
  <para style="q2">ka rhaw hae kha phe na ny hae.</para>
  <para style="q1">
    <verse number="20" style="v" />Theihryanaw nynh ka thinlung kha</para>
  <para style="q2">phe yn koi zah, lungrote ka um.</para>
  <para style="q1">Ngaethyaumsahnaw kha ka ccungku zemah</para>
  <para style="q2">ka muihkuh khyh;</para>
  <para style="q1">ngaengansahtu hae kha</para>
  <para style="q2">ka ccungku zemah ka muihkuh khyh.</para>
  <para style="q1">
    <verse number="21" style="v" />Minmin nynh sy kha</para>
  <para style="q2">looh lang yn pya hae,</para>
  <para style="q1">ka tuihaw zah misutui ariapaw kha</para>
  <para style="q2">nia lan yn pya hae.<note caller="-" style="x"><char style="xo" closed="false">69.21: </char><char style="xt" closed="false"><ref loc="MAT 27:48">Mat 27.48</ref>; <ref loc="MRK 15:36">Mar 15.36</ref>; <ref loc="LUK 23:36">Luk 23.36</ref>; <ref loc="JHN 19:28-29">Joh 19.28-29</ref></char></note></para>
  <para style="q1">
    <verse number="22" style="v" />Mih ccaboi tuh minmin hanlan</para>
  <para style="q2">kaang thua sah lah,</para>
  <para style="q1">minmin te a hobung hae paw hanlan</para>
  <para style="q2">taphung thua sah.<note caller="-" style="x"><char style="xo" closed="false">69.22-23: </char><char style="xt" closed="false"><ref loc="ROM 11:9-10">Rom 11.9-10</ref></char></note></para>
  <para style="q1">
    <verse number="23" style="v" />Mih mit tuh ngaw a muih kho</para>
  <para style="q2">lei lan moh sah lah,</para>
  <para style="q2">mih tae tuh po thyngkuh sah.</para>
  <para style="q1">
    <verse number="24" style="v" />Na thinrianaw khate mih tungvaw</para>
  <para style="q2">bu hae lah,</para>
  <para style="q1">aruapaw na thin-unaw nynh</para>
  <para style="q2">phe phah hae sah.</para>
  <para style="q1">
    <verse number="25" style="v" />Mih ryahmin tuh ccungccaw dae sah lah,</para>
  <para style="q2">mih bu kya lu kheit san um nan hae sah.<note caller="-" style="x"><char style="xo" closed="false">69.25: </char><char style="xt" closed="false"><ref loc="ACT 1:20">Loc 1.20</ref></char></note></para>
  <para style="q1">
    <verse number="26" style="v" />Pawccecize de na tah vae hae paw kha</para>
  <para style="q2">a tuaa a sah hae,</para>
  <para style="q1">vaemaw na muesah vae hae paw kha</para>
  <para style="q2">mah a buachih hae.</para>
  <para style="q1">
    <verse number="27" style="v" />Mih seinaw kyakhe seinaw kha</para>
  <para style="q2">biachihpah hae lah,</para>
  <para style="q2">na kyate seithyaanaw mue nan hae sah.</para>
  <para style="q1">
    <verse number="28" style="v" />Hiinnaw ccazing kyate</para>
  <para style="q2">minmin kha the thua hae sah;</para>
  <para style="q1">miding hae kya min ccazing lawbua</para>
  <para style="q2">thua nan hae sah.<note caller="-" style="x"><char style="xo" closed="false">69.28: </char><char style="xt" closed="false"><ref loc="EXO 32:32">Exo 32.32</ref>; <ref loc="REV 3:5">Bya 3.5</ref>, <ref loc="REV 13:8">13.8</ref>, <ref loc="REV 17:8">17.8</ref></char></note></para>
  <para style="q1">
    <verse number="29" style="v" />Thuasalama kae tuh zakawsangte</para>
  <para style="q2">vawsawnaw kya ka um;</para>
  <para style="q1">Pou Pachia, na khumnaw nynh</para>
  <para style="q2">kae kha yn thungkhaw sah.</para>
  <para style="q1">
    <verse number="30" style="v" />Pachia min kha hlaw te</para>
  <para style="q2">the ka hoysah cih;</para>
  <para style="q1">lungtuanaw byahote amaw kha</para>
  <para style="q2">ka thehoysah cih.</para>
  <para style="q1">
    <verse number="31" style="v" />E hynh nynh aki te accumakeih</para>
  <para style="q2">umpaw tangnuapaw te silaw laeze</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha a lungry</para>
  <para style="q2">a thuasah hua cih.</para>
  <para style="q1">
    <verse number="32" style="v" />Tuaasahkunaw a ing hae paw nynh</para>
  <para style="q2">tuh-e tuh muih hae sah lah,</para>
  <para style="q1">mih lungtua sah;</para>
  <para style="q2">Pachia a ccung hae paw nanning,</para>
  <para style="q2">nae thawmuin sah.</para>
  <para style="q1">
    <verse number="33" style="v" />
    <char style="nd">Bawipaw </char> nynh ryachi hae</para>
  <para style="q2">bya kha a thaepya hae,</para>
  <para style="q2">thong lungkhu um hae paw</para>
  <para style="q1">amaw ccungccaw hae kha</para>
  <para style="q2">pawlangria leite um khyh hae.</para>
  <para style="q1">
    <verse number="34" style="v" />Vaawlui, laephi, rili hae te</para>
  <para style="q2">hynh-e hae kya a umpaw</para>
  <para style="q1">ahysuepaw balyn nynh</para>
  <para style="q2">amaw kha thehoysah hae sah.</para>
  <para style="q1">
    <verse number="35" style="v" />Pachia nynh Zion kha a khum cih zah,</para>
  <para style="q2">Judah khuapi kha a raethui cih;</para>
  <para style="q1">a see hae tuh tuin kya a um cih hae zah,</para>
  <para style="q2">tuh-e tuh a ccou cih hae;</para>
  <para style="q1">
    <verse number="36" style="v" />a see hae mih ccaawno hae nynh</para>
  <para style="q2">tuh-e tuh rho lang a ccou cih hae zah,</para>
  <para style="q1">amaw min a sungsah hae paw nynh</para>
  <para style="q2">tuin kya a um cih hae.</para>
  <chapter number="70" style="c" />
  <para style="s1">Lue khylan Sawsangnaw</para>
  <para style="r">(<ref loc="PSA 40:13-17">Sam 40.13-17</ref>)</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou Pachia, kae kha beih yn luesah tua.</para>
  <para style="q2">Pou <char style="nd">Bawipaw </char>, kae kha</para>
  <para style="q2">bawm khylan rangsaku tua!</para>
  <para style="q1">
    <verse number="2" style="v" />Chia lan yn ry hae paw tuh</para>
  <para style="q2">maethyanaw mue hae sah lah,</para>
  <para style="q2">mih lungmua sah.</para>
  <para style="q1">Kae kha vaemaw muesah yn ry hae paw tuh</para>
  <para style="q2">nulang maeleihkuh hae sah lah,</para>
  <para style="q2">thethyanaw ccou hae sah.</para>
  <para style="q1">
    <verse number="3" style="v" />“Alei, Alei!” cite yn sarya hae paw tuh</para>
  <para style="q2">maethyanaw keiccuze nulang</para>
  <para style="q1">maeleihkuh hae sah.</para>
  <para style="q1">
    <verse number="4" style="v" />Nang ae ccung hae paw balyn tuh</para>
  <para style="q2">na tungvaw mih lungtua sah lah,</para>
  <para style="q1">mih lungpaw sah.</para>
  <para style="q2">Na khumnaw a ry hae paw nynh,</para>
  <para style="q1">“Pachia tuh alesae!” cite</para>
  <para style="q2">zungzae ho hae sah.</para>
  <para style="q1">
    <verse number="5" style="v" />Kae tuh ka ryachi zah</para>
  <para style="q2">minyaapaw nynh ka thua;</para>
  <para style="q1">Pou Pachia, arangte beih yn ccianua!</para>
  <para style="q2">Nang tuh yn bawmtu te</para>
  <para style="q1">yn luesahtu nynh na thua;</para>
  <para style="q2">Pou <char style="nd">Bawipaw </char>, na thysung nan sah!</para>
  <chapter number="71" style="c" />
  <para style="s1">She sae nawlan Sawsangnaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, namaw kya ka rekuh;</para>
  <para style="q2">maethyanaw kharouh yn muesah nan.</para>
  <para style="q1">
    <verse number="2" style="v" />Na dingnaw te yn luesah lah,</para>
  <para style="q2">yn khumtua;</para>
  <para style="q1">na nakaring kha ka kalan yn tuakuh lah,</para>
  <para style="q2">yn khumtua.</para>
  <para style="q1">
    <verse number="3" style="v" />Ka hanlan khynnaw lungpi thua lah,</para>
  <para style="q2">kae kha khum khylan atynpaw</para>
  <para style="q1">rhawlungrua thuatua,</para>
  <para style="q2">pawccecize nang tuh ka lungpi te</para>
  <para style="q1">ka rhawlungrua nynh na thua.</para>
  <para style="q1">
    <verse number="4" style="v" />Pou ka Pachia, ccungccaw hoylei hae paw</para>
  <para style="q2">kuih kyate thuasah,</para>
  <para style="q1">a ding lei hae paw te mih rysawthah</para>
  <para style="q2">hae paw kuih kyate thuasah</para>
  <para style="q1">kae kha yn luesah tua.</para>
  <para style="q1">
    <verse number="5" style="v" />Pou Bawipaw, nang tuh</para>
  <para style="q2">ka ngaehoinaw nynh na thua,</para>
  <para style="q1">Pou <char style="nd">Bawipaw </char>, ka di lya mawte</para>
  <para style="q2">kae doliakupaw nynh na thua.</para>
  <para style="q1">
    <verse number="6" style="v" />Ka pui takaw te nang kha</para>
  <para style="q2">kae reihpeku vae;</para>
  <para style="q1">ka nung vue kyate yn puisahpaw tuh</para>
  <para style="q2">nang nynh na thua.</para>
  <para style="q1">Nang kha po kae thehoysah cih.</para>
  <para style="q1">
    <verse number="7" style="v" />Kae hynh ccungccaw patae hanlan</para>
  <para style="q2">muihsahnaw hawte nynh ka thua,</para>
  <para style="q1">thuasalama nang tuh atynpaw</para>
  <para style="q2">ka khynnaw nynh na thua.</para>
  <para style="q1">
    <verse number="8" style="v" />Anin ninlang ka mung nynh</para>
  <para style="q2">nang kha ae thehoysah zah</para>
  <para style="q2">na phu-enaw kong kha a ho.</para>
  <para style="q1">
    <verse number="9" style="v" />Ka taw vae ze, yn vua nan;</para>
  <para style="q2">ka thawzung athang vae ze, yn vua nan.</para>
  <para style="q1">
    <verse number="10" style="v" />Ka rhaw hae nynh ka konglang</para>
  <para style="q2">hokuh hae zah,</para>
  <para style="q1">kae kha chia yn ry hae paw ryte</para>
  <para style="q2">pynkheihlan khua a khanku hae.</para>
  <para style="q1">
    <verse number="11" style="v" />“Pachia nynh a vua vae paw,</para>
  <para style="q2">khuh-e ccungccaw khuh</para>
  <para style="q1">deehui oh sih lah, kyng oh sih,</para>
  <para style="q2">pawccecize amaw a khum lanpaw</para>
  <para style="q1">hum sanmah um khyh,” cite a hoku hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Pou Pachia, ka kyate beih sawkuh nan;</para>
  <para style="q2">Pou ka Pachia, arangte yn bawmtua!</para>
  <para style="q1">
    <verse number="13" style="v" />Kae yn rawse hae paw tuh</para>
  <para style="q2">maethyanaw ccou hae sah lah, roh hae sah;</para>
  <para style="q1">vawsawnaw tungsah yn ry hae paw tuh</para>
  <para style="q2">saryanaw te thethyanaw ccou hae sah.</para>
  <para style="q1">
    <verse number="14" style="v" />Kae tuh po ka ngaehoi cih zah,</para>
  <para style="q2">nang kha houhouh kae thehoysah cih.</para>
  <para style="q1">
    <verse number="15" style="v" />Na dingnaw te na khumnaw kha</para>
  <para style="q2">anin ninlang ka ho cih,</para>
  <para style="q1">tuh-e hae tuh ka ny khonaw laeze</para>
  <para style="q2">alung zemah ka ho cih.</para>
  <para style="q1">
    <verse number="16" style="v" />Bawipaw PACHIA kya-e athungpaw</para>
  <para style="q2">ryalawnaw hae kha ka thehoysah cih,</para>
  <para style="q1">na dingnaw kyalya kha ka siakhae cih.</para>
  <para style="q1">
    <verse number="17" style="v" />Pou Pachia, ka di lya mawte</para>
  <para style="q2">nae ccangpya vae,</para>
  <para style="q1">ngaeangthua lan umpaw</para>
  <para style="q2">na ryalawnaw hae kha</para>
  <para style="q2">palei ka siakhae ung.</para>
  <para style="q1">
    <verse number="18" style="v" />Pou Pachia, ka taw vae zah,</para>
  <para style="q2">ka sang phe paw lang cia,</para>
  <para style="q2">yn thua cih paw she hae balyn kya</para>
  <para style="q1">na thungnaw kha ka siakhae mawlaezung</para>
  <para style="q2">kae kha yn vua nan.</para>
  <para style="q1">
    <verse number="19" style="v" />Pou Pachia, na huhan te na dingnaw nynh</para>
  <para style="q2">ahangpaw vaawlui phe a phya.</para>
  <para style="q1">Myarya lepaw uccaw hae a raepaw, pou Pachia,</para>
  <para style="q2">nang ae lopaw hummou a um?</para>
  <para style="q1">
    <verse number="20" style="v" />Vawsawnaw te runaw patae</para>
  <para style="q2">yn tungsahpaw nang nynh</para>
  <para style="q2">kae kha thawzung nae pyathui cih;</para>
  <para style="q1">akhupaw laephi kyate</para>
  <para style="q2">kae kha bua nae thuaa cih.</para>
  <para style="q1">
    <verse number="21" style="v" />Sawtuakunaw houh nae pya cih zah,</para>
  <para style="q2">ngaengannaw kha bua nae pya cih.</para>
  <para style="q1">
    <verse number="22" style="v" />Pou ka Pachia, alungzipaw</para>
  <para style="q2">na thua keiccuze nang kha</para>
  <para style="q2">tintang te kae thehoysah cih.</para>
  <para style="q1">Pou Israel hae Pachia Athyaapaw,</para>
  <para style="q2">tintang khuakute na kalan</para>
  <para style="q2">thehoysahnaw hlaw ka sah cih.</para>
  <para style="q1">
    <verse number="23" style="v" />Na kalan thehoysahnaw hlaw</para>
  <para style="q2">he ka sah te, ka khalang te</para>
  <para style="q1">lungtuate ka sia cih.</para>
  <para style="q2">na khum vae paw ka muisaw mah</para>
  <para style="q2">a lungtua cih.</para>
  <para style="q1">
    <verse number="24" style="v" />Ka lae nynh adingpaw na bawmnaw</para>
  <para style="q2">kong kha anin ninlang a ho cih,</para>
  <para style="q1">pawccecize vawsawnaw pya lan</para>
  <para style="q2">yn zuanuakuh hae paw tuh</para>
  <para style="q1">maethyanaw mue hae zah,</para>
  <para style="q2">mih thethah vae.</para>
  <chapter number="72" style="c" />
  <para style="s1">Siapharan elang Sawsangnaw</para>
  <para style="d">Solomon Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou Pachia, na byading kha</para>
  <para style="q2">siapharan kalan pya lah,</para>
  <para style="q1">na dingnaw kha</para>
  <para style="q2">siapharan ccapaw kalan pyatua.</para>
  <para style="q1">
    <verse number="2" style="v" />Aning nynh na ccungccaw hae kha</para>
  <para style="q2">dingnaw te byapia hae sah lah,</para>
  <para style="q1">na kya-e ryachi hae kha byading te</para>
  <para style="q2">byapia hae sah.</para>
  <para style="q1">
    <verse number="3" style="v" />Mua hae nynh ccungccaw hae hanlan</para>
  <para style="q2">hoirumnaw thuakhae hae sah lah,</para>
  <para style="q1">sangpyng hae nynh dingnaw kha</para>
  <para style="q2">thuakhae hae sah.</para>
  <para style="q1">
    <verse number="4" style="v" />Tuh-e siapharan nynh</para>
  <para style="q2">ccungccaw hae kyaze</para>
  <para style="q1">ryachi hae kha thungkhaw hae sah lah,</para>
  <para style="q2">ahobou hae paw kha luenaw pya hae sah,</para>
  <para style="q1">te vawsaw pyatu hae kha tae hae sah.</para>
  <para style="q1">
    <verse number="5" style="v" />Khuanin te sawpaw atyn lungkhu balyn,</para>
  <para style="q2">she takyh kya minmin nynh</para>
  <para style="q2">nang kha ae rih hae sah.</para>
  <para style="q1">
    <verse number="6" style="v" />Tuh-e siapharan tuh aw kou takawpaw</para>
  <para style="q2">lonua vawlan accahpaw</para>
  <para style="q1">khuaa hawte thua sah lah,</para>
  <para style="q2">laephi a ciasahpaw khuaa hawte thua vae sah.</para>
  <para style="q1">
    <verse number="7" style="v" />A she lungkhu kya dingnaw tuh</para>
  <para style="q2">lethung sah lah,</para>
  <para style="q2">sawpaw a zo makhia daenaw um sah.</para>
  <para style="q1">
    <verse number="8" style="v" />Rili ccangkheit kyate ccangkheit kyacia</para>
  <para style="q2">uk sah lah,</para>
  <para style="q1">Zufrates vawpi kyate</para>
  <para style="q2">laephi adianaw cia uk sah.<note caller="-" style="x"><char style="xo" closed="false">72.8: </char><char style="xt" closed="false"><ref loc="ZEC 9:10">Zek 9.10</ref></char></note></para>
  <para style="q1">
    <verse number="9" style="v" />Laesia ram um hae paw nynh</para>
  <para style="q2">a malang khe bakhung hae sah lah,</para>
  <para style="q2">a rhaw hae nynh laenoi kha lya hae sah.</para>
  <para style="q1">
    <verse number="10" style="v" />Tarshish siapharan hae te tuikoih</para>
  <para style="q2">siapharan hae nynh</para>
  <para style="q2">ngunto pya hae sah lah,</para>
  <para style="q1">Sheba te Seba siapharan hae nynh</para>
  <para style="q2">lasung ccyngpah hae sah.</para>
  <para style="q1">
    <verse number="11" style="v" />Siapharan balyn nynh a malang</para>
  <para style="q2">bakhung hae sah lah,</para>
  <para style="q1">minphuin balyn nynh amaw rya kha</para>
  <para style="q2">lawpah hae sah.</para>
  <para style="q1">
    <verse number="12" style="v" />Pawccecize ahobou hae paw nynh</para>
  <para style="q2">amaw kha a ko hae ze luesah hae zah,</para>
  <para style="q1">ryachi hae te bawmtu hoi lei hae paw kha</para>
  <para style="q2">a luesah hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Ryachi hae te minyaa hae kha</para>
  <para style="q2">thawccih hae zah,</para>
  <para style="q2">minyaa hae hiinnaw kha a khum hae.</para>
  <para style="q1">
    <verse number="14" style="v" />Tuaasahnaw te puathonaw kyate</para>
  <para style="q2">mih hiinnaw kha a shawkhaw hae;</para>
  <para style="q1">mih chii tuh amaw muihnaw kya aphute.</para>
  <para style="q1">
    <verse number="15" style="v" />Siapharan tuh a she sae vae sah!</para>
  <para style="q2">Sheba sui kha amaw kalan</para>
  <para style="q1">pya vae hae sah.</para>
  <para style="q2">Amaw elang zungzae</para>
  <para style="q1">sawsangpah hae sah lah,</para>
  <para style="q2">Nin takyh hythuapya hae sah.</para>
  <para style="q1">
    <verse number="16" style="v" />Ram lungkhu kya looh patae um sah;</para>
  <para style="q2">a ccathae tuh Lebanon mua hae kya-e hawte</para>
  <para style="q2">mua dung hae vawlan khe luiluih hy sah;</para>
  <para style="q1">khuapi kya-e ccungccaw hae tuh</para>
  <para style="q2">loo kya-e lonua hae hawte</para>
  <para style="q2">khuapi kyakhe apaw paw hae sah.</para>
  <para style="q1">
    <verse number="17" style="v" />A min tuh zungzae tyn sah lah,</para>
  <para style="q2">a minthaannaw tuh khuanin a um</para>
  <para style="q2">lungkhu balyn po tyn sah.</para>
  <para style="q1">Minphuin balyn tuh amaw liate</para>
  <para style="q2">hythuaccou hae sah;</para>
  <para style="q1">aning tuh hythua ccoupaw nynh</para>
  <para style="q2">thua cite minmin nynh ho hae sah.</para>
  <para style="q1">
    <verse number="18" style="v" />Israel Pachia <char style="nd">Bawipaw </char> tuh</para>
  <para style="q2">thehoysah oh,</para>
  <para style="q1">aning kyalya nynh ngaeangthua lan</para>
  <para style="q2">umpaw uccaw hae kha a rae.</para>
  <para style="q1">
    <verse number="19" style="v" />A phu-epaw a min kha zungzae</para>
  <para style="q2">thehoysah oh; a phu-enaw tuh</para>
  <para style="q1">laephi pynpi phe beih sah.</para>
  <para style="q2">Amen, Amen.</para>
  <para style="q1">
    <verse number="20" style="v" />Jesse ccapaw David sawsangnaw athang vae.</para>
  <chapter number="73" style="c" />
  <para style="ms">UK 3</para>
  <para style="mr">(<ref loc="PSA 73-89">Sam 73—89</ref>)</para>
  <para style="s1">Tuaasahtu hae kyate Lue lan Ngianaw<note caller="+" style="f"><char style="fr" closed="false">73 Abyalu: </char><char style="ft" closed="false">Asaf nynh a phuapaw.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Pachia tuh Israel hae hanlan te</para>
  <para style="q2">thinlung athyaa hae paw hanlan</para>
  <para style="q2">ahoy ccaccing.</para>
  <para style="q1">
    <verse number="2" style="v" />Thuasalama kae tuh vya ka khuliakuh;</para>
  <para style="q2">vya ka thei.</para>
  <para style="q1">
    <verse number="3" style="v" />Pawccecize ccungccaw hoylei hae paw</para>
  <para style="q2">kya-e hoirumnaw kha he ka muih tuh,</para>
  <para style="q1">a lysakuhpaw tungvaw ka eiung.</para>
  <para style="q1">
    <verse number="4" style="v" />Minmin tuh ccinaw hoi khyh hae;</para>
  <para style="q2">mih pyn tuh mih ngedan zah</para>
  <para style="q2">mih ngesaw ahoy.</para>
  <para style="q1">
    <verse number="5" style="v" />Ming hae hawte</para>
  <para style="q2">vawsawnaw tung khyh hae;</para>
  <para style="q1">ming hae hawte</para>
  <para style="q2">teingnaw mue khyh hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Tukeiccuze lysakunaw kha</para>
  <para style="q2">si lang oikuh hae zah,</para>
  <para style="q1">puathonaw kha boeining hawte</para>
  <para style="q2">a bongku hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Eih tho hae keiccuze mih mit tuh</para>
  <para style="q2">phang phinkhaekuh;</para>
  <para style="q1">mih thinlung tuh</para>
  <para style="q2">ngaeenaw te phe abeih.</para>
  <para style="q1">
    <verse number="8" style="v" />Ming hae kha sarya hae zah</para>
  <para style="q2">ahoy leipaw bya kha a hoku hae;</para>
  <para style="q1">lysakute vawsaw pyanaw bya khate</para>
  <para style="q2">a hu a raw hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Vaawlang rawsenaw bya kha ho hae zah,</para>
  <para style="q2">mih lae tuh laephi vawlan a khiakuh.</para>
  <para style="q1">
    <verse number="10" style="v" />Tukeiccuze Pachia ccungccaw hae nynh</para>
  <para style="q2">maeleihkuh hae zah,</para>
  <para style="q2">minmin kha the a hoysah hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Te minmin nynh, “Pachia nynh</para>
  <para style="q2">pawtemou a nyh kho cih?</para>
  <para style="q1">Ahang Huaccepaw kya nythyanaw</para>
  <para style="q2">a um zawtou?” a ci hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Tuhcihawpaw hae tuh</para>
  <para style="q2">ccungccaw hoylei hae paw nynh thua;</para>
  <para style="q1">hiinhoyte zungzae um hae zah,</para>
  <para style="q2">houhouh a hoirum hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Ka thinlung ka thyaasakuh zah,</para>
  <para style="q2">ka kuih kha seinaw hoi lei lante</para>
  <para style="q1">ka singkupaw balyn hynh</para>
  <para style="q2">alakawpaw nynh thua.</para>
  <para style="q1">
    <verse number="14" style="v" />Anin ninlang vawsaw nae teingsah zah,</para>
  <para style="q2">awkhua takyh de nae tah.</para>
  <para style="q1">
    <verse number="15" style="v" />Tuhcihtuhte ka la ho lanze,</para>
  <para style="q2">na ccungccaw hae kya</para>
  <para style="q2">ahme leipaw ka thua cih.</para>
  <para style="q1">
    <verse number="16" style="v" />E hynh pawtemou thaethya lan cite</para>
  <para style="q2">he ka tua tuh,</para>
  <para style="q2">ka hanlan myarya arupaw rya nynh alo,</para>
  <para style="q1">
    <verse number="17" style="v" />Pachia beikinnthyaa lungkhu lang</para>
  <para style="q2">ka tee koute tuh,</para>
  <para style="q1">ccungccaw hoylei hae paw</para>
  <para style="q2">mih thangnaw kha ka muih.</para>
  <para style="q1">
    <verse number="18" style="v" />Minmin kha nawpalaepaw hmin kya</para>
  <para style="q2">na nung hae;</para>
  <para style="q2">ronaw kya na khulia hae.</para>
  <para style="q1">
    <verse number="19" style="v" />Minmin tuh sosoh kyakhe roh hae zah,</para>
  <para style="q2">myarya lepaw rikawnaw keiccuze</para>
  <para style="q2">khaleih a zo hae.</para>
  <para style="q1">
    <verse number="20" style="v" />Minmin tuh lukhakheit nynh</para>
  <para style="q2">he a thaekuh te phe azopaw maan te</para>
  <para style="q1">nynh a loku hae;</para>
  <para style="q2">he na thaesakuh hae tuh,</para>
  <para style="q1">mih tuakunaw kha phe azo vae.</para>
  <para style="q1">
    <verse number="21" style="v" />Ka lungroh zah,</para>
  <para style="q2">ka thinlung he ccih tuh,</para>
  <para style="q1">
    <verse number="22" style="v" />baluh ka ngaee zah pawpaw mah</para>
  <para style="q2">ka tuathya vae khyh;</para>
  <para style="q1">na malang arepaw loramsaw nynh</para>
  <para style="q2">ka lo vae.</para>
  <para style="q1">
    <verse number="23" style="v" />Tuhzemah namaw kyakhe</para>
  <para style="q2">po ka um zah,</para>
  <para style="q2">ka ranglang kuih kha phang nae kyng.</para>
  <para style="q1">
    <verse number="24" style="v" />Tuanaw pyate laan nae mawpah zah,</para>
  <para style="q2">athangnaw kya tuh sawtuanaw te</para>
  <para style="q2">nae ccou cih.</para>
  <para style="q1">
    <verse number="25" style="v" />Vaawlang khua kya nang holeite</para>
  <para style="q2">hummou ka hoi?</para>
  <para style="q1">Namaw laelan laephi vawlan</para>
  <para style="q2">ka rypaw pawpaw mah</para>
  <para style="q2">um vae khyh.</para>
  <para style="q1">
    <verse number="26" style="v" />Ka pyn te ka thinlung tuh</para>
  <para style="q2">nyaabung hae salamah,</para>
  <para style="q1">Pachia tuh ka thinlung thawzung te</para>
  <para style="q2">ka ccoupaw ka hanpaw nynh</para>
  <para style="q1">athua zungzae.</para>
  <para style="q1">
    <verse number="27" style="v" />Nang te a sawkuh hae paw tuh</para>
  <para style="q2">a roh cih hae;</para>
  <para style="q1">na tungvaw a mesei hae paw kha</para>
  <para style="q2">na maemih hae.</para>
  <para style="q1">
    <verse number="28" style="v" />Thuasalama kae ka hanlan tuh</para>
  <para style="q2">Pachia kalan naekupaw hynh ahoy;</para>
  <para style="q1">na ryalaw balyn kha ho khylan,</para>
  <para style="q2">Bawipaw PACHIA kha</para>
  <para style="q1">ka khynnaw lang ka nungku vae.</para>
  <chapter number="74" style="c" />
  <para style="s1">Luenaw Mue khylan Sawsangnaw<note caller="+" style="f"><char style="fr" closed="false">74 Abyalu: </char><char style="ft" closed="false">Asaf byarui.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Pou Pachia, pawccemou kaening hynh</para>
  <para style="q2">zungzae nae vua?</para>
  <para style="q1">Pawccemou namaw kya</para>
  <para style="q2">rampaee hae paw tuu hae kha</para>
  <para style="q2">na thin a rianua hae?</para>
  <para style="q1">
    <verse number="2" style="v" />Langmawlya te na poku hae paw te</para>
  <para style="q2">na rho minphuin thua khylan</para>
  <para style="q1">na shawkhawku hae paw</para>
  <para style="q2">na ccungccaw a pumkuh hae paw kha</para>
  <para style="q1">liathui hae.</para>
  <para style="q2">Na la umnaw Zion Mua kha liathuitua.</para>
  <para style="q1">
    <verse number="3" style="v" />Zungzae arohpaw kalan hin yn cciatua;</para>
  <para style="q2">rhaw hae nynh beikinnthyaa kya</para>
  <para style="q2">umpaw atyn-are kha a ro vae hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Na rhaw hae tuh na hmin thyaapaw</para>
  <para style="q2">lungkhu khe a sia hae;</para>
  <para style="q1">minmin syntawnawpaw kha</para>
  <para style="q2">tuin kya a nung hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Minmin nynh palung thuakaw kya</para>
  <para style="q2">thingphe te raekuhpaw kha</para>
  <para style="q2">hae te a tya hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Oute thing kya asoikuhpaw balyn kha</para>
  <para style="q2">hae te khynlyng khate marya a ro hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Na beikinnthyaa kha maee te a soi hae;</para>
  <para style="q2">na min a umnaw hminthyaa kha</para>
  <para style="q1">laekhu lang sawbung te</para>
  <para style="q2">a nungsisaku hae.</para>
  <para style="q1">
    <verse number="8" style="v" />“Minmin hynh khaleih ro lan hae,”</para>
  <para style="q2">cite mimaw te mimaw a hoku hae;</para>
  <para style="q1">ram kya umpaw Pachia kya-e</para>
  <para style="q2">tungkunaw hmin balyn kha</para>
  <para style="q1">maee te a soi hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Kaening syntawnawpaw hae kha</para>
  <para style="q2">kae muih vae khyh;</para>
  <para style="q1">profeh lu kheit san um vae khyh;</para>
  <para style="q2">hohsecia ccyh aro lanpaw kha</para>
  <para style="q1">a nyhpaw kaening laku kya</para>
  <para style="q2">lu kheit san um khyh.</para>
  <para style="q1">
    <verse number="10" style="v" />Pou Pachia, rhaw hae nynh</para>
  <para style="q2">hohseciamou yn sarya cih hae?</para>
  <para style="q1">rhaw hae nynh na min kha</para>
  <para style="q2">zungzae a ruin a san cih hae tou?</para>
  <para style="q1">
    <verse number="11" style="v" />Pawccemou na kuih na khin?</para>
  <para style="q2">Pawccemou na kuih kha na by kya</para>
  <para style="q1">na nung?</para>
  <para style="q1">
    <verse number="12" style="v" />Tuhzemah Pachia athuapaw</para>
  <para style="q2">ka Siapharan tuh langmawlya mawte</para>
  <para style="q1">laephi vawlan khumnaw</para>
  <para style="q2">rya a lahpaw nynh thua.</para>
  <para style="q1">
    <verse number="13" style="v" />Na thungnaw te rili kha na phia zah,</para>
  <para style="q2">tui lungkhu khe nakaa-hupi hae lu kha</para>
  <para style="q2">na koi hae.<note caller="-" style="x"><char style="xo" closed="false">74.13: </char><char style="xt" closed="false"><ref loc="EXO 14:21">Exo 14.21</ref></char></note></para>
  <para style="q1">
    <verse number="14" style="v" />Levithan hupi lu kha na tude zah,</para>
  <para style="q2">laesia ram e ccungccaw hae kha</para>
  <para style="q2">aepaw lang na pya hae.<note caller="-" style="x"><char style="xo" closed="false">74.14: </char><char style="xt" closed="false"><ref loc="JOB 41:1">Job 41.1</ref>; <ref loc="PSA 104:26">Sam 104.26</ref>; <ref loc="ISA 27:1">Isa 27.1</ref></char></note></para>
  <para style="q1">
    <verse number="15" style="v" />Tuidy te vaw taraw hae kha</para>
  <para style="q2">na luasah hae zah,</para>
  <para style="q1">palei aluapaw vaw hae kha</para>
  <para style="q2">karae na rousah hae.</para>
  <para style="q1">
    <verse number="16" style="v" />Khuadae te khuazi tuh</para>
  <para style="q2">namaw kya-e nynh athua hae;</para>
  <para style="q2">khuanin te sawpaw kha na rae hae.</para>
  <para style="q1">
    <verse number="17" style="v" />Laephi adianaw ramri kha na ia;</para>
  <para style="q2">hawnin te khuaccih kha na rae hae.</para>
  <para style="q1">
    <verse number="18" style="v" />Pou <char style="nd">Bawipaw </char>, rhaw hae nynh</para>
  <para style="q2">ae sarya hae zah,</para>
  <para style="q1">beiknaw pawlangria lei hae paw nynh</para>
  <para style="q2">na min a ruin a san hae paw hynh</para>
  <para style="q2">liathuitua.</para>
  <para style="q1">
    <verse number="19" style="v" />Na vahu a hiinnaw kha</para>
  <para style="q2">sarepaw hae kalan pya nan;</para>
  <para style="q1">na ccungccaw ryachi hae kha</para>
  <para style="q2">zungzae ning nan hae.</para>
  <para style="q1">
    <verse number="20" style="v" />Na byakinnaw kha ning nan,</para>
  <para style="q2">pawccecize ram lungkhu</para>
  <para style="q1">amohnaw hmin hae tuh</para>
  <para style="q2">puathonaw te nynh phe abia.</para>
  <para style="q1">
    <verse number="21" style="v" />Vawsaw pyakunaw a ing hae paw kha</para>
  <para style="q2">maethyanaw muesah nan hae;</para>
  <para style="q1">ryachi hae te minyaa hae nynh</para>
  <para style="q2">na min kha ae thehoysah hae sah.</para>
  <para style="q1">
    <verse number="22" style="v" />Pou Pachia, thokuh lah,</para>
  <para style="q2">na rya kha lawtua,</para>
  <para style="q1">beiknaw pawlangria lei hae paw nynh</para>
  <para style="q2">anin ninlang nang</para>
  <para style="q1">ae sarya hae paw kha</para>
  <para style="q2">liathuitua.</para>
  <para style="q1">
    <verse number="23" style="v" />Na rhaw hae nynh</para>
  <para style="q2">a siarua hae paw kha ning nan,</para>
  <para style="q1">nang ae rawse hae paw nynh</para>
  <para style="q2">siarisiarae palei a um hae paw</para>
  <para style="q1">roi kha ning nan.</para>
  <chapter number="75" style="c" />
  <para style="s1">A Ryalaw hanlan Pachia Thehoysahnaw</para>
  <para style="d">Asaf Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou Pachia, kaening nynh nang kha</para>
  <para style="q2">the kae hoysah;</para>
  <para style="q1">na min tuh kae naeku keiccuze</para>
  <para style="q2">na the kae hoysah.</para>
  <para style="q1">Ccungccaw hae nynh ngaeangthua lan</para>
  <para style="q2">umpaw na cyipaw kong kha a ho hae.</para>
  <para style="q1">
    <verse number="2" style="v" />Ka khyapaw accyh azaw te,</para>
  <para style="q2">dingnaw te bya ka pia cih.</para>
  <para style="q1">
    <verse number="3" style="v" />Laephi te laephi kya umpaw</para>
  <para style="q2">ahysuepaw balyn hynh</para>
  <para style="q2">he a hy hae te,</para>
  <para style="q1">laephi atung hae a tynsahpaw tuh</para>
  <para style="q2">kamaw nynh ka thua.</para>
  <para style="q1">
    <verse number="4" style="v" />A pookuh hae paw kyakhe,</para>
  <para style="q2">“Pookuh nan oh,” cite</para>
  <para style="q1">ka hopah hae zah,</para>
  <para style="q2">ccungccaw hoylei hae paw kyakhe,</para>
  <para style="q1">“Na lysakunaw oh paw ki kha</para>
  <para style="q2">hangthung nan oh;</para>
  <para style="q1">
    <verse number="5" style="v" />nae ki kha ahangnaw lang</para>
  <para style="q2">hangthung nan oh,</para>
  <para style="q1">lysakute byaho nan oh,”</para>
  <para style="q2">cite ka hopya hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Byapianaw hynh nithua,</para>
  <para style="q2">niccaw langte thuasah,</para>
  <para style="q1">palung, alia langte thuasah</para>
  <para style="q2">yn thua khyh;</para>
  <para style="q1">
    <verse number="7" style="v" />byapiatu tuh Pachia thua zah,</para>
  <para style="q2">lu kheit kha sahbung zah,</para>
  <para style="q2">ccangpaw lu kheit kha a hangthung.</para>
  <para style="q1">
    <verse number="8" style="v" />
    <char style="nd">Bawipaw </char> kuih kyakhe</para>
  <para style="q2">banang ccangkheit a um,</para>
  <para style="q1">tuh-e banang kyatuin amynkhuhpaw te</para>
  <para style="q2">pykuhpaw ruithyapaw misutui a um,</para>
  <para style="q1">aning nynh tuh-e tuh moh a lae cih zah,</para>
  <para style="q2">laephi vaw e</para>
  <para style="q1">ccungccaw hoylei hae paw nynh</para>
  <para style="q2">a dangdy balyn kha phe thang lan</para>
  <para style="q2">a neih cih hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Thuasalama kae tuh</para>
  <para style="q2">zungzae ka lungtua cih;</para>
  <para style="q1">Jakob Pachia kha thehoysahnaw hlaw</para>
  <para style="q2">ka sah cih.</para>
  <para style="q1">
    <verse number="10" style="v" />Ccungccaw hoylei hae paw</para>
  <para style="q2">mih ki balyn kha ka khya cih,</para>
  <para style="q1">thuasalama miding hae ki tuh</para>
  <para style="q2">hangthung athua cih.</para>
  <chapter number="76" style="c" />
  <para style="s1">Laephi Pynpi Byapiatu</para>
  <para style="d">Asaf Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Judah ram kya Pachia kha a ny hae;</para>
  <para style="q2">a min tuh Israel ram kya a lesae.</para>
  <para style="q1">
    <verse number="2" style="v" />Jerusalem kya Pachia bu a um,</para>
  <para style="q2">amaw a umnaw hmin tuh</para>
  <para style="q2">Zion nynh thua.</para>
  <para style="q1">
    <verse number="3" style="v" />Tuin kyakhe dalahdalah akpaw</para>
  <para style="q2">the hae, khawriaphua,</para>
  <para style="q1">thaloi te rhaw zunghe hae kha</para>
  <para style="q2">aning nynh a khya hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Nang tuh zungzae tynpaw</para>
  <para style="q2">mua hae laeze na phu-ehua zah,</para>
  <para style="q2">myarya na lesae.</para>
  <para style="q1">
    <verse number="5" style="v" />Arawthungpaw rhaw hae kya-e</para>
  <para style="q2">uccaw hae kha luade thua hae zah,</para>
  <para style="q1">zya a ih vae hae;</para>
  <para style="q1">rhaw hae tuh lu kheit sanmah</para>
  <para style="q2">mih kuih hang kho vae khyh hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Pou Jakob Pachia,</para>
  <para style="q2">na hu na raw hae keiccuze</para>
  <para style="q1">marangle te marang ccikuh hae paw</para>
  <para style="q2">tuh ningkuh hae zah a khuliakuh hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Thuasalama nang tuh</para>
  <para style="q2">ri lan na um ccaccing!</para>
  <para style="q1">na thinria ze, hummou na malang</para>
  <para style="q2">a thadyn kho cih?</para>
  <para style="q1">
    <verse number="8-9" style="v" />Laephi vawlan tuaasahnaw</para>
  <para style="q2">a ing hae paw balyn kha</para>
  <para style="q1">khum lan cite Pachia nynh</para>
  <para style="q2">byapia khylan he a thokuh te,</para>
  <para style="q1">vaawlang te byapianaw roi</para>
  <para style="q2">a saw keiccuze</para>
  <para style="q1">laephi tuh rih zah, zya adae.</para>
  <para style="q1">
    <verse number="10" style="v" />Ccungccaw thinrianaw tuh</para>
  <para style="q2">namaw thehoysah nawlan nynh</para>
  <para style="q1">houh a tang, rhaw kyate</para>
  <para style="q2">a hiinhy hae paw nynh</para>
  <para style="q2">na poi kha a tua cih hae.</para>
  <para style="q1">
    <verse number="11" style="v" />
    <char style="nd">Bawipaw </char> nae Pachia kalan</para>
  <para style="q2">byakinkunaw rae oh lah,</para>
  <para style="q1">tuh-e byakinkunaw thyhte cyih oh;</para>
  <para style="q2">Pachia pepan um hae paw balyn nynh</para>
  <para style="q1">rawri sawtua lan umpaw Pachia kalan</para>
  <para style="q2">lasung ccyngpah hae sah,</para>
  <para style="q1">
    <verse number="12" style="v" />tuh-e Pachia tuh uktu hae hiinnaw kha</para>
  <para style="q2">a nesah bungpaw,</para>
  <para style="q1">laephi siapharan hae kha</para>
  <para style="q2">rinaw a hoisah hae paw nynh thua.</para>
  <chapter number="77" style="c" />
  <para style="s1">Pachia kya-e Athungpaw Ryalawnaw</para>
  <para style="d">Asaf Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pachia kalan thawte ka sia,</para>
  <para style="q2">Pachia kalan thawte ka siapaw roi kha</para>
  <para style="q2">yn thaepah cih.</para>
  <para style="q1">
    <verse number="2" style="v" />Ka vawsaw lyakhe <char style="nd">Bawipaw </char> kha</para>
  <para style="q2">ka ccung; khuazi kya mah</para>
  <para style="q1">ka kuih kha thawbang leite ka dyng;</para>
  <para style="q2">thuasalama ka muisaw tuh</para>
  <para style="q2">ngaengannaw mue khyh.</para>
  <para style="q1">
    <verse number="3" style="v" />Pachia kha ka tua zah,</para>
  <para style="q2">ka hawkhaekuh;</para>
  <para style="q1">Hoyte ka tua zah, ka lungthawzya,</para>
  <para style="q1">
    <verse number="4" style="v" />Mit masite nae isah kho khyh;</para>
  <para style="q2">ka lungvaw eih saw zah,</para>
  <para style="q2">bya ka ho kho khyh.</para>
  <para style="q1">
    <verse number="5" style="v" />Athang vae paw nin hae kha ka tua zah,</para>
  <para style="q2">langmawlya e kum hae kha ka liathui.</para>
  <para style="q1">
    <verse number="6" style="v" />Khuazi khe ka hlaw kha</para>
  <para style="q2">ka thinlung te ka tua;</para>
  <para style="q1">hoyte ka tua zah, ka muisaw kha</para>
  <para style="q2">ka ccung.</para>
  <para style="q1">
    <verse number="7" style="v" />“<char style="nd">Bawipaw </char> nynh zungzae yn vua cih tou?</para>
  <para style="q2">maehoynaw bua yn pya</para>
  <para style="q2">vae lan khyh tou?</para>
  <para style="q1">
    <verse number="8" style="v" />Atynpaw a sungsahnaw kha</para>
  <para style="q2">zungzae a thangsah vae cih tou?</para>
  <para style="q1">A byakinpyakunaw hae tuh</para>
  <para style="q2">zungzae a thangsah vae cih tou?</para>
  <para style="q1">
    <verse number="9" style="v" />Pachia nynh thawcci lanpaw kha</para>
  <para style="q2">phe a ning vae tou?</para>
  <para style="q1">Ngaethyaumsahnaw a hoipaw kha</para>
  <para style="q2">a thinria keiccuze</para>
  <para style="q2">phe a zosah vae tou?” ka ciku.</para>
  <para style="q1">
    <verse number="10" style="v" />Te kae nynh, “Ka ngae athyapaw tuh:</para>
  <para style="q2">Ahang Huaccepaw</para>
  <para style="q1">a ranglang kuih nynh phe a rulae vae,</para>
  <para style="q2">cipaw hynh nynh thua,” ka ci.</para>
  <para style="q1">
    <verse number="11" style="v" />
    <char style="nd">Bawipaw </char> ryalawnaw kha</para>
  <para style="q2">ka tuathui cih;</para>
  <para style="q1">langmawlya na la cyipaw</para>
  <para style="q2">ngaeangthua lan um hae paw kha</para>
  <para style="q2">ka liathui cih.</para>
  <para style="q1">
    <verse number="12" style="v" />Na ryalaw balyn kha ka tuathui cih zah,</para>
  <para style="q2">athungpaw na cyisahnaw hae kha</para>
  <para style="q2">hoyte ka tua cih.</para>
  <para style="q1">
    <verse number="13" style="v" />Pou Pachia, na laanpi tuh athyaa.</para>
  <para style="q2">Pawcihawpaw pachia mou</para>
  <para style="q2">kaening Pachia hawte alesae?</para>
  <para style="q1">
    <verse number="14" style="v" />Nang tuh ngaeangthua lan umpaw</para>
  <para style="q2">rya a lahpaw Pachia nynh na thua;</para>
  <para style="q1">minphuin hae kyakhe na thungnaw kha</para>
  <para style="q2">na langsaku vae.</para>
  <para style="q1">
    <verse number="15" style="v" />A thawsaepaw na kuih te</para>
  <para style="q2">na ccungccaw athua hae paw</para>
  <para style="q1">Jakob te Josef ciihan hae kha</para>
  <para style="q2">na shawkhaw hae.</para>
  <para style="q1">
    <verse number="16" style="v" />Pou Pachia, tui hae nynh nang kha</para>
  <para style="q2">he ae muih hae te, minmin tuh a rih hae;</para>
  <para style="q2">tui akhunaw tuh a thyngkuh.</para>
  <para style="q1">
    <verse number="17" style="v" />Maeking hae nynh khuaa a rawsah;</para>
  <para style="q2">vaawlui mah kholungthyh zah,</para>
  <para style="q1">na the hae tuh</para>
  <para style="q2">teitei lang balyn phe a thua.</para>
  <para style="q1">
    <verse number="18" style="v" />Na kholungthyhpaw roi tuh</para>
  <para style="q2">khiccung kya um zah;</para>
  <para style="q1">na khozawlaekuhpaw nynh</para>
  <para style="q2">laephipi kha a awsah;</para>
  <para style="q2">laephi tuh thyngkuh zah ahy.</para>
  <para style="q1">
    <verse number="19" style="v" />Nang tuh rili kyakhate na cceih,</para>
  <para style="q2">na laanpi tuh akopaw</para>
  <para style="q2">tui kya po a cceih;</para>
  <para style="q1">tuhzemah na ccunoh tuh</para>
  <para style="q2">muih kho thua khyh.</para>
  <para style="q1">
    <verse number="20" style="v" />Moses te Aaron kuih khate</para>
  <para style="q2">na ccungccaw hae kha</para>
  <para style="q1">tuuphu hawte na cciakhae hae.</para>
  <chapter number="78" style="c" />
  <para style="s1">Pachia Hoynaw te Israel hae Nythya leinaw</para>
  <para style="d">Asaf Byarui</para>
  <para style="q1">
    <verse number="1" style="v" />Pou ka ccungccaw hae,</para>
  <para style="q2">ka ccangpyanaw hynh ngaetua oh;</para>
  <para style="q1">ka hopaw bya kalan hin</para>
  <para style="q2">nae nakaring kha oun tuaku tua oh.</para>
  <para style="q1">
    <verse number="2" style="v" />Tousenaw phungpaw kha ka ho cih zah,</para>
  <para style="q2">langmawlya e byakhupaw kha ka ho cih,<note caller="-" style="x"><char style="xo" closed="false">78.2: </char><char style="xt" closed="false"><ref loc="MAT 13:35">Mat 13.35</ref></char></note></para>
  <para style="q1">
    <verse number="3" style="v" />tuh-e tuh ah minpaaw hae nynh</para>
  <para style="q2">aening oun hopya hae paw,</para>
  <para style="q1">ah thae vae oh paw te</para>
  <para style="q2">ah ny vae oh paw kha nynh thua.</para>
  <para style="q1">
    <verse number="4" style="v" />Tuh-e bya hae tuh ah ccaaw hae kha</para>
  <para style="q2">thuruhpya lei lan hae;</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kya-e alesaepaw</para>
  <para style="q2">ryalaw hae,</para>
  <para style="q1">a thawzung te a la cyipaw</para>
  <para style="q2">ngaeangnaw hae kha</para>
  <para style="q1">yn thua cih paw she e</para>
  <para style="q2">ccungccaw hae kya hopya lan hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Jakob ciihan kya</para>
  <para style="q2">phunglang kha tynsah zah,</para>
  <para style="q1">Israel hae kya upadi kha a nung,</para>
  <para style="q2">tuh-e tuh mih ccaaw hae kya</para>
  <para style="q1">ccangpya khylan ah minpaaw hae kha</para>
  <para style="q2">kaw a la pya hae paw nynh thua.</para>
  <para style="q1">
    <verse number="6" style="v" />Tuhcite a pui loh lei hae paw</para>
  <para style="q2">malang she e mih ccaaw hae nynh</para>
  <para style="q1">a nyhbua cih hae, minmin tuh</para>
  <para style="q2">oun lethung cih hae zah,</para>
  <para style="q1">mih ccaaw hae kha</para>
  <para style="q2">a hopah pathy cih hae,</para>
  <para style="q1">
    <verse number="7" style="v" />tuhteze nynh Pachia kha</para>
  <para style="q2">a ngaehoikuh cih hae zah,</para>
  <para style="q1">Pachia ryalaw kha ning leite</para>
  <para style="q2">a kawbya kha a zui cih hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Minmin tuh mih minpaaw hae te</para>
  <para style="q2">lokuh lan khyh hae,</para>
  <para style="q1">mih minpaaw hae tuh</para>
  <para style="q2">alungkhungpaw te</para>
  <para style="q1">rawse a mang hae paw phin,</para>
  <para style="q2">thinlung atyn lei hae paw phin,</para>
  <para style="q1">Pachia tungvaw lungzinaw</para>
  <para style="q2">a hoi lei hae paw nynh thua hae.</para>
  <para style="q1">
    <verse number="9" style="v" />The te li a mang hae paw</para>
  <para style="q2">Efraim phin hae tuh</para>
  <para style="q1">rhawtuk nin kya vae tuh</para>
  <para style="q2">nulang a ki hae.</para>
  <para style="q1">
    <verse number="10" style="v" />Minmin nynh Pachia byakin kha</para>
  <para style="q2">zui khyh hae,</para>
  <para style="q2">a upadi thyhte zui lan a ei hae.</para>
  <para style="q1">
    <verse number="11" style="v" />A la cyipaw te a langsapyakuh hae paw</para>
  <para style="q2">ngaeangnaw hae kha minmin nynh</para>
  <para style="q2">phe a ning hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Izip ram, Zoan bialae kya,</para>
  <para style="q2">mih minpaaw hae muihnaw kyakhe</para>
  <para style="q2">ngaeangnaw hae kha a rae.<note caller="-" style="x"><char style="xo" closed="false">78.12: </char><char style="xt" closed="false"><ref loc="EXO 7:8-12:32">Exo 7.8—12.32</ref></char></note></para>
  <para style="q1">
    <verse number="13" style="v" />Rili kha thoh phiasakuh zah,</para>
  <para style="q2">minmin kha po a zuasah hae,</para>
  <para style="q2">te tui kha pang hawte a thadynsah.<note caller="-" style="x"><char style="xo" closed="false">78.13: </char><char style="xt" closed="false"><ref loc="EXO 14:21-22">Exo 14.21-22</ref></char></note></para>
  <para style="q1">
    <verse number="14" style="v" />Khuadae ccyh kya maeking te</para>
  <para style="q2">cciakhae hae zah, khuazi zidae</para>
  <para style="q2">maee awpaw te a cciakhae hae.<note caller="-" style="x"><char style="xo" closed="false">78.14: </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">Exo 13.21-22</ref></char></note></para>
  <para style="q1">
    <verse number="15" style="v" />Ramkaw kya lungpi hae kha koi zah,</para>
  <para style="q2">rili kya-e tui hawkhate minmin kha</para>
  <para style="q2">a niasah hae.<note caller="-" style="x"><char style="xo" closed="false">78.15-16: </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">Exo 17.1-7</ref>; <ref loc="NUM 20:2-13">Nam 20.2-13</ref></char></note></para>
  <para style="q1">
    <verse number="16" style="v" />Lungpi kyate vaw hae kha pousah zah,</para>
  <para style="q2">tui kha vawpi hae hawte a luasah hae.</para>
  <para style="q1">
    <verse number="17" style="v" />Tuhzemah ramkaw kya</para>
  <para style="q2">Ahang Huaccepaw kha rawsete</para>
  <para style="q2">minmin nynh houh a sei ung hae.</para>
  <para style="q1">
    <verse number="18" style="v" />A ry hae paw looh kha ngiakute</para>
  <para style="q2">mih thinlung kya Pachia kha</para>
  <para style="q2">a syntawtua hae.<note caller="-" style="x"><char style="xo" closed="false">78.18-31: </char><char style="xt" closed="false"><ref loc="EXO 16:2-15">Exo 16.2-15</ref>; <ref loc="NUM 11:4-23">Nam 11.4-23</ref>, <ref loc="NUM 11:31-35">31-35</ref></char></note></para>
  <para style="q1">
    <verse number="19" style="v" />Minmin nynh Pachia kha rawsete,</para>
  <para style="q2">“Pachia nynh ramkaw kya</para>
  <para style="q2">ccaboi kha phae kho vema?</para>
  <para style="q1">
    <verse number="20" style="v" />Tui a pou ccaw cite lungpi kha</para>
  <para style="q2">bua zah, tui tuh a pou,</para>
  <para style="q1">sanlou so yn pya kho vema?</para>
  <para style="q2">a ccungccaw hae elang saw so</para>
  <para style="q1">oun khangpah kho vema?”</para>
  <para style="q2">cite a ho hae.</para>
  <para style="q1">
    <verse number="21" style="v" />
    <char style="nd">Bawipaw </char> nynh tuh-e bya</para>
  <para style="q2">he a thae te, a thin myarya ria;</para>
  <para style="q1">Jakob ciihan tungvaw maeerua zah,</para>
  <para style="q2">Israel tungvaw a thinrianaw tuh</para>
  <para style="q2">alethung,</para>
  <para style="q1">
    <verse number="22" style="v" />pawccecize Pachia kha</para>
  <para style="q2">zyn khyh hae zah,</para>
  <para style="q1">a khumnaw huhan kha</para>
  <para style="q2">doliakuh khyh hae.</para>
  <para style="q1">
    <verse number="23" style="v" />Tuhzemah aning nynh ahangnaw</para>
  <para style="q2">vaawlui kha kawpya zah,</para>
  <para style="q2">vaawlang thuakaw kha a hung;</para>
  <para style="q1">
    <verse number="24" style="v" />a ae lan hae cite manna sanlou kha</para>
  <para style="q2">khuaa lang rawsah zah,</para>
  <para style="q2">vaawlang looh kha a pya hae.<note caller="-" style="x"><char style="xo" closed="false">78.24: </char><char style="xt" closed="false"><ref loc="JHN 6:31">Joh 6.31</ref></char></note></para>
  <para style="q1">
    <verse number="25" style="v" />Ccungccaw hae nynh</para>
  <para style="q2">vaawccungccaw hae sanlou kha a ae hae;</para>
  <para style="q1">Pachia nynh minmin kha</para>
  <para style="q2">looh patae a pya hae.</para>
  <para style="q1">
    <verse number="26" style="v" />Vaawlui khe nithua lang e</para>
  <para style="q2">khisan kha zawsah zah,</para>
  <para style="q1">a huhan te alia lang e khisan kha</para>
  <para style="q2">a zawsah;</para>
  <para style="q1">
    <verse number="27" style="v" />saw kha vuiping hawte,</para>
  <para style="q2">azouthyapaw pavaw hae kha</para>
  <para style="q1">rili laesia zeihte khuaa lang</para>
  <para style="q2">a rawsahpya hae,</para>
  <para style="q1">
    <verse number="28" style="v" />tuh-e tuh mih ryahmin lungkhu,</para>
  <para style="q2">a umnaw hae pepan balyn khe a ccawsah.</para>
  <para style="q1">
    <verse number="29" style="v" />Tuhcite minmin a ry zeih hae te,</para>
  <para style="q2">aning nynh a pya hae keiccuze</para>
  <para style="q2">minmin nynh phe byn lan a ae hae.</para>
  <para style="q1">
    <verse number="30" style="v" />Thuasalama minmin nynh</para>
  <para style="q2">a byn maw hae,</para>
  <para style="q2">looh a ae cciamang lya hae khe,</para>
  <para style="q1">
    <verse number="31" style="v" />Pachia thinrianaw tuh mih tungvaw</para>
  <para style="q2">yn ccah zah, minmin kyaze</para>
  <para style="q1">a thunghua hae paw kha theih hae zah,</para>
  <para style="q2">Israel ccangvae hae kha a khulia hae.</para>
  <para style="q1">
    <verse number="32" style="v" />Israel hae nynh hynh-e balyn hynh</para>
  <para style="q2">a tung hae zemah a sei mamin hae;</para>
  <para style="q1">ngaeangthua lan umpaw</para>
  <para style="q2">a ryalaw hae kha minmin nynh</para>
  <para style="q2">zyn khyh hae.</para>
  <para style="q1">
    <verse number="33" style="v" />Tukeiccuze mih nin tuh hy hawte</para>
  <para style="q2">thangsah han zah,</para>
  <para style="q1">mih kum tuh myarya</para>
  <para style="q2">ri lan umpaw kyakhe a nung.</para>
  <para style="q1">
    <verse number="34" style="v" />Aning nynh minmin kha</para>
  <para style="q2">he a theih hae te,</para>
  <para style="q1">amaw kha a ccung hae;</para>
  <para style="q2">minmin nynh ngaesikuh hae zah</para>
  <para style="q2">Pachia kha thawte a ccung hae.</para>
  <para style="q1">
    <verse number="35" style="v" />Pachia tuh kae lungpi thua zah,</para>
  <para style="q2">kaening oun shawkhawtu</para>
  <para style="q1">Ahang Huaccepaw Pachia nynh thua</para>
  <para style="q2">cipaw oun liathui hae.</para>
  <para style="q1">
    <verse number="36" style="v" />Thuasalama mih khalang te amaw kha</para>
  <para style="q2">nawpalya lan poo hae zah,</para>
  <para style="q2">mih munglae te a ling hae.</para>
  <para style="q1">
    <verse number="37" style="v" />Mih thinlung tuh amaw kya tyn khyh;</para>
  <para style="q2">a byakinnaw kya mih lungzi khyh.</para>
  <para style="q1">
    <verse number="38" style="v" />Tuhzemah aning tuh thawccinaw a hoi,</para>
  <para style="q2">mih hoyleinaw kha ngaethya hae zah,</para>
  <para style="q2">minmin kha roh khyh hae;</para>
  <para style="q1">a thinrianaw kha atu te atu yhkuh zah,</para>
  <para style="q2">a thinrianaw balyn kha</para>
  <para style="q2">pousah leite a synku.</para>
  <para style="q1">
    <verse number="39" style="v" />Minmin tuh pynsaw sasaw thua hae zah,</para>
  <para style="q2">a zaw koute a kithui lei vae paw</para>
  <para style="q1">khisan hawte nynh athua hae</para>
  <para style="q2">cipaw a liathui.</para>
  <para style="q1">
    <verse number="40" style="v" />Minmin nynh amaw kha ramkaw kya</para>
  <para style="q2">atu te atu dou hae zah,</para>
  <para style="q2">laesia ram kya a ngae a thyasah hae!</para>
  <para style="q1">
    <verse number="41" style="v" />Pachia kha atu te atu</para>
  <para style="q2">syntawtua hae zah,</para>
  <para style="q1">Israel Pachia Athyaapaw kha</para>
  <para style="q2">a thinriasah hae.</para>
  <para style="q1">
    <verse number="42" style="v" />Amaw huhan kha thuasah,</para>
  <para style="q2">rhaw hae kyate a shawkhaw hae</para>
  <para style="q2">nin kha thuasah ccykekuh khyh hae;</para>
  <para style="q1">
    <verse number="43" style="v" />Izip ram kya muihsahnaw hae te</para>
  <para style="q2">Zoan bialae kya ngaeangnaw</para>
  <para style="q1">a langsapyaku hae paw kha mah</para>
  <para style="q2">phe ning hae.</para>
  <para style="q1">
    <verse number="44" style="v" />Mih vawkhu hae kha a nia kho</para>
  <para style="q2">khyh ccaw hae cite</para>
  <para style="q2">chiise lang a tangsah.<note caller="-" style="x"><char style="xo" closed="false">78.44: </char><char style="xt" closed="false"><ref loc="EXO 7:17-21">Exo 7.17-21</ref></char></note></para>
  <para style="q1">
    <verse number="45" style="v" />Minmin a bou hae paw</para>
  <para style="q2">kaekih hae kha thuasah,</para>
  <para style="q1">minmin a roh hae paw buphaw hae kha</para>
  <para style="q2">thuasah a sawnua hae.<note caller="-" style="x"><char style="xo" closed="false">78.45: </char><char style="xt" closed="false"><ref loc="EXO 8:1-6">Exo 8.1-6</ref>, <ref loc="EXO 8:20-24">20-24</ref></char></note></para>
  <para style="q1">
    <verse number="46" style="v" />Mih ccathae hae kha</para>
  <para style="q2">maccaloih hae kalan thuasah,</para>
  <para style="q1">mih ryalaw mee kha</para>
  <para style="q2">tungkhipaw hae kalan thuasah a pya hae.<note caller="-" style="x"><char style="xo" closed="false">78.46: </char><char style="xt" closed="false"><ref loc="EXO 10:12-15">Exo 10.12-15</ref></char></note></para>
  <para style="q1">
    <verse number="47" style="v" />Mih misu ku hae kha hya te roh zah,</para>
  <para style="q2">mih eboh ku hae kha dangtui te a ro.<note caller="-" style="x"><char style="xo" closed="false">78.47-48: </char><char style="xt" closed="false"><ref loc="EXO 9:22-25">Exo 9.22-25</ref></char></note></para>
  <para style="q1">
    <verse number="48" style="v" />Mih vaetua hae kha hya te theih zah,</para>
  <para style="q2">mih tuuphu hae kha ria te a chia.</para>
  <para style="q1">
    <verse number="49" style="v" />Mih tungvaw khe ri lan umpaw</para>
  <para style="q2">a thinrianaw, a thin-unaw,</para>
  <para style="q1">a bungpawnaw te a riathaenaw,</para>
  <para style="q2">ro a mang hae paw vaawccungccaw</para>
  <para style="q2">phu hae kha a sawnua hae.</para>
  <para style="q1">
    <verse number="50" style="v" />A thinrianaw kha yhku leite,</para>
  <para style="q2">mih hiinnaw kha haang khyh hae,</para>
  <para style="q2">shethya te phe chia hae.</para>
  <para style="q1">
    <verse number="51" style="v" />Izip ram kya ccatawccaw balyn kha thuasah,</para>
  <para style="q2">Ham ccungccaw hae innbyn raveih kya-e</para>
  <para style="q1">ccatawccaw pise miakaw kha thuasah</para>
  <para style="q2">a chia hae.<note caller="-" style="x"><char style="xo" closed="false">78.51: </char><char style="xt" closed="false"><ref loc="EXO 12:29">Exo 12.29</ref></char></note></para>
  <para style="q1">
    <verse number="52" style="v" />Te a ccungccaw hae kha</para>
  <para style="q2">tuu hae hawte cciakhae hae zah,</para>
  <para style="q1">tuuphu hawte ramkaw kya</para>
  <para style="q2">laan a mawpya hae.<note caller="-" style="x"><char style="xo" closed="false">78.52: </char><char style="xt" closed="false"><ref loc="EXO 13:17-22">Exo 13.17-22</ref></char></note></para>
  <para style="q1">
    <verse number="53" style="v" />Minmin kha khyndadyh lan</para>
  <para style="q2">cciakhae hae zah</para>
  <para style="q2">minmin tuh rih khyh hae;</para>
  <para style="q1">mih rhaw hae kha tuh rili nynh</para>
  <para style="q2">pong a vu hae.<note caller="-" style="x"><char style="xo" closed="false">78.53: </char><char style="xt" closed="false"><ref loc="EXO 14:26-28">Exo 14.26-28</ref></char></note></para>
  <para style="q1">
    <verse number="54" style="v" />Te minmin kha</para>
  <para style="q2">a ram thyaapaw kalan khe thuasah,</para>
  <para style="q1">a ranglang kuih te a tae vae paw</para>
  <para style="q2">mua langkhe thuasah a cciakhae hae.</para>
  <para style="q1">
    <verse number="55" style="v" />Mih malang te minphuin hae kha</para>
  <para style="q2">a dee hae; ram kha</para>
  <para style="q1">Israel minphuin hae kalan nee hae zah,</para>
  <para style="q2">tuin kya mih bu kyakhe</para>
  <para style="q1">khua a sah hae.<note caller="-" style="x"><char style="xo" closed="false">78.55: </char><char style="xt" closed="false"><ref loc="JOS 11:16-23">Jos 11.16-23</ref></char></note></para>
  <para style="q1">
    <verse number="56" style="v" />Tuhzemah minmin nynh</para>
  <para style="q2">Ahang Huaccepaw Pachia kha</para>
  <para style="q1">syntawtua hae zah a rawse hae.</para>
  <para style="q2">A phunglang kha zui khyh hae,<note caller="-" style="x"><char style="xo" closed="false">78.56: </char><char style="xt" closed="false"><ref loc="JDG 2:11-15">Bpt 2.11-15</ref></char></note></para>
  <para style="q1">
    <verse number="57" style="v" />mih minpaaw hae hawte</para>
  <para style="q2">maeleihkuh hae zah mih lungzi khyh;</para>
  <para style="q2">akoupaw li hawte a cceihsei hae.</para>
  <para style="q1">
    <verse number="58" style="v" />Minmin nynh mih khozi beiknaw</para>
  <para style="q2">hmin kha raete Pachia kha a thinriasah hae;</para>
  <para style="q1">mih zohtuh hae khate amaw kha</para>
  <para style="q2">eiungnaw a hoisah hae.</para>
  <para style="q1">
    <verse number="59" style="v" />Pachia nynh he a thae te,</para>
  <para style="q2">myaryamaw a thinria zah,</para>
  <para style="q2">Israel kha ccaring a vua.</para>
  <para style="q1">
    <verse number="60" style="v" />Aning nynh ccungccaw hae kya</para>
  <para style="q2">a la umnaw bu</para>
  <para style="q2">Shiloh khua kha a cciataw,<note caller="-" style="x"><char style="xo" closed="false">78.60: </char><char style="xt" closed="false"><ref loc="JOS 18:1">Jos 18.1</ref>; <ref loc="JER 7:12-14">Jer 7.12-14</ref>, <ref loc="JER 26:6">26.6</ref></char></note></para>
  <para style="q1">
    <verse number="61" style="v" />te a huhan kha rhaw hae kyngsah hae zah,</para>
  <para style="q2">a phu-enaw kha rhaw hae kuih kya</para>
  <para style="q2">a pya hae.<note caller="-" style="x"><char style="xo" closed="false">78.61: </char><char style="xt" closed="false"><ref loc="1SA 4:4-22">1Sa 4.4-22</ref></char></note></para>
  <para style="q1">
    <verse number="62" style="v" />A ccungccaw hae kha thaloi te</para>
  <para style="q2">chisah hae zah a rho tungvaw a thinria.</para>
  <para style="q1">
    <verse number="63" style="v" />Mih ccangvae hae tuh</para>
  <para style="q2">rhawtuknaw kya chih hae zah,</para>
  <para style="q1">mih liaccaw hae elang vawpaw lanpaw</para>
  <para style="q2">lu kheit san um vae khyh.</para>
  <para style="q1">
    <verse number="64" style="v" />Mih ranpibawi hae tuh thaloi te</para>
  <para style="q2">chih hae zah,</para>
  <para style="q1">mih nomae hae nynh rawkhuinaw kha</para>
  <para style="q2">rae vae khyh hae.</para>
  <para style="q1">
    <verse number="65" style="v" />Tetuh Bawipaw tuh inaw kyate</para>
  <para style="q2">a thopaw hawte yn tho,</para>
  <para style="q1">misutui keiccuze</para>
  <para style="q2">a rawhoypaw hawte yn tho.</para>
  <para style="q1">
    <verse number="66" style="v" />A rhaw hae kha phe tae dadi hae zah,</para>
  <para style="q2">maethyate zungzae a nung hae.</para>
  <para style="q1">
    <verse number="67" style="v" />Josef ciihan kha vua zah,</para>
  <para style="q2">Efraim phin kha po khyh;</para>
  <para style="q1">
    <verse number="68" style="v" />Judah phin te a sungsahpaw</para>
  <para style="q2">Zion Mua kha a po.</para>
  <para style="q1">
    <verse number="69" style="v" />A beikinnthyaa kha ahangpaw</para>
  <para style="q2">vaawlui hawte sak zah,</para>
  <para style="q1">zungzae atyn lan a raepaw</para>
  <para style="q2">laephi hawte a sak.</para>
  <para style="q1">
    <verse number="70" style="v" />A ryalahtu David kha po zah,</para>
  <para style="q2">tuukhia kya-e kha a ko;<note caller="-" style="x"><char style="xo" closed="false">78.70-71: </char><char style="xt" closed="false"><ref loc="1SA 16:11-12">1Sa 16.11-12</ref>; <ref loc="2SA 7:8">2Sa 7.8</ref>; <ref loc="1CH 17:7">1Sh 17.7</ref></char></note></para>
  <para style="q1">
    <verse number="71" style="v" />a ccungccaw athuapaw Jakob,</para>
  <para style="q2">amaw rho athuapaw</para>
  <para style="q1">Israel hae tuurinpaw thua khylan,</para>
  <para style="q2">a taw hae a do-oihpaw tuupinung hae</para>
  <para style="q2">a rinnaw kyakhate David kha a po.</para>
  <para style="q1">
    <verse number="72" style="v" />David nynh dingnaw thinlung khate</para>
  <para style="q2">minmin kha do-oih hae zah,</para>
  <para style="q1">hawnaw kuih khate laan a mawpya hae.</para>
  <chapter number="79" style="c" />
  <para style="s1">Jerusalem elang Ngianaw</para>
  <para style="d">Asaf Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou Pachia, minphuin hae nynh</para>
  <para style="q2">na rho lungkhu lang yn thua vae hae;</para>
  <para style="q1">athyaapaw na beikinnpi kha</para>
  <para style="q2">a thusah vae hae;</para>
  <para style="q2">Jerusalem kha a ro vae hae.<note caller="-" style="x"><char style="xo" closed="false">79.1: </char><char style="xt" closed="false"><ref loc="2KI 25:8-10">2Si 25.8-10</ref>; <ref loc="2CH 36:17-19">2Sh 36.17-19</ref>; <ref loc="JER 52:12-14">Jer 52.12-14</ref></char></note></para>
  <para style="q1">
    <verse number="2" style="v" />Na ryalahtu hae rhua kha</para>
  <para style="q2">vaawlang e pavaw hae kalan</para>
  <para style="q1">pya hae zah, alungzipaw</para>
  <para style="q2">na ccungccaw hae saw kha</para>
  <para style="q2">loramsaw hae kalan a pya vae hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Na ccungccaw hae chiise kha</para>
  <para style="q2">Jerusalem pepan balyn</para>
  <para style="q1">tui hawte luasah hae zah,</para>
  <para style="q2">mih rhua a uh lanpaw</para>
  <para style="q2">lu kheit san um khyh.</para>
  <para style="q1">
    <verse number="4" style="v" />Kaening tuh kae innpaw hae nynh</para>
  <para style="q2">saryapaw lang kae tang vae zah,</para>
  <para style="q1">kae pepan um hae paw nynh</para>
  <para style="q2">nuinsepaw te dothatheihpaw lang</para>
  <para style="q1">kae tang vae.</para>
  <para style="q1">
    <verse number="5" style="v" />Pou <char style="nd">Bawipaw </char>, hohseciamou</para>
  <para style="q2">na thinria cih?</para>
  <para style="q2">Zungzae na thinria cih tou?</para>
  <para style="q1">Na thinrianaw tuh maee hawte</para>
  <para style="q2">po rua cih tou?</para>
  <para style="q1">
    <verse number="6" style="v" />Nang ae nyh lei hae paw</para>
  <para style="q2">minphuin hae te</para>
  <para style="q1">na min ae ko lei hae paw</para>
  <para style="q2">peenaw hae kha thinrianua hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Pawccecize minmin nynh</para>
  <para style="q2">Jakob ciihan kha theih hae zah,</para>
  <para style="q1">a umnaw kha mah a ro hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Kae minpaaw hae seinaw keiccuze</para>
  <para style="q2">kaening hynh de oun tah nan;</para>
  <para style="q1">myarya kae nyaa keiccuze</para>
  <para style="q2">arangte thaw oun ccitua.</para>
  <para style="q1">
    <verse number="9" style="v" />Pou oun khumtu Pachia,</para>
  <para style="q2">Na min phu-enaw hanlan</para>
  <para style="q1">oun bawmtua, na min keiccuze</para>
  <para style="q2">oun luesah lah, kae seinaw</para>
  <para style="q2">oun ngaethya.</para>
  <para style="q1">
    <verse number="10" style="v" />Pawccemou minphuin hae nynh,</para>
  <para style="q2">“Mih Pachia tuh teimou um?”</para>
  <para style="q2">cite a ho hae?</para>
  <para style="q1">Na ryalahtu hae chiise kha</para>
  <para style="q2">a luasah keiccu hae ze,</para>
  <para style="q1">minphuin ccangpaw hae tungvaw</para>
  <para style="q2">na liarunaw hae paw kha</para>
  <para style="q1">kae mit nynh muih sah.</para>
  <para style="q1">
    <verse number="11" style="v" />Thongccah hae nynh</para>
  <para style="q2">a hawkhaeku hae paw</para>
  <para style="q1">roi kha thaepya tua hae;</para>
  <para style="q2">chia lan accan vae hae paw kha</para>
  <para style="q1">alesaepaw na huhan khate</para>
  <para style="q2">luesah tua hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Pou Bawipaw,</para>
  <para style="q2">kae innpaw hae nynh</para>
  <para style="q1">nang ae sarya hae keiccuze,</para>
  <para style="q2">leit sari te liaru hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Tetuh kaening na ccungccaw hae,</para>
  <para style="q2">na ramnonaw e tuuphu hae nynh</para>
  <para style="q1">na tungvaw zungzae kae lungtua cih;</para>
  <para style="q2">namaw thehoysahnaw bya kha</para>
  <para style="q1">she kheit koute she kheit kae ho cih.</para>
  <chapter number="80" style="c" />
  <para style="s1">Israel hanlan Sawsangnaw</para>
  <para style="d">Asaf Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Josef phin kha tuuphu hawte</para>
  <para style="q2">a cciakhaepaw,</para>
  <para style="q1">Pou Israel Tuurintu,</para>
  <para style="q2">beih yn ngaepya tua!</para>
  <para style="q1">Cherubim vawlan</para>
  <para style="q2">bawitungkhung kya a haungpaw,<note caller="-" style="x"><char style="xo" closed="false">80.1: </char><char style="xt" closed="false"><ref loc="EXO 25:22">Exo 25.22</ref></char></note></para>
  <para style="q1">
    <verse number="2" style="v" />Efraim, Benjamin te</para>
  <para style="q2">Manasseh phin hae malang khe</para>
  <para style="q1">na thawzung kha langsakute,</para>
  <para style="q2">kaening khum khylan</para>
  <para style="q1">oun thuatua!</para>
  <para style="q1">
    <verse number="3" style="v" />Pou Pachia, kaening hynh</para>
  <para style="q2">langmawlya hawte</para>
  <para style="q2">oun thuasah thui tua;</para>
  <para style="q1">khumnaw kae mue nawlan,</para>
  <para style="q2">na mitmae kha awsah tua.</para>
  <para style="q1">
    <verse number="4" style="v" />Pou <char style="nd">Bawipaw </char> vaaw Pachia,</para>
  <para style="q2">na ccungccaw hae sawsangnaw kya</para>
  <para style="q2">hohseciamou na thinria ung cih?</para>
  <para style="q1">
    <verse number="5" style="v" />Minmin kha mitphi sanlou</para>
  <para style="q2">na dang hae zah,</para>
  <para style="q1">nia lanpaw mitphi kha mah</para>
  <para style="q2">phe beih lan na pya vae hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Kaening hynh kae innpaw hae nynh</para>
  <para style="q2">saryapaw lang nae rae zah,</para>
  <para style="q1">kae rhaw hae nynh oun nuinse hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Pou vaaw <char style="nd">Bawipaw </char> Pachia,</para>
  <para style="q2">kaening hynh langmawlya hawte</para>
  <para style="q2">oun thuasah thui tua,</para>
  <para style="q1">khumnaw kae mue nawlan,</para>
  <para style="q2">na mitmae kha awsah tua.</para>
  <para style="q1">
    <verse number="8" style="v" />Izip ram kyate misu ku kukheit kha</para>
  <para style="q2">na cciakhae zah,</para>
  <para style="q1">ccangpaw minphuin hae kha</para>
  <para style="q2">na dee kou hae te, tuh-e misu ku tuh na lin.</para>
  <para style="q1">
    <verse number="9" style="v" />Tuh-e misu ku hanlan laephi kha</para>
  <para style="q2">na cciccaepya;</para>
  <para style="q1">a tharui saw zah,</para>
  <para style="q2">ram lungkhu phe abeih.</para>
  <para style="q1">
    <verse number="10" style="v" />A mynlyh nynh mua hae kha</para>
  <para style="q2">khaw hae zah,</para>
  <para style="q1">a karan hae nynh sidar ku pipi hae kha</para>
  <para style="q2">pong a bong hae;</para>
  <para style="q1">
    <verse number="11" style="v" />a karan hae tuh rili kyacia lo hae zah,</para>
  <para style="q2">a toihthaw hae paw tuh</para>
  <para style="q2">Vawpi kyacia phe a thua.</para>
  <para style="q1">
    <verse number="12" style="v" />Te laanpi po a cceih hae paw nynh</para>
  <para style="q2">a thae kha a loku ccaw hae cite,</para>
  <para style="q2">pawccemou a tureih kha na ropya?</para>
  <para style="q1">
    <verse number="13" style="v" />Nge nynh tuh-e aku tuh roh zah,</para>
  <para style="q2">loramsaw hae nynh a ae hae.</para>
  <para style="q1">
    <verse number="14" style="v" />Pou vaaw Pachia, yn maeleihku tua;</para>
  <para style="q2">vaawlang te dobung lah muihtua;</para>
  <para style="q1">e misu ku hynh do-oihtua,</para>
  <para style="q2">
    <verse number="15" style="v" />na ranglang kuih te na linpaw</para>
  <para style="q2">misu ku taraw hynh do-oihtua.</para>
  <para style="q1">
    <verse number="16" style="v" />Rhaw hae nynh maee te u hae zah,</para>
  <para style="q2">a nge vae hae;</para>
  <para style="q1">thinrianaw maesue te</para>
  <para style="q2">na thuiheinaw hae kyakhe roh hae sah.</para>
  <para style="q1">
    <verse number="17" style="v" />Thuasalama na ranglang kuih kya</para>
  <para style="q2">a umpaw ccungccaw,</para>
  <para style="q1">namaw elang a thaw na saesahpaw</para>
  <para style="q2">ccungccaw tungvaw khe</para>
  <para style="q2">na kuih kha khangtua.</para>
  <para style="q1">
    <verse number="18" style="v" />Tetuh namaw kyate nulang</para>
  <para style="q2">kharouh kae maeleihkuh vae lan khyh;</para>
  <para style="q1">hiinnaw oun pya lah,</para>
  <para style="q2">na min kae thehoysah cih.</para>
  <para style="q1">
    <verse number="19" style="v" />Pou <char style="nd">Bawipaw </char> vaaw Pachia,</para>
  <para style="q2">khumnaw kae mue nawlan,</para>
  <para style="q1">na mitmae kha awsah tua.</para>
  <chapter number="81" style="c" />
  <para style="s1">A Lungkhungpaw Israel</para>
  <para style="d">Asaf Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Ah thawzung athuapaw Pachia kalan</para>
  <para style="q2">lungtuate hlawsah oh;</para>
  <para style="q2">Jakob Pachia kalan lungtuate sia oh.</para>
  <para style="q1">
    <verse number="2" style="v" />Hlawsah oh lah, tyng kha thuasah,</para>
  <para style="q2">aroi hoypaw daw te tintang kha</para>
  <para style="q2">thuasah khuakuh oh.</para>
  <para style="q1">
    <verse number="3" style="v" />Sawpaw sahhangthung, sahpynglyn,</para>
  <para style="q2">aening poi nin kyakhe</para>
  <para style="q2">mungkae kha tu oh.<note caller="-" style="x"><char style="xo" closed="false">81.3: </char><char style="xt" closed="false"><ref loc="NUM 10:10">Nam 10.10</ref></char></note></para>
  <para style="q1">
    <verse number="4" style="v" />Pawccecize tuh-e tuh Israel hae hanlan</para>
  <para style="q2">phungbya thua zah,</para>
  <para style="q2">Jakob Pachia phungzae nynh thua.</para>
  <para style="q1">
    <verse number="5" style="v" />Izip ram kya po he a cceih te,</para>
  <para style="q2">Josef phin kya tuh-e phunglang tuh a rae.</para>
  <para style="q1">Ka thae boi leipaw roi ccangkheit</para>
  <para style="q2">ka thae zah, tuh-e roi nynh,</para>
  <para style="q1">
    <verse number="6" style="v" />“Na raw vawlan e phupaw kha</para>
  <para style="q2">kae lawpya vae;</para>
  <para style="q1">na kuih kha rya na lawnawpaw</para>
  <para style="q2">sua lungkhu te poh kae thuaapya vae.</para>
  <para style="q1">
    <verse number="7" style="v" />Vawsaw na tungnaw kyate nae ko zah,</para>
  <para style="q2">kae luesah vae;</para>
  <para style="q1">muih kho leinaw kholungthyhnaw</para>
  <para style="q2">hmin kyate nang kha kae leih vae;</para>
  <para style="q1">Meribah tui kyakhe</para>
  <para style="q2">nang kha kae syntawtua.<note caller="-" style="x"><char style="xo" closed="false">81.7: </char><char style="xt" closed="false"><ref loc="EXO 17:7">Exo 17.7</ref>; <ref loc="NUM 20:13">Nam 20.13</ref></char></note></para>
  <para style="q1">
    <verse number="8" style="v" />Pou ka ccungccaw hae, raeringnaw</para>
  <para style="q2">kae pya lya oh hin ngae oh;</para>
  <para style="q2">Pou Israel, ka bya hynh ngaetua!</para>
  <para style="q1">
    <verse number="9" style="v" />Nanning laku kya ramccang pachia</para>
  <para style="q2">um lan khyh;</para>
  <para style="q2">ramccang pachia kha na beik lan khyh oh.<note caller="-" style="x"><char style="xo" closed="false">81.9-10: </char><char style="xt" closed="false"><ref loc="EXO 20:2-3">Exo 20.2-3</ref>; <ref loc="DEU 5:6-7">Deu 5.6-7</ref></char></note></para>
  <para style="q1">
    <verse number="10" style="v" />Kae tuh Izip ram kyate ae poukhae oh paw</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nae Pachia nynh ka thua.</para>
  <para style="q1">Nae khalang kha haehae aw oh lah,</para>
  <para style="q2">kae baw cih oh.</para>
  <para style="q1">
    <verse number="11" style="v" />“Thuasalama ka ccungccaw hae nynh</para>
  <para style="q2">ka bya ngae khyh hae;</para>
  <para style="q2">Israel hae nynh ka kaw yn ngae khyh hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Tukeiccuze mih ry thyhte um hae sah cite,</para>
  <para style="q2">mih lungkhung thyhte ka cciasah hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Ka ccungccaw hae nynh ka bya kha</para>
  <para style="q2">ngae hae sah,</para>
  <para style="q2">Israel nynh ka laanpi kha a zui lanze,</para>
  <para style="q1">
    <verse number="14" style="v" />mih rhaw hae kha arangte</para>
  <para style="q2">ka taepah cih hae zah,</para>
  <para style="q1">minmin a rawse hae paw kha</para>
  <para style="q2">de ka tah cih hae.</para>
  <para style="q1">
    <verse number="15" style="v" />
    <char style="nd">Bawipaw </char> a hua hae paw tuh</para>
  <para style="q2">amaw malang rawrite</para>
  <para style="q2">a thyngkuh cih hae,</para>
  <para style="q1">minmin tungvaw detahnaw tuh</para>
  <para style="q2">zungzae atyn cih.</para>
  <para style="q1">
    <verse number="16" style="v" />Ahoy huapaw chanvuih te</para>
  <para style="q2">nanning kha kae dang cih oh zah,</para>
  <para style="q1">lungpi kya-e khoitui te phe byn lan</para>
  <para style="q2">kae dang cih oh,” a ci.</para>
  <chapter number="82" style="c" />
  <para style="s1">Byading hanlan Ngianaw</para>
  <para style="d">Asaf Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pachia tuh pachia hae</para>
  <para style="q2">a pumkunaw hae kyakhe um zah,</para>
  <para style="q1">pachia hae mih ngaelung khe</para>
  <para style="q2">byapianaw kha a rae.</para>
  <para style="q1">
    <verse number="2" style="v" />“Hohseciamou ahme lei lante</para>
  <para style="q2">bya na pia cih oh zah,</para>
  <para style="q1">ccungccaw hoylei hae paw tungvaw</para>
  <para style="q2">maedonaw kha na hoi cih oh?</para>
  <para style="q1">
    <verse number="3" style="v" />Ryachi hae te ngawraw hae kha</para>
  <para style="q2">byading te pankhaw oh; minyaa hae te</para>
  <para style="q1">bawmtu hoi lei hae paw kha</para>
  <para style="q2">ahmete byapiapah oh.</para>
  <para style="q1">
    <verse number="4" style="v" />Ryachi hae te minyaa hae kha luesah oh;</para>
  <para style="q2">ccungccaw hoylei hae kuih paw kyate</para>
  <para style="q1">khum oh,” a ci.</para>
  <para style="q1">
    <verse number="5" style="v" />Minmin tuh nynaw te thaethyanaw</para>
  <para style="q2">hoi khyh hae,</para>
  <para style="q1">mohnaw kya a khiavuikuh hae;</para>
  <para style="q2">laephi aleihpaw balyn tuh a hy hae.</para>
  <para style="q1">
    <verse number="6" style="v" />“Nanning tuh pachia hae nynh na thua oh,</para>
  <para style="q2">nanning balyn tuh Ahang Huaccepaw</para>
  <para style="q2">ccaaw hae nynh na thua oh;<note caller="-" style="x"><char style="xo" closed="false">82.6: </char><char style="xt" closed="false"><ref loc="JHN 10:34">Joh 10.34</ref></char></note></para>
  <para style="q1">
    <verse number="7" style="v" />thuasalama ccungccaw hawte</para>
  <para style="q2">na chih cih oh zah,</para>
  <para style="q1">siapharan lukhakheit hawte</para>
  <para style="q2">na khuliakuh cih oh,” ka ci.</para>
  <para style="q1">
    <verse number="8" style="v" />Pou Pachia, thokuh lah,</para>
  <para style="q2">laephi hynh byapiatua;</para>
  <para style="q1">pawccecize minphuin balyn tuh</para>
  <para style="q2">na kya-e nynh thua!</para>
  <chapter number="83" style="c" />
  <para style="s1">Rhaw hae Byapia khylan Sawsangnaw</para>
  <para style="d">Asaf Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou Pachia, yccae leite beih um nan;</para>
  <para style="q2">Pou Pachia, daebabi lan beih um nan!</para>
  <para style="q1">
    <verse number="2" style="v" />Na rhaw hae tuh atu heize</para>
  <para style="q2">siarisiarae a um hae;</para>
  <para style="q1">nang ae hua hae paw nynh mih lu kha</para>
  <para style="q2">a hangthung vae hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Na ccungccaw hae kha rawsete</para>
  <para style="q2">aruh lante khua a khannuaku hae;</para>
  <para style="q1">na thungkhawpaw ccungccaw hae kha</para>
  <para style="q2">rawsete pynkheihlan</para>
  <para style="q2">a paccynnuaku hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Minmin nynh, “Rang oh,</para>
  <para style="q2">mih minphuin khuh maemih oh sih;</para>
  <para style="q1">Israel min kha liathui thua lae</para>
  <para style="q2">nan vae sah,” a ciku hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Minmin nynh lunglokute</para>
  <para style="q2">khua a khanku hae;</para>
  <para style="q1">nang kha rawsete</para>
  <para style="q2">byakinkunaw a rae hae;</para>
  <para style="q1">
    <verse number="6" style="v" />tuh-e hae tuh: Edom ccungccaw hae,</para>
  <para style="q2">Ishmael ccungccaw hae;</para>
  <para style="q1">Moab ccungccaw hae,</para>
  <para style="q2">Hagri ccungccaw hae,</para>
  <para style="q1">
    <verse number="7" style="v" />Gebal ccungccaw hae,</para>
  <para style="q2">Ammon ccungccaw hae,</para>
  <para style="q1">Amalek ccungccaw hae,</para>
  <para style="q2">Filistin ccungccaw hae te</para>
  <para style="q2">Tair ccungccaw hae nynh thua hae;</para>
  <para style="q1">
    <verse number="8" style="v" />Assiria ccungccaw hae mah</para>
  <para style="q2">minmin kalan a panbua hae;</para>
  <para style="q1">Minmin tuh Lot ccaaw hae kya-e</para>
  <para style="q2">athungpaw thawzung nynh thua hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Midian ccungccaw hae tungvaw thuasah,</para>
  <para style="q2">Kishon Vawkhu kya-e Sisera te</para>
  <para style="q1">Jabin tungvaw thuasah</para>
  <para style="q2">na cyi hae hawte hynh-e hae hynh cyih hae,<note caller="-" style="x"><char style="xo" closed="false">83.9: </char><char style="xt" closed="false"><ref loc="JDG 4:6-22">Bpt 4.6-22</ref>, <ref loc="JDG 7:1-23">7.1-23</ref></char></note></para>
  <para style="q1">
    <verse number="10" style="v" />Sisera te Jabin tuh Endor kya</para>
  <para style="q2">na roh hae zah, mih rhua tuh</para>
  <para style="q2">laephi kya vaetua ia hawte phe thua hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Oreb te Zeeb tungvaw na cyi hawkhate</para>
  <para style="q2">mih bawi hae balyn kha cyih hae,</para>
  <para style="q1">mih siapharan hae kha mah Zebah te</para>
  <para style="q2">Zalmunna hawkhate cyih hae.<note caller="-" style="x"><char style="xo" closed="false">83.11: </char><char style="xt" closed="false"><ref loc="JDG 7:25">Bpt 7.25</ref>, <ref loc="JDG 8:12">8.12</ref></char></note></para>
  <para style="q1">
    <verse number="12" style="v" />Zebah te Zalmunna tuh, “Pachia ram kha</para>
  <para style="q2">ahmaw ram lang tangsah oh sih,”</para>
  <para style="q2">cite a ho hae paw nynh thua hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Pou ka Pachia, minmin kha</para>
  <para style="q2">khiccung nynh a mungpaw vuiping lang</para>
  <para style="q1">tangsah hae lah, khisan nynh</para>
  <para style="q2">a mungpaw vaekang lang tangsah hae.</para>
  <para style="q1">
    <verse number="14" style="v" />Maee nynh loram a u hawte thuasah,</para>
  <para style="q2">maeesoi nynh mua a u hawte thuasah,</para>
  <para style="q1">
    <verse number="15" style="v" />minmin kha khise te dee hae lah,</para>
  <para style="q2">na khisepi te sii hae.</para>
  <para style="q1">
    <verse number="16" style="v" />Pou <char style="nd">Bawipaw </char>, minmin nynh</para>
  <para style="q2">namaw min a ccung ccaw hae,</para>
  <para style="q2">mih maethyasah hae.</para>
  <para style="q1">
    <verse number="17" style="v" />Maethyanaw mue hae sah lah,</para>
  <para style="q2">zungzae mih lungroh sah;</para>
  <para style="q2">thethyate chih hae sah.</para>
  <para style="q1">
    <verse number="18" style="v" />Na min <char style="nd">Bawipaw </char> na cikuhpaw</para>
  <para style="q2">nang rou hynh nynh</para>
  <para style="q1">laephi pynpi kya Ahang Huaccepaw na thua</para>
  <para style="q2">cipaw nyh hae sah.</para>
  <chapter number="84" style="c" />
  <para style="s1">Beikinnpi kya Beikte Lungtuanaw<note caller="+" style="f"><char style="fr" closed="false">84 Abyalu: </char><char style="ft" closed="false">Korah phin hae hlaw.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Pou vaaw <char style="nd">Bawipaw </char>,</para>
  <para style="q2">na umnaw hmin tuh</para>
  <para style="q2">pawcih baban mou ry lan a um!</para>
  <para style="q1">
    <verse number="2" style="v" />
    <char style="nd">Bawipaw </char> beikinnpi kha</para>
  <para style="q2">ka muisaw nynh myaryamaw</para>
  <para style="q2">ngae zah a thawthang;</para>
  <para style="q1">ka thinlung te ka pyn nynh</para>
  <para style="q2">ahiinpaw Pachia kalan</para>
  <para style="q1">lungtuate hlaw a sah hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Pou vaaw <char style="nd">Bawipaw </char>,</para>
  <para style="q2">ka Siapharan te ka Pachia,</para>
  <para style="q1">rihthya nynh heize umnaw kha</para>
  <para style="q2">muihkuh zah,</para>
  <para style="q1">za-yeh pavaw nynh mah amaw hanlan</para>
  <para style="q2">bu a luaku,</para>
  <para style="q1">na silawhang pe khe mih taw hae kha</para>
  <para style="q2">a nung hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Na inn kya um hae paw tuh</para>
  <para style="q2">lungtua hae paw nynh thua hae,</para>
  <para style="q1">namaw kalan hlaw palei a sah hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Namaw kyate thawzung a mue hae paw,</para>
  <para style="q2">Zion Mua lang ccia lan a ry hae paw tuh</para>
  <para style="q2">lungtua hae paw nynh thua.</para>
  <para style="q1">
    <verse number="6" style="v" />Minmin nynh Baka accya kya</para>
  <para style="q2">a ccia lya hae khe, tuh-e accya tuh</para>
  <para style="q1">tuidy a pounaw hmin lang a tangsah hae;</para>
  <para style="q2">masaty rahpaw khuaatui nynh</para>
  <para style="q2">tuisung hae kha phe a biasah hae.</para>
  <para style="q1">
    <verse number="7" style="v" />A ccia lya hae khe</para>
  <para style="q2">mih thaw houhouh asae;</para>
  <para style="q1">pachia hae Pachia tuh Zion kya</para>
  <para style="q2">muih athua cih.</para>
  <para style="q1">
    <verse number="8" style="v" />Pou vaaw <char style="nd">Bawipaw </char>,</para>
  <para style="q2">ka sawsangnaw hynh yn thaepya tua;</para>
  <para style="q2">Pou Jakob Pachia, yn ngaepya tua!</para>
  <para style="q1">
    <verse number="9" style="v" />Pou oun thungkhawtu Pachia,</para>
  <para style="q2">chitui na thuhpaw mitmae kha dotua.</para>
  <para style="q1">
    <verse number="10" style="v" />Na beikinnpi lungkhu nin kheit um tuh</para>
  <para style="q2">ccangpaw hmin kya nin thong kheit</para>
  <para style="q1">um laeze ahoyhua.</para>
  <para style="q2">Pachia thuakaw ngawtu lang tang tuh</para>
  <para style="q1">ccungccaw hoyleipaw inn lungkhu</para>
  <para style="q2">um laeze ahoyhua.</para>
  <para style="q1">
    <verse number="11" style="v" />Pawccecize <char style="nd">Bawipaw </char> Pachia tuh</para>
  <para style="q2">khuanin thua zah</para>
  <para style="q2">thungkhawtu mah athua;</para>
  <para style="q1">aning nynh maehoynaw te</para>
  <para style="q2">sawtuanaw kha yn pya.</para>
  <para style="q1">Hmerarih lante ryalah hae paw kha</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh ahoypaw uccaw</para>
  <para style="q2">pya leite um khyh hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Pou vaaw <char style="nd">Bawipaw </char>,</para>
  <para style="q2">nang ae doliakuhpaw miakaw tuh</para>
  <para style="q1">lungtuapaw nynh thua.</para>
  <chapter number="85" style="c" />
  <para style="s1">Maehoynaw Mue khylan Sawsangnaw<note caller="+" style="f"><char style="fr" closed="false">85 Abyalu: </char><char style="ft" closed="false">Korah Phin hae Hlaw </char></note></para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char>, na ram tungvaw</para>
  <para style="q2">na lungrythua zah,</para>
  <para style="q2">Jakob ciihan hae kha bua na kikhae hae.</para>
  <para style="q1">
    <verse number="2" style="v" />Na ccungccaw hae hoyleinaw kha</para>
  <para style="q2">na ngaethya hae;</para>
  <para style="q2">mih seinaw balyn kha na ngaethya hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Na thinrianaw balyn kha na zosah zah,</para>
  <para style="q2">myarya lepaw na thinrianaw kha</para>
  <para style="q1">na daesah vae.</para>
  <para style="q1">
    <verse number="4" style="v" />Kaening oun khumtu, pou Pachia,</para>
  <para style="q2">langmawlya hawte</para>
  <para style="q2">oun thuasah thui lah,</para>
  <para style="q1">kae tungvaw na thinrianaw kha</para>
  <para style="q2">daesah ccavae.</para>
  <para style="q1">
    <verse number="5" style="v" />Kae tungvaw zungzae</para>
  <para style="q2">na thinria cih tou?</para>
  <para style="q1">Na thinrianaw tuh she takyh kya</para>
  <para style="q2">accyh po na saesah cih tou?</para>
  <para style="q1">
    <verse number="6" style="v" />Na ccungccaw hae nynh namaw kya</para>
  <para style="q2">mih lungtua nawlan,</para>
  <para style="q1">kaening hynh thawzung nae pyathui</para>
  <para style="q2">lan khyh tou?</para>
  <para style="q1">
    <verse number="7" style="v" />Pou <char style="nd">Bawipaw </char>, atynpaw</para>
  <para style="q2">na sungsahnaw kha</para>
  <para style="q1">oun langsapakuh lah,</para>
  <para style="q2">na khumnaw kha oun pyatua.</para>
  <para style="q1">
    <verse number="8" style="v" />
    <char style="nd">Bawipaw </char> Pachia nynh a ho cih paw</para>
  <para style="q2">bya kha yn thaesah tua,</para>
  <para style="q1">a ccungccaw hae, amaw kya</para>
  <para style="q2">mih lungzi hae paw,</para>
  <para style="q1">mih thinlung te amaw kalan</para>
  <para style="q2">a maeleihkuh hae paw kalan khe</para>
  <para style="q1">aning nynh daenaw bya kha</para>
  <para style="q2">a hopah cih hae.</para>
  <para style="q1">
    <verse number="9" style="v" />A phu-enaw tuh aening ram kya</para>
  <para style="q2">a um nawlan, a khumnaw tuh</para>
  <para style="q1">amaw a rih hae paw kuih kya nynh</para>
  <para style="q2">a um ccaccing.</para>
  <para style="q1">
    <verse number="10" style="v" />Atynpaw sungsahnaw te</para>
  <para style="q2">lungzinaw tuh</para>
  <para style="q1">a tungkuh cih hae;</para>
  <para style="q2">dingnaw te daenaw tuh</para>
  <para style="q2">a myngkuh cih hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Lungzinaw tuh laephi kyate</para>
  <para style="q2">a pouthung cih zah,</para>
  <para style="q1">dingnaw nynh vaawlui te</para>
  <para style="q2">a dobung cih.</para>
  <para style="q1">
    <verse number="12" style="v" />
    <char style="nd">Bawipaw </char> nynh hoynaw kha</para>
  <para style="q2">oun pya cih zah,</para>
  <para style="q2">ah ram nynh patae a voisah cih.</para>
  <para style="q1">
    <verse number="13" style="v" />Dingnaw tuh <char style="nd">Bawipaw </char> malang khe</para>
  <para style="q2">a cceih cih zah,</para>
  <para style="q1">a laanpi kha a raepah cih.</para>
  <chapter number="86" style="c" />
  <para style="s1">Bawmnaw Ngianaw</para>
  <para style="d">David Sawsangnaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, na nakaring tuakute</para>
  <para style="q2">yn ngaepah lah, yn leihtua,</para>
  <para style="q2">kae tuh ka ryachi zah ka ho ka bou.</para>
  <para style="q1">
    <verse number="2" style="v" />Kae tuh namaw kya ka lungzi keiccuze</para>
  <para style="q2">ka hiinnaw hynh yn thungkhawtua;</para>
  <para style="q1">nang ae doliakuhpaw</para>
  <para style="q2">na seepaw hynh yn khumtua.</para>
  <para style="q2">Nang tuh ka Pachia nynh na thua;</para>
  <para style="q1">
    <verse number="3" style="v" />Pou <char style="nd">Bawipaw </char>, na kalan anin ninlang</para>
  <para style="q2">ka sia keiccuze thaw beih yn ccitua.</para>
  <para style="q1">
    <verse number="4" style="v" />Pou <char style="nd">Bawipaw </char>, na kalan</para>
  <para style="q2">saw ka sang keiccuze</para>
  <para style="q2">na seepaw hynh ka lung yn tuasah tua.</para>
  <para style="q1">
    <verse number="5" style="v" />Pou <char style="nd">Bawipaw </char>, nang tuh na hoy,</para>
  <para style="q2">seingaethyanaw na hoi zah,</para>
  <para style="q1">na kalan saw a sang hae paw tungvaw</para>
  <para style="q2">atynpaw sungsahnaw te phe na beih.</para>
  <para style="q1">
    <verse number="6" style="v" />Pou <char style="nd">Bawipaw </char>, ka sawsangnaw hynh</para>
  <para style="q2">yn ngaepya tua; siaruate</para>
  <para style="q2">kae ngianaw hynh yn ngaepya tua.</para>
  <para style="q1">
    <verse number="7" style="v" />Nae leih cih keiccuze</para>
  <para style="q2">ka vawsaw ccyh lya nang kha kae ko.</para>
  <para style="q1">
    <verse number="8" style="v" />Pou <char style="nd">Bawipaw </char>, pachia hae laku kya</para>
  <para style="q2">nang ae lopaw um khyh,</para>
  <para style="q1">na cyipaw rya te alokuhpaw ccangpaw</para>
  <para style="q2">rya ccangkheit san um khyh.</para>
  <para style="q1">
    <verse number="9" style="v" />Pou <char style="nd">Bawipaw </char>, na raepaw</para>
  <para style="q2">minphuin balyn nynh</para>
  <para style="q2">oun cceih cih hae zah,</para>
  <para style="q1">na malang bakhungte na min kha</para>
  <para style="q2">ae thehoysah cih hae.<note caller="-" style="x"><char style="xo" closed="false">86.9: </char><char style="xt" closed="false"><ref loc="REV 15:4">Bya 15.4</ref></char></note></para>
  <para style="q1">
    <verse number="10" style="v" />Pawccecize nang tuh na lesae zah,</para>
  <para style="q2">ngaeangthua lan umpaw</para>
  <para style="q1">uccaw hae kha na rae;</para>
  <para style="q2">nang rou nynh Pachia na thua.</para>
  <para style="q1">
    <verse number="11" style="v" />Pou <char style="nd">Bawipaw </char>, na byaccing kya</para>
  <para style="q2">ka ccia ccaw,</para>
  <para style="q1">na laanpi kha yn ccangpya tua;</para>
  <para style="q2">na min kha sawtua khylan</para>
  <para style="q2">aphei leipaw thinlung yn pyatua.</para>
  <para style="q1">
    <verse number="12" style="v" />Pou <char style="nd">Bawipaw </char> ka Pachia,</para>
  <para style="q2">ka thinlung balyn te nang kha</para>
  <para style="q1">kae thehoysah zah,</para>
  <para style="q2">na min kha zungzae phu kae esah cih.</para>
  <para style="q1">
    <verse number="13" style="v" />Pawccecize ka hanlan atynpaw</para>
  <para style="q2">na sungsahnaw tuh myarya ale;</para>
  <para style="q1">akhunaw michi khua kyate</para>
  <para style="q2">ka muisaw kha nae luesah vae.</para>
  <para style="q1">
    <verse number="14" style="v" />Pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">a lysakuh hae paw nynh</para>
  <para style="q1">rawsete yn thonuaku hae;</para>
  <para style="q2">mih rysawthah hae paw phu nynh</para>
  <para style="q1">nang kha pawlangria leite</para>
  <para style="q2">kae kha chia lan a zuaku hae.</para>
  <para style="q1">
    <verse number="15" style="v" />Pou <char style="nd">Bawipaw </char>, nang tuh</para>
  <para style="q2">thawccih thyapaw te</para>
  <para style="q1">ngaethyaumsah thyapaw,</para>
  <para style="q2">a lungsaepaw, atynpaw sungsahnaw te</para>
  <para style="q1">phe abeihpaw te a lungzipaw</para>
  <para style="q2">Pachia nynh na thua.</para>
  <para style="q1">
    <verse number="16" style="v" />Ka kalan yn maeleihkuh lah,</para>
  <para style="q2">thaw yn ccitua; na seepaw hynh</para>
  <para style="q1">na thawzung yn pyabua;</para>
  <para style="q2">na seenung ccaaw hynh yn khumtua.</para>
  <para style="q1">
    <verse number="17" style="v" />Na kya-e ahoypaw muihsahnaw kha</para>
  <para style="q2">yn langsapyaku tua,</para>
  <para style="q1">tuhteze nynh kae yn hua hae paw nynh</para>
  <para style="q2">tuh-e tuh a muih cih hae zah,</para>
  <para style="q1">mih maethah cih,</para>
  <para style="q2">pawccecize <char style="nd">Bawipaw </char> nynh</para>
  <para style="q1">yn bawm vae zah,</para>
  <para style="q2">ka ngae yn ngansah vae.</para>
  <para style="q1">ae thehoysah cih hae.</para>
  <chapter number="87" style="c" />
  <para style="s1">Zion kya Lungtuanaw<note caller="+" style="f"><char style="fr" closed="false">87 Abyalu: </char><char style="ft" closed="false">Korah phin hae hlaw.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Pachia nynh a raepaw khuapi tuh</para>
  <para style="q2">athyaapaw mua vawlan khe a um;</para>
  <para style="q1">
    <verse number="2" style="v" />
    <char style="nd">Bawipaw </char> nynh Zion thuakaw kha</para>
  <para style="q2">Jakob a umnaw hmin balyn laeze</para>
  <para style="q2">a sungsahua.</para>
  <para style="q1">
    <verse number="3" style="v" />Pou Pachia khuapi,</para>
  <para style="q2">namaw konglang athuapaw</para>
  <para style="q2">aphu-epaw uccaw hae kong kha ho athua.</para>
  <para style="q1">
    <verse number="4" style="v" />Kae yn nyh hae paw kyakhe</para>
  <para style="q2">Rahab khua te Babilon khua kha</para>
  <para style="q1">ka hobia hae; Filistin ram,</para>
  <para style="q2">Tair ram te Ethiopia ram kha mah</para>
  <para style="q1">ka hobia,</para>
  <para style="q2">“E ram kya-e ccungccaw miakaw tuh</para>
  <para style="q2">tuin kya nynh a pui hae,” a ci hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Zion konglang te ho lanze,</para>
  <para style="q2">ccungccaw miakaw tuh</para>
  <para style="q1">tuin kya nynh a pui hae.</para>
  <para style="q2">Ahang Huaccepaw amaw ccaccei nynh</para>
  <para style="q2">tuh-e khua kha a tynsah cih.</para>
  <para style="q1">
    <verse number="6" style="v" />
    <char style="nd">Bawipaw </char> nynh ccungccaw hae kha</para>
  <para style="q2">ccazing he a lah hae te,</para>
  <para style="q1">“Ccungccaw miakaw tuh Zion kya</para>
  <para style="q2">nynh a pui hae,” cite a zeibia cih.</para>
  <para style="q1">
    <verse number="7" style="v" />Hlawsahthya hae paw te</para>
  <para style="q2">a lawthya hae paw nynh,</para>
  <para style="q1">“Nang tuh ka hythuanaw balyn</para>
  <para style="q2">yn phyhnaw tui anaw nynh na thua,”</para>
  <para style="q1">cite phe lokuh lante a ho cih hae.</para>
  <chapter number="88" style="c" />
  <para style="s1">Bawmnaw Mue khylan Sawsangnaw<note caller="+" style="f"><char style="fr" closed="false">88 Abyalu: </char><char style="ft" closed="false">Korah phin hae hlaw.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, yn khumtu Pachia,</para>
  <para style="q2">khuazi khuadae na malang ka sia,</para>
  <para style="q1">
    <verse number="2" style="v" />ka sawsangnaw tuh na kya</para>
  <para style="q2">thua vae sah;</para>
  <para style="q1">na nakaring kha ka siaruanaw kalan</para>
  <para style="q2">yn tuaku tua.</para>
  <para style="q1">
    <verse number="3" style="v" />Pawccecize ka muisaw tuh</para>
  <para style="q2">vawsawnaw te phe beih zah,</para>
  <para style="q1">ka hiinnaw tuh Michi khua lang</para>
  <para style="q2">anaekuh vae.</para>
  <para style="q1">
    <verse number="4" style="v" />Kae tuh Hunghua lungkhu lang</para>
  <para style="q2">a ccah hae paw kya riabia ka thua vae;</para>
  <para style="q1">kae tuh bawmnaw</para>
  <para style="q2">a hoi leipaw hawte thuasah,</para>
  <para style="q1">
    <verse number="5" style="v" />michi rhua hae laku kya</para>
  <para style="q2">a vua hae paw hawte thuasah,</para>
  <para style="q1">theih hae zah shawku kya</para>
  <para style="q2">ahuekuhpaw hawte thuasah</para>
  <para style="q2">ka thua zah,</para>
  <para style="q1">na liathui vae lei hae paw hawte nynh</para>
  <para style="q2">ka thua vae,</para>
  <para style="q1">pawccecize minmin tuh na kuih kyate</para>
  <para style="q2">vua athua hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Kae kha Hunghua akhunaw,</para>
  <para style="q2">amohpaw te akhupaw hmin kya</para>
  <para style="q2">nae nung vae.</para>
  <para style="q1">
    <verse number="7" style="v" />Na thin-unaw nynh ka tungvaw</para>
  <para style="q2">rikalae lan yn ne zah,</para>
  <para style="q2">na tuileih balyn te nae vusah vae.</para>
  <para style="q1">
    <verse number="8" style="v" />Kae ccawkuh hae paw kha</para>
  <para style="q2">nae sibiasah vae hae;</para>
  <para style="q1">minmin nynh a ri hae paw lang</para>
  <para style="q2">nae rae vae.</para>
  <para style="q1">Ka pou kho lei lan nae khawsung vae;</para>
  <para style="q2">
    <verse number="9" style="v" />ngaethyanaw keiccuze</para>
  <para style="q2">ka mit houhouh amoh vae.</para>
  <para style="q1">Pou <char style="nd">Bawipaw </char>, nang kha</para>
  <para style="q2">nin takyh kae ko;</para>
  <para style="q2">ka kuih kha namaw kalan ka dyng.</para>
  <para style="q1">
    <verse number="10" style="v" />Michi hae elang ngaeangthua lan</para>
  <para style="q2">umpaw rya kha na lah tou?</para>
  <para style="q1">Michi hae nynh nang kha</para>
  <para style="q2">thehoysah khylan a thokuh hae tou?</para>
  <para style="q1">
    <verse number="11" style="v" />Atynpaw na sungsahnaw tuh</para>
  <para style="q2">shawku kya ho athua tou?</para>
  <para style="q1">Na lungzinaw kong kha</para>
  <para style="q2">ronaw hmin kya ho athua tou?</para>
  <para style="q1">
    <verse number="12" style="v" />Na kya-e ngaeangnaw hae kha</para>
  <para style="q2">mohnaw kya ny athua tou?</para>
  <para style="q1">Na kya-e khumnawpaw bawmnaw tuh</para>
  <para style="q2">ningnaw ram kya ny athua tou?</para>
  <para style="q1">
    <verse number="13" style="v" />Thuasalama, pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">kae tuh na kalan ka sia;</para>
  <para style="q1">awkhua ccyh kya ka sawsangnaw tuh</para>
  <para style="q2">na malang phe athua.</para>
  <para style="q1">
    <verse number="14" style="v" />Pou <char style="nd">Bawipaw </char>, pawccemou nae vua?</para>
  <para style="q2">Pawccemou na mae nae retawku?</para>
  <para style="q1">
    <verse number="15" style="v" />Ka di lya mawte vawsaw ka tung zah</para>
  <para style="q2">vyavya leih ka chih,</para>
  <para style="q1">detahnaw nae ingsah keiccuze</para>
  <para style="q2">myarya ka bang vae.</para>
  <para style="q1">
    <verse number="16" style="v" />Na thin-unaw nynh phang yn bong;</para>
  <para style="q2">ri lan umpaw na syronaw nynh</para>
  <para style="q2">kae kha yn ro.</para>
  <para style="q1">
    <verse number="17" style="v" />Tui alepaw hawte anin ninlang yn koihlu hae;</para>
  <para style="q2">voilang ranglang te yn naenuaku hae.</para>
  <para style="q1">
    <verse number="18" style="v" />Ka ruiban hae te ka innpaw hae nynh</para>
  <para style="q2">kae kha nae sibiasah hae;</para>
  <para style="q1">kae ccawkuh hae paw tuh</para>
  <para style="q2">mohnaw kya a um hae.</para>
  <chapter number="89" style="c" />
  <para style="s1">
    <note caller="-" style="x">
      <char style="xo" closed="false">89 Abyalu: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 4:31">1Si 4.31</ref>
      </char>
    </note>David kya Pachia Byakinnaw<note caller="+" style="f"><char style="fr" closed="false">89 Abyalu: </char><char style="ft" closed="false">Ezrah phinpaw Ethan hlaw.</char></note></para>
  <para style="r">(<ref loc="1KI 4:31">1Si 4.31</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, atynpaw</para>
  <para style="q2">na sungsahnaw kha hlaw te</para>
  <para style="q1">zungzae ka sah cih;</para>
  <para style="q2">na lungzinaw kha ka mung te</para>
  <para style="q2">she takyh ka siakhae cih.</para>
  <para style="q1">
    <verse number="2" style="v" />atynpaw na sungsahnaw tuh</para>
  <para style="q2">zungzae atyn cite ka ho;</para>
  <para style="q1">na lungzinaw tuh vaawlui hawte atyn.</para>
  <para style="q1">
    <verse number="3" style="v" />Namaw nynh, “Ka popaw</para>
  <para style="q2">ccungccaw kyakhe</para>
  <para style="q1">byakinnaw kha ka rae vae,</para>
  <para style="q2">ka seepaw David kha</para>
  <para style="q2">bya ka kinpakuh zah:</para>
  <para style="q1">
    <verse number="4" style="v" />‘Na ciihan tuh zungzae</para>
  <para style="q2">ka tynsah cih zah,</para>
  <para style="q1">na bawitungkhung tuh</para>
  <para style="q2">she takyh kya ka tynsah cih,’</para>
  <para style="q1">ka cipya,” cite na ho.<note caller="-" style="x"><char style="xo" closed="false">89.4: </char><char style="xt" closed="false"><ref loc="2SA 7:12-16">2Sa 7.12-16</ref>; <ref loc="1CH 17:11-14">1Sh 17.11-14</ref>; <ref loc="PSA 132:11">Sam 132.11</ref>; <ref loc="ACT 2:30">Loc 2.30</ref></char></note></para>
  <para style="q1">
    <verse number="5" style="v" />Pou <char style="nd">Bawipaw </char>, vaawlui hae nynh</para>
  <para style="q2">na raepaw ngaeangnaw hae kha thuasah,</para>
  <para style="q1">athyaapaw ccungccaw hae pumkunaw kyaze</para>
  <para style="q2">na lungzinaw kha thuasah</para>
  <para style="q2">ae thehoysah hae sah.</para>
  <para style="q1">
    <verse number="6" style="v" />Pawccecize vaawlui kya nang te</para>
  <para style="q2">touse lanpaw hummou a um?</para>
  <para style="q1">Vaawlui kya a um hae paw lakuze</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> te alokuhpaw</para>
  <para style="q2">hummou a um?</para>
  <para style="q1">
    <verse number="7" style="v" />Pachia tuh athyaapaw zapi hae laku kya</para>
  <para style="q2">ri lan umpaw nynh thua,</para>
  <para style="q1">a pepan um hae paw balyn laeze</para>
  <para style="q2">alesaepaw te ri lan umpaw nynh thua.</para>
  <para style="q1">
    <verse number="8" style="v" />Pou vaaw <char style="nd">Bawipaw </char> Pachia,</para>
  <para style="q2">nang hawte athawsaepaw hummou a um,</para>
  <para style="q2">pou <char style="nd">Bawipaw</char>?</para>
  <para style="q1">Na lungzinaw nynh namaw kha</para>
  <para style="q2">phang ae koihlu.</para>
  <para style="q1">
    <verse number="9" style="v" />Rili tuihu kha na uk zah,</para>
  <para style="q2">rili tuileih he atho ze, na daesah.</para>
  <para style="q1">
    <verse number="10" style="v" />Rahab kha sachihpaw hawte na ro;</para>
  <para style="q2">na rhaw hae kha athawsaepaw</para>
  <para style="q2">na kuih te phiariphiarae na nung hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Vaawlui hae tuh na uccaw thua zah,</para>
  <para style="q2">laephi mah namaw uccaw nynh thua;</para>
  <para style="q1">laephipi te a lungkhu</para>
  <para style="q2">umpaw balyn kha na rae.</para>
  <para style="q1">
    <verse number="12" style="v" />Palung lang te alia lang kha na rae;</para>
  <para style="q2">Tabor mua te Hermon mua nynh</para>
  <para style="q1">na min kha lungtuate</para>
  <para style="q2">the ae hoysah hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Nang tuh athungpaw kuih na hoi;</para>
  <para style="q2">na kuih tuh a thawsae zah,</para>
  <para style="q2">na ranglang kuih tuh ahang.</para>
  <para style="q1">
    <verse number="14" style="v" />Dingnaw te byading tuh</para>
  <para style="q2">na bawitungkhung aleihpaw nynh thua;</para>
  <para style="q1">atynpaw sungsahnaw te lungzinaw tuh</para>
  <para style="q2">na malang a cceih hae.</para>
  <para style="q1">
    <verse number="15" style="v" />Lungtuanaw roi a nyhpaw</para>
  <para style="q2">ccungccaw hae tuh</para>
  <para style="q1">lungtuapaw nynh thua hae:</para>
  <para style="q2">Pou <char style="nd">Bawipaw </char>, na mitmae awnaw</para>
  <para style="q1">lungkhu a cceih hae paw tuh</para>
  <para style="q2">lungtuapaw nynh thua hae;</para>
  <para style="q1">
    <verse number="16" style="v" />minmin tuh na min kyakhe</para>
  <para style="q2">anin ninlang mih lungtua zah,</para>
  <para style="q2">na dingnaw liate hangthung athua hae.</para>
  <para style="q1">
    <verse number="17" style="v" />Pawccecize nang tuh mih thawzung</para>
  <para style="q2">phu-enaw nynh na thua;</para>
  <para style="q1">na thawccinaw liate kae thungnaw ki tuh</para>
  <para style="q2">hangthung athua.</para>
  <para style="q1">
    <verse number="18" style="v" />Pawccecize kae khawriaphua tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kya-e thua zah,</para>
  <para style="q1">Israel kya-e Athyaapaw Pachia tuh</para>
  <para style="q2">kae siapharan tuh nynh thua.</para>
  <para style="q1">
    <verse number="19" style="v" />Te langmaw lyaze a lungzipaw</para>
  <para style="q2">na ccungccapaw kyakhe vizin te</para>
  <para style="q1">na hopah zah,</para>
  <para style="q2">“A thawsaepaw lukheitpaw kha</para>
  <para style="q1">bawilukhung ka khungsah vae,</para>
  <para style="q2">ccungccaw hae laku kyate</para>
  <para style="q1">po athuapaw lukheitpaw kha</para>
  <para style="q2">ka hangthung vae.</para>
  <para style="q1">
    <verse number="20" style="v" />Ka seepaw David kha ka muih vae;</para>
  <para style="q2">ka chitui athyaapaw te amaw kha</para>
  <para style="q2">ka thuh vae;<note caller="-" style="x"><char style="xo" closed="false">89.20: </char><char style="xt" closed="false"><ref loc="1SA 13:14">1Sa 13.14</ref>; <ref loc="ACT 13:22">Loc 13.22</ref>; <ref loc="1SA 16:12">1Sa 16.12</ref></char></note></para>
  <para style="q1">
    <verse number="21" style="v" />ka kuih tuh amaw kya</para>
  <para style="q2">a um zungzae cih;</para>
  <para style="q1">ka kuih nynh mah amaw kha</para>
  <para style="q2">thawzung a pya cih.</para>
  <para style="q1">
    <verse number="22" style="v" />Rhaw nynh amaw kha</para>
  <para style="q2">tae lan khyh zah,</para>
  <para style="q1">ccungccaw hoyleipaw nynh</para>
  <para style="q2">amaw kha tae lan khyh.</para>
  <para style="q1">
    <verse number="23" style="v" />A rhaw hae kha amaw malang khe</para>
  <para style="q2">ka roh cih hae zah,</para>
  <para style="q1">amaw a huatu hae paw kha</para>
  <para style="q2">ka theih cih hae.</para>
  <para style="q1">
    <verse number="24" style="v" />Ka lungzinaw te atynpaw</para>
  <para style="q2">ka sungsahnaw tuh a tungvaw</para>
  <para style="q1">a um cih zah,</para>
  <para style="q2">ka min liate a thungnaw ki tuh</para>
  <para style="q2">hangthung athua cih.</para>
  <para style="q1">
    <verse number="25" style="v" />A kuih tuh rili vawlan</para>
  <para style="q2">ka khang cih zah,</para>
  <para style="q1">a ranglang kuih tuh vawpi hae vawlan</para>
  <para style="q2">ka khang cih.</para>
  <para style="q1">
    <verse number="26" style="v" />Aning nynh kamaw kalan khe,</para>
  <para style="q2">‘Nang tuh ka Paaw, ka Pachia te</para>
  <para style="q1">yn khumtu Lungpi nynh na thua!’</para>
  <para style="q2">cite a sia cih.</para>
  <para style="q1">
    <verse number="27" style="v" />Aning kha ccatawccaw,</para>
  <para style="q2">laephi siapharan hae kyaze</para>
  <para style="q2">ahang huaccepaw lan ka rae cih.<note caller="-" style="x"><char style="xo" closed="false">89.27: </char><char style="xt" closed="false"><ref loc="REV 1:5">Bya 1.5</ref></char></note></para>
  <para style="q1">
    <verse number="28" style="v" />Atynpaw ka sungsahnaw kha</para>
  <para style="q2">a tungvaw ka tynsah zungzae cih zah,</para>
  <para style="q1">ka byakinnaw tuh amaw kya</para>
  <para style="q2">tynkaring lan a um cih.</para>
  <para style="q1">
    <verse number="29" style="v" />A ciihan kha zungzae</para>
  <para style="q2">ka tynsah cih zah,</para>
  <para style="q1">a bawitungkhung kha vaawlui</para>
  <para style="q2">atyn lungkhu balyn po atyn cih.</para>
  <para style="q1">
    <verse number="30" style="v" />A ccaaw hae nynh ka phung kha</para>
  <para style="q2">vua hae zah,</para>
  <para style="q1">ka phungzae thyhte</para>
  <para style="q2">a zui khyh hae ze thuasah,</para>
  <para style="q1">
    <verse number="31" style="v" />ka phunglang kha</para>
  <para style="q2">pawlangria khyh hae zah,</para>
  <para style="q1">ka kawbya kha</para>
  <para style="q2">a zui khyh hae ze thuasah,</para>
  <para style="q1">
    <verse number="32" style="v" />mih cyiseinaw keiccuze</para>
  <para style="q2">tungbang te thuasah,</para>
  <para style="q1">mih hoyleinaw keiccuze ccinaw</para>
  <para style="q2">alepaw te thuasah de ka tah cih hae;</para>
  <para style="q1">
    <verse number="33" style="v" />thuasalama atynpaw ka sungsahnaw kha</para>
  <para style="q2">amaw kyate ka nue lan khyh,</para>
  <para style="q1">ka lungzinaw kha mah</para>
  <para style="q2">ka roh lan khyh.</para>
  <para style="q1">
    <verse number="34" style="v" />Ka byakinnaw kha ka roh lan khyh,</para>
  <para style="q2">ka mung kyate a poupaw bya kha</para>
  <para style="q2">ka paleih lan khyh.</para>
  <para style="q1">
    <verse number="35" style="v" />David kha ka hynpah lan khyh cite</para>
  <para style="q2">athyaapaw ka thuanaw liate vaekheit te</para>
  <para style="q2">zungzae hanlan bya ka kinku.</para>
  <para style="q1">
    <verse number="36" style="v" />A ciihan tuh zungzae po atyn cih,</para>
  <para style="q2">a bawitungkhung tuh khuanin hawte</para>
  <para style="q2">ka malang atyn cih.</para>
  <para style="q1">
    <verse number="37" style="v" />Tuh-e tuh sawpaw hawte thuasah,</para>
  <para style="q2">vaawlui kyaze a lungzipaw</para>
  <para style="q1">ccaekia hawte thuasah</para>
  <para style="q2">zungzae atyn cih,” na ci.</para>
  <para style="q1">
    <verse number="38" style="v" />Thuasalama atu tuh amaw kha</para>
  <para style="q2">na vua zah na cciataw vae;</para>
  <para style="q1">chitui na thuhpaw tungvaw</para>
  <para style="q2">myarya na thinria vae.</para>
  <para style="q1">
    <verse number="39" style="v" />Na seepaw kya na raepaw</para>
  <para style="q2">byakinnaw kha phe na ro vae;</para>
  <para style="q1">a bawilukhung kha vuiping kya</para>
  <para style="q2">na thusah vae.</para>
  <para style="q1">
    <verse number="40" style="v" />A khualungrua balyn kha</para>
  <para style="q2">marya na tingsahpya vae;</para>
  <para style="q2">a rhawlungrua kha na ropya vae.</para>
  <para style="q1">
    <verse number="41" style="v" />A cceih bungthung hae paw balyn nynh</para>
  <para style="q2">amaw kha a luade hae;</para>
  <para style="q1">aning tuh a innpaw hae nynh</para>
  <para style="q2">a sarya hae paw lang a tang.</para>
  <para style="q1">
    <verse number="42" style="v" />A rhaw hae mih ranglang kuih kha</para>
  <para style="q2">na hangthung vae hae;</para>
  <para style="q1">a rhaw hae balyn kha mih lung</para>
  <para style="q2">na tuasah vae hae.</para>
  <para style="q1">
    <verse number="43" style="v" />Tuhpiaze, a thaloi haw kha</para>
  <para style="q2">na paleihpah zah,</para>
  <para style="q1">rhawtuknaw kya amaw kha</para>
  <para style="q2">na pankhae vae khyh.</para>
  <para style="q1">
    <verse number="44" style="v" />A kuih kyate ccoi kha na lawpah zah,</para>
  <para style="q2">a bawitungkhung kha laekhu lang</para>
  <para style="q2">na vuapya vae.</para>
  <para style="q1">
    <verse number="45" style="v" />A ngawphue ccyh kha na dynsahpah zah,</para>
  <para style="q2">maethya na bong vae.</para>
  <para style="q1">
    <verse number="46" style="v" />Pou <char style="nd">Bawipaw </char>, hohseciamou,</para>
  <para style="q2">zungzae tetou na rekuh cih?</para>
  <para style="q1">Hohseciamou na thin-unaw tuh</para>
  <para style="q2">maee hawte arua cih?</para>
  <para style="q1">
    <verse number="47" style="v" />Ka ccyh tuh hohcihmou</para>
  <para style="q2">adyn cipaw ning nan lah,</para>
  <para style="q1">ccungccaw hae balyn hynh a chihthya lante</para>
  <para style="q2">na raepaw nynh thua cipaw liathuitua!</para>
  <para style="q1">
    <verse number="48" style="v" />Chi leite a hiin khopaw</para>
  <para style="q2">hummou a um?</para>
  <para style="q1">Michi khua huhan kyate</para>
  <para style="q2">hummou a lue kho?</para>
  <para style="q1">
    <verse number="49" style="v" />Pou <char style="nd">Bawipaw </char>, na lungzinaw te</para>
  <para style="q2">David kya bya na kinpyakupaw</para>
  <para style="q1">langmawlya e atynpaw</para>
  <para style="q2">na sungsahnaw kha</para>
  <para style="q2">teimou a um vae?</para>
  <para style="q1">
    <verse number="50" style="v" />Pou <char style="nd">Bawipaw </char>, na seepaw nynh</para>
  <para style="q2">hohcihmou saryanaw</para>
  <para style="q1">ka teing cipaw liathuitua;</para>
  <para style="q2">ccungccaw hae nynh</para>
  <para style="q1">saryakunaw kha ka by kya</para>
  <para style="q2">hohcihmou ka poi cipaw kha</para>
  <para style="q2">mah liathuitua.</para>
  <para style="q1">
    <verse number="51" style="v" />Pou <char style="nd">Bawipaw </char>, na rhaw hae nynh</para>
  <para style="q2">chitui na thuhpaw kha a sarya hae,</para>
  <para style="q2">a ccianaw miakaw kya a sarya hae.</para>
  <para style="q1">
    <verse number="52" style="v" />
    <char style="nd">Bawipaw </char> tuh zungzae te</para>
  <para style="q2">thehoysah thua sah.</para>
  <para style="q2">Amen, Amen.</para>
  <chapter number="90" style="c" />
  <para style="ms">UK 4</para>
  <para style="mr">(<ref loc="PSA 90-106">Sam 90—106</ref>)</para>
  <para style="s1">Pachia te Ccungccaw</para>
  <para style="d">Moses Sawsangnaw</para>
  <para style="q1">
    <verse number="1" style="v" />Bawipaw, nang tuh she takyh kya</para>
  <para style="q2">kae khynnaw nynh na thua.</para>
  <para style="q1">
    <verse number="2" style="v" />Mua hae na rae mawze,</para>
  <para style="q2">laephi pynpi na rae mawze</para>
  <para style="q1">nang tuh athonaw kyate</para>
  <para style="q2">athangnaw kyacia</para>
  <para style="q1">Pachia nynh na thua.</para>
  <para style="q1">
    <verse number="3" style="v" />Ccungccaw hynh laenoi kalan</para>
  <para style="q2">nae kisah zah,</para>
  <para style="q2">“Ccungccaw hae nanning, ki oh,” na ci.</para>
  <para style="q1">
    <verse number="4" style="v" />Na malang tuh kum thong kheit hynh</para>
  <para style="q2">athang vae paw inkhawnin hawte thua zah,</para>
  <para style="q2">khuazi ccyh ccyhkheit hawte nynh athua.<note caller="-" style="x"><char style="xo" closed="false">90.4: </char><char style="xt" closed="false"><ref loc="2PE 3:8">2Pe 3.8</ref></char></note></para>
  <para style="q1">
    <verse number="5" style="v" />Ccungccaw hae kha phe thyaa lan</para>
  <para style="q2">na phi hae;</para>
  <para style="q2">minmin tuh maan hawte thua hae zah,</para>
  <para style="q1">awkhua ccyh kya atoih thawpaw</para>
  <para style="q2">lonua hawte nynh athua hae;</para>
  <para style="q1">
    <verse number="6" style="v" />tuh-e lonua tuh awkhua ccyh lya</para>
  <para style="q2">yn paw zah yn lethung;</para>
  <para style="q1">zete ccyh vae tuh baluh naan zah</para>
  <para style="q2">arou vae.</para>
  <para style="q1">
    <verse number="7" style="v" />Na thinrianaw keiccuze kaening kha</para>
  <para style="q2">marya ro kae thua vae;</para>
  <para style="q1">na thinrianaw keiccuze</para>
  <para style="q2">tae kae thua vae.</para>
  <para style="q1">
    <verse number="8" style="v" />Kae hoyleinaw kha na malang khe</para>
  <para style="q2">na nung zah,</para>
  <para style="q1">aruh lante kae raepaw seinaw kha</para>
  <para style="q2">marya na muih vae.</para>
  <para style="q1">
    <verse number="9" style="v" />Na thinrianaw nynh kae hiinshe</para>
  <para style="q2">oun dynsah;</para>
  <para style="q1">kae hiinshe tuh vaekheit hysawpaw te</para>
  <para style="q2">nynh aloku.</para>
  <para style="q1">
    <verse number="10" style="v" />Kae hiinshe tuh</para>
  <para style="q2">kum sung sari nynh asae;</para>
  <para style="q1">kae thawzung a um ze</para>
  <para style="q2">kum sung tarya mah asae kho;</para>
  <para style="q1">tuhzemah kae hiin lungkhu kya</para>
  <para style="q2">vawsawnaw te</para>
  <para style="q1">ngaethyanaw mawcci nynh kae tung;</para>
  <para style="q2">kae hiinnaw tuh aro maw</para>
  <para style="q1">thang zah phe kae zo.</para>
  <para style="q1">
    <verse number="11" style="v" />Na thinrianaw huhan kha</para>
  <para style="q2">hummou a nyhthya?</para>
  <para style="q1">Na thin-unaw kha ri lan accan thyhte</para>
  <para style="q2">hummou a rih?</para>
  <para style="q1">
    <verse number="12" style="v" />Tukeiccuze kae ccyh riathyanaw kha</para>
  <para style="q2">oun ccangpya tua,</para>
  <para style="q1">tuhteze nynh kae thinlung</para>
  <para style="q2">a haw kho cih.</para>
  <para style="q1">
    <verse number="13" style="v" />Pou <char style="nd">Bawipaw </char>, yn kitua!</para>
  <para style="q2">Hohseciamou aro ung cih?</para>
  <para style="q1">Na see hae tungvaw</para>
  <para style="q2">ngaethyaumsahnaw beih hoitua!</para>
  <para style="q1">
    <verse number="14" style="v" />Atynpaw na sungsahnaw te</para>
  <para style="q2">awkhua takyh kae lungrya</para>
  <para style="q1">oun chisah tua.</para>
  <para style="q2">tuhteze tuh kae hiin lungkhu balyn</para>
  <para style="q2">kae lungtua cih zah kae lungpaw cih.</para>
  <para style="q1">
    <verse number="15" style="v" />Vawsawnaw nae ingsah ccyh</para>
  <para style="q2">asae thathyhte,</para>
  <para style="q1">hoyleinaw kae tungpaw akum</para>
  <para style="q2">alung thathyhte lungtuanaw oun pyatua.</para>
  <para style="q1">
    <verse number="16" style="v" />Na ryalaw tuh na see hae kya</para>
  <para style="q2">langkuh sah lah,</para>
  <para style="q1">na phu-enaw huhan tuh</para>
  <para style="q2">mih ccaaw hae kya langkuh sah.</para>
  <para style="q1">
    <verse number="17" style="v" />
    <char style="nd">Bawipaw </char> kae Pachia kya-e</para>
  <para style="q2">maehoynaw tuh kae tungvaw</para>
  <para style="q1">um sah lah,</para>
  <para style="q2">kae cyipaw ryalaw tuh kaemaw elang</para>
  <para style="q1">hoynaw um sah,</para>
  <para style="q2">Kae kuih nynh rya a lawpaw kya</para>
  <para style="q1">kae laan kae sui ua vae sah.</para>
  <chapter number="91" style="c" />
  <para style="s1">Thungkhawtu Pachia</para>
  <para style="q1">
    <verse number="1" style="v" />Ahang Huaccepaw kya-e</para>
  <para style="q2">khynnaw kya na umpaw,</para>
  <para style="q1">Athunghuapaw kya-e mynlyh kaw</para>
  <para style="q2">na umpaw nang nynh</para>
  <para style="q1">
    <verse number="2" style="v" />
    <char style="nd">Bawipaw </char> kyakhe, “Ka khynnaw te</para>
  <para style="q2">ka rhawlungrua athuapaw</para>
  <para style="q1">ka Pachia kha ka doliaku,”</para>
  <para style="q2">cite na hopah cih.</para>
  <para style="q1">
    <verse number="3" style="v" />Aning nynh nang kha kaangsyatupaw</para>
  <para style="q2">kaang kyate thuasah,</para>
  <para style="q1">chi khopaw ccinaw kyate thuasah</para>
  <para style="q2">ae luesah cih;</para>
  <para style="q1">
    <verse number="4" style="v" />a sake ming nynh</para>
  <para style="q2">nang kha ae bong cih zah,</para>
  <para style="q2">a sake kaw khe khynnaw na mue cih;</para>
  <para style="q1">a lungzinaw tuh khawriaphua te</para>
  <para style="q2">rhawtuk-zunghe athua cih.</para>
  <para style="q1">
    <verse number="5" style="v" />Khuazi kya ri lan umpaw thuasah,</para>
  <para style="q2">ninthu kya athuipaw the thuasah,</para>
  <para style="q1">
    <verse number="6" style="v" />mohnaw kya umpaw</para>
  <para style="q2">vawsawnaw thuasah,</para>
  <para style="q1">ninthuccynglyn kya chia a mangpaw</para>
  <para style="q2">ronaw thuasah na rih lan khyh.</para>
  <para style="q1">
    <verse number="7" style="v" />Na pe khe ccungccaw thong kheit,</para>
  <para style="q2">na ranglang khe</para>
  <para style="q1">thong haw a chih cih hae,</para>
  <para style="q2">thuasalama tuh-e chinawpaw nynh</para>
  <para style="q2">nang kha ae thuanua lan khyh.</para>
  <para style="q1">
    <verse number="8" style="v" />Na mit te do kyalya na do cih zah,</para>
  <para style="q2">ccungccaw hoylei hae paw nynh</para>
  <para style="q1">a teing hae paw detahnaw kha</para>
  <para style="q2">muih te kyalya na muih cih.</para>
  <para style="q1">
    <verse number="9" style="v" />
    <char style="nd">Bawipaw </char> kha na khynnaw lang</para>
  <para style="q2">na nungkuh zah,</para>
  <para style="q1">Ahang Huaccepaw kha</para>
  <para style="q2">na umnaw hmin lang</para>
  <para style="q2">na nungku vae keiccuze,</para>
  <para style="q1">
    <verse number="10" style="v" />hoyleinaw tuh na tungvaw</para>
  <para style="q2">ccah lan khyh zah,</para>
  <para style="q1">ccinaw alepaw tuh na inn pe lang</para>
  <para style="q2">naekuh lan khyh.</para>
  <para style="q1">
    <verse number="11" style="v" />Na ccianaw takyh kya nang kha</para>
  <para style="q2">rin khylan</para>
  <para style="q1">Pachia nynh a vaawccungccaw hae kha</para>
  <para style="q2">kaw a pya cih hae.<note caller="-" style="x"><char style="xo" closed="false">91.11: </char><char style="xt" closed="false"><ref loc="MAT 4:6">Mat 4.6</ref>; <ref loc="LUK 4:10">Luk 4.10</ref></char></note></para>
  <para style="q1">
    <verse number="12" style="v" />Na ccu kha lung kya na thuhku</para>
  <para style="q2">khyh nawlan, mih kuih te</para>
  <para style="q2">nang kha ae dua cih hae.<note caller="-" style="x"><char style="xo" closed="false">91.12: </char><char style="xt" closed="false"><ref loc="MAT 4:6">Mat 4.6</ref>; <ref loc="LUK 4:11">Luk 4.11</ref></char></note></para>
  <para style="q1">
    <verse number="13" style="v" />Chindeih te hupaw kha</para>
  <para style="q2">na syde cih hae,</para>
  <para style="q1">chindeih nopaw te huparepaw kha</para>
  <para style="q2">na ccu te na syde cih hae.<note caller="-" style="x"><char style="xo" closed="false">91.13: </char><char style="xt" closed="false"><ref loc="LUK 10:19">Luk 10.19</ref></char></note></para>
  <para style="q1">
    <verse number="14" style="v" />Kae yn sungsah hae paw kha</para>
  <para style="q2">ka luesah cih hae;</para>
  <para style="q1">ka min yn nyh hae paw kha</para>
  <para style="q2">ka thungkhaw cih hae.</para>
  <para style="q1">
    <verse number="15" style="v" />Minmin nynh yn ko hae ze,</para>
  <para style="q2">ka oi cih hae;</para>
  <para style="q1">vawsaw a tung hae ze,</para>
  <para style="q2">ka umkhae cih hae,</para>
  <para style="q1">minmin kha ka luesah cih hae zah,</para>
  <para style="q2">sawtuanaw ka pya cih hae.</para>
  <para style="q1">
    <verse number="16" style="v" />She saenaw te minmin kha</para>
  <para style="q2">mih lungry ka ccingsah cih hae zah,</para>
  <para style="q1">ka khumnaw kha</para>
  <para style="q2">ka muihsah cih hae.</para>
  <chapter number="92" style="c" />
  <para style="s1">Thehoysahnaw Hlaw<note caller="+" style="f"><char style="fr" closed="false">92 Abyalu: </char><char style="ft" closed="false">Sabbath nin hanlan hlaw.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> kalan lungtuabya hote,</para>
  <para style="q2">Ahang Huaccepaw Pachia,</para>
  <para style="q1">na min thehoysahnaw hlawsah tuh</para>
  <para style="q2">myarya ahoy;</para>
  <para style="q1">
    <verse number="2-3" style="v" />tintang, phyly te roi hoypaw kha</para>
  <para style="q2">khuakute awkhua kya atynpaw</para>
  <para style="q2">na sungsahnaw kha thuasah,</para>
  <para style="q1">khuazi kya na lungzinaw kha thuasah</para>
  <para style="q2">hopaw tuh myarya hoypaw nynh thua.</para>
  <para style="q1">
    <verse number="4" style="v" />Pou <char style="nd">Bawipaw </char>, na ryalaw te</para>
  <para style="q2">ka lung nae tuasah vae;</para>
  <para style="q1">na kuih te na cyipaw liate</para>
  <para style="q2">lungtuate hlaw ka sah.</para>
  <para style="q1">
    <verse number="5" style="v" />Pou <char style="nd">Bawipaw </char>, na ryalaw hae hynh</para>
  <para style="q2">pawcih baban mou alesae!</para>
  <para style="q2">Na tuanaw tuh myarya akhu!</para>
  <para style="q1">
    <verse number="6" style="v" />Mih lungru hae paw nynh</para>
  <para style="q2">nyh kho khyh hae, mingaee hae nynh</para>
  <para style="q2">a thaethya lei hae paw tuh:</para>
  <para style="q1">
    <verse number="7" style="v" />ccungccaw hoylei hae paw tuh</para>
  <para style="q2">lonua hawte lethung hae zah,</para>
  <para style="q1">hoyleinaw a rae hae paw balyn tuh</para>
  <para style="q2">hoynaw a mue hae zemah,</para>
  <para style="q1">zungzae ro athua cih hae,</para>
  <para style="q2">
    <verse number="8" style="v" />thuasalama, pou <char style="nd">Bawipaw </char>,</para>
  <para style="q1">nang tuh ahangnaw kya nynh</para>
  <para style="q2">zungzae na um.</para>
  <para style="q1">
    <verse number="9" style="v" />Pou <char style="nd">Bawipaw </char>, na rhaw hae tuh</para>
  <para style="q2">a chih cih hae;</para>
  <para style="q1">hoyleinaw a rae hae paw balyn tuh</para>
  <para style="q2">phiariphiarae a um cih hae.</para>
  <para style="q1">
    <verse number="10" style="v" />Thuasalama ka ki kha</para>
  <para style="q2">saccung ccungte ki hawte</para>
  <para style="q1">nae hangthung vae;</para>
  <para style="q2">chitui athawpaw te</para>
  <para style="q2">ka tungvaw nae bu vae.</para>
  <para style="q1">
    <verse number="11" style="v" />Ka rhaw hae a shung hae paw kha</para>
  <para style="q2">ka mit nynh phe a muih vae;</para>
  <para style="q1">ahoy leipaw ka rhaw hae ronaw kha</para>
  <para style="q2">ka nakaring te phe ka thae vae.</para>
  <para style="q1">
    <verse number="12" style="v" />Miding hae tuh ungcci ku hawte</para>
  <para style="q2">hoyte lethung hae zah,</para>
  <para style="q1">Lebanon e sidar ku hawte</para>
  <para style="q2">a lethung hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Minmin tuh <char style="nd">Bawipaw </char> inn kya</para>
  <para style="q2">lin thua hae zah,</para>
  <para style="q2">ah Pachia voidu lungkhu a lethung hae.</para>
  <para style="q1">
    <verse number="14" style="v" />A taw vae hae zemah</para>
  <para style="q2">palei athae thae ung hae;</para>
  <para style="q1">hinlalyh lan zungzae um hae zah,</para>
  <para style="q2">aphi te phe beih hae,</para>
  <para style="q1">
    <verse number="15" style="v" />e hynh nynh <char style="nd">Bawipaw </char> tuh</para>
  <para style="q2">ading cipaw a langsah;</para>
  <para style="q1">aning tuh ka lungpi thua zah,</para>
  <para style="q2">amaw kya dingleinaw um khyh.</para>
  <chapter number="93" style="c" />
  <para style="s1">Pachia Lesaenaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> tuh siapharan thua zah,</para>
  <para style="q2">lesaenaw te ccaan athua;</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> tuh ccaan thua zah,</para>
  <para style="q2">a cce kyakhe thawzung te voide athua.</para>
  <para style="q1">Aning nynh laephi kha</para>
  <para style="q2">a nuekuh kho lei lante</para>
  <para style="q2">a tynsah;</para>
  <para style="q1">
    <verse number="2" style="v" />na bawitungkhung kha</para>
  <para style="q2">langmawlya te a la tyn vae;</para>
  <para style="q1">ccyh a um mawze</para>
  <para style="q2">nang tuh na la um vae.</para>
  <para style="q1">
    <verse number="3" style="v" />Pou <char style="nd">Bawipaw </char>, vawpi hae tuh</para>
  <para style="q2">ahangkuh thung hae,</para>
  <para style="q1">vawpi hae tuh mih roi a ccae;</para>
  <para style="q2">vawpi hae tuh a siarua hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Rilipi tuihu laeze lesaehua zah,</para>
  <para style="q2">rili tuileih laeze a lesaehua,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> tuh ahangnaw kya alesae!</para>
  <para style="q1">
    <verse number="5" style="v" />Na phunglang hae tuh myarya atyn;</para>
  <para style="q2">Pou <char style="nd">Bawipaw </char>, thyaanaw tuh</para>
  <para style="q2">na inn te zungzae angaekuh.</para>
  <chapter number="94" style="c" />
  <para style="s1">Miding hanlan Liarutu Pachia</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, nang tuh</para>
  <para style="q2">liarutu Pachia nynh na thua,</para>
  <para style="q1">liarutu Pachia, na awnaw kha</para>
  <para style="q2">awsah tua!</para>
  <para style="q1">
    <verse number="2" style="v" />Pou laephi byapiatu, thoku tua;</para>
  <para style="q2">a lyasakuh hae paw kha</para>
  <para style="q2">accan thyhte detahtua hae!</para>
  <para style="q1">
    <verse number="3" style="v" />Pou <char style="nd">Bawipaw </char>, ccungccaw</para>
  <para style="q2">hoylei hae paw tuh</para>
  <para style="q1">hohseciamou mih lungtua cih?</para>
  <para style="q1">
    <verse number="4" style="v" />Minmin nynh lysakunaw bya kha a ho hae;</para>
  <para style="q2">hoyleinaw a raepaw balyn tuh</para>
  <para style="q2">a pookuh hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Pou <char style="nd">Bawipaw </char>, minmin nynh</para>
  <para style="q2">na ccungccaw hae kha roh hae zah,</para>
  <para style="q1">na rho athuapaw na ccungccaw hae kha</para>
  <para style="q2">a tuaa a sah hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Minmin nynh nomae te</para>
  <para style="q2">mikhia hae kha thuasah,</para>
  <para style="q1">ngawraw hae kha thuasah</para>
  <para style="q2">theih hae zah,</para>
  <para style="q1">
    <verse number="7" style="v" />“<char style="nd">Bawipaw </char> nynh muih lan khyh;</para>
  <para style="q2">Jakob Pachia nynh nyh lan khyh,” a ci hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Pou tuanaw hoi leipaw ccungccaw hae,</para>
  <para style="q2">thaethyatua oh; mingaee hae,</para>
  <para style="q2">hohtuhmou na haw ung cih oh?</para>
  <para style="q1">
    <verse number="9" style="v" />Nakaring a raetupaw Pachia nynh</para>
  <para style="q2">thae lan khyh tou?</para>
  <para style="q1">Mit a raetupaw Pachia nynh</para>
  <para style="q2">muih lan khyh tou?</para>
  <para style="q1">
    <verse number="10" style="v" />Minphuin hae a thuiheitupaw nynh</para>
  <para style="q2">detah leite a um cih tou?</para>
  <para style="q1">ccungccaw kha nynaw</para>
  <para style="q2">a ccangpatupaw nynh</para>
  <para style="q2">nyh lan khyh tou?</para>
  <para style="q1">
    <verse number="11" style="v" />Ccungccaw tuanaw tuh</para>
  <para style="q2">alakawpaw nynh thua cipaw</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh phe a ny.<note caller="-" style="x"><char style="xo" closed="false">94.11: </char><char style="xt" closed="false"><ref loc="1CO 3:20">1Ko 3.20</ref></char></note></para>
  <para style="q1">
    <verse number="12" style="v" />Pou <char style="nd">Bawipaw </char>, na thuihei hae paw te</para>
  <para style="q2">na phunglang na ccangpya hae paw tuh</para>
  <para style="q2">lungtua hae paw nynh thua.</para>
  <para style="q1">
    <verse number="13" style="v" />Ccungccaw hoylei hae paw hanlan</para>
  <para style="q2">hunghua thae athua makhia,</para>
  <para style="q1">minmin kha vawsawnaw kyate</para>
  <para style="q2">haeungnaw na pya hae.</para>
  <para style="q1">
    <verse number="14" style="v" />
    <char style="nd">Bawipaw </char> nynh a ccungccaw hae kha</para>
  <para style="q2">vua lan khyh hae;</para>
  <para style="q1">a rho athuapaw a ccungccaw hae kha</para>
  <para style="q2">vua lan khyh hae;</para>
  <para style="q1">
    <verse number="15" style="v" />pawccecize byading tuh</para>
  <para style="q2">miding hae kalan a kithui cih zah,</para>
  <para style="q1">mih thinlung adingpaw balyn nynh</para>
  <para style="q2">tuh-e byading kha a zui cih hae.</para>
  <para style="q2">
    <verse number="16" style="v" />Ccungccaw hoylei hae paw kha</para>
  <para style="q1">rawsete hummou ka kalan te</para>
  <para style="q2">a thokuh bua cih?</para>
  <para style="q1">Hoyleinaw a rae hae paw kha</para>
  <para style="q2">rawsete hummou yn thadynkhae cih?</para>
  <para style="q1">
    <verse number="17" style="v" />
    <char style="nd">Bawipaw </char> tuh yn bawmtu</para>
  <para style="q2">a la thua khyh lanze,</para>
  <para style="q1">ka muisaw tuh adaenaw ram kya</para>
  <para style="q2">aro maw a um vae cih.</para>
  <para style="q1">
    <verse number="18" style="v" />“Ka ccu a thei,” he ka ci tuh,</para>
  <para style="q2">Pou <char style="nd">Bawipaw </char>, atynpaw</para>
  <para style="q2">na sungsahnaw nynh phang yn kyng.</para>
  <para style="q1">
    <verse number="19" style="v" />Ka tuakunaw he aru vae ze,</para>
  <para style="q2">na kya-e ngaengansahnaw nynh</para>
  <para style="q2">ka lung yn pawsah.</para>
  <para style="q1">
    <verse number="20" style="v" />Uktu hoylei hae paw tuh nang te</para>
  <para style="q2">na ccawkuh kho oh zawtou?</para>
  <para style="q1">Minmin tuh upadi rawsete thyaruhnaw</para>
  <para style="q2">a paccynkuh hae paw nynh thua.</para>
  <para style="q1">
    <verse number="21" style="v" />Minmin nynh miding hae hiinnaw kha</para>
  <para style="q2">rawsete pynkheihlan mungkuh hae zah,</para>
  <para style="q1">seinaw a hoi lei hae paw kha</para>
  <para style="q2">chia lan bya a pia hae.</para>
  <para style="q1">
    <verse number="22" style="v" />Thuasalama <char style="nd">Bawipaw </char> tuh</para>
  <para style="q2">yn thungkhawtu thua vae zah,</para>
  <para style="q1">ka khynnaw lungpi,</para>
  <para style="q2">ka Pachia nynh thua.</para>
  <para style="q1">
    <verse number="23" style="v" />Pachia nynh mih hoyleinaw hanlan</para>
  <para style="q2">a liaru cih hae zah,</para>
  <para style="q1">mih hoyleinaw hanlan</para>
  <para style="q2">minmin kha a maemih cih hae;</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> ah Pachia nynh</para>
  <para style="q2">minmin kha a maemih cih hae.</para>
  <chapter number="95" style="c" />
  <para style="s1">Thehoysahnaw Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Rang oh, <char style="nd">Bawipaw </char> kalan</para>
  <para style="q2">hlawsah oh sih;</para>
  <para style="q1">oun khumtu lungpi kalan lungtuate</para>
  <para style="q2">sia oh sih!</para>
  <para style="q1">
    <verse number="2" style="v" />Lungtuanaw te amaw malang</para>
  <para style="q2">tee oh sih lah,</para>
  <para style="q1">thehoysahnaw hlaw kha lungtuate</para>
  <para style="q2">sah oh sih!</para>
  <para style="q1">
    <verse number="3" style="v" />Pawccecize <char style="nd">Bawipaw </char> tuh</para>
  <para style="q2">alesaepaw Pachia thua zah,</para>
  <para style="q1">pachia hae balyn laeze alesaepaw</para>
  <para style="q2">Siapharan nynh thua.</para>
  <para style="q1">
    <verse number="4" style="v" />Laephi akhunaw balyn tuh</para>
  <para style="q2">a kuih kya um zah,</para>
  <para style="q1">mua ahangnaw hae mah</para>
  <para style="q2">amaw kya-e nynh thua.</para>
  <para style="q1">
    <verse number="5" style="v" />Rili tuh a raepaw thua zah,</para>
  <para style="q2">amaw kya-e nynh thua,</para>
  <para style="q2">laelung kha mah a kuih te a rae.</para>
  <para style="q1">
    <verse number="6" style="v" />Rang oh, bakhung oh sih lah,</para>
  <para style="q2">beik oh sih,</para>
  <para style="q1">oun Raetu <char style="nd">Bawipaw </char> malang</para>
  <para style="q2">ccukharutung oh sih!</para>
  <para style="q1">
    <verse number="7" style="v" />Pawccecize aning tuh</para>
  <para style="q2">ah Pachia nynh thua,</para>
  <para style="q1">aening tuh a ramnonaw kya</para>
  <para style="q2">a paeepaw ccungccaw hae</para>
  <para style="q1">ah thua oh zah, a kuihkaw e</para>
  <para style="q2">tuuphu nynh ah thua oh.</para>
  <para style="q1">Atunin a bya kha ngaetua oh!<note caller="-" style="x"><char style="xo" closed="false">95.7-8: </char><char style="xt" closed="false"><ref loc="HEB 3:15">Heb 3.15</ref>, <ref loc="HEB 4:7">4.7</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">95.7-11: </char><char style="xt" closed="false"><ref loc="HEB 3:7-11">Heb 3.7-11</ref></char></note></para>
  <para style="q2">
    <verse number="8" style="v" />Meribah kya hawte thuasah,</para>
  <para style="q1">laesia ram umpaw</para>
  <para style="q2">Massah kya hawte thuasah</para>
  <para style="q2">nae lungkhung nan sah,<note caller="-" style="x"><char style="xo" closed="false">95.8-9: </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">Exo 17.1-7</ref>; <ref loc="NUM 20:2-13">Nam 20.2-13</ref></char></note></para>
  <para style="q1">
    <verse number="9" style="v" />nae minpaaw hae nynh</para>
  <para style="q2">yn syntawtua hae zah,</para>
  <para style="q1">ka ryalaw mang a muih vae hae pite,</para>
  <para style="q2">yn syntawtua hae.</para>
  <para style="q1">
    <verse number="10" style="v" />Kum sung pali lungkhu khah-e</para>
  <para style="q2">minphuin kha ka hua zah,</para>
  <para style="q1">“Minmin tuh mih thinlung</para>
  <para style="q2">a cceihseipaw thua hae zah,</para>
  <para style="q1">ka laanpi kha pawlangria</para>
  <para style="q2">khyh hae,” ka ci.</para>
  <para style="q1">
    <verse number="11" style="v" />Tukeiccuze ka thinria zah,</para>
  <para style="q2">“Minmin tuh ka haeungnaw</para>
  <para style="q1">lungkhu lang tee lan</para>
  <para style="q2">khyh hae,” cite bya ka kinku.<note caller="-" style="x"><char style="xo" closed="false">95.11: </char><char style="xt" closed="false"><ref loc="NUM 14:20-23">Nam 14.20-23</ref>; <ref loc="DEU 1:34-36">Deu 1.34-36</ref>, <ref loc="DEU 12:9-10">12.9-10</ref>; <ref loc="HEB 4:3-5">Heb 4.3-5</ref></char></note></para>
  <chapter number="96" style="c" />
  <para style="s1">Pachia Thehoysahnaw</para>
  <para style="r">(<ref loc="1CH 16:23-33">1Sh 16.23-33</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> kalan</para>
  <para style="q2">hlaw thawpaw kha sah oh;</para>
  <para style="q1">laephi ccungccaw hae balyn,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kalan hlawsah oh.</para>
  <para style="q1">
    <verse number="2" style="v" />
    <char style="nd">Bawipaw </char> kalan hlawsah oh lah,</para>
  <para style="q2">a min kha thehoysah oh;</para>
  <para style="q1">a khumnaw thehoypaw kha</para>
  <para style="q2">nin takyhte ho oh.</para>
  <para style="q1">
    <verse number="3" style="v" />Minphuin hae kalan a phu-enaw kha</para>
  <para style="q2">ho oh lah, ccungccaw hae balyn kalan</para>
  <para style="q1">ngaeangthua lan umpaw</para>
  <para style="q2">a ryalaw kha ho oh.</para>
  <para style="q1">
    <verse number="4" style="v" />
    <char style="nd">Bawipaw </char> tuh lesae zah,</para>
  <para style="q2">thawmawte thehoysah</para>
  <para style="q2">lanpaw nynh thua;</para>
  <para style="q1">ccangpaw pachia hae balyn laeze</para>
  <para style="q2">sawtuahua lanpaw nynh thua.</para>
  <para style="q1">
    <verse number="5" style="v" />Minphuin ccangpaw hae kya-e</para>
  <para style="q2">pachia hae tuh zohtuh hae nynh thua,</para>
  <para style="q1">thuasalama <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">vaawlui kha a rae.</para>
  <para style="q1">
    <verse number="6" style="v" />Sawtuanaw te lesaenaw tuh</para>
  <para style="q2">amaw malang a um;</para>
  <para style="q1">thawzung te puithyanaw tuh</para>
  <para style="q2">a beikinnthyaa kya a um.</para>
  <para style="q1">
    <verse number="7" style="v" />Laephi ccungccaw hae balyn,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha thehoysah oh,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> phu-enaw te</para>
  <para style="q2">a thawzung kha thehoysah oh.<note caller="-" style="x"><char style="xo" closed="false">96.7-9: </char><char style="xt" closed="false"><ref loc="PSA 29:1-2">Sam 29.1-2</ref></char></note></para>
  <para style="q1">
    <verse number="8" style="v" />A phu-epaw <char style="nd">Bawipaw </char> min kha</para>
  <para style="q2">thehoysah oh;</para>
  <para style="q1">silawnawpaw kha ccyngkute</para>
  <para style="q2">a beikinn lungkhu lang oun tee oh.</para>
  <para style="q1">
    <verse number="9" style="v" />Alesaepaw te athyaapaw</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha beik oh;</para>
  <para style="q1">laephi ccungccaw hae balyn,</para>
  <para style="q2">amaw malang rawrite um oh.</para>
  <para style="q1">
    <verse number="10" style="v" />Minphuin hae kyakhe, “<char style="nd">Bawipaw </char> tuh</para>
  <para style="q2">siapharan nynh thua! Laephipi tuh</para>
  <para style="q1">tynkaring lan thadynsah</para>
  <para style="q2">athua keiccuze kharouh nuekuh lan khyh.</para>
  <para style="q1">Ccungccaw hae kha dingnaw bya</para>
  <para style="q2">a pia cih hae,” cite hopah oh.</para>
  <para style="q1">
    <verse number="11" style="v" />Vaawlui hae tuh mih lungpaw sah lah,</para>
  <para style="q2">laephi tuh a lungtua sah;</para>
  <para style="q1">rili te a lungkhu um hae paw tuh</para>
  <para style="q2">sia hae sah;</para>
  <para style="q1">
    <verse number="12" style="v" />loo te a lungkhu umpaw</para>
  <para style="q2">atyn-are balyn tuh mih lungtua sah.</para>
  <para style="q1">Te ramkaw e thingku balyn tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> malang lungtuate</para>
  <para style="q1">hlaw a sah cih hae;</para>
  <para style="q2">
    <verse number="13" style="v" />pawccecize <char style="nd">Bawipaw </char> tuh</para>
  <para style="q2">laephi kha byapia khylan yn thua.</para>
  <para style="q1">Aning nynh laephi kha dingnaw te</para>
  <para style="q2">bya a pia cih zah,</para>
  <para style="q1">ccungccaw hae kha byaccing te</para>
  <para style="q2">bya a pia cih hae.</para>
  <chapter number="97" style="c" />
  <para style="s1">Pachia Uknaw Phu-enaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> tuh siapharan nynh thua!</para>
  <para style="q2">Laephi tuh a lungtua sah;</para>
  <para style="q2">tuikoih patae mah mih lungtua sah!</para>
  <para style="q1">
    <verse number="2" style="v" />Maeking te marae zipingpaw</para>
  <para style="q2">mohnaw hae tuh amaw pe khe</para>
  <para style="q1">po voilu lan a um hae;</para>
  <para style="q2">dingnaw te byading tuh</para>
  <para style="q2">a bawitungkhung atynnaw nynh thua hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Maee tuh amaw malang khe cceih zah,</para>
  <para style="q2">po voilu lan a umpaw</para>
  <para style="q2">a rhaw hae kha a u hae.</para>
  <para style="q1">
    <verse number="4" style="v" />A khozaw nynh laephipi kha a ak;</para>
  <para style="q2">laephi nynh muih zah a thyngkuh.</para>
  <para style="q1">
    <verse number="5" style="v" />
    <char style="nd">Bawipaw </char> malang khe,</para>
  <para style="q2">laephi pynpi a ukpaw</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> malang khe mua hae tuh</para>
  <para style="q2">khoilung hawte atui hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Vaawlui nynh a dingnaw kong kha ho zah,</para>
  <para style="q2">ccungccaw hae balyn nynh a phu-enaw kha</para>
  <para style="q2">a muih hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Raepaw zohtuh a beikpaw balyn kha</para>
  <para style="q2">maethya a law hae,</para>
  <para style="q1">ccungkia leipaw zohtuh liate</para>
  <para style="q2">a pookuh hae paw pachia hae balyn tuh</para>
  <para style="q2">amaw malang khe a bakhung hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Pou Pachia, na byapianaw liate</para>
  <para style="q2">Zion khuaccaaw hae nynh</para>
  <para style="q1">thae hae zah mih lungtua,</para>
  <para style="q2">Judah ram e khua hae mah mih lungtua.</para>
  <para style="q1">
    <verse number="9" style="v" />Pou <char style="nd">Bawipaw </char>, nang tuh</para>
  <para style="q2">laephi pynpi kya</para>
  <para style="q2">ahang huaccepaw nynh na thua;</para>
  <para style="q1">ccangpaw pachia hae balyn laeze</para>
  <para style="q2">myarya hangthung na thua.</para>
  <para style="q1">
    <verse number="10" style="v" />
    <char style="nd">Bawipaw </char> nynh hoyleipaw</para>
  <para style="q2">a hua hae paw kha a sungsah hae;</para>
  <para style="q1">alungzipaw a ccungccaw hae</para>
  <para style="q2">hiinnaw kha a rin hae;</para>
  <para style="q1">minmin kha ccungccaw hoylei</para>
  <para style="q2">hae paw kuih kyate a luesah hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Awnaw tuh miding hae hanlan</para>
  <para style="q2">aw zah, lungtuanaw tuh</para>
  <para style="q2">thinlung ading hae paw hanlan a aw.</para>
  <para style="q1">
    <verse number="12" style="v" />Pou miding hae nanning,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kya nae lungtua sah lah,</para>
  <para style="q2">a min thyaapaw kha thehoysah oh!</para>
  <chapter number="98" style="c" />
  <para style="s1">Laephi Byapiatu Thehoysah Oh</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> kalan hlaw thawpaw kha sah oh,</para>
  <para style="q2">pawccecize ngaeangthua lan umpaw</para>
  <para style="q2">uccaw hae kha a rae vae.</para>
  <para style="q1">A ranglang kuih te athyaapaw a kuih nynh</para>
  <para style="q2">rhaw kha a taesah vae.</para>
  <para style="q1">
    <verse number="2" style="v" />
    <char style="nd">Bawipaw </char> nynh rhaw a taenaw kha</para>
  <para style="q2">a nysah hae; a dingnaw kha</para>
  <para style="q1">minphuin hae mitmuihnaw kya</para>
  <para style="q2">a langsaku vae.</para>
  <para style="q1">
    <verse number="3" style="v" />Israel hae kya atynpaw a sungsahnaw te</para>
  <para style="q2">a lungzinaw kha a liathui vae.</para>
  <para style="q1">Ah Pachia nynh rhaw a taepaw kha</para>
  <para style="q2">laephi pynpi balyn nynh a muih vae hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Laephi ccungccaw hae balyn, <char style="nd">Bawipaw </char> kalan</para>
  <para style="q2">lungtuate siatua oh;</para>
  <para style="q1">lungtuanaw hlaw khate siatua oh lah,</para>
  <para style="q2">thehoysahnaw hlawsah oh.</para>
  <para style="q1">
    <verse number="5" style="v" />
    <char style="nd">Bawipaw </char> kalan tintang te,</para>
  <para style="q2">roi hoypaw khate</para>
  <para style="q2">thehoysahnaw hlawsah oh.</para>
  <para style="q1">
    <verse number="6" style="v" />Mungkae te saki kha tu biate</para>
  <para style="q2">Siapharan athuapaw</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> malang khe lungtuate sia oh.</para>
  <para style="q1">
    <verse number="7" style="v" />Rili te a lungkhu umpaw balyn nynh</para>
  <para style="q2">sia hae sah;</para>
  <para style="q1">laephi te laephipi kya</para>
  <para style="q2">um hae paw balyn nynh sia hae sah.</para>
  <para style="q1">
    <verse number="8" style="v" />Vawpi hae balyn nynh mih kuihbia hae sah;</para>
  <para style="q2">mua hae balyn nynh</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> malang khe</para>
  <para style="q2">lungtuate pynkheihlan hlawsah hae sah,</para>
  <para style="q1">
    <verse number="9" style="v" />pawccecize aning tuh laephi kha</para>
  <para style="q2">byapia khylan yn thua.</para>
  <para style="q1">Aning nynh laephipi kha dingnaw te</para>
  <para style="q2">bya a pia cih zah,</para>
  <para style="q1">ccungccaw hae kha ahmete</para>
  <para style="q2">bya a pia cih hae.</para>
  <chapter number="99" style="c" />
  <para style="s1">Athyaapaw Pachia Thehoysah Oh</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> tuh siapharan nynh thua,</para>
  <para style="q2">ccungccaw hae tuh thyngkuh hae sah!</para>
  <para style="q1">Aning tuh cherubim vawlan</para>
  <para style="q2">bawitungkhung kyakhe a haung;</para>
  <para style="q2">laephi tuh hy sah!<note caller="-" style="x"><char style="xo" closed="false">99.1: </char><char style="xt" closed="false"><ref loc="EXO 25:22">Exo 25.22</ref></char></note></para>
  <para style="q1">
    <verse number="2" style="v" />
    <char style="nd">Bawipaw </char> tuh Zion kya a lesae;</para>
  <para style="q2">ccungccaw hae balyn laeze</para>
  <para style="q2">hangthung athua.</para>
  <para style="q1">
    <verse number="3" style="v" />Minmin nynh na lesaenaw te</para>
  <para style="q2">ri lan umpaw na min kha</para>
  <para style="q1">ae thehoysah hae sah.</para>
  <para style="q2">Na min tuh athyaapaw nynh thua!</para>
  <para style="q1">
    <verse number="4" style="v" />Athungpaw Siapharan, nang tuh</para>
  <para style="q2">byading a rypaw na thua zah,</para>
  <para style="q2">ahmepaw kha na tynsah vae;</para>
  <para style="q1">byading te dingnaw kha</para>
  <para style="q2">Jakob ciihan kya na rae vae.</para>
  <para style="q1">
    <verse number="5" style="v" />
    <char style="nd">Bawipaw </char> ah Pachia kha</para>
  <para style="q2">thehoysah oh;</para>
  <para style="q1">a ccu khangnawpaw kaw khe</para>
  <para style="q2">bakhungte beik oh.</para>
  <para style="q1">Aning tuh athyaapaw nynh thua!</para>
  <para style="q1">
    <verse number="6" style="v" />Moses te Aaron tuh</para>
  <para style="q2">a ranpibawi hae nynh thua hae,</para>
  <para style="q2">Samuel mah amaw min a kopaw nynh thua.</para>
  <para style="q1">Minmin nynh <char style="nd">Bawipaw </char> kalan</para>
  <para style="q2">sia hae zah, aning nynh a leih hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Maeking tung kyate minmin kha</para>
  <para style="q2">a hopya hae;</para>
  <para style="q1">aning nynh a pya hae paw</para>
  <para style="q2">a phunglang te a phungbya kha</para>
  <para style="q1">minmin nynh a zui hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Pou <char style="nd">Bawipaw </char> kae Pachia,</para>
  <para style="q2">nang nynh minmin kha na leih hae;</para>
  <para style="q1">nang tuh minmin hanlan</para>
  <para style="q2">seingaethyanaw Pachia nynh na thua,</para>
  <para style="q1">thuasalama mih cyiseinaw hanlan</para>
  <para style="q2">liarutu nynh na thua.</para>
  <para style="q1">
    <verse number="9" style="v" />
    <char style="nd">Bawipaw </char> ah Pachia kha</para>
  <para style="q2">thehoysah oh lah,</para>
  <para style="q1">a mua thyaapaw kyakhe beik oh;</para>
  <para style="q2">pawccecize <char style="nd">Bawipaw </char> ah Pachia tuh</para>
  <para style="q1">athyaapaw nynh thua.</para>
  <chapter number="100" style="c" />
  <para style="s1">Ram balyn nynh Pachia Thehoysahnaw</para>
  <para style="d">Thehoysahnaw Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Laephi ccungccaw hae balyn,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kalan lungtuate siatua oh.</para>
  <para style="q1">
    <verse number="2" style="v" />
    <char style="nd">Bawipaw </char> kha lungtuate beik oh;</para>
  <para style="q2">hlawsah biate amaw kalan rang oh.</para>
  <para style="q1">
    <verse number="3" style="v" />
    <char style="nd">Bawipaw </char> tuh Pachia nynh thua</para>
  <para style="q2">cipaw nyh oh.</para>
  <para style="q1">Aening oun raetupaw tuh</para>
  <para style="q2">amaw thua zah, aening tuh</para>
  <para style="q2">amaw kya-e nynh ah thua oh;</para>
  <para style="q1">amaw ccungccaw ah thua oh zah,</para>
  <para style="q2">a tuuphu nynh ah thua oh.</para>
  <para style="q1">
    <verse number="4" style="v" />Lungtuabya hote a koikua</para>
  <para style="q2">lungkhu lang tee oh lah,</para>
  <para style="q1">thehoysah te a voidu lungkhu lang</para>
  <para style="q2">tee oh.</para>
  <para style="q1">A tungvaw lungtuabya ho oh lah,</para>
  <para style="q2">a min kha thehoysah oh.</para>
  <para style="q1">
    <verse number="5" style="v" />Pawccecize <char style="nd">Bawipaw </char> tuh ahoy;</para>
  <para style="q2">atynpaw a sungsahnaw tuh zungzae tyn zah,</para>
  <para style="q1">a lungzinaw tuh she takyh kya atyn.<note caller="-" style="x"><char style="xo" closed="false">100.5: </char><char style="xt" closed="false"><ref loc="1CH 16:34">1Sh 16.34</ref>; <ref loc="2CH 5:13">2Sh 5.13</ref>, <ref loc="2CH 7:3">7.3</ref>; <ref loc="EZR 3:11">Ezr 3.11</ref>; <ref loc="PSA 106:1">Sam 106.1</ref>, <ref loc="PSA 107:1">107.1</ref>, <ref loc="PSA 118:1">118.1</ref>, <ref loc="PSA 136:1">136.1</ref>; <ref loc="JER 33:11">Jer 33.11</ref></char></note></para>
  <chapter number="101" style="c" />
  <para style="s1">Siapharan Byakinkunaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Lungzinaw te byading kong kha</para>
  <para style="q2">hlaw ka sah cih.</para>
  <para style="q1">Pou <char style="nd">Bawipaw </char>, na kalan</para>
  <para style="q2">hlaw ka sah cih.</para>
  <para style="q1">
    <verse number="2" style="v" />Ccaenaw um leipaw laanpi kha</para>
  <para style="q2">ka ccangkuh cih.</para>
  <para style="q2">Hohtuhmou ka kalan nae thua cih?</para>
  <para style="q1">Ka inn lungkhu kya thinlung dingrarihte</para>
  <para style="q2">ka hiin cih.</para>
  <para style="q1">
    <verse number="3" style="v" />Ahoy leipaw miakaw kha</para>
  <para style="q2">ka mitmae kya ka nung lan khyh.</para>
  <para style="q1">a cceihsei hae paw ryalaw kha ka hua;</para>
  <para style="q2">tuh-e tuh ka kya bekuh lan khyh.</para>
  <para style="q1">
    <verse number="4" style="v" />Ahoy leipaw thinlung tuh ka kyate</para>
  <para style="q2">asawkuh cih zah,</para>
  <para style="q2">hoyleinaw kha kharouhmaw ka tua lan khyh.</para>
  <para style="q1">
    <verse number="5" style="v" />Aruh lante a innpaw thethya</para>
  <para style="q2">a hopaw kha ka roh cih.</para>
  <para style="q1">a mitdae lysakuh zah</para>
  <para style="q2">thinlung a tansakuhpaw kha</para>
  <para style="q1">ka ngaesangpah lan khyh.</para>
  <para style="q1">
    <verse number="6" style="v" />Ram lungkhu e mih lungzi hae paw tuh</para>
  <para style="q2">kamaw ryte kae umkheih nawlan hae,</para>
  <para style="q1">minmin kha maehoynaw ka pya cih hae;</para>
  <para style="q2">ccaenaw um lei lante</para>
  <para style="q1">a hiinpaw miakaw tuh</para>
  <para style="q2">ka rya a lah cih hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Ccungccaw ling a mangpaw tuh</para>
  <para style="q2">ka inn kya um lan khyh;</para>
  <para style="q1">hynbya a hopaw tuh ka muihnaw kya</para>
  <para style="q2">um lan khyh.</para>
  <para style="q1">
    <verse number="8" style="v" />Nin kheit koute nin kheit</para>
  <para style="q2">ram lungkhu e ccungccaw hoyleipaw</para>
  <para style="q2">balyn kha ka roh cih hae,</para>
  <para style="q1">hoyleinaw a rae hae paw balyn kha</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> khuapi kyate</para>
  <para style="q2">ka vua cih hae.</para>
  <chapter number="102" style="c" />
  <para style="s1">Bawmnaw Mue khylan Sawsangnaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">ka sawsangnaw yn thaepya tua;</para>
  <para style="q1">ka siaruanaw hynh</para>
  <para style="q2">namaw kalan phe thua sah.</para>
  <para style="q1">
    <verse number="2" style="v" />Vawsawnaw ka tung ccyh lya</para>
  <para style="q2">na mitmae yn retawkuh nan.</para>
  <para style="q1">He kae ko vae ze, yn thaepah lah</para>
  <para style="q2">arangte yn leihtua.</para>
  <para style="q1">
    <verse number="3" style="v" />Pawccecize ka ccyh tuh</para>
  <para style="q1">maeekhuh hawte dyadya lia zah,</para>
  <para style="q2">ka ru hae tuh maeephupi hawte arua.</para>
  <para style="q1">
    <verse number="4" style="v" />Ka thinlung tuh zia thua zah,</para>
  <para style="q2">lonua hawte baleih anaan;</para>
  <para style="q1">looh mah ka ae ry khyh.</para>
  <para style="q1">
    <verse number="5" style="v" />Thawte ka hawkhaeku keiccuze</para>
  <para style="q2">ka ru te ka ving kyalya nynh ka um vae.</para>
  <para style="q1">
    <verse number="6" style="v" />Laesia ram e nawnia hawte ka thua zah,</para>
  <para style="q2">ramkaw e nawnia dihpaw</para>
  <para style="q2">hawte nynh ka thua.</para>
  <para style="q1">
    <verse number="7" style="v" />I kho leite ka um zah,</para>
  <para style="q2">a makhaete innccukaly umpaw</para>
  <para style="q2">pavaw nynh ka lo.</para>
  <para style="q1">
    <verse number="8" style="v" />Ka rhaw hae nynh anin ninlang yn sarya hae;</para>
  <para style="q2">ccyasahku nawlan</para>
  <para style="q1">yn mang hae paw nynh</para>
  <para style="q2">ka min kha thyalawku nawlan a mang hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Buhhaw kha sanlou lang ka ae zah,</para>
  <para style="q2">ka niapaw tuh mitphi te apykuh,</para>
  <para style="q1">
    <verse number="10" style="v" />tuh-e tuh na thinrianaw te</para>
  <para style="q2">na thin-unaw keiccu nynh thua;</para>
  <para style="q1">nae hangthung zah nae vua vae.</para>
  <para style="q1">
    <verse number="11" style="v" />Ka hiinnaw ccyh tuh</para>
  <para style="q2">zetesang e mynzia hawte nynh thua;</para>
  <para style="q1">lonua hawte baleih ka naan.</para>
  <para style="q1">
    <verse number="12" style="v" />Thuasalama, pou <char style="nd">Bawipaw </char>, nang tuh</para>
  <para style="q2">bawitungkhung kya zungzae na haung;</para>
  <para style="q1">na min tuh she takyh kya atyn.</para>
  <para style="q1">
    <verse number="13" style="v" />Na thokuh cih zah Zion kha</para>
  <para style="q2">ngaethya na umsah cih,</para>
  <para style="q1">pawccecize a tungvaw</para>
  <para style="q2">ngaethyaumsahnaw ccyh azaw vae;</para>
  <para style="q1">khyapaw accyh azaw vae.</para>
  <para style="q1">
    <verse number="14" style="v" />Na see hae nynh Zion lung kha</para>
  <para style="q2">ry hae zah, a laenoi kyakhe</para>
  <para style="q2">ngaethyaumsahnaw a hoi hae.</para>
  <para style="q1">
    <verse number="15" style="v" />Minphuin hae nynh <char style="nd">Bawipaw </char> min kha</para>
  <para style="q2">a rih cih hae zah,</para>
  <para style="q1">laephi siapharan balyn nynh</para>
  <para style="q2">na huhan kha a rih cih hae.</para>
  <para style="q1">
    <verse number="16" style="v" />
    <char style="nd">Bawipaw </char> nynh Zion khuapi kha a rae;</para>
  <para style="q2">a phu-enaw kha a langsakuh cih.</para>
  <para style="q1">
    <verse number="17" style="v" />Bawmtu hoi lei hae paw sawsangnaw kha</para>
  <para style="q2">pe a kipah cih hae zah,</para>
  <para style="q1">mih sawsangnaw kha</para>
  <para style="q2">pawlangria leite um lan khyh.</para>
  <para style="q1">
    <verse number="18" style="v" />Malang she e ccungccaw hae nynh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha the a hoysah ccaw hae,</para>
  <para style="q1">e hynh yn thua cih paw she hanlan zei thua sah.</para>
  <para style="q1">
    <verse number="19" style="v" />
    <char style="nd">Bawipaw </char> nynh amaw kya-e athyaapaw</para>
  <para style="q2">ahangnaw kyate a dobung,</para>
  <para style="q1">vaawlang te laephi kha a do,</para>
  <para style="q1">
    <verse number="20" style="v" />tuhte a dopaw tuh thongccah hae paw nynh</para>
  <para style="q2">a hawkhaekunaw hae roi kha thae khylan te</para>
  <para style="q1">a chih vae cih hae paw kha</para>
  <para style="q2">luesah khylan nynh thua.</para>
  <para style="q1">
    <verse number="21" style="v" />tuhteze nynh <char style="nd">Bawipaw </char> min kha</para>
  <para style="q2">Zion kya a siakhae cih hae zah,</para>
  <para style="q1">Jerusalem kya amaw thehoysahnaw kha</para>
  <para style="q2">a siakhae cih hae.</para>
  <para style="q1">
    <verse number="22" style="v" />Tuh-e ccyh tuh minphuin hae te</para>
  <para style="q2">peenaw hae nynh <char style="nd">Bawipaw </char> kha</para>
  <para style="q1">beik khylan pynkheihlan</para>
  <para style="q2">a pumku hae ccyh nynh athua cih.</para>
  <para style="q1">
    <verse number="23" style="v" />Ka no lyakhe ka thawzung yn zyasah vae;</para>
  <para style="q2">ka ccyh kha a dynsah vae.</para>
  <para style="q1">
    <verse number="24" style="v" />Kae nynh, “Pou ka Pachia,</para>
  <para style="q2">ka hiinshe angankuh athua ccyh lyakhe</para>
  <para style="q2">kae kha yn lah nan,</para>
  <para style="q1">nang na ccyh tuh</para>
  <para style="q2">she takyh zungzae atyn,” ka ci.</para>
  <para style="q1">
    <verse number="25" style="v" />Langmawlya te</para>
  <para style="q2">laephi athonaw aleihpaw kha na tynsah,</para>
  <para style="q2">vaawlang hae tuh na kuih te</para>
  <para style="q1">na raepaw nynh thua.<note caller="-" style="x"><char style="xo" closed="false">102.25-27: </char><char style="xt" closed="false"><ref loc="HEB 1:10-12">Heb 1.10-12</ref></char></note></para>
  <para style="q1">
    <verse number="26" style="v" />Tuh-e hae tuh aroh cih hae,</para>
  <para style="q2">thuasalama nang tuh zungzae na tyn;</para>
  <para style="q1">tuh-e hae balyn tuh boeining hawte</para>
  <para style="q2">a seiikuh cih hae.</para>
  <para style="q1">Boeiningsungpue hawte</para>
  <para style="q2">na rulae hae zah phe azo hae.</para>
  <para style="q1">
    <verse number="27" style="v" />Thuasalama nang tuh</para>
  <para style="q2">na rulaekuh khyh zah</para>
  <para style="q2">na hiinnaw tuh thang khyh.</para>
  <para style="q1">
    <verse number="28" style="v" />Na see hae mih ccaaw hae tuh</para>
  <para style="q2">khyndadyh lan a um cih hae;</para>
  <para style="q1">mih ciihan hae tuh namaw malang khe</para>
  <para style="q2">tynsah athua cih hae.</para>
  <chapter number="103" style="c" />
  <para style="s1">Pachia Hoynaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou ka muisaw,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha thehoysah tua,</para>
  <para style="q1">ka lungkhu umpaw balyn,</para>
  <para style="q2">a min thyaapaw kha thehoysah oh.</para>
  <para style="q1">
    <verse number="2" style="v" />Pou ka muisaw, <char style="nd">Bawipaw </char> kha</para>
  <para style="q2">thehoysah lah,</para>
  <para style="q1">a thawccinaw balyn kha ning nan.</para>
  <para style="q1">
    <verse number="3" style="v" />Aning tuh na seinaw balyn kha</para>
  <para style="q2">ae ngaethyatupaw thua zah,</para>
  <para style="q1">na ccinaw balyn kha</para>
  <para style="q2">ae dansahtupaw nynh thua.</para>
  <para style="q1">
    <verse number="4" style="v" />Na hiinnaw kha Hunghuapi kyate</para>
  <para style="q2">ae shawkhawpaw thua zah,</para>
  <para style="q1">atynpaw sungsahnaw te</para>
  <para style="q2">thawccinaw khate nang kha</para>
  <para style="q1">bawilukhung ae khungsahpaw nynh thua.</para>
  <para style="q1">
    <verse number="5" style="v" />Mosipi thawzung hawte</para>
  <para style="q2">na ngawphuenaw kha</para>
  <para style="q2">thawsah thui athua nawlan,</para>
  <para style="q1">na hiin lungkhu balyn hoynaw te</para>
  <para style="q2">na lungrya ae chisahpaw nynh thua.</para>
  <para style="q1">
    <verse number="6" style="v" />
    <char style="nd">Bawipaw </char> nynh tuaasahnaw</para>
  <para style="q2">a ingpaw balyn hanlan</para>
  <para style="q1">dingnaw te byapianaw kha a raepya hae.</para>
  <para style="q1">
    <verse number="7" style="v" />A laanpi kha Moses nysah zah</para>
  <para style="q2">a cyisahnaw kha</para>
  <para style="q1">Israel ccungccaw hae a nysah hae.</para>
  <para style="q1">
    <verse number="8" style="v" />
    <char style="nd">Bawipaw </char> tuh thawccih thyapaw,</para>
  <para style="q2">ngaethyaumsah thyapaw,</para>
  <para style="q1">lungsaepaw te atynpaw sungsahnaw te</para>
  <para style="q2">phe abeihpaw nynh thua.<note caller="-" style="x"><char style="xo" closed="false">103.8: </char><char style="xt" closed="false"><ref loc="JAS 5:11">Jam 5.11</ref></char></note></para>
  <para style="q1">
    <verse number="9" style="v" />Ccungccaw tungvaw seibenaw</para>
  <para style="q2">zungzae mang lan khyh zah,</para>
  <para style="q2">zungzae a thinria lan khyh.</para>
  <para style="q1">
    <verse number="10" style="v" />Ah seinaw thyhte aening kha</para>
  <para style="q2">oun cyihru khyh zah,</para>
  <para style="q2">ah hoyleinaw thyhte oun liaru khyh.</para>
  <para style="q1">
    <verse number="11" style="v" />Vaawlui tuh laephi laeze ahang hawte</para>
  <para style="q2">atynpaw a sungsahnaw tuh</para>
  <para style="q2">amaw a rih hae paw tungvaw myarya ale;</para>
  <para style="q1">
    <verse number="12" style="v" />nithua tuh niccaw te asawku hawte</para>
  <para style="q2">ah cyiseimenaw kha</para>
  <para style="q1">aening kyate oun vuapya vae.</para>
  <para style="q1">
    <verse number="13" style="v" />Paaw nynh a ccaaw tungvaw</para>
  <para style="q2">thawccinaw a hoi hawte,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh amaw</para>
  <para style="q2">rawrih hae paw tungvaw</para>
  <para style="q2">thawccinaw a hoi vae.</para>
  <para style="q1">
    <verse number="14" style="v" />Pawccecize aening hynh</para>
  <para style="q2">pawtemou rae ah thua oh</para>
  <para style="q2">cipaw kha nyh zah,</para>
  <para style="q1">aening tuh laenoi nynh</para>
  <para style="q2">ah thua oh cipaw kha mah a nythui.</para>
  <para style="q1">
    <verse number="15" style="v" />Ccungccaw ccyh tuh</para>
  <para style="q2">lonua hawte nynh thua;</para>
  <para style="q1">ccungccaw tuh loo kya-e</para>
  <para style="q2">haetapaw hawte apaw;</para>
  <para style="q1">
    <verse number="16" style="v" />khisan nynh tuh-e haetapaw tuh</para>
  <para style="q2">mung zah phe azo,</para>
  <para style="q1">a umnaw hmin kha mah</para>
  <para style="q2">ny lan um vae khyh.</para>
  <para style="q1">
    <verse number="17" style="v" />Thuasalama <char style="nd">Bawipaw </char> kya-e</para>
  <para style="q2">atynpaw sungsahnaw tuh</para>
  <para style="q1">amaw rawrih hae paw tungvaw kya</para>
  <para style="q2">zungzae te zungzae cia tyn zah,</para>
  <para style="q1">a dingnaw tuh ccaawsenopaw cia atyn,</para>
  <para style="q1">
    <verse number="18" style="v" />a byakin a zui hae paw tungvaw te</para>
  <para style="q2">a kawbya zui lan</para>
  <para style="q1">a ning lei hae paw tungvaw kya atyn.</para>
  <para style="q1">
    <verse number="19" style="v" />
    <char style="nd">Bawipaw </char> nynh a bawitungkhung tuh</para>
  <para style="q2">vaawlang khe tynsah vae zah,</para>
  <para style="q1">a peenaw nynh atyn-are kha a uk.</para>
  <para style="q1">
    <verse number="20" style="v" />A hopaw bya kha kawngae hae zah</para>
  <para style="q2">a kawpyapaw a zui hae paw,</para>
  <para style="q1">athungpaw a vaawccungccaw hae nanning,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha thehoysah oh.</para>
  <para style="q1">
    <verse number="21" style="v" />
    <char style="nd">Bawipaw </char> rynaw</para>
  <para style="q2">a zuipaw a ryalahtu hae,</para>
  <para style="q1">a vaaw rhawkaw hae balyn,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha thehoysah oh.</para>
  <para style="q1">
    <verse number="22" style="v" />A uknaw hmin takyh kya um hae paw,</para>
  <para style="q2">amaw nynh a rae hae paw balyn,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha thehoysah oh.</para>
  <para style="q2">Pou ka muisaw, <char style="nd">Bawipaw </char> kha</para>
  <para style="q1">thehoysah tua.</para>
  <chapter number="104" style="c" />
  <para style="s1">Raetu Pachia Thehoysahnaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou ka muisaw, <char style="nd">Bawipaw </char> kha</para>
  <para style="q1">thehoysah tua.</para>
  <para style="q2">Pou <char style="nd">Bawipaw </char> ka Pachia,</para>
  <para style="q1">nang tuh myarya na lesae.</para>
  <para style="q1">Sawtuanaw te lesaenaw khate</para>
  <para style="q1">na ccaankuh zah,</para>
  <para style="q2">
    <verse number="2" style="v" />awnaw kha boeining hawte na zingku.</para>
  <para style="q2">Vaawlui kha boeibu hawte</para>
  <para style="q1">tharae na daw zah,</para>
  <para style="q1">
    <verse number="3" style="v" />avawlan umpaw tui vawlan khe</para>
  <para style="q1">na inn kha na sak;</para>
  <para style="q1">maeking kha na marangle lang na mang zah,</para>
  <para style="q2">khivae sake vawlan khe na cciku,</para>
  <para style="q1">
    <verse number="4" style="v" />khivae kha na locceihtu lang na mang zah,</para>
  <para style="q2">maee te maeesoi kha</para>
  <para style="q1">na ryalahtu lang na mang hae.<note caller="-" style="x"><char style="xo" closed="false">104.4: </char><char style="xt" closed="false"><ref loc="HEB 1:7">Heb 1.7</ref></char></note></para>
  <para style="q1">
    <verse number="5" style="v" />Laephi tuh kharouh a nueku khyh ccaw cite,</para>
  <para style="q2">a umnaw kyakhe na tynsah.</para>
  <para style="q1">
    <verse number="6" style="v" />Laephi kha boeining te</para>
  <para style="q2">bong hawte rili te na bong;</para>
  <para style="q1">tui hae tuh mua hae luki khe a thadyn hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Nang nynh tui hae tuh</para>
  <para style="q2">na pe hae zah a ccue hae;</para>
  <para style="q1">na kholungthyhpaw roi kha</para>
  <para style="q2">thae hae zah rangsakute a cceih hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Mua vawlan te bialae langkhe</para>
  <para style="q2">luabung hae zah, minmin elang</para>
  <para style="q1">na paccynpya hae paw hmin kya a thua hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Tui hae nynh laephi kha</para>
  <para style="q2">bua a vu khyh ccaw hae cite,</para>
  <para style="q1">po alua kho lei lante ramri kha na ia.</para>
  <para style="q1">
    <verse number="10" style="v" />Accya khe tuidy kha na phyhsah zah,</para>
  <para style="q2">mua hae laku khe alua hae,</para>
  <para style="q1">
    <verse number="11" style="v" />loramsaw miakaw kha</para>
  <para style="q2">nia lanpaw tui na pya hae;</para>
  <para style="q1">ramkaw e lann hae kha</para>
  <para style="q2">mih tuihaw na kesah vae hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Tuh-e tui kin khe vaawlang e</para>
  <para style="q2">pavaw hae tuh bu luakuh hae zah,</para>
  <para style="q1">thingkaran hae kya hlawsah hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Vaawlui kyate mua hae kha tui na bu hae;</para>
  <para style="q2">laephi tuh na ryalaw athae khate a lungryachih.</para>
  <para style="q1">
    <verse number="14" style="v" />Sahiin hae elang lonua kha na posah zah,</para>
  <para style="q2">ccungccaw hae nynh mang khylan</para>
  <para style="q1">thingku kha na posah,</para>
  <para style="q2">te laephi kyate looh tuh apou,</para>
  <para style="q2">
    <verse number="15" style="v" />misutui nynh ccungccaw kha</para>
  <para style="q2">a lungtuasah zah,</para>
  <para style="q1">chitui nynh mitmae kha a awsah,</para>
  <para style="q2">te sanlou nynh ccungccaw thaw a saesah.</para>
  <para style="q1">
    <verse number="16" style="v" />
    <char style="nd">Bawipaw </char> thingku hae,</para>
  <para style="q2">Lebanon kya a lingpaw sidar ku hae kha</para>
  <para style="q1">tui patae a bu hae.</para>
  <para style="q1">
    <verse number="17" style="v" />Tuh-e thingku hae kyakhe</para>
  <para style="q2">pavaw hae nynh mih bu a luaku hae;</para>
  <para style="q1">kaepaw-pavaw nynh</para>
  <para style="q2">maeccaw ku kya a luaku.</para>
  <para style="q1">
    <verse number="18" style="v" />Ahangpaw mua hae tuh</para>
  <para style="q2">sathaw hae hanlan thua zah,</para>
  <para style="q1">lung pipi hae tuh saveih dihpaw hae hanlan</para>
  <para style="q2">khynnaw nynh thua hae.</para>
  <para style="q1">
    <verse number="19" style="v" />Kumvaelori ny nawlan</para>
  <para style="q2">sawpaw kha na rae vae;</para>
  <para style="q2">khuanin nynh a ccaw ccyh kha a nyku.</para>
  <para style="q1">
    <verse number="20" style="v" />Mohnaw kha na rae,</para>
  <para style="q2">tuh-e tuh khuazi nynh thua,</para>
  <para style="q1">tuh ccyh lyakhe ramkaw e</para>
  <para style="q2">sarangpaw balyn tuh a pou hae.</para>
  <para style="q1">
    <verse number="21" style="v" />Anopaw chindeih hae tuh</para>
  <para style="q2">saw teiku khylan a sia hae,</para>
  <para style="q1">Pachia kya-e mih looh kha a ccungku hae.</para>
  <para style="q1">
    <verse number="22" style="v" />Khuanin he athua te, ki hae zah</para>
  <para style="q2">mih karung kya a ih hae.</para>
  <para style="q1">
    <verse number="23" style="v" />Ccungccaw hae tuh</para>
  <para style="q2">mih ryalawku khylan pou hae zah,</para>
  <para style="q2">zete cia rya a lah hae.</para>
  <para style="q1">
    <verse number="24" style="v" />Pou <char style="nd">Bawipaw </char>, na rae hae paw hynh</para>
  <para style="q2">pawcih baban mou alung!</para>
  <para style="q2">tuh-e hae balyn kha hawnaw te na rae vae;</para>
  <para style="q2">laephi tuh na raepaw te phe abeih.</para>
  <para style="q1">
    <verse number="25" style="v" />Rilipi tuh myarya le zah ako,</para>
  <para style="q2">tuin kyakhe riatae</para>
  <para style="q1">um leipaw avawthya hae paw,</para>
  <para style="q2">ahiinpaw adih ale a um hae.</para>
  <para style="q1">
    <verse number="26" style="v" />Tuin kyakhe sanphalung hae tuh</para>
  <para style="q2">ccue hae zah,</para>
  <para style="q1">tuin kya a zue lante na raepaw</para>
  <para style="q2">Leviathan hupi mah a um.<note caller="-" style="x"><char style="xo" closed="false">104.26: </char><char style="xt" closed="false"><ref loc="JOB 41:1">Job 41.1</ref>; <ref loc="PSA 74:14">Sam 74.14</ref>; <ref loc="ISA 27:1">Isa 27.1</ref></char></note></para>
  <para style="q1">
    <verse number="27" style="v" />Tuh-e hae balyn nynh accyh azaw te,</para>
  <para style="q2">mih looh mueku khylan</para>
  <para style="q1">nang kha ae ngaehoi hae;</para>
  <para style="q1">
    <verse number="28" style="v" />looh kha he na pya hae te,</para>
  <para style="q2">minmin nynh a ccakhungku hae;</para>
  <para style="q1">na kuih he na daw te,</para>
  <para style="q2">minmin tuh ahoypaw</para>
  <para style="q2">uccaw te phe a byn hae.</para>
  <para style="q1">
    <verse number="29" style="v" />Na mitmae he na retawkuh hae te,</para>
  <para style="q2">minmin tuh mih thinphang;</para>
  <para style="q1">mih hy he na thangsah hae te, chih hae zah</para>
  <para style="q2">mih laenoi kalan a ki hae.</para>
  <para style="q1">
    <verse number="30" style="v" />Na muisaw kha he na sawpah hae te,</para>
  <para style="q2">minmin tuh a hiin hae;</para>
  <para style="q1">te laephi mitmae kha na thawsah thui.</para>
  <para style="q1">
    <verse number="31" style="v" />
    <char style="nd">Bawipaw </char> phu-enaw tuh</para>
  <para style="q2">zungzae tyn vae sah;</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> tuh a raepaw kya</para>
  <para style="q2">a lungtua vae sah—</para>
  <para style="q1">
    <verse number="32" style="v" />laephi kha do zah laephi tuh a thyngkuh,</para>
  <para style="q2">mua hae kha ty zah maeekhuh a pou.</para>
  <para style="q1">
    <verse number="33" style="v" />Ka hiin lungkhu balyn</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kalan hlaw ka sah cih;</para>
  <para style="q1">hiinnaw ka hoi lyakhe ka Pachia kalan</para>
  <para style="q2">thehoysahnaw hlaw ka sah cih.</para>
  <para style="q1">
    <verse number="34" style="v" />Kae tuh <char style="nd">Bawipaw </char> kya</para>
  <para style="q2">ka lungtua keiccuze</para>
  <para style="q1">aning tuh ka tuanaw kya</para>
  <para style="q2">a lungrythua vae sah.</para>
  <para style="q1">
    <verse number="35" style="v" />Misei hae tuh laephi kyate</para>
  <para style="q2">maemih thua hae sah lah,</para>
  <para style="q1">ccungccaw hoylei hae paw tuh</para>
  <para style="q2">um nan vae hae sah.</para>
  <para style="q1">Pou ka muisaw, <char style="nd">Bawipaw </char> kha</para>
  <para style="q2">thehoysah tua.</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha thehoysah!</para>
  <chapter number="105" style="c" />
  <para style="s1">Israel hanlan Pachia Lungzinaw</para>
  <para style="r">(<ref loc="1CH 16:8-22">1Sh 16.8-22</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> kalan lungtuabya ho oh,</para>
  <para style="q2">a min kha ko oh lah,</para>
  <para style="q1">a cyipaw kha ccungccaw hae nysah oh.</para>
  <para style="q1">
    <verse number="2" style="v" />Amaw kalan hlawsah oh,</para>
  <para style="q2">thehoysahnaw hlawsah oh;</para>
  <para style="q1">ngaeangthua lan umpaw</para>
  <para style="q2">a ryalaw balyn kha ho oh.</para>
  <para style="q1">
    <verse number="3" style="v" />A min thyaapaw kha phu-esah oh;</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> a ccung hae paw thinlung tuh</para>
  <para style="q1">a lungtua sah.</para>
  <para style="q1">
    <verse number="4" style="v" />
    <char style="nd">Bawipaw </char> te a thawzung kha ccungtua;</para>
  <para style="q2">a mitmae kha ccung zungzae oh.</para>
  <para style="q1">
    <verse number="5-6" style="v" />Pou a seepaw Abraham ciihan,</para>
  <para style="q2">a popaw Jakob ccaaw hae,</para>
  <para style="q1">ngaeang lan umpaw a la cyipaw,</para>
  <para style="q1">ngaeang lan umpaw a ryalaw hae te</para>
  <para style="q2">a hopaw byapianaw kha liathui oh.</para>
  <para style="q1">
    <verse number="7" style="v" />Aning tuh <char style="nd">Bawipaw </char> ah Pachia nynh thua;</para>
  <para style="q2">a byapianaw tuh</para>
  <para style="q2">laephi pynpi hanlan nynh thua.</para>
  <para style="q1">
    <verse number="8" style="v" />A byakinnaw kha zungzae peki zah,</para>
  <para style="q2">kaw a pyapaw kha</para>
  <para style="q1">she thong kheit cia ning khyh,</para>
  <para style="q1">
    <verse number="9" style="v" />Abraham kya a raepaw byakinnaw,</para>
  <para style="q2">Isak kya a kinpyakupaw a byakinnaw,<note caller="-" style="x"><char style="xo" closed="false">105.9: </char><char style="xt" closed="false"><ref loc="GEN 12:7">Gen 12.7</ref>, <ref loc="GEN 17:8">17.8</ref>, <ref loc="GEN 26:3">26.3</ref></char></note></para>
  <para style="q1">
    <verse number="10" style="v" />Jakob kya phungbya lante tynsah zah,</para>
  <para style="q2">Israel kya zungzae tynpaw</para>
  <para style="q1">byakinnaw lante a tynsah,<note caller="-" style="x"><char style="xo" closed="false">105.10-11: </char><char style="xt" closed="false"><ref loc="GEN 28:13">Gen 28.13</ref></char></note></para>
  <para style="q1">
    <verse number="11" style="v" />“Kanaan ram hynh rho lang kae pya cih,”</para>
  <para style="q2">a la cipaw kha a liathui.</para>
  <para style="q1">
    <verse number="12" style="v" />Minmin tuh milu beihtaraw kyalya cih hae zah,</para>
  <para style="q2">ramccang ccungccaw lang tangte</para>
  <para style="q1">
    <verse number="13" style="v" />ram kheit kyate ram kheit kalan,</para>
  <para style="q2">pee kheit kyate ccangpaw pee kheit kalan</para>
  <para style="q1">he a khiavuikuh hae tuh,</para>
  <para style="q1">
    <verse number="14" style="v" />minmin tungvaw tuaasahnaw rae lan,</para>
  <para style="q2">aning nynh humhung sanmah ua khyh;</para>
  <para style="q1">minmin keiccuze siapharan hae kha</para>
  <para style="q2">pe hae zah,<note caller="-" style="x"><char style="xo" closed="false">105.14-15: </char><char style="xt" closed="false"><ref loc="GEN 20:3-7">Gen 20.3-7</ref></char></note></para>
  <para style="q1">
    <verse number="15" style="v" />“Chitui ka thuh hae paw kha ty nan oh;</para>
  <para style="q2">ka profeh hae kha</para>
  <para style="q1">vawsaw pya nan oh,” a cipya hae.</para>
  <para style="q1">
    <verse number="16" style="v" />
    <char style="nd">Bawipaw </char> nynh mih ram kyakhe</para>
  <para style="q2">ccakanccisah zah,</para>
  <para style="q1">mih looh miakaw kha</para>
  <para style="q2">he a ropah hae te,<note caller="-" style="x"><char style="xo" closed="false">105.16: </char><char style="xt" closed="false"><ref loc="GEN 41:53-57">Gen 41.53-57</ref></char></note></para>
  <para style="q1">
    <verse number="17" style="v" />see lang a zua hae paw Josef kha</para>
  <para style="q2">mih malang a saw.<note caller="-" style="x"><char style="xo" closed="false">105.17: </char><char style="xt" closed="false"><ref loc="GEN 37:28">Gen 37.28</ref>, <ref loc="GEN 45:5">45.5</ref></char></note></para>
  <para style="q1">
    <verse number="18" style="v" />A ccu kha sivawrui te khii hae zah,</para>
  <para style="q2">a nging kyakhe sivaw a oisaku hae;<note caller="-" style="x"><char style="xo" closed="false">105.18-19: </char><char style="xt" closed="false"><ref loc="GEN 39:20-40:23">Gen 39.20—40.23</ref></char></note></para>
  <para style="q1">
    <verse number="19" style="v" />a la hopaw bya accing mawlaezung</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> bya nynh</para>
  <para style="q2">amaw kha a syntawtua.</para>
  <para style="q1">
    <verse number="20" style="v" />Siapharan nynh saw zah a luesah;</para>
  <para style="q2">minphuin hae a uktupaw nynh</para>
  <para style="q1">amaw kha a luesah.<note caller="-" style="x"><char style="xo" closed="false">105.20: </char><char style="xt" closed="false"><ref loc="GEN 41:14">Gen 41.14</ref></char></note></para>
  <para style="q1">
    <verse number="21" style="v" />A ram uktu lang tangsah zah,</para>
  <para style="q2">a hoipaw uccaw balyn kha</para>
  <para style="q1">a uktu lang a nung,<note caller="-" style="x"><char style="xo" closed="false">105.21: </char><char style="xt" closed="false"><ref loc="GEN 41:39-41">Gen 41.39-41</ref></char></note></para>
  <para style="q1">
    <verse number="22" style="v" />siapharan kuihkaw e bawi hae kha</para>
  <para style="q2">thuihei khylan te</para>
  <para style="q1">siapharan kuihkaw e piccan hae kha</para>
  <para style="q2">hawnaw te ccangpya khylan a nung.</para>
  <para style="q1">
    <verse number="23" style="v" />Oute Israel tuh Izip ram lang a thua,</para>
  <para style="q2">Jakob tuh Ham ram kya</para>
  <para style="q1">ramccang ccungccaw lante a um.<note caller="-" style="x"><char style="xo" closed="false">105.23: </char><char style="xt" closed="false"><ref loc="GEN 46:6">Gen 46.6</ref>, <ref loc="GEN 47:11">47.11</ref></char></note></para>
  <para style="q1">
    <verse number="24" style="v" />Te <char style="nd">Bawipaw </char> nynh a ccungccaw hae kha</para>
  <para style="q2">myarya pungzaesah hae zah,</para>
  <para style="q1">mih rhaw hae laeze</para>
  <para style="q2">a thawsae huapaw lang a rae hae,<note caller="-" style="x"><char style="xo" closed="false">105.24-25: </char><char style="xt" closed="false"><ref loc="EXO 1:7-14">Exo 1.7-14</ref></char></note></para>
  <para style="q1">
    <verse number="25" style="v" />Izip hae nynh a ccungccaw hae kha</para>
  <para style="q2">hua khylan te a see hae kha thyaruhnaw te</para>
  <para style="q1">phee khylan Izip hae thinlung kha a paleih.</para>
  <para style="q1">
    <verse number="26" style="v" />Aning nynh a seepaw Moses te</para>
  <para style="q2">a po vae paw Aaron kha a saw hae.<note caller="-" style="x"><char style="xo" closed="false">105.26: </char><char style="xt" closed="false"><ref loc="EXO 3:1-4:17">Exo 3.1—4.17</ref></char></note></para>
  <para style="q1">
    <verse number="27" style="v" />Minmin nynh Izip hae kyakhe</para>
  <para style="q2">amaw kya-e muihsahnaw hae kha rae hae zah,</para>
  <para style="q1">Ham ram kya ngaeangnaw hae kha a rae hae.</para>
  <para style="q1">
    <verse number="28" style="v" />Ram lungkhu kya mohnaw kha saw zah,</para>
  <para style="q2">ram kha a mohsah;</para>
  <para style="q1">thuasalama Izip hae nynh a bya kha</para>
  <para style="q2">zui leite a rawse hae.<note caller="-" style="x"><char style="xo" closed="false">105.28: </char><char style="xt" closed="false"><ref loc="EXO 10:21-23">Exo 10.21-23</ref></char></note></para>
  <para style="q1">
    <verse number="29" style="v" />Mih tui kha chiise lang tangsah zah,</para>
  <para style="q2">mih ngasaw kha a chisah.<note caller="-" style="x"><char style="xo" closed="false">105.29: </char><char style="xt" closed="false"><ref loc="EXO 7:17-21">Exo 7.17-21</ref></char></note></para>
  <para style="q1">
    <verse number="30" style="v" />Mih ram tuh buphaw te phe beih zah,</para>
  <para style="q2">mih siapharan inn kya heize phe abeih.<note caller="-" style="x"><char style="xo" closed="false">105.30: </char><char style="xt" closed="false"><ref loc="EXO 8:1-6">Exo 8.1-6</ref></char></note></para>
  <para style="q1">
    <verse number="31" style="v" />Pachia nynh kawpya zah</para>
  <para style="q2">myn hae te maseih hae tuh</para>
  <para style="q1">mih ram pynpi kya phe abeih.<note caller="-" style="x"><char style="xo" closed="false">105.31: </char><char style="xt" closed="false"><ref loc="EXO 8:16-17">Exo 8.16-17</ref>, <ref loc="EXO 8:20-24">20-24</ref></char></note></para>
  <para style="q1">
    <verse number="32" style="v" />Khuaatui hanpaw hya kha ccawsah zah,</para>
  <para style="q2">mih ram pynpi kya ria a kawsah.<note caller="-" style="x"><char style="xo" closed="false">105.32-33: </char><char style="xt" closed="false"><ref loc="EXO 9:22-25">Exo 9.22-25</ref></char></note></para>
  <para style="q1">
    <verse number="33" style="v" />Mih misu ku hae te thaeku ku hae kha roh zah,</para>
  <para style="q2">mih ram e thingku hae kha pong akhya.</para>
  <para style="q1">
    <verse number="34" style="v" />Kawpya zah tungkhipaw hae tuh oun thua hae,</para>
  <para style="q2">riatae leipaw tungkhipaw adih hae paw tuh</para>
  <para style="q1">oun thua hae zah,<note caller="-" style="x"><char style="xo" closed="false">105.34-35: </char><char style="xt" closed="false"><ref loc="EXO 10:12-15">Exo 10.12-15</ref></char></note></para>
  <para style="q1">
    <verse number="35" style="v" />mih ram e thingku-ruaku</para>
  <para style="q2">aphuinphuin kha marya a ae hae,</para>
  <para style="q1">mih laephi kya-e athae hae kha mah</para>
  <para style="q2">marya a ae hae.</para>
  <para style="q1">
    <verse number="36" style="v" />Mih thawzung balyn kyate</para>
  <para style="q2">masaty a poupaw</para>
  <para style="q1">mih ram kya-e ccatawccaw balyn kha a chia.<note caller="-" style="x"><char style="xo" closed="false">105.36: </char><char style="xt" closed="false"><ref loc="EXO 12:29">Exo 12.29</ref></char></note></para>
  <para style="q1">
    <verse number="37" style="v" />Oute Israel kha sui te ngun ryte a poukhae,</para>
  <para style="q2">mih phin raveih kya</para>
  <para style="q1">a thawzyapaw lu kheit san um khyh.<note caller="-" style="x"><char style="xo" closed="false">105.37-38: </char><char style="xt" closed="false"><ref loc="EXO 12:33-36">Exo 12.33-36</ref></char></note></para>
  <para style="q1">
    <verse number="38" style="v" />Izip hae nynh minmin kha</para>
  <para style="q2">a ri hae keiccuze,</para>
  <para style="q1">minmin he a pou hae tuh</para>
  <para style="q2">Izip hae mih lungtua.</para>
  <para style="q1">
    <verse number="39" style="v" />Minmin luki khe maeking kha</para>
  <para style="q2">dawpah hae zah,</para>
  <para style="q2">khuazi kya a aw ccaw cite</para>
  <para style="q1">maee kha a pya hae.<note caller="-" style="x"><char style="xo" closed="false">105.39: </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">Exo 13.21-22</ref></char></note></para>
  <para style="q1">
    <verse number="40" style="v" />Minmin nynh ngia hae zah,</para>
  <para style="q2">vamyng kha a pya hae,</para>
  <para style="q1">vaawlang te looh patae a pya hae.<note caller="-" style="x"><char style="xo" closed="false">105.40: </char><char style="xt" closed="false"><ref loc="EXO 16:2-15">Exo 16.2-15</ref></char></note></para>
  <para style="q1">
    <verse number="41" style="v" />Lungpi kha hung zah tui tuh a pou;</para>
  <para style="q2">tuh-e tui tuh vawpi hawte</para>
  <para style="q1">laesia ram kya po alua.<note caller="-" style="x"><char style="xo" closed="false">105.41: </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">Exo 17.1-7</ref>; <ref loc="NUM 20:2-13">Nam 20.2-13</ref></char></note></para>
  <para style="q1">
    <verse number="42" style="v" />Pawccecize a seepaw Abraham kya</para>
  <para style="q2">a la raepaw athyaapaw</para>
  <para style="q1">a byakinnaw kha a liathui.</para>
  <para style="q1">
    <verse number="43" style="v" />Tuhcite a ccungccaw hae kha</para>
  <para style="q2">lungtuate a cciakhae hae,</para>
  <para style="q1">a po hae paw kha hlawsah biate</para>
  <para style="q2">a cciakhae hae.</para>
  <para style="q1">
    <verse number="44" style="v" />Minphuin ccangpaw hae ram kha</para>
  <para style="q2">minmin kalan pya hae zah,</para>
  <para style="q1">minmin nynh tuh-e hae hoirumnaw kha</para>
  <para style="q2">a hoi hae paw uccaw lang a lawku hae,<note caller="-" style="x"><char style="xo" closed="false">105.44: </char><char style="xt" closed="false"><ref loc="JOS 11:16-23">Jos 11.16-23</ref></char></note></para>
  <para style="q1">
    <verse number="45" style="v" />tuh-e tuh a ccungccaw hae nynh</para>
  <para style="q2">a phungbya kha zui hae zah,</para>
  <para style="q1">a upadi hae kha a zui ccaw hae cite</para>
  <para style="q2">a cyipaw nynh thua.</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <chapter number="106" style="c" />
  <para style="s1">Israel Seinaw Phykunaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> tuh hoy zah,</para>
  <para style="q1">a sungsahnaw tuh zungzae atyn keiccuze</para>
  <para style="q2">amaw kalan lungtuabya ho oh.<note caller="-" style="x"><char style="xo" closed="false">106.1: </char><char style="xt" closed="false"><ref loc="1CH 16:34">1Sh 16.34</ref>; <ref loc="2CH 5:13">2Sh 5.13</ref>, <ref loc="2CH 7:3">7.3</ref>; <ref loc="EZR 3:11">Ezr 3.11</ref>; <ref loc="PSA 100:5">Sam 100.5</ref>, <ref loc="PSA 107:1">107.1</ref>, <ref loc="PSA 118:1">118.1</ref>, <ref loc="PSA 136:1">136.1</ref>; <ref loc="JER 33:11">Jer 33.11</ref></char></note></para>
  <para style="q1">
    <verse number="2" style="v" />
    <char style="nd">Bawipaw </char> nynh a cyipaw</para>
  <para style="q2">alesaepaw balyn kha</para>
  <para style="q1">hum nynh mou a ho kho cih?</para>
  <para style="q2">Hum nynh mou a thehoynaw balyn kha</para>
  <para style="q1">a ho kho cih?</para>
  <para style="q1">
    <verse number="3" style="v" />Byading kha zui zah, dingnaw kha</para>
  <para style="q2">zungzae a raepaw tuh</para>
  <para style="q1">lungtuapaw nynh thua.</para>
  <para style="q1">
    <verse number="4" style="v" />Pou <char style="nd">Bawipaw </char>, na ccungccaw hae kya</para>
  <para style="q2">maehoynaw he na langsakuh te,</para>
  <para style="q1">kae kha yn liathuitua;</para>
  <para style="q2">minmin kha he na luesah hae te,</para>
  <para style="q1">kae mah yn bawmbua;</para>
  <para style="q1">
    <verse number="5" style="v" />na po hae paw kya</para>
  <para style="q2">hoynaw kha ka muih nawlan,</para>
  <para style="q1">na minphuin a lungtuanaw kya</para>
  <para style="q2">ka lungtuabua nawlan,</para>
  <para style="q1">te na rho athua hae paw kya</para>
  <para style="q2">ka lungtuabua nawlan kae kha yn liathuitua.</para>
  <para style="q1">
    <verse number="6" style="v" />Kaening te kae minpaaw hae tuh kae sei vae;</para>
  <para style="q2">hoyleinaw kha kae rae vae;</para>
  <para style="q2">ahoy lei lante kae cyi vae.</para>
  <para style="q1">
    <verse number="7" style="v" />Kae minpaaw hae Izip ram kya</para>
  <para style="q2">a la um lya hae ze</para>
  <para style="q2">ngaeang lan umpaw</para>
  <para style="q1">na ryalawnaw hae kha</para>
  <para style="q2">tuathyanaw la hoi khyh hae;</para>
  <para style="q1">myarya lepaw atynpaw</para>
  <para style="q2">na sungsahnaw kha la liathui khyh hae,</para>
  <para style="q1">Rili Se kyakhe Ahang Huaccepaw kha</para>
  <para style="q2">a dou hae.<note caller="-" style="x"><char style="xo" closed="false">106.7: </char><char style="xt" closed="false"><ref loc="EXO 14:10-12">Exo 14.10-12</ref></char></note></para>
  <para style="q1">
    <verse number="8" style="v" />Tuhzemah alesaepaw</para>
  <para style="q2">a huhan kha langsah khylan,</para>
  <para style="q1">amaw min hanlan</para>
  <para style="q2">minmin kha a khum hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Rili Se kha kawpya zah karae arou;</para>
  <para style="q2">laerou kya cciakhae hawte</para>
  <para style="q1">akhupaw kya po a cciakhae hae.<note caller="-" style="x"><char style="xo" closed="false">106.9-12: </char><char style="xt" closed="false"><ref loc="EXO 14:21-31">Exo 14.21-31</ref></char></note></para>
  <para style="q1">
    <verse number="10" style="v" />Tuhcite minmin kha</para>
  <para style="q2">mih rhaw hae kuih kyate khum hae zah,</para>
  <para style="q1">rhaw hae kuih kyate a luesah hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Mih rhaw hae kha tui nynh</para>
  <para style="q2">marya vu hae zah,</para>
  <para style="q1">lu kheit sanmah lue khyh hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Tetuh minmin nynh</para>
  <para style="q2">amaw bya kha zyn hae zah,</para>
  <para style="q2">a thehoysahnaw hlaw kha a sah hae.<note caller="-" style="x"><char style="xo" closed="false">106.12: </char><char style="xt" closed="false"><ref loc="EXO 15:1-21">Exo 15.1-21</ref></char></note></para>
  <para style="q1">
    <verse number="13" style="v" />Thuasalama aro mawkhe</para>
  <para style="q2">a bya kha a ning hae;</para>
  <para style="q1">amaw kya-e tuanaw pyakunaw kha</para>
  <para style="q2">ngaehoikuh khyh hae.</para>
  <para style="q1">
    <verse number="14" style="v" />Ramkaw khe ryduaanaw</para>
  <para style="q2">myaryamaw hoi hae zah,</para>
  <para style="q1">laesia ram kya Pachia kha</para>
  <para style="q2">a syntawtua hae;<note caller="-" style="x"><char style="xo" closed="false">106.14-15: </char><char style="xt" closed="false"><ref loc="NUM 11:4-34">Nam 11.4-34</ref></char></note></para>
  <para style="q1">
    <verse number="15" style="v" />minmin nynh a ngia hae paw kha</para>
  <para style="q2">aning nynh a pya hae,</para>
  <para style="q1">thuasalama ri lan umpaw ccinaw kha</para>
  <para style="q2">a sawnua hae.</para>
  <para style="q1">
    <verse number="16" style="v" />Minmin nynh ryahmin kyakhe</para>
  <para style="q2">Moses tungvaw te</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kya-e athyaapaw</para>
  <para style="q2">Aaron tungvaw kya</para>
  <para style="q2">eiungnaw a hoi hae.<note caller="-" style="x"><char style="xo" closed="false">106.16-18: </char><char style="xt" closed="false"><ref loc="NUM 16:1-35">Nam 16.1-35</ref></char></note></para>
  <para style="q1">
    <verse number="17" style="v" />Laephi nynh haehae ua zah</para>
  <para style="q2">Dathan kha po a laang,</para>
  <para style="q1">Abiram te a innbyn hae kha</para>
  <para style="q2">pong a thei hae.</para>
  <para style="q1">
    <verse number="18" style="v" />Minmin a zui hae paw kyakhe</para>
  <para style="q2">maee-u zah, maeesoi nynh</para>
  <para style="q1">ccungccaw hoylei hae paw kha phe a u hae.</para>
  <para style="q1">
    <verse number="19" style="v" />Minmin nynh Horeb kyakhe</para>
  <para style="q2">vaetuataw kha raekuh hae zah,</para>
  <para style="q1">a laeeku hae paw zohtuh kha</para>
  <para style="q2">a beik hae.<note caller="-" style="x"><char style="xo" closed="false">106.19-23: </char><char style="xt" closed="false"><ref loc="EXO 32:1-14">Exo 32.1-14</ref></char></note></para>
  <para style="q1">
    <verse number="20" style="v" />Pachia phu-enaw kha</para>
  <para style="q2">lonua a aepaw vaetua zuh lang a rulae hae.</para>
  <para style="q1">
    <verse number="21" style="v" />Minmin nynh mih Khumtu athuapaw</para>
  <para style="q2">Pachia kha a ning hae;</para>
  <para style="q1">aning tuh Izip ram kya myarya lepaw</para>
  <para style="q2">uccaw hae a raetupaw thua zah,</para>
  <para style="q1">
    <verse number="22" style="v" />Ham ram kya ngaeang lan umpaw</para>
  <para style="q2">uccaw a raetupaw te,</para>
  <para style="q1">Rili Se kya ri lan umpaw</para>
  <para style="q2">uccaw a raetupaw nynh thua.</para>
  <para style="q1">
    <verse number="23" style="v" />Tukeiccuze Pachia nynh minmin kha</para>
  <para style="q2">ka roh cih hae a ci;</para>
  <para style="q1">tuhzemah a popaw Moses nynh</para>
  <para style="q2">Pachia malang thadyn zah,</para>
  <para style="q1">minmin kha a ro khyh nawlan hae</para>
  <para style="q2">Pachia thinrianaw kha a daesah.</para>
  <para style="q1">
    <verse number="24" style="v" />Oute minmin nynh ram hoypaw kha</para>
  <para style="q2">pawlangria khyh hae zah,</para>
  <para style="q1">a byakinnaw kha zyn khyh hae.<note caller="-" style="x"><char style="xo" closed="false">106.24-26: </char><char style="xt" closed="false"><ref loc="NUM 14:1-35">Nam 14.1-35</ref></char></note></para>
  <para style="q1">
    <verse number="25" style="v" />Mih bu kyakhe ccohkuh hae zah,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> bya kha ngae khyh hae.</para>
  <para style="q1">
    <verse number="26" style="v" />Tukeiccuze a kuih kha hang zah,</para>
  <para style="q2">“Minmin hynh ramkaw kya</para>
  <para style="q2">ka khulia cih hae,</para>
  <para style="q1">
    <verse number="27" style="v" />mih ciihan hae kha</para>
  <para style="q2">minphuin ccangpaw hae laku kya</para>
  <para style="q1">ka zosah cih hae zah,</para>
  <para style="q2">ccangpaw ram hae kya</para>
  <para style="q1">phiariphiarae ka nung cih hae,” cite</para>
  <para style="q2">minmin kya bya a kinku.<note caller="-" style="x"><char style="xo" closed="false">106.27: </char><char style="xt" closed="false"><ref loc="LEV 26:33">Lev 26.33</ref></char></note></para>
  <para style="q1">
    <verse number="28" style="v" />Tetuh minmin nynh Peor kya umpaw</para>
  <para style="q2">Baal pachia kha beikbua hae zah,</para>
  <para style="q1">achihpaw kalan a pya hae paw</para>
  <para style="q2">silawnawpaw kha a aebua hae;<note caller="-" style="x"><char style="xo" closed="false">106.28-31: </char><char style="xt" closed="false"><ref loc="NUM 25:1-13">Nam 25.1-13</ref></char></note></para>
  <para style="q1">
    <verse number="29" style="v" />mih cyisahnaw te <char style="nd">Bawipaw </char> kha</para>
  <para style="q2">thinriasah hae zah,</para>
  <para style="q1">ccinaw alepaw kha minmin kya a pousah.</para>
  <para style="q1">
    <verse number="30" style="v" />Oute Finehas nynh thadyn zah</para>
  <para style="q2">bya a pia keiccuze</para>
  <para style="q1">ccinaw alepaw tuh phe adae.</para>
  <para style="q1">
    <verse number="31" style="v" />Tuh-e tuh Finehas a dingnaw lang</para>
  <para style="q2">she takyh kya zungzae riapya athua.</para>
  <para style="q1">
    <verse number="32" style="v" />Minmin nynh Meribah tui kyakhe</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha a thinriasah hae zah,</para>
  <para style="q1">minmin keiccuze Moses tuh</para>
  <para style="q2">vawsawnaw a tung;<note caller="-" style="x"><char style="xo" closed="false">106.32-33: </char><char style="xt" closed="false"><ref loc="NUM 20:2-13">Nam 20.2-13</ref></char></note></para>
  <para style="q1">
    <verse number="33" style="v" />Moses kha myaryamaw</para>
  <para style="q2">a thin a riasah hae keiccuze,</para>
  <para style="q1">aning nynh ho lan</para>
  <para style="q2">accan leipaw cia kha phe a ho.</para>
  <para style="q1">
    <verse number="34" style="v" />
    <char style="nd">Bawipaw </char> nynh kaw a pya hae thyhte,</para>
  <para style="q2">minmin nynh minphuin ccangpaw hae kha</para>
  <para style="q1">roh khyh hae,<note caller="-" style="x"><char style="xo" closed="false">106.34-36: </char><char style="xt" closed="false"><ref loc="JDG 2:1-3">Bpt 2.1-3</ref>, <ref loc="JDG 3:5-6">3.5-6</ref></char></note></para>
  <para style="q1">
    <verse number="35" style="v" />tuh-e minphuin hae ryte pykuh hae zah,</para>
  <para style="q2">tuh-e hae nynh a cyi hae hawte</para>
  <para style="q1">cyi lan a ccangku hae.</para>
  <para style="q1">
    <verse number="36" style="v" />Minmin nynh mimaw hanlan</para>
  <para style="q2">kaang lang atangpaw</para>
  <para style="q1">mih zohtuh hae kha a beik hae.</para>
  <para style="q1">
    <verse number="37" style="v" />Mih ccanung hae te</para>
  <para style="q2">mih ccapaw hae khate</para>
  <para style="q1">raerangsaro hae kha si a law hae;<note caller="-" style="x"><char style="xo" closed="false">106.37: </char><char style="xt" closed="false"><ref loc="2KI 17:17">2Si 17.17</ref></char></note></para>
  <para style="q1">
    <verse number="38" style="v" />seinaw a hoi leipaw chiise,</para>
  <para style="q2">mih ccanung hae te</para>
  <para style="q1">mih ccapaw hae chiise khate</para>
  <para style="q2">Kanaan zohtuh hae kha si a law hae,</para>
  <para style="q1">tuh-e ram tuh chiise te a nungsikuh.<note caller="-" style="x"><char style="xo" closed="false">106.38: </char><char style="xt" closed="false"><ref loc="NUM 35:33">Nam 35.33</ref></char></note></para>
  <para style="q1">
    <verse number="39" style="v" />Tuhcite mih cyisahnaw keiccuze</para>
  <para style="q2">athyaa leipaw lang a tang hae,</para>
  <para style="q1">mih cyisahnaw kya a ohhuaku hae.</para>
  <para style="q1">
    <verse number="40" style="v" />Tetuh <char style="nd">Bawipaw </char> thinrianaw tuh</para>
  <para style="q2">a ccungccaw hae tungvaw</para>
  <para style="q2">maee lang rua zah,</para>
  <para style="q1">a rho kha a hua vae;<note caller="-" style="x"><char style="xo" closed="false">106.40-46: </char><char style="xt" closed="false"><ref loc="JDG 2:14-18">Bpt 2.14-18</ref></char></note></para>
  <para style="q1">
    <verse number="41" style="v" />minmin a huatu hae nynh</para>
  <para style="q2">minmin kha uk khylan</para>
  <para style="q1">minphuin ccangpaw hae</para>
  <para style="q2">kuih kalan a pya hae.</para>
  <para style="q1">
    <verse number="42" style="v" />Mih rhaw hae nynh minmin kha</para>
  <para style="q2">tuaasah hae zah,</para>
  <para style="q1">mih rhaw hae kuihkaw khe</para>
  <para style="q2">nung athua hae.</para>
  <para style="q1">
    <verse number="43" style="v" />Minmin kha avae patae a luesah hae,</para>
  <para style="q2">thuasalama minmin nynh</para>
  <para style="q1">mih rynaw kyakhe amaw kha</para>
  <para style="q2">a dou hae,</para>
  <para style="q1">te mih hoyleinaw keiccuze</para>
  <para style="q2">nyaasah athua hae.</para>
  <para style="q1">
    <verse number="44" style="v" />Tuhzemah mih siaruanaw kha</para>
  <para style="q2">he a thaepah hae te,</para>
  <para style="q1">mih riathaenaw kha pe a kipya hae.</para>
  <para style="q1">
    <verse number="45" style="v" />Minmin hanlan</para>
  <para style="q2">a byakinnaw kha liathui zah,</para>
  <para style="q1">atynpaw a sungsahnaw alepaw liate</para>
  <para style="q2">ngaethyaumsahnaw kha a langsaku.</para>
  <para style="q1">
    <verse number="46" style="v" />Minmin a kyngtu hae paw balyn kyakhe</para>
  <para style="q2">ngaethyaumsahnaw a hoisah hae.</para>
  <para style="q1">
    <verse number="47" style="v" />Pou <char style="nd">Bawipaw </char> kae Pachia,</para>
  <para style="q2">kaening hynh oun khumtua,</para>
  <para style="q1">minphuin ccangpaw hae laku kyate</para>
  <para style="q2">oun sueluatua,</para>
  <para style="q1">tuhteze nynh athyaapaw na min te</para>
  <para style="q2">namaw thehoysahnaw kya</para>
  <para style="q1">phu-enaw kha lungtuabya kae ho cih.<note caller="-" style="x"><char style="xo" closed="false">106.47-48: </char><char style="xt" closed="false"><ref loc="1CH 16:35-36">1Sh 16.35-36</ref></char></note></para>
  <para style="q1">
    <verse number="48" style="v" />Israel Pachia <char style="nd">Bawipaw </char> kha</para>
  <para style="q2">zungzae te zungzae cia thehoysah oh.</para>
  <para style="q1">Ccungccaw balyn nynh,</para>
  <para style="q2">“Amen” ci hae sah.</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <chapter number="107" style="c" />
  <para style="ms">UK 5</para>
  <para style="mr">(<ref loc="PSA 107-150">Sam 107—150</ref>)</para>
  <para style="s1">Pachia Hoynaw Thehoysahnaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> tuh ahoy keiccuze</para>
  <para style="q2">amaw kalan lungtuabya ho oh;</para>
  <para style="q1">pawccecize atynpaw a sungsahnaw tuh</para>
  <para style="q1">zungzae atyn.<note caller="-" style="x"><char style="xo" closed="false">107.1: </char><char style="xt" closed="false"><ref loc="1CH 16:34">1Sh 16.34</ref>; <ref loc="2CH 5:13">2Sh 5.13</ref>, <ref loc="2CH 7:3">7.3</ref>; <ref loc="EZR 3:11">Ezr 3.11</ref>; <ref loc="PSA 100:5">Sam 100.5</ref>, <ref loc="PSA 106:1">106.1</ref>, <ref loc="PSA 118:1">118.1</ref>, <ref loc="PSA 136:1">136.1</ref>; <ref loc="JER 33:11">Jer 33.11</ref></char></note></para>
  <para style="q1">
    <verse number="2-3" style="v" />Vawsawnaw kyate khum thua hae zah,</para>
  <para style="q2">nithua, niccaw, thahlang, deilang umpaw</para>
  <para style="q1">ram hae kyate a suelua hae paw,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh a khum hae paw kha nynh</para>
  <para style="q1">tuh-e bya tuh buabua ho hae sah.</para>
  <para style="q1">
    <verse number="4" style="v" />Ccungccaw abang tuh umnaw lanpaw</para>
  <para style="q2">khua kalan a cceihpaw</para>
  <para style="q2">laanpi kha muihku leite,</para>
  <para style="q1">ccungccaw um leinaw laesia ram kyakhe</para>
  <para style="q2">a khiavuikuh hae;</para>
  <para style="q1">
    <verse number="5" style="v" />mih vuelaw, mih tuihaw zah,</para>
  <para style="q2">mih lungthaw athang.</para>
  <para style="q1">
    <verse number="6" style="v" />Tetuh mih vawsawnaw kyate</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kalan sia hae zah,</para>
  <para style="q1">aning nynh mih riathaenaw kyate a luesah hae;</para>
  <para style="q1">
    <verse number="7" style="v" />a um nawlan hae paw khua kya</para>
  <para style="q2">a thua mawlaezung hae,</para>
  <para style="q1">alawpaw laanpi kyate a cciakhae hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Atynpaw a sungsahnaw te</para>
  <para style="q2">ccungccaw hae kya</para>
  <para style="q2">a raepaw ngaeangnaw hae keiccuze</para>
  <para style="q1">minmin nynh <char style="nd">Bawipaw </char> kalan</para>
  <para style="q2">lungtuabya ho hae sah.</para>
  <para style="q1">
    <verse number="9" style="v" />Pawccecize tui a hawpaw kha</para>
  <para style="q2">a tuihawkesah hae zah,</para>
  <para style="q1">a vuelawpaw kha ahoypaw uccaw te</para>
  <para style="q2">a vue a sosah.</para>
  <para style="q1">
    <verse number="10" style="v" />Ccungccaw abang tuh ngaethyate</para>
  <para style="q2">mohnaw kya a haung hae,</para>
  <para style="q1">vawsaw teingte sivawrui te hekute</para>
  <para style="q2">thongccah hae paw a um,</para>
  <para style="q1">
    <verse number="11" style="v" />pawccecize minmin nynh Pachia bya kha</para>
  <para style="q2">rawsete dou hae zah,</para>
  <para style="q1">Ahang Huaccepaw kya-e tuanaw</para>
  <para style="q2">pyakunaw kha pawlangria khyh hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Ryalaw arupaw khate</para>
  <para style="q2">mih lung a thangsah hae,</para>
  <para style="q1">khuliakuh hae zah, a thotu te</para>
  <para style="q2">a bawmtu lu kheit san um khyh.</para>
  <para style="q1">
    <verse number="13" style="v" />Tetuh mih vawsawnaw kyate</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kalan sia hae zah,</para>
  <para style="q1">aning nynh mih riathaenaw kyate a khum hae;</para>
  <para style="q1">
    <verse number="14" style="v" />mohnaw te lungthangnaw kyate</para>
  <para style="q2">minmin kha poh thuaa hae zah,</para>
  <para style="q1">a heenaw hae paw kha a paepya hae.</para>
  <para style="q1">
    <verse number="15" style="v" />Atynpaw a sungsahnaw te</para>
  <para style="q2">ccungccaw hae kya</para>
  <para style="q1">a raepaw ngaeangnaw hae keiccuze</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kalan lungtuabya ho hae sah.</para>
  <para style="q1">
    <verse number="16" style="v" />Pawccecize sohin thuakaw kha khya zah,</para>
  <para style="q2">sivaccaw hae kha</para>
  <para style="q1">ccangning lang a khya hae.</para>
  <para style="q1">
    <verse number="17" style="v" />Abang tuh seinaw laanpi</para>
  <para style="q2">a zuinaw hae kya a ngaeekhaekuh hae,</para>
  <para style="q1">mih hoyleinaw keiccuze</para>
  <para style="q2">riathaenaw a teing hae;</para>
  <para style="q1">
    <verse number="18" style="v" />Looh phuin miakaw kha ry khyh hae zah,</para>
  <para style="q2">chinaw koikua kalan a naekuh hae.</para>
  <para style="q1">
    <verse number="19" style="v" />Tetuh mih vawsawnaw kyate</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kalan sia hae zah,</para>
  <para style="q1">aning nynh mih riathaenaw kyate a khum hae;</para>
  <para style="q1">
    <verse number="20" style="v" />a bya kha sawnua hae zah a dansah hae,</para>
  <para style="q2">te ronaw kyate a khum hae.</para>
  <para style="q1">
    <verse number="21" style="v" />Atynpaw a sungsahnaw te</para>
  <para style="q2">ccungccaw hae kya</para>
  <para style="q1">a raepaw ngaeangnaw hae keiccuze</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kalan lungtuabya ho hae sah.</para>
  <para style="q1">
    <verse number="22" style="v" />Lungtua silawnaw rae hae sah lah,</para>
  <para style="q2">lungtuanaw hlawsahte</para>
  <para style="q2">a cyipaw kha ho hae sah.</para>
  <para style="q1">
    <verse number="23" style="v" />Abang tuh sanphalung ccikute</para>
  <para style="q2">rili vawlan cceih hae zah,</para>
  <para style="q1">tui vawlan khe vuekuakunaw rya a lawkuh hae;</para>
  <para style="q1">
    <verse number="24" style="v" />minmin nynh <char style="nd">Bawipaw </char> ryalawnaw te</para>
  <para style="q2">tui akhupaw kya ngaeangthua lan umpaw</para>
  <para style="q1">a ryalawnaw hae kha a muih hae.</para>
  <para style="q1">
    <verse number="25" style="v" />Kawpya zah khise atho keiccuze</para>
  <para style="q2">tuileih atho.</para>
  <para style="q1">
    <verse number="26" style="v" />Sanphalung tuh vaawlui langkhe</para>
  <para style="q2">hangkuh zah akhunaw langkhe a ccahbung;</para>
  <para style="q1">ccungccaw hae tuh</para>
  <para style="q2">mih vawsaw keiccuze mih lung athang;</para>
  <para style="q1">
    <verse number="27" style="v" />Aruipaw hawte tangkitangkae lante</para>
  <para style="q2">cceih hae zah, a khuliakuh hae,</para>
  <para style="q1">mih nythyanaw balyn tuh phe thang.</para>
  <para style="q1">
    <verse number="28" style="v" />Tetuh mih vawsawnaw kyate</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kalan sia hae zah,</para>
  <para style="q1">aning nynh mih riathaenaw kyate</para>
  <para style="q2">poh a thuaa hae;</para>
  <para style="q1">
    <verse number="29" style="v" />khise kha daesah zah,</para>
  <para style="q2">rili tuileih tuh zya adae.</para>
  <para style="q1">
    <verse number="30" style="v" />Tuhcite zya adae keiccuze</para>
  <para style="q2">mih lungtua zah,</para>
  <para style="q1">a ccia rynaw hae sanphalung</para>
  <para style="q2">thadynnaw hmin kalan a thuakhae hae.</para>
  <para style="q1">
    <verse number="31" style="v" />Atynpaw a sungsahnaw te</para>
  <para style="q2">ccungccaw hae kya</para>
  <para style="q1">a raepaw ngaeangnaw hae keiccuze</para>
  <para style="q2">minmin nynh <char style="nd">Bawipaw </char> kalan</para>
  <para style="q1">lungtuabya ho hae sah.</para>
  <para style="q1">
    <verse number="32" style="v" />Ccungccaw zapi pumkunaw kyakhe</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha hangthung hae sah lah,</para>
  <para style="q1">piccan hae tungkunaw kyakhe</para>
  <para style="q2">amaw kha thehoysah hae sah.</para>
  <para style="q1">
    <verse number="33" style="v" />Vawkhu hae kha laesia ram lang tangsah zah,</para>
  <para style="q2">tuidy aphyhnaw kha mah</para>
  <para style="q1">ram roupaw lang a tangsah,</para>
  <para style="q1">
    <verse number="34" style="v" />Ram hoypaw kya a um hae paw</para>
  <para style="q2">mih hoyleinaw keiccuze</para>
  <para style="q1">tuh-e ram tuh loi-epaw</para>
  <para style="q2">laethya ram lang a tangsah.</para>
  <para style="q1">
    <verse number="35" style="v" />Laesia ram kha tuili lang tangsah zah,</para>
  <para style="q2">ram roupaw kha</para>
  <para style="q1">tuidy aphyhnaw lang a tangsah.</para>
  <para style="q1">
    <verse number="36" style="v" />Te tuin kyakhe mih vuelawpaw kha</para>
  <para style="q2">umsah hae zah, minmin nynh</para>
  <para style="q2">um nawlan khuapi a raeku hae;</para>
  <para style="q1">
    <verse number="37" style="v" />Loo kya ccacii tuu hae zah,</para>
  <para style="q2">misu khokhu khe misu ku kha a lin hae,</para>
  <para style="q1">looh patae a voisah hae.</para>
  <para style="q1">
    <verse number="38" style="v" />A hythuanaw liate minmin tuh</para>
  <para style="q2">patae pungzae hae zah,</para>
  <para style="q1">mih sahiin kha mah zyasah bung khyh.</para>
  <para style="q1">
    <verse number="39" style="v" />Minmin tuh tuaasahkunaw,</para>
  <para style="q2">vawsawnaw te ngaethyanaw keiccuze</para>
  <para style="q1">zyabung hae zah he a nyaabung hae te,</para>
  <para style="q1">
    <verse number="40" style="v" />aning nynh uktu hae kha</para>
  <para style="q2">maethyabong hae zah,</para>
  <para style="q1">laanpi um leinaw ramkaw khe</para>
  <para style="q2">a khiavuisaku hae;</para>
  <para style="q1">
    <verse number="41" style="v" />thuasalama ryachi hae kha</para>
  <para style="q2">riathaenaw kyate luesah hae zah,</para>
  <para style="q1">mih innbyn hae kha tuuphu hawte</para>
  <para style="q2">a pungzaesah hae.</para>
  <para style="q1">
    <verse number="42" style="v" />Miding hae nynh tuh-e tuh</para>
  <para style="q2">muih hae zah, mih lungtua,</para>
  <para style="q1">hoyleinaw balyn nynh</para>
  <para style="q2">a khalang kha a huku.</para>
  <para style="q1">
    <verse number="43" style="v" />A haw hae paw nynh</para>
  <para style="q2">e uccaw hae hynh peki hae sah lah,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> sungsahnaw</para>
  <para style="q2">atynpaw kha tua hae sah.</para>
  <chapter number="108" style="c" />
  <para style="s1">Taenaw hanlan Sawsangnaw</para>
  <para style="r">(<ref loc="PSA 57:7-11">Sam 57.7-11</ref>, <ref loc="PSA 60:5-12">60.5-12</ref>)</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Ka thinlung tuh atyn, pou Pachia,</para>
  <para style="q2">ka thinlung tuh atyn,</para>
  <para style="q1">hlaw ka sah cih zah kae thehoysah cih.</para>
  <para style="q2">Ka muisaw, thoku tua!</para>
  <para style="q1">
    <verse number="2" style="v" />Pou tintang te phyly, tho oh!</para>
  <para style="q2">Kae mah awkhua takaw te ka tho cih.</para>
  <para style="q1">
    <verse number="3" style="v" />Pou <char style="nd">Bawipaw </char>, ccungccaw hae laku</para>
  <para style="q2">na kalan lungtuabya ka ho cih zah,</para>
  <para style="q1">minphuin hae laku namaw kalan</para>
  <para style="q2">thehoysahnaw hlaw ka sah cih.</para>
  <para style="q1">
    <verse number="4" style="v" />Pawccecize na sungsahnaw atynpaw tuh</para>
  <para style="q2">vaawlui laeze hanghua zah,</para>
  <para style="q1">na lungzinaw nynh maeking phe aphya.</para>
  <para style="q1">
    <verse number="5" style="v" />Pou Pachia, vaawlui luki lang cia</para>
  <para style="q2">hangthung na thua sah lah,</para>
  <para style="q1">na phu-enaw nynh laephipi pong bong sah.</para>
  <para style="q1">
    <verse number="6" style="v" />Na sungsah hae paw kha</para>
  <para style="q2">luesah athua ccaw hae,</para>
  <para style="q1">na ranglang kuih te</para>
  <para style="q2">taenaw yn pya lah, yn leihtua.</para>
  <para style="q1">
    <verse number="7" style="v" />Pachia nynh a beikinnthyaa kya</para>
  <para style="q2">byakinpakuh hae zah,</para>
  <para style="q1">“Shekhem kha lungtuate thoh ka phia cih,</para>
  <para style="q2">te Sukkoth Bialae kha ka nee cih hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Gilead tuh ka kya-e nynh thua,</para>
  <para style="q2">Manasseh mah ka kya-e nynh thua;</para>
  <para style="q1">Efraim tuh ka sivawlukhung thua zah,</para>
  <para style="q2">Judah tuh ka bawi hoitang nynh thua.</para>
  <para style="q1">
    <verse number="9" style="v" />Moab tuh tui ka singkunawpaw</para>
  <para style="q2">ka tuikua nynh thua;</para>
  <para style="q1">Edom tuh ka ccukoh ka synaw nynh thua;</para>
  <para style="q2">Filistin kha ka tae zah ka sia,” a ci.</para>
  <para style="q1">
    <verse number="10" style="v" />Hum nynh mou kae kha</para>
  <para style="q2">koihkhawpaw khuapi lungkhu lang</para>
  <para style="q1">yn teekhae cih?</para>
  <para style="q2">Hum nynh mou kae kha</para>
  <para style="q1">Edom lang yn cciakhae cih?</para>
  <para style="q1">
    <verse number="11" style="v" />Pou Pachia, kaening kha</para>
  <para style="q2">phe nae vua vae khaw?</para>
  <para style="q1">Pou Pachia, kae rhawkaw hae ryte</para>
  <para style="q2">na cceihkheih oh khaw?</para>
  <para style="q1">
    <verse number="12" style="v" />Kae rhaw hae kha</para>
  <para style="q2">rawsete kaening hynh</para>
  <para style="q2">bawmnaw beih oun pya,</para>
  <para style="q1">pawccecize ccungccaw bawmnaw tuh</para>
  <para style="q2">ccungkia khyh.</para>
  <para style="q1">
    <verse number="13" style="v" />Pachia liate rawthungte kae cyih cih;</para>
  <para style="q2">kae rhaw hae kha a syde cih paw tuh</para>
  <para style="q1">amaw nynh thua.</para>
  <chapter number="109" style="c" />
  <para style="s1">Liarunaw hanlan Sawsangnaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />The ka hoysahpaw Pachia,</para>
  <para style="q2">daetedae lan um nan.</para>
  <para style="q1">
    <verse number="2" style="v" />Pawccecize ccungccaw hoylei hae te</para>
  <para style="q2">mihyn hae nynh kae kha rawsete</para>
  <para style="q1">ahynthyapaw lae te ka than yn ho hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Huanaw bya te kae kha</para>
  <para style="q2">yn koihlu hae zah,</para>
  <para style="q1">akonglang um leite yn dou hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Minmin hanlan saw ka sangpya lya hae heize</para>
  <para style="q2">ka sungsahnaw kha</para>
  <para style="q1">seibenaw te yn liaru hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Tuhcite hoynaw kha hoyleinaw khate</para>
  <para style="q2">yn liaru hae zah, ka sungsahnaw kha</para>
  <para style="q1">huanaw khate yn liaru hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Khah-e paw kha rawsete</para>
  <para style="q2">ccungccaw hoyleipaw kha khang lah,</para>
  <para style="q1">tuh-e seibetupaw tuh</para>
  <para style="q2">a ranglang khe thadyn sah.</para>
  <para style="q1">
    <verse number="7" style="v" />Byapianaw he a ing te,</para>
  <para style="q2">phe shung sah;</para>
  <para style="q1">a sawsangnaw kha seinaw lante</para>
  <para style="q2">riapya thua sah.</para>
  <para style="q1">
    <verse number="8" style="v" />A hiinshe dyn sah lah, a rya kha</para>
  <para style="q2">mingccangpaw nynh ccou sah.<note caller="-" style="x"><char style="xo" closed="false">109.8: </char><char style="xt" closed="false"><ref loc="ACT 1:20">Loc 1.20</ref></char></note></para>
  <para style="q1">
    <verse number="9" style="v" />A ccaaw hae tuh ngawraw lang</para>
  <para style="q2">tang hae sah lah,</para>
  <para style="q1">a zu tuh nomae lang tang sah.</para>
  <para style="q1">
    <verse number="10" style="v" />A ccaaw hae tuh khiavuikuh hae sah lah,</para>
  <para style="q2">aepaw a ngiakuh hae paw lang tang hae sah;</para>
  <para style="q1">arohpaw mih umnaw kyate</para>
  <para style="q2">ccaring dee thua hae sah.</para>
  <para style="q1">
    <verse number="11" style="v" />A hoipaw balyn kha</para>
  <para style="q2">laebah a umsahtupaw nynh kyngpah sah;</para>
  <para style="q1">a ryalaw mee kha mikhia hae nynh</para>
  <para style="q2">luade hae sah.</para>
  <para style="q1">
    <verse number="12" style="v" />Lu kheit nynh sanmah a tungvaw</para>
  <para style="q2">ngaethyaumsahnaw hoi nan sah,</para>
  <para style="q1">a ccaaw hae ngawraw hae tungvaw</para>
  <para style="q2">thawccinaw a hoipaw</para>
  <para style="q1">lu kheit sanmah um nan sah.</para>
  <para style="q1">
    <verse number="13" style="v" />A ciihan phe mih sah lah,</para>
  <para style="q2">a min tuh she ningnaw kya</para>
  <para style="q2">zo ccavae sah.</para>
  <para style="q1">
    <verse number="14" style="v" />
    <char style="nd">Bawipaw </char> nynh a minpaaw hae</para>
  <para style="q2">hoyleinaw kha liathui sah lah,</para>
  <para style="q1">a nung seinaw kha ngaethya nan sah.</para>
  <para style="q1">
    <verse number="15" style="v" />Tuh-e seinaw hae tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> malang</para>
  <para style="q2">um zungzae sah lah,</para>
  <para style="q1">laephi kyate minmin liathuinawpaw</para>
  <para style="q2">syntawnaw kha zo sah.</para>
  <para style="q1">
    <verse number="16" style="v" />Pawccecize aning nynh thawccinaw</para>
  <para style="q2">langsaku lanpaw kha tua vae khyh,</para>
  <para style="q1">ryachi hae, ahobou hae paw te</para>
  <para style="q2">thinlung a koi hae paw kha</para>
  <para style="q1">phe a chih lan hae cia vawsaw a pya hae.</para>
  <para style="q1">
    <verse number="17" style="v" />Aning tuh thyalawnaw a rypaw thua zah,</para>
  <para style="q2">a tungvaw thyalawnaw ccah sah;</para>
  <para style="q1">hythuanaw a ry leipaw thua zah,</para>
  <para style="q2">hythuanaw tuh amaw kyate sawkuh sah.</para>
  <para style="q1">
    <verse number="18" style="v" />Thyalawnaw kha a angkile hawte a kiku,</para>
  <para style="q2">thyalawnaw tuh a pyn lungkhu lang</para>
  <para style="q1">tui hawte tee sah lah,</para>
  <para style="q2">a ru lungkhu lang chitui hawte tee sah.</para>
  <para style="q1">
    <verse number="19" style="v" />Thyalawnaw tuh a lawkupaw</para>
  <para style="q2">boeining hawte thua sah lah,</para>
  <para style="q1">nin takyh a cciakupaw taeccia hawte thua sah.</para>
  <para style="q1">
    <verse number="20" style="v" />Tuhcihawpaw tuh kae yn rawse hae paw te</para>
  <para style="q2">ka thethya yn ho hae paw nynh</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kyate a mue hae paw</para>
  <para style="q2">mih cyisahnaw mee thua vae sah.</para>
  <para style="q1">
    <verse number="21" style="v" />Pou <char style="nd">Bawipaw </char> ka Bawipaw,</para>
  <para style="q2">na min liate kamaw ccelang ryalawtua;</para>
  <para style="q1">atynpaw na sungsahnaw tuh</para>
  <para style="q2">ahoy keiccuze kae hynh yn luesah tua.</para>
  <para style="q1">
    <verse number="22" style="v" />Pawccecize kae tuh ka ryachi zah</para>
  <para style="q2">a hoboupaw nynh ka thua,</para>
  <para style="q1">ka lungkhu kya ka thinlung myarya ccih.</para>
  <para style="q1">
    <verse number="23" style="v" />Zete ccyh e mynlyh hawte vyavya ka zo;</para>
  <para style="q2">kae tuh tungkhipaw hawte ccaring ka peih.</para>
  <para style="q1">
    <verse number="24" style="v" />Looh ae leite ka um keiccuze</para>
  <para style="q2">ka ccukharu tuh a thawzya zah,</para>
  <para style="q1">ka pyn tuh ka ngethah.</para>
  <para style="q1">
    <verse number="25" style="v" />Kae tuh ccungccaw hae nynh</para>
  <para style="q2">yn theihrya hae paw ka thua zah,</para>
  <para style="q1">he yn muih vae hae ze,</para>
  <para style="q2">mih lu yn henua hae.<note caller="-" style="x"><char style="xo" closed="false">109.25: </char><char style="xt" closed="false"><ref loc="MAT 27:39">Mat 27.39</ref>; <ref loc="MRK 15:29">Mar 15.29</ref></char></note></para>
  <para style="q1">
    <verse number="26" style="v" />Pou <char style="nd">Bawipaw </char> ka Pachia,</para>
  <para style="q2">yn bawmtua!</para>
  <para style="q1">atynpaw na sungsahnaw liate</para>
  <para style="q2">yn khumtua.</para>
  <para style="q1">
    <verse number="27" style="v" />Pou <char style="nd">Bawipaw </char>, e tuh na cyipaw,</para>
  <para style="q2">na kuih te na raepaw nynh thua cipaw</para>
  <para style="q1">minmin nynh nyh hae sah;</para>
  <para style="q1">
    <verse number="28" style="v" />Minmin nynh thya a law hae zemah,</para>
  <para style="q2">nang nynh tuh hythua na pya cih.</para>
  <para style="q1">Kae yn rawse hae paw tuh</para>
  <para style="q2">maethyabong thua hae sah;</para>
  <para style="q1">na ryalahtupaw tuh a lungtua sah.</para>
  <para style="q1">
    <verse number="29" style="v" />Sei yn be hae paw tuh</para>
  <para style="q2">thethyanaw khate bong thua hae sah;</para>
  <para style="q1">boeining te bongku hawte</para>
  <para style="q2">mih maethyanaw khate</para>
  <para style="q2">bong thua hae sah.</para>
  <para style="q1">
    <verse number="30" style="v" />Ka khalang te <char style="nd">Bawipaw </char> kha</para>
  <para style="q2">thawte ka thehoysah cih;</para>
  <para style="q1">ccungccaw patae laku khe</para>
  <para style="q2">amaw kha ka thehoysah cih.</para>
  <para style="q1">
    <verse number="31" style="v" />Pawccecize ryachi hae kha chia lan</para>
  <para style="q2">sei a be hae paw kyate khum khylan,</para>
  <para style="q1">aning tuh ryachi hae ranglang khe</para>
  <para style="q2">phang a thadyn.</para>
  <chapter number="110" style="c" />
  <para style="s1">
    <char style="nd">Bawipaw </char> te A Popaw Siapharan</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> nynh ka Bawipaw kha,</para>
  <para style="q2">“Na rhaw hae kha na ccusy lang</para>
  <para style="q1">kae raepya makhia tuh,</para>
  <para style="q2">ka ranglang khe haung,” a cipya.<note caller="-" style="x"><char style="xo" closed="false">110.1: </char><char style="xt" closed="false"><ref loc="MAT 22:44">Mat 22.44</ref>; <ref loc="MRK 12:36">Mar 12.36</ref>; <ref loc="LUK 20:42-43">Luk 20.42-43</ref>; <ref loc="ACT 2:34-35">Loc 2.34-35</ref>; <ref loc="1CO 15:25">1Ko 15.25</ref>; <ref loc="EPH 1:20-22">Efe 1.20-22</ref>; <ref loc="COL 3:1">Kol 3.1</ref>; <ref loc="HEB 1:13">Heb 1.13</ref>, <ref loc="HEB 8:1">8.1</ref>, <ref loc="HEB 10:12-13">10.12-13</ref></char></note></para>
  <para style="q1">
    <verse number="2" style="v" />
    <char style="nd">Bawipaw </char> nynh na lesaenaw hoitang tuh</para>
  <para style="q2">Zion kyate a saw.</para>
  <para style="q2">Na rhaw hae ngaelung kyakhe uktua.</para>
  <para style="q1">
    <verse number="3" style="v" />Athyaapaw mua hae vawlan khe</para>
  <para style="q2">na ccungccaw hae kha na cciakhae nin hae khe,</para>
  <para style="q1">minmin nynh mimaw lungthote</para>
  <para style="q2">a pyakuh cih hae.</para>
  <para style="q1">Na mino hae tuh awkhua e dangtui hawte,</para>
  <para style="q2">na kalan oun thua cih hae.</para>
  <para style="q1">
    <verse number="4" style="v" />
    <char style="nd">Bawipaw </char> nynh bya phe kinkuh vae zah,</para>
  <para style="q2">a tuanaw tuh paleihkuh lan khyh:</para>
  <para style="q1">“Nang tuh Melkhizedek thuanaw thyhte</para>
  <para style="q2">zungzae ranpibawi nynh na thua,” a ci.<note caller="-" style="x"><char style="xo" closed="false">110.4: </char><char style="xt" closed="false"><ref loc="HEB 5:6">Heb 5.6</ref>, <ref loc="HEB 6:20">6.20</ref>, <ref loc="HEB 7:17">7.17</ref>, <ref loc="HEB 7:21">21</ref></char></note></para>
  <para style="q1">
    <verse number="5" style="v" />Bawipaw tuh na ranglang khe a um;</para>
  <para style="q2">a thinria ccyh khe siapharan hae kha</para>
  <para style="q1">a roh cih hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Aning nynh minphuin hae kya</para>
  <para style="q2">byapianaw a rae cih zah,</para>
  <para style="q1">michi rhua te phe a biasah cih;</para>
  <para style="q2">laephi pynpi e lupi hae kha</para>
  <para style="q2">a roh cih hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Aning nynh laanpi pe aluapaw</para>
  <para style="q2">vawkhu e tui kha a neih cih;</para>
  <para style="q1">tukeiccuze aning nynh</para>
  <para style="q2">a lu kha a hangthung cih.</para>
  <chapter number="111" style="c" />
  <para style="s1">Pachia Ryalaw Thehoysahnaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha miding hae</para>
  <para style="q2">tungkunaw kya thuasah,</para>
  <para style="q1">zapi pumkunaw kya thuasah</para>
  <para style="q2">ka thinlung balyn te the ka hoysah cih.</para>
  <para style="q1">
    <verse number="2" style="v" />
    <char style="nd">Bawipaw </char> ryalawnaw tuh</para>
  <para style="q2">myarya alesae, tuh-e ryalaw kya</para>
  <para style="q1">a lungrythuapaw balyn nynh</para>
  <para style="q2">ccangku a ry hae.</para>
  <para style="q1">
    <verse number="3" style="v" />A ryalaw tuh sawtuanaw,</para>
  <para style="q2">lesaenaw te phe beih zah,</para>
  <para style="q1">a dingnaw tuh zungzae atyn.</para>
  <para style="q1">
    <verse number="4" style="v" />Ngaeangthua lan umpaw</para>
  <para style="q2">a ryalaw hae kha yn ningsah khyh;</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> tuh thawccih thyapaw te</para>
  <para style="q2">ngaethyaumsah thyapaw nynh thua.</para>
  <para style="q1">
    <verse number="5" style="v" />Amaw a rih hae paw kha looh a pya hae;</para>
  <para style="q2">a byakinnaw kha kharouh ning khyh.</para>
  <para style="q1">
    <verse number="6" style="v" />Minphuin ccangpaw hae rho kha</para>
  <para style="q2">a ccungccaw hae kalan pyate,</para>
  <para style="q1">a ryalawnaw huhan kha</para>
  <para style="q2">a ccungccaw hae kya a langsaku vae.</para>
  <para style="q1">
    <verse number="7" style="v" />A kuih te rya a lawpaw balyn tuh</para>
  <para style="q2">zyn lan um zah ading;</para>
  <para style="q1">a kawbya balyn tuh doliaku lan a um.</para>
  <para style="q1">
    <verse number="8" style="v" />Tuh-e hae tuh lungzinaw te</para>
  <para style="q2">dingnaw khate</para>
  <para style="q1">pyapaw athua keiccu hae ze,</para>
  <para style="q2">zungzae te zungzae cia atyn hae.</para>
  <para style="q1">
    <verse number="9" style="v" />A ccungccaw hae hanlan</para>
  <para style="q2">shawkhawnaw a raepya hae;</para>
  <para style="q1">a byakinnaw kha zungzae hanlan</para>
  <para style="q2">kaw a pya vae. A min tuh thyaa zah</para>
  <para style="q1">rawri sawtua lan a um!</para>
  <para style="q1">
    <verse number="10" style="v" />
    <char style="nd">Bawipaw </char> rawrinaw tuh</para>
  <para style="q2">hawnaw athotakawnaw nynh thua;</para>
  <para style="q1">tuhcite kawbya a zuipaw balyn tuh</para>
  <para style="q2">ahoypaw nythyanaw a hoi hae.</para>
  <para style="q1">Amaw kha thehoysahnaw tuh</para>
  <para style="q2">zungzae atyn.<note caller="-" style="x"><char style="xo" closed="false">111.10: </char><char style="xt" closed="false"><ref loc="JOB 28:28">Job 28.28</ref>; <ref loc="PRO 1:7">Ptb 1.7</ref>, <ref loc="PRO 9:10">9.10</ref></char></note></para>
  <chapter number="112" style="c" />
  <para style="s1">Miding hae Hythuanaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> raw a rih hae paw te</para>
  <para style="q1">a kawbya kya myaryamaw</para>
  <para style="q2">mih lungrythua hae paw tuh</para>
  <para style="q2">lungtua hae paw nynh thua.</para>
  <para style="q1">
    <verse number="2" style="v" />Mih ciihan hae tuh ram lungkhu kya</para>
  <para style="q2">mih thawsaepaw athua cih hae;</para>
  <para style="q1">miding hae ciihan tuh</para>
  <para style="q2">hythuapya athua cih hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Mih inn kya sisua te</para>
  <para style="q2">hoirumnaw um zah,</para>
  <para style="q2">mih dingnaw tuh zungzae atyn.</para>
  <para style="q1">
    <verse number="4" style="v" />Miding hae hanlan mohnaw kya</para>
  <para style="q2">awnaw hawte a langkuh hae;</para>
  <para style="q1">minmin tuh thawccih thyapaw,</para>
  <para style="q2">ngaethyaumsah thyapaw te</para>
  <para style="q2">adingpaw nynh thua hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Ming hae kha hysahte</para>
  <para style="q2">koiisakuh hae zah,</para>
  <para style="q1">hmerarih lante rya a lahpaw tuh</para>
  <para style="q2">hoynaw a mue cih.</para>
  <para style="q1">
    <verse number="6" style="v" />Miding hae tuh tyty atyn cih hae;</para>
  <para style="q2">minmin kha zungzae</para>
  <para style="q2">liathui athua cih hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Thethyapaw thae kha rih khyh hae;</para>
  <para style="q2">mih thinlung tuh tyn zah,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kya a khyn hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Mih thinlung tuh tyn zah</para>
  <para style="q2">rih lan khyh hae;</para>
  <para style="q1">athangnaw kya tuh mih rhaw hae tungvaw</para>
  <para style="q2">taenaw a mue cih hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Minmin nynh alakawte a nee vae hae,</para>
  <para style="q2">ryachi hae kha a pya vae hae;</para>
  <para style="q1">mih dingnaw tuh zungzae atyn,</para>
  <para style="q2">mih huhan athuapaw mih ki kha</para>
  <para style="q2">sawtuanaw te hangthung athua.<note caller="-" style="x"><char style="xo" closed="false">112.9: </char><char style="xt" closed="false"><ref loc="2CO 9:9">2Ko 9.9</ref></char></note></para>
  <para style="q1">
    <verse number="10" style="v" />Ccungccaw hoylei hae paw nynh</para>
  <para style="q2">tuh-e tuh muih hae zah mih thinria;</para>
  <para style="q1">mih hawzy hae zah,</para>
  <para style="q2">mih ngethyakhaekuh;</para>
  <para style="q1">ccungccaw hoylei hae paw rynaw tuh</para>
  <para style="q2">accakaepaw lang nynh a tang.</para>
  <chapter number="113" style="c" />
  <para style="s1">Ryachi Bawmtu Pachia</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <para style="q1">Pou <char style="nd">Bawipaw </char> ryalahtu hae,</para>
  <para style="q2">thehoysah oh,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> min kha thehoysah oh.</para>
  <para style="q1">
    <verse number="2" style="v" />
    <char style="nd">Bawipaw </char> min tuh</para>
  <para style="q2">atu te malang zungzae cia</para>
  <para style="q1">thehoyte um sah.</para>
  <para style="q1">
    <verse number="3" style="v" />Khuanin a thua ccyh te a ccaw ccyh cia</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> min tuh</para>
  <para style="q2">thehoysah lanpaw nynh thua.</para>
  <para style="q1">
    <verse number="4" style="v" />
    <char style="nd">Bawipaw </char> tuh minphuin balyn kha</para>
  <para style="q2">uk zah, a phu-enaw tuh</para>
  <para style="q1">vaawlui laeze ahanghua.</para>
  <para style="q1">
    <verse number="5-6" style="v" />Ahangnaw kya haungte</para>
  <para style="q2">vaaw te lae kha a dobungpaw</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> ah Pachia te</para>
  <para style="q2">hummou a lokuh?</para>
  <para style="q1">
    <verse number="7" style="v" />Aning nynh ryachi hae kha</para>
  <para style="q2">laenoi kyate hangthung hae zah,</para>
  <para style="q1">ahobou hae paw kha</para>
  <para style="q2">buhhaw apumkuhpaw kyate</para>
  <para style="q1">a hangthung hae,</para>
  <para style="q1">
    <verse number="8" style="v" />te siapharan ccaaw hae te</para>
  <para style="q2">a ccungccaw hae kya-e uktu bawi hae ryte</para>
  <para style="q1">a haungsah kheih hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Ccaawsaah kho leipaw nopi kha</para>
  <para style="q2">inn innkheit pya zah, ccaaw a saahpaw,</para>
  <para style="q1">a lungtuapaw nung lang a rae.</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <chapter number="114" style="c" />
  <para style="s1">Kawtaw Poi Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Israel hae, Jakob ciihan hae tuh</para>
  <para style="q2">ccangpaw bya a honaw hae</para>
  <para style="q1">Izip ram kyate he a pou hae te,<note caller="-" style="x"><char style="xo" closed="false">114.1: </char><char style="xt" closed="false"><ref loc="EXO 12:51">Exo 12.51</ref></char></note></para>
  <para style="q1">
    <verse number="2" style="v" />Judah tuh Pachia beikinnthyaa lang tang zah,</para>
  <para style="q2">Israel tuh Pachia nynh</para>
  <para style="q1">a ukpaw lang a tang.</para>
  <para style="q1">
    <verse number="3" style="v" />Rili nynh muih zah a ccuetaw;</para>
  <para style="q2">Jordan vaw mah nulang a ki.<note caller="-" style="x"><char style="xo" closed="false">114.3: </char><char style="xt" closed="false"><ref loc="EXO 14:21">Exo 14.21</ref>; <ref loc="JOS 3:16">Jos 3.16</ref></char></note></para>
  <para style="q1">
    <verse number="4" style="v" />Muapi hae tuh tuutepaw hawte</para>
  <para style="q2">thohkuh hae zah, mua taraw hae tuh</para>
  <para style="q1">tuutaw hawte a thohkuh hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Pou rili, pawccemou na ccue?</para>
  <para style="q2">Pou Jordan, pawccemou nulang na ki?</para>
  <para style="q1">
    <verse number="6" style="v" />Pou muapi hae, pawccemou tuutepaw hawte</para>
  <para style="q2">na thohku oh?</para>
  <para style="q1">Pou mua taraw hae,</para>
  <para style="q2">pawccemou tuutaw hawte na thohku oh?</para>
  <para style="q1">
    <verse number="7" style="v" />Pou laephi, <char style="nd">Bawipaw </char> malang,</para>
  <para style="q2">Jakob Pachia malang khe thyngku tua,</para>
  <para style="q1">
    <verse number="8" style="v" />aning nynh lungpi kha</para>
  <para style="q2">tuili lang tangsah zah,</para>
  <para style="q1">rihlung kha tuidy a pounaw lang</para>
  <para style="q2">a tangsah.<note caller="-" style="x"><char style="xo" closed="false">114.8: </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">Exo 17.1-7</ref>; <ref loc="NUM 20:2-13">Nam 20.2-13</ref></char></note></para>
  <chapter number="115" style="c" />
  <para style="s1">Pachia Lesaenaw</para>
  <para style="q1">
    <verse number="1" style="v" />Kaening hanlan thua leite, pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">kaening hanlan thua leite,</para>
  <para style="q1">atynpaw na sungsahnaw te</para>
  <para style="q2">na lungzinaw keiccuze</para>
  <para style="q1">na min phu-e pya nawlan thua vae sah.</para>
  <para style="q1">
    <verse number="2" style="v" />“Mih Pachia tuh teimou a um?” cite</para>
  <para style="q2">minphuin ccangpaw hae nynh</para>
  <para style="q1">pawccemou a ho cih hae?</para>
  <para style="q1">
    <verse number="3" style="v" />Ah Pachia tuh vaawram kya a um;</para>
  <para style="q2">a lungry thyhte a cyi.</para>
  <para style="q1">
    <verse number="4" style="v" />Mih zohtuh hae tuh sui te</para>
  <para style="q2">ngun thua zah, ccungccaw kuih te</para>
  <para style="q2">raepaw nynh athua hae.<note caller="-" style="x"><char style="xo" closed="false">115.4-8: </char><char style="xt" closed="false"><ref loc="PSA 135:15-18">Sam 135.15-18</ref>; <ref loc="REV 9:20">Bya 9.20</ref></char></note></para>
  <para style="q1">
    <verse number="5" style="v" />Tuh-e zohtuh hae tuh</para>
  <para style="q2">mung hoi hae salamah,</para>
  <para style="q1">byaho kho khyh hae;</para>
  <para style="q2">mit hoi hae salamah ngawmuih khyh hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Nakaring hoi hae salamah</para>
  <para style="q2">nawthae khyh hae;</para>
  <para style="q1">naduh hoi hae salamah</para>
  <para style="q2">amyn thae khyh hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Kuih hoi hae salamah haethya khyh hae;</para>
  <para style="q2">ccu hoi hae salamah</para>
  <para style="q1">cceihthya khyh hae;</para>
  <para style="q2">mih lohtharue te roi pousathya khyh hae.</para>
  <para style="q1">
    <verse number="8" style="v" />E zohtuh a raetu hae hynh</para>
  <para style="q2">zohtuh hae mawte nynh a loku hae;</para>
  <para style="q1">e zohtuh hae a doliakuhpaw balyn tuh</para>
  <para style="q2">tuhcite nynh athua hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Pou Israel, <char style="nd">Bawipaw </char> kha doliakuh!</para>
  <para style="q2">Aning tuh minmin bawmtu te</para>
  <para style="q1">thungkhawtu nynh thua.</para>
  <para style="q1">
    <verse number="10" style="v" />Pou Aaron ciihan hae,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha doliakuh oh!</para>
  <para style="q1">Aning tuh minmin bawmtu te</para>
  <para style="q2">thungkhawtu nynh thua.</para>
  <para style="q1">
    <verse number="11" style="v" />
    <char style="nd">Bawipaw </char> rawrih hae paw nanning,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha doliakuh oh!</para>
  <para style="q1">Aning tuh minmin bawmtu te</para>
  <para style="q2">thungkhawtu nynh thua.</para>
  <para style="q1">
    <verse number="12" style="v" />
    <char style="nd">Bawipaw </char> nynh aening kha</para>
  <para style="q2">oun ning khyh zah, hythua oun pya cih;</para>
  <para style="q1">Israel ciihan kha hythua a pya cih;</para>
  <para style="q2">Aaron ciihan kha hythua a pya cih;</para>
  <para style="q1">
    <verse number="13" style="v" />
    <char style="nd">Bawipaw </char> rawrih hae paw adih ale kha</para>
  <para style="q2">hythua a pya cih hae.<note caller="-" style="x"><char style="xo" closed="false">115.13: </char><char style="xt" closed="false"><ref loc="REV 11:18">Bya 11.18</ref>, <ref loc="REV 19:5">19.5</ref></char></note></para>
  <para style="q1">
    <verse number="14" style="v" />
    <char style="nd">Bawipaw </char> nynh nanning te</para>
  <para style="q2">nae ccaaw hae kha</para>
  <para style="q1">pungzaenaw ae pya vae oh sah.</para>
  <para style="q1">
    <verse number="15" style="v" />Vaaw te lae a raetu <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">hythua ae pya vae oh sah.</para>
  <para style="q1">
    <verse number="16" style="v" />Vaawlui tuh <char style="nd">Bawipaw </char> vaawlui nynh thua,</para>
  <para style="q2">thuasalama laephi tuh</para>
  <para style="q1">ccungccaw hae kalan a pya vae.</para>
  <para style="q1">
    <verse number="17" style="v" />Michi hae, daenaw kalan</para>
  <para style="q2">a rungbung hae paw miakaw tuh</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha thehoysah khyh hae.</para>
  <para style="q1">
    <verse number="18" style="v" />Thuasalama aening nynh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha atu te zungzae cia</para>
  <para style="q2">the ah hoysah cih oh.</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <chapter number="116" style="c" />
  <para style="s1">A Dan vae paw nynh Lungtuanaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> kha ka sungsah,</para>
  <para style="q2">pawccecize ka roi te</para>
  <para style="q1">ka bohkunaw bya kha yn thaepya.</para>
  <para style="q1">
    <verse number="2" style="v" />A nakaring kha yn tuapyaku keiccuze</para>
  <para style="q2">ka hiin lungkhu balyn amaw kha ka ko cih.</para>
  <para style="q1">
    <verse number="3" style="v" />Chinaw kaang nynh phang yn koihlu;</para>
  <para style="q2">Sheol kya-e vawsawnaw nynh yn kyng zah,</para>
  <para style="q2">riathaenaw te thinphangnaw kha ka teing.</para>
  <para style="q1">
    <verse number="4" style="v" />Tetuh “Pou <char style="nd">Bawipaw </char>, saw ka sang,</para>
  <para style="q2">ka hiinnaw hynh beih yn khum!” cite</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> min kha ka ko.</para>
  <para style="q1">
    <verse number="5" style="v" />
    <char style="nd">Bawipaw </char> tuh thawccih thyapaw te</para>
  <para style="q2">a dingpaw nynh thua; ah Pachia tuh</para>
  <para style="q1">ngaethyaumsah thyapaw nynh thua.</para>
  <para style="q1">
    <verse number="6" style="v" />
    <char style="nd">Bawipaw </char> nynh bawmtu</para>
  <para style="q2">hoi lei hae paw kha a thungkhaw hae;</para>
  <para style="q1">he yn dothatheih vae hae ze,</para>
  <para style="q2">aning nynh yn khum.</para>
  <para style="q1">
    <verse number="7" style="v" />
    <char style="nd">Bawipaw </char> tuh ka tungvaw</para>
  <para style="q2">myarya ahoy keiccuze</para>
  <para style="q1">Pou ka muisaw, ngaengante umtua.</para>
  <para style="q1">
    <verse number="8" style="v" />
    <char style="nd">Bawipaw </char> nynh ka hiinnaw kha</para>
  <para style="q2">chinaw kyate thuasah,</para>
  <para style="q1">ka mit kha mitphi luanaw kyate thuasah,</para>
  <para style="q2">ka ccu kha thykunaw kyate thuasah</para>
  <para style="q1">yn luesah vae.</para>
  <para style="q1">
    <verse number="9" style="v" />A hiin hae paw ram kyakhe</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> malang cciate ka hiin.</para>
  <para style="q1">
    <verse number="10" style="v" />“Kae tuh riathaenaw myaryamaw</para>
  <para style="q2">ka teing,” ka ci lya heize,</para>
  <para style="q2">ka zynnaw tuh tynkaring.<note caller="-" style="x"><char style="xo" closed="false">116.10: </char><char style="xt" closed="false"><ref loc="2CO 4:13">2Ko 4.13</ref></char></note></para>
  <para style="q1">
    <verse number="11" style="v" />“Ccungccaw miakaw tuh</para>
  <para style="q2">mihyn hae nynh thua,” cite</para>
  <para style="q2">bungzoute ka ho.</para>
  <para style="q1">
    <verse number="12" style="v" />
    <char style="nd">Bawipaw </char> tuh ka tungvaw</para>
  <para style="q2">eih ahoy keiccuze</para>
  <para style="q1">aning kha pawmou ka pyaru cih?</para>
  <para style="q1">
    <verse number="13" style="v" />Khumnaw banang kha ka hang cih zah,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> min kha ka ko cih.</para>
  <para style="q1">
    <verse number="14" style="v" />Bya ka kinkupaw kha</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> ccungccaw hae balyn malang khe</para>
  <para style="q2">amaw kha ka pya cih.</para>
  <para style="q1">
    <verse number="15" style="v" />A mithyaa hae nynh a chi hae paw tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> muihnaw kya myarya aphute.</para>
  <para style="q1">
    <verse number="16" style="v" />Pou <char style="nd">Bawipaw </char>, kae tuh</para>
  <para style="q2">na ryalahtu nynh ka thua;</para>
  <para style="q1">kae tuh na ryalahtunung ccaaw,</para>
  <para style="q2">na ryalahtu nynh ka thua.</para>
  <para style="q2">Yn khiinaw hae paw kha nae supya vae.</para>
  <para style="q1">
    <verse number="17" style="v" />Namaw kalan lungtua silawnaw kha</para>
  <para style="q2">ka rae cih zah,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> min kha ka ko cih.</para>
  <para style="q1">
    <verse number="18" style="v" />Bya ka kinkupaw kha</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> ccungccaw hae balyn malang khe</para>
  <para style="q2">ka pya cih.</para>
  <para style="q1">
    <verse number="19" style="v" />Pou Jerusalem, na ngaelung a umpaw,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> inn voidu lungkhu khe ka pya cih.</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <chapter number="117" style="c" />
  <para style="s1">
    <char style="nd">Bawipaw </char> Thehoysahnaw</para>
  <para style="q1">
    <verse number="1" style="v" />Minphuin hae balyn, <char style="nd">Bawipaw </char> kha</para>
  <para style="q2">thehoysah oh!</para>
  <para style="q1">Ccungccaw hae balyn,</para>
  <para style="q2">amaw kha thehoysah oh!<note caller="-" style="x"><char style="xo" closed="false">117.1: </char><char style="xt" closed="false"><ref loc="ROM 15:11">Rom 15.11</ref></char></note></para>
  <para style="q1">
    <verse number="2" style="v" />Pawccecize aening tungvaw</para>
  <para style="q2">atynpaw a sungsahnaw tuh myarya ale,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> a lungzinaw tuh zungzae atyn.</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <chapter number="118" style="c" />
  <para style="s1">Taenaw Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> tuh hoy zah</para>
  <para style="q2">a sungsahnaw tuh zungzae atyn keiccuze</para>
  <para style="q1">amaw kalan lungtuabya ho oh!<note caller="-" style="x"><char style="xo" closed="false">118.1: </char><char style="xt" closed="false"><ref loc="1CH 16:34">1Sh 16.34</ref>; <ref loc="2CH 5:13">2Sh 5.13</ref>, <ref loc="2CH 7:3">7.3</ref>; <ref loc="EZR 3:11">Ezr 3.11</ref>; <ref loc="PSA 100:5">Sam 100.5</ref>, <ref loc="PSA 106:1">106.1</ref>, <ref loc="PSA 107:1">107.1</ref>, <ref loc="PSA 136:1">136.1</ref>; <ref loc="JER 33:11">Jer 33.11</ref></char></note></para>
  <para style="q1">
    <verse number="2" style="v" />Israel hae nynh, “A sungsahnaw tuh</para>
  <para style="q2">zungzae atyn,” cite ho hae sah.</para>
  <para style="q1">
    <verse number="3" style="v" />Aaron ciihan hae nynh,</para>
  <para style="q2">“A sungsahnaw tuh</para>
  <para style="q2">zungzae atyn,” cite ho hae sah.</para>
  <para style="q1">
    <verse number="4" style="v" />
    <char style="nd">Bawipaw </char> rawrih hae paw nynh,</para>
  <para style="q2">“A sungsahnaw tuh</para>
  <para style="q2">zungzae atyn,” cite ho hae sah.</para>
  <para style="q1">
    <verse number="5" style="v" />Ka riathaenaw kyate</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha ka ko;</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh yn leih zah,</para>
  <para style="q2">akonaw hmin kyakhe yn nung.</para>
  <para style="q1">
    <verse number="6" style="v" />
    <char style="nd">Bawipaw </char> nynh yn pankhae keiccuze</para>
  <para style="q2">ka rih khyh.</para>
  <para style="q2">Ccungccaw nynh ka tungvaw</para>
  <para style="q1">pawmou yn cyih kho cih?<note caller="-" style="x"><char style="xo" closed="false">118.6: </char><char style="xt" closed="false"><ref loc="HEB 13:6">Heb 13.6</ref></char></note></para>
  <para style="q1">
    <verse number="7" style="v" />
    <char style="nd">Bawipaw </char> nynh kae kha</para>
  <para style="q2">bawm khylan yn pankhae;</para>
  <para style="q1">Kae yn hua hae paw tuh</para>
  <para style="q2">a shung hae paw kha ka muih cih.</para>
  <para style="q1">
    <verse number="8" style="v" />Ccungccaw doliaku laeze</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> doliaku tuh ahoyhua.</para>
  <para style="q1">
    <verse number="9" style="v" />Laephi bawi doliaku laeze</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> doliaku tuh ahoyhua.</para>
  <para style="q1">
    <verse number="10" style="v" />Minphuin balyn nynh yn koihlu hae;</para>
  <para style="q2">thuasalama <char style="nd">Bawipaw </char> min te</para>
  <para style="q1">minmin kha ka ro hae!</para>
  <para style="q1">
    <verse number="11" style="v" />Minmin nynh yn koihlu hae,</para>
  <para style="q2">teitei lang balyn te pong yn koihlu hae;</para>
  <para style="q1">thuasalama <char style="nd">Bawipaw </char> min te</para>
  <para style="q2">minmin kha ka ro hae!</para>
  <para style="q1">
    <verse number="12" style="v" />Minmin nynh khoi hawte</para>
  <para style="q2">yn lungnuaku hae;</para>
  <para style="q1">hinpaw a upaw maee hawte</para>
  <para style="q2">minmin tuh a u hae.</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> min te minmin kha ka ro hae!</para>
  <para style="q1">
    <verse number="13" style="v" />Ka khuliaku ccaw cite thawte yn tu hae,</para>
  <para style="q2">thuasalama <char style="nd">Bawipaw </char> nynh yn bawm.</para>
  <para style="q1">
    <verse number="14" style="v" />
    <char style="nd">Bawipaw </char> tuh ka thawzung te</para>
  <para style="q2">ka thungnaw thua zah,</para>
  <para style="q1">yn khumtu lang a tang vae.<note caller="-" style="x"><char style="xo" closed="false">118.14: </char><char style="xt" closed="false"><ref loc="EXO 15:2">Exo 15.2</ref>; <ref loc="ISA 12:2">Isa 12.2</ref></char></note></para>
  <para style="q1">
    <verse number="15" style="v" />Miding hae bu kya taenaw</para>
  <para style="q2">lungtuanaw hlawsah hae paw roi accae:</para>
  <para style="q1">“<char style="nd">Bawipaw </char> a ranglang kuih nynh</para>
  <para style="q2">rawthungte rya a law;</para>
  <para style="q1">
    <verse number="16" style="v" />
    <char style="nd">Bawipaw </char> a ranglang kuih tuh</para>
  <para style="q2">hangthung athua;</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> a ranglang kuih nynh</para>
  <para style="q2">rawthungte rya a law,” a ci hae.</para>
  <para style="q1">
    <verse number="17" style="v" />Ka chih lan khyh, ka hiin cih zah,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> ryalawnaw kha ka siakhae cih.</para>
  <para style="q1">
    <verse number="18" style="v" />
    <char style="nd">Bawipaw </char> nynh myarya ccih lan</para>
  <para style="q2">de yn tah vae,</para>
  <para style="q1">thuasalama yn chisah khyh.</para>
  <para style="q1">
    <verse number="19" style="v" />Dingnaw koikua kha yn hungpah oh;</para>
  <para style="q2">tuin kyate ka tee cih zah,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kalan lungtuabya ka ho cih.</para>
  <para style="q1">
    <verse number="20" style="v" />E hynh <char style="nd">Bawipaw </char> koikua nynh thua;</para>
  <para style="q2">miding hae nynh tuin kya a tee cih hae.</para>
  <para style="q1">
    <verse number="21" style="v" />Nang nynh nae leih zah,</para>
  <para style="q2">nae khum vae keiccuze</para>
  <para style="q1">na tungvaw ka lungtua.</para>
  <para style="q1">
    <verse number="22" style="v" />Inn sak hae paw nynh</para>
  <para style="q2">a nuee hae paw lung tuh</para>
  <para style="q1">apaki lang e abyapi huapaw</para>
  <para style="q2">lung lang yn tang.<note caller="-" style="x"><char style="xo" closed="false">118.22: </char><char style="xt" closed="false"><ref loc="LUK 20:17">Luk 20.17</ref>; <ref loc="ACT 4:11">Loc 4.11</ref>; <ref loc="1PE 2:7">1Pe 2.7</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">118.22-23: </char><char style="xt" closed="false"><ref loc="MAT 21:42">Mat 21.42</ref>; <ref loc="MRK 12:10-11">Mar 12.10-11</ref></char></note></para>
  <para style="q1">
    <verse number="23" style="v" />E hynh <char style="nd">Bawipaw </char> ryalawnaw nynh thua;</para>
  <para style="q2">aening mit kya</para>
  <para style="q2">ngaeangthua lan umpaw nynh thua.</para>
  <para style="q1">
    <verse number="24" style="v" />E nin hynh <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">a raepaw nin nynh thua;</para>
  <para style="q1">e nin kyahin lungtua lungpawte um oh sih.</para>
  <para style="q1">
    <verse number="25" style="v" />Pou <char style="nd">Bawipaw </char>, kaening hynh</para>
  <para style="q2">beih oun khum cite kae ngiaku!</para>
  <para style="q1">Pou <char style="nd">Bawipaw </char>, kaening hynh</para>
  <para style="q2">kae laan kae sui</para>
  <para style="q1">beih uasah cite kae ngiaku!<note caller="-" style="x"><char style="xo" closed="false">118.25: </char><char style="xt" closed="false"><ref loc="MAT 21:9">Mat 21.9</ref>; <ref loc="MRK 11:9">Mar 11.9</ref>; <ref loc="JHN 12:13">Joh 12.13</ref></char></note></para>
  <para style="q1">
    <verse number="26" style="v" />
    <char style="nd">Bawipaw </char> min te yn thuapaw tuh</para>
  <para style="q2">hythuanaw mue vae sah.</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> inn kyate kaening nynh</para>
  <para style="q2">hythuanaw kae pya hae.<note caller="-" style="x"><char style="xo" closed="false">118.26: </char><char style="xt" closed="false"><ref loc="MAT 21:9">Mat 21.9</ref>, <ref loc="MAT 23:39">23.39</ref>; <ref loc="MRK 11:9">Mar 11.9</ref>; <ref loc="LUK 13:35">Luk 13.35</ref>, <ref loc="LUK 19:38">19.38</ref>; <ref loc="JHN 12:13">Joh 12.13</ref></char></note></para>
  <para style="q1">
    <verse number="27" style="v" />
    <char style="nd">Bawipaw </char> tuh Pachia thua zah,</para>
  <para style="q2">aning nynh awnaw kha oun pya vae.</para>
  <para style="q1">Nae kuih te thingnge kha</para>
  <para style="q2">ccyngkute poi kha tho oh lah,</para>
  <para style="q1">silawhang kha po koihlu oh.</para>
  <para style="q1">
    <verse number="28" style="v" />Nang tuh ka Pachia na thua zah,</para>
  <para style="q2">na kalan lungtuabya ka ho cih;</para>
  <para style="q1">ka Pachia na thua zah, kae thehoysah cih.</para>
  <para style="q1">
    <verse number="29" style="v" />
    <char style="nd">Bawipaw </char> lungtuabya ho oh,</para>
  <para style="q2">pawccecize aning tuh hoy zah</para>
  <para style="q1">a sungsahnaw tuh zungzae atyn.</para>
  <chapter number="119" style="c" />
  <para style="s1">Pachia Kawbya A Phu-enaw</para>
  <para style="q1">
    <verse number="1" style="v" />Mih hiinnaw kya ccaenaw um leipaw te</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kawbya a zui hae paw tuh</para>
  <para style="q1">lungtua hae paw nynh thua.</para>
  <para style="q1">
    <verse number="2" style="v" />A phunglang a zui hae paw,</para>
  <para style="q2">mih thinlung balyn te</para>
  <para style="q1">amaw a ccung hae paw te</para>
  <para style="q1">
    <verse number="3" style="v" />hoyleinaw rae leite,</para>
  <para style="q2">a laanpi a zui hae paw tuh</para>
  <para style="q1">lungtua hae paw nynh thua.</para>
  <para style="q1">
    <verse number="4" style="v" />Na kawbya hae kha zuakute zui lan</para>
  <para style="q2">kaw nae pya vae.</para>
  <para style="q1">
    <verse number="5" style="v" />Na phungbya zuinaw kyakhe</para>
  <para style="q2">ka laanpi tuh tyn vae sah!</para>
  <para style="q1">
    <verse number="6" style="v" />Tetuh na kawbya balyn kha</para>
  <para style="q2">hoyte dokute,</para>
  <para style="q2">maethyanaw ka mue lan khyh.</para>
  <para style="q1">
    <verse number="7" style="v" />Adingpaw na phungzae kha</para>
  <para style="q2">he ka nyh te, thinlung adingpaw te</para>
  <para style="q2">nang kha kae thehoysah cih.</para>
  <para style="q1">
    <verse number="8" style="v" />Na phungbya kha ka zui cih;</para>
  <para style="q2">kae kha kharouh beih yn vua nan.</para>
  <para style="q1">
    <verse number="9" style="v" />Mino hae nynh mih laanpi kha</para>
  <para style="q2">pawtemou a thyaasah kho cih hae?</para>
  <para style="q1">Na bya thyhte raeringkunaw liate</para>
  <para style="q2">a thyaasah cih hae.</para>
  <para style="q1">
    <verse number="10" style="v" />Ka thinlung balyn te</para>
  <para style="q2">nang kha kae ccung; na kawbya kyate</para>
  <para style="q1">ccanglang yn cciasah sei nan.</para>
  <para style="q1">
    <verse number="11" style="v" />Na tungvaw ka sei khyh nawlan,</para>
  <para style="q2">na bya kha ka thinlung kya ka ccykeku.</para>
  <para style="q1">
    <verse number="12" style="v" />Pou <char style="nd">Bawipaw </char>, nang kha</para>
  <para style="q2">kae thehoysah;</para>
  <para style="q2">na phungbya kha beih yn ccangpah.</para>
  <para style="q1">
    <verse number="13" style="v" />Nae hopyapaw na phungzae balyn kha</para>
  <para style="q2">ka siakhae cih.</para>
  <para style="q1">
    <verse number="14" style="v" />Hoirumnaw patae kya</para>
  <para style="q2">lungrythuakhaeku hawte,</para>
  <para style="q1">na phunglang kyakhe</para>
  <para style="q2">ka lungry a thuakhaekuh cih.</para>
  <para style="q1">
    <verse number="15" style="v" />Na kawbya kyakhe ka thinlung kha</para>
  <para style="q2">tyty ka nung cih zah,</para>
  <para style="q1">na laanpi kha hoyte ka dokuh cih.</para>
  <para style="q1">
    <verse number="16" style="v" />Na phungbya kyakhe</para>
  <para style="q2">ka lungrythua cih zah,</para>
  <para style="q1">na bya kha ka ning lan khyh.</para>
  <para style="q1">
    <verse number="17" style="v" />Ka hiin zah na bya ka zuithya nawlan,</para>
  <para style="q2">na ryalahtupaw tungvaw kya</para>
  <para style="q1">hoynaw raetua.</para>
  <para style="q1">
    <verse number="18" style="v" />Na kawbya lungkhu e</para>
  <para style="q2">ngaeangthua lan umpaw</para>
  <para style="q1">uccaw hae kha a muih nawlan,</para>
  <para style="q2">ka mit yn awsah tua.</para>
  <para style="q1">
    <verse number="19" style="v" />Laephi vawlan hin mikhia hawte ka um;</para>
  <para style="q2">na kawbya kha ka kyate thuruh nan.</para>
  <para style="q1">
    <verse number="20" style="v" />Na phungzae kha</para>
  <para style="q2">eih a ry zungzae keiccuze</para>
  <para style="q2">ka muisaw tuh maee lang arua.</para>
  <para style="q1">
    <verse number="21" style="v" />Na kawbya a zui lei hae paw</para>
  <para style="q2">thyalaw athua hae paw te</para>
  <para style="q1">a lysakuh hae paw kha na thuihei hae.</para>
  <para style="q1">
    <verse number="22" style="v" />Na phunglang kha ka zui vae keiccuze,</para>
  <para style="q2">yn theihryanaw hae te</para>
  <para style="q1">yn dothatheihnaw hae kha</para>
  <para style="q2">ka kyate yn lawpya tua.</para>
  <para style="q1">
    <verse number="23" style="v" />Uktu bawi hae nynh kae kha</para>
  <para style="q2">rawsete khua a khanku hae ze heize,</para>
  <para style="q1">na ryalahtupaw kae tuh</para>
  <para style="q2">na phungbya hae kha</para>
  <para style="q2">ka thinlung kya tyty ka nung cih.</para>
  <para style="q1">
    <verse number="24" style="v" />Na phunglang tuh ka lungrythua zah,</para>
  <para style="q2">tuanaw hoypaw yn pyatu nynh thua.</para>
  <para style="q1">
    <verse number="25" style="v" />Ka hiinnaw tuh vuiping kya nynh</para>
  <para style="q2">a kalouhku vae;</para>
  <para style="q1">na bya thyhte yn hiinsah thui.</para>
  <para style="q1">
    <verse number="26" style="v" />Ka cyisahnaw balyn kha he ka ho te,</para>
  <para style="q2">nang nynh nae leih;</para>
  <para style="q1">na phungbya hae kha yn ccangpah.</para>
  <para style="q1">
    <verse number="27" style="v" />Na ccangpyanaw laanpi kha</para>
  <para style="q2">yn thaethyasah lah,</para>
  <para style="q1">ngaeangthua lan umpaw</para>
  <para style="q2">na ryalaw hae kyakhe</para>
  <para style="q1">ka thinlung kha tyty ka nung cih.</para>
  <para style="q1">
    <verse number="28" style="v" />Ka ngaethya keiccuze</para>
  <para style="q2">ka thinlung phe atui;</para>
  <para style="q1">na bya thyhte thawzung yn pyatua.</para>
  <para style="q1">
    <verse number="29" style="v" />Akyh leipaw laanpi kha ka kyate</para>
  <para style="q2">sawsakuh lah, na kawbya kha</para>
  <para style="q1">thawccinawte yn ccangpya tua.</para>
  <para style="q1">
    <verse number="30" style="v" />Lungzinaw laanpi kha ka poku vae;</para>
  <para style="q2">na phungzae hae kha</para>
  <para style="q1">ka malang ka nungku vae.</para>
  <para style="q1">
    <verse number="31" style="v" />Pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">na phunglang hae kha ka zui;</para>
  <para style="q2">maethya yn lah nan.</para>
  <para style="q1">
    <verse number="32" style="v" />Thaethyanaw houhouh nae pya keiccuze,</para>
  <para style="q2">na kawbya laanpi kyakhe ka ccue.</para>
  <para style="q1">
    <verse number="33" style="v" />Pou <char style="nd">Bawipaw </char>, na phungbya laanpi kha</para>
  <para style="q2">yn ccangpah lah,</para>
  <para style="q1">tuh-e tuh athangnaw cia ka zui cih.</para>
  <para style="q1">
    <verse number="34" style="v" />Na kawbya kha ccykekute</para>
  <para style="q2">ka thinlung balyn te ka zui nawlan,</para>
  <para style="q1">thaethyanaw beih yn pya.</para>
  <para style="q1">
    <verse number="35" style="v" />Na kawbya kyakhe</para>
  <para style="q2">ka lungry athua keiccuze,</para>
  <para style="q1">na kawbya laanpi kyakhe</para>
  <para style="q2">beih yn cciakhae.</para>
  <para style="q1">
    <verse number="36" style="v" />Ka thinlung te na phunglang kha</para>
  <para style="q2">yn rysah lah,</para>
  <para style="q1">karankunaw yn hoisah nan.</para>
  <para style="q1">
    <verse number="37" style="v" />Ka mit hynh ccungkia leipaw</para>
  <para style="q2">uccaw yn dosah nan;</para>
  <para style="q1">na laanpi kyakhe hiinnaw yn pya.</para>
  <para style="q1">
    <verse number="38" style="v" />Na raw ae rih hae paw hanlan</para>
  <para style="q2">na raepaw na byakinnaw kha</para>
  <para style="q1">na ryalahtu ka tungvaw kya ccingsah tua.</para>
  <para style="q1">
    <verse number="39" style="v" />Na phungzae hae tuh ahoy keiccuze</para>
  <para style="q2">ka ripaw thethyanaw kyate yn luesah.</para>
  <para style="q1">
    <verse number="40" style="v" />Dotua, na kawbya hae kha ka ry;</para>
  <para style="q2">na dingnaw kya yn hiinsah.</para>
  <para style="q1">
    <verse number="41" style="v" />Pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">atynpaw na sungsahnaw tuh</para>
  <para style="q2">ka tungvaw yn thua sah lah,</para>
  <para style="q1">na byakinnaw thyhte</para>
  <para style="q2">na khumnaw mah yn thua sah.</para>
  <para style="q1">
    <verse number="42" style="v" />Tetuh na bya kha ka doliaku keiccuze,</para>
  <para style="q2">yn sarya hae paw kha</para>
  <para style="q2">bya ka khung kho cih hae.</para>
  <para style="q1">
    <verse number="43" style="v" />Na phungzae kha</para>
  <para style="q2">ka ngaehoiku keiccuze</para>
  <para style="q1">byaccingpaw kha ka mung kyate</para>
  <para style="q2">papin yn lawpah nan.</para>
  <para style="q1">
    <verse number="44" style="v" />Na kawbya kha zungzae te zungzae cia</para>
  <para style="q2">po ka zui cih.</para>
  <para style="q1">
    <verse number="45" style="v" />Na kawbya kha ka ccung vae keiccuze</para>
  <para style="q2">luenaw kyakhe ka cceih cih.</para>
  <para style="q1">
    <verse number="46" style="v" />Na kawbya kha siapharan hae malang khe</para>
  <para style="q2">ka ho cih zah,</para>
  <para style="q1">ka maethyakhae lan khyh.</para>
  <para style="q1">
    <verse number="47" style="v" />Na kawbya hae kha ka ry keiccuze</para>
  <para style="q2">tuh-e kawbya hae kyakhe</para>
  <para style="q1">ka lungrythua cih.</para>
  <para style="q1">
    <verse number="48" style="v" />Ka rypaw na kawbya hae kha</para>
  <para style="q2">saw ka tua zah, na phungbya hae kha</para>
  <para style="q1">tyty ka tua cih.</para>
  <para style="q1">
    <verse number="49" style="v" />Na ryalahtupaw hanlan</para>
  <para style="q2">na bya kha liathuitua,</para>
  <para style="q2">tuh-e na bya kha nae ngaehoisah vae.</para>
  <para style="q1">
    <verse number="50" style="v" />Na byakinnaw nynh</para>
  <para style="q2">hiinnaw yn pya keiccuze</para>
  <para style="q1">ka vawsawnaw kya zemah</para>
  <para style="q2">ka ngaengan.</para>
  <para style="q1">
    <verse number="51" style="v" />A lysakuh hae paw nynh</para>
  <para style="q2">kae kha myarya yn theihrya hae,</para>
  <para style="q1">thuasalama na kawbya kyate</para>
  <para style="q2">ka cceihsei khyh.</para>
  <para style="q1">
    <verse number="52" style="v" />Pou <char style="nd">Bawipaw </char>, langmawlya e</para>
  <para style="q2">na phungzae hae kha he ka tua tuh,</para>
  <para style="q2">ngaengannaw ka mue.</para>
  <para style="q1">
    <verse number="53" style="v" />Na kawbya a vua hae paw</para>
  <para style="q2">ccungccaw hoylei hae keiccuze</para>
  <para style="q2">myarya ka thinria.</para>
  <para style="q1">
    <verse number="54" style="v" />Ka umnaw inn miakaw kya</para>
  <para style="q2">na phungbya hae tuh</para>
  <para style="q2">ka hlaw nynh thua hae.</para>
  <para style="q1">
    <verse number="55" style="v" />Pou <char style="nd">Bawipaw </char>, khuazi kya</para>
  <para style="q2">na min kha ka liathui zah</para>
  <para style="q2">na kawbya kha ka zui.</para>
  <para style="q1">
    <verse number="56" style="v" />Na kawbya hae kha ka zui vae keiccuze</para>
  <para style="q2">e hythuanaw hae hynh ka mue.</para>
  <para style="q1">
    <verse number="57" style="v" />
    <char style="nd">Bawipaw </char> tuh ka ccou lanpaw</para>
  <para style="q2">ka hanpaw nynh thua;</para>
  <para style="q1">na bya kha zui lan bya ka kinku.</para>
  <para style="q1">
    <verse number="58" style="v" />Ka thinlung balyn te na kya-e</para>
  <para style="q2">maehoynaw kha kae ngiaku;</para>
  <para style="q1">na byakinnaw thyhte ka tungvaw</para>
  <para style="q2">thaw beih yn ccih.</para>
  <para style="q1">
    <verse number="59" style="v" />Na laanpi kha he ka tua te,</para>
  <para style="q2">na phunglang kalan</para>
  <para style="q2">ka maeleihkuh zah ka zui.</para>
  <para style="q1">
    <verse number="60" style="v" />Na kawbya zui lan</para>
  <para style="q2">ka rangsakuh zah ka thysung khyh.</para>
  <para style="q1">
    <verse number="61" style="v" />Ccungccaw hoylei hae paw nynh</para>
  <para style="q2">mih kaangrui te yn kaesah hae zemah,</para>
  <para style="q1">na kawbya kha ka ning khyh.</para>
  <para style="q1">
    <verse number="62" style="v" />Adingpaw na phungzae hae keiccuze</para>
  <para style="q2">nang kha thehoysah khylan</para>
  <para style="q2">ziraccyng khe ka tho.</para>
  <para style="q1">
    <verse number="63" style="v" />Kae tuh na rawrih hae paw balyn te</para>
  <para style="q2">na kawbya a zui hae paw</para>
  <para style="q2">mih ruiban nynh ka thua.</para>
  <para style="q1">
    <verse number="64" style="v" />Pou <char style="nd">Bawipaw </char>, laephi tuh</para>
  <para style="q2">atynpaw na sungsahnaw te phe abeih;</para>
  <para style="q1">na phungbya hae kha yn ccangpya tua.</para>
  <para style="q1">
    <verse number="65" style="v" />Pou <char style="nd">Bawipaw </char>, na bya thyhte</para>
  <para style="q2">na ryalahtu tungvaw na hoy.</para>
  <para style="q1">
    <verse number="66" style="v" />Na kawbya hae kha ka zyn keiccuze</para>
  <para style="q2">ahoypaw byapiathyanaw te</para>
  <para style="q1">nythyanaw kha yn ccangpya tua.</para>
  <para style="q1">
    <verse number="67" style="v" />Vawsawnaw ka tung maw tuh ka cceihsei,</para>
  <para style="q2">thuasalama atu tuh na bya kha ka zui.</para>
  <para style="q1">
    <verse number="68" style="v" />Nang tuh na hoy zah</para>
  <para style="q2">ahoypaw kha na cyi;</para>
  <para style="q1">na phungbya hae kha yn ccangpya tua.</para>
  <para style="q1">
    <verse number="69" style="v" />A lysakuh hae paw nynh</para>
  <para style="q2">hynbya te ka thethya yn ho hae,</para>
  <para style="q1">thuasalama ka thinlung balyn te</para>
  <para style="q2">na kawbya kha ka zui.</para>
  <para style="q1">
    <verse number="70" style="v" />Mih thinlung tuh thaethyanaw</para>
  <para style="q2">hoi khyh zah a rysaw athah,</para>
  <para style="q1">thuasalama kae tuh</para>
  <para style="q2">na kawbya kyakhe ka lungrythua.</para>
  <para style="q1">
    <verse number="71" style="v" />Na phungbya hae kha</para>
  <para style="q2">ccangku khylan,</para>
  <para style="q1">vawsaw ka tungpaw hynh</para>
  <para style="q2">kamaw hanlan ahoy.</para>
  <para style="q1">
    <verse number="72" style="v" />Na hopaw kawbya tuh</para>
  <para style="q2">sui te ngun athong-asan laeze</para>
  <para style="q2">ka hanlan ahoyhua.</para>
  <para style="q1">
    <verse number="73" style="v" />Na kuih nynh kae kha yn rae zah,</para>
  <para style="q2">khyndadyh lan yn nung;</para>
  <para style="q1">na kawbya hae kha ka ccangku nawlan,</para>
  <para style="q2">thaethyanaw beih yn pya.</para>
  <para style="q1">
    <verse number="74" style="v" />Na bya kha ka ngaehoi vae keiccuze</para>
  <para style="q2">na rawrih hae paw nynh</para>
  <para style="q1">yn muih cih hae zah</para>
  <para style="q2">mih lungtua cih.</para>
  <para style="q1">
    <verse number="75" style="v" />Pou <char style="nd">Bawipaw </char>, na byapianaw tuh</para>
  <para style="q2">akyh cipaw ka nyh zah,</para>
  <para style="q1">na lungzinaw keiccuze vawsawnaw</para>
  <para style="q2">nae tungsah vae cipaw ka ny.</para>
  <para style="q1">
    <verse number="76" style="v" />Na ryalahtu tungvaw bya na kinku thyhte,</para>
  <para style="q2">atynpaw na sungsahnaw tuh</para>
  <para style="q1">ka ngaengannaw lang tang vae sah.</para>
  <para style="q1">
    <verse number="77" style="v" />Na kawbya tuh</para>
  <para style="q2">ka lungrythuakhaeku keiccuze</para>
  <para style="q2">ka hiin nawlan thaw yn ccitua.</para>
  <para style="q1">
    <verse number="78" style="v" />A lysakuh hae paw nynh</para>
  <para style="q2">hynthyanaw te yn ro vae hae keiccuze</para>
  <para style="q1">maethyanaw mue hae sah;</para>
  <para style="q2">kae tuh na kawbya kyakhe</para>
  <para style="q2">ka ohleihkuh cih.</para>
  <para style="q1">
    <verse number="79" style="v" />Na rawrih hae paw nynh</para>
  <para style="q2">na phunglang kha a ny nawlan hae,</para>
  <para style="q1">ka kalan oun maeleihkuh hae sah.</para>
  <para style="q1">
    <verse number="80" style="v" />Maethya ka bongku khyh nawlan,</para>
  <para style="q2">ka thinlung tuh na phungbya kya</para>
  <para style="q1">ccaenaw um leipaw thua vae sah.</para>
  <para style="q1">
    <verse number="81" style="v" />Ka muisaw tuh na khumnaw</para>
  <para style="q2">a ngawnaw kya a thawthang;</para>
  <para style="q1">na bya kha ka ngaehoiku.</para>
  <para style="q1">
    <verse number="82" style="v" />Na byakinpyakupaw kha</para>
  <para style="q2">ka dokhawnaw ze ka mit phe ccih vae;</para>
  <para style="q1">“Hohtuhmou ngaengannaw</para>
  <para style="q2">nae pya cih?” cite ka khia.</para>
  <para style="q1">
    <verse number="83" style="v" />Kae tuh maeekhuh kya umpaw</para>
  <para style="q2">savingtui-um hawte nynh ka thua vae,</para>
  <para style="q1">tuhzemah na phungbya kha</para>
  <para style="q2">ka ning loh khyh.</para>
  <para style="q1">
    <verse number="84" style="v" />Hohsemou na ryalahtupaw nynh</para>
  <para style="q2">ka ngaesang ung cih?</para>
  <para style="q1">Vawsaw yn pya hae paw hynh</para>
  <para style="q2">hohtuhmou bya na pia cih hae?</para>
  <para style="q1">
    <verse number="85" style="v" />A lysakuh hae paw nynh</para>
  <para style="q2">hunghua yn thaekhaw vae hae;</para>
  <para style="q1">minmin nynh na kawbya kha</para>
  <para style="q2">a rawse hae.</para>
  <para style="q1">
    <verse number="86" style="v" />Na kawbya balyn tuh atyn;</para>
  <para style="q2">akonglang um leite vawsaw yn pya hae;</para>
  <para style="q2">beih yn bawmtua!</para>
  <para style="q1">
    <verse number="87" style="v" />Minmin nynh laephi vawlan te</para>
  <para style="q2">vyavya yn zosah vae hae;</para>
  <para style="q1">thuasalama na kawbya hae kha</para>
  <para style="q2">ka vua khyh.</para>
  <para style="q1">
    <verse number="88" style="v" />Na hopaw phunglang hae kha</para>
  <para style="q2">ka zui ccaw hae,</para>
  <para style="q1">atynpaw na sungsahnaw te</para>
  <para style="q2">ka hiinnaw hynh beih yn haang.</para>
  <para style="q1">
    <verse number="89" style="v" />
    <char style="nd">Bawipaw </char> tuh zungzae atyn;</para>
  <para style="q2">na bya tuh vaawram kya</para>
  <para style="q2">tynkaring lan a um.</para>
  <para style="q1">
    <verse number="90" style="v" />Na lungzinaw tuh</para>
  <para style="q2">she takyh kya atyn;</para>
  <para style="q1">laephi kha na tynsah zah,</para>
  <para style="q2">tynkaring lan a um.</para>
  <para style="q1">
    <verse number="91" style="v" />Atyn-are tuh na ryalahtu hae</para>
  <para style="q2">athua keiccuze kaw na pya thyhte</para>
  <para style="q2">atunin cia atyn hae.</para>
  <para style="q1">
    <verse number="92" style="v" />Na kawbya hynh</para>
  <para style="q2">ka lungry a la thua khyh lanze,</para>
  <para style="q1">vawsaw ka teingnaw kya</para>
  <para style="q2">phe ka la chih vae cih.</para>
  <para style="q1">
    <verse number="93" style="v" />Na kawbya hae kha</para>
  <para style="q2">papin ka ning lan khyh,</para>
  <para style="q1">pawccecize e na kawbya hae liate</para>
  <para style="q2">hiinnaw nae pya.</para>
  <para style="q1">
    <verse number="94" style="v" />Kae tuh na kya-e nynh ka thua;</para>
  <para style="q2">beih yn khumtua,</para>
  <para style="q1">pawccecize na kawbya hae kha</para>
  <para style="q2">ka ccung zah ka zui vae.</para>
  <para style="q1">
    <verse number="95" style="v" />Ccungccaw hoylei hae paw nynh</para>
  <para style="q2">chia khylan yn buhkhaw hae,</para>
  <para style="q1">thuasalama na phunglang kha ka tua.</para>
  <para style="q1">
    <verse number="96" style="v" />Pawpaw mah accingpaw um khyh</para>
  <para style="q2">cipaw ka ny vae,</para>
  <para style="q1">thuasalama na kawbya tuh</para>
  <para style="q2">myaryamaw ako.</para>
  <para style="q1">
    <verse number="97" style="v" />Na kawbya hynh</para>
  <para style="q2">pawcih baban mou ka ry!</para>
  <para style="q1">E kyahin anin ninlang ka tua.</para>
  <para style="q1">
    <verse number="98" style="v" />Na kawbya nynh zungzae</para>
  <para style="q2">yn umkhae keiccuze</para>
  <para style="q2">ka rhaw hae laeze yn hawsah hua.</para>
  <para style="q1">
    <verse number="99" style="v" />Na phunglang hae kha</para>
  <para style="q2">tyty ka tua keiccuze</para>
  <para style="q1">ka sazae hae balyn laeze</para>
  <para style="q2">ka nyhthyahua.</para>
  <para style="q1">
    <verse number="100" style="v" />Na kawbya kha ka zui keiccuze</para>
  <para style="q2">akum tang hae paw laeze</para>
  <para style="q2">ka nyhthyahua.</para>
  <para style="q1">
    <verse number="101" style="v" />Na bya kha zui khylan</para>
  <para style="q2">ahoy leipaw laanpi miakaw kha ka sibia.</para>
  <para style="q1">
    <verse number="102" style="v" />Nae ccangpya vae keiccuze</para>
  <para style="q2">na phungzae hae kyate</para>
  <para style="q2">ccanglang ka maekuh khyh.</para>
  <para style="q1">
    <verse number="103" style="v" />Na bya tuh ka taangtua zah</para>
  <para style="q2">pawcih baban mou a e,</para>
  <para style="q2">ka khalang kya khoilutui laeze a ehua.</para>
  <para style="q1">
    <verse number="104" style="v" />Na kawbya liate nythyanaw ka mue;</para>
  <para style="q2">tukeiccuze ahme leipaw</para>
  <para style="q1">laanpi miakaw kha ka hua.</para>
  <para style="q1">
    <verse number="105" style="v" />Na bya tuh ka ccu hanlan</para>
  <para style="q2">maeekhua thua zah,</para>
  <para style="q2">ka laanpi hanlan awnaw nynh thua.</para>
  <para style="q1">
    <verse number="106" style="v" />Adingpaw na phungzae kha</para>
  <para style="q2">zui khylan bya ka kinkuh vae zah</para>
  <para style="q2">ka tynsah vae.</para>
  <para style="q1">
    <verse number="107" style="v" />Pou <char style="nd">Bawipaw </char>, ka teingnaw tuh</para>
  <para style="q2">myaryamaw accih;</para>
  <para style="q2">na bya thyhte beih yn hiin sah.</para>
  <para style="q1">
    <verse number="108" style="v" />Pou <char style="nd">Bawipaw </char>, the kae hoysahnawpaw</para>
  <para style="q2">silawkunawpaw hynh</para>
  <para style="q1">beih yn ccoupah lah,</para>
  <para style="q2">na phungzae kha yn ccangpya tua.</para>
  <para style="q1">
    <verse number="109" style="v" />Ka hiinnaw tuh ka kuih kya nynh tyty a um,</para>
  <para style="q2">thuasalama na kawbya kha ka ning khyh.</para>
  <para style="q1">
    <verse number="110" style="v" />Ccungccaw hoylei hae paw nynh</para>
  <para style="q2">kaang yn syakhaw hae,</para>
  <para style="q1">thuasalama na kawbya kyate</para>
  <para style="q2">ccanglang ka cceihsei khyh.</para>
  <para style="q1">
    <verse number="111" style="v" />Na phunglang hae tuh</para>
  <para style="q2">zungzae ka rho thua zah,</para>
  <para style="q2">ka thinlung a lungtuanawpaw nynh thua.</para>
  <para style="q1">
    <verse number="112" style="v" />Na phungbya hae kha</para>
  <para style="q2">athangnaw cia zungzae zui khylan</para>
  <para style="q1">ka thinlung kya bya ka paeku vae.</para>
  <para style="q1">
    <verse number="113" style="v" />Thinlung apheipaw kha ka hua,</para>
  <para style="q2">thuasalama na kawbya kha ka ry.</para>
  <para style="q1">
    <verse number="114" style="v" />Nang tuh ka rekunaw hmin te</para>
  <para style="q2">ka khawriaphua nynh na thua;</para>
  <para style="q2">na bya kha ka ngaehoi.</para>
  <para style="q1">
    <verse number="115" style="v" />Hoyleinaw a rae hae paw nanning,</para>
  <para style="q2">ka Pachia kawbya kha ka zui nawlan,</para>
  <para style="q2">ka kyate asawkunaw lang cceih oh.</para>
  <para style="q1">
    <verse number="116" style="v" />Ka hiin nawlan,</para>
  <para style="q2">na byakinnaw thyhte yn bawmtua,</para>
  <para style="q1">ka ngaehoinaw kya</para>
  <para style="q2">maethyanaw yn muesah nan.</para>
  <para style="q1">
    <verse number="117" style="v" />Ka khyn nawlan te</para>
  <para style="q2">na phungbya hae kha</para>
  <para style="q1">tyty ka peki nawlan,</para>
  <para style="q2">phang yn kyngtua.</para>
  <para style="q1">
    <verse number="118" style="v" />Na phungbya zui leite</para>
  <para style="q2">a cceihseipaw balyn kha na vua hae;</para>
  <para style="q1">pawccecize mih thyaruhnaw tuh</para>
  <para style="q2">accakaepaw nynh thua.</para>
  <para style="q1">
    <verse number="119" style="v" />Laephi vawlan e</para>
  <para style="q2">ccungccaw hoyleipaw balyn hynh</para>
  <para style="q1">athupaw lang nynh na ria hae;</para>
  <para style="q2">tukeiccuze na phunglang hae kha ka ry.</para>
  <para style="q1">
    <verse number="120" style="v" />Na raw ka ri keiccuze ka thyngkuh,</para>
  <para style="q2">na byapianaw kha ka rih.</para>
  <para style="q1">
    <verse number="121" style="v" />Ahmepaw te akyhpaw kha ka cyi vae;</para>
  <para style="q2">yn tuaa yn sah hae paw kyakhe</para>
  <para style="q2">yn nungsya nan.</para>
  <para style="q1">
    <verse number="122" style="v" />Na ryalahtupaw ka hoynaw hanlan</para>
  <para style="q2">bya yn kinpyaku tua;</para>
  <para style="q1">a lysakuh hae paw nynh</para>
  <para style="q2">vawsawnaw yn pya nan hae sah.</para>
  <para style="q1">
    <verse number="123" style="v" />Na khumnaw te adingpaw</para>
  <para style="q2">na byakin accingnaw kha</para>
  <para style="q1">ka donaw ze ka mit phe ccih vae.</para>
  <para style="q1">
    <verse number="124" style="v" />Atynpaw na sungsahnaw thyhte</para>
  <para style="q2">na ryalahtu hynh yn ccuepe lah,</para>
  <para style="q1">na phungbya hae kha yn ccangpah.</para>
  <para style="q1">
    <verse number="125" style="v" />Kae tuh na ryalahtu nynh ka thua;</para>
  <para style="q2">na phunglang hae kha ka ny nawlan,</para>
  <para style="q1">nythyanaw beih yn pya.</para>
  <para style="q1">
    <verse number="126" style="v" />Na kawbya kha a vua vae hae keiccuze</para>
  <para style="q2">atu hynh <char style="nd">Bawipaw </char> hanlan</para>
  <para style="q1">ryalaw ccyh nynh athua vae.</para>
  <para style="q1">
    <verse number="127" style="v" />Thanccingte, na kawbya hae kha</para>
  <para style="q2">sui laeze ka ryhua zah,</para>
  <para style="q1">sui hoypaw laeze mah ka ryhua.</para>
  <para style="q1">
    <verse number="128" style="v" />Tukeiccuze na kawbya balyn kha ka zui zah,</para>
  <para style="q2">ahme leipaw laanpi miakaw kha ka hua.</para>
  <para style="q1">
    <verse number="129" style="v" />Na phunglang hae tuh</para>
  <para style="q2">ngaeangthua lan a um;</para>
  <para style="q1">tukeiccuze ka hiinnaw nynh</para>
  <para style="q2">khah-e phunglang hae kha a zui.</para>
  <para style="q1">
    <verse number="130" style="v" />Na kawbya kha ccaerarih lan</para>
  <para style="q2">phynaw nynh awnaw kha a pya;</para>
  <para style="q1">tuh-e nynh tuanaw a zya hae paw kha</para>
  <para style="q2">nythyanaw a pya hae.</para>
  <para style="q1">
    <verse number="131" style="v" />Na kawbya kha eih ka ry keiccuze</para>
  <para style="q2">ka khalang ka aw zah ka hy phe law.</para>
  <para style="q1">
    <verse number="132" style="v" />Na min a ry hae paw kha</para>
  <para style="q2">thaw leih na cci hae hawte,</para>
  <para style="q1">ka kalan yn hawi lah, thaw beih yn ccitua.</para>
  <para style="q1">
    <verse number="133" style="v" />Bya nae kinpyaku thyhte</para>
  <para style="q2">ka laan ka sui yn uasahpah lah,</para>
  <para style="q1">hoyleinaw nynh kae kha</para>
  <para style="q2">papin yn uk nan sah.</para>
  <para style="q1">
    <verse number="134" style="v" />Na kawbya hae kha</para>
  <para style="q2">ka zui kho nawlan,</para>
  <para style="q1">ccungccaw tuaasahnaw kyate</para>
  <para style="q2">yn shawkhawtua.</para>
  <para style="q1">
    <verse number="135" style="v" />Na ryalahtupaw tungvaw kya</para>
  <para style="q2">na mitmae kha awsah lah,</para>
  <para style="q1">na phungbya hae kha yn ccangpya tua.</para>
  <para style="q1">
    <verse number="136" style="v" />Na kawbya kha a zui khyh keiccu hae ze,</para>
  <para style="q2">ka mit kyate mitphi tuh vaw hawte alua.</para>
  <para style="q1">
    <verse number="137" style="v" />Pou <char style="nd">Bawipaw </char>, nang tuh na ding zah,</para>
  <para style="q2">na byapianaw tuh ahme.</para>
  <para style="q1">
    <verse number="138" style="v" />Nae pyapaw na phunglang hae tuh</para>
  <para style="q2">a dingpaw te a lungzipaw nynh thua.</para>
  <para style="q1">
    <verse number="139" style="v" />Ka rhaw hae nynh na bya kha</para>
  <para style="q2">a ning hae keiccuze</para>
  <para style="q1">ka thinrianaw nynh maee hawte yn u.</para>
  <para style="q1">
    <verse number="140" style="v" />Na byakin tuh hoyte syntawtua thua zah,</para>
  <para style="q2">na ryalahtu kae nynh khah-e kha ka ry.</para>
  <para style="q1">
    <verse number="141" style="v" />Kae tuh a nyaapaw te</para>
  <para style="q2">a dothatheih hae paw nynh ka thua,</para>
  <para style="q1">tuhzemah na kawbya hae kha</para>
  <para style="q2">ka ning khyh.</para>
  <para style="q1">
    <verse number="142" style="v" />Na dingnaw tuh zungzae tynpaw</para>
  <para style="q2">dingnaw thua zah,</para>
  <para style="q1">na kawbya tuh byaccing nynh thua.</para>
  <para style="q1">
    <verse number="143" style="v" />Vawsawnaw te lungriathaenaw nynh</para>
  <para style="q2">ka tungvaw yn thuanua vae,</para>
  <para style="q1">thuasalama na kawbya hae tuh</para>
  <para style="q2">ka lungrypaw nynh thua.</para>
  <para style="q1">
    <verse number="144" style="v" />Na phunglang hae tuh zungzae ading;</para>
  <para style="q2">nythyanaw kha beih yn pya lah, ka hiin cih.</para>
  <para style="q1">
    <verse number="145" style="v" />Ka thinlung balyn te ka sia;</para>
  <para style="q2">Pou <char style="nd">Bawipaw </char>, beih yn leihtua.</para>
  <para style="q1">Na phungbya hae kha ka zui cih.</para>
  <para style="q1">
    <verse number="146" style="v" />Na kalan khe ka sia;</para>
  <para style="q2">na phunglang hae kha ka zui nawlan,</para>
  <para style="q1">beih yn khumtua.</para>
  <para style="q1">
    <verse number="147" style="v" />Khua adae mawte ka tho zah,</para>
  <para style="q2">bawmnaw mue khylan ka sia;</para>
  <para style="q1">na bya kha ka ngaehoiku.</para>
  <para style="q1">
    <verse number="148" style="v" />Na byakinpyanaw kha tuate</para>
  <para style="q2">zidae ka mit masi leite po ka hah.</para>
  <para style="q1">
    <verse number="149" style="v" />Atynpaw na sungsahnaw liate</para>
  <para style="q2">ka roi beih yn thaepah;</para>
  <para style="q1">Pou <char style="nd">Bawipaw </char>, na byading liate</para>
  <para style="q2">ka hiinnaw beih yn haang.</para>
  <para style="q1">
    <verse number="150" style="v" />Ahoy leipaw eenaw hoite</para>
  <para style="q2">vawsaw yn pya hae paw nynh</para>
  <para style="q1">ka kalan oun naeku hae,</para>
  <para style="q2">minmin tuh na kawbya te a sawkuh hae.</para>
  <para style="q1">
    <verse number="151" style="v" />Tuhzemah pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">nang tuh ka pe na um,</para>
  <para style="q1">na kawbya balyn tuh akyh.</para>
  <para style="q1">
    <verse number="152" style="v" />Na phunglang hae kha</para>
  <para style="q2">zungzae na tynsah vae cipaw tuh</para>
  <para style="q1">langmawlya mawte ka la ny vae.</para>
  <para style="q1">
    <verse number="153" style="v" />Ka riathaenaw hynh yn do lah,</para>
  <para style="q2">yn luesah tua,</para>
  <para style="q1">pawccecize na kawbya kha ka ning khyh.</para>
  <para style="q1">
    <verse number="154" style="v" />Ka tungpaw bya te than kyahin</para>
  <para style="q2">yn pankhaw lah, yn shawkhawtua;</para>
  <para style="q1">na byakinnaw thyhte beih yn hiinsah.</para>
  <para style="q1">
    <verse number="155" style="v" />Khumnaw tuh</para>
  <para style="q2">ccungccaw hoylei hae paw kyate a sawkuh,</para>
  <para style="q1">pawccecize na phungbya kha</para>
  <para style="q2">ccung khyh hae.</para>
  <para style="q1">
    <verse number="156" style="v" />Pou <char style="nd">Bawipaw </char>, na thawccinaw tuh</para>
  <para style="q2">myarya ale; na byading thyhte</para>
  <para style="q1">hiinnaw beih yn pya.</para>
  <para style="q1">
    <verse number="157" style="v" />Yn tuaa yn sah hae paw te</para>
  <para style="q2">ka rhaw hae tuh myarya alung hae,</para>
  <para style="q1">tuhzemah na phunglang kyate</para>
  <para style="q2">ka maekuh khyh.</para>
  <para style="q1">
    <verse number="158" style="v" />Mih lungzi lei hae paw kha</para>
  <para style="q2">ka do hae zah ka luathua,</para>
  <para style="q1">pawccecize na kawbya kha</para>
  <para style="q2">zui khyh hae.</para>
  <para style="q1">
    <verse number="159" style="v" />Na kawbya kha pawcih baban mou</para>
  <para style="q2">ka ry cipaw tuatua;</para>
  <para style="q1">atynpaw na sungsahnaw thyhte</para>
  <para style="q2">ka hiinnaw hynh beih yn haang.</para>
  <para style="q1">
    <verse number="160" style="v" />Na bya hynh abalyn mawte</para>
  <para style="q2">byaccing nynh thua;</para>
  <para style="q1">adingpaw na phungzae ccangkheit cci tuh</para>
  <para style="q2">zungzae atyn.</para>
  <para style="q1">
    <verse number="161" style="v" />Uktu bawi hae nynh akonglang um leite</para>
  <para style="q2">yn tuaa yn sah hae,</para>
  <para style="q1">thuasalama ka thinlung tuh na bya kha a rih.</para>
  <para style="q1">
    <verse number="162" style="v" />Aphutepaw sisua patae</para>
  <para style="q2">a muihkuhpaw hawte</para>
  <para style="q1">na bya kyakhe ka lungtua.</para>
  <para style="q1">
    <verse number="163" style="v" />Hynbya kha ka hua zah ka luathua,</para>
  <para style="q2">thuasalama na kawbya kha ka ry.</para>
  <para style="q1">
    <verse number="164" style="v" />Adingpaw na phungzae hae keiccuze</para>
  <para style="q2">nin kheit ze vae sari kae thehoysah.</para>
  <para style="q1">
    <verse number="165" style="v" />Na kawbya a ry hae paw tuh</para>
  <para style="q2">myarya lepaw daenaw a hoi hae;</para>
  <para style="q1">pawpaw nynh mah minmin kha</para>
  <para style="q2">khulia kho khyh hae.</para>
  <para style="q1">
    <verse number="166" style="v" />Pou <char style="nd">Bawipaw </char>, na khumnaw kha</para>
  <para style="q2">ka ngaehoikuh zah,</para>
  <para style="q1">na kawbya hae kha ka zui.</para>
  <para style="q1">
    <verse number="167" style="v" />Ka hiinnaw nynh</para>
  <para style="q2">na phunglang hae kha a zui;</para>
  <para style="q1">khah-e phunglang hae kha</para>
  <para style="q2">myaryamaw ka ry.</para>
  <para style="q1">
    <verse number="168" style="v" />Na kawbya hae te</para>
  <para style="q2">na phunglang hae kha ka zui,</para>
  <para style="q1">pawccecize ka hiinzia balyn kha</para>
  <para style="q2">phe na muih.</para>
  <para style="q1">
    <verse number="169" style="v" />Pou <char style="nd">Bawipaw </char>, ka siaruanaw hynh</para>
  <para style="q2">na kya thua vae sah;</para>
  <para style="q1">na bya thyhte nythyanaw beih yn pya.</para>
  <para style="q1">
    <verse number="170" style="v" />Kae ngianaw hynh na kya thua vae sah;</para>
  <para style="q2">bya na kinpyaku thyhte yn luesah tua.</para>
  <para style="q1">
    <verse number="171" style="v" />Na phungbya hae kha</para>
  <para style="q2">nae ccangpya keiccuze</para>
  <para style="q1">ka mung nynh thehoysahnaw</para>
  <para style="q2">bya kha a ho cih.</para>
  <para style="q1">
    <verse number="172" style="v" />Na kawbya balyn tuh akyh keiccuze</para>
  <para style="q2">ka mung ka lae nynh</para>
  <para style="q1">na byakinkunaw kha</para>
  <para style="q2">hlaw te a sah cih.</para>
  <para style="q1">
    <verse number="173" style="v" />Na kawbya hae kha</para>
  <para style="q2">ka poku vae keiccuze</para>
  <para style="q1">na kuih tuh kae kha bawm khylan</para>
  <para style="q2">paccynkute um sah.</para>
  <para style="q1">
    <verse number="174" style="v" />Pou <char style="nd">Bawipaw </char>, na khumnaw kha</para>
  <para style="q2">myarya ka ry,</para>
  <para style="q1">na kawbya tuh ka lungrypaw nynh thua.</para>
  <para style="q1">
    <verse number="175" style="v" />Nang kha the kae hoysah kho nawlan,</para>
  <para style="q2">hiinnaw beih yn pyatua,</para>
  <para style="q1">na phungzae hae nynh kae kha</para>
  <para style="q2">yn bawm hae sah.</para>
  <para style="q1">
    <verse number="176" style="v" />Tuu azopaw hawte ka cceihsei vae;</para>
  <para style="q2">na ryalahtupaw hynh beih yn ccung,</para>
  <para style="q1">pawccecize na kawbya kha</para>
  <para style="q2">ka ning khyh.</para>
  <chapter number="120" style="c" />
  <para style="s1">Mihyn hae kyate Lue khylan Sawsangnaw</para>
  <para style="d">Cciathungnaw Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Ka vawsaw lyakhe <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">yn thaepya ccaw cite</para>
  <para style="q2">amaw kalan ka sia:</para>
  <para style="q1">
    <verse number="2" style="v" />“Pou <char style="nd">Bawipaw </char>, ahynthyapaw</para>
  <para style="q2">munglae kyate thuasah,</para>
  <para style="q1">alingthyapaw lae kyate thuasah</para>
  <para style="q2">yn luesah tua,” ka ci.</para>
  <para style="q1">
    <verse number="3" style="v" />Pou alingthyapaw lae,</para>
  <para style="q2">paw thanenaw mou pya na thua cih?</para>
  <para style="q1">Na tungvaw kya pawmou</para>
  <para style="q2">houh cyichih athua cih?</para>
  <para style="q1">
    <verse number="4" style="v" />Rhawkaw kya-e ahepaw the te</para>
  <para style="q2">maeehue a-epaw hawte nynh thua!</para>
  <para style="q1">
    <verse number="5" style="v" />Meshek ram kya</para>
  <para style="q2">ramccangpaw lante um te</para>
  <para style="q1">Kedar ccungccaw hae bu kya um tuh</para>
  <para style="q2">ka hanlan ngaethya lan kou um.</para>
  <para style="q1">
    <verse number="6" style="v" />Daenaw a hua hae paw laku kya</para>
  <para style="q2">khaw cia ka um vae.</para>
  <para style="q1">
    <verse number="7" style="v" />Kae tuh daenaw rypaw nynh ka thua;</para>
  <para style="q2">bya he ka ho vae ze,</para>
  <para style="q1">minmin nynh rhawtukku a ry hae.</para>
  <chapter number="121" style="c" />
  <para style="s1">Pachia Thungkhawnaw</para>
  <para style="d">Cciathungnaw Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Mua langkhe ka dothung—</para>
  <para style="q2">tei kyate mou ka hanlan</para>
  <para style="q2">bawmnaw yn thua cih?</para>
  <para style="q1">
    <verse number="2" style="v" />Ka hanlan bawmnaw tuh</para>
  <para style="q2">vaaw te lae a raetu</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kyate nynh yn thua.</para>
  <para style="q1">
    <verse number="3" style="v" />Na ccu kha ae theisah lan khyh;</para>
  <para style="q2">nang ae rintupaw nynh</para>
  <para style="q1">nang kha ae ngawtaw lan khyh.</para>
  <para style="q1">
    <verse number="4" style="v" />Israel a rintupaw tuh</para>
  <para style="q2">ngawphukuh lan khyh zah,</para>
  <para style="q2">i mah ih lan khyh.</para>
  <para style="q1">
    <verse number="5" style="v" />
    <char style="nd">Bawipaw </char> tuh nang ae rintu nynh thua;</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> tuh na ranglang a umpaw</para>
  <para style="q1">na rekunaw mynlyh nynh thua.</para>
  <para style="q1">
    <verse number="6" style="v" />Khuadae kya khuanin nynh thuasah,</para>
  <para style="q2">khuazi kya sawpaw nynh thuasah</para>
  <para style="q1">vawsaw ae pya lan khyh.</para>
  <para style="q1">
    <verse number="7" style="v" />
    <char style="nd">Bawipaw </char> nynh ahoy leipaw balyn kyate</para>
  <para style="q2">ae thungkhaw cih zah,</para>
  <para style="q1">na hiinnaw kha ae rin cih.</para>
  <para style="q1">
    <verse number="8" style="v" />
    <char style="nd">Bawipaw </char> nynh na pou ze thuasah,</para>
  <para style="q2">na tee ze thuasah atu te</para>
  <para style="q1">zungzae cia ae rin cih.</para>
  <chapter number="122" style="c" />
  <para style="s1">Jerusalem hanlan Sawsangnaw</para>
  <para style="d">Cciathungnaw Hlaw, David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />“<char style="nd">Bawipaw </char> inn lang cceih oh sih!” cite</para>
  <para style="q2">he yn hopya vae hae ze ka lungtua.</para>
  <para style="q1">
    <verse number="2" style="v" />Pou Jerusalem, na koikua lungkhu kya</para>
  <para style="q2">phang kae thadyn.</para>
  <para style="q1">
    <verse number="3" style="v" />Jerusalem tuh sihkakinpaw khuapi</para>
  <para style="q2">atynpaw lang sakpaw nynh thua.</para>
  <para style="q1">
    <verse number="4" style="v" />Israel hae hanlan phungzae a um thyhte,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> minphuin hae tuh</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> min kha thehoysah khylan</para>
  <para style="q2">tuh-e khuapi kalan tuin a cceihthung hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Pawccecize tuin kyakhe</para>
  <para style="q2">byapianaw hanlan bawitungkhung,</para>
  <para style="q1">David phin kya-e bawitungkhung a um.</para>
  <para style="q1">
    <verse number="6" style="v" />Jerusalem daenaw hanlan sawsang oh:</para>
  <para style="q2">“Jerusalem, nang ae sungsah hae paw tuh</para>
  <para style="q1">hoynaw mue hae sah.</para>
  <para style="q1">
    <verse number="7" style="v" />Na khua hohung lungkhu kya</para>
  <para style="q2">daenaw um sah lah,</para>
  <para style="q1">na rhawviainn ahangpaw kya</para>
  <para style="q2">khynnaw um sah.”</para>
  <para style="q1">
    <verse number="8" style="v" />Ka puizia hae te ka ban hae hanlan,</para>
  <para style="q2">“Na kya daenaw um sah,” cite</para>
  <para style="q1">Jerusalem kha ka hopah cih.</para>
  <para style="q1">
    <verse number="9" style="v" />
    <char style="nd">Bawipaw </char> kae Pachia inn kha tuate,</para>
  <para style="q2">na hoynaw hanlan ka ccung cih.</para>
  <chapter number="123" style="c" />
  <para style="s1">Thawccinaw hanlan Ngianaw</para>
  <para style="d">Cciathungnaw Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Vaawram bawitungkhung kya</para>
  <para style="q2">a umpaw <char style="nd">Bawipaw </char>,</para>
  <para style="q1">namaw kalan khe ka dothung!</para>
  <para style="q1">
    <verse number="2" style="v" />See hae nynh mih bawipaw kuih kha</para>
  <para style="q2">do hae zah,</para>
  <para style="q1">seenung hae nynh mih bawinung kuih kha</para>
  <para style="q2">a do hae hawte,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kae Pachia nynh</para>
  <para style="q2">ngaethya oun umsah makhia,</para>
  <para style="q1">amaw kha kae do.</para>
  <para style="q1">
    <verse number="3" style="v" />Pou <char style="nd">Bawipaw </char>, kaening hynh</para>
  <para style="q2">ngaethya beih oun um sah,</para>
  <para style="q1">pawccecize myaryamaw oun dothatheih hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Mihoi hae nynh saryakunaw te</para>
  <para style="q2">a lysakuh hae paw nynh</para>
  <para style="q1">dothatheihkunaw kha kae hiinnaw tuh</para>
  <para style="q2">myaryamaw a teing vae.</para>
  <chapter number="124" style="c" />
  <para style="s1">Israel A Lue keiccuze Thehoysahnaw</para>
  <para style="d">Cciathungnaw Hlaw, David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> tuh aening kalan te</para>
  <para style="q2">a la pan khyh lanze, cite</para>
  <para style="q2">Israel phin nynh atu ho sah:</para>
  <para style="q1">
    <verse number="2" style="v" />“<char style="nd">Bawipaw </char> tuh aening kalan te</para>
  <para style="q2">a la pan khyh lanze,</para>
  <para style="q1">ah rhaw hae nynh aening kha</para>
  <para style="q2">he oun tuk hae te,</para>
  <para style="q1">
    <verse number="3" style="v" />aening tungvaw mih thinrianaw tuh</para>
  <para style="q2">maee lang ruate, ah hiin pi oh te,</para>
  <para style="q2">phe oun la laang vae cih hae;</para>
  <para style="q1">
    <verse number="4" style="v" />tetuh tui alepaw nynh aening kha</para>
  <para style="q2">oun lou cih zah,</para>
  <para style="q2">tuithaw nynh pong oun vu vae cih;</para>
  <para style="q1">
    <verse number="5" style="v" />te tuithaw nynh</para>
  <para style="q2">oun luathin vae cih,” a ci cih hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Ah rhaw hae nynh mih haw te</para>
  <para style="q2">a tei hae paw saw lante</para>
  <para style="q1">oun pya leipaw <char style="nd">Bawipaw </char> tuh</para>
  <para style="q2">thehoysah oh sih.</para>
  <para style="q1">
    <verse number="7" style="v" />Kaang a syatupaw kaang kyate</para>
  <para style="q2">a luepaw pavaw hawte</para>
  <para style="q1">ah lue vae oh;</para>
  <para style="q2">kaang tuh ro thua zah ah lue vae oh.</para>
  <para style="q1">
    <verse number="8" style="v" />Vaaw te lae a raepaw</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> min liate</para>
  <para style="q1">aening tuh bawmnaw ah mue oh.</para>
  <chapter number="125" style="c" />
  <para style="s1">Pachia Ccungccaw hae Khynnaw</para>
  <para style="d">Cciathungnaw Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> a doliakuh hae paw tuh</para>
  <para style="q2">zungzae tyn zah, nue kho athua leipaw</para>
  <para style="q2">Zion Mua te nynh a loku hae.</para>
  <para style="q1">
    <verse number="2" style="v" />Mua hae nynh Jerusalem khua kha</para>
  <para style="q2">a koihlu hae hawte,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh a ccungccaw hae kha</para>
  <para style="q2">atu te zungzae cia a koihlu hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Miding hae nynh mih kuih kha</para>
  <para style="q2">ahoy leipaw rae nawlan</para>
  <para style="q1">a dyng khyh nawlan hae,</para>
  <para style="q2">miding hae hanlan</para>
  <para style="q1">neethung athuapaw ram kyakhe</para>
  <para style="q2">ccungccaw hoylei hae paw ccoi tuh</para>
  <para style="q2">um lan khyh.</para>
  <para style="q1">
    <verse number="4" style="v" />Pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">ccungccaw hoypaw hae tungvaw te</para>
  <para style="q1">mih thinlung a ding hae paw tungvaw kya</para>
  <para style="q2">hoynaw beih raetua.</para>
  <para style="q1">
    <verse number="5" style="v" />Thuasalama akyh leipaw mih laanpi lang</para>
  <para style="q2">a maekuh hae paw kha</para>
  <para style="q1">hoyleinaw a rae hae paw ryte</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh ccanglang</para>
  <para style="q1">ccaring a dee cih hae.</para>
  <para style="q2">Israel kya daenaw um sah!</para>
  <chapter number="126" style="c" />
  <para style="s1">Lungtua Loohruenaw</para>
  <para style="d">Cciathungnaw Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> nynh Zion ccungccaw hae kha</para>
  <para style="q2">he oun kikhae tuh,</para>
  <para style="q1">aening tuh maan a sah hae paw te</para>
  <para style="q2">nynh ah loku oh.</para>
  <para style="q1">
    <verse number="2" style="v" />Tetuh ah khalang tuh</para>
  <para style="q2">nuinnaw te phe beih zah,</para>
  <para style="q2">ah lae tuh lungtua siaruanaw te phe beih;</para>
  <para style="q1">te minphuin ccangpaw hae nynh,</para>
  <para style="q2">“Minmin hanlan <char style="nd">Bawipaw </char> nynh</para>
  <para style="q1">myarya lepaw uccaw hae kha</para>
  <para style="q2">a cyipya vae hae,” cite a ho hae.</para>
  <para style="q1">
    <verse number="3" style="v" />
    <char style="nd">Bawipaw </char> nynh aening hanlan</para>
  <para style="q2">myarya lepaw uccaw hae</para>
  <para style="q1">oun cyipah vae zah,</para>
  <para style="q2">pawcih baban mou ah lungtua!</para>
  <para style="q1">
    <verse number="4" style="v" />Pou <char style="nd">Bawipaw </char>, Negeb vawkhu kya</para>
  <para style="q2">tui bua alua hawte,</para>
  <para style="q1">kaening hynh bua oun kikhae.</para>
  <para style="q1">
    <verse number="5" style="v" />Mitphi luate ccacii a vua hae paw tuh</para>
  <para style="q2">lungtua siaruate looh a rue cih hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Vua lanpaw ccacii kha</para>
  <para style="q2">ccyngkuh hae zah,</para>
  <para style="q1">mitphi luate a pou hae paw tuh</para>
  <para style="q2">mih ccatan cce kha puihkute</para>
  <para style="q1">lungtua siaruate inn lang a ki cih hae.</para>
  <chapter number="127" style="c" />
  <para style="s1">Inn kya Pachia Hythuanaw</para>
  <para style="d">Cciathungnaw Hlaw, Solomon Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> nynh inn kha</para>
  <para style="q2">a sak khyh lanze,</para>
  <para style="q1">inn saktu hae ryalaw tuh</para>
  <para style="q2">alakawpaw nynh thua,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh khuapi kha</para>
  <para style="q2">rhawviapya khyh lanze,</para>
  <para style="q1">khua rhawviatu hae nynh</para>
  <para style="q2">rhawvia hae paw tuh alakawpaw nynh thua.</para>
  <para style="q1">
    <verse number="2" style="v" />Awkhua takaw te thote</para>
  <para style="q2">khuazipi cia i leite,</para>
  <para style="q1">lungvawsaw thawbangte looh ae tuh</para>
  <para style="q2">alakawpaw nynh thua;</para>
  <para style="q1">pawccecize <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">a sungsahpaw kha inaw kaw a pya hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Ccaaw hae tuh <char style="nd">Bawipaw </char> kyate</para>
  <para style="q2">ccoupaw rho ccaccing thua hae zah,</para>
  <para style="q2">lasung nynh thua hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Lukhakheit nynh a no lyaze</para>
  <para style="q2">a saahkupaw ccaaw hae tuh</para>
  <para style="q1">rhawkaw kuih kya umpaw</para>
  <para style="q2">the te nynh a loku hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Tuhcihawpaw the te phe abeihpaw</para>
  <para style="q2">the bawng a hoipaw tuh</para>
  <para style="q1">lungtuapaw nynh thua.</para>
  <para style="q2">A rhaw hae ryte koikua kya</para>
  <para style="q1">bya a hoku hae ze,</para>
  <para style="q2">maethyanaw mue lan khyh.</para>
  <chapter number="128" style="c" />
  <para style="s1">Lungtuapaw Innbyn</para>
  <para style="d">Cciathungnaw Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> rawrih zah</para>
  <para style="q2">a laanpi a zuipaw miakaw tuh</para>
  <para style="q1">lungtuapaw nynh thua.</para>
  <para style="q1">
    <verse number="2" style="v" />Na kuih te rya na lah zah</para>
  <para style="q2">na muepaw looh kha na ae cih;</para>
  <para style="q1">na lungtua cih zah</para>
  <para style="q2">na laan na sui a ua cih.</para>
  <para style="q1">
    <verse number="3" style="v" />Na zu tuh na inn lungkhu kya</para>
  <para style="q2">patae a thaepaw misu ku hawte athua cih;</para>
  <para style="q1">na ccaaw hae nynh oliv thingtoi hawte</para>
  <para style="q2">na ccaboi kha a koihlu cih hae.</para>
  <para style="q1">
    <verse number="4" style="v" />
    <char style="nd">Bawipaw </char> rawrihpaw ccungccaw tuh</para>
  <para style="q2">tuhcite hythuanaw a ccou cih.</para>
  <para style="q1">
    <verse number="5" style="v" />
    <char style="nd">Bawipaw </char> nynh Zion kyate</para>
  <para style="q2">hythua ae pya oh.</para>
  <para style="q1">Jerusalem kya-e hoirumnaw kha</para>
  <para style="q2">nae hiin lungkhu balyn</para>
  <para style="q1">la ccou vae oh.</para>
  <para style="q1">
    <verse number="6" style="v" />Nae mintaw hae kha</para>
  <para style="q2">la muih hin vae oh.</para>
  <para style="q1">Israel kya daenaw um sah!</para>
  <chapter number="129" style="c" />
  <para style="s1">Rhaw Tae nawlan Sawsangnaw</para>
  <para style="d">Cciathungnaw Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />“Ka ngawphue lya mawte</para>
  <para style="q2">atu te atu yn dou vae hae,” cite</para>
  <para style="q1">Israel nynh atu ho sah:</para>
  <para style="q1">
    <verse number="2" style="v" />“Ka ngawphue lya mawte</para>
  <para style="q2">atu te atu yn dou vae hae,</para>
  <para style="q1">tuhzemah yn tae khyh hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Ka ke vawlan leithue hawte a thue hae,</para>
  <para style="q2">a thuenaw hae khe aringkuhpaw kha</para>
  <para style="q1">po a nysaku hae,” cite ho hae sah.</para>
  <para style="q1">
    <verse number="4" style="v" />
    <char style="nd">Bawipaw </char> tuh a ding;</para>
  <para style="q2">aning nynh ccungccaw hoylei hae paw kya-e</para>
  <para style="q2">arui kha thoh a pae vae.</para>
  <para style="q1">
    <verse number="5" style="v" />Zion a huatu hae balyn tuh</para>
  <para style="q2">maethyate nulang sihkuh hae sah.</para>
  <para style="q1">
    <verse number="6" style="v" />Minmin tuh innccukaly kya po zah</para>
  <para style="q2">a lethung mawze baleih anaanpaw</para>
  <para style="q1">lonua hawte thua hae sah,</para>
  <para style="q1">
    <verse number="7" style="v" />tuh-e lonua a khaeetupaw nynh</para>
  <para style="q2">a kuih te huukhin mue khyh zah,</para>
  <para style="q1">lonua cce a tungtupaw nynh mah</para>
  <para style="q2">a kuih te pomkhin mue khyh,</para>
  <para style="q1">
    <verse number="8" style="v" />a pepan po cceih hae paw nynh,</para>
  <para style="q2">“<char style="nd">Bawipaw </char> hythuanaw</para>
  <para style="q2">na tungvaw um vae sah!</para>
  <para style="q1">Kaening nynh <char style="nd">Bawipaw </char> min te</para>
  <para style="q2">hythua kae pya,” cite</para>
  <para style="q1">hopah khyh hae.</para>
  <chapter number="130" style="c" />
  <para style="s1">Shawkhawnaw kha Ngaehoinaw</para>
  <para style="d">Cciathungnaw Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, akhunaw kyate</para>
  <para style="q2">nang kha siaruate kae ko.</para>
  <para style="q2">
    <verse number="2" style="v" />Bawipaw, ka roi beih yn thaepah!</para>
  <para style="q1">Kae ngianaw roi hynh</para>
  <para style="q2">beih yn ngaepya tua!</para>
  <para style="q1">
    <verse number="3" style="v" />Pou <char style="nd">Bawipaw </char>, nang nynh</para>
  <para style="q2">hoyleinaw hae hynh na syntaw lanze,</para>
  <para style="q1">Bawipaw, hummou a thadyn kho cih?</para>
  <para style="q1">
    <verse number="4" style="v" />Thuasalama sawtua rawripaw</para>
  <para style="q2">na thua nawlan seingaethyanaw</para>
  <para style="q1">na hoi.</para>
  <para style="q1">
    <verse number="5" style="v" />
    <char style="nd">Bawipaw </char> kha ka ngaw,</para>
  <para style="q2">ka muisaw nynh mah ngaw zah</para>
  <para style="q1">a bya kha ka ngaehoi;</para>
  <para style="q1">
    <verse number="6" style="v" />Rhawviatu hae nynh khuadaetakaw</para>
  <para style="q2">vyvy yn aw lanpaw kha</para>
  <para style="q1">a ngaehoi hae laeze,</para>
  <para style="q2">ka muisaw nynh</para>
  <para style="q1">Bawipaw kha a ngaehoi.</para>
  <para style="q1">
    <verse number="7" style="v" />Pou Israel, <char style="nd">Bawipaw </char> kha ngaehoikuh!</para>
  <para style="q2">Pawccecize <char style="nd">Bawipaw </char> kyakhe</para>
  <para style="q1">atynpaw sungsahnaw um zah,</para>
  <para style="q2">shawkhawnawpaw huhan alepaw mah</para>
  <para style="q1">amaw kya a um.</para>
  <para style="q1">
    <verse number="8" style="v" />
    <char style="nd">Bawipaw </char> nynh Israel hae kha</para>
  <para style="q2">mih hoyleinaw kyate</para>
  <para style="q1">a shawkhaw cih hae.<note caller="-" style="x"><char style="xo" closed="false">130.8: </char><char style="xt" closed="false"><ref loc="MAT 1:21">Mat 1.21</ref>; <ref loc="TIT 2:14">Tit 2.14</ref></char></note></para>
  <chapter number="131" style="c" />
  <para style="s1">Doliakunaw Hlaw</para>
  <para style="d">Cciathungnaw Hlaw, David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, ka thinlung</para>
  <para style="q2">ka hangsakuh khyh,</para>
  <para style="q2">ka mitdae mah ka lysakuh khyh;</para>
  <para style="q1">kae ka hanlan myaryamaw</para>
  <para style="q2">ngaeangthua lan umpaw te</para>
  <para style="q1">myaryamaw alesaepaw</para>
  <para style="q2">uccaw hae kha ka peki khyh.</para>
  <para style="q1">
    <verse number="2" style="v" />Thuasalama a nung matei</para>
  <para style="q2">a phiakuh vae paw imua hawte,</para>
  <para style="q1">ka thinlung kha zya ka daesaku vae;</para>
  <para style="q2">ka thinlung tuh ka kya a um buapaw,</para>
  <para style="q1">matei a phiakuh vae paw</para>
  <para style="q2">imua te nynh a loku hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Pou Israel, atu te zungzae cia</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha ngaehoiku tua.</para>
  <chapter number="132" style="c" />
  <para style="s1">Zion kya Zungzae Umpaw Pachia</para>
  <para style="d">Cciathungnaw Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, David te a teingpaw</para>
  <para style="q2">vawsawnaw balyn kha liathuitua;</para>
  <para style="q1">
    <verse number="2" style="v" />aning nynh <char style="nd">Bawipaw </char> kalan te</para>
  <para style="q2">Athungpaw Jakob Pachia kalan</para>
  <para style="q1">bya a kinkupaw kha liathuitua:</para>
  <para style="q1">
    <verse number="3-5" style="v" />“<char style="nd">Bawipaw </char> hanlan hmin san kheit,</para>
  <para style="q2">Athungpaw Jakob Pachia hanlan</para>
  <para style="q1">umnaw hmin san kheit kha</para>
  <para style="q2">ka muih mawlaezung,</para>
  <para style="q2">ka inn lungkhu lang ka tee lan khyh zah,</para>
  <para style="q1">ka ikhung vawlan ka kae lan khyh;</para>
  <para style="q2">ka mit kha ka isah lan khyh zah,</para>
  <para style="q1">ka mit-ving kha masite ka isah lan khyh,” a ci.</para>
  <para style="q1">
    <verse number="6" style="v" />Byakin thingkua kong kha</para>
  <para style="q2">Efrathah ram kya kae thae zah,</para>
  <para style="q1">Jaar loo kyakhe tuh-e tuh kae muih.<note caller="-" style="x"><char style="xo" closed="false">132.6-10: </char><char style="xt" closed="false"><ref loc="2CH 6:41-42">2Sh 6.41-42</ref></char></note></para>
  <para style="q1">
    <verse number="7" style="v" />“A umnaw hmin kalan cceih oh sih lah,</para>
  <para style="q2">a ccu a khangnawpaw kyakhe</para>
  <para style="q1">beik oh sih,” kae ci.</para>
  <para style="q1">
    <verse number="8" style="v" />Pou <char style="nd">Bawipaw </char>, thokuh lah,</para>
  <para style="q2">na huhan a umnahpaw</para>
  <para style="q1">byakin thingkua rykhate</para>
  <para style="q2">na umnaw hmin kalan cciatua.</para>
  <para style="q1">
    <verse number="9" style="v" />Na ranpibawi hae nynh</para>
  <para style="q2">dingnaw boeining kha</para>
  <para style="q2">lawkuh hae sah lah,</para>
  <para style="q1">alungzipaw na ccungccaw hae nynh</para>
  <para style="q2">lungtuate sia hae sah.</para>
  <para style="q1">
    <verse number="10" style="v" />Na seepaw David kha tuate,</para>
  <para style="q2">na kya-e chitui thuh athuapaw</para>
  <para style="q1">na ccungccapaw kha vua nan.</para>
  <para style="q1">
    <verse number="11" style="v" />
    <char style="nd">Bawipaw </char> nynh David kyakhe</para>
  <para style="q2">phe atynpaw byakinkunaw kha rae zah,</para>
  <para style="q1">tuh-e byakinnaw kha roh lan khyh:</para>
  <para style="q2">“Na ccapaw hae laku e lu kheit kha</para>
  <para style="q1">na bawitungkhung vawlan ka nung cih.<note caller="-" style="x"><char style="xo" closed="false">132.11: </char><char style="xt" closed="false"><ref loc="2SA 7:12-16">2Sa 7.12-16</ref>; <ref loc="1CH 17:11-14">1Sh 17.11-14</ref>; <ref loc="PSA 89:3-4">Sam 89.3-4</ref>; <ref loc="ACT 2:30">Loc 2.30</ref></char></note></para>
  <para style="q1">
    <verse number="12" style="v" />Na ccapaw hae nynh ka byakin te</para>
  <para style="q2">ka ccangpah cih hae paw</para>
  <para style="q1">ka phunglang hae kha a zui hae ze,</para>
  <para style="q2">mih ccapaw hae nynh mah</para>
  <para style="q1">na bawitungkhung vawlan</para>
  <para style="q2">zungzae a haung cih hae,” na la ci.</para>
  <para style="q1">
    <verse number="13" style="v" />Pawccecize <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">Zion kha a po vae;</para>
  <para style="q2">tuh-e tuh a umnaw lang a ry vae.</para>
  <para style="q1">
    <verse number="14" style="v" />“E hynh zungzae</para>
  <para style="q2">ka umnaw hmin nynh thua;</para>
  <para style="q1">e hynh ka ry vae keiccuze,</para>
  <para style="q2">e kya ka um cih.</para>
  <para style="q1">
    <verse number="15" style="v" />Zion a looh kha</para>
  <para style="q2">hythuanaw patae ka pya cih;</para>
  <para style="q1">a ccungccaw ryachi hae kha</para>
  <para style="q2">looh phe byn lan ka pya cih hae.</para>
  <para style="q1">
    <verse number="16" style="v" />A ranpibawi hae kha</para>
  <para style="q2">khumnaw boeining</para>
  <para style="q2">ka lawsakuh cih hae zah,</para>
  <para style="q1">alungzipaw a ccungccaw hae nynh</para>
  <para style="q2">lungtuate a sia cih hae.</para>
  <para style="q1">
    <verse number="17" style="v" />Tuin kyakhe David ki kikheit kha</para>
  <para style="q2">ka toihsah cih; chitui thuh athuapaw</para>
  <para style="q1">ka ccungccaw hanlan maeekhua kha</para>
  <para style="q2">ka paccyn vae.<note caller="-" style="x"><char style="xo" closed="false">132.17: </char><char style="xt" closed="false"><ref loc="1KI 11:36">1Si 11.36</ref></char></note></para>
  <para style="q1">
    <verse number="18" style="v" />A rhaw hae kha thethya</para>
  <para style="q2">ka ccousah cih hae,</para>
  <para style="q1">thuasalama a bawilukhung tuh</para>
  <para style="q2">a tungvaw khe a aw cih.</para>
  <chapter number="133" style="c" />
  <para style="s1">Uno Lungngingnaw</para>
  <para style="d">Cciathungnaw Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Uno hae nynh lungngingte</para>
  <para style="q2">pynkheihlan um tuh</para>
  <para style="q1">pawcih baban mou hoy zah</para>
  <para style="q2">lungrythua lan a um!</para>
  <para style="q1">
    <verse number="2" style="v" />Tuh-e tuh Aaron lu vawlan te</para>
  <para style="q2">a khawming kalan luibung zah,</para>
  <para style="q1">a angkile nakua kyacia aluibungpaw</para>
  <para style="q2">chitui aphutepaw hawte nynh thua.</para>
  <para style="q1">
    <verse number="3" style="v" />Tuh-e tuh Hermon mua kya-e dangtui,</para>
  <para style="q2">Zion mua vawlan</para>
  <para style="q2">accahpaw hawte nynh thua.</para>
  <para style="q1">Pawccecize tuin kyatuin</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh zungzae hiinnaw,</para>
  <para style="q1">a hythuanaw kha a pya.</para>
  <chapter number="134" style="c" />
  <para style="s1">Khuazi Thehoysahnaw</para>
  <para style="d">Cciathungnaw Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> inn kya khuazi a thadyn hae paw</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> see hae balyn,</para>
  <para style="q1">rang oh lah, <char style="nd">Bawipaw </char> kha</para>
  <para style="q2">thehoysah oh!</para>
  <para style="q1">
    <verse number="2" style="v" />Athyaapaw hmin kalan khe</para>
  <para style="q2">nae kuih hang oh lah,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha thehoysah oh.</para>
  <para style="q1">
    <verse number="3" style="v" />Vaaw te lae a raetupaw <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">Zion kyate hythua ae pya vae oh sah.</para>
  <chapter number="135" style="c" />
  <para style="s1">Pachia Hoynaw Thehoysahnaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <para style="q2">Pou <char style="nd">Bawipaw </char> ryalahtu hae,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> min kha thehoysah oh;</para>
  <para style="q1">
    <verse number="2" style="v" />
    <char style="nd">Bawipaw </char> inn kya a thadyn hae paw,</para>
  <para style="q2">ah Pachia inn voidu lungkhu kya</para>
  <para style="q1">ryalah hae paw nanning,</para>
  <para style="q2">amaw kha thehoysah oh.</para>
  <para style="q1">
    <verse number="3" style="v" />
    <char style="nd">Bawipaw </char> kha thehoysah oh,</para>
  <para style="q2">pawccecize <char style="nd">Bawipaw </char> tuh ahoy;</para>
  <para style="q1">aning tuh thawccih thyapaw athua keiccuze</para>
  <para style="q2">a min thehoysahnaw hlaw kha sah oh.</para>
  <para style="q1">
    <verse number="4" style="v" />Pawccecize <char style="nd">Bawipaw </char> nynh Jakob kha</para>
  <para style="q2">amaw hanlan pokuh zah,</para>
  <para style="q1">Israel kha amaw elang a poku vae.</para>
  <para style="q1">
    <verse number="5" style="v" />
    <char style="nd">Bawipaw </char> tuh a lesaepaw nynh</para>
  <para style="q2">thua cipaw ka ny;</para>
  <para style="q1">ah Bawipaw tuh ccangpaw</para>
  <para style="q2">pachia balyn laeze a lesaehua.</para>
  <para style="q1">
    <verse number="6" style="v" />Vaaw te lae kya thuasah,</para>
  <para style="q2">rili te akhunaw balyn kya thuasah</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh a rypaw miakaw kha a cyi.</para>
  <para style="q1">
    <verse number="7" style="v" />Laephi adianaw kyate</para>
  <para style="q2">maeking kha a pousah thung;</para>
  <para style="q1">khuaaraw nawlan khozaw kha a rae;</para>
  <para style="q2">a ccakhungnaw inn kyate</para>
  <para style="q1">khivae kha a pousah.</para>
  <para style="q1">
    <verse number="8" style="v" />Izip ram e ccatawccaw te</para>
  <para style="q2">thanty kha a chia hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Pou Izip, na ngaelung a umpaw</para>
  <para style="q2">Faro te a ryalahtu hae balyn kha rawsete</para>
  <para style="q1">muihsahnaw te ngaeangnaw kha</para>
  <para style="q2">aning nynh a rae.</para>
  <para style="q1">
    <verse number="10" style="v" />Minphuin patae te athungpaw</para>
  <para style="q2">siapharan hae kha a chia hae,</para>
  <para style="q1">
    <verse number="11" style="v" />Amor hae siapharan Sihon,</para>
  <para style="q2">Bashan hae siapharan Og te</para>
  <para style="q1">Kanaan peenaw kya-e hae balyn kha</para>
  <para style="q2">theih hae zah,</para>
  <para style="q1">
    <verse number="12" style="v" />mih ram kha a ccungccaw</para>
  <para style="q2">Israel hae kalan rho lang a pya hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Pou <char style="nd">Bawipaw </char>, na min tuh zungzae atyn,</para>
  <para style="q2">Pou <char style="nd">Bawipaw </char>, na minthaannaw tuh</para>
  <para style="q2">she takyh atyn.</para>
  <para style="q1">
    <verse number="14" style="v" />Pawccecize <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">a ccungccaw hae kha</para>
  <para style="q1">pankhaete bya a piapah cih hae zah,</para>
  <para style="q2">a see hae kha ngaethya a umsah cih hae.</para>
  <para style="q1">
    <verse number="15" style="v" />Minphuin ccangpaw hae kya-e</para>
  <para style="q2">zohtuh hae tuh ccungccaw kuih te raepaw</para>
  <para style="q1">sui te ngun nynh thua hae.<note caller="-" style="x"><char style="xo" closed="false">135.15-18: </char><char style="xt" closed="false"><ref loc="PSA 115:4-8">Sam 115.4-8</ref>; <ref loc="REV 9:20">Bya 9.20</ref></char></note></para>
  <para style="q1">
    <verse number="16" style="v" />Tuh-e zohtuh hae tuh khalang</para>
  <para style="q2">a hoi hae zemah byaho khyh hae;</para>
  <para style="q1">mit a hoi hae zemah ngawmuih khyh hae;</para>
  <para style="q1">
    <verse number="17" style="v" />nakaring a hoi hae zemah</para>
  <para style="q2">nawthae khyh hae,</para>
  <para style="q2">mih khalang kya hy um khyh.</para>
  <para style="q1">
    <verse number="18" style="v" />Zohtuh a raetu hae paw te</para>
  <para style="q2">zohtuh a doliakuh hae paw balyn tuh</para>
  <para style="q1">zohtuh hae hawmawte athua cih hae.</para>
  <para style="q1">
    <verse number="19" style="v" />Pou Israel ccungccaw hae,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <para style="q1">Pou Aaron ciihan hae, <char style="nd">Bawipaw </char> kha</para>
  <para style="q2">thehoysah oh!</para>
  <para style="q1">
    <verse number="20" style="v" />Pou Levi ciihan hae,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> rawrih hae paw nanning,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <para style="q1">
    <verse number="21" style="v" />Jerusalem kya umpaw <char style="nd">Bawipaw </char> kha</para>
  <para style="q2">Zion kyate thehoysah oh.</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <chapter number="136" style="c" />
  <para style="s1">Pachia Ryalawnaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> tuh hoy zah</para>
  <para style="q2">a sungsahnaw tuh zungzae atyn keiccuze</para>
  <para style="q1">amaw kalan lungtuabya ho oh.<note caller="-" style="x"><char style="xo" closed="false">136.1: </char><char style="xt" closed="false"><ref loc="1CH 16:34">1Sh 16.34</ref>; <ref loc="2CH 5:13">2Sh 5.13</ref>, <ref loc="2CH 7:3">7.3</ref>; <ref loc="EZR 3:11">Ezr 3.11</ref>; <ref loc="PSA 100:5">Sam 100.5</ref>, <ref loc="PSA 106:1">106.1</ref>, <ref loc="PSA 107:1">107.1</ref>, <ref loc="PSA 118:1">118.1</ref>; <ref loc="JER 33:11">Jer 33.11</ref></char></note></para>
  <para style="q1">
    <verse number="2" style="v" />A sungsahnaw tuh</para>
  <para style="q2">zungzae atyn keiccuze</para>
  <para style="q1">pachia hae Pachia kalan</para>
  <para style="q2">lungtuabya ho oh.</para>
  <para style="q1">
    <verse number="3" style="v" />A sungsahnaw tuh</para>
  <para style="q2">zungzae atyn keiccuze</para>
  <para style="q1">bawipaw hae Bawipaw kalan</para>
  <para style="q2">lungtuabya ho oh.</para>
  <para style="q1">
    <verse number="4" style="v" />A sungsahnaw tuh zungzae atyn keiccuze</para>
  <para style="q2">amaw rou nynh myarya lepaw</para>
  <para style="q1">ngaeangnaw kha a rae;</para>
  <para style="q1">
    <verse number="5" style="v" />a sungsahnaw tuh zungzae atyn keiccuze</para>
  <para style="q2">a hawnaw liate vaawlui kha a rae;<note caller="-" style="x"><char style="xo" closed="false">136.5: </char><char style="xt" closed="false"><ref loc="GEN 1:1">Gen 1.1</ref></char></note></para>
  <para style="q1">
    <verse number="6" style="v" />a sungsahnaw tuh zungzae atyn keiccuze</para>
  <para style="q2">laephi kha tui vawlan khe a phae;<note caller="-" style="x"><char style="xo" closed="false">136.6: </char><char style="xt" closed="false"><ref loc="GEN 1:2">Gen 1.2</ref></char></note></para>
  <para style="q1">
    <verse number="7" style="v" />a sungsahnaw tuh zungzae atyn keiccuze</para>
  <para style="q2">myarya lepaw awnaw kha a rae;<note caller="-" style="x"><char style="xo" closed="false">136.7-9: </char><char style="xt" closed="false"><ref loc="GEN 1:16">Gen 1.16</ref></char></note></para>
  <para style="q1">
    <verse number="8" style="v" />a sungsahnaw tuh zungzae atyn keiccuze</para>
  <para style="q2">khuadae kha uk khylan khuanin kha thuasah,</para>
  <para style="q1">
    <verse number="9" style="v" />a sungsahnaw tuh</para>
  <para style="q2">zungzae atyn keiccuze khuazi kha</para>
  <para style="q2">uk khylan sawpaw te</para>
  <para style="q1">awsi hae kha thuasah a rae;</para>
  <para style="q1">
    <verse number="10" style="v" />a sungsahnaw tuh zungzae atyn keiccuze</para>
  <para style="q2">Izip ram e ccatawccaw hae kha a chia hae;<note caller="-" style="x"><char style="xo" closed="false">136.10: </char><char style="xt" closed="false"><ref loc="EXO 12:29">Exo 12.29</ref></char></note></para>
  <para style="q1">
    <verse number="11" style="v" />a sungsahnaw tuh zungzae atyn keiccuze</para>
  <para style="q2">Izip ccungccaw hae kyate</para>
  <para style="q1">Israel hae kha a poukhae hae;<note caller="-" style="x"><char style="xo" closed="false">136.11: </char><char style="xt" closed="false"><ref loc="EXO 12:51">Exo 12.51</ref></char></note></para>
  <para style="q1">
    <verse number="12" style="v" />a sungsahnaw tuh zungzae atyn keiccuze</para>
  <para style="q2">athungpaw kuih te a dyngpaw kuih liate;</para>
  <para style="q1">
    <verse number="13" style="v" />a sungsahnaw tuh zungzae atyn keiccuze</para>
  <para style="q2">Rili Se kha ccangning lang a phia;<note caller="-" style="x"><char style="xo" closed="false">136.13-15: </char><char style="xt" closed="false"><ref loc="EXO 14:21-29">Exo 14.21-29</ref></char></note></para>
  <para style="q1">
    <verse number="14" style="v" />a sungsahnaw tuh zungzae atyn keiccuze</para>
  <para style="q2">Israel hae kha rili ngaelung khe</para>
  <para style="q2">a zuasah hae;</para>
  <para style="q1">
    <verse number="15" style="v" />a sungsahnaw tuh</para>
  <para style="q2">zungzae atyn keiccuze</para>
  <para style="q1">Faro te a rhawkaw hae kha</para>
  <para style="q2">Rili Se kya pong a phung hae;</para>
  <para style="q1">
    <verse number="16" style="v" />a sungsahnaw tuh zungzae atyn keiccuze</para>
  <para style="q2">a ccungccaw hae kha laesia ram kya</para>
  <para style="q1">a cciakhae hae;</para>
  <para style="q1">
    <verse number="17" style="v" />a sungsahnaw tuh</para>
  <para style="q2">zungzae atyn keiccuze</para>
  <para style="q2">alesaepaw siapharan hae kha</para>
  <para style="q1">a chia hae;</para>
  <para style="q1">
    <verse number="18" style="v" />te a sungsahnaw tuh</para>
  <para style="q2">zungzae atyn keiccuze</para>
  <para style="q2">a minthaanpaw siapharan hae kha a chia hae;</para>
  <para style="q1">
    <verse number="19" style="v" />a sungsahnaw tuh</para>
  <para style="q2">zungzae atyn keiccuze</para>
  <para style="q2">Amor hae siapharan Sihon kha a chia;<note caller="-" style="x"><char style="xo" closed="false">136.19: </char><char style="xt" closed="false"><ref loc="NUM 21:21-30">Nam 21.21-30</ref></char></note></para>
  <para style="q1">
    <verse number="20" style="v" />te a sungsahnaw tuh</para>
  <para style="q2">zungzae atyn keiccuze</para>
  <para style="q2">Bashan hae siapharan Og kha a chia;<note caller="-" style="x"><char style="xo" closed="false">136.20: </char><char style="xt" closed="false"><ref loc="NUM 21:31-35">Nam 21.31-35</ref></char></note></para>
  <para style="q1">
    <verse number="21" style="v" />a sungsahnaw tuh</para>
  <para style="q2">zungzae atyn keiccuze</para>
  <para style="q2">mih ram kha rho lang a pya hae;</para>
  <para style="q1">
    <verse number="22" style="v" />a sungsahnaw tuh</para>
  <para style="q2">zungzae atyn keiccuze</para>
  <para style="q1">a ryalahtu Israel hae kha</para>
  <para style="q2">rho a pya hae.</para>
  <para style="q1">
    <verse number="23" style="v" />A sungsahnaw tuh</para>
  <para style="q2">zungzae atyn keiccuze</para>
  <para style="q1">aening ah nyaanaw oh kha</para>
  <para style="q2">oun liathuipya,</para>
  <para style="q1">
    <verse number="24" style="v" />te a sungsahnaw tuh</para>
  <para style="q2">zungzae atyn keiccuze</para>
  <para style="q1">ah rhaw hae kyate</para>
  <para style="q2">aening kha oun luesah;</para>
  <para style="q1">
    <verse number="25" style="v" />a sungsahnaw tuh</para>
  <para style="q2">zungzae atyn keiccuze</para>
  <para style="q1">ahysuepaw balyn kha</para>
  <para style="q2">looh a pya hae.</para>
  <para style="q1">
    <verse number="26" style="v" />Vaawram Pachia kalan</para>
  <para style="q2">lungtuabya ho oh,</para>
  <para style="q1">pawccecize a sungsahnaw tuh</para>
  <para style="q2">zungzae atyn.</para>
  <chapter number="137" style="c" />
  <para style="s1">Jerusalem A Ro keiccu Rawnaw</para>
  <para style="q1">
    <verse number="1" style="v" />Babilon vaw hae kin khe</para>
  <para style="q2">kae haung zah,</para>
  <para style="q1">Zion kha he kae liathui tuh,</para>
  <para style="q2">rawkhuite kae um.</para>
  <para style="q1">
    <verse number="2" style="v" />Kae pe umpaw su ku hae kyakhe</para>
  <para style="q2">kae tintang hae kha kae bawku.</para>
  <para style="q1">
    <verse number="3" style="v" />Pawccecize kaening oun kyngtu hae te</para>
  <para style="q2">oun tuaa oun sahtu hae nynh,</para>
  <para style="q1">“Zion hlaw hlakheit</para>
  <para style="q2">oun sahpya tua oh!” cite</para>
  <para style="q1">hlaw roi te lungtua</para>
  <para style="q2">lungpawnaw roi kha</para>
  <para style="q1">oun ngia hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Pawtemou kaening nynh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> hlaw kha</para>
  <para style="q1">ramccang kyakhe kae sah kho cih?</para>
  <para style="q1">
    <verse number="5" style="v" />Pou Jerusalem,</para>
  <para style="q2">nang kha kae ning lanze,</para>
  <para style="q2">ka ranglang kuih karae rou vae sah!</para>
  <para style="q1">
    <verse number="6" style="v" />Nang kha kae ning ze thuasah,</para>
  <para style="q2">Jerusalem kha</para>
  <para style="q1">ka lungtua huaccepaw laeze</para>
  <para style="q2">ahanghua lante</para>
  <para style="q1">ka nung khyh ze thuasah</para>
  <para style="q2">ka lae tuh ka dang kya</para>
  <para style="q1">phang beekuh sah.</para>
  <para style="q1">
    <verse number="7" style="v" />Pou <char style="nd">Bawipaw </char>, Jerusalem</para>
  <para style="q2">a law nin hae ze,</para>
  <para style="q1">“Marya roh oh! Marya roh oh!</para>
  <para style="q2">Aleihpaw cia phe roh oh!” cite</para>
  <para style="q1">a hokuh hae paw Edom hae kha</para>
  <para style="q2">liathui hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Pou ccanung Babilon,</para>
  <para style="q2">a rosathyapaw nang!</para>
  <para style="q1">Kae tungvaw nae cyi thyhte,</para>
  <para style="q2">nang ae cyihru paw tuh</para>
  <para style="q2">lungtuapaw athua cih!<note caller="-" style="x"><char style="xo" closed="false">137.8: </char><char style="xt" closed="false"><ref loc="REV 18:6">Bya 18.6</ref></char></note></para>
  <para style="q1">
    <verse number="9" style="v" />Na ccaaw hae kha lah hae zah,</para>
  <para style="q2">lung vawlan a zianahpaw tuh</para>
  <para style="q1">lungtuapaw athua cih!</para>
  <chapter number="138" style="c" />
  <para style="s1">Lungtuanaw te Thehoysahnaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, ka thinlung balyn te kae luung;</para>
  <para style="q2">ccangpaw pachia hae malang khe</para>
  <para style="q1">nang thehoysahnaw hlaw kha ka sah;</para>
  <para style="q1">
    <verse number="2" style="v" />athyaapaw na beikinn kalan hawite</para>
  <para style="q2">ka bakhung zah,</para>
  <para style="q2">na min kha kae thehoysah;</para>
  <para style="q1">pawccecize na sungsahnaw tuh</para>
  <para style="q2">tyn zah na lungzi;</para>
  <para style="q1">na min te na bya kha pawpaw balyn laeze</para>
  <para style="q2">na hangthung vae.</para>
  <para style="q1">
    <verse number="3" style="v" />Kae ko nin vae ze, nae thaepah zah,</para>
  <para style="q2">ka muisaw thawzung kha nae saesah.</para>
  <para style="q1">
    <verse number="4" style="v" />Pou <char style="nd">Bawipaw </char>, laephi siapharan balyn nynh</para>
  <para style="q2">ae thehoysah cih hae,</para>
  <para style="q1">pawccecize na khalang kya-e bya kha</para>
  <para style="q2">a thae vae hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Minmin nynh <char style="nd">Bawipaw </char></para>
  <para style="q2">ryalawnaw kong kha</para>
  <para style="q1">hlaw te a sah cih hae,</para>
  <para style="q2">pawccecize <char style="nd">Bawipaw </char> huhan tuh alesae.</para>
  <para style="q1">
    <verse number="6" style="v" />
    <char style="nd">Bawipaw </char> tuh ahangpaw athua zemah</para>
  <para style="q2">a nyaa hae paw kha a peki hae;</para>
  <para style="q1">thuasalama a lysakuh hae paw kha</para>
  <para style="q2">asawnaw kyate phe a muih hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Vawsawnaw laku kya ka ccia zemah,</para>
  <para style="q2">ka rhaw hae thinrianaw kyate</para>
  <para style="q1">nae thungkhaw;</para>
  <para style="q2">na kuih kha na dyng zah,</para>
  <para style="q1">na ranglang kuih nynh</para>
  <para style="q2">kae kha yn luesah.</para>
  <para style="q1">
    <verse number="8" style="v" />
    <char style="nd">Bawipaw </char> nynh ka hanlan</para>
  <para style="q2">a paccynpaw kha a ccingsah cih.</para>
  <para style="q2">Pou <char style="nd">Bawipaw </char>, atynpaw</para>
  <para style="q1">na sungsahnaw tuh zungzae atyn.</para>
  <para style="q2">Na kuih ryalawnaw kha vua nan.</para>
  <chapter number="139" style="c" />
  <para style="s1">Pachia nynh Marya A Ny</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, akaw-aleih</para>
  <para style="q2">nae do mamia zah nae ny vae.</para>
  <para style="q1">
    <verse number="2" style="v" />Ka haung ze thuasah,</para>
  <para style="q2">ka thoku ze thuasah phe nae ny;</para>
  <para style="q2">ka tuanaw kha asawnaw kyate phe na ny.</para>
  <para style="q1">
    <verse number="3" style="v" />Ka ccianaw laanpi te ka inaw kha</para>
  <para style="q2">akaw-aleih phe na muih zah,</para>
  <para style="q2">ka cyisahnaw balyn kha marya na ny.</para>
  <para style="q1">
    <verse number="4" style="v" />Bya kaw kheit san ka ho mawze,</para>
  <para style="q2">pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">ka ho lanpaw kha khaleih na ny.</para>
  <para style="q1">
    <verse number="5" style="v" />Ka nulang ka malang te nae voilu zah,</para>
  <para style="q2">na kuih kha ka tungvaw na khang.</para>
  <para style="q1">
    <verse number="6" style="v" />Tuhcihawpaw hawnaw tuh ka hanlan</para>
  <para style="q2">myaryasankae ngaeangthua lan a um;</para>
  <para style="q1">tuh-e tuh myarya hang zah</para>
  <para style="q2">ka phah kho khyh.</para>
  <para style="q1">
    <verse number="7" style="v" />Na muisaw kyate lue khylan</para>
  <para style="q2">teilangmou ka cceih kho cih?</para>
  <para style="q1">Na umnaw kyate</para>
  <para style="q2">teilangmou ka ccue kho cih?</para>
  <para style="q1">
    <verse number="8" style="v" />Vaawram lang ka kae ze,</para>
  <para style="q2">nang tuh tuin kya na um.</para>
  <para style="q1">Michi khua kya inaw ka raeku ze,</para>
  <para style="q2">nang tuh tuin kya na um.</para>
  <para style="q1">
    <verse number="9" style="v" />Awkhua khuanin thuanaw</para>
  <para style="q2">nithua lang phe dianaw cia ka zou zah,</para>
  <para style="q1">niccaw lang e rili athangnaw kyakhe</para>
  <para style="q2">ka la um lanze,</para>
  <para style="q1">
    <verse number="10" style="v" />tuin kya heize na kuih nynh</para>
  <para style="q2">yn cciakhae cih zah</para>
  <para style="q1">na ranglang kuih nynh</para>
  <para style="q2">tynkaring lan yn kyng cih.</para>
  <para style="q1">
    <verse number="11" style="v" />“Thanccingte mohnaw nynh</para>
  <para style="q2">kae kha yn bong cih zah,</para>
  <para style="q1">ka pepan umpaw awnaw tuh</para>
  <para style="q2">khuazi lang a tang cih,” cite ka ho lanze,</para>
  <para style="q1">
    <verse number="12" style="v" />mohnaw kha heize</para>
  <para style="q2">nang na hanlan tuh moh khyh;</para>
  <para style="q1">nang na hanlan mohnaw tuh</para>
  <para style="q2">awnaw te aloku keiccuze</para>
  <para style="q1">khuazi tuh khuadae hawte a aw.</para>
  <para style="q1">
    <verse number="13" style="v" />Ka lungkhu e miakaw yn raetupaw tuh</para>
  <para style="q2">nang nynh na thua;</para>
  <para style="q2">ka nung vue lungkhu khe nae rae,</para>
  <para style="q1">
    <verse number="14" style="v" />Ngaeangthua lante ri lan a um lante</para>
  <para style="q2">nae rae keiccuze kae thehoysah.</para>
  <para style="q2">Na ryalaw balyn tuh ngaeangthua lan</para>
  <para style="q1">a um cipaw hoyte ka ny.</para>
  <para style="q2">
    <verse number="15" style="v" />Kae kha alangku leinaw khe nae rae zah,</para>
  <para style="q2">laephi akhunaw kyakhe</para>
  <para style="q1">ccynmamyh lante he nae rae tuh,</para>
  <para style="q2">ka pyn tuh namaw kyate thuruh thua khyh.</para>
  <para style="q1">
    <verse number="16" style="v" />Accing loh leipaw</para>
  <para style="q2">ka pyn kha phe na muih.</para>
  <para style="q1">Tuh-e hae ccangkheit san a um mawkhe,</para>
  <para style="q2">ka hanlan na raepaw nin hae balyn kha</para>
  <para style="q2">na ccauh kya zei athua vae.</para>
  <para style="q1">
    <verse number="17" style="v" />Pou Pachia, na tuanaw tuh</para>
  <para style="q2">ka hanlan pawcih baban mou akhincci!</para>
  <para style="q1">Tuh-e na tuanaw balyn tuh</para>
  <para style="q2">pawcih baban mou ako!</para>
  <para style="q1">
    <verse number="18" style="v" />Ria lan ka citua zah, laesia laeze</para>
  <para style="q2">alunghua; he ka thaekuh tuh,</para>
  <para style="q1">namaw kya mamin nynh ka um.</para>
  <para style="q1">
    <verse number="19" style="v" />Pou Pachia, ccungccaw hoylei hae paw kha</para>
  <para style="q2">theih hae lah,</para>
  <para style="q1">ccungccaw chia a mang hae paw tuh</para>
  <para style="q2">ka kyate pou hae sah,</para>
  <para style="q1">
    <verse number="20" style="v" />minmin nynh na konglang kha</para>
  <para style="q2">ahoy lei lante ho hae zah,</para>
  <para style="q1">hoyleinaw hanlan nang kha</para>
  <para style="q2">rawsete mimaw te mimaw</para>
  <para style="q2">a hangsahku hae.</para>
  <para style="q1">
    <verse number="21" style="v" />Pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">nang ae hua hae paw kha</para>
  <para style="q1">ka hua khyh hae tou?</para>
  <para style="q2">Nang ae dou hae paw kha</para>
  <para style="q1">a nungsikuh hae paw lang</para>
  <para style="q2">ka ria khyh hae tou?</para>
  <para style="q1">
    <verse number="22" style="v" />Minmin kha ka thinlung balyn te</para>
  <para style="q2">ka hua hae zah,</para>
  <para style="q2">ka rhaw hae lang ka ria hae.</para>
  <para style="q1">
    <verse number="23" style="v" />Pou Pachia, akaw-aleih yn do mamia lah,</para>
  <para style="q2">ka thinlung kha nytua;</para>
  <para style="q1">yn syntawtua lah,</para>
  <para style="q2">ka tuanaw kha nytua.</para>
  <para style="q1">
    <verse number="24" style="v" />Ka lungkhu kya hoyleinaw</para>
  <para style="q2">a um tou um khyh tou</para>
  <para style="q1">cipaw yn do lah,</para>
  <para style="q2">zungzae tynpaw laanpi kya</para>
  <para style="q1">yn cciakhae tua.</para>
  <chapter number="140" style="c" />
  <para style="s1">Luenaw hanlan Sawsangnaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, hoyleinaw</para>
  <para style="q2">a rae hae paw kyate</para>
  <para style="q1">beih yn luesah;</para>
  <para style="q2">a puatho hae paw kyate</para>
  <para style="q2">yn thungkhawtua,</para>
  <para style="q1">
    <verse number="2" style="v" />mih thinlung kya</para>
  <para style="q2">ahoy leipaw kha paccyn hae zah</para>
  <para style="q1">rhawtuknaw kha</para>
  <para style="q2">palei a puisah hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Mih lae kha hupaw lae hawte</para>
  <para style="q2">hesah hae zah,</para>
  <para style="q1">mih munglae kyakhe</para>
  <para style="q2">huparepaw sy a um.<note caller="-" style="x"><char style="xo" closed="false">140.3: </char><char style="xt" closed="false"><ref loc="ROM 3:13">Rom 3.13</ref></char></note></para>
  <para style="q1">
    <verse number="4" style="v" />Pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">ccungccaw hoylei hae paw kyate</para>
  <para style="q1">phang yn rintua;</para>
  <para style="q2">kae kha khulia khylan</para>
  <para style="q1">yn paccynnuakuh hae paw,</para>
  <para style="q2">a puatho hae paw kyate</para>
  <para style="q2">yn thungkhawtua.</para>
  <para style="q1">
    <verse number="5" style="v" />A lysakuh hae paw nynh</para>
  <para style="q2">kaang yn syakhaw hae,</para>
  <para style="q1">arui khate miaa kha</para>
  <para style="q2">yn zokhaw hae zah,</para>
  <para style="q1">laanpi kyakhe</para>
  <para style="q2">kaang po yn syakhaw hae.</para>
  <para style="q1">
    <verse number="6" style="v" />
    <char style="nd">Bawipaw </char> kalan khe,</para>
  <para style="q2">“Nang tuh ka Pachia nynh na thua;</para>
  <para style="q1">Pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">kae ngianaw roi hynh</para>
  <para style="q2">yn thaepya tua,” cite ka hopya.</para>
  <para style="q1">
    <verse number="7" style="v" />Pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">a thungpaw yn luesahtu ka Bawipaw,</para>
  <para style="q1">rhawtuk nin khe</para>
  <para style="q2">ka lu kha nae bong vae.</para>
  <para style="q1">
    <verse number="8" style="v" />Pou <char style="nd">Bawipaw </char>, ccungccaw hoylei</para>
  <para style="q2">hae paw rynaw kha</para>
  <para style="q1">ua nan hae; ahoy leipaw</para>
  <para style="q2">mih paccynkunaw kha</para>
  <para style="q1">ccingsahpah nan hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Kae yn koihlu hae paw nynh</para>
  <para style="q2">mih lu kha a hangthung hae;</para>
  <para style="q1">mih munglae a hoyleinaw kha nynh</para>
  <para style="q2">mimaw kha phang bong hae sah!</para>
  <para style="q1">
    <verse number="10" style="v" />Zaezae epaw maee-e nynh</para>
  <para style="q2">mih tungvaw ccawphu hae sah!</para>
  <para style="q1">hunghua lungkhu langkhe,</para>
  <para style="q2">pou kho lei lante</para>
  <para style="q2">ccaring vua thua hae sah!</para>
  <para style="q1">
    <verse number="11" style="v" />Mihyn hae kha ram lungkhu kya</para>
  <para style="q2">tynsah nan hae;</para>
  <para style="q1">hoyleinaw nynh a puatho hae paw kha</para>
  <para style="q2">arangte roh hae sah!</para>
  <para style="q1">
    <verse number="12" style="v" />
    <char style="nd">Bawipaw </char> nynh a hoboupaw kha</para>
  <para style="q2">pankhaw zah, a ryachipaw hanlan</para>
  <para style="q1">hmerarih lan a cyipya cipaw kha ka ny.</para>
  <para style="q1">
    <verse number="13" style="v" />Miding hae nynh na min kha</para>
  <para style="q2">ae thehoysah ccaccing cih hae;</para>
  <para style="q1">miding tuh na umnaw kyakhe a um cih.</para>
  <chapter number="141" style="c" />
  <para style="s1">Khyn khylan Sawsangnaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, nang kha kae ko;</para>
  <para style="q2">arangte yn thuanua tua;</para>
  <para style="q1">nang kha he kae ko ze,</para>
  <para style="q2">ka roi kha yn ngaepya tua.</para>
  <para style="q1">
    <verse number="2" style="v" />Ka sawsangnaw hynh na malang</para>
  <para style="q2">mynkhuhpaw lante yn ccoupah lah,</para>
  <para style="q1">ka kuih ka hangthungpaw hynh</para>
  <para style="q2">zete silawnaw lante yn ccoupya tua.<note caller="-" style="x"><char style="xo" closed="false">141.2: </char><char style="xt" closed="false"><ref loc="REV 5:8">Bya 5.8</ref></char></note></para>
  <para style="q1">
    <verse number="3" style="v" />Pou <char style="nd">Bawipaw </char>, ka khalang kya</para>
  <para style="q2">rhawviatu yn nungpah lah,</para>
  <para style="q1">ka mung thuakaw kya yn ngawpya tua.</para>
  <para style="q1">
    <verse number="4" style="v" />Hoyleinaw a rae hae paw ryte mungkute</para>
  <para style="q2">ahoy leipaw cyisahnaw kya ciaakute,</para>
  <para style="q1">ka thinlung hynh ahoy leipaw kalan</para>
  <para style="q2">yn maeleih nan;</para>
  <para style="q1">mih aepaw athuapaw kha</para>
  <para style="q2">yn aesah bua nan.</para>
  <para style="q1">
    <verse number="5" style="v" />Miding hae nynh yn zia hae sah lah,</para>
  <para style="q2">mih lungzi hae paw nynh</para>
  <para style="q1">yn thuihei hae sah.</para>
  <para style="q2">Ccungccaw hoylei hae paw chitui kha</para>
  <para style="q1">ka lu kya papin yn thuh nan hae sah,</para>
  <para style="q2">pawccecize ka sawsangnaw nynh</para>
  <para style="q1">ahoy leipaw mih cyisahnaw kha po a rawse.</para>
  <para style="q1">
    <verse number="6" style="v" />Minmin tungvaw</para>
  <para style="q2">seibe cih hae paw kalan khe</para>
  <para style="q2">minmin kha pya he a thua hae te,</para>
  <para style="q1">ka bya hynh lungrythua lan a um</para>
  <para style="q2">cipaw a nyh cih hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Zoihtatae lan a koi hae paw lung tuh</para>
  <para style="q2">laephi kya kaheikalah a pazaeku hawte,</para>
  <para style="q1">mih ru tuh Michi khua thuakaw kyakhe</para>
  <para style="q2">kaheikalah pazaekuh sah.</para>
  <para style="q1">
    <verse number="8" style="v" />Thuasalama pou PACHIA, ka Bawipaw,</para>
  <para style="q2">ka mit nynh namaw kalan khe a do;</para>
  <para style="q1">namaw kya khynnaw kha ka ccungku;</para>
  <para style="q2">thungkhaw lei lante yn cciataw nan.</para>
  <para style="q1">
    <verse number="9" style="v" />Yn syakhaw hae paw kaang kyate thuasah,</para>
  <para style="q2">hoyleinaw a raetu hae</para>
  <para style="q2">kaang kyate yn luesah.</para>
  <para style="q1">
    <verse number="10" style="v" />Ka makhae kyalya te ka lue lyakhe,</para>
  <para style="q2">ccungccaw hoylei hae paw tuh</para>
  <para style="q1">mimaw kaang kya kae hae sah.</para>
  <chapter number="142" style="c" />
  <para style="s1">
    <note caller="-" style="x">
      <char style="xo" closed="false">142 Abyalu: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 22:1">1Sa 22.1</ref>, <ref loc="1SA 24:3">24.3</ref></char>
    </note> Lue khylan Sawsangnaw<note caller="+" style="f"><char style="fr" closed="false">142 Abyalu: </char><char style="ft" closed="false">David lungkarung lungkhu a um lya a sawsangnaw.</char></note></para>
  <para style="d">David Sawsangnaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> kalan ka roisawte ka sia;</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kalan ka roisawte ka ngia.</para>
  <para style="q1">
    <verse number="2" style="v" />Ka lungccing leinaw kha</para>
  <para style="q2">amaw malang ka thuakhae;</para>
  <para style="q1">ka vawsawnaw kha</para>
  <para style="q2">amaw malang ka hopya.</para>
  <para style="q1">
    <verse number="3" style="v" />Ka muisaw tuh a lungthaw he azya ze,</para>
  <para style="q2">ka ccianaw laanpi kha phe na ny.</para>
  <para style="q1">Ka ccianaw laanpi kyakhe</para>
  <para style="q2">kaang yn syakhaw vae hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Ka ranglang khe he ka do tuh,</para>
  <para style="q2">kae yn nyhpaw lu kheit san um khyh;</para>
  <para style="q1">ka hanlan khynnaw um vae khyh;</para>
  <para style="q2">humhung nynh mah kae kha</para>
  <para style="q1">yn oihsah vae khyh.</para>
  <para style="q1">
    <verse number="5" style="v" />Pou <char style="nd">Bawipaw </char>, na kalan ka sia zah,</para>
  <para style="q2">“Nang tuh ka khynnaw nynh na thua,</para>
  <para style="q1">a hiin hae paw ram kyaze nang tuh</para>
  <para style="q2">ka hanpaw nynh na thua,” ka cipya.</para>
  <para style="q1">
    <verse number="6" style="v" />Myarya nyaa lan zakawsangsah</para>
  <para style="q2">ka thua keiccuze</para>
  <para style="q1">ka siapaw hynh yn ngaepya tua.</para>
  <para style="q1">Yn tuaa yn sah hae paw kyate yn khumtua,</para>
  <para style="q2">pawccecize minmin tuh</para>
  <para style="q2">kamaw laeze myarya mih thawsae.</para>
  <para style="q1">
    <verse number="7" style="v" />Na min kha the ka hoysah kho nawlan,</para>
  <para style="q2">thong kyate beih yn pousah.</para>
  <para style="q1">Ka tungvaw myarya na hoy keiccuze</para>
  <para style="q2">miding hae nynh kae kha</para>
  <para style="q1">yn koihlu cih hae.</para>
  <chapter number="143" style="c" />
  <para style="s1">Luenaw hanlan Sawsangnaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou <char style="nd">Bawipaw </char>, ka sawsangnaw hynh</para>
  <para style="q2">yn thaepah lah, na lungzi keiccuze</para>
  <para style="q1">kae ngianaw hynh beih yn ngaepya tua;</para>
  <para style="q2">na dingnaw liate beih yn leihtua.</para>
  <para style="q1">
    <verse number="2" style="v" />Na ryalahtupaw kae hynh bya yn pia nan,</para>
  <para style="q2">pawccecize ahiinpaw hum sanmah</para>
  <para style="q1">na malang adingpaw um khyh.<note caller="-" style="x"><char style="xo" closed="false">143.2: </char><char style="xt" closed="false"><ref loc="ROM 3:20">Rom 3.20</ref>; <ref loc="GAL 2:16">Gal 2.16</ref></char></note></para>
  <para style="q1">
    <verse number="3" style="v" />Rhaw nynh kae kha deehuite</para>
  <para style="q2">ka hiinnaw kha laephi kya yn roh zah,</para>
  <para style="q1">langmawlya a chih vae hae paw hawte</para>
  <para style="q2">mohnaw kya yn nung.</para>
  <para style="q1">
    <verse number="4" style="v" />Tukeiccuze ka muisaw tuh</para>
  <para style="q2">ka lungkhu kya a lungthawzya;</para>
  <para style="q1">ka thinlung tuh</para>
  <para style="q2">ka lungkhu kya a siikuh.</para>
  <para style="q1">
    <verse number="5" style="v" />Alia vae paw ccyh kha ka liathui,</para>
  <para style="q2">na cyipaw balyn kha ka tua zah,</para>
  <para style="q1">na kuih te na cyipaw kha</para>
  <para style="q2">hoyte ka tua.</para>
  <para style="q1">
    <verse number="6" style="v" />Na kalan ka kuih kha ka dyng;</para>
  <para style="q2">ramrou hawte ka muisaw nynh</para>
  <para style="q1">nang kha tui lang ae haw.</para>
  <para style="q1">
    <verse number="7" style="v" />Pou <char style="nd">Bawipaw </char>, arangte beih yn leihtua,</para>
  <para style="q2">ka lungroh vae.</para>
  <para style="q1">Na mitmae yn retawkuh nan,</para>
  <para style="q2">tuhkhyhze tuh Hunghuapi lungkhu lang</para>
  <para style="q1">a rungbung hae paw hawte</para>
  <para style="q2">ka thua vae cih.</para>
  <para style="q1">
    <verse number="8" style="v" />Nang kha kae doliaku keiccuze</para>
  <para style="q2">atynpaw na sungsahnaw roi kha</para>
  <para style="q1">awkhua ccyh kya beih yn thaesah.</para>
  <para style="q2">ka sawsangnaw tuh namaw kalan</para>
  <para style="q1">a kaethung keiccuze</para>
  <para style="q2">ka zui lanpaw laanpi kha</para>
  <para style="q1">yn ccangpya tua.</para>
  <para style="q1">
    <verse number="9" style="v" />Pou <char style="nd">Bawipaw </char>, ka rhaw hae kyate</para>
  <para style="q2">beih yn khumtua;</para>
  <para style="q2">khyn khylan na kalan kae ccue vae.</para>
  <para style="q1">
    <verse number="10" style="v" />Nang tuh ka Pachia na thua keiccuze</para>
  <para style="q2">na rypaw kha cyi lan</para>
  <para style="q2">yn ccangpya tua.</para>
  <para style="q1">Na muisaw hoypaw nynh</para>
  <para style="q2">laan dingpaw kya</para>
  <para style="q1">yn cciakhae vae sah.</para>
  <para style="q1">
    <verse number="11" style="v" />Pou <char style="nd">Bawipaw </char>, na min hanlan</para>
  <para style="q2">ka hiinnaw hynh yn khynsah tua.</para>
  <para style="q1">Na dingnaw liate vawsawnaw kyate</para>
  <para style="q2">poh yn thuaatua.</para>
  <para style="q1">
    <verse number="12" style="v" />Atynpaw na sungsahnaw liate</para>
  <para style="q2">ka rhaw hae kha na theih hae zah,</para>
  <para style="q1">kae yn rawse hae paw balyn kha na ro hae,</para>
  <para style="q2">pawccecize kae tuh</para>
  <para style="q1">na ryalahtu nynh ka thua.</para>
  <chapter number="144" style="c" />
  <para style="s1">Minphuin hanlan Sawsangnaw</para>
  <para style="d">David Hlaw</para>
  <para style="q1">
    <verse number="1" style="v" />Ka lungpi athuapaw <char style="nd">Bawipaw </char> tuh</para>
  <para style="q2">thehoyte um sah,</para>
  <para style="q1">aning nynh rhawtuk nawlan ka kuih kha</para>
  <para style="q2">ccangpah zah, rhawdou nawlan</para>
  <para style="q1">ka kuihdung kha a ccangpya.</para>
  <para style="q1">
    <verse number="2" style="v" />Aning tuh ka lungpi,</para>
  <para style="q2">ka rhawlungrua,</para>
  <para style="q1">ka khynnaw te yn luesahtu,</para>
  <para style="q2">ka khawriaphua,</para>
  <para style="q1">ka khynnawpaw,</para>
  <para style="q2">minphuin ccangpaw hae kha</para>
  <para style="q1">ka zakaw a sangsahtupaw nynh thua.</para>
  <para style="q1">
    <verse number="3" style="v" />Pou <char style="nd">Bawipaw </char>, ccungccaw hynh</para>
  <para style="q2">paw athua keiccu mou na peki?</para>
  <para style="q1">ccungccaw hynh paw</para>
  <para style="q2">athua keiccu mou na tua?<note caller="-" style="x"><char style="xo" closed="false">144.3: </char><char style="xt" closed="false"><ref loc="JOB 7:17-18">Job 7.17-18</ref>; <ref loc="PSA 8:4">Sam 8.4</ref></char></note></para>
  <para style="q1">
    <verse number="4" style="v" />Ccungccaw hynh</para>
  <para style="q2">vaekheit suepaw hy te nynh aloku;</para>
  <para style="q1">ccungccaw ccyh tuh</para>
  <para style="q2">azothyapaw mynlyh te nynh aloku.</para>
  <para style="q1">
    <verse number="5" style="v" />Pou <char style="nd">Bawipaw </char>, vaawlui kha poh hung lah,</para>
  <para style="q2">yn rungbung tua;</para>
  <para style="q2">mua hae kha ty hae lah,</para>
  <para style="q2">maeekhuh apou cih.</para>
  <para style="q1">
    <verse number="6" style="v" />Khozaw kha laesakuh lah,</para>
  <para style="q2">rhaw hae kha kaheikalah phiasakuh hae;</para>
  <para style="q1">na the kha kaw lah, minmin kha roh hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Ahangnaw kyate na kuih kha dyng lah,</para>
  <para style="q2">akhupaw tui kyate thuasah,</para>
  <para style="q1">ramccang hae kuih kyate thuasah</para>
  <para style="q2">yn luesah lah, yn khumtua,</para>
  <para style="q1">
    <verse number="8" style="v" />mih khalang nynh hynbya ho zah,</para>
  <para style="q2">mih ranglang kuih tuh</para>
  <para style="q2">ahme leipaw nynh thua.</para>
  <para style="q1">
    <verse number="9" style="v" />Pou Pachia, na kalan</para>
  <para style="q2">hlaw thawpaw kha ka sah cih;</para>
  <para style="q1">arui ruihaw umpaw tintang kha</para>
  <para style="q2">kae khuapah cih.</para>
  <para style="q1">
    <verse number="10" style="v" />Siapharan hae kha taenaw na pya hae zah,</para>
  <para style="q2">na ryalahtu David kha na luesah.</para>
  <para style="q1">
    <verse number="11" style="v" />A rysawthahpaw thaloi rhaw kyate</para>
  <para style="q2">kae kha nae khum zah,</para>
  <para style="q1">ramccang hae kuih kyate nae luesah,</para>
  <para style="q2">mih khalang nynh hynbya kha ho zah,</para>
  <para style="q1">mih ranglang kuih tuh</para>
  <para style="q2">ahme leipaw nynh thua.</para>
  <para style="q1">
    <verse number="12" style="v" />Kae ccapaw hae tuh</para>
  <para style="q2">mino athua lya hae khe,</para>
  <para style="q2">myarya hoy lan alepaw</para>
  <para style="q1">thingku hawte thua hae sah lah,</para>
  <para style="q2">kae ccanung hae tuh</para>
  <para style="q2">siapharan inn sak nawlan</para>
  <para style="q1">a aw hae paw apaki lang e</para>
  <para style="q2">tungpi hawte thua vae hae sah.</para>
  <para style="q1">
    <verse number="13" style="v" />Kae ccung-inn hae tuh</para>
  <para style="q2">looh aphuinphuin te</para>
  <para style="q2">phe beih sah;</para>
  <para style="q1">kae tuu hae tuh kae loram kya</para>
  <para style="q2">athong-asan te pungthung hae sah,</para>
  <para style="q1">
    <verse number="14" style="v" />kae vaetua hae mah</para>
  <para style="q2">ataw patae than hae sah.</para>
  <para style="q1">khualungrua vikute</para>
  <para style="q2">teenuakunaw um nan sah lah,</para>
  <para style="q1">ramccang lang deekunaw um nan sah,</para>
  <para style="q2">khua lungkhu e laanpi hae kya</para>
  <para style="q1">lungriathaete siaruanaw um nan sah.</para>
  <para style="q1">
    <verse number="15" style="v" />Tuhcihawpaw hythuanaw a umnaw</para>
  <para style="q2">ccungccaw hae tuh</para>
  <para style="q1">lungtua hae paw nynh thua;</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> tuh mih Pachia athuapaw</para>
  <para style="q1">ccungccaw hae tuh</para>
  <para style="q2">lungtua hae paw nynh thua.</para>
  <chapter number="145" style="c" />
  <para style="s1">Pachia Lesaenaw te Hoynaw<note caller="+" style="f"><char style="fr" closed="false">145 Abyalu: </char><char style="ft" closed="false">David nynh the a hoysahnawpaw hlaw</char></note></para>
  <para style="q1">
    <verse number="1" style="v" />Ka Pachia te ka Siapharan,</para>
  <para style="q2">nang kha kae thehoysah,</para>
  <para style="q1">na min kha zungzae te zungzae cia</para>
  <para style="q2">kae thehoysah cih.</para>
  <para style="q1">
    <verse number="2" style="v" />Nin takyh kae thehoysah cih zah,</para>
  <para style="q2">na min kha zungzae te zungzae cia</para>
  <para style="q2">kae thehoysah cih.</para>
  <para style="q1">
    <verse number="3" style="v" />
    <char style="nd">Bawipaw </char> tuh lesae zah,</para>
  <para style="q2">myaryamaw thehoysah lanpaw nynh thua;</para>
  <para style="q1">a lesaenaw tuh marya ny kho um khyh.</para>
  <para style="q1">
    <verse number="4" style="v" />Na ryalaw hae kha</para>
  <para style="q2">she kheit koute she kheit</para>
  <para style="q2">a thehoysah cih hae zah,</para>
  <para style="q1">ngaeangthua lan umpaw</para>
  <para style="q2">na cyipaw kha a siakhae cih hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Na phu-e lesaenaw te</para>
  <para style="q2">ngaeangthua lan umpaw</para>
  <para style="q1">na ryalaw hae kha</para>
  <para style="q2">hoyte ka tua cih.</para>
  <para style="q1">
    <verse number="6" style="v" />Ri lan umpaw na cyipaw huhan kha</para>
  <para style="q2">a siakhae cih hae zah,</para>
  <para style="q1">na lesaenaw kong kha</para>
  <para style="q2">ka hopah cih hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Myarya lepaw na hoynaw kong kha</para>
  <para style="q2">a ho cih hae zah,</para>
  <para style="q1">na dingnaw kong kha</para>
  <para style="q2">myarya ccae lan hlaw te</para>
  <para style="q1">a sah cih hae.</para>
  <para style="q1">
    <verse number="8" style="v" />
    <char style="nd">Bawipaw </char> tuh thawccih thyapaw,</para>
  <para style="q2">ngaethyaumsah thyapaw,</para>
  <para style="q1">a lungsaepaw thua zah,</para>
  <para style="q2">atynpaw sungsahnaw te</para>
  <para style="q2">phe beihpaw nynh thua.</para>
  <para style="q1">
    <verse number="9" style="v" />
    <char style="nd">Bawipaw </char> tuh</para>
  <para style="q2">ccungccaw hae balyn tungvaw hoy zah,</para>
  <para style="q1">a raepaw balyn tungvaw kya</para>
  <para style="q2">thawccinaw a hoi.</para>
  <para style="q1">
    <verse number="10" style="v" />Pou <char style="nd">Bawipaw </char>, na raepaw balyn nynh</para>
  <para style="q2">nang kha ae thehoysah cih hae zah,</para>
  <para style="q1">alungzipaw na ccungccaw hae balyn nynh</para>
  <para style="q2">ae thehoysah cih hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Minmin nynh na peenaw a phu-enaw te</para>
  <para style="q2">na huhan kong kha a ho cih hae,</para>
  <para style="q1">
    <verse number="12" style="v" />tetuh ccungccaw hae balyn nynh</para>
  <para style="q2">ngaeangthua lan umpaw na cyipaw te</para>
  <para style="q1">na peenaw huhan</para>
  <para style="q2">aphu-epaw kha a nyh cih hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Na peenaw tuh zungzae tynpaw</para>
  <para style="q2">peenaw thua zah,</para>
  <para style="q1">na uknaw tuh she takyh atyn.</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> tuh a hopaw</para>
  <para style="q2">bya balyn kya a lungzi zah,</para>
  <para style="q1">a cyipaw balyn kya thawccinaw a hoi.</para>
  <para style="q1">
    <verse number="14" style="v" />
    <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">a khuliakuh hae paw balyn kha</para>
  <para style="q1">bawm hae zah, a nyaasah hae paw balyn kha</para>
  <para style="q2">a hangthung hae.</para>
  <para style="q1">
    <verse number="15" style="v" />Ahiinpaw ahysuepaw balyn nynh</para>
  <para style="q2">ngaehoinaw te nang kha ae do hae zah,</para>
  <para style="q1">accyh azaw te mih looh kha na pya hae.</para>
  <para style="q1">
    <verse number="16" style="v" />Na kuih kha na daw zah,</para>
  <para style="q2">ahiinpaw ahysuepaw miakaw</para>
  <para style="q2">mih rynaw kha na ccingsahpya hae.</para>
  <para style="q1">
    <verse number="17" style="v" />
    <char style="nd">Bawipaw </char> tuh a ryalaw miakaw kya</para>
  <para style="q2">adingpaw thua zah,</para>
  <para style="q2">a cyipaw balyn kya thawccinaw a hoi.</para>
  <para style="q1">
    <verse number="18" style="v" />
    <char style="nd">Bawipaw </char> tuh amaw a ko hae paw balyn,</para>
  <para style="q2">byaccing te a ko hae paw</para>
  <para style="q2">balyn pe khe a um.</para>
  <para style="q1">
    <verse number="19" style="v" />Amaw raw a rih hae paw balyn rynaw kha</para>
  <para style="q2">a ccingsahpya hae;</para>
  <para style="q1">mih siaruanaw kha mah</para>
  <para style="q2">thaepah hae zah a khum hae.</para>
  <para style="q1">
    <verse number="20" style="v" />
    <char style="nd">Bawipaw </char> nynh amaw</para>
  <para style="q2">a sungsah hae paw balyn kha a rin hae,</para>
  <para style="q1">thuasalama ccungccaw hoy leipaw</para>
  <para style="q2">balyn kha a ro hae.</para>
  <para style="q1">
    <verse number="21" style="v" />Ka khalang nynh <char style="nd">Bawipaw </char></para>
  <para style="q2">thehoysahnaw bya kha a ho cih zah,</para>
  <para style="q1">ccungccaw hae balyn nynh</para>
  <para style="q2">a min thyaapaw kha</para>
  <para style="q1">zungzae te zungzae cia</para>
  <para style="q2">a thehoysah cih hae.</para>
  <chapter number="146" style="c" />
  <para style="s1">Pachia Bawmnaw Thehoysah</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <para style="q2">Pou ka muisaw,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha thehoysah!</para>
  <para style="q1">
    <verse number="2" style="v" />Ka hiin lungkhu balyn</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha the ka hoysah cih;</para>
  <para style="q1">Ka hiin lungkhu balyn</para>
  <para style="q2">ka Pachia thehoysahnaw</para>
  <para style="q1">hlaw kha ka sah cih.</para>
  <para style="q1">
    <verse number="3" style="v" />Bawi hae te ccungccaw hae kha</para>
  <para style="q2">doliakuh nan oh,</para>
  <para style="q2">minmin kya bawmnaw um khyh.</para>
  <para style="q1">
    <verse number="4" style="v" />Mih hy he athang te,</para>
  <para style="q2">laephi kalan a ki hae;</para>
  <para style="q1">tuh-e nin ccaccei khe</para>
  <para style="q2">mih paccynkunaw tuh aroh.</para>
  <para style="q1">
    <verse number="5" style="v" />Jakob Pachia kha</para>
  <para style="q2">bawmtu lang a hoi hae paw,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> mih Pachia kha</para>
  <para style="q2">a ngaehoikuh hae paw tuh</para>
  <para style="q2">lungtua hae paw nynh thua,</para>
  <para style="q1">
    <verse number="6" style="v" />tuh-e Pachia tuh vaaw te lae,</para>
  <para style="q2">rili te tuh-e hae kya</para>
  <para style="q1">a umpaw balyn kha a raetu thua zah,</para>
  <para style="q2">zungzae a lungzipaw nynh thua,<note caller="-" style="x"><char style="xo" closed="false">146.6: </char><char style="xt" closed="false"><ref loc="ACT 4:24">Loc 4.24</ref>, <ref loc="ACT 14:15">14.15</ref></char></note></para>
  <para style="q1">
    <verse number="7" style="v" />aning tuh tuaasahkunaw</para>
  <para style="q2">a ing hae paw hanlan</para>
  <para style="q1">dingnaw a raepaw nynh thua;</para>
  <para style="q2">mih vuelaw hae paw kha</para>
  <para style="q1">looh a pya hae.</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh thongccah</para>
  <para style="q2">hae paw kha a luesah hae;</para>
  <para style="q1">
    <verse number="8" style="v" />
    <char style="nd">Bawipaw </char> nynh mitmoh hae kha</para>
  <para style="q2">ngaw a muihsah hae.</para>
  <para style="q2">a nyaasah hae paw kha a hangthung hae;</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh miding hae kha</para>
  <para style="q2">a sungsah hae.</para>
  <para style="q1">
    <verse number="9" style="v" />
    <char style="nd">Bawipaw </char> nynh mikhia hae kha a rin hae;</para>
  <para style="q2">ngawraw hae te nomae hae kha a bawm hae,</para>
  <para style="q1">thuasalama ccungccaw hoylei hae</para>
  <para style="q2">laanpi kha a ropya hae.</para>
  <para style="q1">
    <verse number="10" style="v" />Pou Zion, na Pachia athuapaw</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh zungzae a uk cih,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <chapter number="147" style="c" />
  <para style="s1">Jerusalem Do-oihnaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <para style="q1">ah Pachia kalan thehoysahnaw</para>
  <para style="q2">hlawsah tuh pawcih baban mou ahoy;</para>
  <para style="q1">pawccecize aning tuh thawccinaw a hoi,</para>
  <para style="q2">hlaw te thehoysah lan</para>
  <para style="q2">a ngaekuhpaw nynh thua.</para>
  <para style="q1">
    <verse number="2" style="v" />
    <char style="nd">Bawipaw </char> nynh Jerusalem kha sak zah,</para>
  <para style="q2">a dee hae paw Israel hae kha</para>
  <para style="q2">a suelua hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Thinlung koi hae paw kha</para>
  <para style="q2">dansah hae zah,</para>
  <para style="q2">mih vaemaw kha a heepya hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Awsi accanlu kha ria zah,</para>
  <para style="q2">mih balyn te min a phu hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Ah Bawipaw tuh lesae zah</para>
  <para style="q2">a huhan myarya ale;</para>
  <para style="q2">a hawnaw tuh tou kho um khyh.</para>
  <para style="q1">
    <verse number="6" style="v" />
    <char style="nd">Bawipaw </char> nynh zakaw</para>
  <para style="q2">a sangsakuhpaw kha</para>
  <para style="q1">a hangthung hae;</para>
  <para style="q2">ccungccaw hoylei hae paw kha</para>
  <para style="q1">laephi kalan a vua hae.</para>
  <para style="q1">
    <verse number="7" style="v" />
    <char style="nd">Bawipaw </char> kalan</para>
  <para style="q2">lungtuanaw hlawsah oh;</para>
  <para style="q1">ah Pachia kalan tintang khuakute</para>
  <para style="q2">roi hoypaw saw oh.</para>
  <para style="q1">
    <verse number="8" style="v" />Vaawlui kha maeking te bong zah,</para>
  <para style="q2">laephi hanlan khuaa a rawsah,</para>
  <para style="q2">mua hae kya lonua a posah.</para>
  <para style="q1">
    <verse number="9" style="v" />Aning nynh sarangpaw hae kha</para>
  <para style="q2">looh pya hae zah,</para>
  <para style="q1">va-aw taw hae nynh</para>
  <para style="q2">a sia hae ze looh a pya hae.</para>
  <para style="q1">
    <verse number="10" style="v" />Marang hae thawzung kyakhe</para>
  <para style="q2">a lungrythua khyh zah,</para>
  <para style="q1">rangtareih lan a ccue hae paw kya mah</para>
  <para style="q2">a lungrythua khyh;</para>
  <para style="q1">
    <verse number="11" style="v" />thuasalama <char style="nd">Bawipaw </char> tuh</para>
  <para style="q2">amaw rawrih hae paw te</para>
  <para style="q2">atynpaw a sungsahnaw kha</para>
  <para style="q1">a ngaehoikuh hae paw</para>
  <para style="q2">kyakhe nynh a lungrythua.</para>
  <para style="q1">
    <verse number="12" style="v" />Pou Jerusalem,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha thehoysah!</para>
  <para style="q1">Pou Zion, na Pachia kha thehoysah!</para>
  <para style="q1">
    <verse number="13" style="v" />Pawccecize aning nynh</para>
  <para style="q2">na koikua ccong kha tynsah zah;</para>
  <para style="q1">na lungkhu e na ccaaw hae kha</para>
  <para style="q2">hythua a pya hae.</para>
  <para style="q1">
    <verse number="14" style="v" />Na ramri lungkhu kya</para>
  <para style="q2">daenaw umsah zah,</para>
  <para style="q1">ahoy huaccepaw chanvuih te</para>
  <para style="q2">nang kha na vue ae sosah.</para>
  <para style="q1">
    <verse number="15" style="v" />Aning nynh laephi kha</para>
  <para style="q2">kawpya zah,</para>
  <para style="q2">a bya tuh arangte yn thua.</para>
  <para style="q1">
    <verse number="16" style="v" />Vuiraw kha tuuming alo lante</para>
  <para style="q2">a ccawsah; dangtui kha mah</para>
  <para style="q2">buhhaw alo lante a hei.</para>
  <para style="q1">
    <verse number="17" style="v" />Hya kha lungpyng hawte a ccawsah,</para>
  <para style="q2">a kyaasahnaw kyakhe</para>
  <para style="q2">hum nynh mou a thadyn kho cih?</para>
  <para style="q1">
    <verse number="18" style="v" />Aning nynh kawpya zah</para>
  <para style="q2">tuh-e hya hae tuh atui hae;</para>
  <para style="q2">a khisan kha zawsah zah tui alua.</para>
  <para style="q1">
    <verse number="19" style="v" />A bya kha Jakob kya a hopya,</para>
  <para style="q2">a phungbya te a phungzae kha</para>
  <para style="q2">Israel hae kya a hopya hae.</para>
  <para style="q1">
    <verse number="20" style="v" />Minphuin ccangpaw hae kya</para>
  <para style="q2">tuhcite cyih khyh;</para>
  <para style="q1">minmin nynh a phungzae kha</para>
  <para style="q2">nyh khyh hae.</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <chapter number="148" style="c" />
  <para style="s1">Pachia Phu-enaw Thehoysah</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <para style="q1">Vaawlui kyate</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha thehoysah oh;</para>
  <para style="q1">ahangnaw kyakhe</para>
  <para style="q2">amaw kha thehoysah oh!</para>
  <para style="q1">
    <verse number="2" style="v" />Vaawccungccaw hae balyn,</para>
  <para style="q2">amaw kha thehoysah oh!</para>
  <para style="q1">a vaaw rhawkaw hae,</para>
  <para style="q2">amaw kha thehoysah oh!</para>
  <para style="q1">
    <verse number="3" style="v" />Khuanin te sawpaw,</para>
  <para style="q2">amaw kha thehoysah oh;</para>
  <para style="q1">a awpaw awsi hae balyn nynh</para>
  <para style="q2">amaw kha thehoysah oh!</para>
  <para style="q1">
    <verse number="4" style="v" />Ahang huaccepaw vaawlui te</para>
  <para style="q2">vaawlui luki e tui hae nanning,</para>
  <para style="q1">amaw kha thehoysah oh!</para>
  <para style="q1">
    <verse number="5" style="v" />Minmin nynh <char style="nd">Bawipaw </char> min kha</para>
  <para style="q2">thehoysah hae sah,</para>
  <para style="q1">pawccecize aning nynh kawpya zah,</para>
  <para style="q2">minmin tuh rae athua hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Aning nynh minmin kha</para>
  <para style="q2">zungzae te zungzae cia tynsah hae zah,</para>
  <para style="q1">minmin nynh a kaw-ei kho khyh hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Laephi kyate <char style="nd">Bawipaw </char> kha</para>
  <para style="q2">thehoysah oh, rili ngasawpi hae te</para>
  <para style="q2">akhupaw rili balyn,</para>
  <para style="q1">
    <verse number="8" style="v" />maee te hya, vuiraw te dangtui te</para>
  <para style="q2">a kawngaepaw khise!</para>
  <para style="q1">
    <verse number="9" style="v" />Muapi hae te sangpyng hae balyn,</para>
  <para style="q2">thingku a thae hae paw te</para>
  <para style="q2">sidar ku hae balyn!</para>
  <para style="q1">
    <verse number="10" style="v" />Loramsaw hae te sahiin hae balyn,</para>
  <para style="q2">avawthya hae paw te</para>
  <para style="q1">azouthyapaw pavaw hae!</para>
  <para style="q1">
    <verse number="11" style="v" />Laephi siapharan hae te</para>
  <para style="q2">ccungccaw hae balyn,</para>
  <para style="q2">bawi hae te laephi uktu hae balyn!</para>
  <para style="q1">
    <verse number="12" style="v" />Ccangvae hae te liaccaw hae,</para>
  <para style="q2">ataw hae paw te ano hae paw mah!</para>
  <para style="q1">
    <verse number="13" style="v" />Minmin nynh <char style="nd">Bawipaw </char> min kha</para>
  <para style="q2">thehoysah hae sah,</para>
  <para style="q1">pawccecize amaw min rou nynh</para>
  <para style="q2">hangthung athua;</para>
  <para style="q1">a huhan tuh vaaw te</para>
  <para style="q2">lae laeze a hanghua.</para>
  <para style="q1">
    <verse number="14" style="v" />Amaw nynh a ccungccaw hae ki kha</para>
  <para style="q2">a hangthung vae hae,</para>
  <para style="q1">lungzipaw a ccungccaw hae balyn,</para>
  <para style="q2">amaw te a naekuh hae paw</para>
  <para style="q1">Israel ccungccaw hae nynh</para>
  <para style="q2">amaw kha thehoysah oh.</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <chapter number="149" style="c" />
  <para style="s1">Pachia Hoynaw Thehoysah</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <para style="q1">Lungzi hae paw a pumkunaw hae kyakhe</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> thehoysahnaw</para>
  <para style="q2">hlaw athawpaw kha sah oh.</para>
  <para style="q1">
    <verse number="2" style="v" />Israel tuh amaw a Raetupaw tungvaw</para>
  <para style="q2">a lungtua sah;</para>
  <para style="q1">Zion ccaaw hae tuh</para>
  <para style="q2">mih Siapharan tungvaw</para>
  <para style="q2">mih lungtua sah.</para>
  <para style="q1">
    <verse number="3" style="v" />Minmin nynh law biate a min kha</para>
  <para style="q2">thehoysah hae sah,</para>
  <para style="q1">tyng te tintang khuakute amaw kalan</para>
  <para style="q2">roi hoypaw saw hae sah.</para>
  <para style="q1">
    <verse number="4" style="v" />Pawccecize <char style="nd">Bawipaw </char> tuh</para>
  <para style="q2">a ccungccaw hae kya a lungrythua;</para>
  <para style="q1">zakawsangsakuh hae paw kha</para>
  <para style="q2">taenaw te a ccaan hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Lungzi hae paw tuh</para>
  <para style="q2">phu-ete mih lungtua sah;</para>
  <para style="q1">mih iphae vawlan khe</para>
  <para style="q2">lungtuate hlawsah hae sah.</para>
  <para style="q1">
    <verse number="6" style="v" />Mih khalang te Pachia</para>
  <para style="q2">thehoysahnaw roi kha</para>
  <para style="q1">thawte saw hae sah lah,</para>
  <para style="q2">mih kuih kyakhe kyng ning ahepaw</para>
  <para style="q2">thaloi kha ccyngkuh hae sah,</para>
  <para style="q1">
    <verse number="7" style="v" />tuh-e tuh minphuin</para>
  <para style="q2">ccangpaw hae kha liaru khylan,</para>
  <para style="q2">ccungccaw hae detah khylan,</para>
  <para style="q1">
    <verse number="8" style="v" />te mih siapharan hae kha</para>
  <para style="q2">sivawrui te khii khylan te</para>
  <para style="q1">mih uktu hae kha</para>
  <para style="q2">sivaw bawtary te khii khylan,</para>
  <para style="q1">
    <verse number="9" style="v" />te tuh-e ccungccaw hae tungvaw</para>
  <para style="q2">Pachia kawpyanaw thyhte</para>
  <para style="q1">byapianaw rae khylan nynh thua.</para>
  <para style="q2">E hynh alungzipaw</para>
  <para style="q1">a mithyaa hae balyn hanlan</para>
  <para style="q2">phu-enaw nynh thua.</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <chapter number="150" style="c" />
  <para style="s1">Pachia Lesaenaw Thehoysah</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <para style="q1">Pachia kha a beikinnthyaa kya</para>
  <para style="q2">thehoysah oh;</para>
  <para style="q1">adawkuhpaw a vaawlui kya amaw kha</para>
  <para style="q2">thehoysah oh!</para>
  <para style="q1">
    <verse number="2" style="v" />Alesaepaw a raepaw keiccu</para>
  <para style="q2">amaw kha thehoysah oh;</para>
  <para style="q1">myaryasankae lepaw</para>
  <para style="q2">a lesaenaw thyhte</para>
  <para style="q1">amaw kha thehoysah oh!</para>
  <para style="q1">
    <verse number="3" style="v" />Mungkae roi te amaw kha</para>
  <para style="q2">thehoysah oh;</para>
  <para style="q1">phyly te tintang khate</para>
  <para style="q2">thehoysah oh!</para>
  <para style="q1">
    <verse number="4" style="v" />Tyng te law biate amaw kha</para>
  <para style="q2">thehoysah oh;</para>
  <para style="q1">arui umpaw te thuasah,</para>
  <para style="q2">akhu uapaw te thuasah</para>
  <para style="q2">thehoysah oh!</para>
  <para style="q1">
    <verse number="5" style="v" />Aroi ccaepaw lanchi te</para>
  <para style="q2">thehoysah oh;</para>
  <para style="q2">aroi myarya ccaepaw</para>
  <para style="q1">lanchi alepaw te amaw kha</para>
  <para style="q2">thehoysah oh.</para>
  <para style="q1">
    <verse number="6" style="v" />A hysuepaw balyn nynh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha thehoysah oh!</para>
</usx>