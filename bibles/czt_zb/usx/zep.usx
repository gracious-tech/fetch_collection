<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="ZEP" style="id">Baebu Thyaa</book>
  <para style="h">ZEFANIAH</para>
  <para style="toc1">Zephaniah</para>
  <para style="toc2">ZEFANIAH</para>
  <para style="toc3">Zef</para>
  <para style="mt1">ZEFANIAH</para>
  <para style="mt2">Zephaniah</para>
  <para style="imt">Byalaanmaw</para>
  <para style="ip">Profeh Zefaniah phung a honaw ccyh hynh BC 600 loukaw nynh thua, BC 621 kya Josiah siapharan nynh beiknaw a raethui maw kum haw loukaw kya athua kho. E ccauh kyahin ccangpaw profeh hae nynh a la ho vae hae paw mah a umbua: Judah hae nynh ccangpaw pachia hae kha a beik hae keiccuze Pachia nynh a roh cih hae. Bawipaw nynh minphuin ccangpaw hae kha mah a roh cih hae. Jerusalem tuh ro athua zemah raethui athua cih zah, tuin kyakhe zakaw a sangsakuhpaw te a dingpaw ccungccaw hae a um cih hae.</para>
  <para style="iot">Abyalupi hae</para>
  <para style="io1">Bawipaw byapianaw nin 1.1—2.3</para>
  <para style="io1">Israel innpaw hae ronaw 2.4-15</para>
  <para style="io1">Jerusalem ronaw te shawkhawnaw 3.1-20</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah siapharan Amon ccapaw Josiah she lyakhe <char style="nd">Bawipaw </char> bya tuh Zefaniah kalan yn thua; Zefaniah tuh Kushi ccapaw, Kushi tuh Gedaliah ccapaw, Gedaliah tuh Amariah ccapaw, Amariah tuh Hezekiah ccapaw nynh thua.<note caller="-" style="x"><char style="xo" closed="false">1.1: </char><char style="xt" closed="false"><ref loc="2KI 22:1-23:30">2Si 22.1—23.30</ref>; <ref loc="2CH 34:1-35:27">2Sh 34.1—35.27</ref></char></note></para>
  <para style="b" />
  <para style="s1">Judah kha Byapianaw</para>
  <para style="q1">
    <verse number="2" style="v" />Laephi vawlan umpaw</para>
  <para style="q2">atyn-are hynh khaleih ka roh cih, cite</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh a ho.</para>
  <para style="q1">
    <verse number="3" style="v" />Ccungccaw te sarangpaw hae kha</para>
  <para style="q2">ka maemih cih hae;</para>
  <para style="q1">vaawlang e pavaw hae te</para>
  <para style="q2">rili kya-e ngasaw hae kha</para>
  <para style="q1">ka maemih cih hae.</para>
  <para style="q2">Ccungccaw hoylei hae paw kha</para>
  <para style="q1">ka khuliasakuh cih hae.</para>
  <para style="q2">Ccungccaw kha laephi vawlan te</para>
  <para style="q1">ka vua cih, cite</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh a ci.</para>
  <para style="q1">
    <verse number="4" style="v" />Judah ram te Jerusalem kya</para>
  <para style="q2">a um hae paw balyn kha</para>
  <para style="q1">ka kuih ka dyngnua cih hae;</para>
  <para style="q2">Baal a beik hae paw</para>
  <para style="q1">a laehy hae paw te</para>
  <para style="q2">zohtuh ranpibawi hae min kha</para>
  <para style="q2">hynh-e hmin kyate ka vua cih hae;</para>
  <para style="q1">
    <verse number="5" style="v" />vaawlang e uccaw hae kha</para>
  <para style="q2">innccuvaw kyate a beiktu hae te</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha beik zah</para>
  <para style="q2">bya mang a kinpakuh pite,</para>
  <para style="q1">Milkom pachia min te</para>
  <para style="q2">bya a kinkuh hae paw kha mah</para>
  <para style="q2">ka vua cih hae.</para>
  <para style="q1">
    <verse number="6" style="v" />
    <char style="nd">Bawipaw </char> kha zui leite</para>
  <para style="q2">nulang a maeleihkuh hae paw,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kha ccung leite</para>
  <para style="q2">tuanaw mah a ngiakuh</para>
  <para style="q1">lei hae paw kha ka vua cih hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" />Bawipaw PACHIA malang khe</para>
  <para style="q2">daebabi lan um oh!</para>
  <para style="q1">Pawccecize <char style="nd">Bawipaw </char> nin tuh anae vae;</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh silawnaw kha</para>
  <para style="q1">a paccyn vae,</para>
  <para style="q2">a kopaw a mikhia hae kha</para>
  <para style="q2">a thyaasah vae hae.</para>
  <para style="q1">
    <verse number="8" style="v" />
    <char style="nd">Bawipaw </char> silawnaw nin khe</para>
  <para style="q2">bawi hae, siapharan ccapaw hae te</para>
  <para style="q1">ramccang boeining te</para>
  <para style="q2">a ccaankuh hae paw balyn kha</para>
  <para style="q2">de ka tah cih hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Tuin nin khe rhawlungrua vawlan</para>
  <para style="q2">po a kae hae paw balyn,</para>
  <para style="q1">mih bawipaw inn kha</para>
  <para style="q2">puathonaw te hynhunaw khate</para>
  <para style="q1">phe a biasah hae paw kha</para>
  <para style="q2">de ka tah cih hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" />
    <char style="nd">Bawipaw </char> nynh a hopaw tuh,</para>
  <para style="q2">tuin nin vae tuh,</para>
  <para style="q1">Ngasaw Koikua kya-e</para>
  <para style="q2">siaruanaw roi kha thuasah,</para>
  <para style="q1">Ccangningnaw khua kya-e</para>
  <para style="q2">rawkhuinaw roi kha thuasah,</para>
  <para style="q1">sangpyng hae kya-e</para>
  <para style="q2">ronaw roi kha thuasah thae athua cih.</para>
  <para style="q1">
    <verse number="11" style="v" />Mortar kya um hae paw tuh</para>
  <para style="q2">a rah a khui hae,</para>
  <para style="q1">pawccecize kungku hae paw</para>
  <para style="q2">balyn tuh a roh vae hae;</para>
  <para style="q1">phua te kungku hae paw</para>
  <para style="q2">balyn tuh a zo vae hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Tuin ccyh khe Jerusalem kha</para>
  <para style="q2">maeekhua te ka ccung cih,</para>
  <para style="q1">“<char style="nd">Bawipaw </char> nynh ahoypaw thuasah,</para>
  <para style="q2">athahpaw thuasah</para>
  <para style="q1">pawpaw mah cyih lan khyh,” cite</para>
  <para style="q2">mih thinlung kya um zah,</para>
  <para style="q1">ahaw vawlan e atui hawte</para>
  <para style="q2">ngaengante a um hae paw kha</para>
  <para style="q2">de ka tah cih hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Mih sisua kha luade athua cih zah,</para>
  <para style="q2">mih inn hae kha ro athua cih.</para>
  <para style="q1">Inn a sakku hae zemah umnah</para>
  <para style="q2">lan khyh hae;</para>
  <para style="q1">misu khokhu a raeku hae zemah</para>
  <para style="q2">tuin kya-e misutui kha</para>
  <para style="q1">neih lan khyh hae.</para>
  <para style="b" />
  <para style="s1">
    <char style="nd">Bawipaw </char> Nin Alesaepaw</para>
  <para style="q1">
    <verse number="14" style="v" />
    <char style="nd">Bawipaw </char> nin alesaepaw tuh anae vae,</para>
  <para style="q2">arangte yn naekuh vae;</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nin kya-e</para>
  <para style="q2">roi tuh akhah,</para>
  <para style="q1">rhawkaw hae tuh</para>
  <para style="q2">myarya ccae lan a sia hae.</para>
  <para style="q1">
    <verse number="15" style="v" />Tuh-e nin tuh thinrianaw nin,</para>
  <para style="q2">lungriathaenaw te</para>
  <para style="q1">thinphangnaw nin,</para>
  <para style="q2">ronaw te maemihnaw nin,</para>
  <para style="q1">mohnaw te ngaethyanaw nin,</para>
  <para style="q2">maeking azi nin te</para>
  <para style="q2">marae zipingpaw mohnaw nin,</para>
  <para style="q1">
    <verse number="16" style="v" />koihkhawpaw khuapi hae te</para>
  <para style="q2">rhawvianaw innhangpaw hae kha</para>
  <para style="q1">rawsete mungkae tu nin te</para>
  <para style="q2">rhawtukte siarua nin nynh thua.</para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" />Ccungccaw hae tungvaw</para>
  <para style="q2">tuhcihawpaw riathaenaw kha</para>
  <para style="q1">ka thuasah cih zah,</para>
  <para style="q2">mitmoh hae hawte a cceih cih hae;</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> tungvaw</para>
  <para style="q2">a sei hae keiccuze</para>
  <para style="q1">mih chii kha vuiping hawte</para>
  <para style="q2">laee athua cih zah,</para>
  <para style="q2">mih saw kha ia hawte vua athua cih.</para>
  <para style="q1">
    <verse number="18" style="v" />
    <char style="nd">Bawipaw </char> a thinria nin tuh,</para>
  <para style="q2">mih sui te mih ngun nynh</para>
  <para style="q1">minmin kha khum kho lan khyh hae;</para>
  <para style="q2">a thinrianaw maee nynh</para>
  <para style="q1">laephi pynpi kha a u cih;</para>
  <para style="q2">laephi vaw um hae paw balyn kha</para>
  <para style="q1">arangte khaleih a thangsah cih hae.</para>
  <para style="b" />
  <chapter number="2" style="c" />
  <para style="s1">Israel Rhaw hae kha Byapianaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou maethya nyh lei</para>
  <para style="q2">hae paw minphuin hae,</para>
  <para style="q1">sueluakuh oh,</para>
  <para style="q2">pynkheihlan sueluakuh oh,</para>
  <para style="q1">
    <verse number="2" style="v" />nanning kha vaekang hawte</para>
  <para style="q2">ccaring ae mung maw oh,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> thinrianaw</para>
  <para style="q2">myarya ccihpaw tuh</para>
  <para style="q1">nae tungvaw a thua maw,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> thin-unaw nin tuh</para>
  <para style="q1">nae tungvaw a thua mawkhe,</para>
  <para style="q2">sueluakuh oh.</para>
  <para style="q1">
    <verse number="3" style="v" />A kawbya a zui hae paw</para>
  <para style="q2">ram lungkhu e zakawsangsakuh</para>
  <para style="q1">hae paw nanning balyn,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha ccungtua oh;</para>
  <para style="q1">dingnaw te zakawsangsakunaw kha</para>
  <para style="q2">ccungtua oh,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> thinrianaw nin khe</para>
  <para style="q2">nanning nynh rekunaw kha poh na muihkuh kho oh.</para>
  <para style="q1">
    <verse number="4" style="v" />Pawccecize Gaza tuh</para>
  <para style="q2">poutaw athua cih zah,</para>
  <para style="q1">Ashkelon tuh ccungccaw</para>
  <para style="q2">kharouh adaepaw lang a tang cih;</para>
  <para style="q1">Ashdod khuaccaaw hae tuh</para>
  <para style="q2">ninthu khe dee athua cih hae zah,</para>
  <para style="q1">Ekron khua tuh khaleih ro athua cih.<note caller="-" style="x"><char style="xo" closed="false">2.4-7: </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">Isa 14.29-31</ref>; <ref loc="JER 47:1-7">Jer 47.1-7</ref>; <ref loc="EZK 25:15-17">Eze 25.15-17</ref>; <ref loc="JOL 3:4-8">Joe 3.4-8</ref>; <ref loc="AMO 1:6-8">Amo 1.6-8</ref>; <ref loc="ZEC 9:5-7">Zek 9.5-7</ref></char></note></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" />Rili kin um hae paw</para>
  <para style="q2">Kereth minphuin hae,</para>
  <para style="q1">nae hanlan ngaethya lan kou um!</para>
  <para style="q2">Pou Filistin hae ram athuapaw Kanaan,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> bya nynh</para>
  <para style="q2">nang kha ae rawse vae;</para>
  <para style="q1">ccungccaw lu kheit san</para>
  <para style="q2">a um lei lan ciate nang kha kae roh cih.</para>
  <para style="q1">
    <verse number="6" style="v" />Pou rili kin e ram,</para>
  <para style="q2">nang tuh sahiin rampaeekunaw,</para>
  <para style="q1">tuurin hae umnaw te</para>
  <para style="q2">tuukhia lang na tang cih.</para>
  <para style="q1">
    <verse number="7" style="v" />Rili kin e ram tuh a laehy hae paw</para>
  <para style="q2">Judah hae ram lang a tang cih,</para>
  <para style="q1">minmin nynh tuin kya a um cih hae zah,</para>
  <para style="q2">zete khe Ashkelon khua e</para>
  <para style="q1">inn hae kya a rya cih hae.</para>
  <para style="q2">Pawccecize <char style="nd">Bawipaw </char></para>
  <para style="q1">mih Pachia nynh minmin kha</para>
  <para style="q2">a oihsah cih hae zah,</para>
  <para style="q1">mih hiinnaw kha langmaw hawte</para>
  <para style="q2">a hoysah thui cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" />Moab hae te Ammon hae nynh</para>
  <para style="q2">ka ccungccaw hae kha</para>
  <para style="q1">theihrya hae zah,</para>
  <para style="q2">mih ram luade lan</para>
  <para style="q1">a poonuaku hae paw bya kha</para>
  <para style="q2">ka thae vae.<note caller="-" style="x"><char style="xo" closed="false">2.8-11: </char><char style="xt" closed="false"><ref loc="ISA 15:1-16:14">Isa 15.1—16.14</ref>, <ref loc="ISA 25:10-12">25.10-12</ref>; <ref loc="JER 48:1-49:6">Jer 48.1—49.6</ref>; <ref loc="EZK 21:28-32">Eze 21.28-32</ref>, <ref loc="EZK 25:1-11">25.1-11</ref>; <ref loc="AMO 1:13-15">Amo 1.13-15</ref></char></note></para>
  <para style="q1">
    <verse number="9" style="v" />Tukeiccuze vaaw <char style="nd">Bawipaw </char>,</para>
  <para style="q2">Israel Pachia nynh a hopaw tuh,</para>
  <para style="q1">kae tuh ka hiin thyhte,</para>
  <para style="q2">Moab tuh Sodom hawte</para>
  <para style="q1">athua cih zah, Ammon tuh</para>
  <para style="q2">Gomorrah hawte athua cih,</para>
  <para style="q1">hinpaw aponaw ram, loi khu,</para>
  <para style="q2">te zungzae arohpaw</para>
  <para style="q1">ram lang a tang cih.</para>
  <para style="q2">A laehypaw ka ccungccaw hae nynh</para>
  <para style="q1">minmin kha a thiing cih hae zah,</para>
  <para style="q2">a hiinhypaw ka minphuin hae nynh</para>
  <para style="q2">mih ram kha a ccou cih hae.<note caller="-" style="x"><char style="xo" closed="false">2.9: </char><char style="xt" closed="false"><ref loc="GEN 19:24">Gen 19.24</ref></char></note></para>
  <para style="q1">
    <verse number="10" style="v" />Minmin nynh vaaw <char style="nd">Bawipaw </char></para>
  <para style="q2">a ccungccaw hae kha saryate</para>
  <para style="q1">a poonuaku hae keiccuze</para>
  <para style="q2">mih lysakunaw hanlan,</para>
  <para style="q1">e hynh minmin tungvaw</para>
  <para style="q2">liarunaw nynh thua.</para>
  <para style="q1">
    <verse number="11" style="v" />
    <char style="nd">Bawipaw </char> nynh minmin kha</para>
  <para style="q2">myarya a risah cih hae;</para>
  <para style="q1">laephi vaw e pachia hae balyn kha</para>
  <para style="q2">ccungkia leipaw lang a rae cih hae,</para>
  <para style="q1">minphuin ccangpaw hae kya-e</para>
  <para style="q2">rili kin e ram te</para>
  <para style="q1">tuikoih hae balyn nynh</para>
  <para style="q2">mih umnaw raveih kyakhe</para>
  <para style="q1">amaw kha bakhungnuate</para>
  <para style="q2">a beik cih hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" />Pou Ethiopia ccungccaw hae,</para>
  <para style="q2">nanning mah ka thaloi te</para>
  <para style="q1">chia na thua cih oh.<note caller="-" style="x"><char style="xo" closed="false">2.12: </char><char style="xt" closed="false"><ref loc="ISA 18:1-7">Isa 18.1-7</ref></char></note></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" />Aning nynh thahlang khe</para>
  <para style="q2">a kuih a dyng cih zah,</para>
  <para style="q1">Assiria kha a roh cih;</para>
  <para style="q2">Nineveh kha ramrou hawte</para>
  <para style="q1">ccungkia leipaw aroupaw,</para>
  <para style="q2">ccungccaw adaepaw</para>
  <para style="q2">khua lang a tangsah cih.<note caller="-" style="x"><char style="xo" closed="false">2.13-15: </char><char style="xt" closed="false"><ref loc="ISA 10:5-34">Isa 10.5-34</ref>, <ref loc="ISA 14:24-27">14.24-27</ref>; <ref loc="NAM 1:1-3:19">Nah 1.1—3.19</ref></char></note></para>
  <para style="q1">
    <verse number="14" style="v" />Khua lungkhu khe sahiin hae te</para>
  <para style="q2">loramsaw miakaw tuh</para>
  <para style="q1">a rya cih hae;</para>
  <para style="q2">ramrou nawnia te lantaw hae tuh</para>
  <para style="q1">tungpi hae dung khe</para>
  <para style="q2">a um cih hae; nawnia hae tuh</para>
  <para style="q1">thanlan-aw hae kya a sia cih hae,</para>
  <para style="q2">va-aw hae tuh inn atolang</para>
  <para style="q1">pounaw khe a to cih hae;</para>
  <para style="q2">pawccecize inn hae kya-e</para>
  <para style="q1">sidar thing hae tuh</para>
  <para style="q2">khaleih law athua cih hae.</para>
  <para style="q1">
    <verse number="15" style="v" />E khuapi tuh amaw te amaw kha,</para>
  <para style="q2">“Kamaw laelan humhung mah</para>
  <para style="q1">um vae khyh,” cite cikuh zah,</para>
  <para style="q2">khyndadyh lan umte</para>
  <para style="q1">a lungtuapaw khua kha athua tou?</para>
  <para style="q2">Atu arohpaw hmin,</para>
  <para style="q1">loramsaw hae nynh</para>
  <para style="q2">a paeenaw hae hmin lang rei</para>
  <para style="q1">phe a tang vae!</para>
  <para style="q2">A pe a cceihpaw miakaw nynh</para>
  <para style="q1">saryanawpaw roisawnua hae zah</para>
  <para style="q2">mih kuihlung kha a lungnua hae.</para>
  <para style="b" />
  <chapter number="3" style="c" />
  <para style="s1">Jerusalem Hoyleinaw</para>
  <para style="q1">
    <verse number="1" style="v" />Rawse a mangpaw,</para>
  <para style="q2">a nungsikuhpaw te</para>
  <para style="q1">ccungccaw a tuaa a sahpaw</para>
  <para style="q2">khuapi hanlan ngaethya lan kou um!</para>
  <para style="q1">
    <verse number="2" style="v" />Tuh-e khuapi tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> bya kha ngae khyh;</para>
  <para style="q1">thuiheinaw mah lawkuh khyh.</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha doliakuh khyh;</para>
  <para style="q1">a Pachia kalan naekuh khyh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" />Tuh-e khua lungkhu e</para>
  <para style="q2">bawi hae tuh palei a siapaw</para>
  <para style="q1">chindeih nynh thua hae;</para>
  <para style="q2">a kya-e byapiatu hae tuh</para>
  <para style="q1">awkhua cia pawpaw mah</para>
  <para style="q2">a cciataw lei hae paw,</para>
  <para style="q1">zete ccyh kya</para>
  <para style="q2">a khiakuhthya hae paw</para>
  <para style="q2">suizaw hae nynh thua hae.</para>
  <para style="q1">
    <verse number="4" style="v" />A profeh hae tuh</para>
  <para style="q2">tuanaw-roihnaw hoi lei</para>
  <para style="q1">hae paw te alungzi leipaw</para>
  <para style="q2">ccungccaw hae nynh thua hae,</para>
  <para style="q1">a ranpibawi hae nynh</para>
  <para style="q2">beikinnthyaa kha thusah hae zah,</para>
  <para style="q2">a kawbya kha a ro hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Tuh-e lungkhu a umpaw</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> tuh ding zah,</para>
  <para style="q1">hoyleinaw kha rae khyh.</para>
  <para style="q2">Awkhua takyh, khuadaetakaw khe</para>
  <para style="q1">a byapianaw kha</para>
  <para style="q2">tyty a langsah zungzae;</para>
  <para style="q1">thuasalama a ding lei</para>
  <para style="q2">hae paw tuh maethya nyh khyh hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" />Minphuin hae kha</para>
  <para style="q2">ka vua vae hae;</para>
  <para style="q1">mih khualungrua hae tuh</para>
  <para style="q2">aroh vae hae, laanpi hae kya</para>
  <para style="q1">humhung nynh mah</para>
  <para style="q2">a ccia khyh ccaw hae cite,</para>
  <para style="q1">khua lungkhu e</para>
  <para style="q2">laanpi hae kha ka ro vae hae;</para>
  <para style="q1">a umtu ccungccaw hae</para>
  <para style="q2">a um lei lan ciate</para>
  <para style="q1">mih khuapi hae kha</para>
  <para style="q2">ro athua vae hae.</para>
  <para style="q1">
    <verse number="7" style="v" />“Khuapi nynh kae kha</para>
  <para style="q2">yn rih ccaccing cih zah,</para>
  <para style="q1">ka thuiheinaw kha</para>
  <para style="q2">a lawkuh cih;</para>
  <para style="q1">tetuh a umnaw kha</para>
  <para style="q2">vuapya thua lan khyh zah,</para>
  <para style="q1">ka ccangpyanaw balyn kha</para>
  <para style="q2">papin ning lan khyh,” cite ka ho.</para>
  <para style="q1">Thuasalama mih cyisahnaw balyn kyakhe</para>
  <para style="q2">hoyleinaw rae kha a ryhua hae.</para>
  <para style="b" />
  <para style="s1">Minphuin hae Lungpaleihkunaw</para>
  <para style="q1">
    <verse number="8" style="v" />Tukeiccuze <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">a hopaw tuh, ccaekia lang</para>
  <para style="q1">tang khylan kae thoku nin cia</para>
  <para style="q2">yn la ngaw oh.</para>
  <para style="q1">Pawccecize minphuin hae kha</para>
  <para style="q2">suelua lan hae zah,</para>
  <para style="q1">peenaw hae kha pum lan hae,</para>
  <para style="q2">te ka thin-unaw, ka thinrianaw</para>
  <para style="q1">asopaw balyn kha</para>
  <para style="q2">mih tungvaw kya bu lan cite</para>
  <para style="q1">bya ka paeku vae;</para>
  <para style="q2">ka thinrianaw maee nynh</para>
  <para style="q1">laephi pynpi kha a u cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" />Tuin ccyh vae tuh</para>
  <para style="q2">ccungccaw balyn nynh</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> min kha</para>
  <para style="q2">ko hae zah, lunglokute</para>
  <para style="q1">a rya a law nawlan hae,</para>
  <para style="q2">mih bya kha athyaapaw</para>
  <para style="q2">bya lang ka paleih cih.</para>
  <para style="q1">
    <verse number="10" style="v" />Ethiopia ram e vaw hae</para>
  <para style="q2">khuraw lang kya</para>
  <para style="q1">phiariphiarae um hae paw</para>
  <para style="q2">ka ccungccaw hae,</para>
  <para style="q1">kae yn beik hae paw nynh</para>
  <para style="q2">ka hanlan lasung kha</para>
  <para style="q1">yn ccyng cih hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" />Tuin nin vae tuh</para>
  <para style="q2">kae nae dounaw oh paw</para>
  <para style="q1">nae cyisahnaw balyn keiccuze</para>
  <para style="q2">nae maethah vae lan khyh;</para>
  <para style="q1">pawccecize pookute</para>
  <para style="q2">mih lungpawkhaekuh hae paw kha</para>
  <para style="q1">na kyate ka dee cih hae,</para>
  <para style="q2">nang tuh athyaapaw</para>
  <para style="q1">ka mua vawlan khe</para>
  <para style="q2">na lysakuh vae lan khyh.</para>
  <para style="q1">
    <verse number="12" style="v" />Pawccecize zakawsangsakuh hae paw te</para>
  <para style="q2">anyaa hae paw kha</para>
  <para style="q1">na ngaelung kya</para>
  <para style="q2">ka nungsya cih hae.</para>
  <para style="q1">Minmin nynh <char style="nd">Bawipaw </char> min kyakhe</para>
  <para style="q2">khynnaw a ccungkuh cih hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Israel hae kya-e</para>
  <para style="q2">a laehy hae paw nynh</para>
  <para style="q1">hoyleinaw kha</para>
  <para style="q2">rae lan khyh hae zah</para>
  <para style="q1">hynbya ho lan khyh hae,</para>
  <para style="q2">mih khalang lungkhu kya</para>
  <para style="q1">ahynhupaw lae um vae lan khyh.</para>
  <para style="q2">Tetuh minmin tuh</para>
  <para style="q1">humhung nynh mah</para>
  <para style="q2">rinaw pya leite</para>
  <para style="q1">rampaeekuh cih hae zah</para>
  <para style="q2">a rya cih hae.<note caller="-" style="x"><char style="xo" closed="false">3.13: </char><char style="xt" closed="false"><ref loc="REV 14:5">Bya 14.5</ref></char></note></para>
  <para style="b" />
  <para style="s1">Lungpawnaw Hlaw</para>
  <para style="q1">
    <verse number="14" style="v" />Pou Zion ccanung,</para>
  <para style="q2">accae lante hlawsahtua.</para>
  <para style="q1">Pou Israel, siatua!</para>
  <para style="q2">Pou Jerusalem ccanung,</para>
  <para style="q1">na thinlung balyn te</para>
  <para style="q2">lungtua lungpawte umtua!</para>
  <para style="q1">
    <verse number="15" style="v" />
    <char style="nd">Bawipaw </char> nynh na tungvaw e</para>
  <para style="q2">detahnaw kha ccaring ae lawpya vae,</para>
  <para style="q1">na rhaw hae kha</para>
  <para style="q2">ccaring a dee vae hae.</para>
  <para style="q1">Israel siapharan,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> tuh nae laku kya a um;</para>
  <para style="q1">na ri lanpaw ronaw kha</para>
  <para style="q2">um vae khyh.</para>
  <para style="q1">
    <verse number="16" style="v" />Tuin nin vae tuh,</para>
  <para style="q2">e bya hynh Jerusalem kalan</para>
  <para style="q1">hopya athua cih:</para>
  <para style="q2">Pou Zion, rih nan;</para>
  <para style="q1">na kuih thaw kha</para>
  <para style="q2">zyasah bung nan.</para>
  <para style="q1">
    <verse number="17" style="v" />
    <char style="nd">Bawipaw </char> na Pachia tuh</para>
  <para style="q2">na ngaelung kya a um,</para>
  <para style="q1">taenaw ae pyapaw</para>
  <para style="q2">athungpaw nynh thua;</para>
  <para style="q1">na tungvaw a lungtua cih zah</para>
  <para style="q2">a lungpaw cih,</para>
  <para style="q1">a sungsahnaw kyakhe</para>
  <para style="q2">nang kha ae thawsah thui cih;</para>
  <para style="q1">poi nin lya hawte phe ccae lan</para>
  <para style="q2">hlawsah te na tungvaw</para>
  <para style="q2">a lungtua cih,</para>
  <para style="q1">
    <verse number="18" style="v" />Na kyate vawsawnaw kha</para>
  <para style="q2">ka lah cih zah,</para>
  <para style="q1">tuh-e hanlan theihryakunaw kha</para>
  <para style="q2">na teing vae lan khyh.</para>
  <para style="q1">
    <verse number="19" style="v" />Tuin ccyh kyakhe</para>
  <para style="q2">nang ae tuaa ae sahtu hae balyn kha</para>
  <para style="q1">kamaw nynh ka cyih cih hae.</para>
  <para style="q2">Ccukhou hae kha</para>
  <para style="q1">ka khum cih hae zah,</para>
  <para style="q2">ccungccaw hae nynh</para>
  <para style="q1">a ccuepe ry lei hae paw kha</para>
  <para style="q2">ka suelua cih hae,</para>
  <para style="q1">mih maethyanaw kha</para>
  <para style="q2">thehoy ccounaw lang</para>
  <para style="q1">ka paleih cih zah,</para>
  <para style="q2">laephi pynpi kya minthaannaw ka pya cih hae.</para>
  <para style="q1">
    <verse number="20" style="v" />Nanning suelua ccyh he yn thua te,</para>
  <para style="q2">inn lang kae cciakhae cih oh;</para>
  <para style="q1">pawccecize na muihnaw oh kyakhe</para>
  <para style="q2">he kae kikhae oh te,</para>
  <para style="q1">nanning kha laephi ccungccaw</para>
  <para style="q2">balyn laku kya minthaannaw te</para>
  <para style="q1">thehoynaw kae ccousah cih oh, cite</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh a ci.</para>
</usx>