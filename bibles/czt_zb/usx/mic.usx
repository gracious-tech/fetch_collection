<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="MIC" style="id">Baebu Thyaa</book>
  <para style="h">MIKAH</para>
  <para style="toc1">Micah</para>
  <para style="toc2">MIKAH</para>
  <para style="toc3">Mik</para>
  <para style="mt1">MIKAH</para>
  <para style="mt2">Micah</para>
  <para style="imt">Byalaanmaw</para>
  <para style="ip">Mikah tuh Isaiah ccyh lyaze alia peenaw Judah ram e khua khuakheit kyate yn langkuhpaw nynh thua. Amos nynh thahlang peenaw kya a thua cih cite a hodaepaw vawsawnaw tahawpaw kha alia peenaw kya mah a thuabua cih cipaw Mikah nynh a ny. Ccungccaw hae tuh a ding khyh hae keiccuze Pachia nynh de a tah cih hae. Thuasalama Mikah nynh a hopaw bya kyakhe malang ccyh hanlan ngaehoinaw a um cipaw accaehua lante a um.</para>
  <para style="ip">Ccykeku lanpaw byatue hae tuh Pachia liate laephi vawlan daenaw a um cih (4.1-4), David ciihan kyate alesaepaw siapharan yn langkuh cih zah minphuin elang daenaw yn thuakhae cih cipaw hodaenaw (5.2-5a); Israel profeh hae nynh a ho hae paw patae kha adynnawte byatue ccangkheit kyalya te 6.8 kya langsakuh zah, “<char style="nd">Bawipaw </char> nynh aening oun ngiapaw tuh: dingrarih lante cyi lanpaw, thawccinaw hoi lanpaw te zakawsangsakute Pachia malang hiin lanpaw kha nynh thua,” a ci.</para>
  <para style="iot">Abyalupi hae</para>
  <para style="io1">Israel te Judah kha byapianaw 1.1—3.12</para>
  <para style="io1">Raethuinaw te daenaw 4.1—5.15</para>
  <para style="io1">Raeringnaw pyanaw te ngaehoinaw bya 6.1—7.20</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah siapharan Jotham, Ahaz te Hezekiah ccyh lyaze Samaria te Jerusalem konglang, Moresheth khuapaw Mikah kalan yn thuapaw <char style="nd">Bawipaw </char> bya.<note caller="-" style="x"><char style="xo" closed="false">1.1: </char><char style="xt" closed="false"><ref loc="2KI 15:32-16:20">2Si 15.32—16.20</ref>, <ref loc="2KI 18:1-20:21">18.1—20.21</ref>; <ref loc="2CH 27:1-7">2Sh 27.1-7</ref>, <ref loc="2CH 28:1-32:33">28.1—32.33</ref></char></note></para>
  <para style="b" />
  <para style="s1">Samaria tungvaw Byapianaw</para>
  <para style="q1">
    <verse number="2" style="v" />Ccungccaw hae,</para>
  <para style="q2">nae balynte thaetua oh;</para>
  <para style="q1">Pou laephi te a lungkhu kya</para>
  <para style="q2">um hae paw balyn, ngaetua oh;</para>
  <para style="q1">Bawipaw PACHIA nynh</para>
  <para style="q2">a beikinn thyaapaw kyate</para>
  <para style="q1">nanning kha rawsete</para>
  <para style="q2">ccaekia lang tang vae sah.</para>
  <para style="q1">
    <verse number="3" style="v" />
    <char style="nd">Bawipaw </char> tuh a umnaw hmin kyate</para>
  <para style="q2">poute yn rungbung cih zah,</para>
  <para style="q2">laephi ahangnaw hmin hae kyakhe a sy cih.</para>
  <para style="q1">
    <verse number="4" style="v" />Tetuh maee pe umpaw</para>
  <para style="q2">khoilung hawte, mua hae tuh</para>
  <para style="q1">amaw zakaw khe atui cih hae zah,</para>
  <para style="q2">apannaw hmin kya tui alua hawte</para>
  <para style="q2">accya hae tuh a pawkhaekuh cih hae.</para>
  <para style="q1">
    <verse number="5" style="v" />E hae balyn tuh Jakob a seimenaw te</para>
  <para style="q2">Israel hae seinaw keiccu nynh thua.</para>
  <para style="q1">Jakob a seimenaw tuh pawmou athua?</para>
  <para style="q2">Samaria khua kha thua khyh tou?</para>
  <para style="q1">Judah kya-e ahangpaw hmin tuh</para>
  <para style="q2">pawmou athua?</para>
  <para style="q2">Jerusalem kha thua khyh tou?</para>
  <para style="q1">
    <verse number="6" style="v" />Tukeiccuze Samaria khua tuh</para>
  <para style="q2">ramkaw umpaw arohpaw</para>
  <para style="q1">apumkuhpaw lang ka rae cih zah</para>
  <para style="q2">misu linnawpaw khokhu lang ka rae cih.</para>
  <para style="q1">Samaria a lung hae kha</para>
  <para style="q2">accya kya ka lae cih hae zah,</para>
  <para style="q1">khua aleihpaw hae kha</para>
  <para style="q2">raerae ka langsah cih.</para>
  <para style="q1">
    <verse number="7" style="v" />A zohtuh hae balyn kha</para>
  <para style="q2">zoihtatyh lan koi athua cih zah,</para>
  <para style="q1">a ryalaw mee balyn kha</para>
  <para style="q2">maee te u athua cih,</para>
  <para style="q1">a zohtuh hae balyn kha ka roh cih;</para>
  <para style="q2">a ohhuakunaw mee</para>
  <para style="q1">a sueluakupaw uccaw hae kha</para>
  <para style="q2">ohhuakunaw mee lang</para>
  <para style="q1">bua pya athua cih.</para>
  <para style="b" />
  <para style="s1">Judah Khuapi hae Ronaw</para>
  <para style="q1">
    <verse number="8" style="v" />Hynh-e keiccuze ka rah ka khui cih;</para>
  <para style="q2">phanah nawku leite</para>
  <para style="q1">ka ccakaete ka cceih cih;</para>
  <para style="q2">suizaw hawte ka sia cih zah,</para>
  <para style="q2">kalauh pavaw hawte ka rah cih.</para>
  <para style="q1">
    <verse number="9" style="v" />Samaria vaemaw tuh dan kho vae khyh.</para>
  <para style="q2">Tuh-e vaemaw tuh</para>
  <para style="q1">Judah kyacia a thua vae;</para>
  <para style="q2">ka ccungccaw hae a umnaw hae</para>
  <para style="q1">Jerusalem koikua cia a thua vae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" />Gath khua kya ho nan oh,</para>
  <para style="q2">raw mah papin rah nan oh;</para>
  <para style="q1">Beth-leafrah khua khe</para>
  <para style="q2">vuiping kya toukuh oh.</para>
  <para style="q1">
    <verse number="11" style="v" />Shafir khuaccaaw hae,</para>
  <para style="q2">nae ccakaete maethyate</para>
  <para style="q1">cciatua oh.</para>
  <para style="q2">Zaanan khuaccaaw hae tuh</para>
  <para style="q2">pou khyh hae;</para>
  <para style="q1">Beth-ezel khua tuh rawkhuite um zah,</para>
  <para style="q2">aning nynh bawmnaw</para>
  <para style="q2">ae pya kho vae lan khyh.</para>
  <para style="q1">
    <verse number="12" style="v" />Maroth khuaccaaw hae tuh</para>
  <para style="q2">hoynaw kha thinphangte</para>
  <para style="q2">a ngaw hae,</para>
  <para style="q1">tuhzemah <char style="nd">Bawipaw </char> kyate</para>
  <para style="q2">ronaw tuh Jerusalem</para>
  <para style="q2">koikua kyacia a thua vae.</para>
  <para style="q1">
    <verse number="13" style="v" />Lakhish khuaccaaw hae,</para>
  <para style="q2">marang hae kha</para>
  <para style="q1">marangle hae kya khii oh;</para>
  <para style="q2">nang tuh Zion ccanung kha</para>
  <para style="q1">seinaw kalan a cciakhae typaw</para>
  <para style="q2">na thua zah,</para>
  <para style="q1">Israel a seimenaw hae kha</para>
  <para style="q2">namaw liate nynh muih athua.</para>
  <para style="q1">
    <verse number="14" style="v" />Tukeiccuze nanning Judah hae nynh</para>
  <para style="q2">Moresheth-gath khua kha</para>
  <para style="q2">phiakunawpaw lasung na pya cih oh;</para>
  <para style="q1">Akhzib khuaccaaw hae nynh</para>
  <para style="q2">Israel siapharan hae kha a ling cih hae.</para>
  <para style="q1">
    <verse number="15" style="v" />Mareshah khuaccaaw hae,</para>
  <para style="q2">nanning ae taetu oh paw kha</para>
  <para style="q2">nae kalan kae thuakhae cih.</para>
  <para style="q1">Israel a phu-enaw tuh</para>
  <para style="q2">Adullam khua lang a thua cih.</para>
  <para style="q1">
    <verse number="16" style="v" />Na sungsah oh paw</para>
  <para style="q2">nae ccaaw hae keiccuze</para>
  <para style="q1">nae sang kha ngokuh oh lah</para>
  <para style="q2">nae lu-okuh oh,</para>
  <para style="q1">minmin kha kyng hae zah</para>
  <para style="q2">nae kyate a ccikhae vae hae keiccuze</para>
  <para style="q1">mosipi hawte nae lu kha okuh oh.</para>
  <para style="b" />
  <chapter number="2" style="c" />
  <para style="s1">Ccungccaw Tuaasahtu hae</para>
  <para style="q1">
    <verse number="1" style="v" />Mih ikhung vawlan khe</para>
  <para style="q2">ahoy leipaw cyisahnaw kong kha</para>
  <para style="q1">khua a khankuh hae paw hanlan</para>
  <para style="q2">ngaethya lan kou um!</para>
  <para style="q1">Khua he yn dae tuh,</para>
  <para style="q2">ccyhhoy he a mue hae te,</para>
  <para style="q2">tuh-e tuh a cyi hae.</para>
  <para style="q1">
    <verse number="2" style="v" />Milae loo kha duaa hae zah</para>
  <para style="q2">a luade hae; inn kha</para>
  <para style="q2">a duaa hae ze, a lawpyaku hae;</para>
  <para style="q1">inn te innbyn hae kha thuasah,</para>
  <para style="q2">ccungccaw hae te</para>
  <para style="q1">mih rho kha thuasah luadete</para>
  <para style="q2">a tuaa a sah hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Tukeiccuze <char style="nd">Bawipaw </char> nynh hynhte a ho:</para>
  <para style="q1">E innbyn hae hynh rawsete</para>
  <para style="q2">hoyleinaw kha ka paccyn cih zah,</para>
  <para style="q1">tuh-e hoyleinaw kyate</para>
  <para style="q2">nae nging na hang kho lan khyh oh;</para>
  <para style="q1">lysakute na cceih kho lan khyh oh,</para>
  <para style="q2">pawccecize tuh-e ccyh tuh</para>
  <para style="q2">ccyh thyapaw athua cih.</para>
  <para style="q1">
    <verse number="4" style="v" />Tuin nin vae tuh,</para>
  <para style="q2">ccungccaw hae nynh</para>
  <para style="q1">nae konglang hynh</para>
  <para style="q2">ronaw tousenawpaw lang</para>
  <para style="q1">a mang cih hae zah,</para>
  <para style="q2">ngaethyanaw hlaw kha a sah cih hae,</para>
  <para style="q1">“Kaening tuh khaleih ro kae thua vae;</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh kae ram kha a law vae;</para>
  <para style="q1">kaening oun kyng hae zah</para>
  <para style="q2">oun cciakhaetu hae kalan</para>
  <para style="q2">a pya vae hae,” a ci cih hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Tukeiccuze ram kha</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> ccungccaw hae kalan</para>
  <para style="q1">ccungthydungte he a neekuh hae te,</para>
  <para style="q2">nanning lu kheit sanmah</para>
  <para style="q1">neebua na thua lan khyh oh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" />Ccungccaw hae nynh,</para>
  <para style="q2">“Profehbya oun hopah nan,</para>
  <para style="q1">tuhcihawpaw kong tuh ho nan,</para>
  <para style="q2">Pachia nynh thethyanaw</para>
  <para style="q2">oun ccousah lan khyh,” a ci hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Pou Jakob ciihan hae,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kya-e</para>
  <para style="q1">ngaesangnaw tuh phe thang vae tou?</para>
  <para style="q2">E hae hynh aning nynh</para>
  <para style="q2">a cyipaw athua tou?</para>
  <para style="q1">Hmerarih lan a hiinpaw kha</para>
  <para style="q2">ka bya nynh hoynaw pya leite</para>
  <para style="q1">a um zawtou? cite</para>
  <para style="q2">byakhia lan accan zawtou?</para>
  <para style="q1">
    <verse number="8" style="v" />Thuasalama nanning nynh</para>
  <para style="q2">ka ccungccaw hae kha</para>
  <para style="q1">rhaw hae hawte na rhaw oh zah</para>
  <para style="q2">na thonuaku oh;</para>
  <para style="q1">rhawtuknaw kyate oun ki hae zah,</para>
  <para style="q2">daebabi lan a um hae paw kha</para>
  <para style="q2">mih angkiccua na khahpyaku oh.</para>
  <para style="q1">
    <verse number="9" style="v" />Ka ccungccaw hae kya-e nopi hae kha</para>
  <para style="q2">mih lungryccingnaw</para>
  <para style="q2">mih inn kyate na dee oh zah,</para>
  <para style="q1">mih ccaaw taraw hae kyate</para>
  <para style="q2">ka phu-enaw kha na law zungzae oh.</para>
  <para style="q1">
    <verse number="10" style="v" />Tho oh lah cciatua oh;</para>
  <para style="q2">e ram hynh adaenaw hmin thua vae khyh,</para>
  <para style="q1">nungsikunaw keiccuze</para>
  <para style="q2">thinlungcci lan umpaw</para>
  <para style="q2">ronaw khate aroh cih.</para>
  <para style="q1">
    <verse number="11" style="v" />Cceih bungthung zah</para>
  <para style="q2">accakaepaw hynbya</para>
  <para style="q1">a hopaw lukhakheit nynh,</para>
  <para style="q2">“Misutui te ruimangpaw</para>
  <para style="q1">niapaw kong kha profehbya</para>
  <para style="q2">kae hopah cih oh,” cite a ho lanze,</para>
  <para style="q1">tuh-e ccungccaw tuh</para>
  <para style="q2">hynh-e ccungccaw hae hanlan</para>
  <para style="q1">profeh athua cih!</para>
  <para style="b" />
  <para style="s1">A laehypaw Israel hae Byakinpyakunaw</para>
  <para style="q1">
    <verse number="12" style="v" />Pou Jakob ciihan hae,</para>
  <para style="q2">nanning balyn kha solei</para>
  <para style="q1">kae suelua cih oh,</para>
  <para style="q2">a hiinhypaw Israel hae kha</para>
  <para style="q1">ka suelua cih hae; tuukhia kya-e</para>
  <para style="q2">tuu hae hawte thuasah,</para>
  <para style="q1">rampaeekunaw kya</para>
  <para style="q2">a umpaw tuuphu hawte thuasah</para>
  <para style="q1">minmin kha pynkheihlan</para>
  <para style="q2">ka suelua cih hae;</para>
  <para style="q1">mih ram kya ccungccaw hae</para>
  <para style="q2">roi tuh myarya accae cih.</para>
  <para style="q1">
    <verse number="13" style="v" />Laanpi a hungtupaw tuh</para>
  <para style="q2">mih malang a cceih cih;</para>
  <para style="q1">minmin nynh koikua kha</para>
  <para style="q2">a khya cih hae zah,</para>
  <para style="q1">tuin kyate a pou cih hae.</para>
  <para style="q2">Mih siapharan tuh</para>
  <para style="q1">mih malang khe a cceih cih,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh mih malang te</para>
  <para style="q1">a cciakhae cih hae.</para>
  <para style="b" />
  <chapter number="3" style="c" />
  <para style="s1">Ahoy leipaw Uktu hae te Profeh hae</para>
  <para style="q1">
    <verse number="1" style="v" />Te kae nynh ka ho:</para>
  <para style="q2">Nanning Jakob ciihan</para>
  <para style="q1">cciakhaetu hae te</para>
  <para style="q2">Israel ciihan uktu hae, ngaetua oh!</para>
  <para style="q1">Dingnaw kha na ny lan oh</para>
  <para style="q2">ccan khyh tou?—</para>
  <para style="q1">
    <verse number="2" style="v" />Hoynaw kha na hua oh zah</para>
  <para style="q2">hoyleinaw kha na ry oh,</para>
  <para style="q1">ka ccungccaw hae ving kha</para>
  <para style="q2">na lae oh zah, mih ru kya-e</para>
  <para style="q2">mih ngesaw kha na louh oh;</para>
  <para style="q1">
    <verse number="3" style="v" />ka ccungccaw hae saw kha</para>
  <para style="q2">na ae oh zah, mih ving kha</para>
  <para style="q1">na lae oh, mih ru kha</para>
  <para style="q2">zoihtatyh lan na khya oh zah,</para>
  <para style="q1">ang lungkhu kya umpaw</para>
  <para style="q2">sange awkuhpaw hawte,</para>
  <para style="q1">na aw oh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" />Tetuh minmin nynh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kalan a sia cih hae,</para>
  <para style="q1">thuasalama ngaepah lan khyh hae;</para>
  <para style="q2">minmin nynh hoyleinaw kha</para>
  <para style="q1">a rae hae keiccuze</para>
  <para style="q2">tuin ccyh kya tuh a mae kha</para>
  <para style="q1">a retawkuh cih hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" />Ka ccungccaw hae kha</para>
  <para style="q2">cciakhaesei hae zah</para>
  <para style="q2">ae lanpaw a hoi ccyh hae khe,</para>
  <para style="q1">“Daenaw a um cih,” cite sia hae zah,</para>
  <para style="q2">mih khalang lungkhu lang</para>
  <para style="q1">paw sanmah a baw lei hae paw kya tuh</para>
  <para style="q2">rhaw atho cih cite a hothya hae paw</para>
  <para style="q1">profeh hae konglang kha</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh hynhte a ho.</para>
  <para style="q1">
    <verse number="6" style="v" />Tukeiccuze vizin muih leite</para>
  <para style="q2">nae hanlan khua azi cih,</para>
  <para style="q1">byaphy kha ho leite</para>
  <para style="q2">nae hanlan amoh cih.</para>
  <para style="q1">Profeh hae hanlan khuanin accah cih zah,</para>
  <para style="q2">minmin hanlan khuadae ccyh tuh amoh cih;</para>
  <para style="q1">
    <verse number="7" style="v" />hodaetu hae tuh mih thethah cih zah,</para>
  <para style="q2">a pawe hae paw tuh</para>
  <para style="q1">maethyanaw a mue cih hae;</para>
  <para style="q2">Pachia nynh a khungru khyh hae keiccuze</para>
  <para style="q1">mih balynte mih khalang</para>
  <para style="q2">a huhkuh cih hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Thuasalama kae tuh, Jakob kha</para>
  <para style="q2">a seimenaw hopya khylan te</para>
  <para style="q1">Israel kha a seinaw hopya khylan</para>
  <para style="q2">huhan te thuasah,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> muisaw te thuasah,</para>
  <para style="q2">byading te thungnaw te thuasah</para>
  <para style="q1">phe ka beih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" />Byading kha hua hae zah</para>
  <para style="q2">dingnaw balyn kha a paleih hae paw,</para>
  <para style="q1">Jakob ciihan uktu hae nanning te</para>
  <para style="q2">Israel ciihan lupi hae nanning,</para>
  <para style="q2">e bya hynh ngaetua oh!</para>
  <para style="q1">
    <verse number="10" style="v" />Chiise luasahnaw khate</para>
  <para style="q2">Zion khuapi kha na rae oh zah,</para>
  <para style="q1">dingleinaw khate</para>
  <para style="q2">Jerusalem khuapi kha na rae oh!</para>
  <para style="q1">
    <verse number="11" style="v" />Khuapi a uktu hae nynh</para>
  <para style="q2">pyaruh kha mue khylan</para>
  <para style="q1">bya a pia hae, ranpibawi hae nynh</para>
  <para style="q2">amee mue khylan a ccangpya hae,</para>
  <para style="q1">profeh hae nynh phua mue khylan</para>
  <para style="q2">malang ccyh hanlan a hodae hae;</para>
  <para style="q1">tuhzemah minmin nynh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha ngeikute,</para>
  <para style="q1">“<char style="nd">Bawipaw </char> tuh aening kya</para>
  <para style="q2">a um ccaccing!</para>
  <para style="q1">Ah tungvaw vawsawnaw</para>
  <para style="q2">ccah lan khyh,” a ci hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Tukeiccu tuh, nanning keiccuze</para>
  <para style="q2">Zion kha lei hawte thue athua cih zah,</para>
  <para style="q1">Jerusalem tuh arohpaw</para>
  <para style="q2">apumkuhpaw lang a tang cih,</para>
  <para style="q1">beikinn a umnaw mua tuh</para>
  <para style="q2">tuhpi lang a tang cih.<note caller="-" style="x"><char style="xo" closed="false">3.12: </char><char style="xt" closed="false"><ref loc="JER 26:18">Jer 26.18</ref></char></note></para>
  <chapter number="4" style="c" />
  <para style="s1">Kawngaenaw liate Daenaw te Khynnaw</para>
  <para style="r">(<ref loc="ISA 2:2-4">Isa 2.2-4</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" />Malang ccyh kya <char style="nd">Bawipaw </char> inn</para>
  <para style="q2">a umnaw mua tuh mua hae kyaze</para>
  <para style="q1">ahang huaccepaw lante</para>
  <para style="q2">thadynsah athua cih zah,</para>
  <para style="q1">sangpyng hae luki lang hangthung athua cih.</para>
  <para style="q2">Ccungccaw hae tuh tuh-e mua langkhe</para>
  <para style="q2">oun thua cih hae,</para>
  <para style="q1">
    <verse number="2" style="v" />minphuin patae tuh oun thua cih hae zah:</para>
  <para style="q2">“Rang oh, <char style="nd">Bawipaw </char> mua lang,</para>
  <para style="q1">Jakob Pachia inn lang</para>
  <para style="q2">kaethung oh sih;</para>
  <para style="q1">aning nynh a laanpi kha</para>
  <para style="q2">oun ccangpah cih zah,</para>
  <para style="q1">aening nynh a ccunoh kha</para>
  <para style="q2">ah zui cih oh,” cite a ho cih hae.</para>
  <para style="q1">Pawccecize ccangpyanaw tuh</para>
  <para style="q2">Zion kyate yn pou cih zah,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> bya tuh</para>
  <para style="q2">Jerusalem kyate yn pou cih.</para>
  <para style="q1">
    <verse number="3" style="v" />Aning nynh minphuin patae kha</para>
  <para style="q2">bya a pia cih hae zah,<note caller="-" style="x"><char style="xo" closed="false">4.3: </char><char style="xt" closed="false"><ref loc="JOL 3:10">Joe 3.10</ref></char></note></para>
  <para style="q1">asawnaw um hae paw</para>
  <para style="q2">minphuin athung hae paw kha</para>
  <para style="q1">a hopia cih hae.</para>
  <para style="q2">Minmin nynh mih thaloi hae kha</para>
  <para style="q1">thetamuin lang a suh cih hae zah,</para>
  <para style="q2">mih ccoi hae kha rungkou lang</para>
  <para style="q1">a suh cih hae;</para>
  <para style="q2">minphuin phuin kheit te</para>
  <para style="q1">phuin kheit nynh thaloi</para>
  <para style="q2">hangnuakuh vae lan khyh hae zah,</para>
  <para style="q1">rhawtuk thyanaw kha</para>
  <para style="q2">ccangkuh vae lan khyh hae;</para>
  <para style="q1">
    <verse number="4" style="v" />ccungccaw balyn nynh</para>
  <para style="q2">mih misu ku te</para>
  <para style="q2">mih thaeku ku kaw khe</para>
  <para style="q1">a haung cih hae zah,</para>
  <para style="q2">humhung nynh mah</para>
  <para style="q1">rinaw pya vae lan khyh hae;<note caller="-" style="x"><char style="xo" closed="false">4.4: </char><char style="xt" closed="false"><ref loc="ZEC 3:10">Zek 3.10</ref></char></note></para>
  <para style="q2">pawccecize vaaw <char style="nd">Bawipaw </char> nynh</para>
  <para style="q1">phe a ho vae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" />Ccungccaw balyn tuh</para>
  <para style="q2">mimaw mih pachia min raveih kha</para>
  <para style="q1">a beik hae, thuasalama aening tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> ah Pachia min kha</para>
  <para style="q1">zungzae ah beik cih oh.</para>
  <para style="b" />
  <para style="s1">Kithui lanpaw Byakinpyakunaw</para>
  <para style="q1">
    <verse number="6" style="v" />
    <char style="nd">Bawipaw </char> nynh a hopaw tuh,</para>
  <para style="q2">tuin nin vae tuh,</para>
  <para style="q1">mih ccukhou hae paw kha</para>
  <para style="q2">ka pum cih hae zah,</para>
  <para style="q1">dee athua hae paw te vawsaw</para>
  <para style="q2">ka teingsah hae paw kha ka suelua cih hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Mih ccukhou hae paw kha</para>
  <para style="q2">a laehypaw lang ka rae cih hae zah,</para>
  <para style="q1">vua athua hae paw kha</para>
  <para style="q2">athungpaw minphuin lang</para>
  <para style="q1">ka rae cih hae;</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh minmin kha</para>
  <para style="q1">Zion Mua kyakhe</para>
  <para style="q2">atu te zungzae cia a uk cih hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" />Pou tuuphu hae kya-e rhawviainn,</para>
  <para style="q2">Zion ccanung kya-e sangpyng,</para>
  <para style="q1">langmawlya e uknaw kaw,</para>
  <para style="q2">ccanung Jerusalem kya-e</para>
  <para style="q1">kawhoinaw kha</para>
  <para style="q2">nang nynh na muethui cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" />Pawccemou atu thawte na raw?</para>
  <para style="q2">Na kya siapharan um khyh tou?</para>
  <para style="q1">Tuanaw ae pyatupaw tuh a chih vae tou?</para>
  <para style="q2">Neitangia accihpaw nopi hawte,</para>
  <para style="q2">pawccemou na teing?</para>
  <para style="q1">
    <verse number="10" style="v" />Pou Zion ccanung,</para>
  <para style="q2">neitangia a ccihpaw nopi hawte</para>
  <para style="q1">teingte hawkhaeku tua;</para>
  <para style="q2">pawccecize atu khuapi kyate</para>
  <para style="q1">na pou cih zah</para>
  <para style="q2">ramkaw kya ryahmin na tahkuh cih;</para>
  <para style="q1">Babilon lang na cceih cih.</para>
  <para style="q2">Tuin kyakhe luesah na thua cih zah,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh na rhaw hae kuih kyate</para>
  <para style="q2">ae shawkhaw cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" />Atu minphuin patae nynh rawsete</para>
  <para style="q2">ae pumnuakuh hae zah,</para>
  <para style="q1">“Zion tuh nungsikuh sah,</para>
  <para style="q2">aning tungvaw khe</para>
  <para style="q2">kae mit lungtua sah,” a ci hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Thuasalama minmin nynh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> tuanaw kha</para>
  <para style="q1">nyh khyh hae; a paccynnaw kha</para>
  <para style="q2">thaethya khyh hae,</para>
  <para style="q1">loohcce hae kha huimin kya</para>
  <para style="q2">a suelua hae hawte</para>
  <para style="q2">minmin kha a suelua vae hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Pou Zion ccanung, thokuh lah,</para>
  <para style="q2">loohcce hae kha tintua hae,</para>
  <para style="q1">na ki kha sivaw te ka rae cih zah,</para>
  <para style="q2">na ccukoh hae kha</para>
  <para style="q1">sohin te ka rae cih,</para>
  <para style="q2">minphuin patae kha</para>
  <para style="q1">zoihtatyh lan na pae cih hae,</para>
  <para style="q2">minmin nynh a mue hae paw</para>
  <para style="q1">uccaw hae kha <char style="nd">Bawipaw </char> kalan</para>
  <para style="q2">na pya cih,</para>
  <para style="q1">mih sisua kha laephi pynpi</para>
  <para style="q2">a uktu Bawipaw kha na pya cih.</para>
  <chapter number="5" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Atu nanning kha koihlunawpaw</para>
  <para style="q2">pang te koihlu na thua vae oh;</para>
  <para style="q1">aening kha phe oun law vae hae;</para>
  <para style="q2">Israel uktupaw byaki kha</para>
  <para style="q1">tungbang te a bua vae hae.</para>
  <para style="b" />
  <para style="s1">Bethlehem kyate Uktu Bawi</para>
  <para style="q1">
    <verse number="2" style="v" />Pou Bethlehem Efrath,</para>
  <para style="q2">nang tuh Judah ram kyaze</para>
  <para style="q1">adihpaw khua na thua zemah,</para>
  <para style="q2">Israel a uk cih paw bawi tuh</para>
  <para style="q1">na kyate ka hanlan yn langkuh cih,</para>
  <para style="q2">aning athonaw tuh langmawlya,</para>
  <para style="q1">alawe vae paw ccyh kya</para>
  <para style="q2">a la um vae paw nynh thua.<note caller="-" style="x"><char style="xo" closed="false">5.2: </char><char style="xt" closed="false"><ref loc="MAT 2:6">Mat 2.6</ref>; <ref loc="JHN 7:42">Joh 7.42</ref></char></note></para>
  <para style="q1">
    <verse number="3" style="v" />Tukeiccuze neitangia a ccihpaw</para>
  <para style="q2">nopinung tuh neitaw</para>
  <para style="q1">a pui mawlaezung cia</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh Israel hae tuh</para>
  <para style="q1">a vua cih hae;</para>
  <para style="q2">te a laehypaw a uno hae tuh</para>
  <para style="q2">Israel hae kalan a ki cih hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Te aning tuh a thadyn cih zah</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> thawzung khate thuasah,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> a Pachia min</para>
  <para style="q2">lesaenaw khate thuasah</para>
  <para style="q2">a tuuphu hae kha looh a dang cih hae.</para>
  <para style="q1">Minmin tuh khyndadyh lan</para>
  <para style="q2">a um cih hae, pawccecize aning tuh</para>
  <para style="q1">laephi adianaw cia</para>
  <para style="q2">alesaepaw athua cih;</para>
  <para style="q1">
    <verse number="5" style="v" />aning tuh daenaw ccungccaw athua cih.</para>
  <para style="b" />
  <para style="q2">Assiria hae tuh ah</para>
  <para style="q1">ram lungkhu lang oun tee hae zah,</para>
  <para style="q2">ah laephi kha he oun sy hae ze,</para>
  <para style="q1">tuurin lu sari te uktu lu tarya kha</para>
  <para style="q2">minmin dou khylan saw lan hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Minmin nynh Assiria ram,</para>
  <para style="q2">Nimrod ram kha thaloi te</para>
  <para style="q1">a uk cih hae zah, Assiria hae nynh</para>
  <para style="q2">ah ram lungkhu lang</para>
  <para style="q1">oun tee hae ze thuasah,</para>
  <para style="q2">ah ramri lungkhu</para>
  <para style="q1">oun sy hae ze thuasah</para>
  <para style="q2">minmin nynh aening kha</para>
  <para style="q1">oun khum cih hae.<note caller="-" style="x"><char style="xo" closed="false">5.6: </char><char style="xt" closed="false"><ref loc="GEN 10:8-11">Gen 10.8-11</ref></char></note></para>
  <para style="b" />
  <para style="s1">A Laehy hae paw hanlan Malang Ccyh</para>
  <para style="q1">
    <verse number="7" style="v" />Minphuin patae nynh</para>
  <para style="q2">a umlu hae paw</para>
  <para style="q1">Jakob ciihan a laehy hae paw tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kyate yn ccahpaw</para>
  <para style="q1">dangtui hawte thuasah,</para>
  <para style="q2">lonua vawlan accawpaw</para>
  <para style="q1">khuaa hawte thuasah athua cih hae,</para>
  <para style="q2">tuh-e khuaa tuh ccungccaw kha</para>
  <para style="q1">doliakuh khyh zah, a chihthyapaw</para>
  <para style="q2">humhung kha sanmah</para>
  <para style="q2">ngaehoikuh khyh.</para>
  <para style="q1">
    <verse number="8" style="v" />Minphuin hae laku kya</para>
  <para style="q2">ccungccaw patae nynh</para>
  <para style="q1">a umlu hae paw Jakob ciihan</para>
  <para style="q2">a laehy hae paw tuh ramkaw e</para>
  <para style="q1">loramsaw hae laku umpaw</para>
  <para style="q2">chindeih hawte thuasah,</para>
  <para style="q1">tuuphu hae laku umpaw</para>
  <para style="q2">chindeih nopaw hawte thuasah athua cih hae;</para>
  <para style="q1">chindeih nynh po a ccia vae ze,</para>
  <para style="q2">khumtu lu kheit san a um lei lan ciate,</para>
  <para style="q1">tuu hae kha syde hae zah</para>
  <para style="q2">zoihtatyh lan a pae hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Nang ae rawse hae paw kha</para>
  <para style="q2">na tae cih hae,</para>
  <para style="q1">na rhaw hae balyn tuh</para>
  <para style="q2">ro athua cih hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" />
    <char style="nd">Bawipaw </char> nynh a hopaw tuh,</para>
  <para style="q2">tuin nin vae tuh,</para>
  <para style="q1">nanning laku e nae marang hae kha</para>
  <para style="q2">ka maemih cih hae zah,</para>
  <para style="q1">nae marangle hae kha</para>
  <para style="q2">ka roh cih hae;</para>
  <para style="q1">
    <verse number="11" style="v" />nae ram e khuapi hae kha</para>
  <para style="q2">ka roh cih hae zah,</para>
  <para style="q1">nae rhawlungrua balyn kha</para>
  <para style="q2">ka ting cih;</para>
  <para style="q1">
    <verse number="12" style="v" />naawthya hae paw kha</para>
  <para style="q2">ka roh cih hae zah,</para>
  <para style="q1">nae kya beidinhothya hae paw</para>
  <para style="q2">um vae lan khyh hae;</para>
  <para style="q1">
    <verse number="13" style="v" />nae kya um hae paw zohtuh hae te</para>
  <para style="q2">na beik oh paw tung hae kha</para>
  <para style="q1">ka roh cih hae, nae kuih te</para>
  <para style="q2">na raeku oh paw kha</para>
  <para style="q2">na beik vae lan khyh oh;</para>
  <para style="q1">
    <verse number="14" style="v" />nae kya umpaw</para>
  <para style="q2">Asherah zohtuh hae kha</para>
  <para style="q1">ka khulia cih hae zah,</para>
  <para style="q2">nae khua hae kha ka roh cih.</para>
  <para style="q1">
    <verse number="15" style="v" />Ka bya a ngae lei hae paw</para>
  <para style="q2">minphuin hae kha</para>
  <para style="q1">thinria bungpaw te ka liaru cih hae.</para>
  <para style="b" />
  <chapter number="6" style="c" />
  <para style="s1">Pachia nynh Israel Seibenaw</para>
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> nynh a hopaw</para>
  <para style="q2">bya hynh thaetua oh:</para>
  <para style="q1">Tho oh lah, mua hae malang khe</para>
  <para style="q2">nae byathan kha hopya tua oh,</para>
  <para style="q1">sangpyng hae nynh</para>
  <para style="q2">nae roi kha thae hae sah.</para>
  <para style="q1">
    <verse number="2" style="v" />Pou mua hae, zungzae atynpaw</para>
  <para style="q2">laephi athonaw aleihpaw hae,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> byathan hynh ngaetua oh;</para>
  <para style="q2">pawccecize <char style="nd">Bawipaw </char> tuh</para>
  <para style="q1">a ccungccaw hae tungvaw</para>
  <para style="q2">byathan hoi zah,</para>
  <para style="q1">Israel te bya a eikuh cih hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" />“Pou ka ccungccaw hae,</para>
  <para style="q2">nanning kha pawmou kae cyi oh?</para>
  <para style="q1">Pawtemou nae thaw kae bang sah oh?</para>
  <para style="q2">Oun khungtua oh!</para>
  <para style="q1">
    <verse number="4" style="v" />Nanning kha Izip ram kyate</para>
  <para style="q2">kae cciakhae thung oh zah,</para>
  <para style="q2">seetangnaw kyate kae shawkhaw oh;</para>
  <para style="q1">nae malang khe Moses, Aaron te</para>
  <para style="q2">Miriam kha kae sawpya oh.<note caller="-" style="x"><char style="xo" closed="false">6.4: </char><char style="xt" closed="false"><ref loc="EXO 4:10-16">Exo 4.10-16</ref>, <ref loc="EXO 12:50-51">12.50-51</ref>, <ref loc="EXO 15:20">15.20</ref></char></note></para>
  <para style="q1">
    <verse number="5" style="v" />Pou ka ccungccaw hae,</para>
  <para style="q2">Moab siapharan Balak nynh</para>
  <para style="q1">a paccynkupaw kha thuasah,</para>
  <para style="q2">Beor ccapaw Balaam nynh</para>
  <para style="q1">bya a khungrupaw kha thuasah</para>
  <para style="q2">liathui oh, <char style="nd">Bawipaw </char> nynh</para>
  <para style="q1">nanning khum khylan</para>
  <para style="q2">a cyipaw kha na ny nawlan oh,</para>
  <para style="q1">Shittim kyate Gilgal kyacia</para>
  <para style="q2">acyihkuhpaw kha</para>
  <para style="q1">liathuitua oh,” a cipya hae.<note caller="-" style="x"><char style="xo" closed="false">6.5: </char><char style="xt" closed="false"><ref loc="NUM 22:2-24:25">Nam 22.2—24.25</ref>; <ref loc="JOS 3:1-4:19">Jos 3.1—4.19</ref></char></note></para>
  <para style="b" />
  <para style="s1">Pachia nynh A Rypaw</para>
  <para style="q1">
    <verse number="6" style="v" />
    <char style="nd">Bawipaw </char> malang khe</para>
  <para style="q2">paw ccyngpyate mou ka cceih cih zah,</para>
  <para style="q1">ahangnaw umpaw</para>
  <para style="q2">Pachia malang khe ka beik cih?</para>
  <para style="q1">Maee-ute silawnaw te kum kheitpaw</para>
  <para style="q2">vaetuataw hae khate tou</para>
  <para style="q2">amaw kalan ka cceih cih?</para>
  <para style="q1">
    <verse number="7" style="v" />
    <char style="nd">Bawipaw </char> nynh tuutepaw</para>
  <para style="q2">thong kheit te chitui vawpi</para>
  <para style="q1">thong haw kha a lungrythua vema?</para>
  <para style="q2">Ka cyiseimenaw hanlan</para>
  <para style="q1">ka ccatawccaw kha tou ka pya cih?</para>
  <para style="q2">Ka thinlung seinaw hanlan</para>
  <para style="q2">ka ccaaw kha tou ka pya cih?</para>
  <para style="q1">
    <verse number="8" style="v" />Pou ccungccapaw, aning nynh</para>
  <para style="q2">ahoypaw kha phe ae hopya vae;</para>
  <para style="q1">dingrarih lante cyi lanpaw,</para>
  <para style="q2">thawccinaw hoi lanpaw te</para>
  <para style="q1">zakawsangsakute Pachia malang</para>
  <para style="q2">hiin lanpaw kha</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh nang</para>
  <para style="q2">ae ngiapaw thua khyh tou?</para>
  <para style="b" />
  <para style="s1">Hynhunaw te Puathonaw kha Detahnaw</para>
  <para style="q1">
    <verse number="9" style="v" />
    <char style="nd">Bawipaw </char> roi tuh</para>
  <para style="q2">khuapi kya accae</para>
  <para style="q1">(na min kha rawrinaw tuh hawnaw nynh thua):</para>
  <para style="q2">Pou khuapi kya a pumkuh hae paw,</para>
  <para style="q2">ngaetua oh!</para>
  <para style="q1">
    <verse number="10" style="v" />Ccungccaw hoylei hae inn kya</para>
  <para style="q2">umpaw ahme leite a mue hae paw sisua te</para>
  <para style="q1">ahme leipaw tounawpaw</para>
  <para style="q2">khinlung kha ka ning kho cih tou?</para>
  <para style="q1">
    <verse number="11" style="v" />Ahme leipaw zawccu te</para>
  <para style="q2">ahme leipaw khinlung</para>
  <para style="q1">a mang hae paw tungvaw</para>
  <para style="q2">ka ngaesang kho cih tou?</para>
  <para style="q1">
    <verse number="12" style="v" />Khua lungkhu e mihoi hae tuh</para>
  <para style="q2">puathonaw te phe abeih hae;</para>
  <para style="q1">khua kya um hae paw tuh</para>
  <para style="q2">hynbya ho hae zah,</para>
  <para style="q1">mih khalang lungkhu kya</para>
  <para style="q2">hynbya a hopaw lae a um.</para>
  <para style="q1">
    <verse number="13" style="v" />Tuhcite na seinaw keiccuze</para>
  <para style="q2">nang kha vuate ro khylan</para>
  <para style="q2">ka thotakaw vae.</para>
  <para style="q1">
    <verse number="14" style="v" />Na ae zemah na byn lan khyh,</para>
  <para style="q2">na lungkhu kya kanmawnaw</para>
  <para style="q1">a um cih; na mue zemah</para>
  <para style="q2">na ccakhungkuh lan khyh,</para>
  <para style="q1">na ccakhungkupaw kha</para>
  <para style="q2">thaloi rhaw kalan ka pya cih.</para>
  <para style="q1">
    <verse number="15" style="v" />Ccacii na tu zemah</para>
  <para style="q2">looh na rue lan khyh;</para>
  <para style="q1">chitui na miaa zemah</para>
  <para style="q2">chitui kha na thuhkuh lan khyh;</para>
  <para style="q1">misu thae na su zemah</para>
  <para style="q2">misutui na neih lan khyh.</para>
  <para style="q1">
    <verse number="16" style="v" />Pawccecize Omri siapharan</para>
  <para style="q2">phungbya kha thuasah,</para>
  <para style="q1">Ahab siapharan nynh</para>
  <para style="q2">a cyipaw balyn kha thuasah</para>
  <para style="q1">na zui zah, minmin nynh</para>
  <para style="q2">tuanaw ae pya hae paw kha na zui.</para>
  <para style="q1">Tukeiccuze nang tuh</para>
  <para style="q2">ccungccaw adaepaw lang</para>
  <para style="q1">kae rae cih zah, khuaccaaw hae kha</para>
  <para style="q2">a sarya hae paw lang ka rae cih hae;</para>
  <para style="q1">tuhcite nang tuh ccungccaw hae nynh</para>
  <para style="q2">nuinsenaw kha na teing cih.<note caller="-" style="x"><char style="xo" closed="false">6.16: </char><char style="xt" closed="false"><ref loc="1KI 16:23-34">1Si 16.23-34</ref>, <ref loc="1KI 21:25-26">21.25-26</ref></char></note></para>
  <para style="b" />
  <chapter number="7" style="c" />
  <para style="s1">A Ozia Thahpaw Israel</para>
  <para style="q1">
    <verse number="1" style="v" />Ka hanlan ngaethya lan kou um!</para>
  <para style="q2">Hawnin ccyh kya thingthae</para>
  <para style="q1">lo koute a muihkuh leipaw hawte thuasah,</para>
  <para style="q2">misu thae lo koute</para>
  <para style="q1">ange kya ae lanpaw</para>
  <para style="q2">a muihkuh leipaw hawte thuasah</para>
  <para style="q1">ka thua vae;</para>
  <para style="q2">ka ae rypaw avoi typaw</para>
  <para style="q1">thaeku thae kha um vae khyh.</para>
  <para style="q1">
    <verse number="2" style="v" />Ram lungkhu kya alungzipaw</para>
  <para style="q2">ccungccaw um vae khyh,</para>
  <para style="q1">adingpaw ccungccaw</para>
  <para style="q2">lu kheit san um vae khyh;</para>
  <para style="q1">mih balynte ccungccaw kha</para>
  <para style="q2">chia lan buhkhaw hae zah,</para>
  <para style="q1">lu kheit te lu kheit</para>
  <para style="q2">kaang a syakhawkuh hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Ahoy leipaw cyi nawlan</para>
  <para style="q2">mih kuih tuh myarya apuakuh;</para>
  <para style="q1">bawi te byapiatu hae nynh</para>
  <para style="q2">pyaruh kha a ngia hae,</para>
  <para style="q1">kaw a hoipaw nynh a rypaw kha</para>
  <para style="q2">hopah hae zah, tuhcite byading kyate a cceihsei hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Minmin kyaze ahoy huaccepaw tuh</para>
  <para style="q2">thabu hawte thua zah,</para>
  <para style="q1">minmin kyaze ading huaccepaw tuh</para>
  <para style="q2">tureih kya-e hinpaw hawte nynh thua.</para>
  <para style="q1">Pachia nynh raeringnaw</para>
  <para style="q2">a la pya vae hae hawte,</para>
  <para style="q1">minmin detahnaw nin tuh yn thua vae;</para>
  <para style="q2">atu tuh mih lungmuanaw ccyh nynh thua vae.</para>
  <para style="q1">
    <verse number="5" style="v" />Na banpaw kha zyn nan,</para>
  <para style="q2">na sungsahpaw kha doliakuh nan;</para>
  <para style="q1">na by vawlan a ihpaw na zu kya heize</para>
  <para style="q2">raeringkute byaho;</para>
  <para style="q1">
    <verse number="6" style="v" />pawccecize ccapaw nynh</para>
  <para style="q2">a paaw kha a thethyasah zah,</para>
  <para style="q1">ccanung nynh a nung kha a rawse,</para>
  <para style="q2">monung nynh a ninnung kha a rawse;</para>
  <para style="q1">nae rhaw hae tuh nae innbyn kya-e</para>
  <para style="q2">ccungccaw hae kha nynh athua hae.<note caller="-" style="x"><char style="xo" closed="false">7.6: </char><char style="xt" closed="false"><ref loc="MAT 10:35-36">Mat 10.35-36</ref>; <ref loc="LUK 12:53">Luk 12.53</ref></char></note></para>
  <para style="q1">
    <verse number="7" style="v" />Thuasalama kae tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha ka ccung cih,</para>
  <para style="q1">yn khumtu Pachia kha</para>
  <para style="q2">ka ngaehoikuh cih;</para>
  <para style="q1">ka Pachia nynh yn thaepah cih.</para>
  <para style="b" />
  <para style="s1">Ngaesikunaw te Pachia Doliakunaw</para>
  <para style="q1">
    <verse number="8" style="v" />Pou ka rhawpaw, ka tungvaw</para>
  <para style="q2">na lungtua nan sah;</para>
  <para style="q1">kae tuh ka khuliaku ze</para>
  <para style="q2">ka thokuh cih, mohnaw kya</para>
  <para style="q1">ka haung ze <char style="nd">Bawipaw </char> tuh</para>
  <para style="q2">ka hanlan awnaw athua cih.</para>
  <para style="q1">
    <verse number="9" style="v" />
    <char style="nd">Bawipaw </char> tungvaw</para>
  <para style="q2">ka sei keiccuze</para>
  <para style="q1">a thinrianaw kha ka teing cih,</para>
  <para style="q2">aning nynh yn pankhae zah,</para>
  <para style="q1">bya yn piapya mawlaezung ka teing cih.</para>
  <para style="q2">Awnaw kalan khe</para>
  <para style="q1">yn poukhae cih zah, amaw kya-e</para>
  <para style="q2">thyaaccounaw kha ka mue cih.</para>
  <para style="q1">
    <verse number="10" style="v" />Tetuh, “<char style="nd">Bawipaw </char> na Pachia tuh</para>
  <para style="q2">teimou a um?” cite</para>
  <para style="q1">yn khiapaw ka rhawpaw nynh</para>
  <para style="q2">tuh-e tuh a muih cih zah a maethah cih.</para>
  <para style="q1">Aning nynh a shungpaw kha</para>
  <para style="q2">ka muih cih; laanpi e tuiccua hawte</para>
  <para style="q1">amaw kha syde athua cih.</para>
  <para style="b" />
  <para style="s1">Ki lanpaw Kong Profehbya</para>
  <para style="q1">
    <verse number="11" style="v" />Na khualungrua raenaw ccyh yn thua cih!</para>
  <para style="q2">Tuin nin vae tuh na ram tuh akochih cih.</para>
  <para style="q1">
    <verse number="12" style="v" />Tuin nin vae tuh Assiria ram te</para>
  <para style="q2">Izip khuapi hae kyate thuasah,</para>
  <para style="q1">Izip ram te Vawpi kyate thuasah,</para>
  <para style="q2">rili kin hae te mua hae miakaw kyate thuasah</para>
  <para style="q2">na kalan oun cceih cih hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Thuasalama tuh-e laephi kya-e ccungccaw hae</para>
  <para style="q2">mih cyisahnaw ahoy leipaw keiccuze</para>
  <para style="q1">tuh-e laephi tuh ccungccaw phe adae cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" />Na tuuphu athuapaw</para>
  <para style="q2">na ccungccaw hae hynh</para>
  <para style="q1">na hoitang te rin hae, minmin tuh</para>
  <para style="q2">ramkaw kya ramnonaw khe</para>
  <para style="q1">mih makhaete a um hae paw</para>
  <para style="q2">na tuuphu nynh thua hae;</para>
  <para style="q1">langmawlya hawte,</para>
  <para style="q2">Bashan te Gilead kyakhe</para>
  <para style="q2">rampaeesakuh hae.</para>
  <para style="q1">
    <verse number="15" style="v" />Izip ram kyate na pou lya hawte,</para>
  <para style="q2">ngaeang lan umpaw uccaw hae kha</para>
  <para style="q2">kaening oun muihsah.</para>
  <para style="q1">
    <verse number="16" style="v" />Minphuin hae nynh</para>
  <para style="q2">a muih cih hae zah,</para>
  <para style="q1">mih thawzung balyn kha</para>
  <para style="q2">mih maethyakhaekuh cih;</para>
  <para style="q1">mih mung kha mih kuih te</para>
  <para style="q2">a huhkuh cih hae;</para>
  <para style="q2">mih nakaring mah nawthae lan khyh;</para>
  <para style="q1">
    <verse number="17" style="v" />hupaw hawte thuasah,</para>
  <para style="q2">laekhu kya avawpaw hawte thuasah</para>
  <para style="q1">laenoi kha a lya cih hae.</para>
  <para style="q2">mih rhawlungrua alungkhu kyate</para>
  <para style="q1">thyngkute a pou cih hae;</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> ah Pachia kalan khe</para>
  <para style="q1">thinphang ri biate oun ki cih hae,</para>
  <para style="q2">te na rawri biate a thadyn cih hae.</para>
  <para style="b" />
  <para style="s1">Pachia Sungsahnaw te Ngaethyaumsahnaw</para>
  <para style="q1">
    <verse number="18" style="v" />Hoyleinaw kha ngaethyate,</para>
  <para style="q2">a laehypaw a rho ccungccaw hae</para>
  <para style="q1">mih cyiseimenaw kha</para>
  <para style="q2">a ngaethya hae paw,</para>
  <para style="q1">nang ae lopaw Pachia hummou a um?</para>
  <para style="q2">A thawccinaw langsakunaw kyakhe</para>
  <para style="q1">a lungrythua keiccuze</para>
  <para style="q2">aning tuh zungzae a thinria khyh.</para>
  <para style="q1">
    <verse number="19" style="v" />Aning nynh aening kha</para>
  <para style="q2">ngaethya bua oun umsah cih zah,</para>
  <para style="q1">aening hoyleinaw balyn kha</para>
  <para style="q2">a ccu kaw khe a syde cih.</para>
  <para style="q1">Kae seinaw balyn kha</para>
  <para style="q2">rili akhupaw lungkhu langkhe na vua cih.</para>
  <para style="q1">
    <verse number="20" style="v" />Langmawlya kae minpaaw hae kya</para>
  <para style="q2">bya na kinku vae hawte,</para>
  <para style="q1">na lungzinaw kha Jakob kya</para>
  <para style="q2">na langsakuh cih zah,</para>
  <para style="q1">arulaekuh leipaw na sungsahnaw kha</para>
  <para style="q2">Abraham kya na langsakuh cih.</para>
</usx>