<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="HOS" style="id">Baebu Thyaa</book>
  <para style="h">HOSEA</para>
  <para style="toc1">Hosea</para>
  <para style="toc2">HOSEA</para>
  <para style="toc3">Hos</para>
  <para style="mt1">HOSEA</para>
  <para style="mt2">Hosea</para>
  <para style="imt">Byalaanmaw</para>
  <para style="ip">Profeh Hosea nynh phung a honaw hmin tuh thahlang Israel peenaw kya thua zah profeh Amos mawze, BC 721 kum Samaria aro maw vawsaw ccyh lya nynh thua. Aning nynh a ho huapaw bya tuh Israel hae nynh zohtuh a beik hae paw kong te Pachia tungvaw mih lungzi leinaw kong nynh thua. Tuh-e lungzi leinaw tuh Hosea nynh a lungzi leipaw nopi kha amaw a zu lang a umkhaepaw khate phe lokuh, a ci. A zu Gomer nynh a tungvaw a lungzi khyh hawte Pachia ccungccaw hae nynh Bawipaw kha a vua hae. E keiccuze Israel hae tuh byapianaw a ing cih hae. Tuhzemah nyathyakou kya atynpaw Pachia sungsahnaw tuh taetu athua cih zah a minphuin kha amaw kalan a kikhae cih zah, mih ccuepekunaw tuh langmaw hawte athuathui cih. Tuh-e sungsahnaw bya tuh 11.8 kya langsakuh zah, “Pou Israel, pawtemou nang kha milae kalan kae ap kho cih? Pawtemou kae vua kho cih?… Ka lungkhu kya ka thinlung tuh arulaekuh vae; nang ngaethya ae umsahpaw ka thinlung tuh nebaleih,” a ci. (11.8)</para>
  <para style="iot">Abyalupi hae</para>
  <para style="io1">Hosea nynh zu a hoinaw te a innbyn 1.1—3.5</para>
  <para style="io1">Israel kha rawsete hopaw bya 4.1—13.16</para>
  <para style="io1">Ngaesikunaw bya te byakinpyakunaw bya 14.1-9</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Judah siapharan Uzziah, Jotham, Ahaz te Hezekiah siapharan hae she lya te Israel siapharan Jeroboam, Joash ccapaw she lyakhe Beeri ccapaw Hosea kalan khe <char style="nd">Bawipaw </char> bya tuh yn thua.<note caller="-" style="x"><char style="xo" closed="false">1.1: </char><char style="xt" closed="false"><ref loc="2KI 14:23-15:7">2Si 14.23—15.7</ref>, <ref loc="2KI 15:32-16:20">15.32—16.20</ref>, <ref loc="2KI 18:1-20:21">18.1—20.21</ref>; <ref loc="2CH 26:1-27:8">2Sh 26.1—27.8</ref>, <ref loc="2CH 28:1-32:33">28.1—32.33</ref></char></note></para>
  <para style="s1">Hosea Innbyn</para>
  <para style="p">
    <verse number="2" style="v" />
    <char style="nd">Bawipaw </char> nynh Hosea kyate masaty bya he a ho te, <char style="nd">Bawipaw </char> nynh Hosea kha, “Cceih lah, ohhuanung kha zu lang dykute ohhuakunaw ccaaw hae kha saahku tua, pawccecize e ram nynh <char style="nd">Bawipaw </char> kha vua zah myarya lepaw ohhuakunaw kha a rae vae,” a cipya. <verse number="3" style="v" />Tukeiccuze Hosea nynh cceih zah Diblaim ccanung Gomer kha zu lang a umkhae, te tuh-e nung nynh ccaawpoi zah ccapaw lu kheit a saahpya.</para>
  <para style="p">
    <verse number="4" style="v" />Te <char style="nd">Bawipaw </char> nynh Hosea kha, “Ccapaw kha Jezreel cite minphutua, pawccecize sosoh aro te Jezreel chiise keiccuze Jehu ciihan hae kha de ka tah cih hae, Israel hae peenaw kha ka thangsah cih.<note caller="-" style="x"><char style="xo" closed="false">1.4: </char><char style="xt" closed="false"><ref loc="2KI 10:11">2Si 10.11</ref></char></note> <verse number="5" style="v" />Tuin nin kya Jezreel accya khe Israel li kha ka khyapah cih,” a ci.</para>
  <para style="p">
    <verse number="6" style="v" />Gomer nynh ccaaw bua poi zah ccanung kha a saah. Te <char style="nd">Bawipaw </char> nynh Hosea kha, “Ccanung kha Lo-ruhamah cite minphutua, pawccecize Israel hae kha ngaethya ka umsah vae lan khyh hae zah, ka ngaethya vae lan khyh hae. <verse number="7" style="v" />Thuasalama Judah kha tuh ngaethya ka umsah cih zah <char style="nd">Bawipaw </char> mih Pachia liate ka khum cih hae; li, thaloi, rhawtuk, marang, marang rhawkaw hae khate ka khum lan khyh hae,” a cipya. <verse number="8" style="v" />Gomer nynh a ccanung kha mateitui he a phia te, ccaawpoi zah ccapaw kha a saah. <verse number="9" style="v" />Te <char style="nd">Bawipaw </char> nynh, “Ccapaw kha Lo-ammi cite minphutua, pawccecize nanning tuh ka ccungccaw hae na thua khyh oh zah kae tuh nae Pachia ka thua khyh,” a ci.</para>
  <para style="s1">Israel kha Bua Dingsahnaw</para>
  <para style="p">
    <verse number="10" style="v" />Tuhzemah Israel hae tuh toutae leipaw te riatae leipaw rili laesia hawte athua cih hae; “Nanning tuh ka ccungccaw hae na thua khyh oh,” cite hopya athuanaw hae hmin kya mawkhe, “Ahiinpaw Pachia ccaaw hae,” cite hopya athua cih hae.<note caller="-" style="x"><char style="xo" closed="false">1.10: </char><char style="xt" closed="false"><ref loc="ROM 9:26">Rom 9.26</ref></char></note> <verse number="11" style="v" />Judah hae te Israel hae tuh pynkheihlan suelua athua cih hae zah, minmin nynh cciakhaetu lu kheit kha a pokuh cih hae; ram kha a ccou cih hae, Jezreel nin tuh alesae cih.</para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Na upaw hae kha Ammi cite ko hae lah, na ccianung hae kha Ruhamah cite ko hae.</para>
  <para style="s1">Israel Lungzi leinaw, Detahnaw te Shawkhawnaw</para>
  <para style="q1">
    <verse number="2" style="v" />Nae nung kha soihbia oh,</para>
  <para style="q2">pawccecize aning tuh</para>
  <para style="q1">ka zu thua vae khyh zah,</para>
  <para style="q2">kae tuh a vawpaw ka thua vae khyh,</para>
  <para style="q1">a ohhuakunaw kha vua zah,</para>
  <para style="q2">milae vawpaw te a seinaw kha</para>
  <para style="q2">a vua nawlan soihbiatua oh,</para>
  <para style="q1">
    <verse number="3" style="v" />tuhkhyhze tuh a boeining kha</para>
  <para style="q2">ka phae cih zah,</para>
  <para style="q1">a pui lya hawte a ccakaete</para>
  <para style="q2">ka umsah cih,</para>
  <para style="q1">ramkaw te ka losakuh cih zah,</para>
  <para style="q2">ramrou lang ka tangsah cih,</para>
  <para style="q1">tui kanmawnaw te</para>
  <para style="q2">aning kha ka chisah cih.</para>
  <para style="q1">
    <verse number="4" style="v" />A ccaaw hae tuh ohhuakunaw</para>
  <para style="q2">ccaaw hae athua hae keiccuze,</para>
  <para style="q1">a ccaaw hae kha ngaethya</para>
  <para style="q2">ka umsah lan khyh hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Pawccecize mih nung tuh</para>
  <para style="q2">a ohhuakuh;</para>
  <para style="q1">minmin a poitu hae aning tuh</para>
  <para style="q2">maethya lan umpaw kha a rae vae.</para>
  <para style="q1">Pawccecize aning nynh,</para>
  <para style="q2">“Ka sungsah hae nulang</para>
  <para style="q1">ka zuikuh cih;</para>
  <para style="q2">minmin nynh kae kha</para>
  <para style="q1">sanlou te tui, tuuming te laaw,</para>
  <para style="q2">chitui te niapaw atui kha</para>
  <para style="q2">yn pya hae,” a ci.</para>
  <para style="q1">
    <verse number="6" style="v" />Tukeiccuze a laanpi kha</para>
  <para style="q2">hinpawbu te ka khaw cih;</para>
  <para style="q1">a ccianaw a muihku khyh ccaw cite</para>
  <para style="q2">lungrua ka ruakhaw cih.</para>
  <para style="q1">
    <verse number="7" style="v" />A sungsah hae kha</para>
  <para style="q2">deehui hae salamah</para>
  <para style="q2">phah lan khyh hae;</para>
  <para style="q1">minmin kha ccung hae salamah</para>
  <para style="q2">muih lan khyh hae.</para>
  <para style="q1">Tetuh aning nynh, “Masaty e</para>
  <para style="q2">ka vawpaw kalan ka kithui cih,</para>
  <para style="q1">pawccecize atu laeze</para>
  <para style="q2">langmawlya kha ka hanlan</para>
  <para style="q2">ahoyhua,” cite a ho cih.</para>
  <para style="q1">
    <verse number="8" style="v" />Aning kha ccathae, misutui te</para>
  <para style="q2">chitui a pyatu tuh</para>
  <para style="q1">kae ka thuapaw kha nyh khyh zah,</para>
  <para style="q2">Baal pachia hanlan</para>
  <para style="q2">a mang hae paw sui te ngun kha</para>
  <para style="q1">hysahte a pyatu tuh kae ka thuapaw kha</para>
  <para style="q2">nyh khyh hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Tukeiccuze loohrue ccyh kya</para>
  <para style="q2">ka ccathae kha ka lahthui cih zah,</para>
  <para style="q1">misutui non ccyh kya</para>
  <para style="q2">ka misutui kha mah ka lahthui cih;</para>
  <para style="q1">a ccakaete um zah</para>
  <para style="q2">bong khylan ka pyapaw</para>
  <para style="q2">ka tuuming te ka laaw kha ka lah cih.</para>
  <para style="q1">
    <verse number="10" style="v" />Atu a sungsah hae muihnaw khe,</para>
  <para style="q2">a boeining kha phaete maethya ka law cih,</para>
  <para style="q1">humhung nynh mah</para>
  <para style="q2">ka kuih kyate luesah lan khyh.</para>
  <para style="q1">
    <verse number="11" style="v" />A lungpawnaw, a poi hae,</para>
  <para style="q2">sawpawdia ccyh hae,</para>
  <para style="q2">a sabbath hae te</para>
  <para style="q1">accyh khyapaw a poi hae balyn kha</para>
  <para style="q2">ka thangsah cih.</para>
  <para style="q1">
    <verse number="12" style="v" />“E hae tuh ka sungsah hae nynh</para>
  <para style="q2">yn pya hae paw nynh thua,” cite</para>
  <para style="q1">aning nynh a hopaw a misu ku hae te</para>
  <para style="q2">a thaeku ku hae kha ka roh cih.</para>
  <para style="q1">Khah-e hae kha ramkaw lang</para>
  <para style="q2">ka tangsah cih zah,</para>
  <para style="q2">loramsaw hae nynh a ae cih hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Baal pachia hae hanlan</para>
  <para style="q2">mynkhuhpaw kha upyate,</para>
  <para style="q1">a kuihpu te aphutepaw</para>
  <para style="q2">lung khate ccaankuh zah,</para>
  <para style="q1">kae kha ningte, a sungsah</para>
  <para style="q2">hae nulang a zuiku nin,</para>
  <para style="q1">Baal pachia hae poi nin keiccuze</para>
  <para style="q2">aning kha de ka tah cih, cite</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh a ci.</para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" />Tukeiccuze, atu aning kha</para>
  <para style="q2">ka soihtua cih,</para>
  <para style="q1">ramkaw lang ka cciakhae cih zah,</para>
  <para style="q2">nebaleih lan ka hopah cih.</para>
  <para style="q1">
    <verse number="15" style="v" />Tuin kyakhe a misu khokhu kha</para>
  <para style="q2">ka pya cih, Akhor Accya kha</para>
  <para style="q2">ngaehoinaw thuakaw lang ka rae cih.</para>
  <para style="q1">Tuin kyakhe aning a zawthaw lya,</para>
  <para style="q2">Izip ram kyate yn pou lya hawte</para>
  <para style="q1">yn leihru cih.<note caller="-" style="x"><char style="xo" closed="false">2.15: </char><char style="xt" closed="false"><ref loc="JOS 7:24-26">Jos 7.24-26</ref></char></note></para>
  <para style="m">
    <verse number="16" style="v" />
    <char style="nd">Bawipaw </char> nynh a hopaw tuh, tuin nin khe nang nynh, “Ka vawpaw,” cite nae ko cih zah, “Ka Baal,” cite nae ko vae lan khyh. <verse number="17" style="v" />Baal hae min kha a mung kyate ka vua cih zah, mih min kha ho thua vae lan khyh. <verse number="18" style="v" />Tuin nin khe loramsaw hae, vaawlang e pavaw hae te laekhu avawthya hae paw ryte nanning hanlan byakinnaw kha ka rae cih; li, thaloi te rhawtuk-zunghe hae kha laephi kyate ka roh cih zah, khyndadyh lan kae isah cih. <verse number="19" style="v" />Nang kha ka zu lang zungzae kae umkhae cih; dingnaw, byading, zungzae tynpaw sungsahnaw te thawccinaw khate ka zu lang kae umkhae cih. <verse number="20" style="v" />Lungzite zu lang kae umkhae cih; te nang nynh <char style="nd">Bawipaw </char> kha na nyh cih.</para>
  <para style="q1">
    <verse number="21" style="v" />
    <char style="nd">Bawipaw </char> nynh a hopaw tuh, tuin nin khe na bya kha kae leih cih,</para>
  <para style="q2">vaawlui bya kha ka thaepah cih zah,</para>
  <para style="q1">vaawlui nynh laephi kha</para>
  <para style="q2">bya a thaepah cih;</para>
  <para style="q1">
    <verse number="22" style="v" />laephi nynh ccathae, misutui te</para>
  <para style="q2">chitui kha bya a thaepah cih hae zah,</para>
  <para style="q1">minmin nynh Jezreel kha</para>
  <para style="q2">bya a thaepah cih hae;</para>
  <para style="q1">
    <verse number="23" style="v" />te aning kha laephi kya</para>
  <para style="q2">kamaw hanlan ccacii lang ka tukuh cih.</para>
  <para style="q1">Te Lo-ruhamah kha</para>
  <para style="q2">ngaethya ka umsah cih,</para>
  <para style="q2">Lo-ammi kha, “Nang tuh</para>
  <para style="q1">ka ccungccaw nynh na thua,” cite</para>
  <para style="q2">ka hopah cih zah,<note caller="-" style="x"><char style="xo" closed="false">2.23: </char><char style="xt" closed="false"><ref loc="ROM 9:25">Rom 9.25</ref>; <ref loc="1PE 2:10">1Pe 2.10</ref></char></note></para>
  <para style="q1">aning nynh, “Nang tuh</para>
  <para style="q2">ka Pachia nynh na thua,” cite</para>
  <para style="q1">a ho cih, a ci.</para>
  <chapter number="3" style="c" />
  <para style="s1">Hosea te A Lungzi leipaw Nopi</para>
  <para style="p">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> nynh kae kha, “Israel hae nynh ccangpaw pachia hae kalan maekute misu thae aroupaw te raepaw sanlou kha a ry hae zemah, <char style="nd">Bawipaw </char> nynh minmin kha a sungsah mamin hae hawte, la cceih lah, vawpaw mang a hoi pite a ohhuakuhnung nopinung kha la sungsah tua,” cite bua yn hopya. <verse number="2" style="v" />Tukeiccuze ngun shekel haw lae pangaw, barli homer ccangkheit te misutui ling kheit khate tuh-e nopinung kha ka re. <verse number="3" style="v" />Te kae nynh amaw kha, “Ka ccungccaw lante nin patae na um cih; na ohhuakuh lan khyh, pise te na ihkheih lan khyh oh, kae te mah ikheih lei lan,” ka cipya. <verse number="4" style="v" />Pawccecize Israel hae tuh siapharan, uktu bawi, silawnaw, athyaapaw tung, ranpibawi angki te terafim zohtuh kha hoi leite nin patae a um cih hae. <verse number="5" style="v" />Tukoute Israel hae tuh a ki cih hae zah <char style="nd">Bawipaw </char> mih Pachia te mih siapharanpaw David kha a ccung cih hae; nyalang ccyh kya tuh <char style="nd">Bawipaw </char> hoynaw kha mue khylan amaw kalan sawtuate a cceih cih hae.</para>
  <chapter number="4" style="c" />
  <para style="s1">Israel tungvaw Seisahnaw Bya</para>
  <para style="p">
    <verse number="1" style="v" />Pou Israel ccungccaw hae, <char style="nd">Bawipaw </char> bya hynh ngaetua oh;</para>
  <para style="q2">pawccecize <char style="nd">Bawipaw </char> tuh ram kya um hae paw tungvaw kya seisahnaw bya a hoi.</para>
  <para style="q1">E ram kya lungzinaw, sungsakunaw um leite,</para>
  <para style="q2">Pachia nynaw um khyh.</para>
  <para style="q1">
    <verse number="2" style="v" />Pekunaw, hynhunaw,</para>
  <para style="q2">ccungccaw chianaw,</para>
  <para style="q1">runaw te milae zu milae vawpaw te</para>
  <para style="q2">seinaw a um;</para>
  <para style="q1">chiise luasakunaw ccangkheit koute</para>
  <para style="q2">ccangkheit a um.</para>
  <para style="q1">
    <verse number="3" style="v" />Tukeiccuze ram tuh rawkhuite um zah,</para>
  <para style="q2">ram lungkhu um hae paw balyn tuh</para>
  <para style="q1">thawthyate a um hae;</para>
  <para style="q2">loramsaw hae, vaawlang e pavaw hae,</para>
  <para style="q1">rili kya-e ngasaw hae heize a zo hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" />Tuhzemah hum nynh sanmah</para>
  <para style="q2">rawse nan sah,</para>
  <para style="q2">hum nynh sanmah ae seisah nan sah,</para>
  <para style="q1">pawccecize, pou ranpibawi,</para>
  <para style="q2">na tungvaw ka lungccing leinaw a um.</para>
  <para style="q1">
    <verse number="5" style="v" />Ninthu khe nang tuh</para>
  <para style="q2">na thy na pawkuh cih;</para>
  <para style="q2">khuazi khe profeh mah nang ryte</para>
  <para style="q1">a thy a pawkuh bua cih,</para>
  <para style="q2">na nung kha mah ka roh cih.</para>
  <para style="q1">
    <verse number="6" style="v" />Ka ccungccaw hae tuh hawnaw</para>
  <para style="q2">azya hae keiccuze aroh hae;</para>
  <para style="q1">nang tuh hawnaw kha na vua keiccuze</para>
  <para style="q2">ka hanlan ranpibawi lang</para>
  <para style="q2">tangnaw kyate nang kha kae vua.</para>
  <para style="q1">Na Pachia kawbya kha</para>
  <para style="q2">na ning vae keiccuze</para>
  <para style="q1">kae nynh mah na ccaaw hae kha</para>
  <para style="q2">ka ning cih hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" />Ranpibawi hae tuh houh lung hae zah,</para>
  <para style="q2">kae kha rawsete houh a sei hae;</para>
  <para style="q2">mih phu-enaw kha</para>
  <para style="q2">maethyanaw lang ka paleih.</para>
  <para style="q1">
    <verse number="8" style="v" />Minmin nynh ka ccungccaw hae</para>
  <para style="q2">seinaw khate a hoirum hae;</para>
  <para style="q2">houhouh sei hae sah ci a ry hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Ccungccaw zapi hae kya acyiku hawte</para>
  <para style="q2">ranpibawi hae kya mah acyihkuh cih;</para>
  <para style="q1">mih ozia keiccu de ka tah cih hae zah,</para>
  <para style="q2">mih cyisahnaw hanlan ka liaru cih hae.</para>
  <para style="q1">
    <verse number="10" style="v" />Minmin tuh a ae hae zemah</para>
  <para style="q2">byn lan khyh hae;</para>
  <para style="q1">a ohhuaku hae zemah</para>
  <para style="q2">pungzae lan khyh hae;</para>
  <para style="q1">pawccecize mimaw toulou kha</para>
  <para style="q2">ohhuakunaw kalan pyakuh hae zah, <verse number="11" style="v" /><char style="nd">Bawipaw </char> kha a vua vae hae.</para>
  <para style="b" />
  <para style="s1">Israel Zohtuh Beiknaw</para>
  <para style="q1">Misutui te athawpaw misutui nianaw nynh</para>
  <para style="q2">nythyanaw kha a zosah.</para>
  <para style="q1">
    <verse number="12" style="v" />Ka ccungccaw hae nynh thingphe kha</para>
  <para style="q2">tuanaw ngiakuh hae zah,</para>
  <para style="q1">phuring-unawpaw mih ccungngue nynh</para>
  <para style="q2">a ny ry hae paw kha a hopya hae.</para>
  <para style="q1">Pawccecize ohhuaku rynaw thinlung nynh</para>
  <para style="q2">minmin kha cciakhaesei hae zah,</para>
  <para style="q2">mih Pachia kha vuate a ohhuaku hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Mua dung hae kyakhe thuasah,</para>
  <para style="q2">sangpyng hae vawlan khe thuasah,</para>
  <para style="q2">a mynlyh ahoypaw phaesi ku kaw,</para>
  <para style="q1">poplar ku kaw, terebint ku kaw khe thuasah</para>
  <para style="q2">silawnaw kha a rae hae.</para>
  <para style="b" />
  <para style="q1">Tukeiccuze nae ccanung hae tuh</para>
  <para style="q2">ohhuakuh hae zah,</para>
  <para style="q1">nae monung hae nynh</para>
  <para style="q2">milae vawpaw te a sei hae.</para>
  <para style="q1">
    <verse number="14" style="v" />Nae ccanung hae nynh</para>
  <para style="q2">a ohhuaku hae ze thuasah,</para>
  <para style="q1">nae monung hae nynh milae vawpaw te</para>
  <para style="q2">a sei hae ze thuasah minmin kha</para>
  <para style="q1">de ka tah lan khyh hae;</para>
  <para style="q2">pawccecize pise hae toulou nynh</para>
  <para style="q1">ohhuanung hae ryte cceihsei hae zah,</para>
  <para style="q2">beikinn e ohhuanung hae ryte</para>
  <para style="q1">silawnaw a raekheih hae;</para>
  <para style="q2">tuhcite nythyanaw a hoi lei</para>
  <para style="q1">hae paw tuh a roh cih hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" />Pou Israel, nang tuh</para>
  <para style="q2">na ohhuaku zemah</para>
  <para style="q1">Judah tuh a seipaw lang tang nan sah.</para>
  <para style="q2">Gilgal khua lang tee nan lah,</para>
  <para style="q1">Beth-aven khua lang cceihthung nan,</para>
  <para style="q2">“<char style="nd">Bawipaw </char> tuh a hiin thyhte,” cite</para>
  <para style="q2">byakinkunaw rae nan.</para>
  <para style="q1">
    <verse number="16" style="v" />A lungkhungpaw vaetua tohlaw hawte,</para>
  <para style="q2">Israel tuh a lungkhung;</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh tuutaw kha</para>
  <para style="q2">akopaw ramnonaw kya</para>
  <para style="q1">a paeesaku hawte,</para>
  <para style="q2">Israel kha atu looh a dang kho cih tou?</para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" />Efraim tuh zohtuh hae kya</para>
  <para style="q2">phang a kyngkuh,</para>
  <para style="q2">aning tuh a um rythyte um sah.</para>
  <para style="q1">
    <verse number="18" style="v" />Mih zu-aenaw kha he a thangsah hae te,</para>
  <para style="q2">ohhuakunaw kyakhe a ciakuh hae;</para>
  <para style="q1">mih phu-enaw laeze</para>
  <para style="q2">ohhuaku rynaw kha a duaahua hae.</para>
  <para style="q1">
    <verse number="19" style="v" />Khivae nynh a sake lungkhu khe</para>
  <para style="q2">lungdete a mung vae hae,</para>
  <para style="q1">mih kya-e silawnawpaw hae keiccuze</para>
  <para style="q2">mih maethah cih.</para>
  <para style="b" />
  <chapter number="5" style="c" />
  <para style="s1">Israel te Judah kha Byapianaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou ranpibawi hae, e hynh thaetua oh!</para>
  <para style="q2">Pou Israel hae, e hynh pekitua oh!</para>
  <para style="q1">Pou siapharan hae, ngaetua oh!</para>
  <para style="q2">Nanning tuh byapianaw na teing cih oh;</para>
  <para style="q1">pawccecize nanning tuh</para>
  <para style="q2">Mizpah kya syapaw kaang,</para>
  <para style="q2">Tabor mua vawlan rawkhawpaw miabu,</para>
  <para style="q1">
    <verse number="2" style="v" />Shittim kya thaepaw laekarung</para>
  <para style="q2">akhupaw lang na tang vae oh;</para>
  <para style="q1">thuasalama tuh-e hae balyn kha</para>
  <para style="q2">de ka tah cih hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" />Efraim kha ka ny,</para>
  <para style="q2">Israel tuh ka kyate thuruh kho</para>
  <para style="q1">thua lan khyh;</para>
  <para style="q2">Pou Efraim, atumaw heize</para>
  <para style="q1">na ohhuakuh vae;</para>
  <para style="q2">Israel tuh anungsikuh vae.</para>
  <para style="q1">
    <verse number="4" style="v" />Mih cyisahnaw nynh minmin kha</para>
  <para style="q2">mih Pachia kalan</para>
  <para style="q1">ki lan kaw-ua khyh hae.</para>
  <para style="q2">Pawccecize ohhuakunaw thinlung tuh</para>
  <para style="q1">mih lungkhu phang um zah,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kha nyh khyh hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" />Israel a lysakunaw nynh</para>
  <para style="q2">amaw toulou kha a rawse;</para>
  <para style="q1">Efraim tuh a cyiseinaw kyakhe</para>
  <para style="q2">a thy a pawkuh;</para>
  <para style="q1">Judah mah minmin ryte</para>
  <para style="q2">a thy a pawkuh bua.</para>
  <para style="q1">
    <verse number="6" style="v" />Mih vaetua phu hae te</para>
  <para style="q2">mih tuuphu hae khate</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> ccung lan</para>
  <para style="q2">a ccia hae zemah,</para>
  <para style="q1">amaw kha muih lan khyh hae;</para>
  <para style="q2">aning tuh minmin te</para>
  <para style="q2">phe sawkuh vae hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Minmin tuh <char style="nd">Bawipaw </char> tungvaw</para>
  <para style="q2">mih lungzi vae khyh;</para>
  <para style="q1">pawccecize mih ccaaw hae tuh</para>
  <para style="q2">aphung thyhte saahpaw ccaaw hae</para>
  <para style="q1">thua vae khyh hae.</para>
  <para style="q2">Sawpaw sah leihpaw nynh</para>
  <para style="q1">minmin te mih loo hae kha a roh cih hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" />Gibeah kya saki tu oh,</para>
  <para style="q2">Ramah kya mungkae tu oh.</para>
  <para style="q1">Beth-aven kya rhawtuknaw</para>
  <para style="q2">roi khate siatua oh;</para>
  <para style="q1">Benjamin phin hae,</para>
  <para style="q2">nulang dotua oh!</para>
  <para style="q1">
    <verse number="9" style="v" />Efraim tuh detahnaw nin kya</para>
  <para style="q2">arohpaw lang a tang cih;</para>
  <para style="q1">Israel phin hae laku kya</para>
  <para style="q2">yn cyihkuh lanpaw phe ariapaw kha</para>
  <para style="q2">ka thaesah hae.</para>
  <para style="q1">
    <verse number="10" style="v" />Judah bawi hae tuh ramri a nuepaw</para>
  <para style="q2">ccungccaw hae lang a tang vae hae;</para>
  <para style="q1">ka thinrianaw kha mih tungvaw kya</para>
  <para style="q2">tui hawte ka bu cih.</para>
  <para style="q1">
    <verse number="11" style="v" />Efraim tuh tuaasahkunaw a teing,</para>
  <para style="q2">byapianaw kya phe a shung,</para>
  <para style="q1">pawccecize accakaepaw nulang</para>
  <para style="q2">zuiku lan bya a paeku.</para>
  <para style="q1">
    <verse number="12" style="v" />Tukeiccuze kae tuh Efraim hanlan</para>
  <para style="q2">zanpaw ka lo zah,</para>
  <para style="q2">Judah hae hanlan athuhpaw nynh ka lo.</para>
  <para style="q1">
    <verse number="13" style="v" />Efraim nynh a ccinaw kha</para>
  <para style="q2">muihkuh zah,</para>
  <para style="q1">Judah nynh mah a vaemaw kha</para>
  <para style="q2">he a muihkuh te,</para>
  <para style="q1">Efraim tuh Assiria lang cceih zah,</para>
  <para style="q2">alesaepaw siapharan kalan</para>
  <para style="q2">ccungccaw a saw hae.</para>
  <para style="q1">Thuasalama aning nynh nanning kha</para>
  <para style="q2">ae dansah kho lan khyh oh,</para>
  <para style="q1">nae vaemaw kha ae hoysah</para>
  <para style="q2">kho lan khyh oh.</para>
  <para style="q1">
    <verse number="14" style="v" />Pawccecize kae tuh Efraim hanlan</para>
  <para style="q2">chindeih hawte ka thua zah,</para>
  <para style="q1">Judah hae hanlan chindeih</para>
  <para style="q2">nopaw hawte nynh ka thua.</para>
  <para style="q1">Kamaw ccaccei nynh thoh ka pae</para>
  <para style="q2">cih hae zah ka cciataw cih hae;</para>
  <para style="q1">minmin kha ccaring ka cciakhae</para>
  <para style="q2">cih hae zah humhung nynh mah</para>
  <para style="q2">khum vae lan khyh hae.</para>
  <para style="q1">
    <verse number="15" style="v" />Minmin nynh mih cyiseinaw kha</para>
  <para style="q2">phykute ka mae yn ccung mawlaezung hae</para>
  <para style="q1">ka umnaw kalan bua ka kithui cih.</para>
  <para style="q2">Vawsaw a teing hae keiccuze</para>
  <para style="q1">ka thawccinaw kha yn ngiakuh cih hae.</para>
  <chapter number="6" style="c" />
  <para style="s1">Ngaesiku lan Hyynaw</para>
  <para style="p">
    <verse number="1" style="v" />“Rang oh, <char style="nd">Bawipaw </char> kalan ki oh sih;</para>
  <para style="q2">pawccecize aening kha</para>
  <para style="q1">thoh oun pae zemah, oun dansah cih;</para>
  <para style="q2">aening kha oun bua zemah</para>
  <para style="q2">ah vaemaw kha oun heepah cih.</para>
  <para style="q1">
    <verse number="2" style="v" />Nin ning koute aening kha</para>
  <para style="q2">oun hiinsah thui cih;</para>
  <para style="q1">nin thumnaw khe aening kha</para>
  <para style="q2">oun thosah cih zah,</para>
  <para style="q2">amaw malang khe ah hiin cih oh.</para>
  <para style="q1">
    <verse number="3" style="v" />
    <char style="nd">Bawipaw </char> kha nyh oh sih,</para>
  <para style="q2">amaw kha ny lan zuakuh oh sih;</para>
  <para style="q1">aning yn langku lanpaw tuh</para>
  <para style="q2">khua yn dae lanpaw hawte phe aria;</para>
  <para style="q1">pharyphary rahpaw khuaa hawte thuasah,</para>
  <para style="q2">laephi kha tui a bupaw</para>
  <para style="q1">hawkhuaa hawte thuasah aning tuh</para>
  <para style="q2">aening kalan yn thua cih,” a ci.</para>
  <para style="s1">Israel te Judah Ngaesiku leinaw</para>
  <para style="q1">
    <verse number="4" style="v" />Pou Efraim, nang kha</para>
  <para style="q2">pawtemou kae cyih cih?</para>
  <para style="q1">Pou Judah, nang kha</para>
  <para style="q2">pawtemou kae cyih cih?</para>
  <para style="q1">Na sungsahnaw tuh awkhua e maeking te</para>
  <para style="q2">taloi azothyapaw vuiraw te nynh aloku.</para>
  <para style="q1">
    <verse number="5" style="v" />Tukeiccuze profeh hae kha</para>
  <para style="q2">mangte minmin kha ka bae vae hae,</para>
  <para style="q1">ka munglae kya-e bya te</para>
  <para style="q2">minmin kha ka chia vae hae,</para>
  <para style="q1">ka byapianaw tuh awnaw</para>
  <para style="q2">hawte nynh athua.</para>
  <para style="q1">
    <verse number="6" style="v" />Ka rypaw tuh atynpaw sungsakunaw kha</para>
  <para style="q2">thua zah, silawnaw thua khyh,</para>
  <para style="q1">maee-ute silawnaw laeze</para>
  <para style="q2">Pachia nynaw kha ka ryhua.<note caller="-" style="x"><char style="xo" closed="false">6.6: </char><char style="xt" closed="false"><ref loc="MAT 9:13">Mat 9.13</ref>, <ref loc="MAT 12:7">12.7</ref></char></note></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" />Thuasalama Adam hawte</para>
  <para style="q2">byakinnaw kha a ro hae;</para>
  <para style="q1">tuin kyakhe ka tungvaw</para>
  <para style="q2">mih lungzi khyh.</para>
  <para style="q1">
    <verse number="8" style="v" />Gilead tuh hoyleinaw a raetu hae</para>
  <para style="q2">khuapi thua zah,</para>
  <para style="q2">chii loihkuhpaw ccunoh nynh thua.</para>
  <para style="q1">
    <verse number="9" style="v" />Damiah hae nynh ccungccaw kha</para>
  <para style="q2">a buh hae hawte,</para>
  <para style="q1">ranpibawi hae tuh pynkheihlan</para>
  <para style="q2">sueluakuh hae zah,</para>
  <para style="q1">Shekhem khua lang cceihpaw laanpi khe</para>
  <para style="q2">ccungccaw kha a chia hae,</para>
  <para style="q2">ri lan umpaw hoyleinaw kha a rae hae.</para>
  <para style="q1">
    <verse number="10" style="v" />Israel hae kyakhe ri lan umpaw</para>
  <para style="q2">uccaw kha ka muih vae;</para>
  <para style="q1">Efraim a ohhuakunaw tuh</para>
  <para style="q2">tuin kya a um,</para>
  <para style="q1">Israel tuh anungsikuh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" />Pou Judah, nang na hanlan mah</para>
  <para style="q2">loohrue ccyh kha khya athua vae.</para>
  <para style="b" />
  <chapter number="7" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Ka ccungccaw hae kha</para>
  <para style="q2">ka kikhae hae zah,</para>
  <para style="q1">Israel kha he ka dansah te,</para>
  <para style="q2">Efraim a ozia hoyleinaw te</para>
  <para style="q1">Samaria kya-e ahoy leipaw</para>
  <para style="q2">cyisahnaw tuh alang cih;</para>
  <para style="q1">pawccecize minmin nynh</para>
  <para style="q2">ahme lei lante cyih hae zah,</para>
  <para style="q1">ru khylan kia biate a tee hae,</para>
  <para style="q2">atolang khe mah kyngdete</para>
  <para style="q2">uccaw a luade hae.</para>
  <para style="q1">
    <verse number="2" style="v" />Mih hoyleinaw balyn kha</para>
  <para style="q2">phe ka ny cipaw</para>
  <para style="q2">minmin nynh tua khyh hae.</para>
  <para style="q1">Atu mih cyisahnaw nynh</para>
  <para style="q2">mimaw kha a koihlu vae hae,</para>
  <para style="q2">minmin tuh ka malang a um hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Mih hoyleinaw khate siapharan kha</para>
  <para style="q2">a lungtuasah hae zah,</para>
  <para style="q1">mih hynhunaw khate bawi hae kha</para>
  <para style="q2">mih lungtuasah hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Minmin balyn tuh milae zu</para>
  <para style="q2">milae vawpaw kya a sei</para>
  <para style="q1">hae paw nynh thua hae;</para>
  <para style="q2">minmin tuh asopaw talyng-ang</para>
  <para style="q2">te nynh aloku hae,</para>
  <para style="q1">sanlou thoutu nynh vaekhui kha</para>
  <para style="q2">a nonde koute</para>
  <para style="q1">sanlou athoo makhia talyng-ang kha</para>
  <para style="q2">maee noihnua leite a nung.</para>
  <para style="q1">
    <verse number="5" style="v" />Ah siapharan poi nin khe</para>
  <para style="q2">a kuihkaw e bawi hae tuh</para>
  <para style="q1">misutui a rui hae; siapharan tuh</para>
  <para style="q2">ccungccaw a saryatu hae ryte</para>
  <para style="q2">a kuih a dyngbua.</para>
  <para style="q1">
    <verse number="6" style="v" />Minmin tuh talyng-ang hawte</para>
  <para style="q2">myarya aso hae, mih thinlung tuh</para>
  <para style="q1">mih lungkhu kya maee lang arua;</para>
  <para style="q2">azi zidae mih thinrianaw tuh</para>
  <para style="q1">byabyate maee lang arua;</para>
  <para style="q2">awkhua takaw vae tuh</para>
  <para style="q2">aruapaw maee hawte thawte arua.</para>
  <para style="q1">
    <verse number="7" style="v" />Mih balyn mawte talyng-ang</para>
  <para style="q2">hawte so hae zah,</para>
  <para style="q2">mih uktu bawi hae kha a chia hae.</para>
  <para style="q1">Mih siapharan hae balyn tuh</para>
  <para style="q2">a chih vae hae; kae yn kopaw</para>
  <para style="q1">lu kheit sanmah um khyh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" />Efraim tuh minphuin ccangpaw hae ryte</para>
  <para style="q2">a mungkuh hae;</para>
  <para style="q1">Efraim tuh buhleih leite</para>
  <para style="q2">voikheit lang kyalya thoupaw</para>
  <para style="q2">sanlou nynh thua.</para>
  <para style="q1">
    <verse number="9" style="v" />Ramccang hae nynh a thawzung kha</para>
  <para style="q2">a aepya hae,</para>
  <para style="q2">thuasalama tuh-e tuh nyh khyh;</para>
  <para style="q1">a lu kya sangpaw patae a um,</para>
  <para style="q2">thuasalama tuh-e tuh nyh khyh.</para>
  <para style="q1">
    <verse number="10" style="v" />Israel a lysakunaw nynh</para>
  <para style="q2">amaw toulou kha a rawse;</para>
  <para style="q1">tuhzemah <char style="nd">Bawipaw </char> mih Pachia kalan</para>
  <para style="q2">kithui khyh hae,</para>
  <para style="q1">e balyn hynh acyiku zemah</para>
  <para style="q2">amaw kha ccung khyh hae.</para>
  <para style="b" />
  <para style="s1">Minphuin hae Doliakunaw</para>
  <para style="q1">
    <verse number="11" style="v" />Efraim tuh angaeepaw, tuanaw hoi leipaw</para>
  <para style="q2">vahu te nynh aloku vae;</para>
  <para style="q1">minmin nynh Izip kha ko hae zah,</para>
  <para style="q2">Assiria langkhe a cceih hae.</para>
  <para style="q1">
    <verse number="12" style="v" />A ccia lya hae khe, minmin kha</para>
  <para style="q2">ka miabu te ka bong cih hae;</para>
  <para style="q1">vaawlang e pavaw hawte laekhu lang</para>
  <para style="q2">ka sahbung cih hae;</para>
  <para style="q1">a pumkunaw hae kya a thae hae thyhte,</para>
  <para style="q2">minmin kha ka thuihei cih hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Ka kyate ccanglang a cciasei</para>
  <para style="q2">vae hae keiccuze, minmin hanlan</para>
  <para style="q1">ngaethya lan kou um!</para>
  <para style="q2">Kae kha yn dou vae hae keiccuze</para>
  <para style="q1">ronaw nynh thuanua hae sah!</para>
  <para style="q2">Minmin kha ka shawkhaw hae zemah,</para>
  <para style="q1">kae kha rawsete hynbya a ho hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" />Thinlung ccaccing te</para>
  <para style="q2">ka kalan sia leite,</para>
  <para style="q2">mih ikhung vawlan khe</para>
  <para style="q1">rawkhuite a um hae;</para>
  <para style="q2">ccathae te misutui mue khylan</para>
  <para style="q1">mimaw saw toulou kha a awku hae;</para>
  <para style="q2">kae kha yn dou hae.</para>
  <para style="q1">
    <verse number="15" style="v" />Thungnaw kuih a pyatu hae te</para>
  <para style="q2">a thuiheitu hae tuh</para>
  <para style="q2">kamaw nynh ka thua,</para>
  <para style="q1">tuhzemah kae kha rawsete</para>
  <para style="q2">ahoy leipaw khua kha a khanku hae.</para>
  <para style="q1">
    <verse number="16" style="v" />Ccungkia leipaw kalan khe a maeku hae;</para>
  <para style="q2">minmin tuh ahynthyapaw</para>
  <para style="q1">li te nynh aloku vae hae;</para>
  <para style="q2">mih bawi hae tuh mih lysakunaw</para>
  <para style="q1">bya keiccuze thaloi te a chih cih hae.</para>
  <para style="q2">Izip ram kya saryanaw a teing cih hae.</para>
  <para style="b" />
  <chapter number="8" style="c" />
  <para style="s1">Israel A Lungzi leinaw</para>
  <para style="q1">
    <verse number="1" style="v" />Mungkae kha tutua!</para>
  <para style="q2">Rhaw tuh <char style="nd">Bawipaw </char> inn luki khe</para>
  <para style="q1">lantaw hawte yn zou,</para>
  <para style="q2">pawccecize minmin nynh</para>
  <para style="q1">ka byakinnaw kha roh hae zah,</para>
  <para style="q2">ka kawbya kha a ei hae.</para>
  <para style="q1">
    <verse number="2" style="v" />Israel hae nynh ka kalan khe,</para>
  <para style="q2">“Kae Pachia, kaening tuh</para>
  <para style="q1">Israel hae kae thua zah,</para>
  <para style="q2">nang kha kae ny!” a ci hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Israel hae nynh hoynaw kha</para>
  <para style="q2">a vua vae hae; rhaw hae nynh</para>
  <para style="q1">minmin kha a deehui cih hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" />Minmin nynh ka kaw leite</para>
  <para style="q2">siapharan hae kha a poku hae;</para>
  <para style="q1">ka ny lei lante bawi hae kha</para>
  <para style="q2">a khangku hae.</para>
  <para style="q1">Mimaw ronaw hanlan</para>
  <para style="q2">mih sui mih ngun khate</para>
  <para style="q2">zohtuh hae kha a raeku hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Pou Samaria, na vaetuataw kha ka hua.</para>
  <para style="q2">Ka thinrianaw tuh</para>
  <para style="q1">mih tungvaw maee lang arua.</para>
  <para style="q2">Hohseciamou mih seinaw</para>
  <para style="q2">thyaa leite a um cih hae?</para>
  <para style="q1">
    <verse number="6" style="v" />E vaetuataw hynh</para>
  <para style="q2">Israel hae kyate nynh yn thua,</para>
  <para style="q1">a kuihhae hoypaw nynh</para>
  <para style="q2">a raepaw nynh thua;</para>
  <para style="q1">e vaetuataw hynh Pachia thua khyh.</para>
  <para style="q2">Samaria kya-e vaetuataw kha</para>
  <para style="q1">zoihtatyh lan khya athua cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" />Minmin nynh khivae ccacii kha tu hae zah,</para>
  <para style="q2">khiccung looh kha a rue cih hae.</para>
  <para style="q1">A thadynpaw loohku nynh</para>
  <para style="q2">avui vui khyh zah,</para>
  <para style="q2">looh kha pousah lan khyh;</para>
  <para style="q1">looh a la pou zemah</para>
  <para style="q2">ramccang hae nynh a ae cih hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Israel kha po laang athua vae;</para>
  <para style="q2">atu tuh ccungkia leipaw angphe hawte</para>
  <para style="q2">minphuin ccangpaw hae laku kya a um.</para>
  <para style="q1">
    <verse number="9" style="v" />Minmin tuh Assiria langkhe</para>
  <para style="q2">a cceihthung vae hae,</para>
  <para style="q1">a makhaete a khiavuikuhpaw</para>
  <para style="q2">ramkaw e lann hawte</para>
  <para style="q2">a khiavuikuh vae;</para>
  <para style="q1">Efraim tuh a sungsah hae kalan</para>
  <para style="q2">amaw toulou kha a zuakuh vae.</para>
  <para style="q1">
    <verse number="10" style="v" />Minphuin ccangpaw hae kalan</para>
  <para style="q2">a zuaku hae zemah,</para>
  <para style="q1">minmin kha ka suelua cih hae;</para>
  <para style="q2">ccyh aro mawze siapharan hae te</para>
  <para style="q1">bawi hae kya-e phupaw ripaw kha</para>
  <para style="q2">riathaete a phu cih hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" />Efraim nynh seishawku nawlan</para>
  <para style="q2">silawhang kha patae houh rae zah,</para>
  <para style="q1">tuh-e hae tuh amaw hanlan</para>
  <para style="q2">seinaw lang houh a tang hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Aning hanlan ccangpyanaw kha</para>
  <para style="q2">patae ka zeipya zemah,</para>
  <para style="q2">aning te asekuh leipaw lang a ria.</para>
  <para style="q1">
    <verse number="13" style="v" />Silawnaw kha rae hae zah,</para>
  <para style="q2">silawnawpaw saw kha a ae hae zemah</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh ccoupah khyh hae.</para>
  <para style="q2">Mih hoyleinaw kha a liathui cih zah,</para>
  <para style="q1">mih seinaw hanlan de a tah cih hae;</para>
  <para style="q2">Izip lang a kithui cih hae.</para>
  <para style="q1">
    <verse number="14" style="v" />Israel nynh amaw a Raetupaw kha ning zah,</para>
  <para style="q2">inn ahoyhoypaw kha a sakku vae;</para>
  <para style="q1">Judah nynh mah khualungrua</para>
  <para style="q2">koihkuhpaw khuapi patae kha a raeku;</para>
  <para style="q1">thuasalama a khuapi hae kha</para>
  <para style="q2">maee te ka soi cih hae zah,</para>
  <para style="q1">koihlupaw a khuapi hae kha</para>
  <para style="q2">maee nynh a u cih hae.</para>
  <para style="b" />
  <chapter number="9" style="c" />
  <para style="s1">Israel kha Detahnaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou Israel, na lungtua nan sah!</para>
  <para style="q2">Ccangpaw minphuin hae hawte</para>
  <para style="q1">na lungpaw nan sah;</para>
  <para style="q2">pawccecize na Pachia kyate</para>
  <para style="q1">na phiakuh zah na ohhuaku vae.</para>
  <para style="q2">looh ruenawpaw huimin miakaw kyakhe</para>
  <para style="q2">na ohhuakunaw mee kha na ry.</para>
  <para style="q1">
    <verse number="2" style="v" />Huimin te misutui tungnawpaw nynh</para>
  <para style="q2">minmin kha kua lan khyh hae,</para>
  <para style="q1">misutui thawpaw tuh</para>
  <para style="q2">minmin hanlan pou lan khyh.</para>
  <para style="q1">
    <verse number="3" style="v" />Efraim ciihan hae tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> ram kya um lan khyh hae;</para>
  <para style="q1">Izip ram lang a ki cih hae zah,</para>
  <para style="q2">Assiria ram khe athyaa leipaw</para>
  <para style="q1">looh kha a ae cih hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" />Misutui niapaw silawnaw kha</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kalan rae lan khyh hae zah,</para>
  <para style="q1">si a lawnaw hae paw nynh</para>
  <para style="q2">aning kha a lungrythuasah lan khyh.</para>
  <para style="q1">Tuhcihawpaw silawnawpaw hae tuh</para>
  <para style="q2">michi raw a rah hae paw kya-e</para>
  <para style="q1">looh hawte athua cih;</para>
  <para style="q2">tuh-e looh a aepaw balyn tuh</para>
  <para style="q1">a nungsikuh cih hae;</para>
  <para style="q2">mih looh tuh mimaw mih vuelaw zah</para>
  <para style="q1">mih vuesonaw hanlan kyalya athua cih;</para>
  <para style="q2">tuh-e looh tuh <char style="nd">Bawipaw </char> inn lang</para>
  <para style="q1">thuakhae thua lan khyh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" />Accyh khyapaw poi nin te</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> poi nin khe</para>
  <para style="q2">nanning nynh pawmou na cyih cih oh?</para>
  <para style="q1">
    <verse number="6" style="v" />Ronaw kyate a lue hae zemah</para>
  <para style="q2">Izip nynh minmin kha a suelua cih hae,</para>
  <para style="q1">Memfis khua khe</para>
  <para style="q2">mih rhua kha uu athua cih.</para>
  <para style="q1">Aphutepaw mih ngun uccaw hae tuh</para>
  <para style="q2">lonua nynh a zithin cih zah,</para>
  <para style="q1">mih umnaw kyakhe hinpaw ku hae apo cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" />Detahnaw ccyh a thua vae,</para>
  <para style="q2">liarunaw nin a thua vae;</para>
  <para style="q1">Israel hae nynh,</para>
  <para style="q2">“E profeh tuh mingaee nynh thua,</para>
  <para style="q1">muisaw ccungccapaw tuh</para>
  <para style="q2">a lungkyh khyh!” cite a sia hae.</para>
  <para style="q1">Nae hoyleinaw ale keiccuze</para>
  <para style="q2">nae kya-e huakunaw tuh myarya ale.<note caller="-" style="x"><char style="xo" closed="false">9.7: </char><char style="xt" closed="false"><ref loc="LUK 21:22">Luk 21.22</ref></char></note></para>
  <para style="q1">
    <verse number="8" style="v" />Profeh tuh ka Pachia hanlan</para>
  <para style="q2">Efraim tungvaw rhawviatu nynh thua,</para>
  <para style="q1">tuhzemah profeh nynh</para>
  <para style="q2">a cyipaw miakaw kyakhe</para>
  <para style="q1">kaang kha a syakhaw hae,</para>
  <para style="q2">a Pachia inn kya heize</para>
  <para style="q2">huakunaw a um.</para>
  <para style="q1">
    <verse number="9" style="v" />Gibeah she lya hawte</para>
  <para style="q2">mih ozia kha mimaw toulou nynh</para>
  <para style="q1">thawte a roku hae;</para>
  <para style="q2">aning nynh mih hoyleinaw kha</para>
  <para style="q1">a liathui cih zah, de a tah cih hae.<note caller="-" style="x"><char style="xo" closed="false">9.9: </char><char style="xt" closed="false"><ref loc="JDG 19:1-30">Bpt 19.1-30</ref></char></note></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" />Ramkaw umpaw misu thae hawte</para>
  <para style="q2">Israel kha ka muih.</para>
  <para style="q1">Athae takawpaw thaeku ku kya-e</para>
  <para style="q2">avoi typaw athae hawte</para>
  <para style="q1">nae minpaaw hae kha ka la muih hae.</para>
  <para style="q2">Thuasalama Baalpeor kya thua hae zah,</para>
  <para style="q1">maethya lan umpaw uccaw kalan khe</para>
  <para style="q2">mimaw toulou kha apkuh hae zah,</para>
  <para style="q1">a ry hae paw uccaw hawte</para>
  <para style="q2">anungsikuhpaw lang a tang hae.<note caller="-" style="x"><char style="xo" closed="false">9.10: </char><char style="xt" closed="false"><ref loc="NUM 25:1-5">Nam 25.1-5</ref></char></note></para>
  <para style="q1">
    <verse number="11" style="v" />Efraim a phu-enaw tuh</para>
  <para style="q2">pavaw hawte a zou cih—</para>
  <para style="q1">ccaaw saahkunaw, ccaaw poinaw te</para>
  <para style="q2">ccaaw hoinaw um lan khyh!</para>
  <para style="q1">
    <verse number="12" style="v" />Ccaaw a saahku hae zemah</para>
  <para style="q2">lu kheit sanmah a hiinhy lei lan ciate</para>
  <para style="q1">ka chitawsah cih hae.</para>
  <para style="q2">Minmin kha he ka cciataw hae te,</para>
  <para style="q1">minmin hanlan ngaethya lan</para>
  <para style="q2">kou um ccaccing cih!</para>
  <para style="q1">
    <verse number="13" style="v" />Langmaw lyaze Efraim tuh</para>
  <para style="q2">do ry umpaw lonua ku hae kya</para>
  <para style="q1">apopaw ungcci ku taraw hawte nynh thua,</para>
  <para style="q2">thuasalama atu vae tuh</para>
  <para style="q1">Efraim nynh a ccaaw hae kha</para>
  <para style="q2">ccungccaw chianaw kalan</para>
  <para style="q2">a cciakhae vae cih hae.</para>
  <para style="q1">
    <verse number="14" style="v" />Pou <char style="nd">Bawipaw </char>, minmin kha pya hae—</para>
  <para style="q2">pawmou na pya cih hae?</para>
  <para style="q1">Ccaaw palei rohpaw neita-inn te</para>
  <para style="q2">mateitui abya leipaw</para>
  <para style="q1">matei kha pya hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" />Mih hoyleinaw miakaw tuh</para>
  <para style="q2">Gilgal kyate nynh yn tho;</para>
  <para style="q2">tuin kyate minmin huanaw kha ka tho.</para>
  <para style="q1">Ahoy leipaw mih cyisahnaw keiccuze</para>
  <para style="q2">ka inn kyate ka dee cih hae.</para>
  <para style="q1">Minmin kha ka sungsah vae lan khyh hae;</para>
  <para style="q2">mih bawi hae balyn tuh</para>
  <para style="q1">rhawthotu hae nynh thua hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" />Efraim tuh vawsaw a tung,</para>
  <para style="q2">mih tharui tuh karae rou zah</para>
  <para style="q1">athae thae lan khyh hae.</para>
  <para style="q2">Ccaaw a saahku hae zemah</para>
  <para style="q1">a sungsah hae paw</para>
  <para style="q2">mih ccaaw hae kha ka theih cih hae.</para>
  <para style="q1">
    <verse number="17" style="v" />Ka Pachia bya kha</para>
  <para style="q2">a ngae khyh hae keiccuze</para>
  <para style="q1">minmin kha a vua cih hae;</para>
  <para style="q2">minmin tuh minphuin</para>
  <para style="q1">ccangpaw hae laku kya</para>
  <para style="q2">a khiavuikuh hae paw lang</para>
  <para style="q1">a tang cih hae.</para>
  <chapter number="10" style="c" />
  <para style="s1">Israel Seinaw te Kyngnaw</para>
  <para style="q1">
    <verse number="1" style="v" />Israel tuh thae patae athaepaw</para>
  <para style="q2">misu ku te nynh aloku.</para>
  <para style="q1">A thae houh lung zah</para>
  <para style="q2">silawhang kha</para>
  <para style="q1">houh lung lan a raeku;</para>
  <para style="q2">a ram a kaethung thyhte</para>
  <para style="q1">a beikpaw tung hae kha</para>
  <para style="q2">houh puithya lan a raeku.</para>
  <para style="q1">
    <verse number="2" style="v" />Mih thinlung tuh hme khyh;</para>
  <para style="q2">mih cyiseinaw keiccuze</para>
  <para style="q1">a teing cih hae.</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh mih silawhang hae kha</para>
  <para style="q1">a tingbung cih zah,</para>
  <para style="q2">mih tung hae kha a roh cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" />Minmin nynh ho hae zah:</para>
  <para style="q2">“Aening nynh <char style="nd">Bawipaw </char> raw kha</para>
  <para style="q1">ah ri khyh oh keiccuze</para>
  <para style="q2">siapharan ah hoi khyh oh,</para>
  <para style="q1">siapharan nynh pawmou</para>
  <para style="q2">oun cyipah kho cih?” a ci hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Bya te kyalya a ho hae; accakaepaw</para>
  <para style="q2">byakinpyakunaw hae kha a rae hae;</para>
  <para style="q1">tukeiccuze tazaeccoikunaw tuh</para>
  <para style="q2">leikua lungkhu the-awnaw kyakhe</para>
  <para style="q2">sy a hoipaw lonua hawte a po.</para>
  <para style="q1">
    <verse number="5" style="v" />Beth-aven kya umpaw</para>
  <para style="q2">vaetuataw zohtuh hanlan</para>
  <para style="q1">Samaria khuaccaaw hae tuh</para>
  <para style="q2">a thyngkuh hae,</para>
  <para style="q1">tuh-e vaetuataw a beik hae paw tuh</para>
  <para style="q2">a rah cih hae zah</para>
  <para style="q1">ranpibawi hae tuh</para>
  <para style="q2">rawkhuite a um cih hae,</para>
  <para style="q1">pawccecize vaetuataw</para>
  <para style="q2">a phu-enaw kha ccanglang</para>
  <para style="q2">a cciakhae vae hae.</para>
  <para style="q1">
    <verse number="6" style="v" />Tuh-e zohtuh tuh alesaepaw</para>
  <para style="q2">siapharan kha lasung lang</para>
  <para style="q1">pya khylan Assiria ram lang</para>
  <para style="q2">cciakhae athua cih.</para>
  <para style="q1">Efraim tuh maethyanaw</para>
  <para style="q2">a mue cih zah, Israel tuh</para>
  <para style="q1">a zohtuh keiccu a maethah cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" />Samaria hae siapharan tuh</para>
  <para style="q2">tui vawlan aphalypaw</para>
  <para style="q2">thingphe taraw hawte a zo cih.</para>
  <para style="q1">
    <verse number="8" style="v" />Israel nynh seinaw</para>
  <para style="q2">a raenaw Aven khua e</para>
  <para style="q1">ahangpaw hmin hae tuh aroh cih hae.</para>
  <para style="q2">Mih silawhang hae vawlan khe</para>
  <para style="q1">hinpaw te lonua hae nynh</para>
  <para style="q2">a zithin cih hae.</para>
  <para style="q1">Minmin nynh mua hae kha,</para>
  <para style="q2">“Oun tingthin oh,” cite</para>
  <para style="q1">a cipah cih hae zah,</para>
  <para style="q2">sangpyng hae kha,</para>
  <para style="q1">“Oun ccawphu oh,” cite</para>
  <para style="q2">a cipah cih hae.<note caller="-" style="x"><char style="xo" closed="false">10.8: </char><char style="xt" closed="false"><ref loc="LUK 23:30">Luk 23.30</ref>; <ref loc="REV 6:16">Bya 6.16</ref></char></note></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" />Pou Israel, Gebeah khua</para>
  <para style="q2">na um lya mawte na sei vae;</para>
  <para style="q1">tuin kyakhe minmin tuh</para>
  <para style="q2">po a sei vae hae.</para>
  <para style="q1">Rhaw nynh minmin kha</para>
  <para style="q2">Gibeah khua kya</para>
  <para style="q2">phah lan khyh hae tou?<note caller="-" style="x"><char style="xo" closed="false">10.9: </char><char style="xt" closed="false"><ref loc="JDG 19:1-30">Bpt 19.1-30</ref></char></note></para>
  <para style="q1">
    <verse number="10" style="v" />Kawngae leipaw ccungccaw hae kha</para>
  <para style="q2">detah khylan ka ccianua cih hae;</para>
  <para style="q1">mih seinaw phuin ning keiccuze</para>
  <para style="q2">detahnaw he a teing hae te,</para>
  <para style="q1">minphuin hae nynh minmin kha</para>
  <para style="q2">a sueluanuakuh cih hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" />Efraim tuh kia vae paw te</para>
  <para style="q2">ccatan tin a rypaw</para>
  <para style="q1">vaetua tohlaw thua zah,</para>
  <para style="q2">apuithyapaw a nging kha</para>
  <para style="q1">ngaethya ka umsah;</para>
  <para style="q2">thuasalama Efraim kha</para>
  <para style="q1">laephi phe mih lan ka thuesah cih;</para>
  <para style="q2">Judah nynh lei a thue cih;</para>
  <para style="q1">Jakob nynh amaw hanlan</para>
  <para style="q2">lei a thuekuh cih.</para>
  <para style="q1">
    <verse number="12" style="v" />Naemaw hanlan dingnaw ccacii kha</para>
  <para style="q2">tukuh oh lah, atynpaw sungsakunaw</para>
  <para style="q2">looh kha rue oh;</para>
  <para style="q1">a umhanpaw laephi kha thuekuh oh;</para>
  <para style="q2">pawccecize <char style="nd">Bawipaw </char> yn thuanaw</para>
  <para style="q1">khylan te nae tungvaw</para>
  <para style="q2">dingnaw khuaarawsah khylan</para>
  <para style="q1">amaw kha ccung ccyh athua vae.<note caller="-" style="x"><char style="xo" closed="false">10.12: </char><char style="xt" closed="false"><ref loc="JER 4:3">Jer 4.3</ref></char></note></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" />Hoyleinaw lei kha na thue oh zah</para>
  <para style="q2">dingleinaw kha na rue vae oh,</para>
  <para style="q1">hynhunaw thae kha na ae vae oh.</para>
  <para style="q2">Pawccecize myarya lungpaw</para>
  <para style="q1">nae rhawkaw hae te</para>
  <para style="q2">nae thawzung kha na doliaku oh.</para>
  <para style="q1">
    <verse number="14" style="v" />Tukeiccuze nae ccungccaw hae kya</para>
  <para style="q2">rhawtuknaw tuh a um cih zah,</para>
  <para style="q1">nae rhawlungrua balyn tuh aroh cih,</para>
  <para style="q2">Shalman siapharan nynh</para>
  <para style="q1">Beth-arbel kha rhawtuk zah</para>
  <para style="q2">a ro ccyh lyaze</para>
  <para style="q1">nung hae tuh mih ccaaw hae ryte</para>
  <para style="q2">palae tui lan</para>
  <para style="q2">a deihnaw hae hawte athua cih.</para>
  <para style="q1">
    <verse number="15" style="v" />Pou Bethel, na hoyleinaw tuh</para>
  <para style="q2">myarya alung keiccuze</para>
  <para style="q1">nang tuh tuhawte cyi na thua cih,</para>
  <para style="q2">Khuadaetakaw khe</para>
  <para style="q1">Israel siapharan kha</para>
  <para style="q2">vua athua ccaccing cih.</para>
  <para style="b" />
  <chapter number="11" style="c" />
  <para style="s1">Israel tungvaw Pachia Sungsahnaw</para>
  <para style="q1">
    <verse number="1" style="v" />Israel tuh a di lyakhe ka sungsah zah</para>
  <para style="q2">ka ccapaw kha Izip ram kyate ka ko.<note caller="-" style="x"><char style="xo" closed="false">11.1: </char><char style="xt" closed="false"><ref loc="EXO 4:22">Exo 4.22</ref>; <ref loc="MAT 2:15">Mat 2.15</ref></char></note></para>
  <para style="q1">
    <verse number="2" style="v" />Minmin kha houh ka ko hae zah,</para>
  <para style="q2">ka kyate houh a cceih hae;</para>
  <para style="q1">Baal pachia hae kalan khe</para>
  <para style="q2">silawnaw rae hae zah,</para>
  <para style="q1">zohtuh hae kalan khe</para>
  <para style="q2">mynkhuhpaw kha a pya hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" />Tuhzemah Efraim kha laanccia</para>
  <para style="q2">a ccangpahpaw tuh</para>
  <para style="q1">kamaw ka thua zah,</para>
  <para style="q2">minmin kha ka kuih te ka dua hae;</para>
  <para style="q1">thuasalama minmin ka dansah</para>
  <para style="q2">hae paw kha nyhkuh khyh hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Ccungccaw thawccinaw rui te thuasah,</para>
  <para style="q2">sungsahnaw rui te thuasah</para>
  <para style="q1">ka cciakhae hae.</para>
  <para style="q2">Imua hae kha mih byaki kalan</para>
  <para style="q1">a hangthungtu hae hawte nynh</para>
  <para style="q2">kae tuh minmin hanlan ka thua.</para>
  <para style="q1">Minmin kha ka bakhungnua hae zah</para>
  <para style="q2">looh ka dang hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" />Ka kalan kithui lan a mya hae keiccuze</para>
  <para style="q2">Izip ram lang a kithui cih hae zah</para>
  <para style="q1">Assiria tuh mih siapharan lang</para>
  <para style="q2">a tang cih.</para>
  <para style="q1">
    <verse number="6" style="v" />Thaloi rhaw nynh mih khuapi hae kha</para>
  <para style="q2">a thiing cih hae,</para>
  <para style="q1">khua koikua ccong hae kha</para>
  <para style="q2">a khyapah cih hae zah, ahoy leipaw</para>
  <para style="q1">mih khuakhannaw keiccuze</para>
  <para style="q2">phe a mih cih hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Ka ccungccaw hae tuh ka kyate</para>
  <para style="q2">ccanglang maekute a cceihsei hae.</para>
  <para style="q1">Ahang Huaccepaw Pachia kha a ko hae,</para>
  <para style="q2">thuasalama aning nynh minmin kha</para>
  <para style="q1">papin hangthung khyh hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" />Efraim, pawtemou nang kha</para>
  <para style="q2">kae vua kho cih?<note caller="-" style="x"><char style="xo" closed="false">11.8: </char><char style="xt" closed="false"><ref loc="DEU 29:23">Deu 29.23</ref></char></note></para>
  <para style="q1">Pou Israel, pawtemou nang kha</para>
  <para style="q2">milae kalan kae ap kho cih?</para>
  <para style="q1">Admah khua hawte pawtemou</para>
  <para style="q2">nang kha kae roh kho cih?</para>
  <para style="q1">Zeboiim khua hawte pawtemou</para>
  <para style="q2">nang kha kae cyih kho cih?</para>
  <para style="q1">Ka lungkhu kya ka thinlung tuh</para>
  <para style="q2">arulaekuh vae;</para>
  <para style="q1">nang ngaethya ae umsahpaw</para>
  <para style="q2">ka thinlung tuh nebaleih.</para>
  <para style="q1">
    <verse number="9" style="v" />Ka thin myarya ria thyhte</para>
  <para style="q2">ka cyih lan khyh;</para>
  <para style="q1">Efraim kha bua ka roh vae lan khyh;</para>
  <para style="q2">pawccecize kae tuh Pachia ka thua zah</para>
  <para style="q1">ccungccaw ka thua khyh,</para>
  <para style="q2">nae laku a umpaw</para>
  <para style="q1">Athyaapaw Pachia ka thua zah,</para>
  <para style="q2">nae kalan thinriate kae thua lan khyh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" />Minmin tuh chindeih hawte a siapaw</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nulang a zuikuh cih hae;</para>
  <para style="q1">aning nynh he a sia vae ze,</para>
  <para style="q2">a ccaaw hae tuh</para>
  <para style="q1">niccaw langte thyngkute</para>
  <para style="q2">oun thua cih hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Minmin tuh Izip ram kyate</para>
  <para style="q2">pavaw hawte arangte</para>
  <para style="q1">oun zou cih hae zah,</para>
  <para style="q2">Assiria ram kyate vahu hawte</para>
  <para style="q1">arangte oun zou cih hae;</para>
  <para style="q2">minmin kha mih inn lang</para>
  <para style="q1">ka kisah cih hae, cite</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh a ci.</para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" />Efraim nynh lingnaw bya te</para>
  <para style="q2">yn koihlu zah,</para>
  <para style="q1">Israel hae nynh hynhunaw bya te</para>
  <para style="q2">oun koihlu hae;</para>
  <para style="q1">thuasalama Judah tuh Pachia ryte</para>
  <para style="q2">po cceihkheih hae zah</para>
  <para style="q1">Athyaapaw Pachia tungvaw</para>
  <para style="q2">lungzinaw a hoi.</para>
  <chapter number="12" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Efraim nynh khivae kha</para>
  <para style="q2">tuu hawte a rin,</para>
  <para style="q1">nithua lang e khivae kha</para>
  <para style="q2">anin ninlang a deehui;</para>
  <para style="q1">minmin nynh ngaeenaw te</para>
  <para style="q2">puathonaw kha a lungsah thung hae;</para>
  <para style="q1">Assiria te byakinnaw kha</para>
  <para style="q2">mang a rae hae pite</para>
  <para style="q1">chitui kha Izip ram langkhe a phu hae.</para>
  <para style="b" />
  <para style="s1">Dounaw Ccyh Asae</para>
  <para style="q1">
    <verse number="2" style="v" />
    <char style="nd">Bawipaw </char> nynh Judah tungvaw</para>
  <para style="q2">seisahnaw bya a hoi,</para>
  <para style="q1">Jakob kha a ozia thyhte</para>
  <para style="q2">de a tah cih zah,</para>
  <para style="q2">a cyisahnaw thyhte a liaru cih.</para>
  <para style="q1">
    <verse number="3" style="v" />Jakob nynh a nung vue lungkhu khe</para>
  <para style="q2">a upaw umnaw kya umru lan</para>
  <para style="q1">zuakuh zah, piccan he yn thua te</para>
  <para style="q2">Pachia kha a rawse.<note caller="-" style="x"><char style="xo" closed="false">12.3: </char><char style="xt" closed="false"><ref loc="GEN 25:26">Gen 25.26</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">12.3-4: </char><char style="xt" closed="false"><ref loc="GEN 32:24-26">Gen 32.24-26</ref></char></note></para>
  <para style="q1">
    <verse number="4" style="v" />Jakob tuh vaawpaw te</para>
  <para style="q2">taekuh hae zah phe a tae,</para>
  <para style="q1">Jakob nynh rah zah</para>
  <para style="q2">hythuanaw kha a ngiaku,</para>
  <para style="q1">Pachia tuh Bethel kya Jakob te</para>
  <para style="q2">tungkuh hae zah bya a hokuh hae.<note caller="-" style="x"><char style="xo" closed="false">12.4: </char><char style="xt" closed="false"><ref loc="GEN 28:10-22">Gen 28.10-22</ref></char></note></para>
  <para style="q1">
    <verse number="5" style="v" />Tuh-e vaaw Pachia <char style="nd">Bawipaw </char> tuh</para>
  <para style="q2">a min <char style="nd">Bawipaw </char> a cikuh!</para>
  <para style="q1">
    <verse number="6" style="v" />Tukeiccuze nanning tuh</para>
  <para style="q2">nae Pachia kalan kithui oh,</para>
  <para style="q1">sungsakunaw te byading kha</para>
  <para style="q2">tynkaring lan kyngkuh oh lah,</para>
  <para style="q1">nae Pachia kha po ngaehoi oh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" />Aning tuh kungkupaw thua zah,</para>
  <para style="q2">ahme leipaw zawccu kha a ccyngku,</para>
  <para style="q2">milae kha vawsawnaw pya a ry.</para>
  <para style="q1">
    <verse number="8" style="v" />Efraim nynh, “Alei, kae tuh</para>
  <para style="q2">ka hoirum vae,</para>
  <para style="q1">sisua patae ka tungkuh vae;</para>
  <para style="q2">ka tungkupaw balyn hynh</para>
  <para style="q1">ahme leite a muepaw nynh thua cite</para>
  <para style="q2">yn seisah lan khyh hae,” a ci.</para>
  <para style="q1">
    <verse number="9" style="v" />Kae tuh Izip ram kyate</para>
  <para style="q2">ae cciakhaepaw <char style="nd">Bawipaw </char></para>
  <para style="q2">na Pachia nynh ka thua;</para>
  <para style="q1">accyh khyapaw poi nin hawte,</para>
  <para style="q2">bu hae kyakhe bua kae umsah cih.<note caller="-" style="x"><char style="xo" closed="false">12.9: </char><char style="xt" closed="false"><ref loc="LEV 23:42-43">Lev 23.42-43</ref></char></note></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" />Profeh hae kya ka ho vae;</para>
  <para style="q2">vizin patae ka langsaku vae,</para>
  <para style="q1">profeh hae kyate ronaw</para>
  <para style="q2">kae thuasah cih.</para>
  <para style="q1">
    <verse number="11" style="v" />Gilead kya hoyleinaw a um,</para>
  <para style="q2">minmin tuh accakaepaw lang</para>
  <para style="q1">a tang ccaccing cih hae.</para>
  <para style="q2">Gilead kyakhe tangnuapaw hae kha</para>
  <para style="q1">si a law hae,</para>
  <para style="q2">tukeiccuze mih silawhang hae tuh</para>
  <para style="q1">leikua lungkhu e the-awnaw kya</para>
  <para style="q2">a umpaw lungpum hawte athua cih hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Jakob tuh Aram ram lang a ccue,</para>
  <para style="q2">tuin kyakhe Israel tuh zu mue khylan</para>
  <para style="q2">milae rya kha lah zah tuu a rin.<note caller="-" style="x"><char style="xo" closed="false">12.12: </char><char style="xt" closed="false"><ref loc="GEN 29:1-20">Gen 29.1-20</ref></char></note></para>
  <para style="q1">
    <verse number="13" style="v" />
    <char style="nd">Bawipaw </char> nynh profeh</para>
  <para style="q2">lu kheit kha mangte Israel hae kha</para>
  <para style="q1">Izip ram kyate</para>
  <para style="q2">cciakhae thung hae zah,</para>
  <para style="q1">profeh lu kheit nynh</para>
  <para style="q2">minmin kha a do-oih hae.<note caller="-" style="x"><char style="xo" closed="false">12.13: </char><char style="xt" closed="false"><ref loc="EXO 12:50-51">Exo 12.50-51</ref></char></note></para>
  <para style="q1">
    <verse number="14" style="v" />Efraim nynh <char style="nd">Bawipaw </char> kha</para>
  <para style="q2">myarya a thinriasah,</para>
  <para style="q1">tukeiccuze a Bawipaw nynh</para>
  <para style="q2">a seinaw kha a tungvaw</para>
  <para style="q1">a ccawsah cih zah,</para>
  <para style="q2">a sarya keiccuze a liaru cih.</para>
  <chapter number="13" style="c" />
  <para style="s1">Israel kha Byapianaw</para>
  <para style="q1">
    <verse number="1" style="v" />Efraim nynh bya a ho vae ze,</para>
  <para style="q2">ming hae tuh a thyngkuh hae;</para>
  <para style="q1">Israel hae nynh aning kha</para>
  <para style="q2">a hangthung hae;</para>
  <para style="q1">thuasalama Baal kha</para>
  <para style="q2">a beik keiccuze sei zah a chih.</para>
  <para style="q1">
    <verse number="2" style="v" />Atu mah po sei hae zah</para>
  <para style="q2">zohtuh kha a raeku hae,</para>
  <para style="q1">mih hawnaw thyhte</para>
  <para style="q2">ngun zohtuh hae kha raekuh hae zah,</para>
  <para style="q1">kuihhae hoy hae paw nynh</para>
  <para style="q2">zohtuh hae kha a rae hae.</para>
  <para style="q1">“E zohtuh hae kalan</para>
  <para style="q2">silawnaw rae oh,” a ci hae.</para>
  <para style="q1">Ccungccaw hae nynh vaetuataw</para>
  <para style="q2">zohtuh hae kha a myng hae!</para>
  <para style="q1">
    <verse number="3" style="v" />Tukeiccuze minmin tuh</para>
  <para style="q2">awkhua e vuiraw hawte thuasah,</para>
  <para style="q1">taloi azopaw dangtui hawte thuasah,</para>
  <para style="q2">huimin kyate khiccungkhiapaw nynh</para>
  <para style="q1">a zoukhaepaw ccatanphue hawte thuasah,</para>
  <para style="q2">thanlan-aw kyate apoupaw</para>
  <para style="q1">maeekhuh hawte thuasah a zo cih hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" />Tuhzemah kae tuh Izip ram kyate</para>
  <para style="q2">ae cciakhaepaw <char style="nd">Bawipaw </char></para>
  <para style="q1">na Pachia nynh ka thua;</para>
  <para style="q2">kamaw laelan ccangpaw Pachia kha</para>
  <para style="q1">nang nynh na hoi khyh,</para>
  <para style="q2">kamaw laelan ccangpaw khumtu um khyh.</para>
  <para style="q1">
    <verse number="5" style="v" />Ram arounaw ramkaw kya</para>
  <para style="q2">looh ae dangpaw tuh</para>
  <para style="q2">kamaw nynh ka thua.<note caller="-" style="x"><char style="xo" closed="false">13.5-6: </char><char style="xt" closed="false"><ref loc="DEU 8:11-17">Deu 8.11-17</ref></char></note></para>
  <para style="q1">
    <verse number="6" style="v" />Looh he ka dang hae tuh a byn hae;</para>
  <para style="q2">mih vueso zah lysakunaw thinlung</para>
  <para style="q2">a hoi hae keiccuze kae kha yn ning hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Tukeiccuze kae tuh minmin hanlan</para>
  <para style="q2">chindeih hawte ka thua cih,</para>
  <para style="q1">kaesing hawte laanpi pe khe</para>
  <para style="q2">ka buh cih hae.</para>
  <para style="q1">
    <verse number="8" style="v" />A taw a luapya hae paw</para>
  <para style="q2">vong hawte minmin kha</para>
  <para style="q1">ka zounua cih hae zah,</para>
  <para style="q2">ka pue ka bou cih hae;</para>
  <para style="q1">tuin kyakhe chindeih hawte</para>
  <para style="q2">ka tei cih hae,</para>
  <para style="q1">loramsaw nynh minmin kha</para>
  <para style="q2">a bou hae hawte ka bou cih hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" />Pou Israel, nang kha kae roh cih;</para>
  <para style="q2">hum nynh mou ae bawm kho cih?</para>
  <para style="q1">
    <verse number="10" style="v" />Nang ae khum kho cih paw</para>
  <para style="q2">na siapharan tuh atu teimou a um?</para>
  <para style="q1">“Siapharan te uktu</para>
  <para style="q2">bawi hae kha yn pya,” cite</para>
  <para style="q1">na ho hae paw nang ae uktu bawi hae tuh</para>
  <para style="q2">na khuapi hae kya a um hae tou?<note caller="-" style="x"><char style="xo" closed="false">13.10: </char><char style="xt" closed="false"><ref loc="1SA 8:5-6">1Sa 8.5-6</ref></char></note></para>
  <para style="q1">
    <verse number="11" style="v" />Ka thinria pite siapharan kha</para>
  <para style="q2">kae pya zah, ka thin phe u lante</para>
  <para style="q1">aning kha bua ka law.<note caller="-" style="x"><char style="xo" closed="false">13.11: </char><char style="xt" closed="false"><ref loc="1SA 10:17-24">1Sa 10.17-24</ref>, <ref loc="1SA 15:26">15.26</ref></char></note></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" />Efraim a hoyleinaw kha</para>
  <para style="q2">tungde thua zah,</para>
  <para style="q2">a seinaw kha ccyke athua.</para>
  <para style="q1">
    <verse number="13" style="v" />Neitangia ccinaw nynh</para>
  <para style="q2">aning kha a thuanua vae,</para>
  <para style="q1">thuasalama aning tuh</para>
  <para style="q2">angaeepaw ccapaw nynh thua;</para>
  <para style="q1">pui azaw ccyh lya a nung vue kyate</para>
  <para style="q2">a pui leipaw imua hawte nynh athua.</para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" />Minmin kha Sheol thungnaw kyate</para>
  <para style="q2">ka shawkhaw cih hae tou?</para>
  <para style="q2">Chinaw kyate ka shawkhaw cih hae tou?</para>
  <para style="q1">Pou chinaw, na kya-e shethya hae tuh</para>
  <para style="q2">teimou a um hae?</para>
  <para style="q1">Pou Sheol, na kya-e ronaw tuh</para>
  <para style="q2">teimou a um?</para>
  <para style="q1">Ngaethyaumsahnaw tuh</para>
  <para style="q2">ka muih leinaw kya thuruh athua.<note caller="-" style="x"><char style="xo" closed="false">13.14: </char><char style="xt" closed="false"><ref loc="1CO 15:55">1Ko 15.55</ref></char></note></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" />Efraim tuh phaeku hae laku kya</para>
  <para style="q2">hinlalyh lan a um zemah,</para>
  <para style="q1">nithua lang e khisan tuh yn zaw cih,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kya-e khisan tuh</para>
  <para style="q1">ramkaw langte yn zaw cih zah,</para>
  <para style="q2">a tuisung te a tuidy hae tuh</para>
  <para style="q2">karae arou cih.</para>
  <para style="q1">Tuh-e khisan nynh aphutepaw uccaw</para>
  <para style="q2">a tungkupaw miakaw kha</para>
  <para style="q2">pong a mung cih.</para>
  <para style="q1">
    <verse number="16" style="v" />Samaria nynh a Pachia kha</para>
  <para style="q2">a dou keiccuze</para>
  <para style="q1">detahnaw a teing cih;</para>
  <para style="q2">minmin tuh thaloi te a chih cih hae,</para>
  <para style="q1">mih ccaaw taraw hae tuh</para>
  <para style="q2">palae tui lan deihnaw athua cih hae zah,</para>
  <para style="q1">ccaawpoipaw mih nopi hae tuh</para>
  <para style="q2">mih vue kha seii athua cih hae.</para>
  <para style="b" />
  <chapter number="14" style="c" />
  <para style="s1">Ngaesiku lan Ngianaw</para>
  <para style="q1">
    <verse number="1" style="v" />Pou Israel, <char style="nd">Bawipaw </char></para>
  <para style="q2">na Pachia kalan kithui tua,</para>
  <para style="q1">pawccecize na hoyleinaw keiccuze</para>
  <para style="q2">na khuliakuh vae.</para>
  <para style="q1">
    <verse number="2" style="v" />Sawsangnaw bya kha paccynkute</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kalan kitua;</para>
  <para style="q1">Amaw kyakhe,</para>
  <para style="q2">“Kae cyiseinaw balyn hynh</para>
  <para style="q1">oun ngaethyatua,</para>
  <para style="q2">thawccinaw te kaening hynh</para>
  <para style="q1">beih oun ccoutua,</para>
  <para style="q2">kae munglae te kae ho hawte</para>
  <para style="q2">kae pya cih.</para>
  <para style="q1">
    <verse number="3" style="v" />Assiria nynh kaening hynh</para>
  <para style="q2">oun khum lan khyh;</para>
  <para style="q1">rhawtuknawpaw marang kha</para>
  <para style="q2">kae ccikuh lan khyh;</para>
  <para style="q1">Kae kuih te kae raeku hae paw kha,</para>
  <para style="q2">‘Nang tuh kae Pachia nynh</para>
  <para style="q1">na thua,’ cite kae ho vae lan khyh.</para>
  <para style="q2">Ngawraw hae nynh</para>
  <para style="q1">na thawccinaw kha</para>
  <para style="q2">a mue hae,” cite hopah oh.</para>
  <para style="b" />
  <para style="s1">Seingaethyanaw</para>
  <para style="q1">
    <verse number="4" style="v" />Mih lungzi leinaw kha</para>
  <para style="q2">ka dansah cih hae;</para>
  <para style="q1">ka lung ccaccing te</para>
  <para style="q2">ka sungsah cih hae,</para>
  <para style="q1">pawccecize mih tungvaw</para>
  <para style="q2">ka thinrianaw phe dae vae.</para>
  <para style="q1">
    <verse number="5" style="v" />Kae tuh Israel hanlan</para>
  <para style="q2">dangtui hawte ka thua cih;</para>
  <para style="q1">aning tuh lili paw hawte a paw cih,</para>
  <para style="q2">Lebanon ramkaw e thingku hawte</para>
  <para style="q2">a tharui a saw cih.</para>
  <para style="q1">
    <verse number="6" style="v" />Aning tuh ange hae atoih cih;</para>
  <para style="q2">oliv thing hawte a puithya cih zah,</para>
  <para style="q2">Lebanon mua hawte a mynkhuh cih.</para>
  <para style="q1">
    <verse number="7" style="v" />Minmin tuh ka mynlyh kaw khe</para>
  <para style="q2">bua a umthui cih hae zah,</para>
  <para style="q1">khokhu hawte hinlalyh lan</para>
  <para style="q2">a um cih hae;</para>
  <para style="q1">misu ku hawte a lethung cih hae zah,</para>
  <para style="q2">Lebanon e misutui hawte</para>
  <para style="q1">mih mynkhuh cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" />Pou Efraim, zohtuh hae te</para>
  <para style="q2">kae tuh pawmou kae sekuh?</para>
  <para style="q1">Na sawsangnaw ae thaepahpaw te</para>
  <para style="q2">nang ae do-oihpaw tuh</para>
  <para style="q1">kamaw nynh ka thua;</para>
  <para style="q2">kae tuh zungzae hinlalyhpaw</para>
  <para style="q1">maeccaw ku hawte nynh ka thua;</para>
  <para style="q2">na lungzinaw tuh ka kyate</para>
  <para style="q2">yn thuapaw nynh thua.</para>
  <para style="q1">
    <verse number="9" style="v" />A haw hae paw nynh</para>
  <para style="q2">e hae hynh a thaethya hae;</para>
  <para style="q1">a nyhthya hae paw nynh</para>
  <para style="q2">e hae hynh a ny hae.</para>
  <para style="q1">Pawccecize <char style="nd">Bawipaw </char> laanpi tuh kyh zah</para>
  <para style="q2">miding hae nynh a zui hae,</para>
  <para style="q1">thuasalama misei hae tuh</para>
  <para style="q2">tuh-e laanpi kya a khuliakuh hae.</para>
</usx>