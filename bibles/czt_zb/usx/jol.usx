<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="JOL" style="id">Baebu Thyaa</book>
  <para style="h">JOEL</para>
  <para style="toc1">Joel</para>
  <para style="toc2">JOEL</para>
  <para style="toc3">Joe</para>
  <para style="mt1">JOEL</para>
  <para style="mt2">Joel</para>
  <para style="imt">Byalaanmaw</para>
  <para style="ip">Profeh Joel konglang hynh beihtaraw kyalya ny thua zah, hohtuh ccyh kya mou a hiin cipaw sanmah ccaethya khyh. Thuasalama e ccauh hynh Persia accozah she lya BC 500 khyhze BC 400 loukaw kya nynh a zei hae paw alo. Tungkhipaw nynh ri lan um lante Palestin ram a ropaw kong thuasah, khuaa sya rah khyh zah pawpaw balyn aroupaw kong thuasah Joel nynh a ho. E acyihkuhpaw hae hynh yn thua cih paw Bawipaw nin kong muihsahnaw cite thuasah, Bawipaw rynaw adingpaw kha a rawse hae paw tungvaw detahnaw ccyh cite thuasah Joel nynh a muih. Bawipaw nynh ccungccaw hae kha ngaesikuh oh lah, hythuanaw kae pyathui cih oh cite bya a kinpyaku hae paw kha Joel nynh ccungccaw hae kha a hopya hae. Syntawku lanpaw ccangkheit tuh, Pachia nynh nopi pise, adih ale ccungccaw balyn tungvaw kya a Muisaw kha a saw cih cipaw byakinpyakunaw nynh thua.</para>
  <para style="iot">Abyalupi hae</para>
  <para style="io1">Tungkhipaw nynh vawsawnaw pyanaw 1.1—2.17</para>
  <para style="io1">Langmawlya hawte thuathui lan byakinpyakunaw 2.18-27</para>
  <para style="io1">Bawipaw Nin 2.28—3.21</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Pethuel ccapaw Joel kalan yn thuapaw <char style="nd">Bawipaw </char> bya:</para>
  <para style="b" />
  <para style="s1">Ram Ro keiccu Rawnaw</para>
  <para style="q1">
    <verse number="2" style="v" />Pou piccan hae, e hynh thaetua oh,</para>
  <para style="q2">ram kya um hae paw balyn,</para>
  <para style="q1">nae nakaring te ngaetua oh!</para>
  <para style="q2">E tahawpaw uccaw hynh</para>
  <para style="q1">nae she kya acyihkuh boi vae tou?</para>
  <para style="q2">Nae minpaaw hae she kya so</para>
  <para style="q2">acyihkuh boi vae tou?</para>
  <para style="q1">
    <verse number="3" style="v" />E konglang hynh</para>
  <para style="q2">nae ccaaw hae kha hopah oh,</para>
  <para style="q1">nae ccaaw hae nynh</para>
  <para style="q2">mih ccaaw hae kha hopah hae sah,</para>
  <para style="q1">mih ccaaw hae nynh</para>
  <para style="q2">ccangpaw she kya-e hae kha</para>
  <para style="q1">hopah hae sah.</para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" />Tungkhipaw alepaw nynh</para>
  <para style="q2">a ae bangpaw alaepaw kha</para>
  <para style="q1">tungkhipaw aphu nynh a ae.</para>
  <para style="q2">Tungkhipaw aphu nynh</para>
  <para style="q1">a ae bangpaw alaepaw kha</para>
  <para style="q2">tungkhipaw adihpaw nynh a ae,</para>
  <para style="q1">tungkhipaw adihpaw nynh</para>
  <para style="q2">a ae bangpaw alaepaw kha</para>
  <para style="q1">ro a mangpaw tungkhipaw nynh a ae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" />A zu a ae hae paw nanning,</para>
  <para style="q2">nae inaw kyate thokuh oh lah,</para>
  <para style="q1">rawtua oh; misutui alawe lan</para>
  <para style="q2">a neih hae paw miakaw balyn,</para>
  <para style="q1">emamiapaw misutui kha</para>
  <para style="q2">nae mung kyate</para>
  <para style="q1">thoh phia athua vae keiccuze</para>
  <para style="q2">rawkhuite um oh.</para>
  <para style="q1">
    <verse number="6" style="v" />Pawccecize athawsae zah</para>
  <para style="q2">riatae um lei hae paw minphuin nynh</para>
  <para style="q2">ka ram kha a thiing vae;<note caller="-" style="x"><char style="xo" closed="false">1.6: </char><char style="xt" closed="false"><ref loc="REV 9:8">Bya 9.8</ref></char></note></para>
  <para style="q1">tuh-e minphuin a haw tuh</para>
  <para style="q2">chindeih haw hawte thua zah,</para>
  <para style="q1">a nua tuh chindeih pinung</para>
  <para style="q2">anua hawte nynh thua.</para>
  <para style="q1">
    <verse number="7" style="v" />Tuh-e minphuin nynh</para>
  <para style="q2">ka misu khokhu kha roh zah,</para>
  <para style="q2">ka thaeku aku hae kha a khya;</para>
  <para style="q1">akaloh kha kia zah a vua;</para>
  <para style="q2">a karan hae tuh pong araw hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" />A zawthaw lya-e a vawpaw hanlan</para>
  <para style="q2">buriboei a zingkuhpaw</para>
  <para style="q2">liaccady hawte rawkhuitua oh.</para>
  <para style="q1">
    <verse number="9" style="v" />
    <char style="nd">Bawipaw </char> inn kya</para>
  <para style="q2">pya lanpaw ccathae te</para>
  <para style="q1">misutui um khyh.</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> ryalahtu hae,</para>
  <para style="q1">ranpibawi hae tuh</para>
  <para style="q2">rawkhuite a um hae.</para>
  <para style="q1">
    <verse number="10" style="v" />Loo hae tuh aroh hae,</para>
  <para style="q2">laephi tuh rawkhuite a um;</para>
  <para style="q1">pawccecize ccathae tuh aroh,</para>
  <para style="q2">misutui tuh arou,</para>
  <para style="q1">chitui mah um vae khyh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" />Loopho hae nanning,</para>
  <para style="q2">nae bungzou sah, misu khokhu</para>
  <para style="q1">do-oihtu hae nanning,</para>
  <para style="q2">rawkhuite um oh,</para>
  <para style="q1">pawccecize chanvuih, barli te</para>
  <para style="q2">loo kya-e ruepaw</para>
  <para style="q2">ccathae hae tuh aroh hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Misu ku tuh naan zah</para>
  <para style="q2">thaeku ku tuh arou.</para>
  <para style="q1">Ccalee thae, ungcci ku te epal—</para>
  <para style="q2">loo kya-e thingku balyn tuh</para>
  <para style="q1">pong arou hae; ccungccaw hae</para>
  <para style="q2">mih lungtuanaw tuh</para>
  <para style="q1">azo ccaccing.</para>
  <para style="b" />
  <para style="s1">Ngaesiku lan Hyynaw</para>
  <para style="q1">
    <verse number="13" style="v" />Ranpibawi hae nanning,</para>
  <para style="q2">buriboei kha zingkute rawkhuitua oh;</para>
  <para style="q1">silawhang kya ryalahtu hae nanning,</para>
  <para style="q2">rawkhuite umtua oh.</para>
  <para style="q1">Ka Pachia rya a lahtu hae nanning,</para>
  <para style="q2">rang oh lah, buri boeining lawkute</para>
  <para style="q1">khuazi ccyh kha liasah oh!</para>
  <para style="q2">Nae Pachia inn kya pya lanpaw</para>
  <para style="q1">ccathae te misutui um khyh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" />Looh-aesung ccyh kha thaesah oh,</para>
  <para style="q2">athyaapaw pumkunaw kha rae oh.</para>
  <para style="q1">Piccan hae te ram lungkhu</para>
  <para style="q2">a um hae paw balyn kha</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nae Pachia inn lang</para>
  <para style="q2">suelua oh lah,</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> kalan siatua oh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" />Tuh-e nin hanlan ngaethya lan kou um!<note caller="-" style="x"><char style="xo" closed="false">1.15: </char><char style="xt" closed="false"><ref loc="ISA 13:6">Isa 13.6</ref></char></note></para>
  <para style="q1">Pawccecize tuh-e <char style="nd">Bawipaw </char> nin tuh anae vae,</para>
  <para style="q2">tuh-e nin tuh Athunghuapaw kya-e</para>
  <para style="q2">ronaw hawte yn thua cih.</para>
  <para style="q1">
    <verse number="16" style="v" />Aening ah muihnaw oh kya maw</para>
  <para style="q2">looh tuh phe athang khaw?</para>
  <para style="q1">Ah Pachia inn kya lungtuanaw te</para>
  <para style="q2">lungpawnaw um vae khyh khaw?</para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" />Laephi aroupaw kya ccacii tuh aroh,</para>
  <para style="q2">uccaw ccakhungnaw inn hae tuh aroh hae,</para>
  <para style="q1">looh a um khyh keiccuze</para>
  <para style="q2">ccung-inn hae tuh aroh hae.</para>
  <para style="q1">
    <verse number="18" style="v" />Sarangpaw hae tuh a hawkhaekuh hae!</para>
  <para style="q2">Sahiin hae tuh rampaeekunaw</para>
  <para style="q1">a um khyh keiccuze a khiavuikuh hae;</para>
  <para style="q2">tuuphu hae mah a teing hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" />Pou <char style="nd">Bawipaw </char>, nang kha</para>
  <para style="q2">thawte kae ko.</para>
  <para style="q1">Pawccecize ramkaw e sahiin hae</para>
  <para style="q2">rampaeekunaw hae kha</para>
  <para style="q2">maee nynh a u vae,</para>
  <para style="q1">ramkaw e thingku balyn tuh</para>
  <para style="q2">maeesoi nynh a u vae.</para>
  <para style="q1">
    <verse number="20" style="v" />Tuinaw hae tuh arou hae keiccuze</para>
  <para style="q2">loramsaw hae heize</para>
  <para style="q1">na kalan a sia hae,</para>
  <para style="q2">ramkaw e sahiin hae</para>
  <para style="q1">rampaeekunaw hae tuh</para>
  <para style="q2">maee nynh phe u vae.</para>
  <para style="b" />
  <chapter number="2" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Zion kya mungkae tu oh;</para>
  <para style="q2">athyaapaw ka mua vawlan khe</para>
  <para style="q1">raeringnaw roi kha ccaesah oh!</para>
  <para style="q2">Ram kya um hae paw balyn tuh</para>
  <para style="q1">thyngkuh hae sah,</para>
  <para style="q2">pawccecize <char style="nd">Bawipaw </char> nin tuh anae vae—</para>
  <para style="q1">
    <verse number="2" style="v" />tuh-e nin tuh mohnaw te</para>
  <para style="q2">mae-uinaw nin, maeking azi nin te</para>
  <para style="q1">marae zipingpaw mohnaw nin nynh thua!</para>
  <para style="q2">Mankakungpaw tuh</para>
  <para style="q1">mua hae vawlan a pazaeku hawte,</para>
  <para style="q2">lung hae zah athungpaw</para>
  <para style="q1">rhawkaw hae tuh oun cceih hae;</para>
  <para style="q2">tuhcihawpaw tuh langmawlya mah</para>
  <para style="q1">um boi khyh zah,</para>
  <para style="q2">malang ccyh kya mah</para>
  <para style="q1">um boi vae lan khyh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" />Mih malang khe maee rua zah,</para>
  <para style="q2">mih nulang khe maeesoi arua.</para>
  <para style="q1">Mih malang e ram tuh</para>
  <para style="q2">Eden khokhu te alokuh,</para>
  <para style="q1">thuasalama mih nulang e tuh</para>
  <para style="q2">pawpaw mah um leipaw</para>
  <para style="q1">ramkaw te nynh aloku,</para>
  <para style="q2">minmin kyate a luepaw um khyh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" />Minmin tuh marang muinsan te</para>
  <para style="q2">lokuh hae zah,<note caller="-" style="x"><char style="xo" closed="false">2.4-5: </char><char style="xt" closed="false"><ref loc="REV 9:7-9">Bya 9.7-9</ref></char></note> rhawtuknawpaw</para>
  <para style="q2">marang hae hawte a ccue hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Marangle hae siho hawte thuasah,</para>
  <para style="q2">athupaw maee-upaw siho hawte thuasah</para>
  <para style="q1">mua dung hae vawlan khe</para>
  <para style="q2">a thohkuh hae,</para>
  <para style="q1">rhawtuk lan a paccynkuh hae paw</para>
  <para style="q2">athungpaw rhawkaw hae hawte</para>
  <para style="q1">ataruinte a um hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" />Mih malang khe ccungccaw hae tuh</para>
  <para style="q2">mih lungriathae zah,</para>
  <para style="q2">mih mae tuh dawkadae lan acih.</para>
  <para style="q1">
    <verse number="7" style="v" />Mih rawthunghua hae paw hawte</para>
  <para style="q2">ccue hae zah, rhawkaw hae hawte</para>
  <para style="q1">khualungrua kya a kae hae.</para>
  <para style="q2">Mih ccianaw kyate</para>
  <para style="q2">ccanglang maeku leite,</para>
  <para style="q1">mih laanpi raveih kha</para>
  <para style="q2">lawbabin lan a zui hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Lu kheit te lu kheit eihkuh sei khyh hae,</para>
  <para style="q2">mawmaw laanpi raveih kha a zui hae;</para>
  <para style="q1">zunghe hae kya po cceih hae zah,</para>
  <para style="q2">minmin kha khee kho khyh hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Khuapi kha naangbia hae zah,</para>
  <para style="q2">khualungrua vawlan a kae hae;</para>
  <para style="q1">inn tungvaw lang kae hae zah,</para>
  <para style="q2">miruh hawte thanlan-aw kyate a tee hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" />Mih malang khe laephi tuh hy zah,<note caller="-" style="x"><char style="xo" closed="false">2.10: </char><char style="xt" closed="false"><ref loc="REV 8:12">Bya 8.12</ref></char></note></para>
  <para style="q2">vaawlui tuh a thyngkuh.</para>
  <para style="q1">Khuanin te sawpaw tuh moh hae zah,</para>
  <para style="q2">awsi hae tuh aw khyh hae.</para>
  <para style="q1">
    <verse number="11" style="v" />
    <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">a rhawkaw hae malang khe</para>
  <para style="q2">a roi a saw;<note caller="-" style="x"><char style="xo" closed="false">2.11: </char><char style="xt" closed="false"><ref loc="REV 6:17">Bya 6.17</ref></char></note> a rhawkaw hae tuh</para>
  <para style="q1">myarya alung hae!</para>
  <para style="q2">A kaw a ngae hae paw tuh</para>
  <para style="q1">riatae um khyh hae.</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nin tuh lesae zah</para>
  <para style="q1">ri lan a um ccaccing;</para>
  <para style="q2">hum nynh mou a teing kho cih?</para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" />Tuhzemah atu heize</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh a hopaw tuh,</para>
  <para style="q1">looh-aesung te, ngaethya rawkhuite,</para>
  <para style="q2">nae thinlung balyn te</para>
  <para style="q2">ka kalan oun ki oh;</para>
  <para style="q1">
    <verse number="13" style="v" />nae boeining kha seii leite,</para>
  <para style="q2">nae thinlung kha seii oh.</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nae Pachia kalan</para>
  <para style="q2">kithui oh, pawccecize aning tuh</para>
  <para style="q1">thawccih thyapaw te</para>
  <para style="q2">ngaethyaumsah thyapaw thua zah,</para>
  <para style="q1">a lungsaepaw, atynpaw</para>
  <para style="q2">sungsahnaw te phe beihpaw,</para>
  <para style="q2">detahnaw kyate a synkuhpaw nynh thua.</para>
  <para style="q1">
    <verse number="14" style="v" />
    <char style="nd">Bawipaw </char> nae Pachia hanlan</para>
  <para style="q2">ccathae silawnaw te</para>
  <para style="q1">niapaw silawnaw kha</para>
  <para style="q2">nanning nynh na pya nawlan oh,</para>
  <para style="q1">Pachia tuh lungpaleihkute</para>
  <para style="q2">yn ki cih zah, hythuanaw</para>
  <para style="q1">a cciataw te cciataw khyh kha</para>
  <para style="q2">hummou a ho kho?</para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" />Zion kya mungkae tu oh;</para>
  <para style="q2">Looh-aesung ccyh kha thaesah oh,</para>
  <para style="q2">athyaapaw pumkunaw kha rae oh.</para>
  <para style="q1">
    <verse number="16" style="v" />Ccungccaw hae kha suelua oh lah,</para>
  <para style="q2">ccungccaw zapi hae kha thyaasah oh;</para>
  <para style="q1">mih kum tang hae paw kha</para>
  <para style="q2">pum oh lah, imua hae kha</para>
  <para style="q1">suelua oh, nosi hae kha heize</para>
  <para style="q2">nae by kya pomte suelua oh.</para>
  <para style="q1">Zudy ccangvaepaw tuh</para>
  <para style="q2">a khaan lungkhu te pou sah lah,</para>
  <para style="q1">akaenung liaccanung tuh</para>
  <para style="q2">zokhawboei lungkhu te pou sah.</para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" />Ranpibawi hae te</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> ryalahtu hae tuh</para>
  <para style="q1">tee takawnaw akhaan te</para>
  <para style="q2">silawhang laku khe rah hae sah lah,</para>
  <para style="q1">“Pou <char style="nd">Bawipaw </char>, na ccungccaw hae hynh</para>
  <para style="q2">ngaethya beih umsah hae,</para>
  <para style="q1">na rho ccungccaw hae hynh</para>
  <para style="q2">a nuinse hae paw lang oun rae nan lah,</para>
  <para style="q1">ccangpaw minphuin hae laku kya</para>
  <para style="q2">ccyasahnawpaw lang beih oun rae nan.</para>
  <para style="q1">‘Mih Pachia tuh teimou a um,’ cite</para>
  <para style="q2">minphuin hae laku kya</para>
  <para style="q1">pawccemou a ho cih hae?” cite ho hae sah.</para>
  <para style="b" />
  <para style="s1">Pachia nynh Byakinpyakunaw</para>
  <para style="q1">
    <verse number="18" style="v" />Tetuh <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">a ram hanlan thawte tua zah,</para>
  <para style="q1">a ccungccaw hae kha</para>
  <para style="q2">ngaethya a umsah hae.</para>
  <para style="q1">
    <verse number="19" style="v" />
    <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">a ccungccaw hae kha leih hae zah:</para>
  <para style="q1">Nanning kha ccathae,</para>
  <para style="q2">misutui te chitui kae pya cih oh zah</para>
  <para style="q1">nae vueso cih; nanning kha</para>
  <para style="q2">minphuin hae laku kya</para>
  <para style="q1">nuinsepaw lang kae rae vae lan khyh oh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" />Thahlang e rhawkaw hae kha</para>
  <para style="q2">nae kyate asawnaw lang</para>
  <para style="q1">ka nue cih hae zah,</para>
  <para style="q2">ramrou te ccungccaw adaenaw</para>
  <para style="q1">ram lang ka dee cih hae,</para>
  <para style="q2">malang um hae paw kha</para>
  <para style="q1">nithua lang e rili lungkhu lang,</para>
  <para style="q2">nulang um hae paw kha</para>
  <para style="q1">niccaw lang e rili lungkhu lang</para>
  <para style="q2">ka dee cih hae;</para>
  <para style="q1">mih rhua tuh athuh cih zah amyn cih.</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh myarya lepaw</para>
  <para style="q1">rya kha a law ccaccing vae! cite a ho.</para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" />Pou laephi, rih nan;</para>
  <para style="q2">lungtua lungpawte umtua,</para>
  <para style="q1">pawccecize <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">myarya lepaw rya kha a law vae!</para>
  <para style="q1">
    <verse number="22" style="v" />Ramkaw e loramsaw hae nanning,</para>
  <para style="q2">rih nan oh,</para>
  <para style="q1">pawccecize rampaeekunaw loram tuh</para>
  <para style="q2">hinlalyh lan a um,</para>
  <para style="q1">thingku hae nynh athae thae hae zah,</para>
  <para style="q2">thaeku ku te misu ku hae nynh</para>
  <para style="q1">athae patae a thae hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" />Pou Zion ccaaw hae,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nae Pachia tungvaw</para>
  <para style="q1">nae lungtua sah lah, nae lungpaw sah;</para>
  <para style="q2">pawccecize nanning thyaaccousah nawlan</para>
  <para style="q1">hawkhuaa kha a rawsah,</para>
  <para style="q2">langmawlya hawte nanning hanlan</para>
  <para style="q2">khuaatui te hawkhuaa kha patae a rawsah.</para>
  <para style="q1">
    <verse number="24" style="v" />Huimin hae tuh ccathae te</para>
  <para style="q2">phe abeih cih hae zah,</para>
  <para style="q1">atui sunawpaw akhu hae tuh</para>
  <para style="q2">misutui te chitui khate</para>
  <para style="q1">a leikuh cih hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" />Tungkhipaw phu kya-e</para>
  <para style="q2">tungkhipaw adihpaw,</para>
  <para style="q1">ro a mangpaw tungkhipaw te</para>
  <para style="q2">tungkhipaw alepaw nynh</para>
  <para style="q1">a ae kum hae kya-e</para>
  <para style="q2">na shung oh paw kha</para>
  <para style="q1">kae pyaru cih oh;</para>
  <para style="q2">e hae tuh nanning kae sawnua oh paw</para>
  <para style="q1">myarya lungpaw</para>
  <para style="q2">ka rhawkaw hae nynh thua hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" />Ae lanpaw patae na hoi cih oh zah</para>
  <para style="q2">phe na byn cih oh,</para>
  <para style="q1">te nae tungvaw ngaeangnaw a raetupaw</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nae Pachia min kha</para>
  <para style="q2">the na hoysah cih oh.</para>
  <para style="q1">Ka ccungccaw hae tuh</para>
  <para style="q2">maethyanaw kha papin teing</para>
  <para style="q2">vae lan khyh hae.</para>
  <para style="q1">
    <verse number="27" style="v" />Kae tuh Israel hae</para>
  <para style="q2">ngaelung khe ka um zah,</para>
  <para style="q1">kae, <char style="nd">Bawipaw </char> tuh nae Pachia nynh</para>
  <para style="q2">ka thua, ccangpaw Pachia um khyh</para>
  <para style="q1">cipaw na nyh cih oh.</para>
  <para style="q2">Ka ccungccaw hae tuh</para>
  <para style="q1">maethyanaw kha</para>
  <para style="q2">papin teing vae lan khyh hae.</para>
  <para style="b" />
  <para style="s1">Pachia Muisaw Bunaw</para>
  <para style="q1">
    <verse number="28" style="v" />Tukoute ccungccaw balyn</para>
  <para style="q2">tungvaw kya ka muisaw ka bu cih;<note caller="-" style="x"><char style="xo" closed="false">2.28-32: </char><char style="xt" closed="false"><ref loc="ACT 2:17-21">Loc 2.17-21</ref></char></note></para>
  <para style="q1">nae ccapaw hae te nae ccanung hae nynh</para>
  <para style="q2">profehbya a ho cih hae,</para>
  <para style="q1">nae paawpi hae nynh</para>
  <para style="q2">maan a sah cih hae zah,</para>
  <para style="q1">nae ccangvae hae nynh</para>
  <para style="q2">vizin hae kha a muih cih hae.</para>
  <para style="q1">
    <verse number="29" style="v" />Tuin nin kya vae tuh,</para>
  <para style="q2">seenung hae te seepaw hae kya heize</para>
  <para style="q1">ka muisaw kha ka bu cih.</para>
  <para style="b" />
  <para style="p">
    <verse number="30" style="v" />Vaawlui te laephi vawlan khe ngaeangnaw hae kha ka langsakuh cih, chiise, maee te maeekhuh atungtung te um hae paw kha ka langsakuh cih. <verse number="31" style="v" /><char style="nd">Bawipaw </char> kya-e alesaepaw te ri lan umpaw nin a thua mawkhe, khuanin tuh amoh cih zah sawpaw tuh chiise lang yn tang cih.<note caller="-" style="x"><char style="xo" closed="false">2.31: </char><char style="xt" closed="false"><ref loc="MAT 24:29">Mat 24.29</ref>; <ref loc="MRK 13:24-25">Mar 13.24-25</ref>; <ref loc="LUK 21:25">Luk 21.25</ref>; <ref loc="REV 6:12-13">Bya 6.12-13</ref></char></note> <verse number="32" style="v" />Tetuh <char style="nd">Bawipaw </char> min a kopaw miakaw tuh khum athua cih; pawccecize <char style="nd">Bawipaw </char> nynh a ho vae hawte,<note caller="-" style="x"><char style="xo" closed="false">2.32: </char><char style="xt" closed="false"><ref loc="ROM 10:13">Rom 10.13</ref></char></note> a lue hae paw tuh Zion Mua te Jerusalem khua kya a um cih hae, <char style="nd">Bawipaw </char> nynh a ko hae paw tuh a hiinhy hae paw ryte a um cih hae.</para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Tuin nin te tuin ccyh kyakhe, Judah te Jerusalem kha hoynaw he ka pyathui hae te, <verse number="2" style="v" />minphuin hae balyn kha ka suelua cih hae zah Jehoshafat accya langkhe ka cciakhae bung cih hae; tuin kyakhe minmin kha bya ka pia cih hae, pawccecize minmin nynh ka ccungccaw hae te ka rho Israel kha minphuin hae laku kya phiariphiarae a nung hae. Ka ram kha neekuh hae zah, <verse number="3" style="v" />ka ccungccaw hae kha see lang lawku lanpaw kong kha ccungthy a dung hae, pise taraw hae kha ohhuakunaw khate rulaekuh hae zah, nopi taraw hae kha misutui lang a zuaku hae, te a nia hae.</para>
  <para style="p">
    <verse number="4" style="v" />Pou Tair khua, Sidon khua te Filistia ram hae balyn, nanning tuh kae ka hanlan pawmou na thua oh? Kae kha nae liaru cih oh tou? Kae kha nae liaru oh ze, nae cyisahnaw kha naemaw lu vawlan palou ka khangru cih.<note caller="-" style="x"><char style="xo" closed="false">3.4-8: </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">Isa 14.29-31</ref>, <ref loc="ISA 23:1-18">23.1-18</ref>; <ref loc="JER 47:1-7">Jer 47.1-7</ref>; <ref loc="EZK 25:15-28:26">Eze 25.15—28.26</ref>; <ref loc="AMO 1:6-10">Amo 1.6-10</ref>; <ref loc="ZEP 2:4-7">Zef 2.4-7</ref>; <ref loc="ZEC 9:1-7">Zek 9.1-7</ref>; <ref loc="MAT 11:21-22">Mat 11.21-22</ref>; <ref loc="LUK 10:13-14">Luk 10.13-14</ref></char></note> <verse number="5" style="v" />Pawccecize ka sui te ka ngun kha na lawku oh, ka sisua patae kha nae beikinn lang na phuku oh. <verse number="6" style="v" />Judah hae te Jerusalem khuaccaaw hae kha mih ram kyate asawnaw lang na cciakhae oh zah, Grik hae kalan na zuaku oh. <verse number="7" style="v" />Thuasalama atu tuh, minmin na zuanaw oh hmin hae kha cciataw khylan ka tuhou cih hae zah, nae cyisahnaw kha naemaw lu vawlan ka khangru cih. <verse number="8" style="v" />Nae ccanung hae te nae ccapaw hae kha Judah hae kuih kalan ka zua cih hae zah, minmin nynh asawnaw umpaw minphuin, Seba hae kalan a zua cih hae; pawccecize <char style="nd">Bawipaw </char> nynh a ho vae.</para>
  <para style="b" />
  <para style="s1">Jehoshafat Accya kya Byapianaw</para>
  <para style="q1">
    <verse number="9" style="v" />E bya hynh minphuin hae kalan thaesah hae:</para>
  <para style="q1">Rhawtuk lan paccynkuh,</para>
  <para style="q2">rhawkaw hae kha</para>
  <para style="q1">lungthobya hopah oh.</para>
  <para style="q2">Rhawkaw hae balyn tuh</para>
  <para style="q1">oun naekuh hae sah lah,</para>
  <para style="q2">oun cceihthung hae sah.</para>
  <para style="q1">
    <verse number="10" style="v" />Nae tamuin hae kha</para>
  <para style="q2">thaloi lang suhkuh oh lah,</para>
  <para style="q1">nae rungkou hae kha</para>
  <para style="q2">ccoi lang suhkuh oh;<note caller="-" style="x"><char style="xo" closed="false">3.10: </char><char style="xt" closed="false"><ref loc="ISA 2:4">Isa 2.4</ref>; <ref loc="MIC 4:3">Mik 4.3</ref></char></note></para>
  <para style="q1">a thawzyapaw nynh,</para>
  <para style="q2">“Kae tuh ka thawsae,” cite ho sah.</para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" />Po voilu lan um hae paw</para>
  <para style="q2">minphuin hae balyn,</para>
  <para style="q1">arangte oun cceih oh lah,</para>
  <para style="q2">tuh-e accya kyakhe sueluakuh oh.</para>
  <para style="q1">Pou <char style="nd">Bawipaw </char>, na rhawkaw hae kha</para>
  <para style="q2">beih yn saw hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Minphuin hae tuh</para>
  <para style="q2">thokuh hae sah lah,</para>
  <para style="q2">Jehoshafat accya kalan</para>
  <para style="q1">cceihthung hae sah;</para>
  <para style="q2">pawccecize a pepan e</para>
  <para style="q1">minphuin hae balyn kha</para>
  <para style="q2">byapia khylan tuin kya ka haung cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" />Loohrue lanpaw tuh</para>
  <para style="q2">avoi vae keiccuze</para>
  <para style="q1">rungkou kha lawku tua.<note caller="-" style="x"><char style="xo" closed="false">3.13: </char><char style="xt" closed="false"><ref loc="REV 14:14-16">Bya 14.14-16</ref>, <ref loc="REV 14:19-20">19-20</ref>, <ref loc="REV 19:15">19.15</ref></char></note></para>
  <para style="q2">Misu mianaw khu tuh</para>
  <para style="q1">phe abia vae keiccuze</para>
  <para style="q2">cceih oh lah, sutua oh.</para>
  <para style="q1">Mih hoyleinaw tuh</para>
  <para style="q2">myarya ale keiccuze</para>
  <para style="q1">misu mianaw khu tuh</para>
  <para style="q2">aleikuh vae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" />Byapaenaw accya kya</para>
  <para style="q2">ccungccaw zapi,</para>
  <para style="q1">ccungccaw pataepi a um hae,</para>
  <para style="q2">pawccecize byapaenaw accya kya</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nin tuh anae vae.</para>
  <para style="q1">
    <verse number="15" style="v" />Khuanin te sawpaw tuh</para>
  <para style="q2">moh hae zah,</para>
  <para style="q1">awsi hae tuh aw vae khyh hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" />
    <char style="nd">Bawipaw </char> tuh Zion kyate sia zah,</para>
  <para style="q2">Jerusalem kyate a roi a saw,</para>
  <para style="q1">vaaw te lae tuh a thyngkuh hae.<note caller="-" style="x"><char style="xo" closed="false">3.16: </char><char style="xt" closed="false"><ref loc="AMO 1:2">Amo 1.2</ref></char></note></para>
  <para style="q2">Thuasalama <char style="nd">Bawipaw </char> tuh</para>
  <para style="q1">a ccungccaw hae hanlan</para>
  <para style="q2">khynnaw thua zah,</para>
  <para style="q1">Israel ccungccaw hae hanlan</para>
  <para style="q2">rhawlungrua nynh thua.</para>
  <para style="b" />
  <para style="s1">Judah hanlan Malang Ccyh</para>
  <para style="q1">
    <verse number="17" style="v" />Tetuh nang nynh athyaapaw</para>
  <para style="q2">ka mua, Zion kya ka umpaw,</para>
  <para style="q1">kae, <char style="nd">Bawipaw </char> na Pachia kha</para>
  <para style="q2">nae nyh vae cih.</para>
  <para style="q1">Jerusalem tuh athyaa cih zah,</para>
  <para style="q2">khua lungkhu kya</para>
  <para style="q1">ramccang hae nynh papinmaw</para>
  <para style="q2">bua cceih vae lan khyh hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" />Tuin nin vae tuh</para>
  <para style="q2">mua hae kyate a-epaw</para>
  <para style="q1">misutui abya cih zah,</para>
  <para style="q2">sangpyng hae kyate</para>
  <para style="q1">mateitui alua cih,</para>
  <para style="q2">Judah ram e vawkhu hae balyn tuh</para>
  <para style="q1">tui alua cih; <char style="nd">Bawipaw </char> inn kyate</para>
  <para style="q2">tuidy apou cih zah,</para>
  <para style="q1">Shittim Accya kha tui a ciasah cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" />Izip ram tuh ccungccaw</para>
  <para style="q2">adaepaw lang a tang cih zah,</para>
  <para style="q1">Edom ram tuh ccungccaw adaepaw</para>
  <para style="q2">ramkaw lang a tang cih,</para>
  <para style="q1">pawccecize Judah hae tungvaw kya</para>
  <para style="q2">puathote ryalah hae zah,</para>
  <para style="q1">ram pynpi kya a sei leipaw</para>
  <para style="q2">chiise kha a luasah hae.</para>
  <para style="q1">
    <verse number="20" style="v" />Thuasalama Judah ram kya</para>
  <para style="q2">ccungccaw a um zungzae cih zah,</para>
  <para style="q1">Jerusalem kya she takyh</para>
  <para style="q2">ccungccaw a um vae cih.</para>
  <para style="q1">
    <verse number="21" style="v" />Mih chiise mee kha</para>
  <para style="q2">phu ka lah cih hae zah,</para>
  <para style="q1">mih seinaw kha ka thyaasah lan khyh hae,</para>
  <para style="q2">pawccecize <char style="nd">Bawipaw </char> tuh</para>
  <para style="q1">Zion kya a um.</para>
</usx>