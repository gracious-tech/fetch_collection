<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="HAB" style="id">Baebu Thyaa</book>
  <para style="h">HABAKKUK</para>
  <para style="toc1">Habakkuk</para>
  <para style="toc2">HABAKKUK</para>
  <para style="toc3">Hab</para>
  <para style="mt1">HABAKKUK</para>
  <para style="mt2">Habakkuk</para>
  <para style="imt">Byalaanmaw</para>
  <para style="ip">Profeh Habakkuh bya hynh Babilon hae nynh a uk lya hae, BC 600 athang dyn kya yn langkuhpaw nynh thua. Babilon hae nynh mih rysawthya keiccuze myarya a lungriathae zah Bawipaw kha, “Ccungccaw hoylei hae paw nynh mimaw laeze a dinghua hae paw kha a ro lya hae khe pawccemou yccae leite na um?” (1.13) a cipya. Bawipaw nynh a khungrupaw tuh, Bawipaw nynh accyh azaw te a cyih cih cite hopah zah, “miding hae tuh mih zynnaw liate a hiin hae,” (2.4) a ci.</para>
  <para style="ip">E ccauh lungkhu umpaw tuhlaepaw tuh, a ding lei hae paw tungvaw kya ronaw a thua lanpaw hodaenaw, Pachia lesaenaw lungpawnaw hlaw te e ccauh zeitu nynh tynkaring lan Pachia a zynnaw kong nynh thua.</para>
  <para style="iot">Abyalupi hae</para>
  <para style="io1">Habakkuk a lungccing leinaw bya te Bawipaw nynh a khungpaw bya 1.1—2.4</para>
  <para style="io1">A ding lei hae paw kha ronaw 2.5-20</para>
  <para style="io1">Habakkuk sawsangnaw 3.1-19</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />Profeh Habakkuh nynh a muihpaw vizin.</para>
  <para style="b" />
  <para style="s1">Profeh nynh Byakhianaw</para>
  <para style="q1">
    <verse number="2" style="v" />Pou <char style="nd">Bawipaw </char>, hohseciamou</para>
  <para style="q2">bawmnaw mue khylan ka sia cih zah,</para>
  <para style="q2">ngaepya leite nae um cih?</para>
  <para style="q1">Hohseciamou na kalan khe,</para>
  <para style="q2">“Puathote yn cyi hae!” cite</para>
  <para style="q1">ka sia cih zah,</para>
  <para style="q2">khum leite nae um cih?</para>
  <para style="q1">
    <verse number="3" style="v" />Pawccemou hoyleinaw hynh</para>
  <para style="q2">nae tungsah zah,</para>
  <para style="q1">vawsawnaw hynh</para>
  <para style="q2">phang na do huataw?</para>
  <para style="q1">Ronaw te puathonaw tuh</para>
  <para style="q2">ka malang phang a um;</para>
  <para style="q1">pekumaekunaw te</para>
  <para style="q2">eikunaw tuh a um.</para>
  <para style="q1">
    <verse number="4" style="v" />Kawbya tuh a thawzya zah,</para>
  <para style="q2">byading nynh kharouh</para>
  <para style="q2">tae vae khyh.</para>
  <para style="q1">Hoyleinaw nynh miding hae kha</para>
  <para style="q2">a koihlu hae—</para>
  <para style="q1">tukeiccuze byapianaw tuh</para>
  <para style="q2">kyh vae khyh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" />Minphuin hae khuh</para>
  <para style="q2">dotua oh lah, muihtua oh!</para>
  <para style="q1">Nae ngaeangthua sah!</para>
  <para style="q2">Nae khuaruaru sah!</para>
  <para style="q1">Pawccecize nanning kha</para>
  <para style="q2">ae hopya oh zemah,</para>
  <para style="q1">na zyn lei lan oh paw</para>
  <para style="q2">ryalaw ccangkheit kha</para>
  <para style="q2">nae she kya ka cyi vae.<note caller="-" style="x"><char style="xo" closed="false">1.5: </char><char style="xt" closed="false"><ref loc="ISA 52:7">Isa 52.7</ref></char></note></para>
  <para style="q1">
    <verse number="6" style="v" />A rysawthah zah</para>
  <para style="q2">a thindynpaw Khaldi hae kha</para>
  <para style="q2">ka tuhou cih hae,</para>
  <para style="q1">mimaw kya-e athua leipaw</para>
  <para style="q2">ram kha luade khylan,</para>
  <para style="q1">laephi pynpi po lekuh lan</para>
  <para style="q2">a cceih hae.<note caller="-" style="x"><char style="xo" closed="false">1.6: </char><char style="xt" closed="false"><ref loc="2KI 24:2">2Si 24.2</ref></char></note></para>
  <para style="q1">
    <verse number="7" style="v" />Minmin tuh ri lan te</para>
  <para style="q2">siiku lan myarya um hae;</para>
  <para style="q1">mimaw kaw te kyalya</para>
  <para style="q2">bya a pia hae.</para>
  <para style="q1">
    <verse number="8" style="v" />Mih marang hae tuh</para>
  <para style="q2">kaesing laeze mih thyranghua,</para>
  <para style="q1">zete riryngmoh kya</para>
  <para style="q2">a khiavuikuhpaw suizaw laeze</para>
  <para style="q1">ri lan umhua hae;</para>
  <para style="q2">mih marang hae tuh a thohkuh hae.</para>
  <para style="q1">Mih marang rhawkaw hae tuh</para>
  <para style="q2">asawnaw langte oun cceih hae;</para>
  <para style="q1">aepaw a zounuapaw</para>
  <para style="q2">mosipi hawte oun zou hae.</para>
  <para style="q1">
    <verse number="9" style="v" />Mih balynte puathote</para>
  <para style="q2">tae khylan oun cceih hae,</para>
  <para style="q1">mih mae kha malang khe</para>
  <para style="q2">tahrarin lan a hawi hae;</para>
  <para style="q1">minmin nynh a kyng hae paw kha</para>
  <para style="q2">suelua hae zah laesia zeih acih hae.</para>
  <para style="q1">
    <verse number="10" style="v" />Siapharan hae kha sarya hae zah,</para>
  <para style="q2">uktu hae kha ccyasahnaw lang a mang hae.</para>
  <para style="q1">Rhawlungrua miakaw kha</para>
  <para style="q2">a nuinse hae,</para>
  <para style="q1">laephi dohsakute tuk</para>
  <para style="q2">hae zah a law hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Tetuh khisan hawte</para>
  <para style="q2">zaw hae zah azo hae;</para>
  <para style="q1">minmin tuh mesei hae zah</para>
  <para style="q2">aseipaw lang a tang hae,</para>
  <para style="q1">mih thungnaw tuh</para>
  <para style="q2">mih pachia nynh thua!</para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" />Pou <char style="nd">Bawipaw </char> ka Pachia,</para>
  <para style="q2">A thyaapaw ka Pachia,</para>
  <para style="q1">nang tuh langmawlya te</para>
  <para style="q2">phe na um vae khaw?</para>
  <para style="q2">Nang tuh na chih lan khyh.</para>
  <para style="q1">Pou <char style="nd">Bawipaw </char>, minmin kha</para>
  <para style="q2">byapiatu lang na nung vae hae;</para>
  <para style="q1">Pou Lungpi, kaening detah khylan</para>
  <para style="q2">minmin kha na khang vae hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Na mit tuh myaryamaw thyaa zah</para>
  <para style="q2">ahoy leipaw kha na do khyh,</para>
  <para style="q1">ahoy leipaw cyisahnaw kha na do khyh;</para>
  <para style="q2">tuhte athua ze, pawccemou</para>
  <para style="q1">mih lungzi lei hae paw kha</para>
  <para style="q2">do kyalya te na do hae zah,</para>
  <para style="q1">ccungccaw hoylei hae paw nynh</para>
  <para style="q2">mimaw laeze a dinghua hae paw kha</para>
  <para style="q1">a laang lya hae khe</para>
  <para style="q2">pawccemou yccae leite na um?</para>
  <para style="q1">
    <verse number="14" style="v" />Ccungccaw hae kha</para>
  <para style="q2">rili kya-e ngasaw hae hawte na rae hae zah,</para>
  <para style="q1">uktu a hoi lei hae paw,</para>
  <para style="q2">avawthyapaw ripaw hae hawte na rae hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" />Rhaw nynh minmin kha</para>
  <para style="q2">ngasabaw te pong a baw hae;</para>
  <para style="q1">a miabu te rawkhaw hae zah</para>
  <para style="q2">a suebia hae,</para>
  <para style="q1">a paih te bong hae zah a suelua hae,</para>
  <para style="q2">tukeiccuze a lungtua zah</para>
  <para style="q2">a lungpawkhaekuh.</para>
  <para style="q1">
    <verse number="16" style="v" />Tukeiccuze a miabu kalan khe</para>
  <para style="q2">silawnaw rae zah,</para>
  <para style="q1">a paih kalan khe pyapaw uccaw kha a pya;</para>
  <para style="q2">pawccecize tuh-e hae liate</para>
  <para style="q1">a ccoupaw uccaw tuh</para>
  <para style="q2">myarya lung zah, looh patae a hoi.</para>
  <para style="q1">
    <verse number="17" style="v" />Te aning nynh a thaloi kha</para>
  <para style="q2">a mang zungzae cih zah,</para>
  <para style="q1">minphuin hae kha thawcci leite</para>
  <para style="q2">a roh cih hae tou?</para>
  <chapter number="2" style="c" />
  <para style="s1">Pachia nynh Profeh kha Bya A Khung</para>
  <para style="p">
    <verse number="1" style="v" />Rhaw ka vianaw innhangpaw kya</para>
  <para style="q2">ka thadyn cih zah, atolang e</para>
  <para style="q1">rhawlungrua vawlan khe ka um cih;</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh ka lungccing</para>
  <para style="q1">leinaw konglang kha</para>
  <para style="q2">ka kalan pawtemou</para>
  <para style="q1">yn hopya cipaw te</para>
  <para style="q2">pawtemou bya yn khung cipaw kha</para>
  <para style="q2">phang ka ngaw cih.</para>
  <para style="q1">
    <verse number="2" style="v" />Te <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">kae kha bya yn khungru zah:</para>
  <para style="q1">Vizin kha zeitua;</para>
  <para style="q2">a ccuetupaw nynh</para>
  <para style="q1">a ccue lalia lante a ria kho nawlan,</para>
  <para style="q2">lungphe kyakhe ccaerarih lan zeitua.</para>
  <para style="q1">
    <verse number="3" style="v" />Vizin accing ccyh zaw loh khyh,</para>
  <para style="q2">tuh-e vizin nynh athangnaw ccyh kha</para>
  <para style="q2">ho zah, hyn khyh.</para>
  <para style="q1">Tuh-e vizin tuh accyh aro ung cih paw</para>
  <para style="q2">alo lanze ngaw hin;</para>
  <para style="q1">soleite accing cih,</para>
  <para style="q2">accyh ro vae lan khyh.<note caller="-" style="x"><char style="xo" closed="false">2.3: </char><char style="xt" closed="false"><ref loc="HEB 10:37">Heb 10.37</ref></char></note></para>
  <para style="q1">
    <verse number="4" style="v" />A lysakuh hae paw kha dotua hae!</para>
  <para style="q2">Mih thinlung tuh ding khyh,</para>
  <para style="q1">thuasalama miding hae tuh</para>
  <para style="q2">mih zynnaw liate a hiin hae.<note caller="-" style="x"><char style="xo" closed="false">2.4: </char><char style="xt" closed="false"><ref loc="ROM 1:17">Rom 1.17</ref>; <ref loc="GAL 3:11">Gal 3.11</ref>; <ref loc="HEB 10:38">Heb 10.38</ref></char></note></para>
  <para style="q1">
    <verse number="5" style="v" />Hoirumnaw tuh ling a mang;</para>
  <para style="q2">a lysakuhpaw tuh tyn khyh,</para>
  <para style="q1">mih lotharue kha Michi khua hawte</para>
  <para style="q2">kobalae lan a aw hae;</para>
  <para style="q1">Chinaw hawte azaw vae ci um boi khyh;</para>
  <para style="q2">minphuin hae balyn kha</para>
  <para style="q1">mimaw hanlan suelua hae zah,</para>
  <para style="q2">ccungccaw balyn kha</para>
  <para style="q1">mimaw kalan a pum hae.</para>
  <para style="b" />
  <para style="s1">Ccungccaw Hoylei hae Vawsawnaw</para>
  <para style="p">
    <verse number="6" style="v" />Taepaw ccungccaw hae nynh</para>
  <para style="q2">a taetu hae paw kha</para>
  <para style="q1">saryanawpaw kesihkesahpaw bya khate,</para>
  <para style="q2">“Nae uccaw athua leipaw kha</para>
  <para style="q2">a ccakhungkuh hae paw</para>
  <para style="q1">nanning hanlan ngaethya lan kou um!”</para>
  <para style="q2">cite a theihrya cih hae zawtou?</para>
  <para style="q1">Hohseciamou naemaw toulou kha</para>
  <para style="q2">na law oh paw laebah khate</para>
  <para style="q2">nae phupaw na risakuh ung cih oh?</para>
  <para style="q1">
    <verse number="7" style="v" />Laebah ae ungsah oh paw tuh</para>
  <para style="q2">palou oun thua lan khyh hae tou?</para>
  <para style="q1">Nanning ae thyngsakuh oh paw tuh</para>
  <para style="q2">oun thokuh lan khyh hae tou?</para>
  <para style="q1">Tetuh nanning tuh minmin nynh</para>
  <para style="q2">luadete a lawku hae paw lang</para>
  <para style="q2">na tang vae cih oh.</para>
  <para style="q1">
    <verse number="8" style="v" />Nanning nynh minphuin patae kha</para>
  <para style="q2">na luade oh keiccuze,</para>
  <para style="q1">a hiinhypaw ccungccaw hae nynh</para>
  <para style="q2">nanning kha ae luade ru cih oh—</para>
  <para style="q1">ccungccaw na chia oh keiccu thuasah,</para>
  <para style="q2">laephi vaw e ccungccaw hae,</para>
  <para style="q1">khuapi hae te tuin kya</para>
  <para style="q2">um hae paw balyn tungvaw kya</para>
  <para style="q1">puathote rya na law</para>
  <para style="q2">oh keiccu thuasah ae luade ru cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" />“Vawsawnaw nynh a phya</para>
  <para style="q2">khonaw kyate lue khylan</para>
  <para style="q1">nae bu kha ahangnaw kya</para>
  <para style="q2">raekute nae innbyn hanlan ahme lei lante</para>
  <para style="q1">uccaw a mue hae paw</para>
  <para style="q2">nanning hanlan ngaethya lan kou um!”</para>
  <para style="q1">
    <verse number="10" style="v" />Nanning nynh ccungccaw patae</para>
  <para style="q2">kha chiate nae innbyn kha</para>
  <para style="q1">maethyasah lan na paccyn vae oh;</para>
  <para style="q2">nae hiinnaw kha na zosaku vae oh.</para>
  <para style="q1">
    <verse number="11" style="v" />Pang thungnawpaw lung nynh heize</para>
  <para style="q2">pang kyate a sia cih zah,</para>
  <para style="q1">inn-boeipae nynh a khungru cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" />“Chiise luanaw te khua kha na rae oh zah,</para>
  <para style="q2">hoyleinaw vawlan khe khuapi kha</para>
  <para style="q1">na thadynsah oh paw nanning hanlan</para>
  <para style="q2">ngaethya lan kou um!”</para>
  <para style="q1">
    <verse number="13" style="v" />Ccungccaw hae nynh maeesoi hanlan</para>
  <para style="q2">thawbangte rya a law hae paw te</para>
  <para style="q1">minphuin hae nynh accakaepaw hanlan</para>
  <para style="q2">mih thaw a bangsaku hae paw kha</para>
  <para style="q1">Vaaw <char style="nd">Bawipaw </char> nynh</para>
  <para style="q2">a cyipaw thua khyh tou?</para>
  <para style="q1">
    <verse number="14" style="v" />Thuasalama rili tuh tui te phe abia hawte,</para>
  <para style="q2">laephi tuh <char style="nd">Bawipaw </char> phu-enaw</para>
  <para style="q2">nythyanaw khate phe abeih cih.<note caller="-" style="x"><char style="xo" closed="false">2.14: </char><char style="xt" closed="false"><ref loc="ISA 11:9">Isa 11.9</ref></char></note></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" />“Mih ccakaete a um hae paw</para>
  <para style="q2">nae innpaw hae kha do khylan,</para>
  <para style="q1">a rui makhia hae ruithyapaw kha</para>
  <para style="q2">na bu oh zah, na niasah oh paw</para>
  <para style="q2">nanning hanlan ngaethya lan kou um!”</para>
  <para style="q1">
    <verse number="16" style="v" />Nanning tuh phu-enaw te</para>
  <para style="q2">thua leite thethyanaw khate</para>
  <para style="q1">phe na byn cih oh,</para>
  <para style="q2">Naemaw mah neih oh lah,</para>
  <para style="q1">tangkitangkae lante cceih oh!</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kuih kya umpaw</para>
  <para style="q1">detahnaw banang nynh</para>
  <para style="q2">nanning kha ae koihlu cih oh zah,</para>
  <para style="q1">nae phu-enaw tuh</para>
  <para style="q2">maethyanaw lang a tang cih!</para>
  <para style="q1">
    <verse number="17" style="v" />Lebanon tungvaw puathote</para>
  <para style="q2">rya na law oh paw kha nynh</para>
  <para style="q1">naemaw kha ae roh cih oh;</para>
  <para style="q2">sarangpaw hae na chia oh,</para>
  <para style="q1">atu tuh sarangpaw hae nynh</para>
  <para style="q2">naemaw kha nae thin ae phangsah cih oh,</para>
  <para style="q1">ccungccaw na chia oh keiccu thuasah,</para>
  <para style="q2">laephi vaw e ccungccaw hae,</para>
  <para style="q1">khuapi hae te tuin kya</para>
  <para style="q2">um hae paw balyn tungvaw kya</para>
  <para style="q1">puathote rya na law oh keiccu thuasah</para>
  <para style="q2">nae thin ae phangsah cih oh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" />A raetupaw nynh a raepaw zohtuh tuh</para>
  <para style="q2">pawmou a thane?</para>
  <para style="q1">Laeepaw zohtuh, ling sazaepaw tuh</para>
  <para style="q2">pawmou a thane?</para>
  <para style="q1">Bya san a ho kho leipaw</para>
  <para style="q2">zohtuh sasaw mang athua pite,</para>
  <para style="q1">zohtuh a raetupaw nynh</para>
  <para style="q2">khah-e zohtuh kha a doliaku!</para>
  <para style="q1">
    <verse number="19" style="v" />Thingtung kha, “Inaw kyate</para>
  <para style="q2">tho ccavae!” cite hopah hae zah,</para>
  <para style="q1">yccae leipaw lungtung kha,</para>
  <para style="q2">“Thoku tua!” cite a hopahpaw</para>
  <para style="q1">nanning hanlan ngaethya lan kou um.</para>
  <para style="q2">Zohtuh nynh ae ccangpah kho tou?</para>
  <para style="q1">Zohtuh tuh sui te ngun khate</para>
  <para style="q2">raedepaw thua zah, a lungkhu kya</para>
  <para style="q1">hiinnaw papin um khyh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" />
    <char style="nd">Bawipaw </char> tuh athyaapaw</para>
  <para style="q2">a beikinn kya a um;</para>
  <para style="q1">laephi ccungccaw balyn nynh</para>
  <para style="q2">amaw malang daebabi lan um hae sah!</para>
  <para style="b" />
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Shigionoth roi thyhte Profeh Habakkuh sawsangnaw.</para>
  <para style="b" />
  <para style="s1">Profeh Sawsangnaw</para>
  <para style="q1">
    <verse number="2" style="v" />Pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">na minthaannaw kha ka thae vae,</para>
  <para style="q1">Pou <char style="nd">Bawipaw </char>,</para>
  <para style="q2">na ryalawnaw kha</para>
  <para style="q2">ka ngaeangthua.</para>
  <para style="q1">Tuh-e ryalaw tuh kae she kyahin</para>
  <para style="q2">bua thawsah thui tua lah,</para>
  <para style="q1">kae she kyahin langsaku tua;</para>
  <para style="q2">na thinria lyamawkhe</para>
  <para style="q2">thawccinaw kha beih liathuitua.</para>
  <para style="q1">
    <verse number="3" style="v" />Pachia tuh Teman kyate yn thua,</para>
  <para style="q2">Athyaapaw Pachia tuh</para>
  <para style="q1">Paran Mua kyate yn thua.</para>
  <para style="q2">A phu-enaw nynh vaawlui kha</para>
  <para style="q1">bong zah, laephi tuh</para>
  <para style="q2">a thehoynaw te phe abeih.</para>
  <para style="q1">
    <verse number="4" style="v" />A awnaw tuh khuanin hawte a aw;</para>
  <para style="q2">a kuih kyate awnaw pou zah,</para>
  <para style="q1">tuin kyakhe a thungnaw kha</para>
  <para style="q2">thuruh athua.</para>
  <para style="q1">
    <verse number="5" style="v" />A malang khe shethya tuh cceih zah,</para>
  <para style="q2">a nulang anaekunaw khate</para>
  <para style="q2">ccinaw nynh a zui.</para>
  <para style="q1">
    <verse number="6" style="v" />Aning nynh thadyn zah</para>
  <para style="q2">laephi tuh ahy;</para>
  <para style="q1">aning nynh do hae zah</para>
  <para style="q2">minphuin hae tuh a thyngkuh hae.</para>
  <para style="q1">Zungzae tynpaw mua hae tuh a koi hae;</para>
  <para style="q2">langmawlya a la ccianawpaw,</para>
  <para style="q1">zungzae tynpaw</para>
  <para style="q2">sangpyng hae tuh a tingbung hae.</para>
  <para style="q1">
    <verse number="7" style="v" />Kushan kya-e bu hae nynh</para>
  <para style="q2">vawsaw a teing hae paw te</para>
  <para style="q1">Midian ram umpaw</para>
  <para style="q2">bu hae kya-e zokhawboei hae nynh</para>
  <para style="q2">a thyngku hae paw kha ka muih.</para>
  <para style="q1">
    <verse number="8" style="v" />Pou <char style="nd">Bawipaw </char>, vawkhu hae kha</para>
  <para style="q2">na thinrianua hae tou?</para>
  <para style="q1">Na marang hae kha</para>
  <para style="q2">na ccikuh hae zah, taenawpaw</para>
  <para style="q1">na marangle hae kha</para>
  <para style="q2">he na ccikuh hae te,</para>
  <para style="q1">vawkhu hae kha na thinrianua hae tou?</para>
  <para style="q2">Rili kha na thin-unua tou?</para>
  <para style="q1">
    <verse number="9" style="v" />Na li kha mang lan</para>
  <para style="q2">na nungdae zah, na the kha</para>
  <para style="q1">kaw lan na nungdae vae.</para>
  <para style="q2">Laephi kha vawkhu hae khate</para>
  <para style="q2">thoh na phia.</para>
  <para style="q1">
    <verse number="10" style="v" />Mua hae nynh nang kha</para>
  <para style="q2">ae muih hae zah a thyngkuh hae.</para>
  <para style="q1">Tui alepaw tuh alua hae;</para>
  <para style="q2">akhupaw rili hae tuh sia hae zah,</para>
  <para style="q1">khuanin nynh amaw</para>
  <para style="q2">a kuih kha a hang;</para>
  <para style="q1">
    <verse number="11" style="v" />myarya rangpaw</para>
  <para style="q2">na the hae tuh aw hae zah,</para>
  <para style="q1">phaephae akpaw na ccoi hae tuh</para>
  <para style="q2">awrarih lan a um lya hae khe,</para>
  <para style="q1">khuanin te sawpaw tuh</para>
  <para style="q2">mih umnaw kya a thadyn hae.</para>
  <para style="q1">
    <verse number="12" style="v" />Thin-ute laephi kya</para>
  <para style="q2">na cceih zah, minphuin hae kha</para>
  <para style="q2">thinriate na syde hae.</para>
  <para style="q1">
    <verse number="13" style="v" />Na ccungccaw hae kha</para>
  <para style="q2">khum khylan,</para>
  <para style="q1">chitui na thuh hae paw kha</para>
  <para style="q2">khum khylan nang tuh nae pou.</para>
  <para style="q1">Ccungccaw hoylei hae paw</para>
  <para style="q2">inn kya-e lu kha palae tui lan</para>
  <para style="q1">na miade zah, aleihpaw kyate</para>
  <para style="q2">innccukaly kyacia phe na zosah.</para>
  <para style="q1">
    <verse number="14" style="v" />A rhawkaw hae cciakhaetupaw kha</para>
  <para style="q2">amaw a the khate na thuingsah,</para>
  <para style="q1">minmin tuh kaening kha</para>
  <para style="q2">phiariphiarae nung khylan</para>
  <para style="q1">khiccung hawte oun thua hae,</para>
  <para style="q2">zya a rekuh hae paw ryachi hae kha</para>
  <para style="q1">ae lan a paccynkuh hae paw hawte</para>
  <para style="q2">mih lung atua.</para>
  <para style="q1">
    <verse number="15" style="v" />Na marang hae khate</para>
  <para style="q2">rili kha po he na zua tuh,</para>
  <para style="q1">athungpaw tui tuh athyhleihkuh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" />Tuh-e tuh he ka thae te</para>
  <para style="q2">ka thyngkuh; tuh-e roi keiccuze</para>
  <para style="q1">ka mung tuh athyngkuh.</para>
  <para style="q2">Ka ru tuh muee zah,</para>
  <para style="q1">ka ccu tuh athyngkuh.</para>
  <para style="q2">Kaening oun tuk hae paw</para>
  <para style="q1">ccungccaw hae tungvaw kya</para>
  <para style="q2">yn thua lanpaw vawsaw nin kha</para>
  <para style="q1">daebabi lan ka ngaw.</para>
  <para style="b" />
  <para style="s1">Vawsaw lya Lungpawnaw</para>
  <para style="q1">
    <verse number="17" style="v" />Thaeku ku nynh</para>
  <para style="q2">apaw paw khyh zah,</para>
  <para style="q1">misu ku kya athae</para>
  <para style="q2">a um khyh zemah thuasah,</para>
  <para style="q1">oliv thing nynh athae thae khyh zah,</para>
  <para style="q2">loo kyate looh</para>
  <para style="q1">apou khyh zemah thuasah,</para>
  <para style="q2">tuukhia kya tuu um khyh zah,</para>
  <para style="q1">sahiin inn kya sahiin</para>
  <para style="q2">a um khyh zemah thuasah</para>
  <para style="q1">
    <verse number="18" style="v" />
    <char style="nd">Bawipaw </char> kya ka lungtua cih zah,</para>
  <para style="q2">yn khumtu Pachia kya</para>
  <para style="q2">ka lungpaw cih.</para>
  <para style="q1">
    <verse number="19" style="v" />Bawipaw PACHIA tuh</para>
  <para style="q2">ka thawzung nynh thua;<note caller="-" style="x"><char style="xo" closed="false">3.19: </char><char style="xt" closed="false"><ref loc="2SA 22:34">2Sa 22.34</ref>; <ref loc="PSA 18:33">Sam 18.33</ref></char></note></para>
  <para style="q1">ka ccu kha sazuh ccu hawte</para>
  <para style="q2">a liazawsah zah,</para>
  <para style="q1">ahangpaw vawlan khe yn cciasah.</para>
  <para style="b" />
</usx>