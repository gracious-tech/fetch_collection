<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="MRK" style="id">Baebu Thyaa</book>
  <para style="h">MARKA</para>
  <para style="toc1">Mark</para>
  <para style="toc2">MARKA</para>
  <para style="toc3">Mar</para>
  <para style="mt">MARKA</para>
  <para style="mt2">KYATE THEHOYPAW</para>
  <para style="mt2">Mark</para>
  <para style="imt">Byalaanmaw</para>
  <para style="im">
    <char style="bk">Thehoypaw Marka </char> nynh “Pachia Ccapaw Jesu Khri kong Thehoypaw,” cite bya a tho. Jesu tuh rya a lah zungzaepaw ccungccaw te kawhoitu hawte a lang. A kawhoinaw tuh a ccangpyanaw kya, Satan hae tungvaw a huhan, ccungccaw seinaw hae a ngaethyanaw kya muih lan a um. Jesu nynh seinaw kyate ccungccaw hae luesah lan a hiinnaw pyakute yn thuapaw Ccungccaw a thuanawpaw a hoku.</para>
  <para style="ip">
    <char style="bk">Marka</char> nynh Jesu phungpaw hynh ccaerarih lan zei zah, a ccangpyanaw hae te a bya hae laeze a ryalaw hae kha abyapi lan a law. Baptisma pyatu Johan konglang bya a tho nawlan a ho koute Jesu baptisma a innaw te tuhounaw a ingnaw a zei koute ccawzeitu nynh Jesu ryalawpaw dansahnaw te ccangpyanaw a zei. Sosoh koute Jesu a zui hae paw nynh amaw kha houh oun ny hae, thuasalama a ry lei hae paw nynh houh a hua hae. Athangnaw byaria hae nynh Jesu tungvaw nyathya lonaw ze laephi hiinnaw kya acyihkuhpaw, vaelantahnaw te a thoothuinaw hae alae lante a langsaku hae.</para>
  <para style="ip">Thehoypaw nynh thangnaw ccangning hoi zah, tuh-e hae tuh koihpaw (bracket) lungkhu kya zei hae paw thua zah <char style="bk">Mark</char> zeitu nynh zeipaw thua leite mingccang hae nynh a zei hae paw nynh athua cih cite zynnaw a um.</para>
  <para style="iot">Alungkhu Umpaw</para>
  <para style="io1">Thehoypaw a thonaw — 1.1-13</para>
  <para style="io1">Galilee kya Jesu nynh zapi kya ryalawnaw — 1.14—9.50</para>
  <para style="io1">Galilee kyate Jerusalem lang — 10.1-52</para>
  <para style="io1">Jerusalem pepan te nyathya lonaw — 11.1—15.47</para>
  <para style="io1">Jesu thoothuinaw — 16.1-8</para>
  <para style="io1">A thoothuipaw Bawipaw a langkunaw te vaawlang a kaenaw — 16.9-20</para>
  <chapter number="1" style="c" />
  <para style="s1">Baptisma Pyatu Johan Phunghonaw</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mat 3.1-12</ref>; <ref loc="LUK 3:1-18">Luk 3.1-18</ref>; <ref loc="JHN 1:19-28">Joh 1.19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Pachia Ccapaw Jesu Khri thehoypaw athotakawnaw.</para>
  <para style="p">
    <verse number="2" style="v" />Profeh Isaiah ccauh kya,</para>
  <para style="q1">“Dotua, na laanpi a paccyn cih paw</para>
  <para style="q2">ka zeccuetu kha</para>
  <para style="q2">na malang ka saw cih.<note caller="-" style="x"><char style="xo" closed="false">1.2: </char><char style="xt" closed="false"><ref loc="MAL 3:1">Mal 3.1</ref></char></note></para>
  <para style="q1">
    <verse number="3" style="v" />Ramkaw kya a siapaw</para>
  <para style="q2">lukheitpaw roi nynh,</para>
  <para style="q1">‘Bawipaw laanpi kha</para>
  <para style="q2">paccynpah oh, a laanpi kha</para>
  <para style="q1">lawbabin lan raepah oh,’ a ci,”</para>
  <para style="q2">cite azeiku hawte;<note caller="-" style="x"><char style="xo" closed="false">1.3: </char><char style="xt" closed="false"><ref loc="ISA 40:3">Isa 40.3</ref> (LXX)</char></note></para>
  <para style="m">
    <verse number="4" style="v" />Baptisma pyatu Johan tuh ramkaw kya yn langkuh zah, seinaw ngaethyanaw hanlan ngaesikunaw te asekuhpaw baptisma kong kha a ho. <verse number="5" style="v" />Judea ram um hae paw balyn te Jerusalem khuaccaaw hae balyn tuh Johan kalan oun cceih hae; mih seinaw phykuh hae zah Jordan vaw kya Johan nynh baptisma a pya hae. <verse number="6" style="v" />Johan tuh kalauh ming te kuakuhpaw boeining kha lawkuh zah a tae kya saving taeccia kha a cciaku, te tungkhipaw te ramkaw e khoitui kha nynh a ae.<note caller="-" style="x"><char style="xo" closed="false">1.6: </char><char style="xt" closed="false"><ref loc="2KI 1:8">2Si 1.8</ref></char></note> <verse number="7" style="v" />Te aning nynh, “Kae laeze a thung huapaw tuh kamaw koute yn thua cih, kae tuh tuh-e paw phanah rui phoupya lan sanmah ka ngaekuh khyh. <verse number="8" style="v" />Kae nynh nanning kha tui te baptisma kae pya oh, thuasalama aning nynh tuh Thyaa Muisaw te baptisma ae pya cih oh,” cite phung a ho.</para>
  <para style="s1">Jesu Baptisma Innaw</para>
  <para style="r">(<ref loc="MAT 3:13-17">Mat 3.13-17</ref>; <ref loc="LUK 3:21-22">Luk 3.21-22</ref>)</para>
  <para style="p">
    <verse number="9" style="v" />Tuin nin hae kyakhe Galilee pee Nazareth khua kyate Jesu yn thua zah Jordan vaw khe Johan nynh baptisma a pya. <verse number="10" style="v" />Tui lungkhu te yn pou miakaw te, vaawlang yn hungkupaw te Muisaw nynh vahu hawte a tungvaw yn ccupaw kha a muih. <verse number="11" style="v" />Te vaawlang te roi yn ccae zah, “Nang tuh ka sungsahpaw ka Ccapaw nynh na thua; na tungvaw kya ka lungry accing,” a ci.<note caller="-" style="x"><char style="xo" closed="false">1.11: </char><char style="xt" closed="false"><ref loc="GEN 22:2">Gen 22.2</ref>; <ref loc="PSA 2:7">Sam 2.7</ref>; <ref loc="ISA 42:1">Isa 42.1</ref>; <ref loc="MAT 3:17">Mat 3.17</ref>, <ref loc="MAT 12:18">12.18</ref>; <ref loc="MRK 9:7">Mar 9.7</ref>; <ref loc="LUK 3:22">Luk 3.22</ref></char></note></para>
  <para style="s1">Jesu Tuhounaw</para>
  <para style="r">(<ref loc="MAT 4:1-11">Mat 4.1-11</ref>; <ref loc="LUK 4:1-13">Luk 4.1-13</ref>)</para>
  <para style="p">
    <verse number="12" style="v" />Vaekheihmawte Muisaw nynh Jesu kha ramkaw lang cciakhae zah, <verse number="13" style="v" />tuin kyakhe nin sung pali um zah Satan nynh a tuhou; loramsaw hae ryte umkheih hae zah vaaw hae nynh a do-oih hae.</para>
  <para style="s1">Galilee kya Jesu Ryalaw Thonaw</para>
  <para style="r">(<ref loc="MAT 4:12-17">Mat 4.12-17</ref>; <ref loc="LUK 4:14-15">Luk 4.14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" />Johan kha thong a sah kou hae te, Jesu tuh Galilee pee lang cceih zah Pachia thehoypaw kha ho zah, <verse number="15" style="v" />“Accyh phe ccing vae, Pachia peenaw tuh anae vae, ngaesikuh oh lah thehoypaw kha zyn oh,” a ci.<note caller="-" style="x"><char style="xo" closed="false">1.15: </char><char style="xt" closed="false"><ref loc="MAT 3:2">Mat 3.2</ref></char></note></para>
  <para style="s1">Masaty Jesu Zuitu hae Konaw</para>
  <para style="r">(<ref loc="MAT 4:18-22">Mat 4.18-22</ref>; <ref loc="LUK 5:1-11">Luk 5.1-11</ref>; <ref loc="JHN 1:35-42">Joh 1.35-42</ref>)</para>
  <para style="p">
    <verse number="16" style="v" />Galilee Rili pe Jesu po a cceih tuh, Simon te a neitaw Andru nynh rili lungkhu mia a vua hae paw kha a muih, pawccecize minmin tuh ngasaw kyngtu hae nynh thua hae. <verse number="17" style="v" />Jesu nynh minmin kha, “Kae hynh yn zui oh lah nanning kha ccungccaw kyngtu hae lang kae rae cih oh,” a cipya hae. <verse number="18" style="v" />Vaekheihmawte mih mia kha cciataw hae zah amaw kha a zui hae. <verse number="19" style="v" />Tuin kyate takyh asawnaw lang he thua tuh, kohlung lungkhu mih mia a thue cciamang hae paw, Zebedi ccapaw James te a neitaw Johan kha a muih hae. <verse number="20" style="v" />Minmin kha vaekheihmawte a ko hae; minmin nynh a hoh hae paw ccungccaw hae ryte mih paaw Zebedi kha kohlung kya cciataw hae zah amaw kha a zui hae.</para>
  <para style="s1">Jesu nynh Raerangsaro A Dee</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luk 4.31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" />Jesu te a zuitu hae tuh Kapernaum khua lang cceih hae zah, sabbath nin khe Jesu nynh sinakok lungkhu lang tee zah a ccangpya hae. <verse number="22" style="v" />A ccangpyanaw a thae hae paw tuh a ccangpyanaw kha mih ngaeangthua, pawccecize kawbya sazae hae hawte thua leite, kawhoipaw lu kheit hawte a ccangpya hae.<note caller="-" style="x"><char style="xo" closed="false">1.22: </char><char style="xt" closed="false"><ref loc="MAT 7:28-29">Mat 7.28-29</ref></char></note> <verse number="23" style="v" />Tuh ccyh lyakhe mih sinakok kya athyaa leipaw muisaw bahkuhpaw lu kheit a um, <verse number="24" style="v" />tuh-e paw nynh, “Nazareth paw Jesu, nang te kaening tuh pawmou ah sekuh oh? Kaening ro khylan tou nae thua? Nang tuh hum nynh na thua cipaw kae ny, Pachia kya-e Athyaapaw nynh na thua,” cite a sia. <verse number="25" style="v" />Jesu nynh kawpya zah, “Yccae nan, khah-e paw lungkhu kyate toikuh,” a cipya. <verse number="26" style="v" />Athyaa leipaw muisaw nynh tuh-e paw tuh thawte a dungsah koute raerae sia zah tuh-e paw kyate phe a toikuh. <verse number="27" style="v" />Te ccungccaw hae balyn tuh mih ngaeangthua zah, “E hynh pawtemou athua? E hynh athawpaw ccangpyakunaw tou? Pawccecize athyaa leipaw muisaw hae kha heize kawpya zah minmin nynh a kaw phe a ngae hae ccarei,” cite a hoku hae. <verse number="28" style="v" />Vaekheihmawte a thongpang tuh Galilee pepan balyn pong pazaekuh vae.</para>
  <para style="s1">Ccungccaw Patae A Dan hae</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mat 8.14-17</ref>; <ref loc="LUK 4:38-41">Luk 4.38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" />Sinakok kyate ccahe a pou hae te, Simon te Andru hae inn langkhe James te Johan ryte a tee hae. <verse number="30" style="v" />Simon a zu nung tuh ccih zah a ih cite Jesu kalan palou a hopya hae. <verse number="31" style="v" />Jesu nynh cceih zah a kuih te kyng zah a tho, te a ngesaw lingpaw tuh vaekheihmawte phe dan zah minmin elang rya a lawpah vae hae.</para>
  <para style="p">
    <verse number="32" style="v" />Zete khuanin he ccah te, ccinaw hoi hae paw balyn te raerangsaro bahkuh hae paw kha Jesu kalan oun cciakhae hae. <verse number="33" style="v" />Khuapi balynte thuakawzung khe oun sueluakuh hae. <verse number="34" style="v" />Ccinaw aphuinphuin te a ccih hae paw patae kha dansah hae zah raerangsaro patae a dee; aning nynh raerangsaro hae kha byaho lan kaw-ua khyh hae, pawccecize minmin nynh amaw kha a ny hae.</para>
  <para style="s1">Galilee Ram Jesu Phungho</para>
  <para style="r">(<ref loc="LUK 4:42-44">Luk 4.42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" />Awkhua takaw khuadae mawkhe Jesu tuh tho zah a pou, te ccungccaw um leinaw langkhe cceih zah tuin kya saw a sang. <verse number="36" style="v" />Simon te a ban hae nynh Jesu kha ccung hae zah, <verse number="37" style="v" />he a muih hae te, “Ccungccaw balyn nynh nang kha ae ccung hae,” cite a hopya hae. <verse number="38" style="v" />Jesu nynh, “Anaenaw khua hae kalan cceih oh sih, tuin kya phung ka ho ccaw, pawccecize tuh-e tuh nynh kae thuanuathepaw,” a cipya hae. <verse number="39" style="v" />Galilee ram po lekuh lan mih sinakok hae kya phungho zah raerangsaro hae kha a dee.<note caller="-" style="x"><char style="xo" closed="false">1.39: </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mat 4.23</ref>, <ref loc="MAT 9:35">9.35</ref></char></note></para>
  <para style="s1">Vaethyakaepaw A Dansah</para>
  <para style="r">(<ref loc="MAT 8:1-4">Mat 8.1-4</ref>; <ref loc="LUK 5:12-16">Luk 5.12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" />Vaethyakaepaw lu kheit nynh a kalan yn thua zah a malang bakhungte, “Na ry ze kae hynh nae thyaasah kho,” cite Jesu kha a ngiaku. <verse number="41" style="v" />Jesu nynh ngaethya a umsah pawte a kuih kha dyng zah tuh-e paw tuh hae zah, “Nang hynh thyaasah kae ry, thyaa ccavae,” a cipya. <verse number="42" style="v" />Tuhte a ho koute vaekheihmawte vaethya ccinaw tuh thyaa zah aning tuh a dan vae. <verse number="43" style="v" />Jesu nynh tuh-e paw tuh tynkaring lan byatawsya zah, <verse number="44" style="v" />“E konglang hynh humhung kya mah na ho khyh nawlan la raeringkuh; thuasalama ranpibawi kalan la cceih lah la dosakuh; te ccungccaw hae kya na dannawpaw ccaekia lang Moses kawbya thyhte silawnaw kha la rae,” cite a hopah koute palou a cciasah.<note caller="-" style="x"><char style="xo" closed="false">1.44: </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">Lev 14.1-32</ref></char></note> <verse number="45" style="v" />Thuasalama tuh-e paw nynh cceih zah tuh-e kong tuh pawpaw kya balyn pong a zeihsaku, tukeiccuze Jesu tuh khuapi lungkhu lang rythyte tee kho vae khyh; khuate lang ramkaw khe um zah, ccungccaw hae nynh mih umnaw raveih kyate amaw kalan oun thua hae.</para>
  <chapter number="2" style="c" />
  <para style="s1">Kuihccu Chihpaw A Dansah</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mat 9.1-8</ref>; <ref loc="LUK 5:17-26">Luk 5.17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Nin beihtaraw aro koute Jesu tuh Kapernaum khua lang yn ki zah aning tuh innvaw nynh a um cipaw kha a thae hae. <verse number="2" style="v" />Vaekheihmawte ccungccaw patae tuh oun sueluakuh hae, tukeiccuze thuakaw kin cia umnaw um lei lan inn nynh ccawng khyh hae; te Jesu nynh minmin kha phung a hopya hae. <verse number="3" style="v" />Ccungccaw lu pali nynh oun puih hae paw a kuihccu chihpaw lu kheit kha Jesu kalan oun cciakhae hae. <verse number="4" style="v" />Ccungccaw alung keiccuze Jesu kalan naekuh kho khyh hae zah a umnaw luki innccukaly kha a kiabia hae; poh a uasah kou hae te ngeccihpaw kha a inawpaw iphae ryte a sawbung hae. <verse number="5" style="v" />Jesu nynh mih zynnaw kha he a muih tuh kuihccu chihpaw kha, “Ka ccapaw, na seinaw tuh ngaethya athua vae,” a cipya. <verse number="6" style="v" />Tuin kya a haung hae paw kawbya sazae hae abang nynh mih lungkaw te, <verse number="7" style="v" />“E Paw hynh pawccemou tuhte Pachia saryapaw bya a ho? Pachia laelan hummou seinaw a ngaethya kho,” cite a tua hae. <verse number="8" style="v" />Jesu nynh mih lungkaw te a tua hae paw kha a thinlung te palou nyh zah, “Nae thinlung kya pawccemou tuhte na tua oh? <verse number="9" style="v" />Kuihccu chihpaw ngeccihpaw kha, ‘Na seinaw tuh ngaethya athua vae,’ cipya tou azoihua, tuhkhyhze ‘Thokuh lah na iphae kha lawkuh lah cceih ccavae,’ cipya tou azoihua? <verse number="10" style="v" />Ccungccaw Ccapaw tuh laephi vawlan seingaethya kaw a hoi cipaw na ny nawlan oh nynh thua,” cite a hopah kou hae te, <verse number="11" style="v" />Jesu nynh kuihccu chihpaw kha “Nang kae hopya, thokuh lah na iphae kha lawkuh lah na inn lang cceih ccavae,” a cipya. <verse number="12" style="v" />Tuh-e paw nynh thokuh zah vaekheihmawte a iphae kha lawkuh zah tuh-e hae balyn malang khe a cceih vae, mih balynte mih ngaeangthua zah, “Hynhcihawpaw hynh kharouh kae muih boi khyh!” ci hae zah Pachia kha a phu-esah hae.</para>
  <para style="s1">Jesu nynh Levi A Ko</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mat 9.9-13</ref>; <ref loc="LUK 5:27-32">Luk 5.27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" />Jesu tuh rili kin lang bua a cceih; ccungccaw zapi balyn tuh a kalan oun thua hae zah minmin kha a ccangpya hae. <verse number="14" style="v" />A ccia lyakhe ngunto khoinaw zung kya a haungpaw Alfeas ccapaw Levi kha muih zah, “Yn zui,” a cipya. Levi nynh thokuh zah a zui.</para>
  <para style="s1">Jesu Misei hae ryte A Ae</para>
  <para style="p">
    <verse number="15" style="v" />Jesu tuh Levi inn kya zete zerya a mang lyakhe, ngunto khoitu hae te misei hae patae mah Jesu ry, a zuitu hae ryte pynkheihlan a koihbua hae, pawccecize tuin kyakhe amaw a zui hae paw ccungccaw patae a um hae. <verse number="16" style="v" />Kawbya sazae hae te Farasi hae nynh Jesu tuh ngunto khoitu hae te misei hae ryte a aekheih hae paw he a muih hae tuh a zuitu hae kyakhe, “Pawccemou aning nynh ngunto khoitu hae te misei hae ryte a aekheih hae?” cite a khia hae. <verse number="17" style="v" />Tuh-e bya tuh Jesu nynh he a thae tuh minmin kha, “A dan hae paw nynh sibawi peki khyh hae, ngeccih hae rou nynh khaw a peki hae, kae tuh miding hae ko khylan kae thua khyh, misei hae ko khylan nynh kae thua,” a cipya hae.</para>
  <para style="s1">Looh-aesungnaw Kong Khianaw</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mat 9.14-17</ref>; <ref loc="LUK 5:33-39">Luk 5.33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" />Johan zuitu hae te Farasi hae zuitu hae tuh looh-ae leih a sung hae, te minmin nynh oun cceih hae zah Jesu kha, “Johan zuitu hae te Farasi hae zuitu hae tuh looh-ae kae sung, pawccemou nang na zuitu hae ze looh-ae a sung khyh hae?” a cipya hae. <verse number="19" style="v" />Jesu nynh minmin kha, “Zudy ccangvaepaw tuh zudy poi oun too hae paw kya a umbua lungkhu tuh tuh-e ccungccaw hae tuh looh-ae a sung cih hae zawtou? Zudy ccangvaepaw tuh minmin ryte a um lungkhu balyn tuh looh-ae sung lan khyh hae. <verse number="20" style="v" />Thuasalama zudy ccangvaepaw kha minmin kyate lawpya ccyh yn thua cih, tuin ccyh vae tuh looh-ae oun sung vae cih hae.</para>
  <para style="p">
    <verse number="21" style="v" />“Humhung nynh mah arynpaw boeining kha athawpaw boeibia te bia boi khyh, tuhte a bia lanze bianawpaw nynh arynpaw boeining kha po lah zah houh aseiikuh paleih vae. <verse number="22" style="v" />Humhung nynh mah athawpaw misutui kha arynpaw misutui-saphuabawng lungkhu lang ruin boi khyh. A ruin lanze misutui athawpaw nynh misutui-saphuabawng kha phae pawsah zah misutui azu, te misutui-saphuabawng tuh aroh; thuasalama athawpaw misutui tuh athawpaw misutui-saphuabawng kya nynh ruin lan accan,” a cipya hae.</para>
  <para style="s1">Sabbath Bawipaw</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mat 12.1-8</ref>; <ref loc="LUK 6:1-5">Luk 6.1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" />Jesu tuh sabbath nin kya loo kyakhe po a cceih; a ccia lya hae khe a zuitu hae nynh looh avui kha a zuku hae.<note caller="-" style="x"><char style="xo" closed="false">2.23: </char><char style="xt" closed="false"><ref loc="DEU 23:25">Deu 23.25</ref></char></note> <verse number="24" style="v" />Farasi hae nynh Jesu kha, “Dotua, pawccemou sabbath nin kya kawbya nynh a kheepaw kha minmin nynh a cyi hae?” cite a khia hae. <verse number="25" style="v" />Jesu nynh, “David nynh amaw te a umkheih hae paw ryte mih vuelaw zah looh a ry lya hae ze, paw nynh a cyi cipaw kha na ria boi khyh oh tou?<note caller="-" style="x"><char style="xo" closed="false">2.25-26: </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1Sa 21.1-6</ref></char></note> <verse number="26" style="v" />Ranpibawi lupi Abiathar ccyh lyaze aning nynh Pachia inn lungkhu lang tee zah kawbya nynh ranpibawi laelan humhung mah ae lan a ua leipaw Nungpyapaw sanlou kha ae zah amaw ryte umkheih hae paw kha mah a pyabua hae,” cite a khung hae.<note caller="-" style="x"><char style="xo" closed="false">2.26: </char><char style="xt" closed="false"><ref loc="LEV 24:9">Lev 24.9</ref></char></note> <verse number="27" style="v" />Jesu nynh, “Sabbath tuh ccungccaw hanlan raepaw nynh thua, ccungccaw tuh sabbath hanlan raepaw thua khyh. <verse number="28" style="v" />Tukeiccuze Ccungccaw Ccapaw tuh sabbath Bawipaw mah athua,” a cipya hae.</para>
  <chapter number="3" style="c" />
  <para style="s1">Sabbath Nin A Dansah hae</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mat 12.9-14</ref>; <ref loc="LUK 6:6-11">Luk 6.6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Jesu tuh sinakok lungkhu lang bua tee zah, tuin kya a kuih voikheit lang achihpaw lu kheit a la um. <verse number="2" style="v" />Minmin nynh Jesu kha seibe khylan, sabbath nin kyakhe tuh-e paw tuh yn dansah ta, yn dansah khyh ta cite a dokhaw hae. <verse number="3" style="v" />Jesu nynh a kuih achihpaw ccungccapaw kha, “Malang yn cceih,” a cipya. <verse number="4" style="v" />Tukoute Jesu nynh minmin kha, “Sabbath nin kya ahoypaw cyi lan kawbya nynh a ua tou? Tuhkhyhze ahoy leipaw cyi lan tou a ua? Hiinnaw kha so khum lan a ua tou? Tuhkhyhze chia lan tou a ua?” cite a khia hae. Thuasalama minmin tuh yccae khyh hae. <verse number="5" style="v" />Thinriate minmin kha po lekuh lan a do hae, mih lungkhungpaw elang a ngaethah zah tuh-e paw tuh, “Na kuih kha dyngtua,” a cipya. A kuih kha dyng zah phe a dan vae. <verse number="6" style="v" />Te Farasi hae tuh pou hae zah Jesu kha pawtemou chia lan cipaw tuh Herod ccungccaw hae ryte palou khua a khanku hae.</para>
  <para style="s1">Ccungccaw Patae A Dan hae</para>
  <para style="r">(<ref loc="LUK 6:17-19">Luk 6.17-19</ref>)</para>
  <para style="p">
    <verse number="7" style="v" />Jesu te a zuitu hae tuh rili kalan cceih hae zah Galilee pee um hae paw ccungccaw patae nynh amaw kha a zui hae; <verse number="8" style="v" />Judea pee Jerusalem khua, Idumea pee, Jordan vaw khuraw lang, Tair khua te Sidon khua pepan um hae paw ccungccaw zapi tuh Jesu nynh a cyipaw balyn kha thae hae zah amaw kalan oun thua hae. <verse number="9" style="v" />Ccungccaw zapi nynh amaw kha a eihsei khyh nawlan hae, Jesu nynh a zuitu hae kha amaw elang kohlung ccangkheit nungdaepya lan a hopya hae.<note caller="-" style="x"><char style="xo" closed="false">3.9-10: </char><char style="xt" closed="false"><ref loc="MRK 4:1">Mar 4.1</ref>; <ref loc="LUK 5:1-3">Luk 5.1-3</ref></char></note> <verse number="10" style="v" />Ccungccaw patae a dansah hae keiccuze ccinaw hoipaw ccungccaw miakaw nynh amaw kha hae khylan a kalan a tuh-eihku hae. <verse number="11" style="v" />Athyaa leipaw muisaw bahkuh hae paw nynh amaw kha he muih hae tuh a malang bakhung hae zah, “Nang tuh Pachia Ccapaw nynh na thua!” cite a sia hae. <verse number="12" style="v" />Jesu nynh amaw kong kha na nysah lan khyh oh cite tynkaring lan bya a kin hae.</para>
  <para style="s1">Locceihtu Lu Haw Lae Ning A Po</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mat 10.1-4</ref>; <ref loc="LUK 6:12-16">Luk 6.12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" />Jesu tuh mua vawlan kaethung zah a rypaw ccungccaw hae kha ko hae zah minmin tuh amaw kalan a cceih hae. <verse number="14" style="v" />Jesu nynh locceihtu hae cite mah min a phu hae paw lu haw lae ning kha amaw ryte umkheih khylan, phungho lan saw khylan te <verse number="15" style="v" />raerangsaro hae dee khonaw kaw hoi khylan a khang hae. <verse number="16" style="v" />Tuh-e a khang hae paw tuh: Simon (Peter cite min a phupaw); <verse number="17" style="v" />Zebedi ccapaw hae James te a neitaw Johan (minmin kha Boaneke cite min a phu hae, asuilan tuh ‘Ria ccapaw hae’ cipaw nynh thua); <verse number="18" style="v" />Andru, Filip, Bartholomew, Matthai, Thomas, Alfeas ccapaw James, Taddias, Kanaan khuapaw Simon, <verse number="19" style="v" />te Jesu pheetupaw Judas Iskariot nynh thua hae; tukoute Jesu tuh inn lang a cceih.</para>
  <para style="s1">Jesu te Beelzebul</para>
  <para style="r">(<ref loc="MAT 12:22-32">Mat 12.22-32</ref>; <ref loc="LUK 11:14-23">Luk 11.14-23</ref>, <ref loc="LUK 12:10">12.10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" />Ccungccaw zapi nynh bua oun thua hae keiccuze Jesu te a zuitu hae tuh ae san ae man khyh hae. <verse number="21" style="v" />Ccungccaw hae nynh, “Jesu tuh a lungkyh vae khyh,” a ci hae paw kha a vaeccaw hae nynh a thae hae keiccuze amaw kha oih lan a cceih hae. <verse number="22" style="v" />Jerusalem kyate oun cceihbung hae paw kawbya sazae hae nynh, “Aning tuh Beelzebul a hoi, raerangsaro hae uktu bawi liate nynh raerangsaro hae kha a dee kho,” a ci hae.<note caller="-" style="x"><char style="xo" closed="false">3.22: </char><char style="xt" closed="false"><ref loc="MAT 9:34">Mat 9.34</ref>, <ref loc="MAT 10:25">10.25</ref></char></note> <verse number="23" style="v" />Tetuh Jesu nynh minmin kha a kalan ko hae zah tousenaw phungpaw te a hopya hae paw tuh: “Pawtemou Satan nynh Satan tuh a dee kho cih? <verse number="24" style="v" />Ram ramkheit nynh amaw te amaw phiakuh zah a rhawku ze, tuh-e ram tuh tyn kho lan khyh. <verse number="25" style="v" />Innbyn byn kheit nynh amaw te amaw phiakuh zah a rhawku ze, tuh-e innbyn tuh tyn kho lan khyh. <verse number="26" style="v" />Satan nynh amaw te amaw kha rawsekuh zah a phiaku ze tyn kho lan khyh zah phe azo cih. <verse number="27" style="v" />A thawsaepaw lu kheit kha a khiide ty khyh ze, pawcihtemou tuh-e paw inn lungkhu lang a tee kho cih zah a uccaw hae kha a lua kho cih? A khiide ty ze nynh a inn kha a lua kho cih.</para>
  <para style="p">
    <verse number="28" style="v" />“Byaccaccing kae hopya oh, ccungccaw hae hynh mih seinaw te saryapaw bya a ho hae paw miakaw kha ngaethya athua cih. <verse number="29" style="v" />Thuasalama Thyaa Muisaw kha saryanaw bya a hopaw miakaw tuh seingaethyanaw papin mue lan khyh, pawccecize zungzae tynpaw seinaw a raepaw nynh thua,” a ci.<note caller="-" style="x"><char style="xo" closed="false">3.29: </char><char style="xt" closed="false"><ref loc="LUK 12:10">Luk 12.10</ref></char></note> <verse number="30" style="v" />Pawccemou hynhte a ho ci ze minmin nynh, “Aning tuh athyaa leipaw muisaw nynh a hoi,” a ci hae keiccu nynh thua.</para>
  <para style="s1">Jesu Vaeccaw hae Ccaccing</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mat 12.46-50</ref>; <ref loc="LUK 8:19-21">Luk 8.19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" />Jesu a nung te a neitawpaw hae tuh oun thua hae zah atolang khe a thadyn hae, te ccungccaw saw hae zah amaw kha a kosah hae. <verse number="32" style="v" />Jesu pepan a haung hae paw ccungccaw zapi nynh amaw kha, “Dotua, na nung te na neitaw hae te na ccianung hae nynh tungku ae ry hae zah atolang nynh a um hae,” a cipya hae. <verse number="33" style="v" />Jesu nynh, “Hum hae mou ka nung te ka neitaw hae tuh?” cite a khung hae. <verse number="34" style="v" />Te a pepan a haung hae paw kha po do hae zah, “Dotua oh, e hae hynh ka nung te ka neitaw hae! <verse number="35" style="v" />Humhung zemah Pachia rynaw a raepaw tuh ka neitaw, ka ccianung te ka nung nynh thua,” a ci.</para>
  <chapter number="4" style="c" />
  <para style="s1">Ccacii Vuatu Tousenaw</para>
  <para style="r">(<ref loc="MAT 13:1-9">Mat 13.1-9</ref>; <ref loc="LUK 8:4-8">Luk 8.4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Jesu nynh rili pe khe bua a ccangpya hae. A pe kya a pumkuh hae paw ccungccaw hae tuh eih a lung hae keiccuze kohlung lungkhu lang tee zah a haung. Kohlung tuh tui lungkhu um zah ccungccaw hae tuh varang lang a thadyn hae.<note caller="-" style="x"><char style="xo" closed="false">4.1: </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">Luk 5.1-3</ref></char></note> <verse number="2" style="v" />Jesu nynh tousenaw phungpaw hae khate patae a ccangpya hae; a ccangpyanaw kyaze minmin kha: <verse number="3" style="v" />“Ngaetua oh! Ccacii vuatu lu kheit nynh ccacii vua lan a cceih. <verse number="4" style="v" />Ccacii kha vua zah abang tuh laanpi pe accah, vaawlang e pavaw hae nynh oun thuanua hae zah phe a tuh hae. <verse number="5" style="v" />Abang tuh laephi zya zah lungpyng alungnaw kya accah; laephi thaawkalae lan a um khyh keiccuze taloi a po hae. <verse number="6" style="v" />Khuanin he yn thua tuh, tharui a saw khyh keiccuze karae arou hae. <verse number="7" style="v" />Abang ccacii tuh hinpaw laku ccah zah hinpaw nynh lethin zah phang a lungde keiccuze athae thae kho khyh. <verse number="8" style="v" />Te abang tuh lae hoy kya ccah zah a po, a pungthung, te athae thae zah leit sung thum, leit sung taruh, leit za kheit avoi. <verse number="9" style="v" />Thae nawlan nakaring a hoipaw ccungccaw tuh thae sah!” cite a hopya hae.</para>
  <para style="s1">Tousenaw nynh A Eenaw</para>
  <para style="r">(<ref loc="MAT 13:10-17">Mat 13.10-17</ref>; <ref loc="LUK 8:9-10">Luk 8.9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" />Jesu tuh a makhaete a um lyakhe, zuitu lu haw lae ning te amaw pe a um hae paw nynh tousenaw phungpaw kong kha a khia hae. <verse number="11" style="v" />Jesu nynh, “Pachia peenaw kya-e byakhupaw kha nanning tuh nysah na thua oh, thuasalama atolang um hae paw tuh pawpaw balyn kha tousenaw phungpaw te nynh hopya athua; <verse number="12" style="v" />tukeiccuze,</para>
  <para style="q1">‘Minmin nynh muihpaw tuh</para>
  <para style="q2">mang a muih hae zemah</para>
  <para style="q1">nyhthya khyh hae;</para>
  <para style="q2">thaepaw tuh mang a thae hae zemah</para>
  <para style="q1">thaethya khyh hae,</para>
  <para style="q2">tuhkhyhze tuh minmin tuh</para>
  <para style="q1">mih lung a paleihkuh cih zah</para>
  <para style="q2">mih seinaw kha</para>
  <para style="q1">ngaethya athua cih hae paw,’ a ci,”</para>
  <para style="m">cite a hopya hae.<note caller="-" style="x"><char style="xo" closed="false">4.12: </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">Isa 6.9-10</ref> (LXX)</char></note></para>
  <para style="s1">Jesu nynh Tousenaw A Ccaesah</para>
  <para style="r">(<ref loc="MAT 13:18-23">Mat 13.18-23</ref>; <ref loc="LUK 8:11-15">Luk 8.11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" />Jesu nynh minmin kha, “E tousenaw phungpaw hynh na thaethya khyh oh tou? Tuhteze ccangpaw tousenaw phungpaw hae balyn kha pawtemou na thaethya vae cih oh? <verse number="14" style="v" />Ccacii vuatu nynh Pachia bya kha a vua. <verse number="15" style="v" />Laanpi pe kya vuapaw bya tuh hynh-e hae hynh nynh thua: Minmin nynh Pachia bya kha he a thae hae tuh Satan nynh vaekheihmawte yn cceih zah mih thinlung kya a vua hae paw bya kha phe a lawpya hae. <verse number="16" style="v" />Tuhawte lung alungnaw kya vuapaw bya tuh hynh-e hae hynh nynh thua: Pachia bya kha he a thae hae tuh vaekheihmawte lungtuate a lawku hae; <verse number="17" style="v" />minmin nynh tharui a hoi khyh hae keiccuze sosoh rou nynh atyn. Tukoute Pachia bya keiccuze vawsawnaw te tuaasahnaw he yn thua tuh palou a maeleihkuh hae. <verse number="18" style="v" />Hinpaw hae laku vuapaw bya tuh hynh-e hae hynh nynh thua: Pachia bya kha a thae hae, <verse number="19" style="v" />thuasalama hynh-e laephi vaw e lungriathaenaw, hoirum rynaw, te ccangpaw uccaw hae duaanaw yn tee zah bya kha phang a lungde keiccuze athae thae kho vae khyh. <verse number="20" style="v" />Lae hoy kya vuapaw bya tuh hynh-e hae nynh thua: Pachia bya kha thae hae zah a lawku hae, te leit sung thum, leit sung taruh, leit za kheit athae avoi,” a cipya hae.</para>
  <para style="s1">Maeekhua Tousenaw</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luk 8.16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" />Jesu nynh, “Maeekhua tuh kee lungkhu thuasah, ikhung kaw thuasah a nung boi hae zawtou? Maee awnawpaw vawlan khang khyh hae tou?<note caller="-" style="x"><char style="xo" closed="false">4.21: </char><char style="xt" closed="false"><ref loc="MAT 5:15">Mat 5.15</ref>; <ref loc="LUK 11:33">Luk 11.33</ref></char></note> <verse number="22" style="v" />Alangkuh lei lante thuruhpaw miakaw kha langsah athua cih zah, khongpaw miakaw kha hungpya athua cih.<note caller="-" style="x"><char style="xo" closed="false">4.22: </char><char style="xt" closed="false"><ref loc="MAT 10:26">Mat 10.26</ref>; <ref loc="LUK 12:2">Luk 12.2</ref></char></note> <verse number="23" style="v" />Thae nawlan nakaring a hoipaw ccungccaw tuh thae sah!” cite a hopya hae. <verse number="24" style="v" />Jesu nynh, “Na thae oh paw kha raeringkuh oh, na tounaw oh paw tounawpaw te naemaw kha toupya ru na thua cih oh zah, houh lung lan heize pyachih na thua cih oh.<note caller="-" style="x"><char style="xo" closed="false">4.24: </char><char style="xt" closed="false"><ref loc="MAT 7:2">Mat 7.2</ref>; <ref loc="LUK 6:38">Luk 6.38</ref></char></note> <verse number="25" style="v" />Pawccecize a hoipaw ccungccaw tuh pyachih athua cih; thuasalama a hoi leipaw ccungccaw tuh a hoi thypaw kha heize lawpya athua cih,” a cipya hae.<note caller="-" style="x"><char style="xo" closed="false">4.25: </char><char style="xt" closed="false"><ref loc="MAT 13:12">Mat 13.12</ref>, <ref loc="MAT 25:29">25.29</ref>; <ref loc="LUK 19:26">Luk 19.26</ref></char></note></para>
  <para style="s1">Ccacii Tousenaw</para>
  <para style="p">
    <verse number="26" style="v" />Jesu nynh, “Ccungccapaw lu kheit nynh loo kya ccacii a vua, <verse number="27" style="v" />khuazi khe ih zah khua yn dae te a tho, te ccacii tuh po zah a lethung, pawtemou a lethung cipaw kha aning nynh nyh khyh. <verse number="28" style="v" />Pawccecize laephi nynh lethungsah zah thae a thaesah; masaty adung atoih, te avui, tukoute avui kya ccathae yn um. <verse number="29" style="v" />Thuasalama ccathae he yn voi tuh aning nynh rungkou te taloi a aw vae, pawccecize loohrue ccyh azaw vae,” a ci.<note caller="-" style="x"><char style="xo" closed="false">4.29: </char><char style="xt" closed="false"><ref loc="JOL 3:13">Joe 3.13</ref></char></note></para>
  <para style="s1">Mungngia Cii Tousenaw</para>
  <para style="r">(Mat 13.31-32, 34; <ref loc="LUK 13:18-19">Luk 13.18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" />Te Jesu nynh, “Pachia peenaw hynh pawtemou ah khinkhia cih oh? Tuhkhyhze pawcihawpaw tousenaw phungpaw mou mang lan? <verse number="31" style="v" />Mungngia cii te nynh aloku, tuh-e tuh laephi kya a vua lya tuh laephi kya vuapaw ccacii balyn laeze adihhua. <verse number="32" style="v" />Thuasalama yn po zah he yn le tuh enaw-eho hae balyn laeze alehua, te aran tuh yn le zah vaawlang e pavaw hae nynh a mynlyh kaw khe bu a luaku hae,” a ci.</para>
  <para style="s1">Jesu nynh Tousenaw A Mang</para>
  <para style="p">
    <verse number="33" style="v" />Ccungccaw hae nynh a thaethya hae thyhte tuhcihawpaw tousenaw phungpaw patae kha mangte bya a hopya hae. <verse number="34" style="v" />Tousenaw phungpaw mang leite bya hopah khyh hae, a zuitu hae ryte mih makhaete a um lya hae khe pawpaw balyn kha a ccaesahpya hae.</para>
  <para style="s1">Jesu nynh Khise A Daesah</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mat 8.23-27</ref>; <ref loc="LUK 8:22-25">Luk 8.22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" />Tuin nin zete khe Jesu nynh a zuitu hae kha, “Khuraw lang khuin zua oh sih,” a cipya hae. <verse number="36" style="v" />Zuitu hae nynh ccungccaw zapi kha cciataw hae zah kohlung kya a umty vae paw Jesu kha a cciakhae hae. Ccangpaw kohlung taraw hae mah amaw ryte a cceihbua hae. <verse number="37" style="v" />Myarya arupaw khise yn tho zah tuileih nynh kohlung kha yn thenuakuh zah kohlung kya tui vyavya abeih. <verse number="38" style="v" />Jesu tuh kohlung nulang sang khe lungngya ngya zah marya a ih; zuitu hae nynh tho hae zah, “Sazae, aening ah chih vae cih oh, na thawsia khyh tou?” a cipya hae. <verse number="39" style="v" />Jesu nynh thokuh zah khise kha, “Zaw nan vae,” cite kawpya zah, rili kha, “Dae, zya dae ccavae!” a cipya. Khise tuh dae zah rili mah daebabi lan a um vae. <verse number="40" style="v" />Te Jesu nynh minmin kha, “Pawccemou hynhcih baban na ri oh? Zynnaw na hoi loh khyh oh ii?” a cipya hae. <verse number="41" style="v" />Minmin tuh myaryamaw rih hae zah, “E paw hynh paw ccungccaw mou? Khise te rili nynh heize a kaw a ngae hae!” cite lu kheit te lu kheit a hoku hae.</para>
  <chapter number="5" style="c" />
  <para style="s1">Raerangsaro Bahkuhpaw A Dansah</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mat 8.28-34</ref>; <ref loc="LUK 8:26-39">Luk 8.26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Jesu te a zuitu hae tuh rili khuraw lang Garasene ram kya oun thua hae. <verse number="2" style="v" />Jesu tuh kohlung lungkhu te he a toikuh takaw te athyaa leipaw muisaw bahkuhpaw ccungccapaw nynh vaekheihmawte shawku kyate yn pou zah Jesu kha yn tungku. <verse number="3" style="v" />Tuh-e paw tuh shawku hae kya a umpaw thua zah hum nynh sanmah sivawrui te khii kho khyh hae. <verse number="4" style="v" />Aning tuh sivawlua thuh hae zah sivawrui te a he hae zemah sivawrui kha thoh pae zah sivawlua kha pong leih a khya; hum nynh sanmah ngaesah kho khyh hae. <verse number="5" style="v" />Khuazi khuadae shawku hae te mua hae kyakhe leih sia zah amaw te amaw kha lung te leih a awku. <verse number="6" style="v" />Asawnaw kyate Jesu kha he a muih tuh ccuenua zah a malang khe bakhung zah, <verse number="7" style="v" />“Ahang Huaccepaw Pachia Ccapaw Jesu, nang te kae tuh pawmou ah sekuh? Kae hynh vawsaw nae pya khyh nawlan Pachia min te kae ngiaku,” cite thawmawte a sia. <verse number="8" style="v" />Pawccecize Jesu nynh tuh-e paw tuh, “Nang athyaa leipaw muisaw, ccungccapaw kyate pou!” cite a cipya keiccu nynh thua. <verse number="9" style="v" />Jesu nynh, “Na min hummou?” cite a khia. Tuh-e paw nynh, “Ka min tuh Legion nynh thua, pawccecize kaening tuh patae kae cih,” cite a khung. <verse number="10" style="v" />Tuin ram kyate asawnaw lang a dee khyh nawlan hae aning nynh Jesu kha thawte a ngia. <verse number="11" style="v" />Tuin pe mua vawlan khe rampaeekuh hae paw voh hae tuh aphupi te a um hae. <verse number="12" style="v" />Te raerangsaro hae balyn nynh, “Voh hae lungkhu lang kae tee ccaw minmin kalan beih oun saw,” cite Jesu kha a ngiaku hae. <verse number="13" style="v" />Jesu nynh minmin kha a ua hae. Te athyaa leipaw muisaw hae tuh cceih hae zah voh hae lungkhu lang a tee hae; voh hae tuh rili kin apannaw langkhe thawte ccuebung hae zah rili kya pong phungkuh hae; voh hae tuh thong ning loukaw acih hae.</para>
  <para style="p">
    <verse number="14" style="v" />Voh a rintu hae nynh ccue hae zah tuh-e kong tuh khuapi te khua taraw hae kya balyn a ho hae. Ccungccaw hae tuh tuh-e acyihkuhpaw tuh do khylan a cceih hae. <verse number="15" style="v" />Jesu kya a thua hae tuh raerangsaro bahkuh zah legion a hoipaw ccungccapaw nynh boeining lawkute a lungkyhrarih lan a haungpaw kha a muih hae tuh a rih hae. <verse number="16" style="v" />Tuh-e a muih hae paw nynh raerangsaro bahkuhpaw kya pawte nynh acyiku cipaw te voh hae kya acyihkuhpaw kha a hopya hae. <verse number="17" style="v" />Tetuh minmin nynh Jesu kha mih ram kyate a pou nawlan a ngia hae. <verse number="18" style="v" />Jesu nynh kohlung lungkhu lang he a tee tuh raerangsaro bahkuhpaw ccungccapaw nynh amaw kya umbua lan a ngiaku. <verse number="19" style="v" />Tuhzemah Jesu nynh ua khyh, “Nae inn lang na vaeccaw hae kalan la cceih lah na hanlan Bawipaw nynh ae cyipyapaw te ngaethya ae umsahnaw kha la hopah hae,” a cipya. <verse number="20" style="v" />Tetuh aning nynh cceih zah Dekapolis ram khe Jesu nynh a cyipyapaw kha a ho vae, te ccungccaw hae balyn tuh mih ngaeangthua.</para>
  <para style="s1">Jairas Ccanung te Jesu Boei Dung A Haenung</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mat 9.18-26</ref>; <ref loc="LUK 8:40-56">Luk 8.40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" />Jesu tuh kohlung te khuraw lang bua zua zah, rili kin a um lyakhe ccungccaw patae tuh amaw kalan oun sueluakuh hae. <verse number="22" style="v" />Sinakok uktu hae lakuze lu kheit, a min Jairas cikuhpaw nynh yn thua zah Jesu kha he a muih tuh a cculeihpaw khe bakhung zah, <verse number="23" style="v" />“Ka ccanung taraw vyavya a chih, beih yn cceih lah a tungvaw khe na kuih na khang zetuh a dan cih zah a hiin cih,” cite thawte a ngia.</para>
  <para style="p">
    <verse number="24" style="v" />Jesu tuh tuh-e paw ryte a cceih hae; ccungccaw patae nynh zui hae zah phang a lungnuaku hae. <verse number="25" style="v" />Tuin kyakhe kum haw lae ning cia chiilua ccinaw a hoipaw nopinung lu kheit a um. <verse number="26" style="v" />Sibawi patae nynh oih hae zah a hoipaw uccaw balyn pong a thangku zemah a ccinaw tuh hoyhua leite houh acihhua. <verse number="27" style="v" />Tuh-e nung nynh Jesu kong kha thae zah ccungccazaw laku khe a nulang te yn cceih zah Jesu boei kha a hae. <verse number="28" style="v" />Pawccecize tuh-e nung nynh, “A boei kha ka hae zetuh phe ka dan cih,” cite a tuaku. <verse number="29" style="v" />Nopinung tuh vaekheihmawte a chii luapaw tuh phe akan, a pyn kya tuh-e ccinaw kyate ka dan vae cipaw a nyku. <verse number="30" style="v" />Jesu nynh a kyate huhan a pou cipaw ccahe a nyh tuh ccungccaw zapi kalan maekuh zah, “Hummou ka boei a hae?” cite a khia hae. <verse number="31" style="v" />A zuitu hae nynh, “Ccungccaw zapi nynh phang ae lungnuaku hae paw mang na muih pite, ‘Hummou yn hae?’ na ci,” a cipya hae. <verse number="32" style="v" />Thuasalama Jesu nynh hummou yn hae cite muih khylan a pepan khe a do. <verse number="33" style="v" />Nopinung nynh a tungvaw acyikuhpaw kha a nyku keiccu rih zah thyngku biate Jesu kalan cceih zah a malang khe bakhung zah acyikuhpaw balyn kha hmerarih lan a hopya. <verse number="34" style="v" />Jesu nynh, “Ka ccanung na zynnaw nynh ae dansah vae, daebabi lan la cceih lah na ccinaw kyate dan ccavae,” a cipya.</para>
  <para style="p">
    <verse number="35" style="v" />Tuhte a ho cciamang lyakhe, sinakok uktupaw inn kyate ccungccaw abang oun thua hae zah, “Na ccanung kha phe chih vae, pawccemou ccangpatupaw hynh vawsaw na pya ry ung?” cite a hopya hae. <verse number="36" style="v" />Tuh-e bya tuh Jesu nynh ccahe a thae tuh sinakok uktupaw kha, “Rih nan, zyn kyalya zyn,” a cipya. <verse number="37" style="v" />Te Jesu nynh Peter, James te James neitaw Johan laelan humhung mah amaw kya zuiku lan ua khyh hae. <verse number="38" style="v" />Sinakok uktupaw inn lang he a thua tuh siarisiarae um hae paw, thawte a rah hae paw kha a muih. <verse number="39" style="v" />Innthung lang tee zah minmin kha, “Pawccemou siarisiarae na um oh zah na raw oh? Imuanung tuh chih khyh, a ihpaw nynh thua,” a cipya hae. <verse number="40" style="v" />Minmin nynh a nuinse hae. Te mih balynte a pousah kou hae te, imuanung a nung te a paaw ryte amaw ry a umkheih hae paw ryte imuanung a inaw langkhe a tee hae. <verse number="41" style="v" />Imuanung kha a kuih te kyng zah, “Talitha kumi,” a cipya; tuh-e asuilan tuh ‘Imuanung taraw, thokuh kae cipya,’ cipaw nynh thua. <verse number="42" style="v" />Imuanung tuh vaekheihmawte thokuh zah a cceih (aning tuh kum haw lae ning acih vae paw nynh thua). Minmin tuh myaryamaw mih ngaeangthua. <verse number="43" style="v" />Tuh-e kong tuh humhung mah a nysah khyh nawlan hae tynkaring lan kaw a pya hae; te aepaw hankhakheit pya oh cite a hopya hae.</para>
  <chapter number="6" style="c" />
  <para style="s1">Nazareth kya Zyn leinaw</para>
  <para style="r">(<ref loc="MAT 13:53-58">Mat 13.53-58</ref>; <ref loc="LUK 4:16-30">Luk 4.16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Jesu tuh tuin kyate cceih zah amaw a khua lang a thua, a zuitu hae nynh amaw kha a zui hae. <verse number="2" style="v" />Sabbath nin kya sinakok kyakhe a ccangpya hae, a thae hae paw patae tuh mih ngaeangthua zah, “E hae balyn hynh paw kyate mou a mueku? Aning nynh a muekupaw e hawnaw hynh pawtecihpaw hawnaw mou? Pawtemou hynhcih ngaeangthua lan umpaw ryalaw hae hynh a kuih te a cyi kho? <verse number="3" style="v" />E paw tuh Mary Ccapaw, lehccamapaw kha thua khyh tou? James, Joses, Judah te Simon mih upaw thua khyh tou? A ccianung hae tuh aening ryte hein kya mang um hae khaw?” cite ho hae zah amaw kha pawlangria khyh hae. <verse number="4" style="v" />Jesu nynh, “Profeh tuh amaw a khua, a puizia hae te a innbyn kya holeite hmin ccanglang tuh saw a tua hae,” a ci.<note caller="-" style="x"><char style="xo" closed="false">6.4: </char><char style="xt" closed="false"><ref loc="JHN 4:44">Joh 4.44</ref></char></note> <verse number="5" style="v" />Tuin kya tuh ngeccih hae beihtaraw tungvaw a kuih khang zah a dansah hae paw laelan ngaeangnaw rae kho vae khyh. <verse number="6" style="v" />Zynnaw a hoi khyh hae keiccuze Jesu tuh a ngaeangthua. Te tuin pepan e khua hae kalan cceih zah a ccangpya hae.</para>
  <para style="s1">Lu Haw Lae Ning A Saw hae</para>
  <para style="r">(<ref loc="MAT 10:5-33">Mat 10.5-33</ref>; <ref loc="LUK 9:1-6">Luk 9.1-6</ref>)</para>
  <para style="p">
    <verse number="7" style="v" />Zuitu lu haw lae ning kha ko hae zah lu ning ccite a saw hae; te athyaa leipaw muisaw hae tungvaw kawhoinaw kha pya hae zah, <verse number="8" style="v" />“Khua na ccongnaw oh kya hoitang ccangkheit laelan pawpaw sanmah ccyngkuh nan oh; sohrae thuasah, sanlou thuasah, phuabu kya phua thuasah phukuh nan oh.<note caller="-" style="x"><char style="xo" closed="false">6.8-11: </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">Luk 10.4-11</ref></char></note> <verse number="9" style="v" />Phanah nawkuh oh lah, angki zung ning kikuh nan oh,” cite kaw a pya hae. <verse number="10" style="v" />Te minmin kha, “Teitei hmin kya zemah inn innkheit lungkhu lang na tee vae oh ze, tuh-e hmin kyate na pou makhia oh tuin kya la um oh. <verse number="11" style="v" />Te humhung zemah nanning kha innccong ae doih oh zah nae bya a ngae khyh hae ze, tuin kyate na pou lya oh khe minmin rawsenawpaw ccaekia lang nae ccu kya-e vuiping kha la khuanua sya oh,” a cipya hae.<note caller="-" style="x"><char style="xo" closed="false">6.11: </char><char style="xt" closed="false"><ref loc="ACT 13:51">Loc 13.51</ref></char></note> <verse number="12" style="v" />Te minmin nynh cceih hae zah ccungccaw hae kha a ngaesiku nawlan hae phung a hopya hae. <verse number="13" style="v" />Minmin nynh raerangsaro patae dee hae zah ngeccih patae kha chitui thuhpah hae zah a dansah hae.<note caller="-" style="x"><char style="xo" closed="false">6.13: </char><char style="xt" closed="false"><ref loc="JAS 5:14">Jam 5.14</ref></char></note></para>
  <para style="s1">Baptisma Pyatu Johan Lu Paenaw</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mat 14.1-12</ref>; <ref loc="LUK 9:7-9">Luk 9.7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" />Jesu tuh a min athaan keiccuze Herod Siapharan nynh amaw kong kha a thae. Abang nynh, “Baptisma pyatu Johan nynh chinaw kyate a thoothui, tukeiccu nynh ngaeangnaw patae a rae kho,” a ci hae.<note caller="-" style="x"><char style="xo" closed="false">6.14-15: </char><char style="xt" closed="false"><ref loc="MAT 16:14">Mat 16.14</ref>; <ref loc="MRK 8:28">Mar 8.28</ref>; <ref loc="LUK 9:19">Luk 9.19</ref></char></note> <verse number="15" style="v" />Mingccang hae nynh, “Elijah nynh thua,” a ci hae. Te mingccang hae nynh, “Langmawlya e profeh lukhakheit hawte profeh nynh thua,” a ci hae. <verse number="16" style="v" />Thuasalama Herod nynh he a thae tuh, “A lu ka paepaw Johan nynh yn thoothui vae,” a ci.</para>
  <para style="p">
    <verse number="17" style="v" />Pawccecize Herod nynh a neitawpaw Filip zu, Herodias kha a zu lang a dyku keiccuze ccungccaw saw zah Johan kha kyngsah te hesah hae zah thong a sawsah hae.<note caller="-" style="x"><char style="xo" closed="false">6.17-18: </char><char style="xt" closed="false"><ref loc="LUK 3:19-20">Luk 3.19-20</ref></char></note> <verse number="18" style="v" />Pawccecize Johan nynh Herod kha, “Na neitawpaw zu tuh na dyku lan ccan khyh,” a cipya. <verse number="19" style="v" />Tukeiccuze Herodias nynh Johan kha lung-ungtungpah zah chia lan a ry; thuasalama theih kho khyh. <verse number="20" style="v" />Pawccecize Johan tuh adingpaw te athyaapaw ccungccaw nynh thua cipaw kha Herod nynh a ny keiccuze a rawrih zah a thungkhaw. Johan bya kha he a thae vae ze, a lunghoy khyh, tuhzemah a bya kha a ngaepya ry. <verse number="21" style="v" />Herod nynh a pui nin kya uktu bawi hae, rhawbawi hae te Galilee pee e cciakhaetu hae elang loohdangnaw poi he a tua tuh Herodias hanlan ccyhhoy yn thua vae. <verse number="22" style="v" />Herodias ccanung nynh tee zah he yn law tuh Herod te a mikhia hae kha mih lungry a thuasah hae; tukeiccuze siapharan nynh nopinung taraw kha, “Na rypaw miakaw yn ngiakuh lah kae pya cih,” a cipya. <verse number="23" style="v" />Tukoute, “Nae ngiakupaw miakaw kae pya cih, ka peenaw angankuh cia heize kae pya cih,” cite thyalawkute bya a kinpyaku. <verse number="24" style="v" />Nopinung taraw nynh toikuh zah a nung kyakhe, “Pawmou ka ngiakuh cih?” cite a khia. A nung nynh, “Baptisma pyatu Johan lu kha ngiakuh,” a cipya. <verse number="25" style="v" />Tuh-e nung nynh vaekheihmawte siapharan kalan ki kangmaw zah, “Baptisma pyatu Johan lu kha pakephepaw te atumaw yn pya ci nynh ka ry,” cite a ngiaku. <verse number="26" style="v" />Tetuh siapharan tuh myaryamaw a ngaethah, tuhzemah a kinku vae paw bya te a mikhia hae keiccuze tuh-e nung kha ei ry vae khyh. <verse number="27" style="v" />Tukeiccuze siapharan nynh rhawkaw lu kheit kha palou saw zah Johan lu thuakhae lan kaw a pya; tuh-e paw nynh cceih zah thonginn kyakhe Johan lu kha a pae. <verse number="28" style="v" />Te a lu kha pakephepaw te yn ccyng zah nopinung taraw kha a pya; tuh-e nung nynh tuh-e tuh a nung kalan a pya. <verse number="29" style="v" />Tuh-e kong tuh Johan zuitu hae nynh he a thae hae te, oun cceih hae zah a rhua kha lah hae zah shaw kya a ccy hae.</para>
  <para style="s1">Thong Pangaw Looh Dangnaw</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mat 14.13-21</ref>; <ref loc="LUK 9:10-17">Luk 9.10-17</ref>; <ref loc="JHN 6:1-15">Joh 6.1-15</ref>)</para>
  <para style="p">
    <verse number="30" style="v" />Locceihtu hae nynh Jesu kalan oun sueluakuh hae zah a cyi hae paw te a ccangpya hae paw balyn kha a hopya hae. <verse number="31" style="v" />Jesu nynh minmin kha, “Nae makhaete ccungccaw adaenaw lang rang oh; sosoh haeung oh,” a cipya hae; pawccecize a teepaw te a poupaw ccungccaw myarya lung zah minmin tuh aenaw ccyh san hoi khyh hae. <verse number="32" style="v" />Te minmin tuh mih makhaete ccungccaw adaenaw lang kohlung te a cceih hae. <verse number="33" style="v" />A ccia hae paw kha ccungccaw patae nynh muih hae zah hum hae mou cipaw a ny hae keiccuze khua takyh kyate mih ccu te oun rangsakuh hae zah locceihtu hae laeze a thuaty hae. <verse number="34" style="v" />Jesu tuh kohlung kyate yn pou zah ccungccaw zapi kha a muih hae tuh ngaethya a umsah hae, pawccecize minmin tuh tuurin a hoi leipaw tuu hae nynh a lo hae; te minmin kha patae a ccangpya hae.<note caller="-" style="x"><char style="xo" closed="false">6.34: </char><char style="xt" closed="false"><ref loc="NUM 27:17">Nam 27.17</ref>; <ref loc="1KI 22:17">1Si 22.17</ref>; <ref loc="2CH 18:16">2Sh 18.16</ref>; <ref loc="EZK 34:5">Eze 34.5</ref>; <ref loc="MAT 9:36">Mat 9.36</ref></char></note> <verse number="35" style="v" />Zete tuh a zuitu hae nynh a kalan oun cceih hae zah, “E kya tuh ramkaw thua zah atu khua yn zi vae cih. <verse number="36" style="v" />E ccungccaw hae hynh anaenaw umpaw khua taraw hae te khua hae kalan ccia sah hae lah mimaw elang aepaw hankhakheit la rekuh hae sah,” cite a hopya hae. <verse number="37" style="v" />Jesu nynh khung hae zah, “Nanning nynh minmin kha ae lanpaw hankhakheit pya oh,” a cipya hae. Te minmin nynh, “Kae cceih cih zah denari phua za ning mee sanlou kha kae re cih zah tetou ae lan kae pya cih hae?” cite a khia hae. <verse number="38" style="v" />Jesu nynh, “Sanlou hohzeihmou na hoi oh? Cceih oh lah dotua oh,” a cipya hae. Minmin nynh a do kou hae te, “Sanlou phe pangaw te ngasaw zaw ning,” a ci hae. <verse number="39" style="v" />Tetuh Jesu nynh ccungccaw hae balyn kha lonua ahinpaw vawlan aphuphute haungsah lan a zuitu hae kha kaw a pya hae. <verse number="40" style="v" />Te ccungccaw hae tuh za kheit phu, sung pangaw phu cite aphuphute a haung hae. <verse number="41" style="v" />Jesu nynh sanlou phe pangaw te ngasaw zaw ning kha lah zah vaawlang dothung zah lungtuabya a ho koute sanlou kha eih zah a zuitu hae kha ccungccaw hae malang nyapya lan a pya hae; ngasaw zaw ning kha mah ccungccaw hae pong a nee hae. <verse number="42" style="v" />Ccungccaw hae balyn tuh ae hae zah phe byn hae. <verse number="43" style="v" />A zuitu hae nynh ngasaw te sanlou a eihpaw kha kee haw lae ning phe beih lan a khuin hae. <verse number="44" style="v" />Sanlou a ae hae paw tuh pise thong pangaw loukaw acih hae.</para>
  <para style="s1">Jesu Tui vawlan A Cceih</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mat 14.22-33</ref>; <ref loc="JHN 6:15-21">Joh 6.15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" />Jesu nynh ccungccaw zapi a saw lya hae khe, a zuitu hae kha arangte kohlung kya ccisakuh hae zah khuraw lang e Bethsaida khua lang a cciasah lalo hae. <verse number="46" style="v" />Minmin kha a saw kou hae te Jesu tuh sawsang lan mua langkhe a cceih.</para>
  <para style="p">
    <verse number="47" style="v" />Khua yn zi tuh kohlung tuh rili ngaelung kya um zah Jesu tuh a makhaete laerou kya a um. <verse number="48" style="v" />Khisan nynh arawsekuh lante azaw keiccu zuitu hae nynh thawte kohlung a zaw hae paw kha a muih; awkhua suimilan ccangthum te ccangtaruh laku khe minmin pe po ccia lan cite mih kalan rili vawlan khe a cceih. <verse number="49" style="v" />Thuasalama minmin nynh rili vawlan a cciapaw kha a muih hae tuh khozi nynh thua cite tua hae zah a sia hae. <verse number="50" style="v" />Pawccecize mih balyn te amaw kha muih hae zah a rih hae. Jesu nynh bya hopah kangmaw hae zah, “Nae thinphang nan sah, kamaw nynh ka thua, rih nan oh,” a cipya hae. <verse number="51" style="v" />Kohlung lungkhu lang mih kalan kaebua zah khisan tuh zya adae; minmin tuh myaryamaw mih ngaeangthua. <verse number="52" style="v" />Pawccecize mih thinlung akhung keiccuze sanlou kya a langsahkupaw kha thaethya khyh hae.</para>
  <para style="s1">Genesaret kya A Dansah hae</para>
  <para style="r">(<ref loc="MAT 14:34-36">Mat 14.34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" />Minmin tuh khuraw a zua kou hae te, Genesaret ram kya thua hae zah varang langkhe kohlung kha a khii hae. <verse number="54" style="v" />Kohlung kyate he a pou hae tuh ccungccaw hae nynh amaw kha palou a ny hae. <verse number="55" style="v" />Tuin pepan e ram hae balyn kalan khe ccue hae zah ngeccih hae kha mih iphae ryte Jesu a um cite a thaenaw lang hae khe oun thuakhae hae. <verse number="56" style="v" />Jesu a ccianaw miakaw khua taraw hae, khuapi hae kya thuasah, loo kya thuasah ngeccih hae kha kungkunaw hmin kya nung hae zah, minmin nynh a boei dung sankaw kha a hae nawlan hae amaw kha a ngia hae; tuh-e a haepaw miakaw tuh a dan hae.</para>
  <chapter number="7" style="c" />
  <para style="s1">Minpaaw hae Ccangpyanaw</para>
  <para style="r">(<ref loc="MAT 15:1-9">Mat 15.1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Farasi hae te Jerusalem kyate oun thua hae paw kawbya sazae hae abang tuh Jesu kalan oun sueluakuh hae zah, <verse number="2" style="v" />a zuitu hae abang nynh kuih singku leite athupaw mih kuih te sanlou a ae hae paw kha a muih hae. <verse number="3" style="v" />Pawccecize Farasi hae te Judah hae balyn tuh langmawlya e piccan hae phung kha zui hae zah mih kuih singku leite ae khyh hae. <verse number="4" style="v" />Kungkunaw hmin kyate a ki hae te, a re hae paw kha a sing khyh hae ze ae khyh hae; te banang hae singpaw, ang hae singpaw, sohin angphe hae singpaw, te haungnawpaw singpaw tahawpaw a zui hae paw ccangpaw patae a um ung. <verse number="5" style="v" />Farasi hae te kawbya sazae hae nynh, “Pawccemou na zuitu hae nynh langmawlya e piccan hae phung thyhte zui leite kuih singku leite sanlou a ae hae?” cite Jesu kha a khia hae. <verse number="6" style="v" />Jesu nynh khung hae zah, “Thyaruh hae, nanning konglang hynh Isaiah nynh hmerarih lan a la hoty vae;</para>
  <para style="q1">‘E ccungccaw hae nynh</para>
  <para style="q2">mih munglae te saw oun tua hae;</para>
  <para style="q1">thuasalama mih thinlung tuh</para>
  <para style="q2">ka kyate asawkuh.<note caller="-" style="x"><char style="xo" closed="false">7.6-7: </char><char style="xt" closed="false"><ref loc="ISA 29:13">Isa 29.13</ref> (LXX)</char></note></para>
  <para style="q1">
    <verse number="7" style="v" />Ccungccaw phung kha</para>
  <para style="q2">Pachia phung lang</para>
  <para style="q1">a ccangpya hae keiccuze</para>
  <para style="q2">kae yn beik hae paw tuh</para>
  <para style="q1">accakaepaw nynh thua,’</para>
  <para style="m">cite azeikuh. <verse number="8" style="v" />Nanning nynh Pachia kawbya kha na vua oh zah ccungccaw hae phung kha na zui oh,” a cipya hae.</para>
  <para style="p">
    <verse number="9" style="v" />Jesu nynh minmin kha, “Naemaw phung zuithya nawlan, Pachia kawbya vuanaw zia kha myarya na thya oh. <verse number="10" style="v" />Pawccecize Moses nynh, ‘Na nung te na paaw kha sawtua hae,’ te ‘Humhung zemah a nung thuasah, a paaw thuasah thya a lahpaw tuh chia thua sah,’ a ci.<note caller="-" style="x"><char style="xo" closed="false">7.10: </char><char style="xt" closed="false"><ref loc="EXO 20:12">Exo 20.12</ref>, <ref loc="EXO 21:17">21.17</ref>; <ref loc="LEV 20:9">Lev 20.9</ref>; <ref loc="DEU 5:16">Deu 5.16</ref></char></note> <verse number="11" style="v" />Thuasalama nanning nynh, ccungccaw lu kheit nynh a paaw te a nung kha, ‘Kamaw liate na mue lan oh paw bawmnaw tuh Korban nynh thua,’ a cipya hae ze, (tuh-e tuh Pachia pya lanpaw uccaw cipaw nynh thua), <verse number="12" style="v" />tuh-e paw tuh a nung te a paaw kha bawm ho vae khyh, na ci oh. <verse number="13" style="v" />Tuhcite nae minpaaw hae kyate na mue oh paw nae phung liate Pachia bya kha na vua vae oh; nanning nynh tuhcihawpaw patae kha na cyi oh,” a cipya hae.</para>
  <para style="p">
    <verse number="14" style="v" />Jesu nynh ccungccaw hae balyn kha a kalan bua ko hae zah minmin kyakhe, “Nae balynte ka bya hynh ngae oh lah thaethya oh: <verse number="15" style="v" />Ccungccaw hynh atolang te alungkhu lang yn teepaw nynh thusah khyh; ccungccaw lungkhu langte yn poupaw uccaw nynh ccungccaw kha a thusah. <verse number="16" style="v" />Thae nawlan nakaring a hoipaw ccungccaw tuh thae sah,” a cipya hae.</para>
  <para style="p">
    <verse number="17" style="v" />Ccungccaw zapi kyate inn lungkhu lang he a tee tuh, a zuitu hae nynh tousenaw phungpaw kong kha a khia hae. <verse number="18" style="v" />Jesu nynh, “Nanning so na thaethya khyh oh tou? Atolang te ccungccaw lungkhu lang a teepaw pawpaw uccaw nynh mah ccungccaw tuh thusah kho khyh cipaw na thaethya khyh oh tou? <verse number="19" style="v" />Pawccecize atolang te yn teepaw tuh bung lungkhu lang tee khyh, vue lungkhu lang nynh a tee; aepaw balyn kha thyaasah zah atolang po toikuh khyh tou?” cite a hopya hae. (E bya liate aepaw looh miakaw tuh athyaa cite a ho rypaw nynh thua). <verse number="20" style="v" />Te Jesu nynh, “Ccungccaw lungkhu kyate a poupaw nynh ccungccaw kha a thusah. <verse number="21" style="v" />Pawccecize ahoy leipaw tuanaw tuh ccungccaw lungkhu e thinlung kyate oun poupaw nynh thua: ohhuakunaw, runaw, ccungccaw chianaw, <verse number="22" style="v" />milae zu milae vawpaw kya seinaw, karankunaw, thyaruhnaw, lingnaw, ohhuaku rynaw, eiungnaw, milae thethya honaw, lysakunaw te ngaeenaw tuh oun pou hae. <verse number="23" style="v" />E ahoy leipaw uccaw hae balyn tuh lungkhu langte oun pou zah ccungccaw kha a thusah,” a ci.</para>
  <para style="s1">Kanaan Nopinung Zynnaw</para>
  <para style="r">(<ref loc="MAT 15:21-28">Mat 15.21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" />Jesu tuh tuin kyate thokuh zah Tair te Sidon ram lang a cceih. Inn innkheit lungkhu lang a teepaw kha humhung sanmah nysah ry khyh; thuasalama rekuh khualae khyh. <verse number="25" style="v" />Pawccecize athyaa leipaw muisaw a hoipaw imuanung a nung nynh Jesu kong a thae pawte a kalan yn cceih zah a cculeihpaw khe a bakhung. <verse number="26" style="v" />Nopinung tuh Siria ram Foenisia pee kya a puinung Zentanung nynh thua; a ccanung kyate raerangsaro kha a deepya ccaw cite Jesu kha a ngia. <verse number="27" style="v" />Thuasalama Jesu nynh, “Ccaaw hae tuh masaty byn hin hae sah; pawccecize ccaaw hae looh kha law lan zah ui hae kha vuapya lan ccan khyh,” a cipya. <verse number="28" style="v" />Te nopinung nynh, “Athua, Bawipaw; tuhzemah ccaaw hae nynh a hei hae paw loohmoi kha ui hae nynh ccaboi kaw te leih a ae hae,” cite a ci. <verse number="29" style="v" />Te Jesu nynh, “E na hopaw na bya keiccu la cceih ccavae, na ccanung kyate raerangsaro phe a pou vae,” a cipya. <verse number="30" style="v" />Tuh-e nung nynh a inn lang he a thua tuh, raerangsaro nynh a poutawpaw, ikhung vawlan a ihpaw a ccanung kha a muih.</para>
  <para style="s1">A Nawpanpaw A Dansah</para>
  <para style="p">
    <verse number="31" style="v" />Jesu tuh Tair pee kyate ki zah Sidon pee kya po cceih zah Dekapolis pee lungkhu te Galilee rili lang po a cceih. <verse number="32" style="v" />Ccungccaw hae nynh a nawpan zah bya a ho kho leipaw ccungccapaw kha a kalan oun cciakhae hae zah a tungvaw kya a kuih khang lan a ngia hae. <verse number="33" style="v" />Jesu nynh tuh-e paw tuh ccungccaw zapi kyate toikhaekuh zah a kuihdung kha a nakaring lungkhu lang a pu, te a tuing te thoi zah a lae kha a haepya. <verse number="34" style="v" />Te vaawlang dothung zah a hy puin a saw; te tuh-e paw tuh, “Effatha,” a cipya. Asuilan tuh, “Ua ccavae sah,” cipaw nynh thua. <verse number="35" style="v" />Vaekheihmawte a naw yn ua zah a laezan ne zah ccaepapeih lan bya a ho vae. <verse number="36" style="v" />Jesu nynh tuh-e kong tuh humhung kya mah a ho khyh nawlan hae kaw a pya hae; thuasalama houh khee hae zah houh a ho hae. <verse number="37" style="v" />Ho kho um lei lan mih ngaeangthua zah, “Aning nynh pawpaw balyn kha kou hoy lan a rae; a nawpanpaw naw phe thaesah zah bya a ho kho leipaw kha bya phe a hosah,” a ci hae.</para>
  <chapter number="8" style="c" />
  <para style="s1">Thong Pali Looh A Dang hae</para>
  <para style="r">(<ref loc="MAT 15:32-39">Mat 15.32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Tuin nin hae kya ccungccaw zapi tuh myarya lung lan oun sueluakuh hae zah ae lanpaw hoi khyh hae, Jesu nynh a zuitu hae kha a kalan ko hae zah, <verse number="2" style="v" />“Ccungccaw zapi hynh ngaethya ka umsah hae, pawccecize ka kya nin thum cia um vae hae zah ae lanpaw hoi khyh hae. <verse number="3" style="v" />Ae leite mih inn lang ka cciasah hae ze laanryng kya a baw cih hae, pawccecize abang tuh laansawpi te oun thua hae paw nynh thua,” a cipya hae. <verse number="4" style="v" />A zuitu hae nynh, “E ramkaw kyahin hynhzeih ccungccaw hae hynh sanlou phe a byn lan hae pawtemou dang kho a um cih?” cite a khung hae. <verse number="5" style="v" />Jesu nynh, “Sanlou hohzeihmou na hoi oh?” cite khia hae zah minmin nynh, “Phe sari,” a ci hae. <verse number="6" style="v" />Ccungccaw zapi hae kha laekhu kya haung lan kaw a pya hae; te sanlou phe sari kha lah zah lungtuabya a ho koute sanlou kha eih zah ccungccaw hae kha nee khylan a zuitu hae kha a pya hae; te minmin nynh ccungccaw hae kha a nee hae. <verse number="7" style="v" />Minmin tuh ngasaw taraw mah beihtaraw hoi hae zah hythua a pya koute ccungccaw hae kalan nee lan kaw a pya hae. <verse number="8" style="v" />Minmin tuh ae hae zah phe a byn hae, te a eihpaw alaepaw kha khuin hae zah kee sari phe abeih. <verse number="9" style="v" />A aepaw ccungccaw hae tuh thong pali loukaw acih hae; te minmin kha a kisah hae. <verse number="10" style="v" />Te a zuitu hae ryte kohlung lungkhu lang arangte tee hae zah Dalmanutha pee lang a cceih hae.</para>
  <para style="p">
    <verse number="11" style="v" />Farasi hae nynh oun cceih hae zah Jesu ryte bya a eikuh hae, amaw kha syntawtua khylan vaawlang e muihsahnaw kha a ngia hae.<note caller="-" style="x"><char style="xo" closed="false">8.11: </char><char style="xt" closed="false"><ref loc="MAT 12:38">Mat 12.38</ref>; <ref loc="LUK 11:16">Luk 11.16</ref></char></note> <verse number="12" style="v" />A thinlung kya a hy puin saw zah, “Pawccepei e ciihan nynh muihsahnaw hynh a ngia? Byaccaccing kae hopya oh, e ciihan hynh pawpaw muihsahnaw sanmah pya thua lan khyh,” a ci.<note caller="-" style="x"><char style="xo" closed="false">8.12: </char><char style="xt" closed="false"><ref loc="MAT 12:39">Mat 12.39</ref>; <ref loc="LUK 11:29">Luk 11.29</ref></char></note> <verse number="13" style="v" />Te minmin kha cciataw hae zah kohlung lungkhu lang bua tee zah khuraw lang a zua.</para>
  <para style="s1">Farasi hae te Herod Ransi</para>
  <para style="r">(<ref loc="MAT 16:5-12">Mat 16.5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" />Zuitu hae nynh sanlou phuku lan phe ning hae zah kohlung kya sanlou phe kheit kyalya nynh a hoi hae. <verse number="15" style="v" />Jesu nynh minmin kha, “Farasi hae ransi te Herod ransi kha raeringkuh oh,” a cipya hae.<note caller="-" style="x"><char style="xo" closed="false">8.15: </char><char style="xt" closed="false"><ref loc="LUK 12:1">Luk 12.1</ref></char></note> <verse number="16" style="v" />Minmin nynh, “Sanlou ah hoi khyh oh pawte nynh hynhte a ho,” cite a hoku hae. <verse number="17" style="v" />Jesu nynh tuh-e tuh nyh zah minmin kha, “Sanlou na hoi khyh oh paw kong tuh pawccemou na hoku oh? Na nyhthya loh khyh oh tou? Na thaethya loh khyh oh tou? Nae thinlung tuh phang akhung ung tou? <verse number="18" style="v" />Mit phang na hoi oh pite na muih khyh oh tou? Nakaring phang na hoi oh pite na thae khyh oh tou? Na syntaw vae khyh oh tou?<note caller="-" style="x"><char style="xo" closed="false">8.18: </char><char style="xt" closed="false"><ref loc="JER 5:21">Jer 5.21</ref>; <ref loc="EZK 12:2">Eze 12.2</ref>; <ref loc="MRK 4:12">Mar 4.12</ref></char></note> <verse number="19" style="v" />Ccungccaw thong pangaw hanlan sanlou phe pangaw ka ia lya kha a eihpaw kee hohzeihmou phe beih lan na khuin oh?” cite a khia hae. Minmin nynh, “Kee haw lae ning,” a ci hae. <verse number="20" style="v" />“Ccungccaw thong pali hanlan sanlou phe sari ka ia lya kha so, a eihpaw kha kee hohzeihmou phe beih lan na khuin oh?” cite a khia hae. Minmin nynh, “Kee sari,” a ci hae. <verse number="21" style="v" />Jesu nynh, “Na thaethya loh khyh oh tou?” a cipya hae.</para>
  <para style="s1">Mitmohpaw Ngawmuih</para>
  <para style="p">
    <verse number="22" style="v" />Minmin tuh Bethsaida khua a thua hae. Abang ccungccaw hae nynh mitmohpaw lu kheit kha Jesu kalan oun cciakhae hae zah a kuih te hae lan a ngia hae. <verse number="23" style="v" />Jesu nynh mitmohpaw kha a kuih te kyng zah khua atolang a cciakhae; a mit kha thoi zah a tungvaw a kuih a khang koute, “Ngaw na muih vae tou?” cite a khia. <verse number="24" style="v" />Aning nynh dothung zah, “Ccungccaw hae kha ka muih kho, thuasalama thingku hae a cceih hae paw nynh a lo hae,” a cipya. <verse number="25" style="v" />Tukoute a kuih kha mitmohpaw mit vawlan bua a khang. Te aning tuh amaw thathyh lan ngawmuih zah ccungccaw miakaw kha ccaerarih lan a muih vae. <verse number="26" style="v" />Jesu nynh, “Khua lungkhu lang la tee nan,” cite hopah zah a inn lang a cciasah.</para>
  <para style="s1">Peter nynh Jesu Kong A Ho</para>
  <para style="r">(<ref loc="MAT 16:13-20">Mat 16.13-20</ref>; <ref loc="LUK 9:18-21">Luk 9.18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" />Jesu tuh a zuitu hae ryte Sisaria Filipi khua pepan e khua taraw hae kalan cceih hae zah laanpi khe a zuitu hae kha, “Ccungccaw hae nynh kae hynh hum oun ci hae mou?” cite a khia hae. <verse number="28" style="v" />Minmin nynh, “Abang nynh baptisma pyatu Johan ae ci hae; abang nynh Elijah ae ci hae; mingccang hae nynh profeh lukhakheit ae ci hae,” cite a khung hae.<note caller="-" style="x"><char style="xo" closed="false">8.28: </char><char style="xt" closed="false"><ref loc="MRK 6:14-15">Mar 6.14-15</ref>; <ref loc="LUK 9:7-8">Luk 9.7-8</ref></char></note> <verse number="29" style="v" />Jesu nynh minmin kha, “Nanning so hum nae ci oh mou?” cite a khia hae. Peter nynh, “Nang tuh Messiah nynh na thua,” a ci.<note caller="-" style="x"><char style="xo" closed="false">8.29: </char><char style="xt" closed="false"><ref loc="JHN 6:68-69">Joh 6.68-69</ref></char></note> <verse number="30" style="v" />Te Jesu nynh amaw kong kha humhung mah a hopya khyh nawlan hae tynkaring lan bya a kin hae.</para>
  <para style="s1">A Chinaw Kong A Hoty</para>
  <para style="r">(<ref loc="MAT 16:21-28">Mat 16.21-28</ref>; <ref loc="LUK 9:22-27">Luk 9.22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" />Jesu nynh a zuitu hae kya ccangpyanaw kha tho zah: Ccungccaw Ccapaw tuh myarya ccihpaw vawsawnaw kha yn teing hahe cih; piccan hae, ranpibawi lepaw hae te kawbya sazae hae nynh oun vua cih hae zah chia yn thua cih; te nin thumnaw kya yn thoothui cih, a cipya hae. <verse number="32" style="v" />Tuh-e bya tuh ccaerarih lan a ho. Tukeiccuze Peter nynh ccanglang cciakhae zah a seisah. <verse number="33" style="v" />Thuasalama Jesu nynh maenuakuh zah a zuitu hae kha do biate Peter kha, “Satan, ka nulang cceih! Pawccecize na tuanaw hynh Pachia kyate yn thuapaw thua khyh, ccungccaw kyate yn thuapaw nynh thua,” cite pe zah a hopya.</para>
  <para style="p">
    <verse number="34" style="v" />Te a zuitu hae te ccungccaw hae kha ko hae zah, “Humhung zemah kae yn zui ry lan thua ze, amaw te amaw kha vuakuh sah lah a vaelantung kha puihkute yn zui sah.<note caller="-" style="x"><char style="xo" closed="false">8.34: </char><char style="xt" closed="false"><ref loc="MAT 10:38">Mat 10.38</ref>; <ref loc="LUK 14:27">Luk 14.27</ref></char></note> <verse number="35" style="v" />Pawccecize humhung zemah a hiinnaw a khumkuh rypaw tuh a hiinnaw kha a shung cih; kae te thehoypaw keiccuze a hiinnaw a shungpaw tuh a hiinnaw kha a khumkuh cih.<note caller="-" style="x"><char style="xo" closed="false">8.35: </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mat 10.39</ref>; <ref loc="LUK 17:33">Luk 17.33</ref>; <ref loc="JHN 12:25">Joh 12.25</ref></char></note> <verse number="36" style="v" />Ccungccaw lu kheit nynh laephi pynpi hynh pong a ccou zeso a hiinnaw a shung lanze pawmou athane? <verse number="37" style="v" />A hiinnaw kha pawtemou a muethui kho ung cih? <verse number="38" style="v" />Tukeiccuze a ohhuakuhpaw te a seipaw hynh-e ciihan kyahin humhung zemah kamaw te ka bya kha mae yn thyakhaepaw tuh Ccungccaw Ccapaw nynh mah vaaw mithyaa hae ryte a Paaw phu-enaw te yn thua vae ze a maethyakhae ru cih,” a cipya hae.</para>
  <chapter number="9" style="c" />
  <para style="s1">Jesu Muinsan Rulaekunaw</para>
  <para style="r">(<ref loc="MAT 17:1-13">Mat 17.1-13</ref>; <ref loc="LUK 9:28-36">Luk 9.28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Jesu nynh minmin kha, “Byaccaccing kae hopya oh, thungnaw ryte yn thuapaw Pachia peenaw kha a muih hae cia a chih cih lei hae paw ccungccaw abang hein kya a thadyn hae,” a cipya hae.</para>
  <para style="p">
    <verse number="2" style="v" />Nin taruh koute Jesu nynh Peter, James te Johan kha hoeibua hae zah ahangpaw mua lang mih makhaete a cciakhae hae; mih malang khe Jesu tuh a muinsan yn rulaekuh.<note caller="-" style="x"><char style="xo" closed="false">9.2-7: </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2Pe 1.17-18</ref></char></note> <verse number="3" style="v" />A boeining tuh myarya raw zah lahlah ak; tuhcih araw lante uccaw a suh khopaw laephi vawlan um lan khyh. <verse number="4" style="v" />Tuin kya Elijah te Moses tuh minmin kya oun langkuh hae zah Jesu ryte bya a hokuh hae. <verse number="5" style="v" />Peter nynh Jesu kha, “Sazae, hein kya ah um oh paw hynh myarya ahoy; bu buthum kae sak sah lah, nang na hanlan bu kheit, Moses hanlan bu kheit, te Elijah hanlan bu kheit,” a cipya. <verse number="6" style="v" />Minmin tuh myarya a ri hae keiccuze Peter nynh paw byaho lan cipaw nykuh khyh zah tuhte a ho. <verse number="7" style="v" />Te maeking yn zi zah minmin kha pong a khong hae, te maeking kyate, “E paw tuh ka sungsahpaw ka Ccapaw nynh thua, amaw bya kha la ngae oh,” cite roi yn ccae.<note caller="-" style="x"><char style="xo" closed="false">9.7: </char><char style="xt" closed="false"><ref loc="MAT 3:17">Mat 3.17</ref>; <ref loc="MRK 1:11">Mar 1.11</ref>; <ref loc="LUK 3:22">Luk 3.22</ref></char></note> <verse number="8" style="v" />Minmin nynh vaekheihmawte mih pepan he a do hae tuh, mimaw kyakhe Jesu laelan hum sanmah muih vae khyh hae.</para>
  <para style="p">
    <verse number="9" style="v" />Mua langte he oun rungbung hae tuh, Ccungccaw Ccapaw nynh chinaw kyate yn thoothui mawlaezung minmin nynh a muih hae paw kha hum kya sanmah a ho khyh nawlan hae kaw a pya hae. <verse number="10" style="v" />Minmin nynh tuh-e a hopaw bya tuh ccykekuh hae zah, chinaw kyate thoothui cipaw tuh pawmou a ho ry cite mimaw te mimaw a khiaku hae. <verse number="11" style="v" />Te minmin nynh Jesu kha, “Pawccemou kawbya sazae hae nynh Elijah tuh yn thuaty cih a ci hae?” cite a khia hae.<note caller="-" style="x"><char style="xo" closed="false">9.11: </char><char style="xt" closed="false"><ref loc="MAL 4:5">Mal 4.5</ref>; <ref loc="MAT 11:14">Mat 11.14</ref></char></note> <verse number="12" style="v" />Jesu nynh, “Pawpaw balyn paccyn ty khylan Elijah tuh yn thuaty ccaccing cih. Thuasalama pawccemou Ccathya nynh, ‘Ccungccaw Ccapaw nynh vawsawnaw a teing cih zah oun vua cih hae,’ a ci? <verse number="13" style="v" />Thuasalama kae hopya oh, Elijah tuh phe a thua ccaccing vae; Ccathyaa nynh amaw kong a zei thyhte ccungccaw hae nynh mih rythyte a tungvaw phe a cyi vae hae,” cite a hopya hae.</para>
  <para style="s1">Imuapaw A Dansah</para>
  <para style="r">(<ref loc="MAT 17:14-21">Mat 17.14-21</ref>; <ref loc="LUK 9:37-43">Luk 9.37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" />Ccangpaw zuitu hae kya a thua hae tuh ccungccaw zapi patae nynh a koihlu hae paw te kawbya sazae hae ryte bya a eiku hae paw kha a muih hae. <verse number="15" style="v" />Ccungccaw hae balyn nynh Jesu kha ccahe a muih hae tuh myarya mih ngaeangthua zah a kalan ccue hae zah bya a beih hae. <verse number="16" style="v" />Jesu nynh kawbya sazae hae kha, “Minmin ryte pawmou na eiku oh?” cite a khia hae. <verse number="17" style="v" />Ccungccaw zapi laku e lu kheitpaw nynh, “Sazae, muisaw bahkuh zah bya a ho kho leipaw ka ccapaw kha na kalan kae cciakhae. <verse number="18" style="v" />Muisaw hoyleipaw nynh he a thuanua vae ze laephi kya vuakuh zah a khalang kyate a taraphue a pou, a hawzy zah karae aho; tuh-e muisaw a dee ccaw hae cite na zuitu hae ka hopah hae zah dee kho khyh hae,” cite a hopya. <verse number="19" style="v" />Jesu nynh minmin kyakhe, “Pou zynnaw a hoi leipaw ciihan, hohseciamou nae kya ka um ung cih? Hohseciamou kae ngaesangpah ung cih oh? Imuapaw kha ka kalan oun cciakhae oh,” a ci. <verse number="20" style="v" />Minmin nynh imuapaw kha a kalan a cciakhae hae. Tuh-e paw nynh Jesu kha he a muih tuh vaekheihmawte muisaw nynh dungsah zah laephi kya khuliakuh zah a toukuh; a khalang kyate a taraphue athua. <verse number="21" style="v" />Jesu nynh imuapaw a paaw kha, “Hynhte a cyinaw asaw vae tou?” cite a khia. A paaw nynh, “A imua lya mawte a cyih vae. <verse number="22" style="v" />Imuapaw hynh ro khylan maee lungkhu lang te tui lungkhu lang palei a phungsaku. Na cyi kho zetuh thaw oun ccih lah oun bawm,” a cipya. <verse number="23" style="v" />Jesu nynh, “Na zyn kho tou! Zynnaw a hoipaw elang tuh pawpaw tynre acyihkuh kho,” a cipya. <verse number="24" style="v" />Imuapaw a paaw nynh vaekheihmawte sia zah, “Bawipaw, ka zyn, ka zyn leinaw hynh beih yn bawm!” a cipya. <verse number="25" style="v" />Ccungccaw hae nynh pynkheihlan oun ccue hae paw kha Jesu nynh he a muih tuh, muisaw hoyleipaw kha pe zah, “A nawpansahpaw te bya a hosah leipaw muisaw, imuapaw kyate pou lah bua na tee vae khyh nawlan kaw kae pya!” a cipya. <verse number="26" style="v" />Muisaw tuh raerae sia zah imuapaw kha dungsah sya zah a poutaw vae; imuapaw tuh achihpaw hawte thua zah ccungccaw patae nynh, “A chih vae,” a ci hae. <verse number="27" style="v" />Thuasalama Jesu nynh imuapaw kha a kuih te kyng zah he a tho tuh po a tho vae. <verse number="28" style="v" />Inn lungkhu lang he a tee tuh a zuitu hae nynh, “Pawccemou kaening nynh muisaw kha kae dee kho khyh,” cite mih makhae kyakhe a khia hae. <verse number="29" style="v" />Jesu nynh, “Hynhcihawpaw tuh sawsangnaw te, looh-ae sungnaw te rou nynh dee kho athua,” a cipya hae.</para>
  <para style="s1">A Chi lanpaw Bua A Ho</para>
  <para style="r">(<ref loc="MAT 17:22-23">Mat 17.22-23</ref>; <ref loc="LUK 9:43-45">Luk 9.43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" />Minmin tuh tuin kyate pou hae zah Galilee ram kya po a cceih hae. Tuh-e tuh Jesu nynh humhung mah nysah ry khyh. <verse number="31" style="v" />Pawccecize a zuitu hae kha ccangpah hae zah, “Ccungccaw Ccapaw tuh ccungccaw hae kuih kya oun ap cih hae zah oun theih cih hae; a theih kou hae te nin thumnaw kya yn thoothui cih,” cite a hopya hae. <verse number="32" style="v" />Tuh-e a hopaw kha minmin nynh a thaethya khyh hae zemah amaw kha khia lan a rih hae.</para>
  <para style="s1">Hummou A Lehua</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mat 18.1-5</ref>; <ref loc="LUK 9:46-48">Luk 9.46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" />Jesu tuh Kapernaum khua thua zah inn lungkhu a um lyakhe a zuitu hae kha, “Laanpi kya paw konglang mou na eiku oh?” cite a khia hae. <verse number="34" style="v" />Thuasalama minmin tuh yccae khyh hae; pawccecize minmin nynh laanpi kyakhe hummou a lehua cipaw kha mimaw te mimaw a eiku hae.<note caller="-" style="x"><char style="xo" closed="false">9.34: </char><char style="xt" closed="false"><ref loc="LUK 22:24">Luk 22.24</ref></char></note> <verse number="35" style="v" />Jesu tuh haung zah lu haw lae ning kha ko hae zah, “Humhung zemah masatypaw lang a tang rypaw tuh ccungccaw balyn kyaze nyathyakoupaw lang a tang cih zah ccungccaw hae ryalawpahtu lang a tang cih,” a cipya hae.<note caller="-" style="x"><char style="xo" closed="false">9.35: </char><char style="xt" closed="false"><ref loc="MAT 20:26-27">Mat 20.26-27</ref>, <ref loc="MAT 23:11">23.11</ref>; <ref loc="MRK 10:43-44">Mar 10.43-44</ref>; <ref loc="LUK 22:26">Luk 22.26</ref></char></note> <verse number="36" style="v" />Imua lu kheit kha lah zah mih laku khe a nung; te a kuih kya dua zah, <verse number="37" style="v" />“Humhung zemah e tahawpaw imua lu kheit kha ka min te leh a khanpaw tuh kae kha leh yn khanpaw nynh thua; humhung zemah kae kha leh yn khanpaw tuh kae kyalya kha leh yn khanpaw thua leite kae yn sawtupaw kha mah leh a khanpaw nynh thua,” cite a hopya hae.<note caller="-" style="x"><char style="xo" closed="false">9.37: </char><char style="xt" closed="false"><ref loc="MAT 10:40">Mat 10.40</ref>; <ref loc="LUK 10:16">Luk 10.16</ref>; <ref loc="JHN 13:20">Joh 13.20</ref></char></note></para>
  <para style="s1">Oun Rhaw leipaw tuh Oun Pankhaepaw</para>
  <para style="r">(<ref loc="LUK 9:49-50">Luk 9.49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" />Johan nynh Jesu kha, “Sazae, na min te raerangsaro a deepaw lu kheit kha kae muih zah kae khee; pawccecize aning tuh aening phu kya-e thua khyh,” a cipya. <verse number="39" style="v" />Jesu nynh, “Tuh-e paw tuh khee nan oh; pawccecize ka min te ngaeangnaw a rae koute ka thethya palou yn ho khopaw humhung mah um lan khyh. <verse number="40" style="v" />Pawccecize aening oun rawse leipaw tuh oun pankhaepaw nynh thua.<note caller="-" style="x"><char style="xo" closed="false">9.40: </char><char style="xt" closed="false"><ref loc="MAT 12:30">Mat 12.30</ref>; <ref loc="LUK 11:23">Luk 11.23</ref></char></note> <verse number="41" style="v" />Byaccaccing kae hopya oh: Khri ccungccaw na thua oh keiccuze ka min liate nia lanpaw tui banang nang kheit ae pya oh paw tuh a ryalaw mee shung lan khyh.<note caller="-" style="x"><char style="xo" closed="false">9.41: </char><char style="xt" closed="false"><ref loc="MAT 10:42">Mat 10.42</ref></char></note></para>
  <para style="s1">Hell Kong Raeringnaw Pyanaw</para>
  <para style="r">(<ref loc="MAT 18:6-10">Mat 18.6-10</ref>)</para>
  <para style="p">
    <verse number="42" style="v" />“Humhung zemah kae yn zynpaw e imua taraw lukhakheit kha seinaw a raesahpaw tuh a nging kya mianawpaw lung kha sae lan zah rili lungkhu lang phung lanze amaw hanlan ahoyhua. <verse number="43" style="v" />Na kuih nynh seinaw ae raesah ze, thoh tya. Kuih voi ning hoite a chih kho leipaw hell maee lungkhu lang ccia laeze kuihccung te hiinnaw kalan tee tuh na hanlan ahoyhua.<note caller="-" style="x"><char style="xo" closed="false">9.43: </char><char style="xt" closed="false"><ref loc="MAT 5:30">Mat 5.30</ref></char></note> <verse number="44" style="v" />Tuin kya tuh zanpaw chih khyh zah maee mah chih khyh. <verse number="45" style="v" />Na ccu nynh ae seisah ze, tuh-e tuh thoh tya; ccu voi ning hoite a chih kho leipaw hell maee lungkhu lang vuaku lanpaw lae tuh ccukhou te hiinnaw lungkhu lang tee lanpaw kha na hanlan ahoyhua. <verse number="46" style="v" />Tuin kya tuh zanpaw chih khyh zah maee mah chih khyh. <verse number="47" style="v" />Na mit nynh seinaw ae raesah ze, poh khoi; mit voi ning hoite hell maee lungkhu lang vuaku laeze mit voi kheit te Pachia peenaw lungkhu lang tee tuh na hanlan ahoyhua.<note caller="-" style="x"><char style="xo" closed="false">9.47: </char><char style="xt" closed="false"><ref loc="MAT 5:29">Mat 5.29</ref></char></note> <verse number="48" style="v" />Tuin kya tuh zanpaw chih khyh zah maee mah chih khyh.<note caller="-" style="x"><char style="xo" closed="false">9.48: </char><char style="xt" closed="false"><ref loc="ISA 66:24">Isa 66.24</ref></char></note></para>
  <para style="p">
    <verse number="49" style="v" />“Pawccecize silawnawpaw miakaw kha loi phing athua hawte ccungccaw miakaw kha maeeloi phing athua cih. <verse number="50" style="v" />Loi tuh ahoy, thuasalama loi nynh a enaw kha azo vae ze, pawtemou na esah kho ung cih? Naemaw kyakhe loi kha hoi oh, lu kheit te lu kheit daenaw te la um oh,” a cipya hae.<note caller="-" style="x"><char style="xo" closed="false">9.50: </char><char style="xt" closed="false"><ref loc="MAT 5:13">Mat 5.13</ref>; <ref loc="LUK 14:34-35">Luk 14.34-35</ref></char></note></para>
  <chapter number="10" style="c" />
  <para style="s1">Zu Myanaw</para>
  <para style="r">(<ref loc="MAT 5:31-32">Mat 5.31-32</ref>, <ref loc="MAT 19:1-12">19.1-12</ref>; <ref loc="LUK 16:18">Luk 16.18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Jesu tuh tuin kyate toikuh zah Judea ram te Jordan vaw khuraw langkhe a cceih; ccungccaw hae nynh a kalan bua oun pumnuakuh hae zah, leih a ccangpya hae hawte bua a ccangpya hae.</para>
  <para style="p">
    <verse number="2" style="v" />Farasi hae abang nynh oun thua hae zah amaw kha syntawtua khylan, “Pisepaw nynh a zu kha mya lan kawbya nynh a ua tou?” cite a khia hae. <verse number="3" style="v" />Jesu nynh, “Moses nynh pawtemou kawbya ae pya oh?” cite a khung hae. <verse number="4" style="v" />Minmin nynh, “Moses nynh myakunaw ccaw zei lan zah mya lan a ua,” cite a khung hae.<note caller="-" style="x"><char style="xo" closed="false">10.4: </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">Deu 24.1-4</ref>; <ref loc="MAT 5:31">Mat 5.31</ref></char></note> <verse number="5" style="v" />Jesu nynh minmin kha, “Nae thinlung akhung keiccu nynh e kawbya hynh ae zeipya oh. <verse number="6" style="v" />Thuasalama raenaw athotakaw lya tuh, ‘Pachia nynh nopi te pise kha a rae.’<note caller="-" style="x"><char style="xo" closed="false">10.6: </char><char style="xt" closed="false"><ref loc="GEN 1:27">Gen 1.27</ref>, <ref loc="GEN 5:2">5.2</ref></char></note> <verse number="7" style="v" />‘Hynh-e keiccuze pise nynh a nung te a paaw kha a cciataw cih zah a zu te a umkheih cih hae;<note caller="-" style="x"><char style="xo" closed="false">10.7-8: </char><char style="xt" closed="false"><ref loc="GEN 2:24">Gen 2.24</ref></char></note> <verse number="8" style="v" />minmin lu ning tuh pyn pynkheit lang a tang cih hae.’ Tukeiccuze minmin tuh lu ning thua vae khyh hae, pyn pynkheit nynh athua vae hae. <verse number="9" style="v" />Tukeiccuze Pachia nynh a suelua vae paw kha humhung nynh mah phia nan sah,” a ci.</para>
  <para style="p">
    <verse number="10" style="v" />Inn lungkhu khe a zuitu hae nynh tuh-e kong kha bua a khia hae. <verse number="11" style="v" />Jesu nynh minmin kha, “Humhung zemah a zu kha mah zah ccangpaw zu a hoipaw tuh zu ccangpaw kya seinaw a raepaw nynh thua.<note caller="-" style="x"><char style="xo" closed="false">10.11-12: </char><char style="xt" closed="false"><ref loc="MAT 5:32">Mat 5.32</ref>; <ref loc="1CO 7:10-11">1Ko 7.10-11</ref></char></note> <verse number="12" style="v" />Nopinung nynh a vawpaw kha mah zah ccangpaw vawpaw a hoi zetuh vawpaw ccangpaw kya seinaw a raenung nynh thua,” a cipya hae.</para>
  <para style="s1">Jesu te Imua hae</para>
  <para style="r">(<ref loc="MAT 19:13-15">Mat 19.13-15</ref>; <ref loc="LUK 18:15-17">Luk 18.15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" />Ccungccaw hae nynh imua taraw hae kha Jesu kalan haesah khylan oun cciakhae hae; a zuitu hae nynh oun cciakhaetu hae kha a pe hae. <verse number="14" style="v" />Jesu nynh tuh-e tuh he a muih te, a thinria zah minmin kha, “Imua taraw hae kha ka kalan oun cceih hae sah, kang nan oh; pawccecize Pachia peenaw tuh hynhcihawpaw hae elang nynh thua. <verse number="15" style="v" />Byaccaccing kae hopya oh, humhung zemah Pachia peenaw kha imua taraw hawte a lawku khyh ze, tuh-e peenaw lungkhu lang tee lan khyh,” a cipya hae.<note caller="-" style="x"><char style="xo" closed="false">10.15: </char><char style="xt" closed="false"><ref loc="MAT 18:3">Mat 18.3</ref></char></note> <verse number="16" style="v" />Imua hae kha dua hae zah mih tungvaw kya a kuih khang zah hythua a pya hae.</para>
  <para style="s1">Mihoi Ccangvaepaw</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mat 19.16-30</ref>; <ref loc="LUK 18:18-30">Luk 18.18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" />Jesu tuh khuaccong lan a thoku lyakhe lukheitpaw nynh a kalan yn ccue zah a malang ccukharutungte, “Sazae hoypaw, zungzae hiinnaw ka ccou nawlan pawmou ka cyih cih?” cite a khia. <verse number="18" style="v" />Jesu nynh, “Pawccemou kae hynh ahoypaw cite nae ko? Pachia lu kheit laelan ahoypaw hum sanmah um khyh. <verse number="19" style="v" />Kawbya hae kha mang na nyh khaw: ‘Ccungccaw na theih lan khyh, milae zu milae vawpaw kya na sei lan khyh, na ruh lan khyh, ahme leipaw ccaekia lang na tang lan khyh, ccungccaw na ling lan khyh, na nung te na paaw kha sawtua,’ cipaw kha,” a cipya.<note caller="-" style="x"><char style="xo" closed="false">10.19: </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">Exo 20.12-16</ref>; <ref loc="DEU 5:16-20">Deu 5.16-20</ref></char></note> <verse number="20" style="v" />Tuh-e paw nynh, “Sazae, tuh-e hae balyn tuh ka di lya mawte pong ka zui vae,” a cipya. <verse number="21" style="v" />Jesu nynh tuh-e paw tuh sungsahnaw te dobia zah, “Ccangkheit na bou ung; la cceih lah na hoipaw balyn kha la zua lah ryachi hae kha la pya hae, te vaawlang khua kya sisua na hoi cih; tukoute rang lah yn zui,” a cipya. <verse number="22" style="v" />Aning nynh tuh-e bya he a thae te, a maesue hoy leite ngaethyate po a cceih, pawccecize aning tuh myarya a hoirumpaw nynh thua.</para>
  <para style="p">
    <verse number="23" style="v" />Jesu nynh a pepan khe do zah a zuitu hae kyakhe, “Mihoi hae nynh Pachia peenaw kya tee lanpaw tuh pawcihmou aru cih!” cite a hopya hae. <verse number="24" style="v" />A zuitu hae tuh tuh-e bya keiccuze mih ngaeangthua. Thuasalama Jesu nynh bua hopah hae zah, “Ka ccaaw oh, Pachia peenaw kya tee tuh pawcihmou aru! <verse number="25" style="v" />Mihoipaw nynh Pachia peenaw kalan tee lae tuh kalauh nynh phynbang khu kya tee nynh azoihua,” a cipya hae. <verse number="26" style="v" />Minmin tuh myarya mih ngaeangthua zah, “Tuhte athua ze hummou khumnaw a mue kho cih” cite lu kheit te lu kheit a hoku hae. <verse number="27" style="v" />Jesu nynh minmin kha do hae zah, “Ccungccaw hanlan thua kho khyh, thuasalama Pachia hanlan athua kho leipaw um khyh; pawccecize Pachia hanlan tuh pawpaw balyn athua kho,” a ci.</para>
  <para style="p">
    <verse number="28" style="v" />Peter nynh Jesu kha, “Dotua, kaening tuh pawpaw balyn kae cciataw zah namaw kha kae zui vae,” a cipya. <verse number="29" style="v" />Jesu nynh, “Byaccaccing kae hopya oh, kae te thehoypaw keiccuze inn, uteno hae, ccianung hae, paaw, nung, zu, ccaaw hae, loo hae, tuh-e hae hankhakheit kha a cciatawpaw tuh, <verse number="30" style="v" />atu she kyahin inn hae, uteno hae, ccia hae, nung hae, ccaaw hae te loo hae kha tuaasahkunaw ryte leit za kheit a mue cih; yn thua cih paw she kya zungzae hiinnaw kha a mue cih. <verse number="31" style="v" />Thuasalama masaty e ccungccaw patae tuh nyathyakou athua cih hae zah nyathyakou e patae tuh masaty athua cih hae,” a ci.<note caller="-" style="x"><char style="xo" closed="false">10.31: </char><char style="xt" closed="false"><ref loc="MAT 20:16">Mat 20.16</ref>; <ref loc="LUK 13:30">Luk 13.30</ref></char></note></para>
  <para style="s1">A Chi lanpaw Bua A Ho</para>
  <para style="r">(<ref loc="MAT 20:17-19">Mat 20.17-19</ref>; <ref loc="LUK 18:31-34">Luk 18.31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" />Minmin nynh Jerusalem lang a cciathung lya hae laanpi kyakhe, Jesu tuh mih malang a cceih; zuitu hae tuh mih ngaeangthua zah nulang te a zuikuh hae paw mah a rih hae. Aning nynh lu haw lae ning kha ccanglang bua cciakhae hae zah a tungvaw yn cyihkuh lanpaw kha a hopya hae: <verse number="33" style="v" />“Dotua oh, aening tuh Jerusalem lang nynh ah cciathung oh; Ccungccaw Ccapaw tuh ranpibawi lepaw hae te kawbya sazae hae kalan oun ap cih hae; minmin nynh chia lante bya oun pia cih hae zah Zenta hae kuih kalan oun ap cih hae; <verse number="34" style="v" />tuh-e hae nynh amaw kha oun sarya cih hae zah oun bua cih hae, mih tuing te oun thoi cih hae zah oun theih cih hae; te nin thumnaw kya bua yn thoothui cih,” a ci.</para>
  <para style="s1">James te Johan nynh Ngianaw</para>
  <para style="r">(<ref loc="MAT 20:20-28">Mat 20.20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" />Zebedi ccaaw hae James te Johan nynh Jesu kalan oun cceih hae zah, “Sazae, kaening nynh kae ngiakupaw nae cyipah ravo nyn ci kae ry,” a cipya hae. <verse number="36" style="v" />Jesu nynh, “Nae hanlan pawmou nae cyisah ry oh?” cite a khia hae. <verse number="37" style="v" />Minmin nynh, “Na phu-enaw kya lu kheit na ranglang, lu kheit na voilang kae haungbua nawlan oun ua,” a ci hae. <verse number="38" style="v" />Thuasalama Jesu nynh, “Nanning nynh paw nynh kae ngia cipaw na nyh khyh oh; ka niapaw banang kha na neih kho cih oh tou? Baptisma ka inpaw kha na in kho cih oh tou?” a cipya hae.<note caller="-" style="x"><char style="xo" closed="false">10.38: </char><char style="xt" closed="false"><ref loc="LUK 12:50">Luk 12.50</ref></char></note> <verse number="39" style="v" />Minmin nynh, “Kae cyih kho cih,” a ci hae. Jesu nynh minmin kha, “Ka niapaw banang kha na neihbua cih oh; ka inpaw baptisma kha mah na inbua cih oh. <verse number="40" style="v" />Thuasalama ka ranglang te ka voilang haungnaw kaw kha kae nynh ka pya kho khyh; e hmin tuh Pachia nynh a paccynpya hae paw kha nynh a pya cih hae,” a cipya hae.</para>
  <para style="p">
    <verse number="41" style="v" />Zuitu hae lu haw nynh tuh-e tuh he a thae hae tuh James te Johan tungvaw mih thinria. <verse number="42" style="v" />Tukeiccuze Jesu nynh minmin kha ko hae zah, “Zenta hae a uktu hae nynh tuh a uk hae paw tungvaw kya huhan hoi hae zah, a lesae hae paw nynh kawhoinaw kha a mang hae cipaw na ny oh.<note caller="-" style="x"><char style="xo" closed="false">10.42-43: </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">Luk 22.25-26</ref></char></note> <verse number="43" style="v" />Thuasalama nanning kya tuh tuhte thua lan khyh; humhung zemah nanning lakuze a lesaepaw lang a tang rypaw tuh nae ryalahtu lang a tang cih.<note caller="-" style="x"><char style="xo" closed="false">10.43-44: </char><char style="xt" closed="false"><ref loc="MAT 23:11">Mat 23.11</ref>; <ref loc="MRK 9:35">Mar 9.35</ref>; <ref loc="LUK 22:26">Luk 22.26</ref></char></note> <verse number="44" style="v" />Humhung zemah nanning lakuze lupihua lang a tang rypaw tuh ccungccaw balyn see lang a tang cih. <verse number="45" style="v" />Pawccecize Ccungccaw Ccapaw tuh rya lawpyaku khylan yn thua khyh, ming hae rya kha lawpya khylan te ccungccaw patae shawkhaw nawlan a hiinnaw kha pyaku khylan nynh yn thua,” cite a hopya hae.</para>
  <para style="b" />
  <para style="s1">Mitmohpaw Bartimu Dansahnaw</para>
  <para style="r">(<ref loc="MAT 20:29-34">Mat 20.29-34</ref>; <ref loc="LUK 18:35-43">Luk 18.35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" />Minmin tuh Jeriko khua a thua hae; te a zuitu hae ry, ccungccaw pataepi ryte Jeriko kyate he a pou hae tuh, Timia ccapaw mitmohpaw Bartimu tuh laanrae khe ccungccaw ngiakute a la haung. <verse number="47" style="v" />Nazareth khuapaw Jesu cipaw he a thae tuh, “David Ccapaw Jesu, kae hynh ngaethya yn umsah!” cite thawte a sia. <verse number="48" style="v" />Ccungccaw patae nynh zya adae ccaw cite a pe hae; thuasalama aning nynh, “David Ccapaw, kae hynh ngaethya yn umsah,” cite houh ccae lan a sia. <verse number="49" style="v" />Jesu nynh thadyn zah tuh-e paw tuh a kosah hae. Minmin nynh mitmohpaw kha ko hae zah, “Na lungtua sah, thokuh, nang kha ae ko,” cite a hopya hae. <verse number="50" style="v" />Aning nynh a boeining kha ccaring a vua koute thohkuh zah Jesu kya a thua. <verse number="51" style="v" />Jesu nynh, “Na hanlan pawmou nae cyisah ry?” cite a khia. Mitmohpaw nynh, “Sazae, ngaw bua yn muih sah,” a cipya. <verse number="52" style="v" />Jesu nynh, “La cceih ccavae, na zynnaw nynh ae dansah vae,” a cipya. Vaekheihmawte ngawmuih zah laanpi kya Jesu kha a zui vae.</para>
  <chapter number="11" style="c" />
  <para style="s1">Jerusalem lang Jesu A Tee</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mat 21.1-11</ref>; <ref loc="LUK 19:28-40">Luk 19.28-40</ref>; <ref loc="JHN 12:12-19">Joh 12.12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Jesu te a zuitu hae nynh Jerusalem lang vyavya a thuadyn hae, Oliv Mua pe umpaw Bethfake khua te Bethani khua kya he a thua hae te, Jesu nynh a zuitu hae lu ning kha malang saw lalo hae zah, <verse number="2" style="v" />“Nae malang umpaw khua kalan la cceih oh lah tuh-e khua lungkhu lang he na tee miakaw oh te, hum nynh sanmah a cciku boi leipaw lann taraw a khii hae paw kha na la muih cih oh, tuh-e tuh oun supah oh lah oun sue oh. <verse number="3" style="v" />Lukhakheit nynh, ‘Pawccemou khahte na cyi oh?’ cite ae khia oh ze, ‘Bawipaw nynh a peki, taloi bua kae pya cih oh,’ na cipah cih oh,” cite a hopya hae. <verse number="4" style="v" />Minmin nynh cceih hae zah sakoih akhung lang laanpi atungkunaw kya a khii hae paw lann taraw kha muih hae zah a supya hae. <verse number="5" style="v" />Tuin kya a thadyn hae paw abang nynh minmin kha, “Pawccemou lann taraw kha na supya oh?” a ci hae. <verse number="6" style="v" />Jesu nynh a taw hae hawte hopah hae zah minmin nynh a cciasah hae. <verse number="7" style="v" />Zuitu hae nynh lann taraw kha Jesu kalan cciakhae hae zah a tungvaw khe mih boei kha de hae zah Jesu nynh a cciku. <verse number="8" style="v" />Ccungccaw patae nynh mih boei kha laanpi kya a phaepya hae; abang nynh anaw lungpaw thingnge hae kha khya hae zah laanpi kya a phaepya hae. <verse number="9" style="v" />Malang cceih hae paw te nulang a zuikuh hae paw nynh,</para>
  <para style="q1">“Hosanna! Bawipaw min te</para>
  <para style="q2">yn thuapaw tuh hythuaccou sah!<note caller="-" style="x"><char style="xo" closed="false">11.9: </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">Sam 118.25-26</ref></char></note></para>
  <para style="q1">
    <verse number="10" style="v" />Yn thua cih paw</para>
  <para style="q2">ah minpaaw David peenaw tuh</para>
  <para style="q1">hythuaccou sah!</para>
  <para style="q2">Ahang huanaw vaawlang khua kya</para>
  <para style="q1">Hosanna thua sah!” cite a sia hae.</para>
  <para style="p">
    <verse number="11" style="v" />Jesu tuh Jerusalem khua a thua te beikinn lungkhu lang a tee; pawpaw balyn kha pong a do koute zete he athua tuh lu haw lae ning ryte Bethani khua lang a cceih hae.</para>
  <para style="s1">Thaeku Ku Thyalawnaw</para>
  <para style="r">(<ref loc="MAT 21:18-22">Mat 21.18-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" />Awkhualan Bethani khua te he a ki hae tuh Jesu tuh a vuelaw. <verse number="13" style="v" />Anaw asaepaw thaeku ku kha asawnaw te muih zah athae ccangkhakheit ka muihkuh cih vosi cite a ccianua; he a thuanua tuh anaw kyalya kha a muih; pawccecize thaeku a thae ccyh thua loh khyh. <verse number="14" style="v" />Jesu nynh thaeku ku kha, “Humhung nynh mah na thae la ae nan vae sah,” cite a cipya, tuh-e bya tuh a zuitu hae nynh phe a thae hae.</para>
  <para style="s1">Jesu nynh Beikinn A Ccikan</para>
  <para style="r">(<ref loc="MAT 21:12-13">Mat 21.12-13</ref>; <ref loc="LUK 19:45-48">Luk 19.45-48</ref>; <ref loc="JHN 2:12-17">Joh 2.12-17</ref>)</para>
  <para style="p">
    <verse number="15" style="v" />Minmin tuh Jerusalem a thua hae. Jesu tuh beikinn voidu lungkhu lang tee zah tuin kya a zuatu hae te a retu hae kha a dee hae, te phuarutu hae ccaboi te valaele zuatu hae tungkhung kha phya a dawleihpya hae. <verse number="16" style="v" />Beikinn voidu lungkhu lang uccaw teekhae lan ua khyh hae. <verse number="17" style="v" />Ccangpah hae zah, “Ccathyaa kyaze,</para>
  <para style="q1">‘Ka inn tuh minphuin hae balyn</para>
  <para style="q2">sawsangnaw inn cite</para>
  <para style="q1">ko athua cih,’ cite</para>
  <para style="q2">zeikuh khyh tou?</para>
  <para style="q1">Thuasalama nanning nynh</para>
  <para style="q2">miruh hae karung lang</para>
  <para style="q1">na rae vae oh,” a cipya hae.<note caller="-" style="x"><char style="xo" closed="false">11.17: </char><char style="xt" closed="false"><ref loc="ISA 56:7">Isa 56.7</ref>; <ref loc="JER 7:11">Jer 7.11</ref></char></note></para>
  <para style="m">
    <verse number="18" style="v" />Kawbya sazae hae te ranpibawi lepaw hae nynh he a thae hae tuh Jesu chianaw laanpi kha a ccung hae; pawccecize ccungccaw balyn nynh a ccangpyanaw kha mih ngaeangthua keiccuze minmin nynh amaw raw a rih hae. <verse number="19" style="v" />Zetesang yn thua tuh Jesu te a zuitu hae tuh khua kyate a pou hae.</para>
  <para style="s1">Thaeku Ku Karae Rounaw</para>
  <para style="r">(<ref loc="MAT 21:18-22">Mat 21.18-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" />Minmin nynh awkhua a ccia lya hae khe a tharui kyate karae aroupaw thaeku ku kha a muih hae. <verse number="21" style="v" />Peter nynh liathui zah Jesu kha, “Sazae, dotua! Thya na lawpaw thaeku ku karae rou vae,” a cipya. <verse number="22" style="v" />Jesu nynh minmin kha, “Pachia kya zynnaw hoi oh. <verse number="23" style="v" />Pawccecize byaccaccing kae hopya oh, humhung zemah e mua hynh, ‘Nang nuekuh lah rili lungkhu lang phungkuh,’ cipah zah lunghiinnaw hoi leite a hopaw tuh acyikuh cih cite a zyn lanze, a ho hawte acyikuh cih.<note caller="-" style="x"><char style="xo" closed="false">11.23: </char><char style="xt" closed="false"><ref loc="MAT 17:20">Mat 17.20</ref>; <ref loc="1CO 13:2">1Ko 13.2</ref></char></note> <verse number="24" style="v" />Tukeiccuze kae hopya oh, sawsang te na ngia oh paw miakaw kha kae mue vae cite zyn oh lah na mue cih oh.</para>
  <para style="p">
    <verse number="25" style="v" />“Sawsang te na thadyn vae oh ze, lukhakheit tungvaw seibe lanpaw ccangkhakheit na hoi oh ze la ngaethya oh; tuhteze nynh vaawlang umpaw nae Paaw nynh mah nae seinaw kha ae ngaethya cih oh.<note caller="-" style="x"><char style="xo" closed="false">11.25-26: </char><char style="xt" closed="false"><ref loc="MAT 6:14-15">Mat 6.14-15</ref></char></note> <verse number="26" style="v" />Thuasalama na ngaethya khyh oh ze, vaawlang umpaw nae Paaw nynh mah nae seinaw kha ae ngaethya lan khyh oh,” cite a hopya hae.</para>
  <para style="s">Jesu Kawhoinaw A Khia hae</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mat 21.23-27</ref>; <ref loc="LUK 20:1-8">Luk 20.1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" />Jesu te a zuitu hae tuh Jerusalem lang bua oun thua hae. Jesu nynh beikinn voidu kya a ccia lyakhe ranpibawi lepaw hae, kawbya sazae hae te piccan hae nynh amaw kalan oun cceih hae zah, <verse number="28" style="v" />“E uccaw hae hynh paw kawhoinaw te mou na cyi? E uccaw hae cyi lan hum nynh mou e kawhoinaw hynh ae pya?” cite a khia hae. <verse number="29" style="v" />Jesu nynh minmin kha, “Kae mah bya kaw kheit kae khia cih oh; nae hopya oh ze, e uccaw hae hynh paw kawhoinaw te nynh ka cyi cipaw kae hopah ru cih oh. <verse number="30" style="v" />Johan kya-e baptisma hynh vaawlang tetou yn thua? Tuhkhyhze ccungccaw hae kyate tou? Yn hopya tua oh,” cite a khia hae. <verse number="31" style="v" />Minmin tuh mimaw te mimaw eikuh hae zah, “Aening nynh, ‘Vaawlang kyate,’ ah ci oh ze, aning nynh, ‘Tuhteze pawccemou Johan kha na zyn khyh oh,’ yn ci cih. <verse number="32" style="v" />Thuasalama, ‘Ccungccaw hae kyate,’ ah ci oh ze,” ci hae zah, minmin nynh ccungccaw hae raw kha a rih hae; pawccecize ccungccaw balyn nynh Johan tuh profeh ccaccing cite a tua hae paw nynh thua. <verse number="33" style="v" />Tukeiccuze minmin nynh Jesu kha, “Kae nyh khyh,” a cipya hae. Jesu nynh, “Kae mah paw kawhoinaw te nynh e uccaw hae hynh ka cyi cipaw kae hopah lan khyh oh,” a cipya hae.</para>
  <chapter number="12" style="c" />
  <para style="s1">Ahoy leipaw Ryalahtu hae Tousenaw</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mat 21.33-46</ref>; <ref loc="LUK 20:9-19">Luk 20.9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Jesu nynh minmin kha tousenaw phungpaw te bya a hopya hae: “Ccungccapaw lu kheit nynh misu khokhu raekuh zah hohung te po a koih, misu mianawpaw akhu kha karouh zah buhang phe a dua, te misu khokhu kha a hohtu hae kalan hohsakuh hae zah ramccang lang a cceih.<note caller="-" style="x"><char style="xo" closed="false">12.1: </char><char style="xt" closed="false"><ref loc="ISA 5:1-2">Isa 5.1-2</ref></char></note> <verse number="2" style="v" />Misu thae lo ccyh yn zaw tuh aning nynh a hanpaw misu thae kha law khylan a see lu kheit kha mih kalan a saw. <verse number="3" style="v" />Minmin nynh tuh-e see tuh kyng hae zah a bua kou hae te, a kuih ccakaete a kisah hae. <verse number="4" style="v" />Aning nynh ccangpaw see kha minmin kalan bua a saw; minmin nynh lung te deih hae zah a lu kya vaemaw a muesah kou hae te, maethyate a kisah hae. <verse number="5" style="v" />Aning nynh ccangpaw see kha bua saw zah minmin nynh tuh-e paw tuh phe a chia hae; te ccangpaw patae kha mah saw hae zah abang kha a bua hae, abang kha a chia hae. <verse number="6" style="v" />Khokhu hoitupaw nynh a sungsahpaw a ccapaw lu kheit kyalya nynh saw lanpaw a hoi vae. Nyathyakou tuh, ‘Minmin nynh ka ccapaw tuh saw a tua cih hae,’ ci zah a ccapaw kha minmin kalan a saw. <verse number="7" style="v" />Thuasalama khokhu a hohtu hae nynh, ‘E paw tuh rhoccoutu nynh thua, rang oh, theih oh sih lah a rho tuh ah uccaw lang a tang vae cih,’ cite lu kheit te lu kheit a hoku hae. <verse number="8" style="v" />Minmin nynh a ccapaw kha kyng hae zah a theih kou hae te, misu khokhu atolang khe a vua hae. <verse number="9" style="v" />Tukeiccuze misu khokhu hoitupaw nynh pawtemou a cyi cih? Aning nynh yn cceih cih zah minmin kha marya a theih cih hae zah misu khokhu kha mingccang hae kalan a pya cih hae. <verse number="10" style="v" />Ccathyaa kyaze,</para>
  <para style="q1">‘Inn sak hae paw nynh</para>
  <para style="q2">a nuee hae paw lung tuh</para>
  <para style="q1">inn saknaw kya abyapi huapaw</para>
  <para style="q2">apaki lang e lung lang yn tang.<note caller="-" style="x"><char style="xo" closed="false">12.10-11: </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">Sam 118.22-23</ref></char></note></para>
  <para style="q1">
    <verse number="11" style="v" />E tuh Bawipaw nynh</para>
  <para style="q2">a cyipaw thua zah,</para>
  <para style="q1">aening muihnaw kya</para>
  <para style="q2">ngaeang lan umpaw nynh thua,’ cite</para>
  <para style="q1">azeikuhpaw kha</para>
  <para style="q2">na ria boi khyh oh tou?” a cipya hae.</para>
  <para style="p">
    <verse number="12" style="v" />Minmin nynh hynh-e tousenaw phungpaw hynh kaening nynh yn honua cipaw a nyku hae keiccuze Jesu kha kyng lan a zuaku hae; thuasalama ccungccaw zapi raw a ri hae keiccuze Jesu kha a cciataw hae.</para>
  <para style="s1">Ngunto Kong Byakhianaw</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mat 22.15-22</ref>; <ref loc="LUK 20:20-26">Luk 20.20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" />Jesu nynh bya a hopaw kha kyngpya khylan minmin nynh Farasi hae te Herodias hae abang kha a sawnua hae. <verse number="14" style="v" />Jesu kya a thua hae te, “Sazae, nang tuh ahmepaw nynh na thua, mirymihua na po khyh, pawccecize nang tuh ccungccaw hae kha maedo leite Pachia laanpi kha hmerarih lan na ccangpya hae cipaw kae ny. Sizar siapharan kalan ngunto pya lan accan tou, ccan khyh tou? <verse number="15" style="v" />Kaening nynh kae pya cih tou, kae pya lan khyh tou?” cite a khia hae. Thuasalama Jesu nynh mih thyaruhnaw kha nyh zah minmin kha, “Pawccemou nae syntawtua oh? Denari kia kheit kha oun ccyngtua oh, ka la dotua,” a cipya hae. <verse number="16" style="v" />Minmin nynh kia kheitpaw kha a cciakhae hae. Jesu nynh minmin kha, “E hynh hum muinsan te hum min mou?” cite a khia hae. Minmin nynh, “Siapharan muinsan te min,” a ci hae. <verse number="17" style="v" />Jesu nynh minmin kha, “Siapharan uccaw hae kha siapharan kalan pya oh lah, Pachia uccaw hae kha Pachia kalan pya oh,” a cipya hae. Minmin tuh a tungvaw kya mih ngaeangthua.</para>
  <para style="s1">Thoothuinaw Kong Byakhianaw</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mat 22.23-33</ref>; <ref loc="LUK 20:27-40">Luk 20.27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" />Thoothuinaw um khyh cite a ho hae paw Sadusi hae abang nynh Jesu kalan oun cceih hae zah,<note caller="-" style="x"><char style="xo" closed="false">12.18: </char><char style="xt" closed="false"><ref loc="ACT 23:8">Loc 23.8</ref></char></note> <verse number="19" style="v" />“Sazae, ‘Ccungccapaw lu kheit nynh ccaawsaah leite a zu kha a chitaw ze, tuh-e paw a neitawpaw nynh tuh-e zu tuh a umkhae cih zah a upaw elang ccaaw a saahpah cih,’ cite Moses nynh oun zeipya.<note caller="-" style="x"><char style="xo" closed="false">12.19: </char><char style="xt" closed="false"><ref loc="DEU 25:5">Deu 25.5</ref></char></note> <verse number="20" style="v" />Vaekheit tuh uno lu sari a um hae. Atawccapaw nynh zu hoi zah ccaawsaah leite a chih. <verse number="21" style="v" />Lu ningnaw nynh tuh-e nung tuh umkhae zah ccaawsaah leite bua a chih; te lu thumnaw nynh tuhawte a chitaw; <verse number="22" style="v" />lu sari mawte tuh-e nung tuh umkhae hae zah ccaawsaah leite a chih hae; nyathyakou tuh tuh-e nopinung mah a chihbua. <verse number="23" style="v" />Tukeiccuze thoothui nin kya tuh-e nung tuh hum zu lang mou a tang cih? Pawccecize lu sari mawte tuh-e nung tuh zu lang a umkhae hae,” cite a khia hae.</para>
  <para style="p">
    <verse number="24" style="v" />Jesu nynh minmin kha, “Ccathyaa te Pachia thungnaw kha na ny khyh oh keiccuze na mesei oh. <verse number="25" style="v" />Pawccecize minmin tuh chinaw kyate he a thoothui hae tetuh zuvaw tang ci um vae khyh, zu dypyaku ci mah um vae khyh, minmin tuh vaawlang e vaaw hae hawte nynh athua vae hae. <verse number="26" style="v" />A chih hae paw thoothuinaw kong lante Pachia nynh, ‘Kae tuh Abraham Pachia, Isak Pachia te Jakob Pachia nynh ka thua,’ cite thabu kyate Moses a hopyapaw kha Moses ccauh kya na ria boi khyh oh tou?<note caller="-" style="x"><char style="xo" closed="false">12.26: </char><char style="xt" closed="false"><ref loc="EXO 3:6">Exo 3.6</ref></char></note> <verse number="27" style="v" />Pachia tuh a chih hae paw Pachia thua khyh, a hiin hae paw Pachia nynh thua, tukeiccuze nanning tuh myarya na mesei oh,” a cipya hae.</para>
  <para style="s1">Byapi huapaw Kawbya</para>
  <para style="r">(<ref loc="MAT 22:34-40">Mat 22.34-40</ref>; <ref loc="LUK 10:25-28">Luk 10.25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" />Kawbya sazae lu kheit nynh yn cceih zah minmin a eiku hae paw kha thae zah Jesu nynh Sadusi hae kha hoyte a phipya hae paw kha a muih keiccuze Jesu kha, “Kawbya balyn kyaze paw kawbya mou abyapihua?” cite a khia.<note caller="-" style="x"><char style="xo" closed="false">12.28-34: </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">Luk 10.25-28</ref></char></note> <verse number="29" style="v" />Jesu nynh, “Kawbya balyn kyaze abyapi huapaw kawbya tuh: ‘Pou Israel, ngaetua; Bawipaw ah Pachia tuh ccangkheit kyalyapaw Bawipaw nynh thua.<note caller="-" style="x"><char style="xo" closed="false">12.29-30: </char><char style="xt" closed="false"><ref loc="DEU 6:4-5">Deu 6.4-5</ref></char></note> <verse number="30" style="v" />Bawipaw na Pachia kha na thinlung balyn te, na hiinnaw balyn te, na tuanaw balyn te, na thawzung balyn te na sungsah cih,’ cipaw hynh nynh athua. <verse number="31" style="v" />Ccangningnaw tuh: ‘Na innpaw kha namaw toulou hawte na sungsah cih,’ cipaw hynh nynh thua. E hae laeze abyapi huapaw kawbya ccangpaw um vae khyh,” a cipya.<note caller="-" style="x"><char style="xo" closed="false">12.31: </char><char style="xt" closed="false"><ref loc="LEV 19:18">Lev 19.18</ref></char></note> <verse number="32" style="v" />Kawbya sazaepaw nynh, “Sazae, na hopaw tuh akyh, byaccing nynh na ho, ‘Pachia tuh ccangkheit kyalya nynh a um; amaw laelan ccangpaw Pachia um vae khyh.’<note caller="-" style="x"><char style="xo" closed="false">12.32: </char><char style="xt" closed="false"><ref loc="DEU 4:35">Deu 4.35</ref></char></note> <verse number="33" style="v" />Pachia kha thinlung balyn te, hawnaw balyn te, thawzung balyn te sungsah lanpaw te ah innpaw kha ahmaw toulou hawte sungsah lanpaw tuh apynpi te maee-ute silawnaw hae te silawnawpaw balyn laeze abyapi huapaw nynh thua,” cite a hopya.<note caller="-" style="x"><char style="xo" closed="false">12.33: </char><char style="xt" closed="false"><ref loc="HOS 6:6">Hos 6.6</ref></char></note> <verse number="34" style="v" />Aning nynh hawrarih lante a khungpaw kha Jesu nynh he a muih tuh amaw kha, “Nang tuh Pachia peenaw te na sawkuh khyh,” a cipya. Tukoute Jesu kha hum nynh sanmah byakhia ngan vae khyh hae.</para>
  <para style="s1">Messiah tuh Hum Ccapaw Mou?</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mat 22.41-46</ref>; <ref loc="LUK 20:41-44">Luk 20.41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" />Jesu nynh beikinn kya a ccangpya lya hae ze a hopaw tuh, “Pawtemou kawbya sazae hae nynh, ‘Messiah tuh David Ccapaw nynh thua,’ cite a ho kho hae? <verse number="36" style="v" />David amaw ccaccei nynh Thyaa Muisaw liate ho zah,</para>
  <para style="q1">‘Bawipaw nynh ka Bawipaw kha,</para>
  <para style="q2">“Na rhaw hae kha na ccuphe kaw</para>
  <para style="q1">kae nung makhia hae nang tuh</para>
  <para style="q2">ka ranglang khe haung,” a cipya,’ a ci.<note caller="-" style="x"><char style="xo" closed="false">12.36: </char><char style="xt" closed="false"><ref loc="PSA 110:1">Sam 110.1</ref></char></note></para>
  <para style="m">
    <verse number="37" style="v" />Tukeiccuze David amaw ccaccei nynh Messiah kha ‘Bawipaw’ cite a ko lanze pawtemou aning tuh a ccapaw athua kho cih?” a ci. Ccungccaw zapi nynh a bya kha lungtuate a ngae hae.</para>
  <para style="s1">Kawbya Sazae hae Raeringnaw Pyanaw</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mat 23.1-36</ref>; <ref loc="LUK 20:45-47">Luk 20.45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" />A ccangpya lya hae khe Jesu nynh, “Kawbya sazae hae kha la raeringkuh oh. Minmin tuh boeining ccuabalaepaw lawkute innlaepae ry hae zah kungkunaw kya sawtuate byabeihku a ry hae; <verse number="39" style="v" />sinakok kya tungkhung ahoy huaccepaw ry hae zah poi kya ahoy huanaw khe a um ry hae; <verse number="40" style="v" />minmin tuh nomae hae inn kha luade hae zah ccungccaw hae nynh oun muih hae sah cite hynhsepi saw a sang hae; minmin tuh accih huapaw detahnaw kha a mue cih hae,” a ci.</para>
  <para style="s1">Nomaenung Lungsing</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luk 21.1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" />Jesu tuh sisua bawng te ahawiliakuh lante haung zah ccungccaw hae nynh sisua bawng lungkhu lang phua a sang hae paw kha a do; a hoirum hae paw patae nynh phua patae a sang hae. <verse number="42" style="v" />A ryachipaw nomaenung lu kheit nynh yn thua zah, pia haw loukaw aphupaw daw phuapia pia ning kha a sang. <verse number="43" style="v" />A zuitu hae kha ko hae zah, “Byaccaccing kae hopya oh, sisua bawng lungkhu lang a sangpaw ccungccaw hae balyn laeze e a ryachipaw nomaenung nynh alunghua a sang. <verse number="44" style="v" />Pawccecize minmin balyn tuh mih hoirumnaw patae kya-e kha a sang hae; thuasalama e nung tuh a ryachi pite a hiinnaw hanlan a hoipaw balyn kha marya a sang,” a cipya hae.</para>
  <chapter number="13" style="c" />
  <para style="s1">Athangnaw Kong Muihsahnaw</para>
  <para style="r">(<ref loc="MAT 24:1-28">Mat 24.1-28</ref>; <ref loc="LUK 21:5-24">Luk 21.5-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Jesu tuh beikinn kyate a toiku lyakhe a zuitu hae kya-e lukheitpaw nynh, “Sazae, dotua, e lung hae te inn hae nynh ale baban hynh!” a cipya. <verse number="2" style="v" />Jesu nynh, “E inn pipi hae hynh na muih khaw? Hein kyahin lung ccangkheit vawlan ccangkheit a khangthykuh lei lan ciate marya tingsah bung yn thua cih,” a cipya.</para>
  <para style="p">
    <verse number="3" style="v" />Jesu tuh Oliv Mua vawlan khe beikinn lang hawi zah a haung lyakhe Peter, James, Johan te Andru nynh mih makhaete, <verse number="4" style="v" />“E uccaw hae hynh hohtuhmou yn cyihkuh cih? E uccaw hae balyn yn ccing lan vae ze, paw muihsahnaw mou yn langkuh cih? Oun hopya tua,” cite a khia hae. <verse number="5" style="v" />Jesu nynh minmin kha, “Humhung nynh mah ae ling khyh nawlan oh la raeringkuh oh. <verse number="6" style="v" />Pawccecize ccungccaw patae nynh ka min te oun thua cih hae zah, ‘Kae tuh amaw nynh ka thua,’ oun ci cih hae zah ccungccaw patae kha oun ling cih hae. <verse number="7" style="v" />Rhawtukkunaw kong te rhawtho lanpaw kong kha na thae oh ze, nae bung la zou nan sah; tuhcihawpaw tuh oun cyihkuh cih, thuasalama athangnaw tuh thua loh khyh. <verse number="8" style="v" />Pawccecize minphuin phuin kheit te phuin kheit, ram kheit te ram kheit oun rhawkuh cih hae; ram takyh kya ccakan yn ccih cih zah innry yn suekuh cih. E hae tuh neitangia accih takawpaw hawte nynh thua.</para>
  <para style="p">
    <verse number="9" style="v" />“Thuasalama nanning tuh la raeringkuh oh; pawccecize minmin nynh nanning kha kungsi hae kalan ae ap cih oh; sinakok hae kya ae bua cih oh. Kae ka keiccuze uktu hae te siapharan hae malang na thadyn cih oh zah, minmin kyakhe ka ccaekia lang na tang cih oh.<note caller="-" style="x"><char style="xo" closed="false">13.9-11: </char><char style="xt" closed="false"><ref loc="MAT 10:17-20">Mat 10.17-20</ref>; <ref loc="LUK 12:11-12">Luk 12.11-12</ref></char></note> <verse number="10" style="v" />Thehoypaw hynh minphuin hae balyn kalan masaty hopya athua cih. <verse number="11" style="v" />Minmin nynh byapianaw kalan ae cciakhae oh zah ae ap vae oh ze, na ho lan oh paw kha nae thawsia nan sah; tuin ccyh kya ho lan na mue oh paw bya kha ho oh; pawccecize a hopaw tuh naemaw thua khyh, Thyaa Muisaw nynh thua. <verse number="12" style="v" />Uteno nynh mimaw te mimaw kha chinaw kalan yn apkuh cih hae; paaw nynh a ccaaw kha yn ap cih; ccaaw hae nynh nungpaaw hae kha oun rawse cih hae zah oun chisah cih hae. <verse number="13" style="v" />Ccungccaw balyn nynh nanning kha ka min keiccuze ae hua cih oh; thuasalama athangnaw cia a tynpaw tuh khum athua cih.<note caller="-" style="x"><char style="xo" closed="false">13.13: </char><char style="xt" closed="false"><ref loc="MAT 10:22">Mat 10.22</ref></char></note></para>
  <para style="p">
    <verse number="14" style="v" />“Thuasalama anungsikuhpaw uccaw nynh um lan accan leinaw hmin kya a thadynpaw kha he nae muih oh te (Baebu a riapaw ccungccaw tuh thaethya sah), Judea ram kya um hae paw nynh mua lang ccue hae sah.<note caller="-" style="x"><char style="xo" closed="false">13.14: </char><char style="xt" closed="false"><ref loc="DAN 9:27">Dan 9.27</ref>, <ref loc="DAN 11:31">11.31</ref>, <ref loc="DAN 12:11">12.11</ref></char></note> <verse number="15" style="v" />Inn tungvaw umpaw ccungccaw nynh a inn lungkhu e ccangkhakheit law khylan inn lungkhu lang rungbung nan vae sah lah tee nan vae sah.<note caller="-" style="x"><char style="xo" closed="false">13.15-16: </char><char style="xt" closed="false"><ref loc="LUK 17:31">Luk 17.31</ref></char></note> <verse number="16" style="v" />Loo kya a umpaw nynh a boeining lawku khylan ki nan vae sah. <verse number="17" style="v" />Tuin ccyh kya tuh ccaaw a poipaw nopi hae te matei zupaw nosi a hoipaw nopi hae hanlan ngaethya lan kou um! <verse number="18" style="v" />Tuh-e ccyh tuh khuaccih ccyh athua khyh nawlan saw la sang oh. <verse number="19" style="v" />Pawccecize Pachia nynh a raepaw raenaw athotakawnaw kyate atu ccyh cia a la um boi leipaw te nyalang mah a um vae cih leipaw teingnaw tuh tuin ccyh kya yn thua cih.<note caller="-" style="x"><char style="xo" closed="false">13.19: </char><char style="xt" closed="false"><ref loc="DAN 12:1">Dan 12.1</ref>; <ref loc="REV 7:14">Bya 7.14</ref></char></note> <verse number="20" style="v" />Bawipaw nynh tuh-e ccyh tuh a dynsah khyh lanze humhung mah lue lan khyh; thuasalama amaw nynh a popaw ccungccaw hae hanlan tuh-e ccyh tuh a dynsah cih. <verse number="21" style="v" />Tuin ccyh kyakhe lukhakheit nynh nanning kha, ‘Dotua! Messiah tuh hein kya nynh a um!’ Tuhkhyhze, ‘Dotua! Khuin kya nynh a um,’ ae cipya oh ze la zyn nan oh. <verse number="22" style="v" />Pawccecize lingthya messiah hae te lingthya profeh hae oun langkuh cih hae zah, athua kho ze popaw ccungccaw hae maw kha ling khylan muihsahnaw te ngaeangnaw hae kha oun langsakuh cih hae. <verse number="23" style="v" />Tukeiccuze la raeringkuh oh; pawpaw balyn kha pong kae hopya vae oh.</para>
  <para style="s1">Ccungccaw Ccapaw Rungnaw</para>
  <para style="r">(<ref loc="MAT 24:29-31">Mat 24.29-31</ref>; <ref loc="LUK 21:25-28">Luk 21.25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" />“Tuh-e vawsawnaw koute,</para>
  <para style="q2">tuin ccyh kya khuanin tuh</para>
  <para style="q1">yn moh cih zah sawpaw mah</para>
  <para style="q2">aw vae lan khyh.<note caller="-" style="x"><char style="xo" closed="false">13.24: </char><char style="xt" closed="false"><ref loc="ISA 13:10">Isa 13.10</ref>; <ref loc="EZK 32:7">Eze 32.7</ref>; <ref loc="JOL 2:10">Joe 2.10</ref>, <ref loc="JOL 2:31">31</ref>, <ref loc="JOL 3:15">3.15</ref>; <ref loc="REV 6:12">Bya 6.12</ref></char></note></para>
  <para style="q1">
    <verse number="25" style="v" />Vaawlang e awsi hae tuh</para>
  <para style="q2">oun ccah cih hae zah</para>
  <para style="q1">vaawlang e huhan balyn tuh</para>
  <para style="q2">yn hy cih.<note caller="-" style="x"><char style="xo" closed="false">13.25: </char><char style="xt" closed="false"><ref loc="ISA 34:4">Isa 34.4</ref>; <ref loc="JOL 2:10">Joe 2.10</ref>; <ref loc="REV 6:13">Bya 6.13</ref></char></note></para>
  <para style="m">
    <verse number="26" style="v" />Ccungccaw Ccapaw tuh alesaepaw huhan te phu-enaw ryte maeking kyate yn rungpaw kha oun muih cih hae.<note caller="-" style="x"><char style="xo" closed="false">13.26: </char><char style="xt" closed="false"><ref loc="DAN 7:13">Dan 7.13</ref>; <ref loc="REV 1:7">Bya 1.7</ref></char></note> <verse number="27" style="v" />Aning nynh a vaaw hae kha a saw cih hae zah a popaw ccungccaw hae kha laephi adianaw kyate vaawlang adianaw kyacia, laephi ki kipali kyate oun suelua cih hae.</para>
  <para style="s1">Thaeku Ku Tousenaw</para>
  <para style="r">(<ref loc="MAT 24:32-35">Mat 24.32-35</ref>; <ref loc="LUK 21:29-33">Luk 21.29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" />“Thaeku ku kya-e tousenaw phungpaw hynh atu ccangku tua oh; aran tuh notazyh lan yn cih zah anaw he yn toih tuh hawnin anae vae cipaw na ny oh. <verse number="29" style="v" />Tuhawte nanning nynh e uccaw hae hynh he nae muih vae oh ze Ccungccaw Ccapaw yn thua lanpaw tuh anae vae, thuakaw kin cia yn naekuh vae cipaw la nyh ccavae oh. <verse number="30" style="v" />Byaccaccing kae hopya oh, e uccaw hae balyn acyiku kou makhia atu she e ccungccaw hae hynh zo lan khyh hae. <verse number="31" style="v" />Vaaw te laephi tuh azo cih, thuasalama ka bya tuh zo lan khyh.</para>
  <para style="s1">Nin te Ccyh Nyh khyh hae</para>
  <para style="r">(<ref loc="MAT 24:36-44">Mat 24.36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" />“Thuasalama tuh-e nin te ccyh tuh hum nynh sanmah nyh khyh, vaawlang umpaw vaaw hae te Ccapaw nynh mah nyh khyh hae, Paaw rou nynh a nyh.<note caller="-" style="x"><char style="xo" closed="false">13.32: </char><char style="xt" closed="false"><ref loc="MAT 24:36">Mat 24.36</ref></char></note> <verse number="33" style="v" />Accyh tuh hohtuh cipaw na ny khyh oh keiccuze raeringkuh oh lah paccynkute la um oh. <verse number="34" style="v" />Pawtemou aloku ci ze, khuaccong lan a cceihpaw ccungccapaw nynh a inn kha cciataw zah a see hae kha mih ryalaw raveih law lan pyasya hae zah thuakaw ngawtupaw kha thuakaw ngaw lan kaw a pyapaw te nynh aloku.<note caller="-" style="x"><char style="xo" closed="false">13.34: </char><char style="xt" closed="false"><ref loc="LUK 12:36-38">Luk 12.36-38</ref></char></note> <verse number="35" style="v" />Tukeiccuze inn hoitupaw tuh zete ccyh tou, ziraccyng tou, awhykhua ccyh tou, khuadaetakaw tou, hohtuh ccyh nynh yn thua cih cipaw na ny khyh oh keiccuze raeringkute la ngaw oh. <verse number="36" style="v" />Aning tuh tualeipite mang yn thua cih zah na i oh paw kha ae muihsei cih oh. <verse number="37" style="v" />Kae hopya oh paw hynh ccungccaw balyn kha ka hopya hae, raeringkute la ngaw oh!” a ci.</para>
  <chapter number="14" style="c" />
  <para style="s1">Jesu Chia lan Pheenaw</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mat 26.1-5</ref>; <ref loc="LUK 22:1-6">Luk 22.1-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Kawtaw Poi te Ransi phing leipaw Sanlou Poi tua nawlan nin ning nynh a ry vae. Ranpibawi lepaw hae te kawbya sazae hae nynh Jesu kyngnaw lanpaw te chianaw lanpaw laanpi kha aruh lante a ccung hae.<note caller="-" style="x"><char style="xo" closed="false">14.1: </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">Exo 12.1-27</ref></char></note> <verse number="2" style="v" />Thuasalama minmin nynh, “Poi lya tuh thua nan sah, tuhkhyhze tuh ccungccaw hae pong oun pokuh sei cih hae,” a ci hae.</para>
  <para style="s1">Bethani kya Zimuin Thuh hae</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mat 26.6-13</ref>; <ref loc="JHN 12:1-8">Joh 12.1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" />Jesu tuh Bethani khua kya vaethya a kaepaw Simon inn kya haung zah a ae lyakhe, nopinung lu kheit nynh myarya amee rupaw zimuin alabasta lung rawpaw bu kheit kha yn ccyng zah abu kha koi zah Jesu lu kha a bu.<note caller="-" style="x"><char style="xo" closed="false">14.3: </char><char style="xt" closed="false"><ref loc="LUK 7:37-38">Luk 7.37-38</ref></char></note> <verse number="4" style="v" />Minmin laku e ccungccaw abang tuh mih thinria zah, “Pawccemou e zimuin hynh alakaw lan a tangsah han? <verse number="5" style="v" />Pawccecize denari phua za thum lae lang zua lan zah ryachi hae pya lanze ahoypaw,” cite hokuh hae zah tuh-e nung kha a seisah hae. <verse number="6" style="v" />Jesu nynh, “Khah-e nung kha amaw um lan um sah, pawccemou vawsaw na pya oh? Aning nynh ka tungvaw kya ahoypaw rya kha a law vae. <verse number="7" style="v" />Pawccecize ryachi hae tuh nae kya zungzae a um hae, na ry takyh oh te mih tungvaw hoynaw na rae kho oh; thuasalama kae tuh nae kya zungzae ka um lan khyh.<note caller="-" style="x"><char style="xo" closed="false">14.7: </char><char style="xt" closed="false"><ref loc="DEU 15:11">Deu 15.11</ref></char></note> <verse number="8" style="v" />Aning nynh a cyi khopaw kha a cyi vae; aning tuh ka rhua ccynaw hanlan ka pyn hynh zimuin yn thuh ty vae. <verse number="9" style="v" />Byaccaccing kae hopya oh, laephi pynpi kya thehoypaw honaw miakaw kya hynh-e nopinung nynh a cyipaw hynh mah amaw liathui nawlan a la hobia cih hae,” a cipya hae.</para>
  <para style="s1">Judas nynh A Nawccaw</para>
  <para style="r">(<ref loc="MAT 26:14-16">Mat 26.14-16</ref>; <ref loc="LUK 22:3-6">Luk 22.3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" />Lu haw lae ning lakuze lu kheit athuapaw Judas Iskariot tuh Jesu kha ap khylan ranpibawi lepaw hae kalan a cceih. <verse number="11" style="v" />Tuh-e tuh he a thae hae te, myarya mih lungtua zah phua pya lante bya a kinpyaku hae. Tukeiccuze Judas nynh Jesu pheethyanaw ccyhhoy kha palei a ccung vae.</para>
  <para style="s1">Kawtaw Poi Zerya Mangkheihnaw</para>
  <para style="r">(<ref loc="MAT 26:17-25">Mat 26.17-25</ref>; Luk 22.7-14, 21-23; <ref loc="JHN 13:21-30">Joh 13.21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" />Ransi phing leipaw Sanlou Poi masaty nin, Kawtaw Poi elang tuutaw te si a law nin hae khe, a zuitu hae nynh Jesu kha, “Kawtaw Poi zerya na mang nawlan kae la cceih cih zah pawkyamou paccyn hae sah ci nae ry?” cite a khia hae. <verse number="13" style="v" />Jesu nynh a zuitu hae lu ning kha saw hae zah, “Khua lungkhu lang la cceih oh lah dawre te tui yn thepaw ccungccapaw kha na la tungkuh cih oh; amaw kha la zui oh; <verse number="14" style="v" />a teenaw e inn hoitupaw kha, ‘Sazaepaw nynh, “Ka zuitu hae ryte Kawtaw Poi zerya kae mangnaw lanpaw mikhia khaan tuh pawkyamou a um?” a ci,’ cite la hopah oh. <verse number="15" style="v" />Te aning nynh a paccyn ty vae paw, akopaw palung khaan kha ae la muihsah cih oh; tuin kyakhe aening hanlan la paccyn oh,” cite a hopya hae. <verse number="16" style="v" />A zuitu hae tuh cceih hae zah khuapi lungkhu a thua hae; Jesu nynh a hopya hae hawte a muih hae; te minmin nynh Kawtaw Poi zerya kha a paccyn hae.</para>
  <para style="p">
    <verse number="17" style="v" />Zetesang khe Jesu tuh zuitu lu haw lae ning ryte oun thua hae. <verse number="18" style="v" />Minmin tuh haung hae zah a ae lya hae khe Jesu nynh, “Byaccaccing kae hopya oh, kamaw te kae aekheihpaw nanning laku e lu kheit nynh kae hynh yn phee cih,” a ci.<note caller="-" style="x"><char style="xo" closed="false">14.18: </char><char style="xt" closed="false"><ref loc="PSA 41:9">Sam 41.9</ref></char></note> <verse number="19" style="v" />Zuitu hae tuh mih ngaethah zah, “Kae ka thua khyh khaw?” cite lu kheit koute lu kheit nynh a khia hae. <verse number="20" style="v" />Jesu nynh khung hae zah, “Tuh-e paw tuh lu haw lae ning lakuze lu kheit, kamaw te pake kae pukheihpaw nynh thua. <verse number="21" style="v" />Ccathyaa kya amaw kong azeiku thyhte Ccungccaw Ccapaw tuh a chih cih; thuasalama Ccungccaw Ccapaw a pheetupaw hanlan ngaethya lan kou um! A la pui khyh ze amaw hanlan ahoyhua cih paw,” a cipya hae.</para>
  <para style="s">Bawipaw Zerya</para>
  <para style="r">(<ref loc="MAT 26:26-30">Mat 26.26-30</ref>; <ref loc="LUK 22:14-20">Luk 22.14-20</ref>; <ref loc="1CO 11:23-25">1Ko 11.23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" />Zerya a mang lya hae khe Jesu nynh sanlou kha lah zah lungtuabya a ho koute eih zah minmin kha a pya hae; te, “Lawkuh oh; e tuh ka pyn nynh thua,” a cipya hae. <verse number="23" style="v" />Tukoute banang kha lah zah lungtuabya a ho koute minmin kha pya hae zah mih balynte a neih hae. <verse number="24" style="v" />Jesu nynh, “E tuh ccungccaw patae hanlan ka laepaw ka chiise, Pachia byakinnaw a tynsahpaw nynh thua.<note caller="-" style="x"><char style="xo" closed="false">14.24: </char><char style="xt" closed="false"><ref loc="EXO 24:8">Exo 24.8</ref>; <ref loc="JER 31:31-34">Jer 31.31-34</ref></char></note> <verse number="25" style="v" />Byaccaccing kae hopya oh, Pachia peenaw kya misutui thawpaw ka nia mawlaezung hynh-e misutui hynh ka neih boi vae lan khyh,” a cipya hae.</para>
  <para style="s1">Peter nynh A Vua lanpaw A Hoty</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mat 26.31-35</ref>; <ref loc="LUK 22:31-34">Luk 22.31-34</ref>; <ref loc="JHN 13:36-38">Joh 13.36-38</ref>)</para>
  <para style="p">
    <verse number="26" style="v" />Hlaw hlakheit a sah kou hae te Oliv Mua lang a cceih hae. <verse number="27" style="v" />Jesu nynh minmin kha, “Nae balynte nae ccuetaw cih oh; pawccecize Ccathyaa kya,</para>
  <para style="q1">‘Tuurinpaw kha ka bua cih zah</para>
  <para style="q2">tuu hae tuh oun phiakuh cih hae,’</para>
  <para style="m">cite azeikuh.<note caller="-" style="x"><char style="xo" closed="false">14.27: </char><char style="xt" closed="false"><ref loc="ZEC 13:7">Zek 13.7</ref></char></note> <verse number="28" style="v" />Thuasalama ka thoothui koute, nae malang Galilee lang ka la cceih ty cih,” a cipya hae.<note caller="-" style="x"><char style="xo" closed="false">14.28: </char><char style="xt" closed="false"><ref loc="MAT 28:16">Mat 28.16</ref></char></note> <verse number="29" style="v" />Peter nynh, “Ming hae balyn nynh ae ccuetaw hae zemah kae tuh kae ccuetaw lan khyh,” a cipya. <verse number="30" style="v" />Jesu nynh Peter kha, “Byaccaccing kae hopya, atunin, atu khuazi kya aw vae ning a khua mawze vae thum nae vua cih,” a cipya. <verse number="31" style="v" />Thuasalama Peter nynh houh ccih lante, “Namaw ryte chikheih lan accan zemah kae vua lan khyh,” a ci. Zuitu hae balyn nynh tuhcite a ho kalang hae.</para>
  <para style="s1">Gethsemane kya Jesu Sawsang</para>
  <para style="r">(<ref loc="MAT 26:36-46">Mat 26.36-46</ref>; <ref loc="LUK 22:39-46">Luk 22.39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" />Gethsemane a cinaw hae hmin kya thua hae zah, Jesu nynh a zuitu hae kha, “Saw ka sang loukaw hein kya la um oh,” a cipya hae. <verse number="33" style="v" />Peter, James te Johan kha a hoeibua hae; a lungvawsaw zah myarya a lungriathae vae. <verse number="34" style="v" />Minmin kha, “Chikhaeku lan ciate myaryamaw ka lungriathae; hein kya la um oh lah la ngaw oh,” a cipya hae. <verse number="35" style="v" />Takyh asawnaw lang a cceih koute laekhu kya bakhung zah, athua kho ze tuh-e accyh tuh amaw kyate alia nawlan saw a sang. <verse number="36" style="v" />“Apang, ka Paaw, nang na hanlan tuh pawpaw balyn marya athua kho; e banang hynh ka kyate beih yn lawpah; tuhzemah kae ka ry hawte thua nan sah, na ry hawte thua sah,” a ci. <verse number="37" style="v" />Te yn thua zah minmin a ih hae paw kha a muih; Peter kha, “Simon, na ih tou? Suimilan ccangkheit san na ngaw kho khyh tou? <verse number="38" style="v" />Tounaw lungkhu lang na ccawsei khyh nawlan oh sawsang oh lah ngaw oh. Thinlung nynh tuh ry salamah pynsaw tuh a thawzya,” a cipya. <verse number="39" style="v" />Jesu tuh bua cceih zah a homae hawte saw bua a sang. <verse number="40" style="v" />Bua yn ki zah minmin a ih hae paw kha a muih; mih mit tuh daekuh vae khyh; pawtemou khung lan cipaw san nyh vae khyh hae. <verse number="41" style="v" />Vae thumnaw bua thua zah minmin kha, “Palei na ih ung oh tou? Na haeung ung oh ii? Azaw vae! Accyh yn thua vae. Dotua oh, Ccungccaw Ccapaw tuh misei hae kuih kalan pya athua vae. <verse number="42" style="v" />Tho oh, cceih ccavae oh sih. Dotua oh, kae yn pheetupaw tuh yn thua vae,” a cipya hae.</para>
  <para style="s1">Jesu Kyngnaw</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mat 26.47-56</ref>; <ref loc="LUK 22:47-53">Luk 22.47-53</ref>; <ref loc="JHN 18:3-12">Joh 18.3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" />Tuhte a ho cciamang lyakhe lu haw lae ning kyaze lu kheit athuapaw Judas tuh ranpibawi lepaw hae, kawbya sazae hae te piccan hae nynh oun saw hae paw ccungccaw zapi ryte, thaloi hae te tungbang hae ccyngkute vaekheihmawte oun thua vae hae. <verse number="44" style="v" />A pheetupaw nynh minmin kha syntawnaw la pyaty hae zah, “Kae nynh kae myngpaw tuh na kyng ry oh paw ccungccapaw nynh thua; amaw kha kyng oh lah khyndadyh lan cciakhae oh,” a cipya hae. <verse number="45" style="v" />Judas nynh he yn thua takaw te Jesu kalan palou cceih zah, “Sazae!” ci zah a myng. <verse number="46" style="v" />Te minmin nynh Jesu kha kyng hae zah a khii hae. <verse number="47" style="v" />A pe a thadynpaw lu kheit nynh thaloi kha thuaakuh zah ranpibawi lupi a seepaw kha a nakua thoh pae lan a bae. <verse number="48" style="v" />Jesu nynh, “Kae hynh miruh hawte kyng khylan thaloi te tungbang te nae ccianua oh tou? <verse number="49" style="v" />Nin takyhte beikinn kya nanning ryte ka um zah kae ccangpya lya oh ze nae kyng khyh oh; thuasalama Ccathyaa tuh ccing sah,” a cipya hae.<note caller="-" style="x"><char style="xo" closed="false">14.49: </char><char style="xt" closed="false"><ref loc="LUK 19:47">Luk 19.47</ref>, <ref loc="LUK 21:37">21.37</ref></char></note> <verse number="50" style="v" />Zuitu hae balyn nynh amaw kha cciataw hae zah a ccuetaw vae hae.</para>
  <para style="p">
    <verse number="51" style="v" />Boei zung kheit kyalya a zingkuhpaw ccangvaepaw nynh Jesu kha a zui; minmin nynh tuh-e paw tuh a kyng hae; <verse number="52" style="v" />aning nynh boei kha ccuetaw zah a sasete po a ccue.</para>
  <para style="s1">Ranpibawi Lupi malang Jesu</para>
  <para style="r">(<ref loc="MAT 26:57-68">Mat 26.57-68</ref>; Luk 22.54-55, 63-71; Joh 18.13-14, 19-24)</para>
  <para style="p">
    <verse number="53" style="v" />Tetuh minmin nynh Jesu kha ranpibawi lupi kalan a cciakhae hae; tuin kyakhe ranpibawi lepaw hae balyn, piccan hae te kawbya sazae hae tuh a la pumkuh hae. <verse number="54" style="v" />Peter nynh Jesu kha ranpibawi lupi maepaw kyacia asawnaw te a zui; te aning tuh rhawvia hae kyakhe haungbua zah maee a ekuh bua. <verse number="55" style="v" />Ranpibawi lepaw hae te kungsi hae balyn nynh Jesu kha chia khylan ccaekia kha a ccungnua hae; thuasalama muih khyh hae. <verse number="56" style="v" />Pawccecize ccungccaw patae nynh ahme leipaw ccaekia kha a khan hae, thuasalama mih ccaekia hae tuh lokuh khyh hae. <verse number="57" style="v" />Ccungccaw abang nynh thadyn hae zah ahme leipaw ccaekia kha hynhte a khan hae: <verse number="58" style="v" />“E paw nynh, ‘Kuih te sakpaw e beikinn hynh ka roh cih zah kuih te sak leipaw ccangpaw beikinn kha nin thum lungkhu ka sak cih,’ cite a hopaw kae thae,” a ci hae.<note caller="-" style="x"><char style="xo" closed="false">14.58: </char><char style="xt" closed="false"><ref loc="JHN 2:19">Joh 2.19</ref></char></note> <verse number="59" style="v" />Thuasalama mih ccaekia tuh lokuh khyh. <verse number="60" style="v" />Te ranpibawi lupi nynh mih malang khe thadyn zah Jesu kha, “Kaw kheit san na khung khyh hae rei? Ccaekia ae khannua hae paw hynh pawtemou athua?” cite a khia. <verse number="61" style="v" />Thuasalama aning nynh yccae khyh, kaw kheit san khung khyh. Tuinte ranpibawi lupi nynh, “Alesaepaw Pachia Ccapaw, Messiah na thua tou?” cite bua a khia. <verse number="62" style="v" />Jesu nynh, “Ka thua; te</para>
  <para style="q1">nanning nynh Ccungccaw Ccapaw tuh</para>
  <para style="q2">Alesaepaw ranglang kya</para>
  <para style="q1">a haungpaw te</para>
  <para style="q2">vaawlang e maeking kyate</para>
  <para style="q1">yn rungpaw kha nae muih cih oh,” a ci.<note caller="-" style="x"><char style="xo" closed="false">14.62: </char><char style="xt" closed="false"><ref loc="DAN 7:13">Dan 7.13</ref></char></note></para>
  <para style="m">
    <verse number="63" style="v" />Tetuh ranpibawi lupi nynh a boeining kha seii zah, “Ccangpaw paw ccaekia mou aho ung? <verse number="64" style="v" />Pachia saryanaw bya a hopaw kha phe na thae vae oh! Pawte na tua oh?” cite a khia hae. Minmin balyn nynh aning tuh chi lan accan cite sei a be hae.<note caller="-" style="x"><char style="xo" closed="false">14.64: </char><char style="xt" closed="false"><ref loc="LEV 24:16">Lev 24.16</ref></char></note> <verse number="65" style="v" />Ccungccaw abang nynh Jesu kha mih tuing te a thoi hae, a mae kha phang bong hae zah a thung hae, te “Profehbya hotua!” a ci hae. Rhawviatu hae nynh mah cciakhae hae zah a bia hae.</para>
  <para style="s1">Peter nynh Jesu A Vua</para>
  <para style="r">(<ref loc="MAT 26:69-75">Mat 26.69-75</ref>; <ref loc="LUK 22:56-62">Luk 22.56-62</ref>; Joh 18.15-18, 25-27)</para>
  <para style="p">
    <verse number="66" style="v" />Peter tuh inn voidu akawlan sang a um lyakhe ranpibawi lupi rya a lawpatunung lu kheit nynh yn thua zah, <verse number="67" style="v" />maee a ekuhpaw Peter kha he a muih tuh, amaw kha riri do zah, “Nang hynh mah Nazareth paw Jesu ryte na umkheih oh paw nynh na thua,” a cipya. <verse number="68" style="v" />Thuasalama Peter nynh pheikuh zah, “Na hopaw tuh ka nyh khyh, thae mah ka thaethya khyh,” a cipya. Peter tuh sakoih pe lang po a cceih; te aw yn khua. <verse number="69" style="v" />Ryalawpatu nopinung nynh Peter kha bua muih zah, tuin pe a thadyn hae paw kyakhe, “E paw hynh minmin kyaze lu kheit nynh athuabua,” a cipya hae. <verse number="70" style="v" />Thuasalama Peter nynh bua a pheiku. Khuekheit cih koute tuin a thadyn hae paw nynh Peter kha, “Thanccingte nang tuh minmin kyaze lu kheit nynh na thua; pawccecize nang tuh Galilee paw nynh na thua,” a ci hae. <verse number="71" style="v" />Thuasalama Peter nynh, “Na ho oh paw ccungccapaw tuh ka nyh khyh,” cite thyalawkuh zah bya a kinku. <verse number="72" style="v" />Tuh ccyh lyakhe vae ningnaw aw ccahe yn khua. Tetuh, “Awkhungpaw vae ning a khua mawze, vae thum nae vua cih,” cite Jesu nynh a hopyapaw bya kha Peter nynh liathui zah thawte a rah.</para>
  <chapter number="15" style="c" />
  <para style="s1">Pilat malang Jesu</para>
  <para style="r">(Mat 27.1-2, 11-14; <ref loc="LUK 23:1-5">Luk 23.1-5</ref>; <ref loc="JHN 18:28-38">Joh 18.28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Awkhua takaw khe ranpibawi lepaw hae tuh piccan hae, kawbya sazae hae te kungsi hae balyn ryte arangte khua a khankuh hae; Jesu kha a he kou hae te cciakhae hae zah Pilat kuih kya a pya hae. <verse number="2" style="v" />Pilat nynh, “Nang hynh Judah hae Siapharan na thua tou?” cite a khia. Jesu nynh, “Na ho hawte nynh thua,” cite a khung. <verse number="3" style="v" />Ranpibawi lepaw hae nynh Jesu kha patae sei a be hae. <verse number="4" style="v" />Pilat nynh, “Kaw kheit san na khung khyh hae rei? Sei ae benaw hae paw hynh hohcihmou alung cipaw dotua!” cite bua a khia. <verse number="5" style="v" />Thuasalama Jesu nynh kaw kheit san bua khung khyh, tukeiccuze Pilat tuh a ngaeangthua.</para>
  <para style="s1">Jesu Chia lan Byapae hae</para>
  <para style="r">(<ref loc="MAT 27:15-26">Mat 27.15-26</ref>; <ref loc="LUK 23:13-25">Luk 23.13-25</ref>)</para>
  <para style="p">
    <verse number="6" style="v" />Kawtaw Poi kya ccungccaw hae nynh a ngia hae paw thongccahpaw lu kheit kha Pilat nynh leih a luesah. <verse number="7" style="v" />Rhawthonaw kya ccungccaw theihtu Barabbas a ci hae paw tuh ccangpaw rhawthotu hae ryte thong a ccahkheih hae. <verse number="8" style="v" />Ccungccaw zapi tuh oun thua hae zah mimaw elang leih a cyipya hae hawte oun cyipya ccaw cite Pilat kha a ngia hae. <verse number="9" style="v" />Pilat nynh, “Judah hae Siapharan hynh nae hanlan kae luesahpya oh ze na ry oh tou?” cite a khia hae. <verse number="10" style="v" />Pawccecize, ranpibawi lepaw hae nynh mih eiung keiccu nynh Jesu kha a ap hae cipaw Pilat nynh phe a ny. <verse number="11" style="v" />Thuasalama Pilat nynh Barabbas kha minmin hanlan a luesah nawlan ranpibawi lepaw hae nynh ccungccaw zapi kha a tou hae. <verse number="12" style="v" />Pilat nynh, “Tuhte athua ze, Judah hae Siapharan na ci oh paw hynh so pawtemou nae cyisah ry oh?” cite bua a khia hae. <verse number="13" style="v" />Minmin nynh, “Amaw kha vaelantung kya khiade!” cite bua a sia hae. <verse number="14" style="v" />Pilat nynh, “Pawccemou? Aning nynh paw seinaw mou a rae?” cite a khia hae. Minmin nynh, “Amaw kha vaelantung kya khiade!” cite houh a sia hae. <verse number="15" style="v" />Pilat nynh ccungccaw zapi kha lunghoysah a ry keiccuze Barabbas kha a sawpya hae; te Jesu kha buasah hae zah vaelantung kya khiade lan a pya hae.</para>
  <para style="s1">Rhawkaw hae nynh A Sarya hae</para>
  <para style="r">(<ref loc="MAT 27:27-31">Mat 27.27-31</ref>; <ref loc="JHN 19:2-3">Joh 19.2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" />Rhawkaw hae nynh Jesu kha uktu bawi maepaw langkhe teekhae hae zah rhawkawphu phu kheit kha abalynte a kobua hae. <verse number="17" style="v" />Minmin nynh sekakungpaw boeining kha a zingsaku hae, hinpaw kha lukhung lang khepah hae zah a lu vawlan a khungsah hae. <verse number="18" style="v" />Tuinte salaam pya hae zah, “Judah hae Siapharan tuh a she sae vae sah!” a ci hae. <verse number="19" style="v" />A lu kha phaeku te bua hae zah mih tuing te a thoi hae, te mih ccukharutung hae zah a bakhungpya hae. <verse number="20" style="v" />Jesu kha a sarya kou hae te boei sepaw kha khah hae zah amaw a boeining kha bua a lawsahku hae, te vaelantung kya khiade lan a cciakhae hae.</para>
  <para style="s1">Vaelantung kya Khiadenaw</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mat 27.32-44</ref>; <ref loc="LUK 23:26-43">Luk 23.26-43</ref>; <ref loc="JHN 19:17-27">Joh 19.17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" />Alexanda te Rufas mih paaw Simon, Sairin khuapaw tuh khua taraw langte yn cceih zah, minmin nynh amaw kha Jesu vaelantung kha puih lan a nangse hae.<note caller="-" style="x"><char style="xo" closed="false">15.21: </char><char style="xt" closed="false"><ref loc="ROM 16:13">Rom 16.13</ref></char></note> <verse number="22" style="v" />Jesu kha Golgotha a ci hae paw hmin langkhe a cciakhae hae (Golgotha cipaw tuh Luru Hmin cipaw nynh thua). <verse number="23" style="v" />Jesu tuh mura te apykuhpaw misutui kha a pya hae; thuasalama Jesu nynh neih khyh. <verse number="24" style="v" />Tukoute vaelantung kya khiade hae zah a boeining hae kha ccungthydungte ccarou a neeku hae.<note caller="-" style="x"><char style="xo" closed="false">15.24: </char><char style="xt" closed="false"><ref loc="PSA 22:18">Sam 22.18</ref></char></note></para>
  <para style="p">
    <verse number="25" style="v" />Awkhua suimilan ccangtakua ccyh khe Jesu kha vaelantung kya a khiade hae. <verse number="26" style="v" />A seisahnaw hae paw ccawkhia tuh: “Judah hae Siapharan,” cite a zei hae. <verse number="27" style="v" />Damiah hae lu ning kha Jesu ryte a ranglang lu kheit, a voilang lu kheit vaelantung kya a khiade bua hae. <verse number="28" style="v" />Tuhcite Ccathyaa kya, “Aning tuh misei hae ryte riakheih athua,” a cipaw kha accing.<note caller="-" style="x"><char style="xo" closed="false">15.28: </char><char style="xt" closed="false"><ref loc="ISA 53:12">Isa 53.12</ref></char></note> <verse number="29" style="v" />Laanpi kya a cceih bungthung hae paw nynh mih lu thuhpah hae zah, “Alei! Beikinn kha roh zah nin thum lungkhu a sakthuipaw nang,<note caller="-" style="x"><char style="xo" closed="false">15.29: </char><char style="xt" closed="false"><ref loc="PSA 22:7">Sam 22.7</ref>, <ref loc="PSA 109:25">109.25</ref>; <ref loc="MRK 14:58">Mar 14.58</ref>; <ref loc="JHN 2:19">Joh 2.19</ref></char></note> <verse number="30" style="v" />namaw te namaw kha khumkuh lah vaelantung kyate yn rungtua!” cite a sarya hae. <verse number="31" style="v" />Tuhawte ranpibawi lepaw hae te kawbya sazae hae nynh mah, “Aning nynh ming hae ze khum hae zah amaw ze khumkuh kho khyh. <verse number="32" style="v" />Kaening nynh kae muih zah kae zyn nawlan, Israel Siapharan, Messiah tuh atu vaelantung kyate yn rungtua sah!” cite sarya hae zah a hoku hae. Jesu ryte vaelantung kya a khiadekheih hae paw nynh mah a saryabua hae.</para>
  <para style="s1">Jesu A Chih</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mat 27.45-56</ref>; <ref loc="LUK 23:44-49">Luk 23.44-49</ref>; <ref loc="JHN 19:28-30">Joh 19.28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" />Ninthuccynglyn kyate zete suimilan ccangthum cia ram balyn tuh pong amoh. <verse number="34" style="v" />Zete suimilan ccangthum ccyh kyakhe Jesu nynh, “Eloi, Eloi, lama sabakthani?” cite thawte a sia. Asuilan tuh, “Ka Pachia, ka Pachia, pawccemou nae vua?” cipaw nynh thua.<note caller="-" style="x"><char style="xo" closed="false">15.34: </char><char style="xt" closed="false"><ref loc="PSA 22:1">Sam 22.1</ref></char></note> <verse number="35" style="v" />A pe a thadyn hae paw abang nynh thae hae zah, “Ngaetua oh, aning nynh Elijah nynh a ko,” a ci hae. <verse number="36" style="v" />Lukheitpaw nynh ccue zah boeipuepaw kha misutui ariapaw kya dung zah ccungngue dung kya a heede koute nia lan pya zah, “Umtua hin; vaelantung kyate sawbung khylan Elijah yn thua ta, do hin oh sih!” a ci.<note caller="-" style="x"><char style="xo" closed="false">15.36: </char><char style="xt" closed="false"><ref loc="PSA 69:21">Sam 69.21</ref></char></note> <verse number="37" style="v" />Jesu tuh thawte sia zah a hy athang. <verse number="38" style="v" />Beikinn lungkhu a zo hae paw boei tuh alu te alia cia zung ning lang aseiikuh.<note caller="-" style="x"><char style="xo" closed="false">15.38: </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">Exo 26.31-33</ref></char></note> <verse number="39" style="v" />Jesu malang a thadynpaw rhawbawipaw nynh tuhcite Jesu a hy athangpaw kha he a muih tuh, “E paw tuh Pachia Ccapaw ccaccing nynh thua!” a ci.</para>
  <para style="p">
    <verse number="40" style="v" />Asawnaw te a do hae paw nopi hae mah a um hae; tuh-e hae kyatuin Mary Magdalin, adih huapaw James te Joses mih nung Mary te Salomi mah a umbua hae.<note caller="-" style="x"><char style="xo" closed="false">15.40-41: </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">Luk 8.2-3</ref></char></note> <verse number="41" style="v" />E hae tuh Galilee ram kya Jesu a um lyaze a zui hae paw te a bawm hae paw nynh thua hae, Jesu ryte Jerusalem lang oun cceihkheih hae paw ccangpaw nopi hae patae mah tuin kya a umbua hae.</para>
  <para style="s1">Jesu Rhua Ccynaw</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mat 27.57-61</ref>; <ref loc="LUK 23:50-56">Luk 23.50-56</ref>; <ref loc="JHN 19:38-42">Joh 19.38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" />Tuin nin tuh sabbath nin athua maw Paccynku nin athua keiccuze zetesang khe <verse number="43" style="v" />Arimathea khuapaw Josef tuh yn thua; aning tuh sawtua lan umpaw kungsi memba lu kheit thua zah Pachia peenaw kha a ngaehoi buapaw nynh thua, Josef nynh rawthungte Pilat kalan tee zah Jesu rhua kha a ngia. <verse number="44" style="v" />Pilat nynh Jesu a chih vae cipaw a thae tuh, a ngaeangthua zah rhawbawipaw kha ko zah, “Jesu a chinaw saw vae tou?” cite a khia. <verse number="45" style="v" />Rhawbawipaw bya he a thae te, Pilat nynh Jesu rhua kha Josef a pya. <verse number="46" style="v" />Josef nynh nebaleihpaw boei rawpaw kha re zah a rhua kha vaelantung kyate sahbung zah nebaleihpaw boei rawpaw khate a lung. Lung a karyn hae paw shaw kyakhe a ccy, athuhfu lang lungphepi kha tounua zah a husung. <verse number="47" style="v" />Mary Magdalin te Joses a nung Mary nynh a rhua a ccynaw hae kha a muih hae.</para>
  <chapter number="16" style="c" />
  <para style="s1">Jesu Thoothuinaw</para>
  <para style="r">(<ref loc="MAT 28:1-9">Mat 28.1-9</ref>; <ref loc="LUK 24:1-12">Luk 24.1-12</ref>; <ref loc="JHN 20:1-10">Joh 20.1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" />Sabbath nin koute Mary Magdalin, James a nung Mary te Salomi nynh cceih hae zah a rhua thuh lanpaw zimuin kha a re hae. <verse number="2" style="v" />Lonaw naw kheit kyaze masaty nin awkhua takaw khuanin a thua khe minmin tuh shawku lang a cceih hae. <verse number="3" style="v" />Minmin nynh, “Shaw athuhfu lung pipi kha hum nynh mou oun nuepah cih?” cite a hoku hae. <verse number="4" style="v" />Minmin nynh he a do hae tuh, myarya lepaw lung pipi phe a nuekuh vae paw kha a muih hae. <verse number="5" style="v" />Shaw lungkhu lang he a tee hae tuh boei rawpaw zingkuh zah ranglang a haungpaw ccangvaepaw lu kheit kha muih hae zah a siikuh hae. <verse number="6" style="v" />Aning nynh minmin kha, “Siikuh nan oh, vaelantung kya a khiade hae paw Nazareth paw Jesu kha nanning nynh na ccung oh. Aning tuh phe a thoo vae! Hein kya um vae khyh. A rhua a ccynaw hae hynh dotua oh. <verse number="7" style="v" />La cceih oh lah a zuitu hae te Peter kha, aning tuh nae malang Galilee lang nynh a ccia; ae hopya oh hawte tuin kya na la muih cih oh, cite la hopah oh,” a cipya hae.<note caller="-" style="x"><char style="xo" closed="false">16.7: </char><char style="xt" closed="false"><ref loc="MAT 26:32">Mat 26.32</ref>; <ref loc="MRK 14:28">Mar 14.28</ref></char></note></para>
  <para style="p">
    <verse number="8" style="v" />Tukeiccuze minmin tuh shawku kyate pou hae zah thyngkute ngaeangthuate a ccue hae; a ri hae keiccuze hum sanmah hopah khyh hae.</para>
  <para style="s1">A Zuitu hae kya A Langkuh</para>
  <para style="p">
    <verse number="9" style="v" />Jesu tuh lonaw kyaze masaty nin awkhua takaw kya a thoothui koute, raerangsaro lu sari a deepyapaw Mary Magdalin kyakhe masaty a langkuh. <verse number="10" style="v" />Mary nynh cceih zah Jesu ryte a umkheih boi hae paw tuh rawkhuite a um lya hae khe a hopya hae. <verse number="11" style="v" />Thuasalama minmin nynh Jesu tuh a hiin vae cipaw te Mary nynh a muih cipaw he a thae hae tuh zyn khyh hae.</para>
  <para style="p">
    <verse number="12" style="v" />Tukoute zuitu hae lu ning nynh khua taraw lang a ccia lya hae khe Jesu tuh ccangpaw muinsan lante mih kya a langkuh. <verse number="13" style="v" />Minmin nynh ki hae zah tuhlaepaw zuitu hae kyakhe tuh-e kong tuh a hopya hae; thuasalama zyn khyh hae.</para>
  <para style="p">
    <verse number="14" style="v" />Tukoute zuitu hae lu haw lae kheit nynh looh a ae lya hae khe Jesu tuh mih kya a langkuh, Jesu a thoothui koute amaw a muihtu hae bya kha a zyn khyh hae keiccuze mih zyn leinaw te mih lungkhungnaw elang minmin kha a pe hae.</para>
  <para style="s1">Khri nynh Ryalaw A Naw hae</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mat 28.16-20</ref>)</para>
  <para style="p">
    <verse number="15" style="v" />Jesu nynh minmin kha, “Laephi vaw balyn la cceih oh lah raepaw miakaw kyakhe thehoypaw la ho oh.<note caller="-" style="x"><char style="xo" closed="false">16.15: </char><char style="xt" closed="false"><ref loc="ACT 1:8">Loc 1.8</ref></char></note> <verse number="16" style="v" />Zyn zah baptisma a inpaw tuh khum athua cih; thuasalama a zyn leipaw tuh byapianaw a ing cih. <verse number="17" style="v" />A zyn hae paw tuh hynh-e muihsahnaw hae hynh pya athua cih hae: ka min te raerangsaro hae kha a dee cih hae; bya thawpaw kha a ho cih hae; <verse number="18" style="v" />Minmin nynh hupaw hae kha a kyng cih hae; a chisah khopaw asy kha a nia hae zemah pawtua-ung lan khyh hae; ngeccih hae tungvaw mih kuih a khang cih hae zah ngeccih hae tuh a dan cih hae,” cite a hopya hae.</para>
  <para style="s1">Jesu Vaawlang Kaenaw</para>
  <para style="r">(<ref loc="LUK 24:50-53">Luk 24.50-53</ref>; <ref loc="ACT 1:9-11">Loc 1.9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" />Tuhcite Bawipaw Jesu nynh minmin kha a hopah kou hae te amaw tuh vaawlang lawthung thua zah Pachia a ranglang khe a haung vae.<note caller="-" style="x"><char style="xo" closed="false">16.19: </char><char style="xt" closed="false"><ref loc="ACT 1:9-11">Loc 1.9-11</ref></char></note> <verse number="20" style="v" />Zuitu hae tuh cceih hae zah khua takyh kya thehoypaw a siakhae hae, Bawipaw nynh minmin ryte ryalah zah, minmin nynh phung a ho hae paw tuh ahme cipaw kha a rae hae paw muihsahnaw liate a langkuh. Amen.</para>
</usx>