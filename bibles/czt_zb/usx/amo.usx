<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="AMO" style="id">Baebu Thyaa</book>
  <para style="h">AMOS</para>
  <para style="toc1">Amos</para>
  <para style="toc2">AMOS</para>
  <para style="toc3">Amo</para>
  <para style="mt1">AMOS</para>
  <para style="mt2">Amos</para>
  <para style="imt">Byalaanmaw</para>
  <para style="ip">Amos tuh Baebu lungkhu kyaze a byaho asae lante zei athuapaw masaty profeh nynh thua. Aning tuh Judah ram umpaw khua kyate yn thuapaw athua zemah Israel peenaw thahlang e ccungccaw hae kyakhe BC 750 loukaw kya phung a ho. E ccyh lya hynh myarya a kaethung ccyh, beiknaw lante mah myarya ahoy ccyh, atolang te donaw kya tuh khynnaw a um ccyh nynh thua. Thuasalama Amos nynh tuh-e kaethungnaw tuh mihoi hae elang kyalya thua zah, dingleinaw te ryachi hae tungvaw tuaasahnaw kha a tynsahpaw nynh thua cite a muih. Beiknaw lante a zui hae paw kha mah mih thinlung ccaccing te thua khyh, khynnaw mah khynnaw ccaccing thua khyh. Pachia nynh tuh-e minphuin tuh de a tah cih cite thawmuin rawhoyte a ho. Aning nynh byading kha, “tui hawte lua sah oh” (5.24) cite ngia hae zah, “<char style="nd">Bawipaw </char>, vaaw Pachia nynh Josef ciihan a laehy hae paw kha thaw poh a ccih kho hae,” a ci.</para>
  <para style="iot">Abyalupi hae</para>
  <para style="io1">Israel innpaw hae kha byapianaw 1.1—2.5</para>
  <para style="io1">Israel kha byapianaw 2.6—6.14</para>
  <para style="io1">Vizin ccangpangaw 7.1—9.15</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />E bya tuh Judah siapharan Uzziah ccyh lya te Israel siapharan Jehoash ccapaw Jeroboam ccyh lya, innry asueku maw kum ning lyakhe, Tekoa khua kyaze tuurin athua buapaw Amos nynh Israel ram konglang vizin a muihpaw bya nynh thua.<note caller="-" style="x"><char style="xo" closed="false">1.1: </char><char style="xt" closed="false"><ref loc="2KI 15:1-7">2Si 15.1-7</ref>; <ref loc="2CH 26:1-23">2Sh 26.1-23</ref>; <ref loc="2KI 14:23-29">2Si 14.23-29</ref></char></note></para>
  <para style="s1">Israel Innpaw hae Byapianaw</para>
  <para style="m">
    <verse number="2" style="v" />Amos nynh a hopaw tuh:<note caller="-" style="x"><char style="xo" closed="false">1.2: </char><char style="xt" closed="false"><ref loc="JOL 3:16">Joe 3.16</ref></char></note></para>
  <para style="q1">
    <char style="nd">Bawipaw </char> tuh Zion mua vawlan te sia zah,</para>
  <para style="q2">Jerusalem kyate a roi a saw;</para>
  <para style="q1">Tuurin hae kya-e tuu a paeekunaw</para>
  <para style="q2">kinno tuh naan zah,</para>
  <para style="q1">Karmel mua dung tuh arou vae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" />
    <char style="nd">Bawipaw </char> nynh hynhte a ho:</para>
  <para style="q2">Damaskas nynh atu te atu</para>
  <para style="q1">seinaw a rae keiccuze</para>
  <para style="q2">detah leite ka um lan khyh;</para>
  <para style="q1">minmin nynh Gilead kha</para>
  <para style="q2">sivaw haw bingkuhpaw</para>
  <para style="q1">ccatan tinnawpaw thingtung khate</para>
  <para style="q2">a tinde hae.<note caller="-" style="x"><char style="xo" closed="false">1.3-5: </char><char style="xt" closed="false"><ref loc="ISA 17:1-3">Isa 17.1-3</ref>; <ref loc="JER 49:23-27">Jer 49.23-27</ref>; <ref loc="ZEC 9:1">Zek 9.1</ref></char></note></para>
  <para style="q1">
    <verse number="4" style="v" />Tukeiccuze Hazael</para>
  <para style="q2">siapharan inn vawlan khe</para>
  <para style="q2">maee ka sawnua cih zah,</para>
  <para style="q1">tuh-e maee nynh Benhadad kya-e</para>
  <para style="q2">rhawlungrua hae kha a u cih.</para>
  <para style="q1">
    <verse number="5" style="v" />Damaskas koikua accong hae kha</para>
  <para style="q2">ka khya cih zah,</para>
  <para style="q2">Aven Accya kya um hae paw te</para>
  <para style="q1">Beth-eden khua e uktu bawi kha</para>
  <para style="q2">ka vua cih hae.</para>
  <para style="q1">Siria ccungccaw hae kha kyngte</para>
  <para style="q2">Kir ram lang cciakhae athua cih hae, cite</para>
  <para style="qr">
    <char style="nd">Bawipaw </char> nynh a ho.</para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" />
    <char style="nd">Bawipaw </char> nynh hynhte a ho:</para>
  <para style="q1">Gaza khua nynh atu te atu</para>
  <para style="q2">seinaw a rae keiccuze</para>
  <para style="q2">detah leite ka um lan khyh;</para>
  <para style="q1">minmin nynh minphuin pynpi kha kyngte</para>
  <para style="q2">Edom ram kalan ap khylan a cciakhae hae.<note caller="-" style="x"><char style="xo" closed="false">1.6-8: </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">Isa 14.29-31</ref>; <ref loc="JER 47:1-7">Jer 47.1-7</ref>; <ref loc="EZK 25:15-17">Eze 25.15-17</ref>; <ref loc="JOL 3:4-8">Joe 3.4-8</ref>; <ref loc="ZEP 2:4-7">Zef 2.4-7</ref>; <ref loc="ZEC 9:5-7">Zek 9.5-7</ref></char></note></para>
  <para style="q1">
    <verse number="7" style="v" />Tukeiccuze Gaza khualungrua vawlan khe</para>
  <para style="q2">maee ka sawnua cih zah,</para>
  <para style="q2">tuh-e maee nynh a rhawlungrua kha a u cih.</para>
  <para style="q1">
    <verse number="8" style="v" />Ashdod kya um hae paw te</para>
  <para style="q2">Ashkelon uknaw ccoi a kyngtu</para>
  <para style="q1">bawi kha ka vua cih hae.</para>
  <para style="q2">Ekron khua kha ka kuih</para>
  <para style="q1">ka maeleihnua cih zah,</para>
  <para style="q2">a laehypaw Filistin hae tuh</para>
  <para style="q1">a roh cih hae, cite</para>
  <para style="qr">Bawipaw PACHIA nynh a ho.</para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" />
    <char style="nd">Bawipaw </char> nynh hynhte a ho:</para>
  <para style="q1">Tair nynh atu te atu seinaw a rae keiccuze</para>
  <para style="q2">detah leite ka um lan khyh;</para>
  <para style="q1">minmin nynh minphuin pynpi kha</para>
  <para style="q2">Edom ram kalan a ap hae,</para>
  <para style="q1">a puizia ryte a rae hae paw</para>
  <para style="q2">byakinnaw kha liathui khyh.<note caller="-" style="x"><char style="xo" closed="false">1.9-10: </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">Isa 23.1-18</ref>; <ref loc="EZK 26:1-28:19">Eze 26.1—28.19</ref>; <ref loc="JOL 3:4-8">Joe 3.4-8</ref>; <ref loc="ZEC 9:1-4">Zek 9.1-4</ref>; <ref loc="MAT 11:21-22">Mat 11.21-22</ref>; <ref loc="LUK 10:13-14">Luk 10.13-14</ref></char></note></para>
  <para style="q1">
    <verse number="10" style="v" />Tukeiccuze Tair kya-e</para>
  <para style="q2">khualungrua vawlan khe</para>
  <para style="q1">maee ka sawnua cih zah,</para>
  <para style="q2">tuh-e maee nynh a rhawlungrua hae kha a u cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" />
    <char style="nd">Bawipaw </char> nynh hynhte a ho:</para>
  <para style="q1">Edom nynh atu te atu</para>
  <para style="q2">seinaw a rae keiccuze</para>
  <para style="q2">detah leite ka um lan khyh;</para>
  <para style="q1">aning nynh a unopaw kha</para>
  <para style="q2">thaloi te deehui zah,</para>
  <para style="q2">ngaethyaumsah khyh;</para>
  <para style="q1">zungzae a thinria zah,</para>
  <para style="q2">a thin-unaw kha tyty a ccykeku.<note caller="-" style="x"><char style="xo" closed="false">1.11-12: </char><char style="xt" closed="false"><ref loc="ISA 34:5-17">Isa 34.5-17</ref>, <ref loc="ISA 63:1-6">63.1-6</ref>; <ref loc="JER 49:7-22">Jer 49.7-22</ref>; <ref loc="EZK 25:12-14">Eze 25.12-14</ref>, <ref loc="EZK 35:1-15">35.1-15</ref>; <ref loc="OBA 1:1-14">Oba 1-14</ref>; <ref loc="MAL 1:2-5">Mal 1.2-5</ref></char></note></para>
  <para style="q1">
    <verse number="12" style="v" />Tukeiccuze Teman khua vawlan khe</para>
  <para style="q2">maee ka sawnua cih zah,</para>
  <para style="q1">tuh-e maee nynh Bozrah kya-e</para>
  <para style="q2">rhawlungrua hae kha a u cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" />
    <char style="nd">Bawipaw </char> nynh hynhte a ho:</para>
  <para style="q1">Ammon hae nynh atu te atu</para>
  <para style="q2">seinaw a rae hae keiccuze</para>
  <para style="q2">detah leite ka um lan khyh hae;</para>
  <para style="q1">mih ram kha kosah khylan</para>
  <para style="q2">Gilead ram e ccaawpoipaw</para>
  <para style="q2">nopi hae vue kha a pawsah hae.<note caller="-" style="x"><char style="xo" closed="false">1.13-15: </char><char style="xt" closed="false"><ref loc="JER 49:1-6">Jer 49.1-6</ref>; <ref loc="EZK 21:28-32">Eze 21.28-32</ref>, <ref loc="EZK 25:1-7">25.1-7</ref>; <ref loc="ZEP 2:8-11">Zef 2.8-11</ref></char></note></para>
  <para style="q1">
    <verse number="14" style="v" />Tukeiccuze Rabbah khualungrua kha</para>
  <para style="q2">maee te ka u cih zah, tuh-e maee nynh</para>
  <para style="q2">a khualungrua hae kha a u cih,</para>
  <para style="q1">rhawtuk nin kya siaruanaw a um cih zah,</para>
  <para style="q2">khiccungkhia nin kya khise athobia cih;</para>
  <para style="q1">
    <verse number="15" style="v" />tetuh mih siapharan te</para>
  <para style="q2">a kuihkaw e bawi hae kha</para>
  <para style="q1">kyngte a cciakhae cih hae, cite</para>
  <para style="qr">
    <char style="nd">Bawipaw </char> nynh a ho.</para>
  <chapter number="2" style="c" />
  <para style="q1">
    <verse number="1" style="v" />
    <char style="nd">Bawipaw </char> nynh hynhte a ho:</para>
  <para style="q2">Moab nynh atu te atu seinaw a rae keiccuze</para>
  <para style="q1">detah leite ka um lan khyh;</para>
  <para style="q2">aning nynh Edom siapharan ru kha</para>
  <para style="q2">buhhaw lang phe tang lan maee te a u.<note caller="-" style="x"><char style="xo" closed="false">2.1-3: </char><char style="xt" closed="false"><ref loc="ISA 15:1-16:14">Isa 15.1—16.14</ref>, <ref loc="ISA 25:10-12">25.10-12</ref>; <ref loc="JER 48:1-47">Jer 48.1-47</ref>; <ref loc="EZK 25:8-11">Eze 25.8-11</ref>; <ref loc="ZEP 2:8-11">Zef 2.8-11</ref></char></note></para>
  <para style="q1">
    <verse number="2" style="v" />Tukeiccuze Moab ram kha</para>
  <para style="q2">maee ka sawnua cih zah,</para>
  <para style="q1">tuh-e maee nynh Kerioth</para>
  <para style="q2">rhawlungrua hae kha a u cih,</para>
  <para style="q1">myarya ccae lan siathungnaw,</para>
  <para style="q2">siaruanaw te mungkae roi laku khe</para>
  <para style="q2">Moab hae tuh a chih cih hae;</para>
  <para style="q1">
    <verse number="3" style="v" />Moab ram angaelung khe</para>
  <para style="q2">uktu bawi kha ka vua cih zah,</para>
  <para style="q1">amaw ryte a kuihkaw e</para>
  <para style="q2">bawi hae balyn kha ka theih cih hae, cite</para>
  <para style="qr">
    <char style="nd">Bawipaw </char> nynh a ho.</para>
  <para style="b" />
  <para style="s1">Judah kha Byapianaw</para>
  <para style="q1">
    <verse number="4" style="v" />
    <char style="nd">Bawipaw </char> nynh hynhte a ho:</para>
  <para style="q2">Judah nynh atu te atu</para>
  <para style="q1">seinaw a rae keiccuze</para>
  <para style="q2">detah leite ka um lan khyh;</para>
  <para style="q1">pawccecize minmin nynh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> kawbya kha vua hae zah,</para>
  <para style="q1">a phungbya kha zui khyh hae,</para>
  <para style="q2">mih minpaaw hae nynh</para>
  <para style="q1">a zui hae paw hynbya khate</para>
  <para style="q2">minmin kha cciakhaesei athua vae hae.</para>
  <para style="q1">
    <verse number="5" style="v" />Tukeiccuze Judah tungvaw</para>
  <para style="q2">maee ka sawnua cih zah,</para>
  <para style="q1">tuh-e maee nynh Jerusalem</para>
  <para style="q2">rhawlungrua hae kha a u cih.</para>
  <para style="b" />
  <para style="s1">Israel kha Byapianaw</para>
  <para style="q1">
    <verse number="6" style="v" />
    <char style="nd">Bawipaw </char> nynh hynhte a ho:</para>
  <para style="q1">Israel nynh atu te atu seinaw a rae keiccuze</para>
  <para style="q2">detah leite ka um lan khyh;</para>
  <para style="q1">pawccecize minmin nynh</para>
  <para style="q2">miding hae kha ngun lang zua hae zah,</para>
  <para style="q1">minyaa hae kha phanah</para>
  <para style="q2">bua kheit lang a zua hae—</para>
  <para style="q1">
    <verse number="7" style="v" />ryachi hae lu kha laekhu e</para>
  <para style="q2">vuiping kya syde hae zah,</para>
  <para style="q1">zakawsang hae paw kha</para>
  <para style="q2">laante langkhe a tu hae;</para>
  <para style="q1">ka min thyaapaw kha thusah khylan</para>
  <para style="q2">paaw te ccaaw nynh</para>
  <para style="q2">nopi lu kheit kha a teenua hae;</para>
  <para style="q1">
    <verse number="8" style="v" />silawhang miakaw pe khe</para>
  <para style="q2">a lawku hae paw ponpaw</para>
  <para style="q1">boeining vawlan a i hae;</para>
  <para style="q2">detahnaw kyate a mue hae paw</para>
  <para style="q1">phua te a reku hae paw</para>
  <para style="q2">misutui kha mih Pachia inn kya a nia hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" />Tuhzemah sidar thing</para>
  <para style="q2">ahang hawte hang zah,</para>
  <para style="q1">phaesi thing hawte a thungpaw</para>
  <para style="q2">Amor minphuin kha</para>
  <para style="q2">mih malang khe ka ro;</para>
  <para style="q1">avawlan umpaw Amor thae te</para>
  <para style="q2">akawlan umpaw Amor tharui kha ka ro.<note caller="-" style="x"><char style="xo" closed="false">2.9: </char><char style="xt" closed="false"><ref loc="DEU 3:8-11">Deu 3.8-11</ref></char></note></para>
  <para style="q1">
    <verse number="10" style="v" />Amor hae ram kha ccou khylan,</para>
  <para style="q2">Izip ram kyate kae poukhae oh zah,</para>
  <para style="q2">ramkaw kya kum sung pali</para>
  <para style="q2">kae cciakhae oh.</para>
  <para style="q1">
    <verse number="11" style="v" />Nae ccaaw hae abang kha</para>
  <para style="q2">profeh lang ka hangthung hae zah,</para>
  <para style="q1">nae mino hae abang kha</para>
  <para style="q2">nazir<note caller="+" style="f"><char style="fr" closed="false">2.11 </char><char style="fq" closed="false">nazir </char><char style="ft" closed="false">cipaw tuh misutui nia lei lante, athyaa leipaw looh ae lei lante, sang ngoku lei lante, rhua ty lei lante byakinkuh zah Pachia a zynnaw a langsakuhpaw ccungccaw nynh thua (Nam 6.1-8 kha do).</char></note> hae lang ka hangthung hae.</para>
  <para style="q1">Pou Israel ccungccaw hae,</para>
  <para style="q2">tuh-e bya tuh ahmepaw</para>
  <para style="q1">thua ccaccing khyh tou? cite</para>
  <para style="qr">
    <char style="nd">Bawipaw </char> nynh a ho.<note caller="-" style="x"><char style="xo" closed="false">2.11: </char><char style="xt" closed="false"><ref loc="NUM 6:1-8">Nam 6.1-8</ref></char></note></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" />Thuasalama nanning nynh</para>
  <para style="q2">nazir hae kha misutui na niasah oh zah,</para>
  <para style="q1">profeh hae kha, “Profehbya</para>
  <para style="q2">na ho lan khyh,” cite kaw na pya oh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" />Tukeiccuze phe beih lan</para>
  <para style="q2">tarouhkuhpaw loohcce nynh</para>
  <para style="q1">le kha a nethin hawte,</para>
  <para style="q2">nae umnaw hmin kyakhe</para>
  <para style="q2">nanning kha kae nethin cih oh.</para>
  <para style="q1">
    <verse number="14" style="v" />Arangte a ccue khopaw nynh</para>
  <para style="q2">ccue man lan khyh zah,</para>
  <para style="q1">a thawsaepaw nynh a thawzung kha</para>
  <para style="q2">thua man lan khyh.</para>
  <para style="q1">A thungpaw nynh a hiinnaw kha</para>
  <para style="q2">khumkuh lan khyh;</para>
  <para style="q1">
    <verse number="15" style="v" />li a ccyngkuhpaw nynh</para>
  <para style="q2">thadyn man lan khyh zah,</para>
  <para style="q1">arangte a ccue khopaw nynh mah</para>
  <para style="q2">amaw kha khumkuh man lan khyh,</para>
  <para style="q1">marang rhawkaw nynh mah</para>
  <para style="q2">a hiinnaw kha khumkuh man lan khyh;</para>
  <para style="q1">
    <verse number="16" style="v" />tuin nin kya tuh a thung hae paw laku e</para>
  <para style="q2">mih thinlung tang hae paw nynh mah</para>
  <para style="q1">mih sasete a ccue cih hae, cite</para>
  <para style="qr">
    <char style="nd">Bawipaw </char> nynh a ho.</para>
  <para style="b" />
  <chapter number="3" style="c" />
  <para style="s1">Israel Seinaw te Detahnaw</para>
  <para style="p">
    <verse number="1" style="v" />Izip ram kyate minphuin pynpi te ka poukhae hae paw, pou Israel ccungccaw hae, <char style="nd">Bawipaw </char> nynh nanning ae honua oh paw e bya hynh ngaetua oh:</para>
  <para style="q1">
    <verse number="2" style="v" />Laephi vawlan e minphuin hae balyn kyaze</para>
  <para style="q2">nanning kyalya kha kae ny oh;</para>
  <para style="q1">tukeiccuze nae hoyleinaw balyn hanlan</para>
  <para style="q2">de kae tah cih oh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" />Ccungccaw lu ning nynh</para>
  <para style="q2">nawccawnaw hoity leite pynkheihlan</para>
  <para style="q2">khua a ccongkheih thya hae zawtou?</para>
  <para style="q1">
    <verse number="4" style="v" />Chindeih tuh teipaw saw a hoi leite</para>
  <para style="q2">ramkaw kya a sia zawtou?</para>
  <para style="q1">Chindeih anopaw tuh</para>
  <para style="q2">pawpaw sanmah a kyngkuh leite</para>
  <para style="q2">a karung kyate a sia zawtou?</para>
  <para style="q1">
    <verse number="5" style="v" />Lae vawlan khe kaangsya leite,</para>
  <para style="q2">pavaw tuh kaang a kae zawtou?</para>
  <para style="q1">Kaang tuh a pheihtu a um leite</para>
  <para style="q2">a seihkuh boi zawtou?</para>
  <para style="q1">
    <verse number="6" style="v" />Khua lungkhu kya</para>
  <para style="q2">mungkae kha tu athua ze,</para>
  <para style="q1">khuaccaaw hae tuh ri leite</para>
  <para style="q2">a um hae zawtou?</para>
  <para style="q1">
    <char style="nd">Bawipaw </char> nynh ronaw a thuasah leite,</para>
  <para style="q2">khua lungkhu kya ronaw a thua zawtou?</para>
  <para style="q1">
    <verse number="7" style="v" />Bawipaw PACHIA nynh a paccynpaw kha</para>
  <para style="q2">a ryalahtu profeh hae kya</para>
  <para style="q1">a langsakuh leite,</para>
  <para style="q2">pawpaw sanmah cyih khyh.</para>
  <para style="q1">
    <verse number="8" style="v" />Chindeih nynh he a sia vae ze,</para>
  <para style="q2">hummou ri leite a um cih?</para>
  <para style="q1">Bawipaw PACHIA nynh bya he a ho vae ze,</para>
  <para style="q2">hummou profehbya ho leite a um kho?</para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" />Ashdod te Izip kya-e rhawlungrua hae kha</para>
  <para style="q2">thaesah hae lah,</para>
  <para style="q1">“Samaria mua vawlan pumkuh oh,</para>
  <para style="q2">Samaria khua lungkhu kya</para>
  <para style="q1">siarisiaraepaw roi te</para>
  <para style="q2">tuaasahkunaw a umpaw kha</para>
  <para style="q2">dotua oh,” cite hopah hae.</para>
  <para style="q1">
    <verse number="10" style="v" />Minmin nynh akyhpaw cyi lanpaw kha</para>
  <para style="q2">nykuh khyh hae, mih inn</para>
  <para style="q1">ahoyhoy hae paw kyakhe</para>
  <para style="q2">puathonaw te a luade hae paw</para>
  <para style="q1">uccaw hae kha a ccakhung hae, cite</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh a ci.</para>
  <para style="q1">
    <verse number="11" style="v" />Tukeiccuze Bawipaw PACHIA nynh hynhte a ho:</para>
  <para style="q2">Rhaw nynh ram kha a koihlu cih zah,</para>
  <para style="q1">na koihkhawkupaw kha ae phoupah cih;</para>
  <para style="q2">na inn ahoyhoy hae paw kha</para>
  <para style="q1">luadete a roh cih hae.</para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" />
    <char style="nd">Bawipaw </char> nynh hynhte a ho: Tuurinpaw nynh tuu accu ccangning khyhze nakua ccapyh kha chindeih khalang kyate a khum hawte, Samaria khua umpaw iphae adung te ikhung apaekua vawlan a haung hae paw Israel hae beihtaraw kha khum athua cih hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" />Bawipaw PACHIA, vaaw Pachia nynh</para>
  <para style="q2">a hopaw kha ngae oh lah,</para>
  <para style="q2">Jakob ciihan hae kha honua oh:</para>
  <para style="q1">
    <verse number="14" style="v" />Israel kha a seinaw keiccuze</para>
  <para style="q2">de ka tah nin khe,</para>
  <para style="q1">Bethel kya umpaw silawhang hae kha</para>
  <para style="q2">de ka tah cih hae,</para>
  <para style="q1">silawhang a ki hae kha moi athua cih hae zah</para>
  <para style="q2">laekhu lang a ccah cih hae.<note caller="-" style="x"><char style="xo" closed="false">3.14: </char><char style="xt" closed="false"><ref loc="2KI 23:15">2Si 23.15</ref></char></note></para>
  <para style="q1">
    <verse number="15" style="v" />Khuaccih ccyh lya-e inn te</para>
  <para style="q2">hawnin ccyh lya-e inn kha</para>
  <para style="q2">ka phou cih hae;</para>
  <para style="q1">saepaw nua te a ccaan hae paw</para>
  <para style="q2">inn hae kha ka roh cih,</para>
  <para style="q1">myarya lepaw inn hae tuh</para>
  <para style="q2">a zo vae cih hae, cite</para>
  <para style="qr">
    <char style="nd">Bawipaw </char> nynh a ho.</para>
  <para style="b" />
  <chapter number="4" style="c" />
  <para style="q1">
    <verse number="1" style="v" />Ryachi hae kha tuaasah hae zah,</para>
  <para style="q2">a nyaa hae paw kha a nangde hae paw,</para>
  <para style="q1">mih vawpaw hae kha, “Nia lanpaw</para>
  <para style="q2">oun pya!” a cih hae paw,</para>
  <para style="q1">Samaria Mua vawlan e</para>
  <para style="q2">Bashan vaetuapi hae,</para>
  <para style="q2">e bya hynh ngaetua oh.</para>
  <para style="q1">
    <verse number="2" style="v" />Bawipaw PACHIA nynh</para>
  <para style="q2">a thyaanaw liate bya a kinku vae:</para>
  <para style="q2">Nanning kha bawnawpaw te thuasah,</para>
  <para style="q1">nae ccaaw nae no hae kha heize</para>
  <para style="q2">ngasabaw te thuasah</para>
  <para style="q1">ae cciakhae oh ccyh tuh</para>
  <para style="q2">yn thua ccaccing cih.</para>
  <para style="q1">
    <verse number="3" style="v" />Nanning tuh lu kheit ccite</para>
  <para style="q2">khualungrua-ua kyate</para>
  <para style="q1">lawbabin lan malang na pou cih oh;</para>
  <para style="q2">te Harmon langkhe ae vua cih oh, cite</para>
  <para style="qr">
    <char style="nd">Bawipaw </char> nynh a ci.</para>
  <para style="q1">
    <verse number="4" style="v" />Bethel lang oun cceih oh lah, sei oh;</para>
  <para style="q2">Gilgal lang oun cceih oh lah,</para>
  <para style="q1">seinaw patae raetua oh;</para>
  <para style="q2">awkhua takyh si na lawnaw oh paw kha</para>
  <para style="q1">oun ccyng oh,</para>
  <para style="q2">nae kya-e pumhaw pumkheit kha</para>
  <para style="q2">nin thum ze vae kheit oun ccyng oh;</para>
  <para style="q1">
    <verse number="5" style="v" />ransi phingkuhpaw lungtuanaw</para>
  <para style="q2">sanlou kha oun ccyng oh,</para>
  <para style="q1">lungthote silawnaw kha rae oh, cite</para>
  <para style="q2">zapi hae kha thaesah oh;</para>
  <para style="q1">pawccecize, pou Israel ccungccaw hae,</para>
  <para style="q2">tuhcite khaw na cyi ry oh! cite</para>
  <para style="qr">Bawipaw PACHIA nynh a ho.</para>
  <para style="b" />
  <para style="s1">Israel nynh Thuiheinaw A Ei</para>
  <para style="q1">
    <verse number="6" style="v" />Nae khuapi hae balyn kyakhe</para>
  <para style="q2">ccakan ka ccisah zah,</para>
  <para style="q2">nae umnaw takyh kyakhe looh ka thangsah,</para>
  <para style="q1">tuhzemah ka kalan nae kithui khyh oh, cite</para>
  <para style="qr">
    <char style="nd">Bawipaw </char> nynh a ci.</para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" />Loohrue nawlan sawpaw sah thum he ary te,</para>
  <para style="q2">khuaa kha mah kae rawsahpah vae khyh oh;</para>
  <para style="q1">khuapi khua kheit kya khuaa ka rawsah zah,</para>
  <para style="q2">ccangpaw khua kheit kya</para>
  <para style="q2">khuaa ka rawsah khyh;</para>
  <para style="q1">loo ccyng kheit kya tuh khuaarah zah,</para>
  <para style="q2">khuaa a raw leinaw loo kya tuh karae rou;</para>
  <para style="q1">
    <verse number="8" style="v" />tukeiccuze khua khua ning khua thum hae tuh</para>
  <para style="q2">tui nia khylan khua khua kheit kalan</para>
  <para style="q2">a ccia hae zemah byn khyh hae;</para>
  <para style="q1">tuhzemah ka kalan nae kithui khyh oh, cite</para>
  <para style="qr">
    <char style="nd">Bawipaw </char> nynh a ho.</para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" />Khivae keiccu aku chinaw,</para>
  <para style="q2">aphi pou zah aku chinaw khate</para>
  <para style="q1">nanning kha de kae tah oh;</para>
  <para style="q2">nae khokhu hae te</para>
  <para style="q2">nae misu khokhu hae kha ka ro hae;</para>
  <para style="q1">tungkhipaw hae nynh nae thaeku ku hae te</para>
  <para style="q2">nae oliv ku hae kha a ae hae;</para>
  <para style="q1">tuhzemah ka kalan nae kithui khyh oh, cite</para>
  <para style="qr">
    <char style="nd">Bawipaw </char> nynh a ci.</para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" />Izip ram kya ka thuasahpaw</para>
  <para style="q2">shethya kha nae kya ka thuasah;</para>
  <para style="q1">nae ccangvae hae kha thaloi te ka chia hae;</para>
  <para style="q2">nae marang hae kha</para>
  <para style="q2">ccaring kae cciakhaepya oh;</para>
  <para style="q1">nae ryahmin kya-e athuhpaw amyn kha</para>
  <para style="q2">nae naduh te kae suesah oh,</para>
  <para style="q1">tuhzemah ka kalan nae kithui khyh oh, cite</para>
  <para style="qr">
    <char style="nd">Bawipaw </char> nynh a ci.</para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" />Pachia nynh Sodom te</para>
  <para style="q2">Gomorrah a ro lya hawte,</para>
  <para style="q2">nanning abang kha kae ro oh,</para>
  <para style="q1">nanning tuh maee lungkhu te</para>
  <para style="q2">lawpaw maeething taraw te nynh</para>
  <para style="q2">na loku oh;</para>
  <para style="q1">tuhzemah ka kalan nae kithui khyh oh, cite</para>
  <para style="qr">
    <char style="nd">Bawipaw </char> nynh a ci.<note caller="-" style="x"><char style="xo" closed="false">4.11: </char><char style="xt" closed="false"><ref loc="GEN 19:24">Gen 19.24</ref></char></note></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" />Tukeiccuze, pou Israel,</para>
  <para style="q2">tuhcite na tungvaw ka cyih cih;</para>
  <para style="q1">tuhte na tungvaw ka cyih cih keiccuze,</para>
  <para style="q2">na Pachia kha tungku lan</para>
  <para style="q1">paccynku tua, pou Israel!</para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" />Pawccecize mua hae te</para>
  <para style="q2">khivae kha a raetupaw,</para>
  <para style="q1">a tuanaw kha ccungccaw hae kya</para>
  <para style="q2">a langsakuhpaw,</para>
  <para style="q1">awkhua e awnaw kha mohnaw lang rae zah,</para>
  <para style="q2">laephi ahang hae paw kha</para>
  <para style="q1">a sydepaw a min tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char>, vaaw Pachia a cikuh.</para>
  <chapter number="5" style="c" />
  <para style="s1">Israel Seinaw keiccu Rawkhuinaw</para>
  <para style="p">
    <verse number="1" style="v" />Pou Israel hae, hynh-e kae hopya oh paw</para>
  <para style="q2">rawkhuinaw bya hynh ngaetua oh:</para>
  <para style="q1">
    <verse number="2" style="v" />Liaccanung Israel tuh a khuliakuh vae,</para>
  <para style="q2">thokuh vae lan khyh;</para>
  <para style="q1">a ram kya a huekuh vae,</para>
  <para style="q2">aning kha a tho lanpaw lu kheit san um khyh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" />Bawipaw PACHIA nynh hynhte a ho:</para>
  <para style="q1">Rhawtuk lan ccungccaw thong kheit</para>
  <para style="q2">a sawpaw khuapi tuh</para>
  <para style="q2">milu za kheit kyalya alae vae cih,</para>
  <para style="q1">ccungccaw za kheit a sawpaw khuapi tuh</para>
  <para style="q2">lu haw kyalya alae vae cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" />
    <char style="nd">Bawipaw </char> nynh Israel hae kha</para>
  <para style="q2">hynhte a hopya hae:</para>
  <para style="q1">Kae kha yn ccung oh lah, na hiin cih oh;</para>
  <para style="q2">
    <verse number="5" style="v" />thuasalama Bethel khua kha ccung nan oh,</para>
  <para style="q1">Gilgal khua lungkhu lang tee nan oh,</para>
  <para style="q2">Beersheba khua lang cceih nan oh,</para>
  <para style="q1">pawccecize Gilgal khua tuh</para>
  <para style="q2">a kyng cih hae zah</para>
  <para style="q1">a cciakhae ccaccing cih hae,</para>
  <para style="q2">Bethel khua tuh</para>
  <para style="q1">accakaepaw lang a tang cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" />
    <char style="nd">Bawipaw </char> kha ccung oh lah,</para>
  <para style="q2">na hiin cih oh, tuhkhyhze tuh</para>
  <para style="q1">Josef ciihan hae kha maee hawte a u cih hae,</para>
  <para style="q2">tuh-e maee nynh Bethel kha</para>
  <para style="q2">a u cih zah, a thetu um lan khyh.</para>
  <para style="q1">
    <verse number="7" style="v" />Byading kha eccangkary lang</para>
  <para style="q2">na tangsah oh zah,</para>
  <para style="q1">dingnaw kha laekhu lang na vua oh!</para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" />Awsitaruh te Orion awsiphu kha a raetupaw,<note caller="-" style="x"><char style="xo" closed="false">5.8: </char><char style="xt" closed="false"><ref loc="JOB 9:9">Job 9.9</ref>, <ref loc="JOB 38:31">38.31</ref></char></note></para>
  <para style="q2">marae zipingpaw mohnaw kha</para>
  <para style="q1">awkhua awnaw lang a paleihtupaw,</para>
  <para style="q2">khuadae kha khuazi lang</para>
  <para style="q1">a mohsahtupaw,</para>
  <para style="q2">rili tui kha ko zah laephi vawlan</para>
  <para style="q1">moh a laetupaw a min tuh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> a cikuh;</para>
  <para style="q1">
    <verse number="9" style="v" />aning nynh mih thawsae hae paw te</para>
  <para style="q2">rhawlungrua hae kha a ro hae.</para>
  <para style="q1">
    <verse number="10" style="v" />Minmin nynh koikua kya</para>
  <para style="q2">dingleinaw a langsakuhpaw te</para>
  <para style="q2">byaccing a hopaw kha a hua hae.</para>
  <para style="q1">
    <verse number="11" style="v" />Nanning nynh ryachi hae kha</para>
  <para style="q2">na syde oh zah,</para>
  <para style="q2">looh kha na luade oh keiccuze</para>
  <para style="q1">asuikuhpaw lung te inn na sakku oh zemah</para>
  <para style="q2">tuh-e inn hae kya na um lan khyh oh;</para>
  <para style="q1">ry lan umpaw misu khokhu hae kha</para>
  <para style="q2">na raeku oh zemah,</para>
  <para style="q1">tuin kya-e misutui kha</para>
  <para style="q2">na neih lan khyh oh.</para>
  <para style="q1">
    <verse number="12" style="v" />Nae cyiseimenaw alungpaw te</para>
  <para style="q2">nae seinaw alungpaw kha phe ka ny—</para>
  <para style="q1">miding hae kha vawsaw na pya oh zah,</para>
  <para style="q2">pyaruh kha na lawku oh,</para>
  <para style="q1">minyaa hae kha byapianaw koikua kyate</para>
  <para style="q2">atolang na dee oh.</para>
  <para style="q1">
    <verse number="13" style="v" />Tukeiccuze mihawpaw nynh tuh</para>
  <para style="q2">tuhcihawpaw ccyh kya</para>
  <para style="q2">daebabi lan a um;</para>
  <para style="q1">pawccecize tuh-e ccyh tuh</para>
  <para style="q2">ccyh thyapaw nynh thua.</para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" />Na hiin ccaw oh,</para>
  <para style="q2">hoyleinaw kha ccung leite</para>
  <para style="q2">hoynaw kha ccung oh;</para>
  <para style="q1">tuhte na cyi oh zetuh, na ho vae oh hawte,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char>, vaaw Pachia tuh</para>
  <para style="q2">nae kya a um cih.</para>
  <para style="q1">
    <verse number="15" style="v" />Hoyleinaw kha hua oh lah,</para>
  <para style="q2">hoynaw kha ry oh,</para>
  <para style="q1">byapianaw koikua kya</para>
  <para style="q2">dingnaw kha tynsah oh;</para>
  <para style="q1">
    <char style="nd">Bawipaw </char>, vaaw Pachia nynh Josef ciihan</para>
  <para style="q2">a laehy hae paw kha</para>
  <para style="q1">thaw poh a ccih kho hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" />Tukeiccuze Bawipaw,</para>
  <para style="q2">vaaw Pachia, <char style="nd">Bawipaw </char> nynh hynhte a ho:</para>
  <para style="q1">Laanpi takyh kya rawnaw a um cih zah,</para>
  <para style="q2">“Ezou! Ezou!” a ci cih hae.</para>
  <para style="q1">Loopho hae te a rahthya hae paw kha</para>
  <para style="q2">raw lan a ko cih hae;</para>
  <para style="q1">
    <verse number="17" style="v" />misu khokhu hae balyn kya</para>
  <para style="q2">rawnaw a um cih,</para>
  <para style="q1">pawccecize kae tuh nae laku kya</para>
  <para style="q2">po ka cceih cih, cite</para>
  <para style="qr">
    <char style="nd">Bawipaw </char> nynh a ci.</para>
  <para style="b" />
  <para style="s1">
    <char style="nd">Bawipaw </char> Nin</para>
  <para style="q1">
    <verse number="18" style="v" />
    <char style="nd">Bawipaw </char> nin a ngaehoi hae paw</para>
  <para style="q2">nanning hanlan ngaethya lan kou um!</para>
  <para style="q2">Pawccemou <char style="nd">Bawipaw </char> nin tuh na ngaehoi oh?</para>
  <para style="q1">Tuh-e nin tuh moh zah awnaw um khyh;</para>
  <para style="q2">
    <verse number="19" style="v" />ccungccaw nynh chindeih kyate ccue zah,</para>
  <para style="q2">vong te a tungku hae hawte athua cih zah,</para>
  <para style="q1">inn lungkhu lang tee zah</para>
  <para style="q2">pang kya a hahku lyakhe</para>
  <para style="q2">hupaw nynh a khy hawte athua cih.</para>
  <para style="q1">
    <verse number="20" style="v" />
    <char style="nd">Bawipaw </char> nin tuh</para>
  <para style="q2">awnaw thua leite mohnaw nin nynh thua,</para>
  <para style="q1">awnaw um leite marae zipaw</para>
  <para style="q2">mohnaw nin nynh thua.</para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" />Nae beiknaw poi hae kha ka hua zah</para>
  <para style="q2">pawlang ka ria khyh,</para>
  <para style="q1">athyaapaw nae pumkunaw kha mah</para>
  <para style="q2">ka lungrythua khyh.<note caller="-" style="x"><char style="xo" closed="false">5.21-22: </char><char style="xt" closed="false"><ref loc="ISA 1:11-14">Isa 1.11-14</ref></char></note></para>
  <para style="q1">
    <verse number="22" style="v" />Maee-ute silawnaw te</para>
  <para style="q2">ccathae silawnaw kha</para>
  <para style="q1">nae pya oh zemah,</para>
  <para style="q2">kae ccoupah lan khyh oh;</para>
  <para style="q1">ccawkunaw silawnaw lante</para>
  <para style="q2">nae pya oh paw</para>
  <para style="q1">athopaw nae sahiin hae kha mah</para>
  <para style="q2">lymaw ka do lan khyh.</para>
  <para style="q1">
    <verse number="23" style="v" />Na siarua oh paw</para>
  <para style="q2">nae hlaw roi kha zya dae oh;</para>
  <para style="q2">nae tintang roi kha ka thae ry khyh.</para>
  <para style="q1">
    <verse number="24" style="v" />Byading kha tui hawte luasah oh lah,</para>
  <para style="q2">dingnaw kha akan leipaw</para>
  <para style="q1">vaw hawte luasah oh.</para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" />Pou Israel hae, silawnawpaw te pyapaw uccaw hae kha ramkaw kya kum sung pali lungkhu ka kalan nae thuakhae oh tou?<note caller="-" style="x"><char style="xo" closed="false">5.25-27: </char><char style="xt" closed="false"><ref loc="ACT 7:42-43">Loc 7.42-43</ref></char></note> <verse number="26" style="v" />Nae siapharan Sakkuth, nae awsi-pachia Kaiwan te na raeku oh paw zohtuh hae kha na lawkuh cih oh; <verse number="27" style="v" />tukeiccuze nanning kha kyngte Damaskas khunglang kae cciakhaesah cih oh, cite a min vaaw Pachia a cikuhpaw <char style="nd">Bawipaw </char> nynh a ci.</para>
  <chapter number="6" style="c" />
  <para style="s1">Israel Ronaw</para>
  <para style="q1">
    <verse number="1" style="v" />Zion kya lungdaete a um hae paw te</para>
  <para style="q2">Samaria Mua vawlan</para>
  <para style="q1">khyndadyh lan a um hae paw,</para>
  <para style="q2">minphuin hae kyaze</para>
  <para style="q1">asung-e huapaw lante alangkuhpaw,</para>
  <para style="q2">Israel hae nynh a doliaku hae paw hanlan</para>
  <para style="q2">ngaethya lan kou um!</para>
  <para style="q1">
    <verse number="2" style="v" />Kalneh khua lang</para>
  <para style="q2">la cceih oh lah, la dotua oh;</para>
  <para style="q2">tuin kyate myarya lepaw</para>
  <para style="q1">Hamath khua lang la cceih oh;</para>
  <para style="q2">te Filistin ram e Gath khua langkhe</para>
  <para style="q1">la cceihbung oh.</para>
  <para style="q2">Nanning tuh e ram hae laeze</para>
  <para style="q1">na hoyhua oh tou?</para>
  <para style="q2">Nae ram tuh mih ram laeze akohua tou?</para>
  <para style="q1">
    <verse number="3" style="v" />Nin thahpaw nin kha</para>
  <para style="q2">ccaring na nue oh zah,</para>
  <para style="q1">puathote ukkunaw nin kha</para>
  <para style="q2">na naesah oh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" />Saepaw nua te raekuhpaw</para>
  <para style="q2">ikhung vawlan ih hae zah,</para>
  <para style="q1">mih iphae vawlan a huekuh hae paw,</para>
  <para style="q2">tuuphu kya-e tuutaw hae te</para>
  <para style="q1">vaetua khia kya-e vaetuataw hae kha</para>
  <para style="q2">a ae hae paw hanlan thuasah,</para>
  <para style="q1">
    <verse number="5" style="v" />tintang khuakute hlaw huataw kha sah hae zah,</para>
  <para style="q2">David hawte khuakupaw uccaw kha</para>
  <para style="q2">a raekuh hae paw hanlan thuasah,</para>
  <para style="q1">
    <verse number="6" style="v" />misutui kha banang lepaw te neih hae zah,</para>
  <para style="q2">chitui ahoyhoypaw kha</para>
  <para style="q1">a thuhku hae zemah Josef nynh</para>
  <para style="q2">ronaw a teingpaw kha</para>
  <para style="q1">mih ngaethah lei hae paw hanlan thuasah</para>
  <para style="q2">ngaethya lan kou um!</para>
  <para style="q1">
    <verse number="7" style="v" />Tukeiccuze minmin kha masaty</para>
  <para style="q2">a kyng cih hae zah a cciakhae cih hae,</para>
  <para style="q1">kalouhkalouh huekuh hae paw kya-e</para>
  <para style="q2">lungpawnaw tuh athang cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" />Bawipaw PACHIA ccaccei nynh</para>
  <para style="q2">bya a kinku vae (<char style="nd">Bawipaw </char>,</para>
  <para style="q2">vaaw Pachia nynh a ho):</para>
  <para style="q1">Jakob nynh a lysakunaw te</para>
  <para style="q2">a rhawlungrua hae kha ka hua;</para>
  <para style="q1">khuapi te a lungkhu um hae paw balyn kha</para>
  <para style="q2">rhaw hae kalan ka ap cih hae.</para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" />Inn innkheit lungkhu ccungccaw lu haw a laehy hae ze, a chih cih hae. <verse number="10" style="v" />Michi te puizia athua hae paw lu kheit nynh michi rhua kha maee te u khylan inn lungkhu te a poukhae cih, te inn lungkhu umpaw lu kheit kha, “Na umkheih oh paw lukhakheit a um ung tou?” cite a khia lanze, “Um vae khyh,” cite a khung cih. Tetuh tuh-e a puiziapaw tuh nynh, “Daebabi lan zya um! <char style="nd">Bawipaw </char> min kha ho lanpaw thua khyh,” a cipah cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" />Dotua, <char style="nd">Bawipaw </char> nynh kawpya keiccuze,</para>
  <para style="q2">inn lepaw kha phiariphiarae</para>
  <para style="q1">pong um lan phou athua cih zah,</para>
  <para style="q2">inn dihpaw kha zoihtatae lan</para>
  <para style="q2">phou athua cih.</para>
  <para style="q1">
    <verse number="12" style="v" />Marang hae tuh lung pipi vawlan</para>
  <para style="q2">a ccue hae zawtou?</para>
  <para style="q1">Ccungccaw nynh rili kha tangnuapaw te</para>
  <para style="q2">lei lang a thue zawtou?</para>
  <para style="q1">Thuasalama nanning nynh dingnaw kha</para>
  <para style="q2">sy lang na paleih oh zah,</para>
  <para style="q1">dingnaw thae kha</para>
  <para style="q2">eccangkary lang na paleih oh—</para>
  <para style="q1">
    <verse number="13" style="v" />nanning nynh Lodebar khua kya</para>
  <para style="q2">nae lungpaw zah,</para>
  <para style="q1">“Karnaim kha ahmaw thawzung te</para>
  <para style="q2">ah lah khyh oh tou?” na ciku oh.</para>
  <para style="q1">
    <verse number="14" style="v" />Thanccingte, pou Israel hae,</para>
  <para style="q2">nanning kha rawse khylan</para>
  <para style="q1">minphuin phuin kheit ka langsakuh cih zah</para>
  <para style="q2">minmin nynh nanning kha</para>
  <para style="q1">Lebo-hamath kyate Arabah Accya kyacia</para>
  <para style="q2">ae tuaa ae sah cih oh, cite <char style="nd">Bawipaw </char>,</para>
  <para style="q1">vaaw Pachia nynh a ci.</para>
  <chapter number="7" style="c" />
  <para style="s1">Tungkhipaw, Maee, Tounawpaw Arui</para>
  <para style="p">
    <verse number="1" style="v" />E hynh Bawipaw PACHIA nynh kae yn muihsahpaw nynh thua: siapharan kya-e lonua ku kha aw athua koute, lonua bua yn po takaw ccyh khe, <char style="nd">Bawipaw </char> nynh tungkhipaw hae kha a rae cih. <verse number="2" style="v" />Tuh-e hae nynh ram lungkhu e lonua hae kha he a ae kou hae te, kae nynh,</para>
  <para style="q1">“Pou Bawipaw PACHIA,</para>
  <para style="q2">beih ngaethya hae, cite kae ngia!</para>
  <para style="q1">Pawtemou Jakob tuh a thadyn kho cih?</para>
  <para style="q2">Aning tuh myarya dihpaw nynh thua!” ka cipya.</para>
  <para style="q1">
    <verse number="3" style="v" />E konglang te <char style="nd">Bawipaw </char> tuh</para>
  <para style="q2">a lungpaleihkuh zah,</para>
  <para style="q1">“E hynh cyihkuh vae lan khyh,” cite</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh a ci.</para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" />E hynh Bawipaw PACHIA nynh kae yn muihsahpaw nynh thua: Bawipaw PACHIA nynh maee te bya a pia cih zah, tuh-e maee nynh rilipi te laephi kha a u cih. <verse number="5" style="v" />Tetuh kae nynh,</para>
  <para style="q1">“Pou Bawipaw PACHIA,</para>
  <para style="q2">beih umtawtua, cite kae ngia!</para>
  <para style="q1">Pawtemou Jakob tuh a thadyn kho cih?</para>
  <para style="q2">Aning tuh myarya dihpaw nynh thua!” ka cipya.</para>
  <para style="q1">
    <verse number="6" style="v" />E konglang te <char style="nd">Bawipaw </char> tuh</para>
  <para style="q2">a lungpaleihkuh zah,</para>
  <para style="q1">“E hynh mah cyihkuh lan khyh,” cite</para>
  <para style="q2">Bawipaw PACHIA nynh a ci.</para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" />E hynh <char style="nd">Bawipaw </char> nynh bua yn muihsahpaw nynh thua: Bawipaw tuh tounawpaw arui kha a kuih kya ccyngkuh zah, tounawpaw arui te raekuhpaw pang pe khe a thadyn. <verse number="8" style="v" />Te <char style="nd">Bawipaw </char> nynh kae kha, “Amos, pawmou na muih?” cite yn khia zah, kae nynh, “Tounawpaw arui kha nynh ka muih,” cite ka khung. Tetuh Bawipaw nynh,</para>
  <para style="q1">“Dotua, ka ccungccaw Israel hae ngaelung khe</para>
  <para style="q2">tounawpaw arui kha ka nung cih;</para>
  <para style="q1">minmin kha papin bua</para>
  <para style="q2">ka ngaesangpah vae lan khyh hae;</para>
  <para style="q1">
    <verse number="9" style="v" />Isak kya-e ahangpaw hmin hae tuh</para>
  <para style="q2">ccungccaw adae cih zah,</para>
  <para style="q1">Israel a beikinnthyaa hae tuh</para>
  <para style="q2">ro athua cih hae,</para>
  <para style="q1">Jeroboam ciihan hae kha thaloi te</para>
  <para style="q2">ka thonuakuh cih hae,” a ci.</para>
  <para style="b" />
  <para style="s1">Amaziah te Amos</para>
  <para style="p">
    <verse number="10" style="v" />Tetuh Bethel ranpibawi Amaziah nynh Israel siapharan Jeroboam kalan saw hae zah, “Amos nynh nang kha rawsete Israel hae ngaelung khe aruh lante a paccynku vae; a hopaw bya balyn kha ram pynpi nynh ngaesang kho vae khyh. <verse number="11" style="v" />Amos nynh hynhte a ho:</para>
  <para style="q1">‘Jeroboam tuh thaloi te a chih cih,</para>
  <para style="q2">Israel tuh a kyng cih hae zah,</para>
  <para style="q1">a ram kyate asawnaw lang</para>
  <para style="q2">a cciakhae cih hae,’ a ci,” cite a hopya.</para>
  <para style="m">
    <verse number="12" style="v" />Te Amaziah nynh Amos kha, “Pou profeh, cceih, Judah ram lang ccaring ccue lah, tuin kyakhe profehbya hote na vue la kuakuh. <verse number="13" style="v" />Bethel khua kya profehbya papin ho nan vae, pawccecize Bethel tuh siapharan beikinnthyaa thua zah, ram pynpi beikinn nynh thua,” a cipya.</para>
  <para style="p">
    <verse number="14" style="v" />Tetuh Amos nynh Amaziah kha, “Kae tuh profeh ka thua khyh, profeh ccapaw mah ka thua khyh; kae tuh sahiin a rinpaw ka thua zah, thaeku ku hae kha a do-oihtupaw nynh ka thua. <verse number="15" style="v" /><char style="nd">Bawipaw </char> nynh sahiin phu ka rinnaw kyate kae kha yn ko zah, ‘La cceih lah, ka ccungccaw Israel hae kya profehbya la ho,’ yn cipya.</para>
  <para style="q1">
    <verse number="16" style="v" />“Tukeiccuze, atu <char style="nd">Bawipaw </char> bya kha ngaetua.</para>
  <para style="q2">Nang nynh, ‘Israel kha rawsete</para>
  <para style="q1">profehbya ho nan, Isak ciihan kha</para>
  <para style="q2">rawsete phungho nan,’ na ci.</para>
  <para style="q1">
    <verse number="17" style="v" />Tukeiccuze <char style="nd">Bawipaw </char> nynh hynhte a ho:</para>
  <para style="q2">‘Na zu tuh khuapi kya ohhuanung lang</para>
  <para style="q1">a tang cih zah,</para>
  <para style="q2">na ccanung hae te na ccapaw hae tuh</para>
  <para style="q1">thaloi te a chih cih hae,</para>
  <para style="q2">na laephi kha tounawpaw rui te</para>
  <para style="q1">a tou cih hae zah a neekuh cih hae;</para>
  <para style="q2">nang tuh athyaa leipaw ram kya na chih cih,</para>
  <para style="q1">Israel tuh a kyng cih hae zah</para>
  <para style="q2">a ram kyate ccaring a cciakhae</para>
  <para style="q1">ccaccing cih hae,’ a ci,” cite a hopya.</para>
  <chapter number="8" style="c" />
  <para style="s1">Thingthae Nungnawpaw Shua</para>
  <para style="p">
    <verse number="1" style="v" />E hynh Bawipaw PACHIA nynh kae yn muihsahpaw nynh thua—hawnin ccyh e thingthae a umnahpaw shua shuakheit alangkuh. <verse number="2" style="v" /><char style="nd">Bawipaw </char> nynh, “Amos, pawmou na muih?” cite yn khia zah, kae nynh, “Hawnin ccyh e thingthae shua kheit kha ka muih,” ka cipya. Tetuh <char style="nd">Bawipaw </char> nynh kae kha,</para>
  <para style="q1">“Ka ccungccaw Israel hae tungvaw kya</para>
  <para style="q2">athangnaw tuh a thua vae;</para>
  <para style="q1">minmin kha papin bua ka ngaesangpah</para>
  <para style="q2">vae lan khyh hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Tuin nin vae tuh beikinn e</para>
  <para style="q2">hlawsah hae paw roi tuh</para>
  <para style="q2">rawkhuinaw roi lang a tang cih.</para>
  <para style="q1">Michi rhua patae a um cih zah,</para>
  <para style="q2">hmin takyh kya a vua cih hae,</para>
  <para style="q1">“Daebabi lan um oh! a ci cih hae,” cite</para>
  <para style="qr">Bawipaw PACHIA nynh a ci.</para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" />Minyaa hae kha syde hae zah,</para>
  <para style="q2">ram kya-e ryachi hae kha</para>
  <para style="q1">ro lan a ry hae paw nanning,</para>
  <para style="q2">e bya hynh ngaetua oh,</para>
  <para style="q1">
    <verse number="5" style="v" />nanning nynh, “Looh kha zua khylan,</para>
  <para style="q2">hohtuh vema sawpaw</para>
  <para style="q1">sah thawpaw tuh athang cih;</para>
  <para style="q2">chanvuih kha zua khylan,</para>
  <para style="q1">hohtuh vema sabbath tuh athang cih?</para>
  <para style="q2">Ephah kha disah lan zah,</para>
  <para style="q1">shekel kha lesah lan,</para>
  <para style="q2">ahme leipaw zawccu khate ling lan hae,</para>
  <para style="q1">
    <verse number="6" style="v" />ahoy leipaw chanvuih kha zua lan zah,</para>
  <para style="q2">ryachi hae kha ngunphua te re lan hae,</para>
  <para style="q1">minyaa hae kha phanah bua kheit te</para>
  <para style="q2">re lan hae,” cite na hoku oh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" />
    <char style="nd">Bawipaw </char> nynh Jakob lesaenaw liate</para>
  <para style="q2">bya a kinku vae:</para>
  <para style="q2">Mih cyisahnaw kha papin ka ning lan khyh.</para>
  <para style="q1">
    <verse number="8" style="v" />E keiccuze laephi tuh hy leite</para>
  <para style="q2">a um cih zawtou?</para>
  <para style="q1">Laephi vawlan um hae paw balyn tuh</para>
  <para style="q2">rawkhui leite a um cih hae zawtou?</para>
  <para style="q1">Ram pynpi tuh Nal vawpi hawte</para>
  <para style="q2">a thokuh cih zah,</para>
  <para style="q1">Izip ram e Nal vawpi hawte</para>
  <para style="q2">a le koute siibung leite a um cih zawtou?</para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" />Bawipaw PACHIA nynh a hopaw tuh,</para>
  <para style="q2">tuin nin vae tuh, ninthu ccyh kya</para>
  <para style="q1">khuanin kha ka ccawsah cih zah,</para>
  <para style="q2">khuadae a aw ccyh khe laephi kha</para>
  <para style="q2">ka mohsah cih.</para>
  <para style="q1">
    <verse number="10" style="v" />Nae poi hae kha rawkhuinaw lang</para>
  <para style="q2">ka tangsah cih zah,</para>
  <para style="q1">nae hlaw hae kha rawnaw hlaw lang</para>
  <para style="q2">ka tangsah cih;</para>
  <para style="q1">ccungccaw balyn kha mih tae kya</para>
  <para style="q2">buriboei ka voisakuh cih hae zah,</para>
  <para style="q1">mih lu kha marya ka o cih hae;</para>
  <para style="q2">ccapaw lu kheit kyalyapaw chih zah</para>
  <para style="q1">a raw hae hawte nae poi kha</para>
  <para style="q2">ka thuasah cih zah,</para>
  <para style="q1">poi athangnaw tuh myarya khahpaw</para>
  <para style="q2">nin hawte ka thuasah cih.</para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" />Bawipaw PACHIA nynh a hopaw tuh,</para>
  <para style="q2">ram lungkhu kya ccakannaw ccyh tuh</para>
  <para style="q1">yn thua ccaccing cih;</para>
  <para style="q2">looh hanlan ccakannaw thua khyh,</para>
  <para style="q1">tui hanlan kanmawnaw mah thua leite,</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> bya thaenaw hanlan</para>
  <para style="q2">ccakannaw athua cih.</para>
  <para style="q1">
    <verse number="12" style="v" />Ccungccaw hae nynh</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> bya kha ccungte,</para>
  <para style="q1">a ccue bungthung cih hae,</para>
  <para style="q2">rili ccangkheit kyate rili ccangkheit kyacia,</para>
  <para style="q1">thahlang te nithua lang cia</para>
  <para style="q2">a khiakuh cih hae,</para>
  <para style="q1">thuasalama muih lan khyh hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" />Tuin nin vae tuh apuithyapaw</para>
  <para style="q2">liaccaw hae te ccangvae hae tuh</para>
  <para style="q2">tui kanmawte a bang cih hae.</para>
  <para style="q1">
    <verse number="14" style="v" />Samaria hae pachia Ashimah min te</para>
  <para style="q2">thyalawkute byakinkuh hae zah,</para>
  <para style="q1">“Pou Dan, na pachia tuh</para>
  <para style="q2">a hiin thyhte,” cite ho hae zah,</para>
  <para style="q1">“Beersheba laanpi tuh</para>
  <para style="q2">a hiin thyhte,” cite a hotu hae tuh</para>
  <para style="q1">a khuliakuh cih hae zah</para>
  <para style="q2">papin thokuh vae lan khyh hae.</para>
  <para style="b" />
  <chapter number="9" style="c" />
  <para style="s1">Israel Ronaw</para>
  <para style="p">
    <verse number="1" style="v" />Silawhang pe a thadynpaw <char style="nd">Bawipaw </char> kha ka muih, te aning nynh a hopaw tuh:</para>
  <para style="q1">Thuakawtung hae tuh ahy mawlaezung hae thuakawtung adung hae kha buatua;</para>
  <para style="q2">ccungccaw hae lu vawlan a ccawphu nawlan hae, thuakawtung hae kha khyatua hae;</para>
  <para style="q1">a laehy hae paw kha thaloi te</para>
  <para style="q2">ka theih cih hae;</para>
  <para style="q1">lu kheit sanmah ccue lan khyh hae,</para>
  <para style="q2">lu kheit sanmah lue lan khyh hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" />Sheol lang cia laephi a thaeku hae zemah,</para>
  <para style="q2">tuin kyate poh ka thuaa cih hae;</para>
  <para style="q1">vaawlang cia a kaethung hae zemah,</para>
  <para style="q2">tuin kyate ka sahbung cih hae.</para>
  <para style="q1">
    <verse number="3" style="v" />Karmel mua dung kya a reku hae zemah,</para>
  <para style="q2">ka ccung cih hae zah,</para>
  <para style="q2">tuin kyate ka kyng cih hae;</para>
  <para style="q1">rili kaw khe ka muihnaw kyate</para>
  <para style="q2">a reku hae zemah, rili kya-e</para>
  <para style="q1">hupi kha kaw ka pya cih zah,</para>
  <para style="q2">a khyh cih hae.</para>
  <para style="q1">
    <verse number="4" style="v" />Mih rhaw hae nynh kyng hae zah</para>
  <para style="q2">a cciakhae hae zemah, tuin kyakhe</para>
  <para style="q1">thaloi kha kaw ka pya cih zah,</para>
  <para style="q2">minmin kha a theih cih hae.</para>
  <para style="q1">hoynaw hanlan thua leite,</para>
  <para style="q2">vawsawnaw hanlan</para>
  <para style="q1">minmin kha riri ka do cih hae.</para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" />Bawipaw, vaaw PACHIA nynh</para>
  <para style="q2">laephi kha ty zah laephi tuh phe atui,</para>
  <para style="q1">laephi kya um hae paw balyn tuh</para>
  <para style="q2">a rah a khui hae,</para>
  <para style="q1">Nal vawpi hawte thokuh hae zah,</para>
  <para style="q2">Izip ram e Nal vawpi hawte,</para>
  <para style="q2">bua a ccahbung hae;</para>
  <para style="q1">
    <verse number="6" style="v" />Bawipaw nynh vaawlang khe</para>
  <para style="q2">avawlan khaan kha raekuh zah,</para>
  <para style="q1">laephi luki khe adawkuhpaw</para>
  <para style="q2">vaawlui kha a rae;</para>
  <para style="q2">rili tui kha ko zah,</para>
  <para style="q1">laephi vawlan khe a bu—</para>
  <para style="q2">a min tuh <char style="nd">Bawipaw </char> a cikuh.</para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" />Pou Israel hae, nanning tuh</para>
  <para style="q2">ka hanlan Ethiopia hae te</para>
  <para style="q1">na lokuh khyh oh tou? cite</para>
  <para style="q2">
    <char style="nd">Bawipaw </char> nynh a ci.</para>
  <para style="q1">Israel kha Izip ram kyate,</para>
  <para style="q2">Filistin hae kha Kaftor ram kyate,</para>
  <para style="q1">Aramean hae kha Kir ram kyate</para>
  <para style="q2">ka cciakhae khyh hae tou?</para>
  <para style="q1">
    <verse number="8" style="v" />Bawipaw PACHIA mit nynh</para>
  <para style="q2">aseipaw peenaw kha riri do zah,</para>
  <para style="q1">laephi vawlan kyate ka roh cih,</para>
  <para style="q2">thuasalama Jakob ciihan hae kha</para>
  <para style="q1">mih cii phe mih lan</para>
  <para style="q2">ka roh lan khyh hae, cite</para>
  <para style="qr">
    <char style="nd">Bawipaw </char> nynh a ci.</para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" />Kaw ka tho cih zah, looh kha</para>
  <para style="q2">pasaryh te ryh hawte,</para>
  <para style="q1">minphuin hae balyn laku kya</para>
  <para style="q2">Israel hae kha ka ryh cih hae,</para>
  <para style="q1">ccathae pynkheit sanmah</para>
  <para style="q2">laekhu lang ccah lan khyh.</para>
  <para style="q1">
    <verse number="10" style="v" />“Hoyleinaw nynh kaening kha</para>
  <para style="q2">oun phah lan khyh, tung mah</para>
  <para style="q1">kae tung lan khyh,” cite a ho hae paw,</para>
  <para style="q2">ka ccungccaw misei hae balyn tuh</para>
  <para style="q1">thaloi te a chih cih hae.</para>
  <para style="b" />
  <para style="s1">David Peenaw Muethuinaw</para>
  <para style="q1">
    <verse number="11" style="v" />Tuin nin vae tuh a pu vae paw David bu kha</para>
  <para style="q2">ka thadynsah thui cih,</para>
  <para style="q1">pang a uanaw kha ka pingthui cih zah,</para>
  <para style="q2">a ronaw kha ka cyihthui cih,</para>
  <para style="q2">bu kha langmawlya hawte ka sakthui cih.<note caller="-" style="x"><char style="xo" closed="false">9.11-12: </char><char style="xt" closed="false"><ref loc="ACT 15:16-18">Loc 15.16-18</ref></char></note></para>
  <para style="q1">
    <verse number="12" style="v" />Tuhteze nynh Edom ram kya</para>
  <para style="q2">a laehy hae paw te</para>
  <para style="q2">ka min te ko athua hae paw</para>
  <para style="q1">minphuin hae balyn kha minmin nynh</para>
  <para style="q2">a ccou cih hae, cite</para>
  <para style="q1">e rya a lahtupaw <char style="nd">Bawipaw </char> nynh a ci.</para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" />
    <char style="nd">Bawipaw </char> nynh a hopaw tuh,</para>
  <para style="q2">lei a thuepaw nynh looh a ruetupaw kha</para>
  <para style="q1">a phya ccyh te misutui a sutupaw nynh</para>
  <para style="q2">acii a lintupaw kha</para>
  <para style="q1">a phya ccyh tuh yn thua ccaccing cih;</para>
  <para style="q2">mua hae kyate misutui abya ccyh te</para>
  <para style="q1">sangpyng hae balyn kyate</para>
  <para style="q2">misutui alua ccyh tuh yn thua ccaccing cih.</para>
  <para style="q1">
    <verse number="14" style="v" />Ka ccungccaw Israel hae kha</para>
  <para style="q2">ka kikhae cih hae,</para>
  <para style="q1">aroh vae paw khuapi hae kha</para>
  <para style="q2">a raethui cih hae zah a umnah cih hae;</para>
  <para style="q1">misu khokhu kha a raekuh cih hae zah,</para>
  <para style="q2">mih misutui kha a neih cih hae,</para>
  <para style="q1">khokhu kha a raekuh cih hae zah,</para>
  <para style="q2">mih thingthae kha a ae cih hae.</para>
  <para style="q1">
    <verse number="15" style="v" />Minmin kha mih laephi vawlan khe</para>
  <para style="q2">ka lin cih hae zah,</para>
  <para style="q1">ka pya vae hae paw laephi kyate</para>
  <para style="q2">minmin kha poh khaeethui</para>
  <para style="q1">papin thua vae lan khyh hae, cite</para>
  <para style="qr">
    <char style="nd">Bawipaw </char> nae Pachia nynh a ci.</para>
</usx>