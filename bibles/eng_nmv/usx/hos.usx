<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="HOS" style="id">- Tov Rose New Messianic Version Bible</book>
  <para style="h">Hosea</para>
  <para style="mt">Hosea</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />The word of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> that came unto Hoshea <char style="add">[salvation]</char>, the son of Be’eri <char style="add">[my well]</char>, in the days of ‘Uziyah <char style="add">[my strength is Yehovah]</char>, Toram <char style="add">[Yehovah is Perfect]</char>, Achaz <char style="add">[he has grasped]</char>, <char style="add">[and]</char> Hizkiyahu <char style="add">[Yehovah is my strength]</char>, kings of Y’hudah <char style="add">[Let Him (God) Be Praised]</char>, and in the days of Yarov’am <char style="add">[the people will contend]</char> the son of Yo’ash <char style="add">[Given by the Lord]</char>, king of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="2" style="v" />The beginning of the word of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> by Hoshea <char style="add">[salvation]</char>. And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> said to Hoshea <char style="add">[salvation]</char>, Go, take unto you<char style="ord">i</char> a wife of cult prostitution and children of cult prostitution: for the land has committed great whoredom, <char style="add">[departing]</char> from the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="3" style="v" />So he went and took Gomer <char style="add">[complete]</char> the daughter of Divlayim <char style="add">[two cakes]</char>; which conceived, and bore him a son.</para>
  <para style="p">
    <verse number="4" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> said unto him, Call his name Yizre’el <char style="add">[God Sows]</char>; for yet a little <char style="add">[while]</char>, and I will avenge the blood of Yizre’el <char style="add">[God Sows]</char> upon the house of Yehu <char style="add">[Yehovah is He]</char>, and will cause to cease the kingdom of the house of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="5" style="v" />And it shall come to pass at that day, that I will break the bow of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> in the valley of Yizre’el <char style="add">[God Sows]</char>.</para>
  <para style="p">
    <verse number="6" style="v" />And she conceived again, and bore a daughter. And [God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>] said unto him, Call her name Lo-Ruchamah <char style="add">[no mercy]</char>: for I will no more have mercy upon the house of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>; but I will utterly take them away.</para>
  <para style="p">
    <verse number="7" style="v" />But I will have mercy upon the house of Y’hudah <char style="add">[Let Him (God) Be Praised]</char>, and will save them by the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> their God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>, and will not save them by bow, nor by sword, nor by battle, by horses, nor by horsemen.</para>
  <para style="p">
    <verse number="8" style="v" />Now when she had weaned Lo-Ruchamah <char style="add">[no mercy]</char>, she conceived, and bore a son.</para>
  <para style="p">
    <verse number="9" style="v" />Then said [God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>], Call his name Lo-’Ammi <char style="add">[not my people]</char>: for you<char style="ord">2f</char> <char style="add">[are]</char> not my people, and I will not be your [God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>].</para>
  <para style="p">
    <verse number="10" style="v" />Yet the number of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> shall be as the sand of the sea, which cannot be measured nor numbered; and it shall come to pass, <char style="add">[that]</char> in the place where it was said unto them, You<char style="ord">2f</char> <char style="add">[are]</char> not my people, <char style="add">[there]</char> it shall be said unto them, <char style="add">[You<char style="ord">2f</char> are]</char> the sons of the living God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>.</para>
  <para style="p">
    <verse number="11" style="v" />Then shall the children of Y’hudah <char style="add">[Let Him (God) Be Praised]</char> and the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> be gathered together, and appoint themselves one head, and they shall come up out of the land: for great <char style="add">[shall be]</char> the day of Yizre’el <char style="add">[God Sows]</char>.</para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Say you<char style="ord">2f</char> unto your brethren, ‘Ammi <char style="add">[my people]</char>; and to your sisters, ‘Ruchamah <char style="add">[pitied]</char>.</para>
  <para style="p">
    <verse number="2" style="v" />Plead with your mother, plead: for she <char style="add">[is]</char> not my wife, neither <char style="add">[am]</char> I her husband: let her therefore put away her cult prostitution out of her sight, and her adulteries from between her breasts;</para>
  <para style="p">
    <verse number="3" style="v" />Lest I strip her naked, and set her as in the day that she was born, and make her as a wilderness, and set her like a dry land, and slay her with thirst.</para>
  <para style="p">
    <verse number="4" style="v" />And I will not have mercy upon her children; for they <char style="add">[be]</char> the children of cult prostitution.</para>
  <para style="p">
    <verse number="5" style="v" />For their mother has played the prostitute: she that conceived them has done shamefully: for she said, I will go after my lovers, that give <char style="add">[me]</char> my bread and my water, my wool and my flax, my oil and my drink.</para>
  <para style="p">
    <verse number="6" style="v" />Therefore, behold, I will hedge up your<char style="ord">i</char> way with thorns, and make a wall, that she shall not find her paths.</para>
  <para style="p">
    <verse number="7" style="v" />And she shall follow after her lovers, but she shall not overtake them; and she shall seek them, but shall not find <char style="add">[them]</char>: then shall she say, I will go and return to my first husband; for then <char style="add">[was it]</char> better with me than now.</para>
  <para style="p">
    <verse number="8" style="v" />For she did not know that I gave her corn, and wine, and oil, and multiplied her silver and gold, <char style="add">[which]</char> they prepared for Ba’al <char style="add">[lord (a false god)]</char>.</para>
  <para style="p">
    <verse number="9" style="v" />Therefore will I return, and take away my corn in the time thereof, and my wine in the season thereof, and will recover my wool and my flax <char style="add">[given]</char> to cover her nakedness.</para>
  <para style="p">
    <verse number="10" style="v" />And now will I reveal her lewdness in the sight of her lovers, and none shall deliver her out of my hand.</para>
  <para style="p">
    <verse number="11" style="v" />I will also cause all her gladness to cease, her feast days, her new moons, and her Shabbat, and all her solemn feasts.</para>
  <para style="p">
    <verse number="12" style="v" />And I will destroy her vines and her fig trees, whereof she has said, These <char style="add">[are]</char> my rewards that my lovers have given me: and I will make them a forest, and the beasts of the field shall eat them.</para>
  <para style="p">
    <verse number="13" style="v" />And I will visit upon her the days of Ba’alim <char style="add">[lords (false gods)]</char>, wherein she burned incense to them, and she decked herself with her earrings and her jewels, and she went after her lovers, and forgot me, says the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="14" style="v" />Therefore, behold, I will allure her, and bring her into the wilderness, and speak comfortably unto her.</para>
  <para style="p">
    <verse number="15" style="v" />And I will give her vineyards from there, and the valley of Akhor <char style="add">[Trouble]</char> for a door of hope: and she shall sing there, as in the days of her youth, and as in the day when she came up out of the land of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>.</para>
  <para style="p">
    <verse number="16" style="v" />And it shall be at that day, says the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, <char style="add">[that]</char> you<char style="ord">i</char> shall call me Ishi <char style="add">[My Husband]</char>; and shall call me no more Ba’ali <char style="add">[lord (a false god)]</char>.</para>
  <para style="p">
    <verse number="17" style="v" />For I will take away the names of Ba’alim <char style="add">[lords (false gods)]</char> out of her mouth, and they shall no more be remembered by their name.</para>
  <para style="p">
    <verse number="18" style="v" />And in that day will I make a covenant for them with the beasts of the field, and with the fowls of heaven, and <char style="add">[with]</char> the creeping things of the ground: and I will break the bow and the sword and the battle out of the earth, and will make them to lie down safely.</para>
  <para style="p">
    <verse number="19" style="v" />And I will betroth you<char style="ord">i</char> unto me forever; yes, I will betroth you<char style="ord">i</char> unto me in righteousness, and in judgment, and in lovingkindness, and in mercies.</para>
  <para style="p">
    <verse number="20" style="v" />I will even betroth you<char style="ord">i</char> unto me in faithfulness: and you<char style="ord">i</char> shall know the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="21" style="v" />And it shall come to pass in that day, I will hear, says the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, I will hear the heavens, and they shall hear the earth;</para>
  <para style="p">
    <verse number="22" style="v" />And the earth shall hear the corn, and the wine, and the oil; and they shall hear Yizre’el <char style="add">[God Sows]</char>.</para>
  <para style="p">
    <verse number="23" style="v" />And I will sow her unto me in the earth; and I will have mercy upon her that had not obtained mercy; and I will say to <char style="add">[them which were]</char> not my people, you<char style="ord">i</char> <char style="add">[are]</char> my people; and they shall say, <char style="add">[you<char style="ord">i</char> are]</char> my God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>.</para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />Then said the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> unto me, Go yet, love a woman beloved of <char style="add">[her]</char> friend, yet an adulteress, according to the love of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> toward the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, who look to other gods, and love raisin cakes.</para>
  <para style="p">
    <verse number="2" style="v" />So I bought her to me for fifteen <char style="add">[pieces]</char> of silver, and <char style="add">[for]</char> an homer of barley, and an half homer of barley:</para>
  <para style="p">
    <verse number="3" style="v" />And I said unto her, you<char style="ord">i</char> shall abide for me many days; you<char style="ord">i</char> shall not play the prostitute, and you<char style="ord">i</char> shall not be for <char style="add">[another]</char> man: so <char style="add">[will]</char> I also <char style="add">[be]</char> for you<char style="ord">i</char>.</para>
  <para style="p">
    <verse number="4" style="v" />For the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> shall abide many days without a king, and without a prince, and without a sacrifice, and without an image, and without an ephod <char style="pn">(vest)</char>, and <char style="add">[without]</char> teraphim <char style="pn">(household gods)</char>:</para>
  <para style="p">
    <verse number="5" style="v" />Afterward shall the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> return, and seek the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> their God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>, and David <char style="add">[beloved]</char> their king; and shall fear the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> and his goodness in the latter days.</para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hear the word of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, you<char style="ord">2f</char> people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>: for the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> has a controversy with the inhabitants of the land, because <char style="add">[there is]</char> no truth, nor mercy, nor knowledge of God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> in the land.</para>
  <para style="p">
    <verse number="2" style="v" />By swearing, and lying, and killing, and stealing, and committing adultery, they break out, and blood touches blood.</para>
  <para style="p">
    <verse number="3" style="v" />Therefore shall the land mourn, and everyone that dwells in it shall languish, with the beasts of the field, and with the fowls of heaven; yes, the fishes of the sea also shall be taken away.</para>
  <para style="p">
    <verse number="4" style="v" />Yet let no man strive, nor reprove another: for your<char style="ord">i</char> people <char style="add">[are]</char> as they that strive with the priest.</para>
  <para style="p">
    <verse number="5" style="v" />Therefore shall you<char style="ord">i</char> fall in the day, and the prophet also shall fall with you<char style="ord">i</char> in the night, and I will destroy your<char style="ord">i</char> mother.</para>
  <para style="p">
    <verse number="6" style="v" />My people are destroyed for lack of knowledge: because you<char style="ord">i</char> have rejected knowledge, I will also reject you<char style="ord">i</char>, that you<char style="ord">i</char> shall be no priest to me: seeing you<char style="ord">i</char> have forgotten the law of your<char style="ord">i</char> God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>, I will also forget your<char style="ord">i</char> children.</para>
  <para style="p">
    <verse number="7" style="v" />As they were increased, so they sinned against me: <char style="add">[therefore]</char> will I change their glory into shame.</para>
  <para style="p">
    <verse number="8" style="v" />They eat up the sin of my people, and they set their heart on their iniquity.</para>
  <para style="p">
    <verse number="9" style="v" />And there shall be, like people, like priest: and I will punish them for their ways, and reward them their doings.</para>
  <para style="p">
    <verse number="10" style="v" />For they shall eat, and not have enough: they shall commit whoredom, and shall not increase: because they have left off to take heed to the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="11" style="v" />Whoredom and wine and New Wine take away the heart.</para>
  <para style="p">
    <verse number="12" style="v" />My people ask counsel at their stocks, and their staff declares unto them: for the spirit of cult prostitution has caused <char style="add">[them]</char> to err, and they have gone a whoring from under their God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>.</para>
  <para style="p">
    <verse number="13" style="v" />They sacrifice upon the tops of the mountains, and burn incense upon the hills, under oaks and poplars and elms, because the shadow thereof <char style="add">[is]</char> good: therefore your daughters shall commit whoredom, and your spouses shall commit adultery.</para>
  <para style="p">
    <verse number="14" style="v" />I will not punish your daughters when they commit whoredom, nor your spouses when they commit adultery: for themselves are separated with whores, and they sacrifice with prostitutes: therefore the people <char style="add">[that]</char> does not understand shall fall.</para>
  <para style="p">
    <verse number="15" style="v" />Though you<char style="ord">i</char>, Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, play the prostitute, <char style="add">[yet]</char> let not Y’hudah <char style="add">[Let Him (God) Be Praised]</char> offend <char style="pn">(make angry; make one stumble; violate)</char>; and come not you<char style="ord">2f</char> unto Gilgal <char style="add">[A Wheel, Rolling]</char>, neither go you<char style="ord">2f</char> up to Beit-On <char style="add">[vanity] [house of vanity]</char>, nor swear, The LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> lives.</para>
  <para style="p">
    <verse number="16" style="v" />For Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> slides back as a backsliding heifer: now the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> will feed them as a lamb in a large place.</para>
  <para style="p">
    <verse number="17" style="v" />Efrayim <char style="add">[Doubly Fruitful] [is]</char> joined to idols: let him alone.</para>
  <para style="p">
    <verse number="18" style="v" />Their drink is sour: they have committed whoredom continually: her rulers <char style="add">[with]</char> shame do love, Give you<char style="ord">2f</char>.</para>
  <para style="p">
    <verse number="19" style="v" />The wind has bound her up in her wings, and they shall be ashamed because of their sacrifices.</para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hear you<char style="ord">2f</char> this, O priests; and hearken, you<char style="ord">2f</char> house of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>; and give you<char style="ord">2f</char> ear, O house of the king; for judgment <char style="add">[is]</char> toward you, because you<char style="ord">2f</char> have been a snare on Mitzpah <char style="add">[watchtower]</char>, and a net spread upon Tavor <char style="add">[Mound]</char>.</para>
  <para style="p">
    <verse number="2" style="v" />And the revolters are profound <char style="pn">(go deep into something)</char> to make slaughter, though I <char style="add">[have been]</char> a rebuker of them all.</para>
  <para style="p">
    <verse number="3" style="v" />I know Efrayim <char style="add">[Doubly Fruitful]</char>, and Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> is not hid from me: for now, O Efrayim <char style="add">[Doubly Fruitful]</char>, you<char style="ord">i</char> commits whoredom, <char style="add">[and]</char> Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> is defiled.</para>
  <para style="p">
    <verse number="4" style="v" />They will not frame their doings to turn unto their God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>: for the spirit of cult prostitution <char style="add">[is]</char> in the midst of them, and they have not known the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="5" style="v" />And the pride of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> does testify to his face: therefore shall Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> and Efrayim <char style="add">[Doubly Fruitful]</char> fall in their iniquity; Y’hudah <char style="add">[Let Him (God) Be Praised]</char> also shall fall with them.</para>
  <para style="p">
    <verse number="6" style="v" />They shall go with their flocks and with their herds to seek the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>; but they shall not find <char style="add">[him]</char>; he has withdrawn himself from them.</para>
  <para style="p">
    <verse number="7" style="v" />They have dealt treacherously against the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>: for they have begotten strange children: now shall a month devour them with their portions.</para>
  <para style="p">
    <verse number="8" style="v" />Blow you<char style="ord">2f</char> the cornet <char style="pn">(a wind instrument; horn; trumpet)</char> in Giv’ah <char style="add">[Hill]</char>, <char style="add">[and]</char> the trumpet in Ramah <char style="add">[Hill]</char>: cry aloud <char style="add">[at]</char> Beit-On <char style="add">[vanity] [house of vanity]</char>, after you<char style="ord">i</char>, O Binyamin <char style="add">[Son of the Right Hand/Strength]</char>.</para>
  <para style="p">
    <verse number="9" style="v" />Efrayim <char style="add">[Doubly Fruitful]</char> shall be desolate in the day of rebuke <char style="pn">(reprimand; strongly warn; restrain)</char>: among the tribes of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> have I made known that which shall surely be.</para>
  <para style="p">
    <verse number="10" style="v" />The princes of Y’hudah <char style="add">[Let Him (God) Be Praised]</char> were like them that remove the bound: <char style="add">[therefore]</char> I will pour out my wrath upon them like water.</para>
  <para style="p">
    <verse number="11" style="v" />Efrayim <char style="add">[Doubly Fruitful] [is]</char> oppressed <char style="add">[and]</char> broken in judgment, because he willingly walked after the commandment.</para>
  <para style="p">
    <verse number="12" style="v" />Therefore <char style="add">[will]</char> I <char style="add">[be]</char> unto Efrayim <char style="add">[Doubly Fruitful]</char> as a moth, and to the house of Y’hudah <char style="add">[Let Him (God) Be Praised]</char> as rottenness.</para>
  <para style="p">
    <verse number="13" style="v" />When Efrayim <char style="add">[Doubly Fruitful]</char> saw his sickness, and Y’hudah <char style="add">[Let Him (God) Be Praised] [saw]</char> his wound, then went Efrayim <char style="add">[Doubly Fruitful]</char> to the Ashur <char style="pn">(Assyrian)</char>, and sent to king Yarav <char style="add">[contender]</char>: yet could he not heal you, nor cure you of your wound.</para>
  <para style="p">
    <verse number="14" style="v" />For I <char style="add">[will be]</char> unto Efrayim <char style="add">[Doubly Fruitful]</char> as a lion, and as a young lion to the house of Y’hudah <char style="add">[Let Him (God) Be Praised]</char>: I, <char style="add">[even]</char> I, will tear and go away; I will take away, and none shall rescue <char style="add">[him]</char>.</para>
  <para style="p">
    <verse number="15" style="v" />I will go <char style="add">[and]</char> return to my place, till they acknowledge their offence, and seek my face: in their affliction they will seek me early.</para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Come, and let us return unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>: for he has torn, and he will heal us; he has smitten, and he will bind us up.</para>
  <para style="p">
    <verse number="2" style="v" />After two days will he revive us: in the third day he will raise us up, and we shall live in his sight.</para>
  <para style="p">
    <verse number="3" style="v" />Then shall we know, <char style="add">[if]</char> we follow on to know the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>: his going forth is prepared as the morning; and he shall come unto us as the rain, as the latter <char style="add">[and]</char> former rain unto the earth.</para>
  <para style="p">
    <verse number="4" style="v" />O Efrayim <char style="add">[Doubly Fruitful]</char>, what shall I do unto you<char style="ord">i</char>? O Y’hudah <char style="add">[Let Him (God) Be Praised]</char>, what shall I do unto you<char style="ord">i</char>? for your goodness <char style="add">[is]</char> as a morning cloud, and as the early dew it goes away.</para>
  <para style="p">
    <verse number="5" style="v" />Therefore have I hewed <char style="add">[them]</char> by the prophets; I have slain them by the words of my mouth: and your<char style="ord">i</char> judgments <char style="add">[are as]</char> the light <char style="add">[that]</char> goes forth.</para>
  <para style="p">
    <verse number="6" style="v" />For I desired mercy, and not sacrifice; and the knowledge of God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> more than burnt offerings.</para>
  <para style="p">
    <verse number="7" style="v" />But they like men have transgressed the covenant: there have they dealt treacherously against me.</para>
  <para style="p">
    <verse number="8" style="v" />Gil’ad <char style="add">[Rocky Region] [is]</char> a city of them that work iniquity, <char style="add">[and is]</char> polluted with blood.</para>
  <para style="p">
    <verse number="9" style="v" />And as troops of robbers wait for a man, <char style="add">[so]</char> the company of priests murder in the way by consent: for they commit lewdness.</para>
  <para style="p">
    <verse number="10" style="v" />I have seen an horrible thing in the house of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>: there <char style="add">[is]</char> the whoredom of Efrayim <char style="add">[Doubly Fruitful]</char>, Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> is defiled.</para>
  <para style="p">
    <verse number="11" style="v" />Also, O Y’hudah <char style="add">[Let Him (God) Be Praised]</char>, he has set an harvest for you<char style="ord">i</char>, when I returned the captivity of my people.</para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />When I would have healed Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, then the iniquity of Efrayim <char style="add">[Doubly Fruitful]</char> was discovered, and the wickedness of Shomron <char style="add">[watch mountain]</char>: for they commit falsehood; and the thief comes in, <char style="add">[and]</char> the troop of robbers spoils without.</para>
  <para style="p">
    <verse number="2" style="v" />And they consider not in their hearts <char style="add">[that]</char> I remember all their wickedness: now their own doings have beset them about; they are before my face.</para>
  <para style="p">
    <verse number="3" style="v" />They make the king glad with their wickedness, and the princes with their lies.</para>
  <para style="p">
    <verse number="4" style="v" />They <char style="add">[are]</char> all adulterers, as an oven heated by the baker, <char style="add">[who]</char> ceases from raising after he has kneaded the dough, until it be leavened.</para>
  <para style="p">
    <verse number="5" style="v" />In the day of our king the princes have made <char style="add">[him]</char> sick with bottles of wine; he stretched out his hand with scorners.</para>
  <para style="p">
    <verse number="6" style="v" />For they have made ready their heart like an oven, whiles they lie in wait: their baker sleeps all the night; in the morning it burns as a flaming fire.</para>
  <para style="p">
    <verse number="7" style="v" />They are all hot as an oven, and have devoured their judges; all their kings are fallen: <char style="add">[there is]</char> none among them that calls unto me.</para>
  <para style="p">
    <verse number="8" style="v" />Efrayim <char style="add">[Doubly Fruitful]</char>, he has mixed himself among the people; Efrayim <char style="add">[Doubly Fruitful]</char> is a cake not turned.</para>
  <para style="p">
    <verse number="9" style="v" />Strangers have devoured his strength, and he knows <char style="add">[it]</char> not: yes, gray hairs are here and there upon him, yet he knows not.</para>
  <para style="p">
    <verse number="10" style="v" />And the pride of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> testifies to his face: and they do not return to the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> their God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>, nor seek him for all this.</para>
  <para style="p">
    <verse number="11" style="v" />Efrayim <char style="add">[Doubly Fruitful]</char> also is like a silly dove without heart: they call to <char style="pn">(to do entirely, do wholly)</char> Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>, they go to Ashur <char style="add">[the level plain]</char> <char style="pn">(the land of the sons of Shem (name, renown (great reputation; being well-known)))</char>.</para>
  <para style="p">
    <verse number="12" style="v" />When they shall go, I will spread my net upon them; I will bring them down as the fowls of the heaven; I will chastise them, as their congregation has heard.</para>
  <para style="p">
    <verse number="13" style="v" />Woe unto them! for they have fled from me: destruction unto them! because they have transgressed against me: though I have redeemed them, yet they have spoken lies against me.</para>
  <para style="p">
    <verse number="14" style="v" />And they have not cried unto me with their heart, when they howled upon their beds: they assemble themselves for corn and wine, <char style="add">[and]</char> they rebel against me.</para>
  <para style="p">
    <verse number="15" style="v" />Though I have bound <char style="add">[and]</char> strengthened their arms, yet do they imagine mischief against me.</para>
  <para style="p">
    <verse number="16" style="v" />They return, <char style="add">[but]</char> not to the most High: they are like a deceitful bow: their princes shall fall by the sword for the rage of their tongue: this <char style="add">[shall be]</char> their ridicule <char style="pn">(laughing at enemies’ threats)</char> in the land of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>.</para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />
    <char style="add">[Set]</char> the trumpet to your<char style="ord">i</char> mouth. <char style="add">[He shall come]</char> as an eagle against the house of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, because they have transgressed my covenant, and trespassed against my law.</para>
  <para style="p">
    <verse number="2" style="v" />Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> shall cry unto me, My God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>, we know you<char style="ord">i</char>.</para>
  <para style="p">
    <verse number="3" style="v" />Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> has cast off <char style="add">[the thing that is]</char> good: the enemy shall pursue him.</para>
  <para style="p">
    <verse number="4" style="v" />They have set up kings, but not by me: they have made princes, and I knew <char style="add">[it]</char> not: of their silver and their gold have they made them idols, that they may be cut off.</para>
  <para style="p">
    <verse number="5" style="v" />You<char style="ord">1s</char> calf, O Shomron <char style="add">[watch mountain]</char>, has cast <char style="pn">[you<char style="ord">i</char>]</char> off; my anger is kindled against them: how long <char style="add">[will it be]</char> before they attain to innocency?</para>
  <para style="p">
    <verse number="6" style="v" />For from Yisra’el <char style="add">[He Holds Onto The Heel Of God] [was]</char> it also: the workman made it; therefore it <char style="add">[is]</char> not God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>: but the calf of Shomron <char style="add">[watch mountain]</char> shall be broken in pieces.</para>
  <para style="p">
    <verse number="7" style="v" />For they have sown the wind, and they shall reap the whirlwind: it has no stalk: the bud shall yield no meal: if so be it yield, the strangers shall swallow <char style="pn">(to approve, commend, accept)</char> it up.</para>
  <para style="p">
    <verse number="8" style="v" />Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> is swallow (to approve, commend, accept)ed up: now shall they be among the Gentiles as a vessel wherein <char style="add">[is]</char> no pleasure.</para>
  <para style="p">
    <verse number="9" style="v" />For they are gone up to Ashur <char style="add">[the level plain]</char> <char style="pn">(the land of the sons of Shem (name, renown (great reputation; being well-known)))</char>, a wild ass alone by himself: Efrayim <char style="add">[Doubly Fruitful]</char> has hired lovers.</para>
  <para style="p">
    <verse number="10" style="v" />Yes, though they have hired among the nations, now will I gather them, and they shall sorrow a little for the burden of the king of princes.</para>
  <para style="p">
    <verse number="11" style="v" />Because Efrayim <char style="add">[Doubly Fruitful]</char> has made many altars to sin, altars shall be unto him to sin.</para>
  <para style="p">
    <verse number="12" style="v" />I have written to him the great things of my law, <char style="add">[but]</char> they were counted as a strange thing.</para>
  <para style="p">
    <verse number="13" style="v" />They sacrifice flesh <char style="add">[for]</char> the sacrifices of my offerings, and eat <char style="add">[it; but]</char> the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> accepts them not; now will he remember their iniquity, and visit their sins: they shall return to Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>.</para>
  <para style="p">
    <verse number="14" style="v" />For Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> has forgotten his Maker, and builds temples; and Y’hudah <char style="add">[Let Him (God) Be Praised]</char> has multiplied fenced cities: but I will send a fire upon his cities, and it shall devour the palaces thereof.</para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />Rejoice not, O Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, for joy, as <char style="add">[other]</char> people: for you<char style="ord">i</char> have gone a whoring from your<char style="ord">i</char> God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>, you<char style="ord">i</char> have loved a reward upon every corn floor.</para>
  <para style="p">
    <verse number="2" style="v" />The floor and the winepress shall not feed them, and the New Wine shall fail in her.</para>
  <para style="p">
    <verse number="3" style="v" />They shall not dwell in the LORD-Yehōvah’s <char style="add">[Messiah Pre-Incarnate]</char> land; but Efrayim <char style="add">[Doubly Fruitful]</char> shall return to Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>, and they shall eat unclean <char style="add">[things]</char> in Ashur <char style="add">[the level plain]</char> <char style="pn">(the land of the sons of Shem (name, renown (great reputation; being well-known)))</char>.</para>
  <para style="p">
    <verse number="4" style="v" />They shall not offer wine <char style="add">[offerings]</char> to the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, neither shall they be pleasing unto him: their sacrifices <char style="add">[shall be]</char> unto them as the bread of mourners; all that eat thereof shall be polluted: for their bread for their soul shall not come into the house of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="5" style="v" />What will you<char style="ord">2f</char> do in the solemn day, and in the day of the feast of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>?</para>
  <para style="p">
    <verse number="6" style="v" />For, lo, they are gone because of destruction: Mitzrayim <char style="add">[Egypt - The Narrow Place]</char> shall gather them up, Memphis shall bury them: the pleasant <char style="add">[places]</char> for their silver, nettles shall possess them: thorns <char style="add">[shall be]</char> in their tabernacles.</para>
  <para style="p">
    <verse number="7" style="v" />The days of visitation are come, the days of recompense are come; Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> shall know <char style="add">[it]</char>: the prophet <char style="add">[is]</char> a fool, the spiritual man <char style="add">[is]</char> mad, for the multitude of you<char style="ord">i</char> iniquity, and the great hatred.</para>
  <para style="p">
    <verse number="8" style="v" />The watchman of Efrayim <char style="add">[Doubly Fruitful] [was]</char> with my God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>: <char style="add">[but]</char> the prophet <char style="add">[is]</char> a snare of a fowler in all his ways, <char style="add">[and]</char> hatred in the house of his God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>.</para>
  <para style="p">
    <verse number="9" style="v" />They have deeply corrupted <char style="add">[themselves]</char>, as in the days of Giv’ah <char style="add">[Hill]</char>: <char style="add">[therefore]</char> he will remember their iniquity, he will visit their sins.</para>
  <para style="p">
    <verse number="10" style="v" />I found Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> like grapes in the wilderness; I saw your fathers as the firstripe in the fig tree at her first time: <char style="add">[but]</char> they went to Ba’al-P’or <char style="add">[Lord of the Opening]</char>, and separated themselves unto <char style="add">[that]</char> shame; and <char style="add">[their]</char> abominations were according as they loved.</para>
  <para style="p">
    <verse number="11" style="v" />
    <char style="add">[As for]</char> Efrayim <char style="add">[Doubly Fruitful]</char>, their glory shall fly away like a bird, from the birth, and from the womb, and from the conception.</para>
  <para style="p">
    <verse number="12" style="v" />Though they bring up their children, yet will I bereave them, <char style="add">[that there shall]</char> not <char style="add">[be]</char> a man <char style="add">[left]</char>: yes, woe also to them when I depart from them!</para>
  <para style="p">
    <verse number="13" style="v" />Efrayim <char style="add">[Doubly Fruitful]</char>, as I saw Tzor <char style="pn">(Tyrus)</char> <char style="add">[a rock]</char>, <char style="add">[is]</char> planted in a pleasant place: but Efrayim <char style="add">[Doubly Fruitful]</char> shall bring forth his children to the murderer.</para>
  <para style="p">
    <verse number="14" style="v" />Give them, O LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>: what will you<char style="ord">i</char> give? give them a miscarrying womb and dry breasts.</para>
  <para style="p">
    <verse number="15" style="v" />All their wickedness <char style="add">[is]</char> in Gilgal <char style="add">[A Wheel, Rolling]</char>: for there I hated them: for the wickedness of their doings I will drive them out of my house, I will love them no more: all their princes <char style="add">[are]</char> revolters.</para>
  <para style="p">
    <verse number="16" style="v" />Efrayim <char style="add">[Doubly Fruitful]</char> is smitten, their root is dried up, they shall bear no fruit: yes, though they bring forth, yet will I slay <char style="add">[even]</char> the beloved <char style="add">[fruit]</char> of their womb.</para>
  <para style="p">
    <verse number="17" style="v" />My God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> will cast them away, because they did not hearken unto him: and they shall be wanderers among the nations.</para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />Yisra’el <char style="add">[He Holds Onto The Heel Of God] [is]</char> an empty vine, he brings forth fruit unto himself: according to the multitude of his fruit he has increased the altars; according to the goodness of his land they have made goodly images.</para>
  <para style="p">
    <verse number="2" style="v" />Their heart is divided; now shall they be found faulty: he shall break down their altars, he shall spoil <char style="pn">(plunder; prey; booty)</char> their images.</para>
  <para style="p">
    <verse number="3" style="v" />For now they shall say, We have no king, because we feared not the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>; what then should a king do to us?</para>
  <para style="p">
    <verse number="4" style="v" />They have spoken words, swearing falsely in making a covenant: thus judgment springs up as hemlock in the furrows of the field.</para>
  <para style="p">
    <verse number="5" style="v" />The inhabitants of Shomron <char style="add">[watch mountain]</char> shall fear because of the calves of Beit-On <char style="add">[vanity] [house of vanity]</char>: for the people thereof shall mourn over it, and the priests thereof <char style="add">[that]</char> rejoiced on it, for the glory thereof, because it is departed from it.</para>
  <para style="p">
    <verse number="6" style="v" />It shall be also carried unto Ashur <char style="add">[the level plain]</char> <char style="pn">(the land of the sons of Shem (name, renown (great reputation; being well-known)))</char> <char style="add">[for]</char> a present to king Yarav <char style="add">[contender]</char>: Efrayim <char style="add">[Doubly Fruitful]</char> shall receive shame, and Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> shall be ashamed of his own counsel.</para>
  <para style="p">
    <verse number="7" style="v" />
    <char style="add">[As for]</char> Shomron <char style="add">[watch mountain]</char>, her king is cut off as the foam upon the water.</para>
  <para style="p">
    <verse number="8" style="v" />The high places also of On <char style="add">[vanity]</char>, the sin of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, shall be destroyed: the thorn and the thistle shall come up on their altars; and they shall say to the mountains, Cover us; and to the hills, Fall on us.</para>
  <para style="p">
    <verse number="9" style="v" />O Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, you<char style="ord">i</char> have sinned from the days of Giv’ah <char style="add">[Hill]</char>: there they stood: the battle in Giv’ah <char style="add">[Hill]</char> against the children of iniquity did not overtake them.</para>
  <para style="p">
    <verse number="10" style="v" />
    <char style="add">[It is]</char> in my desire that I should chastise them; and the people shall be gathered against them, when they shall bind themselves in their two furrows.</para>
  <para style="p">
    <verse number="11" style="v" />And Efrayim <char style="add">[Doubly Fruitful] [is as]</char> an heifer <char style="add">[that is]</char> taught, <char style="add">[and]</char> loves to trample out <char style="add">[the corn]</char>; but I passed over upon her fair neck: I will make Efrayim <char style="add">[Doubly Fruitful]</char> to ride; Y’hudah <char style="add">[Let Him (God) Be Praised]</char> shall plow, <char style="add">[and]</char> Ya’akov <char style="add">[Heal of God]</char> shall break his clods.</para>
  <para style="p">
    <verse number="12" style="v" />Sow to yourselves in righteousness, reap in mercy; break up your fallow <char style="pn">(to approve, commend, accept)</char> ground: for <char style="add">[it is]</char> time to seek the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, till he come and rain righteousness upon you.</para>
  <para style="p">
    <verse number="13" style="v" />You<char style="ord">2f</char> have plowed wickedness, you<char style="ord">2f</char> have reaped iniquity; you<char style="ord">2f</char> have eaten the fruit of lies: because you<char style="ord">i</char> did trust in your<char style="ord">i</char> way, in the multitude of your<char style="ord">i</char> mighty men.</para>
  <para style="p">
    <verse number="14" style="v" />Therefore shall a tumult arise among your<char style="ord">i</char> people, and all your<char style="ord">i</char> fortresses shall be spoiled, as Shalman <char style="add">[fire-worshipper]</char> spoiled Beit-Arbel <char style="add">[house of God’s ambush]</char> in the day of battle: the mother was dashed in pieces upon <char style="add">[her]</char> children.</para>
  <para style="p">
    <verse number="15" style="v" />So shall Beit-El <char style="add">[House of God]</char> do unto you because of your great wickedness: in a morning shall the king of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> utterly be cut off.</para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />When Yisra’el <char style="add">[He Holds Onto The Heel Of God] [was]</char> a child, then I loved him, and called my son out of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>.</para>
  <para style="p">
    <verse number="2" style="v" />
    <char style="add">[As]</char> they called them, so they went from them: they sacrificed unto Ba’alim <char style="add">[lords (false gods)]</char>, and burned incense to graven images.</para>
  <para style="p">
    <verse number="3" style="v" />I taught Efrayim <char style="add">[Doubly Fruitful]</char> also to go, taking them by their arms; but they knew not that I healed them.</para>
  <para style="p">
    <verse number="4" style="v" />I drew them with cords of a man, with bands of love: and I was to them as they that take off the yoke on their jaws, and I laid meat unto them.</para>
  <para style="p">
    <verse number="5" style="v" />He shall not return into the land of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>, but the Ashur <char style="pn">(Assyrian)</char> shall be his king, because they refused to return.</para>
  <para style="p">
    <verse number="6" style="v" />And the sword shall abide on his cities, and shall consume his branches, and devour <char style="add">[them]</char>, because of their own counsels.</para>
  <para style="p">
    <verse number="7" style="v" />And my people are bent to backsliding from me: though they called them to the most High, none at all would exalt <char style="add">[him]</char>.</para>
  <para style="p">
    <verse number="8" style="v" />How shall I give you<char style="ord">i</char> up, Efrayim <char style="add">[Doubly Fruitful]</char>? <char style="add">[how]</char> shall I deliver you<char style="ord">i</char>, Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>? how shall I make you<char style="ord">i</char> as Admah <char style="add">[Red Earth]</char>? <char style="add">[how]</char> shall I set you<char style="ord">i</char> as Tzvoyim <char style="add">[Gazelles]</char>? my heart is turned within me, my repentings are kindled together.</para>
  <para style="p">
    <verse number="9" style="v" />I will not execute the fierceness of my anger, I will not return to destroy Efrayim <char style="add">[Doubly Fruitful]</char>: for I <char style="add">[am]</char> God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>, and not man; the Holy One in the midst of you<char style="ord">i</char>: and I will not enter into the city.</para>
  <para style="p">
    <verse number="10" style="v" />They shall walk after the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>: he shall roar like a lion: when he shall roar, then the children shall tremble from the west.</para>
  <para style="p">
    <verse number="11" style="v" />They shall tremble as a bird out of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>, and as a dove out of the land of Ashur <char style="add">[the level plain]</char> <char style="pn">(the land of the sons of Shem (name, renown (great reputation; being well-known)))</char>: and I will place them in their houses, says the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="12" style="v" />Efrayim <char style="add">[Doubly Fruitful]</char> compasses me about with lies, and the house of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> with deceit: but Y’hudah <char style="add">[Let Him (God) Be Praised]</char> yet rules with God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>, and is faithful with the saints.</para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />Efrayim <char style="add">[Doubly Fruitful]</char> feeds on wind, and follows after the east wind: he daily increases lies and desolation; and they do make a covenant with the children of Ashur, and oil is carried into Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>.</para>
  <para style="p">
    <verse number="2" style="v" />The LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> has also a controversy with Y’hudah <char style="add">[Let Him (God) Be Praised]</char>, and will punish Ya’akov <char style="add">[Heal of God]</char> according to his ways; according to his doings will he recompense him.</para>
  <para style="p">
    <verse number="3" style="v" />He took his brother by the heel in the womb, and by his strength he had power with God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>:</para>
  <para style="p">
    <verse number="4" style="v" />Yes, he had power over the angel, and prevailed: he wept, and made supplication unto him: he found him <char style="add">[in]</char> Beit-El <char style="add">[House of God]</char>, and there he spoke with us;</para>
  <para style="p">
    <verse number="5" style="v" />Even the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> Tz’va’ot <char style="add">[of the Heavenly Armies]</char>; the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> <char style="add">[is]</char> his memorial.</para>
  <para style="p">
    <verse number="6" style="v" />Therefore turn you<char style="ord">i</char> to your<char style="ord">i</char> God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>: keep mercy and judgment, and wait on your<char style="ord">i</char> God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> continually.</para>
  <para style="p">
    <verse number="7" style="v" />
    <char style="add">[He is]</char> a merchant, the balances of deceit <char style="add">[are]</char> in his hand: he loves to oppress.</para>
  <para style="p">
    <verse number="8" style="v" />And Efrayim <char style="add">[Doubly Fruitful]</char> said, Yet I am become rich, I have found me out substance: <char style="add">[in]</char> all my labours they shall find none iniquity in me that <char style="add">[were]</char> sin.</para>
  <para style="p">
    <verse number="9" style="v" />And I <char style="add">[that am]</char> the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> your<char style="ord">i</char> God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> from the land of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char> will yet make you<char style="ord">i</char> to dwell in tabernacles, as in the days of the solemn feast.</para>
  <para style="p">
    <verse number="10" style="v" />I have also spoken by the prophets, and I have multiplied visions, and used similitudes, by the ministry of the prophets.</para>
  <para style="p">
    <verse number="11" style="v" />
    <char style="add">[Is there]</char> iniquity <char style="add">[in]</char> Gil’ad <char style="add">[Rocky Region]</char>? surely they are vanity: they sacrifice bullocks in Gilgal <char style="add">[A Wheel, Rolling]</char>; yes, their altars <char style="add">[are]</char> as heaps in the furrows of the fields.</para>
  <para style="p">
    <verse number="12" style="v" />And Ya’akov <char style="add">[Heal of God]</char> fled into the country of Aram <char style="pn">(Syria)</char> <char style="add">[exalted]</char>, and Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> served for a wife, and for a wife he kept <char style="add">[sheep]</char>.</para>
  <para style="p">
    <verse number="13" style="v" />And by a prophet the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> brought Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> out of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>, and by a prophet was he preserved.</para>
  <para style="p">
    <verse number="14" style="v" />Efrayim <char style="add">[Doubly Fruitful]</char> provoked <char style="add">[him]</char> to anger most bitterly: therefore shall he leave his blood upon him, and his reproach <char style="pn">(disgrace; shame)</char> shall his Lord <char style="add">[Adon – Ruler of the Earth]</char> return unto him.</para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />When Efrayim <char style="add">[Doubly Fruitful]</char> spoke trembling, he exalted himself in Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>; but when he offended in Ba’al <char style="add">[lord (a false god)]</char>, he died.</para>
  <para style="p">
    <verse number="2" style="v" />And now they sin more and more, and have made them molten images of their silver, <char style="add">[and]</char> idols according to their own understanding, all of it the work of the craftsmen: they say of them, Let the men that sacrifice kiss the calves.</para>
  <para style="p">
    <verse number="3" style="v" />Therefore they shall be as the morning cloud, and as the early dew that passes away, as the chaff <char style="add">[that]</char> is driven with the whirlwind out of the floor, and as the smoke out of the chimney.</para>
  <para style="p">
    <verse number="4" style="v" />Yet I <char style="add">[am]</char> the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> you<char style="ord">i</char> God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> from the land of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>, and you<char style="ord">i</char> shall know no god but me: for <char style="add">[there is]</char> no saviour beside me.</para>
  <para style="p">
    <verse number="5" style="v" />I did know you<char style="ord">i</char> in the wilderness, in the land of great drought.</para>
  <para style="p">
    <verse number="6" style="v" />According to their pasture, so were they filled; they were filled, and their heart was exalted; therefore have they forgotten me.</para>
  <para style="p">
    <verse number="7" style="v" />Therefore I will be unto them as a lion: as a leopard by the way will I observe <char style="add">[them]</char>:</para>
  <para style="p">
    <verse number="8" style="v" />I will meet them as a bear <char style="add">[that is]</char> bereaved <char style="add">[of her whelps]</char>, and will rend <char style="pn">(tear apart; forcefully rip apart)</char> the caul <char style="pn">(membrane; fatty tissue around a bodily organ)</char> of their heart, and there will I devour them like a lion: the wild beast shall tear them.</para>
  <para style="p">
    <verse number="9" style="v" />O Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, you<char style="ord">i</char> have destroyed yourself; but in me <char style="add">[is]</char> you<char style="ord">i</char> help.</para>
  <para style="p">
    <verse number="10" style="v" />I will be your<char style="ord">i</char> king: where <char style="add">[is any other]</char> that may save you<char style="ord">i</char> in all your<char style="ord">i</char> cities? and your<char style="ord">i</char> of whom you<char style="ord">i</char> said, Give me a king and princes?</para>
  <para style="p">
    <verse number="11" style="v" />I gave you<char style="ord">i</char> a king in my anger, and took <char style="add">[him]</char> away in my wrath.</para>
  <para style="p">
    <verse number="12" style="v" />The iniquity of Efrayim <char style="add">[Doubly Fruitful] [is]</char> bound up; his sin <char style="add">[is]</char> hid.</para>
  <para style="p">
    <verse number="13" style="v" />The sorrows of a travailing woman shall come upon him: he <char style="add">[is]</char> an unwise son; for he should not stay long in <char style="add">[the place of]</char> the breaking forth of children.</para>
  <para style="p">
    <verse number="14" style="v" />I will ransom them from the power of the grave; I will redeem them from death: O death, I will be your<char style="ord">i</char> plagues; O grave, I will be your<char style="ord">i</char> destruction: repentance shall be hid from my eyes.</para>
  <para style="p">
    <verse number="15" style="v" />Though he be fruitful among <char style="add">[his]</char> brethren, an east wind shall come, the wind of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> shall come up from the wilderness, and his spring shall become dry, and his fountain shall be dried up: he shall spoil <char style="pn">(plunder; prey; booty)</char> the treasure of all pleasant vessels.</para>
  <para style="p">
    <verse number="16" style="v" />Shomron <char style="add">[watch mountain]</char> shall become desolate; for she has rebelled against her God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>: they shall fall by the sword: their infants shall be dashed in pieces, and their women with child shall be ripped up.</para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />O Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, return unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> your<char style="ord">i</char> God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>; for you<char style="ord">i</char> have fallen by your<char style="ord">i</char> iniquity.</para>
  <para style="p">
    <verse number="2" style="v" />Take with you words, and turn to the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>: say unto him, Take away all iniquity, and receive <char style="add">[us]</char> graciously: so will we render the calves of our lips.</para>
  <para style="p">
    <verse number="3" style="v" />Ashur <char style="add">[A Level Plain]</char> shall not save us; we will not ride upon horses: neither will we say any more to the work of our hands, <char style="add">[You<char style="ord">2f</char> are]</char> our gods: for in you<char style="ord">i</char> the fatherless finds mercy.</para>
  <para style="p">
    <verse number="4" style="v" />I will heal their backsliding, I will love them freely: for my anger is turned away from him.</para>
  <para style="p">
    <verse number="5" style="v" />I will be as the dew unto Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>: he shall grow as the lily, and cast forth his roots as L’vanon <char style="add">[Whiteness]</char>.</para>
  <para style="p">
    <verse number="6" style="v" />His branches shall spread, and his beauty shall be as the olive tree, and his smell as L’vanon <char style="add">[Whiteness]</char>.</para>
  <para style="p">
    <verse number="7" style="v" />They that dwell under his shadow shall return; they shall revive <char style="add">[as]</char> the corn, and grow as the vine: the scent thereof <char style="add">[shall be]</char> as the wine of L’vanon <char style="add">[Whiteness]</char>.</para>
  <para style="p">
    <verse number="8" style="v" />Efrayim <char style="add">[Doubly Fruitful] [shall say]</char>, What have I to do any more with idols? I have heard <char style="add">[him]</char>, and observed him: I <char style="add">[am]</char> like a green fir tree. From me is you<char style="ord">i</char> fruit found.</para>
  <para style="p">
    <verse number="9" style="v" />Who <char style="add">[is]</char> wise, and he shall understand these <char style="add">[things]</char>? prudent, and he shall know them? for the ways of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> <char style="add">[are]</char> right, and the just shall walk in them: but the transgressors shall fall in it.</para>
</usx>