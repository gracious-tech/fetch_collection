<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="NUM" style="id">- Tov Rose New Messianic Version Bible</book>
  <para style="h">Numbers</para>
  <para style="mt">Numbers</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char> in the wilderness of Sinai, in the tabernacle of the congregation, on the first <char style="add">[day]</char> of the second month, in the second year after they were come out of the land of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>, saying,</para>
  <para style="p">
    <verse number="2" style="v" />Take you<char style="ord">2f</char> the sum of all the congregation of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, after their families, by the house of their fathers, with the number of <char style="add">[their]</char> names, every male by their polls;</para>
  <para style="p">
    <verse number="3" style="v" />From twenty years old and upward, all that are able to go forth to war in Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>: you<char style="ord">i</char> and Aharon <char style="add">[Bright, Very High]</char> shall number them by their armies.</para>
  <para style="p">
    <verse number="4" style="v" />And with you there shall be a man of every tribe; every one head of the house of his fathers.</para>
  <para style="p">
    <verse number="5" style="v" />And these <char style="add">[are]</char> the names of the men that shall stand with you: of <char style="add">[the tribe of]</char> Re’uven <char style="add">[Behold a Son]</char>; Elitzur <char style="add">[My God is a Rock]</char> the son of Sh’de’ur <char style="add">[Almighty’s Light]</char>.</para>
  <para style="p">
    <verse number="6" style="v" />Of Shim’on <char style="add">[he who hears]</char>; Shlumi’el <char style="add">[Friend of God]</char> the son of Tzuri-shaddai <char style="add">[My Rock is the Almighty]</char>.</para>
  <para style="p">
    <verse number="7" style="v" />Of Y’hudah <char style="add">[Let Him (God) Be Praised]</char>; Nachshon <char style="add">[Enchanter]</char> the son of ‘Amminadav <char style="add">[family of the prince]</char>.</para>
  <para style="p">
    <verse number="8" style="v" />Of Yissakhar <char style="add">[There Is Recompense]</char>; N’tan’el <char style="add">[God’s Gift]</char> the son of Zuar <char style="add">[Small]</char>.</para>
  <para style="p">
    <verse number="9" style="v" />Of Z’vulun <char style="add">[Glorious Dwelling Place]</char>; ‘Eli’av <char style="add">[My Father is God]</char> the son of Helon <char style="add">[Strength]</char>.</para>
  <para style="p">
    <verse number="10" style="v" />Of the children of Yosef <char style="add">[(God) He Shall Add]</char>: of Efrayim <char style="add">[Doubly Fruitful]</char>; Elishama <char style="add">[My God has Heard]</char> the son of Ammihud <char style="add">[People of Magesty]</char>: of M’nasheh <char style="add">[Causing to Forget]</char>; Gamali’el <char style="add">[Reward of God]</char> the son of Pedahzur <char style="add">[The Rock has Ransomed]</char>.</para>
  <para style="p">
    <verse number="11" style="v" />Of Binyamin <char style="add">[Son of the Right Hand/Strength]</char>; Avidan <char style="add">[My Father is Judge]</char> the son of Gid’oni <char style="add">[My Hewer]</char>.</para>
  <para style="p">
    <verse number="12" style="v" />Of Dan <char style="add">[Judge]</char>; Achi’ezer <char style="add">[My Brother is Help]</char> the son of ‘‘Ammi <char style="add">[my people]</char> -Shaddai <char style="add">[Shaddai is my Kinsman]</char>.</para>
  <para style="p">
    <verse number="13" style="v" />Of Asher <char style="add">[Happy]</char>; Pag’i’el <char style="add">[God’s Intervention]</char> the son of ‘Okhran <char style="add">[Troubled]</char>.</para>
  <para style="p">
    <verse number="14" style="v" />Of Gad <char style="add">[Good Fortune with Troublesome Effort]</char>; Elyasaf <char style="add">[My God has Added]</char> the son of De’u’el <char style="add">[They Know God]</char>.</para>
  <para style="p">
    <verse number="15" style="v" />Of Naftali <char style="add">[My Wrestling]</char>; Achira <char style="add">[My Brother is Evil]</char> the son of ‘Enan <char style="add">[keen-eyed]</char>.</para>
  <para style="p">
    <verse number="16" style="v" />These <char style="add">[were]</char> the renowned of the congregation, princes of the tribes of their fathers, heads of thousands in Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="17" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and Aharon <char style="add">[Bright, Very High]</char> took these men which are expressed by <char style="add">[their]</char> names:</para>
  <para style="p">
    <verse number="18" style="v" />And they assembled all the congregation together on the first <char style="add">[day]</char> of the second month, and they declared their pedigrees after their families, by the house of their fathers, according to the number of the names, from twenty years old and upward, by their polls.</para>
  <para style="p">
    <verse number="19" style="v" />As the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, so he numbered them in the wilderness of Sinai.</para>
  <para style="p">
    <verse number="20" style="v" />And the children of Re’uven <char style="add">[Behold a Son]</char>, Yisra’el’s <char style="add">[He Holds Onto The Heel Of God]</char> eldest son, by their generations, after their families, by the house of their fathers, according to the number of the names, by their polls, every male from twenty years old and upward, all that were able to go forth to war;</para>
  <para style="p">
    <verse number="21" style="v" />Those that were numbered of them, <char style="add">[even]</char> of the tribe of Re’uven <char style="add">[Behold a Son]</char>, <char style="add">[were]</char> forty and six thousand and five hundred.</para>
  <para style="p">
    <verse number="22" style="v" />Of the children of Shim’on <char style="add">[he who hears]</char>, by their generations, after their families, by the house of their fathers, those that were numbered of them, according to the number of the names, by their polls, every male from twenty years old and upward, all that were able to go forth to war;</para>
  <para style="p">
    <verse number="23" style="v" />Those that were numbered of them, <char style="add">[even]</char> of the tribe of Shim’on <char style="add">[he who hears]</char>, <char style="add">[were]</char> fifty and nine thousand and three hundred.</para>
  <para style="p">
    <verse number="24" style="v" />Of the children of Gad <char style="add">[Good Fortune with Troublesome Effort]</char>, by their generations, after their families, by the house of their fathers, according to the number of the names, from twenty years old and upward, all that were able to go forth to war;</para>
  <para style="p">
    <verse number="25" style="v" />Those that were numbered of them, <char style="add">[even]</char> of the tribe of Gad <char style="add">[Good Fortune with Troublesome Effort]</char>, <char style="add">[were]</char> forty and five thousand six hundred and fifty.</para>
  <para style="p">
    <verse number="26" style="v" />Of the children of Y’hudah <char style="add">[Let Him (God) Be Praised]</char>, by their generations, after their families, by the house of their fathers, according to the number of the names, from twenty years old and upward, all that were able to go forth to war;</para>
  <para style="p">
    <verse number="27" style="v" />Those that were numbered of them, <char style="add">[even]</char> of the tribe of Y’hudah <char style="add">[Let Him (God) Be Praised]</char>, <char style="add">[were]</char> threescore and fourteen thousand and six hundred.</para>
  <para style="p">
    <verse number="28" style="v" />Of the children of Yissakhar <char style="add">[There Is Recompense]</char>, by their generations, after their families, by the house of their fathers, according to the number of the names, from twenty years old and upward, all that were able to go forth to war;</para>
  <para style="p">
    <verse number="29" style="v" />Those that were numbered of them, <char style="add">[even]</char> of the tribe of Yissakhar <char style="add">[There Is Recompense]</char>, <char style="add">[were]</char> fifty and four thousand and four hundred.</para>
  <para style="p">
    <verse number="30" style="v" />Of the children of Z’vulun <char style="add">[Glorious Dwelling Place]</char>, by their generations, after their families, by the house of their fathers, according to the number of the names, from twenty years old and upward, all that were able to go forth to war;</para>
  <para style="p">
    <verse number="31" style="v" />Those that were numbered of them, <char style="add">[even]</char> of the tribe of Z’vulun <char style="add">[Glorious Dwelling Place]</char>, <char style="add">[were]</char> fifty and seven thousand and four hundred.</para>
  <para style="p">
    <verse number="32" style="v" />Of the children of Yosef <char style="add">[(God) He Shall Add]</char>, <char style="add">[namely]</char>, of the children of Efrayim <char style="add">[Doubly Fruitful]</char>, by their generations, after their families, by the house of their fathers, according to the number of the names, from twenty years old and upward, all that were able to go forth to war;</para>
  <para style="p">
    <verse number="33" style="v" />Those that were numbered of them, <char style="add">[even]</char> of the tribe of Efrayim <char style="add">[Doubly Fruitful]</char>, <char style="add">[were]</char> forty thousand and five hundred.</para>
  <para style="p">
    <verse number="34" style="v" />Of the children of M’nasheh <char style="add">[Causing to Forget]</char>, by their generations, after their families, by the house of their fathers, according to the number of the names, from twenty years old and upward, all that were able to go forth to war;</para>
  <para style="p">
    <verse number="35" style="v" />Those that were numbered of them, <char style="add">[even]</char> of the tribe of M’nasheh <char style="add">[Causing to Forget]</char>, <char style="add">[were]</char> thirty and two thousand and two hundred.</para>
  <para style="p">
    <verse number="36" style="v" />Of the children of Binyamin <char style="add">[Son of the Right Hand/Strength]</char>, by their generations, after their families, by the house of their fathers, according to the number of the names, from twenty years old and upward, all that were able to go forth to war;</para>
  <para style="p">
    <verse number="37" style="v" />Those that were numbered of them, <char style="add">[even]</char> of the tribe of Binyamin <char style="add">[Son of the Right Hand/Strength]</char>, <char style="add">[were]</char> thirty and five thousand and four hundred.</para>
  <para style="p">
    <verse number="38" style="v" />Of the children of Dan <char style="add">[Judge]</char>, by their generations, after their families, by the house of their fathers, according to the number of the names, from twenty years old and upward, all that were able to go forth to war;</para>
  <para style="p">
    <verse number="39" style="v" />Those that were numbered of them, <char style="add">[even]</char> of the tribe of Dan <char style="add">[Judge]</char>, <char style="add">[were]</char> threescore and two thousand and seven hundred.</para>
  <para style="p">
    <verse number="40" style="v" />Of the children of Asher <char style="add">[Happy]</char>, by their generations, after their families, by the house of their fathers, according to the number of the names, from twenty years old and upward, all that were able to go forth to war;</para>
  <para style="p">
    <verse number="41" style="v" />Those that were numbered of them, <char style="add">[even]</char> of the tribe of Asher <char style="add">[Happy]</char>, <char style="add">[were]</char> forty and one thousand and five hundred.</para>
  <para style="p">
    <verse number="42" style="v" />Of the children of Naftali <char style="add">[My Wrestling]</char>, throughout their generations, after their families, by the house of their fathers, according to the number of the names, from twenty years old and upward, all that were able to go forth to war;</para>
  <para style="p">
    <verse number="43" style="v" />Those that were numbered of them, <char style="add">[even]</char> of the tribe of Naftali <char style="add">[My Wrestling]</char>, <char style="add">[were]</char> fifty and three thousand and four hundred.</para>
  <para style="p">
    <verse number="44" style="v" />These <char style="add">[are]</char> those that were numbered, which Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and Aharon <char style="add">[Bright, Very High]</char> numbered, and the princes of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, <char style="add">[being]</char> twelve men: each one was for the house of his fathers.</para>
  <para style="p">
    <verse number="45" style="v" />So were all those that were numbered of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, by the house of their fathers, from twenty years old and upward, all that were able to go forth to war in Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>;</para>
  <para style="p">
    <verse number="46" style="v" />Even all they that were numbered were six hundred thousand and three thousand and five hundred and fifty.</para>
  <para style="p">
    <verse number="47" style="v" />But the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> after the tribe of their fathers were not numbered among them.</para>
  <para style="p">
    <verse number="48" style="v" />For the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> had spoken unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="49" style="v" />Only you<char style="ord">i</char> shall not number the tribe of Levi <char style="pn">(Levite)</char> <char style="add">[Adhesion, Joiner]</char>, neither take the sum of them among the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>:</para>
  <para style="p">
    <verse number="50" style="v" />But you<char style="ord">i</char> shall appoint the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> over the tabernacle of testimony, and over all the vessels thereof, and over all things that <char style="add">[belong]</char> to it: they shall bear the tabernacle, and all the vessels thereof; and they shall minister unto it, and shall encamp round about the tabernacle.</para>
  <para style="p">
    <verse number="51" style="v" />And when the tabernacle sets forward, the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> shall take it down: and when the tabernacle is to be pitched, the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> shall set it up: and the stranger that comes near shall be put to death.</para>
  <para style="p">
    <verse number="52" style="v" />And the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> shall pitch their tents, every man by his own camp, and every man by his own Flag <char style="pn">(banner)</char>, throughout their hosts.</para>
  <para style="p">
    <verse number="53" style="v" />But the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> shall pitch round about the tabernacle of testimony, that there be no wrath upon the congregation of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>: and the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> shall keep the charge of the tabernacle of testimony.</para>
  <para style="p">
    <verse number="54" style="v" />And the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> did according to all that the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, so did they.</para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and unto Aharon <char style="add">[Bright, Very High]</char>, saying,</para>
  <para style="p">
    <verse number="2" style="v" />Every man of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> shall pitch by his own Flag <char style="pn">(banner)</char>, with the flag <char style="pn">(or banner; as of an army)</char> of their father’s house: far off about the tabernacle of the congregation shall they pitch.</para>
  <para style="p">
    <verse number="3" style="v" />And on the east side toward the rising of the sun shall they of the Flag <char style="pn">(banner)</char> of the camp of Y’hudah <char style="add">[Let Him (God) Be Praised]</char> pitch throughout their armies: and Nachshon <char style="add">[Enchanter]</char> the son of ‘Amminadav <char style="add">[family of the prince] [shall be]</char> captain of the children of Y’hudah <char style="add">[Let Him (God) Be Praised]</char>.</para>
  <para style="p">
    <verse number="4" style="v" />And his host, and those that were numbered of them, <char style="add">[were]</char> threescore and fourteen thousand and six hundred.</para>
  <para style="p">
    <verse number="5" style="v" />And those that do pitch next unto him <char style="add">[shall be]</char> the tribe of Yissakhar <char style="add">[There Is Recompense]</char>: and N’tan’el <char style="add">[God’s Gift]</char> the son of Zuar <char style="add">[Small] [shall be]</char> captain of the children of Yissakhar <char style="add">[There Is Recompense]</char>.</para>
  <para style="p">
    <verse number="6" style="v" />And his host, and those that were numbered thereof, <char style="add">[were]</char> fifty and four thousand and four hundred.</para>
  <para style="p">
    <verse number="7" style="v" />
    <char style="add">[Then]</char> the tribe of Z’vulun <char style="add">[Glorious Dwelling Place]</char>: and ‘Eli’av <char style="add">[My Father is God]</char> the son of Helon <char style="add">[Strength] [shall be]</char> captain of the children of Z’vulun <char style="add">[Glorious Dwelling Place]</char>.</para>
  <para style="p">
    <verse number="8" style="v" />And his host, and those that were numbered thereof, <char style="add">[were]</char> fifty and seven thousand and four hundred.</para>
  <para style="p">
    <verse number="9" style="v" />All that were numbered in the camp of Y’hudah <char style="add">[Let Him (God) Be Praised] [were]</char> an hundred thousand and eighty thousand and six thousand and four hundred, throughout their armies. These shall first set forth.</para>
  <para style="p">
    <verse number="10" style="v" />On the south side <char style="add">[shall be]</char> the Flag <char style="pn">(banner)</char> of the camp of Re’uven <char style="add">[Behold a Son]</char> according to their armies: and the captain of the children of Re’uven <char style="add">[Behold a Son] [shall be]</char> Elitzur <char style="add">[My God is a Rock]</char> the son of Sh’de’ur <char style="add">[Almighty’s Light]</char>.</para>
  <para style="p">
    <verse number="11" style="v" />And his host, and those that were numbered thereof, <char style="add">[were]</char> forty and six thousand and five hundred.</para>
  <para style="p">
    <verse number="12" style="v" />And those which pitch by him <char style="add">[shall be]</char> the tribe of Shim’on <char style="add">[he who hears]</char>: and the captain of the children of Shim’on <char style="add">[he who hears] [shall be]</char> Shlumi’el <char style="add">[Friend of God]</char> the son of Tzuri-shaddai <char style="add">[My Rock is the Almighty]</char>.</para>
  <para style="p">
    <verse number="13" style="v" />And his host, and those that were numbered of them, <char style="add">[were]</char> fifty and nine thousand and three hundred.</para>
  <para style="p">
    <verse number="14" style="v" />Then the tribe of Gad <char style="add">[Good Fortune with Troublesome Effort]</char>: and the captain of the sons of Gad <char style="add">[Good Fortune with Troublesome Effort] [shall be]</char> Elyasaf <char style="add">[My God has Added]</char> the son of Reu’el <char style="add">[friend of God]</char>.</para>
  <para style="p">
    <verse number="15" style="v" />And his host, and those that were numbered of them, <char style="add">[were]</char> forty and five thousand and six hundred and fifty.</para>
  <para style="p">
    <verse number="16" style="v" />All that were numbered in the camp of Re’uven <char style="add">[Behold a Son] [were]</char> an hundred thousand and fifty and one thousand and four hundred and fifty, throughout their armies. And they shall set forth in the second rank.</para>
  <para style="p">
    <verse number="17" style="v" />Then the tabernacle of the congregation shall set forward with the camp of the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> in the midst of the camp: as they encamp, so shall they set forward, every man in his place by their standards.</para>
  <para style="p">
    <verse number="18" style="v" />On the west side <char style="add">[shall be]</char> the Flag <char style="pn">(banner)</char> of the camp of Efrayim <char style="add">[Doubly Fruitful]</char> according to their armies: and the captain of the sons of Efrayim <char style="add">[Doubly Fruitful] [shall be]</char> Elishama <char style="add">[My God has Heard]</char> the son of Ammihud <char style="add">[People of Magesty]</char>.</para>
  <para style="p">
    <verse number="19" style="v" />And his host, and those that were numbered of them, <char style="add">[were]</char> forty thousand and five hundred.</para>
  <para style="p">
    <verse number="20" style="v" />And by him <char style="add">[shall be]</char> the tribe of M’nasheh <char style="add">[Causing to Forget]</char>: and the captain of the children of M’nasheh <char style="add">[Causing to Forget] [shall be]</char> Gamali’el <char style="add">[Reward of God]</char> the son of Pedahzur <char style="add">[The Rock has Ransomed]</char>.</para>
  <para style="p">
    <verse number="21" style="v" />And his host, and those that were numbered of them, <char style="add">[were]</char> thirty and two thousand and two hundred.</para>
  <para style="p">
    <verse number="22" style="v" />Then the tribe of Binyamin <char style="add">[Son of the Right Hand/Strength]</char>: and the captain of the sons of Binyamin <char style="add">[Son of the Right Hand/Strength] [shall be]</char> Avidan <char style="add">[My Father is Judge]</char> the son of Gid’oni <char style="add">[My Hewer]</char>.</para>
  <para style="p">
    <verse number="23" style="v" />And his host, and those that were numbered of them, <char style="add">[were]</char> thirty and five thousand and four hundred.</para>
  <para style="p">
    <verse number="24" style="v" />All that were numbered of the camp of Efrayim <char style="add">[Doubly Fruitful] [were]</char> an hundred thousand and eight thousand and an hundred, throughout their armies. And they shall go forward in the third rank.</para>
  <para style="p">
    <verse number="25" style="v" />The Flag <char style="pn">(banner)</char> of the camp of Dan <char style="add">[Judge] [shall be]</char> on the north side by their armies: and the captain of the children of Dan <char style="add">[Judge] [shall be]</char> Achi’ezer <char style="add">[My Brother is Help]</char> the son of ‘‘Ammi <char style="add">[my people]</char> -Shaddai <char style="add">[Shaddai is my Kinsman]</char>.</para>
  <para style="p">
    <verse number="26" style="v" />And his host, and those that were numbered of them, <char style="add">[were]</char> threescore and two thousand and seven hundred.</para>
  <para style="p">
    <verse number="27" style="v" />And those that encamp by him <char style="add">[shall be]</char> the tribe of Asher <char style="add">[Happy]</char>: and the captain of the children of Asher <char style="add">[Happy] [shall be]</char> Pag’i’el [God’s Intervention] the son of ‘Okhran <char style="add">[Troubled]</char>.</para>
  <para style="p">
    <verse number="28" style="v" />And his host, and those that were numbered of them, <char style="add">[were]</char> forty and one thousand and five hundred.</para>
  <para style="p">
    <verse number="29" style="v" />Then the tribe of Naftali <char style="add">[My Wrestling]</char>: and the captain of the children of Naftali <char style="add">[My Wrestling] [shall be]</char> Achira <char style="add">[My Brother is Evil]</char> the son of ‘Enan <char style="add">[keen-eyed]</char>.</para>
  <para style="p">
    <verse number="30" style="v" />And his host, and those that were numbered of them, <char style="add">[were]</char> fifty and three thousand and four hundred.</para>
  <para style="p">
    <verse number="31" style="v" />All they that were numbered in the camp of Dan <char style="add">[Judge] [were]</char> an hundred thousand and fifty and seven thousand and six hundred. They shall go hindmost with their standards.</para>
  <para style="p">
    <verse number="32" style="v" />These <char style="add">[are]</char> those which were numbered of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> by the house of their fathers: all those that were numbered of the camps throughout their hosts <char style="add">[were]</char> six hundred thousand and three thousand and five hundred and fifty.</para>
  <para style="p">
    <verse number="33" style="v" />But the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> were not numbered among the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>; as the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded Moshe <char style="add">[He Who Draws Out Of The Waters]</char>.</para>
  <para style="p">
    <verse number="34" style="v" />And the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> did according to all that the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded Moshe <char style="add">[He Who Draws Out Of The Waters]</char>: so they pitched by their standards, and so they set forward, every one after their families, according to the house of their fathers.</para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />These also <char style="add">[are]</char> the generations of Aharon <char style="add">[Bright, Very High]</char> and Moshe <char style="add">[He Who Draws Out Of The Waters]</char> in the day <char style="add">[that]</char> the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke with Moshe <char style="add">[He Who Draws Out Of The Waters]</char> in mount Sinai.</para>
  <para style="p">
    <verse number="2" style="v" />And these <char style="add">[are]</char> the names of the sons of Aharon <char style="add">[Bright, Very High]</char>; Nadav <char style="add">[Generous]</char> the firstborn, and Avihu <char style="add">[he is my father]</char>, El’azar <char style="add">[God has helped]</char>, and Itamar <char style="add">[Coast of Palms]</char>.</para>
  <para style="p">
    <verse number="3" style="v" />These <char style="add">[are]</char> the names of the sons of Aharon <char style="add">[Bright, Very High]</char>, the priests which were anointed, whom he consecrated to minister in the priest’s office.</para>
  <para style="p">
    <verse number="4" style="v" />And Nadav <char style="add">[Generous]</char> and Avihu <char style="add">[he is my father]</char> died before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, when they offered strange fire before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, in the wilderness of Sinai, and they had no children: and El’azar <char style="add">[God has helped]</char> and Itamar <char style="add">[Coast of Palms]</char> ministered in the priest’s office in the sight of Aharon <char style="add">[Bright, Very High]</char> their father.</para>
  <para style="p">
    <verse number="5" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="6" style="v" />Bring the tribe of Levi <char style="pn">(Levite)</char> <char style="add">[Adhesion, Joiner]</char> near, and present them before Aharon <char style="add">[Bright, Very High]</char> the priest, that they may minister unto him.</para>
  <para style="p">
    <verse number="7" style="v" />And they shall keep his charge, and the charge of the whole congregation before the tabernacle of the congregation, to do the service of the tabernacle.</para>
  <para style="p">
    <verse number="8" style="v" />And they shall keep all the instruments of the tabernacle of the congregation, and the charge of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, to do the service of the tabernacle.</para>
  <para style="p">
    <verse number="9" style="v" />And you<char style="ord">i</char> shall give the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> unto Aharon <char style="add">[Bright, Very High]</char> and to his sons: they <char style="add">[are]</char> wholly given unto him out of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="10" style="v" />And you<char style="ord">i</char> shall appoint Aharon <char style="add">[Bright, Very High]</char> and his sons, and they shall wait on their priest’s office: and the stranger that comes near shall be put to death.</para>
  <para style="p">
    <verse number="11" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="12" style="v" />And I, behold, I have taken the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> from among the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> instead of all the firstborn that opens the womb among the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>: therefore the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> shall be my;</para>
  <para style="p">
    <verse number="13" style="v" />Because all the firstborn <char style="add">[are]</char> my; <char style="add">[for]</char> on the day that I struck all the firstborn in the land of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char> I consecrated unto me all the firstborn in Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, both man and beast: my shall they be: I <char style="add">[am]</char> the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="14" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char> in the wilderness of Sinai, saying,</para>
  <para style="p">
    <verse number="15" style="v" />Number the children of Levi <char style="pn">(Levite)</char> <char style="add">[Adhesion, Joiner]</char> after the house of their fathers, by their families: every male from a month old and upward shall you<char style="ord">i</char> number them.</para>
  <para style="p">
    <verse number="16" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> numbered them according to the word of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, as he was commanded.</para>
  <para style="p">
    <verse number="17" style="v" />And these were the sons of Levi <char style="pn">(Levite)</char> <char style="add">[Adhesion, Joiner]</char> by their names; Gershon <char style="add">[Exile]</char>, and K’hat <char style="add">[assembly, congregation]</char>, and M’rari <char style="add">[Bitter]</char>.</para>
  <para style="p">
    <verse number="18" style="v" />And these <char style="add">[are]</char> the names of the sons of Gershon <char style="add">[Exile]</char> by their families; Livni <char style="add">[White]</char>, and Shime’i <char style="add">[Fame]</char>.</para>
  <para style="p">
    <verse number="19" style="v" />And the sons of K’hat <char style="add">[assembly, congregation]</char> by their families; ‘Amram <char style="add">[exalted people]</char>, and Yitz’har <char style="add">[Oil]</char>, Hevron <char style="add">[Seat of Association]</char>, and Uzziel <char style="add">[My Strength is God]</char>.</para>
  <para style="p">
    <verse number="20" style="v" />And the sons of M’rari <char style="add">[Bitter]</char> by their families; Machli <char style="add">[Sick]</char>, and Mushi <char style="add">[Yielding]</char>. These <char style="add">[are]</char> the families of the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> according to the house of their fathers.</para>
  <para style="p">
    <verse number="21" style="v" />Of Gershon <char style="add">[Exile] [was]</char> the family of the Livni <char style="add">[White Ones]</char>, and the family of the Shim’i <char style="add">[Famous Ones]</char>: these <char style="add">[are]</char> the families of the Gershuni <char style="add">[Exiled Ones]</char>.</para>
  <para style="p">
    <verse number="22" style="v" />Those that were numbered of them, according to the number of all the males, from a month old and upward, <char style="add">[even]</char> those that were numbered of them <char style="add">[were]</char> seven thousand and five hundred.</para>
  <para style="p">
    <verse number="23" style="v" />The families of the Gershuni <char style="add">[Exiled Ones]</char> shall pitch behind the tabernacle westward.</para>
  <para style="p">
    <verse number="24" style="v" />And the chief of the house of the father of the Gershuni <char style="add">[Exiled Ones] [shall be]</char> Elyasaf <char style="add">[My God has Added]</char> the son of La’el <char style="add">[Belonging to God]</char>.</para>
  <para style="p">
    <verse number="25" style="v" />And the charge of the sons of Gershon <char style="add">[Exile]</char> in the tabernacle of the congregation <char style="add">[shall be]</char> the tabernacle, and the tent, the covering thereof, and the hanging for the door of the tabernacle of the congregation,</para>
  <para style="p">
    <verse number="26" style="v" />And the hangings of the court, and the curtain for the door of the court, which <char style="add">[is]</char> by the tabernacle, and by the altar round about, and the cords of it for all the service thereof.</para>
  <para style="p">
    <verse number="27" style="v" />And of K’hat <char style="add">[assembly, congregation] [was]</char> the family of the Amrami, and the family of the Yitz’hari, and the family of the Khevroni, and the family of the ‘Uzi’el <char style="add">[God is My Strength]</char>: these <char style="add">[are]</char> the families of the K’hati.</para>
  <para style="p">
    <verse number="28" style="v" />In the number of all the males, from a month old and upward, <char style="add">[were]</char> eight thousand and six hundred, keeping the charge of the sanctuary.</para>
  <para style="p">
    <verse number="29" style="v" />The families of the sons of K’hat <char style="add">[assembly, congregation]</char> shall pitch on the side of the tabernacle southward.</para>
  <para style="p">
    <verse number="30" style="v" />And the chief of the house of the father of the families of the K’hati <char style="add">[shall be]</char> Elitzafan <char style="add">[My God has Protected]</char> the son of Uzziel <char style="add">[My Strength is God]</char>.</para>
  <para style="p">
    <verse number="31" style="v" />And their charge <char style="add">[shall be]</char> the ark, and the table, and the candlestick, and the altars, and the vessels of the sanctuary which they minister, and the hanging, and all the service thereof.</para>
  <para style="p">
    <verse number="32" style="v" />And El’azar <char style="add">[God has helped]</char> the son of Aharon <char style="add">[Bright, Very High]</char> the priest <char style="add">[shall be]</char> chief over the chief of the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char>, <char style="add">[and have]</char> the oversight of them that keep the charge of the sanctuary.</para>
  <para style="p">
    <verse number="33" style="v" />Of M’rari <char style="add">[Bitter] [was]</char> the family of the Machli, and the family of the Mushi: these <char style="add">[are]</char> the families of M’rari <char style="add">[Bitter]</char>.</para>
  <para style="p">
    <verse number="34" style="v" />And those that were numbered of them, according to the number of all the males, from a month old and upward, <char style="add">[were]</char> six thousand and two hundred.</para>
  <para style="p">
    <verse number="35" style="v" />And the chief of the house of the father of the families of M’rari <char style="add">[Bitter] [was]</char> Tzuri’el <char style="add">[My Rock is God]</char> the son of Avichayil <char style="add">[Father of Strength]</char>: <char style="add">[these]</char> shall pitch on the side of the tabernacle northward.</para>
  <para style="p">
    <verse number="36" style="v" />And <char style="add">[under]</char> the custody and charge of the sons of M’rari <char style="add">[Bitter] [shall be]</char> the boards of the tabernacle, and the bars thereof, and the pillars thereof, and the sockets thereof, and all the vessels thereof, and all that serves thereto,</para>
  <para style="p">
    <verse number="37" style="v" />And the pillars of the court round about, and their sockets, and their pins, and their cords.</para>
  <para style="p">
    <verse number="38" style="v" />But those that encamp before the tabernacle toward the east, <char style="add">[even]</char> before the tabernacle of the congregation eastward, <char style="add">[shall be]</char> Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, and Aharon <char style="add">[Bright, Very High]</char> and his sons, keeping the charge of the sanctuary for the charge of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>; and the stranger that comes near shall be put to death.</para>
  <para style="p">
    <verse number="39" style="v" />All that were numbered of the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char>, which Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and Aharon <char style="add">[Bright, Very High]</char> numbered at the commandment of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, throughout their families, all the males from a month old and upward, <char style="add">[were]</char> twenty and two thousand.</para>
  <para style="p">
    <verse number="40" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> said unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, Number all the firstborn of the males of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> from a month old and upward, and take the number of their names.</para>
  <para style="p">
    <verse number="41" style="v" />And you<char style="ord">i</char> shall take the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> for me <char style="pn">(I [am] the LORD-Yehōvah (Messiah Pre-Incarnate))</char> instead of all the firstborn among the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>; and the cattle of the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> instead of all the firstlings among the cattle of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="42" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> numbered, as the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded him, all the firstborn among the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="43" style="v" />And all the firstborn males by the number of names, from a month old and upward, of those that were numbered of them, were twenty and two thousand two hundred and threescore and thirteen.</para>
  <para style="p">
    <verse number="44" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="45" style="v" />Take the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> instead of all the firstborn among the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, and the cattle of the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> instead of their cattle; and the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> shall be my: I <char style="add">[am]</char> the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="46" style="v" />And for those that are to be redeemed of the two hundred and threescore and thirteen of the firstborn of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, which are more than the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char>;</para>
  <para style="p">
    <verse number="47" style="v" />you<char style="ord">i</char> shall even take five shekels apiece by the poll, after the shekel of the sanctuary shall you<char style="ord">i</char> take <char style="add">[them]</char> (the shekel <char style="add">[is]</char> twenty gerahs)</para>
  <para style="p">
    <verse number="48" style="v" />And you<char style="ord">i</char> shall give the money, which the over and above <char style="pn">(what is left over)</char> of them is to be redeemed, unto Aharon <char style="add">[Bright, Very High]</char> and to his sons.</para>
  <para style="p">
    <verse number="49" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> took the redemption money of them that were over and above them that were redeemed by the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char>:</para>
  <para style="p">
    <verse number="50" style="v" />Of the firstborn of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> took he the money; a thousand three hundred and threescore and five <char style="add">[shekels]</char>, after the shekel of the sanctuary:</para>
  <para style="p">
    <verse number="51" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> gave the money of them that were redeemed unto Aharon <char style="add">[Bright, Very High]</char> and to his sons, according to the word of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, as the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded Moshe <char style="add">[He Who Draws Out Of The Waters]</char>.</para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and unto Aharon <char style="add">[Bright, Very High]</char>, saying,</para>
  <para style="p">
    <verse number="2" style="v" />Take the sum of the sons of K’hat <char style="add">[assembly, congregation]</char> from among the sons of Levi <char style="pn">(Levite)</char> <char style="add">[Adhesion, Joiner]</char>, after their families, by the house of their fathers,</para>
  <para style="p">
    <verse number="3" style="v" />From thirty years old and upward even until fifty years old, all that enter into the host, to do the work in the tabernacle of the congregation.</para>
  <para style="p">
    <verse number="4" style="v" />This <char style="add">[shall be]</char> the service of the sons of K’hat <char style="add">[assembly, congregation]</char> in the tabernacle of the congregation, <char style="add">[about]</char> the most holy things:</para>
  <para style="p">
    <verse number="5" style="v" />And when the camp sets forward, Aharon <char style="add">[Bright, Very High]</char> shall come, and his sons, and they shall take down the covering veil, and cover the ark of testimony with it:</para>
  <para style="p">
    <verse number="6" style="v" />And shall put thereon the covering of badgers’ skins, and shall spread over <char style="add">[it]</char> a cloth wholly of blue, and shall put in the rods <char style="pn">(clubs)</char> thereof.</para>
  <para style="p">
    <verse number="7" style="v" />And upon the table of showbread, they shall spread a cloth of blue, and put thereon the dishes, and the spoons, and the bowls, and covers to cover withal: and the continual bread shall be thereon:</para>
  <para style="p">
    <verse number="8" style="v" />And they shall spread upon them a cloth of scarlet, and cover the same with a covering of badgers’ skins, and shall put in the rods <char style="pn">(clubs)</char> thereof.</para>
  <para style="p">
    <verse number="9" style="v" />And they shall take a cloth of blue, and cover the candlestick of the light, and his lamps, and his tongs, and his snuffdishes, and all the oil vessels thereof, which they minister unto it:</para>
  <para style="p">
    <verse number="10" style="v" />And they shall put it and all the vessels thereof within a covering of badgers’ skins, and shall put <char style="add">[it]</char> upon a bar.</para>
  <para style="p">
    <verse number="11" style="v" />And upon the golden altar, they shall spread a cloth of blue, and cover it with a covering of badgers’ skins, and shall put to the rods <char style="pn">(clubs)</char> thereof:</para>
  <para style="p">
    <verse number="12" style="v" />And they shall take all the instruments of ministry, which they minister in the sanctuary, and put <char style="add">[them]</char> in a cloth of blue, and cover them with a covering of badgers’ skins, and shall put <char style="add">[them]</char> on a bar:</para>
  <para style="p">
    <verse number="13" style="v" />And they shall take away the ashes from the altar, and spread a purple cloth thereon:</para>
  <para style="p">
    <verse number="14" style="v" />And they shall put upon it all the vessels thereof, which they minister about it, <char style="add">[even]</char> the censers, the flesh hooks, and the shovels, and the basins, all the vessels of the altar; and they shall spread upon it a covering of badgers’ skins, and put to the rods <char style="pn">(clubs)</char> of it.</para>
  <para style="p">
    <verse number="15" style="v" />And when Aharon <char style="add">[Bright, Very High]</char> and his sons have made an end of covering the sanctuary, and all the vessels of the sanctuary, as the camp is to set forward; after that, the sons of K’hat <char style="add">[assembly, congregation]</char> shall come to bear <char style="add">[it]</char>: but they shall not touch <char style="add">[any]</char> holy thing, lest they die. These <char style="add">[things are]</char> the burden of the sons of K’hat <char style="add">[assembly, congregation]</char> in the tabernacle of the congregation.</para>
  <para style="p">
    <verse number="16" style="v" />And to the office of El’azar <char style="add">[God has helped]</char> the son of Aharon <char style="add">[Bright, Very High]</char> the priest <char style="add">[pertains]</char> the oil for the light, and the sweet incense, and the daily meat offering, and the anointing oil, <char style="add">[and]</char> the oversight of all the tabernacle, and of all that in it <char style="add">[is]</char>, in the sanctuary, and in the vessels thereof.</para>
  <para style="p">
    <verse number="17" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and unto Aharon <char style="add">[Bright, Very High]</char>, saying,</para>
  <para style="p">
    <verse number="18" style="v" />Cut you<char style="ord">2f</char> not off the tribe of the families of the K’hati from among the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char>:</para>
  <para style="p">
    <verse number="19" style="v" />But thus do unto them, that they may live, and not die, when they approach unto the most holy things: Aharon <char style="add">[Bright, Very High]</char> and his sons shall go in, and appoint them every one to his service and to his burden:</para>
  <para style="p">
    <verse number="20" style="v" />But they shall not go in to see when the holy things are covered, lest they die.</para>
  <para style="p">
    <verse number="21" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="22" style="v" />Take also the sum of the sons of Gershon <char style="add">[Exile]</char>, throughout the houses of their fathers, by their families;</para>
  <para style="p">
    <verse number="23" style="v" />From thirty years old and upward until fifty years old shall you<char style="ord">i</char> number them; all that enter in to perform the service, to do the work in the tabernacle of the congregation.</para>
  <para style="p">
    <verse number="24" style="v" />This <char style="add">[is]</char> the service of the families of the Gershuni <char style="add">[Exiled Ones]</char>, to serve, and for burdens:</para>
  <para style="p">
    <verse number="25" style="v" />And they shall bear the curtains of the tabernacle, and the tabernacle of the congregation, his covering, and the covering of the badgers’ skins that <char style="add">[is]</char> above upon it, and the hanging for the door of the tabernacle of the congregation,</para>
  <para style="p">
    <verse number="26" style="v" />And the hangings of the court, and the hanging for the door of the gate of the court, which <char style="add">[is]</char> by the tabernacle and by the altar round about, and their cords, and all the instruments of their service, and all that is made for them: so shall they serve.</para>
  <para style="p">
    <verse number="27" style="v" />At the appointment of Aharon <char style="add">[Bright, Very High]</char> and his sons shall be all the service of the sons of the Gershuni <char style="add">[Exiled Ones]</char>, in all their burdens, and in all their service: and you<char style="ord">2f</char> shall appoint unto them in charge all their burdens.</para>
  <para style="p">
    <verse number="28" style="v" />This <char style="add">[is]</char> the service of the families of the sons of Gershon <char style="add">[Exile]</char> in the tabernacle of the congregation: and their charge <char style="add">[shall be]</char> under the hand of Itamar <char style="add">[Coast of Palms]</char> the son of Aharon <char style="add">[Bright, Very High]</char> the priest.</para>
  <para style="p">
    <verse number="29" style="v" />As for the sons of M’rari <char style="add">[Bitter]</char>, you<char style="ord">i</char> shall number them after their families, by the house of their fathers;</para>
  <para style="p">
    <verse number="30" style="v" />From thirty years old and upward even unto fifty years old shall you<char style="ord">i</char> number them, every one that enters into the service, to do the work of the tabernacle of the congregation.</para>
  <para style="p">
    <verse number="31" style="v" />And this <char style="add">[is]</char> the charge of their burden, according to all their service in the tabernacle of the congregation; the boards of the tabernacle, and the bars thereof, and the pillars thereof, and sockets thereof,</para>
  <para style="p">
    <verse number="32" style="v" />And the pillars of the court round about, and their sockets, and their pins, and their cords, with all their instruments, and with all their service: and by name you<char style="ord">2f</char> shall reckon the instruments of the charge of their burden.</para>
  <para style="p">
    <verse number="33" style="v" />This <char style="add">[is]</char> the service of the families of the sons of M’rari <char style="add">[Bitter]</char>, according to all their service, in the tabernacle of the congregation, under the hand of Itamar <char style="add">[Coast of Palms]</char> the son of Aharon <char style="add">[Bright, Very High]</char> the priest.</para>
  <para style="p">
    <verse number="34" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and Aharon <char style="add">[Bright, Very High]</char> and the chief of the congregation numbered the sons of the K’hati after their families, and after the house of their fathers,</para>
  <para style="p">
    <verse number="35" style="v" />From thirty years old and upward even unto fifty years old, every one that enters into the service, for the work in the tabernacle of the congregation:</para>
  <para style="p">
    <verse number="36" style="v" />And those that were numbered of them by their families were two thousand seven hundred and fifty.</para>
  <para style="p">
    <verse number="37" style="v" />These <char style="add">[were]</char> they that were numbered of the families of the K’hati, all that might do service in the tabernacle of the congregation, which Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and Aharon <char style="add">[Bright, Very High]</char> did number according to the commandment of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> by the hand of Moshe <char style="add">[He Who Draws Out Of The Waters]</char>.</para>
  <para style="p">
    <verse number="38" style="v" />And those that were numbered of the sons of Gershon <char style="add">[Exile]</char>, throughout their families, and by the house of their fathers,</para>
  <para style="p">
    <verse number="39" style="v" />From thirty years old and upward even unto fifty years old, every one that enters into the service, for the work in the tabernacle of the congregation,</para>
  <para style="p">
    <verse number="40" style="v" />Even those that were numbered of them, throughout their families, by the house of their fathers, were two thousand and six hundred and thirty.</para>
  <para style="p">
    <verse number="41" style="v" />These <char style="add">[are]</char> they that were numbered of the families of the sons of Gershon <char style="add">[Exile]</char>, of all that might do service in the tabernacle of the congregation, whom Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and Aharon <char style="add">[Bright, Very High]</char> did number according to the commandment of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="42" style="v" />And those that were numbered of the families of the sons of M’rari <char style="add">[Bitter]</char>, throughout their families, by the house of their fathers,</para>
  <para style="p">
    <verse number="43" style="v" />From thirty years old and upward even unto fifty years old, every one that enters into the service, for the work in the tabernacle of the congregation,</para>
  <para style="p">
    <verse number="44" style="v" />Even those that were numbered of them after their families, were three thousand and two hundred.</para>
  <para style="p">
    <verse number="45" style="v" />These <char style="add">[be]</char> those that were numbered of the families of the sons of M’rari <char style="add">[Bitter]</char>, whom Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and Aharon <char style="add">[Bright, Very High]</char> numbered according to the word of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> by the hand of Moshe <char style="add">[He Who Draws Out Of The Waters]</char>.</para>
  <para style="p">
    <verse number="46" style="v" />All those that were numbered of the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char>, whom Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and Aharon <char style="add">[Bright, Very High]</char> and the chief of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> numbered, after their families, and after the house of their fathers,</para>
  <para style="p">
    <verse number="47" style="v" />From thirty years old and upward even unto fifty years old, every one that came to do the service of the ministry, and the service of the burden in the tabernacle of the congregation,</para>
  <para style="p">
    <verse number="48" style="v" />Even those that were numbered of them, were eight thousand and five hundred and eighty.</para>
  <para style="p">
    <verse number="49" style="v" />According to the commandment of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> they were numbered by the hand of Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, every one according to his service, and according to his burden: thus were they numbered of him, as the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded Moshe <char style="add">[He Who Draws Out Of The Waters]</char>.</para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="2" style="v" />Command the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, that they put out of the camp every leper, and every one that has an issue <char style="pn">(what comes forth)</char>, and whosoever is defiled by the dead:</para>
  <para style="p">
    <verse number="3" style="v" />Both male and female shall you<char style="ord">2f</char> put out, without the camp shall you<char style="ord">2f</char> put them; that they defile not their camps, in the midst whereof I dwell.</para>
  <para style="p">
    <verse number="4" style="v" />And the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> did so, and put them out without the camp: as the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, so did the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="5" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="6" style="v" />Speak unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, When a man or woman shall commit any sin that men commit, to do a trespass against the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and that person be guilty;</para>
  <para style="p">
    <verse number="7" style="v" />Then they shall confess their sin which they have done: and he shall recompense his trespass with the principal thereof, and add unto it the fifth <char style="add">[part]</char> thereof, and give <char style="add">[it]</char> unto <char style="add">[him]</char> against whom he has trespassed.</para>
  <para style="p">
    <verse number="8" style="v" />But if the man have no kinsman to recompense the trespass unto, let the trespass be recompensed unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, <char style="add">[even]</char> to the priest; beside the ram of the atonement, whereby an atonement shall be made for him.</para>
  <para style="p">
    <verse number="9" style="v" />And every offering of all the holy things of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, which they bring unto the priest, shall be his.</para>
  <para style="p">
    <verse number="10" style="v" />And every man’s consecrated things shall be his: whatsoever any man gives the priest, it shall be his.</para>
  <para style="p">
    <verse number="11" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="12" style="v" />Speak unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, and say unto them, If any man’s wife go aside, and commit a trespass against him,</para>
  <para style="p">
    <verse number="13" style="v" />And a man lie with her carnally, and it be hid from the eyes of her husband, and be kept close, and she be defiled, and <char style="add">[there be]</char> no witness against her, neither she be taken <char style="add">[with the manner]</char>;</para>
  <para style="p">
    <verse number="14" style="v" />And the spirit of jealousy come upon him, and he be jealous of his wife, and she be defiled: or if the spirit of jealousy come upon him, and he be jealous of his wife, and she be not defiled:</para>
  <para style="p">
    <verse number="15" style="v" />Then shall the man bring his wife unto the priest, and he shall bring her offering for her, the tenth <char style="add">[part]</char> of an eifah of barley meal; he shall pour no oil upon it, nor put frankincense thereon; for it <char style="add">[is]</char> an offering of jealousy, an offering of memorial, bringing iniquity to remembrance.</para>
  <para style="p">
    <verse number="16" style="v" />And the priest shall bring her near, and set her before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>:</para>
  <para style="p">
    <verse number="17" style="v" />And the priest shall take holy water in an earthen vessel; and of the dust that is in the floor of the tabernacle the priest shall take, and put <char style="add">[it]</char> into the water:</para>
  <para style="p">
    <verse number="18" style="v" />And the priest shall set the woman before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and uncover the woman’s head, and put the offering of memorial in her hands, which <char style="add">[is]</char> the jealousy offering: and the priest shall have in his hand the bitter water that causes the curse:</para>
  <para style="p">
    <verse number="19" style="v" />And the priest shall charge her by an oath, and say unto the woman, If no man have lain with you<char style="ord">i</char>, and if you<char style="ord">i</char> have not gone aside to uncleanness <char style="add">[with another]</char> instead of you<char style="ord">i</char> husband, be you<char style="ord">i</char> free from this bitter water that causes the curse:</para>
  <para style="p">
    <verse number="20" style="v" />But if you<char style="ord">i</char> have gone aside <char style="add">[to another]</char> instead of you<char style="ord">i</char> husband, and if you<char style="ord">i</char> be defiled, and some man have lain with you<char style="ord">i</char> beside you<char style="ord">i</char> husband:</para>
  <para style="p">
    <verse number="21" style="v" />Then the priest shall charge the woman with an oath of cursing, and the priest shall say unto the woman, The LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> make you<char style="ord">i</char> a curse and an oath among you<char style="ord">i</char> people, when the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> does make you<char style="ord">i</char> thigh to rot, and you<char style="ord">i</char> belly to swell;</para>
  <para style="p">
    <verse number="22" style="v" />And this water that causes the curse shall go into you<char style="ord">i</char> bowels <char style="pn">(inward parts; affections)</char>, to make <char style="pn">[you<char style="ord">i</char>]</char> belly to swell, and <char style="add">[you<char style="ord">i</char>]</char> thigh to rot: And the woman shall say, Amen, amen.</para>
  <para style="p">
    <verse number="23" style="v" />And the priest shall write these curses in a book, and he shall blot <char style="add">[them]</char> out with the bitter water:</para>
  <para style="p">
    <verse number="24" style="v" />And he shall cause the woman to drink the bitter water that causes the curse: and the water that causes the curse shall enter into her, <char style="add">[and become]</char> bitter.</para>
  <para style="p">
    <verse number="25" style="v" />Then the priest shall take the jealousy offering out of the woman’s hand, and shall wave the offering before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and offer it upon the altar:</para>
  <para style="p">
    <verse number="26" style="v" />And the priest shall take an handful of the offering, <char style="add">[even]</char> the memorial thereof, and burn <char style="add">[it]</char> upon the altar, and afterward shall cause the woman to drink the water.</para>
  <para style="p">
    <verse number="27" style="v" />And when he has made her to drink the water, then it shall come to pass, <char style="add">[that]</char>, if she be defiled, and have done trespass against her husband, that the water that causes the curse shall enter into her, <char style="add">[and become]</char> bitter, and her belly shall swell, and her thigh shall rot: and the woman shall be a curse among her people.</para>
  <para style="p">
    <verse number="28" style="v" />And if the woman be not defiled, but be clean; then she shall be free, and shall conceive seed.</para>
  <para style="p">
    <verse number="29" style="v" />This <char style="add">[is]</char> the law of jealousies, when a wife goes aside <char style="add">[to another]</char> instead of her husband, and is defiled;</para>
  <para style="p">
    <verse number="30" style="v" />Or when the spirit of jealousy comes upon him, and he be jealous over his wife, and shall set the woman before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and the priest shall execute upon her all this law.</para>
  <para style="p">
    <verse number="31" style="v" />Then shall the man be guiltless from iniquity, and this woman shall bear her iniquity.</para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="2" style="v" />Speak unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, and say unto them, When either man or woman shall separate <char style="add">[themselves]</char> to vow a vow of a Nazir <char style="add">[One Separated]</char>, to separate <char style="add">[themselves]</char> unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>:</para>
  <para style="p">
    <verse number="3" style="v" />He shall separate <char style="add">[himself]</char> from wine and strong drink, and shall drink no vinegar of wine, or vinegar of strong drink, neither shall he drink any liquor of grapes, nor eat moist grapes, or dried.</para>
  <para style="p">
    <verse number="4" style="v" />All the days of his separation shall he eat nothing that is made of the vine tree, from the kernels even to the husk.</para>
  <para style="p">
    <verse number="5" style="v" />All the days of the vow of his separation there shall no razor come upon his head: until the days be fulfilled, in the which he separates <char style="add">[himself]</char> unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, he shall be holy, <char style="add">[and]</char> shall let the locks of the hair of his head grow.</para>
  <para style="p">
    <verse number="6" style="v" />All the days that he separates <char style="add">[himself]</char> unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> he shall come at no dead body.</para>
  <para style="p">
    <verse number="7" style="v" />He shall not make himself unclean for his father, or for his mother, for his brother, or for his sister, when they die: because the consecration of his God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered] [is]</char> upon his head.</para>
  <para style="p">
    <verse number="8" style="v" />All the days of his separation he <char style="add">[is]</char> holy unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="9" style="v" />And if any man die very suddenly by him, and he has defiled the head of his consecration; then he shall shave his head in the day of his cleansing, on the seventh day shall he shave it.</para>
  <para style="p">
    <verse number="10" style="v" />And on the eighth day he shall bring two turtles, or two young pigeons, to the priest, to the door of the tabernacle of the congregation:</para>
  <para style="p">
    <verse number="11" style="v" />And the priest shall offer the one for a sin offering, and the other for a burnt offering, and make an atonement for him, for that he sinned by the dead, and shall hallow <char style="pn">(to approve, commend, accept)</char> his head that same day.</para>
  <para style="p">
    <verse number="12" style="v" />And he shall consecrate <char style="pn">(treat as set apart or separate unto God)</char> unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> the days of his separation, and shall bring a lamb of the first year for a trespass offering: but the days that were before shall be lost, because his separation was defiled.</para>
  <para style="p">
    <verse number="13" style="v" />And this <char style="add">[is]</char> the law of the Nazir <char style="add">[One Separated]</char>, when the days of his separation are fulfilled: he shall be brought unto the door of the tabernacle of the congregation:</para>
  <para style="p">
    <verse number="14" style="v" />And he shall offer his offering unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, one he lamb of the first year without blemish for a burnt offering, and one ewe lamb of the first year without blemish for a sin offering, and one ram without blemish for peace offerings,</para>
  <para style="p">
    <verse number="15" style="v" />And a basket of unleavened bread, cakes of fine flour mingled with oil, and wafers of unleavened bread anointed with oil, and their meat offering, and their drink offerings.</para>
  <para style="p">
    <verse number="16" style="v" />And the priest shall bring <char style="add">[them]</char> before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and shall offer his sin offering, and his burnt offering:</para>
  <para style="p">
    <verse number="17" style="v" />And he shall offer the ram <char style="add">[for]</char> a sacrifice of peace offerings unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, with the basket of unleavened bread: the priest shall offer also his meat offering, and his drink offering.</para>
  <para style="p">
    <verse number="18" style="v" />And the Nazir <char style="add">[One Separated]</char> shall shave the head of his separation <char style="add">[at]</char> the door of the tabernacle of the congregation, and shall take the hair of the head of his separation, and put <char style="add">[it]</char> in the fire which <char style="add">[is]</char> under the sacrifice of the peace offerings.</para>
  <para style="p">
    <verse number="19" style="v" />And the priest shall take the coocked <char style="pn">(boiled)</char> shoulder of the ram, and one unleavened cake out of the basket, and one unleavened wafer, and shall put <char style="add">[them]</char> upon the hands of the Nazir <char style="add">[One Separated]</char>, after <char style="add">[the hair of]</char> his separation is shaven:</para>
  <para style="p">
    <verse number="20" style="v" />And the priest shall wave them <char style="add">[for]</char> a wave offering before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>: this <char style="add">[is]</char> holy for the priest, with the wave breast and heave shoulder: and after that the Nazir <char style="add">[One Separated]</char> may drink wine.</para>
  <para style="p">
    <verse number="21" style="v" />This <char style="add">[is]</char> the law of the Nazir <char style="add">[One Separated]</char> who has vowed, <char style="add">[and of]</char> his offering unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> for his separation, beside <char style="add">[that]</char> that his hand shall get: according to the vow which he vowed, so he must do after the law of his separation.</para>
  <para style="p">
    <verse number="22" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="23" style="v" />Speak unto Aharon <char style="add">[Bright, Very High]</char> and unto his sons, saying, On this wise you<char style="ord">2f</char> shall bless the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, saying unto them,</para>
  <para style="p">
    <verse number="24" style="v" />The LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> bless you<char style="ord">i</char>, and keep you<char style="ord">i</char>:</para>
  <para style="p">
    <verse number="25" style="v" />The LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> make his face shine upon you<char style="ord">i</char>, and be gracious unto you<char style="ord">i</char>:</para>
  <para style="p">
    <verse number="26" style="v" />The LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> lift up his Countenance <char style="pn">(Face, appearance; show favor)</char> upon you<char style="ord">i</char>, and give you<char style="ord">i</char> peace.</para>
  <para style="p">
    <verse number="27" style="v" />And they shall put my name upon the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>; and I will bless them.</para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />And it came to pass on the day that Moshe <char style="add">[He Who Draws Out Of The Waters]</char> had fully set up the tabernacle, and had anointed it, and sanctified it, and all the instruments thereof, both the altar and all the vessels thereof, and had anointed them, and sanctified them;</para>
  <para style="p">
    <verse number="2" style="v" />That the princes of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, heads of the house of their fathers, who <char style="add">[were]</char> the princes of the tribes, and were over them that were numbered, offered:</para>
  <para style="p">
    <verse number="3" style="v" />And they brought their offering before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, six covered wagons, and twelve oxen; a wagon for two of the princes, and for each one an ox: and they brought them before the tabernacle.</para>
  <para style="p">
    <verse number="4" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="5" style="v" />Take <char style="add">[it]</char> of them, that they may be to do the service of the tabernacle of the congregation; and you<char style="ord">i</char> shall give them unto the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char>, to every man according to his service.</para>
  <para style="p">
    <verse number="6" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> took the wagons and the oxen, and gave them unto the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char>.</para>
  <para style="p">
    <verse number="7" style="v" />Two wagons and four oxen he gave unto the sons of Gershon <char style="add">[Exile]</char>, according to their service:</para>
  <para style="p">
    <verse number="8" style="v" />And four wagons and eight oxen he gave unto the sons of M’rari <char style="add">[Bitter]</char>, according unto their service, under the hand of Itamar <char style="add">[Coast of Palms]</char> the son of Aharon <char style="add">[Bright, Very High]</char> the priest.</para>
  <para style="p">
    <verse number="9" style="v" />But unto the sons of K’hat <char style="add">[assembly, congregation]</char> he gave none: because the service of the sanctuary belonging unto them <char style="add">[was that]</char> they should bear upon their shoulders.</para>
  <para style="p">
    <verse number="10" style="v" />And the princes offered for dedicating of the altar in the day that it was anointed, even the princes offered their offering before the altar.</para>
  <para style="p">
    <verse number="11" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> said unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, They shall offer their offering, each prince on his day, for the dedicating of the altar.</para>
  <para style="p">
    <verse number="12" style="v" />And he that offered his offering the first day was Nachshon <char style="add">[Enchanter]</char> the son of ‘Amminadav <char style="add">[family of the prince]</char>, of the tribe of Y’hudah <char style="add">[Let Him (God) Be Praised]</char>:</para>
  <para style="p">
    <verse number="13" style="v" />And his offering <char style="add">[was]</char> one silver charger <char style="pn">(a large platter or dish)</char>, the weight thereof <char style="add">[was]</char> an hundred and thirty <char style="add">[shekels]</char>, one silver bowl of seventy shekels, after the shekel of the sanctuary; both of them <char style="add">[were]</char> full of fine flour mingled with oil for a meat offering:</para>
  <para style="p">
    <verse number="14" style="v" />One spoon of ten <char style="add">[shekels]</char> of gold, full of incense:</para>
  <para style="p">
    <verse number="15" style="v" />One young bullock, one ram, one lamb of the first year, for a burnt offering:</para>
  <para style="p">
    <verse number="16" style="v" />One kid of the goats for a sin offering:</para>
  <para style="p">
    <verse number="17" style="v" />And for a sacrifice of peace offerings, two oxen, five rams, five he goats, five lambs of the first year: this <char style="add">[was]</char> the offering of Nachshon <char style="add">[Enchanter]</char> the son of ‘Amminadav <char style="add">[family of the prince]</char>.</para>
  <para style="p">
    <verse number="18" style="v" />On the second day N’tan’el <char style="add">[God’s Gift]</char> the son of Zuar <char style="add">[Small]</char>, prince of Yissakhar <char style="add">[There Is Recompense]</char>, did offer:</para>
  <para style="p">
    <verse number="19" style="v" />He offered <char style="add">[for]</char> his offering one silver charger <char style="pn">(a large platter or dish)</char>, the weight whereof <char style="add">[was]</char> an hundred and thirty <char style="add">[shekels]</char>, one silver bowl of seventy shekels, after the shekel of the sanctuary; both of them full of fine flour mingled with oil for a meat offering:</para>
  <para style="p">
    <verse number="20" style="v" />One spoon of gold of ten <char style="add">[shekels]</char>, full of incense:</para>
  <para style="p">
    <verse number="21" style="v" />One young bullock, one ram, one lamb of the first year, for a burnt offering:</para>
  <para style="p">
    <verse number="22" style="v" />One kid of the goats for a sin offering:</para>
  <para style="p">
    <verse number="23" style="v" />And for a sacrifice of peace offerings, two oxen, five rams, five he goats, five lambs of the first year: this <char style="add">[was]</char> the offering of N’tan’el <char style="add">[God’s Gift]</char> the son of Zuar <char style="add">[Small]</char>.</para>
  <para style="p">
    <verse number="24" style="v" />On the third day ‘Eli’av <char style="add">[My Father is God]</char> the son of Helon <char style="add">[Strength]</char>, prince of the children of Z’vulun <char style="add">[Glorious Dwelling Place]</char>, <char style="add">[did offer]</char>:</para>
  <para style="p">
    <verse number="25" style="v" />His offering <char style="add">[was]</char> one silver charger <char style="pn">(a large platter or dish)</char>, the weight whereof <char style="add">[was]</char> an hundred and thirty <char style="add">[shekels]</char>, one silver bowl of seventy shekels, after the shekel of the sanctuary; both of them full of fine flour mingled with oil for a meat offering:</para>
  <para style="p">
    <verse number="26" style="v" />One golden spoon of ten <char style="add">[shekels]</char>, full of incense:</para>
  <para style="p">
    <verse number="27" style="v" />One young bullock, one ram, one lamb of the first year, for a burnt offering:</para>
  <para style="p">
    <verse number="28" style="v" />One kid of the goats for a sin offering:</para>
  <para style="p">
    <verse number="29" style="v" />And for a sacrifice of peace offerings, two oxen, five rams, five he goats, five lambs of the first year: this <char style="add">[was]</char> the offering of ‘Eli’av <char style="add">[My Father is God]</char> the son of Helon <char style="add">[Strength]</char>.</para>
  <para style="p">
    <verse number="30" style="v" />On the fourth day Elitzur <char style="add">[My God is a Rock]</char> the son of Sh’de’ur <char style="add">[Almighty’s Light]</char>, prince of the children of Re’uven <char style="add">[Behold a Son]</char>, <char style="add">[did offer]</char>:</para>
  <para style="p">
    <verse number="31" style="v" />His offering <char style="add">[was]</char> one silver charger <char style="pn">(a large platter or dish)</char> of the weight of an hundred and thirty <char style="add">[shekels]</char>, one silver bowl of seventy shekels, after the shekel of the sanctuary; both of them full of fine flour mingled with oil for a meat offering:</para>
  <para style="p">
    <verse number="32" style="v" />One golden spoon of ten <char style="add">[shekels]</char>, full of incense:</para>
  <para style="p">
    <verse number="33" style="v" />One young bullock, one ram, one lamb of the first year, for a burnt offering:</para>
  <para style="p">
    <verse number="34" style="v" />One kid of the goats for a sin offering:</para>
  <para style="p">
    <verse number="35" style="v" />And for a sacrifice of peace offerings, two oxen, five rams, five he goats, five lambs of the first year: this <char style="add">[was]</char> the offering of Elitzur <char style="add">[My God is a Rock]</char> the son of Sh’de’ur <char style="add">[Almighty’s Light]</char>.</para>
  <para style="p">
    <verse number="36" style="v" />On the fifth day Shlumi’el <char style="add">[Friend of God]</char> the son of Tzuri-shaddai <char style="add">[My Rock is the Almighty]</char>, prince of the children of Shim’on <char style="add">[he who hears]</char>, <char style="add">[did offer]</char>:</para>
  <para style="p">
    <verse number="37" style="v" />His offering <char style="add">[was]</char> one silver charger <char style="pn">(a large platter or dish)</char>, the weight whereof <char style="add">[was]</char> an hundred and thirty <char style="add">[shekels]</char>, one silver bowl of seventy shekels, after the shekel of the sanctuary; both of them full of fine flour mingled with oil for a meat offering:</para>
  <para style="p">
    <verse number="38" style="v" />One golden spoon of ten <char style="add">[shekels]</char>, full of incense:</para>
  <para style="p">
    <verse number="39" style="v" />One young bullock, one ram, one lamb of the first year, for a burnt offering:</para>
  <para style="p">
    <verse number="40" style="v" />One kid of the goats for a sin offering:</para>
  <para style="p">
    <verse number="41" style="v" />And for a sacrifice of peace offerings, two oxen, five rams, five he goats, five lambs of the first year: this <char style="add">[was]</char> the offering of Shlumi’el <char style="add">[Friend of God]</char> the son of Tzuri-shaddai <char style="add">[My Rock is the Almighty]</char>.</para>
  <para style="p">
    <verse number="42" style="v" />On the sixth day Elyasaf <char style="add">[My God has Added]</char> the son of De’u’el <char style="add">[They Know God]</char>, prince of the children of Gad <char style="add">[Good Fortune with Troublesome Effort]</char>, <char style="add">[offered]</char>:</para>
  <para style="p">
    <verse number="43" style="v" />His offering <char style="add">[was]</char> one silver charger <char style="pn">(a large platter or dish)</char> of the weight of an hundred and thirty <char style="add">[shekels]</char>, a silver bowl of seventy shekels, after the shekel of the sanctuary; both of them full of fine flour mingled with oil for a meat offering:</para>
  <para style="p">
    <verse number="44" style="v" />One golden spoon of ten <char style="add">[shekels]</char>, full of incense:</para>
  <para style="p">
    <verse number="45" style="v" />One young bullock, one ram, one lamb of the first year, for a burnt offering:</para>
  <para style="p">
    <verse number="46" style="v" />One kid of the goats for a sin offering:</para>
  <para style="p">
    <verse number="47" style="v" />And for a sacrifice of peace offerings, two oxen, five rams, five he goats, five lambs of the first year: this <char style="add">[was]</char> the offering of Elyasaf <char style="add">[My God has Added]</char> the son of De’u’el <char style="add">[They Know God]</char>.</para>
  <para style="p">
    <verse number="48" style="v" />On the seventh day Elishama <char style="add">[My God has Heard]</char> the son of Ammihud <char style="add">[People of Magesty]</char>, prince of the children of Efrayim <char style="add">[Doubly Fruitful]</char>, <char style="add">[offered]</char>:</para>
  <para style="p">
    <verse number="49" style="v" />His offering <char style="add">[was]</char> one silver charger <char style="pn">(a large platter or dish)</char>, the weight whereof <char style="add">[was]</char> an hundred and thirty <char style="add">[shekels]</char>, one silver bowl of seventy shekels, after the shekel of the sanctuary; both of them full of fine flour mingled with oil for a meat offering:</para>
  <para style="p">
    <verse number="50" style="v" />One golden spoon of ten <char style="add">[shekels]</char>, full of incense:</para>
  <para style="p">
    <verse number="51" style="v" />One young bullock, one ram, one lamb of the first year, for a burnt offering:</para>
  <para style="p">
    <verse number="52" style="v" />One kid of the goats for a sin offering:</para>
  <para style="p">
    <verse number="53" style="v" />And for a sacrifice of peace offerings, two oxen, five rams, five he goats, five lambs of the first year: this <char style="add">[was]</char> the offering of Elishama <char style="add">[My God has Heard]</char> the son of Ammihud <char style="add">[People of Magesty]</char>.</para>
  <para style="p">
    <verse number="54" style="v" />On the eighth day <char style="add">[offered]</char> Gamali’el <char style="add">[Reward of God]</char> the son of Pedahzur <char style="add">[The Rock has Ransomed]</char>, prince of the children of M’nasheh <char style="add">[Causing to Forget]</char>:</para>
  <para style="p">
    <verse number="55" style="v" />His offering <char style="add">[was]</char> one silver charger <char style="pn">(a large platter or dish)</char> of the weight of an hundred and thirty <char style="add">[shekels]</char>, one silver bowl of seventy shekels, after the shekel of the sanctuary; both of them full of fine flour mingled with oil for a meat offering:</para>
  <para style="p">
    <verse number="56" style="v" />One golden spoon of ten <char style="add">[shekels]</char>, full of incense:</para>
  <para style="p">
    <verse number="57" style="v" />One young bullock, one ram, one lamb of the first year, for a burnt offering:</para>
  <para style="p">
    <verse number="58" style="v" />One kid of the goats for a sin offering:</para>
  <para style="p">
    <verse number="59" style="v" />And for a sacrifice of peace offerings, two oxen, five rams, five he goats, five lambs of the first year: this <char style="add">[was]</char> the offering of Gamali’el <char style="add">[Reward of God]</char> the son of Pedahzur <char style="add">[The Rock has Ransomed]</char>.</para>
  <para style="p">
    <verse number="60" style="v" />On the ninth day Avidan <char style="add">[My Father is Judge]</char> the son of Gid’oni <char style="add">[My Hewer]</char>, prince of the children of Binyamin <char style="add">[Son of the Right Hand/Strength]</char>, <char style="add">[offered]</char>:</para>
  <para style="p">
    <verse number="61" style="v" />His offering <char style="add">[was]</char> one silver charger <char style="pn">(a large platter or dish)</char>, the weight whereof <char style="add">[was]</char> an hundred and thirty <char style="add">[shekels]</char>, one silver bowl of seventy shekels, after the shekel of the sanctuary; both of them full of fine flour mingled with oil for a meat offering:</para>
  <para style="p">
    <verse number="62" style="v" />One golden spoon of ten <char style="add">[shekels]</char>, full of incense:</para>
  <para style="p">
    <verse number="63" style="v" />One young bullock, one ram, one lamb of the first year, for a burnt offering:</para>
  <para style="p">
    <verse number="64" style="v" />One kid of the goats for a sin offering:</para>
  <para style="p">
    <verse number="65" style="v" />And for a sacrifice of peace offerings, two oxen, five rams, five he goats, five lambs of the first year: this <char style="add">[was]</char> the offering of Avidan <char style="add">[My Father is Judge]</char> the son of Gid’oni <char style="add">[My Hewer]</char>.</para>
  <para style="p">
    <verse number="66" style="v" />On the tenth day Achi’ezer <char style="add">[My Brother is Help]</char> the son of ‘‘Ammi <char style="add">[my people]</char> -Shaddai <char style="add">[Shaddai is my Kinsman]</char>, prince of the children of Dan <char style="add">[Judge]</char>, <char style="add">[offered]</char>:</para>
  <para style="p">
    <verse number="67" style="v" />His offering <char style="add">[was]</char> one silver charger <char style="pn">(a large platter or dish)</char>, the weight whereof <char style="add">[was]</char> an hundred and thirty <char style="add">[shekels]</char>, one silver bowl of seventy shekels, after the shekel of the sanctuary; both of them full of fine flour mingled with oil for a meat offering:</para>
  <para style="p">
    <verse number="68" style="v" />One golden spoon of ten <char style="add">[shekels]</char>, full of incense:</para>
  <para style="p">
    <verse number="69" style="v" />One young bullock, one ram, one lamb of the first year, for a burnt offering:</para>
  <para style="p">
    <verse number="70" style="v" />One kid of the goats for a sin offering:</para>
  <para style="p">
    <verse number="71" style="v" />And for a sacrifice of peace offerings, two oxen, five rams, five he goats, five lambs of the first year: this <char style="add">[was]</char> the offering of Achi’ezer <char style="add">[My Brother is Help]</char> the son of ‘‘Ammi <char style="add">[my people]</char> -Shaddai <char style="add">[Shaddai is my Kinsman]</char>.</para>
  <para style="p">
    <verse number="72" style="v" />On the eleventh day Pag’i’el [God’s Intervention] the son of ‘Okhran <char style="add">[Troubled]</char>, prince of the children of Asher <char style="add">[Happy]</char>, <char style="add">[offered]</char>:</para>
  <para style="p">
    <verse number="73" style="v" />His offering <char style="add">[was]</char> one silver charger <char style="pn">(a large platter or dish)</char>, the weight whereof <char style="add">[was]</char> an hundred and thirty <char style="add">[shekels]</char>, one silver bowl of seventy shekels, after the shekel of the sanctuary; both of them full of fine flour mingled with oil for a meat offering:</para>
  <para style="p">
    <verse number="74" style="v" />One golden spoon of ten <char style="add">[shekels]</char>, full of incense:</para>
  <para style="p">
    <verse number="75" style="v" />One young bullock, one ram, one lamb of the first year, for a burnt offering:</para>
  <para style="p">
    <verse number="76" style="v" />One kid of the goats for a sin offering:</para>
  <para style="p">
    <verse number="77" style="v" />And for a sacrifice of peace offerings, two oxen, five rams, five he goats, five lambs of the first year: this <char style="add">[was]</char> the offering of Pag’i’el <char style="add">[God’s Intervention]</char> the son of ‘Okhran <char style="add">[Troubled]</char>.</para>
  <para style="p">
    <verse number="78" style="v" />On the twelfth day Achira <char style="add">[My Brother is Evil]</char> the son of ‘Enan <char style="add">[keen-eyed]</char>, prince of the children of Naftali <char style="add">[My Wrestling]</char>, <char style="add">[offered]</char>:</para>
  <para style="p">
    <verse number="79" style="v" />His offering <char style="add">[was]</char> one silver charger <char style="pn">(a large platter or dish)</char>, the weight whereof <char style="add">[was]</char> an hundred and thirty <char style="add">[shekels]</char>, one silver bowl of seventy shekels, after the shekel of the sanctuary; both of them full of fine flour mingled with oil for a meat offering:</para>
  <para style="p">
    <verse number="80" style="v" />One golden spoon of ten <char style="add">[shekels]</char>, full of incense:</para>
  <para style="p">
    <verse number="81" style="v" />One young bullock, one ram, one lamb of the first year, for a burnt offering:</para>
  <para style="p">
    <verse number="82" style="v" />One kid of the goats for a sin offering:</para>
  <para style="p">
    <verse number="83" style="v" />And for a sacrifice of peace offerings, two oxen, five rams, five he goats, five lambs of the first year: this <char style="add">[was]</char> the offering of Achira <char style="add">[My Brother is Evil]</char> the son of ‘Enan <char style="add">[keen-eyed]</char>.</para>
  <para style="p">
    <verse number="84" style="v" />This <char style="add">[was]</char> the dedication of the altar, in the day when it was anointed, by the princes of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>: twelve chargers of silver, twelve silver bowls, twelve spoons of gold:</para>
  <para style="p">
    <verse number="85" style="v" />Each charger <char style="pn">(a large platter or dish)</char> of silver <char style="add">[weighing]</char> an hundred and thirty <char style="add">[shekels]</char>, each bowl seventy: all the silver vessels <char style="add">[weighed]</char> two thousand and four hundred <char style="add">[shekels]</char>, after the shekel of the sanctuary:</para>
  <para style="p">
    <verse number="86" style="v" />The golden spoons <char style="add">[were]</char> twelve, full of incense, <char style="add">[weighing]</char> ten <char style="add">[shekels]</char> apiece, after the shekel of the sanctuary: all the gold of the spoons <char style="add">[was]</char> an hundred and twenty <char style="add">[shekels]</char>.</para>
  <para style="p">
    <verse number="87" style="v" />All the oxen for the burnt offering <char style="add">[were]</char> twelve bullocks, the rams twelve, the lambs of the first year twelve, with their meat offering: and the kids of the goats for sin offering twelve.</para>
  <para style="p">
    <verse number="88" style="v" />And all the oxen for the sacrifice of the peace offerings <char style="add">[were]</char> twenty and four bullocks, the rams sixty, the he goats sixty, the lambs of the first year sixty. This <char style="add">[was]</char> the dedication of the altar, after that it was anointed.</para>
  <para style="p">
    <verse number="89" style="v" />And when Moshe <char style="add">[He Who Draws Out Of The Waters]</char> was gone into the tabernacle of the congregation to speak with him, then he heard the voice of one speaking unto him from off the mercy seat that <char style="add">[was]</char> upon the ark of testimony, from between the two cherubim: and he spoke unto him.</para>
  <chapter number="8" style="c" />
  <para style="p">
    <verse number="1" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="2" style="v" />Speak unto Aharon <char style="add">[Bright, Very High]</char>, and say unto him, When you<char style="ord">i</char> lightest the lamps, the seven lamps shall give light over against the candlestick.</para>
  <para style="p">
    <verse number="3" style="v" />And Aharon <char style="add">[Bright, Very High]</char> did so; he lighted the lamps thereof over against the candlestick, as the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded Moshe <char style="add">[He Who Draws Out Of The Waters]</char>.</para>
  <para style="p">
    <verse number="4" style="v" />And this work of the candlestick <char style="add">[was of]</char> beaten gold, unto the shaft thereof, unto the flowers thereof, <char style="add">[was]</char> beaten work: according unto the pattern which the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> had showed Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, so he made the candlestick.</para>
  <para style="p">
    <verse number="5" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="6" style="v" />Take the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> from among the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, and cleanse them.</para>
  <para style="p">
    <verse number="7" style="v" />And thus shall you<char style="ord">i</char> do unto them, to cleanse them: Sprinkle water of purifying upon them, and let them shave all their flesh, and let them wash their clothes, and <char style="add">[so]</char> make themselves clean.</para>
  <para style="p">
    <verse number="8" style="v" />Then let them take a young bullock with his meat offering, <char style="add">[even]</char> fine flour mingled with oil, and another young bullock shall you<char style="ord">i</char> take for a sin offering.</para>
  <para style="p">
    <verse number="9" style="v" />And you<char style="ord">i</char> shall bring the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> before the tabernacle of the congregation: and you<char style="ord">i</char> shall gather the whole assembly of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> together:</para>
  <para style="p">
    <verse number="10" style="v" />And you<char style="ord">i</char> shall bring the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>: and the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> shall put their hands upon the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char>:</para>
  <para style="p">
    <verse number="11" style="v" />And Aharon <char style="add">[Bright, Very High]</char> shall offer the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> <char style="add">[for]</char> an offering of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, that they may execute the service of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="12" style="v" />And the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> shall lay their hands upon the heads of the bullocks: and you<char style="ord">i</char> shall offer the one <char style="add">[for]</char> a sin offering, and the other <char style="add">[for]</char> a burnt offering, unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, to make an atonement for the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char>.</para>
  <para style="p">
    <verse number="13" style="v" />And you<char style="ord">i</char> shall set the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> before Aharon <char style="add">[Bright, Very High]</char>, and before his sons, and offer them <char style="add">[for]</char> an offering unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="14" style="v" />Thus shall you<char style="ord">i</char> separate the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> from among the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>: and the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> shall be my.</para>
  <para style="p">
    <verse number="15" style="v" />And after that shall the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> go in to do the service of the tabernacle of the congregation: and you<char style="ord">i</char> shall cleanse them, and offer them <char style="add">[for]</char> an offering.</para>
  <para style="p">
    <verse number="16" style="v" />For they <char style="add">[are]</char> wholly given unto me from among the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>; instead of such as open every womb, <char style="add">[even instead of]</char> the firstborn of all the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, have I taken them unto me.</para>
  <para style="p">
    <verse number="17" style="v" />For all the firstborn of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God] [are]</char> my, <char style="add">[both]</char> man and beast: on the day that I struck every firstborn in the land of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char> I sanctified them for myself.</para>
  <para style="p">
    <verse number="18" style="v" />And I have taken the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> for all the firstborn of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="19" style="v" />And I have given the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to] [as]</char> a gift to Aharon <char style="add">[Bright, Very High]</char> and to his sons from among the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, to do the service of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> in the tabernacle of the congregation, and to make an atonement for the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>: that there be no plague among the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, when the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> come near unto the sanctuary.</para>
  <para style="p">
    <verse number="20" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, and Aharon <char style="add">[Bright, Very High]</char>, and all the congregation of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, did to the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> according unto all that the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded Moshe <char style="add">[He Who Draws Out Of The Waters]</char> concerning the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char>, so did the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> unto them.</para>
  <para style="p">
    <verse number="21" style="v" />And the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> were purified, and they washed their clothes; and Aharon <char style="add">[Bright, Very High]</char> offered them <char style="add">[as]</char> an offering before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>; and Aharon <char style="add">[Bright, Very High]</char> made an atonement for them to cleanse them.</para>
  <para style="p">
    <verse number="22" style="v" />And after that went the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> in to do their service in the tabernacle of the congregation before Aharon <char style="add">[Bright, Very High]</char>, and before his sons: as the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> had commanded Moshe <char style="add">[He Who Draws Out Of The Waters]</char> concerning the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char>, so did they unto them.</para>
  <para style="p">
    <verse number="23" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="24" style="v" />This <char style="add">[is it]</char> that <char style="add">[belongs]</char> unto the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char>: from twenty and five years old and upward they shall go in to wait upon the service of the tabernacle of the congregation:</para>
  <para style="p">
    <verse number="25" style="v" />And from the age of fifty years they shall cease waiting upon the service <char style="add">[thereof]</char>, and shall serve no more:</para>
  <para style="p">
    <verse number="26" style="v" />But shall minister with their brethren in the tabernacle of the congregation, to keep the charge, and shall do no service. Thus shall you<char style="ord">i</char> do unto the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> touching their charge.</para>
  <chapter number="9" style="c" />
  <para style="p">
    <verse number="1" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char> in the wilderness of Sinai, in the first month of the second year after they were come out of the land of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>, saying,</para>
  <para style="p">
    <verse number="2" style="v" />Let the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> also keep the Passover at his appointed season.</para>
  <para style="p">
    <verse number="3" style="v" />In the fourteenth day of this month, at even, you<char style="ord">2f</char> shall keep it in his appointed season: according to all the rites of it, and according to all the ceremonies thereof, shall you<char style="ord">2f</char> keep it.</para>
  <para style="p">
    <verse number="4" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> spoke unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, that they should keep the Passover.</para>
  <para style="p">
    <verse number="5" style="v" />And they kept the Passover on the fourteenth day of the first month at even in the wilderness of Sinai: according to all that the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, so did the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="6" style="v" />And there were certain men, who were defiled by the dead body of a man, that they could not keep the Passover on that day: and they came before Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and before Aharon <char style="add">[Bright, Very High]</char> on that day:</para>
  <para style="p">
    <verse number="7" style="v" />And those men said unto him, We <char style="add">[are]</char> defiled by the dead body of a man: wherefore are we kept back, that we may not offer an offering of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> in his appointed season among the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>?</para>
  <para style="p">
    <verse number="8" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> said unto them, Stand still, and I will hear what the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> will command concerning you.</para>
  <para style="p">
    <verse number="9" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="10" style="v" />Speak unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, saying, If any man of you or of your posterity shall be unclean by reason of a dead body, or <char style="add">[be]</char> in a journey afar off, yet he shall keep the Passover unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="11" style="v" />The fourteenth day of the second month at even they shall keep it, <char style="add">[and]</char> eat it with unleavened bread and bitter <char style="add">[herbs]</char>.</para>
  <para style="p">
    <verse number="12" style="v" />They shall leave none of it unto the morning, nor break any bone of it: according to all the ordinances of the Passover they shall keep it.</para>
  <para style="p">
    <verse number="13" style="v" />But the man that <char style="add">[is]</char> clean, and is not in a journey, and forbears to keep the Passover, even the same soul shall be cut off from among his people: because he brought not the offering of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> in his appointed season, that man shall bear his sin.</para>
  <para style="p">
    <verse number="14" style="v" />And if a stranger shall sojourn among you, and will keep the Passover unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>; according to the ordinance of the Passover, and according to the manner thereof, so shall he do: you<char style="ord">2f</char> shall have one ordinance, both for the stranger, and for him that was born in the land.</para>
  <para style="p">
    <verse number="15" style="v" />And on the day that the tabernacle was reared up the cloud covered the tabernacle, <char style="add">[namely]</char>, the tent of the testimony: and at even there was upon the tabernacle as it were the appearance of fire, until the morning.</para>
  <para style="p">
    <verse number="16" style="v" />So it was always: the cloud covered it <char style="add">[by day]</char>, and the appearance of fire by night.</para>
  <para style="p">
    <verse number="17" style="v" />And when the cloud was taken up from the tabernacle, then after that the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> journeyed: and in the place where the cloud abode, there the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> pitched their tents.</para>
  <para style="p">
    <verse number="18" style="v" />At the commandment of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> journeyed, and at the commandment of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> they pitched: as long as the cloud abode upon the tabernacle they rested in their tents.</para>
  <para style="p">
    <verse number="19" style="v" />And when the cloud tarried long upon the tabernacle many days, then the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> kept the charge of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and journeyed not.</para>
  <para style="p">
    <verse number="20" style="v" />And <char style="add">[so]</char> it was, when the cloud was a few days upon the tabernacle; according to the commandment of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> they abode in their tents, and according to the commandment of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> they journeyed.</para>
  <para style="p">
    <verse number="21" style="v" />And <char style="add">[so]</char> it was, when the cloud abode from even unto the morning, and <char style="add">[that]</char> the cloud was taken up in the morning, then they journeyed: whether <char style="add">[it was]</char> by day or by night that the cloud was taken up, they journeyed.</para>
  <para style="p">
    <verse number="22" style="v" />Or <char style="add">[whether it were]</char> two days, or a month, or a year, that the cloud tarried upon the tabernacle, remaining thereon, the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> abode in their tents, and journeyed not: but when it was taken up, they journeyed.</para>
  <para style="p">
    <verse number="23" style="v" />At the commandment of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> they rested in the tents, and at the commandment of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> they journeyed: they kept the charge of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, at the commandment of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> by the hand of Moshe <char style="add">[He Who Draws Out Of The Waters]</char>.</para>
  <chapter number="10" style="c" />
  <para style="p">
    <verse number="1" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="2" style="v" />Make you<char style="ord">i</char> two trumpets of silver; of a whole piece shall you<char style="ord">i</char> make them: that you<char style="ord">i</char> may use them for the calling of the assembly, and for the journeying of the camps.</para>
  <para style="p">
    <verse number="3" style="v" />And when they shall blow with them, all the assembly shall assemble themselves to you<char style="ord">i</char> at the door of the tabernacle of the congregation.</para>
  <para style="p">
    <verse number="4" style="v" />And if they blow <char style="add">[but]</char> with one <char style="add">[trumpet]</char>, then the princes, <char style="add">[which are]</char> heads of the thousands of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, shall gather themselves unto you<char style="ord">i</char>.</para>
  <para style="p">
    <verse number="5" style="v" />When you<char style="ord">2f</char> blow an alarm, then the camps that lie on the east parts shall go forward.</para>
  <para style="p">
    <verse number="6" style="v" />When you<char style="ord">2f</char> blow an alarm the second time, then the camps that lie on the south side shall take their journey: they shall blow an alarm for their journeys.</para>
  <para style="p">
    <verse number="7" style="v" />But when the congregation is to be gathered together, you<char style="ord">2f</char> shall blow, but you<char style="ord">2f</char> shall not sound an alarm.</para>
  <para style="p">
    <verse number="8" style="v" />And the sons of Aharon <char style="add">[Bright, Very High]</char>, the priests, shall blow with the trumpets; and they shall be to you for an ordinance forever throughout your generations.</para>
  <para style="p">
    <verse number="9" style="v" />And if you<char style="ord">2f</char> go to war in your land against the enemy that oppresses you, then you<char style="ord">2f</char> shall blow an alarm with the trumpets; and you<char style="ord">2f</char> shall be remembered before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> your God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>, and you<char style="ord">2f</char> shall be saved from your enemies.</para>
  <para style="p">
    <verse number="10" style="v" />Also in the day of your gladness, and in your solemn days, and in the beginnings of your months, you<char style="ord">2f</char> shall blow with the trumpets over your burnt offerings, and over the sacrifices of your peace offerings; that they may be to you for a memorial before your God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>: I <char style="add">[am]</char> the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> your God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>.</para>
  <para style="p">
    <verse number="11" style="v" />And it came to pass on the twentieth <char style="add">[day]</char> of the second month, in the second year, that the cloud was taken up from off the tabernacle of the testimony.</para>
  <para style="p">
    <verse number="12" style="v" />And the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> took their journeys out of the wilderness of Sinai; and the cloud rested in the wilderness of Pa’ran <char style="add">[place of caverns]</char>.</para>
  <para style="p">
    <verse number="13" style="v" />And they first took their journey according to the commandment of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> by the hand of Moshe <char style="add">[He Who Draws Out Of The Waters]</char>.</para>
  <para style="p">
    <verse number="14" style="v" />In the first <char style="add">[place]</char> went the Flag <char style="pn">(banner)</char> of the camp of the children of Y’hudah <char style="add">[Let Him (God) Be Praised]</char> according to their armies: and over his host <char style="add">[was]</char> Nachshon <char style="add">[Enchanter]</char> the son of ‘Amminadav <char style="add">[family of the prince]</char>.</para>
  <para style="p">
    <verse number="15" style="v" />And over the host of the tribe of the children of Yissakhar <char style="add">[There Is Recompense] [was]</char> N’tan’el <char style="add">[God’s Gift]</char> the son of Zuar <char style="add">[Small]</char>.</para>
  <para style="p">
    <verse number="16" style="v" />And over the host of the tribe of the children of Z’vulun <char style="add">[Glorious Dwelling Place] [was]</char> ‘Eli’av <char style="add">[My Father is God]</char> the son of Helon <char style="add">[Strength]</char>.</para>
  <para style="p">
    <verse number="17" style="v" />And the tabernacle was taken down; and the sons of Gershon <char style="add">[Exile]</char> and the sons of M’rari <char style="add">[Bitter]</char> set forward, bearing the tabernacle.</para>
  <para style="p">
    <verse number="18" style="v" />And the Flag <char style="pn">(banner)</char> of the camp of Re’uven <char style="add">[Behold a Son]</char> set forward according to their armies: and over his host <char style="add">[was]</char> Elitzur <char style="add">[My God is a Rock]</char> the son of Sh’de’ur <char style="add">[Almighty’s Light]</char>.</para>
  <para style="p">
    <verse number="19" style="v" />And over the host of the tribe of the children of Shim’on <char style="add">[he who hears] [was]</char> Shlumi’el <char style="add">[Friend of God]</char> the son of Tzuri-shaddai <char style="add">[My Rock is the Almighty]</char>.</para>
  <para style="p">
    <verse number="20" style="v" />And over the host of the tribe of the children of Gad <char style="add">[Good Fortune with Troublesome Effort] [was]</char> Elyasaf <char style="add">[My God has Added]</char> the son of De’u’el <char style="add">[They Know God]</char>.</para>
  <para style="p">
    <verse number="21" style="v" />And the K’hati set forward, bearing the sanctuary: and <char style="add">[the other]</char> did set up the tabernacle against they came.</para>
  <para style="p">
    <verse number="22" style="v" />And the Flag <char style="pn">(banner)</char> of the camp of the children of Efrayim <char style="add">[Doubly Fruitful]</char> set forward according to their armies: and over his host <char style="add">[was]</char> Elishama <char style="add">[My God has Heard]</char> the son of Ammihud <char style="add">[People of Magesty]</char>.</para>
  <para style="p">
    <verse number="23" style="v" />And over the host of the tribe of the children of M’nasheh <char style="add">[Causing to Forget] [was]</char> Gamali’el <char style="add">[Reward of God]</char> the son of Pedahzur <char style="add">[The Rock has Ransomed]</char>.</para>
  <para style="p">
    <verse number="24" style="v" />And over the host of the tribe of the children of Binyamin <char style="add">[Son of the Right Hand/Strength] [was]</char> Avidan <char style="add">[My Father is Judge]</char> the son of Gid’oni <char style="add">[My Hewer]</char>.</para>
  <para style="p">
    <verse number="25" style="v" />And the Flag <char style="pn">(banner)</char> of the camp of the children of Dan <char style="add">[Judge]</char> set forward, <char style="add">[which was]</char> the rearward of all the camps throughout their hosts: and over his host <char style="add">[was]</char> Achi’ezer <char style="add">[My Brother is Help]</char> the son of ‘‘Ammi <char style="add">[my people]</char> -Shaddai <char style="add">[Shaddai is my Kinsman]</char>.</para>
  <para style="p">
    <verse number="26" style="v" />And over the host of the tribe of the children of Asher <char style="add">[Happy] [was]</char> Pag’i’el <char style="add">[God’s Intervention]</char> the son of ‘Okhran <char style="add">[Troubled]</char>.</para>
  <para style="p">
    <verse number="27" style="v" />And over the host of the tribe of the children of Naftali <char style="add">[My Wrestling] [was]</char> Achira <char style="add">[My Brother is Evil]</char> the son of ‘Enan <char style="add">[keen-eyed]</char>.</para>
  <para style="p">
    <verse number="28" style="v" />Thus <char style="add">[were]</char> the journeyings of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> according to their armies, when they set forward.</para>
  <para style="p">
    <verse number="29" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> said unto Hovav <char style="add">[Cherished]</char>, the son of Re’u’el <char style="add">[Friend of God]</char> the Midyani <char style="add">[Strife]</char>, Moshe <char style="add">[He Who Draws Out Of The Waters]</char>’ father in law, We are journeying unto the place of which the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> said, I will give it you: come you<char style="ord">i</char> with us, and we will do you<char style="ord">i</char> good: for the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> has spoken good concerning Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="30" style="v" />And he said unto him, I will not go; but I will depart to my own land, and to my family.</para>
  <para style="p">
    <verse number="31" style="v" />And he said, Leave us not, I pray you<char style="ord">i</char>; forasmuch as you<char style="ord">i</char> know how we are to encamp in the wilderness, and you<char style="ord">i</char> may be to us instead of eyes.</para>
  <para style="p">
    <verse number="32" style="v" />And it shall be, if you<char style="ord">i</char> go with us, yes, it shall be, that what goodness the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> shall do unto us, the same will we do unto you<char style="ord">i</char>.</para>
  <para style="p">
    <verse number="33" style="v" />And they departed from the mount of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> three days’ journey: and the ark of the covenant of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> went before them in the three days’ journey, to search out a resting place for them.</para>
  <para style="p">
    <verse number="34" style="v" />And the cloud of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> <char style="add">[was]</char> upon them by day, when they went out of the camp.</para>
  <para style="p">
    <verse number="35" style="v" />And it came to pass, when the ark set forward, that Moshe <char style="add">[He Who Draws Out Of The Waters]</char> said, Rise up, LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and let you<char style="ord">i</char> enemies be scattered; and let them that hate you<char style="ord">i</char> flee before you<char style="ord">i</char>.</para>
  <para style="p">
    <verse number="36" style="v" />And when it rested, he said, Return, O LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, unto the many thousands of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <chapter number="11" style="c" />
  <para style="p">
    <verse number="1" style="v" />And <char style="add">[when]</char> the people complained, it displeased the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>: and the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> heard <char style="add">[it]</char>; and his anger was kindled; and the fire of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> burnt among them, and consumed <char style="add">[them that were]</char> in the uttermost parts of the camp.</para>
  <para style="p">
    <verse number="2" style="v" />And the people cried unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>; and when Moshe <char style="add">[He Who Draws Out Of The Waters]</char> prayed unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, the fire was quenched.</para>
  <para style="p">
    <verse number="3" style="v" />And he called the name of the place Tav’erah <char style="add">[Burning]</char>: because the fire of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> burnt among them.</para>
  <para style="p">
    <verse number="4" style="v" />And the mixt multitude that <char style="add">[was]</char> among them fell a lusting: and the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> also wept again, and said, Who shall give us flesh to eat?</para>
  <para style="p">
    <verse number="5" style="v" />We remember the fish, which we did eat in Mitzrayim <char style="add">[Egypt - The Narrow Place]</char> freely; the cucumbers, and the melons, and the leeks, and the onions, and the garlic:</para>
  <para style="p">
    <verse number="6" style="v" />But now our soul <char style="add">[is]</char> dried away: <char style="add">[there is]</char> nothing at all, beside this manna, <char style="add">[before]</char> our eyes.</para>
  <para style="p">
    <verse number="7" style="v" />And the manna <char style="add">[was]</char> as coriander seed, and the colour thereof as the colour of bdellium.</para>
  <para style="p">
    <verse number="8" style="v" />
    <char style="add">[And]</char> the people went about, and gathered <char style="add">[it]</char>, and ground <char style="add">[it]</char> in mills, or beat <char style="add">[it]</char> in a mortar, and baked <char style="add">[it]</char> in pans, and made cakes of it: and the taste of it was as the taste of fresh oil.</para>
  <para style="p">
    <verse number="9" style="v" />And when the dew fell upon the camp in the night, the manna fell upon it.</para>
  <para style="p">
    <verse number="10" style="v" />Then Moshe <char style="add">[He Who Draws Out Of The Waters]</char> heard the people weep throughout their families, every man in the door of his tent: and the anger of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> was kindled greatly; Moshe <char style="add">[He Who Draws Out Of The Waters]</char> also was displeased.</para>
  <para style="p">
    <verse number="11" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> said unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, For what reason have you<char style="ord">i</char> afflicted you<char style="ord">i</char> servant? and wherefore have I not found favour in you<char style="ord">i</char> sight, that you<char style="ord">i</char> lays the burden of all this people upon me?</para>
  <para style="p">
    <verse number="12" style="v" />Have I conceived all this people? have I begotten them, that you<char style="ord">i</char> should say unto me, Carry them in you<char style="ord">i</char> bosom, as a nursing father bears the sucking child, unto the land which you<char style="ord">i</char> swore unto their fathers?</para>
  <para style="p">
    <verse number="13" style="v" />Whence should I have flesh to give unto all this people? for they weep unto me, saying, Give us flesh, that we may eat.</para>
  <para style="p">
    <verse number="14" style="v" />I am not able to bear all this people alone, because <char style="add">[it is]</char> too heavy for me.</para>
  <para style="p">
    <verse number="15" style="v" />And if you<char style="ord">i</char> deal thus with me, kill me, I pray you<char style="ord">i</char>, out of hand, if I have found favour in you<char style="ord">i</char> sight; and let me not see my wretchedness.</para>
  <para style="p">
    <verse number="16" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> said unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, Gather unto me seventy men of the elders of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, whom you<char style="ord">i</char> know to be the elders of the people, and officers over them; and bring them unto the tabernacle of the congregation, that they may stand there with you<char style="ord">i</char>.</para>
  <para style="p">
    <verse number="17" style="v" />And I will come down and talk with you<char style="ord">i</char> there: and I will take of the spirit which <char style="add">[is]</char> upon you<char style="ord">i</char>, and will put <char style="add">[it]</char> upon them; and they shall bear the burden of the people with you<char style="ord">i</char>, that you<char style="ord">i</char> bear <char style="add">[it]</char> not yourself alone.</para>
  <para style="p">
    <verse number="18" style="v" />And say you<char style="ord">i</char> unto the people, Sanctify <char style="pn">(make holy; set apart for God’s use)</char> yourselves against tomorrow, and you<char style="ord">2f</char> shall eat flesh: for you<char style="ord">2f</char> have wept in the ears of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, saying, Who shall give us flesh to eat? for <char style="add">[it was]</char> well with us in Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>: therefore the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> will give you flesh, and you<char style="ord">2f</char> shall eat.</para>
  <para style="p">
    <verse number="19" style="v" />You<char style="ord">2f</char> shall not eat one day, nor two days, nor five days, neither ten days, nor twenty days;</para>
  <para style="p">
    <verse number="20" style="v" />
    <char style="add">[But]</char> even a whole month, until it come out at your nostrils, and it be loathsome unto you: because that you<char style="ord">2f</char> have despised the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> which <char style="add">[is]</char> among you, and have wept before him, saying, Why came we forth out of Mitzrayim [Egypt - The Narrow Place]?</para>
  <para style="p">
    <verse number="21" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> said, The people, among whom I <char style="add">[am]</char>, <char style="add">[are]</char> six hundred thousand footmen; and you<char style="ord">i</char> have said, I will give them flesh, that they may eat a whole month.</para>
  <para style="p">
    <verse number="22" style="v" />Shall the flocks and the herds be slain for them, to suffice them? or shall all the fish of the sea be gathered together for them, to suffice them?</para>
  <para style="p">
    <verse number="23" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> said unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, Is the LORD-Yehōvah’s <char style="add">[Messiah Pre-Incarnate]</char> hand waxed short? you<char style="ord">i</char> shall see now whether my word shall come to pass unto you<char style="ord">i</char> or not.</para>
  <para style="p">
    <verse number="24" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> went out, and told the people the words of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and gathered the seventy men of the elders of the people, and set them round about the tabernacle.</para>
  <para style="p">
    <verse number="25" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> came down in a cloud, and spoke unto him, and took of the spirit that <char style="add">[was]</char> upon him, and gave <char style="add">[it]</char> unto the seventy elders: and it came to pass, <char style="add">[that]</char>, when the spirit rested upon them, they prophesied, and did not cease.</para>
  <para style="p">
    <verse number="26" style="v" />But there remained two <char style="add">[of the]</char> men in the camp, the name of the one <char style="add">[was]</char> Eldad <char style="add">[God has Loved]</char>, and the name of the other Medad <char style="add">[Love]</char>: and the spirit rested upon them; and they <char style="add">[were]</char> of them that were written, but went not out unto the tabernacle: and they prophesied in the camp.</para>
  <para style="p">
    <verse number="27" style="v" />And there ran a young man, and told Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, and said, Eldad <char style="add">[God has Loved]</char> and Medad <char style="add">[Love]</char> do prophesy in the camp.</para>
  <para style="p">
    <verse number="28" style="v" />And Y’hoshua <char style="add">[Yehovah is Salvation]</char> the son of Nun <char style="add">[Posterity]</char>, the servant of Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, <char style="add">[one]</char> of his young men, answered and said, My lord Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, forbid them.</para>
  <para style="p">
    <verse number="29" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> said unto him, Envy you<char style="ord">i</char> for my sake? would God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> that all the LORD-Yehōvah’s <char style="add">[Messiah Pre-Incarnate]</char> people were prophets, <char style="add">[and]</char> that the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> would put his spirit upon them!</para>
  <para style="p">
    <verse number="30" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> got him into the camp, he and the elders of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="31" style="v" />And there went forth a wind from the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and brought quails from the sea, and let <char style="add">[them]</char> fall by the camp, as it were a day’s journey on this side, and as it were a day’s journey on the other side, round about the camp, and as it were two cubits <char style="add">[high]</char> upon the face of the earth.</para>
  <para style="p">
    <verse number="32" style="v" />And the people stood up all that day, and all <char style="add">[that]</char> night, and all the next day, and they gathered the quails: he that gathered least gathered ten homers: and they spread <char style="add">[them]</char> all abroad for themselves round about the camp.</para>
  <para style="p">
    <verse number="33" style="v" />And while the flesh <char style="add">[was]</char> yet between their teeth, before it was chewed, the wrath of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> was kindled against the people, and the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> struck the people with a very great plague.</para>
  <para style="p">
    <verse number="34" style="v" />And he called the name of that place Kivrot-HaTa’avah <char style="add">[Graves of Lust]</char>: because there they buried the people that lusted.</para>
  <para style="p">
    <verse number="35" style="v" />
    <char style="add">[And]</char> the people journeyed from Kivrot-HaTa’avah <char style="add">[Graves of Lust]</char> unto Hatzerot <char style="add">[A Place in the Wilderness]</char>; and abode at Hatzerot <char style="add">[A Place in the Wilderness]</char>.</para>
  <chapter number="12" style="c" />
  <para style="p">
    <verse number="1" style="v" />And Miryam <char style="add">[rebellion]</char> and Aharon <char style="add">[Bright, Very High]</char> spoke against Moshe <char style="add">[He Who Draws Out Of The Waters]</char> because of the Cushi <char style="pn">(Ethiopian)</char> woman whom he had married: for he had married an Cushi <char style="pn">(Ethiopian)</char> woman.</para>
  <para style="p">
    <verse number="2" style="v" />And they said, Has the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> indeed spoken only by Moshe <char style="add">[He Who Draws Out Of The Waters]</char>? has he not spoken also by us? And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> heard <char style="add">[it]</char>.</para>
  <para style="p">
    <verse number="3" style="v" />
    <char style="pn">(Now the man Moshe [He Who Draws Out Of The Waters] [was] very meek, above all the men which [were] upon the face of the earth.)</char></para>
  <para style="p">
    <verse number="4" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke suddenly unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, and unto Aharon <char style="add">[Bright, Very High]</char>, and unto Miryam <char style="add">[rebellion]</char>, Come out you<char style="ord">2f</char> three unto the tabernacle of the congregation. And they three came out.</para>
  <para style="p">
    <verse number="5" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> came down in the pillar of the cloud, and stood <char style="add">[in]</char> the door of the tabernacle, and called Aharon <char style="add">[Bright, Very High]</char> and Miryam <char style="add">[rebellion]</char>: and they both came forth.</para>
  <para style="p">
    <verse number="6" style="v" />And he said, Hear now my words: If there be a prophet among you, <char style="add">[I]</char> the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> will make myself known unto him in a vision, <char style="add">[and]</char> will speak unto him in a dream.</para>
  <para style="p">
    <verse number="7" style="v" />My servant Moshe <char style="add">[He Who Draws Out Of The Waters] [is]</char> not so, who <char style="add">[is]</char> faithful in all my house.</para>
  <para style="p">
    <verse number="8" style="v" />With him will I speak mouth to mouth, even apparently, and not in dark speeches; and the similitude of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> shall he behold: wherefore then were you<char style="ord">2f</char> not afraid to speak against my servant Moshe <char style="add">[He Who Draws Out Of The Waters]</char>?</para>
  <para style="p">
    <verse number="9" style="v" />And the anger of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> was kindled against them; and he departed.</para>
  <para style="p">
    <verse number="10" style="v" />And the cloud departed from off the tabernacle; and, behold, Miryam <char style="add">[rebellion] [became]</char> leprous, <char style="add">[white]</char> as snow: and Aharon <char style="add">[Bright, Very High]</char> looked upon Miryam <char style="add">[rebellion]</char>, and, behold, <char style="add">[she was]</char> leprous.</para>
  <para style="p">
    <verse number="11" style="v" />And Aharon <char style="add">[Bright, Very High]</char> said unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, Alas, my lord, I beseech <char style="pn">(to call upon; appeal; beg)</char> you<char style="ord">i</char>, lay not the sin upon us, wherein we have done foolishly, and wherein we have sinned.</para>
  <para style="p">
    <verse number="12" style="v" />Let her not be as one dead, of whom the flesh is half consumed when he comes out of his mother’s womb.</para>
  <para style="p">
    <verse number="13" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> cried unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, saying, Heal her now, O God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>, I beseech <char style="pn">(to call upon; appeal; beg)</char> you<char style="ord">i</char>.</para>
  <para style="p">
    <verse number="14" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> said unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, If her father had but spit in her face, should she not be ashamed seven days? let her be shut out from the camp seven days, and after that let her be received in <char style="add">[again]</char>.</para>
  <para style="p">
    <verse number="15" style="v" />And Miryam <char style="add">[rebellion]</char> was shut out from the camp seven days: and the people journeyed not till Miryam <char style="add">[rebellion]</char> was brought in <char style="add">[again]</char>.</para>
  <para style="p">
    <verse number="16" style="v" />And afterward the people removed from Hatzerot <char style="add">[A Place in the Wilderness]</char>, and pitched in the wilderness of Pa’ran <char style="add">[place of caverns]</char>.</para>
  <chapter number="13" style="c" />
  <para style="p">
    <verse number="1" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="2" style="v" />Send you<char style="ord">i</char> men, that they may search the land of Kena’an <char style="add">[Merchant]</char>, which I give unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>: of every tribe of their fathers shall you<char style="ord">2f</char> send a man, everyone a ruler among them.</para>
  <para style="p">
    <verse number="3" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> by the commandment of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> sent them from the wilderness of Pa’ran <char style="add">[place of caverns]</char>: all those men <char style="add">[were]</char> heads of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="4" style="v" />And these <char style="add">[were]</char> their names: of the tribe of Re’uven <char style="add">[Behold a Son]</char>, Shamua <char style="add">[Renowned]</char> the son of Zakur <char style="add">[Mindful]</char>.</para>
  <para style="p">
    <verse number="5" style="v" />Of the tribe of Shim’on <char style="add">[he who hears]</char>, Shafat <char style="add">[He Has Judged]</char> the son of Hori <char style="add">[Cave Dweller]</char>.</para>
  <para style="p">
    <verse number="6" style="v" />Of the tribe of Y’hudah <char style="add">[Let Him (God) Be Praised]</char>, Kalev <char style="add">[Dog]</char> the son of Y’funeh <char style="add">[He Will Face]</char>.</para>
  <para style="p">
    <verse number="7" style="v" />Of the tribe of Yissakhar <char style="add">[There Is Recompense]</char>, Yig’al <char style="add">[He Redeems]</char> the son of Yosef <char style="add">[(God) He Shall Add]</char>.</para>
  <para style="p">
    <verse number="8" style="v" />Of the tribe of Efrayim <char style="add">[Doubly Fruitful]</char>, Hoshea <char style="add">[salvation]</char> the son of Nun <char style="add">[Posterity]</char>.</para>
  <para style="p">
    <verse number="9" style="v" />Of the tribe of Binyamin <char style="add">[Son of the Right Hand/Strength]</char>, Palti <char style="add">[Escape]</char> the son of Rafu <char style="add">[Healed]</char>.</para>
  <para style="p">
    <verse number="10" style="v" />Of the tribe of Z’vulun <char style="add">[Glorious Dwelling Place]</char>, Gadi <char style="add">[my fortune]</char>’el <char style="add">[God is my Fortune]</char> the son of Sodi <char style="add">[Acquaintance]</char>.</para>
  <para style="p">
    <verse number="11" style="v" />Of the tribe of Yosef <char style="add">[(God) He Shall Add]</char>, <char style="add">[namely]</char>, of the tribe of M’nasheh <char style="add">[Causing to Forget]</char>, Gadi <char style="add">[my fortune] [My Fortune]</char> the son of Susi <char style="add">[My Horse]</char>.</para>
  <para style="p">
    <verse number="12" style="v" />Of the tribe of Dan <char style="add">[Judge]</char>, ‘Ammi’el <char style="add">[my kinsman is God]</char> the son of G’malli <char style="add">[Camel Driver]</char>.</para>
  <para style="p">
    <verse number="13" style="v" />Of the tribe of Asher <char style="add">[Happy]</char>, S’tur <char style="add">[Hidden]</char> the son of Mikha’el <char style="add">[Who is Like God?]</char>.</para>
  <para style="p">
    <verse number="14" style="v" />Of the tribe of Naftali <char style="add">[My Wrestling]</char>, Nachbi <char style="add">[Hidden]</char> the son of Vosi <char style="add">[Rich]</char>.</para>
  <para style="p">
    <verse number="15" style="v" />Of the tribe of Gad <char style="add">[Good Fortune with Troublesome Effort]</char>, Ge’u’el <char style="add">[Majesty of God]</char> the son of Makhi <char style="add">[Decrease]</char>.</para>
  <para style="p">
    <verse number="16" style="v" />These <char style="add">[are]</char> the names of the men which Moshe <char style="add">[He Who Draws Out Of The Waters]</char> sent to spy out the land. And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> called Hoshea <char style="add">[salvation]</char> the son of Nun <char style="add">[Posterity]</char> Y’hoshua <char style="add">[Yehovah is Salvation] [Jehovah is Salvation]</char>.</para>
  <para style="p">
    <verse number="17" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> sent them to spy out the land of Kena’an <char style="add">[Merchant]</char>, and said unto them, Get you up this <char style="add">[way]</char> southward, and go up into the mountain:</para>
  <para style="p">
    <verse number="18" style="v" />And see the land, what it <char style="add">[is]</char>; and the people that dwell in it, whether they <char style="add">[be]</char> strong or weak, few or many;</para>
  <para style="p">
    <verse number="19" style="v" />And what the land <char style="add">[is]</char> that they dwell in, whether it <char style="add">[be]</char> good or bad; and what cities <char style="add">[they be]</char> that they dwell in, whether in tents, or in strong holds;</para>
  <para style="p">
    <verse number="20" style="v" />And what the land <char style="add">[is]</char>, whether it <char style="add">[be]</char> fat or lean, whether there be wood in it, or not. And be you<char style="ord">2f</char> of good courage, and bring of the fruit of the land. Now the time <char style="add">[was]</char> the time of the firstripe grapes.</para>
  <para style="p">
    <verse number="21" style="v" />So they went up, and searched the land from the Wilderness of Tzin <char style="add">[Flat]</char> unto Rechov <char style="add">[Broad Place]</char>, as men come to Hamat <char style="add">[Fortress]</char>.</para>
  <para style="p">
    <verse number="22" style="v" />And they ascended by the south, and came unto Hevron <char style="add">[Seat of Association]</char>; where Achiman <char style="add">[My Brother is a Gift]</char>, Sheshai <char style="add">[Noble]</char>, and Talmai <char style="add">[Plowman]</char>, the children of Anak <char style="add">[Neck]</char>, <char style="add">[were]</char>. <char style="pn">(Now Hevron [Seat of Association] was built seven years before Tzo’an [Place of Departure] in Mitzrayim [Egypt - The Narrow Place].)</char></para>
  <para style="p">
    <verse number="23" style="v" />And they came unto the brook of Eshkol <char style="add">[Cluster]</char>, and cut down from there a branch with one cluster of grapes, and they bore it between two upon a staff; and <char style="add">[they brought]</char> of the pomegranates, and of the figs.</para>
  <para style="p">
    <verse number="24" style="v" />The place was called the brook Eshkol <char style="add">[Cluster]</char>, because of the cluster of grapes which the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> cut down from there.</para>
  <para style="p">
    <verse number="25" style="v" />And they returned from searching of the land after forty days.</para>
  <para style="p">
    <verse number="26" style="v" />And they went and came to Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, and to Aharon <char style="add">[Bright, Very High]</char>, and to all the congregation of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, unto the wilderness of Pa’ran <char style="add">[place of caverns]</char>, to Kadesh <char style="add">[Holy]</char>; and brought back word unto them, and unto all the congregation, and showed them the fruit of the land.</para>
  <para style="p">
    <verse number="27" style="v" />And they told him, and said, We came unto the land to which you<char style="ord">i</char> sent us, and surely it flows with milk and honey; and this <char style="add">[is]</char> the fruit of it.</para>
  <para style="p">
    <verse number="28" style="v" />Nevertheless the people <char style="add">[be]</char> strong that dwell in the land, and the cities <char style="add">[are]</char> walled, <char style="add">[and]</char> very great: and moreover we saw the children of Anak <char style="add">[Neck]</char> there.</para>
  <para style="p">
    <verse number="29" style="v" />The ‘Amalekim <char style="add">[Dwellers in a Valley]</char> dwell in the land of the south: and the Hitti <char style="add">[Terrorists]</char>, and the Y’vusi <char style="add">[Threshers, Trampled Under Foot]</char>, and the Emori <char style="add">[Highlanders]</char>, dwell in the mountains: and the Kena’ani <char style="add">[Merchant]</char> dwell by the sea, and by the coast of Yarden <char style="add">[Descender]</char>.</para>
  <para style="p">
    <verse number="30" style="v" />And Kalev <char style="add">[Dog]</char> stilled the people before Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, and said, Let us go up at once, and possess it; for we are well able to overcome it.</para>
  <para style="p">
    <verse number="31" style="v" />But the men that went up with him said, We be not able to go up against the people; for they <char style="add">[are]</char> stronger than we.</para>
  <para style="p">
    <verse number="32" style="v" />And they brought up an evil report of the land which they had searched unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, saying, The land, through which we have gone to search it, <char style="add">[is]</char> a land that eats up the inhabitants thereof; and all the people that we saw in it <char style="add">[are]</char> men of a great stature.</para>
  <para style="p">
    <verse number="33" style="v" />And there we saw the giants, the sons of Anak <char style="add">[Neck]</char>, <char style="add">[which come]</char> of the giants: and we were in our own sight as grasshoppers, and so we were in their sight.</para>
  <chapter number="14" style="c" />
  <para style="p">
    <verse number="1" style="v" />And all the congregation lifted up their voice, and cried; and the people wept that night.</para>
  <para style="p">
    <verse number="2" style="v" />And all the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> murmured against Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and against Aharon <char style="add">[Bright, Very High]</char>: and the whole congregation said unto them, Would God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> that we had died in the land of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>! or would God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> we had died in this wilderness!</para>
  <para style="p">
    <verse number="3" style="v" />And wherefore has the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> brought us unto this land, to fall by the sword, that our wives and our children should be a prey? were it not better for us to return into Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>?</para>
  <para style="p">
    <verse number="4" style="v" />And they said one to another, Let us make a captain, and let us return into Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>.</para>
  <para style="p">
    <verse number="5" style="v" />Then Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and Aharon <char style="add">[Bright, Very High]</char> fell on their faces before all the assembly of the congregation of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="6" style="v" />And Y’hoshua <char style="add">[Yehovah is Salvation]</char> the son of Nun <char style="add">[Posterity]</char>, and Kalev <char style="add">[Dog]</char> the son of Y’funeh <char style="add">[He Will Face]</char>, <char style="add">[which were]</char> of them that searched the land, rent their clothes:</para>
  <para style="p">
    <verse number="7" style="v" />And they spoke unto all the company of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, saying, The land, which we passed through to search it, <char style="add">[is]</char> an exceeding good land.</para>
  <para style="p">
    <verse number="8" style="v" />If the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> delight in us, then he will bring us into this land, and give it us; a land which flows with milk and honey.</para>
  <para style="p">
    <verse number="9" style="v" />Only rebel not you<char style="ord">2f</char> against the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, neither fear you<char style="ord">2f</char> the people of the land; for they <char style="add">[are]</char> bread for us: their defense is departed from them, and the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> <char style="add">[is]</char> with us: fear them not.</para>
  <para style="p">
    <verse number="10" style="v" />But all the congregation bade stone them with stones. And the glory of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> appeared in the tabernacle of the congregation before all the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="11" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> said unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, How long will this people provoke me? and how long will it be before they believe me, for all the signs which I have showed among them?</para>
  <para style="p">
    <verse number="12" style="v" />I will strike them with the pestilence, and disinherit them, and will make of you<char style="ord">i</char> a greater nation and mightier than they.</para>
  <para style="p">
    <verse number="13" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> said unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, Then the Mitzri shall hear <char style="add">[it]</char>, <char style="pn">(for you<char style="ord">i</char> brought up this people in you<char style="ord">i</char> might from among them;)</char></para>
  <para style="p">
    <verse number="14" style="v" />And they will tell <char style="add">[it]</char> to the inhabitants of this land: <char style="add">[for]</char> they have heard that you<char style="ord">i</char> LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> <char style="add">[are]</char> among this people, that you<char style="ord">i</char> LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> are seen face to face, and <char style="add">[that]</char> your<char style="ord">i</char> cloud stands over them, and <char style="add">[that]</char> you<char style="ord">i</char> go before them, by day time in a pillar of a cloud, and in a pillar of fire by night.</para>
  <para style="p">
    <verse number="15" style="v" />Now <char style="add">[if]</char> you<char style="ord">i</char> shall kill <char style="add">[all]</char> this people as one man, then the nations which have heard the fame of you<char style="ord">i</char> will speak, saying,</para>
  <para style="p">
    <verse number="16" style="v" />Because the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> was not able to bring this people into the land which he swore unto them, therefore he has slain them in the wilderness.</para>
  <para style="p">
    <verse number="17" style="v" />And now, I beseech <char style="pn">(to call upon; appeal; beg)</char> you<char style="ord">i</char>, let the power of my Lord be great, according as you<char style="ord">i</char> have spoken, saying,</para>
  <para style="p">
    <verse number="18" style="v" />The LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> <char style="add">[is]</char> longsuffering, and of great mercy, forgiving iniquity and transgression, and by no means clearing <char style="add">[the guilty]</char>, visiting the iniquity of the fathers upon the children unto the third and fourth <char style="add">[generation]</char>.</para>
  <para style="p">
    <verse number="19" style="v" />Pardon, I beseech <char style="pn">(to call upon; appeal; beg)</char> you<char style="ord">i</char>, the iniquity of this people according unto the greatness of you<char style="ord">i</char> mercy, and as you<char style="ord">i</char> have forgiven this people, from Mitzrayim <char style="add">[Egypt - The Narrow Place]</char> even until now.</para>
  <para style="p">
    <verse number="20" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> said, I have pardoned according to you<char style="ord">i</char> word:</para>
  <para style="p">
    <verse number="21" style="v" />But <char style="add">[as]</char> truly <char style="add">[as]</char> I live, all the earth shall be filled with the glory of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="22" style="v" />Because all those men which have seen my glory, and my miracles, which I did in Mitzrayim <char style="add">[Egypt - The Narrow Place]</char> and in the wilderness, and have tempted me now these ten times, and have not listened to my voice;</para>
  <para style="p">
    <verse number="23" style="v" />Surely they shall not see the land which I swore unto their fathers, neither shall any of them that provoked me see it:</para>
  <para style="p">
    <verse number="24" style="v" />But my servant Kalev <char style="add">[Dog]</char>, because he had another spirit with him, and has followed me fully, him will I bring into the land whereinto he went; and his seed shall possess it.</para>
  <para style="p">
    <verse number="25" style="v" />
    <char style="pn">(Now the ‘Amalekim [Dwellers in a Valley] and the Kena’ani [Merchant] dwelt in the valley.)</char> Tomorrow turn you, and get you into the wilderness by the way of the Red sea.</para>
  <para style="p">
    <verse number="26" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and unto Aharon <char style="add">[Bright, Very High]</char>, saying,</para>
  <para style="p">
    <verse number="27" style="v" />How long <char style="add">[shall I bear with]</char> this evil congregation, which murmur against me? I have heard the murmurings of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, which they murmur against me.</para>
  <para style="p">
    <verse number="28" style="v" />Say unto them, <char style="add">[As truly as]</char> I live, says the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, as you<char style="ord">2f</char> have spoken in my ears, so will I do to you:</para>
  <para style="p">
    <verse number="29" style="v" />Your carcasses shall fall in this wilderness; and all that were numbered of you, according to your whole number, from twenty years old and upward, which have murmured against me,</para>
  <para style="p">
    <verse number="30" style="v" />Doubtless you<char style="ord">2f</char> shall not come into the land, <char style="add">[concerning]</char> which I swore to make you dwell in it, save Kalev <char style="add">[Dog]</char> the son of Y’funeh <char style="add">[He Will Face]</char>, and Y’hoshua <char style="add">[Yehovah is Salvation]</char> the son of Nun <char style="add">[Posterity]</char>.</para>
  <para style="p">
    <verse number="31" style="v" />But your little ones, which you<char style="ord">2f</char> said should be a prey, them will I bring in, and they shall know the land which you<char style="ord">2f</char> have despised.</para>
  <para style="p">
    <verse number="32" style="v" />But <char style="add">[as for]</char> you, your carcasses, they shall fall in this wilderness.</para>
  <para style="p">
    <verse number="33" style="v" />And your children shall wander in the wilderness forty years, and bear your cult prostitution, until your carcasses be wasted in the wilderness.</para>
  <para style="p">
    <verse number="34" style="v" />After the number of the days in which you<char style="ord">2f</char> searched the land, <char style="add">[even]</char> forty days, each day for a year, shall you<char style="ord">2f</char> bear your iniquities, <char style="add">[even]</char> forty years, and you<char style="ord">2f</char> shall know my breach <char style="pn">(breaking forth; a break; opening, inlet)</char> of promise.</para>
  <para style="p">
    <verse number="35" style="v" />I the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> have said, I will surely do it unto all this evil congregation, that are gathered together against me: in this wilderness they shall be consumed, and there they shall die.</para>
  <para style="p">
    <verse number="36" style="v" />And the men, which Moshe <char style="add">[He Who Draws Out Of The Waters]</char> sent to search the land, who returned, and made all the congregation to murmur against him, by bringing up a slander upon the land,</para>
  <para style="p">
    <verse number="37" style="v" />Even those men that did bring up the evil report upon the land, died by the plague before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="38" style="v" />But Y’hoshua <char style="add">[Yehovah is Salvation]</char> the son of Nun <char style="add">[Posterity]</char>, and Kalev <char style="add">[Dog]</char> the son of Y’funeh <char style="add">[He Will Face]</char>, <char style="add">[which were]</char> of the men that went to search the land, lived <char style="add">[still]</char>.</para>
  <para style="p">
    <verse number="39" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> told these sayings unto all the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>: and the people mourned greatly.</para>
  <para style="p">
    <verse number="40" style="v" />And they rose up early in the morning, and got them up into the top of the mountain, saying, Lo, we <char style="add">[be here]</char>, and will go up unto the place which the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> has promised: for we have sinned.</para>
  <para style="p">
    <verse number="41" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> said, For what reason now do you<char style="ord">2f</char> transgress the commandment of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>? but it shall not prosper.</para>
  <para style="p">
    <verse number="42" style="v" />Go not up, for the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> <char style="add">[is]</char> not among you; that you<char style="ord">2f</char> be not smitten before your enemies.</para>
  <para style="p">
    <verse number="43" style="v" />For the ‘Amalekim <char style="add">[Dwellers in a Valley]</char> and the Kena’ani <char style="add">[Merchant] [are]</char> there before you, and you<char style="ord">2f</char> shall fall by the sword: because you<char style="ord">2f</char> are turned away from the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, therefore the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> will not be with you.</para>
  <para style="p">
    <verse number="44" style="v" />But they presumed to go up unto the hill top: nevertheless the ark of the covenant of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, departed not out of the camp.</para>
  <para style="p">
    <verse number="45" style="v" />Then the ‘Amalekim <char style="add">[Dwellers in a Valley]</char> came down, and the Kena’anim <char style="add">[Merchants]</char> which dwelt in that hill, and struck them, and scattered <char style="pn">(defeated in battle)</char> them, <char style="add">[even]</char> unto Hormah <char style="add">[Asylum]</char>.</para>
  <chapter number="15" style="c" />
  <para style="p">
    <verse number="1" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="2" style="v" />Speak unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, and say unto them, When you<char style="ord">2f</char> be come into the land of your habitations, which I give unto you,</para>
  <para style="p">
    <verse number="3" style="v" />And will make an offering by fire unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, a burnt offering, or a sacrifice in performing a vow, or in a freewill offering, or in your solemn feasts, to make a soothing aroma unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, of the herd, or of the flock:</para>
  <para style="p">
    <verse number="4" style="v" />Then shall he that offers his offering unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> bring a meat offering of a tenth deal of flour mingled with the fourth <char style="add">[part]</char> of an hin <char style="add">[a quart]</char> of oil.</para>
  <para style="p">
    <verse number="5" style="v" />And the fourth <char style="add">[part]</char> of an hin <char style="add">[a quart]</char> of wine for a drink offering shall you<char style="ord">i</char> prepare with the burnt offering or sacrifice, for one lamb.</para>
  <para style="p">
    <verse number="6" style="v" />Or for a ram, you<char style="ord">i</char> shall prepare <char style="add">[for]</char> a meat offering two tenth deals of flour mingled with the third <char style="add">[part]</char> of an hin <char style="add">[a quart]</char> of oil.</para>
  <para style="p">
    <verse number="7" style="v" />And for a drink offering you<char style="ord">i</char> shall offer the third <char style="add">[part]</char> of an hin <char style="add">[a quart]</char> of wine, <char style="add">[for]</char> a soothing aroma unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="8" style="v" />And when you<char style="ord">i</char> prepare a bullock <char style="add">[for]</char> a burnt offering, or <char style="add">[for]</char> a sacrifice in performing a vow, or peace offerings unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>:</para>
  <para style="p">
    <verse number="9" style="v" />Then shall he bring with a bullock a meat offering of three tenth deals of flour mingled with half an hin <char style="add">[a quart]</char> of oil.</para>
  <para style="p">
    <verse number="10" style="v" />And you<char style="ord">i</char> shall bring for a drink offering half an hin <char style="add">[a quart]</char> of wine, <char style="add">[for]</char> an offering made by fire, of a soothing aroma unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="11" style="v" />Thus shall it be done for one bullock, or for one ram, or for a lamb, or a kid.</para>
  <para style="p">
    <verse number="12" style="v" />According to the number that you<char style="ord">2f</char> shall prepare, so shall you<char style="ord">2f</char> do to every one according to their number.</para>
  <para style="p">
    <verse number="13" style="v" />All that are born of the country shall do these things after this manner, in offering an offering made by fire, of a soothing aroma unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="14" style="v" />And if a stranger sojourn with you, or whosoever <char style="add">[be]</char> among you in your generations, and will offer an offering made by fire, of a soothing aroma unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>; as you<char style="ord">2f</char> do, so he shall do.</para>
  <para style="p">
    <verse number="15" style="v" />One ordinance <char style="add">[shall be both]</char> for you of the congregation, and also for the stranger that sojournes <char style="add">[with you]</char>, an ordinance forever in your generations: as you<char style="ord">2f</char> <char style="add">[are]</char>, so shall the stranger be before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="16" style="v" />One law and one manner shall be for you, and for the stranger that sojournes with you.</para>
  <para style="p">
    <verse number="17" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="18" style="v" />Speak unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, and say unto them, When you<char style="ord">2f</char> come into the land to which I bring you,</para>
  <para style="p">
    <verse number="19" style="v" />Then it shall be, that, when you<char style="ord">2f</char> eat of the bread of the land, you<char style="ord">2f</char> shall offer up an heave offering unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="20" style="v" />You<char style="ord">2f</char> shall offer up a cake of the first of your dough <char style="add">[for]</char> an heave offering: as <char style="add">[you<char style="ord">2f</char> do]</char> the heave offering of the threshing floor, so shall you<char style="ord">2f</char> heave it.</para>
  <para style="p">
    <verse number="21" style="v" />Of the first of your dough you<char style="ord">2f</char> shall give unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> an heave offering in your generations.</para>
  <para style="p">
    <verse number="22" style="v" />And if you<char style="ord">2f</char> have erred, and not observed all these commandments, which the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> has spoken unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>,</para>
  <para style="p">
    <verse number="23" style="v" />
    <char style="add">[Even]</char> all that the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> has commanded you by the hand of Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, from the day that the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded <char style="add">[Moshe [He Who Draws Out Of The Waters]]</char>, and henceforward among your generations;</para>
  <para style="p">
    <verse number="24" style="v" />Then it shall be, if <char style="add">[ought]</char> be committed by ignorance without the knowledge of the congregation, that all the congregation shall offer one young bullock for a burnt offering, for a soothing aroma unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, with his meat offering, and his drink offering, according to the manner, and one kid of the goats for a sin offering.</para>
  <para style="p">
    <verse number="25" style="v" />And the priest shall make an atonement for all the congregation of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, and it shall be forgiven them; for it <char style="add">[is]</char> ignorance: and they shall bring their offering, a sacrifice made by fire unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and their sin offering before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, for their ignorance:</para>
  <para style="p">
    <verse number="26" style="v" />And it shall be forgiven all the congregation of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, and the stranger that sojournes among them; seeing all the people <char style="add">[were]</char> in ignorance.</para>
  <para style="p">
    <verse number="27" style="v" />And if any soul sin through ignorance, then he shall bring a she goat of the first year for a sin offering.</para>
  <para style="p">
    <verse number="28" style="v" />And the priest shall make an atonement for the soul that sins ignorantly, when he sins by ignorance before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, to make an atonement for him; and it shall be forgiven him.</para>
  <para style="p">
    <verse number="29" style="v" />You<char style="ord">2f</char> shall have one law for him that sins through ignorance, <char style="add">[both for]</char> him that is born among the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, and for the stranger that sojournes among them.</para>
  <para style="p">
    <verse number="30" style="v" />But the soul that does <char style="add">[ought]</char> presumptuously, <char style="add">[whether he be]</char> born in the land, or a stranger, the same reproaches the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>; and that soul shall be cut off from among his people.</para>
  <para style="p">
    <verse number="31" style="v" />Because he has despised the word of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and has broken his commandment, that soul shall utterly be cut off; his iniquity <char style="add">[shall be]</char> upon him.</para>
  <para style="p">
    <verse number="32" style="v" />And while the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> were in the wilderness, they found a man that gathered sticks upon the Shabbat <char style="add">[Rest]</char> day.</para>
  <para style="p">
    <verse number="33" style="v" />And they that found him gathering sticks brought him unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and Aharon <char style="add">[Bright, Very High]</char>, and unto all the congregation.</para>
  <para style="p">
    <verse number="34" style="v" />And they put him in ward (in custody, with a guard; prison), because it was not declared what should be done to him.</para>
  <para style="p">
    <verse number="35" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> said unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, The man shall be surely put to death: all the congregation shall stone him with stones without the camp.</para>
  <para style="p">
    <verse number="36" style="v" />And all the congregation brought him without the camp, and stoned him with stones, and he died; as the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded Moshe <char style="add">[He Who Draws Out Of The Waters]</char>.</para>
  <para style="p">
    <verse number="37" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="38" style="v" />Speak unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, and bid them that they make them fringes in the borders of their garments throughout their generations, and that they put upon the fringe of the borders a ribbon of blue:</para>
  <para style="p">
    <verse number="39" style="v" />And it shall be unto you for a fringe, that you<char style="ord">2f</char> may look upon it, and remember all the commandments of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and do them; and that you<char style="ord">2f</char> seek not after your own heart and your own eyes, after which you<char style="ord">2f</char> use to go a whoring:</para>
  <para style="p">
    <verse number="40" style="v" />That you<char style="ord">2f</char> may remember, and do all my commandments, and be holy unto your God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>.</para>
  <para style="p">
    <verse number="41" style="v" />I <char style="add">[am]</char> the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> your God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>, which brought you out of the land of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>, to be your God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>: I <char style="add">[am]</char> the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> your God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>.</para>
  <chapter number="16" style="c" />
  <para style="p">
    <verse number="1" style="v" />Now Korakh <char style="add">[Bald]</char>, the son of Yitz’har <char style="add">[Shining Oil]</char>, the son of K’hat <char style="add">[assembly, congregation]</char>, the son of Levi <char style="pn">(Levite)</char> <char style="add">[Adhesion, Joiner]</char>, and Datan <char style="add">[belonging to a fountain]</char> and Aviram <char style="add">[My Father is Exalted]</char>, the sons of ‘Eli’av <char style="add">[My Father is God]</char>, and On, the son of Pelet <char style="add">[Swiftness]</char>, sons of Re’uven <char style="add">[Behold a Son]</char>, took <char style="add">[men]</char>:</para>
  <para style="p">
    <verse number="2" style="v" />And they rose up before Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, with certain of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, two hundred and fifty princes of the assembly, famous in the congregation, men of renown (great reputation; being well-known):</para>
  <para style="p">
    <verse number="3" style="v" />And they gathered themselves together against Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and against Aharon <char style="add">[Bright, Very High]</char>, and said unto them, [You<char style="ord">2f</char> take] too much upon you, seeing all the congregation <char style="add">[are]</char> holy, every one of them, and the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> <char style="add">[is]</char> among them: wherefore then lift you<char style="ord">2f</char> up yourselves above the congregation of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>?</para>
  <para style="p">
    <verse number="4" style="v" />And when Moshe <char style="add">[He Who Draws Out Of The Waters]</char> heard <char style="add">[it]</char>, he fell upon his face:</para>
  <para style="p">
    <verse number="5" style="v" />And he spoke unto Korakh <char style="add">[Bald]</char> and unto all his company, saying, Even tomorrow the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> will show who <char style="add">[are]</char> his, and <char style="add">[who is]</char> holy; and will cause <char style="add">[him]</char> to come near unto him: even <char style="add">[him]</char> whom he has chosen will he cause to come near unto him.</para>
  <para style="p">
    <verse number="6" style="v" />This do; Take you censers, Korakh <char style="add">[Bald]</char>, and all his company;</para>
  <para style="p">
    <verse number="7" style="v" />And put fire in it, and put incense in them before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> tomorrow: and it shall be <char style="add">[that]</char> the man whom the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> does choose, he <char style="add">[shall be]</char> holy: <char style="add">[you<char style="ord">2f</char> take]</char> too much upon you, you<char style="ord">2f</char> sons of Levi <char style="pn">(Levite)</char> <char style="add">[Adhesion, Joiner]</char>.</para>
  <para style="p">
    <verse number="8" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> said unto Korakh <char style="add">[Bald]</char>, Hear, I pray you, you<char style="ord">2f</char> sons of Levi <char style="pn">(Levite)</char> <char style="add">[Adhesion, Joiner]</char>:</para>
  <para style="p">
    <verse number="9" style="v" />
    <char style="add">[Seems it but]</char> a small thing unto you, that the God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> has separated you from the congregation of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, to bring you near to himself to do the service of the tabernacle of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and to stand before the congregation to minister unto them?</para>
  <para style="p">
    <verse number="10" style="v" />And he has brought you<char style="ord">i</char> near <char style="add">[to him]</char>, and all you<char style="ord">i</char> brethren the sons of Levi <char style="pn">(Levite)</char> <char style="add">[Adhesion, Joiner]</char> with you<char style="ord">i</char>: and seek you<char style="ord">2f</char> the priesthood also?</para>
  <para style="p">
    <verse number="11" style="v" />For which cause <char style="add">[both]</char> you<char style="ord">i</char> and all you<char style="ord">i</char> company <char style="add">[are]</char> gathered together against the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>: and what <char style="add">[is]</char> Aharon <char style="add">[Bright, Very High]</char>, that you<char style="ord">2f</char> murmur against him?</para>
  <para style="p">
    <verse number="12" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> sent to call Datan <char style="add">[belonging to a fountain]</char> and Aviram <char style="add">[My Father is Exalted]</char>, the sons of ‘Eli’av <char style="add">[My Father is God]</char>: which said, We will not come up:</para>
  <para style="p">
    <verse number="13" style="v" />
    <char style="add">[Is it]</char> a small thing that you<char style="ord">i</char> have brought us up out of a land that flows with milk and honey, to kill us in the wilderness, except you<char style="ord">i</char> make yourself altogether a prince over us?</para>
  <para style="p">
    <verse number="14" style="v" />Moreover you<char style="ord">i</char> have not brought us into a land that flows with milk and honey, or given us inheritance of fields and vineyards: will you<char style="ord">i</char> put out the eyes of these men? we will not come up.</para>
  <para style="p">
    <verse number="15" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> was very exceedingly angry, and said unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, Respect not you<char style="ord">i</char> their offering: I have not taken one ass from them, neither have I hurt one of them.</para>
  <para style="p">
    <verse number="16" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> said unto Korakh <char style="add">[Bald]</char>, Be you<char style="ord">i</char> and all you<char style="ord">i</char> company before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, you<char style="ord">i</char>, and they, and Aharon <char style="add">[Bright, Very High]</char>, tomorrow:</para>
  <para style="p">
    <verse number="17" style="v" />And take every man his censer, and put incense in them, and bring you<char style="ord">2f</char> before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> every man his censer, two hundred and fifty censers; you<char style="ord">i</char> also, and Aharon <char style="add">[Bright, Very High]</char>, each <char style="add">[of you]</char> his censer.</para>
  <para style="p">
    <verse number="18" style="v" />And they took every man his censer, and put fire in them, and laid incense thereon, and stood in the door of the tabernacle of the congregation with Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and Aharon <char style="add">[Bright, Very High]</char>.</para>
  <para style="p">
    <verse number="19" style="v" />And Korakh <char style="add">[Bald]</char> gathered all the congregation against them unto the door of the tabernacle of the congregation: and the glory of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> appeared unto all the congregation.</para>
  <para style="p">
    <verse number="20" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and unto Aharon <char style="add">[Bright, Very High]</char>, saying,</para>
  <para style="p">
    <verse number="21" style="v" />Separate yourselves from among this congregation, that I may consume them in a moment.</para>
  <para style="p">
    <verse number="22" style="v" />And they fell upon their faces, and said, O God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>, the God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> of the spirits of all flesh, shall one man sin, and will you<char style="ord">i</char> be exceedingly angry with all the congregation?</para>
  <para style="p">
    <verse number="23" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="24" style="v" />Speak unto the congregation, saying, Get you up from about the tabernacle of Korakh <char style="add">[Bald]</char>, Datan <char style="add">[belonging to a fountain]</char>, and Aviram <char style="add">[My Father is Exalted]</char>.</para>
  <para style="p">
    <verse number="25" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> rose up and went unto Datan <char style="add">[belonging to a fountain]</char> and Aviram <char style="add">[My Father is Exalted]</char>; and the elders of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> followed him.</para>
  <para style="p">
    <verse number="26" style="v" />And he spoke unto the congregation, saying, Depart, I pray you, from the tents of these wicked men, and touch nothing of theirs, lest you<char style="ord">2f</char> be consumed in all their sins.</para>
  <para style="p">
    <verse number="27" style="v" />So they got up from the tabernacle of Korakh <char style="add">[Bald]</char>, Datan <char style="add">[belonging to a fountain]</char>, and Aviram <char style="add">[My Father is Exalted]</char>, on every side: and Datan <char style="add">[belonging to a fountain]</char> and Aviram <char style="add">[My Father is Exalted]</char> came out, and stood in the door of their tents, and their wives, and their sons, and their little children.</para>
  <para style="p">
    <verse number="28" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> said, Hereby you<char style="ord">2f</char> shall know that the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> has sent me to do all these works; for <char style="add">[I have]</char> not <char style="add">[done them]</char> of my own mind.</para>
  <para style="p">
    <verse number="29" style="v" />If these men die the common death of all men, or if they be visited after the visitation of all men; <char style="add">[then]</char> the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> has not sent me.</para>
  <para style="p">
    <verse number="30" style="v" />But if the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> make a new thing, and the earth open her mouth, and swallow <char style="pn">(to approve, commend, accept)</char> them up, with all that [appertain (to belong to; to pertain to)] unto them, and they go down quick into the pit; then you<char style="ord">2f</char> shall understand that these men have provoked the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="31" style="v" />And it came to pass, as he had made an end of speaking all these words, that the ground clave asunder that <char style="add">[was]</char> under them:</para>
  <para style="p">
    <verse number="32" style="v" />And the earth opened her mouth, and swallow <char style="pn">(to approve, commend, accept)</char>ed them up, and their houses, and all the men that <char style="add">[appertained]</char> unto Korakh <char style="add">[Bald]</char>, and all <char style="add">[their]</char> goods.</para>
  <para style="p">
    <verse number="33" style="v" />They, and all that <char style="add">[appertained]</char> to them, went down alive into the pit, and the earth closed upon them: and they perished from among the congregation.</para>
  <para style="p">
    <verse number="34" style="v" />And all Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> that <char style="add">[were]</char> round about them fled at the cry of them: for they said, Lest the earth swallow <char style="pn">(to approve, commend, accept)</char> us up <char style="add">[also]</char>.</para>
  <para style="p">
    <verse number="35" style="v" />And there came out a fire from the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and consumed the two hundred and fifty men that offered incense.</para>
  <para style="p">
    <verse number="36" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="37" style="v" />Speak unto El’azar <char style="add">[God has helped]</char> the son of Aharon <char style="add">[Bright, Very High]</char> the priest, that he take up the censers out of the burning, and scatter you<char style="ord">i</char> the fire yonder; for they are consecrated.</para>
  <para style="p">
    <verse number="38" style="v" />The censers of these sinners against their own souls, let them make them broad plates <char style="add">[for]</char> a covering of the altar: for they offered them before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, therefore they are consecrated: and they shall be a sign unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="39" style="v" />And El’azar <char style="add">[God has helped]</char> the priest took the brazen censers, which they that were burnt had offered; and they were made broad <char style="add">[plates for]</char> a covering of the altar:</para>
  <para style="p">
    <verse number="40" style="v" />
    <char style="add">[To be]</char> a memorial unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, that no stranger, which <char style="add">[is]</char> not of the seed of Aharon <char style="add">[Bright, Very High]</char>, come near to offer incense before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>; that he be not as Korakh <char style="add">[Bald]</char>, and as his company: as the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> said to him by the hand of Moshe <char style="add">[He Who Draws Out Of The Waters]</char>.</para>
  <para style="p">
    <verse number="41" style="v" />But on the morrow all the congregation of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> murmured against Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and against Aharon <char style="add">[Bright, Very High]</char>, saying, You<char style="ord">2f</char> have killed the people of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="42" style="v" />And it came to pass, when the congregation was gathered against Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and against Aharon <char style="add">[Bright, Very High]</char>, that they looked toward the tabernacle of the congregation: and, behold, the cloud covered it, and the glory of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> appeared.</para>
  <para style="p">
    <verse number="43" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and Aharon <char style="add">[Bright, Very High]</char> came before the tabernacle of the congregation.</para>
  <para style="p">
    <verse number="44" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="45" style="v" />Get you up from among this congregation, that I may consume them as in a moment. And they fell upon their faces.</para>
  <para style="p">
    <verse number="46" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> said unto Aharon <char style="add">[Bright, Very High]</char>, Take a censer, and put fire in it from off the altar, and put on incense, and go quickly unto the congregation, and make an atonement for them: for there is wrath gone out from the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>; the plague is begun.</para>
  <para style="p">
    <verse number="47" style="v" />And Aharon <char style="add">[Bright, Very High]</char> took as Moshe <char style="add">[He Who Draws Out Of The Waters]</char> commanded, and ran into the midst of the congregation; and, behold, the plague was begun among the people: and he put on incense, and made an atonement for the people.</para>
  <para style="p">
    <verse number="48" style="v" />And he stood between the dead and the living; and the plague was detained <char style="pn">(held)</char>.</para>
  <para style="p">
    <verse number="49" style="v" />Now they that died in the plague were fourteen thousand and seven hundred, beside them that died about the matter of Korakh <char style="add">[Bald]</char>.</para>
  <para style="p">
    <verse number="50" style="v" />And Aharon <char style="add">[Bright, Very High]</char> returned unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char> unto the door of the tabernacle of the congregation: and the plague was detained <char style="pn">(held)</char>.</para>
  <chapter number="17" style="c" />
  <para style="p">
    <verse number="1" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="2" style="v" />Speak unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, and take of every one of them a rod according to the house of <char style="add">[their]</char> fathers, of all their princes according to the house of their fathers twelve rods: write you<char style="ord">i</char> every man’s name upon his rod.</para>
  <para style="p">
    <verse number="3" style="v" />And you<char style="ord">i</char> shall write Aharon <char style="add">[Bright, Very High]</char>’s name upon the rod of Levi <char style="pn">(Levite)</char> <char style="add">[Adhesion, Joiner]</char>: for one rod <char style="add">[shall be]</char> for the head of the house of their fathers.</para>
  <para style="p">
    <verse number="4" style="v" />And you<char style="ord">i</char> shall lay them up in the tabernacle of the congregation before the testimony, where I will meet with you.</para>
  <para style="p">
    <verse number="5" style="v" />And it shall come to pass, <char style="add">[that]</char> the man’s rod, whom I shall choose, shall blossom: and I will make to cease from me the murmurings of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, whereby they murmur against you.</para>
  <para style="p">
    <verse number="6" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> spoke unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, and every one of their princes gave him a rod apiece, for each prince one, according to their fathers’ houses, <char style="add">[even]</char> twelve rods: and the rod of Aharon <char style="add">[Bright, Very High] [was]</char> among their rods.</para>
  <para style="p">
    <verse number="7" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> laid up the rods before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> in the tabernacle of witness.</para>
  <para style="p">
    <verse number="8" style="v" />And it came to pass, that on the morrow Moshe <char style="add">[He Who Draws Out Of The Waters]</char> went into the tabernacle of witness; and, behold, the rod of Aharon <char style="add">[Bright, Very High]</char> for the house of Levi <char style="pn">(Levite)</char> <char style="add">[Adhesion, Joiner]</char> was budded, and brought forth buds, and bloomed blossoms, and yielded almonds.</para>
  <para style="p">
    <verse number="9" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> brought out all the rods from before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> unto all the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>: and they looked, and took every man his rod.</para>
  <para style="p">
    <verse number="10" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> said unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, Bring Aharon <char style="add">[Bright, Very High]</char>’s rod again before the testimony, to be kept for a token against the rebels; and you<char style="ord">i</char> shall quite take away their murmurings from me, that they die not.</para>
  <para style="p">
    <verse number="11" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> did <char style="add">[so]</char>: as the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded him, so did he.</para>
  <para style="p">
    <verse number="12" style="v" />And the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying, Behold, we die, we perish, we all perish.</para>
  <para style="p">
    <verse number="13" style="v" />Whosoever comes anything near unto the tabernacle of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> shall die: shall we be consumed with dying?</para>
  <chapter number="18" style="c" />
  <para style="p">
    <verse number="1" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> said unto Aharon <char style="add">[Bright, Very High]</char>, you<char style="ord">i</char> and you<char style="ord">i</char> sons and you<char style="ord">i</char> father’s house with you<char style="ord">i</char> shall bear the iniquity of the sanctuary: and you<char style="ord">i</char> and you<char style="ord">i</char> sons with you<char style="ord">i</char> shall bear the iniquity of your priesthood.</para>
  <para style="p">
    <verse number="2" style="v" />And you<char style="ord">i</char> brethren also of the tribe of Levi <char style="pn">(Levite)</char> <char style="add">[Adhesion, Joiner]</char>, the tribe of you<char style="ord">i</char> father, bring you<char style="ord">i</char> with you<char style="ord">i</char>, that they may be joined unto you<char style="ord">i</char>, and minister unto you<char style="ord">i</char>: but you<char style="ord">i</char> and you<char style="ord">i</char> sons with you<char style="ord">i</char> <char style="add">[shall minister]</char> before the tabernacle of witness.</para>
  <para style="p">
    <verse number="3" style="v" />And they shall keep you<char style="ord">i</char> charge, and the charge of all the tabernacle: only they shall not come near the vessels of the sanctuary and the altar, that neither they, nor you<char style="ord">2f</char> also, die.</para>
  <para style="p">
    <verse number="4" style="v" />And they shall be joined unto you<char style="ord">i</char>, and keep the charge of the tabernacle of the congregation, for all the service of the tabernacle: and a stranger shall not come near unto you.</para>
  <para style="p">
    <verse number="5" style="v" />And you<char style="ord">2f</char> shall keep the charge of the sanctuary, and the charge of the altar: that there be no wrath any more upon the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="6" style="v" />And I, behold, I have taken your brethren the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> from among the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>: to you <char style="add">[they are]</char> given <char style="add">[as]</char> a gift for the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, to do the service of the tabernacle of the congregation.</para>
  <para style="p">
    <verse number="7" style="v" />Therefore you<char style="ord">i</char> and you<char style="ord">i</char> sons with you<char style="ord">i</char> shall keep your priest’s office for everything of the altar, and within the veil; and you<char style="ord">2f</char> shall serve: I have given your priest’s office <char style="add">[unto you]</char> as a service of gift: and the stranger that comes near shall be put to death.</para>
  <para style="p">
    <verse number="8" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Aharon <char style="add">[Bright, Very High]</char>, Behold, I also have given you<char style="ord">i</char> the charge of my heave offerings of all the consecrated things of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>; unto you<char style="ord">i</char> have I given them by reason of the anointing, and to you<char style="ord">i</char> sons, by an ordinance forever.</para>
  <para style="p">
    <verse number="9" style="v" />This shall be you<char style="ord">i</char> of the most holy things, <char style="add">[reserved]</char> from the fire: every oblation of theirs, every meat offering of theirs, and every sin offering of theirs, and every trespass offering of theirs, which they shall render unto me, <char style="add">[shall be]</char> most holy for you<char style="ord">i</char> and for you<char style="ord">i</char> sons.</para>
  <para style="p">
    <verse number="10" style="v" />In the most holy <char style="add">[place]</char> shall you<char style="ord">i</char> eat it; every male shall eat it: it shall be holy unto you<char style="ord">i</char>.</para>
  <para style="p">
    <verse number="11" style="v" />And this <char style="add">[is]</char> you<char style="ord">i</char>; the heave offering of their gift, with all the wave offerings of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>: I have given them unto you<char style="ord">i</char>, and to you<char style="ord">i</char> sons and to you<char style="ord">i</char> daughters with you<char style="ord">i</char>, by a statute forever: every one that is clean in you<char style="ord">i</char> house shall eat of it.</para>
  <para style="p">
    <verse number="12" style="v" />All the best of the oil, and all the best of the wine, and of the wheat, the firstfruits of them which they shall offer unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, them have I given you<char style="ord">i</char>.</para>
  <para style="p">
    <verse number="13" style="v" />
    <char style="add">[And]</char> whatsoever is first ripe in the land, which they shall bring unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, shall be you<char style="ord">i</char>; every one that is clean in you<char style="ord">i</char> house shall eat <char style="add">[of]</char> it.</para>
  <para style="p">
    <verse number="14" style="v" />Eveeverything devoted in Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> shall be you<char style="ord">i</char>.</para>
  <para style="p">
    <verse number="15" style="v" />Eveeverything that opens the womb in all flesh, which they bring unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, <char style="add">[whether it be]</char> of men or beasts, shall be you<char style="ord">i</char>: nevertheless the firstborn of man shall you<char style="ord">i</char> surely redeem, and the firstling of unclean beasts shall you<char style="ord">i</char> redeem.</para>
  <para style="p">
    <verse number="16" style="v" />And those that are to be redeemed from a month old shall you<char style="ord">i</char> redeem, according to you<char style="ord">i</char> estimation, for the money of five shekels, after the shekel of the sanctuary, which <char style="add">[is]</char> twenty gerahs.</para>
  <para style="p">
    <verse number="17" style="v" />But the firstling of a cow, or the firstling of a sheep, or the firstling of a goat, you<char style="ord">i</char> shall not redeem; they <char style="add">[are]</char> holy: you<char style="ord">i</char> shall sprinkle their blood upon the altar, and shall burn their fat <char style="add">[for]</char> an offering made by fire, for a soothing aroma unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="18" style="v" />And the flesh of them shall be you<char style="ord">i</char>, as the wave breast and as the right shoulder are you<char style="ord">i</char>.</para>
  <para style="p">
    <verse number="19" style="v" />All the heave offerings of the holy things, which the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> offer unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, have I given you<char style="ord">i</char>, and you<char style="ord">i</char> sons and you<char style="ord">i</char> daughters with you<char style="ord">i</char>, by a statute forever: it <char style="add">[is]</char> a covenant of salt forever before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> unto you<char style="ord">i</char> and to you<char style="ord">i</char> seed with you<char style="ord">i</char>.</para>
  <para style="p">
    <verse number="20" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Aharon <char style="add">[Bright, Very High]</char>, you<char style="ord">i</char> shall have no inheritance in their land, neither shall you<char style="ord">i</char> have any part among them: I <char style="add">[am]</char> you<char style="ord">i</char> part and you<char style="ord">i</char> inheritance among the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="21" style="v" />And, behold, I have given the children of Levi <char style="pn">(Levite)</char> <char style="add">[Adhesion, Joiner]</char> all the tenth in Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> for an inheritance, for their service which they serve, <char style="add">[even]</char> the service of the tabernacle of the congregation.</para>
  <para style="p">
    <verse number="22" style="v" />Neither must the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> from this time forth <char style="pn">(from now on)</char> come near the tabernacle of the congregation, lest they bear sin, and die.</para>
  <para style="p">
    <verse number="23" style="v" />But the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> shall do the service of the tabernacle of the congregation, and they shall bear their iniquity: <char style="add">[it shall be]</char> a statute forever throughout your generations, that among the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> they have no inheritance.</para>
  <para style="p">
    <verse number="24" style="v" />But the tithes of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, which they offer <char style="add">[as]</char> an heave offering unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, I have given to the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> to inherit: therefore I have said unto them, Among the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> they shall have no inheritance.</para>
  <para style="p">
    <verse number="25" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="26" style="v" />Thus speak unto the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char>, and say unto them, When you<char style="ord">2f</char> take of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> the tithes which I have given you from them for your inheritance, then you<char style="ord">2f</char> shall offer up an heave offering of it for the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, <char style="add">[even]</char> a tenth <char style="add">[part]</char> of the tithe.</para>
  <para style="p">
    <verse number="27" style="v" />And <char style="add">[this]</char> your heave offering shall be reckoned unto you, as though <char style="add">[it were]</char> the corn of the threshing floor, and as the fullness of the winepress.</para>
  <para style="p">
    <verse number="28" style="v" />Thus you<char style="ord">2f</char> also shall offer an heave offering unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> of all your tithes, which you<char style="ord">2f</char> receive of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>; and you<char style="ord">2f</char> shall give thereof the LORD-Yehōvah’s <char style="add">[Messiah Pre-Incarnate]</char> heave offering to Aharon <char style="add">[Bright, Very High]</char> the priest.</para>
  <para style="p">
    <verse number="29" style="v" />Out of all your gifts you<char style="ord">2f</char> shall offer every heave offering of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, of all the best thereof, <char style="add">[even]</char> the consecrated part thereof out of it.</para>
  <para style="p">
    <verse number="30" style="v" />Therefore you<char style="ord">i</char> shall say unto them, When you<char style="ord">2f</char> have heaved the best thereof from it, then it shall be counted unto the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> as the increase of the threshing floor, and as the increase of the winepress.</para>
  <para style="p">
    <verse number="31" style="v" />And you<char style="ord">2f</char> shall eat it in every place, you<char style="ord">2f</char> and your households: for it <char style="add">[is]</char> your reward for your service in the tabernacle of the congregation.</para>
  <para style="p">
    <verse number="32" style="v" />And you<char style="ord">2f</char> shall bear no sin by reason of it, when you<char style="ord">2f</char> have heaved from it the best of it: neither shall you<char style="ord">2f</char> pollute the holy things of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, lest you<char style="ord">2f</char> die.</para>
  <chapter number="19" style="c" />
  <para style="p">
    <verse number="1" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and unto Aharon <char style="add">[Bright, Very High]</char>, saying,</para>
  <para style="p">
    <verse number="2" style="v" />This <char style="add">[is]</char> the ordinance of the law which the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> has commanded, saying, Speak unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, that they bring you<char style="ord">i</char> a red heifer without spot, wherein <char style="add">[is]</char> no blemish, <char style="add">[and]</char> upon which never came yoke:</para>
  <para style="p">
    <verse number="3" style="v" />And you<char style="ord">2f</char> shall give her unto El’azar <char style="add">[God has helped]</char> the priest, that he may bring her forth without the camp, and <char style="add">[one]</char> shall slay her before his face:</para>
  <para style="p">
    <verse number="4" style="v" />And El’azar <char style="add">[God has helped]</char> the priest shall take of her blood with his finger, and sprinkle of her blood directly before the tabernacle of the congregation seven times:</para>
  <para style="p">
    <verse number="5" style="v" />And <char style="add">[one]</char> shall burn the heifer in his sight; her skin, and her flesh, and her blood, with her dung, shall he burn:</para>
  <para style="p">
    <verse number="6" style="v" />And the priest shall take cedar wood, and hyssop, and scarlet, and cast <char style="add">[it]</char> into the midst of the burning of the heifer.</para>
  <para style="p">
    <verse number="7" style="v" />Then the priest shall wash his clothes, and he shall bathe his flesh in water, and afterward he shall come into the camp, and the priest shall be unclean until the even.</para>
  <para style="p">
    <verse number="8" style="v" />And he that burns her shall wash his clothes in water, and bathe his flesh in water, and shall be unclean until the even.</para>
  <para style="p">
    <verse number="9" style="v" />And a man <char style="add">[that is]</char> clean shall gather up the ashes of the heifer, and lay <char style="add">[them]</char> up without the camp in a clean place, and it shall be kept for the congregation of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> for a water of separation: it <char style="add">[is]</char> a purification for sin.</para>
  <para style="p">
    <verse number="10" style="v" />And he that gathers the ashes of the heifer shall wash his clothes, and be unclean until the evening: and it shall be unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, and unto the stranger that sojournes among them, for a statute forever.</para>
  <para style="p">
    <verse number="11" style="v" />He that touches the dead body of any man shall be unclean seven days.</para>
  <para style="p">
    <verse number="12" style="v" />He shall purify himself with it on the third day, and on the seventh day he shall be clean: but if he purify not himself the third day, then the seventh day he shall not be clean.</para>
  <para style="p">
    <verse number="13" style="v" />Whosoever touches the dead body of any man that is dead, and purifies not himself, defiles the tabernacle of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>; and that soul shall be cut off from Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>: because the water of separation was not sprinkled upon him, he shall be unclean; his uncleanness <char style="add">[is]</char> yet upon him.</para>
  <para style="p">
    <verse number="14" style="v" />This <char style="add">[is]</char> the law, when a man dies in a tent: all that come into the tent, and all that <char style="add">[is]</char> in the tent, shall be unclean seven days.</para>
  <para style="p">
    <verse number="15" style="v" />And every open vessel, which has no covering bound upon it, <char style="add">[is]</char> unclean.</para>
  <para style="p">
    <verse number="16" style="v" />And whosoever touches one that is slain with a sword in the open fields, or a dead body, or a bone of a man, or a grave, shall be unclean seven days.</para>
  <para style="p">
    <verse number="17" style="v" />And for an unclean <char style="add">[person]</char> they shall take of the ashes of the burnt heifer of purification for sin, and running water shall be put thereto in a vessel:</para>
  <para style="p">
    <verse number="18" style="v" />And a clean person shall take hyssop, and dip <char style="add">[it]</char> in the water, and sprinkle <char style="add">[it]</char> upon the tent, and upon all the vessels, and upon the persons that were there, and upon him that touched a bone, or one slain, or one dead, or a grave:</para>
  <para style="p">
    <verse number="19" style="v" />And the clean <char style="add">[person]</char> shall sprinkle upon the unclean on the third day, and on the seventh day: and on the seventh day he shall purify himself, and wash his clothes, and bathe himself in water, and shall be clean at even.</para>
  <para style="p">
    <verse number="20" style="v" />But the man that shall be unclean, and shall not purify himself, that soul shall be cut off from among the congregation, because he has defiled the sanctuary of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>: the water of separation has not been sprinkled upon him; he <char style="add">[is]</char> unclean.</para>
  <para style="p">
    <verse number="21" style="v" />And it shall be a perpetual statute unto them, that he that sprinkles the water of separation shall wash his clothes; and he that touches the water of separation shall be unclean until even.</para>
  <para style="p">
    <verse number="22" style="v" />And whatsoever the unclean <char style="add">[person]</char> touches shall be unclean; and the soul that touches <char style="add">[it]</char> shall be unclean until even.</para>
  <chapter number="20" style="c" />
  <para style="p">
    <verse number="1" style="v" />Then came the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, <char style="add">[even]</char> the whole congregation, into the desert of Tzin <char style="add">[Flat]</char> in the first month: and the people abode in Kadesh <char style="add">[Holy]</char>; and Miryam <char style="add">[rebellion]</char> died there, and was buried there.</para>
  <para style="p">
    <verse number="2" style="v" />And there was no water for the congregation: and they gathered themselves together against Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and against Aharon <char style="add">[Bright, Very High]</char>.</para>
  <para style="p">
    <verse number="3" style="v" />And the people chastised with Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, and spoke, saying, Would God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> that we had died when our brethren died before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>!</para>
  <para style="p">
    <verse number="4" style="v" />And why have you<char style="ord">2f</char> brought up the congregation of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> into this wilderness, that we and our cattle should die there?</para>
  <para style="p">
    <verse number="5" style="v" />And wherefore have you<char style="ord">2f</char> made us to come up out of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>, to bring us in unto this evil place? it <char style="add">[is]</char> no place of seed, or of figs, or of vines, or of pomegranates; neither <char style="add">[is]</char> there any water to drink.</para>
  <para style="p">
    <verse number="6" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and Aharon <char style="add">[Bright, Very High]</char> went from the presence of the assembly unto the door of the tabernacle of the congregation, and they fell upon their faces: and the glory of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> appeared unto them.</para>
  <para style="p">
    <verse number="7" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="8" style="v" />Take the rod, and gather you<char style="ord">i</char> the assembly together, you<char style="ord">i</char>, and Aharon <char style="add">[Bright, Very High]</char> you<char style="ord">i</char> brother, and speak you<char style="ord">2f</char> unto the rock before their eyes; and it shall give forth his water, and you<char style="ord">i</char> shall bring forth to them water out of the rock: so you<char style="ord">i</char> shall give the congregation and their beasts drink.</para>
  <para style="p">
    <verse number="9" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> took the rod from before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, as he commanded him.</para>
  <para style="p">
    <verse number="10" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and Aharon <char style="add">[Bright, Very High]</char> gathered the congregation together before the rock, and he said unto them, Hear now, you<char style="ord">2f</char> rebels; must we fetch you water out of this rock?</para>
  <para style="p">
    <verse number="11" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> lifted up his hand, and with his rod he struck the rock twice: and the water came out abundantly, and the congregation drank, and their beasts <char style="add">[also]</char>.</para>
  <para style="p">
    <verse number="12" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and Aharon <char style="add">[Bright, Very High]</char>, Because you<char style="ord">2f</char> believed me not, to sanctify <char style="pn">(make holy; set apart for God’s use)</char> me in the eyes of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, therefore you<char style="ord">2f</char> shall not bring this congregation into the land which I have given them.</para>
  <para style="p">
    <verse number="13" style="v" />This <char style="add">[is]</char> the water of M’rivah <char style="add">[Arguing]</char>; because the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> strove with the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and he was sanctified in them.</para>
  <para style="p">
    <verse number="14" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> sent messengers from Kadesh <char style="add">[Holy]</char> unto the king of Edom <char style="add">[Red]</char>, Thus says you<char style="ord">i</char> brother Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, you<char style="ord">i</char> know all the travail that has befallen us:</para>
  <para style="p">
    <verse number="15" style="v" />How our fathers went down into Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>, and we have dwelt in Mitzrayim <char style="add">[Egypt - The Narrow Place]</char> a long time; and the Mitzri vexed us, and our fathers:</para>
  <para style="p">
    <verse number="16" style="v" />And when we cried unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, he heard our voice, and sent an angel, and has brought us forth out of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>: and, behold, we <char style="add">[are]</char> in Kadesh <char style="add">[Holy]</char>, a city in the uttermost of you<char style="ord">i</char> border:</para>
  <para style="p">
    <verse number="17" style="v" />Let us pass, I pray you<char style="ord">i</char>, through you<char style="ord">i</char> country: we will not pass through the fields, or through the vineyards, neither will we drink <char style="add">[of]</char> the water of the wells: we will go by the king’s <char style="add">[high]</char> way, we will not turn to the right hand nor to the left, until we have passed you<char style="ord">i</char> borders.</para>
  <para style="p">
    <verse number="18" style="v" />And Edom <char style="add">[Red]</char> said unto him, you<char style="ord">i</char> shall not pass by me, lest I come out against you<char style="ord">i</char> with the sword.</para>
  <para style="p">
    <verse number="19" style="v" />And the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> said unto him, We will go by the high way: and if I and my cattle drink of you<char style="ord">i</char> water, then I will pay for it: I will only, without <char style="add">[doing]</char> anything <char style="add">[else]</char>, go through on my feet.</para>
  <para style="p">
    <verse number="20" style="v" />And he said, you<char style="ord">i</char> shall not go through. And Edom <char style="add">[Red]</char> came out against him with much people, and with a strong hand.</para>
  <para style="p">
    <verse number="21" style="v" />Thus Edom <char style="add">[Red]</char> refused to give Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> passage through his border: wherefore Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> turned away from him.</para>
  <para style="p">
    <verse number="22" style="v" />And the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, <char style="add">[even]</char> the whole congregation, journeyed from Kadesh <char style="add">[Holy]</char>, and came unto mount Hor <char style="add">[Mountain Peak]</char>.</para>
  <para style="p">
    <verse number="23" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and Aharon <char style="add">[Bright, Very High]</char> in mount Hor <char style="add">[Mountain Peak]</char>, by the coast of the land of Edom <char style="add">[Red]</char>, saying,</para>
  <para style="p">
    <verse number="24" style="v" />Aharon <char style="add">[Bright, Very High]</char> shall be gathered unto his people: for he shall not enter into the land which I have given unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, because you<char style="ord">2f</char> rebelled against my word at the water of M’rivah <char style="add">[Arguing]</char>.</para>
  <para style="p">
    <verse number="25" style="v" />Take Aharon <char style="add">[Bright, Very High]</char> and El’azar <char style="add">[God has helped]</char> his son, and bring them up unto mount Hor <char style="add">[Mountain Peak]</char>:</para>
  <para style="p">
    <verse number="26" style="v" />And strip Aharon <char style="add">[Bright, Very High]</char> of his garments, and put them upon El’azar <char style="add">[God has helped]</char> his son: and Aharon <char style="add">[Bright, Very High]</char> shall be gathered <char style="add">[unto his people]</char>, and shall die there.</para>
  <para style="p">
    <verse number="27" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> did as the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded: and they went up into mount Hor <char style="add">[Mountain Peak]</char> in the sight of all the congregation.</para>
  <para style="p">
    <verse number="28" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> stripped Aharon <char style="add">[Bright, Very High]</char> of his garments, and put them upon El’azar <char style="add">[God has helped]</char> his son; and Aharon <char style="add">[Bright, Very High]</char> died there in the top of the mount: and Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and El’azar <char style="add">[God has helped]</char> came down from the mount.</para>
  <para style="p">
    <verse number="29" style="v" />And when all the congregation saw that Aharon <char style="add">[Bright, Very High]</char> was dead, they mourned for Aharon <char style="add">[Bright, Very High]</char> thirty days, <char style="add">[even]</char> all the house of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <chapter number="21" style="c" />
  <para style="p">
    <verse number="1" style="v" />And <char style="add">[when]</char> king ‘Arad <char style="add">[A Wild Ass]</char> the Kena’ani <char style="add">[Merchants]</char>, which dwelt in the south, heard tell that Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> came by the way of the spies; then he fought against Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, and took <char style="add">[some]</char> of them prisoners.</para>
  <para style="p">
    <verse number="2" style="v" />And Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> vowed a vow unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and said, If you<char style="ord">i</char> will indeed deliver this people into my hand, then I will utterly destroy their cities.</para>
  <para style="p">
    <verse number="3" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> listened to the voice of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, and delivered up the Kena’ani <char style="add">[Merchant]</char>; and they utterly destroyed them and their cities: and he called the name of the place Hormah <char style="add">[Asylum]</char>.</para>
  <para style="p">
    <verse number="4" style="v" />And they journeyed from mount Hor <char style="add">[Mountain Peak]</char> by the way of the Red sea, to compass <char style="pn">(go around, encircle; encompass)</char> the land of Edom <char style="add">[Red]</char>: and the soul of the people was much discouraged because of the way.</para>
  <para style="p">
    <verse number="5" style="v" />And the people spoke against God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>, and against Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, For what reason have you<char style="ord">2f</char> brought us up out of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char> to die in the wilderness? for <char style="add">[there is]</char> no bread, neither <char style="add">[is there any]</char> water; and our soul loathes this light bread.</para>
  <para style="p">
    <verse number="6" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> sent fiery serpents among the people, and they bit the people; and much people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> died.</para>
  <para style="p">
    <verse number="7" style="v" />Therefore the people came to Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, and said, We have sinned, for we have spoken against the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and against you<char style="ord">i</char>; pray unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, that he take away the serpents from us. And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> prayed for the people.</para>
  <para style="p">
    <verse number="8" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> said unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, Make you<char style="ord">i</char> a fiery serpent, and set it upon a pole: and it shall come to pass, that every one that is bitten, when he looks upon it, shall live.</para>
  <para style="p">
    <verse number="9" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> made a serpent of brass, and put it upon a pole, and it came to pass, that if a serpent had bitten any man, when he beheld the serpent of brass, he lived.</para>
  <para style="p">
    <verse number="10" style="v" />And the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> set forward, and pitched in Ovot <char style="add">[Waterskins]</char>.</para>
  <para style="p">
    <verse number="11" style="v" />And they journeyed from Ovot <char style="add">[Waterskins]</char>, and pitched at ‘Iyei-Ha’avarim <char style="add">[Ruins of Regions Beyond]</char>, in the wilderness which <char style="add">[is]</char> before Mo’av <char style="add">[Seed of my Father]</char>, toward the sunrising.</para>
  <para style="p">
    <verse number="12" style="v" />From there they removed, and pitched in the Vadi Zared <char style="add">[“Flexible Twig of a Willow Tree” Brook]</char>.</para>
  <para style="p">
    <verse number="13" style="v" />From there they removed, and pitched on the other side of ‘Arnon <char style="add">[Rushing Stream]</char>, which <char style="add">[is]</char> in the wilderness that comes out of the coasts of the Emori <char style="add">[Highlanders]</char>: for ‘Arnon <char style="add">[Rushing Stream] [is]</char> the border of Mo’av <char style="add">[Seed of my Father]</char>, between Mo’av <char style="add">[Seed of my Father]</char> and the Emori <char style="add">[Highlanders]</char>.</para>
  <para style="p">
    <verse number="14" style="v" />For what reason it is said in the book of the wars of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, What he did in the Red sea, and in the brooks of ‘Arnon <char style="add">[Rushing Stream]</char>,</para>
  <para style="p">
    <verse number="15" style="v" />And at the stream of the brooks that goes down to the dwelling of ‘Ar <char style="add">[A City]</char>, and lies upon the border of Mo’av <char style="add">[Seed of my Father]</char>.</para>
  <para style="p">
    <verse number="16" style="v" />And from there <char style="add">[they went]</char> to Be’er <char style="add">[Well]</char>: that <char style="add">[is]</char> the well whereof the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, Gather the people together, and I will give them water.</para>
  <para style="p">
    <verse number="17" style="v" />Then Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> sang this song, Spring up, O well; sing you<char style="ord">2f</char> unto it:</para>
  <para style="p">
    <verse number="18" style="v" />The princes excavated the well, the nobles of the people excavated it, by <char style="add">[the direction of]</char> the lawgiver, with their rods <char style="pn">(clubs)</char>. And from the wilderness <char style="add">[they went]</char> to Mattanah <char style="add">[Gift of Jehovah]</char>:</para>
  <para style="p">
    <verse number="19" style="v" />And from Mattanah <char style="add">[Gift of Jehovah]</char> to Nachali’el <char style="add">[Torrents of God]</char>: and from Nachali’el <char style="add">[Torrents of God]</char> to Bamot <char style="add">[Great High Place]</char>:</para>
  <para style="p">
    <verse number="20" style="v" />And from Bamot <char style="add">[Great High Place] [in]</char> the valley, that <char style="add">[is]</char> in the country of Mo’av <char style="add">[Seed of my Father]</char>, to the top of Pisgah [Cleft <char style="pn">(split hoof; an opening, break or split)</char> Mountain Range], which looks toward Y’shim’on <char style="add">[Wasteland]</char>.</para>
  <para style="p">
    <verse number="21" style="v" />And Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> sent messengers unto Sichon <char style="add">[Warrior]</char> king of the Emori <char style="add">[Highlanders]</char>, saying,</para>
  <para style="p">
    <verse number="22" style="v" />Let me pass through you<char style="ord">i</char> land: we will not turn into the fields, or into the vineyards; we will not drink <char style="add">[of]</char> the waters of the well: <char style="add">[but]</char> we will go along by the king’s <char style="add">[high]</char> way, until we be past you<char style="ord">i</char> borders.</para>
  <para style="p">
    <verse number="23" style="v" />And Sichon <char style="add">[Warrior]</char> would not suffer Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> to pass through his border: but Sichon <char style="add">[Warrior]</char> gathered all his people together, and went out against Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> into the wilderness: and he came to Yachatz <char style="add">[Trampled Down]</char>, and fought against Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="24" style="v" />And Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> struck him with the edge of the sword, and possessed his land from ‘Arnon <char style="add">[Rushing Stream]</char> unto Yabok <char style="add">[luxuriant emptying river]</char>, even unto the children of ‘Amon <char style="add">[Inbred]</char>: for the border of the children of ‘Amon <char style="add">[Inbred] [was]</char> strong.</para>
  <para style="p">
    <verse number="25" style="v" />And Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> took all these cities: and Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> dwelt in all the cities of the Emori <char style="add">[Highlanders]</char>, in Heshbon <char style="add">[Stronghold]</char>, and in all the villages thereof.</para>
  <para style="p">
    <verse number="26" style="v" />For Heshbon <char style="add">[Stronghold] [was]</char> the city of Sichon <char style="add">[Warrior]</char> the king of the Emori <char style="add">[Highlanders]</char>, who had fought against the former king of Mo’av <char style="add">[Seed of my Father]</char>, and taken all his land out of his hand, even unto ‘Arnon <char style="add">[Rushing Stream]</char>.</para>
  <para style="p">
    <verse number="27" style="v" />For what reason they that speak in proverbs say, Come into Heshbon <char style="add">[Stronghold]</char>, let the city of Sichon <char style="add">[Warrior]</char> be built and prepared:</para>
  <para style="p">
    <verse number="28" style="v" />For there is a fire gone out of Heshbon <char style="add">[Stronghold]</char>, a flame from the city of Sichon <char style="add">[Warrior]</char>: it has consumed ‘Ar <char style="add">[A City]</char> of Mo’av <char style="add">[Seed of my Father]</char>, <char style="add">[and]</char> the lords of the high places of ‘Arnon <char style="add">[Rushing Stream]</char>.</para>
  <para style="p">
    <verse number="29" style="v" />Woe to you<char style="ord">i</char>, Mo’av <char style="add">[Seed of my Father]</char>! you<char style="ord">i</char> are undone, O people of K’mosh <char style="add">[Subduer]</char>: he has given his sons that escaped, and his daughters, into captivity unto Sichon <char style="add">[Warrior]</char> king of the Emori <char style="add">[Highlanders]</char>.</para>
  <para style="p">
    <verse number="30" style="v" />We have shot at them; Heshbon <char style="add">[Stronghold]</char> is perished even unto Divon <char style="add">[Wasting]</char>, and we have laid them waste even unto Nofach <char style="add">[Blast]</char>, which <char style="add">[reaches]</char> unto Meidva <char style="add">[Water of Rest]</char>.</para>
  <para style="p">
    <verse number="31" style="v" />Thus Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> dwelt in the land of the Emori <char style="add">[Highlanders]</char>.</para>
  <para style="p">
    <verse number="32" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> sent to spy out Ya’zer <char style="add">[Helped]</char>, and they took the villages thereof, and drove out the Emori <char style="add">[Highlanders]</char> that <char style="add">[were]</char> there.</para>
  <para style="p">
    <verse number="33" style="v" />And they turned and went up by the way of Bashan <char style="add">[Fruitful]</char>: and ‘Og <char style="add">[Long-necked]</char> the king of Bashan <char style="add">[Fruitful]</char> went out against them, he, and all his people, to the battle at Edre’i <char style="add">[Good Pasture]</char>.</para>
  <para style="p">
    <verse number="34" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> said unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, Fear him not: for I have delivered him into you<char style="ord">i</char> hand, and all his people, and his land; and you<char style="ord">i</char> shall do to him as you<char style="ord">i</char> did unto Sichon <char style="add">[Warrior]</char> king of the Emori <char style="add">[Highlanders]</char>, which dwelt at Heshbon <char style="add">[Stronghold]</char>.</para>
  <para style="p">
    <verse number="35" style="v" />So they struck him, and his sons, and all his people, until there was none left him alive: and they possessed his land.</para>
  <chapter number="22" style="c" />
  <para style="p">
    <verse number="1" style="v" />And the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> set forward, and pitched in the plains of Mo’av <char style="add">[Seed of my Father]</char> on this side Yarden <char style="add">[Descender] [by]</char> Yericho <char style="add">[Its Moon]</char>.</para>
  <para style="p">
    <verse number="2" style="v" />And Balak <char style="add">[Devastator]</char> the son of Zippor <char style="add">[Sparrow]</char> saw all that Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> had done to the Emori <char style="add">[Highlanders]</char>.</para>
  <para style="p">
    <verse number="3" style="v" />And Mo’av <char style="add">[Seed of my Father]</char> was sore afraid of the people, because they <char style="add">[were]</char> many: and Mo’av <char style="add">[Seed of my Father]</char> was distressed because of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="4" style="v" />And Mo’av <char style="add">[Seed of my Father]</char> said unto the elders of Midyan <char style="add">[Strife]</char>, Now shall this company lick up all <char style="add">[that are]</char> round about us, as the ox licks up the grass of the field. And Balak <char style="add">[Devastator]</char> the son of Zippor <char style="add">[Sparrow] [was]</char> king of the Mo’avi <char style="add">[of his father]</char> at that time.</para>
  <para style="p">
    <verse number="5" style="v" />He sent messengers therefore unto Bil’am <char style="add">[Not of the People]</char> the son of B’or <char style="add">[Burning]</char> to P’tor <char style="add">[Soothsayer (one who fortells the future by ungodly means)]</char>, which <char style="add">[is]</char> by the river of the land of the children of his people, to call him, saying, Behold, there is a people come out from Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>: behold, they cover the face of the earth, and they abide over against me:</para>
  <para style="p">
    <verse number="6" style="v" />Come now therefore, I pray you<char style="ord">i</char>, curse me this people; for they <char style="add">[are]</char> too mighty for me: perhaps I shall prevail, <char style="add">[that]</char> we may strike them, and <char style="add">[that]</char> I may drive them out of the land: for I know that he whom you<char style="ord">i</char> bless <char style="add">[is]</char> Blessed <char style="pn">(Favored by God; happy; prosperous)</char>, and he whom you<char style="ord">i</char> curse is cursed.</para>
  <para style="p">
    <verse number="7" style="v" />And the elders of Mo’av <char style="add">[Seed of my Father]</char> and the elders of Midyan <char style="add">[Strife]</char> departed with the rewards of divination in their hand; and they came unto Bil’am <char style="add">[Not of the People]</char>, and spoke unto him the words of Balak <char style="add">[Devastator]</char>.</para>
  <para style="p">
    <verse number="8" style="v" />And he said unto them, Lodge here this night, and I will bring you word again, as the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> shall speak unto me: and the princes of Mo’av <char style="add">[Seed of my Father]</char> abode with Bil’am <char style="add">[Not of the People]</char>.</para>
  <para style="p">
    <verse number="9" style="v" />And God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> came unto Bil’am <char style="add">[Not of the People]</char>, and said, What men <char style="add">[are]</char> these with you<char style="ord">i</char>?</para>
  <para style="p">
    <verse number="10" style="v" />And Bil’am <char style="add">[Not of the People]</char> said unto God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>, Balak <char style="add">[Devastator]</char> the son of Zippor <char style="add">[Sparrow]</char>, king of Mo’av <char style="add">[Seed of my Father]</char>, has sent unto me, <char style="add">[saying]</char>,</para>
  <para style="p">
    <verse number="11" style="v" />Behold, <char style="add">[there is]</char> a people come out of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>, which covers the face of the earth: come now, curse me them; perhaps I shall be able to overcome them, and drive them out.</para>
  <para style="p">
    <verse number="12" style="v" />And God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> said unto Bil’am <char style="add">[Not of the People]</char>, you<char style="ord">i</char> shall not go with them; you<char style="ord">i</char> shall not curse the people: for they <char style="add">[are]</char> Blessed <char style="pn">(Favored by God; happy; prosperous)</char>.</para>
  <para style="p">
    <verse number="13" style="v" />And Bil’am <char style="add">[Not of the People]</char> rose up in the morning, and said unto the princes of Balak <char style="add">[Devastator]</char>, Get you into your land: for the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> refuses to give me leave to go with you.</para>
  <para style="p">
    <verse number="14" style="v" />And the princes of Mo’av <char style="add">[Seed of my Father]</char> rose up, and they went unto Balak <char style="add">[Devastator]</char>, and said, Bil’am <char style="add">[Not of the People]</char> refuses to come with us.</para>
  <para style="p">
    <verse number="15" style="v" />And Balak <char style="add">[Devastator]</char> sent yet again princes, more, and more honourable than they.</para>
  <para style="p">
    <verse number="16" style="v" />And they came to Bil’am <char style="add">[Not of the People]</char>, and said to him, Thus says Balak <char style="add">[Devastator]</char> the son of Zippor <char style="add">[Sparrow]</char>, Let nothing, I pray you<char style="ord">i</char>, hinder you<char style="ord">i</char> from coming unto me:</para>
  <para style="p">
    <verse number="17" style="v" />For I will promote you<char style="ord">i</char> unto very great honour, and I will do whatsoever you<char style="ord">i</char> say unto me: come therefore, I pray you<char style="ord">i</char>, curse me this people.</para>
  <para style="p">
    <verse number="18" style="v" />And Bil’am <char style="add">[Not of the People]</char> answered and said unto the servants of Balak <char style="add">[Devastator]</char>, If Balak <char style="add">[Devastator]</char> would give me his house full of silver and gold, I cannot go beyond the word of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> my God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>, to do less or more.</para>
  <para style="p">
    <verse number="19" style="v" />Now therefore, I pray you, wait you<char style="ord">2f</char> also here this night, that I may know what the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> will say unto me more.</para>
  <para style="p">
    <verse number="20" style="v" />And God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> came unto Bil’am <char style="add">[Not of the People]</char> at night, and said unto him, If the men come to call you<char style="ord">i</char>, rise up, <char style="add">[and]</char> go with them; but yet the word which I shall say unto you<char style="ord">i</char>, that shall you<char style="ord">i</char> do.</para>
  <para style="p">
    <verse number="21" style="v" />And Bil’am <char style="add">[Not of the People]</char> rose up in the morning, and saddled his ass, and went with the princes of Mo’av <char style="add">[Seed of my Father]</char>.</para>
  <para style="p">
    <verse number="22" style="v" />And God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>’s anger was kindled because he went: and the angel of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> stood in the way for an adversary against him. Now he was riding upon his ass, and his two servants <char style="add">[were]</char> with him.</para>
  <para style="p">
    <verse number="23" style="v" />And the ass saw the angel of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> standing in the way, and his sword drawn in his hand: and the ass turned aside out of the way, and went into the field: and Bil’am <char style="add">[Not of the People]</char> struck the ass, to turn her into the way.</para>
  <para style="p">
    <verse number="24" style="v" />But the angel of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> stood in a path of the vineyards, a wall <char style="add">[being]</char> on this side, and a wall on that side.</para>
  <para style="p">
    <verse number="25" style="v" />And when the ass saw the angel of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, she thrust herself unto the wall, and crushed Bil’am <char style="add">[Not of the People]</char>’s foot against the wall: and he struck her again.</para>
  <para style="p">
    <verse number="26" style="v" />And the angel of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> went further, and stood in a narrow place, where <char style="add">[was]</char> no way to turn either to the right hand or to the left.</para>
  <para style="p">
    <verse number="27" style="v" />And when the ass saw the angel of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, she fell down under Bil’am <char style="add">[Not of the People]</char>: and Bil’am <char style="add">[Not of the People]</char>’s anger was kindled, and he struck the ass with a staff.</para>
  <para style="p">
    <verse number="28" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> opened the mouth of the ass, and she said unto Bil’am <char style="add">[Not of the People]</char>, What have I done unto you<char style="ord">i</char>, that you<char style="ord">i</char> have smitten me these three times?</para>
  <para style="p">
    <verse number="29" style="v" />And Bil’am <char style="add">[Not of the People]</char> said unto the ass, Because you<char style="ord">i</char> have mocked me: I would there were a sword in my hand, for now would I kill you<char style="ord">i</char>.</para>
  <para style="p">
    <verse number="30" style="v" />And the ass said unto Bil’am <char style="add">[Not of the People]</char>, <char style="add">[Am]</char> not I you<char style="ord">i</char> ass, upon which you<char style="ord">i</char> have ridden ever since <char style="add">[I was]</char> you<char style="ord">i</char> unto this day? was I ever won’t to do so unto you<char style="ord">i</char>? And he said, No.</para>
  <para style="p">
    <verse number="31" style="v" />Then the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> opened the eyes of Bil’am <char style="add">[Not of the People]</char>, and he saw the angel of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> standing in the way, and his sword drawn in his hand: and he bowed down his head, and fell flat on his face.</para>
  <para style="p">
    <verse number="32" style="v" />And the angel of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> said unto him, For what reason have you<char style="ord">i</char> smitten you<char style="ord">i</char> ass these three times? behold, I went out that is to withstand you<char style="ord">i</char>, because <char style="add">[you<char style="ord">i</char>]</char> way is perverse before me:</para>
  <para style="p">
    <verse number="33" style="v" />And the ass saw me, and turned from me these three times: unless she had turned from me, surely now also I had slain you<char style="ord">i</char>, and saved her alive.</para>
  <para style="p">
    <verse number="34" style="v" />And Bil’am <char style="add">[Not of the People]</char> said unto the angel of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, I have sinned; for I knew not that you<char style="ord">i</char> stood in the way against me: now therefore, if it displease you<char style="ord">i</char>, I will get me back again.</para>
  <para style="p">
    <verse number="35" style="v" />And the angel of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> said unto Bil’am <char style="add">[Not of the People]</char>, Go with the men: but only the word that I shall speak unto you<char style="ord">i</char>, that you<char style="ord">i</char> shall speak. So Bil’am <char style="add">[Not of the People]</char> went with the princes of Balak <char style="add">[Devastator]</char>.</para>
  <para style="p">
    <verse number="36" style="v" />And when Balak <char style="add">[Devastator]</char> heard that Bil’am <char style="add">[Not of the People]</char> was come, he went out to meet him unto a city of Mo’av <char style="add">[Seed of my Father]</char>, which <char style="add">[is]</char> in the border of ‘Arnon <char style="add">[Rushing Stream]</char>, which <char style="add">[is]</char> in the utmost coast.</para>
  <para style="p">
    <verse number="37" style="v" />And Balak <char style="add">[Devastator]</char> said unto Bil’am <char style="add">[Not of the People]</char>, Did I not earnestly send unto you<char style="ord">i</char> to call you<char style="ord">i</char>? wherefore came you<char style="ord">i</char> not unto me? am I not able indeed to promote you<char style="ord">i</char> to honour?</para>
  <para style="p">
    <verse number="38" style="v" />And Bil’am <char style="add">[Not of the People]</char> said unto Balak <char style="add">[Devastator]</char>, Lo, I am come unto you<char style="ord">i</char>: have I now any power at all to <char style="pn">(to do entirely, do wholly)</char> say anything? the word that God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> puts in my mouth, that shall I speak.</para>
  <para style="p">
    <verse number="39" style="v" />And Bil’am <char style="add">[Not of the People]</char> went with Balak <char style="add">[Devastator]</char>, and they came unto Kiryat-Hutzot <char style="add">[City of Streets]</char>.</para>
  <para style="p">
    <verse number="40" style="v" />And Balak <char style="add">[Devastator]</char> offered oxen and sheep, and sent to Bil’am <char style="add">[Not of the People]</char>, and to the princes that <char style="add">[were]</char> with him.</para>
  <para style="p">
    <verse number="41" style="v" />And it came to pass on the morrow, that Balak <char style="add">[Devastator]</char> took Bil’am <char style="add">[Not of the People]</char>, and brought him up into the high places of Ba’al <char style="add">[lord (a false god)]</char>, that there he might see the utmost <char style="add">[part]</char> of the people.</para>
  <chapter number="23" style="c" />
  <para style="p">
    <verse number="1" style="v" />And Bil’am <char style="add">[Not of the People]</char> said unto Balak <char style="add">[Devastator]</char>, Build me here seven altars, and prepare me here seven oxen and seven rams.</para>
  <para style="p">
    <verse number="2" style="v" />And Balak <char style="add">[Devastator]</char> did as Bil’am <char style="add">[Not of the People]</char> had spoken; and Balak <char style="add">[Devastator]</char> and Bil’am <char style="add">[Not of the People]</char> offered on <char style="add">[every]</char> altar a bullock and a ram.</para>
  <para style="p">
    <verse number="3" style="v" />And Bil’am <char style="add">[Not of the People]</char> said unto Balak <char style="add">[Devastator]</char>, Stand by you<char style="ord">i</char> burnt offering, and I will go: perhaps the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> will come to meet me: and whatsoever he shows me I will tell you<char style="ord">i</char>. And he went to an high place.</para>
  <para style="p">
    <verse number="4" style="v" />And God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> met Bil’am <char style="add">[Not of the People]</char>: and he said unto him, I have prepared seven altars, and I have offered upon <char style="add">[every]</char> altar a bullock and a ram.</para>
  <para style="p">
    <verse number="5" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> put a word in Bil’am <char style="add">[Not of the People]</char>’s mouth, and said, Return unto Balak <char style="add">[Devastator]</char>, and thus you<char style="ord">i</char> shall speak.</para>
  <para style="p">
    <verse number="6" style="v" />And he returned unto him, and, lo, he stood by his burnt sacrifice, he, and all the princes of Mo’av <char style="add">[Seed of my Father]</char>.</para>
  <para style="p">
    <verse number="7" style="v" />And he took up his parable, and said, Balak <char style="add">[Devastator]</char> the king of Mo’av <char style="add">[Seed of my Father]</char> has brought me from Aram, out of the mountains of the east, <char style="add">[saying]</char>, Come, curse me Ya’akov <char style="add">[Heal of God]</char>, and come, defy Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="8" style="v" />How shall I curse, whom God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> has not cursed? or how shall I defy, <char style="add">[whom]</char> the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> has not defied?</para>
  <para style="p">
    <verse number="9" style="v" />For from the top of the rocks I see him, and from the hills I behold him: lo, the people shall dwell alone, and shall not be reckoned among the nations.</para>
  <para style="p">
    <verse number="10" style="v" />Who can count the dust of Ya’akov <char style="add">[Heal of God]</char>, and the number of the fourth <char style="add">[part]</char> of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>? Let me die the death of the righteous, and let my last end be like his!</para>
  <para style="p">
    <verse number="11" style="v" />And Balak <char style="add">[Devastator]</char> said unto Bil’am <char style="add">[Not of the People]</char>, What have you<char style="ord">i</char> done unto me? I took you<char style="ord">i</char> to curse my enemies, and, behold, you<char style="ord">i</char> have Blessed <char style="pn">(Favored by God; happy; prosperous)</char> <char style="add">[them]</char> altogether.</para>
  <para style="p">
    <verse number="12" style="v" />And he answered and said, Must I not take heed to speak that which the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> has put in my mouth?</para>
  <para style="p">
    <verse number="13" style="v" />And Balak <char style="add">[Devastator]</char> said unto him, Come, I pray you<char style="ord">i</char>, with me unto another place, from what place you<char style="ord">i</char> may see them: you<char style="ord">i</char> shall see but the utmost part of them, and shall not see them all: and curse me them from there.</para>
  <para style="p">
    <verse number="14" style="v" />And he brought him into the field of Tzofim <char style="add">[Watchers]</char>, to the top of Pisgah [Cleft <char style="pn">(split hoof; an opening, break or split)</char> Mountain Range], and built seven altars, and offered a bullock and a ram on <char style="add">[every]</char> altar.</para>
  <para style="p">
    <verse number="15" style="v" />And he said unto Balak <char style="add">[Devastator]</char>, Stand here by you<char style="ord">i</char> burnt offering, while I meet <char style="add">[the LORD-Yehōvah (Messiah Pre-Incarnate)]</char> yonder.</para>
  <para style="p">
    <verse number="16" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> met Bil’am <char style="add">[Not of the People]</char>, and put a word in his mouth, and said, Go again unto Balak <char style="add">[Devastator]</char>, and say thus.</para>
  <para style="p">
    <verse number="17" style="v" />And when he came to him, behold, he stood by his burnt offering, and the princes of Mo’av <char style="add">[Seed of my Father]</char> with him. And Balak <char style="add">[Devastator]</char> said unto him, What has the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoken?</para>
  <para style="p">
    <verse number="18" style="v" />And he took up his parable, and said, Rise up, Balak <char style="add">[Devastator]</char>, and hear; hearken unto me, you<char style="ord">i</char> son of Zippor <char style="add">[Sparrow]</char>:</para>
  <para style="p">
    <verse number="19" style="v" />God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered] [is]</char> not a man, that he should lie; neither the Son of man, that he should repent: has he said, and shall he not do <char style="add">[it]</char>? or has he spoken, and shall he not make it good?</para>
  <para style="p">
    <verse number="20" style="v" />Behold, I have received <char style="add">[commandment]</char> to bless: and he has Blessed <char style="pn">(Favored by God; happy; prosperous)</char>; and I cannot reverse it.</para>
  <para style="p">
    <verse number="21" style="v" />He has not beheld iniquity in Ya’akov <char style="add">[Heal of God]</char>, neither has he seen perverseness in Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>: the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> his God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered] [is]</char> with him, and the shout of a king <char style="add">[is]</char> among them.</para>
  <para style="p">
    <verse number="22" style="v" />God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> brought them out of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>; he has as it were the strength of an unicorn.</para>
  <para style="p">
    <verse number="23" style="v" />Surely <char style="add">[there is]</char> no enchantment against Ya’akov <char style="add">[Heal of God]</char>, neither <char style="add">[is there]</char> any divination against Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>: according to this time it shall be said of Ya’akov <char style="add">[Heal of God]</char> and of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, What has God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> wrought!</para>
  <para style="p">
    <verse number="24" style="v" />Behold, the people shall rise up as a great lion, and lift up himself as a young lion: he shall not lie down until he eat <char style="add">[of]</char> the prey, and drink the blood of the slain.</para>
  <para style="p">
    <verse number="25" style="v" />And Balak <char style="add">[Devastator]</char> said unto Bil’am <char style="add">[Not of the People]</char>, Neither curse them at all, nor bless them at all.</para>
  <para style="p">
    <verse number="26" style="v" />But Bil’am <char style="add">[Not of the People]</char> answered and said unto Balak <char style="add">[Devastator]</char>, Told not I you<char style="ord">i</char>, saying, All that the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> speaks, that I must do?</para>
  <para style="p">
    <verse number="27" style="v" />And Balak <char style="add">[Devastator]</char> said unto Bil’am <char style="add">[Not of the People]</char>, Come, I pray you<char style="ord">i</char>, I will bring you<char style="ord">i</char> unto another place; perhaps it will please God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> that you<char style="ord">i</char> may curse me them from there.</para>
  <para style="p">
    <verse number="28" style="v" />And Balak <char style="add">[Devastator]</char> brought Bil’am <char style="add">[Not of the People]</char> unto the top of P’or <char style="add">[Cleft (split hoof; an opening, break or split)]</char>, that looks toward Y’shim’on <char style="add">[Wasteland]</char>.</para>
  <para style="p">
    <verse number="29" style="v" />And Bil’am <char style="add">[Not of the People]</char> said unto Balak <char style="add">[Devastator]</char>, Build me here seven altars, and prepare me here seven bullocks and seven rams.</para>
  <para style="p">
    <verse number="30" style="v" />And Balak <char style="add">[Devastator]</char> did as Bil’am <char style="add">[Not of the People]</char> had said, and offered a bullock and a ram on <char style="add">[every]</char> altar.</para>
  <chapter number="24" style="c" />
  <para style="p">
    <verse number="1" style="v" />And when Bil’am <char style="add">[Not of the People]</char> saw that it pleased the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> to bless Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, he went not, as at other times, to seek for enchantments, but he set his face toward the wilderness.</para>
  <para style="p">
    <verse number="2" style="v" />And Bil’am <char style="add">[Not of the People]</char> lifted up his eyes, and he saw Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> abiding <char style="add">[in his tents]</char> according to their tribes; and the spirit of God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> came upon him.</para>
  <para style="p">
    <verse number="3" style="v" />And he took up his parable, and said, Bil’am <char style="add">[Not of the People]</char> the son of B’or <char style="add">[Burning]</char> has said, and the man whose eyes are open has said:</para>
  <para style="p">
    <verse number="4" style="v" />He has said, which heard the words of God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>, which saw the vision of the Almighty, falling <char style="add">[into a trance]</char>, but having his eyes open:</para>
  <para style="p">
    <verse number="5" style="v" />How goodly are you<char style="ord">i</char> tents, O Ya’akov <char style="add">[Heal of God]</char>, <char style="add">[and]</char> you<char style="ord">i</char> tabernacles, O Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>!</para>
  <para style="p">
    <verse number="6" style="v" />As the valleys are they spread forth, as gardens by the river’s side, as the trees of lign <char style="add">[brown]</char> aloes which the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> has planted, <char style="add">[and]</char> as cedar trees beside the waters.</para>
  <para style="p">
    <verse number="7" style="v" />He shall pour the water out of his buckets, and his seed <char style="add">[shall be]</char> in many waters, and his king shall be higher than Agag <char style="add">[Violent]</char>, and his kingdom shall be exalted.</para>
  <para style="p">
    <verse number="8" style="v" />God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> brought him forth out of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>; he has as it were the strength of an unicorn: he shall eat up the nations his enemies, and shall break their bones, and pierce <char style="add">[them]</char> through with his arrows.</para>
  <para style="p">
    <verse number="9" style="v" />He couched, he lay down as a lion, and as a great lion: who shall stir him up? Blessed <char style="pn">(Favored by God; happy; prosperous)</char> <char style="add">[is]</char> he that blesses you<char style="ord">i</char>, and cursed <char style="add">[is]</char> he that curses you<char style="ord">i</char>.</para>
  <para style="p">
    <verse number="10" style="v" />And Balak <char style="add">[Devastator]</char>’s anger was kindled against Bil’am <char style="add">[Not of the People]</char>, and he struck his hands together: and Balak <char style="add">[Devastator]</char> said unto Bil’am <char style="add">[Not of the People]</char>, I called you<char style="ord">i</char> to curse my enemies, and, behold, you<char style="ord">i</char> have altogether Blessed <char style="pn">(Favored by God; happy; prosperous)</char> <char style="add">[them]</char> these three times.</para>
  <para style="p">
    <verse number="11" style="v" />Therefore now flee you<char style="ord">i</char> to you<char style="ord">i</char> place: I thought to promote you<char style="ord">i</char> unto great honour; but, lo, the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> has kept you<char style="ord">i</char> back from honour.</para>
  <para style="p">
    <verse number="12" style="v" />And Bil’am <char style="add">[Not of the People]</char> said unto Balak <char style="add">[Devastator]</char>, Spoke I not also to you<char style="ord">i</char> messengers which you<char style="ord">i</char> sent unto me, saying,</para>
  <para style="p">
    <verse number="13" style="v" />If Balak <char style="add">[Devastator]</char> would give me his house full of silver and gold, I cannot go beyond the commandment of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, to do <char style="add">[either]</char> good or bad of my own mind; <char style="add">[but]</char> what the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> says, that will I speak?</para>
  <para style="p">
    <verse number="14" style="v" />And now, behold, I go unto my people: come <char style="add">[therefore, and]</char> I will advertise <char style="pn">(to advise, warn, inform, reveal)</char> you<char style="ord">i</char> what this people shall do to you<char style="ord">i</char> people in the latter days.</para>
  <para style="p">
    <verse number="15" style="v" />And he took up his parable, and said, Bil’am <char style="add">[Not of the People]</char> the son of B’or <char style="add">[Burning]</char> has said, and the man whose eyes are open has said:</para>
  <para style="p">
    <verse number="16" style="v" />He has said, which heard the words of God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>, and knew the knowledge of the most High, <char style="add">[which]</char> saw the vision of the Almighty, falling <char style="add">[into a trance]</char>, but having his eyes open:</para>
  <para style="p">
    <verse number="17" style="v" />I shall see him, but not now: I shall behold him, but not near: there shall come a Star out of Ya’akov <char style="add">[Heal of God]</char>, and a Sceptre shall rise out of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, and shall strike the corners of Mo’av <char style="add">[Seed of my Father]</char>, and destroy all the children of Shet <char style="add">[Compensation]</char>.</para>
  <para style="p">
    <verse number="18" style="v" />And Edom <char style="add">[Red]</char> shall be a possession, Se’ir <char style="add">[Shaggy]</char> also shall be a possession for his enemies; and Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> shall do valiantly.</para>
  <para style="p">
    <verse number="19" style="v" />Out of Ya’akov <char style="add">[Heal of God]</char> shall come he that shall have dominion, and shall destroy him that remains of the city.</para>
  <para style="p">
    <verse number="20" style="v" />And when he looked on ‘Amalek <char style="add">[Dweller in a Valley]</char>, he took up his parable, and said, ‘Amalek <char style="add">[Dweller in a Valley] [was]</char> the first of the nations; but his latter end <char style="add">[shall be]</char> that he perish forever.</para>
  <para style="p">
    <verse number="21" style="v" />And he looked on the Keini <char style="add">[traveling tinkers or blacksmiths]</char>, and took up his parable, and said, Strong is you<char style="ord">i</char> dwellingplace, and you<char style="ord">i</char> put your<char style="ord">i</char> nest in a rock.</para>
  <para style="p">
    <verse number="22" style="v" />Nevertheless the Kayin <char style="add">[Possession]</char> shall be wasted, until Ashur <char style="add">[A Level Plain]</char> shall carry you<char style="ord">i</char> away captive.</para>
  <para style="p">
    <verse number="23" style="v" />And he took up his parable, and said, Alas, who shall live when God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> does this!</para>
  <para style="p">
    <verse number="24" style="v" />And ships <char style="add">[shall come]</char> from the coast of Kittim <char style="add">[Bruisers]</char>, and shall afflict Ashur <char style="add">[A Level Plain]</char>, and shall afflict ‘Ever, and he also shall perish forever.</para>
  <para style="p">
    <verse number="25" style="v" />And Bil’am <char style="add">[Not of the People]</char> rose up, and went and returned to his place: and Balak <char style="add">[Devastator]</char> went his way.</para>
  <chapter number="25" style="c" />
  <para style="p">
    <verse number="1" style="v" />And Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> abode in Sheetim <char style="add">[The Acacias]</char>, and the people began to commit whoredom with the daughters of Mo’av <char style="add">[Seed of my Father]</char>.</para>
  <para style="p">
    <verse number="2" style="v" />And they called the people unto the sacrifices of their gods: and the people did eat, and bowed down to their gods.</para>
  <para style="p">
    <verse number="3" style="v" />And Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> joined himself unto Ba’al-P’or <char style="add">[Lord of the Opening]</char>: and the anger of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> was kindled against Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="4" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> said unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, Take all the heads of the people, and hang them up before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> against the sun, that the fierce anger of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> may be turned away from Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="5" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> said unto the of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, Slay you<char style="ord">2f</char> every one his men that were joined unto Ba’al-P’or <char style="add">[Lord of the Opening]</char>.</para>
  <para style="p">
    <verse number="6" style="v" />And, behold, one of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> came and brought unto his brethren a Midyani woman in the sight of Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, and in the sight of all the congregation of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, who <char style="add">[were]</char> weeping <char style="add">[before]</char> the door of the tabernacle of the congregation.</para>
  <para style="p">
    <verse number="7" style="v" />And when Pinchas <char style="add">[mouth of brass]</char>, the son of El’azar <char style="add">[God has helped]</char>, the son of Aharon <char style="add">[Bright, Very High]</char> the priest, saw <char style="add">[it]</char>, he rose up from among the congregation, and took a javelin in his hand;</para>
  <para style="p">
    <verse number="8" style="v" />And he went after the man of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> into the tent, and thrust both of them through, the man of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, and the woman through her belly. So the plague was detained <char style="pn">(held)</char> from the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="9" style="v" />And those that died in the plague were twenty and four thousand.</para>
  <para style="p">
    <verse number="10" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="11" style="v" />Pinchas <char style="add">[mouth of brass]</char>, the son of El’azar <char style="add">[God has helped]</char>, the son of Aharon <char style="add">[Bright, Very High]</char> the priest, has turned my wrath away from the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, while he was zealous for my sake among them, that I consumed not the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> in my jealousy.</para>
  <para style="p">
    <verse number="12" style="v" />For what reason say, Behold, I give unto him my covenant of peace:</para>
  <para style="p">
    <verse number="13" style="v" />And he shall have it, and his seed after him, <char style="add">[even]</char> the covenant of an everlasting priesthood; because he was zealous for his God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>, and made an atonement for the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="14" style="v" />Now the name of the Israeli that was slain, <char style="add">[even]</char> that was slain with the Midyani woman, <char style="add">[was]</char> Zimri <char style="add">[My Music]</char>, the son of Salu <char style="add">[Weighted]</char>, a prince of a chief house among the Shimoni.</para>
  <para style="p">
    <verse number="15" style="v" />And the name of the Midyani woman that was slain <char style="add">[was]</char> Kozbi <char style="add">[My Lie]</char>, the daughter of Tzur <char style="add">[Rock]</char>; he <char style="add">[was]</char> head over a people, <char style="add">[and]</char> of a chief house in Midyan <char style="add">[Strife]</char>.</para>
  <para style="p">
    <verse number="16" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="17" style="v" />Vex the Midyanim <char style="add">[Strife]</char>, and strike them:</para>
  <para style="p">
    <verse number="18" style="v" />For they vex you with their wiles, which they have beguiled you in the matter of P’or <char style="pn">[Cleft (split hoof; an opening, break or split)]</char>, and in the matter of Kozbi <char style="add">[My Lie]</char>, the daughter of a prince of Midyan <char style="add">[Strife]</char>, their sister, which was slain in the day of the plague for P’or <char style="pn">[Cleft (split hoof; an opening, break or split)]</char>’s sake.</para>
  <chapter number="26" style="c" />
  <para style="p">
    <verse number="1" style="v" />And it came to pass after the plague, that the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and unto El’azar <char style="add">[God has helped]</char> the son of Aharon <char style="add">[Bright, Very High]</char> the priest, saying,</para>
  <para style="p">
    <verse number="2" style="v" />Take the sum of all the congregation of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, from twenty years old and upward, throughout their fathers’ house, all that are able to go to war in Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="3" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and El’azar <char style="add">[God has helped]</char> the priest spoke with them in the plains of Mo’av <char style="add">[Seed of my Father]</char> by Yarden <char style="add">[Descender] [near]</char> Yericho <char style="add">[Its Moon]</char>, saying,</para>
  <para style="p">
    <verse number="4" style="v" />
    <char style="add">[Take the sum of the people]</char>, from twenty years old and upward; as the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, which went forth out of the land of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>.</para>
  <para style="p">
    <verse number="5" style="v" />Re’uven <char style="add">[Behold a Son]</char>, the eldest son of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>: the children of Re’uven <char style="add">[Behold a Son]</char>; Hanokh <char style="add">[Dedicated]</char>, <char style="add">[of whom comes]</char> the family of the Hanokhi <char style="add">[Dedicated]</char>: of Pallu <char style="add">[Distinguished]</char>, the family of the Pallui <char style="add">[Distinguished Ones]</char>:</para>
  <para style="p">
    <verse number="6" style="v" />Of Hetzron <char style="add">[surrounded by a wall]</char>, the family of the Hetzroni: of Karmi <char style="add">[Fruitful, Noble]</char>, the family of the Karmi.</para>
  <para style="p">
    <verse number="7" style="v" />These <char style="add">[are]</char> the families of the Re’uveni <char style="add">[behold, a son!]</char>: and they that were numbered of them were forty and three thousand and seven hundred and thirty.</para>
  <para style="p">
    <verse number="8" style="v" />And the sons of Pallu <char style="add">[Distinguished]</char>; ‘Eli’av <char style="add">[My Father is God]</char>.</para>
  <para style="p">
    <verse number="9" style="v" />And the sons of ‘Eli’av <char style="add">[My Father is God]</char>; N’mu’el <char style="add">[Day of God]</char>, and Datan <char style="add">[belonging to a fountain]</char>, and Aviram <char style="add">[My Father is Exalted]</char>. This <char style="add">[is that]</char> Datan <char style="add">[belonging to a fountain]</char> and Aviram <char style="add">[My Father is Exalted]</char>, <char style="add">[which were]</char> famous in the congregation, who strove against Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and against Aharon <char style="add">[Bright, Very High]</char> in the company of Korakh <char style="add">[Bald]</char>, when they strove against the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>:</para>
  <para style="p">
    <verse number="10" style="v" />And the earth opened her mouth, and swallow (to approve, commend, accept)ed them up together with Korakh <char style="add">[Bald]</char>, when that company died, what time the fire devoured two hundred and fifty men: and they became a sign.</para>
  <para style="p">
    <verse number="11" style="v" />Yet the children of Korakh <char style="add">[Bald]</char> died not.</para>
  <para style="p">
    <verse number="12" style="v" />The sons of Shim’on <char style="add">[he who hears]</char> after their families: of N’mu’el <char style="add">[Day of God]</char>, the family of the N’mu’eli: of Yamin <char style="add">[Right Hand]</char>, the family of the Yamini: of Yakhin <char style="add">[He will establish]</char>, the family of the Yakhini:</para>
  <para style="p">
    <verse number="13" style="v" />Of Zerach <char style="add">[Rising]</char>, the family of the Zarchi: of Sha’ul <char style="add">[Desired]</char>, the family of the Sha’uli.</para>
  <para style="p">
    <verse number="14" style="v" />These <char style="add">[are]</char> the families of the Shimoni, twenty and two thousand and two hundred.</para>
  <para style="p">
    <verse number="15" style="v" />The children of Gad <char style="add">[Good Fortune with Troublesome Effort]</char> after their families: of Tz’fon <char style="add">[Treasure]</char>, the family of the Tz’foni: of Haggi <char style="add">[Festive]</char>, the family of the Haggi: of Shuni <char style="add">[Fortunate]</char>, the family of the Shuni:</para>
  <para style="p">
    <verse number="16" style="v" />Of Ozni <char style="add">[My Hearing]</char>, the family of the Ozni <char style="add">[My Hearing]</char>: of ‘Eri <char style="add">[Watchful]</char>, the family of the ‘Eri:</para>
  <para style="p">
    <verse number="17" style="v" />Of Arod, the family of the Arodi <char style="add">[I Shall Subdue]</char>: of Ar’eli, the family of the Ar’eli.</para>
  <para style="p">
    <verse number="18" style="v" />These <char style="add">[are]</char> the families of the children of Gad <char style="add">[Good Fortune with Troublesome Effort]</char> according to those that were numbered of them, forty thousand and five hundred.</para>
  <para style="p">
    <verse number="19" style="v" />The sons of Y’hudah <char style="add">[Let Him (God) Be Praised] [were]</char> Er and Onan: and Er and Onan died in the land of Kena’an <char style="add">[Merchant]</char>.</para>
  <para style="p">
    <verse number="20" style="v" />And the sons of Y’hudah <char style="add">[Let Him (God) Be Praised]</char> after their families were; of Shelah <char style="add">[A Petition]</char>, the family of the Shelani: of Partzi <char style="add">[Breach (breaking forth; a break; opening, inlet)]</char>, the family of the Partzi: of Zerach <char style="add">[Rising]</char>, the family of the Zarchi.</para>
  <para style="p">
    <verse number="21" style="v" />And the sons of Partzi <char style="add">[Breach (breaking forth; a break; opening, inlet)]</char> were; of Hetzron <char style="add">[surrounded by a wall]</char>, the family of the Hetzroni: of Hamul <char style="add">[Spared]</char>, the family of the Hamuli.</para>
  <para style="p">
    <verse number="22" style="v" />These <char style="add">[are]</char> the families of Y’hudah <char style="add">[Let Him (God) Be Praised]</char> according to those that were numbered of them, threescore and sixteen thousand and five hundred.</para>
  <para style="p">
    <verse number="23" style="v" />
    <char style="add">[Of]</char> the sons of Yissakhar <char style="add">[There Is Recompense]</char> after their families: <char style="add">[of]</char> Tola <char style="add">[Worm]</char>, the family of the Tola’i: of Puvah <char style="add">[Splendid]</char>, the family of the Puni:</para>
  <para style="p">
    <verse number="24" style="v" />Of Yashuv <char style="add">[He Will Return]</char>, the family of the Yashuvi: of Shimron <char style="add">[Watch-Height]</char>, the family of the Shimroni.</para>
  <para style="p">
    <verse number="25" style="v" />These <char style="add">[are]</char> the families of Yissakhar <char style="add">[There Is Recompense]</char> according to those that were numbered of them, threescore and four thousand and three hundred.</para>
  <para style="p">
    <verse number="26" style="v" />
    <char style="add">[Of]</char> the sons of Z’vulun <char style="add">[Glorious Dwelling Place]</char> after their families: of Sered <char style="add">[Fear]</char>, the family of the Sardi: of Elon <char style="add">[Mighty]</char>, the family of the Eloni: of Yachle’el <char style="add">[God Waits]</char>, the family of the Yachle’eli.</para>
  <para style="p">
    <verse number="27" style="v" />These <char style="add">[are]</char> the families of the Z’vuloni according to those that were numbered of them, threescore thousand and five hundred.</para>
  <para style="p">
    <verse number="28" style="v" />The sons of Yosef <char style="add">[(God) He Shall Add]</char> after their families <char style="add">[were]</char> M’nasheh <char style="add">[Causing to Forget]</char> and Efrayim <char style="add">[Doubly Fruitful]</char>.</para>
  <para style="p">
    <verse number="29" style="v" />Of the sons of M’nasheh <char style="add">[Causing to Forget]</char>: of Makhir <char style="add">[Sold]</char>, the family of the Makhiri: and Makhir <char style="add">[Sold]</char> begat <char style="pn">(to be father of; be ancestor of)</char> Gil’ad <char style="add">[Rocky Region]</char>: of Gil’ad <char style="add">[Rocky Region] [come]</char> the family of the Gil’adi.</para>
  <para style="p">
    <verse number="30" style="v" />These <char style="add">[are]</char> the sons of Gil’ad <char style="add">[Rocky Region]</char>: <char style="add">[of]</char> Ee’ezr <char style="add">[No Help]</char>, the family of the Ee’ezri: of Helek <char style="add">[Portion]</char>, the family of the Helki:</para>
  <para style="p">
    <verse number="31" style="v" />And <char style="add">[of]</char> Asri’el <char style="add">[I Shall Be a Prince with God]</char>, the family of the Asri’eli: and <char style="add">[of]</char> Sh’khem <char style="add">[Shoulder]</char>, the family of the Shikhmi:</para>
  <para style="p">
    <verse number="32" style="v" />And <char style="add">[of]</char> Sh’mida <char style="add">[Wise]</char>, the family of the Shemida’i: and <char style="add">[of]</char> Hefer <char style="add">[A Well]</char>, the family of the Hefri.</para>
  <para style="p">
    <verse number="33" style="v" />And Tz’lof’chad <char style="add">[First-Born]</char> the son of Hefer <char style="add">[A Well]</char> had no sons, but daughters: and the names of the daughters of Tz’lof’chad <char style="add">[First-Born] [were]</char> Machlah <char style="add">[Disease]</char>, and No’ah <char style="add">[Motion]</char>, Hoglah <char style="add">[Partidge]</char>, Machlah <char style="add">[Queen]</char>, and Tirtzah <char style="add">[Favourable]</char>.</para>
  <para style="p">
    <verse number="34" style="v" />These <char style="add">[are]</char> the families of M’nasheh <char style="add">[Causing to Forget]</char>, and those that were numbered of them, fifty and two thousand and seven hundred.</para>
  <para style="p">
    <verse number="35" style="v" />These <char style="add">[are]</char> the sons of Efrayim <char style="add">[Doubly Fruitful]</char> after their families: of Shutelach <char style="add">[Noise of Breaking]</char>, the family of the Shutelachi: of Bakher <char style="add">[Young Camel]</char>, the family of the Bakhri: of Tachan <char style="add">[Camp]</char>, the family of the Tachani.</para>
  <para style="p">
    <verse number="36" style="v" />And these <char style="add">[are]</char> the sons of Shutelach <char style="add">[Noise of Breaking]</char>: of ‘Eran <char style="add">[Watcher]</char>, the family of the ‘Erani.</para>
  <para style="p">
    <verse number="37" style="v" />These <char style="add">[are]</char> the families of the sons of Efrayim <char style="add">[Doubly Fruitful]</char> according to those that were numbered of them, thirty and two thousand and five hundred. These <char style="add">[are]</char> the sons of Yosef <char style="add">[(God) He Shall Add]</char> after their families.</para>
  <para style="p">
    <verse number="38" style="v" />The sons of Binyamin <char style="add">[Son of the Right Hand/Strength]</char> after their families: of Bela <char style="add">[Destruction]</char>, the family of the Bela’i: of Ashbel <char style="add">[Fire of Bel]</char>, the family of the Ashbeli: of Achiram <char style="add">[Brother of Mother]</char>, the family of the Achirai <char style="add">[Brother of Mother]</char>:</para>
  <para style="p">
    <verse number="39" style="v" />Of Sh’fufam <char style="add">[Serpent]</char>, the family of the Shufami: of Hufam <char style="add">[Coast-man]</char>, the family of the Hufami.</para>
  <para style="p">
    <verse number="40" style="v" />And the sons of Bela <char style="add">[Destruction]</char> were Ard <char style="add">[I shall Subdue]</char> and Na’aman <char style="add">[Pleasantness]</char>: [of Ard <char style="add">[I shall Subdue]</char>], the family of the Ardi: <char style="add">[and]</char> of Na’aman <char style="add">[Pleasantness]</char>, the family of the Na’ami.</para>
  <para style="p">
    <verse number="41" style="v" />These <char style="add">[are]</char> the sons of Binyamin <char style="add">[Son of the Right Hand/Strength]</char> after their families: and they that were numbered of them <char style="add">[were]</char> forty and five thousand and six hundred.</para>
  <para style="p">
    <verse number="42" style="v" />These <char style="add">[are]</char> the sons of Dan <char style="add">[Judge]</char> after their families: of Shucham <char style="add">[Pit-digger]</char>, the family of the Shuchami. These <char style="add">[are]</char> the families of Dan <char style="add">[Judge]</char> after their families.</para>
  <para style="p">
    <verse number="43" style="v" />All the families of the Shuchami, according to those that were numbered of them, <char style="add">[were]</char> threescore and four thousand and four hundred.</para>
  <para style="p">
    <verse number="44" style="v" />
    <char style="add">[Of]</char> the children of Asher <char style="add">[Happy]</char> after their families: of Yimnah <char style="add">[Right Hand]</char>, the family of the Yimnah: of Yishvi <char style="add">[He Resembles Me]</char>, the family of the Yishvi: of B’ri’i <char style="add">[With a Friend]</char>, the family of the B’ri’i.</para>
  <para style="p">
    <verse number="45" style="v" />Of the sons of B’ri’i <char style="add">[With a Friend]</char>: of Hever <char style="add">[Friend/Comrade]</char>, the family of the Hevri: of Malki’el <char style="add">[My King is God]</char>, the family of the Malki’eli.</para>
  <para style="p">
    <verse number="46" style="v" />And the name of the daughter of Asher <char style="add">[Happy] [was]</char> Serach <char style="add">[The Prince Breathed]</char>.</para>
  <para style="p">
    <verse number="47" style="v" />These <char style="add">[are]</char> the families of the sons of Asher <char style="add">[Happy]</char> according to those that were numbered of them; <char style="add">[who were]</char> fifty and three thousand and four hundred.</para>
  <para style="p">
    <verse number="48" style="v" />
    <char style="add">[Of]</char> the sons of Naftali <char style="add">[My Wrestling]</char> after their families: of Yachtze’el <char style="add">[God Divides]</char>, the family of the Yachtze’eli: of Guni <char style="add">[My Defender]</char>, the family of the Guni:</para>
  <para style="p">
    <verse number="49" style="v" />Of Yitzer <char style="add">[Forming]</char>, the family of the Yetzri: of Shillem <char style="add">[Repaid]</char>, the family of the Shillemi.</para>
  <para style="p">
    <verse number="50" style="v" />These <char style="add">[are]</char> the families of Naftali <char style="add">[My Wrestling]</char> according to their families: and they that were numbered of them <char style="add">[were]</char> forty and five thousand and four hundred.</para>
  <para style="p">
    <verse number="51" style="v" />These <char style="add">[were]</char> the numbered of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, six hundred thousand and a thousand seven hundred and thirty.</para>
  <para style="p">
    <verse number="52" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="53" style="v" />Unto these the land shall be divided for an inheritance according to the number of names.</para>
  <para style="p">
    <verse number="54" style="v" />To many you<char style="ord">i</char> shall give the more inheritance, and to few you<char style="ord">i</char> shall give the less inheritance: to every one shall his inheritance be given according to those that were numbered of him.</para>
  <para style="p">
    <verse number="55" style="v" />Yet the land shall be divided by lot: according to the names of the tribes of their fathers they shall inherit.</para>
  <para style="p">
    <verse number="56" style="v" />According to the lot shall the possession thereof be divided between many and few.</para>
  <para style="p">
    <verse number="57" style="v" />And these <char style="add">[are]</char> they that were numbered of the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> after their families: of Gershon <char style="add">[Exile]</char>, the family of the Gershuni <char style="add">[Exiled Ones]</char>: of K’hat <char style="add">[assembly, congregation]</char>, the family of the K’hati: of M’rari <char style="add">[Bitter]</char>, the family of the M’rari.</para>
  <para style="p">
    <verse number="58" style="v" />These <char style="add">[are]</char> the families of the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char>: the family of the Livni <char style="add">[White Ones]</char>, the family of the Khevroni, the family of the Machli, the family of the Mushi, the family of the Korchi. And K’hat <char style="add">[assembly, congregation]</char> begat <char style="pn">(to be father of; be ancestor of)</char> ‘Amram <char style="add">[exalted people]</char>.</para>
  <para style="p">
    <verse number="59" style="v" />And the name of ‘Amram <char style="add">[exalted people]</char>’s wife <char style="add">[was]</char> Yokheved <char style="add">[Jehovah is Glory]</char>, the daughter of Levi <char style="pn">(Levite)</char> <char style="add">[Adhesion, Joiner]</char>, whom <char style="add">[her mother]</char> bore to Levi <char style="pn">(Levite)</char> <char style="add">[Adhesion, Joiner]</char> in Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>: and she bore unto ‘Amram <char style="add">[exalted people]</char> Aharon <char style="add">[Bright, Very High]</char> and Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, and Miryam <char style="add">[rebellion]</char> their sister.</para>
  <para style="p">
    <verse number="60" style="v" />And unto Aharon <char style="add">[Bright, Very High]</char> was born Nadav <char style="add">[Generous]</char>, and Avihu <char style="add">[he is my father]</char>, El’azar <char style="add">[God has helped]</char>, and Itamar <char style="add">[Coast of Palms]</char>.</para>
  <para style="p">
    <verse number="61" style="v" />And Nadav <char style="add">[Generous]</char> and Avihu <char style="add">[he is my father]</char> died, when they offered strange fire before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="62" style="v" />And those that were numbered of them were twenty and three thousand, all males from a month old and upward: for they were not numbered among the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, because there was no inheritance given them among the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="63" style="v" />These <char style="add">[are]</char> they that were numbered by Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and El’azar <char style="add">[God has helped]</char> the priest, who numbered the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> in the plains of Mo’av <char style="add">[Seed of my Father]</char> by Yarden <char style="add">[Descender] [near]</char> Yericho <char style="add">[Its Moon]</char>.</para>
  <para style="p">
    <verse number="64" style="v" />But among these there was not a man of them whom Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and Aharon <char style="add">[Bright, Very High]</char> the priest numbered, when they numbered the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> in the wilderness of Sinai.</para>
  <para style="p">
    <verse number="65" style="v" />For the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> had said of them, They shall surely die in the wilderness. And there was not left a man of them, save Kalev <char style="add">[Dog]</char> the son of Y’funeh <char style="add">[He Will Face]</char>, and Y’hoshua <char style="add">[Yehovah is Salvation]</char> the son of Nun <char style="add">[Posterity]</char>.</para>
  <chapter number="27" style="c" />
  <para style="p">
    <verse number="1" style="v" />Then came the daughters of Tz’lof’chad <char style="add">[First-Born]</char>, the son of Hefer <char style="add">[A Well]</char>, the son of Gil’ad <char style="add">[Rocky Region]</char>, the son of Makhir <char style="add">[Sold]</char>, the son of M’nasheh <char style="add">[Causing to Forget]</char>, of the families of M’nasheh <char style="add">[Causing to Forget]</char> the son of Yosef <char style="add">[(God) He Shall Add]</char>: and these <char style="add">[are]</char> the names of his daughters; Machlah <char style="add">[Disease]</char>, No’ah <char style="add">[Motion]</char>, and Hoglah <char style="add">[Partidge]</char>, and Machlah <char style="add">[Queen]</char>, and Tirtzah <char style="add">[Favorable]</char>.</para>
  <para style="p">
    <verse number="2" style="v" />And they stood before Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, and before El’azar <char style="add">[God has helped]</char> the priest, and before the princes and all the congregation, <char style="add">[by]</char> the door of the tabernacle of the congregation, saying,</para>
  <para style="p">
    <verse number="3" style="v" />Our father died in the wilderness, and he was not in the company of them that gathered themselves together against the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> in the company of Korakh <char style="add">[Bald]</char>; but died in his own sin, and had no sons.</para>
  <para style="p">
    <verse number="4" style="v" />Why should the name of our father be done away from among his family, because he has no son? Give unto us <char style="add">[therefore]</char> a possession among the brethren of our father.</para>
  <para style="p">
    <verse number="5" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> brought their cause before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="6" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="7" style="v" />The daughters of Tz’lof’chad <char style="add">[First-Born]</char> speak right: you<char style="ord">i</char> shall surely give them a possession of an inheritance among their father’s brethren; and you<char style="ord">i</char> shall cause the inheritance of their father to pass unto them.</para>
  <para style="p">
    <verse number="8" style="v" />And you<char style="ord">i</char> shall speak unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, saying, If a man die, and have no son, then you<char style="ord">2f</char> shall cause his inheritance to pass unto his daughter.</para>
  <para style="p">
    <verse number="9" style="v" />And if he have no daughter, then you<char style="ord">2f</char> shall give his inheritance unto his brethren.</para>
  <para style="p">
    <verse number="10" style="v" />And if he have no brethren, then you<char style="ord">2f</char> shall give his inheritance unto his father’s brethren.</para>
  <para style="p">
    <verse number="11" style="v" />And if his father have no brethren, then you<char style="ord">2f</char> shall give his inheritance unto his kinsman that is next to him of his family, and he shall possess it: and it shall be unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> a statute of judgment, as the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded Moshe <char style="add">[He Who Draws Out Of The Waters]</char>.</para>
  <para style="p">
    <verse number="12" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> said unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, Get you<char style="ord">i</char> up into this mount ‘Avarim <char style="add">[Regions Beyond]</char>, and see the land which I have given unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="13" style="v" />And when you<char style="ord">i</char> have seen it, you<char style="ord">i</char> also shall be gathered unto you<char style="ord">i</char> people, as Aharon <char style="add">[Bright, Very High]</char> you<char style="ord">i</char> brother was gathered.</para>
  <para style="p">
    <verse number="14" style="v" />For you<char style="ord">2f</char> rebelled against my commandment in the desert of Tzin <char style="add">[Flat]</char>, in the strife of the congregation, to sanctify <char style="pn">(make holy; set apart for God’s use)</char> me at the water before their eyes: that <char style="add">[is]</char> the water of M’rivah <char style="add">[Arguing]</char> in Kadesh <char style="add">[Holy]</char> in the wilderness of Tzin <char style="add">[Flat]</char>.</para>
  <para style="p">
    <verse number="15" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> spoke unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, saying,</para>
  <para style="p">
    <verse number="16" style="v" />Let the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, the God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> of the spirits of all flesh, set a man over the congregation,</para>
  <para style="p">
    <verse number="17" style="v" />Which may go out before them, and which may go in before them, and which may lead them out, and which may bring them in; that the congregation of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> be not as sheep which have no shepherd.</para>
  <para style="p">
    <verse number="18" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> said unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, Take you<char style="ord">i</char> Y’hoshua <char style="add">[Yehovah is Salvation]</char> the son of Nun <char style="add">[Posterity]</char>, a man in whom <char style="add">[is]</char> the spirit, and lay you<char style="ord">i</char> hand upon him;</para>
  <para style="p">
    <verse number="19" style="v" />And set him before El’azar <char style="add">[God has helped]</char> the priest, and before all the congregation; and give him a charge in their sight.</para>
  <para style="p">
    <verse number="20" style="v" />And you<char style="ord">i</char> shall put <char style="add">[some]</char> of you<char style="ord">i</char> honour upon him, that all the congregation of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> may be obedient.</para>
  <para style="p">
    <verse number="21" style="v" />And he shall stand before El’azar <char style="add">[God has helped]</char> the priest, who shall ask <char style="add">[counsel]</char> for him after the judgment of Urim <char style="add">[Lights]</char> before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>: at his word shall they go out, and at his word they shall come in, <char style="add">[both]</char> he, and all the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> with him, even all the congregation.</para>
  <para style="p">
    <verse number="22" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> did as the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded him: and he took Y’hoshua <char style="add">[Yehovah is Salvation]</char>, and set him before El’azar <char style="add">[God has helped]</char> the priest, and before all the congregation:</para>
  <para style="p">
    <verse number="23" style="v" />And he laid his hands upon him, and gave him a charge, as the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded by the hand of Moshe <char style="add">[He Who Draws Out Of The Waters]</char>.</para>
  <chapter number="28" style="c" />
  <para style="p">
    <verse number="1" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="2" style="v" />Command the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, and say unto them, My offering, <char style="add">[and]</char> my bread for my sacrifices made by fire, <char style="add">[for]</char> a soothing aroma unto me, shall you<char style="ord">2f</char> observe to offer unto me in their due season.</para>
  <para style="p">
    <verse number="3" style="v" />And you<char style="ord">i</char> shall say unto them, This <char style="add">[is]</char> the offering made by fire which you<char style="ord">2f</char> shall offer unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>; two lambs of the first year without spot day by day, <char style="add">[for]</char> a continual burnt offering.</para>
  <para style="p">
    <verse number="4" style="v" />The one lamb shall you<char style="ord">i</char> offer in the morning, and the other lamb shall you<char style="ord">i</char> offer at even;</para>
  <para style="p">
    <verse number="5" style="v" />And a tenth <char style="add">[part]</char> of an eifah of flour for a meat offering, mingled with the fourth <char style="add">[part]</char> of an hin <char style="add">[a quart]</char> of beaten oil.</para>
  <para style="p">
    <verse number="6" style="v" />
    <char style="add">[It is]</char> a continual burnt offering, which was ordained in mount Sinai for a soothing aroma, a sacrifice made by fire unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="7" style="v" />And the drink offering thereof <char style="add">[shall be]</char> the fourth <char style="add">[part]</char> of an hin <char style="add">[a quart]</char> for the one lamb: in the holy <char style="add">[place]</char> shall you<char style="ord">i</char> cause the strong wine to be poured unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> <char style="add">[for]</char> a drink offering.</para>
  <para style="p">
    <verse number="8" style="v" />And the other lamb shall you<char style="ord">i</char> offer at even: as the meat offering of the morning, and as the drink offering thereof, you<char style="ord">i</char> shall offer <char style="add">[it]</char>, a sacrifice made by fire, of a soothing aroma unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="9" style="v" />And on the Shabbat <char style="add">[Rest]</char> day two lambs of the first year without spot, and two tenth deals of flour <char style="add">[for]</char> a meat offering, mingled with oil, and the drink offering thereof:</para>
  <para style="p">
    <verse number="10" style="v" />
    <char style="add">[This is]</char> the burnt offering of every Shabbat <char style="add">[Rest]</char>, beside the continual burnt offering, and his drink offering.</para>
  <para style="p">
    <verse number="11" style="v" />And in the beginnings of your months you<char style="ord">2f</char> shall offer a burnt offering unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>; two young bullocks, and one ram, seven lambs of the first year without spot;</para>
  <para style="p">
    <verse number="12" style="v" />And three tenth deals of flour <char style="add">[for]</char> a meat offering, mingled with oil, for one bullock; and two tenth deals of flour <char style="add">[for]</char> a meat offering, mingled with oil, for one ram;</para>
  <para style="p">
    <verse number="13" style="v" />And a several tenth deal of flour mingled with oil <char style="add">[for]</char> a meat offering unto one lamb; <char style="add">[for]</char> a burnt offering of a soothing aroma, a sacrifice made by fire unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="14" style="v" />And their drink offerings shall be half an hin <char style="add">[a quart]</char> of wine unto a bullock, and the third <char style="add">[part]</char> of an hin <char style="add">[a quart]</char> unto a ram, and a fourth <char style="add">[part]</char> of an hin <char style="add">[a quart]</char> unto a lamb: this <char style="add">[is]</char> the burnt offering of every month throughout the months of the year.</para>
  <para style="p">
    <verse number="15" style="v" />And one kid of the goats for a sin offering unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> shall be offered, beside the continual burnt offering, and his drink offering.</para>
  <para style="p">
    <verse number="16" style="v" />And in the fourteenth day of the first month <char style="add">[is]</char> the Passover of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="17" style="v" />And in the fifteenth day of this month <char style="add">[is]</char> the feast: seven days shall unleavened bread be eaten.</para>
  <para style="p">
    <verse number="18" style="v" />In the first day <char style="add">[shall be]</char> an holy convocation; you<char style="ord">2f</char> shall do no manner of servile work <char style="add">[in it]</char>:</para>
  <para style="p">
    <verse number="19" style="v" />But you<char style="ord">2f</char> shall offer a sacrifice made by fire <char style="add">[for]</char> a burnt offering unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>; two young bullocks, and one ram, and seven lambs of the first year: they shall be unto you without blemish:</para>
  <para style="p">
    <verse number="20" style="v" />And their meat offering <char style="add">[shall be of]</char> flour mingled with oil: three tenth deals shall you<char style="ord">2f</char> offer for a bullock, and two tenth deals for a ram;</para>
  <para style="p">
    <verse number="21" style="v" />A several tenth deal shall you<char style="ord">i</char> offer for every lamb, throughout the seven lambs:</para>
  <para style="p">
    <verse number="22" style="v" />And one goat <char style="add">[for]</char> a sin offering, to make an atonement for you.</para>
  <para style="p">
    <verse number="23" style="v" />You<char style="ord">2f</char> shall offer these beside the burnt offering in the morning, which <char style="add">[is]</char> for a continual burnt offering.</para>
  <para style="p">
    <verse number="24" style="v" />After this manner you<char style="ord">2f</char> shall offer daily, throughout the seven days, the meat of the sacrifice made by fire, of a soothing aroma unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>: it shall be offered beside the continual burnt offering, and his drink offering.</para>
  <para style="p">
    <verse number="25" style="v" />And on the seventh day you<char style="ord">2f</char> shall have an holy convocation; you<char style="ord">2f</char> shall do no servile work.</para>
  <para style="p">
    <verse number="26" style="v" />Also in the day of the firstfruits, when you<char style="ord">2f</char> bring a new meat offering unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, after your weeks <char style="add">[be out]</char>, you<char style="ord">2f</char> shall have an holy convocation; you<char style="ord">2f</char> shall do no servile work:</para>
  <para style="p">
    <verse number="27" style="v" />But you<char style="ord">2f</char> shall offer the burnt offering for a soothing aroma unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>; two young bullocks, one ram, seven lambs of the first year;</para>
  <para style="p">
    <verse number="28" style="v" />And their meat offering of flour mingled with oil, three tenth deals unto one bullock, two tenth deals unto one ram,</para>
  <para style="p">
    <verse number="29" style="v" />A several tenth deal unto one lamb, throughout the seven lambs;</para>
  <para style="p">
    <verse number="30" style="v" />
    <char style="add">[And]</char> one kid of the goats, to make an atonement for you.</para>
  <para style="p">
    <verse number="31" style="v" />You<char style="ord">2f</char> shall offer <char style="add">[them]</char> beside the continual burnt offering, and his meat offering, <char style="pn">(they shall be unto you without blemish)</char> and their drink offerings.</para>
  <chapter number="29" style="c" />
  <para style="p">
    <verse number="1" style="v" />And in the seventh month, on the first <char style="add">[day]</char> of the month, you<char style="ord">2f</char> shall have an holy convocation; you<char style="ord">2f</char> shall do no servile work: it is a day of blowing the trumpets unto you.</para>
  <para style="p">
    <verse number="2" style="v" />And you<char style="ord">2f</char> shall offer a burnt offering for a soothing aroma unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>; one young bullock, one ram, <char style="add">[and]</char> seven lambs of the first year without blemish:</para>
  <para style="p">
    <verse number="3" style="v" />And their meat offering <char style="add">[shall be of]</char> flour mingled with oil, three tenth deals for a bullock, <char style="add">[and]</char> two tenth deals for a ram,</para>
  <para style="p">
    <verse number="4" style="v" />And one tenth deal for one lamb, throughout the seven lambs:</para>
  <para style="p">
    <verse number="5" style="v" />And one kid of the goats <char style="add">[for]</char> a sin offering, to make an atonement for you:</para>
  <para style="p">
    <verse number="6" style="v" />Beside the burnt offering of the month, and his meat offering, and the daily burnt offering, and his meat offering, and their drink offerings, according unto their manner, for a soothing aroma, a sacrifice made by fire unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="7" style="v" />And you<char style="ord">2f</char> shall have on the tenth <char style="add">[day]</char> of this seventh month an holy convocation; and you<char style="ord">2f</char> shall afflict your souls: you<char style="ord">2f</char> shall not do any work <char style="add">[in it]</char>:</para>
  <para style="p">
    <verse number="8" style="v" />But you<char style="ord">2f</char> shall offer a burnt offering unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> <char style="add">[for]</char> a soothing aroma; one young bullock, one ram, <char style="add">[and]</char> seven lambs of the first year; they shall be unto you without blemish:</para>
  <para style="p">
    <verse number="9" style="v" />And their meat offering <char style="add">[shall be of]</char> flour mingled with oil, three tenth deals to a bullock, <char style="add">[and]</char> two tenth deals to one ram,</para>
  <para style="p">
    <verse number="10" style="v" />A several tenth deal for one lamb, throughout the seven lambs:</para>
  <para style="p">
    <verse number="11" style="v" />One kid of the goats <char style="add">[for]</char> a sin offering; beside the sin offering of atonement, and the continual burnt offering, and the meat offering of it, and their drink offerings.</para>
  <para style="p">
    <verse number="12" style="v" />And on the fifteenth day of the seventh month you<char style="ord">2f</char> shall have an holy convocation; you<char style="ord">2f</char> shall do no servile work, and you<char style="ord">2f</char> shall keep a feast unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> seven days:</para>
  <para style="p">
    <verse number="13" style="v" />And you<char style="ord">2f</char> shall offer a burnt offering, a sacrifice made by fire, of a soothing aroma unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>; thirteen young bullocks, two rams, <char style="add">[and]</char> fourteen lambs of the first year; they shall be without blemish:</para>
  <para style="p">
    <verse number="14" style="v" />And their meat offering <char style="add">[shall be of]</char> flour mingled with oil, three tenth deals unto every bullock of the thirteen bullocks, two tenth deals to each ram of the two rams,</para>
  <para style="p">
    <verse number="15" style="v" />And a several tenth deal to each lamb of the fourteen lambs:</para>
  <para style="p">
    <verse number="16" style="v" />And one kid of the goats <char style="add">[for]</char> a sin offering; beside the continual burnt offering, his meat offering, and his drink offering.</para>
  <para style="p">
    <verse number="17" style="v" />And on the second day [you<char style="ord">2f</char> shall offer] twelve young bullocks, two rams, fourteen lambs of the first year without spot:</para>
  <para style="p">
    <verse number="18" style="v" />And their meat offering and their drink offerings for the bullocks, for the rams, and for the lambs, <char style="add">[shall be]</char> according to their number, after the manner:</para>
  <para style="p">
    <verse number="19" style="v" />And one kid of the goats <char style="add">[for]</char> a sin offering; beside the continual burnt offering, and the meat offering thereof, and their drink offerings.</para>
  <para style="p">
    <verse number="20" style="v" />And on the third day eleven bullocks, two rams, fourteen lambs of the first year without blemish;</para>
  <para style="p">
    <verse number="21" style="v" />And their meat offering and their drink offerings for the bullocks, for the rams, and for the lambs, <char style="add">[shall be]</char> according to their number, after the manner:</para>
  <para style="p">
    <verse number="22" style="v" />And one goat <char style="add">[for]</char> a sin offering; beside the continual burnt offering, and his meat offering, and his drink offering.</para>
  <para style="p">
    <verse number="23" style="v" />And on the fourth day ten bullocks, two rams, <char style="add">[and]</char> fourteen lambs of the first year without blemish:</para>
  <para style="p">
    <verse number="24" style="v" />Their meat offering and their drink offerings for the bullocks, for the rams, and for the lambs, <char style="add">[shall be]</char> according to their number, after the manner:</para>
  <para style="p">
    <verse number="25" style="v" />And one kid of the goats <char style="add">[for]</char> a sin offering; beside the continual burnt offering, his meat offering, and his drink offering.</para>
  <para style="p">
    <verse number="26" style="v" />And on the fifth day nine bullocks, two rams, <char style="add">[and]</char> fourteen lambs of the first year without spot:</para>
  <para style="p">
    <verse number="27" style="v" />And their meat offering and their drink offerings for the bullocks, for the rams, and for the lambs, <char style="add">[shall be]</char> according to their number, after the manner:</para>
  <para style="p">
    <verse number="28" style="v" />And one goat <char style="add">[for]</char> a sin offering; beside the continual burnt offering, and his meat offering, and his drink offering.</para>
  <para style="p">
    <verse number="29" style="v" />And on the sixth day eight bullocks, two rams, <char style="add">[and]</char> fourteen lambs of the first year without blemish:</para>
  <para style="p">
    <verse number="30" style="v" />And their meat offering and their drink offerings for the bullocks, for the rams, and for the lambs, <char style="add">[shall be]</char> according to their number, after the manner:</para>
  <para style="p">
    <verse number="31" style="v" />And one goat <char style="add">[for]</char> a sin offering; beside the continual burnt offering, his meat offering, and his drink offering.</para>
  <para style="p">
    <verse number="32" style="v" />And on the seventh day seven bullocks, two rams, <char style="add">[and]</char> fourteen lambs of the first year without blemish:</para>
  <para style="p">
    <verse number="33" style="v" />And their meat offering and their drink offerings for the bullocks, for the rams, and for the lambs, <char style="add">[shall be]</char> according to their number, after the manner:</para>
  <para style="p">
    <verse number="34" style="v" />And one goat <char style="add">[for]</char> a sin offering; beside the continual burnt offering, his meat offering, and his drink offering.</para>
  <para style="p">
    <verse number="35" style="v" />On the eighth day you<char style="ord">2f</char> shall have a solemn assembly: you<char style="ord">2f</char> shall do no servile work <char style="add">[in it]</char>:</para>
  <para style="p">
    <verse number="36" style="v" />But you<char style="ord">2f</char> shall offer a burnt offering, a sacrifice made by fire, of a soothing aroma unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>: one bullock, one ram, seven lambs of the first year without blemish:</para>
  <para style="p">
    <verse number="37" style="v" />Their meat offering and their drink offerings for the bullock, for the ram, and for the lambs, <char style="add">[shall be]</char> according to their number, after the manner:</para>
  <para style="p">
    <verse number="38" style="v" />And one goat <char style="add">[for]</char> a sin offering; beside the continual burnt offering, and his meat offering, and his drink offering.</para>
  <para style="p">
    <verse number="39" style="v" />These <char style="add">[things]</char> you<char style="ord">2f</char> shall do unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> in your set feasts, beside your vows, and your freewill offerings, for your burnt offerings, and for your meat offerings, and for your drink offerings, and for your peace offerings.</para>
  <para style="p">
    <verse number="40" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> told the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> according to all that the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded Moshe <char style="add">[He Who Draws Out Of The Waters]</char>.</para>
  <chapter number="30" style="c" />
  <para style="p">
    <verse number="1" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> spoke unto the heads of the tribes concerning the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, saying, This <char style="add">[is]</char> the thing which the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> has commanded.</para>
  <para style="p">
    <verse number="2" style="v" />If a man vow a vow unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, or swear an oath to bind his soul with a bond; he shall not break his word, he shall do according to all that proceeds out of his mouth.</para>
  <para style="p">
    <verse number="3" style="v" />If a woman also vow a vow unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and bind herself by a bond, <char style="add">[being]</char> in her father’s house in her youth;</para>
  <para style="p">
    <verse number="4" style="v" />And her father hear her vow, and her bond which she has bound her soul, and her father shall hold his peace at her: then all her vows shall stand, and every bond which she has bound her soul shall stand.</para>
  <para style="p">
    <verse number="5" style="v" />But if her father disallow <char style="pn">(to approve, commend, accept)</char> her in the day that he hears; not any of her vows, or of her bonds which she has bound her soul, shall stand: and the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> shall forgive her, because her father disallow (to approve, commend, accept)ed her.</para>
  <para style="p">
    <verse number="6" style="v" />And if she had at all an husband, when she vowed, or uttered ought out of her lips, which she bound her soul;</para>
  <para style="p">
    <verse number="7" style="v" />And her husband heard <char style="add">[it,]</char> and held his peace at her in the day that he heard <char style="add">[it]</char>: then her vows shall stand, and her bonds which she bound her soul shall stand.</para>
  <para style="p">
    <verse number="8" style="v" />But if her husband disallow (to approve, commend, accept)ed her on the day that he heard <char style="add">[it]</char>; then he shall make her vow which she vowed, and that which she uttered with her lips, which she bound her soul, of none effect: and the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> shall forgive her.</para>
  <para style="p">
    <verse number="9" style="v" />But every vow of a widow, and of her that is divorced, which they have bound their souls, shall stand against her.</para>
  <para style="p">
    <verse number="10" style="v" />And if she vowed in her husband’s house, or bound her soul by a bond with an oath;</para>
  <para style="p">
    <verse number="11" style="v" />And her husband heard <char style="add">[it]</char>, and held his peace at her, <char style="add">[and]</char> disallow <char style="pn">(to approve, commend, accept)</char>ed her not: then all her vows shall stand, and every bond which she bound her soul shall stand.</para>
  <para style="p">
    <verse number="12" style="v" />But if her husband has utterly made them void on the day he heard <char style="add">[them; then]</char> whatsoever proceeded out of her lips concerning her vows, or concerning the bond of her soul, shall not stand: her husband has made them void; and the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> shall forgive her.</para>
  <para style="p">
    <verse number="13" style="v" />Every vow, and every binding oath to afflict the soul, her husband may establish it, or her husband may make it void.</para>
  <para style="p">
    <verse number="14" style="v" />But if her husband altogether hold his peace at her from day to day; then he establishes all her vows, or all her bonds, which <char style="add">[are]</char> upon her: he confirms them, because he held his peace at her in the day that he heard <char style="add">[them]</char>.</para>
  <para style="p">
    <verse number="15" style="v" />But if he shall any ways make them void after that he has heard <char style="add">[them]</char>; then he shall bear her iniquity.</para>
  <para style="p">
    <verse number="16" style="v" />These <char style="add">[are]</char> the statutes, which the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, between a man and his wife, between the father and his daughter, <char style="add">[being yet]</char> in her youth in her father’s house.</para>
  <chapter number="31" style="c" />
  <para style="p">
    <verse number="1" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="2" style="v" />Avenge the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> of the Midyanim <char style="add">[Strife]</char>: afterward shall you<char style="ord">i</char> be gathered unto you<char style="ord">i</char> people.</para>
  <para style="p">
    <verse number="3" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> spoke unto the people, saying, Arm some of yourselves unto the war, and let them go against the Midyanim <char style="add">[Strife]</char>, and avenge the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> of Midyan <char style="add">[Strife]</char>.</para>
  <para style="p">
    <verse number="4" style="v" />Of every tribe a thousand, throughout all the tribes of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, shall you<char style="ord">2f</char> send to the war.</para>
  <para style="p">
    <verse number="5" style="v" />So there were delivered out of the thousands of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, a thousand of <char style="add">[every]</char> tribe, twelve thousand armed for war.</para>
  <para style="p">
    <verse number="6" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> sent them to the war, a thousand of <char style="add">[every]</char> tribe, them and Pinchas <char style="add">[mouth of brass]</char> the son of El’azar <char style="add">[God has helped]</char> the priest, to the war, with the holy instruments, and the trumpets to blow in his hand.</para>
  <para style="p">
    <verse number="7" style="v" />And they warred against the Midyanim <char style="add">[Strife]</char>, as the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded Moshe <char style="add">[He Who Draws Out Of The Waters]</char>; and they killed all the males.</para>
  <para style="p">
    <verse number="8" style="v" />And they killed the kings of Midyan <char style="add">[Strife]</char>, beside the rest of them that were slain; <char style="add">[namely]</char>, Evi <char style="add">[My Desire]</char>, and Rekem <char style="add">[Variegation]</char>, and Tzur <char style="add">[Rock]</char>, and Hur <char style="add">[Liberty]</char>, and Reva <char style="add">[Four]</char>, five kings of Midyan <char style="add">[Strife]</char>: Bil’am <char style="add">[Not of the People]</char> also the son of B’or <char style="add">[Burning]</char> they killed with the sword.</para>
  <para style="p">
    <verse number="9" style="v" />And the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> took <char style="add">[all]</char> the women of Midyan <char style="add">[Strife]</char> captives, and their little ones, and took the spoil <char style="pn">(plunder; prey; booty)</char> of all their cattle, and all their flocks, and all their goods.</para>
  <para style="p">
    <verse number="10" style="v" />And they burnt all their cities wherein they dwelt, and all their goodly castles, with fire.</para>
  <para style="p">
    <verse number="11" style="v" />And they took all the spoil <char style="pn">(plunder; prey; booty)</char>, and all the prey, <char style="add">[both]</char> of men and of beasts.</para>
  <para style="p">
    <verse number="12" style="v" />And they brought the captives, and the prey, and the spoil <char style="pn">(plunder; prey; booty)</char>, unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, and El’azar <char style="add">[God has helped]</char> the priest, and unto the congregation of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, unto the camp at the plains of Mo’av <char style="add">[Seed of my Father]</char>, which <char style="add">[are]</char> by Yarden <char style="add">[Descender] [near]</char> Yericho <char style="add">[Its Moon]</char>.</para>
  <para style="p">
    <verse number="13" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, and El’azar <char style="add">[God has helped]</char> the priest, and all the princes of the congregation, went forth to meet them without the camp.</para>
  <para style="p">
    <verse number="14" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> was exceedingly angry with the officers of the host, <char style="add">[with]</char> the captains over thousands, and captains over hundreds, which came from the battle.</para>
  <para style="p">
    <verse number="15" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> said unto them, Have you<char style="ord">2f</char> saved all the women alive?</para>
  <para style="p">
    <verse number="16" style="v" />Behold, these caused the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, through the counsel of Bil’am <char style="add">[Not of the People]</char>, to commit trespass against the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> in the matter of P’or <char style="add">[Cleft (split hoof; an opening, break or split)]</char>, and there was a plague among the congregation of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="17" style="v" />Now therefore kill every male among the little ones, and kill every woman that has known man by lying with him.</para>
  <para style="p">
    <verse number="18" style="v" />But all the women children, that have not known a man by lying with him, keep alive for yourselves.</para>
  <para style="p">
    <verse number="19" style="v" />And do you<char style="ord">2f</char> abide without the camp seven days: whosoever has killed any person, and whosoever has touched any slain, purify <char style="add">[both]</char> yourselves and your captives on the third day, and on the seventh day.</para>
  <para style="p">
    <verse number="20" style="v" />And purify all <char style="add">[your]</char> clothing, and all that is made of skins, and all work of goats’ <char style="add">[hair]</char>, and all things made of wood.</para>
  <para style="p">
    <verse number="21" style="v" />And El’azar <char style="add">[God has helped]</char> the priest said unto the men of war which went to the battle, This <char style="add">[is]</char> the ordinance of the law which the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded Moshe <char style="add">[He Who Draws Out Of The Waters]</char>;</para>
  <para style="p">
    <verse number="22" style="v" />Only the gold, and the silver, the brass, the iron, the tin, and the lead,</para>
  <para style="p">
    <verse number="23" style="v" />Eveeverything that may abide the fire, you<char style="ord">2f</char> shall make <char style="add">[it]</char> go through the fire, and it shall be clean: nevertheless it shall be purified with the water of separation: and all that abides not the fire you<char style="ord">2f</char> shall make go through the water.</para>
  <para style="p">
    <verse number="24" style="v" />And you<char style="ord">2f</char> shall wash your clothes on the seventh day, and you<char style="ord">2f</char> shall be clean, and afterward you<char style="ord">2f</char> shall come into the camp.</para>
  <para style="p">
    <verse number="25" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="26" style="v" />Take the sum of the prey that was taken, <char style="add">[both]</char> of man and of beast, you<char style="ord">i</char>, and El’azar <char style="add">[God has helped]</char> the priest, and the chief fathers of the congregation:</para>
  <para style="p">
    <verse number="27" style="v" />And divide the prey into two parts; between them that took the war upon them, who went out to battle, and between all the congregation:</para>
  <para style="p">
    <verse number="28" style="v" />And levy a tribute unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> of the men of war which went out to battle: one soul of five hundred, <char style="add">[both]</char> of the persons, and of the beeves <char style="pn">(cattle)</char>, and of the asses, and of the sheep:</para>
  <para style="p">
    <verse number="29" style="v" />Take <char style="add">[it]</char> of their half, and give it unto El’azar <char style="add">[God has helped]</char> the priest, <char style="add">[for]</char> an heave offering of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="30" style="v" />And of the people of Yisra’el’s <char style="add">[He Holds Onto The Heel Of God]</char> half, you<char style="ord">i</char> shall take one portion of fifty, of the persons, of the beeves <char style="pn">(cattle)</char>, of the asses, and of the flocks, of all manner of beasts, and give them unto the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char>, which keep the charge of the tabernacle of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="31" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and El’azar <char style="add">[God has helped]</char> the priest did as the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded Moshe <char style="add">[He Who Draws Out Of The Waters]</char>.</para>
  <para style="p">
    <verse number="32" style="v" />And the booty, <char style="add">[being]</char> the rest of the prey which the men of war had caught, was six hundred thousand and seventy thousand and five thousand sheep,</para>
  <para style="p">
    <verse number="33" style="v" />And threescore and twelve thousand beeves <char style="pn">(cattle)</char>,</para>
  <para style="p">
    <verse number="34" style="v" />And threescore and one thousand asses,</para>
  <para style="p">
    <verse number="35" style="v" />And thirty and two thousand persons in all, of women that had not known man by lying with him.</para>
  <para style="p">
    <verse number="36" style="v" />And the half, <char style="add">[which was]</char> the portion of them that went out to war, was in number three hundred thousand and seven and thirty thousand and five hundred sheep:</para>
  <para style="p">
    <verse number="37" style="v" />And the LORD-Yehōvah’s <char style="add">[Messiah Pre-Incarnate]</char> tribute of the sheep was six hundred and threescore and fifteen.</para>
  <para style="p">
    <verse number="38" style="v" />And the beeves <char style="pn">(cattle)</char> <char style="add">[were]</char> thirty and six thousand; of which the LORD-Yehōvah’s <char style="add">[Messiah Pre-Incarnate]</char> tribute <char style="add">[was]</char> threescore and twelve.</para>
  <para style="p">
    <verse number="39" style="v" />And the asses <char style="add">[were]</char> thirty thousand and five hundred; of which the LORD-Yehōvah’s <char style="add">[Messiah Pre-Incarnate]</char> tribute <char style="add">[was]</char> threescore and one.</para>
  <para style="p">
    <verse number="40" style="v" />And the persons <char style="add">[were]</char> sixteen thousand; of which the LORD-Yehōvah’s <char style="add">[Messiah Pre-Incarnate]</char> tribute <char style="add">[was]</char> thirty and two persons.</para>
  <para style="p">
    <verse number="41" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> gave the tribute, <char style="add">[which was]</char> the LORD-Yehōvah’s <char style="add">[Messiah Pre-Incarnate]</char> heave offering, unto El’azar <char style="add">[God has helped]</char> the priest, as the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded Moshe <char style="add">[He Who Draws Out Of The Waters]</char>.</para>
  <para style="p">
    <verse number="42" style="v" />And of the people of Yisra’el’s <char style="add">[He Holds Onto The Heel Of God]</char> half, which Moshe <char style="add">[He Who Draws Out Of The Waters]</char> divided from the men that warred,</para>
  <para style="p">
    <verse number="43" style="v" />(Now the half <char style="add">[that pertained unto]</char> the congregation was three hundred thousand and thirty thousand <char style="add">[and]</char> seven thousand and five hundred sheep,</para>
  <para style="p">
    <verse number="44" style="v" />And thirty and six thousand beeves <char style="pn">(cattle)</char>,</para>
  <para style="p">
    <verse number="45" style="v" />And thirty thousand asses and five hundred,</para>
  <para style="p">
    <verse number="46" style="v" />And sixteen thousand persons;)</para>
  <para style="p">
    <verse number="47" style="v" />Even of the people of Yisra’el’s <char style="add">[He Holds Onto The Heel Of God]</char> half, Moshe <char style="add">[He Who Draws Out Of The Waters]</char> took one portion of fifty, <char style="add">[both]</char> of man and of beast, and gave them unto the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char>, which kept the charge of the tabernacle of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>; as the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded Moshe <char style="add">[He Who Draws Out Of The Waters]</char>.</para>
  <para style="p">
    <verse number="48" style="v" />And the officers which <char style="add">[were]</char> over thousands of the host, the captains of thousands, and captains of hundreds, came near unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>:</para>
  <para style="p">
    <verse number="49" style="v" />And they said unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, You<char style="ord">1s</char> servants have taken the sum of the men of war which <char style="add">[are]</char> under our charge, and there lacks not one man of us.</para>
  <para style="p">
    <verse number="50" style="v" />We have therefore brought an oblation for the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, what every man has gotten, of jewels of gold, chains, and bracelets, rings, earrings, and tablets <char style="pn">(small, flat ornaments or jewelry)</char>, to make an atonement for our souls before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="51" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and El’azar <char style="add">[God has helped]</char> the priest took the gold of them, <char style="add">[even]</char> all wrought jewels.</para>
  <para style="p">
    <verse number="52" style="v" />And all the gold of the offering that they offered up to the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, of the captains of thousands, and of the captains of hundreds, was sixteen thousand seven hundred and fifty shekels.</para>
  <para style="p">
    <verse number="53" style="v" />(<char style="add">[For]</char> the men of war had taken spoil <char style="pn">(plunder; prey; booty)</char>, every man for himself.)</para>
  <para style="p">
    <verse number="54" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and El’azar <char style="add">[God has helped]</char> the priest took the gold of the captains of thousands and of hundreds, and brought it into the tabernacle of the congregation, <char style="add">[for]</char> a memorial for the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <chapter number="32" style="c" />
  <para style="p">
    <verse number="1" style="v" />Now the children of Re’uven <char style="add">[Behold a Son]</char> and the children of Gad <char style="add">[Good Fortune with Troublesome Effort]</char> had a very great multitude of cattle: and when they saw the land of Ya’zer <char style="add">[Helped]</char>, and the land of Gil’ad <char style="add">[Rocky Region]</char>, that, behold, the place <char style="add">[was]</char> a place for cattle;</para>
  <para style="p">
    <verse number="2" style="v" />The children of Gad <char style="add">[Good Fortune with Troublesome Effort]</char> and the children of Re’uven <char style="add">[Behold a Son]</char> came and spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, and to El’azar <char style="add">[God has helped]</char> the priest, and unto the princes of the congregation, saying,</para>
  <para style="p">
    <verse number="3" style="v" />‘Atarot <char style="add">[Crowns]</char>, and Divon <char style="add">[Wasting]</char>, and Ya’zer <char style="add">[Helped]</char>, and Nimrah <char style="add">[Pure]</char>, and Heshbon <char style="add">[Stronghold]</char>, and El’aleh <char style="add">[God is Ascending]</char>, and S’vam <char style="add">[Fragrance]</char>, and Nevo <char style="add">[Prophet]</char>, and Be’on <char style="add">[Indwelling]</char>,</para>
  <para style="p">
    <verse number="4" style="v" />
    <char style="add">[Even]</char> the country which the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> struck before the congregation of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, <char style="add">[is]</char> a land for cattle, and you<char style="ord">i</char> servants have cattle:</para>
  <para style="p">
    <verse number="5" style="v" />For what reason, said they, if we have found grace in you<char style="ord">i</char> sight, let this land be given unto you<char style="ord">i</char> servants for a possession, <char style="add">[and]</char> bring us not over Yarden <char style="add">[Descender]</char>.</para>
  <para style="p">
    <verse number="6" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> said unto the children of Gad <char style="add">[Good Fortune with Troublesome Effort]</char> and to the children of Re’uven <char style="add">[Behold a Son]</char>, Shall your brethren go to war, and shall you<char style="ord">2f</char> sit here?</para>
  <para style="p">
    <verse number="7" style="v" />And wherefore discourage you<char style="ord">2f</char> the heart of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> from going over into the land which the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> has given them?</para>
  <para style="p">
    <verse number="8" style="v" />Thus did your fathers, when I sent them from Kadesh <char style="add">[Holy]</char> -Barnea <char style="add">[Holy]</char> to see the land.</para>
  <para style="p">
    <verse number="9" style="v" />For when they went up unto the valley of Eshkol <char style="add">[Cluster]</char>, and saw the land, they discouraged the heart of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, that they should not go into the land which the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> had given them.</para>
  <para style="p">
    <verse number="10" style="v" />And the LORD-Yehōvah’s <char style="add">[Messiah Pre-Incarnate]</char> anger was kindled the same time, and he swore, saying,</para>
  <para style="p">
    <verse number="11" style="v" />Surely none of the men that came up out of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>, from twenty years old and upward, shall see the land which I swore unto Avraham <char style="add">[Exalted Father]</char>, unto Yitz’khak <char style="add">[Laughter]</char>, and unto Ya’akov <char style="add">[Heal of God]</char>; because they have not wholly followed me:</para>
  <para style="p">
    <verse number="12" style="v" />Save Kalev <char style="add">[Dog]</char> the son of Y’funeh <char style="add">[He Will Face]</char> the K’nizi <char style="add">[The Sons of Kenez]</char>, and Y’hoshua <char style="add">[Yehovah is Salvation]</char> the son of Nun <char style="add">[Posterity]</char>: for they have wholly followed the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="13" style="v" />And the LORD-Yehōvah’s <char style="add">[Messiah Pre-Incarnate]</char> anger was kindled against Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, and he made them wander in the wilderness forty years, until all the generation, that had done evil in the sight of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, was consumed.</para>
  <para style="p">
    <verse number="14" style="v" />And, behold, you<char style="ord">2f</char> are risen up in your fathers’ stead, an increase of sinful men, to augment yet the fierce anger of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> toward Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="15" style="v" />For if you<char style="ord">2f</char> turn away from after him, he will yet again leave them in the wilderness; and you<char style="ord">2f</char> shall destroy all this people.</para>
  <para style="p">
    <verse number="16" style="v" />And they came near unto him, and said, We will build sheepfolds here for our cattle, and cities for our little ones:</para>
  <para style="p">
    <verse number="17" style="v" />But we ourselves will go ready armed before the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, until we have brought them unto their place: and our little ones shall dwell in the fenced cities because of the inhabitants of the land.</para>
  <para style="p">
    <verse number="18" style="v" />We will not return unto our houses, until the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> have inherited every man his inheritance.</para>
  <para style="p">
    <verse number="19" style="v" />For we will not inherit with them on yonder side Yarden <char style="add">[Descender]</char>, or forward; because our inheritance is fallen to us on this side Yarden <char style="add">[Descender]</char> eastward.</para>
  <para style="p">
    <verse number="20" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> said unto them, If you<char style="ord">2f</char> will do this thing, if you<char style="ord">2f</char> will go armed before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> to war,</para>
  <para style="p">
    <verse number="21" style="v" />And will go all of you armed over Yarden <char style="add">[Descender]</char> before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, until he has driven out his enemies from before him,</para>
  <para style="p">
    <verse number="22" style="v" />And the land be subdued before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>: then afterward you<char style="ord">2f</char> shall return, and be guiltless before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and before Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>; and this land shall be your possession before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="23" style="v" />But if you<char style="ord">2f</char> will not do so, behold, you<char style="ord">2f</char> have sinned against the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>: and be sure your sin will find you out.</para>
  <para style="p">
    <verse number="24" style="v" />Build you cities for your little ones, and folds for your sheep; and do that which has proceeded out of your mouth.</para>
  <para style="p">
    <verse number="25" style="v" />And the children of Gad <char style="add">[Good Fortune with Troublesome Effort]</char> and the children of Re’uven <char style="add">[Behold a Son]</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying, You<char style="ord">1s</char> servants will do as my lord commands.</para>
  <para style="p">
    <verse number="26" style="v" />Our little ones, our wives, our flocks, and all our cattle, shall be there in the cities of Gil’ad <char style="add">[Rocky Region]</char>:</para>
  <para style="p">
    <verse number="27" style="v" />But you<char style="ord">i</char> servants will pass over, every man armed for war, before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> to battle, as my lord says.</para>
  <para style="p">
    <verse number="28" style="v" />So concerning them Moshe <char style="add">[He Who Draws Out Of The Waters]</char> commanded El’azar <char style="add">[God has helped]</char> the priest, and Y’hoshua <char style="add">[Yehovah is Salvation]</char> the son of Nun <char style="add">[Posterity]</char>, and the chief fathers of the tribes of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>:</para>
  <para style="p">
    <verse number="29" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> said unto them, If the children of Gad <char style="add">[Good Fortune with Troublesome Effort]</char> and the children of Re’uven <char style="add">[Behold a Son]</char> will pass with you over Yarden <char style="add">[Descender]</char>, every man armed to battle, before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and the land shall be subdued before you; then you<char style="ord">2f</char> shall give them the land of Gil’ad <char style="add">[Rocky Region]</char> for a possession:</para>
  <para style="p">
    <verse number="30" style="v" />But if they will not pass over with you armed, they shall have possessions among you in the land of Kena’an <char style="add">[Merchant]</char>.</para>
  <para style="p">
    <verse number="31" style="v" />And the children of Gad <char style="add">[Good Fortune with Troublesome Effort]</char> and the children of Re’uven <char style="add">[Behold a Son]</char> answered, saying, As the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> has said unto you<char style="ord">i</char> servants, so will we do.</para>
  <para style="p">
    <verse number="32" style="v" />We will pass over armed before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> into the land of Kena’an <char style="add">[Merchant]</char>, that the possession of our inheritance on this side Yarden <char style="add">[Descender] [may be]</char> ours.</para>
  <para style="p">
    <verse number="33" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> gave unto them, <char style="add">[even]</char> to the children of Gad <char style="add">[Good Fortune with Troublesome Effort]</char>, and to the children of Re’uven <char style="add">[Behold a Son]</char>, and unto half the tribe of M’nasheh <char style="add">[Causing to Forget]</char> the son of Yosef <char style="add">[(God) He Shall Add]</char>, the kingdom of Sichon <char style="add">[Warrior]</char> king of the Emori <char style="add">[Highlanders]</char>, and the kingdom of ‘Og <char style="add">[Long-necked]</char> king of Bashan <char style="add">[Fruitful]</char>, the land, with the cities thereof in the coasts, <char style="add">[even]</char> the cities of the country round about.</para>
  <para style="p">
    <verse number="34" style="v" />And the children of Gad <char style="add">[Good Fortune with Troublesome Effort]</char> built Divon <char style="add">[Wasting]</char>, and ‘Atarot <char style="add">[Crowns]</char>, and ‘Aeo’er <char style="add">[Ruins]</char>,</para>
  <para style="p">
    <verse number="35" style="v" />And ‘Artrot-Shofan <char style="add">[Crowns in Their Rapine]</char>, and Ya’zer <char style="add">[Helped]</char>, and Yogbehah <char style="add">[Lofty]</char>,</para>
  <para style="p">
    <verse number="36" style="v" />And Beit-Nimrah <char style="add">[House of the Leopard]</char>, and Beit-Haran <char style="add">[mountaineer] [House of the Joyful Shouter]</char>, fenced cities: and folds for sheep.</para>
  <para style="p">
    <verse number="37" style="v" />And the children of Re’uven <char style="add">[Behold a Son]</char> built Heshbon <char style="add">[Stronghold]</char>, and El’aleh <char style="add">[God is Ascending]</char>, and Kiryatayim <char style="add">[Two Cities]</char>,</para>
  <para style="p">
    <verse number="38" style="v" />And Nevo <char style="add">[Prophet]</char>, and Ba’al-M’on <char style="add">[lord of the Habitation]</char>, <char style="pn">(their names being changed,)</char> and Sivmah <char style="add">[Fragrance]</char>: and gave other names unto the cities which they built.</para>
  <para style="p">
    <verse number="39" style="v" />And the children of Makhir <char style="add">[Sold]</char> the son of M’nasheh <char style="add">[Causing to Forget]</char> went to Gil’ad <char style="add">[Rocky Region]</char>, and took it, and dispossessed the Emori <char style="add">[Rebellious Highlanders]</char> which <char style="add">[was]</char> in it.</para>
  <para style="p">
    <verse number="40" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> gave Gil’ad <char style="add">[Rocky Region]</char> unto Makhir <char style="add">[Sold]</char> the son of M’nasheh <char style="add">[Causing to Forget]</char>; and he dwelt in it.</para>
  <para style="p">
    <verse number="41" style="v" />And Ya’ir <char style="add">[He Enlightens]</char> the son of M’nasheh <char style="add">[Causing to Forget]</char> went and took the small to (to do entirely, do wholly)wns thereof, and called them Havot-Ya’ir <char style="add">[Villages of the Enlighteners]</char>.</para>
  <para style="p">
    <verse number="42" style="v" />And Novach <char style="add">[Barking]</char> went and took K’nat <char style="add">[Possession]</char>, and the villages thereof, and called it Novach <char style="add">[Barking]</char>, after his own name.</para>
  <chapter number="33" style="c" />
  <para style="p">
    <verse number="1" style="v" />These <char style="add">[are]</char> the journeys of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, which went forth out of the land of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char> with their armies under the hand of Moshe <char style="add">[He Who Draws Out Of The Waters]</char> and Aharon <char style="add">[Bright, Very High]</char>.</para>
  <para style="p">
    <verse number="2" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> wrote their goings out according to their journeys by the commandment of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>: and these <char style="add">[are]</char> their journeys according to their goings out.</para>
  <para style="p">
    <verse number="3" style="v" />And they departed from Ra’amses in the first month, on the fifteenth day of the first month; on the morrow after the Passover the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> went out with an high hand in the sight of all the Mitzri.</para>
  <para style="p">
    <verse number="4" style="v" />For the Mitzri buried all <char style="add">[their]</char> firstborn, which the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> had smitten among them: upon their gods also the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> executed judgments.</para>
  <para style="p">
    <verse number="5" style="v" />And the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> removed from Ra’amses, and pitched in Sukkot <char style="add">[Booths]</char>.</para>
  <para style="p">
    <verse number="6" style="v" />And they departed from Sukkot <char style="add">[Booths]</char>, and pitched in ‘Eitam <char style="add">[Lair of Wild Beasts]</char> [with them: their plowshare], which <char style="add">[is]</char> in the edge of the wilderness.</para>
  <para style="p">
    <verse number="7" style="v" />And they removed from ‘Eitam <char style="add">[Lair of Wild Beasts]</char> [with them: their plowshare], and turned again unto Pi-Hachirot <char style="add">[The Place where the Sedge Grows]</char>, which <char style="add">[is]</char> before Ba’al-Tz’fon <char style="add">[Lord of the North]</char>: and they pitched before Migdol <char style="add">[Tower]</char>.</para>
  <para style="p">
    <verse number="8" style="v" />And they departed from before Pi-Hachirot <char style="add">[The Place where the Sedge Grows]</char>, and passed through the midst of the sea into the wilderness, and went three days’ journey in the wilderness of ‘Eitam <char style="add">[Lair of Wild Beasts]</char> [with them: their plowshare], and pitched in Marah <char style="add">[Bitterness]</char>.</para>
  <para style="p">
    <verse number="9" style="v" />And they removed from Marah <char style="add">[Bitterness]</char>, and came unto Eilim <char style="add">[Palms]</char>: and in Eilim <char style="add">[Palms] [were]</char> twelve fountains of water, and threescore and ten palm trees; and they pitched there.</para>
  <para style="p">
    <verse number="10" style="v" />And they removed from Eilim <char style="add">[Palms]</char>, and encamped by the Red sea.</para>
  <para style="p">
    <verse number="11" style="v" />And they removed from the Red sea, and encamped in the wilderness of Sin.</para>
  <para style="p">
    <verse number="12" style="v" />And they took their journey out of the wilderness of Sin, and encamped in Dofkah <char style="add">[Knocking]</char>.</para>
  <para style="p">
    <verse number="13" style="v" />And they departed from Dofkah <char style="add">[Knocking]</char>, and encamped in Alush <char style="add">[I Will Knead (Bread)]</char>.</para>
  <para style="p">
    <verse number="14" style="v" />And they removed from Alush <char style="add">[I Will Knead (Bread)]</char>, and encamped at Refidim <char style="add">[Resting Places]</char>, where was no water for the people to drink.</para>
  <para style="p">
    <verse number="15" style="v" />And they departed from Refidim <char style="add">[Resting Places]</char>, and pitched in the wilderness of Sinai.</para>
  <para style="p">
    <verse number="16" style="v" />And they removed from the desert of Sinai, and pitched at Kivrot-HaTa’avah <char style="add">[Graves of Lust]</char>.</para>
  <para style="p">
    <verse number="17" style="v" />And they departed from Kivrot-HaTa’avah <char style="add">[Graves of Lust]</char>, and encamped at Hatzerot <char style="add">[A Place in the Wilderness]</char>.</para>
  <para style="p">
    <verse number="18" style="v" />And they departed from Hatzerot <char style="add">[A Place in the Wilderness]</char>, and pitched in Ritmah <char style="add">[Health]</char>.</para>
  <para style="p">
    <verse number="19" style="v" />And they departed from Ritmah <char style="add">[Health]</char>, and pitched at Rimmon <char style="add">[Pomegranate]</char> -Peretz [Pomegranate of the Breach (breaking forth; a break; opening, inlet)].</para>
  <para style="p">
    <verse number="20" style="v" />And they departed from Rimmon <char style="add">[Pomegranate]</char> -Peretz [Pomegranate of the Breach (breaking forth; a break; opening, inlet)], and pitched in Livnah <char style="add">[Pavement]</char>.</para>
  <para style="p">
    <verse number="21" style="v" />And they removed from Livnah <char style="add">[Pavement]</char>, and pitched at Rissah <char style="add">[Ruin]</char>.</para>
  <para style="p">
    <verse number="22" style="v" />And they journeyed from Rissah <char style="add">[Ruin]</char>, and pitched in K’helah <char style="add">[Assembly]</char>.</para>
  <para style="p">
    <verse number="23" style="v" />And they went from K’helah <char style="add">[Assembly]</char>, and pitched in mount Shefer <char style="add">[Beauty]</char>.</para>
  <para style="p">
    <verse number="24" style="v" />And they removed from mount Shefer <char style="add">[Beauty]</char>, and encamped in Haradah <char style="add">[Fear]</char>.</para>
  <para style="p">
    <verse number="25" style="v" />And they removed from Haradah <char style="add">[Fear]</char>, and pitched in Mak’helot <char style="add">[Place of Assembly]</char>.</para>
  <para style="p">
    <verse number="26" style="v" />And they removed from Mak’helot <char style="add">[Place of Assembly]</char>, and encamped at Tachat <char style="add">[Station]</char>.</para>
  <para style="p">
    <verse number="27" style="v" />And they departed from Tachat <char style="add">[Station]</char>, and pitched at Terach <char style="add">[Station]</char>.</para>
  <para style="p">
    <verse number="28" style="v" />And they removed from Terach <char style="add">[Station]</char>, and pitched in Mitkah <char style="add">[Sweetness]</char>.</para>
  <para style="p">
    <verse number="29" style="v" />And they went from Mitkah <char style="add">[Sweetness]</char>, and pitched in HaShmonah <char style="add">[Fatness]</char>.</para>
  <para style="p">
    <verse number="30" style="v" />And they departed from HaShmonah <char style="add">[Fatness]</char>, and encamped at Moserot <char style="add">[Bonds]</char>.</para>
  <para style="p">
    <verse number="31" style="v" />And they departed from Moserot <char style="add">[Bonds]</char>, and pitched in B’nei-Ya’akan <char style="add">[Sons of Twisting]</char>.</para>
  <para style="p">
    <verse number="32" style="v" />And they removed from B’nei-Ya’akan <char style="add">[Sons of Twisting]</char>, and encamped at Hor-HaGidgad <char style="add">[Cavern of Gidgad]</char>.</para>
  <para style="p">
    <verse number="33" style="v" />And they went from Hor-HaGidgad <char style="add">[Cavern of Gidgad]</char>, and pitched in Yotvatah <char style="add">[Pleasantness]</char>.</para>
  <para style="p">
    <verse number="34" style="v" />And they removed from Yotvatah <char style="add">[Pleasantness]</char>, and encamped at Avronah <char style="add">[Passage]</char>.</para>
  <para style="p">
    <verse number="35" style="v" />And they departed from Avronah <char style="add">[Passage]</char>, and encamped at ‘Etzyon-Gever <char style="add">[Backbone of a Man]</char>.</para>
  <para style="p">
    <verse number="36" style="v" />And they removed from ‘Etzyon-Gever <char style="add">[Backbone of a Man]</char>, and pitched in the wilderness of Tzin <char style="add">[Flat]</char>, which <char style="add">[is]</char> Kadesh <char style="add">[Holy]</char>.</para>
  <para style="p">
    <verse number="37" style="v" />And they removed from Kadesh <char style="add">[Holy]</char>, and pitched in mount Hor <char style="add">[Mountain Peak]</char>, in the edge of the land of Edom <char style="add">[Red]</char>.</para>
  <para style="p">
    <verse number="38" style="v" />And Aharon <char style="add">[Bright, Very High]</char> the priest went up into mount Hor <char style="add">[Mountain Peak]</char> at the commandment of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and died there, in the fortieth year after the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> were come out of the land of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>, in the first <char style="add">[day]</char> of the fifth month.</para>
  <para style="p">
    <verse number="39" style="v" />And Aharon <char style="add">[Bright, Very High] [was]</char> an hundred and twenty and three years old when he died in mount Hor <char style="add">[Mountain Peak]</char>.</para>
  <para style="p">
    <verse number="40" style="v" />And king ‘Arad <char style="add">[A Wild Ass]</char> the Kena’ani <char style="add">[Merchants]</char>, which dwelt in the south in the land of Kena’an <char style="add">[Merchant]</char>, heard of the coming of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="41" style="v" />And they departed from mount Hor <char style="add">[Mountain Peak]</char>, and pitched in Tzalmonah <char style="add">[Shady]</char>.</para>
  <para style="p">
    <verse number="42" style="v" />And they departed from Tzalmonah <char style="add">[Shady]</char>, and pitched in Punon <char style="add">[Darkness]</char>.</para>
  <para style="p">
    <verse number="43" style="v" />And they departed from Punon <char style="add">[Darkness]</char>, and pitched in Ovot <char style="add">[Waterskins]</char>.</para>
  <para style="p">
    <verse number="44" style="v" />And they departed from Ovot <char style="add">[Waterskins]</char>, and pitched in ‘Iyei-Ha’avarim <char style="add">[Ruins of Regions Beyond]</char>, in the border of Mo’av <char style="add">[Seed of my Father]</char>.</para>
  <para style="p">
    <verse number="45" style="v" />And they departed from ‘Ee’yim <char style="add">[Ruins]</char>, and pitched in Divon-Gad <char style="add">[Wasting]</char>.</para>
  <para style="p">
    <verse number="46" style="v" />And they removed from Divon-Gad <char style="add">[Wasting]</char>, and encamped in ‘‘Almon <char style="add">[concealed]</char> -Divlatayim <char style="add">[Concealing the Two Cakes]</char>.</para>
  <para style="p">
    <verse number="47" style="v" />And they removed from ‘‘Almon <char style="add">[concealed]</char> -Divlatayim <char style="add">[Concealing the Two Cakes]</char>, and pitched in the mountains of ‘Avarim <char style="add">[Regions Beyond]</char>, before Nevo <char style="add">[Prophet]</char>.</para>
  <para style="p">
    <verse number="48" style="v" />And they departed from the mountains of ‘Avarim <char style="add">[Regions Beyond]</char>, and pitched in the plains of Mo’av <char style="add">[Seed of my Father]</char> by Yarden <char style="add">[Descender] [near]</char> Yericho <char style="add">[Its Moon]</char>.</para>
  <para style="p">
    <verse number="49" style="v" />And they pitched by Yarden <char style="add">[Descender]</char>, from Beit-HaYeshimot <char style="add">[House of the Desolation] [even]</char> unto Avel-HaSheetim <char style="add">[Meadow of Acacias]</char> in the plains of Mo’av <char style="add">[Seed of my Father]</char>.</para>
  <para style="p">
    <verse number="50" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char> in the plains of Mo’av <char style="add">[Seed of my Father]</char> by Yarden <char style="add">[Descender] [near]</char> Yericho <char style="add">[Its Moon]</char>, saying,</para>
  <para style="p">
    <verse number="51" style="v" />Speak unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, and say unto them, When you<char style="ord">2f</char> are passed over Yarden <char style="add">[Descender]</char> into the land of Kena’an <char style="add">[Merchant]</char>;</para>
  <para style="p">
    <verse number="52" style="v" />Then you<char style="ord">2f</char> shall drive out all the inhabitants of the land from before you, and destroy all their pictures, and destroy all their molten images, and quite pluck down all their high places:</para>
  <para style="p">
    <verse number="53" style="v" />And you<char style="ord">2f</char> shall dispossess <char style="add">[the inhabitants]</char> of the land, and dwell in it: for I have given you the land to possess it.</para>
  <para style="p">
    <verse number="54" style="v" />And you<char style="ord">2f</char> shall divide the land by lot for an inheritance among your families: <char style="add">[and]</char> to the more you<char style="ord">2f</char> shall give the more inheritance, and to the fewer you<char style="ord">2f</char> shall give the less inheritance: every man’s <char style="add">[inheritance]</char> shall be in the place where his lot falls; according to the tribes of your fathers you<char style="ord">2f</char> shall inherit.</para>
  <para style="p">
    <verse number="55" style="v" />But if you<char style="ord">2f</char> will not drive out the inhabitants of the land from before you; then it shall come to pass, that those which you<char style="ord">2f</char> let remain of them <char style="add">[shall be]</char> pricks in your eyes, and thorns in your sides, and shall vex you in the land wherein you<char style="ord">2f</char> dwell.</para>
  <para style="p">
    <verse number="56" style="v" />Moreover it shall come to pass, <char style="add">[that]</char> I shall do unto you, as I thought to do unto them.</para>
  <chapter number="34" style="c" />
  <para style="p">
    <verse number="1" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="2" style="v" />Command the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, and say unto them, When you<char style="ord">2f</char> come into the land of Kena’an <char style="add">[Merchant]</char>; (this <char style="add">[is]</char> the land that shall fall unto you for an inheritance, <char style="add">[even]</char> the land of Kena’an <char style="add">[Merchant]</char> with the coasts thereof:)</para>
  <para style="p">
    <verse number="3" style="v" />Then your south quarter shall be from the wilderness of Tzin <char style="add">[Flat]</char> along by the coast of Edom <char style="add">[Red]</char>, and your south border shall be the outmost coast of the salt sea eastward:</para>
  <para style="p">
    <verse number="4" style="v" />And your border shall turn from the south to the ascent of ‘Akrabbim <char style="add">[Ascent of Scorpions]</char>, and pass on to Tzin <char style="add">[Flat]</char>: and the going forth thereof shall be from the south to Kadesh <char style="add">[Holy]</char> -Barnea <char style="add">[Holy]</char>, and shall go on to Hatzar-Adar <char style="add">[Enclosure of Glory]</char>, and pass on to ‘Atzmon <char style="add">[Strong]</char>:</para>
  <para style="p">
    <verse number="5" style="v" />And the border shall fetch a compass <char style="pn">(go around, encircle; encompass)</char> from ‘Atzmon <char style="add">[Strong]</char> unto the river of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>, and the goings out of it shall be at the sea.</para>
  <para style="p">
    <verse number="6" style="v" />And <char style="add">[as for]</char> the western border, you<char style="ord">2f</char> shall even have the great sea for a border: this shall be your west border.</para>
  <para style="p">
    <verse number="7" style="v" />And this shall be your north border: from the great sea you<char style="ord">2f</char> shall point out for you mount Hor <char style="add">[Mountain Peak]</char>:</para>
  <para style="p">
    <verse number="8" style="v" />From mount Hor <char style="add">[Mountain Peak]</char> you<char style="ord">2f</char> shall point out <char style="add">[your border]</char> unto the entrance of Hamat <char style="add">[Fortress]</char>; and the goings forth of the border shall be to Tz’dad <char style="add">[Mountain Side]</char>:</para>
  <para style="p">
    <verse number="9" style="v" />And the border shall go on to Zifon <char style="add">[Fragrance]</char>, and the goings out of it shall be at Hatzar-’Einan <char style="add">[Villiage of Fountains]</char>: this shall be your north border.</para>
  <para style="p">
    <verse number="10" style="v" />And you<char style="ord">2f</char> shall point out your east border from Hatzar-’Einan <char style="add">[Village of Fountains]</char> to Sh’fam <char style="add">[Bald]</char>:</para>
  <para style="p">
    <verse number="11" style="v" />And the coast shall go down from Sh’fam <char style="add">[Bald]</char> to Rivlah <char style="add">[Fertility]</char>, on the east side of ‘Ayin <char style="add">[Spring]</char>; and the border shall descend, and shall reach unto the side of the sea of Kinneret <char style="add">[Harps]</char> eastward:</para>
  <para style="p">
    <verse number="12" style="v" />And the border shall go down to Yarden <char style="add">[Descender]</char>, and the goings out of it shall be at the salt sea: this shall be your land with the coasts thereof round about.</para>
  <para style="p">
    <verse number="13" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> commanded the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, saying, This <char style="add">[is]</char> the land which you<char style="ord">2f</char> shall inherit by lot, which the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded to give unto the nine tribes, and to the half tribe:</para>
  <para style="p">
    <verse number="14" style="v" />For the tribe of the children of Re’uven <char style="add">[Behold a Son]</char> according to the house of their fathers, and the tribe of the children of Gad <char style="add">[Good Fortune with Troublesome Effort]</char> according to the house of their fathers, have received <char style="add">[their inheritance]</char>; and half the tribe of M’nasheh <char style="add">[Causing to Forget]</char> have received their inheritance:</para>
  <para style="p">
    <verse number="15" style="v" />The two tribes and the half tribe have received their inheritance on this side Yarden <char style="add">[Descender] [near]</char> Yericho <char style="add">[Its Moon]</char> eastward, toward the sunrising.</para>
  <para style="p">
    <verse number="16" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="17" style="v" />These <char style="add">[are]</char> the names of the men which shall divide the land unto you: El’azar <char style="add">[God has helped]</char> the priest, and Y’hoshua <char style="add">[Yehovah is Salvation]</char> the son of Nun <char style="add">[Posterity]</char>.</para>
  <para style="p">
    <verse number="18" style="v" />And you<char style="ord">2f</char> shall take one prince of every tribe, to divide the land by inheritance.</para>
  <para style="p">
    <verse number="19" style="v" />And the names of the men <char style="add">[are]</char> these: Of the tribe of Y’hudah <char style="add">[Let Him (God) Be Praised]</char>, Kalev <char style="add">[Dog]</char> the son of Y’funeh <char style="add">[He Will Face]</char>.</para>
  <para style="p">
    <verse number="20" style="v" />And of the tribe of the children of Shim’on <char style="add">[he who hears]</char>, Sh’mu’el <char style="add">[His Name is El]</char> the son of Ammihud <char style="add">[People of Magesty]</char>.</para>
  <para style="p">
    <verse number="21" style="v" />Of the tribe of Binyamin <char style="add">[Son of the Right Hand/Strength]</char>, Elidad <char style="add">[My God Has Loved]</char> the son of Kislon <char style="add">[Confidence]</char>.</para>
  <para style="p">
    <verse number="22" style="v" />And the prince of the tribe of the children of Dan <char style="add">[Judge]</char>, Buki <char style="add">[Wasting]</char> the son of Yogli <char style="add">[He is Exiled]</char>.</para>
  <para style="p">
    <verse number="23" style="v" />The prince of the children of Yosef <char style="add">[(God) He Shall Add]</char>, for the tribe of the children of M’nasheh <char style="add">[Causing to Forget]</char>, Hani’el <char style="add">[Favoured of God]</char> the son of Efod <char style="add">[A (Special) Belt (wrapped around)]</char>.</para>
  <para style="p">
    <verse number="24" style="v" />And the prince of the tribe of the children of Efrayim <char style="add">[Doubly Fruitful]</char>, K’mu’el <char style="add">[Raised of God]</char> the son of Shiftan <char style="add">[Judicial]</char>.</para>
  <para style="p">
    <verse number="25" style="v" />And the prince of the tribe of the children of Z’vulun <char style="add">[Glorious Dwelling Place]</char>, Elitzafan <char style="add">[My God has Protected]</char> the son of Parnakh <char style="add">[Delicate]</char>.</para>
  <para style="p">
    <verse number="26" style="v" />And the prince of the tribe of the children of Yissakhar <char style="add">[There Is Recompense]</char>, Palti’el <char style="add">[God Delivers]</char> the son of ‘Azan <char style="add">[Very Strong]</char>.</para>
  <para style="p">
    <verse number="27" style="v" />And the prince of the tribe of the children of Asher <char style="add">[Happy]</char>, Achihud <char style="add">[Brother of Majesty]</char> the son of Shlomi <char style="add">[Peaceful]</char>.</para>
  <para style="p">
    <verse number="28" style="v" />And the prince of the tribe of the children of Naftali <char style="add">[My Wrestling]</char>, P’dah’el <char style="add">[Ransomed by God]</char> the son of Ammihud <char style="add">[People of Magesty]</char>.</para>
  <para style="p">
    <verse number="29" style="v" />These <char style="add">[are they]</char> whom the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded to divide the inheritance unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> in the land of Kena’an <char style="add">[Merchant]</char>.</para>
  <chapter number="35" style="c" />
  <para style="p">
    <verse number="1" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char> in the plains of Mo’av <char style="add">[Seed of my Father]</char> by Yarden <char style="add">[Descender] [near]</char> Yericho <char style="add">[Its Moon]</char>, saying,</para>
  <para style="p">
    <verse number="2" style="v" />Command the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, that they give unto the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> of the inheritance of their possession cities to dwell in; and you<char style="ord">2f</char> shall give <char style="add">[also]</char> unto the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> suburbs for the cities round about them.</para>
  <para style="p">
    <verse number="3" style="v" />And the cities shall they have to dwell in; and the suburbs of them shall be for their cattle, and for their goods, and for all their beasts.</para>
  <para style="p">
    <verse number="4" style="v" />And the suburbs of the cities, which you<char style="ord">2f</char> shall give unto the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char>, <char style="add">[shall reach]</char> from the wall of the city and outward a thousand cubits round about.</para>
  <para style="p">
    <verse number="5" style="v" />And you<char style="ord">2f</char> shall measure from without the city on the east side two thousand cubits, and on the south side two thousand cubits, and on the west side two thousand cubits, and on the north side two thousand cubits; and the city <char style="add">[shall be]</char> in the midst: this shall be to them the suburbs of the cities.</para>
  <para style="p">
    <verse number="6" style="v" />And among the cities which you<char style="ord">2f</char> shall give unto the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to] [there shall be]</char> six cities for refuge, which you<char style="ord">2f</char> shall appoint for the manslayer, that he may flee there: and to them you<char style="ord">2f</char> shall add forty and two cities.</para>
  <para style="p">
    <verse number="7" style="v" />
    <char style="add">[So]</char> all the cities which you<char style="ord">2f</char> shall give to the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to] [shall be]</char> forty and eight cities: them [shall you<char style="ord">2f</char> give] with their suburbs.</para>
  <para style="p">
    <verse number="8" style="v" />And the cities which you<char style="ord">2f</char> shall give <char style="add">[shall be]</char> of the possession of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>: from <char style="add">[them that have]</char> many you<char style="ord">2f</char> shall give many; but from <char style="add">[them that have]</char> few you<char style="ord">2f</char> shall give few: every one shall give of his cities unto the Levi’im <char style="pn">(Levites)</char> <char style="add">[Joined to]</char> according to his inheritance which he inherits.</para>
  <para style="p">
    <verse number="9" style="v" />And the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> spoke unto Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, saying,</para>
  <para style="p">
    <verse number="10" style="v" />Speak unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, and say unto them, When you<char style="ord">2f</char> be come over Yarden <char style="add">[Descender]</char> into the land of Kena’an <char style="add">[Merchant]</char>;</para>
  <para style="p">
    <verse number="11" style="v" />Then you<char style="ord">2f</char> shall appoint you cities to be cities of refuge for you; that the slayer may flee there, which kills any person at unawares.</para>
  <para style="p">
    <verse number="12" style="v" />And they shall be unto you cities for refuge from the avenger; that the manslayer die not, until he stand before the congregation in judgment.</para>
  <para style="p">
    <verse number="13" style="v" />And of these cities which you<char style="ord">2f</char> shall give six cities shall you<char style="ord">2f</char> have for refuge.</para>
  <para style="p">
    <verse number="14" style="v" />You<char style="ord">2f</char> shall give three cities on this side Yarden <char style="add">[Descender]</char>, and three cities shall you<char style="ord">2f</char> give in the land of Kena’an <char style="add">[Merchant]</char>, <char style="add">[which]</char> shall be cities of refuge.</para>
  <para style="p">
    <verse number="15" style="v" />These six cities shall be a refuge, <char style="add">[both]</char> for the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, and for the stranger, and for the sojourner among them: that every one that kills any person unawares may flee there.</para>
  <para style="p">
    <verse number="16" style="v" />And if he strike him with an instrument of iron, so that he die, he <char style="add">[is]</char> a murderer: the murderer shall surely be put to death.</para>
  <para style="p">
    <verse number="17" style="v" />And if he strike him with throwing a stone, which he may die, and he die, he <char style="add">[is]</char> a murderer: the murderer shall surely be put to death.</para>
  <para style="p">
    <verse number="18" style="v" />Or <char style="add">[if]</char> he strike him with an hand weapon of wood, which he may die, and he die, he <char style="add">[is]</char> a murderer: the murderer shall surely be put to death.</para>
  <para style="p">
    <verse number="19" style="v" />The revenger of blood himself shall slay the murderer: when he meets him, he shall slay him.</para>
  <para style="p">
    <verse number="20" style="v" />But if he thrust him of hatred, or hurl at him by laying of wait, that he die;</para>
  <para style="p">
    <verse number="21" style="v" />Or in hatred <char style="pn">(being an enemy)</char> strike him with his hand, that he die: he that struck <char style="add">[him]</char> shall surely be put to death; <char style="add">[for]</char> he <char style="add">[is]</char> a murderer: the revenger of blood shall slay the murderer, when he meets him.</para>
  <para style="p">
    <verse number="22" style="v" />But if he thrust him suddenly without hatred <char style="pn">(being an enemy)</char>, or have cast upon him anything without laying of wait,</para>
  <para style="p">
    <verse number="23" style="v" />Or with any stone, which a man may die, seeing <char style="add">[him]</char> not, and cast <char style="add">[it]</char> upon him, that he die, and <char style="add">[was]</char> not his enemy, neither sought his harm:</para>
  <para style="p">
    <verse number="24" style="v" />Then the congregation shall judge between the slayer and the revenger of blood according to these judgments:</para>
  <para style="p">
    <verse number="25" style="v" />And the congregation shall deliver the slayer out of the hand of the revenger of blood, and the congregation shall restore him to the city of his refuge, to which he was fled: and he shall abide in it unto the death of the High Priest, which was anointed with the holy oil.</para>
  <para style="p">
    <verse number="26" style="v" />But if the slayer shall at any time come without the border of the city of his refuge, to which he was fled;</para>
  <para style="p">
    <verse number="27" style="v" />And the revenger of blood find him without the borders of the city of his refuge, and the revenger of blood kill the slayer; he shall not be guilty of blood:</para>
  <para style="p">
    <verse number="28" style="v" />Because he should have remained in the city of his refuge until the death of the High Priest: but after the death of the High Priest the slayer shall return into the land of his possession.</para>
  <para style="p">
    <verse number="29" style="v" />So these <char style="add">[things]</char> shall be for a statute of judgment unto you throughout your generations in all your dwellings.</para>
  <para style="p">
    <verse number="30" style="v" />Whoso kills any person, the murderer shall be put to death by the mouth of witnesses: but one witness shall not testify against any person <char style="add">[to cause him]</char> to die.</para>
  <para style="p">
    <verse number="31" style="v" />Moreover you<char style="ord">2f</char> shall take no satisfaction for the life of a murderer, which <char style="add">[is]</char> guilty of death: but he shall be surely put to death.</para>
  <para style="p">
    <verse number="32" style="v" />And you<char style="ord">2f</char> shall take no satisfaction for him that is fled to the city of his refuge, that he should come again to dwell in the land, until the death of the priest.</para>
  <para style="p">
    <verse number="33" style="v" />So you<char style="ord">2f</char> shall not pollute the land wherein you<char style="ord">2f</char> <char style="add">[are]</char>: for blood it defiles the land: and the land cannot be cleansed of the blood that is shed in it, but by the blood of him that shed it.</para>
  <para style="p">
    <verse number="34" style="v" />Defile not therefore the land which you<char style="ord">2f</char> shall inhabit, wherein I dwell: for I the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> dwell among the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <chapter number="36" style="c" />
  <para style="p">
    <verse number="1" style="v" />And the chief fathers of the families of the children of Gil’ad <char style="add">[Rocky Region]</char>, the son of Makhir <char style="add">[Sold]</char>, the son of M’nasheh <char style="add">[Causing to Forget]</char>, of the families of the sons of Yosef <char style="add">[(God) He Shall Add]</char>, came near, and spoke before Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, and before the princes, the chief fathers of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>:</para>
  <para style="p">
    <verse number="2" style="v" />And they said, The LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded my lord to give the land for an inheritance by lot to the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>: and my lord was commanded by the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> to give the inheritance of Tz’lof’chad <char style="add">[First-Born]</char> our brother unto his daughters.</para>
  <para style="p">
    <verse number="3" style="v" />And if they be married to any of the sons of the <char style="add">[other]</char> tribes of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, then shall their inheritance be taken from the inheritance of our fathers, and shall be put to the inheritance of the tribe whereunto they are received: so shall it be taken from the lot of our inheritance.</para>
  <para style="p">
    <verse number="4" style="v" />And when the jubilee of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> shall be, then shall their inheritance be put unto the inheritance of the tribe whereunto they are received: so shall their inheritance be taken away from the inheritance of the tribe of our fathers.</para>
  <para style="p">
    <verse number="5" style="v" />And Moshe <char style="add">[He Who Draws Out Of The Waters]</char> commanded the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> according to the word of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, saying, The tribe of the sons of Yosef <char style="add">[(God) He Shall Add]</char> has said well.</para>
  <para style="p">
    <verse number="6" style="v" />This <char style="add">[is]</char> the thing which the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> does command concerning the daughters of Tz’lof’chad <char style="add">[First-Born]</char>, saying, Let them marry to whom they think best; only to the family of the tribe of their father shall they marry.</para>
  <para style="p">
    <verse number="7" style="v" />So shall not the inheritance of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> remove from tribe to tribe: for every one of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> shall keep himself to the inheritance of the tribe of his fathers.</para>
  <para style="p">
    <verse number="8" style="v" />And every daughter, that possesses an inheritance in any tribe of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, shall be wife unto one of the family of the tribe of her father, that the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> may enjoy every man the inheritance of his fathers.</para>
  <para style="p">
    <verse number="9" style="v" />Neither shall the inheritance remove from <char style="add">[one]</char> tribe to another tribe; but every one of the tribes of the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> shall keep himself to his own inheritance.</para>
  <para style="p">
    <verse number="10" style="v" />Even as the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, so did the daughters of Tz’lof’chad <char style="add">[First-Born]</char>:</para>
  <para style="p">
    <verse number="11" style="v" />For Machlah <char style="add">[Disease]</char>, Tirtzah <char style="add">[Favorable]</char>, and Hoglah <char style="add">[Partidge]</char>, and Machlah <char style="add">[Queen]</char>, and No’ah <char style="add">[Motion]</char>, the daughters of Tz’lof’chad <char style="add">[First-Born]</char>, were married unto their father’s brothers’ sons:</para>
  <para style="p">
    <verse number="12" style="v" />
    <char style="add">[And]</char> they were married into the families of the sons of M’nasheh <char style="add">[Causing to Forget]</char> the son of Yosef <char style="add">[(God) He Shall Add]</char>, and their inheritance remained in the tribe of the family of their father.</para>
  <para style="p">
    <verse number="13" style="v" />These <char style="add">[are]</char> the commandments and the judgments, which the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> commanded by the hand of Moshe <char style="add">[He Who Draws Out Of The Waters]</char> unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> in the plains of Mo’av <char style="add">[Seed of my Father]</char> by Yarden <char style="add">[Descender] [near]</char> Yericho <char style="add">[Its Moon]</char>.</para>
</usx>