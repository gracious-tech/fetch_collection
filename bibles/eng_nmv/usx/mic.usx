<?xml version="1.0" encoding="utf-8"?>
<usx version="2.6">
  <book code="MIC" style="id">- Tov Rose New Messianic Version Bible</book>
  <para style="h">Micah</para>
  <para style="mt">Micah</para>
  <chapter number="1" style="c" />
  <para style="p">
    <verse number="1" style="v" />The word of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> that came to Mikhah <char style="add">[Who is Like God?]</char> the Moreshet <char style="add">[possession of Gat (wine-vat)]</char> in the days of Toram <char style="add">[Yehovah is Perfect]</char>, Achaz <char style="add">[he has grasped]</char>, <char style="add">[and]</char> Hizkiyahu <char style="add">[Yehovah is my strength]</char>, kings of Y’hudah <char style="add">[Let Him (God) Be Praised]</char>, which he saw concerning Shomron <char style="add">[watch mountain]</char> and Yerushalayim <char style="add">[Foundation of Peace]</char>.</para>
  <para style="p">
    <verse number="2" style="v" />Hear, all you<char style="ord">2f</char> people; hearken, O earth, and all that in it is: and let the Lord-Adonai <char style="add">[Greatest Above All Things]</char> GOD-Yehōvih <char style="pn">(THE FATHER)</char> be witness against you, the Lord-Adonai <char style="pn">(The Father)</char> from his holy temple.</para>
  <para style="p">
    <verse number="3" style="v" />For, behold, the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> comes forth out of his place, and will come down, and trample upon the high places of the earth.</para>
  <para style="p">
    <verse number="4" style="v" />And the mountains shall be molten under him, and the valleys shall be cleft <char style="pn">(split hoof; an opening, break or split)</char>, as grow <char style="pn">(become; advance)</char> before the fire, <char style="add">[and]</char> as the waters <char style="add">[that are]</char> poured down a steep place.</para>
  <para style="p">
    <verse number="5" style="v" />For the transgression of Ya’akov <char style="add">[Heal of God] [is]</char> all this, and for the sins of the house of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>. What <char style="add">[is]</char> the transgression of Ya’akov <char style="add">[Heal of God]</char>? <char style="add">[is it]</char> not Shomron <char style="add">[watch mountain]</char>? and what <char style="add">[are]</char> the high places of Y’hudah <char style="add">[Let Him (God) Be Praised]</char>? <char style="add">[are they]</char> not Yerushalayim <char style="add">[Foundation of Peace]</char>?</para>
  <para style="p">
    <verse number="6" style="v" />Therefore I will make Shomron <char style="add">[watch mountain]</char> as an heap of the field, <char style="add">[and]</char> as plantings of a vineyard: and I will pour down the stones thereof into the valley, and I will discover <char style="pn">(uncover; reveal; have first sight of)</char> the foundations thereof.</para>
  <para style="p">
    <verse number="7" style="v" />And all the graven images thereof shall be beaten to pieces, and all the hires thereof shall be burned with the fire, and all the idols thereof will I lay desolate: for she gathered <char style="add">[it]</char> of the hire of an prostitute, and they shall return to the hire of an prostitute.</para>
  <para style="p">
    <verse number="8" style="v" />Therefore I will wail and howl, I will go stripped and naked: I will make a wailing like the dragons, and mourning as the owls.</para>
  <para style="p">
    <verse number="9" style="v" />For her wound <char style="add">[is]</char> incurable; for it is come unto Y’hudah <char style="add">[Let Him (God) Be Praised]</char>; he is come unto the gate of my people, <char style="add">[even]</char> to Yerushalayim <char style="add">[Foundation of Peace]</char>.</para>
  <para style="p">
    <verse number="10" style="v" />Declare you<char style="ord">2f</char> <char style="add">[it]</char> not at Gat <char style="add">[Winepress]</char>, weep you<char style="ord">2f</char> not at all: in the Beit-L’afrah <char style="add">[house of dust]</char> roll yourself in the dust.</para>
  <para style="p">
    <verse number="11" style="v" />Pass you<char style="ord">2f</char> away, you<char style="ord">i</char> inhabitant of Safir <char style="add">[faith]</char>, having your<char style="ord">i</char> shame naked: the inhabitant of Tza’anan <char style="add">[pointed]</char> came not forth in the mourning of Beit-Ha’etzel <char style="add">[house of narrowing]</char>; he shall receive of you his standing.</para>
  <para style="p">
    <verse number="12" style="v" />For the inhabitant of Marot <char style="add">[bitterness]</char> waited carefully for good: but evil came down from the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> unto the gate of Yerushalayim <char style="add">[Foundation of Peace]</char>.</para>
  <para style="p">
    <verse number="13" style="v" />O you<char style="ord">i</char> inhabitant of Lakhish <char style="add">[Invincible]</char>, bind the chariot to the swift beast: she <char style="add">[is]</char> the beginning of the sin to the daughter of Tziyon <char style="add">[parched place]</char>: for the transgressions of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> were found in you<char style="ord">i</char>.</para>
  <para style="p">
    <verse number="14" style="v" />Therefore shall you<char style="ord">i</char> give presents to Moreshet-Gat <char style="add">[possession of Gat (winepress)]</char>: the houses of Achziv <char style="add">[Deceit] [shall be]</char> a lie to the kings of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="15" style="v" />Yet will I bring an heir unto you<char style="ord">i</char>, O inhabitant of Mareshah <char style="add">[Crest of a Hill]</char>: he shall come unto ‘Adulam <char style="add">[Justice of the People]</char> the glory of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="16" style="v" />Make you<char style="ord">i</char> bald, and mourn you<char style="ord">i</char> for your<char style="ord">i</char> delicate children; enlarge your<char style="ord">i</char> baldness as the eagle; for they are gone into captivity from you<char style="ord">i</char>.</para>
  <chapter number="2" style="c" />
  <para style="p">
    <verse number="1" style="v" />Woe to them that devise iniquity, and work evil upon their beds! when the morning is light, they practice it, because it is in the power of their hand.</para>
  <para style="p">
    <verse number="2" style="v" />And they covet fields, and take <char style="add">[them]</char> by violence; and houses, and take <char style="add">[them]</char> away: so they oppress a man and his house, even a man and his heritage.</para>
  <para style="p">
    <verse number="3" style="v" />Therefore thus says the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>; Behold, against this family do I devise an evil, from which you<char style="ord">2f</char> shall not remove your necks; neither shall you<char style="ord">2f</char> go haughtily: for this time <char style="add">[is]</char> evil.</para>
  <para style="p">
    <verse number="4" style="v" />In that day shall <char style="add">[one]</char> take up a parable against you, and lament with a doleful <char style="pn">(mournful cry; sorrowful howl)</char> lamentation, <char style="add">[and]</char> say, We be utterly spoiled: he has changed the portion of my people: how has he removed <char style="add">[it]</char> from me! turning away he has divided our fields.</para>
  <para style="p">
    <verse number="5" style="v" />Therefore you<char style="ord">i</char> shall have none that shall cast a cord by lot in the congregation of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="6" style="v" />Prophesy you<char style="ord">2f</char> not, <char style="add">[say they to them that]</char> prophesy: they shall not prophesy to them, <char style="add">[that]</char> they shall not take shame.</para>
  <para style="p">
    <verse number="7" style="v" />O [you<char style="ord">i</char> that are] named the house of Ya’akov <char style="add">[Heal of God]</char>, is the Spirit of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> straitened (impeded or restricted; narrowed, distressed)? <char style="add">[are]</char> these his doings? do not my words do good to him that walks uprightly?</para>
  <para style="p">
    <verse number="8" style="v" />Even of late my people is risen up as an enemy: you<char style="ord">2f</char> pull off the robe with the garment from them that pass by securely as men averse <char style="pn">(disliking, turned from)</char> from war.</para>
  <para style="p">
    <verse number="9" style="v" />The women of my people have you<char style="ord">2f</char> cast out from their pleasant houses; from their children have you<char style="ord">2f</char> taken away my glory forever.</para>
  <para style="p">
    <verse number="10" style="v" />Arise you<char style="ord">2f</char>, and depart; for this <char style="add">[is]</char> not <char style="add">[your]</char> rest: because it is polluted, it shall destroy <char style="add">[you]</char>, even with a sore destruction.</para>
  <para style="p">
    <verse number="11" style="v" />If a man walking in the spirit and falsehood do lie, <char style="add">[saying]</char>, I will prophesy unto you<char style="ord">i</char> of wine and of strong drink; he shall even be the prophet of this people.</para>
  <para style="p">
    <verse number="12" style="v" />I will surely assemble, O Ya’akov <char style="add">[Heal of God]</char>, all of you<char style="ord">i</char>; I will surely gather the remnant of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>; I will put them together as the sheep of Botzrah <char style="add">[sheepfold or fortress]</char>, as the flock in the midst of their fold: they shall make great noise by reason of <char style="add">[the multitude of]</char> men.</para>
  <para style="p">
    <verse number="13" style="v" />The breaker is come up before them: they have broken up, and have passed through the gate, and are gone out by it: and their king shall pass before them, and the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> on the head of them.</para>
  <chapter number="3" style="c" />
  <para style="p">
    <verse number="1" style="v" />And I said, Hear, I pray you, O heads of Ya’akov <char style="add">[Heal of God]</char>, and you<char style="ord">2f</char> princes of the house of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>; <char style="add">[Is it]</char> not for you to know judgment?</para>
  <para style="p">
    <verse number="2" style="v" />Who hate the good, and love the evil; who pluck off their skin from off them, and their flesh from off their bones;</para>
  <para style="p">
    <verse number="3" style="v" />Who also eat the flesh of my people, and flay <char style="pn">(stip the skin off)</char> their skin from off them; and they break their bones, and chop them in pieces, as for the pot, and as flesh within the caldron.</para>
  <para style="p">
    <verse number="4" style="v" />Then shall they cry unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, but he will not hear them: he will even hide his face from them at that time, as they have behaved themselves ill in their doings.</para>
  <para style="p">
    <verse number="5" style="v" />Thus says the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> concerning the prophets that make my people err, that bite with their teeth, and cry, Peace; and he that puts not into their mouths, they even prepare war against him.</para>
  <para style="p">
    <verse number="6" style="v" />Therefore night <char style="add">[shall be]</char> unto you, that you<char style="ord">2f</char> shall not have a vision; and it shall be dark unto you, that you<char style="ord">2f</char> shall not divine; and the sun shall go down over the prophets, and the day shall be dark over them.</para>
  <para style="p">
    <verse number="7" style="v" />Then shall the seers be ashamed, and the diviners confounded: yes, they shall all cover their lips; for <char style="add">[there is]</char> no answer of God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>.</para>
  <para style="p">
    <verse number="8" style="v" />But truly I am full of power by the Spirit of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and of judgment, and of might, to declare unto Ya’akov <char style="add">[Heal of God]</char> his transgression, and to Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> his sin.</para>
  <para style="p">
    <verse number="9" style="v" />Hear this, I pray you, you<char style="ord">2f</char> heads of the house of Ya’akov <char style="add">[Heal of God]</char>, and princes of the house of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>, that abhor judgment, and pervert all equity.</para>
  <para style="p">
    <verse number="10" style="v" />They build up Tziyon <char style="add">[parched place]</char> with blood, and Yerushalayim <char style="add">[Foundation of Peace]</char> with iniquity.</para>
  <para style="p">
    <verse number="11" style="v" />The heads thereof judge for reward, and the priests thereof teach for hire, and the prophets thereof divine for money: yet will they lean upon the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and say, <char style="add">[Is]</char> not the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> among us? none evil can come upon us.</para>
  <para style="p">
    <verse number="12" style="v" />Therefore shall Tziyon <char style="add">[parched place]</char> for your sake be plowed <char style="add">[as]</char> a field, and Yerushalayim <char style="add">[Foundation of Peace]</char> shall become heaps, and the mountain of the house as the high places of the forest.</para>
  <chapter number="4" style="c" />
  <para style="p">
    <verse number="1" style="v" />But in the last days it shall come to pass, <char style="add">[that]</char> the mountain of the house of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> shall be established in the top of the mountains, and it shall be exalted above the hills; and people shall flow unto it.</para>
  <para style="p">
    <verse number="2" style="v" />And many nations shall come, and say, Come, and let us go up to the mountain of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and to the house of the God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> of Ya’akov <char style="add">[Heal of God]</char>; and he will teach us of his ways, and we will walk in his paths: for the law shall go forth of Tziyon <char style="add">[parched place]</char>, and the word of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> from Yerushalayim <char style="add">[Foundation of Peace]</char>.</para>
  <para style="p">
    <verse number="3" style="v" />And he shall judge among many people, and rebuke <char style="pn">(reprimand; strongly warn; restrain)</char> strong nations afar off; and they shall beat their swords into plowshares, and their spears into pruninghooks: nation shall not lift up a sword against nation, neither shall they learn war any more.</para>
  <para style="p">
    <verse number="4" style="v" />But they shall sit every man under his vine and under his fig tree; and none shall make <char style="add">[them]</char> afraid: for the mouth of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> Tz’va’ot <char style="add">[of the Heavenly Armies]</char> has spoken <char style="add">[it]</char>.</para>
  <para style="p">
    <verse number="5" style="v" />For all people will walk everyone in the name of his god, and we will walk in the name of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> our God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> forever and ever.</para>
  <para style="p">
    <verse number="6" style="v" />In that day, says the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, will I assemble her that is lame, and I will gather her that is driven out, and her that I have afflicted;</para>
  <para style="p">
    <verse number="7" style="v" />And I will make her that halted a remnant, and her that was cast far off a strong nation: and the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> shall reign over them in mount Tziyon <char style="add">[parched place]</char> from from this time forth <char style="pn">(from now on)</char>, even forever.</para>
  <para style="p">
    <verse number="8" style="v" />And you<char style="ord">i</char>, O tower of the flock, the strong hold of the daughter of Tziyon <char style="add">[parched place]</char>, unto you<char style="ord">i</char> shall it come, even the first dominion; the kingdom shall come to the daughter of Yerushalayim <char style="add">[Foundation of Peace]</char>.</para>
  <para style="p">
    <verse number="9" style="v" />Now why do you<char style="ord">i</char> cry out aloud? <char style="add">[is there]</char> no king in you<char style="ord">i</char>? is your<char style="ord">i</char> counselor perished? for pangs <char style="pn">(extreme sharp pains)</char> have taken you<char style="ord">i</char> as a woman in travail.</para>
  <para style="p">
    <verse number="10" style="v" />Be in pain, and labour to bring forth, O daughter of Tziyon <char style="add">[parched place]</char>, like a woman in travail: for now shall you<char style="ord">i</char> go forth out of the city, and you<char style="ord">i</char> shall dwell in the field, and you<char style="ord">i</char> shall go <char style="add">[even]</char> to Bavel <char style="pn">(to jumble, or a confused medley of sounds; confusion; gate of the deity)</char> <char style="pn">(Babylon)</char> <char style="add">[confusion]</char>; there shall you<char style="ord">i</char> be delivered; there the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> shall redeem you<char style="ord">i</char> from the hand of you<char style="ord">i</char> enemies.</para>
  <para style="p">
    <verse number="11" style="v" />Now also many nations are gathered against you<char style="ord">i</char>, that say, Let her be defiled, and let our eye look upon Tziyon <char style="add">[parched place]</char>.</para>
  <para style="p">
    <verse number="12" style="v" />But they know not the thoughts of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, neither understand they his counsel: for he shall gather them as the sheaves into the floor.</para>
  <para style="p">
    <verse number="13" style="v" />Arise and thresh, O daughter of Tziyon <char style="add">[parched place]</char>: for I will make your<char style="ord">i</char> horn iron, and I will make your<char style="ord">i</char> hoofs brass: and you<char style="ord">i</char> shall beat in pieces many people: and I will consecrate <char style="pn">(treat as set apart or separate unto God)</char> their gain unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, and their substance unto the Lord-Adon of the whole earth.</para>
  <chapter number="5" style="c" />
  <para style="p">
    <verse number="1" style="v" />Now gather yourself in troops, O daughter of troops: he has laid siege against us: they shall strike the judge of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char> with a rod upon the cheek.</para>
  <para style="p">
    <verse number="2" style="v" />But you<char style="ord">i</char>, Beit-Lechem <char style="add">[House of Bread]</char> Ephrat [ash-heap: place of fruitfulness], <char style="add">[though]</char> you<char style="ord">i</char> be little among the thousands of Y’hudah <char style="add">[Let Him (God) Be Praised]</char>, <char style="add">[yet]</char> out of you<char style="ord">i</char> shall he come forth unto me <char style="add">[that is]</char> to be ruler in Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>; whose goings forth <char style="add">[have been]</char> from of old, from everlasting.</para>
  <para style="p">
    <verse number="3" style="v" />Therefore will he give them up, until the time <char style="add">[that]</char> she which travails has brought forth: then the remnant of his brethren shall return unto the people of Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="4" style="v" />And he shall stand and feed in the strength of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, in the majesty of the name of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> his God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>; and they shall abide: for now shall he be great unto the ends of the earth.</para>
  <para style="p">
    <verse number="5" style="v" />And this <char style="add">[man]</char> shall be the peace, when the Ashur <char style="pn">(Assyrian)</char> shall come into our land: and when he shall trample in our palaces, then shall we raise against him seven shepherds, and eight principal men.</para>
  <para style="p">
    <verse number="6" style="v" />And they shall waste the land of Ashur <char style="add">[the level plain]</char> <char style="pn">(the land of the sons of Shem (name, renown (great reputation; being well-known)))</char> with the sword, and the land of Nimrod in the entrances thereof: thus shall he deliver <char style="add">[us]</char> from the Ashur <char style="pn">(Assyrian)</char>, when he comes into our land, and when he treads within our borders.</para>
  <para style="p">
    <verse number="7" style="v" />And the remnant of Ya’akov <char style="add">[Heal of God]</char> shall be in the midst of many people as a dew from the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, as the showers upon the grass, that tarries not for man, nor waits for the sons of men.</para>
  <para style="p">
    <verse number="8" style="v" />And the remnant of Ya’akov <char style="add">[Heal of God]</char> shall be among the Gentiles in the midst of many people as a lion among the beasts of the forest, as a young lion among the flocks of sheep: who, if he go through, both treads down, and tears in pieces, and none can deliver.</para>
  <para style="p">
    <verse number="9" style="v" />You<char style="ord">1s</char> hand shall be lifted up upon your<char style="ord">i</char> adversaries, and all your<char style="ord">i</char> enemies shall be cut off.</para>
  <para style="p">
    <verse number="10" style="v" />And it shall come to pass in that day, says the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, that I will cut off your<char style="ord">i</char> horses out of the midst of you<char style="ord">i</char>, and I will destroy your<char style="ord">i</char> chariots:</para>
  <para style="p">
    <verse number="11" style="v" />And I will cut off the cities of your<char style="ord">i</char> land, and throw down all your<char style="ord">i</char> strong holds:</para>
  <para style="p">
    <verse number="12" style="v" />And I will cut off witchcrafts out of your<char style="ord">i</char> hand; and you<char style="ord">i</char> shall have no <char style="add">[more]</char> soothsayers:</para>
  <para style="p">
    <verse number="13" style="v" />Your<char style="ord">1s</char> graven images also will I cut off, and your<char style="ord">i</char> standing images out of the midst of you<char style="ord">i</char>; and you<char style="ord">i</char> shall no more worship the work of your<char style="ord">i</char> hands.</para>
  <para style="p">
    <verse number="14" style="v" />And I will pluck up your<char style="ord">i</char> Asherim <char style="add">[false goddess]</char> out of the midst of you<char style="ord">i</char>: so will I destroy your<char style="ord">i</char> cities.</para>
  <para style="p">
    <verse number="15" style="v" />And I will execute vengeance in anger and fury upon the heathen, such as they have not heard.</para>
  <chapter number="6" style="c" />
  <para style="p">
    <verse number="1" style="v" />Hear you<char style="ord">2f</char> now what the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> says; Arise, contend you<char style="ord">i</char> before the mountains, and let the hills hear you<char style="ord">i</char> voice.</para>
  <para style="p">
    <verse number="2" style="v" />Hear you<char style="ord">2f</char>, O mountains, the LORD-Yehōvah’s <char style="add">[Messiah Pre-Incarnate]</char> controversy, and you<char style="ord">2f</char> strong foundations of the earth: for the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> has a controversy with his people, and he will plead with Yisra’el <char style="add">[He Holds Onto The Heel Of God]</char>.</para>
  <para style="p">
    <verse number="3" style="v" />O my people, what have I done unto you<char style="ord">i</char>? and wherein have I wearied you<char style="ord">i</char>? testify against me.</para>
  <para style="p">
    <verse number="4" style="v" />For I brought you<char style="ord">i</char> up out of the land of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char>, and redeemed you<char style="ord">i</char> out of the house of servants; and I sent before you<char style="ord">i</char> Moshe <char style="add">[He Who Draws Out Of The Waters]</char>, Aharon <char style="add">[Bright, Very High]</char>, and Miryam <char style="add">[rebellion]</char>.</para>
  <para style="p">
    <verse number="5" style="v" />O my people, remember now what Balak <char style="add">[Devastator]</char> king of Mo’av <char style="add">[Seed of my Father]</char> consulted, and what Bil’am <char style="add">[Not of the People]</char> the son of B’or <char style="add">[Burning]</char> answered him from Sheetim <char style="add">[The Acacias]</char> unto Gilgal <char style="add">[A Wheel, Rolling]</char>; that you<char style="ord">2f</char> may know the righteousness of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>.</para>
  <para style="p">
    <verse number="6" style="v" />Wherewith shall I come before the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, <char style="add">[and]</char> bow myself before the high God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>? shall I come before him with burnt offerings, with calves of a year old?</para>
  <para style="p">
    <verse number="7" style="v" />Will the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> be pleased with thousands of rams, <char style="add">[or]</char> with ten thousands of rivers of oil? shall I give my firstborn <char style="add">[for]</char> my transgression, the fruit of my body <char style="add">[for]</char> the sin of my soul?</para>
  <para style="p">
    <verse number="8" style="v" />He has showed you<char style="ord">i</char>, O man, what <char style="add">[is]</char> good; and what does the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> require of you<char style="ord">i</char>, but to do justly, and to love mercy, and to walk humbly with your<char style="ord">i</char> God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>?</para>
  <para style="p">
    <verse number="9" style="v" />The LORD-Yehōvah’s <char style="add">[Messiah Pre-Incarnate]</char> voice cries unto the city, and <char style="add">[the man of]</char> wisdom shall see you<char style="ord">i</char> name: hear you<char style="ord">2f</char> the rod, and who has appointed it.</para>
  <para style="p">
    <verse number="10" style="v" />Are there yet the treasures of wickedness in the house of the wicked, and the scant measure <char style="add">[that is]</char> abominable?</para>
  <para style="p">
    <verse number="11" style="v" />Shall I count <char style="add">[them]</char> pure with the wicked balances, and with the bag of deceitful weights?</para>
  <para style="p">
    <verse number="12" style="v" />For the rich men thereof are full of violence, and the inhabitants thereof have spoken lies, and their tongue <char style="add">[is]</char> deceitful in their mouth.</para>
  <para style="p">
    <verse number="13" style="v" />Therefore also will I make <char style="pn">[you<char style="ord">i</char>]</char> sick in attacking you<char style="ord">i</char>, in making <char style="pn">[you<char style="ord">i</char>]</char> desolate because of your<char style="ord">i</char> sins.</para>
  <para style="p">
    <verse number="14" style="v" />you<char style="ord">i</char> shall eat, but not be satisfied; and your<char style="ord">i</char> casting down <char style="add">[shall be]</char> in the midst of you<char style="ord">i</char>; and you<char style="ord">i</char> shall take hold, but shall not deliver; and <char style="add">[that]</char> which you<char style="ord">i</char> deliver will I give up to the sword.</para>
  <para style="p">
    <verse number="15" style="v" />you<char style="ord">i</char> shall sow, but you<char style="ord">i</char> shall not reap; you<char style="ord">i</char> shall trample the olives, but you<char style="ord">i</char> shall not anoint yourselfi with oil; and sweet wine, but shall not drink wine.</para>
  <para style="p">
    <verse number="16" style="v" />For the statutes of ‘Omri <char style="add">[pupil of Yehovah]</char> are kept, and all the works of the house of Ach’av <char style="add">[father’s brother]</char>, and you<char style="ord">2f</char> walk in their counsels; that I should make you<char style="ord">i</char> a desolation, and the inhabitants thereof an hissing: therefore you<char style="ord">2f</char> shall bear the reproach <char style="pn">(disgrace; shame)</char> of my people.</para>
  <chapter number="7" style="c" />
  <para style="p">
    <verse number="1" style="v" />Woe is me! for I am as when they have gathered the summer fruits, as the grapegleanings of the vintage: <char style="add">[there is]</char> no cluster to eat: my soul desired the firstripe fruit.</para>
  <para style="p">
    <verse number="2" style="v" />The good <char style="add">[man]</char> is perished out of the earth: and <char style="add">[there is]</char> none upright among men: they all lie in wait for blood; they hunt every man his brother with a net.</para>
  <para style="p">
    <verse number="3" style="v" />That they may do evil with both hands earnestly, the prince asks, and the judge <char style="add">[asks]</char> for a reward; and the great <char style="add">[man]</char>, he utters his mischievous desire: so they wrap it up.</para>
  <para style="p">
    <verse number="4" style="v" />The best of them <char style="add">[is]</char> as a brier: the most upright <char style="add">[is sharper]</char> than a thorn hedge: the day of your<char style="ord">i</char> watchmen <char style="add">[and]</char> your<char style="ord">i</char> visitation comes; now shall be their perplexity.</para>
  <para style="p">
    <verse number="5" style="v" />Trust you<char style="ord">2f</char> not in a friend, put you<char style="ord">2f</char> not confidence in a guide: keep the doors of you<char style="ord">i</char> mouth from her that lies in you<char style="ord">i</char> bosom.</para>
  <para style="p">
    <verse number="6" style="v" />For the son dishonours the father, the daughter rises up against her mother, the daughter in law against her mother in law; a man’s enemies <char style="add">[are]</char> the men of his own house.</para>
  <para style="p">
    <verse number="7" style="v" />Therefore I will look unto the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>; I will wait for the God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> of my salvation: my God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> will hear me.</para>
  <para style="p">
    <verse number="8" style="v" />Rejoice not against me, O my enemy: when I fall, I shall arise; when I sit in darkness, the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> <char style="add">[shall be]</char> a light unto me.</para>
  <para style="p">
    <verse number="9" style="v" />I will bear the indignation of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char>, because I have sinned against him, until he plead my cause, and execute judgment for me: he will bring me forth to the light, <char style="add">[and]</char> I shall behold his righteousness.</para>
  <para style="p">
    <verse number="10" style="v" />Then <char style="add">[she that is]</char> my enemy shall see <char style="add">[it]</char>, and shame shall cover her which said unto me, Where is the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> you<char style="ord">i</char> God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>? my eyes shall behold her: now shall she be trampled down as the mire of the streets.</para>
  <para style="p">
    <verse number="11" style="v" />
    <char style="add">[In]</char> the day that your<char style="ord">i</char> walls are to be built, <char style="add">[in]</char> that day shall the decree be far removed.</para>
  <para style="p">
    <verse number="12" style="v" />
    <char style="add">[In]</char> that day <char style="add">[also]</char> he shall come even to you<char style="ord">i</char> from Ashur <char style="add">[the level plain]</char> <char style="pn">(the land of the sons of Shem (name, renown (great reputation; being well-known)))</char>, and <char style="add">[from]</char> the fortified cities, and from the fortress even to the river, and from sea to sea, and <char style="add">[from]</char> mountain to mountain.</para>
  <para style="p">
    <verse number="13" style="v" />Yet the land shall be desolate because of them that dwell in it, for the fruit of their doings.</para>
  <para style="p">
    <verse number="14" style="v" />Feed you<char style="ord">i</char> people with your<char style="ord">i</char> rod, the flock of your<char style="ord">i</char> heritage, which dwell solitarily <char style="add">[in]</char> the wood, in the midst of Carmel <char style="add">[Garden-land]</char>: let them feed <char style="add">[in]</char> Bashan <char style="add">[Fruitful]</char> and Gil’ad <char style="add">[Rocky Region]</char>, as in the days of old.</para>
  <para style="p">
    <verse number="15" style="v" />According to the days of your<char style="ord">i</char> coming out of the land of Mitzrayim <char style="add">[Egypt - The Narrow Place]</char> will I show unto him marvelous <char style="add">[things]</char>.</para>
  <para style="p">
    <verse number="16" style="v" />The nations shall see and be confounded at all their might: they shall lay <char style="add">[their]</char> hand upon <char style="add">[their]</char> mouth, their ears shall be deaf.</para>
  <para style="p">
    <verse number="17" style="v" />They shall lick the dust like a serpent, they shall move out of their holes like worms of the earth: they shall be afraid of the LORD-Yehōvah <char style="pn">(Messiah Pre-Incarnate)</char> our God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char>, and shall fear because of you<char style="ord">i</char>.</para>
  <para style="p">
    <verse number="18" style="v" />Who <char style="add">[is]</char> a God-Elōhīm <char style="pn">(The Living Word)</char> <char style="add">[The Many Powered]</char> like unto you<char style="ord">i</char>, that pardons iniquity, and passes by the transgression of the remnant of his heritage? he retains not his anger forever, because he delights <char style="add">[in]</char> mercy.</para>
  <para style="p">
    <verse number="19" style="v" />He will turn again, he will have compassion upon us; he will subdue our iniquities; and you<char style="ord">i</char> will cast all their sins into the depths of the sea.</para>
  <para style="p">
    <verse number="20" style="v" />you<char style="ord">i</char> will perform the tto Ya’akov <char style="add">[Heal of God]</char>, <char style="add">[and]</char> the mercy to Avraham <char style="add">[Exalted Father]</char>, which you<char style="ord">i</char> have sworn unto our fathers from the days of old.</para>
</usx>