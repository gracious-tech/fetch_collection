  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1" />เหล้า/ทำให้/คน/ปากพล่อย ของ/มึนเมา/ทำให้/คน/เอะอะ/โวยวาย</para>
  <para style="q1" vid="PRO 20:1">และ/ผู้/ใด/ยอมให้/มัน/พา/หลง/เตลิด/ไป/ก็/ไม่ฉลาด<verse eid="PRO 20:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2" />พระ/พิโรธ/ของ/กษัตริย์/ทำให้/คน/หวาดผวา/ดั่ง/ฟัง/เสียง/คำราม/ของ/ราชสีห์</para>
  <para style="q1" vid="PRO 20:2">การยั่วยุ/พระ/พิโรธ/ของ/พระองค์/เป็น/การ/เอา/ชีวิต/ไป/ทิ้ง<verse eid="PRO 20:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3" />หลีกเลี่ยง/การ/ทะเลาะเบาะแว้ง/ถือเป็น/เกียรติ/อย่าง/หนึ่ง</para>
  <para style="q1" vid="PRO 20:3">มี/แต่/คน/โง่/เท่านั้น/ที่/ชอบ/หา/เรื่อง<verse eid="PRO 20:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4" />คน/เกียจคร้าน/ไม่ยอม/ไถ/หว่าน/เมื่อ/ถึง/ฤดู</para>
  <para style="q1" vid="PRO 20:4">ดังนั้น/เมื่อ/ถึง/เวลา/เก็บเกี่ยว/ก็/จะ/ไม่มี/อะไร/กิน<verse eid="PRO 20:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5" />ความคิด/ดี/เหมือน/น้ำ/ที่/อยู่/ลึก/ใน/ใจ/คน</para>
  <para style="q1" vid="PRO 20:5">แต่/คน/ที่/มี/ความ/เข้าใจ/ก็/ตัก/มัน/ออกมา/ได้<verse eid="PRO 20:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6" />คน/มากมาย/อ้างว่า/ตน/มี/ความ/รัก/มั่นคง</para>
  <para style="q1" vid="PRO 20:6">แต่/ใคร/เล่า/จะ/พบ/คน/ซื่อสัตย์?<verse eid="PRO 20:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7" />คน/ชอบธรรม/ดำเนิน/ชีวิต/อย่าง/ไร้/ที่ติ</para>
  <para style="q1" vid="PRO 20:7">ลูกหลาน/ของเขา/ย่อม/ได้รับ/พร<verse eid="PRO 20:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8" />เมื่อ/กษัตริย์/ประทับ/บนบัลลังก์/พิพากษา</para>
  <para style="q1" vid="PRO 20:8">พระเนตร/ของ/พระองค์/ทรง/ฝัดร่อน/ความชั่ว/ทั้งปวง/ออก<verse eid="PRO 20:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9" />ไม่มี/ใคร/กล่าว/ได้/ว่า “ข้าพเจ้า/ได้/รักษาใจ/ของ/ตน/ให้/บริสุทธิ์</para>
  <para style="q1" vid="PRO 20:9">ข้าพเจ้า/สะอาด/ปราศจาก/บาป”<verse eid="PRO 20:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10" />ตราชั่ง/ไม่/เที่ยง/กับ/เครื่อง/ตวง/ไม่/ได้/ขนาด</para>
  <para style="q1" vid="PRO 20:10">
    <char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรง/ชิงชัง/ทั้งคู่<verse eid="PRO 20:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11" />แม้/เด็กๆ เรา/ก็/มอง/ออก/ได้/จาก/การ/กระทำ/ของเขา</para>
  <para style="q1" vid="PRO 20:11">ดังนั้น/ชีวิต/ของเขา/บริสุทธิ์/ถูกต้อง/จริงหรือ?<verse eid="PRO 20:11" /></para>
  <para style="b" />
  <para style="q1">
