<usx version="3.0">
  <book code="1CH" style="id">- Biblica® Open Thai New Contemporary Version 2007</book>
  <para style="rem">Copyright © 1999, 2001, 2007 by Biblica, Inc.</para>
  <para style="h">1 พงศาวดาร</para>
  <para style="toc1">1 พงศาวดาร</para>
  <para style="toc2">1 พงศาวดาร</para>
  <para style="toc3">1พศด.</para>
  <para style="mt1">1 พงศาวดาร</para>
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="s1">บันทึก/ประวัติศาสตร์/ตั้งแต่/อาดัม/ถึง/อับราฮัม</para>
  <para style="s2">จาก/อาดัม/ถึง/บุตร/ทั้งหลาย/ของ/โนอาห์</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 1:1" />อาดัม เสท เอโนช <verse eid="1CH 1:1" /><verse number="2" style="v" sid="1CH 1:2" />เคนัน มาหะลาเลล ยาเรด <verse eid="1CH 1:2" /><verse number="3" style="v" sid="1CH 1:3" />เอโนค เมธูเสลาห์ ลาเมค โนอาห์<verse eid="1CH 1:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 1:4" />บุตร/ของ/โนอาห์ ได้แก่<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">ภาษาฮีบรู/ไม่มี/ข้อความ/ว่า/</char><char style="fqa" closed="false">บุตร/ของ/โนอาห์/ได้แก่</char></note></para>
  <para style="li1" vid="1CH 1:4">เชม ฮาม และ/ยาเฟท<verse eid="1CH 1:4" /></para>
  <para style="s2">เชื้อสาย/ของ/ยาเฟท</para>
  <para style="r">(<ref loc="GEN 10:2-5">ปฐก.10:2-5</ref>)</para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 1:5" />บุตร<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">คำ/ว่า/</char><char style="fqa" closed="false">บุตร/</char><char style="ft" closed="false">อาจ/หมายถึง วงศ์วาน ทายาท หรือ ชนชาติ ก็/ได้ เช่น/เดียว/กับ/ข้อ 6-10,17 และ 20</char></note>ของ/ยาเฟท ได้แก่</para>
  <para style="li1" vid="1CH 1:5">โกเมอร์ มาโกก มาดัย ยาวาน ทูบัล เมเชค และ/ทิราส<verse eid="1CH 1:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 1:6" />บุตร/ของ/โกเมอร์ ได้แก่</para>
  <para style="li1" vid="1CH 1:6">อัชเคนัส รีฟาท<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">สำเนา/ต้นฉบับ/ภาษาฮีบรู/ส่วนใหญ่/ว่า/</char><char style="fqa" closed="false">ดีฟัท</char></note> และ/โทการมาห์<verse eid="1CH 1:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 1:7" />บุตร/ของ/ยาวาน ได้แก่</para>
  <para style="li1" vid="1CH 1:7">เอลีชาห์ ทารชิช คิททิม และ/โรดานิม<verse eid="1CH 1:7" /></para>
  <para style="s1">เชื้อสาย/ของ/ฮาม</para>
  <para style="r">(<ref loc="GEN 10:6-20">ปฐก.10:6-20</ref>)</para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 1:8" />บุตร/ของ/ฮาม ได้แก่</para>
  <para style="li1" vid="1CH 1:8">คูช มิสราอิม<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">คือ อียิปต์ เช่น/เดียว/กับ/ข้อ 11</char></note> พูต และ/คานาอัน<verse eid="1CH 1:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 1:9" />บุตร/ของ/คูช ได้แก่</para>
  <para style="li1" vid="1CH 1:9">เสบา ฮาวิลาห์ สับทา ราอามาห์ และ/สับเทคา</para>
  <para style="li1" vid="1CH 1:9">บุตร/ของ/ราอามาห์ ได้แก่</para>
  <para style="li1" vid="1CH 1:9">เชบา/กับ/เดดาน<verse eid="1CH 1:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 1:10" />คูช/เป็น/บิดา<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">คำ/ว่า/</char><char style="fqa" closed="false">บิดา/</char><char style="ft" closed="false">อาจ/หมายถึง บรรพบุรุษ ต้นตระกูล หรือ/ผู้/ก่อตั้ง เช่น/เดียว/กับ/ข้อ 11,13,18 และ 20</char></note>ของ</para>
  <para style="li1" vid="1CH 1:10">นิมโรด/ซึ่ง/ต่อมา/ได้/เป็น/นักรบ/ผู้/ยิ่งใหญ่/ของ/โลก<verse eid="1CH 1:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 1:11" />มิสราอิม/เป็น/บิดา/ของ</para>
  <para style="li1" vid="1CH 1:11">ชาวลูดิม ชาว/อานามิม ชาว/เลหะบิม ชาว/นัฟทูฮิม <verse eid="1CH 1:11" /><verse number="12" style="v" sid="1CH 1:12" />ชาว/ปัทรุสิม ชาว/คัสลูฮิม (ซึ่งเป็น/บรรพบุรุษ/ของ/ชาว/ฟีลิสเตีย) และ/ชาว/คัฟโทร์<verse eid="1CH 1:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 1:13" />คานาอัน/เป็น/บิดา/ของ</para>
  <para style="li1" vid="1CH 1:13">ไซดอน/ผู้/เป็น/บุตร/หัวปี<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">หรือ/</char><char style="fqa" closed="false">ชาว/ไซดอน/พวก/แรก/สุด</char></note> และ/ของ/ชาว/ฮิตไทต์ <verse eid="1CH 1:13" /><verse number="14" style="v" sid="1CH 1:14" />ชาว/เยบุส ชาว/อาโมไรต์ ชาว/เกอร์กาชี <verse eid="1CH 1:14" /><verse number="15" style="v" sid="1CH 1:15" />ชาว/ฮีไวต์ ชาว/อารคี ชาว/สินี <verse eid="1CH 1:15" /><verse number="16" style="v" sid="1CH 1:16" />ชาว/อารวัด ชาว/เศเมอร์ และ/ชาว/ฮามัท<verse eid="1CH 1:16" /></para>
  <para style="s2">เชื้อสาย/ของ/เชม</para>
  <para style="r">(<ref loc="GEN 10:21-31">ปฐก.10:21-31</ref>; <ref loc="GEN 11:10-27">11:10-27</ref>)</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 1:17" />บุตร/ของ/เชม ได้แก่</para>
  <para style="li1" vid="1CH 1:17">เอลาม อัสชูร์ อารปัคชาด ลูด และ/อารัม</para>
  <para style="li1" vid="1CH 1:17">บุตร/ของ/อารัม ได้แก่<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">สำเนา/ต้นฉบับ/ภาษาฮีบรู/ส่วนใหญ่/ไม่มี/ประโยคนี้ (ดู/<char style="xt"><ref loc="GEN 10:23">ปฐก.10:23</ref></char>)</char></note></para>
  <para style="li1" vid="1CH 1:17">อูส ฮูล เกเธอร์ และ/เมเชค<verse eid="1CH 1:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 1:18" />อารปัคชาด/เป็น/บิดา/ของ/เชลาห์</para>
  <para style="li1" vid="1CH 1:18">เชลาห์/เป็น/บิดา/ของ/เอเบอร์<verse eid="1CH 1:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 1:19" />เอเบอร์/มี/บุตร/ชาย/สอง/คน ได้แก่</para>
  <para style="li1" vid="1CH 1:19">เปเลก<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false">แปลว่า แยก</char></note> เพราะ/โลก/ถูกแบ่ง/แยก/ใน/ช่วงชีวิต/ของ/เปเลก และ/อีก/คน/หนึ่ง/คือ โยกทาน<verse eid="1CH 1:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 1:20" />โยกทาน/เป็น/บิดา/ของ</para>
  <para style="li1" vid="1CH 1:20">อัลโมดัด เชเลฟ ฮาซารมาเวท เยราห์ <verse eid="1CH 1:20" /><verse number="21" style="v" sid="1CH 1:21" />ฮาโดรัม อุซาล ดิคลาห์ <verse eid="1CH 1:21" /><verse number="22" style="v" sid="1CH 1:22" />โอบาล<note caller="+" style="f"><char style="fr" closed="false">1:22 </char><char style="ft" closed="false">สำเนา/ต้นฉบับ/ภาษาฮีบรู/ส่วนใหญ่/ว่า/</char><char style="fqa" closed="false">เอบาล/</char><char style="ft" closed="false">(ดู/<char style="xt"><ref loc="GEN 10:28">ปฐก.10:28</ref></char>)</char></note> อาบีมาเอล เชบา <verse eid="1CH 1:22" /><verse number="23" style="v" sid="1CH 1:23" />โอฟีร์ ฮาวิลาห์ และ/โยบับ คน/เหล่านี้/เป็น/บุตร/ของ/โยกทาน<verse eid="1CH 1:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 1:24" />เชม อารปัคชาด<note caller="+" style="f"><char style="fr" closed="false">1:24 </char><char style="ft" closed="false">สำเนา LXX. บางฉบับ/ว่า/</char><char style="fqa" closed="false">อารปัคชาด ไคนัน</char></note> เชลาห์<verse eid="1CH 1:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 1:25" />เอเบอร์ เปเลก เรอู<verse eid="1CH 1:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 1:26" />เสรุก นาโฮร์ เทราห์<verse eid="1CH 1:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 1:27" />และ/อับราม (คือ/อับราฮัม)<verse eid="1CH 1:27" /></para>
  <para style="s1">ครอบครัว/ของ/อับราฮัม</para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 1:28" />บุตร/ของ/อับราฮัม ได้แก่</para>
  <para style="li1" vid="1CH 1:28">อิสอัค/กับ/อิชมาเอล<verse eid="1CH 1:28" /></para>
  <para style="s2">วงศ์วาน/ของ/นาง/ฮาการ์</para>
  <para style="r">(<ref loc="GEN 25:12-16">ปฐก.25:12-16</ref>)</para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 1:29" />วงศ์วาน/ของ/อิชมาเอล ได้แก่</para>
  <para style="li1" vid="1CH 1:29">เนบาโยท/ผู้/เป็น/บุตร/หัวปี เคดาร์ อัดเบเอล มิบสัม <verse eid="1CH 1:29" /><verse number="30" style="v" sid="1CH 1:30" />มิชมา ดูมาห์ มัสสา ฮาดัด เทมา <verse eid="1CH 1:30" /><verse number="31" style="v" sid="1CH 1:31" />เยทูร์ นาฟิช และ/เคเดมาห์ คน/เหล่านี้/เป็น/บุตร/ของ/อิชมาเอล<verse eid="1CH 1:31" /></para>
  <para style="s2">วงศ์วาน/ของ/นาง/เคทูราห์</para>
  <para style="r">(<ref loc="GEN 25:1-4">ปฐก.25:1-4</ref>)</para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 1:32" />บุตร/ซึ่ง/เกิด/จาก/นาง/เคทูราห์/ภรรยา/น้อย/ของ/อับราฮัม ได้แก่</para>
  <para style="li1" vid="1CH 1:32">ศิมราน โยกชาน เมดาน มีเดียน อิชบาก และ/ชูอาห์</para>
  <para style="li1" vid="1CH 1:32">บุตร/ของ/โยกชาน ได้แก่</para>
  <para style="li1" vid="1CH 1:32">เชบา/กับ/เดดาน<verse eid="1CH 1:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 1:33" />บุตร/ของ/มีเดียน ได้แก่</para>
  <para style="li1" vid="1CH 1:33">เอฟาห์ เอเฟอร์ ฮาโนค อาบีดา และ/เอลดาอาห์</para>
  <para style="li1" vid="1CH 1:33">คน/เหล่านี้/เป็น/วงศ์วาน/ของ/นาง/เคทูราห์<verse eid="1CH 1:33" /></para>
  <para style="s2">วงศ์วาน/ของ/นาง/ซาราห์</para>
  <para style="r">(<ref loc="GEN 36:10-14">ปฐก.36:10-14</ref>)</para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 1:34" />อับราฮัม/เป็น/บิดา/ของ/อิสอัค</para>
  <para style="li1" vid="1CH 1:34">อิสอัค/มี/บุตร/ชาย/สอง/คน ได้แก่</para>
  <para style="li1" vid="1CH 1:34">เอซาว/กับ/อิสราเอล<verse eid="1CH 1:34" /></para>
  <para style="s1">เชื้อสาย/ของ/เอซาว</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 1:35" />บุตร/ของ/เอซาว ได้แก่</para>
  <para style="li1" vid="1CH 1:35">เอลีฟัส เรอูเอล เยอูช ยาลาม และ/โคราห์<verse eid="1CH 1:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 1:36" />บุตร/ของ/เอลีฟัส ได้แก่</para>
  <para style="li1" vid="1CH 1:36">เทมาน โอมาร์ เศโฟ<note caller="+" style="f"><char style="fr" closed="false">1:36 </char><char style="ft" closed="false">สำเนา/ต้นฉบับ/ภาษาฮีบรู/ส่วนใหญ่/ว่า/</char><char style="fqa" closed="false">เศฟีร์/</char><char style="ft" closed="false">(ดู/<char style="xt"><ref loc="GEN 36:11">ปฐก.36:11</ref></char>)</char></note> กาทาม เคนัส</para>
  <para style="li1" vid="1CH 1:36">และ/อามาเลข/ซึ่ง/เกิด/จาก/นาง/ทิมนา<note caller="+" style="f"><char style="fr" closed="false">1:36 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">กาทาม เคนัส ทิมนา และ/อามาเลข/</char><char style="ft" closed="false">(ดู/<char style="xt"><ref loc="GEN 36:12">ปฐก.36:12</ref></char>)</char></note><verse eid="1CH 1:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 1:37" />บุตร/ของ/เรอูเอล ได้แก่</para>
  <para style="li1" vid="1CH 1:37">นาหาท เศราห์ ชัมมาห์ และ/มิสซาห์<verse eid="1CH 1:37" /></para>
  <para style="s2">ประชากร/ของ/เสอีร์/ใน/เอโดม</para>
  <para style="r">(<ref loc="GEN 36:20-28">ปฐก.36:20-28</ref>)</para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 1:38" />บุตร/ของ/เสอีร์ ได้แก่</para>
  <para style="li1" vid="1CH 1:38">โลทาน โชบาล ศิเบโอน อานาห์ ดีโชน เอเซอร์ และ/ดีชาน<verse eid="1CH 1:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 1:39" />บุตร/ของ/โลทาน ได้แก่</para>
  <para style="li1" vid="1CH 1:39">โฮรี/กับ/โฮมัม ทิมนา/เป็น/น้องสาว/ของ/โลทาน<verse eid="1CH 1:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 1:40" />บุตร/ของ/โชบาล ได้แก่</para>
  <para style="li1" vid="1CH 1:40">อัลวาน<note caller="+" style="f"><char style="fr" closed="false">1:40 </char><char style="ft" closed="false">สำเนา/ต้นฉบับ/ภาษาฮีบรู/ส่วนใหญ่/ว่า/</char><char style="fqa" closed="false">เอลี/ยัน/</char><char style="ft" closed="false">(ดู/<char style="xt"><ref loc="GEN 36:23">ปฐก.36:23</ref></char>)</char></note> มานาฮาท เอบาล เชโฟ และ/โอนัม</para>
  <para style="li1" vid="1CH 1:40">บุตร/ของ/ศิเบโอน ได้แก่</para>
  <para style="li1" vid="1CH 1:40">อัยยาห์/กับ/อานาห์<verse eid="1CH 1:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 1:41" />บุตร/ของ/อานาห์ ได้แก่</para>
  <para style="li1" vid="1CH 1:41">ดีโชน</para>
  <para style="li1" vid="1CH 1:41">บุตร/ของ/ดีโชน ได้แก่</para>
  <para style="li1" vid="1CH 1:41">เฮมดาน<note caller="+" style="f"><char style="fr" closed="false">1:41 </char><char style="ft" closed="false">สำเนา/ต้นฉบับ/ภาษาฮีบรู/ส่วนใหญ่/ว่า/</char><char style="fqa" closed="false">ฮัมราน/</char><char style="ft" closed="false">(ดู/<char style="xt"><ref loc="GEN 36:26">ปฐก.36:26</ref></char>)</char></note> เอชบาน อิธราน และ/เคราน<verse eid="1CH 1:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 1:42" />บุตร/ของ/เอเซอร์ ได้แก่</para>
  <para style="li1" vid="1CH 1:42">บิลฮาน ศาอาวาน และ/อาขาน<note caller="+" style="f"><char style="fr" closed="false">1:42 </char><char style="ft" closed="false">สำเนา/ต้นฉบับ/ภาษาฮีบรู/ส่วนใหญ่/ว่า/</char><char style="fqa" closed="false">ยาอาคาน/</char><char style="ft" closed="false">(ดู/<char style="xt"><ref loc="GEN 36:27">ปฐก.36:27</ref></char>)</char></note></para>
  <para style="li1" vid="1CH 1:42">บุตร/ของ/ดีชาน<note caller="+" style="f"><char style="fr" closed="false">1:42 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">ดีโชน/</char><char style="ft" closed="false">เป็น/อีก/รูป/หนึ่ง/ของ/</char><char style="fqa" closed="false">ดีชาน</char></note> ได้แก่</para>
  <para style="li1" vid="1CH 1:42">อูส/กับ/อารัน<verse eid="1CH 1:42" /></para>
  <para style="s2">ผู้/ปกครอง/ของ/เอโดม</para>
  <para style="r">(<ref loc="GEN 36:31-43">ปฐก.36:31-43</ref>)</para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 1:43" />กษัตริย์/ซึ่ง/ปกครอง/ใน/เอโดม/ก่อน/ที่/จะ/มี/กษัตริย์/อิสราเอล<note caller="+" style="f"><char style="fr" closed="false">1:43 </char><char style="ft" closed="false">หรือ/</char><char style="fqa" closed="false">ก่อน/กษัตริย์/อิสราเอล/ปกครอง/เหนือ/พวกเขา</char></note> ได้แก่</para>
  <para style="li1" vid="1CH 1:43">เบลา/บุตร/เบโอร์/แห่ง/เมือง/ดินฮาบาห์<verse eid="1CH 1:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 1:44" />เมื่อ/เบลา/สิ้นพระชนม์ โยบับ/บุตร/เศราห์/จาก/โบสราห์/ขึ้น/ครองราชย์/แทน<verse eid="1CH 1:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 1:45" />เมื่อ/โยบับ/สิ้นพระชนม์ หุชาม/จาก/ดินแดน/ของ/ชาว/เทมาน/ขึ้น/ครองราชย์/แทน<verse eid="1CH 1:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 1:46" />เมื่อ/หุชาม/สิ้นพระชนม์ ฮาดัด/บุตร/เบดัด ผู้/ซึ่ง/พิชิต/กองทัพ/มีเดียน/ใน/ดินแดน/โมอับ/ขึ้น/ครองราชย์/แทน เมือง/ของ/ฮาดัด/คือ/อาวีท<verse eid="1CH 1:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 1:47" />เมื่อ/ฮาดัด/สิ้นพระชนม์ สัมลาห์/จาก/มัสเรคาห์/ขึ้น/ครองราชย์/แทน<verse eid="1CH 1:47" /></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 1:48" />เมื่อ/สัมลาห์/สิ้นพระชนม์ ชาอูล/จาก/เรโหโบท/ริมแม่น้ำ<note caller="+" style="f"><char style="fr" closed="false">1:48 </char><char style="ft" closed="false">อาจจะ/เป็น/แม่น้ำ/ยูเฟรติส</char></note>ขึ้น/ครองราชย์/แทน<verse eid="1CH 1:48" /></para>
  <para style="li1">
    <verse number="49" style="v" sid="1CH 1:49" />เมื่อ/ชาอูล/สิ้นพระชนม์ บาอัลฮานัน/บุตร/อัคโบร์/ขึ้น/ครองราชย์/แทน<verse eid="1CH 1:49" /></para>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 1:50" />เมื่อ/บาอัลฮานัน/สิ้นพระชนม์ ฮาดัด/ขึ้น/ครองราชย์/แทน เมือง/ของ/พระองค์/คือ/ปาอู<note caller="+" style="f"><char style="fr" closed="false">1:50 </char><char style="ft" closed="false">สำเนา/ต้นฉบับ/ภาษาฮีบรู/ส่วนใหญ่/ว่า/</char><char style="fqa" closed="false">ปาอี/</char><char style="ft" closed="false">(ดู/<char style="xt"><ref loc="GEN 36:39">ปฐก.36:39</ref></char>)</char></note> มเหสี/ของ/ฮาดัด/คือ เมเหทาเบล/ธิดา/ของ/มัทเรด ผู้/เป็น/ธิดา/ของ/เมซาหับ <verse eid="1CH 1:50" /><verse number="51" style="v" sid="1CH 1:51" />ต่อมา/ฮาดัด/ก็/สิ้นพระชนม์/เช่นกัน</para>
  <para style="li1" vid="1CH 1:51">ประมุข/องค์/ต่างๆ ของ/เอโดม ได้แก่</para>
  <para style="li1" vid="1CH 1:51">ทิมนา อัลวาห์ เยเธท <verse eid="1CH 1:51" /><verse number="52" style="v" sid="1CH 1:52" />โอโฮลีบามาห์ เอลาห์ ปิโนน <verse eid="1CH 1:52" /><verse number="53" style="v" sid="1CH 1:53" />เคนัส เทมาน มิบซาร์ <verse eid="1CH 1:53" /><verse number="54" style="v" sid="1CH 1:54" />มักดีเอล และ/อิราม คน/เหล่านี้/คือ/ประมุข/ของ/เอโดม<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="s1">เชื้อสาย/ของ/อิสราเอล</para>
  <para style="r">(<ref loc="GEN 35:23-26">ปฐก.35:23-26</ref>)</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 2:1" />บุตร/ของ/อิสราเอล ได้แก่</para>
  <para style="li1" vid="1CH 2:1">รูเบน สิเมโอน เลวี ยูดาห์ อิสสาคาร์ เศบูลุน <verse eid="1CH 2:1" /><verse number="2" style="v" sid="1CH 2:2" />ดาน โยเซฟ เบนยามิน นัฟทาลี กาด และ/อาเชอร์<verse eid="1CH 2:2" /></para>
  <para style="s1">ยูดาห์</para>
  <para style="r">(<ref loc="RUT 4:18-22">นรธ.4:18-22</ref>; <ref loc="MAT 1:3-6">มธ.1:3-6</ref>)</para>
  <para style="s2">ถึง/บุตร/ของ/เฮสโรน</para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 2:3" />บุตร/ของ/ยูดาห์ ได้แก่</para>
  <para style="li1" vid="1CH 2:3">เอร์ โอนัน และ/เชลาห์ ทั้ง/สามคน/เกิด/จาก/ธิดา/ของ/ชูอา/ชาว/คานาอัน เอร์/บุตร/หัวปี/นั้น/เป็น/คน/ชั่ว/ใน/สาย/พระเนตร/ของ/<char style="nd">องค์/พระผู้เป็นเจ้า</char> พระองค์/จึง/ทรง/ประหาร/เขา <verse eid="1CH 2:3" /><verse number="4" style="v" sid="1CH 2:4" />ทามาร์/ลูกสะใภ้/ของ/ยูดาห์/ให้กำเนิด/ลูกแฝด คือ/เปเรศ/กับ/เศราห์/แก่/ยูดาห์ ยูดาห์/จึง/มี/บุตร/ชาย/ทั้งหมด/ห้า/คน<verse eid="1CH 2:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 2:5" />บุตร/ของ/เปเรศ ได้แก่</para>
  <para style="li1" vid="1CH 2:5">เฮสโรน/กับ/ฮามูล<verse eid="1CH 2:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 2:6" />บุตร/ของ/เศราห์ ได้แก่</para>
  <para style="li1" vid="1CH 2:6">ศิมรี เอธาน เฮมาน คาลโคล์ และ/ดารดา<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">สำเนา/ต้นฉบับ/ภาษาฮีบรู/ส่วนใหญ่/ว่า/</char><char style="fqa" closed="false">ดารา/</char><char style="ft" closed="false">(ดู/<char style="xt"><ref loc="1KI 4:31">1พกษ.4:31</ref></char>)</char></note> รวม/ห้า/คน<verse eid="1CH 2:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 2:7" />บุตร/ของ/คารมี ได้แก่</para>
  <para style="li1" vid="1CH 2:7">อาคาร์<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">แปลว่า ปัญหา ใน/พระธรรม/โยชูวา/เรียก/</char><char style="fqa" closed="false">อาคาร์/</char><char style="ft" closed="false">ว่า/</char><char style="fqa" closed="false">อาคาน</char></note>ผู้/นำ/ความ/ทุกข์ร้อน/มา/สู่/อิสราเอล/โดย/เก็บ/สิ่ง/ที่/พระเจ้า/ตรัส/สั่งให้/ทำลาย<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">คำ/นี้/ใน/ภาษาฮีบรู/หมายถึง/สิ่งของ/หรือ/บุคคล/ที่/ถวาย/แด่/<char style="nd">องค์/พระผู้เป็นเจ้า</char>/แล้ว ไม่อาจ/เรียกคืน/ได้ มักจะ/ต้อง/ทำลาย/ให้/หมด/สิ้นไป</char></note><verse eid="1CH 2:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 2:8" />บุตร/ของ/เอธาน ได้แก่</para>
  <para style="li1" vid="1CH 2:8">อาซาริยาห์<verse eid="1CH 2:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 2:9" />บุตร/ของ/เฮสโรน ได้แก่</para>
  <para style="li1" vid="1CH 2:9">เยราห์เมเอล ราม และ/คาเลบ<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">เคลุบัย/</char><char style="ft" closed="false">เป็น/อีก/รูป/หนึ่ง/ของ/</char><char style="fqa" closed="false">คาเลบ</char></note><verse eid="1CH 2:9" /></para>
  <para style="s2">จาก/ราม/บุตร/ของ/เฮสโรน</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 2:10" />ราม/เป็น/บิดา/ของ</para>
  <para style="li1" vid="1CH 2:10">อัมมีนาดับ อัมมีนาดับ/เป็น/บิดา/ของ/นาห์โชน/ผู้นำ/ของ/ตระกูล/ยูดาห์ <verse eid="1CH 2:10" /><verse number="11" style="v" sid="1CH 2:11" />นาห์โชน/เป็น/บิดา/ของ/สัลโมน<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">สัลมา/</char><char style="ft" closed="false">(ดู/<char style="xt"><ref loc="RUT 4:21">นรธ.4:21</ref></char>)</char></note> สัลโมน/เป็น/บิดา/ของ/โบอาส <verse eid="1CH 2:11" /><verse number="12" style="v" sid="1CH 2:12" />โบอาส/เป็น/บิดา/ของ/โอเบด โอเบด/เป็น/บิดา/ของ/เจสซี<verse eid="1CH 2:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 2:13" />เจสซี/เป็น/บิดา/ของ</para>
  <para style="li1" vid="1CH 2:13">เอลีอับ/บุตร/หัวปี บุตร/คน/ที่สอง/คือ/อาบีนาดับ คน/ที่สาม/คือ/ชิเมอา <verse eid="1CH 2:13" /><verse number="14" style="v" sid="1CH 2:14" />คน/ที่สี่/คือ/เนธันเอล คน/ที่ห้า/คือ/รัดดัย <verse eid="1CH 2:14" /><verse number="15" style="v" sid="1CH 2:15" />คน/ที่หก/คือ/โอเซม และ/คน/ที่เจ็ด/คือ/ดาวิด <verse eid="1CH 2:15" /><verse number="16" style="v" sid="1CH 2:16" />เจสซี/มี/บุตร/สาว/สอง/คน/คือ/เศรุยาห์/กับ/อาบีกายิล บุตร/ชาย/สามคน/ของ/นาง/เศรุยาห์/ได้แก่ อาบีชัย โยอาบ และ/อาสาเฮล <verse eid="1CH 2:16" /><verse number="17" style="v" sid="1CH 2:17" />อาบีกายิล/มี/บุตร/ชื่อ/อามาสา มี/สามี/ชื่อ/เยเธอร์/ชาว/อิชมาเอล<verse eid="1CH 2:17" /></para>
  <para style="s2">จาก/คาเลบ/บุตร/ของ/เฮสโรน</para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 2:18" />คาเลบ/บุตร/เฮสโรน/มี/ภรรยา/สอง/คน/คือ อาซูบาห์/กับ/เยรีโอท บุตร/ของ/อาซูบาห์/ได้แก่ เยเชอร์ โชบับ และ/อารโดน <verse eid="1CH 2:18" /><verse number="19" style="v" sid="1CH 2:19" />เมื่อ/อาซูบาห์/สิ้นชีวิต/แล้ว คาเลบ/แต่งงาน/กับ/เอฟรัท/ซึ่ง/ให้กำเนิด/บุตร/ชื่อ/เฮอร์ <verse eid="1CH 2:19" /><verse number="20" style="v" sid="1CH 2:20" />เฮอร์/เป็น/บิดา/ของ/อูรี อูรี/เป็น/บิดา/ของ/เบซาเลล<verse eid="1CH 2:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 2:21" />เฮสโรน/แต่งงาน/กับ/บุตร/สาว/ของ/มาคีร์/บิดา/ของ/กิเลอาด (เขา/แต่งงาน/เมื่อ/อายุ/หกสิบ/ปี) และ/นาง/ให้กำเนิด/บุตร/ชื่อ/เสกุบ <verse eid="1CH 2:21" /><verse number="22" style="v" sid="1CH 2:22" />เสกุบ/เป็น/บิดา/ของ/ยาอีร์/ซึ่ง/ครองเมือง 23 แห่ง/ใน/แดน/กิเลอาด <verse eid="1CH 2:22" /><verse number="23" style="v" sid="1CH 2:23" />(แต่/เกชูร์/และ/อารัม/ยึด/เมือง/ฮัฟโวทยาอีร์<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">หรือ/</char><char style="fqa" closed="false">ยึด/บริเวณ/ที่ตั้ง/ถิ่นฐาน/ของ/ยาอีร์</char></note> ไป/จาก/เขา และ/ยึด/เมือง/เคนัท/กับ/หมู่บ้าน/หกสิบ/แห่ง/โดยรอบ/ไป/ด้วย) คน/เหล่านี้/ล้วนเป็น/วงศ์วาน/ของ/มาคีร์/บิดา/กิเลอาด<verse eid="1CH 2:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 2:24" />หลังจากที่/เฮสโรน/เสียชีวิต/ใน/คาเลบ/เอฟราธาห์ อาบียาห์/ภรรยา/ของ/เฮสโรน/ให้กำเนิด/บุตร/ชื่อ/อัชฮูร์/ซึ่งเป็น/บิดา<note caller="+" style="f"><char style="fr" closed="false">2:24 </char><char style="ft" closed="false">คำ/ว่า/</char><char style="fqa" closed="false">บิดา/</char><char style="ft" closed="false">อาจจะ/มี/ความหมาย/ว่า ผู้/นำทาง/พลเรือน หรือ ผู้/นำทาง/ทหาร เช่น/เดียว/กับ/ข้อ 42,45,49-52 และ/อาจจะ/มี/หมายความ/อย่างนี้/ใน/ที่อื่นๆ ด้วย</char></note>ของ/เทโคอา<verse eid="1CH 2:24" /></para>
  <para style="s2">จาก/เยราห์เมเอล/บุตร/ของ/เฮสโรน</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 2:25" />บุตร/ของ/เยราห์เมเอล/บุตร/หัวปี/ของ/เฮสโรน ได้แก่</para>
  <para style="li1" vid="1CH 2:25">ราม/ผู้/เป็น/บุตร/หัวปี บูนาห์ โอเรน โอเซม และ<note caller="+" style="f"><char style="fr" closed="false">2:25 </char><char style="ft" closed="false">หรือ/</char><char style="fqa" closed="false">โอเรน และ/โอเซม ซึ่ง/เกิด/จาก/นาง</char></note>อาหิยาห์ <verse eid="1CH 2:25" /><verse number="26" style="v" sid="1CH 2:26" />อาทาราห์/ภรรยา/อีก/คน/หนึ่ง/ของ/เยราห์เมเอล/ให้กำเนิด/บุตร/ชื่อ/โอนัม<verse eid="1CH 2:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 2:27" />บุตร/ของ/ราม/บุตร/หัวปี/ของ/เยราห์เมเอล ได้แก่</para>
  <para style="li1" vid="1CH 2:27">มาอัส ยามีน และ/เอเคอร์<verse eid="1CH 2:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 2:28" />บุตร/ของ/โอนัม ได้แก่</para>
  <para style="li1" vid="1CH 2:28">ชัมมัย/กับ/ยาดา</para>
  <para style="li1" vid="1CH 2:28">บุตร/ของ/ชัมมัย ได้แก่</para>
  <para style="li1" vid="1CH 2:28">นาดับ/กับ/อาบีชูร์<verse eid="1CH 2:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 2:29" />อาบีชูร์/กับ/ภรรยา/ชื่อ/อาบีฮายิล/มี/บุตรชื่อ อาห์บาน/กับ/โมลิด<verse eid="1CH 2:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 2:30" />บุตร/ของ/นาดับ ได้แก่</para>
  <para style="li1" vid="1CH 2:30">เสเลด/กับ/อัปปาอิม เสเลด/สิ้นชีวิต/โดย/ไม่มี/บุตร<verse eid="1CH 2:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 2:31" />บุตร/ของ/อัปปาอิม ได้แก่</para>
  <para style="li1" vid="1CH 2:31">อิชอี/บิดา/ของ/เชชัน เชชัน/เป็น/บิดา/ของ/อาห์ลัย<verse eid="1CH 2:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 2:32" />บุตร/ของ/ยาดา/น้องชาย/ชัมมัย ได้แก่</para>
  <para style="li1" vid="1CH 2:32">เยเธอร์/กับ/โยนาธาน เยเธอร์/เสียชีวิต/โดย/ไม่มี/บุตร<verse eid="1CH 2:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 2:33" />บุตร/ของ/โยนาธาน ได้แก่</para>
  <para style="li1" vid="1CH 2:33">เปเลธ/กับ/ศาซา</para>
  <para style="li1" vid="1CH 2:33">คน/เหล่านี้/คือ/วงศ์วาน/ของ/เยราห์เมเอล<verse eid="1CH 2:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 2:34" />เชชัน/มี/แต่/บุตร/สาว ไม่มี/บุตร/ชาย</para>
  <para style="li1" vid="1CH 2:34">เขา/มี/คน/ใช้/ชาวอียิปต์/คน/หนึ่ง/ชื่อ/ยารฮา <verse eid="1CH 2:34" /><verse number="35" style="v" sid="1CH 2:35" />เชชัน/ยก/บุตร/สาว/คน/หนึ่ง/ให้/ยารฮา นาง/ให้กำเนิด/บุตร/ชื่อ/อัททัย<verse eid="1CH 2:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 2:36" />อัททัย/เป็น/บิดา/ของ/นาธัน</para>
  <para style="li1" vid="1CH 2:36">นาธัน/เป็น/บิดา/ของ/ศาบาด<verse eid="1CH 2:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 2:37" />ศาบาด/เป็น/บิดา/ของ/เอฟลาล</para>
  <para style="li1" vid="1CH 2:37">เอฟลาล/เป็น/บิดา/ของ/โอเบด<verse eid="1CH 2:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 2:38" />โอเบด/เป็น/บิดา/ของ/เยฮู</para>
  <para style="li1" vid="1CH 2:38">เยฮู/เป็น/บิดา/ของ/อาซาริยาห์<verse eid="1CH 2:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 2:39" />อาซาริยาห์/เป็น/บิดา/เฮเลส</para>
  <para style="li1" vid="1CH 2:39">เฮเลส/เป็น/บิดา/ของ/เอเลอาสาห์<verse eid="1CH 2:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 2:40" />เอเลอาสาห์/เป็น/บิดา/ของ/สิสะมัย</para>
  <para style="li1" vid="1CH 2:40">สิสะมัย/เป็น/บิดา/ของ/ชัลลูม<verse eid="1CH 2:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 2:41" />ชัลลูม/เป็น/บิดา/ของ/เยคามิยาห์ เยคามิยาห์/เป็น/บิดา/ของ/เอลีชามา<verse eid="1CH 2:41" /></para>
  <para style="s2">ตระกูล/ของ/คาเลบ</para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 2:42" />บุตร/ของ/คาเลบ/น้องชาย/ของ/เยราห์เมเอล ได้แก่</para>
  <para style="li1" vid="1CH 2:42">เมชา/บุตร/หัวปี/ซึ่งเป็น/บิดา/ของ/ศิฟ ศิฟ/เป็น/บิดา/ของ/มาเรชาห์<note caller="+" style="f"><char style="fr" closed="false">2:42 </char><char style="ft" closed="false">ใน/ภาษาฮีบรู/วลี/นี้/มี/ความหมาย/ไม่ชัดเจน</char></note>ซึ่งเป็น/บิดา/ของ/เฮโบรน<verse eid="1CH 2:42" /></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 2:43" />บุตร/ของ/เฮโบรน ได้แก่</para>
  <para style="li1" vid="1CH 2:43">โคราห์ ทัปปูวาห์ เรเคม และ/เชมา <verse eid="1CH 2:43" /><verse number="44" style="v" sid="1CH 2:44" />เชมา/เป็น/บิดา/ของ/ราฮัม ราฮัม/เป็น/บิดา/ของ/โยรเคอัม เรเคม/เป็น/บิดา/ของ/ชัมมัย <verse eid="1CH 2:44" /><verse number="45" style="v" sid="1CH 2:45" />ชัมมัย/มี/บุตร/ชื่อ/มาโอน มาโอน/เป็น/บิดา/ของ/เบธซูร์<verse eid="1CH 2:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 2:46" />เอฟาห์/ภรรยา/น้อย/ของ/คาเลบ/เป็น/มารดา/ของ/ฮาราน โมซา และ/กาเซส ฮาราน/เป็น/บิดา/ของ/กาเซส<verse eid="1CH 2:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 2:47" />บุตร/ของ/ยาดัย ได้แก่</para>
  <para style="li1" vid="1CH 2:47">เรเกม โยธาม เกชาน เปเลท เอฟาห์ และ/ชาอัฟ<verse eid="1CH 2:47" /></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 2:48" />มาอาคาห์/ภรรยา/น้อย/ของ/คาเลบ/มี/บุตร/ชื่อ/เชเบอร์/และ/ทีรหะนาห์ <verse eid="1CH 2:48" /><verse number="49" style="v" sid="1CH 2:49" />นาง/ยัง/ให้/กำเนิด/ชาอัฟ/ผู้/เป็น/บิดา/ของ/มัดมันนาห์ และ/เชวา/ผู้/เป็น/บิดา/ของ/มัคเบนาห์/กับ/กิเบอา และ/คาเลบ/มี/บุตร/สาว/ชื่อ/อัคสาห์ <verse eid="1CH 2:49" /><verse number="50" style="v" sid="1CH 2:50" />คน/เหล่านี้/คือ/วงศ์วาน/ของ/คาเลบ</para>
  <para style="li1" vid="1CH 2:50">บุตร/ของ/เฮอร์/ผู้/เป็น/บุตร/ชาย/หัวปี/ของ/เอฟราธาห์ ได้แก่</para>
  <para style="li1" vid="1CH 2:50">โชบาล/ผู้/เป็น/บิดา/ของ/คีริยาทเยอาริม <verse eid="1CH 2:50" /><verse number="51" style="v" sid="1CH 2:51" />สัลมา/ผู้/เป็น/บิดา/ของ/เบธเลเฮม และ/ฮาเรฟ/ผู้/เป็น/บิดา/ของ/เบธกาเดอร์<verse eid="1CH 2:51" /></para>
  <para style="li1">
    <verse number="52" style="v" sid="1CH 2:52" />วงศ์วาน/ของ/โชบาล/ผู้/เป็น/บิดา/ของ/คีริยาทเยอาริม ได้แก่</para>
  <para style="li1" vid="1CH 2:52">ฮาโรเอห์/ซึ่งเป็น/ต้นตระกูล/ของ/ชาว/มานาฮาท/ครึ่งหนึ่ง <verse eid="1CH 2:52" /><verse number="53" style="v" sid="1CH 2:53" />และ/ตระกูล/ต่างๆ ของ/คีริยาทเยอาริม/ได้แก่ ตระกูล/อิทไรต์ ตระกูล/ปุไท ตระกูล/ชูมัท และ/ตระกูล/มิชรา ชาว/โศราห์/และ/ชาว/เอชทาโอล/สืบ/เชื้อสาย/มา/จาก/ตระกูล/เหล่านี้<verse eid="1CH 2:53" /></para>
  <para style="li1">
    <verse number="54" style="v" sid="1CH 2:54" />วงศ์วาน/ของ/สัลมา คือ</para>
  <para style="li1" vid="1CH 2:54">เบธเลเฮม ชาว/เนโทฟาห์ อัทโรทเบธ โยอาบ ชาว/มานาฮาท/อีก/ครึ่งหนึ่ง และ/ชาว/โศราห์ <verse eid="1CH 2:54" /><verse number="55" style="v" sid="1CH 2:55" />รวมทั้ง/ตระกูล/ต่างๆ ของ/บรรดา/อาลักษณ์<note caller="+" style="f"><char style="fr" closed="false">2:55 </char><char style="ft" closed="false">หรือ/</char><char style="fqa" closed="false">ของ/ชาว/โสเฟอร์</char></note> ซึ่ง/อาศัย/ที่/ยาเบส/ได้แก่ ตระกูล/ทิราไธต์ ตระกูล/ชิเมอัท และ/ตระกูล/สุคา คน/เหล่านี้/เป็น/ชาว/เคไนต์ ซึ่ง/สืบ/เชื้อสาย/มา/จาก/ฮัมมัท/ต้นตระกูล/เรคาบ<note caller="+" style="f"><char style="fr" closed="false">2:55 </char><char style="ft" closed="false">หรือ/</char><char style="fqa" closed="false">เป็น/บิดา/ของ/เบธเรคาบ</char></note><verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="s2">เชื้อสาย/ของ/ดาวิด</para>
  <para style="r">(<ref loc="2SA 3:2-5">2ซมอ.3:2-5</ref>; <ref loc="2SA 5:14-16">5:14-16</ref>; <ref loc="1CH 14:4-7">1พศด.14:4-7</ref>)</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 3:1" />โอรส/ของ/ดาวิด/ที่/ประสูติ/ใน/เฮโบรน ได้แก่</para>
  <para style="li1" vid="1CH 3:1">อัมโนน/โอรส/หัวปี ประสูติ/จาก/นาง/อาหิโนอัม/แห่ง/ยิสเรเอล องค์/ที่สอง/คือ/ดาเนียล/ประสูติ/จาก/นาง/อาบีกายิล/แห่ง/คารเมล<verse eid="1CH 3:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 3:2" />องค์/ที่สาม/คือ/อับซาโลม ประสูติ/จาก/นาง/มาอาคาห์/ธิดา/กษัตริย์/ทัลมัย/แห่ง/เกชูร์</para>
  <para style="li1" vid="1CH 3:2">องค์/ที่สี่/คือ/อาโดนียาห์ ประสูติ/จาก/นาง/ฮักกีท<verse eid="1CH 3:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 3:3" />องค์/ที่ห้า/คือ/เชฟาทิยาห์ ประสูติ/จาก/นาง/อาบีทัล</para>
  <para style="li1" vid="1CH 3:3">องค์/ที่หก/คือ/อิทเรอัม ประสูติ/จาก/นาง/เอกลาห์<verse eid="1CH 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 3:4" />ทั้ง/หก/พระองค์นี้/ประสูติ/ใน/เฮโบรน ที่/ซึ่ง/ดาวิด/ครองราชย์/อยู่/เจ็ด/ปี/หกเดือน</para>
  <para style="li1" vid="1CH 3:4">ดาวิด/ทรง/ครองราชย์/ใน/กรุง/เยรูซาเล็ม/อีก 33 ปี<verse eid="1CH 3:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 3:5" />โอรส/ซึ่ง/ประสูติ/ที่นั่น ได้แก่</para>
  <para style="li1" vid="1CH 3:5">ชัมมุวา<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">ชิเมอา/</char><char style="ft" closed="false">เป็น/อีก/รูป/หนึ่ง/ของ/</char><char style="fqa" closed="false">ชัมมุวา</char></note> โชบับ นาธัน และ/โซโลมอน ทั้ง/สี่/องค์นี้/ประสูติ/จาก/นาง/บัทเชบา<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">สำเนา/ต้นฉบับ/ภาษาฮีบรู/ส่วนใหญ่/ว่า/</char><char style="fqa" closed="false">บัทชูวา/</char><char style="ft" closed="false">(ดู/<char style="xt"><ref loc="2SA 11:3">2ซมอ.11:3</ref></char>)</char></note> ธิดา/อัมมีเอล <verse eid="1CH 3:5" /><verse number="6" style="v" sid="1CH 3:6" />ดาวิด/มี/โอรส/องค์อื่นๆ อีก ได้แก่ อิบฮาร์ เอลิชูอา<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">สำเนา/ต้นฉบับ/ภาษาฮีบรู/ส่วนใหญ่/ว่า/</char><char style="fqa" closed="false">เอลีชามา/</char><char style="ft" closed="false">(ดู/<char style="xt"><ref loc="2SA 5:15">2ซมอ.5:15</ref></char> และ/<char style="xt"><ref loc="1CH 14:5">1พศด.14:5</ref></char>)</char></note> เอลีเฟเลท <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" />โนกาห์ เนเฟก ยาเฟีย <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" />เอลีชามา เอลียาดา และ/เอลีเฟเลท รวมเป็น/เก้า/องค์ <verse eid="1CH 3:8" /><verse number="9" style="v" sid="1CH 3:9" />รายชื่อ/เหล่านี้/ไม่รวม/โอรส/ที่/ประสูติ/จาก/สนม ดาวิด/ทรงมี/ธิดา/ชื่อ/ว่า/ทามาร์/ด้วย<verse eid="1CH 3:9" /></para>
  <para style="s2">กษัตริย์/ยูดาห์</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 3:10" />โอรส/ของ/โซโลมอน/คือ/เรโหโบอัม</para>
  <para style="li1" vid="1CH 3:10">ซึ่ง/มี/บุตร/คือ/อาบียาห์</para>
  <para style="li1" vid="1CH 3:10">ซึ่ง/มี/บุตร/คือ/อาสา</para>
  <para style="li1" vid="1CH 3:10">ซึ่ง/มี/บุตร/คือ/เยโฮชาฟัท<verse eid="1CH 3:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 3:11" />ซึ่ง/มี/บุตร/คือ/เยโฮรัม<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">โยรัม/</char><char style="ft" closed="false">เป็น/อีก/รูป/หนึ่ง/ของ/</char><char style="fqa" closed="false">เยโฮรัม</char></note></para>
  <para style="li1" vid="1CH 3:11">ซึ่ง/มี/บุตร/คือ/อาหัสยาห์</para>
  <para style="li1" vid="1CH 3:11">ซึ่ง/มี/บุตร/คือ/โยอาช<verse eid="1CH 3:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 3:12" />ซึ่ง/มี/บุตร/คือ/อามาซิยาห์</para>
  <para style="li1" vid="1CH 3:12">ซึ่ง/มี/บุตร/คือ/อาซาริยาห์</para>
  <para style="li1" vid="1CH 3:12">ซึ่ง/มี/บุตร/คือ/โยธาม<verse eid="1CH 3:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 3:13" />ซึ่ง/มี/บุตร/คือ/อาหัส</para>
  <para style="li1" vid="1CH 3:13">ซึ่ง/มี/บุตร/คือ/เฮเซคียาห์</para>
  <para style="li1" vid="1CH 3:13">ซึ่ง/มี/บุตร/คือ/มนัสเสห์<verse eid="1CH 3:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 3:14" />ซึ่ง/มี/บุตร/คือ/อาโมน</para>
  <para style="li1" vid="1CH 3:14">ซึ่ง/มี/บุตร/คือ/โยสิยาห์<verse eid="1CH 3:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 3:15" />โอรส/ของ/โยสิยาห์ ได้แก่</para>
  <para style="li1" vid="1CH 3:15">โยฮานัน/โอรส/หัวปี</para>
  <para style="li1" vid="1CH 3:15">องค์/ที่สอง/คือ/เยโฮยาคิม</para>
  <para style="li1" vid="1CH 3:15">องค์/ที่สาม/คือ/เศเดคียาห์</para>
  <para style="li1" vid="1CH 3:15">องค์/ที่สี่/คือ/ชัลลูม<verse eid="1CH 3:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 3:16" />ผู้/ครองราชย์/สืบต่อ/จาก/เยโฮยาคิม ได้แก่</para>
  <para style="li1" vid="1CH 3:16">เยโฮยาคีน<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">เยโคนิยาห์/</char><char style="ft" closed="false">เป็น/อีก/รูป/หนึ่ง/ของ/</char><char style="fqa" closed="false">เยโฮยาคีน/</char><char style="ft" closed="false">เช่น/เดียว/กับ/ข้อ 17</char></note>ผู้/เป็น/โอรส</para>
  <para style="li1" vid="1CH 3:16">และ/เศเดคียาห์<verse eid="1CH 3:16" /></para>
  <para style="s2">ราชวงศ์/หลังจาก/ตก/เป็น/เชลย</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 3:17" />วงศ์วาน/ของ/เยโฮยาคีน/ผู้/ตก/เป็น/เชลย ได้แก่</para>
  <para style="li1" vid="1CH 3:17">เชอัลทิเอล/โอรส/ของ/พระองค์ <verse eid="1CH 3:17" /><verse number="18" style="v" sid="1CH 3:18" />มัลคีราม เปดายาห์ เชนาสซาร์ เยคามิยาห์ โฮชามา และ/เนดาบียาห์<verse eid="1CH 3:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 3:19" />บุตร/ของ/เปดายาห์ ได้แก่</para>
  <para style="li1" vid="1CH 3:19">เศรุบบาเบล/กับ/ชิเมอี</para>
  <para style="li1" vid="1CH 3:19">บุตร/ของ/เศรุบบาเบล ได้แก่</para>
  <para style="li1" vid="1CH 3:19">เมชุลลาม/กับ/ฮานันยาห์</para>
  <para style="li1" vid="1CH 3:19">บุตร/สาว/คือ/เชโลมิท<verse eid="1CH 3:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 3:20" />และ/บุตร/คนอื่นๆ อีก/ห้า/คน ได้แก่</para>
  <para style="li1" vid="1CH 3:20">ฮาชูบาห์ โอเฮล เบเรคิยาห์ ฮาสาดิยาห์ และ/ยูชับเฮเสด<verse eid="1CH 3:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 3:21" />วงศ์วาน/ของ/ฮานันยาห์ ได้แก่</para>
  <para style="li1" vid="1CH 3:21">เปลาทียาห์/และ/เยชายาห์/กับ/บุตร/ทั้งหลาย/ของ/เรไฟยาห์ ของ/อารนัน ของ/โอบาดีห์ และ/ของ/เชคานิยาห์<verse eid="1CH 3:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 3:22" />วงศ์วาน/ของ/เชคานิยาห์ ได้แก่</para>
  <para style="li1" vid="1CH 3:22">เชไมอาห์/และ/บุตร/คือ ฮัททัช อิกาล บารียาห์ เนอารียาห์ และ/ชาฟัท รวม/หกคน<verse eid="1CH 3:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 3:23" />บุตร/ของ/เนอารียาห์ ได้แก่</para>
  <para style="li1" vid="1CH 3:23">เอลีโอนัย ฮิสคีอาห์ และ/อัสรีคัม รวม/สามคน<verse eid="1CH 3:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 3:24" />บุตร/ของ/เอลีโอนัย ได้แก่</para>
  <para style="li1" vid="1CH 3:24">โฮดาวิยาห์ เอลียาชีบ เปไลยาห์ อักขูบ โยฮานัน เดไลยาห์ และ/อานานี รวม/เจ็ด/คน<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="s2">ตระกูล/อื่นๆ ของ/ยูดาห์</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 4:1" />วงศ์วาน/ของ/ยูดาห์ ได้แก่</para>
  <para style="li1" vid="1CH 4:1">เปเรศ เฮสโรน คารมี เฮอร์ และ/โชบาล<verse eid="1CH 4:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 4:2" />เรอายาห์/บุตร/ของ/โชบาล/ซึ่งเป็น/บิดา/ของ/ยาหาท ยาหาท/เป็น/บิดา/ของ/อาหุมัย/และ/ลาฮาด คน/เหล่านี้/อยู่/ใน/ตระกูล/โศราห์<verse eid="1CH 4:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 4:3" />บุตร<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">บิดา</char></note>ของ/เอตาม/ได้แก่ ยิสเรเอล อิชมา อิดบาช และ/ฮัสเซเลลโพนี/ผู้/เป็น/ธิดา <verse eid="1CH 4:3" /><verse number="4" style="v" sid="1CH 4:4" />เปนูเอล/บิดา/ของ/เกโดร์ และ/เอเซอร์/บิดา/ของ หุชาห์</para>
  <para style="li1" vid="1CH 4:4">คน/เหล่านี้/คือ/วงศ์วาน/ของ/เฮอร์ ซึ่งเป็น/บุตร/ชาย/หัวปี/ของ/เอฟราธาห์/และ/เป็น/บิดา<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">คำ/ว่า/</char><char style="fqa" closed="false">บิดา/</char><char style="ft" closed="false">อาจจะ/มี/ความหมาย/ว่า ผู้/นำทาง/พลเรือน หรือ ผู้/นำทาง/ทหาร เช่น/เดียว/กับ/ข้อ 12,14,17,18 และ/อาจจะ/มี/ความหมาย/อย่างนี้/ใน/ที่อื่นๆ/ด้วย</char></note> ของ/เบธเลเฮม<verse eid="1CH 4:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 4:5" />อัชฮูร์/บิดา/ของ/เทโคอา มี/ภรรยา/สอง/คน/คือ เฮลาห์/กับ/นาอาราห์<verse eid="1CH 4:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 4:6" />นาง/นาอาราห์/ให้กำเนิด/อาหุสซาม เฮเฟอร์ เทเมนี และ/ฮาอาหัชทารี คน/เหล่านี้/เป็น/วงศ์วาน/ของ/นาง/นาอาราห์<verse eid="1CH 4:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 4:7" />ส่วน/นาง/เฮลาห์/ให้กำเนิด</para>
  <para style="li1" vid="1CH 4:7">เศเรท โศหาร์ เอทนาน <verse eid="1CH 4:7" /><verse number="8" style="v" sid="1CH 4:8" />และ/โคส/ซึ่งเป็น/บิดา/ของ/อานูบ/กับ/ฮัสโซเบบาห์ และ/ตระกูล/ต่างๆ ของ/อาหารเฮล/บุตร/ฮารูม<verse eid="1CH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9" />ยาเบส/เป็น/ผู้/ที่/ทรง/เกียรติ/กว่า/พี่ๆ น้องๆ มารดา/ตั้งชื่อ/เขา/ว่า ยาเบส<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">คำ/ว่า/</char><char style="fqa" closed="false">ยาเบส/</char><char style="ft" closed="false">มี/เสียง/คล้าย/คำ/ภาษาฮีบรู/ที่/มี/ความหมาย/ว่า/</char><char style="fqa" closed="false">เจ็บปวด</char></note> เพราะ/นาง/กล่าว/ว่า “เพราะ/เรา/คลอด/เขา/ด้วย/ความ/เจ็บปวด” <verse eid="1CH 4:9" /><verse number="10" style="v" sid="1CH 4:10" />ยาเบส/อธิษฐาน/ต่อ/พระเจ้า/แห่ง/อิสราเอล/ว่า “ขอ/ทรง/โปรด/อวยพร/ข้า/พระองค์ และ/ขยาย/พรมแดน/ของ/ข้าพระองค์! ขอ/พระหัตถ์/ของ/พระองค์/อยู่/กับ/ข้าพระองค์ และ/ปกป้อง/ข้าพระองค์/จาก/ภยันตราย เพื่อ/ข้าพระองค์/จะ/พ้น/จาก/ความ/เจ็บปวด” และ/พระเจ้า/ประทาน/ตามที่/เขา/ทูลขอ<verse eid="1CH 4:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 4:11" />เคลูบ/พี่น้อง/ของ/ชูฮาห์ มี/บุตร/คือ/เมหิร์/ผู้/เป็น/บิดา/ของ/เอชโทน <verse eid="1CH 4:11" /><verse number="12" style="v" sid="1CH 4:12" />เอชโทน/เป็น/บิดา/ของ/เบธราฟา ปาเสอาห์/และ/เทหินนาห์/ซึ่งเป็น/บิดา/ของ/อิร์นาหาช<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false">หรือ/</char><char style="fqa" closed="false">เมือง/ของ/นาหาช</char></note> คน/เหล่านี้/เป็น/คน/ของ/เรคาห์<verse eid="1CH 4:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 4:13" />บุตร/ของ/เคนัส ได้แก่</para>
  <para style="li1" vid="1CH 4:13">โอทนีเอล/กับ/เสไรอาห์</para>
  <para style="li1" vid="1CH 4:13">บุตร/ของ/โอทนีเอล ได้แก่</para>
  <para style="li1" vid="1CH 4:13">ฮาธาท/กับ/เมโอโนธัย<note caller="+" style="f"><char style="fr" closed="false">4:13 </char><char style="ft" closed="false">ภาษาฮีบรู/ไม่มี/วลี/ที่ว่า/</char><char style="fqa" closed="false">กับ/เมโอโนธัย</char></note> <verse eid="1CH 4:13" /><verse number="14" style="v" sid="1CH 4:14" />เมโอโนธัย/เป็น/บิดา/ของ/โอฟราห์</para>
  <para style="li1" vid="1CH 4:14">เสไรอาห์/เป็น/บิดา/ของ/โยอาบ/บิดา/แห่ง/เกหะราชิม<note caller="+" style="f"><char style="fr" closed="false">4:14 </char><char style="ft" closed="false">แปลว่า หุบเขา/ช่างฝีมือ</char></note> ที่/ได้/ชื่อ/เช่นนั้น/เพราะ/มี/ช่างฝีมือ/จำนวน/มาก/อาศัย/อยู่<verse eid="1CH 4:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 4:15" />บุตร/ของ/คาเลบ/ผู้/เป็น/บุตร/เยฟุนเนห์ ได้แก่</para>
  <para style="li1" vid="1CH 4:15">อิรู เอลาห์ และ/นาอัม</para>
  <para style="li1" vid="1CH 4:15">บุตร/ของ/เอลาห์ ได้แก่</para>
  <para style="li1" vid="1CH 4:15">เคนัส<verse eid="1CH 4:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 4:16" />บุตร/ของ/เยฮาลเลเลล ได้แก่</para>
  <para style="li1" vid="1CH 4:16">ศิฟ ศิฟาห์ ทิรียา และ/อาสาเรล<verse eid="1CH 4:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 4:17" />บุตร/ของ/เอสราห์ ได้แก่</para>
  <para style="li1" vid="1CH 4:17">เยเธอร์ เมเรด/เอเฟอร์ และ/ยาโลน ภรรยา/คน/หนึ่ง/ของ/เมเรด/ให้กำเนิด/มิเรียม ชัมมัย และ/อิชบาห์/ผู้/เป็น/บิดา/ของ/เอชเทโมอา <verse eid="1CH 4:17" /><verse number="18" style="v" sid="1CH 4:18" />(ภรรยา/ชาวยูดาห์/ของ/เอชเทโมอา/ให้/กำเนิด/เยเรด/บิดา/ของ/เกโดร์ เฮเบอร์/บิดา/ของ/โสโค/และ/เยคูธีเอล/บิดา/ของ/ศาโนอาห์) คน/เหล่านี้/คือ/บุตร/ของ/บิธิยาห์/ธิดา/ฟาโรห์ ซึ่ง/เมเรด/แต่งงาน/ด้วย<verse eid="1CH 4:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 4:19" />ภรรยา/ของ/โฮดียาห์/เป็น/น้องสาว/ของ/นาฮัม</para>
  <para style="li1" vid="1CH 4:19">มี/บุตร/เป็น/บิดา/ของ/เคอีลาห์/แห่ง/การมี และ/เอชเทโมอา/แห่ง/มาอาคาห์<verse eid="1CH 4:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 4:20" />บุตร/ของ/ชิโมน ได้แก่</para>
  <para style="li1" vid="1CH 4:20">อัมโนน รินนาห์ เบนฮานัน และ/ทิโลน</para>
  <para style="li1" vid="1CH 4:20">วงศ์วาน/ของ/อิชอี ได้แก่ โศเหท/กับ/เบนโศเฮท<verse eid="1CH 4:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 4:21" />บุตร/ของ/เชลาห์/ผู้/เป็น/บุตร/ของ/ยูดาห์ ได้แก่ เอร์/บิดา/ของ/เลคาห์ ลาอาดาห์/บิดา/ของ/มาเรชาห์ และ/ตระกูล/ช่าง/ผ้าลินิน/ที่/เมือง/เบธอัชเบอา <verse eid="1CH 4:21" /><verse number="22" style="v" sid="1CH 4:22" />โยคิม/ชาว/โคเซบา โยอาช และ/สาราฟ/ซึ่ง/ปกครอง/ใน/โมอับ/และ/เมือง/ยาชูบิเลเฮม (บันทึก/เหล่านี้/มา/จาก/ครั้ง/โบราณ) <verse eid="1CH 4:22" /><verse number="23" style="v" sid="1CH 4:23" />พวกเขา/เป็น/ช่าง/ปั้น/หม้อ/ผู้/อาศัย/อยู่/ที่/เนทาอิม/กับ/เกเดราห์ และ/ทำงาน/ถวาย/กษัตริย์<verse eid="1CH 4:23" /></para>
  <para style="s1">วงศ์วาน/ของ/สิเมโอน</para>
  <para style="r">(<ref loc="JOS 19:2-10">ยชว.19:2-10</ref>)</para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 4:24" />วงศ์วาน/ของ/สิเมโอน ได้แก่</para>
  <para style="li1" vid="1CH 4:24">เนมูเอล ยามิน ยา/ริบ เศราห์ และ/ชาอูล<verse eid="1CH 4:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 4:25" />ชาอูล/มี/บุตร/ชื่อ/ชัลลูม หลาน/ชื่อ/มิบสัม และ/เหลน/ชื่อ/มิชมา<verse eid="1CH 4:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 4:26" />วงศ์วาน/ของ/มิชมา ได้แก่</para>
  <para style="li1" vid="1CH 4:26">ฮัมมูเอล/ซึ่ง/มี/บุตร/ชื่อ/ศักเกอร์ และ/หลาน/ชื่อ/ชิเมอี<verse eid="1CH 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27" />ชิเมอี/มี/บุตร/ชาย/สิบหก/คน บุตร/สาว/หกคน แต่/พี่น้อง/ของ/ชิเมอี/มี/บุตร/น้อย ดังนั้น/ทั้ง/ตระกูล/ของ/พวกเขา/จึง/มีจำนวน/คน/ไม่/มาก/เหมือน/ชาวยูดาห์ <verse eid="1CH 4:27" /><verse number="28" style="v" sid="1CH 4:28" />พวกเขา/อาศัย/อยู่/ที่/เมือง/เบเออร์เชบา เมือง/โมลาดาห์ เมือง/ฮาซาร์ชูอัล <verse eid="1CH 4:28" /><verse number="29" style="v" sid="1CH 4:29" />บิลฮาห์ เอเซม โทลัด <verse eid="1CH 4:29" /><verse number="30" style="v" sid="1CH 4:30" />เบธูเอล โฮรมาห์ ศิกลาก <verse eid="1CH 4:30" /><verse number="31" style="v" sid="1CH 4:31" />เบธมาร์คาโบท ฮาซารสูสิม เบธบิรี และ/ชาอาราอิม เมือง/เหล่านี้/เป็น/ของ/พวกเขา/จวบจน/รัชกาล/ของ/ดาวิด <verse eid="1CH 4:31" /><verse number="32" style="v" sid="1CH 4:32" />หมู่บ้าน/โดยรอบ/ได้แก่ เอตาม อายิน ริมโมน โทเคน และ/เอชัน รวม/ห้า/แห่ง <verse eid="1CH 4:32" /><verse number="33" style="v" sid="1CH 4:33" />และ/หมู่บ้าน/ทั้งปวง/โดยรอบ/เมือง/เหล่านี้/จด/บาอาลัท<note caller="+" style="f"><char style="fr" closed="false">4:33 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">บาอัล/</char><char style="ft" closed="false">(ดู/<char style="xt"><ref loc="JOS 19:8">ยชว.19:8</ref></char>)</char></note> คือ/ถิ่นฐาน/ของ/พวกเขา และ/พวกเขา/เก็บ/บันทึก/ลำดับ/วงศ์ตระกูล/เอาไว้<verse eid="1CH 4:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 4:34" />เมโชบับ ยัมเลค โยชาห์/บุตร/อามาซิยาห์ <verse eid="1CH 4:34" /><verse number="35" style="v" sid="1CH 4:35" />โยเอล เยฮู/บุตร/โยชิบิยาห์/ผู้/เป็น/บุตร/ของ/เสไรอาห์ ผู้/เป็น/บุตร/ของ/อาสิเอล <verse eid="1CH 4:35" /><verse number="36" style="v" sid="1CH 4:36" />เอลีโอนัย ยาอาโคบาห์ เยโชไฮยาห์ อาสายาห์ อาดีเอล เยสิมีเอล เบไนยาห์ <verse eid="1CH 4:36" /><verse number="37" style="v" sid="1CH 4:37" />และ/ศิซา/บุตร/ซิฟี ผู้/เป็น/บุตร/อัลโลน ผู้/เป็น/บุตร/เยดายาห์ ผู้/เป็น/บุตร/ชิมรี ผู้/เป็น/บุตร/เชไมอาห์<verse eid="1CH 4:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 4:38" />รายชื่อ/ข้างต้น/นี้/เป็น/ผู้นำ/ของ/ตระกูล ซึ่ง/ครอบครัว/ของ/พวกเขา/ขยาย/ใหญ่ <verse eid="1CH 4:38" /><verse number="39" style="v" sid="1CH 4:39" />และ/พวกเขา/ได้/ไป/ยัง/รอบนอก/ของ/เกโดร์/สู่/ฟาก/ตะวันออก/ของ/หุบเขา เพื่อ/เสาะหา/ทุ่งหญ้า/สำหรับ/เลี้ยง/แพะ/แกะ <verse eid="1CH 4:39" /><verse number="40" style="v" sid="1CH 4:40" />พวกเขา/พบ/ทุ่งหญ้า/กว้างใหญ่ อุดม/สมบูรณ์ และ/สงบสุข มี/เชื้อสาย/ของ/ฮาม/อาศัย/อยู่/ที่/นั่น/มา/ก่อน<verse eid="1CH 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41" />ใน/รัชกาล/กษัตริย์/เฮเซคียาห์/แห่ง/ยูดาห์ คน/ทั้งหมด/ตาม/บันทึก/รายชื่อ/ข้างต้น/ได้/บุกเข้า/โจมตี/และ/ทำลาย/ล้าง<note caller="+" style="f"><char style="fr" closed="false">4:41 </char><char style="ft" closed="false">คำ/นี้/ใน/ภาษาฮีบรู/หมายถึง สิ่งของ/หรือ/บุคคล/ที่/ถวาย/แด่/<char style="nd">องค์/พระผู้เป็นเจ้า</char>/แล้ว ไม่อาจ/เรียกคืน/ได้ มักจะ/ต้อง/ทำลาย/ให้/หมด/สิ้นไป</char></note>เชื้อสาย/ของ/ฮาม/กับ/ชาว/เมอูนี/ซึ่ง/อาศัย/อยู่/ที่/นั่น/จน/หมดสิ้น ดังที่/เห็น/เด่นชัด/จวบจน/บัดนี้ แล้ว/ตั้งรกราก/แทน/เนื่องจาก/มี/ทุ่งหญ้า/สำหรับ/ฝูง/แพะ/แกะ/ของ/ตน <verse eid="1CH 4:41" /><verse number="42" style="v" sid="1CH 4:42" />และ/ชนเผ่า/สิเมโอน/เหล่านี้/จำนวน/ห้าร้อย/คน นำ/โดย/เปลาทียาห์ เนอารียาห์ เรไฟยาห์ และ/อุสซีเอล/ซึ่ง/ล้วนเป็น/บุตร/ของ/อิชอี พา/กัน/บุก/แดน/เทือกเขา/เสอีร์ <verse eid="1CH 4:42" /><verse number="43" style="v" sid="1CH 4:43" />พวกเขา/ทำลาย/ล้าง/ชน/ชาว/อามาเลข/ที่/ยัง/เหลือ/อยู่ แล้ว/อาศัย/อยู่/ที่/นั่น/ตราบจน/บัดนี้<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="s1">วงศ์วาน/ของ/รูเบน</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 5:1" />รูเบน/บุตร/ชาย/หัวปี/ของ/อิสราเอล (เนื่องจาก/ทำให้/เตียง/สมรส/ของ/บิดา/เป็น/มลทิน สิทธิ/บุตร/หัวปี/ของเขา/จึง/ตกอยู่/แก่/บุตร/ของ/โยเซฟ/ผู้/เป็น/บุตร/ของ/อิสราเอล บันทึก/ลำดับ/วงศ์ตระกูล/จึง/ไม่ได้/เอ่ยถึง/รูเบน/ใน/ฐานะ/บุตร/หัวปี <verse eid="1CH 5:1" /><verse number="2" style="v" sid="1CH 5:2" />โยเซฟ/ได้รับ/สิทธิ/บุตร/หัวปี แม้ว่า/ยูดาห์/เป็น/ตระกูล/ที่/เข้มแข็ง/ที่สุด/ใน/หมู่พี่น้อง และ/มี/เจ้านาย/องค์หนึ่ง/มา/จาก/ยูดาห์) <verse eid="1CH 5:2" /><verse number="3" style="v" sid="1CH 5:3" />บุตร/ของ/รูเบน/ผู้/เป็น/บุตร/หัวปี/ของ/อิสราเอล/ได้แก่</para>
  <para style="li1" vid="1CH 5:3">ฮาโนค ปัลลู เฮสโรน และ/คารมี<verse eid="1CH 5:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 5:4" />วงศ์วาน/ของ/โยเอล ได้แก่</para>
  <para style="li1" vid="1CH 5:4">บุตร/ชื่อ/เชไมอาห์ ซึ่ง/มี/บุตร/คือ/โกก ซึ่ง/มี/บุตร/คือ/ชิเมอี <verse eid="1CH 5:4" /><verse number="5" style="v" sid="1CH 5:5" />ซึ่ง/มี/บุตร/คือ/มีคาห์ ซึ่ง/มี/บุตร/คือ/เรอายาห์ ซึ่ง/มี/บุตร/คือ/บาอัล<verse eid="1CH 5:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 5:6" />บุตร/ของ/บาอัล/คือ/เบเอราห์/ผู้/นำ/คน/หนึ่ง/ของ/ตระกูล/รูเบน ซึ่ง/ถูก/จับไป/เป็น/เชลย/ของ/กษัตริย์/ทิกลัท/ปิเลเสอร์<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">ทิลกัทปิลเนเสอร์/</char><char style="ft" closed="false">เป็น/อีก/รูป/หนึ่ง/ของ/</char><char style="fqa" closed="false">ทิกลัท/ปิเลเสอร์/</char><char style="ft" closed="false">เช่น/เดียว/กับ/ข้อ 26</char></note>แห่ง/อัสซีเรีย<verse eid="1CH 5:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 5:7" />ญาติ/ของเขา/ตาม/ตระกูล/ต่างๆ ที่/บันทึก/ใน/ลำดับ/วงศ์ตระกูล ได้แก่</para>
  <para style="li1" vid="1CH 5:7">เยอีเอล/ผู้/เป็น/หัวหน้า เศคาริยาห์ <verse eid="1CH 5:7" /><verse number="8" style="v" sid="1CH 5:8" />และ/เบลา/ผู้/เป็น/บุตร/ของ/อาซาส ผู้/เป็น/บุตร/ของ/เชมา ผู้/เป็น/บุตร/ของ/โยเอล พวกเขา/ตั้ง/ถิ่นฐาน/จาก/เมือง/อาโรเออร์/จด/เมือง/เนโบ/และ/เมือง/บาอัลเมโอน <verse eid="1CH 5:8" /><verse number="9" style="v" sid="1CH 5:9" />ทาง/ตะวันออก พวกเขา/ครอบครอง/ดินแดน/ไป/จด/เขต/ถิ่น/กันดาร/ซึ่ง/ไป/สู่/แม่น้ำ/ยูเฟรติส เพราะ/ฝูงสัตว์/ขยาย/เพิ่มขึ้น/ใน/ดินแดน/กิเลอาด<verse eid="1CH 5:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 5:10" />ใน/รัชกาล/กษัตริย์/ซาอูล/พวกเขา/รบชนะ/ชาว/ฮาการ์/และ/ครอบครอง/ที่อยู่อาศัย/ของ/พวกเขา/ทั่ว/ภูมิภาค/ตะวันออก/ทั้งหมด/ของ/กิเลอาด<verse eid="1CH 5:10" /></para>
  <para style="s1">วงศ์วาน/ของ/กาด</para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 5:11" />ชนเผ่า/กาด/อาศัย/ถัดจาก/พวกเขา/ใน/ดินแดน/บาชาน/จน/จด/เมือง/สาเลคาห์<verse eid="1CH 5:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 5:12" />โยเอล/เป็น/หัวหน้า รอง/ลงมา/คือ/ชาฟาม จาก/นั้น/คือ/ยานัย/กับ/ชาฟัท/ใน/บาชาน<verse eid="1CH 5:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 5:13" />ญาติ/ของเขา/ตาม/ครอบครัว/ต่างๆ ได้แก่ มีคาเอล เมชุลลาม เชบา โยรัย ยาคาน ศิอา และ/เอเบอร์ รวม/เจ็ด/คน<verse eid="1CH 5:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 5:14" />คน/เหล่านี้/คือ/บุตร/ของ/อาบีฮายิล ผู้/เป็น/บุตร/ของ/หุรี ผู้/เป็น/บุตร/ของ/ยาโรอาห์ ผู้/เป็น/บุตร/ของ/กิเลอาด ผู้/เป็น/บุตร/ของ/มิคาเอล ผู้/เป็น/บุตร/ของ/เยชิชัย ผู้/เป็น/บุตร/ของ/ยาโด ผู้/เป็น/บุตร/ของ/บูส<verse eid="1CH 5:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 5:15" />อาหิ/บุตร/ของ/อับดีเอล ผู้/เป็น/บุตร/ของ/กูนี เป็น/หัวหน้า/ครอบครัว<verse eid="1CH 5:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 5:16" />ชนเผ่า/กาด/อาศัย/อยู่/ใน/ดินแดน/กิเลอาด ใน/ดินแดน/บาชาน และ/หมู่บ้าน/โดยรอบ และ/ตลอดไป/จน/สุด/ทุ่งหญ้า/แห่ง/ชาโรน<verse eid="1CH 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 5:17" />ทั้งหมด/นี้/ล้วน/มี/ชื่อ/อยู่/ใน/บันทึก/ลำดับ/วงศ์ตระกูล/ใน/รัชกาล/กษัตริย์/โยธาม/แห่ง/ยูดาห์/และ/กษัตริย์/เยโรโบอัม/แห่ง/อิสราเอล<verse eid="1CH 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18" />ชนเผ่า/รูเบน กาด และ/มนัสเสห์/ครึ่งเผ่า/มี/กำลัง/พล 44,760 คน/เพื่อ/ออกรบ ทุกคน/ล้วน/แข็งแรง/แกล้ว/กล้า สามารถ/ถือ/โล่ จับ/ดาบ ใช้/ธนู และ/ผ่าน/การฝึก/เพื่อ/สู้รบ <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" />พวกเขา/สู้รบ/กับ/ชาว/ฮาการ์ ชาว/เยทูร์ ชาว/นาฟิช และ/ชาว/โนดับ <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" />พระเจ้า/ทรง/ช่วย/เหลือ/พวกเขา/ใน/การสู้รบ และ/พระองค์/ทรงมอบ/ชาว/ฮาการ์/กับ/พันธมิตร/ทั้งปวง/แก่/พวกเขา เพราะ/พวกเขา/ร้อง/ทูล/พระองค์/ขณะ/สู้รบ พระองค์/ทรง/ตอบ/คำ/อธิษฐาน/ของ/พวกเขา/เนื่องจาก/พวกเขา/วางใจ/ใน/พระองค์ <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />พวกเขา/ยึด/ฝูงสัตว์/มา/จาก/ชาว/ฮาการ์ มี/อูฐ 50,000 ตัว แกะ 250,000 ตัว ลา 2,000 ตัว และ/เชลย 100,000 คน <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" />ศัตรู/มากมาย/ถูกฆ่าตาย/เพราะ/ศึก/ครั้งนี้/เป็น/ของ/พระเจ้า พวกเขา/ครอบครอง/ดินแดน/อยู่/จนกระทั่ง/ตก/เป็น/เชลย<verse eid="1CH 5:22" /></para>
  <para style="s1">วงศ์วาน/ของ/มนัสเสห์/ครึ่งเผ่า</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />เผ่า/มนัสเสห์/ครึ่งเผ่า/ตั้งรกราก/อยู่/ทั่ว/แดน/จาก/บาชาน/จด/บาอัลเฮอร์โมน คือ/เสนีร์ (หรือ/ภูเขา/เฮอร์โมน) พวกเขา/มี/จำนวน/มาก<verse eid="1CH 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 5:24" />หัวหน้า/ครอบครัว/ของ/พวกเขา/ได้แก่ เอเฟอร์ อิชอี เอลีเอล อัสรีเอล เยเรมีย์ โฮดาวิยาห์ และ/ยาดีเอล ล้วน/แล้วแต่/เป็น/นักรบ/กล้าหาญ มี/ชื่อเสียง และ/เป็น/ผู้นำ/ครอบครัว <verse eid="1CH 5:24" /><verse number="25" style="v" sid="1CH 5:25" />แต่/พวกเขา/ไม่/ซื่อสัตย์/ต่อ/พระเจ้า/ของ/บรรพบุรุษ กลับ/ปล่อยตัว/ปล่อย/ใจ/ให้/กับ/เทพเจ้า/ต่างๆ ของ/บรรดา/ชนชาติ/ที่/พระเจ้า/ได้/ทรง/ทำลาย/ล้าง/ไป/ต่อหน้า/พวกเขา <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" />ฉะนั้น/พระเจ้า/แห่ง/อิสราเอล/ทรงดลใจ/กษัตริย์/ปูล (คือ/ทิกลัท/ปิเลเสอร์)แห่ง/อัสซีเรีย/ให้/มา/พิชิต/และ/กวาดต้อน/ชนเผ่า/รูเบน กาด และ/มนัสเสห์/ครึ่งเผ่า/ไป/เป็น/เชลย/อยู่/ใน/แดน/ฮาลาห์ ฮาโบร์ ฮารา และ/แม่/น้ำ/โกซาน/จวบจน/ทุกวันนี้<verse eid="1CH 5:26" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="s1">วงศ์วาน/ของ/เลวี</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 6:1" />บุตร/ของ/เลวี ได้แก่</para>
  <para style="li1" vid="1CH 6:1">เกอร์โชน โคฮาท และ/เมรารี<verse eid="1CH 6:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 6:2" />บุตร/ของ/โคฮาท ได้แก่</para>
  <para style="li1" vid="1CH 6:2">อัมราม อิสฮาร์ เฮโบรน และ/อุสซีเอล<verse eid="1CH 6:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 6:3" />บุตร/ของ/อัมราม ได้แก่</para>
  <para style="li1" vid="1CH 6:3">อาโรน โมเสส และ/มิเรียม</para>
  <para style="li1" vid="1CH 6:3">บุตร/ของ/อาโรน ได้แก่</para>
  <para style="li1" vid="1CH 6:3">นาดับ อาบีฮู เอเลอาซาร์ และ/อิธามาร์<verse eid="1CH 6:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 6:4" />เอเลอาซาร์/เป็น/บิดา/ของ/ฟีเนหัส</para>
  <para style="li1" vid="1CH 6:4">ฟีเนหัส/เป็น/บิดา/ของ/อาบีชูวา<verse eid="1CH 6:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 6:5" />อาบีชูวา/เป็น/บิดา/ของ/บุคคี</para>
  <para style="li1" vid="1CH 6:5">บุคคี/เป็น/บิดา/ของ/อุสซี<verse eid="1CH 6:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 6:6" />อุสซี/เป็น/บิดา/ของ/เศราหิยาห์</para>
  <para style="li1" vid="1CH 6:6">เศราหิยาห์/เป็น/บิดา/ของ/เมราโยท<verse eid="1CH 6:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 6:7" />เมราโยท/เป็น/บิดา/ของ/อามาริยาห์</para>
  <para style="li1" vid="1CH 6:7">อามาริยาห์/เป็น/บิดา/ของ/อาหิทูบ<verse eid="1CH 6:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 6:8" />อาหิทูบ/เป็น/บิดา/ของ/ศาโดก</para>
  <para style="li1" vid="1CH 6:8">ศาโดก/เป็น/บิดา/ของ/อาหิมาอัส<verse eid="1CH 6:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 6:9" />อาหิมาอัส/เป็น/บิดา/ของ/อาซาริยาห์</para>
  <para style="li1" vid="1CH 6:9">อาซาริยาห์/เป็น/บิดา/ของ/โยฮานัน<verse eid="1CH 6:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 6:10" />โยฮานัน/เป็น/บิดา/ของ/อาซาริยาห์ (เขา/เป็น/ปุโรหิต/ของ/พระวิหาร/ที่/โซโลมอน/ทรงสร้าง/ขึ้น/ใน/กรุง/เยรูซาเล็ม)<verse eid="1CH 6:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 6:11" />อาซาริยาห์/เป็น/บิดา/ของ/อามาริยาห์</para>
  <para style="li1" vid="1CH 6:11">อามาริยาห์/เป็น/บิดา/ของ/อาหิทูบ<verse eid="1CH 6:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 6:12" />อาหิทูบ/เป็น/บิดา/ของ/ศาโดก</para>
  <para style="li1" vid="1CH 6:12">ศาโดก/เป็น/บิดา/ของ/ชัลลูม<verse eid="1CH 6:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 6:13" />ชัลลูม/เป็น/บิดา/ของ/ฮิลคียาห์</para>
  <para style="li1" vid="1CH 6:13">ฮิลคียาห์/เป็น/บิดา/ของ/อาซาริยาห์<verse eid="1CH 6:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 6:14" />อาซาริยาห์/เป็น/บิดา/ของ/เสไรยาห์</para>
  <para style="li1" vid="1CH 6:14">และ/เสไรยาห์/เป็น/บิดา/ของ/เยโฮซาดัก<verse eid="1CH 6:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 6:15" />เยโฮซาดัก/ถูก/กวาดต้อน/ไป/เป็น/เชลย เมื่อ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรงให้/ประชากร/ยูดาห์/และ/เยรูซาเล็ม/ตก/เป็น/เชลย/ของ/กษัตริย์/เนบูคัดเนสซาร์<verse eid="1CH 6:15" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="16" style="v" sid="1CH 6:16" />บุตร/ของ/เลวี ได้แก่</para>
  <para style="li1" vid="1CH 6:16">เกอร์โชน<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">เกอร์โชม/</char><char style="ft" closed="false">เป็น/อีก/รูป/หนึ่ง/ของ/</char><char style="fqa" closed="false">เกอร์โชน/</char><char style="ft" closed="false">เช่น/เดียว/กับ/ข้อ 17,20,43,62 และ 71</char></note> โคฮาท และ/เมรารี<verse eid="1CH 6:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 6:17" />รายชื่อ/บุตร/ของ/เกอร์โชน ได้แก่</para>
  <para style="li1" vid="1CH 6:17">ลิบนี/กับ/ชิเมอี<verse eid="1CH 6:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 6:18" />บุตร/ของ/โคฮาท ได้แก่</para>
  <para style="li1" vid="1CH 6:18">อัมราม อิสฮาร์ เฮโบรน และ/อุสซีเอล<verse eid="1CH 6:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 6:19" />บุตร/ของ/เมรารี ได้แก่</para>
  <para style="li1" vid="1CH 6:19">มาห์ลี/กับ/มูชี</para>
  <para style="p" vid="1CH 6:19">ตระกูล/ต่างๆ ของ/เลวี/ลำดับ/ตาม/ต้นตระกูล/มี/ดังนี้<verse eid="1CH 6:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 6:20" />วงศ์วาน/ของ/เกอร์โชน ได้แก่</para>
  <para style="li1" vid="1CH 6:20">ลิบนี/ซึ่ง/มี/บุตร/คือ/ยาหาท ซึ่ง/มี/บุตร/คือ/ศิมมาห์ <verse eid="1CH 6:20" /><verse number="21" style="v" sid="1CH 6:21" />ซึ่ง/มี/บุตร/คือ/โยอาห์ ซึ่ง/มี/บุตร/คือ/อิดโด ซึ่ง/มี/บุตร/คือ/เศราห์ ซึ่ง/มี/บุตร/คือ/เยอาเธรัย<verse eid="1CH 6:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 6:22" />วงศ์วาน/ของ/โคฮาท ได้แก่</para>
  <para style="li1" vid="1CH 6:22">อัมมีนาดับ ซึ่ง/มี/บุตร/คือ/โคราห์</para>
  <para style="li1" vid="1CH 6:22">ซึ่ง/มี/บุตร/คือ/อัสสีร์ <verse eid="1CH 6:22" /><verse number="23" style="v" sid="1CH 6:23" />ซึ่ง/มี/บุตร/คือ/เอลคานาห์</para>
  <para style="li1" vid="1CH 6:23">ซึ่ง/มี/บุตร/คือ/เอบียาสาฟ ซึ่ง/มี/บุตร/คือ/อัสสีร์<verse eid="1CH 6:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 6:24" />ซึ่ง/มี/บุตร/คือ/ทาหัท ซึ่ง/มี/บุตร/คือ/อูรี/เอล ซึ่ง/มี/บุตร/คือ/อุสซียาห์ ซึ่ง/มี/บุตร/คือ/ชาอูล<verse eid="1CH 6:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 6:25" />วงศ์วาน/ของ/เอลคานาห์ ได้แก่</para>
  <para style="li1" vid="1CH 6:25">อามาสัย อาหิโมท<verse eid="1CH 6:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 6:26" />ซึ่ง/มี/บุตร/คือ/เอลคานาห์<note caller="+" style="f"><char style="fr" closed="false">6:26 </char><char style="ft" closed="false">สำเนา/ต้นฉบับ/ภาษาฮีบรู/ส่วนใหญ่/ว่า/</char><char style="fqa" closed="false">อาหิโมท </char><char style="fv" closed="false">26 </char><char style="fqa" closed="false">และ/เอลคานาห์ บุตร/ของ/เอลคานาห์ ได้แก่</char></note></para>
  <para style="li1" vid="1CH 6:26">ซึ่ง/มี/บุตร/คือ/โศฟัย ซึ่ง/มี/บุตร/คือ/นาหาท <verse eid="1CH 6:26" /><verse number="27" style="v" sid="1CH 6:27" />ซึ่ง/มี/บุตร/คือ/เอลีอับ ซึ่ง/มี/บุตร/คือ/เยโรฮัม ซึ่ง/มี/บุตร/คือ/เอลคานาห์ ซึ่ง/มี/บุตร/คือ/ซามูเอล<note caller="+" style="f"><char style="fr" closed="false">6:27 </char><char style="ft" closed="false">ภาษาฮีบรู/ไม่มี/วลี/ที่ว่า/</char><char style="fqa" closed="false">ซึ่ง/มี/บุตร/คือ/ซามูเอล/</char><char style="ft" closed="false">(ดู/<char style="xt"><ref loc="1SA 1:19">1ซมอ.1:19</ref>,<ref loc="1SA 1:20">20</ref></char> และ/<char style="xt"><ref loc="1CH 6:33">1พศด.6:33</ref>,<ref loc="1CH 6:34">34</ref></char>)</char></note><verse eid="1CH 6:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 6:28" />บุตร/ของ/ซามูเอล ได้แก่</para>
  <para style="li1" vid="1CH 6:28">โยเอล<note caller="+" style="f"><char style="fr" closed="false">6:28 </char><char style="ft" closed="false">ภาษาฮีบรู/ไม่มี/คำ/ว่า/</char><char style="fqa" closed="false">โยเอล/</char><char style="ft" closed="false">(ดู/<char style="xt"><ref loc="1SA 8:2">1ซมอ.8:2</ref></char> และ/<char style="xt"><ref loc="1CH 6:33">1พศด.6:33</ref></char>)</char></note>ผู้/เป็น/บุตร/หัวปี</para>
  <para style="li1" vid="1CH 6:28">กับ/อาบียาห์/บุตร/คน/รอง<verse eid="1CH 6:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 6:29" />วงศ์วาน/ของ/เมรารี ได้แก่</para>
  <para style="li1" vid="1CH 6:29">มาห์ลี/ซึ่ง/มี/บุตร/คือ/ลิบนี ซึ่ง/มี/บุตร/คือ/ชิเมอี ซึ่ง/มี/บุตร/คือ/อุสซาห์<verse eid="1CH 6:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 6:30" />ซึ่ง/มี/บุตร/คือ/ชิเมอา ซึ่ง/มี/บุตร/คือ/ฮักกียาห์ ซึ่ง/มี/บุตร/คือ/อาสายาห์<verse eid="1CH 6:30" /></para>
  <para style="s2">นักดนตรี/ประจำ/พระวิหาร</para>
  <para style="r">(<ref loc="JOS 21:4-39">ยชว.21:4-39</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31" />ต่อไปนี้/คือ/ผู้/ที่/กษัตริย์/ดาวิด/ทรง/แต่งตั้ง/ให้/บรรเลง/เพลง/ใน/พระ/นิเวศ/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/หลังจากที่/นำ/หีบ/พันธสัญญา/มา/ตั้งไว้/ที่นั่น/แล้ว <verse eid="1CH 6:31" /><verse number="32" style="v" sid="1CH 6:32" />พวกเขา/ทำ/หน้าที่/บรรเลง/เพลง/หน้า/พลับพลา ซึ่งก็คือ/เต็นท์/นัดพบ ตราบจน/โซโลมอน/สร้าง/พระวิหาร/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ที่/กรุง/เยรูซาเล็ม/เสร็จแล้ว พวกเขา/ปฏิบัติ/หน้าที่/ตาม/กฎ/ระเบียบ/ที่ตั้ง/ไว้<verse eid="1CH 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 6:33" />คน/เหล่านี้/ซึ่ง/ปฏิบัติ/หน้าที่/พร้อมกับ/บุตร/ทั้งหลาย/ของ/ตน ได้แก่</para>
  <para style="li1" vid="1CH 6:33">จาก/วงศ์/โคฮาท คือ</para>
  <para style="li1" vid="1CH 6:33">เฮมาน/นักดนตรี</para>
  <para style="li1" vid="1CH 6:33">ซึ่งเป็น/บุตร/ของ/โยเอล ซึ่งเป็น/บุตร/ของ/ซามูเอล<verse eid="1CH 6:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 6:34" />ซึ่งเป็น/บุตร/ของ/เอลคานาห์ ซึ่งเป็น/บุตร/ของ/เยโรฮัม</para>
  <para style="li1" vid="1CH 6:34">ซึ่งเป็น/บุตร/ของ/เอลีเอล ซึ่งเป็น/บุตร/ของ/โทอาห์<verse eid="1CH 6:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 6:35" />ซึ่งเป็น/บุตร/ของ/ศุฟ ซึ่งเป็น/บุตร/ของ/เอลคานาห์</para>
  <para style="li1" vid="1CH 6:35">ซึ่งเป็น/บุตร/ของ/มาฮาท ซึ่งเป็น/บุตร/ของ/อามาสัย<verse eid="1CH 6:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 6:36" />ซึ่งเป็น/บุตร/ของ/เอลคานาห์ ซึ่งเป็น/บุตร/ของ/โยเอล</para>
  <para style="li1" vid="1CH 6:36">ซึ่งเป็น/บุตร/ของ/อาซาริยาห์ ซึ่งเป็น/บุตร/ของ/เศฟันยาห์<verse eid="1CH 6:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 6:37" />ซึ่งเป็น/บุตร/ของ/ทาหัท ซึ่งเป็น/บุตร/ของ/อัสสีร์</para>
  <para style="li1" vid="1CH 6:37">ซึ่งเป็น/บุตร/ของ/เอบียาสาฟ ซึ่งเป็น/บุตร/ของ/โคราห์<verse eid="1CH 6:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 6:38" />ซึ่งเป็น/บุตร/ของ/อิสฮาร์ ซึ่งเป็น/บุตร/ของ/โคฮาท</para>
  <para style="li1" vid="1CH 6:38">ซึ่งเป็น/บุตร/ของ/เลวี ซึ่งเป็น/บุตร/ของ/อิสราเอล<verse eid="1CH 6:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 6:39" />ผู้/ช่วย/มือขวา/ของ/เฮมาน/คือ/อาสาฟ</para>
  <para style="li1" vid="1CH 6:39">ซึ่งเป็น/บุตร/ของ/เบเรคิยาห์ ซึ่งเป็น/บุตร/ของ/ชิเมอา<verse eid="1CH 6:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 6:40" />ซึ่งเป็น/บุตร/ของ/มีคาเอล ซึ่งเป็น/บุตร/ของ/บาอาเสยาห์<note caller="+" style="f"><char style="fr" closed="false">6:40 </char><char style="ft" closed="false">สำเนา/ต้นฉบับ/ภาษาฮีบรู/บางฉบับ และ/สำเนา/ฉบับ LXX. หนึ่ง/ฉบับ/และ/ฉบับ Syr. ว่า/</char><char style="fqa" closed="false">มาอาเสยาห์</char></note></para>
  <para style="li1" vid="1CH 6:40">ซึ่งเป็น/บุตร/ของ/มัลคิยาห์ <verse eid="1CH 6:40" /><verse number="41" style="v" sid="1CH 6:41" />ซึ่งเป็น/บุตร/ของ/เอทนี</para>
  <para style="li1" vid="1CH 6:41">ซึ่งเป็น/บุตร/ของ/เศราห์ ซึ่งเป็น/บุตร/ของ/อาดายาห์<verse eid="1CH 6:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 6:42" />ซึ่งเป็น/บุตร/เอธาน ซึ่งเป็น/บุตร/ของ/ศิมมาห์</para>
  <para style="li1" vid="1CH 6:42">ซึ่งเป็น/บุตร/ของ/ชิเมอี <verse eid="1CH 6:42" /><verse number="43" style="v" sid="1CH 6:43" />ซึ่งเป็น/บุตร/ของ/ยาหาท</para>
  <para style="li1" vid="1CH 6:43">ซึ่งเป็น/บุตร/ของ/เกอร์โชน ซึ่งเป็น/บุตร/ของ/เลวี<verse eid="1CH 6:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 6:44" />ผู้/ช่วย/มือซ้าย/ของเขา/คือ/เอธาน ตระกูล/เมรารี</para>
  <para style="li1" vid="1CH 6:44">ซึ่งเป็น/บุตร/ของ/คีชี ซึ่งเป็น/บุตร/ของ/อับดี</para>
  <para style="li1" vid="1CH 6:44">ซึ่งเป็น/บุตร/ของ/มัลลุค <verse eid="1CH 6:44" /><verse number="45" style="v" sid="1CH 6:45" />ซึ่งเป็น/บุตร/ของ/ฮาชาบิยาห์</para>
  <para style="li1" vid="1CH 6:45">ซึ่งเป็น/บุตร/ของ/อามาซิยาห์ ซึ่งเป็น/บุตร/ของ/ฮิลคียาห์<verse eid="1CH 6:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 6:46" />ซึ่งเป็น/บุตร/ของ/อัมซี ซึ่งเป็น/บุตร/ของ/บานี</para>
  <para style="li1" vid="1CH 6:46">ซึ่งเป็น/บุตร/ของ/เชเมอร์ <verse eid="1CH 6:46" /><verse number="47" style="v" sid="1CH 6:47" />ซึ่งเป็น/บุตร/ของ/มาห์ลี</para>
  <para style="li1" vid="1CH 6:47">ซึ่งเป็น/บุตร/ของ/มูชี ซึ่งเป็น/บุตร/ของ/เมรารี</para>
  <para style="li1" vid="1CH 6:47">ซึ่งเป็น/บุตร/ของ/เลวี<verse eid="1CH 6:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48" />ส่วน/พี่น้อง/ตระกูล/เลวี/ได้รับ/มอบหมาย/หน้าที่/อื่นๆ ทั้งหมด/ใน/พลับพลา/ซึ่งเป็น/พระ/นิเวศ/ของ/พระเจ้า <verse eid="1CH 6:48" /><verse number="49" style="v" sid="1CH 6:49" />แต่/อาโรน/และ/วงศ์วาน/เป็น/ผู้/ถวาย/เครื่อง/บูชา/ต่างๆ และ/เครื่อง/หอม/บน/แท่น/บูชา/รวมทั้ง/ดูแล/กิจธุระ/ทั้งหมด/ที่/เกี่ยวกับ/อภิสุทธิสถาน และ/การขอ/อภัยโทษ/บาป/สำหรับ/อิสราเอล/ให้/ครบถ้วน/ทุก/ประการ/ตามที่/โมเสส/ผู้/รับใช้/พระเจ้า/ได้/บัญชา/ไว้<verse eid="1CH 6:49" /></para>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 6:50" />วงศ์วาน/ของ/อาโรน ได้แก่</para>
  <para style="li1" vid="1CH 6:50">เอเลอาซาร์ ซึ่ง/มี/บุตร/คือ/ฟีเนหัส</para>
  <para style="li1" vid="1CH 6:50">ซึ่ง/มี/บุตร/คือ/อาบีชูวา <verse eid="1CH 6:50" /><verse number="51" style="v" sid="1CH 6:51" />ซึ่ง/มี/บุตร/คือ/บุคคี</para>
  <para style="li1" vid="1CH 6:51">ซึ่ง/มี/บุตร/คือ/อุสซี ซึ่ง/มี/บุตร/คือ/เศราหิยาห์<verse eid="1CH 6:51" /></para>
  <para style="li1">
    <verse number="52" style="v" sid="1CH 6:52" />ซึ่ง/มี/บุตร/คือ/เมราโยท ซึ่ง/มี/บุตร/คือ/อามาริยาห์</para>
  <para style="li1" vid="1CH 6:52">ซึ่ง/มี/บุตร/คือ/อาหิทูบ <verse eid="1CH 6:52" /><verse number="53" style="v" sid="1CH 6:53" />ซึ่ง/มี/บุตร/คือ/ศาโดก ซึ่ง/มี/บุตร/คือ/อาหิมาอัส<verse eid="1CH 6:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="1CH 6:54" />พื้นที่/ซึ่ง/ได้รับ/การแบ่ง/สรร/ให้/เป็น/เขต/แดน/สำหรับ/ตั้ง/ถิ่นฐาน/ของ/พวกเขา/มี/ดังนี้ (สลาก/แรก/สุด/ได้แก่ วงศ์วาน/ของ/อาโรน/ใน/ตระกูล/โคฮาท)<verse eid="1CH 6:54" /></para>
  <para style="pi1">
    <verse number="55" style="v" sid="1CH 6:55" />พวกเขา/ได้/รับ/เมือง/เฮโบรน/ใน/ยูดาห์/และ/ทุ่งหญ้า/โดยรอบ <verse eid="1CH 6:55" /><verse number="56" style="v" sid="1CH 6:56" />แต่/ท้องทุ่ง/และ/หมู่บ้าน/ของ/เมือง/นั้น/ยกให้/แก่/คาเลบ/บุตร/เยฟุนเนห์<verse eid="1CH 6:56" /></para>
  <para style="pi1">
    <verse number="57" style="v" sid="1CH 6:57" />วงศ์วาน/ของ/อาโรน/จึง/ได้/รับ/เฮโบรน (เมือง/ลี้ภัย) ลิบนาห์<note caller="+" style="f"><char style="fr" closed="false">6:57 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">ได้รับ/เมือง/ลี้ภัย/ต่างๆ ได้แก่ เฮโบรน/</char><char style="ft" closed="false">(ดู/<char style="xt"><ref loc="JOS 21:13">ยชว.21:13</ref></char>)</char></note> ยาททีร์ เอชเทโมอา <verse eid="1CH 6:57" /><verse number="58" style="v" sid="1CH 6:58" />ฮีเลน เดบีร์ <verse eid="1CH 6:58" /><verse number="59" style="v" sid="1CH 6:59" />อาชัน ยุททาห์<note caller="+" style="f"><char style="fr" closed="false">6:59 </char><char style="ft" closed="false">ภาษาฮีบรู/ไม่มี/คำ/ว่า/</char><char style="fqa" closed="false">ยุททาห์/</char><char style="ft" closed="false">(ดู/<char style="xt"><ref loc="JOS 21:16">ยชว.21:16</ref></char>)</char></note>และ/เบธเชเมช/รวมทั้ง/ทุ่งหญ้า/โดยรอบ <verse eid="1CH 6:59" /><verse number="60" style="v" sid="1CH 6:60" />และ/จาก/ตระกูล/เบนยามิน ได้รับ/กิเบโอน<note caller="+" style="f"><char style="fr" closed="false">6:60 </char><char style="ft" closed="false">ภาษาฮีบรู/ไม่มี/คำ/ว่า/</char><char style="fqa" closed="false">กิเบโอน/</char><char style="ft" closed="false">(ดู/<char style="xt"><ref loc="JOS 21:17">ยชว.21:17</ref></char>)</char></note> เกบา อาเลเมท และ/อานาโธท/รวม/ทุ่งหญ้า</para>
  <para style="pi1" vid="1CH 6:60">เมือง/เหล่านี้/รวม 13 เมือง/แบ่งสรร/กัน/ใน/หมู่/ตระกูล/โคฮาท<verse eid="1CH 6:60" /></para>
  <para style="li1">
    <verse number="61" style="v" sid="1CH 6:61" />คนอื่นๆ ที่/เหลือ/ใน/วงศ์วาน/ของ/โคฮาท/ได้รับ/การแบ่ง/สรร 10 เมือง/จาก/ตระกูล/ต่างๆ ของ/มนัสเสห์/ครึ่งเผ่า<verse eid="1CH 6:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="1CH 6:62" />สำหรับ/วงศ์วาน/ของ/เกอร์โชน/ตามแต่/ละ/ตระกูล/ได้รับ 13 เมือง/ใน/บาชาน/จาก/เผ่า/อิสสาคาร์ อาเชอร์ นัฟทาลี และ/บางส่วน/ของ/เผ่า/มนัสเสห์/ที่/อยู่/ใน/บาชาน<verse eid="1CH 6:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="1CH 6:63" />วงศ์วาน/ของ/เมรารี/ตามแต่/ละ/ตระกูล/ได้รับ 12 เมือง/จาก/เผ่ารูเบน กาด และ/เศบูลุน<verse eid="1CH 6:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="1CH 6:64" />เป็นอันว่า/ชน/อิสราเอล/ได้/มอบ/เมือง/ต่างๆ พร้อม/ทุ่งหญ้า/แก่/ชน/เลวี <verse eid="1CH 6:64" /><verse number="65" style="v" sid="1CH 6:65" />พวกเขา/แบ่งสรร/เมือง/ดังกล่าว/ให้/จาก/เผ่ายูดาห์ สิเมโอน และ/เบนยามิน<verse eid="1CH 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="1CH 6:66" />เผ่า/เอฟราอิม/มอบ/เมือง/ต่างๆ พร้อม/ทุ่งหญ้า/โดยรอบ/ให้แก่/ตระกูล/ต่างๆ ของ/โคฮาท<verse eid="1CH 6:66" /></para>
  <para style="pi1">
    <verse number="67" style="v" sid="1CH 6:67" />พวกเขา/ได้/รับ/เมือง/เชเคม (เมือง/ลี้ภัย)<note caller="+" style="f"><char style="fr" closed="false">6:67 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">ได้รับ/เมือง/ลี้ภัย/ต่างๆ ได้แก่ เมือง/เชเคม/</char><char style="ft" closed="false">(ดู/<char style="xt"><ref loc="JOS 21:21">ยชว.21:21</ref></char>)</char></note> ใน/แดน/เทือกเขา/แห่ง/เอฟราอิม เมือง/เกเซอร์ <verse eid="1CH 6:67" /><verse number="68" style="v" sid="1CH 6:68" />เมือง/โยกเมอัม เมือง/เบธโฮโรน <verse eid="1CH 6:68" /><verse number="69" style="v" sid="1CH 6:69" />เมืองอัย/ยาโลน และ/เมืองกัท/ริมโมน/พร้อม/ทุ่งหญ้า<verse eid="1CH 6:69" /></para>
  <para style="pi1">
    <verse number="70" style="v" sid="1CH 6:70" />เผ่า/มนัสเสห์/อีก/ครึ่งเผ่า/ได้/มอบ/เมือง/อาเนอร์/และ/เมือง/บิเลอัม/พร้อมทั้ง/ทุ่งหญ้า/ให้แก่/ตระกูล/อื่นๆ ที่/เหลือ/ของ/โคฮาท<verse eid="1CH 6:70" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="71" style="v" sid="1CH 6:71" />เชื้อสาย/เกอร์โชน/ได้รับ/ดังนี้</para>
  <para style="li1" vid="1CH 6:71">เผ่า/มนัสเสห์/ครึ่งเผ่า</para>
  <para style="li1" vid="1CH 6:71">มอบ/เมือง/โกลาน/ใน/บาชาน/กับ/อัชทาโรท พร้อม/ทุ่งหญ้า<verse eid="1CH 6:71" /></para>
  <para style="li1">
    <verse number="72" style="v" sid="1CH 6:72" />เผ่า/อิสสาคาร์</para>
  <para style="li1" vid="1CH 6:72">มอบ/เมือง/เคเดช เมือง/ดาเบรัท <verse eid="1CH 6:72" /><verse number="73" style="v" sid="1CH 6:73" />เมือง/ราโมท และ/เมือง/อาเนม พร้อม/ทุ่งหญ้า<verse eid="1CH 6:73" /></para>
  <para style="li1">
    <verse number="74" style="v" sid="1CH 6:74" />เผ่า/อาเชอร์</para>
  <para style="li1" vid="1CH 6:74">มอบ/เมือง/มาชาล เมือง/อับโดน <verse eid="1CH 6:74" /><verse number="75" style="v" sid="1CH 6:75" />เมือง/ฮุกอก และ/เมือง/เรโหบ พร้อม/ทุ่งหญ้า<verse eid="1CH 6:75" /></para>
  <para style="li1">
    <verse number="76" style="v" sid="1CH 6:76" />และ/เผ่า/นัฟทาลี</para>
  <para style="li1" vid="1CH 6:76">มอบ/เมือง/เคเดช/ใน/กาลิลี เมือง/ฮัมโมน และ/เมือง/คีริยาธาอิม พร้อม/ทุ่งหญ้า<verse eid="1CH 6:76" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="77" style="v" sid="1CH 6:77" />เชื้อสาย/เมรารี (ชน/เลวี/อื่นๆ ที่/เหลือ)ได้รับ/ดังนี้</para>
  <para style="li1" vid="1CH 6:77">เผ่า/เศบูลุน/มอบ/เมือง/โยกเนอัม เมือง/คารทาห์<note caller="+" style="f"><char style="fr" closed="false">6:77 </char><char style="ft" closed="false">ภาษาฮีบรู/ไม่มี/คำ/ว่า/</char><char style="fqa" closed="false">เมือง/โยกเนอัม เมือง/คารทาห์</char></note> เมือง/ริมโมโน/กับ/เมือง/ทาโบร์ พร้อม/ทุ่งหญ้า<verse eid="1CH 6:77" /></para>
  <para style="li1">
    <verse number="78" style="v" sid="1CH 6:78" />เผ่ารูเบน/จาก/อีก/ฟาก/ของ/แม่น้ำ/จอร์แดน/ฝั่ง/ตะวันออก/ของ/เมือง/เยรีโค</para>
  <para style="li1" vid="1CH 6:78">มอบ/เมือง/เบเซอร์/ใน/ถิ่น/กันดาร เมือง/ยาซาห์ <verse eid="1CH 6:78" /><verse number="79" style="v" sid="1CH 6:79" />เมือง/เคเดโมท และ/เมือง/เมฟาอาท พร้อม/ทุ่งหญ้า<verse eid="1CH 6:79" /></para>
  <para style="li1">
    <verse number="80" style="v" sid="1CH 6:80" />และ/เผ่ากาด</para>
  <para style="li1" vid="1CH 6:80">มอบ/เมือง/ราโมท/ใน/กิเลอาด เมือง/มาหะนาอิม <verse eid="1CH 6:80" /><verse number="81" style="v" sid="1CH 6:81" />เมือง/เฮชโบน/และ/เมือง/ยาเซอร์ พร้อม/ทุ่งหญ้า<verse eid="1CH 6:81" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="s1">วงศ์วาน/ของ/อิสสาคาร์</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 7:1" />บุตร/ของ/อิสสาคาร์ ได้แก่</para>
  <para style="li1" vid="1CH 7:1">โทลา ปูอาห์ ยาชูบ และ/ชิมโรน รวม/สี่/คน<verse eid="1CH 7:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 7:2" />บุตร/ของ/โทลา ได้แก่</para>
  <para style="li1" vid="1CH 7:2">อุสซี เรไฟยาห์ เยรีเอล ยามัย อิบสัม และ/ซามูเอล ล้วนแต่/เป็น/หัวหน้า/ครอบครัว ใน/รัชกาล/ของ/ดาวิด/มี/กำลัง/พล/จาก/วงศ์วาน/ของ/โทลา/ซึ่ง/บันทึก/ไว้/ใน/ลำดับ/วงศ์ตระกูล 22,600 คน<verse eid="1CH 7:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 7:3" />บุตร/ของ/อุสซี ได้แก่</para>
  <para style="li1" vid="1CH 7:3">อิสราหิยาห์</para>
  <para style="li1" vid="1CH 7:3">บุตร/ของ/อิสราหิยาห์ ได้แก่</para>
  <para style="li1" vid="1CH 7:3">มีคาเอล โอบาดีห์ โยเอล และ/อิสชีอาห์ ทั้ง/ห้า/คน/เป็น/หัวหน้า <verse eid="1CH 7:3" /><verse number="4" style="v" sid="1CH 7:4" />ตาม/บันทึก/ลำดับ/วงศ์ตระกูล/ของ/พวกเขา พวกเขา/มี/กำลังพล 36,000 คน เพราะ/พวกเขา/มี/ภรรยา/และ/บุตร/มากมาย<verse eid="1CH 7:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 7:5" />กำลังพล/จาก/ทุก/ตระกูล/ของ/เผ่า/อิสสาคาร์/มี 87,000 คน ตาม/บันทึก/ลำดับ/วงศ์ตระกูล<verse eid="1CH 7:5" /></para>
  <para style="s1">วงศ์วาน/ของ/เบนยามิน</para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 7:6" />บุตร/ทั้ง/สาม/ของ/เบนยามิน ได้แก่</para>
  <para style="li1" vid="1CH 7:6">เบลา เบเคอร์ และ/เยดียาเอล<verse eid="1CH 7:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 7:7" />บุตร/ของ/เบลา ได้แก่</para>
  <para style="li1" vid="1CH 7:7">เอสโบน อุสซี อุสซีเอล เยรีโมท และ/อิรี ล้วนแต่/เป็น/หัวหน้า/ครอบครัว รวม/ห้า/คน ตาม/บันทึก/ลำดับ/วงศ์ตระกูล/ของ/พวกเขา พวกเขา/มี/กำลังพล 22,034 คน<verse eid="1CH 7:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 7:8" />บุตร/ของ/เบเคอร์ ได้แก่</para>
  <para style="li1" vid="1CH 7:8">เศมิราห์ โยอาช เอลีเอเซอร์ เอลีโอนัย อมรี เยเรโมท อาบียาห์ อานาโธท และ/อาเลเมท ทั้งหมด/นี้/เป็น/บุตร/ของ/เบเคอร์ <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />บันทึก/ลำดับ/วงศ์ตระกูล/ของ/พวกเขา/มี/ชื่อ/หัวหน้า/ตระกูล/และ/กำลังพล 20,200 คน<verse eid="1CH 7:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 7:10" />บุตร/ของ/เยดียาเอล ได้แก่</para>
  <para style="li1" vid="1CH 7:10">บิลฮาน</para>
  <para style="li1" vid="1CH 7:10">บุตร/ของ/บิลฮาน ได้แก่</para>
  <para style="li1" vid="1CH 7:10">เยอูช เบนยามิน เอฮูด เคนาอะนาห์ เศธาน ทารชิช และ/อาหิชาฮาร์ <verse eid="1CH 7:10" /><verse number="11" style="v" sid="1CH 7:11" />บรรดา/บุตร/ของ/เยดียาเอล/ล้วนเป็น/หัวหน้า/ครอบครัว มี/กำลัง/พล 17,200 คน<verse eid="1CH 7:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 7:12" />วงศ์วาน/ของ/อิระ/คือ ชาว/ชุปปิม/และ/หุปปิม ส่วน/ชาว/หุชิม/เป็น/วงศ์วาน/ของ/อาเฮอร์<verse eid="1CH 7:12" /></para>
  <para style="s1">วงศ์วาน/ของ/นัฟทาลี</para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 7:13" />บุตร/ของ/นัฟทาลี/ผู้/สืบ/เชื้อสาย/จาก/นาง/บิลฮาห์ ได้แก่</para>
  <para style="li1" vid="1CH 7:13">ยาซีเอล กุนี เยเซอร์ และ/ชิลเลม<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">สำเนา/ต้นฉบับ/ภาษาฮีบรู/ส่วนใหญ่/ว่า/</char><char style="fqa" closed="false">ชัลลูม/</char><char style="ft" closed="false">(ดู/ปฐก.46:24 และ กดว.26:49)</char></note><verse eid="1CH 7:13" /></para>
  <para style="s1">วงศ์วาน/ของ/มนัสเสห์</para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 7:14" />วงศ์วาน/ของ/มนัสเสห์/ซึ่ง/เกิด/จาก/ภรรยา/น้อย/ชาวอารัม ได้แก่</para>
  <para style="li1" vid="1CH 7:14">อัสรีเอล/และ/มาคีร์/บิดา/แห่ง/กิเลอาด <verse eid="1CH 7:14" /><verse number="15" style="v" sid="1CH 7:15" />มาคีร์/ได้/ภรรยา/เป็น/ชาว/หุปปิม/และ/ชุปปิม น้องสาว/ของ/มาคีร์/คือ/มาอาคาห์</para>
  <para style="li1" vid="1CH 7:15">วงศ์วาน/อีก/คน/หนึ่ง/คือ/เศโลเฟหัด/ซึ่ง/มี/แต่/บุตร/สาว<verse eid="1CH 7:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 7:16" />มาอาคาห์/ภรรยา/ของ/มาคีร์/มี/บุตร/ซึ่ง/ให้/ชื่อ/ว่า เปเรช น้องชาย/ของเขา/คือ/เชเรช ซึ่ง/มี/บุตร/คือ/อุลาม/กับ/ราเคม<verse eid="1CH 7:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 7:17" />บุตร/ของ/อุลาม ได้แก่</para>
  <para style="li1" vid="1CH 7:17">เบดาน</para>
  <para style="li1" vid="1CH 7:17">คน/เหล่านี้/คือ/วงศ์วาน/ของ/กิเลอาด/ผู้/เป็น/บุตร/ของ/มาคีร์/บุตร/มนัสเสห์ <verse eid="1CH 7:17" /><verse number="18" style="v" sid="1CH 7:18" />ฮัมโมเลเคท น้องสาว/ของเขา/ให้กำเนิด/อิชโฮด อาบีเอเซอร์ และ/มาห์ลาห์<verse eid="1CH 7:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 7:19" />บุตร/ของ/เชมิดา ได้แก่</para>
  <para style="li1" vid="1CH 7:19">อาหิยัน เชเคม ลิคฮี และ/อานียัม<verse eid="1CH 7:19" /></para>
  <para style="s1">วงศ์วาน/ของ/เอฟราอิม</para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 7:20" />วงศ์วาน/ของ/เอฟราอิม ได้แก่</para>
  <para style="li1" vid="1CH 7:20">ชูเธลาห์/ซึ่ง/มี/บุตร/คือ/เบเรด</para>
  <para style="li1" vid="1CH 7:20">ซึ่ง/มี/บุตร/คือ/ทาหัท ซึ่ง/มี/บุตร/คือ/เอเลอาดาห์</para>
  <para style="li1" vid="1CH 7:20">ซึ่ง/มี/บุตร/คือ/ทาหัท <verse eid="1CH 7:20" /><verse number="21" style="v" sid="1CH 7:21" />ซึ่ง/มี/บุตร/คือ/ศาบาด ซึ่ง/มี/บุตร/คือ/ชูเธลาห์</para>
  <para style="li1" vid="1CH 7:21">เอเซอร์/และ/เอเลอัด/ถูก/ชาว/พื้นเมือง/ของ/กัท/ฆ่าตาย/เมื่อ/จะ/ไป/ยึด/ฝูงสัตว์/ของ/คน/เหล่านั้น <verse eid="1CH 7:21" /><verse number="22" style="v" sid="1CH 7:22" />เอฟราอิม/ผู้/เป็น/บิดา/เศร้าโศก/อยู่/หลาย/วัน และ/บรรดา/ญาติ/พา/กัน/มา/ปลอบโยน/เขา <verse eid="1CH 7:22" /><verse number="23" style="v" sid="1CH 7:23" />หลังจาก/นั้น/เอฟราอิม/ก็/ร่วม/หลับนอน/กับ/ภรรยา นาง/ตั้งครรภ์/และ/ให้/กำเนิด/บุตร/ชาย/ซึ่ง/เขา/ตั้งชื่อ/ให้/ว่า/เบรียาห์<note caller="+" style="f"><char style="fr" closed="false">7:23 </char><char style="ft" closed="false">คำ/ว่า/</char><char style="fqa" closed="false">เบรียาห์/</char><char style="ft" closed="false">มี/เสียง/คล้าย/คำ/ภาษาฮีบรู/ที่/มี/ความหมาย/ว่า เคราะห์ร้าย</char></note> เพราะ/เกิดเหตุ/โศกสลด/ใน/ครอบครัว <verse eid="1CH 7:23" /><verse number="24" style="v" sid="1CH 7:24" />บุตร/สาว/ของ/เอฟราอิม/คือ/เชเอราห์/ผู้/สร้าง/เมือง/เบธโฮโรน/บน/และ/เบธโฮโรน/ล่าง/กับ/เมือง/อุสเซนเชเอราห์<verse eid="1CH 7:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 7:25" />เบรียาห์/มี/บุตร/คือ/เรฟาห์</para>
  <para style="li1" vid="1CH 7:25">ซึ่ง/มี/บุตร/คือ/เรเชฟ<note caller="+" style="f"><char style="fr" closed="false">7:25 </char><char style="ft" closed="false">ภาษาฮีบรู/ไม่มี/วลี/ที่ว่า/</char><char style="fqa" closed="false">ซึ่ง/มี/บุตร/คือ</char></note> ซึ่ง/มี/บุตร/คือ/เทลาห์ ซึ่ง/มี/บุตร/คือ/ทาหาน<verse eid="1CH 7:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 7:26" />ซึ่ง/มี/บุตร/คือ/ลาดาน ซึ่ง/มี/บุตร/คือ/อัมมีฮูด</para>
  <para style="li1" vid="1CH 7:26">ซึ่ง/มี/บุตร/คือ/เอลีชามา <verse eid="1CH 7:26" /><verse number="27" style="v" sid="1CH 7:27" />ซึ่ง/มี/บุตร/คือ/นูน ซึ่ง/มี/บุตร/คือ/โยชูวา<verse eid="1CH 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 7:28" />ถิ่นฐาน/ของ/พวกเขา/ได้แก่ เมือง/เบธเอล/กับ/หมู่บ้าน/ล้อมรอบ/นาอารัน/ไป/ทาง/ตะวันออก เมือง/เกเซอร์/กับ/หมู่บ้าน/โดยรอบ/ไป/ทาง/ตะวันตก และ/จาก/เมือง/เชเคม/กับ/หมู่บ้าน/โดยรอบ/ไป/จนถึง/อัยยาห์/และ/หมู่บ้าน/โดยรอบ <verse eid="1CH 7:28" /><verse number="29" style="v" sid="1CH 7:29" />เลียบ/ชายแดน/ของ/มนัสเสห์/ได้แก่ เมือง/เบธชาน เมือง/ทาอานาค เมือง/เมกิดโด และ/เมือง/โดร์ พร้อมทั้ง/หมู่บ้าน วงศ์วาน/ของ/โยเซฟ/บุตร/อิสราเอล/อาศัย/อยู่/ใน/เมือง/เหล่านี้<verse eid="1CH 7:29" /></para>
  <para style="s1">วงศ์วาน/ของ/อาเชอร์</para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 7:30" />บุตร/ของ/อาเชอร์ ได้แก่</para>
  <para style="li1" vid="1CH 7:30">อิมนาห์ อิชวาห์ อิชวี และ/เบรียาห์ บุตร/สาว/คือ/เสราห์<verse eid="1CH 7:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 7:31" />บุตร/ของ/เบรียาห์ ได้แก่</para>
  <para style="li1" vid="1CH 7:31">เฮเบอร์/กับ/มัลคีเอล ซึ่งเป็น/บิดา/ของ/บิรซาวิท<verse eid="1CH 7:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 7:32" />เฮเบอร์/เป็น/บิดา/ของ/ยาเฟลท โชเมอร์ และ/โฮธาม/กับ/ชูอา/น้องสาว/ของ/พวกเขา<verse eid="1CH 7:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 7:33" />บุตร/ของ/ยาเฟลท ได้แก่</para>
  <para style="li1" vid="1CH 7:33">ปาสัค บิมฮาล และ/อัชวาท คน/เหล่านี้/คือ/บุตร/ของ/ยาเฟลท<verse eid="1CH 7:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 7:34" />บุตร/ของ/โชเมอร์ ได้แก่</para>
  <para style="li1" vid="1CH 7:34">อาหิ โรห์กาห์<note caller="+" style="f"><char style="fr" closed="false">7:34 </char><char style="ft" closed="false">หรือ/</char><char style="fqa" closed="false">บุตร/ของ/พี่น้อง/ของ/โชเมอร์/ได้แก่ โรห์กาห์</char></note> ฮุบบาห์ และ/อารัม<verse eid="1CH 7:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 7:35" />บุตร/ของ/เฮเลม/น้องชาย/ของเขา ได้แก่</para>
  <para style="li1" vid="1CH 7:35">โศฟาห์ อิมนา เชเลช และ/อามัล<verse eid="1CH 7:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 7:36" />บุตร/ของ/โศฟาห์ ได้แก่</para>
  <para style="li1" vid="1CH 7:36">สุอาห์ ฮารเนเฟอร์ ชูอัล เบรี อิมราห์ <verse eid="1CH 7:36" /><verse number="37" style="v" sid="1CH 7:37" />เบเซอร์ โฮด ชัมมา ชิลชาห์ อิธราน<note caller="+" style="f"><char style="fr" closed="false">7:37 </char><char style="ft" closed="false">อาจจะ/เป็น/อีก/รูป/หนึ่ง/ของ/</char><char style="fqa" closed="false">เยเธอร์</char></note> และ/เบเอรา<verse eid="1CH 7:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 7:38" />บุตร/ของ/เยเธอร์ ได้แก่</para>
  <para style="li1" vid="1CH 7:38">เยฟุนเนห์ ปิสปาห์ และ/อารา<verse eid="1CH 7:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 7:39" />บุตร/ของ/อุลลา ได้แก่</para>
  <para style="li1" vid="1CH 7:39">อาราห์ ฮันนีเอล และ/รีเซีย<verse eid="1CH 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CH 7:40" />คน/เหล่านี้/คือ/วงศ์วาน/ของ/อาเชอร์ เป็น/หัวหน้า/ครอบครัว เป็น/นักรบ/แกล้ว/กล้า/ผู้/ได้รับ/เลือกสรร/และ/เป็น/ผู้นำ/ที่/โดดเด่น พวกเขา/มี/กำลังพล 26,000 คน/ตาม/บันทึก/ลำดับ/วงศ์ตระกูล<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="s1">ลำดับ/วงศ์ตระกูล/ของ/ซาอูล/ชาว/เบนยามิน</para>
  <para style="r">(<ref loc="1CH 9:34-44">1พศด.9:34-44</ref>)</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 8:1" />บุตร/ของ/เบนยามิน ได้แก่ เบลา/บุตร/หัวปี</para>
  <para style="li1" vid="1CH 8:1">คน/ที่สอง/คือ/อัชเบล คน/ที่สาม/คือ/อาหะราห์<verse eid="1CH 8:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 8:2" />คน/ที่สี่/คือ/โนฮาห์ และ/คน/ที่ห้า/คือ/ราฟา<verse eid="1CH 8:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 8:3" />บุตร/ของ/เบลา ได้แก่</para>
  <para style="li1" vid="1CH 8:3">อัดดาร์ เกรา อาบีฮูด<note caller="+" style="f"><char style="fr" closed="false">8:3 </char><char style="ft" closed="false">หรือ/</char><char style="fqa" closed="false">เกรา/บิดา/ของ/เอฮูด</char></note> <verse eid="1CH 8:3" /><verse number="4" style="v" sid="1CH 8:4" />อาบีชูวา นาอามาน อาโหอาห์ <verse eid="1CH 8:4" /><verse number="5" style="v" sid="1CH 8:5" />เกรา เชฟูฟาน และ/หุราม<verse eid="1CH 8:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 8:6" />เชื้อสาย/ของ/เอฮูด/ซึ่งเป็น/หัวหน้า/ครอบครัว/ต่างๆ ที่อาศัย/อยู่/ที่/เมือง/เกบา และ/ถูก/บังคับ/ให้/ย้ายไป/อยู่/ที่/เมือง/มานาฮาท ได้แก่<verse eid="1CH 8:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 8:7" />นาอามาน อาหิยาห์ และ/เกรา/ผู้/ย้าย/พวกเขา/ออกไป/นอก/ประเทศ/และ/เป็น/บิดา/ของ/อุสซา/กับ/อาหิฮูด<verse eid="1CH 8:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 8:8" />หลังจาก/ชาหะราอิม/หย่า/กับ/นางหุชิม/และ/นาง/บาอารา เขา/มี/บุตร/หลาย/คน/ที่/เกิด/ใน/โมอับ <verse eid="1CH 8:8" /><verse number="9" style="v" sid="1CH 8:9" />บุตร/ของเขา/ที่/เกิด/จาก/นางโฮเดช ได้แก่ โยบับ ศิเบีย เมชา มัลคาม <verse eid="1CH 8:9" /><verse number="10" style="v" sid="1CH 8:10" />เยอูส สาเคีย และ/มิรมาห์ คน/เหล่านี้/คือ/บุตร/ชาย/ของเขา/ซึ่ง/ล้วนแต่/เป็น/หัวหน้า/ครอบครัว <verse eid="1CH 8:10" /><verse number="11" style="v" sid="1CH 8:11" />บุตร/ที่/เกิด/จาก/หุชิม/คือ อาบีทูบ/กับ/เอลปาอัล<verse eid="1CH 8:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 8:12" />บุตร/ของ/เอลปาอัล ได้แก่</para>
  <para style="li1" vid="1CH 8:12">เอเบอร์ มิชอัม เชเมด (ผู้/สร้าง/เมือง/โอโน/กับ/โลด ทั้ง/หมู่บ้าน/โดยรอบ) <verse eid="1CH 8:12" /><verse number="13" style="v" sid="1CH 8:13" />เบรียาห์/และ/เชมา ล้วนเป็น/หัวหน้า/ครอบครัว/ต่างๆ ซึ่ง/อาศัย/ใน/อัยยาโลน พวกเขา/ขับไล่/ชาว/เมือง/กัท/ออกไป<verse eid="1CH 8:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 8:14" />อาหิโย ชาชัก เยเรโมท <verse eid="1CH 8:14" /><verse number="15" style="v" sid="1CH 8:15" />เศบาดิยาห์ อาราด เอเดอร์ <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" />มีคาเอล อิชปาห์ และ/โยฮา คน/เหล่านี้/ล้วนเป็น/บุตร/ของ/เบรียาห์<verse eid="1CH 8:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 8:17" />เศบาดิยาห์ เมชุลลาม ฮิสคี เฮเบอร์ <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" />อิชเมรัย อิสลิยาห์ และ/โยบับ คน/เหล่านี้/เป็น/บุตร/ของ/เอลปาอัล<verse eid="1CH 8:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 8:19" />ยาคิม ศิครี ศับดี <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" />เอลีเยนัย ศิลเลธัย เอลีเอล <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" />อาดายาห์ เบไรอาห์ และ/ชิมราท คน/เหล่านี้/เป็น/บุตร/ของ/ชิเมอี<verse eid="1CH 8:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 8:22" />อิชปาน เอเบอร์ เอลีเอล <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" />อับโดน ศิครี ฮานาน <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" />ฮานันยาห์ เอลาม อันโธธียาห์ <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" />อิฟไดยาห์ และ/เปนูเอล คน/เหล่านี้/เป็น/บุตร/ของ/ชาชัก<verse eid="1CH 8:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 8:26" />ชัมเชรัย เชหะรียาห์ อาธาลิยาห์<verse eid="1CH 8:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 8:27" />ยาอาเรชีอาห์ เอลียาห์ และ/ศิครี คน/เหล่านี้/เป็น/บุตร/ของ/เยโรฮัม<verse eid="1CH 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 8:28" />ทั้งหมด/นี้/เป็น/หัวหน้า/ครอบครัว/และ/ผู้/นำ/ตาม/บันทึก/ลำดับ/วงศ์ตระกูล พวกเขา/อาศัย/ที่/เยรูซาเล็ม<verse eid="1CH 8:28" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="29" style="v" sid="1CH 8:29" />เยอีเอล<note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="ft" closed="false">ภาษาฮีบรู/ไม่มี/คำ/ว่า/</char><char style="fqa" closed="false">เยอีเอล/</char><char style="ft" closed="false">(ดู 9:35)</char></note> บิดา<note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="ft" closed="false">คำ/ว่า/</char><char style="fqa" closed="false">บิดา/</char><char style="ft" closed="false">อาจจะ/มี/ความหมาย/ว่า ผู้/นำทาง/พลเรือน หรือ ผู้/นำทาง/ทหาร</char></note>ของ/กิเบโอน/อาศัย/อยู่/ที่/กิเบโอน</para>
  <para style="li1" vid="1CH 8:29">ภรรยา/ของเขา/ชื่อ/มาอาคาห์ <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />บุตร/หัวปี/ของเขา/คือ/อับโดน บุตร/คน/ต่อมา/ได้แก่ ศูร์ คีช บาอัล เนอร์<note caller="+" style="f"><char style="fr" closed="false">8:30 </char><char style="ft" closed="false">ภาษาฮีบรู/ไม่มี/คำ/ว่า/</char><char style="fqa" closed="false">เนอร์/</char><char style="ft" closed="false">(ดู 9:36)</char></note> นาดับ <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" />เกโดร์ อาหิโย เศเคอร์ <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" />และ/มิกโลท/ผู้/เป็น/บิดา/ของ/ชิเมอาห์ พวกเขา/ก็/อาศัย/อยู่/ใกล้ๆ ญาติพี่น้อง/ที่/เยรูซาเล็ม/เช่นกัน<verse eid="1CH 8:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 8:33" />เนอร์/เป็น/บิดา/ของ/คีช ผู้/เป็น/บิดา/ของ/ซาอูล ซาอูล/เป็น/บิดา/ของ/โยนาธาน มัลคีชูวา อาบีนาดับ และ/เอชบาอัล<note caller="+" style="f"><char style="fr" closed="false">8:33 </char><char style="ft" closed="false">เป็นที่รู้จัก/ใน/อีก/ชื่อ/หนึ่ง/ว่า/</char><char style="fqa" closed="false">อิชโบเชท</char></note><verse eid="1CH 8:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 8:34" />บุตร/ของ/โยนาธาน ได้แก่</para>
  <para style="li1" vid="1CH 8:34">เมริบบาอัล<note caller="+" style="f"><char style="fr" closed="false">8:34 </char><char style="ft" closed="false">เป็นที่รู้จัก/ใน/อีก/ชื่อ/หนึ่ง/ว่า/</char><char style="fqa" closed="false">เมฟีโบเชท</char></note>บิดา/ของ/มีคาห์<verse eid="1CH 8:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 8:35" />บุตร/ของ/มีคาห์ ได้แก่</para>
  <para style="li1" vid="1CH 8:35">ปีโธน เมเลค ทาเรีย และ/อาหัส<verse eid="1CH 8:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 8:36" />อาหัส/เป็น/บิดา/ของ/เยโฮอัดดาห์ เยโฮอัดดาห์/เป็น/บิดา/ของ/อาเลเมท อัสมาเวท และ/ศิมรี ศิมรี/เป็น/บิดา/ของ/โมซา <verse eid="1CH 8:36" /><verse number="37" style="v" sid="1CH 8:37" />โมซา/เป็น/บิดา/ของ/บิเนอา ซึ่งเป็น/บิดา/ของ/ราฟาห์ ซึ่งเป็น/บิดา/ของ/เอเลอาสาห์ ซึ่งเป็น/บิดา/ของ/อาเซล<verse eid="1CH 8:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 8:38" />อาเซล/มี/บุตร/ชาย/หก/คน ตาม/รายชื่อ/ดังนี้/คือ อัสรีคัม โบเครู อิชมาเอล เชอาริยาห์ โอบาดีห์ และ/ฮานาน คน/เหล่านี้/เป็น/บุตร/ของ/อาเซล<verse eid="1CH 8:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 8:39" />บุตร/ของ/เอเชก/น้องชาย/อาเซล/ได้แก่ อุลาม/บุตร/หัวปี คน/ที่สอง/คือ/เยอูช และ/คน/ที่สาม/คือ/เอลีเฟเลท <verse eid="1CH 8:39" /><verse number="40" style="v" sid="1CH 8:40" />บรรดา/บุตร/ของ/อุลาม/เป็น/นักรบ/แกล้ว/กล้า/และ/เป็น/นักธนู คน/เหล่านี้/มี/บุตร/และ/หลาน/รวม 150 คน</para>
  <para style="li1" vid="1CH 8:40">คน/เหล่านี้/คือ/วงศ์วาน/ของ/เบนยามิน<verse eid="1CH 8:40" /></para>
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />ชน/อิสราเอล/ทุกคน/มี/ชื่อ/อยู่/ใน/บันทึก/ลำดับ/วงศ์ตระกูล/ซึ่ง/บันทึก/ไว้/ใน/จดหมาย/เหตุ/กษัตริย์/แห่ง/อิสราเอล ชน/ยูดาห์/ต้อง/ตก/ไป/เป็น/เชลย/ที่/บาบิโลน/เพราะ/ไม่/ซื่อสัตย์<verse eid="1CH 9:1" /></para>
  <para style="s1">ประชากร/ใน/เยรูซาเล็ม</para>
  <para style="r">(<ref loc="NEH 11:3-19">นหม.11:3-19</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 9:2" />พวก/แรก/ที่/กลับ/มา/อาศัย/อยู่/ใน/เมือง/ของ/ตน/อีก/ครั้ง/มี/ชน/อิสราเอล ปุโรหิต ชน/เลวี และ/ผู้/ช่วย/งาน/ใน/พระวิหาร<verse eid="1CH 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 9:3" />คน/จาก/เผ่ายูดาห์ เบนยามิน เอฟราอิม และ/มนัสเสห์/ที่/มา/อาศัย/ใน/เยรูซาเล็ม ได้แก่<verse eid="1CH 9:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 9:4" />อุธัย/ผู้/เป็น/บุตร/ของ/อัมมีฮูด ผู้/เป็น/บุตร/ของ/อมรี ผู้/เป็น/บุตร/ของ/อิมรี ผู้/เป็น/บุตร/ของ/บานี วงศ์วาน/ของ/เปเรศ/บุตร/ยูดาห์<verse eid="1CH 9:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 9:5" />จาก/เชื้อสาย/ชิโลห์ ได้แก่</para>
  <para style="li1" vid="1CH 9:5">อาสายาห์/ผู้/เป็น/บุตร/หัวปี และ/บุตร/ทั้งหลาย/ของเขา<verse eid="1CH 9:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 9:6" />จาก/เชื้อสาย/เศราห์ ได้แก่</para>
  <para style="li1" vid="1CH 9:6">เยอูเอล</para>
  <para style="li1" vid="1CH 9:6">และ/คน/จาก/ยูดาห์/รวม/จำนวน 690 คน<verse eid="1CH 9:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 9:7" />จาก/เผ่า/เบนยามิน ได้แก่</para>
  <para style="li1" vid="1CH 9:7">สัลลู/ผู้/เป็น/บุตร/ของ/เมชุลลาม ผู้/เป็น/บุตร/ของ/โฮดาวิยาห์ ผู้/เป็น/บุตร/ของ/หัสเสนูอาห์<verse eid="1CH 9:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 9:8" />อิบเนยาห์/ผู้/เป็น/บุตร/ของ/เยโรฮัม เอลาห์/ผู้/เป็น/บุตร/ของ/อุสซี ผู้/เป็น/บุตร/ของ/มิครี และ/เมชุลลาม/ผู้/เป็น/บุตร/ของ/เชฟาทิยาห์ ผู้/เป็น/บุตร/ของ/เรอูเอล ผู้/เป็น/บุตร/ของ/อิบนียาห์<verse eid="1CH 9:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 9:9" />รวม/คน/จาก/เผ่า/เบนยามิน/ตาม/บันทึก/ลำดับ/วงศ์ตระกูล/ได้ 956 คน ทั้งหมด/นี้/ล้วนเป็น/หัวหน้า/ครอบครัว<verse eid="1CH 9:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 9:10" />บรรดา/ปุโรหิต ได้แก่</para>
  <para style="li1" vid="1CH 9:10">เยดายาห์ เยโฮยาริบ ยาคีน<verse eid="1CH 9:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 9:11" />อาซาริยาห์/เจ้าหน้าที่/ดูแล/พระ/นิเวศ/ของ/พระเจ้า/ผู้/เป็น/บุตร/ของ/ฮิลคียาห์ ผู้/เป็น/บุตร/ของ/เมชุลลาม ผู้/เป็น/บุตร/ของ/ศาโดก ผู้/เป็น/บุตร/ของ/เมราโยท ผู้/เป็น/บุตร/ของ/อาหิทูบ<verse eid="1CH 9:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 9:12" />อาดายาห์/ผู้/เป็น/บุตร/ของ/เยโรฮัม ผู้/เป็น/บุตร/ของ/ปาชเฮอร์ ผู้/เป็น/บุตร/ของ/มัลคียาห์ และ/มาอาสัย/ผู้/เป็น/บุตร/ของ/อาดีเอล ผู้/เป็น/บุตร/ของ/ยาเซราห์ ผู้/เป็น/บุตร/ของ/เมชุลลาม ผู้/เป็น/บุตร/ของ/เมชิลเลมิท ผู้/เป็น/บุตร/ของ/อิมเมอร์<verse eid="1CH 9:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 9:13" />มี/ปุโรหิต/ซึ่ง/เป็น/หัวหน้า/ครอบครัว/รวม 1,760 คน เป็น/ผู้/ที่/มี/หน้าที่/รับผิดชอบ/ใน/พระ/นิเวศ/ของ/พระเจ้า<verse eid="1CH 9:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 9:14" />จาก/เผ่าเลวี ได้แก่</para>
  <para style="li1" vid="1CH 9:14">เชไมอาห์/ผู้/เป็น/บุตร/ของ/หัสชูบ ผู้/เป็น/บุตร/ของ/อัสรีคัม ผู้/เป็น/บุตร/ของ/ฮาชาบิยาห์/จาก/ตระกูล/เมรารี <verse eid="1CH 9:14" /><verse number="15" style="v" sid="1CH 9:15" />บัคบัคคาร์ เฮเรช กาลาล และ/มัททานิยาห์ ผู้/เป็น/บุตร/ของ/มีคา ผู้/เป็น/บุตร/ของ/ศิครี ผู้/เป็น/บุตร/ของ/อาสาฟ <verse eid="1CH 9:15" /><verse number="16" style="v" sid="1CH 9:16" />โอบาดีห์/ผู้/เป็น/บุตร/ของ/เชไมอาห์ ผู้/เป็น/บุตร/ของ/กาลาล ผู้/เป็น/บุตร/ของ/เยดูธูน และ/เบเรคิยาห์/ผู้/เป็น/บุตร/ของ/อาสา ผู้/เป็น/บุตร/ของ/เอลคานาห์ ผู้/อาศัย/อยู่/ใน/หมู่บ้าน/ต่างๆ ของ/ชาว/เนโทฟาห์<verse eid="1CH 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 9:17" />ยาม/เฝ้า/ประตู ได้แก่</para>
  <para style="li1" vid="1CH 9:17">ชัลลูม/ผู้/เป็น/หัวหน้า อักขูบ ทัลโมน และ/อาหิมาน/กับ/พี่น้อง/ของเขา <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" />ยาม/เฝ้า/ประตู/เหล่านี้/ล้วนเป็น/คน/จาก/ค่าย/ของ/เลวี พวกเขา/ยังคง/รับผิดชอบ/ประตู/หลวง/ด้าน/ตะวันออก/จนถึง/ทุกวันนี้ <verse eid="1CH 9:18" /><verse number="19" style="v" sid="1CH 9:19" />ชัลลูม/ผู้/เป็น/บุตร/โคเร ผู้/เป็น/บุตร/ของ/เอบียาสาฟ ผู้/เป็น/บุตร/ของ/โคราห์ ชัลลูม/และ/เพื่อน/ร่วม/งาน/ซึ่ง/อยู่/ใน/ตระกูล/เดียวกับ/เขา (ตระกูล/โคราห์)รับผิดชอบ/เฝ้าอยู่/ที่/ธรณีประตู/ของ/พลับพลา<note caller="+" style="f"><char style="fr" closed="false">9:19 </char><char style="ft" closed="false">คือ/</char><char style="fqa" closed="false">พระวิหาร/</char><char style="ft" closed="false">เช่น/เดียว/กับ/ข้อ 23</char></note> เหมือน/ที่/บรรพบุรุษ/ของ/ตน/รับผิดชอบ/ดูแล/ทางเข้า/ที่ประทับ/ของ/<char style="nd">องค์/พระผู้เป็นเจ้า</char> <verse eid="1CH 9:19" /><verse number="20" style="v" sid="1CH 9:20" />แต่เดิม/ฟีเนหัส/บุตร/เอเลอาซาร์/เป็น/ผู้/ดูแล/ยาม/เหล่านี้ และ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/สถิต/กับ/เขา <verse eid="1CH 9:20" /><verse number="21" style="v" sid="1CH 9:21" />เศคาริยาห์/บุตร/เมเชเลมิยาห์/เป็น/ยาม/ประตู ดูแล/ทางเข้า/เต็นท์/นัดพบ<verse eid="1CH 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 9:22" />ผู้/ที่/ได้/รับเลือก/เป็น/ยาม/เฝ้า/ที่/ธรณีประตู/รวม 212 คน มี/รายชื่อ/อยู่/ใน/บันทึก/ลำดับ/วงศ์ตระกูล/ของ/หมู่บ้าน/ของ/ตน ดาวิด/กับ/ผู้/ทำนาย/ซามูเอล/ได้/แต่งตั้ง/ให้/ประจำ/หน้าที่ <verse eid="1CH 9:22" /><verse number="23" style="v" sid="1CH 9:23" />พวกเขา/กับ/วงศ์วาน/มี/หน้าที่/ดูแล/ทางเข้า/พระ/นิเวศ/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ที่/เรียกว่า/พลับพลา <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />ยาม/เฝ้า/ประตู/ประจำการ/อยู่/ทั้ง/สี่/ด้าน/คือ/ด้าน/ตะวันออก ตะวันตก เหนือ และ/ใต้ <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" />พี่น้อง/ของเขา/จาก/หมู่บ้าน/ต่างๆ ผลัด/เวร/กัน/มา/ช่วย/งาน/คราว/ละ/เจ็ดวัน <verse eid="1CH 9:25" /><verse number="26" style="v" sid="1CH 9:26" />หัวหน้า/ยาม/เฝ้า/ประตู/ทั้ง/สี่/คน/ซึ่งเป็น/ชน/เลวี/ได้รับ/ความ/ไว้วางใจ/ให้/รับผิดชอบ/ห้อง/ต่างๆ และ/คลัง/ต่างๆ ใน/พระ/นิเวศ/ของ/พระเจ้า <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" />พวกเขา/ต้อง/เฝ้ายาม/ประจำ/ตำแหน่ง/รอบ/พระ/นิเวศ/ของ/พระเจ้า/ตลอดคืน และ/จะ/มา/ไข/กุญแจ/เปิด/ประตู/ทุก/เช้า<verse eid="1CH 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28" />บางคน/มี/หน้าที่/ดูแล/ภาชนะ/ต่างๆ ซึ่ง/ใช้/ใน/งาน/พระวิหาร จะ/ตรวจ/นับ/เมื่อ/รับ/เข้า/หรือ/นำออก <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" />บางคน/รับผิดชอบ/ส่วน/ต่างๆ ของ/อาคาร ภาชนะ/ทั้งปวง/ใน/สถาน/นมัสการ ตลอดจน/แป้ง เหล้าองุ่น น้ำมัน เครื่อง/หอม และ/เครื่องเทศ <verse eid="1CH 9:29" /><verse number="30" style="v" sid="1CH 9:30" />แต่/ปุโรหิต/บางคน/ดูแล/การผสม/เครื่องเทศ <verse eid="1CH 9:30" /><verse number="31" style="v" sid="1CH 9:31" />มัททีธิยาห์/คน/เลวี ผู้/เป็น/บุตร/หัวปี/ของ/ชัลลูม/ตระกูล/โคราห์ ได้รับ/มอบหมาย/หน้าที่/ทำ/ขนมปัง/ถวายบูชา <verse eid="1CH 9:31" /><verse number="32" style="v" sid="1CH 9:32" />พี่น้อง/ตระกูล/โคฮาท/บางคน/มี/หน้าที่/จัดเตรียม/ขนมปัง/วางไว้/บนโต๊ะ/ทุกวัน/สะบาโต<verse eid="1CH 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33" />บรรดา/นักดนตรี/ซึ่งเป็น/หัวหน้า/ครอบครัว/ต่างๆ ของ/เลวี พักอยู่/ใน/ห้อง/ที่/พระวิหาร และ/ได้รับ/การ/ยกเว้น/จาก/หน้าที่/อื่นๆ เพราะ/ต้อง/รับผิดชอบ/งาน/ทั้ง/กลางวัน/และ/กลางคืน<verse eid="1CH 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34" />คน/เหล่านี้/คือ/หัวหน้า/ครอบครัว/และ/ผู้/นำ/ต่างๆ ของ/ชน/เลวี มี/รายชื่อ/ตาม/บันทึก/ลำดับ/วงศ์ตระกูล พวกเขา/พักอาศัย/อยู่/ที่/เยรูซาเล็ม<verse eid="1CH 9:34" /></para>
  <para style="s1">ลำดับ/วงศ์ตระกูล/ของ/ซาอูล</para>
  <para style="r">(<ref loc="1CH 8:28-38">1พศด.8:28-38</ref>)</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 9:35" />เยอีเอล/บิดา<note caller="+" style="f"><char style="fr" closed="false">9:35 </char><char style="ft" closed="false">คำ/ว่า/</char><char style="fqa" closed="false">บิดา/</char><char style="ft" closed="false">อาจจะ/มี/ความหมาย/ว่า ผู้/นำทาง/พลเรือน หรือ ผู้/นำทาง/ทหาร</char></note>ของ/กิเบโอน/อาศัย/อยู่/ที่/กิเบโอน</para>
  <para style="li1" vid="1CH 9:35">ภรรยา/ของเขา/คือ/มาอาคาห์ <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />บุตร/หัวปี/ของเขา/ชื่อ/อับโดน บุตร/คน/ต่อๆ มา/ได้แก่ ศูร์ คีช บาอัล เนอร์ นาดับ <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" />เกโดร์ อาหิโย เศคาริยาห์ และ/มิกโลท <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" />มิกโลท/เป็น/บิดา/ของ/ชิเมอัม พวกเขา/อาศัย/อยู่/ใกล้ๆ ญาติพี่น้อง/ใน/เยรูซาเล็ม/เช่นกัน<verse eid="1CH 9:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 9:39" />เนอร์/เป็น/บิดา/ของ/คีช/ผู้/เป็น/บิดา/ของ/ซาอูล ผู้/เป็น/บิดา/ของ/โยนาธาน มัลคีชูวา อาบีนาดับ และ/เอชบาอัล<note caller="+" style="f"><char style="fr" closed="false">9:39 </char><char style="ft" closed="false">เป็น/ที่/รู้จัก/ใน/อีก/ชื่อ/หนึ่ง/ว่า/</char><char style="fqa" closed="false">อิชโบเชท</char></note><verse eid="1CH 9:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 9:40" />บุตร/ของ/โยนาธาน ได้แก่</para>
  <para style="li1" vid="1CH 9:40">เมริบบาอัล<note caller="+" style="f"><char style="fr" closed="false">9:40 </char><char style="ft" closed="false">เป็นที่รู้จัก/ใน/อีก/ชื่อ/หนึ่ง/ว่า/</char><char style="fqa" closed="false">เมฟีโบเชท</char></note>ผู้/เป็น/บิดา/ของ/มีคาห์<verse eid="1CH 9:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 9:41" />บุตร/ของ/มีคาห์ ได้แก่</para>
  <para style="li1" vid="1CH 9:41">ปีโธน เมเลค ทาเรีย และ/อาหัส<note caller="+" style="f"><char style="fr" closed="false">9:41 </char><char style="ft" closed="false">ภาษาฮีบรู/ไม่มี/วลี/ว่า/</char><char style="fqa" closed="false">และ/อาหัส/</char><char style="ft" closed="false">(<char style="xt">ดู <ref loc="1CH 8:35">8:35</ref></char>)</char></note><verse eid="1CH 9:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 9:42" />อาหัส/เป็น/บิดา/ของ/ยาดาห์ ยาดาห์<note caller="+" style="f"><char style="fr" closed="false">9:42 </char><char style="ft" closed="false">หรือ/</char><char style="fqa" closed="false">ของ/ยาราห์ ยาราห์/</char><char style="ft" closed="false">(<char style="xt">ดู <ref loc="1CH 8:36">8:36</ref></char>)</char></note>เป็น/บิดา/ของ/อาเลเมท อัสมาเวท และ/ศิมรี ศิมรี/เป็น/บิดา/ของ/โมซา <verse eid="1CH 9:42" /><verse number="43" style="v" sid="1CH 9:43" />โมซา/เป็น/บิดา/ของ/บิเนอา ผู้/เป็น/บิดา/ของ/เรไฟยาห์ ผู้/เป็น/บิดา/ของ/เอเลอาสาห์ ผู้/เป็น/บิดา/ของ/อาเซล<verse eid="1CH 9:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 9:44" />อาเซล/มี/บุตร/ชาย/หกคน ตาม/รายชื่อ/ดังนี้</para>
  <para style="li1" vid="1CH 9:44">อัสรีคัม โบเครู อิชมาเอล เชอาริยาห์ โอบาดีห์ และ/ฮานาน คน/เหล่านี้/เป็น/บุตร/ของ/อาเซล<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="s1">ซาอูล/ฆ่าตัวตาย</para>
  <para style="r">(<ref loc="1SA 31:1-13">1ซมอ.31:1-13</ref>; <ref loc="2SA 1:4-12">2ซมอ.1:4-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />ครั้งนั้น/อิสราเอล/สู้รบ/กับ/ฟีลิสเตีย อิสราเอล/แตก/หนี และ/ผู้/คน/มากมาย/ล้มตาย/บน/ภูเขา/กิลโบอา <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" />ทหาร/ฟีลิสเตีย/ประชิด/ตัว/ซาอูล/กับ/โอรส และ/ได้/สังหาร/โอรส/ทั้ง/สาม/คือ/โยนาธาน อาบีนาดับ และ/มัลคีชูวา <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" />การรบ/เป็น/ไป/อย่าง/ดุเดือด ทหาร/ฟีลิสเตีย/ยิงธนู/เข้าใส่/ซาอูล พระ/อาการ/สาหัส<verse eid="1CH 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 10:4" />ซาอูล/ตรัส/กับ/ผู้/เชิญ/อาวุธ/ว่า “จง/ชัก/ดาบ/ออก/มา/แทง/ทะลุ/ร่าง/ของเรา มิฉะนั้น/พวก/ที่/ไม่ได้/เข้าสุหนัต/เหล่านี้/จะ/มา/ฆ่า/เรา/และ/นำ/ความ/อัปยศ/มา/ให้/เรา”</para>
  <para style="p" vid="1CH 10:4">แต่/ผู้/เชิญ/อาวุธ/ไม่กล้า/ทำ ฉะนั้น/ซาอูล/จึง/โถม/พระกาย/ลง/บน/ดาบ/ของ/พระองค์/เอง <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />เมื่อ/ผู้/เชิญ/อาวุธ/เห็นว่า/ซาอูล/สิ้นพระชนม์/แล้ว ก็/ทุ่ม/กาย/ลง/บน/ดาบ/ของ/ตน/ตาย/ตามไป <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />เป็นอันว่า/ซาอูล/กับ/โอรส/ทั้ง/สาม/และ/ทั้ง/ราชวงศ์/สิ้นชีวิต/ไป/ด้วยกัน<verse eid="1CH 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7" />เมื่อ/ชน/อิสราเอล/ใน/หุบเขา/เห็น/กองทัพ/แตก/หนี และ/เห็นว่า/ซาอูล/กับ/โอรส/สิ้นพระชนม์ ก็/พา/กัน/ละทิ้ง/บ้านเมือง/หนีไป ชาว/ฟีลิสเตีย/ก็/เข้า/ยึดครอง<verse eid="1CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8" />วันรุ่งขึ้น/เมื่อ/ชาว/ฟีลิสเตีย/ออกมา/ปลด/ของ/มีค่า/จาก/ศพ ก็/พบ/ร่าง/ของ/ซาอูล/และ/โอรส/อยู่/บน/ภูเขา/กิลโบอา <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />พวกเขา/จึง/ปลด/ยุทธภัณฑ์/ของ/ซาอูล/และ/ตัด/พระ/เศียร/ไป แล้ว/ส่ง/ผู้/สื่อสาร/ไป/ทั่ว/แดน/ฟีลิสเตีย ประกาศ/ข่าว/ท่ามกลาง/เทวรูป/และ/ประชาชน <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />พวกเขา/เก็บ/ยุทธภัณฑ์/ของ/ซาอูล/ไว้/ใน/วิหาร/ของ/เทพเจ้า/ของ/ตน และ/แขวน/พระ/เศียร/ของ/ซาอูล/ไว้/ใน/วิหาร/ของ/พระดาโกน<verse eid="1CH 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11" />เมื่อ/ชาว/ยาเบชกิเลอาด/ได้ยิน/ถึง/การ/กระทำ/ของ/ชาว/ฟีลิสเตีย/ต่อ/ซาอูล <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />ผู้/กล้าหาญ/ทั้งหมด/ของ/พวกเขา/ก็/ออกไป/นำ/พระ/ศพ/ของ/ซาอูล/กับ/โอรส/ทั้ง/สาม/กลับมา/ที่/ยาเบช แล้ว/ฝัง/พระ/อัฐิ/ไว้/ใต้/ต้นไม้/ใหญ่/ใน/เมือง/ยาเบช แล้ว/พา/กัน/ถือ/อดอาหาร/เป็น/เวลา/เจ็ดวัน<verse eid="1CH 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13" />ซาอูล/สิ้นพระชนม์/เพราะ/ไม่/ซื่อสัตย์/ต่อ/<char style="nd">องค์/พระผู้เป็นเจ้า</char> ไม่ได้/ปฏิบัติ/ตาม/พระดำรัส/ของ/<char style="nd">องค์/พระผู้เป็นเจ้า</char> ถึงกับ/ขอ/คำปรึกษา/จาก/คน/ทรง <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" />ซาอูล/ไม่ได้/ทูลถาม/<char style="nd">องค์/พระผู้เป็นเจ้า</char> พระองค์/จึง/ทรง/ประหาร/ซาอูล และ/ยก/อาณาจักร/ให้แก่/ดาวิด/บุตร/ของ/เจสซี<verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s1">ดาวิด/ขึ้น/เป็น/กษัตริย์</para>
  <para style="r">(<ref loc="2SA 5:1-3">2ซมอ.5:1-3</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />ชาว/อิสราเอล/ทั้งปวง/มา/เข้าเฝ้า/ดาวิด/ที่/เมือง/เฮโบรน และ/ทูล/ว่า “ข้าพระบาท/ทั้งหลาย/เป็น/พี่น้อง/ร่วม/สายโลหิต/ของ/ฝ่าพระบาท <verse eid="1CH 11:1" /><verse number="2" style="v" sid="1CH 11:2" />ตั้งแต่/ใน/รัชกาล/ของ/กษัตริย์/ซาอูล ฝ่าพระบาท/ก็/ทรงเป็น/ผู้/นำ/อิสราเอล/ใน/การรบ พระยาห์เวห์/พระเจ้า/ของ/ฝ่าพระบาท/ได้/ตรัส/กับ/ฝ่าพระบาท/ไว้/ว่า ‘เจ้า/จะ/เป็น/ผู้/เลี้ยงดู/และ/เป็น/ผู้/ปกครอง/ของ/อิสราเอล/ประชากร/ของเรา’ ”<verse eid="1CH 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3" />เมื่อ/ผู้/อาวุโส/ทั้งปวง/ของ/อิสราเอล/มา/เข้าเฝ้า/กษัตริย์/ดาวิด/ที่/เมือง/เฮโบรน พระองค์/ทรงทำ/สัญญา/กับ/พวกเขา/ที่นั่น/ต่อหน้า/<char style="nd">องค์/พระผู้เป็นเจ้า</char> และ/พวกเขา/เจิม/ตั้ง/ดาวิด/เป็น/กษัตริย์/ปกครอง/อิสราเอล เป็น/จริง/ตามที่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรงสัญญา/ไว้/แล้ว/ผ่านทาง/ซามูเอล<verse eid="1CH 11:3" /></para>
  <para style="s1">ดาวิด/พิชิต/เยรูซาเล็ม</para>
  <para style="r">(<ref loc="2SA 5:6-10">2ซมอ.5:6-10</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4" />ดาวิด/และ/ชน/อิสราเอล/ทั้งปวง/เดินทัพ/มายัง/เยรูซาเล็ม (คือ/เมือง/เยบุส) ชาว/เยบุส/ซึ่ง/อาศัย/อยู่/ที่/นั่น <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" />กล่าว/กับ/ดาวิด/ว่า “เจ้า/เข้ามา/ใน/นี้/ไม่ได้/หรอก” แต่/ดาวิด/ยึด/ป้อม/ของ/เมือง/ศิโยน ซึ่ง/เรียกว่า “เมือง/ดาวิด” ได้<verse eid="1CH 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 11:6" />ดาวิด/บอกไว้/ว่า “ผู้/ใด/ที่/นำ/ทัพ/บุกโจมตี/เมือง/เยบุส/จะ/ได้/เป็น/แม่ทัพ” โยอาบ/บุตร/นาง/เศรุยาห์/บุก/ไป/เป็น/คน/แรก จึง/ได้/เป็น/แม่ทัพ/ของ/ดาวิด<verse eid="1CH 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 11:7" />ดาวิด/จึง/ประทับ/อยู่/ใน/ป้อม/ปราการ/นั้น ที่นั่น/จึง/ได้/ชื่อ/ว่า “เมือง/ดาวิด” <verse eid="1CH 11:7" /><verse number="8" style="v" sid="1CH 11:8" />ดาวิด/ทรง/ขยาย/เมือง/นั้น/ออกไป/รอบๆ ป้อม/ปราการ<note caller="+" style="f"><char style="fr" closed="false">11:8 </char><char style="ft" closed="false">หรือ/</char><char style="fqa" closed="false">มิลโล</char></note>ไป/จนถึง/กำแพง/ที่/ล้อมรอบ/เมือง ใน/ขณะที่/โยอาบ/ซ่อมแซม/ส่วนอื่นๆ ที่/เหลือ/ของ/เมือง <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" />และ/ดาวิด/ทรง/ยิ่งใหญ่/ขึ้นเรื่อยๆ เพราะ/พระยาห์เวห์/ผู้/ทรงฤทธิ์/สถิตอยู่/ด้วย<verse eid="1CH 11:9" /></para>
  <para style="s1">ยอดนักรบ/ของ/ดาวิด</para>
  <para style="r">(<ref loc="2SA 23:8-39">2ซมอ.23:8-39</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />ต่อไปนี้/คือ/หัวหน้า/นักรบ/ของ/ดาวิด ซึ่ง/ร่วมกับ/ชน/อิสราเอล/ทั้งปวง/เสริม/แสนยานุภาพ/ของ/ดาวิด/ทั่วราช/อาณาจักร ตามที่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรงสัญญา/ไว้/แล้ว <verse eid="1CH 11:10" /><verse number="11" style="v" sid="1CH 11:11" />รายชื่อ/หัวหน้า/นักรบ/ของ/ดาวิด/คือ</para>
  <para style="p" vid="1CH 11:11">ยาโชเบอัม<note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="ft" closed="false">อาจจะ/เป็น/อีก/รูป/หนึ่ง/ของ/</char><char style="fqa" closed="false">ยาโชบบาอัล</char></note>แห่ง/ตระกูล/ฮัคโมนี เป็น/หัวหน้า/กอง/ทหาร<note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="ft" closed="false">หรือ/</char><char style="fqa" closed="false">หัวหน้า/สามสิบ/ยอดนักรบ/</char><char style="ft" closed="false">หรือ/</char><char style="fqa" closed="false">หัวหน้า/สาม/ยอดนักรบ/</char><char style="ft" closed="false">(ดู/<char style="xt"><ref loc="2SA 23:8">2ซมอ.23:8</ref></char>)</char></note>ของ/ดาวิด เขา/ใช้/หอก/สังหาร/ข้าศึก/ถึง/สามร้อย/คน/ใน/คราว/เดียว/กัน<verse eid="1CH 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12" />คน/ต่อมา/คือ/เอเลอาซาร์ บุตร/โดดัย/ชาว/อาโหอาห์ <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />เขา/อยู่/เคียงข้าง/ดาวิด/ใน/สงคราม/กับ/ฟีลิสเตีย/ที่/เมือง/ปัสดัมมิม กองทัพ/อิสราเอล/ที่/อยู่/ใน/ทุ่ง/ข้าวบาร์เลย์/กำลัง/เริ่ม/ถอยหนี <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />แต่/ดาวิด/กับ/เขา/ปักหลัก/อยู่/กลาง/ทุ่ง รับมือ/และ/พิชิต/ชาว/ฟีลิสเตีย และ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ประทาน/ชัยชนะ/อัน/ยิ่งใหญ่<verse eid="1CH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15" />ครั้งหนึ่ง/สาม/ยอดนักรบ/ของ/สามสิบ/ยอดนักรบ/มาหา/ดาวิด/ที่/ศิลา/ที่/ถ้ำ/อดุลลัม ขณะ/กอง/ทหาร/ของ/ฟีลิสเตีย/ตั้ง/ค่าย/อยู่/ใน/หุบเขา/เรฟาอิม <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />ครั้งนั้น/ดาวิด/อยู่ใน/ที่มั่น ส่วน/แนวรบ/ของ/ฟีลิสเตีย/อยู่/ที่/เมือง/เบธเลเฮม <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" />ดาวิด/กระหาย/น้ำ/และ/เปรย/ขึ้น/ว่า “ถ้า/มี/ใคร/ไป/นำ/น้ำ/จาก/บ่อ/ใกล้/ประตู/เมือง/เบธเลเฮม/มา/ให้/เรา/ดื่ม/ก็/ดี!” <verse eid="1CH 11:17" /><verse number="18" style="v" sid="1CH 11:18" />สาม/ยอดนักรบ/นี้/ก็/ตีฝ่า/แนวรบ/ของ/ฟีลิสเตีย/ไป/ตัก/น้ำ/จาก/บ่อ/นั้น/มา/ให้ แต่/ดาวิด/ไม่ยอม/ดื่ม กลับ/ริน/ลง/ต่อหน้า/<char style="nd">องค์/พระผู้เป็นเจ้า</char> <verse eid="1CH 11:18" /><verse number="19" style="v" sid="1CH 11:19" />และ/กล่าว/ว่า “ขอ/พระเจ้า/ห้ามไว้/ไม่ให้/เรา/ดื่ม/น้ำ/นี้! ควร/หรือ/ที่/เรา/จะ/ดื่ม/เลือด/ของ/คน/เหล่านี้/ซึ่ง/เสี่ยงชีวิต/ไป/เอามา?” เนื่องจาก/พวกเขา/เสี่ยงชีวิต/ไป/เอา/น้ำ/มา ดาวิด/จึง/ไม่ยอม/ดื่ม</para>
  <para style="p" vid="1CH 11:19">นี่คือ/วีรกรรม/ของ/สาม/ยอด/นักรบ<verse eid="1CH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20" />อาบีชัย/น้องชาย/ของ/โยอาบ/เป็น/หัวหน้า/ของ/สาม/ยอดนักรบ เขา/ใช้/หอก/สังหาร/ข้าศึก/ถึง/สามร้อย/คน เขา/จึง/มี/ชื่อเสียง/เลื่องลือ/เทียบเท่า/สาม/ยอดนักรบ <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />เขา/เป็น/หัวหน้า/และ/มี/เกียรติ/เป็น/สองเท่า/เหนือ/สาม/ยอดนักรบ แม้จะ/ไม่ได้/เป็น/หนึ่ง/ใน/จำนวน/นั้น<verse eid="1CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22" />เบไนยาห์/บุตร/เยโฮยาดา/เป็น/ทหาร/กล้า/จาก/เมือง/ขับเซเอล/ผู้/สร้าง/วีรกรรม/หลาย/ครั้ง เขา/สังหาร/ยอด/ฝีมือ/สอง/คน/ของ/โมอับ ครั้งหนึ่ง/เขา/ลง/ไป/ใน/หลุม/ฆ่า/สิงโต/ใน/วันที่/หิมะ/ตก/หนัก <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" />และ/เขา/ได้/สังหาร/คน/อียิปต์/คน/หนึ่ง/ซึ่ง/สูง/ถึง 5 ศอก<note caller="+" style="f"><char style="fr" closed="false">11:23 </char><char style="ft" closed="false">คือ ประมาณ 2.3 เมตร</char></note> แม้ว่า/คน/นั้น/ถือ/หอก/ใหญ่/เท่ากับ/ไม้/กระพั่น/ทอผ้า แต่/เบไนยาห์/ถือ/ไม้พลอง/เข้า/สู้ เขา/กระชาก/หอก/จาก/มือ/ของ/ชาวอียิปต์/คน/นั้น/และ/สังหาร/ด้วย/หอก <verse eid="1CH 11:23" /><verse number="24" style="v" sid="1CH 11:24" />นี่คือ/วีรกรรม/ของ/เบไนยาห์/บุตร/เยโฮยาดา เขา/ก็/มี/ชื่อเสียง/เลื่องลือ/เทียบเท่า/สาม/ยอด/นักรบ/ด้วย <verse eid="1CH 11:24" /><verse number="25" style="v" sid="1CH 11:25" />เขา/มี/เกียรติ/มากกว่า/ใครๆ ใน/สามสิบ/ยอด/นักรบ แต่/ไม่ได้/รวม/อยู่ใน/สาม/ยอด/นักรบ ดาวิด/ทรง/แต่งตั้ง/ให้/เขา/ดูแล/กอง/ทหาร/รักษา/พระองค์<verse eid="1CH 11:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 11:26" />เหล่า/นักรบ ได้แก่</para>
  <para style="li1" vid="1CH 11:26">อาสาเฮล/น้องชาย/ของ/โยอาบ</para>
  <para style="li1" vid="1CH 11:26">เอลฮานัน/บุตร/โดโด คน/เบธเลเฮม<verse eid="1CH 11:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 11:27" />ชัมโมท/คน/ฮาโรด</para>
  <para style="li1" vid="1CH 11:27">เฮเลส/คน/เปโลน<verse eid="1CH 11:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 11:28" />อิรา/บุตร/อิกเขช/คน/เทโคอา</para>
  <para style="li1" vid="1CH 11:28">อาบีเอเซอร์/คน/อานาโธท<verse eid="1CH 11:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 11:29" />สิบเบคัย/คน/หุชาห์</para>
  <para style="li1" vid="1CH 11:29">อิลัย/คน/อาโหอาห์<verse eid="1CH 11:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 11:30" />มาหะรัย/คน/เนโทฟาห์</para>
  <para style="li1" vid="1CH 11:30">เฮเลด/บุตร/บาอานาห์/คน/เนโทฟาห์<verse eid="1CH 11:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 11:31" />อิธัย/บุตร/รีบัย/คน/กิเบอาห์/ใน/เขต/เบนยามิน</para>
  <para style="li1" vid="1CH 11:31">เบไนยาห์/คน/ปิราโธน<verse eid="1CH 11:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 11:32" />หุรัย/คน/ห้วย/กาอัช</para>
  <para style="li1" vid="1CH 11:32">อาบีเอล/คน/อารบา<verse eid="1CH 11:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 11:33" />อัสมาเวท/คน/บาฮา/รู</para>
  <para style="li1" vid="1CH 11:33">เอลียาห์บา/คน/ชาอัลโบน<verse eid="1CH 11:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 11:34" />เหล่า/บุตร/ของ/ฮาเชม/คน/กิโซ</para>
  <para style="li1" vid="1CH 11:34">โยนาธาน/บุตร/ชากี/คน/ฮาราร์<verse eid="1CH 11:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 11:35" />อาหิอัม/บุตร/สาคาร์/คน/ฮาราร์</para>
  <para style="li1" vid="1CH 11:35">เอลีฟัล/บุตร/เออร์<verse eid="1CH 11:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 11:36" />เฮเฟอร์/คน/เมเคราห์</para>
  <para style="li1" vid="1CH 11:36">อาหิยาห์/คน/เปโลน<verse eid="1CH 11:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 11:37" />เฮสโร/คน/คารเมล</para>
  <para style="li1" vid="1CH 11:37">นาอารัย/บุตร/เอสบัย<verse eid="1CH 11:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 11:38" />โยเอล/น้องชาย/ของ/นาธัน</para>
  <para style="li1" vid="1CH 11:38">มิบฮาร์/บุตร/ฮากรี<verse eid="1CH 11:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 11:39" />เศเลก/คน/อัมโมน</para>
  <para style="li1" vid="1CH 11:39">นาหะรัย/คน/เบโรท ผู้/เชิญ/อาวุธ/ประจำตัว/ของ/โยอาบ/บุตร/นาง/เศรุยาห์<verse eid="1CH 11:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 11:40" />อิรา/คน/อิธรา</para>
  <para style="li1" vid="1CH 11:40">กาเรบ/คน/อิธรา<verse eid="1CH 11:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 11:41" />อุรียาห์/คน/ฮิตไทต์</para>
  <para style="li1" vid="1CH 11:41">ศาบาด/บุตร/อาห์ลัย<verse eid="1CH 11:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 11:42" />อาดีนา/บุตร/ชิซา/คน/รูเบน เป็น/หัวหน้า/ของ/คน/รูเบน/และ/คน/สามสิบ/คน/ที่/อยู่/กับ/เขา<verse eid="1CH 11:42" /></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 11:43" />ฮานาน/บุตร/มาอาคาห์ โยชาฟัท/คน/มิธเน<verse eid="1CH 11:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 11:44" />อุสซียา/คน/อัชเทรัท</para>
  <para style="li1" vid="1CH 11:44">ชามา/และ/เยอีเอล/บุตร/โฮธาม/คน/อาโรเออร์<verse eid="1CH 11:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 11:45" />เยดียาเอล/บุตร/ชิมรี/และ/โยฮา/คน/ทิไซต์/ผู้/เป็น/น้องชาย<verse eid="1CH 11:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 11:46" />เอลีเอล/คน/มาหะไวต์</para>
  <para style="li1" vid="1CH 11:46">เยรีบัย/และ/โยชาวิยาห์/บุตร/เอลนาอัม</para>
  <para style="li1" vid="1CH 11:46">อิทมาห์/คน/โมอับ<verse eid="1CH 11:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 11:47" />เอลีเอล โอเบด และ/ยาอาซีเอล/คน/เมโซบัย<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s1">เหล่า/นักรบ/มา/สมทบ/กับ/ดาวิด</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 12:1" />ต่อไปนี้/คือ/ผู้/ที่/มา/สมทบ/กับ/ดาวิด/ที่/ศิกลาก ขณะที่/เขา/ถูกไล่/ไป/ให้/พ้น/จาก/พระพักตร์/ซาอูล/บุตร/คีช (พวกเขา/อยู่/ใน/หมู่/นักรบ/ซึ่ง/ช่วย/ดาวิด/สู้รบ <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" />ล้วนเป็น/นักธนู/และ/เป็น/มือ/สลิง/ผู้/เชี่ยวชาญ/ทั้ง/มือซ้าย/และ/มือขวา ต่างก็/มา/จาก/เผ่า/เบนยามิน/เช่น/เดียว/กับ/ซาอูล) ได้แก่<verse eid="1CH 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 12:3" />หัวหน้า/อาหิเยเซอร์/และ/โยอาช ทั้งคู่/เป็น/บุตร/ของ/เชมาอาห์/แห่ง/เมือง/กิเบอา เยซีเอล และ/เปเลท/บุตร/ของ/อัสมาเวท เบราคาห์ เยฮู/จาก/เมือง/อานาโธท <verse eid="1CH 12:3" /><verse number="4" style="v" sid="1CH 12:4" />อิชมัยยาห์/จาก/เมือง/กิเบโอน/ผู้/เป็น/ทหารกล้า/ซึ่ง/อยู่/ใน/ระดับ/ผู้/นำ/ของ/สามสิบ/ยอดนักรบ เยเรมีย์ ยาฮาซีเอล โยฮานัน โยซาบาด/จาก/เมือง/เกเดราห์ <verse eid="1CH 12:4" /><verse number="5" style="v" sid="1CH 12:5" />เอลูซัย เยรีโมท เบอัลลิยาห์ เชมาริยาห์ และ/เชฟาทิยาห์ จาก/ตระกูล/ฮารูฟ <verse eid="1CH 12:5" /><verse number="6" style="v" sid="1CH 12:6" />เอลคานาห์ อิสชีอาห์ อาซาเรล โยเอเซอร์/กับ/ยาโชเบอัม/จาก/ตระกูล/โคราห์ <verse eid="1CH 12:6" /><verse number="7" style="v" sid="1CH 12:7" />และ/โยเอลาห์/กับ/เศบาดิยาห์/บุตร/เยโรฮัม/ชาว/เกโดร์<verse eid="1CH 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8" />นักรบ/บางคน/จาก/เผ่ากาด/ก็/แปร/พรรค/มา/อยู่/กับ/ดาวิด/ใน/ที่มั่น/ใน/ถิ่น/กันดาร พวกเขา/เป็น/นักรบ/กล้าหาญ/ผู้/เจน/ศึก/และ/ช่ำชอง/ใน/การ/ใช้/โล่/กับ/หอก เป็น/คน/หน้าตา/ดุร้าย/เหมือน/สิงห์ ไว/เหมือน/ละมั่ง/บน/ภูเขา<verse eid="1CH 12:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 12:9" />เอเซอร์/เป็น/หัวหน้า</para>
  <para style="li1" vid="1CH 12:9">โอบาดีห์/เป็น/รอง/หัวหน้า คน/ที่สาม/คือ/เอลีอับ<verse eid="1CH 12:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 12:10" />คน/ที่สี่/คือ/มิชมันนาห์ คน/ที่ห้า/คือ/เยเรมีย์<verse eid="1CH 12:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 12:11" />คน/ที่หก/คือ/อัททัย คน/ที่เจ็ด/คือ/เอลีเอล<verse eid="1CH 12:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 12:12" />คน/ที่แปด/คือ/โยฮานัน คน/ที่เก้า/คือ/เอลซาบาด<verse eid="1CH 12:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 12:13" />คน/ที่สิบ/คือ/เยเรมีย์ คน/ที่สิบเอ็ด/คือ/มัคบันนัย<verse eid="1CH 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14" />คน/กาด/เหล่านี้/เป็น/นายทัพ/ที่/ด้อย/ที่สุด/ก็/ยัง/เหมาะ/กับ/พล/นับ/ร้อย และ/ที่/ยิ่งใหญ่/ที่สุด/ก็/เหมาะ/กับ/พล/นับพัน <verse eid="1CH 12:14" /><verse number="15" style="v" sid="1CH 12:15" />พวกเขา/ข้าม/แม่น้ำ/จอร์แดน/ไป/ใน/เดือน/ที่หนึ่ง/ซึ่งเป็น/ฤดู/น้ำหลาก และ/สู้รบ/กับ/ทุกคน/ใน/หุบเขา/ทั้ง/ด้าน/ตะวันออก/และ/ตะวันตก<verse eid="1CH 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16" />มี/คนอื่นๆ จาก/เผ่า/เบนยามิน/และ/ยูดาห์/มาหา/ดาวิด/ใน/ที่มั่น <verse eid="1CH 12:16" /><verse number="17" style="v" sid="1CH 12:17" />ดาวิด/ออกไป/พบ/พวกเขา/และ/กล่าว/ว่า “หาก/พวก/ท่าน/มาหา/เรา/อย่างสันติ มา/ช่วย/เรา เรา/ก็/พร้อมที่จะ/ให้/ท่าน/เข้าพวก แต่/หาก/ท่าน/มา/เพื่อ/ทรยศ/มอบ/เรา/ให้/แก่/ศัตรู/ของเรา ทั้งๆ ที่/มือ/ของเรา/ไม่ได้/ทำ/ร้าย/ใคร ก็/ขอให้/พระเจ้า/ของ/บรรพบุรุษ/ของเรา/ทอดพระเนตร/และ/ตัดสินโทษ/ท่าน/เถิด”<verse eid="1CH 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18" />แล้ว/พระวิญญาณ/เสด็จ/ลงมา/เหนือ/อามาสัย/ผู้/นำ/ของ/สามสิบ/ยอด/นักรบ และ/เขา/กล่าว/ว่า</para>
  <para style="q1" vid="1CH 12:18">“ดาวิด/เอ๋ย! เรา/เป็น/พวก/ท่าน</para>
  <para style="q1" vid="1CH 12:18">บุตร/เจสซี/เอ๋ย! เรา/เป็น/ฝ่าย/ท่าน</para>
  <para style="q1" vid="1CH 12:18">ความ/สำเร็จ/จง/เป็น/ของ/ท่าน</para>
  <para style="q1" vid="1CH 12:18">ความ/สำเร็จ/จง/เป็น/ของ/ทุกคน/ที่/ช่วยเหลือ/ท่าน</para>
  <para style="q1" vid="1CH 12:18">เพราะ/พระเจ้า/ของ/ท่าน/จะ/ทรง/ช่วย/ท่าน”</para>
  <para style="p" vid="1CH 12:18">ดาวิด/จึง/รับ/พวกเขา/ไว้/และ/ตั้งให้/เป็น/หัวหน้า/กองโจร<verse eid="1CH 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19" />มี/บางคน/จาก/เผ่า/มนัสเสห์/แปร/พรรค/มา/อยู่/กับ/ดาวิด/เมื่อ/เขา/ร่วมทัพ/ฟีลิสเตีย/จะ/ไป/รบ/กับ/ซาอูล (ดาวิด/กับ/พวก/ไม่ได้/ช่วย/ชาว/ฟีลิสเตีย/รบ เพราะ/เมื่อ/ขุนพล/ของ/ฟีลิสเตีย/ปรึกษา/กัน/แล้ว พวกเขา/กล่าว/ว่า “ถ้า/เขา/ละทิ้ง/พวกเรา กลับไป/เป็น/พวก/ของ/ซาอูล/นาย/เดิม หัว/ของ/พวกเรา/คง/หลุด/จาก/บ่า”) <verse eid="1CH 12:19" /><verse number="20" style="v" sid="1CH 12:20" />คน/มนัสเสห์/ที่/มา/เป็น/พวก/กับ/ดาวิด/ขณะที่/เขา/ไป/ศิกลาก/ได้แก่ อัดนาห์ โยซาบาด เยดียาเอล มีคาเอล โยซาบาด เอลีฮู และ/ศิลเลธัย ล้วนเป็น/หัวหน้า/กองพัน/ใน/มนัสเสห์ <verse eid="1CH 12:20" /><verse number="21" style="v" sid="1CH 12:21" />พวกเขา/เป็น/นักรบ/กล้าหาญ เป็น/นายทัพ/ช่วยเหลือ/ดาวิด/ต่อสู้/กับ/กองโจร <verse eid="1CH 12:21" /><verse number="22" style="v" sid="1CH 12:22" />มี/คน/มา/สมทบ/กับ/ดาวิด/มากขึ้น/เรื่อยๆ จนกระทั่ง/ดาวิด/มี/กองทัพ/ยิ่งใหญ่/เกรียงไกร/เหมือน/กองทัพ/ของ/พระเจ้า<note caller="+" style="f"><char style="fr" closed="false">12:22 </char><char style="ft" closed="false">หรือ/</char><char style="fqa" closed="false">กองทัพ/ยิ่งใหญ่/และ/ทรง/อานุภาพ</char></note><verse eid="1CH 12:22" /></para>
  <para style="s1">คนอื่นๆ ที่/มา/สมทบ/กับ/ดาวิด/ที่/เมือง/เฮโบรน</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 12:23" />ต่อไปนี้/เป็น/จำนวน/พลรบ/ที่/มา/สมทบ/กับ/ดาวิด/ที่/เมือง/เฮโบรน เพื่อ/จะ/ตั้ง/ดาวิด/เป็น/กษัตริย์/แทน/ซาอูล ตามที่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/ไว้/แล้ว<verse eid="1CH 12:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 12:24" />มี/นักรบ/จาก/ยูดาห์ 6,800 คน มี/โล่/และ/หอก/พร้อม<verse eid="1CH 12:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 12:25" />มี/นักรบ/พร้อม/ออกศึก/จาก/สิเมโอน 7,100 คน<verse eid="1CH 12:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 12:26" />จาก/เลวี 4,600 คน <verse eid="1CH 12:26" /><verse number="27" style="v" sid="1CH 12:27" />รวม/เยโฮยาดา/ซึ่งเป็น/หัวหน้า/ใน/ครอบครัว/ของ/อาโรน/พร้อมกับ/คน 3,700 คน <verse eid="1CH 12:27" /><verse number="28" style="v" sid="1CH 12:28" />และ/ศาโดก/นักรบ/หนุ่ม/ผู้/กล้าหาญ/พร้อมด้วย/เจ้าหน้าที่ 22 คน/จาก/ครอบครัว/ของเขา<verse eid="1CH 12:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 12:29" />จาก/เบนยามิน/ญาติพี่น้อง/ของ/ซาอูล/มี 3,000 คน ซึ่ง/ส่วนใหญ่/เคย/ภักดี/ต่อ/ฝ่าย/ซาอูล/มา/ก่อน<verse eid="1CH 12:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 12:30" />มี/นักรบ/กล้าหาญ/จาก/เอฟราอิม 20,800 คน ล้วน/มี/ชื่อเสียง/ใน/ตระกูล/ของ/ตน<verse eid="1CH 12:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 12:31" />เผ่า/มนัสเสห์/ครึ่งเผ่า/ส่ง/คน/มา/ตาม/รายชื่อ/ที่/ระบุ/ไว้ 18,000 คน เพื่อ/ตั้ง/ดาวิด/เป็น/กษัตริย์<verse eid="1CH 12:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 12:32" />มี/หัวหน้า/ตระกูล/จาก/อิสสาคาร์ 200 คน พร้อมทั้ง/ญาติ/ที่/อยู่/ใต้/บังคับ/บัญชา/ของเขา/ทุกคน/ที่/เข้า/ใจ/จังหวะ/เวลา และ/รู้/ว่า/อิสราเอล/ควร/ทำ/อย่างไร<verse eid="1CH 12:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 12:33" />มี/นักรบ/เจน/ศึก/จาก/เศบูลุน 50,000 คน พร้อม/ออกศึก/โดย/ใช้/อาวุธ/ทุก/ชนิด/และ/มี/ความ/ภักดี/ต่อ/ดาวิด/อย่าง/แน่วแน่<verse eid="1CH 12:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 12:34" />มี/เจ้าหน้าที่/จาก/นัฟทาลี 1,000 คน และ/ทหาร 37,000 คน ถือ/โล่/และ/หอก<verse eid="1CH 12:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 12:35" />จาก/ดาน/มี 28,600 คน พร้อม/ออกศึก<verse eid="1CH 12:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 12:36" />มี/ทหาร/เจน/ศึก/จาก/อาเชอร์ 40,000 คน พร้อมรบ<verse eid="1CH 12:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 12:37" />ชนเผ่า/รูเบน กาด และ/มนัสเสห์/อีก/ครึ่งเผ่า/จาก/ฟาก/ตะวันออก/ของ/แม่น้ำ/จอร์แดน 120,000 คน มี/อาวุธ/ทุก/ชนิด<verse eid="1CH 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 12:38" />ทั้งหมด/นี้/เป็น/นักรบ/ที่/สมัครใจ/ออกศึก พวกเขา/มา/ยัง/เมือง/เฮโบรน ตั้งใจ/เต็มที่/ที่/จะ/เชิญ/ดาวิด/ขึ้น/เป็น/กษัตริย์/เหนือ/อิสราเอล ชาว/อิสราเอล/อื่นๆ ทั้งหมด/ก็/พร้อมใจ/กัน/ที่/จะ/ตั้ง/ดาวิด/เป็น/กษัตริย์ <verse eid="1CH 12:38" /><verse number="39" style="v" sid="1CH 12:39" />พวกเขา/กินเลี้ยง/ร่วมกับ/ดาวิด/เป็น/เวลา/สามวัน เพราะ/ครอบครัว/ของ/พวกเขา/ได้/จัดเตรียม/เสบียง/มา/ให้ <verse eid="1CH 12:39" /><verse number="40" style="v" sid="1CH 12:40" />ทั้ง/ยังมี/ประชาชน/ทั้ง/ใกล้/และ/ไกล/เช่น อิสสาคาร์ เศบูลุน และ/นัฟทาลี นำ/อาหาร/บรรทุก/มา/บน/ลา อูฐ ล่อ และ/วัว นอกจากนั้น/ได้/นำ/สิ่งของ/มากมาย/มา/ร่วม/งานฉลอง/นี้/ได้แก่ แป้ง มะเดื่อ/อัด ขนม/ลูกเกด เหล้าองุ่น น้ำมัน วัว และ/แกะ เพราะ/มี/ความ/ชื่นชม/ยินดี/ใน/อิสราเอล<verse eid="1CH 12:40" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s1">อัญเชิญ/หีบ/พันธสัญญา/กลับมา</para>
  <para style="r">(<ref loc="2SA 6:1-11">2ซมอ.6:1-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />ดาวิด/ทรง/หารือ/กับ/แม่ทัพ/นายกอง/ทั้งปวง <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" />แล้ว/ตรัส/กับ/ชุมชน/อิสราเอล/ทั้งปวง/ว่า “หาก/ท่าน/ทั้งหลาย/เห็นดี/และ/เป็น/พระ/ประสงค์/ของ/พระยาห์เวห์/พระเจ้า/ของเรา ให้/เรา/ส่งข่าว/ไป/ยัง/พี่น้อง/ของเรา/ทั่ว/แดน/อิสราเอล/ทั้ง/ใกล้/หรือ/ไกล รวมทั้ง/บรรดา/ปุโรหิต/และ/คน/เลวี/ใน/เมือง/และ/ใน/ทุ่งหญ้า/ของ/พวกเขา/ให้/มา/ร่วมกับ/เรา <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" />ให้/เรา/อัญเชิญ/หีบ/พันธสัญญา/ของ/พระเจ้า/ของเรา/กลับ/คืน/มา เพราะ/ใน/รัชกาล/กษัตริย์/ซาอูล เรา/ได้/ละเลย/หีบนั้น<note caller="+" style="f"><char style="fr" closed="false">13:3 </char><char style="ft" closed="false">หรือ/</char><char style="fqa" closed="false">เรา/ได้/ละเลย/พระองค์/</char><char style="ft" closed="false">หรือ/</char><char style="fqa" closed="false">เรา/ไม่ได้/ทูลถาม/พระองค์</char></note>” <verse eid="1CH 13:3" /><verse number="4" style="v" sid="1CH 13:4" />ชุมนุม/ประชากร/ทั้งหมด/ล้วน/เห็น/พ้อง/ต้อง/กัน เพราะ/พวกเขา/เห็น/ว่า/เป็น/สิ่ง/ถูกต้อง<verse eid="1CH 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5" />ดาวิด/จึง/ทรง/ชุมนุม/พล/อิสราเอล/ทั่ว/แดน ตั้งแต่/แม่น้ำ/ชิโหร์/ใน/อียิปต์/จน/จด/เมือง/เลโบฮามัท<note caller="+" style="f"><char style="fr" closed="false">13:5 </char><char style="ft" closed="false">หรือ/</char><char style="fqa" closed="false">ทางเข้า/สู่/ฮามัท</char></note> เพื่อ/อัญเชิญ/หีบ/พันธสัญญา/ของ/พระเจ้า/มา/จาก/คีริยาทเยอาริม <verse eid="1CH 13:5" /><verse number="6" style="v" sid="1CH 13:6" />ดาวิด/และ/ชน/อิสราเอล/ทั้งปวง/จึง/ไป/ยัง/บาอาลาห์/แห่ง/ยูดาห์ (คีริยาทเยอาริม) เพื่อ/อัญเชิญ/หีบ/พันธสัญญา/ของ/พระเจ้า/พระยาห์เวห์/ซึ่ง/ประทับ/ระหว่าง/เครูบ อัน/เป็น/หีบ/พันธสัญญา/ที่/เรียก/ตาม/พระนาม<verse eid="1CH 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 13:7" />พวกเขา/อัญเชิญ/หีบ/พันธสัญญา/ของ/พระเจ้า/จาก/บ้าน/ของ/อาบีนาดับ/ขึ้น/บน/เกวียน/เล่ม/ใหม่ โดย/มี/อุสซาห์/และ/อาหิโย/เป็น/ผู้นำ/ทาง/มา <verse eid="1CH 13:7" /><verse number="8" style="v" sid="1CH 13:8" />ดาวิด/กับ/ประชากร/อิสราเอล/ทั้งปวง/เฉลิมฉลอง/อย่าง/เต็มที่/ต่อหน้า/พระเจ้า มี/การ/ขับร้อง/และ/บรรเลง/ดนตรี/ด้วย/พิณ/เขา/คู่ พิณใหญ่ รำมะนา ฉาบ และ/แตร<verse eid="1CH 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9" />เมื่อ/พวกเขา/มาถึง/ลาน/นวด/ข้าว/ของ/คิโดน วัว/สะดุด/เสียหลัก อุสซาห์/ยื่น/มือ/ออกรับ/หีบ/พันธสัญญา <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" />พระ/พิโรธ/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/จึง/พลุ่งขึ้น/ต่อ/อุสซาห์ พระองค์/ทรง/ประหาร/เขา/ที่/ยื่น/มือ/ออก/แตะต้อง/หีบ/พันธสัญญา เขา/จึง/สิ้นชีวิต/ลง/ต่อหน้า/พระเจ้า<verse eid="1CH 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11" />ดาวิด/ไม่/พอ/พระทัย/เพราะ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรง/พระ/พิโรธ/อุสซาห์ สถานที่/แห่ง/นั้น/จึง/ได้/ชื่อ/ว่า เปเรศอุสซาห์<note caller="+" style="f"><char style="fr" closed="false">13:11 </char><char style="ft" closed="false">แปลว่า อุบัติภัย/แก่/อุสซาห์</char></note>ตั้งแต่/นั้น/มา<verse eid="1CH 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 13:12" />ใน/วัน/นั้น/ดาวิด/เกรงกลัว/พระเจ้า/และ/ตรัส/ว่า “เรา/จะ/นำ/หีบ/พันธสัญญา/ของ/พระเจ้า/กลับไป/กับ/เรา/ได้/อย่างไร?” <verse eid="1CH 13:12" /><verse number="13" style="v" sid="1CH 13:13" />ใน/ที่สุด/ดาวิด/ก็/ไม่ได้/อัญเชิญ/หีบ/พันธสัญญา/ไป/ยัง/เมือง/ดาวิด แต่/นำไป/ไว้/ที่/บ้าน/ของ/โอเบดเอโดม/ชาวกัท <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />หีบ/พันธสัญญา/คงอยู่/กับ/ครอบครัว/ของ/โอเบดเอโดม/ตลอด/สามเดือน และ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรง/อวยพร/ครัวเรือน/และ/กิจการ/งาน/ทุกอย่าง/ของเขา<verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s1">ครอบครัว/ของ/ดาวิด</para>
  <para style="r">(<ref loc="2SA 5:11-16">2ซมอ.5:11-16</ref>; <ref loc="1CH 3:5-8">1พศด.3:5-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />กษัตริย์/ฮีราม/แห่ง/เมือง/ไทระ/ส่ง/ทูต/มา/เข้าเฝ้า/ดาวิด พร้อมกับ/ช่าง/สกัดหิน/และ/ช่างไม้ และ/ส่ง/ซุง/ไม้สน/ซีดาร์/มา/เพื่อ/ช่วย/สร้าง/พระราชวัง/ของ/ดาวิด <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" />ดาวิด/ทรง/ตระหนัก/ว่าที่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรง/สถาปนา/ดาวิด/เป็น/กษัตริย์/เหนือ/อิสราเอล และ/ทรง/เชิดชู/อาณาจักร/ของ/ดาวิด/อย่าง/มาก ก็/เพื่อ/เห็นแก่/อิสราเอล/ประชากร/ของ/พระองค์<verse eid="1CH 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3" />ที่/กรุง/เยรูซาเล็ม/ดาวิด/ทรงมี/มเหสี/อื่นๆ อีก/และ/มี/โอรส/ธิดา/มากมาย <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" />โอรส/ซึ่ง/ประสูติ/ที่นั่น/ได้แก่ ชัมมุวา โชบับ นาธัน โซโลมอน <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" />อิบฮาร์ เอลีชูอา เอลเปเลท <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" />โนกาห์ เนเฟก ยาเฟีย <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" />เอลีชามา เบเอลยาดา<note caller="+" style="f"><char style="fr" closed="false">14:7 </char><char style="ft" closed="false">เป็น/อีก/รูป/หนึ่ง/ของ/</char><char style="fqa" closed="false">เอลียาดา</char></note> และ/เอลีเฟเลท<verse eid="1CH 14:7" /></para>
  <para style="s1">ดาวิด/พิชิต/ชาว/ฟีลิสเตีย</para>
  <para style="r">(<ref loc="2SA 5:17-25">2ซมอ.5:17-25</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />เมื่อ/ชาว/ฟีลิสเตีย/ได้ข่าว/ว่า/ดาวิด/ได้รับ/การเจิม/ตั้ง/เป็น/กษัตริย์/ปกครอง/อิสราเอล ก็/ระดมพล/ทั้งหมด/มา/ตามหา/ดาวิด ดาวิด/ทรงทราบ/เรื่อง/จึง/ออกไป/รับมือ <verse eid="1CH 14:8" /><verse number="9" style="v" sid="1CH 14:9" />เมื่อ/ชาว/ฟีลิสเตีย/มาถึง/และ/ได้/บุกเข้า/ปล้น/หุบเขา/เรฟาอิม <verse eid="1CH 14:9" /><verse number="10" style="v" sid="1CH 14:10" />ดาวิด/จึง/ทูลถาม/พระเจ้า/ว่า “ข้าพระองค์/ควร/ออกไป/โจมตี/พวก/ฟีลิสเตีย/หรือไม่? พระองค์/จะ/ทรงมอบ/พวกเขา/ไว้/ใน/มือ/ของ/ข้าพระองค์/หรือไม่?”</para>
  <para style="p" vid="1CH 14:10">
    <char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/ตอบว่า “ไปเถิด เรา/จะ/มอบ/พวกเขา/ไว้/ใน/มือ/ของเจ้า”<verse eid="1CH 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11" />ดาวิด/กับ/พวก/จึง/บุกเข้า/โจมตี/ทัพ/ฟีลิสเตีย/ที่/บาอัลเปราซิม/และ/มี/ชัยชนะ ดาวิด/ตรัส/ว่า “พระเจ้า/ทรง/ถาโถม/เข้าใส่/ศัตรู/ของ/ข้าพเจ้า/ดั่ง/สายน้ำ/เชี่ยว/ด้วยมือ/ของ/ข้าพเจ้า” ที่/แห่ง/นั้น/จึง/ได้/ชื่อ/ว่า บาอัลเปราซิม<note caller="+" style="f"><char style="fr" closed="false">14:11 </char><char style="ft" closed="false">แปลว่า องค์/พระผู้เป็นเจ้า/ผู้/ทรง/ถาโถม/เข้าใส่</char></note> <verse eid="1CH 14:11" /><verse number="12" style="v" sid="1CH 14:12" />ชาว/ฟีลิสเตีย/ทิ้ง/รูปเคารพ/ของ/ตน/ไว้ และ/ดาวิด/สั่งให้/เผาทิ้ง<verse eid="1CH 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13" />ต่อมา/ชาว/ฟีลิสเตีย/มา/ปล้น/หุบเขา/แห่ง/นั้น/อีก <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" />ดาวิด/จึง/ทูลถาม/พระเจ้า/อีก/และ/พระเจ้า/ตรัส/ตอบว่า “อย่า/บุกโจมตี/ทาง/ด้าน/หน้า แต่/จง/โอบล้อม/แล้ว/รุก/เข้า/โจมตี/ทางด้าน/หน้า/ของ/หมู่/ต้นยาง/สน <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />เมื่อ/เจ้า/ได้ยิน/เสียง/คล้าย/เสียง/ย่ำเท้า/บน/ยอด/ต้นยาง/สน จง/บุกเข้า/โจมตี เพราะ/เป็น/สัญญาณ/ว่า/พระเจ้า/ได้/เสด็จ/ไป/ล่วงหน้า/เพื่อ/เล่นงาน/กองทัพ/ฟีลิสเตีย/แล้ว” <verse eid="1CH 14:15" /><verse number="16" style="v" sid="1CH 14:16" />ดังนั้น/ดาวิด/ก็/ทำ/ตาม/ที่/พระเจ้า/ตรัส/สั่ง และ/ทำลาย/ล้าง/ทัพ/ฟีลิสเตีย/ตลอดทาง/ตั้งแต่/เมือง/กิเบโอน/จนถึง/เมือง/เกเซอร์<verse eid="1CH 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17" />ชื่อเสียง/ของ/ดาวิด/จึง/เลื่องลือ/ไป/ทั่ว/ทุก/แดน และ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรงทำให้/ชนชาติ/ทั้งปวง/ยำเกรง/ดาวิด<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s1">อัญเชิญ/หีบ/พันธสัญญา/มายัง/กรุง/เยรูซาเล็ม</para>
  <para style="r">(<ref loc="2SA 6:12-19">2ซมอ.6:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />หลังจาก/ดาวิด/ได้/สร้าง/พระ/ตำหนัก/ต่างๆ สำหรับ/พระองค์/ใน/เมือง/ดาวิด/แล้ว ดาวิด/ก็/ทรง/เตรียม/ที่/สำหรับ/หีบ/พันธสัญญา/ของ/พระเจ้า/และ/ตั้ง/พลับพลา/ขึ้น/หลัง/หนึ่ง <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" />แล้ว/ดาวิด/ตรัส/ว่า “อย่าให้/ผู้/ใด/อื่น/เว้นแต่/ชน/เลวี/อัญเชิญ/หีบ/พันธสัญญา/ของ/พระเจ้า เพราะว่า/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรงเลือก/พวกเขา/ให้/หาม/หีบ/พันธสัญญา/ของ/<char style="nd">องค์/พระผู้เป็นเจ้า</char> และ/รับใช้/อยู่/ต่อหน้า/พระองค์/ตลอดไป”<verse eid="1CH 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 15:3" />ดาวิด/จึง/ทรงให้/เรียก/ชุมนุม/อิสราเอล/ทั้งปวง/ใน/กรุง/เยรูซาเล็ม เพื่อ/อัญเชิญ/หีบ/พันธสัญญา/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/มายัง/ที่/ซึ่ง/ดาวิด/จัดเตรียม/ไว้ <verse eid="1CH 15:3" /><verse number="4" style="v" sid="1CH 15:4" />แล้ว/ทรงให้/วงศ์วาน/ของ/อาโรน/และ/ชน/เลวี/มา/พร้อม/หน้า/กัน<verse eid="1CH 15:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 15:5" />จาก/วงศ์วาน/โคฮาท</para>
  <para style="li1" vid="1CH 15:5">อุรีเอล/เป็น/หัวหน้า/และ/ญาติ 120 คน<verse eid="1CH 15:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 15:6" />จาก/วงศ์วาน/เมรารี</para>
  <para style="li1" vid="1CH 15:6">อาสายาห์/เป็น/หัวหน้า/และ/ญาติ 220 คน<verse eid="1CH 15:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 15:7" />จาก/วงศ์วาน/เกอร์โชน<note caller="+" style="f"><char style="fr" closed="false">15:7 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">เกอร์โชม/</char><char style="ft" closed="false">เป็น/อีก/รูป/หนึ่ง/ของ/</char><char style="fqa" closed="false">เกอร์โชน</char></note></para>
  <para style="li1" vid="1CH 15:7">โยเอล/เป็น/หัวหน้า/และ/ญาติ 130 คน<verse eid="1CH 15:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 15:8" />จาก/วงศ์วาน/เอลีซาฟาน</para>
  <para style="li1" vid="1CH 15:8">เชไมอาห์/เป็น/หัวหน้า/และ/ญาติ 200 คน<verse eid="1CH 15:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 15:9" />จาก/วงศ์วาน/เฮโบรน</para>
  <para style="li1" vid="1CH 15:9">เอลีเอล/เป็น/หัวหน้า/และ/ญาติ 80 คน<verse eid="1CH 15:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 15:10" />จาก/วงศ์วาน/อุสซีเอล</para>
  <para style="li1" vid="1CH 15:10">อัมมีนาดับ/เป็น/หัวหน้า/และ/ญาติ 112 คน<verse eid="1CH 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11" />แล้ว/ดาวิด/ทรง/บัญชา/ให้/ปุโรหิต/ทั้งสอง/คือ ศาโดก/กับ/อาบียาธาร์ และ/คน/เลวี/ได้แก่ อุรีเอล อาสายาห์ โยเอล เชไมอาห์ เอลีเอล และ/อัมมีนาดับ/มา/เข้าเฝ้า <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" />แล้ว/ตรัส/ว่า “ท่าน/ทั้งหลาย/เป็น/หัวหน้า/ตระกูล/ต่างๆ ของ/เลวี ท่าน/และ/พวก/พ้อง/ชาวเลวี/จง/ชำระ/ตน/ให้/บริสุทธิ์/และ/นำ/หีบ/พันธสัญญา/ของ/พระยาห์เวห์/พระเจ้า/แห่ง/อิสราเอล/มายัง/สถานที่/ซึ่ง/เรา/ได้/จัดเตรียม/ไว้ <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" />ครั้งก่อน/พระยาห์เวห์/พระเจ้า/ของเรา/ทรง/พระ/พิโรธ/พวกเรา เพราะ/พวก/ท่าน/ซึ่งเป็น/คน/เลวี/ไม่ได้/เป็น/ผู้/อัญเชิญ/หีบ/พันธสัญญา เรา/ไม่ได้/ทูลถาม/พระองค์/ถึง/วิธีการ/ที่/จะ/นำ/หีบ/มา/ตาม/ที่/ทรง/กำหนด/ไว้” <verse eid="1CH 15:13" /><verse number="14" style="v" sid="1CH 15:14" />ฉะนั้น/เหล่า/ปุโรหิต/และ/คน/เลวี/จึง/ชำระ/ตน/เพื่อ/อัญเชิญ/หีบ/พันธสัญญา/ของ/พระยาห์เวห์/พระเจ้า/ของ/อิสราเอล <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" />จาก/นั้น/คน/เลวี/ได้/ยก/หีบ/พันธสัญญา/ของ/พระเจ้า/ขึ้น/บ่า/โดย/ใช้/คานหาม ตามที่/โมเสส/ได้/สั่ง/ไว้/ตาม/พระ/ดำรัส/ของ/องค์/พระผู้เป็นเจ้า<verse eid="1CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16" />ดาวิด/ตรัส/สั่ง/บรรดา/หัวหน้า/ของ/คน/เลวี/ให้/แต่งตั้ง/พี่น้อง/เป็น/นักร้อง เพื่อ/ขับร้อง/บทเพลง/รื่นเริง/ยินดี/คลอ/เสียง/เครื่อง/ดนตรี/ต่างๆ ได้แก่ พิณใหญ่ พิณเขาคู่ และ/ฉาบ<verse eid="1CH 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 15:17" />ชน/เลวี/จึง/แต่งตั้ง/เฮมาน/บุตร/โยเอล แต่งตั้ง/อาสาฟ/บุตร/เบเรคิยาห์/จาก/หมู่พี่น้อง/ของเขา และ/แต่งตั้ง/เอธาน/บุตร/คูชายาห์/จาก/พี่น้อง/ตระกูล/เมรารี <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />พี่น้อง/ที่/เป็น/ผู้/ช่วย/รอง/ลงมา/ได้แก่ เศคาริยาห์<note caller="+" style="f"><char style="fr" closed="false">15:18 </char><char style="ft" closed="false">สำเนา/ต้นฉบับ/ภาษาฮีบรู/ส่วนใหญ่/ว่า/</char><char style="fqa" closed="false">เศคาริยาห์ บุตร และ/</char><char style="ft" closed="false">หรือ/</char><char style="fqa" closed="false">เศคาริยาห์ เบน และ/</char><char style="ft" closed="false">(ดูข้อ 20 และ <char style="xt"><ref loc="1CH 16:5">16:5</ref></char>)</char></note> ยาอาซีเอล เชมิราโมท เยฮีเอล อุนนี เอลีอับ เบไนยาห์ มาอาเสอาห์ มัททีธิยาห์ เอลีเฟเลหุ มิกเนยาห์ โอเบดเอโดม และ/เยอีเอล<note caller="+" style="f"><char style="fr" closed="false">15:18 </char><char style="ft" closed="false">ฉบับ LXX. ว่า/</char><char style="fqa" closed="false">เยอีเอล/และ/อาซาซิยาห์/</char><char style="ft" closed="false">(ดู/ข้อ 21)</char></note>ยาม/เฝ้า/ประตู<verse eid="1CH 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19" />นักดนตรี/คือ/เฮมาน อาสาฟ และ/เอธาน/เป็น/ผู้/ตีฉาบ/ทอง/สัมฤทธิ์ <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" />เศคาริยาห์ เอซีเอล เชมิราโมท เยฮีเอล อุนนี เอลีอับ มาอาเสอาห์ และ/เบไนยาห์/เล่น/พิณ/ใหญ่/คลอ/ตาม/ทำนอง/อาลาโมท <verse eid="1CH 15:20" /><verse number="21" style="v" sid="1CH 15:21" />มัททีธิยาห์ เอลีเฟเลหุ มิกเนยาห์ โอเบดเอโดม เยอีเอล และ/อาซาซิยาห์ เล่น/พิณ/เขา/คู่/คลอ/ตาม/ทำนอง/เชมินิท <verse eid="1CH 15:21" /><verse number="22" style="v" sid="1CH 15:22" />เคนานิยาห์/หัวหน้า/ของ/คน/เลวี/รับผิดชอบ/ดูแล/การ/ขับร้อง/เพราะ/เขา/เชี่ยวชาญ/มาก<verse eid="1CH 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 15:23" />เบเรคิยาห์/และ/เอลคานาห์/เป็น/ยาม/ประตู/เฝ้า/หีบ/พันธสัญญา <verse eid="1CH 15:23" /><verse number="24" style="v" sid="1CH 15:24" />เชบานิยาห์ โยชาฟัท เนธันเอล อามาสัย เศคาริยาห์ เบไนยาห์ และ/เอลีเอเซอร์ ล้วนเป็น/ปุโรหิต/ผู้/เป่าแตร/นำหน้า/หีบ/พันธสัญญา/ของ/พระเจ้า โอเบดเอโดม/กับ/เยฮียาห์/ก็/เป็น/ยาม/ประตู/เฝ้า/หีบ/พันธสัญญา/ด้วย<verse eid="1CH 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25" />ดาวิด/และ/บรรดา/ผู้/อาวุโส/ของ/อิสราเอล/และ/นายทัพ/นายกอง/จึง/ไป/อัญเชิญ/หีบ/พันธสัญญา/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/มา/จาก/บ้าน/ของ/โอเบดเอโดม/ด้วย/ความ/ชื่นชม/ยินดี <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />เพราะ/พระเจ้า/ทรง/ช่วย/คน/เลวี/ที่/หาม/หีบ/พันธสัญญา/ของ/<char style="nd">องค์/พระผู้เป็นเจ้า</char> เขา/ทั้งปวง/จึง/ถวาย/วัว/ผู้/เจ็ด/ตัว/และ/แกะผู้/เจ็ด/ตัว <verse eid="1CH 15:26" /><verse number="27" style="v" sid="1CH 15:27" />ดาวิด/พร้อมทั้ง/คน/เลวี/ทั้งหมด/ที่/อัญเชิญ/หีบ/พันธสัญญา คณะ/นักร้อง และ/เคนานิยาห์/ผู้/รับผิดชอบ/คณะ/นักร้อง/ต่างก็/สวม/ชุด/ผ้าลินิน ดาวิด/ทรง/สวม/เอโฟด/ลินิน/ด้วย <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />เป็นอันว่า/ปวงชน/อิสราเอล/ได้/อัญเชิญ/หีบ/พันธสัญญา/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/มายัง/กรุง/เยรูซาเล็ม/ท่ามกลาง/เสียง/โห่ร้อง/ชื่นชม/ยินดี เสียง/เป่า/เขาแกะ/และ/แตร เสียง/ฉาบ เสียงพิณ/ใหญ่/และ/พิณ/เขา/คู่<verse eid="1CH 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29" />ขณะที่/หีบ/พันธสัญญา/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/เข้าสู่/เมือง/ดาวิด มีคาล/ราชธิดา/ของ/ซาอูล/มอง/จาก/หน้าต่าง เห็น/กษัตริย์/ดาวิด/ทรง/ร่ายรำ/และ/เฉลิม/ฉลอง/ก็/นึก/ดู/แคลน/อยู่/ในใจ<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1" />พวกเขา/อัญเชิญ/หีบ/พันธสัญญา/ของ/พระเจ้า/มา/ตั้งไว้/ใน/พลับพลา/ซึ่ง/ดาวิด/ทรง/จัด/เตรียมไว้ และ/ถวาย/เครื่อง/เผา/บูชา/กับ/เครื่อง/สันติ/บูชา/ต่อหน้า/พระเจ้า <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" />หลังจากที่/ถวาย/เครื่อง/เผา/บูชา/และ/เครื่อง/สันติ/บูชา/เสร็จแล้ว ดาวิด/ก็/ทรง/อวยพร/ประชาชน/ใน/พระนาม/ของ/พระยาห์เวห์ <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />และ/ประทาน/ขนมปัง อินทผลัม/อัด และ/ขนม/ลูกเกด/อย่างละ/หนึ่ง/ก้อน/แก่/อิสราเอล/ทุกคน/ทั้ง/ชาย/และ/หญิง<verse eid="1CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4" />ดาวิด/ทรง/แต่งตั้ง/คน/เลวี/บางคน/ให้/ปฏิบัติ/งาน/อยู่/หน้า/หีบ/พันธสัญญา/ของ/<char style="nd">องค์/พระผู้เป็นเจ้า</char> โดย/การ/ทูลขอ ขอบพระคุณ และ/ถวาย/คำ/สรรเสริญ/แด่/พระยาห์เวห์/พระเจ้า/แห่ง/อิสราเอล/ได้แก่ <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" />อาสาฟ/เป็น/หัวหน้า รองลงมา/คือ/เศคาริยาห์ คนอื่นๆ ได้แก่ เยอีเอล เชมิราโมท เยฮีเอล มัททีธิยาห์ เอลีอับ เบไนยาห์ โอเบดเอโดม และ/เยอีเอล คน/เหล่านี้/เล่น/พิณ/ใหญ่/และ/พิณ/เขา/คู่ อาสาฟ/เป็น/ผู้/ตีฉาบ <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" />ปุโรหิต/เบไนยาห์/และ/ยาฮาซีเอล/เป่าแตร/เป็น/ประจำ/หน้า/หีบ/พันธสัญญา/ของ/พระเจ้า<verse eid="1CH 16:6" /></para>
  <para style="s1">บท/สดุดี/ขอบพระคุณ/ของ/ดาวิด</para>
  <para style="r">(<ref loc="PSA 96:1-13">สดด.96:1-13</ref>; <ref loc="PSA 105:1-15">105:1-15</ref>; <ref loc="PSA 106:1">106:1</ref>,<ref loc="PSA 106:47-48">47-48</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7" />ใน/วัน/นั้น/ดาวิด/ทรงมอบ/บท/สดุดี/ขอบพระคุณ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ให้/อาสาฟ/กับ/ผู้/ช่วย/ของเขา/เป็น/ครั้งแรก/ดังนี้/ว่า<verse eid="1CH 16:7" /></para>
  <para style="qm1">
    <verse number="8" style="v" sid="1CH 16:8" />จง/ขอบพระคุณ/<char style="nd">องค์/พระผู้เป็นเจ้า</char> และ/ร้อง/ทูล/ออก/พระนาม/ของ/พระองค์</para>
  <para style="qm1" vid="1CH 16:8">ให้/ประชาชาติ/ทั้งหลาย/ได้/รู้/ถึง/สิ่ง/ที่/พระองค์/ทรงทำ<verse eid="1CH 16:8" /></para>
  <para style="qm1">
    <verse number="9" style="v" sid="1CH 16:9" />จง/ร้องเพลง/ถวาย/พระองค์ ร้อง/สรรเสริญ/ถวาย/พระองค์</para>
  <para style="qm1" vid="1CH 16:9">บอก/ถึง/พระ/ราชกิจ/อัน/มหัศจรรย์/ทั้งสิ้น/ของ/พระองค์<verse eid="1CH 16:9" /></para>
  <para style="qm1">
    <verse number="10" style="v" sid="1CH 16:10" />จง/เทิดทูน/พระนาม/อัน/บริสุทธิ์/ของ/พระองค์</para>
  <para style="qm1" vid="1CH 16:10">ให้/จิตใจ/ของ/ผู้/ที่/แสวงหา/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ชื่นชม/ยินดี<verse eid="1CH 16:10" /></para>
  <para style="qm1">
    <verse number="11" style="v" sid="1CH 16:11" />จง/หมาย/พึ่ง/<char style="nd">องค์พระผู้เป็นเจ้า</char>/และ/พลัง/อำนาจ/ของ/พระองค์</para>
  <para style="qm1" vid="1CH 16:11">จง/แสวงหา/พระพักตร์/พระองค์/เสมอ<verse eid="1CH 16:11" /></para>
  <para style="b" />
  <para style="qm1">
    <verse number="12" style="v" sid="1CH 16:12" />จง/ระลึก/ถึง/ปาฏิหาริย์/ที่/พระองค์/ทรง/กระทำ</para>
  <para style="qm1" vid="1CH 16:12">ถึง/การ/อัศจรรย์/และ/คำ/พิพากษา/ที่/พระองค์/ทรง/ประกาศ<verse eid="1CH 16:12" /></para>
  <para style="qm1">
    <verse number="13" style="v" sid="1CH 16:13" />วงศ์วาน/อิสราเอล/ผู้/รับใช้/ของ/พระองค์/เอ๋ย</para>
  <para style="qm1" vid="1CH 16:13">ลูกหลาน/ของ/ยาโคบ/ที่/ทรงเลือก/สรร/เอ๋ย<verse eid="1CH 16:13" /></para>
  <para style="qm1">
    <verse number="14" style="v" sid="1CH 16:14" />พระองค์/ทรงเป็น/พระยาห์เวห์/พระเจ้า/ของเรา</para>
  <para style="qm1" vid="1CH 16:14">การ/พิพากษา/ของ/พระองค์/อยู่/ทั่ว/พื้น/แผ่นดิน/โลก<verse eid="1CH 16:14" /></para>
  <para style="b" />
  <para style="qm1">
    <verse number="15" style="v" sid="1CH 16:15" />พระองค์/ทรง/ระลึก/ถึง<note caller="+" style="f"><char style="fr" closed="false">16:15 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">จง/ระลึก/ถึง/</char><char style="ft" closed="false">(ดู/<char style="xt"><ref loc="PSA 105:8">สดด.105:8</ref></char>)</char></note>พันธสัญญา/ของ/พระองค์/ตลอดกาล</para>
  <para style="qm1" vid="1CH 16:15">ทรง/ระลึก/ถึง/พระดำรัส/ที่/ทรง/บัญชา/ไว้/ตลอด/พัน/ชั่วอายุ/คน<verse eid="1CH 16:15" /></para>
  <para style="qm1">
    <verse number="16" style="v" sid="1CH 16:16" />พันธสัญญา/ที่/พระองค์/ทรงทำ/กับ/อับราฮัม</para>
  <para style="qm1" vid="1CH 16:16">คำปฏิญาณ/ที่/พระองค์/ทรงสัญญา/กับ/อิสอัค<verse eid="1CH 16:16" /></para>
  <para style="qm1">
    <verse number="17" style="v" sid="1CH 16:17" />พระองค์/ทรง/ยืนยัน/ต่อ/ยาโคบ/เป็น/กฎเกณฑ์</para>
  <para style="qm1" vid="1CH 16:17">ต่อ/อิสราเอล/เป็น/พันธสัญญา/นิรันดร์<verse eid="1CH 16:17" /></para>
  <para style="qm1">
    <verse number="18" style="v" sid="1CH 16:18" />“เรา/จะ/ยก/ดินแดน/คานาอัน/ให้/เจ้า</para>
  <para style="qm1" vid="1CH 16:18">ให้/เป็น/มรดก/ของเจ้า/ทั้งหลาย”<verse eid="1CH 16:18" /></para>
  <para style="b" />
  <para style="qm1">
    <verse number="19" style="v" sid="1CH 16:19" />เมื่อ/อิสราเอล/ยัง/มี/จำนวน/น้อย/นัก</para>
  <para style="qm1" vid="1CH 16:19">น้อย/เหลือเกิน และ/เป็น/เพียง/คน/แปลกหน้า/ใน/ดินแดน/นั้น<verse eid="1CH 16:19" /></para>
  <para style="qm1">
    <verse number="20" style="v" sid="1CH 16:20" />พวกเขา<note caller="+" style="f"><char style="fr" closed="false">16:18-20 </char><char style="ft" closed="false">สำเนา/ต้นฉบับ/ภาษาฮีบรู/ส่วนใหญ่/ว่า/</char><char style="fqa" closed="false">เป็น/มรดก/ของเจ้า/ทั้งหลาย / </char><char style="fv" closed="false">19 </char><char style="fqa" closed="false">แม้ว่า/อิสราเอล/ยัง/มี/จำนวน/น้อย/นัก / น้อย/เหลือเกิน/และ/เป็น/เพียง/คน/แปลกหน้า/ใน/ที่นั้น” / </char><char style="fv" closed="false">20 </char><char style="fqa" closed="false">พวกเขา</char></note>ระเหเร่ร่อน/จาก/ชนชาติ/หนึ่ง/ไป/อีก/ชนชาติ/หนึ่ง</para>
  <para style="qm1" vid="1CH 16:20">จาก/อาณาจักร/หนึ่ง/ไป/อีก/อาณาจักร/หนึ่ง<verse eid="1CH 16:20" /></para>
  <para style="qm1">
    <verse number="21" style="v" sid="1CH 16:21" />พระองค์/ไม่/ทรง/ยอมให้/ใคร/ข่มเหง/รังแก/เขา</para>
  <para style="qm1" vid="1CH 16:21">เพราะ/เห็นแก่/เขา พระองค์/ทรง/กำราบ/กษัตริย์/ทั้งหลาย<verse eid="1CH 16:21" /></para>
  <para style="qm1">
    <verse number="22" style="v" sid="1CH 16:22" />“อย่า/แตะต้อง/บรรดา/ผู้/ที่/เรา/เจิม/ตั้งไว้</para>
  <para style="qm1" vid="1CH 16:22">อย่าทำ/อันตราย/ใดๆ แก่/เหล่า/ผู้เผยพระวจนะ/ของเรา”<verse eid="1CH 16:22" /></para>
  <para style="b" />
  <para style="qm1">
    <verse number="23" style="v" sid="1CH 16:23" />ทั่ว/ทั้ง/โลก/จง/ร้องเพลง/ถวาย/องค์/พระผู้เป็นเจ้า</para>
  <para style="qm1" vid="1CH 16:23">จง/ประกาศ/ความรอด/ของ/พระองค์/ทุกๆ วัน<verse eid="1CH 16:23" /></para>
  <para style="qm1">
    <verse number="24" style="v" sid="1CH 16:24" />จง/ประกาศ/พระเกียรติสิริ/ของ/พระองค์/ท่ามกลาง/ประชาชาติ/ทั้งหลาย</para>
  <para style="qm1" vid="1CH 16:24">ประกาศ/พระ/ราชกิจ/ล้ำเลิศ/ของ/พระองค์/ท่ามกลาง/ชนชาติ/ทั้งมวล<verse eid="1CH 16:24" /></para>
  <para style="b" />
  <para style="qm1">
    <verse number="25" style="v" sid="1CH 16:25" />เพราะ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรง/ยิ่งใหญ่/นัก และ/ควร/แก่/การ/สรรเสริญ/เป็น/ที่สุด</para>
  <para style="qm1" vid="1CH 16:25">พระองค์/ทรงเป็น/ที่/เคารพ/ยำเกรง/เหนือ/พระ/ทั้งปวง<verse eid="1CH 16:25" /></para>
  <para style="qm1">
    <verse number="26" style="v" sid="1CH 16:26" />เพราะ/พระ/ของ/ชนชาติ/ต่างๆ เป็น/เพียง/รูปเคารพ</para>
  <para style="qm1" vid="1CH 16:26">แต่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรงสร้าง/ฟ้าสวรรค์<verse eid="1CH 16:26" /></para>
  <para style="qm1">
    <verse number="27" style="v" sid="1CH 16:27" />สง่าราศี/และ/พระบารมี/อยู่/ต่อหน้า/พระองค์</para>
  <para style="qm1" vid="1CH 16:27">พระ/เดชานุภาพ/และ/ความ/ปีติยินดี/อยู่/ใน/ที่/ประทับ/ของ/พระองค์<verse eid="1CH 16:27" /></para>
  <para style="b" />
  <para style="qm1">
    <verse number="28" style="v" sid="1CH 16:28" />ทุก/ครอบครัว/ใน/ชนชาติ/ทั้งหลาย/เอ๋ย จง/เทิดทูน/<char style="nd">องค์พระผู้เป็นเจ้า</char>/เถิด</para>
  <para style="qm1" vid="1CH 16:28">จง/เทิดทูน/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ถึง/พระเกียรติสิริ/และ/พระ/เดชานุภาพ/ของ/พระองค์<verse eid="1CH 16:28" /></para>
  <para style="qm1">
    <verse number="29" style="v" sid="1CH 16:29" />จง/เทิดทูน/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ตาม/พระ/เกียรติ/สิริ/ที่/ควร/แก่/พระนาม/ของ/พระองค์</para>
  <para style="qm1" vid="1CH 16:29">จง/นำ/เครื่อง/บูชา/มา/ต่อหน้า/พระองค์</para>
  <para style="qm1" vid="1CH 16:29">จง/นมัสการ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ใน<note caller="+" style="f"><char style="fr" closed="false">16:29 </char><char style="ft" closed="false">หรือ/</char><char style="fqa" closed="false">ด้วย</char></note>สง่าราศี/แห่ง/ความ/บริสุทธิ์/ของ/พระองค์<verse eid="1CH 16:29" /></para>
  <para style="qm1">
    <verse number="30" style="v" sid="1CH 16:30" />โลก/ทั้ง/โลก/จง/สั่นสะท้าน/ต่อหน้า/พระองค์</para>
  <para style="qm1" vid="1CH 16:30">โลก/ได้รับ/การ/สถาปนา/ไว้/อย่าง/มั่นคง จะ/ไม่มี/วัน/คลอนแคลน<verse eid="1CH 16:30" /></para>
  <para style="b" />
  <para style="qm1">
    <verse number="31" style="v" sid="1CH 16:31" />ฟ้าสวรรค์/จง/ชื่นชม/ยินดี แผ่นดิน/โลก/จง/เปรมปรีดิ์</para>
  <para style="qm1" vid="1CH 16:31">ให้/ประชาชาติ/ทั้งหลาย/กล่าว/ว่า “<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรง/ครอบครอง!”<verse eid="1CH 16:31" /></para>
  <para style="qm1">
    <verse number="32" style="v" sid="1CH 16:32" />ท้องทะเล/และ/สรรพสิ่ง/ใน/นั้น/จง/แซ่ซ้อง/กังวาน</para>
  <para style="qm1" vid="1CH 16:32">ท้องทุ่ง/และ/ทุกสิ่ง/ใน/นั้น/จง/ร่าเริง<verse eid="1CH 16:32" /></para>
  <para style="qm1">
    <verse number="33" style="v" sid="1CH 16:33" />แล้ว/ต้นไม้/ใน/ป่า/จะ/ร้องเพลง</para>
  <para style="qm1" vid="1CH 16:33">พวก/มัน/จะ/ร้องเพลง/อย่าง/ชื่นบาน/ต่อหน้า/องค์/พระผู้เป็นเจ้า</para>
  <para style="qm1" vid="1CH 16:33">เพราะ/พระองค์/เสด็จมา/เพื่อ/พิพากษา/แผ่นดิน/โลก<verse eid="1CH 16:33" /></para>
  <para style="b" />
  <para style="qm1">
    <verse number="34" style="v" sid="1CH 16:34" />จง/ขอบพระคุณ/<char style="nd">องค์/พระผู้เป็นเจ้า</char> เพราะ/พระองค์/ทรง/แสนดี</para>
  <para style="qm1" vid="1CH 16:34">ความรัก/มั่นคง/ของ/พระองค์/ดำรง/นิรันดร์<verse eid="1CH 16:34" /></para>
  <para style="qm1">
    <verse number="35" style="v" sid="1CH 16:35" />จง/ร้อง/ทูล/พระองค์/ว่า “ข้าแต่/พระเจ้า องค์/พระ/ผู้ช่วย/ให้/รอด ขอ/ทรง/ช่วย/ข้าพระองค์/ทั้งหลาย/ให้/รอด</para>
  <para style="qm1" vid="1CH 16:35">ขอ/ทรง/รวบรวม/และ/กอบกู้/ข้าพระองค์/ทั้งหลาย/จาก/ชนชาติ/ต่างๆ</para>
  <para style="qm1" vid="1CH 16:35">เพื่อ/ข้าพระองค์/ทั้งหลาย/จะ/ขอบพระคุณ/พระนาม/อัน/บริสุทธิ์/ของ/พระองค์</para>
  <para style="qm1" vid="1CH 16:35">เพื่อ/ข้าพระองค์/ทั้งหลาย/จะ/ยกย่อง/สรรเสริญ/พระองค์”<verse eid="1CH 16:35" /></para>
  <para style="qm1">
    <verse number="36" style="v" sid="1CH 16:36" />ขอ/สรรเสริญ/พระยาห์เวห์/พระเจ้า/แห่ง/อิสราเอล</para>
  <para style="qm1" vid="1CH 16:36">จาก/นิรันดร์/กาล/จวบจน/นิรันดร์/กาล</para>
  <para style="m" vid="1CH 16:36">แล้ว/ให้/ปวง/ประชากร/จง/กล่าว/ว่า “อาเมน” และ “สรรเสริญ/องค์/พระผู้เป็นเจ้า”<verse eid="1CH 16:36" /></para>
  <para style="b" />
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37" />ดาวิด/ทรงมอบ/หมาย/ให้/อาสาฟ/และ/คณะ/ปฏิบัติ/หน้าที่/อย่าง/สม่ำเสมอ/ที่/หน้า/หีบ/พันธสัญญา/ของ/<char style="nd">องค์/พระผู้เป็นเจ้า</char> โดย/จัดการ/ทุกอย่าง/ให้/ครบถ้วน/ตาม/ข้อกำหนด/ทุกวัน <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" />และ/ให้/โอเบดเอโดม และ/เพื่อน/ร่วม/งาน 68 คน/ร่วม/ปรนนิบัติ/ด้วย โอเบดเอโดม/บุตร/เยดูธูน/และ/โฮสาห์/เป็น/ยาม/เฝ้า/ประตู<verse eid="1CH 16:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39" />ดาวิด/ทรงให้/ปุโรหิต/ศาโดก/และ/ปุโรหิต/คนอื่นๆ ซึ่ง/รับใช้/ร่วมกัน/กับ/เขา/ประจำ/อยู่/ที่/พลับพลา/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/บน/สถาน/บูชา/บน/ที่สูง/ใน/กิเบโอน <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" />เพื่อ/ถวาย/เครื่อง/เผา/บูชา/บน/แท่น/บูชา/แด่/<char style="nd">องค์/พระผู้เป็นเจ้า</char> ทุกเช้า/ทุก/เย็น/ตาม/ที่/บันทึก/ไว้/ใน/บทบัญญัติ/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ที่/ประทาน/แก่/อิสราเอล <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" />และ/ให้/เฮมาน เยดูธูน กับ/คนอื่นๆ อีก/หลาย/คน/ที่/ได้/รับ/เลือก/และ/ระบุ/ชื่อ/ไว้/เป็น/ผู้/ถวาย/คำ/ขอบ/พระคุณ/แด่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ว่า “เพราะ/ความรัก/มั่นคง/ของ/พระองค์/ดำรง/นิรันดร์” <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" />เฮมาน/กับ/เยดูธูน/รับผิดชอบ/การเป่า/แตร ตีฉาบ และ/บรรเลง/เครื่อง/ดนตรี/ต่างๆ คลอไป/กับ/บทเพลง/ศักดิ์สิทธิ์ บุตร/ทั้งหลาย/ของ/เยดูธูน/ประจำ/อยู่/ที่/ประตู<verse eid="1CH 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43" />จาก/นั้น/ประชาชน/ทั้งหมด/ก็/แยกย้าย/กัน/กลับ/บ้าน ส่วน/ดาวิด/เสด็จ/กลับ/พระราชวัง/ไป/อวยพร/เชื้อ/พระวงศ์<verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s1">คำสัญญา/ของ/พระเจ้า/ต่อ/ดาวิด</para>
  <para style="r">(<ref loc="2SA 7:1-17">2ซมอ.7:1-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />หลังจาก/ดาวิด/เข้า/ประทับ/ใน/พระราชวัง/แล้ว พระองค์/ตรัส/กับ/ผู้เผยพระวจนะ/นาธัน/ว่า “ดูเถิด เรา/อยู่/ใน/วัง/ไม้สน/ซีดาร์ ใน/ขณะที่/หีบ/พันธสัญญา/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/อยู่/ใน/เต็นท์”<verse eid="1CH 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2" />นาธัน/ทูล/ตอบว่า “ขอ/ทรงทำ/ตาม/พระ/ดำริ/ของ/ฝ่าพระบาท/เถิด เพราะ/พระเจ้า/สถิต/กับ/ฝ่าพระบาท”<verse eid="1CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3" />ใน/คืนนั้น/มี/พระ/ดำรัส/ของ/พระเจ้า/มาถึง/นาธัน/ความ/ว่า<verse eid="1CH 17:3" /></para>
  <para style="pm">
    <verse number="4" style="v" sid="1CH 17:4" />“จง/ไป/บอก/ดาวิด/ผู้/รับใช้/ของเรา/ว่า ‘<char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/ดังนี้/ว่า เจ้า/ไม่ใช่/ผู้/ที่/จะ/สร้าง/วิหาร/ให้/เรา/อยู่ <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />เรา/ไม่เคย/อยู่/ใน/วิหาร/เลย นับตั้งแต่/เรา/นำ/อิสราเอล/ออก/มา/จาก/อียิปต์/จวบจน/ทุกวันนี้ เรา/ไป/มา/กับ/เต็นท์/ตลอด ไม่ว่า/ย้ายไป/ที่ไหน <verse eid="1CH 17:5" /><verse number="6" style="v" sid="1CH 17:6" />ไม่ว่า/เรา/ไป/ที่ไหน/กับ/ปวงชน/อิสราเอล เรา/เคย/ออกปาก/กับ/ผู้/นำ<note caller="+" style="f"><char style="fr" closed="false">17:6 </char><char style="ft" closed="false">โดยปกติ/แปลว่า/</char><char style="fqa" closed="false">ผู้/วินิจฉัย/</char><char style="ft" closed="false">เช่น/เดียว/กับ/ข้อ 10</char></note>คน/ใด/ซึ่ง/เรา/สั่ง/ให้/เลี้ยงดู/ประชากร/ของเรา/หรือ/ว่า “ทำไม/ไม่/สร้าง/วิหาร/ด้วย/ไม้สน/ซีดาร์/ให้/เรา?” ’<verse eid="1CH 17:6" /></para>
  <para style="pm">
    <verse number="7" style="v" sid="1CH 17:7" />“บัดนี้/จง/บอก/ดาวิด/ผู้/รับใช้/ของเรา/ว่า ‘พระยาห์เวห์/ผู้/ทรงฤทธิ์/ตรัส/ว่า เรา/พา/เจ้า/ออกมา/จาก/ทุ่งหญ้า จาก/การ/ต้อน/ฝูงแกะ/มา/ปกครอง/อิสราเอล/ประชากร/ของเรา <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />เรา/อยู่/กับ/เจ้า/ไม่ว่า/เจ้า/ไป/ที่ไหน/และ/เรา/ทำลาย/ศัตรู/ทั้งปวง/ของเจ้า/ออกไป/ให้/พ้น/หน้า/เจ้า บัดนี้/เรา/จะ/ทำให้/นาม/ของเจ้า/เลื่องลือ/ไป/เหมือน/นาม/บุคคล/สำคัญ/ทั้งหลาย/ของ/โลก <verse eid="1CH 17:8" /><verse number="9" style="v" sid="1CH 17:9" />และ/เรา/จัดเตรียม/ที่/แห่ง/หนึ่ง/ให้/อิสราเอล/ประชากร/ของเรา/ตั้งรกราก เพื่อ/เขา/จะ/มี/บ้านเรือน/เป็น/ของ/ตนเอง/และ/ไม่ต้อง/ถูก/รบกวน/อีก คน/ชั่ว/จะ/ไม่/มา/ข่มเหง/รังแก/พวกเขา/อย่างที่/เคยทำ/อีก/ต่อไป <verse eid="1CH 17:9" /><verse number="10" style="v" sid="1CH 17:10" />และ/เป็น/อย่างนั้น/เรื่อยมา/นับตั้งแต่/เรา/ได้/ตั้ง/ผู้/นำ/ทั้งหลาย/ปกครอง/อิสราเอล/ประชากร/ของเรา เรา/จะ/ปราบ/ศัตรู/ทั้งปวง/ของเจ้า/ด้วย</para>
  <para style="pm" vid="1CH 17:10">“ ‘เรา/ขอ/ประกาศ/ว่า/<char style="nd">องค์พระผู้เป็นเจ้า</char>/จะ/สถาปนา/วงศ์วาน/สำหรับ/เจ้า <verse eid="1CH 17:10" /><verse number="11" style="v" sid="1CH 17:11" />เมื่อ/เจ้า/หมด/อายุขัย/และ/ล่วงลับ/ไป/อยู่/กับ/บรรพบุรุษ/ของเจ้า/แล้ว เรา/จะ/ตั้ง/บุตร/ชาย/คนหนึ่ง/ของเจ้า/ขึ้น/ครองราชย์/ต่อ/จาก/เจ้า เป็น/บุตร/คน/หนึ่ง/ของเจ้า/เอง และ/เรา/จะ/สถาปนา/อาณาจักร/ของเขา <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />เขา/เป็น/ผู้/ที่/จะ/สร้าง/วิหาร/ให้/เรา และ/เรา/จะ/สถาปนา/บัลลังก์/ของเขา/ตลอดกาล <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" />เรา/จะ/เป็น/บิดา/ของเขา/และ/เขา/จะ/เป็น/บุตร/ของเรา เรา/จะ/ไม่/ริบ/ความรัก/มั่นคง/ของเรา/ไป/จาก/เขา เหมือน/ที่/เรา/ริบ/จาก/ผู้/ที่/ปกครอง/ก่อนหน้า/เจ้า <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />เรา/จะ/ตั้ง/เขา/ไว้/ใน/นิเวศ/และ/อาณาจักร/ของเรา/ตลอดไป เรา/จะ/สถาปนา/บัลลังก์/ของเขา/ไว้/ตลอด/นิรันดร์’ ”<verse eid="1CH 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15" />นาธัน/จึง/กราบทูล/พระดำรัส/ทั้งสิ้น/ที่/ทรง/เปิดเผย/นี้/ให้/ดาวิด/ทราบ<verse eid="1CH 17:15" /></para>
  <para style="s1">คำ/อธิษฐาน/ของ/ดาวิด</para>
  <para style="r">(<ref loc="2SA 7:18-29">2ซมอ.7:18-29</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16" />จาก/นั้น/กษัตริย์/ดาวิด/จึง/เสด็จ/เข้าไป/ประทับ/นั่ง/ต่อหน้า/<char style="nd">องค์/พระผู้เป็นเจ้า</char> และ/ทูล/ว่า</para>
  <para style="pm" vid="1CH 17:16">“ข้าแต่/พระเจ้า/พระยาห์เวห์ ข้าพระองค์/เป็น/ผู้/ใด/เล่า วงศ์ตระกูล/ของ/ข้าพระองค์/เป็น/ใคร/หนอ พระองค์/จึง/ทรงนำ/ข้าพระองค์/มาถึง/เพียงนี้? <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />และ/ไม่/เพียง/เท่านี้ ข้าแต่/พระเจ้า พระองค์/ยัง/ตรัส/ถึง/อนาคต/ของ/วงศ์วาน/ผู้/รับใช้/ของ/พระองค์ พระองค์/ทรง/ทอดพระเนตร/ข้าพระองค์/ราวกับว่า/เป็น/ผู้/มี/เกียรติ/สูงส่ง ข้าแต่/พระเจ้า/พระยาห์เวห์<verse eid="1CH 17:17" /></para>
  <para style="pm">
    <verse number="18" style="v" sid="1CH 17:18" />“ดาวิด/จะ/กราบทูล/อะไร/มาก/ไป/กว่า/นี้/ได้/ที่/ทรงให้/เกียรติ/ผู้/รับใช้/ของ/พระองค์/ถึงเพียงนี้? เพราะ/พระองค์/ทรง/รู้จัก/ผู้/รับใช้/ของ/พระองค์ <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" />ข้าแต่/<char style="nd">องค์/พระผู้เป็นเจ้า</char> พระองค์/ทรง/กระทำ/สิ่ง/ที่/ยิ่งใหญ่/นี้ และ/ประทาน/คำ/มั่น/สัญญา/อัน/ยิ่งใหญ่/เหล่านี้ เพราะ/เห็นแก่/ผู้/รับใช้/ของ/พระองค์ และ/ตาม/พระ/ประสงค์/ของ/พระองค์<verse eid="1CH 17:19" /></para>
  <para style="pm">
    <verse number="20" style="v" sid="1CH 17:20" />“ข้าแต่/<char style="nd">องค์/พระผู้เป็นเจ้า</char> เท่าที่/ข้าพระองค์/ทั้งหลาย/ได้ยิน/มา/กับ/หู ไม่มี/ผู้/ใด/เสมอ/เหมือน/พระองค์ ไม่มี/พระเจ้า/อื่นใด/นอกจาก/พระองค์ <verse eid="1CH 17:20" /><verse number="21" style="v" sid="1CH 17:21" />และ/มี/ชนชาติ/ใด/เล่า/ทั่ว/พิภพ/ที่/เสมอ/เหมือน/อิสราเอล/ประชากร/ของ/พระองค์ ซึ่ง/พระเจ้า/ของเขา/เสด็จมา/ไถ่/ประชากร/เพื่อ/พระองค์/เอง และ/เพื่อ/นำ/เกียรติยศ/มา/สู่/พระนาม/ของ/พระองค์ และ/ทรง/กระทำ/การ/อัศจรรย์/อัน/ยิ่งใหญ่/น่า/เกรงขาม โดย/ขับไล่/ประชาชาติ/ต่างๆ/ออกไป/ให้/พ้น/หน้า/ประชากร/ของ/พระองค์/ซึ่ง/พระองค์/ทรง/ไถ่/ออก/จาก/อียิปต์ <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />พระองค์/ทรงให้/อิสราเอล/ประชากร/ของ/พระองค์/เป็น/กรรมสิทธิ์/ของ/พระองค์/เอง/ตลอด/นิรันดร์ และ/ข้าแต่/<char style="nd">องค์/พระผู้เป็นเจ้า</char> พระองค์/ทรงเป็น/พระเจ้า/ของ/พวกเขา<verse eid="1CH 17:22" /></para>
  <para style="pm">
    <verse number="23" style="v" sid="1CH 17:23" />“และ/บัดนี้ ข้าแต่/<char style="nd">องค์/พระผู้เป็นเจ้า</char> ขอให้/คำมั่นสัญญา/ที่/ทรงให้/ไว้/เกี่ยวกับ/ผู้/รับใช้/และ/วงศ์วาน/นั้น/ได้/รับ/การ/สถาปนา/ไว้/ตลอด/นิรันดร์ ขอ/ทรง/กระทำ/ตาม/พระ/สัญญา <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />เพื่อ/การ/นั้น/จะ/ตั้งมั่น/อยู่/และ/เพื่อ/พระนาม/ของ/พระองค์/จะ/ยิ่งใหญ่/นิรันดร์ แล้ว/คน/ทั้งหลาย/จะ/กล่าว/ว่า ‘พระยาห์เวห์/ผู้/ทรงฤทธิ์ พระเจ้า/เหนือ/อิสราเอล ทรงเป็น/พระเจ้า/ของ/อิสราเอล’ และ/วงศ์วาน/ดาวิด/ผู้/รับใช้/ของ/พระองค์/จะ/ได้รับ/การ/สถาปนา/ไว้/ต่อหน้า/พระองค์<verse eid="1CH 17:24" /></para>
  <para style="pm">
    <verse number="25" style="v" sid="1CH 17:25" />“ข้าแต่/พระเจ้า/ของ/ข้าพระองค์ พระองค์/ทรง/เปิดเผย/แก่/ผู้/รับใช้/ของ/พระองค์/ว่า/จะ/ทรง/สถาปนา/วงศ์วาน/เพื่อ/เขา ดังนั้น/ผู้/รับใช้/ของ/พระองค์/จึง/กล้า/ทูล/อธิษฐาน/เช่นนี้ <verse eid="1CH 17:25" /><verse number="26" style="v" sid="1CH 17:26" />ข้าแต่/พระยาห์เวห์ พระองค์/ทรงเป็น/พระเจ้า! พระองค์/ทรงสัญญา/จะ/ประทาน/สิ่งดี/เหล่านี้/ให้แก่/ผู้/รับใช้/ของ/พระองค์ <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />บัดนี้/พระองค์/ทรง/พอพระทัย/ที่/จะ/อวยพร/วงศ์วาน/ของ/ผู้/รับใช้/ของ/พระองค์/ให้/ยืนยง/ตลอดไป/ใน/สาย/พระเนตร/ของ/พระองค์ ข้าแต่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/เพราะ/พระองค์/ทรง/อวยพร/วงศ์วาน/ของ/ข้าพระองค์/แล้ว และ/พวกเขา/จะ/ได้รับ/พระพร/ของ/พระองค์/สืบไป/นิรันดร์”<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s1">ชัยชนะ/ของ/ดาวิด</para>
  <para style="r">(<ref loc="2SA 8:1-14">2ซมอ.8:1-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />ต่อมา/ดาวิด/ทรง/พิชิต/ชาว/ฟีลิสเตีย/อย่าง/ราบคาบ ทรงยึด/เมืองกัท/และ/หมู่บ้าน/โดยรอบ/จาก/ฟีลิสเตีย<verse eid="1CH 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 18:2" />ดาวิด/ยัง/ได้/ทรง/พิชิต/ชาว/โมอับ/ด้วย พวกเขา/ตก/เป็น/เมืองขึ้น/และ/นำ/เครื่อง/บรรณาการ/มา/ถวาย<verse eid="1CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3" />ยิ่งกว่านั้น/ดาวิด/ยัง/ทรง/สู้รบ/กับ/กษัตริย์/ฮาดัดเอเซอร์/แห่ง/เมือง/โศบาห์/ไป/จนถึง/เมือง/ฮามัท ใน/คราว/ที่/ฮาดัดเอเซอร์/ทรง/เสด็จ/ไป/สถาปนา/ราช/อำนาจ/แถบ/แม่น้ำ/ยูเฟรติส <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" />ดาวิด/ทรงยึด/รถม้าศึก/หนึ่งพัน/คัน พล/รถรบ/เจ็ดพัน/คน และ/ทหารราบ/สองหมื่น/คน ทรงตัด/เอ็น/ขา/ม้า/ศึก/ทั้งหมด ยกเว้น/ม้า/สำหรับ/เทียม/รถ/หนึ่ง/ร้อยตัว<verse eid="1CH 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5" />เมื่อ/ชาว/อารัม/จาก/เมือง/ดามัสกัส/มา/ช่วย/กษัตริย์/ฮาดัดเอเซอร์/แห่ง/เมือง/โศบาห์ ดาวิด/ทรง/สังหาร/พวกเขา 22,000 คน <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" />ทรงวาง/กำลัง/ทหาร/ไว้/ใน/อาณาจักร/อารัม/แห่ง/ดามัสกัส ชาวอารัม/ก็/ขึ้นกับ/ดาวิด/และ/ต้อง/ส่ง/บรรณาการ/มา/ถวาย <char style="nd">องค์พระผู้เป็นเจ้า</char>/ประทาน/ชัยชนะ/แก่/ดาวิด/ไม่ว่า/เขา/จะ/ไป/ที่/ไหน<verse eid="1CH 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7" />ดาวิด/ทรงนำ/โล่/ทองคำ/ของ/บรรดา/นายทหาร/ของ/ฮาดัดเอเซอร์/มายัง/กรุง/เยรูซาเล็ม <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" />และ/นำ/ทอง/สัมฤทธิ์/จำนวน/มหาศาล/มา/จาก/เมือง/เทบาห์<note caller="+" style="f"><char style="fr" closed="false">18:8 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">ทิบหาท/</char><char style="ft" closed="false">เป็น/อีก/รูป/หนึ่ง/ของ/</char><char style="fqa" closed="false">เทบาห์</char></note>และ/เมืองคูน/ของ/ฮาดัดเอเซอร์ โซโลมอน/ทรงใช้/ทอง/สัมฤทธิ์/เหล่านี้/ทำ/ขันสาคร เสาหาน และ/ภาชนะ/ทอง/สัมฤทธิ์/ต่างๆ<verse eid="1CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9" />เมื่อ/กษัตริย์/โทอู/แห่ง/เมือง/ฮามัท/ได้ข่าว/ว่า/ดาวิด/ทรง/รบชนะ/ทั้ง/กองทัพ/ของ/กษัตริย์/ฮาดัดเอเซอร์/แห่ง/เมือง/โศบาห์ <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />ก็/ส่ง/ฮาโดรัม/ราช/โอรส/มา/ถวาย/คำนับ/กษัตริย์/ดาวิด/และ/ร่วม/ยินดี/ใน/ชัยชนะ/เหนือ/ฮาดัดเอเซอร์ เพราะ/ฮาดัดเอเซอร์/และ/โทอู/เป็น/ศัตรู/ที่/ขับเคี่ยว/กัน/มา ฮาโดรัม/นำ/เครื่องเงิน เครื่องทอง และ/เครื่องทอง/สัมฤทธิ์/มา/ถวาย/ด้วย<verse eid="1CH 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 18:11" />กษัตริย์/ดาวิด/ทรง/ถวาย/สิ่ง/เหล่านี้/แด่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/เช่น/เดียว/กับ/เงิน/และ/ทอง/ที่/ทรง/ริบ/มา/จาก/ชนชาติ/ทั้งหมด/ต่อไปนี้/คือ เอโดม โมอับ อัมโมน ฟีลิสเตีย และ/อามาเลข<verse eid="1CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12" />อาบีชัย/บุตร/นาง/เศรุยาห์/สังหาร/ชาว/เอโดม 18,000 คน/ที่/หุบเขา/เกลือ <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" />เขา/วาง/กำลัง/ทหาร/ไว้/ใน/เอโดม และ/ชาว/เอโดม/ทั้งปวง/ก็/ยอม/สวามิภักดิ์/ต่อ/ดาวิด <char style="nd">องค์พระผู้เป็นเจ้า</char>/ประทาน/ชัยชนะ/แก่/ดาวิด/ไม่ว่า/เขา/จะ/ไป/ที่/ไหน<verse eid="1CH 18:13" /></para>
  <para style="s1">ข้าราชบริพาร/ของ/ดาวิด</para>
  <para style="r">(<ref loc="2SA 8:15-18">2ซมอ.8:15-18</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14" />ดาวิด/ทรง/ปกครอง/ทั่ว/แดน/อิสราเอล ทรงทำ/สิ่ง/ที่/ถูกต้อง/เที่ยงธรรม/เพื่อ/ปวง/ประชากร/ของ/พระองค์ <verse eid="1CH 18:14" /><verse number="15" style="v" sid="1CH 18:15" />โยอาบ/บุตร/นาง/เศรุยาห์/เป็น/แม่ทัพ/เยโฮชาฟัท/บุตร/อาหิลูด/เป็น/อาลักษณ์/หลวง <verse eid="1CH 18:15" /><verse number="16" style="v" sid="1CH 18:16" />ศาโดก/บุตร/อาหิทูบ/และ/อาหิเมเลค<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="ft" closed="false">สำเนา/ต้นฉบับ/ภาษาฮีบรู/ส่วนใหญ่/ว่า/</char><char style="fqa" closed="false">อาบีเมเลค/</char><char style="ft" closed="false">(ดู/<char style="xt"><ref loc="2SA 8:17">2ซมอ.8:17</ref></char>)</char></note>บุตร/อาบียาธาร์/เป็น/ปุโรหิต ชัฟชา/เป็น/ราช/เลขา <verse eid="1CH 18:16" /><verse number="17" style="v" sid="1CH 18:17" />เบไนยาห์/บุตร/เยโฮยาดา/ดูแล/คน/เคเรธี/และ/คน/เปเลท บรรดา/โอรส/ของ/ดาวิด/เป็น/ราช/มนตรี<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="s1">ดาวิด/พิชิต/ชาว/อัมโมน</para>
  <para style="r">(<ref loc="2SA 10:1-19">2ซมอ.10:1-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />ต่อมา/กษัตริย์/นาหาช/แห่ง/อัมโมน/สิ้นพระชนม์ และ/โอรส/ของ/พระองค์/ขึ้น/ครองราชย์/แทน <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" />ดาวิด/ทรง/รำพึง/ว่า “เรา/จะ/แสดง/ความ/กรุณา/ต่อ/ฮานูน/บุตร/นาหาช/เพราะ/บิดา/ของเขา/เคย/แสดง/ความ/กรุณา/ต่อเรา” ดาวิด/จึง/ทรงส่ง/ทูต/ไป/แสดง/ความ/เสียใจ/ต่อ/ฮานูน/ที่/สูญเสีย/ราช/บิดา</para>
  <para style="p" vid="1CH 19:2">แต่/เมื่อ/คณะทูต/ของ/ดาวิด/มา/เข้าเฝ้า/ฮานูน/ที่/ดินแดน/อัมโมน/เพื่อ/แสดง/ความ/เห็นใจ/ต่อเขา <verse eid="1CH 19:2" /><verse number="3" style="v" sid="1CH 19:3" />พวก/ขุนนาง/ชาว/อัมโมน/ทูล/ฮานูน/ว่า “ฝ่าพระบาท/ทรง/คิดว่า/ดาวิด/ให้เกียรติ/แก่/ราช/บิดา/ของ/ฝ่าพระบาท/โดย/ส่ง/คน/เหล่านี้/มา/แสดง/ความ/เห็นใจ/ต่อ/ฝ่าพระบาท/หรือ? พวกเขา/มา/สอดแนม/ดู/ลาดเลา/ก่อน/เข้าโจมตี/ไม่ใช่หรือ?” <verse eid="1CH 19:3" /><verse number="4" style="v" sid="1CH 19:4" />ดังนั้น/ฮานูน/จึง/จับ/คน/ของ/ดาวิด/โกน/เครา/และ/ตัด/เสื้อ/ผ้า/ตรง/สะโพก/ออก แล้ว/ปล่อยไป<verse eid="1CH 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 19:5" />เมื่อ/ดาวิด/ทรงทราบ/เหตุการณ์/ที่/เกิดขึ้น จึง/ส่ง/ผู้/สื่อสาร/ไป/พบ/คน/เหล่านั้น/เพราะ/พวกเขา/รู้สึก/อับอาย/ขายหน้า/อย่าง/มาก กษัตริย์/ตรัส/ว่า “จง/พักอยู่ที่/เยรีโค/จนกว่า/เครา/จะ/ขึ้น/ดังเดิม แล้ว/ค่อย/กลับมา”<verse eid="1CH 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6" />ถึง/ตอนนี้/ชาว/อัมโมน/ตระหนัก/ดี/ว่า/ได้/ยั่วยุ/ดาวิด/อย่าง/ร้ายแรง ฮานูน/และ/ชาว/อัมโมน/จึง/นำ/เงิน/หนัก/ประมาณ 34 ตัน<note caller="+" style="f"><char style="fr" closed="false">19:6 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">1,000 ตะลันต์</char></note> ไป/จ้าง/รถม้าศึก/และ/พล/รถรบ/จาก/อารัมนาหะราอิม อารัม มาอาคาห์ และ/โศบาห์ <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />ฮานูน/ทรง/จ้าง/รถม้าศึก 32,000 คัน/และ/พล/รถรบ และ/ให้/เงิน/กษัตริย์/มาอาคาห์/กับ/กองทัพ/ซึ่ง/มา/ตั้ง/ค่ายพัก/อยู่/ใกล้/เมือง/เมเดบา ขณะที่/ชาว/อัมโมน/เคลื่อนทัพ/มา/จาก/เมือง/ต่างๆ เพื่อ/สู้รบ<verse eid="1CH 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8" />เมื่อ/ดาวิด/ทรงทราบ/เช่นนั้น/ก็/ส่ง/โยอาบ/และ/กองทัพ/อิสราเอล/ทั้งหมด/ไป <verse eid="1CH 19:8" /><verse number="9" style="v" sid="1CH 19:9" />กองทัพ/อัมโมน/ออกมา/ตั้ง/ประจัน/หน้า/กับ/กองทัพ/ของ/ดาวิด/ที่/ทาง/เข้า/เมือง/ของ/พวกเขา ใน/ขณะที่/บรรดา/กษัตริย์/ซึ่ง/เสด็จมา/ร่วมรบ/ด้วย/นั้น/ตั้ง/ค่าย/อยู่/ใน/ที่โล่ง/นอกเมือง<verse eid="1CH 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10" />โยอาบ/เห็นว่า/กอง/กำลัง/ของ/ศัตรู/ตั้ง/แนวรบ/อยู่/ทั้ง/ข้างหน้า/และ/ข้างหลัง ก็/จัดกำลัง/ทหาร/ฝีมือดี/ที่สุด/ของ/อิสราเอล/ส่วนหนึ่ง/ไป/รับ/มือ/ชาว/อารัม <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" />โยอาบ/ให้/ทหาร/ส่วน/ที่/เหลือ/อยู่/ภายใต้/การ/บัญชาการ/ของ/อาบีชัย/น้องชาย/ของเขา และ/จัดทัพ/เคลื่อน/ออกไป/รับมือ/กับ/ชาว/อัมโมน <verse eid="1CH 19:11" /><verse number="12" style="v" sid="1CH 19:12" />โยอาบ/กล่าว/ว่า “ถ้า/พวก/อารัม/แข็งแกร่ง/เกินกำลัง/ของเรา เจ้า/จง/มา/ช่วย/เรา แต่ถ้า/พวก/อัมโมน/แข็งแกร่ง/เกินกำลัง/ของเจ้า เรา/จะ/ไป/ช่วย/เจ้า <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />จง/เข้มแข็ง/และ/ให้/เรา/ต่อสู้/อย่าง/กล้าหาญ/เพื่อ/พี่น้อง/ร่วมชาติ/ของเรา และ/เพื่อ/นคร/แห่ง/พระเจ้า/ของเรา <char style="nd">องค์พระผู้เป็นเจ้า</char>/จะ/ทรง/กระทำ/ตามที่/ทรง/เห็นชอบ”<verse eid="1CH 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14" />แล้ว/โยอาบ/กับ/กอง/ทหาร/ก็/บุกเข้า/โจมตี ชาว/อารัม/ก็/ถอยหนี <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" />เมื่อ/ชาว/อัมโมน/เห็น/ชาว/อารัม/ล่าถอย พวกเขา/ก็/ถอยหนี/จาก/อาบีชัย/น้องชาย/ของ/โยอาบ/เข้า/ไป/ใน/เมือง โยอาบ/จึง/ยกทัพ/กลับมา/ยัง/กรุง/เยรูซาเล็ม<verse eid="1CH 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16" />หลังจาก/ชาว/อารัม/เห็นว่า/ถูก/อิสราเอล/รุกไล่/พวกเขา/ก็/ส่ง/คน/ไป/นำ/กำลัง/ชาว/อารัม/จาก/อีก/ฟาก/หนึ่ง/ของ แม่น้ำ/ยูเฟรติส/โดย/แม่ทัพ/โชฟาค/ของ/ฮาดัดเอเซอร์/นำทัพ/มา<verse eid="1CH 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17" />เมื่อ/ดาวิด/ทรงทราบ/ข่าว พระองค์/ทรง/ระดมพล/อิสราเอล/ทั้งหมด/และ/ข้าม/แม่น้ำ/จอร์แดน/ไป/รบ/กับ/ศัตรู ทรง/ตั้ง/แนวรบ/ประจัน/หน้า/กับ/ชาว/อารัม/และ/สู้รบ/กัน <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" />แต่/พวกเขา/พ่าย/หนี/ต่อหน้า/อิสราเอล และ/ดาวิด/ทรง/สังหาร/พล/รถรบ/ของ/พวกเขา/เจ็ดพัน/คน/กับ/ทหารราบ/อีก/สี่หมื่น/คน และ/ทรง/สังหาร/โชฟาค/แม่ทัพ/ของ/พวกเขา/ด้วย<verse eid="1CH 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 19:19" />เมื่อ/ข้ารับใช้/ของ/ฮาดัดเอเซอร์/เห็นว่า/พวกเขา/พ่ายแพ้/อิสราเอล/ก็/ขอ/สงบศึก/และ/ยอม/เป็น/เมืองขึ้น/ของ/ดาวิด ชาว/อารัม/จึง/ไม่กล้า/มา/ช่วย/ชาว/อัมโมน/สู้รบ/อีก/เลย<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s1">การยึด/เมือง/รับบาห์</para>
  <para style="r">(<ref loc="2SA 11:1">2ซมอ.11:1</ref>; <ref loc="2SA 12:29-31">12:29-31</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />ใน/ฤดู/ใบไม้/ผลิ/อัน/เป็น/ช่วง/ที่/กษัตริย์/ทั้งหลาย/มัก/ออกไป/รบ โยอาบ/นำ/ทัพ/อิสราเอล/ไป/ทำลาย/ล้าง/ดินแดน/ของ/ชาว/อัมโมน แล้ว/เขา/ก็/ไป/ล้อม/เมือง/รับบาห์ แต่/ดาวิด/ยังคง/ประทับ/อยู่/ที่/กรุง/เยรูซาเล็ม โยอาบ/โจมตี/รับบาห์/และ/ทิ้ง/ให้/เป็น/ซาก/ปรักหักพัง <verse eid="1CH 20:1" /><verse number="2" style="v" sid="1CH 20:2" />ดาวิด/ทรง/ถอด/มงกุฎ/จาก/พระ/เศียร/ของ/กษัตริย์<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">หรือ/</char><char style="fqa" closed="false">ของ/พระมิลโคม/</char><char style="ft" closed="false">(คือ พระโมเลค)</char></note>ของ/พวกเขา/มา/สวม/บน/พระ/เศียร/ของ/พระองค์ มงกุฎ/นั้น/ทำ/ด้วย/ทองคำ/หนัก/ประมาณ 34 กิโลกรัม<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">1 ตะลันต์</char></note>ประดับ/เพชร/นิล/จินดา ดาวิด/ทรง/ริบ/ของ/เชลย/ได้/มากมาย/จาก/เมือง/นั้น <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />และ/ทรง/เกณฑ์/ชาว/เมือง/นั้น/ให้/มา/ทำงาน/โดย/ใช้/เลื่อย จอบ เสียม/และ/ขวาน ดาวิด/ทรงทำ/เช่นนี้/กับ/ทุกเมือง/ของ/อัมโมน แล้ว/ดาวิด/กับ/กองทัพ/ทั้งหมด/ก็/กลับ/กรุง/เยรูซาเล็ม<verse eid="1CH 20:3" /></para>
  <para style="s1">สงคราม/กับ/ชาว/ฟีลิสเตีย</para>
  <para style="r">(<ref loc="2SA 21:15-22">2ซมอ.21:15-22</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />ต่อมา/มี/การสู้รบ/กับ/ชาว/ฟีลิสเตีย/อีก/ที่/เกเซอร์ ครั้งนั้น/สิบเบคัย/ชาว/หุชาห์/ได้/สังหาร/สิปปัย/วงศ์วาน/ของ/พวก/มนุษย์ยักษ์/เรฟาอิม และ/ชาว/ฟีลิสเตีย/ก็/ยอมแพ้<verse eid="1CH 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5" />ใน/การรบ/กับ/ฟีลิสเตีย/อีก/ครั้งหนึ่ง เอลฮานัน/บุตร/ยาอีร์/ได้/สังหาร/ลามี/น้องชาย/ของ/โกลิอัท/ชาวกัท ผู้/ซึ่ง/ถือ/หอก/ด้าม/ใหญ่/เหมือน/ไม้/กระพั่น/ทอผ้า<verse eid="1CH 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6" />ใน/การรบ/อีก/ครั้งที่/เมืองกัท คน/ร่าง/ยักษ์/ผู้/หนึ่ง/มี/นิ้วมือ/นิ้วเท้า/ข้างละ 6 นิ้ว/รวมเป็น 24 นิ้ว ซึ่งเป็น/วงศ์วาน/ราฟา/เช่นกัน <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" />ได้/มา/ข่มขู่/อิสราเอล แต่/ถูก/โยนาธาน/บุตร/ชิเมอา/พี่ชาย/ของ/ดาวิด/สังหาร<verse eid="1CH 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8" />แล้ว/ดาวิด/และ/ทหาร/ปลิดชีพ/คน/เหล่านี้/ซึ่ง/เป็น/วงศ์วาน/ของ/ราฟา/แห่ง/เมืองกัท<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s1">ดาวิด/ทรง/นับ/ไพร่พล</para>
  <para style="r">(<ref loc="2SA 24:1-25">2ซมอ.24:1-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />ซาตาน/ลุกขึ้น/เล่นงาน/อิสราเอล และ/ดลใจ/ให้/ดาวิด/ทำ/สำมะโน/ไพร่พล/อิสราเอล <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" />ดาวิด/จึง/ตรัส/กับ/โยอาบ/และ/เหล่า/แม่ทัพ/นายกอง/ว่า “จง/ไป/นับ/ไพร่พล/อิสราเอล/จาก/เมือง/เบเออร์เชบา/จด/เมืองดาน/แล้ว/กลับมา/รายงาน เพื่อ/เรา/จะ/รู้ว่า/มี/คน/อยู่/เท่าไร”<verse eid="1CH 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3" />โยอาบ/ทูล/ทัดทาน/ว่า “ขอ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรง/เพิ่มพูน/กำลังพล/ของ/พระองค์/ร้อยเท่า ทั้งหมด/ก็/เป็น/คน/ของ/ฝ่าพระบาท/ไม่ใช่หรือ? เหตุใด/จึง/ทรง/ประสงค์/ให้/ทำ/เช่นนี้? ควร/หรือ/ที่/จะ/นำ/ความผิด/มา/สู่/อิสราเอล?”<verse eid="1CH 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4" />แต่/คำบัญชา/ของ/กษัตริย์/ย่อม/มี/อำนาจ/เหนือ/โยอาบ โยอาบ/จึง/เดินทาง/ไป/ทั่ว/ดินแดน/อิสราเอล/แล้ว/กลับมา/ยัง/กรุง/เยรูซาเล็ม <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" />โยอาบ/ทูล/รายงาน/ดาวิด/ว่า/จำนวน/คน/ที่/ออกรบ/ได้/ทั่ว/ทั้ง/อิสราเอล/มี 1,100,000 คน และ 470,000 คน/ใน/ยูดาห์<verse eid="1CH 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 21:6" />แต่/โยอาบ/ไม่ได้/รวม/จำนวน/คน/เลวี/และ/เบนยามิน เพราะ/เขา/รู้สึก/ว่า/คำบัญชา/นี้/น่ารังเกียจ <verse eid="1CH 21:6" /><verse number="7" style="v" sid="1CH 21:7" />คำบัญชา/นี้/ก็/เป็น/สิ่ง/ที่/ชั่ว/ใน/สาย/พระเนตร/ของ/พระเจ้า/ด้วย ดังนั้น/พระองค์/จึง/ทรง/ลงโทษ/อิสราเอล<verse eid="1CH 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 21:8" />ดาวิด/กราบทูล/พระเจ้า/ว่า “สิ่ง/ที่/ข้าพระองค์/ทำ/นั้น/บาป/มาก บัดนี้/ขอ/ทรง/โปรด/ยกโทษ/ความผิด/ของ/ผู้/รับใช้/ของ/พระองค์ ข้าพระองค์/ได้/ทำ/สิ่ง/ที่/โง่เขลา/มาก”<verse eid="1CH 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9" />
    <char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/กับ/กาด/ผู้/ทำนาย/ของ/ดาวิด/ว่า <verse eid="1CH 21:9" /><verse number="10" style="v" sid="1CH 21:10" />“จง/ไป/บอก/ดาวิด/ว่า ‘<char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/ดังนี้/ว่า เรา/มี/ข้อเสนอ/สาม/ประการ ให้/เจ้า/เลือก/อย่าง/หนึ่ง/แล้ว/เรา/จะ/จัดการ/กับ/เจ้า/ตามนั้น’ ”<verse eid="1CH 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11" />กาด/จึง/เข้าเฝ้า/และ/ทูล/ดาวิด/ว่า “<char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/ดังนี้/ว่า ‘จง/เลือก/เอา <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />ระหว่าง/การ/กันดาร/อาหาร/สามปี หรือ/ถูกดาบ/ของ/ศัตรู/ของเจ้า/ล้างผลาญ/สามเดือน<note caller="+" style="f"><char style="fr" closed="false">21:12 </char><char style="ft" closed="false">ฉบับ LXX. และ Vulg. ว่า/</char><char style="fqa" closed="false">เตลิด/หนี/จาก/การไล่ล่า/ฆ่าฟัน/ของ/ศัตรู/สามเดือน/</char><char style="ft" closed="false">(ดู/<char style="xt"><ref loc="2SA 24:13">2ซมอ.24:13</ref></char>)</char></note> หรือ/ถูก/ลงโทษ/ด้วย/ดาบ/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/สามวัน/คือ โรคระบาด/ร้ายแรง/ซึ่ง/ทูต/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/จะ/นำ/หายนะ/มา/สู่/อิสราเอล/ทุก/หย่อม/หญ้า’ ดังนั้น/ขอ/ทรง/แจ้ง/คำตอบ/เพื่อ/ข้าพระบาท/จะ/นำไป/ทูล/พระองค์/ผู้/ทรงใช้/ข้าพระบาท/มา”<verse eid="1CH 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13" />ดาวิด/ตรัส/ตอบ/กาด/ว่า “เรา/ลำบากใจ/มาก แต่/ขอ/ตกอยู่ใน/อุ้ง/พระหัตถ์/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ดีกว่า/ตกอยู่ใน/เงื้อมมือ/ของ/มนุษย์ เพราะ/พระ/เมตตา/คุณ/ของ/พระองค์/ใหญ่หลวง/นัก”<verse eid="1CH 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14" />ฉะนั้น/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรงให้/เกิดโรค/ระบาด/ใน/อิสราเอล เป็น/ผล/ให้/มี/คน/ล้มตาย/เจ็ดหมื่น/คน <verse eid="1CH 21:14" /><verse number="15" style="v" sid="1CH 21:15" />ใน/ช่วง/โรคระบาด พระเจ้า/ทรงใช้/ทูตสวรรค์/องค์หนึ่ง/มา/ทำลาย/ล้าง/กรุง/เยรูซาเล็ม แต่/ขณะนั้น/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทอดพระเนตร/แล้ว/ทรง/ทุกข์/พระทัย/เนื่องด้วย/ภัยพิบัติ/นั้น จึง/ตรัส/แก่/ทูต/ผู้/ทำลาย/ว่า “พอ/แล้ว! ยั้งมือ/เถิด” ขณะนั้น/ทูต/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/กำลัง/ยืนอยู่/ที่/ลาน/นวด/ข้าว/ของ/อาราวนาห์<note caller="+" style="f"><char style="fr" closed="false">21:15 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">โอรนัน/</char><char style="ft" closed="false">เป็น/อีก/รูป/หนึ่ง/ของ/</char><char style="fqa" closed="false">อาราวนาห์/</char><char style="ft" closed="false">เช่น/เดียว/กับ/ข้อ 18-28</char></note>ชาว/เยบุส<verse eid="1CH 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16" />เมื่อ/ดาวิด/ทอดพระเนตร/เห็น/ทูต/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ยืนอยู่/ระหว่าง/ฟ้าสวรรค์/กับ/แผ่นดิน/โลก และ/ถือ/ดาบ/อยู่/เหนือ/กรุง/เยรูซาเล็ม ดาวิด/กับ/บรรดา/ผู้/อาวุโส/ซึ่ง/สวม/ผ้ากระสอบ/อยู่/จึง/หมอบ/กราบ/ซบหน้า/ลง/กับ/พื้น<verse eid="1CH 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 21:17" />ดาวิด/กราบทูล/พระเจ้า/ว่า “ข้าพระองค์/ไม่ใช่หรือ/ที่/สั่งให้/นับ/จำนวน/ไพร่พล ข้าพระองค์/คือ/ผู้/ที่/ทำ/ผิด/ทำ/บาป ประชากร/เหล่านี้/เป็น/แต่เพียง/ฝูงแกะ พวกเขา/ทำ/ผิด/อัน/ใด/เล่า? ข้าแต่/พระยาห์เวห์/พระเจ้า/ของ/ข้าพระองค์ ขอ/ทรง/ลงโทษ/ข้าพระองค์/กับ/ครอบครัว/เท่านั้น/เถิด แต่/อย่าให้/ภัยพิบัติ/นี้/ยังคงอยู่/กับ/ประชากร/ของ/พระองค์/เลย”<verse eid="1CH 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18" />ทูต/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/จึง/สั่ง/กาด/ให้/ไป/แจ้ง/ดาวิด/ให้/ขึ้นไป/สร้าง/แท่นบูชา/ถวาย/แด่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ที่/ลาน/นวด/ข้าว/ของ/อาราวนาห์/ชาว/เยบุส <verse eid="1CH 21:18" /><verse number="19" style="v" sid="1CH 21:19" />ดาวิด/จึง/ไป/ปฏิบัติ/ตาม/พระดำรัส/ซึ่ง/กาด/ได้/กล่าว/ไว้/ใน/พระนาม/ของ/พระยาห์เวห์<verse eid="1CH 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 21:20" />ขณะ/อาราวนาห์/กำลัง/นวด/ข้าว/สาลี/อยู่ เขา/เหลียว/มา/เห็น/ทูตสวรรค์ บุตร/ชาย/สี่/คน/ของเขา/ที่/อยู่/ด้วย/ก็/วิ่ง/หนีไป/ซ่อนตัว <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" />แล้ว/อาราวนาห์/เห็น/ดาวิด/เดิน/เข้ามา/หา จึง/วิ่ง/จาก/ลาน/นวด/ข้าว/มา/กราบ/ซบหน้า/ลง/ถึง/ดิน/ต่อหน้า/ดาวิด<verse eid="1CH 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22" />ดาวิด/ตรัส/กับ/อาราวนาห์/ว่า “เรา/ขอ/ซื้อ/ลาน/นวด/ข้าว/แห่งนี้/จาก/เจ้า/เต็ม/ราคา แล้ว/เรา/จะ/สร้าง/แท่นบูชา/ถวาย/แด่/<char style="nd">องค์/พระผู้เป็นเจ้า</char> พระองค์/จะ/ได้/ทรง/ระงับ/โรคระบาด/ครั้งนี้”<verse eid="1CH 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23" />อาราวนาห์/ทูล/ดาวิด/ว่า “ข้าแต่/องค์/กษัตริย์ ขอ/ฝ่าพระบาท/ทรงรับ/ไปเถิด จะ/ใช้/ทำ/สิ่งใด/ก็/ตามแต่/จะ/โปรด ขอ/ทรงรับ/วัว/ไป/เป็น/เครื่อง/เผา/บูชา เลื่อน/นวด/ข้าว/สามารถ/ใช้/เป็น/ฟืน และ/ข้าวสาลี/สำหรับ/เป็น/เครื่อง/ธัญ/บูชา ข้าพระบาท/ขอ/ถวาย/ทั้งหมด/นี้”<verse eid="1CH 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24" />แต่/กษัตริย์/ดาวิด/ตรัส/ตอบ/อาราวนาห์/ว่า “เรา/ยืนยัน/ที่/จะ/ซื้อ/เต็ม/ราคา เรา/ไม่อาจ/รับ/สิ่ง/ที่/เป็น/ของเจ้า/ไป/ถวาย/แด่/<char style="nd">องค์/พระผู้เป็นเจ้า</char> หรือ/จะ/ถวาย/เครื่อง/เผา/บูชา/โดย/ไม่/ลงทุน/อะไรเลย”<verse eid="1CH 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25" />ดาวิด/จึง/ทรง/จ่าย/ทองคำ/หนัก/ประมาณ 7 กิโลกรัม<note caller="+" style="f"><char style="fr" closed="false">21:25 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">600 เชเขล</char></note> ให้แก่/อาราวนาห์/เป็น/ค่า/ที่ดิน <verse eid="1CH 21:25" /><verse number="26" style="v" sid="1CH 21:26" />แล้ว/ดาวิด/สร้าง/แท่นบูชา/ขึ้น/ที่นั่น/ถวาย/แด่/<char style="nd">องค์/พระผู้เป็นเจ้า</char> และ/ถวาย/เครื่อง/เผา/บูชา/กับ/เครื่อง/สันติ/บูชา/ด้วย ดาวิด/ร้อง/ทูล/<char style="nd">องค์/พระผู้เป็นเจ้า</char><char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรง/ตอบ/โดย/ให้/ไฟ/จาก/ฟ้าสวรรค์/มา/เผา/เครื่อง/บูชา/บน/แท่น/นั้น<verse eid="1CH 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27" />แล้ว/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรง/บัญชา/ให้/ทูต/องค์นั้น/เก็บ/ดาบ/เข้า/ฝัก <verse eid="1CH 21:27" /><verse number="28" style="v" sid="1CH 21:28" />เมื่อ/ดาวิด/เห็นว่า/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรง/ตอบ/คำวิงวอน/ที่/ลาน/นวด/ข้าว/ของ/อาราวนาห์/ชาว/เยบุส ก็/ทรง/ถวาย/เครื่อง/บูชา/ที่นั่น/อีก <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" />พลับพลา/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/และ/แท่นบูชา/ซึ่ง/โมเสส/ได้/สร้าง/ขึ้น/ใน/ถิ่น/กันดาร/ยังคงอยู่/บน/สถาน/บูชา/บน/ที่สูง/ใน/กิเบโอน <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />แต่/ดาวิด/ไม่/สามารถ/เสด็จ/ไป/ทูลถาม/พระเจ้า/ที่นั่น เพราะ/กลัว/ดาบ/ของ/ทูต/ของ/องค์/พระผู้เป็นเจ้า<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1" />แล้ว/ดาวิด/ตรัส/ว่า “พระ/นิเวศ/ของ/พระเจ้า/พระยาห์เวห์/และ/แท่นบูชา/สำหรับ/เครื่อง/เผา/บูชา/ของ/อิสราเอล/จะ/อยู่/ที่นี่”<verse eid="1CH 22:1" /></para>
  <para style="s1">เตรียม/ก่อสร้าง/พระวิหาร</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />ดาวิด/จึง/ทรง/เกณฑ์/คน/ต่างด้าว/ที่อาศัย/ใน/อิสราเอล และ/มอบหมาย/ให้/เป็น/ช่าง/สกัดหิน เตรียม/หิน/สำหรับ/ก่อสร้าง/พระวิหาร/ของ/พระเจ้า <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" />ดาวิด/ทรงให้/เตรียม/เหล็ก/จำนวน/มาก เพื่อ/ทำ/หมุด/สำหรับ/ใช้/กับ/บานประตู/และ/เหล็ก/ยึด และ/หลอม/ทอง/สัมฤทธิ์ จำนวน/มหาศาล/เกินกว่า/จะ/ชั่งได้ <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" />ทั้ง/เตรียม/ซุง/ไม้สน/ซีดาร์/มากมาย/เกินกว่า/จะ/นับได้ ซึ่ง/ชาว/ไซดอน/และ/ชาว/ไทระ/ได้/นำ/มา/ถวาย/ดาวิด<verse eid="1CH 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 22:5" />ดาวิด/ตรัส/ว่า “โซโลมอน/ลูก/ของเรา/ยัง/เด็ก/และ/อ่อน/ประสบการณ์ พระ/นิเวศ/ซึ่ง/จะ/สร้าง/ขึ้น/เพื่อ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ควรจะ/งดงาม/โอ่อ่า/ตระการ มี/ชื่อเสียง/เลื่องลือ/ใน/สายตา/มวล/ประชาชาติ ฉะนั้น/เรา/จะ/ตระเตรียม/เพื่อ/การ/นี้” ดาวิด/จึง/ทรง/เตรียมการ/ไว้/อย่าง/เต็มที่/ก่อน/สิ้นพระชนม์<verse eid="1CH 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6" />แล้ว/ดาวิด/ตรัส/กำชับ/โซโลมอน/ราช/โอรส/ให้/สร้าง/พระ/นิเวศ/ถวาย/แด่/พระยาห์เวห์/พระเจ้า/ของ/อิสราเอล <verse eid="1CH 22:6" /><verse number="7" style="v" sid="1CH 22:7" />ดาวิด/ตรัส/ว่า “ลูกเอ๋ย ใจ/พ่อ/คิด/จะ/สร้าง/พระ/นิเวศ/เพื่อ/พระนาม/ของ/พระยาห์เวห์/พระเจ้า/ของ/พ่อ <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" />แต่/มี/พระ/ดำรัส/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/มาถึง/พ่อ/ว่า ‘เจ้า/ได้/ฆ่า/คน/มากมาย/ใน/สงคราม ทำให้/เลือด/นอง/แผ่นดิน/ใน/สายตา/ของเรา ฉะนั้น/เจ้า/จะ/ไม่ได้/เป็น/ผู้/สร้าง/นิเวศ/เพื่อ/นาม/ของเรา <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" />แต่/จะ/มี/ลูก/คน/หนึ่ง/ของเจ้า/เป็น/บุคคล/แห่ง/สันติ ซึ่ง/เรา/จะ/ให้/เขา/พัก/สงบ/จาก/ศัตรู/รอบด้าน ลูก/คนนี้/จะ/มี/ชื่อว่า โซโลมอน<note caller="+" style="f"><char style="fr" closed="false">22:9 </char><char style="ft" closed="false">คำ/ว่า/</char><char style="fqa" closed="false">โซโลมอน/</char><char style="ft" closed="false">มี/เสียง/คล้าย/และ/อาจ/มา/จาก/คำ/ภาษาฮีบรู/ที่/มี/ความหมาย/ว่า/</char><char style="fqa" closed="false">สันติสุข</char></note>และ/เรา/จะ/ให้/อิสราเอล/อยู่/เย็น/เป็น/สุข/ตลอด/รัชกาล/ของเขา <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" />เขา/คือ/ผู้/ที่/จะ/สร้าง/นิเวศ/เพื่อ/นาม/ของเรา เขา/จะ/เป็น/บุตร/ของเรา และ/เรา/จะ/เป็น/บิดา/ของเขา และ/จะ/สถาปนา/ราชบัลลังก์/ของเขา/เหนือ/อิสราเอล/ตลอดไป’<verse eid="1CH 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11" />“บัดนี้ ลูกเอ๋ย ขอให้/<char style="nd">องค์พระผู้เป็นเจ้า</char>/สถิต/กับ/เจ้า ให้/เจ้า/ประสบ/ความ/สำเร็จ และ/สร้าง/พระ/นิเวศ/สำหรับ/พระยาห์เวห์/พระเจ้า/ของเจ้า/ดัง/ที่/พระองค์/ตรัส/ไว้/แล้ว <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" />ขอ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ประทาน/ความสุขุม/รอบคอบ/กับ/ความ/เข้าใจ/แก่/เจ้า เมื่อ/ทรง/ตั้ง/เจ้า/ขึ้น/ปกครอง/อิสราเอล เพื่อ/เจ้า/จะ/รักษา/บทบัญญัติ/ของ/พระยาห์เวห์/พระเจ้า/ของเจ้า <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" />หาก/เจ้า/ใส่ใจ/ปฏิบัติ/ตาม/กฎหมาย/และ/บทบัญญัติ/ซึ่ง/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ประทาน/แก่/โมเสส/สำหรับ/อิสราเอล เจ้า/ก็/จะ/ประสบ/ความ/สำเร็จ จง/เข้มแข็ง/และ/กล้าหาญ/เถิด อย่า/กลัว/หรือ/อย่าท้อแท้<verse eid="1CH 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14" />“พ่อ/เพียร/สะสม/เพื่อ/พระวิหาร/ของ/<char style="nd">องค์/พระผู้เป็นเจ้า</char> ได้/ทองคำ/หนัก/ประมาณ 3,450 ตัน<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">100,000 ตะลันต์</char></note> เงิน/หนัก/ประมาณ 34,500 ตัน<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">1,000,000 ตะลันต์</char></note> เหล็ก/กับ/ทอง/สัมฤทธิ์/จำนวน/มหาศาล/เกินกว่า/จะ/ชั่ง/ได้ พร้อมทั้ง/ซุง/กับ/หิน เจ้า/อาจ/หา/เพิ่มเติม/อีก/ก็/ได้ <verse eid="1CH 22:14" /><verse number="15" style="v" sid="1CH 22:15" />เจ้า/มี/คนงาน/มากมาย/ทั้ง/ช่าง/สกัด/หิน ช่าง/ก่อ ช่างไม้ ช่างฝีมือ/ทุก/ประเภท <verse eid="1CH 22:15" /><verse number="16" style="v" sid="1CH 22:16" />ผู้/ชำนาญ/งาน/ทอง เงิน ทอง/สัมฤทธิ์ และ/เหล็ก บัดนี้/จง/เริ่ม/งาน ขอให้/<char style="nd">องค์พระผู้เป็นเจ้า</char>/สถิต/กับ/ลูก”<verse eid="1CH 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17" />แล้ว/ดาวิด/บัญชา/ให้/บรรดา/ผู้/นำ/อิสราเอล/ช่วยเหลือ/โซโลมอน/ราช/โอรส/ของ/พระองค์ <verse eid="1CH 22:17" /><verse number="18" style="v" sid="1CH 22:18" />ดาวิด/ตรัส/กับ/พวกเขา/ว่า “พระยาห์เวห์/พระเจ้า/ของ/ท่าน/สถิต/กับ/ท่าน/ไม่ใช่หรือ? และ/ทรง/โปรด/ประทาน/ความสงบ/รอบด้าน/แก่/พวก/ท่าน/ไม่ใช่หรือ? เพราะ/ทรงให้/ชนชาติ/ทั้งหลาย/ที่/อยู่/ใน/ดินแดน/นี้/ก่อน/เรา/พ่ายแพ้/เรา และ/ดินแดน/นี้/ก็/ขึ้น/ต่อ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/และ/ต่อ/ประชากร/ของ/พระองค์ <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" />บัดนี้/จง/ทุ่มเท/จิตใจ/และ/จิตวิญญาณ/แสวงหา/พระยาห์เวห์/พระเจ้า/ของ/ท่าน จง/เริ่ม/สร้าง/สถาน/นมัสการ/ของ/พระเจ้า/พระยาห์เวห์ เพื่อ/ท่าน/จะ/นำ/หีบ/พันธสัญญา/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/และ/เครื่องใช้/อัน/บริสุทธิ์/ต่างๆ เข้าสู่/พระวิหาร ซึ่ง/จะ/สร้าง/ขึ้น/เพื่อ/พระนาม/ของ/พระยาห์เวห์”<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="s1">คน/เลวี</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />เมื่อ/ดาวิด/ทรง/ชรา/มาก/แล้ว ก็/ตั้ง/โซโลมอน/ราช/โอรส/ขึ้น/เป็น/กษัตริย์/ปกครอง/อิสราเอล<verse eid="1CH 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2" />ดาวิด/ทรงเรียก/ผู้/นำ/ทั้งปวง/ของ/อิสราเอล/มา/รวม/กัน รวมทั้ง/ปุโรหิต/และ/คน/เลวี <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" />มี/การ/นับ/จำนวน/คน/เลวี/ที่/มี/อายุ/สามสิบ/ปี/ขึ้นไป รวม/ทั้งสิ้น 38,000 คน <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" />ดาวิด/ตรัส/ว่า “ให้ 24,000 คน/ดูแล/งาน/ที่/พระวิหาร/ของ/<char style="nd">องค์/พระผู้เป็นเจ้า</char> อีก 6,000 คน/เป็น/เจ้าหน้าที่/และ/ตุลาการ <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" />อีก 4,000 คน/เป็น/ยาม/เฝ้า/ประตู/พระวิหาร และ/อีก 4,000 คน/สรรเสริญ/<char style="nd">องค์/พระผู้เป็นเจ้า</char> พร้อมกับ/บรรเลง/เครื่อง/ดนตรี/ต่างๆ ที่/เรา/เตรียมไว้”<verse eid="1CH 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 23:6" />ดาวิด/ทรง/แบ่ง/คน/เลวี/เป็น/สาม/กลุ่ม/ใหญ่/ตาม/ชื่อ/บุตร/ของ/เลวี/ได้แก่ ตระกูล/เกอร์โชน ตระกูล/โคฮาท และ/ตระกูล/เมรารี<verse eid="1CH 23:6" /></para>
  <para style="s1">ตระกูล/เกอร์โชน</para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 23:7" />จาก/ตระกูล/เกอร์โชน ได้แก่</para>
  <para style="li1" vid="1CH 23:7">ลาดาน/กับ/ชิเมอี<verse eid="1CH 23:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 23:8" />บุตร/ของ/ลาดาน ได้แก่</para>
  <para style="li1" vid="1CH 23:8">เยฮีเอล/ผู้/เป็น/หัวหน้า เศธาม และ/โยเอล รวม/สามคน<verse eid="1CH 23:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 23:9" />บุตร/ของ/ชิเมอี ได้แก่</para>
  <para style="li1" vid="1CH 23:9">เชโลโมท ฮาซีเอล และ/ฮาราน รวม/สามคน</para>
  <para style="li1" vid="1CH 23:9">คน/เหล่านี้/เป็น/หัวหน้า/ครอบครัว/ของ/เชื้อสาย/ลาดาน<verse eid="1CH 23:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 23:10" />บุตร/ของ/ชิเมอี ได้แก่</para>
  <para style="li1" vid="1CH 23:10">ยาหาท ศีซา<note caller="+" style="f"><char style="fr" closed="false">23:10 </char><char style="ft" closed="false">สำเนา/ต้นฉบับ/ภาษาฮีบรู/ส่วนใหญ่/ว่า/</char><char style="fqa" closed="false">ศีนา/</char><char style="ft" closed="false">เช่น/เดียว/กับ/ข้อ 11</char></note> เยอูช และ/เบรียาห์</para>
  <para style="li1" vid="1CH 23:10">คน/เหล่านี้/คือ/บุตร/ของ/ชิเมอี รวม/สี่/คน<verse eid="1CH 23:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 23:11" />ยาหาท/เป็น/หัวหน้า คน/ที่สอง/คือ/ศีซา ส่วน/เยอูช/และ/เบรียาห์/มี/บุตร/ชาย/ไม่/กี่/คน จึง/นับเป็น/ครอบครัว/เดียวกัน ได้รับ/มอบหมาย/งาน/เดียวกัน<verse eid="1CH 23:11" /></para>
  <para style="s1">ตระกูล/โคฮาท</para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 23:12" />บุตร/ของ/โคฮาท ได้แก่</para>
  <para style="li1" vid="1CH 23:12">อัมราม อิสฮาร์ เฮโบรน และ/อุสซีเอล รวม/สี่/คน<verse eid="1CH 23:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 23:13" />บุตร/ของ/อัมราม ได้แก่</para>
  <para style="li1" vid="1CH 23:13">อาโรน/กับ/โมเสส</para>
  <para style="li1" vid="1CH 23:13">อาโรน/และ/ลูกหลาน/ตลอด/ทุก/ชั่วอายุ/ถูก/แยก/ไว้/เพื่อ/ชำระ/สิ่ง/ที่/บริสุทธิ์/ที่สุด เพื่อ/ถวาย/เครื่อง/บูชา/แด่/<char style="nd">องค์/พระผู้เป็นเจ้า</char> เพื่อ/รับใช้/อยู่/ต่อหน้า/พระองค์/และ/เพื่อ/กล่าว/อำนวยพร/ใน/พระนาม/ของ/พระองค์/ตลอดไป <verse eid="1CH 23:13" /><verse number="14" style="v" sid="1CH 23:14" />วงศ์วาน/ของ/โมเสส/ซึ่งเป็น/คน/ของ/พระเจ้า/นับรวม/เข้า/กับ/เผ่าเลวี<verse eid="1CH 23:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 23:15" />บุตร/ของ/โมเสส ได้แก่</para>
  <para style="li1" vid="1CH 23:15">เกอร์โชม/กับ/เอลีเอเซอร์<verse eid="1CH 23:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 23:16" />วงศ์วาน/ของ/เกอร์โชม ได้แก่</para>
  <para style="li1" vid="1CH 23:16">ชูบาเอล/ผู้/เป็น/หัวหน้า<verse eid="1CH 23:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 23:17" />ส่วน/เอลีเอเซอร์</para>
  <para style="li1" vid="1CH 23:17">มี/บุตร/ชายคน/เดียว/คือ/เรหับยาห์/ผู้/เป็น/หัวหน้า แต่/เรหับยาห์/มี/บุตร/หลาน/มากมาย<verse eid="1CH 23:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 23:18" />บุตร/ของ/อิสฮาร์ ได้แก่</para>
  <para style="li1" vid="1CH 23:18">เชโลมิท/ผู้/เป็น/หัวหน้า<verse eid="1CH 23:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 23:19" />บุตร/ของ/เฮโบรน ได้แก่</para>
  <para style="li1" vid="1CH 23:19">เยรียาห์/ผู้/เป็น/หัวหน้า คน/ที่สอง/คือ/อามาริยาห์</para>
  <para style="li1" vid="1CH 23:19">คน/ที่สาม/คือ/ยาฮาซีเอล และ/คน/ที่สี่/คือ/เยคาเมอัม<verse eid="1CH 23:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 23:20" />บุตร/ของ/อุสซีเอล ได้แก่</para>
  <para style="li1" vid="1CH 23:20">มีคาห์/ผู้/เป็น/หัวหน้า และ/คน/ที่สอง/คือ/อิสชีอาห์<verse eid="1CH 23:20" /></para>
  <para style="s1">ตระกูล/เมรารี</para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 23:21" />บุตร/ของ/เมรารี ได้แก่</para>
  <para style="li1" vid="1CH 23:21">มาห์ลี/กับ/มูชี</para>
  <para style="li1" vid="1CH 23:21">บุตร/ของ/มาห์ลี ได้แก่</para>
  <para style="li1" vid="1CH 23:21">เอเลอาซาร์/กับ/คีช<verse eid="1CH 23:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 23:22" />เอเลอาซาร์/สิ้นชีวิต/โดย/ไม่มี/บุตร/ชาย/สืบสกุล มี/แต่/บุตร/สาว/ซึ่ง/ก็/ได้/แต่งงาน/กับ/ลูก/พี่/ลูก/น้อง/คือ/บุตรชาย/ของ/คีช<verse eid="1CH 23:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 23:23" />บุตร/ของ/มูชี ได้แก่</para>
  <para style="li1" vid="1CH 23:23">มาห์ลี เอเดอร์ และ/เยรีโมท รวม/สามคน<verse eid="1CH 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 23:24" />คน/เหล่านี้/คือ/วงศ์วาน/ของ/เลวี/ตาม/ครอบครัว/ที่/ได้/ขึ้น/ทะเบียน/ไว้/ตาม/ชื่อ/ของ/หัวหน้า/ครอบครัว ชาย/ชาวเลวี/ที่/อายุ/ยี่สิบ/ปี/ขึ้นไป/ที่/กล่าว/มา/นี้ ทุกคน/มี/หน้าที่/ปฏิบัติ/งาน/ใน/พระวิหาร/ของ/<char style="nd">องค์/พระผู้เป็นเจ้า</char> <verse eid="1CH 23:24" /><verse number="25" style="v" sid="1CH 23:25" />เพราะ/ดาวิด/ตรัส/ไว้/ว่า “พระยาห์เวห์/พระเจ้า/แห่ง/อิสราเอล/ทรง/โปรด/ให้/เหล่า/ประชากร/ได้พัก/สงบ และ/พระองค์/จะ/ประทับ/อยู่/ใน/กรุง/เยรูซาเล็ม/ตลอดไป/เป็น/นิตย์ <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" />คน/เลวี/จึง/ไม่/จำเป็น/ต้อง/แบกหาม/พลับพลา/และ/เครื่องใช้/ต่างๆ โยกย้าย/ไป/มา/อีก/ต่อไป” <verse eid="1CH 23:26" /><verse number="27" style="v" sid="1CH 23:27" />มี/การ/นับ/จำนวน/คน/เลวี/ที่/อายุ/ยี่สิบ/ปี/ขึ้นไป/ตาม/คำสั่ง/ล่าสุด/ของ/ดาวิด<verse eid="1CH 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 23:28" />งาน/ของ/คน/เลวี/คือ/ช่วยเหลือ/วงศ์วาน/ของ/อาโรน/ใน/การปฏิบัติ/หน้าที่/ใน/พระวิหาร/ของ/<char style="nd">องค์/พระผู้เป็นเจ้า</char> ทั้ง/ดูแล/ลาน/พระวิหาร/และ/ห้อง/ต่างๆ ที่/อยู่/ด้านข้าง ชำระ/สิ่ง/ที่/บริสุทธิ์/ศักดิ์สิทธิ์/ทั้งปวง/และ/ทำ/หน้าที่/อื่นๆ ใน/พระ/นิเวศ/ของ/พระเจ้า <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" />พวกเขา/รับผิดชอบ/การจัด/ขนมปัง/เบื้อง/พระพักตร์ แป้ง/ละเอียด/สำหรับ/เครื่อง/ธัญ/บูชา ขนมปัง/ไม่/ใส่/เชื้อ การอบ/ปิ้ง/และ/การผสม ตลอดจน/การชั่ง/ตวง/วัด <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />และ/ทุกเช้า/ทุก/เย็น/จะ/ยืน/ร้องเพลง/ขอบพระคุณ/และ/สรรเสริญ/<char style="nd">องค์/พระผู้เป็นเจ้า</char> <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" />ทุก/ครั้ง/ที่/มี/การถวาย/เครื่อง/เผา/บูชา/แด่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ใน/วัน/สะบาโต งานฉลอง/วัน/ขึ้น/หนึ่ง/ค่ำ และ/เทศกาล/ตาม/กำหนด พวกเขา/จะ/ปรนนิบัติ/รับใช้/อยู่/ต่อหน้า/<char style="nd">องค์พระผู้เป็นเจ้า</char>/สม่ำเสมอ/ครบ/จำนวน/และ/ทำ/งาน/ตามที่/ได้/กำหนด/ไว้<verse eid="1CH 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 23:32" />คน/เลวี/จึง/ปฏิบัติ/หน้าที่/รับผิดชอบ/สำหรับ/เต็นท์/นัดพบ วิสุทธิสถาน/และ/งาน/ต่างๆ ใน/พระวิหาร/ของ/<char style="nd">องค์/พระผู้เป็นเจ้า</char> ภายใต้/การบังคับ/บัญชา/ของ/พี่น้อง/วงศ์วาน/อาโรน<verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="s1">การแบ่ง/หน้าที่/ของ/ปุโรหิต</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />วงศ์วาน/ของ/อาโรน/แบ่ง/ตาม/หมู่/เหล่า/ได้/ดังนี้</para>
  <para style="p" vid="1CH 24:1">บุตร/ของ/อาโรน ได้แก่ นาดับ อาบีฮู เอเลอาซาร์ และ/อิธามาร์ <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" />แต่/นาดับ/กับ/อาบีฮู/เสียชีวิต/ก่อน/บิดา/โดย/ไม่มี/บุตร/ชาย เอเลอาซาร์/กับ/อิธามาร์/จึง/ทำหน้าที่/ปุโรหิต <verse eid="1CH 24:2" /><verse number="3" style="v" sid="1CH 24:3" />ดาวิด/ทรง/แยก/วงศ์วาน/ของ/อาโรน/เป็น/กลุ่มๆ เพื่อ/แบ่ง/หน้าที่/ปฏิบัติ/งาน/โดย/มี/ศาโดก/วงศ์วาน/ของ/เอเลอาซาร์/และ/อาหิเมเลค/วงศ์วาน/ของ/อิธามาร์/คอย/ช่วยเหลือ/พระองค์ <verse eid="1CH 24:3" /><verse number="4" style="v" sid="1CH 24:4" />วงศ์วาน/ของ/เอเลอาซาร์/แยก/เป็น/สิบหก/กลุ่ม และ/อิธามาร์/แยก/เป็น/แปด/กลุ่ม ตาม/จำนวน/หัวหน้า/ครอบครัว/เพราะ/ใน/กลุ่ม/วงศ์วาน/ของ/เอเลอาซาร์/มี/ผู้/นำมา/กก/ว่า <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />การแบ่ง/งาน/ใช้/วิธี/ทอด/สลาก/เพื่อ/ไม่ให้/เกิด/ความลำเอียง จะ/ได้/มี/เจ้าหน้าที่/ประจำ/สถาน/นมัสการ และ/เจ้าหน้าที่/ของ/พระเจ้า/จาก/วงศ์วาน/ทั้ง/ของ/เอเลอาซาร์/และ/ของ/อิธามาร์<verse eid="1CH 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6" />อาลักษณ์/เชไมอาห์/บุตร/ของ/เนธันเอล/ชาวเลวี/บันทึก/รายชื่อ/ของ/พวกเขา/ต่อหน้า/กษัตริย์ และ/ต่อหน้า/เจ้า/หน้าที่/ทั้งหลาย ได้แก่ ปุโรหิต/ศาโดก อาหิเมเลค/บุตร/อาบียาธาร์ และ/หัวหน้า/ครอบครัว/ของ/ปุโรหิต/และ/ของ/คน/เลวี ทอด/สลาก/มอบหมาย/งาน/ให้/กลุ่ม/หนึ่ง/จาก/สาย/เอเลอาซาร์ แล้ว/อีก/กลุ่ม/หนึ่ง/จาก/สาย/อิธามาร์/สลับ/กัน/ไป<verse eid="1CH 24:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 24:7" />สลาก/แรก/สุด/ได้แก่ เยโฮยาริบ</para>
  <para style="li1" vid="1CH 24:7">ที่/สอง/คือ/เยดายาห์<verse eid="1CH 24:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 24:8" />ที่สาม/คือ/ฮาริม</para>
  <para style="li1" vid="1CH 24:8">ที่/สี่/คือ/เสโอริม<verse eid="1CH 24:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 24:9" />ที่/ห้า/คือ/มัลคิยาห์</para>
  <para style="li1" vid="1CH 24:9">ที่/หก/คือ/มิยามิน<verse eid="1CH 24:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 24:10" />ที่/เจ็ด/คือ/ฮักโขส</para>
  <para style="li1" vid="1CH 24:10">ที่/แปด/คือ/อาบียาห์<verse eid="1CH 24:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 24:11" />ที่/เก้า/คือ/เยชูอา</para>
  <para style="li1" vid="1CH 24:11">ที่/สิบ/คือ/เชคานิยาห์<verse eid="1CH 24:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 24:12" />ที่/สิบเอ็ด/คือ/เอลียาชีบ</para>
  <para style="li1" vid="1CH 24:12">ที่/สิบสอง/คือ/ยาคิม<verse eid="1CH 24:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 24:13" />ที่/สิบสาม/คือ/หุปปาห์</para>
  <para style="li1" vid="1CH 24:13">ที่/สิบสี่/คือ/เยเชเบอับ<verse eid="1CH 24:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 24:14" />ที่/สิบห้า/คือ/บิลกาห์</para>
  <para style="li1" vid="1CH 24:14">ที่/สิบหก/คือ/อิมเมอร์<verse eid="1CH 24:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 24:15" />ที่/สิบเจ็ด/คือ/เฮซีร์</para>
  <para style="li1" vid="1CH 24:15">ที่/สิบแปด/คือ/ฮัปปิสเซส<verse eid="1CH 24:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 24:16" />ที่/สิบเก้า/คือ/เปธาหิยาห์</para>
  <para style="li1" vid="1CH 24:16">ที่/ยี่สิบ/คือ/เยเฮสเคล<verse eid="1CH 24:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 24:17" />ที่/ยี่สิบเอ็ด/คือ/ยาคีน</para>
  <para style="li1" vid="1CH 24:17">ที่/ยี่สิบสอง/คือ/กามูล<verse eid="1CH 24:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 24:18" />ที่/ยี่สิบสาม/คือ/เดไลยาห์</para>
  <para style="li1" vid="1CH 24:18">และ/ที่/ยี่สิบสี่/คือ/มาอาซิยาห์<verse eid="1CH 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19" />นี่คือ/ลำดับ/ปฏิบัติ/งาน/เมื่อ/พวกเขา/เข้า/สู่/พระวิหาร/ของ/<char style="nd">องค์/พระผู้เป็นเจ้า</char> ตาม/กฎ/เกณฑ์/ที่/อาโรน/บรรพบุรุษ/วางไว้ ตามที่/พระยาห์เวห์/พระเจ้า/แห่ง/อิสราเอล/ทรง/บัญชา/อาโรน<verse eid="1CH 24:19" /></para>
  <para style="s1">วงศ์วาน/อื่นๆ ของ/เลวี</para>
  <para style="m">
    <verse number="20" style="v" sid="1CH 24:20" />สำหรับ/วงศ์วาน/อื่นๆ ของ/เลวี/มี/ดังนี้</para>
  <para style="li1" vid="1CH 24:20">จาก/บุตร/ของ/อัมราม/คือ/ชูบาเอล</para>
  <para style="li1" vid="1CH 24:20">จาก/บุตร/ของ/ชูบาเอล/คือ/เยเดยาห์<verse eid="1CH 24:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 24:21" />ส่วน/เรหับยาห์ จาก/บุตร/ของเขา/คือ</para>
  <para style="li1" vid="1CH 24:21">อิสชีอาห์/ผู้/เป็น/หัวหน้า<verse eid="1CH 24:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 24:22" />จาก/สาย/อิสฮาร์/คือ/เชโลโมท</para>
  <para style="li1" vid="1CH 24:22">จาก/บุตร/เชโลโมท/คือ/ยาหาท<verse eid="1CH 24:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 24:23" />บุตร/ของ/เฮโบรน/ได้แก่</para>
  <para style="li1" vid="1CH 24:23">เยรียาห์/ผู้/เป็น/หัวหน้า<note caller="+" style="f"><char style="fr" closed="false">24:23 </char><char style="ft" closed="false">สำเนา/ต้นฉบับ/ภาษาฮีบรู/ส่วนใหญ่/ว่า/</char><char style="fqa" closed="false">บุตร/ทั้งหลาย/ของ/เยรียาห์/</char><char style="ft" closed="false">(<char style="xt">ดู <ref loc="1CH 23:19">23:19</ref></char>)</char></note> คน/ที่สอง/คือ/อามาริยาห์ คน/ที่สาม/คือ/ยาฮาซีเอล และ/คน/ที่สี่/คือ/เยคาเมอัม<verse eid="1CH 24:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 24:24" />บุตร/ของ/อุสซีเอล/คือ/มีคาห์</para>
  <para style="li1" vid="1CH 24:24">จาก/บุตร/ของ/มีคาห์/คือ/ชามีร์<verse eid="1CH 24:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 24:25" />น้อง/ของ/มีคาห์/คือ/อิสชีอาห์ จาก/บุตร/ของ/อิสชีอาห์/คือ/เศคาริยาห์<verse eid="1CH 24:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 24:26" />บุตร/ของ/เมรารี/คือ/มาห์ลี/กับ/มูชี</para>
  <para style="li1" vid="1CH 24:26">บุตร/ของ/ยาอาซียาห์/คือ/เบโน<verse eid="1CH 24:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 24:27" />เชื้อสาย/เมรารี ได้แก่</para>
  <para style="li1" vid="1CH 24:27">จาก/ยาอาซียาห์/คือ เบโน โชฮัม</para>
  <para style="li1" vid="1CH 24:27">ศักเกอร์ และ/อิบรี<verse eid="1CH 24:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 24:28" />จาก/มาห์ลี/คือ/เอเลอาซาร์/ซึ่ง/ไม่มี/บุตร<verse eid="1CH 24:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 24:29" />จาก/คีช/คือ เยราห์เมเอล/บุตร/ของ/คีช<verse eid="1CH 24:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 24:30" />บุตร/ของ/มูชี/ได้แก่ มาห์ลี เอเดอร์ และ/เยรีโมท</para>
  <para style="p" vid="1CH 24:30">คน/เหล่านี้/คือ/ชน/เลวี/ตาม/ครอบครัว/ของ/พวกเขา <verse eid="1CH 24:30" /><verse number="31" style="v" sid="1CH 24:31" />พวกเขา/ได้/รับ/มอบหมาย/หน้าที่/ต่างๆ โดย/การ/ทอด/สลาก/เช่น/เดียว/กับ/วงศ์วาน/ของ/อาโรน ไม่มี/การ/จำแนก/วัย/หรือ/ระดับ/รุ่น การ/แบ่ง/หน้าที่/โดย/การ/ทอด/สลาก/นี้/กระทำ/ต่อหน้า/กษัตริย์/ดาวิด/และ/ต่อหน้า/ศาโดก อาหิเมเลค กับ/บรรดา/หัวหน้า/ครอบครัว/ของ/ปุโรหิต/และ/ของ/ชน/เลวี<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s1">นักร้อง</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />ดาวิด/และ/บรรดา/แม่ทัพ/นายกอง/ได้/แยก/บางคน/จาก/กลุ่ม/บุตร/ของ/อาสาฟ เฮมาน และ/เยดูธูน มา/ทำ/หน้าที่/เผย/พระวจนะ/คลอ/ด้วย/เสียงพิณ/ใหญ่ พิณเขาคู่ และ/ฉาบ รายชื่อ/ต่อไปนี้/คือ/ผู้/ที่/ทำ/หน้าที่/ดังกล่าว<verse eid="1CH 25:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 25:2" />จาก/บุตร/ของ/อาสาฟ ได้แก่</para>
  <para style="li1" vid="1CH 25:2">ศักเกอร์ โยเซฟ เนธานิยาห์ และ/อาสาเรลาห์ บุตร/เหล่านี้/อยู่/ภายใต้/การดูแล/ของ/อาสาฟ ซึ่ง/อาสาฟ/เผย/พระวจนะ/ภายใต้/การดูแล/ของ/กษัตริย์<verse eid="1CH 25:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 25:3" />จาก/บุตร/ของ/เยดูธูน ได้แก่</para>
  <para style="li1" vid="1CH 25:3">เกดาลิยาห์ เศรี เยชายาห์ ชิเมอี<note caller="+" style="f"><char style="fr" closed="false">25:3 </char><char style="ft" closed="false">สำเนา/ต้นฉบับ/ภาษาฮีบรู/ส่วนใหญ่/ไม่มี/คำ/ว่า/</char><char style="fqa" closed="false">ชิเมอี/</char><char style="ft" closed="false">เช่น/เดียว/กับ/ข้อ 17</char></note> ฮาชาบิยาห์/และ/มัททีธิยาห์ รวม/ทั้งหมด/หกคน อยู่/ภายใต้/การนำ/ของ/เยดูธูน/บิดา/ของ/พวกเขา ซึ่ง/เผย/พระวจนะ/โดย/บรรเลง/พิณ/ขอบพระคุณ/และ/สรรเสริญ/<char style="nd">องค์/พระผู้เป็นเจ้า</char><verse eid="1CH 25:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 25:4" />จาก/บุตร/ของ/เฮมาน ได้แก่</para>
  <para style="li1" vid="1CH 25:4">บุคคี/ยาห์ มัททานิยาห์ อุสซีเอล ชูบาเอล เยรีโมท ฮานานิยาห์ ฮานานี เอลียาธาห์ กิดดาลที และ/โรมัมทีเอเซอร์ โยชเบคาชาห์ มัลโลธี โฮธีร์ และ/มาหะซิโอท <verse eid="1CH 25:4" /><verse number="5" style="v" sid="1CH 25:5" />ทั้งหมด/นี้/คือ/บุตร/ของ/เฮมาน/ผู้/ทำนาย/ของ/กษัตริย์ พระเจ้า/ประทาน/บุตร/เหล่านี้/ให้แก่/เขา/ตาม/พระ/สัญญา/เพื่อ/ยกย่อง/เชิดชู/พระองค์ พระเจ้า/ประทาน/ให้/เฮมาน/มี/บุตร/ชาย/สิบสี่/คน/และ/บุตร/สาว/สามคน<verse eid="1CH 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 25:6" />คน/เหล่านี้/มี/หน้าที่/ตีฉาบ บรรเลง/พิณใหญ่/และ/พิณ/เขา/คู่/เพื่อ/ปรนนิบัติ/ใน/พระ/นิเวศ/ของ/<char style="nd">องค์/พระผู้เป็นเจ้า</char> ภายใต้/การ/ควบคุม/วง/โดย/บิดา/ของเขา ทั้ง/อาสาฟ เยดูธูน และ/เฮมาน/ขึ้น/ตรง/ต่อ/กษัตริย์ <verse eid="1CH 25:6" /><verse number="7" style="v" sid="1CH 25:7" />เขา/ทั้ง/สาม/และ/ญาติ/พี่น้อง/ได้รับ/การ/ฝึกฝน/จน/เชี่ยวชาญ/ใน/ด้าน/ดนตรี/เพื่อ/<char style="nd">องค์/พระผู้เป็นเจ้า</char> รวม/ทั้งสิ้น 288 คน <verse eid="1CH 25:7" /><verse number="8" style="v" sid="1CH 25:8" />ต่าง/ได้รับ/มอบหมาย/ใน/หน้าที่/ตาม/การ/ทอด/สลาก/อย่าง/เท่าเทียม/กัน ไม่ว่า/หนุ่ม/หรือ/แก่ ไม่/คำนึง/ว่า/เป็น/ครู/หรือ/ศิษย์<verse eid="1CH 25:8" /></para>
  <para style="b" />
  <table>
    <row style="tr">
