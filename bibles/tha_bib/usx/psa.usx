  <chapter eid="PSA 105" />
  <chapter number="106" style="c" sid="PSA 106" />
  <para style="cl">สดุดี 106</para>
  <para style="r">(<ref loc="1CH 16:34-36">1พศด.16:34-36</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1" />จง/สรรเสริญ/<char style="nd">องค์/พระผู้เป็นเจ้า</char><note caller="+" style="f"><char style="fr" closed="false">106:1 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">ฮาเลลูยา/</char><char style="ft" closed="false">เช่น/เดียว/กับ/ข้อ 48</char></note></para>
  <para style="b" vid="PSA 106:1" />
  <para style="q1" vid="PSA 106:1">จง/ขอบพระคุณ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/เพราะ/พระองค์/ทรงแสนดี</para>
  <para style="q1" vid="PSA 106:1">ความรัก/มั่นคง/ของ/พระองค์/ดำรง/นิรันดร์<verse eid="PSA 106:1" /></para>
