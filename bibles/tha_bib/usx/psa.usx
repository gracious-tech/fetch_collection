  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12" />พวกเขา/รายล้อม/ข้าพเจ้า/เหมือน/ฝูงผึ้ง</para>
  <para style="q1" vid="PSA 118:12">แต่/เขา/มอด/ดับลง/อย่าง/รวดเร็ว/เหมือน/ไฟ/ไหม้/หนาม</para>
  <para style="q1" vid="PSA 118:12">ใน/พระนาม/ของ/พระยาห์เวห์ ข้าพเจ้า/จะ/ทำลาย/พวกเขา/ให้/สิ้น<verse eid="PSA 118:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13" />ข้าพเจ้า/ถูก/รุม/กระหน่ำ/จะ/ล้มลง/อยู่/แล้ว</para>
  <para style="q1" vid="PSA 118:13">แต่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรง/ช่วย/ข้าพเจ้า<verse eid="PSA 118:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14" />
    <char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรงเป็น/กำลัง/และ/เป็น/บทเพลง/ของ/ข้าพเจ้า</para>
  <para style="q1" vid="PSA 118:14">พระองค์/ทรงเป็น/ความรอด/ของ/ข้าพเจ้า<verse eid="PSA 118:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15" />เสียง/โห่ร้อง/ยินดี/และ/เสียง/ไชโย</para>
  <para style="q1" vid="PSA 118:15">ดังก้อง/ใน/เต็นท์/ของ/คน/ชอบธรรม</para>
  <para style="q1" vid="PSA 118:15">ว่า “พระหัตถ์/ขวา/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ได้/กระทำ/สิ่ง/ที่/ยิ่งใหญ่!<verse eid="PSA 118:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 118:16" />พระหัตถ์/ขวา/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ชูขึ้น/สูง</para>
  <para style="q1" vid="PSA 118:16">พระหัตถ์/ขวา/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ได้/กระทำ/สิ่ง/ที่/ยิ่งใหญ่!”<verse eid="PSA 118:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17" />ข้าพเจ้า/จะ/ไม่ตาย แต่/มี/ชีวิต/อยู่</para>
  <para style="q1" vid="PSA 118:17">และ/จะ/ประกาศ/พระ/ราชกิจ/ของ/องค์/พระผู้เป็นเจ้า<verse eid="PSA 118:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18" />
    <char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรง/ตีสอน/ข้าพเจ้า/อย่างหนัก</para>
  <para style="q1" vid="PSA 118:18">แต่/ไม่ได้/ทรงมอบ/ข้าพเจ้า/ให้แก่/ความตาย<verse eid="PSA 118:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19" />จง/เปิด/ประตู/แห่ง/ความ/ชอบธรรม/ให้/ข้าพเจ้า</para>
  <para style="q1" vid="PSA 118:19">ข้าพเจ้า/จะ/เข้าไป/และ/ถวาย/คำ/ขอบ/พระคุณ/องค์/พระผู้เป็นเจ้า<verse eid="PSA 118:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20" />นี่คือ/ประตู/ของ/<char style="nd">องค์/พระผู้เป็นเจ้า</char></para>
  <para style="q1" vid="PSA 118:20">ผู้/ชอบธรรม/จะ/เข้า/ไป/ทาง/ประตู/นี้<verse eid="PSA 118:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21" />ข้าพระองค์/ขอบพระคุณ/พระองค์/เพราะ/พระองค์/ทรง/ตอบ/ข้าพระองค์</para>
  <para style="q1" vid="PSA 118:21">พระองค์/ทรงมา/เป็น/ความรอด/ของ/ข้าพระองค์<verse eid="PSA 118:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22" />ศิลา/ซึ่ง/ช่าง/ก่อ/ได้/ทิ้ง/แล้ว</para>
  <para style="q1" vid="PSA 118:22">บัดนี้/กลับกลาย/เป็น/ศิลา/มุม/เอก<verse eid="PSA 118:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23" />
    <char style="nd">องค์พระผู้เป็นเจ้า</char>/ได้/ทรง/กระทำ/การ/นี้</para>
  <para style="q1" vid="PSA 118:23">เป็น/สิ่ง/มหัศจรรย์/ใน/สายตา/ของเรา<verse eid="PSA 118:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24" />นี่คือ/วันที่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรงสร้าง</para>
  <para style="q1" vid="PSA 118:24">ให้/เรา/ชื่นชม/ยินดี/และ/เปรมปรีดิ์<verse eid="PSA 118:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25" />ข้าแต่/<char style="nd">องค์/พระผู้เป็นเจ้า</char> ขอ/ทรง/ช่วย/ข้าพระองค์/ทั้งหลาย/ให้/รอด</para>
  <para style="q1" vid="PSA 118:25">ข้าแต่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ขอโปรด/ประทาน ความ/สำเร็จ/แก่/ข้าพระองค์/ทั้งหลาย<verse eid="PSA 118:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26" />สรรเสริญ/พระองค์/ผู้/เสด็จมา/ใน/พระนาม/ของ/พระยาห์เวห์</para>
  <para style="q1" vid="PSA 118:26">ข้าพระองค์/ทั้งหลาย/ขอ/สรรเสริญ/พระองค์<note caller="+" style="f"><char style="fr" closed="false">118:26 </char><char style="ft" closed="false">ใน/ภาษาฮีบรู/คำ/นี้/เป็น/พหูพจน์</char></note> จาก/พระ/นิเวศ/ของ/องค์/พระผู้เป็นเจ้า<verse eid="PSA 118:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27" />พระยาห์เวห์/ทรงเป็น/พระเจ้า</para>
  <para style="q1" vid="PSA 118:27">พระองค์/ทรงให้/ความสว่าง/ของ/พระองค์/ส่อง/เหนือ/เรา</para>
  <para style="q1" vid="PSA 118:27">ให้/เรา/ถือ/กิ่งไม้/ร่วม/ขบวน/เฉลิมฉลอง</para>
  <para style="q1" vid="PSA 118:27">ไป/ถึง<note caller="+" style="f"><char style="fr" closed="false">118:27 </char><char style="ft" closed="false">หรือ/</char><char style="fqa" closed="false">มัด/เครื่อง/บูชา/เฉลิมฉลอง/ด้วยเชือก / และ/นำไป/ถึง</char></note>เชิงงอน/ของ/แท่นบูชา<verse eid="PSA 118:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28" />พระองค์/ทรงเป็น/พระเจ้า/ของ/ข้าพระองค์</para>
  <para style="q1" vid="PSA 118:28">ข้าพระองค์/จะ/ขอบพระคุณ/พระองค์</para>
  <para style="q1" vid="PSA 118:28">พระองค์/ทรงเป็น/พระเจ้า/ของ/ข้าพระองค์</para>
  <para style="q1" vid="PSA 118:28">ข้าพระองค์/จะ/เทิดทูน/พระองค์<verse eid="PSA 118:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29" />จง/ขอบพระคุณ/<char style="nd">องค์/พระผู้เป็นเจ้า</char> เพราะ/พระองค์/ทรงแสนดี</para>
  <para style="q1" vid="PSA 118:29">ความรัก/มั่นคง/ของ/พระองค์/ดำรง/นิรันดร์<verse eid="PSA 118:29" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" sid="PSA 119" />
  <para style="cl">สดุดี 119<note caller="+" style="f"><char style="fr" closed="false">119 </char><char style="ft" closed="false">สดุดี 119 ใน/ภาษาฮีบรู แต่ละ/ตอน/ของ/สดุดี/บทนี้/ขึ้น/ต้น/ด้วย/อักษร/ฮีบรู/ตัวเดียว/กัน และ/ตัวอักษร/ของ/แต่ละ/ตอน/จะ/เรียง/ตามลำดับ/ตั้งแต่/อาเลฟ/ถึง/เทาว์</char></note></para>
  <para style="qa">อาเลฟ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1" />ความสุข/มี/แก่/ผู้/ที่/วิถีทาง/ของเขา/ไร้/ที่ติ</para>
  <para style="q1" vid="PSA 119:1">ผู้/ซึ่ง/ประพฤติ/ตาม/บทบัญญัติ/ของ/องค์/พระผู้เป็นเจ้า<verse eid="PSA 119:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2" />ความสุข/มี/แก่/ผู้/ที่/รักษา/กฎเกณฑ์/ของ/พระองค์</para>
  <para style="q1" vid="PSA 119:2">และ/แสวงหา/พระองค์/หมด/ทั้ง/ใจ<verse eid="PSA 119:2" /></para>
