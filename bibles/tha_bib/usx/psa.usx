  <para style="q1" vid="PSA 98:8">ภูเขา/ทั้งหลาย/จง/ร้องเพลง/รื่นเริง/ด้วยกัน<verse eid="PSA 98:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9" />ทุกสิ่ง/จง/ร้องเพลง/ต่อหน้า/<char style="nd">องค์/พระผู้เป็นเจ้า</char></para>
  <para style="q1" vid="PSA 98:9">เพราะ/พระองค์/เสด็จมา/เพื่อ/พิพากษา/โลก</para>
  <para style="q1" vid="PSA 98:9">พระองค์/จะ/ทรง/พิพากษา/โลก/ด้วย/ความ/ชอบธรรม</para>
  <para style="q1" vid="PSA 98:9">และ/พิพากษา/ชนชาติ/ต่างๆ อย่าง/ยุติธรรม<verse eid="PSA 98:9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" sid="PSA 99" />
  <para style="cl">สดุดี 99</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1" />
    <char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรง/ครอบครอง ประชาชาติ/ทั้งหลาย/จง/ครั่นคร้าม</para>
  <para style="q1" vid="PSA 99:1">พระองค์/ประทับ/บนบัลลังก์/ระหว่าง/เครูบ แผ่นดิน/โลก/จง/สั่นสะท้าน<verse eid="PSA 99:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2" />
    <char style="nd">องค์พระผู้เป็นเจ้า</char>/ผู้/ประทับ/ใน/ศิโยน/ทรง/ยิ่งใหญ่</para>
  <para style="q1" vid="PSA 99:2">พระองค์/ทรงเป็น/ที่/เทิดทูน/เหนือ/มวล/ประชาชาติ<verse eid="PSA 99:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3" />ให้/พวกเขา/สรรเสริญ/พระนาม/อัน/ยิ่งใหญ่/และ/น่า/เกรงขาม/ของ/พระองค์</para>
