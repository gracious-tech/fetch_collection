  <chapter eid="PSA 31" />
  <chapter number="32" style="c" sid="PSA 32" />
  <para style="cl">สดุดี 32</para>
  <para style="d">(มัสคิล<note caller="+" style="f"><char style="fr" closed="false">32:0 </char><char style="ft" closed="false">หัวเรื่อง/สดุดี 32 คงจะ/เป็น/ศัพท์/ทาง/วรรณกรรม/หรือ/ทาง/ดนตรี</char></note>บทหนึ่ง/ของ/ดาวิด)</para>
