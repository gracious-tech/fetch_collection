  <para style="toc3">กดว.</para>
  <para style="mt1">กันดารวิถี</para>
  <chapter number="1" style="c" sid="NUM 1" />
  <para style="s1">สำมะโน/ประชากร</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 1:1" />วันที่/หนึ่ง/เดือน/ที่/สอง/ของ/ปี/ที่/สอง หลังจาก/ชาว/อิสราเอล/ออก/จาก/ประเทศ/อียิปต์ <char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/กับ/โมเสส/ใน/เต็นท์/นัดพบ/ที่/ถิ่น/กันดาร/ซีนาย/ว่า <verse eid="NUM 1:1" /><verse number="2" style="v" sid="NUM 1:2" />“จง/สำรวจ/สำมะโน/ประชากร/ชุมชน/อิสราเอล/ทั้งหมด แยก/เป็น/ราย/ตระกูล/และ/ครอบครัว ให้/ทำ/บัญชี/รายชื่อ/ผู้ชาย/ทุกคน <verse eid="NUM 1:2" /><verse number="3" style="v" sid="NUM 1:3" />เจ้า/กับ/อาโรน/จะ/ต้อง/นับ/จำนวน/ผู้ชาย/ใน/อิสราเอล/ที่/มี/อายุ/ยี่สิบ/ปี/ขึ้นไป/ซึ่ง/สามารถ/ทำ/หน้าที่/ใน/กองทัพ/ได้ โดย/แยก/พวกเขา/ออกเป็น/หมู่/เหล่า <verse eid="NUM 1:3" /><verse number="4" style="v" sid="NUM 1:4" />ผู้/นำ/จาก/แต่ละ/เผ่า เผ่าละ/หนึ่ง/คน/จะ/เป็น/ผู้ช่วย/ของ/เจ้า <verse eid="NUM 1:4" /><verse number="5" style="v" sid="NUM 1:5" />ต่อไปนี้/เป็น/รายชื่อ/ของ/ผู้/นำ/ที่/จะ/มา/ช่วย/เจ้า/ได้แก่</para>
  <para style="li1" vid="NUM 1:5">จาก/เผ่ารูเบน/คือ เอลีซูร์/บุตร/เชเดเออร์<verse eid="NUM 1:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="NUM 1:6" />จาก/เผ่า/สิเมโอน/คือ เชลูมิเอล/บุตร/ศูริชัดดัย<verse eid="NUM 1:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 1:7" />จาก/เผ่า/ยูดาห์/คือ นาห์โชน/บุตร/อัมมีนาดับ<verse eid="NUM 1:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="NUM 1:8" />จาก/เผ่า/อิสสาคาร์/คือ เนธันเอล/บุตร/ศุอาร์<verse eid="NUM 1:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="NUM 1:9" />จาก/เผ่า/เศบูลุน/คือ เอลีอับ/บุตร/เฮโลน<verse eid="NUM 1:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 1:10" />จาก/บุตร/ของ/โยเซฟ/คือ</para>
  <para style="li1" vid="NUM 1:10">จาก/เผ่า/เอฟราอิม/คือ เอลีชามา/บุตร/อัมมีฮูด</para>
  <para style="li1" vid="NUM 1:10">จาก/เผ่า/มนัสเสห์/คือ กามาลิเอล/บุตร/เปดาซูร์<verse eid="NUM 1:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="NUM 1:11" />จาก/เผ่า/เบนยามิน/คือ อาบีดัน/บุตร/กิเดโอนี<verse eid="NUM 1:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 1:12" />จาก/เผ่า/ดาน/คือ อาหิเยเซอร์/บุตร/อัมมีชัดดัย<verse eid="NUM 1:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 1:13" />จาก/เผ่า/อาเชอร์/คือ ปากีเอล/บุตร/โอคราน<verse eid="NUM 1:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 1:14" />จาก/เผ่ากาด/คือ เอลียาสาฟ/บุตร/เดอูเอล<verse eid="NUM 1:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="NUM 1:15" />จาก/เผ่า/นัฟทาลี/คือ อาหิรา/บุตร/เอนัน”<verse eid="NUM 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 1:16" />คน/เหล่านี้/ได้รับ/การ/แต่งตั้ง/จาก/ชุมชน/ให้/เป็น/ผู้/นำ/เผ่า/ต่างๆ ตาม/บรรพบุรุษ พวกเขา/เป็น/หัวหน้า/ตระกูล/ต่างๆ ของ/อิสราเอล<verse eid="NUM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 1:17" />โมเสส/และ/อาโรน/ได้/นำ/ชาย/เหล่านี้/ตาม/บัญชี/รายชื่อ/ที่/ให้/ไว้/มา <verse eid="NUM 1:17" /><verse number="18" style="v" sid="NUM 1:18" />และ/ได้/เรียก/ประชุม/ประชากร/ทั้งหมด/ใน/วันที่/หนึ่ง/เดือน/ที่/สอง ประชาชน/ได้/ระบุ/บรรพบุรุษ/ของ/ตน/ตาม/ตระกูล/และ/ครอบครัว และ/ได้/ขึ้น/บัญชี/รายชื่อ/ผู้ชาย/ที่/มี/อายุ/ยี่สิบ/ปี/ขึ้นไป/ทีละคน <verse eid="NUM 1:18" /><verse number="19" style="v" sid="NUM 1:19" />ตามที่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรง/บัญชา/โมเสส ดังนั้น/เขา/จึง/นับ/จำนวน/คน/เหล่านี้/ใน/ถิ่น/กันดาร/ซีนาย<verse eid="NUM 1:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 1:20" />จาก/วงศ์วาน/ของ/รูเบน/บุตร/ชาย/หัวปี/ของ/อิสราเอล</para>
  <para style="li1" vid="NUM 1:20">ผู้ชาย/อายุ/ยี่สิบ/ปี/ขึ้นไป/ทุกคน/ที่/ออกรบ/ได้ ขึ้นบัญชี/รายชื่อ/ทีละคน/ตาม/ตระกูล/และ/ตาม/ครอบครัว <verse eid="NUM 1:20" /><verse number="21" style="v" sid="NUM 1:21" />จำนวน/พล/จาก/เผ่ารูเบน 46,500 คน<verse eid="NUM 1:21" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="22" style="v" sid="NUM 1:22" />จาก/วงศ์วาน/ของ/สิเมโอน</para>
  <para style="li1" vid="NUM 1:22">ผู้ชาย/อายุ/ยี่สิบ/ปี/ขึ้นไป/ทุกคน/ที่/ออกรบ/ได้ ขึ้นบัญชี/รายชื่อ/ทีละคน/ตาม/ตระกูล/และ/ตาม/ครอบครัว <verse eid="NUM 1:22" /><verse number="23" style="v" sid="NUM 1:23" />จำนวน/พล/จาก/เผ่า/สิเมโอน 59,300 คน<verse eid="NUM 1:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="NUM 1:24" />จาก/วงศ์วาน/ของ/กาด</para>
  <para style="li1" vid="NUM 1:24">ผู้ชาย/อายุ/ยี่สิบ/ปี/ขึ้นไป/ทุกคน/ที่/ออกรบ/ได้ ขึ้นบัญชี/รายชื่อ/ตาม/ตระกูล/และ/ตาม/ครอบครัว <verse eid="NUM 1:24" /><verse number="25" style="v" sid="NUM 1:25" />จำนวน/พล/จาก/เผ่ากาด 45,650 คน<verse eid="NUM 1:25" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="26" style="v" sid="NUM 1:26" />จาก/วงศ์วาน/ของ/ยูดาห์</para>
  <para style="li1" vid="NUM 1:26">ผู้ชาย/อายุ/ยี่สิบ/ปี/ขึ้นไป/ทุกคน/ที่/ออกรบ/ได้ ขึ้นบัญชี/รายชื่อ/ตาม/ตระกูล/และ/ตาม/ครอบครัว <verse eid="NUM 1:26" /><verse number="27" style="v" sid="NUM 1:27" />จำนวน/พล/จาก/เผ่ายูดาห์ 74,600 คน<verse eid="NUM 1:27" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="28" style="v" sid="NUM 1:28" />จาก/วงศ์วาน/ของ/อิสสาคาร์</para>
  <para style="li1" vid="NUM 1:28">ผู้ชาย/อายุ/ยี่สิบ/ปี/ขึ้นไป/ทุกคน/ที่/ออกรบ/ได้ ขึ้นบัญชี/รายชื่อ/ตาม/ตระกูล/และ/ตาม/ครอบครัว <verse eid="NUM 1:28" /><verse number="29" style="v" sid="NUM 1:29" />จำนวน/พล/จาก/เผ่า/อิสสาคาร์ 54,400 คน<verse eid="NUM 1:29" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="30" style="v" sid="NUM 1:30" />จาก/วงศ์วาน/ของ/เศบูลุน</para>
  <para style="li1" vid="NUM 1:30">ผู้ชาย/อายุ/ยี่สิบ/ปี/ขึ้นไป/ทุกคน/ที่/ออกรบ/ได้ ขึ้นบัญชี/รายชื่อ/ตาม/ตระกูล/และ/ตาม/ครอบครัว <verse eid="NUM 1:30" /><verse number="31" style="v" sid="NUM 1:31" />จำนวน/พล/จาก/เผ่า/เศบูลุน 57,400 คน<verse eid="NUM 1:31" /></para>
  <para style="b" />
  <para style="p">
    <verse number="32" style="v" sid="NUM 1:32" />จาก/วงศ์วาน/ของ/เอฟราอิม/บุตร/โยเซฟ</para>
  <para style="li1" vid="NUM 1:32">ผู้ชาย/อายุ/ยี่สิบ/ปี/ขึ้นไป/ทุกคน/ที่/ออกรบ/ได้ ขึ้นบัญชี/รายชื่อ/ตาม/ตระกูล/และ/ตาม/ครอบครัว <verse eid="NUM 1:32" /><verse number="33" style="v" sid="NUM 1:33" />จำนวน/พล/จาก/เผ่า/เอฟราอิม 40,500 คน<verse eid="NUM 1:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="NUM 1:34" />จาก/วงศ์วาน/ของ/มนัสเสห์/บุตร/โยเซฟ</para>
  <para style="li1" vid="NUM 1:34">ผู้ชาย/อายุ/ยี่สิบ/ปี/ขึ้นไป/ทุกคน/ที่/ออกรบ/ได้ ขึ้นบัญชี/รายชื่อ/ตาม/ตระกูล/และ/ตาม/ครอบครัว <verse eid="NUM 1:34" /><verse number="35" style="v" sid="NUM 1:35" />จำนวน/พล/จาก/เผ่า/มนัสเสห์ 32,200 คน<verse eid="NUM 1:35" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="36" style="v" sid="NUM 1:36" />จาก/วงศ์วาน/ของ/เบนยามิน</para>
  <para style="li1" vid="NUM 1:36">ผู้ชาย/อายุ/ยี่สิบ/ปี/ขึ้นไป/ทุกคน/ที่/ออกรบ/ได้ ขึ้นบัญชี/รายชื่อ/ตาม/ตระกูล/และ/ตาม/ครอบครัว <verse eid="NUM 1:36" /><verse number="37" style="v" sid="NUM 1:37" />จำนวน/พล/จาก/เผ่า/เบนยามิน 35,400 คน<verse eid="NUM 1:37" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="38" style="v" sid="NUM 1:38" />จาก/วงศ์วาน/ของ/ดาน</para>
  <para style="li1" vid="NUM 1:38">ผู้ชาย/อายุ/ยี่สิบ/ปี/ขึ้นไป/ทุกคน/ที่/ออกรบ/ได้ ขึ้นบัญชี/รายชื่อ/ตาม/ตระกูล/และ/ตาม/ครอบครัว <verse eid="NUM 1:38" /><verse number="39" style="v" sid="NUM 1:39" />จำนวน/พล/จาก/เผ่า/ดาน 62,700 คน<verse eid="NUM 1:39" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="40" style="v" sid="NUM 1:40" />จาก/วงศ์วาน/ของ/อาเชอร์</para>
  <para style="li1" vid="NUM 1:40">ผู้ชาย/อายุ/ยี่สิบ/ปี/ขึ้นไป/ทุกคน/ที่/ออกรบ/ได้ ขึ้นบัญชี/รายชื่อ/ตาม/ตระกูล/และ/ตาม/ครอบครัว <verse eid="NUM 1:40" /><verse number="41" style="v" sid="NUM 1:41" />จำนวน/พล/จาก/เผ่า/อาเชอร์ 41,500 คน<verse eid="NUM 1:41" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="42" style="v" sid="NUM 1:42" />จาก/วงศ์วาน/ของ/นัฟทาลี</para>
  <para style="li1" vid="NUM 1:42">ผู้ชาย/อายุ/ยี่สิบ/ปี/ขึ้นไป/ทุกคน/ที่/ออกรบ/ได้ ขึ้นบัญชี/รายชื่อ/ตาม/ตระกูล/และ/ตาม/ครอบครัว <verse eid="NUM 1:42" /><verse number="43" style="v" sid="NUM 1:43" />จำนวน/พล/จาก/เผ่า/นัฟทาลี 53,400 คน<verse eid="NUM 1:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 1:44" />ทั้งหมด/นี้/คือ/จำนวน/ผู้ชาย/ที่/โมเสส อาโรน/และ/ผู้/นำ/ทั้ง/สิบ/สองเผ่า/ของ/อิสราเอล/ได้/นับไว้ แต่ละคน/เป็น/ตัวแทน/ครอบครัว/ของเขา <verse eid="NUM 1:44" /><verse number="45" style="v" sid="NUM 1:45" />คือ/ผู้ชาย/อิสราเอล/อายุ/ยี่สิบ/ปี/ขึ้นไป/ทุกคน/ที่/ร่วมทัพ/ได้ ได้/ถูก/นับไว้/ตาม/ครอบครัว/ของเขา <verse eid="NUM 1:45" /><verse number="46" style="v" sid="NUM 1:46" />รวม/ทั้งสิ้น 603,550 คน<verse eid="NUM 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="NUM 1:47" />แต่/จำนวน/นี้/ไม่รวม/คน/เผ่าเลวี <verse eid="NUM 1:47" /><verse number="48" style="v" sid="NUM 1:48" /><char style="nd">องค์พระผู้เป็นเจ้า</char>/ได้/ตรัส/กับ/โมเสส/ไว้/ว่า <verse eid="NUM 1:48" /><verse number="49" style="v" sid="NUM 1:49" />“ยกเว้น/เผ่าเลวี ไม่ต้อง/ลง/จำนวน/ใน/สำมะโน/ประชากร/ของ/อิสราเอล <verse eid="NUM 1:49" /><verse number="50" style="v" sid="NUM 1:50" />แต่/จง/ตั้ง/คน/เลวี/ให้/รับผิดชอบ/งาน/เกี่ยวกับ/พลับพลา/แห่ง/พันธสัญญา พวกเขา/ต้อง/เคลื่อนย้าย/พลับพลา ดูแล/เครื่องใช้/และ/ทุกสิ่ง/ที่/อยู่/ใน/พลับพลา พวกเขา/ต้อง/ตั้งเต็นท์/อาศัย/อยู่/รอบ/พลับพลา <verse eid="NUM 1:50" /><verse number="51" style="v" sid="NUM 1:51" />เมื่อใด/ก็/ตามที่/มี/การ/เคลื่อนย้าย/พลับพลา คน/เลวี/จะ/เป็น/ผู้/ปลด/พลับพลา/ลง/หรือ/ตั้งขึ้น/ใหม่ ผู้/อื่น/ที่/เข้า/ใกล้/พลับพลา/จะ/ต้อง/ถูก/ประหาร/ชีวิต <verse eid="NUM 1:51" /><verse number="52" style="v" sid="NUM 1:52" />ชาว/อิสราเอล/จะ/ต้อง/ตั้งเต็นท์/ของ/ตน/เป็น/หมู่/เหล่า แต่ละคน/อยู่/ใน/ค่าย/ของ/ตน/ภายใต้/ธง/ประจำ/กอง <verse eid="NUM 1:52" /><verse number="53" style="v" sid="NUM 1:53" />ส่วน/คน/เลวี/จะ/ต้อง/ตั้งเต็นท์/รอบ/พลับพลา/แห่ง/พันธสัญญา/เพื่อ/พระ/พิโรธ/ของ/พระเจ้า/จะ/ไม่ตก/แก่/ชุมชน/อิสราเอล ให้/คน/เลวี/รับผิดชอบ/ดูแล/พลับพลา/แห่ง/พันธสัญญา”<verse eid="NUM 1:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="NUM 1:54" />ประชากร/อิสราเอล/ก็/ปฏิบัติ/ตาม/ทุกสิ่ง/ที่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/สั่ง/โมเสส<verse eid="NUM 1:54" /></para>
  <chapter eid="NUM 1" />
  <chapter number="2" style="c" sid="NUM 2" />
  <para style="s1">การจัดตั้ง/ค่าย/ของ/เผ่า/ต่างๆ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 2:1" />
    <char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/กับ/โมเสส/และ/อาโรน/ว่า <verse eid="NUM 2:1" /><verse number="2" style="v" sid="NUM 2:2" />“ชน/อิสราเอล/จะ/ตั้ง/ค่าย/รอบ/เต็นท์/นัดพบ ให้/ห่าง/จาก/เต็นท์/นัดพบ/ระยะ/หนึ่ง แต่ละคน/อยู่/ภายใต้/ธง/ประจำ/กอง/ของเขา/พร้อมกับ/ธง/ประจำ/ครอบครัว”<verse eid="NUM 2:2" /></para>
  <para style="pi1">
    <verse number="3" style="v" sid="NUM 2:3" />ด้าน/ตะวันออก/ของ/พลับพลา/เป็น/ที่ตั้ง/ค่าย/ของ/หมู่/เหล่า/ยูดาห์/ภายใต้/ธง/ประจำ/กอง/ของ/พวกเขา ผู้นำ/คือ/นาห์โชน/บุตร/อัมมีนาดับ <verse eid="NUM 2:3" /><verse number="4" style="v" sid="NUM 2:4" />จำนวน/พล 74,600 คน<verse eid="NUM 2:4" /></para>
  <para style="pi1">
    <verse number="5" style="v" sid="NUM 2:5" />ถัด/มา/เป็น/ที่ตั้ง/ค่าย/ของ/เผ่า/อิสสาคาร์ ผู้/นำ/คือ/เนธันเอล/บุตร/ศุอาร์ <verse eid="NUM 2:5" /><verse number="6" style="v" sid="NUM 2:6" />จำนวน/พล 54,400 คน<verse eid="NUM 2:6" /></para>
  <para style="pi1">
    <verse number="7" style="v" sid="NUM 2:7" />จาก/นั้น/ได้แก่/เผ่า/เศบูลุน ผู้/นำ/คือ/เอลีอับ/บุตร/เฮโลน <verse eid="NUM 2:7" /><verse number="8" style="v" sid="NUM 2:8" />จำนวน/พล 57,400 คน<verse eid="NUM 2:8" /></para>
  <para style="pi1">
    <verse number="9" style="v" sid="NUM 2:9" />รวมพล/แนวรบ/ด้าน/เผ่ายูดาห์/ตาม/หมู่/เหล่า/ของ/พวกเขา/ได้ 186,400 คน กลุ่ม/นี้/จะ/เคลื่อน/กำลัง/ออกไป/เป็น/กลุ่มแรก<verse eid="NUM 2:9" /></para>
  <para style="b" />
  <para style="pi1">
    <verse number="10" style="v" sid="NUM 2:10" />ด้านใต้/ของ/พลับพลา/เป็น/ที่ตั้ง/ค่าย/ของ/หมู่/เหล่า/รูเบน/ภายใต้/ธง/ประจำ/กอง/ของ/พวกเขา ผู้/นำ/คือ/เอลีซูร์/บุตร/เชเดเออร์ <verse eid="NUM 2:10" /><verse number="11" style="v" sid="NUM 2:11" />จำนวน/พล 46,500 คน<verse eid="NUM 2:11" /></para>
  <para style="pi1">
    <verse number="12" style="v" sid="NUM 2:12" />ถัด/มา/คือ/เผ่า/สิเมโอน ผู้/นำ/คือ/เชลูมิเอล/บุตร/ศูริชัดดัย <verse eid="NUM 2:12" /><verse number="13" style="v" sid="NUM 2:13" />จำนวน/พล 59,300 คน<verse eid="NUM 2:13" /></para>
  <para style="pi1">
    <verse number="14" style="v" sid="NUM 2:14" />ถัดมา/คือ/เผ่ากาด ผู้/นำ/คือ/เอลียาสาฟ/บุตร/เดอูเอล<note caller="+" style="f"><char style="fr" closed="false">2:14 </char><char style="ft" closed="false">สำเนา MT. บางฉบับ/ว่า/</char><char style="fqa" closed="false">เรอูเอล</char></note> <verse eid="NUM 2:14" /><verse number="15" style="v" sid="NUM 2:15" />จำนวน/พล 45,650 คน<verse eid="NUM 2:15" /></para>
  <para style="pi1">
    <verse number="16" style="v" sid="NUM 2:16" />รวมพล/แนวรบ/ด้าน/เผ่ารูเบน/ตาม/หมู่/เหล่า/ของ/พวกเขา/ได้ 151,450 คน กลุ่ม/นี้/จะ/เคลื่อน/กำลัง/เป็น/กลุ่ม/ที่สอง<verse eid="NUM 2:16" /></para>
  <para style="b" />
  <para style="pi1">
    <verse number="17" style="v" sid="NUM 2:17" />ส่วน/เต็นท์/นัดพบ/และ/ค่าย/ของ/เผ่าเลวี/จะ/ตั้งอยู่/กลาง/ค่าย พวกเขา/จะ/เคลื่อน/ออก/ตามลำดับ/เดียวกับ/การ/ตั้ง/ค่าย แต่ละ/กลุ่ม/อยู่/ใน/ตำแหน่ง/ของ/ตนเอง/ภายใต้/ธง/ประจำ/กอง/ของ/ตน<verse eid="NUM 2:17" /></para>
  <para style="b" />
  <para style="pi1">
    <verse number="18" style="v" sid="NUM 2:18" />ด้าน/ตะวันตก/ของ/พลับพลา/เป็น/ที่ตั้ง/ค่าย/ของ/หมู่/เหล่า/เอฟราอิม/ภายใต้/ธง/ประจำ/กอง/ของ/พวกเขา ผู้/นำ/คือ/เอลีชามา/บุตร/อัมมีฮูด <verse eid="NUM 2:18" /><verse number="19" style="v" sid="NUM 2:19" />จำนวน/พล 40,500 คน<verse eid="NUM 2:19" /></para>
  <para style="pi1">
    <verse number="20" style="v" sid="NUM 2:20" />ถัด/มา/คือ/เผ่า/มนัสเสห์ ผู้/นำ/คือ/กามาลิเอล/บุตร/เปดาซูร์ <verse eid="NUM 2:20" /><verse number="21" style="v" sid="NUM 2:21" />จำนวน/พล 32,200 คน<verse eid="NUM 2:21" /></para>
  <para style="pi1">
    <verse number="22" style="v" sid="NUM 2:22" />ถัดมา/คือ/เผ่า/เบนยามิน ผู้/นำ/คือ/อาบีดัน/บุตร/กิเดโอนี <verse eid="NUM 2:22" /><verse number="23" style="v" sid="NUM 2:23" />จำนวน/พล 35,400 คน<verse eid="NUM 2:23" /></para>
  <para style="pi1">
    <verse number="24" style="v" sid="NUM 2:24" />รวมพล/ใน/แนวรบ/ด้าน/เผ่า/เอฟราอิม/ตาม/หมู่/เหล่า/ของ/พวกเขา/ได้ 108,100 คน พวกเขา/จะ/เคลื่อนพล/เป็น/กลุ่ม/ที่สาม<verse eid="NUM 2:24" /></para>
  <para style="b" />
  <para style="pi1">
    <verse number="25" style="v" sid="NUM 2:25" />ด้านเหนือ/ของ/พลับพลา/เป็น/ที่ตั้ง/ค่าย/ของ/หมู่/เหล่า/ดาน/ภายใต้/ธง/ประจำ/กอง/ของ/พวกเขา ผู้/นำ/คือ/อาหิเยเซอร์/บุตร/อัมมีชัดดัย <verse eid="NUM 2:25" /><verse number="26" style="v" sid="NUM 2:26" />จำนวน/พล 62,700 คน<verse eid="NUM 2:26" /></para>
  <para style="pi1">
    <verse number="27" style="v" sid="NUM 2:27" />ถัดมา/คือ/เผ่า/อาเชอร์ ผู้/นำ/คือ/ปากีเอล/บุตร/โอคราน <verse eid="NUM 2:27" /><verse number="28" style="v" sid="NUM 2:28" />จำนวน/พล 41,500 คน<verse eid="NUM 2:28" /></para>
  <para style="pi1">
    <verse number="29" style="v" sid="NUM 2:29" />ถัดมา/คือ/เผ่า/นัฟทาลี ผู้/นำ/คือ/อาหิรา/บุตร/เอนัน <verse eid="NUM 2:29" /><verse number="30" style="v" sid="NUM 2:30" />จำนวน/พล 53,400 คน<verse eid="NUM 2:30" /></para>
  <para style="pi1">
    <verse number="31" style="v" sid="NUM 2:31" />รวมพล/ใน/แนวรบ/ด้าน/เผ่า/ดาน/ได้ 157,600 คน เวลา/เดินทาง/จะ/อยู่/รั้งท้าย/ขบวน/ภายใต้/ธง/ประจำ/กอง/ของ/พวกเขา<verse eid="NUM 2:31" /></para>
  <para style="b" />
  <para style="pi1">
    <verse number="32" style="v" sid="NUM 2:32" />ทั้งหมด/นี้/คือ/ชน/อิสราเอล/นับ/ตาม/ครอบครัว/ของ/พวกเขา/ที่/อยู่/ใน/ค่าย ตาม/หมู่/เหล่า/มีจำนวน/ทั้งสิ้น 603,550 คน <verse eid="NUM 2:32" /><verse number="33" style="v" sid="NUM 2:33" />ทั้งนี้/ไม่นับ/คน/เลวี/รวมกับ/ชน/อิสราเอล/อื่นๆ ตามที่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรง/บัญชา/แก่/โมเสส<verse eid="NUM 2:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 2:34" />ดังนั้น/ประชากร/อิสราเอล/จึง/ได้/ทำ/ทุกสิ่ง/ตามที่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/สั่ง/โมเสส/คือ แต่ละคน/พร้อมกับ/ตระกูล/และ/ครอบครัว/ของ/ตน/ได้/ตั้ง/ค่ายพัก/แรม/ภายใต้/ธง/ประจำ/กอง/ของ/พวกเขา/และ/เคลื่อนพล/ตามที่/กำหนด/ไว้<verse eid="NUM 2:34" /></para>
  <chapter eid="NUM 2" />
  <chapter number="3" style="c" sid="NUM 3" />
  <para style="s1">คน/เลวี</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 3:1" />ต่อไปนี้/เป็น/เรื่องราว/ของ/ครอบครัว/อาโรน/และ/โมเสส เมื่อ/ครั้ง/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/กับ/โมเสส/บน/ภูเขา/ซีนาย<verse eid="NUM 3:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="NUM 3:2" />บุตร/ชาย/ของ/อาโรน/ได้แก่ นาดับ/ซึ่งเป็น/บุตร/หัวปี อาบีฮู เอเลอาซาร์ และ/อิธามาร์ <verse eid="NUM 3:2" /><verse number="3" style="v" sid="NUM 3:3" />คน/เหล่านี้/ซึ่งเป็น/บุตร/ของ/อาโรน/ได้รับ/การเจิม/ตั้ง/และ/สถาปนา/ให้/ปรนนิบัติ/ใน/ฐานะ/ปุโรหิต <verse eid="NUM 3:3" /><verse number="4" style="v" sid="NUM 3:4" />แต่/นาดับ/และ/อาบีฮู/เสียชีวิต/ต่อหน้า/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ใน/ถิ่น/กันดาร/ซีนาย/เมื่อ/ได้/จุดไฟ/ต้องห้าม/ขึ้น คน/ทั้งสอง/ไม่มี/บุตร จึง/เหลือแต่/เอเลอาซาร์/และ/อิธามาร์/ทำหน้าที่/ปุโรหิต/ใน/ช่วงชีวิต/ของ/อาโรน/ผู้/เป็น/บิดา<verse eid="NUM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 3:5" />
    <char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/กับ/โมเสส/ว่า <verse eid="NUM 3:5" /><verse number="6" style="v" sid="NUM 3:6" />“จง/นำ/คน/เผ่าเลวี/มา/รายงาน/ตัว/ต่อ/ปุโรหิต/อาโรน/เพื่อ/ช่วย/งาน/เขา <verse eid="NUM 3:6" /><verse number="7" style="v" sid="NUM 3:7" />คน/เหล่านี้/จะ/ปฏิบัติ/หน้าที่/ใน/เต็นท์/นัดพบ/แทน/อาโรน/และ/ชาว/อิสราเอล/ทั้งหมด โดย/รับผิดชอบ/งาน/เกี่ยวกับ/พลับพลา/ทั้งหมด <verse eid="NUM 3:7" /><verse number="8" style="v" sid="NUM 3:8" />พวกเขา/จะ/ต้อง/คอยดูแล/ส่วน/ประกอบ/ทั้งหมด/ของ/เต็นท์/นัดพบ และ/ปฏิบัติ/หน้าที่/ที่/พลับพลา/เพื่อ/ชน/อิสราเอล <verse eid="NUM 3:8" /><verse number="9" style="v" sid="NUM 3:9" />จง/มอบ/คน/เลวี/ให้แก่/อาโรน/และ/บรรดา/บุตร/ชาย/ของเขา คน/เลวี/เป็น/ชาว/อิสราเอล/ที่/คอย/ช่วย/งาน/เขา<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="ft" closed="false">สำเนา MT. บางฉบับ และ/ฉบับ SamP. และ ฉบับ LXX. ว่า/</char><char style="fqa" closed="false">ช่วย/งาน/เรา/</char><char style="ft" closed="false">(ดู/<char style="xt"><ref loc="NUM 8:16">กดว.8:16</ref></char>)</char></note> อย่าง/เต็มที่ <verse eid="NUM 3:9" /><verse number="10" style="v" sid="NUM 3:10" />จง/แต่งตั้ง/อาโรน/กับ/บุตร/ชาย/ของเขา/ให้/ปฏิบัติ/หน้าที่/ปุโรหิต ใคร/อื่น/ล่วงล้ำ/เข้ามา/ใกล้/สถาน/นมัสการ/จะ/มี/โทษ/ถึงตาย”<verse eid="NUM 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 3:11" />
    <char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/กับ/โมเสส/อีก/ว่า <verse eid="NUM 3:11" /><verse number="12" style="v" sid="NUM 3:12" />“เรา/ได้/เลือก/ชนเผ่า/เลวี/จาก/ชน/อิสราเอล/ให้/เป็น/ตัวแทน/บุตร/ชาย/หัวปี/ของ/หญิง/ชาว/อิสราเอล/ทุกคน คน/เลวี/เป็น/ของเรา <verse eid="NUM 3:12" /><verse number="13" style="v" sid="NUM 3:13" />เพราะ/บุตร/หัวปี/เป็น/ของเรา ตั้งแต่/วันที่/เรา/ประหาร/บุตร/ชาย/หัวปี/ทั้งปวง/ของ/ชาวอียิปต์ เรา/ได้/แยก/ลูกหัวปี/ของ/อิสราเอล/ทั้งหมด ไม่ว่า/คน/หรือ/สัตว์/มา/เป็น/ของเรา เรา/คือ/พระยาห์เวห์”<verse eid="NUM 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 3:14" />
    <char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/กับ/โมเสส/ใน/ถิ่น/กันดาร/ซีนาย/ว่า <verse eid="NUM 3:14" /><verse number="15" style="v" sid="NUM 3:15" />“จง/นับ/จำนวน/คน/เลวี/ตาม/ครอบครัว/และ/ตระกูล/ของเขา นับ/ผู้ชาย/ทุกคน/อายุ/หนึ่ง/เดือน/ขึ้น/ไป” <verse eid="NUM 3:15" /><verse number="16" style="v" sid="NUM 3:16" />ดังนั้น/โมเสส/ก็/นับ/พวกเขา/ตาม/คำสั่ง/ของ/องค์/พระผู้เป็นเจ้า<verse eid="NUM 3:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="NUM 3:17" />ต่อไปนี้/เป็น/รายชื่อ/บุตร/ของ/เลวี ได้แก่</para>
  <para style="li1" vid="NUM 3:17">เกอร์โชน โคฮาท และ/เมรารี<verse eid="NUM 3:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="NUM 3:18" />คน/ใน/ตระกูล/เกอร์โชน ได้แก่</para>
  <para style="li1" vid="NUM 3:18">ลิบนี/และ/ชิเมอี<verse eid="NUM 3:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="NUM 3:19" />คน/ใน/ตระกูล/โคฮาท ได้แก่</para>
  <para style="li1" vid="NUM 3:19">อัมราม อิสฮาร์ เฮโบรน และ/อุสซีเอล<verse eid="NUM 3:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 3:20" />คน/ใน/ตระกูล/เมรารี ได้แก่</para>
  <para style="li1" vid="NUM 3:20">มาห์ลี/และ/มูชี</para>
  <para style="p" vid="NUM 3:20">ทั้งหมด/นี้/คือ/ตระกูล/ต่างๆ ของ/คน/เลวี/ตาม/ครอบครัว/ของเขา<verse eid="NUM 3:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="NUM 3:21" />ลูกหลาน/ของ/ลิบนี/และ/ชิเมอี/เป็น/ของ/ตระกูล/เกอร์โชน <verse eid="NUM 3:21" /><verse number="22" style="v" sid="NUM 3:22" />รวม/ผู้ชาย/ทั้งหมด/ที่/อายุ/หนึ่ง/เดือน/ขึ้น/ไป/มี 7,500 คน <verse eid="NUM 3:22" /><verse number="23" style="v" sid="NUM 3:23" />ตระกูล/เกอร์โชน/จะ/ตั้ง/ค่าย/ด้าน/ทิศ/ตะวันตก/หลัง/พลับพลา <verse eid="NUM 3:23" /><verse number="24" style="v" sid="NUM 3:24" />ผู้/นำ/ครอบครัว/ต่างๆ ใน/ตระกูล/เกอร์โชน/คือ/เอลียาสาฟ/บุตร/ลาเอล <verse eid="NUM 3:24" /><verse number="25" style="v" sid="NUM 3:25" />ตระกูล/เกอร์โชน/รับผิดชอบ/ดูแล/พลับพลา/และ/เต็นท์ พร้อม/เครื่อง/คลุม/เต็นท์/และ/ม่าน/ตรง/ทางเข้า/เต็นท์/นัดพบ <verse eid="NUM 3:25" /><verse number="26" style="v" sid="NUM 3:26" />ม่านกั้น/รอบ/ลาน/พลับพลา ม่านกั้น/ทางเข้า/ลาน/พลับพลา/และ/แท่นบูชา และ/เชือก/ทั้งหมด/ที่ใช้/โยง/พลับพลา/เข้า/ด้วยกัน และ/ทุกอย่าง/ที่/เกี่ยวข้อง/เพื่อ/ใช้/ใน/งาน/นี้<verse eid="NUM 3:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="NUM 3:27" />ลูกหลาน/ของ/อัมราม อิสฮาร์ เฮโบรน และ/อุสซีเอล/เป็น/ของ/ตระกูล/โคฮาท <verse eid="NUM 3:27" /><verse number="28" style="v" sid="NUM 3:28" />รวม/ผู้ชาย/ทั้งหมด/ที่/อายุ/หนึ่ง/เดือน/ขึ้น/ไป/มี 8,600 คน<note caller="+" style="f"><char style="fr" closed="false">3:28 </char><char style="ft" closed="false">สำเนา LXX. บางฉบับ/ว่า/</char><char style="fqa" closed="false">8,300 คน</char></note>ตระกูล/โคฮาท/รับผิดชอบ/ดูแล/สถาน/นมัสการ <verse eid="NUM 3:28" /><verse number="29" style="v" sid="NUM 3:29" />ตระกูล/โคฮาท/จะ/ตั้ง/ค่าย/ด้าน/ทิศใต้/ของ/พลับพลา <verse eid="NUM 3:29" /><verse number="30" style="v" sid="NUM 3:30" />ผู้/นำ/ครอบครัว/ต่างๆ ใน/ตระกูล/โคฮาท/คือ เอลีซาฟาน/บุตร/อุสซีเอล <verse eid="NUM 3:30" /><verse number="31" style="v" sid="NUM 3:31" />พวกเขา/รับผิดชอบ/ดูแล/หีบ/พันธสัญญา โต๊ะ คัน/ประทีป แท่น/ทั้งสอง/และ/เครื่องใช้/ต่างๆ ของ/สถาน/นมัสการ ม่าน และ/ทุกอย่าง/ที่/เกี่ยวข้อง/เพื่อ/ใช้/ใน/งาน/นี้ <verse eid="NUM 3:31" /><verse number="32" style="v" sid="NUM 3:32" />หัวหน้า/ใหญ่/ของ/คน/เลวี/คือ ปุโรหิต/เอเลอาซาร์/บุตร/ของ/อาโรน เขา/ได้/รับ/แต่งตั้ง/ให้/กำกับ/ดูแล/สถาน/นมัสการ<verse eid="NUM 3:32" /></para>
  <para style="b" />
  <para style="p">
    <verse number="33" style="v" sid="NUM 3:33" />ลูกหลาน/ของ/มาห์ลี/และ/มูชี/เป็น/ของ/ตระกูล/เมรารี <verse eid="NUM 3:33" /><verse number="34" style="v" sid="NUM 3:34" />รวม/ชาย/ทั้งหมด/ที่/อายุ/หนึ่ง/เดือน/ขึ้น/ไป/มี 6,200 คน <verse eid="NUM 3:34" /><verse number="35" style="v" sid="NUM 3:35" />ผู้/นำ/ครอบครัว/ต่างๆ ใน/ตระกูล/เมรารี/คือ/ศุรีเอล/บุตร/อาบีฮายิล พวกเขา/จะ/ตั้ง/ค่าย/ด้าน/ทิศเหนือ/ของ/พลับพลา <verse eid="NUM 3:35" /><verse number="36" style="v" sid="NUM 3:36" />ตระกูล/เมรารี/ได้รับ/มอบหมาย/ให้/ดูแล/ไม้/ฝา/ของ/พลับพลา คาน/ขวาง เสา ฐานรอง/รับ อุปกรณ์/ต่างๆ และ/ทุกส่วน/ที่/เกี่ยวข้อง/เพื่อ/ใช้/ใน/งาน/นี้ <verse eid="NUM 3:36" /><verse number="37" style="v" sid="NUM 3:37" />ตลอดจน/เสา/รอบ/ลาน/พลับพลา ฐาน/รองรับ หลักหมุด และ/เชือก<verse eid="NUM 3:37" /></para>
  <para style="b" />
  <para style="p">
    <verse number="38" style="v" sid="NUM 3:38" />โมเสส/และ/อาโรน/กับ/บรรดา/บุตร/ชาย/ของเขา/จะ/ตั้งเต็นท์/ที่/ด้าน/ทิศ/ตะวันออก/ของ/พลับพลา ด้านหน้า/เต็นท์/นัดพบ พวกเขา/รับผิดชอบ/ดูแล/สถาน/นมัสการ/แทน/ชน/อิสราเอล ใคร/อื่น/ล่วงล้ำ/เข้าใกล้/สถาน/นมัสการ/จะ/มี/โทษ/ถึงตาย<verse eid="NUM 3:38" /></para>
  <para style="b" />
  <para style="p">
    <verse number="39" style="v" sid="NUM 3:39" />รวม/ชาย/เลวี/อายุ/หนึ่ง/เดือน/ขึ้น/ไป/ทั้งหมด ซึ่ง/โมเสส/และ/อาโรน/ได้/นับไว้/ตาม/ตระกูล/ของ/พวกเขา ตาม/พระ/บัญชา/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/มี 22,000 คน<verse eid="NUM 3:39" /></para>
  <para style="b" />
  <para style="p">
    <verse number="40" style="v" sid="NUM 3:40" />
    <char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/กับ/โมเสส/ว่า “จง/ทำ/ทะเบียน/รายชื่อ/บุตร/ชาย/หัวปี/ทุกคน/ของ/อิสราเอล/ที่/มี/อายุ/หนึ่ง/เดือน/ขึ้น/ไป <verse eid="NUM 3:40" /><verse number="41" style="v" sid="NUM 3:41" />คน/เลวี/จะ/เป็น/ของเรา เป็น/ตัวแทน/บุตร/ชาย/หัวปี/ของ/อิสราเอล และ/ฝูงสัตว์/ของ/คน/เลวี/จะ/เป็น/ตัวแทน/ลูกหัวปี/ทั้งหมด/ของ/ฝูงสัตว์/ของ/คน/อิสราเอล เรา/คือ/พระยาห์เวห์”<verse eid="NUM 3:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 3:42" />ดังนั้น/โมเสส/จึง/นับ/จำนวน/บุตร/หัวปี/ทั้งหมด/ของ/ชน/อิสราเอล/ตามที่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรง/บัญชา <verse eid="NUM 3:42" /><verse number="43" style="v" sid="NUM 3:43" />บุตร/ชาย/หัวปี/อายุ/หนึ่ง/เดือน/ขึ้น/ไป/ตาม/รายชื่อ/มี/ทั้งสิ้น 22,273 คน<verse eid="NUM 3:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 3:44" />
    <char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/กับ/โมเสส/ว่า <verse eid="NUM 3:44" /><verse number="45" style="v" sid="NUM 3:45" />“จง/มอบ/คน/เลวี/ให้/เรา/แทน/บุตร/ชาย/หัวปี/ทั้งหมด/ของ/อิสราเอล และ/มอบ/ฝูงสัตว์/ของ/คน/เลวี/ให้/เรา/แทน/ฝูงสัตว์/ของ/พวกเขา คน/เลวี/จะ/เป็น/ของเรา เรา/คือ/พระยาห์เวห์ <verse eid="NUM 3:45" /><verse number="46" style="v" sid="NUM 3:46" />สำหรับ/บุตร/ชาย/หัวปี/ของ/อิสราเอล 273 คน/ซึ่ง/เกิน/จำนวน/คน/เลวี/นั้น <verse eid="NUM 3:46" /><verse number="47" style="v" sid="NUM 3:47" />จง/เก็บเงิน/หนัก/คน/ละ/ห้า/เชเขล<note caller="+" style="f"><char style="fr" closed="false">3:47 </char><char style="ft" closed="false">1 เชเขล คือ/เงิน/หนัก/ประมาณ 11.5 กรัม มีค่า/เท่ากับ/ค่าแรง/สอง/เดือน เช่น/เดียว/กับ/ข้อ 50</char></note>ตาม/เชเขล/ของ/สถาน/นมัสการ ซึ่ง/เท่ากับ/ยี่สิบ/เกราห์ <verse eid="NUM 3:47" /><verse number="48" style="v" sid="NUM 3:48" />จง/มอบ/เงิน/ค่าไถ่ตัว/ของ/ชน/อิสราเอล/ที่/เกินมา/นี้/ให้แก่/อาโรน/และ/บุตร/ชาย/ของเขา”<verse eid="NUM 3:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="NUM 3:49" />โมเสส/จึง/เก็บ/เงิน/ค่าไถ่/จาก/บุตร/หัวปี/ชาว/อิสราเอล ซึ่ง/เกิน/จำนวน/คน/ที่/ไถ่/แล้ว/โดยทาง/คน/เลวี <verse eid="NUM 3:49" /><verse number="50" style="v" sid="NUM 3:50" />รวม/จำนวน/เงิน/ที่/เก็บ/ได้/หนัก 1,365 เชเขล ตาม/เชเขล/ของ/สถาน/นมัสการ <verse eid="NUM 3:50" /><verse number="51" style="v" sid="NUM 3:51" />โมเสส/มอบ/เงิน/ค่าไถ่/นี้/ให้แก่/อาโรน/และ/บรรดา/บุตร/ชาย/ตาม/พระ/บัญชา/ของ/องค์/พระผู้เป็นเจ้า<verse eid="NUM 3:51" /></para>
  <chapter eid="NUM 3" />
  <chapter number="4" style="c" sid="NUM 4" />
  <para style="s1">คน/โคฮาท</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 4:1" />
    <char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/กับ/โมเสส/และ/อาโรน/ว่า <verse eid="NUM 4:1" /><verse number="2" style="v" sid="NUM 4:2" />“จง/ทำ/บัญชี/รายชื่อ/คน/โคฮาท/ซึ่งเป็น/เชื้อสาย/หนึ่ง/ของ/คน/เลวี/ตาม/ตระกูล/และ/ตาม/ครอบครัว/ของเขา <verse eid="NUM 4:2" /><verse number="3" style="v" sid="NUM 4:3" />จง/นับ/ผู้ชาย/ทุกคน/ซึ่ง/มี/อายุ/ตั้งแต่/สามสิบ/ปี/ถึง/ห้าสิบ/ปี/ซึ่ง/มี/คุณสมบัติ/ที่/จะ/มา/รับใช้/ใน/เต็นท์/นัดพบ<verse eid="NUM 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 4:4" />“ภารกิจ/ของ/คน/โคฮาท/ใน/เต็นท์/นัดพบ/คือ ดูแล/สิ่ง/บริสุทธิ์/ที่สุด <verse eid="NUM 4:4" /><verse number="5" style="v" sid="NUM 4:5" />เมื่อ/โยกย้าย/ค่ายพัก อาโรน/กับ/บุตร/ชาย/จะ/เข้าไป/ปลด/ม่านกั้น/อภิสุทธิสถาน/ลงมา/คลุม/หีบ/พันธสัญญา <verse eid="NUM 4:5" /><verse number="6" style="v" sid="NUM 4:6" />จากนั้น/เอา/หนัง/พะยูน/คลุมทับ/ม่าน ใช้/ผ้า/สีน้ำเงิน/คลุมทับ/หนัง/พะยูน/อีก/ชั้น/หนึ่ง แล้ว/สอด/คานหาม/หีบ/พันธสัญญา<verse eid="NUM 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 4:7" />“ให้/พวกเขา/คลี่/ผ้า/สีน้ำเงิน/คลุม/โต๊ะ/เครื่อง/ถวาย/เบื้อง/พระพักตร์ วาง/จาน ชาม เหยือก และ/ขนมปัง/ซึ่ง/ต้อง/ตั้งไว้/เสมอ/บน/โต๊ะ/นั้น <verse eid="NUM 4:7" /><verse number="8" style="v" sid="NUM 4:8" />เอา/ผ้า/สีแดง/คลุมทับ/สิ่ง/เหล่านั้น แล้ว/ใช้/หนัง/พะยูน/คลุมทับ/ไว้ และ/สอด/คานหาม/เข้าที่/ห่วง/ของ/โต๊ะ<verse eid="NUM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 4:9" />“จาก/นั้น/เอา/ผ้า/สีน้ำเงิน/คลุม/คัน/ประทีป ตะเกียง กรรไกร/แต่ง/ไส้ตะเกียง ถาด และ/ภาชนะ/ทั้งหมด/สำหรับ/บรรจุ/น้ำมัน/มะกอก/เพื่อ/ใช้/เติม/ตะเกียง <verse eid="NUM 4:9" /><verse number="10" style="v" sid="NUM 4:10" />แล้ว/ใช้/หนัง/พะยูน/ห่อ/ทับ/อีก/รอบ นำ/ทั้ง/ห่อ/ขึ้นไป/วาง/บน/แคร่หาม<verse eid="NUM 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 4:11" />“จาก/นั้น/คลี่/ผ้า/สีน้ำเงิน/คลุม/แท่นบูชา/ทองคำ คลุม/ด้วย/หนัง/พะยูน/อีก/ชั้น แล้ว/สอด/คาน/ลอด/ห่วง/ของ/แท่น<verse eid="NUM 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 4:12" />“พวกเขา/ต้อง/ใช้/ผ้า/สีน้ำเงิน/ห่อ/ภาชนะ/เครื่องใช้/ทั้งหมด/ที่ใช้/ใน/สถาน/นมัสการ คลุมทับ/ด้วย/หนัง/พะยูน แล้ว/นำ/ไป/วาง/บน/แคร่หาม<verse eid="NUM 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 4:13" />“ให้/เขา/เอา/ขี้เถ้า/ออก/จาก/แท่นบูชา/ทอง/สัมฤทธิ์ และ/ใช้/ผ้าสีม่วง/คลุม/แท่น <verse eid="NUM 4:13" /><verse number="14" style="v" sid="NUM 4:14" />แล้ว/เอา/ภาชนะ/เครื่องใช้/ประจำ/แท่น/ทั้งหมด/ได้แก่ ถาด/รอง/ไฟ ขอ/เกี่ยว ทัพพี อ่าง/ประพรม และ/ภาชนะ/อื่นๆ วาง/บน/ผ้านั้น แล้ว/คลุม/ด้วย/หนัง/พะยูน เอา/คาน/สอด/ประจำที่<verse eid="NUM 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 4:15" />“เมื่อ/อาโรน/และ/บรรดา/บุตร/ชาย/คลุม/เครื่อง/ตกแต่ง/อัน/บริสุทธิ์/และ/เครื่องใช้/บริสุทธิ์/เหล่านี้/ทั้งหมด/แล้ว และ/เมื่อ/ทั้ง/ค่าย/พร้อม/จะ/เคลื่อนย้าย คน/โคฮาท/จะ/เข้า/มา/หาม/สิ่ง/เหล่านี้ แต่/พวกเขา/จะ/แตะต้อง/สิ่ง/บริสุทธิ์/ไม่ได้ มิฉะนั้น/จะ/ต้อง/ตาย งาน/ของ/คน/โคฮาท/คือ/การ/แบกหาม/สิ่งต่างๆ ใน/เต็นท์/นัดพบ<verse eid="NUM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 4:16" />“ปุโรหิต/เอเลอาซาร์/บุตร/ชาย/ของ/อาโรน/จะ/รับผิดชอบ/เรื่อง/น้ำมัน/เติม/ประทีป เครื่อง/หอม ธัญ/บูชา/ประจำวัน และ/น้ำมัน/เจิม เขา/มี/หน้าที่/ตรวจตรา/ดูแล/พลับพลา/และ/ของ/ทั้งหมด/ใน/พลับพลา รวมทั้ง/เครื่องใช้/และ/เครื่อง/ตกแต่ง/อัน/บริสุทธิ์/ของ/พลับพลา”<verse eid="NUM 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 4:17" />
    <char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/กับ/โมเสส/และ/อาโรน/ว่า <verse eid="NUM 4:17" /><verse number="18" style="v" sid="NUM 4:18" />“อย่า/ปล่อยให้/บรรดา/คน/ตระกูล/โคฮาท/ถูกตัดขาด/จาก/เผ่าเลวี <verse eid="NUM 4:18" /><verse number="19" style="v" sid="NUM 4:19" />เพื่อ/ป้องกัน/ไม่ให้/เขา/ต้อง/ตาย/เมื่อ/เข้ามา/ใกล้/สิ่ง/บริสุทธิ์ เจ้า/จง/ทำ/ดังนี้/คือ อาโรน/กับ/บรรดา/บุตร/ชาย/จะ/เข้ามา/ใน/สถาน/นมัสการ คอย/กำกับ/ว่า/ให้/แต่ละคน/ทำ/อะไร/และ/ต้อง/แบกหาม/สิ่งใด/บ้าง <verse eid="NUM 4:19" /><verse number="20" style="v" sid="NUM 4:20" />แต่/คน/โคฮาท/จะ/ต้อง/ไม่/เข้าไป/มอง/สิ่ง/บริสุทธิ์/แม้/ชั่ว/อึดใจ มิฉะนั้น/จะ/ต้อง/ตาย”<verse eid="NUM 4:20" /></para>
  <para style="s1">คน/เกอร์โชน</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 4:21" />
    <char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/กับ/โมเสส/ว่า <verse eid="NUM 4:21" /><verse number="22" style="v" sid="NUM 4:22" />“จง/ขึ้น/ทะเบียน/คน/เกอร์โชน/ตาม/ครอบครัว/และ/ตาม/ตระกูล/ของเขา <verse eid="NUM 4:22" /><verse number="23" style="v" sid="NUM 4:23" />จง/นับ/ชาย/ทุกคน/ที่/มี/อายุ/ตั้งแต่/สามสิบ/ถึง/ห้าสิบ/ปี ซึ่ง/มี/คุณสมบัติ/ที่/จะ/มา/รับใช้/ใน/เต็นท์/นัดพบ<verse eid="NUM 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 4:24" />“นี่คือ/หน้าที่/ของ/คน/ตระกูล/เกอร์โชน/ใน/การ/ทำงาน/และ/ขน/สัมภาระ <verse eid="NUM 4:24" /><verse number="25" style="v" sid="NUM 4:25" />พวกเขา/จะ/ต้อง/ขน/ม่าน/พลับพลา เต็นท์/นัดพบ เครื่อง/คลุม/ต่างๆ และ/เครื่อง/คลุม/ชั้นนอก/ที่/ทำ/จาก/หนัง/พะยูน ม่าน/ตรง/ทางเข้า/เต็นท์/นัดพบ <verse eid="NUM 4:25" /><verse number="26" style="v" sid="NUM 4:26" />ม่านกั้น/ลาน/พลับพลา/และ/แท่นบูชา ม่าน/สำหรับ/ทางเข้า เชือก และ/อุปกรณ์/อื่นๆ คน/เกอร์โชน/จะ/ต้อง/รับผิดชอบ/งาน/ที่/เกี่ยวกับ/สิ่ง/เหล่านี้/ทั้งหมด <verse eid="NUM 4:26" /><verse number="27" style="v" sid="NUM 4:27" />อาโรน/และ/บุตร/ชาย/ต้อง/กำกับ/ดูแล และ/มอบหมาย/งาน/ทุกอย่าง/ไม่ว่า/ใน/งาน/แบกหาม/หรือ งาน/อื่นๆ ให้/คน/เกอร์โชน <verse eid="NUM 4:27" /><verse number="28" style="v" sid="NUM 4:28" />นี่คือ/งาน/ของ/ตระกูล/เกอร์โชน/ที่/เต็นท์/นัดพบ โดย/มี/ปุโรหิต/อิธามาร์/บุตร/ชาย/ของ/อาโรน/คอย/กำกับ/ดูแล<verse eid="NUM 4:28" /></para>
  <para style="s1">คน/เมรารี</para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 4:29" />“จง/นับ/คน/เมรารี/ตาม/ตระกูล/และ/ตาม/ครอบครัว/ของเขา <verse eid="NUM 4:29" /><verse number="30" style="v" sid="NUM 4:30" />จง/นับ/ชาย/ทุกคน/ที่/มี/อายุ/ตั้งแต่/สามสิบ/ปี/ถึง/ห้าสิบ/ปี ซึ่งมี/คุณสมบัติ/ที่/จะ/มา/รับใช้/ใน/เต็นท์/นัดพบ <verse eid="NUM 4:30" /><verse number="31" style="v" sid="NUM 4:31" />นี่/เป็น/หน้าที่/ที่/เขา/จะ/ต้อง/ทำ/ที่/เต็นท์/นัดพบ/คือ ขน/ไม้/ฝา/ของ/พลับพลา คาน/ขวาง เสา ฐานรอง/รับ <verse eid="NUM 4:31" /><verse number="32" style="v" sid="NUM 4:32" />เสา/ของ/ลาน/พลับพลา/พร้อมทั้ง/ฐาน/รอง/รับ หลักหมุด เชือก เครื่องใช้ และ/เครื่อง/ประกอบ/อื่นๆ ทั้งหมด จง/มอบ/หน้าที่/แบกหาม/อย่าง/เจาะจง/ให้/แต่ละคน <verse eid="NUM 4:32" /><verse number="33" style="v" sid="NUM 4:33" />นี่คือ/งาน/รับใช้/ของ/ตระกูล/เมรารี/ที่/เต็นท์/นัดพบ โดย/มี/ปุโรหิต/อิธามาร์/บุตร/ชาย/ของ/อาโรน/คอย/กำกับ/ดูแล”<verse eid="NUM 4:33" /></para>
  <para style="s1">การ/นับ/จำนวน/คน/ใน/ตระกูล/เลวี</para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 4:34" />โมเสส อาโรน/และ/บรรดา/ผู้/นำ/ชุมชน/ได้/นับ/คน/โคฮาท/ตาม/ตระกูล/และ/ตาม/ครอบครัว/ต่างๆ ของเขา <verse eid="NUM 4:34" /><verse number="35" style="v" sid="NUM 4:35" />ชาย/ทุกคน/ที่/มี/อายุ/ตั้งแต่/สามสิบ/ปี/ถึง/ห้าสิบ/ปี ซึ่งมี/คุณสมบัติ/ที่/จะ/มา/รับใช้/ใน/เต็นท์/นัดพบ <verse eid="NUM 4:35" /><verse number="36" style="v" sid="NUM 4:36" />นับ/ตาม/ตระกูล/ได้ 2,750 คน <verse eid="NUM 4:36" /><verse number="37" style="v" sid="NUM 4:37" />นี่คือ/ยอดรวม/จำนวน/ตระกูล/โคฮาท/ซึ่ง/รับใช้/ใน/เต็นท์/นัดพบ โมเสส/กับ/อาโรน/ได้/นับ/จำนวน/พวกเขา/ตามที่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรง/บัญชา/ผ่านทาง/โมเสส<verse eid="NUM 4:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 4:38" />เขา/ได้/นับ/คน/เกอร์โชน/ตาม/ตระกูล/และ/ตาม/ครอบครัว/ของเขา <verse eid="NUM 4:38" /><verse number="39" style="v" sid="NUM 4:39" />ชาย/ทุกคน/ที่/มี/อายุ/ตั้งแต่/สามสิบ/ปี/ถึง/ห้าสิบ/ปี/ซึ่งมี/คุณสมบัติ/ที่/จะ/มา/รับใช้/ใน/เต็นท์/นัดพบ <verse eid="NUM 4:39" /><verse number="40" style="v" sid="NUM 4:40" />นับ/ตาม/ตระกูล/และ/ตาม/ครอบครัว/ได้ 2,630 คน <verse eid="NUM 4:40" /><verse number="41" style="v" sid="NUM 4:41" />นี่คือ/ยอดรวม/จำนวน/คน/ตระกูล/เกอร์โชน/ซึ่ง/รับใช้/ที่/เต็นท์/นัดพบ โมเสส/กับ/อาโรน/นับ/จำนวน/พวกเขา/ตามที่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรง/บัญชา<verse eid="NUM 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 4:42" />เขา/ได้/นับ/คน/เมรารี/ตาม/ตระกูล/และ/ตาม/ครอบครัว/ของเขา <verse eid="NUM 4:42" /><verse number="43" style="v" sid="NUM 4:43" />ชาย/ทุกคน/ที่/มี/อายุ/ตั้งแต่/สามสิบ/ปี/ถึง/ห้าสิบ/ปี ซึ่งมี/คุณสมบัติ/ที่/จะ/มา/รับใช้/ใน/เต็นท์/นัดพบ <verse eid="NUM 4:43" /><verse number="44" style="v" sid="NUM 4:44" />นับ/ตาม/ตระกูล/ของ/พวกเขา/ได้ 3,200 คน <verse eid="NUM 4:44" /><verse number="45" style="v" sid="NUM 4:45" />นี่คือ/ยอดรวม/จำนวน/คน/ตระกูล/เมรารี โมเสส/กับ/อาโรน/นับ/จำนวน/พวกเขา/ตามที่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรง/บัญชา/ผ่านทาง/โมเสส<verse eid="NUM 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 4:46" />ดังนั้น/โมเสส อาโรน และ/บรรดา/ผู้/นำ/ของ/อิสราเอล/ได้/นับ/จำนวนคน/เลวี/ทั้งหมด/ตาม/ตระกูล/และ/ตาม/ครอบครัว/ของ/พวกเขา <verse eid="NUM 4:46" /><verse number="47" style="v" sid="NUM 4:47" />ชาย/ทุกคน/ที่/มี/อายุ/ตั้งแต่/สามสิบ/ปี/ถึง/ห้าสิบ/ปี/ซึ่งมี/คุณสมบัติ/ที่/จะ/มา/รับใช้/และ/ขนย้าย/เต็นท์/นัดพบ <verse eid="NUM 4:47" /><verse number="48" style="v" sid="NUM 4:48" />รวม/ทั้งสิ้น 8,580 คน <verse eid="NUM 4:48" /><verse number="49" style="v" sid="NUM 4:49" />แต่ละคน/ได้รับ/มอบหมาย/หน้าที่/และ/รายการ/สิ่ง/ที่/ต้อง/ขนย้าย/ตาม/พระ/บัญชา/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ผ่านทาง/โมเสส</para>
  <para style="p" vid="NUM 4:49">ดังนั้น/พวกเขา/จึง/นับ/จำนวนคน/เลวี/ตามที่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ได้/บัญชา/โมเสส/ไว้<verse eid="NUM 4:49" /></para>
  <chapter eid="NUM 4" />
  <chapter number="5" style="c" sid="NUM 5" />
  <para style="s1">ความ/บริสุทธิ์/ของ/ค่าย</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 5:1" />
    <char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/กับ/โมเสส/ว่า <verse eid="NUM 5:1" /><verse number="2" style="v" sid="NUM 5:2" />“จง/สั่ง/ประชากร/อิสราเอล/ให้/ส่ง/คน/ที่/เป็น/โรคผิวหนัง<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">โดยปกติ/แปลว่า โรคเรื้อน แต่/คำ/ภาษาฮีบรู/อาจ/หมายถึง/โรคผิวหนัง/ชนิดต่างๆ ไม่/จำเป็น/ต้อง/หมายถึง/โรคเรื้อน/เท่านั้น</char></note>ผู้/มี/สิ่ง/ที่/หลั่ง/ออก/หรือ/ผู้/ที่/เป็น/มลทิน/ตาม/ระเบียบ/พิธี/เพราะ/ไป/แตะต้อง/ซากศพ ออกไป/จาก/ค่าย <verse eid="NUM 5:2" /><verse number="3" style="v" sid="NUM 5:3" />ไม่ว่า/จะ/เป็น/หญิง/หรือ/ชาย จง/ส่ง/คน/เหล่านี้/ออกไป/นอกค่าย เพื่อ/ไม่ให้/เป็น/มลทิน/แก่/ค่ายพัก/ซึ่ง/เรา/อยู่/ท่ามกลาง/พวกเขา” <verse eid="NUM 5:3" /><verse number="4" style="v" sid="NUM 5:4" />ชาว/อิสราเอล/ก็/ปฏิบัติ/ตาม/โดย/ส่ง/คน/เหล่านั้น/ออกไป/นอกค่าย/ตามที่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรง/บัญชา/โมเสส<verse eid="NUM 5:4" /></para>
  <para style="s1">การชดใช้/เมื่อ/ทำ/ผิด</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 5:5" />
    <char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/กับ/โมเสส/ว่า <verse eid="NUM 5:5" /><verse number="6" style="v" sid="NUM 5:6" />“จง/แจ้ง/ประชากร/อิสราเอล/ว่า ‘เมื่อ/หญิง/หรือ/ชาย/ใด/ทำ/ผิด/ต่อ/คนอื่น/อย่าง/หนึ่ง/อย่างใด ผู้/นั้น/ย่อม/มี/ความผิด/เพราะ/ไม่/ซื่อสัตย์/ต่อ/<char style="nd">องค์/พระผู้เป็นเจ้า</char> <verse eid="NUM 5:6" /><verse number="7" style="v" sid="NUM 5:7" />เขา/จะ/ต้อง/สารภาพ/บาป/และ/ชดใช้/เต็ม/จำนวน/ตาม/ความเสียหาย และ/ชดใช้/เพิ่มอีก/หนึ่ง/ใน/ห้า/ให้แก่/ผู้/เสียหาย <verse eid="NUM 5:7" /><verse number="8" style="v" sid="NUM 5:8" />แต่/หาก/ผู้/เสียหาย/ไม่มี/ญาติสนิท/ที่/จะ/รับ/แทน ค่า/ชดใช้/นั้น/เป็น/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/และ/ต้อง/นำไป/มอบ/แก่/ปุโรหิต/พร้อมด้วย/แกะตัวผู้/สำหรับ/ขออภัย/โทษ/บาป/ให้/เขา <verse eid="NUM 5:8" /><verse number="9" style="v" sid="NUM 5:9" />ของ/ถวาย/อัน/บริสุทธิ์/ทั้งหมด/ที่/ประชากร/อิสราเอล/นำมา/มอบ/แก่/ปุโรหิต/ถือเป็น/ของ/ปุโรหิต <verse eid="NUM 5:9" /><verse number="10" style="v" sid="NUM 5:10" />ของ/ถวาย/อัน/บริสุทธิ์/ของ/แต่ละคน/เป็น/กรรมสิทธิ์/ของเขา/เอง แต่/สิ่ง/ที่/ยกให้/ปุโรหิต/จะ/เป็น/ของ/ปุโรหิต’ ”<verse eid="NUM 5:10" /></para>
  <para style="s1">ทดสอบ/ภรรยา/ที่/ไม่ซื่อสัตย์</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 5:11" />แล้ว/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/กับ/โมเสส/ว่า <verse eid="NUM 5:11" /><verse number="12" style="v" sid="NUM 5:12" />“จง/แจ้ง/ประชากร/อิสราเอล/ว่า ‘ภรรยา/ของ/ชายคน/ใด/คบชู้/และ/ไม่/ซื่อสัตย์/ต่อ/เขา <verse eid="NUM 5:12" /><verse number="13" style="v" sid="NUM 5:13" />โดย/ไป/นอน/กับ/ชาย/อื่น/และ/ยัง/เป็น/ความลับ ไม่/เป็น/ที่/ประจักษ์/ต่อ/สามี (เพราะว่า/ไม่มี/พยาน/หลักฐาน/และ/จับ/ไม่ได้/คาหนังคาเขา) <verse eid="NUM 5:13" /><verse number="14" style="v" sid="NUM 5:14" />และ/ถ้า/สามี/รู้สึก/หึงหวง และ/สงสัย/ใน/ตัว/ภรรยา/ของ/ตน ไม่ว่า/ภรรยา/จะ/ทำ/ผิดหรือ/ไม่/ก็/ตาม <verse eid="NUM 5:14" /><verse number="15" style="v" sid="NUM 5:15" />เขา/จะ/ต้อง/พา/ภรรยา/และ/เครื่อง/บูชา/ของ/เธอ/คือ/แป้ง/บาร์เลย์/ประมาณ 2 ลิตร<note caller="+" style="f"><char style="fr" closed="false">5:15 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า หนึ่งในสิบ/เอฟาห์</char></note>มาหา/ปุโรหิต/โดย/ไม่ต้อง/เคล้า/น้ำมัน/หรือ/โรย/เครื่อง/หอม เพราะ/เป็น/ธัญ/บูชา/เรื่อง/ความ/หึงหวง และ/เป็น/เครื่อง/บูชา/ที่/เตือน/ให้/ระลึก/ถึง/ความผิด<verse eid="NUM 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 5:16" />“ ‘ปุโรหิต/จะ/พา/นาง/มา/ยืน/อยู่/ต่อหน้า/<char style="nd">องค์/พระผู้เป็นเจ้า</char> <verse eid="NUM 5:16" /><verse number="17" style="v" sid="NUM 5:17" />จาก/นั้น/เขา/จะ/เอา/น้ำ/บริสุทธิ์/บรรจุ/ใน/ภาชนะ/ดินเผา ผสม/ฝุ่น/ที่/พื้น/พลับพลา/ลงใน/น้ำ/นั้น <verse eid="NUM 5:17" /><verse number="18" style="v" sid="NUM 5:18" />หลังจาก/ปุโรหิต/พา/นาง/มา/ยืน/อยู่/ต่อหน้า/<char style="nd">องค์/พระผู้เป็นเจ้า</char> เขา/จะ/ปล่อย/ผม/ของ/นาง และ/ให้/นาง/ถือ/เครื่อง/บูชา/ที่/เตือน/ให้/ระลึก/ถึง/ความผิด/และ/ธัญ/บูชา/เรื่อง/ความ/หึงหวง ใน/ขณะที่/ปุโรหิต/ถือ/น้ำ/ขม/แห่ง/คำสาป <verse eid="NUM 5:18" /><verse number="19" style="v" sid="NUM 5:19" />ปุโรหิต/จะ/ให้/นาง/สาบาน/ตน/แล้ว/พูดกับ/นาง/ว่า “หาก/ไม่มี/ชาย/อื่น/หลับนอน/กับ/เจ้า และ/เจ้า/ไม่ได้/หลงผิด และ/ไม่/เป็น/มลทิน/ขณะ/อยู่/กิน/กับ/สามี/ของ/เจ้า ขอให้/น้ำขม/ที่/นำ/คำ/สาปแช่ง/มา/นี้/ไม่ทำ/อันตราย/เจ้า <verse eid="NUM 5:19" /><verse number="20" style="v" sid="NUM 5:20" />แต่/หาก/เจ้า/หลงผิด/ขณะที่/ยังอยู่/กิน/กับ/สามี และ/เจ้า/ได้/ทำ/ตัว/ให้/เป็น/มลทิน/โดย/หลับนอน/กับ/ชาย/อื่น/ที่ไม่ใช่/สามี” <verse eid="NUM 5:20" /><verse number="21" style="v" sid="NUM 5:21" />จาก/นั้น/ปุโรหิต/จะ/ให้/นาง/สาบาน/ว่า “ขอ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรงทำให้/ประชากร/ของ/เจ้า/สาปแช่ง/และ/ประณาม/เจ้า/เมื่อ/พระองค์/ทำให้/เจ้า/แท้งลูก/และ/เป็น/หมัน<note caller="+" style="f"><char style="fr" closed="false">5:21 </char><char style="ft" closed="false">หรือ/</char><char style="fqa" closed="false">ทำให้/ท้อง/เจ้า/บวม/และ/โคนขา/เจ้า/เสีย/ไป/</char><char style="ft" closed="false">เช่น/เดียว/กับ/ข้อ 22 และ 27</char></note> <verse eid="NUM 5:21" /><verse number="22" style="v" sid="NUM 5:22" />ขอให้/น้ำ/นี้/นำ/คำ/สาปแช่ง/เข้าสู่/ร่างกาย/ของ/เจ้า ทำให้/เจ้า/แท้งลูก/และ/เป็น/หมัน”</para>
  <para style="p" vid="NUM 5:22">“ ‘แล้ว/นาง/ต้อง/กล่าว/ว่า “อาเมน ขอให้/เป็น/ไป/ตาม/นั้น/เถิด<note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">อาเมน อาเมน</char></note>”<verse eid="NUM 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 5:23" />“ ‘ปุโรหิต/จะ/เขียน/คำ/สาปแช่ง/เหล่านี้/ลง/บน/หนังสือ/ม้วน แล้ว/นำ/มา/ล้างออก/ใน/น้ำขม/นี้ <verse eid="NUM 5:23" /><verse number="24" style="v" sid="NUM 5:24" />แล้ว/ปุโรหิต/จะ/ให้/นาง/ดื่มน้ำ/ขม/แห่ง/คำ/สาปแช่ง น้ำ/นี้/จะ/เข้า/ไป/ใน/ตัว/นาง/และ/ทำให้/นาง/ทุกข์/ทรมาน <verse eid="NUM 5:24" /><verse number="25" style="v" sid="NUM 5:25" />ปุโรหิต/จะ/รับ/ธัญ/บูชา/เรื่อง/ความ/หึงหวง/จาก/มือ/ของ/นาง นำมา/ยื่น/ถวาย/ต่อหน้า/<char style="nd">องค์/พระผู้เป็นเจ้า</char> แล้ว/นำ/มา/ที่/แท่นบูชา <verse eid="NUM 5:25" /><verse number="26" style="v" sid="NUM 5:26" />ต่อ/จากนั้น/ปุโรหิต/จะ/กอบ/ธัญ/บูชา/ขึ้นมา/กำมือ/หนึ่ง เป็น/เครื่อง/บูชา/ส่วน/อนุสรณ์ เผา/บน/แท่น/บูชา แล้ว/ให้/นาง/ดื่มน้ำ/นี้ <verse eid="NUM 5:26" /><verse number="27" style="v" sid="NUM 5:27" />หาก/นาง/ได้/ทำ/ตัว/ให้/เป็น/มลทิน/และ/ไม่ซื่อสัตย์/ต่อ/สามี เมื่อ/ปุโรหิต/ให้/นาง/ดื่มน้ำ/ที่/นำ/การสาปแช่ง/มา น้ำ/จะ/เข้า/ไป/ใน/ตัว/ของ/นาง/และ/ทำให้/นาง/ทุกข์/ทรมาน/อย่าง/แสน/สาหัส ทำให้/นาง/เป็น/หมัน/หรือ/แท้งลูก/ไป นาง/จะ/เป็น/ที่/สาปแช่ง/ใน/หมู่/ประชากร/ของ/นาง <verse eid="NUM 5:27" /><verse number="28" style="v" sid="NUM 5:28" />แต่/หาก/นาง/ไม่/เป็น/มลทิน/และ/บริสุทธิ์ ไม่ได้/คบชู้ นาง/จะ/พ้นผิด/และ/จะ/สามารถ/มี/ลูก/ได้<verse eid="NUM 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 5:29" />“ ‘นี่คือ/บทบัญญัติ/เรื่อง/ความ/หึงหวง เมื่อ/ภรรยา/ได้/หลงผิด/และ/ทำ/ตัว/ให้/เป็น/มลทิน/โดย/นอกใจ/หรือ/มีชู้ <verse eid="NUM 5:29" /><verse number="30" style="v" sid="NUM 5:30" />หรือ/เมื่อ/สามี/รู้สึก/หึงหวง/และ/สงสัย/ใน/ตัว/ภรรยา ปุโรหิต/จะ/นำ/นาง/มา/ยืนอยู่/ต่อหน้า/<char style="nd">องค์พระผู้เป็นเจ้า</char>/และ/ดำเนิน/การ/ตามที่/กล่าว/มา/แล้ว <verse eid="NUM 5:30" /><verse number="31" style="v" sid="NUM 5:31" />สามี/ของ/นาง/จะ/ไม่ต้อง/รับผิด/ใดๆ แต่/นาง/ต้อง/รับ/ผล/เพราะ/บาป/ของ/นาง’ ”<verse eid="NUM 5:31" /></para>
  <chapter eid="NUM 5" />
  <chapter number="6" style="c" sid="NUM 6" />
  <para style="s1">นาศีร์</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 6:1" />
    <char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/กับ/โมเสส/ว่า <verse eid="NUM 6:1" /><verse number="2" style="v" sid="NUM 6:2" />“จง/แจ้ง/ชน/อิสราเอล/ว่า ‘ชาย/หรือ/หญิง/คน/ใด/ถวาย/สัตย์/ปฏิญาณ/เป็น/พิเศษ/ว่า/จะ/เป็น/นาศีร์/อุทิศ/ตน/แด่/<char style="nd">องค์/พระผู้เป็นเจ้า</char> <verse eid="NUM 6:2" /><verse number="3" style="v" sid="NUM 6:3" />เขา/ต้อง/งด/เครื่องดื่ม/มึนเมา/หรือ/เหล้าองุ่น น้ำองุ่น ผลองุ่น/สด/หรือ/ลูกเกด และ/น้ำส้มสายชู/ที่/ได้/จาก/เหล้าองุ่น <verse eid="NUM 6:3" /><verse number="4" style="v" sid="NUM 6:4" />ตลอด/ระยะเวลา/ที่/เขา/เป็น/นาศีร์/นั้น เขา/จะ/ไม่กิน/สิ่งใด/ที่/มา/จาก/ต้นองุ่น แม้แต่/เมล็ด/หรือ/เปลือก/องุ่น<verse eid="NUM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 6:5" />“ ‘ตลอด/ช่วงนั้น/เขา/จะ/ไม่/ตัดผม เขา/ต้อง/รักษา/ตน/ให้/บริสุทธิ์ เขา/จึง/ต้อง/ไว้/ผมยาว <verse eid="NUM 6:5" /><verse number="6" style="v" sid="NUM 6:6" />ตลอด/ระยะเวลา/ที่/เขา/เป็น/นาศีร์<note caller="+" style="f"><char style="fr" closed="false">6:6 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า/</char><char style="fqa" closed="false">ตลอด/ระยะเวลา/ที่/เขา/แยก/ตัว/ออก/</char><char style="ft" closed="false">เช่น/เดียว/กับ/ข้อ 8 และ 12</char></note>ถวาย/แด่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/เขา/จะ/ต้อง/ไม่/ย่างกราย/เข้าใกล้/ซากศพ <verse eid="NUM 6:6" /><verse number="7" style="v" sid="NUM 6:7" />แม้ว่า/จะ/เป็น/ศพ/ของ/บิดา/มารดา/หรือ/พี่น้อง/ชาย/หญิง เขา/จะ/ต้อง/ไม่ทำ/ตัว/ให้/เป็น/มลทิน/ตาม/ระเบียบ/พิธี เพราะ/สัญลักษณ์/แห่ง/การ/เป็น/นาศีร์/อยู่/บน/ศีรษะ/ของเขา <verse eid="NUM 6:7" /><verse number="8" style="v" sid="NUM 6:8" />ตลอด/ระยะเวลา/ที่/เขา/เป็น/นาศีร์ เขา/ต้อง/ชำระ/ตัว/ให้/บริสุทธิ์/แยก/ไว้/แด่/องค์/พระผู้เป็นเจ้า<verse eid="NUM 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 6:9" />“ ‘หาก/มี/คน/มา/ตาย/อยู่/ข้าง/ตัว/เขา/โดย/ปัจจุบัน/ทัน/ด่วน ทำให้/ผม/ที่/เขา/ถวาย/ปฏิญาณ/ไว้/เป็น/มลทิน เขา/ต้อง/โกน/ศีรษะ/ใน/วัน/ชำระ/ตัว/คือ/วันที่/เจ็ด <verse eid="NUM 6:9" /><verse number="10" style="v" sid="NUM 6:10" />ใน/วันที่/แปด/เขา/ต้อง/นำ/นกเขา/หรือ/นกพิราบ/รุ่น/สอง/ตัว/มา/มอบ/แก่/ปุโรหิต/ตรง/ทางเข้า/เต็นท์/นัดพบ <verse eid="NUM 6:10" /><verse number="11" style="v" sid="NUM 6:11" />ปุโรหิต/จะ/ถวาย/นก/ตัวหนึ่ง/เป็น/เครื่อง/บูชา/ไถ่บาป อีก/ตัวหนึ่ง/เป็น/เครื่อง/เผา/บูชา/เพื่อ/ลบ/บาป/สำหรับ/ผู้/นั้น เพราะ/เขา/ได้/ทำ/บาป/โดย/การ/อยู่/ใกล้/ซากศพ ใน/วัน/เดียวกัน/นั้น/เขา/ต้อง/ชำระ/ศีรษะ/ถวาย/อีก/ครั้ง <verse eid="NUM 6:11" /><verse number="12" style="v" sid="NUM 6:12" />เขา/ต้อง/อุทิศ/ตน/แด่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ตลอด/ระยะเวลา/ที่/เขา/เป็น/นาศีร์ และ/นำแกะ/ผู้/อายุ/หนึ่ง/ขวบ/ตัวหนึ่ง/มา/เป็น/เครื่อง/บูชา/ลบ/ความผิด วัน/อื่นๆ ก่อนหน้า/นั้น/ไม่นับ เพราะ/เขา/ได้/เป็น/มลทิน/ตลอด/ระยะเวลา/ที่/เขา/เป็น/นาศีร์<verse eid="NUM 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 6:13" />“ ‘เมื่อ/ครบ/กำหนด/การ/เป็น/นาศีร์/ตาม/กฎ/ของ/นาศีร์/แล้ว เขา/จะ/ต้อง/มา/ที่/ทางเข้า/เต็นท์/นัดพบ <verse eid="NUM 6:13" /><verse number="14" style="v" sid="NUM 6:14" />และ/ถวาย/สัตว์/ที่/ไม่มี/ตำหนิ/แด่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/คือ ถวาย/ลูกแกะ/ตัวผู้/อายุ/หนึ่ง/ขวบ/หนึ่ง/ตัว/เป็น/เครื่อง/เผา/บูชา ลูกแกะ/ตัวเมีย/อายุ/หนึ่ง/ขวบ/หนึ่ง/ตัว/เป็น/เครื่อง/บูชา/ไถ่บาป และ/แกะผู้/อีก/หนึ่ง/ตัว/เป็น/เครื่อง/สันติ/บูชา <verse eid="NUM 6:14" /><verse number="15" style="v" sid="NUM 6:15" />พร้อมกับ/ธัญ/บูชา/และ/เครื่องดื่ม/บูชา ขนมปัง/ไม่/ใส่/เชื้อ/หนึ่ง/กระจาด/อัน/ได้แก่ ขนมปัง/ที่/ทำ/จาก/แป้ง/ละเอียด/เคล้า/น้ำมัน และ/ขนมปัง/แผ่น/บาง/ทา/ด้วย/น้ำมัน<verse eid="NUM 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 6:16" />“ ‘ปุโรหิต/จะ/ยื่น/ถวาย/ของ/เหล่านี้/ต่อหน้า/<char style="nd">องค์พระผู้เป็นเจ้า</char>/แล้ว/ถวาย/เครื่อง/บูชา/ไถ่บาป/และ/เครื่อง/เผา/บูชา <verse eid="NUM 6:16" /><verse number="17" style="v" sid="NUM 6:17" />จาก/นั้น/เขา/จะ/ถวาย/ขนมปัง/ไม่/ใส่/เชื้อ/กระจาด/นั้น และ/แกะตัวผู้/เป็น/เครื่อง/สันติ/บูชา/พร้อมด้วย/ธัญ/บูชา/และ/เครื่องดื่ม/บูชา/แด่/องค์/พระผู้เป็นเจ้า<verse eid="NUM 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 6:18" />“ ‘แล้ว/นาศีร์/ต้อง/โกน/ผม/ออก/ตามที่/ปฏิญาณ/อุทิศ/ตน/นั้น/ที่/ทาง/เข้า/เต็นท์/นัดพบ และ/นำ/ผม/นั้น/ไป/ใส่/ใน/ไฟ/ที่/เผา/เครื่อง/สันติ/บูชา/อยู่<verse eid="NUM 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 6:19" />“ ‘เมื่อ/นาศีร์/นั้น/โกน/ผม/เสร็จแล้ว ปุโรหิต/จะ/นำ/โคนขา/หน้า/ของ/แกะผู้/ที่/ต้ม/แล้ว ขนมปัง/ไม่/ใส่/เชื้อ และ/ขนมปัง/แผ่น/บาง/ไม่/ใส่/เชื้อ/จาก/กระจาด/นั้น/ใส่/ไว้/ใน/มือ/ของเขา <verse eid="NUM 6:19" /><verse number="20" style="v" sid="NUM 6:20" />แล้ว/ปุโรหิต/จะ/ยื่น/ถวาย/สิ่ง/เหล่านั้น/ต่อหน้า/องค์/พระผู้เป็นเจ้า/เป็น/เครื่อง/บูชา/ยื่น/ถวาย ทั้งหมด/นั้น/เป็น/ของ/บริสุทธิ์ เป็น/ส่วน/ของ/ปุโรหิต/พร้อมกับ/เนื้อ/อก/และ/โคนขา/ซึ่ง/ยื่นถวาย/แด่/พระองค์ หลังจาก/นั้น/นาศีร์/ผู้/นั้น/จึง/ดื่ม/เหล้าองุ่น/ได้<verse eid="NUM 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 6:21" />“ ‘ทั้งหมด/นี้/คือ/บทบัญญัติ/ของ/นาศีร์ ผู้/ที่/ถวาย/ปฏิญาณ/แด่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ตาม/การ/อุทิศ/ตัว/ของเขา นอกจากนี้/เขา/จะ/ถวาย/สิ่ง/อื่น/อีก/ก็/ได้ แต่/เขา/จะ/ต้อง/ทำ/ตาม/คำปฏิญาณ ตาม/กฎ/ของ/นาศีร์/ให้/สำเร็จ’ ”<verse eid="NUM 6:21" /></para>
  <para style="s1">พร/จาก/ปุโรหิต</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 6:22" />
    <char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/กับ/โมเสส/ว่า <verse eid="NUM 6:22" /><verse number="23" style="v" sid="NUM 6:23" />“จง/บอก/อาโรน/กับ/บุตร/ชาย/ว่า ‘นี่/เป็น/วิธี/ที่/เจ้า/จะ/อวยพร/ชน/อิสราเอล จง/กล่าว/แก่/พวกเขา/ดังนี้<verse eid="NUM 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 6:24" />“ ‘ “ขอ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรง/อำนวยพร</para>
  <para style="q1" vid="NUM 6:24">และ/ทรง/พิทักษ์/รักษา/ท่าน<verse eid="NUM 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="NUM 6:25" />ขอให้/พระพักตร์/ของ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทอแสง/เหนือ/ท่าน</para>
  <para style="q1" vid="NUM 6:25">ขอ/พระองค์/ทรง/เมตตา/กรุณา/ท่าน<verse eid="NUM 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="NUM 6:26" />ขอ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ทรง/โปรดปราน/ท่าน<note caller="+" style="f"><char style="fr" closed="false">6:26 </char><char style="ft" closed="false">หรือ/</char><char style="fqa" closed="false"><char style="nd">องค์/พระผู้เป็นเจ้า</char>/ทรง/หัน/พระพักตร์/มาหา/ท่าน</char></note></para>
  <para style="q1" vid="NUM 6:26">และ/ประทาน/สันติสุข/แก่/ท่าน” ’<verse eid="NUM 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 6:27" />“ดังนั้น/อาโรน/กับ/บุตร/ชาย/จะ/ประทับ/นาม/ของเรา/เหนือ/อิสราเอล และ/เรา/จะ/อวยพร/พวกเขา”<verse eid="NUM 6:27" /></para>
  <chapter eid="NUM 6" />
  <chapter number="7" style="c" sid="NUM 7" />
  <para style="s1">ของ/ถวาย/เมื่อ/ถวาย/พลับพลา</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 7:1" />เมื่อ/โมเสส/สร้าง/พลับพลา/เสร็จแล้ว เขา/เจิม/และ/ชำระ/พลับพลา/กับ/ส่วน/ประกอบ/ทั้งหมด รวมทั้ง/แท่นบูชา/และ/ภาชนะ/เครื่องใช้/ทุกอย่าง/สำหรับ/แท่นบูชา <verse eid="NUM 7:1" /><verse number="2" style="v" sid="NUM 7:2" />บรรดา/ผู้/นำ/ของ/อิสราเอล/และ/หัวหน้า/ครอบครัว/ต่างๆ ได้/ถวาย/เครื่อง/บูชา พวกเขา/เป็น/หัวหน้า/เผ่า/ต่างๆ ซึ่ง/รับผิดชอบ/ผู้/ที่/ได้/ขึ้น/ทะเบียน/ไว้ <verse eid="NUM 7:2" /><verse number="3" style="v" sid="NUM 7:3" />พวกเขา/นำ/เกวียน/หก/เล่ม/และ/วัว/สิบสอง/ตัว/มา/ถวาย/แด่/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ผู้/นำ/สอง/คน/ถวาย/เกวียน/เล่มหนึ่ง/กับ/วัว/คน/ละ/ตัว/ตรง/หน้า/พลับพลา<verse eid="NUM 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 7:4" />
    <char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/กับ/โมเสส/ว่า <verse eid="NUM 7:4" /><verse number="5" style="v" sid="NUM 7:5" />“จง/รับ/ของ/ถวาย/จาก/เขา/เถิด และ/ใช้/วัว/กับ/เกวียน/เหล่านั้น/สำหรับ/งาน/ที่/เต็นท์/นัดพบ จง/มอบ/ของ/เหล่านั้น/ให้/คน/เลวี/ไว้/ใช้/ใน/งาน/ของเขา/แต่ละคน”<verse eid="NUM 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 7:6" />โมเสส/จึง/นำ/เกวียน/และ/วัว/ไป/มอบให้/คน/เลวี <verse eid="NUM 7:6" /><verse number="7" style="v" sid="NUM 7:7" />เขา/มอบ/เกวียน/สอง/เล่ม/และ/วัว/สี่ตัว/ให้/คน/เกอร์โชน/เพื่อ/ใช้สอย/ใน/งาน/ของเขา <verse eid="NUM 7:7" /><verse number="8" style="v" sid="NUM 7:8" />มอบ/เกวียน/สี่/เล่ม/พร้อม/วัว/แปด/ตัว/แก่/คน/เมรารี/เพื่อ/ใช้/ใน/งาน/ของเขา คน/เหล่านี้/อยู่/ใต้/บังคับ/บัญชา/ของ/ปุโรหิต/อิธามาร์/บุตร/ของ/อาโรน <verse eid="NUM 7:8" /><verse number="9" style="v" sid="NUM 7:9" />แต่/โมเสส/ไม่ได้/มอบ/สิ่งใด/ให้/คน/โคฮาท เพราะ/พวกเขา/จะ/ต้อง/หาม/เครื่องใช้/ศักดิ์สิทธิ์/ตามที่/พวกเขา/รับผิดชอบ<verse eid="NUM 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 7:10" />ใน/วันที่/เจิม/แท่นบูชา บรรดา/ผู้/นำ/ได้/นำ/เครื่อง/บูชา/มา/ถวาย/ที่/แท่น/บูชา <verse eid="NUM 7:10" /><verse number="11" style="v" sid="NUM 7:11" />เพราะ/<char style="nd">องค์พระผู้เป็นเจ้า</char>/ตรัส/กับ/โมเสส/ว่า “ให้/ผู้/นำ/แต่ละคน/นำ/ของ/ถวาย/มา/คน/ละ/วัน/เพื่อ/มอบถวาย/แท่นบูชา”<verse eid="NUM 7:11" /></para>
  <para style="b" />
  <para style="m">
    <verse number="12" style="v" sid="NUM 7:12" />ใน/วันแรก/นาห์โชน/บุตร/อัมมีนาดับ/แห่ง/เผ่ายูดาห์/นำ/ของ/มา/ถวาย ได้แก่<verse eid="NUM 7:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="NUM 7:13" />จานเงิน/หนึ่ง/ใบ/หนัก/ประมาณ 1.5 กิโลกรัม<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า 130 เชเขล ตาม/เชเขล/ของ/สถาน/นมัสการ เช่น/เดียว/กับ/ที่อื่น/ใน/บทนี้</char></note> อ่าง/ประพรม ทำ/จาก/เงิน/หนึ่ง/ใบ/หนัก/ประมาณ 800 กรัม<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า 70 เชเขล/ตาม/เชเขล/ของ/สถาน/นมัสการ เช่น/เดียว/กับ/ที่อื่น/ใน/บทนี้</char></note> ทั้ง/จาน/และ/ชาม/ใส่/แป้ง/ละเอียด/เคล้า/น้ำมัน/สำหรับ/เป็น/ธัญ/บูชา <verse eid="NUM 7:13" /><verse number="14" style="v" sid="NUM 7:14" />จาน/ทองคำ/หนึ่ง/ใบ/หนัก/ประมาณ 110 กรัม<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="ft" closed="false">ภาษาฮีบรู/ว่า 10 เชเขล ตาม/เชเขล/ของ/สถาน/นมัสการ เช่น/เดียว/กับ/ที่อื่น/ใน/บทนี้</char></note> บรรจุ/เครื่อง/หอม <verse eid="NUM 7:14" /><verse number="15" style="v" sid="NUM 7:15" />วัว/หนุ่ม/หนึ่ง/ตัว แกะผู้/หนึ่ง/ตัว ลูกแกะ/ตัวผู้/อายุ/หนึ่ง/ขวบ/หนึ่ง/ตัว/สำหรับ/เป็น/เครื่อง/เผา/บูชา <verse eid="NUM 7:15" /><verse number="16" style="v" sid="NUM 7:16" />แพะผู้/หนึ่ง/ตัว/เป็น/เครื่อง/บูชา/ไถ่บาป <verse eid="NUM 7:16" /><verse number="17" style="v" sid="NUM 7:17" />วัว/ผู้/สอง/ตัว แกะผู้/ห้าตัว แพะผู้/ห้าตัว และ/ลูกแกะ/ตัวผู้/อายุ/หนึ่ง/ขวบ/ห้าตัว สำหรับ/เป็น/เครื่อง/สันติ/บูชา นี่คือ/ของ/ถวาย/จาก/นาห์โชน/บุตร/อัมมีนาดับ<verse eid="NUM 7:17" /></para>
  <para style="b" />
  <para style="m">
    <verse number="18" style="v" sid="NUM 7:18" />วันที่/สอง เนธันเอล/บุตร/ศุอาร์/ผู้/นำ/เผ่า/อิสสาคาร์/นำ/ของ/มา/ถวาย ได้แก่<verse eid="NUM 7:18" /></para>
  <para style="mi">
    <verse number="19" style="v" sid="NUM 7:19" />จานเงิน/หนึ่ง/ใบ/หนัก/ประมาณ 1.5 กิโลกรัม อ่าง/ประพรม/ทำ/จาก/เงิน/หนึ่ง/ใบ/หนัก/ประมาณ 800 กรัม ทั้ง/จาน/และ/ชาม/ใส่/แป้ง/ละเอียด/เคล้า/น้ำมัน/สำหรับ/เป็น/ธัญ/บูชา <verse eid="NUM 7:19" /><verse number="20" style="v" sid="NUM 7:20" />จาน/ทองคำ/หนึ่ง/ใบ/หนัก/ประมาณ 110 กรัม/บรรจุ/เครื่อง/หอม <verse eid="NUM 7:20" /><verse number="21" style="v" sid="NUM 7:21" />วัว/หนุ่ม/หนึ่ง/ตัว แกะผู้/หนึ่ง/ตัว ลูกแกะ/ตัวผู้/อายุ/หนึ่ง/ขวบ/หนึ่ง/ตัว สำหรับ/เป็น/เครื่อง/เผา/บูชา <verse eid="NUM 7:21" /><verse number="22" style="v" sid="NUM 7:22" />แพะผู้/หนึ่ง/ตัว/เป็น/เครื่อง/บูชา/ไถ่บาป <verse eid="NUM 7:22" /><verse number="23" style="v" sid="NUM 7:23" />วัว/ผู้/สอง/ตัว แกะผู้/ห้าตัว แพะผู้/ห้าตัว และ/ลูกแกะ/ตัวผู้/อายุ/หนึ่ง/ขวบ/ห้าตัว/สำหรับ/เป็น/เครื่อง/สันติ/บูชา นี่คือ/ของ/ถวาย/จาก/เนธันเอล/บุตร/ศุอาร์<verse eid="NUM 7:23" /></para>
  <para style="b" />
  <para style="m">
    <verse number="24" style="v" sid="NUM 7:24" />วันที่/สาม เอลีอับ/บุตร/เฮโลน/ผู้/นำ/เผ่า/เศบูลุน/นำ/ของ/มา/ถวาย ได้แก่<verse eid="NUM 7:24" /></para>
  <para style="mi">
    <verse number="25" style="v" sid="NUM 7:25" />จานเงิน/หนึ่ง/ใบ/หนัก/ประมาณ 1.5 กิโลกรัม อ่าง/ประพรม/ทำ/จาก/เงิน/หนึ่ง/ใบ/หนัก/ประมาณ 800 กรัม ทั้ง/จาน/และ/ชาม/ใส่/แป้ง/ละเอียด/เคล้า/น้ำมัน/สำหรับ/เป็น/ธัญ/บูชา <verse eid="NUM 7:25" /><verse number="26" style="v" sid="NUM 7:26" />จาน/ทองคำ/หนึ่ง/ใบ/หนัก/ประมาณ 110 กรัม/บรรจุ/เครื่อง/หอม <verse eid="NUM 7:26" /><verse number="27" style="v" sid="NUM 7:27" />วัว/หนุ่ม/หนึ่ง/ตัว แกะผู้/หนึ่ง/ตัว ลูกแกะ/ตัวผู้/อายุ/หนึ่ง/ขวบ/หนึ่ง/ตัว สำหรับ/เป็น/เครื่อง/เผา/บูชา <verse eid="NUM 7:27" /><verse number="28" style="v" sid="NUM 7:28" />แพะผู้/หนึ่ง/ตัว/เป็น/เครื่อง/บูชา/ไถ่บาป <verse eid="NUM 7:28" /><verse number="29" style="v" sid="NUM 7:29" />วัว/ผู้/สอง/ตัว แกะผู้/ห้าตัว แพะผู้/ห้าตัว และ/ลูกแกะ/ตัวผู้/อายุ/หนึ่ง/ขวบ/ห้าตัว/สำหรับ/เป็น/เครื่อง/สันติ/บูชา นี่คือ/ของ/ถวาย/จาก/เอลีอับ/บุตร/เฮโลน<verse eid="NUM 7:29" /></para>
  <para style="b" />
  <para style="m">
    <verse number="30" style="v" sid="NUM 7:30" />วันที่/สี่ เอลีซูร์/บุตร/เชเดเออร์/ผู้/นำ/เผ่ารูเบน/นำ/ของ/มา/ถวาย ได้แก่<verse eid="NUM 7:30" /></para>
  <para style="mi">
    <verse number="31" style="v" sid="NUM 7:31" />จานเงิน/หนึ่ง/ใบ/หนัก/ประมาณ 1.5 กิโลกรัม อ่าง/ประพรม/ทำ/จาก/เงิน/หนึ่ง/ใบ/หนัก/ประมาณ 800 กรัม ทั้ง/จาน/และ/ชาม/ใส่/แป้ง/ละเอียด/เคล้า/น้ำมัน/สำหรับ/เป็น/ธัญ/บูชา <verse eid="NUM 7:31" /><verse number="32" style="v" sid="NUM 7:32" />จาน/ทองคำ/หนึ่ง/ใบ/หนัก/ประมาณ 110 กรัม/บรรจุ/เครื่อง/หอม <verse eid="NUM 7:32" /><verse number="33" style="v" sid="NUM 7:33" />วัว/หนุ่ม/หนึ่ง/ตัว แกะผู้/หนึ่ง/ตัว ลูกแกะ/ตัวผู้/อายุ/หนึ่ง/ขวบ/หนึ่ง/ตัว/สำหรับ/เป็น/เครื่อง/เผา/บูชา <verse eid="NUM 7:33" /><verse number="34" style="v" sid="NUM 7:34" />แพะผู้/หนึ่ง/ตัว/เป็น/เครื่อง/บูชา/ไถ่บาป <verse eid="NUM 7:34" /><verse number="35" style="v" sid="NUM 7:35" />วัว/ผู้/สอง/ตัว แกะผู้/ห้าตัว แพะผู้/ห้าตัว และ/ลูกแกะ/ตัวผู้/อายุ/หนึ่ง/ขวบ/ห้าตัว/สำหรับ/เป็น/เครื่อง/สันติ/บูชา นี่คือ/ของ/ถวาย/จาก/เอลีซูร์/บุตร/เชเดเออร์<verse eid="NUM 7:35" /></para>
  <para style="b" />
  <para style="m">
