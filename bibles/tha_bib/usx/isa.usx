  <para style="q1" vid="ISA 34:17">และ/อาศัย/อยู่/ที่/นั่น/ตลอด/ทุก/ชั่วอายุ<verse eid="ISA 34:17" /></para>
  <chapter eid="ISA 34" />
  <chapter number="35" style="c" sid="ISA 35" />
  <para style="s1">ความ/ชื่นชม/ยินดี/ของ/ผู้/รับ/การไถ่</para>
