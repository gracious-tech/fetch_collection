<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">-NAMBYA TRANSLATION PROJECT</book>
  <para style="h">3 Joni</para>
  <para style="toc1">Lukwalo lwatatu lwakakwalwa naJoni</para>
  <para style="toc2">3 Joni</para>
  <para style="toc3">3 Jon</para>
  <para style="mt2">Lukwalo lwatatu lwa</para>
  <para style="mt1">JONI</para>
  <para style="imt">Matangisilo</para>
  <para style="ip">Lukwalo lwatatu Joni lwakakwalwa nompositoli Joni, zwingaba pakati pamakole angaba makumi mashanu zwinda kuzana mushule mokuzwalwa kwaJesu. Joni aatozwileba kuti ndiye unkwali, koga unozwileba eti unkulwana. (Watatu John 1:1) Ndimo mwaalotila akale munaJoni wabili 1:1. Pana nolubimbo lokuti Joni wakakwala indebo imbuya yaJoni akale nama kwalo osematatu Joni wotanga, Joni wabili, Joni watatu nonshaji paakabegala mu Efasasi.</para>
  <para style="ip">Joni wakakwala lukwalo yolu kundimbwi unowhi Geyasi. Unoshoba Geyasi sonkwaina uwe akale unondaya kuti etambule maKristo kwaina bayimo mulwendo bepinda mubugalo yobo.</para>
  <para style="iot">Zwilomumwa</para>
  <para style="io1">Joni unosungula lukwalo lulwe (Joni watatu 1:1)</para>
  <para style="io1">Akale onosungwaja Geyasi akale ondaya kuti etambule banakwaina (Joni watatu 1:2-8)</para>
  <para style="io1">Unotobela nokulebeleka nezwabamwe banhulume nababili Diyotrefesi na Demetriyasi (Joni watatu 1:9-12)</para>
  <para style="io1">Unopejeleja nokulukonya lukwalo lulwe ( Joni watatu 1:13-14)</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />Imi unkulwana,</para>
  <para style="p" vid="3JN 1:1">Kunawi unodikana Geyasi, undinoda muchokomende.<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />Iwi unodikana, ndinonamata kuti zwose zwikukwendele zwibuyanana, akale kuti ube nobuchilo bubuya, ndinoziba kuti zwibuya nompepo uwo. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />Ndakashanta kasa yopo bamwe babanakwaina pabakaswika bakasumikija kubimbika kuko kuchokomende yobupenyu bubo, akale ndimo kasa iwi unotobela wechokomende. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />Apana chingandishantisa kupinda yezwi kuwha kuti bana bangu banotobeleja ichokomende.<verse eid="3JN 1:4" /></para>
  <para style="s">Geyasi wakalumbija</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />Iwi unodikana, ulobimbika panazwaumutila banakwaina kojoba beli bausinoziba. <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />Basumikija ludo lulo mbeli kwegubungano, ndimukumbila ubabhanche mulwendo lwabo munzila inokuja Mwali. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />Nokuti batanga lwendo pezhulu pokushingila Kristo, akale abajatambula chinhu kuva kunabo basinodimbwa. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />Nokudalo tinokwelela kubhancha banhu bakadalo, kuti tibe banoshinga pamwempela kutila ichokomende.<verse eid="3JN 1:8" /></para>
  <para style="s">Diyotrefesi naDemetriyasi</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />Ndakakwalila igubungano, koga Diyotrefesi, unoda kuzwibiga mbeli, aatotitambula. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />Nokudalo, ndingoswika, ndoda kuzwileba yezwi zwaakumuta, zwokuleba maniepwa mabi nozwedu, esinogunchikana nezwo, unolamba kutambula bamwe banakwaina, akale ejibisa yabo banoda kubatambula ebabhisa mugubungano.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />Iwi unodikana, usikwejejele chibi, koga kwejejela chibhodo, yoyo unota zwibuya ngowaMwali, yoyo unota zwibi aajanu ombona Mwali.<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />Demetriyasi unosumikijilwa naibo bose, kana nelebeswa zwalyo linounsumikijila nasubo tinounsumikijila, sezwaunoziba iwi kuti busumikiji bwedu ndibwechokomende.<verse eid="3JN 1:12" /></para>
  <para style="s">Kumusa kopejeleja</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />Ndabeli nezwinji zwokukukwalila, koga andidi kukukwalila nechikwaliso kana ne inki. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />Ndobimba kukubona munshaji umfupi, akale tinoolebeleka tikalingana.<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />Lunyalalo ngalube nawi.</para>
  <para style="p" vid="3JN 1:15">Bakwaina banokumusa muchiyobo. Umuse umwe nomwe wabakwaina bedu.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>