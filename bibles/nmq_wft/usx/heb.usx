<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- NAMBYA TRANSLATION PROJECT</book>
  <para style="h">BaHebhelu</para>
  <para style="toc1">Iwhalo kuba Hebhelu</para>
  <para style="toc2">BaHebhelu</para>
  <para style="toc3">Heb</para>
  <para style="mt2">Iwhalo</para>
  <para style="mt1">KUBAHEBHELU</para>
  <para style="imt">Matangisilo</para>
  <para style="ip">Iwhalo kubaHebhelu lukwalo lunosungwaja lutondeja kuti Jesu wakazhajikija chini zwipolofita zwinji zwomuChivumilano Chantolo. Yakakwalwa sembhaunulo. Ina zwakanokolwa kuChivumilano Chantolo zwingaswika makumi mashanu negumi limwempela munaba Hebhelu zwinotondeja pachena kuti Jesu wakazhajikija chini chipolofita nemishingo yoNtebuji Nkulwana wechiJuda. Nokuda kwezwi, Lukwalo yolu lwalosungwaja maKristo echiJuda. Iwhalo yabaHebhelu inotondeja kuti Jesu wakazhajikija chini undawo kutila kuti batebuji besipile mipilo kabili. Jesu wakaba umpilijo wezwibi zwose, kamwempela akale konshaji wose. MaKristo munshaji wedu bangawana busungwaji mulukwalo kubaHebhelu nokugala betobela Jesu Kristu saiye unota kuti zwitubulike kunasu kuti tibimbe munaMwali, Akale kuti tilambe tibimba munaiye (baHebhelu 12:2).</para>
  <para style="ip">Apana unoziba kuti ndiani wakakwala iwhalo yabaHebhelu, asi babhati boluzibo banoyeyesela umpositoli Paulu, Luka kana Bhanabhasi. Unshaji wokukwalwa autozibwa koga banji bana chisimiso chokuti yakakwalwa kusanu kwaswika makole makumi mashanu anamakumi mabili mushule mokuzwalwa kwaKristo IJerusalema lyakapalajwa mugole lyamakumi masanu anamabili, Asi unkwali wolukwalo yolu unolebeleka nezwe Jerusalema sokuti lijakaba lyapalajwa. BaHebhelu yakakwalilwa kuRoma (BaHebhelu 13:24) Akale ingaba yakakwendeswa kumakubungano alosiyanasiyana.</para>
  <para style="iot">Zwilomumwa</para>
  <para style="io1">Unkwali unotondeja kuti Jesu upopezhulu pabapolofeti baMwali nengilozi (BaHebhelu 1:1—4:13)</para>
  <para style="io1">Esikondilambeli etondeja kuti Jesu upo pezhulu pabatebuji banoshinga mutempeli lyaMwali muJerusalema (BaHebhelu 4:14—7:28)</para>
  <para style="io1">Akale bushingili bwaJesu bupo pezhulu kupinda chivumilano chantolo Mwali chaakata nabanhu babe zwipindila mumulawo waakapa Mozesi (BaHebhelu 8:1—10:31)</para>
  <para style="io1">Mushule mokupandulula kuti Jesu upo pezhulu munazwose, Unkwali unopa indayo jilosiyanasiyana jokuta</para>
  <para style="io1">(BaHebhelu 10:32—13:17). Kopejeleja unkwali unopeja lukwalo nokusungwaja akale nokumusa (BaHebhelu 13:18-25)</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s">Iwhi lyaMwali nomuMwananhulumyana uwe</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />Ntolo Mwali wakabelebeleka namatategulu edu eshingisa bapolofeti, munzila jinji akale jilo siyanasiyana, <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />asi mumazhuba yawa okupejeleja wakalebeleka kunasu nomuMwananhulumyana, yoyu wakashalwa kuti ebe undyifuma wezwinhu zwose, pana iye zwinhu zwose zwakabumbwa. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />Unotondejela lukujo lwaMwali akale elinhojela yaMwali, ulobhata zwinhu zwose newhi lilye linesimba. Paakachenesa luchinyo, Wakagala kuluboko lwokululyi, lwoyo opezhuluzhulu unokujwa.<verse eid="HEB 1:3" /></para>
  <para style="s">Bukulwana boMwananhulumyana waMwali</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4" />Mwananhulumyana wakaba unkulwana kungilozi sezwo izina lyaakapiwa igulwana kupinda lyajo. <verse eid="HEB 1:4" /><verse number="5" style="v" sid="HEB 1:5" />Ndikunaipi ingilozi Mwali kwakaleba kuti,</para>
  <para style="q1" vid="HEB 1:5">“Iwi uMwananhulumyana wangu,</para>
  <para style="q2" vid="HEB 1:5">nasi ndaba Tate babo kana kuti</para>
  <para style="q1" vid="HEB 1:5">“ndinooba Tate babe,</para>
  <para style="q2" vid="HEB 1:5">akale unooba Mwananhulumyana wangu.”<verse eid="HEB 1:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 1:6" />Akale paachabuza imbano iye penyika unooti,</para>
  <para style="q1" vid="HEB 1:6">“Ngenamatwe nengilozi jose jaMwali.”<verse eid="HEB 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 1:7" />Mwali paanolebeleka nozwengilozi unoti,</para>
  <para style="q1" vid="HEB 1:7">“Ndiye unota ingilozi jije jibebhepo,</para>
  <para style="q2" vid="HEB 1:7">nabashingi babe bebe kubilima komoto.”<verse eid="HEB 1:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />Koga nezwo Mwananhulumyana unoti,</para>
  <para style="q1" vid="HEB 1:8">“Chigalo chobushe chenu, imwi Mwali ngechisinopela.</para>
  <para style="q2" vid="HEB 1:8">Iswimbo yobululami ndiyo iswimbo yobushe bwenu.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />Wakada bululami ukabenga zwisilolulama.</para>
  <para style="q1" vid="HEB 1:9">Ndizwo Mwali, Mwali uwo, wakakuguba</para>
  <para style="q1" vid="HEB 1:9">Namafuta olushanto kupinda bakwaina babo.”<verse eid="HEB 1:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10" />Akale wakati</para>
  <para style="q1" vid="HEB 1:10">“ Tezi, wakabamba inyika pakutanga,</para>
  <para style="q2" vid="HEB 1:10">akale matenga mishingo yamaboko awo.<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />Banoopalala, koga iwi unoosala ulipo,</para>
  <para style="q2" vid="HEB 1:11">banooshakala bose sezwimbalo.<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />Unoobapeta seshashiko,</para>
  <para style="q2" vid="HEB 1:12">Akale banooshandulwa sechimbalo.</para>
  <para style="q1" vid="HEB 1:12">Asi iwi autoshanduka,</para>
  <para style="q2" vid="HEB 1:12">akale namakole awo aatojiba.”<verse eid="HEB 1:12" /></para>
  <para style="b" />
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />Ndikuneipi ngilozi kwaakati,</para>
  <para style="q1" vid="HEB 1:13">“Gala kuluboko lolulyi lwangu</para>
  <para style="q2" vid="HEB 1:13">Kujine ndite babengi babo</para>
  <para style="q2" vid="HEB 1:13">Chisanda chamakumbo awo.”<verse eid="HEB 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14" />Ingilozi ajitoba iyo mipepo inoshingila yakatumwa kooshinga, nokuda kwabo balootambula luchijo.<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s">Luchijo lukulwana</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />Nokudalo tilokwelela kubiga indangalilo jose panezwitakawha, kutila kuti tisipambuke kunaizwo. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />Nokuti kana iwhi lyakasumwa nengilozi lyakaba lili ilyo akale kuleswa kose nokusowhilila kwakatambula kulangwa kulokwelela, <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />tingachila chini kana tisinani noluchijo lukulwana ali? Lwakazibiswa pakutanga naTezi akale lukasimiswa kwatili naabo bakonwha, <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />Mwali nokukwe wakapa busumikiji nezwitondejelo nezwishamiso nezwichenamiso zwilosiyanasiyana akale nezwipo zwoMpepo uNchena zwaakakoba nokuda kukwe.<verse eid="HEB 2:4" /></para>
  <para style="s">Unotitungamilila mulujicho</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Nezwo Mwali aajakapa ingilozi isimba pezhulu penyika inozha, sezwa tikumuleba nezwayo. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />Kwakasumikijwa kunobumwe bugalo kuwhi,</para>
  <para style="q1" vid="HEB 2:6">“Unhu ini kuti uunjeye ali,</para>
  <para style="q2" vid="HEB 2:6">kana mwananhulumyana wonhu zwinota kuti uundondote?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />Wakonta kuti ebe pasi pengilozi konshaji umpfupi,</para>
  <para style="q2" vid="HEB 2:7">akale akoombajika chilemba cholukujo nokulemekejwa.<verse eid="HEB 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 2:8" />Akabiga zwinhu zwose pasi pamakumbo awe.”</para>
  <para style="m" vid="HEB 2:8">Ngweno pakubiga zwinhu zwose pasi pape, akuna zwaakasiya zwili kuzhe kwamasimba awe. Asi ngweno atijanhu tabona kuti zwinhu zwose zwipo pasi pape. <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />Koga tinobona Jesu wakaninipiswa kungilozi konshaji unshoma, ngweno akambajikwa chilemba cholukujo nolulemekejo nokuda kokuyangata kolufu, kutila kuti nechipiwo chaMwali efile banhu bose. <verse eid="HEB 2:9" /><verse number="10" style="v" sid="HEB 2:10" />Nokuti zwakaba zwikakwelela kuti Mwali, wakabumba zwinhu zwose akale zwibumbilwa iye, kutila kuti ete umbambi woluchijo lwabo epelelele nokuyangatiswa mukubuza bana banhulumyana banji mulukujo.<verse eid="HEB 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11" />Nokuti iye unochenesa naabo banocheneswa banechinde limwempela, ndizwo esina ishoni jokubashoba kuti banakwaina, <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />eti,</para>
  <para style="q1" vid="HEB 2:12">“Izina lyenu ndolipupula kubanakwaina,</para>
  <para style="q2" vid="HEB 2:12">ndomukuja ndili mugubungano.”<verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />Unoti kabili, “Ndinobiga lubimbo lwangu mwaali.” Akale unoti “Ndipo yopano nabana bandakapiwa naMwali.”<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />Sezwo bana beli belopa nombili, iye neebo wakaba nechimo yecho, kutila kuti nolufu engapalaja yoyo unamasimba pezhulu polufu, zwileba Guluzhanje, <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />akale kuti emunule bose bakabakasungwa nolutyo lolufu kobupenyu bwabo bose. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />Nezwo ichokomende kuti aanani nengilozi koga kubhancha inzwalo yaAbhulahamu. <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />Nokudalo kwaluba kwakakwelela kuti ebe sabanakwaina babe muzwinhu zwose, kutila kuti ebe untebuji unkulwana uneshe akale ulobimbika mukushingila Mwali, kuti iye elipile luchinyo lwabanhu. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />Sezwo iye nokukwe wakayabula akakwejwa, unotubula kubhancha yabo banokwejwa.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">Jesu unkulwana kupinda Mozesi</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Nezwo banakwaina bachena, imwi muloshanganyila mukushobwa kokudenga, langalilani Jesu umpositoli nontebuji unkulwana wobusumikiji bwedu. <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />Wakaba ekabimbika kunoyo wakomponcha, saMozesi wakabakabimbika mungumba yaMwali. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />Koga Jesu wakakwelela lukujwo lunji kupinda Mozesi, sobuzwili kuti umbaki wengumba ndiye unokujwa kupinda ingumba. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />Nokuti ingumba yose inobakwa nonhu, koga umbaki wezwinhu zwose ndiMwali. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />Nezwo Mozesi wakaba ekabimbika mungumba yaMwali yose soshingi, kuti esumikije zwinhu zwakaba zwaloolebwa mumazhuba ambeli, <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />koga Kristo wakaba akabimbika mungumba yaMwali soMwananhulumyana. Akale tinoba ingumba iye kana tigala mukubimba nomukushiya mulubimbo lwedu.<verse eid="HEB 3:6" /></para>
  <para style="s">Lunyetutuko kubanhu baMwali</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />Nokudalo uMpepo uNchena unoti,</para>
  <para style="q1" vid="HEB 3:7">“Nasi mungowha iwhi lilye,<verse eid="HEB 3:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8" />musikomise myoyo yenu sonshaji wokupandukila Mwali,</para>
  <para style="q2" vid="HEB 3:8">nezhuba lyokukwejwa mugwegulu,<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />yopo matategulu enu pabakandikweja,</para>
  <para style="q2" vid="HEB 3:9">kojoba bakabona mishingo yangu kwamakole makumi mana.<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />Nezwo ndakanyemiswa nechizekululu yechiya,</para>
  <para style="q2" vid="HEB 3:10">‘ndikati banogala bakapambuka mumyoyo yabo.’</para>
  <para style="q2" vid="HEB 3:10">abajanu baziba inzila jangu.<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />Zwandakakowa mubukali bwangu nditi,</para>
  <para style="q2" vid="HEB 3:11">‘Abatoongwina mulunyetutuko lwangu.’”<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />Chenjelani, banakwaina, kuti kusibe nomwempela pakati penu unano moyo umbi, unamwoyo usinodimbwa, emutungamilila mukuwa kuva kunaMwali umpenyu. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />Koga sungwajanani mazhuba ose, sezwo lishobwa “nasi,” kutila kuti kusibe noumwe wenu uchakomeselwa mwoyo mukuchengwa noluchinyo. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />Nokuti tinoshanganyilana muna Kristo, kana chete tibhatilila mulubimbo lwedu lwotanga kujine kube kumapejelejo, <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />kana kuwhi,</para>
  <para style="q1" vid="HEB 3:15">“Nasi, pamunowha iwhi lilye,</para>
  <para style="q2" vid="HEB 3:15">musikomise myoyo yenu</para>
  <para style="q2" vid="HEB 3:15">soponshaji wokupanduka.”<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />Ndibanhi bakawha koga bakapanduka? Abatoba yaba bose na bakava kuIjipiti, betungamililwa naMozesi? <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />Ndiani wakonyeteja kwamakole makumi mana? Abatoba yabo bakachinya, bakashayikila mugwegulu na? <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />Akale ndikunani kwaakakowa kuti abajilokwelela kungwina mulunyetutuko lulwe, koga kunaabo basakawhilila? <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />Nokudalo tinobona kuti abajakatubula kungwina pezhulu pokusodimbwa kwabo.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Nokudalo, kana chibimbiso chokungwina mulunyetutuko lulwe chichipo, atityeni kutila kuti kusibe noumwe wenu uchawhi wakonelwa kuswika paluli. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />Nokuti iNdebo iMbuya yakezha kwatili sokwabali, koga iwhi lyabakawha ibo alijakababhancha, nokuti yabo bakaliwha abajakalishanganisa nokudimbwa. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />Nokuti isu takadimbwa tinongwina mulunyetutuko yolo, sezwaakaleba eti,</para>
  <para style="q1" vid="HEB 4:3">“Ndinokowa mubukali bwangu nditi,</para>
  <para style="q2" vid="HEB 4:3">‘Abatoofa bangwina mulunyetutuko lwangu,’ ”</para>
  <para style="m" vid="HEB 4:3">Kojoba mishingo iye yakabapela kuvila pakupatulwa kwenyika. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />Nokuti pana pamwe paakaleba nezhuba lyashanu linamabili eti, “Mwali wakanyetutukwa nezhuba lyashanu linamabili kumishingo iye yose.” <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />Akale mundebo yeyi wakati, “Abatoofa bangwina mulunyetutuko lwangu.” <verse eid="HEB 4:5" /><verse number="6" style="v" sid="HEB 4:6" />Sezwo kunooba nabamwe banootubula kungwina, koga yabo bakaba batambula iNdebo iMbuya bakakonwa kungwina pezhulu pokusowhilila, <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />akale wakashala limwe izhuba eti “Nasi,” elebeleka kupindila munaDavidi kwapinda nshaji undefu mumawhi abandwa kale,</para>
  <para style="q1" vid="HEB 4:7">“Nasi, mungowha iwhi lilye,</para>
  <para style="q2" vid="HEB 4:7">musikomise myoyo yenu.”<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />Nokuti ngana Joshuwa akabapa lunyetutuko, Mwali aajaloolebeleka nezwe limwe izhuba. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />Nezwo, kunosala izhuba lyesabata lyokunyetutuka kwabanhu baMwali, <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />nokuti ani naani unongwina mulunyetutuko lwaMwali, unonyetuka mumishingo yiye somwaakata Mwali kumishingo yiye. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />Nokudalo ngatikwejeni kungwina mulunyetutuko yolo, kuti kusibe nomwe uchawila muchitiko chakadalo chokusowhilila.<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />Nokuti iwhi lyaMwali ibhenyu akale lishinga kasa, linopiza kupinda igwalabaza linocheka namatibi mabili, libhaya lipambulanya mwoyo nompepo, kana imhingu nomwongo, libiga pachena lulakamilo nezwinoshaka kutiwa nomwoyo. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />Akale akuna chibumbwa chilosisika kwaali, koga zwose zwilofukulwa akale zwipo pachena mumesho awe iye utichoolungululila zwito zwedu.<verse eid="HEB 4:13" /></para>
  <para style="s">Jesu uNtebuji unkulwana</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />Sezwatina uNtebuji unkulwana, elinkulugulu wakapinda kumatenga unowhi Jesu, Mwananhulumyana waMwali, nokudalo ngatisimiseni busumikiji bwedu. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />Nokuti atina uNtebuji unkulwana usinotubula kutiwhila ishe mubutela bwedu, koga iye wakakwejwa munzila jose somutinokwejwa, koga esina luchinyo. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />Nokudalo atisendeleni pelyo nobugalo bweshe tili nolubimbo, kuti titambule ishe nokuwana chipiwo chokutibhancha nonshaji wokushayiwa.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />Nokuti untebuji unkulwana wose unoshalwa pakati pabanhu, emisilwa kumililila banhu muzwinhu zwaMwali kuti epile zwipo nemipilo yoluchinyo. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />Angaba nobunyolonyolo kuna basinoziba nabalolashika, nokuti naiye unanobutela. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />Nezwo ulokwelela kupila umpilo woluchinyo lulwe nolwabanhu. <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />Apana unhu usinozwipa ega kulemekejwa, koga unoshobwa naMwali, sezwakatiwa Aloni.<verse eid="HEB 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5" />Nezwo Kristo ajakazwinyamula kujine ebe untebuji unkulwana,</para>
  <para style="q1" vid="HEB 5:5">“koga wakaponchwa na iye wakati kwaali, “Iwi uMwananhumyana wangu,</para>
  <para style="q2" vid="HEB 5:5">nasi ndaba Tate babo.”<verse eid="HEB 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />Sezwaanoleba akale kuneimwe indebo kuti,</para>
  <para style="q1" vid="HEB 5:6">“Iwi untebuji kujine kube lini nalini,</para>
  <para style="q2" vid="HEB 5:6">nenzila yaMelukizedeki.”<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />Mumazhuba obupenyu bubwe, Jesu wakanamata ekumbila, nokulila kukulwana nemishoji, kunayoyo waluba nesimba lyokuunchija mulufu, nokudalo wakawhiwa pezhulu pokutya Mwali kukwe. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />Kojoba waluba Mwananhulumyana, wakazwilayija kuwhilila pezhulu pokuyabula kukwe, <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />akale wakatiwa ulopelelela, akaba ichinde lyokuchijwa kusinopela kuna bose banounwhilila, <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />wakaponchwa naMwali kuba uNtebuji unkulwana nenzila yaMelukizedeki.<verse eid="HEB 5:10" /></para>
  <para style="s">Chichenjejo pezhulu pokulamwa ludimbo</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />Tinazwinji zwatingamubuje pezhulu pezwi, koga zwikukutu kulungulula, nokuti mwakaba bazilili pakuwha. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />Kojoba nonshaji yono mwalukwelela kuba balayiji, koga munokwelela kuti kube nomwe unomulayija akale zwimiso zwamabambo zwewhi lyaMwali, moda unkaka, kusi kulya kulosima, <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />nokuti wose unolalama nonkanka una kusowhisisa kumawhi obululami, nokuti uncheche. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />Koga kulya kusimu ngokwaba kakubuka, yabo bane ndangalilo jakalayijwa nokuta kuti betubule kusiyanisa zwibuya nozwibi.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Nokudalo ngatilekeni zwilayijo zwamabambo aKristo, akale tinde mukukubuka, tisinobiga kabili chimisikilo chokushanduka kuva kumishingo inobuzilija lufu, akale neyokudimbwa kunaMwali, <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />nendayilo yemibhabhatizo, kubiga maboko, kumuka kubafi, akale nezwokutongwa kusinopela. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />Akale yezwi tichata kana Mwali evuma.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />Nokuti azwitotubulika kubwiliza akale kushandula yabo bakabamunikilwa, bakabalabila chipo chokudenga akale bakashanganyila kuMpepo Nchena, <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />akale bakalabila bubuya bwewhi lyaMwali nesimba lyonshaji ukumuzha, <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />kana yaba bangowa mukuvumila, nokuti banonkahamila kabili Mwananhulumyana waMwali nokwabo, boonshampula. <verse eid="HEB 6:6" /><verse number="7" style="v" sid="HEB 6:7" />Nokuti inyika yanwa ivula inogala iyinila, imejeka zwimela zwilokosha kunaabo banoyilimilwa, inowana makombolelo kunaMwali. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />Koga inyika inomela miwha nedihwa ilobhaya aina nshingo akale yabapelyo nokufizhwa, kupela kwayo kupiswa.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />Banakwaina banodikana, kojoba tileba alo, koga kunamwi tinalubimbo pezhulu penu nezwinhu zwibuya zwoluchijo. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />Nokuti Mwali aatoba usakalulama, kuti angaleka kulangalila mishingo yenu, akale noludo lumwakatondejela pezhulu pape mukushingila bachena, sobwamuchinota. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />Akale tinachido chokuti umwe nomwe wenu etondejele kusungwala kumwempela mukuba nechimiso chizhele cholubimbo kuswikila kumapejelejo. <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />Kuti musibe nobusimbe koga mube bakwekwejeli baabo bakafumiswa, nezwabakabimbiswa pezhulu pokudimbwa nokunangatila.<verse eid="HEB 6:12" /></para>
  <para style="s">Chibimbiso chaMwali chechokomende</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />Nezwo Mwali paakata chibimbiso kunaAbhulahamu, nokuti akujakabelina umwe unkulugulu kuti oonkowe, wakazwukowela ega, <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />eti, “Chokomende ndokukombolela, ndiwaje zwizekululu zwizwo.” <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />Nenzila yakaleyo Abhulahamu, amilila nokuzwisimisa, wakapiwa zwaakaba abimbiswa. <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />Banhu banokowha nomwe unkulwana kwabali, akale mukunyenyejana kwabo kwose ikowe isimiso lyokopeleleja. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />Nokudalo Mwali paakada kutondejela zwizhele kubalyi befuma bezwibimbiso kusoshanduka kwechimilo chechinangwa chiche, wakasimisa nekowe, <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />Kutila kuti muzwinhu zwibili zwisinoshanduka, azwitotubulika kuti Mwali eniepe, isu takatizhila kwaali kuti tiwane kusungwajwa kukulwana kuti tivupule lubimbo lulobigwa mbeli kwedu. <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />Tina yolu lubimbo lunanga ingobyo yompepo, ilosima akale ikalondoteka, inopinda mukati mobugalo buchena kushule kwenabiko, <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />yomo Jesu mwaakangwina sontangili ulotimilila, aba untebuji unkulwana nokusinopela nenzila yaMelukizedeki.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">Untebuji Melukizedeki</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Nokuti yoyu Melukizedeki, tezi woku Salemu, untebuji waMwali unkulugulu, wakashangana naAbhulahamu eva kunobulaya mashe, akonkombolela, <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />akale Abhulahamu wakonkobela chegumi chezwinhu zwose. Chotanga, izina lyokuti Melukizedeki linoleba kuti “ She wobululami”, nokuti wakabeli she weSalemu, zwiva kuti, “she wolunyalalo.” <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />Iye aana tate kana amai, kana ichinde akale aana matangilo amazhuba kana kupela kobupenyu, asi ekatoja mwananhulumyana waMwali unondilambeli elintebuji nokusinopela.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />Bonani kuti unkulwana chini. Abhulahamu tategulu wakompa chegumi kunezwo zwaakabapamba kuhondo. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />Nabo benzwalo yaLevi banogajwa butebuji banandayo mumulawo wokutola chegumi kuva kubanhu, zwiva kuti, kubanakwaina babo, kojoba yaba naibo belichizekululu chaAbhulahamu. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />Koga yoyu unhu usi wechinde lyaLevi, wakatambula chegumi kuva kunaAbhulahamu akonkombolela iye wakaba eli nezwibimbiso. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />Azwina kukahajika kuti untukutuku unokombolelwa nonkulwana. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />Yopa zwegumi zwinotambulwa nabanhu banofa, koga kunelimwe bhazu, noyo unosumikijwa kuti umpenyu <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />Umwe angaleba kuti Levi womene unotambula zwegumi, iye wakapa zwegumi nomuna Abhulahamu, <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />nokuti wakabechi munhunji yaTate babe pakwakati Melukizedeki ashangamija Abhulahamu.<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />Ngana kupelelela kwakaba kuwanikwa nomubutebuji bwaLevi, nokuti mwabuli banhu bakatambula mulawo, kwaloshakilwani umwe untebuji kuti enyamuke eli wenzila yaMelukizedeki, esi woluji lwaAloni? <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />Nokuti kana kuli nokushanduka mubutebuji, kunokwelela kuba nokushandukabo mumulawo. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Nokuti yoyo umulebwa nezwizwe wakaba eli wolumwe luji, akuna unhu woluji lokunayibo wakabashingila pedebulilo. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />Zwipo pachena kuti Tezi wedu ngowenzwalo yaJuda, akale nozwoluji yolo, Mozesi apana zwaakaleba nozwabatebuji.<verse eid="HEB 7:14" /></para>
  <para style="s">Umwe untebuji unanga Melukizedeki</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15" />Yezwi zwinoba pachena kasa kana umwe untebuji abhuka muchitojaniso chaMelikizedeki, <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />iye wakaba untebuji kusinotobelejwa zwilotalwa mumulawo asi nokuzwalwa muchinde, koga nesimba lobupenyu businopela. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />Nokudalo kulosumikijwa nezwizwe kuwhi “iwi untebuji nokusinopela nenzila yaMelukizedeki.” <verse eid="HEB 7:17" /><verse number="18" style="v" sid="HEB 7:18" />Nejimwe inzila mulawo wotanga unosiywa kumbali, pezhulu pobutela bwacho nokushayiwa unshingo kwacho. <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />Nokuti mulawo aujakata chinhu chilopelelela, nejimwe inzila lubimbo lubuya lunosungulwa, akale lunotisendeja pelyo naMwali.<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />Akale akujakabelina kukowha. Yabo bakatanga kuba batebuji bakagajwa besakowha, <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />koga yoyu wakangwina nekowhe,</para>
  <para style="q1" vid="HEB 7:21">“Tezi wakakowha</para>
  <para style="q2" vid="HEB 7:21">akale atoshandula indangalilo jije,</para>
  <para style="q1" vid="HEB 7:21">‘Iwi untebuji nokusinopela.’ ”<verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />Yezwi zwinota Jesu ebechisimiso chechivumilano chibuyanana.<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />Batebuji botanga bakaba beli banji, nokuti bakaba bekonejwa nolufu kuti bendile mbeli munshingo, <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />koga iye unogala eli ntebuji, nokuti unondilambeli nokusinopela. <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />Nezwo unesimba lyokuchija nokusinopela yabo banozha kunaMwali munaiye, nokuti unogala ebakumbilila.<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />Nokuti zwakabekwelela kuti tibe nontebuji unkulwana wakadai, unchena, usinosoleka, usiloswibhiswa, ulopambulwa kubachinyi, ulonyamulwa kupinda matenga. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />Azwitodikana kwaali kuti epile mipilo mazhuba ose, esinota sabamwe batebuji bakulwana banopila pezhulu poluchinyo lwabo pakutanga, kova beyipila pezhulu poluchinyo lwabanhu, yezwi iye wakazwita kamwempela konshaji wose paakazwipila iye. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />Nokuti mulawo unogaja banhu mubutela bwabo sabatebuji bakulwana, asi iwhi lyekowe, lyakezha mushule mumulawo, lyakagaja Mwananhulumyana wakapeleleswa kusinopela.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">Jesu uNtebuji wedu unkulwana</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Ngweno chikulwana munazwose zwatikumuleba ndiyezwi, tinanaye untebuji unkulwana uli ali, iye ugele kululyi lwechibhula chobushe Chobushaninga kudenga, <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />unshingi muchikombelo chili tente ijena lyechokomende lilomiswa naTezi koga kusi unhu.<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />Nokuti wose untebuji unkulwana unogajwa kuti epile zwipo nemibhailo, nokudalo zwinodikana akale kuti yoyo untebuji ebenacho chaanopila <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />Nokuti ngana wakaba eli penyika, aajaloba untebuji kana, nokuti baipo batebuji banopila zwipo betobeleja mulawo. <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />Banoshingila chitojaniso akale nontuzi wechikombelo chokudenga, nokuti Mozesi paakabeda kubaka itente, wakalaywa naMwali, kuti, “Bona kuti unota zwose sechikwejaniso chawakatondejwa pedunhu.” <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />Koga sezwazwili, Kristo wakawana bushingili bubuyanana kasa kupinda bwantolo sechivumilano chaanomililila chili chibuyanana, sezwachilobakilwa pozwibimbiso zwibuyanana.<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />Nokuti ngana chivumilano chotanga chakaba chisilolunduka, akujaloba nechabili. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />Koga unobawana belinondandu paanoti,</para>
  <para style="q1" vid="HEB 8:8">“Mazhuba akumuzha, unodalo Tezi,</para>
  <para style="q2" vid="HEB 8:8">yopo pandichota chivumilano chipya nengumba ya izilayeli akale nengumba yaJuda,<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />zwisi sechivumilano chandakata namatategulu abo</para>
  <para style="q2" vid="HEB 8:9">pezhuba lindakababhata noluboko ndibabhisa munyika yeIjipiti,</para>
  <para style="q1" vid="HEB 8:9">nokuti abajakandila mbeli muchivumilano changu,</para>
  <para style="q2" vid="HEB 8:9">nokudalo namibo andijakabayeya, unodalo Tezi.<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />Yechi ndicho chivumilano chandichata nengumba yaIzilayeli,</para>
  <para style="q2" vid="HEB 8:10">mushule mwamazhuba yayo unodalo Tezi,</para>
  <para style="q1" vid="HEB 8:10">ndinoobiga milawo yangu mundangalilo jabo,</para>
  <para style="q2" vid="HEB 8:10">ndiyikwale mumwoyo yabo,</para>
  <para style="q1" vid="HEB 8:10">akale ndibe Mwali wabo,</para>
  <para style="q2" vid="HEB 8:10">naibo banooba banhu bangu.<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />Akale abatoolayijana mububwanakwaina bwabo</para>
  <para style="q2" vid="HEB 8:11">kana ani naani aatolayija mwanakwaina uwe eti,</para>
  <para style="q2" vid="HEB 8:11">‘Ziba Tezi.’</para>
  <para style="q1" vid="HEB 8:11">nokuti bose banoondiziba imi,</para>
  <para style="q2" vid="HEB 8:11">kuvila kuntukutuku zwinda kunkulwana wabo.<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />Nokuti ndinooba neshe pezwibi zwabo,</para>
  <para style="q2" vid="HEB 8:12">akale anditokumbulukwa luchinyo lwabo akale.”<verse eid="HEB 8:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 8:13" />Pakuleba nezwechivumilano chipya unota chotanga kuti chibe chisina nshingo. Chisichina unshingo nokubachantolo chabulobwandila.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s">Kunamata kwopenyika nokudenga</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Ngweno chivumilano chotanga chakabeli nemilawo yokunamata akale nobugalo buchena bopenyika. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />Nokuti itente lyakaba likalonganywa, lyokuzhe, mwakaba muli nechigajiko chomwenje, netafula nechinkwa chichena, linowhi Bugalo buChena. <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />Kuseli kwedabiko lyabili kwakabeli netente lyakabewhi Bugalo buChena, <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />kuli nedebulilo lyendalama lyokufhungayijila akale negwati lyechivumilano likajululwa nendalama kumapazu ose, mukati mwalyo muli nefhukwana yendalama yokulondotela imana, neswimbo yaAloni yakakwinila namabwe echivumilano, <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />pezhulu pegwati pakaba peli namakelubhimu olukujo akasikatila chibhula cheshe. Ngweno atingalebeleke zwizhele pezhulu pezwi zwinhu.<verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />Mabambanyilo yaya, atiwa, batebuji balungwina mazhuba ose mutente lyokuzhe beta unshingo wabo, <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />koga munalyabili untebuji unkulwana ega chete ndiye wakabengwina kamwempela negole, elinelopa lyalopila iye akale bakachinya nokusoziba. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />Nezwi uMpepo uNchena unotondejela kuti inzila yokungwina mubugalo buchena ayijanu ikazhulwa nokuti ibhazu lyokutanga lyedhumba lyokuzhe lichimile, <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />chili chitondejelo mumazhuba Anasi. Yezwi zwiinoleba kuti zwipo nemibhayilo zwakapilwa azwijakabetubula kululamisa luyeyo lonamati, <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />asi zwinongoba zwokulya nozwokunwa akale nozwamashambisilo alosiyanasiyana, zwakaba zwikamisilwa umbili, kuswikila unshaji wokululamisa.<verse eid="HEB 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />Asi Kristo paakaboneka sontebuji unkulwana wezwinhu zwibuya zwakezha, nokudalo nomukupindila mudhumba igulwana akale lilopelelejwa lisilotiwa namaboko onhu, lisi ilyo lyakabumbilwa yezwi <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />iye wakangwilaatu muBugalo Buchena, esijilobhata ilopa lyembuji kana lyotunamani koga nelopa lilye, nezwo wakatiwanila kumunulwa kusinopela. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />Nokuti kana ilopa lyembuji nenkunzi, nokushashwa kwabanhu baloswibha nelota lyetokazi zwishambija mukuchenesa umbili, <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />zwilokosha chini kuti ilopa lyaKristo wakazwipila noMpepo wokusinopela kunaMwali esina chibi, chenesani luyeyo lwenu kuva kumishingo ilofa kuti mushingile Mwali umpenyu.<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />Nezwo ndiye undebeleli wechivumilano chipya, kuti yabo baloshobwa betambule chibimbiso chefuma isinopela, sezwo lufu lwakatikana lunobamunula muzwibi zwabo pasi pechivumilano chokutanga.<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />Nezwo kana peli nolukwalo lwokukoba ifuma, lufu loyo wakalukwala lulokwelela kusumikijwa. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />Nokudalo lukwalo lokukobana ifuma lunoshinga chete palufu, akale aluna isimba kana mweni walo echili umpenyu, <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />ndizo chivumilano chokutanga chisakamiswa pesina ilopa. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />Zwisungo zwomulawu zwose pazwakashomejelwa naMozesi kubanhu bose etobeleja mulawo, wakatola ilopa lyamanamani nelyembuji, nevula nobukuse bushaba, nakatabi kehaisopi, akashashaila pezhulu pewhalo nabanhu bose, <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />wakati, “Yeli ilopa lyechivumilano Mwali chaakabalaya kuti belondote.” <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />Nenzila yakaleyo wakashashaila nelopa inhumba nezwibiya zwinoshingiswa pakunamata. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />Chokomende, pasi pomulawu posa zwose zwinhu zwinocheneswa nelopa, akale kuzhe kwokuti kupilwe ilopa, apana kulekejelwa kwoluchinyo.<verse eid="HEB 9:22" /></para>
  <para style="s">Umbayilo waKristo Unobhisa Luchinyo</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />Zwakabakakwelela kuti zwitojaniso zwezwinhu zwokudenga zwicheneswe nenzila yakadai, koga zwinhu zwiko kudenga ndizwo kasa zwilokwelela kucheneswa nemitebulo mibuya kupinda yezwi. <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />Nokuti Kristo aajakabanhu angwina mubugalo buchena bulobakwa namaboko, chili chitojaniso chechokomende, koga wakangwina kudenga komene, ngweno eboneke mbeli kwaMwali emilila isu. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />Akutoba kuti egale ezwipila kanji, sezwo untebuji unkulwana engwina Bugalo Buchena kasa, igole negole nelopa lisili lilye, <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />nezwo, waluyabula kanji kuva pakubumbwa kwenyika. Koga sezwazwili wakaboneka kamwempela chete kumapejelejo kwonshaji, koobhisa luchinyo nenzila yokuzwipila kukwe. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />Somwazwilobambwa, kuti unhu unofa kamwempela, mushule mwezwo kunozha kutongwa, <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />nokudalo Kristo wakapilwa kamwempela kubhisa luchinyo lwabanji, unoobuya kabili, esinozhila luchinyo asi ezhila koochija yabo baneshungu jokuundindila.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="s">Untebulo waKristo</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />Mulawo untuzi wezwinhu zwibuya zwikumuzha, kusili chimo chawo, aungabalulamise yabo banoswendela pelyo, nemitebulo yeyo inopilwa igole negole, <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />Nokuti ngana zwisakadalo mitebulo yeyi basakayileka. Banamati bakabashambiswa, abajaluba noluyeyo lwoluchinyo. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />Asi mumipilo yeyi kuna chikumbulujo choluchinyo igole negole. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />Azwitotubulika kuti ilopa lyenkunzi nelyembuji kuti zwibhise luchinyo.<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />Nezwo Kristo paakezha munyika, wakati,</para>
  <para style="q1" vid="HEB 10:5">“Mipilo nemitebulo amujakaida,</para>
  <para style="q2" vid="HEB 10:5">asi mwakandibambila umbili.<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />Amujimutambula umpilo wemhuka ulopiswa pedebulilo,</para>
  <para style="q2" vid="HEB 10:6">akale nemipilo yoluchinyo, amujakashantilwa.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />Kova nditi, ‘Ndezha,</para>
  <para style="q2" vid="HEB 10:7">kota kuda kwenu, imwi Mwali,</para>
  <para style="q2" vid="HEB 10:7">sezwazwilo kwalwa nezwangu muwhalo yomuLawo.’ ”<verse eid="HEB 10:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8" />Pakutanga wakati, “Imwi amujakashantilwa nemipilo akale nemipilo ilopiswa, nemipilo yoluchinyo” yeyi inopilwa zwinda noMulawu, <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />kova eti, ndipo yopano, “Ndezha koota kuda kwedu.” Wakombiga kumbali yondiya wokutanga, akanyamulila pezhulu wabili. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />Nezwi, takatiwa bachena pakupilwa kwombili waJesu Kristo kamwempela konshaji wose.<verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />Akale untebuji wose unoma mazhuba ose etamishingo yobutebuji, epila, epama untebulo umwempela usinobhisa luchinyo. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />Koga Kristo paakapila untebulo woluchinyo umwempela koonshaji wose, wakava agala kululyi lwaMwali, <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />emilila kuswikila babengi babe baba chitobelo chamakumbo awe. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />Nontebulo umwempela konshaji wose chete wakabuza kupelelela kuna yabo bakacheneswa.<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />Akale uMpepo uNchena unopa busumikiji kunasu, mushule mokuleba yezwi,<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />“Yechi ndicho chivumilano chandichata nabo,</para>
  <para style="q2" vid="HEB 10:16">mushule mwawo mazhuba, unodalo She,</para>
  <para style="q1" vid="HEB 10:16">ndichabiga milawu mumyoyo yabo</para>
  <para style="q2" vid="HEB 10:16">nokuyikwala mundangalilo jabo,”<verse eid="HEB 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />Unopamija eti, “Andichinooyeya luchinyo lwabo nokutayija kwabo.” <verse eid="HEB 10:17" /><verse number="18" style="v" sid="HEB 10:18" />Yopo pana kulekejelwa kwezwi, apachina untebulo unotilwa luchinyo.<verse eid="HEB 10:18" /></para>
  <para style="s">Atizheni pelyo naMwali</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />Nokudalo, banakwaina, sezwo tili nomwoyo wokungwina mubugalo buchena pezhulu pelopa lyaJesu, <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />nenzila impya akale imhenyu, yaakatizhulila mudabiko, zwinova kuti nombili uwe. <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />Nokuti tina untebuji unkulugulu wengumba yaMwali, <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />ngatisendeleni pelyo nemyoyo yechokomende akale nokudimbwa kusimu, myoyo yedu ikashamupulujika isina indangalilo imbi nemibili iloshambiswa nevula inchena. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />Ngatibhatisiseni tisinoleka, kulebulula lubimbo lwedu nokuti wakatibimbiswa ndiye ulobimbika; <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />akale ngatiyeyeseseni kuti tingasungwajana chini kuti tidanane nokuta mishingo mibuya, <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />tisinolekeja kushangana, sezwinotiwa nabamwe, koga tisungwajane kasakasa umwe nomwe sezwamunobona yelyo izhuba lisendela pelyo. <verse eid="HEB 10:25" /><verse number="26" style="v" sid="HEB 10:26" />Kana tichinya nomwaza, mushule mwokuziba ichokomende, litakatambula, apachina untebulo unobhisa luchinyo unosala, <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />koga zwinoba zwasala, kumilila kutongwa kunotyisa, nebibi lyomoto lichoopisa babengi baMwali. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />Unhu unotaluka Mulawo waMozesi unobulayiwa esinowhilwa ishe, kana peli nabasumikiji babili kana batatu. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />Biya kunobeli chini kulangwa kwoyo unolelupisa Mwananhulumyana waMwali nokulingila pasi ilopa lyechivumilano lyaakacheneswa nalyo nokutuka uMpepo wechipiwo? <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />Nokuti tinounziba iye wakati, “Imbwilizilo ngeyangu, ndinobwilizila.”Akale wakati, “She unootonga banhu babe.” <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />Chinhu chinotyisa kasa kuwila mumaboko aMwali umpenyu.<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />Langalilani mazhuba akapinda pamwakati mushule mokuwana lumuniko, mwakasimilila kojoba mwakaba mujiijwa, <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />umwe unshaji mwakatukwa nokuwhiswa kulwaja mbeli kwabanhu, umwe unshaji mwakashanganiswa nabalobhatwa nenzila yakadalo. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />Mwakawhila ishe basungwa, mukatambula nolushanto kutolelwa zwibiya zwenu nokuti mwakamuziba kuti munachuma chinokwemujwa kupinda yezwo akale chisinopela. <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />Nokudalo musilashe mwoyo wesimba, unoba iwo unendipilo ihulwana. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />Ibani banotobeleja nomwoyo ndefu unonangatila, kutila kuti moota kuda kwaMwali, mutukotambula zwaakabimbisa. <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />Nokudalo</para>
  <para style="q1" vid="HEB 10:37">“Kwasala unshaji unshoma,</para>
  <para style="q2" vid="HEB 10:37">yoyo unozha, unoozha,</para>
  <para style="q2" vid="HEB 10:37">esinojilwa,<verse eid="HEB 10:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38" />asi wangu ulolulama unooba umpenyu nokudimbwa,</para>
  <para style="q2" vid="HEB 10:38">koga kana ebwiilila mushule,</para>
  <para style="q2" vid="HEB 10:38">mwoyo wangu autowana lushanto naye.”<verse eid="HEB 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />Asi atitoba yabo banobwilila mushule kova bepalajwa, koga tinakudimbwa akale takachijwa.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s">Kudimbwa</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />Kudimbwa kuba nesimiso yezwinhu zwatilolingilila, isimiso lyezwinhu zwisinobonwa. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />Yezwi ndizo zwakatisa kuti Mwali beshantilwe namatategulu.<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />Nokudimbwa tinowhisisa kuti inyika yakabumbwa newhi lyaMwali, kutila kuti zwinoboneka zwakatiwa, zwiva munezwo zwisinoboneka.<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />Nokudimbwa Abhelo wakapila untebulo kunaMwali, untebulo wakashantisa Mwali kupinda waKeyini, nokudalo wakashobwa kuwhi wakalulama pezhulu pontebulo, Mwali wakaba unsumikiji pakutambula untebulo uwe, kojoba akafa ukumulebeleka nokuda kwokudimbwa. <verse eid="HEB 11:4" /><verse number="5" style="v" sid="HEB 11:5" />Nokudimbwa Inoki wakanyamulilwa pezhulu zwakatisa kuti esife akale aajakawanikwa nokuda kokuti Mwali bakontola. Ngweno esanhu atolwa wakapupulilwa kuti wakashantisa Mwali. <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />Akale pasina ludimbo azwitotubulika kuunshantisa Mwali. Nokuti ani nani unozha kuna Mwali ulokwelela kudimbwa kuti Mwali upo akale unopa umbayilo kunayabo banounshaka. <verse eid="HEB 11:6" /><verse number="7" style="v" sid="HEB 11:7" />Nowa nokudimbwa, anyeulilwa naMwali pezhulu pezwitiko zwisanu nezwinhu zwaboneka, wakawhilila akale akabaka chikepe kuti echije imhuli iye, nezwi wakapa undandu kunyika, akale akaba uNdyifuma wobululami bunozha nokudimbwa<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />Abhulahamu nokudimbwa wakawhilila paakabujwa kuti emilike ende kunyika yaalopiwa kuti ibe fuma iye, wakamilika esinoziba kuti ukumunda kupi. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />Nokudimbwa wakagala munyika yokubimbiswa somunyika yokuzhe egala mumishasha eli naIsaki naJakobe bakaba beli balyi becho chibimbiso panhu pamwela naye. <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />Nokuti wakaba ekamilila unzinda waluba mabambo ezwakalonganywa zwikabakwa naMwali.<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />Sala nokudimbwa wakapiwa isimba lyokubhata imimba, kojoba wakaba akwegula nokuti wakabona kuti ulobimbika iye wakopa chibimbiso. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />Nokudalo kuvila kunhulume yoyu umwempela, akale iye wakaba sonhu wakafa wakazwala zwizekululu zwinji zwinanga senyenyeji jedenga akale zwisilobalwa sonsenche wokumbali kwegungwa.<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />Bose yaba banhu bakabe chinolalama nokudimbwa pabakashayika abajakatambula zwinhu zwibakabimbiswa asi bakazwibona bakashantila zwilikule, bevuma kuti banovakule akale bezi penyika. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />Banhu banolebeleka yezwi, banobhudila pachena kuti bakumushaka bugalo bwabo. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />Ngana bakaba beyeya nezwobugalo mubakava, baluba nonshaji wokubwilila. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />Asi sezwazwili, banolakamilila inyika imbuya, inanga sedenga. Nokudalo Mwali abana ishoni kuti beshobwe kuti ndiMwali wabo, nokuti wakabalonganyila iguta.<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />Abhulahamu nokudimbwa wakapila Isaki, mukukwejwa, wakabatambuliswa zwibimbiso akazwimisila kuumpila mwananhulumyana uwe umwempela chete, <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />kojoba iye wakalebwa nezwizwe kuwhi, “Inzwalo iyo ichoova muna Isaki.” <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />Wakazwibona kuti Mwali walutubula kumusa banhu kuva mubafi, nezwo sechitondejelo, wakontambula kabili kuva kubafi.<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />Nokudimbwa Isaki wakapa makombolelo onshaji unozha kunaJakobe naIsawu.<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />Nokudimbwa Jakobe abulofa wakakombolela umwe nomwe wabana banhulumyana baJosefa, ekakotama pakadozo, enamata. <verse eid="HEB 11:21" /><verse number="22" style="v" sid="HEB 11:22" />Nokudimbwa Josefa, pakufa kukwe wakalebeleka nezwokubhuda kwaba Izilayeli, kova ebalayila kuti banooajika poni mafupa awe pakufa kukwe.<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />Nokudimbwa, Mozesi, paakazwalwa, wakasiswa nabazwali babe kwemweji mitatu, nokuti bakabona kuti waluba mwana umbhodo, akale abajakatya mulawo washe.<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />Nokudimbwa Mozesi, paakakubuka, wakalamba kushobwa kuwhi mwana womwananhukajana waFalo, <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />wakashala kuti eyangate pamwempela nabanhu baMwali, pana kunakilwa muluchinyo konshaji fupi. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />Wakalangalila kuti kujiijwa pezhulu paKristo bufumi bukulwana kupinda bweIjipiti, nokuti wakabakalindila kupiwa umbhayilo.<verse eid="HEB 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27" />Nokudimbwa wakabhuda muIjipiti esinotya bukali bwashe, nokuti wakasimatija pakuda kubona yoyo usinoboneka. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />Nokudimbwa wakalondota milya yokupindilila yabaJuda nokushashaila ilopa, kuti umpalaji wembano esijibulaye imbano jabaIzilayeli. <verse eid="HEB 11:28" /><verse number="29" style="v" sid="HEB 11:29" />Nokudimbwa banhu bakataluka iGungwa iShaba sofana penyika pakakoma, asi baIjipiti pabakakweja kuta alo, bakanwila undondwe.<verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />Nokudimbwa, bulambo bweJeliko bwakakolomoka pabwaka zunguluka kwamazhuba mashanu ana mabili. <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />Nokudimbwa Rahabhu ivemu, aajakapalajwa pamwempela naabo basijakabewhilila, nokuti wakatambula neshe ifukula.<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />Ini zwimwe zwandingalebe? Unshaji autondivumija kulebeleka nezwaGidiyoni, naBharaki, naSamsoni, naJefuta, naDavidi, naSamuyeli nabamwe bapolofeti. <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />Ibo nokudimbwa bakazunda bushe, bakasungwajila indulamo, bakatambula zwibimbiso, nokuzuna milomo yeshumba, <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />bakajima mabibi makulana omoto, bakatizha kubulayiwa negwalabaza, bakawana isimba kuva mubutela, bakasima mujihondo, nokuzunda balwi behondo banova kunejimwe inyika, kuti betizhe. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />Banhukaji bakatambula bakafa babo, bakamuswa mukufa.</para>
  <para style="p" vid="HEB 11:35">Bamwe bakayangatiswa, bakalamba kutambula lusupuko, kutila kuti boomuka akale kubupenyu bubuya. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />Bamwe bakasekwa nokunabhwa, bakasungwa namaketani nokubigwa muntolongo. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />Bakapubulwa namabwe, bakachekwa nesaha pakati, bakabulayiwa negwalabaza, bekwenda bekambala zwipapata zwemhwizi nembuji, beli basheti, bakayabiswa nokuyangatiswa, <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />besakakwelelwa nenyika beyambaila mumakwa nomumatunhu, nomumapako nomumakwizhana.<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />Yaba bose, kojoba kwakalebelekwa zwibuya nezwokudimbwa kwabo, abajakatambula zwakabimbiswa, <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />nokuti Mwali wakabona mbeli chimwe chinhu chibuya kasa kwatili, kuzhe kwedu abajaluwana kupelela.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s">Mwali Tate Bedu</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Nokudalo sezwatilo zyungulukilwa noluvute lwabasumikiji, nasubo ngatisiyeni mitolo noluchinyo kulobhatilila pelyo nasu, kova tilabuka tinangatila unjiijano watakatalilwa, <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />tilingilila kunaJesu untangisi wokudimbwa kwedu umpejisisi woluvumilo lwedu, iye wakati amisilwa pezhulu polushanto lunozha, akanyamula unchinjikwa esineni nechiswabiso chawo, akanogala kululyi lwechibhula chobushe bwaMwali.<verse eid="HEB 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3" />Langalilani iye wakasimilila kukakabajwa kwakadai kuva kubachinyi, kutila kuti musinyale kana kupelelwa nolubimbo. <verse eid="HEB 12:3" /><verse number="4" style="v" sid="HEB 12:4" />Mukulwisana kwenu noluchinyo amujanu mwaswika penhambo yokunangatija kujine kukutuke ilopa lyenu. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />Mwakanganwa na, chilayilo chinosuma kwamuli sabana banhulumyana chinoti?</para>
  <para style="q1" vid="HEB 12:5">“Mwana wangu, usishunde kulayiwa kunova kunaShe,</para>
  <para style="q2" vid="HEB 12:5">usilashe mwoyo kana walangwa naiye.<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />Nokuti She unolanga yoyo waanoda,</para>
  <para style="q2" vid="HEB 12:6">akale unolaya umwe nomwe mwana waanotambula.<verse eid="HEB 12:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 12:7" />Mukulangwa zwinotilwa kuti mube nokusima, Mwali unomubhata sabana babe, nokuti ngoupi mwana usinolangwa natate babe? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />Kana musinolangwa sobukunotiwa kunhu wose, zwinoleba kuti muli bokunungwa akale amutoba bana babe. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />Kuzhe kwezwi, takabeli nawo matate openyika akatilanga, tikaalemekeja. Ani biya atitozwideleja pasi paTate bompepo kuti tiwane bupenyu? <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />Nokuti bakatilanga kwonshaji umfupi sokuda kwabo, koga Mwali banotilanga kuti tibe babuya akale tikobelane buchena bwabo. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />Kwafeno kulangwa kunota sokuti kunobuza kulwajilwa pana kushantilwa, mukukwenda kwonshaji kunobuza unchelo wolunyalalo bobululami kunaabo bakalangwa.<verse eid="HEB 12:11" /></para>
  <para style="s">Indayo nezwichenjejo</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />Nokudalo simisani maboko enu asina masimba akale nezwivi zwilodemuka! <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />Mubambile makumbo enu inzila jilokololoka kutila kuti zwinoshuja zwisisonyoke koga zwilapiwe.<verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />Babalilani kugala mulunyalalo nabanhu bose, akale mubuchena nokuti kana pesina yezwi apana angabona She. <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />Muchenjele kuti apana unokonwa kuwana chipiwo chaMwali, kuti kusibe nomwe uchaba “sonji unobaba” unomela unyaja banhu, nawo banji banoswibhiswa, <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />kusibe nomwe unopombola kana usina bumwali saIsawu, wakatengesa indulamo yobumbano bubwe pezhulu pokulya kumwempela. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />Munoziba kuti mushule mwezwo paakajoda kutola makombolelo, wakalambwa, nokuti aajakawana unshaji wokuchingunuka, kojoba wakaashaka nemishoji.<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />Imwi amujakezha kuna zwinogumwa, ibibi lyomoto, nenhilima nokufufikwa nebhepo igulwana, <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />nokulila kwewamanda, kana iwhi lyakadalo lilebeleka mawhi kuti yabo bakaliwa bakakumbilisa kuti kusibe naamwe mawhi anolebelekwa kwabali. <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />Abajakatubula kulondota indayijo yabakapiwa yokuti, “Kana imwe imhuka ikaguma idunhu, inoopubulwa namabwe.” <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />Chokomende zwakaboneka zwakazwityisa kujine Mozesi akati, “Ndimuteketa nolutyo.”<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />Koga imwi mwakezha kuDunhu lyeZiyoni, nokuguta lyaMwali umpenyu, iJelusalema lyedenga nokuluvute lwengilozi jisinolabika jakabunganila miliya, <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />nokugubungano lyembano jinamazina alokwalwa kudenga, nokuntongi uli iyeMwali wazwose, nokumipepo yabanhu yabakalulama bakatiwa bakapelelela, <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />nokunaJesu, umililili wechivumilano chipya, nokulopa lyakashashailwa linolebeleka zwibuyanana kupinda ilopa lyaAbhelo.<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />Musilambe iwhi lyoyo ukumulebeleka. Nokuti kana yabo bakalamba kuwhilila yoyo wakabalaya elipenyika besakatubula kunyeluka, kwedu kulangwa kunoopindilija kana tilamba kuwhilila yoyo unotichenjeja eli kudenga. <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />Iwhi lilye lyakazyunguza inyika asi ngweno wabimbisa kuti, “Ndichazunguja kamwempela akale kusi kuti inyika yoga asi nedenga bo.” <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />Mawhi yaya, “kamwempela akale” anotondeja kuti zwinhu zwakabumbwa zwinoozungunujwa zwibhiswe, kutila kuti yezwo zwisinotubulika zungunuka zwigale zwilipo.<verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />Nezwo ngatibokeni nokuti takapiwa bushe businozungujika, ngatinshingileni iye nokunamata Mwali tili nolulemekejo pamwe nolutyo, <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />nokuti Mwali wedu moto unopalaja.<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">Ungalilo unoshantisa Mwali</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Itani kuti ludo lwomwanakwaina lundile mbeli. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />Musikanganilwe kutambula bezi, nokudalo bamwe bakatambula ingilozi besinoziba. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />Bayeyeni yabo bayimo muntolongo, mute soti mumontolongo nabo, naabo banosheteswa sokuti mumushetela pamwempela.<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />Itani kuti kulobolana kulemekejwe pakati penu mose, akale itani kuti bulo lwabalolobolana busibe neshambwa, nokuti Mwali uchababetekisa basangu nabapomboli.<verse eid="HEB 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5" />Musikubuse kuda imali mubupenyu bwenu, gutisikani nezwamuna nazwo, nokuti wakati iye, “Anditookulasha kana kukusiya woga.” <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />Ndizwo titubula kulebeleka nolubimbo titi,</para>
  <para style="q1" vid="HEB 13:6">“She umbhanchi wangu,</para>
  <para style="q2" vid="HEB 13:6">Anditootya.</para>
  <para style="q1" vid="HEB 13:6">Unhu angatani kwandili?”<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />Yeyani batungamili benu, yabo bakamupupulila iwhi lyaMwali, mulangalile mapejelejo ondalamilo wabo, mukwejejele kudimbwa kwabo. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />Jesu Kristo unogala eli iye omene zhilo nanasi nalini kwose. <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />Musichengelwe nezwilayijo zwemishobo zwilosiyanasiyana, nokuti zwibuya kuti mwoyo usimiswe nechipiwo, kusi kuti nozwokulya kusakabhancha yabo bakaba bekudisisa.<verse eid="HEB 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10" />Tine debulilo libasinovumijwa kulyila ipo yabo banoshinga muchitumba. <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />Mitumbu yemhuka jine lopa linobuzwa mubugalo buchena, nontebuji unkulwana sontebulo wompilo woluchinyo, jinopiswa kuzhe kwemishasha. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />Nokudalo Jesu wakasheteswa kuzhe kweshubo lyeguta kutila kuchenesa banhu nelopa lilye. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />Nokudalo andeni mbeli kwaali kuzhe kwemishasha, tinyamula kuyabuliswa kukwe. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />Nokuti yopano atina iguta linogalwa unshaji undefu kasa, koga tinoshaka iguta linoozha. <verse eid="HEB 13:14" /><verse number="15" style="v" sid="HEB 13:15" />Nomuna iye, ngatindileni mbeli tipila untebulo wolukujo kunaMwali, yoyo ndiwo unchelo wondomo unokuja izina lilye. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />Musuleke kuta mishingo mibuya nokukobelana zwamunanazwo, nokuti mipilo yakadai inoshantisa Mwali.<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />Whililani batungamili benu akale muzwideleje kwabali, nokuti ibo balolinda mipepo yenu sabanhu bachoolungulula nezwazwo. Ngebete yezwi nolushanto, kusi nomwoyo unolwaja nokuti yezwi azwina lubhancho kwamuli.<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />Mutinamatile isu nokuti tinechokomende yokuba noluyeyo lubhodo, nokuti tinoda kuta zwakalulama unshaji uli wose. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />Ndinomubweta kuti munditile yezwi kutila kuti ndibwilizwe nokukambija kwamuli.<verse eid="HEB 13:19" /></para>
  <para style="s">Unamato wokukonya</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />Feno ngana Mwali wolunyalalo, iye wakamusa She wedu Jesu mubafi, undyisi unkulwana wemwizi, nelopa lyechivumilano chisinopela, <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />angomululamisa muzwinhu zwose zwibuya kutila kuti mute kuda kukwe, eshinga mukati mwenu, yezwo zwinounshantisa mumesho awe, nomuna Jesu Kristo, iye ulokwelela kukujwa lini nalini. Ameni.<verse eid="HEB 13:21" /></para>
  <para style="s">Mawhi okupejeleja</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />Ndinomubweta banakwaina bangu, kuti mutambule nokubabalila mawhi angu, nokuti ndamukwalila zwishoma. <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />Mulokwelela kuwhisisa kuti mwanakwaina wedu Timoti wakasungunulwa, ndinoomubona ndili naye angokambija kuswika.<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />Mumuse bose batungamili benu naibo bachena bose. Naabo banova kuItali banomumusa.<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />Chipiwo ngachibe namwi mose.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>