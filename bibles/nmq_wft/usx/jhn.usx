<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- NAMBYA TRANSLATION PROJECT</book>
  <para style="h">Joni</para>
  <para style="toc1">Indebo Imbuya yakakwalwa naJoni</para>
  <para style="toc2">Joni</para>
  <para style="toc3">Jon</para>
  <para style="mt2">INdebo IMbuya yakakwalwa</para>
  <para style="mt1">naJONI</para>
  <para style="imt">Matangisilo</para>
  <para style="ip">Indebo Imbuya yakakwalwa naJoni imwe yewhalo ina muchivumilano chipya inopandulula bupenyu bwaJesu Kristo. Imwe neimwe inowhi, “ivangeli,” zwiva kuti, “iNdebo iMbuya.” Jakakwalwa mushule mokufa kwaJesu naMateo, Mako, Luka naJoni. INdebo iMbuya yakakwalwa naJoni ingaba yakakwalwa nompositoli Joni zwingaba mushule mwamakole makumi mashanu anamakumi mana mushule mokuzwalwa kwaKristo. Kojoba iyo iwhalo isinoleba alo kuti Joni ndiye unkwali, unkwalilo unanga sewhalo yaJoni yokutanga, yabili neyatatu. Bamwe bakwali bantolo banoti Joni wakabegala muguta igulwana lyeEfesu noyo nshaji, nokudalo zwinoboneka sokuti lukwalo lwakakwalilwa muEfesu.</para>
  <para style="ip">Joni unoleba pachena kuti chinangwa chewhalo yeyi ndichokubhancha banhu kuti bedimbwe kuti Jesu ndiye Kristo, Mwananhulumyana waMwali umpenyu (Joni 20:31). Nokudimbwa yezwi tingaba nobupenyu muzina lilye. Iwhalo yakakwalilwa babali bechiJuda nabasi bechiJuda. INdebo iMbuya yaJoni nejimwe inzila ilosiyana nejimwe iNdebo iMbuya inhatu. Iye wakatokoloja pezwishamiso zwakatiwa naJesu akale aajakakwala zwinji pezhulu pemikwejaniso iye. Zwimwe zwitiko zwilokosha zwinanga sokubhabhatizwa kwaJesu nokukwejwa kukwe mugwegulu azwijilokwalwa muNdebo iMbuya yeyi.</para>
  <para style="iot">Zwilomumwa</para>
  <para style="io1">Joni unotanga iNdebo iMbuya muchisiyaniso chotanga 1:1-18</para>
  <para style="io1">Ekwala pezhulu pezwishamiso zwilosiyanasiyana zwakatiwa naJesu ( Joni 1:19—12:50)</para>
  <para style="io1">Eleba zwitiko zwinji mubupenyu bwaJesu zwinda kulufu nokumuka kukwe (Joni 13:1—20:31)</para>
  <para style="io1">Joni unopejisa iNdebo iMbuya muchisiyaniso chamakumi mabili nechimwempela elebeleka noumwe unshaji Jesu paakazwitondejela kubanhu mushule mokumuka kukwe mubafi akale eleba chinangwa chiche chokukwala iwhalo yeyi.</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">Iwhi lyobupenyu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />Pakutanga iye Whi wakabelipo, iye Whi wakabeli naMwali akale iye Whi wakabeli Mwali. <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />Iye wakabeli naMwali pakutanga. <verse eid="JHN 1:2" /><verse number="3" style="v" sid="JHN 1:3" />Pezhulu pape Mwali wakabumba zwinhu zwose akale nomuna iye apana chakabumbwa chisakabumbwa nomunaiye. <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />Muna iye mwaluba bupenyu akale bupenyu ndibwo bwakabeli mwenje wabanhu. <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />Mwenje yondiya unongaima munhilima, akale inhilima aijanhu yauzunda.<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />Kwaluba nonhulume wakatumwa naMwali, izina lilye waluba Joni. <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />Wakezhila koosumukija akale nokupupula nezwomwenje yoyo, kuti bose bebe nokudimbwa nomunaiye. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />Iye nokukwe aajakabeli mwenje, asi wakezha koopupula nezwomwenje. <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />Mwenje wechokomende unomunikila banhu bose, wakabezha munyika.<verse eid="JHN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10" />Wakabeli munyika, inyika yakabumbwa nomunaiye, koga aijakonziba. <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />Wakezha kubanhu bokunaibo, koga banhu bokunaibo abajakontambula. <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />Koga yabo bose bakontambula, yabo bakadimbwa muzina lilye, wakabapa masimba kuti bebe bana baMwali, <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />yabo basijakazwalwa nelopa, nokuda kwombili, kana nokuda konhu, asi nokuda kwaMwali.<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />Akale iye Whi wakaba unhu, akagala pakati pedu. Takabona lukujo lulwe, lukujo lomwananhulumyana umwempela unova kunaTate. Elizhele ishe nechokomende.<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />Joni wakapa kupupula nezwizwe, akashomejela eti, “Yoyu ndiye wandakati, ‘unoozha mushule mwangu unkulwana kwandili nokuti wakabelipo kale ndisanhu ndabaipo.’ ”<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />Kuva kukuzhajwa kukwe, tose takatambula chipiwo pezhulu chipiwo. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />Nokuti mulawo wakapiwa pezhulu paMozesi, nechipiwo nechokomende zwakezha nomuna Jesu Kristo. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />Akuna unhu wanu akabona Mwali, koga mwananhulumyana umwempela, upo pamoyo waTate, ndiye wakata kuti Mwali ezibikane.<verse eid="JHN 1:18" /></para>
  <para style="s">Undayijwo waJoni ubhabhatizi</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mateo 3:1-12</ref>; <ref loc="2JN 1:1-8">2 Joni 1:1-8</ref>; <ref loc="LUK 3:1-18">Luka 3:1-18</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />Yoku ndiko kupupula kwaJoni, baJuda pabakatumila kwaali batebuji naLevi, beva kuJelusalema koombhuza, “kuti ndiwi aani?”<verse eid="JHN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20" />Wakavuma, aajakalamba, koga wakavuma eti, “Anditobeli Kristo.”<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />Koga bakombhuza, “ndiwi anhi? ndiwi Elija na?”</para>
  <para style="p" vid="JHN 1:21">Akashandula eti, “Anditobami.”</para>
  <para style="p" vid="JHN 1:21">“Ndiwi umpolofeti na?”</para>
  <para style="p" vid="JHN 1:21">Koga wakashandula eti, “Mane.”<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />Bakati kwaali, “Ndiwi aani?” Tipenshandulo kutila yabo bakatituma. Iwi unozwiti ndiwi aani.<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />Joni wakabashandula namawhi ompolofeti Izaya eti,</para>
  <para style="q1" vid="JHN 1:23">“Ndimi iwhi lyoyo umukushomeja mugwegulu eti,</para>
  <para style="q2" vid="JHN 1:23">Lulamisa inzila yaTezi.”<verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />Yabo bakabatumwa nabaFalisi, <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />bakombhuza, bakati, “Ini biya ubhabhatiza, kana usi Kristo, Elija kana yoyo umpolofeti?” <verse eid="JHN 1:25" /><verse number="26" style="v" sid="JHN 1:26" />Joni wakabashandula eti, “Imi ndinobhabhatiza nevula, koga pakati penhu kumile, umwe wamusinoziba. <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />Iye unozha mushule mwangu, kana unchili weshangu jije andijilokwelela kujisungunula.” <verse eid="JHN 1:27" /><verse number="28" style="v" sid="JHN 1:28" />Yezwi zwakatikana kuBhetani, museli mwolwizi Jolodani, yoko Joni kwaakaba ebhabhatiza.<verse eid="JHN 1:28" /></para>
  <para style="s">Imhwizana yaMwali</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />Nezhuba linotobela wakabona Jesu ezha kwaali, akati, “Lingani imhwizana yaMwali inobhisa luchinyo lwenyika. <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />Yoyu ndiye, wandakati, unoozha mushule mwangu unkulwana kwandili, nokuti wakabelipo kale ndisanhu ndabaipo. <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />Nokwangu ndakaba ndisinounziba, koga ndizwo ndakezha ndibhabhatiza nevula, kuti etondejwe kubanhu bokwaIzilayeli.” <verse eid="JHN 1:31" /><verse number="32" style="v" sid="JHN 1:32" />Joni wakapupula, akati, “Ndakabona uMpepo ebhuluka senjiba eva kudenga, ekagala paali. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />Imi nokwangu andijakaboonziba, koga iye wakandituma kuti ndoobhabhatiza nevula, wakati kunami, ‘Iye wauchabona uMpepo ebhuluka, egala paali ndiye womene unobhabhatiza noMpepo uNchena.’ <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />Akale ndakabona ndikapupula, kuti yoyu ndiye Mwananhulumyana waMwali.”<verse eid="JHN 1:34" /></para>
  <para style="s">Balayijwa baJesu bokutanga</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />Muchimuka akale, Joni wakabelimile nabalayijwa babe babili, <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />akale paakabona Jesu ekwenda wakati, “Lingani iMhwizana yaMwali!”<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />Balayijwa babili pakonwha eleba yezwi, bakatobela Jesu.<verse eid="JHN 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 1:38" />Jesu wakachebuka, akababona betobela akababhuza eti, “Ini zwamukumuda?”</para>
  <para style="p" vid="JHN 1:38">Bakashandula beti, “Rabhi” (zwinoleba kuti undayiji), “ukumugala kupi?”<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />Wakati kwabali, “Izhani moobona.” Bakezha bakabona kwaakabegala akale nezhuba yelyo bakagala naye, kwakabakwaba madeko.<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />Umwe wababili wakawha Joni elebeleka, kova ontobela, wakabeli Endulu wakabeli unkulu nonuna naSimoni Pita. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />Chaakatanga kuta kuwana mwanakwaina uwe Simoni akati kwaali, “Tawana Mesiya,” (zwinoleba kuti Kristo) <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />Wakonsenga, kunaJesu.</para>
  <para style="p" vid="JHN 1:42">Jesu wakoondinga akati, “Ndiwi Simoni mwananhulumyana waJona? Unooshobwa kuwhi Kefasi,” (kana zwatolekwa zwileba kuti Pita).<verse eid="JHN 1:42" /></para>
  <para style="s">Jesu unoshoba Filipu naNataniyeli</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />Muchimuka Jesu wakayeya kunda kuGalili akawana Filipu akati kwaali, “Nditobele.” <verse eid="JHN 1:43" /><verse number="44" style="v" sid="JHN 1:44" />Ngweno Filipu wakabeli wokuBhetisaida iguta linova Endulu naPita. <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />Filipu wakawana Nataniyeli akati kwaali, “tongwana iye wakakwalwa naMozesi mumulawo akale nowakakwalwa nabapolofeti, Jesu wokuNazaleta mwananhulumyana waJosefa.”<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />Nataniyeli wakati kwaali, “pana chibuya na chingabhuda muNazaleta?”</para>
  <para style="p" vid="JHN 1:46">Filipu wakashandula eti, “izha ubone.”<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />Jesu paakabona Nataniyeli ezha kwaali wakati, “linga, uIzilayeli womene, muna iye amuna buchengeji.”<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />Nataniyeli wakati kwaali, “ani unondiziba chini?”</para>
  <para style="p" vid="JHN 1:48">Jesu wakoshandula, “Filipu esanhu akushoba, pawabeli mudako monti wonkuyu, ndabakubona kale.”<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />Nataniyeli wakati, “Ndayiji, uMwananhulumyana waMwali, uli She weIzilayeli.”<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />Jesu wakati kunaiye, “ukumudimbwa na nokuti ndati kunawi, ndakubona mudako lyonti wonkuyu? Unoobona zwinhu zwikulwana pana yezwi.” <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />Akale wakati, “Ndolebesa, munoobona idenga lizhulika, akale ingilozi jaMwali jitanha nokubhuluka pezhulu pomwananhulumyana wonhu.”<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">Mabhiko Okulobolana kuKana</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />Nezhuba lyatatu kwakaba namabhiko kuKana muGalili, akale amai baJesu bakabelipo. <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />Jesu nabalayijwa babe, bakaba bakokwa kumabhiko okulobolana. <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />Iwaini payakapela, amai baJesu bakati kwaali, “abachina iwaini.”<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />Jesu wakati kwabali, “Imwi mai, zwinani nami yezwi? Unshaji wangu aujanu waswika.” <verse eid="JHN 2:4" /><verse number="5" style="v" sid="JHN 2:5" />Amai babe bakati kubashingi, “Itani zwose zwaachamubuja.” <verse eid="JHN 2:5" /><verse number="6" style="v" sid="JHN 2:6" />Pakalepo, kwakaba kuli imbiya jamabwe ishanu nemwempela, jikabigwa yopo, jili jabaJuda songalilo wabo pakuchenesa, imwe neimwe inyamula malita angaba izana. <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />Jesu wakati kubashingi, “Izhajani imbiya nevula.” Bakajizhaja imbiya kuti fwampi. <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />Wakati kwabali, “Ngweno tekani imwe musenge kuntungamili wamabhiko.” Nezwo bakasenga. <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />Untungamili wamabhiko paakalabila ivula, yakababa iwaini. Aajakaziba kuti yava kupi (kojoba bashingi bakabateka ivula bakabezwiziba). Untungamili wamabhiko wakashoba undoboli, <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />akati kwaali, “Unhu wose unosotanga apa iwaini imbuya, kooti kana banhu banwa basungunuka, ndipo pakunobuzwa iwaini imbi, asi imwi mwalondota iwaini imbuya kujine kube ngweno.”<verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />Yechi chitondejelo chotanga chakatiwa naJesu kuKana muGalili. Wakatondejela lukujo lulwe, balayijwa babe bakadimbwa mwaali.<verse eid="JHN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />Mushule mwezwo wakenda kuKapenaume namai babe nabanakwaina babe nabalayijwa babe, yoko bakanogala mazhuba mashoma.<verse eid="JHN 2:12" /></para>
  <para style="s">Jesu unonda kuTempeli</para>
  <para style="r">(<ref loc="MAT 21:12">Mateo 21:12</ref>,<ref loc="MAT 21:13">13</ref>; <ref loc="LUK 19:45">Luka 19:45</ref>,<ref loc="LUK 19:46">46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />Miliya yePasika yabaJuda yakababa pelyo akale Jesu wakenda kuJelusalema. <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />Mutempeli wakawana yabo baluba betengesa ingombe, imhwizi, inkwilimba nabanochincha imali beligele pamatebuli abo. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />Wakakosha iswipu yoluji, akabatata bose mutempeli, nemhwizi, nengombe jabo, akatataula imali yaabo baluchincha imali, akapindimula matebuli abo. <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />Wakabuja yabo bakabetengesa inkwilimba kuti, “Bhisani zwinhu yezwi yopa, musite ingumba yaTate bangu ibe ingumba yokutengesela.” <verse eid="JHN 2:16" /><verse number="17" style="v" sid="JHN 2:17" />Balayijwa babe bakalangalila kuti kwakabakakwalwa kuti, “Kusungwalila ingumba iyo kuchandilya moyo.”<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />BaJuda bakati kwaali, “Ngechipi chitondejelo chaungatitondeje kuti ini uta yezwi?” <verse eid="JHN 2:18" /><verse number="19" style="v" sid="JHN 2:19" />Jesu wakabashandula akati, “Kolomolani itempeli yeli, asi mumazhuba matatu ndolibakulula kabili.”<verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />BaJuda kova beti, “Kwakatola makole makumi mana ana mashanu nelimwempela kuti kubakwe itempeli yeli, asi ungalibaka mumazhuba matatu na?”<verse eid="JHN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21" />Koga iye itempeli lyaakabeleba umbili uwe. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />Nezwo paakamuswa kubafi balayijwa babe bakakumbulukwa kuti wakabazwileba yezwi akale bakadimbwa mundebo nomumawhi akalebwa naJesu.<verse eid="JHN 2:22" /></para>
  <para style="s">Jesu Unaluzibo Nobunhu Bwabanhu</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />Ngweno paakabeli muJelusalema kumiliya yePasika, banji bakadimbwa munaiye pabakabona zwitondejelo zwaakata, <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />koga Jesu aajakabimba nabo, nokuti waluziba bunhu bwabanhu, <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />nezwo aajakabeda busumikiji bonhu, nokuti iye waluziba zwaluba zwili munhu.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">Jesu na Nikodimasi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />Ngweno kwakabeli nonhulume wakabeli unFalisi unowhi Nikodimasi, untungamili wabaJuda. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />Yoyu nhulume wakezha kunaJesu busiku akati kwaali, “Rabhi, tinoziba kuti undayiji unova kunaMwali, nezwo akuna angata zwitondejelo yezwi zwaukumuta kuzhe kokuti Mwali elinaye.”<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />Jesu wakonshandula eti, “Ndinokubuja ilebeswa nditi, kuzhe kokuti unhu ezwalwe bupya, aangabone buShe bwaMwali.”<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />Nikodimasi wakati kwaali, “Unhu unozwalwa chini iye, abankulwana? Angabwilila, kabili muntumbu wamai babe, etikozwalwa kabili!”<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />Jesu wakashandula akati, “Ndokubuja ilebeswa,” kuzhe kokuti unhu ezwalwe nevula noMpepo aangangwine mubushe bwaMwali. <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />Yezwo zwazwalwa nombili ngezwombili akale yezwo zwazwalwa noMpepo ngezwompepo. <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />Usichename nokuti ndati kunawi, unokwelela kuzwalwa bupya. <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />Ibhepo linopunga palinoda akale unowha izhoba lyalyo koga autoziba kwalinova kana kwalinonda, zwakadalo bo kuna iye wakazwalwa noMpepo.<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />Nikodimasi wakabhuza eti, “Ani biya yezwi zwinotikana chini?”<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />Jesu wakonshandula eti, “Iwi ulindayiji wokuIzilayeli, asi autowhisisa yezwi?” <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />Ndolebesa nditi kwauli, tinolebeleka zwatinoziba akale tinopa busumikiji kuna yezwo zwatakabona koga imwi amutotambula busumikiji bwedu. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />Kana ndingomukubuja zwinhu zwopenyika amutodimbwa, mungadimbwa chini ndingomukubuja zwinhu zwokudenga? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />Akuna wakenda kudenga koga iye Mwananhulumyana woNhu, unobhuluka eva kudenga.<verse eid="JHN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14" />Akale sezwo Mozesi akanyamula inyoka mugwegulu, nezwo Mwananhulumyana woNhu unokwelela kunyamulilwa pezhulu, <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />nokuti yoyo unodimbwa kwaali unowana bupenyu businopela. <verse eid="JHN 3:15" /><verse number="16" style="v" sid="JHN 3:16" />Nokuti Mwali wakayida inyika, zwokuti wakapila Mwananhulumyana umwempela uwe, kuti yoyo unodimbwa kwaali, aatoopala koga unoba nobupenyu businopela. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />Mwali aajakatuma Mwananhulumyana uwe penyika kuti ezhe koobetekesa inyika, koga kuti inyika ichijwe pezhulu pape.<verse eid="JHN 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 3:18" />Iye unodimbwa kwaali atobetekeswa asi iye usinodimbwa wabetekeswa kale nokuti aajadimbwa muMwananhulumyana umwempela waMwali. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />Akale yoyu ndiwo untongo, wokuti mwenje wakezha munyika akale banhu bakada inhilima, pana mwenje nokuti zwito zwabo zwaluba zwibi. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />Wose unota zwisakalulama, unobenga mwenje akale atoozha kumwenje, kutila kuti zwito zwizwe zwisibhude pachena. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />Koga iye unota ilebeswa, unozha kumwenje, kuti zwiboneke zwibuyanana kuti zwito zwizwe zwakatiwa mukuwhilila Mwali.<verse eid="JHN 3:21" /></para>
  <para style="s">Jesu naJoni umbhabhatizi</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />Mushule mwezwi Jesu nabalayijwa babe bakenda kunyika yeJudiya, yoko wakaba elinabo, ebhabhatiza banhu. <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />Joni wakaba ebhabhatiza kuAnoni pelyo neSalimu nokuti kwakabeli nevula inji kwakale, banhu bakezha bebhabhatizwa. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />Yopo Joni wakaba esanhu angwina muntolongo.<verse eid="JHN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />Ngweno kwakaba nokunyenyejana pakati pabalayijwa baJoni nonJuda pezhulu pokucheneswa. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />Akale bakezha kuna Joni, bakati kwaali, “Ndayiji yondiya wakabeli nawi museli mwolwizi Jolodani, uwakapila busumikiji, ukumubhabhatiza akale bose bakumunda kuna iye.”<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />Joni wakashandula eti, “akuna unhu angatambula chinhu kuzhe kokuti ukumupiwa chiva kudenga. <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />Imwi momene mwandisumikijila kuti, ndakakati anditoba Kristo koga ndakatumwa mbeli kukwe. <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />Iye una undobolwa, ndiye unkwasha, umpelekeji wonkwasha unoma akale onwha, eshanta kasa kuwha iwhi lyonkwansha, nezwo kushanta kwangu kwazhajikijwa. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />Unokwelela kukubuka, koga ndokwelela kuninipa.”<verse eid="JHN 3:30" /></para>
  <para style="s">Iye wakava kudenga</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />Iye unova pezhulu, upo pezhulu pabo bose, iye uli wenyika, nguwenyika, akale unolebeleka zwinhu zwenyika, iye unova kudenga wipo pezhulu pabo bose. <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />Una busumikiji nezwaakabona, akale nezwaakawha, asi akuna kana umwempela unotambula busumikiji bubwe. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />Iye unotambula busumikiji bubwe unosimisa kuti Mwali ichokomende. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />Nezwo yoyo Mwali wakatuma, ndiye unoleba mawhi aMwali, nokuti utopa uMpepo nokukwela zwisinojiba. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />Tate banoda Mwananhulumyana, akale bakabiga zwinhu zwose mumaboko awe. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />Iye unodimbwa muMwananhulumyana una, bupenyu businopela, iye usinowhilila Mwananhulumyana aatobona bupenyu, koga bukali bwaMwali bunogala paali.<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">Jesu Nonhukaji UNSamalia</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />Ngweno Jesu paakaziba kuti baFalisi, bawha kuti Jesu wakabelayija, akale ebhabhatiza eta balayijwa banji kupinda Joni, <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />(kojoba Jesu, iye nokukwe aajakabhabhatiza, asi balaijwa babe ndibo bakabe bhabhatiza) <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />Wakabhuda muJudiya akenda kuGalili kabili. <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />Asi wakabekwelela kupinda nomuSamaliya.<verse eid="JHN 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 4:5" />Nezwo wakezha kuguta lyeSaika limo muSamaliya, pelyo nominda waJakobe waakabapa mwananhulumyana uwe Josefa seshabo. <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />Inhiba yaJakobe yakabeli pakalepo, Jesu anyajwa nolwendo lulwe wakagala pelyo nenhiba. Kwaluba unshaji wamasikati makulwana.<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />Kwakaswika unhukaji wokuSamaliya koteka ivula, Jesu wakati kwaali, “Ndipe ivula ndinwe.” <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />Noyo unshaji balayijwa babe bakabenda kuguta kunotenga zwolya.<verse eid="JHN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />Unhukaji unSamariya wakati kwaali, “Iwi unJuda, imi ndinSamaliya ungandikumbila chini ivula?” (Nokuti baJuda abatolyijana nabaSamaliya)<verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />Jesu wakonshandula eti, “Ngana uziba chipo chaMwali akale kuti ndiyani ukumulebeleka yezwi kwauli eti, ‘Ndipe ivula ndinwe’ iwi waluunkumbila, akale iye walukupa ivula inopa bupenyu.”<verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />Unhukaji wakati kwaali, “Shungwasha amuna chokutekesa, akale inhiba inomila, munoiwana kupi ivula inopa bupenyu?” <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />Unkulwana na kupinda tate bedu Jakobe wakatipa inhiba yeyi, akanwa mwaili iye emene, nabana banhulumyana babe, nechuma chiche? <verse eid="JHN 4:12" /><verse number="13" style="v" sid="JHN 4:13" />Jesu wakati kwaali, “Wose unonwa yeyi ivula unoba nenyota kakale, <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />asi iye unonwa yeyo ivula yandichoompa, aatoba nenyota, ivula yandichoompa, inooba mwaali ishawi, linovilila kuswikila mubupenyu businopela.”<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />Unhukaji wakati kwaali, shungwasha ndipeni ivula yeyi kuti ndisibe nenyota akale, kana kuzha yokuno kooteka ivula.<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />Jesu wakati kwaali, “Inda unoshoba undume uwo, muzhe yokuno.”<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />Unhukaji wakoonshandula eti, “Andina undume.”</para>
  <para style="p" vid="JHN 4:17">Jesu wakati kwaali, “Walebesa kuti, Auna undume. <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />Nokuti wakabeli nabalume bashanu, akale yoyu waunanaye ngweno aatoba undume uwo, yezwi wazwileba nechokomende.”<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />Unhukaji wakati kwaali, “Shungwasha, ndinobona kuti mumpolofeti.” <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />Matategulu edu balunamatila mudunhu yeli, koga imwi munoti kuJelusalema ndiko kuna bugalo bulosungilwa kunamatila banhu.<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />Jesu wakati kwaali, “Nhukaji ndidimbwe, unshaji ukumuzha yopo pabasinoonamata Tate pedunhu yeli kana muJelusalema.” <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />Imwi munonamata zwamusinoziba, isu tonamata zwatinoziba, nokuti luchijo lunova kuba Juda. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />Koga unshaji ukumuzha, akale waswika ndingweno, yopo banodimbwa zwechokomende banoonamata Tate mumpepo nomuchokomende, yabo ndibo Tate babanoshaka kuti bebanamate. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />Mwali umpepo, akale yabo banounamata banokwelela kuunamata mumpepo nomuchokomende.<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />Unhukaji wakati kwaali, “Ndinoziba kuti Mesiya ukumuzha (iye unoshobwa ewhi Kristo,) angozha unootipandululila zwinhu zwose.”<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />Jesu wakati kwaali, “Imi ndikumulebeleka nawi ndimi iye.”<verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />Pakalepo balayijwa babe, bakezha. Bakachenama kuti ukumulebeleka nonhukaji, asi akuna wakati kunhukaji, “Ini zwaunoda,” kana kunaJesu kuti, “Ini ulebeleka naye?”<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />Nezwo unhukaji wakasiya ihali iye yevula, akenda muguta, akati kubanhu, <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />“Izhani mubone unhulume wandibuja zwose zwandakata. Angaba iye Kristo na yoyu?” <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />Bakabhuda muguta akale bakenda kwaali.<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />Noyonshaji balayijwa babe bakombweta beti “Ndayiji ilya.”<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />Koga wakati kwabali, “Ndina zyokulya zwamusinoziba imwi.”<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />Balayijwa bakati kunoumwe noumwe wabo, “angaba ipo na woombuzila zwokulya?”<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />Jesu wakati kwabali, “Kulya kwangu kuta chido choyo wakandituma, akale nokupejisa unshingo uwe. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />Imwi amutosoti, ‘Kuchina myeji mina yasala, kova kuzha kuvuna na?’ Ndomubuja kuti ilingani, mubone kuti muminda mwachena kale kwakwelela kuvunwa. <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />Iye unovuna, unowana indipo akale unobunganya michelo kobupenyu businopela kutila kuti umbyali nounovuna beshante panu pamwempela. <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />Nokudalo chichimbe chinolebesa chinoti, ‘Umwe unobyala akale umwe unovuna.’ <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />Ndakamutuma kuti muvune yezwo zwamusakashinga, bamwe bakashinga, akale imwi mwakavuna pabakashinga ibo.”<verse eid="JHN 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />BaSamaliya banji bomuguta yeli bakadimbwa kunaJesu pezhulu pobusumikiji bonhukaji yoyu wakati, “Wandibuja zwose zwandakata.” <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />Nokudalo BaSamaliya pabakezha kwaali, bakonkumbila kuti egale nabo, akale wakagala kwakale mazhuba mabili.<verse eid="JHN 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41" />Akale banji kasa bakadimbwa pezhulu pamawhi aJesu. <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />Bakati kunhukaji, “Atichinodimbwa nokuda kwamawhi awo, nokuti tazwiwhila toga, akale taziba kuti yoyu chokomende unchiji wepasi lyose.”<verse eid="JHN 4:42" /></para>
  <para style="s">Jesu unochija mwananhulumyana wontungamili</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />Mushule mwamazhuba mabili wakenda kuGalili. <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />Nokuti Jesu nokukwe wakabati, “umpolofeti aatokujwa munyika iye.” <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />Nokudalo paakaswika kuGalili, baGalili bakontambula, nokuti bakababona zwose zwaakabata muJelusalema kumiliya, nokuti naibo bakabenda kumiliya yePasika. <verse eid="JHN 4:45" /><verse number="46" style="v" sid="JHN 4:46" />Wakenda akale kuKana muGalili, yoko kwakabashandula ivula ikabe waini. Akale kuKapenawomi kwakabeli nontungamili walulwalilwa nomwananhulumyana. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />Paakawha kuti Jesu wava kuJudiya waswika muGalili, wakenda akoonkumbila kuti ende enochija mwananhulumyana uwe, nokuti wakaba alobofa. <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />Jesu nezwo wakati kwaali, “Kuzhe kokuti mubone zwitondejelo nozwishamiso amutodimbwa.”<verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />Untungamili wakati kwaali, “Shungwasha, delela, mwana wangu esanhu afa.”<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />Jesu wakati kwaali, “Inda mwananhulumyana uwo unochila.”</para>
  <para style="p" vid="JHN 4:50">Unhulume yoyu wakadimbwa iwhi Jesu lyakalebeleka kwaali, akanyamuka akenda kumba kukwe. <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />Paakaba enda, bashingi babe bakontandamija bakombuja kuti mwananhulumyana uwe wachila.<verse eid="JHN 4:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52" />Nezwo wakababhuza unshaji paakatanga kupabula, bakati kwaali, “Zhilo neawa yotanga yamasikati makulwana, kupisa mbili nokululuma kwakapela.” <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />Tate bakaziba kuti ndiwo unshaji Jesu paakati kwabali, “Mwananhulumyana uwo uchachila,” akale iye nokukwe wakadimbwa, nemhuli iye yose.<verse eid="JHN 4:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54" />Ngweno chaluba chishamiso chabili yechi, Jesu chaakata abuya eva kuJudiya enda kuGalili.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">Kuchilisa peGandwa</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />Mushule mwezwi, kwakaba namabhiko abaJuda, akale Jesu wakenda kuJelusalema. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />Ngweno muJelusalema peshubo lyeMhwizi, kwaluba negandwa lyaluwhi muchiHebhelu Bhetisaida, lyaluba lyakazyungulukwa notutumba tushanu. <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />Mututumba kwakabelilele banhu banji bakabelwala, mapofu, makosha, nabakakokonyala, <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" /><note caller="+" style="f"><char style="fr" closed="false">5:4 </char><char style="ft" closed="false">Mamwe makwalo echiGiliki aana ivesi yeyi</char></note>bekamilila kukovongwa kwevula nokuti ingilozi yaShe yakabekwenda noumwe unshaji, mugandwa ikovonga ivula, yoyo walutanga kungwina mushule mwokukovongwa kwevula wakabechiliswa kuva mubulwaji cheninge bupi bwaalulwala. <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />Umwe unhulume wakabelipo, wakabalwala kwamakole makumi matatu anatushanu tunatutatu. <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />Jesu paakaumbona, wakaziba kuti waluba akalala kwonshaji undefu, wakombhuza eti, “Unoda kuchila na?”<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />Unhulume unolwala wakashandula eti, “Shungwasha imi andina unhu angandibiga mugandwa pakunokovongwa ivula, asi yopo kana ndinda umwe unongwina mbeli kwangu.”<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />Jesu wakati kwaali, “Nyamuka, utole bushasha ukwende.” <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />Pakalepo unhulume wakachila, akatola bushasha bubwe akakwenda. Yeli lyaluba izhuba lyesabata. <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />BaJuda bakati kunhulume waluba achiliswa, “Nasi isabata azwipo pamulawu kuti unyamule bushasha bubo.”<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />Koga wakabashandula eti, “Unhulume wandichilisa wati kunami, ‘Tola bushasha bubo ukwende.’ ” <verse eid="JHN 5:11" /><verse number="12" style="v" sid="JHN 5:12" />Bakombhuza beti, “Ndiani unhulume wakubuja kuti utole bushasha bubo ukwende?”<verse eid="JHN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13" />Ngweno unhulume wakaba achiliswa aajakaziba kuti ndiani, nokuti Jesu wakababhuda, sezwo kwaluba nebunga lyabanhu mubugalo yobo. <verse eid="JHN 5:13" /><verse number="14" style="v" sid="JHN 5:14" />Mushule mwezwo, Jesu wakongwana mutempeli akati kwaali, “Linga wachila, usichinye kabili, kutila kuti usiwilwe nezwikulwana kupinda yezwi.”<verse eid="JHN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15" />Unhulume yoyu wakabhuda akanobuja baJuda kuti ndiJesu woonchilisa. <verse eid="JHN 5:15" /><verse number="16" style="v" sid="JHN 5:16" />Yezwi ndizwo zwakatisa kuti baJuda boonshetesa Jesu nokuti wakabeta yezwi nezhuba lyesabata. <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />Koga Jesu wakabashandula eti, “Tate bangu bakumushinga, nami ndikumushinga.”<verse eid="JHN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18" />Yezwi ndizwo zwakatisa kuti baJuda bedisise kasa kuumbulaya, nokuti aajakataluka mulawo wesabata chete koga wakabeshoba Mwali kuti ndiTate babe, ezwikwelanisa naMwali.<verse eid="JHN 5:18" /></para>
  <para style="s">Isimba lyoMwananhulumyana</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />Jesu wakati kwabali, ndinolebesa nditi kwamuli, Mwananhulumyana apana zwaangate ega, asi unota zwaanobona zwitiwa naTate babe, nezwo zwose zwinotiwa naTate, zwinotiwa bo noMwananhulumyana. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />Nezwo Tate banoda Mwananhulumyana, akale banontondeja zwose zwabamuta, banoontondeja mishingo mikulwana kuna yeyi, zwokuti munooshama. <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />Sezwo Tate bemusa bakafa akale bebapa bupenyu, zwili alo, Mwananhulumyana unopa bupenyu kunaabo baanoda kupa bupenyu. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />Tate abatotonga unhu, koga bakapa isimba lyose lyokutonga kuMwananhulumyana, <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />kuti bose bekuje Mwananhulumyana somubanokuja Tate. Iye usinokuja Mwananhulumyana aatokuja Tate bakontuma.<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />Ndolebesa nditi kwamuli, iye unowhilila iwhi lyangu akale edimbwa munaiye wakandituma, una bupenyu businopela akale aatotongwa koga unobabhuda mulufu akangwina mubupenyu. <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />Ndolebesa nditi kwamuli, unshaji ukumuzha akale ndingweno yopo bakafa pabanowha iwhi lyoMwananhulumyana waMwali akale yabo banoliwha banoolalama. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />Sezwo Tate bana bupenyu mwabali, nezwo bakapa Mwananhulumyana kuti ebe nobupenyu mwaali, <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />akale bakompa isimba lyokutonga nokuti Mwananhulumyana woNhu. <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />Musishamiswe nezwi, nokuti unshaji ukumuzha yopo bose baimo mumakumbu banowha iwhi lilye, <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />akale banoobhuda mumakumbu abo, yabo bakata zwibuya banoomuka bebe bapenyu, akale yabo bakata zwibi banoomukila kunotongwa.<verse eid="JHN 5:29" /></para>
  <para style="s">Basumikiji baJesu</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30" />Apana zwandinotubula kuta nesimba lyangu, ndotonga sokubujwa naMwali, akale kutonga kwangu kwakalulama nokuti anditoshaka kuda kwangu asi kuda kwoyo wakandituma.<verse eid="JHN 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />Kana ndizwisumikijila, busumikiji bwangu abutoba bwechokomende, <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />upo umwe unosumikija kwandili akale ndinoziba kuti busumikiji bwaanopa nezwangu ngobwechokomende. <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" />Mwakatuma bamwe banhu kunaJoni, akasumikija ichokomende. <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />Zwisi zwokuti ndinobimba nobusumikiji bwandikumutambula kuva kubanhu, asi ndinoleba yezwi kuti muchijwe. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />Joni wakabeli chimuniko chakabetutuma chingaima, akale imwi mwakashantila untutumo uwe kwonshaji unshoma. <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />Asi busumikiji bwandinanabwo bukulwana kupinda bwaJoni, nezwo mishingo yandakapiwa naTate kuti ndipejise, yeyi mishingo yandikumuta, inobuza busumikiji bwokuti Tate bakandituma. <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />Akale Tate bakandituma ibo bakanditila busumikiji. Iwhi lyabo amujanu mwaliwha, amujanu mwabona zwabali, <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />akale amuna iwhi lilye munamwi, nokuti amutoundimbwa yoyo waatuma. <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />Munotokoloja makwalo Machena, nokuti munoyeya kuti munowana bupenyu businopela mwaali, akale yayo makwalo ndiwo anobuza busumikiji bwangu, <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />asi munolamba kubuya kwandili kuti mube nobupenyu.<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />Anditotambula kukujwa kunova kubanhu. <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />Koga ndinomuziba. Ndoziba kuti amuna ludo lwaMwali mwamuli. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />Ndezha muzina lyaTate bangu asi amutonditambula, koga umwe angozha nezina lilye, munoontambula. <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />Mungadimbwa chini, imwi munotambula lukujo kuva kunoumwe noumwe, asi musinoshaka lukujo lunova kunaMwali chete. <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />Musiyeye kuti ndinomupa undandu kunaTate. NdiMozesi ukumumupa undandu kuna yoyo wamunobimba naye. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />Kana mwakadimbwa munaMozesi, mwaludimbwa munami, nokuti wakakwala nezwangu. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />Asi kana musinodimbwa mumakwalo awe, mungawadimbwa chini mawhi angu?<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">Jesu unopa kulya kuzwiulu zwishanu</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mateo 14:13-21</ref>; <ref loc="LUK 9:10-17">Luka 9:10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />Mushule mwezwi Jesu wakenda kunelimwe ibhazu lyegungwa lyeGalili, lyakabewhi akale Taibheliyasi. <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />Akale ibunga igulwana lyakontobela, nokuti bakababona zwishamiso zwaakata echilisa balwaji. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />Jesu wakatanha mudunhu, akale mwakale akagala pasi nabalayijwa babe. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />Pakalepo unshaji wePasika, miliya yabaJuda wakababapelyo. <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />Paakalinga, wakabona ibunga igulwana lizha kwaali, Jesu wakati kuna Filipu, “Ndikupi kwatingatenga chinkwa, kuti banhu yaba belye?” <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />Yezwi wakazwileba onkweja, nokuti iye nokukwe wakabeziba kuti walutani.<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />Filipu wakonshandula eti, “Indipo yemyeji mishanu ina umwempela, aingatenge chinkwa chinokwana kuti umwe noumwe wabo ewane kababi.”<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />Umwe wabalaijwa babe Endulu, mwanakwaina waSimoni Pita wakati kwaali, <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />“Pana umbisana yopano unazwinkwa zwebhali zwishanu nehobe imbili, koga yezwi zwingatani pabanhu bose yaba.” <verse eid="JHN 6:9" /><verse number="10" style="v" sid="JHN 6:10" />Jesu wakati kwabali, “Gajikani banhu pasi.” Pakalepo pabugalo yobo pakabelina buhwa bunji, sezwo banhulume bakagala pasi, bakabeli bangaswika zwiulu zwishanu. <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />Kova Jesu etola zwinkwa, eboka, paakapeja, wakakobela yabo balubabeligele. Akabakobela nehobe naijo, bakalya madilo. <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />Akale pabakati baguta, wakabuja balayijwa babe eti, “Bunganisani zwimedu zwasala kusibe nezwichalashika.” <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />Bakabunganisa, bakazhaja zwizuma igumi nezwibili zwezwimedu zwakava muzwinkwa zwishanu zwebhali, zwakasiyiwa naabo bakalya.<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />Banhu pabakabona chishamiso chaakata, bakati, “Yoyu ndiye chokomende umpolofeti, uchezha munyika.” <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />Jesu aziba kuti bakumuda kuuntola nesimba kuti bounte she, Jesu wakabhuda akabwilila akale mudunhu eli ega.<verse eid="JHN 6:15" /></para>
  <para style="s">Jesu unokwenda pezhulu pevula</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mateo 14:22-33</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />Kwaba madekwana, balayijwa babe bakabhulukila kugungwa, <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />bakangwina mubwato bukulwana, benda museli kuKapenaumi. Kwakabaswibha, akale Jesu aajakabanu aswika kwabali. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />Igungwa lyakanyamuka nokuti kwakabakupunga ibhepo linesimba. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />Bakati bayuwa, bakwenda makilomita angaba mashanu kana mashanu nelimwe, bakabona Jesu ekwenda pezhulu pegungwa akale esendela pelyo nobwato. Bakatya, <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />koga wakati kwabali, “Ndimi, musitye.” <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />Pakalepo bakountambula mubwato, akale pakalepo bwato bwakaswika kunyika kwabakabenda.<verse eid="JHN 6:21" /></para>
  <para style="s">Banhu banoshaka Jesu</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />Nezhuba linotobela, banhu bakabasala kunelimwe ibhazu lyegungwa bakababona bwato bumwempela chete kwakale, akale Jesu aajakabangwina mubwato nabalayijwa babe, asi kuti balayijwa babe bakabenda boga. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />Koga, mato anova kuTayibheliyasi akasendela pelyo noopo pabakabalyila chinkwa mushule mokuboka kwaTezi. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />Banhu pabakabona kuti Jesu aajakabelipo, kana balaijwa babe, ibo nokwabo bakangwina mumato yayo bakenda kuKapenaumi, beshaka Jesu.<verse eid="JHN 6:24" /></para>
  <para style="s">Jesu Ndiye Chinkwa Chobupenyu</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />Pabakongwana museli lyegungwa bakati kwaali, “Ndayiji wezha lini yokuno?”<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />Jesu wakabashandula eti, “Ndolebesa nditi kwamuli, mondishaka, kusi kuti mwabona zwishamiso, asi pezhulu pokuti mwakalya mukaguta zwinkwa. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />Musizwinyaje nezwokulya kunopela, koga kulya kwemisi isinopela, kwamunopiwa noMwananhulumyana woNhu, nokuti paali Mwali Tate bakabiga imhande yabo.”<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />Kova beti kwaali, “Ini zwatilokwelela kuta, kuti tibeta mishingo yaMwali?” <verse eid="JHN 6:28" /><verse number="29" style="v" sid="JHN 6:29" />Jesu wakabashandula eti, “Yoyu ndiwo unshingo waMwali, kuti mudimbwe munooyo waakatuma.”<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />Nokudalo bakati kwaali, “Ngweno ngechipi chitondejelo chauchata, kuti tibone, akale tikudimbwe? Mishingo ipi yaunota? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />MaTate edu akalya imana mugwegulu, sezwakakwalwa kuwhi, ‘Wakabapa chinkwa chakava kudenga kuti belye.’ ”<verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />Jesu wakati kwabali, “Ndinolebesa nditi kwamuli,” Mozesi zwakamupa aatoba chinkwa chinova kudenga, Tate bangu ndibo banomupa chinkwa chechokomende, chinova kudenga. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />Nokuti chinkwa chaMwali ndicho chinobhuluka chiva kudenga, akale chipa inyika bupenyu. <verse eid="JHN 6:33" /><verse number="34" style="v" sid="JHN 6:34" />Bakati kwaali, “Tezi tipeni chinkwa yechi unshaji wose.”<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />Jesu wakati kunaibo, “Ndimi chinkwa chobupenyu, yoyo unozha kwandili aatofa nenzhala, noyo unodimbwa kwandili aatofa nenyota. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />Koga sezwandakaleba kwamuli, kuti mwandibona imi asi amutodimbwa <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />Bose yabo bandinopiwa naTate bangu banoozha kwandili, akale yoyo unozha kwandili, anditoontatamilila kuzhe. <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />Nokuti ndakabhuluka ndiva kudenga, kusi koota chido changu, asi chido choyo wakandituma, <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />akale yechi ndicho chido choyo wakandituma, kuti ndisilashikilwe kana nomwempela waabo bose baakandipa, koga kuti ndibamuse muzhuba lyokupejeleja. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />Nokuti, yechi ndicho chido chaTate bangu, kuti wose unobona Mwananhulumyana akale edimbwa mwaali unooba nobupenyu businopela, akale imi ndoomusa nezhuba lyokupejisila.”<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />BaJuda bakanyunyuta, nokuti wakati, “Ndimi chinkwa chakabhuluka chiva kudenga.” <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />Bakati, “Yoyu aatoba Jesu, mwananhulumyana waJosefa, unatate namai batinoziba na? Biya unoleba chini ngweno kuti, ‘Ndakabhuluka ndiva kudenga.’ ”<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />Jesu wakabashandula eti, “Musingungune mukati mwenu. <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />Apana angezha kunami, kuzhe kokuti Tate bakandituma bebabuze, akale ndinoobamusa nezhuba lyokupejeleja. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />Zwilokwalwa muwhalo jabapolofeti kuwhi, ‘Akale bose banoolayijwa naMwali.’ Wose uchabaawha akale alayijwa naTate, unoozha kwandili. <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />Apana wanu abona Tate, kuzhe koyo unova kuna Mwali, iye ega ndiye wakabona Tate. <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />Ndinolebesa nditi kwamuli, iye unodimbwa una bupenyu businopela. <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />Ndimi chinkwa chobupenyu. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />MaTate enu akalya imana mugwegulu, akale bakafa. <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />Yechi ndicho chinkwa chinobhuluka chiva kudenga, kuti unhu angalya akale esife. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />Ndichinkwa chopenyu chakava kudenga, kana unhu angochilya chinkwa yechi, unoolalama kwemisi isinopela, akale chinkwa chandichapila kubupenyu bwenyika, umbili wangu.”<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />BaJuda bakakakabajana pakati babo beti, “Yoyu unhu, angatipa chini umbili uwe kuti tilye?”<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />Nokudalo Jesu wakati kwabali, “Ndolebesa nditi kwamuli, kuzhe kokuti mulye umbili woMwananhulumyana woNhu akale munwe ilopa lilye, amuna bupenyu mwamuli, <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />iye unolya umbili wangu akale enwa ilopa lyangu una bupenyu businopela, akale ndoomusa nezhuba lyokupejeleja <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />nokuti umbili wangu kulya kwechokomende, akale ilopa lyangu chinwiwa chechokomende. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />Iye unolya umbili wangu akale enwa ilopa lyangu, unogala mwandili akale namibo ndogala mwaali. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />Sezwo Tate bapenyu bakandituma, akale nokuti ndolalama nokuda kwaTate, neezwo yoyo unondilya, unoolalama nokuda kwangu. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />Yechi ndicho chinkwa chakabhuluka chiva kudenga, chisili sechakalyiwa namatate enu akafa, yoyo unolya chinkwa yechi unoolalama kwemisi isinopela.”<verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />Yezwi wakazwileba paakabelayija elimusinagogi, muKapenaumi.<verse eid="JHN 6:59" /></para>
  <para style="s">Mawhi Obupenyu Businopela</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />Banji babalayijwa babe, pabakazwiwha yezwi bakati, “Yeyi indebo indemu, ndiani angaitambula?”<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />Koga Jesu, ezwiziba emene kuti balayijwa babe bakumungunguna nazwo, wakati kwabali, “Zwinomunenguja na yezwi? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />Mukangobona Mwananhulumyana wonhu etanha ebwilila kudenga kwaakabeli pakutanga ke? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />UMpepo ndiye unopa bupenyu, umbili aunanshingo, mawhi yaya andalebeleka kwamuli uMpepo nobupenyu. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />Koga pana bamwe benu basinodimbwa.” Nokuti Jesu wakabeziba kuvila pakutanga kuti ndibani basilodimbwa, akale nokuti ndiani walooncheta. <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />Akale wakati, “Ndizwo ndakamubuja kuti apana unozha kwandili kuzhe kokuti azwipiwa naTate.”<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />Mushule mwezwi, bunji bwabalayijwa babe bakabwilila shule akale abajakaba bechinokwenda naye. <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />Jesu wakati kuna baligumi nababili, “Namwibo mumuda kunda na?”<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />Simoni Pita wakonshandula eti, “Tezi tingenda kunaani? Iwi ndiwi una mawhi obupenyu businopela. <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />Akale isu tadimbwa, tikaswika pakuziba kuti ndiwi uNchena waMwali.”<verse eid="JHN 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70" />Jesu wakabashandula eti, “Andijakamushala na imwi, baligumi nababili? Akale umwe wenu ndiguluzhanje.” <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />Wakabeleba Judasi mwananhulumyana waSimoni Isikaliyoti, nokuti iye, umwe wabaligumi nababili ndiye walooncheta.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">Jesu Nabanuna Babe</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />Shule mwezwi, Jesu wakabekwendenda muGalili, ajakatubula kunda kuJudiya nokuti baJuda bakaba beda kuumbulaya. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />Ngweno miliya yezwitumba yabaJuda yakababa pelyo. <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />Nokudalo banuna babe bakati kwaali, “Bhuda yopa inda kuJudiya kutila kuti balayijwa babo bebone mishingo iyo yaukumuta. <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />Nokuti akuna unhu unoshinga ekabwata, kana eda kuzibwa nabamwe. Kana ukata yezwi zwinhu, zwitondejele kunyika.” <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />Banuna babe abajakabedimbwa mwaali.<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />Jesu wakati kwabali, “Unshaji wangu aujanu waswika asi kunamwi unshaji wose ulokwelela. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />Banhu bomunyika abangamubenge koga imi banondibenga, nokuti ndinobabuja kuti banota zwinhu zwibi. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />Indani kumiliya imwi, imi andijikumunda kumiliya yeyi, nokuti unshaji wangu ulokwelela aujanu waswika.” <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />Aleba alo, wakasala muGalili.<verse eid="JHN 7:9" /></para>
  <para style="s">Jesu Kumiliya Yezwitumba</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />Koga mushule mokunda kwabanuna babe kumiliya, naiye wakenda kwakale esinoboneka pachena, ekazwisisa. <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />Batungamili babaJuda bakabe boonshaka kumiliya beti, “Uko kupi?”<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />Kwakaba nokungunguna pezhulu pape pakati pabanhu, bamwe beti, “Yoyu unhu umbuya,” akale bamwe beti, “Pe, ukumulasha banhu.” <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />Nokutya batungamili babaJuda, apana wakalebeleka nezwizwe pachena.<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />Kwaba pakati kwemiliya Jesu wakenda mulubazhe lwetempeli akatangisa kulayija. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />BaJuda bakachenama beti, “Seni unhu yoyu unoziba zwinji, iye esakalayijwa?”<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />Iye Jesu wakabashandula eti, “Kulayija kwangu akutoba kwangu asi ndikoyo wakandituma. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />Kana unhu eda kuta kuda kwaMwali, uchaziba kuti indayijo yangu ikumuva kunaMwali kana kuti ndimuzwilebelekela nezwangu nesimba lyamgu. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />Yoyo unozwi lebelekala nesimba lilye nezwizwe, unoshaka lukujo lulwe ega, koga iye unoshaka lukujo lwoyo wakontuma unechokomende, akale munaiye amuna maniepwa. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />Mozesi aajakamupa Mulawo na? Koga akuna kana umwe wenu unolondota mulawo yoyo. Ini mushaka kundibulaya imi?”<verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />Banhu bakashandula beti, “Unanedimoni! ndiani ukumuda kukubulaya?”<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />Jesu wakabashandula eti, “Ndakata chishamiso, chimwempela mose mwakachenamiswa nacho. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />Mozesi wakamulaya kuti mumhalaje banhabanhulumyana benu (asi azwitova kuti kwakava kunaMozesi, koga kwakava kumatate enu) asi munomhalaja unhu nesabata. <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />Kana unhu emhalajwa nesabata, kuti mulawo waMozesi usivunwe, mwandinyemela chini? kuti ndachilisa unhu nesabata. <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />Musishungule mulinga unhu, koga shungulani nenzila ilolulama.”<verse eid="JHN 7:24" /></para>
  <para style="s">Jesu Ndiye Mesaya Na?</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />Bamwe banhu bomuJelusalema bakabebhuza beti, “Aatoba iye na yoyu unhulume wabakumushaka kubulaya? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />Akale yopa ukumulebeleka pachena, koga apana zwibamuleba kwaali, zwingaba na, kuti batungamili banoziba kasa kuti ndiye Kristo. <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />Koga tinoziba kuti yoyu unhu unova kupi, asi Kristo akaswika akuna unhu unooziba kuti unova kupi.”<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />Asi Jesu wakashomeja, elayija, mulubazhe lwetempeli eti, “Munondiziba, akale munoziba nokwandinova, andijakezha nokuda kwangu, iye wakandituma ndiwe chokomende. Akale iye amutounziba, <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />asi imi ndinounziba, nokuti ndinova kwaali, akale wakandituma.”<verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />Bakada kuunsunga asi akuna wakoumbhata nokuti unshaji uwe wakaba usanu waswika. <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />Asi banhu banji bakadimbwa munaiye, bakati, “Kristo angoswika, uchata zwitondejo zwinji na, kupinda zwatiwa nonhu yoyu?”<verse eid="JHN 7:31" /></para>
  <para style="s">Balindi Banotumwa Kunosunga Jesu</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />BaFalisi bakawha ibunga linyeula nezwaJesu. Bakulwana babatebuji nabaFalisi bakatumila balindi betempeli kuti benounsunga. <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />Jesu kova eti, “Ndinoba namwi kwonshaji umfupi, ndisikonda kunoyo wakandituma, <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />munoondipyanga asi amutoondiwana, kwandinobeli amutotubula kuswika.”<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />Batungamili babaJuda bakabhuzana beti, “Biya unhu yoyu ukumuyeya kunda kupi, yoko kwaanoti atito tubula kuungwana? Umuda kunda kumakuta abaGiliki bakamwaikila, kuti enolayija baGiliki na? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />Ukumulebani kana eti, ‘Munoondishaka koga amutoondiwana akale kwandinobeli amutoswika’? ”<verse eid="JHN 7:36" /></para>
  <para style="s">Tulonga Twevula Inopa Bupenyu</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />Nezhuba lyopejeleja lyemiliya, lyakaba lili izhuba igulwana kasakasa, Jesu wakamilika akalebelekela pezhulu, eti, “Kana peli nomwe unenyota, ngeezhe kwandili oonwa. <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />Iye unodimbwa kwandili sokuleba kwewhalo iti, ‘Kuva mumwoyo mumwe kunookunga injizi jevula yobupenyu.’ ” <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />Ngweno yezwi wakazwileba pezhulu poMpepo, yabo banodimbwa kwaali bachootambula, nokuti uMpepo wakaba esanhu apiwa, nokuti Jesu aajakabanhu akujwa.<verse eid="JHN 7:39" /></para>
  <para style="s">Kupambukana Pakati Pabanhu</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />Pabakati bawha mawhi yaya, bamwe banhu bakati, “Ilebeswa, yoyu unhu ndiye umpolofeti ulolingililwa.”<verse eid="JHN 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41" />Bamwe bakati, “Yoyu ndiKristo.”</para>
  <para style="p" vid="JHN 7:41">Koga bamwe bakati, “Zwingaba alo na kuti Kristo angava kuGalili? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />Ani iyo iwhalo ayijakaleba na kuti Kristo unoova kuchinde lyaDavidi akale kunsha weBhetelehema, kunova naDavidi?” <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />Nokudalo kwakaba nokusovumilana pakati pabanhu pezhulu pape. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />Bamwe babo bakabeda kuunsunga koga akuna wakoombhata.<verse eid="JHN 7:44" /></para>
  <para style="s">Batungamili BabaJuda Bakalamba Kudimbwa Kwaali</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />Balindi betempeli bakabwilila kubakulwana babatebuji nabaFalisi, ibo bakati kwabali, “Ini musoombuza?”<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />Balindi betempeli bakashandula beti, “Akuna unhu wanu akalebeleka soyu unhu.”<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />BaFalisi bakabashandula beti, “Ani namwibo mwachengelwa na? <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />Kungaba umwe untungamili kana unFalisi wadimbwa munaiye na? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />Koga ibunga yeli lisinoziba mulawo, lilofhizhwa.”<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />Nikodimasi wakabenda kuna iye kale, akale eli umwe wabo, wakati kwabali, <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />“Ani mulawo wedu unopa untongo panhu, asanu apiwa chibaka kuti ewhiwe kuti watani.”<verse eid="JHN 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52" />Bakashandula beti, “Nawi unova kuGalili na? Shaka mumakwalo, unowana kuti akuna umpolofeti unobhuda muGalili.” <verse eid="JHN 7:52" /><verse number="53" style="v" sid="JHN 7:53" />Bakenda, umwe nomwe kungumba iye<note caller="+" style="f"><char style="fr" closed="false">7:53 </char><char style="ft" closed="false">Jimwe iwhalo jantolo jechiGiliki ajina iwhalo yeyi</char></note>.<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s">Unhukaji Wakabhatwa Epombola</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />Jesu wakenda kudunhu lyeOlivi. <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />Zhingwanangwana wakenda kutempeli, banhu bose bakezha kwaali, akagala pasi akabalayija. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />Bakwali bomulawo nabaFalisi bakabuza unhukaji, wakaba abhatwa epombola, akale bakombiga pakati pabo. <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />Bakati kwaali, “Ndayiji, yoyu unhukaji wabhatwa epombola. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />Ngweno mumulawo waMozesi waakatilayija isu kuti tipubule unhukaji wakadai, iwi unotini naye?” <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />Yezwi bakazwileba bounkweja, kuti bewane zwokuuntamijila nazwo, asi Jesu wakashuzhumala akakwala pasi nakanyala kake. <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />Bakendila mbeli beumbhuza, wakanyamuka akati kwabali, “Yoyo usina zwibi pakati penhu ngetange kuumpubula nebwe.” <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />Wakashuzhumala kabili akakwala nakanyala kake pasi. <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />Koga pabakazwiwa bakamilika benda umwe nomwe, kutanga bakulwana, asi Jesu wakasala ega, nonhukaji akama mbeli kukwe. <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />Jesu wakakotomoka akombhuza eti, “Nhukaji bayikokupi? Akuna wakupa undandu na?”<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />Wakashandula eti, “Akuna, Tezi.”</para>
  <para style="p" vid="JHN 8:11">Akale, Jesu wakati, “Nami anditokupa undandu, inda koga usichinye kabili.”<verse eid="JHN 8:11" /></para>
  <para style="s">Jesu Mwenje Wenyika</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />Jesu wakalebeleka kabili kwabali eti, “Ndili mwenje wenyika, iye unonditobela, aatokwenda munhilima koga unoba nomweje wobupenyu.”<verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />BaFalisi bakati kwaali, “Ukumuzwipa busumikiji, busumikiji bubo abutoba ilebeswa.”<verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />Jesu wakashandula eti, “Kojoba ndili nobusumikiji, busumikiji bwangu ndibwechokomende nokuti ndinoziba kwandakava kana kwandikumunda koga imwi amutoziba kwandikumunda kana kwandikumuva. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />Munotonga nenzila yabanhu, imi anditonga unhu. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />Kojoba ndikatonga, kutonga kwangu ndikwe chokomende, nokuti andili ndoga, Tate bakandituma bananami. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />Mumulawo wenu kulokwalwa kuwhi, busumikiji bwabanhu babili ngobwechokomende. <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />Ndinozwisumikijila akale naTate bakandituma naibo banondisumikijila.”<verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />Bakati kwaali, nezwo, “Baiko kupi Tate babo.”</para>
  <para style="p" vid="JHN 8:19">Jesu wakashandula akati, “Amutondiziba kana naTate bangu. Ngana mundiziba mwalubaziba naTate bangu.”<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />Yaya mawhi wakaaleba, eli panolondotwa mipilo, paakabelayija mutempeli koga akuna wakoonsunga nokuti unshaji uwe aujakabanu waswika.<verse eid="JHN 8:20" /></para>
  <para style="s">Amungende Kwandikumunda</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />Jesu wakati kwabali akale, “Ndikumunda, munondishaka, akale munofila muluchinyo zwenu. Kwandinonda imi amungakuswike.” <verse eid="JHN 8:21" /><verse number="22" style="v" sid="JHN 8:22" />Batungamili babaJuda bakati, “Chisoko kuda kuzwibulaya na? Sezwo eti, Kwandinonda amungakuswike?” <verse eid="JHN 8:22" /><verse number="23" style="v" sid="JHN 8:23" />Wakati kwabali, “Imwi muli bopenyika yeino, asi imi anditoba wopenyika yeino. Imi ndinova kudenga. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />Ndizwo ndamubuja kuti munofila muzwibi zwenu. Kuzhe kokuti mudimbwe kuti ndili iye, chokomende muchafila muluchinyo lwenu.”<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />Bakombhuza beti, “Ndiwi aani?”</para>
  <para style="p" vid="JHN 8:25">Jesu wakabashandula eti, “Ndili iye wandabemubuja kuti ndili iye kuva pakutanga. <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />Ndina zwinji zwokuleba zwokumutonga nazwo, koga iye wakandituma, ndiye chokomende, akale ndinobuja banhu bopenyika zwandakawha kwaali.”<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />Abajakawhisisa kuti wakalebeleka nabo, nezwa Tate. <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />Nokudalo Jesu wakati, “Mungonyamulila pezhulu Mwananhulumyana woNhu, ndipo pamuchooziba kuti ndili iye akale akuna zwandinota nesimba lyangu chete asi ndinolebeleka somundakalayijwa naTate. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />Akale iye wakandituma una nami ajandisiya ndoga, nokuda kokuti ndinota zwinounshantisa Iye.”<verse eid="JHN 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30" />Elebeleka banji, ndipo pabadimbwa kwaali.<verse eid="JHN 8:30" /></para>
  <para style="s">Ilebeswa Linomusupula</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />Jesu kova eti kuba Juda bakaba badimbwa kwaali, “Mungondila mbeli mulinundayijo yangu, mulibalayijwa bangu bechokomende. <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />akale munooziba ilebeswa, akale ilebeswa linomusungunula.”<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />Bakonshandula beti, “Tili bwoluji lwaAbhulahamu, akale atijanu tababalanda kana kunani, ini biya uti unosungunulwa?”<verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />Jesu wakabashandula eti, “Ndinolebesa nditi kwamuli, wose unochinya, undanda woluchinyo. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />Undanda, aatogala mumhuli kusinopela, asi mwananhulumyana ndiye, unogala kusinopela. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />Nezwo kana Mwananhulumyana emusungunula, munosungunulwa kasa. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />Ndinoziba kuti muli bechizekululu chaAbhulahamu koga mumuda kundibulaya, nokuti mawhi angu aana bugalo mwamuli. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />Ndinolebeleka zwandakatondejwa naTate bangu akale mota zwamwakawha zwiva kuna tate benu.”<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />Bakonshandula beti, “Abhulahamu nditate bedu.”</para>
  <para style="p" vid="JHN 8:39">Jesu wakati kwabali, “Ngana muli bana baAbhulahamu mwalota zwakatiwa naAbhulahamu, <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />koga ngweno munoshaka kundibulaya, imi unhu wamubuja ichokomende lyandakawha kunaMwali, asi yezwi azwitoba izwo zwakatiwa naAbhulahamu. <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />Munota zwakatiwa natate benu.”</para>
  <para style="p" vid="JHN 8:41">Bakashandula beti kwaali, “Isu atijakazwalilwa mubupombwe, tina Tate bamwempela Mwali.”<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />Jesu wakati kwabali, “Ngana Mwali wakabeli Tate benu, mwalondida, nokuti ndakava kunaMwali, Ngweno ndipo yopano penyika. Andijakazwizhila nokuda kwangu koga wakandituma. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />Ini musinowhisisa zwandinoleba? Nokuti amutotubula kutambula indayijo yangu. <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />Muli batate benu guluzhanje, chido chenu kuta kuda kwatate benu. Wakabeli umbulayi kuvila pakutanga akale aanani nezwokuta nechokomende, nokuti amuna ichokomende mwaali. Kana enyepa, unolebeleka lulimi lulwe nokudalo unonyepa akale nditate bamaniepwa. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />Koga, nokuda kokuti ndinomubuja ichokomende, imi amutondidimbwa. <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />Ndiani wenu unowana luchinyo munami? Kana ndimubuja ilebeswa ini musinondidimbwa? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />Iye uli waMwali unowha iwhi lyaMwali, zwinotisa kuti musunwhe, ndizwokuti amutoba baMwali.”<verse eid="JHN 8:47" /></para>
  <para style="s">Jesu NaAbhulahamu</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />Batungamili babaJuda bakonshandula beti, “Amutoba imo na kana titi unSamaliya akale unedimoni?”<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />Jesu wakabashandula eti, “Andina idimoni,” koga ndinokuja Tate bangu asi, amutondilemekeja. <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />Nezwo anditoshaka lukujo lwangu, koga, umwempela unolushaka unoba ndiye untongi. <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />Ndinolebesa nditi kwamuli, “Wose unolondota mawhi angu, aatofa.”<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />Batungamili babaJuda bakati kwaali, “Ngweno taziba kuti unedimoni, Abhulahamu wakafa, pamwempela nabapolofeti akale unoleba, kuti, ‘Yoyo unolondota mawhi angu aatofa.’ <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />Unkulwana na kupinda tate bedu Abhulahamu? Wakafa, akale nabapolofeti bakafa, iwi unozwiti uli ani?”<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />Jesu wakabashandula eti, “Kana ndizwikuja imi, lukujo lwangu alutoba chinu, ndiTate bangu banondikuja ibo bamunoti ndiMwali wenu. <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />Asi amujanu moonziba, imi ndonziba, ndingoti anditonziba ndinoba ndiniepa samwi, ndinokwelela kuba uniepi samwi, asi ndinounziba nokudalo ndinowhilila indayijo yiye. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />Tate benu Abhulahamu bakashanta kuti walubona izhuba lyangu, wakalibona akale wakashanta.”<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />Batungamili babaJuda bakati kwaali, “Aujanu waswika makole okuzwalwa makumi mashanu, unoti wombona Abhulahamu?” <verse eid="JHN 8:57" /><verse number="58" style="v" sid="JHN 8:58" />Jesu wakati kwabali, “Ndolebesa nditi, ndakabayipo Abhulahamu esanu abayipo ndakabelipo.” <verse eid="JHN 8:58" /><verse number="59" style="v" sid="JHN 8:59" />Nokudalo bakanunga mabwe kuti bompubule, koga Jesu wakazwisisa akava abhuda mutempeli.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">Jesu Unolapa unhulume wakazwalwa elibhofu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />Jesu paakapinda munzila wakabona unhulume waluba ibhofu, kuvila pakuzwalwa kukwe. <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />Balayijwa babe bakombhuza kuti, “Ndayiji ndiani wakachinya, unhulume yoyu kana kuti bazwali babe, zwakatisa kuti ezwalwe elibhofu?”<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />Jesu wakashandula eti, “Akutoba kuti yoyu unhu wakachinya, kana kuti bazwali babe, asi kuti mishingo yaMwali itondejelwe mwaali. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />Tinokwelela kuta mishingo yayoyo wakandituma, kuchili masikati nokuti kungoba busiku akutoba noochatubula kushinga. <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />Cheninge ndili munyika, ndili mwenje wenyika.”<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />Aleba yezwi, wakafhila mate pasi, akakanya ivu namate akaguba idope pamesho ebhofu, <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />eti kwaali, “Inda unoshamba, mugandwa lyeSilomu” (zwinoleba kuti watumwa). Wakenda akanoshamba akabuya ebona. <verse eid="JHN 9:7" /><verse number="8" style="v" sid="JHN 9:8" />Babakijani, naabo bakombona pakutanga echili unkumbili bakabhuza beti, “Aatoba iye na, unhulume yoyu walugala ekumbila?” <verse eid="JHN 9:8" /><verse number="9" style="v" sid="JHN 9:9" />Bamwe bakati, “Ndiye,” bamwe bakati, “Aatoba iye, asi unanga saiye,” Iye wakalamba eti, “Ndimi iye.” <verse eid="JHN 9:9" /><verse number="10" style="v" sid="JHN 9:10" />Bakandila mbeli bombuza beti, “Biya mesho awo azhulika chini?”<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />Iye wakashandula akati, “Unhulume unowhi Jesu wakanya idope akandiguba kumesho kwangu akati kunami, Inda kuSilomu ushambe, nezwo ndenda ndikanoshamba ndikatanga kubona.”<verse eid="JHN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12" />Bakati kwaali, “Uko kupi iye?”</para>
  <para style="p" vid="JHN 9:12">Wakashandula eti, “Anditoziba.”<verse eid="JHN 9:12" /></para>
  <para style="s">BaFalisi Banopenyengula Ibhofu</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />Banhu bakabuza kubaFalisi unhulume wakabeli ibhofu. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />Ngweno lyaluba izhuba lyesabata yopo Jesu paakakanya idope eta kuti ibhofu libone. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />BaFalisi bakombhuza kabili, kuti wabona chini. Iye akabashandula eti, “Wabiga idope pamesho angu ndikashamba ngweno ndikumubona.”<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />Bamwe babaFalisi bakati, “Yoyu unhu aatova kunaMwali, nezwo aatolemekeja isabata.”</para>
  <para style="p" vid="JHN 9:16">Koga bamwe bakabebhuza beti, “Biya unhu unchinyi angata chini zwishamiso zwinanga sezwi?” Kwakaba nokukakabajana pakati pabo.<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />Nezwo bakati kabili kubhofu yelyo, “Unotini naye sezwo azhula mesho awo?”</para>
  <para style="p" vid="JHN 9:17">Wakati, “Umpolofeti.”<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />Batungamili babaJuda abajakadimbwa kuti waluba ibhofu akale watanga kubona, kuswikila bashoba bazwali bonhulume yoyo wakabona <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />bakababhuza beti, “Mwananhulumyana wenu na yoyu, wamunoti wakazwalwa elibhofu? Biya kwatachini kuti ebone?”<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />Bazwali babe bakati, “Tinoziba kuti yoyu mwananhulumyana wedu akale wakazwalwa elibhofu, <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />koga ngweno atitoziba kuti wabona chini kana kuti ndiyani wonzhula mesho. Umbhuzeni, wakubuka unotubula kuzwilebelekela ega.” <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />Bazwali babe bakaleba yezwi nokuti balutya batungamili babaJuda, nokuti batungamili babaJuda bakabavumilana kuti umwe waloti Jesu ndiye Kristo, walutatamilwa muSinagogi. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />Nezwo bazwali babe bakati, “Wakubuka umbhuzeni.”<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />Bakapamha bakonshoba kabili yoyu unhulume waluba ibhofu bakati kwaali, “Ipa lukujo kunaMwali, tinoziba kuti yoyu unhu unchinyi.”<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />Wakashandula akati, “Kuti unchinyi anditozwiziba, chinhu chimwempela chandinoziba ndichokuti ndabeli ibhofu asi ngweno ndimubona.”<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />Bakombhuza beti, “Watani kwauli? Waazhula chishoboni mesho awo?”<verse eid="JHN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27" />Wakabashandula akati, “Ndamubuja ntolo seni, asi amujawhilila, ini muda kuwha kabili? Mumuda kuba balayijwa babe namwibo na?”<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />Bakontuka beti, “Iwi uli undayijwa uwe, asi isu tili balayijwa baMozesi. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />Tinoziba kuti Mwali walebeleka kunaMozesi, koga yoyu unhulume atitounziba kuti unova kupi.”<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />Unhulume wakashandula akati, “Biya ini, yechi chishamiso! Amutoziba kwaakava koga wazhula mesho angu. <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />Tinoziba kuti Mwali aatowhilila bachinyi koga kana ani azwe eli unamati waMwali akale eta kuda kukwe, Mwali unounwha. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />Kuvila inyika payakabumbwa, atijanu tawha, kuti kuna wakata kuti unhu wakazwalwa eli bhofu ebone. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />Ngana yoyu unhu esakava kunaMwali, apana zwaalotubula kuta.”<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />Bakonshandula beti, “Wakazwalwa muluchinyo nezwo ungatilayijani isu?” Bakava bakontatila musinagogi.<verse eid="JHN 9:34" /></para>
  <para style="s">Bupofu BwoMpepo</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />Jesu wakawha kuti bontatamilila pazhe, wakati ongwana, wakati kwaali, “Unodimbwa kuMwananhulumyana woNhu na?”<verse eid="JHN 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36" />Wakashandula eti, “Ndibuje kuti ndiani shungwasha, kutila kuti ndidimbwe mwaali?”<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />Jesu wakati kwaali, “Waumbona, akale ndiye ukumulebeleka nawi.”<verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />Akati, “Tezi, ndinodimbwa,” akonamata.<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />Jesu wakati, “Ndakezhila kutonga inyika yeyi kuti basinobona bebone, akale yabo banobona bebe mapofu.”<verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />Bamwe baFalisi bakabeli pelyo naye bakawha yezwi, bakati kwaali, “Nasu tili mapofu na?”<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />Jesu wakati kwabali, “Ngana mwakabeli mapofu, amujaloba nondandu, koga munolamba mulinondandu nokuti munoti munobona.”<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">Unkwejaniso Wondyisi Umbuya</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />“Ndinolebesa ndinoti kwamuli, Iye usinongwina nopankoba wedanga lyemhwizi koga etanha nelimwe ibhazu, yoyu unhu imbava akale umpambi, <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />asi iye unongwina nopankoba ndiye undyisi wemhwizi. <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />Undindi unounzhulila ishubo, imhwizi jinowha iwhi lilye, akale unoshoba imhwizi jije namazina ajo, ejitungamilila pakubhuda. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />Kana ajibhisa jose, unokwenda mbeli kwajo, kova imhwizi jiuntobela nokuti jinoliziba iwhi lilye. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />Ajitotobela umvakule, koga jinountizha nokuti ajitoliziba iwhi lyomvakule.”<verse eid="JHN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6" />Jesu wakaleba unkwejaniso yoyu kwabali, asi abajakawhisisa, zwaakaba, eleba kwabali.<verse eid="JHN 10:6" /></para>
  <para style="s">Jesu Ndiye Undyisi Umbuyanana</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />Jesu wakapamha akati kwabali, Ndinolebesa ndinoti kwamuli, ndimi unkoba wemhwizi. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />Imhwizi ajijakabawhilila bose bakanditangila kuzha, nokuti imbava nabapambi. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />Ndimi unkoba, aani nani unongwina nomunami, unoochijwa akale unongwina ebhude, ewane machelelo. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />Imbava inozhila kukwiba, nokubulaya nokupalaja chete, koga ndakezha kuti bewane bupenyu, akale buzhele.<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />Ndimi uNdyisi umbuyanana, uNdyisi umbuyanana unopila bupenyu bubwe kumhwizi. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />Unshingi unchenekwa, usili undyisi kana mweni wemhwizi, paanobona ibhele lizha, unotizha ejisiya imhwizi, ibhele linobwezha jimwe, kova lijitataula. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />Unotizha nokuti unchenekwa, akale aanani nemhwizi. <verse eid="JHN 10:13" /><verse number="14" style="v" sid="JHN 10:14" />Ndimi uNdyisi umbuyanana, ndinojiziba imhwizi jangu, akale naijo jangu jinondiziba, <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />sezwo Tate bendiziba nami ndinobaziba Tate, ndinopila bupenyu bwangu kumhwizi. <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />Akale ndina jimwe imhwizi jisili jelino idanga, naijo ndinokwelela kujibuza akale jinoowha iwhi lyangu. Nezwo jinooba idanga limwempela noNdyisi umwempela.<verse eid="JHN 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17" />Pezhulu pechisoko yechi, Tate banondida nokuti ndinopila bupenyu bwangu kutila kuti ndibutole kabili. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />Apana anganditolela ibwo, koga ndobupila nokuda kwangu. Ndinesimba lyokubupila, akale ndinesimba lyokubutola kabili, yoku kulayila ndakakutambula kuva kunaTate bangu.<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />Kwakaba nokukakabajana kabili, pakati pabaJuda pezhulu pamawhi yaya. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />Banji babo bakati, “Unanedimoni akale unopenga, ini munwhilila?”<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />Bamwe bakati, “Yeji ajitoba indebo jonhu unane dimoni. Idimoni lingata mesho ebhofu kuti ebone na?”<verse eid="JHN 10:21" /></para>
  <para style="s">Jesu unolambwa</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />Kwakabeli nemiliya yokupila itempeli kuJelusalema nonshaji wemhepo, <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />akale Jesu wakabekwenda mulubazhe lwetempeli lyaSolomoni. <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />Nezwo batungamili babaJuda bakonkomboloja bakati kwaali, “Uchaswika lini utisiya tikakahajika? Kana uli Kristo tibuje pachena.”<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />Jesu wakabashandula eti, “Ndamubuja asi amutodimbwa. Mishingo yandinota muzina lyaTate bangu, ndiyo inondisumikijila. <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />Asi amutodimbwa nokuti amutoba imhwizi jangu. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />Imhwizi jangu jinoliwha iwhi lyangu, akale ndinojiziba nayijo jinonditobela. <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />Ndinojipa bupenyu businopela, ajitoopalala, akale akuna angajivupula mumaboko angu. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />Tate bangu bakandipa ijo, bakulwana kupinda bose akale akuna unotubula kujivupula muluboko lwaTate. <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />Imi naTate tibamwempela.”<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />BaJuda bakatola mabwe kabili kuti bompubule, <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />koga Jesu wakabashandula akati, “Ndakamutondeja mishingo yangu mibuya yakava kunaTate, biya munondipubulila upi?”<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />BaJuda bakonshandula bakati, “Atitokupubulila mishingo mibuya koga kuti watuka Mwali nokuti iwi uli unhu unozwita Mwali!”<verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />Jesu wakabashandula akati, “Azwijilokwalwa na mumulawo wenu kuti, Ndati muli bamwali.” <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />Kana akabashoba kuti bamwali kunabo kwakaswika iwhi lyaMwali, asi lukwalo luchena alungatalukwe, <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />imwi munoti iye wakashalujwa naTate akatumwa munyika, “Unotuka Mwali nokuti ndati, ‘NdiMwananhulumyana waMwali?’ <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />Kana ndisinota mishingo yaTate bangu, nezwo musindidimbwe, <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />koga kana ndiita, kojoba musinondidimbwa imi, asi dimbwani mumishingo, kutila kuti muzibe akale muwhisise kuti Tate bayimo mwandili nami ndimo munaTate ”<verse eid="JHN 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39" />Bakakweja akale kuunsunga koga wakapujumuka mumaboko abo.<verse eid="JHN 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />Wakabhuda akenda, museli mwolwizi Jolodani, kubugalo bwaakatangila Joni kubhabhatizila, akasala elikwakale. <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />Banhu banji bakezha kwaali bakati, “Joni aajakata zwishamiso,” koga zwose zwinhu zwaakaleba pezhulu poyu unhu ilebeswa. <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />Banji bakadimbwa mwaali kubugalo yobo.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">Kufa KwaLazalo</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />Ngweno umwe unhulume wakabelwala, wakaba ewhiLazalo wokuBhetani, iguta mwakabegala Mariya naMatha bakabeli unkulu nonuna. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />Yoyu Mariya ndiye wakaguba Tezi mafuta, akabukusha makumbo namasusu awe. Unkazwaji uwe Lazalo wakaba elwala. <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />Nezwo yaba unkulu nonuna, bakatumila iwhi kunaJesu beti, “Tezi, Lazalo waunoda ukumulwala.”<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />Asi Jesu paakazwiwha wakati, “Yaya malwaji aatoba olufu, asi ndiwolukujo lwaMwali, kuti Mwananhulumyana waMwali ekujwe nazwo.”<verse eid="JHN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5" />Jesu wakabeda Matha, Mariya nonkazwaji wabo Lazalo. <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />Nezwo paakawha nezwokulwala kwaLazalo, wakagala amwe mazhuba mabili mubugalo mwaakaba eli. <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />Mushule mwezwi wakati kubalayijwa babe, “Andeni kuJudiya kabili.”<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />Balayijwa babe bakati, “Ndayiji, baJuda bakabeda kukupubula namabwe munshaji ushomanana wapinda, asi ngweno ukumuda kunda kwakale kabili?”<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />Jesu wakabashandula eti, “Akuna maawa igumi namabili muzhuba na? Kana unhu angokwenda masikati aatogubhulwa nokuti unobona nomwenje wenyika yeino.” <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />Asi kana unhu akakwenda, busiku, unogubhulwa nokuti aana mwenje. <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />Wakati alebeleka, akapamija eti, “Unkwaina wedu Lazalo walala, koga ndichenda kunoomusa.”<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />Balayijwa babe bakati kwaali, “Tezi kana kuli kuti walala, uchachila.”<verse eid="JHN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13" />Ngweno Jesu wakaba alebeleka nezwolufu lwaLazalo, asi ibo bakayeya kuti kulala kokunyetutukwa. <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />Kova Jesu ebabuja pachena eti, “Lazalo wafa, <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />akale nokuda kwenu, ndinoshanta kuti andijabelipo, kutila kuti mudimbwe. Koga andeni kuna iye.”<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />Tomasi unoshobwa kuti imbile, wakati kunabamwe balayijwakwaina, “Andeni nasu kutila kuti, tife naye.”<verse eid="JHN 11:16" /></para>
  <para style="s">Jesu Ndiye Kumuka Nobupenyu</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />Ngweno Jesu paakaswika, wakawana kuti Lazalo wakaba aba mugumbu kale kwamazhuba mana. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />Bhetani yakabeli pelyo neJelusalema, unshizho ungaba makilomita matatu. <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />Banji babaJuda bakaba bezha konyalaja Matha naMariya pezhulu ponkazwaji wabo.<verse eid="JHN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20" />Yopo Matha paakawha kuti Jesu ukumuzha, wakenda akanootandamija asi Mariya wakagala mungumba. <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />Matha wakati kuna Jesu, “Tezi ngana wabelipo yopano unkazwaji wangu aajalofa. <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />Asi nangweno ndinoziba kuti chose chaunokumbila kuna Mwali, Mwali unokupa.”<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />Jesu wakati kwaali, “Unkazwaji uwo unomuka kubafi.”<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />Matha wakati kwaali, “Ndinoziba kuti unoomuka pakumuka kwabakafa nezhuba lyopejisila.”<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />Jesu wakati kwaali, “Ndili kumuka nobupenyu, iye unodimbwa kunami kojoba akafa, asi unoolalama, <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />akale iye unolalama nokudimbwa munami aatoofa. Unodimbwa yezwi na?”<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />Wakati kwaali, “Ndimo Tezi, ndinodimbwa kuti uli Kristo Mwananhulumyana waMwali, iye ukumuzha munyika.”<verse eid="JHN 11:27" /></para>
  <para style="s">Jesu Unolila</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />Paakaleba yezwi, wakenda akashoba unkazwaji uwe wechinhukaji Mariya kumbali akati, “Undayiji upo yopano, ukumukushoba.” <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />Mariya paakazwiwha yezwi, wakamilika nokukambija akenda kunaJesu. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />Ngweno Jesu aajakabanu angwina munsha koga wakabechi kubugalo kwaakabashangana naMatha. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />BaJuda bakabeli naye mungumba, beunyalaja pabakabona Mariya emilika nokukambija akale ebhuda pazhe, bakontobela beyeya kuti ukumunda kugumbu kunolilila kwakale.<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />Ndipo Mariya, paakaswika yopo pakabeli naJesu, paakombona wakafhigama pamakumbo awe eti kwaali, “Tezi ngana wabelipo yopa unkazwaji wangu aajalufa.”<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />Jesu paakombona elila nabaJuda bakabezha naye nayibo belila wakabhatikana kasa mumwoyo akalwajilwa, <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />akale kova ebhuza eti, “Moondajika kupi?”</para>
  <para style="p" vid="JHN 11:34">Bakati kwaali, “Tezi, izha ubone.”<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />Jesu wakalila. <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />Nezwo BaJuda bakati, “Ilingani kuti wakabeunda chini!”<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />Asi bamwe babo bakati, “Unhu yoyu wakata kuti mapofu ebone, ajalounta na unhu yoyu kuti esife?”<verse eid="JHN 11:37" /></para>
  <para style="s">Lazalo Unomuswa Kubafi</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />Jesu wakabhatwa neshungu akenda kugumbu lyakaba lili bhako akale ibwe lyakaba likalikonya. <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />Jesu wakati, “Ibhisani ibwe.”</para>
  <para style="p" vid="JHN 11:39">Asi Matha, unkazwaji womfi Lazalo, wakati kwaali, “Tezi nouno unshaji kunoba kwaba nokunhuwa, nokuti waaba namazhuba mana afa.”<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />Jesu wakati kwaali, “Andijakubuja na kuti kana udimbwa unobona lukujo lwaMwali?” <verse eid="JHN 11:40" /><verse number="41" style="v" sid="JHN 11:41" />Nokudalo bakabhisa ibwe. Akale Jesu wakalinga kudenga akati, “Tate, ndinoboka nokuti mwandiwha imi. <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />Ndinoziba kuti munondiwha unshaji wose, asi ndaleba yezwi pezhulu pabanhu bamile yopa, kutila kuti bedimbwe kuti mwakandituma.” <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />Paakaleba yezwi wakashomeja newhi igulwana eti, “Lazalo, bhuda.” <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />Unhulume wakababafa wakabhuda, maboko awe namakumbo awe akapombelwa nemicheka, akale chiso chiche chikasungwa noncheka. Jesu wakati kwabali, “Unsupuleni, akale mundeke ende.”<verse eid="JHN 11:44" /></para>
  <para style="s">Chilangano Chokubulaya Jesu</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mateo 26:1-5</ref>; <ref loc="MRK 14:1">Mako 14:1</ref>,<ref loc="MRK 14:2">2</ref>; <ref loc="LUK 22:1">Luka 22:1</ref>,<ref loc="LUK 22:2">2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />Banji babaJuda bakabezha kolila naMariya bakababona zwaakaba ata, bakadimbwa munaJesu, <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />koga bamwe bakenda kubaFalisi bakababuja zwakaba zwatiwa naJesu. <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />Nokudalo batebuji bakulwana nabaFalisi bakagala igota bakati, “Ini zwatingate? Nokuti yoyu unhulume ukumuta zwishamiso zwinji.” <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />Kana tingoondeka endila mbeli, banhu bose banodimbwa mwaali, akale baRoma banozha koopalaja itempeli lyedu akale nenyika yedu.<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />Koga umwe wabo wakabewhi Keyifasi wakabeli untebuji unkulwana igole yelyo, wakati kwabali, “Apana chinhu chamunoziba, <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />Amutowhisisa kuti, zwili ndibwalo kunamwi kuti unhu umwempela efile banhu, kuna kuti inyika yose ipalajwe.” <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />Ajakaleba yezwi nokuda kukwe, asi nokuti wakaba eli untebuji unkulwana igole yelyo, wakafolofita kuti Jesu unokwelela kufila baJuda, <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />kusi kwabaJuda chete, asi kubunganisa nabana baMwali balopalalana kunyika jose.<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />Nezwo kuva nelyo izhuba, bakalangana kuti bombulaye. <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />Nezwo Jesu ajakabechinokwenda pachena pakati pabaJuda, koga wakenda kumizi ipo pelyo negwegulu, kuguta lyaluwhi Ifulemu, kwakale wakagala nabalayijwa babe.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />Ngweno miliya yePasika yabaJuda, yakababapelyo, banhu banji bakava kumizi bakenda kuJelusalema iPasika isanu yaswika kuti beno zwichenesa. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />Bakabepyanga Jesu, belebelekesana belimile mulubazhe lwetempeli beti, “Mubweni soti ukumuzha na kumiliya?” <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />Ngweno bakulwana babatebuji nabaFalisi bakaba balaya kuti uchaba aziba kuti Jesu ukokupi, ebazibise, kutila kuti bounsunge.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">Jesu Unogubwa KuBhetani</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mateo 26:1-5</ref>; <ref loc="MRK 14:3-9">Mako 14:3-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />Kwasala mazhuba mashanu nelimwempela kuti iPasika liswike, Jesu wakenda kuBhetani, yoko kwaluba kuli naLazalo, wakamuswa naJesu kubafi. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />Bakombhikila chilayilo, Mata akompakulila naLazalo umwe waabo bakaba belya naJesu. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />Mariya wakatola iganta lyelita yobunde bwenadi bwakabeshoba imali yopezhulu, akaguba makumbo aJesu, akabukusha makumbo aJesu eshingisa masusu awe, ingumba yose ikanhuwilila bunde. <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />Koga Judasi Isikaliyoti, umwe wabalayijwa babe (iye wakooncheta) wakati, <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />“Ani yobubunde busatengeswa nendipo yonshingo wegole, kova imali yeyo ipiwa basheti.” <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />Yezwi wakazwileba, kusi kuti wakaba eli nechido nabasheti koga nokuti wakabeli imbava, akale sezwo wakabelondota chikwama chemali, walugala etola zwalubigwa mukati.<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />Jesu wakati, “Undekeni, ebulondote bunde kuswika izhuba lyokujikwa kwangu, <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />Basheti munogala muli nabo unshaji wose, asi imi amutogala muli nami.”<verse eid="JHN 12:8" /></para>
  <para style="s">Chilangano Chokubulaya Lazalo</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />Ibunga lyabaJuda palyakawha kuti umo muBhetani, alijakezhila Jesu chete, asi kobona Lazalo waaluba amusa kubafi. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />Nezwo bakulwana babatebuji bakayeya kuti bebulaye Lazalo neebo, <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />nokuti, pezhulu paLazalo, banji bakasiya baJuda bedimbwa munaJesu.<verse eid="JHN 12:11" /></para>
  <para style="s">Jesu Unongwina MuJelusalemu Epembelelwa</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mateo 21:1-11</ref>; <ref loc="MRK 11:1-11">Mako 11:1-11</ref>; <ref loc="LUK 19:28-40">Luka 19:28-40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />Nezhuba linotobela, ibunga igulwana lyabanhu lyakabezha kumiliya, lyakawha kuti Jesu ukumuzha kuJelusalema. <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />Nokudalo bakatola inhabi jamalala bakenda kunountandamija beshomeja beti, “Hosana! Ulokombolelwa iye unozha muzina lyaTezi, Iye She weIzilayeli.”<verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />Jesu wakawana mwana wedonki, akatanha, sezwo zwilokwalwa kuwhi,<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />“Usitye, mwananhukajana weZiyoni,</para>
  <para style="q1" vid="JHN 12:15">ilinga, She uwo ukumuzha.</para>
  <para style="q2" vid="JHN 12:15">ekatanha mwana wedonki.”<verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />Balayijwa babe abajakazwiwhisisa yezwi pakutanga, asi Jesu paakangaimiswa bakayeya kuti yezwi ndizwo zwakakwalwa pezhulu pape akale zwakatiwa kwaali.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />Ibunga lyakaba lili naye, paakashomeja Lazalo kuti ebhude mugumbu akale eumusa mubakafa bakendila mbeli besumikija. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />Ndizo zwakatisa kuti ibunga linde kunountandamija, nokuti bakaba bawha kuti wakaba ata chichemiso yecho. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />BaFalisi bakati kunoumwe noumwe, “Mwazwibona kuti apana zwamungate, ilingani inyika yatobela iye.”<verse eid="JHN 12:19" /></para>
  <para style="s">Bamwe BaGiliki Banoshaka Jesu.</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />Ngweno pakati paabo bakabenda kunonamata kumiliya kwaluba nabaGiliki. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />Nokudalo bakenda kuna Filipu, wokuBhetisaida muGalili bakati kwaali, “Shungwasha, tinoda kubona Jesu.”<verse eid="JHN 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22" />Filipu wakenda akanobuja Endulu, mububili bwabo bakenda kunobuja Jesu. <verse eid="JHN 12:22" /><verse number="23" style="v" sid="JHN 12:23" />Jesu wakati kwabali, “Unshaji waswika wokuti Mwananhulumyana woNhu engaimiswe. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />Ndinolebesa ndinoti kwamuli, kuzhe kwokuti imbeyu yekoloni imbwelele muvu, itikofa, inogala yakadalo, asi ingofa inozwala ikoloni inji. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />Iye unoda bupenyu bubwe unolashikilwa nabo, asi iye unobenga bupenyu bubwe munyika yeyino unobulondota kusinopela. <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />Kana unhu endishingila, unokwelela kunditobela yokwo kwandili, nechishingi changu akale chinoba ipo, kana ani azwe endishingila, Tate banoondemekeja.<verse eid="JHN 12:26" /></para>
  <para style="s">Jesu Unolebeleka Nezwolufu Lulwe</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />“Ngweno umpepo wangu ulojiijwa. Ini zwandingalebe? Nditi Tate, ndichijeni panoyu unshaji? Mane, ndezhila yezwi—panshaji yoyu. Kutila kuti ndindile mbeli mukujiila koono unshaji. <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />Tate ngaimisani izina lyenu.”</para>
  <para style="p" vid="JHN 12:28">Pakalepo iwhi lyakaswika liva kudenga liti, “Ndalingaimisa akale ndinolingaimisa kabili.”<verse eid="JHN 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29" />Ibunga lyaluba lilimile lyakaliwha iwhi bamwe bakati, “Kwadilima,” asi bamwe bakati, “Ingilozi yabelebeleka naye.”<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />Jesu wakashandula akati, “Iwhi yeli lyezhila imwi, alijezhila imi.” <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />Ngweno ndiwo unshaji wokulangwa kwenyika, pakalepo unchinda wenyika yeyi unoolashilwa kuzhe. <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />Imi, pandichanyamulwa kuva penyika ndokakatila banhu bose kwandili. <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />Wakaleba yezwi kuti etondejele kuti unoofa lufu luli chini.<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />Ibunga lyakounshandula liti, “Tazwiwha kuva kumulawo kuti Kristo unobelipo kwemisi yose. Unoleba chini kuti Mwananhulumyana woNhu unokwelela kunyamulwa enda pezhulu? Ndiani yoyu Mwananhulumyana woNhu?”<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />Jesu wakati kwabali, “Mwenje uchina namwi kwonshaji umwe umfupi. Kwendani muchina nomwenje, kuti inhilima isimuwane, iye unokwenda munhilima aatoziba kwaamunda. <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />Muchina nomwenje, dimbwani mumwenje kuti mube bana bomwenje.”</para>
  <para style="s" vid="JHN 12:36">Kusodimbwa Kwabanhu</para>
  <para style="p" vid="JHN 12:36">Jesu paakaleba yezwi, wakabhuda akanobwata. <verse eid="JHN 12:36" /><verse number="37" style="v" sid="JHN 12:37" />Kojoba akata zwishamiso zwinji mbeli kwabo, koga ibo abajakadimbwa mwaali, <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />yezwi zwakaba alo kuti kuzhajikijwe mawhi akalebwa noMpolofeti Izaya okuti,</para>
  <para style="q1" vid="JHN 12:38">“Tezi, ndiyani wakadimbwa kupupula kwedu,</para>
  <para style="q1" vid="JHN 12:38">akale ndikunani Tezi kwaakatondejela isimba lilye?”<verse eid="JHN 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />Nezwo abajakadimbwa. Nokudalo Izaya wakati akale,<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />“Wakabata bakaba mapofu,</para>
  <para style="q2" vid="JHN 12:40">akale akata kuti myoyo yabo ibe mikukutu.</para>
  <para style="q1" vid="JHN 12:40">kutila kuti mesho abo esibone, nemyoyo yabo isiwhisise,</para>
  <para style="q2" vid="JHN 12:40">kuti bechingunukile kwandili ndibachilise.”<verse eid="JHN 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41" />Izaya wakaleba yezwi nokuti, wakabona kungaima kwaJesu akalebeleka nezwizwe.<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />Zwisinani banji babatungamili, bakadimbwa mwaali, koga pezhulu pokutya baFalisi abajakalebeleka nezwazwo pachena, betyila kuti bangabhiswa musinagogi, <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />nokuti bakabedisisa lukujo lwabanhu kasa kupinda, lukujo lwaMwali.<verse eid="JHN 12:43" /></para>
  <para style="s">Kutongwa Namawhi AJesu</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />Jesu wakashomeja eti, “Iye unodimbwa mwandili, aatodimbwa kwandili asi kunoyo wakandituma.” <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />Akale iye unobona imi, wabona yoyo wakandituma. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />Ndezha somwenje munyika, kuti yoyo unodimbwa munami esigale munhilima. <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />Kana unhu ewha indebo yangu asi esinoyilondota, anditontonga. Nokuti andijakezha kotonga inyika asi koyichija. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />Iye unondilamba akale esinotambula indebo yangu una unountonga, mawhi andinoleba anooba, untongi uwe nezhuba lyopejisila. <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />Nokudalo anditoleba yezwi zwiva musimba lyangu, asi ibo Tate bakandituma, ndibo bakandipa chilayo chokuti ndilebeni akale kuti ndilebeleke zwipi. <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />Ndinoziba kuti undayo yoyu bupenyu businopela. Nokudalo zwandinoleba, ndinozwileba sokulayilwa kwangu naTate.<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">Jesu Unoshambisa Balayijwa Babe Makumbo</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />Ngweno kusanhu kwaswika miliya yePasika, Jesu waluzibakale kuti unshaji wokuti enyamuke ebhuda munyika enda kunaTate babe waswika, Iye wakabada babe bakabeli munyika, wakabada kuswikila kumapejelejo.<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />Nonshaji wechilayilo, guluzhanje wakababiga kale mumwoyo waJudasi, mwananhulumyana waSimoni Isikaliyoti kuti onchete. <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />Jesu eziba kuti Tate bakabiga zwinhu zwose mumaboko awe, nokuti wakava kunaMwali akale wakabenda kunaMwali, <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />nokudalo wakamilika pechilayilo akabhisa zwimbalo zwizwe zwopezhulu akazwibiga kumbali, akasunga uncheka munshana uwe, <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />kova edila ivula munachoshambila, akatanga kushambisa balayijwa babe makumbo, akabachumula noncheka waakaba ekasungilila munshana. <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />Wakezha kunaSimoni Pita, akale Pita wakati kwaali “Tezi mondishambisa makumbo angu na?”<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />Jesu wakounshandula eti, “Zwandikumukuta amutozwiziba ngweno, asi mukunda kwonshaji munoozwiwhisisa.”<verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />Pita wakati, “Amutooshambisa makumbo angu kuswika lini.”</para>
  <para style="p" vid="JHN 13:8">Jesu wakounshandula eti, “Kana imi ndisakushambisa makumbo autoba umwe wangu.”<verse eid="JHN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9" />Simoni Pita wakati kunaiye, “Tezi kusibe makumbo angu oga asi namaboko nonsholo.” <verse eid="JHN 13:9" /><verse number="10" style="v" sid="JHN 13:10" />Jesu wakati kwaali, “Iye washamba ulokwelela kushamba makumbo chete nokuti umbili uwe wose uloshambijika. Imwi mose muloshambijika kuzhe kwomwempela wenu.” <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />Nokudalo Jesu wakabeziba kuti ndiani uchoncheta, ndizwo akati abatoba ibo bose baloshambijika.<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />Paakabashambisa makumbo, wakatola chimbalo chiche akambala, akagala pasi akababhuza eti, “Munoziba kuti ini zwandata kwamuli? <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />Mondishoba muti Ndayiji akale muti Tezi, zwibuya nokuti ndili alo. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />Kana imi Tezi akale ndili Ndayiji, ndashambisa makumbo enu, munokwelela kushambisana makumbo neebo. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />Nokuti ndamupa chibonelo, kuti imwibo munokwelela kuta sezwandata imi kwamuli. <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />Ndinolebesa ndinoti kwamuli, unshingi, aatoba unkulwana kupinda tezi uwe, naiye wakatumwa aatoba unkulwana kupinda yoyo wakoontuma. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />Kana muziba yezwi zwinhu, mulokombolelwa kana muzwita.<verse eid="JHN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />“Andijikumuleba imwi mose, ndinobaziba bandakashala. Asi iwhalo inokwelela kuzhajikijwa inoti, ‘Iye walya zwokulya nami wandishandukila.’ <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />Ndinomubuja yezwi ngweno, zwisanu zwatikana, kutila kuti pazwichootikana mudimbwe kuti ndili iye. <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />Ndinolebesa nditi kwamuli, iye unotambula aanizwe wandinotuma, unotambula imi, akale iye unotambula imi unotambula yoyo wandituma.”<verse eid="JHN 13:20" /></para>
  <para style="s">Jesu Unolebeleka Nezwokuchetwa Kukwe</para>
  <para style="r">(<ref loc="MAT 26:20-25">Mateo 26:20-25</ref>; <ref loc="LUK 22:21-23">Luka 22:21-23</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />Jesu paakaleba yezwi, wakahetela mumpepo akapupula eti, “Ndinolebesa nditi kwamuli umwempela wenu unoondicheta.”<verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />Balayijwa bakalingana umwe noumwe, besinoziba kuti ukumuleba aani. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />Umwe wabalayijwa, waakabeda Jesu wakaba eligele pelyo naJesu. <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />Simoni Pita nokudalo wakakobola luboko kunoyo undayijwa eti, “Tibuje kuti ukumuleba aani.”<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />Nokudalo undayijwa yoyo wakasendela pelyo naJesu akabhuza eti, “Tezi angaba aani?”<verse eid="JHN 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26" />Jesu wakashandula eti, “Ndiye yoyu wandichasebela chipemu chechinkwa mundyilo ndiumpa.” Wakati aseba wakachipa Judasi, mwananhulumyana waSimoni Isikaliyoti. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />Judasi akalya chipemu chechinkwa, Satani wakangwina mwaali. Jesu akati kwaali, “Kambija ute zwaunokwelela kuta.” <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />Ngweno apana unhu petebuli waluziba kuti wakalebelani yezwi kwaali. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />Nokuti Judasi ndiye wakabebhata chikwama chemali, bamwe bakayeya kuti Jesu wountuma kuti enotenga zwinodikana pemiliya yeyi, akale bamwe bakayeya kuti wombuja kuti epe basheti chimwe zwinhu.<verse eid="JHN 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 13:30" />Shule mokutambula chipemu, wakava abhuda, akale kwakabeli busiku.<verse eid="JHN 13:30" /></para>
  <para style="s">Undayo Umpya</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />Judasi paakenda pazhe Jesu wakati, “Ngweno Mwananhulumyana woNhu wakujwa akale iye Mwali wakujwa mwaali, <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />kana Mwali ekujwa munaiye, Mwali unokuja Mwananhulumyana munaiye Mwali ezwita nokukambija. <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" />Bana bangu, ndichaba namwi kwonshaji unshoma. Munoondipyanga, sezwandabaleba kubatungamili babaJuda ngweno ndozwileba kunamwi, ‘Kwandikumunda amutotubula kukuswika.’ <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />Ndomupa mulawo umpya wokuti mudanane. Sezwo ndakamuda, namwibo mudanane. <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />Kana muli noludo umwe kunoumwe, banhu bose banooziba kuti mubalayijwa bangu.”<verse eid="JHN 13:35" /></para>
  <para style="s">Jesu unoleba Kulambwa Kukwe NaPita</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mateo 26:31-35</ref>; <ref loc="MRK 14:27-31">Mako 14:27-31</ref>; <ref loc="LUK 22:31-34">Luka 22:31-34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />Simoni Pita wakoumbhuza eti, “Tezi ukumundapi?”</para>
  <para style="p" vid="JHN 13:36">Jesu wakashandula eti, “Kwandikumunda aungatubule kunditobela ngweno, koga unoonditobela mushule.”<verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />Pita wakati kwaali, “Tezi ini ndisinotubula kumutobela ngweno, ndilozwipila kumufila.”<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />Jesu wakashandula eti. “Ungatubula kundifila na? Ndinolebesa nditi kwauli igukulume lisanu lyakokoleka, unobandilamba katatu.”<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">Jesu Inzila Yokunda Kuna Tate.</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />“Myoyo yenu ngayileke kujiijika, dimbwani kunaMwali, mudimbwe nokwandili. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />Munsha waTate bangu munabugalo bunji bokugala, Ndikumunda kunomubambanyila bugalo. Ngana zwisakadalo ndalomubuja <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />Akale ndingonda kunomubambanyila pokugala, ndoobuya akale, kuti ndoomutola mube kwandili, kuti pandili mubeyipo namwibo. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />Akale moyiziba inzila kwandimunda.”<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />Tomasi wakati kwaali, “Tezi, atitokuziba kwaumunda, tingaiziba chini inzila?”<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />Jesu wakati kwaali, “Imi ndimi inzila, nechokomende, nobupenyu, apana unozha kuna Tate, asi nokwandili. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />Ngana mwakandiziba, mwalubaziba naTate bangu, kuvila ngweno mwabaziba akale mwababona.”<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />Filipu wakati kwaali, “Tezi, titondejeni Tate, tova tagunchikana.”<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />Jesu wakati kwaali, “Filipu, ndabeli namwi konshaji undefu kasa, koga autondiziba na? Yoyo wabona imi wabona Tate, ungati, ‘Titondeje Tate chini?’ <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />Autodimbwa na kuti ndimo munaTate akale naTate baimo munami? Mawhi andinolebeleka kunamwi anditowaleba nesimba lyangu, koga Tate banogala mwandili ndibo banota mishingo yabo. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />Idimbwani kuti ndimo munaTate, naTate bayimo mwandili, kana kuti, mundidimbwe nemishingo yandinota. <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />Ndinolebesa ndinoti kwamuli, yoyo unodimbwa mwandili, unoota mishingo yandinota, akale unoota nemishingo mikulwana kupinda yandinota, nokuti ndikumunda kunaTate. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />Chose chamuchakumbila muzina lyangu, ndoochita, kutila kuti Tate bekujwe muMwananhulumyana. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />Kana mungokumbila chinhu muzina lyangu, ndochita.<verse eid="JHN 14:14" /></para>
  <para style="s">Jesu Unobimbisa UMpepo uNchena</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />“Kana mundida munolondota milawo yangu. <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />Akale ndichanamata kunaTate, akale banomupa umwe uMbhanchi, uchaba namwi kwemisi yose, <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />Iye uMpepo wechokomende, usinotambulwa nenyika, nokuti ayumbweni kana kuunziba, imwi monounziba nokuti unogala namwi akale unoba mwamuli.<verse eid="JHN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18" />“Anditomusiya muli senhelela, ndoozha kwamuli. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />Munshaji unshomanana, inyika ayitoondibona, koga imwi moondibona, nokuti ndimpenyu, namwibo moobabapenyu. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />Nezhuba yelyo mooziba kuti ndimo munaTate bangu, akale imwi munami, akale nami munamwi. <verse eid="JHN 14:20" /><verse number="21" style="v" sid="JHN 14:21" />Iye una milawo yangu akale eyilondota ndiye unondida, akale iye unondida unoodiwa naTate bangu, akale Imi ndinoonda akale ndoozwitondejela pachena kwaali.” <verse eid="JHN 14:21" /><verse number="22" style="v" sid="JHN 14:22" />Judasi, usiliiye Isikaliyoti, wakati kunaiye, “Tezi umutilani kuti uzwitondejele kwatili, usinozwitondejela kunyika?”<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />Jesu wakonshandula eti, Unhu kana endida, uchawhilila indayijo yangu. Tate bangu banounda, akale isu tinoozha kwaali, tite unsha wedu mwaali. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />Yoyo usinondida aatowhilila indayijo yangu, akale nendayijo yamunowha ayitoba yangu koga ngiyaTate bakandituma.<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />“Yezwi zwinhu ndamubuja ndichilinamwi. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />Koga uMbhanchi, uMpepo uNchena, uchatumwa naTate muzina lyangu, iye unoomulayija zwinhu zwose, akale unoomukumbuluja zwose zwandakamubuja.”<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />Lunyalalo ndolusiya kwamuli, lunyalalo lwangu ndomupa, anditomupa sobwayinopa inyika. Myoyo yenu ngileke kujiijika, kana kutya. <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />Mwawha nditi kwamuli ‘Ndonda, akale ndoozha kwamuli.’ Ngana mwakabendida, mwalushantilwa, nokuti ndimunda kunaTate, nokuti Tate bakulwana kwandili. <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />Akale ndamubuja ngweno zwisanu zwatikana, kutila kuti nonsi wazwichatikana mudimbwe. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />Andichinolebeleka zwinji namwi, nokuti untongi wenyika yeno ukumuzha. Iye aana masimba pezhulu pangu, <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />koga ndota swokundilaya kwaTate, kutila kuti inyika izibe kuti ndobada Tate.</para>
  <para style="p" vid="JHN 14:31">“Milikani tinde.<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">Jesu Unzhambi Wechokomende.</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />“Ndimi unzhambi wechokomende, akale Tate bangu ndibo undimi wonzhambi. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />Jose inhabi jangu, jisino zwala michelo, unojitema, akale lutabi lose lunozwala luno tanabulwa, kuti luzwale kasa michelo. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />Imwi mwakacheneswa kale nendayijo jandakamulayija. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />Galani mwandili, nami mwamuli. Lutabi alutozwala michelo loga, kuzhe kokuti lugale panzhambi, nokudalo namwibo amungatubule kuzwala michelo kuzhe kokuti mugale mwandili.<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />“Ndimi unzhambi, imwi ndimwi inhabi. Iye unogala mwandili, nami mwaali, ndiye unozwala michelo minji, nokuti kuzhe kwangu amutotubula kuta chinhu. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />Kana unhu esinogala mwandili, unolashilwa kuzhe solutabi eswabe. Inhabi jinobunganywa, jisikoposela mumoto, jipiswe. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />Kana mugala mwandili, namawhi angu egala mwamuli, kumbilani zwamunoda munozwitilwa. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />Kana muzwala michelo minji motondejela kuti mubalayijwa bangu, Tate bangu banokujwa. <verse eid="JHN 15:8" /><verse number="9" style="v" sid="JHN 15:9" />Sezwo Tate bakandida, nami ndakamudabo, galani muludo lwangu. <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />Kana mulondota zwilayijo zwangu munoogala muludo lwangu, sezwo ndalondota zwilayijo zwaTate bangu akale ndigala muludo lwabo.<verse eid="JHN 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11" />“Ndakamubuja yezwi zwinhu, kuti kushanta kwangu kube mwamuli, akale kuti kushanta kwenu kupelele. <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />Yoku ndiko kulaya kwaangu, kuti mudanane sezwo ndakamuda imwi. <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />Apana unhu unaludo lukulwana kupinda unhu unofila bakwaina babe. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />Imwi mubakwaina bangu kana muta zwandinomulaya. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />Andichinomushoba nditi mubalanda, nokuti undanda aatoziba zwinotiwa naTezi uwe koga ndinoti mubakwaina nokuti zwinhu zwose zwandakawha kunaTate bangu ndakamuzibisa izwo. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />Imwi amujakandishala imi, koga ndakamushala ndikamuponcha, kuti munde munozwala michelo, akale michelo yenu igalilile kutila kuti zwose zwamunokumbila kuna Tate muzina lyangu bemupe. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />Nezwo ndinomulayila, kuti mudanane.<verse eid="JHN 15:17" /></para>
  <para style="s">INyika Inobenga Balayijwa</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />“Kana inyika imubenga, izibani kuti yakandibenga isanhu yamubenga imwi. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />Ngana mwaluba benyika, inyika yalumuda sabayo. Asi ndakamushala kuva munyika, amutoba benyika, ndizwo inyika imubenga. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />Yeyani iwhi lyandakaleba kwamuli nditi, ‘Undanda aatoba unkulwana kupinda tezi uwe.’ kana bakandiyabisa imi, banoomuyabisa namwibo, kana bakalondota indayijo yangu, banoolondota indayijo yenu. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />Koga zwose yezwi baanomutila nokuti mulibangu akale abatounziba wakandituma. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />Ngana ndisakezha kolebeleka nabo, abajaloba noluchinyo, asi ngweno abachina lubhatilo noluchinyo lwabo. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />Iye unondibenga, unobenga Tate bangu bo. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />Ngana ndisijakata mishingo pakati pabo, isijakatiwa nomwe unhu, abajaluba noluchinyo koga ngweno bakabona bakava bandibenga imi naTate bangu. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />Koga yezwi zwakatina kuti kuzhajikijwe iwhi lilokwalwa mumulawo wabo linoti, ‘Bakandibenga besina chisoko.’<verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />“Kana uMbhanchi angozha, iye wandichatumila kuva kunaTate, uMpepo wechokomende, unova kunaTate unoondisumikijila. <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />Akale namwibo, mubasumikiji, nokuti mwaluba nami kuvila pakutanga.”<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />“Ndaleba zwose yezwi kwamuli kuti musilashike mukudimbwa kwenu. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />Banoomutata mumasinagogo, chokomende unshaji ukumuzha wokuti aanizwe unomubulaya unoyeya kuti ukumushingila Mwali. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />Akale banoota zwinhu yezwi nokuti abajakabaziba Tate, kana imi. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />Koga ndaleba zwinhu yezwi kwamuli, kutila kuti unshaji wabo ungoswika mulangalile kuti ndakamubuja nezwabo. Andijakaleba zwinhu yezwi kwamuli, kuvila pakutanga nokuti ndakabechinanamwi.”<verse eid="JHN 16:4" /></para>
  <para style="s">Unshingo WoMpempo UNchena</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5" />“Koga ngweno ndikumunda kuna iye wakandituma, asi akuna kana umwempela wenu ukumundibhuza eti, ‘Ukumunda kupi?’ <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />Nokuti ndamubuja zwinhu yezwi, myoyo yenu yazhala neshungu. <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />Zwisineni, ndinomubuja ichokomende, zwinobhancha imwi kuti ndinde nokuti kana ndisenda uMbhanchi aangezhe kwamuli koga kana ndenda ndinoontuma kwamuli. <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />Akale angozha, unoobwetekeja inyika pezhulu poluchinyo, nobululami, akale nontongo. <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />Balolashika undingilo wabo noluchinyo, nokuti abatodimbwa kwandili, <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />balolashika pandingilo wabo wokululama, nokuti ndinonda kunaTate, akale amuchinoondibona kabili, <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />akale balolashika pandingilo wabo wontongo, nokuti untongi wenyika yeno ulotongwa kale.”<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />“Ndina zwinhu zwinji zwandichinoda kulebeleka kwamuli, koga amungatubule kuzwibhatisisa ngweno.” <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />Paachezha uMpepo wechokomende, unoomutungamilila muchokomende chose, nokuti aatoleba zwesimba lilye, koga yezwo zwaanowha ndizwo zwaachaleba, akale unoomuzibisa zwichinozha. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />Unoondikuja, nokuti unootola zwandinoleba emubuja. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />“Zwinhu zwose zwabananazwo Tate ngozwangu, ndizo ndati uMpepo unootola zwandinoumbuja emuzibise imwi.”<verse eid="JHN 16:15" /></para>
  <para style="s">Kushulubala Kunooshandulwa Kukaba Kushanta</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />“Mushule monshaji unshomanana, amutondibona, koga mushule monshaji unshomanana, moondibona akale.”<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />Bamwe balayijwa babe bakati umwe kunoumwe, ‘Ini yezwi zwakumuleba kwatili kuti, mushule monshaji unshomanana, amutoba muchinondibona, koga mushule monshaji unshomanana, moondibona akale?’ akale paanoti, ‘nokuti ndimunda kunaTate.’ <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />Bakati, “Ini zwaanoleba nokuti mushule monshaji unshomanana? Atitoziba zwaanoleba.”<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />Jesu wakabeziba kuti bakumuda kuumbhuza, nezwo wakati kwabali, “Ndizwo yezwi zwakumumubhuzana na kuti ndandilebani nditi, ‘Konshaji unshomanana amutondibona akale munshaji unshomanana munoondibona?’ <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />Ndolebesa nditi kwamuli munoofwikula nokulila, koga inyika inooshanta, munoowushubala koga kuwushubala kwenu kunooshanduka kubelushanto <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />Unhukaji kana imimba ilwaja unohetela, nokuti unshaji uwe unosoba waswika, asi kana achila mwana aachinolangalila kulwajilwa yokuya, pezhulu polushanto lwokuti kwachilwa mwana penyika. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />Nezwo mulohetela ngweno, koga ndinoomubona, munooshanta, akale apana uchoomutolela lushanto lwenu.”<verse eid="JHN 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23" />“Nelyo izhuba amutoondikumbila chinhu. Ndinolebesa nditi kwamuli, chose chamuchakumbila kunaTate muzina lyangu banoomupa. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />Kuswikila yono nshaji apana chamwanhu mwakumbila muzina lyangu, kumbilani, akale munootambula, kuti lushanto lwenu luzhulile.<verse eid="JHN 16:24" /></para>
  <para style="s">Kuzunda Inyika</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />“Ndamubuja yezwi nezwichimbe, koga kunoozha unshaji pandicholeba ndisinoshingisa mikwejaniso koga ndinoomubuja zwaTate pachena. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />Muzhuba yelyo munookumbila muzina lyangu, akale anditoti kwamuli ndinoomunamatila kunaTate, <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />nokuti Tate bomene banomuda, nokuti imwi mwakandida akale mukadimbwa kuti ndakava kunaTate. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />Ndakava kunaTate ndikezha penyika, akale ndimusiya inyika ndinda kunaTate.”<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />Balayijwa babe bakati, “Ngweno umulebeleka zwipopachena, kusi nezwichimbe. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />Ngweno taziba kuti unoziba zwinhu zwose, akale azwitoshaka kuti unhu ebenombhuzo kwauli, neezwi tadimbwa kuti wakava kunaMwali.”<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />Jesu wakabashandula eti, “Ngweno mwadimbwa na? <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />Unshaji umuzha, chokomende waswika, pamuchatataukana, unhu wose kunzi uwe, akale moondisiya ndoga. Koga anditobandoga, nokuti Tate bana nami. <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />Ndamubuja yezwi, kuti munami muwane lunyalalo. Munyika munamasheto, koga ibani nolushanto, inyika ndaizunda.”<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">Jesu Unonamatila Balayijwa Babe.</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />Jesu paakaleba yaya mahwi, wakalinga kudenga, akati, “Tate, unshaji waswika. Kujani Mwananhulumyana wenu kuti Mwananhulumyana emukuje bo, <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />sezwo mwakompa masimba pezhulu pabanhu bose, kutila kuti epe bupenyu businopela kuna yabo bose bamwakompa. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />Akale yobu bupenyu businopela, kuti bemuzibe imwi Mwali wechokomende akale naJesu Kristo wamwakatuma. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />Ndakamukuja penyika, ndakawupeja unshingo wamwakandipa kuti ndiunte. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />Akale ngweno Tate, ndikujeni imi mbeli kwenu, nolukujo lwandakaba ndilinalo namwi inyika isanhu yabumbwa.”<verse eid="JHN 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />“Ndakatondejela izina lyenu kubanhu bamwakandipa kuva munyika, baluba benu mukandipa imi, akale bakalondota iwhi lyenu. <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />Ngweno banoziba kuti zwose zwamwakandipa zwinova kwamuli. <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />Nokuti ndakabapa mawhi amwakandipa, bakawatambula, bakaziba ichokomende kuti ndakava kwamuli nokudalo bakadimbwa kuti ndakatumwa namwi.”<verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />“Ndikumubanamatila, andijikumunamatila inyika, koga yabaya bamwakandipa nokuti ngabenu. <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />Zwose zwangu ngozwenu, zwenu ngozwangu akale ndokujwa nomunaibo. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />Akale ngweno andichimo munyika, koga bayimo munyika, akale ndikumuzha kwamuli. Tate bachena, balondoteni muzina lyenu, ilo lyamwakandipa, kuti bebe unhu umwempela chete, sezwo tili bamwempela. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />Ndichili nabo ndakabalondota muzina lyenu lyamwakandipa, ndikabalinda kusina umwe wabo wakalashika, kuzhe komwanhanhulumyana wakabakamisilwa kulashwa, kuti lukwalo luzhajikijwe. <verse eid="JHN 17:12" /><verse number="13" style="v" sid="JHN 17:13" />Koga ngweno ndozha kwamuli, ndinoleba zwinhu yezwi penyika kutila kuti bezhajwe nolushanto lwangu mwabali. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />Ndakabapa iwhi lyenu, akale inyika ikababenga nokuti abatoba benyika, sezwandisili wenyika. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />Anditonamatila kuti mubabhise penyika, koga kuti mubalondote pana umbi. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />Abatoba benyika, nami anditobeli wenyika. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />Mubachenese muchokomende, iwhi lyenu ndilo ichokomende. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />Sezwo mwakandituma munyika, namibo ndakabatuma munyika. <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />Ndazwichenesela ibo, kutila kuti becheneswe zwizhele.”<verse eid="JHN 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />“Anditonamatila yaba chete, koga naabo banodimbwa munami newhi lyabo, <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />kutila kuti bose bebe bamwempela sezwo imwi Tate muli mwandili nami ndili mwamuli. Ndinonamatila kuti naibo bebe mwatili, kutila kuti inyika idimbwe kuti mwakandituma. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />Ndakabapa lukujo lwamwakandipa, kuti bebe bamwempela, zwatili bamwempela. <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />Imi mwabali, namwi mwandili, kuti bebebamwempela zwilopelelela, kutila kuti inyika izibe kuti mwakandituma akale mukabada, sezwamakandida imi.”<verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />“Tate, ndine chido chokuti yabaya bamwakandipa, bebe nami pose pandinobeli, kuti bebone lukujwo lwangu lwamwakandipa nokuti mwakandida musanu mwabumba inyika. <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />Imwi Tate bakalulama, kojoba inyika isakamuziba, koga ndomuziba, naibo yaba bakaziba kuti mwakandituma. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />Ndakata kuti muzibikane kwabali, akale ndondila mbeli kuti muzibikane, kutila kuti kudanana kwenu kwamunanako kunami kube munaibo, namibo ndibe munaibo.”<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">Kusungwa KwaJesu</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mateo 26:47-56</ref>; <ref loc="MRK 14:43-50">Mako 14:43-50</ref>; <ref loc="LUK 22:47-53">Luka 22:47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />Jesu aleba yaya mawhi, wakabhuda nabalayijwa babe bakavubuka igoba linowhi Kidiloni, kwaluba nechilili, chaakangwina nabalayijwa babe. <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />Ngweno Judasi, wakoncheta, naiye walubuziba bugalo yobwo, nokuti Jesu walusobungana kanjikanji nabalayijwa babe mwakale. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />Nokudalo Judasi wakapiwa igapo lyabalwi nabalindi betempeli kubatebuji bakulwana akale nokubaFalisi, bakenda kuchilili yecho, beli namalambi nomwenje akale nezwilwaniso. <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />Jesu, eziba zwose zwalutikana kwaali, wakezha mbeli kwabo akati kwabali, “Mumupyanga aani?”<verse eid="JHN 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5" />Bakonshandula beti, “Jesu wokuNazaleta.”</para>
  <para style="p" vid="JHN 18:5">Jesu wakati kwabali, ‘‘Ndimi iye.”</para>
  <para style="p" vid="JHN 18:5">Judasi wakoncheta, wakabelimile nabo. <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />Jesu paakati kwabali, “Ndimi iye,” bakabwilila mushule bakawila pasi. <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />Wakababhuza akale eti ‘‘Mumupyanga aani?”</para>
  <para style="p" vid="JHN 18:7">Bakashandula beti, “Jesu wokuNazaleta.”<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />Jesu wakashandula eti, “Ndamubuja kuti ndimi iye, nokudalo, kana mupyanga imi, lekejani banhulume yaba bende.” <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />(Yoku kuzhajikija mawhi aakabaleba kuti, “Kunaabo bamwakandipa, andijakalashikilwa kana nomwempela.”)<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />Simoni Pita, wakatola igwalabaza lyaakabeli nalyo, akatema undanda wontebuji unkulwana, akondumula inzebe yokululyi. Izina lyondanda lyaluwhi Malikasi. <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" />Jesu wakati kuna Pita, “Ibwiliza igwalabaza lilyo pabugalo bwalyo, ndisinwe na unkombe wokujiijwa wandapiwa natate bangu?”<verse eid="JHN 18:11" /></para>
  <para style="s">Jesu Unosengwa Mbeli KwaAnasi</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />Nokudalo igapo lyabalwi nontungamili walyo, nabalindi betempeli bakombhata Jesu bakonsunga. <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />Bakatanga bonsenga kunaAnasi, nokuti wakaba eli unkalabwa waKayifasi, wakabeli untebuji unkulwana igole yelyo. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />NdiKayifasi wakabalaya baJuda kuti zwilolulama kuti unhu umwempela unokwelela kufila banhu bose.<verse eid="JHN 18:14" /></para>
  <para style="s">Pita Unolamba Jesu</para>
  <para style="r">(<ref loc="MAT 26:69">Mateo 26:69</ref>; <ref loc="MRK 14:66-68">Mako 14:66-68</ref>; <ref loc="LUK 22:55-57">Luka 22:55-57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />Simoni Pita noomwe undayijwa bakatobela Jesu. Nokuti yoyu undayijwa waluzibwa nontebuji unkulwana, wakangwina mulubazhe lontebuji unkulwana pamwempela naJesu, <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />koga Pita echimile pazhe, pankoba. Umwe undayijwa waluzibwa nontebuji unkulwana, wakabhuda akanolebeleka nondindikaji wonkoba, akangwinisa Pita mukati. <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />Unsichana walulinda pankoba wakati kunaPita, “Iwi autoba umwe wabalayijwa bonhu yoyu na?”</para>
  <para style="p" vid="JHN 18:17">Iye wakati, “Anditoba.”<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />Ngweno bashingi nabalindi betempeli bakabangija moto wamasimbe, nokuti kwakabetonhola, bakabelimile bezwikotela moto, Pita naiye wakaba elinabo elimile ezwikotela moto.<verse eid="JHN 18:18" /></para>
  <para style="s">Untebuji Unkulwana Unobhuzisisa Jesu</para>
  <para style="r">(<ref loc="MAT 26:59-66">Mateo 26:59-66</ref>; <ref loc="MRK 14:55-64">Mako 14:55-64</ref>; <ref loc="LUK 22:66-71">Luka 22:66-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />Untebuji unkulwana wakabhuza Jesu nezwabalayijwa babe nendayijo yiye. <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />Jesu wakonshandula akati, “Ndabelebeleka pachena kubanhu bose, unshaji wose ndakabelayija mumasinagogo akale nomutempeli, kuli iko kunobunganila baJuda bose, andijakaleba chinhu mwakasisika. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />Unondibhuzilani? Ibhuza yabo bakandiwha, kuti ini zwandakaleba kwabali, banoziba zwandakaleba.”<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />Alebeleka yezwi, umwe undindi wetempeli wakaba elimile pelyo naJesu wakomakula akati, “Ndiko kudabila untebuji unkulwana na yoku?”<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />Jesu wakonshandula eti, “Kana ndalebeleka bubi, sumikija bubi yobwo, koga kana ndalebeleka zwanana, wandilobelani biya?”<verse eid="JHN 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24" />Anasi wakontumija akasungwa kuna Keyifasi untebuji unkulwana.<verse eid="JHN 18:24" /></para>
  <para style="s">Pita Unolamba Jesu Akale</para>
  <para style="r">(<ref loc="MAT 26:71-75">Mateo 26:71-75</ref>; <ref loc="MRK 14:69-72">Mako 14:69-72</ref>; <ref loc="LUK 22:58-62">Luka 22:58-62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />Ngweno Simoni Pita wakaba elimile ezwikotelela moto. Bakabhuza beti, ‘‘Iwi, autoba umwe wabalayijwa babe na?”</para>
  <para style="p" vid="JHN 18:25">Wakanyenyeja eti, “Anditoba imi?”<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />Umwe wabashingi bontebuji unkulwana, igamu lyowakabadumulwa inzebe naPita, wakabhuza eti, ‘‘Andijakubona na uli naye muchilili?”<verse eid="JHN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 18:27" />Pita akale wakapamha enyenyeja, pakalepo igukulume lyakakokoleka.<verse eid="JHN 18:27" /></para>
  <para style="s">Jesu Unosengwa Mbeli MwaPilato</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mateo 27:1-2</ref>; <ref loc="MRK 15:1-5">Mako 15:1-5</ref>; <ref loc="LUK 23:1-5">Luka 23:1-5</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />Kova beva kungumba yaKefasi, boonsenga Jesu kungumba yontongi wabaRoma. Kwakaba kuchi zwingwanangwana. Ibo abajakangwina mungumba yontongi kuti besiswibhe, betila kuti belye ipasika. <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />Nokudalo Pilato wakabhuda akenda kwabali akati, ‘‘Mumumpomela undandu ni unhulume yoyu?”<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />Bakonshandula beti, “Ngana unhulume yoyu esiumvuni womulawo atijaluumbuza kwauli.”<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />Pilato wakati kwabali, ‘‘Untoleni imwi muuntonge nomulawo wenu.”</para>
  <para style="p" vid="JHN 18:31">BaJuda bakati kwaali, ‘‘Atitovumijwa isu kubulaya unhu.” <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />Yoku kwaluba kuzhajikija iwhi lyaJesu lyaakaleba etondejela kuti unoofa lufu lwakata chini.<verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />Ngweno Pilato wakangwina kabili mungumba yontongi wabaRoma akashoba Jesu, akati kwaali,‘‘Ndiwi She wamaJuda na?”<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />Jesu wakonshandula eti, ‘‘Ukumuleba yezwi nokukwo, kana wazwibujwa nabamwe nezwangu?”<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />Pilato wakashandula eti, ‘‘Imi ndiNjuda na? Luji lulwo akale nabatebuji bakulwana bakupila kwandili, ini zwawata?”<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />Jesu wakashandula eti, ‘‘Bushe bwangu abutoba bwenyika yeno, ngana bushe bwangu buli bwenyika yeno, bashingi bangu balulwana, kuti ndisisungwe nabatungamili babaJuda, koga bushe bwangu abutoba bwopenyika.”<verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />Pilato wakati kwaali, “Ndiko kuti ulishe na?”</para>
  <para style="p" vid="JHN 18:37">Jesu wakashandula eti, “Wazwileba ndiwi kuti ndili she. Ndizwo zwandakazwalilwa, akale ndizo zwandakezhila penyika, kuti ndisumikije ichokomende. Umwenoumwe uli wechokomende unowha iwhi lyangu.”<verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />Pilato wakombhuza eti, ‘‘Ichokomende ini? ”</para>
  <para style="s" vid="JHN 18:38">Jesu Unotongelwa Lufu</para>
  <para style="r" vid="JHN 18:38">(<ref loc="MAT 27:15-31">Mateo 27:15-31</ref>; <ref loc="MRK 15:6-20">Mako 15:6-20</ref>; <ref loc="LUK 23:13-25">Luka 23:13-25</ref>)</para>
  <para style="p" vid="JHN 18:38">Mushule mokulebeleka yezwi, wakabhuda akenda kubaJuda akale, akati kwabali, “Andijikumuwana undandu mwaali. <verse eid="JHN 18:38" /><verse number="39" style="v" sid="JHN 18:39" />Koga imwi munengalilo yokuti ndimusungunulile unsungwa umwempela pePasika. Movuma na kuti ndimusungunilile she wabaJuda?”<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />Ibo bakakongoloka kakale beti, “Kusi yoyonhu ne koga Bhalabhasi!” Ngweno Bhalabhasi waluba umpambi.<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />Pilato wakatola Jesu kova oonabha. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />Balwi bakaluka chilemba chemiwha, bakachibiga pansholo uwe, akale bakombajika igubukubu lyensulubele, <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />bakabezha kwaali beti, “Ndauwe, She wabaJuda!” Boomakula.<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />Pilato wakabhuda akale, akati kwabali, “Ilingani, ndimuumbuza kwamuli kuti muzibe kuti andijawana chisoko chokuti ndiumpe untongo.” <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />Sezwo Jesu wakabhuda akambala chilemba chemiwha negulukubu yensulubele, Pilato wakati kwabali, “Hoyu unhulume!”<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />Batebuji bakulwana nabalindi betempeli pabakombona, bakashomeja beti, “Unkahamile! Unkahamile!”</para>
  <para style="p" vid="JHN 19:6">Pilato wakati kwabali, “Untoleni imwi muunkahamile, nokuti andibweni chisoko chokuumpa untongo.”<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />Batungamili babaJuda bakonshandula, beti, “Tina nomulawo, akale nomulawo yoyo unokwelela kufa, nokuti wazwita Mwananhulumyana waMwali.”<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />Pilato paakawha mawhi yaya, wakatya kasa, <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />akangwina akale mungumba akati kuna Jesu, “Unovakupi?”</para>
  <para style="p" vid="JHN 19:9">Asi Jesu aajakashandula. <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />Nezwo Pilato wakati kwaali, “Autoda kulebeleka nami? Autoziba na kuti ndinemasimba lyokukusungunula, akale nesimba lyokukukahamila?”<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />Jesu wakonshandula eti, “Aungabe nesimba pezhulu pangu kuzhe kokuti walipiwa liva pezhulu, nezwo iye wandibuza kwauli ndiye unaluchinyo lukulwana kasakasa.”<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />Kuva yoyo nshaji Pilato wakakweja kuunsungunula, asi batungamili babaJuda bakakongoloka beti, “Kana ungoonsungunula yoyu unhu autoba unkwaina waKesali, wose unozwita she, umulwisana naKesali.”<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />Pilato paakawha mawhi yaya, wakabuza Jesu pazhe akagala pechigalo chiche chobutongi, pabugalo bwaluwhi Chilongamabwe muchiHebhelu baluti iGabhata. <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />Ngweno lyakabalili izhuba lyokulonganyila miliya yePasika, kwakaba kuli masikati makulwana. Wakati kubaJuda, “Ilingani She wenu!”<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />Bakashomeja beti, “Umbhise yopano, Ubhise yopano, unkahamile!</para>
  <para style="p" vid="JHN 19:15">Pilato wakati kwabali, “Ndikahamile she wenu na?”</para>
  <para style="p" vid="JHN 19:15">Batebuji bakulwana bakashandula beti, “Atina umwe she kuzhe kwaKesali.”<verse eid="JHN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16" />Kova oompila kwabali kuti ekahamilwe.</para>
  <para style="s" vid="JHN 19:16">Jesu Unokahamilwa</para>
  <para style="r" vid="JHN 19:16">(<ref loc="MAT 27:32-44">Mateo 27:32-44</ref>; <ref loc="MRK 15:21-32">Mako 15:21-32</ref>; <ref loc="LUK 23:26-43">Luka 23:26-43</ref>)</para>
  <para style="p" vid="JHN 19:16">Nezwo balwi bakontola Jesu. <verse eid="JHN 19:16" /><verse number="17" style="v" sid="JHN 19:17" />Wakanyamula unchinjikwa uwe, benda kubugalo bunowhi bugalo bwebhepe lyonsholo, bunowhi, (muchiHebhelu iGologota.) <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />Kwakaleko bakonkahamila panchijikwa, nabamwe babili, Jesu eli pakati pabo. <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />Pilato neebo wakakwala idopoji akalibiga panchinjikwa, linoti, “Jesu wokuNazaleta, She wabaJuda.” <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />Banji babaJuda bakalibala idopoji yeli, nokuti bugalo Jesu bwaakakahamililwa bwakabeli pelyo neguta igulwana, akale kwakabakakwalwa muchiHebhelu, muchiLatini, nomuchiGiliki. <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />Batebuji bakulwana babaJuda bakati kuna Pilato, “Usikwale kuti, ‘She wabaJuda,’ koga uti, ‘Yoyu unhulume wati, imi ndili she wabaJuda.’ ”<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />Pilato wakabashandula eti, “Zwandakwala, ndakwala.”<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />Balwi pabakapeja kuunkahamila Jesu, bakatola zwimbalo zwizwe bakata zwipindi zwina, chipindi kuna umwe noumwe wabalwi, akale neshashiko iye. Koga ishashiko yakabesina umpeto, yakabakalukwa kuvila pezhulu zwinda pasi ulincheka umwempela.<verse eid="JHN 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 19:24" />Nezwo bakati kunoumwe noumwe, “Tisiyijelule koga ngatiteni ifumbefumbe kuti tibone kuti inoba yani.” Yezwi zwakatilwa kuzhajikija lukwalo lunoti,</para>
  <para style="q1" vid="JHN 19:24">“Bakajelulilana zwimbalo zwangu,</para>
  <para style="q2" vid="JHN 19:24">bakatila ifumbefumbe ishashiko yangu.”</para>
  <para style="m" vid="JHN 19:24">Yezwi ndizwo zwakatiwa nabalwi.<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />Pelyo nonchinjikwa waJesu, kwakaba kulimile amai baJesu, nonkulu wamai babe, Mariya unkaji waKilopasi, naMariya wokuMagadala. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />Jesu paakabona amai babe, akale nondayijwa waakabeda elimile pelyo, wakati kuna amai babe, “Mai, ilinga yondiya mwananhulumyana uwo!”<verse eid="JHN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27" />Kova eti kundayijwa uwe, “Ilinga yaba ndi amai babo!” Akale kuva yoyo unshaji undayijwa wakabatola akanogala nabo kunsha uwe.<verse eid="JHN 19:27" /></para>
  <para style="s">Kufa KwaJesu</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mateo 27:45-56</ref>; <ref loc="MRK 15:33-41">Mako 15:33-41</ref>; <ref loc="LUK 23:44-49">Luka 23:44-49</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />Mushule mwezwi, Jesu aziba kuti zwose zwapela, kuti ezhajikija lukwalo luchena wakati, “Ndafanenyota.”<verse eid="JHN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 19:29" />Ihali izhele iwaini inopanyuka yakabeli pakalepo, nokudalo bakabiga inganganga lizhele newaini linopanyuka pakakunyana kehayisopi bakakamilija kundomo uwe. <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />Jesu paakalabila iwaini inopanyuka wakati, “Zwapela.”</para>
  <para style="p" vid="JHN 19:30">Wakakotamisa unsholo uwe akafa.<verse eid="JHN 19:30" /></para>
  <para style="s">Kubhayiwa KwaJesu Mulubavu</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />Sezwo waluba unsi wokulonganyila, kutila kuti mitumbu isibe pamichinjikwa nesabata (nokuti isabata yeli lyakabakakosha), batungamili babaJuda bakakumbila kunaPilato kuti makumbo aabo bakakahamilwa panchinjikwa evunwe, akale betolwe. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />Nokudalo balwi bakezha bakavuna makumbo owokutanga, akale nowoumwe wakaba akakaamilwa naye, <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />koga pabakaswika pana Jesu bakabona kuti ulofa kale, abajakavuna makumbo awe. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />Koga umwe wabalwi wakombhaya mulubavu nefhumo, pakalepo kwakabhuda ilopa nevula. <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />Iye wakazwibona unano busumikiji, busumikiji bubwe ngobwe chokomende, akale iye unoziba kuti unoleba ichokomende kuti namwibo mudimbwe. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />Yezwi zwinhu zwakatika kuti lukwalo luchena luzhajikijwe lunoti, “Apana ifupa lilye lichavunwa.” <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />Akale lumwe lukwalo luchena lunoti, “Banoolinga kuna iye wabakabhaya.”<verse eid="JHN 19:37" /></para>
  <para style="s">Kujikwa KwaJesu</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mateo 27:57-61</ref>; <ref loc="MRK 15:42-47">Mako 15:42-47</ref>; <ref loc="LUK 23:50-56">Luka 23:50-56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />Mushule mwezwi Josefa wokuGuta lyokuAlimatiya wakabeli undayijwa waJesu, koga zwilosisika, nokutya batungamili babaJuda, wakakumbila kuna Pilato kuti etola untumbu waJesu .Pilato wakomvumija. Nokudalo wakezha akatola untumbu uwe. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />Nikodimasi iye wakabenda kunaJesu busiku, wakezhabo, ebuza zwishanganiswa zwobunde bwedati nuna bulemu bungaba makilogilamu makumi matatu. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />Bakatola untumbu waJesu, bakomputila nemicheka nezwishanganiswa zwobunde zwinonhuwilila songalilo wokujika kwabaJuda. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />Pabugalo paakakahamililwa pakabelina chilili, akale muchilili yechi mwakabeli negumbu ibhya musakabanhu mwalajikwabo unhu. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />Nokudalo, nokuti lyakabeli izhuba lyabaJuda lyokulonganya, akale nokuti igumbu lyakabeli pelyo, bakabiga untumbu waJesu mwakalemo.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">Igumbu Lisina Chinhu</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mateo 28:1-8</ref>; <ref loc="MRK 16:1-8">Mako 16:1-8</ref>; <ref loc="LUK 24:1-12">Luka 24:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />Ngweno nonsi wotanga weviki Mariya wokuMagada wakakezha kugumbu nokukambija, kuchakaswibha, akabona kuti ibwe lyakababhiswa pegumbu. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />Wakalabuka, akenda kunaSimoni Pita, nokunomwe undayijwa, waludisiswa naJesu, akati kwabali, “Babhisa Tezi mugumbu, akale atitoziba kwabombiga.’’<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />Pita wakabhuda noumwe undayijwa, bakenda bekalingisa kugumbu. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />Bakalabuka pamwempela, koga umwe undayijwa wakalabuka kasa akasiya Pita, akaswika kutanga pegumbu, <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />akale wakakotama eshozhela, akabona micheka ili pasi, asi aajakangwina. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />Simoni Pita wakezha, ountobela, akangwina mugumbu. Akabona micheka ili pasi. <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />Akale uncheka wakaba uli munsholo mumwe aujakabeli paneyimwe, micheka, koga wakabakapetwa uliwoga. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />Undayijwa yondiya wakatanga kuswika pegumbu, naiye bo wakangwina akabona akale akadimbwa, <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />nokuti bakaba besanu bawhisisa lukwalo lunoti, ‘unokwelela kumuka kubafi.’ <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />Balayijwa bakabwilila kujingumba jabo.<verse eid="JHN 20:10" /></para>
  <para style="s">Jesu Unozwitondeja Kuna Mariya WokuMagadala</para>
  <para style="r">(<ref loc="MAT 28:9-10">Mateo 28:9-10</ref>; <ref loc="MRK 16:9-11">Mako 16:9-11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />Mariya wakaba elimile kuzhe kwegumbu efwikula, akale echinofwikula wakakotama akashozhela mugumbu, <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />wakabona ingilozi imbili jikambala zwimbalo zwichena, jiligele pasi, imwe kwakabeli kunsholo imwe kwakabeli namakumbo, yopo pakaba palajikwa untumbu waJesu <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />Jikati kwaali, ‘Mai munofwikulilani?” Iye wakati kwajili,</para>
  <para style="p" vid="JHN 20:13">“Nokuti batola She wangu, akale anditoziba kwabombiga.”<verse eid="JHN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14" />Echinoleba yezwi wakachebuka, akabona Jesu elimile, koga aajakaziba kuti ndiye. <verse eid="JHN 20:14" /><verse number="15" style="v" sid="JHN 20:15" />Jesu wakati kwaali “Mai munofwikulilani? Ndiani wamunoshaka biya?”</para>
  <para style="p" vid="JHN 20:15">Iye wakayeya soti undimi, akati kwaali, “Shungwasha, kana mombhisa, ndibujeni zwenu pamombiga, ndinountola.’’<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />Jesu wakonshoba eti, “Mariya.”</para>
  <para style="p" vid="JHN 20:16">Iye wakachingunuka akati kwaali, “Raboni ndiko kuti, “Undayiji,” muchiHebhelu.<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />Jesu wakati kwaali, ‘‘Usindibhate, nokuti andijanu ndatanha kunda kunaTate bangu, koga inda kubanakwaina bangu, unoti kwabali ‘Ndotanha kunda kunaTate bangu, nokuna Tate benu, kunaMwali wangu, nokunaMwali wenu.’ ”<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />Mariya wokuMagadala wakenda, akanobuja balayijwa kuti wabona Tezi, akale kuti wabujwa zwinhu yezwi naiye.<verse eid="JHN 20:18" /></para>
  <para style="s">Jesu Unozwitondejela Kubalayijwa Babe</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mateo 28:16-20</ref>; <ref loc="MRK 16:14-18">Mako 16:14-18</ref>; <ref loc="LUK 24:36-49">Luka 24:36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />Madeko ezhuba lyakalelyo lyokutanga lyeviki, balayijwa bakabaka bungana pamwempela bekakonya mikoba nokuti bakabetya batungamili babaJuda, Jesu wakezha akama pakati pabo, akati kwabali, “Lunyalalo ngalube namwi.” <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />Aleba yezwi, wakabatondeja maboko nebhazu lilye. Nokudalo balayijwa bakashanta nokubona Tezi. <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />Jesu wakapamha akati kwabali, “Lunyalalo ngalube namwi, Tate sezwa bakandituma namibo ndinomutuma.” <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />Wakati aleba yezwi wakafemela pezhulu pabo akati kwabali, “Tambulani umpempo unchena. <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />Kana mukalekejela banhu luchinyo lwabo lunolekejelwa koga, kana mungosolekejela banhu luchinyo lwabo alutolekejelwa.”<verse eid="JHN 20:23" /></para>
  <para style="s">Jesu NaTomasi</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />Ngweno Tomasi unowhi imbile umwe wabaligumi lina babili wakaba esipo pabali paakaswika Jesu. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />Nezwo bamwe balayijwa bakati kwaali, “Isu taumbona Tezi,” Koga iye wakati kwabali, “Kana ndisabona mumaboko awe mabanga enembe, ndikabiga kanyala mubanga enembe akale ndiwheke luboko lwangu mulubavu lulwe anditodimbwa.” <verse eid="JHN 20:25" /><verse number="26" style="v" sid="JHN 20:26" />Kwakati kwapinda mazhuba mashanu anamatatu, balayijwa babe bakaba belimungumba. Tomasi wakabeli nabo. Matendele akabakakonywa, asi Jesu wangwina akama pakati pabo akati, “Lunyalalo ngalube namwi. ” <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />Wakati kunaTomasi, “Biga kanyala kako yopa, ubone maboko angu, ubuze luboko lulwo, ulubige palubavu lwangu, leka kusodimbwa koga dimbwa.” <verse eid="JHN 20:27" /><verse number="28" style="v" sid="JHN 20:28" />Tomasi wakashandula akati kwaali, “Tezi wangu naMwali wangu.” <verse eid="JHN 20:28" /><verse number="29" style="v" sid="JHN 20:29" />Jesu wakati kwaali, “Tomasi nokuti wandibona wadimbwa?” Balokombolelwa yabo basijakabona koga banodimbwa.<verse eid="JHN 20:29" /></para>
  <para style="s">Chinangwa CheWhalo Yeyi</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />Jesu wakata zwimwe zwishamiso zwinji mbeli kwabalayijwa babe zwisakakwalwa muwhalo yeyi, <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />koga yezwi zwakakwalwa kuti mudimbwe kuti Jesu Kristo Mwananhulumyana waMwali, akale kuti kana mudimbwa mube nobupenyu muzina lilye.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">Jesu Unozwitondejela Kubalayijwa Bashanu Nababili</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />Mushule moopo Jesu wakazwitondejela akale kubalayijwa kumbali kwegungwa lyeTayibheliyasi, wakazwitondejela nenzila yeyi. <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />Simoni Pita, Tomasi wakabeshobwa kuwhi imbile, Nataniyele unova kuKana muGalili, banabanhulumyana baZebhedi, akale nabamwe babalayijwa babili baluba pamwempela. <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />Simoni Pita wakati kwabali, “Ndikumunda kunovuba ihobe.”</para>
  <para style="p" vid="JHN 21:3">Bakati kwaali, “Tonda nawi.” Bakabhuda bakenda bakangwina mubwato bukulwana, koga busiku yobo apana zwabakabhata. <verse eid="JHN 21:3" /><verse number="4" style="v" sid="JHN 21:4" />Pakalepo kwaloboja, Jesu wakama pebhambo, koga balayijwa abajakaziba kuti ndiJesu. <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />Jesu wakati kwabali, ‘‘Bakwaina bangu munanehobe na?”</para>
  <para style="p" vid="JHN 21:5">Bakonshandula beti, “Mane.”<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />Akati kwabali, “Posani ivubo kululyi lwobwato, mobhata.” Nokudalo bakaliposa, ngweno bakakonwa kulikuluntila mubwato, nokuwanda kwehobe.<verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />Undayijwa waludiwa naJesu wakati kuna Pita, “NdiTezi.” Simoni Pita paakawha kuti ndiTezi, wakambala zwimbalo zwizwe, nokuti wakabazwimbula, akalwipukila mugungwa. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />Koga bamwe balayijwa bakezha nobwato, bekulunta ivubo lyakabeli zhele nehobe, nokuti bakaba besikule nenyika, koga kwaluswika izana lyamamita. <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />Pabakaswika penyika, bakabona moto wamasimbe, peli nehobe pakale nechinkwa. <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />Jesu wakati kwabali, “Ibuzani jimwe hobe jimwabhata ngweno.”<verse eid="JHN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11" />Nokudalo Simoni Pita wakatanha mubwato akakuluntila ivubo lyakabelizhele ihobe ihulwana penyika, jakabeli izana lina makumi mashanu ane nhatu, kojoba jakabeli inji ivubo alijakajeluka. <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />Jesu wakati kwabali, “Izhani mulye kulya kwezhingwanangwana.” Apana kana umwempela wabalayijwa wakoombhuza kuti, “Ndiwi aani?” Nokuti bakabeziba kuti ndiTezi. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />Jesu wakatola chinkwa akabapa, akale nehobe bo.<verse eid="JHN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 21:14" />Yopa kwaluba kwechitatu Jesu etondejelwa kubalayijwa babe, mushule mokumuswa munabakafa.<verse eid="JHN 21:14" /></para>
  <para style="s">Jesu NaPita</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />Pabakapeja kulya kwezhingwanangwana, Jesu wakati kuna Simoni Pita, “Simoni Mwananhulumyana waJohani unondida kupinda yaba na?”</para>
  <para style="p" vid="JHN 21:15">Wakati kwaali, “Eya Tezi, unoziba kuti ndokuda.”</para>
  <para style="p" vid="JHN 21:15">Wakati kwaali, “Lyisa imhwizana jangu.” <verse eid="JHN 21:15" /><verse number="16" style="v" sid="JHN 21:16" />Kwechibili, wakati kwaali, Simoni mwananhulumyana waJohani unondida na?”</para>
  <para style="p" vid="JHN 21:16">Wakati kwaali, “Eya Tezi, unoziba kuti ndokuda.”</para>
  <para style="p" vid="JHN 21:16">Wakati kwaali, “Yembela imhwizi jangu.” <verse eid="JHN 21:16" /><verse number="17" style="v" sid="JHN 21:17" />Wakati kwaali kwechitatu, “Simoni mwananhulumyana waJohani, unondida na?”</para>
  <para style="p" vid="JHN 21:17">Pita wakajiijika nokuti wakati kwaali kwechitatu, “Unondida na?” Wakati kwaali “Tezi, unoziba zwose, unoziba kuti ndokuda.”</para>
  <para style="p" vid="JHN 21:17">Jesu wakati kwaali, “Ilyisa imhwizi jangu. <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />Ndinolebesa nditi kwauli, uchintukutuku wakabezwimbajika, unda kwaunoda, koga kana wakwegula unootambunuja maboko awo, umwe unokumbajika kova ekunyamula ekusenga kwausinoda kunda.” <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />(Yezwi wakazwileba, etondejela lufu lwaalokuja Mwali nalo.) Akale mushule mezwi, wakati kwaali, ‘Nditobele.’ ”<verse eid="JHN 21:19" /></para>
  <para style="s">Jesu Noumwe Undayijwa</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />Pita wakachebuka akabona undayijwa wakabediwa naJesu ebatobela, iye wakabeligele pelyo naJesu belayila wakati, ‘‘Tezi ndiyani uchakucheta?” <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />Pita paakombona, wakati kunaJesu, “Tezi, ani unhulume yoyu?’<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />Jesu wakati kwaali, “Kana chilichido changu kuti egale ndijine ndibuye, iwi unaneni nazwo? Nditobele!”<verse eid="JHN 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23" />Iwhi yeli lyakamwalalika mubanakwaina bose, kuti undayijwa yoyu aatofa, koga Jesu aajakaleba kuti aatofa, koga wakati, “Kana chilichido changu kuti egale ndijine ndibuye, iwi uneni nazwo?”<verse eid="JHN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />Ndiye yoyu undayijwa ukumusumikija izwo yezwi zwinhu, akale wakazwikwala yezwi zwinhu, akale tinoziba kuti busumikiji bubwe ngobwechokomende.<verse eid="JHN 21:24" /></para>
  <para style="s">Kupejeleja</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />Koga pana zwimwe zwinhu zwinji zwakatiwa naJesu, ngana zwose zwakakwalwa chimwe nechimwe chazo, ndoyeya kuti inyika iyo ayijalutubula kunyamula makwalo alukwalwa.<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>