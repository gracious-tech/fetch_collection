<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">2 JN- NAMBYA TRANSLATION PROJECT</book>
  <para style="h">2 Joni</para>
  <para style="toc1">Lukwalo lwabili lwakakwalwa naJoni</para>
  <para style="toc2">2 Joni</para>
  <para style="toc3">2 Jon</para>
  <para style="mt2">Lukwalo lwabili lwakakwalwa na</para>
  <para style="mt1">JONI</para>
  <para style="imt">Matangisilo</para>
  <para style="ip">Lukwalo lwaJoni wabili lwakakwalwa nompositoli Joni mumakole angaba pakati pamakumi mashanu zwinda kuzana mushule kokuzwalwa kwaJesu. Joni aatozwileba kuti ndiye unkwali, koga unozwileba eti unkulwana. Zwilomumwa munaJoni wabili zwilotojana kasa nezwilomumwa mundebo imbuya yaJoni. Yezwi zwinobhuda pachena munzila yaanosimatija nayo indayo yaJesu kuti kube nokudanana akale nenzila yaanokwejanisa kuda Jesu nokutobela indayijo jije (Joni wabili 1.5-6, Joni 15.9-10). Kuna kudimbwa kuti Joni wakakwala Indebo Imbuya yaJoni akale namakwalo matatu Joni wotanga, Joni wabili, naJoni watatu ponshaji paakabegala muEfesasi.</para>
  <para style="ip">Lukwalo yolu, Joni wakabelukwalila tezikaji uloshalwa nabana babe. Angabe wakabeleba igubungano. Chinangwa chaJoni mukukwala yolulukwalo ndichokusungwaja igubungano akale nokulichenjeja chenjeja kubalaiji bamaniepwa.</para>
  <para style="iot">Zwilomumwa</para>
  <para style="io1">Joni unosungula lukwalo nokuleba kuti ngolwani akale nokumusa bachalutambula (Joni wabili 1:1-3)</para>
  <para style="io1">Unondilambeli esungwaja igubungano nokubakumbuluja mulawo unkulwana kasakasa (Joni wabili 1:4-6)</para>
  <para style="io1">Etobela nokuba chenjeja nezwaba layiji bamaniepwa (Joni wabili 1:7-11)</para>
  <para style="io1">Joni unopeja lukwalo lulwe nokumusa kunova kubadimbwi begubungano kwaanogala (Joni wabili 1:12-13)</para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />Imi unkulwana,</para>
  <para style="p" vid="2JN 1:1">Tezikaji wakashalwa, nabana babe, bandinoda muchokomende, kusi kuti ndoga, koga naibo bwose banoziba ichokomende, <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />pezhulu pechokomende linogala mwatili, linooba nasu kujine kube lini nalini.<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />Chipiwo, neshe, nolunyalalo zwinova kuna Mwali Tate nokuna Jesu Kristo Mwananhulumyana waTate, ngazwibe nasu muchokomende nomuludo.<verse eid="2JN 1:3" /></para>
  <para style="s">Chokomende noLudo</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />Ndakashanta kasa kuwana bamwe bana babo bekwenda muchokomende, sokulaywa kwedu naTate. <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />Akale ngweno ndinokubweta, nchindalongo kusi kuti ndikumumukwalila mulawo umpya pe, koga wakalondiya wakabelipo kuvila pakutanga, kuti tidanane. <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />Yolundilwo ludo, kuti titobele milawo yiye, ndiwo mulawu umwakawha kuvila pakutanga, kuti mugale muludo.<verse eid="2JN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />Nokuti bachengeji banji bazhala munyika, ndibo banhu banolamba kuti Jesu Kristo wakezha eli unhu. Unhu wakadai uchengeji akale unonyenyeja Kristo. <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />Bhwazulani, kuti musilashikilwe nozwamwakashingila, koga mutambule indipo izhele. <verse eid="2JN 1:8" /><verse number="9" style="v" sid="2JN 1:9" />Unhu wose unopamija akale esinoma nendayijo yaKristo aana Mwali, iye unoma nendayijo una, bose Tate noMwananhulumyana. <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />Kana umwe unhu eswika kwamuli esina indayijo yeyi, musuumuse kana kuungwinisa mungumba yenu, <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />Nokuti wose unootambula unobeshingila pamwempela naye mumishingo iye mibi.<verse eid="2JN 1:11" /></para>
  <para style="s">Mawhi Opejeleja</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />Kojoba ndili nozwinji zwandinoda kumukwalila, andidi kushingisa ipepa kana i inki, koga ndobimba kuzha kwomubona akale kolebeleka namwi tikalingana, kutila kuti kushanta kwedu kupelelele.<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />Bana bonkazwaji wechinhukaji baloshalwa bakumukumusa.<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>