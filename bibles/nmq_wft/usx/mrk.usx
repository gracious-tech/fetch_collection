<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- NAMBYA TRANSLATION PROJECT</book>
  <para style="h">Mako</para>
  <para style="toc1">Indebo Imbuya yakakwalwa naMako</para>
  <para style="toc2">Mako</para>
  <para style="toc3">Mk</para>
  <para style="mt2">INdebo iMbuya yakakwalwa</para>
  <para style="mt1">naMAKO</para>
  <para style="imt">Matangisilo</para>
  <para style="ip">INdebo iMbuya yaMako imwe yewhalo ina jimomu muChivumilano Chipya inoleba nezwobupenyu bwaKristo. Imwe nemwe yewhalo yeji inowhi, “Ivangeli” zwileba kuti “Indebo Imbuya.” Yeji whalo jakakwalwa naMateo, Mako, Luka naJoni mushule molufu lwaJesu Kristo. Indebo Imbuya yaMako ndiyo imfupi pewhalo jose ina. Akale kunoyeyelwa kuti ndiyo iwhalo yakatanga kukwalwa panajose iwhalo imbuya pakati pamakole makumi mana anegumi limwempela namana kunoswika makumi mana anamakumi mabili Jesu azwalwa. Banji bobumhizha bwewhalo jeBhayibhili banoti yeyi whalo yakakwalwa muguta LyeLoma chili chinangwa chokukutaija baKristo bechiLoma.</para>
  <para style="ip">Mako akale ezibwa ewhiJoni Mako, wakabeli unkwaina woMpositoli Paulo naBhanabhasi koga impuwo iye yakolunduka pezhulu pokusiya lwendo lwokunobhaunula iNdebo iMbuya. (Mishingo 13:13). Akale Mako wakooba nolwendo elina Bhanabhasi (Mishingo 15:37-39). Mako akale wakabezibikana sonkwaina wopelyo waPita (1 Pita 5:13). Kojoba Mako esijakabelipo zwitikana Jesu elipenyu, bobumhizha bwewhalo jeBhayibhili banodimbwa kuti Mako wakakwala zwinji zwaakabujwa naPita akale zwili izwo zwilobhata Indebo Imbuya yaMako. Mundebo yeyi Mako unosimisa butobeleji nokulayija mawhi okupela kwenyika.</para>
  <para style="iot">Zwilomumwa</para>
  <para style="io1">Mako unopachingwiniso muchikamu (Mako 1:1-13).</para>
  <para style="io1">Mako unondila mbeli eleba nezwemishingo yaJesu elimuGalileya chikamu (Mako 1:14—8:21).</para>
  <para style="io1">Unondila mbeli elebeleka nolwendo lwa Jesu ku Jelusalemu (Mako 8:22—10:52).</para>
  <para style="io1">Mako unopeja kukwala nezwa Jesu munshaji elimuJelusalema, akale nolufu nokumuka (Mako 11:1—16:8)</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">Kubhaunula kwaJoni umbabhatizi</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mateo 3:1-12</ref>; <ref loc="LUK 3:1-18">Luka 3:1-18</ref>; <ref loc="JHN 1:19-28">Joni 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Kutanga kweNdebo iMbuya yaJesu Kristo, Mwananhulumyana waMwali, <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />Sobuzwakakwalwa mumpolofita Izaya, kuwhi:</para>
  <para style="q1" vid="MRK 1:2">“Ndinotuma untumwa wangu pambeli papo,</para>
  <para style="q2" vid="MRK 1:2">unookukungubulila inzila yiyo,<verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />Iwhi lyounoshomeja mugwegulu liti,</para>
  <para style="q2" vid="MRK 1:3">‘Kungubulani inzila yaTezi,</para>
  <para style="q2" vid="MRK 1:3">lulamisani inzila yiye.’ ”<verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />Joni umbhabhatizi wakakezha mugwegulu ebhaunula umbhabhatizo wokushanduka kuti luchinyo lulekejelwe. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Banhu banji bakabeva mudunhu lyeJudiya akale nomuguta lyeJelusalema bakenda kuna Joni akababhabhatiza muJolodani belebulula zwibi zwabo.<verse eid="MRK 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6" />Akale Joni wakabembala chimbalo chobukuse bwekamela nebhanti lyebhapata munshana, wakabelya imhashu nobuchi bweshango. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Wakabhaunula eti, “mashule mwangu kunoozha umwe unesimba kupinda lyangu, wandisinokwelela kukotama kuti ndisupule unchili weshangu jije. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Imi ndakamubhabhatiza nevula, koga iye unoomubhabhatiza noMpepo uNchena.”<verse eid="MRK 1:8" /></para>
  <para style="s">Kubhabhatizwa akale nokukwejwa kwaJesu</para>
  <para style="r">(<ref loc="MAT 3:13-4:11">Mateo 3:13—4:11</ref>; <ref loc="LUK 3:21">Luka 3:21</ref>,<ref loc="LUK 3:22">22</ref>; <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Mumazhuba yayo, Jesu wakezha eva kuNazaleta mudunhu lyeGalili, akabhabhatizwa naJoni muJolodani. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Pakalepo echinobhuda muvula, wakabona idenga lizhulika, akale uMpepo waluba senjiba ubhelukila paali. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />Akale iwhi lyakava kudenga, “Iwi uMwananhulumyana wangu unodikana, nawi ndilokushantilwa kasa.”<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Pakalepo umpepo wakonsenga mugwegulu. <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />Wakagala mugwegulu mazhuba makumi mana ekwejwa naGuluzhanje, egala nemhuka jeshango, ingilozi jakondinda.<verse eid="MRK 1:13" /></para>
  <para style="s">Jesu unoshoba bavubi bana</para>
  <para style="r">(<ref loc="MAT 4:12-22">Mateo 4:12-22</ref>; <ref loc="LUK 4:14">Luka 4:14</ref>,<ref loc="LUK 4:15">15</ref>; <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Wakati asungwa Joni, Jesu wakenda kuGalili epupula iNdebo iMbuya yaMwali, <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />eti, “Unshaji wazhajikijwa bushe bwaMwali bwaswika; shandukani, mudimbwe iNdebo iMbuya!”<verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />Wakati ekwenda mumbali mwegungwa lyeGalili, wakabona Simoni elinonuna uwe Endulu, beposa ivubo mugungwa, nokuti baluba bavubi behobe. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Jesu wakati kwabali, “Nditobeleni ndomuta kuti mube bavubi babanhu.” <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Pakalepo bakasiya ivubo jabo, bakontobela.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />Wakati akwenda unshizho umfupi wakabona Jemusi, mwananhulumyana waZebhediya naJoni ununa uwe, beli mubwato benamatija ivubo. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Pakalepo, wakabashoba, bakasiya tate babo Zebhediya mubwato belinozwishingi, ibo bakontobela.<verse eid="MRK 1:20" /></para>
  <para style="s">Unhulume una umpepo umbi</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luka 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Bakenda kuKapenaumi, nezhuba lyeSabata, pakalepo bakenda kusinagogi Jesu akalayija. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Bakashamiswa nokulayija kukwe, nokuti wakabalayija sonhu unesimba, esinota sabakwali.<verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />Pakalepo musinagogi lyabo mwaluba nonhu wakabeli nompepo umbi, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />wakashomeja eti “Tinani nawi Jesu weNazaleta? Wezha kotipalaja isu. Ndinokuziba kuti ndiwi aani: Unchena waMwali!”<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />Koga Jesu wakonkalalila, eti: “Whilijila, bhuda mwaali”<verse eid="MRK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26" />Umpepo umbi wakonsuntula, ukalila newhi lyopezhulu, ukabhuda mwaali. <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />Banhu bose bakachenama bakatanga kubhuzana beti: “Ini yezwi? Indayijo impya na yeyi? Inesimba lyokukalalila umpepo umbi akale uuwhilila!” <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />Pakalepo inyaya yezwo zwaakata, yakawhika kumapazu ose enyika yeGalili.<verse eid="MRK 1:28" /></para>
  <para style="s">Jesu unochija banhu banji</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mateo 8:14-17</ref>; <ref loc="LUK 4:38-41">Luka 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Pabakabhuda musinagogi, bakangwina mungumba yaSimoni naEndulu, beli naJemusi naJoni. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Amezwale baSimoni bakaba belilele belwala bepisa umbili. Pakalepo Jesu wakabujwa nezwabo. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Wakenda kwabali akababhata luboko, akabamusa bulwaji bukava bwapela. Bakamilika bakabashingila.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />Madekwana, izhuba limila, bakabuza kwaali bose banolwala naabo banamadimoni. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Iguta lyose lyakabungana pankoba. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Wakachija banji bakabelwala malwaji alosiyanasiyana, akabhisa madimoni; aajakavumija madimoni kuti elebeleke, nokuti akabeziba kuti Jesu ndiyani.<verse eid="MRK 1:34" /></para>
  <para style="s">Jesu unopupula muGalili</para>
  <para style="r">(<ref loc="LUK 4:2-44">Luka 4:2-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Kumijelo, kuchi kutema, wakamuka akabhuda, akenda kubugalo busina banhu, akanonamata kwakale. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Simoni naabo baluba naye, bakontobela, <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />pabakati bongwana Jesu, bakati kwaali, “Bose banhu bakumukupota.”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />Asi Jesu wakati kwabali, “Andeni kunaimwe misha kuti ndinopupula kwakaleko nokuti ndizwo zwindakezhila.”<verse eid="MRK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39" />Wakakwendela iGalili yose ebhaunula mumasinagogo abo, akale ebhisa madimoni.<verse eid="MRK 1:39" /></para>
  <para style="s">Jesu unolapa unhulume</para>
  <para style="r">(<ref loc="MAT 8:1-4">Mateo 8:1-4</ref>; <ref loc="LUK 5:12-16">Luka 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Unhu unamapelembuji wakenda kwaali, akafhigama pambeli pape, akabweta kwaali eti, “Kana uda, ungandishampuluja.”<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />Jesu wakonwhileshe, akatambunuja luboko lulwe, akonguma, akati kwaali, “Ndinoda, cheneswa.” <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Pakalepo mapelembuji akava apela, akashambijika. <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />Jesu wakondaya, akoondeka akenda. <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />Akati kwaali, “Whilila, usibuje unhu, koga inda unozwitondejela kuntebuji, akale upile untebulo wokushampulujwa kukwo, sechisumikijo chokuchila kuko sokulaya kwaMozesi.”<verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />Wakabhuda akabuja banhu banji epupula, inyaya yiye yakawhikwa nabanhu banji zwikatisa kuti Jesu wakaba esichinotubula kungwina muguta, asi wakenda kubugalo bokuzhe kwamakuta, koga banhu bakenda kwaali, beva kumapazu wose.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">Jesu unochija unhulume unabukosha</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mateo 9:1-8</ref>; <ref loc="LUK 5:17-26">Luka 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Akale kwapinda mazhuba mashoma, akabuya muKapenaume banhu bakawha kuti umomungumba. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Banhu banji bakabungana panhupamwempela zwokuti kwakashayikana bugalo, kana nopankoba pose; iye wakapupula iwhi kwabali. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Bakezha kwaali, banhulume bana, bekanyamula igosha. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Pabakakonwa kuswika paali pezhulu pedupwa lyabanhu bakafukunyula idenga paaluba eli; pabakafukunyula idenga bakangwinisa, bushasha pakabelilele igosha. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Jesu paakabona kudimbwa kwabo, wakati kugosha “mwananhulumyana luchinyo lulo lwalekejelwa.”<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />Feno bamwe bakwali baluba bakagala pakalepo beyeya mumyoyo yabo, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“Ani ndiyani yoyu unhulume unotuka Mwali? Ndiyani angalekejela luchinyo kuzhe kwaMwali ega!”<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />Koga pakalepo Jesu wakaziba mumpepo uwe kuti kuna banoyeya alo pakati pabo, wakati kwabali, “Ini muyeya yezwi mumyoyo yenu? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Ngezwipi zwilelu kuleba kugosha kuti zwibi zwizwo zwalekejelwa kana kuti milika utole unseme uwo ukwende? <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Koga kuti muzibe kuti mwananhulumyana woNhu unesimba penyika lyokulekejela luchinyo penyika. <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />Ndinoti kwauli tola unseme uwo, unde kungumba kuko.”<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />Wakamilika, nokukambija akatola unseme uwe akenda pazhe mbeli kwabo bose; bakashama bakakuja Mwali beti, “atijanhu tabona zwakadai!”<verse eid="MRK 2:12" /></para>
  <para style="s">Jesu unoshoba Levi</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mateo 9:9-13</ref>; <ref loc="LUK 5:27-32">Luka 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Wakabhuda kabili akenda kugungwa; banhu bose bakenda kwaali akabalayija. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Wakati epinda, wakabona Levi mwananhulumyana waAlufiyasi eligele panolipiswa akati kwaali, “Nditobele.” Wakamilika akontobela.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />Ngweno zwakatikana kuti, batelesi banji nabachinyi bakabelimukulya naJesu nabatobeli babe, nokuti baluba belibanji bakontobela. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Bakwali nabaFalisi pabakombona elya nabatelesi nabachinyi, bakati kubalayijwa babe, “Ani ini elya nabatelesi nabachinyi?”<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />Jesu paakawha yezwi, wakati kwabali, “Yabo banabuchilo abatoda undapi koga yabo banolwala ndibo banounshaka; Andijakezha koshoba balolulama, koga bachinyi.”<verse eid="MRK 2:17" /></para>
  <para style="s">Umbhuzo pezhulu pokukwija kulya</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mateo 9:14-17</ref>; <ref loc="LUK 5:33-39">Luka 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Batobeli baJohani naba Falisi baluzwiminya kulya, bakenda bakati kuna iye, “Ini batobeli baJoni nabatobeli babaFalisi kulya koga batobeli babo abatozwiminya kulya na? ”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />Jesu wakati kwabali, “Zwinota na kuti bezi bonhulume ukumuchada ekwije kulya iye ukumuchada elinabo?” Bangobeli naye wechinhulumyana ukumuchada pakati pabo abangakwije kulya. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Koga anozha mazhuba yoyu unhulumyana paachobhiswa pakati pabo, ndipo pabachozwiminya kulya.<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />“Apana unhu unofumila uncheka umpya pechimbalo chantolo, angodalo uncheka umpya unoshakaja wantolo kova ujeluka kasa. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />Apana unhu unodila iwaini impya munkabo wantolo, angodalo iwaini inokwamula unkabo kova ikutuka, asi iwaini impya inodilwa muhobhodo yebhapata ibhya.”<verse eid="MRK 2:22" /></para>
  <para style="s">Umbhuzo pezhulu peSabata</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mateo 12:1-8</ref>; <ref loc="LUK 6:1-5">Luka 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Ngweno zwakatikana kuti pabakakwenda mukati mominda wezwilyo nezhuba lyeSabata batobeli baluba bekwenda bevuna misholo yezwilyo. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />BaFalisi bakati kuna iye, “Lingani, ini beta yezwi zwisakalulama nezhuba lyeSabata!”<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />Iye wakati kwabali, “Amujakabala zwakatiwa naDavidi, wakabeshaka lubhancho elinezhala iye nabo baluba naye, <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />kuti wakenda chini mungumba yaMwali mumazhuba aAbhiyata, wakabeli untebuji unkulwana, akalya chinkwa chisakabevumijwa kulyiwa kuzhe kwabatebuji akale wakapa bamwe baaluba eli nabo.”<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />Akale wakati kwabali, “ISabata yakatilwa unhu; unhu aajakatilwa iSabata; <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />nezwo Mwananhulumyana wonhu ndiShe weSabata.”<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">Unhulume unaluboko lulokokonyala</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mateo 12:9-14</ref>; <ref loc="LUK 6:6-11">Luka 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Jesu wakangwina akale muSinagogi, kwakabeli nonhulume wakabakakokonyala luboko. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />BaFalisi bakondingisisa, bedakubona kuti uchonchilisa nezhuba lyeSabata, beda kuumpa undandu. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />Jesu wakati kunhulume woluboko lulokokonyala, “Izha yopano.” <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />Wakati kwabali, “Zwilokwelela ngezwipi kuta zwibuya nezhuba lyeSabata kana kuta zwibi? Kuchija kana kubulaya?”</para>
  <para style="p" vid="MRK 3:4">Apana wakadabila. <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />Wakabalinga bose akanyema akaba neshungu ebona bukukutu bwemyoyo yabo, wakati kunhulume ,“Tambunuja luboko lulo.” Wakatambunuja luboko lukakololoka. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />Pakalepo baFalisi bakabhuda bakenda kunogowana naba Helodi, bepyanga inzila yokuuncheta.<verse eid="MRK 3:6" /></para>
  <para style="s">Luvute kumbali kweGungwa</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Jesu nabatobeli babe bakabhuda bakenda kugungwa; Banhu banji bokuGalili nabo kuJudiya bakontobela, <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />nabokuJelusalema, nabokuIdumiya nabakava museli mweJolodani, nabokuTaya neSidoni bakezha belibanjibo kowha zwinhu zwaakabata. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />Wakabuja balayijwa babe kuti belonganyile bwato bwokushingisa, kuti luvute lwabanhu lusumpwanyilile; <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />nokuti wakachija banhu banji, nezwo bose bakabeli namalwaji bakomanikija beda kuunguma. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Mipepo mibi yakabeti ingombona yakabewila pasi ishobelela iti, “lwi uMwananhulumyana waMwali.”<verse eid="MRK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12" />Wakaba eyinyalaja, kuti isibuje banhu nozuzwe.<verse eid="MRK 3:12" /></para>
  <para style="s">Jesu unoshala baPositoli igumi nababili</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mateo 10:1-4</ref>; <ref loc="LUK 6:12-16">Luka 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Feno wakatanha mudunhu akashobela kwaali sokuda kukwe bakenda kwaali. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />Pakalepo wakashala bali gumi nababili, kuti bebenaye akale kuti ebatume kunopupula, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />akale kuti ebape masimba okutata mipepo mibi.<verse eid="MRK 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16" />Yaya ndiwo mazina abaligumi nababili baakashala; Simoni wakonshoba kuti ndiPita <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />Jemusi mwana waZebhedi nonuna uwe Joni baakashoba eti Bhonajisi, zwinoleba kuti Banabanhulumyana Bontimbo; <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />naEndulu, naFilipu, naBhatilomeyo, naMateo, naTomasi, naJemusi mwananhulumyana waAlufiyasi, naTadeyosi, naSimoni unKenani, <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />naJudasi Isikaliyoti, uli iye wakoncheta.<verse eid="MRK 3:19" /></para>
  <para style="s">Jesu naBhelizabhalu</para>
  <para style="r">(<ref loc="MAT 12:22-32">Mateo 12:22-32</ref>; <ref loc="LUK 11:14-23">Luka 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Wakenda kungumba, asi banhu banji bakabungana kabili, nezwo abajakaba nonshaji wokuti belya. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Banakwaina babe pabakazwiwha yezwi bakenda kuti benontola nokuti banhu bakabeti, “Unopenga!”<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />Bakwali bakava kuJelusalema bakati ,“unanaBheluzabheli unchinda wamadimoni, ndizwo ebhisa madimoni.”<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />Wakabashobela kwaali akalebeleka nabo eshingisa unkwejaniso akati, Guluzhanje angatatamila chini Guluzhanje? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Kana bushe bulwisana bwogabwoga, yobo bushe abungasime. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />Kana imhuli isakabhatana ili mumakapo anolwisana, yeyo imhuli aingasime. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Kana Guluzhange angozwikamula mumakapo mabili, apana kwanonda unopalala.<verse eid="MRK 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27" />Apana unhu angangwina mungumba, mweni elimo, kova etola zwibiya madilo, yezwi zwingatikana chete, kana mweni asungililwa, ndipo paangatole zwibiya mumba.<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />Chokomende ndinomubuja banhu banolekejelwa zwose zwibi nokutuka kwabanota, <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />koga ani nani unotuka uMpepo uNchena aatowana lulekejelo nokuti waaba noluchinyo lusinopela. <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />Nokuti bakabeti una nolupepo lubi.<verse eid="MRK 3:30" /></para>
  <para style="s">Amai nabanuna baJesu</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mateo 12:46-50</ref>; <ref loc="LUK 8:19-21">Luka 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Pakalepo amai baJesu nabanuna babe bakaswika bakama pazhe, bakatumila iwhi kuti bonshobe. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Bakabeli naye mungumba bakombuja kuti mai babo nabakazwaji babo bechinhulume bakumukushaka.<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />Iye wakabashandula eti “amai bangu ndiyani? kana kuti banuna bangu ndibapi?” <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />Wakalinga luvute lwabanhu bakaba konkomboloja akati, “yaba ndibo amai bangu, yaba ndibo banuna bangu. <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Iye unota chido chaMwali ndiye ununa wangu, ndiye unkazwaji wangu akale ndiye amai bangu.”<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">Unkwejaniso wombyali</para>
  <para style="r">(<ref loc="MAT 13:1-9">Mateo 13:1-9</ref>; <ref loc="LUK 8:4-8">Luka 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />Akale wakatangisa kulayija elikumbali kwegungwa. Ibunga lyabanhu lyakabunganila kwaali, nezwo wakangwina mubwato akagala mukati, banhu bose belimile penyika kumbali kwegungwa. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Wakabalayija zwinhu zwinji eshingisa mikwejaniso, wakalayija eti,<verse eid="MRK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3" />Whililani! umbyali wakenda kunobyala imbeyu. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />Paakabemezha, imwe imbeyu yakambwelela munzila, inyuni jikezha jikailya. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Imwe imbeyu ikambwelela pamwala unevu ishoma, yakakambijisa kumela, nokuti ivu lyakabeli ishoma. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />Izhuba palyakapisa, imbeyu yakapya ikakoma, nokuti aijakabeli nemiji. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Imwe imbeyu yakambwelela muvu linemimiwha, nokudalo yakakubuka mimhiwa ikazunda imbeyu ikakonwa kuzwala. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Imwe imbeyu yakambwelela muvu ibuyanana, ikamela ikaba unshonga umbuyanana, wakazwala kumwe makumi matatu, kumwe makumi mashanu anegumi, kumwe izana.<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />Wakati, “Yoyo unenzebe jowha ngewhe.”<verse eid="MRK 4:9" /></para>
  <para style="s">Chinangwa chonkwejaniso</para>
  <para style="r">(<ref loc="MAT 13:10-17">Mateo 13:10-17</ref>; <ref loc="LUK 8:9">Luka 8:9</ref>,<ref loc="LUK 8:10">10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Aba ega bakabeli naye nabo baligumi nababili bakombhuza nonkwejaniso yoyu. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Wakati kwabali, “Imwi mulopiwa kuti muzibe isiswa lyechichenamiso chobushe bwaMwali,” koga bamwe bose baiko kuzhe, zwose banozwiwhila mumikwejaniso, <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />kutila kuti kubona bangabona koga besino bonesesa,</para>
  <para style="q1" vid="MRK 4:12">kuwha bangawha koga besinowhisisa,</para>
  <para style="q2" vid="MRK 4:12">kuti besishanduke, besinolekejelwa</para>
  <para style="q1" vid="MRK 4:12">zwibi zwabo.<verse eid="MRK 4:12" /></para>
  <para style="s">Jesu unopandulula nezwonkwejaniso wombyali</para>
  <para style="r">(<ref loc="MAT 13:18-23">Mateo 13:18-23</ref>; <ref loc="LUK 8:11-15">Luka 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Wakati kwabali, “Amujawhisisa na unkwejaniso yoyu? Mungaiwhisisisa chini yose mikwejaniso?” <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Umbyali unobyala iwhi. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Yaba ndibo bananga sembeyu yakambwelela munzila, mulyakabyalwa iwhi, kana beliwha, pakalepo Guluzhanje unoswika nokambija kova elibhisa iwhi lyabyalwa munaibo. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Imbeyu inombwelela pamwala ndibo yaba, banoti bangoliwha banolitambula pakalepo nolushanto; <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />asi pezhulu pokusoba nemiji, banoba nalyo kwonshaji unshomanana, koga kungoba namasheto pakalepo banowa. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Bamwe bananga semhuji jinobyalwa mumiwha, ndibo banowha iwhi, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />asi nokulakamila zwenyika, nobuchengeji bwobufumi nokuchiba nezwimwe zwinjinji zwinozunda iwhi kova bekonwa kuzwala michelo. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />“Koga yaba bakabyalwa muvu ibuyanana ndibo banowha iwhi kova belitambula akale kova bezwalwa michelo, bamwe makumi matatu, bamwe makumi mashanu anegumi nabamwe izana.”<verse eid="MRK 4:20" /></para>
  <para style="s">Chimuniko chilofukwa nechitundu</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luka 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />Wakati kwabali, “Chimuniko chinotutumiswa kova chifukwa nechitundu na kana kubigwa mudako lyobushasha? Koga achitobigwa pechitala na? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Apana chilosisika chisinobhisilwa pachena, akale apana chichagala lilisiswa koga chichabigwa pachena. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Yoyo unenzebe jinowha, ngewhe.”<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />Wakati kwabali, “Muchenjele pana zwamunowha; lubazho lwamunoshingisa ndilwo luchashingiswa kwamuli; kwamuli zwichapamhijwa. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />Nokuti kunooyo unazwinhu, unoopamhijilwa zwimwe; koga yoyo usina chaananacho, noozo zwana nazwo unozwitolelwa.”<verse eid="MRK 4:25" /></para>
  <para style="s">Unkwejaniso wemhuji inokubuka</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Wakati akale, “Bushe bwaMwali bunanga unhu wakamezha imbeyu munda, <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />kova elala, emuka busiku namasikati, imbeyu iyo kova imela ikubuka, iye esina luzibo kuti zwimutikana chini” <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Inyika iyo nokwayo inozwala michelo, kunotanga unshonga, kutobela mwangala, nokuyiva kwezwilyo. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />Pakalepo zwingoyiva, unotola chibaza evune nokuti unshaji wokuvuna waswika.<verse eid="MRK 4:29" /></para>
  <para style="s">Unkwejaniso wemhuji yemasitadi</para>
  <para style="r">(<ref loc="MAT 13:31">Mateo 13:31</ref>,<ref loc="MAT 13:32">32</ref>,<ref loc="MAT 13:34">34</ref>; <ref loc="LUK 13:18">Luka 13:18</ref>,<ref loc="LUK 13:19">19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Wakati akale, “Bushe bwokudenga tingabukwejanisa neni, kana kuti tingashingisa upi unkwejaniso” <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />Bunanga semhuji yemasitadi, painobyalwa muvu, inhukutuku kumhuji jose jomunyika; <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />“Koga ingobyalwa, inokubuka kuba unti unkulwana kupinda miti yose, utukoba nenhabi ihulwana, kuti inyuni jedenga jigale muntuzi wawo.”<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />Wakashingisa mikwejaniso minji mukulebeleka iwhi, zwikwendelana nokuwhisisa kwabo; <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />aajakalebeleka nabo esashingisa unkwejaniso asi baba boga nabalayijwa babe walusobapandululila zwose.<verse eid="MRK 4:34" /></para>
  <para style="s">Jesu unonyalaja ibhepo mugungwa</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mateo 8:23-27</ref>; <ref loc="LUK 8:22-25">Luka 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Madeko ezhuba lyakalelo, wakati kwabali, “Ngatitalukileni kunelimwe ibhazu.” <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />Pabakasiya luvute lwabanhu, bakongwinisa mubwato kuli nobumwe bwato. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Kwakezha ibhepo igulwana makampo akapamula bwato, bwato bukazhala ivula. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Wakabeli mushule mobwato elilele ponchegelo; bakomusa, bakati kwaali, “Ndayiji amuneshungu na kuti talebopalajwa” <verse eid="MRK 4:38" /><verse number="39" style="v" sid="MRK 4:39" />Wakamuka akalikalalila ibhepo, akati kugungwa, “Nyalala!” Ibhepo lyakama, kukaba nokuwhilijila kukulwana <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />Wakati kwabali, “Ini muli nolutyo ali? Neni musinodimbwa”<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />Bakatya zwikulugulu bakati kunomwe nomwe, “Ndiyani yoyu unowhililwa nebhepo negungwa”<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">Jesu unochilisa unhulume unampepo umbi</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mateo 8:28-34</ref>; <ref loc="LUK 8:26-39">Luka 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Bakavubukila museli lyegungwa, munyika yamaGenesaleti. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Ebhuluka chete mubwato, pakalepo wakashangana nonhulume wakabebhuda kumakumbu eli nompepo umbi, <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />yoyu unhulume wakabegala kumakumbu, apana unhu wakabetubula kunsunga, kana namaketani; <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />nokuti wakabesungwa kanjinji neminchili namaketani, asi wakabesupula maketani, minchili edubula zwibhimpi zwibhimpi; apana kana umwempela unhu waluntubula. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Busiku namasikati walusowanika kumakumbu nomumatunhu ekwiila elikumuzwicheka namabwe.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />Paakabona Jesu echikule, wakalabukila kwaali akonkuja; <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />wakashomeja newhi lipo pezhulu akati, “Jesu mwana waMwali uPezhuluzhulu uneni nami? Ndakubweta muzina lyaMwali kuti usindishetese” <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Nokuti iye wakati kwaali, “Iwi mpepo umbi bhuda munhu yoyu.”<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />Jesu wakombhuza kuti, “Izina lilyo ndiwi ani?” Wakashandula eti “Izina lyangu ndimi Legiyoni, nokuti tibanji” <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />Wakombweta ekumbila kuti esiyibhise muneyo inyika. <verse eid="MRK 5:10" /><verse number="11" style="v" sid="MRK 5:11" />Kwakabeli nedanga lyengulube jakabechela mudako lyedunhu, <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />mipepo mibi yakonkumbila iteteja, iti, “Tisengeni mungulube, tingwine munaijo.” <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />Nokudalo wakaivumila. Mipepo mibi yakabhuda ikanongwina mungulube; idanga lyose, jakabeswika kuzwiulu zwibili, lyakalabuka namasimba likashotoka pebhilipili lingwina mugungwa jikanwila ndondwe mugungwa.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />Balyisi bakatizha, bakabuja banhu muguta, nomumisha. Luvute lwabanhu lwakenda kunobona zwakatikana. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Bakezha kunaJesu, bakabona unhu wakabeli nemipepo mibi minji, eligele zwanana akale akambala, indangalilo jije jili pamwempela; ibo bakatya. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Ibo bakabona zwitikana bakababuja muzwakatikanila kunoyo wakabeli nemipepo mibi, nezwakatikana kungulube.<verse eid="MRK 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 5:17" />Bakonteteja Jesu kuti ebhude mubugalo bwabo.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />Paakabengwina mubwato, yoyo wakabeli nemipepo mibi wakakumbilisisa kuna iye kuti ebe naye.<verse eid="MRK 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 5:19" />Koga aajakomvumila, akati kwaali, “Inda kusha kuko kubakwaina babo unobabuja zwawatilwa naShe, nokuti wakuwhila ishe chini.”<verse eid="MRK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 5:20" />Wakenda akatanga kubuja banhu muDikapolisi, zwakatilwa naJesu, bose bakachenama.<verse eid="MRK 5:20" /></para>
  <para style="s">Mwananhukajana waJailosi nonhukaji wakaguma ishashiko yaJesu</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mateo 9:18-26</ref>; <ref loc="LUK 8:40-56">Luka 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Jesu paakataluka igungwa ebwilila museli eli mubwato, kwakezha kwaali ibunga lyabanhu; iye wakabeli kumbali kwegugwa. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Umwe wabatungamili besinagogi, izina lilye ndiJayilosi, paakabona Jesu wakawila kumakumbo awe, <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />Wakombweta eteteja eti, “Mwananhukajana wangu umulwalila kufa. Izhani mumbige maboko enu pezhulu pape, kutila kuti echile ebe nobupenyu.”<verse eid="MRK 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24" />Wakenda naye, ibunga lyabanhu lyakontobela liunsundikija.<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />Kwakabeli nonhukaji wakabeli nobulwaji bwokubhuda ilopa kwamakole igumi linamabili, <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />wakabahetela nokulapwa nabalapi banji, ashingisa yose ifuma yiye koga azwijakombancha chinhu, asi bulwaji bwakakubuka. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Wakati awha nozwaJesu, akezha nokushule kukwe mubuta lyabanhu akabhata zwimbalo zwizwe. <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />Wakati, “Ndingobhata chete zwimbalo zwizwe, ndochila.”<verse eid="MRK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29" />Pakalepo ilopa lyakama; iye akawha mumbili uwe kuti wachijwa. <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />Pakalepo Jesu wakaziba kuti isimba lyabhuda mwaali, wakachingunuka kubuta lyabanhu, akati, “Ndiyani wabhata zwimbalo zwangu? ”<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />Balayijwa babe bakati kwaali, “Mubweni luvute lwabanhu lulimusundikijana pamuli, kova mubhuza kuti ndiyani wandiguma? ”<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />Wakalingalinga kuti ebone kuti ndiyani wombata. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />Wechinhukaji, noluzibo kuti ini zwatikana kwaali, wakezha eli nolutyo eluluma akawila mbeli kwaJesu akombuja ichokomende lyose. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Wakati kunaiye, “Mwananhukajana, kudimbwa kuko kwakuchija; inda mulunyalalo wachila mubulwaji bubo.”<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />Echinolebeleka, kwakaswika bakava kungumba yonkulwana wesinagogi, bakati “Mwananhukajana wenu washayika. Muchinonyajilani undayiji?”<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />Jesu paakawha zwakalebwa wakati kunkulwana wesinagogi, “Usitye koga dimbwa chete.” <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />Aajakavumila bamwe kuzhe kwaPita, Jemusi naJoni wanozwalwa naye kuti bontobele. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Paakaswika pengumba yonkululwana wesinagogi wakabona idupwa lyabanhu lita izhoba, nokukwiila kasa. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Paakangwina mukati wakati kwabali, “Igwilakwila ngilyeni? Mwananhukajana yoyu ulele aajafa.”<verse eid="MRK 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40" />Bakonseka. Wakababhisila pazhe, akatola tate naamai bomwana naabo bakabekwenda naye bakangwina mumba mwakabelilele mwana. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />Wakabhata luboko lwomwananhukajana akati kwaali, “Talita Kumi” Zwingoshandulwa zwinoleba kuti “ Nsichana ndinoti kwauli imuka.”<verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />Pakalepo mwanansichana wakamuka akakwenda, (wakabeli namakole igumi namabili) bakashama zwikulugulu. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Wakabalayila nesimba kuti zwisizibikane zwatikana akababuja kuti bompe zwokulya.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">Jesu unolambwa kuNazaleta</para>
  <para style="r">(<ref loc="MAT 13:53-58">Mateo 13:53-58</ref>; <ref loc="LUK 4:16-30">Luka 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Wakabhuda paakabeli akenda kuguta lyokunaibo, batobeli babe bakontobela. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Nezhuba lyeSabata wakatanga kulayija muSinagogi; banji bakonwha bakashama beti, “Yoyu unhulume wakazwiwana kupi zwinhu yezwi?” Akale buchenjevu yobu wakabupiwa nani? Nemishingo inesimba inotiwa namaboko awe! <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />Yoyu aatoba iye na, umbezhi mwananhulumyana waMaliya, akale unkulu waJemusi, naJosesi, naJudasi naSimoni, akale bakazwaji babe abaipo yopano nasu?. Bakonyemela.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />Jesu wakati kwabali, “Umpolofeti aatolemekejwa munyika yiye, mumakamu awe nomungumba yiye.”<verse eid="MRK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5" />Aajakata mishingo inoshamisa kuzhe kwokubiga maboko awe pezhulu pabashoma banolwala akabachija. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Wakachenamiswa pezhulu pokusodimbwa kwabo akenda mumizi elayija.<verse eid="MRK 6:6" /></para>
  <para style="s">Jesu unotuma balayijwa baligumi nababili</para>
  <para style="r">(<ref loc="MAT 10:5-15">Mateo 10:5-15</ref>; <ref loc="LUK 9:1-6">Luka 9:1-6</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7" />Wakashoba igumi lina babili kuti bebuye kwaali, akatanga kubatuma babili nababili, akabapa isimba pezhulu pemipepo mibi. <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />Wakabalayila kuti besinyamule chinhu palwendo kana ini zwazwo, kuzhe kwoludozo; besitole chinkwa, kana chikwama, kana chinemali; <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />koga bembale zwikwabaila besimbale ishashiko imbili. <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Wakati kwabali, “Pose pamunongwina mungumba, galani mwakale kuswika mwabhuda. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />Pose pamusinotambulwa akale belamba kumuwha, kana mubhuda pabali, mukuhumule ihuluba pasi kwamakumbo enu sobusumikiji kwabali.”<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />Bakabhuda bakenda bepupula kuti banhu banokwelela kushanduka. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />Bakabhisa mipepo yamadimoni bakaguba banhu namafuta, banji balulwala bakachijwa.<verse eid="MRK 6:13" /></para>
  <para style="s">Lufu lwaJohani umbhabhatizi</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mateo 14:1-12</ref>; <ref loc="LUK 9:7-9">Luka 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />She Helodi wakawha nozuzwe; nokuti izina lyaJesu lyaluzibikana. Bamwe bakati “Joni umbhabhatizi wamuka kubafi; ndizwo yaya masimba amushinga mwaali.”<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />Asi bamwe bakati, “NdiElija.”</para>
  <para style="p" vid="MRK 6:15">Bamwe bo bakati, “Umpolofeti unanga sabamwe bapolofeti bantolo.”<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />Koga Helodi paakazwiwha wakati, “Joni wandakadumula unsholo wamuswa.” <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />Helodi nokukwe ndiye wakabiga Joni muntolongo pezhulu paHelodiyasi unkaji wonuna uwe Filipu nokuti wakalobola unkaji wonuna uwe. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Nokuti Joni wakabati kuna Helodi, “Azwipo pamulawu kuti iwi utole unkaji wonuna uwo.”<verse eid="MRK 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19" />Nezwo Helodiyasi wakombenga akada kuumbulaya. Koga aajakatubula, <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />nokuti Helodi wakontya Joni, eziba kuti unhu umbuya akale unchena, akava ondondota zwibhodo. Wakati onwha elebeleka, wakaba elangalila kasa, koga onwha nolushanto.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />Koga lyakaswika izhuba lyakakwelela, nezhuba lyokuzwalwa kukwe Helodi wakatila mabhiko makolokota awe, bakulwana babanhu nababhati bakulwana bomuGalili. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />Mwananhukajana waHelodiyasi wakazana zwakashantisa Helodi nabezi babe. She wakati kunhukajana, “Ileba kana ini chaunoda ndokupa.” <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Wakakowha kwaali akati, “Ndokowha kuti chaunokumbila chose kwandili ndokupa, kungaba iganta lyobushe bwangu.”<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />Wakenda kuna amai babe akati, “Ndingakumbilani na?” Bakashandula beti, “Unsholo waJoni umbhabhatizi.”<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />Pakalepo wakakimbija kungwina kunaShe akakumbila eti. “Ndinoshaka kuti mundipe unsholo waJoni umbhabhatizi mundyilo feno.”<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />Pakalepo She wakashulubala, koga wakakonwa kulamba pezhulu pokukowha kwaakabata mbeli kwabezi babe. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />She wakatuma nokukimbija undwi akombuja kuti kubuzwe unsholo uwe. Wakenda akanoundumula unsholo muntolongo, <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />akabuza unsholo uwe mundyilo akompa unsichana; unsichana akapa amai babe. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />Balayijwa babe pabakawha bakezha bakatola umbili uwe bakonjika, mugumbu.<verse eid="MRK 6:29" /></para>
  <para style="s">Jesu unopa kulya zwiulu zwishanu</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mateo 14:13-21</ref>; <ref loc="LUK 9:10-17">Luka 9:10-17</ref>; <ref loc="JHN 6:1-14">Joni 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Bapositoli bakabungana kuna Jesu bakonzuwila zwose zwabakata nezwabakalayija. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Wakati kwabali, “Izhani tinde kubugalo bulosisika tibe toga, tinyetutukwe pashoma.” Banji bakabezha bamwe benda, yezwi zwakabakashayisa unshaji kana wokulya. <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />Bakenda nobwato kubugalo busina banhu, beli boga.<verse eid="MRK 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33" />Banhu banji bakababona benda, bakonziba bakalabukila kwakale beva mumizi yose, bakabatangila kuswika kwakale. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />Wakati abhuda, wakabona banhu banji akabawhila ishe, nokuti bakaba beli semhwizi jisina uncheji; wakatanga kubalayija zwinhu zwinji kasa. <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />Unshaji pawakapela, balayijwa babe bakezha kwaali bakati, “Timo mushango lisina banhu akale unshaji wapela, <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />Babujeni bende kumakuta nokumisha, benozwitengela zwokulya.”<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />Koga wakashandula akati kwabali, “Imwi bapeni zwokulya.”</para>
  <para style="p" vid="MRK 6:37">Bakati kwaali, “Tinde kunotenga zwinkwa zwemali inoshoba mazana mabili amasheleni, tibape belye kani?”<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />Wakati kwabali, “Zwingana zwinkwa zwamuna nazwo? Indani munolinga.”</para>
  <para style="p" vid="MRK 6:38">Pabakaziba bakati kwaali, “Zwishanu nehobe imbili.”<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />Wakabuja kuti begajike banhu bose pasi mumakapo pobuhwa bunyolo. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Bakagala pasi mumakapo abanhu izana, bamwe makumi mashanu. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Feno wakatola zwinkwa zwishanu nehobe imbili akalinga kudenga akaboka, akamedula zwinkwa akapa balayijwa babe kuti bebape, nehobe imbili akajikobela bose. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Bakalya bose bakaguta. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />Baka bunganisa zwimedu zwezwinkwa muzwitundu igumi lina zwibili zwakazhajwa nehobe. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Bakalya zwinkwa baluba banhulume baluba zwiulu zwishanu.<verse eid="MRK 6:44" /></para>
  <para style="s">Jesu unokwenda pezhulu pevula</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mateo 14:22-33</ref>; <ref loc="JHN 6:15-21">Joni 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Pakalepo wakababuja balayijwa babe kuti bengwine mubwato, kuti bende museli kuBhetisaida, iye esala emwayisa ibunga lyabanhu kuti linde. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Wakati amwayisa banhu kuti bende wakamilika akenda kudunhu kuti enonamata. <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />Kwaba madeko bwato bwakababa pakati nopakati pegungwa, iye eli ega penyika. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Wakababona bekakomelwa bekwendesa bwato nokuti ibhepo lyakabeshangamijana nabo. Nonshaji unanga wechina wobusiku, wakabuya kwabali ekwenda pezhulu pegungwa, wakata sofana ukumubapindilila, <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />asi pabakombona ekwenda pezhulu pegungwa bakati ishaku bakalija imhele, <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />nokuti bose bakombona bakava mwoyo. Koga iye wakalebeleka nabo nokukambija akati kwabali, “Simani myoyo, musitye ndimi.” <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Wakenda akatanha mubwato mubakabeli, ibhepo lyakanyalala; Bakakashamiswa kasa, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />nokuti abajakawhisisisa chishamiso chezwinkwa, myoyo yabo yaluba mikukutu.<verse eid="MRK 6:52" /></para>
  <para style="s">Jesu unochija banolwala kuGenesaleti</para>
  <para style="r">(<ref loc="MAT 14:34-36">Mateo 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Bakati bataluka bakaswika kunyika yeGenesaleti bakasungilila bwato mubhambo. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Pabakati babhuda mubwato banhu bakonziba pakalepo, <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />bakalabukila mubugalo bose bomwakwakale yomo bakatanga kusenga banolwala pamiseme bebasenga yoko kwabakonwha kuti ndikwo kwaali. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Mose mwaakangwina, mumisha nomumakuta, nomujinyika, bakalajika banolwala mujinzila bakombweta kuti bebhate umpeto woga wechimbalo chiche, bose bakonguma, bakachila.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">Kulayija kwamatategulu</para>
  <para style="r">(<ref loc="MAT 15:1-9">Mateo 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />Feno baFalisi bakabungana kwaali nabaKwali bakava kuJelusalema, <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />bakabona bamwe babalayijwa babe kuti bakabelya zwokulya namaboko mabi, yezwi zwileba kuti abajakabashamba maboko.<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />Nokuti baFalisi nabaJuda bose abatolya besashamba maboko belondota ingalilo yamatategulu abo; <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />akale kana bava kumusika, abatolya besanu bazwichenesa, minji milawo ibanotobeleja inanga sokushambisa mikombe, ihali nendyilo jobutale.<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />Pakalepo baFalisi nabaKwali bakombhuza beti, “Ini balayijwa benu besinotobelaja indayijo yatakapiwa namatategulu, nokuti ibo banolya besashamba maboko?”<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />Wakashandula eti kwabali, “Izaya wakapolofita pezhulu penu imwi bachengeji sezwakulokwalwa kuwhi:</para>
  <para style="q1" vid="MRK 7:6">“Banhu yaba banondikuja nemilomo yabo,</para>
  <para style="q2" vid="MRK 7:6">koga myoyo yabo iko kule nami.<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />Banondinamata zwamanyepwa,</para>
  <para style="q2" vid="MRK 7:7">belayija zwilayijo zwemilawu yabanhu!”<verse eid="MRK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8" />“Munosiya mulawo waMwali, mulondota milawu yabanhu.”<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />Wakati kwabali, “Munenzila jokulamba mulawo waMwali, mutila kuti mulondote inzila yemigalilo yenu!” <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />Nokuti Mozesi wakati, “Lemekeja tate babo namai babo akale, yoyo unolebeleka bubi pezhulu patate namai babe, chokomende ulokwelela kufa,” <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />“Koga munolayija kuti, kana unhu eti kunatate babe kana amai babe, chipi nechipi zwacho chamunowana kuva kunami chaba iKobhani (ndiko kuti chaba umpilo kunaMwali), <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />nokudalo amuchinounvumija kuti etile tate babe naamai babe chinhu, <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />nokudalo munota iwhi lyaMwali lisibe nesimba pezhulu pendayijo yemigalilo yenu. Akale zwinji kasa zwakadai zwamunota.”<verse eid="MRK 7:13" /></para>
  <para style="s">Zwinhu zwinoswibhisa unhu</para>
  <para style="r">(<ref loc="MAT 15:10-20">Mateo 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />Wakashoba akale banhu kwaali akati kwabali, “Ndiwhilileni mwose muwhisise: <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />apana chinhu chipo pazhe ponhu chinoti chingongwina mwaali chinonswibhisa; koga yezwo zwinobhuda mwaali ndizwo zwinoswibhisa unhu.” <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />(Kana kuli unenzebe jokuwha, ngaawhe)<verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />Wakati angwina mungumba, evila kubanhu, balayijwa babe bakombhuza nezwonkwejaniso yoyu. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Iye wakati kwabali, “Namwi amutowhisisa? Amubweni kuti zwose zwinongwina munhu zwiva nokuzhe azwingoswibhise, <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />nokuti azwitongwina mumwoyo uwe, koga zwinongwina muntumbu uwe, kova zwinobhudila kuzhe” (Nokuleba alo wakavumila kuti zwose zwokulya zwilyiwe)<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />Akale wakati, “Zwinobhuda mumwoyo wonhu ndizwo zwinoswibhisa unhu. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Nokuti mukati momoyo wonhu ndimo munobhuda luyeyo lubi, busangu, kukwiba, kubulaya, nokupombola, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />buchiba, kuba nomwoyo umbi, kuchengela, buhungu, kunyetela, kutuka, kuzwikuja, nobulema. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />Zwose yezwi zwibi zwinova mumwoyo ndizwo zwinoswibhisa unhu.”<verse eid="MRK 7:23" /></para>
  <para style="s">Kudimbwa kwonhukaji</para>
  <para style="r">(<ref loc="MAT 15:21-28">Mateo 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Jesu wakamilika pakalepo, akenda kunyika yeTile neSidoni. Wakangwina mungumba, aajakabeda kuti banhu bonzibe, asi banhu bakaziba. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Paluba nonhukaji waluba nomwanansichana wakaba eli nompepo umbi, paakawha nezwizwe, wakamuka nokunda kwakale, akaswika ezwiwigila pamakumbo awe. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Unhukaji yoyu waluba unGiliki, eli chizwalwa chokubugalo bunowhi Sayilofonisheni. Wakonkumbila kuti ebhise umpepo umbi mumwanansichana uwe. <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />Wakati kwaali, “Bana ngabetange kuguta, nokuti azwijilolulama kutola chokulya chabana, kova muchiposela imbwa.”<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />Unhukaji wakashandula, akati, “Eya She, koga imbwanana jinolya pasi pechitala zwimedu zwinolashwa nabana.”<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />Wakashandula akati kwaali, “Nokulebeleka kuko udalo, inda umpepo umbi wabhuda mumwanansichana uwo.”<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />Wakenda kungumba yiye, akawana mwanansichana uwe elilele pabulo, umpepo umbi wakaba wabhuda mwaali.<verse eid="MRK 7:30" /></para>
  <para style="s">Jesu unochija Machinzebe Chimumu</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Wakabuya akabhuda mubugalo bweguta lyeTaya akapinda nomuSidoni ekaswika kugungwa lyeGalili, epinda pakati penyika yeDikapolisi. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Bakabuza kwaali unhu waluba elinenzebe jisinowha akale elichimumu; bakombweta kuti ebige luboko lulwe pezhulu pape. <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />Wakontola akobhisa kubanhu, akonsengela kulosisika, wakabiga tunyala tutwe munzebe, akafhila mate, akombhata lulimi lulwe. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Wakalinga zhezhulu kudenga, akamimila, akati kwaali, “Efata,” zwileba kuti, “Zhulika!”<verse eid="MRK 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35" />Inzebe jije jakava jazhulika, lulimi luka lelupa akava atubula kulebeleka. <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />Wakababuja kuti besibuje bamwe banhu koga, paakabajibisa, iye ndipo pabakanyaya kubuja banhu. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Zwakabashamisa kasa bakati, “Zwose zwaanota zwibuya; unota machinzebe ewhe nezwimumu zwilebeleke.”<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">Jesu unopa banhu bali zwiulu zwina zwokulya</para>
  <para style="r">(<ref loc="MAT 15:32-39">Mateo 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Mumazhuba yayo, kwakaba noluvute lwakabungana koga besina zwokulya, Jesu wakashoba balayijwa babe akati kwabali, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“Ndinobawhila ishe banhu, nokuti ndagala mazhuba matatu ndilinabo koga besina zwokulya, <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />ndingoti bende kumisha yabo nezhala bamwe banozilika munzila nokuti bamwe banova kule.”<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />Balayijwa babe bakonshandula beti, “Unhu angachiwana kupi chinkwa chingabaguncha banhu mugwa yeli?”<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />Iye wakabhuza akale akati, “Munazwinkwa zwingana?” Bakati “zwishanu zwina zwibili,”<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />Wakabuja banhu kuti begale pasi; wakatola zwinkwa zwishanu zwina zwibili, akaboka, akazwimedula akapa balayijwa kuti bepe banhu; bakabakobela banhu. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Akale bakabeli nehobe inshoma; wakajikombolela, akababuja kuti bepe banhu. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Bakalya bakaguta; bakanunga tufwapi twakabesala bakazhaja zwitundu zwishanu zwina zwibili. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Bakalya bakabeswika kuzwiulu zwina. <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />Wakababuja kuti bende; pakalepo iye wakangwina mubwato nabalayijwa babe, bakenda munyika yeDalamanuta.<verse eid="MRK 8:10" /></para>
  <para style="s">BaFalisi banokumbila chishamiso</para>
  <para style="r">(<ref loc="MAT 16:1-4">Mateo 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />Kwakaswika baFalisi kwakale bakakakabajana naye bonkweja beti ebatondeje chitondejelo chokudenga. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />Wakatula ibhika akati, “Yechi chizekululu chinoshakilani chitondejelo na? Ndomubuja ilebeswa ndoti, yechi chizekululu achitoopiwa chitondejelo.”<verse eid="MRK 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 8:13" />Wakabasiya akangwina mubwato, akenda kunelimwe iseli.<verse eid="MRK 8:13" /></para>
  <para style="s">Bulungo bwabaFalisi naHelodi</para>
  <para style="r">(<ref loc="MAT 16:5-12">Mateo 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Feno bakabakanganwa kunyamula zwinkwa; bakabeli nechinkwa chimwempela chete mubwato. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />Wakabalaya eti, “Chenjelelani umfufumuso wabaFalisi, akale nomfufumuso waHelodi.”<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />Bakalebelejana beti, “Waleba yezwi nokuti atina zwokulya.”<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />Nokuziba indangalilo jabo, Jesu wakati kwabali, “Ini mulebelekesana nokusonyamula kwenu zwinkwa? Amutobona nokuwhisisa? Myoyo yenu ichi mikukutu na? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />Munamesho koga amutobona, munenzebe koga amutowha? Amutokumbulukwa pe? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />Pandakamedula zwinkwa kubanhu zwiulu zwishanu, mwakazhaja zwitundu zwingana nezwifwapi?”</para>
  <para style="p" vid="MRK 8:19">Bakati kwaali, “Igumi nezwibili.”<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />“ Akale pandakamedula zwinkwa kuzwiulu zwina mwakanunga zwifwapi mukazhaja zwitundu zwingana?”</para>
  <para style="p" vid="MRK 8:20">Bakati kwaali, “Zwishanu zwinazwibili.”<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />Akati kwabali, “Ini biya musinowhisisa?”<verse eid="MRK 8:21" /></para>
  <para style="s">Jesu unochija unhulume ibhofu peBhetisaida</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Bakaswika kuBhetisaida. Bamwe banhu bakabuza unhulume wakabeli ibhofu kwaali, bakonkwekweteja kuti ongume. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Wakabhata unhulume ibhofu noluboko, akenda naye kuzhe kwonzi; wakomfhila kumesho namate akombiga maboko pezhulu, akombhuza eti, “Ubweni chinhu na?”<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />Wakalinga zhezhulu akati “Ndibweni banhu, koga bananga semiti ikumukwendenda.”<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />Akale wakabuya akabiga maboko pamesho awe; wakalingisisa akabona zwibuyanana. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Wakonsungula kuti ende kungumba yiye akati, “Usibuje unhu munsha.”<verse eid="MRK 8:26" /></para>
  <para style="s">Lumemo lwaPita naJesu</para>
  <para style="r">(<ref loc="MAT 16:13-20">Mateo 16:13-20</ref>; <ref loc="LUK 9:18-21">Luka 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Jesu wakenda nabalayijwa babe mumizi yeSizaliya Filipu, belimunzila wakababhuza balayijwa babe eti, “Banhu banoti ndimi ani?”<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />Ibo bakashandula beti, “Joni umbhabhatizi bamwe bamuti Elija akale bamwe bamuti umwe wabapolofeti.”<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />Wakababhuza ibo akati kwabali, “Ani imwi moti ndimi ani?”</para>
  <para style="p" vid="MRK 8:29">Pita wakashandula akati kwaali, “Imwi ndimwi Kristo.”<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />Wakabalaya kuti besibuje kana unhu umwempela nozuzwe.<verse eid="MRK 8:30" /></para>
  <para style="s">Jesu unolebeleka nezwokujiijwa akale nolufu lulwe</para>
  <para style="r">(<ref loc="MAT 16:21-28">Mateo 16:21-28</ref>; <ref loc="LUK 9:22-27">Luka 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Wakatanga kubalayija kuti Mwananhulumyana woNhu, unoojiijwa zwikulwana kasa, unoolashwa nabakulwana bose, nabatungamili babatebuji, nabakwali, unoobulayiwa koga unoomuka mushule mwamazhuba matatu. <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Yezwi wakazwileba pachena. Pita wakonshobela kumbali akatanga kunkalalila. <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />Paakachebuka wakalinga balayijwa babe akakalalila Pita eti, “Guluzhanje bhuda mushule lyangu. Iwi aujikumuyeya zwaMwali, ukumuyeya zwabanhu.”<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />Wakashoba luvute nabalayijwa babe kuti bezhe kwaali akati kwabali, “Kana unhu eda kunditobela, ngaazwilambe etole unchinjikwa uwe enditobele.” <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />“Yoyo unobabalila bupenyu bubwe bunoondashikila, koga yoyo unolashikilwa nobupenyu bubwe pezhulu pangu kana pezhulu peNdebo iMbuya yangu, yoyo unoobuchija. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Zwinoumbhancha neni kuti unhu ewana zwose zwopenyika koga kova elashikilwa nobupenyu bubwe? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Unhu ini zwaangapile sendipilo yobupenyu bubwe? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />Aani naani unonditila ishoni, kana mawhi angu munechi chizekululu chobupombwe nobuchinyi, Mwananhulumyana woNhu unoontila ishoni paachezha mubushe bwaTate babe nengilozi inchena.”<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Wakati kwabali, “Chokomende ndinoti kwamuli, pana bamwe benu yopano, abatolushangana lufu, besanhu babona bushe bwaMwali buzha nesimba.”<verse eid="MRK 9:1" /></para>
  <para style="s">Kungaimiswa kwaJesu</para>
  <para style="r">(<ref loc="MAT 17:1-13">Mateo 17:1-13</ref>; <ref loc="LUK 9:28-36">Luka 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />Mushule mwamazhuba mashanu ana limwempela, Jesu wakatola Pita naJemusi naJoni, akatanha nabo pezhulu pedunhu ilefu, pabakabeli boga; ndipo paakashandulwa chimo mbeli kwabo, <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />zwimbalo zwizwe zwakangaima zwikaba zwichena kasa zwokuti akuna penyika angapopa zwimbalo zwikachena alo. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Kwakaboneka Elija naMozesi belebeleka naJesu. <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />Pita wakalebeleka akati kuna Jesu, “She, zwibuya zwatili yopano, ngatibakeni zwitumba zwitatu, chimwe chibe chenu, chimwe chaMozesi, nechimwe chaElija.” <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />Ajakaziba zwakabeleba nokuti, bakabhatwa nolutyo.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />Kwakaba negole likabafukatila, iwhi likawhika liva mugole liti “Yoyu Mwananhulumyana wangu unodikana, unwhilileni!” <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />Pakalepo pabakalinga yoku noku, apana unhu ubakabona kuzhe kwaJesu chete wakabeli nabo.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />Pabakabebhuluka idunhu, Jesu wakabalaya kuti, besibuje kana upizwe unhu nezwababona ejine Mwananhulumyana woNhu emuke kuna bakafa.<verse eid="MRK 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10" />Bakazwilondota mumyoyo yabo, bebhuzana pakati pabo kuti zwinolebani, “kumuka kubafi.” <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" />Bakombhuza bakati, “Banolebani bakwali kana beti Elija unokwelela kutanga kuswika?”<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />Wakashandula akati, “Elija unotanga kuzha kobhisa zwinhu pachena; koga zwilokwalwa chini noMwanonhulumyana woNhu unooyangata kasa akale bondambe na?” <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />“Koga ndinomubuja kuti Elija wakaswika, bakata madilo kwaali sobuzwilokwalwa nezwizwe.”<verse eid="MRK 9:13" /></para>
  <para style="s">Jesu unochija umbisana unampepo umbi</para>
  <para style="r">(<ref loc="MAT 17:14-21">Mateo 17:14-21</ref>; <ref loc="LUK 9:37-43">Luka 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Pabakati baswika pakabeli nabamwe balayijwa, bakabona idupwa igulwana lili pakalepo akale bamwe bakwali bakabe kakabajana nabo. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Pakalepo idupwa palyakabona Jesu, lyakashama kasa likezha kwaali ikomusa. <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />Wakababhuza eti, “Mumukakabajana nabo neni?”<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />Umwe mukati mwebunga wakashandula eti, “Ndayiji, ndabuza mwananhulumyana wangu kwamuli unampepo wokusotubula kulebeleka. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Kana ekabhatwa nompepo yoyu, unombwejela pasi; epupuma ifulu, eluma meno akale umbili unokakanyala; ndakakumbila balayijwa babo kuti bebhise umpepo yoyu pazhe, asi bakakonwa.”<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />Iye wakabashandula eti, “Imwi chizekululu chisinodimbwa! Biya ndigale namwi kuswikila lini? Umbuzeni kwandili.” <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />Bakombuza umbisana kwaali.</para>
  <para style="p" vid="MRK 9:20">Umpepo puwakombona, wakonsuntula umbisana akawila pasi akapupa ekungulika, epupuma ifulu. <verse eid="MRK 9:20" /><verse number="21" style="v" sid="MRK 9:21" />Jesu wakabhuza tate bombisana akati. “Waaba nonshaji undefu chini eli ali? Bakati, kuva echintukutuku.” <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />“Kanjinji unosomposela mumoto nomuvula, ukweja kumbulaya; asi kana mutubula tiwhileni ishe tibhancheni!”<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />Jesu wakati kuna iye, “Ndingata zwaandinotubula! Zwose zwinotubulika kuna iye unodimbwa.”<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />Pakalepo tate bomwana bakashomeja belila, bakati, “Ndinodimbwa, ndibhancheni pakusodimbwa kwangu!”<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />Jesu paakabona banhu bezha belabuka bebungana, wakakalalila umpepo umbi eti kwauli, “Iwi mpepo wobumumu nobuchinzebe, ndinokulaya, bhuda mwaali, usibuye kabili!”<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />Pawakashobelela nokumfundilija kasa, wakabhuda mwaali, umbisana wakaba sonhu wafa; banji bakatanga kulebeleka beti, “Wafa.” <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Koga Jesu wakombhata noluboko lulwe akonyamula, naiye akamilika.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />Wakati angwina mungumba, balayijwa babe bakombhuza pabakaba boga beti, “Isu takonwa chini kumbhisa?”<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />Wakati kwabali, “Unshobo yoyu aungabhude asi nokunamata.”<verse eid="MRK 9:29" /></para>
  <para style="s">Jesu unolebeleka akale nezwolufu lulwe</para>
  <para style="r">(<ref loc="MAT 17:22">Mateo 17:22</ref>,<ref loc="MAT 17:23">23</ref>; <ref loc="LUK 9:43-45">Luka 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Bakabhuda yopo bakenda bakapinda nomuGalili. Aajakada kuti zwizibwe nonhu; <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />nokuti wakabelayija balayijwa babe eti kwabali, “Mwananhulumyana woNhu unoopilwa mumaboko abanhu, ibo bachoombulaya; kana abulayiwa, mushule mwamazhuba matatu unoomuka.”<verse eid="MRK 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32" />Koga abajakawhisisisa kuti indayijo yiye ikumulebani, akale bakatya kuumbhuza. <verse eid="MRK 9:32" /><verse number="33" style="v" sid="MRK 9:33" />Bakaswika kuKapenaumi, pabakangwina mungumba wakababhuza eti, “Ani mwaba muzuwani mulimunzila?”<verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />Koga bakawhilijila, nokuti munzila beli boga bakaba benyenyejana kuti ndiyani unkulwana kasa kasa. <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />Wakagala pasi, akashoba baligumi namabili, akati kwabali, “Kana unhu eda kuti ebe wokutanga, ngaabe wokujibija kwabali, ebe unshingi wabo bose.” <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />Wakatola mwana, akomisa mbeli kwabo, akomfufuzhila, akati kwabali; <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />“Aani nani unotambula umwe wabana batukutuku bakadai muzina lyangu, unonditambulabo; akale wose unonditambula, aatobetambula imi, koga unotambula iye wakandituma.”<verse eid="MRK 9:37" /></para>
  <para style="s">Aani kana aani usinotilwisa ngowedu</para>
  <para style="r">(<ref loc="LUK 9:49">Luka 9:49</ref>,<ref loc="LUK 9:50">50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Joni wakati kwaali, “Ndayiji, tabona unhulume ebhisa madimoni muzina lyenu, asi toonjibisa, nokuti atoba umwe wedu.”<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />Koga Jesu wakati, “Musuundambije, nokuti akuna unhu angata zwishamiso muzina lyangu, pakalepo etanga kulebeleka bubi nami. <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />Nokuti yoyo usinolwisana nasu ngowedu. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />Chokomende ndinoti kwamuli, unhu unomupa unkombe wevula yokunwa muzina lyangu, nokuti mulibaKristo, chokomende aangalashikilwe nombhayilo uwe.”<verse eid="MRK 9:41" /></para>
  <para style="s">Kukwejwa muluchinyo</para>
  <para style="r">(<ref loc="MAT 18:6-9">Mateo 18:6-9</ref>; <ref loc="LUK 17:1">Luka 17:1</ref>,<ref loc="LUK 17:2">2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />“Yoyo unotisa umwempela waaba batukutuku banodimbwa kunami kuti bechinye, zwingaba zwibuya kuti yoyo unhu esungililwe igwiyo igulwana munchibha uwe kova iye eposelwa mugungwa. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />Akale kana luboko lulwo lutisa kuti uchinye, ludumule! zwibuya kuti iwi ungwine mubupenyu uligosha, kuna kuti ube namaboko mabili kova unda kuGehena, kumoto usinojima” <verse eid="MRK 9:43" /><verse number="45" style="v" sid="MRK 9:45" />Kana igumbo lilyo likungwinisa muluchinyo, lidumule; zwibuya kuti ungwine mubupenyu uligosha, kuna kuti ube namakumbo mabili kova uposelwa muGehena. <verse eid="MRK 9:45" /><verse number="47" style="v" sid="MRK 9:47" />“Kana izhisho lilyo litisa kuti uchinye, libhise! zwibuya kuti ungwine mubushe bwaMwali uli nezhisho limwempela, kuna kuti namesho mabili uposelwe muGehena.” <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />“Imo munegonye lisinofa, akale nomoto usinojima.”<verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />Umwe noumwe unoolungwa nomoto.<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />Munyu umbuyanana; koga kana munyu usichinolwela, biya mungomusilija chini?</para>
  <para style="p" vid="MRK 9:50">“Ibani nomunyu mukati mwenu, mugale nolunyalalo umwe nomwe.”<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">Jesu unolayija nezwokushimana</para>
  <para style="r">(<ref loc="MAT 19:1-12">Mateo 19:1-12</ref>; <ref loc="LUK 16:18">Luka 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Wakanyamuka akenda kubugalo bweJudiya, akale nomunelimwe seli lyeJolodani, idupwa lyabanhu lyakabungana kwaali akale; songalilo uwe, iye wakabalayija. <verse eid="MRK 10:1" /><verse number="2" style="v" sid="MRK 10:2" />BaFalisi bakezha bakombhuza bonkweja beti, “ Zwimo mumulawo na kuti unhulume eshime unkaji uwe?” <verse eid="MRK 10:2" /><verse number="3" style="v" sid="MRK 10:3" />Wakabashandula akale eti kwabali, “Mozesi wakamulaya ni?” <verse eid="MRK 10:3" /><verse number="4" style="v" sid="MRK 10:4" />Bakati, “Mozesi wakaba evumila kuti unhulume ekwalile unhukaji uwe lukwalo lwokunshima kova onshima.” <verse eid="MRK 10:4" /><verse number="5" style="v" sid="MRK 10:5" />Koga Jesu wakabashandula ekati kwabali. Yezwi zwakatiwa nokukoma kwemyoyo yenu, kuti emukwalile yoyu mulawo. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />Asi kuva pakutangisa kutiwa kwenyika, Mwali wakabumba unhulume nonhukaji. <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />“Zwakadalo unhulume unoosiya tate namai babe ebhataniswe nonkaji uwe, <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />yaba babili banooba inyama imwempela. Nokudalo abachili babili, koga inyama imwempela. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Nezwo, zwabhataniswa naMwali, zwisipambulanywe nonhu.” <verse eid="MRK 10:9" /><verse number="10" style="v" sid="MRK 10:10" />Belimungumba, balayijwa babe bakombhuza akale nenyaya yakaleyi. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Wakati kwabali, “Yoyo unoshima unkaji uwe, kova elobola umwe una undandu wokupombola kwaali; <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />akale kana ashima undume uwe, kova elobolwa nomwe, umupombola.”<verse eid="MRK 10:12" /></para>
  <para style="s">Jesu unokombolela bana batukutuku.</para>
  <para style="r">(<ref loc="MAT 19:13-15">Mateo 19:13-15</ref>; <ref loc="LUK 18:15-17">Luka 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Pakalepo bakabebuza bana kwaali, kuti ebagume, koga balayijwa babe bakaba kalalila. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />Asi paakazwibona yezwi Jesu, aajakanakilwa nazwo akati kwabali, “Lekani bana bezhe kwandili, musibalambije, nokuti bushe bwaMwali ngobwabo bananga saba. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Ndolebesa, kwamuli nditi, yoyo usinotambula bushe bwaMwali somwana untukutuku, aatofa alingwina.” <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Wakabafufujila, akababiga maboko awe akabakombolela.<verse eid="MRK 10:16" /></para>
  <para style="s">Unhulume umfumi</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mateo 19:16-30</ref>; <ref loc="LUK 18:18-30">Luka 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Elimukukwenda munzila, unhulume wakezha elabuka akafhugama mbeli kukwe akati kwaali, “Ndayiji wakalulama, ini zwandingate, kuti ndiwane bupenyu businopela?” <verse eid="MRK 10:17" /><verse number="18" style="v" sid="MRK 10:18" />Jesu wakati kwaali, “Unondishobelani kuti ndakalulama? Wakalulama umwempela chete, ndiMwali. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />Milawu unoyiziba: Usibulaye; Usipombole; Usikwibe; Usisumikijie manyepwa; Usitolele unhu chinhu; Ikuja tate namai babo.”<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />Iye wakati kwaali, “Ndayiji, zwose yezwi ndilozwilondota kuva ndili uncheche.”<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />Jesu wakoondinga, akonda akati kwaali, “Chinhu chimwempela chiloshayika; inda unotengesa zwose zwauna nazwo, upe basheti, unowana ifuma yokudenga; utukozha unditobele.” <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />Paakazwiwha yezwi wakahetela, wakenda elineshungu; nokuti wakaba ekafuma kasa.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />Jesu wakalinga linga akati kubalayijwa babe, “Zwikukutu kunaibo balofuma kuti bengwine mubushe bwaMwali!”<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />Balayijwa babe bakachenamiswa namawhi awe. Koga Jesu wakati akale kwabali, “Bana, kulemu chini kungwina mubushe bwa Mwali!” <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />“Zwilelu kuti ikamela lingwine mukabanga keneleti kuna kuti umfumi engwine mubushe bwa Mwali.”<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />Bakashamiswa kasa, bakati kwaali, “Ndiyani biya achachijwa?”<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />Jesu wakabalinga akati, “Kunhu azwitotubukana, koga kuna Mwali zwose zwinotubukana.”<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />Pita wakatanga kulebeleka kwaali eti “Ilingani, isu tasiya zwose tikamutobela.”<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />Jesu wakashandula akati, “Chokomende ndinoti kwamuli, apana unhu wakasiya ingumba, ununa kana nkazwaji, kana amai kana tate kana bana kana minda pezhulu pangu neNdebo Mbuya,” <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />usinootambuliswa nononshaji izana lyejingumba kana bakazwaji bechinhulume kana bakazwaji bechinhukaji kana mamai kana bana kana miminda noluyabiso akale bupenyu businopela munshaji unozha. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />“Koga banji botanga banooba bopejeleja, baiko kumapejelejo banooba botanga.”<verse eid="MRK 10:31" /></para>
  <para style="s">Jesu unoleba kwechitatu nezwolufu lulwe</para>
  <para style="r">(<ref loc="MAT 20:17-19">Mateo 20:17-19</ref>; <ref loc="LUK 18:31-34">Luka 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />Bakabeli munzila benda kuJelusalema, Jesu eli pambeli; bakachenama akale bakabontobela bakaba nolutyo. Wakatola baligumi nababili akatanga kubabuja nezwitiko zwalootikana kwaali eti, <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />“Bonani, tikumunda kuJelusalema, Mwananhulumyana woNhu unopilwa kubatebuji bakulwana nokubakwali, ibo bachontongela lufu akale banompila kuna bokuzhe, <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />banonseka, akale bonfhile, bondobe, akale bombulaye, mushule mwamazhuba matatu unomuka.”<verse eid="MRK 10:34" /></para>
  <para style="s">Chikumbilo chaJemusi naJoni</para>
  <para style="r">(<ref loc="MAT 20:20-28">Mateo 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Jemusi naJoni, bana baZebhedi bakaswika kwaali bakati, “Ndayiji tinoda mutitile zwose zwatichakumbila kwamuli.”<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />Wakati kwabali, “Ini zwamumuda kuti ndimutile?”<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />Bakati kwaali, “Titeni kuti umwe wedu egale kululyi umwe egale kuchesho muBugalo bwenu bwolukujo.”<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />Koga Jesu wakati kwabali, “Amutochiziba chamumukumbila. Imwi mootubula na kunwa unkombe wandinonwa kana lubhabhatizo lwandimubhabhatizwa nalwo?”<verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />Bakati kwaali, “Tinotubula.”</para>
  <para style="p" vid="MRK 10:39">Jesu wakati kwabali, “Unkombe wandichanwila muchaunwila, akale munoobhabhatizwa nolubhabhatizo lwandichabhabhatizwa nalwo; <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />koga kugala kululyi kwangu kana kuchesho changu, azwitoba zwangu, koga nguzwa yabo bakazwilonganyilwa.”<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />Pabakazwiwha bamwe babo baligumi, bakabanyemela kasa Jemusi naJoni. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />Asi Jesu wakabashobela kwaali akalebeleka eti, “Mozwiziba kuti matezi abokuzhe anobalaya nobukukutu, nabakulwana babo banoshingisa isimba pezhulu pabo. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Azwitonoba alo kwamuli; unoda kuba unkulwana pakati kwenu ngaabe unshingi wenu, <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />akale noyo unoda kuba wotanga unokwelela kuba unzike wabo bose. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Nokuti Mwananhulumyana woNhu aajakezha koshingilwa, koga koshingila nokupila bupenyu bubwe kuti bube indipilo yabanji.”<verse eid="MRK 10:45" /></para>
  <para style="s">Jesu unochija Bhatimiyasi ibhofu</para>
  <para style="r">(<ref loc="MAT 20:29-34">Mateo 20:29-34</ref>; <ref loc="LUK 18:35-43">Luka 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Bakaswika kuJeliko; paakubhuda kuJeliko elinabalayijwa babe nedupwa lyabanhu, ibhofu Bhatimiyasi, mwananhulumyana waTimiyusi, wakabeligele kumbali kwongwagwa ekumbila. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />Paakawha kuti ndiJesu wokuNazaleta, wakatanga kushomeja eti, “Jesu Mwananhulumyana waDavidi, ndiwhileni ishe!”<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />Banji bakombuja kuti enyalale, koga iye ndipo pakakongoloka nesimba, “Mwananhulumyana waDavidi ndiwhileni ishe!”<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />Jesu wakama akati, “Unshobeni.”</para>
  <para style="p" vid="MRK 10:49">Bakalishoba ibhofu, bakati, “Shanta; nyamuka umukushoba.”<verse eid="MRK 10:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50" />Wakalashila kumbali ishashiko lilye, akanyamuka nesimba, enda kunaJesu.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />Jesu wakati kwaali, “Unoda kuti ndikutileni na?”</para>
  <para style="p" vid="MRK 10:51">Ibhofu lyakati, “She ndimuda kuti ndibone.”<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />Jesu wakati kwaali, “Inda azo; kudimbwa kukwo kwakuchija.”</para>
  <para style="p" vid="MRK 10:52">Pakalepo wakabona, akontobela mungwagwa.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">Jesu unotambulwa kuJelusalema</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mateo 21:1-11</ref>; <ref loc="LUK 19:28-40">Luka 19:28-40</ref>; <ref loc="JHN 12:12-19">Joni 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Bakati baswendela kuJelusalema pelyo neBhetifaji neBhetani kudunhu linowhi Olivi, wakatuma balayijwa babe babili. <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />Akati kwabali, “Indani kunsha ulolingisana namwi, kana mwaswika kwauli munowana mwana wedonki ukasungililwa usanu watanwa nonhu, muunsupule, mumbuze.” <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Kana unhu eti kunamwi. “Munotilani yezwi,” muti “She unounda pakalepo unountumila yokuno.” <verse eid="MRK 11:3" /><verse number="4" style="v" sid="MRK 11:4" />Bakenda bakawana mwana wedonki ukasungililwa pankoba pazhe mungwagwa; bakonsupula. <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />Bamwe bakaba belimile yopo bakati kwabali, “Mumutani musupula mwana wedonki?”<verse eid="MRK 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6" />Bakalebeleka kwabali sokuleba kwaJesu; bakabavumija. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Bakabuza mwana wedonki kunaJesu, bakabiga zwimbalo zwabo pezhulu, akagala pezhulu. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Banji bakawala zwimbalo zwabo munzila, bamwe bakatema inhabi jina mazhani jibakabatema muminda, bakawala munzila <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Bakaba bekwenda mbeli, nabakabetobela bakashomeja beti Hosana. Ulokombolelwa iye unozha muzina lyashe. <verse eid="MRK 11:9" /><verse number="10" style="v" sid="MRK 11:10" />“Bulokombolelwa bushe bwatate bedu Davidi bukumuzha. Hosana wopezhuluzhulu.” <verse eid="MRK 11:10" /><verse number="11" style="v" sid="MRK 11:11" />Wakangwina muJelusalema akenda mutempeli; wakati alinga zwinhu zwose sezwo kwaluba madekwana, wakabhuda akenda kuBhetani pamwe nabegumi linababili.<verse eid="MRK 11:11" /></para>
  <para style="s">Jesu unofizha unkuyu</para>
  <para style="r">(<ref loc="MAT 21:18">Mateo 21:18</ref>,<ref loc="MAT 21:19">19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Nezhuba linotobela, pakubhuda kwabo kuBhetani wakaba nenzhala. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Wakabona unkuyu unamazhani echikule, akenda kwauli eti pamwe angawana zwokulya kwauli. Paakaswika wakawana pesina chinhu, koga mazhani oga chete nokuti aujakabeli unshaji wokuti ihuyu jibe ipo. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Wakalebeleka eti kwauli, “Kusibe noucholya zwizwalo zwizwo kuswikila nalini.” Balayijwa babe bakazwiwha.<verse eid="MRK 11:14" /></para>
  <para style="s">Jesu unotata banotengesa muTempeli</para>
  <para style="r">(<ref loc="MAT 21:12-17">Mateo 21:12-17</ref>; <ref loc="LUK 19:45-48">Luka 19:45-48</ref>; <ref loc="JHN 2:13-22">Joni 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Bakaswika kuJelusalema. Wakangwina mutempeli akatanga kutatamila yabo bakabetengesa nayabo bakabetenga beli mutempeli, akakudumula zwitala zwabo bakabechincha imali, nezwigalo zwabalutengesa injiba; <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />aajakavumila kuti unhu angangwina mutempeli ekanyamula zwibiya. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Wakabalayija akati kwabali, “Azwijakakwalwa kani kuti, ‘ingumba yangu inoowhi ingumba yokunamata yenduji jose.’ Koga imwi mwaita ingumba lyembava.”<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />Batebuji bakulwana nabakwali bomulawo bakazwiwha, bakada kushaka inzila yokuti bombulaye; koga bakontya nokuti banhu bose bakashamiswa nokulayija kukwe.<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />Madekwana bakabhuda muguta.<verse eid="MRK 11:19" /></para>
  <para style="ms">Isimba lyokudimbwa</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Zhingwanangwana bakati bepinda, bakabona unkuyu wakakoma nemiji yose. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Pita wakalangalila akati, “She lingani unti umwafizha wakoma.”<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />Jesu wakashandula akati kwabali, “Akati ibani nokudimbwa kunaMwali.” <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />Chokomende ndinoti kunamwi, umwe nomwe unoti kudunhu yeli, “nyamulwa uposelwe mugungwa,” esinokahajika mumwoyo uwe koga edimbwa kuti zwaanoleba zwinotikana, zwinoba alo. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Nokudalo ndinomubuja nditi zwinhu zwose zwamunokumbila pakunamata dimbwani kuti mozwitambula, zwinoba alo. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />Pose pamunomilika munamata, lekejelani bwose bamunandandu nabo, kutila kuti Tate benu bokudenga bemulekejele luchinyo lwenu.<verse eid="MRK 11:25" /></para>
  <para style="s">Umbhuzo pezhulu pesimba lyaJesu</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mateo 21:23-27</ref>; <ref loc="LUK 20:1-8">Luka 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Bakabuya bakaswika kuJelusalema. Echinokwendenda mutempeli, batebuji bakulwana nabakwali bomulawo nabatungamili bakezha kwaali, <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />bakati kunaiye, “Zwinhu yezwi unozwita nesimba lipi kana kuti ndiyani wakakupa isimba yeli lyokuta yezwi?”<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />Jesu wakashandula akati kwabali, “Nami ndinomubhuza umbhuzo, mundishandule nami ndichamubuja masimba andinoshingisa kuta yezwi. <verse eid="MRK 11:29" /><verse number="3" style="v" sid="MRK 11:3" />Umbhabhatizo waJoni wakava kudenga kana kuti kubanhu? Ndishanduleni.”<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />Bakanyenyejana beti, “Kana tikati kwakava kudenga,” uchati, “Ini musakadimbwa kunaiye?” <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Koga titi, “Kwakava kubanhu?” Bakatya banhu nokuti bose bakati Joni waluba umpolofeti wechokomende. <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />Bakonshandula Jesu bakati, “Atitoziba.” Jesu wakati kwabili, “Namibo anditomubuja masimba andinota nawo yezwi zwinhu.”<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">Unkwejaniso wabalimi babili</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mateo 21:33-46</ref>; <ref loc="LUK 20:9-19">Luka 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Wakatangisa kubhaunula kwabali nemikwejaniso. “Unhulume wakabyala unda wonzhambi, akashosha lukuta, akacha idizwa lyokuswinila imhuji, akabaka ingumba yondindi, akacheneka balimi, akenda kuna imwe inyika.” <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />Pawakaswika unshaji, wakatuma unshingi kubalimi, kuti enotola zizwalo zwonda wonzhambi. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Koga bakombhata bakondoba, bakombwiliza eli alo. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Wakabuya akatuma umwe unshingi kwabali, naiye bakondwajisa bakombwiliza neshoni. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />Wakabuya akatuma umwe, yoyu bakombulaya; nabamwe banji babakaloba, bamwe bakababulaya. <verse eid="MRK 12:5" /><verse number="6" style="v" sid="MRK 12:6" />Wakaba nomwananhulumyana umwempela, unodikana kwaali; wakontuma kumapejelejo eti, “Bachondemekeja mwananhulumyana wangu,” <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" />Koga yabo balimi bakalebelejana beti, “Yoyu ndiye undyi wefuma; izhani tiumbulaye ifuma ichaba yedu.” <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Bakombhata, bakombulaya, bakombhisila pazhe kwominda wonzhambi.<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />Unootani mweni wonda wonzhambi na? Unoobuya epalaje balimi yabo, epe bamwe balimi unda wonzhambi. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />Ani amujanu mwabala na, lukwalo yolu lunoti:</para>
  <para style="q1" vid="MRK 12:10">“Ibwe lyakalashwa nababaki,</para>
  <para style="q2" vid="MRK 12:10">ndilyo lyakoba ibwe lyakadikana;<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />yoku kuta kwaTezi,</para>
  <para style="q2" vid="MRK 12:11">zwinoshamisa mumesho edu?”<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Pakalepo bakanyetela bakada kushaka inzila yokunsunga asi bakatya luvute lyabanhu; nokuti bakabezwiziba kuti wakaba eleba ibo nonkwejaniso yoyu, Bakonsiya, bakava benda.<verse eid="MRK 12:12" /></para>
  <para style="s">Umbhuzo pezhulu pokutela</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mateo 22:15-22</ref>; <ref loc="LUK 20:20-26">Luka 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Feno bakatuma bamwe babaFalisi nabaHelodi kwaali, kuti bombhate nezwaakaleba. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />Bakezha bakati kwaali, “Ndayiji, tinoziba kuti munechokomende amutolinga zwonhu; amutolinga zwokuzhe kwonhu, koga munolayija inzila yaMwali. Zwimo mumulawu kana ne kulipa untelo kunaKesali?”<verse eid="MRK 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15" />“Tilipe kana tileke kulipa?” Nokuziba buchengeji bwabo, wakati kwabali, “Munondikwejelani na? Buzani ikobeli kwandili ndilibone.”<verse eid="MRK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16" />Bakabuza imwempela. Wakati kwabali, “Untojaniso yoyu nezwilokwalwa yopa ngezwani?”</para>
  <para style="p" vid="MRK 12:16">Bakati kwaali, “NgezwaKesali.”<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />Jesu wakati kwabali, “Ipani Kesali zwinhu zwaKesali, nokunaMwali zwinhu zwaMwali.”</para>
  <para style="p" vid="MRK 12:17">Bakachenamiswa naye.<verse eid="MRK 12:17" /></para>
  <para style="s">Umbhuzo pezhulu pokumuka kwabakafa</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mateo 22:23-33</ref>; <ref loc="LUK 20:27-40">Luka 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />BaSadusi bakezha kwaali, ibo banoti akuna kumuka kwabakafa, bakombhuza umbhuzo beti, <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />“Ndayiji, Mozesi wakatikwalila kuti, kana unkulu wonhu afa, akasiya unkaji esina mwana, ununa uwe etole unkaji uwe, emusile unkulu uwe mafhigwa.” <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Kwakabelipo bana bechinhulume bonhu umwempela, bashanu nababili; wokutanga wakatola unhukaji, paakafa aajakasiya bana; <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />wabili wakontola, akafa esasiya bana; nowatatu wakata alo; kuswikila wechishanu nowabili. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />Bakontola bashanu nababili koga besinosiya bana, kumapejelejo unhukaji neebo wakafa. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Pakumuka kwabakafa, unooba unkaji wani pakati pabo na? Nokuti bose bashanu nababili waluba eli unkaji wabo.<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />Jesu wakati kwabali, “Amujalashika na, nokusoziba makwalo nesimba lyaMwali?” <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />Nokuti banomuka kuna bakafa, abatolobola kana kulobolwa, asi banoba sengilozi kudenga. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />Kana kuli kumuswa kwabakafa, amujakabala na paLukwalo lwaMozesi, penyaya yedenje lyakabepya, kuti wakati, “Ndimi Mwali waAbhulahamu, Mwali waIsaka, naMwali waJakobe? <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Aatoba Mwali wabakafa, asi wabapenyu; mulolashika kasa.”<verse eid="MRK 12:27" /></para>
  <para style="s">Mulawo unkulwana</para>
  <para style="r">(<ref loc="MAT 22:34-40">Mateo 22:34-40</ref>; <ref loc="LUK 10:25-28">Luka 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Umwe wabakwali wakawha kunyenyejana kwabo, eziba kuti wakaba ashandula zwibuyanana, wakombhuza eti, “Ngoupi mulawo unkulwana pana yose?”<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />Jesu wakashandula akati, “Mulawo unkulwana ndiyoyu, Jowhani baIzilayeli! She Mwali ndiye She ega chete.” <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />akale ida She Mwali uwo nomwoyo uwo wose, nompepo uwo wose, nendangalilo jijo jose, nesimba lilyo lyose. <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />“Wechibili ndiyoyu, Ida umbakijani uwo sezwaunozwida iwi. Akuna umwe mulawo unkulwana kuna yeyi.” <verse eid="MRK 12:31" /><verse number="32" style="v" sid="MRK 12:32" />Feno unkwali womulawu wakati kwaali, “Ndimo Ndayiji, mwalebesa kuti ndiwo woga chete, akuna umwe kuzhe kukwe. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Kuunda iye nomwoyo wose, nokulangalila kwose, nesimba lyose, nokuda umbakijani uwo sezwaunozwida iwi, zwinopinda yose mipilo yokupiswa nemibhayilo.”<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />Jesu wakati ebona kuti washandula zwibuyanana wakati kwaali, “Awiko kule nobushe bwaMwali.” Akujakaba nonhu wakada kuti ombhuze umbhuzo.<verse eid="MRK 12:34" /></para>
  <para style="s">Umbhuzo pezhulu poNchiji</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mateo 22:41-46</ref>; <ref loc="LUK 20:41-44">Luka 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Jesu wakati elayija muTempeli, wakati, “Bakwali banoleba chini kuti Kristo ndiye mwananhulumyana waDavidi?” <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />Davidi emene ekazhajwa noMpepo uNchena wakati,</para>
  <para style="q1" vid="MRK 12:36">“She wakati kuna She wangu:</para>
  <para style="q2" vid="MRK 12:36">Gala kululyi lwangu,</para>
  <para style="q2" vid="MRK 12:36">kuswikila ndabiga babengi babo pasi pamakumbo awo”<verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />Davidi omene unonshoba eti She, “Angaba mwananhulumyana uwe chini na?” Banji bakashantilwa nokunwha.<verse eid="MRK 12:37" /></para>
  <para style="s">Jesu unochenjenja pezhulu pabalayiji bomulawo</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mateo 23:1-36</ref>; <ref loc="LUK 20:45-47">Luka 20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />Mundayijo yiye wakati, “Chenjelelani bakwali, banoda kukwenda nezwimbalo zwilefu, nokumuswa kumisika, <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />nokugala pezwigalo zwopezhulu mumasinagogo nobugalo bwambeli pamabhiko, <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />ibo betola jingumba jenchilikaji, beta minamato milefu yokuchengeja. Yaba bachobetekeswa zwinopindilija”<verse eid="MRK 12:40" /></para>
  <para style="s">Umpilo wenchilikaji</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luka 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Feno wakaba eligele ekalingisana nechibigilo chemali, ebona banji bebiga imali muchibigilo. Bafumi banji bakabiga imali inji. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Kwakaswika inchilikaji isakafuma, yakabiga makobeli mabili anota iganta lyesenti. <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />Wakashoba balayijwa babe, akati kwabali, “Ndinolebesa nditi kwamuli, inchilikaji yeyi isakafuma, yabiga zwinji muchibigilo kuna yabo bose bapila, <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />nokuti bose bakapa zwiva mufumo yabo yose, asi iye mukushaiwa kukwe wakapa zwose zwaana nazwo, zwobupenyu bubwe bwose.”<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">Jesu unolebeleka nezwokupalajwa kwetempeli</para>
  <para style="r">(<ref loc="MAT 24:1">Mateo 24:1</ref>,<ref loc="MAT 24:2">2</ref>; <ref loc="LUK 21:5">Luka 21:5</ref>,<ref loc="LUK 21:6">6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Wakati ebhuda mutempeli umwe wabalayijwa babe wakati kwaali, “Ndayiji linga bubhodo bwamabwe nobubhodo bweji jingumba!”<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />Jesu wakati kwaali, “Uzwibweni zwibakwa yezwi zwikulwana? Akutosiyiwa kana ibwe limwempela pezhulu pelimwe lisinowigilwa pasi.”<verse eid="MRK 13:2" /></para>
  <para style="s">Inyajo nenjabiso</para>
  <para style="r">(<ref loc="MAT 24:3-14">Mateo 24:3-14</ref>; <ref loc="LUK 21:7-19">Luka 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Wakati eligele pedunhu linowhi Olivi lyakalingisana neTempeli Pita naJemusi naJoni, naEndulu bakombhuza beli boga bakati. <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“Tibujeni kuti yezwi zwinhu zwinotikana lini biya, nechiboniso chinooba chipi kana yezwi zwinhu zwabulotikana.”<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />Jesu wakatanga kuti kwabali, “Chenjelani kuti musichengwe nonhu. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Banji banozha nezina lyangu beti, Ndimi iye! belasha banji.” <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />Kana muwha nezwehondo namalebwalebwa ehondo musive mwoyo, yezwi zwilokwelela kutikana koga kupela akujanu kwaba ipo. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Nokuti luji lunolwisana nolumwe luji, bushe bunoolwisana nobumwe bushe; kunooba ipo kudengenuka kwenyika kubugalo bulosiyanasiyana kunooba nenzhala; yezwi zwinanga sokutanga kwokulwaja kwemimba.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />Chenjelani imwi; nokuti banomusenga kumakota; mulobwa mumasinagogo, munoomiswa mbeli pabatongi namashe pezhulu pangu, chibe chisumikilo kwabali. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Koga iNdebo iMbuya inokwelela kutanga yapupulwa kunduji jose. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Kana bemubuza imwi kukubeteswa, musizwinyaje kuti munoolebani, ilebani chete chamunoba mwapiwa nonshaji yoyo, nokuti atobamwi munolebeleka koga uMpepo uNchena. <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />Mwanakwaina unoopila mwanakwaina uwe kuti ebulayiwe, nadade mwana wabo, nabana banooshandukila bazwali babo nokubabulayisa. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />Munoobengwa naibo bose nokuda kwezina lyangu; koga unonangatila kuswikila kumapejelejo unoochijwa.<verse eid="MRK 13:13" /></para>
  <para style="s">Lutyo lukulugulu</para>
  <para style="r">(<ref loc="MAT 24:15-28">Mateo 24:15-28</ref>; <ref loc="LUK 21:20-24">Luka 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />Kana mubona chinhu chinotyisa chilimile pabugalo pachisilokwelela kuba ipo (Unobala ngawhisise kuti zwinolebani) yabo bokuJudiya ngabetizhile kumatunhu; <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />yoyo upo pezhulu pedenga lwengumba esibhuluke enda mungumba kunotola chinhu; <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />naiye umomuminda esibwilile mushule kunotola chimbalo chiche, <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Mayee kuna yabo banemimba, nabanomwisa pamazhuba yayo! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Namatani kuti zwisitikane nonshaji wemhepo <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />Nokuti mumazhuba yayo kunooba ipo kuyabula kusanhu kwaba ipo kuvila pakubumbwa kwenyika yakabumbwa naMwali, kujine kube ngweno nokusichinooba ipo. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />Akale ngana She esashomapaja mazhuba yayo akuna walojijwa; koga nokuda kwabanhu bakashalwa, wakashomapaja mazhuba yawo.<verse eid="MRK 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21" />Nezwo kana unhu eti kwamuli, “Lingani hoyu Kristo, kana Lingani hondiya! musidimbwe.” <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />BaKristo bamaniepwa nabapolofeti bamaniepwa banooba ipo beta zwiboneso nezwishamiso kuti belashe bakashalwa kana zwitika. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Koga chenjelani; ndagala ndamubuja kale zwose.<verse eid="MRK 13:23" /></para>
  <para style="s">Kubuya koMwananhulumyana woNhu</para>
  <para style="r">(<ref loc="MAT 24:29-31">Mateo 24:29-31</ref>; <ref loc="LUK 21:25-28">Luka 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />Mumazhuba yawo shule kwokuyabula, izhuba linooswibha nomweji autoopa buchena, <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />nenyenyeji jinoombwela jiva kudenga, namasimba okudenga anoodengunujwa. <verse eid="MRK 13:25" /><verse number="26" style="v" sid="MRK 13:26" />Pakalepo banoobona Mwananhulumyana woNhu ezha eli mumakole eli namasimba makulwana nolukujo. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Pakalepo unootuma ingilozi jibunganise bakashalwa babe kuvila kumatibi mana enyika kunoswika kumajibilo edenga.<verse eid="MRK 13:27" /></para>
  <para style="s">Indayijo yonkuyu</para>
  <para style="r">(<ref loc="MAT 24:32-35">Mateo 24:32-35</ref>; <ref loc="LUK 21:29-33">Luka 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />Wanani chilayijo pankwejaniso wonkuyu, kana lutabi luba lunyolo lungokwinila munoziba kuti izhizha lyaba pelyo. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Zwili alo, kana mubona yezwi zwinhu zwitikana, zibani kuti waaba pelyo, peshubo. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Chokomende ndinoti kwamuli, yechi chizekululu achitoopinda kusanhu kwatikana zwose yezwi, <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Idenga nenyika zwinoopela koga mawhi angu aatoopinda.<verse eid="MRK 13:31" /></para>
  <para style="s">Apana unoziba izhuba kana unshaji</para>
  <para style="r">(<ref loc="MAT 24:36-44">Mateo 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />Koga zwezhuba kana unshaji yoyo, akuna unhu unoziba kana ingilozi jokudenga kana Mwananhulumyana koga Tate chete, <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />Galani, mwakalinda; nokuti amutounziba pauchaswika unshaji. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />Zwinanga sonhu wakenda kunoshanya, akasiya ingumba yiye, akapa balanda babe masimba, umwe nomwe akapiwa unshingo uwe, akabuja unolinda pankoba kuti elinde. <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />Nezwo ilindani nokuti amutoziba kuti tezi wengumba unozha lini, kungaba madeko, kana pakati pobusiku, kana pakukokolika igukulume kana kumijelo <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />kuti esiswike musinoziba emuwane mulilele. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />Zwandinoleba kwamuli ndinozwileba kunabamwe.<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">Chilangano chokubulaya Jesu</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mateo 26:1-5</ref>; <ref loc="LUK 22:1">Luka 22:1</ref>,<ref loc="LUK 22:2">2</ref>; <ref loc="JHN 11:45-53">Joni 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Ngweno kwakabasala mazhuba mabili kuti kube milya yePasika namabhiko echinkwa chisina umfufumuso. Batebuji bakulwana nabakwali bakapota inzila yokumbhata zwilosisika, akale bombulaye; <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />nokuti bakati, “Kusibe panshaji wamabhiko, nokuti banhu bangatimukila kukaba nezhoba.”<verse eid="MRK 14:2" /></para>
  <para style="s">Jesu unogubwa kuBhetani</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mateo 26:6-13</ref>; <ref loc="JHN 12:1-8">Joni 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />Wakati eli kuBhetani mungumba yaSimoni, wamapelembuji, Jesu eligele pakulya, kwakezha unhukaji eli nonkabo wamafuta enadi omene etengwa nemali inji. Wakapwanya unkabo akadila Jesu, namafuta enadi pansholo. <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />Bamwe bakabelipo bakanyetela bakati, “Ini yezwi kulasha mafuta?” <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />“Mafuta yaya alutengeswa namazana matatu amakobeli esiliva kukapiwa basheti.” Bakonyemela kasa unhukaji.<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />Koga Jesu wakati, “Undekejeni; Mumunyajilani? Wata unshingo umbuya kwandili. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />Basheti munobeli nabo unshaji wose, akale pamunoda kubatila zwanana motubula kubatila; koga imi amutobeli nami unshaji wose. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />Wata zwaanotubula; Walonganyila umbili wangu usanu ukajikwa. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Chokomende, ndinoti kwamuli, kwose kwaichabhaunulwa iNdebo iMbuya yeyi munyika jose, zwatiwa noyu nhukaji zwinoopupulwa sechikumbulujo naye.”<verse eid="MRK 14:9" /></para>
  <para style="s">Judasi unovuma kucheta Jesu</para>
  <para style="r">(<ref loc="MAT 26:14-16">Mateo 26:14-16</ref>; <ref loc="LUK 22:3-6">Luka 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Umwe wabaligumi nababili, Judasi Sikaliyoti wakenda kubatebuji bakulwana kunouncheta. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Pabakazwiwha yezwi bakashanta, bakombimbisa kuumpa imali. Iye wakapota inzila yokumpilija kwabali.<verse eid="MRK 14:11" /></para>
  <para style="s">Jesu unolya iPasika nabalayijwa</para>
  <para style="r">(<ref loc="MAT 26:17-25">Mateo 26:17-25</ref>; <ref loc="LUK 22:7-14">Luka 22:7-14</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Joni 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Nezhuba lyotanga lyechinkwa chisina umfufumuso, pabanobhayila imhwizana yePasika, balayijwa babe bakati kwaali, “Munoda kuti tinde kupi tinolonganyila, kwamuchanolyila iPasika?”<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />Wakatuma balayijwa babe babili akati kwabali, “Indani muguta, moshangana nonhulume ekasenga ihali yevula, muntobele, <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />yopo paachangwina, muti kumweni wengumba, uNdayiji wati.” “Ipoponi ingumba yabashanyi kwandichalyila iPasika nabalayijwa bangu?” <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />“Unomutondeja ingumba ihulwana ipopezhulu ilolonganyilwa kale; mwakalemo mutilonganyile.”<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />Balayijwa bakenda akale bakaswika muguta, bakawana zwose sezwaakabaleba; bakabambanyila iPasika.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />Madekwana, wakezha nabaligumi banababili. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Pabakagala kuti belye, Jesu wakati, “Chokomende ndinoti kunamwi, umwe wenu wandikumulya naye unondicheta.”<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />Bose bakaba neshungu, umwe noomwe akati kwaali, “Ndimi na?” <verse eid="MRK 14:19" /><verse number="20" style="v" sid="MRK 14:20" />Wakati kwabali, “Umwe wenu baligumi nababili, wandimuseba naye mundyilo. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Nokuti Mwananhulumyana woNhu unonda sezwilokwalwa pezhulu pape, mayee kunoyo uchoncheta Mwananhulumyana woNhu! Zwaluba zwibuya ngana yoyo unhu esakazwalwa.”<verse eid="MRK 14:21" /></para>
  <para style="s">Chilayilo chaShe</para>
  <para style="r">(<ref loc="MAT 26:26-30">Mateo 26:26-30</ref>; <ref loc="LUK 22:14-20">Luka 22:14-20</ref>; <ref loc="1CO 11:23-25">1 BaKolinte 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Belikumulya, wakatola chinkwa akaboka, akachimedula akabapa akati, “Tolani; yoyu umbili wangu.”<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />Wakatola unkombe, paakaboka wakabapa bakanwa bose. <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />Wakati kwabali, “Yeli ilopa lyangu, lyechivumilano, lichakutukila banji. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />Chokomende ndinoti kwamuli, anditoonwa akale unchelo wonzhambi kujine kuswike izhuba lyandichoonwa bupya kuBushe bwaMwali.”<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />Pabakapeja kukwimba lwimbo, bakenda kudunhu lyeOlivi.<verse eid="MRK 14:26" /></para>
  <para style="s">Jesu unolebambeli kulambwa naPita</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mateo 26:31-35</ref>; <ref loc="LUK 22:31-34">Luka 22:31-34</ref>; <ref loc="JHN 13:36-38">Joni 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />Jesu wakati kwabali, “Banji mobwilileshule; nokuti zwilokwalwa kuti ndooloba uncheji, imhwizi jinootataukana, <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" />koga, mushule mwokumuka kwangu, ndinoonda mbeli kwenu kuGalili.”<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />Pita wakati kwaali, “Koja bose bakabwilila shule, Imi anditoobwilileshule.”<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />Jesu wakati kwaali, “Chokomende, ndinoti kwauli, busiku bwanasi, igukulume lisanu lyakokoleka kabili unobandilamba katatu.”<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />Koga wakalebeleka nesimba eti, “ Kojoba zwileba kuti ndife namwi, anditomulamba.”</para>
  <para style="p" vid="MRK 14:31">Bose bakaleba alo.<verse eid="MRK 14:31" /></para>
  <para style="s">Jesu unonamata muGesemani</para>
  <para style="r">(<ref loc="MAT 26:36-46">Mateo 26:36-46</ref>; <ref loc="LUK 22:39-46">Luka 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Bakaswika pabugalo bunowhi Gesemani, wakati kubalayijwa babe, “Galani yopa, imi ndichinonamata.” <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Wakatola Pita, naJemusi, naJoni akenda nabo, wakatanga kujiijika nokuva moyo. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Wakati kwabali, “UMpepo wangu unaneshungu ihulwana kasa kuswikila pakufa. Galani yopa mulinde.”<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />Wakabasiya akakwenda kashizho, akawila pasi, akale akanamata eti, “Kana zwitubulika yoyu unshaji upinde kumbali.” <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />Akale wakati, “Abha! Tate! Kunamwi zwose zwinotikana; nyendulusani unkombe yoyu kwandili; koga kusibe kuda kwangu, koga kube kuda kwenu.”<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />Wakabwilila kubalayijwa babe, akawana belilele, akati kuna Pita, “Simoni, seni ulele? Autotubula kulindila kwe awa limwempela?” <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />“Lindilani munamate, kuti musingwine mukukwejwa. Umpepo unoda koga inyama ilodemuka.”<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />Wakabwilila kabili kunonamata, akapamha kuleba mawhi alotojana. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Paakabwilila akale kubalayijwa babe, wakawana belilele, nokuti bakabakafa nehope, akale abajakaziba mawhi okunshandula.<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />Wakabuya akale kwechitatu akati kwabali, “Muchilele zwenu munyetutukwa na? Zwakwana; unshaji waswika; Mwananhulumyana woNhu umupilwa mumaboko abachinyi. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />Mukani, andeni. Uncheti wangu waaba pelyo.”<verse eid="MRK 14:42" /></para>
  <para style="s">Kusungwa kwaJesu</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mateo 26:47-56</ref>; <ref loc="LUK 22:47-53">Luka 22:47-53</ref>; <ref loc="JHN 18:3-12">Joni 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />Pakalepo, echinolebeleka, Judas, umwe wabaligumi nababili, wakaswika eli noluvute lwabanhu bana makwabalaza nejiswimbo, beva kubatebuji bakulwana nabakwali namakolokota. <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />Feno uncheti wakababapa chitondejelo eti, “Yoyu wandichamyonta ndiye; mumbhate muntole munde naye mumbhatise.”<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />Paakaswika, wakenda kwaali nokukambija akati, “Ndayiji!” Akomyonta. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Bakabiga maboko abo bakombhata. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Umwe waabo bakabelimile pakalepo, wakabhisa igwalabaza lilye akacheka undanda wontebuji unkulwana akobhisa inzebe. <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />Jesu wakati kwabali, “Mwezha sabanhu bamuzhila imbava, namakwabalaza neswimbo muzha kondisunga? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />Mazhuba wose ndaluba namwi ndilayija mutempeli, amujakandibhata. Koga makwalo alokwelela kuzhajikijwa.”<verse eid="MRK 14:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50" />Bakonsiya bakatizha.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />Umwe unzhuzha wakontobela, ekambala uncheka chete; bakombhata, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />koga wakabapujumuka akasiya uncheka akatizha elichinkuna.<verse eid="MRK 14:52" /></para>
  <para style="s">Jesu unomiswa mbeli kweGota</para>
  <para style="r">(<ref loc="MAT 26:57-68">Mateo 26:57-68</ref>; <ref loc="LUK 22:54">Luka 22:54</ref>,<ref loc="LUK 22:55">55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13">Joni 18:13</ref>,<ref loc="JHN 18:14">14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Bakonsenga Jesu kuntebuji unkulwana; kuli iko kwakabakashangana bose batebuji bakulwana namakolokota nabakwali. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Pita wakontobela, eli kashizho, kunoswika mulukaya lwontebuji unkulwana, wakabeligele nabalindi ekota moto. <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />Feno batebuji bakulwana negota bakapyanga busumikiji bondandu wokuti Jesu ebulayiwe, koga abajakabuwana. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Banji bakapa busumikiji bwamanyepwa, koga busumikiji bwabo bwakasiyana.<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />Bamwe bakanyamuka bepa busumikiji bwamanyepwa beti, <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />“Isu takonwha eti, Imi ndinokolomola itempeli yeli lyakabakwa namaboko, mumazhuba matatu kova ndibaka limwe lisilobakwa namaboko.” <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Kojoba zwakadalo busumikiji bwabo abujaka vumilana.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />Untebuji unkulwana wakanyamuka pakati pabo akabhuza Jesu eti, “Apana zwaunoshandula na? Ini yezwi banhu yaba zwibanosumikija pezhulu papo?”<verse eid="MRK 14:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61" />Koga iye wakanyalala, aajakashandula. Untebuji Unkulwana wakombhuza kabili akati kwaali, “Ndiwi Kristo na, Mwananhulumyana waiye Ulokombolelwa?”<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />Jesu wakati, “Ndimi; Akale moombona Mwananhulumyana woNhu eligele kululyi lwaMasimba, akale ezha namakole okudenga.”<verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />Untebuji unkulwana wakajelula ingubo jije akale akati, “Tichinoshakilani busumikiji? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />Mwazwiwhila mose Mwali etukwa! Moyeya ni?”</para>
  <para style="p" vid="MRK 14:64">Bose bakati unandandu, unokwelela kufa.<verse eid="MRK 14:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65" />Bamwe bakatanga kumfhila mate, akale bakomfuka kumesho, bondoba, akale beti, “Polofeta!” Nabalindi bakonshangamija nempama.<verse eid="MRK 14:65" /></para>
  <para style="s">Pita unolamba Jesu</para>
  <para style="r">(<ref loc="MAT 26:69-75">Mateo 26:69-75</ref>; <ref loc="LUK 22:56-62">Luka 22:56-62</ref>; <ref loc="JHN 18:15-18">Joni 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Feno Pita wakabeli mudako, mulukaya, umwe wabalandakaji bontebuji unkulwana wakezha, <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />paakabona Pita ekota moto, wakondinga akati, “Iwi wabeli naJesu wokuNazaleta.”<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />Koga wakanyenyeja akati, “Anditozwiziba akale anditozwiwhisisa zwaumuleba.” Wakabhuda mugumbi pakalepo igukulume likakokolika. <verse eid="MRK 14:68" /><verse number="69" style="v" sid="MRK 14:69" />Undandakaji wakombona kabili, akale akabuja bakabeli mile pafupi akati, “Yoyu umwe wabo.” <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Koga iye wakanyenyeja akale.</para>
  <para style="p" vid="MRK 14:70">Munshaji umfupi bakabeli mile pelyo naPita bakati kwaali, “Chokomende iwi umwe wabo; nokuti iwi uli wokuGalili.”<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />Pakalepo wakatanga kutukana nokukowha, “Anditonziba yoyu unhu wamumulebeleka nezwizwe!”<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />Pakalepo igukulume lyakakokoleka kwechibili. Pita wakakumbulukwa mawhi aJesu okuti kwaali, “Igukulume lisanu lyakokoleka kabili, unobandilamba katatu.” Wakazwiyeya yezwi akalila.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">Jesu unomiswa mbeli kwaPilato</para>
  <para style="r">(<ref loc="MAT 27:1">Mateo 27:1</ref>,<ref loc="MAT 27:2">2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">Luka 23:1-5</ref>; <ref loc="JHN 18:28-38">Joni 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Pakalepo, zhingwanangwana, batebuji bakulwana nabatungamili babanhu nabakwali, namakolokota ose bakalangana bakonsunga Jesu, bakenda naye, bakonsenga kuna Pilato. <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />Pilato wakombhuza eti, “Ndiwi She wabaJuda na?”</para>
  <para style="p" vid="MRK 15:2">Wakashandula akati kwaali, “Ndiwi wazwileba.”<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />Batebuji bakulwana bakakomelela bonyepela zwinji. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Pilato wakombhuza akale, akati, “Autoshandula na? Iwha yose milandu minji yabamukupomela.”<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />Asi Jesu aajakashandula chinhu, nokudalo yezwi zwakachenamisa Pilato.<verse eid="MRK 15:5" /></para>
  <para style="s">Jesu unotongelwa lufu</para>
  <para style="r">(<ref loc="MAT 27:15-26">Mateo 27:15-26</ref>; <ref loc="LUK 23:13-25">Luka 23:13-25</ref>; <ref loc="JHN 18:39-19:16">Joni 18:39—19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Nonshaji wemilya, Pilato walusosungunula unsungwa umwempela, ubanokumbila. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Kwakaba kuli noumwe nhulume waluwhi Bhalabhasi, wakaba asungilwa kubulaya unhu pakupanduka eli nabamwe. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Ibunga lyabanhu lyakezha, likatangisa kukumbila Pilato kuti ete somwakabeta kuti ebasungunulile umwe unsungwa. <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />Pilato wakabashandula akati, “Munoda kuti ndimusungunulile She wabaJuda na?” <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Wakabezwiziba kuti batebuji bakulwana bakombhuza kwaali pezhulu polubengo.<verse eid="MRK 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11" />Koga batebuji bakulwana bakakunijila ibunga lyabanhu kuti likumbile kuti ebasungunulile Bhalabhasi. <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />Pilato wakabashandula, akale akati kwabali, “Ndite chini biya naye, umunoti ndiShe wabaJuda?”<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />Bakashomeja beti, “Unkahamile panchinjikwa!”<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />Pilato wakati kwabali, “Wakata ndandu ni?”</para>
  <para style="p" vid="MRK 15:14">Bakanyanyisa kushomeja, beti: “Unkahamile panchinjikwa!”<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />Pilato wakada kushantisa ibunga lyabanhu, wakabasungunulila Bhalabhasi, kova epilija Jesu kuti enonabhwa nokukahamilwa.<verse eid="MRK 15:15" /></para>
  <para style="s">Balwi behondo banoseka Jesu</para>
  <para style="r">(<ref loc="MAT 27:27-31">Mateo 27:27-31</ref>; <ref loc="JHN 19:2">Joni 19:2</ref>,<ref loc="JHN 19:3">3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Feno balwi bakonsenga mukati mwolubazhe mungumba inowhi iPratoliyamu, bakabunganija igapo lyabehondo lyose. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />Bakombajika ingubo ishaba, bakaluka chilemba chemiwha, bakombajika icho. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Bakatanga kuunkuja, beti, “Ndauwe She, wabaJuda!” <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />Bakondoba nolushanga ponsholo, bakonfhila mate, bakafhigama nezwivi, bakondemekeja. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Pabakati bonseka, bakombula ingubo yensulubele, bakombajika zwimbalo zwizwe. Bakenda naye kuti benonkahamila.<verse eid="MRK 15:20" /></para>
  <para style="s">Jesu unokahamilwa panchinjikwa</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mateo 27:32-44</ref>; <ref loc="LUK 23:26-43">Luka 23:26-43</ref>; <ref loc="JHN 19:17-27">Joni 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />Umwe unhu waluwhi Simoni wokuSayilini, tate baAlekizanda naLufusi, wakaswika evakuzhe kweguta, bakomanikija kuti enyamule unchinjikwa waJesu. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />Bakenda naye Jesu, kubugalo bwaluwhi, iGologota, zwinoleba kuti, bugalo bwebhepe lyonsholo. <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Bakompa iwaini iloshanganiswa nemula, koga aajakainwa. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Bakati bonkahamila, bakakobelana zwimbalo zwizwe, bakata ifumbefumbe kuti umwe noumwe epiwe chipi. <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />Waluba unshaji we awa yetatu zwingwanangwana pabakonkahamila. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Kwakabakakwalwa lukwalo lwondandu uwe, lwokuti: “She wabaJuda.” <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />Kwakakahamilwa pamwempela naye imbava imbili, umwe kululyi, umwe kuchesho chiche. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />(Kwakazhajikijwa unkwalo unoti: “Wakakahamilwa pamwempela nabachinyi”<verse eid="MRK 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29" />Akale yabo balupinda nopo bakontuka, bakajunguja misholo yabo, beti, “Aaa, iwi unozakunula iTempeli, ukabuya ukalibakulula mumazhuba matatu, <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />zwichije iwi, bhuluka panchinjikwa.”<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />Batebuji bakulwana pamwempela nabakwali bakonseka, bakalebeleka, beti, “Wakachija bamwe, aatotubula kuzwichija iye.” <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />“Kristo, She wabaIzilayeli, ngebhuluke panchinjikwa ngweno kutila kuti tibone, akale tidimbwe.”Nabakabakahamilwa pamwe naye bakontuka.<verse eid="MRK 15:32" /></para>
  <para style="s">Kufa kwaJesu</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mateo 27:45-56</ref>; <ref loc="LUK 23:44-49">Luka 23:44-49</ref>; <ref loc="JHN 19:28-30">Joni 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Kwakati kwaswika iawa yeshanu inalimwe, kwakaswibha munyika yose kuswikila iawa lyeshanu linamana. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Ne awa lyeshanu linamana, Jesu bakashomeja newhi igulwana, akati: “Eloyi, Eloyi, lama sabakatani?” Zwinoleba kuti: “Mwali wangu, Mwali wangu, mwandisiyilani na?”<verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />Bamwe bakabelimile yopo bakati bawha, bakati: “Lingani, ukumushoba Elija.” <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />Kwakamilika umwe, akalabuka akanyajika chinganganga muwaini inopanyuka, akabiga mulushanga, akoonwisika, eti, “Lingilijani pela, tibone kana Elija unozha na koombhuluja.”<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />Jesu bakashomeja newhi igulwana, akafa.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />Uncheka weTempeli wakajeluka pakati, wakatangisila pezhulu unda pasi. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Akale unkulwana wegapo lyabalwi elimile pambeli kukwe, ombona efa alo, wakati, “Chokomende, yoyu unhu waluba Mwananhulumyana waMwali.”<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />Kwakaba kulipo banhukaji belimile kule, belingisisa; pakati pabo kwakaba kulipo Mariya Magadalena, naMariya amai baJemusi untukutuku naJosesi, naSalome; <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />Ndibo bakabauntobela bechi muGalili, bakonshingila, nabamwe banhukaji banji bakatanha naye benda kuJelusalema.<verse eid="MRK 15:41" /></para>
  <para style="s">Kujikwa kwaJesu</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mateo 27:57-61</ref>; <ref loc="LUK 23:50-56">Luka 23:50-56</ref>; <ref loc="JHN 19:38-42">Joni 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Kwakaba madekwana lyakabeli izhuba lyokulonganyila, nokuti lyaluba izhuba linotangila iSabata, <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />kwakaswika Josefa weAlimatiya, umwe wakabelemekejwa wamakulukota, emene wakaba elindila bushe bwaMwali, wakenda kuna Pilato, esinotya, akakumbila untumbu waJesu. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />Pilato wakashamiswa kuwha kuti wafa kale; wakashoba unkulwana wabalwi, akombhuza kuti waaba nonshaji afa na. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Wakati awha kunkulwana wabalwi, wakompa Josefa untumbu, <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />lye wakatenga uncheka umbhodo, akabhuluja untumbu, akompeteleja noncheka yoyo, akombiga mugumbu lyakachiwa mubwe, akakungulujila ibwe kuvala igumbu. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Mariya Magadalena, naMariya amai baJosesi, bakabona yopo paakajikwa.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">Kumuka kwaJesu</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mateo 28:1-8</ref>; <ref loc="LUK 24:1-12">Luka 24:1-12</ref>; <ref loc="JHN 20:1-10">Joni 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Pakakwapela iSabata, Mariya Magadalena na Mariya amai baJemusi naSalome bakatenga mafuta anonhuwilila kuti bende benonguba. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Kumijelo nezhuba lyotanga lyeviki, bakenda kugumbu, pakubhuda kwezhuba. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />Bakalebelekesana beti, “Ndiyani uchanoti kungulujila ibwe pankoba wegumbu biya?” <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />Pabakalingisisa, bakabona ibwe lyakungulijwa kojoba lyakabeli igulwana kasa. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Bakangwina mugumbu bakabona unzhuzha eligele kululyi, akambala zwimbalo zwichena; bakachenama.<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />Wakati kwabali, “Musuve mwoyo, mumushaka Jesu wokuNazaleta, wakakahamilwa panchijikwa. Wamuka aipo yopano; lingani yopa ndipo pabakabombiga. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Koga indani munobuja balayijwa babe naPita kuti wenda pambeli penu kuGalili; munonouwana kwakale sokubujwa kwenu”<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />Bakabhuda bekatizha kugumbu, nokuti bakaba nokuteketa nokutya kasa, abajakabuja unhu nokuti bakaba betya.<verse eid="MRK 16:8" /></para>
  <para style="s">Mapejelejo eNdebo iMbuya <note caller="+" style="f"><char style="fr" closed="false">16:8. </char><char style="ft" closed="false">Amwe mwakwalo akatolokwa ntolo ana yaya majibilo ku Ndebo Imbuya (indima 9-20).</char></note></para>
  <para style="s">Jesu unozwitondeja kunaMariya Magadalena</para>
  <para style="r">(<ref loc="MAT 28:9">Mateo 28:9</ref>,<ref loc="MAT 28:10">10</ref>; <ref loc="JHN 20:11-18">Joni 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />Jesu wakati amuka zwingwanangwana nezhuba lyotanga lyeviki, wakatanga kuboneka kuna Mariya Magadalena iye waakabhisa mipepo mibi mishanu ina mibili. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Iye wakenda akanobabuja yabo baluba belinaye, bakaba bechinolila. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Pabakawha kuti umpenyu, nokuti waboneka kwaali abajakadimbwa.<verse eid="MRK 16:11" /></para>
  <para style="s">Jesu unozwitondeja kubatobeli babili</para>
  <para style="r">(<ref loc="LUK 24:13-35">Luka 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Mushule mwezwi wakazwitondejela nechimwe chimo kubabili babo bakabekwenda mumizi. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Bakenda bakanobuja bamwe, koga abajakabadimbwa.<verse eid="MRK 16:13" /></para>
  <para style="s">Jesu unozwitondejela kuna bali gumi nomwempela</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mateo 28:16-20</ref>; <ref loc="LUK 24:36-49">Luka 24:36-49</ref>; <ref loc="JHN 20:19-23">Joni 20:19-23</ref>; <ref loc="ACT 1:6-8">Mishingo 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Shule mwezwi wakazwitondejela kuna baligumi nomwempela, beligele pabakabelya; akabapa undandu pezhulu pokusodimbwa kwabo nobukukutu bwemyoyo yabo, nokuti abajakadimbwa kuna yabo bakombona amuka. <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />Wakati kwabali, “Indani kunyika jose mubhaunule iNdebo iMbuya kuzwibumbwa zwose. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Yoyo unovumila ebhabhatizwe unoochijwa, koga yoyo usinovumila unoolashwa. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Yezwi zwitondejelo zwinootobela banovumila. Muzina lyangu banoobhisa madimoni bepupule nendimi impya, <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />banoonunga jinyoka namaboko, kojoba bakanwa zwinhu zwinobulaya azwitoobalwajisa, banobiga maboko pezhulu pabanolwala bechikochila.”<verse eid="MRK 16:18" /></para>
  <para style="s">Jesu unotolwa enda kudenga</para>
  <para style="r">(<ref loc="LUK 24:50-53">Luka 24:50-53</ref>; <ref loc="ACT 1:9-11">Mishingo 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />She Jesu wakati alebeleka nabo, wakatolwa akenda kudenga akanogala kuluboko lolulyi lwaMwali. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Ibo bakenda bekanobhaunula iNdebo iMbuya kwose kwose, She eshinga nabo esimisa iwhi nezwiboniso zwakatobela. Ameni<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>