<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="TIT" style="id">- NAMBYA TRANSLATION PROJECT</book>
  <para style="h">Tayitasi</para>
  <para style="toc1">Lukwalo lwaPaulu Kuna Tayitasi</para>
  <para style="toc2">Tayitasi</para>
  <para style="toc3">Tayit</para>
  <para style="mt2">Lukwalo LwaPaulu</para>
  <para style="mt1">KUNATAYITASI</para>
  <para style="imt">Matangisilo</para>
  <para style="ip">Lukwalo lwaTayitasi lumwe lwamakwalo mana aPaulu, akakwalilwa banhu kusigubungano. Amwe makwalo matatu, ndiTimoti wotanga, Timoti wabili, naFilimoni. Paulu wakakwalila Tayitasi, koga akale wakakwala sokuti lukwalo lungabalwa newhi lyopezhulu kubanhu banji. Isu yezwi tingazwiziba nokuzwileba kukwe kuti uMpositoli, chinhu chakabezibwa kale naTayitasi. Paulu angabe akakwala lukwalo yolu pakati pamakole makumi mashanu negumi mwempela lina tutatu zwinda kumakumi mashanu negumi mwempela linatushanu.</para>
  <para style="ip">Paulu wakaba alaya Tayitasi kuti etungamile makubungano akabeli pechibongo cheKiliti. Paulu wakakwala lukwalo yolu epa indayilo kuna Tayitasi yokushala nokulayija batungamili bamakubungano. Wakapa indayilo inokwelana somumakwalo awe kuna Timoti. Lukwalo lulwe lunolondejela kuti batungamili bamakubungano banokwelela kupiwa lulemeko lyopezhulu. Makubungano nabatungamili bamakubungano bangweno banokwelela kulingisisa zwibuyanana akale zwimomunsi nenzila jilokwelela yabo bayimo mubutungamili.</para>
  <para style="iot">Zwilomumwa</para>
  <para style="io1">Paulu unolaya Tayitasi kuti ebige batungamili banabumwali (Tayitasi 1:1-16)</para>
  <para style="io1">Kova akale ondaya kuti elayije banhu kuti begale bupenyu buna Mwali (Tayitasi 2:1—3:11)</para>
  <para style="io1">Pakupejeleja, Paulu unokwala mawhi okukonya (Tayitasi 3:12-15)</para>
  <chapter number="1" style="c" sid="TIT 1" />
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1" />Imi, Paulu, unshingi waMwali, akale umpositoli waJesu Kristo.</para>
  <para style="p" vid="TIT 1:1">Ndakashalwa kuti ndikubuse kudimbwa kwabo banhu baloshalwa naMwali, noluzibo lwabo lwechokomende zwinokwendelana nokutya Mwali, <verse eid="TIT 1:1" /><verse number="2" style="v" sid="TIT 1:2" />mulubimbo lwobupenyu businopela, Mwali usinoniepa wakabimbiswa kuva kumatangisilo <verse eid="TIT 1:2" /><verse number="3" style="v" sid="TIT 1:3" />akale panshaji ulokwelela zwakatondejela muwhi lilye mukubhaunula kwandakapiwa nokulaya kwaMwali uNchiji wedu.<verse eid="TIT 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="TIT 1:4" />Kuna Tayitasi, mwananhulumyana wangu wechokomende muluvumilo lumwempela.</para>
  <para style="p" vid="TIT 1:4">Chipiwo nolunyalalo zwinova kunaMwali Tate nokunaKristo Jesu uNchiji wedu lube nawi.<verse eid="TIT 1:4" /></para>
  <para style="s">Unshingo waTaitasi muKileti</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5" />Yezwi ndizwo zwandakakusiyila kuKileti, kuti ukolole nokambija palolunduka, akale ubige bakulwana bamakubungano mumakuta ose sokukulaya kwangu, <verse eid="TIT 1:5" /><verse number="6" style="v" sid="TIT 1:6" />Unkulwana wegubungano unokwelela kuwanikwa esina chibi, eli ulobimbika kunkaji uwe akale bana babe beli bavumili besina bupalaji nokusowhilila. <verse eid="TIT 1:6" /><verse number="7" style="v" sid="TIT 1:7" />Nokuti umbhishopi sombhati wezwinhu zwaMwali unokwelela kusoshundika, aatokwelela kuzwida, kana kukambija kunyema, kana kuba unkolwi, kana usinoda kulwana, kana ibhazwi kungwano, <verse eid="TIT 1:7" /><verse number="8" style="v" sid="TIT 1:8" />koga untambuli wabezi, unoda bubuya, unozwikabula, ulolulama, unchena akale unozwitinha, <verse eid="TIT 1:8" /><verse number="9" style="v" sid="TIT 1:9" />Yeli iWhi ndilechokomende akale lilobimbika sokulayijwa kukwe, kutila kuti etubule kulayija indayilo yechokomende nokukolola yabo banonyenyejana nayo.<verse eid="TIT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10" />Nokuti kuna banhu banji basinowhilila, banolebeleka zwamayabwe akale beli bachengeji, kasakasa igapo lyabemhalajo, <verse eid="TIT 1:10" /><verse number="11" style="v" sid="TIT 1:11" />balokwelela kukalalilwa kuti bewhilijile, sezwo belimuzoza imhuli imhumbulu nokulayija zwabasinokwelela kulayija betila kuti bewane ingwano isina nolubhancho. <verse eid="TIT 1:11" /><verse number="12" style="v" sid="TIT 1:12" />Umwe wabo, undebambeli waMwali wokuna ibo, wakati, “BaKileti baniepi unshaji wose, bananga samapuka obubi, mapazwi masimbe.” <verse eid="TIT 1:12" /><verse number="13" style="v" sid="TIT 1:13" />Busumikiji yobu ngubwechokomende. Nokudalo bakalalile nesimba, kuti bebe nokudimbwa kuliiko, <verse eid="TIT 1:13" /><verse number="14" style="v" sid="TIT 1:14" />panokuti bewhilile ingano jabaJuda kana kulaya kwabanhu banoshunda ichokomende. <verse eid="TIT 1:14" /><verse number="15" style="v" sid="TIT 1:15" />Kuna baloshambijika zwose zwinhu zwiloshambijika, koga kubabipisi nabasinodimbwa apana zwiloshambijika, indangalilo nemyoyo yabo zwiloswibha. <verse eid="TIT 1:15" /><verse number="16" style="v" sid="TIT 1:16" />Banozwita banoziba Mwali, koga banondamba nezwito zwabo, banonengesa, abatowhilila akale abatokwelela kana chipi zwacho chito chibuyanana.<verse eid="TIT 1:16" /></para>
  <chapter eid="TIT 1" />
  <chapter number="2" style="c" sid="TIT 2" />
  <para style="s">Indayijo Iliiyo</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1" />Koga iwi, ilayija indayijo iliiyo. <verse eid="TIT 2:1" /><verse number="2" style="v" sid="TIT 2:2" />Layija banhulume bakulwana kuti bezikatile, belemekejeke, bezwikabule, balosima mukudimbwa, balosima noludo, akale balosima mukusungwaja. <verse eid="TIT 2:2" /><verse number="3" style="v" sid="TIT 2:3" />Munzila yakaleyo layijani banhukaji bakulwana kuti bezwilemese muzwito zwabo, akale besibe banoniepa kana bakolwi banokubukilwa nobusukwa, koga belayije zwili izwo zwibuyanana, <verse eid="TIT 2:3" /><verse number="4" style="v" sid="TIT 2:4" />kutila kuti belayije banhukaji batukutuku kuda balume babo nabana babo, <verse eid="TIT 2:4" /><verse number="5" style="v" sid="TIT 2:5" />bebe namaano, bekashambijika, belondota misha yabo, baneshe, nokuzwibiga pasi pabalume babo, kuti iwhi lyaMwali lisishuluswe.<verse eid="TIT 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6" />Munzila yakaleyo, sungwaja bazhuzha kuti bezwibhate. <verse eid="TIT 2:6" /><verse number="7" style="v" sid="TIT 2:7" />Zwitondejele nenzila jose sechitondejelo chezwito zwibuya, akale mukulayija kuko tondejela kubimbika, kuzwipila, <verse eid="TIT 2:7" /><verse number="8" style="v" sid="TIT 2:8" />nendebo iliiyo isinoshungulika, kutila kuti yoyo unonyenyeja ebe neshoni, pesina chibi chaangalebe nozwedu.<verse eid="TIT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9" />Layijani balanda kuti bezwideleje kumatezi abo akale kuti bebagunche muzwinhu zwose, akale besinoshandulana namatezi abo, <verse eid="TIT 2:9" /><verse number="10" style="v" sid="TIT 2:10" />kana kubakwibila, koga betondejele kubimbika kwechokomende kulopelelela, kutila kuti muzwinhu zwose lakamile indayijo yaMwali uNchiji wedu.<verse eid="TIT 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11" />Nokuti chipiwo chaMwali chakabuza luchijo lwabanhu bose, <verse eid="TIT 2:11" /><verse number="12" style="v" sid="TIT 2:12" />chitilayija kuzwikabula, kulamba zwechinamato,akale nozwokulakamila zwenyika, nokulalama bupenyu bunoshantisa mwali, tilulame akale bupenyu bokutya mwali penyika, <verse eid="TIT 2:12" /><verse number="13" style="v" sid="TIT 2:13" />takamilila makombolelo edu olubimbo, kupamuka kokungaima kwaMwali wedu unkulwana noNchiji Jesu Kristo, <verse eid="TIT 2:13" /><verse number="14" style="v" sid="TIT 2:14" />wakazwipila iye kutimunula isu mububi bose akale ezwichenesela banhu babe balosungwalila zwito zwibuyanana.<verse eid="TIT 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15" />Zibisa zwinhu yezwi, sungwaja akale kalalila nesimba lyose. Usivumile kana ani kuti ekulingile pasi.<verse eid="TIT 2:15" /></para>
  <chapter eid="TIT 2" />
  <chapter number="3" style="c" sid="TIT 3" />
  <para style="s">Ingalilo yoNkristo</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1" />Bakumbuluje bavumili kuzwideleja kubatongi nokubutongi, kuwhilila, kuzwimisila kuta kana upi unshingo ulolulama, <verse eid="TIT 3:1" /><verse number="2" style="v" sid="TIT 3:2" />kusoolebeleka bubi nabamwe banhu, kusokakabajana, kuba banyolo, akale kugala ukalemekeja unhu wose zwilopelelela. <verse eid="TIT 3:2" /><verse number="3" style="v" sid="TIT 3:3" />Nokuti isu noumwe unshaji takabeli malema, tisinowhilila, titungamililwa kumbali, balanda bendakamilo jilosiyanasiyana nokunakilijwa kunjiinji, mazhuba edu eli obubi nobuchiba, tibengwa nabanhu akale tibengana umwe noumwe. <verse eid="TIT 3:3" /><verse number="4" style="v" sid="TIT 3:4" />Koga ishe noludo lwaMwali uNchiji wedu pazwakapamuka, <verse eid="TIT 3:4" /><verse number="5" style="v" sid="TIT 3:5" />wakatichija isu, kusi nezwatinota mubululami bwedu, koga neshe jije, nomukushambiswa kokuzwalwa bupya nokumusilijwa muMpepo uNchena. <verse eid="TIT 3:5" /><verse number="6" style="v" sid="TIT 3:6" />Mwali waakadila patili zwizhele umpepo unchena nomunaJesu Kristo uNchiji wedu, <verse eid="TIT 3:6" /><verse number="7" style="v" sid="TIT 3:7" />kutila kuti talulamiswa nechipiwo chiche, tibe balyifumi zwikwendelana nolubimbo lobupenyu businopela. <verse eid="TIT 3:7" /><verse number="8" style="v" sid="TIT 3:8" />Yeyi indebo ngiyechokomende.</para>
  <para style="p" vid="TIT 3:8">Chido changu kuti usimise yezwi zwinhu, kutila kuti yabo bakadimbwa munaMwali bete zwito zwibuyanana. Yezwi zwinhu zwibuya akale zwina lubhancho kubanhu. <verse eid="TIT 3:8" /><verse number="9" style="v" sid="TIT 3:9" />Koga lekejani kukakabajana kobulema, machinde amatategulu, imhalalano akale nokujojobolana nezwomulawo, nokuti azwina lubhancho akale azwina nshingo. <verse eid="TIT 3:9" /><verse number="10" style="v" sid="TIT 3:10" />Koga unhu unopambulanya bamwe, unkabule kotanga nakabili kuva yopo, muumpe mesho usina chokuta naye, <verse eid="TIT 3:10" /><verse number="11" style="v" sid="TIT 3:11" />unoziba kuti unhu yoyo umbi akale unchinyi, wazwilasha iye.<verse eid="TIT 3:11" /></para>
  <para style="s">Indayijo YoPejeleja</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12" />Pandichatuma Alitemasi kana Tichikasi kwauli, ukweje nesimba kuzha kwandili kuNikopolisi, nokuti ndasunga kuti ndiko kwandichabeli unshaji wemhepo wose. <verse eid="TIT 3:12" /><verse number="13" style="v" sid="TIT 3:13" />Ita nokukimbija zwimomumasimba awo kuti Zinasi igweta naApolosi bengwine inzila ngweno, ubone kuti apana chabanoshayiwa. <verse eid="TIT 3:13" /><verse number="14" style="v" sid="TIT 3:14" />Akale ita kuti banhu bokunasu bezibe kuta zwito zwibuyanana, kutila kuti bebhanche nokukambijisa munyaya jinoda kukambijilwa nolubhancho, akale besibe basina nshingo.<verse eid="TIT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15" />Bose bandinanabo bakumumusa. Umuse yabo banotida mukudimbwa.</para>
  <para style="p" vid="TIT 3:15">Chipiwo chibe namwi mose.<verse eid="TIT 3:15" /></para>
  <chapter eid="TIT 3" />
</usx>