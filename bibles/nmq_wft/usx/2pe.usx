<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2PE" style="id">- NAMBYA TRANSLATION PROJECT</book>
  <para style="h">2 Pita</para>
  <para style="toc1">Lukwalo Lwebili Lwakakwalwa naPita</para>
  <para style="toc2">2 Pita</para>
  <para style="toc3">2 Pit</para>
  <para style="mt2">Lukwalo Lwabili Lwakakwalwa na</para>
  <para style="mt1">PITA</para>
  <para style="imt">Matangisilo</para>
  <para style="ip">Lukwalo lwabili lwaPita lwakakwalwa noMpositoli Pita, koga bemhizha banji bamazhubano banonyenyejana nazwo yezwi. Zwingatikana kuti umwe wabo wakakwala muzina lyaPita. Unkwali unoleba kuti unsumikiji wakabona namesho awe bupenyu bwaJesu kasa kushandulwa kukwe pedunhu (2 Pita 1.17-18). Kana Pita eli unkwali wolukwalo, kungaba kuti wakalukwala eli kuRoma, amakumi mashanu negumi Jesu asanu azwalwa, Pita esanhu ashaika. Unolushoba kuti lukwalo lulwe lwebili. (2 Pita 3:1) yezwi zwiva kuti lukwalo yolu lwakakwalwa mushule molukwalo lwaPita lokutanga. Lukwalo yolu lulonanga baKristo bwose.</para>
  <para style="ip">Chinangwa chaPita chokukwala lukwalo yolu chakabeli chokusungwaja baKristo bwose kuti begale bupenyu bubuya nokubachenjeja kuti besitobele indayijo yabalayiji bamaniepwa (2 Pita 2:1-22). Wakabakutaija kuti besiwhilile banhu bamuti Jesu umujilwa kubuya. Koga wakabatondejela kuti Mwali aanedontela koga unoda kuti unhu wose echijwe (2 Pita 3:8-9). Yechi ndicho chisoko chogala bupenyu bubuyanana (2 Pita 3:14).</para>
  <para style="iot">Zwilomumwa</para>
  <para style="io1">Pita unozwisuma akale nokulebeleka kubabali babe (2 Pita 1:1-2)</para>
  <para style="io1">Kova ebakumbuluja kuti begale bupenyu bubuyanana nokuti Mwali wakatitubulila (2 Pita 1:3-21)</para>
  <para style="io1">Wakatobela nokuchenjeja nezwabalayiji boniepa akale unoleba nezwichatikana kubalayiji boniepa kumapejelejo (2 Pita 2:1-22)</para>
  <para style="io1">Mushule mezwi Pita unopejeleja nokusungwaja bavumili kuti begale bupenyu bubuyanana kulonganyila kuzha kwabili kwaJesu (2 Pita 3:1-17)</para>
  <chapter number="1" style="c" sid="2PE 1" />
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1" />Imi Simoni Pita, unshingi akale noMpositoli waJesu Kristo,</para>
  <para style="p" vid="2PE 1:1">Kunaabo bakawana kudimbwa kulokosha nokwedu mubululami bwaMwali noNchiji wedu Jesu Kristo.<verse eid="2PE 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2" />Chipiwo nolunyalalo zwiwande munamwi muluzibo lwaMwali nolwaJesu Tezi wedu.<verse eid="2PE 1:2" /></para>
  <para style="s">Kushoba nokushala kwaMwali</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3" />Masimba awe obumwali akatipa zwinhu zwose zwobupenyu nobumwali, zwipindila muluzibo lwoyo wakatishobela kukungaima kukwe nobubuya. <verse eid="2PE 1:3" /><verse number="4" style="v" sid="2PE 1:4" />Nomunaizwo wakatipa lubimbo lulwe lukulwana akale lunokosha, kuti neezwi mupuluke mububi bumomunyika bunobuzwa nolulakamilo, akale kuti mushanganile zwolubumbo bobuMwali. <verse eid="2PE 1:4" /><verse number="5" style="v" sid="2PE 1:5" />Nechisoko yechi ikwejani nesimba lyenu kupamija kudimbwa, nobubuya, akale bubuya noluzibo. <verse eid="2PE 1:5" /><verse number="6" style="v" sid="2PE 1:6" />akale luzibo nokuzwibhata, nokuzwibhata kunakusungwala akale kusungwala nobumwali, <verse eid="2PE 1:6" /><verse number="7" style="v" sid="2PE 1:7" />akale bumwali nobubwanakwaina bunaludo, akale nobubwanakwaina bunaludo, noludo. <verse eid="2PE 1:7" /><verse number="8" style="v" sid="2PE 1:8" />Nokuti kana yezwi zwinhu zwili munamwi akale zwili zwinji, zwinomubhata kuti musibe banokonwa kana kusoba nemichelo muluzibo lwaTezi wedu Jesu Kristo. <verse eid="2PE 1:8" /><verse number="9" style="v" sid="2PE 1:9" />Nokuti yoyo usina nazwo yezwi, ibhofu akale unobonela pafupi nokukanganwa kuti wakashampulujwa muluchinyo lulwe lwantolo.<verse eid="2PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10" />Nokudalo, banakwaina, sungwalani kasa kusimitija kushobwa nokushalwa kwenu, nokuti mungota yezwi amutofa mwawa, <verse eid="2PE 1:10" /><verse number="11" style="v" sid="2PE 1:11" />nezwo motambulwa nokungwina kukulwana, mubushe businopela bwaTezi noNchiji wedu Jesu Kristo.<verse eid="2PE 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12" />Nokudalo ndilonanga kumukumbuluja yezwi zwinhu unshaji wose, kojoba muzwiziba akale zwakazikatila muchokomende chamunanacho. <verse eid="2PE 1:12" /><verse number="13" style="v" sid="2PE 1:13" />Ndoyeya kuti zwilolulama, kana ndichili mumbili yoyu, kumunyandula nokumukumbuluja, <verse eid="2PE 1:13" /><verse number="14" style="v" sid="2PE 1:14" />nokuti ndoziba kuti kufa kwangu kwabapelyo, sezwo Tezi wedu Jesu Kristo akanditondeja. <verse eid="2PE 1:14" /><verse number="15" style="v" sid="2PE 1:15" />Akale ndota kuti mushule mokushayika kwangu, mutubule nonshaji wose kukumbulukwa zwinhu yezwi.<verse eid="2PE 1:15" /></para>
  <para style="s">Basumikiji bakabona kungaima kwaKristo</para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16" />Atijakatobela ingano jakabumbwa nobusoso patakamuzibisa masimba nokuzha kwaTezi wedu Jesu Kristo, koga tibasumikiji bakabona namesho edu bukulwana bubwe. <verse eid="2PE 1:16" /><verse number="17" style="v" sid="2PE 1:17" />Nokuti paakatambula lukujo nokungaima kunaMwali Tate akale iwhi lyakezha kwaali nokuNgaima kuKulwana, “Yoyu Mwananhulumyana wangu unodikana, munaiye ndiloshanta kasa,” <verse eid="2PE 1:17" /><verse number="18" style="v" sid="2PE 1:18" />iwhi yeli takaliwha isu liva kudenga, nokuti takabeli naye mudunhu ijena.<verse eid="2PE 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19" />Tinanalyo iwhi lyechipolofita lilosimatijwa. Mungata zwibuyanana kuwhilila iwhi yeli sezwamunota kuchimuniko chimumunika munhilima, kujine kube kumijelo intanda ibhude mumyoyo yenu. <verse eid="2PE 1:19" /><verse number="20" style="v" sid="2PE 1:20" />Chokutanga mokwelela kuwhisisa yezwi, kuti apana chipolofita chomuWhalo inchena chinotolokwa muchido chonhu, <verse eid="2PE 1:20" /><verse number="21" style="v" sid="2PE 1:21" />nokuti apana chipolofita chakezha nokuda konhu, koga banhu besundwa noMpepo uNchena bakalebeleka zwinova kunaMwali.<verse eid="2PE 1:21" /></para>
  <chapter eid="2PE 1" />
  <chapter number="2" style="c" sid="2PE 2" />
  <para style="s">Balayiji boniepa</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1" />Kwakabeli nabapolofeti boniepa somumwakabeli balayiji boniepa bakabhuka bo mukati mwabanhu, sezwichooba balayiji boniepa mukati mwenu, bachabuza indayijo ilosisika inopalaja, belamba Tezi wakabatenga, bezwikokela kupalajwa nokukambijisa. <verse eid="2PE 2:1" /><verse number="2" style="v" sid="2PE 2:2" />Banji banootobela zwobuhungu bwabo, akale inzila yechokomende inootukwa pezhulu pabo. <verse eid="2PE 2:2" /><verse number="3" style="v" sid="2PE 2:3" />Mubupazwi bwabo banoomuchenga namawhi abo okuniepa, kuvila ntolo kulashwa kwabo kwakabeshinga pakati pabo, nokupalajwa kwabo akujakalekejwa.<verse eid="2PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4" />Kana Mwali asakalekejela ngilozi jabo pajakachinya akajisunga namaketani, akajiposela mugehena, akajibiga mumatizwa anomila anenhilima kujichalondotwa kuswikila kutongwa kwajo, <verse eid="2PE 2:4" /><verse number="5" style="v" sid="2PE 2:5" />kana asakalekejela inyika yantolo, koga akalondota Nowa, umbhaunuli wobululami, nabamwe bashanu banababili, paakabuza izhame pasi lyose lyabasina bumwali, <verse eid="2PE 2:5" /><verse number="6" style="v" sid="2PE 2:6" />kana akalasha makuta eSodoma neGomola nokuwapisa kubelota, akaata chibonelo cheezwo zwichatikana kunaabo basina bumwali, <verse eid="2PE 2:6" /><verse number="7" style="v" sid="2PE 2:7" />akale kana akachija Loti ulolulama, wakabejiijwa kasa nobusangu bwababi, <verse eid="2PE 2:7" /><verse number="8" style="v" sid="2PE 2:8" />nokuti zwaakabona unhu yoyu ulolulama akale nezwaakawha eligele mukati mwabo, wakayangata mumwoyo uwe ulolulama izhuba nezhuba nezwito zwabo zwisilolulama, <verse eid="2PE 2:8" /><verse number="9" style="v" sid="2PE 2:9" />kana zwili alo Tezi unoziba kuchija banabumwali mukukwejwa, akale nokulondota basakalulama mukulangwa kuswikila izhuba lyontongo, <verse eid="2PE 2:9" /><verse number="10" style="v" sid="2PE 2:10" />akale kasa yabo banongwina mululakamilo lwoluchibo lunoswibhisa akale belingila pasi butongi.</para>
  <para style="p" vid="2PE 2:10">Basinotya akale beli bamachinzebe, basinotya kutuka banongaima, <verse eid="2PE 2:10" /><verse number="11" style="v" sid="2PE 2:11" />kojoba ingilozi jilihulwana akale jilinesimba, ajitobapa milandu ina kutuka mbeli kwaTezi. <verse eid="2PE 2:11" /><verse number="12" style="v" sid="2PE 2:12" />Koga yaba banhu, semhuka jisinoyeya, zwibumbwa zwinota zwinhu zwisayeya, zwakazwalilwa kubhatwa zwibulayiwa, banotukana munyaya jibasinoziba, nenzila imwempelabo banoopalajwa semhuka, <verse eid="2PE 2:12" /><verse number="13" style="v" sid="2PE 2:13" />beyabulila luchinyo lubakata. Ibo banozwibona kuli kunakilijwa kuzwishantisa nezhoba masikati. Ibo bananga zwiswibhiso namabata eshambwa, mukunakilijwa kwabo kwezhoba, bezwishantisa namwi. <verse eid="2PE 2:13" /><verse number="14" style="v" sid="2PE 2:14" />Banamesho azhele bupomboli, besinogunchikana noluchinyo, banochengela bana butela mumyoyo, myoyo yabo ilolayijwa bupazwi, bana balofhizhwa! <verse eid="2PE 2:14" /><verse number="15" style="v" sid="2PE 2:15" />Basiya inzila iliiyo bakalashika, betobela inzila yaBhalamu, mwananhulumyana waBhiyo, wakabeda ingwano muzwito zwibi, <verse eid="2PE 2:15" /><verse number="16" style="v" sid="2PE 2:16" />koga wakakalalilwa muluchinyo lulwe, idonki chimumu lyakalebeleka newhi lyonhu zwakapeja imhengo jije umpolofeti.<verse eid="2PE 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17" />Yaba bananga mashawi asine vula akale ifulele limupungwa nebhepo, ibo balolonganyilwa bugalo mu nhilima ihulwana. <verse eid="2PE 2:17" /><verse number="18" style="v" sid="2PE 2:18" />Nokuti banozwitunha zwobulema namawhi apezhulu, bechenga nokushobela lulakamilo lwezwito zwombili zwobunhu bachinova mukupujumuka kunayabo banogala muluchinyo. <verse eid="2PE 2:18" /><verse number="19" style="v" sid="2PE 2:19" />Banobabimbisa lusununguko, koga ibo nokwabo beli balanda bobubi, nokuti yezwo zwinokoma unhu, kunaizwo iye undanda. <verse eid="2PE 2:19" /><verse number="20" style="v" sid="2PE 2:20" />Kana, bapujumuka mukuswibhiswa nenyika muluzibo lwaTezi noNchiji wedu Jesu Kristo, bangoobhatwa mububi, bakomwa, chimilo chabo chopejeleja chinooba chibi kasa kupinda chokutanga. <verse eid="2PE 2:20" /><verse number="21" style="v" sid="2PE 2:21" />Nokuti zwalubazwibuya kwabali ngana basakaziba inzila yobululami kuna kuti bebwilile mushule beva mundawo unchena ubakapiwa. <verse eid="2PE 2:21" /><verse number="22" style="v" sid="2PE 2:22" />Zwakatikana kwabali sezwinolebwa nechichimbe chechokomende, kuti, “Imbwa inobwilila kumafho ayo,” akale, “Ingulube yashambiswa inobwilila kunobumbuluka mumatope.”<verse eid="2PE 2:22" /></para>
  <chapter eid="2PE 2" />
  <chapter number="3" style="c" sid="2PE 3" />
  <para style="s">Chibimbiso chokuBuya kwaTezi</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1" />Banodikana yolu lukwalo lwabili lwandinomukwalila ngweno, akale munaijo jilimbili iwhalo ndanyandula mwamuli indangalilo yenu yechokomende nokumukumbuluja, <verse eid="2PE 3:1" /><verse number="2" style="v" sid="2PE 3:2" />ndoda kuti mukumbulukwe kupolofita kwabapolofeti bachena akale nomulawo waTezi noNchiji wakapiwa kunamwi nomubapositoli benu. <verse eid="2PE 3:2" /><verse number="3" style="v" sid="2PE 3:3" />Chokutanga, imwi mokwelela kuwhisisa yezwi, kuti banoheula banoozha mumazhuba okupejeleja, beheula besundwa nendakamilo jabo jimbi <verse eid="2PE 3:3" /><verse number="4" style="v" sid="2PE 3:4" />akale beti, “Chibimbiso chokuzha kukwe, chipi? Nokuti kuvila matate ashaika, zwinhu zwose zwendilambeli sezwizwakabeli kuvila kulupatuko.” <verse eid="2PE 3:4" /><verse number="5" style="v" sid="2PE 3:5" />Banolekeja nomwaza kulinga chitiko yechi, kuti newhi lyaMwali matenga akabaipo kuvila ntolo, akale inyika yakabumbwa kuva muvula itiwa nevula, <verse eid="2PE 3:5" /><verse number="6" style="v" sid="2PE 3:6" />Kupindila muvula, inyika yakabelipo noyo unshaji yakapalajwa nezhame lyevula yakaleyo. <verse eid="2PE 3:6" /><verse number="7" style="v" sid="2PE 3:7" />Koga newhi limwempela lyakalelo matenga nenyika zwipo ngweno zwilolondotelwa moto, nezhuba lyontongo nokupalajwa kwabanhu basina bumwali.<verse eid="2PE 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8" />Koga badikani musilekeje kulingisisa ichokomende yeli, kuti kunaTezi izhuba limwempela lingaba sechiulu chamakole, akale chiulu chamakole chingaba sezhuba limwempela. <verse eid="2PE 3:8" /><verse number="9" style="v" sid="2PE 3:9" />Tezi aanedontela nechibimbiso chiche sokubona kwabamwe bezwitola sedontela, koga unamoyondefu kwamuli, aatoda kuti kube noumwe uchapalala, koga kuti banhu bwose beshanduke.<verse eid="2PE 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10" />Koga izhuba lyaTezi linoozha sembava, akale pakalepo matenga anoopinda nonkuwaluzha unkulwana, akale zwinhu zwose zwinopalajwa nomoto, akale inyika zwose nezwimomukati zwinobwigwa pachena. <verse eid="2PE 3:10" /><verse number="11" style="v" sid="2PE 3:11" />Sezwo zwinhu zwose yezwi zwichapalajwa, imwi mokwelela kubabanhu balichini? Bupenyu bwenu bunokwelela kuba buchena akale mwakazwipila kunaMwali, <verse eid="2PE 3:11" /><verse number="12" style="v" sid="2PE 3:12" />somumwakamilila mukukambijisisa kuzha kwezhuba lyaMwali, nokuti idenga linoobangijilwa akale linyauswa, nezwinhu zwose nomoto! <verse eid="2PE 3:12" /><verse number="13" style="v" sid="2PE 3:13" />Koga zwindila muchibimbiso chiche tomilila idenga ipya akale nenyika impya muliimo munogala bululami.<verse eid="2PE 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14" />Nokudalo, badikani, mukamilila yezwi, sungwalani kuti muwanikwe musina kabata kana kubipisa, akale muli mulunyalalo naye. <verse eid="2PE 3:14" /><verse number="15" style="v" sid="2PE 3:15" />Akale tolani mwoyondefu waTezi wedu soluchijo. Somwanakwaina wedu unodikana Paulu wakamukwalila nobuchenjevu bwaakapiwa naMwali, <verse eid="2PE 3:15" /><verse number="16" style="v" sid="2PE 3:16" />elebeleka nezwi sezwaanota mumakwalo awe wose. Muna zwimwe zwinhu mukati mwamakwalo awe zwilemu kuwhisisa, zwokuti basinaluzibo nabasilojikama mukudimbwa kwabo banozwishandulila kova zwibapalaja, sezwabanota nejimwe iwhalo inchena.<verse eid="2PE 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17" />Nokudalo, imwi badikani, mwazwiziba yezwi kuchinonshaji, chenjelani kuti musipepulwe nolukanganiso lwabanhu basina mulawo akale kova mulashikilwa nokujikama kwenu. <verse eid="2PE 3:17" /><verse number="18" style="v" sid="2PE 3:18" />Koga kubukani muchipiwo nomuluzibo lwaTezi noNchiji wedu Jesu Kristo. Lukujo ngalube kunaiye, ngweno nokwe misiyose. Ameni.<verse eid="2PE 3:18" /></para>
  <chapter eid="2PE 3" />
</usx>