<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- NAMBYA TRANSLATION PROJECT</book>
  <para style="h">BaFilipi</para>
  <para style="toc1">Filipu</para>
  <para style="toc2">BaFilipi</para>
  <para style="toc3">BaFil</para>
  <para style="mt2">Lukwalo lwaPaulu</para>
  <para style="mt1">KUBAFILIPI</para>
  <para style="imt">Matangisilo</para>
  <para style="ip">Paulo wakakwalila banodimbwa kuFilipi, kungaba makumi mashanu ane gumi nemwempela mushule mokuzwalwa kwaKristo. Wakalukwala eli muntolongo kunoyeyelwa kuti wakabeli Romu. (BaFilipi 1.13), lukwalo lwakakwalilwa igubungano limo muguta lyeFilipi. Tingawha zwishoma nezwe Filipu kuva muwhalo yeMishingo. IFilipi yaluba iguta igulwana lyedunhu lyomuMasedoniya. Paulo naSilasi bakatanga igubungano panhu pamwempela, akale bakabeli bose muntolongo busiku bumwempela chete beli kwakale (Mishingo 16).</para>
  <para style="ip">Paulu angabe akabeli nezwinangwa zwinji mukukwala lukwalo yolu. Wakashingisa unsi yoyu kuboka igubungano nechipo chibakatumila pabakawa kuti wimomuntolongo (BaFilipi 4:10-19). Wakabazibisa nechimo chiche eli mutolongo akakumbila Timoti naEpafuloditasi kugubungano (BaFilipi 2:19-30) kutila kuti bebatambule akale belemekeje batungamili bose</para>
  <para style="iot">Zwilomumwa</para>
  <para style="io1">Paulo unotanga lukwalo nokumusa igubungano kuFilipi (BaFilipi 1:1-2)</para>
  <para style="io1">Unokobelana nabo chinyeulilo chechimo chaali mukati mwacho nezwibilailo zwaana nazwo (BaFilipi 1:3—2:30)</para>
  <para style="io1">Kova epa zwilayijo zwinji zwokulalama kwamaKristo (BaFilipi 3:1—4:9)</para>
  <para style="io1">Paulu unopejisa nokuboka igubungano lyokuFilipi nezwipo zwabo akale ebamusa (BaFilipi 4:10-23).</para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />Imi Paulu naTimoti, bashingi baKristo Jesu.</para>
  <para style="p" vid="PHP 1:1">Kubachena bose munaKristo Jesu baiko kuFilipi, madebuji bamakubungano nabadikoni.<verse eid="PHP 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 1:2" />Chipiwo kwamuli nolunyalalo lunova kunaMwali Tate bedu nokunaTezi Jesu Kristo.<verse eid="PHP 1:2" /></para>
  <para style="s">Unamato waPaulu Kuba Bali Babe</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />Ndinoboka Mwali wangu mukumukumbulukwa kwangu kwose, <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />unshaji wose wandinomunamatila mose, ndozwita nolushanto, <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />pezhulu pokubhatana kwedu namwi mundebo imbuya kuva kuzhuba lyotanga kuswika ngweno. <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />Akale ndinechokomende kuti iye Mwali wakatanga unshingo umbuya uchompejisisa nezhuba lyaKristo Jesu. <verse eid="PHP 1:6" /><verse number="7" style="v" sid="PHP 1:7" />Zwibuya kunami kuti ndiwhe ali pezhulu penu mose, mumo mumwoyo wangu, nokuti tose imwi nami tokobelana chipiwo, mose mukusungwa kwangu akale nomukulwila nechisimiso chendebo imbuya. <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />Nokuti Mwali unsumikiji wangu, kuti ndinomuzwimba chini mose noludo lwaKristo Jesu.<verse eid="PHP 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 1:9" />Akale unamato wangu kuti ludo lwenu lukubuke kasakasa, noluzibo akale nokuwhisisa zwose, <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />kutila kuti muvumile zwibuya, akale mube bachena basinandandu nezhuba lyaKristo, <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />mukazhajwa nonchelo wobululami bunozhila munaJesu Kristo, zwikuja nokutunhumwija Mwali.<verse eid="PHP 1:11" /></para>
  <para style="s">Kulalama ndiKristo</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />Banakwaina, ndinoda kuti muzibe, yezwi zwakatikana kwandili zwakabhancha kasa mukukwendesa indebo imbuya. <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" />Nokudalo zwazibikana kubalindi bonzinda waTezi wabaRoma nokunaibo bose kuti ndilosungilwa Kristo, <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />banakwaina banji bananolubimbo munaTezi pezhulu pokusungwa kwangu, akale balozwipila kulebeleka iwhi lyaMwali nesimba besina lutyo.<verse eid="PHP 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15" />Bamwe muchokomende bamubhaunula Kristo nokunyucha akale nonchilijano, koga bamwe mububuya. <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />Yabo bamuta mububuya noludo, banoziba kuti ndakabigwa yomuno nokulwila iNdebo iMbuya, <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />bamwe bakabepupula Kristo nomwoyo wobuchiba, betila kuti bepamije masheto angu ndili mutolongo.<verse eid="PHP 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PHP 1:18" />Ini biya? Munzila jose, kungaba kuniepejela kana mulebeswa, Kristo umupupulwa, akale munoozwo ndoshanta, <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />nokuti ndoziba kuti pezhulu peminamato yenu akale nolubhancho lwoMpepo waJesu Kristo yezwi zwinooshanduka kuba kusungunulwa kwangu. <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />Ishungu jangu kulingilila mulubimbo kuti muzwinhu zwose anditoswabiswa kana neni, nomwoyo unsimu wandinanawo, ngweno nonshaji wose, Kristo unokujwa mumbili wangu, kungaba mubupenyu kana mulufu. <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />Nokuti kwandili kulalama ndiKristo, akale kufa ingwano. <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />Kana kulikulalama mumbili, zwinoleba unshingo una michelo kwandili. Zwakadalo zwandichashala andingazwizibe. <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />Ndilosindamijwa kasa pakati pezwi zwibili. Chido changu ngechokuti ndinde ndinoba naKristo, yezwi zwibuya kasa, <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />koga kubampenyu kwangu mumbili yoyu zwinodikana kasa kwamuli. <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />Ndikaguchikana nezwi, ndoziba kuti ndichagala akale ndinobeli namwi mose, kutila kubhudilila kwenu nokushanta mukudimbwa, <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />kutila kuti mwandili muwane chisoko chilopamijika chokushiya munaKristo Jesu, nokuzha kwangu kabili kwamuli.<verse eid="PHP 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27" />Chete zwito zwenu zwobupenyu zwibe zwinokwelela indebo imbuya yaKristo, kutila kuti kana ndibuya koomubona kana ndisipo ndiwhe kuti mulobhatana mupepo umwempela mwakasima, mundangalilo imwempela mulwa mwakabhatana mulwila kudimbwa mundebo imbuya. <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />Musinotya chili chose kunabo bamunonyenyejana nabo. Yeli ishula lipopachena kwabali lyokupalajwa kwabo, koga lyochijwa kwenu, zwiva kunaMwali. <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />Nokudalo zwakapiwa imwi nokuda kwaKristo kuti amujilokwelela kudimbwa kunaiye chete, koga nokuunjabulila, <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" />mulimuhondo imwempela imwakabona, ngweno imukumuwha kuti ngiyangu.<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s">Kuzwininipisa noBukulwana bwaKristo</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />Nezwo kana kuli nokusungwajwa munaKristo, kana ini zwinonyungumula ludo, kana ini zwinoshingilana mumpepo, kana zwoludo neshe, <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />zhajikijani lushanto lwangu nokuba nendangalilo imwempela, noludo lumwempela, nemiyeyo nendangalilo imwempela. <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />Musite zwinhu mubuchiba kana kushiya, koga mukuzwininipisa mutole bamwe sababuya kunamwi. <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />Umwe noomwe wenu esilinge zwaanoda iye chete, koga nezwinodiwa nabamwe. <verse eid="PHP 2:4" /><verse number="5" style="v" sid="PHP 2:5" />Ibani nendangalilo yeyi pakati penu, ili yenu munaKristo Jesu,<verse eid="PHP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6" />Iye, kojoba akabeli muchimo chaMwali,</para>
  <para style="q2" vid="PHP 2:6">Ajakayeya kuzwitondejela nesimba kuti unokwelana naMwali,<verse eid="PHP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7" />koga wakasiya zwose,</para>
  <para style="q2" vid="PHP 2:7">akatola chimo choshingi,</para>
  <para style="q1" vid="PHP 2:7">akaba sonhu</para>
  <para style="q2" vid="PHP 2:7">akale akaboneka muchimo chonhu.<verse eid="PHP 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PHP 2:8" />Wakawanikwa muchimo chonhu, akazwininipisa akale akawhilila kuswikila afa,</para>
  <para style="q2" vid="PHP 2:8">kojoba lufu lopanchinjikwa.<verse eid="PHP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9" />Nokudalo Mwali wakokuja kasakasa,</para>
  <para style="q2" vid="PHP 2:9">akompa izina lipo pezhulu pamazina ose,<verse eid="PHP 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10" />Nokudalo izina lyaJesu likujwe,</para>
  <para style="q2" vid="PHP 2:10">zwibumbwa zwose kudenga penyika nomudako lyenyika</para>
  <para style="q2" vid="PHP 2:10">zwilokwelela kufugama,<verse eid="PHP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PHP 2:11" />akale indimi jose jipupule kuti Jesu Kristo ndiTezi,</para>
  <para style="q2" vid="PHP 2:11">kuti lukujo lube kunaMwali Tate.<verse eid="PHP 2:11" /></para>
  <para style="s">Kungaima soMwenje muNyika</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />Nokudalo, badiwa bangu, sezwo muwhilila unshaji wose, ngweno kusibe ndilipo koga kanji kube munshaji ndisipo, shingani luchijo lwenu nokutya nokuteketa, <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />nokuti Mwali ukumushinga mwamuli, kuti mude akale muzhajikije chinangwa chiche chibuya.<verse eid="PHP 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14" />Itani zwinhu zwose musinongunguna kana kunyenyeja, <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />kuti musibe nondandu mubebabuya, bana baMwali basina luchinyo pakati pechizwalwa chakakovomala akale chakalasha bunhu bwacho bwakalulama, pakati pabo mongaima somwenje munyika, <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />bhatililani kuwhi lyobupenyu, kutila kuti muzhuba lyaKristo ndishiye kuti andijakalabukila zwisipo kana kuti ndakashingila zwisipo.<verse eid="PHP 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 2:17" />Kojoba ndikadilwa sontebulo wokupila umpilo wokudimbwa kwenu, ndoshantilwa akale ndonakilijwa namwi mose. <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />Zwakadalo namwibo mokwelela kushanta nokunakilijwa nami.<verse eid="PHP 2:18" /></para>
  <para style="s">Timoti naEpafolodaitasi</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />Ndinobimba munaTezi Jesu kutuma Timoti kwamuli nokukambija, kutila kuti ndishantiswe nokuwha inyaya pezhulu penu. <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />Andina unanga saiye, uchabiga bugalo bwenu mumwoyo mumwe zwechokomende. <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />Bose bamwe banolinga zwobupenyu bwabo kusi zwaJesu Kristo. <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />Koga kubimbika kwaTimoti mokuziba, somwananhulumyana natate, kuti wakashinga chini nami mundebo imbuya. <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />Ndinobimba nezwo kuuntuma nokukambija pandichabona kuti ndotiwa chini, <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />akale ndinobimba munaTezi kuti munshaji umfupi imi nokwangu bo ndozha. <verse eid="PHP 2:24" /><verse number="25" style="v" sid="PHP 2:25" />Ndazwiyeya kasa kuti nditumile kwamuli Epafodaitasi mwanakwaina nonshingikwaina wangu, nondwikwaina, untumwa wenu akale elinshingi kundibhancha zwandinoshaiwa, <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />nokuti wabemuzwimba mose, akale eyabula nokuti mwakawha kuti wabelwala. <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />Chokomende wakabelwala, wakajofa. Asi Mwali wakonwhila ishe, kusi iye chete koga namibo, kuti ndisibe neshungu pezhulu peshungu. <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />Nokudalo imi ndimi ndilosungwala kasa kuuntuma, nditila kuti mushante nokuumbona kabili, kutila kuti kubilila kwangu kudelele. <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />Nezwo untambuleni munaTezi nolushanto lwose, akale mukuje banhu bakadai, <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />nokuti wakajofila unshingo waKristo, ebiga bupenyu bubwe mugubaji kutila kuti epejeleje unshingo wenu imwi umusakatubula kuta.<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s">Bululami bweChokomende.</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />Banakwaina bangu, pakujiba, shantani munaTezi. Azwitondinyaja imi kukwala zwinhu zwimwempela kwamuli, akale chitabilijo kunamwi. <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />Chenjelelani bananga sembwa, chenjelelani bashingi bobubi, chenjelelani banonyonyonganya umbili. <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />Nokuti timhalajo yechokomende, inonamata Mwali mumpepo, akale tishiya munaKristo Jesu, tisinobiga lubimbo mumbili. <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />Kojoba imi nokwangu ndinachisoko cholubimbo mumbili bo. Kana umwe unhu eyeya kuti unachisoko cholubimbo mumbili, imi ndinanacho chilopindilija, <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" />ndakamhalajwa nezhuba lyashanu lina matatu, ndili umwe wabaIzilayeli, woluji lwaBhenjamini, uHebhelu wakazwalwa namaHebhelu, kumulawo ndili umFalisi, <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" />mukusungwala ndili unjabisi wegubungano, kubululami ndipo pasi pomulawu ndisina ndandu. <verse eid="PHP 3:6" /><verse number="7" style="v" sid="PHP 3:7" />Ingwano yose indakawana, ndakaitola sokulashikilwa pezhulu paKristo. <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />Pezhulu paizwo zwose ndinolaba zwose sokulashikilwa pezhulu pokuziba Kristo Jesu Tezi wangu kunopinda zwose. Pezhulu pape ndakayabula kulashikilwa nezwinhu zwose, ndikazwilaba seshambwa, kutila kuti ndiwane Kristo, <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />akale ndiwanikwe mwaali, ndisina kululama kwangu, kunova mumulawo, koga bunova mukudimbwa munaKristo, bululami bunova kunaMwali buloyaama mukudimbwa, <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />kuti ndunzibe nesimba lyokumuka kukwe, akale kuti ndikobane naye mukuyabula kukwe, nditojane naye mukufa kukwe, <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />akale ndina chibimbo kuti ndowana kumuka kubafi.<verse eid="PHP 3:11" /></para>
  <para style="s">Kulabukila kuChinangwa</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />Kusi kuti yezwi ndakazwiwana kale kana kuti ndakapeleleswa kale, koga ndimulwisa kuti ndizwite zwangu, yezwo Kristo Jesu zwakanditila kale. <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />Banakwaina, anditoleba kuti chakaba changu, koga chinhu chimwempela chandinota, ndokanganwa zwimushule akale ndilwisila zwikombeli, <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />imi ndilwisila kundambeli kuchinangwa chombhailo wopezhulu undikumushobelwa naMwali munaKristo Jesu.<verse eid="PHP 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 3:15" />Tose takubuka mumpepo ngatibe nendangalilo yeyo, akale kana besina indangalilo yeyo, Mwali unoomuzhulila yezwo. <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />Atibhatilileni chete muchokomende kunezwo zwatakawana.<verse eid="PHP 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />Banakwaina shanganyilanani mukundikwejejela, akale lingisisani yabo banolalama betobela chitondejelo chibuya munasu. <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />Banji, bandakamubuja nozwabo tunjinji akale mane ngweno ndinomubuja ndilila, bagele sezwita zwonchinjikwa waKristo. <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />Mapejelejo abo kupalajwa, mwali wabo untumbu, akale beshiya nokuswaba kwabo, nendangalilo jipo pazwinhu zwenyika. <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />Koga bugalo bwedu bukokudenga, akale kuvila kwalili tilomilila unchiji, Tezi Jesu Kristo, <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />iye uchashandula mibili yedu yopasi inabutela kuti ibe sombili uwe wongaima, nesimba linota kuti etubule kubiga zwinhu zwose pasi pape.<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="s">Indayilo</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />Nokudalo, banakwaina bangu, bandinoda nokuzwimba, lushanto nechilemba changu, imani mwakasima nenzila yeyi munaTezi, badikani bangu.<verse eid="PHP 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />Ndimubweta Yudiya, naSintiki kuti bevumilane munaTezi. <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />Akale ndokukumbila bo, iwi kwaina wangu wechokomende, kuti ubhanche banhukaji yaba, nokuti bakashinga pamwepela nami mundebo imbuya, naKilementi nabamwe bose bashingikwaina bangu, banamazina abo muwhalo yobupenyu.<verse eid="PHP 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4" />Shantani munaTezi unshaji wose, akale ndinoti, Shantani.<verse eid="PHP 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 4:5" />Banhu bose ngebezibe kugontama kwenu. Tezi wabapelyo. <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />Musiyabujwe kana neni, koga muna zwose nomunamato nokubweta kuna kuboka mute kuti zwikumbilo zwenu zwizibikane kunaMwali. <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />Akale lunyalalo lwaMwali, lunopinda kuwhisisa kose, lunolondota myoyo nendangalilo jenu munaKristo Jesu.<verse eid="PHP 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8" />Kumapejelejo, banakwaina, chose chingaba ilebeswa, chose chinokujwa, chose chilolulama, chose chiloshambijika, chose chibhodo, chose chinolemekejwa, kana peli nezwibuya, kana peli nezwinokwelela kukujwa, yozwi zwinhu muzwiyeye. <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />Zwamwakalayijwa nezwamwakatambula nezwamwakawha nezwamwakabona kunami, zwiteni, Mwali wolunyalalo unooba namwi.<verse eid="PHP 4:9" /></para>
  <para style="s">Kuboka Chipo</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />Ndoshanta kasa munaTezi kuti ngweno mwamusilija chibilailo chenu nami, chokomende mwakabebilaila nezwangu, koga amujakabelina chibaka. <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />Kusi kuti ndikumulilijika nokushayiwa, nokudalo ndakalayijwa kuti, muna chipi chimo chandili, ndigutikane. <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />Ndokuziba kushayiwa, akale ndokuziba kufuma, muna chipi kana chipi chimo ndakalayijwa isiswa lyokumilana nobuji, akale nezhala, buwandi nokushayiwa. <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />Ndotubula kuta zwinhu zwose munaiye unondisimisa.<verse eid="PHP 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14" />Nezwo jakabeli ishe jenu kuti mukobelane nami injabulo jangu. <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />Akale imwi baFilipi mozwiziba yezwi kuti pandakatanga kubhaunula indebo imbuya kunamwi, pandakabhuda muMasedoniya, apana igubungano lyakabhatana nami penyaya yokupa nokutambula kuzhe kwenu chete, <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" />nokuti ndili kuTesalonika mwakatumija lubhancho kusi kamwempela. <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />Akutoba kuti ndimushaka chipo, koga ndimushaka ingwano ichopamija indipo yenu. <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />Ndakatambula indipo izhele, akale zwilopamijilwa, ndilozhajwa, ndakatambula zwipo zwimwakatumija kunaEpafodaitasi, umpilo unonhuwilila, untebulo unotambulika akale unoshantisa kunaMwali. <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />Mwali wangu unomukashulila zwose zwamunoda zwikwendelana nefuma nokungaima kukwe munaKristo Jesu. <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />Ngakube lukujo kunaMwali Tate bedu kwemisi isinopela. Ameni.<verse eid="PHP 4:20" /></para>
  <para style="s">Kumusa kopejeleja</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />Mumuse bachena bose munaKristo Jesu. Banakwaina bandinanabo bamumumusa. <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />Bachena bose bakumumusa kasa bengumba yaSiza.<verse eid="PHP 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23" />Chipiwo chaTezi Jesu Kristo ngachibe nompepo wenu.<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>