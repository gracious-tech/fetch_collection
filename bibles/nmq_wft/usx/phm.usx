<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- NAMBYA TRANSLATION PROJECT</book>
  <para style="h">Filimoni</para>
  <para style="toc1">Lukwalo lwaPaulu Kuna Filimoni</para>
  <para style="toc2">Filimoni</para>
  <para style="toc3">Fil</para>
  <para style="mt2">Lukwalo LwaPaulu</para>
  <para style="mt1">KUNAFILIMONI</para>
  <para style="imt">Matangisilo</para>
  <para style="ip">Iwhalo imfupi yaFilimoni yakakwalwa noMpositoli Paulu (Filimoni 1:1). Paulu wakabeli muntolongo eyikwala, zwinoyeselwa kuti wakayikwala eli kuLoma, zwinova kuti wakayikwala kwapinda makole makumi mashanu anegumi negole limwempela mushule mokuzwalwa kwaKristo, yoyu unshaji kunoyeyelelwa kuti ndiwo unshaji wakakwala BaKolose.</para>
  <para style="ip">Yeyi iwhalo wakayikwalila unhu waluwhi Filimoni. Filimoni waluba imhingu yegubungano akale elimweni wabalanda. Paulu wakonkwalila ekumbila kuti esilange undanda uwe Onesimasi wakabootizha. Mumulawo wechiLoma Filimoni wakabelina inkwelelo yokumbulaya Onesimasi. Paulu wakashingisa mawhi okubweta kusungwaja Filimoni kuti oontambule Onesimasi somwanakwaina muchiKristo akale nokupanikija kuti Onesimasi evumilwe kuti eshinge pamwempela naPaulu (Filimoni 1:13-14).</para>
  <para style="iot">Zwilomumwa</para>
  <para style="io1">Paulu unomusa Filimoni (Filimoni 1:1-3)</para>
  <para style="io1">Kova Paulu ebhuza ekamilila Onesimasi kuti Filimoni ontambule somwanakwaina muchiKristo (Filimoni 1:4-21)</para>
  <para style="io1">Paulu unopejeleja nokuzibisa chinangwa chiche chokushanya akale nokubalezwa (Filimoni 1:22-25)</para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />Imi Paulu, ndakasungilwa Kristo Jesu, naTimoti mwanakwaina wedu. Kuna Filimoni unshingikwaina wedu unodikana <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />naAfiya unkazwaji wedu naAkipasi undwikwaina, negubungano linoshangana mungumba yiyo. <verse eid="PHM 1:2" /><verse number="3" style="v" sid="PHM 1:3" />Chipiwo nolunyalalo lunova kunaMwali Tate bedu naTezi wedu Jesu Kristo lubekwamuli.<verse eid="PHM 1:3" /></para>
  <para style="s">Ludo LwaFilimoni noLubimbo</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />Ndoboka Mwali wangu unshaji wose pandinokumbulukwa muminamato yangu, <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />nokuti ndikumuwha nezwokudimbwa kuko munaTezi Jesu Kristo noludo lulo kubachena bose, <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />akale ndonamata kuti kukobelana kokudimbwa kuko kunyamule luzibo lwobubuya bwedu bwose munaKristo. <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />Mwanakwaina wangu ndakawana kushanta kukulwana nokunyalajwa muludo lulo, nokuti myoyo yabachena yakatonhojwa nokupindila mwauli.<verse eid="PHM 1:7" /></para>
  <para style="s">Kukumbilwa kwaOnesimasi</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />Nezwo, kojoba ndili nefuba munaKristo kuti ndikulaye kuti ute zwinodikana, <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />koga pezhulu poludo ndoshala kukubwetekeja, ngweno imi, Paulu, umililili akale wakasungilwa Kristo Jesu, <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />ndokubwetekeja ndikumbilila mwana wangu, Onesimasi, undakaba tate babe mukusungwa kwangu. <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />Pakutanga aajakabelina lubhancho kwauli, koga ngweno unanolubhancho kasa kwauli nokwandili.<verse eid="PHM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12" />Ndimuumbwiliza kwauli Onesimasi, iye wandinoda sokutumija nomwoyo wangu kwauli. <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />Ndalushanta kasa kugala naye, kutila kuti endishingile akamilila iwi nonshaji wangu wokusungilwa indebo imbuya, <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />koga andijakashala kuta chinhu usandivumila kutila kuti bubuya bubo busibe bwokumanikijwa koga bomwoyo ulosupuka.<verse eid="PHM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15" />Pamwe ndizwo akapambukana nawi konshaji, kuti ube naye kwemisi yose, <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />esichili undanda koga zwinopindilija bulanda, somwanakwaina unodikana, kasa kwandili koga zwilopamijika kwauli, sonhu akale mwanakwaina munaTezi.<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />Kana unditola soumwe uwo, untambule nenzila yawalunditambula nayo. <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />Kana akakubipisila, kana elina chikwelete chicho, ilipisa imi. <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />Imi Paulu ndinokwala yezwi noluboko lwangu, ndinolipa—pesina zwandinoleba nezwe chikwelete chaunanacho iwi, kwandili chobupenyu bubo. <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />Nokudalo, mwanakwaina, ndibhanche somwanakwaina munaTezi. Tonhoja mwoyo wangu munaKristo.<verse eid="PHM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21" />Ndinanolubimbo lwokuwhilila kuko, ndokwala kwauli, ndiziba kuti unota zwinji kupinda zwandaleba. <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />Nonshaji wakalewo, undibambanyile ingumba yabezi, nokuti ndinobimba kuti neminamato yenu ndichavumila kwamuli.<verse eid="PHM 1:22" /></para>
  <para style="s">Kumusa koPejeleja</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />Epafulasi unsungwakwaina munaKristo Jesu, ukumukumusa, <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />akale naMako, Alisitakasi, Dimasi, naLuka, bashingikwaina bangu bakumukumusa naibo.<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />Chipiwo chaTezi Jesu Kristo chibe nompepo wenu.<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>