<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">-NAMBYA TRANSLATION PROJECT</book>
  <para style="h">BaGalatiya</para>
  <para style="toc1">Lukwalo lwaPaulo Kuba Galatiya</para>
  <para style="toc2">BaGalatiya</para>
  <para style="toc3">Gal</para>
  <para style="mt2">Lukwalo lwaPaulo</para>
  <para style="mt1">KUBAGALATIYA</para>
  <para style="imt">Matangisilo</para>
  <para style="ip">Iwhalo yabaGalatiya yakakwalwa nompositoli Paulu ( BaGalatiya 1:1). Yakaba ili whalo Paulu yaakakwalila kumakubungano okuGalatiya makole angaba pakati pamakole makumi mana anamashanu namatatu kuswikila makole makumi mashanu anamabili mushule kokuzwalwa kwaJesu Kristo. BaGalatiya bangaba bakabeli banhu bakaba begala kuGalatiya idunhu lyokuRoma. Babhati boluzibo banji abana luzibo kuti Paulu wakaba eli kupi paakabekwala lukwalo yolu, koga makuta eEfesasi neKolinte angaba eli iwo kwaakakwalila.</para>
  <para style="ip">Paulu wakakwalila maKristo echiJuda naasi echiJuda, mumakubungano omuGalatiya. Wakakwala enyenyeja indayijo yamaniepwa yakaba iti maKristo akaba ekwelela kutobela milawo yechiJuda yomuChivumilano Chantolo, kasakasa kumhalajwa. Kwakaba kuli negapo lyabanhu mumaKristo akaba ewhi banoshandulila kuchiJuda bakaba beda kuti yabo basi baJuda bemhalajwe. Akale bakanyenyeja bupositoli bwaPaulu.</para>
  <para style="ip">Paulu wakakwalila bupositoli bubwe nokubabuja zwakatikana mubupenyu bubwe ( BaGalatiya 1:11—2.14) akale wakalwila iNdebo iMbuya nokupandulula kuti luchijo lunowanika chete nokudimbwa munaJesu Kristo (BaGalatiya 2:16) Yezwi zwinowanikwa neshe jinova kunaMwali kusikuta kwabanhu.</para>
  <para style="iot">Zwilomumwa</para>
  <para style="io1">Paulu unotanga lukwalo lulwe nokumusa makubungano omuGalatiya (BaGalatiya 1:1-5)</para>
  <para style="io1">Paulu esiko pandulula zomushule zwaakata kulwilila kulayija akale nokuti wakakweja kulalama nomulawo asi zwijakabhancha (BaGalatiya 1:6—2:21)</para>
  <para style="io1">Esikondilambeli epandulula unshingo wondawo nechipiwo muluchijo (BaGalatiya 3:1—4:31)</para>
  <para style="io1">Akale esikopa indayo jilosiyanasiyana jokulalama chiKristu chibuya (BaGalatiya 5:1—6:10)</para>
  <para style="io1">Paulu unopeja lukwalo lulwe nokumusa akale epa chikumbilo chopejeleja kuti bekumbulukwe kuti kushandulwa naMwali kuba unhu umpya zwilokosha kasa kupinda milawo yokuzhe, sowokumhalajwa (BaGalatiya 6:1-18)</para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />Imi Paulu umpositoli, anditova kubanhu kana pezhulu ponhu, koga munaJesu Kristo naMwali Tate, bakoumusa mubafi, <verse eid="GAL 1:1" /><verse number="2" style="v" sid="GAL 1:2" />akale nabo bose banakwaina bandina nabo,</para>
  <para style="p" vid="GAL 1:2">Kumakubungano okuGalatiya.<verse eid="GAL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3" />Chipiwo nolunyalalo ngazwibe namwi, zwiva kunaMwali Tate nokunaTezi wedu Jesu Kristo.<verse eid="GAL 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 1:4" />Iye wakazwipila pezhulu poluchinyo lwedu, kuti etimunule kuva kububi bwonshaji wangweno, sokuda kwaMwali Tate bedu, <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />kuna iye ngakube lukujo kujine kube lini nalini. Ameni.<verse eid="GAL 1:5" /></para>
  <para style="s">Indebo imbuya imwempela</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />Ndilochenama kuti mukumukambija kuundamba, iye wakamushobela muchipiwo chaKristo akale mushandukila kundebo ilosiyana, <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />akutoba kuti kuna neNdebo iMbuya imwe, koga kuna bamwe bakumumushunda, beda kushandula iNdebo iMbuya yaKristo. <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />Kojoba isu kana ingilozi inova kudenga ibhaunula iNdebo iMbuya kwamuli, ilosiyana nendiya yatakamubhaunulila, ngefhizhwe. <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />Sezwatakaleba kale, feno ndinoleba akale, kana umwe emubhaunulila iNdebo iMbuya imwe kuna yeyi yamwakatambula, ngefhizhwe.<verse eid="GAL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10" />Biya feno ndinoda kuti ndidikanwe nabanhu kana naMwali na? Kana ndinobabalila kushantisa banhu na? Ngana ndabechinoshantisa banhu, andaluba unshingi waKristo.<verse eid="GAL 1:10" /></para>
  <para style="s">Inzila Paulo yaakaba umpositoli nayo</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />Banakwaina, ndinomuzibisa kuti iNdebo iMbuya yakapupulwa nami aitoba iNdebo iMbuya yakava kunhu. <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />Nokuti andijakaitambula kuva kunhu, kana kuilayijwa, asi yakezha nokutondejwa naJesu Kristo.<verse eid="GAL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13" />Nokuti mwakawha ungalilo wangu wantolo ndichimukudimbwa kwabaJuda, kuti ndakajiija igubungano lyaMwali zwikulwana ndikweja kulipalaja, <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />akale muna zwobuJuda, ndakapinda banji isamwali jangu boluji lwangu, ndikasungwala zwikulwana nengalilo yamatate angu.<verse eid="GAL 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15" />Koga Mwali wakabandishala Ndisanhu ndazwalwa akale wakandishoba nechipiwo chiche, <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />wakashanta kutondejela Mwananhulumyana uwe kunami, kutila kuti ndibhaunule iNdebo iMbuya nezwizwe kubanhu Bokuzhe, andijakabhuza unhu, <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />kana kunda kuJelusalema kunaabo bakabeli bapositoli mbeli kwangu, koga ndakenda kuAlabhiya akale ndikabwilila kuDamasikasi. <verse eid="GAL 1:17" /><verse number="18" style="v" sid="GAL 1:18" />Kwapinda makole matatu, ndakenda kuJelusalema kunoshanyila <note caller="+" style="f"><char style="fr" closed="false">1:18 </char><char style="ft" closed="false">Pita</char></note>Kefasi, ndikagala naye mazhuba igumi namashanu. <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />Koga andijakabonana nomwe wabamwe babapositoli kuzhe kwaJemusi ununa waShe.<verse eid="GAL 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 1:20" />Kunezwi zwandimumukwalila, pambeli paMwali, anditoniepa!<verse eid="GAL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21" />Ndipo pandakenda munyika jeSiliya neSilisiya. <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />Ndakaba ndisinozibwa nechiso namakubungano aKristo omuJudiya. <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />Bakabewha chete kuti, “yondiya wakabetijiija, ukumubhaunula ngweno luvumilo lwaakabeda kupalaja.” <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />Bakava bakuja Mwali pezhulu pangu.<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s">Paulu nabamwe baPositoli</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />Mushule mwamakole igumi namana ndakenda kuJelusalema ndili naBhanabhasi naTayitasi. <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />Ndakenda nokuda kwechitondejelo, akale ndikabhaunula indebo imbuya yandakabe ndibhaunula kuna Bokuzhe, ndishangana zwilosisikana nabatungamilili balokosha. Ndaludisisa kasa kuba nechokomende kuti ndikumulabukila zwipo akale kuti ndakalabukila zwipo. <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />Koga kana iye Tayitasi wakabeli nami, aajakamanikijwa kumhalajwa kojoba wakabeli unGiliki. <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />Koga yeyi nyaya yokumhalajwa yakamuswa nabanakwaina bamaniepwa bakangwiniswa zwilosisika, bakezha kofukula kusupuka kwedu kwatina nako munaKristo Jesu, kutila kuti betibuze mubuzike, <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />koga atijakazwibiga pasi pabo kana konshaji, kuti ilebeswa lyeNdebo iMbuya lilondotelwe imwi.<verse eid="GAL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6" />Yabo baluba nezwigalo zwopezhulu zwinolemekejwa, kana ini zwabaluba apana zwazwinoleba kwandili, Mwali atotondeja lushalulo, yabo balulemekejwa apana zwibakapamija pandili. <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />Koga, pabakabona kuti ndakapiwa unshingo weNdebo iMbuya kunaabo basakamhalajwa, saPita mwaaluba kuna bakamhalajwa. <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />Nokuti iye wakashinga munaPita sompositoli kuna bakamhalajwa, wakabeshinga nokunami sompositoli kuna Bokuzhe. <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />Akale pabakabona chipiwo chandakapiwa, Jemusi, naKefasi naJoni yabo bakabeli madabiko alokosha, bakatitambula nenzila yokukamujana, imi naBhanabhasi, kuti tinde kunaBokuzhe asi ibo benda kuna balomhalajwa. <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />Zwabakakumbila ndizwokuti tindilembeli tikumbuluka banoyabula, ndicho chinhu chandaludisisisa kuta.<verse eid="GAL 2:10" /></para>
  <para style="s">Paulu unokalalila Kefasi kuAntiyoku</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />Yopo <note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">Pita</char></note>Kefasi paakezha kuAntiyoki, ndakanyenyejana naye tikalingana nokuti wakama elinondandu. <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />Nokuti bamwe banhu besanu bava kunaJemusi, walusolya naBokuzhe. Koga pabakaswika wakatanga kubwilila mushule akale akazwipambula kwabali, nokutya igapo lyabalomhalajwa. <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />Akale bose baJuda bakatobela kusobimbika kukwe, zwakatisa kuti Bhanabhasi naiye etobele kusobimbika kwabo. <verse eid="GAL 2:13" /><verse number="14" style="v" sid="GAL 2:14" />Koga pandakabona kuti abajakabakama pechokomende cheNdebo iMbuya, ndakati kunaKefasi mbeli kwabo bose, “kana iwi, kojoba uli unJuda ulalama sowoKuzhe akale sousi unJuda, ungabhata nesimba chini kuti Bokuzhe betobele ungalilo wabaJuda?”<verse eid="GAL 2:14" /></para>
  <para style="s">MaJuda naBokuzhe banochijwa nokudimbwa</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15" />Isu nokwedu, tibaJuda nokuzwalwa akale “bachinyi Bokuzhe”, <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />tiziba kuti unhu aatolulamiswa nemishingo yomulawo, koga nokudimbwa munaJesu Kristo, nezwo nasubo, takadimbwa munaKristo Jesu, kuti tilulamiswe nokudimbwa munaKristo, akale kusi mishingo yomulawo, nokuti nemishingo yomulawo apana uchalulamiswa. <verse eid="GAL 2:16" /><verse number="17" style="v" sid="GAL 2:17" />Koga kana mukushaka kwedu kululamiswa munaKristo, isu nokwedu takawanikwa tili bachinyi, Kristo waba umililili wabachinyi na? Pe azwitoba alo! <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />Kana ndikabaka bupya akale yezwiya zwandakakolomola, nezwo ndinoba ndili umbipisi. <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />Nezwo imi pezhulu pomulawu ndakafa kumulawo, kuti ndilalame kunaMwali. <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />Ndakakahamilwa naKristo, akuchili imi ndikumulalama, koga Kristo unolalama mwandili, akale bupenyu bwandinolalama ngweno mumbili, ndinolalama nokudimbwa muMwananhulumyana waMwali, iye wakandida akazwipila pezhulu pangu. <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />Anditolamba chipiwo chaMwali, nokuti ngana kululamiswa kwakaba kuwanikwa nomulawo, nokudalo Kristo waluba akafila zwisipo.<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s">Mulawo kana kudimbwa</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />Imwi baGalatiya malengende! Ndiani wakamulowa? Mbeli kwamesho enu Jesu Kristo wakatondejelwa pachena ndiye wakakahamilwa panchinjikwa. <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />Ndimubhuze yechi chete, mwakatambula uMpepo nemishingo yomulawo, kana nokudimbwa zwamwakawha? <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />Ani mumalengende na? Zwamakatanga noMpepo, biya mungojibija nozwombili na? <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />Zwakatikana kwamuli zwinji azwitoleba chinhu na? Chokomende zwina zwazwinoleba. <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />Ani iye unomupa uMpepo nokuta zwichenamiso pakati penu unota alo nemishingo yomulawo, kana nokuwhilila muli nokudimbwa.<verse eid="GAL 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6" />Yeyani Abhulahamu, “wakadimbwa kuna Mwali, zwikalangalilwa kuti bululami kuna iye.” <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" />Nokudalo mubweni kuti banhu banodimbwa, ndibo bana baAbhulahamu. <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />Akale nolukwalo, lubona zwikombeli kuti Mwali unoolulamisa boKuzhe nokudimbwa, lwakabhaunula indebo iMbuya zwisanu zwatikana kunaAbhulahamu, luti “Munawi induji jose jinookombolelwa.” <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />Nokudalo, yabo banhu banodimbwa balokombolelwa pamwempela naAbhulahamu wakabedimbwa.<verse eid="GAL 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10" />Nokuti bose banobimba nemishingo yomulawo balofhizhwa, sezwazwilokwalwa kuwhi, “Ngefhizhwe unhu wose usinotobeleja zwinhu zwose zwilokwalwa mulukwalo lomulawo, nokuzwita.” <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />Ngweno zwipopachena kuti apana unhu unolulamiswa mbeli kwaMwali nomulawo, nokuti, “Iye ulolulama unolalama nokudimbwa.” <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />Koga mulawo aunani nezwokudimbwa, nokuti, “Iye unoilondota unoolalama nayo.” <verse eid="GAL 3:12" /><verse number="13" style="v" sid="GAL 3:13" />Kristo wakatisunungula mukufhizhwa kwomulawo, nokuti iye wakaba chifhizho nokuda kwedu, sezwazwilokwalwa kuwhi, “Ulofhizhwa unhu wose ulolengelela panti” <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />kuti munaKristo Jesu chikombolelo chaAbhulahamu chingezha pana boKuzhe, kuti titambule chibimbiso choMpepo nokudimbwa.<verse eid="GAL 3:14" /></para>
  <para style="s">Mulawo nechibimbiso</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />Banakwaina, lingani ndimupe unkwejaniso wezwinhu zwinotikana mazhuba ose, apana unojima chido chonhu kana kupamija pezhulu pacho, kana chavumilanwa. <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />Ngweno zwibimbiso zwakatiwa kunaAbhulahamu nokunzwalo iye. Iwhalo ayitoleba kuti, “Nokunzwalo jije,” ileba inji, asi ileba imwempela, “Akale kunzwalo iyo,” ileba Kristo. <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />Chandimuleba ndiyechi, mulawo, wakoozha kwapinda makole mazana mana namakumi matatu aungajime chivumilano chakavumilanwa naMwali kuti chibimbiso chisishinge. <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" />Nokuti kana ifuma ipiwa nomulawo, azwichizwechibimbiso koga Mwali wakaipa Abhulahamu nechibimbiso.<verse eid="GAL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19" />Biya mulawo ngoweni? Wakapamijwa nokubaipo kwezwibi, kuswikila inzwalo yaswika kunaiyo chibimbiso kuchakatiwa, akale wagajwa nengilozi nomumililili. <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />Ngweno umililili unoleba banji, koga Mwali umwempela.<verse eid="GAL 3:20" /></para>
  <para style="s">Chinangwa chomulawo</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />Ani mulawo unolwisana nezwibimbiso zwaMwali na? Azwitoba alo, nokuti kana mulawo watalwa unota kuti kube nobupenyu, nokudalo bululami bwalubuzwa nomulawo. <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />Koga lukwalo lunobiga zwinhu zwose pasi poluchinyo, kuti yezwo zwakabimbiswa mukuvuma munaJesu Kristo zwipiwe yabo banodimbwa.<verse eid="GAL 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23" />Ngweno kudimbwa kusanu kwabayipo, takabakakonyelwa pasi pomulawu, takasungwa kuswikila kudimbwa kwaputunulwa. <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />Nokudalo mulawo wakaba undondoti wedu kujine Kristo aswika, kuti tilulamiswe nokudimbwa. <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />Koga ngweno sezwo kudimbwa lwaswika, atichili pasi pondondoti.<verse eid="GAL 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26" />MunaKristo Jesu imwi mose mubana baMwali nokudimbwa, <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />nokuti mwakabhabhatizwa munaKristo, mwambala Kristo. <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />Akuchina unJuda kana unGiliki, akuchina unzike kana unsungunuki, akuchina unhulume kana unhukaji, nokuti mose muchinhu chimwempela munaKristo Jesu. <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />Akale kana muli baKristo, nezwo muli benzwalo yaAbhulahamu, balyifumi sechibimbiso chakatiwa.<verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />Zwandinoleba ndizwezwi, kana undyifuma echi mwana aajilosiyana nondanda pe, kojoba eli mweni wefuma. <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />Koga unoba eli pasi pabalondoti nababhati kujine kuswike unshaji wakatalwa natate. <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />Nenzila inokwelana nasubo patakaba tili bana, takabeli balanda tili pasi pemipepo yenyika. <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />Koga unshaji pawakaswika, Mwali wakatuma Mwananhulumyana uwe, wakazwalwa nonhukaji, wakazwalilwa pasi pomulawu, <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />kuti echije yabaya bakaba beli pasi pomulawu kuti titambulwe sabana.<verse eid="GAL 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 4:6" />Nokuti mubana, Mwali wakatumila mumyoyo yedu uMpepo woMwananhulumyana uwe, unoshomeja uti, “<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">Zwinoleba kuti Tate mululimi lwechiAlamaiki</char></note>Abha! Tate.” <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />MunaMwali auchi undanda, koga mwana, nezwo nokuti umwana, undyifuma.<verse eid="GAL 4:7" /></para>
  <para style="s">Kubilaila kwaPaulu pezhulu pabaGalatiya</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />Pemishaji yakapela, musanu mwaziba Mwali, mwakaba mulibazike kuzwibumbwa zwisi zwimwali, <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />koga feno sobumwabaziba Mwali, kana kuti mwazibwa naMwali, mungabwilila chini akale kumipepo yobutela neyokujiila, yamunoda kuba balanda bayo akale? <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />Munolondota mazhuba, nemyeji, nemyaka namakole! <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />Ndikumutya kuti ndakamushingila nesimba zwisipo.<verse eid="GAL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12" />Banakwaina, ndikumumubweta kuti mube sami, nokuti imi ndakaba samwi. Amuna chinhu chamwakandichinyila pe, <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />Moziba kuti chakata kuti ndimubhaunulile iNdebo iMbuya panshaji wokutanga, ndichokuti ndakaba ndilwala. <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />Koga amujakandishasha kana kundishunda kojoba bulwaji bwangu bwakaba buli chikwejo kwamuli, koga mwakanditambula sengilozi yaMwali kana kuti saKristo Jesu. <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />Kugunchikana kwamwakabewha kwakenda kupi biya? Nokuti ndinomupupulila, kana zwakabetubulika, mwalubhisa mesho enu mundipa. <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />Ani biya ndaba umbengi wenu na, nokumubuja ichokomende?<verse eid="GAL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17" />Yabo banhu banota soti banoda kumubhancha, belinechinangwa chisi chibhodo, chinhu chabanobabalila ndichokuda kumubhisa kwatili, kuti mute zwabanoda. <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />Zwibuya kusungwala, kana chinangwa chili chibuya, nokugala zwitiwa alo, kusibe chete kana ndili namwi. <verse eid="GAL 4:18" /><verse number="19" style="v" sid="GAL 4:19" />Bana bangu batukutuku, imwi bandinowhila kulwaja sokwemimba, kuswikila Kristo abumbwa munamwi! <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />Ndajoda kuti saali ndili namwi feno kutila kuti ndishandule inzila yokulebeleka kwangu, nokuti andichinoziba kuti ini chandingate namwi.<verse eid="GAL 4:20" /></para>
  <para style="s">Unkwejaniso waHaga naSala</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />Ndibujeni imwi munoda kuba pasi po mulawo, amuwhile zwimulebwa nomulawo na? <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />Nokuti kulokwalwa kuti Abhulahamu wakabeli nabana banhulumyana babili, umwe wondandakaji nomwe wonhukaji ulosungunuka. <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />Mwananhulumyana wondandakaji wakazwalwa kwombili, koga wonhukaji wosungunuko wakazwalwa nechibimbiso. <verse eid="GAL 4:23" /><verse number="24" style="v" sid="GAL 4:24" />Yoyu unkwejaniso, wabanhukaji yaba babili zwivumilano zwibili, umwe unova kudunhu lyeSinai, ezwala bana bachooba balanda, ndiHaga. <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />Ngweno Haga ulomilila idunhu lyeSinai muAlabhiya, unokwendelana neJelusalema lyangweno, nokuti umo mubulanda nabana babe. <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />Koga iJelusalema lipopezhulu lilosungunuka, ndibo amai bedu. <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />Nokuti kunokwalwa kuwhi,</para>
  <para style="q1" vid="GAL 4:27">“Shanta, iwi mhanje usinozwala,</para>
  <para style="q2" vid="GAL 4:27">pululuja ushomeje, iwi usakawha kulwaja kwemimba,</para>
  <para style="q1" vid="GAL 4:27">nokuti bana bonhukaji yondiya wakalambwa banji,</para>
  <para style="q2" vid="GAL 4:27">kupinda bana bonhukaji ulolobolwa.”<verse eid="GAL 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28" />Ngweno imwi, banakwaina, saIsaki, mubana bechibimbiso. <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />Nonshaji yondiya, iye wakazwalwa nokwombili wakashetesa wakazwalwa nokoMpepo sezwazwili ngweno. <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />Koga iwhalo inotini? Inoti “Tatamila undandakaji nomwananhulumyana uwe, nokuti mwananhulumyana wondandakaji aatolya ifuma panu pamwempela nomwananhulumyana wonhukaji wakasungunuka.” <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />Nezwo, banakwaina, atitoba bana bondandakaji koga bonhukaji ulosungunuka.<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="s">Londotejani Lusungunuko Lwenu</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />Kristo wakatisungunula kuti tibe nolusungunuko. Nokudalo mume mwakasima, musivume akale ijogwe lyobulanda.<verse eid="GAL 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2" />Ngweno imi, Paulu ndinoti kwamuli, kana muvumila kumhalajwa, Kristo aana lubhancha kwamuli. <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />Akale ndinosumikija kunhulume wose unovuma kumhalajwa, kuti ulosungilwa kulondota mulawo wose. <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />Mulopambulanywa naKristo, imwi munolulamiswa nomulawo, mwabhuda muchipiwo. <verse eid="GAL 5:4" /><verse number="5" style="v" sid="GAL 5:5" />Nokuti noMpepo, nokudimbwa tilomilila lubimbo lobululami. <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />Nokuti munaKristo Jesu kumhalajwa kana kusomhalajwa akutobhancha chinhu, asi chinhu chinodikana kudimbwa kushinga muludo. <verse eid="GAL 5:6" /><verse number="7" style="v" sid="GAL 5:7" />Mwakaba mulabuka zwibuyanana, mwakachingilijwa nani kuti musiwhilile ichokomende na? <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />Yoku kubweteja akutova kuna iye unomushoba. <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" />Imbiliso inshomanana inobilisa <note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">Ivingwa lyefulawa</char></note>ivingwa lyose. <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />Ndinobimba munaShe kuti amutooba nendangalilo jakasiyana nejangu, koga unomunyaja, unouwana untongo uwe, kojoba akaba ani. <verse eid="GAL 5:10" /><verse number="11" style="v" sid="GAL 5:11" />Koga imi, banakwaina, kana ndichinobhaunula imhalajo, ndosheteselwani na? Saali chigubhuliso chonchinjikwa chabhiswa. <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />Yabo banomunyaja, bezwisunyule bomene.<verse eid="GAL 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13" />Banakwaina, mwakoshobelwa lusungunuko, koga chete lusungunuko yolwo lusitiwe kuba inzila yokushantisa mbili, koga mushingilane muludo. <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />Nokuti mulawo wose ulozhulijwa mubala limwempela, “Ida umbakijani uwo sobuunozwida iwi.” <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />Koga kana mulumana, mulyana, muchenjele kuti musipejane.<verse eid="GAL 5:15" /></para>
  <para style="s">UMpepo noLubumbilo Lonhu</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />Nokudalo ndinoti, mukwende noMpepo, musishantise zwilakamilo zwombili. <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" />Nokuti zwilakamilo zwombili zwinopesana noMpepo, nezwilakamilo zwoMpepo zwinopesana nombili, nokuti yezwi zwinonyenyejana, kutila kuti zwimutabilije kuta zwamunoda. <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />Kana mutungamililwa noMpepo amuchipo pasi pomulawu. <verse eid="GAL 5:18" /><verse number="19" style="v" sid="GAL 5:19" />Mishingo yombili ipo pachena, Kupombola, bushambwa, busangu <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />kukomba zwimwali, bulowi, lubengano, kukakabajana, ifupa, kunyema, lulyo, kusowhililana, kupambukana, <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />kuchiba, kukolwa, kushantisa mbili, nezwimwe zwakadalo. Ndinomuchenjeja, sezwandakamuchenjeja kale, kuti banota zwakadai abangalye ifuma yobushe bwaMwali. <verse eid="GAL 5:21" /><verse number="22" style="v" sid="GAL 5:22" />Koga unchelo woMpepo, Ludo, lushanto, lunyalalo, moyo ndefu, ishe, bubuya, kubimbika, <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />bunyolo, kuzwibhata, kunezwi akuna mulawo unolambija yozwi. <verse eid="GAL 5:23" /><verse number="24" style="v" sid="GAL 5:24" />Yabo baKristo Jesu bakakahamila mibili yabo panchinjikwa nezwilakamilo nezwido zwabo. <verse eid="GAL 5:24" /><verse number="25" style="v" sid="GAL 5:25" />Kana tilalama noMpepo, ngatikwendeni takatungamililwa noMpepo. <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />Ngatileke kuzwida, kutangana, nefupa umwe kunoumwe.<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="s">Nyamulilanani Mitolo</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />Banakwaina, unhu angabhatwa muluchinyo, imwi bompepo, undulamiseni nolupepo lobunyolonyolo. Muchenjelebo imwi mwomene kuti musikwejwe. <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />Nyamulisanani mitolo, nokuta alo muzhajise mulawo waKristo. <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />Nokuti kana umwe eyeya kuti ulokosha iye pesina zwaali, unozwichengeja. <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />Koga unhu wose ngeelingisise ungalilo uwe, nokudalo chisoko chiche chokuzwikuja chinobeli mwaali chete, chisi mukuzwikwelanisa nombakijani uwe. <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />Nokuti unhu nonhu unokwelela kunyamula untolo uwe. <verse eid="GAL 6:5" /><verse number="6" style="v" sid="GAL 6:6" />Iye unolayijwa iwhi lyaMwali ngeekobelane zwinhu zwose zwibuya nondayiji uwe. <verse eid="GAL 6:6" /><verse number="7" style="v" sid="GAL 6:7" />Musichengwe, Mwali aatosekwa. Nokuti unhu zwaanobyala ndizwo zwaanovuna. <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />Nokuti iye unobyalila kumbili iye uchavuna kubola kuva kumbili iye, koga yoyo unobyala kuMpepo uchavuna bupenyu businopela kuva kuMpepo. <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />Tisinyale pakuta zwibuya, nokuti kana tisinonyala tinoovuna nonshaji ulokwelela. <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />Nokudalo patinoba tili nechibaka ngatitileni banhu bose zwibuya, kasakasa kuna ibo bemhuli yabanodimbwa.<verse eid="GAL 6:10" /></para>
  <para style="s">Kuchenjejwa kokupejisila Nokumusa</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />Bonani bukulwana bwamabala andikumumukwalila noluboko lwangu. <verse eid="GAL 6:11" /><verse number="12" style="v" sid="GAL 6:12" />Yabo banoda kuzwitondejela mumbili banomumanikija kuti mumhalajwe, kutila kuti besiyangatisilwe unchinjikwa waKristo. <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />Nokuti yabo bakamhalajwa nokwabo abatolondota mulawo, koga banoda kuti imwi mumhalajwe kutila kuti bezwikuje nokumhalajwa kwenu kombili. <verse eid="GAL 6:13" /><verse number="14" style="v" sid="GAL 6:14" />Koga kana ndilimi, ndisizwikuje kuzhe konchinjikwa waTezi wedu Jesu Kristo, pezhulu nomunaiyo inyika yakakahamililwa imi akale imi kunyika. <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />Nokuti kumhalaja kana kusomhalajwa akutoleba chinhu, koga chinokosha unhu ngebe chibumbwa chipya. <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />Lunyalalo neshe ngazwibe kuna ibo bose banokwenda nomulawo yoyu, akale nabanhu beIzilayeli beli banhu baMwali.<verse eid="GAL 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17" />Kuvila feno kusibe nonhu uchandinyaja, nokuti ndinamabanga aJesu pambili pangu.<verse eid="GAL 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18" />18 Banakwaina bangu Chipiwo chaShe wedu Jesu Kristo ngachibe nompepo wenu. Ameni.<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>