<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JAS" style="id">-NAMBYA TRANSLATION PROJECT</book>
  <para style="h">Jemusi</para>
  <para style="toc1">Lukwalo lwaJemusi</para>
  <para style="toc2">Jemusi</para>
  <para style="toc3">Jemu</para>
  <para style="mt2">Lukwalo lwaJemusi</para>
  <para style="mt1">JEMUSI</para>
  <para style="imt">Matangisilo</para>
  <para style="ip">Iwhalo yaJemusi yakakwalwa nomwe unhu unowhi Jemusi. Yoyu wakabeli Jemusi ununa waJesu, wakabeli untungamili mugubungano lyotanga akale wakabeli umwe weGota lyeJelusalema (Mishingo 15:13). UMpositoli Paulo nayiye wakonshoba eti “idabijo” lyegubungano muna (baGalatiya 2:9). Bana chikolo banodimbwa kuti yeyi iwhalo yaJemusi yakakwalwa mushule mwamakole makumi mashanu mushule kokuzwalwa kwaKristu. Sezwo Jemusi wakabeli untungamili wegubungano muJelusalemu, zwinotubulika kuti wakakwala iwhalo yeyi egala kwakale.</para>
  <para style="ip">Jemusi unokwalila iwhalo iye “benduji igumi inatubili balomwayikana mukati mwenduji” (Jemusi 1:1). Zwilayijo zwimomuna Jemusi zwinoshinga kumaKristo ose, asi yopa pakawhi benduji igumi inatubili zwinobhisila pachena kuti Jemusi wakabekwalila maKristo echiJuda. Nokuti yeyi iwhalo yakabekwelela kuswikwa kubuta lyabanobala, lyakabhata inyaya jinji. Jemusi unolingisisa kasa pobukamu bokudimbwa nezwito, kudimbwa kwechokomende kunotondejelwa nezwito (Jemusi 2:17). Unochenjeja pezhulu polushalulo kwabalofuma pana basheti (Jemusi 2:1-4) akale unotibuja kuti tichenjelele zwatinoleba (Jemusi 3:1-12).</para>
  <para style="iot">Zwilomumwa</para>
  <para style="io1">Jemusi unomusa babe banobala (Jemusi 1:1)</para>
  <para style="io1">Unosungwaja maKristo kuti benangatile pabanoyabula (Jemusi 1:2-27)</para>
  <para style="io1">Kova eti zwilokwelela kuti kudimbwa kutondejelwe muzwito (Jemusi 2:1-26)</para>
  <para style="io1">Mushule mwezwo unoti mahwi ananesimba (Jemusi 3:1-12)</para>
  <para style="io1">Jemusi unolungulula kuti buchenjevu bwaMwali bulosiyana chini nobuchenjevu bwenyika (Jemusi 3:13—4:10)</para>
  <para style="io1">Unolayija banobala babe kuti besizwifufumule (Jemusi 4:11—5:6)</para>
  <para style="io1">Jemusi unopeja iwhalo nokupa indayijo jilozibilika. (Jemusi 5:7-20)</para>
  <chapter number="1" style="c" sid="JAS 1" />
  <para style="s">Kumusana</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1" />Imi Jemusi undanda waMwali naShe Jesu Kristo.</para>
  <para style="p" vid="JAS 1:1">Kuna benduji gumi nembili mulomwayikana munyika jose.</para>
  <para style="p" vid="JAS 1:1">Ndinomumusa.<verse eid="JAS 1:1" /></para>
  <para style="s">Kudimbwa nobuchenjevu</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2" />Banakwaina shantani kana mwashangana nokukwejwa kulosiyanasiyana, <verse eid="JAS 1:2" /><verse number="3" style="v" sid="JAS 1:3" />munoziba kuti kukwejwa kolubimbo lwenu ndikokunomusimisa. <verse eid="JAS 1:3" /><verse number="4" style="v" sid="JAS 1:4" />Akale itani kuti kusimatija kuzhale kunamwi kutila kuti mube babuya balopelela, akale musinoshayiwa chinhu. <verse eid="JAS 1:4" /><verse number="5" style="v" sid="JAS 1:5" />Kana umwe wenu eshayiwa buchenjevu, ngekumbile kunaMwali, unopa bose banhu neshe jije akale esinopandandu kuna bose, nezwo unoopiwa. <verse eid="JAS 1:5" /><verse number="6" style="v" sid="JAS 1:6" />Koga ngekumbile mukudimbwa, pesina kukahajika, nokuti iye unokahajika unanga sebhitu legungwa linochingaija livililijwa nebhepo. <verse eid="JAS 1:6" /><verse number="7" style="v" sid="JAS 1:7" />Yoyo unhu esilingilile kutambula chinhu kuva kunaTezi, <verse eid="JAS 1:7" /><verse number="8" style="v" sid="JAS 1:8" />nokuti yoyo unhu unane myoyo mibili aajilojikama munzila jije.<verse eid="JAS 1:8" /></para>
  <para style="s">Kusheta nokuFuma</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9" />Lekani mwanakwaina unolingilwa pasi ezwikuje mukunyamulwa kukwe, <verse eid="JAS 1:9" /><verse number="10" style="v" sid="JAS 1:10" />akale umfumi mukuninipiswa kukwe, nokuti seluba lyobuhwa unofa. <verse eid="JAS 1:10" /><verse number="11" style="v" sid="JAS 1:11" />Nokuti izhuba linobhuda nokupisa kasa lihwihwinyisa buhwa, maluba alo anowa, akale bubhodo bwalyo bunopela. Nezwo umfumi uchapalala echi pakati pokuta mishingo iye.<verse eid="JAS 1:11" /></para>
  <para style="s">Kukweja nokuKwejwa</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12" />Ulokombolelwa unhu unondilambeli edimbwa koga elimukukwejwa, nokuti angozunda kukwejwa unoopiwa umbayilo waMwali waakabimbisa kunabo banounda. <verse eid="JAS 1:12" /><verse number="13" style="v" sid="JAS 1:13" />Kusibe nounoti kana akwejwa, “ Ndakwejwa naMwali,” nokuti Mwali aangakwejwe nobubi akale iye apana waanokweja, <verse eid="JAS 1:13" /><verse number="14" style="v" sid="JAS 1:14" />koga unhu wose unokwejwa paano shobelejwa akale nokuchengejwa nolulakamilo lubi lulwe. <verse eid="JAS 1:14" /><verse number="15" style="v" sid="JAS 1:15" />Kana lulakamilo lubi lungobaipo kunozwala luchinyo, akale luchinyo lungo kubuka lunozwala lufu.<verse eid="JAS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16" />Banakwaina bangu balodikana, musichengwe. <verse eid="JAS 1:16" /><verse number="17" style="v" sid="JAS 1:17" />Chose chipo chibuya nechipo chilopelelela chinova kudenga, zwiva kunaTate bezwimuniko zwokudenga basinoshanduka semintuzi inoshanduka. <verse eid="JAS 1:17" /><verse number="18" style="v" sid="JAS 1:18" />Nokuda kukwe wakatizwala newhi lyechokomende kuti tingaba yondiya uchelo wotanga pazwibumbwa zwizwe.<verse eid="JAS 1:18" /></para>
  <para style="s">Kuwha noKuta</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19" />Banakwaina bangu banodikana zibani banodikana. Unhu wose ngekambije kuwha, ngejilwe kulebeleka, ejilwe kunyema. <verse eid="JAS 1:19" /><verse number="20" style="v" sid="JAS 1:20" />Nokuti kunyema kwonhu akutobuza bululami bunodiwa naMwali. <verse eid="JAS 1:20" /><verse number="21" style="v" sid="JAS 1:21" />Nokudalo lashani zwose zwito zwenu zwineshambwa akale nobubi buzhele, mutambule nokuzwininipisa, iwhi lyakabyalwa munamwi linotubula kuchija myoyo yenu.<verse eid="JAS 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22" />Koga ibani banotobeleja iwhi, akale musibe banowhilila chete, muzwichenga. <verse eid="JAS 1:22" /><verse number="23" style="v" sid="JAS 1:23" />Kana umwe eli unowhilila iwhi koga pesina zwaanota, unanga sonhu ukumuzwiyeba chiso chiche pechiboniboni, <verse eid="JAS 1:23" /><verse number="24" style="v" sid="JAS 1:24" />nokuti unozwilinga kova enda pakalepo unokanganwa kuti unolingika chini. <verse eid="JAS 1:24" /><verse number="25" style="v" sid="JAS 1:25" />Koga iye yoyo unolinga kasa mumulawo ulokwelela, mulawo wolusununguko, akale kusimilila, esinowha kova ekanganwa koga eta chinhu yecho, unokombolelwa muna zwaanota.<verse eid="JAS 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26" />Kana unhu eyeya kuti unodimbwa, koga esinokabula lulimi lulwe koga echengela mwoyo uwe, kudimbwa kukwe akutobhancha. <verse eid="JAS 1:26" /><verse number="27" style="v" sid="JAS 1:27" />Kudimbwa kuloshambijika nokuchena mbeli kwaMwali Tate ndikoku, kushanyila inhelela nenchilikaji mubukukutu bwabo, nokuzwilondota ukashambijika munyika.<verse eid="JAS 1:27" /></para>
  <chapter eid="JAS 1" />
  <chapter number="2" style="c" sid="JAS 2" />
  <para style="s">Kuchenjejwa pezhulu poluShalulo</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1" />Banakwaina bangu, musitondejele lushalulo, mukabhatilila mukudimbwa munaShe wedu Jesu Kristo, Tezi wedu wolukujo. <verse eid="JAS 2:1" /><verse number="2" style="v" sid="JAS 2:2" />Kana unhu ulineseka lyendalama akale ekambala zwimbalo zwibuya angozha mubungano, akale kungoswika unhu unosheta eline zwimbalo zwilosofwala, <verse eid="JAS 2:2" /><verse number="3" style="v" sid="JAS 2:3" />mopa lulemeko kunooyo ulombala zwanana kova muti kwaali, “Hecho chibhula chibuyanana chicho,” koga kunsheti moti “Ima yopo kana kuti ugala pasi pelyo namakumbo angu.” <verse eid="JAS 2:3" /><verse number="4" style="v" sid="JAS 2:4" />Amujimushalujana, pakati penu na, moba batongi banamiyeyo mibi? <verse eid="JAS 2:4" /><verse number="5" style="v" sid="JAS 2:5" />Banakwaina banodikana whililani. Mwali ajakashaluja na, yabo banosheta munyika kuti bebebafumi mukudimbwa akale bebe balyifumi bobushe bwaalobimbisa kunabo banooda? <verse eid="JAS 2:5" /><verse number="6" style="v" sid="JAS 2:6" />Koga imwi amutolemekeja basheti. Abatoba bafumi banomudyamija na, akale atoba ibo banomusenga kumakota na? <verse eid="JAS 2:6" /><verse number="7" style="v" sid="JAS 2:7" />Akale abatoba ibo banotuka izina linolemekejwa lamunoshobwa nalo.<verse eid="JAS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8" />Mungozhajika undawo wobushe, sezwakulo kwalwa muwhalo, “Ida umbakijani uwo sobunozwida iwi nokuko,” munota zwibuya, <verse eid="JAS 2:8" /><verse number="9" style="v" sid="JAS 2:9" />koga mungoshalula banhu, mukumuta luchinyo, akale mulawo unobhata nondandu wokuvuna undawo <verse eid="JAS 2:9" /><verse number="10" style="v" sid="JAS 2:10" />Nokuti kana ani azwe unolondota wose mulawo koga evuna umwempela unobeli nondandu wokuvuna yose milayo. <verse eid="JAS 2:10" /><verse number="11" style="v" sid="JAS 2:11" />Nokuti iye wakati, “usipombole,” wakati akale, “Usibulaye.” Kana usinopombola koga ubulaya, unobe uvuna mulawo. <verse eid="JAS 2:11" /><verse number="12" style="v" sid="JAS 2:12" />Nokudalo lebelekani akale muzwibhate sabanhu bachanotongwa nomulawo wolusununguko. <verse eid="JAS 2:12" /><verse number="13" style="v" sid="JAS 2:13" />Nokuti untongo autobeli neshe kunoyo usinowhila ishe, asi ishe jinozunda untongo.<verse eid="JAS 2:13" /></para>
  <para style="s">Kudimbwa nemishingo</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14" />Banakwaina zwinobhacha neni, kana unhu eti unodimbwa koga zwito zwizwe zwisinotondejela alo? kudimbwa kukwe kungombhanchaneni. <verse eid="JAS 2:14" /><verse number="15" style="v" sid="JAS 2:15" />Kana mwanakwaina wechinhukaji kana wechinhulume esina zwombala akale eshayiwa kulya mazhuba ose, <verse eid="JAS 2:15" /><verse number="16" style="v" sid="JAS 2:16" />kova umwe wenu eti kwabali, “Indani zwibhodo, mujiyililwe akale ugute,” esabapa zwinodiwa nombili biya zwinobhanchani? <verse eid="JAS 2:16" /><verse number="17" style="v" sid="JAS 2:17" />Kudimbwa kana kukazwimila koga, pesina mishingo, kulofa.<verse eid="JAS 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18" />Koga umwe angati, “Iwi unakudimbwa, asi imi ndinamishingo.” Nditondeje kudimbwa kuko kusina mishingo, imi nemishingo yangu ndokutondeja kudimbwa kwangu. <verse eid="JAS 2:18" /><verse number="19" style="v" sid="JAS 2:19" />Munovumila kuti Mwali umwempela, zwibuya. Neebo madimoni anodimbwa akale anotilimuka. <verse eid="JAS 2:19" /><verse number="20" style="v" sid="JAS 2:20" />Iwi lema unoda kutondejwa, kuti kuvumila kusina mishingo akuna lubhancho? <verse eid="JAS 2:20" /><verse number="21" style="v" sid="JAS 2:21" />Abhulahamu, tate bedu, ajakalulamiswa nezwito na, paakapila mwananhulumyana uwe Isaki pedebulilo? <verse eid="JAS 2:21" /><verse number="22" style="v" sid="JAS 2:22" />Uzubweni, kuti kudimbwa nezwito zwakaba zwishinga pamwempela, kudimbwa kukwe kwaka zhajikijwa nemishingo. <verse eid="JAS 2:22" /><verse number="23" style="v" sid="JAS 2:23" />Akale iwhalo yakazhajikijwa painoti, “Abhulahamu wakadimbwa kunaMwali, yezwi zwakata kuti ewhi ulolulama,” akashobwa kuwhi unkwaina waMwali. <verse eid="JAS 2:23" /><verse number="24" style="v" sid="JAS 2:24" />Mubweni kuti unhu unolulamiswa nemishingo iye kusi kuti kudimbwa koga.<verse eid="JAS 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25" />Akale munzila ilokwelana, atoba imo na kuti Rahabhu invemu wakalulamisa nezwito zwizwe, paakatambula batumwa akabatizhisa neimwe inzila.<verse eid="JAS 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26" />Sokuti umbili usina umpepo ulofa, zwakadalo nokudimbwa kusina mishingo kulofa.<verse eid="JAS 2:26" /></para>
  <chapter eid="JAS 2" />
  <chapter number="3" style="c" sid="JAS 3" />
  <para style="s">Kalimi</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1" />Banji benu musube balayiji, banakwaina bangu moziba kuti isu balayiji tinookomeselwa pakutongwa. <verse eid="JAS 3:1" /><verse number="2" style="v" sid="JAS 3:2" />Nokuti tose tolundula kanjinji, kana umwe esinolundula panazwanoleba unobakalulama kasa. Akale unobetubula kuzwubhata. <verse eid="JAS 3:2" /><verse number="3" style="v" sid="JAS 3:3" />Kana tibiga matomu mumilomo yamabhiza kuti ete zwatinoda, totungamila mibili yawo. <verse eid="JAS 3:3" /><verse number="4" style="v" sid="JAS 3:4" />Neebo lingani zwikepe, kojoba zwilizwikulwana zwikwendeswa nebhepo, unokwendesa unoshingisa inhando nhukutuku kuchingunuka. <verse eid="JAS 3:4" /><verse number="5" style="v" sid="JAS 3:5" />Kalimi kababi katukutuku koga kanoshiya nezwito zwikulwana.</para>
  <para style="p" vid="JAS 3:5">Ishango gulwana linopiswa nomoto untukutuku. <verse eid="JAS 3:5" /><verse number="6" style="v" sid="JAS 3:6" />Nokudalo kalimi moto. Kalimi kababi kasakalulama pakati pezwibabi zwombili wedu, kanobipisa umbili wose, kanopisa mamilo enyika, akale iko kanopiswa moto wegehena. <verse eid="JAS 3:6" /><verse number="7" style="v" sid="JAS 3:7" />Wose unshobo wemhuka nenyuni, makabi, nezwipuka zwomuvula ingaba ipizwayo imhuka ingatambiswa akale yakatambiswa nabanhu, <verse eid="JAS 3:7" /><verse number="8" style="v" sid="JAS 3:8" />koga apana unhu angatambisa kalimi, akale kalosungwala muzwibi, kazhele butulu bunabukali. <verse eid="JAS 3:8" /><verse number="9" style="v" sid="JAS 3:9" />Tokashingisa kuboka Tezi naTate akale tokashingisa kufhizha banhu bakabumbwa nonkwejaniso waMwali. <verse eid="JAS 3:9" /><verse number="10" style="v" sid="JAS 3:10" />Mundomo umwempela munobhuda kukombolela nokufhizha. Banakwaina, yezwi azwitokwelela kuba alo. <verse eid="JAS 3:10" /><verse number="11" style="v" sid="JAS 3:11" />Ani ishawi limwempela lingabhuda ivula imbodo nevula inolwela pondomo na? <verse eid="JAS 3:11" /><verse number="12" style="v" sid="JAS 3:12" />Banakwaina unkuyu ungazwala ma olivi na, kana unzhambi uzwale ihuyu na? Ishawi linevula inolwela alingabhise ivula inonaka<verse eid="JAS 3:12" /></para>
  <para style="s">Buchenjevu bunova Kudenga</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13" />Ndiyani unabuchenjevu kana kuwhisisa pakati penu? Nobupenyu bubwe bubuya ngetondeje mishingo iye nokuzwininipisa kuna buchenjevu. <verse eid="JAS 3:13" /><verse number="14" style="v" sid="JAS 3:14" />Koga kana mumyoyo yenu mukafundilila nefupa nokuda kuti kubemwi chete, musizwitunhumwije kana kulamba ichokomende, <verse eid="JAS 3:14" /><verse number="15" style="v" sid="JAS 3:15" />buchenjevu bwakadai abutova kudenga, asi ngobwapasi, abutoba bwompepo nchena, asi bwemipepo mibi. <verse eid="JAS 3:15" /><verse number="16" style="v" sid="JAS 3:16" />Panowanika ifupa nokuda kokuti zwose zwizhe kunaiye, ndipo pana kusobambikika nezwito zwibi zwilosiyana. <verse eid="JAS 3:16" /><verse number="17" style="v" sid="JAS 3:17" />Koga buchenjevu bunova kudenga kutanga buloshambijika akale bunalunyalalo, bunyolonyolo, kuzwideleja, kuzhala neshe, akale nemichelo mibuya, kusoba nolushalulo akale nokusolebesa. <verse eid="JAS 3:17" /><verse number="18" style="v" sid="JAS 3:18" />Balanduli banobyala lunyalalo, banovuna michelo yobululami ina lunyalalo.<verse eid="JAS 3:18" /></para>
  <chapter eid="JAS 3" />
  <chapter number="4" style="c" sid="JAS 4" />
  <para style="s">Kusoba nobukwayina neNyika</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1" />Ani ihondo jose nokukakabajana pakati penu zwimuva kupi? Azwijimuva muzwilakamilo zwenu zwibi zwimukulwisana mukati mwenu? <verse eid="JAS 4:1" /><verse number="2" style="v" sid="JAS 4:2" />Moda zwinhu, asi amutozwiwana, nokudalo mulozwipila kubulaya. Munolakamila zwinhu, koga amutozwiwana, ndipo pamuno kakabajana nokulwana. Amuna zwamunoda nokuti amujikumuzwikumbila kunaMwali. <verse eid="JAS 4:2" /><verse number="3" style="v" sid="JAS 4:3" />Munokumbila koga amutotambula, nokuti munokumbilila zwisakalulama, kuti mushingise muzwilakamilo zwenu. <verse eid="JAS 4:3" /><verse number="4" style="v" sid="JAS 4:4" />Imwi bapomboli, amutoziba kuti kuda zwenyika ndiko kuba babengi baMwali na? Nokudalo ani nani unoda kuba nkwaina wenyika unozwita umbengi waMwali <verse eid="JAS 4:4" /><verse number="5" style="v" sid="JAS 4:5" />Amutoyeya na kuti akuna, ichokomende muwhalo inoti, “Iye ulobiga umpepo mwatili uzhele kulakamila kukulwana kunanefupa.” <verse eid="JAS 4:5" /><verse number="6" style="v" sid="JAS 4:6" />Koga ishe jaanotipa Mwali jinesimba lisimu. Sezwilokwalwa kuwhi, “Mwali unonyenyeja banoshiya, asi unopa ishe kuna banozuninipisa.” <verse eid="JAS 4:6" /><verse number="7" style="v" sid="JAS 4:7" />Nokudalo zwibigeni pasi paiye Mwali. Misikijanani naguluzhanje, nokudalo unomutizha. <verse eid="JAS 4:7" /><verse number="8" style="v" sid="JAS 4:8" />Sendelani kunaMwali, naiye unoswendela kunamwi. Shambani maboko enu, imwi bachinyi, muchenese myoyo yenu, imwi bemyoyo mibili. <verse eid="JAS 4:8" /><verse number="9" style="v" sid="JAS 4:9" />Whisani ishe, mufwikula akale lilani, shandulani kuseka kwenu kube kulila, lushanto lwenu ngalube kuhushubala. <verse eid="JAS 4:9" /><verse number="10" style="v" sid="JAS 4:10" />Zwininipiseni mbeli kwaTezi, iye unomunyamulila pezhulu.<verse eid="JAS 4:10" /></para>
  <para style="s">Chichenjejo pezhulu pokutongana</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11" />Banakwaina musilebelekane bubi chenuchenu. Yoyo unolebeleka bubi nomwanakwaina kana kutonga mwanakwaina uwe, unolebeleka bubi pezhulu pomulawu akale unotonga mulawo asi kana utonga mulawo autoba untobeleji womulawo koga untongi wawo. <verse eid="JAS 4:11" /><verse number="12" style="v" sid="JAS 4:12" />Mwali ndiye ega umpi womulawu akale untongi. Ndiye ega angachija kana kupalaja. Iwindiwi aani unotonga umbakijani uwo?<verse eid="JAS 4:12" /></para>
  <para style="s">Chichenjejo pezhulu pokuShiya</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13" />Ngweno ndiwhilileni, imwi munoti, “Nasi kana mangwana tinoba nolwendo lokunda kunelimwe iguta, kwatichano gala igole titengesa tiwane imali.” <verse eid="JAS 4:13" /><verse number="14" style="v" sid="JAS 4:14" />Amungazibe kuti bupenyu bwenu mangwana bunobeli chini, Ini bupenyu bwenu? Nokuti munanga sefulele linoboneka kwonshaji unshoma kova libwandila. <verse eid="JAS 4:14" /><verse number="15" style="v" sid="JAS 4:15" />Zwamunokwelela kuleba ndiyezwi, “Kana Tezi beda, tinolalama kova tita yezwi nezwi.” <verse eid="JAS 4:15" /><verse number="16" style="v" sid="JAS 4:16" />Koga ngweno moshiya nokuzwiloba chifuba, kushiya kwakadai kubi.<verse eid="JAS 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17" />Nokuti, tingoleka kuta zwibuya tiziba kuti tokwelela kuta alo, tikumuchinya.<verse eid="JAS 4:17" /></para>
  <chapter eid="JAS 4" />
  <chapter number="5" style="c" sid="JAS 5" />
  <para style="s">Chichenjejo kubafumi</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1" />Iwhililani ngweno, imwi bafumi, lilani akale mufwikule pezhulu pokuyangata kukumuzha kunamwi. <verse eid="JAS 5:1" /><verse number="2" style="v" sid="JAS 5:2" />Ifuma yenu yabola akale zwimbalo zwenu zwamumwa nonchenje. <verse eid="JAS 5:2" /><verse number="3" style="v" sid="JAS 5:3" />Indalama nesiliva yenu zwaba nengula, akale ingula yabo ndiyo ichaba busumikiji pezhulu penu akale bunoolya umbili wenu somoto. Mwakalundika ifuma yamazhuba opejeleja. <verse eid="JAS 5:3" /><verse number="4" style="v" sid="JAS 5:4" />Ilingani! Indipilo yamwakakonwa kulipa bashingi bakashakula muminda yenu ikumulila pezhulu penu. Kulila kwabakavuna kwasika munzebe jaMwali wamasimba ose. <verse eid="JAS 5:4" /><verse number="5" style="v" sid="JAS 5:5" />Mwalalama penyika mububuya nokunakilwa, mwazwikoja mutila izhuba lyokubulayiwa. <verse eid="JAS 5:5" /><verse number="6" style="v" sid="JAS 5:6" />Mwapa bamwe undandu akale mukabulaya unhu ulolulama iye usinonyenyejana namwi.<verse eid="JAS 5:6" /></para>
  <para style="s">Mwoyo ndefu nokuNamata,</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7" />Banakwaina ibani nomwoyo undefu, kuswika kubuya kwaTezi. Undimi unomilila unchelo umbuya wenyika, eba nomwoyo ndefu kuswikila wawana ivula yotanga neyopejisila. <verse eid="JAS 5:7" /><verse number="8" style="v" sid="JAS 5:8" />Namwibo ibani nemyoyo milefu. Simisani myoyo yenu, nokuti kuzha kwaTezi kwaba pelyo.<verse eid="JAS 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9" />Banakwaina kusibe nokungunguna pakati penu, kutila kuti musipiwe untongo, ilingani untongi umile ponkoba. <verse eid="JAS 5:9" /><verse number="10" style="v" sid="JAS 5:10" />Banakwaina tolani bapolofeti bakalebeleka muzina lyaTezi, sechitondejelo chokuyabula akale nomwoyo ndefu. <verse eid="JAS 5:10" /><verse number="11" style="v" sid="JAS 5:11" />Lingani, tobashoba totibaloshanta yabobalosimitija. Mwakahwa nokusimitija kwaJobhu, akale mwakabona chinangwa chaTezi kumapejelejo, akale Tezi unaluwhilo neshe.<verse eid="JAS 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12" />Pezhulu pezwinhu zwose, banakwaina bangu, musikowhe nedenga, kana nenyika, kana neipi yose ikowhe, koga “Eya” ngebe “Eya” kana kuti pe ngebe pe kutila kuti musiwile mundandu.<verse eid="JAS 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13" />Pana ukumuyabula pakati penu na? Ngenamate. Upo uloshantilwa na? Ngekwimbe jimbo jolukujo. <verse eid="JAS 5:13" /><verse number="14" style="v" sid="JAS 5:14" />Kuna umulwala na pakati penu? Ngeeshobe bakulwana begubungano boonamatile boongube namafuta aTezi. <verse eid="JAS 5:14" /><verse number="15" style="v" sid="JAS 5:15" />Unamato wokudimbwa unoonchilisa undwaji, akale Tezi banoomusa, kana elinoluchinyo, unoolekejelwa. <verse eid="JAS 5:15" /><verse number="16" style="v" sid="JAS 5:16" />Nokudalo lebululani luchinyo kunomwe noumwe akale munamatilane, kuti muchiliswe. Unamato wowakalulama una isimba lyinji akale unoshinga. <verse eid="JAS 5:16" /><verse number="17" style="v" sid="JAS 5:17" />Elija wakabeli unhu sasu koga wakanamata nesimba kuti ivula isine penyika, akale kwamakole matatu nemyeji mishanu nomwempela akujakana. <verse eid="JAS 5:17" /><verse number="18" style="v" sid="JAS 5:18" />Kova enamata kabili ivula ikana iva kudenga, akale inyika ikamejeka zwilimwa zwayo.<verse eid="JAS 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19" />Banakwaina bangu, kana umwe pakati penu epamhala kuva kulebeswa kova umwe ochingunula, <verse eid="JAS 5:19" /><verse number="20" style="v" sid="JAS 5:20" />ngeezibe kuti yoyo unochinungula uchinyi kuva mukulashika munzila iye, unochija mwoyo uwe kulufu kova etibikila zwibi zwinji.<verse eid="JAS 5:20" /></para>
  <chapter eid="JAS 5" />
</usx>