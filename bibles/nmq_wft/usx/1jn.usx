<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Nambya Translation Project</book>
  <para style="h">1 Joni</para>
  <para style="toc1">Lukwalo lwotanga lwakakwalwa naJoni</para>
  <para style="toc2">1 Joni</para>
  <para style="toc3">1 Jon</para>
  <para style="mt2">Lukwalo lwotanga lwaka kwalwa na</para>
  <para style="mt1">JONI</para>
  <para style="imt">Matangisilo</para>
  <para style="ip">lukwalo lwotanga lwaJoni lwakakwalwa nompositoli Joni pakati pamakole makumi mashanu kunoswika izana lyamakole mushule mokuzwalwa kwaJesu. Joni atozwisuma sokuti ndiye nkwali, koga chisiyaniso chotanga chinotondeja kuti unsumikiji wobupenyu nokumuka kwaJesu. (1 Joni 1:1-3). inzila yanokwala nayo muna 1 Joni ulotojana kasa nenzila yaakakwala nayo indebo imbuya munaJoni. Unodimbwa kuti Joni ndiye unkwali wakakwala indebo imbuya namakwalo matatu ananga sa 1 Joni, 2 na 3 Joni echinogala kuEfasasi.</para>
  <para style="ip">Joni wakakwala lukwalo yolu kunaabo banodimbwa bose akale nooyo unshaji igubungano lyakabeli mubukukutu kubhuda kugapo lyabanhu bakabeli nendayijo yoniepa bakabewhi ma “sinoputiki.” Bakabedimbwa kuti Jesu wakabeli Mwali uzhele akale ajakabeli unhukasa pakabeli penyika. Pezhulu pezwi Joni unokwala nokuba unsumikiji mubupenyu bwaJesu akale nokuti maboko awe akombhata Jesu (1 Joni 1:1-3). Joni wakakwala lukwalo yolu kuti ezhajikije lushanto lulwe ( 1 Joni 1.4), kuti etabilije banodimbwa kuti besi bipise (1 Joni 2:1), kuti etabilijile banodimbwa kundayijo yoniepa (1 Joni 2:26), nokusimisa banodimbwa kuti bakachijwa (1 Joni 5:13).</para>
  <para style="iot">Zwilomumwa</para>
  <para style="io1">Joni unopa chingwiniso cholukwalo lulwe nechinangwa chaamukwalila (1 Joni 1:1-4)</para>
  <para style="io1">Akale unopandulula kuti Mwali mwenji ulichini nokuti tokwelela kulalama samalalamilo aJesu (1 Joni 1:5––3.10)</para>
  <para style="io1">Chinotobela, unotikumbukuja nomulawo wokudanana (1 Joni 3:11––-5:12)</para>
  <para style="io1">Unopejeleja lukwalo lulwe muna (1 Joni 5:13-21)</para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s">IWhi lyoBupenyu</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />Tinomukwalila nezwe Whi lyobupenyu, lyakaba lilipo kuva pakutanga. Takaliwha, tikalibona namesho edu, eya takalibona akale maboko edu akalibhata, <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" />yobo bupenyu bwakatondejelwa akale tikabubona, tikabusumikija, tikapupula bupenyu businopela kunamwi, bwakabeli naTate akale bwakatondejelwa kunasu. <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />Yezwo zwitakabona nokuwha tozwipupula kunamwi, kuti namwibo mubenokulyijana nasu, kulyijana kwedu kuko kunaTate nokuMwananhulumyana uwe Jesu Kristo. <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />Tinokwala yezwi kutila kuti kushanta kwedu kupelelele.<verse eid="1JN 1:4" /></para>
  <para style="s">Mwali Mwenje</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />Yeli ndilo iwhi lyatakawha kuna iye, lipupulwa kwamuli, kuti Mwali ndiye mwenje, akale munaiye amuna kana inhilima. <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />Kana titi tinakulyijana naiye, tilimukukwenda munhilima, timunyepa akale atijikumulalama muchokomende, <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />koga kana tikwenda mumwenje, sobwaali iye mumwenje, tinakulyijana umwe noumwe, nelopa lyaJesu, Mwananhulumyana uwe, unotichenesa muzwibi zwose<verse eid="1JN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8" />Kana titi atina luchinyo tikumuzwichenga, nelebeswa alimo munasu. <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />Kana tilebulula zwibi zwedu, ulobimbika iye akale ulolulama, neebo unootilekejela zwibi zwedu akale unotishampuluja kuva mukusolulama kwose. <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />Kana titi atijilochinya, tinounta inyepi, akale newhi lilye alimo munasu.<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s">Kristo Umbhanchi Wedu</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />Bana bangu, ndimukwala yezwi kwamuli kuti musichinye, koga kana unhu achinya, tina undebelekeli unaTate, Jesu Kristo ulolulama. <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />Iye nokukwe ndiye umpilo woluchinyo lwedu, lusiluchinyo lwedu chete koga luchinyo lwenyika yose.<verse eid="1JN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3" />Nezwi tingaba nechokomende kuti tinounziba, kana tilondota milawo iye. <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />Yoyo unoti “Ndonziba,” koga esinolondota milawo iye, inyepi, akale ichokomende alimo munaiye, <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />koga yoyo unolondota iwhi lilye, munaiye ludo lwechokomende kunaMwali lunopeleleswa. Nezwo tingaba nechokomende kuti timomunaiye. <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />Yoyo unoti unogala mwaali unokwelela kukwenda munzila yakaleyo, yakakwenda iye Jesu Kristo.<verse eid="1JN 2:6" /></para>
  <para style="s">Undayo Umpya</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />Banodikana, andijikumumukwalila indayo impya, koga ngiyantolo imwakabeli nawo kuvila pakutanga, yeyi indayo yantolo iwhi limwakawha. <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />Koga ndikumumukwalila indayo impya, ili yechokomende kuna iye nokunamwi, nokuti inhilima imukupinda, mwenje wechokomende ukumupenya kale.<verse eid="1JN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9" />Yoyo unoti umomumwenje, ebenga mwanakwaina uwe, uchimo munhilima. <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />Yoyo, unoda mwanakwaina uwe, unogala mumwenje akale mukati mwawo amuna zwingontisa kuti echinye, <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />yoyo unobenga mwanakwaina uwe, uchimo munhilima, unokwenda munhilima, akale aatoziba kwaamunda nokuti inhilima yapofomaja mesho awe.<verse eid="1JN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12" />Ndikumukwalila imwi bana batukutuku, nokuti luchinyo lwenu lwakalekejelwa pezhulu pezina lilye. <verse eid="1JN 2:12" /><verse number="13" style="v" sid="1JN 2:13" />Ndikumumukwalila imwi matate, nokuti munonziba wakabelipo kuvila pakutanga. Ndikumumukwalila imwi bazhuzha, nokuti mwakazunda iye umbi.<verse eid="1JN 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 2:14" />Ndinomukwalila imwi bana, nokuti munouziba Tate. Ndomukwalila imwi, matate, nokuti monziba iye wakabelipo kuvila pakutanga. Ndomukwalila imwi bazhuzha, nokuti munamasimba, newhi lyaMwali linogala mwamuli, akale mwakazunda umbi.<verse eid="1JN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />Muside inyika kana zwinhu zwimomukati mwayo. Kana umwe wenu eda inyika, ludo lyobuTate alwimo mwaali. <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />Munazwose zwimomunyika, kulakamila kombili, kulakamila kwamesho, kuzwikuja nobupenyu, azwitoba zwaTate koga ngozwe nyika. <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />Akale inyika nezwilakamilo zwayo zwinopinda, koga iye unota kuda kwaMwali unogala kwalini nalini .<verse eid="1JN 2:17" /></para>
  <para style="s">Unyenyeji waKristo</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />Bana bangu, unshaji wopejeleja waba pelyo, akale sezwimwakawha kuti unyenyeji waKristo ukumuzha, ngweno babengi baKristo banji bezha. Nokudalo taziba kuti waba unshanji wopejeleja. <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />Yaba banhu atijakabelina bulyijani nabo, ndizo bakatisiya nokuti ngana bakabeli bedu, balondilambeli nasu, koga ibo bakabhuda, zwitondeja pachena kuti bose abajakabeli bedu.<verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />Koga imwi mwakagubwa noNchena akale mose moziba ichokomende. <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />Ndinomukwalila, ndisinoleba kuti amutoziba ichokomende, akale moliziba ilebeswa, apana manyepwa anova muchokomende.<verse eid="1JN 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22" />Ndiani iniepi, aatoba iye na unolamba kuti Jesu ndiKristo? Wakadai ndiye unyenyeji waKristo, nokuti unolamba Tate noMwananhulumyana. <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />Yoyo unolamba Mwananhulumyana unolamba Tate, yoyo unotambula Mwananhulumyana una naTate neebo.<verse eid="1JN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24" />Bonani kuti yezwi zwimwakawha kuvila pakutanga, zwinogala mwamuli. Kana yezwi zwimwakawha kuvila pakutanga zwigala mwamuli nezwo mogala muMwananhulumyana akale nomuna Tate <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />Yezwi ndizwo zwaakatibimbisa Kristo, zwokuti unootipa bupenyu businopela.<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />Ndikumumukwalila yezwi nphezhulu pabanhu banoda kumuchenga. <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />Imwi, kugubwa kwamwakatambula kuna iye, kunoogala munamwi, nokudalo akutodikana kuti kube nonhu uchamulayija, nokuti kuguba kukwe kunomulaija nezwe zwinhu zwose, akale ichokomende, aatoba maniepwa, sezwa mwakalayijwa galani muna iye.<verse eid="1JN 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />Ngweno, imwi bana indilani mbeli mugala munaiye kutila kuti paachaboneka tibe balozwimisila, tisibe neshoni mbeli kukwe pakuzha kukwe. <verse eid="1JN 2:28" /><verse number="29" style="v" sid="1JN 2:29" />Kana muziba kuti iye ulolulama, zibani kuti wose unota zwilolulama wakazwalwa naiye.<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="s">Bana baMwali</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />Ilingani bukulwana bwoludo lutakapiwa naTate, kuti tishobwe kuwhi tibana baMwali. Akale ndizwo zwinotisa kuti inyika isitizibe isu nokuti aijakonziba. <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />Banakwaina banodikana, ngweno tibana baMwali, zwatichaba azwijanu zwazibikana. Koga tinoziba kuti, kana Kristo aswika, tinooba saiye, nokuti tinoombona sobwaali. <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />Banhu bose banobimba munaiye bano zwichenesa, kuti bebe bachena saiye.<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />Wose unhu unochinya, unotaluka mulawo, nokuti kuchinya kutaluka mulawo. <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />Moziba kuti Kristo wakaboneka kuti ebhise luchinyo, akale muna iye amuna luchinyo. <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />Akuna unogala muna iye unondila mbeli echinya. Unondila mbeli echinya aajanhu ombona akale aatonziba.<verse eid="1JN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7" />Bana, musileke umwenhu emuchenga. Iye unota bululami ulolulama, sobwaali iye wakalulama. <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />Iye unochinya, ngowaguluzhanje, nokuti guluzhanje wagala echinya kuva pakutanga. Chisoko chokuzha koMwananhulumyana waMwali chakaba chili chokupalaja mishingo yaguluzhanje.<verse eid="1JN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9" />Akuna unhu, unozwalwa naMwali, unochinya, nokuti imbeyu yaMwali inogala mwaali, akale angandile mbeli echinya. <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />Yomu ndimo mwatinoziba bana baMwali nabaguluzhanje, unhu wose usinota zwilolulama aatoba mwana wamwali kana nooyo usinoda mwanakwaina uwe.<verse eid="1JN 3:10" /></para>
  <para style="s">Dananani</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />Yeli ndilo iwhi limwakawha kuva pakutanga, linoti, tidanane. <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />Tisibe sa Keyini wakabeli wokumbi, wakabulaya ununa uwe Abhelo. Ani Keyini wakombulayilani? Nokuti mishingo yiye yaluba mibi, koga yonuna uwe yaluba ikalulama.<verse eid="1JN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13" />Banakwaina musichename, kana inyika imubenga. <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />Tinoziba kuti takabhuda mulufu tikangwina mubupenyu, nokuti tinoda banakwaina. Wose usina ludo umomulufu. <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />Wose unobenga mwanakwaina uwe umbulayi, akale moziba kuti akuna umbulayi unabupenyu businopela. <verse eid="1JN 3:15" /><verse number="16" style="v" sid="1JN 3:16" />Yeyi ndiyo inzila yatinoziba nayo ludo, Jesu wakatifila. Nasubo tinokwelela kufila pabanakwaina bedu. <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />Kana umwe ekafuma kova ebona mwanakwaina eyabula esinounwhila ishe, ludo lwaMwali lunoba muna iye chini? <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />Bana bangu banodikana, tisibe banoda namawhi kana nokulebeleka chete, koga nezwito nechokomende.<verse eid="1JN 3:18" /></para>
  <para style="s">Kusima mbeli KwaMwali</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />Yeyi ndiyo inzila yatinoziba kuti tili bechokomende, akale kuti mwoyo yedu tonyetutusa chini mbeli kukwe, <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />kojoba myoyo yedu itipandandu, tino ziba kuti Mwali unkulwana kupinda myoyo yedu, akale unoziba zwose. <verse eid="1JN 3:20" /><verse number="21" style="v" sid="1JN 3:21" />Banakwaina banodikana kana myoyo yedu isinotipa ndandu, tina mwoya nsimu mbeli kwaMwali, <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />akale tinowana zwose zwatinokumbila kuva kunaiye, nokuti tinolondota milawo iye nokuta zwaanoda. <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" />Yoyu ndiwo undawo uwe, kuti tidimbwe muzina lyoMwananhulumyana uwe, Jesu Kristo, akale tidanane sokutilaya kukwe. <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />Yabo banolondota milawo iye, unogala mwabali, naibo mwaali. Ndimo mwatinoziba kuti ugele munasu. Tinozibiswa yezwi nompepo waakatipa.<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s">Umpepo weChokomende noMpepo woniepa</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />Banodikana, musidimbwe umpepo wose, koga ibigeni mukukwejwa mipepo kuti mubone kuti ndiyaMwali na, nokuti bapolofeti banji bamaniepwa baimo munyika. <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />Munounziba uMpepo waMwali nezwi, umpepo wose, unovuma kuti Jesu Kristo wakezha akaba unhu, ngowa Mwali, <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />nooyo umpepo, usinovuma Jesu, autova kunaMwali, koga yoyu wakadalo umbengi waKristo, umwakawha kuti unozha, akale waba munyika kale.<verse eid="1JN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4" />Imwi bana muli baMwali, akale mwakabakoma ibo, nokuti yoyo umo mwamuli unkulwana kunooyo umomunyika. <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />Ibo ndibenyika, akale zwose zwabanolebeka ndizwenyika, nenyika inobawhilila. <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />Tili baMwali, aani naani, unonziba Mwali, unotiwha, koga aani naani, usi waMwali, aatotiwha. Nezwi tinoziba uMpepo wechokomende nompepo wamaniepwa.<verse eid="1JN 4:6" /></para>
  <para style="s">Mwali Ludo</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />Banodikana, ngatidananeni nokuti ludo lunova kunaMwali, akale iye una ludo ulozwalwa naMwali, akale unoziba Mwali. <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />Iye usina ludo, aatoziba Mwali, nokuti Mwali ludo. <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />Munayezwi ludo lwaMwali lwakazwitondeja pakati pedu, kuti Mwali wakatuma Mwananhulumyana uwe umwempela chete munyika, kutila kuti tilalame nomunaiye. <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />Yolu ndilo ludo kusi kuti takada Mwali asi kuti wakatida isu akatumila Mwananhulumyana uwe kuti ebe umpilo woluchinyo lwedu.<verse eid="1JN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11" />Balodikana, sezwo Mwali wakatida ali, neebo isu tokwelela kuti tidanane. <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />Apana unhu wakabona Mwali kana lini, koga kana tidanana, Mwali ugele mukati mwedu, noludo lulwe lunozhajikijwa mwatili.<verse eid="1JN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13" />Ndimomwatinoziba kuti tigele munaiye, neebo iye munasu, ulotipa uMpepo uwe. <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />Tabona akale tasumikija kuti Tate bakatumila Mwananhulumyana wabo kuti ebe uNchiji wenyika. <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />Yoyo unodimbwa kuti Jesu Mwananhulumyana waMwali, Mwali unogala mwaali, naiye unogala munaMwali. <verse eid="1JN 4:15" /><verse number="16" style="v" sid="1JN 4:16" />Nokudalo toziba akale tinodimbwa muludo Mwali lwananalo kwatili.</para>
  <para style="p" vid="1JN 4:16">Mwali ludo, nooyo unogala muludo unogala munaMwali, naMwali unogala mwaali. <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />Munezwo ludo lulwopelela kwatili kutila kuti tisime neZhuba lyokutongwa, nokuti sezwaali iye, ndimo mwatilibo munyika. <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />Amuna lutyo muludo, koga ludo lulopelela lunotatamila lutyo nokuti lutyo lunazwokuta nokulangwa, yoyo unotya aajilopelela muludo.<verse eid="1JN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19" />Isu tinoda, nokuti iye wakatida kutanga. <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />Kana umwe unhu eleba kuti, “Ndinoda Mwali,” asi esinoda mwanakwaina uwe iniepi nokuti yoyo usinoda mwanakwaina uwe waanobona, aangade Mwali waasinobona. <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />Akale tina mulawo unova kuna iye, unoti, unoda Mwali, ngeedebo mwanakwaina uwe.<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s">Kuzunda kwedu Inyika</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />Wose unodimbwa kuti Jesu ndiKristo, yoyo unhu unozwalwa naMwali, akale unhu wose unoda unzwali, unoda mwana uwe. <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />Nezwo tinoziba kuti tinoda bana baMwali, kana tada Mwali tilondota nomulawo uwe. <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />Nokuti yolu ludo lwaMwali, kuti tilondote milawo iye. Akale milawo yiye ayitolema. <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />Nokuti wose unozwalwa naMwali chinozunda inyika, yoku ndiko kuzunda kunokoma inyika, kudimbwa kwedu. <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />Ndiani angakoma inyika, kuzhe koyo unovumila kuti Jesu Mwananhulumyana waMwali.<verse eid="1JN 5:5" /></para>
  <para style="s">Busumikiji nezwa Jesu Kristo</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />Yoyu ndiye wakezha nevula nelopa, Jesu Kristo kusi ivula chete koga nevula nelopa, umpepo ndiye unsumikiji, nokuti Umpepo ndiye ichokomende. <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />Kuna basumikiji butatu, <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />uMpepo, ivula nelopa, akale yezwi zwitatu zwinowililana. <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />Kana titambula busumikiji bwabanhu, busumikiji bwaMwali bukulwana kupinda, nokuti yobu ndibo busumikiji bwaMwali bwaakasumikija nezwo Mwananhulumyana uwe. <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />Yoyo unodimbwa muMwananhulumyana waMwali una busumikiji yobu mukati mumwe, asi yoyo usinodimbwa munaMwali, unounta inyepi, nokuti aajakadimbwa busumikiji bwaMwali bwaanosumikijila pezhulu poMwananhulumyana uwe. <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" />Yobu ndibwo busumikiji bwokuti, Mwali wakatipa bupenyu businopela, akale yobu bupenyu bwimo muMwananhulumyana uwe. <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />Yoyo unano Mwananhulumyana, una nobupenyu asi, usina Mwananhulumyana waMwali, aanabupenyu.<verse eid="1JN 5:12" /></para>
  <para style="s">Bupenyu businopela</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />Ndinomukwalila yezwi, imwi mulodimbwa muzina lyoMwananhulumyana waMwali, kuti muzibe kuti muna nobupenyu businopela. <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />Akale yolu ndilo lubimbo lwatina nalo muna iye, lwokuti kana tikumbila chose chinhu, nenzila yokuda kukwe, unotiwha. <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />Akale kana tiziba kuti unotiwha panazwose zwatino kumbila, tinoziba kuti tawana zwatakumbila kwaali.<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />Kana ungobona mwanakwaina echinya luchinyo lusinotungamila kulufu unokwelela kunamata akale Mwali uchompa bupenyu. Ndikumuleba yabo banaluchinyo lusinotungamilila kulufu. Pana luchinyo lunotungamilila kulufu, andijikumuva kuti munamate nezwazwo. <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />Zwose zwisilolulama luchinyo, koga pana luchinyo lusinotungamilila kulufu.<verse eid="1JN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />Tinoziba kuti yoyo unozwalwa naMwali, aatondilambeli echinya, koga Mwali unobalondota bana babe, akale umbi aatobaguma.<verse eid="1JN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19" />Tinoziba kuti tiliba Mwali, akale inyika yose imomusimba lyaguluzhanje.<verse eid="1JN 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20" />Tinoziba kuti Mwananhulumyana waMwali waswika akale watipa kuwhisisa kutila kuti tiunzibe iye zwechokomende, akale timo mwaali iye wechokomende, muMwananhulumyana uwe Jesu Kristo. Yoyu ndiye Mwali wechokomende, ndiye bupenyu businopela.<verse eid="1JN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21" />Imwi bana, musizwishanganise muzwimwali.<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>