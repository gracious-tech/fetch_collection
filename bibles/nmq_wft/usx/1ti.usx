<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TI" style="id">NTP NAMBYA PROJECT</book>
  <para style="h">1 Timoti</para>
  <para style="toc1">Lukwalo Lwotanga LwaPaulu Kuna Timoti</para>
  <para style="toc2">1 Timoti</para>
  <para style="toc3">1 Tim</para>
  <para style="mt2">Lukwalo Lwotanga LwaPaulu</para>
  <para style="mt1">KUNATIMOTI</para>
  <para style="imt">Matangisilo</para>
  <para style="ip">Iukwalo lyotanga lwaTimoti lukwalo lwakakwalwa noMpositoli Paulu kundayijwa uwe Timoti. Lukwalo lwaTimoti lwotanga lunoyeyelelwa kuti lwakakwalwa mumakole angaba pakati pamakole makumi mashanu ane gumi mwempela lina tubi mushule mokuzwala kwa Kristo kana makumi mashanu ane gumi mwempela lina tuna mushule mokuzwalwa kwaJesu. Yoyu unshaji ungaba pelyo nolufu lwaPaulu. Paulu wakabewhanana kasa naTimoti akale tunji wakaboonshoba kuti mwananhulumyana uwe (baFilipi 2:22 (1 Timoti 1:2, 1:18)</para>
  <para style="ip">Yolu lumwe lwamakwalo mana akakwalwa naPaulu ekwalila unhu kuna kuti ekwalile igubungano. Mamwe matatu ndiTimoti wabili, Tayitasi naFilimoni. Timoti wotanga uzhele nendayijo yokunamata mugubungano (1 Timoti 2:1-15). Zwinota kuti unhu ekwelele kuba untungamili wegubungano (1 Timoti 3: 1, 13). Nokuchenjeja nezwabalayiji boniepa (1 Timoti 1:3-11, 4:1-5, 6:2-5). Yezwi zwinotondejela inzila Paulu yaakabelayija Timoti nayo kuba ntungamili mukati mwegubungano. Timoti wotanga una zwilayijo zwinji zwinobhancha batungamili, kubhata zwibuyanana mishingo yegubungano mubugalo nobugalo.</para>
  <para style="iot">Zwilomumwa</para>
  <para style="io1">Paulu unotanga nokumusa Timoti (1 Timoti 1:1-2)</para>
  <para style="io1">Kova echenjeja Timoti nabalayiji boniepa (1 Timoti 1: 3-11)</para>
  <para style="io1">Paulu unondilambeli elondejela kuboka kukwe kuba naJesu Kristo (1 Timoti 1:1—2-19)</para>
  <para style="io1">Zwitobelwa nokulayija kukwe Timoti kunamata nezwobutungamili bwegubungano (1 Timoti 2-3)</para>
  <para style="io1">Paulu unopejeleja lukwalo lulwe nokupa Timoti indayijo yopejeleja (1 Timoti 4:16-21)</para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />Imi Paulu, umpositoli waKristo Jesu sokulaya kwaMwali uNchiji wedu akale nomuna Kristo Jesu lubimbo lwedu.<verse eid="1TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TI 1:2" />Kuna Timoti mwana wangu wechokomende mukudimbwa.</para>
  <para style="p" vid="1TI 1:2">Mwali Tate naTezi wedu Kristo Jesu bekupe chipiwo, ishe, nolunyalalo.<verse eid="1TI 1:2" /></para>
  <para style="s">Kuchenjeja nendayijo yoniepa.</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />Sokusungwaja kwangu pandakabenda kuMasedoniya, gala muEfeso kutila kuti ulaye bamwe banhu kuti besilayije kana ipi indayijo ilosiyana, <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />kana kuti bezwibalayije nengano jisina ichokomende akale nokubanda matategulu zwisinopela zwinokuja kuyeyesela koga zwisina mabambo aMwali okudimbwa. <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />Chinangwa chokulaywa kwedu ludo lunova mumwoyo unchena nenjeyo imbuya akale nokudimbwa kwechokomende. <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />Bamwe banhu bakabhuda muna yezwi bakapamhala bengwina mukukwejisa mayabwe, <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />bedisisisa kuba balayiji bomulawo, koga besinowhisisa zwabamuleba kana zwabakumusimatija.<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />Ngweno toziba kuti mulawo umbuya, kana umwe ewushingisa zwimomumulawo. <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />Zwiwhisisika kuti mulawo aujilotilwa balolulama koga banobipisa nabasinowhilila, basina zwaMwali nabachinyi, basili bachena akale nabasijiloshambijika, babulayi bamatate nababulayi bamamai, nababulayi babanhu, <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />basangu, ingochani, banopamba banhu, iniepi, banokowha maniepwa, naizwo zwose zwinonyenyeja indayijo imbuya, <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />zwikwendelana neNdebo iMbuya ina lukujo lwaMwali lulokombolelwa lundakapiwa kuti ndilondote.<verse eid="1TI 1:11" /></para>
  <para style="s">Kuboka Ishe jaMwali</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />Ndoboka iye wakandipa isimba, Kristo Jesu Tezi wedu nokuti wakandibona ndikabimbika akandishala kuti ndiunshingile, <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" />kojoba pakutanga ndakabefizha Mwali, ndunjabisa akale nduutila bukali, koga ndakatambula ishe jije nokuti ndakazwita mukusoziba nokusodimbwa, <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />akale chipiwo chaTezi chakafwashukila imi nokudimbwa akale noludo lumo munaKristo Jesu. <verse eid="1TI 1:14" /><verse number="15" style="v" sid="1TI 1:15" />Isumo yeyi ngiyelebeswa akale ilokwelela kutambulwa zwizhele, kuti Kristo Jesu wakezha penyika koochija bachinyi. Akale imi, ndimi nchinyi unkulwana kuna bose, <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />koga ndakatambula ishe neechi chisoko, kuti munami sonkulwana wabachinyi, kutila kuti Jesu Kristo etondejele moyondefu uwe ulopelelela, chili chitondejelo kuna yabo baloodimbwa kuna iye kwobupenyu businopela. <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />Kuna She walini nalini, usinofa, usinoboneka, Mwali umwempela, ngekujwe akale elemekejwe kwemisi isinopela. Ameni.<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />Timoti, mwana wangu ndinokupa indayilo yeyi, zwikwendelana nobupolofeti bwaka tiwa kwauli kuti bukunyungumule kuti ulwane ihondo imbuya, <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />ukabhata kudimbwa nomwoyo umbuya. Nokulamba umoyo umbuya bamwe banhu bakapwachawula kudimbwa kwabo. <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />Bamwe babo ndiHemenausi naAlekizanda, bandakalanga nokupila kuna Satani kuti belayijwe beleke kutuka Mwali.<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="s">Kunamata MuGubungano</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />Chotanga ndinosungilija kuti imbwetejo, minamato, kukumbilila bamwe nokuboka kutilwe banhu bose, <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />akale namashe nabo bose bayipo pezwigalo zwopezhulu, kutila kuti tibe nobupenyu buna kuwhilijila nolunyalalo akale buna kutya Mwali nolulemeko munzila jose. <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />Yezwi zwibuya akale zwinotambulika pambeli paMwali uNchiji wedu, <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />iye unoda kuti banhu bose bechijwe akale kuti bose bebe noluzibo lwechokomende. <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />Nokuti kuna naMwali umwempela, akale kuna unkwendeleji umwempela pakati paMwali nabanhu, unhu Kristo Jesu, <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />iye wakazwipila sendipilo yabanhu bose, busumikiji bwakabaipo nonshaji ulokwelela. <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" />Nezwi ndakaponchwa kuba umbhaunuli akale umpositoli akale uNdayiji wabo Kuzhe mukudimbwa nomuchokomende. Andijikumuniepa, ndikumumubuja ichokomende.<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />Ndinokwemuja kuti mubugalo bose banhulume benamate, benyamula maboko machena pasina kunyema kana kukakabajana, <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" />akale kuti banhukaji banokwelela kumbala zwina chilemelela, zwimbalo zwina bunhu, zwisi zwamasusu alolukwa, kana indalama, kana bushonge kana zwimbalo zwinodula kasa, <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />koga nezwito zwibuya, zwilokwelela banhukaji balodimbwa muchinamati. <verse eid="1TI 2:10" /><verse number="11" style="v" sid="1TI 2:11" />Unhukaji ngelayijwe mukunyalala nokuzwininipisa kose. <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />Anditovumija unhukaji kuti elayije kana kuti ebenesimba pezhulu pabanhulume, iye unokwelela kuwhilijila. <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />Nokuti Adamu wakatanga kubumbwa, kukatobela Eva, <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />akale Adamu aajakachengelwa, koga unhukaji ndiye wakachengelwa akaba unchinyi. <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />Koga unhukaji unoochijwa nokuzwala bana, kana ekasimilila mukudimbwa, muludo, mubuchena nomukujikama.<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="s">Batungamili muGubungano</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />Isumo inolebesa kuti, unhu kana eda chigalo chokuba untungamili wegubungano, unobeda unshingo umbuyanana kasa. <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" />Ngweno untungamili wegubungano unokwelela kuba unhu usinolebelwa chibi paali, unhulume ulolobola unkaji umwempela, ulojikama, unozwikabula, una buchenjevu, una chilemela, unotambula banhu, akale etubula kulayija, <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />usinkolwi, usina luzha koga eli nyolonyolo, usine gakaba akale usinotangala imali. <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />Unokwelela kubhata imhuli iye zwibuyanana, bana babe bezwininipisa akale belina lulemeso munzila jose, <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />kana unhu esinotubula kutungamila ingumba iye, angalondota chini igubungano lyaMwali? <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />Aatokwelela kuba umvumili umpya, nokuti angazwida nokushiya akawila mukulashwa kwaGuluzhanje, <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />nokudalo unokwelela kukujwa nabokuzhe kwegubungano, nokuti angawila mukushundwa akale nomukalabwi kaGuluzhanje.<verse eid="1TI 3:7" /></para>
  <para style="s">Babhanchi muGubungano</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />Babhanchi bomugubungano naibo banokwelela kuba nechimilo chibuya, besintwakubili, besi banwi bewayini, besi mapazwi anovumpila zwose, <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />banokwelela kutambula isiswa lyokudimbwa beli nomwoyo ulolulama upo pachena. <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />Akale ngebetange bakwejwa, kana batondejela kuba balulami, ngabepiwe unshingo wobubhanchi mugubungano. <verse eid="1TI 3:10" /><verse number="11" style="v" sid="1TI 3:11" />Banhukaji ngebebe nechimilo chibuya, basinopita, koga bano zwibhata, beli balo bimbika muzwinhu zwose. <verse eid="1TI 3:11" /><verse number="12" style="v" sid="1TI 3:12" />Babhanchi begubungano ngebebe banhulume bana nkaji umwempela, akale ngebebe bano tubula kulela bana nemhuli yabo zwibuyanana, <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />nokuti yabo bano shinga zwibuyanana saba bhanchi mugubungano banozwiwanila kulemekejwa akale nokubimbika kukulwana mukudimbwa kuna Kristo Jesu.<verse eid="1TI 3:13" /></para>
  <para style="s">Isiswa iGulwana lyokudimbwa kwedu</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />Ndobimba kuswika kwamuli munshaji unshoma unotobela, koga ndikumukwala indayo yeji kutila kuti, <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />kana ndingochelejwa uzibe kuti banhu bano kwelela kuzwibhata chini mugubungano, lili ilyo igubungano lyaMwali umpenyu, ibhango akale nobulambo bwechokomende. <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />Zwinotambulwabo kuti zwilosisika mukunamata Mwali zwikulwana,</para>
  <para style="q1" vid="1TI 3:16">iye wakatondejelwa mumbili.</para>
  <para style="q2" vid="1TI 3:16">Akasimatijwa muMpepo.</para>
  <para style="q2" vid="1TI 3:16">Akabonwa nengilozi jaMwali.</para>
  <para style="q1" vid="1TI 3:16">Akabhaunulwa mukati mwenduji.</para>
  <para style="q2" vid="1TI 3:16">Bakwondimbwa munyika yose.</para>
  <para style="q2" vid="1TI 3:16">Akanyamulilwa kudenga mukungaima.<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="s">Balayiji bamaNiepwa</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />Ngweno uMpepo unoleba pachena kuti munshaji unozha bamwe banoobhuda mukudimbwa nokuwhilila mipepo inochengela akale nendayijo yemipepo mibi, <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />bachengeji babaniepi bana nomwoyo ulokoma beta sabakapiswa imhande nesimbi inopisa, <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />banolambisa banhu kulobolana akale besungwaja kulamba kulya kwakabumbwa naMwali kuti kutambulwe nokuboka naabo banodimbwa akale beziba ichokomende. <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />Nokuti zwose zwakabumbwa naMwali zwibuya, akale apana chinokwelela kulambwa kana chatambulwa nokuboka, <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />nokuti chilo cheneswa newhi lyaMwali akale nonamato.<verse eid="1TI 4:5" /></para>
  <para style="s">Unshingi uMbuya waKristo Jesu</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />Ungolayija yezwi kubanakwaina, unoba unshingi umbuyanana waKristo Jesu, wakakubuswa newhi lyokudimbwa akale nendayijo imbuyanana yawatobela. <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />Usitobele indebo jisina bumwali akale jobulema. Uzwilayije kuzwibhata sezwi nodiwa naMwali. <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />Kojoba kulayija kokusimisa umbili kuli nolubhancho, kutya Mwali kunodikana muzwinhu zwose, sezwo kuli nechibimbiso mubupenyu bwangweno akale nomubupenyu bunozha. <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />Isumo yechokomende inodikana akale inokwelela kutambulwa zwizhele. <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />Nokuti yezwi ndizo zwatinoshingilila nokufundumalila, nokuti lubimbo lwedu lupo panaMwali umpenyu, iye unchiji wabanhu bose, kasakasa waabo banodimbwa.<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />Laya akale ulayije yezwi zwinhu. <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />Pesibe nonhu uchakushundila butukutuku bubo, koga ube chitondejelo kubavumili mundebo, muchimilo, muludo, mukudimbwa nomubuchena. <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />Kuswikila ndezha, bona kuti iwhalo inchena jikumubalilwa banhu bose, ubhaunula, usungwaja nokulayija. <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />Usilekelele chipo cha unanacho, chiwakapiwa nonshamulo wechipolofeti negota lyabakulwana begubungano pa lyakakubiga maboko. <verse eid="1TI 4:14" /><verse number="15" style="v" sid="1TI 4:15" />Unshingo yoyu unte, uzwipile kwazwiili, kutila kuti bose bebone kubhudilila kuko. <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />Zwilondote, nokundayijo iyo, akale ubhatilile kunezwi nokuti ungodalo unozwichija iwi nabawhilili babo banokuwha.<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="s">Mishingo yokutungamilila baVumili</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />Usikalalile unhulume unkulwana koga unsungwaje sezwaunota kuna dade babo, banhulumyana ubabhate sabanakwaina babo, <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />bechinhukaji bakulwana sama mai, bechinhukajana sabakazwaji, mubuchena bose.<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />Kuja inchilikaji jechokomende. <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />Kana inchilikaji ili nabana kana bazekulu, ngebetange kulayijwa unshingo wabo woluvumilo kumhuli jabo akale muneyi nzila belipe nokubhancha bazwali babo, nokuti yezwi zwinotambulika mumesho aMwali. <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />Iyo inchilikaji yechokomende, iliyoga, inobimba naMwali akale indila mbeli ikumbila nokunamata busiku nesikati, <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />koga iyo inchilikaji inoda kasa zwenyika ilofa kojoba ilimhenyu. <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />Balaye pezhulu pezwi kutila kuti besibe nokushundwa. <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />Kana unhu esinobhancha makamu awe, kasa bemhuli iye, yoyo walasha kudimbwa akale umbi kupinda usinodimbwa.<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />Inchilikaji inamakole anova pamakumi mashanu anegumi ngekwalwe, kana akabakalobolwa nondume umwempela, <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />akale ili nobusumikiji bwemishingo yayo mibuya, sonhu wakakubusa bana babe zwibuyanana, ekatambula bezi, ekashambisa makumbo abachena, ekabhancha baimo mubukukutu, ekazwipila kuta zwibuya munzila jose.<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />Koga musikwale inchilikaji inhukutuku, nokuti jingokubukilwa nolulakamilo jinosooda kulobolwa, jipambuka munzila yaKristo, <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />akale jinosooshundwa nokuti jinosoba jalasha chibimbiso chajo chotanga. <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />Kuzhe kwezwi, jinosoozibila kujintayila, jikwendenda mumisha nemisha, zwisizwobusimbe chete koga nokunyeya akale jilinyajo, jilebeleka zwisilokwelela. <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />Nokudalo ndoti inchilikaji inhukutuku ngajilobolwe, jibe nabana, jilondote jingumba jajo, akale jisitite kuti tilebelekwe bubi nombengi. <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />Nokuti bamwe bakalashikila kale kunaSatani. <verse eid="1TI 5:15" /><verse number="16" style="v" sid="1TI 5:16" />Kana peli nonhukaji unodimbwa unamakamu inchilikaji, ngejibhanche, igubungano lisinyajwe, kutila kuti libhanche inchilikaji jechokomende.<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />Bakulwana begubungano banotungamila zwibuyanana banokwelela kukujwa zwilopamululwa, kasa yabo banoshinga kubhaunula nokulayija, <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />nokuti iwhalo inchena inoti, “Usisunge undomo wenkabe ikumushingila muzwilyo.” Akale, “Unshingi ulokwelela indipo yiye.” <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />Usitambule undandu ulopomelwa unhu unkulwana wegubungano, kuzhe kokuti kuli nobusumikiji bwabanhu babili kana batatu. <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />Kunayabo balobhatilila muluchinyo, bakalalile mbeli kwabanhu bose, kutila kuti bose betye.<verse eid="1TI 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1TI 5:21" />Mbeli kwaMwali nokunaKristo Jesu nenhumwa jaMwali jiloshalwa ndokulaya kuti ulondote milawo yeyi zwisineshalulo, usite zwinhu zwineshalulo. <verse eid="1TI 5:21" /><verse number="22" style="v" sid="1TI 5:22" />Usikambije kubiga banhu maboko kuti beshingile Mwali, kana kushanganyila muluchinyo lwabamwe banhu, gala wakashambijika.<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />Usinwe ivula chete, koga shingisa iwaini inshoma kutila muntumbu mumo akale namalwaji manjinji anosokubhata.<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />Luchinyo lwabamwe banhu lupopachena, lunotungamila kubutongo, koga luchinyo lwabamwe lunosooboneka kwapinda unshaji. <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />Nokudalo akale zwito zwibuya zwipo pachena, kojoba kusakadalo, azwitolamba zwakasisika.<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />Bose yabo baipo pasi pejogwe lyobulanda ngebekuje matezi abo, kutila kuti izina nendayijo yaMwali zwisibipiswe. <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />Yabo bana beni banodimbwa abatokwelela kubalelupisa nokuti banakwaina, koga banokwelela kubashingila zwibuyanana kasa nokuti yabo bamushingilwa badimbwi akale badikani.</para>
  <para style="s" vid="1TI 6:2">Indayijo yamaNiepwa neFuma Yechokomende</para>
  <para style="p" vid="1TI 6:2">Layija akale usungwaje mishingo yeyi. <verse eid="1TI 6:2" /><verse number="3" style="v" sid="1TI 6:3" />Kana peli nouchalayija zwisiyezwi akale esinovumilana namawhi echokomende aTezi wedu Jesu Kristo akale nendayijo inokwendelana nokutya Mwali, <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />yoyu ulofutilwa nokuzwitunha, apana chaanoziba, ulolakamila impikenkani nokunyenyejana namawhi, zwinobuzilija izhisho ibi, kupalalana, kunyeya, nokuyeyelana zwibi, <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />akale kukakabajana pakati pabanhu bendangalilo imbi nabasina ichokomende, belangalila kuti kutya Mwali inzila yokuwana ingwano.<verse eid="1TI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6" />Panowanikwa indipo ihulwana kasa pakutya Mwali nokugunchikana, <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />nokuti apana zwatakabuza munyika, akale apana zwatingabhise munyika, <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />koga tingoba nokulya nezwombala, nezwi togunchikana. <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />Koga yabo banodisisisa kufuma banowila mukukwejwa, mukalabwi, nomuzwilakamilo zwinji zwisinamaano zwinokubaja zwichumwikija banhu mukunyonyolwa nokupalajwa. <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />Nokuti kudisisisa imali ndikokutangisa kwobubi bose, nechi chilakamilo bamwe bakabhuda mukudimbwa bakazwibhayaula myoyo yabo namalwaji manji.<verse eid="1TI 6:10" /></para>
  <para style="s">Indayijo kuna Timoti</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />Koga iwi, nhu waMwali, chintuka kunaizwo zwose yezwi, inanga bululami, bumwali, kudimbwa, ludo, busungwali, nobunyolo. <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />Ilwa kulwana kubuya kokudimbwa, bhatilila nesimba kubupenyu businopela buwakashobelwa pawakavuma zwibuyanana mbeli kwabasumikiji banji. <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" />Mbeli kwaMwali unopa bupenyu kuzwinhu zwose, akale naKristo Jesu iye wakapa busumikiji bubuya mbeli kwaPontiyasi Pilato, <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />ndokulaya kuti ulondote mulawo pesina chibi akale pesina kushundwa kujine kooba nokupamuka kwaTezi wedu Jesu Kristo, <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />zwichootondejelwa nonshaji ulokwelela naiye ulokombolelwa akale eli iye ega uNtongi, She wamashe akale Tezi wamatezi, <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />iye ega unabupenyu businopela akale unogala mulumuniko lusinoswikika, iye usanu abonekwa nonhu akale usinoboneka. Kunaiye ngekube lukujo nobutongo businopela. Ameni.<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />Laya yabo balofuma muneno inyika, balaye kuti besishiye, kana kuti bebimbe nobufumi businobimbika koga munaMwali iye unotipa zwose zwinotishantisa. <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />Banokwelela kuta zwibuya, befume muzwito zwibuya, bepe bekasupuka akale bekazwipila kukobelana nabamwe. <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />Nokudalo banozwilonganyila matangisilo mabuya kunezwambeli, kutila kuti bebe nobupenyu buli ibo.<verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />Timoti, linga zwaawakapiwa kuti ulondote. Lekeja kulebeleka zwisina bumwali akale nokunyenyejana pezhulu pezwinowhi luzibo eli maniepwa, <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />nokuvumila yezwi bamwe bakapambuka mukudimbwa.</para>
  <para style="p" vid="1TI 6:21">Chipiwo chaMwali chibe namwi mose.<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>