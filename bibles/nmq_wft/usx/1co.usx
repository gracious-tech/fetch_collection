<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">NAMBYA TRANSLATION PROJECT</book>
  <para style="h">1 BaKolinte</para>
  <para style="toc1">Lukwalo lwotanga lwaPaulu kubaKolinte</para>
  <para style="toc2">1 BaKolinte</para>
  <para style="toc3">1 Bak</para>
  <para style="mt2">Lukwalo Lwotanga lwaPaulu</para>
  <para style="mt1">kubaKOLINTE</para>
  <para style="imt">Matangisilo</para>
  <para style="ip">1 BaKolinte wakakwalwa noMpositoli Paulo munshaji ungaba wamakole makumi mashanu anamashanu mushule mokuzwalwa kwaKristo (1 BaKolinte 1:1) Yolu ndilo lukwako lwotanga lwatinanalo pamakwalo mabili akakwalwa naPaulu kugubungano lyokuKolinte. Angaba akakwala lukwalo yolu nonshaji paakabegala kuEfesasi esanhu akaza kushanyila kuKolinte elimulwendo lwokunda nokubuya kuMasedoniya (1 BaKolinte 16:5-9).</para>
  <para style="ip">Yolu lukwalo lukumushandula zwilebo zwakatambulwa naPaulu kuva kuna bamwe banhu bomugubungano pezhulu pezwimwe zwitiko zwisilolulama mugubungano, zwinoshanganisa lushalulo nobupombwe. Iguta igulwana lyeKolinte lyakabezibikana kasa nobupombwe, nokudalo azwitoshamisa kuti igubungano lyokwakaleko lyakooba nenyaya jakadalo. 1 Kolinte ina imbalo inozibikana kasa yoludo (1 BaKolinte 13:1-13).</para>
  <para style="iot">Zwilomumwa</para>
  <para style="io1">Paulu unomusa baKolinte akale unoboka Mwali pezhulu pabo (1 BaKolinte 1:1-9).</para>
  <para style="io1">Kova elinga inyaya jaakatambula pezhulu pokushalujana mugubungano lyoku Kolinte (1 BaKolinte 1:10—4:21).</para>
  <para style="io1">Unotobela nokulinga inyaya yobupombwe nokusengana kumakota (1 BaKolinte 5:1—6:20).</para>
  <para style="io1">Kuvayopo unopa indayijo munazwokulobolana, kupa umpilo kuzwimwali, kunamata panobonekwa nonhu wose, zwipo zwompepo, nokumuka mukufa (1 BaKolinte 7:1—15:58).</para>
  <para style="io1">Kopejeleja unolinga zwinotikana mubupenyu nezwinoshanganwa nazwo mubupenyu (1 BaKolinte 16:1-24)</para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />Imi Paulu wakashobwa kuba umpositoli waKristo Jesu nokuda kwaMwali, akale nomwanakwaina wedu Sositenesi, <verse eid="1CO 1:1" /><verse number="2" style="v" sid="1CO 1:2" />kugubungano lyaMwali liko kuKolinte, nokunaabo bakacheneswa munaKristo Jesu, nabakashobwa kuba bachena naabo bose baiko kubugalo bulosiyanasiyana beshoba izina lyaTezi wedu Jesu Kristo, Tezi wabo nowedu.<verse eid="1CO 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3" />Chipiwo nolunyalalo zwinova kunaMwali Tate bedu akale naTezi Jesu Kristo zwibe namwi.<verse eid="1CO 1:3" /></para>
  <para style="s">Makombolelo MunaKristo</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />Ndinoboka Mwali unshaji wose pezhulu pechipiwo chiche chamwakapiwa munaJesu Kristo, <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />kuti munzila jose mwakafumiswa, mundebo akale nomuluzibo lwose munaiye. <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />Sezwo busumikiji munaKristo bwakasimatijwa mukati mwenu, <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />kutila kuti musishayiwe zwipo zwoMpepo, muchilomilila kutondejelwa kwaTezi wedu Jesu Kristo, <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />uchamukaba kuswikila kumapejelejo, musina luchinyo nezhuba lyaTezi wedu Jesu Kristo. <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />Mwali ulobimbika, iye wakamushobela kubwanakwaina bwoMwananhulumyana waMwali, Tezi Jesu Kristo.<verse eid="1CO 1:9" /></para>
  <para style="s">Kupambukana MuGubungano</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />Ndinomubweta banakwaina, muzina lyaTezi wedu Jesu Kristo, kuti mose muvumilane kuti kusibe nokukakabajana pakati penu, koga kuti muvumilane mundangalilo akale nondingilo umwempela. <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />Banakwaina bangu, ndakanyeulilwa nabanhu baKuloyi kuti kuna kukakabajana pakati penu. <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" />Zwandikumuleba ndizwokuti umwe noumwe wenu umuti, “Imi ndotobela Paulu,” kana kuti, “Imi ndotobela Apolosi,” kana kuti “Imi ndotobela Kefasi,” kana kuti “Imi ndotobela Kristo.” <verse eid="1CO 1:12" /><verse number="13" style="v" sid="1CO 1:13" />Kristo ulopambulanywa na? Paulu wakakahamililwa imwi na? Kana kuti mwakabhabhatizwa muzina lyaPaulu na?<verse eid="1CO 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 1:14" />Ndinoboka Mwali kuti apana wandakabhabhatiza kuzhe kwaKilisipusi naGeyasi, <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />kuti pesibe umwe wenu angati mwakabhabhatizwa muzina lyangu. <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" />(Ndakabhabhatiza bo imhuli yaSitefanasi. Kuzhe kwaaba, anditokumbulukwa kuti pana bamwe bandakabhabhatiza. <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />Nokuti Kristo aajakandituma koobhabhatiza, koga koobhaunula iNdebo iMbuya, akale zwisi zwobuchenjevu bwopandomo, zwingava zwashampula unchinjikwa waKristo upejwa isimba.<verse eid="1CO 1:17" /></para>
  <para style="s">Kristo Isimba NobuChenjevu BwaMwali</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />Nokuti iwhi lyonchinjikwa mayabwe kunaabo bakumupalala, koga kunasu tikumuchijwa, isimba lyaMwali. <verse eid="1CO 1:18" /><verse number="19" style="v" sid="1CO 1:19" />Nokuti kulokwalwa kuti,</para>
  <para style="q1" vid="1CO 1:19">“Ndoozakunula buchenjevu bwabachenjeli</para>
  <para style="q1" vid="1CO 1:19">akale busoso bwabalochenjela ndoobuzunila.”<verse eid="1CO 1:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="1CO 1:20" />Upoponi unchenjevu? Upoponi unkwali womulawo? Upoponi unyenyeji wamazhubaano? Mwali aajata kuti buchenjevu bwopenyika bube mayabwe na?<verse eid="1CO 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 1:21" />Nokuti mubuchenjevu bwaMwali, inyika ayijakaziba Mwali zwiva mubuchenjevu, zwakashantisa Mwali kuti kuva mubulema bwatinobhaunula kuchijwe yabo banodimbwa. <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />Nokuti baJuda banoda zwishamiso akale baGiliki banoshaka buchenjevu, <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />koga isu tinobhaunula Kristo wakakahamilwa, chikonejo kubaJuda akale bulema kunaBokuzhe, <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />koga kunaabo baloshobwa, kubaJuda nokubaGiliki, Kristo isimba lyaMwali akale nobuchenjevu bwaMwali. <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />Nokuti bulema bwaMwali buchenjevu bukulwana kuna buchenjevu bwabanhu, akale butela bwaMwali bunesimba linopinda lyabanhu.<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />Banakwaina, yeyani kushobwa kwenu, abatoba banji benu bakabaka chenjela sezwilongwa zwenyika, abatoba banji bakabeli nesimba, abatoba banji bakabakazwalwa mubushe, <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />koga Mwali wakashala zwamayabwe munyika kuti eswabise balochenjela, Mwali wakashala zwisina isimba munyika kuti eswabise banamasimba, <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />Mwali wakashala zwipopasi nezwiloshundwa munyika, kana zwinhu zwisipo, kuzakunyula zwipo kuti pebe pesichina zwipo, <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />kutila kuti pesibe nonhu uchazwitunha pambeli paMwali. <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />Mwali ndiye wakamuta kuti mube munaKristo Jesu, iye Kristo wakatiwa naMwali kuti ebe buchenjevu bwedu. Kristo wakatita kuti tibe balulami, bachena akale nolusupuko. <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />Nokudalo, sezwilokwalwa kuti, “Yoyo unozwitunha, ngezwitunhe munaTezi.”<verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="s">Chilayijo Pezhulu PaKristo Wakakahamilwa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />Banakwaina pandakezha kwamuli, andijakezha kwamuli ndibhaunula isiswa lyaMwali ndishingisa mawhi obumhizha akale obuchenjevu bwabanhu. <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />Ndakashaluja kusoziba chinhu pakati penu kuzhe kwaJesu Kristo akale Iye wakakahamilwa. <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" />Pandakezha kwamuli ndakaba ndili untela, ndiluluma kasa nolutyo, <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />akale indebo yangu nembhaunulo yangu zwakazwisi zwamawhi obwetekeja obuchenjevu bwabanhu, koga zwili zwechitondejelo chamasimba oMpepo, <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />kutila kuti kudimbwa kwenu kusibakilwe pezhulu pechimisikijo chobuchenjevu bwabanhu koga pamasimba aMwali.<verse eid="1CO 2:5" /></para>
  <para style="s">Buchenjevu BwaMwali</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />Kunaabo bakubuka mumpepo, tolebeleka buchenjevu, koga busi buchenjevu bonshaji yoono kana bwabatongi benyika yeino, ibo bakumupalajwa. <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />Koga tolebeleka buchenjevu bulosisika bwaMwali, bwaakasunga Mwali kusanhu kwabumbwa inyika kuti chibe chikujo kwatili. <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />Apana wabatongi boono unshaji wakazwiwhisisa yezwi, nokuti ngana bakazwiwhisisa, abajalunkahamila Tezi wolukujo. <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />Koga, sezwilokwalwa kuti,</para>
  <para style="q1" vid="1CO 2:9">“Zwisanu zwabonwa namesho, kana kuwhiwa nenzebe,</para>
  <para style="q2" vid="1CO 2:9">kana kulangalilwa nendangalilo jonhu,</para>
  <para style="q2" vid="1CO 2:9">Mwali wakalonganyila yabo banounda.”<verse eid="1CO 2:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10" />Mwali wakafumula zwinhu yezwi kwatili noMpepo. Nokuti uMpepo unoshaka zwinhu zwose, kana muntika mwaMwali. <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />Ndiani unhu angaziba indangalilo jonhu kuzhe kwompepo umo munaiye mweni? Zwikadalo, apana unowhisisa miyeyo yaMwali kuzhe koMpepo waMwali. <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />Ngweno atijatambula umpepo wenyika, koga uMpepo unova kunaMwali, kutila kuti tiwhisise zwipo zwatilopiwa naMwali pesina indipo.<verse eid="1CO 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 2:13" />Akale isu toleba yezwi namawhi atisakalayijwa nobuchenjevu bwabanhu koga noMpepo, kupandululala ichokomende lyompepo kunaabo bananoMpepo. <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />Unhu wenyama aatotambula zwipo zwoMpepo waMwali, nokuti bulema kwaali, akale aatotubula kuzwiwhisisa nokuti zwinopenyengulwa nompepo. <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />Unhu unanoMpepo unopenyengula zwinhu zwose, asi iye nokukwe aangapenyengulwe noumwe.</para>
  <para style="q1" vid="1CO 2:15">“Ndiani unaluzibo nendangalilo jaTezi?</para>
  <para style="q2" vid="1CO 2:15">Kuti etubule kuundayija?”</para>
  <para style="m" vid="1CO 2:15">Koga isu tinendangalilo jaKristo.<verse eid="1CO 2:15" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s">Bashingi baMwali</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />Banakwaina, andijalolebeleka namwi sabanhu bompepo, koga sabanhu benyika, sabana bacheche munaKristo. <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" />Ndakamunwisika unkaka, kusi kulya kukukutu, nokuti amujakabanu mwakwelela ikwo, akale kojoba alo amujanu mwakwelela, <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />nokuti nangweno muchili benyika. Nokuti kana pelinoluchibo nokukakabajana mukati mwenu, amutoba benyika yeino na? Akale amujikumuta zwinotiwa nabanhu koga na? <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" />Nokuti kana umwe eti, “Imi ndinotobela Paulu,” umwe eti, “Imi ndinotobela Apolosi,” amuli ibo banhu benyika na?<verse eid="1CO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5" />Ani Apolosi ndiani na? Paulu ini? Bashingi bakamuta kuti mudimbwe, umwe noumwe wakashinga sokupiwa kukwe naTezi. <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" />Imi ndakabyala imbeyu, Apolosi wakadilila, koga Mwali ndiye wakakubusa. <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />Nokudalo umbyali, kana unodilila abatoba chinhu, koga ulokosha ndiMwali unokubusa. <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />Yoyo unobyala noyo unodilila bana chinangwa chimwempela, asi umwe noumwe unootambula indipo yiye sokushinga kukwe. <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />Nokuti isu tibashingikwaina baMwali, imwi muminda waMwali, muchibakwa chaMwali.<verse eid="1CO 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 3:10" />Nezwe chipiwo chandakapiwa naMwali, sombaki unabumhizha ndakabiga chimisikilo, umwe unhu ukumubaka pezhulu pacho. Nokudalo umwe noumwe ngechenjelele kuti unobaka chini pezhulu pacho. <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />Nokuti apana chimwe chimisikilo chingabigwa noumwe kuzhe kwecho chakabigwa kale, icho chili Jesu Kristo. <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />Feno kana umwe angobaka pezhulu pechimisikilo yechi nendalama, isiliva, mabwe alokosha, namapango, kana mashanga, nobuhwa, <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />unshingo wonhu nonhu unozwitondejela, nokuti iZhuba yelyo linoozwibhisila pachena, nokuti unoofumulwa nomoto, akale moto unookweja kuti unshingo womwe noumwe ulotiwa chini. <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />Kana unshingo wakabakwa nonhu pezhulu pechimisikilo ungowanikwa ulimile mushule mokukwejwa nomoto, umbaki yoyo unotambula indipo. <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />Asi kana unshingo wonhu ungopiswa, yoyo unolashikilwa nazwose, kojoba iye nokukwe akachijwa, asi kuchijwa kukwe kunoba sonhu wachijwa mumoto.<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />Imwi amutoziba na kuti mutempeli lyaMwali, akale nokuti uMpepo waMwali unogala mwamuli? <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />Kana unhu epalaja itempeli lyaMwali, Mwali unoompalaja. Nokuti itempeli lyaMwali ijena, akale yelyo itempeli ndimwi.<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />Kusibe nouchazwichengeja. Kana umwe pakati penu eyeya kuti ulochenjela nouno unshaji, ngezwite ilema kuti ebe ulochenjela. <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />Nokuti buchenjevu bwopenyika yeeno mayabwe kunaMwali. Nokuti zwilokwalwa kuti, “Iye unobhata bachenjevu mubuchengeji bwabo,” <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />akale iwhalo inchena jinoti, “Tezi unoziba kuti indangalilo jabachenjevu mayabwe.” <verse eid="1CO 3:20" /><verse number="21" style="v" sid="1CO 3:21" />Nezwo kusibe nonhu unozwitunha nozwabanhu. Nokuti zwose zwinhu ngozwenu, <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />kungaba Paulu, kana Apolosi, kana Kefasi, kana ipasi lyose, kana bupenyu, kana lufu, kana yono unshaji kana unozha, zwose yezwi ngozwenu, <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />akale imwi mulibaKristo, akale Kristo ngowaMwali.<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s">BaPositoli BaKristo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />Nokudalo, banhu balokwelela kutilinga sabashingi baKristo akale sabanhu balobhatiswa isiswa lyaMwali. <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />Akale zwinokwelela kuti babhati bebe balobimbika. <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />Koga kunami, chinhu chitukutuku kuti nditongeswe namwi, kana kutongeswa negota lyabanhu. Kana imi nokwangu anditozwitongesa. <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />Luyeyo lwangu luchena, koga azwitoleba kuti andina undandu. Iye Tezi ndiye unonditonga. <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />Nokudalo musipe untongo unshaji usanu waswika, asi imani kujine Tezi eswike, iye uchabiga pachena zwinhu zwose zwilosisika munhilima akale uchabhisila pachena zwinangwa zwomwoyo. Nokudalo unhu wose unootambula lukujo lulwe kunaMwali.<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />Banakwaina ndashingisa zwose yezwi ndikwejanisa imi naApolosi sezwibonelo kumulayija kuti indebo yeyi inotini inoti, “Musipindilile pana zwilokwalwa,” akale kusibe noumwe wenu unozwifufumula nokuda koumwe unhu kupinda umwe. <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />Ndiani unokupa isimba kuti upe untongo kunabamwe? Ini chauna nacho chausakapiwa? Kana wakachitambula, unoshiyilani biya sokuti achitoba chipo?<verse eid="1CO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8" />Munanazo zwose zwamunoda! Mwafuma kale! Mwaba mashe kale musina nasu! Akale ndokwemuja kuti ngana mwaba mashe, kutila kuti tikobelane butongi namwi! <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />Sokuyeya kwangu ndinoti Mwali wakatondejela isu bapositoli sabokupejeleja kunaibo bose, sabanhu bakatongelwa lufu, nokuti tatiwa chinu chokuyebwa munyika yose, kungilozi nokubanhu. <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />Isu timalema pezhulu paKristo, asi imwi mulochenjela munaKristo! Isu tinabutela, asi imwi mubasimu! Imwi munolemekejwa, asi isu atitolemekejwa! <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />Kuswikila unshaji yono tinanenzhala nenyota, tilojelukilwa, timulobwa akale tisina pokugala, <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" />akale timushinga nesimba, tishinga namaboko edu. patinotukwa, tokombolela, patinoyabiswa, tobhatilila, <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />patinoniepejelwa, toshandula zwinyolonyolo. Nangweno ali tishambwa lyopenyika yose, sezwisheshemo zwezwinhu zwose.<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />Andijimumukwalila yezwi kuti mubeneshoni, asi kuti ndimuchenjeje sabana bangu banodikana. <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />Kojoba muli nabaleli zwiulu munaKristo, amuna matate manji. Nokuti imi ndakaba tate benu munaKristo Jesu pezhulu pokumubhaunulila indebo iMbuya. <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" />Ndikumumusungwaja kuti mube bakwejejeli bangu. <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />Nokudalo ndakamutumila Timoti, mwana wangu unodikana akale unobimbika munaTezi, kuti emukumbuluje inzila jangu munaKristo, sobundinolayija mubugalo bose nomumakubungano ose.<verse eid="1CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18" />Bamwe banozwitunhumwija babweni soti andichinoozha kwamuli. <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />Koga ndinoozha kunamwi nokukambijisa, kana Tezi evuma, ndipo pandichoobona, kusi chete indebo jaabo banozwitunhumwija akale kuti banesimba lipi. <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />Nokuti bushe bwaMwali abumo mukulebeleka, koga isimba. <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />Ini chamunoda? Ndizhe kwamuli nonzato, kana ndizhe noludo mumpepo unyolo?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s">Busangu MuGubungano</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />Pana zwimunyeulwa kuti munabusangu mukati mwenu, ibwo businowanikwa kana mukati mwabokuzhe, nokuti unhulumyana umushangana nonkaji watate babe. <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />Akale munoshiya! Amutokwelela kuti mulile na, akale nokutata mukati mwenu yoyo ukumuta yezwo? <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />Kojoba ndisipo kwombili ndinanamwi mumpepo, ndapa kale untongo muzina lyaJesu kuna yoyu wazwita soti ndinamwi, <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />Pamunoshangana, umpepo wangu una namwi, nesimba lyaTezi Jesu, <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />yoyu nhulumyana mumpile kunaSatani kuti umbili uwe upalajwe, kutila kuti umpepo uwe uchijwe nezhuba lyaTezi Jesu.<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />Kuzwitunha kwenu akutoba kubuya. Amutoziba kuti umfufumuso unshoma unofufumusa chifhuwha chose. <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />Bhisani umfufumuso wantolo kuti mube chifhuwha chipya musina umfufumuso nokuti ndimo mwamuli. Nokuti Kristo imhwizana yedu yepasika, wakapilwa. <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />Nokudalo ngatipembeleleni miliya yeyi, tisinoshingisa umfufumuso wantolo, umfufumuso wolunya nobubi, koga nechinkwa chisina umfufumuso chenjikamo nechokomende.<verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />Ndakamukwalila mulukwalo lwangu kuti musikamujane nabasangu, <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />ndisinova basangu benyika yeyi, kana mapazwi nabapambi, kana banonamata zwimwali, nokuti kana kwakadalo, mwalukwelela kubhuda munyika. <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />Koga ngweno ndikumumukwalila kuti musikamujane nonhu unezina lyokuti mwanakwaina, kana elinondandu wobusangu, bupazwi, unonamata zwimwali, unogala akatukana, unkolwi, umpambi, amutokwelela kana kulya naye wakadalo.<verse eid="1CO 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12" />Nokuti imi ndinaneni nokupa untongo bokuzhe? Abatoba ibo na baimo mugubungano bamunokwelela kubetesa? <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />Mwali unotonga bokuzhe. “Tatani unhu yoyo umbi pakati penu.”<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s">Kusengana Kumakota Omulawu Kwabanakwaina BeGubungano</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />Kana umwe wenu eli nondandu nomwanakwaina ulokwelela na kunda kumakota abasinodimbwa kuna kuti ende kubachena? <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />Amutoziba na kuti bachena banootonga ipasi lyose? Akale kana inyika yose itongwa namwi, imwi mungasotubula kubetesa milandu mitukutuku na? <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />Amutoziba na kuti isu toopa untongo ingilozi? Nezwo tingakonwa neni nenyaya jobupenyu yobu! <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />Nokudalo kana muli nenyaya yakadai, moyisengelani kuna yabo basinolemekejwa negubungano? <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />Ndinoleba yezwi kuti mube neshoni. Ndimo na kuti apana umwempela pakati penu ulochenjela angatubula kutonga inyaya jabanakwaina? <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />Koga mwanakwaina unosenga mwanakwaina kugota lyomulawo, akale yezwi ezwita pambeli pabasinodimbwa!<verse eid="1CO 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7" />Kusengana kumakota omulawu zwinoleba kukonwa kwenu. Ini musinotambula kuchinyilwa? Ini musinovuma kuchebelwa? <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />Koga imwi momene mochinya nokuchebela, akale yezwi muzwitila banakwaina benu. <verse eid="1CO 6:8" /><verse number="9" style="v" sid="1CO 6:9" />Amutozwiziba na kuti basilolulama abatoopiwa ifuma yobushe bwaMwali? Musichengwe, basangu, banonamata zwimwali, bapomboli, nabanolala nabanhulumekwaina, <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />nembava, mapazwi, bakolwi, batuki, kana bapambi apana uchoolya ifuma yobushe bwaMwali. <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />Bamwe benu bakabeli alo. Asi mwakashambiswa, mukacheneswa, mukalulamiswa muzina lyaTezi Jesu Kristo, akale nomuMpepo waMwali wedu.<verse eid="1CO 6:11" /></para>
  <para style="s">Ishingisani Mibili Yenu Kukuja Mwali</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />“Ndinovumijwa kuta zwinhu zwose,” asi azwitoba izwo zwose zwinobhancha. “Ndinovumijwa kuta zwinhu zwose,” asi anditoopiwa undanda nechimwe chinhu. <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />“Kulya kwakatilwa untumbu akale untumbu kulya,” asi Mwali unoopalaja bubili bwazwo. Umbili aujilotilwa kuta busangu, koga kushingila Tezi, akale Tezi kuba nesimba pezhulu pombili. <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />Mwali wakamusa Tezi, akale unootimusa nasubo nesimba lilye.<verse eid="1CO 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15" />Amutozwiziba na kuti mibili yenu imhingu jaKristo? Biya ndingatola imhingu jaKristo kova ndijishanganisa nemhingu jombili wevemu na? Mane pe! <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />Amutozwiziba na kuti yoyo unozwishanganisa nevemu unoba umbili umwempela nalyo? Sezwilokwalwa kuti, “Yabo babili banooba umbili umwempela.” <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />Koga yoyo ulobhatana naTezi unoba umpepo umwempela naye.<verse eid="1CO 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18" />Tizhani busangu! Lwose lumwe luchinyo lunotiwa nonhu lukwo kuzhe kwombili, asi unhu unsangu unochinyila umbili uwe. <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" />Amutozwiziba na kuti umbili wenu itempeli lyoMpepo uNchena, unolalama mwamuli, umwakatambula kuva kunaMwali? Akale amutoba benu, <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />nokuti mwakatengwa nendipo. Nokudalo kujani Mwali nemibili yenu.<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="ip" />
  <para style="s">Mibhuzo Nezwokulobolana</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />Ngweno pezhulu penyaya imwakakwala.</para>
  <para style="p" vid="1CO 7:1">Zwibuya kuti unhulume esinde pabulo nonhukaji. <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />Koga pezhulu pechikwejo chobusangu, unhulume umwe noumwe ngeebe nonkaji uwe, nonhukaji bo umwe noumwe nondume uwe. <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />Undume ngepe unkaji uwe inkwelelo yiye sonkaji uwe, nonkaji ete alo kundume uwe. <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />Nokuti unkaji aatotonga umbili uwe, asi undume uwe ndiye unountonga, zwili alo bo undume aatotonga umbili uwe asi unkaji uwe. <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />Musiminyane inkwelelo youmwe kunoumwe, kuzhe kwokuti mwawhanana kwonshaji, kuti mube nonshaji wokunamata, asi mubuye mushangane akale kutila kuti Satani elekeje kumukweja pezhulu pokusotubula kwenu kuzwibhata.<verse eid="1CO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 7:6" />Ndoleba yezwi sechivumilano, kusi kumumanikija. <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />Imi ndaluda kuti ngana bose baba sobwandili. Koga umwe noumwe unanechipo chiche chaalomisilwa chinova kunaMwali, umwe unopiwa cholu luji akale umwe cholumwe.<verse eid="1CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8" />Kuna basilolobolwa kana kulobola, nokunchilikaji ndinoti zwibuya kwabali kuti begale boga sami. <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />Koga, kana besinotubula kuzwibhata ngebelobole kana belobolwe. Nokuti kulobola kana kulobolwa kubuya kupinda kupya neshungu jolulakamilo.<verse eid="1CO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10" />Kuna balolobolana ndobalaya, kusi kuti ndimi koga ndiTezi, kuti unkaji esipambukane nondume uwe. <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />Asi kana apambukana naye ngegale eli ega esakalobolwa, kana kuti ebwilizane nondume uwe akale kuti undume esishime unkaji uwe.<verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />Kunamwi bamwe mose, ndimi ndinoti, atoba Tezi pe, kuti kana peli nomwanakwaina unanonkaji usinodimbwa, asi unkaji evuma kugala naye, iye aatokwelela kuunshima. <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />Kana unhukaji elinondume usinodimbwa, asi undume evuma kugala naye, iye bo aatokwelela kuunshima. <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />Nokuti undume usinodimbwa unocheneswa pezhulu ponkaji uwe, akale nonkaji usinodimbwa unocheneswa pezhulu pondume uwe. Ngana kusi alo, bana benu ngana belishambwa, asi feno bachena. <verse eid="1CO 7:14" /><verse number="15" style="v" sid="1CO 7:15" />Koga kana yoyo usinodimbwa eda kupambukana, ngezwibe alo, nokuti pakadai wechinhulume nowechinhukaji esilosungililwa. Nokuti Mwali wakatishobela kugala nolunyalalo. <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />Iwi nkaji, ungaziba chini kuti ungoonchija undume uwo? Iwi ndume, ungaziba chini kuti ungoonchija unkaji uwo?<verse eid="1CO 7:16" /></para>
  <para style="s">Galani Sokushobwa Kwenu NaMwali</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />Umwe noumwe ngelalame bupenyu bwaakapiwa naTezi, akale Mwali bwaakonshobela. Yoyu ndiwo mulawo wangu mumakubungano ose. <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />Upo na wakaba akamhalajwa nonshaji wokushobwa kukwe? Esishake kubhisa imhande yemhalajo. Upo na wakaba esakamhalajwa nonshaji wokushobwa kukwe? Esishake kumhalajwa. <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />Nokuti kumhalajwa kana kusomhalajwa akutobhancha chinhu, asi kulondota milawo yaMwali ndiko kulokosha. <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />Umwe noumwe ngegale muchimo chaakashobelwa. <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />Wakaba uli undanda pawakashobwa na? Usizwilye mwoyo nazwo. Asi kana zwitikana kuti ungawana lusungunuko lulwo, lushake ukweje kuluwana. <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />Nokuti yoyo wakashobelwa kunaTezi eli undanda, unhu ulosupuka waTezi. Zwili alo bo, yoyo wakashobwa eli ulosupuka undanda waKristo. <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />Mwakatengwa nendipo, musibe balanda babanhu. <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />Banakwaina, aani nani ngegale muchimo chaakabeli paakashobwa naMwali.<verse eid="1CO 7:24" /></para>
  <para style="s">Mibhuzo Pezhulu Paabo Basilolobolwa Nenchilikaji</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />Ngweno penyaya yabasilolobolwa, andina undayo waTezi, koga ndomupa unjeyo wangu sonhu ulobimbika akale wakawana ishe jaTezi. <verse eid="1CO 7:25" /><verse number="26" style="v" sid="1CO 7:26" />Kuyeya kwangu ndinoti zwibuya kuti pezhulu penjabulo jipo ngweno, unhu ngegale sobwaali. <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />Ulosungililwa kunkaji uwo na? Usishake kusungunulwa. Aujilolobola na? Usishake kulobola. <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />Asi ungolobola, aujachinya, akale kana unsichana elobolwa, aajimuchinya. Koga banolobola kana kulobolwa banoshangana namasheto omunyika, imi ndoda kumutabilija munaizwo yezwi.<verse eid="1CO 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29" />Banakwaina ndimuleba kuti, unshaji wakatalwa waba umfupi kasakasa, kuvila feno yabo bana bakaji begale sabasina, <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />akale banolila bebe sabasinolila, baloshanta bebe sabasiloshantilwa, akale banotenga bebe sabasina chinhu, <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />yabo banoshinga zwenyika bebe sabasilo sungwa nazwo zwenyika. Nokuti chimo chenyika yeyi chikumupinda.<verse eid="1CO 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32" />Ndoda kuti musungunuke munazwinomulya moyo. Unhulume usilolobola unozwilya moyo pezhulu pezwinhu zwaTezi, kuti angashantisa chini Tezi, <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />asi unhulume unankaji, unozwilya moyo nozwenyika, kuti angonshantisa chini unkaji uwe, <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />nezwo ishungu jije jiloganukana. Unhukaji kana unsichana usilolobolwa unozwilya moyo pezhulu pezwaTezi, kuti angaba unchena chini mumbili nomumpepo, koga unhukaji ulolobolwa unozwilya moyo pezhulu pezwenyika, kuti angashantisa chini undume uwe.<verse eid="1CO 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 7:35" />Yezwi ndimuzwilebela kuti mubhanchikane, kusi kuti ndimujibilije koga kuti ndinyamule chilayijo chamakwendelo mabuya akale kuti mube munozwipila kasa kunaTezi.<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />Kana peli nounoyeya kuti aachijilojikama mubugalo bubwe pezhulu pemhandala iye yalotangila, akale kana ishungu jije jolulakamilo junkubukila, kana ewha eda kulobola, ulokwelela kuta kuda kukwe. Aajikumuchinya. <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />Koga yoyo ulozikatila mumwoyo uwe, esina lushako koga etubula kuzwibhata muludo lulwe, akale ekazwimisila mumwoyo uwe kuti esiundobole, unota zwibuya kana ayeya kusoundobola unsichana. <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />Nokudalo yoyo unolobola imhandala iye, unota zwibuyanana, akale noyo unolekeja kulobola unota zwibuyanana kasa.<verse eid="1CO 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39" />Unkaji ulosungililwa kundume uwe kana eli umpenyu. Kana undume angopalala, ulosupuka kuti elobolwe kana nani waanoda, asi ngebe unodimbwa munaTezi. <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />Asi umbonelo wangu ngowokuti angaba nolushanto lukulwana kasa angogala sobwaali. Akale ndoyeya kuti nami ndina noMpepo waMwali.<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s">Umbhuzo Pezhulu Pezwokulya Zwinopilwa Kuzwimwali</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />Ngweno nenyaya yezwokulya zwinopilwa kuzwimwali,</para>
  <para style="p" vid="1CO 8:1">“tose tinoziba kuti tina luzibo.” “Luzibo” lunofufumula, asi ludo lunobaka. <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />Kana unhu eyeya kuti unoziba chimwe chinhu, aajanhu aziba sobwaanokwelela kuziba. <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />Koga kana unhu eda Mwali, yoyo unozibwa naMwali.<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />Nenyaya yokulya zokulya zwinopilwa kuzwimwali, tinoziba kuti akuna umwe Mwali kuzhe kwaIye ega. <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />Kojoba bangaba belipo banowhi bamwali kudenga kana penyika, kasa baipo “bamwali” banji akale, “namatezi” manji, <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />koga kwatili kuna naMwali umwempela, Tate, kunovila zwinhu zwose akale watinolalamila, Tezi umwempela, Jesu Kristo, nomunaiye zwinhu zwose zwakabumbwa akale nomunaiye tinolalama.<verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />Asi abatoba banhu bose banaluzibo yolu. Koga bamwe, balozibila zwimwali banolya kulya sokuti chokomende kwakapilwa kuzwimwali, luyeyo lwabo lulodemuka, lunova lwaswibhiswa. <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />Kulya akungatisendeje kunaMwali. Apana zwatinolashikilwa nazwo tingosolya, akale apana zwatinowana nokulya.<verse eid="1CO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9" />Chenjelani kuti lusungunuko lwenu lusibe chikonejo kuna bananoluyeyo lulodemuka. <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />Nokuti wose unhu unokubona uligele mutempeli lyezwimwali ulikumulya, iwi uli unhu unaluzibo, yoyo unabutela muluyeyo lulwe aatoosungwajika kulya zwolya zwilopilwa kuzwimwali na? <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />Akale noluzibo lulwo wabulaya mwanakwaina uwo unabutela, iye wakafilwa naKristo. <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />Banakwaina kana muchinyila nokulwajisa luyeyo lwomwanakwaina unabutela, mochinyila Kristo. <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />Nokudalo, kana kulya kuwigisa mwanakwaina wangu, andichinoolya inyama kuswikila nalini, kuti ndisiwigise mwanakwaina wangu.<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s">Inkwelelo NeMishingo YoMpositoli</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />Andijilosungunuka na? Anditoba umpositoli na? Andijakombona Jesu Tezi wedu na? Imwi amutoba michelo yemishingo yangu munaTezi na? <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />Kana kunabamwe ndisi umpositoli, koga ndili iye kwamuli, nokuti imwi muchisimatijo chobupositoli bwangu kunaTezi.<verse eid="1CO 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3" />Yoku ndikwo kuzwitabilija kwangu kuna yabo banondipenyengula <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />Atilokwelela kuti tibhanchwe nezwokulya nokunwa namwi na? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />Atilokwelela na kupelekejwa nonkaji unodimbwa, sabamwe bapositoli, akale bakazwaji bechinhulume baTezi naKefasi? <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />Kana ndimi naBhanabhasi chete tilokwelela kushinga kuti tilalame? <verse eid="1CO 9:6" /><verse number="7" style="v" sid="1CO 9:7" />Ndiani undwi unoshinga ezwilipa nemali yiye? Ndiani unolima chilili chonzhambi esinolya unchelo wacho? Ndiani unolyisa chuma esinolya unkaka wacho?<verse eid="1CO 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8" />Ndikumuleba yezwi musimba lyabanhu na? Mulawo aujikumuleba zwimwempela na? <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" />Nokuti zwilokwalwa mumulawo waMozesi kuti, “Usisunge undomo wenkabe kana ishokola zwilyo.” Mwali ukumuzwinyaja nenkabe na? <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />Aajikumulebeleka yezwi pezhulu pedu na? Zwakakwalilwa isu, nokuti undimi nounoshokola banota yezwi mulubimbo lokuti bewane unkobe muzwilyo. <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" />Kana tabyala imbeyu yompepo pakati penu, azwitokwelela na kuti tiwane imbuyilwa yezwinobhatika zwenyika kwamuli? <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />Kana bamwe bekwelela kubhanchwa namwi, isu atijilokwelela kuwana lukulwana na?</para>
  <para style="p" vid="1CO 9:12">Kojoba kwakadalo, atijakaishingisa yeyi inkwelelo, koga takawhilijila tikazwimisila kuna izwo zwose kuti tisibige chikonejo munzila yeNdebo iMbuya yaKristo. <verse eid="1CO 9:12" /><verse number="13" style="v" sid="1CO 9:13" />Amutozwiziba na kuti yabo banoshinga mutempeli banowana kulya kwabo mutempeli, akale naabo banoshingila pedebulilo banokobelana zwompilo wedebulilo? <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" />Munzila imwempela, Tezi wakalaya kuti yabo banobhaunula iNdebo iMbuya banokwelela kuwana bupenyu bwabo muNdebo iMbuya.<verse eid="1CO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15" />Koga imi andijanu ndashingisa inkwelelo yeyi, akale andijikumumukwalila kuti zwitiwe kwandili. Nokuti ndingakwemuja kufa kuna kuti unhu enditolele yezwi zwandinoshiya nazwo. <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />Nokuti kana ndibhaunula iNdebo iMbuya, yezwi azwitondishiyisa. Nokuti ndikumusundilwa kuta alo. Lutaka kwandili kana ndisinobhaunula iNdebo iMbuya! <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />Nokuti kana ndita yezwi nokuda kwangu, ndoba nendipo, koga kana kusi kuda kwangu, ndota yezwi sonshingo wandilomisilwa. <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />Ani indipo yangu ngeyipi? Yezwi chete, kuti mukubhaunula kwangu iNdebo iMbuya kusibe nokulipisa, ndisinoshingisa inkwelelo yangu zwizhele muNdebo iMbuya.<verse eid="1CO 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />Kojoba ndakasungunuka kubanhu bose, ndakazwita undanda kunaibo bose kutila kuti ndiwanile Kristo banji. <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />KubaJuda ndakaba sonJuda kutila kuti ndiwane baJuda, kuna yabo baipo pasi pomulawu ndakaba soupo pasi pomulawu, kojoba ndisakabeli pasi pomulawu, kutila kuti ndiwane baipo pasi pomulawu. <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />Kunaabo baiko kuzhe kwomulawo ndakaba soumwe ukokuzhe kwomulawo, kusi kusongunuka kumulawo waMwali koga ndili pasi pomulawu waKristo kuti ndiwane yabo baiko kuzhe komulawu. <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />Kuna banabutela, ndakaba idela, kuti ndibuze matela kunaKristo. Ndakaba zwinhu zwose kubanhu bose, kuti nditubule nenzila jose kuchija bamwe.<verse eid="1CO 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 9:23" />Zwose yezwi ndozwitila iNdebo iMbuya, kuti ndiwane unkobe mumakombolelo ayo. <verse eid="1CO 9:23" /><verse number="24" style="v" sid="1CO 9:24" />Amutoziba na kuti bose banolabuka banogundujana, koga umwempela chete ndiye unowana indipo? Nokudalo labukani kuti muwane indipo. <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />Bose banogundujana mumizano banozwitiba muzwinhu zwose. Banota yezwi kuti betambule chilemba chinoshakala, koga isu towana chisinoshakala. <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />Nokudalo imi anditolabuka sonhu usibweni zwaamulabukila, anditoloba ifaindi sonhu ukumuloba umpepo, <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />koga ndoloba umbili wangu ndiunkoma, kutilakuti mushule mwokubhaunulila bamwe imi nokwangu ndisilashwe.<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s">Chichenjejo Pezhulu Pokunamata Zwimwali</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />Banakwaina ndoda kuti muzibe, kuti matate edu ose akabeli mudako lyegole, akale bwose bakavubuka igungwa, <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />bwose bakabhabhatizwa mugole nomugungwa, bakaba batobeli baMozesi. <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />Akale bwose bakalya kulya kompepo kumwempela, <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />akale bwose bakanwa kunwa kompepo umwempela. Bakanwa Mubwe lyompepo lyakabebapelekeja, ibwe yelyo lyakaba liliKristo. <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />Koga bunji bwabo abajakashantisa Mwali, nokudalo mitumbu yabo yakamezhwa mugwegulu.<verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />Ngweno yezwi zwinhu zwichenjejo kwatili, kuti tiside bubi sezwabakata. <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />Musibe banonamata zwimwali sezwakabetiwa nabamwe babo, sezwilokwalwa kuti, “Banhu bakagala pasi kuti belye nokunwa, akale bakamilika bezana zobuhungu.” <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />Tisite zwobusangu sezwabakata bamwe babo, zwiulu makumi mabili nabatatu bakafa izhuba limwempela. <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />Tisibige Kristo mukukwejwa, sezwakatiwa nabamwe babo bakapalajwa nenyoka, <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />musinyunyute sabamwe bakapalajwa noMpalaji. <verse eid="1CO 10:10" /><verse number="11" style="v" sid="1CO 10:11" />Ngweno yezwi zwinhu zwakatikana kwabali sechichenjejo, koga zwakakwalilwa kuti ibe indayijo kwatili, taswikilwa nonshaji wamapejelejo.<verse eid="1CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 10:12" />Nokudalo yoyo unoyeya kuti umile ngechenjele kutila kuti esiwe. <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />Apana kukwejwa kwakamuswikila kusilozibilika kubanhu. Mwali ulobimbika, akale aatomulekeja mukwejwa zwipo pezhulu pamasimba enu, koga mukukwejwa unomupa inzila yokupujumuka, kutila kuti mutubule kuzwimila.<verse eid="1CO 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />Nokudalo banodikana bangu tizhani kunamata zwimwali. <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />Ndimulebeleka nabanhu banowhisisa, lingani kuti motini nezwandimuleba. <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" />Unkombe wokuboka watinokombolela, akutoba kushanganyila mulopa lyaKristo na? Chinkwa chatinopemula achitoba kushanganyila mumbili waKristo na? <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />Sezwo kuli nechinkwa chimwempela yechiya, isu kojoba tili banji timbili umwempela, nokuti tose tokobelana chinkwa chimwempela.<verse eid="1CO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18" />Langalilani banhu bokwaIzilayeli, kuti yabo banolya umpilo, balyijani pedebulilo lyaMwali na? <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />Ini zwandimuleba biya? Ani zwimwali kana kulya kulopilwa kuzwimwali zwinhu na zwipo? <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />Mane, ndinova kuti mipilo inopilwa nabasinodimbwa inopilwa kumadimoni kusi kunaMwali. Andidi kuti mukamujane namadimoni. <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />Amunganwe munkombe waTezi nomunkombe wamadimoni. Amungalye muli petebuli lyaTezi akale nopetebuli lyamadimoni. <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />Tinyeteje Tezi kuti ebenefupa na? Tinesimba kuumpinda na?<verse eid="1CO 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />“Zwinhu zwose zwinovumijwa,” koga azwitoba izwo zwose zwinobhancha. “Zwinhu zwose zwinovumijwa,” koga azwitoba izwo zwose zwinobaka. <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />Kusibe nouchashaka zwinonakila iye, koga zwinonakila umbakijani uwe. <verse eid="1CO 10:24" /><verse number="25" style="v" sid="1CO 10:25" />Ilyani zwose zwinotengeswa mumusika wenyama musinobhuza chinhu pezhulu poluyeyo, <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />nokuti, “Ipasi lyose ngelyaTezi, nezwinhu zwose zwimomukati.”<verse eid="1CO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27" />Kana usinodimbwa akakukoka kunolya akale uda kunda, ulye zwose zwinobigwa mbeli kukwo, usibhuze chinhu pezhulu poluyeyo. <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />Koga umwe unhu angoti kwauli, “Yechi chakapilwa sompilo kuzwimwali,” usilye pezhulu pooyo wakubuja akale nopezhulu poluyeyo. <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />Ndoleba luyeyo lulwe, lusili lulwo.</para>
  <para style="p" vid="1CO 10:29">Ani kusungunuka kwangu kunotongelwani pezhulu poluyeyo loumwe? <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />Kana ndalya nokuboka, ndopilwani undandu nokuda kwezokulya zwandabokela?<verse eid="1CO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31" />Nezwo, kojoba ulya kana unwa, kana ini zwazwo zwaunota, ta zwose ukuja Mwali. <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />Usichinyile baJuda, baGiliki kana igubungano lyaMwali, <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />sezwandikumukweja kushantisa unhu wose nenzila jose, andijikumuzwitila kuwana, koga ndimutila banji kutila kuti bechijwe.<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1" />Ikwejejelani imi, sezwandilo kwekwejela Kristo.<verse eid="1CO 11:1" /></para>
  <para style="s">Kufuka unsholo pakunamata</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />Ndinomukuja nokuti mondikumbulukwa muzwinhu zwose akale mulondota indayijo sezwandakamulayija. <verse eid="1CO 11:2" /><verse number="3" style="v" sid="1CO 11:3" />Ndoda kuti muwhisise kuti unsholo wonhulume wose ndiKristo, unsholo wonhukaji wose unhulume, nonsholo waKristo ndiMwali. <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />Unhulume upi azwe unonamata kana kupolofita ekafuka unsholo uwe unolelupisa unsholo uwe, <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />koga unhukaji upi azwe unonamata kana kupolofita nonsholo usilofukwa unolelupisa unsholo uwe, yezwi zwinokwelana sokuti unsholo uwe uloguswa. <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />Kana unhukaji esinosunga itaulu munsholo uwe, ngekele isusu lilye, koga kana zwipisa ishoni kuti unhukaji ekelwe kana eguswe, ngesunge itaulu. <verse eid="1CO 11:6" /><verse number="7" style="v" sid="1CO 11:7" />Unhulume aatokwelela kufuka unsholo uwe, nokuti ndiye chitojaniso nolukujo lwaMwali, koga unhukaji lukujo lwonhulume. <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />Nokuti unhulume aajakabumbwa eva kunhukaji, koga unhukaji wakava kunhulume. <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />Unhulume aajakabumbilwa unhukaji, koga unhukaji wakabumbilwa unhulume. <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />Nechisoko yechi akale nokuda kwengilozi unhukaji ulokwelela kumbala itaulu munsholo uwe sechitondejelo chokuba pasi pamasimba. <verse eid="1CO 11:10" /><verse number="11" style="v" sid="1CO 11:11" />Kojoba kwakadalo, kunaTezi unhukaji aajilosungunuka kunhulume kana unhulume kunhukaji, <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />sezwo unhukaji wakabumbwa eva kunhulume, feno unhulume unozwalwa nonhukaji, asi zwinhu zwose zwinova kuna Mwali.<verse eid="1CO 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13" />Motini imwi nokwenu, zwilokwelela na kuti unhukaji enamate kunaMwali esilofuka unsholo uwe? <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />Lubumbo alutotilayija na kuti unhulume angoba namasusu malefu yezwi zwinoundeleja chimilo, <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />koga unhukaji kana elinesusu ilefu ishiyo lilye? Nokuti isusu lilye ilefu wakapilwa kuti chibe chifukiso chiche. <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />Kana unhu eli wokunyenyeja, isu kana namakubungano aMwali atitoziba umwe untilo.<verse eid="1CO 11:16" /></para>
  <para style="s">Chilayilo ChaTezi</para>
  <para style="r">(<ref loc="MAT 26:26-29">Mateo 26:26-29</ref>; <ref loc="MRK 14:22-25">Mako 14:22-25</ref>; <ref loc="LUK 22:14-20">Luka 22:14-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />Muzwilayijo zwinotobela anditomukuja, nokuti pamunoshangana amutota zwibuya koga zwinosheshemesa. <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />Nokuti chokutanga, pamunobungana segubungano, ndiwhile kuti pana kusowhanana pakati penu, yezwi ndozwidimbwa zwishomanana, <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />kunokwelela kuti kube notukapo mukati mwenu kuti kuzibikane yabo baimo muchokomende. <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />Pamunoshangana, achitoba chilyo chaTezi chamunolya. <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />Nokuti pakulya kwenu, umwe noumwe unolya madilo etangila bamwe pakulya kukwe, yezwi zwinota kuti bamwe bebenenzhala, nabamwe bekolwa. <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />Amuna jingumba na jokulyila nokunwila? Kana kuti molingila pasi igubungano lyaMwali akale nokuswabisa banoshayiwa? Nditini kwamuli? Ndimutunhumwije nezwi na? Pe anditozwita.<verse eid="1CO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23" />Nokuti zwandakatambula kuva kunaTezi zwilayijo zwandakamupa, kuti Tezi Kristo, nezhuba lyaakachetwa, wakatola chinkwa, <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />aboka, akachimedula akati, “Yoyu umbili wangu uchapilwa imwi. Itani yezwi mundikumbulukwa.” <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />Nenzila imwempela, pabakapeja chilayilo wakatola unkombe akati, “Yoyu unkombe, chivumilano chipya mulopa lyangu. Itani yezwi unshaji wose pamunonwa, mundikumbulukwe.”<verse eid="1CO 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 11:26" />Unshaji wose pamunolya chinkwa yechi nokunwa munkombe yoyu mopupula kufa kwaTezi ejine ebuye. <verse eid="1CO 11:26" /><verse number="27" style="v" sid="1CO 11:27" />Nokudalo aani nani unolya chinkwa kana kunwa munkombe waTezi esilokwelela, unandandu wokuchinyila umbili nelopa lyaTezi. <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />Nokudalo, umwe noumwe ngetange kuzwishenengula, ndipo paachalya chinkwa nokunwa munkombe. <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />Nokuti aani nani unolya nokunwa, esinowhisisa zwombili waTezi unozwinwila untongo uwe. <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />Yezwi ndizwo zwimutisa kuti banji benu bebe balodemuka akale nokulwala, bamwe bakafa. <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />Koga ngana takazwishenengula nokwedu, atijalupiwa untongo. <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />Koga kana tikatongwa naTezi, tinolangwa kutila kuti tisilashwe pamwempela nenyika.<verse eid="1CO 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33" />Nezwo banakwaina bangu, pamunoshangana pamwempela pakulya chilyo chaTezi, mililanani, <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />kana umwe wenu elinenzhala, ngeelye kunsha uwe, kutila kuti musipiwe untongo naMwali pamunoshangana. Jimwe inyaya, ndoojishinganya pandichezha.<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s">Zwipo Zwinova KuMpepo UNchena.</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />Banakwaina, ngweno penyaya yezwipo zwoMpepo, anditoda kuti mube basinoziba. <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />Munoziba kuti musanu mwadimbwa kunaMwali, zwisinani kuti mwakabasengwa chini, mwakabakalashikila kuzwimwali zwisinolebeleka. <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />Nokudalo ndoda kuti muwhisise kuti apana unhu ulotungamilwa noMpepo waMwali angati, “Jesu fhizhwa!” Akale apana angati, “Jesu ndiTezi,” kuzhe kwoMpepo uNchena.<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />Pana zwipo zwenduji jilosiyanasiyana, koga uMpepo umwempela, <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />akale pane induji jilosiyanasiyana jemishingo, koga Tezi unoshingilwa umwempela, <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />akale pana induji jilosiyanasiyana jonshingilo, koga ndiMwali umwempela unopa bose kutubula kuta yezwi zwinhu mubanhu bose. <verse eid="1CO 12:6" /><verse number="7" style="v" sid="1CO 12:7" />Umwe noumwe ulopiwa zwitondejelo zwoMpepo kutila kuti zwinakile unhu wose. <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />Kuna umwe, uMpepo unopa kulebeleka kwobuchenjevu, akale kuna umwe kulebeleka kwoluzibo zwiva kuMpepo umwempela, <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />kuna umwe, kudimbwa noMpepo umwempela, kuna umwe zwipo zwokuchilisa balwaji noMpepo wakaleyo, <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />kuna umwe unshingo wezwishamiso, kuna umwe bupolofita, akale kuna umwe kutubula kusiyanisa mipepo, kuna umwe indimi jilosiyanasiyana, kuna umwe kutolika indimi. <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />Zwose yezwi zwinonyungumulwa noMpepo umwempela chete, unokobela umwe noumwe chiche sokuda kukwe.<verse eid="1CO 12:11" /></para>
  <para style="s">Umbili Umwempela Una Imhingu Inji</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />Sezwo umbili uli umwempela koga una imhingu inji, akale jose ngijombili, kojoba jili inji, umbili umwempela, Kristo neebo uli alo. <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />Nokuti noMpepo umwempela isu tose takabhabhatizilwa mumbili umwempela, baJuda kana baGiliki, balanda kana balosupunuka, akale tose takanwiswa wakaleyo uMpepo umwempela. <verse eid="1CO 12:13" /><verse number="14" style="v" sid="1CO 12:14" />Nokuti umbili autoba imhingu imwempela, koga inji. <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />Kana igumbo lingoti, “Nokuti anditoba luboko, anditoba imhingu yombili,” yezwi azwingate kuti lisibe imhingu yombili. <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />Akale kana inzebe ingoti, “Nokuti anditoba izhisho, anditoba imhingu yombili,” yezwi azwitota kuti isibe imhingu yombili. <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />Ngana umbili wose uli izhisho, kuwha kwaluba poni? Umbili wose ngana ulinzebe kunhuwija kwaluba poni? <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />Koga sezwazwili, Mwali wakabiga mumbili imhingu jilosiyanasiyana, imwe neimwe sokulonga kukwe. <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />Ngana imhingu jose jili imhingu imwempela, ngana umbili uli kupi? <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />Sezwazwili kuna imhingu inji asi umbili umwempela. <verse eid="1CO 12:20" /><verse number="21" style="v" sid="1CO 12:21" />Izhisho alingati kuluboko, “Iwi imi anditokushaka,” kana akale unsholo uti kumakumbo, “Imwi imi anditomushaka.” <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />Koga, yejo imhingu jombili, jinoboneka jilinobutela, jilokosha, <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />akale imhingu jombili jisinokujika, tojikuja kasa, yejo imhingu jinopisa ishoni tojifuka nolulemeso, <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />zwisinodikana nemhingu jedu jinoyebeka. Koga Mwali wakabumba imhingu jilosiyanasiyana kuba umbili umwempela, epa lulemekejo lukulwana kumhingu jinoshundwa, <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />kutila kuti kusibe nokusowhisisana mumbili, koga kuti imhingu jilondotane. <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />Kana imhingu imwempela ingolwala, jose jinolwalabo, kana imhingu imwempela ingokujwa, jose jinoshantila pamwempela. <verse eid="1CO 12:26" /><verse number="27" style="v" sid="1CO 12:27" />Ngweno imwi mumbili waKristo akale umwe noumwe imhingu yawo ilosiyana yawo. <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" />Akale Mwali wakagaja mugubungano kutanga, bapositoli, chabili bapolofeti, chatatu balayiji, kukatobela bashingi banota zwichenamiso, kukatobela zwipo zwokuchilisa, babhanchi, bakwendesi bamakubungano, nabanolebeleka indimi jilosiyanasiyana. <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />Bose bapositoli na? Bose bapolofeti na? Bose balayiji na? Bose banota zwichenamiso na? <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />Bose bana zwipo zwokuchilisa na? Bose banolebeleka nendimi na? Bose bangatoloka indimi na? <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />Asi imwi mukwemuja zwipo zwilokosha kasa.</para>
  <para style="p" vid="1CO 12:31">Akale ngweno ndomutondeja inzila imbuyanana kasa.<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s">Ludo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />Kana ndilebeleka nendimi jabanhu nejejingilozi, koga ndisina ludo, ndinsimbi yezhoba kana isangusangu limungengeja. <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" />Akale kana ndikaba nechipo chokupolofita, akale ndiwhisisa isiswa lyose noluzibo lwose, akale kana ndikaba nokudimbwa kwose kunonyamula matunhu, koga kana ndisina ludo anditoba chinhu. <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />Kojoba ndingokobela basheti, zwose zwandinanazwo, kana ndikapila umbili wangu kuti upiswe, koga ndisina ludo, apana chandichawana.<verse eid="1CO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4" />Ludo lunamoyondefu akale neshe, ludo aluna ifupa, kuzwifufumula kana kuzwida. <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />kana kusonya. Ludo alutoshaka zwalwo unshajiwose, alutonyetela kana kubwilizila, <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />alutoshantila zwisakalulama, koga lunoshantiswa nechokomende. <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />Ludo lunotambula zwinhu zwose, lunodimbwa zwinhu zwose, lunobimba zwinhu zwose, lunosungwala pazwinhu zwose. <verse eid="1CO 13:7" /><verse number="8" style="v" sid="1CO 13:8" />Ludo alutojiba, koga zwobupolofita zwinoopela, zwendimi zwinopela, luzibo lunoopinda. <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />Nokuti luzibo lwedu lushoma akale kupolofita kwedu akulopelelela, <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />koga zwilopelelela zwingoswika, yezwo zwisilopelelela zwinoopinda.<verse eid="1CO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11" />Ndichi uncheche ndakabelebeleka soncheche, ndiyeya soncheche, ndilangalila soncheche, pandakaba unhu unkulwana ndakasiya inzila jobucheche. <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />Kwangweno atijimubona zwibuyanana muchiboniboni, koga noyo nshaji tinoobona pechiso nechiso. Ngweno ndoziba chikamu, yopo ndoowhisisa zwizhele, sobundichawhisiswa bo zwizhele.<verse eid="1CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13" />Yezwi zwitatu zwinogala zwilipo, kudimbwa, lubimbo, noludo, koga chikulwana panezwi ludo.<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s">Zwinji pezhulu Pezwipo ZwoMpepo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />Itani kuti ludo lube chinangwa chenu, akale kwemujani kasa zwipo zwoMpepo, kasakasa chipo chokupolofita. <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />Nokuti yoyo unolebeleka nendimi aatolebeleka kubanhu koga kuna Mwali, nokuti apana unounwhisisa, koga unolebeleka isiswa muMpepo. <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />Koga, yoyo unopolofita unolebeleka kubanhu mawhi okubabaka ebasungwaja, nokubanyalaja. <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />Yoyo unolebeleka nendimi unozwibaka iye emene, koga yoyo unopolofita unobaka igubungano.<verse eid="1CO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5" />Ngweno ndoda kuti mwose mulebeleke nendimi, kasa kasa kupolofita. Yoyo unopolofita unkulwana kupinda yoyo unolebeleka nendimi, kuzhe kwokuti umwe etoloke, kutila kuti igubungano libakike. <verse eid="1CO 14:5" /><verse number="6" style="v" sid="1CO 14:6" />Banakwaina, ndingoswika kwamuli ndilebeleka nendimi, ndomubhancha neni, kuzhe kwokuti ndimubuje zwitondejelo kana luzibo kana kupolofita kana indayijo?<verse eid="1CO 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 14:7" />Kana zwilijwa zwisina bupenyu zwinanga untetele kana kadende, zwisinobhisila pachena maando alokwejemuka, unhu angaziba chini kuti ini chimulijwa? <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />Akale kana lukwembo lungolila zwisilozibilika, ndiani uchazwibambanyila kulwana ihondo? <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />Zwili alo kwamuli, kana mulebeleka mawhi asinowhikana, biya bamwe bangawha chini zwamunoleba? Nokuti mooba mulebeleka mumpepo chete. <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />Muna indimi inji pasi lyose, asi apana lulimi lusina chalunoleba, <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />koga kana ndisinoluziba lulimi, ndoba umvakule kundebeleki akale undebeleki unoba umvakule kwandili. <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />Zwili alo nokunamwi, sezwo imwi nokwenu mudisisa zwipo zwoMpepo, shakisisani yezwo zwichabaka igubungano.<verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />Nokudalo, yoyo unolebeleka nendimi unokwelela kunamatila isimba lyokutoloka. <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />Nokuti kana ndinamata nendimi, umpepo wangu unonamata koga indangalilo yangu aina unchelo. <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />Nditechini imi? Ndichanamata nompepo akale ndichanamata nendangalilo. Ndichakwimbabo nompepo akale ndichakwimba nendangalilo. <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />Kana zwisakadalo, kana iwi uboka noMpepo, umwe usili iwi angati, “Ameni” chini kukuboka kuko esinoziba kuti ukumutini? <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />Iwi ungaboka zwibuyanana kasa, koga umwe unhu aatoba asima.<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />Ndinoboka Mwali nokuti imi ndinolebeleka nendimi kupinda imwi mwose, <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />kojoba kwakadalo, mugubungano ndingada kulebeleka mawhi mashanu anowhisiswa nabanhu, kutila kuti ndilayije bamwe, kuna kuti ndilebeleke mawhi zwiulu zwiligumi nendimi jisinowhisisika.<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />Banakwaina, musibe bana batukutuku muluyeyo lwenu, muzwibi ibani sabacheche, asi muluyeyo mukubuke. <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />Mumulawo kulokwalwa kuwhi,</para>
  <para style="q1" vid="1CO 14:21">“Tezi unoti, ndoolebeleka nabanhu yaba</para>
  <para style="q2" vid="1CO 14:21">ndishingisa banhu banolebeleka indimi jobwezi,</para>
  <para style="q1" vid="1CO 14:21">akale nemyemyeto yabavakule.</para>
  <para style="q2" vid="1CO 14:21">Kojoba kwakadalo abatoondiwhilila.”<verse eid="1CO 14:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="1CO 14:22" />Nezwo, indimi ajitoba chitondejelo kuna yabo balodimbwa koga ngechabasilodimbwa, asi kupolofita akutoba kwabasinodimbwa koga badimbwi.<verse eid="1CO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23" />Nokudalo, kana igubungano lyabungana lyose, kova bose belebeleka nendimi jisinowhisisika, kungongwina basilolayijwa kana basinodimbwa, abatoleba na kuti mopenga? <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />Koga kana mose mukapolofita, kova kungwina usinodimbwa kana usilolayijwa, unoboneswa bubi bubwe nabose, akatongwa naibo, <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />isiswa limo mumwoyo mumwe linofumulwa, akale unotibhama ekuja Mwali nokushomeja eti, “Mwali nechokomende umomwamuli.”<verse eid="1CO 14:25" /></para>
  <para style="s">Kuzikatila Mugubungano</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />Ani biya, ini banakwaina? Kana mwabungana, umwe nomwe unalwimbo, kana chilayijo, kana chitondejelo, kana kulebeleka nendimi, kana kutoloka. Zwinhu zwose ngazwitilwe kubakana. <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />Kana umwe elebeleka nendimi ngakube babili kana batatu chete, belabajana akale umwe etoleka. <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />Kana pesina unotoloka, unhu yoyo ngenyalale mugubungano akale ezwilebelekele ega nokunaMwali. <verse eid="1CO 14:28" /><verse number="29" style="v" sid="1CO 14:29" />Lekejani bapolofeti babili kana batatu belebeleke, bamwe belingisise zwalebwa. <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />Kana chitondejelo chabhisilwa pachena kunoumwe ugele pelyo, wabelebeleka ngenyalale umwe elebeleke. <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />Nokuti mose mungapolofita umwe nomwe, kutila kuti bose belayijwe akale besungwajwe. <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />Akale mipepo yabapolofeti ipopasi pabapolofeti, <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />nokuti Mwali aatoba Mwali wenyonganyonga, koga wolunyalalo.</para>
  <para style="p" vid="1CO 14:33">Sezwazwili mumakubungano ose abachena, <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />banhukaji ngebewhilijile mumakubungano. Nokuti abajilovumilwa kulebeleka, koga ngebezwideleje sezwinolebwa nomulawo. <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />Kana peli nechibanoshaka kuziba ngebebhuze balume babo kungumba. Nokuti zwinopisa ishoni kuti unhukaji elebeleke mugubungano.<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />Iwhi lyaMwali lyakatanga namwi, kana lyakaswika kwamuli mwoga na? <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />Kana pelinounoyeya kuti umpolofeti, kana kuti ndiwozwompepo, unokwelela kuti ezwitambule kuti zwandinomukwalila kulaya kwaTezi. <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />Kana pelina usinozwitambula yezwi, naiye neebo aatotambulwa. <verse eid="1CO 14:38" /><verse number="39" style="v" sid="1CO 14:39" />Nokudalo banakwaina bangu, ibani nechido chokupolofita, akale musilambije kulebeleka nendimi, <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />asi zwose zwinhu ngazwitiwe zwibuyanana kutobelwa inzila inokwelela.<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s">Kumuka KwaKristo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />Ngweno, ndoda kumukumbuluja banakwaina, inzila yandakamubhaunulila iNdebo iMbuya, yeyo imwakatambula akale imumile paili, <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />iyo ichamuchija kana mubhatilila kundebo yandakamubhaunulila, kuzhe kwokuti kudimbwa kwenu kwakakusi kwechokomende.<verse eid="1CO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3" />Zwandakatambula zwilokosha ndizwo zwandakamupa, zwokuti Kristo wakafila luchinyo lwedu, sobuzwili mumakwalo, <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" />kuti wakajikwa, akamuswa nezhuba lyatatu sokuleba kwaMakwalo Machena, <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" />akale kuti wakazwitondejela kunaKefasi, akale kubalayijwa babe baligumi nababili. <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />Wakaboneka kubanakwaina banopinda mazana mashanu panshaji umwempela, banji babo bachibapenyu, kojoba bamwe babo bakanyetutukwa. <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />Wakabonwa naJemusi, nokubapositoli bose.<verse eid="1CO 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 15:8" />Kumapejelejo wakazwitondejela kwandili, imi ndili sonhu wokuzwalwa unshaji usanu wakwana, akale wakaboneka kunami. <verse eid="1CO 15:8" /><verse number="9" style="v" sid="1CO 15:9" />Nokuti imi ndili untukutuku kubapositoli bose, ndisilokwelela kuwhi ndimpositoli nokuti ndakayabisa igubungano lyaMwali. <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />Koga nechipiwo chaMwali ndili yezwo zwandili, akale chipiwo chiche kwandili achijakaba chisina unshingo. Kojoba zwakadalo, ndakashinga kupinda ibo bose, kusili imi asi chili chipiwo chaMwali chimo mwandili. <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />Kungaba kuwhi kwakabeli imi kana ibo, ndizwo zwatinobhaunula akale imwi ndizwo zwamwakadimbwa.<verse eid="1CO 15:11" /></para>
  <para style="s">Kumuka Kwedu</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />Ngweno kana Kristo ebhaunulwa kuwhi wakamuswa kuna bakafa, bamwe benu bangaleba chini kuti apana kumuka kuna bakafa? <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />Koga kana pesina kumuka kubafi, zwinova kuti naiye Kristo aajakamuswa, <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />kana Kristo esakamuswa, zwinova kuti kubhaunula kwedu akunanshingo akale nokudimbwa kwenu akunanshingo bo. <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />Isu towanika tida kupita Mwali, nokuti takasumikija kuti Mwali wakomusa Kristo, waasakamusa kana chili chokomende kuti bakafa abatomuswa. <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />Kana bakafa besinomuswa, ndiko kuti Kristo aajakamuswa. <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />Kana Kristo esakamuswa, kudimbwa kwenu mayabwe, akale muchimo muluchinyo lwenu. <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />Nezwo bose yabo bakafa beli munaKristo, bakapalala. <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />Kana lubimbo lwedu muna Kristo lulibubuya kubupenyu chetechete, nokudalo tokwelela kuwhilwa ishe kupinda bose munyika. <verse eid="1CO 15:19" /><verse number="20" style="v" sid="1CO 15:20" />Koga ilebeswa ngelyokuti Kristo wakamuswa kubafi, ndiye unchelo wokutanga kunaabo bakafa. <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />Sezwo lufu lwakabuzwa nonhu, nokumuka kubafi kwakabuzwa nonhu bo. <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />Sezwabanofa bose munaAdamu, nokudalo munaKristo banooba bapenyu bose. <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />Koga umwe nomwe nenzila yiye, Kristo unchelo wokutanga, kova pakuzha kukwe yabo baiko kunaKristo. <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />Ndipo pachaswika umpejelejo, paachasenga bushe kunaMwali Tate mushule mwokupalaja bushe bwose, nobutongi bose akale namasimba ose. <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />Nokuti iye unokwelela kutonga ejine ebige bose babengi babe pasi pamakumbo awe. <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />Umbengi wopejeleja uchapalajwa, lufu. <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />Lukwalo luchena lunoti, “Mwali wakabiga zwinhu zwose pasi pamakumbo awe.” Koga kana kuwhi, “Zwinhu zwose zwilobigwa pasi pape,” zwipopachena kuti azwitoshanganisila Mwali nokukwe, wakabiga zwinhu zwose pasi paKristo. <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />Kana zwose zwinhu zwichabigwa pasi pape, ndipo pakuchabigwa iye Mwananhulumyana pasi paiye, iye wakabiga zwose zwinhu pasi pape, kutila kuti Mwali ebe zwinhu zwose kubanhu bose. <verse eid="1CO 15:28" /><verse number="29" style="v" sid="1CO 15:29" />Biya banotini banhu nokubhabhatizwa bekamilila bakafa? Kana bakafa besinomuswa zwachose, ini bebhabhatizwa bekabamilila? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />Ini tigala tilimumakubaji unshaji wose, <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />banakwaina ndilolingana nolufu izhuba nezhuba? Yezwi ichokomende, sokushiya kwangu munamwi kwandinanako muna Kristo Jesu Tezi wedu, <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />Ini chandinowana kana ndakalwana nemhuka kuEfesasi nezwinangwa zwabanhu? Kana bakafa besinomuswa, “Ngatilyeni akale tinwe, nokuti mangwana tofa.”<verse eid="1CO 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33" />Musichengwe, “Kukwenda nababi kunopalaja chimilo chibuya.” <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />Bwililani kundangalilo jenu imbuya, musoochinye. Nokuti bamwe abana luzibo lwaMwali. Ndikumuleba yezwi kuti mube neshoni.<verse eid="1CO 15:34" /></para>
  <para style="s">Umbili Wokumuswa</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />Koga umwe unobhuza eti, “Bakafa banomuswa chini? Banozha beli nombili wakata chini?” <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />Iwi ilema lyonhu! Chaunobyala achitomela kuzhe kokuti chitange chafa. <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />Akale zwaunobyala azwitoba iwo umbili uchooba ipo, koga unobyala imbeyu yekoloni kana imwe imbeyu. <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />Koga Mwali unoyipa umbili sokushala kukwe, akale imwe, neyimwe imbeyu unoyipa umbili wayo.<verse eid="1CO 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 15:39" />Nokuti mibili yose ayijilotojana, asi kuna imwe yabanhu, neyimwe yemhuka, neyimwe yenyuni, akale neyimwe yehobe.<verse eid="1CO 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40" />Kuna mibili yokudenga, nemibili yopenyika, asi kungaima kweyokudenga kumwe, akale nokungaima kweyomunyika kumwe bo. <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />Kuna kungaima kwezhuba, nokumwe kungaima kwomweji, akale nokumwe kungaima kwenyenyeji, nokuti imwe neimwe inyenyeji inongaima zwilosiyana.<verse eid="1CO 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42" />Kwakadalo bo kumuka kwabakafa. Umbili unojikwa unobola, unomuswa autobola. <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />Unojikwa zwisilolemekejwa, umuswa mulukujo. unojikwa mubutela, unomuswa mumasimba. <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />Unojikwa uli umbili wenyama, umuswa uli umbili wompepo. Kana pelinombili wenyama, pana bo nombili wompepo. <verse eid="1CO 15:44" /><verse number="45" style="v" sid="1CO 15:45" />Nokudalo zwilokwalwa kuti, “Unhu wotanga Adamu wakaba unhu umpenyu,” Adamu wokupejeleja wakaba umpepo unopa bupenyu. <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />Achitoba chompepo chinotanga, asi ngechombili, kova kutobela chompepo. <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />Unhu wotanga wehuluba wakava munyika, unhu wabili unova kudenga. <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />Sezwaakaba eli unhu wehuluba, ndibo bubali behuluba, akale sobwaali unhu wokudenga, ndibo bubali bo bokudenga. <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />Sezwo tili nechimo chonhu wehuluba, tooba akale nechimo chonhu wokudenga.<verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />Ndomubuja yezwi banakwaina, kuti inyama nelopa azwingawane ifuma yobushe bwaMwali, Nezwino palala azwingalye ifuma isinopalala.<verse eid="1CO 15:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="1CO 15:51" />Whililani! Ndimubuje isiswa. Tose atitoofa, asi tose tooshandulwa, <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />munshaji unshomanana, sokubhwinya kwezhisho, mulukwembo lwopejeleja. Lukwembo paluchoolila, bakafa banoomuswa besichinopalala, akale isu tooshandulwa. <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />Nokuti umbili unopalala unokwelela kumbala umbili usinopalala, akale noyu umbili unofa unokwelela kumbala umbili usinofa.<verse eid="1CO 15:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="1CO 15:54" />Kana umbili unopalala wambala usinopalala, nounofa wambala usisofa, ndipo pachazhajikijwa isumo ilokwalwa kuti, “Lufu lunominywa mukuzunda.”</para>
  <para style="q1" vid="1CO 15:54">“Awe! Lufu kukoma kuko kupo poni?</para>
  <para style="q1" vid="1CO 15:54">Awe! Lufu, lubola lulo lupo poni?<verse eid="1CO 15:54" /></para>
  <para style="m">
    <verse number="56" style="v" sid="1CO 15:56" />Lubola lwolufu luchinyo, nesimba lyoluchinyo mulawo. <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />Koga toboka Mwali, unotipa kukoma nomuna Tezi wedu Jesu Kristo.<verse eid="1CO 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58" />Nokudalo, banakwaina bangu banodikana, imani mukasima, musisundwe nechinhu, unshaji wose mushingila Tezi, muziba kuti kushinga kwenu munaTezi akutoba kwamayabwe.<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s">Umpilo Wabadimbwi Banoshayiwa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />Ngweno pezhulu penyaya yonsupo wabachena, sezwandakaleba kumakubungano okuGalatiya, kuti namwibo mute alo. <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />Nezhuba lyotanga lyeviki jose, umwe noumwe wenu ngeebige zwimwe kumbali elondote sokuwana kukwe. Kutila kuti zwisitange kubunganiswa pandichaswika. <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />Akale kana ndaswika, ndootuma yabo bamwakashala, newhalo kuti besenge zwipo zwenu kuJelusalema. <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />Kana zwooboneka zwili zwibuya kuti namibo ndindebo, banoondipelekeja.<verse eid="1CO 16:4" /></para>
  <para style="s">Bulongwa BwaPaulu</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />Ndoomushanyila pandichapinda nomuMasedoniya, nokuti ndilonanga kupinda nomuMasedoniya, <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />posa ndingava ndagala namwi, kana kupeja unshaji wemhepo, kutila kuti mundibhanche kwandinobenda. <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />Nokuti andidi kumubona ngweno ndipinda chete, ndinalubimbo lwokupeja unshaji ndefu ndilinamwi, kana Tezi beda.<verse eid="1CO 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8" />Koga ndogala kuEfesu kuswikila iPentekositi, <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />nokuti unkoba ulokwazabuka wokushinga zwanana wazhulwa kwandili, akale babengi banji.<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />Paachezha Timoti mubone kuti unogala namwi esinalutyo, nokuti ukumuta unshingo waTezi sami. <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />Nokudalo kusibe nounonshunda, koga umpindijeni mulunyalalo mulwendo lulwe, kuti ebuye kwandili, nokuti ndilondingilila pamwempela nabanakwaina.<verse eid="1CO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12" />Pamwanakwaina wedu Apolosi, ndakonsungwaja nesimba kuti emushanyile nabamwe nabanakwaina, asi achijakabeli chido chiche kuzha ngweno. Unoozha paachawana unshaji.<verse eid="1CO 16:12" /></para>
  <para style="s">Mawhi Okupejeleja</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />Galani mwakabhwazula, simani mukudimbwa kwenu, ibani nomwoyo, simani. <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />Zwose zwamunota, muzwite muludo.<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />Ngweno, banakwaina, moziba kuti imhuli yaSitefanasi ndiyo yakatanga kushanduka kudunhu igulwana lyokuAkeya, akale balozwipila kubhata unshingo wabachena. Banakwaina, ndomusungwaja, <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />kuti muwhilile banhu bakadai akale nokunabo banoshinga nesimba. <verse eid="1CO 16:16" /><verse number="17" style="v" sid="1CO 16:17" />Ndashantilwa nokuzha kwaSitefanasi naFochunatusi naAkaikusi nokuti batipa zwatabeshayiwa nokusobaipo kwenu. <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />Bamusilija umpepo wangu nowenu. Balemekejeni banhu bakadayi.<verse eid="1CO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />Makubungano okuEzhiya akumumusa. Akwila naPulisika pamwempela negubungano limomungumba yabo bakumumusa kasa munaTezi. <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />Bose banakwaina bakumumusa.</para>
  <para style="p" vid="1CO 16:20">Mumusane nokumusana kobwanakwaina kuchena.<verse eid="1CO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />Imi Paulu, ndakwala noluboko lwangu, ndimumusa.<verse eid="1CO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22" />Kana unhu esinoda Tezi ngaabe ulofhizhwa.</para>
  <para style="p" vid="1CO 16:22">Izhani Tezi wedu!<verse eid="1CO 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23" />Chipiwo chaTezi Jesu ngachibe namwi! <verse eid="1CO 16:23" /><verse number="24" style="v" sid="1CO 16:24" />Ludo lwangu lube namwi mose munaKristo Jesu. Ameni.<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>