<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LUK" style="id">- NAMBYA TRANSLATION PROJECT</book>
  <para style="h">Luka</para>
  <para style="toc1">Indebo Imbuya yakakwalwa naLuka</para>
  <para style="toc2">Luka</para>
  <para style="toc3">Luk</para>
  <para style="mt2">Indebo Imbuya yakakwalwa</para>
  <para style="mt1">naLuka</para>
  <para style="imt">Matangisilo</para>
  <para style="ip">Indebo imbuya yaLuka imwe yewhalo ina jimo muChivumilano Chipya jinoleba nezwobupenyu bwa Jesu Kristo. Yeji iwhalo jose jinoshobwa jiwhi “Ivangeli”, zwiva kuti, “Indebo Imbuya.” Jakakwalwa mushule molufu lwaJesu naMateo, Mako, Luka naJoni. Luka aajakakwala nezwa Jesu chete, koga akale nezwakatiwa nabalayijwa babe mushule molufu nokumuka kukwe. Apana unoziba kuti iwhalo yaLuka yakakwalwa lini kana kuti kupi, koga banji bobumhizha bwewhalo jeBhayibhili banoti ingaba yakakwalwa kumakole makumi mana, anamakumi mabili Jesu azwalwa. Unkwali ndiLuka akale wakabeli uNdapi. Unkwalilo nolulimi lwaanoshingisa lunotondeja kuti wakabeli nendayijo yopezhulu. Luka wakabeda kuti kukwalwe inwolohondo yaJesu yomene yobupenyu bwaJesu eleba zwitiko sezwakatikana, kutila kuti banoyibala bebe nokubhanchikana (Luka 1:1-3). Aajakabeli unJuda (baKolose 4:10-14) akale wakakwala nenzila inota kuti basi baJuda bebe nokuwhisisisa. Yezwi zwinoboneka nenzila yaanopandulula zwamagalilo abaJuda (Luka 1:8).</para>
  <para style="ip">INdebo iMbuya yakakwalwa naLuka ilotojana newhalo yaMateo neyaMako nokuti jinolondejela zwinhu zwinokwendelana nenzila ilotojana. Pakati pewhalo inhatu yeji, yaLuka ndiyo inopandulula zwizhele nezwokuzwalwa kwaJoni umbhabhatizi. Luka akale unosimisa kulekejela (Luka 3:3, 11:4, 17:3-4, 23:34, 24:47) nokunamata (Luka 3:21, 5:16, 6:12, 11:1-12, 22:32).</para>
  <para style="iot">Zwilomumwa</para>
  <para style="io1">Muna Luka 1:1-4, Luka unopa chingwiniso cheNdebo iMbuya yiye esikopandulula chinangwa chiche chokuikwala.</para>
  <para style="io1">Esikoleba nezwokufa kwaJesu akale nokuti ulozwimisila chini kuta bushingili (Luka 1:5—4:13).</para>
  <para style="io1">Chikamu chikulwana chendebo iMbuya yiye (Luka 4:14—21:38), Luka unolebeleka nezwemishingo yakatiwa naJesu, kasakasa zwishamiso zwaakata nezwinhu zwaakalayija.</para>
  <para style="io1">Muzwikamu zwopejeleja zwitatu (Luka 22:1—24:53), unotondeja kuti Jesu wakafa, akajikwa akale kuti wakamuka chini kubafi.</para>
  <chapter number="1" style="c" sid="LUK 1" />
  <para style="s">Matangisilo</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1" />Kunawi Tiyofilasi.</para>
  <para style="p" vid="LUK 1:1">Kojoba banhu banji bakaba batabo unshingo wokukwala iNdebo iMbuya belungulula iNdebo iMbuya jozwunhu zwakatikana pakati pedu. <verse eid="LUK 1:1" /><verse number="2" style="v" sid="LUK 1:2" />Sezwatakatambula kunaabo bakaba beli basumikiji bakazwibona pakutanga, akale beli ibo bakwendesi bewhi, <verse eid="LUK 1:2" /><verse number="3" style="v" sid="LUK 1:3" />zwakaboneka zwili zwibuya kwandili, ndakazwishakisisa zwose zwinhu, kuva kumatangisilo, kuti ndikukwalile zwitobekejana, iwi unokujwa Tiyofilasi, <verse eid="LUK 1:3" /><verse number="4" style="v" sid="LUK 1:4" />kutila kuti uzibe ichokomende nezwo zwinhu zwiwakalayijwa.<verse eid="LUK 1:4" /></para>
  <para style="s">Kusumwa kokuzwalwa kwaJoni umbhabhatizi.</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5" />Mumazhuba aShe Helodi wokuJudiya kwakaba kuli nontebuji, waluwhi Zakaliya izina lilye, eli wengumba yaAbhija, unkaji uwe neebo wakabezwalwa kubana bechinhukajana baAloni, izina lilye ewhi ndiElizabeti. <verse eid="LUK 1:5" /><verse number="6" style="v" sid="LUK 1:6" />Bakaba bekalulama bubili bwabo pambeli paMwali, belondota yose milawo nezwisungo zwaShe besina chibi. <verse eid="LUK 1:6" /><verse number="7" style="v" sid="LUK 1:7" />Asi abajakabeli nomwana, nokuti Elizabeti aajakabebhata imimba, bose bakaba bakwegula.<verse eid="LUK 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8" />Kwakati kuli igwi lyechipani chiche chokubhata unshingo wobutebuji kuna Mwali, <verse eid="LUK 1:8" /><verse number="9" style="v" sid="LUK 1:9" />sontilo wobutebuji, imfumbefumbe yakawila kuna iye, kuti ebe unongwina muTempeli lyaShe kunofhungaija imfhungaijo. <verse eid="LUK 1:9" /><verse number="10" style="v" sid="LUK 1:10" />Ibunga lyose lyabanhu lyakabenamata pazhe nonshaji weawa yompilo wefhungaijo. <verse eid="LUK 1:10" /><verse number="11" style="v" sid="LUK 1:11" />Ingilozi yaShe yakaboneka kwaali kubhazu lyechokululyi kwedebulilo lyefhungaijo. <verse eid="LUK 1:11" /><verse number="12" style="v" sid="LUK 1:12" />Paakaibona, Zakaliya wakashushikana, akakatamuka. <verse eid="LUK 1:12" /><verse number="13" style="v" sid="LUK 1:13" />Asi ingilozi yakati kwaali, “Usitye, Zakaliya, nokuti unamato uwo wawhikana, nokudalo unkaji uwo Elizabeti unookuzwalila mwananhulumyana, akale undundike izina kuti ndiJoni. <verse eid="LUK 1:13" /><verse number="14" style="v" sid="LUK 1:14" />Unooba nolushanto nokunakilwa akale banji, banooshantilwa nokuzwalwa kukwe; <verse eid="LUK 1:14" /><verse number="15" style="v" sid="LUK 1:15" />nokuti unooba unkulwana mumesho aShe, aatobenwa iwaini nezwinwiwa zwinokola, unoozhajwa noMpepo uNchena echimuntumbu wamai babe. <verse eid="LUK 1:15" /><verse number="16" style="v" sid="LUK 1:16" />Unoobachingunulila kunaShe Mwali wabo bana baIzilayeli banji, <verse eid="LUK 1:16" /><verse number="17" style="v" sid="LUK 1:17" />unoonda mbeli kukwe nompepo nesimba lyaElija, mukuchingunula myoyo yamatate kubana babo, nabasinowhilila banoobuzwa, kumaano nokuwhilila muzwinokwelela kubambilwa She.”<verse eid="LUK 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18" />Zakaliya wakati kungilozi, “Ndinozwiziba chini yezwi? Nokuti imi ndakwegula, nonkaji wangu makole awanda.”<verse eid="LUK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19" />Ingilozi yakonshandula ikati, “Ndimi Gabhuliyeli, ndinoma mbeli kwaMwali, ndatumwa kuti ndooleba kwauli mawhi mabuya yaya. <verse eid="LUK 1:19" /><verse number="20" style="v" sid="LUK 1:20" />Iwha unooba chimumu akale ukonwe kulebeleka, kujine kwoswika yelyo izhuba pazwichatikana yezwi, zwitiswa nokuti aujadimbwa mawhi angu koga yezwi zwinoozhajikijwa nonsi wazwo.”<verse eid="LUK 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21" />Banhu bakabakondindila Zakaliya, bakachenamiswa nokujilwa kukwe muTempeli. <verse eid="LUK 1:21" /><verse number="22" style="v" sid="LUK 1:22" />Paakati abhuda, wakakonwa kulebeleka nabo, bakaziba kuti wabona chibono muTempeli, wakashingisa maboko kulebeleka, akagala elichimumu.<verse eid="LUK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23" />Kwakati kwapela mazhuba egwi lilye lyokutebula, wakenda kungumba yiye. <verse eid="LUK 1:23" /><verse number="24" style="v" sid="LUK 1:24" />Mushule mwamazhuba yaya, unkaji uwe Elizabeti wakabhata imimba, koga akazwisisa kwemyeji mishanu, eti, <verse eid="LUK 1:24" /><verse number="25" style="v" sid="LUK 1:25" />“She wata ali kwandili mumazhuba aandilinga nawo, wata ali kutila kupeja kusekwa kwangu mukati mwabanhu.”<verse eid="LUK 1:25" /></para>
  <para style="s">Kusuma kwokuzwalwa kwaJesu</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26" />Nomweji washanu nomwempela ingilozi Gabhuliyeli yakatumwa naMwali kuGalili muguta linowhi Nazaleta, <verse eid="LUK 1:26" /><verse number="27" style="v" sid="LUK 1:27" />kumhandala yakaba yahwayiwa nonzhuzha unowhi Josefa, wengumba yaDavidi, izina lyemhandala iwhi Mariya. <verse eid="LUK 1:27" /><verse number="28" style="v" sid="LUK 1:28" />Akale yakezha kwaali ikati, “Shanta iwi ulodikana! She una nawi.”<verse eid="LUK 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29" />Koga wakaba nolutyo lukulwana newhi yeli, akayeya kuti kumusa kuli chini yoku. <verse eid="LUK 1:29" /><verse number="30" style="v" sid="LUK 1:30" />Ingilozi yakati kwaali, “Usitye Mariya, nokuti wawana ishe kunaMwali. <verse eid="LUK 1:30" /><verse number="31" style="v" sid="LUK 1:31" />Jowha, unooba nemimba, unoozwala mwananhulumyana wauchoopa izina kuti ndiJesu. <verse eid="LUK 1:31" /><verse number="32" style="v" sid="LUK 1:32" />Iye unooba unkulwana, akale unooshobwa ewhi Mwananhulumyana wooyo wopeZhuluzhulu, She Mwali unoumpa chigalo chobushe chatate babe Davidi, <verse eid="LUK 1:32" /><verse number="33" style="v" sid="LUK 1:33" />akale unootonga ingumba yaJakobe nokusinopela, nobushe bubwe bunooba ipo kusinopela.”<verse eid="LUK 1:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34" />Mariya wakati kungilozi, “Zwinotikana chini yezwi, nokuti andina undume?”<verse eid="LUK 1:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35" />Ingilozi yaMwali yakati kwaali, “UMpepo uNchena unoozha pezhulu papo, akale isimba lyoupo pezhulu kasa linokufukatija, nokudalo mwana uchoochilwa unowhi uNchena, Mwananhulumyana waMwali. <verse eid="LUK 1:35" /><verse number="36" style="v" sid="LUK 1:36" />Iwha igamu lilyo Elizabeti, wakwegula, naiye wakabhata imimba yomwananhulumyana, yaba nemyeji mishanu nomwempela, iye wakaba ewhi aana inzwalo. <verse eid="LUK 1:36" /><verse number="37" style="v" sid="LUK 1:37" />Nokuti kunaMwali apana chinokona.”<verse eid="LUK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38" />Mariya wakati, “Linga imi ndindandakaji waShe, ngazwibe kwandili sokuleba kuko.” Ingilozi yakabhuda ikenda.<verse eid="LUK 1:38" /></para>
  <para style="s">Mariya unoshanyila Elizabeti</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39" />Mumazhuba yayo, Mariya wakanyamuka, akenda kunyika yamatunhu ekambija enda muguta limo muJudiya, <verse eid="LUK 1:39" /><verse number="40" style="v" sid="LUK 1:40" />akanongwina mungumba yaZakaliya, akamusa Elizabeti. <verse eid="LUK 1:40" /><verse number="41" style="v" sid="LUK 1:41" />Elizabeti wakati awha kumusa kwaMariya, mwana wakatumuka muntumbu mumwe, ndipo Elizabeti wakazhala noMpepo uNchena, <verse eid="LUK 1:41" /><verse number="42" style="v" sid="LUK 1:42" />akashomeja newhi lyopezhulu eti, “Ulokombolelwa pakati pabanhukaji bose, ulokombolelwa unchelo wemimba yiyo! <verse eid="LUK 1:42" /><verse number="43" style="v" sid="LUK 1:43" />Ani kwaba chini kuti amai baShe wangu bezhe kunami? <verse eid="LUK 1:43" /><verse number="44" style="v" sid="LUK 1:44" />Ilinga, palyangowhika munzebe iwhi lilyo undimusa, mwana watumuka muntumbu mwangu nolushanto. <verse eid="LUK 1:44" /><verse number="45" style="v" sid="LUK 1:45" />Ulokombolelwa iye unodimbwa nokuti, kunooba nokuzhajikijwa kuna zwakalebwa naShe.”<verse eid="LUK 1:45" /></para>
  <para style="s">Lwimbo lwaMariya lwokukuma</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46" />Mariya wakati,</para>
  <para style="q1" vid="LUK 1:46">“UMpepo wangu unokuja She,<verse eid="LUK 1:46" /></para>
  <para style="q2">
    <verse number="47" style="v" sid="LUK 1:47" />akale nompepo wangu unoshanta kunaMwali, uNchiji wangu,<verse eid="LUK 1:47" /></para>
  <para style="q2">
    <verse number="48" style="v" sid="LUK 1:48" />nokuti wabona chimilo changu chobunhu koga akandilinga neshe, ndili undandakaji uwe,</para>
  <para style="q1" vid="LUK 1:48">hezwo kuvila ngweno zwizwalwa zwose zwinotobela zwinondishoba zwiti ndilokombolelwa;<verse eid="LUK 1:48" /></para>
  <para style="q2">
    <verse number="49" style="v" sid="LUK 1:49" />nokuti iye wamasimba wanditila zwinhu zwikulwana, akale nezina lilye ijena.<verse eid="LUK 1:49" /></para>
  <para style="q2">
    <verse number="50" style="v" sid="LUK 1:50" />Ishe jije jiko kunaabo banontya</para>
  <para style="q2" vid="LUK 1:50">kuvila kuchizekululu kunda kuchizekululu.<verse eid="LUK 1:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51" />Watondeja isimba lyoluboko lulwe,</para>
  <para style="q2" vid="LUK 1:51">wapalaja banozwifufumula mumyoyo yabo.<verse eid="LUK 1:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52" />Wabhuluja bamasimba pezwigalo zwabo,</para>
  <para style="q2" vid="LUK 1:52">wanyamula pezhulu babeli pasi.<verse eid="LUK 1:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53" />Wagutisa banenzhala nezwinhu zwibuyanana,</para>
  <para style="q2" vid="LUK 1:53">akale bafumi wabatata besina zwibananazwo.<verse eid="LUK 1:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54" />Wabhancha undanda uwe Izilayeli,</para>
  <para style="q2" vid="LUK 1:54">ekumbulukwa ishe jije,<verse eid="LUK 1:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55" />sezwaakaleba kumatate edu, kunaAbhulahamu,</para>
  <para style="q2" vid="LUK 1:55">nokunzwalo yiye kujine kube lini.”<verse eid="LUK 1:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56" />Mariya wakagala naye kwemyeji ingaba mitatu, akabwilila kunsha uwe.<verse eid="LUK 1:56" /></para>
  <para style="s">Kuzwalwa kwaJoni umbhabhatizi</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57" />Wakaswika unshaji wokuti Elizabeti echile, akachila mwananhulumyana. <verse eid="LUK 1:57" /><verse number="58" style="v" sid="LUK 1:58" />Babakijani babe, namakamu awe pabakazwiwha kuti She wontila ishe ihulwana, bakashanta naye.<verse eid="LUK 1:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 1:59" />Kwakati kwapinda mazhuba mashanu anamatatu, bakezha kwomhalaja mwana, bamwe bakada kundundikila izina lyatate babe Zakaliya, <verse eid="LUK 1:59" /><verse number="60" style="v" sid="LUK 1:60" />koga amai babe bakati, “Mane pe, unokwelela kuwhi ndiJoni.”<verse eid="LUK 1:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 1:61" />Asi bakati kwaali, “Kuluji lwenu akuna unoshobwa nezina yeli.” <verse eid="LUK 1:61" /><verse number="62" style="v" sid="LUK 1:62" />Bakazibisa tate babe nezwitondejelo kuti ibo bebazibise izina libanoda kuti eshobwe nalyo.<verse eid="LUK 1:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 1:63" />Wakakumbila chikwalilo, akakwala kuti, “Izina lilye ndiJoni.” Bose bakachenama. <verse eid="LUK 1:63" /><verse number="64" style="v" sid="LUK 1:64" />Pakalepo undomo uwe wakazhulika, nolulimi lulwe lukasupulika, akalebeleka ekuja Mwali. <verse eid="LUK 1:64" /><verse number="65" style="v" sid="LUK 1:65" />Bakaba nolutyo bose babakijani babo, zwikalebelekwa mubugalo bose bwenyika yamatunhu yeJudiya, <verse eid="LUK 1:65" /><verse number="66" style="v" sid="LUK 1:66" />yabo bose bakazwiwha bakazwilondota mumyoyo yabo beti, “Unooba mwana ulichini yoyu?” Luboko lwaShe lwakaba luli naye.<verse eid="LUK 1:66" /></para>
  <para style="s">Kupolofita kwaZakaliya</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67" />Tate babe Zakaliya bakazhajwa noMpepo uNchena, bakapolofita beti.<verse eid="LUK 1:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68" />“Ngakujwe She Mwali waIzilayeli,</para>
  <para style="q2" vid="LUK 1:68">nokuti washanyila akamunula banhu babe,<verse eid="LUK 1:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69" />watinyamulila lubizho lwoluchijo mungumba yaDavidi undandalume uwe,<verse eid="LUK 1:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70" />sezwaakaleba nondomo wabapolofeti bachena bantolo,<verse eid="LUK 1:70" /></para>
  <para style="q2">
    <verse number="71" style="v" sid="LUK 1:71" />kuti unootichija kubabengi bedu,</para>
  <para style="q2" vid="LUK 1:71">nomumaboko abanhu bose banotibenga.<verse eid="LUK 1:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72" />kutila ishe matategulu edu,</para>
  <para style="q2" vid="LUK 1:72">nokukumbulukwa chivumilano chiche chichena,<verse eid="LUK 1:72" /></para>
  <para style="q2">
    <verse number="73" style="v" sid="LUK 1:73" />nekowhe yaakata kuna tate bedu Abhulahamu,<verse eid="LUK 1:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="LUK 1:74" />kuti betipe kusupulwa mumaboko ababengi bedu,</para>
  <para style="q2" vid="LUK 1:74">akale tiunamate tisinotya,<verse eid="LUK 1:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="LUK 1:75" />nomubuchena nobululami mbeli kukwe</para>
  <para style="q2" vid="LUK 1:75">mazhuba ose obupenyu bwedu.<verse eid="LUK 1:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76" />Akale iwi Mwana, unooshobwa uwhi umpolofeti woPezhuluzhulu,</para>
  <para style="q1" vid="LUK 1:76">nokuti unookwenda mbeli kwaShe kunobambanyila inzila jije,<verse eid="LUK 1:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77" />unoopa luzibo lwoluchijo kubanhu,</para>
  <para style="q2" vid="LUK 1:77">nokulekejelwa kwoluchinyo lwabo,<verse eid="LUK 1:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78" />neshe inyolonyolo jaMwali wedu, izhuba yelyo palicheja kunasu liva zhezhulu<verse eid="LUK 1:78" /></para>
  <para style="q2">
    <verse number="79" style="v" sid="LUK 1:79" />kupa lumuniko kunaabo bagele munhilima nomuntuzi wolufu,</para>
  <para style="q2" vid="LUK 1:79">nokutungamila makumbo edu munzila yolunyalalo.”<verse eid="LUK 1:79" /></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80" />Mwana wakakubuka, akasima mumpepo, wakagala mugwegulu kujine kukaswika izhuba lyaakazwitondejela kubaIzilayeli.<verse eid="LUK 1:80" /></para>
  <chapter eid="LUK 1" />
  <chapter number="2" style="c" sid="LUK 2" />
  <para style="s">Kuzwalwa kwaJesu</para>
  <para style="r">(<ref loc="MAT 1:18-25">Mateo 1:18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1" />Mumazhuba yayo, chishomejo chakawhika chiva kunaKesali Agasitasi kuti banhu bwose munyika banokwelela kuti bekwaliswe. <verse eid="LUK 2:1" /><verse number="2" style="v" sid="LUK 2:2" />Yoku kukwaliswa kwakabeli kwotanga kutiwa nonshaji Kiliniyasi eli untongi weSiliya. <verse eid="LUK 2:2" /><verse number="3" style="v" sid="LUK 2:3" />Bose bakenda kuti benokwaliswa, umwe noumwe kuguta lyokunaibo.<verse eid="LUK 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4" />Josefa neebo wakanyamuka eva kuGalili, kuzhe kweguta lyeNazaleti, engwina munyika yeJudiya, akenda kuguta lyaDavidi linowhi Bhetelehema, nokuti wakabeli wengumba akale eli inzwalo yaDavidi, <verse eid="LUK 2:4" /><verse number="5" style="v" sid="LUK 2:5" />kuti enokwaliswa naMariya, wakaba ahwaywa, akale iye elinemimba. <verse eid="LUK 2:5" /><verse number="6" style="v" sid="LUK 2:6" />Kwakati beli kwakale yoko mazhuba akaba aswika okuti echile. <verse eid="LUK 2:6" /><verse number="7" style="v" sid="LUK 2:7" />Wakachila imbano mwananhulumyana, akomputilija nemicheka, akondajika muchilyilo chemhuka, nokuti bakabashayiwa bugalo mujingumba jabezi.<verse eid="LUK 2:7" /></para>
  <para style="s">Balyisi neNgilozi</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8" />Kunyika yeyo kwakaba kuli nabalyisi bemhwizi belyisa akale belinda imhwizi jabo kumachelelo busiku. <verse eid="LUK 2:8" /><verse number="9" style="v" sid="LUK 2:9" />Akale ingilozi yaShe yakaboneka kwabali, kungaima kwaShe kwakapenya yopo pabakabeli, bakatya kasakasa. <verse eid="LUK 2:9" /><verse number="10" style="v" sid="LUK 2:10" />Ingilozi yakati kwabali, “Musitye, nokuti ndimumubuzila inyaya imbuya ina lushanto lukulwana luchaba kubanhu bose. <verse eid="LUK 2:10" /><verse number="11" style="v" sid="LUK 2:11" />Nokuti muguta lyaDavidi nasi mwazwalilwa uNchiji, ndiKristo, Tezi. <verse eid="LUK 2:11" /><verse number="12" style="v" sid="LUK 2:12" />Yechi ndicho chichaba chitondejelo kwamuli: monowana mwana uncheche ekaputilijwa mumicheka, ekalajikwa muchilyilo chemhuka.”<verse eid="LUK 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13" />Pakalepo kwakaba nebunga lyezwibumbwa zwaMwali zwokudenga nengilozi zwikuja Mwali zwiti, <verse eid="LUK 2:13" /><verse number="14" style="v" sid="LUK 2:14" />“Lukujo kunaMwali wopezhulu, nolunyalalo munyika, banhu begalike!”<verse eid="LUK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15" />Kwakati ingilozi jenda jabwilila kudenga, balyisi bakalebelekesana beti, “Andeni kuBhetelehema, tinozwibonela yechi chinhu chatikana, chatazibiswa naShe.”<verse eid="LUK 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16" />Bakenda nokambija, bakawana Mariya naJosefa, nomwana elilele muchilyilo chemhuka. <verse eid="LUK 2:16" /><verse number="17" style="v" sid="LUK 2:17" />Pabakombona bakazibisa zwibakababujwa nezwomwana yoyu, <verse eid="LUK 2:17" /><verse number="18" style="v" sid="LUK 2:18" />bose bakawha bakachenamiswa nezwakabelebwa naba balyisi kwabali, <verse eid="LUK 2:18" /><verse number="19" style="v" sid="LUK 2:19" />Koga Mariya wakalondota zwose yezwi ezwiyeya mumwoyo uwe. <verse eid="LUK 2:19" /><verse number="20" style="v" sid="LUK 2:20" />Balyisi bakabwilila, bekuja nokuboka Mwali munezwo zwose zwibakawha nezwibakabona, somuzwakaba zwalebwa kwabali.<verse eid="LUK 2:20" /></para>
  <para style="s">Jesu unolundikilwa izina</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21" />Mushule kweviki, unshaji wokumhalajwa kwomwana wakaswika, akawhi ndiJesu, izina lyakaba lyalebwa nengilozi amai besanhu babhata imimba.<verse eid="LUK 2:21" /></para>
  <para style="s">Jesu unopilwa muTempeli</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 2:22" />Unshaji wakaswika wokushampulujwa kwaJosefa naMariya, kutobelejwa mulawo waMozesi. Bakombuza kuJelusalema kuti epilwe kunaShe, <verse eid="LUK 2:22" /><verse number="23" style="v" sid="LUK 2:23" />sezwilokwalwa mumulawo waShe kuti, “Mwananhulumyana wose wotanga ulokwelela kuwhi unchena kunaTezi.” <verse eid="LUK 2:23" /><verse number="24" style="v" sid="LUK 2:24" />Nokupila umpilo kutobelejwa zwilolebwa mumulawo waShe, injiba imbili kana inyunyana jenkwilimba imbili.<verse eid="LUK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25" />Kwakaba kuli nonhulume muJelusalema waluwhi ndiSimiyoni. Unhulume yoyu wakaba ekalulama etya Mwali, ekamilila kunyalajwa kweIzilayeli, noMpepo uNchena wakaba uli mwaali. <verse eid="LUK 2:25" /><verse number="26" style="v" sid="LUK 2:26" />Wakaba atondejwa noMpepo uNchena kuti aatoofa asanu abona She Kristo. <verse eid="LUK 2:26" /><verse number="27" style="v" sid="LUK 2:27" />Wakatungamililwa noMpepo engwina mutempeli, bazwali pabakabuza mwana Jesu, kuti etiwe sezwinotiwa mumulawo, <verse eid="LUK 2:27" /><verse number="28" style="v" sid="LUK 2:28" />wakontola mumaboko awe, akakuja Mwali eti:<verse eid="LUK 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29" />“She feno mungata kuti undanda</para>
  <para style="q2" vid="LUK 2:29">wenu ende mulunyalalo sokubimbisa kwenu,<verse eid="LUK 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30" />nokuti mesho angu abona luchijo lwenu,<verse eid="LUK 2:30" /></para>
  <para style="q2">
    <verse number="31" style="v" sid="LUK 2:31" />lumwakabamba mumesho abanhu bose,<verse eid="LUK 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32" />ndiwo mwenje wokumunikila bokuzhe,</para>
  <para style="q2" vid="LUK 2:32">nolukujo lwabanhu benu baIzilayeli.”<verse eid="LUK 2:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33" />Tate naamai babe bechakashamiswa nezwo zwakabelebwa nezwizwe, <verse eid="LUK 2:33" /><verse number="34" style="v" sid="LUK 2:34" />Simiyoni wakabakombolela akati kuna amai babe Mariya, “Ilingani yoyu mwana ulomilila kuwila pasi nokumuka kwabanji muIzilayeli, akale ndiye chitondejelo chichalebelekwa bubi nezwacho <verse eid="LUK 2:34" /><verse number="35" style="v" sid="LUK 2:35" />akale igwalabaza linoobhaya umpepo wenu, kutila zwimuyeywa mumyoyo yabanji zwitondejelwe pachena.”<verse eid="LUK 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36" />Kwakaba kuli naAna umpolofeti wechinhukaji, mwananhukajana waFanuwelu, woluji lwaAsha, wakaba akwegula, wakabagala nondume uwe kwamakole mashanu ana mabili kuva kubumhandala bubwe, <verse eid="LUK 2:36" /><verse number="37" style="v" sid="LUK 2:37" />akaba inchilikaji inamakole makumi mashanu ana makumi matatu namakole mana. Aajakabebhuda muTempeli, ekuja nokuzwiminya kulya, akale enamata busiku namasikati. <verse eid="LUK 2:37" /><verse number="38" style="v" sid="LUK 2:38" />Eswika panoyo unshaji, wakaboka Mwali, akale wakalebeleka nezwizwe kuna ibo bose bakabemilila kuchijwa kweJelusalema.<verse eid="LUK 2:38" /></para>
  <para style="s">Kubwilila kuNazaleti</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39" />Pabakati bapeja zwose zwinotobelejwa mumulawo waShe, bakabwilila kuGalili kuguta lyabo lyeNazaleti. <verse eid="LUK 2:39" /><verse number="40" style="v" sid="LUK 2:40" />Nomwana wakakubuka, akasima mumpepo akaba namaano nechipiwo chaMwali chakaba pezhulu pape.<verse eid="LUK 2:40" /></para>
  <para style="s">Umbisana Jesu mutempeli</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41" />Bazwali babe bakabenda kuJelusalema makole ose pemilya yePasika. <verse eid="LUK 2:41" /><verse number="42" style="v" sid="LUK 2:42" />Paakaba namakole igumi lina mabili bakenda kuJelusalema kumilya sezwinokwelela pamulawo, <verse eid="LUK 2:42" /><verse number="43" style="v" sid="LUK 2:43" />payakapela milya, bakabwilila kusha kwabo asi umbisana Jesu wakasala mushule kuJelusalema, bazwali babe besinozwiziba, <verse eid="LUK 2:43" /><verse number="44" style="v" sid="LUK 2:44" />bakabona sokuti bana naye bakakwenda lwendo lwezhuba limwempela, bakonshaka mukati mwamakamu nabakwaina babo; <verse eid="LUK 2:44" /><verse number="45" style="v" sid="LUK 2:45" />bakati bonshayiwa, bakabwilila kuJelusalema kunoumpota. <verse eid="LUK 2:45" /><verse number="46" style="v" sid="LUK 2:46" />Mushule mwamazhuba matatu, bakongwana muTempeli eligele pakati pabalayiji elimukubawhilila akale ebabhuza mibhuzo, <verse eid="LUK 2:46" /><verse number="47" style="v" sid="LUK 2:47" />bose bakawha elebeleka, bakachenamiswa namaano awe nokushandula kukwe. <verse eid="LUK 2:47" /><verse number="48" style="v" sid="LUK 2:48" />Pabakombona bakachenama, amai babe bakati kwaali, “Mwanangu ini uta ali kwatili? Linga tate babo nami tabekupyanga tikahetela.”<verse eid="LUK 2:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49" />Wakabashandula akati, “Mwaba mundipotelani? Amujabeziba na kuti ndokwelela kuba ndili mungumba yaTate bangu?” <verse eid="LUK 2:49" /><verse number="50" style="v" sid="LUK 2:50" />Asi abajakawhisisa mawhi aakaleba kunaibo.<verse eid="LUK 2:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51" />Wakenda nabo, bakaswika kuNazaleti, wakagala nabazwali babe ebawhilila, asi amai babe bakazwilondota zwose yezwi mumwoyo mwabo. <verse eid="LUK 2:51" /><verse number="52" style="v" sid="LUK 2:52" />Jesu wakendila mbeli ekubuka mumaano, nombili nokudikana kunaMwali nokubanhu.<verse eid="LUK 2:52" /></para>
  <chapter eid="LUK 2" />
  <chapter number="3" style="c" sid="LUK 3" />
  <para style="s">Kubhaunula kwaJoni umbhabhatizi</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mateo 3:1-12</ref>; <ref loc="2JN 1:1-8">2 Joni 1:1-8</ref>; <ref loc="JHN 1:19-28">Joni 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1" />Lyakabeli igole lyegumi linamashanu lyobutongi bwaTibheliyasi Kesali, Ponsiyo Pilato eli untongi weJudiya, Helodi eli umbhatili weGalili, unkulu uwe Filipu eli umbhatili weItuliya neTilakonitisi, Lisaniyasi eli umbhatili wokuAbhilene, <verse eid="LUK 3:1" /><verse number="2" style="v" sid="LUK 3:2" />panshaji Anasi naKefasi beli batebuji bakulwana, iwhi lyaMwali lyakaswika kunaJoni mwananhulumyana waZakaliya elimugwegulu; <verse eid="LUK 3:2" /><verse number="3" style="v" sid="LUK 3:3" />wakakezha munyika yose yeJolodani, ebhaunula umbhabhatizo wokushanduka, kuti luchinyo lulekejelwe. <verse eid="LUK 3:3" /><verse number="4" style="v" sid="LUK 3:4" />Sezwazwilokwalwa muwhalo yoMpolofeti Izaya eti,</para>
  <para style="q1" vid="LUK 3:4">“Iwhi lyounoshomeja mugwegulu liti,</para>
  <para style="q2" vid="LUK 3:4">‘Kungubulani inzila yaTezi,</para>
  <para style="q2" vid="LUK 3:4">Lulamisani inzila yiye.<verse eid="LUK 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5" />Makoba ose anoozhajwa,</para>
  <para style="q2" vid="LUK 3:5">ose matunhu notutunhu tunoofupipiswa,</para>
  <para style="q1" vid="LUK 3:5">jinzila jilobhilingana jinokololwa,</para>
  <para style="q2" vid="LUK 3:5">nenzila jinamitunda jinootandabajwa,<verse eid="LUK 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6" />Banhu bose banoobona luchijo lwaMwali.’”<verse eid="LUK 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7" />Wakati kubunga lyakaswika kuna iye lida kubhabhatizwa, “Imwi bana benyoka, ndiyani wakamubuja kuti mutizhe bukali bukumuzha? <verse eid="LUK 3:7" /><verse number="8" style="v" sid="LUK 3:8" />Itani zwinhu zwinotondejela michelo yokushanduka, musitange kuzwibuja kuti, ‘tina tategulu wedu Abhulahamu’ Ndinomubuja Mwali unamasimba okubhisa bana baAbhulahamu kuva mumabwe yaya. <verse eid="LUK 3:8" /><verse number="9" style="v" sid="LUK 3:9" />Ngweno ishanhu lyalajikwa ponji wemiti, wose unti usinozwala unchelo umbuya, unootemwa uwigilwa pasi kova uposelwa mumoto.”<verse eid="LUK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10" />Ibunga lyabanhu lyakombhuza liti, “Biya tite chini?”<verse eid="LUK 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11" />Wakabashandula eti, “Yoyo unazwimbalo zwibili ulokwelela kupa chimwempela kuna yoyo usina, akale yoyo unazwokulya ngete alo.”<verse eid="LUK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12" />BaTelesi bakezha kwobhabhatizwa, bakati kwaali, “Ndayiji tokwelela kuta chini?”<verse eid="LUK 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13" />Wakati kwabali, “Musitole zwilopindilija panezwo zwamulomisilwa.”<verse eid="LUK 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 3:14" />Balwi neebo bakombhuza beti, “Ani isu tilokwelela kuta chini biya?”</para>
  <para style="p" vid="LUK 3:14">Wakati kwabali, “Musitole chinhu kubanhu mushingisa isimba kana kupita, gunchikanani nendipo yenu.”<verse eid="LUK 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15" />Banhu bose bakabeli nobulingiliji, yezwi zwakata kuti betange kuyeya kuti posa Joni angaba eliKristo, <verse eid="LUK 3:15" /><verse number="16" style="v" sid="LUK 3:16" />Joni wakabashandula akati, “Imi ndomubhabhatiza nevula, asi ukumuzha unamasimba anopinda angu, anditokwelela kana nokusupula unchili weshangu jije, iye unoomubhabhatiza noMpepo uNchena akale nomoto. <verse eid="LUK 3:16" /><verse number="17" style="v" sid="LUK 3:17" />Umpyayijo uwe umomuluboko akale unookululuja zwilyo zwizwe zwose, unoopyaila lubuwa lulwe, kova ebiga zwilyo mugombana lilye, asi unoopisa bungu mumoto usinojima.”<verse eid="LUK 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 3:18" />Wakabalaya zwinhu zwinji akabhaunula iNdebo iMbuya kubanhu. <verse eid="LUK 3:18" /><verse number="19" style="v" sid="LUK 3:19" />Koga Helodi igulukota, yoyo wakabakalalilwa pezhulu paHelodiyasi unkaji wonuna uwe, nezwimwe zwinhu zwibi zwinji zwaakabata, <verse eid="LUK 3:19" /><verse number="20" style="v" sid="LUK 3:20" />wakapamhija bumwe bubi, nokubiga Joni muntolongo.<verse eid="LUK 3:20" /></para>
  <para style="s">Kubhabhatizwa kwaJesu</para>
  <para style="r">(<ref loc="MAT 3:13-17">Mateo 3:13-17</ref>; <ref loc="2JN 1:9-11">2 Joni 1:9-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21" />Pabakati bose banhu babhabhatizwa, neebo Jesu wakabhabhatizwa, paakaba eli mukunamata, idenga lyakazhulika, <verse eid="LUK 3:21" /><verse number="22" style="v" sid="LUK 3:22" />uMpepo uNchena wakabhulukila paali ulimuchimo chenjiba, ndipo iwhi likava kudenga likati, “Ndiwi Mwananhulumyana wangu unodikana, ndinoshanta munawi.”<verse eid="LUK 3:22" /></para>
  <para style="s">Matategulu aJesu</para>
  <para style="r">(<ref loc="MAT 1:1-17">Mateo 1:1-17</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23" />Jesu waluba namakole angaba makumi matatu okuzwalwa, paakatanga unshingo uwe eli kwakakuyeyeselwa kuti mwananhulumyana waJosefa, iye eli mwananhulumyana waHeli, <verse eid="LUK 3:23" /><verse number="24" style="v" sid="LUK 3:24" />mwananhulumyana waMatati, mwananhulumyana waLevi, mwananhulumyana waMeluchi, mwananhulumyana waJanayi, mwananhulumyana waJosefa, <verse eid="LUK 3:24" /><verse number="25" style="v" sid="LUK 3:25" />mwananhulumyana waMatatiyasi, mwananhulumyana waAmosi, mwananhulumyana waNahamu, mwananhulumyana waEsili, mwananhulumyana waNagai, <verse eid="LUK 3:25" /><verse number="26" style="v" sid="LUK 3:26" />mwananhulumyana waMata, mwananhulumyana waMatatiyasi, mwananhulumyana waSemeni, mwananhulumyana waJoseki, mwananhulumyana waJoda, <verse eid="LUK 3:26" /><verse number="27" style="v" sid="LUK 3:27" />mwananhulumyana waJohana, mwananhulumyana waResa, mwananhulumyana waZelubhabheli, mwananhulumyana waShelitiyeli, mwananhulumyana waNeri, <verse eid="LUK 3:27" /><verse number="28" style="v" sid="LUK 3:28" />mwananhulumyana waMeliki, mwananhulumyana waAdi, mwananhulumyana waKosamu, mwananhulumyana waElimadamu, mwananhulumyana waEli <verse eid="LUK 3:28" /><verse number="29" style="v" sid="LUK 3:29" />mwananhulumyana waJoshuwa, mwananhulumyana waElieza, mwananhulumyana waJolimu, mwananhulumyana waMatati, mwananhulumyana waLevi, <verse eid="LUK 3:29" /><verse number="30" style="v" sid="LUK 3:30" />mwananhulumyana waSimiyoni, mwananhulumyana waJuda, mwananhulumyana waJosefa, mwananhulumyana waJonamu, mwananhulumyana waEliyakimu, <verse eid="LUK 3:30" /><verse number="31" style="v" sid="LUK 3:31" />mwananhulumyana waMeliya, mwananhulumyana waMena, mwananhulumyana waMatata, mwananhulumyana waNatani, mwananhulumyana waDavidi <verse eid="LUK 3:31" /><verse number="32" style="v" sid="LUK 3:32" />mwananhulumyana waJese, mwananhulumyana waObhedi, mwananhulumyana waBhowazi, mwananhulumyana waSalamoni, mwananhulumyana waNashoni <verse eid="LUK 3:32" /><verse number="33" style="v" sid="LUK 3:33" />mwananhulumyana waAminadabhi, mwananhulumyana waAdimini, mwananhulumyana waAni, mwananhulumyana waHeziloni, mwananhulumyana waPelezi, mwananhulumyana waJuda, <verse eid="LUK 3:33" /><verse number="34" style="v" sid="LUK 3:34" />mwananhulumyana waJakobe, mwananhulumyana waIsaki, mwananhulumyana waAbhulahamu, mwananhulumyana waTela, mwananhulumyana waNahola, <verse eid="LUK 3:34" /><verse number="35" style="v" sid="LUK 3:35" />mwananhulumyana waSelugi, mwananhulumyana waLewu, mwananhulumyana waPelegi, mwananhulumyana waEbha, mwananhulumyana waShela, <verse eid="LUK 3:35" /><verse number="36" style="v" sid="LUK 3:36" />mwananhulumyana waKenani, mwananhulumyana waAfazedi, mwananhulumyana waShemu, mwananhulumyana waNowa, mwananhulumyana waLameki, <verse eid="LUK 3:36" /><verse number="37" style="v" sid="LUK 3:37" />mwananhulumyana waMetusela, mwananhulumyana waInoki, mwananhulumyana waJaledi, mwananhulumyana waMahalaleli, mwananhulumyana waKenani, <verse eid="LUK 3:37" /><verse number="38" style="v" sid="LUK 3:38" />mwananhulumyana waInosi, mwananhulumyana waSeti, mwananhulumyana waAdamu, mwananhulumyana waMwali.<verse eid="LUK 3:38" /></para>
  <chapter eid="LUK 3" />
  <chapter number="4" style="c" sid="LUK 4" />
  <para style="s">Kukwejwa kwaJesu</para>
  <para style="r">(<ref loc="MAT 4:1-11">Mateo 4:1-11</ref>; <ref loc="2JN 1:12-13">2 Joni 1:12-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1" />Jesu elizhele noMpepo uNchena wakezha eva kuJolodani akatungamililwa noMpepo <verse eid="LUK 4:1" /><verse number="2" style="v" sid="LUK 4:2" />kwamazhuba makumi mana, wakakwejwa naGuluzhanje. Apana zwaakalya mumazhuba yayo, paakapela mazhuba wakaba nenzhala.<verse eid="LUK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3" />Guluzhanje wakati kwaali, “Kana uli mwananhulumyana waMwali, ibuja ibwe yeli lishanduke libe chinkwa.”<verse eid="LUK 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4" />Asi Jesu wakashandula eti, “Zwilokwalwa kuwhi, ‘unhu aatolalama nechinkwa chete.’”<verse eid="LUK 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5" />Guluzhanje wakonsenga pezhulu, akontondeja bushe bwedenga nonshanji umfupi. <verse eid="LUK 4:5" /><verse number="6" style="v" sid="LUK 4:6" />Guluzhanje wakati, “Ndokupa masimba ose yaya nefuma yose yeyi. Zwose zwilopiwa kwandili ndingapa kana aani wandinoshala. <verse eid="LUK 4:6" /><verse number="7" style="v" sid="LUK 4:7" />Zwose yezwi zwinoba zwizwo kana ukandinamata imi.”<verse eid="LUK 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8" />Jesu wakashandula eti kwaali, “Zwilokwalwa kuti namata She Mwali uwo akale shingila iye chete.”<verse eid="LUK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9" />Wakonsenga kuJelusalema, akomisika pechilungwani cheTempeli, akati kwaali, “Kana uli Mwananhulumyana waMwali, zwiwigile pasi uvila yopano, <verse eid="LUK 4:9" /><verse number="10" style="v" sid="LUK 4:10" />nokuti kulokwalwa kuti, ‘Unobuja ingilozi jije Mwali jikulinde.’ <verse eid="LUK 4:10" /><verse number="11" style="v" sid="LUK 4:11" />Akale, jinokunyamula namaboko ajo kutila kuti usigubhulwe nebwe.”<verse eid="LUK 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12" />Jesu wakonshandula eti, “Kunowhi, usikweje She Mwali uwo.”<verse eid="LUK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13" />Guluzhanje paakapeja jose inzila jokunkweja, wakonsiya kuti oonzhila muna umwe unshaji.<verse eid="LUK 4:13" /></para>
  <para style="s">Jesu unotanga unshingo uwe muGalili</para>
  <para style="r">(<ref loc="MAT 4:12-17">Mateo 4:12-17</ref>; <ref loc="MRK 1:14">Mako 1:14</ref>; <ref loc="MRK 15">15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14" />Jesu wakabwilila kuGalili, nesimba lyoMpepo, impuwo yiye yakaswika kubugalo bose. <verse eid="LUK 4:14" /><verse number="15" style="v" sid="LUK 4:15" />Wakalayija mumasinagogo abo akakujwa naibo bose.<verse eid="LUK 4:15" /></para>
  <para style="s">Jesu unolambwa muNazaleta</para>
  <para style="r">(<ref loc="MAT 13:53-58">Mateo 13:53-58</ref>; <ref loc="MRK 6:1-6">Mako 6:1-6</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16" />Wakaswika kuNazaleti, kwaakakubukila, nezhuba lyeSabata wakangwina muSinagogi, sezwaakabegala eta. Wakanyamuka kuti ebale, <verse eid="LUK 4:16" /><verse number="17" style="v" sid="LUK 4:17" />wakatambikwa iwhalo yeNdebo joMpolofeti Izaya. Wakaizhula iwhalo akawana palokwalwa kuwhi,<verse eid="LUK 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18" />“UMpepo waShe upo pezhulu pangu,</para>
  <para style="q2" vid="LUK 4:18">nokuti wakandiguba kuti ndibuze iNdebo iMbuya kubasheti.</para>
  <para style="q1" vid="LUK 4:18">Wakandituma kwosuma lusungunuko kubatapwa,</para>
  <para style="q2" vid="LUK 4:18">nokubhwazulisa mesho amapofu,</para>
  <para style="q1" vid="LUK 4:18">nokoomunula balosindamijwa,<verse eid="LUK 4:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="LUK 4:19" />nokuzibisa pachena igole lyobubuya bwaShe.”<verse eid="LUK 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20" />Jesu wakaivala iwhalo, akaibwiliza kumbhanchi, akagala pasi; mesho abo bose bakabeli muSinagogi akontokoloja. <verse eid="LUK 4:20" /><verse number="21" style="v" sid="LUK 4:21" />Wakatanga nokuti kwabali, “Nasi unkwalo yoyu ukumuzhajikijwa munzebe jenu.”<verse eid="LUK 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22" />Bose bakapupula zwanana naiye, bakashamiswa namawhi eshe akava mundomo mumwe, bakati, “Atoba iye na yoyu mwananhulumyana waJosefa?”<verse eid="LUK 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23" />Wakati kwabali, “Chokomende muchandilungululila chichimbe chinoti, ‘Ndapi zwilape’ zwatakawha kuti wakazwita kuKapenaume, zwite bo yomuno munyika yokunamwi.” <verse eid="LUK 4:23" /><verse number="24" style="v" sid="LUK 4:24" />Wakati akale, “Chokomende ndinomubuja, apana undebambeli waMwali unotambulwa zwibuyanana munyika yokunaibo. <verse eid="LUK 4:24" /><verse number="25" style="v" sid="LUK 4:25" />Koga ndinomubuja isimiso kuti, kwakabeli nenchilikaji inji kuIzilayeli mumazhuba aElija, pakwakakonywa idenga kwamakole matatu nemyeji mishanu ina umwempela, kukaba nenzhala munyika yose, <verse eid="LUK 4:25" /><verse number="26" style="v" sid="LUK 4:26" />koga Elija aajakatumwa kuna imwe yajo, koga kunchilikaji yokuZalefati munyika yeSidoni. <verse eid="LUK 4:26" /><verse number="27" style="v" sid="LUK 4:27" />Kwakabeli nabanji balulwala mapelembuji kuIzilayeli nonshaji nompolofeti Elisha, koga apana nomwempela wakashampulujwa kuzhe kwaNamani uNsiliya.”<verse eid="LUK 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28" />Pabakawha yezwi, bose bakabeli muSinagogi bakanyema kasa. <verse eid="LUK 4:28" /><verse number="29" style="v" sid="LUK 4:29" />Bakamilika bakonsusuma kuvila kuguta yelyo, bakonsenga pebhilipili lyedunhu kulobakiwa iguta lyabo, beda kuumposela yopo. <verse eid="LUK 4:29" /><verse number="30" style="v" sid="LUK 4:30" />Koga iye wakapinda pakati pabo akenda.<verse eid="LUK 4:30" /></para>
  <para style="s">Unhu unalupepo lubi</para>
  <para style="r">(<ref loc="MRK 1:21-28">Mako 1:21-28</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31" />Wakenda kuguta lyeKapenaume muGalili, nezhuba lyeSabata wakabelayija banhu. <verse eid="LUK 4:31" /><verse number="32" style="v" sid="LUK 4:32" />Bakachenamiswa nokulayija kukwe nokuti wakabelayija newhi linesimba. <verse eid="LUK 4:32" /><verse number="33" style="v" sid="LUK 4:33" />MuSinagogi kwakaba kuli nonhu waluba nompepo weshambwa wedimoni, wakakwiila newhi lipopezhulu, <verse eid="LUK 4:33" /><verse number="34" style="v" sid="LUK 4:34" />“Aa! uneni nasu, Jesu wokuNazaleti? Wezha kotipalaja na? Ndoziba kuti uli ani, uNchena waMwali.”<verse eid="LUK 4:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35" />Jesu wakakalalila umpepo akati, “Whilijila ubhude mwaali!” Palyakongwigila pasi pakati pabanhu, idimoni lyakabhuda mwaali lisonkubaja.<verse eid="LUK 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36" />Zwakabashamisa bose bakabhuzana beti, “Iwhini yeli? Linokalalila mipepo yeshambwa namasimba ikabhuda.” <verse eid="LUK 4:36" /><verse number="37" style="v" sid="LUK 4:37" />Impuwo yiye yakaswika mushango lyose lyokwakale.<verse eid="LUK 4:37" /></para>
  <para style="s">Kulapwa kwabanhu banji</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mateo 8:14-17</ref>; <ref loc="MRK 1:29-34">Mako 1:29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38" />Wakabhuda muSinagogi, akanongwina mungumba yaSimoni. Amezwale baSimoni bakabelwala umbili wabo upisa kasa, bakonzibisa nozwamalwaji. <verse eid="LUK 4:38" /><verse number="39" style="v" sid="LUK 4:39" />Wakanoma pelyo nopabulo akabuja ilwaji lyokupisa kwombili kuti libhude mwabali, lyakabhuda, bakamuka nokunyamuka pakale yopo bakatanga kubashingila.<verse eid="LUK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40" />Palyakati lyamila izhuba, bose bakabeli nabanhu banolwala malwaji alosiyanasiyana bakabuzwa kunaiye; wakabiga maboko awe panoumwe noumwe wabo akabachilisa bose. <verse eid="LUK 4:40" /><verse number="41" style="v" sid="LUK 4:41" />Banhu banji bakabhuda madimoni manji, ekwiila, eti, “Iwi ndiwi mwananhulumyana waMwali!”</para>
  <para style="p" vid="LUK 4:41">Asi wakaakalalila, akale aajakawavumija kuti elebeleke nokuti akabeziba kuti ndiKristo.<verse eid="LUK 4:41" /></para>
  <para style="s">Jesu unobhaunula mumasinagogo</para>
  <para style="r">(<ref loc="MRK 1:35-39">Mako 1:35-39</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42" />Palyakeja, wakabhuda akenda kubugalo busakabeli nabanhu. Banhu bakompyanga bakongwana kwaakabeli bakonkoneja kuti ebasiye; <verse eid="LUK 4:42" /><verse number="43" style="v" sid="LUK 4:43" />asi wakati kunaibo, “Ndokwelela kunobhaunula iNdebo iMbuya pezhulu pobushe bwaMwali munaamwe makuta neebo, nokuti ndizwo zwindakatumwa.”<verse eid="LUK 4:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 4:44" />Nokudalo wakendila mbeli ebhaunula mumasinagogo omuJudiya.<verse eid="LUK 4:44" /></para>
  <chapter eid="LUK 4" />
  <chapter number="5" style="c" sid="LUK 5" />
  <para style="s">Jesu unoshoba balayijwa botanga</para>
  <para style="r">(<ref loc="MAT 4:18-22">Mateo 4:18-22</ref>; <ref loc="MRK 1:16-20">Mako 1:16-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1" />Jesu wakati elimile kumbali kwegungwa lyeGenesaleti, igapo lyabanhu lyakezha kwaali beda kuwha iwhi lyaMwali, <verse eid="LUK 5:1" /><verse number="2" style="v" sid="LUK 5:2" />Wakabona bwato bubili bulimumbali mwegungwa; bavubi bakaba babhuluka, bekusha mazamba abo, <verse eid="LUK 5:2" /><verse number="3" style="v" sid="LUK 5:3" />Jesu wakangwina munabumwe bwato, bwakabeli bwaSimoni, wakonkumbila kuti esundile zwishoma bwato muvula, akagala pasi akatanga kulayija igapo eligele mubwato.<verse eid="LUK 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4" />Paakapeja kulebeleka, wakati kunaSimoni, “Bigani bwato kulomila mupose mazamba mubhate ihobe.”<verse eid="LUK 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5" />Simoni wakashandula akati, “She tashinga busiku bose asi apana chatabhata, asi nokuti ndimwi mwaleba towaposa mazamba.” <verse eid="LUK 5:5" /><verse number="6" style="v" sid="LUK 5:6" />Bakaposa mazamba abo muvula bakabhata ihobe inji kasa, mane mazamba akatanga kujeluka, <verse eid="LUK 5:6" /><verse number="7" style="v" sid="LUK 5:7" />bakashoba bakwaina babo bakabeli munobumwe bwato, bebakobola noluboko, kuti bezhe boobabhancha. Bakezha, bakazhaja bwato bwabo bubili mane bukajondyondyomela. <verse eid="LUK 5:7" /><verse number="8" style="v" sid="LUK 5:8" />Paakabona yezwi, Simoni Pita wakazwiwigila munhambo jaJesu eti, “Bhudani pandili She, nokuti imi ndunchinyi.”<verse eid="LUK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 5:9" />Iye, naibo bose baluba naye, bakachenama, pezhulu pokubhata ihobe inji jakadai, <verse eid="LUK 5:9" /><verse number="10" style="v" sid="LUK 5:10" />naJemusi naJoni bana baZebhedi bakabeli bakwaina baSimoni bakachenama. Jesu wakati kunaSimoni, “Usitye, kuvila nasi unoba umvubi wabanhu.”<verse eid="LUK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 5:11" />Pabakasenga bwato bwabo penyika kumbali kwegungwa, bakasiya zwose, bakontobela.<verse eid="LUK 5:11" /></para>
  <para style="s">Jesu unochija unhulume</para>
  <para style="r">(<ref loc="MAT 8:1-4">Mateo 8:1-4</ref>; <ref loc="MRK 1:40-45">Mako 1:40-45</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12" />Wakati eli munelimwe iguta, kwakaswika umwe unhulume wakabelizhele mapelembuji, paakabona Jesu, wakazwiwigila pasi akatibhama onkumbila eti, “She, kana muda motubula kundichenesa.”<verse eid="LUK 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13" />Wakatambunuja luboko lulwe, akonguma eti, “Eya ndinoda, shambijika.” Mapelembuji akonsiya pakalepo. <verse eid="LUK 5:13" /><verse number="14" style="v" sid="LUK 5:14" />Wakondaya kuti esibuje banhu, asi “Inda unozwitondeja kuntebuji akale upile umpilo wokushampulujwa kukwo, sechitondejelo kunaibo, sezwakalebwa naMozesi.”<verse eid="LUK 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15" />Asi impuwo yaJesu yakazhala inyika yose, kukabungana igapo igulwana, lizha kowhilila nokuchiliswa mumalwaji abo. <verse eid="LUK 5:15" /><verse number="16" style="v" sid="LUK 5:16" />Koga iye wakenda kubugalo busina banhu akanamata.<verse eid="LUK 5:16" /></para>
  <para style="s">Jesu unochilisa igosha</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mateo 9:1-8</ref>; <ref loc="MRK 2:1-12">Mako 2:1-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17" />Nelimwe lyamazhuba yayo, elimukulayija, kwakaba kuli baFalisi nabalayiji bomulawo beligele pasi beva mumisha yose yomuGalili neJudiya nomuJelusalema, isimba lyaShe lyokuchilisa lyakaba mwaali. <verse eid="LUK 5:17" /><verse number="18" style="v" sid="LUK 5:18" />Bamwe banhulume bakaswika bekanyamula pabushasha, unhulume wakabeli igosha, bakabekweja kuungwinisa mungumba kuti bontule pambeli paJesu, <verse eid="LUK 5:18" /><verse number="19" style="v" sid="LUK 5:19" />koga nokuzhala kwabanhu, bakashayiwa kuti balungwinisa chini, ndipo pabakonyamula bonsenga pezhulu pedenga lyengumba, bakazhula ibanga kova bongwinisa ekalajikwa pabushasha akabhulujwa pakati pabanhu mbeli kwaJesu. <verse eid="LUK 5:19" /><verse number="20" style="v" sid="LUK 5:20" />Paakabona kudimbwa kwabo wakati, “Awe nhulume, luchinyo lulwo lwalekejelwa.”<verse eid="LUK 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21" />Bakwali bomulawo nabaFalisi bakatanga kuzwibhuza beti, “Ani ndiyani yoyu unolebeleka ali efizha? Ndiyani angalekejela luchinyo kuzhe kwaMwali!”<verse eid="LUK 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22" />Jesu paakaziba mibhuzo yabo wakabashandula eti, “Ini muyeya yezwi mumyoyo yenu? <verse eid="LUK 5:22" /><verse number="23" style="v" sid="LUK 5:23" />Zwilelu ngezwipi, kuti, walekejelwa luchinyo lulwo, kana kuti, Milika ukwende? <verse eid="LUK 5:23" /><verse number="24" style="v" sid="LUK 5:24" />Kuti muzibe kuti Mwananhulumyana woNhu unesimba lyokulekejela luchinyo penyika, wakati kunhulume unabukosha, ndinoti kwauli, Nyamuka tola bushasha bubo unde kungumba kuko.”<verse eid="LUK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 5:25" />Pakale yopo wakanyamuka pambeli pabo bose, akanyamula bushasha paakabelilele akenda kusha kukwe ekuja Mwali. <verse eid="LUK 5:25" /><verse number="26" style="v" sid="LUK 5:26" />Bose bakachenama, bakaba nolutyo akale bakakuja Mwali, beti, “Nasi tabona zwinhu zwinochenamisa.”<verse eid="LUK 5:26" /></para>
  <para style="s">Jesu unoshoba Levi.</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mateo 9:9-13</ref>; <ref loc="MRK 2:13-17">Mako 2:13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27" />Kuva yopo wakabhuda akenda, akabona untelesi waluwhi ndiLevi, eligele pengumba yokutelesa wakati kwaali, “Nditobele.” <verse eid="LUK 5:27" /><verse number="28" style="v" sid="LUK 5:28" />Wakasiya zwose, akanyamuka akontobela.<verse eid="LUK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29" />Levi wakontila mabhiko makulwana mungumba yiye, kwakabeli nabatelesi banji nabamwe banhu pamwempela nabo belimukulya. <verse eid="LUK 5:29" /><verse number="30" style="v" sid="LUK 5:30" />BaFalisi nabakwali bakabelipo bakanyunyuta kubalayijwa babe beti, “Ini mulya nokunwa pamwempela nabatelesi akale nabachinyi?”<verse eid="LUK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31" />Jesu wakabashandula eti, “Yabo banabuchilo abatoda undapi, asi yabo banolwala, <verse eid="LUK 5:31" /><verse number="32" style="v" sid="LUK 5:32" />andijakezhila kwoshoba banhu babuya koga, bachinyi kuti beshanduke.”<verse eid="LUK 5:32" /></para>
  <para style="s">Umbhuzo pezhulu pokuzwiminya kulya</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mateo 9:14-17</ref>; <ref loc="MRK 2:18-22">Mako 2:18-22</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33" />Bakati kuna iye, “Balayijwa baJoni banozwiminya kulya mishaji minji, akale banonamata, akale balayijwa babaFalisi banota alo neebo, koga balayijwa babo banolya benwa.”<verse eid="LUK 5:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34" />Jesu wakati kwabali, “Mungata kuti balokokwa kumabhiko okulobola bezwiminye kulya ibo beli bose nondoboli na? <verse eid="LUK 5:34" /><verse number="35" style="v" sid="LUK 5:35" />Anooswika mazhuba undoboli paachootolwa pakati pabo ndipo pabachoozwiminya kulya mumazhuba yayo.”<verse eid="LUK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36" />Wakababuja akale unkwejaniso, “Apana unhu unocheka chibabi chechimbalo chipya kova ebiga pechimbalo chantolo, angodalo chipya chinoojeluka nokuti chipya achitookwendelana nechantolo. <verse eid="LUK 5:36" /><verse number="37" style="v" sid="LUK 5:37" />Akale apana unhu unodila iwaini impya mumikabo yantolo, angodalo iwaini impya ingakwamula mikabo yebhapata kova ikutuka nemikabo inova yapwachuka. <verse eid="LUK 5:37" /><verse number="38" style="v" sid="LUK 5:38" />Koga iwaini impya ilokwelela kubigwa mumikabo mipya. <verse eid="LUK 5:38" /><verse number="39" style="v" sid="LUK 5:39" />Akale apana unoda iwaini impya iye ava mukunwa iwaini yantolo, nokuti unoti, ‘Yantolo imbuya.’”<verse eid="LUK 5:39" /></para>
  <chapter eid="LUK 5" />
  <chapter number="6" style="c" sid="LUK 6" />
  <para style="s">UMbhuzo pezhulu pezhuba lyeSabata</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mateo 12:1-8</ref>; <ref loc="MRK 2:23-28">Mako 2:23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1" />Zwakatikana neSabata, ekwenda muminda mwakabeli nezwilyo, balayijwa babe bakatanga kupulula misholo yezwilyo bebukusha mumaboko abo, belya. <verse eid="LUK 6:1" /><verse number="2" style="v" sid="LUK 6:2" />Bamwe babaFalisi bakati, “Ini muta zwisinovumijwa kutiwa nezhuba lyeSabata?”<verse eid="LUK 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3" />Jesu wakashandula eti, “Amujakabala na zwakatiwa naDavidi paakabeli nenzhala iye nabamwe bakabeli naye, <verse eid="LUK 6:3" /><verse number="4" style="v" sid="LUK 6:4" />kuti wakangwina mungumba yaMwali, akatola zwinkwa zwilopilwa kunaMwali, zwisinovumilwa kulyiwa nonhukoga, kuzhe kwabatebuji chete. Wakalya, akapa yabo baakabeli nabo?”<verse eid="LUK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 6:5" />Wakati kwabali, “Mwananhulumyana woNhu ndiShe weSabata.”<verse eid="LUK 6:5" /></para>
  <para style="s">Unhulume unaluboko lulokokonyala.</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mateo 12:9-14</ref>; <ref loc="MRK 3:1-6">Mako 3:1-6</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6" />Limwe izhuba lyeSabata, paakangwina musinagogi elayija, kwakabeli nonhulume wakabeli noluboko lwokululyi lulokokonyala. <verse eid="LUK 6:6" /><verse number="7" style="v" sid="LUK 6:7" />Bakwali nabaFalisi bakaba bekalingilila kuti unochilisa na nezhuba lyeSabata kutila kuti bompe undandu. <verse eid="LUK 6:7" /><verse number="8" style="v" sid="LUK 6:8" />Koga iye wakaziba kuyeya kwabo, akati kunoyo nhulume unaluboko lulokokonyala, “Milika izha ume yopano.” Wakanyamuka, akama. <verse eid="LUK 6:8" /><verse number="9" style="v" sid="LUK 6:9" />Jesu wakati kwabali, “Ndomubhuza, zwimo mumulawo wezhuba lyeSabata na, kuta zwibuya kana kukubaja, kuchija bupenyu kana kubupalaja?” <verse eid="LUK 6:9" /><verse number="10" style="v" sid="LUK 6:10" />Wakalinga kunaibo bose, akati kwaali, “ Tambunuja luboko lulwo.” Wakata alo, luboko lulwe lukava lwakololoka.<verse eid="LUK 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 6:11" />Ibo bakazhalilwa nobukali, bakatanga kulangana kuti bangontani Jesu.<verse eid="LUK 6:11" /></para>
  <para style="s">Jesu unoshala baPositoli bali igumi nababili.</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mateo 10:1-4</ref>; <ref loc="MRK 3:13-19">Mako 3:13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12" />Munaya mazhuba wakenda pezhulu pedunhu kunonamata, wakanamata kunaMwali busiku bose. <verse eid="LUK 6:12" /><verse number="13" style="v" sid="LUK 6:13" />Palyakeja wakashoba balayijwa babe kwaali, akashala igumi linababili, akabashoba kuti “BaPositoli”, <verse eid="LUK 6:13" /><verse number="14" style="v" sid="LUK 6:14" />Simoni, wakonshoba kuti ndiPita, nonuna uwe Endulu, naJemusi naJoni, naFilipu, naBhatilomeyo <verse eid="LUK 6:14" /><verse number="15" style="v" sid="LUK 6:15" />naMateo, naTomasi, naJemusi mwananhulumyana waAlufiyasi, naSimoni unowhi uNsungwaji, <verse eid="LUK 6:15" /><verse number="16" style="v" sid="LUK 6:16" />naJudasi mwananhulumyana waJemusi, naJudasi Isikaliyoti, wakooncheta.<verse eid="LUK 6:16" /></para>
  <para style="s">Jesu unolayija nokulapa</para>
  <para style="r">(<ref loc="MAT 4:23-25">Mateo 4:23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17" />Wakabhuluka nabo, akama penyika ilotandabala eli negapo lyabalayijwa babe, negapo igulwana lyabanhu bakabeva munyika yose yeJudiya neJelusalema nokunyika yeTaya neSidoni jipo pelyo negungwa kuti bonwhilila nokulapwa mumalwaji abo. <verse eid="LUK 6:17" /><verse number="18" style="v" sid="LUK 6:18" />nayabo bakabeyangatiswa namalwaji nemipepo mibi bakezha bakachijwa neebo. <verse eid="LUK 6:18" /><verse number="19" style="v" sid="LUK 6:19" />Ibunga lyabanhu lyakakweja kuti liungume, nokuti kwakabhuda kwaali isimba lichilisa bose.<verse eid="LUK 6:19" /></para>
  <para style="s">Kushanta neshungu.</para>
  <para style="r">(<ref loc="MAT 5:1-12">Mateo 5:1-12</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20" />Jesu wakatokoloja balayijwa babe akati, Mulokombolelwa imwi basheti, nokuti bushe bwaMwali ngobwenu! <verse eid="LUK 6:20" /><verse number="21" style="v" sid="LUK 6:21" />Mulokombolelwa imwi munenzhala ngweno, nokuti moogunchwa! Mulokombolelwa imwi munolila feno, nokuti mooseka!<verse eid="LUK 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 6:22" />“Mulokombolelwa imwi kana banhu bemubenga, bemufizha, bemutuka, kana beti mubabi, pezhulu poMwananhulumyana woNhu! <verse eid="LUK 6:22" /><verse number="23" style="v" sid="LUK 6:23" />Shantani nelyo izhuba, shotokani nolushanto, nokuti indipo yenu ihulwana iko kudenga, nokuti yezwi ndizwo zwakatiwa namatategulu enu kubapolofeti.”<verse eid="LUK 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24" />Mayee! kunamwi mulofuma, nokuti mwakatambula kale kubokwa kwenu.<verse eid="LUK 6:24" /></para>
  <para style="q2">
    <verse number="25" style="v" sid="LUK 6:25" />Mayee! kunamwi muloguta feno, nokuti munoofa nenzhala.</para>
  <para style="q1" vid="LUK 6:25">Mayee! kunamwi munoseka ngweno, nokuti moolila nokufwikula.<verse eid="LUK 6:25" /></para>
  <para style="q2">
    <verse number="26" style="v" sid="LUK 6:26" />Mayee! kunamwi kana banhu bose beleba zwibuya namwi, nokuti matategulu abo bakata alo kubalebambeli bamaniepwa.<verse eid="LUK 6:26" /></para>
  <para style="s">Kuda babengi</para>
  <para style="r">(<ref loc="MAT 5:38-48">Mateo 5:38-48</ref>; <ref loc="MAT 7:12">7:12</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27" />Koga ndinoti kunamwi mulowhilila: Idani babengi benu, itani zwibuya kunayabo banomubenga, <verse eid="LUK 6:27" /><verse number="28" style="v" sid="LUK 6:28" />kombolelani yabo banomufhizha, munamatile yabo banomuyabisa. <verse eid="LUK 6:28" /><verse number="29" style="v" sid="LUK 6:29" />Kunoyo unokuloba pedama, umpe limwe akale, kunoyo unokutolela ijazi lilyo, umpe nechimbalo chicho. <verse eid="LUK 6:29" /><verse number="30" style="v" sid="LUK 6:30" />Ipa aani kanaani unokumbila chimwe chinhu kwauli; akale yoyo unotola chinhu chicho, usichitole kwaali akale. <verse eid="LUK 6:30" /><verse number="31" style="v" sid="LUK 6:31" />Zwamunoda kuti banhu bemutile, muzwitebo kwabali. <verse eid="LUK 6:31" /><verse number="32" style="v" sid="LUK 6:32" />Kana muda chete yabo banomuda, mobokelwani? Nokuti bachinyi banoda yabo banobada bo. <verse eid="LUK 6:32" /><verse number="33" style="v" sid="LUK 6:33" />Kana muta zwibuya kunabanomutila zwibuya, mungabokelwani? Nokuti nabachinyi banota alo. <verse eid="LUK 6:33" /><verse number="34" style="v" sid="LUK 6:34" />Kana mucheneka yabo bamunoziba kuti banomubwilizila, mungabokelwani biya? Bachinyi neebo banocheneka bachinyikwaina kuti bebabwilizile zwose. <verse eid="LUK 6:34" /><verse number="35" style="v" sid="LUK 6:35" />Koga! Idani babengi benu, batileni zwibuya, muchenekese musinolingilila kubwilizilwa akale, indipo yenu inooba ihulwana, akale mooba bana boyo Upezhuluzhulu, nokuti iye uneshe kunabo basinoboka bana bundimindimi. <verse eid="LUK 6:35" /><verse number="36" style="v" sid="LUK 6:36" />Ibani neshe saTate benu baneshe.<verse eid="LUK 6:36" /></para>
  <para style="s">Kutonga Bamwe</para>
  <para style="r">(<ref loc="MAT 7:1-5">Mateo 7:1-5</ref>)</para>
  <para style="m">
    <verse number="37" style="v" sid="LUK 6:37" />Bamwe, namwibo amutootongwa, musipe undandu bamwe, namwibo amutoopiwa undandu, lekejelani, namwibo munoolekejelwa, <verse eid="LUK 6:37" /><verse number="38" style="v" sid="LUK 6:38" />ipani, namwibo munoopiwa bo, akale zwilozhala, nonkwelo umbuyanana, zwilosindiilwa, zwifwashuka, zwasindwa kasa zwinoodilwa mumaboko enu. Chikweleso chamunoshingisa, ndichochichookweleswa kwamuli. <verse eid="LUK 6:38" /><verse number="39" style="v" sid="LUK 6:39" />Wakababuja unkwejaniso wokuti: “Ibhofu lingatungamila limwe ibhofu na? Mububili bwabo abangawile mudizwa na?” <verse eid="LUK 6:39" /><verse number="40" style="v" sid="LUK 6:40" />Undayijwa aatokubukila undayiji uwe, asi wose undayijwa kana apeja zwilayijo zwizwe, unoba sondayiji uwe. <verse eid="LUK 6:40" /><verse number="41" style="v" sid="LUK 6:41" />“Ini ubona kababi muzhisho lyomwanakwaina uwo, koga usinobona idanda muzhisho lilyo? <verse eid="LUK 6:41" /><verse number="42" style="v" sid="LUK 6:42" />Unolebelani kumwanakwaina uwo uti, ‘Mwanakwaina, ima ndikubhise kababi kaimo muzhisho lilyo’ iwi usinobona idanda limo muzhisho lilyo? Iwi unchengeji! Bhisa tangwa idanda limo muzhisho lilyo, ndipo pauchabona zwanana kuti ubhise kababi muzhisho lyomwanakwaina uwo.<verse eid="LUK 6:42" /></para>
  <para style="s">Unti nonchelo wawo</para>
  <para style="r">(<ref loc="MAT 7:16-20">Mateo 7:16-20</ref>; <ref loc="MAT 12:33-35">12:33-35</ref>)</para>
  <para style="pi">
    <verse number="43" style="v" sid="LUK 6:43" />Apana unti umbhodo unozwala unchelo umbi, kana kuti unti umbi uzwale unchelo umbuya, <verse eid="LUK 6:43" /><verse number="44" style="v" sid="LUK 6:44" />unti nonti unozibikana nonchelo wawo. Ihuyu ajitochelwa munti womiwha, kana kuchela unchelo wonzhambi mumiwha. <verse eid="LUK 6:44" /><verse number="45" style="v" sid="LUK 6:45" />Unhu umbuya unobhisa zwibhodo zwinova mukati momwoyo uwe, koga unhu umbi unobhisa zwibi zwiva mugombana lyomwoyo uwe umbi, nokuti mawhi onhu anova munazwizhele mumwoyo uwe.<verse eid="LUK 6:45" /></para>
  <para style="s">Babaki bengumba babili.</para>
  <para style="r">(<ref loc="MAT 7:24-27">Mateo 7:24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46" />“Ini mundishoba muti, ‘Tezi, Tezi’ koga musinota zwandinomubuja? <verse eid="LUK 6:46" /><verse number="47" style="v" sid="LUK 6:47" />Unhu wose unozha kwandili ewhilila mawhi angu, akale ewashingisa, ndomutondeja kuti unanga sani, <verse eid="LUK 6:47" /><verse number="48" style="v" sid="LUK 6:48" />unanga sonhu wakabaka ingumba yiye, wakacha, akamija akale akabakila pamwala, pakwakaswika makukazhame nevula inji yolwizi, yakaloba ingumba yeyo, koga aijakatubula kuyiteketesa ingumba nokuti yakabakabakwa zwibuya. <verse eid="LUK 6:48" /><verse number="49" style="v" sid="LUK 6:49" />Asi yoyo unowha esinota, unanga sonhu wakabaka ingumba yiye pasina chimisikilo, lwizi lwakailoba, lukaisusumila pasi, yakakolomoka nokukambija ikapalajika zwikulwana.”<verse eid="LUK 6:49" /></para>
  <chapter eid="LUK 6" />
  <chapter number="7" style="c" sid="LUK 7" />
  <para style="s">Jesu unochilisa unshingi, wonkulwana wabalwi babaLoma</para>
  <para style="r">(<ref loc="MAT 8:5-13">Mateo 8:5-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1" />Paakapeja zwose kuleba zwaakabeda kuti banhu bewhe, wakangwina muKapenaume. <verse eid="LUK 7:1" /><verse number="2" style="v" sid="LUK 7:2" />Untungamili wezana lyabalwi behondo, wakabeli nonshingi unodikana kwaali wakabelwalila kufa. <verse eid="LUK 7:2" /><verse number="3" style="v" sid="LUK 7:3" />Paakawha nezwaJesu, wakatuma bakulwana bamaJuda kuti benoonkumbila kuti ezhe kwochilisa unshingi uwe. <verse eid="LUK 7:3" /><verse number="4" style="v" sid="LUK 7:4" />Pabakaswika kunaJesu, bakanombweta kasa beti, “Ulokwelela kasa kubhanchwa namwi, <verse eid="LUK 7:4" /><verse number="5" style="v" sid="LUK 7:5" />nokuti unoda inyika yedu akale ndiye wakatibakila isinagogi.”<verse eid="LUK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 7:6" />Jesu wakenda nabo. Pakati abapelyo nengumba, untungamili wabalwi wakatumila bakwaina babe kwaali kuti benoti, “She musizwinyaje nokuti anditokwelela kuti mungwine mungumba yangu; <verse eid="LUK 7:6" /><verse number="7" style="v" sid="LUK 7:7" />nokudalo ndizwo ndayeya kuti ndizhe imi kunamwi.Koga ilebani iwhi chete unshingi wangu echijwe. <verse eid="LUK 7:7" /><verse number="8" style="v" sid="LUK 7:8" />Nokuti imibo ndinhu upo pasi pomulawu, ndina balwi baipo pasi pangu; kuna umwe ndinoti, ‘Inda’ unonda, ndingoti kunomwe, ‘Izha’ unozha, ndikati kunzike wangu, ‘Ita yechi’ unota.”<verse eid="LUK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9" />Jesu paakawha mawhi yaya wakachenama, akachebuka, akati kubanhu bakabontobela, “Ndinomubuja andijanu ndawana kudimbwa kukulugulu kwakadai kana muIzilayeli.”<verse eid="LUK 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 7:10" />Bakati yabo bakabatumwa pabakabwilila kungumba bakawana unshingi wakabelwala, achila.<verse eid="LUK 7:10" /></para>
  <para style="s">Jesu unomusa mwananhulumyana wenchilikaji.</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11" />Kuva yopo wakenda kuguta lyeNaini epelekejwa nabalayijwa babe pamwempela nabanhu banji. <verse eid="LUK 7:11" /><verse number="12" style="v" sid="LUK 7:12" />Paakati aba pelyo neshubo lyeguta, wakashangana nabanhu bekanyamula unhu wakaba afa, wakabeli mwananhulumyana umwempela wamai babe, ibo belinchilikaji, banhu banji bomuguta bekwenda naye. <verse eid="LUK 7:12" /><verse number="13" style="v" sid="LUK 7:13" />She paakombona wakonwhila ishe akati kuna iye, “Usilile.” <verse eid="LUK 7:13" /><verse number="14" style="v" sid="LUK 7:14" />Wakenda pelyo akaguma bushasha, banyamuli bakama. Iye akati, “Awe nzhuzha, ndinoti kwauli, imuka.” <verse eid="LUK 7:14" /><verse number="15" style="v" sid="LUK 7:15" />Unzhuzha wakaba akafa wakamuka akagala, akatanga kulebeleka. Iye akompila kuna amai babe.<verse eid="LUK 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16" />Banhu bose bakabanolutyo, bakakuja Mwali beti, “Undebambeli waMwali unkulwana waswika pakati pedu, Mwali washanyila banhu babe!”<verse eid="LUK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 7:17" />Impuwo yiye yakawhikana kunyika yose yeJudiya namatunhu akabhatana nayo.<verse eid="LUK 7:17" /></para>
  <para style="s">Batumwa baJoni umbhabhatizi.</para>
  <para style="r">(<ref loc="MAT 11:2-19">Mateo 11:2-19</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18" />Balayijwa baJoni bakombuja iye zwose yezwi zwinhu. <verse eid="LUK 7:18" /><verse number="19" style="v" sid="LUK 7:19" />Joni wakashoba balayijwa babe babili akabatuma kunaShe, kunombhuza kuti, “Ndiwi ukumuzha na, kana tilingilile umwe?”<verse eid="LUK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20" />Pabakaswika kuna iye, bakati, “Tatumwa kwobhuza kwauli naJoni uMbhabhatizi kuti, ‘Ndiwi ukumuzha na?’ Kana tilingilile umwe?”<verse eid="LUK 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21" />Panoyo unshaji wakachilisa banhu banji mumalwaji abo, zwinobanyaja, nemipepo mibi, akata mapofu manji, kuti bebone. <verse eid="LUK 7:21" /><verse number="22" style="v" sid="LUK 7:22" />Wakashandula akati, “Indani munobuja Joni zwimwabona nezwimwawha, mapofu amubona, makosha amukwenda, bana mapelembuji bamushampulujwa, nabanenzebe jisinowha, bamuwha, nabafi bakumumuswa akale indebo imbuya imubhaunulwa kubasheti. <verse eid="LUK 7:22" /><verse number="23" style="v" sid="LUK 7:23" />Ulokombolelwa usinonyetejwa nami.”<verse eid="LUK 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24" />Pabakenda batumwa baJoni, wakatanga kulungulula nezwaJoni kubanhu eti, “Mwakenda mugwegulu kunobonani? Idete liteketeswa nebhepo na? <verse eid="LUK 7:24" /><verse number="25" style="v" sid="LUK 7:25" />Mwakenda kunobonani? Unhulume ulombala zwimbalo zwibhodo na? Banombala ali akale belalama bupenyu bwopezhulu banowanika mungumba jamatezi. <verse eid="LUK 7:25" /><verse number="26" style="v" sid="LUK 7:26" />Biya mwakamunda kunobonani? Undebambeli waMwali na? Eya, ndinomubuja, zwinopinda undebambeli. <verse eid="LUK 7:26" /><verse number="27" style="v" sid="LUK 7:27" />Ndiye wakakwalwa nezwizwe kuwhi, ‘Ndootuma untumwa wangu pambeli papo, unookungubula inzila yiyo.’ <verse eid="LUK 7:27" /><verse number="28" style="v" sid="LUK 7:28" />Ndinomubuja pakati pabo bose bakazwalwa nabechinhukaji apana unkulwana kupinda Joni, koga yoyo untukutuku mubushe bwaMwali, ndiye unkulwana kupinda iye.”<verse eid="LUK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29" />Pabakawha zwose yezwi, bose banhu nabatelesi, bakakuja Mwali nokuti bakabhabhatizwa nombhabhatizo waJoni, <verse eid="LUK 7:29" /><verse number="30" style="v" sid="LUK 7:30" />koga baFalisi nabasilawu bakalamba kubhabhatizwa sokulonga kwaMwali.<verse eid="LUK 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31" />“Ani biya banhu bechizekululu changweno ndobakwejanisa neni, bananga sani? <verse eid="LUK 7:31" /><verse number="32" style="v" sid="LUK 7:32" />Bananga sabana batukutuku bagele pamusika beshomejana beti; ‘Takamulijila bundimbwa, koga amujakazana, takamukwimbila jedilwe koga amujakalila.’ <verse eid="LUK 7:32" /><verse number="33" style="v" sid="LUK 7:33" />Joni umbhabhatizi wakezha esinolya chinkwa kana kunwa iwaini, koga mwakati unanedimoni. <verse eid="LUK 7:33" /><verse number="34" style="v" sid="LUK 7:34" />Mwananhulumyana wonhu waswika, elya nokunwa, koga munoti, ‘Lingani yoyu unhulume! Unolyisa kasa akale unkolwi, unkwaina wabatelesi nabachinyi!’ <verse eid="LUK 7:34" /><verse number="35" style="v" sid="LUK 7:35" />Koga buchenjevu bwakaboneka buli bwakalulama nabana babo bose.”<verse eid="LUK 7:35" /></para>
  <para style="s">Jesu elikungumba yaSimoni unFalisi</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36" />Umwe wabaFalisi wakakoka Jesu kuti bende benolya bose, nokudalo wakenda mungumba yomFalisi akagala kutebuli. <verse eid="LUK 7:36" /><verse number="37" style="v" sid="LUK 7:37" />Kwakangwina unhukaji waluba elalama bupenyu bwomuluchinyo muguta yeli, paakaziba kuti Jesu unolayila mungumba yomFalisi, wakenda ekasenga ifukwana yamafuta obunde, <verse eid="LUK 7:37" /><verse number="38" style="v" sid="LUK 7:38" />elimile kushule mwaJesu elikumakumbo elila, wakabukusha mishoji yiye yakabedonela pamakumbo aJesu eshingisa masusu awe, kova emyonta makumbo aJesu akonguba mafuta. <verse eid="LUK 7:38" /><verse number="39" style="v" sid="LUK 7:39" />umfalisi wakabakoka Jesu ebona yezwi, wakayeya nezwomumwoyo uwe eti, “Ngana unhu yoyu eli undebambeli waMwali, waluziba kuti yoyu unhu ukumuunguma ndiyani akale ulichini, nokuti unchinyi.”<verse eid="LUK 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40" />Jesu wakonshandula akati, “Simoni, pana zwandikumuda kuleba kunawi.”</para>
  <para style="p" vid="LUK 7:40">Iye wakashandula eti, “Lebani Ndayiji.”<verse eid="LUK 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41" />“Kwakaba kuli noncheneki wakacheneka banhulume babili, Umwe wakonchenekesa madinali anokwana mazana mashanu, umwe akonchenekesa madinari makumi mashanu. <verse eid="LUK 7:41" /><verse number="42" style="v" sid="LUK 7:42" />Bakakonwa kulipa chikwelete bose, uncheneki akabalekejela mububili bwabo. Ndiyani biya pakati pabo uchoonda kasa?”<verse eid="LUK 7:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43" />Simoni wakashandula eti, “Ndinobimba kuti yoyo wakalekejelwa elinemali inji.”</para>
  <para style="p" vid="LUK 7:43">Jesu wakati, “Ndimo kasa.” <verse eid="LUK 7:43" /><verse number="44" style="v" sid="LUK 7:44" />Jesu wakachingunuka akalinga kunhukaji akati kuna Simoni, “Simoni, uumbweni yoyu unhukaji? Ndangwina mungumba yiyo koga aujandipa ivula kuti ndishambe makumbo angu, koga iye wanyolopisa makumbo angu nemishoji yiye akabukusha namasusu awe. <verse eid="LUK 7:44" /><verse number="45" style="v" sid="LUK 7:45" />Iwi aujandimyonta, koga iye kuvila pandangwina wabemyonta pamakumbo angu pose. <verse eid="LUK 7:45" /><verse number="46" style="v" sid="LUK 7:46" />Iwi aujaguba unsholo wangu namafuta, koga iye waguba makumbo angu namafuta anonhuwilila. <verse eid="LUK 7:46" /><verse number="47" style="v" sid="LUK 7:47" />Nokudalo luchinyo lulwe lunji, lwalekejelwa nokuti watondeja kuda lukulwana, asi yoyo unolekejelwa zwishoma, neebo unotondeja ludo lushoma.”<verse eid="LUK 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48" />Wakati kunhukaji, “Luchinyo lulwo lwalekejelwa.”<verse eid="LUK 7:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49" />Yabo bakaba beli naye belya petebuli bakatanga kulebeleka pakati pabo beti, “Ndiyani yoyu unota kulekejela luchinyo?”<verse eid="LUK 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50" />Wakati kunhukaji, “Kudimbwa kukwo kwakuchija, inda mulunyalalo.”<verse eid="LUK 7:50" /></para>
  <chapter eid="LUK 7" />
  <chapter number="8" style="c" sid="LUK 8" />
  <para style="s">Mamai okuGalili anotobela Jesu</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1" />Eva yopo wakangwina mumakuta nomumizi ebhaunula akale esuma iNdebo iMbuya yobushe bwaMwali. Balayijwa babe bali igumi nababili baluba naye, <verse eid="LUK 8:1" /><verse number="2" style="v" sid="LUK 8:2" />akale waluba nabamwe bechinhukaji bakaba babhiswa mipepo mibi namalwaji; naMariya walushobwa ewhi Magadalena, wakaba abhiswa mipepo mibi mishanu inamibili. <verse eid="LUK 8:2" /><verse number="3" style="v" sid="LUK 8:3" />NaJohana unkaji waKuza, umbhati wengumba yaHelodi, naSusana nabamwe banji bakaba bobhancha eli nabalayijwa munazwose zwabakabeshayiwa.<verse eid="LUK 8:3" /></para>
  <para style="s">Unkwejaniso wombyali</para>
  <para style="r">(<ref loc="MAT 13:1-9">Mateo 13:1-9</ref>; <ref loc="MRK 4:1-9">Mako 4:1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4" />Banhu banji pabakezha bakabungana kwaali, beva mumakuta alosiyanasiyana, wakalebeleka nonkwejaniso akati,<verse eid="LUK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 8:5" />“Undimi wakenda kunobyala imbeyu yiye, paakamezha, imwe yakambwelela kumbali kwenzila ikatobwa, ikalyiwa nenyuni jedenga. <verse eid="LUK 8:5" /><verse number="6" style="v" sid="LUK 8:6" />Imwe yakambwelela pamwala, yakamela, ikahwima nokushayiwa mwando. <verse eid="LUK 8:6" /><verse number="7" style="v" sid="LUK 8:7" />Imwe yakambwelela panamiwha, ikakubuka pamwe nemiwha, ikamanikijwa. <verse eid="LUK 8:7" /><verse number="8" style="v" sid="LUK 8:8" />Imwe yakambwelela muvu ibuyanana, yakakubuka, ikazwala izana lyonchelo .” Paakapeja kuleba yezwi wakashomeja akati, “Unenzebe ngewhe.” Zwinangwa zwemikwejaniso.<verse eid="LUK 8:8" /></para>
  <para style="s">Chinangwa cheMikwejaniso</para>
  <para style="r">(<ref loc="MAT 13:10-17">Mateo 13:10-17</ref>; <ref loc="MRK 4:10-12">Mako 4:10-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9" />Balayijwa babe pabakombhuza kuti unkwejaniso yoyu unolebani, <verse eid="LUK 8:9" /><verse number="10" style="v" sid="LUK 8:10" />wakashandula eti, “Imwi mulopiwa kuziba isiswa lyobushe bwaMwali, koga bamwe banotilwa mikwejaniso chete kutila kuti bebone asi besibonesese, bewhe asi besiwhisise.”<verse eid="LUK 8:10" /></para>
  <para style="s">Jesu unopandulula ukwejaniso wombyali.</para>
  <para style="r">(<ref loc="MAT 13:18-23">Mateo 13:18-23</ref>; <ref loc="MRK 4:13-20">Mako 4:13-20</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11" />“Yezwi ndizwo zwinolebwa nonkwejaniso: Imbeyu ndilyo iwhi lyaMwali. <verse eid="LUK 8:11" /><verse number="12" style="v" sid="LUK 8:12" />Imbeyu yokumbali kwenzila banhu banoliwha, kova Satani eswika elibhisa iwhi mumyoyo yabo, kutila kuti besilidimbwe, nokuti banosokochijwa. <verse eid="LUK 8:12" /><verse number="13" style="v" sid="LUK 8:13" />Imbeyu yopamwala, banhu banoti bangoliwha iwhi, banolitambula nolushanto, koga abana miji, banodimbwa kwonshaji umfupi, asi bangokwejwa banomuka nokulilamba. <verse eid="LUK 8:13" /><verse number="14" style="v" sid="LUK 8:14" />Imbeyu yakambwelela pamiwha ndibo yabaya bakaliwha, asi mubupenyu banokonejwa nokunakilijwa, ifuma nezwinonakilija penyika, ndizwo besinozwala michelo isinokubuka. <verse eid="LUK 8:14" /><verse number="15" style="v" sid="LUK 8:15" />Imbeyu yakambwelela muvu ibuyanana ndibo banhu yabaya bana myoyo mibuya inobimbika, banoti bangoliwha iwhi, banolibhata bolilondota besima nalyo kova bezwala michelo.”<verse eid="LUK 8:15" /></para>
  <para style="s">Unkwejaniso weChimuniko</para>
  <para style="r">(<ref loc="MRK 4:21-25">Mako 4:21-25</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16" />“Unhu aangatutumise chimuniko kova echitibhikila nendyilo kana kuchibiga pasi pombheda, asi unochibiga palonabuka kutila kuti banhu bemunikilwe kana bengwina mungumba.<verse eid="LUK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 8:17" />“Zwose zwilosisika zwinoobhudila pachena, zwose zwilofumikwa zwinoofumulwa.<verse eid="LUK 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 8:18" />“Chenjelani kuti mowhilila chini, nokuti yoyo unanazwo unoopamhijilwa, asi yoyo usina, unootolelwa nezwo zwishoma zwanoyeyesela kuti unanazwo .”<verse eid="LUK 8:18" /></para>
  <para style="s">Amai baJesu nabanuna babe.</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mateo 12:46-50</ref>; <ref loc="MRK 3:31-35">Mako 3:31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19" />Amai babe nabanuna babe bakezha bompota, bakakonwa kumbona nokuti pezhulu pebunga lyabanhu. <verse eid="LUK 8:19" /><verse number="20" style="v" sid="LUK 8:20" />Wakabujwa kuti, “Amai babo nabanuna babo bamile pazhe bakumuda kukubona.”<verse eid="LUK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21" />Koga wakati kwabali, “Amai bangu nabanakwaina bangu, ndiyabo banowha iwhi lyaMwali, kova beta zwalinoleba.”<verse eid="LUK 8:21" /></para>
  <para style="s">Jesu unonyalaja ibhepo muGungwa</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mateo 8:23-27</ref>; <ref loc="MRK 4:35-41">Mako 4:35-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22" />Limwe izhuba wakatanha mubwato nabalayijwa babe, akati kwabali, “Ngativubukeni tinde museli mwegandwegulu.” Bakangwina bakatanga lwendo, <verse eid="LUK 8:22" /><verse number="23" style="v" sid="LUK 8:23" />bakati bechinotanga lwendo lwabo, iye wakabhatwa nehope akalala. Kwakaswika ibhepo igulwana linegampo, ivula ikatanga kungwina mubwato, bose bakaba mugubaji. <verse eid="LUK 8:23" /><verse number="24" style="v" sid="LUK 8:24" />Bakenda kwaali bakomusa beti, “Tezi, Tezi, tabolopalala!”</para>
  <para style="p" vid="LUK 8:24">Iye wakamuka, akakalalila ibhepo nevula yakabeli nobukali, zwose zwikava zwama kukaba nokunyalala. <verse eid="LUK 8:24" /><verse number="25" style="v" sid="LUK 8:25" />Wakati kwabali, “Kuponi kudimbwa kwenu biya?”</para>
  <para style="p" vid="LUK 8:25">Asi ibo bakakankabala bakatya, bakabhuzana beti, “Angaba ani yoyu unolaya ibhepo linabukali nevula, hezwo zwinonwhilila?”<verse eid="LUK 8:25" /></para>
  <para style="s">Jesu unolapa unhu unamadimoni</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mateo 8:28-34</ref>; <ref loc="MRK 5:1-20">Mako 5:1-20</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26" />Bakaswika kunyika yeGenesaleti ilolingana neGalili <verse eid="LUK 8:26" /><verse number="27" style="v" sid="LUK 8:27" />Paakati atoba pasi, wakachingamijwa nonhulume waluba namadimoni eva muguta, wakabesinombala akale esinogala pengumba, asi egala kumakumbu. <verse eid="LUK 8:27" /><verse number="28" style="v" sid="LUK 8:28" />Wakati abona Jesu, wakakwiila kova embwela mbeli kukwe, akashomeja eti, “Unani nami na Jesu Mwananhulumyana waMwali wopeZhuluzhulu? Ndakombelela usindijiije.” <verse eid="LUK 8:28" /><verse number="29" style="v" sid="LUK 8:29" />Wakaleba yezwi nokuti Jesu wakaba abuja umpepo umbi kuti ubhude munoyo unhulume. (Wakabegala ekabhatwa nedimoni, kojoba maboko namakumbo awe akabegala ekasungwa neketani koga wakabedubula iketani idimoni liunsenga mugwegulu).<verse eid="LUK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30" />Jesu wakombhuza eti, “Unowhi ani izina lilyo?”</para>
  <para style="p" vid="LUK 8:30">Iye wakati, “Ndinowhi Ligiyoni,” nokuti wakabangwinwa namadimoni manji. <verse eid="LUK 8:30" /><verse number="31" style="v" sid="LUK 8:31" />Iwo akombweta kuti esiwatatile kubugalo bunomila kusinojiba.<verse eid="LUK 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32" />Kwaluba nedanga igulwana lyengulube jakaba jichela mumbali mwedunhu, iwo akombweta kuti ewavumije engwine munaijo. Wakaavumija. <verse eid="LUK 8:32" /><verse number="33" style="v" sid="LUK 8:33" />Madimoni akabhuda munoyo unhulume, akangwina mungulube, jakalabukila kubhilipili, jikanombwelela mugungwa, jikanonwila undondwe jikafa.<verse eid="LUK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34" />Balyisi bengulube pabakabona yezwi zwitika, bakatizha bakanobuja bokuguta nabanhu bomumizi. <verse eid="LUK 8:34" /><verse number="35" style="v" sid="LUK 8:35" />Banhu bakenda kunobona yezwo zwakabatikana, pabakaswika kunaJesu, bakawana unhu wakasiyiwa nemipepo yamadimoni eligele pelyo naJesu ekambala akale imhengo japela, yezwi zwakabatyisa. <verse eid="LUK 8:35" /><verse number="36" style="v" sid="LUK 8:36" />Yabo bakazwibona bakalungululila banhu kuti yoyu unhu wakachijwa chini. <verse eid="LUK 8:36" /><verse number="37" style="v" sid="LUK 8:37" />Bose banhu bomubugalo bweGenesaleti yobo bakonkumbila kuti ebhude ende nokuti bakaba nolutyo, iye wakangwina mubwato akabwilila. <verse eid="LUK 8:37" /><verse number="38" style="v" sid="LUK 8:38" />Unhulume wakabhiswa madimoni wakakumbila kuti bende bose,</para>
  <para style="p" vid="LUK 8:38">Asi iye wakombwiliza ontuma, eti, <verse eid="LUK 8:38" /><verse number="39" style="v" sid="LUK 8:39" />“Bwilila kusha kuko, unobabuja zwiwatilwa naMwali.”</para>
  <para style="p" vid="LUK 8:39">Iye wakenda muguta epupula zwose zwaakatilwa naJesu.<verse eid="LUK 8:39" /></para>
  <para style="s">Kumuswa kwomwananhukajana waJailos nokulapwa kwonhukaji wakabekunga ilopa</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mateo 9:18-26</ref>; <ref loc="MRK 5:21-43">Mako 5:21-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40" />Jesu paakabwilila museli mwegungwa, banhu bakontambula nolushanto nokuti bose bakabakomilila. <verse eid="LUK 8:40" /><verse number="41" style="v" sid="LUK 8:41" />Kwakaswika unhulume waluwhi Jayilosi, eli untungamili weSinagogi, wakazwiwigila pamakumbo aJesu, akombweta kuti ende kungumba yiye, <verse eid="LUK 8:41" /><verse number="42" style="v" sid="LUK 8:42" />nokuti mwananhukajana uwe umwempela chete, wakabeli namakole igumi linamabili okuzwalwa, wakaba alobofa.</para>
  <para style="p" vid="LUK 8:42">Paakabekwenda, banhu bakabomanikija. <verse eid="LUK 8:42" /><verse number="43" style="v" sid="LUK 8:43" />Unhukaji wakabekunga ilopa elwala kwamakole igumi lina mabili, wakabakona kubalapi, <verse eid="LUK 8:43" /><verse number="44" style="v" sid="LUK 8:44" />wakezha nokushule kukwe, akaguma lupetelo lwechimbalo chiche, pakalepo ilopa lyakava lyama kukunga. <verse eid="LUK 8:44" /><verse number="45" style="v" sid="LUK 8:45" />Jesu wakati, “Ndiyani wandiguma?”</para>
  <para style="p" vid="LUK 8:45">Pabakalamba bose, Pita wakati, “Tezi, seni banhu bamususumana, ndibo bamumumanikija.”<verse eid="LUK 8:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46" />Koga Jesu wakati, “Kuna unhu wandiguma, nokuti ndaliwha isimba libhuda mwandili.” <verse eid="LUK 8:46" /><verse number="47" style="v" sid="LUK 8:47" />Paakabona kuti wazibikana, unhukaji yoyu wakenda kunaiye eteketa akazwiwigila pamakumbo aJesu, elungulula pakati pabanhu bose kuti wakongumilani akale nokuchila kukwe pakalepo. <verse eid="LUK 8:47" /><verse number="48" style="v" sid="LUK 8:48" />Wakati kwaali, “Mwananhukajana kudimbwa kukwo kwakuchilisa, inda nolunyalalo.”<verse eid="LUK 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49" />Echinolebeleka alo, kwakaswika untumwa eva kungumba yombhati wemishingo musinagogi eti, “Mwananhukajana wapalala, musinyaje.”<verse eid="LUK 8:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50" />Koga Jesu pakazwiwha yezwi wakonshandula eti, “Usitye, iba nokudimbwa chete unochila.”<verse eid="LUK 8:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51" />Paakaswika pengumba yeyo, aajakavumija banhu banji kuti bengwine naye kuzhe kwaPita, naJoni, naJemusi, natate namai bomwananhukajana. <verse eid="LUK 8:51" /><verse number="52" style="v" sid="LUK 8:52" />Bose baluba belila, lilidilwe, asi iye wakati, “Musilile aajafa ulele.”<verse eid="LUK 8:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53" />Bose bakonseka, nokuti bakabeziba kuti wafa. <verse eid="LUK 8:53" /><verse number="54" style="v" sid="LUK 8:54" />Wakombhata luboko unsichana, akoonshoba eti, “Awe mwana, imuka!” <verse eid="LUK 8:54" /><verse number="55" style="v" sid="LUK 8:55" />Umpepo uwe wakabwilila mwaali, akamuka, akamilika pakalepo. Wakabuja banhu kuti bompe kulya. <verse eid="LUK 8:55" /><verse number="56" style="v" sid="LUK 8:56" />Zwakabachenamisa bazwali babe, asi iye wakababuja kuti besibuje kana aani nezwakabatikana.<verse eid="LUK 8:56" /></para>
  <chapter eid="LUK 8" />
  <chapter number="9" style="c" sid="LUK 9" />
  <para style="s">Jesu unotuma balayijwa babe gumi namabili</para>
  <para style="r">(<ref loc="MAT 10:5-15">Mateo 10:5-15</ref>; <ref loc="MRK 6:7-13">Mako 6:7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1" />Wakashoba pamwempela balayijwa igumi nababili, akabapa isimba nobukulwana bwokubhisa wose madimoni nokulapa malwaji, <verse eid="LUK 9:1" /><verse number="2" style="v" sid="LUK 9:2" />akale wakabatuma kunobhaunula bushe bwaMwali nokulapa banolwala. <verse eid="LUK 9:2" /><verse number="3" style="v" sid="LUK 9:3" />Wakati kwabali, “Musinyamule kana chinhu mulwendo lwenu, kana kadozo, kana chikwama, kana chokulya, kana imali; musinde nezwimbalo zwibili. <verse eid="LUK 9:3" /><verse number="4" style="v" sid="LUK 9:4" />Ingumba ipi zwayo yamunongwina, galani mwakale kuswikila mujine mukwende. <verse eid="LUK 9:4" /><verse number="5" style="v" sid="LUK 9:5" />Kuna yabo basinomutambula, kuhumulani ihuluba kumakumbo pakubhuda kwenu munsha yoyo, bube busumikiji kwabali.”<verse eid="LUK 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 9:6" />Bakanyamuka, bakakwendela mizi minji bebhaunula iNdebo iMbuya, belapa kumapazu ose.<verse eid="LUK 9:6" /></para>
  <para style="s">Bukukutu bwaHelodi</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mateo 14:1-12</ref>; <ref loc="MRK 6:14-29">Mako 6:14-29</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7" />Helodi untongi wakawha zwose yezwi zwakabetikana, akakankabala nokuti bamwe bakaba beti ndiJoni wamuka mubafi, <verse eid="LUK 9:7" /><verse number="8" style="v" sid="LUK 9:8" />bamwe bo beti ndiElija waboneka akale bamwe beti umwe wabalebambeli baMwali wantolo wamuka akale. <verse eid="LUK 9:8" /><verse number="9" style="v" sid="LUK 9:9" />Helodi wakati, “Joni ndakondubula unchibha, ani biya ndiyani yoyo undimuwha eta zwakadai?” Wakashaka kuti ombone.<verse eid="LUK 9:9" /></para>
  <para style="s">Jesu unopa kulya zwiulu zwishanu</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mateo 14:13-21</ref>; <ref loc="MRK 6:30-44">Mako 6:30-44</ref>; <ref loc="JHN 6:1-14">Joni 6:1-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10" />Bapositoli bakabuya bakombuja zwose zwibakaba bata. Wakabatola akenda nabo beliboga kuguta linowhi Bhetisaida. <verse eid="LUK 9:10" /><verse number="11" style="v" sid="LUK 9:11" />Ibunga lyabanhu palyakazwiwha yezwi, lyakontobela, wakabatambula akababuja nezwobushe bwaMwali, akalapa yabo bakaba beshaka kuchijwa.<verse eid="LUK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12" />Kwakati kwaba madekwana, balayijwa babe igumi nababili bakezha kwaali bakati, “Lekeja banhu bende kumizi nokumisha ipo pelyo kuti bewane kulya nokuti yokuno timo mubugalo musina banhu.”<verse eid="LUK 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13" />Koga iye wakati kwabali, “Imwi bapeni zwokulya.” Ibo bakati, “Tina zwinkwa zwishanu nehobe imbili chete. Kuzhe kwokuti tinobatengela kulya banhu bose yaba.” <verse eid="LUK 9:13" /><verse number="14" style="v" sid="LUK 9:14" />Banhulume bakabeswika zwiulu zwishanu.</para>
  <para style="p" vid="LUK 9:14">Wakati kubalayijwa babe, “Babujeni begale pasi muzwikapo zwabanhu makumi mashanu.”<verse eid="LUK 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 9:15" />Bakata alo bakagajika banhu bose pasi. <verse eid="LUK 9:15" /><verse number="16" style="v" sid="LUK 9:16" />Wakatola zwinkwa zwishanu nehobe imbili, akalinga kudenga, akaboka Mwali, akamedula, akapa balayijwa babe kuti bekobele banhu. <verse eid="LUK 9:16" /><verse number="17" style="v" sid="LUK 9:17" />Bakalya bakaguta bose. Bakakolela zwipemu zwakasala zwakazhaja zwitundu igumi lina zwibili.<verse eid="LUK 9:17" /></para>
  <para style="s">Pita Unolebeleka Kudimbwa kukwe kunaJesu</para>
  <para style="r">(<ref loc="MAT 16:13-19">Mateo 16:13-19</ref>; <ref loc="MRK 8:27-29">Mako 8:27-29</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18" />Zwakatikana kuti elimukunamata eli ega kumbali, eli nabalayijwa babe, wakababhuza eti, “Banhu banoti ndimi aani?”<verse eid="LUK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19" />Bakashandula beti, “Banoti ndiwi Joni umbhabhatizi, koga bamwe banoti ndiwi Elija nabamwe bo banoti ndimi umwe wabalebambeli baMwali bantolo wamuka.”<verse eid="LUK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20" />Wakati kwabali, “Ani imwi munoti ndimi aani?” Pita wakashandula eti, “Ndiwi Kristo waMwali.”<verse eid="LUK 9:20" /></para>
  <para style="s">Jesu unolebeleka nezwolufu lulwe</para>
  <para style="r">(<ref loc="MAT 16:20-28">Mateo 16:20-28</ref>; <ref loc="MRK 8:30-9:1">Mako 8:30—9:1</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21" />Wakabalaya kuti besibuje umwe nezwi, <verse eid="LUK 9:21" /><verse number="22" style="v" sid="LUK 9:22" />eti, “Mwananhulumyana woNhu ulokwelela kuyabula muna zwinji, akale elambwe nabakulugulu nabatebuji bakulwana nabakwali, unoobulayiwa, nezhuba lyatatu unoomuswa .”<verse eid="LUK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23" />Wakati kwabali bose, “Kana unhu eda kunditobela, ngezwilambe, etole unchinjikwa uwe mazhuba ose, enditobele. <verse eid="LUK 9:23" /><verse number="24" style="v" sid="LUK 9:24" />Nokuti wose unoda kuchija bupenyu bubwe unobulashikilwa, asi yoyo unolashikilwa nobupenyu bubwe pezhulu pangu unoochijwa. <verse eid="LUK 9:24" /><verse number="25" style="v" sid="LUK 9:25" />Zwinobhanchani kuti unhu ewane inyika yose, iye nokukwe ezwipalaja? <verse eid="LUK 9:25" /><verse number="26" style="v" sid="LUK 9:26" />Nokuti aani naani uneshoni nami namawhi angu, Mwananhulumyana woNhu unoontila ishoni, paachoozha mulukujo lulwe, nomulukujo lwaTate nenhumwa jaMwali inchena. <verse eid="LUK 9:26" /><verse number="27" style="v" sid="LUK 9:27" />Ndinolebesa kwamuli, baipo bamwe benu pakale yopano bachabona bushe bwaMwali besanhu bafa.”<verse eid="LUK 9:27" /></para>
  <para style="s">Kushanduka kwaJesu</para>
  <para style="r">(<ref loc="MAT 17:1-8">Mateo 17:1-8</ref>; <ref loc="MRK 9:2-8">Mako 9:2-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28" />Kwapinda mazhuba mashanu ana matatu zwalebwa yezwi, wakatola Pita, naJoni naJemusi akenda nabo kudunhu kunonamata. <verse eid="LUK 9:28" /><verse number="29" style="v" sid="LUK 9:29" />Wakati elimukunamata, chiso chiche chakashanduka nezwimbalo zwizwe zwakangaima nobuchena. <verse eid="LUK 9:29" /><verse number="30" style="v" sid="LUK 9:30" />Pakalepo kwakaboneka banhulume babili, Mozesi naElija belebeleka naye, <verse eid="LUK 9:30" /><verse number="31" style="v" sid="LUK 9:31" />bakaboneka belimukungaima, belebeleka nezwokukwenda kukwe kuti kwakabeli pelyo kuti kunozhajikija muJelusalema. <verse eid="LUK 9:31" /><verse number="32" style="v" sid="LUK 9:32" />Pita nabaluba naye bakaba bhatwa nehope, asi pabakati babhwazula, bakabona kungaima kukwe nabanhulume babili bakaba belimile naye. <verse eid="LUK 9:32" /><verse number="33" style="v" sid="LUK 9:33" />Yaba banhulume pabakabonsiya, Pita wakati kuna Jesu, “Tezi, zwibuya kuti tipo yopano, ngatibakeni zwitumba zwitatu, chicho, chaMozesi nechaElija.” Aajakabeziba zwaakabelebeleka.<verse eid="LUK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34" />Echinoleba alo kwakezha igole, likaba fukatila bakangwina mugole, balayijwa bakaba nolutyo. <verse eid="LUK 9:34" /><verse number="35" style="v" sid="LUK 9:35" />Iwhi lyakawhika liva mugole liti, “Yoyu ndiye Mwananhulumyana wangu wandakashala, unwhilileni!”<verse eid="LUK 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 9:36" />Palyakama kuwhika iwhi, Jesu wakaboneka aba ega. Balayijwa bakawhilijila, apana ubakabuja mumazhuba yayo nezwo zwibakabona.<verse eid="LUK 9:36" /></para>
  <para style="s">Jesu unochija umbisana unampepo umbi</para>
  <para style="r">(<ref loc="MAT 17:14-18">Mateo 17:14-18</ref>; <ref loc="MRK 9:14-27">Mako 9:14-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37" />Muchimuka pabakabhuluka idunhu, ibunga lyabanhu lyakezha konshangamija. <verse eid="LUK 9:37" /><verse number="38" style="v" sid="LUK 9:38" />Umwe unhulume waluba mugapo wakashomeja eti, “Ndayiji, ndimukumbila kuti muwhile ishe mwananhulumyana wangu, nokuti ndiye mwanangu ega, <verse eid="LUK 9:38" /><verse number="39" style="v" sid="LUK 9:39" />umpepo umbi ungombhata, pakalepo unotanga kukwiila kova ezhazhama pakalepo unobhuda ifulu mundomo autonsiya. <verse eid="LUK 9:39" /><verse number="40" style="v" sid="LUK 9:40" />Ndakakumbila balayijwa babo kuti bombhise asi bakakonwa.”<verse eid="LUK 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41" />Jesu wakashandula eti, “Aa! Chizekululu chisina kudimbwa, mane kunonoba lini ndili namwi, ndimuwhila ishe? Umbuze yokuno mwananhulumyana uwo.”<verse eid="LUK 9:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42" />Paakabezha umbisana, idimoni lyakongwigila pasi akatanga kuzhazhama. Asi Jesu wakakalalila umpepo weshambwa, akachija umbisana, kova ompa kuna tate babe. <verse eid="LUK 9:42" /><verse number="43" style="v" sid="LUK 9:43" />Bose bakachenamiswa nesimba lyaMwali.</para>
  <para style="s" vid="LUK 9:43">Jesu unolebeleka pezhulu polufu lulwe akale</para>
  <para style="r" vid="LUK 9:43">(<ref loc="MAT 17:22">Mateo 17:22</ref>,<ref loc="MAT 17:23">23</ref>; <ref loc="MRK 9:30-32">Mako 9:30-32</ref>)</para>
  <para style="p" vid="LUK 9:43">Asi bechakachenama nezwose zwaakata, wakati kubalayijwa babe, <verse eid="LUK 9:43" /><verse number="44" style="v" sid="LUK 9:44" />“Iwhisisani mawhi yaya, nokuti Mwananhulumyana woNhu unoochetwa kova epilwa mumaboko abanhu.” <verse eid="LUK 9:44" /><verse number="45" style="v" sid="LUK 9:45" />Koga abajakawhisisa mawhi yaya, zwakabakasisika kwabali, kuti besiwhisise, akale bakatya kuti bombhuze nezwaakaleba.<verse eid="LUK 9:45" /></para>
  <para style="s">Unkulwana ndiyani?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mateo 18:1-5</ref>; <ref loc="MRK 9:33-37">Mako 9:33-37</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46" />Bakatanga kukakabajana pakati pabo beti unkulwana pakati pabo ndiyani. <verse eid="LUK 9:46" /><verse number="47" style="v" sid="LUK 9:47" />Jesu mukuziba kuti zwakabeli mundangalilo jabo ini, wakatola mwana akomisa pelyo naye, <verse eid="LUK 9:47" /><verse number="48" style="v" sid="LUK 9:48" />akati kwabali, “Aani naani unotambula mwana yoyu muzina lyangu unobanditambula namibo, wose unotambula imi, unotambula iye wakandituma, nokuti yoyo untukutuku pakati penu mwose, ndiye unkulwana.”<verse eid="LUK 9:48" /></para>
  <para style="s">Wose usinonyenyejana nami ngowenu</para>
  <para style="r">(<ref loc="MRK 9:38-40">Mako 9:38-40</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49" />Joni wakashandula eti, “Tezi, tabona unhulume ebhisa madimoni muzina lyenu, asi tondambija kuta alo nokuti atoba umwe wedu.”<verse eid="LUK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50" />Koga Jesu wakati kwaali, “Musunjibise, nokuti aani naani usinonyenyejana namwi unowhanana namwi.”<verse eid="LUK 9:50" /></para>
  <para style="s">Unzi wokuSamariya unolamba kutambula Jesu</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51" />Paakati abapelyo mazhuba awe okuti etambulwe kudenga, wakatola inzila inonda kuJelusalema. <verse eid="LUK 9:51" /><verse number="52" style="v" sid="LUK 9:52" />Wakatuma batumwa babe mbeli kukwe, bakanongwina munzi wokuSamariya betila kuumbambila, <verse eid="LUK 9:52" /><verse number="53" style="v" sid="LUK 9:53" />koga banhu abajakontambula, nokuti zwakabeli pachena kuti ulonanga kunda kuJelusalema. <verse eid="LUK 9:53" /><verse number="54" style="v" sid="LUK 9:54" />Pabakati balayijwa babe Jemusi naJoni babona yezwi, bakati, “Tezi munoda kuti tishobe moto ubheluke uva kudenga kuti ubapalaje na?”<verse eid="LUK 9:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 9:55" />Asi wakachingunuka, akabakalalila. <verse eid="LUK 9:55" /><verse number="56" style="v" sid="LUK 9:56" />Bakenda kunomwe unzi.<verse eid="LUK 9:56" /></para>
  <para style="s">Bachooba batobeli baJesu</para>
  <para style="r">(<ref loc="MAT 8:19-22">Mateo 8:19-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57" />Beli mulwendo lwabo, umwe unhulume wakati kunaiye, “Ndokutobela kwose kwaunonda.”<verse eid="LUK 9:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58" />Jesu wakati kwaali, “Ihaba jina makwizhana, nenyuni jomuzhezhulu jina zwizhumbo, koga Mwananhulumyana woNhu aana paanolajika unsholo uwe.”<verse eid="LUK 9:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59" />Wakati kunomwe, “Nditobele.” Asi iye wakashandula, eti, “Tezi ndisiyeni ndinolajika tate bangu tangwa.”<verse eid="LUK 9:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60" />Koga wakati kwaali, “Leka bakafa belajike bakafa babo, iwi inda, unopupula bushe bwaMwali.”<verse eid="LUK 9:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61" />Umwe wakati, “Ndomutobela Tezi, asi lekani tangwa ndinokoneka bopasha pangu.” <verse eid="LUK 9:61" /><verse number="62" style="v" sid="LUK 9:62" />Jesu wakati kwaali, “Apana unoti abiga luboko lulwe pechikekelo, unotanga kuchebuka mushule, yoyo aatokwelela kuba mubushe bwaMwali.”<verse eid="LUK 9:62" /></para>
  <chapter eid="LUK 9" />
  <chapter number="10" style="c" sid="LUK 10" />
  <para style="s">Jesu unotuma baakashala makumi mashanu anamakumi mabili nababili</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1" />Mushule mwezwi Tezi wakashala banhu banoswika makumi mashanu anamakumi mabili nababili, akabatuma kuti bekwende beli babili babili, bende mbeli kukwe kumakuta nokumapazu ose aalushanyila. <verse eid="LUK 10:1" /><verse number="2" style="v" sid="LUK 10:2" />Wakati kwabali, “Igoloka igulwana, koga bashingi bashoma, nokudalo namatani kunaShe wegoloka kuti etumile bashingi mukuvuna kukwe. <verse eid="LUK 10:2" /><verse number="3" style="v" sid="LUK 10:3" />Indani ndomutuma, semhwizana pakati pamashambo. <verse eid="LUK 10:3" /><verse number="4" style="v" sid="LUK 10:4" />Musinyamule chikwama chemali, kana ihomo, kana ishangu, musimuse unhu munzila, <verse eid="LUK 10:4" /><verse number="5" style="v" sid="LUK 10:5" />Yose ingumba yamunongwina, mutange nokuti, ‘Lunyalalo ngalube muna yeyi ingumba.’ <verse eid="LUK 10:5" /><verse number="6" style="v" sid="LUK 10:6" />Kana mwananhulumyana wolunyalalo elipo, lunyalalo lwenu lunosala paali, asi kana zwisili alo, lunyalalo lwenu lunobuya kwamuli. <verse eid="LUK 10:6" /><verse number="7" style="v" sid="LUK 10:7" />Mugale mwakalemo mungumba, mulye kulya nokunwa zwose zwibanomupa, nokuti unshingi ulokwelela kuwana indipo yiye, Musiti muneyi ingumba mwagala, nomunendiya mwanogala. <verse eid="LUK 10:7" /><verse number="8" style="v" sid="LUK 10:8" />Muguta lyose lyamunogwina bemutambula, ilyani zwabanomupa, <verse eid="LUK 10:8" /><verse number="9" style="v" sid="LUK 10:9" />mulape banolwala banobelipo, mulebe kwabali muti, ‘Bushe bwaMwali bwaba pelyo namwi.’ <verse eid="LUK 10:9" /><verse number="10" style="v" sid="LUK 10:10" />Asi kana mwangwina muguta kova beleka kumutambula, kwendani pakati pejinzila muti, <verse eid="LUK 10:10" /><verse number="11" style="v" sid="LUK 10:11" />“Nehuluba yeguta lyenu ilobhatilila kumakumbo edu, toyikuhumula tiyisiya namwi, asi zibani kuti bushe bwaMwali bupo pelyo. <verse eid="LUK 10:11" /><verse number="12" style="v" sid="LUK 10:12" />Ndinomubuja muzhuba lyokutongwa, Mwali unooba neshe neSodoma kupinda yelyo iguta.<verse eid="LUK 10:12" /></para>
  <para style="s">Makuta asinodimbwa</para>
  <para style="r">(<ref loc="MAT 11:20-24">Mateo 11:20-24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13" />“Mayee Korazini! Mayee Bhetisaida! Ngana zwishamiso zwakatilwa imwi, zwatiwa akale kuTaya neSidoni ngana bagali bamo bakashanduka kale, bakambala masaka nokuzwiguba ilota. <verse eid="LUK 10:13" /><verse number="14" style="v" sid="LUK 10:14" />Kojoba zwakadalo kutongwa kweTaya neSidoni akutoba kulemu kupinda kwenu. <verse eid="LUK 10:14" /><verse number="15" style="v" sid="LUK 10:15" />Nawi Kapenaume, unoonyamulilwa kudenga na? Unooposelwa pasi kuhadesi.”<verse eid="LUK 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16" />“Aani wose unomuwhilila imwi, unondiwhilila imi neebo, yoyo unomulamba imwi, unondilamba bo imi, Akale yoyo unondilamba imi, unobelamba bo iye yoyo wakandituma.”<verse eid="LUK 10:16" /></para>
  <para style="s">Kubuya kwamakumi mashanu anamakumi mabili namabili</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17" />Bakabuya belinolushanto, yabaya makumi mashanu anamakumi mabili nababili beti, “Tezi, namadimoni anotiwhilila kana tishingisa izina Lilyo!”<verse eid="LUK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18" />Wakati kwabali, “Ndakabona Satani embwela solupenyo eva kudenga. <verse eid="LUK 10:18" /><verse number="19" style="v" sid="LUK 10:19" />Iwhani! Ndamupa isimba lyokutoba inyoka nemhami, nokuzunda ose masimba ombengi, akale apana chichoomulwajisa. <verse eid="LUK 10:19" /><verse number="20" style="v" sid="LUK 10:20" />Koga musishante nokuti mipepo inomuwhilila, koga shantani nokuti mazina enu alokwalwa kudenga.”<verse eid="LUK 10:20" /></para>
  <para style="s">Jesu unoshantilwa</para>
  <para style="r">(<ref loc="MAT 11:25-27">Mateo 11:25-27</ref>; <ref loc="MAT 13:16-17">13:16-17</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21" />Nonshaji wakaleyo wakashanta muMpepo uNchena akati, “Ndinomuboka, Tate, She wedenga nenyika, nokuti mwakasisa yezwi kuna banamaano nabachenjevu, koga mwakazwitondeja kubanabacheche. Eya, Tate, mwakatondeja ishe nechido chenu.<verse eid="LUK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22" />“Tate bangu bakandipa zwose, apana unoziba kuti Mwananhulumyana ndiyani, kuzhe kwaibo Tate, kana kuti Tate ndiyani, kuzhe kwoMwananhulumyana akale noMwananhulumyana unotondeja Tate kunaabo baanoda.”<verse eid="LUK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23" />Wakalinga kubalayijwa babe akalebeleka nabo musiswa akati, “Alokombolelwa mesho anobona zwamubweni imwi! <verse eid="LUK 10:23" /><verse number="24" style="v" sid="LUK 10:24" />Nokuti ndinoleba nditi kwamuli, Banji bapolofeti baMwali namashe bakabeda kubona zwamubweni, asi abajakazwibona, nokuwha zwamuwhile asi abajakazwiwha.”<verse eid="LUK 10:24" /></para>
  <para style="s">UnSamariya umbuya</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25" />Undayiji woMulawo wakanyamuka eda kukweja Jesu akati,“ Ndayiji, biya ndilokwelela kutani kuti ndiwane ifuma yobupenyu businopela?”<verse eid="LUK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26" />Jesu wakonshandula eti, “Mulokwalwa kuwhini mumulawo? Mwakabalani”<verse eid="LUK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27" />Wakashandula eti, “Ida She Mwali uwo, nomwoyo uwo wose, nompepo uwo wose, nesimba lilyo lyose, nendangalilo jijo jose, akale ida umbakijani uwo sobwaunozwida iwi nokuko.”<verse eid="LUK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28" />Wakati kwaali “Washandula zwibuyanana, ita yezwi uchalalama.” <verse eid="LUK 10:28" /><verse number="29" style="v" sid="LUK 10:29" />Koga iye eda kuzwilulamisa, wakati kunaJesu, “Umbakijani wangu ndiyani?”<verse eid="LUK 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30" />Jesu wakashandula, eti, “Umwe unhu wakabekwenda ekunuka eva kuJelusalema enda kuJeliko, wakapambwa nembava jikombula zwimbalo, jikondoba, jikonsiya ekazilika. <verse eid="LUK 10:30" /><verse number="31" style="v" sid="LUK 10:31" />Kwakaswika untebuji epinda ekwenda nenzila yakaleyo, asi paakabona unhu yoyo wakanyenduluka akapinda kumbali. <verse eid="LUK 10:31" /><verse number="32" style="v" sid="LUK 10:32" />Nenzila yakaleyo kwakaswika unLevi akombona, akanyenduluka bo akapinda kumbali. <verse eid="LUK 10:32" /><verse number="33" style="v" sid="LUK 10:33" />Koga unSamariya wakabekwenda muneyo inzila wakaswika paali, paakombona wakonwhila ishe, <verse eid="LUK 10:33" /><verse number="34" style="v" sid="LUK 10:34" />wakenda kwaali, akondila mafuta newaini akapomba uncheka pezwilonda zwizwe kova onyamula nemhuka yiye, akoonsenga kungumba inoswikila bakwendi akanondinda. <verse eid="LUK 10:34" /><verse number="35" style="v" sid="LUK 10:35" />Muchimuka wakabhisa madinari mabili akapa unolinga bugalo yobo, akati, ‘Ndilingileni unhu yoyu, mungoshingisa imwe imali inopinda yeyi, ndinoomubwilizila imali yenu pandichanobuya.”’<verse eid="LUK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36" />Jesu wakajibija ebhuza eti, “Pakati paba batatu, unoyeya kuti ndiyani wakabeli umbakijani woyo unhu, wakabhatwa nembava?”<verse eid="LUK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37" />Wakati, “Ndiyoyo wakonwhila ishe.”</para>
  <para style="p" vid="LUK 10:37">Jesu wakati kwaali, “Inda neebo unota alo.”<verse eid="LUK 10:37" /></para>
  <para style="s">Jesu unoshanyila Malita naMariya</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38" />Pabakaba bekwenda, Jesu nabalayijwa babe bakaswika panomwe unzi, umwe unhukaji unowhi Malita wakontambula mungumba yiye. <verse eid="LUK 10:38" /><verse number="39" style="v" sid="LUK 10:39" />Waluba nonkazwaji wechinhukaji unowhi Mariya, iye wakagala pasi pelyo namakumbo aTezi ewhilila indayijo. <verse eid="LUK 10:39" /><verse number="40" style="v" sid="LUK 10:40" />Koga Malita wakaba nokunyajikana pezhulu pemishingo yaakabekwelela kuta, ndipo paakezha kwaali, akati, “Tezi, amunani nokuti nkazwaji wangu wechinhukaji ,wandilekelela ndita ndoga yose mishingo? Umbujeni endibhanche neebo.”<verse eid="LUK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41" />Koga Tezi wakonshandula eti, “Malita, Malita, umunyajwa ushungulujika nezwinhu zwinji, <verse eid="LUK 10:41" /><verse number="42" style="v" sid="LUK 10:42" />Chimwempela chete chinodikana. Mariya washala chibuya nokuti aatochitolelwa.”<verse eid="LUK 10:42" /></para>
  <chapter eid="LUK 10" />
  <chapter number="11" style="c" sid="LUK 11" />
  <para style="s">Indayijo yaJesu pezhulu pokunamata</para>
  <para style="r">(<ref loc="MAT 6:9-13">Mateo 6:9-13</ref>; <ref loc="MAT 7:7-11">7:7-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1" />Wakati elikumunamata kunalimwe ibhazu, paakapeja umwe wabalayijwa babe wakati kuna iye, “Tezi, tilayijeni kunamata, sezwakatiwa naJoni kubalayijwa babe.”<verse eid="LUK 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2" />Wakati kwabali, “Kana munamata, munoti:</para>
  <para style="q1" vid="LUK 11:2">“‘Tate,</para>
  <para style="q2" vid="LUK 11:2">izina lyenu ngalikujwe.</para>
  <para style="q2" vid="LUK 11:2">bushe bwenu ngabuswike,<verse eid="LUK 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3" />Tipeni kulya kwedu kwemisi nemisi,<verse eid="LUK 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4" />mutilekejele luchinyo lwedu,</para>
  <para style="q2" vid="LUK 11:4">sobutinobalekejela bose banotichinyila,</para>
  <para style="q1" vid="LUK 11:4">musitilekelele tiwila mukukwejwa.’”<verse eid="LUK 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5" />Wakati kwabali, “Ndiyani pakati penu unoti eli nonkwaina uwe, kova enda kwaali pakati pobusiku eswika eti, ‘Nkwaina wangu ndicheneke zwinkwa zwitatu, <verse eid="LUK 11:5" /><verse number="6" style="v" sid="LUK 11:6" />nokuti unkwaina wangu umo mulwendo wandiswikila, andina, chokuumpa!’ <verse eid="LUK 11:6" /><verse number="7" style="v" sid="LUK 11:7" />iye unoshandula elimungumba eti, ‘Usindinyaje, ndakonya kale unkoba akale imi nabana bangu talala kale, andingamuke kuti ndikupe chinhu’ <verse eid="LUK 11:7" /><verse number="8" style="v" sid="LUK 11:8" />Ndinomubuja kojoba iye esinomuka kuti ompe pezhulu pobukwaina bwabo, kunangatila kukwe chete ndikwo kungoonta kuti emuke ompe zwose zwaanoda. <verse eid="LUK 11:8" /><verse number="9" style="v" sid="LUK 11:9" />Nokudalo ndinoti kwamuli, Kumbilani, munoopiwa, pyangani munoowana, gogojani, munoozhulilwa. <verse eid="LUK 11:9" /><verse number="10" style="v" sid="LUK 11:10" />Nokuti aani naani unokumbila unopiwa, nooyo unopyanga unowana, noyo unogogoja unozhulilwa. <verse eid="LUK 11:10" /><verse number="11" style="v" sid="LUK 11:11" />Ndiyani pakati penu unoti eli tate angati, kana mwana akumbila ihobe iye ompe inyoka, <verse eid="LUK 11:11" /><verse number="12" style="v" sid="LUK 11:12" />kana kuti angompa imhami, iye akumbila ibumbulu? <verse eid="LUK 11:12" /><verse number="13" style="v" sid="LUK 11:13" />Kana imwi nobubi bwenu yobu, muziba kupa bana benu zwipo zwibuyanana, ani biya Tate benu bokudenga bangakonwa chini kupa uMpepo uNchena kuna yabo banokumbila kwabali!”<verse eid="LUK 11:13" /></para>
  <para style="s">Jesu naBheluzabheli</para>
  <para style="r">(<ref loc="MAT 12:22-30">Mateo 12:22-30</ref>; <ref loc="MRK 3:20-27">Mako 3:20-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14" />Ngweno wakaba ebhisa idimoni lyakabeli chimumu, palyakabhuda idimoni unhu wakabeli chimumu wakatanga kulebeleka, banhu bakachenama. <verse eid="LUK 11:14" /><verse number="15" style="v" sid="LUK 11:15" />Koga bamwe babo bakati, “Unobhisa madimoni namasimba aBheluzabheli, unchinda wamadimoni.”<verse eid="LUK 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 11:16" />Bamwe, bakonkweja nokukumbila kuti ete chitondejelo chinova kudenga. <verse eid="LUK 11:16" /><verse number="17" style="v" sid="LUK 11:17" />Koga iye, eziba indangalilo jabo, wakati kwabali, “Bose bushe buloganukana bunopalajika, akale ingumba iloganukana nokwayo, inombwela. <verse eid="LUK 11:17" /><verse number="18" style="v" sid="LUK 11:18" />Nokudalo kana Satani ekapambukana, bushe bubwe bungaba ipo chini? Nokuti munoti ndikumubhisa madimoni nesimba lyaBheluzabheli. <verse eid="LUK 11:18" /><verse number="19" style="v" sid="LUK 11:19" />Kana ndibhisa madimoni nesimba lyaBheluzabheli, ani bana benu banowabhisa nesimba lyani? Nokudalo ndibo bachaba batongi benu. <verse eid="LUK 11:19" /><verse number="20" style="v" sid="LUK 11:20" />Asi kana ndibhisa madimoni nakanyala kaMwali, zwinoleba kuti bushe bwaMwali bwaswika kwamuli.<verse eid="LUK 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21" />“Kana unhulume unesimba akale ekapakata zwilwaniso zwizwe, elinda unzi uwe, chuma chiche chilotabilijika. <verse eid="LUK 11:21" /><verse number="22" style="v" sid="LUK 11:22" />Koga kana kukaswika umwe unanesimba linopinda lilye, kova onkoma, unotola zwose zwilwaniso zwaabebimba nazwo, unzundi kova ekoba zwaakwiba.<verse eid="LUK 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23" />“Yoyo usiko kubhazu lyangu aatowililana nami, akale yoyo usinobutitika nami unotataula.”<verse eid="LUK 11:23" /></para>
  <para style="s">Kubwilila kwoMpepo Umbi</para>
  <para style="r">(<ref loc="MAT 12:43-45">Mateo 12:43-45</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24" />“Kana umpepo weshambwa wabhuda munhu unopungaila upinda kubugalo bulokoma, upyanga pokunyetutukila, ungoshayiwa unoti, ‘Ndobwilila kungumba yangu kwandakava.’ <verse eid="LUK 11:24" /><verse number="25" style="v" sid="LUK 11:25" />Paunobwilila unowana ingumba ikashambijika akale ikalonganyika. <verse eid="LUK 11:25" /><verse number="26" style="v" sid="LUK 11:26" />Unobwilila kunokoka imwe mipepo mishanu inamibili mikali kasa kupinda iwo, kova ingwina ikagala mukati, kana zwaba alo, yoyo unhu unooba mubukukutu kupinda pakutanga.”<verse eid="LUK 11:26" /></para>
  <para style="s">Lushanto lwechokomende</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27" />Paakabechinolebeleka yezwi, umwe unhukaji mukati mwebunga wakashomeja eti, “Ilokombolelwa imimba yakakunyamula akale nezhamu liwakamwa.”<verse eid="LUK 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28" />Koga Iye wakashandula eti, “Balokombolelwa ndiyabo banowha iwhi lyaMwali kova belilondota.”<verse eid="LUK 11:28" /></para>
  <para style="s">Chitondejo chaJona</para>
  <para style="r">(<ref loc="MAT 12:38-42">Mateo 12:38-42</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29" />Palyakati ibunga lyabanhu lyawanda, wakatanga kulebeleka eti, “Chizekululu yechi chilohunguka, chinoda chitondejo asi apana chachichapiwa kuzhe kwechitondejo chaJona. <verse eid="LUK 11:29" /><verse number="30" style="v" sid="LUK 11:30" />Nokuti Jona wakaba chitondejelo kubanhu beNinive, nokudalo Mwananhulumyana woNhu unooba alo kuchizekululu yechi. <verse eid="LUK 11:30" /><verse number="31" style="v" sid="LUK 11:31" />Nezhuba lyokutongwa, baNdalama bokuchamhembe pamwempela nabanhu bechizekululu yechi banooma mbeli bebapa undandu nezhuba lyokutongwa, nokuti bakakwenda wose unshizho beva kunyika yabo kuti boowhilila indayijo jobuchenjevu jaSolomoni, asi ndinoti kwamuli, yopano pana unkulwana kupinda Solomoni. <verse eid="LUK 11:31" /><verse number="32" style="v" sid="LUK 11:32" />Nezhuba lyokutongwa banhu beNinive banooshandukila chizekululu yechi bechipa undandu, nokuti Jona paakabhaunula bakashanduka, lingani yopano pana unkulwana kupinda Jona.<verse eid="LUK 11:32" /></para>
  <para style="s">Chimuniko choMbili</para>
  <para style="r">(<ref loc="MAT 5:15">Mateo 5:15</ref>; <ref loc="MAT 6:22">6:22</ref>,<ref loc="MAT 6:23">23</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33" />“Apana unhu unotutumisa chimuniko kova echibiga palosisika kana kuchitibhikila nechitundu, asi unochibiga pechibigilo chacho kutila kuti banongwina bebone lumuniko. <verse eid="LUK 11:33" /><verse number="34" style="v" sid="LUK 11:34" />Chimuniko chombili izhisho lilyo, kana izhisho lilyo lilibhenyu, umbili uwo uzhele lumuniko, asi kana lilwaja izhisho lilyo, nombili uwo uzhele inhilima. <verse eid="LUK 11:34" /><verse number="35" style="v" sid="LUK 11:35" />Nokudalo chenjela kuti lumuniko luli munawi lusibe inhilima. <verse eid="LUK 11:35" /><verse number="36" style="v" sid="LUK 11:36" />Kana umbili uwo wose ulizhele mwenje, pesina pana nenhilima, unooba nomwenje wose, umunikilwa nedubi lyawo.”<verse eid="LUK 11:36" /></para>
  <para style="s">Jesu unoshungula baFalisi naBalayiji bomulawo</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mateo 23:1-36</ref>; <ref loc="MRK 12:38-40">Mako 12:38-40</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37" />Echinolebeleka, umwe umFalisi wakonkoka kuti enolya naye chilayilo, wakangwina mungumba akagala panolyilwa. <verse eid="LUK 11:37" /><verse number="38" style="v" sid="LUK 11:38" />UmFalisi wakashama paakabona kuti Jesu wakatanga kulya esashamba maboko. <verse eid="LUK 11:38" /><verse number="39" style="v" sid="LUK 11:39" />Tezi wakati kwaali, “Imwi baFalisi, moshambisa pazhe ponkombe nendyilo, asi mukati mwenu muzhele bupambi nobubi. <verse eid="LUK 11:39" /><verse number="40" style="v" sid="LUK 11:40" />Imwi malema! Atoba iye na wakabumba pazhe akale akabumba mukati? <verse eid="LUK 11:40" /><verse number="41" style="v" sid="LUK 11:41" />Asi ipani zwimo mukati mwemikombe nendyilo jenu kubasheti, zwose zwenu zwinoshambijika.<verse eid="LUK 11:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42" />“Mayee kunamwi baFalisi! nokuti munopila chegumi, butwilo nemilibo yose, musinolangalila kululama noludo lwaMwali, yezwi munokwelela kuzwita musinosiyija zwimwe.<verse eid="LUK 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43" />“Mayee kunamwi baFalisi! nokuti munoda zwibhula zwokulemeswa mumasinagogo nokumuswa kana muli kumisika. <verse eid="LUK 11:43" /><verse number="44" style="v" sid="LUK 11:44" />Mayee kunamwi! nokuti munanga samakumbu asinoboneka, anotobwa nabanhu besinoziba.”<verse eid="LUK 11:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45" />Limwe igweta lyakashandula liti, “Ndayiji, kana muleba alo, mumutituka nasubo.”<verse eid="LUK 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46" />Iye wakati, “Mayee nokunamwi magweta! Nokuti munonyamulisa banhu mitolo milemu kasa, koga imwi amutoiguma kana nakanyala mitolo yeyo. <verse eid="LUK 11:46" /><verse number="47" style="v" sid="LUK 11:47" />Mayee kunamwi! nokuti munobakila makumbu abalebambeli baMwali, ibo bakabulayiwa namatate enu. <verse eid="LUK 11:47" /><verse number="48" style="v" sid="LUK 11:48" />Imwi mubasumikiji akale mozwida zwakatiwa namatate enu, nokuti ibo bakababulaya, imwi munobakila makumbu abo. <verse eid="LUK 11:48" /><verse number="49" style="v" sid="LUK 11:49" />Ndizwo Mwali akati nobuchenjevu bubwe, ‘Ndoobatumijila bapolofeti baMwali nabapositoli, bamwe banoobabulaya, bamwe banoobayangatisa’ <verse eid="LUK 11:49" /><verse number="50" style="v" sid="LUK 11:50" />kutila kuti ilopa lyabapolofeti bose lyakakutuka kuva matangisilo enyika linoobeteswa kuchizekululu yechi, <verse eid="LUK 11:50" /><verse number="51" style="v" sid="LUK 11:51" />kutangila kulopa lyaAbhelo mane kuswikila kulopa lyaZakaliya, wakabulayilwa pakati pedebulilo netempeli. Eya ndinomubuja, Chizekululu yechi chinozwibetekeselwa yezwi.<verse eid="LUK 11:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52" />“Mayee kunamwi balayiji bomulawo! nokuti mwakabhisa ikii inozhula mikoba yoluzibo, koga imwi nokwenu amujakangwina mukati, asi mwakajibisa yabo bakabeda kungwina mukati.”<verse eid="LUK 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53" />Wakati ebhuda pabali, balayiji bomulawo nabaFalisi bakatanga kumpyangila undandu, nokunkunijila kuti elundule pakulebeleka, <verse eid="LUK 11:53" /><verse number="54" style="v" sid="LUK 11:54" />bakonteya kuti bombhatile mundebo jije.<verse eid="LUK 11:54" /></para>
  <chapter eid="LUK 11" />
  <chapter number="12" style="c" sid="LUK 12" />
  <para style="s">Chichenjejo pezhulu pobuchengeji</para>
  <para style="r">(<ref loc="MAT 10:26">Mateo 10:26</ref>,<ref loc="MAT 10:27">27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1" />Pakwakabungana banhu banji bakata kutobana, wakalebeleka etangisa kubalayijwa babe eti, “Muchenjelele umfufumuso wabaFalisi, ndikwo kuchengeja kwabo. <verse eid="LUK 12:1" /><verse number="2" style="v" sid="LUK 12:2" />Apana chilofumikwa chicholekejwa kufumulwa, kana chilosisika zwicholekeja kubigwa pachena. <verse eid="LUK 12:2" /><verse number="3" style="v" sid="LUK 12:3" />Nokudalo zwose zwamunoleba munhilima zwinowhika kwakachena, nezwamunonyebeza musiswa mungumba zwinoshomejelwa pezhulu pengumba.<verse eid="LUK 12:3" /></para>
  <para style="s">Unokwelela kutyiwa Ndiyani</para>
  <para style="r">(<ref loc="MAT 1">Mateo 1</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4" />“Ndinomubuja banakwaina bangu, musitye yabo banobulaya umbili, besina zwabanotubula mushule mwazwo. <verse eid="LUK 12:4" /><verse number="5" style="v" sid="LUK 12:5" />Koga ndinomuchenjeja pezhulu powamulokwelela kutya, ityani iye unesimba lyokuposela muGehena kana wafa, eya ndinomubuja ityani iye.<verse eid="LUK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 12:6" />“Atoba imo na kuti tunyuni tushanu tungatengwa namapeni mabili? Koga apana kana kamwempela kanokanganika mumesho aMwali. <verse eid="LUK 12:6" /><verse number="7" style="v" sid="LUK 12:7" />Seni, isusu limwe nelimwe limwo munsholo wenu lilolabwa kale. Musitye, nokuti mulokosha kupinda tundonga tunji.<verse eid="LUK 12:7" /></para>
  <para style="s">Kuvuma nokulamba Kristo</para>
  <para style="r">(<ref loc="MAT 10:32">Mateo 10:32</ref>,<ref loc="MAT 10:33">33</ref>; <ref loc="MAT 12:32">12:32</ref>; <ref loc="MAT 10:19">10:19</ref>,<ref loc="MAT 10:20">20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8" />“Akale ndinomubuja kuti wose unondivumila mbeli kwabanhu, iye yoyo unoovumilwa noMwananhulumyana woNhu mbeli kwengilozi jaMwali, <verse eid="LUK 12:8" /><verse number="9" style="v" sid="LUK 12:9" />asi iye unondilamba mbeli kwabanhu, unoolambwa mbeli kwabatumwa baMwali.<verse eid="LUK 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 12:10" />“Akale wose unolebeleka iwhi ibi nezwoMwananhulumyana woNhu unoolekejelwa, koga yoyo unotukana pezhulu poMpepo uNchena aatolekejelwa.<verse eid="LUK 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11" />“Pabanomusenga kumasinagogo nokubatongi nokumakulukota musizwinyaje kuti mozwishandula chini, kana kuti motini, <verse eid="LUK 12:11" /><verse number="12" style="v" sid="LUK 12:12" />nokuti panoyo unshaji uMpepo uNchena unoomulayija zwamulokwelela kuleba.”<verse eid="LUK 12:12" /></para>
  <para style="ms">Unkwejaniso womfumi ilema</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13" />Umwe unhu wakabeli mukati mwebunga lyabanhu wakati kuna Iye, “Ndayiji, ibujani unkulu wangu kuti endikobele bo ifuma.”<verse eid="LUK 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14" />Asi iye wakati kwaali, “Awe, ndiyani wandibiga kuti ndibe untongi kana unkobanisi wechuma chenu?” <verse eid="LUK 12:14" /><verse number="15" style="v" sid="LUK 12:15" />Wakati kwabali, “Chenjelani musibe noluchiba nechuma, nokuti bupenyu bwonhu abutobakwa nokuwanda kwefuma.”<verse eid="LUK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16" />Wakababuja unkwejaniso akati, “Unda wondimi wakafuma wakoompa igoloka igulwana, <verse eid="LUK 12:16" /><verse number="17" style="v" sid="LUK 12:17" />akayeya mumwoyo uwe eti, ‘Ini zwandichata, nokuti andina pokubigila zwilyo zwangu zwose?’ <verse eid="LUK 12:17" /><verse number="18" style="v" sid="LUK 12:18" />Akati, ‘Ndichata yezwi’ akababuja kuti, ‘Ndichakolomola ose makombana angu kova ndibaka amwe makulwana, yomo ndimo mwandichabiga zwilyo nezwibiya zwangu zwose. <verse eid="LUK 12:18" /><verse number="19" style="v" sid="LUK 12:19" />akale ndichati kumpepo wangu, Mpepo wangu, unazwolya zwinji mubupenyu bubo kwamakole manji akumutobela, nokudalo teja mwoyo, ilya, unwe, akale ushante.’ <verse eid="LUK 12:19" /><verse number="20" style="v" sid="LUK 12:20" />Asi Mwali wakati kwaali: ‘Awe, lema! Busiku bwanasi umpepo uwo unoshobwa, Ani biya ichaba yani ifuma iyo yose yeyi yaulozwilondotela?’<verse eid="LUK 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21" />“Ndizwo zwichaba kunhu wose unobunganisa ifuma iye ega koga esilofuma mbeli kwaMwali.”<verse eid="LUK 12:21" /></para>
  <para style="s">Bimbani naMwali</para>
  <para style="r">(<ref loc="MAT 6:25-34">Mateo 6:25-34</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22" />Wakati kubalayijwa babe, “Nokudalo ndinomubuja, musizwinyaje nezwobupenyu bwenu kuti, molyani, kana nezwombili wenu kuti mombalani. <verse eid="LUK 12:22" /><verse number="23" style="v" sid="LUK 12:23" />Nokuti bupenyu bukulwana kupinda kulya, nombili kupinda zwimbalo. <verse eid="LUK 12:23" /><verse number="24" style="v" sid="LUK 12:24" />Lingani makungubo, aatobyala akale aatovuna, aana zwilondotelo kana makombana, koga Mwali unowapa zwokulya. modikana chini imwi kupinda inyuni iraveni! <verse eid="LUK 12:24" /><verse number="25" style="v" sid="LUK 12:25" />Ndiyani pakati penu angapamhija bulefu bwobupenyu bubwe pezhulu pokuzwinyaja? <verse eid="LUK 12:25" /><verse number="26" style="v" sid="LUK 12:26" />Kana musinotubula kuta zwinhu zwitukutuku, mozwinyajilani nezwimwe? <verse eid="LUK 12:26" /><verse number="27" style="v" sid="LUK 12:27" />Lingani maluba, kuti anokubuka chini, aatoshinga kana kuluka, asi ndomubuja kojoba Solomoni akambala zwimbalo zwizwe zwibuya zwinaluyebo aajakambala selimwe lyamaluba.<verse eid="LUK 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 12:28" />Kana Mwali embajika alo buhwa bweshango bunoti nasi bumomuminda, mangwana bunopiswa mumoto, ani imwi unoomumbajika zwili chini, Imwi banhu muna kudimbwa kutukutuku! <verse eid="LUK 12:28" /><verse number="29" style="v" sid="LUK 12:29" />Nokudalo musibige mwoyo nezwamuchalya, kana zwamuchanwa, musizwinyaje nazwo. <verse eid="LUK 12:29" /><verse number="30" style="v" sid="LUK 12:30" />Nokuti benyika jose banozwishaka yezwi, asi ibo Tate benu banoziba kuti yezwi zwinhu munozwishaka. <verse eid="LUK 12:30" /><verse number="31" style="v" sid="LUK 12:31" />Asi shakani bushe bubwe, mukadalo yezwi zwinhu zwinooba zwenu neebo.<verse eid="LUK 12:31" /></para>
  <para style="s">Bufumi kuDenga</para>
  <para style="r">(<ref loc="MAT 6:19-21">Mateo 6:19-21</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32" />“Musibe nokutya imwi gapo idukutuku, nokuti Tate benu banoshantila kumupa bushe. <verse eid="LUK 12:32" /><verse number="33" style="v" sid="LUK 12:33" />Tengesani zwaamunanazwo, mupe zwipo kubasheti, ishakani zwikwama zwisinoshakala, nefuma isinopela kudenga, kusina imbava ichabuswikila kana igube lichabupalaja. <verse eid="LUK 12:33" /><verse number="34" style="v" sid="LUK 12:34" />Nokuti panefuma yiyo, ndipo mwoyo uwo pauchaba bo.<verse eid="LUK 12:34" /></para>
  <para style="ms">Bashingi Banolingilila Zwibuyanana</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35" />“Bonani kuti mugele mukambala zwimbalo zwenu. Zwimunikiso zwenu ngezwigale zwikatutuma, <verse eid="LUK 12:35" /><verse number="36" style="v" sid="LUK 12:36" />ibani sabanhu balomilila tezi wabo umuva kumabhiko okulobolana, unoti angogogoja banomuka nokunzhulila unkoba pakalepo. <verse eid="LUK 12:36" /><verse number="37" style="v" sid="LUK 12:37" />Balokombolelwa yabo bashingi banowanika beliwhile pakuswika kwatezi wabo, chokomende ndinomubuja unoozwipombela noncheka, kova ebabuja kuti begale pasi pabugalo bwokulyila ebapakulila iye. <verse eid="LUK 12:37" /><verse number="38" style="v" sid="LUK 12:38" />Unooba nolushanto kana awana bekomilila kwova eswika pakati pobusiku kana kumijelo, balokombolelwa yabo bashingi. <verse eid="LUK 12:38" /><verse number="39" style="v" sid="LUK 12:39" />Asi whisisani yezwi, ngana mweni wengumba akabeziba kuti imbava inoswika noupi unshaji, aajaluleka imbava ingwina mungumba yiye. <verse eid="LUK 12:39" /><verse number="40" style="v" sid="LUK 12:40" />Namwibo galani mukazwibambanyila, nokuti Mwananhulumyana woNhu unozha nonshaji umusinoyeyesela.”<verse eid="LUK 12:40" /></para>
  <para style="s">Unshingi ulobimbika kana usilobimbika</para>
  <para style="r">(<ref loc="MAT 24:45-51">Mateo 24:45-51</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41" />Pita wakati, “Tezi, nonkwejaniso yoyu mumubuja isu na, kana kuti wose unhu?” <verse eid="LUK 12:41" /><verse number="42" style="v" sid="LUK 12:42" />Tezi wakati, “Ndiupi biya umbhati wengumba ulobimbika nouna maano, unopiwa natezi uwe kuba unkulwana pezhulu pabengumba yiye kuti ebe unkobeli wokulya nonshaji ulokwelela? <verse eid="LUK 12:42" /><verse number="43" style="v" sid="LUK 12:43" />Ulokombolelwa yoyo unshingi unoti kana tezi uwe aswika unowanikwa eta yezwo. <verse eid="LUK 12:43" /><verse number="44" style="v" sid="LUK 12:44" />Chokomende ndinomubuja kuti unoova ompa kuti ebe iye unolinga ifuma iye yose. <verse eid="LUK 12:44" /><verse number="45" style="v" sid="LUK 12:45" />Kana unshingi yoyo eti mumwoyo mumwe, ‘Tezi wangu umujilwa kuzha’ kova etanga kuloba zwishingi zwechinhulumyana nozwechinhukajana, elya, enwa nokukolwa, <verse eid="LUK 12:45" /><verse number="46" style="v" sid="LUK 12:46" />ibo tezi booyo unshingi unooswika nezhuba lyaasinoyeyesela akale nonshaji waasinoziba, unoontonga, kova ombiga pamwempela naabo basilobimbika.<verse eid="LUK 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47" />“Akale yoyo unshingi wakabeziba chido chatezi uwe, koga akawanikwa asakazwilonganyila nokuta chido chatezi unoonabhwa zwikulwana kasa. <verse eid="LUK 12:47" /><verse number="48" style="v" sid="LUK 12:48" />Asi yoyo usaluziba akata zwilokwelela kulobelwa, unokwaiswa zwishomanana. Kuna yoyo unopiwa zwinji, neebo kunolingililwa zwinji kuna iye, akale yoyo ulopiwa lubimbo lukulwana zwinji zwinolingililwa kwaali.<verse eid="LUK 12:48" /></para>
  <para style="s">Jesu Umpalalanyi</para>
  <para style="r">(<ref loc="MAT 10:34-36">Mateo 10:34-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49" />“Ndakezha kwobuza moto penyika, ndokwemuja chini kuti ngana uli mukututuma kale! <verse eid="LUK 12:49" /><verse number="50" style="v" sid="LUK 12:50" />Kuna umbhabhatizo undichakwelela kutambula zwinondinyaja kasa ado kushungulujwa kwangu kujine kutike! <verse eid="LUK 12:50" /><verse number="51" style="v" sid="LUK 12:51" />Munoyeya kuti ndakezha penyika kwobuza lunyalalo? Mane, asi kusowhanana, <verse eid="LUK 12:51" /><verse number="52" style="v" sid="LUK 12:52" />kuvila ngweno ali ingumba yabashanu inoopambukana, batatu bepambukana nababili, nababili bepambukana nabatatu, <verse eid="LUK 12:52" /><verse number="53" style="v" sid="LUK 12:53" />Tate abatoowhanana nomwananhulumyana wabo, nomwananhulumyana aatowhanana natate babe, amai abatoowhanana nomwanansichana wabo, nomwanansichana aatowhanana naamai babe, amezwale abatoowhanana nonkajiwomwana, nonkajiwomwana aatowhanana naamezwale.”<verse eid="LUK 12:53" /></para>
  <para style="ms">Kuwhisisa Unshaji</para>
  <para style="r">(<ref loc="MAT 16:2">Mateo 16:2</ref>,<ref loc="MAT 16:3">3</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54" />Wakati akale kubunga lyabanhu, “Kana mubona igole liva kubumililo, munoti pakalepo, ‘Inova ina ivula’ kova kuba alo.” <verse eid="LUK 12:54" /><verse number="55" style="v" sid="LUK 12:55" />Mungowha ibhepo liva kuchampembe, munoti, ‘kwalobopisa’ kova kuba alo. <verse eid="LUK 12:55" /><verse number="56" style="v" sid="LUK 12:56" />Imwi bachengeji! Munoziba kuti zwinolebani zwitondejelo zwopenyika nomudenga, Ani biya ini mukonwa kuziba zwitondejelo zwonshaji yoyu?<verse eid="LUK 12:56" /></para>
  <para style="s">Whanana nombengi uwo</para>
  <para style="r">(<ref loc="MAT 5:25">Mateo 5:25</ref>,<ref loc="MAT 5:26">26</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57" />Ini biya musinozwishalila imwi nokwenu kuti zwilolulama ngezwipi? <verse eid="LUK 12:57" /><verse number="58" style="v" sid="LUK 12:58" />Kana uli munzila unda kugota uli pamwempela noyo wakupa undandu, kweja nesimba kuti muwhanane muchimunzila, nokuti unokumisa pambeli pontongi, akale untongi unokupila kumapolisa achakuposela muntolongo. <verse eid="LUK 12:58" /><verse number="59" style="v" sid="LUK 12:59" />“Ndinomubuja, amutoomubhuda mukati, kuswikila mwalipa ikobeli lyopejeleja.”<verse eid="LUK 12:59" /></para>
  <chapter eid="LUK 12" />
  <chapter number="13" style="c" sid="LUK 13" />
  <para style="s">Jesu unolayija nozwokuchingunuka</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1" />Panoyo unshaji bakabelipo bamwe bakabuja Jesu nozwabaGalili bakabulayiwa naPilato banelopa lyabo lyakaba lyashanganiswa nompilo wabo. <verse eid="LUK 13:1" /><verse number="2" style="v" sid="LUK 13:2" />Wakabashandula akati, “Imwi moyeya kuti ibo baGalili yaba, bakaba beli bachinyi bakulwana kupinda bamwe bose baGalili nokuti bakayabula alo? <verse eid="LUK 13:2" /><verse number="3" style="v" sid="LUK 13:3" />Ndinomubuja, mane abajakadalo, koga kana musinoshanduka, mwose moopalala saibo. <verse eid="LUK 13:3" /><verse number="4" style="v" sid="LUK 13:4" />Kana yabo igumi lina bashanu bana batatu bakafa bechigwa pakuwilwa nobushozhi boku Silomu, imwi moyeya kuti yabo bakabeli bachinyi kupinda bose banhu balugala muJelusalema? <verse eid="LUK 13:4" /><verse number="5" style="v" sid="LUK 13:5" />Ndinomubuja nditi mane, kana musachingunuka, mwose moopalala saibo.<verse eid="LUK 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6" />Wakababuja yoyu unkwejaniso, eti: “Umwe unhulume wakabyala unkuyu muchilili chiche chonzhambi, wakangwina kuti enochela ihuyu mukati, asi apana unchelo waakawana. <verse eid="LUK 13:6" /><verse number="7" style="v" sid="LUK 13:7" />Wakati kunshingi uwe womuchilili, ‘Lingapela mumakole ose matatu apinda ndizha kwopota ihuyu munkuyu yoyu, apana chindanu ndawana. Unteme unti yoyu! Ini upeja kulya muvu lyangu?’ <verse eid="LUK 13:7" /><verse number="8" style="v" sid="LUK 13:8" />Iye wakonshandula eti, ‘Tezi unsiye kwegole pela tibone, ndunshakulile mumbali kova ndibiga umfhuje. <verse eid="LUK 13:8" /><verse number="9" style="v" sid="LUK 13:9" />Kana ukazwala michelo igole limuzha, panobeli pabuya, koga ukakonwa mungontema zwenu.”’<verse eid="LUK 13:9" /></para>
  <para style="s">Jesu unolapa unhukaji igosha nezhuba lyeSabata</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10" />Jesu wakabelayija musinagogi nezhuba lyeSabata. <verse eid="LUK 13:10" /><verse number="11" style="v" sid="LUK 13:11" />Kwaluba nonhukaji wakaba eli nompepo umbi wakaba wondwajika kwamakole igumi lina mashanu ana matatu unshana uwe wakabakakovomala esinotubula kuma ekakololoka. <verse eid="LUK 13:11" /><verse number="12" style="v" sid="LUK 13:12" />Paakati Jesu ombona, wakonshoba, eti kwaali, “Awe nhukaji wasupulwa mubulwaji bubo.” <verse eid="LUK 13:12" /><verse number="13" style="v" sid="LUK 13:13" />Wakabiga maboko awe panaiye, akava akololoka unshana uwe pakalepo, akakuja Mwali.<verse eid="LUK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14" />Koga untungamili womusinagogi wakabipilwa nokuti Jesu wakalapa nezhuba lyeSabata, akalebeleka kubanhu bakaba belipo, akati, “Kunamazhuba mashanu ana limwe okushinga, nokudalo izhani mumazhuba yaya kuti muchiliswe, asi musizhe nezhuba lyeSabata.”<verse eid="LUK 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15" />She wakonshandula akati, “Imwi bachengeji! Apana pakati penu unosupula inkabe kana idonki muchilyilo chalyo neSabata kuti enoyinwisa na? <verse eid="LUK 13:15" /><verse number="16" style="v" sid="LUK 13:16" />Feno hechi chizwalwa choluji lwaAbhulahamu chabakasungwa naSatani kwamakole igumi linamashanu ana matatu, aatokwelela kusupulwa mukusungwa kukwe nezhuba lyeSabata na?” <verse eid="LUK 13:16" /><verse number="17" style="v" sid="LUK 13:17" />Paakaleba yaya mawhi, bose babengi babe bakaba neshoni, akale banhu bose bakashantilwa naizwo zwose zwishamiso zwibhodo zwaakata.<verse eid="LUK 13:17" /></para>
  <para style="s">Unkwejaniso wembeyu yemasitadi</para>
  <para style="r">(<ref loc="MAT 13:31">Mateo 13:31</ref>,<ref loc="MAT 13:32">32</ref>; <ref loc="MRK 4:30-32">Mako 4:30-32</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18" />Nokudalo wakati iye, “Ani bushe bwaMwali bunanga seni? Ndingabutojanisa neni? <verse eid="LUK 13:18" /><verse number="19" style="v" sid="LUK 13:19" />Bunanga sembeyu yemasitadi yakabyalwa nonhu muchilili chiche, yakakubuka ikaba unti, inyuni jinobakila zwizhumbo penhabi.”<verse eid="LUK 13:19" /></para>
  <para style="s">Unkwejaniso womfufumuso</para>
  <para style="r">(<ref loc="MAT 13:33">Mateo 13:33</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20" />Akale wakati, “Ndobutojanisa neni bushe bwaMwali? <verse eid="LUK 13:20" /><verse number="21" style="v" sid="LUK 13:21" />Bunanga somfufumuso wakatolwa nonhukaji, akabushanganisa ekwelanisa nobuswa bwekoloni bulokamulwa katatu, zwikafufumuka.”<verse eid="LUK 13:21" /></para>
  <para style="s">Unkoba Untukutuku</para>
  <para style="r">(<ref loc="MAT 7:13">Mateo 7:13</ref>,<ref loc="MAT 7:14">14</ref>,<ref loc="MAT 7:21-23">21-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22" />Wakapinda mukati mwamakuta nomumizi, elayija ekalingisa kuJelusalema. <verse eid="LUK 13:22" /><verse number="23" style="v" sid="LUK 13:23" />Umwe unhu wakati kwaali, “Tezi, kunoochijwa bashoma chete na?”</para>
  <para style="p" vid="LUK 13:23">Iye wakati kwabali, <verse eid="LUK 13:23" /><verse number="24" style="v" sid="LUK 13:24" />“Kwejani namasimba enu kungwina nonkoba ulomanikila, nokuti banji, ndinomubuja, banookweja kungwina naiwo, asi abatootubula. <verse eid="LUK 13:24" /><verse number="25" style="v" sid="LUK 13:25" />Kana mweni wengumba anyamuka kova ekonya idendele, imwi kwowanika mupopazhe mulimile kova mutanga kugogoja pedendele muti, ‘Tizhulileni unkoba She!’ Iye unomushandula eti, ‘Anditomuziba kuti mova kupi.’ <verse eid="LUK 13:25" /><verse number="26" style="v" sid="LUK 13:26" />Pakalepo imwi munooti, ‘Takalya, tikanwa tilinamwi, akale mwakalayija mumigwagwa yedu!’ <verse eid="LUK 13:26" /><verse number="27" style="v" sid="LUK 13:27" />Koga iye unooti, ‘Anditoziba kuti munova kupi, Bhudani yopa imwi bahungu.’ <verse eid="LUK 13:27" /><verse number="28" style="v" sid="LUK 13:28" />Yopo kunooba nokulila, nokuziya kwameno, pamuchoobona Abhulahamu, naIsaki, naJakobe, naibo bose bapolofeti mubushe bwaMwali, imwi mose mwalashilwa kuzhe. <verse eid="LUK 13:28" /><verse number="29" style="v" sid="LUK 13:29" />Banhu banooswika beva kubuvezhuba, kubumililo, kubunwanyuni nokuchamhembe, bezha kotola bugalo bwabo kumabhiko omubushe bwaMwali. <verse eid="LUK 13:29" /><verse number="30" style="v" sid="LUK 13:30" />Lingani, baiko kumapejelejo bachooba bokutanga, bokutanga neebo bachooba bopejeleja.”<verse eid="LUK 13:30" /></para>
  <para style="s">Kuda iJelusalema kwaJesu</para>
  <para style="r">(<ref loc="MAT 23:37-39">Mateo 23:37-39</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31" />Pakelepo bamwe baFalisi bakezha bakati kuna iye, “Bhuda yopano ukwende, nokuti Helodi umuda kukubulaya.”<verse eid="LUK 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32" />Wakabashandula eti, “Indani munobuja yeyo ihaba kuti, ‘Nasi namangwana ndinobhisa mipepo mibi nokuchilisa, nezhuba lyatatu ndobaapeja unshingo wangu.’ <verse eid="LUK 13:32" /><verse number="33" style="v" sid="LUK 13:33" />Zwisineni kwanasi namangwana nezhuba linotobela ndilokwelela kukwenda nenzila yangu, azwilokwelela kuti undebambeli waMwali, ebulayilwe kumwe kuzhe kwokuJelusalema.”<verse eid="LUK 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34" />“Jelusalema, Jelusalema! Unobulaya bapolofeti baMwali nokupubula namabwe yabo banotumwa kunawi! Tungana ndida kubunganisa bana babo bose, seseche inofukatila tukukwana twayo mumapapilo, asi aujakada! <verse eid="LUK 13:34" /><verse number="35" style="v" sid="LUK 13:35" />Linga ingumba yiyo inolashwa. Akale ndokubuja, auchinoondibona, kujine kuswike unshaji wauchooti, ‘Ulokombolelwa unozha muzina lyaShe.”’<verse eid="LUK 13:35" /></para>
  <chapter eid="LUK 13" />
  <chapter number="14" style="c" sid="LUK 14" />
  <para style="s">Jesu unochilisa unhulume unolwala</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1" />Nelimwe izhuba lyeSabata wakenda kungumba youmwe unkulwana wabaFalisi kuti enolya naye, bakaba bakondingisisa. <verse eid="LUK 14:1" /><verse number="2" style="v" sid="LUK 14:2" />Unhu waluba ekazwimba umbili wakabeli mbeli kukwe. <verse eid="LUK 14:2" /><verse number="3" style="v" sid="LUK 14:3" />Jesu wakalebeleka kubalayiji bomulawo nabaFalisi eti, “Zwipo pamulawo kana nee, kuchilisa nezhuba lyeSabata?”<verse eid="LUK 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 14:4" />Asi ibo bakawhilijila. Jesu wakontola akonchilisa, kova ondeka kuti ende. <verse eid="LUK 14:4" /><verse number="5" style="v" sid="LUK 14:5" />Wakati kwabali, “Ndiyani wenu unoti eli nomwana kana inkabe yawila munhiba nezhuba lyeSabata, esinokambijisa kuyibhisa kojoba lili izhuba lyeSabata?”<verse eid="LUK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 14:6" />Asi bakakonwa kunshandula panezwi.<verse eid="LUK 14:6" /></para>
  <para style="s">Kuzwininipisa</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7" />Ngweno wakababuja unkwejaniso yabo bakabakokwa, abona bamwe bezi beshala bugalo bwechilemeso, akati kwabali, <verse eid="LUK 14:7" /><verse number="8" style="v" sid="LUK 14:8" />“Kana wakokwa kumabhiko omuchado, usigale pechigalo chobulemeso, nokuti posa unhu unolemekejwa kupinda iwi angaba ekakokwabo, <verse eid="LUK 14:8" /><verse number="9" style="v" sid="LUK 14:9" />iye wamukoka mose angezha kova eti kunawi.” “Ipa chibhula yechi kunoyu, yezwi zwinokupisa ishoni nokuti unonyamuka ukanogala pechigalo chabanhukoga” <verse eid="LUK 14:9" /><verse number="10" style="v" sid="LUK 14:10" />Asi kana wakokwa, inda unogala pechigalo chabanhukoga, kutila kuti angoswika unkoki, unoti kwauli, nkwaina, inyamuka, unogala mbeli nokudalo yezwi zwinopa kulemeswa kwauli pakati pabanhu bose baunobeligele nabo. <verse eid="LUK 14:10" /><verse number="11" style="v" sid="LUK 14:11" />“Nokuti yabo banozwikuja banooninipiswa, akale yabo banozwininipisa, banookujwa.”<verse eid="LUK 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12" />Wakati kunoyo wakabonkoka, “Kana uda kukoka bamwe kuti belye nawi, chilayilo kana mabhiko, usishobe bakwaina babo, kana bakulu babo namakamu awo kana babakijani balofuma, nokuti bangookukokabo, kova wobwilizilwa indipo iyo. <verse eid="LUK 14:12" /><verse number="13" style="v" sid="LUK 14:13" />Asi kana wata mabhiko, koka basheti, namakosha namapofu, <verse eid="LUK 14:13" /><verse number="14" style="v" sid="LUK 14:14" />ungodalo unookombolelwa, nokuti yaba abana zwokukubwilizila. Unoobwilizilwa nezhuba lyokumuka kwabakalulama.”<verse eid="LUK 14:14" /></para>
  <para style="s">Unkwejaniso wamabhiko makulwana</para>
  <para style="r">(<ref loc="MAT 22:1-10">Mateo 22:1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15" />Umwe waabo wakabelya naye wakati awha yezwi wakati kwaali, “Ulokombolelwa yoyo uchoolya chinkwa mubushe bwaMwali!”<verse eid="LUK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16" />Koga Jesu wakati kwaali, “Kwakabeli nonhu wakata mabhiko makulwana, akakoka banhu banji <verse eid="LUK 14:16" /><verse number="17" style="v" sid="LUK 14:17" />pawakaswika unshaji wamabhiko wakatuma unshingi uwe kuti enoti kunayabo baakabakoka, ‘Izhani nokuti zwose zwabambanyilwa.’ <verse eid="LUK 14:17" /><verse number="18" style="v" sid="LUK 14:18" />Asi bose bakatanga kukumbila lubhatilo. Wotanga wakati kwaali, ‘Ndatenga minda, ndilokwelela kunda kunoombona, undibhatile nche.’ <verse eid="LUK 14:18" /><verse number="19" style="v" sid="LUK 14:19" />Umwe wakati, ‘Ndatenga zwipani zwishanu zwenkabe, feno ndimunda kunozwikweja, undikumbilile lulekelelo.’ <verse eid="LUK 14:19" /><verse number="20" style="v" sid="LUK 14:20" />Umwe neebo wakati, ‘Ndava mukulobola ngweno, nokudalo anditotubula kuzha.’ <verse eid="LUK 14:20" /><verse number="21" style="v" sid="LUK 14:21" />Nezwo unshingi wakabwilila kuna tezi uwe akombuja. Mweni wengumba wakalutila akati kunshingi, ‘Kambija inda kumigwagwa nomujinzila jomuguta, ubuze yopano basheti naabo banabukosha namapofu nabanoshuja.’ <verse eid="LUK 14:21" /><verse number="22" style="v" sid="LUK 14:22" />Unshingi wakati, ‘She ndata sokuleba kwenu; asi bugalo buchimo.’ <verse eid="LUK 14:22" /><verse number="23" style="v" sid="LUK 14:23" />Tezi wakati kunshingi, ‘Inda kumigwagwa nomutunzila tutukutuku ubahatamije banhu kuti bezhe, kutila kuti ingumba yangu izhale.’ <verse eid="LUK 14:23" /><verse number="24" style="v" sid="LUK 14:24" />Ndinomubuja apana kana umwe wabo bakabakokwa uchalabila chilayilo changu!”<verse eid="LUK 14:24" /></para>
  <para style="s">Kuzwipila kwontobeli waKristo</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25" />Wakabekwenda nebunga lyabanhu banji liuntobela; wakachingunuka kwabali akati, <verse eid="LUK 14:25" /><verse number="26" style="v" sid="LUK 14:26" />“Kana unhu ezha kwandili esinobenga tate babe, namai babe, nonkaji uwe, nabana babe, nabakazwaji babe bechinhulume, nabakazwaji babe bechinhukaji, eya nobupenyu bubwe aangabe undayijwa wangu. <verse eid="LUK 14:26" /><verse number="27" style="v" sid="LUK 14:27" />Aani naani usinonyamula unchinjikwa uwe, enditobela, aangabe undayijwa wangu. <verse eid="LUK 14:27" /><verse number="28" style="v" sid="LUK 14:28" />Ndiyani pakati penu unoti kana eda kubaka bushozhi, esinotanga agala pasi tangwa ezibe kuti unemalini akale unanayo na imali yokushingisa kuswikila kubaka kupele? <verse eid="LUK 14:28" /><verse number="29" style="v" sid="LUK 14:29" />Kana esinota alo, aatotubula kupeja kubaka bushozhi, unojibila kubaka mabambo chete, bose banozwibona banoonseka, <verse eid="LUK 14:29" /><verse number="30" style="v" sid="LUK 14:30" />beti, ‘yoyu wakatanga kubaka asi wakakonwa kupeja kubaka.’ <verse eid="LUK 14:30" /><verse number="31" style="v" sid="LUK 14:31" />Kana ndiupi she unonda kuhondo kunolwana noomwe She esinotanga kugala pasi, eyeyesesa kuti igumi lyezwiulu zwabalwi babe linotubula kulwana nooyo She, unamakumi mabili ezwiulu zwabalwi? <verse eid="LUK 14:31" /><verse number="32" style="v" sid="LUK 14:32" />Kana abona kuti unokomwa unomuka nokutuma umililili uwe kuti enombwetela lunyalalo bechikule kutila kuti beve bawhanana. <verse eid="LUK 14:32" /><verse number="33" style="v" sid="LUK 14:33" />Nokudalo,” Jesu wakati, “Aani naani usinolamba chose chuma chiche aangabe undayijwa wangu.”<verse eid="LUK 14:33" /></para>
  <para style="s">Kuba munyu usinanshingo</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34" />“Munyu umbuya, koga kana washampuluka, ungalweleswa neni akale? <verse eid="LUK 14:34" /><verse number="35" style="v" sid="LUK 14:35" />Auchina nshingo kuvu kana kulwi lwomfhuje, banhu banondasha. Unenzebe jokuwha ngeewhe.”<verse eid="LUK 14:35" /></para>
  <chapter eid="LUK 14" />
  <chapter number="15" style="c" sid="LUK 15" />
  <para style="s">Imhwizi yakalashika</para>
  <para style="r">(<ref loc="MAT 18:12-14">Mateo 18:12-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1" />Bose batelesi nabachinyi bakabunganila kwaali kuti bewhilile zwaakabeleba. <verse eid="LUK 15:1" /><verse number="2" style="v" sid="LUK 15:2" />BaFalisi nabakwali bomulawo bakangunguna beti, “Yoyu unhu unotambula bachinyi, akale elya nabo.” <verse eid="LUK 15:2" /><verse number="3" style="v" sid="LUK 15:3" />Nokudalo wakababuja yoyu unkwejaniso:<verse eid="LUK 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 15:4" />“Ndiyani pakati penu, unezana lyemhwizi, kova elashikilwa nemwempela, usinosiya imhwizi makumi mashanu ana mana neshanu jine jina mushango, enda kunoshaka yeyo imwempela yalashika kujine aibona na? <verse eid="LUK 15:4" /><verse number="5" style="v" sid="LUK 15:5" />Unoti kana aiwana unoyipika pamapi awe nolushanto. <verse eid="LUK 15:5" /><verse number="6" style="v" sid="LUK 15:6" />Kana aswika pasha, unoshoba bakwaina nababakijani babe kova eti kwabali, ‘shantani nami nokuti ndaiwana imhwizi yangu yabalashika.’ <verse eid="LUK 15:6" /><verse number="7" style="v" sid="LUK 15:7" />Nezwo mwakalemo, zwinokwelana, nokuti kunooba nolushanto kudenga pakushanduka kwonchinyi umwempela, kupinda makumi mashanu ana mana anabashanu nabana abanhu bakalulama basinoda kushanduka.<verse eid="LUK 15:7" /></para>
  <para style="s">Ikobeli lyakalashika</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8" />“Akale unhukaji unamakobeli igumi, unoti kana alashikilwa nekobeli limwempela, atobaimo na kuti unotutumisa chimuniko, kova epyaila ingumba epyangisisa ingumba yose kujine elibone? <verse eid="LUK 15:8" /><verse number="9" style="v" sid="LUK 15:9" />Unoti kana aliwana, unoshoba bakwaina nababakijani babe, eti kunaibo, ‘Ishantani nami, nokuti ndaliwana ikobeli lyangu lyabakalashika.’ <verse eid="LUK 15:9" /><verse number="10" style="v" sid="LUK 15:10" />Nokudalo ndinomubuja kunalushanto mbeli kwengilozi jaMwali pakushanduka kwonchinyi umwempela.”<verse eid="LUK 15:10" /></para>
  <para style="s">Mwananhulumyana wakalashika</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11" />Jesu wakati akale, “Kwaluba nomwe unhulume wakabeli nabana banhulumyana babili, <verse eid="LUK 15:11" /><verse number="12" style="v" sid="LUK 15:12" />untukutuku wakati kuna tate babe, ‘Tate ndikobeleni chuma changu ngweno.’ Bakabakobela mububili bwabo. <verse eid="LUK 15:12" /><verse number="13" style="v" sid="LUK 15:13" />Mushule mwamazhuba mashomanana mwananhulumyana untukutuku wakatola chuma chiche akabhuda pasha akenda kunyika ikokule kasa, yoko kwaakanotataula ifuma yiye yose mubupenyu bwobuhungu. <verse eid="LUK 15:13" /><verse number="14" style="v" sid="LUK 15:14" />Payakati yompelela ifuma yiye yose, kwakaba nenzhala ihulwana kasa muneyo inyika, nokudalo wakatanga kuyabula. <verse eid="LUK 15:14" /><verse number="15" style="v" sid="LUK 15:15" />Ndipo pakenda kunoshingila umwe ungali wokunyika yakaleyo, akanopiwa unshingo wokulela ingulube muminda. <verse eid="LUK 15:15" /><verse number="16" style="v" sid="LUK 15:16" />Wakadisisa kuzwigutisa namakwepele akabepiwa ingulube, nokuti apana unhu wakompa. <verse eid="LUK 15:16" /><verse number="17" style="v" sid="LUK 15:17" />Asi paakatanga kuyeya zwanana wakati, ‘Bangana bashingi batate bangu banowana kulya kwabo kulokwana, ngweno imi yopano ndimufa nenzhala! <verse eid="LUK 15:17" /><verse number="18" style="v" sid="LUK 15:18" />Ndinobhuda yokuno ndinde kuna tate bangu ndinoti kwabali, “Tate ndakachinya kunawedenga akale nokunamwi. <verse eid="LUK 15:18" /><verse number="19" style="v" sid="LUK 15:19" />Andichilokwelela kuwhi ndiMwananhulumyana wenu, nditoleni soumwe wabashingi benu.”’ <verse eid="LUK 15:19" /><verse number="20" style="v" sid="LUK 15:20" />Wakanyamuka, akenda kuna tate babe. Wakati epamuka, echikule, tate babe pabakombona, bakawha ishungu, bakondabukila, bakomungutila akale bakomyonta. <verse eid="LUK 15:20" /><verse number="21" style="v" sid="LUK 15:21" />Mwananhulumyana wakati kwabali, ‘Tate ndakachinya kunawedenga nokunamwi, andichilokwelela kuti ndiwhi ndiMwananhulumyana wenu.’ <verse eid="LUK 15:21" /><verse number="22" style="v" sid="LUK 15:22" />Asi tate bakashoba bashingi babo bakati, ‘Kambijani! Buzani chimbalo chibuyanana kasa kupinda zwose mumbajike mumbige iseka pakanyala kake, neshangu kumakumbo awe, <verse eid="LUK 15:22" /><verse number="23" style="v" sid="LUK 15:23" />akale mubuze inamani lilokojwa, mulibulaye, tilye tishante, <verse eid="LUK 15:23" /><verse number="24" style="v" sid="LUK 15:24" />nokuti yoyu mwananhulumyana wangu wakabafa, asi wamuka, wakabalashika, asi waboneka.’ Bakatanga kushanta.<verse eid="LUK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25" />“Panoyo unshaji unkulu uwe wakaba eli kuminda, pakubuya kukwe wakati aba pelyo nengumba, wakawha bundimbwa nokuzana. <verse eid="LUK 15:25" /><verse number="26" style="v" sid="LUK 15:26" />Wakashoba umwe wabashingi akabhuza eti, ‘Ini zwimutikana?’ <verse eid="LUK 15:26" /><verse number="27" style="v" sid="LUK 15:27" />Iye wakati kwaali, ‘Ununa uwo wabuya, nokudalo tate babo babulaya inamani lilokojwa nokuti bontambula elimpenyu akale zwanana.’ <verse eid="LUK 15:27" /><verse number="28" style="v" sid="LUK 15:28" />Unkulu uwe wakanyema, aajakada kungwina mungumba. Tate babe bakabhuda, bakombweta, <verse eid="LUK 15:28" /><verse number="29" style="v" sid="LUK 15:29" />asi iye wakashandula akati kunatate babe, ‘Lingani makole ose yaya ndagala ndimushingila, akale andijanu ndaleka kutobeleja milawu yenu, koga amujakandipa kana kabujana zwako kuti nami ndishante nabakwaina bangu! <verse eid="LUK 15:29" /><verse number="30" style="v" sid="LUK 15:30" />Asi yoyu mwananhukumyana wenu, wakanopalaja ifuma yiye namavemu, ngweno wezha mwombulayila inamani lilokojwa!’ <verse eid="LUK 15:30" /><verse number="31" style="v" sid="LUK 15:31" />Asi ibo bakati, ‘Mwanangu, iwi tigele tose unshaji wose, zwose zwangu ngozwizwo. <verse eid="LUK 15:31" /><verse number="32" style="v" sid="LUK 15:32" />Asi kwabekwelela kuti tishante, nokuti ununa uwo wakabafa, asi nasi wamuka, wakabalashika, koga nasi waboneka.”’<verse eid="LUK 15:32" /></para>
  <chapter eid="LUK 15" />
  <chapter number="16" style="c" sid="LUK 16" />
  <para style="s">Unshingisi unabuchengeji</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1" />Wakati kubalayijwa babe, “Kwakaba kuli nonhu wakabakafuma waluba elingilwa ifuma yiye nonshingi; unshingi yoyu wakabelebelejwa kuwhi wakabetataula ifuma yiye. <verse eid="LUK 16:1" /><verse number="2" style="v" sid="LUK 16:2" />Nokudalo wakonshoba, akati kwaali, ‘Ini yezwi zwandiwhile nawi? Ndilungululile kuti wakabeilinga chini ifuma yangu, nokuti auchinoba unshingi wangu akale.’ <verse eid="LUK 16:2" /><verse number="3" style="v" sid="LUK 16:3" />Unshingi wakayeya nechomumwoyo uwe, eti, ‘Biya ndite chini sezwo She bangu bamuda kunditata pemishingo? Andina isimba lyokulima akale ndineshoni yokupema. <verse eid="LUK 16:3" /><verse number="4" style="v" sid="LUK 16:4" />Ndaziba kuti ndota chini, kuti banhu benditambule mujingumba jabo kana ndabhiswa unshingo.’ <verse eid="LUK 16:4" /><verse number="5" style="v" sid="LUK 16:5" />Nokudalo wakashoba umwe nomwe wakabeli nozwikwelete kunatezi uwe, akati kunawotanga, ‘Unachikweleti chemalini kunatezi wangu?’ <verse eid="LUK 16:5" /><verse number="6" style="v" sid="LUK 16:6" />Wakati, ‘Izana lyemingomo yamafuta.’ Unshingi wakati, ‘Tola lukwalo lwechikwelete chicho ugale pasi nokukambija ukwale kuti makumi mashanu.’ <verse eid="LUK 16:6" /><verse number="7" style="v" sid="LUK 16:7" />Wakabhuza umwe akale, eti, ‘Ani iwi unechikwelete chemalini?’ Wakashandula eti ‘Izana lyemihwele yegolosi.’ Unshingi wakati, ‘Tola lukwalo lwechikweleti chicho, ukwale makumi mashanu ana matatu egolosi.’ <verse eid="LUK 16:7" /><verse number="8" style="v" sid="LUK 16:8" />Nokudalo tezi boyu unshingi usilobimbika, wakakuja unshingi uwe nobuchenjevu bwakadalo, nokuti banhu bopenyika balochenjela pakuta zwinhu zwabo, kupinda bana bomwenje muchizekululu chabo.” <verse eid="LUK 16:8" /><verse number="9" style="v" sid="LUK 16:9" />akale Jesu wakati, “Bakani bukwaina bwenu mushingisa bufumi bubi bwopasi kutila kuti kana bwapela, munootambulwa mungumba jemisi isinopela. <verse eid="LUK 16:9" /><verse number="10" style="v" sid="LUK 16:10" />Iye ulobimbika munazwitukutuku, ulobimbika akale muzwikulwana, iye usilobimbika muzwitukutuku, aatobimbika muzwikulwana. <verse eid="LUK 16:10" /><verse number="11" style="v" sid="LUK 16:11" />Kana usijakabimbika mubufumi bubi bwopasi, ndiyani biya uchabimba nawi mubufumi bwechokomende? <verse eid="LUK 16:11" /><verse number="12" style="v" sid="LUK 16:12" />Akale kana usijakabimbika nezwinhu zwabamwe, biya ndiyani uchakupa zwinhu zwizwo?<verse eid="LUK 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13" />“Apana unshingi angashingila matezi mabili, nokuti angabenga umwe, eda umwe, kana kulemesa umwe, eshunda umwe. Aungashingile Mwali akale nemali.”<verse eid="LUK 16:13" /></para>
  <para style="ms">Jimwe indebo jaJesu kubaFalisi</para>
  <para style="r">(<ref loc="MAT 11:12">Mateo 11:12</ref>,<ref loc="MAT 11:13">13</ref>; <ref loc="MAT 5:31">5:31</ref>,<ref loc="MAT 5:32">32</ref>; <ref loc="MRK 10:11">Mako 10:11</ref>,<ref loc="MRK 10:12">12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14" />BaFalisi, pabakawha yezwi, nokuda imali kwabo, bakonseka Jesu. <verse eid="LUK 16:14" /><verse number="15" style="v" sid="LUK 16:15" />Koga iye wakati kwabali, “Imwi muli yabaya banozwita bakalulama mumesho abanhu, asi Mwali unoziba myoyo yenu, nokuti zwamunokuja imwi banhu zwinosheshemesa mumesho aMwali.<verse eid="LUK 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16" />“Mulawu waMozesi newhalo jabapolofeti jakabeshinga kuswikila unshaji waJoni uMbhabhatizi, kuvila yopo INdebo iMbuya yobushe bwaMwali ikumubhaunulwa wose unhu ukumuzwimanikijila mwabuli. <verse eid="LUK 16:16" /><verse number="17" style="v" sid="LUK 16:17" />Asi zwilelu kuti idenga nenyika zwipinde, kuna kuti kabala katukutuku komulawu kebhiswe.<verse eid="LUK 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18" />“Wose unoshima unkaji uwe kova elobola umwe unhukaji, unopombola, akale yoyo unolobola unhukaji wakashimwa nondume, unobepombola.<verse eid="LUK 16:18" /></para>
  <para style="s">Umfumi naLazalo</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19" />“Kwakaba kulina umfumi walumbala zwimbalo zwinalubala lwensulubele nemicheka mibuya akale elalama bupenyu bwokuzwishantisa mazhuba ose. <verse eid="LUK 16:19" /><verse number="20" style="v" sid="LUK 16:20" />Akale kwaluba nonsheti waluwhi Lazalo, egala peshubo lyolukuta, umbili uwe ulizhele zwilonda, <verse eid="LUK 16:20" /><verse number="21" style="v" sid="LUK 16:21" />wakabelakamila kulya tupemu twalumbwela tuva petebuli lyomfumi, nembwa neebo jakabezha komyanguta zwilonda zwizwe. <verse eid="LUK 16:21" /><verse number="22" style="v" sid="LUK 16:22" />Unsheti wakafa akanyamulwa nengilozi jikonsenga pechifuba chaAbhulahamu. Umfumi wakafabo akajikwa, <verse eid="LUK 16:22" /><verse number="23" style="v" sid="LUK 16:23" />elimuhadesi eyangata kasa, wakanyamula mesho awe, akabona Abhulahamu kule kule, Lazalo elipelyo naye. <verse eid="LUK 16:23" /><verse number="24" style="v" sid="LUK 16:24" />Wakashomeja eti, ‘Tate Abhulahamu ndiwhileni ishe, tumani Lazalo engwinise imhela yakanyala kake muvula, etonhoje lulimi lwangu, nokuti ndikumuyangata muntutumo yoyu.’ <verse eid="LUK 16:24" /><verse number="25" style="v" sid="LUK 16:25" />Asi Abhulahamu wakati, ‘Mwananhulumyana, yeya mubupenyu bubo wakaba upiwa zwose zwinhu zwibhodo, asi Lazalo wakaba epiwa zwinhu zwibi; feno iye umunyalajwa iwi ukumuyangata. <verse eid="LUK 16:25" /><verse number="26" style="v" sid="LUK 16:26" />Azwitoba yezwi chete, panegolonga linomila pakati pedu, linotisa kuti yabo banoda kutaluka beva yokuno bezha yoko abatotubula, apana akale angataluka eva yoko ezha kunasu.’ <verse eid="LUK 16:26" /><verse number="27" style="v" sid="LUK 16:27" />Akale wakati, ‘Tate, kana zwakadalo ndimukumbila kuti muntume kungumba yatate bangu, <verse eid="LUK 16:27" /><verse number="28" style="v" sid="LUK 16:28" />nokuti ndinabanuna bashanu, kuti enobachenjeja kutila kuti besizhe yokuno kubugalo bwokujiijwa.’ <verse eid="LUK 16:28" /><verse number="29" style="v" sid="LUK 16:29" />Koga Abhulahamu wakati, ‘Banuna babo bana naMozesi nabalebambeli baMwali, ngebebawhilile.’ <verse eid="LUK 16:29" /><verse number="30" style="v" sid="LUK 16:30" />Wakati iye, ‘Tate Abhulahamu atoba imo pe, kana umwe amuka mubafi enda kwabali, yopo bangashanduka.’ <verse eid="LUK 16:30" /><verse number="31" style="v" sid="LUK 16:31" />Iye wakati kwaali, ‘Kana besinowhilila Mozesi nabalebambeli baMwali, abangawhilile kojoba umwe amuka mubafi ebakwekweteja.”’<verse eid="LUK 16:31" /></para>
  <chapter eid="LUK 16" />
  <chapter number="17" style="c" sid="LUK 17" />
  <para style="s">Kuchinyila nolulekejelo</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1" />Wakati kubalayijwa babe, “Zwinhu zwinobuzilija luchinyo zwilokwelela kuzha, koga mayee kunoyo unozwibuzilija yezwo! <verse eid="LUK 17:1" /><verse number="2" style="v" sid="LUK 17:2" />Zwaluba zwibuya kuti ihando isungililwe munchibha mumwe etukoposelwa mugungwa pana kuti etise umwe waaba batukutuku kuti echinye. <verse eid="LUK 17:2" /><verse number="3" style="v" sid="LUK 17:3" />Chenjelani nokwenu.</para>
  <para style="p" vid="LUK 17:3">“Kana mwanakwaina uwo akuchinyila, unkalalile, kana achingunuka, undekejele. <verse eid="LUK 17:3" /><verse number="4" style="v" sid="LUK 17:4" />Kana akubipisila tushanu tuna tubili nezhuba, akale ebuya kwauli tushanu tuna tubili eti, ‘Ndakukanganisila’ iwi unokwelela kundekejela.”<verse eid="LUK 17:4" /></para>
  <para style="s">Kudimbwa</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5" />Bapositoli bakati kunaShe, “Tipamhijileni kudimbwa kwedu!”<verse eid="LUK 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6" />Tezi wakashandula eti, “Ngana kudimbwa kwenu kuli kukulwana semhuji yemasitadi, mwaluti kunti wonSikamo yoyu, ‘Nyukuka unozwijikila mugungwa’ unti yoyo walumuwhilila.<verse eid="LUK 17:6" /></para>
  <para style="s">Unshingo wechishingi</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7" />“Ndiyani pakati penu unanshingi uwe unondimila kana kunchejela imhwizi, unoti kana aswika ebhuda kuminda eti kwaali, ‘Izha nokukambija, gala pasi ulye na? <verse eid="LUK 17:7" /><verse number="8" style="v" sid="LUK 17:8" />Aatoti kwaali, ‘Bambanya chilailo changu, umbale zwilokwelela utukondilindila kuswikila ndapeja kulya nokunwa. Iwi unoolya nokunwa kana ndapeja na?’ <verse eid="LUK 17:8" /><verse number="9" style="v" sid="LUK 17:9" />Angomboka na unshingi yoyu nokuti wata zwaalayiwa kuta? <verse eid="LUK 17:9" /><verse number="10" style="v" sid="LUK 17:10" />Nokudalo ngazwibe alo nokunamwi. Kana mwata zwamwalayiwa kuta, itini, tibashingi chete, tata zwitaba tikakwelela kuta.”’<verse eid="LUK 17:10" /></para>
  <para style="s">Jesu unochilisa Banhulume Bali igumi</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11" />Palwendo lulwe lwokuJelusalema, wakapinda pakati peSamaliya neGalili. <verse eid="LUK 17:11" /><verse number="12" style="v" sid="LUK 17:12" />Echinongwina muna umwe unzi, wakatandamijwa nabanhu bali igumi bakabelwala mapelembuji ibo bakamila kule naye, <verse eid="LUK 17:12" /><verse number="13" style="v" sid="LUK 17:13" />bakashomeja beti, “Jesu, Tezi! Tiwhileni ishe!”<verse eid="LUK 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14" />Paakababona wakati kwabali, “Indani munozwitondejela kubatebuji.”</para>
  <para style="p" vid="LUK 17:14">Bechinokwenda, bakashampulujwa. <verse eid="LUK 17:14" /><verse number="15" style="v" sid="LUK 17:15" />Umwe wabo paakabona kuti wachiliswa, wakabwilila etunhumwija Mwali newhi lipo pezhulu, <verse eid="LUK 17:15" /><verse number="16" style="v" sid="LUK 17:16" />akazwiwigila pasi pamakumbo awe omboka. Yoyu unhu wakabeli unSamaliya. <verse eid="LUK 17:16" /><verse number="17" style="v" sid="LUK 17:17" />Nokudalo Jesu wakati, “Akujachiliswa bali igumi na? Bamwe bashanu nabana baipi? <verse eid="LUK 17:17" /><verse number="18" style="v" sid="LUK 17:18" />Apana wabuya kwotunhumwija Mwali kuzhe kwoyu umvakule?” <verse eid="LUK 17:18" /><verse number="19" style="v" sid="LUK 17:19" />Wakati kuna iye, “Imilika unde azwo, kudimbwa kukwo kwakuchilisa.”<verse eid="LUK 17:19" /></para>
  <para style="s">Kuswika kwobushe bwaMwali</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20" />Paakabhuzwa nabaFalisi kuti bushe bwaMwali bunoswika lini, wakabashandula eti, “Bushe bwaMwali abutozha sechitondejelo chinooboneka, <verse eid="LUK 17:20" /><verse number="21" style="v" sid="LUK 17:21" />akale abutoti, ‘Hobuno yokuno’ kana ‘Hobuya yokuya!’ Izibani kuti bushe bwaMwali bwipo pakati penu.”<verse eid="LUK 17:21" /></para>
  <para style="s">Izhuba lyoMwananhulumyana woNhu</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22" />Wakati kubalayijwa babe, “Unooswika unsi pamuchada kobona izhuba lyoMwananhulumyana wonhu, koga amutoolibona. <verse eid="LUK 17:22" /><verse number="23" style="v" sid="LUK 17:23" />Banooti kwamuli,‘Ilingani, hondiya yokuya!’ kana kuti, ‘Ilingani hoono yokuno!’ Musinde, musibatobele. <verse eid="LUK 17:23" /><verse number="24" style="v" sid="LUK 17:24" />Nokuti kuzha kwoMwananhulumyana wonhu kunooba solupenyo lunomunika kunelimwe ibhazu lyedenga lunda nokunelimwe ibhazu lyedenga unodalo Mwananhulumyana wonhu nelyo izhuba lyokuzha kukwe. <verse eid="LUK 17:24" /><verse number="25" style="v" sid="LUK 17:25" />Koga ulokwelela kusheteswa tangwa etikolambwa nechizekululu yechi. <verse eid="LUK 17:25" /><verse number="26" style="v" sid="LUK 17:26" />Sobukwakaba kuli mumazhuba aNowa, kunooba alo mumazhuba oMwananhulumyana woNhu. <verse eid="LUK 17:26" /><verse number="27" style="v" sid="LUK 17:27" />Banhu bakalya, bakanwa, banhulume nabanhukaji bakalobola nokulobojwa kukajine kukaswika izhuba lyaakangwina mubwato Nowa, mapopoma evula akezha akabapalaja bose. <verse eid="LUK 17:27" /><verse number="28" style="v" sid="LUK 17:28" />Akale zwinanga sezwakatiwa mumazhuba aLoti, bakalya, bakanwa, bakatenga, bakatengesa, bakabyala, bakabaka, <verse eid="LUK 17:28" /><verse number="29" style="v" sid="LUK 17:29" />koga nezhuba lyokubhuda kwaLoti muSodoma, kwakana moto nesalifa uva kudenga zwikabapalaja bose, <verse eid="LUK 17:29" /><verse number="30" style="v" sid="LUK 17:30" />zwinooba alo nezhuba lyaachatondejelwa Mwananhulumyana woNhu. <verse eid="LUK 17:30" /><verse number="31" style="v" sid="LUK 17:31" />Nelyo izhuba, yoyo unooba eli pedenga lyengumba, eli nezwibiya zwizwe mungumba, esibheluke kuti ezwitole, noyo unobeli muminda, esibwilile mushule. <verse eid="LUK 17:31" /><verse number="32" style="v" sid="LUK 17:32" />Kumbulukwani unkaji waLoti. <verse eid="LUK 17:32" /><verse number="33" style="v" sid="LUK 17:33" />Yoyo unoda kulondota bupenyu bubwe unolashikilwa nabo, asi yoyo unobulasha, unoobulondota. <verse eid="LUK 17:33" /><verse number="34" style="v" sid="LUK 17:34" />Ndinomubuja, noobo busiku babili banoba belilele pabulo bumwempela, umwempela unootolwa, umwe akasiyiwa. <verse eid="LUK 17:34" /><verse number="35" style="v" sid="LUK 17:35" />Banhukaji babili banooba bekwiya pamwempela, umwe unootolwa, umwe akasiyiwa.” <verse eid="LUK 17:35" /><verse number="36" style="v" sid="LUK 17:36" />Bakombhuza bakati, “Ngokupi, Tezi?” <verse eid="LUK 17:36" /><verse number="37" style="v" sid="LUK 17:37" />Wakashandula akati, “Yopo pana untumbi, magola anobungana.”<verse eid="LUK 17:37" /></para>
  <chapter eid="LUK 17" />
  <chapter number="18" style="c" sid="LUK 18" />
  <para style="b" />
  <para style="s">Unkwejaniso wenchilikaji nontongi</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1" />Wakababuja unkwejaniso, kuti banokwelela kunamata benangatila, besinonyala. <verse eid="LUK 18:1" /><verse number="2" style="v" sid="LUK 18:2" />Wakati, “Kwakaba kuli nontongi, mune limwe iguta, wakaba esinotya Mwali akale esinolemekeja banhu, <verse eid="LUK 18:2" /><verse number="3" style="v" sid="LUK 18:3" />muguta lyakalelyo kwakaba kuli nenchilikaji yakabezha kwaali iti, ‘Ndibhanche kumbengi wangu.’ <verse eid="LUK 18:3" /><verse number="4" style="v" sid="LUK 18:4" />Wakatola unshaji undefu esinovuma, koga kumapejelejo wakayeya akati, ‘Kojoba ndisinotya Mwali kana kulemekeja banhu, <verse eid="LUK 18:4" /><verse number="5" style="v" sid="LUK 18:5" />koga nokuti inchilikaji yeyi ikumunangatila, ndoyipa chilulamiso chailokwelela kutila kuti isibendinyaja nokugala izha.”’<verse eid="LUK 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6" />She wakandilambeli eti, “Iwhani zwinolebwa nontongi usilolulama. <verse eid="LUK 18:6" /><verse number="7" style="v" sid="LUK 18:7" />Feno Mwali aatobapa na indulamilo jabo bose baloshalwa babe banolila kwaali masikati nobusiku ? Uchajilwa na kubashandula? <verse eid="LUK 18:7" /><verse number="8" style="v" sid="LUK 18:8" />Ndinomubuja, uchabapa indulamo jabo nokukambija. Koga Mwananhulumyana woNhu paachezha, unoowana balodimbwa na penyika?”<verse eid="LUK 18:8" /></para>
  <para style="s">Unkwejaniso womFalisi noNtelesi</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9" />Jesu wakababuja unkwejaniso yoyu, kunaaboyabo bakabeyeya kuti ndibo balolulama akale belingila bamwe pasi, akati: <verse eid="LUK 18:9" /><verse number="10" style="v" sid="LUK 18:10" />“Pakabelipo banhu babili bakenda mutempeli kunonamata, umwe wakabeli umFalisi, umwe eli untelesi. <verse eid="LUK 18:10" /><verse number="11" style="v" sid="LUK 18:11" />UmFalisi wakama, akanamata eti, ‘Mwali, ndinomuboka, nokuti anditokwelana nabamwe banhu, mapazwi, basilolulama, nabapomboli, kana kuba soyu untelesi. <verse eid="LUK 18:11" /><verse number="12" style="v" sid="LUK 18:12" />Ndinozwiminya kulya kabili neviki, ndinopila chegumi chezwose zwandinowana.’ <verse eid="LUK 18:12" /><verse number="13" style="v" sid="LUK 18:13" />Koga untelesi wakamila kule, esinoda kulinga zhezhulu kudenga, wakaloba chifuba chiche eti, ‘Mwali ibani neshe kwandili imi unchinyi!’ <verse eid="LUK 18:13" /><verse number="14" style="v" sid="LUK 18:14" />Ndinomubuja, yoyu unhu wakenda kungumba kukwe alulamiswa, asi yondiya umwe pe, nokuti yoyo unozwifufumula unootonhobajwa, noyo unozwininipisa, unonyamulwa”<verse eid="LUK 18:14" /></para>
  <para style="s">Jesu unokombolela bana batukutuku</para>
  <para style="r">(<ref loc="MAT 19:13-15">Mateo 19:13-15</ref>; <ref loc="MRK 10:13-16">Mako 10:13-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15" />Feno bakabuza bana kuti ebakombolele, koga balayijwa pabakabona yezwi, bakabakabula. <verse eid="LUK 18:15" /><verse number="16" style="v" sid="LUK 18:16" />Koga Jesu wakabashoba kwaali akati,“ Lekejani bana bezhe kwandili musibajibise, nokuti bushe bwaMwali ngobwaba bakadai. <verse eid="LUK 18:16" /><verse number="17" style="v" sid="LUK 18:17" />Chokomende, ndinoti kunamwi, wose usinotambula bushe bwaMwali somwana untukutuku, aatobungwina.”<verse eid="LUK 18:17" /></para>
  <para style="s">Unhulume ulofuma.</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mateo 19:16-30</ref>; <ref loc="MRK 10:17-31">Mako 10:17-31</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18" />Umwe untungamili wakombhuza eti,“ Ndayiji umbuya, ndinokwelela kutani kuti ndiwane bupenyu businopela?”<verse eid="LUK 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19" />Jesu wakati kwaali, “Unondishobelani kuti ndimbuya? Apana umbuya kuzhe kwaMwali ega. <verse eid="LUK 18:19" /><verse number="20" style="v" sid="LUK 18:20" />Unoyiziba milawo inoti: Usipombole, usibulaye, usikwibe, usisumikijile manyepwa, lemesa tate babo namai babo.”<verse eid="LUK 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21" />Iye wakashandula akati,</para>
  <para style="b" vid="LUK 18:21">“Zwose yezwi ndakazwilondota kuva kubutukutuku bwangu.”<verse eid="LUK 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22" />Paakawha yezwi, Jesu wakati kwaali: “Kuna chinhu chimwempela chilosalilila. Tengesa zwose zwaunanazwo ukobele basheti, ndipo pauchaba nefuma kudenga utukozha unditobele.” <verse eid="LUK 18:22" /><verse number="23" style="v" sid="LUK 18:23" />Paakawha yezwi, wakawushubala, nokuti wakaba ekafuma kasakasa.<verse eid="LUK 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 18:24" />Jesu wakondinga, akati, “Zwikukutu chini kuti yabo bakafuma bengwine mubushe bwaMwali! <verse eid="LUK 18:24" /><verse number="25" style="v" sid="LUK 18:25" />Nokuti zwilelu kuti ikamela lipinde pakati pakabanga keneleti, kuna kuti umfumi engwine mubushe bwaMwali.”<verse eid="LUK 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26" />Bakabe kawhilila yezwi bakati, “Ndiyani biya angachijwa?”<verse eid="LUK 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27" />Koga iye wakati, “Zwibasinotubula banhu, Mwali unozwitubula.”<verse eid="LUK 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28" />Pita wakati, “Isu takasiya mizi yedu tikakutobela.”<verse eid="LUK 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29" />Wakati kwabali, “Chokomende ndinomubuja, apana unhu wakasiya unzi kana unkaji kana banakwaina kana bazwali kana bana pezhulu pobushe bwaMwali, <verse eid="LUK 18:29" /><verse number="30" style="v" sid="LUK 18:30" />usinoolipwa kanji mumisi yobupenyu bwopasi nomumisi yobupenyu businopela bunozha.”<verse eid="LUK 18:30" /></para>
  <para style="s">Jesu unolebeleka ketatu nozwolufu lulwe</para>
  <para style="r">(<ref loc="MAT 20:17-19">Mateo 20:17-19</ref>; <ref loc="MRK 10:32-34">Mako 10:32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31" />Wakatola bali igumi nababili akati kwabali, “Iwhani, timunda kuJelusalema akale zwose zwakakwalwa nabalebambeli baMwali pezhulu poMwananhulumyana woNhu, zwinozhajikijwa. <verse eid="LUK 18:31" /><verse number="32" style="v" sid="LUK 18:32" />Nokuti unoopilwa kuna bokuzhe, akale unoosekwa, unootukwa akale nokufhilwa namate, <verse eid="LUK 18:32" /><verse number="33" style="v" sid="LUK 18:33" />pabachoopeja kuunyangatisa, banoombulaya, koga nezhuba lyatatu unoomuka kubafi akale.”<verse eid="LUK 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34" />Asi abajakazwiwhisisa yezwi, zwakaba zwikasisika kwabali bakakonwa kuwhisisa zwaakabeleba.<verse eid="LUK 18:34" /></para>
  <para style="s">Jesu unochilisa unhu usinobona</para>
  <para style="r">(<ref loc="MAT 20:29-34">Mateo 20:29-34</ref>; <ref loc="MRK 10:46-52">Mako 10:46-52</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35" />Paakati abapelyo neJeliko, kwakaba kulinonhu ibhofu wakabeligele kumbali kwenzila ekumbila, <verse eid="LUK 18:35" /><verse number="36" style="v" sid="LUK 18:36" />paakawha idupwa lyabanhu lipinda, wakabhuza kuti ini yezwo.<verse eid="LUK 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 18:37" />Bakombuja kuti, “Jesu wokuNazaleti ukumupinda.”<verse eid="LUK 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38" />Wakashomeja eti, “Jesu Mwananhulumyana waDavidi, ndiwhile ishe!”<verse eid="LUK 18:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39" />Banhu bakabelimbeli bakonkalalila kuti ewhilijile koga iye wakanyanya kushomeja kasa eti, “Mwananhulumyana waDavidi ndiwhile ishe!” <verse eid="LUK 18:39" /><verse number="40" style="v" sid="LUK 18:40" />Jesu wakama akabalaya kuti bombuze kwaali, paakaswika pelyo, wakombhuza eti, <verse eid="LUK 18:40" /><verse number="41" style="v" sid="LUK 18:41" />“Unoda kuti ndikutileni?”</para>
  <para style="p" vid="LUK 18:41">Wakashandula eti, “Tezi ndite kuti ndibone.”<verse eid="LUK 18:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42" />Jesu wakati kwaali, “Bhwazula, kudimbwa kukwo kwakuchilisa.”<verse eid="LUK 18:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 18:43" />Pakalepo, mesho awe akazhulika, akontobela Jesu, ekuja Mwali, nabanhu bose pabakabona yezwi, bakatunhumwija Mwali.<verse eid="LUK 18:43" /></para>
  <chapter eid="LUK 18" />
  <chapter number="19" style="c" sid="LUK 19" />
  <para style="s">Jesu naZakeu</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1" />Wakangwina muJeliko, epinda mukati. <verse eid="LUK 19:1" /><verse number="2" style="v" sid="LUK 19:2" />Mwakaba muli nonhulume unowhi Zakeu, eli untelesi unkulwana, ekafuma. <verse eid="LUK 19:2" /><verse number="3" style="v" sid="LUK 19:3" />Wakaba edisisa kuti ebone kuti Jesu ndiyani, koga wakakonelwa kuumbona pezhulu pabanhu banji, nokuti iye wakaba eli umfupi. <verse eid="LUK 19:3" /><verse number="4" style="v" sid="LUK 19:4" />Nokudalo, wakalabuka mbeli akanotanha munti wonSikamo kuti ombone pakupinda kukwe. <verse eid="LUK 19:4" /><verse number="5" style="v" sid="LUK 19:5" />Jesu paakaswika pakale, wakalinga zhezhulu, akati kwaali, “Zakeu, bhuluka munti nokukambija nokuti ndokwelela kugala kungumba yiyo nasi.”<verse eid="LUK 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 19:6" />Wakakimbija kubhuluka, akoontambula nolushanto. <verse eid="LUK 19:6" /><verse number="7" style="v" sid="LUK 19:7" />Pabakabona yezwi, banhu bose bakanyunyuta beti, “Wenda kunoba mwezi wonchinyi.”<verse eid="LUK 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8" />Koga Zakeu wakamilika akati kunaShe, “Bonani, Tezi, ndichakamula pakati nopakati chuma changu ndipe basheti, kana pana undakachengela, ndinompa chuma chiche zwilopamhwa kana.”<verse eid="LUK 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9" />Jesu wakati kwaali, “Nasi luchijo lwezha kuneyi ingumba nokuti yoyu neebo mwananhulumyana waAbhulahamu. <verse eid="LUK 19:9" /><verse number="10" style="v" sid="LUK 19:10" />Mwananhulumyana woNhu wakezha kwoshaka nokuchija bakalashika.”<verse eid="LUK 19:10" /></para>
  <para style="s">Unkwejaniso wemali yendalama</para>
  <para style="r">(<ref loc="MAT 25:14-30">Mateo 25:14-30</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11" />Bechakawhilila yezwi, wakendila mbeli akababuja unkwejaniso, nokuti wakaba aba pelyo neJelusalema naibo bakaba beyeya kuti bushe bwaMwali bwakaba buzwitondejela nokukambija. <verse eid="LUK 19:11" /><verse number="12" style="v" sid="LUK 19:12" />Nokudalo, wakati, “Umwe unhulume unozwalwa kungumba yobushe wakenda kunyika iko kule kunoponchwa bushe, nokubuya mushule mwezwo. <verse eid="LUK 19:12" /><verse number="13" style="v" sid="LUK 19:13" />Wakashoba igumi lyabashingi babe, wakabapa makobeli igumi, akababuja kuti, ‘Itani zwokushambaja nemali yeyi kujine ndibuye.’ <verse eid="LUK 19:13" /><verse number="14" style="v" sid="LUK 19:14" />Koga banhu bomunyika yiye bakombenga bakatuma batumwa mushule mumwe kuti benoti, ‘Atidi kuti unhu yoyu etitonge.’<verse eid="LUK 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15" />Wakati abuya mushule mwokuponchwa kukwe bushe, wakatumila bashingi babe baakaba asiyila imali, kuti beshobwe, ebone kuyizwalisa kwabo kwabakabekwelela kuti bete. <verse eid="LUK 19:15" /><verse number="16" style="v" sid="LUK 19:16" />Wokutanga wakezha akati, ‘Tezi, ikobeli lyenu lyakazwala amwe ali igumi.’ <verse eid="LUK 19:16" /><verse number="17" style="v" sid="LUK 19:17" />Iye wakati kwaali, ‘Wazwita, unshingi umbuya! Nokuti waaba nokubimbika muchinhu chitukutuku, ndokupa masimba pezhulu pamakuta ali igumi.’ <verse eid="LUK 19:17" /><verse number="18" style="v" sid="LUK 19:18" />Wabili wakezha eti, ‘Tezi, ikobeli lyenu lyakazwala mamwe mashanu.’ <verse eid="LUK 19:18" /><verse number="19" style="v" sid="LUK 19:19" />Wakati kuna yoyu, ‘Naibo ndokupa bukulwana kumakuta mashanu.’ <verse eid="LUK 19:19" /><verse number="20" style="v" sid="LUK 19:20" />Wakezha umwebo, eti, ‘Tezi, heli ikobeli lyenu, ndakaliputila muncheka, <verse eid="LUK 19:20" /><verse number="21" style="v" sid="LUK 19:21" />nokuti ndakabemutya kuti munhu unamwoyo unkukutu, motola pamusabiga chinhu, movuna pamusakabyala.’ <verse eid="LUK 19:21" /><verse number="22" style="v" sid="LUK 19:22" />Iye wakati kwaali, ‘Namawhi awo, ndokupa undandu, iwi unshingi umbi! Iwi wakabeziba kuti ndinkukutu, ndotola zwindisakabiga, ndovuna zwindisakabyala? <verse eid="LUK 19:22" /><verse number="23" style="v" sid="LUK 19:23" />Ini usakabiga ikobeli lyangu mubhenki? Pakubuya kwangu, ndalolitola lyazwala.’ <verse eid="LUK 19:23" /><verse number="24" style="v" sid="LUK 19:24" />Wakati kuna yabo bakabelimile pelyo, ‘Tolani ikobeli kwaali, mupe yoyo unegumi lyamakobeli.’ <verse eid="LUK 19:24" /><verse number="25" style="v" sid="LUK 19:25" />Asi bakati kwaali, ‘Tezi seni una igumi lyamakobeli kale.’ <verse eid="LUK 19:25" /><verse number="26" style="v" sid="LUK 19:26" />‘Ndinomubuja, umwe nomwe unanazwo, unoopiwa zwimwe, koga yoyo usina, unootolelwa zwishoma zwanobelinanazwo.’ <verse eid="LUK 19:26" /><verse number="27" style="v" sid="LUK 19:27" />‘Akale babengi bangu, yabo basakada kuti ndibatonge, babuzeni yopano mubabulaye pambeli kwangu.”’<verse eid="LUK 19:27" /></para>
  <para style="s">Jesu unongwina muJelusalema</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mateo 21:1-11</ref>; <ref loc="MRK 11:1-11">Mako 11:1-11</ref>; <ref loc="JHN 12:12-19">Joni 12:12-19</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28" />Mushule mwamawhi yaya, wakenda mbeli kwabo mulwendo, enda kuJelusalema. <verse eid="LUK 19:28" /><verse number="29" style="v" sid="LUK 19:29" />Wakati aba pelyo neBhetifaji nokuBhetani, pedunhu linowhi Olivi, wakatuma balayijwa babe babili, <verse eid="LUK 19:29" /><verse number="30" style="v" sid="LUK 19:30" />eti, “Indani kunzi ulolingana namwi, mungongwina mukati, muchawana mwana wedonki usanu ukagadwa nonhu, ukasungililwa, muunsupule muzhe nawo yokuno. <verse eid="LUK 19:30" /><verse number="31" style="v" sid="LUK 19:31" />Kana umwe unhu emubhuza kuti, ‘Mukumukasupulilani biya?’ Muumbuje kuti, “Tezi unoida.”<verse eid="LUK 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32" />Batumwa yabaya bakenda, bakanowana sokuleba kukwe. <verse eid="LUK 19:32" /><verse number="33" style="v" sid="LUK 19:33" />Pabakati belimukusupula mwana wedonki, beni bakati kwabali, “Monsupulilani mwana wedonki?”<verse eid="LUK 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34" />Ibo bakati, “She unounshaka.” <verse eid="LUK 19:34" /><verse number="35" style="v" sid="LUK 19:35" />Bakombuza kunaJesu, bakawala micheka yabo pezhulu, bakombhancha kugada. <verse eid="LUK 19:35" /><verse number="36" style="v" sid="LUK 19:36" />Paakabekwenda, bakawala ingubo jabo mungwagwa.<verse eid="LUK 19:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37" />Wakati aba pelyo nomungenyuka wedunhu lyeOlivi, idupwa lyose lyabalayijwa lyakatanga kushomeja bekuja Mwali pezhulu pemishingo yiye yabakaba babona, <verse eid="LUK 19:37" /><verse number="38" style="v" sid="LUK 19:38" />beti, “Ulokombolelwa Tezi unozha muzina lyaShe. Lunyalalo kudenga nolukujo pezhuluzhulu.” <verse eid="LUK 19:38" /><verse number="39" style="v" sid="LUK 19:39" />Bamwe babaFalisi bakabeli mubunga lyabanhu bakati kuna iye, “Ndayiji, kabulani balayijwa benu.”<verse eid="LUK 19:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40" />Iye wakashandula eti, “Ndinomubuja, kana bangowhilijila mabwe ndiwo achashomeja!”<verse eid="LUK 19:40" /></para>
  <para style="s">Jesu unolilila iJelusalema</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41" />Wakati aba pelyo, ebona iguta, wakalililila, <verse eid="LUK 19:41" /><verse number="42" style="v" sid="LUK 19:42" />eti, “Ngana uziba nasi zwinhu zwinobuza lunyalalo! Koga feno yezwi zwilosisika mumesho awo. <verse eid="LUK 19:42" /><verse number="43" style="v" sid="LUK 19:43" />Nokuti mazhuba anoozha pauchatilwa lukuta, uzunilwa nababengi babo, kumapazu ose, <verse eid="LUK 19:43" /><verse number="44" style="v" sid="LUK 19:44" />unoowigilwa pasi, iwi nabana babo mukati, apana ibwe lichasala pezhulu pelimwe, nokuti aujakaziba izhuba lyokushanyilwa kukwo.”<verse eid="LUK 19:44" /></para>
  <para style="s">Jesu unonda kuTempeli</para>
  <para style="r">(<ref loc="MAT 21:12-17">Mateo 21:12-17</ref>; <ref loc="MRK 11:15-19">Mako 11:15-19</ref>; <ref loc="JHN 2:13-22">Joni 2:13-22</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45" />Wakangwina mutempeli, akatangisa kutatamila bakabetengesa, <verse eid="LUK 19:45" /><verse number="46" style="v" sid="LUK 19:46" />eti kwabali, “Kulokwalwa kuti, ‘Ingumba yangu inooba ingumba yokunamata.’ koga imwi mwaita ibhako lyembava.”<verse eid="LUK 19:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47" />Wakabelayija muTempeli mazhuba ose. Batebuji bakulwana, bakwali, nabatungamili babanhu, bakabeshaka kuumbulaya, <verse eid="LUK 19:47" /><verse number="48" style="v" sid="LUK 19:48" />koga bakashayiwa kuti baluzwita chini yezwi, nokuti banhu bose bakabesimatila kuwha mawhi awe.<verse eid="LUK 19:48" /></para>
  <chapter eid="LUK 19" />
  <chapter number="20" style="c" sid="LUK 20" />
  <para style="s">Umbhuzo nesimba lyaJesu</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mateo 21:23-27</ref>; <ref loc="MRK 11:27-33">Mako 11:27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1" />Limwe izhuba echinolayija banhu mutempeli ebhaunula iNdebo iMbuya, bakulwana babatebuji nabakwali bomulawo akale nabakulugulu bose bakezha, <verse eid="LUK 20:1" /><verse number="2" style="v" sid="LUK 20:2" />beti kwaali, “Tibuje, unowawana kupi masimba okuta yezwi kana kuti ndiyani wakakupa masimba yaya?”<verse eid="LUK 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3" />Wakabashandula eti, “Nami ndichamubhuza chinhu chimwempela, ndibujeni, <verse eid="LUK 20:3" /><verse number="4" style="v" sid="LUK 20:4" />umbhabhatizo waJoni wakava kuna Mwali kana kubanhu?”<verse eid="LUK 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5" />Bakatanga kubhuzana chabochabo beti, “Tingoti kudenga, uchati, ‘Ani biya ini musakadimbwa mwaali?’ <verse eid="LUK 20:5" /><verse number="6" style="v" sid="LUK 20:6" />Asi tingoti, ‘Kubanhu’ banhu bose banotipubula namabwe, nokuti balogunchikana kuti Joni wakabeli undebambeli waMwali.” <verse eid="LUK 20:6" /><verse number="7" style="v" sid="LUK 20:7" />Nokudalo bakashandula beti, abatoziba kuti lwakava kupi.<verse eid="LUK 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8" />Jesu wakati kunaibo, “Nami neebo anditomubuja kuti yezwi ndozwita nesimba lyani.”<verse eid="LUK 20:8" /></para>
  <para style="s">Unkwejaniso wabacheneki bominda wonzhambi</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mateo 21:33-46</ref>; <ref loc="MRK 12:1-12">Mako 12:1-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9" />Wakatanga kubuja banhu unkwejaniso yoyu: “Unhu wakabyala unzhambi muminda uwe, akabhatisa balimi unda uwe, akenda kuneimwe inyika kwonshaji undefu. <verse eid="LUK 20:9" /><verse number="10" style="v" sid="LUK 20:10" />Pawakaswika unshaji, wakatuma unshingi kubalimi kuti benonkobelabo unchelo wonzhambi, asi balimi bakondoba unshingi, bakombwiliza esina zwalosenga. <verse eid="LUK 20:10" /><verse number="11" style="v" sid="LUK 20:11" />Wakatuma umwe unshingi; noyu bo bakondoba, bakombhata nenzila isina chilemelela, bakombwiliza esina chinhu. <verse eid="LUK 20:11" /><verse number="12" style="v" sid="LUK 20:12" />Wakatuma unshingi watatu, yoyu bakondwajisa bakontatamila. <verse eid="LUK 20:12" /><verse number="13" style="v" sid="LUK 20:13" />Nokudalo mweni wominda wonzhambi wakati, ‘Ndotani biya? Ndobatumila mwananhulumyana wangu unodikana, ateni banonoundemekeja.’ <verse eid="LUK 20:13" /><verse number="14" style="v" sid="LUK 20:14" />Balimi yaba pabakombona, bakalangana bakati, ‘Yoyu ndiye undyi wefuma, atiumbulayeni kutila kuti ifuma ibe yedu!’ <verse eid="LUK 20:14" /><verse number="15" style="v" sid="LUK 20:15" />Nokudalo bakomposela kuzhe kwominda wonzhambi bakombulaya.</para>
  <para style="p" vid="LUK 20:15">“Ani biya ini zwaachata kubalimi mweni wominda wonzhambi?” <verse eid="LUK 20:15" /><verse number="16" style="v" sid="LUK 20:16" />“Unoozha kwobabulaya balimi yaba, kova epa unda wonzhambi uwe kunabamwe balimi.”</para>
  <para style="p" vid="LUK 20:16">Pabakazwiwha yezwi, bakati “Pe pe kusibe alo!”<verse eid="LUK 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17" />Koga wakabalinga akati, “Zwinolebani biya yezwi zwakakwalwa zwinoti:</para>
  <para style="q1" vid="LUK 20:17">‘Ibwe lyakalambwa nababaki,</para>
  <para style="q2" vid="LUK 20:17">ndilyo lyakooba ilyo linodikana kasa.’<verse eid="LUK 20:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="LUK 20:18" />Wose unhu unowila panelyo ibwe unoovunauka ebe zwibabi asi kana yelo ibwe lingombwelela pezhulu ponhu linoompwachaula.”<verse eid="LUK 20:18" /></para>
  <para style="s">Umbhuzo nokulipa mutelo</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mateo 22:15-22</ref>; <ref loc="MRK 12:13-17">Mako 12:13-17</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19" />Bakwali bomulawo nabakulwana babatebuji bakakweja kuunsunga pakale yopo, asi bakatya banhu; nokuti bakaziba kuti unkwejaniso wakabeleba ibo, <verse eid="LUK 20:19" /><verse number="20" style="v" sid="LUK 20:20" />Bakondingilija kuti bompyangile undandu, bakatuma bachengeji kuti bezwite balolulama, kuti bombhate namawhi aachaleba, kutila kuti bompile kubatongi. <verse eid="LUK 20:20" /><verse number="21" style="v" sid="LUK 20:21" />Bakombhuza beti, “Ndayiji, tinoziba kuti munoleba nokulayija ichokomende, amuna ishalulo, asi molayija inzila yaMwali nechokomende. <verse eid="LUK 20:21" /><verse number="22" style="v" sid="LUK 20:22" />Tinovumilwa kulipa mutelo kunaKesali kana ne?”<verse eid="LUK 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23" />Koga iye abona buchengeji bwabo, wakati kwabali, <verse eid="LUK 20:23" /><verse number="24" style="v" sid="LUK 20:24" />“Nditondejeni ikobeli lina untojaniso wani nezina lyani?” Bakati, “WaKesali.”<verse eid="LUK 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25" />Wakati kwabali, “Nokudalo ipani kunaKesali zwinhu zwaKesali, kunaMwali zwinhu zwaMwali.”<verse eid="LUK 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26" />Nokudalo abajakongwanila undandu muna zwaakaleba pambeli pabanhu, bakachenamiswa nenshandulo yiye, bakawhilijila.<verse eid="LUK 20:26" /></para>
  <para style="s">Umbhuzo nokumuka kubafi</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mateo 22:23-33</ref>; <ref loc="MRK 12:18-27">Mako 12:18-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27" />Kwakezha kwaali bamwe babaSadusi, ibo banoti, akuna kumuka mukufa, <verse eid="LUK 20:27" /><verse number="28" style="v" sid="LUK 20:28" />bakombhuza beti, “Ndayiji, Mozesi wakatikwalila mulawo eti, ‘Kana unhulume afa kova esiya unkaji esina mwana, ununa unokwelela kulobola inchilikaji ezwalile unkulu bana.’ <verse eid="LUK 20:28" /><verse number="29" style="v" sid="LUK 20:29" />Feno kwakabeli banhulumyana bashanu banababili, wokutanga wakalobola akafa esanhu aba nabana, <verse eid="LUK 20:29" /><verse number="30" style="v" sid="LUK 20:30" />nowabili neebo, <verse eid="LUK 20:30" /><verse number="31" style="v" sid="LUK 20:31" />watatu neebo wakontola akata alo, bose beli bashanu bana babili bakafa besaba nabana. <verse eid="LUK 20:31" /><verse number="32" style="v" sid="LUK 20:32" />Kumapejelejo unhukaji yoyu wakafabo. <verse eid="LUK 20:32" /><verse number="33" style="v" sid="LUK 20:33" />Pakumuka kwabakafa unooba unkaji wani? Nokuti bose belibashanu banababili bakabako ndobola?”<verse eid="LUK 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34" />Jesu wakati kwabali, “Banhu bonshaji yono banolobolana, <verse eid="LUK 20:34" /><verse number="35" style="v" sid="LUK 20:35" />asi yabo balomilila unshaji ukumuzha akale banoomuka kubafi, abatoolobolana, <verse eid="LUK 20:35" /><verse number="36" style="v" sid="LUK 20:36" />nokuti abachinoofa, banokwelana nengilozi akale bana baMwali beli bana bokumuka kubafi. <verse eid="LUK 20:36" /><verse number="37" style="v" sid="LUK 20:37" />Asi nenyaya yokumuswa kwabakafa, naMozesi wakatondejela pachena pakututuma kwedenje, paakashobelela Tezi eti ‘ndiMwali waAbhulahamu, naMwali waIsaki naMwali waJakobe.’ <verse eid="LUK 20:37" /><verse number="38" style="v" sid="LUK 20:38" />Feno aatoba Mwali wabakafa koga wabapenyu, nokuti bose bapenyu nomunaiye.”<verse eid="LUK 20:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39" />Bamwe bakwali bomulawo bakashandula beti, “Ndayiji mwashandula zwibuyanana.” <verse eid="LUK 20:39" /><verse number="40" style="v" sid="LUK 20:40" />Bakava bakatya kuumbhuza mimwe mibhuzo.<verse eid="LUK 20:40" /></para>
  <para style="s">Umbhuzo pezhulu paMesiya</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mateo 22:41-46</ref>; <ref loc="MRK 12:35-37">Mako 12:35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41" />Koga wakati kwabali, “Ini biya Kristo ewhi Mwananhulumyana waDavidi? <verse eid="LUK 20:41" /><verse number="42" style="v" sid="LUK 20:42" />Nokuti Davidi nokukwe unoti mulukwalo lweJimbo,</para>
  <para style="q1" vid="LUK 20:42">“Tezi wakati kuna Tezi wangu:</para>
  <para style="q2" vid="LUK 20:42">“Gala kululyi lwangu,<verse eid="LUK 20:42" /></para>
  <para style="q2">
    <verse number="43" style="v" sid="LUK 20:43" />kuswikila babengi babo baba chitobelelo chamakumbo awo.”<verse eid="LUK 20:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="LUK 20:44" />Davidi unoonshoba eti “Tezi unoba mwananhulumyana uwe chini?”<verse eid="LUK 20:44" /></para>
  <para style="s">Jesu unochenjeja pezhulu paBakwali bomulawo</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mateo 23:1-36</ref>; <ref loc="MRK 12:38-40">Mako 12:38-40</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45" />Banhu bose bechinowhilila, wakati kubalayijwa babe, <verse eid="LUK 20:45" /><verse number="46" style="v" sid="LUK 20:46" />“Chenjelelani bakwali, banoda kumbala zwimbalo zwilefu, banoda kumuswa kana beli kumusika, banoda kugala pezwigalo zwabanolemekejwa muSinagogi nokumabhiko, <verse eid="LUK 20:46" /><verse number="47" style="v" sid="LUK 20:47" />banokwibila inchilikaji jingumba jabo akale banota minamato milefu kuti beyebwe. Banoolangwa pakulwana kasa!”<verse eid="LUK 20:47" /></para>
  <chapter eid="LUK 20" />
  <chapter number="21" style="c" sid="LUK 21" />
  <para style="s">Umpilo wenchilikaji</para>
  <para style="r">(<ref loc="MRK 12:41-44">Mako 12:41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1" />Wakanyamula mesho awe akabona bafumi bebiga zwipo zwabo munsangwa yompilo, <verse eid="LUK 21:1" /><verse number="2" style="v" sid="LUK 21:2" />akabona inchilikaji yaluba unsheti ibiga makobeli mabili. <verse eid="LUK 21:2" /><verse number="3" style="v" sid="LUK 21:3" />Wakati iye, “Chokomende ndinomubuja, yeyi inchilikaji inosheta yabiga zwinji zwinopinda zwabamwe bose, <verse eid="LUK 21:3" /><verse number="4" style="v" sid="LUK 21:4" />nokuti bose yaba babiga zwibavubula mufuma yabo, inchilikaji yakakuhumula zwose zwayakabeli nazwo pakulalama kwayo.”<verse eid="LUK 21:4" /></para>
  <para style="s">Kupalajwa kweTempeli</para>
  <para style="r">(<ref loc="MAT 24:1">Mateo 24:1</ref>,<ref loc="MAT 24:2">2</ref>; <ref loc="MRK 13:1">Mako 13:1</ref>,<ref loc="MRK 13:2">2</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5" />Bamwe pabakabelebeleka nokuyebeka kwetempeli namabwe mabhodo akale nezwipo zwakabepilwa, iye wakati, <verse eid="LUK 21:5" /><verse number="6" style="v" sid="LUK 21:6" />“Zwose yezwi zwinhu zwimubweni, unshaji unooswika wokuti apana ibwe limwempela lichoosala likabambwa pezhulu pelimwe, lisakolomolelwa pasi.”<verse eid="LUK 21:6" /></para>
  <para style="s">Inyajo nenjabuliso</para>
  <para style="r">(<ref loc="MAT 24:3-14">Mateo 24:3-14</ref>; <ref loc="MRK 13:3-13">Mako 13:3-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7" />Bakombhuza bakati, “Ndayiji, biya zwinootikana lini yezwi, akale, ini chichaba chitondejelo chokuti zwalobotikana?”<verse eid="LUK 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8" />Iye wakati, “Chenjelani musichengwe, nokuti banji banoozha muzina lyangu beti, ‘Ndimi iye!’ akale beti, ‘Unshaji wabapelyo!’ Musibatobele. <verse eid="LUK 21:8" /><verse number="9" style="v" sid="LUK 21:9" />Musitye kana muwha jihondo nokumukilana, nokuti yezwi zwinokwelela kuti zwitikane tangwa, kupela akutokambija kuswika.” <verse eid="LUK 21:9" /><verse number="10" style="v" sid="LUK 21:10" />Wakati akale kwabali, “Inyika imwe inoomukila imwe inyika, nobushe bunoomukila bumwebo bushe, <verse eid="LUK 21:10" /><verse number="11" style="v" sid="LUK 21:11" />kunooba nokudengunuka kukulwana kwenyika, ibhamba, malwaji, nozwitiko zwibi kunabose bugalo, akale kunooba nezwitondejelo zwinotyisa zwiva kudenga. <verse eid="LUK 21:11" /><verse number="12" style="v" sid="LUK 21:12" />Asi zwisanu zwatikana zwose yezwi, banoomusunga nokumuyangatisa, akale bemusenga mumasinagogo nokumubiga muntolongo, munoomiswa mbeli kwamashe nabatongi pezhulu pezina lyangu. <verse eid="LUK 21:12" /><verse number="13" style="v" sid="LUK 21:13" />Yoyu unooba unshaji wenu wokuti musumikije. <verse eid="LUK 21:13" /><verse number="14" style="v" sid="LUK 21:14" />Nokudalo zwiyeyeni mumyoyo yenu, kutila kuti musizwinyaje kuti munooshandula mutini, <verse eid="LUK 21:14" /><verse number="15" style="v" sid="LUK 21:15" />nokuti imi ndoomupa mawhi namaano anoota kuti babengi benu bekonwe kumuzunda kana kumukakabaja. <verse eid="LUK 21:15" /><verse number="16" style="v" sid="LUK 21:16" />Munoosengwa kwabali nabazwali, nabanakwaina benu, akale nabakwaina benu, bamwe benu banoobulayiwa, <verse eid="LUK 21:16" /><verse number="17" style="v" sid="LUK 21:17" />Munoobengwa nabanhu bose pezhulu pezina lyangu. <verse eid="LUK 21:17" /><verse number="18" style="v" sid="LUK 21:18" />Asi apana kana limwempela lyesusu munsholo mwenu lichoolashika. <verse eid="LUK 21:18" /><verse number="19" style="v" sid="LUK 21:19" />Mukusima kwenu munoowana bupenyu.<verse eid="LUK 21:19" /></para>
  <para style="s">Kupalajwa kweJelusalema</para>
  <para style="r">(<ref loc="MAT 24:15-21">Mateo 24:15-21</ref>; <ref loc="MRK 13:14-19">Mako 13:14-19</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20" />“Kana mukabona Jelusalema yazyungulukilwa nabalwi, zibani kuti kupalajwa kwayo kwaba pelyo. <verse eid="LUK 21:20" /><verse number="21" style="v" sid="LUK 21:21" />Nokudalo lekani yabo baiko kuJudiya betizhile kumatunhu, nayabo baimo mukati mweguta bebhude, naabo baiko kumizi besingwine, <verse eid="LUK 21:21" /><verse number="22" style="v" sid="LUK 21:22" />nokuti yaya ndiwo mazhuba olubwilizilo, kuti zwose yezwo zwakakwalwa zwizhajikijwe. <verse eid="LUK 21:22" /><verse number="23" style="v" sid="LUK 21:23" />Mayee kunabo banemimba, namamai banomwisa munayo mazhuba! Kunooba neshungu penyika nolunya kuluji yolu, <verse eid="LUK 21:23" /><verse number="24" style="v" sid="LUK 21:24" />banoobulayiwa negwalabaza akale banoopambilwa kunyika jose, neJelusalema linootobwa namakumbo abokuzhe kujine unshaji wabo bokuzhe wazhajikijwa.<verse eid="LUK 21:24" /></para>
  <para style="s">Kuzha kwoMwananhulumyana woNhu</para>
  <para style="r">(<ref loc="MAT 24:29-31">Mateo 24:29-31</ref>; <ref loc="MRK 13:24-27">Mako 13:24-27</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25" />“Kunooba nezwitondejelo zwichatikana kuzhuba, kumweji nokunyenyeji, nopenyika induji jinooba neshungu, jinyajwa nokukampa nontimbo wegungwa, <verse eid="LUK 21:25" /><verse number="26" style="v" sid="LUK 21:26" />banhu banoopela isimba nokutya akale nokumilila zwinobezha munyika, nokuti masimba edenga anoodengunuka. <verse eid="LUK 21:26" /><verse number="27" style="v" sid="LUK 21:27" />Akale banoobona mwananhulumyana wonhu ezha elimugole elinamasimba nolukujo lukulwana. <verse eid="LUK 21:27" /><verse number="28" style="v" sid="LUK 21:28" />Kana zwinhu yezwi zwatanga kutikana, nyamukani, munyamule misholo yenu mulinge zhezhulu, nokuti luchijo lwenu lwaba pelyo.”<verse eid="LUK 21:28" /></para>
  <para style="s">Unkwejaniso wonkuyu</para>
  <para style="r">(<ref loc="MAT 24:32-35">Mateo 24:32-35</ref>; <ref loc="MRK 13:28-31">Mako 13:28-31</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29" />Wakababuja unkwejaniso eti, “Lingani unkuyu neimwe yose miti, <verse eid="LUK 21:29" /><verse number="30" style="v" sid="LUK 21:30" />Ikangotangisa kukwinila, momuka nokuziba kuti izhizha lyaba pelyo. <verse eid="LUK 21:30" /><verse number="31" style="v" sid="LUK 21:31" />Nokudalo, mungobona zwinhu yezwi zwitikana, zibani kuti bushe bwaMwali bwaba pelyo.<verse eid="LUK 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32" />“Ndinolebesa nditi kwamuli, chizekululu chisanhu chapinda, zwose yezwi zwinhu zwinooba zwatikana. <verse eid="LUK 21:32" /><verse number="33" style="v" sid="LUK 21:33" />Idenga nenyika zwinoopela, koga mawhi angu aatoopela.<verse eid="LUK 21:33" /></para>
  <para style="s">Galani mwakabhwazula</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34" />“Zwichenjeleleni kuti myoyo yenu isibhatikane nobuhungu, nokukolwa, nokulakamila zwobupenyu, kuti yelyo izhuba lisoomuswikila musinoliyeyela, <verse eid="LUK 21:34" /><verse number="35" style="v" sid="LUK 21:35" />nokuti linoozha pezhulu ponhu wose upo penyika. <verse eid="LUK 21:35" /><verse number="36" style="v" sid="LUK 21:36" />Nokudalo galani mwakabhwazula, munamata kuti mube nesimba lyokutizha zwose zwichootika, nokuma mbeli kwoMwananhulumyana woNhu.”<verse eid="LUK 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37" />Akale mazhuba ose wakabelayija muTempeli, asi nonshaji wamadeko wakabenda kunolala mudunhu linowhi Olivi. <verse eid="LUK 21:37" /><verse number="38" style="v" sid="LUK 21:38" />Zhingwanangwana, banhu bose bakabezha kwaali koonwhilila mutempeli.<verse eid="LUK 21:38" /></para>
  <chapter eid="LUK 21" />
  <chapter number="22" style="c" sid="LUK 22" />
  <para style="s">Kuchetwa kwaJesu</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1" />Unshaji wemilya yechinkwa chisina umfufumuso, inowhi Pasika yakababa pelyo. <verse eid="LUK 22:1" /><verse number="2" style="v" sid="LUK 22:2" />Batebuji bakulwana nabakwali bakaba bepyanga kuti bangombulaya chini; asi bakabetya banhu.<verse eid="LUK 22:2" /></para>
  <para style="s">Judasi unocheta Jesu</para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 22:3" />Guluzhanje wakangwina muna Judasi, wakaba ewhi Sikaliyoti, eli umwe wabegumi lina babili, <verse eid="LUK 22:3" /><verse number="4" style="v" sid="LUK 22:4" />wakenda kubatebuji bakulwana namakulukota kuti angompila chini kwabali. <verse eid="LUK 22:4" /><verse number="5" style="v" sid="LUK 22:5" />Bakashantilwa bakavumilana kuti banompa imali. <verse eid="LUK 22:5" /><verse number="6" style="v" sid="LUK 22:6" />Nokudalo wakavuma akashaka unshaji ulokwelela kuti angompila chini kwabali pesina banhu banji.<verse eid="LUK 22:6" /></para>
  <para style="s">Jesu unolonganyila chilayilo chePasika.</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7" />Lyakaswika izhuba lyemilya yechinkwa chisina umfufumuso akale lili izhuba lyePasika pakunobulayiwa imhwizana <verse eid="LUK 22:7" /><verse number="8" style="v" sid="LUK 22:8" />Nokudalo Jesu wakatuma Pita naJoni, eti, “Indani munotibambanyila ipasika kuti toolya.” <verse eid="LUK 22:8" /><verse number="9" style="v" sid="LUK 22:9" />Bakati kwaali, “Moda kuti tibambanyile kupi?” <verse eid="LUK 22:9" /><verse number="10" style="v" sid="LUK 22:10" />Wakati kwabali, “Mungongwina muguta, moshangana nonhulume ulosenga ihali yevula, muntobele munongwina mungumba yaachangwina, <verse eid="LUK 22:10" /><verse number="11" style="v" sid="LUK 22:11" />muti kumweni wengumba, ‘Undayiji unoti kwamuli: Iponi ingumba yabezi mundichalyila ipasika nabalayijwa bangu?’ <verse eid="LUK 22:11" /><verse number="12" style="v" sid="LUK 22:12" />Iye uchanomutondeja ingumba ihulwana ipopezhulu inazwibiya zwose mukati, mubambanyile iyo.” <verse eid="LUK 22:12" /><verse number="13" style="v" sid="LUK 22:13" />Bakenda bakanowana sezwaakabaleba, bakava babambanyila ipasika.<verse eid="LUK 22:13" /></para>
  <para style="s">Chilayilo chaShe</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14" />Pawakati waswika unshaji, wakagala pakulya nabo bapositoli. <verse eid="LUK 22:14" /><verse number="15" style="v" sid="LUK 22:15" />Wakati kwabali, “Ndabedisisisa kuti ndilye ipasika yeyi namwi ndisanhu ndayabula, <verse eid="LUK 22:15" /><verse number="16" style="v" sid="LUK 22:16" />ndinomubuja kuti anditoolya kujine zwizhajikijwe mubushe bwaMwali.”<verse eid="LUK 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 22:17" />Wakatola unkombe akaboka akati, “Tolani yoyu, mukobelane; <verse eid="LUK 22:17" /><verse number="18" style="v" sid="LUK 22:18" />nokuti ndinomubuja nditi kuvila ngweno andichinoonwa akale chinwiwa chonzhambi kuswikila bushe bwaMwali bwaswika.”<verse eid="LUK 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19" />Wakatola akale, chinkwa, akaboka, akachimedula, akabapa eti, “Yoyu umbili wangu, uchapilwa imwi, galani muta ali kuti mundikumbulukile pakale.” <verse eid="LUK 22:19" /><verse number="20" style="v" sid="LUK 22:20" />Bakati bapeja chilayilo, wakati, “Yoyu unkombe chivumilano chipya chelopa lyangu lichookutukila imwi.”<verse eid="LUK 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 22:21" />Asi lingani, luboko lwoyo uchandicheta lunanami yopano petebuli. <verse eid="LUK 22:21" /><verse number="22" style="v" sid="LUK 22:22" />“Nokuti Mwananhulumyana woNhu ukumunda sobuzwakamisilwa, asi mayee kunoyo unhu uchoncheta!”<verse eid="LUK 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 22:23" />Pakalepo bakatanga kubhuzana kuti kungaba ani pakati pabo angata chinhu chakadalo.<verse eid="LUK 22:23" /></para>
  <para style="s">Bukulwana bwechokomende.</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24" />Kwakaba nokukakabajana pakati pabo kuti ndiyani angaba unkulwana wabo. <verse eid="LUK 22:24" /><verse number="25" style="v" sid="LUK 22:25" />Wakati kwabali, “Mashe abokuzhe anamasimba pezhulu pabo, yabo banamasimba pezhulu pabo banoshobwa sababhanchi babanhu. <verse eid="LUK 22:25" /><verse number="26" style="v" sid="LUK 22:26" />Asi zwisibe alo pakati penu; yoyu unkulwana pakati penu ngaabe iye soti ndiye untukutuku, neebo untungamili ngaabe sonshingi. <verse eid="LUK 22:26" /><verse number="27" style="v" sid="LUK 22:27" />Ndiyani unkulwana, yoyo unogala pakulya, kana yoyo unoshingila? Aatoba yoyo ugele pakulya na? Koga imi ndipo pakati penu soyo ukumushingila.<verse eid="LUK 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 22:28" />Ndimwi yabo balamba beli nami mukukwejwa kwangu, <verse eid="LUK 22:28" /><verse number="29" style="v" sid="LUK 22:29" />feno ndomupa bushe somubakandipa Tate, <verse eid="LUK 22:29" /><verse number="30" style="v" sid="LUK 22:30" />kuti mulye nokunwa petebuli lyangu mubushe bwangu, akale mogala zwigalo zwobushe mutonga induji igumi nembili jokwaIzilaeyli.<verse eid="LUK 22:30" /></para>
  <para style="s">Pita unolamba Jesu.</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31" />“Simoni, Simoni, whilila, Satani wakumbila kuti ekupyeke sekoloni, <verse eid="LUK 22:31" /><verse number="32" style="v" sid="LUK 22:32" />asi ndakunamatila, kuti usikonwe mukudimbwa kukwo; asi ungochingunuka, simisa banakwaina babo.”<verse eid="LUK 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33" />Wakashandula eti, “She, imi ndilozwipila kunda muntolongo nokufa namwi.” <verse eid="LUK 22:33" /><verse number="34" style="v" sid="LUK 22:34" />Wakati, “Ndokubuja Pita, kuti igukulume lisanhu lyakokolika nasi, unoba wandilamba katatu kuti autondiziba.”<verse eid="LUK 22:34" /></para>
  <para style="s">Chikwama, nehobhodo negwalabaza</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35" />Wakati kunaibo, “Pandakamutuma musina ihobhodo kana chikwama kana ishangu, pana zwamwakashayiwa na?” Bakati, “Apana.”<verse eid="LUK 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36" />Wakati kwabali, “Asi feno, yoyo unanechikwama ngechitole, unanehobhodo ngete zwakalezwo. Noyo usina igwalabaza ngetengese ijasi lilye etukotenga igwalabaza.” <verse eid="LUK 22:36" /><verse number="37" style="v" sid="LUK 22:37" />Nokuti ndomubuja kuti zwilokwelela kuzhajikijwa zwinhu yezwi zwilokwalwa pezhulu pangu zwokuti, “Unoobalilwa nabachinyi, yezwi zwakakwalwa mumakwalo pezhulu pangu zwikumuzhajikijwa.” <verse eid="LUK 22:37" /><verse number="38" style="v" sid="LUK 22:38" />Bakati, “She, lingani yopano haya makwalabaza mabili.” Iye akati, “Zwakwana.”<verse eid="LUK 22:38" /></para>
  <para style="s">Jesu unonamata kudunhu lyeOlivi</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39" />Wakabhuda, samazhuba ose akenda kudunhu lyeOlivi; balayijwa babe bakontobela. <verse eid="LUK 22:39" /><verse number="40" style="v" sid="LUK 22:40" />Paakaswika kwakale, wakati kwabali, “Namatani kuti musingwine mukukwejwa.”<verse eid="LUK 22:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 22:41" />Wakabasiya akasosoloka kwonshizho unanga sokuposwa kwebwe akanofhigama akanamata, <verse eid="LUK 22:41" /><verse number="42" style="v" sid="LUK 22:42" />eti, “Tate kana muda, bhisani unkombe yoyu kunami, kusibe kuda kwangu, koga kuda kwenu ngakutiwe.” <verse eid="LUK 22:42" /><verse number="43" style="v" sid="LUK 22:43" />Akale kwakaboneka ingilozi kwaali iva kudenga ikoonsimisa. <verse eid="LUK 22:43" /><verse number="44" style="v" sid="LUK 22:44" />Elimukulwajilwa wakanamata neshungu, akale idukuta lilye lyakaba samadonwe makulwana elopa akabedonela pasi.<verse eid="LUK 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45" />Paakanyamuka kuva mukunamata, wakabwilila kwakabeli balayijwa akabawana belilele neshungu jabo, <verse eid="LUK 22:45" /><verse number="46" style="v" sid="LUK 22:46" />wakati kwabali, “Molalilani biya? Mukani munamate, kutila kuti musingwine mukukwejwa.”<verse eid="LUK 22:46" /></para>
  <para style="s">Kusungwa kwaJesu</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47" />Wakati echinolebeleka, kwakaswika igapo lyabanhu, likatungamililwa naJudasi wakabeli umwe wabegumi lina babili.Wakenda pelyo naJesu kuti omyonte, <verse eid="LUK 22:47" /><verse number="48" style="v" sid="LUK 22:48" />asi Jesu wakati kwaali, “Judasi unompila mwananhulumyana wonhu nokumyonta kani?” <verse eid="LUK 22:48" /><verse number="49" style="v" sid="LUK 22:49" />Pabakabona zwalutobela, yabo bakabekwenda naye bakati, “She titeme negwalabaza na?” <verse eid="LUK 22:49" /><verse number="50" style="v" sid="LUK 22:50" />Umwe wabo wakatema akadubula inzebe yokululyi yondanda wontebuji unkulwana.<verse eid="LUK 22:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51" />Asi Jesu wakati, “Zwakwana yezwi!” Wakaguma inzebe akonchilisa.<verse eid="LUK 22:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52" />Jesu wakati kubatebuji bakulwana, nabatungamilili babalindi beTempeli nabakulugulu bakaba bezha nolubengo kwaali, eti, “Mwezha kwandili namakwalabaza akale neswimbo sofana ndimpambi na? <verse eid="LUK 22:52" /><verse number="53" style="v" sid="LUK 22:53" />Pandakabeli namwi muTempeli mazhuba ose amujakakweja kundisunga. Koga yoyu ndiwo unshaji wenu, nowesimba lyenhilima.”<verse eid="LUK 22:53" /></para>
  <para style="s">Pita unolamba Jesu</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54" />Bakombhata bakenda naye kungumba yontebuji unkulwana. Pita wakatobela ekwendela kule; <verse eid="LUK 22:54" /><verse number="55" style="v" sid="LUK 22:55" />Pakabangijwa moto pakati polubazhe, Pita wakagala pakati pabo. <verse eid="LUK 22:55" /><verse number="56" style="v" sid="LUK 22:56" />Umwe undandakaji wakombona eligele pamoto, akondingisisa akati, “Yoyu unhulume neebo wabeli naye.”<verse eid="LUK 22:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57" />Koga wakalamba, akati “Awe nhukaji anditounziba.” <verse eid="LUK 22:57" /><verse number="58" style="v" sid="LUK 22:58" />Mushule monshaji umfupi umwe akale wakombona akati, “Nawibo uli umwe wabo!”</para>
  <para style="p" vid="LUK 22:58">Asi Pita wakati, “Awe nhulume anditoba iye pe!”<verse eid="LUK 22:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59" />Mushule kwonshaji weawa lingaba limwempela, umwe wakanangatila eti, “Chokomende unhulume yoyu ndiye wabeli naye, nokuti unGalili.”<verse eid="LUK 22:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60" />Asi Pita wakati, “Awe nhulume anditozwiziba zwaumulebeleka.”</para>
  <para style="p" vid="LUK 22:60">Pakalepo echinolebeleka igukulume lyakakokolika. <verse eid="LUK 22:60" /><verse number="61" style="v" sid="LUK 22:61" />She wakachingunuka akondinga Pita. Ndipo Pita paakakumbulukwa mawhi aShe pakalebeleka kwaali eti, “Igukulume lisanu lyakokolika nasi, unooba wandilamba katatu.” <verse eid="LUK 22:61" /><verse number="62" style="v" sid="LUK 22:62" />Wakabhuda akenda pazhe akanolila kasakasa.<verse eid="LUK 22:62" /></para>
  <para style="s">Jesu unoshungulujwa.</para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63" />Yabo banhulume bakaba bakombhata Jesu bakonsota akale bondoba <verse eid="LUK 22:63" /><verse number="64" style="v" sid="LUK 22:64" />bakomfuka kumesho, bakati, “Polofita kuti ndiyani wakuloba?” <verse eid="LUK 22:64" /><verse number="65" style="v" sid="LUK 22:65" />Bakaleba mawhi manji bontuka.<verse eid="LUK 22:65" /></para>
  <para style="s">Jesu unomiswa mbeli kweGota</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66" />Pakwakeja, bakashangana begota lyabatebuji bakulwana, nabakwali; bakombuza mbeli kwegota lyabo, bakati, <verse eid="LUK 22:66" /><verse number="67" style="v" sid="LUK 22:67" />“Tibuje kana ndiwi Kristo.”</para>
  <para style="p" vid="LUK 22:67">Koga iye wakati kwabali, “Kana ndingomubuja amutondidimbwa, <verse eid="LUK 22:67" /><verse number="68" style="v" sid="LUK 22:68" />akale ndingomubhuza, amutondishandula. <verse eid="LUK 22:68" /><verse number="69" style="v" sid="LUK 22:69" />Asi kuvila ngweno mwananhulumyana woNhu unoogala kuluboko lwokululyi lwamasimba aMwali.” <verse eid="LUK 22:69" /><verse number="70" style="v" sid="LUK 22:70" />Bose bakati, “Iwi uMwananhulumyana waMwali na?” Wakati kwabali, “Seni ndimwi mumuleba moga.” <verse eid="LUK 22:70" /><verse number="71" style="v" sid="LUK 22:71" />Bakati, “Ani biya tichinoda busumikiji bweni? Tazwiwhila isu nokwedu zwava mundomo mumwe.”<verse eid="LUK 22:71" /></para>
  <chapter eid="LUK 22" />
  <chapter number="23" style="c" sid="LUK 23" />
  <para style="s">Jesu pambeli kwaPilato</para>
  <para style="r">(<ref loc="MAT 27:1">Mateo 27:1</ref>,<ref loc="MAT 27:2">2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="MRK 15:1-5">Mako 15:1-5</ref>; <ref loc="JHN 18:28-38">Joni 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1" />Igapo lyose lyabanhu lyakanyamuka likonsenga kunaPilato. <verse eid="LUK 23:1" /><verse number="2" style="v" sid="LUK 23:2" />Bakatanga kuumpa undandu beti, “Unhu yoyu tongwana eniepela banhu, ekanganisa inyika yedu eti banhu besilipe mutelo kunaKesali akale umuti ndiye Kristo She.”<verse eid="LUK 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3" />Pilato wakombhuza eti, “Uli She wabaJuda na?”</para>
  <para style="p" vid="LUK 23:3">Iye wakashandula eti, “Seni ndiwi wazwileba.”<verse eid="LUK 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4" />Pilato wakati kubatebuji bakulwana nebunga lyabanhu, “Andibweni undandu kunoyu unhulume.”<verse eid="LUK 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 23:5" />Koga ibo bakasimisa beti, “Ukumukunijila banhu nokulayija kukwe muJudiya yose, kuva kuGalili nokuno kwose.”<verse eid="LUK 23:5" /></para>
  <para style="s">Jesu pambeli paHelodi</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6" />Paakawha yezwi, Pilato wakabhuza kuti yoyu unhu angaba wokuGalili na? <verse eid="LUK 23:6" /><verse number="7" style="v" sid="LUK 23:7" />Paakaziba kuti upopasi pobushe bwaHelodi, wakontumila kunaHelodi, iye waluba muJelusalema noyo unshaji. <verse eid="LUK 23:7" /><verse number="8" style="v" sid="LUK 23:8" />Helodi wakashantilwa kasa kubona Jesu, nokuti wakabadisisa kwonshaji undefu kumbona nokuti wakabawha nezwizwe, ebimba kuti angabona chichenamiso chitiwa naiye. <verse eid="LUK 23:8" /><verse number="9" style="v" sid="LUK 23:9" />Wakombhuza mibhuzo kwonshaji undefu; koga iye aajakashandula. <verse eid="LUK 23:9" /><verse number="10" style="v" sid="LUK 23:10" />Batebuji bakulwana nabakwali bakasimatija kumpa undandu. <verse eid="LUK 23:10" /><verse number="11" style="v" sid="LUK 23:11" />Neebo Helodi nabalwi babe bakonsota, bakombajika chimbalo chibhodo, bakombwiliza kunaPilato. <verse eid="LUK 23:11" /><verse number="12" style="v" sid="LUK 23:12" />Helodi naPilato bakava baba bakwaina, kojoba mushule bakabebengana.<verse eid="LUK 23:12" /></para>
  <para style="s">Jesu unotongelwa kufa</para>
  <para style="r">(<ref loc="MAT 27:15-26">Mateo 27:15-26</ref>; <ref loc="MRK 15:6-15">Mako 15:6-15</ref>; <ref loc="JHN 18:39-19:16">Joni 18:39—19:16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13" />Pilato wakashoba pamwempela batebuji bakulwana nabatungamili nabanhu, <verse eid="LUK 23:13" /><verse number="14" style="v" sid="LUK 23:14" />akati kwabali, “Mwabuza unhu yoyu kwandili mumpa undandu wokusungilija kuti banhu bepanduke, Pandombhuzisisa mbeli kwenu, imi andijongwana elinondandu sokuleba kwenu, <verse eid="LUK 23:14" /><verse number="15" style="v" sid="LUK 23:15" />kana Helodi ajongwana nondandu, wombwiliza kwatili. Apana zwaakata zwaalokwelela kuti ebulayiwe. <verse eid="LUK 23:15" /><verse number="16" style="v" sid="LUK 23:16" />Nokudalo ndichonabha nditukondeka ende azwe.” <verse eid="LUK 23:16" /><verse number="17" style="v" sid="LUK 23:17" />Ngweno wakabakasungilwa kusunungula unhu umwempela pamabhiko.<verse eid="LUK 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18" />Asi bose bakazholomoka pamwempela beti, “Yoyu ngefe, mutisunungulile Bhalabhasi!” <verse eid="LUK 23:18" /><verse number="19" style="v" sid="LUK 23:19" />Unhulume wakaba asungilwa imhelemhele yakabatikana muguta akale nokubulaya unhu.<verse eid="LUK 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20" />Pilato wakapamha kwabali eda kusupula Jesu; <verse eid="LUK 23:20" /><verse number="21" style="v" sid="LUK 23:21" />asi bakashomeja beti, “Unkahamile! Unkahamile!” <verse eid="LUK 23:21" /><verse number="22" style="v" sid="LUK 23:22" />Pilato wakalebeleka lwatatu kwabali akati, “Ani wakata undandu ni unhu yoyu? Imi ndongwana esina undandu unokwelela kuti ebulayiwe, nokudalo ndichonabha chete nditukounsungunula.”<verse eid="LUK 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23" />Asi ibo bakanangatila kuzholomoka beti ekahamilwe. Mawhi abo akazunda. <verse eid="LUK 23:23" /><verse number="24" style="v" sid="LUK 23:24" />Untongo waPilato wakaba wokuti zwibakabeda zwitiwe. <verse eid="LUK 23:24" /><verse number="25" style="v" sid="LUK 23:25" />Nokudalo wakasungunula yondiya wakabasungilwa imhelemhele nokubulaya unhu; akabapila Jesu kuti bonte zwabakabeda<verse eid="LUK 23:25" /></para>
  <para style="s">Jesu unokahamilwa panchinjikwa</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mateo 27:32-44</ref>; <ref loc="MRK 15:21-32">Mako 15:21-32</ref>; <ref loc="JHN 19:17-27">Joni 19:17-27</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26" />Pabakaba benda naye, bakabhata nesimba umwe unowhi Simoni wokuSayilini wakabeva kuminda, bakonyamulisa unchinjikwa mushule mwaJesu.<verse eid="LUK 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 23:27" />Igapo lyabanhu igulwana lyakontobela Jesu, pamwempela namamai bakabelila nokukwiila. <verse eid="LUK 23:27" /><verse number="28" style="v" sid="LUK 23:28" />Koga Jesu wakachebukila kwabali akati, “Mamai eJelusalema, musindililile imi, koga zwililileni imwi nabana benu. <verse eid="LUK 23:28" /><verse number="29" style="v" sid="LUK 23:29" />Nokuti mazhuba akumuzha pabachooti, ‘Balokombolelwa basinozwala, bezwizwalilo zwisanu zwazwala, nabanamazhamu asakamwisa.’ <verse eid="LUK 23:29" /><verse number="30" style="v" sid="LUK 23:30" />Banootanga kuti kumatunhu, ‘wilani pezhulu pedu!’ nokututunhu, ‘Tisiseni.’ <verse eid="LUK 23:30" /><verse number="31" style="v" sid="LUK 23:31" />Nokuti kana yezwi zwitiwa kunti unyolo, ini zwichatiwa kunti wakakoma?”<verse eid="LUK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32" />Bakatungamija bo bamwe bapanduki babili kuti benobulayiwa. <verse eid="LUK 23:32" /><verse number="33" style="v" sid="LUK 23:33" />Pabakaswika kubugalo bunowhi “Bhepe lyonsholo,” bakonkahamila pamwe nabapanduki babili, umwe kululyi umwe kuchesho. <verse eid="LUK 23:33" /><verse number="34" style="v" sid="LUK 23:34" />Jesu wakati, “Tate balekejeleni nokuti abatoziba zwibakumuta.”</para>
  <para style="p" vid="LUK 23:34">Bakakandila kuti bekobelana zwimbalo zwizwe. <verse eid="LUK 23:34" /><verse number="35" style="v" sid="LUK 23:35" />Banhu bakama belingilija, nabatongi bakonseka beti, “Wakachija bamwe, neebo ngezwichije, kana eliKristo unshalwa waMwali!” <verse eid="LUK 23:35" /><verse number="36" style="v" sid="LUK 23:36" />Nabalwi behondo bakonseka, besendela kwaali kuti bompe iwaini inopanyuka, <verse eid="LUK 23:36" /><verse number="37" style="v" sid="LUK 23:37" />beti, “Kana uli She wabaJuda, zwichije!”<verse eid="LUK 23:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38" />Kwakaba kuli nonkwalo pezhulu pape, unoti, “Yoyu ndiShe wabaJuda.”<verse eid="LUK 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39" />Umwe wabapanduki wakabakakahamilwa yopo wakondebela bubi eti, “Autoba Kristo na? Zwichije utichijebo.”<verse eid="LUK 23:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40" />Koga umwe wakadabila onkalalila eti, “Autotya Mwali na, aubweni iwi kuti watongelwa zwilokwelana naye kuti ufe. <verse eid="LUK 23:40" /><verse number="41" style="v" sid="LUK 23:41" />Kulangwa kwedu kuno kwendelana nezwito zwedu, asi yoyu unhu apana chibi chaakata.” <verse eid="LUK 23:41" /><verse number="42" style="v" sid="LUK 23:42" />Wakati iye, “Jesu undiyeye ungoswika kubushe bubo.”<verse eid="LUK 23:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43" />Wakati kunaiye, “Chokomende ndinoti kwauli, nasi yelino unoba nami muPaladiso.”<verse eid="LUK 23:43" /></para>
  <para style="s">Kufa kwaJesu</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mateo 27:45-56</ref>; <ref loc="MRK 15:33-41">Mako 15:33-41</ref>; <ref loc="JHN 19:28-30">Joni 19:28-30</ref>)</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44" />Kwakababa iawa yashanu nemwempela, kukaba nenhilima ishango lyose kujine kukaba iawa yashanu ina mana, <verse eid="LUK 23:44" /><verse number="45" style="v" sid="LUK 23:45" />izhuba lyasikatilwa, uncheka womuTempeli ukajeluka pakati nopakati. <verse eid="LUK 23:45" /><verse number="46" style="v" sid="LUK 23:46" />Jesu wakalila eshomeja newhi igulwana, akati, “Tate ndinopila umpepo wangu mumaboko enu.” Paakapeja kuleba yezwi wakafema kopejisila.<verse eid="LUK 23:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47" />Untungamili wezana lyabalwi behondo, paakabona zwatikana, wakakuja Mwali eti, “Yoyu unhu chokomende wabakalulama.”<verse eid="LUK 23:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 23:48" />Banhu banji bakabezha kolingilila, pabakabona zwatikana, bakabwilila kumisha yabo beloba zwifuba zwabo neshungu. <verse eid="LUK 23:48" /><verse number="49" style="v" sid="LUK 23:49" />Akale bose bakabezibana naye, pamwempela namamai bakabontobela beva kuGalili bakamila kule bekalinga yezwi zwitikano.<verse eid="LUK 23:49" /></para>
  <para style="s">Kujikwa kwaJesu</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mateo 27:57-61</ref>; <ref loc="MRK 15:42-47">Mako 15:42-47</ref>; <ref loc="JHN 19:38-42">Joni 19:38-42</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50" />Kwakaba kuli nonhu unowhi Josefa, wakabeva kuAlimatiya. Wakabeli imhingu yeGota igulwana, ekalulama akale elemekejwa, <verse eid="LUK 23:50" /><verse number="51" style="v" sid="LUK 23:51" />iye aajakabavuma zwakababambwa nabamwe kuti zwitiwe, iye wakava kuJudini iguta lyomuAlimatiya bakamilila bushe bwaMwali. <verse eid="LUK 23:51" /><verse number="52" style="v" sid="LUK 23:52" />Unhulume yoyu wakenda kunaPilato, akakumbila untumbu waJesu. <verse eid="LUK 23:52" /><verse number="53" style="v" sid="LUK 23:53" />Wakontulula, akomputilija muncheka akombiga mugumbu lyakabachiwa pamwala lisanu lyalajikwa untumbu mukati. <verse eid="LUK 23:53" /><verse number="54" style="v" sid="LUK 23:54" />Lyakaba lili izhuba lyokubambanyila, akale neSabata yakaba ilimukutanga.<verse eid="LUK 23:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55" />Mamai bakabezha beva kuGalili beli naye, bakatobela mushule, bakabona igumbu nondajikilo wontumbu,<verse eid="LUK 23:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 23:56" />Akale bakabwilila bakalonganyila bunde namafuta okunguba. Nezhuba lyeSabata bakanyetutuka sezwakazwilebwa nomulawu.<verse eid="LUK 23:56" /></para>
  <chapter eid="LUK 23" />
  <chapter number="24" style="c" sid="LUK 24" />
  <para style="s">Kumuka kwaJesu</para>
  <para style="r">(<ref loc="MAT 28:1-10">Mateo 28:1-10</ref>; <ref loc="MRK 16:1-8">Mako 16:1-8</ref>; <ref loc="JHN 20:1-10">Joni 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1" />Nezhuba lyokutanga lyeviki, kumijelo, bakanyamula bunde bwabakabalonganya bakenda kugumbu. <verse eid="LUK 24:1" /><verse number="2" style="v" sid="LUK 24:2" />Bakawana ibwe lyakungulijwa lyabhiswa pegumbu, <verse eid="LUK 24:2" /><verse number="3" style="v" sid="LUK 24:3" />asi pabakangwina, bakawana untumbu waShe Jesu usimo mukati. <verse eid="LUK 24:3" /><verse number="4" style="v" sid="LUK 24:4" />Bechinochenamiswa nezwi, kwakaboneka banhulume babili bekambala ingubo jinopenya, pelyo nabo; <verse eid="LUK 24:4" /><verse number="5" style="v" sid="LUK 24:5" />bechakazhala nolutyo, banhukaji bakatibhama, kova banhulume beti kwabali, “Munoshakilani umpenyu mukati munabakafa na? <verse eid="LUK 24:5" /><verse number="6" style="v" sid="LUK 24:6" />Yeyani zwaakaleba kunamwi paakamuka, eli muGalili, <verse eid="LUK 24:6" /><verse number="7" style="v" sid="LUK 24:7" />eti, Mwananhulumyana woNhu unokwelela kupilwa mumaboko abachinyi, ekahamilwe, nezhuba lyatatu, emuke mukufa.”<verse eid="LUK 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 24:8" />Bakava bakumbulukwa mawhi awe, <verse eid="LUK 24:8" /><verse number="9" style="v" sid="LUK 24:9" />bakabwilila beva kugumbu bakanoleba zwose kubalayijwa bali igumi nomwempela, nokuna bamwe bose. <verse eid="LUK 24:9" /><verse number="10" style="v" sid="LUK 24:10" />Kwakakuli Mariya Magadalena, Johana, Mariya amai baJemusi nabamwe mamai bakaba beli nabo, pabakaba bebuja bapositoli, <verse eid="LUK 24:10" /><verse number="11" style="v" sid="LUK 24:11" />koga mawhi yaya akaba sofana mayabwe, nokudalo abajakadimbwa nayo. <verse eid="LUK 24:11" /><verse number="12" style="v" sid="LUK 24:12" />Koga Pita wakanyamuka akalabuka enda kugumbu, wakaswika akashozhela akabona zwimbalo zwomugumbo koga pesina zwimwe akale, kova ebwilila kusha akachenamiswa nezwakabatikana.<verse eid="LUK 24:12" /></para>
  <para style="s">Munzila yokuEmausi</para>
  <para style="r">(<ref loc="MRK 16:12">Mako 16:12</ref>,<ref loc="MRK 16:13">13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13" />Nelyo izhuba bamwe babili bakaba benda kunoumwe unzi unowhi Emausi, unshizho ungaba mamaili mashanu ana mabili kuva kuJelusalema, <verse eid="LUK 24:13" /><verse number="14" style="v" sid="LUK 24:14" />bakabeli mukuzuwa pezhulu pezwakabatikana. <verse eid="LUK 24:14" /><verse number="15" style="v" sid="LUK 24:15" />Bechinolebeleka nokuzuwa, Jesu wakezha kunaibo akakwendesana nabo. <verse eid="LUK 24:15" /><verse number="16" style="v" sid="LUK 24:16" />Koga mesho abo akakonwa kuti boonzibe. <verse eid="LUK 24:16" /><verse number="17" style="v" sid="LUK 24:17" />Wakati kwabali, “Mukumunda mukwejisa nenyaya yeni?”</para>
  <para style="p" vid="LUK 24:17">Bakama pakalepo, bakadongomala. <verse eid="LUK 24:17" /><verse number="18" style="v" sid="LUK 24:18" />Umwe wabo waluwhi Kilopasi wakashandula kwaali akati, “Ndiwi woga mwezi muJelusalema usinoziba zwinhu zwakatikana mukati mwamazhuba mashoma apinda?”<verse eid="LUK 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19" />Wakati kunaibo, “Zwinhu ni?” Ibo bakati,</para>
  <para style="p" vid="LUK 24:19">“Zwili mawililana naJesu wokuNazaleta, wakabeli umpolofeti unesimba muzwito nomuwhi mbeli kwaMwali nabanhu bose, <verse eid="LUK 24:19" /><verse number="20" style="v" sid="LUK 24:20" />kuti bakulwana babatebuji nabatongi bakompila kuti etongelwe lufu nokunkahamila. <verse eid="LUK 24:20" /><verse number="21" style="v" sid="LUK 24:21" />Isu takabeli nolubimbo lwokuti ndiye uchasungunula iIzilayeli. Eya, pezhulu pezwi kwapinda mazhuba matatu yezwi zwinhu zwatikana. <verse eid="LUK 24:21" /><verse number="22" style="v" sid="LUK 24:22" />Akale bamwe mamai egapo lyedu batichenamisa. Benda kugumbu zhingwanangwana, <verse eid="LUK 24:22" /><verse number="23" style="v" sid="LUK 24:23" />bawana untumbu uwe usipo, babuya kwotibuja kuti babona ingilozi yakababuja kuti umpenyu. <verse eid="LUK 24:23" /><verse number="24" style="v" sid="LUK 24:24" />Bamwe bakabeli nasu benda kugumbu, bakawana sezwalebwa namamai, asi iye nokukwe abajombona.”<verse eid="LUK 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25" />Wakati kwabali, “Imwi malema, ini mujilwa kudimbwa zwose zwinolebwa nabapolofeti! <verse eid="LUK 24:25" /><verse number="26" style="v" sid="LUK 24:26" />Azwijakabakakwelela na kuti Kristo eyabule ali kutila kuti engwine mulukujo lulwe?” <verse eid="LUK 24:26" /><verse number="27" style="v" sid="LUK 24:27" />Wakabalungululila zwakabakakwalwa mumakwalo pezhulu pape kuva kunaMozesi newhalo jabapolofeti.<verse eid="LUK 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28" />Bakabaswendela pelyo nonzi ubakaba benda kwauli. Iye wakata sofana uchinonda mbeli, <verse eid="LUK 24:28" /><verse number="29" style="v" sid="LUK 24:29" />koga bakombweta kuti egale nabo beti, “Igalani nasu nokuti izhuba lyalebomila masikati apela, kwaboloswibha.” Nokudalo wakangwina akagala nabo.<verse eid="LUK 24:29" /></para>
  <para style="s">Chilayilo muEmausi</para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 24:30" />Paakaba eligele nabo pakulya, wakatola chinkwa akaboka, akachimedula ebapa. <verse eid="LUK 24:30" /><verse number="31" style="v" sid="LUK 24:31" />Mesho abo akazhulika bakonziba, asi iye wakava abwandila kwabali. <verse eid="LUK 24:31" /><verse number="32" style="v" sid="LUK 24:32" />Bakabhuzana chabochabo beti,“ Myoyo yedu aijabepisa na mukati mwedu, paabelebeleka nasu munzila etipandululila makwalo?”<verse eid="LUK 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 24:33" />Bakava banyamuka nonshaji yoyo bakabwilila kuJelusalema; bakanowana bali igumi nomwempela, nabamwe bakabelipo, <verse eid="LUK 24:33" /><verse number="34" style="v" sid="LUK 24:34" />bakati kwabali, “Chokomende She wamuka, akale wabonwa naSimoni!”<verse eid="LUK 24:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 24:35" />Babili yaba bakava babalungululila bamwe zwakatikana kunaibo munzila, akale kuti bakonziba chini paakamedula chinkwa.<verse eid="LUK 24:35" /></para>
  <para style="s">Jesu unoboneka kubapositoli babe</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36" />Bechinolebeleka zwose yezwi, Jesu nokukwe wakama pakati pabo. <verse eid="LUK 24:36" /><verse number="37" style="v" sid="LUK 24:37" />Bakakatamuka, bakatya beyeya kuti posa babweni ishaku. <verse eid="LUK 24:37" /><verse number="38" style="v" sid="LUK 24:38" />Wakati kwabali, “Ini munyajikana akale ini muli nokukahajika mumyoyo yenu? <verse eid="LUK 24:38" /><verse number="39" style="v" sid="LUK 24:39" />Lingani maboko angu namakumbo angu, ndimi iye nokukwe; ndigumeni mubone, ishaku alina inyama kana mafupa sozwamubweni kuti ndinanazwo.” <verse eid="LUK 24:39" /><verse number="40" style="v" sid="LUK 24:40" />Akale paakaleba yezwi wakabatondeja maboko nama kumbo awe. <verse eid="LUK 24:40" /><verse number="41" style="v" sid="LUK 24:41" />Bakashanta kasa zwikabata kuti besibe nokuvumila bakama besinolebeleka, wakati kwabali, “Munanazwo zwokulya yopano na?” <verse eid="LUK 24:41" /><verse number="42" style="v" sid="LUK 24:42" />Bakompa chibabi chehobe ilogochwa, <verse eid="LUK 24:42" /><verse number="43" style="v" sid="LUK 24:43" />wakatola akalya mbeli kwabo.<verse eid="LUK 24:43" /></para>
  <para style="s">Mubasumikiji bangu</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mateo 28:16-20</ref>; <ref loc="MRK 16:14-18">Mako 16:14-18</ref>; <ref loc="JHN 20:19-23">Joni 20:19-23</ref>; <ref loc="ACT 1:6-8">Mishingo 1:6-8</ref>)</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44" />Wakati kunaibo, “Yaya mawhi angu andakabemubuja ndichinamwi, kuti zwose zwakakwalwa nezwangu mumulawo waMozesi nomubapolofeti nomuJimbo zwilokwelela kuzhajikijwa.”<verse eid="LUK 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45" />Wakazhula indangalilo jabo kuti bewhisise makwalo, <verse eid="LUK 24:45" /><verse number="46" style="v" sid="LUK 24:46" />akati kwabali, “Nokudalo kwakakwalwa kuwhi Kristo ulokwelela kusheteswa akale emuke munabakafa nezhuba lyatatu, <verse eid="LUK 24:46" /><verse number="47" style="v" sid="LUK 24:47" />akale kuti muzina lilye luchingunuko lwokulekejelwa luchinyo lubhaunulwe kunduji jose zwitangisila kuJelusalema. <verse eid="LUK 24:47" /><verse number="48" style="v" sid="LUK 24:48" />Ndimwi basumikiji bezwi. <verse eid="LUK 24:48" /><verse number="49" style="v" sid="LUK 24:49" />Lingani ndikumutumila kwamuli zwibakabimbisa Tate, koga galani muguta mujine mupiwe masimba anova pezhulu.”<verse eid="LUK 24:49" /></para>
  <para style="s">Jesu unotanha kudenga</para>
  <para style="r">(<ref loc="MRK 16:19">Mako 16:19</ref>,<ref loc="MRK 16:20">20</ref>; <ref loc="ACT 1:9-11">Mishingo 1:9-11</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50" />Wakabatola akenda nabo bakanoswika kuBhetani akanyamula maboko awe, akaba kombolela. <verse eid="LUK 24:50" /><verse number="51" style="v" sid="LUK 24:51" />Elimukubakombolela wakabasiya akatanhiswa kudenga. <verse eid="LUK 24:51" /><verse number="52" style="v" sid="LUK 24:52" />Bakabwilila kuJelusalema, beli nolushanto lukulwana, <verse eid="LUK 24:52" /><verse number="53" style="v" sid="LUK 24:53" />bakalamba beli muTempeli bekuja Mwali.<verse eid="LUK 24:53" /></para>
  <chapter eid="LUK 24" />
</usx>