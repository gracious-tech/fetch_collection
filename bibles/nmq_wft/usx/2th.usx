<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TH" style="id">- NAMBYA TRANSLATION PROJECT</book>
  <para style="h">2 BaTesalonika</para>
  <para style="toc1">Lukwalo lwabili lwaPaulo Kuba Tesalonika</para>
  <para style="toc2">2 BaTesalonika</para>
  <para style="toc3">2 Tesa</para>
  <para style="mt2">Lukwalo Lwabili LwaPaulu</para>
  <para style="mt1">KUBATESALONIKA</para>
  <para style="imt">Matangisilo</para>
  <para style="ip">Lukwalo lwabili kubaTesalonika lwakakwalwa noPositoli Paulu (2 Tesalonika 1:1). Wakakwala lukwalo yolu eva mukukwala baTesalonika botanga mumakole makumi mashanu ane mwempela mushule mokuzwalwa kwaKristo azwalwa. Paulu wakabechili muKorinti paakakwala lukwalo yolu kugubungano lomuTesalonika lili gubungano lyaakasungula mulwendo lulwe lwabili lokupupula (Mishingo 17:1-10). Kunowhi muwhalo yeMishingo iGubungano lyakabeshanganisa bamwe banodimbwa nabe chiGiliki banji.</para>
  <para style="ip">Igubungano lyokuTesalonika linanga lyakabenyajwa nokupela kwenyika akale nokuzha kabili kwaKristo. Nokuti Paulu wakazwikwala kanjinji muwhalo jije jose mbili kuba Tesalonika. Chingaba chikamu chikulwana chabaKolinte bechibili chinolebeleka nokuphela kwenyika. Paulu akale wakabalaya nobusimbe. Wose unhu ngeshinge kuti ewane kulya kukwe (2 Tesalonika 3:6-10).</para>
  <para style="iot">Zwilomumwa</para>
  <para style="io1">Paulu unotanga lukwalo nokuzwileba iye nabamwebabe muna (2 Tesalonika 1:1-2)</para>
  <para style="io1">Akale kova eboka Mwali nokuba kweGubungano muTesalonika nokuba namatila (2 Tesalonika 1:3-12)</para>
  <para style="io1">Paulu unolebeleka nokupela kwonshaji muchisiyaniso chabili</para>
  <para style="io1">Kova elebeleka nobubi bwobusimbe nechido chokushinga (2 Tesalonika 3:1-15)</para>
  <para style="io1">Paulu unokonya nokumusa igubungano akale (2 Tesalonika 3:16-18)</para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />Imi Paulu, naSilivanosi naTimoti.</para>
  <para style="p" vid="2TH 1:1">Kugubungano lyeTesalonika munaMwali Tate bedu nomuna Tezi Jesu Kristo.<verse eid="2TH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2" />Chipiwo nolunyalalo zwiva kunaMwali Tate nokuna Tezi Jesu Kristo.<verse eid="2TH 1:2" /></para>
  <para style="s">Untongo Pakuzha kwaKristu</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />Banakwaina tilosungilwa kupa kuboka kuna Mwali pezhulu penu unshaji wose, somwazwilokwelela, akale kudimbwa kwenu kumukubuka kasa. Akale ludo lupo pakati penu lwamunopana lukumukubuka. <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />Nokudalo isu bomene tozwifufumula namwi muma kubungano aMwali nokusimatila akale kudimbwa mukushungulujwa kwenu, nokuyabuliswa kwamumutilwa mukashingilila.<verse eid="2TH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5" />Yechi ndicho chitondejo chobululami bontongo waMwali, kuti mube balokwelela mubushe bwaMwali ibo bwamumuyabulila. <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />Mwali ulolulama, unobwiliza kunakulwaja kunabo bakumumulwajisa. <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />Akale etipa kunyetutuka kunamwi pamwempela nasu kunaabo balolwajilwa, yezwi zwinootikana kanaTezi Jesu atondejelwa eva kudenga nengilozi jije jinesimba, <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />mumoto unovilima unoobuza kulwaja kunaabo basinoziba Mwali akale nokunaabo basino tobeleja indebo imbuya yaTezi wedu Jesu. <verse eid="2TH 1:8" /><verse number="9" style="v" sid="2TH 1:9" />Banooba nechilango chokuyangata kusinopela kunopalaja nokushalujwa kwabo mukubayipo kwaTezi nolukujo lwamasimba awe, <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />pakuzha kukwe yelyo izhuba kokujwa, kubanhu babe bachena akale nokuba chishamiso kunabo bose balodimbwa, nokuti mwakadimbwa busumikiji bwedu kunamwi.<verse eid="2TH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11" />Pezhulu pezwi ngweno togala timunamatila, kuti Mwali wedu emutile balokwelela mukushobwa kukwe, akale namasimba awe ezhajikije ishungu jenu jose jobuya bwemishingo yokudimbwa, <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />kutila izina lyaTezi wedu Jesu libe nokukujwa munamwi, namwi munaiye, mushe jaMwali naTezi Jesu Kristo.<verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="s">Umbi</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />Bakwaina pakuzha kwaTezi wedu Jesu Kristo akale nokubungana kwedu kuti tishangana naye, tomukumbila kasa, <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />kuti musikimbije kukatamuka kana kushantilwa mundangalilo kana nompepo kana iwhi, kana lukwalo lunota sokuti lumuva kwatili, luti izhuba lyaTezi lyaswika. <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />Kusibe nonhu unomuchenga kana neyipi nzila, nokuti yelo izhuba alitooswika, kuzhe kokuti kupanduka kube iko kunotanga, akale unhu usinotobeleja mulawo ebhisilwe pachena, iye wokupalajwa, <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />nokuzwikuja pezhulu pezwimwali zwose kana zwinhu zwinonamatwa, etole chigalo mutempele yaMwali, ezwisuma kuti ndiMwali.<verse eid="2TH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5" />Amuchinoyeya na, kuti ndichilinamwi ndakamubuja yezwi? <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />Akale munoziba zwikumumubhata ngweno kutila kuti oobhiswapachena nonshaji uwe ulokwelela. <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />Nezwo isiswa lokusowhisisika kokusogajikana kumukushinga kale, iye chete unotubula kuzwikabula unozwita alo kuswikila abhuda munzila. <verse eid="2TH 2:7" /><verse number="8" style="v" sid="2TH 2:8" />Akale una bupenyu bokulundula unoobhiswa pachena, Tezi Jesu unombulaya nolufhemo lunobhuda mundomo akale nokuumpalaja kokupenya kokuzha kukwe. <verse eid="2TH 2:8" /><verse number="9" style="v" sid="2TH 2:9" />Kuzha kombipisi zwinoba zwinokwendelana nenzila Satani yaanoshinga nayo masimba anazwitondejo zwokuniepa nezwishamiso, <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />nabose bubi nokuchengeja kunaabo bachapalajwa nokuti bakalamba kuda ichokomende kuti bechijwe. <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />Nokudalo Mwali unobatumila zwinesimba zwinobakanganisa mundangalililo, kuti bedimbwe munazwamaniepwa, <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />kutila kuti bose belashwe basijakabe dimbwa ichokomende koga beshantiswa nokusolulama.<verse eid="2TH 2:12" /></para>
  <para style="s">Mwakashalilwa Luchijo</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />Banakwaina banodika kuna Tezi, tilosungilwa kuti tipe kuboka kuna Mwali wose unshaji namwi, nokuti Mwali wakamushala kuva pokutanga kuti muchijwe nokupinda mukucheneswa noMpepo nokudimbwa muchokomende. <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" />Kune zwi wakamushoba kuva nomundebo imbuya, kutila kuti muwane lukujo lwaTezi wedu Jesu Kristo. <verse eid="2TH 2:14" /><verse number="15" style="v" sid="2TH 2:15" />Banakwaina nokudalo, galani mukasima akale bhatililani mumagalilo amwakalayijwa nasu, kungaba newhi lyondomo kana nolukwalo.<verse eid="2TH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16" />Ngana iye Tezi wedu Jesu Kristo, naMwali Tate bedu bakatida neshe bakatipa kuzwinyalaja kusinopela nolubimbo lubuya, <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />ngesungwaje myoyo yenu eyisimise mumishingo yose mibuya nomuwhi.<verse eid="2TH 2:17" /></para>
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="s">Tinamatileni</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />Banakwaina pakupejeleja, tinamatileni, kuti iwhi lyaTezi likambije kuzhalilana,akale likujwa somulyakabeli pakati penu, <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />kuti tichijwe kuva mubuhungu nobubi bwabanhu, nokuti atoba bose banodimbwa.<verse eid="2TH 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 3:3" />Koga Tezi ulobimbika, unomusimisa akale emutabilije kumbi. <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />Akale tinalubimbo munaTezi nomunamwi, kuti mumuta akale muchata zwinhu zwatinomubuja.<verse eid="2TH 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 3:5" />Tezi ngana atungamija myoyo yenu muludo lwaMwali akale nokusimilila kwaKristo.<verse eid="2TH 3:5" /></para>
  <para style="s">Bubi bobusimbe</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />Banakwaina, ngweno tomulaya nomuzina lyaTezi wedu Jesu Kristo, kuti musosolokele kule naye wose mwanakwaina umukulalama bupenyu bobusimbe zwisinokwendelana namagalilo amwakatambula kuva kunasu. <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />Imwi nokwenu moziba kuti mokwelela kuti mutikwejejele chini, atijakabaka galilila maboko patakabeli namwi, <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />atijakalya kulya chonhu tisalipa, koga takabeshinga nesimba masikati nobusiku kuti tisipe untolo kuna umwe wenu. <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />Akutoba kuti atina indulamo yeyo, koga tibe unkwejaniso kutila kuti mutikwejejele. <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />Nokuti patakabeli namwi takamupa undayo yoyu, “kana umwe wenu esashinga, esilye”.<verse eid="2TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11" />Tiwhile kuti bamwe benu bamulalama nobusimbe, beli banongwinila nyaya jabamwe, besinoshinga. <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />Ngweno banhu bakadayi tobalaya nokubasungwaja munaTezi Jesu Kristo kuti bete unshingo wabo mulunyalalo akale kuti bewane zwingabachija.<verse eid="2TH 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 3:13" />Koga banakwaina musinyale kuta zwinhu zwakalulama. <verse eid="2TH 3:13" /><verse number="14" style="v" sid="2TH 3:14" />Kana umwe wenu angolamba kutobeleja zwatimuleba munolu lukwalo, ziba yoyo unhu musilyijane, kutila kuti ebe neshoni. <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />Musuundinge sombengi koga muundaye somwanakwaina.<verse eid="2TH 3:15" /></para>
  <para style="s">Mawhi okukoneka</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />She wolunyalalo nokukwe emupe lunyalalo muna wose unshaji munzila jose. Tezi ngaabe namwi mwose.<verse eid="2TH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17" />Imi, Paulu, ndokwala yezwi noluboko lwangu ndimumusa. Yeyi imhande muwhalo jangu jose, ndiwo nkwalilo wangu.<verse eid="2TH 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18" />Ishe jaTezi wedu Jesu Kristu ngejibe namwi mwose.<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>