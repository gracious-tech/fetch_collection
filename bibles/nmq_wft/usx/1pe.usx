<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1PE" style="id">- NAMBYA TRANSLATION PROJECT</book>
  <para style="h">1Pita</para>
  <para style="toc1">Lukwalo Lwotanga Lwakakwalwa naPita</para>
  <para style="toc2">1 Pita</para>
  <para style="toc3">1 Pit</para>
  <para style="mt2">Lukwalo Lwotanga Lwakakwalwa na</para>
  <para style="mt1">PITA</para>
  <para style="imt">Matangisilo</para>
  <para style="ip">Lukwalo lwaPita lwokutanga lwakakwalwa noMpositoli Pita. Pita wakatangisa lukwalo lulwe nokuzwisuma kuti iye ndiani akale kuti umukwalila aani. Lukwalo yolu lwakakwalilwa maKristo wose “bezi muneno inyika” (1 Pita 1.1, 1.17 na 2.11) Babali babe wakabashoba ali tunji nokuti bakabaka mwayuluka munyika jilosiyanasiyana. Lukwalo lulwe lulotojana nolwaPaulu kubaEfesu nejimwe inzila, banji banodimbwa kuti Pita Wotanga wakakwalwa mushule molukwalo kubaEfesu mugole lingaba makumi mashanu anegumi namashanu mushule Jesu azwalwa. Pita wakakwala lukwalo yolu elikuRoma yaakabeshoba kuti iBhabhiloni (1 Pita 5.13).</para>
  <para style="ip">Pita unoti wakakwala lukwalo yolu, “Kusungwaja akale nokusumikija kuti yezwi chipiwo chechokomende chaMwali,” (1 Pita 5.12). Pana zwimwe zwilotojana pakati paPita Wokutanga 2.11—3:7, BaEfesu 5:18—6:9 naBaKolose 3:1.18—4:6. Wose makwalo elimatatu anolayija nokukamujana kwemhuli nokuwhilila butongi. Akale unosungwaja maKristo ose kubhatilila kunaKristo, kojoba pelina bulemu nokuti mapejelejo abapelyo (1Pita 4:1).</para>
  <para style="iot">Zwilomumwa</para>
  <para style="io1">Pita unozwisuma akale unolebeleka nabanobala babe (1 Pita 1:1-2)</para>
  <para style="io1">Kova ebokaMwali noluchijo lunokobelanwa naibo bose akale nokuti zwinolebani mubupenyu bwabo (1 Pita 1:3-2:10)</para>
  <para style="io1">Unondilambeli epa indayijo kubavumili yokugalisana zwibuyanana munyika akale nokutondejela kukamujana kulosiyanasiyana kunanga sokondume nonkaji nondanda natezi (1 Pita 2:11-4:11)</para>
  <para style="io1">Mushule mwezwi Pita wakasungwaja kuti benangatile kojoba kulina injabulo (1 Pita 4:12-511)</para>
  <para style="io1">Ndipo paakakonya lukwalo lulwe (1 Pita 5:12-14)</para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />Imi Pita, umpositoli waJesu Kristo,</para>
  <para style="p" vid="1PE 1:1">kunaabo bakwendi balomwayikana muPontusi, Galatiya, Kapadosia, Ezhiya, nomuBhitiniya, bakashalwa naMwali, <verse eid="1PE 1:1" /><verse number="2" style="v" sid="1PE 1:2" />bakaponchwa noluzibo lwambeli lwaMwali Tate, nokucheneswa nonshingo woMpepo unchena kuti bewhilile Jesu Kristo, nokushashailwa nelopa lilye.</para>
  <para style="p" vid="1PE 1:2">Chipiwo nolunyalalo zwipamijwe kwamuli.<verse eid="1PE 1:2" /></para>
  <para style="s">Lubimbo Lupenyu</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />Lukujo ngalube kunaMwali naTate baTezi weduJesu Kristo! Mushe jije ihulwana takazwalwa bupya mulubimbo lupenyu mukumuka kwaJesu Kristo kunabakafa, <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />akale mushabo isinopalajika, isiloswibhiswa, isinokulumpala ilolondotelwa imwi kudenga, <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />imwi mulolindwa nesimba lyaMwali mukudimbwa pezhulu poluchijo lulomilila kutondejelwa nonshaji opejeleja.<verse eid="1PE 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 1:6" />Muna zwose yezwi munooshanta kasa, kojoba ngweno konshaji unshomanana munokwelela kujiijwa mukukwejwa kulosiyanasiyana. <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />Yezwi zwakezhila kuti kudimbwa kwenu kwechokomende, kutondejelwe pachena kuti kukulwana kupinda indalama ilopiswa nomoto, iyo inopalajika, yezwi zwingata, mutambule lukujo, kungaima akale nokulemekeja Jesu Kristo paachatondejelwa. <verse eid="1PE 1:7" /><verse number="8" style="v" sid="1PE 1:8" />Kojoba musanu moombona monda, akale kojoba musinombona ngweno, modimbwa mwaali akale mulizhele lushanto lusinolebelekeka nokutunhumwija, <verse eid="1PE 1:8" /><verse number="9" style="v" sid="1PE 1:9" />nokuti mumutambula imbuyilwa yokudimbwa kwenu, luli luchijo lwemyoyo yenu.<verse eid="1PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10" />Yezwi zwili zwoluchijo yolu bapolofeti zwabakalebeleka, chipiwo chichezha kwamuli, chakashakisiswa kunakunika kukulwana, <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />bakabhuzisisa kuti unhuni kana unshajini wakatondejelwa noMpepo waKristo munaibo akale kuti wakaba utondejelani paakalebambeli nokuyabula kwaKristo nokungaima kwalutobela. <verse eid="1PE 1:11" /><verse number="12" style="v" sid="1PE 1:12" />Zwakatondejelwa kwabali kuti abajakabezwishingila ibo koga imwi, pabakalebeleka nezwinhu zwakazibiswa imwi naabo bakabhaunula indebo imbuya kunamwi noMpepo uNchena wakatumilwa kuva kudenga. Nengilozi jinodisisa kuzwilinga zwinhu yezwi.<verse eid="1PE 1:12" /></para>
  <para style="s">Kushobelwa kuLalama kuChena</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />Nokudalo, nendangalilo jenu, jilomuka akale jili jilogajikana, bigani lubimbo lwenu zwizhele pe chichabuzwa kwamuli pakutondejelwa kwaJesu Kristo. <verse eid="1PE 1:13" /><verse number="14" style="v" sid="1PE 1:14" />Sabana banowhilila, musitobele zwilakamilo zwenu zwobubi zwamazhuba akapinda okuswoziba kwenu Mwali. <verse eid="1PE 1:14" /><verse number="15" style="v" sid="1PE 1:15" />Koga sezwo iye wakamushoba elinchena, nokudalo ibani bachena muzwito zwenu zwose, <verse eid="1PE 1:15" /><verse number="16" style="v" sid="1PE 1:16" />nokuti zwilokwalwa kuti, “Ibani bachena, nokuti imi ndinchena.”<verse eid="1PE 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17" />Sezwo mushoba Tate banotonga umwenoumwe nemishingo iye besineshalulo, galani bupenyu bwenu mulutyo unshaji wenu wose musili beeyo nyika. <verse eid="1PE 1:17" /><verse number="18" style="v" sid="1PE 1:18" />Nokuti moziba kuti mwakatengwa kuva munzila jisina lubhancho jimwakawana kumatategulu enu, amujakatengwa nezwinhu zwinopalala zwinanga isiliva kana indalama, <verse eid="1PE 1:18" /><verse number="19" style="v" sid="1PE 1:19" />koga nelopa linokosha lyaKristo, imhwizana isiloswibhiswa kana. kabata. <verse eid="1PE 1:19" /><verse number="20" style="v" sid="1PE 1:20" />Wagala wakabakashalwa inyika isanu yabumbwa, koga wakatondejelwa munshaji opejeleja zwitilwa imwi. <verse eid="1PE 1:20" /><verse number="21" style="v" sid="1PE 1:21" />Kupindila munaiye modimbwa munaMwali, wakoomusa mubafi akompa kungaima, nokudalo kudimbwa nolubimbo lwenu zwimo munaMwali.<verse eid="1PE 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22" />Ngweno sezwo mwazwichenesa nokuwhilila ichokomende noludo luliilo kuna umwe noumwe, dananani zwechokomende zwiva mumwoyo. <verse eid="1PE 1:22" /><verse number="23" style="v" sid="1PE 1:23" />Mwakazwalwa bupya, kusikwembeyu inopalala, koga isinopalala, kupindila muwhi ibhenyu lisinopela lyaMwali, <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" />Sezwinoleba iwhalo inchena kuti,</para>
  <para style="q1" vid="1PE 1:24">“Bwose banhu bananga sobuhwa,</para>
  <para style="q2" vid="1PE 1:24">akale kungaima kwabo kunanga sama maluba omuminda,</para>
  <para style="q1" vid="1PE 1:24">Buhwa bunohwihwinyala, akale maluba anombwela,<verse eid="1PE 1:24" /></para>
  <para style="q2">
    <verse number="25" style="v" sid="1PE 1:25" />koga iwhi lyaTezi linogala kwemisi isinopela.”</para>
  <para style="m" vid="1PE 1:25">Yelyo iwhi ndilyo iNdebo iMbuya yakabhaunulilwa imwi.<verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="s">Ibwe ibhenyu noLuji luChena</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />Nokudalo lekani lubengo lwose, buchengeji bwose, kuniepejela, nobuchiba akale kuswibhisa bamwe nenzila jose. <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />Sabana bacheche, kwemujani unkaka unchena wompepo, kuti naiwo, namwi mukubuke muluchijo, <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" />nokuti mwakalabila bubuya bwaTezi.<verse eid="1PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4" />Izhani kwaali, kubwe ibhenyu yeli, lyakalambwa nabanhu koga mumesho aMwali liloshalwa akale lilokosha, <verse eid="1PE 2:4" /><verse number="5" style="v" sid="1PE 2:5" />akale samabwe mapenyu imwi momene mubakwe mube ingumba yompepo, mubebatebuji bachena, kupila mipilo yompepo inotambulika kunaMwali nomunaJesu Kristo. <verse eid="1PE 2:5" /><verse number="6" style="v" sid="1PE 2:6" />Nokuti zwimo muwhalo inchena.</para>
  <para style="q1" vid="1PE 2:6">“Lingani ndimubiga ibwe muZayoni,</para>
  <para style="q2" vid="1PE 2:6">ibwe lyolujibo liloshalwa akale lilokosha,</para>
  <para style="q2" vid="1PE 2:6">akale yoyo unodimbwa munaiye aatoswabiswa.”<verse eid="1PE 2:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="1PE 2:7" />Nokudalo kunamwi banodimbwa, yelibwe lilokosha koga kunabo basinodimbwa, iye ulokosha, koga kunayabo basinodimbwa,</para>
  <para style="q1" vid="1PE 2:7">“Ibwe babaki libakalamba,</para>
  <para style="q2" vid="1PE 2:7">lyaba ilyo unsholo wolujibo,”<verse eid="1PE 2:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="1PE 2:8" />akale,</para>
  <para style="q1" vid="1PE 2:8">“ibwe lichagubhula banhu,</para>
  <para style="q2" vid="1PE 2:8">ihando ichabawiga.”</para>
  <para style="m" vid="1PE 2:8">Banogubhulwa nokuti abatowhilila iwhi, swokubigwa kwazwo kuti bete.<verse eid="1PE 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9" />Koga imwi muluji luloshalwa, batebuji bwobushe, luji luchena, banhu baMwali, kuti mutubule kuleba zwito zwizwe zwinochenamisa iye wakamubhisa munhilima emusenga mwenje uwe unochenamisa. <verse eid="1PE 2:9" /><verse number="10" style="v" sid="1PE 2:10" />Noumwe unshaji amujakabeli banhu baMwali, koga ngweno mwababanhu baMwali, noumwe unshaji amujakabanu mwatambula ishe, koga ngweno mwatambula ishe.<verse eid="1PE 2:10" /></para>
  <para style="s">Balanda baMwali</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />Banodikana, ndomubweta sabo banova kunejimwe nyika akale sabo bagele kunyika jisilijabo kuti bezwikwije muzwilakamilo zwoluchinyo zwombili, izwo zwimomuhondo nomwoyo wenu. <verse eid="1PE 2:11" /><verse number="12" style="v" sid="1PE 2:12" />Itani untilo umbuya pakati pabasinodimbwa, kutila kuti bangoti belebeleke bubi namwi sababipisi, ateni bangabona zwito zwenu zwibuya bekuje Mwali nezhuba lyokushanyilwa.<verse eid="1PE 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13" />Zwidelejeni pasi pobutongi bwose bwabanhu mutilaTezi, kungaba kuntongi wenyika jilosiyanasiyana eli nkulugulu, <verse eid="1PE 2:13" /><verse number="14" style="v" sid="1PE 2:14" />kana batongi bamatunhu, swokutumwa kwabo kulanga yabo banota zwibi nokukuja yabo banota zwibuya. <verse eid="1PE 2:14" /><verse number="15" style="v" sid="1PE 2:15" />Nokuti chido chaMwali kuti mute zwibuya kuti muwhilijise indebo jisina luzibo, jabanhu malema. <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />Galani sabanhu balosununguka, koga musinoshingisa kusununguka kwenu kutila kusisa bubi, koga galani sabashingi baMwali. <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />Kujani wose unhu. Mude banakwaina. Ityani Mwali. Kujani untongi unotonga inyika jilosiyanasiyana.<verse eid="1PE 2:17" /></para>
  <para style="s">Chibonelo chokujiijwa kwaKristo</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />Bashingi mukutya Mwali, zwidelejeni kumatezi enu wose nechilemela chose, kusi kunaabo babuya nabanyolonyolo chete koga nokunaabo banabukali. <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />Nokuti umwe unonyamulwa, kana eyeya Mwali, kova emilana nokulwajilwa ejiijwa zwisakalulama. <verse eid="1PE 2:19" /><verse number="20" style="v" sid="1PE 2:20" />Umbayiloni waunowana, kana walobelwa kuchinya kuko kova utamoyondefu? Asi kana ungota zwibuya kova uzwijiilila akale kova utamoyondefu, unowana kunyamulwa naMwali. <verse eid="1PE 2:20" /><verse number="21" style="v" sid="1PE 2:21" />Yezwi ndizwo zwimwakashobelwa, sezwo Kristo naiye wakakuyabulila, emusiyila chibonelo, kuti mutobele munhambo jije. <verse eid="1PE 2:21" /><verse number="22" style="v" sid="1PE 2:22" />Aajakachinya, nobuchengeji abujakawanikwa mundomo mumwe. <verse eid="1PE 2:22" /><verse number="23" style="v" sid="1PE 2:23" />Paakatukwa, aajakabwilizila kutuka, paakajiila, aajakatyisijila, koga wakabimba naiye unotonga zwilolulama. <verse eid="1PE 2:23" /><verse number="24" style="v" sid="1PE 2:24" />Iye nokukwe wakanyamula luchinyo lwedu mumbili uwe ponchinjikwa, kuti tife muluchinyo akale tibe babapenyu mubululami. Namalonda awe mwakachiliswa. <verse eid="1PE 2:24" /><verse number="25" style="v" sid="1PE 2:25" />Mwabelashika semhwizi, koga ngweno mwabuya kuNdyisi akale Undondoti wemyoyo yenu.<verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="s">Balume nabakaji babo</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />Nenzila imwempela bakaji, zwidelejeni kubalume benu, kutila kuti bamwe, kojoba besinowhilila iwhi, bangashandulwa nezwito zwabakaji babo pesina iwhi, <verse eid="1PE 3:1" /><verse number="2" style="v" sid="1PE 3:2" />pabachabona zwito zwenu zwoloshambijika akale nobubuya bobupenyu bwenu. <verse eid="1PE 3:2" /><verse number="3" style="v" sid="1PE 3:3" />Kuzwinakisa kwenu kusibe kokuzhe, kokuluka masusu, kuzwilemba nendalama, akale nokumbala zwimbalo zwibhodo, <verse eid="1PE 3:3" /><verse number="4" style="v" sid="1PE 3:4" />koga ngekube komumwoyo, bubhodo businopalajika bompepo unalunyalalo nobunyolonyolo, zwili izo zwilokosha kasa mumesho aMwali. <verse eid="1PE 3:4" /><verse number="5" style="v" sid="1PE 3:5" />Nokudalo noumwe unshaji banhukaji bachena bakabebimba naMwali bakabezwishonga akale bezwideleja kubalume babo, <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" />saSara ewhilila Abhulahamu, onshoba eti tezi. Akale ngweno imwi mubana babe, kana muta zwibuya akale pesina zwamunotya.<verse eid="1PE 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7" />Nenzila imwempela, balume galani zwibuya nabakaji benu, mupe lukujo kubanhukaji sabakwaina basinesimba, sezwo muli balyifuma pamwempela bechipiwo chobupenyu, kutila kuti minamato yenu isikonejwe.<verse eid="1PE 3:7" /></para>
  <para style="s">Kusheteselwa kuta Zwilolulama</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />Nezwo kumapejelejo, imwi mwose mubhatane, muwhilane ishe, muludo nobubwanakwaina, nomwoyo unyolo akale nendangalilo yokuzwininipisa. <verse eid="1PE 3:8" /><verse number="9" style="v" sid="1PE 3:9" />Musibwilizile bubi nobubi kana kutukana nokutukana, koga muneyimwe inzila kombolelani, nokuti yezwi ndizwo zwimwakashobelwa, kuti muwane kukombolelwa. <verse eid="1PE 3:9" /><verse number="10" style="v" sid="1PE 3:10" />Nokuti,</para>
  <para style="q1" vid="1PE 3:10">“Iye unoda bupenyu</para>
  <para style="q2" vid="1PE 3:10">akale kuti ebone mazhuba mabuyanana,</para>
  <para style="q2" vid="1PE 3:10">ngebhise lulimi lulwe mububi</para>
  <para style="q2" vid="1PE 3:10">akale nondomo uwe esilebeleke zwochengeja,<verse eid="1PE 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11" />ngesiye bubi akale ete zwilolulama,</para>
  <para style="q2" vid="1PE 3:11">ngeshake lunyalalo akale elutobelele.<verse eid="1PE 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1PE 3:12" />Nokuti chiso chaTezi aipo pabalolulama,</para>
  <para style="q2" vid="1PE 3:12">akale unowha minamato yabo.</para>
  <para style="q2" vid="1PE 3:12">Koga chiso chaTezi achitobonana nabanota bubi.”<verse eid="1PE 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13" />Ngweno ndiyani angamulwajisa kana mwakasungwalila zwibuya? <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" />Kojoba mungooyabiswa pezhulu pobululami mokombolelwa. Musitye zwabanotya kana kujiijika, <verse eid="1PE 3:14" /><verse number="15" style="v" sid="1PE 3:15" />koga mumyoyo yenu ikujani Kristo saTezi. Unshaji wose zwibambanyileni kuzwitabilija kunhu wose unota kuti upe chisoko cholubimbo lwimo munamwi, <verse eid="1PE 3:15" /><verse number="16" style="v" sid="1PE 3:16" />muzwite nobunyolo akale nolukujo. Londotani luyeyo lwenu luliluchena, kutila kuti, mungolebelekwa bubi, naabo banomutukila zwito zwenu zwibuya munaKristo beswabiswe. <verse eid="1PE 3:16" /><verse number="17" style="v" sid="1PE 3:17" />Nokuti zwibuya kuyabisilwa kuta zwilolulama, kana chili chido chaMwali, pana kuta chibi. <verse eid="1PE 3:17" /><verse number="18" style="v" sid="1PE 3:18" />Nokuti Kristo neebo wakafila luchinyo kamwempela zwachose, ulolulama etila basilolulama, kuti pamwe angatibuza kunaMwali. Wakabulayiwa mumbili koga etiwa umpenyu mumpepo, <verse eid="1PE 3:18" /><verse number="19" style="v" sid="1PE 3:19" />muliimo mwaakenda kunobhaunula kumipepo yabanhu muntolongo, <verse eid="1PE 3:19" /><verse number="20" style="v" sid="1PE 3:20" />basakabewhilila mumazhuba apinda, yopo moyondefu waMwali puwakamilila mumazhuba aNowa nonshaji wokubakwa kobwato, bashoma chete ndibobakachijwa muvula, banhu bashanu banabatatu chete bakachijwa. <verse eid="1PE 3:20" /><verse number="21" style="v" sid="1PE 3:21" />Umbhabhatizo yoyu unkwejaniso nezwi, ngweno ndiwo unomuchija, kusikubhisa ishambwa pambili koga chili chibweteso kunaMwali choluyeyo lubuya, nomukumuka kwaJesu Kristo, <verse eid="1PE 3:21" /><verse number="22" style="v" sid="1PE 3:22" />iye wakenda kudenga akale ukokuluboko lolulyi lwaMwali. Ingilozi, butongi akale namasimba zwipo pasi pape.<verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="s">Bupenyu buloShanduka</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />Sezwo Kristo akajiila mumbili, zwisimiseni nendangalilo imwempela, nokuti yoyo wayabiswa mumbili waleka luchinyo, <verse eid="1PE 4:1" /><verse number="2" style="v" sid="1PE 4:2" />nokudalo abachina bupenyu bonshaji wose bokugala mumbili nomululakamilo lubi lwobunhu koga muchido chaMwali. <verse eid="1PE 4:2" /><verse number="3" style="v" sid="1PE 4:3" />Lekani unshaji wapinda ubewazhulila wokuti bokuzhe bete zwabanoda kuta, begala mubuhungu, muzwilakamilo, mubukolwi, mukunakilwa, nejungwe lyokukolwa kunezhoba, nokunamata zwimwali zwinosheshemesa. <verse eid="1PE 4:3" /><verse number="4" style="v" sid="1PE 4:4" />Bamuchenama kuti ngweno amuchinotandila muzwito zwobuhungu, akale bamumubhata bubi, <verse eid="1PE 4:4" /><verse number="5" style="v" sid="1PE 4:5" />koga banoopa inshandulo kunaiye ulozwibambanyila kutonga bapenyu nabakafa. <verse eid="1PE 4:5" /><verse number="6" style="v" sid="1PE 4:6" />Nokuti yezwi ndizwo zwakatisa kuti indebo imbuya ibhaunulwe nokunabakafa, kuti kojoba bakatongwa munyama sabanhu, pamwe bangagala mumpepo saMwali.<verse eid="1PE 4:6" /></para>
  <para style="s">Babhati babuya bezwipo zwaMwali</para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />Mapejelejo ezwinhu zwose abapelyo, nokudalo galani nendangalilo jizhele akale mulichanga paminamato yenu. <verse eid="1PE 4:7" /><verse number="8" style="v" sid="1PE 4:8" />Pezhulu paizo zwose bhatisisani musinolekeja kudanana, sezwo ludo lunotibhikila luchinyo lunjinji. <verse eid="1PE 4:8" /><verse number="9" style="v" sid="1PE 4:9" />Mutambulane zwibuyanana pasina unogungu. <verse eid="1PE 4:9" /><verse number="10" style="v" sid="1PE 4:10" />Umwe noumwe wakatambula chipo, ngeechishingise umwe kunoumwe, sababhati babuya bezwipiwo zwilosiyanasiyana zwaMwali. <verse eid="1PE 4:10" /><verse number="11" style="v" sid="1PE 4:11" />Yoyo unolebeleka, elebeleke sounolebeleka mawhi aMwali, yoyo unobhancha, ngezwite nesimba lyaanopiwa naMwali, kutila kuti munaizwo zwose Mwali ekujwe muna Jesu Kristo. Lukujo nobutongi zwibe kwaali kwemisi isinopela. Ameni.<verse eid="1PE 4:11" /></para>
  <para style="s">Kuyabuliswa sonKristu</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />Banodikana musichenamiswe nokuyabiswa kunopisa kuchamuzhila koomukweja, swokuti chinhu chisilozibilika chimutikana kwamuli. <verse eid="1PE 4:12" /><verse number="13" style="v" sid="1PE 4:13" />Koga shantani cheninge mulimukukobelana injabulo naKristo, kuti pamwe namwibo mungooshanta mukashantisisa pakuchoofumulwa kungaima kukwe. <verse eid="1PE 4:13" /><verse number="14" style="v" sid="1PE 4:14" />Kana mutukilwa izina lyaKristo, mulokombolelwa, nokuti umpepo wolukujo akale nowaMwali ulochegela panamwi. <verse eid="1PE 4:14" /><verse number="15" style="v" sid="1PE 4:15" />Kusibe umwe wenu uchayabula sombulayi, kana imbava, unchinyi, kana umputuki. <verse eid="1PE 4:15" /><verse number="16" style="v" sid="1PE 4:16" />Kana umwe angoyabula soNkristo, esibe neshoni, koga pasi pezina yelyo ngekuje Mwali.<verse eid="1PE 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 4:17" />Nokuti unshaji waswika kuti kutongwa kutangiswe munsha waMwali, akale kana bungotangisa nasu, ini achabamapejelejo aabo basinowhilila iNdebo iMbuya yaMwali? <verse eid="1PE 4:17" /><verse number="18" style="v" sid="1PE 4:18" />Akale</para>
  <para style="q1" vid="1PE 4:18">“Kana kuchija ulolulama kuli kukukutu</para>
  <para style="q2" vid="1PE 4:18">ani biya umbi nonchinyi banoochilila poni?”<verse eid="1PE 4:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="1PE 4:19" />Nokudalo yabo banojiila mumishingo mibuya yaMwali ngabete zwilolulama akale bepile myoyo yabo kuMbumbi ulobimbika.<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="s">Idanga lyaMwali</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />Nokudalo ndosungwaja bakulwana pakati penu, sonkulukwaina akale sonsumikiji wokujiila kwaKristo akale ndili umwe wabaimo mukungaima kuchafumulwa, <verse eid="1PE 5:1" /><verse number="2" style="v" sid="1PE 5:2" />chejani idanga lyaMwali limunolinga. Tani kusikokubhatwa nesimba koga mukasungunuka, koga sokuda kwaMwali kusi kwendipo imbi koga nokudisisisa. <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />Musikome baipo pasi penu, koga mulimikwejaniso kudanga. <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />Akale pachaboneswa uNdyisi unkulwana, moowana chilemba cholukujo chisinokulumpala.<verse eid="1PE 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5" />Nokudalo imwi batukutuku, zwidelejeni kubakulwana. Imwi mwose mbalani kuzwideleja umwe noumwe nokuti, “Mwali unonyenyejana nabanoshiya, koga unopa chipiwo kunabo banozwideleja.” <verse eid="1PE 5:5" /><verse number="6" style="v" sid="1PE 5:6" />Nokudalo imwi zwidelejeni pasi poluboko lunesimba lwaMwali, kuti nonshaji ulokwelela emunyamule. <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />Iposelani kubibila kwenu kose panaiye, nokuti unchengeti wenu.<verse eid="1PE 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8" />Gajikakanani mundangalilo, bhwazulani. Chita chenu guluzhanje umunyangija seshumba imukuluma, ipota wayichalya. <verse eid="1PE 5:8" /><verse number="9" style="v" sid="1PE 5:9" />Undambeni, mukasima mukudimbwa kwenu, muziba kuti yezwiya zwamwakaba shangana nozwo zwokuyabula zwinodikana somububwanakwaina bwenu mupasi lyose. <verse eid="1PE 5:9" /><verse number="10" style="v" sid="1PE 5:10" />Akale mushule mokuyabula konshaji umfupi, Mwali wechipiwo chose, wakamushoba kukungaima kukwe kwemisi isinopela munaKristo, iye nokukwe unoobwiliza, ezikatija, akale emusimisa. <verse eid="1PE 5:10" /><verse number="11" style="v" sid="1PE 5:11" />Isimba ngelibe kunaiye kwemisi isinopela. Ameni.<verse eid="1PE 5:11" /></para>
  <para style="s">Kumusa kopejeleja</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />Nolubhancho lwaSilivanasi, wandinobona somwanakwaina ulobimbika, ndamukwalila mubufupi, ndimusungwaja akale ndileba kuti yechi ndichochipiwo chechokomende chaMwali, imani mwakasima munaicho.<verse eid="1PE 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13" />Bhabhiloni iloshalwa pamwempela namwi nomwananhulumyana wangu Mako bakumumusa. <verse eid="1PE 5:13" /><verse number="14" style="v" sid="1PE 5:14" />Mumusane nolumyonto loludo.</para>
  <para style="p" vid="1PE 5:14">Lunyalalo kwamuli mose mumo munaKristo.<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>