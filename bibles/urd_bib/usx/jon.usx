<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JON" style="id">- Biblica® Open Urdu Contemporary Version</book>
  <para style="h">یُوناہؔ</para>
  <para style="toc1">یُوناہؔ کی نبُوّت</para>
  <para style="toc2">یُوناہؔ</para>
  <para style="toc3">یُوناہؔ</para>
  <para style="mt1">یُوناہؔ</para>
  <para style="mt2">کی نبُوّت</para>
  <chapter number="1" style="c" sid="JON 1"/>
  <para style="s1">یَاہوِہ کے حُضُور سے یُوناہؔ کا فرار ہونا</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 1:1"/>یَاہوِہ کا کلام یُوناہؔ بِن امِتّائی پر نازل ہُوا: <verse eid="JON 1:1"/><verse number="2" style="v" sid="JON 1:2"/>”اُٹھ کر اُس بڑے شہر نینوہؔ کو جا اَور اُس کے خِلاف مُنادی کر کیونکہ اُن کی بدی میرے سامنے تک آ پہُنچی ہے۔“<verse eid="JON 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 1:3"/>لیکن یُوناہؔ یَاہوِہ کے حُضُور سے ترشیشؔ کی طرف جانے کو بھاگے اَور یافؔا جا پہُنچے۔ وہاں اُنہیں ترشیشؔ کو جانے والا ایک پانی کا جہاز مِلا۔ اَور وہ کرایہ دے کر اُس میں سوار ہُوئے تاکہ اُن کے ساتھ یَاہوِہ کی حُضُوری سے ترشیشؔ کو چلے جائیں۔<verse eid="JON 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 1:4"/>تَب یَاہوِہ نے سمُندر پر ایک اَیسی آندھی بھیجی کہ جہاز کے ٹکڑے ٹکڑے ہو جانے کا خطرہ پیدا ہو گیا۔ <verse eid="JON 1:4"/><verse number="5" style="v" sid="JON 1:5"/>سارے ملّاح خوفزدہ ہو گئے اَور ہر ایک اَپنے اَپنے معبُود کو پُکارنے لگے اَور جہاز کو ہلکا کرنے کی غرض سے اَپنا مال و اَسباب سمُندر میں پھینک دیا۔</para>
  <para style="p" vid="JON 1:5">لیکن یُوناہؔ نبی جہاز کے اَندر پڑے سو رہے تھے۔ <verse eid="JON 1:5"/><verse number="6" style="v" sid="JON 1:6"/>جہاز کے کپتان نے اُن کے پاس جا کر کہا، ”آپ کیسے سو سکتے ہیں؟ اُٹھو اَور اَپنے خُدا کو پُکارو۔ شاید وہ ہماری سُنے اَور ہم ہلاک نہ ہوں۔“<verse eid="JON 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JON 1:7"/>تَب ملّاحوں نے آپَس میں کہا، ”آؤ ہم قُرعہ ڈالیں اَور مَعلُوم کریں کہ اِس آفت کے لیٔے کون ذمّہ دار ہے۔“ اُنہُوں نے قُرعہ ڈالا اَور قُرعہ یُوناہؔ کے نام پر نِکلا۔ <verse eid="JON 1:7"/><verse number="8" style="v" sid="JON 1:8"/>اُنہُوں نے اُس سے کہا کہ ہمیں بتا، ”یہ آفت ہم پر کس کی وجہ سے آئی ہے؟ تمہارا پیسہ کیا ہے؟ اَور آپ کہاں سے آئے ہیں؟ آپ کا وطن کہاں ہے اَور آپ کس قوم سے تعلّق رکھتے ہیں؟“<verse eid="JON 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 1:9"/>یُوناہؔ نے جَواب دیا، ”میں ایک عِبرانی ہُوں اَور آسمان کے خُدا یَاہوِہ کی عبادت کرتا ہُوں جِس نے زمین اَور سمُندر تخلیق کی ہے۔“<verse eid="JON 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 1:10"/>اِس بات کو سُن کر وہ خوفزدہ گیٔے اَور اُن سے پُوچھا، ”آپ نے کیا کیا ہے؟“ (کیونکہ یُوناہؔ نے اُنہیں یہ بتا دیا تھا کہ، وہ یَاہوِہ کے حُضُور سے بھاگ رہے تھے۔)<verse eid="JON 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JON 1:11"/>سمُندر میں طُوفان بڑھتا جا رہاتھا اِس لیٔے اُنہُوں نے یُوناہؔ سے پُوچھا، ”ہم آپ کے ساتھ کیا کریں تاکہ سمُندر ہمارے لیٔے ساکن ہو جائے؟“<verse eid="JON 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JON 1:12"/>”مُجھ کو اُٹھاکر سمُندر میں پھینک دو،“ یُوناہؔ نے جَواب دیا، ”تو سمُندر ساکن ہو جائے گا۔ کیونکہ مَیں جانتا ہُوں کہ یہ بڑا طُوفان میری غلطی کے باعث تمہارے اُوپر آیا ہے۔“<verse eid="JON 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JON 1:13"/>پھر بھی ملّاح نے جہاز کو ساحِل تک لے جانے کی اَپنی پُوری کوشش کی مگر وہ ساحِل تک لے جانے میں کامیاب نہیں ہُوئے کیونکہ سمُندر پہلے سے بھی زِیادہ موجزن ہوتا جا رہاتھا۔ <verse eid="JON 1:13"/><verse number="14" style="v" sid="JON 1:14"/>تَب وہ یَاہوِہ کے حُضُور میں فریاد کئے، ”اَے یَاہوِہ، اِس شخص کی جان لینے کے لیٔے ہم لوگوں کو ہلاک نہ کر۔ ایک معصُوم کی موت کی ذمّہ داری ہمارے گردن پر نہ ڈال کیونکہ اَے یَاہوِہ، آپ نے جو چاہا اُسے کیا۔“ <verse eid="JON 1:14"/><verse number="15" style="v" sid="JON 1:15"/>تَب اُنہُوں نے یُوناہؔ کو اُٹھاکر سمُندر میں پھینک دیا اَور سمُندر کی لہریں تھم گئیں۔ <verse eid="JON 1:15"/><verse number="16" style="v" sid="JON 1:16"/>اِس بات سے وہ لوگ بہت خوفزدہ ہو گیٔے اَور اُنہُوں نے یَاہوِہ کے حُضُور میں قُربانی گذرانی اَور مَنّتیں مانیں۔<verse eid="JON 1:16"/></para>
  <para style="s1">یُوناہؔ کی دعا</para>
  <para style="p">
    <verse number="17" style="v" sid="JON 1:17"/>لیکن یَاہوِہ نے یُوناہؔ کو نگل جانے کے لیٔے ایک بڑی مچھلی تیّار کر رکھی تھی اَور یُوناہؔ تین دِن اَور تین رات مچھلی کے پیٹ میں رہا۔<verse eid="JON 1:17"/></para>
  <chapter eid="JON 1"/>
  <chapter number="2" style="c" sid="JON 2"/>
  <para style="nb">
    <verse number="1" style="v" sid="JON 2:1"/>تَب یُوناہؔ نبی نے مچھلی کے پیٹ کے اَندر سے یَاہوِہ اَپنے خُدا سے فریاد کی۔ <verse eid="JON 2:1"/><verse number="2" style="v" sid="JON 2:2"/>اُس نے کہا:</para>
  <para style="q1" vid="JON 2:2">”اَپنی مُصیبت کے دَوران مَیں نے یَاہوِہ سے دعا کی،</para>
  <para style="q2" vid="JON 2:2">اَور اُس نے میری سُن لی۔</para>
  <para style="q1" vid="JON 2:2">مَیں نے پاتال کی گہرائی سے مدد کے لیٔے پُکارا،</para>
  <para style="q2" vid="JON 2:2">اَور خُدا نے میری فریاد سُنی۔<verse eid="JON 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JON 2:3"/>خُدا نے مُجھے سمُندر کی گہرائی میں پھینک دیا تھا</para>
  <para style="q2" vid="JON 2:3">اَور لہروں نے مُجھے گھیرلیا تھا؛</para>
  <para style="q1" vid="JON 2:3">تیری تمام موجیں اَور لہریں</para>
  <para style="q2" vid="JON 2:3">میرے اُوپر سے گزر گئیں۔<verse eid="JON 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JON 2:4"/>مَیں نے کہا، ’مَیں آپ کی نظروں سے</para>
  <para style="q2" vid="JON 2:4">دُور کر دیا گیا ہُوں؛</para>
  <para style="q1" vid="JON 2:4">لیکن مَیں پھر سے</para>
  <para style="q2" vid="JON 2:4">آپ کے بیت المُقدّس کو دیکھوں گا۔‘<verse eid="JON 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JON 2:5"/>ہیبت ناک پانی نے مُجھے خوفزدہ کر دیا،</para>
  <para style="q2" vid="JON 2:5">گہرائی میرے چاروں طرف تھی؛</para>
  <para style="q2" vid="JON 2:5">سمُندری نباتات میرے سَر کے چاروں طرف لپٹ گئی تھی۔<verse eid="JON 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JON 2:6"/>میں پہاڑوں کی گہرائی تک ڈُوب گیا تھا؛</para>
  <para style="q2" vid="JON 2:6">زمین کے راستے ہمیشہ کے لئے مجھ پر بندہو گئے تھے۔</para>
  <para style="q1" vid="JON 2:6">لیکن آپ نے اَے یَاہوِہ، میرے خُدا،</para>
  <para style="q2" vid="JON 2:6">میری جان کو پاتال سے باہر نکالا۔“<verse eid="JON 2:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JON 2:7"/>جَب میری زندگی ختم ہو رہی تھی،</para>
  <para style="q2" vid="JON 2:7">تَب اَے یَاہوِہ، مَیں نے آپ کو یاد کیا،</para>
  <para style="q1" vid="JON 2:7">اَور میری دعا آپ کے بیت المُقدّس میں</para>
  <para style="q2" vid="JON 2:7">آپ کے حُضُور میں پہُنچی۔<verse eid="JON 2:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JON 2:8"/>جو لوگ جھُوٹے معبُودوں سے لپٹے رہتے ہیں</para>
  <para style="q2" vid="JON 2:8">وہ خُود کو خُدا کی شفقت سے محروم رکھتے ہیں۔<verse eid="JON 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JON 2:9"/>لیکن مَیں تیری شُکر گزاری کا نغمہ گاتے ہُوئے،</para>
  <para style="q2" vid="JON 2:9">آپ کے لئے قُربانی گذرانوں گا۔</para>
  <para style="q1" vid="JON 2:9">مَیں نے جو مَنّت مانگی ہے اُسے پُورا کروں گا۔</para>
  <para style="q2" vid="JON 2:9">میں گواہی دیتا ہُوں، نَجات یَاہوِہ کی طرف سے آتی ہے۔<verse eid="JON 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 2:10"/>اَور یَاہوِہ نے اُس بڑی مچھلی کو حُکم دیا اَور اُس نے یُوناہؔ کو خشک زمین پر اُگل دیا۔<verse eid="JON 2:10"/></para>
  <chapter eid="JON 2"/>
  <chapter number="3" style="c" sid="JON 3"/>
  <para style="s1">یُوناہؔ نینوہؔ کو روانہ ہوتاہے</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 3:1"/>تَب یَاہوِہ کا کلام دُوسری بار یُوناہؔ پر نازل ہُوا: <verse eid="JON 3:1"/><verse number="2" style="v" sid="JON 3:2"/>”اُٹھ، اُس بڑے شہر نینوہؔ کو جا اَورجو پیغام میں تُمہیں وہاں دینے والا ہُوں اُس کی مُنادی کر۔“<verse eid="JON 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 3:3"/>تَب یُوناہؔ یَاہوِہ کے کلام کے مُطابق نینوہؔ کو گیا۔ نینوہؔ بہت بڑا شہر تھا۔ وہاں پہُنچنے کے لیٔے تین دِن لگتے تھے۔ <verse eid="JON 3:3"/><verse number="4" style="v" sid="JON 3:4"/>یُوناہؔ نینوہؔ شہر میں داخل ہُوا اَور ایک دِن کا سفر طے کرتے ہُوئے اُس نے اعلان کیا، ”اَب سے چالیس دِن کے بعد نینوہؔ تباہ کر دیا جائے گا۔ <verse eid="JON 3:4"/><verse number="5" style="v" sid="JON 3:5"/>تَب نینوہؔ کے باشِندے خُدا پر ایمان لائے اَور روزہ کا اعلان کیا اَور بڑے سے چُھوٹے تک سَب نے ٹاٹ اوڑھا۔“<verse eid="JON 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 3:6"/>جَب نینوہؔ کے بادشاہ کو یہ خبر پہُنچی تو وہ اَپنے تخت سے اُٹھا اَور اَپنا شاہی لباس اُتار کر ٹاٹ اوڑھ کر خاک پر بیٹھ گیا۔ <verse eid="JON 3:6"/><verse number="7" style="v" sid="JON 3:7"/>اَور نینوہؔ میں یُوں اعلان کروایا،</para>
  <para style="pmo" vid="JON 3:7">بادشاہ اَور اُس کے سرداروں کی طرف سے فرمان جاری ہے کہ،</para>
  <para style="pm" vid="JON 3:7">کویٔی اِنسان یا حَیوان، گلّہ اَور مویشی نہ کچھ کھائیں اَور نہ پیئیں۔ <verse eid="JON 3:7"/><verse number="8" style="v" sid="JON 3:8"/>بَلکہ ہر اِنسان اَور حَیوان ٹاٹ اوڑھے اَور فوراً خُدا سے فریاد کرے۔ اَور ہر شخص اَپنی بُری روِش اَور ظُلم سے باز آئے۔ <verse eid="JON 3:8"/><verse number="9" style="v" sid="JON 3:9"/>کون جانتا ہے؟ شاید خُدا ہم پر رحم کرے اَور اَپنا اِرادہ بدلے اَور وہ اَپنا قہر شدید نازل کرنے سے باز آئے اَور ہم ہلاک نہ ہوں۔<verse eid="JON 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 3:10"/>جَب خُدا نے اُن کا یہ عَمل دیکھا کہ وہ اَپنی بُری روِش سے پھر گیٔے تو اُس نے اَپنا اِرادہ بدل دیا اَور اُس عذاب کو جو وہ اُن پر نازل کرنے والا تھا اُسے روک دیا اَور اُسے نازل نہ کیا۔<verse eid="JON 3:10"/></para>
  <chapter eid="JON 3"/>
  <chapter number="4" style="c" sid="JON 4"/>
  <para style="s1">خُدا کی رحمت پر یُوناہؔ کا غُصّہ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 4:1"/>لیکن یُوناہؔ کو خُدا کا یہ فیصلہ بہت بُرا لگا اَور وہ سخت ناراض ہُوا۔ <verse eid="JON 4:1"/><verse number="2" style="v" sid="JON 4:2"/>اُس نے یَاہوِہ سے دعا مانگی، ”اَے یَاہوِہ، جَب مَیں اَپنے گھر میں تھا، تو کیا مَیں نے یہی بات نہیں کہی تھی کہ آپ اُنہیں مُعاف کر دیں گے؟ اِس لیٔے مَیں نے ترشیشؔ کو بھاگنے میں جلدی کی تھی۔ کیونکہ مَیں جانتا تھا کہ آپ رحیم و کریم خُدا ہیں۔ جو قہر کرنے میں دھیما اَور شفقت میں غنی ہیں۔ آپ اَیسے خُدا ہیں جو عذاب نازل کرنے سے باز رہتاہے۔ <verse eid="JON 4:2"/><verse number="3" style="v" sid="JON 4:3"/>اَب، اَے یَاہوِہ آپ میری جان لے لیں کیونکہ میرے اِس جینے سے مَرجانا بہتر ہے۔“<verse eid="JON 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 4:4"/>تَب یَاہوِہ نے جَواب دیا، کیا، ”تمہارا غُصّہ کرنا جائز ہے؟“<verse eid="JON 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 4:5"/>تَب یُوناہؔ شہر سے باہر جا کر مشرق کی طرف ایک جگہ جا بیٹھا۔ وہاں اُس نے اَپنے لیٔے ایک چھپّر بنا کر اُس کے سایہ میں بیٹھ گیا اَور اِنتظار کرنے لگاکہ شہر کا کیا حال ہوتاہے۔ <verse eid="JON 4:5"/><verse number="6" style="v" sid="JON 4:6"/>تَب یَاہوِہ خُدا نے ایک پتّوں والی بیل اُگائی اَور اُسے یُوناہؔ کے اُوپر پھیلایا تاکہ اُس کے سَر پر سایہ ہو اَور وہ تیز دھوپ سے بچے اَور آرام پایٔے۔ یُوناہؔ اُس سائے دار درخت سے بہت خُوش ہُوا۔ <verse eid="JON 4:6"/><verse number="7" style="v" sid="JON 4:7"/>لیکن دُوسرے دِن صُبح سویرے خُدا نے ایک کیڑا بھیجا جِس نے پتّوں والی بیل کی جڑ کو کاٹ ڈالا اَور وہ سُوکھ گیا۔ <verse eid="JON 4:7"/><verse number="8" style="v" sid="JON 4:8"/>جَب آفتاب نِکلا تو خُدا نے مشرق سے ایک جھُلسانے والی لُو چلائی اَور آفتاب کی تپش نے یُوناہؔ کے سَر میں اسر کیا جِس سے وہ بے ہوش ہو گیا اَور مرنے کی آرزُومند ہوکر کہنے لگا، ”میرے اِس جینے سے مَرجانا بہتر ہے۔“<verse eid="JON 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 4:9"/>تَب خُدا نے یُوناہؔ سے پُوچھا، ”کیا اِس پتّوں والی بیل کی بابت تمہارا غُصّہ جائز ہے؟“</para>
  <para style="p" vid="JON 4:9">یُوناہؔ نے کہا، ”ہاں، میں اِتنا ناراض ہُوں کہ مَرنا چاہتا ہُوں۔“<verse eid="JON 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 4:10"/>تَب یَاہوِہ نے فرمایا، ”تُمہیں اِس پتّوں والی بیل کااِتنا خیال ہے، جسے نہ تُم نے لگایا نہ اُس کی دیکھ بھال کی اَور نہ ہی تُم نے اُسے بڑھایا۔ جو ایک ہی رات میں اُگا اَور دُوسری رات میں سُوکھ گیا۔ <verse eid="JON 4:10"/><verse number="11" style="v" sid="JON 4:11"/>تو پھر کیا میں اِس بڑے شہر نینوہؔ کا فکر نہ کروں؟ جِس میں ایک لاکھ بیس ہزار سے زِیادہ لوگ رہتے ہیں، جو اَپنے داہنے اَور بائیں ہاتھ میں فرق نہیں کر سکتے، اَور اِسی طرح بے شُمار مویشی بھی رہتے ہیں۔“<verse eid="JON 4:11"/></para>
  <chapter eid="JON 4"/>
</usx>
