<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NUM" style="id">- Biblica® Open Urdu Contemporary Version</book>
  <para style="h">گِنتی</para>
  <para style="toc1">گِنتی کی کِتاب</para>
  <para style="toc2">گِنتی</para>
  <para style="toc3">گِن</para>
  <para style="mt1">گِنتی</para>
  <para style="mt2">کی کِتاب</para>
  <chapter number="1" style="c" sid="NUM 1"/>
  <para style="s1">مردُم شماری</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 1:1"/>بنی اِسرائیل کے مُلک مِصر سے نکل آنے کے دُوسرے سال کے دُوسرے مہینے کے پہلے دِن سِینؔائی کے بیابان میں یَاہوِہ نے خیمہ اِجتماع میں مَوشہ سے باتیں کیں اَور یہ حُکم دیا: <verse eid="NUM 1:1"/><verse number="2" style="v" sid="NUM 1:2"/>”تُم بنی اِسرائیل کی ساری جماعت کی اُن کی برادری اَور خاندانوں کے مُطابق ہر ایک مَرد کا یکے بعد دیگرے نام درج کرکے مردُم شُماری کرو۔ <verse eid="NUM 1:2"/><verse number="3" style="v" sid="NUM 1:3"/>تُم اَور اَہرونؔ تمام اِسرائیلی مَردوں کی اُن کہ دستوں کے مُطابق گِنتی کرنا جو بیس سال یا اُس سے زِیادہ عمر کے ہُوں اَورجو فَوج میں خدمت کرنے کے قابل ہُوں۔ <verse eid="NUM 1:3"/><verse number="4" style="v" sid="NUM 1:4"/>اَور ہر قبیلہ سے ایک آدمی جو اَپنے خاندان کا سردار ہو تمہاری مدد کرے۔<verse eid="NUM 1:4"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="5" style="v" sid="NUM 1:5"/>”اَورجو آدمی تمہاری مدد کریں گے اُن کے نام یہ ہیں:</para>
  <para style="b" vid="NUM 1:5"/>
  <para style="li1" vid="NUM 1:5">”رُوبِنؔ کے قبیلہ سے شدِیُورؔ کا بیٹا اِلیضُورؔ؛<verse eid="NUM 1:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="NUM 1:6"/>شمعُونؔ کے قبیلہ سے ضُوریشدّؔی کا بیٹا سلُومی ایل؛<verse eid="NUM 1:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 1:7"/>یہُوداہؔ کے قبیلہ سے عَمّیندابؔ کا بیٹا نحشونؔ؛<verse eid="NUM 1:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="NUM 1:8"/>یِسَّکاؔر کے قبیلہ سے ضُعرؔ کا بیٹا نتنی ایل؛<verse eid="NUM 1:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="NUM 1:9"/>زبُولُون کے قبیلہ سے حیلونؔ کا بیٹا اِلیابؔ؛<verse eid="NUM 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 1:10"/>یُوسیفؔ کے بیٹوں میں سے:</para>
  <para style="li2" vid="NUM 1:10">اِفرائیمؔ کے قبیلہ سے عمّیہُوؔد کا بیٹا اِلیشمعؔ</para>
  <para style="li2" vid="NUM 1:10">منشّہ کے قبیلہ سے پِداہضُورؔ کا بیٹا گَملی ایل؛<verse eid="NUM 1:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="NUM 1:11"/>بِنیامین کے قبیلہ سے ابیدانؔ بِن گِدعونیؔ؛<verse eid="NUM 1:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 1:12"/>دانؔ کے قبیلہ سے احیعزر بِن عمّی شدّؔی؛<verse eid="NUM 1:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 1:13"/>آشیر کے قبیلہ سے عُکرانؔ کا بیٹا پگعِیلؔ؛<verse eid="NUM 1:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 1:14"/>گادؔ کے قبیلہ سے دعُوایلؔ کا بیٹا اِلیاسفؔ؛<verse eid="NUM 1:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="NUM 1:15"/>نفتالی کے قبیلہ سے عینانؔ کا بیٹا اَخیرعؔ۔“<verse eid="NUM 1:15"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="16" style="v" sid="NUM 1:16"/>جماعت میں سے اِن آدمیوں کا جو اَپنے قبیلوں کے سردار تھے تقرّر کیا گیا۔ وہ اِسرائیل کی برادریوں کے سربراہ تھے۔<verse eid="NUM 1:16"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="17" style="v" sid="NUM 1:17"/>مَوشہ اَور اَہرونؔ نے اُن آدمیوں کو جِن کے نام اُنہیں بتائے گیٔے تھے اَپنے ساتھ لیا۔ <verse eid="NUM 1:17"/><verse number="18" style="v" sid="NUM 1:18"/>اَور دُوسرے مہینے کے پہلے دِن ساری جماعت کو جمع کیا۔ لوگوں نے اَپنی اَپنی برادری اَور خاندانوں کے مُطابق اَپنا حسب و نَسب ظاہر کیا اَورجو مَرد بیس سال یا اُس سے زِیادہ عمر کے تھے اُن کے نام یکے بعد دیگرے درج کئے گیٔے۔ <verse eid="NUM 1:18"/><verse number="19" style="v" sid="NUM 1:19"/>جَیسا کہ یَاہوِہ نے مَوشہ کو حُکم دیا تھا اُسی کے مُطابق اُس نے اُنہیں سِینؔائی کے بیابان میں گِنا۔<verse eid="NUM 1:19"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 1:20"/>اِسرائیل کے پہلوٹھے رُوبِنؔ کی نَسل سے:</para>
  <para style="li2" vid="NUM 1:20">بیس سال یا اُس سے زِیادہ عمر کے سبھی مَردوں کے نام جو فَوج میں خدمت کرنے کے قابل تھے اَپنی اَپنی برادری اَور خاندان کے مُطابق یکے بعد دیگرے درج کئے گیٔے۔ <verse eid="NUM 1:20"/><verse number="21" style="v" sid="NUM 1:21"/>اَور رُوبِنؔ کے قبیلہ سے جِن آدمیوں کے نام درج کئے گیٔے اُن کی تعداد 46,500 تھی۔<verse eid="NUM 1:21"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 1:22"/>شمعُونؔ کی نَسل سے:</para>
  <para style="li2" vid="NUM 1:22">بیس سال یا اُس سے زِیادہ عمر کے سبھی مَردوں کے نام جو فَوج میں خدمت کرنے کے قابل تھے اَپنی اَپنی برادری اَور خاندان کے مُطابق یکے بعد دیگرے درج کئے گیٔے۔ <verse eid="NUM 1:22"/><verse number="23" style="v" sid="NUM 1:23"/>اَور شمعُونؔ کے قبیلہ سے جِن آدمیوں کے نام درج کئے گیٔے اُن کی تعداد 59,300 تھی۔<verse eid="NUM 1:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="NUM 1:24"/>گادؔ کی نَسل سے:</para>
  <para style="li2" vid="NUM 1:24">بیس سال یا اُس سے زِیادہ عمر کے سبھی مَردوں کے نام جو فَوج میں خدمت کرنے کے قابل تھے اَپنی اَپنی برادری اَور خاندان کے مُطابق یکے بعد دیگرے درج کئے گیٔے۔ <verse eid="NUM 1:24"/><verse number="25" style="v" sid="NUM 1:25"/>اَور گادؔ کے قبیلہ سے جِن آدمیوں کے نام درج کئے گیٔے اُن کی تعداد 45,650 تھی۔<verse eid="NUM 1:25"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="26" style="v" sid="NUM 1:26"/>یہُوداہؔ کی نَسل سے:</para>
  <para style="li2" vid="NUM 1:26">بیس سال یا اُس سے زِیادہ عمر کے سبھی مَردوں کے نام جو فَوج میں خدمت کرنے کے قابل تھے اَپنی اَپنی برادری اَور خاندان کے مُطابق یکے بعد دیگرے درج کئے گیٔے۔ <verse eid="NUM 1:26"/><verse number="27" style="v" sid="NUM 1:27"/>یہُوداہؔ کے قبیلہ سے جِن آدمیوں کے نام درج کئے گیٔے اُن کی تعداد 74,600 تھی۔<verse eid="NUM 1:27"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="28" style="v" sid="NUM 1:28"/>یِسَّکاؔر کی نَسل سے:</para>
  <para style="li2" vid="NUM 1:28">بیس سال یا اُس سے زِیادہ عمر کے سبھی مَردوں کے نام جو فَوج میں خدمت کرنے کے قابل تھے اَپنی اَپنی برادری اَور خاندان کے مُطابق یکے بعد دیگرے درج کئے گیٔے۔ <verse eid="NUM 1:28"/><verse number="29" style="v" sid="NUM 1:29"/>یِسَّکاؔر کے قبیلہ سے جِن آدمیوں کے نام درج کئے گیٔے اُن کی تعداد 54,400 تھی۔<verse eid="NUM 1:29"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="30" style="v" sid="NUM 1:30"/>زبُولُون کی نَسل سے:</para>
  <para style="li2" vid="NUM 1:30">بیس سال یا اُس سے زِیادہ عمر کے سبھی مَردوں کے نام جو فَوج میں خدمت کرنے کے قابل تھے اَپنی اَپنی برادری اَور خاندان کے مُطابق یکے بعد دیگرے درج کئے گیٔے۔ <verse eid="NUM 1:30"/><verse number="31" style="v" sid="NUM 1:31"/>زبُولُون کے قبیلہ سے جِن آدمیوں کے نام درج کئے گیٔے اُن کی تعداد 57,400 تھی۔<verse eid="NUM 1:31"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="32" style="v" sid="NUM 1:32"/>یُوسیفؔ کی اَولاد:</para>
  <para style="li1" vid="NUM 1:32">یعنی اِفرائیمؔ کی نَسل سے:</para>
  <para style="li2" vid="NUM 1:32">بیس سال یا اُس سے زِیادہ عمر کے سبھی مَردوں کے نام جو فَوج میں خدمت کرنے کے قابل تھے اَپنی اَپنی برادری اَور خاندان کے مُطابق یکے بعد دیگرے درج کئے گیٔے۔ <verse eid="NUM 1:32"/><verse number="33" style="v" sid="NUM 1:33"/>اِفرائیمؔ کے قبیلہ سے جِن آدمیوں کے نام درج کئے گیٔے اُن کی تعداد 40,500 تھی۔<verse eid="NUM 1:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="NUM 1:34"/>منشّہ کی نَسل سے:</para>
  <para style="li2" vid="NUM 1:34">بیس سال یا اُس سے زِیادہ عمر کے سبھی مَردوں کے نام جو فَوج میں خدمت کرنے کے قابل تھے اَپنی اَپنی برادری اَور خاندان کے مُطابق یکے بعد دیگرے درج کئے گیٔے۔ <verse eid="NUM 1:34"/><verse number="35" style="v" sid="NUM 1:35"/>منشّہ کے قبیلہ سے جِن آدمیوں کے نام درج کئے گیٔے اُن کی تعداد 32,200 تھی۔<verse eid="NUM 1:35"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="36" style="v" sid="NUM 1:36"/>بِنیامین کی نَسل سے:</para>
  <para style="li2" vid="NUM 1:36">بیس سال یا اُس سے زِیادہ عمر کے سبھی مَردوں کے نام جو فَوج میں خدمت کرنے کے قابل تھے اَپنی اَپنی برادری اَور خاندان کے مُطابق یکے بعد دیگرے درج کئے گیٔے۔ <verse eid="NUM 1:36"/><verse number="37" style="v" sid="NUM 1:37"/>بِنیامین کے قبیلہ سے جِن آدمیوں کے نام درج کئے گیٔے اُن کی تعداد 35,400 تھی۔<verse eid="NUM 1:37"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 1:38"/>دانؔ کی نَسل سے:</para>
  <para style="li2" vid="NUM 1:38">بیس سال یا اُس سے زِیادہ عمر کے سبھی مَردوں کے نام جو فَوج میں خدمت کرنے کے قابل تھے اَپنی اَپنی برادری اَور خاندان کے مُطابق یکے بعد دیگرے درج کئے گیٔے۔ <verse eid="NUM 1:38"/><verse number="39" style="v" sid="NUM 1:39"/>دانؔ کے قبیلہ سے جِن آدمیوں کے نام درج کئے گیٔے اُن کی تعداد 62,700 تھی۔<verse eid="NUM 1:39"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="40" style="v" sid="NUM 1:40"/>آشیر کی نَسل سے:</para>
  <para style="li2" vid="NUM 1:40">بیس سال یا اُس سے زِیادہ عمر کے سبھی مَردوں کے نام جو فَوج میں خدمت کرنے کے قابل تھے اَپنی اَپنی برادری اَور خاندان کے مُطابق یکے بعد دیگرے درج کئے گیٔے۔ <verse eid="NUM 1:40"/><verse number="41" style="v" sid="NUM 1:41"/>آشیر کے قبیلہ سے جِن آدمیوں کے نام درج کئے گیٔے اُن کی تعداد 41,500 تھی۔<verse eid="NUM 1:41"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="42" style="v" sid="NUM 1:42"/>نفتالی کی نَسل سے:</para>
  <para style="li2" vid="NUM 1:42">بیس سال یا اُس سے زِیادہ عمر کے سبھی مَردوں کے نام جو فَوج میں خدمت کرنے کے قابل تھے اَپنی اَپنی برادری اَور خاندان کے مُطابق یکے بعد دیگرے درج کئے گیٔے۔ <verse eid="NUM 1:42"/><verse number="43" style="v" sid="NUM 1:43"/>نفتالی کے قبیلہ سے جِن آدمیوں کے نام درج کئے گیٔے اُن کی تعداد 53,400 تھی۔<verse eid="NUM 1:43"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="44" style="v" sid="NUM 1:44"/>مَوشہ اَور اَہرونؔ اَور بنی اِسرائیل کے بَارہ سرداروں نے جِس میں سے ہر ایک اَپنے اَپنے خاندان کا سردار تھا جِن مَردوں کو گِنا وہ یہی تھے۔ <verse eid="NUM 1:44"/><verse number="45" style="v" sid="NUM 1:45"/>چنانچہ تمام بنی اِسرائیل میں جتنے مَرد بیس سال یا اُس سے زِیادہ عمر کے تھے اَورجو اِسرائیل کی فَوج میں خدمت کرنے کے قابل تھے اَپنے اَپنے خاندانوں کے مُطابق شُمار کئے گیٔے۔ <verse eid="NUM 1:45"/><verse number="46" style="v" sid="NUM 1:46"/>اُن کی کُل تعداد 6,03,550 تھی۔<verse eid="NUM 1:46"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="47" style="v" sid="NUM 1:47"/>البتّہ لیوی کے قبیلہ کے خاندانوں کا اَوروں کے ساتھ شُمار نہ کیا گیا۔ <verse eid="NUM 1:47"/><verse number="48" style="v" sid="NUM 1:48"/>کیونکہ یَاہوِہ نے مَوشہ سے فرمایا تھا، <verse eid="NUM 1:48"/><verse number="49" style="v" sid="NUM 1:49"/>”تُم لیوی کے قبیلہ کا شُمار نہ کرنا اَور نہ ہی اُنہیں دُوسرے اِسرائیلیوں کی مردُم شماری میں شامل کرنا۔ <verse eid="NUM 1:49"/><verse number="50" style="v" sid="NUM 1:50"/>بَلکہ تُم لیویوں کو مَسکن اَور اُس کی تمام آرائِش کی چیزوں اَور اُس سے متعلّقہ ہر شَے کا نِگراں مُقرّر کرنا۔ وہ مَسکن اَور اُس کی آرائِش کی چیزوں کو اُٹھائیں اُس کی حِفاظت کریں اَور اُس کے اطراف ڈیرے ڈالیں۔ <verse eid="NUM 1:50"/><verse number="51" style="v" sid="NUM 1:51"/>جَب کبھی مَسکن کے خیمہ کو کہیں اَور لے جانے کا وقت آئے تو لیوی اُسے گرائیں اَور جَب کبھی اُسے کھڑا کرنے کا موقع آئے تو لیوی ہی یہ کام کریں۔ اَور اگر کویٔی اَور شخص اُس کے قریب آ جائے تو وہ جان سے ماراجائے۔ <verse eid="NUM 1:51"/><verse number="52" style="v" sid="NUM 1:52"/>اَور بنی اِسرائیل اَپنے اَپنے دستوں کے مُطابق اَپنے خیمے کھڑے کریں یعنی ہر شخص اَپنی اَپنی چھاؤنی میں اَور اَپنے اَپنے پرچم کے نیچے خیمہ زن ہو۔ <verse eid="NUM 1:52"/><verse number="53" style="v" sid="NUM 1:53"/>البتّہ لیوی شہادت کے مَسکن کے اطراف اَپنے خیمے کھڑے کریں تاکہ بنی اِسرائیل کی جماعت پر غضب نازل نہ ہو۔ لیوی شہادت کے مَسکن کی حِفاظت کے ذمّہ دار ہوں گے۔“<verse eid="NUM 1:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="NUM 1:54"/>چنانچہ بنی اِسرائیل نے وَیسا ہی کیا، جَیسا یَاہوِہ نے مَوشہ کو حُکم دیا تھا۔<verse eid="NUM 1:54"/></para>
  <chapter eid="NUM 1"/>
  <chapter number="2" style="c" sid="NUM 2"/>
  <para style="s1">قبیلوں کی چھاؤنیوں کی ترتیب</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 2:1"/>یَاہوِہ نے مَوشہ اَور اَہرونؔ کو حُکم دیا: <verse eid="NUM 2:1"/><verse number="2" style="v" sid="NUM 2:2"/>”بنی اِسرائیل خیمہ اِجتماع کے اِردگرد لیکن اُس سے کچھ فاصلہ پر اَپنے اَپنے پرچموں کے نیچے اَور اَپنے اَپنے آبائی خاندانوں کے پرچموں کے ساتھ اَپنی چھاؤنیاں قائِم کریں۔“<verse eid="NUM 2:2"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="3" style="v" sid="NUM 2:3"/>اَور مشرق کی جانِب جہاں سے آفتاب طُلوع ہوتاہے:</para>
  <para style="li1" vid="NUM 2:3">یہُوداہؔ کی چھاؤنی کے دستے اَپنے جھنڈے کے نیچے اَپنے ڈیرے لگائیں اَور عَمّیندابؔ کا بیٹا نحشونؔ یہُوداہؔ کا سردار ہوگا۔ <verse eid="NUM 2:3"/><verse number="4" style="v" sid="NUM 2:4"/>اَور اُس کے دستے کے شُمار کَردہ مَردوں کی تعداد 74,600 ہے۔<verse eid="NUM 2:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="NUM 2:5"/>یِسَّکاؔر کا قبیلہ اُن کے مُتّصل خیمہ زن ہو اَور ضُعرؔ کا بیٹا نتنی ایل بنی یِسَّکاؔر کا سردار ہوگا۔ <verse eid="NUM 2:5"/><verse number="6" style="v" sid="NUM 2:6"/>اَور اُس کے دستوں کے شُمار کَردہ مَردوں کی تعداد 54,400 ہے۔<verse eid="NUM 2:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 2:7"/>زبُولُون کا قبیلہ اُن کے مُتّصل ہوگا اَور حیلونؔ کا بیٹا اِلیابؔ بنی زبُولُون کا سردار ہوگا۔ <verse eid="NUM 2:7"/><verse number="8" style="v" sid="NUM 2:8"/>اَور اُس کے دستے کے شُمار کئے ہویٔے مَردوں کی تعداد 57,400 ہے۔<verse eid="NUM 2:8"/></para>
  <para style="lf">
    <verse number="9" style="v" sid="NUM 2:9"/>یہُوداہؔ کی چھاؤنی کے لیٔے نامزد کَردہ تمام مَردوں کی تعداد اُن کے اَپنے دستوں کے مُطابق 1,86,400 ہے۔ پہلے یہی کُوچ کریں گے۔<verse eid="NUM 2:9"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="10" style="v" sid="NUM 2:10"/>جُنوب کی جانِب</para>
  <para style="li1" vid="NUM 2:10">رُوبِنؔ کی چھاؤنی کے دستے اَپنے اَپنے جھنڈوں کے نیچے ہوں گے اَور شدِیُورؔ کا بیٹا اِلیضُورؔ بنی رُوبِنؔ کا سردار ہوگا۔ <verse eid="NUM 2:10"/><verse number="11" style="v" sid="NUM 2:11"/>اُس کے دستے کے شُمار کَردہ مَردوں کی تعداد 46,500 ہے۔<verse eid="NUM 2:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 2:12"/>شمعُونؔ کا قبیلہ اُن کے مُتّصل خیمہ زن ہوگا اَور ضُوریشدّؔی کا بیٹا سلُومی ایل بنی شمعُونؔ کا سردار ہوگا۔ <verse eid="NUM 2:12"/><verse number="13" style="v" sid="NUM 2:13"/>اُس کے دستے کے شُمار کَردہ مَردوں کی تعداد 59,300 ہے۔<verse eid="NUM 2:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 2:14"/>گادؔ کا قبیلہ اُن کے مُتّصل ہوگا اَور دعُوایلؔ<note caller="+" style="f"><char style="fr" closed="false">2‏:14 </char><char style="fq" closed="false">دعُوایلؔ </char><char style="ft" closed="false">کچھ نُسخوں میں </char><char style="fqa" closed="false">رِعوایلؔ بھی لِکھا ہُواہے۔</char></note> کا بیٹا اِلیاسفؔ بنی گادؔ کا سردار ہوگا۔ <verse eid="NUM 2:14"/><verse number="15" style="v" sid="NUM 2:15"/>اُس کے دستے کے شُمار کَردہ مَردوں کی تعداد 45,650 ہے۔<verse eid="NUM 2:15"/></para>
  <para style="lf">
    <verse number="16" style="v" sid="NUM 2:16"/>رُوبِنؔ کی چھاؤنی کے لیٔے نامزد کئے ہویٔے تمام مَردوں کی تعداد اُن کے اَپنے دستوں کے مُطابق 1,51,450 ہے۔ کُوچ کے وقت اِن کا دُوسرا مقام ہوگا۔<verse eid="NUM 2:16"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="17" style="v" sid="NUM 2:17"/>تَب سَب چھاؤنیوں کے درمیان سے خیمہ اِجتماع اَور لیویوں کی چھاؤنی کے افراد کُوچ کریں گے اَور وہ اِسی ترتیب سے جَیسے کے اُن کے ڈیرے کھڑے ہوں گے اَپنی اَپنی جگہ پر اَور اَپنے اَپنے جھنڈے کے نیچے کُوچ کریں گے۔<verse eid="NUM 2:17"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="18" style="v" sid="NUM 2:18"/>مغرب کی جانِب اِفرائیمؔ کی چھاؤنی کے دستے اَپنے اَپنے پرچم کے نیچے ہوں گے</para>
  <para style="li1" vid="NUM 2:18">اَور عمّیہُوؔد کا بیٹا اِلیشمعؔ بنی اِفرائیمؔ کا سردار ہوگا۔ <verse eid="NUM 2:18"/><verse number="19" style="v" sid="NUM 2:19"/>اُس کے دستے کے شُمار کَردہ مَردوں کی تعداد 40,500 ہے۔<verse eid="NUM 2:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 2:20"/>منشّہ کا قبیلہ اُن کے مُتّصل ہوگا اَور پِداہضُورؔ کا بیٹا گَملی ایل بنی منشّہ کا سردار ہوگا۔ <verse eid="NUM 2:20"/><verse number="21" style="v" sid="NUM 2:21"/>اُس کے لشکر کے شُمار کَردہ مَردوں کی تعداد 32,200 ہے۔<verse eid="NUM 2:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 2:22"/>پھر بِنیامین کا قبیلہ ہوگا اَور ابیدانؔ بِن گِدعونیؔ بنی بِنیامین کا سردار ہوگا۔ <verse eid="NUM 2:22"/><verse number="23" style="v" sid="NUM 2:23"/>اُس کے دستے کے شُمار کَردہ مَردوں کی تعداد 35,400 ہے۔<verse eid="NUM 2:23"/></para>
  <para style="lf">
    <verse number="24" style="v" sid="NUM 2:24"/>اِفرائیمؔ کی چھاؤنی کے لیٔے نامزد کئے ہویٔے تمام مَردوں کی تعداد اُن کے اَپنے دستوں کے مُطابق 1,08,100 ہے۔ کُوچ کے وقت اُن کا مقام تیسرا ہوگا۔<verse eid="NUM 2:24"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="25" style="v" sid="NUM 2:25"/>شمال کی جانِب</para>
  <para style="li1" vid="NUM 2:25">دانؔ کی چھاؤنی کے دستے اَپنے اَپنے پرچموں کے نیچے ہوں گے اَور احیعزر بِن عمّی شدّؔی بنی دانؔ کا سردار ہوگا۔ <verse eid="NUM 2:25"/><verse number="26" style="v" sid="NUM 2:26"/>اُس کے دستے کے شُمار کَردہ مَردوں کی تعداد 62,700 ہے۔<verse eid="NUM 2:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="NUM 2:27"/>آشیر کا قبیلہ اُن کے مُتّصل خیمہ زن ہوگا اَور عُکرانؔ کا بیٹا پگعِیلؔ بنی آشیر کا سردار ہوگا۔ <verse eid="NUM 2:27"/><verse number="28" style="v" sid="NUM 2:28"/>اُس کے دستے کے شُمار کَردہ مَردوں کی تعداد 41,500 ہے۔<verse eid="NUM 2:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="NUM 2:29"/>پھر نفتالی کا قبیلہ ہوگا اَور عینانؔ کا بیٹا اَخیرعؔ بنی نفتالی کا سردار ہوگا۔ <verse eid="NUM 2:29"/><verse number="30" style="v" sid="NUM 2:30"/>اُس کے دستوں کے شُمار کَردہ مَردوں کی تعداد 53,400 ہے۔<verse eid="NUM 2:30"/></para>
  <para style="lf">
    <verse number="31" style="v" sid="NUM 2:31"/>دانؔ کی چھاؤنی کے لیٔے نامزد کَردہ تمام مَردوں کی تعداد 1,57,600 ہے۔ وہ اَپنے اَپنے پرچموں کے نیچے سَب سے پیچھے کُوچ کریں گے۔<verse eid="NUM 2:31"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="32" style="v" sid="NUM 2:32"/>یہی وہ اِسرائیلی ہیں جو اَپنے اَپنے آبائی خاندانوں کے مُطابق شُمار کئے گیٔے۔ اَور چھاؤنیوں کے سَب لوگوں کی تعداد جو اَپنے اَپنے دستوں کے مُطابق شُمار کئے گیٔے 6,03,550 ہے۔ <verse eid="NUM 2:32"/><verse number="33" style="v" sid="NUM 2:33"/>البتّہ جَیسا یَاہوِہ نے مَوشہ کو حُکم دیا تھا اُس کے مُطابق لیوی دُوسرے اِسرائیلیوں کے ساتھ شُمار نہ کئے گیٔے۔<verse eid="NUM 2:33"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="34" style="v" sid="NUM 2:34"/>چنانچہ جَیسا یَاہوِہ نے مَوشہ کو حُکم دیا تھا بنی اِسرائیل نے وَیسا ہی کیا اَور اِسی طریقہ سے وہ اَپنی اَپنی برادری والوں اَور خاندان کے ساتھ اَپنے اَپنے پرچموں کے نیچے قِیام کرتے اَور کُوچ کرتے گیٔے۔<verse eid="NUM 2:34"/></para>
  <chapter eid="NUM 2"/>
  <chapter number="3" style="c" sid="NUM 3"/>
  <para style="s1">بنی لیوی</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 3:1"/>جِس وقت یَاہوِہ نے کوہِ سِینؔائی پر مَوشہ سے باتیں کیں اُس وقت اَہرونؔ اَور مَوشہ کے خاندان کا نَسب نامہ یہ تھا۔<verse eid="NUM 3:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="NUM 3:2"/>اَہرونؔ کے بیٹوں کے نام نادابؔ جو پہلوٹھا تھا اَبِیہُو الیعزرؔ اَور اِتمارؔ ہیں۔ <verse eid="NUM 3:2"/><verse number="3" style="v" sid="NUM 3:3"/>اَہرونؔ کے اُن بیٹوں کے نام جو ممسوح کاہِنؔ تھے اَور کہانت کی خدمت کے لیٔے مُقرّر کئے گیٔے تھے یہی ہیں۔ <verse eid="NUM 3:3"/><verse number="4" style="v" sid="NUM 3:4"/>البتّہ نادابؔ اَور اَبِیہُو یَاہوِہ کے حُضُور اُسی وقت مَر گیٔے تھے جَب اُنہُوں نے سِینؔائی کے بیابان میں اُن کے حُضُور ناجائز آگ کے ساتھ نذر گذرانی تھی۔ اُن کے کویٔی اَولاد نہ تھی اِس لیٔے صِرف الیعزرؔ اَور اِتمارؔ ہی اَپنے باپ اَہرونؔ کی زندگی میں کاہِنؔ کی خدمت اَنجام دیتے تھے۔<verse eid="NUM 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 3:5"/>پھر یَاہوِہ نے مَوشہ سے فرمایا، <verse eid="NUM 3:5"/><verse number="6" style="v" sid="NUM 3:6"/>”لیوی کے قبیلہ کو لاکر اَہرونؔ کاہِنؔ کے سامنے حاضِر کر تاکہ وہ اُس کی مدد کریں۔ <verse eid="NUM 3:6"/><verse number="7" style="v" sid="NUM 3:7"/>وہ خیمہ اِجتماع میں مُلاقات کے خیمہ کی نگہبانی کریں اَورجو فرائض اَہرونؔ اَور ساری جماعت کی طرف سے اُن پر عاید کام ہیں اُنہیں بجا لائیں۔ <verse eid="NUM 3:7"/><verse number="8" style="v" sid="NUM 3:8"/>وہ خیمہ اِجتماع کی تمام اشیائے آرائِش کی حِفاظت کریں اَور شہادت کے خیمہ میں خدمت اَنجام دیتے ہویٔے بنی اِسرائیل کے مَسکن کے فرائض کو پُورا کریں۔ <verse eid="NUM 3:8"/><verse number="9" style="v" sid="NUM 3:9"/>تُم لیویوں کو اَہرونؔ اَور اُس کے بیٹوں کے سُپرد کر دو۔ بنی اِسرائیل میں سے یہی لوگ اُن کی مدد کے لیٔے مُقرّر کئے گیٔے ہیں۔ <verse eid="NUM 3:9"/><verse number="10" style="v" sid="NUM 3:10"/>اَہرونؔ اَور اُس کے بیٹے ہی بطور کاہِنؔ کہانت کے لیٔے مُقرّر کئے جایٔیں۔ اگر کویٔی اَور شخص پاک مَقدِس کے قریب آئے تو وہ جان سے ماراجائے۔“<verse eid="NUM 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 3:11"/>یَاہوِہ نے مَوشہ سے یہ بھی فرمایا، <verse eid="NUM 3:11"/><verse number="12" style="v" sid="NUM 3:12"/>”مَیں نے بنی اِسرائیل میں سے لیویوں کو ہر اِسرائیلی عورت کے پہلوٹھے کے عِوض لے لیا ہے۔ لہٰذا لیوی میرے ہیں۔ <verse eid="NUM 3:12"/><verse number="13" style="v" sid="NUM 3:13"/>کیونکہ سَب پہلوٹھے میرے ہیں۔ جَب مَیں نے مُلک مِصر میں سَب پہلوٹھوں کو مارا تھا تَب مَیں نے اِسرائیل کے ہر پہلوٹھے کو خواہ وہ اِنسان کا ہو یا حَیوان کا اَپنے لیٔے مخصُوص کر لیا تھا۔ وہ میرے ہیں۔ میں ہی یَاہوِہ ہُوں۔“<verse eid="NUM 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 3:14"/>پھر یَاہوِہ نے سِینؔائی کے بیابان میں مَوشہ سے فرمایا، <verse eid="NUM 3:14"/><verse number="15" style="v" sid="NUM 3:15"/>”لیویوں کا اُن کے آبائی خاندانوں اَور برادری کے مُطابق شُمار کر۔ ایک ماہ یا اُس سے زِیادہ عمر کے ہر لڑکے کو شُمار کر۔“ <verse eid="NUM 3:15"/><verse number="16" style="v" sid="NUM 3:16"/>چنانچہ جَیسا یَاہوِہ نے اَپنے کلام کے ذریعہ حُکم دیا تھا مَوشہ نے اُس کے مُطابق اُن کا شُمار کیا۔<verse eid="NUM 3:16"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="17" style="v" sid="NUM 3:17"/>لیوی کے بیٹوں کے نام یہ تھے:</para>
  <para style="li2" vid="NUM 3:17">گیرشون، قُہات اَور مِراریؔ۔<verse eid="NUM 3:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="NUM 3:18"/>گیرشون کے گھرانوں کے نام یہ تھے:</para>
  <para style="li2" vid="NUM 3:18">لِبنیؔ اَور شِمعیؔ۔<verse eid="NUM 3:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="NUM 3:19"/>قُہاتی کی برادری والے یہ ہیں:</para>
  <para style="li2" vid="NUM 3:19">عمرامؔ، اِضہاؔر، حِبرونؔ اَور عُزّی ايل<verse eid="NUM 3:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 3:20"/>مِراریؔ کی برادری والے یہ ہیں:</para>
  <para style="li2" vid="NUM 3:20">محلیؔ اَور مُوشیؔ۔</para>
  <para style="b" vid="NUM 3:20"/>
  <para style="lf" vid="NUM 3:20">لیویوں کی برادری والے اُن کی برادری اَور خاندانوں کے مُطابق یہی تھے۔<verse eid="NUM 3:20"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="21" style="v" sid="NUM 3:21"/>لِبنیؔ اَور شِمعیؔ کی برادری کا گیرشون سے تعلّق تھا۔ یہ گیرشونیوں کی برادری والے تھے۔<verse eid="NUM 3:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 3:22"/>اُن میں ایک ماہ یا اُس سے زِیادہ عمر کے لڑکوں کی تعداد جِن کا شُمار کیا گیا تھا 7,500 تھی۔<verse eid="NUM 3:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="NUM 3:23"/>گیرشونیوں کی برادری والوں کو مُلاقات کے مَسکن کے پیچھے مغرب کی جانِب ڈیرے ڈالنے تھے۔<verse eid="NUM 3:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="NUM 3:24"/>اَور لاایلؔ کا بیٹا اِلیاسفؔ گیرشونیوں کی برادری والوں کا سردار تھا۔<verse eid="NUM 3:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="NUM 3:25"/>اَور بنی گیرشون خیمہ اِجتماع میں اِن چیزوں کی دیکھ بھال کے ذمّہ دار تھے، مُلاقات کے خیمہ، اَور اُس کا غلاف، خیمہ اِجتماع کے دروازہ کا پردہ، <verse eid="NUM 3:25"/><verse number="26" style="v" sid="NUM 3:26"/>مُلاقات کے مَسکن اَور مذبح کے گِرد کے صحن کے دروازہ کا پردہ اَور رسّیاں اَور اُن کے اِستعمال سے تعلّق رکھنے والے سارے کام بھی اُن کے ذمّہ تھے۔<verse eid="NUM 3:26"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="27" style="v" sid="NUM 3:27"/>عمرامی، اِضہاری، حِبرونی اَور عُزّی ایلیوں کی برادری والے قُہات سے تعلّق رکھتے تھے۔ یہ نَسل قُہاتیوں کے خاندان تھے۔<verse eid="NUM 3:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="NUM 3:28"/>اِن میں ایک ماہ یا اُس سے زِیادہ عمر کے لڑکوں کی تعداد، جِن کا شُمار کیا گیا تھا 8,600 تھی۔</para>
  <para style="li1" vid="NUM 3:28">قُہاتی پاک مَقدِس کے مذبح کی دیکھ بھال کے ذمّہ دار تھے۔<verse eid="NUM 3:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="NUM 3:29"/>قُہاتی کی برادری والوں کو مُلاقات کے مَسکن کے جُنوب کی جانِب خیمہ زن ہونا تھا<verse eid="NUM 3:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="NUM 3:30"/>اَور عُزّی ايل کا بیٹا اِلیضفنؔ قُہاتی خاندان کی برادری اَور خاندان کا سردار تھا۔<verse eid="NUM 3:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="NUM 3:31"/>صندُوق، میز، چراغدان، مذبحوں، عبادت میں کام آنے والے پاک مَقدِس کے ظروف، پردہ اَور اُن کے لیٔے اِستعمال میں آنے والی ہر چیز کی دیکھ بھال اُن کے ذمّہ تھی۔<verse eid="NUM 3:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="NUM 3:32"/>اَور اَہرونؔ کاہِنؔ کا بیٹا الیعزرؔ لیویوں کا سردار اعلیٰ تھا۔ وہ اُن لوگوں کے اُوپر مُقرّر کیا گیا تھا جو پاک مَقدِس کی حِفاظت کے ذمّہ دار تھے۔<verse eid="NUM 3:32"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="33" style="v" sid="NUM 3:33"/>محلیؔ اَور مُوشیؔ کی برادری والوں کا تعلّق مِراریؔ سے تھا۔ یہ مِراریؔ نَسل سے تھے۔<verse eid="NUM 3:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="NUM 3:34"/>اُن میں ایک ماہ یا اُس سے زِیادہ عمر کے لڑکوں کی تعداد جِن کا شُمار کیا گیا تھا 6,200 تھی۔<verse eid="NUM 3:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="NUM 3:35"/>اَور اَبی حائیل کا بیٹا ضُوری ایل، مِراریؔ کی برادری کے خاندان کا سردار تھا۔</para>
  <para style="li1" vid="NUM 3:35">اُنہیں مُلاقات کے مَسکن کے شمال کی جانِب خیمہ زن ہونا تھا۔<verse eid="NUM 3:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="NUM 3:36"/>بنی مِراریؔ کو مُلاقات کے مَسکن کی چوکھٹوں، اُس کے بینڈوں، سُتونوں اَور خانوں، اُس کے تمام سازوسامان اَور اُن کے اِستعمال سے تعلّق رکھنے والی ہر چیز کی ذمّہ داری سونپی گئی <verse eid="NUM 3:36"/><verse number="37" style="v" sid="NUM 3:37"/>اَور اِردگرد کے صحن کے سُتونوں اَور اُن کے خانوں، خیموں کی میخوں اَور رسّیوں کی دیکھ بھال کرنا بھی اُن کے ذمّہ تھا۔<verse eid="NUM 3:37"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 3:38"/>مَوشہ اَور اَہرونؔ اَور اُس کے بیٹوں کو مُلاقات کے خیمہ کے مشرق کی جانِب جہاں سے آفتاب طُلوع ہوتاہے یعنی خیمہ اِجتماع کے سامنے خیمہ زن ہونا تھا۔</para>
  <para style="li1" vid="NUM 3:38">وہ بنی اِسرائیل کی خاطِر پاک مَقدِس کی حِفاظت کے ذمّہ دار تھے۔</para>
  <para style="li1" vid="NUM 3:38">اگر کویٔی اَور شخص پاک مَقدِس کے قریب جاتا تو وہ جان سے مار دیا جاتا تھا۔<verse eid="NUM 3:38"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="39" style="v" sid="NUM 3:39"/>مَوشہ اَور اَہرونؔ نے یَاہوِہ کے حُکم کے مُطابق ایک ماہ یا اُس سے زِیادہ عمر کے لڑکوں سمیت جتنے لیویوں کو اُن کے اَپنے اَپنے گھرانوں کے مُطابق شُمار کیا اُن کی تعداد 22,000 تھی۔<verse eid="NUM 3:39"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="40" style="v" sid="NUM 3:40"/>یَاہوِہ نے مَوشہ سے فرمایا، ”بنی اِسرائیل کے ایک ماہ یا اُس سے زِیادہ عمر کے تمام پہلوٹھے لڑکوں کا شُمار کر اَور اُن کے نام کی فہرست مُرتّب کر۔ <verse eid="NUM 3:40"/><verse number="41" style="v" sid="NUM 3:41"/>اَور بنی اِسرائیل کے سَب پہلوٹھوں کے عِوض لیویوں کو، اَور بنی اِسرائیل کے مویشیوں کے سَب پہلوٹھوں کے عِوض لیویوں کے مویشیوں کو میرے لیٔے لے۔ میں ہی یَاہوِہ ہُوں۔“<verse eid="NUM 3:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 3:42"/>چنانچہ مَوشہ نے یَاہوِہ کے حُکم کے مُطابق بنی اِسرائیل کے سَب پہلوٹھوں کا شُمار کیا۔ <verse eid="NUM 3:42"/><verse number="43" style="v" sid="NUM 3:43"/>اَور ایک ماہ یا اُس سے زِیادہ عمر کے نرینہ پہلوٹھوں کی تعداد اُن کے ناموں کی فہرست کے مُطابق 22,273 تھی۔<verse eid="NUM 3:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 3:44"/>یَاہوِہ نے مَوشہ سے یہ بھی فرمایا، <verse eid="NUM 3:44"/><verse number="45" style="v" sid="NUM 3:45"/>”بنی اِسرائیل کے سَب پہلوٹھوں کے عِوض لیویوں کو اَور اُن کے مویشیوں کے عِوض لیویوں کے مویشیوں کو لیں اَور لیوی میرے ہُوں۔ میں ہی یَاہوِہ ہُوں۔ <verse eid="NUM 3:45"/><verse number="46" style="v" sid="NUM 3:46"/>اَور بنی اِسرائیل کے 273 پہلوٹھوں کے فدیہ کے لیٔے جو لیویوں کی تعداد سے زِیادہ ہیں <verse eid="NUM 3:46"/><verse number="47" style="v" sid="NUM 3:47"/>پاک مَقدِس کے ثاقل کے حِساب سے جو وزن میں بیس گیراہ کے برابر ہوتاہے فی کس پانچ ثاقل<note caller="+" style="f"><char style="fr" closed="false">3‏:47 </char><char style="fq" closed="false">پانچ ثاقل </char><char style="ft" closed="false">قریب اٹھّاون گرام</char></note> لیں۔ <verse eid="NUM 3:47"/><verse number="48" style="v" sid="NUM 3:48"/>اَور وہ رُوپیہ اُن زِیادہ اِسرائیلیوں کے فدیہ کے لیٔے اَہرونؔ اَور اُس کے بیٹوں کو دیں۔“<verse eid="NUM 3:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="NUM 3:49"/>چنانچہ مَوشہ نے اُن سے جو تعداد میں لیویوں کے چھُڑائے ہوؤں سے زِیادہ تھے فدیہ کا رُوپیہ لیا۔ <verse eid="NUM 3:49"/><verse number="50" style="v" sid="NUM 3:50"/>اَور بنی اِسرائیل کے پہلوٹھوں سے اُس نے پاک مَقدِس کے ثاقل کے حِساب سے 1,365 ثاقل<note caller="+" style="f"><char style="fr" closed="false">3‏:50 </char><char style="fq" closed="false">1,365 ثاقل </char><char style="ft" closed="false">قریب سولہ گرام</char></note> چاندی وصول کی۔ <verse eid="NUM 3:50"/><verse number="51" style="v" sid="NUM 3:51"/>اَور مَوشہ نے یَاہوِہ کے حُکم کے مُطابق فدیہ کی رقم اَہرونؔ اَور اُس کے بیٹوں کو دیا۔<verse eid="NUM 3:51"/></para>
  <chapter eid="NUM 3"/>
  <chapter number="4" style="c" sid="NUM 4"/>
  <para style="s1">بنی قُہات</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 4:1"/>یَاہوِہ نے مَوشہ اَور اَہرونؔ سے فرمایا: <verse eid="NUM 4:1"/><verse number="2" style="v" sid="NUM 4:2"/>”لیویوں کے خاندان میں سے قُہاتی طبقہ کی اُن کے گھرانوں اَور آبائی خاندانوں کے مُطابق مردُم شماری کرو۔ <verse eid="NUM 4:2"/><verse number="3" style="v" sid="NUM 4:3"/>تیس سے لے کر پچاس سال کی عمر کے سبھی مَردوں کو جو خیمہ اِجتماع کی خدمت میں ہاتھ بٹانے کے لیٔے آتے ہیں شُمار کرو۔<verse eid="NUM 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 4:4"/>”خیمہ اِجتماع میں بنی قُہات کا کام یہ ہوگا کہ وہ پاک ترین اَشیا کی حِفاظت کریں۔ <verse eid="NUM 4:4"/><verse number="5" style="v" sid="NUM 4:5"/>جَب لشکر کُوچ کرے تَب اَہرونؔ اَور اُس کے بیٹے اَندر جایٔیں اَور بیچ کے پردے کو اُتاریں اَور اُس سے عہد کے صندُوق کو ڈھانک دیں۔ <verse eid="NUM 4:5"/><verse number="6" style="v" sid="NUM 4:6"/>تَب وہ اُس پر دریائی بچھڑوں کی کھالوں کا غلاف چڑھائیں اَور اُس کے اُوپر بالکُل نیلے رنگ کا کپڑا بچھائیں اَور بَلّیاں اَپنی جگہ پر گاڑ دیں۔<verse eid="NUM 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 4:7"/>”پھر نذر کی روٹی کی میز پر نیلا کپڑا بچھا کر اُس پر طباق، ڈونگے، پیالے اَور تپاون کی نذروں کے مرتبان رکھیں اَور نذر کی روٹی بھی اُس پر لگاتار قائِم رہے۔ <verse eid="NUM 4:7"/><verse number="8" style="v" sid="NUM 4:8"/>اُن کے اُوپر وہ سُرخ رنگ کا کپڑا بچھائیں جسے دریائی بچھڑوں کی کھالوں سے ڈھانکیں اَور اُس کی بَلّیاں اَپنی جگہ پر گاڑ دیں۔<verse eid="NUM 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 4:9"/>”پھر وہ نیلے رنگ کا کپڑا لیں اَور اُس سے چراغدان کو جو رَوشنی کے لیٔے ہے اُس کے چراغوں، اُس کی بتّی کترنے کی قینچیوں اَور کشتیوں اَور اُس کے سَب مرتبانوں سمیت جِن میں زَیتُون کا تیل مہیا کیا جاتا ہے ڈھانک دیں۔ <verse eid="NUM 4:9"/><verse number="10" style="v" sid="NUM 4:10"/>تَب وہ اُسے اُس کے تمام سازوسامان کے ساتھ دریائی بچھڑوں کی کھالوں کے غلاف میں لپیٹیں اَور اُسے اُٹھانے والے چوکھٹے پر رکھ دیں۔<verse eid="NUM 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 4:11"/>”اَور زرّیں مذبح پر وہ نیلا کپڑا پھیلا دیں اَور اُسے دریائی بچھڑوں کی کھالوں سے ڈھانپ دیں اَور اُس کی بَلّیاں اَپنی اَپنی جگہ پر گاڑ دیں۔<verse eid="NUM 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 4:12"/>”تَب وہ اُن تمام برتنوں کو لے کرجو پاک مَقدِس کی خدمت میں کام آتے ہیں نیلے کپڑے میں لپیٹیں دریائی بچھڑوں کی کھالوں کے غلاف سے ڈھانکیں اَور چوکھٹے پر رکھ دیں۔<verse eid="NUM 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 4:13"/>”پھر وہ کانسے کے مذبح پر سے سَب راکھ اُٹھاکر اُس کے اُوپر اَرغوانی رنگ کا کپڑا بچھائیں۔ <verse eid="NUM 4:13"/><verse number="14" style="v" sid="NUM 4:14"/>پھر وہ اُس کے اُوپر وہ تمام برتن رکھیں جو مذبح پر خدمت کے لیٔے اِستعمال کئے جاتے ہیں جَیسے انگیٹھیاں، سیخیں، بیلچے اَور چھڑکاؤ کے پیالے۔ اُس کے اُوپر وہ دریائی بچھڑوں کی کھالوں کا غلاف بچھائیں اَور اُس کی بَلّیاں اَپنی جگہوں پر گاڑ دیں۔<verse eid="NUM 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 4:15"/>”جَب اَہرونؔ اَور اُس کے بیٹے آرائِش کے مُقدّس سازوسامان کو اَور تمام مُقدّس اَشیا کو ڈھانک چکیں اَور جَب چھاؤنی کُوچ کے لیٔے تیّار ہو تَب بنی قُہات اُٹھانے کے لیٔے آئیں۔ لیکن وہ مُقدّس اَشیا کو نہ چھُوئیں کہیں اَیسا نہ ہو کہ وہ مَر جایٔیں۔ بنی قُہات وُہی اَشیا اُٹھائیں جو خیمہ اِجتماع میں ہیں۔<verse eid="NUM 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 4:16"/>”اَہرونؔ کاہِنؔ کا بیٹا الیعزرؔ رَوشنی کے تیل، خُوشبودار بخُور، دائمی نذر کی قُربانی اَور مَسح کرنے کے زَیتُون کے تیل کی حِفاظت کا نِگراں ہوگا۔ وہ سارے مَسکن اَور اُس کے اَندر کی آرائِش کے مُقدّس سازوسامان سمیت ہر چیز کا ذمّہ دار ہوگا۔“<verse eid="NUM 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 4:17"/>پھر یَاہوِہ نے مَوشہ اَور اَہرونؔ سے کہا، <verse eid="NUM 4:17"/><verse number="18" style="v" sid="NUM 4:18"/>”خیال رہے کہ قُہاتیوں کے قبائلی خاندان لیویوں سے جُدا نہ ہونے پائیں۔ <verse eid="NUM 4:18"/><verse number="19" style="v" sid="NUM 4:19"/>تاکہ جَب وہ نہایت مُقدّس اَشیا کے قریب آئیں تو زندہ رہیں اَور مَر نہ جایٔیں۔ تُم اُن کی خاطِر اَیسا کرنا کہ اَہرونؔ اَور اُس کے بیٹے پاک مَقدِس کے اَندر جایٔیں اَور یہ طے کریں کہ اُن میں سے ہر ایک کیا کام کرے اَور کون سا بوجھ اُٹھائے۔ <verse eid="NUM 4:19"/><verse number="20" style="v" sid="NUM 4:20"/>لیکن قوہاتی مُقدّس چیزوں کو دیکھنے کی خاطِر دَم بھرکے لیٔے بھی اَندر نہ آنے پائیں۔ کہیں اَیسا نہ ہو کہ وہ مَر جایٔیں۔“<verse eid="NUM 4:20"/></para>
  <para style="s1">بنی گیرشون</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 4:21"/>یَاہوِہ نے مَوشہ سے فرمایا، <verse eid="NUM 4:21"/><verse number="22" style="v" sid="NUM 4:22"/>”بنی گیرشون کے آبائی خاندانون اَور اُن کے بھی گھرانوں کے مُطابق مردُم شماری کرو۔ <verse eid="NUM 4:22"/><verse number="23" style="v" sid="NUM 4:23"/>تیس سے لے کر پچاس سال کی عمر کے سبھی مَردوں کو جو خیمہ اِجتماع کی خدمت میں ہاتھ بٹانے کے لیٔے آتے ہیں شُمار کرو۔<verse eid="NUM 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 4:24"/>”کام کرنے اَور بوجھ اُٹھانے میں گیرشونیوں کے خاندان یہ خدمت بجا لائیں: <verse eid="NUM 4:24"/><verse number="25" style="v" sid="NUM 4:25"/>وہ مَسکن کے پردے، خیمہ اِجتماع، اُس کے غلاف، دریائی بچھڑوں کی کھالوں کا اُوپری غلاف، خیمہ اِجتماع کے دروازہ کے پردے، <verse eid="NUM 4:25"/><verse number="26" style="v" sid="NUM 4:26"/>مَسکن اَور مذبح کے اِردگرد صحن کے پردے، دروازہ کا پردہ اَور رسّیاں اَور وہ سَب آلات جو اُس کے کام میں اِستعمال ہوتے ہیں، اُٹھایا کریں۔ اَور اُن چیزوں کے ساتھ جو کچھ کیا جاتا ہے وہ سَب گیرشون ہی کیا کریں۔ <verse eid="NUM 4:26"/><verse number="27" style="v" sid="NUM 4:27"/>گیرشونیوں کی ساری خدمت خواہ وہ بوجھ اُٹھانا یا دیگر کام کرنا ہو اَہرونؔ اَور اُس کے بیٹوں کی ہدایات کے مُطابق اَنجام پایٔے۔ جو کچھ اُنہیں اُٹھانا ہے اُس کی ذمّہ داری تُم اُن کے سُپرد کر دو۔ <verse eid="NUM 4:27"/><verse number="28" style="v" sid="NUM 4:28"/>خیمہ اِجتماع میں گیرشونیوں کے گھرانوں کی یہی خدمت رہے گی اَور اُن کی خدمات اَہرونؔ کاہِنؔ کے بیٹے اِتمارؔ کی ہدایات کے مُطابق ہوگی۔<verse eid="NUM 4:28"/></para>
  <para style="s1">بنی مِراریؔ</para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 4:29"/>”بنی مِراریؔ کو بھی اُن کے گھرانوں اَور آبائی خاندانوں کے مُطابق شُمار کر <verse eid="NUM 4:29"/><verse number="30" style="v" sid="NUM 4:30"/>تیس سے لے کر پچاس سال کی عمر تک کے سبھی مَردوں کو جو خیمہ اِجتماع کی خدمت میں ہاتھ بٹانے کے لیٔے آتے ہیں شُمار کر۔ <verse eid="NUM 4:30"/><verse number="31" style="v" sid="NUM 4:31"/>اَور خیمہ اِجتماع میں وہ یہ خدمت اَنجام دیں: مَسکن کے تختے، اُس کے بینڈے، سُتون اَور خانے <verse eid="NUM 4:31"/><verse number="32" style="v" sid="NUM 4:32"/>اَور چاروں طرف کے صحن کے سُتون اَور اُن کے خانے، خیموں کی میخیں، رسّیاں، اُن کے تمام آلات اَور اُن کے اِستعمال میں آنے والی ہر چیز کو وہ اُٹھایا کریں۔ ہر شخص کو خاص خاص چیزیں اُٹھانے کی ذمّہ داری سونپی جائے۔ <verse eid="NUM 4:32"/><verse number="33" style="v" sid="NUM 4:33"/>بنی مِراریؔ کے خاندانوں کو خیمہ اِجتماع میں اَہرونؔ کاہِنؔ کے بیٹے اِتمارؔ کی زیرِ ہدایات جو خدمت اَنجام دینا ہے وہ یہی ہے۔“<verse eid="NUM 4:33"/></para>
  <para style="s1">لیویوں کے گھرانوں کی گِنتی</para>
  <para style="li1">
    <verse number="34" style="v" sid="NUM 4:34"/>چنانچہ مَوشہ اَور اَہرونؔ اَور جماعت کے سرداروں نے قُہاتیوں کو اُن کے گھرانوں اَور آبائی خاندانوں کے مُطابق شُمار کیا۔<verse eid="NUM 4:34"/></para>
  <para style="li2">
    <verse number="35" style="v" sid="NUM 4:35"/>تیس سے لے کر پچاس سال کی عمر کے سبھی مَردوں کو جو خیمہ اِجتماع کی خدمت میں ہاتھ بٹانے کے لیٔے آئےتھے <verse eid="NUM 4:35"/><verse number="36" style="v" sid="NUM 4:36"/>جنہیں اُن کے گھرانوں کے مُطابق شُمار کیا گیا اُن کی تعداد 2,750 تھی۔ <verse eid="NUM 4:36"/><verse number="37" style="v" sid="NUM 4:37"/>قُہاتی برادریوں کے جتنے لوگ خیمہ اِجتماع میں خدمت کرتے تھے اُن سَب کی تعداد یہی تھی جنہیں مَوشہ اَور اَہرونؔ نے یَاہوِہ کے مَوشہ کو دیئے ہویٔے حُکم کے مُطابق شُمار کیا۔<verse eid="NUM 4:37"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 4:38"/>بنی گیرشون کو اُن کے گھرانوں اَور آبائی خاندانوں کے مُطابق شُمار کیا گیا۔<verse eid="NUM 4:38"/></para>
  <para style="li2">
    <verse number="39" style="v" sid="NUM 4:39"/>تیس سے لے کر پچاس سال کی عمر تک کے سَب مَردوں کو جو خیمہ اِجتماع کی خدمت میں ہاتھ بٹانے کے لیٔے آئےتھے، <verse eid="NUM 4:39"/><verse number="40" style="v" sid="NUM 4:40"/>اُنہیں اُن کے گھرانوں اَور آبائی خاندانوں کے مُطابق گِنا گیا اَور اُن کی تعداد 2,630 تھی۔ <verse eid="NUM 4:40"/><verse number="41" style="v" sid="NUM 4:41"/>بنی گیرشون کے برادریوں کے جتنے لوگ خیمہ اِجتماع میں خدمت کرتے تھے اُن سَب کی تعداد اِتنی ہی تھی اَور یَاہوِہ کے حُکم کے مُطابق مَوشہ اَور اَہرونؔ نے اُنہیں شُمار کیا تھا۔<verse eid="NUM 4:41"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="42" style="v" sid="NUM 4:42"/>بنی مِراریؔ کو اُن کے گھرانوں اَور خاندانوں کے مُطابق شُمار کیا گیا۔<verse eid="NUM 4:42"/></para>
  <para style="li2">
    <verse number="43" style="v" sid="NUM 4:43"/>تیس سے لے کر پچاس سال کی عمر تک کے سبھی مَردوں کو جو خیمہ اِجتماع کی خدمت میں ہاتھ بٹانے کے لیٔے آئےتھے، <verse eid="NUM 4:43"/><verse number="44" style="v" sid="NUM 4:44"/>اُنہیں اُن کے گھرانوں کے مُطابق شُمار کیا گیا اَور اُن کی تعداد 3,200 تھی۔ <verse eid="NUM 4:44"/><verse number="45" style="v" sid="NUM 4:45"/>بنی مِراریؔ کے گھرانوں کے لوگوں کی کُل تعداد یہی تھی جنہیں مَوشہ اَور اَہرونؔ نے یَاہوِہ کے مَوشہ کی مَعرفت دئیے ہویٔے حُکم کے مُطابق شُمار کیا تھا۔<verse eid="NUM 4:45"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="46" style="v" sid="NUM 4:46"/>چنانچہ مَوشہ، اَہرونؔ اَور بنی اِسرائیل کے سرداروں نے سَب لیویوں کو اُن کے گھرانوں اَور خاندانوں کے مُطابق شُمار کیا۔ <verse eid="NUM 4:46"/><verse number="47" style="v" sid="NUM 4:47"/>اَور تیس سے لے کر پچاس سال کی عمر کے سبھی مَردوں کی تعداد جو خدمت کرنے اَور خیمہ اِجتماع کو اُٹھانے کا کام کرنے آئےتھے، <verse eid="NUM 4:47"/><verse number="48" style="v" sid="NUM 4:48"/>اُن کی تعداد 8,580 تھی۔ <verse eid="NUM 4:48"/><verse number="49" style="v" sid="NUM 4:49"/>یَاہوِہ کے حُکم کے مُطابق جو اُس نے مَوشہ کو دیا تھا ہر ایک کو اُس کا کام سونپا گیا اَور اُنہیں بتایا گیا کہ کون کیا کیا بوجھ اُٹھائے گا۔</para>
  <para style="b" vid="NUM 4:49"/>
  <para style="p" vid="NUM 4:49">چنانچہ اُسی حُکم کے مُطابق جو یَاہوِہ نے مَوشہ کو دیا تھا اُن کا شُمار کیا گیا۔<verse eid="NUM 4:49"/></para>
  <chapter eid="NUM 4"/>
  <chapter number="5" style="c" sid="NUM 5"/>
  <para style="s1">چھاؤنی کی پاکیزگی</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 5:1"/>یَاہوِہ نے مَوشہ سے فرمایا، <verse eid="NUM 5:1"/><verse number="2" style="v" sid="NUM 5:2"/>”بنی اِسرائیل کو حُکم دو کہ وہ ہر اُس شخص کو جسے جِلد کی کویٔی متعدّی بیماری ہو یا جریان کا مرض ہو یا جو کسی مُردہ کو چھُونے کے باعث ناپاک ہو چُکاہو، چھاؤنی سے خارج کر دیں۔ <verse eid="NUM 5:2"/><verse number="3" style="v" sid="NUM 5:3"/>خواہ وہ مَرد ہو یا عورت، اُنہیں چھاؤنی سے خارج کر دو تاکہ وہ اَپنی چھاؤنی کو ناپاک نہ کر دیں جہاں میں خُود اُن کے درمیان رہتا ہُوں۔“ <verse eid="NUM 5:3"/><verse number="4" style="v" sid="NUM 5:4"/>بنی اِسرائیل نے اَیسا ہی کیا۔ اُنہُوں نے اُنہیں چھاؤنی سے خارج کر دیا۔ اُنہُوں نے ٹھیک وَیسا ہی کیا جَیسا یَاہوِہ نے مَوشہ کو حُکم دیا تھا۔<verse eid="NUM 5:4"/></para>
  <para style="s1">خطا کا کفّارہ</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 5:5"/>یَاہوِہ نے مَوشہ سے فرمایا، <verse eid="NUM 5:5"/><verse number="6" style="v" sid="NUM 5:6"/>”بنی اِسرائیل سے کہو: ’اگر کویٔی مَرد یا عورت کسی شخص کے ساتھ کسی قِسم کی بدکاری کرے اَور اِس طرح سے یَاہوِہ سے دغا کرے تو وہ شخص مُجرم ٹھہرے گا، <verse eid="NUM 5:6"/><verse number="7" style="v" sid="NUM 5:7"/>اَور اُس نے جو گُناہ کیا ہو وہ اُس کا اقرار کرے اَور کفّارہ کے طور پر اَپنی خطا کے پُورے مُعاوضہ میں اُس کا پانچواں حِصّہ اَور مِلا کر اُس شخص کو دے جِس کا اُس نے قُصُور کیا ہے۔ <verse eid="NUM 5:7"/><verse number="8" style="v" sid="NUM 5:8"/>لیکن اگر اُس شخص کا کویٔی قریبی رشتہ دار نہ ہو جسے اُس خطا کا مُعاوضہ دیا جائے تو وہ مُعاوضہ یَاہوِہ کا ہوگا، لہٰذا اُسے اَور کفّارہ کے مینڈھے کو کاہِنؔ کے سُپرد کیا جائے۔ <verse eid="NUM 5:8"/><verse number="9" style="v" sid="NUM 5:9"/>بنی اِسرائیل جِتنی بھی مُقدّس نذریں کاہِنؔ کے پاس لائیں وہ سَب کاہِنؔ کی ہُوں گی۔ <verse eid="NUM 5:9"/><verse number="10" style="v" sid="NUM 5:10"/>ہر شخص کے مُقدّس نذرانے اُس کے اَپنے ہوں گے لیکن جو چیز وہ کاہِنؔ کو دے گا وہ کاہِنؔ کی ہوگی۔‘ “<verse eid="NUM 5:10"/></para>
  <para style="s1">بےوفا بیوی کی آزمائش</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 5:11"/>پھر یَاہوِہ نے مَوشہ سے فرمایا، <verse eid="NUM 5:11"/><verse number="12" style="v" sid="NUM 5:12"/>”بنی اِسرائیل سے مُخاطِب ہو اَور اُن سے کہو: ’اگر کسی آدمی کی بیوی گُمراہ ہوکر اُس سے دغا کرے اَور <verse eid="NUM 5:12"/><verse number="13" style="v" sid="NUM 5:13"/>کسی غَیر مَرد کے ساتھ ہم بِستر ہو، اَور یہ بات اُس کے خَاوند سے پوشیدہ رہے اَور اُس کی ناپاکی ظاہر بھی نہ ہونے پایٔے (کیونکہ اُس کے خِلاف کویٔی گواہ نہیں اَور نہ ہی وہ عَین فعل کے وقت پکڑی گئی ہے)، <verse eid="NUM 5:13"/><verse number="14" style="v" sid="NUM 5:14"/>اَور اُس کے خَاوند کے دِل میں بدگُمانی پیدا ہو جائے کہ اُس کی بیوی ناپاک ہو چُکی ہے یا وہ بدظن ہوکر اَپنی بیوی کی پاک دامنی پر شک کرنے لگے حالانکہ وہ ناپاک نہ ہُوئی ہو <verse eid="NUM 5:14"/><verse number="15" style="v" sid="NUM 5:15"/>تو وہ اَپنی بیوی کو کاہِنؔ کے سامنے حاضِر کرے، اَور اَپنے ساتھ ایفہ کا دسواں حِصّہ<note caller="+" style="f"><char style="fr" closed="false">5‏:15 </char><char style="fq" closed="false">دسواں حِصّہ </char><char style="ft" closed="false">تقریباً ایک کِلو چھ سَو گرام</char></note> جَو کا آٹا اُس کی طرف سے نذرانے کے طور پر لے جائے۔ لیکن اُس پر تیل نہ ڈالے، نہ ہی لوبان رکھے کیونکہ یہ اناج کی قُربانی غیرت کی ہے یعنی یادگاری نذر کی قُربانی ہے جو بدی کو یاد دِلانے کے لیٔے ہے۔<verse eid="NUM 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 5:16"/>” ’تَب کاہِنؔ اُسے نزدیک لایٔے اَور اُسے یَاہوِہ کے حُضُور کھڑا کرے۔ <verse eid="NUM 5:16"/><verse number="17" style="v" sid="NUM 5:17"/>اَور کاہِنؔ مٹّی کے برتن میں مُقدّس پانی لے اَور مَسکن کے فرش پر کی کچھ گَرد لے کر اُس پانی میں ڈال دے۔ <verse eid="NUM 5:17"/><verse number="18" style="v" sid="NUM 5:18"/>جَب کاہِنؔ اُس عورت کو یَاہوِہ کے حُضُور میں کھڑا کر چُکے تو وہ اُس کے بال کھول دے، اَور اُس کے ہاتھوں میں یادگار کی قُربانی تھما دے جو غیرت کی اناج کی قُربانی ہے اَور خُود اَپنے ہاتھ میں اُس لعنت لانے والے کڑوے پانی کے برتن کو تھامے رہے۔ <verse eid="NUM 5:18"/><verse number="19" style="v" sid="NUM 5:19"/>تَب کاہِنؔ عورت کو قَسم کھِلا کر اُس سے کہے، ”اگر کویٔی اَور آدمی تمہارے ساتھ ہم بِستر نہیں ہُواہے اَور تُو اَپنے خَاوند کی ہوتے ہویٔے گُمراہ ہوکر ناپاک نہیں ہُوئی تو یہ کڑوا پانی جو لعنت لاتا ہے تُمہیں ضرر نہ پہُنچائے <verse eid="NUM 5:19"/><verse number="20" style="v" sid="NUM 5:20"/>لیکن اگر تُو اَپنے خَاوند کی ہوتے ہویٔے گُمراہ ہو چُکی ہے اَور اگر تُونے اَپنے خَاوند کے علاوہ کسی اَور شخص کے ساتھ ہم بِستر ہوکر اَپنے آپ کو ناپاک کر دیا ہے۔“ <verse eid="NUM 5:20"/><verse number="21" style="v" sid="NUM 5:21"/>یہاں کاہِنؔ اُس عورت کو اُس لعنت کی قَسم دِلائے تو، ”یَاہوِہ تمہاری ران کو سُکھا کر اَور تمہارے پیٹ کو پھُلا کر تمہاری قوم کے لوگوں سے تُجھ پر لعنت اَور ملامت کرائے۔ <verse eid="NUM 5:21"/><verse number="22" style="v" sid="NUM 5:22"/>یہ پانی جو لعنت لاتا ہے تمہارے جِسم میں داخل ہو تاکہ تمہارا پیٹ پھُولے اَور تمہاری ران سڑائے۔“</para>
  <para style="p" vid="NUM 5:22">” ’تَب وہ عورت کہے، ”آمین! آمین۔“<verse eid="NUM 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 5:23"/>” ’تَب کاہِنؔ اُن لعنتوں کو ایک طُومار میں لِکھ کر اُنہیں اُس کڑوے پانی میں دھو ڈالے <verse eid="NUM 5:23"/><verse number="24" style="v" sid="NUM 5:24"/>اَور وہ کڑوا پانی جو لعنت لاتا ہے اُس عورت کو پلائے اَور یہ پانی اُس میں داخل ہوگا اَور شدید کڑواہٹ پیدا کرےگا۔ <verse eid="NUM 5:24"/><verse number="25" style="v" sid="NUM 5:25"/>پھر کاہِنؔ اُس کے ہاتھ میں سے غیرت کی اناج کی قُربانی کو لے کر اُسے یَاہوِہ کے حُضُور ہلائے اَور اُسے مذبح کے پاس لایٔے۔ <verse eid="NUM 5:25"/><verse number="26" style="v" sid="NUM 5:26"/>پھر کاہِنؔ اناج کی قُربانی میں سے یادگار کی قُربانی کے طور پر مُٹّھی بھر حِصّہ لے کر اُسے مذبح پر جَلائے۔ پھر وہ اُس عورت کو وہ پانی پلائے۔ <verse eid="NUM 5:26"/><verse number="27" style="v" sid="NUM 5:27"/>اگر وہ ناپاک ہو چُکی ہو اَور اَپنے خَاوند سے دغا کر چُکی ہو تو جَب اُسے وہ پانی جو لعنت لاتا ہے پِلایا جائے گا وہ اُس کے پیٹ میں جا کر نہایت شدید کڑواہٹ پیدا کرےگا۔ اُس کا پیٹ پھُول جائے گا اَور اُس کی ران سڑ جائے گی اَور وہ اَپنی قوم میں لعنتی ٹھہرے گی۔ <verse eid="NUM 5:27"/><verse number="28" style="v" sid="NUM 5:28"/>البتّہ اگر اُس عورت نے اَپنے آپ کو ناپاک نہ کیا ہو بَلکہ پاک رہی ہو تو وہ بےگُناہ ٹھہرے گی اَور اُس سے اَولاد ہو سکے گی۔<verse eid="NUM 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 5:29"/>” ’غیرت کے بارے میں، یہی آئین ہے خواہ کویٔی عورت اَپنے خَاوند کی ہوتے ہویٔے گُمراہ ہوکر اَپنے آپ کو ناپاک کر لے، <verse eid="NUM 5:29"/><verse number="30" style="v" sid="NUM 5:30"/>یا کسی آدمی کو اَپنی بیوی پر شک کرنے کی وجہ سے غیرت آئے تو کاہِنؔ اُسے یَاہوِہ کے حُضُور کھڑا کرے اَور اُس آئین پر پُوری طرح عَمل کیا جائے۔ <verse eid="NUM 5:30"/><verse number="31" style="v" sid="NUM 5:31"/>خَاوند تو کسی بھی بدی سے بَری ٹھہرے گا البتّہ اُس عورت کو اَپنے گُناہ کا نتیجہ بھگتنا ہوگا۔‘ “<verse eid="NUM 5:31"/></para>
  <chapter eid="NUM 5"/>
  <chapter number="6" style="c" sid="NUM 6"/>
  <para style="s1">نذیروں کے متعلّق ہدایات</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 6:1"/>یَاہوِہ نے مَوشہ سے فرمایا، <verse eid="NUM 6:1"/><verse number="2" style="v" sid="NUM 6:2"/>”بنی اِسرائیل سے مُخاطِب ہو اَور اُن سے کہو: ’اگر کویٔی مَرد یا عورت نذیر کی مَنّت یعنی اَپنے آپ کو یَاہوِہ کے لیٔے الگ رکھنے کی خاص مَنّت مانے، <verse eid="NUM 6:2"/><verse number="3" style="v" sid="NUM 6:3"/>تو وہ مَے اَور شراب سے دُور رہے اَور مَے یا شراب سے بنایا ہُوا سِرکہ نہ پیے۔ وہ انگور کا رس بھی نہ پیے اَور نہ تازہ انگور یا کشمش کھائے۔ <verse eid="NUM 6:3"/><verse number="4" style="v" sid="NUM 6:4"/>جَب تک کہ وہ نذیر رہے تَب تک جو کچھ انگور کی بیل سے پیدا ہوتاہے، اُس میں سے کچھ بھی نہ کھائے، بیج اَور چھِلکے بھی نہیں۔<verse eid="NUM 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 6:5"/>” ’اُس کی نذارت کی مَنّت کی ساری میعاد کے دَوران اُس کے سَر پر اُسترا نہ پھیرا جائے اَور اُس کی یَاہوِہ کے لیٔے الگ رہنے کی مُدّت پُوری ہونے تک وہ پاک رہے اَور اَپنے سَر کے بالوں کو بڑھنے دے۔<verse eid="NUM 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 6:6"/>” ’اَور یَاہوِہ اَپنی نذارت کی پُوری مُدّت تک وہ کسی لاش کے قریب نہ جائے۔ <verse eid="NUM 6:6"/><verse number="7" style="v" sid="NUM 6:7"/>خواہ اُس کا اَپنا باپ یا ماں یا بھایٔی یا بہن بھی مَر جائے تو بھی وہ اُن کو چھُو کر اَپنے آپ کو نجِس نہ کر لے کیونکہ اَپنے یَاہوِہ کے لیٔے الگ رہنے کی علامت اُس کے سَر پر ہے۔ <verse eid="NUM 6:7"/><verse number="8" style="v" sid="NUM 6:8"/>وہ اَپنی نذارت کی پُوری مُدّت تک یَاہوِہ کے لیٔے پاک ہے۔<verse eid="NUM 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 6:9"/>” ’اگر کویٔی اَچانک اُس کی مَوجُودگی میں مَر جائے جِس سے کہ اُس کے نذر کئے ہویٔے بال ناپاک ہو جایٔیں تو وہ اَپنے پاک ہونے کے دِن یعنی ساتویں دِن اَپنا سَر مُنڈائے۔ <verse eid="NUM 6:9"/><verse number="10" style="v" sid="NUM 6:10"/>اَور آٹھویں دِن وہ دو قُمریاں یا کبُوتر کے دو بچّے خیمہ اِجتماع کے دروازہ پر کاہِنؔ کے پاس لایٔے۔ <verse eid="NUM 6:10"/><verse number="11" style="v" sid="NUM 6:11"/>اَور کاہِنؔ ایک کو گُناہ کی قُربانی اَور دُوسرے کو سوختنی نذر کے طور پر گذرانے اَور اُس کی خاطِر کفّارہ دے کیونکہ وہ لاش کے پاس مَوجُود رہ کر ناپاک ہو گیا اَور اُسی دِن وہ اُس کے سَر کو پاک کرے۔ <verse eid="NUM 6:11"/><verse number="12" style="v" sid="NUM 6:12"/>وہ اَپنے الگ رہنے کی مُدّت تک اَپنے آپ کو یَاہوِہ کے لیٔے نذر کرے اَور ایک سال بھر کا نر برّہ خطا کی قُربانی کے لیٔے لایٔے۔ لیکن گزرے ہویٔے دِن گنے نہیں جایٔیں گے کیونکہ وہ اَپنی نذارت کے ایّام میں ناپاک ہو گیا تھا۔<verse eid="NUM 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 6:13"/>” ’پھر جَب اُس کی نذرات کی میعاد پُوری ہو جائے تو نذیر کے لیٔے آئین یہ ہے: اُسے خیمہ اِجتماع کے دروازہ پر حاضِر کیا جائے۔ <verse eid="NUM 6:13"/><verse number="14" style="v" sid="NUM 6:14"/>وہاں وہ یَاہوِہ کے لیٔے یہ قُربانیاں پیش کرے: سوختنی نذر کے لیٔے ایک بے عیب یک سالہ نر برّہ گُناہ کی قُربانی کے لیٔے ایک بے عیب یک سالہ مادہ برّہ اَور سلامتی کی نذر کے لیٔے ایک بے عیب مینڈھا۔ <verse eid="NUM 6:14"/><verse number="15" style="v" sid="NUM 6:15"/>اَور ساتھ ہی ساتھ اناج کی نذریں اَور تپاون کی نذروں اَور بے خمیری روٹیوں کی ایک ٹوکری بھی لایٔے جِس میں زَیتُون کا تیل ملے ہویٔے مَیدے کے کُلچے اَور تیل سے چُپڑی ہُوئی بے خمیری ٹکیاں ہُوں۔<verse eid="NUM 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 6:16"/>” ’کاہِنؔ اُنہیں یَاہوِہ کے حُضُور پیش کرے اَور اُنہیں گُناہ کی قُربانی اَور سوختنی نذر کے طور پر پیش کرے۔ <verse eid="NUM 6:16"/><verse number="17" style="v" sid="NUM 6:17"/>کاہِنؔ بے خمیری روٹیوں کی ٹوکری کے ساتھ اُس مینڈھے کو یَاہوِہ کے حُضُور سلامتی کی نذر کی قُربانی کے طور پر گذرانے اَور اُن کی اناج کی قُربانی اَور اُن کے تپاون بھی لایٔے۔<verse eid="NUM 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 6:18"/>” ’تَب خیمہ اِجتماع کے دروازہ پر نذیر اَپنے نذارت کے بال مُنڈوائے۔ پھر وہ اُن بالوں کو لے کر سلامتی کی نذر کی قُربانی کے نیچے والی آگ میں ڈال دے۔<verse eid="NUM 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 6:19"/>” ’جَب نذیر اَپنی نذارت کے بال مُنڈوا چُکے تَب کاہِنؔ مینڈھے کا اُبالا ہُوا شانہ اَور اُس ٹوکری میں کا ایک کُلچہ اَور ایک ٹکیا جو دونوں بے خمیر کے بنائے گیٔے ہُوں اُس کے ہاتھوں میں دے۔ <verse eid="NUM 6:19"/><verse number="20" style="v" sid="NUM 6:20"/>اَور کاہِنؔ اُنہیں ہلانے کی نذر کی قُربانی کے طور پر یَاہوِہ کے حُضُور ہلائے۔ وہ مُقدّس ہیں اَور ہلائے ہویٔے سینہ اَور پیش کی ہُوئی ران سمیت کاہِنؔ کے ہیں۔ اُس کے بعد نذیر مَے پی سَکتا ہے۔‘<verse eid="NUM 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 6:21"/>” ’نذیر اَپنی نذارت کے مُطابق یَاہوِہ کے لیٔے جِس چڑھاوے کی مَنّت مانے علاوہ اُس کے جِس کا اُسے مقدور ہو اُن سَب کے متعلّق یہی آئین ہے۔ اُس نے جو مَنّت مانی ہو اُسے نذارت کی آئین کے مُطابق پُورا کیا جائے۔‘ “<verse eid="NUM 6:21"/></para>
  <para style="s1">کاہِنؔ کی برکت</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 6:22"/>یَاہوِہ نے مَوشہ سے فرمایا، <verse eid="NUM 6:22"/><verse number="23" style="v" sid="NUM 6:23"/>”اَہرونؔ اَور اُس کے بیٹوں سے کہو، ’تُم بنی اِسرائیل کو اِس طرح برکت دو۔ تُم اُن سے کہو:<verse eid="NUM 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 6:24"/>” ’یَاہوِہ تُمہیں برکت دیں</para>
  <para style="q2" vid="NUM 6:24">اَور تُمہیں محفوظ رکھے؛<verse eid="NUM 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="NUM 6:25"/>یَاہوِہ اَپنا چہرہ تُجھ پر جلوہ گِر فرمائیں</para>
  <para style="q2" vid="NUM 6:25">اَور تُجھ پر مہربان ہُوں؛<verse eid="NUM 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="NUM 6:26"/>یَاہوِہ اَپنا چہرہ اُٹھائیں اَور تمہاری طرف متوجّہ ہُوں</para>
  <para style="q2" vid="NUM 6:26">اَور تُمہیں سلامتی بخشیں۔‘ “<verse eid="NUM 6:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 6:27"/>”اِس طرح وہ میرے نام کو بنی اِسرائیل پر رکھیں اَور مَیں اُنہیں برکت بخشوں گا۔“<verse eid="NUM 6:27"/></para>
  <chapter eid="NUM 6"/>
  <chapter number="7" style="c" sid="NUM 7"/>
  <para style="s1">مَسکن کے تقدیس کی قُربانیاں</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 7:1"/>جَب مَوشہ مَسکن کو کھڑا کر چُکا تو اُس نے اُسے مَسح کیا اَور اُسے اَور اُس کے سارے سازوسامان کو مُقدّس کیا۔ اُس نے مذبح اَور اُس کے تمام ظروف کو بھی مَسح اَور مُقدّس کیا۔ <verse eid="NUM 7:1"/><verse number="2" style="v" sid="NUM 7:2"/>تَب اِسرائیل کے سردار جو شُمار کئے ہوؤں کے اُوپر مُقرّر کئے ہویٔے اَپنے اَپنے خاندانوں کے سربراہ اَور قبیلوں کے نِگراں تھے نذرانے لے آئے۔ <verse eid="NUM 7:2"/><verse number="3" style="v" sid="NUM 7:3"/>اَور وہ اَپنے نذرانوں کے طور پر چھ ڈھکی ہُوئی گاڑیاں اَور بَارہ بَیل یَاہوِہ کے پاس لایٔے یعنی ہر سردار کی طرف سے ایک ایک بَیل اَور دو دو سرداروں کی طرف سے ایک ایک گاڑی۔ اُنہیں اُنہُوں نے مَسکن کے سامنے پیش کیا۔<verse eid="NUM 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 7:4"/>یَاہوِہ نے مَوشہ سے فرمایا، <verse eid="NUM 7:4"/><verse number="5" style="v" sid="NUM 7:5"/>”تُو اُنہیں قبُول کر تاکہ وہ خیمہ اِجتماع کے لیٔے اِستعمال ہُوں اَور تُو اُنہیں لیویوں میں ہر شخص کی خدمت کے مُطابق بانٹ دے۔“<verse eid="NUM 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 7:6"/>چنانچہ مَوشہ نے وہ گاڑیاں اَور بَیل لے کر لیویوں کو دے دئیے۔ <verse eid="NUM 7:6"/><verse number="7" style="v" sid="NUM 7:7"/>گیرشون کے گھرانوں کو اُس نے اُن کی خدمت کے مُطابق دو گاڑیاں اَور چار بَیل دئیے۔ <verse eid="NUM 7:7"/><verse number="8" style="v" sid="NUM 7:8"/>اَور بنی مِراریؔ کو اُن کی خدمت کے مُطابق چار گاڑیاں اَور آٹھ بَیل دئیے۔ یہ سَب اَہرونؔ کاہِنؔ کے بیٹے اِتمارؔ کی قیادت میں تھے۔ <verse eid="NUM 7:8"/><verse number="9" style="v" sid="NUM 7:9"/>لیکن مَوشہ نے بنی قُہات کو کچھ نہ دیا کیونکہ وہ مُقدّس چیزوں کو اَپنے کندھوں پر اُٹھانے کے ذمّہ دار تھے۔<verse eid="NUM 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 7:10"/>پھر جَب مذبح کا مَسح کیا گیا تَب سارے سردار اُس کی تقدیس کے لیٔے اَپنے اَپنے نذرانے لایٔے اَور اُنہیں مذبح کے سامنے پیش کیا۔ <verse eid="NUM 7:10"/><verse number="11" style="v" sid="NUM 7:11"/>کیونکہ یَاہوِہ نے مَوشہ سے کہاتھا، ”ہر روز ایک ہی سردار مذبح کی تقدیس کے لیٔے اَپنا نذرانہ لایٔے۔“<verse eid="NUM 7:11"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="12" style="v" sid="NUM 7:12"/>لہٰذا جو شخص پہلے دِن اَپنا ہدیہ لایا وہ یہُوداہؔ کے قبیلہ کا نحشونؔ بِن عَمّیندابؔ تھا۔<verse eid="NUM 7:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 7:13"/>اُس کا ہدیہ یہ تھا:</para>
  <para style="li2" vid="NUM 7:13">ایک سَو تیس ثاقل وزن<note caller="+" style="f"><char style="fr" closed="false">7‏:13 </char><char style="fq" closed="false">ایک سَو تیس ثاقل وزن </char><char style="ft" closed="false">تقریباً ایک کِلو پانچ سَو گرام</char></note> کا چاندی کا ایک طباق اَور ستّر ثاقل وزن کا چاندی<note caller="+" style="f"><char style="fr" closed="false">7‏:13 </char><char style="fq" closed="false">ستّر ثاقل وزن کا چاندی </char><char style="ft" closed="false">تقریباً آٹھ سو گرام</char></note> کا چھڑکنے کا ایک پیالہ۔ اِن دونوں کا وزن پاک مَقدِس کے ثاقل کے پیمانہ کے مُطابق تھا اَور ہر ایک میں اناج کی قُربانی کے لیٔے تیل مِلا ہُوا مَیدہ بھرا تھا؛<verse eid="NUM 7:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="NUM 7:14"/>دس ثاقل وزن کا سونے کا ایک ظرف جو لوبان سے بھرا ہُوا تھا؛<verse eid="NUM 7:14"/></para>
  <para style="li2">
    <verse number="15" style="v" sid="NUM 7:15"/>سوختنی نذر کے لیٔے ایک بچھڑا، ایک مینڈھا اَور ایک یک سالہ نر برّہ؛<verse eid="NUM 7:15"/></para>
  <para style="li2">
    <verse number="16" style="v" sid="NUM 7:16"/>گُناہ کی قُربانی کے لیٔے ایک بکرا؛<verse eid="NUM 7:16"/></para>
  <para style="li2">
    <verse number="17" style="v" sid="NUM 7:17"/>اَور سلامتی کی نذر کی قُربانی کے طور پر پیش کرنے کے لیٔے دو بَیل، پانچ نر مینڈھے، پانچ بکرے اَور پانچ یک سالہ نر برّے۔</para>
  <para style="lf" vid="NUM 7:17">یہ نحشونؔ بِن عَمّیندابؔ کا ہدیہ تھا۔<verse eid="NUM 7:17"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="18" style="v" sid="NUM 7:18"/>دُوسرے دِن یِسَّکاؔر کے قبیلہ کا سردار نتنی ایل بِن ضُعرؔ اَپنا ہدیہ لایا۔<verse eid="NUM 7:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="NUM 7:19"/>اَور اُس کا ہدیہ یہ تھا:</para>
  <para style="li2" vid="NUM 7:19">ایک سَو تیس ثاقل وزن کا چاندی کا ایک طباق اَور ستّر ثاقل وزن کا چاندی کا چھڑکنے کا ایک پیالہ۔ اِن دونوں کا وزن پاک مَقدِس کے ثاقل کے پیمانہ کے مُطابق تھا اَور ہر ایک میں اناج کی قُربانی کے لیٔے تیل مِلا ہُوا مَیدہ بھرا تھا؛<verse eid="NUM 7:19"/></para>
  <para style="li2">
    <verse number="20" style="v" sid="NUM 7:20"/>دس ثاقل وزن کا سونے کا ایک ظرف جو لوبان سے بھرا ہُوا تھا؛<verse eid="NUM 7:20"/></para>
  <para style="li2">
    <verse number="21" style="v" sid="NUM 7:21"/>سوختنی نذر کے لیٔے ایک بچھڑا، ایک مینڈھا اَور ایک یک سالہ نر برّہ؛<verse eid="NUM 7:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="NUM 7:22"/>گُناہ کی قُربانی کے لیٔے ایک بکرا؛<verse eid="NUM 7:22"/></para>
  <para style="li2">
    <verse number="23" style="v" sid="NUM 7:23"/>اَور سلامتی کی نذر کی قُربانی کے طور پر پیش کرنے کے لیٔے دو بَیل، پانچ نر مینڈھے، پانچ بکرے اَور پانچ یک سالہ نر برّے۔</para>
  <para style="lf" vid="NUM 7:23">یہ نتنی ایل بِن ضُعرؔ کا ہدیہ تھا۔<verse eid="NUM 7:23"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="24" style="v" sid="NUM 7:24"/>تیسرے دِن اِلیابؔ بِن حیلونؔ نے جو زبُولُون کے قبیلہ کا سردار تھا اَپنا ہدیہ گذرانا۔<verse eid="NUM 7:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="NUM 7:25"/>اُس کا ہدیہ یہ تھا:</para>
  <para style="li2" vid="NUM 7:25">ایک سَو تیس ثاقل وزن کا چاندی کا ایک طباق اَور ستّر ثاقل وزن کا چاندی کا چھڑکنے کا ایک پیالہ۔ اِن دونوں کا وزن پاک مَقدِس کے ثاقل کے پیمانہ کے مُطابق تھا اَور ہر ایک میں اناج کی قُربانی کے لیٔے تیل مِلا ہُوا مَیدہ بھرا تھا؛<verse eid="NUM 7:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="NUM 7:26"/>دس ثاقل وزن کا سونے کا ایک ظرف جو لوبان سے بھرا ہُوا تھا؛<verse eid="NUM 7:26"/></para>
  <para style="li2">
    <verse number="27" style="v" sid="NUM 7:27"/>سوختنی نذر کے لیٔے ایک بچھڑا، ایک مینڈھا، اَور ایک یک سالہ نر برّہ؛<verse eid="NUM 7:27"/></para>
  <para style="li2">
    <verse number="28" style="v" sid="NUM 7:28"/>گُناہ کی قُربانی کے لیٔے ایک بکرا؛<verse eid="NUM 7:28"/></para>
  <para style="li2">
    <verse number="29" style="v" sid="NUM 7:29"/>سلامتی کی نذر کی قُربانی کے طور پر پیش کرنے کے لیٔے دو بَیل، پانچ نر مینڈھے، پانچ بکرے اَور پانچ یک سالہ نر برّے۔</para>
  <para style="lf" vid="NUM 7:29">یہ اِلیابؔ بِن حیلونؔ کا ہدیہ تھا۔<verse eid="NUM 7:29"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="30" style="v" sid="NUM 7:30"/>چوتھے دِن رُوبِنؔ کے قبیلہ کے سردار اِلیضُورؔ بِن شدِیُورؔ نے اَپنا ہدیہ پیش کیا۔<verse eid="NUM 7:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="NUM 7:31"/>اُس کا ہدیہ یہ تھا:</para>
  <para style="li2" vid="NUM 7:31">ایک سَو تیس ثاقل وزن کا چاندی کا ایک طباق اَور ستّر ثاقل وزن کا چاندی کا چھڑکنے کا ایک پیالہ۔ اِن دونوں کا وزن پاک مَقدِس کے ثاقل کے پیمانہ کے مُطابق تھا اَور ہر ایک میں اناج کی قُربانی کے لیٔے تیل مِلا ہُوا مَیدہ بھرا تھا؛<verse eid="NUM 7:31"/></para>
  <para style="li2">
    <verse number="32" style="v" sid="NUM 7:32"/>دس ثاقل وزن کا سونے کا ایک ظرف جو لوبان سے بھرا ہُوا تھا؛<verse eid="NUM 7:32"/></para>
  <para style="li2">
    <verse number="33" style="v" sid="NUM 7:33"/>سوختنی نذر کے لیٔے ایک بچھڑا، ایک مینڈھا، اَور ایک یک سالہ نر برّہ؛<verse eid="NUM 7:33"/></para>
  <para style="li2">
    <verse number="34" style="v" sid="NUM 7:34"/>گُناہ کی قُربانی کے لیٔے ایک بکرا؛<verse eid="NUM 7:34"/></para>
  <para style="li2">
    <verse number="35" style="v" sid="NUM 7:35"/>اَور سلامتی کی نذر کی قُربانی کے طور پر پیش کرنے کے لیٔے دو بَیل، پانچ نر مینڈھے، پانچ بکرے اَور پانچ یک سالہ نر برّے۔</para>
  <para style="lf" vid="NUM 7:35">یہ اِلیضُورؔ بِن شدِیُورؔ کا ہدیہ تھا۔<verse eid="NUM 7:35"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="36" style="v" sid="NUM 7:36"/>پانچویں دِن شمعُونؔ کے قبیلہ کے سردار سلُومی ایل بِن ضُوریشدّؔی نے اَپنا ہدیہ پیش کیا۔<verse eid="NUM 7:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="NUM 7:37"/>اُس کا ہدیہ یہ تھا:</para>
  <para style="li2" vid="NUM 7:37">ایک سَو تیس ثاقل وزن کا چاندی کا ایک طباق اَور ستّر ثاقل وزن کا چاندی کا چھڑکنے کا ایک پیالہ۔ اِن دونوں کا وزن مَقدِس کے ثاقل کے پیمانہ کے مُطابق تھا اَور ہر ایک میں اناج کی قُربانی کے لیٔے تیل مِلا ہُوا مَیدہ بھرا تھا؛<verse eid="NUM 7:37"/></para>
  <para style="li2">
    <verse number="38" style="v" sid="NUM 7:38"/>دس ثاقل وزن کا سونے کا ایک ظرف جو لوبان سے بھرا ہُوا تھا؛<verse eid="NUM 7:38"/></para>
  <para style="li2">
    <verse number="39" style="v" sid="NUM 7:39"/>سوختنی نذر کے لیٔے ایک بچھڑا، ایک مینڈھا، اَور ایک یک سالہ نر برّہ؛<verse eid="NUM 7:39"/></para>
  <para style="li2">
    <verse number="40" style="v" sid="NUM 7:40"/>گُناہ کی قُربانی کے لیٔے ایک بکرا؛<verse eid="NUM 7:40"/></para>
  <para style="li2">
    <verse number="41" style="v" sid="NUM 7:41"/>اَور سلامتی کی نذر کی قُربانی کے طور پر گذراننے کے لیٔے دو بَیل، پانچ نر مینڈھے، پانچ بکرے اَور پانچ یک سالہ نر برّے۔</para>
  <para style="lf" vid="NUM 7:41">یہ سلُومی ایل بِن ضُوریشدّؔی کا ہدیہ تھا۔<verse eid="NUM 7:41"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="42" style="v" sid="NUM 7:42"/>چھٹے دِن اِلیاسفؔ بِن دعُوایلؔ نے اَپنا ہدیہ پیش کیا جو گادؔ کے قبیلہ کا سردار تھا۔<verse eid="NUM 7:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="NUM 7:43"/>اُس کا ہدیہ یہ تھا:</para>
  <para style="li2" vid="NUM 7:43">ایک سَو تیس ثاقل وزن کا چاندی کا ایک طباق اَور ستّر ثاقل وزن کا چاندی کا چھڑکنے کا ایک پیالہ۔ اِن دونوں کا وزن پاک مَقدِس کے ثاقل کے پیمانہ کے مُطابق تھا اَور ہر ایک میں اناج کی قُربانی کے لیٔے تیل مِلا ہُوا مَیدہ بھرا تھا؛<verse eid="NUM 7:43"/></para>
  <para style="li2">
    <verse number="44" style="v" sid="NUM 7:44"/>دس ثاقل وزن کا سونے کا ایک ظرف جو لوبان سے بھرا ہُوا تھا؛<verse eid="NUM 7:44"/></para>
  <para style="li2">
    <verse number="45" style="v" sid="NUM 7:45"/>سوختنی نذر کے لیٔے ایک بچھڑا، ایک مینڈھا، اَور ایک یک سالہ نر برّہ؛<verse eid="NUM 7:45"/></para>
  <para style="li2">
    <verse number="46" style="v" sid="NUM 7:46"/>گُناہ کی قُربانی کے لیٔے ایک بکرا؛<verse eid="NUM 7:46"/></para>
  <para style="li2">
    <verse number="47" style="v" sid="NUM 7:47"/>اَور سلامتی کی نذر کی قُربانی کے طور پر پیش کرنے کے لیٔے دو بَیل، پانچ نر مینڈھے، پانچ بکرے اَور پانچ یک سالہ نر برّے۔</para>
  <para style="lf" vid="NUM 7:47">یہ اِلیاسفؔ بِن دعُوایلؔ کا ہدیہ تھا۔<verse eid="NUM 7:47"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="48" style="v" sid="NUM 7:48"/>ساتویں دِن اِلیشمعؔ بِن عمّیہُوؔد نے اَپنا ہدیہ پیش کیا جو اِفرائیمؔ کے قبیلہ کا سردار تھا۔<verse eid="NUM 7:48"/></para>
  <para style="li1">
    <verse number="49" style="v" sid="NUM 7:49"/>اُس کا ہدیہ یہ تھا:</para>
  <para style="li2" vid="NUM 7:49">ایک سَو تیس ثاقل وزن کا چاندی کا ایک طباق اَور ستّر ثاقل وزن کا چاندی کا چھڑکنے کا ایک پیالہ۔ اِن دونوں کا وزن پاک مَقدِس کے ثاقل کے پیمانہ کے مُطابق تھا اَور ہر ایک میں اناج کی قُربانی کے لیٔے تیل مِلا ہُوا مَیدہ بھرا تھا؛<verse eid="NUM 7:49"/></para>
  <para style="li2">
    <verse number="50" style="v" sid="NUM 7:50"/>دس ثاقل وزن کا سونے کا ایک ظرف جو لوبان سے بھرا ہُوا تھا؛<verse eid="NUM 7:50"/></para>
  <para style="li2">
    <verse number="51" style="v" sid="NUM 7:51"/>سوختنی نذر کے لیٔے ایک بچھڑا، ایک مینڈھا، اَور ایک یک سالہ نر برّہ؛<verse eid="NUM 7:51"/></para>
  <para style="li2">
    <verse number="52" style="v" sid="NUM 7:52"/>گُناہ کی قُربانی کے لیٔے ایک بکرا؛<verse eid="NUM 7:52"/></para>
  <para style="li2">
    <verse number="53" style="v" sid="NUM 7:53"/>اَور سلامتی کی نذر کی قُربانی کے طور پر گذراننے کے لیٔے دو بَیل، پانچ نر مینڈھے، پانچ بکرے اَور پانچ یک سالہ نر برّے۔</para>
  <para style="lf" vid="NUM 7:53">یہ اِلیشمعؔ بِن عمّیہُوؔد کا ہدیہ تھا۔<verse eid="NUM 7:53"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="54" style="v" sid="NUM 7:54"/>آٹھویں دِن گَملی ایل بِن پِداہضُورؔ نے اَپنا ہدیہ پیش کیا جو منشّہ کے قبیلہ کا سردار تھا۔<verse eid="NUM 7:54"/></para>
  <para style="li1">
    <verse number="55" style="v" sid="NUM 7:55"/>اُس کا ہدیہ یہ تھا:</para>
  <para style="li2" vid="NUM 7:55">ایک سَو تیس ثاقل وزن کا چاندی کا ایک طباق اَور ستّر ثاقل وزن کا چاندی کا چھڑکنے کا ایک پیالہ۔ اِن دونوں کا وزن پاک مَقدِس کے ثاقل کے پیمانہ کے مُطابق تھا اَور ہر ایک میں اناج کی قُربانی کے لیٔے تیل مِلا ہُوا مَیدہ بھرا تھا؛<verse eid="NUM 7:55"/></para>
  <para style="li2">
    <verse number="56" style="v" sid="NUM 7:56"/>دس ثاقل وزن کا سونے کا ایک ظرف جو لوبان سے بھرا ہُوا تھا؛<verse eid="NUM 7:56"/></para>
  <para style="li2">
    <verse number="57" style="v" sid="NUM 7:57"/>سوختنی نذر کے لیٔے ایک بچھڑا، ایک مینڈھا، اَور ایک یک سالہ نر برّہ؛<verse eid="NUM 7:57"/></para>
  <para style="li2">
    <verse number="58" style="v" sid="NUM 7:58"/>گُناہ کی قُربانی کے لیٔے ایک بکرا؛<verse eid="NUM 7:58"/></para>
  <para style="li2">
    <verse number="59" style="v" sid="NUM 7:59"/>اَور سلامتی کی نذر کی قُربانی کے طور پر پیش کرنے کے لیٔے دو بَیل، پانچ نر مینڈھے، پانچ بکرے اَور پانچ یک سالہ نر برّے۔</para>
  <para style="lf" vid="NUM 7:59">یہ گَملی ایل بِن پِداہضُورؔ کا ہدیہ تھا۔<verse eid="NUM 7:59"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="60" style="v" sid="NUM 7:60"/>نویں دِن بِنیامین کے قبیلہ کے سردار ابیدانؔ بِن گِدعونیؔ نے اَپنا ہدیہ پیش کیا۔<verse eid="NUM 7:60"/></para>
  <para style="li1">
    <verse number="61" style="v" sid="NUM 7:61"/>اُس کا ہدیہ یہ تھا:</para>
  <para style="li2" vid="NUM 7:61">ایک سَو تیس ثاقل وزن کا چاندی کا ایک طباق اَور ستّر ثاقل وزن کا چاندی کا چھڑکنے کا ایک پیالہ۔ اِن دونوں کا وزن پاک مَقدِس کے ثاقل کے پیمانہ کے مُطابق تھا اَور ہر ایک میں اناج کی قُربانی کے لیٔے تیل مِلا ہُوا مَیدہ بھرا تھا؛<verse eid="NUM 7:61"/></para>
  <para style="li2">
    <verse number="62" style="v" sid="NUM 7:62"/>دس ثاقل وزن کا سونے کا ایک ظرف جو لوبان سے بھرا ہُوا تھا؛<verse eid="NUM 7:62"/></para>
  <para style="li2">
    <verse number="63" style="v" sid="NUM 7:63"/>سوختنی نذر کے لیٔے ایک بچھڑا، ایک مینڈھا، اَور ایک یک سالہ نر برّہ؛<verse eid="NUM 7:63"/></para>
  <para style="li2">
    <verse number="64" style="v" sid="NUM 7:64"/>گُناہ کی قُربانی کے لیٔے ایک بکرا؛<verse eid="NUM 7:64"/></para>
  <para style="li2">
    <verse number="65" style="v" sid="NUM 7:65"/>اَور سلامتی کی نذر کی قُربانی کے طور پر پیش کرنے کے لیٔے دو بَیل، پانچ نر مینڈھے، پانچ بکرے اَور پانچ یک سالہ نر برّے۔</para>
  <para style="lf" vid="NUM 7:65">یہ ابیدانؔ بِن گِدعونیؔ کا ہدیہ تھا۔<verse eid="NUM 7:65"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="66" style="v" sid="NUM 7:66"/>دسویں دِن دانؔ کے قبیلہ کا سردار احیعزر بِن عمّی شدّؔی اَپنا ہدیہ لایا۔<verse eid="NUM 7:66"/></para>
  <para style="li1">
    <verse number="67" style="v" sid="NUM 7:67"/>اُس کا ہدیہ یہ تھا:</para>
  <para style="li2" vid="NUM 7:67">ایک سَو تیس ثاقل وزن کا چاندی کا ایک طباق اَور ستّر ثاقل وزن کا چاندی کا چھڑکنے کا ایک پیالہ۔ اِن دونوں کا وزن پاک مَقدِس کے ثاقل کے پیمانہ کے مُطابق تھا اَور ہر ایک میں اناج کی قُربانی کے لیٔے تیل مِلا ہُوا مَیدہ بھرا تھا؛<verse eid="NUM 7:67"/></para>
  <para style="li2">
    <verse number="68" style="v" sid="NUM 7:68"/>دس ثاقل وزن کا سونے کا ایک ظرف جو لوبان سے بھرا ہُوا تھا؛<verse eid="NUM 7:68"/></para>
  <para style="li2">
    <verse number="69" style="v" sid="NUM 7:69"/>سوختنی نذر کے لیٔے ایک بچھڑا، ایک مینڈھا، اَور ایک یک سالہ نر برّہ؛<verse eid="NUM 7:69"/></para>
  <para style="li2">
    <verse number="70" style="v" sid="NUM 7:70"/>گُناہ کی قُربانی کے لیٔے ایک بکرا؛<verse eid="NUM 7:70"/></para>
  <para style="li2">
    <verse number="71" style="v" sid="NUM 7:71"/>اَور سلامتی کی نذر کی قُربانی کے طور پر گذراننے کے لیٔے دو بَیل، پانچ نر مینڈھے، پانچ بکرے اَور پانچ یک سالہ نر برّے۔</para>
  <para style="lf" vid="NUM 7:71">یہ احیعزر بِن عمّی شدّؔی کا ہدیہ تھا۔<verse eid="NUM 7:71"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="72" style="v" sid="NUM 7:72"/>گیارھویں دِن آشیر کے قبیلہ کا سردار پگعِیلؔ بِن عُکرانؔ اَپنا ہدیہ لایا۔<verse eid="NUM 7:72"/></para>
  <para style="li1">
    <verse number="73" style="v" sid="NUM 7:73"/>اُس کا ہدیہ یہ تھا:</para>
  <para style="li2" vid="NUM 7:73">ایک سَو تیس ثاقل وزن کا چاندی کا ایک طباق اَور ستّر ثاقل وزن کا چاندی کا چھڑکنے کا ایک پیالہ۔ اِن دونوں کا وزن پاک مَقدِس کے ثاقل کے پیمانہ کے مُطابق تھا اَور ہر ایک میں اناج کی قُربانی کے لیٔے تیل مِلا ہُوا مَیدہ بھرا تھا؛<verse eid="NUM 7:73"/></para>
  <para style="li2">
    <verse number="74" style="v" sid="NUM 7:74"/>دس ثاقل وزن کا سونے کا ایک ظرف جو لوبان سے بھرا ہُوا تھا؛<verse eid="NUM 7:74"/></para>
  <para style="li2">
    <verse number="75" style="v" sid="NUM 7:75"/>سوختنی نذر کے لیٔے ایک بچھڑا، ایک مینڈھا، اَور ایک یک سالہ نر برّہ؛<verse eid="NUM 7:75"/></para>
  <para style="li2">
    <verse number="76" style="v" sid="NUM 7:76"/>گُناہ کی قُربانی کے لیٔے ایک بکرا؛<verse eid="NUM 7:76"/></para>
  <para style="li2">
    <verse number="77" style="v" sid="NUM 7:77"/>اَور سلامتی کی نذر کی قُربانی کے طور پر پیش کرنے کے لیٔے دو بَیل، پانچ نر مینڈھے، پانچ بکرے اَور پانچ یک سالہ نر برّے۔</para>
  <para style="lf" vid="NUM 7:77">یہ عُکرانؔ کے بیٹے پگعِیلؔ کا ہدیہ تھا۔<verse eid="NUM 7:77"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="78" style="v" sid="NUM 7:78"/>بارہویں دِن اَخیرعؔ بِن عینانؔ نے جو نفتالی کے قبیلہ کا سردار تھا اَپنا ہدیہ پیش کیا۔<verse eid="NUM 7:78"/></para>
  <para style="li1">
    <verse number="79" style="v" sid="NUM 7:79"/>اُس کا ہدیہ یہ تھا:</para>
  <para style="li2" vid="NUM 7:79">ایک سَو تیس ثاقل وزن کا چاندی کا ایک طباق اَور ستّر ثاقل وزن کا چاندی کا چھڑکنے کا ایک پیالہ۔ اِن دونوں کا وزن پاک مَقدِس کے ثاقل کے پیمانہ کے مُطابق تھا اَور ہر ایک میں اناج کی قُربانی کے لیٔے تیل مِلا ہُوا مَیدہ بھرا تھا؛<verse eid="NUM 7:79"/></para>
  <para style="li2">
    <verse number="80" style="v" sid="NUM 7:80"/>دس ثاقل وزن کا سونے کا ایک ظرف جو لوبان سے بھرا ہُوا تھا؛<verse eid="NUM 7:80"/></para>
  <para style="li2">
    <verse number="81" style="v" sid="NUM 7:81"/>سوختنی نذر کے لیٔے ایک بچھڑا، ایک مینڈھا، اَور ایک یک سالہ نر برّہ؛<verse eid="NUM 7:81"/></para>
  <para style="li2">
    <verse number="82" style="v" sid="NUM 7:82"/>گُناہ کی قُربانی کے لیٔے ایک بکرا؛<verse eid="NUM 7:82"/></para>
  <para style="li2">
    <verse number="83" style="v" sid="NUM 7:83"/>اَور سلامتی کی نذر کی قُربانی کے طور پر پیش کرنے کے لیٔے دو بَیل، پانچ نر مینڈھے، پانچ بکرے اَور پانچ یک سالہ نر برّے۔</para>
  <para style="lf" vid="NUM 7:83">یہ عینانؔ کے بیٹے اَخیرعؔ کا ہدیہ تھا۔<verse eid="NUM 7:83"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="84" style="v" sid="NUM 7:84"/>مذبح کے ممسوح ہونے کے وقت اُس کی تقدیس کے لیٔے بنی اِسرائیل کے سرداروں کے لایٔے ہویٔے عطیات یہی تھے۔</para>
  <para style="li2" vid="NUM 7:84">یعنی چاندی کے بَارہ طباق، چاندی کے چھڑکنے کے بَارہ پیالے اَور سونے کے بَارہ ظروف۔ <verse eid="NUM 7:84"/><verse number="85" style="v" sid="NUM 7:85"/>ہر چاندی کے طباق کا وزن ایک سَو تیس ثاقل تھا اَور ہر چھڑکنے کا پیالہ ستّر ثاقل کا تھا۔ مجموعی طور پر اُن چاندی کے ظروف کا وزن پاک مَقدِس کے ثاقل کے پیمانہ کے مُطابق دو ہزار چار سَو ثاقل<note caller="+" style="f"><char style="fr" closed="false">7‏:85 </char><char style="fq" closed="false">دو ہزار چار سَو ثاقل</char><char style="ft" closed="false">تقریباً اٹّھائیس کِلوگرام</char></note> تھا۔ <verse eid="NUM 7:85"/><verse number="86" style="v" sid="NUM 7:86"/>لوبان سے بھرے ہویٔے سونے کے بَارہ ظروف پاک مَقدِس کے ثاقل کے پیمانہ کے مُطابق دس دس ثاقل کے تھے۔ مجموعی طور پر اُن سونے کے ظروف کا وزن ایک سَو بیس ثاقل<note caller="+" style="f"><char style="fr" closed="false">7‏:86 </char><char style="fq" closed="false">ایک سَو بیس ثاقل </char><char style="ft" closed="false">تقریباً ایک کِلو چار سَو گرام</char></note> تھا۔<verse eid="NUM 7:86"/></para>
  <para style="li2">
    <verse number="87" style="v" sid="NUM 7:87"/>سوختنی نذر کے لیٔے لایٔے ہویٔے جانوروں کی مجموعی تعداد اَپنی اَپنی اناج کی قُربانیوں سمیت یہ تھی: بَارہ بچھڑے، بَارہ مینڈھے، بَارہ یک سالہ نر برّے اَور گُناہ کی قُربانی کے لیٔے بَارہ بکرے اِستعمال کئے گیٔے۔<verse eid="NUM 7:87"/></para>
  <para style="li2">
    <verse number="88" style="v" sid="NUM 7:88"/>سلامتی کی نذر کی قُربانی کے طور پر پیش کرنے کے لیٔے جانوروں کی کُل تعداد یہ تھی: چوبیس بَیل، ساٹھ مینڈھے، ساٹھ بکرے، اَور ساٹھ یک سالہ نر برّے۔</para>
  <para style="b" vid="NUM 7:88"/>
  <para style="lf" vid="NUM 7:88">مذبح کے ممسوح ہونے کے بعد اُس کی تقدیس کے لیٔے یہ عطیات پیش کیٔے گیٔے۔<verse eid="NUM 7:88"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="89" style="v" sid="NUM 7:89"/>جَب مَوشہ یَاہوِہ سے باتیں کرنے کے لیٔے خیمہ اِجتماع میں داخل ہُوا تو اُس نے کفّارہ کے سرپوش پر سے جو عہد کے صندُوق کے اُوپر رکھا ہُوا تھا دونوں کروبیوں کے درمیان سے وہ آواز سُنی جو اُس سے مُخاطِب تھی اَور یَاہوِہ نے مَوشہ کے ساتھ باتیں کیں۔<verse eid="NUM 7:89"/></para>
  <chapter eid="NUM 7"/>
  <chapter number="8" style="c" sid="NUM 8"/>
  <para style="s1">چراغوں کو رَوشن کرنے کا طریقہ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 8:1"/>یَاہوِہ نے مَوشہ سے فرمایا، <verse eid="NUM 8:1"/><verse number="2" style="v" sid="NUM 8:2"/>”اَہرونؔ سے مُخاطِب ہو اَور اُس سے کہہ، ’جَب تُو سات چراغوں کو رَوشن کرے تو دیکھنا کہ اُن سے چراغدان کے سامنے کا احاطہ رَوشن ہو۔‘ “<verse eid="NUM 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 8:3"/>چنانچہ اَہرونؔ نے اَیسا ہی کیا۔ اُس نے چراغوں کو اِس طرح جما دیا کہ اُن کے رُخ چراغدان کے سامنے کی طرف تھے جَیسا کہ یَاہوِہ نے مَوشہ کو حُکم دیا تھا۔ <verse eid="NUM 8:3"/><verse number="4" style="v" sid="NUM 8:4"/>اَور چراغدان کی ساخت یُوں تھی: وہ اَپنے پیندے سے لے کر پھُولوں تک گڑھے ہویٔے سونے کا بنا تھا اَور چراغدان ٹھیک اُسی نمونہ کا بنا تھا جَیسا یَاہوِہ نے مَوشہ کو بتایا تھا۔<verse eid="NUM 8:4"/></para>
  <para style="s1">لیویوں کا الگ کیاجانا</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 8:5"/>یَاہوِہ نے مَوشہ سے فرمایا، <verse eid="NUM 8:5"/><verse number="6" style="v" sid="NUM 8:6"/>”لیویوں کو دُوسرے تمام بنی اِسرائیل سے الگ کرکے اُنہیں رسماً پاک کر۔ <verse eid="NUM 8:6"/><verse number="7" style="v" sid="NUM 8:7"/>اُنہیں پاک کرنے کے لیٔے تُم یُوں کرنا: اُن پر پاک کرنے کا پانی چھڑک، پھر وہ اَپنے سارے جِسم پر اُسترا پھروائیں اَور اَپنے کپڑے دھوئیں اَور اِس طرح اَپنے آپ کو پاک کر لیں۔ <verse eid="NUM 8:7"/><verse number="8" style="v" sid="NUM 8:8"/>تَب وہ ایک بچھڑا اَور اُس کے ساتھ کی اناج کی قُربانی کے لیٔے تیل مِلا ہُوا مَیدہ لیں اَور تُو گُناہ کی قُربانی کے لیٔے ایک دُوسرا بچھڑا لینا۔ <verse eid="NUM 8:8"/><verse number="9" style="v" sid="NUM 8:9"/>تَب لیویوں کو خیمہ اِجتماع کے سامنے حاضِر کرنا اَور بنی اِسرائیل کی ساری جماعت کو جمع کرنا۔ <verse eid="NUM 8:9"/><verse number="10" style="v" sid="NUM 8:10"/>تُم لیویوں کو یَاہوِہ کے حُضُور لانا، تَب بنی اِسرائیل اُن پر اَپنے ہاتھ رکھیں <verse eid="NUM 8:10"/><verse number="11" style="v" sid="NUM 8:11"/>اَور اَہرونؔ لیویوں کو یَاہوِہ کے حُضُور بنی اِسرائیل کی طرف سے ہلانے کی نذر کی قُربانی کے طور پر پیش کرے تاکہ وہ یَاہوِہ کی خدمت کرنے کے لیٔے تیّار ہُوں۔<verse eid="NUM 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 8:12"/>”جَب لیوی اَپنے اَپنے ہاتھ بچھڑوں کے سَروں پر رکھ چکیں، تَب تُم ایک کو یَاہوِہ کے لیٔے گُناہ کی قُربانی کے طور پر اَور دُوسرے کو سوختنی نذر کے طور پر پیش کرنا تاکہ لیویوں کا کفّارہ دیا جائے۔ <verse eid="NUM 8:12"/><verse number="13" style="v" sid="NUM 8:13"/>پھر تُم لیویوں کو اَہرونؔ اَور اُس کے بیٹوں کے آگے کھڑا کرنا اَور تَب اُن کو یَاہوِہ کے رُوبرو ہلانے کی نذر کی قُربانی کے طور پر پیش کرنا۔ <verse eid="NUM 8:13"/><verse number="14" style="v" sid="NUM 8:14"/>اِس طرح سے تُم لیویوں کو دُوسرے بنی اِسرائیل سے الگ کرنا اَور لیوی میرے ہوں گے۔<verse eid="NUM 8:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 8:15"/>”جَب تُم لیویوں کو پاک کر چُکو اَور ہلانے کی نذر کی قُربانی کے طور پر پیش کر چُکو تَب وہ خیمہ اِجتماع میں اَپنی خدمت بجا لانے کے لیٔے آئیں۔ <verse eid="NUM 8:15"/><verse number="16" style="v" sid="NUM 8:16"/>یہ وہ بنی اِسرائیل ہیں جو مُکمّل طور پر مُجھے سونپے جایٔیں۔ مَیں نے اُنہیں پہلوٹھے کے یعنی ہر اِسرائیلی عورت کے پہلے بیٹے کے عِوض اَپنا لیا ہے۔ <verse eid="NUM 8:16"/><verse number="17" style="v" sid="NUM 8:17"/>بنی اِسرائیل کا ہر پہلوٹھا خواہ اِنسان کا ہو یا حَیوان کا میرا ہے۔ جَب مَیں نے مُلک مِصر میں سَب پہلوٹھوں کو مار ڈالا تھا، اُسی وقت مَیں نے اُنہیں اَپنے لیٔے مخصُوص کر لیا تھا۔ <verse eid="NUM 8:17"/><verse number="18" style="v" sid="NUM 8:18"/>اَور مَیں نے بنی اِسرائیل کے سَب پہلوٹھوں کے عِوض لیویوں کو لے لیا ہے۔ <verse eid="NUM 8:18"/><verse number="19" style="v" sid="NUM 8:19"/>تمام بنی اِسرائیل میں سے مَیں نے لیویوں کو اَہرونؔ اَور اُس کے بیٹوں کو بنی اِسرائیل کی جانِب سے اِس لیٔے عطا کیا ہے کہ وہ خیمہ اِجتماع میں بنی اِسرائیل میں خدمت کریں اَور اُن کے لیٔے کفّارہ دیں تاکہ جَب بنی اِسرائیل پاک مَقدِس کے قریب جایٔیں تو اُن پر کویٔی وَبا نازل نہ ہو۔“<verse eid="NUM 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 8:20"/>چنانچہ مَوشہ، اَہرونؔ اَور بنی اِسرائیل کی ساری جماعت نے لیویوں کے ساتھ ٹھیک وَیسا ہی کیا جَیسا یَاہوِہ نے مَوشہ کو حُکم دیا تھا۔ <verse eid="NUM 8:20"/><verse number="21" style="v" sid="NUM 8:21"/>لیویوں نے اَپنے آپ کو پاک کیا اَور اَپنے کپڑے دھو ڈالے۔ تَب اَہرونؔ نے اُنہیں یَاہوِہ کے رُوبرو ہلانے کی نذر کی قُربانی کے طور پر پیش کیا اَور اُنہیں پاک کرنے کے لیٔے اُن کی خاطِر کفّارہ دیا۔ <verse eid="NUM 8:21"/><verse number="22" style="v" sid="NUM 8:22"/>اُس کے بعد لیوی اَہرونؔ اَور اُس کے بیٹوں کی قیادت میں خیمہ اِجتماع میں اَپنی خدمت بجا لانے کے لیٔے چلے آئے۔ اُنہُوں نے لیویوں کے ساتھ ٹھیک وَیسا ہی کیا جَیسا یَاہوِہ نے مَوشہ کو حُکم دیا تھا۔<verse eid="NUM 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 8:23"/>پھر یَاہوِہ نے مَوشہ سے فرمایا، <verse eid="NUM 8:23"/><verse number="24" style="v" sid="NUM 8:24"/>”لیویوں پر لازِم ہوگا: پچّیس سال یا اُس سے زِیادہ عمر کے مَرد خیمہ اِجتماع میں خدمت کرنے آیا کریں۔ <verse eid="NUM 8:24"/><verse number="25" style="v" sid="NUM 8:25"/>لیکن پچاس سال کی عمر ہونے پر وہ اَپنی روزمرّہ کی خدمت سے مستعفی ہُوں اَور پھر کام نہ کریں۔ <verse eid="NUM 8:25"/><verse number="26" style="v" sid="NUM 8:26"/>وہ اگر چاہیں تو خیمہ اِجتماع کی خدمت میں اَپنے بھائیوں کا ہاتھ بٹائیں لیکن بذاتِ خُود کویٔی کام نہ کریں۔ تُم لیویوں کو اِسی قِسم کی ذمّہ داریاں سونپنا۔“<verse eid="NUM 8:26"/></para>
  <chapter eid="NUM 8"/>
  <chapter number="9" style="c" sid="NUM 9"/>
  <para style="s1">عیدِفسح</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 9:1"/>اُن کے مُلک مِصر سے نکل آنے کے دُوسرے سال کے پہلے مہینے میں یَاہوِہ سِینؔائی کے بیابان میں مَوشہ سے مُخاطِب ہُوا۔ اُنہُوں نے کہا، <verse eid="NUM 9:1"/><verse number="2" style="v" sid="NUM 9:2"/>”بنی اِسرائیل مُقرّرہ وقت پر عیدِفسح منائیں۔ <verse eid="NUM 9:2"/><verse number="3" style="v" sid="NUM 9:3"/>اِسی ماہ کی چودھویں تاریخ کی شام کے وقت تُم اُسے مُقرّرہ وقت پر اُس ضوابط کے مُطابق منانا۔“<verse eid="NUM 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 9:4"/>چنانچہ مَوشہ نے بنی اِسرائیل کو عیدِفسح منانے کے لیٔے کہا، <verse eid="NUM 9:4"/><verse number="5" style="v" sid="NUM 9:5"/>اَور اُنہُوں نے پہلے مہینے کی چودھویں تاریخ کی شام کو سِینؔائی کے بیابان میں عیدِفسح منایا اَور بنی اِسرائیل نے وَیسا ہی کیا جَیسا یَاہوِہ نے مَوشہ کو حُکم دیا تھا۔<verse eid="NUM 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 9:6"/>لیکن کچھ لوگ اُس روز عیدِفسح نہ منا سکے کیونکہ اُن میں سے کچھ لوگ اَیسے بھی تھے جو کسی لاش کو چھُونے کے سبب سے ناپاک ہو گئے تھے۔ چنانچہ وہ اُسی دِن مَوشہ اَور اَہرونؔ کے پاس آئے <verse eid="NUM 9:6"/><verse number="7" style="v" sid="NUM 9:7"/>اَور مَوشہ سے کہنے لگے، ”ہم تو کسی لاش کو چھُونے کے سبب سے ناپاک ہو چُکے ہیں پھر ہم لوگ دُوسرے اِسرائیلیوں کے ساتھ مُقرّرہ وقت پر یَاہوِہ کی قُربانی پیش کرنے سے کیوں محروم رکھے جایٔیں؟“<verse eid="NUM 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 9:8"/>مَوشہ نے اُنہیں جَواب دیا، ”جَب تک میں پتا نہ لگاؤں کہ یَاہوِہ تمہارے حق میں کیا حُکم دیتے ہیں تُم ٹھہرے رہو۔“<verse eid="NUM 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 9:9"/>تَب یَاہوِہ نے مَوشہ سے فرمایا، <verse eid="NUM 9:9"/><verse number="10" style="v" sid="NUM 9:10"/>”بنی اِسرائیل سے کہہ، ’تُم میں سے یا تمہاری نَسل میں سے جو لوگ کسی لاش کو چھُونے کی وجہ سے ناپاک ہو چُکے ہُوں یا کہیں دُور سفر میں ہُوں تو بھی وہ یَاہوِہ کے لیٔے عیدِفسح منائیں۔ <verse eid="NUM 9:10"/><verse number="11" style="v" sid="NUM 9:11"/>وہ اُسے دُوسرے مہینے کے چودھویں دِن کی شام کو منائیں اَور فسح کے گوشت کو بے خمیری روٹی اَور کڑوے ساگ پات کے ساتھ کھایٔیں۔ <verse eid="NUM 9:11"/><verse number="12" style="v" sid="NUM 9:12"/>اَور اُس میں سے کچھ بھی صُبح تک باقی نہ چھوڑا جائے، اُن کی کوئی بھی ہڈّی نہ توڑی جائے۔ اَور جَب وہ عیدِفسح منائیں تو اُس کی تمام شَریعت پر عَمل کریں۔ <verse eid="NUM 9:12"/><verse number="13" style="v" sid="NUM 9:13"/>لیکن جو شخص رسماً پاک ہو اَور سفر میں بھی نہ ہو اگر وہ عیدِفسح نہ منائے تو وہ اَپنی قوم میں سے کاٹ ڈالا جائے کیونکہ اُس نے مُقرّرہ وقت پر یَاہوِہ کی قُربانی پیش نہیں کی۔ اُس آدمی کا گُناہ اُسی کے سَر لگے گا۔<verse eid="NUM 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 9:14"/>” ’اگر کویٔی مُلک اِسرائیل کا باشِندہ ہو یا غَیراِسرائیلی جو تمہارے ساتھ بُودوباش کرتا ہو یَاہوِہ کے لیٔے فسح کرنا چاہے تو وہ اُسے اُس کے ضوابط کے مُطابق مانے۔ تُم مُلک اِسرائیل کے باشِندے اَور غَیراِسرائیلی باشِندے دونوں کے لیٔے ایک ہی ضوابط رکھنا۔‘ “<verse eid="NUM 9:14"/></para>
  <para style="s1">خیمہ اِجتماع کے اُوپر بادل کا چھا جانا</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 9:15"/>جِس دِن پاک مَسکن یعنی عہد کا خیمہ نصب ہُوا، اُس دِن اُس پر بادل چھا گیا اَور شام سے لے کر صُبح تک وہ بادل پاک مَسکن کے اُوپر آگ کی مانند نظر آتا رہا۔ <verse eid="NUM 9:15"/><verse number="16" style="v" sid="NUM 9:16"/>اَور ہمیشہ اَیسا ہی ہوتا تھا، خیمہ پر بادل چھایا رہتا تھا اَور رات کو وہ آگ کی مانند نظر آتا تھا۔ <verse eid="NUM 9:16"/><verse number="17" style="v" sid="NUM 9:17"/>اَور جَب وہ بادل خیمے کے اُوپر سے چھٹ جاتا تھا تو بنی اِسرائیل کُوچ کرتے تھے اَور جہاں وہ بادل جا کر ٹھہر جاتا تھا وہاں اِسرائیلی قِیام کرتے تھے اَور جَب تک وہ بادل ٹھہرا رہتا تھا اِسرائیلی بھی وہاں ڈیرے ڈالے رہتے تھے۔ <verse eid="NUM 9:17"/><verse number="18" style="v" sid="NUM 9:18"/>بنی اِسرائیل یَاہوِہ کے حُکم سے کُوچ کرتے اَور اُسی کے حُکم سے وہ ڈیرے بھی ڈالتے تھے، اَور جَب تک بادل مَسکن پر ٹھہرا رہے وہ چھاؤنی میں رہے۔ <verse eid="NUM 9:18"/><verse number="19" style="v" sid="NUM 9:19"/>جَب بادل کافی عرصہ تک مَسکن پر ٹھہرا رہتا تھا تو بنی اِسرائیل یَاہوِہ کے حُکم کے مُطابق کُوچ نہ کرتے تھے۔ <verse eid="NUM 9:19"/><verse number="20" style="v" sid="NUM 9:20"/>بعض اوقات وہ بادل چند ہی دِنوں تک مَسکن پر رہتا تھا اَور تَب بھی وہ یَاہوِہ کے حُکم سے ڈیرے ڈالے پڑے رہتے اَور جَب وہ حُکم دیتا تو وہ کُوچ کرتے تھے۔ <verse eid="NUM 9:20"/><verse number="21" style="v" sid="NUM 9:21"/>کبھی تو وہ بادل شام سے لے کر صُبح تک ہی ٹھہرا رہتا تھا اَور جَب وہ صُبح کو اُٹھ جاتا تھا تو وہ کُوچ کرتے تھے۔ لہٰذا دِن ہو یا رات جَب بھی وہ بادل اُٹھ جاتا تھا وہ روانہ ہو جاتے تھے۔ <verse eid="NUM 9:21"/><verse number="22" style="v" sid="NUM 9:22"/>چاہے بادل مَسکن پر دو دِن مہینے بھر یا پُورے سال ٹھہرا رہتا بنی اِسرائیل بھی چھاؤنی میں ٹھہرے رہتے اَور کُوچ نہ کرتے تھے۔ لیکن جَب وہ اُٹھ جاتا تو وہ بھی چل پڑتے تھے۔ <verse eid="NUM 9:22"/><verse number="23" style="v" sid="NUM 9:23"/>یَاہوِہ کے حُکم سے وہ خیمہ زن ہوتے اَور یَاہوِہ ہی کے حُکم سے وہ کُوچ کرتے۔ یُوں وہ یَاہوِہ کے حُکم کو بجا لاتے تھے جو اُنہیں مَوشہ کی مَعرفت دیا گیا تھا۔<verse eid="NUM 9:23"/></para>
  <chapter eid="NUM 9"/>
  <chapter number="10" style="c" sid="NUM 10"/>
  <para style="s1">چاندی کے نرسنگے</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 10:1"/>یَاہوِہ نے مَوشہ سے فرمایا، <verse eid="NUM 10:1"/><verse number="2" style="v" sid="NUM 10:2"/>”گڑھی ہُوئی چاندی کے دو نرسنگے بنا لے اَور اُنہیں جماعت کو جمع کرنے اَور چھاؤنی کے کُوچ کرنے کے لیٔے کام میں لانا۔ <verse eid="NUM 10:2"/><verse number="3" style="v" sid="NUM 10:3"/>اَور جَب دونوں نرسنگے پھُونکے جایٔیں تَب ساری جماعت خیمہ اِجتماع کے دروازہ پر تمہارے سامنے جمع ہو جائے۔ <verse eid="NUM 10:3"/><verse number="4" style="v" sid="NUM 10:4"/>لیکن اگر ایک نرسنگا ہی پھُونکا جائے تو صِرف وہ لوگ جو بنی اِسرائیل کے برادریوں کے رئیس یعنی سربراہ ہیں تمہارے سامنے اِکٹھّے ہُوں۔ <verse eid="NUM 10:4"/><verse number="5" style="v" sid="NUM 10:5"/>جَب سانس باندھ کر زور سے نرسنگا پھُونکا جائے تو جو قبیلے مشرق کی جانِب مُقیم ہیں وہ کُوچ کریں۔ <verse eid="NUM 10:5"/><verse number="6" style="v" sid="NUM 10:6"/>جَب دوبارہ سانس باندھ کر زور سے نرسنگا پھُونکا جائے تو جُنوب کی جانِب والی چھاؤنیوں کو کُوچ کریں۔ لہٰذا سانس باندھ کر زور سے نرسنگا پھُونکا جانا کُوچ کا اِشارہ ہوگا۔ <verse eid="NUM 10:6"/><verse number="7" style="v" sid="NUM 10:7"/>جماعت کو جمع کرنے کے لیٔے بھی نرسنگے پھُونکے جایٔیں لیکن اُن کی آوازوں کو زِیادہ طُول دیا جائے۔<verse eid="NUM 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 10:8"/>”اَہرونؔ کاہِنؔ کے بیٹے نرسنگے پھُونکیں۔ یہ فرمان تمہارے اَور تمہاری آئندہ پُشتوں کے لیٔے دائمی فرمان قائِم رہے۔ <verse eid="NUM 10:8"/><verse number="9" style="v" sid="NUM 10:9"/>جَب تُم اَپنے ہی مُلک میں کسی اَیسے دُشمن سے لڑنے کے لیٔے نکلو جو تُم پر ظُلم ڈھاتا ہے تَب سانس باندھ کر زور سے نرسنگے پھُونکنا۔ تَب تُم یَاہوِہ اَپنے خُدا کے حُضُور یاد کئے جاؤگے اَور اَپنے دُشمنوں سے رِہائی پاؤگے۔ <verse eid="NUM 10:9"/><verse number="10" style="v" sid="NUM 10:10"/>اَور اَپنی خُوشی کے موقعوں جَیسے اَپنی مُقرّرہ عیدوں اَور نئے چاند کے جَشن اَور اَپنی سوختنی نذروں اَور سلامتی کی نذر کی قُربانیوں کے موقعوں پر تُم نرسنگے پھُونکو اَور وہ تمہارے خُدا کے حُضُور میں تمہاری یادگارہو جانے کا باعث ہوں گے۔ مَیں یَاہوِہ تمہارا خُدا ہُوں۔“<verse eid="NUM 10:10"/></para>
  <para style="s1">بنی اِسرائیل کا دشتِ سِینؔائی سے کُوچ کرنا</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 10:11"/>دُوسرے سال کے دُوسرے ماہ کے بیسویں دِن وہ بادل شہادت کے مَسکن پر سے اُٹھ گیا۔ <verse eid="NUM 10:11"/><verse number="12" style="v" sid="NUM 10:12"/>تَب بنی اِسرائیل نے سِینؔائی کے بیابان سے کُوچ کیا اَور جابجا سفر کرتے رہے یہاں تک کہ وہ بادل پارانؔ کے بیابان میں جا کر ٹھہرگیا۔ <verse eid="NUM 10:12"/><verse number="13" style="v" sid="NUM 10:13"/>چنانچہ اُنہُوں نے مَوشہ کی مَعرفت دئیے ہویٔے یَاہوِہ کے حُکم کے مُطابق پہلا کُوچ کیا۔<verse eid="NUM 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 10:14"/>پہلے یہُوداہؔ کی چھاؤنی کے دستے اَپنے جھنڈے اُونچے کرکے روانہ ہویٔے اَور عَمّیندابؔ کا بیٹا نحشونؔ اُن کی قیادت کر رہاتھا۔ <verse eid="NUM 10:14"/><verse number="15" style="v" sid="NUM 10:15"/>ضُعرؔ کا بیٹا نتنی ایل یِسَّکاؔر کے قبیلہ کے دستوں کی قیادت کر رہاتھا <verse eid="NUM 10:15"/><verse number="16" style="v" sid="NUM 10:16"/>اَور حیلونؔ کا بیٹا اِلیابؔ زبُولُون کے قبیلہ کے دستوں کی قیادت کر رہاتھا۔ <verse eid="NUM 10:16"/><verse number="17" style="v" sid="NUM 10:17"/>تَب مَسکن اُتارا گیا اَور بنی گیرشون اَور بنی مِراریؔ نے جو اُسے اُٹھائے ہویٔے تھے کُوچ کیا۔<verse eid="NUM 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 10:18"/>پھر رُوبِنؔ کی چھاؤنی کے دستے اَپنے جھنڈے اُونچے کرکے روانہ ہویٔے اَور شدِیُورؔ کا بیٹا اِلیضُورؔ اُن کی قیادت کر رہاتھا۔ <verse eid="NUM 10:18"/><verse number="19" style="v" sid="NUM 10:19"/>ضُوریشدّؔی کا بیٹا سلُومی ایل شمعُونؔ کے قبیلہ کے دستوں کی قیادت کر رہاتھا۔ <verse eid="NUM 10:19"/><verse number="20" style="v" sid="NUM 10:20"/>اَور دعُوایلؔ کا بیٹا اِلیاسفؔ، گادؔ کے قبیلہ کے دستوں کی قیادت کر رہاتھا۔ <verse eid="NUM 10:20"/><verse number="21" style="v" sid="NUM 10:21"/>تَب قُہاتیوں نے مُقدّس چیزیں اُٹھائے ہویٔے کُوچ کیا۔ اُن کے پہُنچنے سے پہلے ضروُری تھا کہ مَسکن کھڑا کر دیا جائے۔<verse eid="NUM 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 10:22"/>پھر اِفرائیمؔ کے قبیلہ کے دستے اَپنے جھنڈے اُونچے کرکے روانہ ہویٔے۔ عمّیہُوؔد کا بیٹا اِلیشمعؔ اُن کی قیادت کر رہاتھا۔ <verse eid="NUM 10:22"/><verse number="23" style="v" sid="NUM 10:23"/>پِداہضُورؔ کا بیٹا گَملی ایل منشّہ کے قبیلہ کے دستوں کی قیادت کر رہاتھا۔ <verse eid="NUM 10:23"/><verse number="24" style="v" sid="NUM 10:24"/>اَور ابیدانؔ بِن گِدعونیؔ بِنیامین کے قبیلہ کے دستوں کی قیادت کر رہاتھا۔<verse eid="NUM 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 10:25"/>اَور آخِر میں دانؔ کی چھاؤنی کے دستے اَپنے جھنڈے کے ساتھ سارے دستوں کے پیچھے روانہ ہویٔے۔ احیعزر بِن عمّی شدّؔی اُن کی قیادت کر رہاتھا۔ <verse eid="NUM 10:25"/><verse number="26" style="v" sid="NUM 10:26"/>عُکرانؔ کا بیٹا پگعِیلؔ آشیر کے قبیلہ کے دستوں کی قیادت کر رہاتھا، <verse eid="NUM 10:26"/><verse number="27" style="v" sid="NUM 10:27"/>اَور عینانؔ کا بیٹا اَخیرعؔ نفتالی کے قبیلہ کے دستوں کی قیادت کر رہاتھا۔ <verse eid="NUM 10:27"/><verse number="28" style="v" sid="NUM 10:28"/>چنانچہ جَب اِسرائیلی دستے کُوچ کرتے تھے تو اِسی ترتیب کے مُطابق آگے روانہ ہوتے تھے۔<verse eid="NUM 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 10:29"/>مَوشہ نے اَپنے سسُر رِعوایلؔ مِدیانی کے بیٹے حوبابؔ سے کہا، ”ہم اُس مقام کی طرف کُوچ کر رہے ہیں جِس کے متعلّق یَاہوِہ نے فرمایاہے، ’میں اُسے تُمہیں دُوں گا!‘ لہٰذا تُو بھی ہمارے ساتھ چل اَور ہم تمہارے ساتھ نیک سلُوک کریں گے کیونکہ یَاہوِہ نے بنی اِسرائیل سے نیکی کا وعدہ کیا ہے۔“<verse eid="NUM 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 10:30"/>اُس نے جَواب دیا، ”نہیں میں نہیں چلتا۔ میں تو اَپنے مُلک اَور اَپنے لوگوں میں لَوٹ جاؤں گا۔“<verse eid="NUM 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 10:31"/>لیکن مَوشہ نے کہا، ”مہربانی سے ہمیں چھوڑکر نہ جاؤ کیونکہ تُم ہی بتا سکتے ہو کہ بیابان میں ہم کہاں قِیام کریں: اَور تُم ہمارے لیٔے آنکھوں کا کام دے سکتے ہو۔ <verse eid="NUM 10:31"/><verse number="32" style="v" sid="NUM 10:32"/>اگر تُم ہمارے ساتھ چلوگے تو ہر نیکی میں جو یَاہوِہ ہمارے ساتھ کریں گے تُم بھی برابر کے حِصّہ دار ہوگے۔“<verse eid="NUM 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 10:33"/>چنانچہ وہ یَاہوِہ کے پہاڑ سے چل پڑے اَور تین دِن تک سفر کرتے رہے اَور اُن تین دِنوں میں یَاہوِہ کے عہد کا صندُوق اُن کے قِیام کرنے کے لیٔے جگہ تلاش کرتا ہُوا اُن کے آگے آگے چلتا رہا۔ <verse eid="NUM 10:33"/><verse number="34" style="v" sid="NUM 10:34"/>اَور جَب وہ اَپنی چھاؤنی سے کُوچ کرتے تو یَاہوِہ کا بادل اُن کے اُوپر دِن بھر سایہ کئے رہتا تھا۔<verse eid="NUM 10:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 10:35"/>جَب صندُوق کُوچ کرتا تھا تو مَوشہ کہتا تھا،</para>
  <para style="q1" vid="NUM 10:35">”اَے یَاہوِہ اُٹھیں!</para>
  <para style="q2" vid="NUM 10:35">آپ کے دُشمن پراگندہ ہو جایٔیں؛</para>
  <para style="q2" vid="NUM 10:35">اَور آپ کے حریف آپ کے سامنے سے بھاگ جایٔیں۔“<verse eid="NUM 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 10:36"/>اَور جَب کبھی وہ ٹھہر جاتا تھا تو وہ کہتا تھا،</para>
  <para style="q1" vid="NUM 10:36">”اَے یَاہوِہ،</para>
  <para style="q2" vid="NUM 10:36">ہزاروں ہزار اِسرائیلیوں میں لَوٹ کر آ جائیں۔“<verse eid="NUM 10:36"/></para>
  <chapter eid="NUM 10"/>
  <chapter number="11" style="c" sid="NUM 11"/>
  <para style="s1">یَاہوِہ کی جانِب سے آتِش کا نازل ہونا</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 11:1"/>پھر لوگ یَاہوِہ سے اَپنی تکالیف کی شکایت کرنے لگے اَور جَب اُنہُوں نے اُنہیں سُنا تو اُن کا غضب بھڑک اُٹھا۔ تَب یَاہوِہ کی آتِش اُن کے درمیان بھڑکی جِس سے اُن کی چھاؤنی کے چاروں طرف کے علاقے بھسم ہونے لگے۔ <verse eid="NUM 11:1"/><verse number="2" style="v" sid="NUM 11:2"/>تَب لوگوں نے مَوشہ سے آہ و زاری کی اَور اُس نے یَاہوِہ سے دعا کی اَور وہ آگ بُجھ گئی۔ <verse eid="NUM 11:2"/><verse number="3" style="v" sid="NUM 11:3"/>اِس لیٔے اُس جگہ کا نام تبعیرہؔ<note caller="+" style="f"><char style="fr" closed="false">11‏:3 </char><char style="fq" closed="false">تبعیرہؔ </char><char style="ft" closed="false">جلنا</char></note> پڑا کیونکہ یَاہوِہ کی آگ اُن کے درمیان جَل اُٹھی تھی۔<verse eid="NUM 11:3"/></para>
  <para style="s1">یَاہوِہ کی جانِب سے بٹیریں</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 11:4"/>بنی اِسرائیل میں شامل ہونے والے جمع لوگ کھانے کی دُوسری چیزوں کی خواہش کرنے لگے، اَور بنی اِسرائیل بھی آہ و زاری کرنے لگے، ”کاش کہ ہمیں کھانے کو گوشت مِل سَکتا! <verse eid="NUM 11:4"/><verse number="5" style="v" sid="NUM 11:5"/>ہمیں اُس مچھلی کی جسے ہم مِصر میں مُفت کھاتے تھے اَور اُن کھیروں، خربوزوں، گندنوں، ہری پیاز اَور لہسن کی بھی یاد آتی ہے۔ <verse eid="NUM 11:5"/><verse number="6" style="v" sid="NUM 11:6"/>لیکن اَب ہماری بھُوک مَر چُکی ہے؛ اَور ہم اِس منّا کے علاوہ اَور کچھ دیکھ ہی نہیں پاتے!“<verse eid="NUM 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 11:7"/>منّا دھنیے کی مانند تھا اَور وہ دال کی طرح دِکھائی دیتا تھا۔ <verse eid="NUM 11:7"/><verse number="8" style="v" sid="NUM 11:8"/>لوگ اِدھر اُدھر جا کر اُسے جمع کرتے اَور اُسے چکّی میں پیستے یا اوکھلی میں کُوٹ لیتے تھے۔ پھر اُسے کسی برتن میں پکاتے تھے یا اُس کے پھُلکے بناتے تھے اَور اُس کا مزہ زَیتُون کے تیل کا سا ہوتا تھا۔ <verse eid="NUM 11:8"/><verse number="9" style="v" sid="NUM 11:9"/>رات کو جَب چھاؤنی پر اوس پڑتی تھی تَب منّا بھی گِرتا تھا۔<verse eid="NUM 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 11:10"/>مَوشہ نے ہر خاندان کے افراد کو اَپنے اَپنے خیمہ کے دروازہ پر واویلا کرتے ہویٔے سُنا۔ یَاہوِہ نہایت غضبناک ہُوئے اَور مَوشہ بھی پریشان ہو گیا۔ <verse eid="NUM 11:10"/><verse number="11" style="v" sid="NUM 11:11"/>مَوشہ نے یَاہوِہ سے پُوچھا، ”آپ اَپنے خادِم پر یہ مُصیبت کیوں لائے؟ آخِر مَیں نے اَیسا کون سا کام کیا تھا آپ کی نظرِکرم مُجھ پر سے اُٹھی جِس سے آپ ناراض ہُوئے اَور اِن سَب لوگوں کا بوجھ مُجھ پر ڈال دیا؟ <verse eid="NUM 11:11"/><verse number="12" style="v" sid="NUM 11:12"/>کیا یہ سَب لوگ میرے پیٹ میں پڑے تھے؟ کیا یہ مُجھ ہی سے پیدا ہویٔے؟ پھر آپ مُجھے کیوں کہتے ہیں ’میں ایک دایہ کی مانند جو کسی نَوزائیدہ بچّے کو لیٔے پھرتی ہے اُنہیں اَپنی گود میں اُٹھاکر‘ اُس مُلک میں لے جاؤں جِس کے دینے کی قَسم آپ نے اُن کے آباؤاَجداد سے کھائی ہے؟ <verse eid="NUM 11:12"/><verse number="13" style="v" sid="NUM 11:13"/>میں اِن سَب کے لیٔے گوشت کہاں سے لاؤں؟ وہ یہ کہہ کر میرے سامنے گڑگڑاتے ہیں، ’ہمیں گوشت کھانے کو دیں!‘ <verse eid="NUM 11:13"/><verse number="14" style="v" sid="NUM 11:14"/>میں اکیلا اِن سَب کو کیسے سنبھالوں؟ یہ بوجھ میری طاقت سے باہر ہے۔ <verse eid="NUM 11:14"/><verse number="15" style="v" sid="NUM 11:15"/>اگر آپ میرے ساتھ اَیسا ہی سلُوک کرتے ہیں تو براہِ کرم مجھ سے ابھی میری جان لے لیں۔ اگر مَیں نے آپ سے نظرِکرم پائی ہے تو میں اَپنی تباہی سے دوچار نہ ہونے پاؤں۔“<verse eid="NUM 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 11:16"/>یَاہوِہ نے مَوشہ سے فرمایا: ”بنی اِسرائیل کے بُزرگوں میں سے ستّر اَیسے لوگوں کو میرے حُضُور میں جمع کر جنہیں تُو جانتا ہے کہ وہ قوم کے سردار اَور منصبدار ہیں اَور اُنہیں خیمہ اِجتماع کے پاس لے آنا کہ وہ تمہارے ساتھ وہاں کھڑے ہُوں۔ <verse eid="NUM 11:16"/><verse number="17" style="v" sid="NUM 11:17"/>تَب مَیں نیچے اُتر آؤں گا اَور تُجھ سے وہاں باتیں کروں گا اَور مَیں اُس رُوح میں سے جو تُجھ پر ہے کچھ لے کر اُس رُوح کو اُن پر ڈال دُوں گا۔ وہ لوگوں کا بوجھ اُٹھانے میں تمہاری مدد کریں گے تاکہ تُمہیں اکیلے بوجھ اُٹھانا نہ پڑے۔<verse eid="NUM 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 11:18"/>”لوگوں سے کہو، ’کل گوشت کھانے کے لیٔے اَپنے آپ کو پاک کر لو۔ جَب تُم یہ کہہ کر آہ و زاری کر رہے تھے، ”کاش ہمیں گوشت کھانے کو ملتا! ہم مِصر ہی میں اَچھّے تھے!“ یَاہوِہ نے تمہاری فریاد سُن لی ہے۔ لہٰذا وہ تُمہیں گوشت دیں گے اَور تُم اُسے کھاؤگے۔ <verse eid="NUM 11:18"/><verse number="19" style="v" sid="NUM 11:19"/>تُم صِرف ایک یا دو دِن یا پانچ، دس یا بیس دِن ہی نہیں، <verse eid="NUM 11:19"/><verse number="20" style="v" sid="NUM 11:20"/>بَلکہ پُورے ایک ماہ تک اُسے کھاتے رہوگے یہاں تک کہ وہ تمہارے نتھنوں سے نکلنے لگے گا اَور تُمہیں اُس سے گھن آنے لگے گی کیونکہ تُم نے یَاہوِہ کو جو تمہارے درمیان ہے ترک کر دیا اَور اُن کے سامنے یہ کہہ کر آہ و زاری کی، ”ہم مِصر سے کیوں نکل آئے؟“ ‘ “<verse eid="NUM 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 11:21"/>لیکن مَوشہ نے کہا، ”سَب لوگ جو میرے ساتھ ہیں اِن میں چھ لاکھ تو پیادے ہی ہیں اَور آپ کہتے ہیں، ’میں اِنہیں اِتنا گوشت دُوں گا کہ وہ مہینے بھر اُسے کھاتے رہیں گے!‘ <verse eid="NUM 11:21"/><verse number="22" style="v" sid="NUM 11:22"/>اگر بھیڑ بکریوں کے گلّے اَور مویشیوں کے ریوڑ بھی اُن کے لیٔے ذبح کئے جایٔیں تو کیا اُن کے لیٔے بس ہوں گے؟ اَور اگر سمُندر کی ساری مچھلیاں لائی جایٔیں تو کیا وہ اُن کے لیٔے کافی ہُوں گی؟“<verse eid="NUM 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 11:23"/>یَاہوِہ نے مَوشہ کو جَواب دیا، ”کیا یَاہوِہ کا ہاتھ اِس قدر چھوٹا ہو گیا ہے؟ اَب تُو دیکھ لے گا کہ میرا قول پُورا ہوتاہے یا نہیں۔“<verse eid="NUM 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 11:24"/>تَب مَوشہ نے باہر جا کر لوگوں کو یَاہوِہ کی باتیں کہہ سُنائیں۔ اُس نے اُن میں سے ستّر سربراہ بُزرگوں کو جمع کیا اَور اُنہیں خیمہ کے اِردگرد کھڑا کر دیا۔ <verse eid="NUM 11:24"/><verse number="25" style="v" sid="NUM 11:25"/>تَب یَاہوِہ بادل میں ہوکر اُترے اَور اُنہُوں نے مَوشہ سے باتیں کیں اَور اُس رُوح میں سے جو مَوشہ پر تھا کچھ لے کر اُسے اُن ستّر سردار بُزرگوں پر ڈال دیا۔ اَور جَب وہ رُوح اُن پر اُترا تَب اُنہُوں نے نبُوّت کی لیکن بعد میں پھر کبھی نہ کیا۔<verse eid="NUM 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 11:26"/>البتّہ دو شخص جِن کے نام اِلدادؔ اَور میدادؔ تھے چھاؤنی میں رہ گیٔے تھے۔ اُن کے نام بُزرگوں کی فہرست میں درج تھے لیکن وہ خیمہ کے پاس نہیں آئےتھے۔ پھر بھی اُن پر رُوح اُتر آیا اَور وہ چھاؤنی میں نبُوّت کرنے لگے۔ <verse eid="NUM 11:26"/><verse number="27" style="v" sid="NUM 11:27"/>ایک نوجوان دَوڑتا ہُوا مَوشہ کے پاس گیا اَور کہا، ”اِلدادؔ اَور میدادؔ چھاؤنی میں نبُوّت کر رہے ہیں۔“<verse eid="NUM 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 11:28"/>تَب یہوشُعؔ بِن نُونؔ نے، جو اَپنی جَوانی ہی سے مَوشہ کا مُعاوِن رہ چُکاتھا کہا، ”اَے میرے آقا مَوشہ! اُنہیں روک دیں!“<verse eid="NUM 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 11:29"/>لیکن مَوشہ نے جَواب دیا، ”کیا تُمہیں میری خاطِر رشک آتا ہے؟ کاش کہ یَاہوِہ کے سَب لوگ نبی ہوتے اَور یَاہوِہ اَپنی رُوح اُن سَب پر ڈالتے!“ <verse eid="NUM 11:29"/><verse number="30" style="v" sid="NUM 11:30"/>تَب مَوشہ اَور بنی اِسرائیل کے بُزرگ چھاؤنی میں لَوٹ آئے۔<verse eid="NUM 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 11:31"/>پھر یَاہوِہ کی طرف سے ایک آندھی چلی اَور سمُندر سے بٹیریں اُڑا لائی اَور اُنہیں چھاؤنی کے چاروں طرف زمین پر ڈال دیا۔ اَور اُن کی کثرت کا یہ حال تھا کہ ایک دِن کی مَسافت تک ہر طرف اُن کی دو دو ہاتھ<note caller="+" style="f"><char style="fr" closed="false">11‏:31 </char><char style="fq" closed="false">دو دو ہاتھ </char><char style="ft" closed="false">تقریباً نوّے سینٹی میٹر</char></note> اُونچی تہہ لگی ہُوئی تھی۔ <verse eid="NUM 11:31"/><verse number="32" style="v" sid="NUM 11:32"/>پُورے دِن اَور پُوری رات اَور دُوسرے دِن بھی لوگوں نے باہر جا کر بٹیریں جمع کیں اَور کسی نے بھی دس حُومر<note caller="+" style="f"><char style="fr" closed="false">11‏:32 </char><char style="fq" closed="false">دس حُومر </char><char style="ft" closed="false">یعنی، مُمکنہ طور پر تقریباً ایک میٹرک ٹن اَور چھ سَو کِلوگرام</char></note> سے کم نہ بٹوریں اَور اُنہیں چھاؤنی کے چاروں طرف پھیلا دیا۔ <verse eid="NUM 11:32"/><verse number="33" style="v" sid="NUM 11:33"/>لیکن گوشت ابھی اُن کے دانتوں کے درمیان ہی تھا اَور وہ اُسے نگل بھی نہ پایٔے تھے کہ یَاہوِہ کا قہر اُن پر بھڑکا اَور وہ ایک نہایت شدید وَبا کے باعث مار ڈالے گیٔے۔ <verse eid="NUM 11:33"/><verse number="34" style="v" sid="NUM 11:34"/>اِس لیٔے اُس جگہ کا نام قِبروتؔ ہتّاوہؔ<note caller="+" style="f"><char style="fr" closed="false">11‏:34 </char><char style="fq" closed="false">قِبروتؔ ہتّاوہؔ </char><char style="ft" closed="false">خواہش کی قبریں</char></note> رکھا گیا کیونکہ وہ لوگ جنہوں نے کسی دُوسری قِسم کی غِذا کی حِرص کی تھی وہاں دفن کئے گیٔے تھے۔<verse eid="NUM 11:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 11:35"/>تَب وہ لوگ قِبروتؔ ہتّاوہؔ سے سفر کرکے حَضِیروتؔ کو گیٔے اَور وہاں خیمہ زن ہویٔے۔<verse eid="NUM 11:35"/></para>
  <chapter eid="NUM 11"/>
  <chapter number="12" style="c" sid="NUM 12"/>
  <para style="s1">مِریمؔ اَور اَہرونؔ کا مُوسیٰ کی مُخالفت کرنا</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 12:1"/>مِریمؔ اَور اَہرونؔ مَوشہ کی کُوشی بیوی کے سبب سے اُس کی بُرائی کرنے لگے کیونکہ اُس نے ایک کُوشی عورت سے بیاہ کر لیا تھا۔ <verse eid="NUM 12:1"/><verse number="2" style="v" sid="NUM 12:2"/>اُنہُوں نے کہا، ”کیا یَاہوِہ نے محض مَوشہ ہی سے باتیں کی ہیں؟ کیا اُنہُوں نے ہم سے بھی باتیں نہیں کیں؟“ اَور یَاہوِہ نے اُن کی یہ باتیں سُن لیں۔<verse eid="NUM 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 12:3"/>(مَوشہ نہایت حلیم شخص تھا بَلکہ وہ رُوئے زمین کے ہر شخص سے زِیادہ حلیم تھا۔)<verse eid="NUM 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 12:4"/>یَاہوِہ نے فوراً مَوشہ، اَہرونؔ اَور مِریمؔ سے کہا، ”تُم تینوں نکل کر خیمہ اِجتماع کے پاس حاضِر ہو جاؤ۔“ چنانچہ وہ تینوں باہر نکل آئے۔ <verse eid="NUM 12:4"/><verse number="5" style="v" sid="NUM 12:5"/>تَب یَاہوِہ بادل کے ایک سُتون میں ہوکر اُتر آئے اَور خیمہ کے دروازہ پر کھڑے ہوکر اَہرونؔ اَور مِریمؔ کو بُلایا۔ جَب وہ دونوں آگے بڑھے <verse eid="NUM 12:5"/><verse number="6" style="v" sid="NUM 12:6"/>تَب یَاہوِہ نے فرمایا، ”میری باتیں سُنو:</para>
  <para style="q1" vid="NUM 12:6">”جَب تمہارے درمیان یَاہوِہ کا کویٔی نبی برپا ہوتاہے،</para>
  <para style="q2" vid="NUM 12:6">تو میں اَپنے آپ کو، اُس پر رُویا میں ظاہر کرتا ہُوں،</para>
  <para style="q2" vid="NUM 12:6">اَور خواب میں اُس سے باتیں کرتا ہُوں۔<verse eid="NUM 12:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 12:7"/>لیکن میرے خادِم مَوشہ کے حق میں اَیسا نہیں ہے؛</para>
  <para style="q2" vid="NUM 12:7">وہ میرے سارے خاندان میں قابلِ اِعتماد ہے۔<verse eid="NUM 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 12:8"/>اُس سے میں مُعمّوں میں نہیں</para>
  <para style="q2" vid="NUM 12:8">بَلکہ کھُلے طور پر اَور رُوبرو باتیں کرتا ہُوں،</para>
  <para style="q2" vid="NUM 12:8">اُسے یَاہوِہ کا دیدار بھی نصیب ہوتاہے۔</para>
  <para style="q1" vid="NUM 12:8">پھر تُمہیں میرے خادِم مَوشہ کی بُرائی کرتے ہویٔے</para>
  <para style="q2" vid="NUM 12:8">خوف کیوں نہ آیا؟“<verse eid="NUM 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 12:9"/>اَور یَاہوِہ کا غضب اُن پر بھڑکا اَور وہ اُنہیں چھوڑکر چلےگئے۔<verse eid="NUM 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 12:10"/>جَب خیمہ کے اُوپر سے بادل اُٹھ گیا تو مِریمؔ وہاں کھڑی تھی اَور وہ کوڑھ سے برف کی مانند سفید ہو چُکی تھی۔ اَہرونؔ نے مُڑ کر اُس کی طرف دیکھا تو پتا چلا کہ اُسے کوڑھ کا مرض لاحق ہو گیا ہے۔ <verse eid="NUM 12:10"/><verse number="11" style="v" sid="NUM 12:11"/>اَور اَہرونؔ نے مَوشہ سے فرمایا، ”اَے میرے آقا براہِ کرم اِس گُناہ کو جو ہم سے نادانی میں سرزد ہُوا اُسے ہمارے خِلاف نہ ٹھہرائیں۔ <verse eid="NUM 12:11"/><verse number="12" style="v" sid="NUM 12:12"/>اَور مِریمؔ کو اُس مَرے ہویٔے بچّہ کی مانند نہ رہنے دیں جِس کا جِسم اَپنی ماں کے پیٹ سے نکلنے پر ہی ادھ گلا ہوتاہے۔“<verse eid="NUM 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 12:13"/>تَب مَوشہ نے یہ کہہ کر یَاہوِہ سے مِنّت کی، ”اَے خُدا! براہِ کرم آپ اُسے شفا دیں!“<verse eid="NUM 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 12:14"/>یَاہوِہ نے مَوشہ کو جَواب دیا، ”اگر اِس کے باپ نے اِس کے مُنہ پر صِرف تھُوکا ہی ہوتا تو کیا وہ سات دِن تک پشیمان نہ رہتی؟ لہٰذا سات دِن تک اُسے چھاؤنی کے باہر بند رہنے دیں۔ اُس کے بعد وہ اَندر لائی جا سکتی ہے۔“ <verse eid="NUM 12:14"/><verse number="15" style="v" sid="NUM 12:15"/>چنانچہ مِریمؔ سات دِن تک چھاؤنی کے باہر بند رہی اَور اُس کے اَندر آنے تک لوگوں نے کُوچ نہیں کیا۔<verse eid="NUM 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 12:16"/>اُس کے بعد وہ لوگ حَضِیروتؔ سے روانہ ہویٔے اَور پارانؔ کے بیابان میں جا کر خیمہ زن ہویٔے۔<verse eid="NUM 12:16"/></para>
  <chapter eid="NUM 12"/>
  <chapter number="13" style="c" sid="NUM 13"/>
  <para style="s1">مُلک کنعانؔ کا جائزہ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 13:1"/>یَاہوِہ نے مَوشہ سے فرمایا، <verse eid="NUM 13:1"/><verse number="2" style="v" sid="NUM 13:2"/>”چند آدمیوں کو روانہ کر کہ وہ مُلکِ کنعانؔ کا جسے میں بنی اِسرائیل کو دے رہا ہُوں جائزہ لیں۔ تُم ہر آبائی قبیلہ کے سرداروں میں سے ایک ایک شخص کو بھیجنا۔“<verse eid="NUM 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 13:3"/>چنانچہ مَوشہ نے یَاہوِہ کے حُکم کے مُطابق پارانؔ کے بیابان سے اُنہیں روانہ کیا۔ وہ سَب اِسرائیلی سردار تھے۔<verse eid="NUM 13:3"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="4" style="v" sid="NUM 13:4"/>اُن کے نام یہ ہیں:</para>
  <para style="b" vid="NUM 13:4"/>
  <para style="li1" vid="NUM 13:4">رُوبِنؔ کے قبیلہ سے، زکُورؔ کا بیٹا شَمّوعؔ؛<verse eid="NUM 13:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="NUM 13:5"/>شمعُونؔ کے قبیلہ سے حَوریؔ کا بیٹا شافاطؔ؛<verse eid="NUM 13:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="NUM 13:6"/>یہُوداہؔ کے قبیلہ سے یفُنّہؔ کا بیٹا کالبؔ؛<verse eid="NUM 13:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 13:7"/>یِسَّکاؔر کے قبیلہ سے یُوسیفؔ کا بیٹا اِگالؔ؛<verse eid="NUM 13:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="NUM 13:8"/>اِفرائیمؔ کے قبیلہ سے نُونؔ کا بیٹا ہوشِیعؔ؛<verse eid="NUM 13:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="NUM 13:9"/>بِنیامین کے قبیلہ سے رفُوؔ کا بیٹا پَلطیؔ؛<verse eid="NUM 13:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 13:10"/>زبُولُون کے قبیلہ سے سودیؔ کا بیٹا گدّی ایل؛<verse eid="NUM 13:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="NUM 13:11"/>منشّہ کے قبیلہ سے (جو یُوسیفؔ کا قبیلہ تھا) سُوسیؔ کا بیٹا گدّی؛<verse eid="NUM 13:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 13:12"/>دانؔ کے قبیلہ سے گمّلیؔ کا بیٹا عمّی ایل؛<verse eid="NUM 13:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 13:13"/>آشیر کے قبیلہ سے مِیکاایلؔ کا بیٹا سَتُورؔ؛<verse eid="NUM 13:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 13:14"/>نفتالی کے قبیلہ سے وُفسیؔ کا بیٹا نَحّبِی؛<verse eid="NUM 13:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="NUM 13:15"/>گادؔ کے قبیلہ سے ماکیؔ کا بیٹا گیُوایلؔ۔<verse eid="NUM 13:15"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="16" style="v" sid="NUM 13:16"/>یہ اُن لوگوں کے نام ہیں جنہیں مَوشہ نے اُس مُلک کا جائزہ لینے کے لیٔے بھیجا تھا۔ (مَوشہ نے نُونؔ کے بیٹے ہوشِیعؔ کا نام یہوشُعؔ رکھا۔)<verse eid="NUM 13:16"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="17" style="v" sid="NUM 13:17"/>جَب مَوشہ نے اُنہیں مُلکِ کنعانؔ کا جائزہ لینے کے لیٔے بھیجا تو کہا، ”تُم نِیگیوؔ کی طرف سے ہوتے ہویٔے کوہستانی مُلک میں جانا۔ <verse eid="NUM 13:17"/><verse number="18" style="v" sid="NUM 13:18"/>اَور دیکھنا کہ وہ مُلک کیسا ہے اَور وہاں کے باشِندے مضبُوط ہیں یا کمزور؛ تھوڑے ہیں یا بہت؛ <verse eid="NUM 13:18"/><verse number="19" style="v" sid="NUM 13:19"/>وہ کِس قِسم کے مُلک میں بسے ہویٔے ہیں؟ وہ اَچھّا ہے یا بُرا؟ وہ کیسے شہروں میں رہتے ہیں؟ کیا وہ بغیر فصیلوں کے ہیں یا فصیلدار ہیں؟ <verse eid="NUM 13:19"/><verse number="20" style="v" sid="NUM 13:20"/>وہاں کی زمین کیسی ہے؟ کیا وہ زرخیز ہے یا بنجر؟ اَور اُس میں درخت ہیں یا نہیں؟ ہمّت کرکے اَپنے ساتھ اُس مُلک کا کچھ پھل لے آنا۔“ (وہ انگور کی پہلی فصل کا موسم تھا۔)<verse eid="NUM 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 13:21"/>چنانچہ اُنہُوں نے جا کر صینؔ کے بیابان مدخل لیبو حماتؔ کی جانِب رحوبؔ تک اُس مُلک کا جائزہ لیا۔ <verse eid="NUM 13:21"/><verse number="22" style="v" sid="NUM 13:22"/>وہ نِیگیوؔ سے ہوتے ہویٔے حِبرونؔ تک آئے جہاں عناق کے بیٹے احیمانؔ، شیشائی اَور تلمی رہتے تھے۔ (حِبرونؔ مِصر کے ضعنؔ سے سات سال قبل بسایا گیا تھا۔) <verse eid="NUM 13:22"/><verse number="23" style="v" sid="NUM 13:23"/>جَب وہ اِشکلؔ کی وادی میں پہُنچے تو اُنہُوں نے ایک شاخ کاٹ لی جِس میں انگور کا صِرف ایک گُچّھا تھا جسے اُن میں سے دو آدمی ایک لاٹھی پر لٹکایٔے ہویٔے تھے۔ اَور وہ کچھ انار اَور اَنجیر بھی لے آئے۔ <verse eid="NUM 13:23"/><verse number="24" style="v" sid="NUM 13:24"/>انگور کے اُس گُچّھے کے سبب جسے اِسرائیلیوں نے وہاں سے کاٹا تھا اُس مقام کا نام وادی اِشکلؔ رکھا گیا۔ <verse eid="NUM 13:24"/><verse number="25" style="v" sid="NUM 13:25"/>چالیس دِن کے بعد وہ اُس مُلک کی صورت حال کا جائزہ لے کر لَوٹے۔<verse eid="NUM 13:25"/></para>
  <para style="s1">صورت حال کی اِطّلاع</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 13:26"/>وہ پارانؔ کے بیابان میں قادِسؔ کے مقام پر مَوشہ، اَہرونؔ اَور بنی اِسرائیل کی ساری جماعت کے پاس لَوٹ آئے۔ وہاں اُنہُوں نے اُنہیں اَور تمام لوگوں کو سارا حال بتایا اَور اُنہیں اُس مُلک کے پھل بھی دِکھائے۔ <verse eid="NUM 13:26"/><verse number="27" style="v" sid="NUM 13:27"/>اُنہُوں نے مَوشہ کو یہ احوال سُنایا: ”ہم اُس مُلک میں گیٔے جہاں تُم نے ہمیں بھیجا اَور وہاں واقعی دُودھ اَور شہد بہتا ہے اَور یہ پھل بھی وہاں کے ہیں۔ <verse eid="NUM 13:27"/><verse number="28" style="v" sid="NUM 13:28"/>لیکن جو لوگ وہاں بستے ہیں وہ بڑے مضبُوط ہیں اَور وہاں کے شہر فصیلدار اَور نہایت بڑے ہیں۔ ہم نے وہاں بنی عناق کو بھی دیکھا۔ <verse eid="NUM 13:28"/><verse number="29" style="v" sid="NUM 13:29"/>نِیگیوؔ میں تو عمالیقی آباد ہیں لیکن حِتّی، یبُوسی اَور امُوری کوہستانی علاقہ میں رہتے ہیں اَور کنعانی سمُندر کے پاس اَور یردنؔ کے ساحِل پر بسے ہویٔے ہیں۔“<verse eid="NUM 13:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 13:30"/>تَب کالبؔ نے مَوشہ کے سامنے سَب لوگوں کو چُپ کرایا اَور کہا، ”ہم جا کر کیوں نہ اُس مُلک پر قبضہ کر لیں کیونکہ ہم یقیناً اَیسا کر سکتے ہیں۔“<verse eid="NUM 13:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 13:31"/>لیکن جو لوگ اُس کے ساتھ گیٔے تھے وہ کہنے لگے، ”ہم اُن لوگوں پر حملہ نہیں کر سکتے کیونکہ وہ ہم سے زِیادہ زورآور ہیں۔“ <verse eid="NUM 13:31"/><verse number="32" style="v" sid="NUM 13:32"/>اَور اِس طرح اُنہُوں نے بنی اِسرائیل کے درمیان اُس مُلک کے بارے میں جِس کا اُنہُوں نے جائزہ لیا تھا غلط خبر پھیلا دی۔ اُنہُوں نے کہا، ”جِس مُلک کا ہم نے جائزہ لیا وہ اَپنے باشِندوں کو کھا جاتا ہے۔ ہم نے وہاں جتنے لوگ بھی دیکھے وہ سَب بڑے قدآور ہیں۔ <verse eid="NUM 13:32"/><verse number="33" style="v" sid="NUM 13:33"/>اَور ہم نے وہاں بنی نفیل کو بھی دیکھا (جو عناقیوں کی نَسل کے نفیلی قوم سے تھے)۔ ہم اُن کے سامنے ٹِڈّوں کی مانند نظر آنے لگے اَور اُنہُوں نے بھی ہمیں ٹِڈّے ہی سمجھا۔“<verse eid="NUM 13:33"/></para>
  <chapter eid="NUM 13"/>
  <chapter number="14" style="c" sid="NUM 14"/>
  <para style="s1">لوگوں کی بغاوت</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 14:1"/>اُس رات قوم کے سَب لوگ اَپنی آواز بُلند کرکے چِلّائے اَور زار زار رُوئے۔ <verse eid="NUM 14:1"/><verse number="2" style="v" sid="NUM 14:2"/>تمام اِسرائیلی مَوشہ اَور اَہرونؔ کے خِلاف بُڑبُڑانے لگے اَور ساری جماعت نے اُن سے کہا، ”کاش کہ ہم مِصر ہی میں مَر جاتے یا بیابان ہی میں ڈھیر ہو جاتے! <verse eid="NUM 14:2"/><verse number="3" style="v" sid="NUM 14:3"/>یَاہوِہ ہمیں اِس مُلک میں کیوں لائے ہیں؟ کیا صِرف اِس لیٔے کہ ہم تلواروں سے قتل کئے جایٔیں؟ ہماری بیویاں اَور بچّے لُوٹ کا مال بَن جایٔیں؟ کیا ہمارے لیٔے بہتر نہ ہوگا کہ ہم واپس مِصر چلے جایٔیں؟“ <verse eid="NUM 14:3"/><verse number="4" style="v" sid="NUM 14:4"/>اَور وہ آپَس میں کہنے لگے، ”آؤ ہم کسی کو اَپنا سردار بنا لیں اَور مِصر لَوٹ چلیں۔“<verse eid="NUM 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 14:5"/>تَب مَوشہ اَور اَہرونؔ بنی اِسرائیل کی ساری جماعت کے سامنے جو وہاں جمع تھی مُنہ کے بَل گِرے۔ <verse eid="NUM 14:5"/><verse number="6" style="v" sid="NUM 14:6"/>یہوشُعؔ بِن نُونؔ اَور یفُنّہؔ کے بیٹے کالبؔ نے جو اُس مُلک کا جائزہ لینے والوں میں سے تھے اَپنے اَپنے کپڑے پھاڑ ڈالے <verse eid="NUM 14:6"/><verse number="7" style="v" sid="NUM 14:7"/>اَور بنی اِسرائیل کی ساری جماعت سے کہا، ”جِس مُلک میں سے گزر کر ہم نے اُس کا جائزہ لیا وہ نہایت اَچھّا مُلک ہے۔ <verse eid="NUM 14:7"/><verse number="8" style="v" sid="NUM 14:8"/>اگر یَاہوِہ ہم سے راضی رہے تو وہ ہمیں اُس مُلک میں پہُنچا دیں گے جہاں دُودھ اَور شہد بہتا ہے اَور اُسے ہمیں دیں گے۔ <verse eid="NUM 14:8"/><verse number="9" style="v" sid="NUM 14:9"/>صِرف اِتنا ہو کہ یَاہوِہ کے خِلاف بغاوت نہ کرو اَور نہ اُس مُلک کے لوگوں سے ڈرو کیونکہ ہم اُن کو نگل جایٔیں گے۔ اُنہیں کہیں پناہ نہیں ملے گی۔ یَاہوِہ ہمارے ساتھ ہیں۔ تُم اُن سے مت ڈرو۔“<verse eid="NUM 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 14:10"/>لیکن ساری جماعت اُنہیں سنگسار کرنے کی باتیں کرنے لگی۔ تَب خیمہ اِجتماع میں تمام بنی اِسرائیل کے سامنے یَاہوِہ کا جلال ظاہر ہُوا۔ <verse eid="NUM 14:10"/><verse number="11" style="v" sid="NUM 14:11"/>یَاہوِہ نے مَوشہ سے کہا، ”یہ لوگ کب تک میری توہین کرتے رہیں گے؟ اَور باوُجُود اُن تمام معجزوں کے جو مَیں نے اُن کے درمیان کیٔے ہیں وہ کب تک مُجھ پر ایمان نہ لائیں گے؟ <verse eid="NUM 14:11"/><verse number="12" style="v" sid="NUM 14:12"/>میں اُنہیں وَبا سے ماروں گا اَور اُنہیں تباہ کر دُوں گا۔ لیکن تُمہیں ایک اَیسی قوم بناؤں گا جو اِن سے بھی عظیم اَور زورآور ہوگی۔“<verse eid="NUM 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 14:13"/>مَوشہ نے یَاہوِہ سے کہا، ”تَب تو مِصری اِس کے بارے میں سُن لیں گے! آپ تو اَپنی قُدرت سے اِن لوگوں کو اُن کے درمیان سے نکال لائے۔ <verse eid="NUM 14:13"/><verse number="14" style="v" sid="NUM 14:14"/>اَور وہ اُس مُلک کے باشِندوں کو اِس کے بارے میں بتائیں گے۔ وہ تو سُن چُکے ہیں کہ آپ جو یَاہوِہ ہیں اِن لوگوں کے درمیان رہتے ہیں اَور یہ کہ آپ جو یَاہوِہ ہیں رُوبرو دِکھائی دیتے ہیں اَور آپ کا بادل اُن پر سایہ کئے رہتاہے اَور آپ دِن کے وقت بادل کے سُتون میں ہوکر اَور رات کو آگ کے سُتون میں ہوکر اُن کے آگے آگے چلا کرتے ہیں۔ <verse eid="NUM 14:14"/><verse number="15" style="v" sid="NUM 14:15"/>اگر آپ اِن لوگوں کو ایک ہی وقت جان سے مار ڈالیں تو جِن قوموں نے آپ کے بارے میں یہ حال سُنا ہے وہ کہیں گی: <verse eid="NUM 14:15"/><verse number="16" style="v" sid="NUM 14:16"/>’چونکہ یَاہوِہ اِس قوم کو اُس مُلک میں نہ لا سکے جِس کا وعدہ اُنہُوں نے اُن سے قَسم کھا کر کیا تھا اِس لیٔے اُنہُوں نے اُنہیں بیابان میں مار ڈالا۔‘<verse eid="NUM 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 14:17"/>”لہٰذا اَب یَاہوِہ کی قُدرت آپ کے اِس قول کے مُطابق عیاں ہو: <verse eid="NUM 14:17"/><verse number="18" style="v" sid="NUM 14:18"/>’یَاہوِہ قہر کرنے میں دھیمے شفقت میں غنی اَور گُناہ اَور سرکشی کے بخشنے والے۔ پھر بھی وہ مُجرم کو بے سزا نہیں چھوڑتے اَور وہ اَولاد کو اُن کے آباؤاَجداد کے گُناہ کی سزا اُن کے بیٹوں اَور پوتوں کو تیسری اَور چوتھی پُشت تک دیتے ہیں۔‘ <verse eid="NUM 14:18"/><verse number="19" style="v" sid="NUM 14:19"/>لہٰذا اَپنی لافانی مَحَبّت کے مُطابق جَیسے آپ اُنہیں مِصر سے نکلنے کے بعد سے آج تک مُعاف کرتے آئے ہیں وَیسے ہی اَب بھی اِن لوگوں کا گُناہ بخش دیں۔“<verse eid="NUM 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 14:20"/>یَاہوِہ نے جَواب دیا، ”مَیں نے تمہاری اِلتجا کے مُطابق اُنہیں مُعاف کر دیا۔ <verse eid="NUM 14:20"/><verse number="21" style="v" sid="NUM 14:21"/>البتّہ مُجھے اَپنی حیات کی قَسم کہ جَب تک یَاہوِہ کے جلال سے ساری زمین معموُر ہوتی رہے گی <verse eid="NUM 14:21"/><verse number="22" style="v" sid="NUM 14:22"/>جِس کسی نے میرا جلال دیکھا اَور اُن معجزوں کو بھی دیکھا جو مَیں نے مِصر میں اَور اِس بیابان میں کئے لیکن میرا حُکم نہ مانا اَور دس بار مُجھے آزمایا <verse eid="NUM 14:22"/><verse number="23" style="v" sid="NUM 14:23"/>اُن میں سے ایک شخص بھی اُس مُلک کو ہرگز نہ دیکھ پایٔےگا جِس کے دینے کا وعدہ مَیں نے قَسم کھا کر اُن کے آباؤاَجداد سے کیا تھا۔ <verse eid="NUM 14:23"/><verse number="24" style="v" sid="NUM 14:24"/>لیکن چونکہ میرے خادِم کالبؔ کی کچھ اَور ہی طبیعت تھی اَور وہ دِل و جان سے میری پیروی کرتا آیا ہے میں اُسے اُس مُلک میں جہاں وہ ہو آیا ہے پہُنچاؤں گا اَور اُس کی اَولاد اُس کی وارِث ہوگی۔ <verse eid="NUM 14:24"/><verse number="25" style="v" sid="NUM 14:25"/>چونکہ عمالیقی اَور کنعانی وادیوں میں بسے ہویٔے ہیں لہٰذا کل تُم پلٹ کر بحرِقُلزمؔ کو جانے والی راہ سے بیابان کی طرف کُوچ کرو۔“<verse eid="NUM 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 14:26"/>پھر یَاہوِہ نے مَوشہ اَور اَہرونؔ سے کہا: <verse eid="NUM 14:26"/><verse number="27" style="v" sid="NUM 14:27"/>”آخِر کب تک یہ بدکار قوم میرے خِلاف بُڑبُڑاتی رہے گی؟ مَیں نے اِن بُڑبُڑانے والے اِسرائیلیوں کی شکائتیں سُن لی ہیں۔ <verse eid="NUM 14:27"/><verse number="28" style="v" sid="NUM 14:28"/>سو تُم اُن سے کہہ دو کہ یَاہوِہ فرماتے ہیں، ’مُجھے میری حیات کی قَسم میں تمہارے ساتھ وُہی سلُوک کروں گا، جِس پر تُم نے مُجھے مجبُور کر دیا ہے۔ <verse eid="NUM 14:28"/><verse number="29" style="v" sid="NUM 14:29"/>تمہاری لاشیں اِسی بیابان میں پڑی رہ جایٔیں گی۔ تُم میں سے جتنے افراد بیس سال یا اُس سے زِیادہ عمر کے ہیں جِن کی مردُم شماری ہو چُکی ہے اَورجو میرے خِلاف بُڑبُڑایا کرتے تھے۔ <verse eid="NUM 14:29"/><verse number="30" style="v" sid="NUM 14:30"/>اُن میں سے یفُنّہؔ کے بیٹے کالبؔ اَور یہوشُعؔ بِن نُونؔ کے سِوا کویٔی بھی اُس مُلک میں داخل نہ ہونے پایٔےگا جِس میں تُمہیں بسانے کی مَیں نے قَسم کھائی تھی۔ <verse eid="NUM 14:30"/><verse number="31" style="v" sid="NUM 14:31"/>البتّہ تمہارے بال بچّوں کو جِن کے متعلّق تُم نے کہاتھا کہ وہ اِغوا کر لیٔے جایٔیں گے میں وہاں لے آؤں گا تاکہ وہ اُس مُلک کی قدر پہچانیں جسے تُم نے ٹھکرا دیا۔ <verse eid="NUM 14:31"/><verse number="32" style="v" sid="NUM 14:32"/>لیکن تمہارا یہ حال ہوگا کہ تمہاری لاشیں اِسی بیابان میں پڑی رہیں گی۔ <verse eid="NUM 14:32"/><verse number="33" style="v" sid="NUM 14:33"/>تمہاری اَولاد چالیس سال تک یہاں گلّہ بانی کرتی رہے گی اَور تمہاری بدکاری کا پھل برداشت کرتی رہے گی جَب تک کہ تمہاری آخِری لاش بیابان میں پڑی پڑی گل نہ جائے۔ <verse eid="NUM 14:33"/><verse number="34" style="v" sid="NUM 14:34"/>اِن چالیس دِنوں کے حِساب سے جَب کہ تُم اُس مُلک کا جائزہ لیتے رہے فی دِن ایک سال کے مُطابق چالیس سال تک تُم اَپنے گُناہوں کا پھل پاتے رہوگے اَور تَب تُمہیں مَعلُوم ہوگا کہ میری مُخالفت کرنے کا اَنجام کیا ہوتاہے؟‘ <verse eid="NUM 14:34"/><verse number="35" style="v" sid="NUM 14:35"/>میں یَاہوِہ یہ کہہ چُکا اَور مَیں اُس بدکار قوم کے ساتھ جو میری مُخالفت پر ایکا کر چُکی ہے یقیناً اَیسا ہی کروں گا۔ اُن کا خاتِمہ اِسی بیابان میں ہوگا اَور وہ یہیں مَریں گے۔“<verse eid="NUM 14:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 14:36"/>لہٰذا جِن لوگوں کو مَوشہ نے مُلک کا جائزہ لینے کے لیٔے بھیجا تھا اَور جنہوں نے لَوٹ کر اُس کے متعلّق غلط اِطّلاع دے کر ساری جماعت کو مَوشہ کے خِلاف بُڑبُڑانے پر اُبھارا تھا۔ <verse eid="NUM 14:36"/><verse number="37" style="v" sid="NUM 14:37"/>یہ لوگ جو اُس مُلک کے بارے میں غلط اِطّلاع دینے کے ذمّہ دار تھے یَاہوِہ کے حُضُور وَبا سے مَر گیٔے۔ <verse eid="NUM 14:37"/><verse number="38" style="v" sid="NUM 14:38"/>جو لوگ مُلک کا جائزہ لینے گیٔے تھے اُن میں سے صِرف یہوشُعؔ بِن نُونؔ اَور یفُنّہؔ کا بیٹا کالبؔ سلامت بچ گیٔے۔<verse eid="NUM 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 14:39"/>جَب مَوشہ نے تمام بنی اِسرائیل کو یہ ماجرا سُنایا تو وہ بہت دُکھ سے رونے لگے۔ <verse eid="NUM 14:39"/><verse number="40" style="v" sid="NUM 14:40"/>دُوسرے دِن علی الصبح وہ یہ کہتے ہویٔے اُس مُلک کی پہاڑیوں پر چڑھنے لگے، ”ہم نے یَاہوِہ کے خِلاف گُناہ کیا ہے۔ البتّہ ہم اُس مقام تک جایٔیں گے جِس کا وعدہ یَاہوِہ نے کیا ہے۔“<verse eid="NUM 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 14:41"/>لیکن مَوشہ نے کہا، ”تُم یَاہوِہ کے حُکم کی خِلاف ورزی کیوں کر رہے ہو؟ تُم اُس میں کامیاب نہ ہوگے! <verse eid="NUM 14:41"/><verse number="42" style="v" sid="NUM 14:42"/>تُم اُوپر نہ چڑھو کیونکہ یَاہوِہ تمہارے ساتھ نہیں ہیں اَور تُم اَپنے دُشمنوں سے شِکست کھاؤگے، <verse eid="NUM 14:42"/><verse number="43" style="v" sid="NUM 14:43"/>کیونکہ وہاں عمالیقیوں اَور کنعانیوں سے تمہارا سامنا ہوگا اَور چونکہ تُم یَاہوِہ سے برگشتہ ہو گئے ہو وہ تمہارے ساتھ نہ ہوں گے اَور تُم تلوار سے مارے جاؤگے۔“<verse eid="NUM 14:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 14:44"/>تاہم وہ جَسارت کرکے کوہستانی مُلک کی پہاڑیوں پر چڑھنے لگے اَور مَوشہ اَور یَاہوِہ کے عہد کا صندُوق چھاؤنی میں ہی پڑا رہا۔ <verse eid="NUM 14:44"/><verse number="45" style="v" sid="NUM 14:45"/>تَب عمالیقی اَور کنعانی جو اُس کوہستانی مُلک میں رہتے تھے نیچے اُتر آئے اَور اُن پر ٹوٹ پڑے اَور حُرمہؔ تک اُن کو مارتے چلے گیٔے۔<verse eid="NUM 14:45"/></para>
  <chapter eid="NUM 14"/>
  <chapter number="15" style="c" sid="NUM 15"/>
  <para style="s1">مزید قُربانیاں</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 15:1"/>یَاہوِہ نے مَوشہ سے فرمایا، <verse eid="NUM 15:1"/><verse number="2" style="v" sid="NUM 15:2"/>”بنی اِسرائیل سے مُخاطِب ہو اَور اُن سے فرما، ’جَب تُم اُس مُلک میں داخل ہو جاؤ جو میں تُمہیں رہنے کے لیٔے دے رہا ہُوں <verse eid="NUM 15:2"/><verse number="3" style="v" sid="NUM 15:3"/>اَور تُم یَاہوِہ کے لیٔے گائے بَیل یا بھیڑ بکریوں کی آتِشی قُربانیاں اَور اناج کی نذریں پیش کرو جو یَاہوِہ کے لیٔے فرحت بخش خُوشبو ہُوں۔ خواہ وہ سوختنی نذریں یا کسی خاص مَنّت کے ذبیحے، رضا کی قُربانیاں یا عیدوں کی قُربانیاں ہُوں۔ <verse eid="NUM 15:3"/><verse number="4" style="v" sid="NUM 15:4"/>تو جو شخص اَپنا نذرانہ لایٔے وہ یَاہوِہ کے حُضُور چوتھائی ہین<note caller="+" style="f"><char style="fr" closed="false">15‏:4 </char><char style="fq" closed="false">چوتھائی ہین </char><char style="ft" closed="false">تقریباً ایک لیٹر</char></note> تیل مِلا ہُوا ایفہ کا دسواں حِصّہ<note caller="+" style="f"><char style="fr" closed="false">15‏:4 </char><char style="fq" closed="false">ایفہ کا دسواں حِصّہ </char><char style="ft" closed="false">تقریباً ایک کِلو چھ سَو گرام</char></note> مَیدہ اناج کی قُربانی کے طور پر گذرانے۔ <verse eid="NUM 15:4"/><verse number="5" style="v" sid="NUM 15:5"/>اَور سوختنی نذر کے ہر برّہ یا ذبیحہ کے پیچھے چوتھائی ہین مَے تپاون کے طور پر تیّار کرے۔<verse eid="NUM 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 15:6"/>” ’ہر مینڈھے کے ساتھ تہائی ہین<note caller="+" style="f"><char style="fr" closed="false">15‏:6 </char><char style="fq" closed="false">تہائی ہین </char><char style="ft" closed="false">تقریباً 1.3 لیٹر</char></note> تیل مِلا ہُوا ایفہ کا پانچواں حِصّہ<note caller="+" style="f"><char style="fr" closed="false">15‏:6 </char><char style="fq" closed="false">ایفہ کا پانچواں حِصّہ </char><char style="ft" closed="false">تقریباً تین کِلو دو سو گرام</char></note> مَیدہ اناج کی قُربانی کے طور پر، <verse eid="NUM 15:6"/><verse number="7" style="v" sid="NUM 15:7"/>اَور تہائی ہین مَے تپاون کے طور پر تیّار کرنا۔ اِسے یَاہوِہ کے حُضُور فرحت بخش خُوشبو کے طور پر پیش کرنا۔<verse eid="NUM 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 15:8"/>” ’جَب تُو یَاہوِہ کے حُضُور سوختنی نذر یا خاص مَنّت کے ذبیحے یا سلامتی کی نذر کے ذبیحہ کے طور پر بچھڑا تیّار کرے <verse eid="NUM 15:8"/><verse number="9" style="v" sid="NUM 15:9"/>تو اُس بچھڑے کے ساتھ نِصف ہین تیل<note caller="+" style="f"><char style="fr" closed="false">15‏:9 </char><char style="fq" closed="false">نِصف ہین تیل </char><char style="ft" closed="false">تقریباً 1.9 لیٹر</char></note> مِلا ہُوا ایفہ کے تین دہائی<note caller="+" style="f"><char style="fr" closed="false">15‏:9 </char><char style="fq" closed="false">ایفہ کے تین دہائی </char><char style="ft" closed="false">تقریباً پانچ کِلوگرام</char></note> حِصّہ کے برابر مَیدہ اناج کی قُربانی کے طور پر، <verse eid="NUM 15:9"/><verse number="10" style="v" sid="NUM 15:10"/>اَور نِصف ہین مَے تپاون کے طور پر بھی لانا۔ یہ یَاہوِہ کے حُضُور غِذا کی فرحت بخش خُوشبو والی آتِشی قُربانی ہوگی۔ <verse eid="NUM 15:10"/><verse number="11" style="v" sid="NUM 15:11"/>ہر بَیل یا مینڈھا اَور ہر برّہ یا بکرا اِسی طرح تیّار کیا جائے۔ <verse eid="NUM 15:11"/><verse number="12" style="v" sid="NUM 15:12"/>تُم جتنے بھی جانور تیّار کرو ہر ایک کے ساتھ اَیسا ہی کرنا۔<verse eid="NUM 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 15:13"/>” ’ہر ایک اِسرائیلی باشِندہ جَب یَاہوِہ کے حُضُور فرحت بخش خُوشبو کے طور پر آتِشی قُربانی پیش کر دے تو وہ یہ سَب کام اِسی طریقہ سے کیا کرے۔ <verse eid="NUM 15:13"/><verse number="14" style="v" sid="NUM 15:14"/>آنے والی پُشتوں میں جَب کبھی کویٔی پردیسی یا کسی اَور شخص جو تمہارے ساتھ بُودوباش کرتا ہو یَاہوِہ کے حُضُور فرحت بخش خُوشبو کے طور پر غِذا کی آتِشی قُربانی پیش کرے تو وہ بھی ہُوبہو وَیسا ہی کرے جَیسا تُم کرتے ہو۔ <verse eid="NUM 15:14"/><verse number="15" style="v" sid="NUM 15:15"/>جماعت میں تمہارے لیٔے اَور تمہارے ساتھ رہنے والے پردیسی کے لیٔے ایک سے فرمان ہُوں اَور پُشت در پُشت یہ دائمی فرمان ہمیشہ کے لیٔے رہے گا۔ یَاہوِہ کے آگے تُم اَور پردیسی برابر ہیں۔ <verse eid="NUM 15:15"/><verse number="16" style="v" sid="NUM 15:16"/>تمہارے لیٔے اَور تمہارے درمیان رہنے والے پردیسیوں کے لیٔے ایک ہی آئین اَور طریقے ہوں گے۔‘ “<verse eid="NUM 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 15:17"/>یَاہوِہ نے مَوشہ سے فرمایا، <verse eid="NUM 15:17"/><verse number="18" style="v" sid="NUM 15:18"/>”بنی اِسرائیل سے مُخاطِب ہو اَور اُن سے فرما: جَب تُم اُس مُلک میں داخل ہو جاؤ، جہاں میں تُمہیں لیٔے جاتا ہُوں <verse eid="NUM 15:18"/><verse number="19" style="v" sid="NUM 15:19"/>اَور تُم اُس مُلک کی پیداوار میں سے کھاؤ تو اُس کا کچھ حِصّہ یَاہوِہ کے لیٔے نذر کرنا۔ <verse eid="NUM 15:19"/><verse number="20" style="v" sid="NUM 15:20"/>اَپنے پہلے گوندھے ہویٔے آٹے کی ایک روٹی پیش کرنا اَور اُسے کھلیان کے نذرانہ کے طور پر گذراننا۔ <verse eid="NUM 15:20"/><verse number="21" style="v" sid="NUM 15:21"/>تمہاری آنے والی پُشتیں اَپنے پہلے گوندھے ہویٔے آٹے میں سے یَاہوِہ کے لیٔے یہ نذرانہ دیا کریں۔<verse eid="NUM 15:21"/></para>
  <para style="s1">غَیر اِرادتاً سرزد گُناہوں کی قُربانیاں</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 15:22"/>” ’اگر تُم غَیر اِرادتاً یَاہوِہ کے مَوشہ کو دئیے ہویٔے اِن اَحکام میں سے کسی پر عَمل نہ کرو، <verse eid="NUM 15:22"/><verse number="23" style="v" sid="NUM 15:23"/>یعنی جِس دِن سے یَاہوِہ نے حُکم دینا شروع کیا تَب سے تمام اَحکام جو یَاہوِہ نے آنے والی پُشتوں کے لیٔے مَوشہ کی مَعرفت دئیے۔ <verse eid="NUM 15:23"/><verse number="24" style="v" sid="NUM 15:24"/>اَور اگر یہ غَیر اِرادتاً ہُوا ہو اَور جماعت کو اُس کا علم نہ ہو تو ساری جماعت ایک بچھڑا سوختنی نذر کے طور پر پیش کرے تاکہ وہ یَاہوِہ کے حُضُور فرحت بخش خُوشبو ہو اَور اُس کے ساتھ آئین کے مُطابق اُس کی اناج کی قُربانی اَور اُس کا تپاون<note caller="+" style="f"><char style="fr" closed="false">15‏:24 </char><char style="fq" closed="false">تپاون </char><char style="ft" closed="false">انگوری شِیرہ بھی ہو سکتا ہے</char></note> بھی چڑھائے اَور گُناہ کی قُربانی کے طور پر ایک بکرا پیش کرے۔ <verse eid="NUM 15:24"/><verse number="25" style="v" sid="NUM 15:25"/>یُوں کاہِنؔ بنی اِسرائیل کی ساری جماعت کے لیٔے کفّارہ دے اَور وہ بخش دئیے جایٔیں گے کیونکہ یہ خطا دانستہ طور پر نہیں ہُوئی تھی اَور اُنہُوں نے اَپنی خطا کے عِوض یَاہوِہ کے حُضُور آتِشی قُربانی اَور گُناہ کی قُربانی پیش کر دی تھی۔ <verse eid="NUM 15:25"/><verse number="26" style="v" sid="NUM 15:26"/>تَب بنی اِسرائیل کی ساری جماعت اَور اُن کے ساتھ رہنے والے پردیسی مُعاف کئے جایٔیں گے کیونکہ سبھی لوگ اِس نادانستہ خطا میں شریک تھے۔<verse eid="NUM 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 15:27"/>” ’لیکن اگر صِرف ایک ہی شخص غَیر اِرادتاً گُناہ کرے تو وہ یک سالہ بکری گُناہ کی قُربانی کے طور پر پیش کرے <verse eid="NUM 15:27"/><verse number="28" style="v" sid="NUM 15:28"/>اَور کاہِنؔ غَیر اِرادتاً گُناہ کرنے والے کی خاطِر یَاہوِہ کے حُضُور میں کفّارہ دے اَور جَب اُس کے لیٔے کفّارہ دے دیا جائے گا تو وہ مُعافی پایٔےگا۔ <verse eid="NUM 15:28"/><verse number="29" style="v" sid="NUM 15:29"/>غَیر اِرادتاً گُناہ کرنے والے ہر شخص کے لیٔے ایک ہی آئین ہو خواہ وہ مُلک اِسرائیل کا باشِندہ ہو یا غَیراِسرائیلی۔<verse eid="NUM 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 15:30"/>” ’لیکن جو شخص جان بوجھ کر گُناہ کرے خواہ وہ مُلک اِسرائیل کا باشِندہ ہو یا غَیراِسرائیلی ہو وہ یَاہوِہ کی اہانت کرتا ہے اَور وہ شخص اَپنے لوگوں میں سے کاٹ ڈالا جائے۔ <verse eid="NUM 15:30"/><verse number="31" style="v" sid="NUM 15:31"/>چونکہ اُس نے یَاہوِہ کے کلام کی تحقیر کی اَور اُن کی حُکم عُدولی کی اِس لیٔے وہ شخص ضروُر کاٹ ڈالا جائے۔ اُس کا گُناہ اُسی کے سَر لگے گا۔‘ “<verse eid="NUM 15:31"/></para>
  <para style="s1">سَبت توڑنے والوں کو سزائے موت</para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 15:32"/>جَب بنی اِسرائیل بیابان میں رہتے تھے تَب ایک شخص سَبت کے دِن لکڑیاں جمع کرتا ہُوا پایا گیا۔ <verse eid="NUM 15:32"/><verse number="33" style="v" sid="NUM 15:33"/>جنہوں نے اُسے لکڑیاں جمع کرتے ہویٔے پایاتھا وہ اُسے مَوشہ اَور اَہرونؔ اَور ساری جماعت کے پاس لے آئے <verse eid="NUM 15:33"/><verse number="34" style="v" sid="NUM 15:34"/>اَور اُنہُوں نے اُسے حِراست میں رکھا کیونکہ یہ واضح نہ تھا کہ اُس کے ساتھ کیا سلُوک کیا جائے۔ <verse eid="NUM 15:34"/><verse number="35" style="v" sid="NUM 15:35"/>تَب یَاہوِہ نے مَوشہ سے فرمایا، ”یہ آدمی مار ڈالا جائے۔ ساری جماعت چھاؤنی کے باہر اُسے سنگسار کرے۔“ <verse eid="NUM 15:35"/><verse number="36" style="v" sid="NUM 15:36"/>چنانچہ جَیسا یَاہوِہ نے مَوشہ کو حُکم دیا تھا اُسی کے مُطابق جماعت نے اُسے چھاؤنی کے باہر لے جا کر سنگسار کیا اَور وہ مَر گیا۔<verse eid="NUM 15:36"/></para>
  <para style="s1">کُرتوں کے کناروں پر جھالریں لگانا</para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 15:37"/>یَاہوِہ نے مَوشہ سے کہا، <verse eid="NUM 15:37"/><verse number="38" style="v" sid="NUM 15:38"/>”بنی اِسرائیل سے مُخاطِب ہو اَور اُن سے کہہ کہ وہ پُشت در پُشت اَپنے کُرتوں کے کناروں پر جھالریں لگائیں اَور ہر جھالر پر ایک نیلا ڈورا ٹانکیں۔ <verse eid="NUM 15:38"/><verse number="39" style="v" sid="NUM 15:39"/>یہ جھالریں اَیسی ہُوں کہ جَب اُن پر تمہاری نگاہ پڑے تو یَاہوِہ کے سَب اَحکام تُمہیں یاد آئیں تاکہ تُم اُن پر عَمل کرو اَور اَپنے دِل اَور آنکھوں کی خواہشوں کی پیروی میں کویٔی فاحِشہ حرکت نہ کر بیٹھو۔ <verse eid="NUM 15:39"/><verse number="40" style="v" sid="NUM 15:40"/>تَب تُم یاد کرکے میرے سَب حُکموں پر عَمل کروگے اَور اَپنے خُدا کے واسطے مُقدّس ہوگے۔ <verse eid="NUM 15:40"/><verse number="41" style="v" sid="NUM 15:41"/>مَیں یَاہوِہ تمہارا خُدا ہُوں جو تُمہیں مِصر سے نکال لایا تاکہ تمہارا خُدا ٹھہروں۔ مَیں یَاہوِہ تمہارا خُدا ہُوں۔“<verse eid="NUM 15:41"/></para>
  <chapter eid="NUM 15"/>
  <chapter number="16" style="c" sid="NUM 16"/>
  <para style="s1">قورحؔ داتنؔ اَور ابیرامؔ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 16:1"/>قورحؔ جو لیوی کا پرپوتا قُہات کا پوتا اَور اِضہاؔر کا بیٹا تھا اِلیابؔ کے بیٹوں داتنؔ اَور ابیرامؔ اَور پِلیتھ کے بیٹے اَونؔ جَیسے چند بنی رُوبِنؔ کے ساتھ مِل کر گستاخی کر بیٹھے۔ <verse eid="NUM 16:1"/><verse number="2" style="v" sid="NUM 16:2"/>وہ مَوشہ کے خِلاف اُٹھ کھڑے ہویٔے۔ بنی اِسرائیل میں سے ڈھائی سَو لوگ اُن کے ساتھ تھے جو جماعت کے نامور سردار اَور مجلس کے نامزد رُکن تھے۔ <verse eid="NUM 16:2"/><verse number="3" style="v" sid="NUM 16:3"/>وہ مَوشہ اَور اَہرونؔ کی مُخالفت کرنے کے لئے ایک گِروہ کی طور پر اِکٹھّے ہوکر اُن سے کہنے لگے، ”تُم حَد سے بڑھ چُکے ہو! ساری جماعت اَور اُس کا ہر ایک فرد مُقدّس ہے اَور یَاہوِہ اُن کے ساتھ ہیں۔ پھر تُم یَاہوِہ کی جماعت میں اَپنے آپ کو کیوں بالاتر رکھتے ہیں؟“<verse eid="NUM 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 16:4"/>جَب مَوشہ نے یہ باتیں سُنی تو وہ اَپنے مُنہ کے بَل گرا۔ <verse eid="NUM 16:4"/><verse number="5" style="v" sid="NUM 16:5"/>تَب اُس نے قورحؔ اَور اُس کے تمام پیروکاروں سے کہا: ”کل صُبح کے وقت یَاہوِہ صَاف ظاہر کر دیں گے کہ کون اُن کا ہے اَور کون مُقدّس ہے اَور وہ اُس شخص کو اَپنے قریب آنے دیں گے۔ جسے وہ آپ نے آپ مُنتخب کریں گے اُسے وہ اَپنی قربت بھی بخشیں گے۔ <verse eid="NUM 16:5"/><verse number="6" style="v" sid="NUM 16:6"/>لہٰذا اَے قورحؔ! تُم اَور تمہارے تمام پیروکار اَپنا اَپنا بخُوردان لیں <verse eid="NUM 16:6"/><verse number="7" style="v" sid="NUM 16:7"/>اَور کل اُن میں آگ رکھ کر تُم یَاہوِہ کے حُضُور بخُور جَلاؤ۔ تَب جِس شخص کو یَاہوِہ مُنتخب کریں وُہی مُقدّس ٹھہرے گا۔ اَے لیویو! تُم حَد سے زِیادہ بڑھ گیٔے ہو!“<verse eid="NUM 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 16:8"/>مَوشہ نے قورحؔ سے یہ بھی کہا، ”اَے لیویو سُنو! <verse eid="NUM 16:8"/><verse number="9" style="v" sid="NUM 16:9"/>کیا تمہارے لیٔے یہ کافی نہیں کہ اِسرائیل کے خُدا نے تُمہیں بنی اِسرائیل کی جماعت سے الگ کرکے اَپنی قربت میں لیا ہے تاکہ تُم یَاہوِہ کے مَسکن کی خدمت کرو اَور جماعت کے سامنے کھڑے ہوکر اُس کی بھی خدمت بجا لاؤ۔ <verse eid="NUM 16:9"/><verse number="10" style="v" sid="NUM 16:10"/>اِس طرح یَاہوِہ نے تُمہیں اَور تمہارے سَب لیوی بھائیوں کو بھی اَپنی قربت میں لے آئے، لیکن اَب تُم کہانت بھی حاصل کرنا چاہتے ہو۔ <verse eid="NUM 16:10"/><verse number="11" style="v" sid="NUM 16:11"/>دراصل وہ یَاہوِہ ہی ہیں جِس کے خِلاف تُم اَور تمہارے سَب پیروکار اِکٹھّے ہو گئے ہو۔ اَہرونؔ کون ہے، جو تُم اُس کے خِلاف بُڑبُڑاتے ہو؟“<verse eid="NUM 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 16:12"/>تَب مَوشہ نے اِلیابؔ کے بیٹوں داتنؔ اَور ابیرامؔ کو بُلوا بھیجا لیکن اُنہُوں نے کہا، ”ہم نہیں آتے! <verse eid="NUM 16:12"/><verse number="13" style="v" sid="NUM 16:13"/>کیا یہ کافی نہیں کہ تُم ہمیں ایک اَیسے مُلک سے جِس میں دُودھ اَور شہد بہتا ہے، اِس لیٔے نکال لائے ہو، ہمیں بیابان میں مار ڈالو؟ اَب تُم حاکم بَن کر ہم پر اِختیار بھی جتاتے ہو؟ <verse eid="NUM 16:13"/><verse number="14" style="v" sid="NUM 16:14"/>اِس کے علاوہ تُم نے ہمیں اُس مُلک میں بھی نہیں پہُنچایا جہاں دُودھ اَور شہد بہتا ہے اَور نہ ہمیں کھیتوں اَور تاکستانوں کا وارِث بنایا۔ کیا تُم اُن لوگوں کے ساتھ غُلام جَیسا برتاؤ کرنا چاہتے ہو؟ نہیں، ہم نہیں آئیں گے!“<verse eid="NUM 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 16:15"/>تَب مَوشہ بےحد غُصّہ ہُوا اَور یَاہوِہ سے کہنے لگے، ”اُن کا ہدیہ قبُول نہ کرنا۔ مَیں نے اُن سے ایک گدھا بھی نہیں لیا نہ اُن میں سے کسی کو کویٔی نُقصان پہُنچایا ہے۔“<verse eid="NUM 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 16:16"/>پھر مَوشہ نے قورحؔ سے کہا، ”کل تُم اَپنے سَب پیروکاروں کو ساتھ لے کر یَاہوِہ کے آگے حاضِر ہو۔ تُم، اَور تمہارے وہ لوگ اَور اَہرونؔ بھی۔ <verse eid="NUM 16:16"/><verse number="17" style="v" sid="NUM 16:17"/>ہر شخص اَپنا اَپنا بخُوردان لے اَور اُس میں بخُور ڈالے اَور اُسے یَاہوِہ کے حُضُور پیش کرے۔ کُل ڈھائی سَو بخُوردان ہوں۔ تُم اَور اَہرونؔ بھی اَپنا اَپنا بخُوردان پیش کرنا۔“ <verse eid="NUM 16:17"/><verse number="18" style="v" sid="NUM 16:18"/>چنانچہ سارے آدمی اَپنا اَپنا بخُوردان لے کر اُن میں آگ اَور بخُور ڈال کر مَوشہ اَور اَہرونؔ کے ساتھ خیمہ اِجتماع کے دروازہ پر آ کھڑے ہویٔے۔ <verse eid="NUM 16:18"/><verse number="19" style="v" sid="NUM 16:19"/>جَب قورحؔ نے اَپنے سارے فریق والوں کو اُن کے خِلاف خیمہ اِجتماع کے دروازہ پر جمع کیا تو یَاہوِہ کا جلال ساری جماعت کے سامنے ظاہر ہُوا۔ <verse eid="NUM 16:19"/><verse number="20" style="v" sid="NUM 16:20"/>یَاہوِہ نے مَوشہ اَور اَہرونؔ سے کہا: <verse eid="NUM 16:20"/><verse number="21" style="v" sid="NUM 16:21"/>”اَپنے آپ کو اِس جماعت سے الگ کر لو تاکہ میں پل بھر میں اُن کا خاتِمہ کر دُوں۔“<verse eid="NUM 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 16:22"/>لیکن مَوشہ اَور اَہرونؔ مُنہ کے بَل گِر کر کہنے لگے، ”اَے خُدا! اَے بنی نَوع اِنسان کی رُوحوں کے خُدا! کیا آپ ساری جماعت پر اَپنا قہر نازل کریں گے جَب کہ صِرف ایک آدمی نے گُناہ کیا ہے؟“<verse eid="NUM 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 16:23"/>تَب یَاہوِہ نے مَوشہ سے کہا: <verse eid="NUM 16:23"/><verse number="24" style="v" sid="NUM 16:24"/>”اِس جماعت سے کہہ، ’وہ قورحؔ داتنؔ اَور ابیرامؔ کے خیموں کے آس پاس سے ہٹ جائے۔‘ “<verse eid="NUM 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 16:25"/>مَوشہ اُٹھ کر داتنؔ اَور ابیرامؔ کی طرف گیا اَور اِسرائیل کے بُزرگ اُس کے پیچھے پیچھے گیٔے۔ <verse eid="NUM 16:25"/><verse number="26" style="v" sid="NUM 16:26"/>اُس نے جماعت کو آگاہ کیا، ”اِن بدکار آدمیوں کے خیموں کے پاس سے پیچھے ہٹ جاؤ اَور اُن کی کسی چیز کو نہ چھوؤ۔ کہیں اَیسا نہ ہو کہ تُم بھی اُن کے سَب گُناہوں کے باعث برباد ہو جاؤ۔“ <verse eid="NUM 16:26"/><verse number="27" style="v" sid="NUM 16:27"/>چنانچہ وہ قورحؔ، داتنؔ اَور ابیرامؔ کے خیموں کے آس پاس سے ہٹ گیٔے۔ لیکن داتنؔ اَور ابیرامؔ باہر نکل آئے اَور اَپنی بیویوں اَور چُھوٹے بچّوں کے ساتھ اَپنے اَپنے خیموں کے دروازوں پر کھڑے ہو گئے۔<verse eid="NUM 16:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 16:28"/>تَب مَوشہ نے کہا، ”اِس سے تُم جان لوگے کہ یَاہوِہ نے مُجھے یہ سَب کام کرنے کے لیٔے بھیجا ہے اَور یہ بھی کہ یہ میرا اَپنا منصُوبہ نہیں تھا۔ <verse eid="NUM 16:28"/><verse number="29" style="v" sid="NUM 16:29"/>اگر یہ اِنسان قُدرتی موت مَریں اَور اُن کے ساتھ وُہی ہو جو سَب لوگوں کے ساتھ ہُوا کرتا ہے تو میں یَاہوِہ کا بھیجا ہُوا نہیں ہُوں۔ <verse eid="NUM 16:29"/><verse number="30" style="v" sid="NUM 16:30"/>لیکن اگر یَاہوِہ کویٔی انوکھا کرشمہ دِکھائیں اَور زمین اَپنا مُنہ کھول دے اَور اُنہیں اَور اُن کا سَب کچھ نگل جائے اَور وہ زندہ ہی قبر میں سما جایٔیں تَب تُم جان لوگے کہ اِن لوگوں نے خُدا کی تحقیر کی ہے۔“<verse eid="NUM 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 16:31"/>جوں ہی اُس نے یہ باتیں ختم کیں اُن کے قدموں کے نیچے کی زمین پھٹ گئی <verse eid="NUM 16:31"/><verse number="32" style="v" sid="NUM 16:32"/>اَور زمین نے اَپنا مُنہ کھول دیا اَور اُنہیں، اُن کے گھر بار اَور قورحؔ کے یہاں کے سَب آدمیوں کو اَور اُن کے تمام مال و اَسباب کو ہڑپ کر لیا۔ <verse eid="NUM 16:32"/><verse number="33" style="v" sid="NUM 16:33"/>وہ اَپنے تمام مال و اَسباب کے ساتھ زندہ ہی قبر میں جا پڑے اَور زمین اُن کے اُوپر برابر ہو گئی اَور وہ جماعت میں سے نابود ہو گئے۔ <verse eid="NUM 16:33"/><verse number="34" style="v" sid="NUM 16:34"/>اُن کا چِلّانا سُن کر تمام اِسرائیلی جو اُن کے آس پاس تھے وہ یہ کہتے ہویٔے بھاگ نکلے، ”زمین ہمیں بھی نگل لے گی!“<verse eid="NUM 16:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 16:35"/>تَب یَاہوِہ کے پاس سے آگ نکلی اَور اُن ڈھائی سَو آدمیوں کو بھسم کر گئی جو بخُور چڑھا رہے تھے۔<verse eid="NUM 16:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 16:36"/>یَاہوِہ نے مَوشہ سے کہا: <verse eid="NUM 16:36"/><verse number="37" style="v" sid="NUM 16:37"/>”اَہرونؔ کاہِنؔ کے بیٹے الیعزرؔ سے کہہ کہ وہ بخُوردانوں کو جھلستے ہویٔے انبار میں سے نکال لے اَور اَنگاروں کو کچھ فاصلہ پر بِکھیر دے کیونکہ وہ بخُوردان مُقدّس ہیں۔ <verse eid="NUM 16:37"/><verse number="38" style="v" sid="NUM 16:38"/>وہ اُن آدمیوں کے بخُوردان ہیں جنہوں نے اَپنی ہی جان سے دُشمنی کرکے گُناہ کیا تھا۔ اُن بخُوردانوں کو پِیٹ پِیٹ کر پترے بنالو تاکہ وہ مذبح پر منڈھے جایٔیں کیونکہ اُنہیں یَاہوِہ کے حُضُور رکھا گیا تھا۔ اِس لیٔے وہ پاک ہیں۔ وہ بنی اِسرائیل کے لیٔے ایک نِشان ٹھہریں گے۔“<verse eid="NUM 16:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 16:39"/>چنانچہ الیعزرؔ کاہِنؔ نے وہ کانسے کے بخُوردان بٹور لئے جنہیں وہ لوگ لے کر آئےتھے جو بعد کو بھسم کر دیئے گیٔے تھے اَور اُس نے اُن بخُوردانوں کو پِٹوا کر اُن کے پترے بنوائے تاکہ اُن سے مذبح کو منڈھا جائے۔ <verse eid="NUM 16:39"/><verse number="40" style="v" sid="NUM 16:40"/>جَیسا کہ یَاہوِہ نے مَوشہ کی مَعرفت حُکم دیا تھا یہ بنی اِسرائیل کو جتانے کے لیٔے تھا کہ اَہرونؔ کی نَسل کے علاوہ کویٔی غَیر شخص بخُور جَلانے کے لیٔے یَاہوِہ کے حُضُور نہ جائے تاکہ اَیسا نہ ہو کہ اُس کا اَنجام بھی قورحؔ اَور اُس کے فریق والوں کی طرح ہو۔<verse eid="NUM 16:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 16:41"/>دُوسرے دِن بنی اِسرائیل کی ساری جماعت یہ کہہ کر مَوشہ اَور اَہرونؔ کے خِلاف بُڑبُڑانے لگی، ”تُم نے یَاہوِہ کے لوگوں کو مار ڈالا ہے۔“<verse eid="NUM 16:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 16:42"/>لیکن جَب وہ جماعت مَوشہ اَور اَہرونؔ کے خِلاف جمع ہو رہی تھی تو اُنہُوں نے خیمہ اِجتماع کی طرف نگاہ کی کہ اَچانک ایک بادل اُن پر چھا گیا اَور یَاہوِہ کا جلال ظاہر ہُوا۔ <verse eid="NUM 16:42"/><verse number="43" style="v" sid="NUM 16:43"/>تَب مَوشہ اَور اَہرونؔ خیمہ اِجتماع کے سامنے آئے، <verse eid="NUM 16:43"/><verse number="44" style="v" sid="NUM 16:44"/>اَور یَاہوِہ نے مَوشہ سے کہا: <verse eid="NUM 16:44"/><verse number="45" style="v" sid="NUM 16:45"/>”اِس جماعت کے بیچ سے ہٹ جاؤ تاکہ میں فوراً اُن کا خاتِمہ کر دُوں۔“ تَب وہ مُنہ کے بَل گِرے۔<verse eid="NUM 16:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 16:46"/>تَب مَوشہ نے اَہرونؔ سے کہا، ”اَپنا بخُوردان لے اُس میں مذبح پر سے آگ لے کر رکھ اَور اُس پر بخُور ڈال اَور جلدی سے جماعت کے پاس جا کر اُن کے لیٔے کفّارہ دے کیونکہ یَاہوِہ کی طرف سے قہر نازل ہُواہے اَور وَبا شروع ہو چُکی ہے۔“ <verse eid="NUM 16:46"/><verse number="47" style="v" sid="NUM 16:47"/>چنانچہ اَہرونؔ نے مَوشہ کے کہنے کے مُطابق کیا اَور وہ دَوڑتا ہُوا جماعت کے درمیان گیا۔ حالانکہ لوگوں میں وَبا پھیل چُکی تھی تو بھی اَہرونؔ نے بخُور جَلایا اَور اُن کے لیٔے کفّارہ دیا۔ <verse eid="NUM 16:47"/><verse number="48" style="v" sid="NUM 16:48"/>اَور وہ مُردوں اَور زندوں کے درمیان کھڑا ہُوا اَور وَبا رُک گئی۔ <verse eid="NUM 16:48"/><verse number="49" style="v" sid="NUM 16:49"/>اَور قورحؔ کی وجہ سے مَرے ہویٔے لوگوں کے علاوہ مزید چودہ ہزار سات سَو لوگ وَبا سے مَر گیٔے۔ <verse eid="NUM 16:49"/><verse number="50" style="v" sid="NUM 16:50"/>تَب اَہرونؔ لَوٹ کر خیمہ اِجتماع کے دروازہ پر مَوشہ کے پاس آیا کیونکہ وَبا موقُوف ہو چُکی تھی۔<verse eid="NUM 16:50"/></para>
  <chapter eid="NUM 16"/>
  <chapter number="17" style="c" sid="NUM 17"/>
  <para style="s1">اَہرونؔ کا عصا</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 17:1"/>یَاہوِہ نے مَوشہ سے کہا: <verse eid="NUM 17:1"/><verse number="2" style="v" sid="NUM 17:2"/>”بنی اِسرائیل سے مُخاطِب ہو اَور اُن کے آبائی قبیلوں کے سرداروں سے فی کس ایک عصا کے حِساب سے بَارہ عصے لیٔے جایٔیں اَور ہر آدمی کا نام اُس کے عصا پر لِکھّا جائے۔ <verse eid="NUM 17:2"/><verse number="3" style="v" sid="NUM 17:3"/>لیوی کے عصا پر اَہرونؔ کا نام لِکھنا کیونکہ ہر آبائی قبیلہ کے سردار کے لیٔے ایک عصا ہوگا <verse eid="NUM 17:3"/><verse number="4" style="v" sid="NUM 17:4"/>اَور اُنہیں خیمہ اِجتماع میں عہد کے صندُوق کے سامنے جہاں میں تُم سے مُلاقات کرتا ہُوں رکھ دیں۔ <verse eid="NUM 17:4"/><verse number="5" style="v" sid="NUM 17:5"/>اَور جِس شخص کو میں چُنوں گا اُس کے عصا میں سے کونپلیں پھوٹ نکلیں گی اَور مَیں بنی اِسرائیل کے تمہارے خِلاف مُتواتر بُڑبُڑانے سے چھُٹکارا پاؤں گا۔“<verse eid="NUM 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 17:6"/>چنانچہ مَوشہ نے بنی اِسرائیل سے گُفتگو کی اَور اُن کے سرداروں نے ہر آبائی قبیلہ کے سردار کے پیچھے ایک عصا کے حِساب سے بَارہ عصے اُسے دئیے اَور اَہرونؔ کا عصا بھی اُن میں تھا۔ <verse eid="NUM 17:6"/><verse number="7" style="v" sid="NUM 17:7"/>مَوشہ نے سارے عصے لے کر عہد کا خیمہ میں یَاہوِہ کے حُضُور رکھ دئیے۔<verse eid="NUM 17:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 17:8"/>دُوسرے دِن جَب مَوشہ عہد کے خیمہ میں داخل ہُوا تو دیکھا کہ اَہرونؔ کے عصا میں جو لیویوں کے خاندان کی نُمائندگی کرتا تھا نہ صِرف کونپلیں پھوٹی ہُوئی تھیں بَلکہ پھُول بھی کھِلے ہویٔے تھے اَور بادام بھی لگے ہویٔے تھے۔ <verse eid="NUM 17:8"/><verse number="9" style="v" sid="NUM 17:9"/>تَب مَوشہ وہ سارے عصے یَاہوِہ کے حُضُور سے نکال کر تمام بنی اِسرائیل کے پاس لے گئے۔ اُنہُوں نے اُنہیں دیکھا اَور ہر آدمی نے اَپنا اَپنا عصا لے لیا۔<verse eid="NUM 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 17:10"/>یَاہوِہ نے مَوشہ سے کہا، ”اَہرونؔ کے عصا کو عہد کے صندُوق کے آگے پھر رکھ دیں تاکہ وہ اُن باغیوں کے لیٔے ایک نِشان کے طور پر رکھا رہے۔ اِس سے اُن کا میرے خِلاف بُڑبُڑانا ختم ہو جائے گا تاکہ وہ مَر نہ جایٔیں۔“ <verse eid="NUM 17:10"/><verse number="11" style="v" sid="NUM 17:11"/>مَوشہ نے ٹھیک وَیسا ہی کیا جَیسا یَاہوِہ نے اُسے حُکم دیا تھا۔<verse eid="NUM 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 17:12"/>بنی اِسرائیل نے مَوشہ سے کہا، ”ہم مَر جایٔیں گے۔ ہم کہیں کے نہ رہے۔ ہم سَب کہیں کے نہ رہے۔ <verse eid="NUM 17:12"/><verse number="13" style="v" sid="NUM 17:13"/>اگر کویٔی یَاہوِہ کے مَسکن کے قریب بھی جاتا ہے تو مارا جاتا ہے۔ تو کیا ہم سَب کے سَب مَر جایٔیں گے؟“<verse eid="NUM 17:13"/></para>
  <chapter eid="NUM 17"/>
  <chapter number="18" style="c" sid="NUM 18"/>
  <para style="s1">کاہِنوں اَور لیویوں کی ذمّہ داریاں</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 18:1"/>یَاہوِہ نے اَہرونؔ سے کہا، ”پاک مَقدِس کے خِلاف سرزد ہونے والے گُناہوں کا بار تُم پر، تمہارے بیٹوں اَور تمہارے آبائی خاندان پر ہوگا۔ اَور کہانت کے خِلاف سرزد ہونے والے گُناہوں کا بار صِرف تُم پر اَور تمہارے بیٹوں پر ہوگا۔ <verse eid="NUM 18:1"/><verse number="2" style="v" sid="NUM 18:2"/>جَب تُم اَور تمہارے بیٹے عہد کے خیمہ کے آگے خدمت کریں تو اَپنے آبائی قبیلہ سے اَپنے لیوی بھائیوں کو بھی اَپنے ساتھ لے آیا کریں تاکہ وہ تمہارے ساتھ مِل کر تمہاری مدد کریں۔ <verse eid="NUM 18:2"/><verse number="3" style="v" sid="NUM 18:3"/>وہ تُمہیں جَوابدہ ہوں گے اَور وہ خیمہ کی ساری خدمت اَنجام دیں لیکن وہ پاک مَقدِس کے سازوسامان یا مذبح کے نزدیک نہ جایٔیں۔ کہیں اَیسا نہ ہو کہ وہ اَور تُم دونوں مارے جاؤ۔ <verse eid="NUM 18:3"/><verse number="4" style="v" sid="NUM 18:4"/>وہ تمہارے ساتھ مِل کر خیمہ اِجتماع کی حِفاظت کے ذمّہ دار ہوں گے جِس میں خیمہ کے سَب کام شامل ہیں۔ اَور جہاں تُم ہو وہاں کویٔی دُوسرا نہ آنے پایٔے۔<verse eid="NUM 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 18:5"/>”پاک مَقدِس اَور مذبح کی حِفاظت تُم ہی کرنا تاکہ آئندہ بنی اِسرائیل پر قہر نازل نہ ہو۔ <verse eid="NUM 18:5"/><verse number="6" style="v" sid="NUM 18:6"/>مَیں نے خُود تمہارے لیوی بھائیوں کو بنی اِسرائیل کے درمیان سے تمہاری مدد کے لیٔے مُنتخب کیا ہے اَور اُنہیں یَاہوِہ کے لیٔے وقف کیا ہے تاکہ وہ خیمہ اِجتماع میں خدمت بجا لائیں۔ <verse eid="NUM 18:6"/><verse number="7" style="v" sid="NUM 18:7"/>لیکن مذبح سے تعلّق رکھنے والی ہر چیز کی اَور پردہ کے اَندر کی کہانت کی خدمات صِرف تُم اَور تمہارے بیٹے ہی اَنجام دیں۔ کہانت کی خدمت کا شرف میں تُمہیں بخشتا ہُوں۔ اگر کویٔی اَور پاک مَقدِس کے قریب آ جائے تو وہ جان سے مار ڈالا جائے۔“<verse eid="NUM 18:7"/></para>
  <para style="s1">کاہِنوں اَور لیویوں کے لیٔے ہدیئے</para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 18:8"/>تَب یَاہوِہ نے اَہرونؔ سے کہا، ”مَیں نے خُود تُمہیں اُن نذرانوں کی ذمّہ داری دی ہے جو مُجھے پیش کئے جاتے ہیں۔ جتنے پاک نذرانے بنی اِسرائیل میرے حُضُور پیش کرتے ہیں وہ سَب میں تُمہیں اَور تمہارے بیٹوں کو تمہارے حق میں دائمی حِصّہ کے طور پر دے رہا ہُوں۔ <verse eid="NUM 18:8"/><verse number="9" style="v" sid="NUM 18:9"/>نہایت پاک نذرانوں میں سے جو حِصّہ آگ سے بچایا جائے وہ تمہارا ہوگا۔ وہ نذرانے جنہیں وہ نہایت پاک قُربانیوں کے طور پر مُجھے پیش کرتے ہیں خواہ وہ اناج کی نذر، گُناہ کی قُربانی یا خطا کی قُربانیاں ہُوں سَب تُم اَور تمہارے بیٹوں کے لیٔے ہیں۔ <verse eid="NUM 18:9"/><verse number="10" style="v" sid="NUM 18:10"/>تُم اُن کو نہایت مُقدّس جان کر کھانا۔ صِرف مَرد اُنہیں کھایٔیں۔ اَور تُم اُنہیں پاک ماَننا۔<verse eid="NUM 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 18:11"/>”اَور یہ بھی تمہارا ہوگا: جِتنا نذرانہ بنی اِسرائیل ہلانے کی نذروں کی قُربانی کے لیٔے دیں اُسے میں تُمہیں اَور تمہارے بیٹوں اَور بیٹیوں کو اُن کا حق دائمی حِصّہ کے طور پر دیتا ہُوں اُن کا اَبدی حق مُقرّر کر دے رہا ہُوں۔ تمہارے خاندان کا ہر شخص جو رسماً پاک ہو اُنہیں کھا سَکتا ہے۔<verse eid="NUM 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 18:12"/>”بہترین زَیتُون کا تیل، بہترین نئے انگوری شِیرے اَور اناج جسے وہ اَپنی پہلی فصل کے پہلے پھل کے طور پر یَاہوِہ کو پیش کرتے ہیں وہ سَب میں تُمہیں دیتا ہُوں۔ <verse eid="NUM 18:12"/><verse number="13" style="v" sid="NUM 18:13"/>اَپنے مُلک کا سارا پہلا پھل جسے وہ یَاہوِہ کے لیٔے لائیں تمہارا ہوگا۔ تمہارے خاندان کا ہر شخص جو رسماً پاک ہو اُنہیں کھا سَکتا ہے۔<verse eid="NUM 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 18:14"/>”بنی اِسرائیل کی جو یَاہوِہ کے لیٔے مخصُوص کی ہُوئی ہر شَے تمہاری ہوگی۔ <verse eid="NUM 18:14"/><verse number="15" style="v" sid="NUM 18:15"/>ہر رِحم کا پہلا بچّہ خواہ وہ اِنسان ہو یا حَیوان جو یَاہوِہ کو نذر کیا گیا ہو تمہارا ہے۔ لیکن تُم اِنسان کے پہلوٹھے اَور ناپاک جانوروں کے پہلوٹھے نر بچّوں کو فدیہ لے کر چھوڑ دینا۔ <verse eid="NUM 18:15"/><verse number="16" style="v" sid="NUM 18:16"/>جَب وہ ایک مہینے کے ہُوں تَب تُم اُنہیں اُن کی فدیہ کی مُقرّرہ قیمت لے کر چھوڑا دینا جو پاک مَقدِس کے بیس گِیرہ کی ثاقل کے حِساب سے چاندی کی پانچ ثاقل<note caller="+" style="f"><char style="fr" closed="false">18‏:16 </char><char style="fq" closed="false">پانچ ثاقل </char><char style="ft" closed="false">تقریباً اٹھّاون گرام</char></note> ہوگی۔<verse eid="NUM 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 18:17"/>”لیکن گائے، بھیڑ اَور بکری کے پہلوٹھوں کا فدیہ نہ لینا۔ وہ مُقدّس ہیں۔ تُو اُن کا خُون مذبح پر چھڑکنا اَور اُن کی چربی آتِشی قُربانی کے طور پر جَلا دینا تاکہ وہ یہ یَاہوِہ کے حُضُور غِذا کی فرحت بخش خُوشبو ٹھہرے۔ <verse eid="NUM 18:17"/><verse number="18" style="v" sid="NUM 18:18"/>جِس طرح ہلانے کی نذر کی قُربانی کا سینہ اَور داہنی ران تمہارے ہیں اُسی طرح اُن کا گوشت بھی تمہارا ہوگا۔ <verse eid="NUM 18:18"/><verse number="19" style="v" sid="NUM 18:19"/>بنی اِسرائیل کی یَاہوِہ کو پیش کی ہُوئی مُقدّس قُربانیوں کی نذروں میں سے جو کچھ الگ رکھا جائے اُسے میں تُمہیں اَور تمہارے بیٹوں اَور بیٹیوں کو تمہارے مُقرّرہ حِصّہ کے طور پر دے دیتا ہُوں۔ یہ یَاہوِہ کے حُضُور تمہارے اَور تمہاری نَسل کے لیٔے نمک کا دائمی عہد ہے۔“<verse eid="NUM 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 18:20"/>یَاہوِہ نے اَہرونؔ سے کہا، ”اُن کے مُلک میں تمہاری کویٔی مِیراث نہ ہوگی اَور نہ اُن کے درمیان تمہارا کویٔی حِصّہ ہوگا۔ میں ہی بنی اِسرائیل میں تمہارا حِصّہ اَور تمہاری مِیراث ہُوں۔<verse eid="NUM 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 18:21"/>”اَور مَیں نے لیویوں کو اُس خدمت کے عِوض جو وہ خیمہ اِجتماع میں اَنجام دیتے ہیں اِسرائیل کی ساری دہ یکی مِیراث کے طور پر دی ہے۔ <verse eid="NUM 18:21"/><verse number="22" style="v" sid="NUM 18:22"/>آئندہ بنی اِسرائیل خیمہ اِجتماع کے نزدیک ہرگز نہ آئیں۔ کہیں اَیسا نہ ہو کہ گُناہ اُن کے سَر لگے اَور وہ مَر جایٔیں۔ <verse eid="NUM 18:22"/><verse number="23" style="v" sid="NUM 18:23"/>بَلکہ لیوی ہی خیمہ اِجتماع کی خدمت کریں اَور وُہی اُن کا بارِ گُناہ اُٹھایا کریں۔ یہ آئندہ پُشتوں کے لیٔے دائمی فرمان ہے۔ اَور بنی اِسرائیل کے درمیان اُنہیں کویٔی مِیراث نہ ملے۔ <verse eid="NUM 18:23"/><verse number="24" style="v" sid="NUM 18:24"/>اِس کے عِوض مَیں نے اُس دہ یکی کو جو اِسرائیلی نذر کے طور پر یَاہوِہ کے حُضُور پیش کرتے ہیں لیویوں کی مِیراث قرار دیا ہے۔ اِس لیٔے مَیں نے اُن کے حق میں کہا ہے: ’بنی اِسرائیل کے درمیان اُنہیں کویٔی مِیراث نہ ملے۔‘ “<verse eid="NUM 18:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 18:25"/>یَاہوِہ نے مَوشہ سے کہا، <verse eid="NUM 18:25"/><verse number="26" style="v" sid="NUM 18:26"/>”لیویوں سے مُخاطِب ہو اَور اُن سے کہہ: ’جَب تُم بنی اِسرائیل سے وہ دہ یکی لو جسے میں تُمہیں مِیراث میں دیتا ہُوں تَب تُم اُس دہ یکی کا دسواں حِصّہ یَاہوِہ کے حُضُور میں اُٹھانے کی قُربانی کے نذرانے کے طور پر گذراننا۔ <verse eid="NUM 18:26"/><verse number="27" style="v" sid="NUM 18:27"/>تمہارا یہ نذرانہ تمہارے حق میں کھلیان کے اناج یا مے کے حوض کی طرح سمجھا جائے گا۔ <verse eid="NUM 18:27"/><verse number="28" style="v" sid="NUM 18:28"/>اِس طریقہ سے تُم بھی اَپنی سَب دہ یکیوں میں سے جو تُم بنی اِسرائیل کی طرف سے پاؤگے یَاہوِہ کے حُضُور نذرانہ پیش کرنا۔ اُن دہ یکیوں میں سے یَاہوِہ کا حِصّہ اَہرونؔ کاہِنؔ کو دینا۔ <verse eid="NUM 18:28"/><verse number="29" style="v" sid="NUM 18:29"/>ہر نذرانہ جو تُمہیں دیا جائے اُس کا بہترین اَور مُقدّس حِصّہ یَاہوِہ کے لیٔے مخصُوص کرکے الگ طور پر پیش کیا جائے۔‘<verse eid="NUM 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 18:30"/>”لیویوں سے کہہ: ’جَب تُم بہترین حِصّہ کی قُربانی کے طور پر پیش کروگے تو وہ تمہارے حق میں کھلیان کی پیداوار یا مے کے حوض کے طور پر گِنا جائے گا۔ <verse eid="NUM 18:30"/><verse number="31" style="v" sid="NUM 18:31"/>اَور بقیّہ حِصّہ کو تُم اَور تمہارے خاندان کے لوگ کہیں بھی کھا سکتے ہیں کیونکہ وہ خیمہ اِجتماع میں تمہاری خدمت کا مُعاوضہ ہے۔ <verse eid="NUM 18:31"/><verse number="32" style="v" sid="NUM 18:32"/>اَور تُم اُس میں کا بہترین حِصّہ کی قُربانی کے طور پر دینے سے اِس مُعاملہ میں مُجرم نہ ٹھہروگے۔ تُم بنی اِسرائیل کے مُقدّس نذرانوں کو ہرگز ناپاک نہ کرنا ورنہ مارے جاؤگے۔‘ “<verse eid="NUM 18:32"/></para>
  <chapter eid="NUM 18"/>
  <chapter number="19" style="c" sid="NUM 19"/>
  <para style="s1">ناپاکی دُور کرنے کا پانی</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 19:1"/>یَاہوِہ نے مَوشہ اَور اَہرونؔ سے کہا: <verse eid="NUM 19:1"/><verse number="2" style="v" sid="NUM 19:2"/>”یَاہوِہ نے جِس آئین کا حُکم دیا ہے اُس کا تَقاضا یہ ہے: بنی اِسرائیل سے کہہ دو کہ وہ تمہارے پاس لال رنگ کی ایک بے عیب اَور بے داغ بچھیا لائیں جِس پر کبھی جُوا نہ رکھا گیا ہو۔ <verse eid="NUM 19:2"/><verse number="3" style="v" sid="NUM 19:3"/>پھر تُم اُسے الیعزرؔ کاہِنؔ کو دے دو تاکہ اُسے چھاؤنی کے باہر لے جایا جائے اَور اُس کے سامنے ذبح کیا جائے۔ <verse eid="NUM 19:3"/><verse number="4" style="v" sid="NUM 19:4"/>تَب الیعزرؔ کاہِنؔ اَپنی اُنگلی پر اُس کا کچھ خُون لے لیں اَور اُسے خیمہ اِجتماع کے سامنے کی طرف سات مرتبہ چھڑکنا۔ <verse eid="NUM 19:4"/><verse number="5" style="v" sid="NUM 19:5"/>تَب اُس بچھیا کو اُس کی کھال، گوشت، خُون اَور انتڑیاں سمیت اُس کے سامنے جَلا دیا جائے۔ <verse eid="NUM 19:5"/><verse number="6" style="v" sid="NUM 19:6"/>پھر کاہِنؔ دیودار کی کچھ لکڑی، زُوفا اَور سُرخ رنگ کا اُون لے کر اُس جلتی ہُوئی بچھیا کے اُوپر ڈال دیں۔ <verse eid="NUM 19:6"/><verse number="7" style="v" sid="NUM 19:7"/>اُس کے بعد کاہِنؔ اَپنے کپڑے دھوئے اَور پانی سے غُسل کر لے۔ پھر وہ چھاؤنی میں چلے آئے لیکن شام تک وہ ناپاک رہے گا۔ <verse eid="NUM 19:7"/><verse number="8" style="v" sid="NUM 19:8"/>اَورجو شخص اُسے جَلائے وہ بھی اَپنے کپڑے دھوئے اَور پانی سے غُسل کر لے اَور وہ بھی شام تک ناپاک رہے گا۔<verse eid="NUM 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 19:9"/>”پھر کویٔی پاک شخص اُس بچھیا کی راکھ بٹورے اَور اُسی چھاؤنی کے باہر کسی اَیسی جگہ رکھ چھوڑے جو رسماً پاک ہو۔ بنی اِسرائیل کی جماعت اُسے ناپاکی دُور کرنے کے پانی میں ڈالنے کے لیٔے رکھے۔ اِسے طہارت کے لیٔے اِستعمال کیا جائے۔ <verse eid="NUM 19:9"/><verse number="10" style="v" sid="NUM 19:10"/>جو شخص اِس بچھیا کی راکھ کو بٹورے وہ بھی اَپنے کپڑے دھوئے۔ وہ بھی شام تک ناپاک رہے گا۔ یہ بنی اِسرائیل کے لیٔے اَور اُن کے درمیان رہنے والے پردیسیوں کے لیٔے بھی دائمی فرمان ہوگا۔<verse eid="NUM 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 19:11"/>”جو شخص کسی لاش کو چھُوئے وہ سات دِن تک ناپاک رہے گا۔ <verse eid="NUM 19:11"/><verse number="12" style="v" sid="NUM 19:12"/>وہ شخص اَپنے آپ کو تیسرے دِن اَور ساتویں دِن پانی سے پاک کر لے۔ تَب وہ پاک ہو جائے گا۔ لیکن اگر وہ اَپنے آپ کو تیسرے اَور ساتویں دِن پاک نہ کرے تو وہ پاک نہ ہوگا۔ <verse eid="NUM 19:12"/><verse number="13" style="v" sid="NUM 19:13"/>جو شخص کسی لاش کو چھُوتا ہے اَور اَپنے آپ کو پاک نہیں کر پاتا وہ یَاہوِہ کے خیمہ اِجتماع کو ناپاک کرتا ہے۔ وہ شخص اِسرائیل میں سے کاٹ ڈالا جائے۔ چونکہ ناپاکی دُور کرنے کا پانی اُس پر نہیں چھِڑکا گیا اِس لیٔے وہ ناپاک ہے۔ اُس کی ناپاکی قائِم رہے گی۔<verse eid="NUM 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 19:14"/>”جَب کویٔی شخص خیمہ میں مَر جائے تو اُس پر اِس آئین کا اِطلاق ہوگا: جو کویٔی اُس خیمہ میں داخل ہو یا جو کویٔی اُس میں رہتا ہو وہ سات دِن تک ناپاک رہے گا۔ <verse eid="NUM 19:14"/><verse number="15" style="v" sid="NUM 19:15"/>اَور ہر ایک کھُلا برتن جِس پر کویٔی ڈھکنا نہ ہو ناپاک ٹھہرے گا۔<verse eid="NUM 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 19:16"/>”اَورجو کویٔی میدان میں کسی تلوار سے مارے گیٔے کو یا اُس شخص کو جو طبعی موت مَرا ہو یا اِنسان کی ہڈّی کو یا کسی قبر کو چھُوئے وہ سات دِن تک ناپاک رہے گا۔<verse eid="NUM 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 19:17"/>”ناپاک شخص کے لیٔے اُس جلی ہُوئی گُناہ کی قُربانی کی کچھ راکھ کسی مرتبان میں لے کر اُس پر تازہ پانی ڈال دو۔ <verse eid="NUM 19:17"/><verse number="18" style="v" sid="NUM 19:18"/>تَب کویٔی آدمی جو رسماً پاک ہو زُوفا لے اَور اُسے اُس پانی میں ڈُبو کر اُس خیمہ پر اَور سَب سازوسامان پر اَور جتنے لوگ وہاں تھے اُن پر چھڑکے۔ اَور اُس شخص پر بھی چھڑکے جِس نے اِنسان کی ہڈّی کو یا قبر کو یا مقتول کو یا کسی اَیسے مُردے کو چھُوا ہو جو طبعی موت مَرا ہو۔ <verse eid="NUM 19:18"/><verse number="19" style="v" sid="NUM 19:19"/>وہ پاک آدمی تیسرے اَور ساتویں دِن اُس ناپاک شخص پر چھڑکے اَور ساتویں دِن وہ اُسے پاک کر دیں، جِس شخص کو پاک کیا جا رہا ہو وہ اَپنے کپڑے دھوئے اَور پانی سے غُسل کرے تو وہ شام کو پاک ہو جائے گا۔ <verse eid="NUM 19:19"/><verse number="20" style="v" sid="NUM 19:20"/>لیکن اگر کویٔی شخص ناپاک ہو اَور اَپنے آپ کو پاک نہ کر لے تو اُسے جماعت سے کاٹ ڈالا جائے کیونکہ اُس نے یَاہوِہ کے پاک مَقدِس کو ناپاک کیا ہے۔ طہارت کا پانی اُس پر چھِڑکا نہیں گیا اِس لیٔے وہ ناپاک ہے۔ <verse eid="NUM 19:20"/><verse number="21" style="v" sid="NUM 19:21"/>یہ اُن کے لیٔے ایک دائمی فرمان ہو۔</para>
  <para style="p" vid="NUM 19:21">”جو کویٔی طہارت کا پانی لے کر چھڑکے وہ بھی اَپنے کپڑے دھوئے اَورجو کویٔی طہارت کے پانی کو چھُوئے وہ شام تک ناپاک رہے گا۔ <verse eid="NUM 19:21"/><verse number="22" style="v" sid="NUM 19:22"/>ناپاک شخص جِس شَے کو بھی چھُوتا ہے وہ شَے ناپاک ہو جاتی ہے اَور وہ چھُونے والا بھی شام تک ناپاک رہے گا۔“<verse eid="NUM 19:22"/></para>
  <chapter eid="NUM 19"/>
  <chapter number="20" style="c" sid="NUM 20"/>
  <para style="s1">چٹّان سے پانی نکالنا</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 20:1"/>پہلے مہینے میں بنی اِسرائیل کی ساری جماعت صینؔ کے بیابان میں پہُنچی اَور وہ لوگ قادِسؔ میں رہنے لگے۔ اَور مِریمؔ نے وہاں وفات پائی اَور وہیں پر دفن ہُوئی۔<verse eid="NUM 20:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 20:2"/>وہاں اِسرائیل کے لوگوں کے لیٔے پانی نہ مِلا۔ لہٰذا وہ مَوشہ اَور اَہرونؔ کے خِلاف اِکھٹّے ہُوئے۔ <verse eid="NUM 20:2"/><verse number="3" style="v" sid="NUM 20:3"/>مَوشہ سے جھگڑا کرکے کہنے لگے، ”کاش ہم بھی اُس وقت ہی مَر گیٔے ہوتے جَب ہمارے بھایٔی یَاہوِہ کے حُضُور مَر گیٔے! <verse eid="NUM 20:3"/><verse number="4" style="v" sid="NUM 20:4"/>تُم یَاہوِہ کی جماعت کو اِس بیابان میں کیوں لے آئے ہو کہ ہم اَور ہمارے مویشی یہاں مَر جایٔیں؟ <verse eid="NUM 20:4"/><verse number="5" style="v" sid="NUM 20:5"/>تُم نے ہمیں مِصر سے نکال کر اِس ہولناک جگہ میں کیوں پہُنچا دیا؟ یہاں نہ تو اناج ہے نہ اَنجیر، نہ انگوری باغ ہیں نہ انار۔ یہاں تک کہ پینے کے لیٔے پانی بھی مُیسّر نہیں ہے!“<verse eid="NUM 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 20:6"/>تَب مَوشہ اَور اَہرونؔ جماعت کے پاس سے خیمہ اِجتماع کے دروازہ پر جا کر مُنہ کے بَل گِرے اَور یَاہوِہ کا جلال اُن پر ظاہر ہُوا۔ <verse eid="NUM 20:6"/><verse number="7" style="v" sid="NUM 20:7"/>اَور یَاہوِہ نے مَوشہ سے کہا: <verse eid="NUM 20:7"/><verse number="8" style="v" sid="NUM 20:8"/>”اُس عصا کو لے لینا اَور تُم اَور تمہارا بھایٔی اَہرونؔ دونوں مِل کر جماعت کو جمع کرو اَور اُن کی آنکھوں کے سامنے اُس چٹّان سے کہو اَور وہ اَپنا پانی اُنڈیل دے گی۔ اِس طرح تُم جماعت کے لیٔے اُس چٹّان سے پانی نکالنا تاکہ وہ اَور اُن کے مویشی پی سکیں۔“<verse eid="NUM 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 20:9"/>چنانچہ مَوشہ نے یَاہوِہ کے حُضُور ٹھیک اُن کے حُکم کے مُطابق وہ عصا لیا <verse eid="NUM 20:9"/><verse number="10" style="v" sid="NUM 20:10"/>اَور اُس نے اَور اَہرونؔ نے جماعت کو اُس چٹّان کے سامنے جمع کیا اَور مَوشہ نے اُن سے کہا، ”اَے باغیو! سُنو کیا ہم تمہارے لیٔے اِسی چٹّان سے پانی نکالیں؟“ <verse eid="NUM 20:10"/><verse number="11" style="v" sid="NUM 20:11"/>تَب مَوشہ نے اَپنا ہاتھ اُٹھایا اَور اُس چٹّان پر دو بار عصا مارا اَور پانی بہہ نِکلا، جسے جماعت نے اَور اُن کے مویشیوں نے پیا۔<verse eid="NUM 20:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 20:12"/>لیکن یَاہوِہ نے مَوشہ اَور اَہرونؔ سے کہا، ”چونکہ تُم نے مُجھ پر اِتنا بھروسا نہ رکھا کہ بنی اِسرائیل کے سامنے میری تقدیس اَور میرا اِحترام کرتے اِس لیٔے تُم اِس جماعت کو اُس مُلک میں نہیں پہُنچاؤگے جسے میں اُنہیں دے رہا ہُوں۔“<verse eid="NUM 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 20:13"/>مریبہؔ<note caller="+" style="f"><char style="fr" closed="false">20‏:13 </char><char style="fq" closed="false">مریبہؔ </char><char style="ft" closed="false">یعنی جھگڑا</char></note> کا چشمہ یہی ہے جہاں بنی اِسرائیل نے یَاہوِہ سے جھگڑا کیا تھا اَور وہ اُن کے درمیان پاک ثابت ہُوا۔<verse eid="NUM 20:13"/></para>
  <para style="s1">اِدُوم کا بنی اِسرائیل کو سفر کرنے سے روکنا</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 20:14"/>پھر مَوشہ نے قادِسؔ سے اِدُوم کے بادشاہ کے پاس قاصِد روانہ کئے اَور یہ پیغام بھیجا:</para>
  <para style="pm" vid="NUM 20:14">”تمہارا بھایٔی اِسرائیل یہ عرض کرتا ہے کہ تُم اُن سَب مُصیبتوں سے واقف ہو جو ہم پر آن پڑی ہیں۔ <verse eid="NUM 20:14"/><verse number="15" style="v" sid="NUM 20:15"/>ہمارے آباؤاَجداد مِصر میں گیٔے اَور ہم کیٔی سال وہاں رہے۔ مِصریوں نے ہمارے اَور ہمارے آباؤاَجداد کے ساتھ بُرا سلُوک کیا، <verse eid="NUM 20:15"/><verse number="16" style="v" sid="NUM 20:16"/>لیکن جَب ہم نے یَاہوِہ سے فریاد کی تو اُنہُوں نے ہماری سُنی اَور ایک فرشتہ بھیج کر ہمیں مِصر سے نکال لے آئے۔</para>
  <para style="pm" vid="NUM 20:16">”اَب ہم یہاں قادِسؔ شہر میں ہیں جو تمہاری سلطنت کی سرحد پر واقع ہے۔ <verse eid="NUM 20:16"/><verse number="17" style="v" sid="NUM 20:17"/>اَے بادشاہ لہٰذا مہربانی فرما کر ہمیں اَپنے مُلک سے ہوکر جانے کی اِجازت دیں۔ ہم کسی کھیت یا انگوری باغ میں سے ہوکر نہیں گزریں گے اَور نہ کسی کنوئیں کا پانی پیئیں گے۔ ہم شاہراہ سے ہوتے ہویٔے سفر کریں گے اَور جَب تک تمہاری سلطنت سے باہر نہ نکل جایٔیں تَب تک داہنے یا بائیں ہاتھ نہیں مُڑیں گے۔“<verse eid="NUM 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 20:18"/>لیکن اِدُومیوں نے جَواب دیا:</para>
  <para style="pm" vid="NUM 20:18">”تُم یہاں سے ہوکر جانے نہ پاؤگے اَور اگر تُم نے کوشش کی تو ہم نکل کر تلوار سے تُم پر حملہ کریں گے۔“<verse eid="NUM 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 20:19"/>اِسرائیلیوں نے پھر کہلا بھیجا:</para>
  <para style="pm" vid="NUM 20:19">”ہم بڑی شاہراہ سے ہوتے ہویٔے چلے جایٔیں گے اَور اگر ہم یا ہمارے مویشی تمہارا پانی پیئیں تو اُس کا دام دیں گے۔ ہم صِرف پیدل چلے جانا چاہتے ہیں اَور کچھ نہیں۔“<verse eid="NUM 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 20:20"/>اُنہُوں نے پھر جَواب دیا:</para>
  <para style="pm" vid="NUM 20:20">”تُم جانے نہ پاؤگے۔“</para>
  <para style="p" vid="NUM 20:20">تَب اِدُوم بڑی بھاری اَور طاقتور فَوج لے کر اُن کے مُقابلہ کے لیٔے نکل آیا۔ <verse eid="NUM 20:20"/><verse number="21" style="v" sid="NUM 20:21"/>چونکہ اِدُوم نے بنی اِسرائیل کو اَپنی سلطنت کی حُدوُد میں سے ہوکر جانے کی اِجازت نہ دی، اِس لیٔے اِسرائیلی لوگ پیچھے مُڑ کر دُوسرے راستہ سے چلے گیٔے۔<verse eid="NUM 20:21"/></para>
  <para style="s1">اَہرونؔ کی وفات</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 20:22"/>تَب بنی اِسرائیل کی ساری جماعت قادِسؔ سے کُوچ کرکے کوہِ ہُورؔ پہُنچی۔ <verse eid="NUM 20:22"/><verse number="23" style="v" sid="NUM 20:23"/>اَور اِدُوم کی سرحد کے نزدیک کوہِ ہُورؔ پر یَاہوِہ نے مَوشہ اَور اَہرونؔ سے فرمایا، <verse eid="NUM 20:23"/><verse number="24" style="v" sid="NUM 20:24"/>”اَہرونؔ اَپنے لوگوں میں جا ملے گا۔ وہ اُس مُلک میں داخل نہ ہوں گے جسے میں بنی اِسرائیل کو دے رہا ہُوں کیونکہ تُم دونوں نے مریبہؔ کے چشمہ پر میرے حُکم کے خِلاف بغاوت کی تھی۔ <verse eid="NUM 20:24"/><verse number="25" style="v" sid="NUM 20:25"/>لہٰذا تُم اَہرونؔ اَور اُس کے بیٹے الیعزرؔ کو اَپنے ساتھ لے کر کوہِ ہُورؔ کے اُوپر جانا۔ <verse eid="NUM 20:25"/><verse number="26" style="v" sid="NUM 20:26"/>اَور اَہرونؔ کے کاہِنؔ لباس کو اُتار کر اُس کے بیٹے الیعزرؔ کو پہنا دینا کیونکہ اَہرونؔ اَپنے لوگوں میں جا ملے گا۔ وہ وہیں وفات پایٔےگا۔“<verse eid="NUM 20:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 20:27"/>مَوشہ نے یَاہوِہ کے حُکم کے مُطابق عَمل کیا اَور وہ ساری جماعت کی آنکھوں کے سامنے کوہِ ہُورؔ پر چڑھ گیٔے۔ <verse eid="NUM 20:27"/><verse number="28" style="v" sid="NUM 20:28"/>مَوشہ نے اَہرونؔ کے کپڑے اُتار کر اُس کے بیٹے الیعزرؔ کو پہنا دئیے اَور اَہرونؔ وہیں اُس پہاڑ کی چوٹی پر مَر گیا۔ تَب مَوشہ اَور الیعزرؔ پہاڑ پر سے اُتر آئے۔ <verse eid="NUM 20:28"/><verse number="29" style="v" sid="NUM 20:29"/>اَور جَب ساری جماعت کو خبر ہُوئی کہ اَہرونؔ وفات پا چُکے ہیں تو تمام بنی اِسرائیل کے خاندان کے لوگ تیس دِن تک اُن کے لیٔے ماتم کرتے رہے۔<verse eid="NUM 20:29"/></para>
  <chapter eid="NUM 20"/>
  <chapter number="21" style="c" sid="NUM 21"/>
  <para style="s1">عَرادؔ کی تباہی</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 21:1"/>جَب عَرادؔ کے کنعانی بادشاہ نے جو نِیگیوؔ میں رہتا تھا سُنا کہ اِسرائیل اتھارِمؔ کی راہ سے آ رہاہے تو اُس نے اِسرائیلیوں پر حملہ کیا اَور اُن میں سے کیٔی ایک کو اسیر کر لیا۔ <verse eid="NUM 21:1"/><verse number="2" style="v" sid="NUM 21:2"/>تَب اِسرائیل نے یَاہوِہ کے حُضُور یہ مَنّت مانی: ”اگر آپ اِن لوگوں کو ہمارے ہاتھ میں کر دیں تو ہم اُن کے شہروں کو تباہ کر دیں گے۔“ <verse eid="NUM 21:2"/><verse number="3" style="v" sid="NUM 21:3"/>یَاہوِہ نے اِسرائیل کی فریاد سُنی اَور کنعانیوں کو اُن کے حوالہ کر دیا۔ اُنہُوں نے اُنہیں اَور اُن کے شہروں کو مُکمّل طور پر تباہ کر دیا۔ اِس لیٔے اُس جگہ کا نام حُرمہؔ<note caller="+" style="f"><char style="fr" closed="false">21‏:3 </char><char style="fq" closed="false">حُرمہؔ </char><char style="ft" closed="false">تباہی</char></note> رکھا گیا۔<verse eid="NUM 21:3"/></para>
  <para style="s1">کانسے کا سانپ</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 21:4"/>پھر اُنہُوں نے کوہِ ہُورؔ سے کُوچ کرکے بحرِقُلزمؔ کی راہ لی تاکہ مُلک اِدُوم کے باہر گھُوم کر جایٔیں لیکن وہ لوگ راستہ میں عاجز آ گئے۔ <verse eid="NUM 21:4"/><verse number="5" style="v" sid="NUM 21:5"/>وہ خُدا اَور مَوشہ کے خِلاف بکنے لگے اَور کہا، ”تُم ہمیں مِصر سے نکال کر بیابان میں مرنے کے لیٔے کیوں لے آئے؟ یہاں نہ تو روٹی ہے نہ پانی! اَور ہم اِس نکمّی خُوراک سے بھی عاجز آ چُکے ہیں۔“<verse eid="NUM 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 21:6"/>تَب یَاہوِہ نے اُن لوگوں کے درمیان زہریلے سانپ بھیجے؛ سانپوں نے لوگوں کو کاٹا اَور بہت سے اِسرائیلی مَر گیٔے۔ <verse eid="NUM 21:6"/><verse number="7" style="v" sid="NUM 21:7"/>تَب وہ لوگ مَوشہ کے پاس آکر کہنے لگے، ”ہم نے گُناہ کیا ہے کہ ہم نے یَاہوِہ کے حُضُور اَور تمہارے خِلاف زبان درازی کی۔ دعا کرو، یَاہوِہ اِن سانپوں کو ہم سے دُور کر دیں۔“ چنانچہ مَوشہ نے اُن لوگوں کے لیٔے دعا کی۔<verse eid="NUM 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 21:8"/>یَاہوِہ نے مَوشہ سے کہا، ”ایک سانپ بنا لینا اَور اُسے کھمبے پر لٹکانا اَور سانپ کا ڈسا ہُوا جو کویٔی بھی فرد اُسے دیکھ لے گا وہ زندہ بچے گا۔“ <verse eid="NUM 21:8"/><verse number="9" style="v" sid="NUM 21:9"/>چنانچہ مَوشہ نے کانسے کا ایک سانپ بنا کر اُسے کھمبے پر لٹکا دیا؛ تَب جَب کبھی کسی کو سانپ ڈس لیتا اَور وہ اُس کانسے کے سانپ کی طرف دیکھتا تو زندہ بچ جاتا۔<verse eid="NUM 21:9"/></para>
  <para style="s1">مُوآب کا سفر</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 21:10"/>پھر اِسرائیلیوں نے کُوچ کیا اَور اوبُوتؔ میں آکر خیمہ زن ہویٔے۔ <verse eid="NUM 21:10"/><verse number="11" style="v" sid="NUM 21:11"/>اَور اوبُوتؔ سے کُوچ کیا اَور عیّے عباریمؔ میں خیمہ زن ہویٔے جو مشرق کی جانِب مُوآب کے سامنے بیابان میں ہے۔ <verse eid="NUM 21:11"/><verse number="12" style="v" sid="NUM 21:12"/>وہاں سے کُوچ کرکے وہ وادی زیِریؔد میں خیمہ زن ہویٔے۔ <verse eid="NUM 21:12"/><verse number="13" style="v" sid="NUM 21:13"/>وہاں سے کُوچ کرکے وہ دریائے ارنُونؔ کے کنارے پر خیمہ زن ہویٔے جو اُس بیابان میں سے گزرتی ہے اَورجو امُوریوں کے علاقہ میں اَندر تک پھیلا ہُواہے۔ دریائے ارنُونؔ مُوآب اَور امُوریوں کے درمیان مُوآب کی سرحد ہے۔ <verse eid="NUM 21:13"/><verse number="14" style="v" sid="NUM 21:14"/>اِس لیٔے یَاہوِہ کے جنگ نامہ میں یُوں لِکھّا ہے:</para>
  <para style="q1" vid="NUM 21:14">”واہیبؔ<note caller="+" style="f"><char style="fr" closed="false">21‏:14 </char><char style="fq" closed="false">واہیبؔ </char><char style="ft" closed="false">کچھ صحیفوں میں ذہابؔ لیا گیا ہے</char></note> جو سُوفہؔ میں ہے</para>
  <para style="q2" vid="NUM 21:14">اَور ارنُونؔ کی وادیوں۔ <verse eid="NUM 21:14"/><verse number="15" style="v" sid="NUM 21:15"/>اَور اُن وادیوں کے ڈھلان</para>
  <para style="q1" vid="NUM 21:15">جو عاؔر کے مقام تک پھیلے ہویٔے ہیں</para>
  <para style="q2" vid="NUM 21:15">اَور مُوآب کی سرحد سے مُتّصِل ہے۔“<verse eid="NUM 21:15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="NUM 21:16"/>پھر وہاں سے بیرؔ تک اُنہُوں نے اَپنا سفر جاری رکھا۔ یہ وُہی کنواں ہے جہاں یَاہوِہ نے مَوشہ سے کہاتھا، ”لوگوں کو جمع کرنا اَور مَیں اُنہیں پانی دُوں گا۔“<verse eid="NUM 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 21:17"/>تَب اِسرائیل نے یہ نغمہ گایا:</para>
  <para style="q1" vid="NUM 21:17">”اَے کنوئیں تُو اُبل آ!</para>
  <para style="q2" vid="NUM 21:17">اُس کے لیٔے گاؤ،<verse eid="NUM 21:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 21:18"/>اُس کنوئیں کے لیٔے جسے شہزادوں نے تعمیر کیا</para>
  <para style="q2" vid="NUM 21:18">اَور قوم کے اُمرا نے</para>
  <para style="q2" vid="NUM 21:18">اَپنے عصائے شاہی اَور عصاؤں سے کھودا۔“</para>
  <para style="m" vid="NUM 21:18">تَب وہ اُس بیابان سے متنّہؔ کو گیٔے۔ <verse eid="NUM 21:18"/><verse number="19" style="v" sid="NUM 21:19"/>اَور متنّہؔ سے نحلی ایل کو اَور نحلی ایل سے باموت کو، <verse eid="NUM 21:19"/><verse number="20" style="v" sid="NUM 21:20"/>اَور باموت سے مُوآب کی اُس وادی میں آئے جہاں پِسگہؔ کی چوٹی پر سے یشیمونؔ یعنی بنجر علاقہ نظر آتا ہے۔<verse eid="NUM 21:20"/></para>
  <para style="s1">سیحونؔ اَور عوگؔ کی شِکست</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 21:21"/>تَب اِسرائیل نے امُوریوں کے بادشاہ سیحونؔ کے پاس قاصِد روانہ کرکے یہ پیغام بھیجا:<verse eid="NUM 21:21"/></para>
  <para style="pm">
    <verse number="22" style="v" sid="NUM 21:22"/>”بادشاہ ہمیں اَپنے مُلک میں سے ہوکر جانے دیں۔ ہم مُڑ کر کھیتوں یا تاکستانوں میں نہیں گھُسیں گے اَور نہ ہی کنوؤں کا پانی پیئیں گے۔ اَور جَب تک تمہارے مُلک سے گزر نہ جایٔیں سیدھے شاہراہ پر ہی چلتے رہیں گے۔“<verse eid="NUM 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 21:23"/>لیکن سیحونؔ نے اِسرائیل کو اَپنے مُلک میں سے ہوکر جانے نہ دیا بَلکہ اَپنے تمام فَوج کو جمع کرکے اِسرائیل کے مُقابلہ کے لیٔے بیابان میں نکل آئے اَور جَب وہ یاہضؔ کو پہُنچے تو اِسرائیل سے لڑے۔ <verse eid="NUM 21:23"/><verse number="24" style="v" sid="NUM 21:24"/>البتّہ اِسرائیل نے اُسے تلوار سے مار ڈالا اَور اُس کے مُلک پر ارنُونؔ سے لے کر یبّوقؔ تک جہاں بنی عمُّون کی سرحد ہے قبضہ کر لیا کیونکہ اُن کی سرحد مضبُوط تھی۔ <verse eid="NUM 21:24"/><verse number="25" style="v" sid="NUM 21:25"/>اِسرائیل نے حِشبونؔ اَور اُس کے اِردگرد کی بستیوں سمیت امُوریوں کے سَب شہروں پر قبضہ کر لیا اَور اُن میں بس گیٔے۔ <verse eid="NUM 21:25"/><verse number="26" style="v" sid="NUM 21:26"/>حِشبونؔ امُوریوں کے بادشاہ سیحونؔ کا شہر تھا جِس نے مُوآب کے پہلے بادشاہ سے لڑ کر ارنُونؔ تک اُس کا سارا مُلک اُس سے چھین لیا تھا۔<verse eid="NUM 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 21:27"/>اِس لیٔے شعرا کہتے ہیں:</para>
  <para style="q1" vid="NUM 21:27">”حِشبونؔ کو آؤ، ہم اِس کو مضبُوطی سے تعمیر کریں گے۔</para>
  <para style="q2" vid="NUM 21:27">سیحونؔ کا شہر مضبُوط بُنیادوں پر قائِم ہے۔<verse eid="NUM 21:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="NUM 21:28"/>”حِشبونؔ سے آگ نکلی</para>
  <para style="q2" vid="NUM 21:28">یعنی سیحونؔ کے شہر سے شُعلہ بھڑکا</para>
  <para style="q1" vid="NUM 21:28">جِس نے مُوآب کے عاؔر کو</para>
  <para style="q2" vid="NUM 21:28">اَور ارنُونؔ کے اُونچے مقامات کے اُمرا کو بھسم کر دیا۔<verse eid="NUM 21:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="NUM 21:29"/>اَے مُوآب! تُجھ پر افسوس!</para>
  <para style="q2" vid="NUM 21:29">اَے کموشؔ کے لوگو تُم تباہ ہو گئے!</para>
  <para style="q1" vid="NUM 21:29">اُس نے اَپنے بیٹوں کو بھگوڑوں</para>
  <para style="q2" vid="NUM 21:29">اَور اَپنی بیٹیوں کو اسیروں کی مانند</para>
  <para style="q2" vid="NUM 21:29">امُوریوں کے بادشاہ سیحونؔ کے حوالہ کر دیا۔<verse eid="NUM 21:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="NUM 21:30"/>”لیکن ہم نے اُن کا تختہ اُلٹ دیا ہے؛</para>
  <para style="q2" vid="NUM 21:30">حِشبونؔ دیبونؔ سمیت تباہ ہو گیا ہے</para>
  <para style="q1" vid="NUM 21:30">اَور ہم نے اُنہیں نُپاحؔ تک</para>
  <para style="q2" vid="NUM 21:30">جو میدباؔ تک پھیلا ہُواہے اُجاڑ دیا ہے۔“<verse eid="NUM 21:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 21:31"/>اِس طرح بنی اِسرائیل امُوریوں کے مُلک میں بس گیٔے۔<verse eid="NUM 21:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 21:32"/>مَوشہ نے یعزیرؔ کا جائزہ لینے کے لیٔے جاسُوس بھیجے اَور پھر بنی اِسرائیل نے اُس کے اِردگرد کے قصبوں پر قبضہ کر لیا اَور امُوریوں کو وہاں سے نکال دیا۔ <verse eid="NUM 21:32"/><verse number="33" style="v" sid="NUM 21:33"/>پھر وہ باشانؔ کے راستہ سے آگے بڑھے اَور باشانؔ کا بادشاہ عوگؔ اَپنے سارے لشکر کے ساتھ نکل کر ادرعیؔ کے مقام پر اُن سے جنگ کرے۔<verse eid="NUM 21:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 21:34"/>یَاہوِہ نے مَوشہ سے فرمایا، ”اُس سے خوفزدہ مت ہو کیونکہ مَیں نے اُسے اُس کے سارے لشکر اَور اُس کے مُلک سمیت تمہارے حوالہ کر دیا ہے۔ لہٰذا جَیسا تُم نے امُوریوں کے بادشاہ سیحونؔ کے ساتھ کیا، جو حِشبونؔ میں حُکمراں تھا وَیسا ہی اُس کے ساتھ بھی کرنا۔“<verse eid="NUM 21:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 21:35"/>چنانچہ اُنہُوں نے اُسے اُس کے بیٹوں اَور اُس کے سارے لشکر کو یہاں تک مارا کہ اُن میں سے کویٔی نہ بچا اَور اُنہُوں نے اُس کے مُلک پر قبضہ کر لیا۔<verse eid="NUM 21:35"/></para>
  <chapter eid="NUM 21"/>
  <chapter number="22" style="c" sid="NUM 22"/>
  <para style="s1">بلقؔ کا بِلعاؔم کو دعوت دینا</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 22:1"/>تَب بنی اِسرائیل نے مُوآب کے میدانوں کی طرف کُوچ کیا اَور وہ یریحوؔ کے مقابل دریائے یردنؔ کے پار خیمہ زن ہویٔے۔<verse eid="NUM 22:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 22:2"/>بنی اِسرائیل نے امُوریوں کے ساتھ جو کچھ کیا تھا وہ سَب بلقؔ بِن صِفُورؔ نے دیکھا تھا۔ <verse eid="NUM 22:2"/><verse number="3" style="v" sid="NUM 22:3"/>اِس لیٔے مُوآب نہایت خوفزدہ ہُوا کیونکہ اُن لوگوں کی تعداد بہت زِیادہ تھی۔ سَو مُوآبی بنی اِسرائیل کی وجہ سے بےحد پریشان ہویٔے۔<verse eid="NUM 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 22:4"/>چنانچہ مُوآبیوں نے مِدیانی بُزرگوں سے کہا، ”یہ گِروہ ہمارے آس پاس کی ہر شَے کو اَیسے چٹ کر جائے گا جَیسے کویٔی بَیل کھیت کی گھاس کو چٹ کر جاتا ہے۔“</para>
  <para style="p" vid="NUM 22:4">چنانچہ بلقؔ بِن صِفُورؔ نے جو اُن دِنوں مُوآب کا بادشاہ تھا، <verse eid="NUM 22:4"/><verse number="5" style="v" sid="NUM 22:5"/>بِلعاؔم بِن بعورؔ کو بُلانے کے لیٔے اُس کے پاس قاصِد بھیجے جو بڑے دریا کے کنارے واقع اَپنی جائے رہائش پتھورؔ میں تھا۔ بلقؔ نے کہلا بھیجا:</para>
  <para style="pm" vid="NUM 22:5">”ایک قوم مِصر سے نکل کر آئی ہے؛ جِس کے لوگوں سے مُلک کی سطح چھُپ گئی ہے اَور اَب وہ میرے مقابل جم گیٔے ہیں۔ <verse eid="NUM 22:5"/><verse number="6" style="v" sid="NUM 22:6"/>لہٰذا تُم آکر اُن لوگوں پر لعنت کرنا کیونکہ وہ مُجھ سے زِیادہ قوی ہیں۔ تَب شاید میں اُنہیں شِکست دے کر مُلک سے باہر نکال سکوں، کیونکہ مَیں جانتا ہُوں کہ جنہیں آپ برکت دیتے ہیں اُنہیں برکت ملتی ہے اَور جِن پر آپ لعنت کرتے ہیں وہ ملعُون ہوتے ہیں۔“<verse eid="NUM 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 22:7"/>چنانچہ مُوآبی اَور مِدیانی بُزرگ اَپنے ساتھ فال کھولنے کی اُجرت لے کر روانہ ہویٔے۔ جَب وہ بِلعاؔم کے پاس پہُنچے تو اُسے بلقؔ کا پیغام دے دیا۔<verse eid="NUM 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 22:8"/>بِلعاؔم نے اُن سے کہا، ”تُم رات یہیں گُزارو اَور یَاہوِہ مُجھے جو جَواب دیں گے اُسے مَیں تمہارے پاس لے آؤں گا۔“ چنانچہ مُوآب کے حاکم بِلعاؔم کے ہاں ٹھہر گیٔے۔<verse eid="NUM 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 22:9"/>خُدا نے بِلعاؔم کے پاس آکر پُوچھا، ”تمہارے ساتھ یہ کون آدمی ہیں؟“<verse eid="NUM 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 22:10"/>بِلعاؔم نے خُدا سے کہا، ”مُوآب کے بادشاہ بلقؔ بِن صِفُورؔ نے میرے پاس یہ پیغام بھیجا ہے: <verse eid="NUM 22:10"/><verse number="11" style="v" sid="NUM 22:11"/>’جو قوم مِصر سے نکل آئی ہے اُس کے لوگوں سے مُلک کی سطح چھُپ گئی ہے۔ لہٰذا تُم آکر میری خاطِر اُن پر لعنت کرنا۔ تَب شاید میں اُن سے جنگ کرکے اُنہیں نکال سکوں۔‘ “<verse eid="NUM 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 22:12"/>لیکن خُدا نے بِلعاؔم سے کہا، ”تُو اُن کے ساتھ مت جا اَور نہ ہی اُن لوگوں پر لعنت کر کیونکہ وہ مُبارک ہیں۔“<verse eid="NUM 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 22:13"/>بِلعاؔم نے صُبح کو اُٹھ کر بلقؔ کے حاکم سے کہا، ”تُم اَپنے مُلک کو لَوٹ جاؤ کیونکہ یَاہوِہ مُجھے تمہارے ساتھ جانے کی اِجازت نہیں دیتے۔“<verse eid="NUM 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 22:14"/>چنانچہ مُوآبی حاکم بلقؔ کے پاس لَوٹ آئے اَور کہا، ”بِلعاؔم نے ہمارے ساتھ آنے سے اِنکار کر دیا۔“<verse eid="NUM 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 22:15"/>تَب بلقؔ نے دُوسرے حاکم روانہ کئے جو تعداد میں زِیادہ اَور پہلوں سے زِیادہ مُعزّز تھے۔ <verse eid="NUM 22:15"/><verse number="16" style="v" sid="NUM 22:16"/>وہ بِلعاؔم کے پاس آئے اَور کہا:</para>
  <para style="pm" vid="NUM 22:16">”بلقؔ بِن صِفُورؔ نے یُوں کہا ہے، ’میرے پاس آنے سے مت جِھجک، <verse eid="NUM 22:16"/><verse number="17" style="v" sid="NUM 22:17"/>کیونکہ مَیں تُمہیں نہایت فیّاضی سے صِلہ دُوں گا اَورجو کچھ آپ مُجھ سے کہیں گے میں وُہی کروں گا۔ لہٰذا تُم آؤ اَور میری خاطِر اُن لوگوں پر لعنت کرنا۔‘ “<verse eid="NUM 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 22:18"/>لیکن بِلعاؔم نے اُنہیں جَواب دیا، ”چاہے بلقؔ اَپنے محل میں جِتنا چاندی اَور سونا مُجھے دے تَب بھی میں اَپنے یَاہوِہ خُدا کے حُکم سے تجاوُز نہیں کر سَکتا۔ <verse eid="NUM 22:18"/><verse number="19" style="v" sid="NUM 22:19"/>لہٰذا تُم اُن لوگوں کی طرح آج کی رات یہیں قِیام کرو تَب میں دیکھوں گا کہ یَاہوِہ مُجھ سے اَور کیا کہتے ہیں۔“<verse eid="NUM 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 22:20"/>اُس رات خُدا بِلعاؔم کے پاس آئے اَور کہا، ”چونکہ یہ آدمی تُجھے بُلانے آئے ہیں لہٰذا تُو اُن کے ساتھ چلا جا لیکن جو مَیں تُجھ سے کہُوں وُہی کرنا۔“<verse eid="NUM 22:20"/></para>
  <para style="s1">بِلعاؔم کی گدھی</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 22:21"/>چنانچہ بِلعاؔم صُبح کو اُٹھا اَور اَپنی گدھی پر زین کسا اَور مُوآبی حاکم کے ہمراہ چل دیا۔ <verse eid="NUM 22:21"/><verse number="22" style="v" sid="NUM 22:22"/>لیکن جَب وہ گیا تو خُدا کا قہر بھڑک اُٹھا اَور یَاہوِہ کا فرشتہ اُس کی مزاحمت کرنے کے لیٔے راستہ روک کر کھڑا ہو گیا۔ بِلعاؔم اَپنی گدھی پر سوار تھا اَور اُس کے دو خادِم اُس کے ہمراہ تھے۔ <verse eid="NUM 22:22"/><verse number="23" style="v" sid="NUM 22:23"/>جَب اُس گدھی نے یَاہوِہ کے فرشتہ کو اَپنے ہاتھ میں ننگی تلوار لیٔے راستہ روکے کھڑا دیکھا تو وہ راستہ سے ہٹ کر کھیت میں چلی گئی۔ تَب بِلعاؔم نے اُسے مارا تاکہ اُسے راستہ پر واپس لے آئے۔<verse eid="NUM 22:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 22:24"/>تَب یَاہوِہ کا فرشتہ دو تاکستانوں کے درمیان ایک تنگ پگڈنڈی پر جا کر کھڑا ہو گیا جِس کے دونوں طرف دیواریں تھیں۔ <verse eid="NUM 22:24"/><verse number="25" style="v" sid="NUM 22:25"/>جَب اُس گدھی نے یَاہوِہ کے فرشتہ کو دیکھا تو وہ دیوار سے اَیسی چپک گئی کہ بِلعاؔم کا پاؤں دیوار سے ٹکرا گیا۔ چنانچہ اُس نے اُسے پھر مارا۔<verse eid="NUM 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 22:26"/>تَب یَاہوِہ کا فرشتہ آگے بڑھ کر ایک اَیسے تنگ مقام میں کھڑا ہو گیا جہاں داہنی یا بائیں طرف مُڑنے تک کی جگہ نہ تھی۔ <verse eid="NUM 22:26"/><verse number="27" style="v" sid="NUM 22:27"/>جَب اُس گدھی نے یَاہوِہ کے فرشتہ کو دیکھا تو وہ بِلعاؔم کو لیٔے ہویٔے بیٹھ گئی۔ وہ اِس قدر خفا ہُوا کہ اُسے اَپنی لاٹھی سے مارا۔ <verse eid="NUM 22:27"/><verse number="28" style="v" sid="NUM 22:28"/>تَب یَاہوِہ نے گدھی کا مُنہ کھولا اَور اُس نے بِلعاؔم سے کہا، ”مَیں نے تیرے ساتھ کیا کیا ہے جو تُونے مُجھے تین بار مارا؟“<verse eid="NUM 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 22:29"/>بِلعاؔم نے گدھی کو جَواب دیا، ”تُونے مُجھے بےوقُوف بنایا! اگر میرے ہاتھ میں تلوار ہوتی تو مَیں تُجھ کو اِسی وقت مار ڈالتا۔“<verse eid="NUM 22:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 22:30"/>گدھی نے بِلعاؔم سے کہا، ”کیا میں تیری وُہی گدھی نہیں ہُوں جِس پر تُو آج تک سوار ہوتا آیا ہے؟ کیا مَیں نے تیرے ساتھ پہلے کبھی اَیسا کیا ہے؟“</para>
  <para style="p" vid="NUM 22:30">اُس نے کہا، ”نہیں۔“<verse eid="NUM 22:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 22:31"/>تَب یَاہوِہ نے بِلعاؔم کی آنکھیں کھولیں اَور اُس نے یَاہوِہ کے فرشتہ کو ہاتھ میں ننگی تلوار لیٔے ہویٔے راہ میں کھڑا دیکھا۔ چنانچہ وہ جھُک کر مُنہ کے بَل گرا۔<verse eid="NUM 22:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 22:32"/>یَاہوِہ کے فرشتہ نے اُس سے پُوچھا، ”تُونے اَپنی گدھی کو تین بار کیوں مارا؟ مَیں تُجھ سے مزاحمت کرنے اِس لیٔے یہاں آیا ہُوں کہ تیری چال میری نظر میں ٹیڑھی ہے۔ <verse eid="NUM 22:32"/><verse number="33" style="v" sid="NUM 22:33"/>اِس گدھی نے مُجھے دیکھا اَور تین بار میرے سامنے سے ہٹ گئی۔ اگر وہ نہ ہٹتی تو یقیناً تُجھ کو تو میں مار ہی ڈالتا لیکن اُسے جیتی چھوڑ دیتا۔“<verse eid="NUM 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 22:34"/>بِلعاؔم نے یَاہوِہ کے فرشتہ سے کہا، ”مَیں نے گُناہ کیا ہے۔ میں نہیں جانتا تھا کہ تُو میرا راستہ روکے کھڑا ہے۔ لیکن اگر تُجھے ناگوار گزرتا ہو تو میں واپس چلا جاتا ہُوں۔“<verse eid="NUM 22:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 22:35"/>یَاہوِہ کے فرشتہ نے بِلعاؔم سے کہا، ”تُو اِن آدمیوں کے ساتھ چلا جا لیکن وُہی بات کہنا جو مَیں تُجھ سے کہُوں۔“ لہٰذا بِلعاؔم بلقؔ کے حاکم کے ساتھ چلا گیا۔<verse eid="NUM 22:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 22:36"/>جَب بلقؔ نے سُنا کہ بِلعاؔم آ رہاہے تو وہ اُس کے اِستِقبال کے لیٔے مُوآب کے اُس شہر تک گیا جو ارنُونؔ کی سرحد پر اُس کے مُلک کے آخِری کنارے پر ہے۔ <verse eid="NUM 22:36"/><verse number="37" style="v" sid="NUM 22:37"/>بلقؔ نے بِلعاؔم سے کہا، ”مَیں نے تُجھے فوراً بُلایا تھا۔ تُونے آنے میں اِتنی تاخیر کیوں کی؟ کیا مَیں تُجھے صِلہ دینے کے قابل نہ تھا؟“<verse eid="NUM 22:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 22:38"/>بِلعاؔم نے بلقؔ سے کہا، ”اَب تو مَیں تمہارے پاس آ ہی چُکا ہُوں۔ لیکن اَپنی طرف سے کچھ نہیں کہہ سَکتا؟ جو بات خُدا میرے مُنہ میں ڈالیں گے میں وُہی کہُوں گا۔“<verse eid="NUM 22:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 22:39"/>تَب بِلعاؔم بلقؔ کے ساتھ ہو لیا اَور وہ قِریت حُصاتؔ پہُنچ گیٔے۔ <verse eid="NUM 22:39"/><verse number="40" style="v" sid="NUM 22:40"/>بلقؔ نے مویشی اَور بھیڑوں کی قُربانیاں پیش کیں اَور کچھ گوشت بِلعاؔم اَور اُن اہلکاروں کو دیا جو اُس کے ساتھ تھے۔ <verse eid="NUM 22:40"/><verse number="41" style="v" sid="NUM 22:41"/>دُوسرے دِن صُبح کو بلقؔ بِلعاؔم کو باموت بَعل<note caller="+" style="f"><char style="fr" closed="false">22‏:41 </char><char style="fq" closed="false">باموت بَعل </char><char style="ft" closed="false">بَعل کی اُونچی جگہ</char></note> کو عبادت کے مقام پر لے گیا اَور وہاں اُوپر سے اُس نے اِسرائیلی چھاؤنی کے بیرونی حِصّہ کو دُور دُور تک دیکھا۔<verse eid="NUM 22:41"/></para>
  <chapter eid="NUM 22"/>
  <chapter number="23" style="c" sid="NUM 23"/>
  <para style="s1">بِلعاؔم کی پہلی نبُوّت</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 23:1"/>بِلعاؔم نے بلقؔ سے کہا، ”میرے لیٔے یہاں سات مذبحے تعمیر کرو اَور میرے لیٔے سات بَیل اَور سات مینڈھے بھی تیّار رکھو۔“ <verse eid="NUM 23:1"/><verse number="2" style="v" sid="NUM 23:2"/>بلقؔ نے بِلعاؔم کے کہنے کے مُطابق کیا اَور اُن دونوں نے ہر مذبح پر ایک ایک بَیل اَور ایک ایک مینڈھا قُربان کیا۔<verse eid="NUM 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 23:3"/>تَب بِلعاؔم نے بلقؔ سے کہا، ”تُم اَپنی سوختنی نذر کے پاس کھڑے رہو جَب تک میں جاتا ہُوں۔ شاید یَاہوِہ مُجھ سے مُلاقات کرنے آئیں۔ وہ جو کچھ مُجھ پر ظاہر کریں گے میں تُمہیں بتاؤں گا۔“ پھر وہ ایک برہنہ ٹیلے پر جا چڑھا۔<verse eid="NUM 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 23:4"/>وہاں خُدا بِلعاؔم سے مِلے اَور بِلعاؔم نے کہا، ”مَیں نے سات مذبحے بنائے ہیں اَور ہر مذبح پر ایک ایک بَیل اَور ایک ایک مینڈھا چڑھایا ہے۔“<verse eid="NUM 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 23:5"/>تَب یَاہوِہ نے بِلعاؔم کے مُنہ میں اَپنا کلام ڈالا اَور کہا، ”بلقؔ کے پاس لَوٹ جا اَور اُسے میرا پیغام پہُنچا۔“<verse eid="NUM 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 23:6"/>چنانچہ وہ اُس کے پاس لَوٹ کر آیا اَور اُسے مُوآب کے سَب حاکم سمیت اَپنی سوختنی نذر کے پاس کھڑا پایا۔ <verse eid="NUM 23:6"/><verse number="7" style="v" sid="NUM 23:7"/>تَب بِلعاؔم نے اَپنا پیغام بَیان کیا:</para>
  <para style="q1" vid="NUM 23:7">”بلقؔ نے مُجھے ارام سے،</para>
  <para style="q2" vid="NUM 23:7">یعنی شاہِ مُوآب نے، مُجھے مشرقی پہاڑوں سے بُلوایا۔</para>
  <para style="q1" vid="NUM 23:7">اَور فرمایا، ’آ جاؤ اَور میری طرف سے یعقوب پر لعنت بھیجو؛</para>
  <para style="q2" vid="NUM 23:7">آ جاؤ اَور اِسرائیل کو دھمکاؤ۔‘<verse eid="NUM 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 23:8"/>میں اُن پر لعنت کیسے کروں،</para>
  <para style="q2" vid="NUM 23:8">جِن پر خُدا نے لعنت نہیں کی؟</para>
  <para style="q1" vid="NUM 23:8">میں اُنہیں کیسے دھمکی دُوں،</para>
  <para style="q2" vid="NUM 23:8">جنہیں یَاہوِہ نے دھمکی نہیں دی؟<verse eid="NUM 23:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 23:9"/>چٹّانوں کی چوٹیوں پر سے وہ مُجھے نظر آتے ہیں،</para>
  <para style="q2" vid="NUM 23:9">اَور پہاڑوں کی اُونچائی سے اُنہیں دیکھتا ہُوں۔</para>
  <para style="q1" vid="NUM 23:9">میں اَیسی قوم کو دیکھ رہا ہُوں جو الگ رہتی ہے</para>
  <para style="q2" vid="NUM 23:9">اَور دُوسری قوموں میں اَپنا شُمار نہیں کرتی۔<verse eid="NUM 23:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NUM 23:10"/>یعقوب کی خاک کے ذرّوں کو کون گِن سَکتا ہے</para>
  <para style="q2" vid="NUM 23:10">یا اِسرائیل کے چوتھے حِصّہ کو کون شُمار کر سَکتا ہے؟</para>
  <para style="q1" vid="NUM 23:10">کاش میں راستبازوں کی موت مروں</para>
  <para style="q2" vid="NUM 23:10">اَور میرا اَنجام بھی اُن ہی کی مانند ہو!“<verse eid="NUM 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 23:11"/>بلقؔ نے بِلعاؔم سے کہا، ”تُونے میرے ساتھ یہ کیا کیا؟ مَیں نے تُجھے اَپنے دُشمنوں پر لعنت کرنے کے لیٔے بُلایا لیکن تُونے اُنہیں برکت دینے کے سِوا کچھ نہ کیا!“<verse eid="NUM 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 23:12"/>اُس نے جَواب دیا، ”کیا میں وہ بات نہ کہُوں جو یَاہوِہ نے میرے مُنہ میں ڈالی ہے؟“<verse eid="NUM 23:12"/></para>
  <para style="s1">بِلعاؔم کی دُوسری نبُوّت</para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 23:13"/>تَب بلقؔ نے بِلعاؔم سے کہا، ”اَب میرے ساتھ دُوسری جگہ چلو جہاں سے تُم اُن کو دیکھ سکوگے۔ تُم اُن سَب کو تو نہیں لیکن اُن چھاؤنی کے بیرونی حِصّہ کو دیکھ پاؤگے اَور وہاں سے تُم اُن پر میری خاطِر لعنت کرنا۔“ <verse eid="NUM 23:13"/><verse number="14" style="v" sid="NUM 23:14"/>چنانچہ وہ اُسے پِسگہؔ کی چوٹی پر ضوفیمؔ کے میدان میں لے گیا اَور وہاں اُس نے سات مذبحے بنائے اَور ہر مذبح پر ایک ایک بَیل اَور ایک ایک مینڈھا چڑھایا۔<verse eid="NUM 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 23:15"/>بِلعاؔم نے بلقؔ سے کہا، ”تُم یہاں اَپنی سوختنی نذر کے پاس ٹھہرے رہو جَب تک کہ میں وہاں یَاہوِہ سے مِل لُوں۔“<verse eid="NUM 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 23:16"/>اَور یَاہوِہ بِلعاؔم سے ملے اَور اُنہُوں نے اُس کے مُنہ میں اَپنا کلام ڈالا اَور کہا، ”بلقؔ کے پاس لَوٹ جا اَور اُسے یہ پیغام پہُنچا۔“<verse eid="NUM 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 23:17"/>چنانچہ وہ اُس کے پاس لَوٹ آیا اَور اُسے مُوآب کے حاکم سمیت اَپنی سوختنی نذر کے پاس کھڑا پایا۔ بلقؔ نے اُس سے پُوچھا، ”یَاہوِہ نے کیا کہا ہے؟“<verse eid="NUM 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 23:18"/>تَب اُس نے اَپنا پیغام بَیان کیا:</para>
  <para style="q1" vid="NUM 23:18">”اُٹھ اَے بلقؔ اَور سُن؛</para>
  <para style="q2" vid="NUM 23:18">اَے اِبن صِفُورؔ! میری بات پر کان لگا۔<verse eid="NUM 23:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 23:19"/>خُدا اِنسان نہیں کہ جھُوٹ بولیں،</para>
  <para style="q2" vid="NUM 23:19">اَور نہ وہ آدمؔ زاد ہے کہ اَپنا اِرادہ بدلے۔</para>
  <para style="q1" vid="NUM 23:19">کیا جو کچھ وہ کہتے ہیں اُس پر عَمل نہیں کرتے؟</para>
  <para style="q2" vid="NUM 23:19">اَورجو وعدہ کرتے ہیں اُسے پُورا نہیں کرتے؟<verse eid="NUM 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="NUM 23:20"/>مُجھے تو برکت دینے کا حُکم مِلا ہے؛</para>
  <para style="q2" vid="NUM 23:20">وہ برکت دے چُکے ہیں اَور مَیں اُسے ردّ نہیں کر سَکتا۔<verse eid="NUM 23:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="NUM 23:21"/>”یعقوب میں کویٔی بدبختی نہیں پائی جاتی،</para>
  <para style="q2" vid="NUM 23:21">اَور نہ اِسرائیل کی تباہی اُن کی نظر میں ہے۔</para>
  <para style="q1" vid="NUM 23:21">یَاہوِہ اُن کا خُدا اُن کے ساتھ ہے؛</para>
  <para style="q2" vid="NUM 23:21">اَور بادشاہ کی للکار اُن کے درمیان ہے۔<verse eid="NUM 23:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 23:22"/>خُدا اُنہیں مِصر سے نکال کر لائے ہیں؛</para>
  <para style="q2" vid="NUM 23:22">اَور اُن میں جنگلی سانڈ کی سِی طاقت ہے۔<verse eid="NUM 23:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="NUM 23:23"/>یعقوب کے خِلاف کویٔی سحر نہیں چلتا،</para>
  <para style="q2" vid="NUM 23:23">اَور نہ اِسرائیل کے خِلاف فالگیری ہو سکتی ہے۔</para>
  <para style="q1" vid="NUM 23:23">بَلکہ یعقوب اَور اِسرائیل کے حق میں اَب یہ کہا جائے گا،</para>
  <para style="q2" vid="NUM 23:23">’دیکھو خُدا نے کیسے عجِیب کام کئے ہیں۔‘<verse eid="NUM 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 23:24"/>یہ لوگ شیرنی کی مانند اُٹھتے ہیں،</para>
  <para style="q2" vid="NUM 23:24">اَور اَپنے آپ کو اُس شیر کی مانند تن کر کھڑا رکھتے ہیں</para>
  <para style="q1" vid="NUM 23:24">جو اُس وقت تک نہیں سُستاتا جَب تک کہ اَپنا شِکار نہ کھالے</para>
  <para style="q2" vid="NUM 23:24">اَور اَپنے مقتولوں کا خُون نہ پی لے۔“<verse eid="NUM 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 23:25"/>تَب بلقؔ نے بِلعاؔم سے کہا، ”تُم اُن پر نہ تو لعنت کرنا، نہ ہی اُنہیں برکت دینا!“<verse eid="NUM 23:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 23:26"/>بِلعاؔم نے بلقؔ کو جَواب دیا، ”کیا مَیں نے تُمہیں نہیں بتایا کہ میں وُہی کروں گا جو یَاہوِہ فرمائیں گے؟“<verse eid="NUM 23:26"/></para>
  <para style="s1">بِلعاؔم کی تیسری نبُوّت</para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 23:27"/>تَب بلقؔ نے بِلعاؔم سے کہا، ”اَچھّا مَیں تُجھے ایک اَور جگہ لے چلتا ہُوں۔ شاید خُدا کو پسند آئے کہ تُو میری خاطِر وہاں سے اُن پر لعنت کرے۔“ <verse eid="NUM 23:27"/><verse number="28" style="v" sid="NUM 23:28"/>اَور بلقؔ بِلعاؔم کو پعورؔ کی چوٹی پر لے گیا جہاں سے بنجر علاقہ نظر آتا ہے۔<verse eid="NUM 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 23:29"/>بِلعاؔم نے بلقؔ سے کہا، ”میرے لیٔے یہاں سات مذبحے بنا اَور سات بَیل اَور سات مینڈھے تیّار کر۔“ <verse eid="NUM 23:29"/><verse number="30" style="v" sid="NUM 23:30"/>بلقؔ نے بِلعاؔم کے کہنے کے مُطابق کیا اَور ہر مذبح پر ایک بَیل اَور ایک مینڈھا چڑھایا۔<verse eid="NUM 23:30"/></para>
  <chapter eid="NUM 23"/>
  <chapter number="24" style="c" sid="NUM 24"/>
  <para style="p">
    <verse number="1" style="v" sid="NUM 24:1"/>جَب بِلعاؔم نے دیکھا کہ یَاہوِہ کی رضا یہی ہے کہ وہ اِسرائیل کو برکت دے تو اُس نے فالگیری دیکھنے کی پرانی عادت چھوڑکر اَپنا مُنہ بیابان کی طرف موڑا۔ <verse eid="NUM 24:1"/><verse number="2" style="v" sid="NUM 24:2"/>جَب بِلعاؔم نے نگاہ کی اَور دیکھا کہ بنی اِسرائیل قبیلہ بہ قبیلہ چھاؤنی ہیں تو خُدا کی رُوح اُس پر نازل ہُوئی <verse eid="NUM 24:2"/><verse number="3" style="v" sid="NUM 24:3"/>اَور اُس نے اَپنا پیغام بَیان کیا:</para>
  <para style="q1" vid="NUM 24:3">”بِلعاؔم بِن بعورؔ کی نبُوّت،</para>
  <para style="q2" vid="NUM 24:3">اُس کی الہامی تقریر جِس کی آنکھ رَوشن ہے،<verse eid="NUM 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NUM 24:4"/>بَلکہ یہ اُسی کی الہامی تقریر ہے جو خُدا کا کلام سُنتا ہے،</para>
  <para style="q2" vid="NUM 24:4">جو سَجدہ میں گرا ہُوا اَپنی بینا آنکھوں سے</para>
  <para style="q2" vid="NUM 24:4">قادرمُطلق کی رُویا دیکھتا ہے۔<verse eid="NUM 24:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="NUM 24:5"/>”اَے یعقوب تیرے خیمے</para>
  <para style="q2" vid="NUM 24:5">اَور اَے بنی اِسرائیل تمہاری قِیام گاہیں کیا ہی خُوبصورت ہیں!<verse eid="NUM 24:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="NUM 24:6"/>”وہ وادیوں کی طرح پھیلے ہویٔے ہیں،</para>
  <para style="q2" vid="NUM 24:6">گویا لبِ دریا کے باغیچے،</para>
  <para style="q1" vid="NUM 24:6">جو یَاہوِہ کے لگائے ہویٔے عُود کے درخت،</para>
  <para style="q2" vid="NUM 24:6">اَور دریاؤں کے کنارے کے دیودار۔<verse eid="NUM 24:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 24:7"/>اُن کی نمدار شاخوں سے بوندیں ٹپکیں گی؛</para>
  <para style="q2" vid="NUM 24:7">اَور اُن کی جڑوں کو کثرت سے پانی ملے گا۔</para>
  <para style="b" vid="NUM 24:7"/>
  <para style="q1" vid="NUM 24:7">”اُن کا بادشاہ اَگاگؔ سے بھی عظیم تر ہوگا؛</para>
  <para style="q2" vid="NUM 24:7">اَور اُن کی سلطنت عروج پایٔے گی۔<verse eid="NUM 24:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 24:8"/>”خُدا اُنہیں مِصر سے نکال لایا؛</para>
  <para style="q2" vid="NUM 24:8">اُن میں جنگلی سانڈ کی سِی طاقت ہے۔</para>
  <para style="q1" vid="NUM 24:8">وہ مُخالف قوموں کو کھا جاتے ہیں</para>
  <para style="q2" vid="NUM 24:8">اَور اُن کی ہڈّیوں کو چُورچُور کر دیتے ہیں؛</para>
  <para style="q2" vid="NUM 24:8">اَور اَپنے تیروں سے اُن کو چھید ڈالتے ہیں۔<verse eid="NUM 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 24:9"/>وہ شیر کی طرح تاک لگا کر بیٹھ جاتے ہیں،</para>
  <para style="q2" vid="NUM 24:9">بَلکہ شیرنی کی طرح۔ اَب اُنہیں کون چھیڑے؟</para>
  <para style="b" vid="NUM 24:9"/>
  <para style="q1" vid="NUM 24:9">”جو تُمہیں برکت دیں وہ برکت پائیں</para>
  <para style="q2" vid="NUM 24:9">اَورجو تُجھ پر لعنت کریں وہ ملعُون ہُوں!“<verse eid="NUM 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 24:10"/>تَب بلقؔ کا غُصّہ بِلعاؔم پر بھڑکا۔ اُس نے اَپنے ہاتھ پر ہاتھ مارا اَور اُس سے کہا، ”مَیں نے تُجھے اَپنے دُشمنوں پر لعنت کرنے کے لیٔے بُلایا لیکن تینوں بار تُونے اُنہیں برکت پر برکت دی۔ <verse eid="NUM 24:10"/><verse number="11" style="v" sid="NUM 24:11"/>اَب تُو اِسی وقت رخصت ہو اَور اَپنے گھر چلا جا! مَیں نے کہاتھا کہ مَیں تُجھے فیّاضی سے صِلہ دُوں گا لیکن یَاہوِہ نے تُجھے اِس صِلہ سے محروم رکھا ہے۔“<verse eid="NUM 24:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 24:12"/>بِلعاؔم نے بلقؔ کو جَواب دیا، ”کیا مَیں نے اُن قاصِدوں سے جنہیں تُونے میرے پاس بھیجا تھا یہ نہ کہاتھا، <verse eid="NUM 24:12"/><verse number="13" style="v" sid="NUM 24:13"/>’اگر بلقؔ اَپنے محل میں جِتنا چاندی اَور سونا مُجھے دے تَب بھی میں اَپنی طرف سے بھلا یا بُرا کچھ بھی نہیں کر سَکتا۔ جو یَاہوِہ کے حُکم کے خِلاف ہو، بَلکہ جو کچھ یَاہوِہ کہیں گے میں وُہی کہُوں گا‘؟ <verse eid="NUM 24:13"/><verse number="14" style="v" sid="NUM 24:14"/>اَب مَیں اَپنی اُمّت کے پاس لَوٹ کر جاتا ہُوں لیکن دیکھ میں تُمہیں جتائے دیتا ہُوں کہ یہ لوگ آنے والے دِنوں میں تمہاری قوم کے ساتھ کیسا سلُوک کریں گے۔“<verse eid="NUM 24:14"/></para>
  <para style="s1">بِلعاؔم کی چوتھی نبُوّت</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 24:15"/>تَب اُس نے اَپنا پیغام بَیان کیا:</para>
  <para style="q1" vid="NUM 24:15">”بِلعاؔم بِن بعورؔ کی نبُوّت،</para>
  <para style="q2" vid="NUM 24:15">اُس کی نبُوّت جِس کی آنکھ رَوشن ہے،<verse eid="NUM 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="NUM 24:16"/>بَلکہ یہ اُسی کی نبُوّت ہے جو خُدا کا کلام سُنتا ہے،</para>
  <para style="q2" vid="NUM 24:16">اَور خُداتعالیٰ کا عِرفان رکھتا ہے،</para>
  <para style="q1" vid="NUM 24:16">جو سَجدہ میں گرا ہُوا اَپنی بینا آنکھوں سے</para>
  <para style="q2" vid="NUM 24:16">قادرمُطلق کی رُویا دیکھتا ہے۔<verse eid="NUM 24:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="NUM 24:17"/>”میں اُسے دیکھوں گا، پر ابھی نہیں؛</para>
  <para style="q2" vid="NUM 24:17">وہ مُجھے نظر بھی آئے گا، پر نزدیک سے نہیں۔</para>
  <para style="q1" vid="NUM 24:17">یعقوب سے ایک ستارہ نکلے گا؛</para>
  <para style="q2" vid="NUM 24:17">اَور اِسرائیل میں سے ایک عصائے شاہی بُلند ہوگا۔</para>
  <para style="q1" vid="NUM 24:17">وہ مُوآب کی پیشانیوں کو</para>
  <para style="q2" vid="NUM 24:17">اَور شیتؔ کے سَب بیٹوں کی کھوپڑیوں کو کُچل دے گا۔<verse eid="NUM 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 24:18"/>اِدُوم مغلُوب ہوگا؛</para>
  <para style="q2" vid="NUM 24:18">اَور اُس کا دُشمن، سِعِیؔر بھی مغلُوب ہوگا،</para>
  <para style="q2" vid="NUM 24:18">لیکن اِسرائیل تقویّت پاتا جائے گا۔<verse eid="NUM 24:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 24:19"/>یعقوب کی نَسل میں سے ایک شہزادہ برپا ہوگا</para>
  <para style="q2" vid="NUM 24:19">جو شہر کے باقی بچے لوگوں کو تباہ کر ڈالے گا۔“<verse eid="NUM 24:19"/></para>
  <para style="s1">بِلعاؔم کی پانچویں نبُوّت</para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 24:20"/>تَب بِلعاؔم نے عمالیقؔ کی طرف نگاہ کی اَور یہ پیغام بَیان کیا:</para>
  <para style="q1" vid="NUM 24:20">”عمالیقؔ قوموں میں اوّل تو تھا،</para>
  <para style="q2" vid="NUM 24:20">لیکن آخِرکار اُس کا اَنجام تباہی ہے۔“<verse eid="NUM 24:20"/></para>
  <para style="s1">بِلعاؔم کی چھٹویں نبُوّت</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 24:21"/>تَب اُس نے قینیوں کی طرف دیکھا اَور یہ پیغام بَیان کیا:</para>
  <para style="q1" vid="NUM 24:21">”تمہاری قِیام گاہ محفوظ ہے،</para>
  <para style="q2" vid="NUM 24:21">اَور تمہارا آشیانہ چٹّان میں بنا ہُواہے؛<verse eid="NUM 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 24:22"/>پھر بھی اَے قینیو جَب اشُور تُمہیں اسیر کرےگا</para>
  <para style="q2" vid="NUM 24:22">تَب تُم تباہ ہو جاؤگے۔“<verse eid="NUM 24:22"/></para>
  <para style="s1">بِلعاؔم کی ساتویں نبُوّت</para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 24:23"/>تَب اُس نے اَپنا پیغام جاری رکھا:</para>
  <para style="q1" vid="NUM 24:23">”ہائے افسوس! اگر خُدا کی مرضی نہ ہو تو کون زندہ بچے گا؟<verse eid="NUM 24:23"/></para>
  <para style="q2">
    <verse number="24" style="v" sid="NUM 24:24"/>کِتّیمؔ کے ساحِلوں سے جہاز آئیں گے؛</para>
  <para style="q1" vid="NUM 24:24">اَور وہ اشُور اَور عِبرؔ دونوں پر قبضہ کر لیں گے،</para>
  <para style="q2" vid="NUM 24:24">لیکن وہ بھی تباہ ہو جایٔیں گے۔“<verse eid="NUM 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 24:25"/>تَب بِلعاؔم اُٹھ کر گھر لَوٹا اَور بلقؔ نے اَپنی راہ لی۔<verse eid="NUM 24:25"/></para>
  <chapter eid="NUM 24"/>
  <chapter number="25" style="c" sid="NUM 25"/>
  <para style="s1">مُوآب اِسرائیل کو ورغلاتا ہے</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 25:1"/>اِسرائیلی شِطِّیمؔ میں رہتے تھے اَور لوگوں نے اُن مُوآبی عورتوں کے ساتھ حرام کاری شروع کر دی، <verse eid="NUM 25:1"/><verse number="2" style="v" sid="NUM 25:2"/>جو اُنہیں اَپنے معبُودوں کی قُربانیوں میں آنے کی دعوت دیتی تھیں۔ یہ لوگ وہاں جا کر کھاتے اَور اُن معبُودوں کو سَجدہ کرتے تھے۔ <verse eid="NUM 25:2"/><verse number="3" style="v" sid="NUM 25:3"/>اِس طرح بنی اِسرائیل نے پعورؔ کے بَعل کی عبادت میں شرکت کی اَور یَاہوِہ کا قہر اُن پر بھڑکا۔<verse eid="NUM 25:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 25:4"/>یَاہوِہ نے مَوشہ سے کہا: ”اِن لوگوں کے سَب سربراہوں اَور سرغنوں کو لے کر قتل کر اَور اُنہیں یَاہوِہ کے حُضُور دِن کی رَوشنی میں ٹانگ دینا تاکہ یَاہوِہ کا قہرِ شدید بنی اِسرائیل پر سے ٹل جائے۔“<verse eid="NUM 25:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 25:5"/>چنانچہ مَوشہ نے اِسرائیل کے حاکموں سے کہا، ”تمہارے جِن جِن آدمیوں نے پعورؔ کے بَعل کی عبادت میں شرکت کی وہ سَب قتل کئے جایٔیں۔“<verse eid="NUM 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 25:6"/>اَور جَب بنی اِسرائیل کی ساری جماعت خیمہ اِجتماع کے دروازہ پر رو رہی تھی تَب ایک اِسرائیلی مَوشہ اَور سَب لوگوں کی آنکھوں کے سامنے ایک مِدیانی عورت کو اَپنے خاندان میں لے آیا۔ <verse eid="NUM 25:6"/><verse number="7" style="v" sid="NUM 25:7"/>تَب الیعزرؔ کے بیٹے فِنحاسؔ نے جو اَہرونؔ کاہِنؔ کا پوتا تھا یہ دیکھا تو اُس نے جماعت میں سے اُٹھ کر ہاتھ میں ایک نیزہ لیا۔ <verse eid="NUM 25:7"/><verse number="8" style="v" sid="NUM 25:8"/>اَور اُس اِسرائیلی کے پیچھے پیچھے خیمہ میں داخل ہُوا اَور اُس نے اُس اِسرائیلی مَرد اَور اُس عورت دونوں کے پیٹ میں نیزہ بھونک دیا۔ تَب بنی اِسرائیل پر آئی ہُوئی وَبا جاتی رہی <verse eid="NUM 25:8"/><verse number="9" style="v" sid="NUM 25:9"/>اَور جتنے لوگ وَبا سے مَرے تھے اُن کی تعداد چوبیس ہزار تھی۔<verse eid="NUM 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 25:10"/>یَاہوِہ نے مَوشہ سے کہا، <verse eid="NUM 25:10"/><verse number="11" style="v" sid="NUM 25:11"/>”الیعزرؔ کے بیٹے فِنحاسؔ نے جو اَہرونؔ کاہِنؔ کا پوتا ہے میرے قہر کو بنی اِسرائیل پر سے ہٹا دیا کیونکہ اُس نے اُن کے درمیان میرے لیٔے اَپنی غیرت کا اَیسا مظاہرہ کیا کہ مَیں نے اَپنی غیرت کے جوش میں اُنہیں نابود نہیں کیا <verse eid="NUM 25:11"/><verse number="12" style="v" sid="NUM 25:12"/>اِس لیٔے اُس سے کہہ کہ میں اُس کے ساتھ اَپنا عہدِ اَمن باندھ رہا ہُوں۔ <verse eid="NUM 25:12"/><verse number="13" style="v" sid="NUM 25:13"/>وہ اُس کے اَور اُس کی اَولاد کے لیٔے دائمی کہانت کا عہد ہوگا کیونکہ وہ اَپنے خُدا کے واسطے غیرت مند ہُوا اَور اُس نے بنی اِسرائیل کے لیٔے کفّارہ دیا۔“<verse eid="NUM 25:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 25:14"/>اُس اِسرائیلی مَرد کا نام جو اُس مِدیانی عورت کے ساتھ مارا گیا وہ زِمریؔ تھا جو شمعُونؔ کے خاندان کا سردار سالوؔ کا بیٹا تھا۔ <verse eid="NUM 25:14"/><verse number="15" style="v" sid="NUM 25:15"/>اَور اُس مِدیانی عورت کا نام جو ماری گئی تھی کوزبیؔ تھا۔ وہ ضُورؔ کی بیٹی تھی جو ایک مِدیانی خاندان کا قبائلی سردار تھا۔<verse eid="NUM 25:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 25:16"/>یَاہوِہ نے مَوشہ سے کہا، <verse eid="NUM 25:16"/><verse number="17" style="v" sid="NUM 25:17"/>”مِدیانیوں کو حریف جان کر مار ڈالو۔ <verse eid="NUM 25:17"/><verse number="18" style="v" sid="NUM 25:18"/>کیونکہ اُنہُوں نے بھی جَب تُمہیں دھوکا دیا تو حریف ہی جانا جَیسا پعورؔ کے مُعاملہ میں اَور اُن کی بہن کوزبیؔ کے مُعاملہ میں ہُوا جو مِدیانی سردار کی بیٹی تھی اَور اُس وَبا میں جو پعورؔ کے سبب پھیلی تھی ماری گئی تھی۔“<verse eid="NUM 25:18"/></para>
  <chapter eid="NUM 25"/>
  <chapter number="26" style="c" sid="NUM 26"/>
  <para style="s1">دُوسری مردُم شماری</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 26:1"/>وَبا کے بعد یَاہوِہ نے مَوشہ اَور اَہرونؔ کاہِنؔ کے بیٹے الیعزرؔ سے کہا، <verse eid="NUM 26:1"/><verse number="2" style="v" sid="NUM 26:2"/>”بنی اِسرائیل کی ساری جماعت میں بیس سال یا اُس سے زِیادہ عمر کے جتنے لوگ اِسرائیلی لشکر میں خدمت کرنے کے قابل ہُوں اُن سَب کی اُن کے آبائی خاندانوں کے مُطابق مردُم شُماری کرنا۔“ <verse eid="NUM 26:2"/><verse number="3" style="v" sid="NUM 26:3"/>چنانچہ مَوشہ اَور الیعزرؔ کاہِنؔ مُوآب کے میدانوں میں یردنؔ کے کنارے یریحوؔ کے مقابل اُن سے مُخاطِب ہویٔے اَور کہا: <verse eid="NUM 26:3"/><verse number="4" style="v" sid="NUM 26:4"/>”بیس سال یا اُس سے زِیادہ عمر کے آدمیوں کی مردُم شُماری کرو جَیسا یَاہوِہ نے مَوشہ کو حُکم دیا ہے۔“</para>
  <para style="b" vid="NUM 26:4"/>
  <para style="lh" vid="NUM 26:4">یہ وہ اِسرائیلی تھے جو مُلک مِصر سے نکل آئےتھے:<verse eid="NUM 26:4"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="5" style="v" sid="NUM 26:5"/>اِسرائیل کے پہلوٹھے رُوبِنؔ کے بیٹے یہ تھے:</para>
  <para style="li2" vid="NUM 26:5">حنوخؔ جِس سے حنوخیوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:5">پلوّؔ جِس سے پلّویوں کی برادری چلی؛<verse eid="NUM 26:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="NUM 26:6"/>حِضرونؔ جِس سے حضرونیوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:6">اَور کرمی جِس سے کرمیوں کی برادری چلی؛<verse eid="NUM 26:6"/></para>
  <para style="lf">
    <verse number="7" style="v" sid="NUM 26:7"/>یہ رُوبِنیوں کی برادری والے تھے اَور اُن میں سے جو شُمار کئے گیٔے اُن کی تعداد 43,730 تھی۔<verse eid="NUM 26:7"/></para>
  <para style="li2">
    <verse number="8" style="v" sid="NUM 26:8"/>پلوّؔ کا بیٹا اِلیابؔ تھا، <verse eid="NUM 26:8"/><verse number="9" style="v" sid="NUM 26:9"/>اَور اِلیابؔ کے بیٹے نموایل داتنؔ اَور ابیرامؔ ہیں جو جماعت کے نُمائندے تھے جنہوں نے مَوشہ اَور اَہرونؔ کے خِلاف سرکشی کی تھی اَور قورحؔ کے پیروکاروں میں سے تھے جَب اُنہُوں نے یَاہوِہ کے خِلاف سرکشی کی تھی۔ <verse eid="NUM 26:9"/><verse number="10" style="v" sid="NUM 26:10"/>زمین نے اَپنا مُنہ کھولا اَور اُنہیں قورحؔ سمیت نگل گئی اَور اُس کے پیروکار اُس وقت مَر گیٔے جَب آگ نے ڈھائی سَو لوگوں کو بھسم کیا اَور وہ ایک عِبرت کا نِشان ٹھہرے۔ <verse eid="NUM 26:10"/><verse number="11" style="v" sid="NUM 26:11"/>البتّہ قورحؔ کے سارے بیٹے نہیں مَرے تھے۔<verse eid="NUM 26:11"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 26:12"/>شمعُونؔ کے بیٹے اَپنی برادریوں کے مُطابق یہ تھے:</para>
  <para style="li2" vid="NUM 26:12">نموایل جِس سے نموایلیوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:12">یمینؔ جِس سے یمینیوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:12">یاکِن جِس سے یکینیوں کی برادری چلی؛<verse eid="NUM 26:12"/></para>
  <para style="li2">
    <verse number="13" style="v" sid="NUM 26:13"/>زیراحؔ جِس سے زیراحیوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:13">اَور شاؤل جِس سے شاؤلیوں کی برادری چلی۔<verse eid="NUM 26:13"/></para>
  <para style="lf">
    <verse number="14" style="v" sid="NUM 26:14"/>یہ بنی شمعُونؔ کی برادری کے تھے۔ اِن میں آدمیوں کی تعداد 22,200 تھی۔<verse eid="NUM 26:14"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="15" style="v" sid="NUM 26:15"/>گادؔ کے بیٹے اَپنی برادری کے مُطابق یہ تھے:</para>
  <para style="li2" vid="NUM 26:15">ضِفونؔ جِس سے ضِفونی کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:15">حگّیؔ جِس سے حگّیوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:15">شُونی، جِس سے شُونیوں کی برادری چلی؛<verse eid="NUM 26:15"/></para>
  <para style="li2">
    <verse number="16" style="v" sid="NUM 26:16"/>اُزنی جِس سے اُزنیوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:16">عیری، جِس سے عیریوں کی برادری چلی؛<verse eid="NUM 26:16"/></para>
  <para style="li2">
    <verse number="17" style="v" sid="NUM 26:17"/>اَرود، جِس سے اَرودیوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:17">اَور اَریلی جِس سے اَریلیوں کی برادری چلی۔<verse eid="NUM 26:17"/></para>
  <para style="lf">
    <verse number="18" style="v" sid="NUM 26:18"/>یہ بنی گادؔ کی برادری کے تھے اَور اُن میں سے جو شُمار کئے گیٔے اُن کی تعداد 40,500 تھی۔<verse eid="NUM 26:18"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="19" style="v" sid="NUM 26:19"/>عیرؔ اَور اَونانؔ یہُوداہؔ کے بیٹے تھے لیکن وہ مُلکِ کنعانؔ میں مَر گیٔے۔<verse eid="NUM 26:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 26:20"/>یہُوداہؔ کے بیٹے اَپنی برادریوں کے مُطابق یہ تھے:</para>
  <para style="li2" vid="NUM 26:20">شِلحؔ جِس سے شیلانیوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:20">پیریزؔ جِس سے پیریزیوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:20">اَور زیراحؔ جِس سے زیراحیوں کی برادری چلی۔<verse eid="NUM 26:20"/></para>
  <para style="li2">
    <verse number="21" style="v" sid="NUM 26:21"/>پیریزؔ کے بیٹے یہ تھے:</para>
  <para style="li3" vid="NUM 26:21">حِضرونؔ جِس سے حضرونیوں کی برادری چلی؛</para>
  <para style="li3" vid="NUM 26:21">حمُولؔ جِس سے حمُولیوں کی برادری چلی؛<verse eid="NUM 26:21"/></para>
  <para style="lf">
    <verse number="22" style="v" sid="NUM 26:22"/>یہ یہُوداہؔ کی برادری کے تھے اَور اُن میں سے جو شُمار کئے گیٔے اُن کی تعداد 76,500 تھی۔<verse eid="NUM 26:22"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="23" style="v" sid="NUM 26:23"/>یِسَّکاؔر کے بیٹے اَپنے برادریوں کے مُطابق یہ تھے:</para>
  <para style="li2" vid="NUM 26:23">تولعؔ جِس سے تولعیوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:23">پُوّہؔ جِس سے پُوّہیوں کی برادری چلی؛<verse eid="NUM 26:23"/></para>
  <para style="li2">
    <verse number="24" style="v" sid="NUM 26:24"/>یَعشُوبؔ جِس سے یَعشُوبیوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:24">اَور شِمرون جِس سے شِمرونیوں کی برادری چلی۔<verse eid="NUM 26:24"/></para>
  <para style="lf">
    <verse number="25" style="v" sid="NUM 26:25"/>یہ یِسَّکاؔر کی برادری کے تھے۔ اِن میں سے جو شُمار کئے گیٔے اُن کی تعداد 64,300 تھی۔<verse eid="NUM 26:25"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="26" style="v" sid="NUM 26:26"/>زبُولُون کے بیٹے اَپنی برادریوں کے مُطابق یہ تھے:</para>
  <para style="li2" vid="NUM 26:26">سرد جِس سے سردیوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:26">ایلون جِس سے ایلونیوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:26">اَور یحلی ایل جِس سے یحلی ایلی قبیلہ کی برادری چلی۔<verse eid="NUM 26:26"/></para>
  <para style="lf">
    <verse number="27" style="v" sid="NUM 26:27"/>یہ زبُولُونیوں کی برادری کے تھے۔ اِن میں سے جو شُمار کئے گیٔے اُن کی تعداد 60,500 تھی۔<verse eid="NUM 26:27"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="28" style="v" sid="NUM 26:28"/>یُوسیفؔ کے بیٹے اَپنی برادریوں کے مُطابق منشّہ اَور اِفرائیمؔ تھے۔<verse eid="NUM 26:28"/></para>
  <para style="lh">
    <verse number="29" style="v" sid="NUM 26:29"/>منشّہ کے بیٹے یہ تھے:</para>
  <para style="li2" vid="NUM 26:29">مکیرؔ جِس سے مکیریوں کی برادری چلی (مکیرؔ سے گِلعادؔ پیدا ہُوا تھا)؛</para>
  <para style="li2" vid="NUM 26:29">گِلعادؔ سے گِلعادیوں کی برادری چلی؛<verse eid="NUM 26:29"/></para>
  <para style="li2">
    <verse number="30" style="v" sid="NUM 26:30"/>گِلعادؔ کے بیٹے یہ ہیں:</para>
  <para style="li3" vid="NUM 26:30">اِیعزرؔ جِس سے اِیعزریوں کی برادری چلی؛</para>
  <para style="li3" vid="NUM 26:30">حِلقؔ جِس سے حِلقیوں کی برادری چلی؛<verse eid="NUM 26:30"/></para>
  <para style="li3">
    <verse number="31" style="v" sid="NUM 26:31"/>اَسری ایل، جِس اَسری ایلیوں کی برادری چلی؛</para>
  <para style="li3" vid="NUM 26:31">شِکیمؔ جِس سے شِکیمؔی برادری چلی؛<verse eid="NUM 26:31"/></para>
  <para style="li3">
    <verse number="32" style="v" sid="NUM 26:32"/>شمیدعؔ جِس سے شمیدعیوں کی برادری چلی؛</para>
  <para style="li3" vid="NUM 26:32">اَور حِفرؔ جِس سے حِفریوں کی برادری چلی۔<verse eid="NUM 26:32"/></para>
  <para style="li3">
    <verse number="33" style="v" sid="NUM 26:33"/>(ضلافحادؔ بِن حِفرؔ کے ہاں کویٔی بیٹا پیدا نہ ہُوا بَلکہ صِرف بیٹیاں ہی ہُوئیں جِن کے نام محلاہؔ، نوحؔا، حُگلاہؔ، مِلکاہؔ اَور تِرضاؔہ تھے۔)<verse eid="NUM 26:33"/></para>
  <para style="lf">
    <verse number="34" style="v" sid="NUM 26:34"/>یہ منشّہیوں کی برادری کے تھے۔ اِن میں سے جو شُمار کئے گیٔے اُن کی تعداد 52,700 تھی۔<verse eid="NUM 26:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="NUM 26:35"/>اِفرائیمؔ کے بیٹے اَپنی برادریوں کے مُطابق یہ تھے:</para>
  <para style="li2" vid="NUM 26:35">شُوتلحؔ جِس سے شُوتلحیوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:35">بِکیؔر جِس سے بِکیریوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:35">اَور تحنؔ جِس سے تحنیوں کی برادری چلی۔<verse eid="NUM 26:35"/></para>
  <para style="li2">
    <verse number="36" style="v" sid="NUM 26:36"/>شُوتلحؔ کے بیٹے یہ تھے:</para>
  <para style="li3" vid="NUM 26:36">عیرانؔ جِس سے عیرانیوں کی برادری چلی۔<verse eid="NUM 26:36"/></para>
  <para style="lf">
    <verse number="37" style="v" sid="NUM 26:37"/>یہ بنی اِفرائیمؔ کی برادری کے تھے۔ اِن میں سے جو شُمار کئے گیٔے اُن کی تعداد 32,500 تھی۔</para>
  <para style="lf" vid="NUM 26:37">یُوسیفؔ کے بیٹوں کی برادری کے یہی ہیں۔<verse eid="NUM 26:37"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 26:38"/>بِنیامین کے بیٹے کی برادری کے مُطابق یہ تھے:</para>
  <para style="li2" vid="NUM 26:38">بَیلعؔ، جِس سے بَیلعیوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:38">اَشبیلؔ، جِس سے اَشبیلیوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:38">اخِیرامؔ، جِس سے اخِیرامیوں کی برادری چلی۔<verse eid="NUM 26:38"/></para>
  <para style="li2">
    <verse number="39" style="v" sid="NUM 26:39"/>شُوفامؔ جِس سے شُوفامیوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:39">اَور حُوپامؔ جِس سے حُوپامیوں کی برادری چلی۔<verse eid="NUM 26:39"/></para>
  <para style="li2">
    <verse number="40" style="v" sid="NUM 26:40"/>بَیلعؔ کے دو بیٹے اردؔ اَور نَعمانؔ تھے۔</para>
  <para style="li3" vid="NUM 26:40">اردؔ سے اَردیوں کی برادری چلی</para>
  <para style="li3" vid="NUM 26:40">اَور نَعمانؔ سے نَعمانیوں کی برادری چلی۔<verse eid="NUM 26:40"/></para>
  <para style="lf">
    <verse number="41" style="v" sid="NUM 26:41"/>یہ بنی بِنیامین کی برادری کے تھے۔ اِن میں سے جو شُمار کئے گیٔے اُن کی تعداد 45,600 تھی۔<verse eid="NUM 26:41"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="42" style="v" sid="NUM 26:42"/>دانؔ کے بیٹے کی برادری کے مُطابق یہ تھے:</para>
  <para style="li2" vid="NUM 26:42">شُوحامؔ جِس سے شُوحامیوں کی برادری چلی؛</para>
  <para style="lf" vid="NUM 26:42">یہ دانیوں کی برادری کے تھے۔ <verse eid="NUM 26:42"/><verse number="43" style="v" sid="NUM 26:43"/>وہ سبھی شُوحامیوں کی برادری کے تھے اَور اُن میں سے جو شُمار کئے گیٔے اُن کی تعداد 64,400 تھی۔<verse eid="NUM 26:43"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="44" style="v" sid="NUM 26:44"/>آشیر کے بیٹے کی برادری کے مُطابق یہ تھے:</para>
  <para style="li2" vid="NUM 26:44">یِمنہؔ جِس سے یمنیوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:44">اِشویؔ جِس سے اِشویوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:44">اَور بریعہؔ جِس سے بریعاہیوں کی برادری چلی۔<verse eid="NUM 26:44"/></para>
  <para style="li2">
    <verse number="45" style="v" sid="NUM 26:45"/>اَور بنی بریعہؔ یہ ہیں:</para>
  <para style="li3" vid="NUM 26:45">حِبرؔ جِس سے حِبری کی برادری چلی؛</para>
  <para style="li3" vid="NUM 26:45">اَور مَلکی ایل جِس سے مَلکی ایلیوں کی برادری چلی۔<verse eid="NUM 26:45"/></para>
  <para style="lf">
    <verse number="46" style="v" sid="NUM 26:46"/>(آشیر کی ایک بیٹی تھی جِس کا نام سراحؔ تھا۔)<verse eid="NUM 26:46"/></para>
  <para style="lf">
    <verse number="47" style="v" sid="NUM 26:47"/>یہ آشیریوں کی برادری کے تھے۔ اِن میں سے جو شُمار کئے گیٔے اُن کی تعداد 53,400 تھی۔<verse eid="NUM 26:47"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="48" style="v" sid="NUM 26:48"/>نفتالی کے بیٹے اَپنی برادری کے مُطابق یہ تھے:</para>
  <para style="li2" vid="NUM 26:48">یحصیل جِس سے یحصیلیوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:48">گُونی جِس سے گُونیوں کی برادری چلی؛<verse eid="NUM 26:48"/></para>
  <para style="li2">
    <verse number="49" style="v" sid="NUM 26:49"/>یصر جِس سے یصریوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:49">اَور شِلّیمؔ جِس سے شِلّیمیوں کی برادری چلی۔<verse eid="NUM 26:49"/></para>
  <para style="lf">
    <verse number="50" style="v" sid="NUM 26:50"/>یہ بنی نفتالی کی برادری کے تھے۔ اِن میں سے جو شُمار کئے گیٔے اُن کی تعداد 45,400 تھی۔<verse eid="NUM 26:50"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="51" style="v" sid="NUM 26:51"/>بنی اِسرائیل کے جِن لوگوں کا شُمار کیا گیا اُن کی کُل تعداد 6,01,730 تھی۔<verse eid="NUM 26:51"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="52" style="v" sid="NUM 26:52"/>یَاہوِہ نے مَوشہ سے کہا، <verse eid="NUM 26:52"/><verse number="53" style="v" sid="NUM 26:53"/>”اُنہیں اُن کے ناموں کے شُمار کے مُطابق وہ زمین مِیراث کے طور پر بانٹ دی جائے۔ <verse eid="NUM 26:53"/><verse number="54" style="v" sid="NUM 26:54"/>بڑے گِروہ کو زِیادہ حِصّہ دیا جائے اَور چُھوٹے گِروہ کو کم۔ ہر ایک کو اُن کے درج کئے ہویٔے ناموں کی تعداد کے مُطابق مِیراث ملے۔ <verse eid="NUM 26:54"/><verse number="55" style="v" sid="NUM 26:55"/>خیال رہے کہ زمین قُرعہ اَندازی کے ذریعہ تقسیم کی جائے۔ ہر قبیلہ جو بھی مِیراث پایٔے وہ اُس کے آبائی قبیلہ کے ناموں کے مُطابق ہو۔ <verse eid="NUM 26:55"/><verse number="56" style="v" sid="NUM 26:56"/>اَور ہر مِیراث بڑے اَور چُھوٹے گِروہوں میں قُرعہ اَندازی کے ذریعہ تقسیم کی جائے۔“<verse eid="NUM 26:56"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="57" style="v" sid="NUM 26:57"/>بنی لیوی جو اَپنی اَپنی برادریوں کے مُطابق شُمار کئے گیٔے یہ ہیں:</para>
  <para style="li2" vid="NUM 26:57">گیرشون جِس سے گیرشونیوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:57">قُہات جِس سے قُہاتیوں کی برادری چلی؛</para>
  <para style="li2" vid="NUM 26:57">مِراریؔ جِس سے مِراریوں کی برادری چلی۔<verse eid="NUM 26:57"/></para>
  <para style="li1">
    <verse number="58" style="v" sid="NUM 26:58"/>یہ بھی لیویوں ہی کی برادری کے تھے:</para>
  <para style="li2" vid="NUM 26:58">لبنیوں کی برادری،</para>
  <para style="li2" vid="NUM 26:58">حِبرونیوں کی برادری،</para>
  <para style="li2" vid="NUM 26:58">محلیوں کی برادری،</para>
  <para style="li2" vid="NUM 26:58">مُوشیوں کی برادری،</para>
  <para style="li2" vid="NUM 26:58">قورحؔیوں کی برادری۔</para>
  <para style="li2" vid="NUM 26:58">(قُہات عمرامؔ کا آباؤاَجداد تھا۔ <verse eid="NUM 26:58"/><verse number="59" style="v" sid="NUM 26:59"/>عمرامؔ کی بیوی کا نام یوکبِدؔ تھا جو لیوی کی نَسل سے تھی اَور مِصر میں لیوی کے ہاں پیدا ہُوئی تھی۔ اُن کے ہاں اَہرونؔ، مَوشہ اَور اُن کی بہن مِریمؔ عمرام سے پیدا ہویٔے۔ <verse eid="NUM 26:59"/><verse number="60" style="v" sid="NUM 26:60"/>اَور اَہرونؔ سے نادابؔ، اَبِیہُو، الیعزرؔ اَور اِتمارؔ پیدا ہویٔے۔ <verse eid="NUM 26:60"/><verse number="61" style="v" sid="NUM 26:61"/>لیکن نادابؔ اَور اَبِیہُو تو اُس وقت مَر گیٔے جَب اُنہُوں نے یَاہوِہ کے حُضُور میں ناجائز آگ کا نذرانہ چڑھایا۔)<verse eid="NUM 26:61"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="62" style="v" sid="NUM 26:62"/>لیویوں کے سبھی نرینہ فرزندوں کی تعداد جو ایک ماہ یا اُس سے زِیادہ عمر کے تھے 23,000 تھی۔ وہ بنی اِسرائیل کے ساتھ اِس لیٔے نہیں گنے گیٔے کیونکہ اُنہیں اُن کے ساتھ مِیراث نہ مِلی تھی۔<verse eid="NUM 26:62"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="63" style="v" sid="NUM 26:63"/>یہی وہ اِسرائیلی لوگ ہیں جنہیں مَوشہ اَور الیعزرؔ کاہِنؔ نے مُوآب کے میدانوں میں یردنؔ کے کنارے پر یریحوؔ کے مقابل گِنا تھا۔ <verse eid="NUM 26:63"/><verse number="64" style="v" sid="NUM 26:64"/>لیکن اُن میں سے ایک بھی اُن اِسرائیلیوں میں شامل نہ تھا جنہیں مَوشہ اَور اَہرونؔ کاہِنؔ نے سِینؔائی کے بیابان میں شُمار کیا تھا۔ <verse eid="NUM 26:64"/><verse number="65" style="v" sid="NUM 26:65"/>کیونکہ یَاہوِہ نے اُن اِسرائیلیوں کو کہہ دیا تھا کہ وہ یقیناً بیابان میں مَر جایٔیں گے اَور یفُنّہؔ کے بیٹے کالبؔ اَور یہوشُعؔ بِن نُونؔ کے سِوا اُن میں ایک بھی باقی نہیں بچا تھا۔<verse eid="NUM 26:65"/></para>
  <chapter eid="NUM 26"/>
  <chapter number="27" style="c" sid="NUM 27"/>
  <para style="s1">ضلافحادؔ کی بیٹیاں</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 27:1"/>ضلافحادؔ بِن حِفرؔ گِلعادؔ کا پوتا اَور منشّہ کے بیٹے مکیرؔ کا پرپوتا تھا۔ اُس کی بیٹیاں یُوسیفؔ کے بیٹے منشّہ کی برادری کی نَسل سے تھیں۔ اُن بیٹیوں کے نام محلاہؔ نوحؔا حُگلاہؔ مِلکاہؔ اَور تِرضاؔہ تھے۔ وہ آئیں اَور <verse eid="NUM 27:1"/><verse number="2" style="v" sid="NUM 27:2"/>خیمہ اِجتماع کے دروازہ پر مَوشہ الیعزرؔ کاہِنؔ سربراہوں اَور ساری جماعت کے سامنے کھڑی ہوکر کہنے لگیں: <verse eid="NUM 27:2"/><verse number="3" style="v" sid="NUM 27:3"/>”ہمارا باپ بیابان میں مَر گیا۔ وہ قورحؔ کے اُن پیروکاروں میں سے نہ تھا جنہوں نے یَاہوِہ کے خِلاف سرکشی کی تھی بَلکہ وہ اَپنے ہی گُناہ میں مَرا اَور اُس کے کویٔی بیٹا نہ تھا۔ <verse eid="NUM 27:3"/><verse number="4" style="v" sid="NUM 27:4"/>چنانچہ بیٹا نہ ہونے کے باعث ہمارے باپ کا نام اُس کی برادری سے کیوں مِٹ جائے؟ لہٰذا ہمیں بھی ہمارے باپ کے رشتہ داروں کے ساتھ مِیراث میں حِصّہ دو۔“<verse eid="NUM 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 27:5"/>چنانچہ مَوشہ اُن کا مُعاملہ یَاہوِہ کے حُضُور لے گیا <verse eid="NUM 27:5"/><verse number="6" style="v" sid="NUM 27:6"/>اَور یَاہوِہ نے مَوشہ سے کہا: <verse eid="NUM 27:6"/><verse number="7" style="v" sid="NUM 27:7"/>”ضلافحادؔ کی بیٹیاں ٹھیک کہتی ہیں۔ تُو اُنہیں اُن کے باپ کے رشتہ داروں کے درمیان ضروُر ہی کچھ جائداد بطور مِیراث دینا۔ پس اُن کے باپ کی مِیراث اُن کے سُپرد کر دے۔<verse eid="NUM 27:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 27:8"/>”اَور بنی اِسرائیل سے کہہ، ’اگر کویٔی آدمی مَر جائے اَور اُس کا کویٔی بیٹا نہ ہو تو اُس کی مِیراث اُس کی بیٹی کو دینا۔ <verse eid="NUM 27:8"/><verse number="9" style="v" sid="NUM 27:9"/>اگر اُس کی کویٔی بیٹی بھی نہ ہو تو اُس کی مِیراث اُس کے بھائیوں کو دینا۔ <verse eid="NUM 27:9"/><verse number="10" style="v" sid="NUM 27:10"/>اَور اگر اُس کے کویٔی بھایٔی بھی نہ ہوں تو اُس کی مِیراث اُس کے باپ کے بھائیوں کو دینا۔ <verse eid="NUM 27:10"/><verse number="11" style="v" sid="NUM 27:11"/>اگر اُس کے باپ کے بھایٔی بھی نہ ہوں تو اُس برادری میں جو بھی اُس کا سَب سے قریبی رشتہ دار ہو اُسے اُس کی مِیراث دینا تاکہ وہ اُس کی مِلکیّت بَن جائے اَور یہ بنی اِسرائیل کے لیٔے آئین یَاہوِہ کے مَوشہ کو دئیے ہویٔے حُکم کے مُطابق شَرعی فرض ہوگا۔‘ “<verse eid="NUM 27:11"/></para>
  <para style="s1">مُوسیٰ کے جانشین کے طور پر یہوشُعؔ کی تقرّری</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 27:12"/>تَب یَاہوِہ نے مَوشہ سے فرمایا، ”تُو اُس عباریمؔ پہاڑ پر چڑھ کر اُس مُلک کو دیکھ جو مَیں نے بنی اِسرائیل کو عطا کیا ہے۔ <verse eid="NUM 27:12"/><verse number="13" style="v" sid="NUM 27:13"/>اُسے دیکھ لینے کے بعد تُو بھی اَپنے بھایٔی اَہرونؔ کی طرح اَپنے لوگوں میں جا ملے گا۔ <verse eid="NUM 27:13"/><verse number="14" style="v" sid="NUM 27:14"/>کیونکہ جَب صینؔ کے بیابان میں پانی کے چشمہ کے پاس جماعت نے سرکشی کی تھی تَب تُم دونوں نے میرا حُکم نہ مانا اَور اُن کی آنکھوں کے سامنے میری تقدیس نہ کی۔“ (یہ وُہی مریبہؔ کا چشمہ ہے جو صینؔ کے بیابان قادِسؔ میں ہے۔)<verse eid="NUM 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 27:15"/>مَوشہ نے یَاہوِہ سے کہا، <verse eid="NUM 27:15"/><verse number="16" style="v" sid="NUM 27:16"/>”یَاہوِہ! تمام نَوع اِنسان کی رُوحوں کے خُدا کسی آدمی کو اِس جماعت پر ایک نِگراں مُقرّر کرنا <verse eid="NUM 27:16"/><verse number="17" style="v" sid="NUM 27:17"/>جو اُن کے سامنے آیا جایا کرے اَورجو اُنہیں باہر لے جانے اَور اَندر لانے میں اُن کا رہبر ہو تاکہ یَاہوِہ کی جماعت اُن بھیڑوں کی طرح نہ ہو جِن کا کویٔی چرواہا نہیں ہوتا۔“<verse eid="NUM 27:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 27:18"/>چنانچہ یَاہوِہ نے مَوشہ سے فرمایا، ”تُو یہوشُعؔ بِن نُونؔ کو جو رُوح سے معموُر ہے لے اَور اُس پر اَپنا ہاتھ رکھ۔ <verse eid="NUM 27:18"/><verse number="19" style="v" sid="NUM 27:19"/>اُسے الیعزرؔ کاہِنؔ اَور ساری جماعت کے سامنے کھڑا کر اَور اُن کے سامنے اُسے اِختیار دے۔ <verse eid="NUM 27:19"/><verse number="20" style="v" sid="NUM 27:20"/>اَپنے کچھ اِختیارات اُس کے سُپرد کردینا تاکہ بنی اِسرائیل کی ساری جماعت اُس کی اِطاعت کرے۔ <verse eid="NUM 27:20"/><verse number="21" style="v" sid="NUM 27:21"/>وہ الیعزرؔ کاہِنؔ کے سامنے کھڑا ہُوا کرے جو یَاہوِہ کے حُضُور اُس کی خاطِر اُوریمؔ کا حُکم دریافت کیا کرےگا۔ اِسی کے حُکم سے وہ اَور بنی اِسرائیل کی ساری جماعت باہر جایا کریں اَور اُسی کے حُکم سے وہ اَندر آئیں۔“<verse eid="NUM 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 27:22"/>چنانچہ مَوشہ نے یَاہوِہ کے حُکم کے مُطابق عَمل کیا۔ اُس نے یہوشُعؔ کو لیا اَور الیعزرؔ کاہِنؔ اَور ساری جماعت کے سامنے کھڑا کیا۔ <verse eid="NUM 27:22"/><verse number="23" style="v" sid="NUM 27:23"/>تَب یَاہوِہ نے جو ہدایات مَوشہ کی مَعرفت دی تھیں اُن کے مُطابق اُس نے اَپنے ہاتھ یہوشُعؔ پر رکھے اَور اُسے اِختیار بخشا۔<verse eid="NUM 27:23"/></para>
  <chapter eid="NUM 27"/>
  <chapter number="28" style="c" sid="NUM 28"/>
  <para style="s1">روزمرّہ کی قُربانیاں</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 28:1"/>یَاہوِہ نے مَوشہ سے کہا: <verse eid="NUM 28:1"/><verse number="2" style="v" sid="NUM 28:2"/>”بنی اِسرائیل کو یہ حُکم سُنانا اَور اُن سے کہنا، ’تُم میری نذر، یعنی میری وہ غِذا جو میرے لیٔے فرحت بخش خُوشبو والی آتِشی قُربانی ہے مُقرّرہ وقت پر یاد سے پیش کرتے رہنا۔‘ <verse eid="NUM 28:2"/><verse number="3" style="v" sid="NUM 28:3"/>اُن سے کہہ کہ یَاہوِہ کے لیٔے تُم جو آتِشی قُربانی پیش کرو وہ یہ ہے: ہر روز حسبِ معمول دو بے عیب یک سالہ برّے سوختنی نذر کے طور پر چڑھایا کرنا۔ <verse eid="NUM 28:3"/><verse number="4" style="v" sid="NUM 28:4"/>ایک برّہ صُبح کو اَور دُوسرا شام کو چڑھانا۔ <verse eid="NUM 28:4"/><verse number="5" style="v" sid="NUM 28:5"/>اَور ساتھ ہی ایفہ کے دسویں حِصّہ<note caller="+" style="f"><char style="fr" closed="false">28‏:5 </char><char style="fq" closed="false">ایفہ کے دسویں حِصّہ </char><char style="ft" closed="false">تقریباً ایک کِلو چھ سَو گرام</char></note> کے برابر مَیدہ میں چوتھائی ہین<note caller="+" style="f"><char style="fr" closed="false">28‏:5 </char><char style="fq" closed="false">چوتھائی ہین </char><char style="ft" closed="false">تقریباً ایک لیٹر</char></note> کُوٹ کر نکالا ہُوا زَیتُون کا تیل مِلا کر اناج کی قُربانی کے طور پر پیش کرنا۔ <verse eid="NUM 28:5"/><verse number="6" style="v" sid="NUM 28:6"/>یہ وُہی دائمی سوختنی نذر ہے جو کوہِ سِینؔائی پر مُقرّر کی گئی تھی تاکہ یَاہوِہ کے حُضُور فرحت بخش خُوشبو دینے والی آتِشی قُربانی ٹھہرے۔ <verse eid="NUM 28:6"/><verse number="7" style="v" sid="NUM 28:7"/>اَور اُس کے ساتھ فی برّہ کے ساتھ ہین کا چوتھائی حِصّہ مَے انگوری شِیرہ کے طور پر لائی جائے۔ یہ انگوری شِیرہ یَاہوِہ کے لیٔے پاک مَقدِس میں چڑھانا۔ <verse eid="NUM 28:7"/><verse number="8" style="v" sid="NUM 28:8"/>دُوسرا برّہ شام کے جھٹپٹے کے وقت چڑھانا اَور اُس کے ساتھ بھی صُبح کی طرح اناج کی قُربانی اَور انگوری شِیرے کی نذر ہو۔ یہ یَاہوِہ کے حُضُور غِذا کی فرحت بخش خُوشبو والی آتِشی قُربانی ہوگی۔<verse eid="NUM 28:8"/></para>
  <para style="s1">سَبت کی قُربانی</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 28:9"/>” ’اَور سَبت کے دِن دو بے عیب یک سالہ برّے اَور ایفہ کا پانچواں<note caller="+" style="f"><char style="fr" closed="false">28‏:9 </char><char style="fq" closed="false">ایفہ کا پانچواں </char><char style="ft" closed="false">تقریباً سَوا تین کِلوگرام</char></note> حِصّہ تیل مِلا ہُوا مَیدہ تپاون کے ساتھ اناج کی قُربانی کے طور پر پیش کرنا۔ <verse eid="NUM 28:9"/><verse number="10" style="v" sid="NUM 28:10"/>حسبِ معمول پیش کی جانے والی سوختنی نذر اَور اُس کے تپاون کے علاوہ یہ ہر سَبت کی سوختنی نذر ہے۔<verse eid="NUM 28:10"/></para>
  <para style="s1">ماہانہ قُربانیاں</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 28:11"/>” ’ہر مہینے کے پہلے دِن دو بچھڑے، ایک مینڈھا اَور سات یک سالہ نر برّے جو سَب کے سَب بے عیب ہُوں سوختنی نذر کے طور پر یَاہوِہ کے حُضُور میں چڑھایا کرنا۔ <verse eid="NUM 28:11"/><verse number="12" style="v" sid="NUM 28:12"/>ہر بچھڑے کے ساتھ ایفہ کا تین دہائی حِصّہ<note caller="+" style="f"><char style="fr" closed="false">28‏:12 </char><char style="fq" closed="false">ایفہ کا تین دہائی حِصّہ </char><char style="ft" closed="false">تقریباً ایک کِلو پانچ سو گرام</char></note> اناج کی نذر تیل مِلا ہُوا مَیدہ اَور ہر مینڈھے کے ساتھ ایفہ کا پانچواں حِصّہ اناج کی نذر تیل مِلا ہُوا مَیدہ؛ <verse eid="NUM 28:12"/><verse number="13" style="v" sid="NUM 28:13"/>اَور ہر برّہ کے ساتھ ایفہ کا دسواں حِصّہ تیل مِلا ہُوا مَیدہ اناج کی قُربانی کے طور پر پیش کرنا۔ یہ سوختنی نذر یَاہوِہ کے لیٔے فرحت بخش خُوشبو دینے والی آتِشی قُربانی ٹھہرے۔ <verse eid="NUM 28:13"/><verse number="14" style="v" sid="NUM 28:14"/>ہر بچھڑے کے ساتھ نِصف ہین<note caller="+" style="f"><char style="fr" closed="false">28‏:14 </char><char style="fq" closed="false">نِصف ہین </char><char style="ft" closed="false">تقریباً 1.9لیٹر</char></note> ہر مینڈھے کے ساتھ ایک تہائی ہین<note caller="+" style="f"><char style="fr" closed="false">28‏:14 </char><char style="fq" closed="false">ایک تہائی ہین </char><char style="ft" closed="false">تقریباً 1.3 لیٹر</char></note> اَور ہر برّہ کے ساتھ پاؤ ہین<note caller="+" style="f"><char style="fr" closed="false">28‏:14 </char><char style="fq" closed="false">پاؤ ہین </char><char style="ft" closed="false">تقریباً ایک لیٹر</char></note> مَے تپاون کے طور پر دی جائے۔ یہ ماہانہ سوختنی نذر ہے جو سال بھر ہر نئے چاند کے موقع پر پیش کی جائے۔ <verse eid="NUM 28:14"/><verse number="15" style="v" sid="NUM 28:15"/>حسبِ معمول پیش کی جانے والی سوختنی نذر اَور اُس کے ساتھ دئیے جانے والے تپاون کے علاوہ ایک بکرا یَاہوِہ کے لیٔے گُناہ کی قُربانی کے طور پر پیش کیا جائے۔<verse eid="NUM 28:15"/></para>
  <para style="s1">عیدِفسح کا جَشن</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 28:16"/>” ’پہلے مہینے کے چودھویں دِن یَاہوِہ کا فسح ہُوا کرے۔ <verse eid="NUM 28:16"/><verse number="17" style="v" sid="NUM 28:17"/>اَور اُسی مہینے کے پندرھویں دِن عید منائی جائے اَور سات دِن تک بے خمیری روٹی کھائی جائے۔ <verse eid="NUM 28:17"/><verse number="18" style="v" sid="NUM 28:18"/>پہلے دِن مُقدّس اِجتماع ہو اَور عام دِنوں کی طرح کویٔی کام بالکُل نہ کرنا۔ <verse eid="NUM 28:18"/><verse number="19" style="v" sid="NUM 28:19"/>اَور یَاہوِہ کے لیٔے آتِشی قُربانی پیش کی جائے جو دو بچھڑوں، ایک مینڈھے اَور سات یک سالہ نر برّوں کی سوختنی نذر پر مُشتمل ہو جو سَب کے سَب بے عیب ہُوں۔ <verse eid="NUM 28:19"/><verse number="20" style="v" sid="NUM 28:20"/>ہر بچھڑے کے ساتھ ایک ایفہ کا تین دہائی حِصّہ زَیتُون کا تیل اناج کی نذر مِلا ہُوا مَیدہ، ہر مینڈھے کے ساتھ ایفہ کا پانچواں حِصّہ زَیتُون کا تیل اناج کی نذر مِلا ہُوا مَیدہ؛ <verse eid="NUM 28:20"/><verse number="21" style="v" sid="NUM 28:21"/>اَور ساتوں برّوں میں سے ہر ایک کے ساتھ دسواں حِصّہ نذر کی قُربانی کے طور پر پیش کرنا۔ <verse eid="NUM 28:21"/><verse number="22" style="v" sid="NUM 28:22"/>گُناہ کی قُربانی کے طور پر ایک بکرے کا اِضافہ کرنا تاکہ اُس سے تمہارے لیٔے کفّارہ دیا جائے۔ <verse eid="NUM 28:22"/><verse number="23" style="v" sid="NUM 28:23"/>اُنہیں صُبح کو حسبِ معمول دی جانے والی سوختنی نذر کے علاوہ پیش کرنا۔ <verse eid="NUM 28:23"/><verse number="24" style="v" sid="NUM 28:24"/>اِسی طرح سات دِن تُم روزانہ آتِشی قُربانی کی یہ غِذا چڑھانا تاکہ وہ یَاہوِہ کے لیٔے فرحت بخش خُوشبو ٹھہرے۔ یہ حسبِ معمول دی جانے والی سوختنی نذر اَور اُس کے تپاون کے علاوہ پیش کی جائے۔ <verse eid="NUM 28:24"/><verse number="25" style="v" sid="NUM 28:25"/>ساتویں دِن پھر تمہارا مُقدّس اِجتماع ہو اَور حسبِ معمول کویٔی کام نہ کرنا۔<verse eid="NUM 28:25"/></para>
  <para style="s1">ہفتوں کی عید</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 28:26"/>” ’پہلے پھلوں کے دِن جَب تُم ہفتوں کی عید کے موقع پر یَاہوِہ کے لیٔے نئی نذر کی قُربانی پیش کرو تَب بھی تمہارا مُقدّس اِجتماع ہو اَور اُس روز بھی کویٔی حسبِ معمول کام اَنجام نہ دیا جائے۔ <verse eid="NUM 28:26"/><verse number="27" style="v" sid="NUM 28:27"/>اَور دو بچھڑے، ایک مینڈھا اَور سات یک سالہ نر برّے سوختنی نذر کے طور پر گذرانو جو یَاہوِہ کے لیٔے فرحت بخش خُوشبو ہو۔ <verse eid="NUM 28:27"/><verse number="28" style="v" sid="NUM 28:28"/>ہر بچھڑے کے ساتھ اناج کی نذر کی قُربانی کے طور پر ایفہ کا تین دہائی حِصّہ زَیتُون کا تیل مِلا ہُوا مَیدہ ہو، مینڈھے کے ساتھ ایفہ کا پانچواں حِصّہ ہو؛ <verse eid="NUM 28:28"/><verse number="29" style="v" sid="NUM 28:29"/>اَور سات برّوں میں سے ہر ایک برّے کے ساتھ ایفہ کا دسواں حِصّہ ہو۔ <verse eid="NUM 28:29"/><verse number="30" style="v" sid="NUM 28:30"/>اَور ایک بکرا بھی شامل کر لو تاکہ تمہارے لیٔے کفّارہ دیا جائے۔ <verse eid="NUM 28:30"/><verse number="31" style="v" sid="NUM 28:31"/>حسبِ معمول دی جانے والی سوختنی نذر اَور اُس کی اناج کی نذر کی قُربانی کے علاوہ تُم اُنہیں بھی اُن کے تپاون کی نذروں کے ساتھ پیش کرنا۔ البتّہ خیال رہے کہ سَب جانور بے عیب ہُوں۔<verse eid="NUM 28:31"/></para>
  <chapter eid="NUM 28"/>
  <chapter number="29" style="c" sid="NUM 29"/>
  <para style="s1">نرسنگوں کی عید</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 29:1"/>” ’ساتویں مہینے کے پہلے دِن تمہارا مُقدّس اِجتماع ہو اَور اُس دِن کویٔی حسبِ معمول کام نہ کیا جائے۔ یہ تمہارے لیٔے نرسنگے پھُونکنے کا دِن ہے۔ <verse eid="NUM 29:1"/><verse number="2" style="v" sid="NUM 29:2"/>تُم ایک بچھڑا، ایک مینڈھا اَور سات یک سالہ نر برّے جو سَب کے سَب بے عیب ہُوں سوختنی نذر کے طور پر پیش کرنا تاکہ یَاہوِہ کے لیٔے فرحت بخش خُوشبو ٹھہرے۔ <verse eid="NUM 29:2"/><verse number="3" style="v" sid="NUM 29:3"/>بچھڑے کے ساتھ اناج کی نذر کی قُربانی کے طور پر ایفہ کا تین دہائی حِصّہ زَیتُون کا تیل مِلا ہُوا مَیدہ ہو؛ مینڈھے کے ساتھ پانچواں حِصّہ <verse eid="NUM 29:3"/><verse number="4" style="v" sid="NUM 29:4"/>اَور سات برّوں میں سے ہر ایک برّے کے ساتھ دسواں حِصّہ ہو۔ <verse eid="NUM 29:4"/><verse number="5" style="v" sid="NUM 29:5"/>اَور ایک بکرا بھی شامل کر لو تاکہ تمہارے لیٔے گُناہ کی قُربانی کے طور پر کفّارہ دیا جائے۔ <verse eid="NUM 29:5"/><verse number="6" style="v" sid="NUM 29:6"/>یہ مُقرّرہ ماہانہ اَور روزمرّہ دی جانے والی سوختنی نذروں اَور اُن کے ساتھ کی اناج کی نذر اَور تپاون کی نذروں کی قُربانیوں کے علاوہ ہیں۔ یہ یَاہوِہ کے حُضُور فرحت بخش خُوشبو والی آتِشی قُربانیوں کے طور پر پیش کی جایٔیں۔<verse eid="NUM 29:6"/></para>
  <para style="s1">یومِ کفّارہ</para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 29:7"/>” ’اِسی ساتویں مہینے کے دسویں دِن تمہارا مُقدّس اِجتماع ہو۔ اُس دِن تُم اَپنی خُودی کا اِنکار کرنا اَور کویٔی کام نہ کرنا۔ <verse eid="NUM 29:7"/><verse number="8" style="v" sid="NUM 29:8"/>اَور یَاہوِہ کے حُضُور فرحت بخش خُوشبو کے لیٔے ایک بچھڑا، ایک مینڈھا اَور سات یک سالہ نر برّے جو سَب کے سَب بے عیب ہُوں سوختنی نذر کے طور پر پیش کرنا۔ <verse eid="NUM 29:8"/><verse number="9" style="v" sid="NUM 29:9"/>بچھڑے کے ساتھ اناج کی نذر کی قُربانی کے طور پر ایفہ کا تین دہائی حِصّہ زَیتُون کا تیل مِلا ہُوا مَیدہ ہو، مینڈھے کے ساتھ پانچواں حِصّہ ہو۔ <verse eid="NUM 29:9"/><verse number="10" style="v" sid="NUM 29:10"/>اَور سات برّوں میں سے ہر ایک برّہ کے ساتھ دسواں حِصّہ ہو۔ <verse eid="NUM 29:10"/><verse number="11" style="v" sid="NUM 29:11"/>اَور ایک بکرا گُناہ کی قُربانی کے طور پر بھی شامل کر لو جو کفّارہ کے لیٔے دی ہُوئی گُناہ کی قُربانی اَور حسبِ معمول دی جانے والی سوختنی نذر اَور اناج کی نذر کی قُربانی اَور تپاون کی نذروں کے علاوہ ہو۔<verse eid="NUM 29:11"/></para>
  <para style="s1">خیموں کی عید</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 29:12"/>” ’ساتویں مہینے کے پندرھویں دِن پھر تمہارا مُقدّس اِجتماع ہو۔ اُس دِن تُم کویٔی حسبِ معمول کام نہ کرنا اَور سات دِن تک یَاہوِہ کے لیٔے کی عید منانا۔ <verse eid="NUM 29:12"/><verse number="13" style="v" sid="NUM 29:13"/>اَور سوختنی نذر کے طور پر تیرہ بچھڑے، دو مینڈھے اَور چودہ یک سالہ نر برّے جو سَب کے سَب بے عیب ہُوں گذراننا تاکہ وہ یَاہوِہ کے لیٔے فرحت بخش خُوشبو کی آتِشی قُربانی ٹھہرے۔ <verse eid="NUM 29:13"/><verse number="14" style="v" sid="NUM 29:14"/>تیرہ بچھڑوں میں سے ہر بچھڑے کے ساتھ اناج کی نذر کی قُربانی کے طور پر ایفہ کا تین دہائی حِصّہ زَیتُون کا تیل مِلا ہُوا مَیدہ ہو اَور دونوں مینڈھوں میں سے ہر مینڈھے کے ساتھ پانچواں حِصّہ ہو۔ <verse eid="NUM 29:14"/><verse number="15" style="v" sid="NUM 29:15"/>اَور چودہ برّوں میں سے ہر برّہ کے ساتھ دسواں حِصّہ ہو۔ <verse eid="NUM 29:15"/><verse number="16" style="v" sid="NUM 29:16"/>اَور ایک بکرا گُناہ کی قُربانی کے طور پر بھی شامل کر لو جو حسبِ معمول دی جانے والی سوختنی نذر اَور اناج کی نذر کی قُربانی اَور تپاون کے علاوہ ہو۔<verse eid="NUM 29:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 29:17"/>” ’دُوسرے دِن بَارہ بچھڑے، دو مینڈھے اَور چودہ یک سالہ نر برّے جو سَب کے سَب بے عیب ہُوں چڑھانا۔ <verse eid="NUM 29:17"/><verse number="18" style="v" sid="NUM 29:18"/>بچھڑوں، مینڈھوں اَور برّوں کے ساتھ اُن کے اعداد شُمار کے مُطابق اناج کی نذر کی قُربانیاں اَور تپاون کی نذریں بھی گذراننا۔ <verse eid="NUM 29:18"/><verse number="19" style="v" sid="NUM 29:19"/>اَور ایک بکرا گُناہ کی قُربانی کے طور پر بھی شامل کر لو جو حسبِ معمول دی جانے والی سوختنی نذر اَور اناج کی نذر کی قُربانی اَور تپاون کی نذروں کے علاوہ ہو۔<verse eid="NUM 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 29:20"/>” ’تیسرے دِن گیارہ بچھڑے، دو مینڈھے اَور چودہ یک سالہ نر برّے جو سَب کے سَب بے عیب ہُوں چڑھانا۔ <verse eid="NUM 29:20"/><verse number="21" style="v" sid="NUM 29:21"/>بچھڑوں، مینڈھوں اَور برّوں کے ساتھ اُن کے اعداد شُمار کے مُطابق اناج کی نذر اَور تپاون کی نذروں کی قُربانیاں بھی گذراننا۔ <verse eid="NUM 29:21"/><verse number="22" style="v" sid="NUM 29:22"/>اَور ایک بکرا گُناہ کی قُربانی کے طور پر بھی شامل کر لو جو حسبِ معمول دی جانے والی سوختنی نذر اَور اناج کی نذر کی قُربانی اَور تپاون کے علاوہ ہو۔<verse eid="NUM 29:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 29:23"/>” ’چوتھے دِن دس بچھڑے، دو مینڈھے اَور چودہ یک سالہ نر برّے جو سَب کے سَب بے عیب ہُوں چڑھانا۔ <verse eid="NUM 29:23"/><verse number="24" style="v" sid="NUM 29:24"/>بچھڑوں، مینڈھوں اَور برّوں کے ساتھ اُن کے اعداد شُمار کے مُطابق اناج کی نذر اَور تپاون کی نذریں بھی گذراننا۔ <verse eid="NUM 29:24"/><verse number="25" style="v" sid="NUM 29:25"/>اَور ایک بکرا گُناہ کی قُربانی کے طور پر بھی شامل کر لو جو حسبِ معمول دی جانے والی سوختنی نذر اَور اناج کی نذر کی قُربانی اَور تپاون کے علاوہ ہو۔<verse eid="NUM 29:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 29:26"/>” ’پانچویں دِن نَو بچھڑے، دو مینڈھے اَور چودہ یک سالہ نر برّے جو سَب کے سَب بے عیب ہُوں چڑھانا۔ <verse eid="NUM 29:26"/><verse number="27" style="v" sid="NUM 29:27"/>بچھڑوں، مینڈھوں اَور برّوں کے ساتھ اُن کے اعداد شُمار کے مُطابق اناج کی نذر اَور تپاون کی نذریں کی قُربانیاں بھی گذراننا۔ <verse eid="NUM 29:27"/><verse number="28" style="v" sid="NUM 29:28"/>اَور ایک بکرا گُناہ کی قُربانی کے طور پر بھی شامل کر لو جو حسبِ معمول دی جانے والی سوختنی نذر اَور اناج کی نذر کی قُربانی اَور تپاون کے علاوہ ہو۔<verse eid="NUM 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 29:29"/>” ’چھٹے دِن آٹھ بچھڑے، دو مینڈھے اَور چودہ یک سالہ نر برّے جو سَب کے سَب بے عیب ہُوں چڑھانا۔ <verse eid="NUM 29:29"/><verse number="30" style="v" sid="NUM 29:30"/>بچھڑوں، مینڈھوں اَور برّوں کے ساتھ اُن کے اعداد شُمار کے مُطابق اناج کی نذر اَور تپاون کی نذروں کی قُربانیاں بھی گذراننا۔ <verse eid="NUM 29:30"/><verse number="31" style="v" sid="NUM 29:31"/>اَور ایک بکرا گُناہ کی قُربانی کے طور پر بھی شامل کر لو جو حسبِ معمول دی جانے والی سوختنی نذر اَور اناج کی نذر کی قُربانی اَور تپاون کے علاوہ ہو۔<verse eid="NUM 29:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 29:32"/>” ’ساتویں دِن سات بچھڑے، دو مینڈھے اَور چودہ یک سالہ نر برّے جو سَب کے سَب بے عیب ہُوں چڑھانا۔ <verse eid="NUM 29:32"/><verse number="33" style="v" sid="NUM 29:33"/>بچھڑوں، مینڈھوں اَور برّوں کے ساتھ اُن کے اعداد شُمار کے مُطابق اناج کی نذر اَور تپاون کی نذریں بھی گذراننا۔ <verse eid="NUM 29:33"/><verse number="34" style="v" sid="NUM 29:34"/>اَور ایک بکرا گُناہ کی قُربانی کے طور پر بھی شامل کر لو جو حسبِ معمول دی جانے والی سوختنی نذر اَور اناج کی نذر کی قُربانی اَور تپاون کے علاوہ ہو۔<verse eid="NUM 29:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 29:35"/>” ’آٹھویں دِن تمہارا اِجتماع ہو اَور کویٔی حسبِ معمول کام نہ کیا جائے۔ <verse eid="NUM 29:35"/><verse number="36" style="v" sid="NUM 29:36"/>اَور سوختنی نذر کے طور پر ایک بچھڑا، ایک مینڈھا اَور سات یک سالہ نر برّے جو سَب کے سَب بے عیب ہُوں گذرانو تاکہ وہ یَاہوِہ کے لیٔے فرحت بخش خُوشبو کی آتِشی قُربانی ٹھہرے۔ <verse eid="NUM 29:36"/><verse number="37" style="v" sid="NUM 29:37"/>بچھڑے، مینڈھے اَور برّوں کے ساتھ اُن کے اعداد شُمار کے مُطابق اناج کی نذر اَور تپاون کی نذریں بھی گذراننا۔ <verse eid="NUM 29:37"/><verse number="38" style="v" sid="NUM 29:38"/>اَور ایک بکرا گُناہ کی قُربانی کے طور پر بھی شامل کر لو جو حسبِ معمول دی جانے والی سوختنی نذر اَور اناج کی نذر کی قُربانی اَور تپاون کے علاوہ ہو۔<verse eid="NUM 29:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 29:39"/>” ’تُم اَپنی مُقرّرہ عیدوں کے موقعوں پر اُن کو یَاہوِہ کے حُضُور اَپنی مَنّتوں اَور رضا کی قُربانیوں کے علاوہ اَپنی سوختنی نذریں، اناج کی نذریں، تپاون کی نذریں اَور سلامتی کی نذریں گذراننا۔‘ “<verse eid="NUM 29:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 29:40"/>مَوشہ نے بنی اِسرائیل کو وہ سَب کچھ بتا دیا جِس کا حُکم یَاہوِہ نے اُسے دیا تھا۔<verse eid="NUM 29:40"/></para>
  <chapter eid="NUM 29"/>
  <chapter number="30" style="c" sid="NUM 30"/>
  <para style="s1">قَسموں سے متعلّق آئین</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 30:1"/>مَوشہ نے اِسرائیل کے قبیلوں کے سربراہوں سے کہا: ”یَاہوِہ نے یہ حُکم دیا ہے: <verse eid="NUM 30:1"/><verse number="2" style="v" sid="NUM 30:2"/>جَب کویٔی آدمی یَاہوِہ کی مَنّت مانے یا قَسم کھا کر کویٔی عہدوپیمان کر بیٹھے تو وہ اَپنا عہد نہ توڑے بَلکہ جو کچھ اُس نے کہا ہے اُسے پُورا کرے۔<verse eid="NUM 30:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 30:3"/>”جَب کویٔی عورت اَپنے باپ کے گھر میں رہتے ہویٔے یَاہوِہ سے مَنّت مانے یا کویٔی عہدوپیمان کر بیٹھے <verse eid="NUM 30:3"/><verse number="4" style="v" sid="NUM 30:4"/>اَور اُس کا باپ اُس کی مَنّت یا عہد کے بارے میں سُن کر اُس سے کچھ نہ کہے تو اُس کی سَب مَنّتیں اَور عہدوپیمان جو اُس نے اَپنے اُوپر فرض کر لیا ہے برقرار رہیں گے۔ <verse eid="NUM 30:4"/><verse number="5" style="v" sid="NUM 30:5"/>لیکن اگر اُس کا باپ جَب یہ سُن لے اَور اُسے منع کر دے تو اُس کی کویٔی مَنّت یا کویٔی عہدوپیمان جسے اُس نے اَپنے اُوپر فرض کر لیا ہو برقرار نہیں رہے گا۔ یَاہوِہ اُسے مُعاف کر دیں گے کیونکہ اُس کے باپ نے اُسے منع کیا ہے۔<verse eid="NUM 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 30:6"/>”اگر وہ مَنّت ماننے کے بعد بیاہ کر لے یا اُس کے ہونٹوں پر ناعاقبت اَندیشی کی وجہ سے کویٔی اَیسی بات آ جائے جو اُس نے اَپنے اُوپر فرض ٹھہرائی ہو <verse eid="NUM 30:6"/><verse number="7" style="v" sid="NUM 30:7"/>اَور اُس کا خَاوند اُن کے بارے میں سُن کر اُس سے کچھ نہ کہے تو اُس کی مَنّتیں یا عہدوپیمان جو اُس نے اَپنے اُوپر فرض ٹھہرائے ہیں برقرار رہیں گے۔ <verse eid="NUM 30:7"/><verse number="8" style="v" sid="NUM 30:8"/>لیکن اگر اُس کا خَاوند جَب یہ سُن لے اَور اُسے منع کر دے تو وہ اُس مَنّت کو اَور ناعاقبت اَندیشی کی وجہ سے کئے ہویٔے وعدے کو جو اُس نے اَپنے اُوپر فرض ٹھہرایا ہو منسُوخ کرتا ہے تو یَاہوِہ اُسے مُعاف کر دیں گے۔<verse eid="NUM 30:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 30:9"/>”لیکن کویٔی بِیوہ یا مُطلّقہ عورت جو مَنّت مانے یا اَپنے اُوپر کویٔی پابندی عاید کر لے وہ برقرار رہے گی۔<verse eid="NUM 30:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 30:10"/>”اگر کویٔی عورت اَپنے خَاوند کے ساتھ رہتے ہویٔے کویٔی مَنّت مانے یا قَسم کھا کر اَپنے اُوپر کویٔی پابندی عاید کر لیتی ہے <verse eid="NUM 30:10"/><verse number="11" style="v" sid="NUM 30:11"/>اَور اُس کا خَاوند ہے سُن کر اُس سے کچھ نہ کہے اَور اُسے منع نہ کرے تو اُس کی ساری مَنّتیں اَور اُس کی اَپنے آپ پر عاید کی ہُوئی پابندیاں برقرار رہیں گی۔ <verse eid="NUM 30:11"/><verse number="12" style="v" sid="NUM 30:12"/>لیکن اگر اُس کا خَاوند اُنہیں سُننے کے بعد منسُوخ کر دیتاہے تو اُس کے مُنہ سے نکلی ہُوئی کویٔی مَنّت یا پابندی برقرار نہ رہے گی۔ اُس کے خَاوند نے اُنہیں منسُوخ کیا ہے اَور یَاہوِہ اُسے مُعاف کر دیں گے۔ <verse eid="NUM 30:12"/><verse number="13" style="v" sid="NUM 30:13"/>اُس کا خَاوند اُس کی مانی ہُوئی کسی بھی مَنّت کو یا قَسم کھا کر پرہیزگاری کے لیٔے اَپنے اُوپر عاید کی ہُوئی کسی بھی پابندی کو قائِم رکھ سَکتا ہے یا منسُوخ کر سَکتا ہے۔ <verse eid="NUM 30:13"/><verse number="14" style="v" sid="NUM 30:14"/>لیکن اگر اُس کا خَاوند اُس کے متعلّق کسی دِن بھی اُس سے کچھ نہ کہے تَب وہ اُس کی تمام مَنّتیں اَور خُود پر عاید کی ہُوئی پابندیاں برقرار رکھتا ہے۔ وہ اِس لیٔے برقرار رہتی ہیں کہ اُس نے اُن کے متعلّق سُن کر بھی اُس سے کچھ نہ کہا۔ <verse eid="NUM 30:14"/><verse number="15" style="v" sid="NUM 30:15"/>البتّہ اگر وہ اُن کے بارے میں سُننے کے کچھ عرصہ بعد اُنہیں منسُوخ کرتا ہے تو وہ اُس کے گُناہ کا ذمّہ دار ہوگا۔“<verse eid="NUM 30:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 30:16"/>خَاوند اَور بیوی کے درمیان اَور باپ اَور اُس کے گھر میں رہتی ہُوئی اُس کی جَوان بیٹی کے درمیان آپَس کے تعلّقات کے متعلّق یَاہوِہ نے یہ ضوابط مَوشہ کو دئیے۔<verse eid="NUM 30:16"/></para>
  <chapter eid="NUM 30"/>
  <chapter number="31" style="c" sid="NUM 31"/>
  <para style="s1">مِدیانیوں سے اِنتقام</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 31:1"/>یَاہوِہ نے مَوشہ سے کہا، <verse eid="NUM 31:1"/><verse number="2" style="v" sid="NUM 31:2"/>”مِدیانیوں سے بنی اِسرائیل کا اِنتقام لے۔ اُس کے بعد تُو اَپنے لوگوں میں جا ملے گا۔“<verse eid="NUM 31:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 31:3"/>چنانچہ مَوشہ نے لوگوں سے کہا، ”اَپنے میں سے چند آدمیوں کو مِدیانیوں کے خِلاف جنگ کرنے اَور اُن سے یَاہوِہ کا اِنتقام لینے کے لیٔے مُسلّح کر لو۔ <verse eid="NUM 31:3"/><verse number="4" style="v" sid="NUM 31:4"/>اِسرائیل کے ہر قبیلہ میں سے ایک ایک ہزار آدمی جنگ کے لیٔے بھیجنا۔“ <verse eid="NUM 31:4"/><verse number="5" style="v" sid="NUM 31:5"/>چنانچہ اِسرائیل کی برادریوں میں سے فی قبیلہ ایک ہزار کے حِساب سے بَارہ ہزار آدمیوں نے جنگ کے لیٔے ہتھیار باندھ لیٔے۔ <verse eid="NUM 31:5"/><verse number="6" style="v" sid="NUM 31:6"/>یُوں مَوشہ نے ہر قبیلہ میں سے ایک ہزار آدمیوں کو جنگ کے لیٔے الیعزرؔ کاہِنؔ کے بیٹے فِنحاسؔ کے ساتھ بھیجا جِس نے پاک مَقدِس کے ظروف اَور جنگ کا نعرہ بُلند کرنے کے لیٔے نرسنگے اَپنے ساتھ لیٔے۔<verse eid="NUM 31:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 31:7"/>اُنہُوں نے یَاہوِہ کے ذریعہ مَوشہ کو دئیے ہویٔے حُکم کے مُطابق وہ مِدیانیوں سے لڑے اَور ہر آدمی کو مار ڈالا <verse eid="NUM 31:7"/><verse number="8" style="v" sid="NUM 31:8"/>جِن لوگوں کو اُنہُوں نے موت کے گھاٹ اُتارا اُن میں عیویؔ، رِقمؔ، ضُورؔ، حُورؔ، رِبعؔ اَور یہ پانچ مِدیانی بادشاہ بھی تھے۔ اُنہُوں نے بِلعاؔم بِن بعورؔ کو بھی تلوار سے قتل کیا۔ <verse eid="NUM 31:8"/><verse number="9" style="v" sid="NUM 31:9"/>اِسرائیلیوں نے مِدیانی عورتوں اَور بچّوں کو اسیر کیا اَور مِدیانیوں کے مویشیوں کے تمام ریوڑ بھیڑ اَور بکریوں کے تمام گلّے اَور سارا مال و اَسباب لُوٹ لیا۔ <verse eid="NUM 31:9"/><verse number="10" style="v" sid="NUM 31:10"/>اُنہُوں نے اُن تمام شہروں کو جہاں مِدیانی آباد تھے اَور اُن کی سَب چھاؤنی کو نذرِ آتِش کر دیا۔ <verse eid="NUM 31:10"/><verse number="11" style="v" sid="NUM 31:11"/>تَب اُنہُوں نے لوگوں اَور جانوروں سمیت تمام مالِ غنیمت کو جمع کیا <verse eid="NUM 31:11"/><verse number="12" style="v" sid="NUM 31:12"/>اَور تمام اسیروں اَور مالِ غنیمت کو مَوشہ، الیعزرؔ کاہِنؔ اَور بنی اِسرائیل کی ساری جماعت کے پاس اَپنی چھاؤنی میں لے آئے جو یریحوؔ کے مقابل یردنؔ کے کنارے مُوآب کے میدانوں میں تھی۔<verse eid="NUM 31:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 31:13"/>مَوشہ اَور الیعزرؔ کاہِنؔ اَور جماعت کے سَب سردار اُن کے اِستِقبال کے لیٔے چھاؤنی کے باہر گیٔے۔ <verse eid="NUM 31:13"/><verse number="14" style="v" sid="NUM 31:14"/>مَوشہ جنگ سے لَوٹے ہویٔے اُن افسران پر جھلّایا جو ہزاروں اَور سینکڑوں فَوجی دستوں کی قیادت کر رہے تھے۔<verse eid="NUM 31:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 31:15"/>مَوشہ نے اُن سے پُوچھا، ”کیا تُم نے سَب عورتوں کو زندہ رہنے دیا؟“ <verse eid="NUM 31:15"/><verse number="16" style="v" sid="NUM 31:16"/>پعورؔ میں جو کچھ ہُوا اُس وقت یہی عورتیں بِلعاؔم کی صلاح سے اِسرائیلیوں کو یَاہوِہ سے برگشتہ کرنے کا ذریعہ بنی تھیں اَور یَاہوِہ کے لوگوں میں وَبا پھیلی تھی۔ <verse eid="NUM 31:16"/><verse number="17" style="v" sid="NUM 31:17"/>لہٰذا سَب لڑکوں کو مار ڈالو اَور ہر اُس عورت کو بھی مار ڈالو جو کسی مَرد کے ساتھ ہم بِستر ہو چُکی ہو۔ <verse eid="NUM 31:17"/><verse number="18" style="v" sid="NUM 31:18"/>لیکن ہر اُس لڑکی کو اَپنے لیٔے بچائے رکھو جو کبھی کسی مَرد کے ساتھ ہم بِستر نہ ہُوئی ہو۔<verse eid="NUM 31:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 31:19"/>”تُم سَب جنہوں نے کسی کو قتل کیا ہو یا کسی مقتول کو چھُوا ہو سات دِن تک چھاؤنی کے باہر رہے۔ تیسرے اَور ساتویں دِن تُم اَپنے آپ کو اَور اَپنے اسیروں کو پاک کر لو۔ <verse eid="NUM 31:19"/><verse number="20" style="v" sid="NUM 31:20"/>تُم ہر کپڑے کو اَور چمڑے، بکری کے بالوں اَور لکڑی سے بنی ہُوئی ہر شَے کو پاک کر لو۔“<verse eid="NUM 31:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 31:21"/>تَب الیعزرؔ کاہِنؔ نے اُن سپاہیوں سے جو جنگ کرنے گیٔے تھے کہا، ”یَاہوِہ کی مَوشہ کو دی ہُوئی آئین کا یہ تَقاضا ہے کہ <verse eid="NUM 31:21"/><verse number="22" style="v" sid="NUM 31:22"/>سونا، چاندی، کانسا، لوہا، رانگا اَور سیسہ <verse eid="NUM 31:22"/><verse number="23" style="v" sid="NUM 31:23"/>اَور دُوسری کویٔی شَے جو آگ کی تاب لا سکے اُسے آگ میں ڈالا جائے، تَب وہ صَاف ہوگی۔ لیکن اُسے طہارت کے پانی سے بھی پاک کیا جائے۔ اَورجو کچھ آگ کو برداشت نہ کر سکے اُسے اُس پانی میں ڈالا جائے۔ <verse eid="NUM 31:23"/><verse number="24" style="v" sid="NUM 31:24"/>ساتویں دِن تُم اَپنے کپڑے دھونا۔ اَور پاک و صَاف ہوکر چھاؤنی میں آجانا۔“<verse eid="NUM 31:24"/></para>
  <para style="s1">مالِ غنیمت کا تقسیم کرنا</para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 31:25"/>یَاہوِہ نے مَوشہ سے کہا، <verse eid="NUM 31:25"/><verse number="26" style="v" sid="NUM 31:26"/>”تُو اَور الیعزرؔ کاہِنؔ اَور جماعت کے خاندانوں کے سردار مِل کر اُن لوگوں اَور جانوروں کو شُمار کرو جو اسیر کئے گیٔے تھے۔ <verse eid="NUM 31:26"/><verse number="27" style="v" sid="NUM 31:27"/>اَور مالِ غنیمت کو جنگ میں شریک ہونے والے سپاہیوں اَور بقیّہ جماعت کے درمیان تقسیم کرنا۔ <verse eid="NUM 31:27"/><verse number="28" style="v" sid="NUM 31:28"/>اُن سپاہیوں کے حِصّہ میں جو جنگ میں لڑے تھے یَاہوِہ کے لیٔے خراج کے طور پر ہر پانچ سَو لوگوں، مویشیوں، گدھوں، بھیڑوں میں سے ایک کے حِساب سے ایک حِصّہ لے لیں۔ <verse eid="NUM 31:28"/><verse number="29" style="v" sid="NUM 31:29"/>اُن کے نِصف حِصّہ میں سے تُم یہ خراج لے کر اُسے الیعزرؔ کاہِنؔ کو یَاہوِہ کے نذرانہ کے طور پر دے دینا۔ <verse eid="NUM 31:29"/><verse number="30" style="v" sid="NUM 31:30"/>اَور بنی اِسرائیل کے نِصف حِصّہ میں سے ہر پچاس کے پیچھے ایک ایک لینا خواہ وہ اِنسان ہُوں یا مویشی، گدھے، بھیڑیں، یا کویٔی اَور جانور۔ اُنہیں لیویوں کو دینا جو یَاہوِہ کے خیمہ اِجتماع کی حِفاظت کے ذمّہ دار ہیں۔“ <verse eid="NUM 31:30"/><verse number="31" style="v" sid="NUM 31:31"/>مَوشہ اَور الیعزرؔ کاہِنؔ نے وُہی کیا۔ جو یَاہوِہ نے مَوشہ کو حُکم دیا تھا۔<verse eid="NUM 31:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 31:32"/>لُوٹ کا مال جو سپاہیوں کے ہاتھ لگا تھا اُس کے علاوہ بچا ہُوا مالِ غنیمت یہ تھا: 6,75,000 بکریاں، <verse eid="NUM 31:32"/><verse number="33" style="v" sid="NUM 31:33"/>72,000 مویشی، <verse eid="NUM 31:33"/><verse number="34" style="v" sid="NUM 31:34"/>61,000 گدھے، <verse eid="NUM 31:34"/><verse number="35" style="v" sid="NUM 31:35"/>32,000 اَیسی عورتیں جو کسی مَرد کے ساتھ ہم بِستر نہ ہُوئی تھیں۔<verse eid="NUM 31:35"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="36" style="v" sid="NUM 31:36"/>جنگ میں لڑنے والوں کا نِصف حِصّہ یہ تھا:</para>
  <para style="b" vid="NUM 31:36"/>
  <para style="li1" vid="NUM 31:36">3,37,500 بھیڑیں <verse eid="NUM 31:36"/><verse number="37" style="v" sid="NUM 31:37"/>جِن میں سے 675 بھیڑیں یَاہوِہ کے لیٔے تھیں<verse eid="NUM 31:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 31:38"/>36,000 مویشی جِن میں یَاہوِہ کے لیٔے 72 تھے؛<verse eid="NUM 31:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="NUM 31:39"/>گدھے 30,500 جِن میں یَاہوِہ کے لئے 61 تھے؛<verse eid="NUM 31:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="NUM 31:40"/>16,000 مَرد جِن میں 32 یَاہوِہ کے لئے تھے،<verse eid="NUM 31:40"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="41" style="v" sid="NUM 31:41"/>جَیسا یَاہوِہ نے مَوشہ کو حُکم دیا تھا اُسی کے مُطابق اُس نے وہ رسد الیعزرؔ کاہِنؔ کو یَاہوِہ کے حِصّہ کے طور پر دیا۔<verse eid="NUM 31:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 31:42"/>بنی اِسرائیل کا نِصف حِصّہ جسے مَوشہ نے جنگی مَردوں کے حِصّہ سے الگ کر لیا تھا: <verse eid="NUM 31:42"/><verse number="43" style="v" sid="NUM 31:43"/>یعنی جماعت کا نِصف حِصّہ یہ 3,37,500 بھیڑیں، <verse eid="NUM 31:43"/><verse number="44" style="v" sid="NUM 31:44"/>36,000 مویشی، <verse eid="NUM 31:44"/><verse number="45" style="v" sid="NUM 31:45"/>30,500 گدھے، <verse eid="NUM 31:45"/><verse number="46" style="v" sid="NUM 31:46"/>16,000 مَرد۔ <verse eid="NUM 31:46"/><verse number="47" style="v" sid="NUM 31:47"/>اَور بنی اِسرائیل کے نِصف حِصّہ میں سے مَوشہ نے خُدا کے حُکم کے مُطابق ہر پچاس مَردوں اَور جانوروں کے پیچھے ایک ایک چُن کر لیویوں کو دیا جو یَاہوِہ کے مَسکن کی حِفاظت کے ذمّہ دار تھے۔<verse eid="NUM 31:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 31:48"/>تَب وہ افسران جو ہزاروں اَور سینکڑوں فَوجی دستوں کی قیادت کر رہے تھے مَوشہ کے پاس آئے۔ <verse eid="NUM 31:48"/><verse number="49" style="v" sid="NUM 31:49"/>اَور مَوشہ سے کہنے لگے، ”تمہارے خادِموں نے اُن سپاہیوں کا جو ہمارے ماتحت تھے شُمار کیا اَور اُن میں سے ایک بھی کم نہ ہُوا۔ <verse eid="NUM 31:49"/><verse number="50" style="v" sid="NUM 31:50"/>چنانچہ بازوبند، کنگن، انگُوٹھیاں، کان کی بالیاں اَور گلوبند جَیسی سونے کی چیزوں میں سے جو کچھ ہمارے ہاتھ لگا اُسے ہم یَاہوِہ کے حُضُور میں ہدیہ کے طور پر لایٔے ہیں تاکہ ہمارے لیٔے یَاہوِہ کے حُضُور کفّارہ دیا جائے۔“<verse eid="NUM 31:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="NUM 31:51"/>تَب مَوشہ اَور الیعزرؔ کاہِنؔ نے اُن سے وہ سونا لے لیا جو گڑھے ہویٔے گہنوں کی شکل میں تھا۔ <verse eid="NUM 31:51"/><verse number="52" style="v" sid="NUM 31:52"/>ہزاروں اَور سینکڑوں فَوجی دستوں کے سپہ سالاروں سے لیٔے ہویٔے سونے کا وزن جسے مَوشہ اَور الیعزرؔ نے یَاہوِہ کے حُضُور میں نذرانے کے طور پر پیش کیا تھا جو 16,750 ثاقل<note caller="+" style="f"><char style="fr" closed="false">31‏:52 </char><char style="fq" closed="false">16,750 ثاقل </char><char style="ft" closed="false">تقریباً ایک سَو نوّے کِلوگرام</char></note> تھا۔ <verse eid="NUM 31:52"/><verse number="53" style="v" sid="NUM 31:53"/>ہر جنگی سپاہی نے اَپنے لیٔے کچھ نہ کچھ لے لیا تھا۔ <verse eid="NUM 31:53"/><verse number="54" style="v" sid="NUM 31:54"/>مَوشہ اَور الیعزرؔ کاہِنؔ نے ہزاروں اَور سینکڑوں فَوجی دستوں کے سپہ سالاروں سے سونا لے لیا اَور وہ اُسے یَاہوِہ کے حُضُور میں بنی اِسرائیل کی یادگار کے طور پر خیمہ اِجتماع میں لے آئے۔<verse eid="NUM 31:54"/></para>
  <chapter eid="NUM 31"/>
  <chapter number="32" style="c" sid="NUM 32"/>
  <para style="s1">یردنؔ کے آرپار کے قبیلے</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 32:1"/>بنی رُوبِنؔ اَور بنی گادؔ نے جِن کے پاس جانوروں کے بڑے بڑے ریوڑ اَور گلّے تھے جَب یہ دیکھا کہ یعزیرؔ اَور گِلعادؔ کے مُلک مویشیوں کے لیٔے نہایت اَچھّے ہیں <verse eid="NUM 32:1"/><verse number="2" style="v" sid="NUM 32:2"/>تو وہ رُوبِنؔ کے قبیلہ اَور مَوشہ اَور الیعزرؔ کاہِنؔ اَور گادؔ کی جماعت کے سربراہوں کے پاس آکر کہنے لگے، <verse eid="NUM 32:2"/><verse number="3" style="v" sid="NUM 32:3"/>”عطاروتؔ دیبونؔ یعزیرؔ، نِمرہؔ، حِشبونؔ، الیعالہؔ سیبامؔ، نبوؔ اَور بعُونؔ، <verse eid="NUM 32:3"/><verse number="4" style="v" sid="NUM 32:4"/>کا مُلک جِن پر یَاہوِہ نے بنی اِسرائیل کو فتح بخشی مویشیوں کے لیٔے نہایت مُناسب ہے اَور تمہارے خادِموں کے پاس مویشی ہیں۔“ <verse eid="NUM 32:4"/><verse number="5" style="v" sid="NUM 32:5"/>پھر اُنہُوں نے کہا، ”اگر ہم پر آپ کی نظرِکرم ہے تو یہ مُلک اَپنے خادِموں کو مِیراث کے طور پر عطا فرما اَور ہم پر یردنؔ پار کرنے کی نَوبَت نہ لا۔“<verse eid="NUM 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 32:6"/>مَوشہ نے بنی گادؔ اَور بنی رُوبِنؔ سے کہا، ”کیا تمہارے بھایٔی جنگ کرنے جایٔیں اَور تُم یہیں بیٹھے رہو؟ <verse eid="NUM 32:6"/><verse number="7" style="v" sid="NUM 32:7"/>تُم بنی اِسرائیل کا اُس مُلک میں جانے کا حوصلہ کیوں پست کر رہے ہو جسے یَاہوِہ نے اُنہیں دیا ہے؟ <verse eid="NUM 32:7"/><verse number="8" style="v" sid="NUM 32:8"/>جَب مَیں نے تمہارے آباؤاَجداد کو قادِسؔ برنیع سے اُس مُلک کا مُعائنہ کرنے کے لیٔے بھیجا تھا تو اُنہُوں نے بھی اَیسا ہی کہاتھا۔ <verse eid="NUM 32:8"/><verse number="9" style="v" sid="NUM 32:9"/>جَب وہ اِشکلؔ کی وادی تک پہُنچے تو اُس مُلک کو دیکھ کر اُنہُوں نے بنی اِسرائیل کے حوصلے پست کر دئیے کہ وہ اُس مُلک میں داخل نہ ہُوئے جسے یَاہوِہ نے اُنہیں دیا ہے۔ <verse eid="NUM 32:9"/><verse number="10" style="v" sid="NUM 32:10"/>اُس دِن یَاہوِہ کا غضب اُن پر بھڑکا اَور اُنہُوں نے یہ قَسم کھائی: <verse eid="NUM 32:10"/><verse number="11" style="v" sid="NUM 32:11"/>’چونکہ اُنہُوں نے میری دِل و جان سے پیروی نہیں کی اِس لیٔے اُن میں سے بیس سال یا اُس سے زِیادہ عمر کا کویٔی بھی شخص جو مِصر سے نکل آیا ہے اُس مُلک کو نہیں دیکھ پایٔےگا جسے دینے کی قَسم مَیں نے اَبراہامؔ اَور اِصحاقؔ اَور یعقوب سے کھائی ہے؛ <verse eid="NUM 32:11"/><verse number="12" style="v" sid="NUM 32:12"/>سِوا یفُنّہؔ قِنزّی کے بیٹے کالبؔ اَور یہوشُعؔ بِن نُونؔ کے جنہوں نے دِل و جان سے یَاہوِہ کی پیروی کی۔‘ <verse eid="NUM 32:12"/><verse number="13" style="v" sid="NUM 32:13"/>یَاہوِہ کا قہر اِسرائیل کے خِلاف بھڑک اُٹھا اَور اُنہُوں نے اُنہیں چالیس سال تک بیابان میں مارے مارے پھرنے پر مجبُور کیا۔ یہاں تک کہ اُس پُشت کے سَب لوگ جنہوں نے یَاہوِہ کی نظر میں گُناہ کیا تھا نابود ہو گئے۔<verse eid="NUM 32:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 32:14"/>”اَور یہاں تُم ہو۔ اَے گُنہگاروں کی اَولاد جو اَپنے آباؤاَجداد کی جگہ پر کھڑے ہوکر یَاہوِہ کے قہر کو اِسرائیل پر اَور بھی زِیادہ شدید کر رہے ہو۔ <verse eid="NUM 32:14"/><verse number="15" style="v" sid="NUM 32:15"/>اگر تُم اُس کی پیروی سے مُنہ موڑوگے تو وہ پھر اُن سَب لوگوں کو بیابان میں چھوڑ دے گا اَور تُم ہی اُن کی تباہی کا باعث ہوگے۔“<verse eid="NUM 32:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 32:16"/>تَب وہ مَوشہ کے پاس آکر کہنے لگے، ”ہم یہاں اَپنے مویشیوں کے لیٔے بھیڑوں کے باڑے اَور اَپنی عورتوں اَور بچّوں کے لیٔے شہر بنانا چاہتے ہیں۔ <verse eid="NUM 32:16"/><verse number="17" style="v" sid="NUM 32:17"/>لیکن ہم ہتھیار باندھ کر بنی اِسرائیل سے آگے آگے چلنے کے لیٔے تیّار ہیں جَب تک کہ اُن کو اُن کی جگہ تک نہ پہُنچائیں۔ اِس اَثنا میں ہماری عورتیں اَور بچّے اِس مُلک کے باشِندوں سے بچنے کے لیٔے فصیلدار شہروں میں رہیں گے۔ <verse eid="NUM 32:17"/><verse number="18" style="v" sid="NUM 32:18"/>ہم اُس وقت تک اَپنے گھروں کو نہ لَوٹیں گے جَب تک کہ ہر اِسرائیلی اَپنی اَپنی مِیراث کا مالک نہیں ہو جاتا۔ <verse eid="NUM 32:18"/><verse number="19" style="v" sid="NUM 32:19"/>ہم اُن کے ساتھ یردنؔ کے اُس پار کویٔی مِیراث نہ لیں گے کیونکہ ہمیں ہماری مِیراث یردنؔ کے مشرق میں ہی مِل چُکی ہے۔“<verse eid="NUM 32:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 32:20"/>تَب مَوشہ نے اُن سے کہا، ”اگر تُم یُوں کرو کہ لڑنے کے لیٔے یَاہوِہ کے حُضُور مُسلّح ہو جاؤ، <verse eid="NUM 32:20"/><verse number="21" style="v" sid="NUM 32:21"/>اَور اگر تُم سَب مُسلّح ہوکر یَاہوِہ کے حُضُور یردنؔ پار جاؤ اَور جَب تک وہ اَپنے دُشمنوں کو اَپنے سامنے سے ہٹا نہ دے، <verse eid="NUM 32:21"/><verse number="22" style="v" sid="NUM 32:22"/>اَور وہ مُلک یَاہوِہ کے حُضُور میں قبضہ میں نہ آ جائے تَب تک تُم واپس نہ آنا۔ تَب تُم یَاہوِہ اَور اِسرائیل کے نزدیک اَپنے فرض سے سبکدوش ہو جاؤگے اَور یہ مُلک یَاہوِہ کے حُضُور تمہاری مِلکیّت ہو جائے گا۔<verse eid="NUM 32:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 32:23"/>”لیکن اگر تُم اَیسا نہ کروگے تو یَاہوِہ کے گُنہگار ٹھہروگے اَور یقین جانو کہ تمہارا گُناہ تُمہیں پکڑ لے گا۔ <verse eid="NUM 32:23"/><verse number="24" style="v" sid="NUM 32:24"/>لہٰذا اَپنی عورتوں اَور بچّوں کے لیٔے شہر تعمیر کرو اَور اَپنے گلّوں کے لیٔے بھیڑوں کے باڑے بناؤ لیکن تُم نے جو وعدہ کیا ہے اُسے پُورا کرو۔“<verse eid="NUM 32:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 32:25"/>تَب بنی گادؔ اَور بنی رُوبِنؔ نے مَوشہ سے کہا، ”تمہارے خادِم اَپنے آقا کے حُکم کے مُطابق ہی کریں گے۔ <verse eid="NUM 32:25"/><verse number="26" style="v" sid="NUM 32:26"/>ہمارے بال بچّے، ہماری بھیڑ بکریوں کے گلّے اَور ہمارے مویشیوں کے ریوڑ یہاں گِلعادؔ کے شہروں میں رہیں گے <verse eid="NUM 32:26"/><verse number="27" style="v" sid="NUM 32:27"/>لیکن تمہارے خادِموں میں سے ہر آدمی جَیسا کہ ہمارا آقا فرماتا ہے لڑائی کے لیٔے مُسلّح ہوکر یَاہوِہ کے حُضُور لڑنے کو یردنؔ پار جائے گا۔“<verse eid="NUM 32:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 32:28"/>تَب مَوشہ نے اُن کے بارے میں الیعزرؔ کاہِنؔ کو یہوشُعؔ بِن نُونؔ کو اَور اِسرائیلی قبیلوں کے خاندانوں کے سربراہوں کو ہدایات دیں۔ <verse eid="NUM 32:28"/><verse number="29" style="v" sid="NUM 32:29"/>مَوشہ نے اُن سے کہا، ”اگر بنی گادؔ اَور بنی رُوبِنؔ کا ہر آدمی لڑائی کے لیٔے مُسلّح ہوکر یَاہوِہ کے حُضُور میں تمہارے ساتھ یردنؔ پار کر لے اَور جَب اُس مُلک پر تمہارا قبضہ ہو جائے تَب تُم گِلعادؔ کا مُلک اُنہیں مِیراث میں دینا۔ <verse eid="NUM 32:29"/><verse number="30" style="v" sid="NUM 32:30"/>لیکن اگر وہ مُسلّح ہوکر تمہارے ساتھ پار نہ جایٔیں تو وہ مُلکِ کنعانؔ میں تمہارے ساتھ اَپنی مِیراث قبُول کر لیں۔“<verse eid="NUM 32:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 32:31"/>تَب بنی گادؔ اَور بنی رُوبِنؔ نے جَواب دیا، ”تمہارے خادِم وَیسا ہی کریں گے جَیسا یَاہوِہ نے حُکم دیا ہے۔ <verse eid="NUM 32:31"/><verse number="32" style="v" sid="NUM 32:32"/>ہم مُسلّح ہوکر یَاہوِہ کے حُضُور میں اُس پار مُلکِ کنعانؔ میں جایٔیں گے لیکن جو جائداد ہمیں مِیراث میں ملے وہ یردنؔ کے اِس پار ہی ہو۔“<verse eid="NUM 32:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 32:33"/>تَب مَوشہ نے بنی گادؔ، بنی رُوبِنؔ اَور یُوسیفؔ کے بیٹے منشّہ کے نِصف قبیلہ کو امُوریوں کے بادشاہ سیحونؔ کی اَور باشانؔ کے بادشاہ عوگؔ کی مملکت یعنی اُن کا سارا مُلک دے دیا جِس میں اُن کے تمام شہر اَور اُن کے اِردگرد کے علاقے شامل تھے۔<verse eid="NUM 32:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 32:34"/>بنی گادؔ نے دیبونؔ، عطاروتؔ، عروعؔر، <verse eid="NUM 32:34"/><verse number="35" style="v" sid="NUM 32:35"/>عطروتؔ شوفانؔ، یعزیرؔ، یُگبِہؔا، <verse eid="NUM 32:35"/><verse number="36" style="v" sid="NUM 32:36"/>بیت نِمرہؔ اَور بیت حارانؔ جَیسے فصیلدار شہر تعمیر کئے اَور اَپنے گلّوں کے لیٔے بھیڑوں کے باڑے بنائے۔ <verse eid="NUM 32:36"/><verse number="37" style="v" sid="NUM 32:37"/>اَور بنی رُوبِنؔ نے حِشبونؔ، الیعالہؔ اَور قِریتائم کو اَز سَر نَو تعمیر کیا، <verse eid="NUM 32:37"/><verse number="38" style="v" sid="NUM 32:38"/>اَور نبوؔ اَور بَعل مِعُون (یہ نام تبدیل کئے گیٔے) اَور سِبماہؔ بھی تعمیر کئے۔ اُنہُوں نے اَپنے تعمیر کَردہ نئے شہروں کے دُوسرے نام رکھے۔<verse eid="NUM 32:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 32:39"/>منشّہ کے بیٹے مکیرؔ کی نَسل کے لوگوں نے گِلعادؔ جا کر اُس پر قبضہ کر لیا اَور وہاں جو امُوری تھے اُنہیں نکال دیا۔ <verse eid="NUM 32:39"/><verse number="40" style="v" sid="NUM 32:40"/>چنانچہ مَوشہ نے گِلعادؔ کا علاقہ مکیرؔ بِن منشّہ کو دے دیا اَور اُس کی نَسل کے لوگ وہاں بس گیٔے۔ <verse eid="NUM 32:40"/><verse number="41" style="v" sid="NUM 32:41"/>اَور منشّہ کے بیٹے یائیرؔ نے اِردگرد کی بستیوں پر قبضہ کر لیا اَور اُن کا نام حوّوت یائیرؔ<note caller="+" style="f"><char style="fr" closed="false">32‏:41 </char><char style="fq" closed="false">حوّوت یائیرؔ </char><char style="ft" closed="false">یائیرؔ کی بستیاں</char></note> رکھا۔ <verse eid="NUM 32:41"/><verse number="42" style="v" sid="NUM 32:42"/>اَور نوبحؔ نے قناتؔ اَور اُس کے گرد و نواح کی بستیوں کو اَپنے قبضہ میں لے لیا اَور اُس علاقہ کا نام اَپنے ہی نام پر نوبحؔ رکھا۔<verse eid="NUM 32:42"/></para>
  <chapter eid="NUM 32"/>
  <chapter number="33" style="c" sid="NUM 33"/>
  <para style="s1">بنی اِسرائیل کی سفر کی منزلیں</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 33:1"/>جَب بنی اِسرائیل مَوشہ اَور اَہرونؔ کی قیادت میں دستے بنا کر مُلک مِصر سے نکلے تو اُنہُوں نے اَپنے سفر میں حسب ذیل منزلیں طے کیں۔ <verse eid="NUM 33:1"/><verse number="2" style="v" sid="NUM 33:2"/>یَاہوِہ کے حُکم کے مُطابق مَوشہ نے اُن کے سفر کی یہ منزلیں درج کر لیں۔ لہٰذا اُن کا مَنزل بہ مَنزل سفر یُوں رہا:<verse eid="NUM 33:2"/></para>
  <para style="b"/>
  <para style="pi1">
    <verse number="3" style="v" sid="NUM 33:3"/>پہلے مہینے کے پندرھویں دِن یعنی فسح کے دُوسرے دِن بنی اِسرائیل نے رَعمسیسؔ سے کُوچ کیا۔ وہ سَب مِصریوں کی نظروں کے سامنے نہایت دِلیری سے نکل پڑے <verse eid="NUM 33:3"/><verse number="4" style="v" sid="NUM 33:4"/>جو مِصری اَپنے پہلوٹھوں کو جنہیں یَاہوِہ نے مار ڈالا تھا دفن کرنے میں مصروف تھے کیونکہ یَاہوِہ نے اُن کے معبُودوں کو بھی سزا دی تھی۔<verse eid="NUM 33:4"/></para>
  <para style="pi1">
    <verse number="5" style="v" sid="NUM 33:5"/>بنی اِسرائیل رَعمسیسؔ سے کُوچ کرکے سُکّوتؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:5"/></para>
  <para style="pi1">
    <verse number="6" style="v" sid="NUM 33:6"/>اَور سُکّوتؔ سے کُوچ کرکے ایتھامؔ میں جو بیابان کے سِرے پر ہے، خیمہ زن ہویٔے۔<verse eid="NUM 33:6"/></para>
  <para style="pi1">
    <verse number="7" style="v" sid="NUM 33:7"/>پھر وہ ایتھامؔ سے کُوچ کرکے بَعل ضِفونؔ کے مشرق کی جانِب پیہاخیروتؔ کو مُڑے اَور مِگدُلؔ کے نزدیک خیمہ زن ہویٔے۔<verse eid="NUM 33:7"/></para>
  <para style="pi1">
    <verse number="8" style="v" sid="NUM 33:8"/>تَب اُنہُوں نے پیہاخیروتؔ سے کُوچ کیا اَور سمُندر کے درمیان سے گزر کر بیابان میں داخل ہویٔے اَور ایتھامؔ کے بیابان میں تین دِن کی مَسافات طے کرکے مارہؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:8"/></para>
  <para style="pi1">
    <verse number="9" style="v" sid="NUM 33:9"/>مارہؔ سے کُوچ کرکے ایلِمؔ کو گیٔے جہاں پانی کے بَارہ چشمے اَور کھجور کے ستّر درخت تھے اَور وہاں خیمہ زن ہویٔے۔<verse eid="NUM 33:9"/></para>
  <para style="pi1">
    <verse number="10" style="v" sid="NUM 33:10"/>پھر وہ ایلِمؔ سے کُوچ کرکے بحرِقُلزمؔ کے کنارے خیمہ زن ہویٔے۔<verse eid="NUM 33:10"/></para>
  <para style="pi1">
    <verse number="11" style="v" sid="NUM 33:11"/>اَور بحرِقُلزمؔ سے کُوچ کرکے سِنؔ کے بیابان میں خیمہ زن ہویٔے۔<verse eid="NUM 33:11"/></para>
  <para style="pi1">
    <verse number="12" style="v" sid="NUM 33:12"/>دشتِ سِنؔ کے بیابان سے کُوچ کرکے وہ دفقہؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:12"/></para>
  <para style="pi1">
    <verse number="13" style="v" sid="NUM 33:13"/>اَور دفقہؔ سے کُوچ کرکے الُوشؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:13"/></para>
  <para style="pi1">
    <verse number="14" style="v" sid="NUM 33:14"/>الُوشؔ سے کُوچ کرکے وہ رفیدیمؔ میں خیمہ زن ہویٔے جہاں لوگوں کو پینے کے لیٔے پانی نہ مِلا۔<verse eid="NUM 33:14"/></para>
  <para style="pi1">
    <verse number="15" style="v" sid="NUM 33:15"/>رفیدیمؔ سے کُوچ کرکے وہ سِینؔائی کے بیابان میں خیمہ زن ہویٔے۔<verse eid="NUM 33:15"/></para>
  <para style="pi1">
    <verse number="16" style="v" sid="NUM 33:16"/>اَور سِینؔائی کے بیابان سے کُوچ کرکے قِبروتؔ ہتّاوہؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:16"/></para>
  <para style="pi1">
    <verse number="17" style="v" sid="NUM 33:17"/>قِبروتؔ ہتّاوہؔ سے کُوچ کرکے وہ حَضِیروتؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:17"/></para>
  <para style="pi1">
    <verse number="18" style="v" sid="NUM 33:18"/>اَور حَضِیروتؔ سے کُوچ کرکے رِتھمہؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:18"/></para>
  <para style="pi1">
    <verse number="19" style="v" sid="NUM 33:19"/>رِتھمہؔ سے کُوچ کرکے وہ رِمّونؔ پیریزؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:19"/></para>
  <para style="pi1">
    <verse number="20" style="v" sid="NUM 33:20"/>اَور رِمّونؔ پیریزؔ سے کُوچ کرکے لِبناہؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:20"/></para>
  <para style="pi1">
    <verse number="21" style="v" sid="NUM 33:21"/>لِبناہؔ سے کُوچ کرکے وہ ریسّہؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:21"/></para>
  <para style="pi1">
    <verse number="22" style="v" sid="NUM 33:22"/>اَور ریسّہؔ سے کُوچ کرکے قہیلاتہؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:22"/></para>
  <para style="pi1">
    <verse number="23" style="v" sid="NUM 33:23"/>قہیلاتہؔ سے کُوچ کرکے وہ کوہِ شافِرؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:23"/></para>
  <para style="pi1">
    <verse number="24" style="v" sid="NUM 33:24"/>اَور کوہِ شافِرؔ سے کُوچ کرکے حَرادہؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:24"/></para>
  <para style="pi1">
    <verse number="25" style="v" sid="NUM 33:25"/>حَرادہؔ سے کُوچ کرکے مقہیلوتؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:25"/></para>
  <para style="pi1">
    <verse number="26" style="v" sid="NUM 33:26"/>اَور مقہیلوتؔ سے کُوچ کرکے تحتؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:26"/></para>
  <para style="pi1">
    <verse number="27" style="v" sid="NUM 33:27"/>تحتؔ سے کُوچ کرکے وہ تیراحؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:27"/></para>
  <para style="pi1">
    <verse number="28" style="v" sid="NUM 33:28"/>اَور تیراحؔ سے کُوچ کرکے مِتقہؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:28"/></para>
  <para style="pi1">
    <verse number="29" style="v" sid="NUM 33:29"/>مِتقہؔ سے کُوچ کرکے وہ حشمُونہؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:29"/></para>
  <para style="pi1">
    <verse number="30" style="v" sid="NUM 33:30"/>اَور حشمُونہؔ سے کُوچ کرکے موسِیروتؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:30"/></para>
  <para style="pi1">
    <verse number="31" style="v" sid="NUM 33:31"/>موسِیروتؔ سے کُوچ کرکے وہ بنی جعقانؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:31"/></para>
  <para style="pi1">
    <verse number="32" style="v" sid="NUM 33:32"/>اَور بنی جعقانؔ سے کُوچ کرکے حور ہَگِدّگَادؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:32"/></para>
  <para style="pi1">
    <verse number="33" style="v" sid="NUM 33:33"/>حور ہَگِدّگَادؔ سے کُوچ کرکے وہ یُوطباتؔہ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:33"/></para>
  <para style="pi1">
    <verse number="34" style="v" sid="NUM 33:34"/>اَور یُوطباتؔہ سے کُوچ کرکے عبرونہؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:34"/></para>
  <para style="pi1">
    <verse number="35" style="v" sid="NUM 33:35"/>عبرونہؔ سے کُوچ کرکے وہ عضیُون گیبر میں خیمہ زن ہویٔے۔<verse eid="NUM 33:35"/></para>
  <para style="pi1">
    <verse number="36" style="v" sid="NUM 33:36"/>اَور عضیُون گیبر سے کُوچ کرکے صینؔ کے بیابان میں قادِسؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:36"/></para>
  <para style="pi1">
    <verse number="37" style="v" sid="NUM 33:37"/>قادِسؔ سے کُوچ کرکے وہ مُلک اِدُوم کی سرحد پر کوہِ ہُورؔ پر خیمہ زن ہویٔے۔ <verse eid="NUM 33:37"/><verse number="38" style="v" sid="NUM 33:38"/>اَور بنی اِسرائیل کے مِصر سے نکل آنے کے چالیسویں سال کے پانچویں مہینے کے پہلے دِن اَہرونؔ کاہِنؔ یَاہوِہ سے حُکم پا کر کوہِ ہُورؔ پر چڑھ گیا جہاں اُس نے وفات پائی۔ <verse eid="NUM 33:38"/><verse number="39" style="v" sid="NUM 33:39"/>اَور جَب اَہرونؔ نے کوہِ ہُورؔ پر وفات پائی تَب وہ ایک سَو تئیس سال کا تھا۔<verse eid="NUM 33:39"/></para>
  <para style="pi1">
    <verse number="40" style="v" sid="NUM 33:40"/>عَرادؔ کے کنعانی بادشاہ کو جو مُلکِ کنعانؔ کے نِیگیوؔ میں رہتا تھا بنی اِسرائیل کے آنے کی خبر مِلی۔<verse eid="NUM 33:40"/></para>
  <para style="pi1">
    <verse number="41" style="v" sid="NUM 33:41"/>کوہِ ہُورؔ سے کُوچ کرکے وہ ضلمُونہؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:41"/></para>
  <para style="pi1">
    <verse number="42" style="v" sid="NUM 33:42"/>اَور ضلمُونہؔ سے کُوچ کرکے فُونونؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:42"/></para>
  <para style="pi1">
    <verse number="43" style="v" sid="NUM 33:43"/>فُونونؔ سے کُوچ کرکے وہ اوبُوتؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:43"/></para>
  <para style="pi1">
    <verse number="44" style="v" sid="NUM 33:44"/>اَور اوبُوتؔ سے کُوچ کرکے مُوآب کی سرحد پر عیّے عباریمؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:44"/></para>
  <para style="pi1">
    <verse number="45" style="v" sid="NUM 33:45"/>عیّم عباریمؔ سے کُوچ کرکے وہ دیبونؔ گادؔ میں خیمہ زن ہویٔے۔<verse eid="NUM 33:45"/></para>
  <para style="pi1">
    <verse number="46" style="v" sid="NUM 33:46"/>اَور دیبونؔ گادؔ سے کُوچ کرکے علمونؔ دِبلہ تائیمؔ میں خیمہ زن ہویٔے<verse eid="NUM 33:46"/></para>
  <para style="pi1">
    <verse number="47" style="v" sid="NUM 33:47"/>علمونؔ دِبلہ تائیمؔ سے کُوچ کرکے عباریمؔ کے پہاڑوں پر نبوؔ کے مقابل خیمہ زن ہویٔے۔<verse eid="NUM 33:47"/></para>
  <para style="pi1">
    <verse number="48" style="v" sid="NUM 33:48"/>اَور پھر اُنہُوں نے عباریمؔ کے پہاڑوں سے کُوچ کیا اَور مُوآب کے میدانوں میں یردنؔ کے کنارے یریحوؔ کے مقابل خیمہ زن ہویٔے۔ <verse eid="NUM 33:48"/><verse number="49" style="v" sid="NUM 33:49"/>اَور وہاں مُوآب کے میدانوں میں اُنہُوں نے یردنؔ کے کنارے پر بیت یسیموتؔ سے لے کر ابیل شِطِّیمؔ تک اَپنے خیمے کھڑے کئے۔<verse eid="NUM 33:49"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="50" style="v" sid="NUM 33:50"/>تَب یَاہوِہ نے مُوآب کے میدانوں میں یریحوؔ کے مقابل کے یردنؔ کے کنارے پھر مَوشہ سے کہا: <verse eid="NUM 33:50"/><verse number="51" style="v" sid="NUM 33:51"/>”بنی اِسرائیل سے مُخاطِب ہو اَور اُن سے کہہ، ’جَب تُم یردنؔ کو عبور کرکے مُلکِ کنعانؔ میں داخل ہو <verse eid="NUM 33:51"/><verse number="52" style="v" sid="NUM 33:52"/>تو اُس مُلک کے سبھی باشِندوں کو اَپنے سامنے سے نکال دینا اَور اُن کے تراشے ہویٔے بُتوں اَور ڈھالی ہویٔی مورتیوں کو توڑ ڈالنا اَور اُن کے تمام اُونچے مقامات کو مِسمار کردینا۔ <verse eid="NUM 33:52"/><verse number="53" style="v" sid="NUM 33:53"/>تُم اُس مُلک پر قبضہ کرکے اُس میں بُودوباش کرنا کیونکہ مَیں نے وہ مُلک تُمہیں دیا ہے تاکہ تُم اُس کے مالک بنو۔ <verse eid="NUM 33:53"/><verse number="54" style="v" sid="NUM 33:54"/>تُم اَپنی برادریوں کے مُطابق قُرعہ اَندازی کے ذریعہ اُس مُلک کو بانٹ لینا۔ بڑے گِروہ کو زِیادہ مِیراث دینا اَور چُھوٹے کو کم۔ جو حِصّہ قُرعہ اَندازی کے ذریعہ اُن کے نام سے نکلے وہ اُن کا ہوگا۔ تُم اَپنے آبائی قبائل کے مُطابق مِیراث تقسیم کرنا۔<verse eid="NUM 33:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="NUM 33:55"/>” ’لیکن اگر تُم اُس مُلک کے باشِندوں کو نہیں نکالوگے تو جِن کو تُم رہنے دوگے وہ تمہاری آنکھوں میں خار اَور تمہارے پہلوؤں میں کانٹے بَن کر رہ جایٔیں گے اَور جِس مُلک میں تُم بسوگے وہاں وہ تُمہیں دِق کریں گے۔ <verse eid="NUM 33:55"/><verse number="56" style="v" sid="NUM 33:56"/>اَور تَب مَیں تمہارے ساتھ وُہی کروں گا جو میں اُن کے ساتھ کرنا چاہتا ہُوں۔‘ “<verse eid="NUM 33:56"/></para>
  <chapter eid="NUM 33"/>
  <chapter number="34" style="c" sid="NUM 34"/>
  <para style="s1">مُلک کنعانؔ کی حُدوُد</para>
  <para style="lh">
    <verse number="1" style="v" sid="NUM 34:1"/>یَاہوِہ نے مَوشہ سے کہا: <verse eid="NUM 34:1"/><verse number="2" style="v" sid="NUM 34:2"/>”بنی اِسرائیل کو حُکم دے اَور اُن سے کہہ کہ جَب تُم مُلکِ کنعانؔ میں داخل ہو جو مِیراث کے طور پر تمہارے سُپرد کیا جائے گا تو اُس کی حُدوُد یہ رہیں گی۔<verse eid="NUM 34:2"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="3" style="v" sid="NUM 34:3"/>” ’تمہاری جُنوبی سمت میں مُلک اِدُوم کی سرحد سے لگ کر صینؔ کے بیابان کا کچھ حِصّہ شامل ہوگا۔ مشرق کی جانِب تمہاری جُنوبی سرحد بحرمُردار کے سِرے سے شروع ہوکر، <verse eid="NUM 34:3"/><verse number="4" style="v" sid="NUM 34:4"/>درّۂ عقرابیمؔ کے جُنوب سے ہوتی ہُوئی اَور صینؔ سے گزرتی ہُوئی قادِسؔ برنیع کے جُنوب میں جا نکلے۔ تَب وہ حضارادّاؔر کو جا کر عضمُوؔن تک پہُنچے گی، <verse eid="NUM 34:4"/><verse number="5" style="v" sid="NUM 34:5"/>جہاں وہ عضمُوؔن سے مُڑ کر وادی مِصر سے مِل کر سمُندر<note caller="+" style="f"><char style="fr" closed="false">34‏:5 </char><char style="fq" closed="false">سمُندر </char><char style="ft" closed="false">یعنی بہر رُوم</char></note> پر ختم ہوگی۔<verse eid="NUM 34:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="NUM 34:6"/>تمہاری مغربی سرحد بڑے سمُندر کا ساحِل ہوگی۔ یہی تمہاری مغربی سرحد ہوگی۔<verse eid="NUM 34:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 34:7"/>شمالی سرحد کے لیٔے بہر رُوم سے کوہِ ہُورؔ تک ایک لکیر کھینچنا، <verse eid="NUM 34:7"/><verse number="8" style="v" sid="NUM 34:8"/>اَور اُسے کوہِ ہُورؔ سے لیبو حماتؔ کے مدخل تک بڑھا لینا۔ تَب وہ سرحد ضِدادؔ تک جائے گی۔ <verse eid="NUM 34:8"/><verse number="9" style="v" sid="NUM 34:9"/>اَور زِفروُنؔ تک ہوتی ہُوئی حضار عینانؔ پر ختم ہوگی۔ یہ تمہاری شمالی سرحد ہوگی۔<verse eid="NUM 34:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 34:10"/>مشرقی سرحد کے لیٔے حضار عینانؔ سے شفامؔ تک ایک لکیر کھینچنا۔ <verse eid="NUM 34:10"/><verse number="11" style="v" sid="NUM 34:11"/>پھر وہ سرحد شفامؔ سے نیچے کی طرف عینؔ کے مشرق میں رِبلہؔ کو جائے گی اَور کِنّریتؔ کی جھیل<note caller="+" style="f"><char style="fr" closed="false">34‏:11 </char><char style="fq" closed="false">کِنّریتؔ کی جھیل </char><char style="ft" closed="false">یعنی گلِیلی جھیل</char></note> کے مشرق کی ڈھلانوں سے ہوتی ہُوئی نکلے گی۔ <verse eid="NUM 34:11"/><verse number="12" style="v" sid="NUM 34:12"/>تَب وہ سرحد یردنؔ کے کنارے سے نکلتی ہُوئی بحرمُردار پر ختم ہوگی۔</para>
  <para style="b" vid="NUM 34:12"/>
  <para style="lf" vid="NUM 34:12">” ’ہر طرف کی اِن حُدوُد کے اَندر کا مُلک تمہارا ہوگا۔‘ “<verse eid="NUM 34:12"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="NUM 34:13"/>مَوشہ نے بنی اِسرائیل کو حُکم دیا: ”اُس مُلک کو قُرعہ اَندازی کے ذریعہ بطور مِیراث بانٹ لینا۔ یَاہوِہ نے حُکم دیا ہے کہ اِسے ساڑھے نَو قبیلوں کو دیا جائے، <verse eid="NUM 34:13"/><verse number="14" style="v" sid="NUM 34:14"/>کیونکہ رُوبِنؔ کے قبیلہ اَور گادؔ کے قبیلہ اَور منشّہ کے نِصف قبیلہ کے خاندان اَپنی مِیراث پا چُکے ہیں۔ <verse eid="NUM 34:14"/><verse number="15" style="v" sid="NUM 34:15"/>اُن ڈھائی قبیلوں نے یردنؔ کے مشرقی ساحِل پر یریحوؔ کے مقابل جہاں سے آفتاب طُلوع ہوتاہے اَپنی مِیراث پائی ہے۔“<verse eid="NUM 34:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 34:16"/>یَاہوِہ نے مَوشہ سے کہا، <verse eid="NUM 34:16"/><verse number="17" style="v" sid="NUM 34:17"/>”جو لوگ اِس مُلک کو مِیراث کے طور پر تمہارے سُپرد کریں گے اُن کے نام یہ ہیں: الیعزرؔ کاہِنؔ اَور یہوشُعؔ بِن نُونؔ۔ <verse eid="NUM 34:17"/><verse number="18" style="v" sid="NUM 34:18"/>اَور مُلک کو مِیراث کے طور پر بانٹنے میں مدد کرنے کے لیٔے ہر قبیلہ سے ایک سردار کا تقرّر کرنا۔<verse eid="NUM 34:18"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="19" style="v" sid="NUM 34:19"/>”اَور اُن کے نام یہ ہیں:</para>
  <para style="b" vid="NUM 34:19"/>
  <para style="li1" vid="NUM 34:19">”یہُوداہؔ کے قبیلہ سے یفُنّہؔ کا بیٹا کالبؔ؛<verse eid="NUM 34:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 34:20"/>شمعُونؔ کے قبیلہ سے عمّیہُوؔد کا بیٹا شموایلؔ؛<verse eid="NUM 34:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="NUM 34:21"/>بِنیامین کے قبیلہ سے کِسلونؔ کا بیٹا، اِلیدادؔ؛<verse eid="NUM 34:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 34:22"/>دانؔ کے قبیلہ کا سردار یُگلیؔ کا بیٹا بُقّیؔ؛<verse eid="NUM 34:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="NUM 34:23"/>یُوسیفؔ کے بیٹے منشّہ کے قبیلہ کا سردار حنّی ایل بِن افُود۔<verse eid="NUM 34:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="NUM 34:24"/>یُوسیفؔ کے بیٹے اِفرائیمؔ کے قبیلہ کا سردار قمُوایلؔ بِن سِفتانؔ۔<verse eid="NUM 34:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="NUM 34:25"/>زبُولُون کے قبیلہ کا سردار اِلیضفنؔ بِن پرناکؔ۔<verse eid="NUM 34:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="NUM 34:26"/>یِسَّکاؔر کے قبیلہ کا سردار، پَلطیؔ ايلؔ بِن عَزّانؔ؛<verse eid="NUM 34:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="NUM 34:27"/>آشیر کے قبیلہ کا سردار اخیہُودؔ بِن شلُومیؔ۔<verse eid="NUM 34:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="NUM 34:28"/>اَور نفتالی کے قبیلہ کا سردار پِداہیلؔ بِن عمّیہُوؔد۔“<verse eid="NUM 34:28"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="29" style="v" sid="NUM 34:29"/>یہ وہ لوگ ہیں جنہیں یَاہوِہ نے حُکم دیا کہ مُلکِ کنعانؔ میں بنی اِسرائیل کو مِیراث تقسیم کریں۔<verse eid="NUM 34:29"/></para>
  <chapter eid="NUM 34"/>
  <chapter number="35" style="c" sid="NUM 35"/>
  <para style="s1">لیویوں کے شہر</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 35:1"/>یَاہوِہ نے مُوآب کے میدانوں میں جو یریحوؔ کے مقابل یردنؔ کے کنارے پر ہیں مَوشہ سے کہا: <verse eid="NUM 35:1"/><verse number="2" style="v" sid="NUM 35:2"/>”بنی اِسرائیل کو حُکم دے کہ جو مِیراث تُمہیں ملے گی اُس میں سے تُم لیویوں کو اُن کے رہنے کے لیٔے شہر دینا اَور اُن شہروں کے اطراف کی چراگاہیں بھی اُنہیں دینا۔ <verse eid="NUM 35:2"/><verse number="3" style="v" sid="NUM 35:3"/>تَب اُن کے پاس رہنے کے لیٔے شہر اَور اُن کے گائے بَیلوں، بھیڑ بکریوں کے گلّوں اَور اُن کے دُوسرے سبھی مویشیوں کے لیٔے چراگاہیں ہُوں گی۔<verse eid="NUM 35:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 35:4"/>”شہر کے اطراف کی جو چراگاہیں تُم لیویوں کو دوگے وہ شہر کی فصیل سے تقریباً چار سَو مِیٹر دُور تک پھیلی ہُوئی ہُوں۔ <verse eid="NUM 35:4"/><verse number="5" style="v" sid="NUM 35:5"/>تُم شہر کے باہر مشرق کی جانِب تقریباً نَو سَو مِیٹر، جُنوب کی جانِب تقریباً نَو سَو مِیٹر، مغرب کی جانِب تقریباً نَو سَو مِیٹر اَور شمال کی جانِب تقریباً نَو سَو مِیٹر اِس طرح ناپنا کہ شہر اُن کے درمیان آ جائے۔ شہروں کے اطراف کا یہ علاقہ اُن کے لیٔے چراگاہ ہوگا۔<verse eid="NUM 35:5"/></para>
  <para style="s1">پناہ کے شہر</para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 35:6"/>”جو شہر تُم لیویوں کو دو اُن میں سے چھ پناہ کے لیٔے مخصُوص ہُوں جہاں اَیسا شخص جِس نے کسی کا خُون کیا ہو بھاگ جائے۔ اِن کے علاوہ اُنہیں بِیالیس شہر اَور بھی دے دینا۔ <verse eid="NUM 35:6"/><verse number="7" style="v" sid="NUM 35:7"/>کُل مِلا کر تُم لیویوں کو اڑتالیس شہر اُن کی چراگاہوں سمیت دے دینا۔ <verse eid="NUM 35:7"/><verse number="8" style="v" sid="NUM 35:8"/>بنی اِسرائیل کی مِیراث میں سے جو شہر تُم لیویوں کو دو وہ ہر قبیلہ کی مِیراث میں سے اِس اُصُول کے مُطابق لیٔے جایٔیں کہ جِس قبیلہ کے پاس زِیادہ شہر ہُوں اُن سے زِیادہ اَور جِن کے پاس کم ہُوں اُن سے کم طلب کئے جایٔیں۔“<verse eid="NUM 35:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 35:9"/>تَب یَاہوِہ نے مَوشہ سے کہا: <verse eid="NUM 35:9"/><verse number="10" style="v" sid="NUM 35:10"/>”بنی اِسرائیل سے مُخاطِب ہو اَور اُن سے کہہ: جَب تُم یردنؔ کو پار کرکے مُلکِ کنعانؔ پہُنچ جاؤ، <verse eid="NUM 35:10"/><verse number="11" style="v" sid="NUM 35:11"/>تو چند شہر اَپنے لیٔے پناہ کے شہروں کے طور پر چُن لینا جہاں وہ شخص جِس سے غَیر اِرادی طور پر کویٔی قتل سرزد ہو گیا ہو بھاگ کر جا سکے۔ <verse eid="NUM 35:11"/><verse number="12" style="v" sid="NUM 35:12"/>وہ شہر اِنتقام لینے والے سے پناہ پانے کے مقام ہوں گے تاکہ جَب تک قتل کے فَیصلہ کے لیٔے جماعت کے سامنے کھڑا نہ ہو تَب تک مارا نہ جائے۔ <verse eid="NUM 35:12"/><verse number="13" style="v" sid="NUM 35:13"/>یہ چھ شہر جو تُم دوگے تمہارے پناہ کے شہر ہوں گے۔ <verse eid="NUM 35:13"/><verse number="14" style="v" sid="NUM 35:14"/>اِن میں سے تین یردنؔ کے اِس پار اَور تین مُلکِ کنعانؔ میں پناہ کے شہروں کے طور پر دے دینا۔ <verse eid="NUM 35:14"/><verse number="15" style="v" sid="NUM 35:15"/>یہ چھ شہر بنی اِسرائیل کے لیٔے اَور پردیسیوں اَور اُن لوگوں کے لیٔے پناہ کے شہر ہوں گے جو اُن کے درمیان بُودوباش کرتے ہیں تاکہ جو شخص کسی کو غَیر اِرادی طور پر قتل کرے وہ وہاں بھاگ جائے۔<verse eid="NUM 35:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 35:16"/>” ’اگر کویٔی آدمی کسی شخص کو لوہے کی کسی چیز سے اَیسا مارے کہ وہ مَر جائے تو وہ خُونی ٹھہرے گا اَیسا خُونی جان سے ماراجائے۔ <verse eid="NUM 35:16"/><verse number="17" style="v" sid="NUM 35:17"/>یا اگر کسی کے ہاتھ میں جان لیوا پتّھر ہو اَور وہ اُس سے کسی کو اَیسا مارے کہ وہ مَر جائے تو وہ خُونی ٹھہرے گا۔ اَیسا خُونی جان سے ماراجائے۔ <verse eid="NUM 35:17"/><verse number="18" style="v" sid="NUM 35:18"/>یا اگر کسی کے ہاتھ میں لکڑی کی کویٔی جان لیوا چیز ہو اَور وہ اُس سے کسی کو اَیسا مارے کہ وہ مَر جائے تو وہ خُونی ٹھہرے گا۔ اَیسا خُونی جان سے ماراجائے۔ <verse eid="NUM 35:18"/><verse number="19" style="v" sid="NUM 35:19"/>خُون کا اِنتقام لینے والا خُود ہی اُس خُونی کو قتل کرے یعنی جَب بھی اُسے پایٔے اُسی وقت اُسے مار ڈالے۔ <verse eid="NUM 35:19"/><verse number="20" style="v" sid="NUM 35:20"/>اگر کویٔی کسی کو عداوت کے باعث اِرادتاً دھکیل دے یا دانستہ طور پر کویٔی شَے اُس کے اُوپر پھینک دے اَور وہ مَر جائے <verse eid="NUM 35:20"/><verse number="21" style="v" sid="NUM 35:21"/>یا دُشمنی سے اُسے اَپنے ہاتھ سے اَیسا مارے کہ وہ مَر جائے تو وہ شخص جان سے مار ڈالا جائے۔ وہ خُونی ہے۔ خُون کا اِنتقام لینے والا جَب بھی اُس خُونی کو پایٔے اُسے اُسی وقت مار ڈالے۔<verse eid="NUM 35:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 35:22"/>” ’لیکن اگر کویٔی شخص کسی کو بغیر عداوت کے ناگہاں دھکیل دے یا غَیر اِرادتاً کویٔی شَے اُس کے اُوپر پھینک دے <verse eid="NUM 35:22"/><verse number="23" style="v" sid="NUM 35:23"/>یا اُسے دیکھے بغیر اُس کے اُوپر اَیسا پتّھر گرا دے جو اُس کی جان لے سکے اَور وہ مَر جائے تو چونکہ وہ اُس کا دُشمن نہ تھا اَور نہ اُسے ضرر پہُنچانے کا اِرادہ رکھتا تھا، <verse eid="NUM 35:23"/><verse number="24" style="v" sid="NUM 35:24"/>اِس لیٔے جماعت اُس کے اَور خُون کا اِنتقام لینے والے کے درمیان اِن ضوابط کے مُطابق فَیصلہ کرے۔ <verse eid="NUM 35:24"/><verse number="25" style="v" sid="NUM 35:25"/>اَور جماعت اُس قاتل کو خُون کا اِنتقام لینے والے کے ہاتھ سے بچالے اَور اُسے واپس پناہ کے اُس شہر میں بھیج دے جہاں وہ بھاگ گیا تھا۔ مُقدّس تیل سے ممسوح کئے ہویٔے اعلیٰ کاہِن کے زندہ رہنے تک وہ وہیں رہے گا۔<verse eid="NUM 35:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 35:26"/>” ’لیکن اگر وہ مُلزم پناہ کے شہر کی حُدوُد کے باہر نکل جائے جہاں وہ بھاگ کر گیا تھا <verse eid="NUM 35:26"/><verse number="27" style="v" sid="NUM 35:27"/>اَور خُون کا اِنتقام لینے والا اُس مُلزم کو شہر کے باہر پا کر قتل کر ڈالے تو بھی وہ خُون بہانے کا مُجرم نہ ٹھہرے گا۔ <verse eid="NUM 35:27"/><verse number="28" style="v" sid="NUM 35:28"/>چنانچہ مُلزم اعلیٰ کاہِن کاہِنؔ کی موت تک پناہ کے شہر میں ہی رہے اَور اعلیٰ کاہِن کی موت کے بعد ہی وہ اَپنی موروثی جگہ واپس ہو۔<verse eid="NUM 35:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 35:29"/>” ’تُم جہاں بھی رہو تمہاری آنے والی پُشتوں پر آئین کے اِن ہی ضوابط کا اِطلاق ہوگا۔<verse eid="NUM 35:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 35:30"/>” ’اگر کویٔی شخص کسی اِنسان کو مار ڈالے تو اِس قاتل کو گواہوں کی شہادت پر ہی قتل کیا جائے۔ لیکن کسی ایک ہی گواہ کی شہادت پر کویٔی شخص قتل نہ کیا جائے۔<verse eid="NUM 35:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 35:31"/>” ’سزائے موت کے مُستحق خُونی مُجرم کی جان بحالی کے لیٔے فدیہ قبُول نہ کرنا۔ اُسے لازمی طور پر مار ڈالا جائے۔<verse eid="NUM 35:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 35:32"/>” ’اَورجو شخص پناہ کے شہر کو بھاگ گیا ہو اُس کے لیٔے بھی اِس غرض سے فدیہ قبُول نہ کرنا کہ اعلیٰ کاہِن کی موت سے قبل اُسے اَپنے مُلک میں لَوٹ کر رہنے کا موقع مِل سکے۔<verse eid="NUM 35:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 35:33"/>” ’جِس مُلک میں تُم ہو اُسے ناپاک نہ کرنا۔ خُونریزی مُلک کو ناپاک کردیتی ہے اَور اُس مُلک کے لیٔے جِس میں خُون بہایا جائے اُس شخص کے خُون کے علاوہ جِس نے خُون بہایا ہو، اَور کسی چیز کا کفّارہ نہیں دیا جا سَکتا۔ <verse eid="NUM 35:33"/><verse number="34" style="v" sid="NUM 35:34"/>اُس مُلک کو ناپاک نہ کرو جہاں تُم بستے ہو اَور جہاں میں رہتا ہُوں کیونکہ مَیں جو یَاہوِہ ہُوں بنی اِسرائیل کے درمیان رہتا ہُوں۔‘ “<verse eid="NUM 35:34"/></para>
  <chapter eid="NUM 35"/>
  <chapter number="36" style="c" sid="NUM 36"/>
  <para style="s1">ضلافحادؔ کی بیٹیوں کی مِیراث</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 36:1"/>منشّہ کے پوتے اَور مکیرؔ کے بیٹے گِلعادؔ کی برادری کے خاندان کے سربراہوں نے جو یُوسیفؔ کی نَسل کی برادریوں سے تعلّق رکھتے تھے مَوشہ اَور اُن سرداروں کے پاس آکر جو اِسرائیلی خاندانوں کے سربراہ تھے بات چیت کی۔ <verse eid="NUM 36:1"/><verse number="2" style="v" sid="NUM 36:2"/>اُنہُوں نے کہا، ”جَب یَاہوِہ نے ہمارے آقا کو یہ مُلک بنی اِسرائیل کو قُرعہ اَندازی کے ذریعہ بطور مِیراث دینے کا حُکم دیا تو اُنہُوں نے تُمہیں حُکم دیا تھا کہ ہمارے بھایٔی ضلافحادؔ کی مِیراث اُس کی بیٹیوں کو دی جائے۔ <verse eid="NUM 36:2"/><verse number="3" style="v" sid="NUM 36:3"/>بالفرض وہ بنی اِسرائیل کے دُوسرے قبیلوں کے مَردوں سے بیاہ کر لیتی ہیں تو اُن کی مِیراث ہماری آبائی مِیراث سے نکل کر اُس قبیلہ کی مِیراث میں شامل کی جائے گی جِس سے وہ بیاہی جایٔیں گی اَور اِس طرح ہمیں دی ہُوئی مِیراث کا کچھ حِصّہ لے لیا جائے گا۔ <verse eid="NUM 36:3"/><verse number="4" style="v" sid="NUM 36:4"/>اَور جَب بنی اِسرائیل کا یوویلؔ کا سال<note caller="+" style="f"><char style="fr" closed="false">36‏:4 </char><char style="fq" closed="false">یوویلؔ کا سال </char><char style="ft" closed="false">پچاسواں سال</char></note> آئے گا تَب اُن کی مِیراث اُس قبیلہ کی مِیراث میں شامل کی جائے گی جِس میں وہ بیاہی جایٔیں گی اَور اُن کی جائداد ہمارے آباؤاَجداد کی قبائلی مِیراث سے نکل جائے گی۔“<verse eid="NUM 36:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 36:5"/>تَب یَاہوِہ کے حُکم سے مَوشہ نے بنی اِسرائیل کو یہ ہدایت دی: ”یُوسیفؔ کی نَسل کے قبیلہ کے لوگ ٹھیک کہتے ہیں۔ <verse eid="NUM 36:5"/><verse number="6" style="v" sid="NUM 36:6"/>ضلافحادؔ کی بیٹیوں کے حق میں یَاہوِہ کا حُکم یہ ہے، ’وہ جِس کسی کو چاہیں اُس سے بیاہ کر لیں لیکن وہ اَپنے آباؤاَجداد کے قبیلہ کی برادریوں میں ہی بیاہی جایٔیں۔‘ <verse eid="NUM 36:6"/><verse number="7" style="v" sid="NUM 36:7"/>بنی اِسرائیل میں مِیراث ایک قبیلہ سے دُوسرے قبیلہ میں جانے نہ پایٔے اَور ہر اِسرائیلی اَپنا مُلک جسے اُس نے اَپنے آباؤاَجداد سے مِیراث میں پایا ہے اَپنے ہی قبضہ میں رکھے۔ <verse eid="NUM 36:7"/><verse number="8" style="v" sid="NUM 36:8"/>ہر بیٹی جو بنی اِسرائیل کے کسی قبیلہ میں مِیراث پاتی ہے وہ اَپنے آبائی قبیلہ کے برادریوں میں ہی بیاہی جائے تاکہ ہر اِسرائیلی اَپنے آباؤاَجداد کی مِیراث پر قابض رہے۔ <verse eid="NUM 36:8"/><verse number="9" style="v" sid="NUM 36:9"/>کویٔی مِیراث ایک قبیلہ سے دُوسرے قبیلہ میں جانے نہ پایٔے بَلکہ ہر اِسرائیلی قبیلہ اَپنی اَپنی مِیراث اَپنے قبضہ میں رکھے۔“<verse eid="NUM 36:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 36:10"/>چنانچہ ضلافحادؔ کی بیٹیوں نے وَیسا ہی کیا، جَیسا یَاہوِہ نے مَوشہ کو حُکم دیا تھا۔ <verse eid="NUM 36:10"/><verse number="11" style="v" sid="NUM 36:11"/>لہٰذا ضلافحادؔ کی بیٹیاں محلاہؔ، تِرضاؔہ، حُگلاہؔ، مِلکاہؔ، اَور نوحؔا اَپنے چچیرے بھائیوں کے ساتھ بیاہی گئیں۔ <verse eid="NUM 36:11"/><verse number="12" style="v" sid="NUM 36:12"/>یعنی وہ یُوسیفؔ کے بیٹے منشّہ کی نَسل کی برادریوں میں بیاہی گئیں اَور اُن کی مِیراث اُن کے آبائی برادری اَور قبیلہ میں ہی قائِم رہی۔<verse eid="NUM 36:12"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="NUM 36:13"/>جو اَحکام اَور ضوابط یَاہوِہ نے مُوآب کے میدانوں میں یریحوؔ کے پاس یردنؔ کے کنارے پر مَوشہ کی مَعرفت بنی اِسرائیل کو دئیے یہی ہیں۔<verse eid="NUM 36:13"/></para>
  <chapter eid="NUM 36"/>
</usx>
