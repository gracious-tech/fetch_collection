<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JOB" style="id">- Biblica® Open Urdu Contemporary Version</book>
  <para style="h">ایُّوب</para>
  <para style="toc1">ایُّوب کی کِتاب</para>
  <para style="toc2">ایُّوب</para>
  <para style="toc3">ایُّو</para>
  <para style="mt1">ایُّوب</para>
  <para style="mt2">کی کِتاب</para>
  <chapter number="1" style="c" sid="JOB 1"/>
  <para style="s1">تمہید</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 1:1"/>عُوضؔ کی سرزمین میں ایُّوب نام کے ایک شخص رہتے تھے۔ وہ کامل اَور راستباز اِنسان تھے، ایُّوب خُدا سے ڈرتے اَور بدی سے دُور رہتے تھے۔ <verse eid="JOB 1:1"/><verse number="2" style="v" sid="JOB 1:2"/>اُن کے سات بیٹے اَور تین بیٹیاں تھیں، <verse eid="JOB 1:2"/><verse number="3" style="v" sid="JOB 1:3"/>اَور اُن کے پاس سات ہزار بھیڑیں، تین ہزار اُونٹ، پانچ سَو جوڑی بَیل اَور پانچ سَو گدھیاں، اَور اُن کے پاس بے شُمار خادِم بھی تھے۔ غرض اہلِ مشرق میں ایُّوب کا مرتبہ نہایت ہی بُلند تھا۔<verse eid="JOB 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOB 1:4"/>اُن کے بیٹے اَپنے دستور کے مُطابق اَپنی باری باری سے اَپنے اَپنے گھروں میں ضیافت کیا کرتے تھے اَور اَپنی تینوں بہنوں کو بھی دعوت دیتے تھے تاکہ وہ بھی اُن کے ساتھ دسترخوان پر شریک ہُوں۔ <verse eid="JOB 1:4"/><verse number="5" style="v" sid="JOB 1:5"/>جَب ضیافت کا دَور پُورا ہو جاتا تھا تو ایُّوب اُنہیں بُلاتے اَور اُن کی طہارت کے بعد صُبح کو سویرے اُٹھ کر ہی اُن سَب کے لیٔے سوختنی نذر پیش کرتے تھے کیونکہ وہ سوچتے تھے، ”شاید میرے بچّوں سے کویٔی خطا ہویٔی ہو، اَور اُنہُوں نے اَپنے دِل میں خُدا کی تکفیر کی ہو۔“ اَیسا کرنا ایُّوب کا دستور بَن گیا تھا۔<verse eid="JOB 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 1:6"/>ایک دِن خُدا کے بیٹے<note caller="+" style="f"><char style="fr" closed="false">1‏:6 </char><char style="fq" closed="false">خُدا کے بیٹے </char><char style="ft" closed="false">یعنی فرشتے</char></note> یعنی فرشتے یَاہوِہ کے رُوبرو حاضِر ہُوئے اَور شیطان بھی اُن کے ساتھ حاضِر ہُوا۔ <verse eid="JOB 1:6"/><verse number="7" style="v" sid="JOB 1:7"/>یَاہوِہ نے شیطان سے پُوچھا، ”تُو کہاں سے آ رہاہے؟“</para>
  <para style="p" vid="JOB 1:7">شیطان نے یَاہوِہ کو جَواب دیا، ”میں پُورے زمین کی سَیر کرتا ہُوا اَور اُس میں اِدھر اُدھر گھُومتے پھرتے آ رہا ہُوں۔“<verse eid="JOB 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JOB 1:8"/>تَب یَاہوِہ نے شیطان سے پُوچھا، ”کیا تُونے میرے خادِم ایُّوب پر غور کیا ہے؟ کیونکہ پُوری زمین پر اُس کی مانند کامل اَور راستباز شخص کویٔی نہیں ہے جو خُدا سے ڈرتا اَور بدی سے دُور رہتا ہو۔“<verse eid="JOB 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JOB 1:9"/>شیطان نے یَاہوِہ کو جَواب دیا، ”کیا ایُّوب بلاوجہ خُدا سے ڈرتا ہے؟“<note caller="+" style="f"><char style="fr" closed="false">1‏:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="REV 12:10">مُکا 12‏:10</ref>‏</char></char></note> <verse eid="JOB 1:9"/><verse number="10" style="v" sid="JOB 1:10"/>”کیا آپ نے اُس کے، اَور اُس کے خاندان کے اَور اُس کی ہر چیز کے اِردگرد حِفاظتی باڑ نہیں لگا رکھی ہے؟ آپ نے اُس کے ہاتھوں کے کاموں میں برکت بخشی ہے جِس کے باعث اُس کے بھیڑ بکریوں اَور گائے بَیلوں کی تعداد بڑھ کر سارے مُلک میں پھیل گیٔے ہیں۔ <verse eid="JOB 1:10"/><verse number="11" style="v" sid="JOB 1:11"/>لیکن ذرا اَپنا ہاتھ بڑھائیں اَور اُس کا سَب کچھ برباد کر دیں تو وہ یقیناً آپ کے مُنہ پر آپ کی تکفیر کرےگا۔“<verse eid="JOB 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JOB 1:12"/>یَاہوِہ نے شیطان سے کہا، ”بہت خُوب! اُس کی ہر شَے پر مَیں تُجھے اِختیار دیتا ہُوں، لیکن ایُّوب کو ہاتھ مت لگانا۔“</para>
  <para style="p" vid="JOB 1:12">تَب شیطان یَاہوِہ کے حُضُور سے چلا گیا۔<verse eid="JOB 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JOB 1:13"/>ایک دِن جَب ایُّوب کے بیٹے اَور بیٹیاں اَپنے بڑے بھایٔی کے گھر میں ضیافت کر رہے تھے اَور انگوری شِیرہ نوشی میں مصروف تھے، <verse eid="JOB 1:13"/><verse number="14" style="v" sid="JOB 1:14"/>تبھی ایک قاصِد ایُّوب کے پاس آیا اَور کہنے لگا، ”بَیل کھیت میں ہل چلا رہے تھے اَور گدھے اُن کے نزدیک چَر رہے تھے، <verse eid="JOB 1:14"/><verse number="15" style="v" sid="JOB 1:15"/>کہ کچھ مُلکِ شیبا کے لوگ آئے اَور اُن پر ٹوٹ پڑے اَور اُنہیں لے گیٔے۔ اُنہُوں نے تلوار سے خادِموں کو تہِ تیغ کر ڈالا اَور صِرف میں ہی اکیلا بچ نِکلا تاکہ آپ کو خبر دُوں۔“<verse eid="JOB 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JOB 1:16"/>وہ ابھی یہ کہہ ہی رہاتھا کہ ایک اَور قاصِد آیا اَور کہنے لگا، ”آسمان سے خُدا کی آگ نازل ہویٔی اَور بھیڑوں اَور خادِموں کو بھسم کر دیا اَور صِرف میں ہی اکیلا بچ نِکلا تاکہ آپ کو خبر دُوں۔“<verse eid="JOB 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JOB 1:17"/>وہ ابھی یہ کہہ ہی رہاتھا کہ ایک اَور قاصِد آکر کہنے لگا، ”کَسدی<note caller="+" style="f"><char style="fr" closed="false">1‏:17 </char><char style="fq" closed="false">کَسدی</char><char style="ft" closed="false">حملہ آوروں کا ایک گِروہ دکھائی دیتاہے، شاید ایُّوب کی سرزمین کے شمال میں۔</char></note> تین گِروہوں میں تقسیم ہوکر آپ کے اُونٹوں پر ٹوٹ پڑے اَور اُنہیں لے گیٔے۔ اُنہُوں نے خادِموں کو تلوار سے تہِ تیغ کر ڈالا اَور صِرف میں ہی اکیلا بچ نِکلا تاکہ آپ کو خبر دُوں۔“<verse eid="JOB 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JOB 1:18"/>وہ ابھی یہ کہہ ہی رہاتھا کہ ایک اَور قاصِد آیا اَور کہنے لگا، ”آپ کے بیٹے اَور بیٹیاں اَپنے بڑے بھایٔی کے گھر میں ضیافت کر رہے تھے اَور انگوری شِیرہ نوشی میں مصروف تھے، <verse eid="JOB 1:18"/><verse number="19" style="v" sid="JOB 1:19"/>کہ اَچانک بیابان کی جانِب سے ایک زوردار آندھی آئی اَور مکان کے چاروں کونوں سے یُوں ٹکرائی کہ وہ اُن جَوانوں پر گِر پڑا اَور سَب مَر گیٔے۔ صِرف میں ہی اکیلا بچ نِکلا تاکہ آپ کو خبر دُوں۔“<verse eid="JOB 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JOB 1:20"/>تَب ایُّوب اُٹھ کھڑے ہُوئے اَور رنجیدہ ہوکر اَپنا لباس چاک کیا اَور سَر مُنڈوایا اَور زمین پر گِر کر خُدا کو سَجدہ کیا<note caller="+" style="f"><char style="fr" closed="false">1‏:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="EZR 9:3">عزرا 9‏:3</ref>‏</char></char></note> <verse eid="JOB 1:20"/><verse number="21" style="v" sid="JOB 1:21"/>اَور کہا:</para>
  <para style="q1" vid="JOB 1:21">”میں اَپنی ماں کے پیٹ سے ننگا نِکلا،</para>
  <para style="q2" vid="JOB 1:21">اَور ننگا ہی واپس چلا جاؤں گا۔</para>
  <para style="q1" vid="JOB 1:21">یَاہوِہ نے دیا اَور یَاہوِہ نے لے لیا؛</para>
  <para style="q2" vid="JOB 1:21">یَاہوِہ کے نام کی سِتائش ہو۔“<note caller="+" style="f"><char style="fr" closed="false">1‏:21 </char><char style="ft" closed="false"><char style="xt"><ref loc="ECC 5:15">واعظ 5‏:15</ref>‏</char></char></note><verse eid="JOB 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JOB 1:22"/>اِن سَب باتوں میں، ایُّوب نے نہ تو گُناہ کیا اَور نہ خُدا کو اِن سَب باتوں کا ذمّہ دار ٹھہرا کر کُفر بکا۔<verse eid="JOB 1:22"/></para>
  <para style="b"/>
  <chapter eid="JOB 1"/>
  <chapter number="2" style="c" sid="JOB 2"/>
  <para style="s1">ایُّوب کی دُوسری آزمائش</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 2:1"/>ایک اَور دِن خُدا کے بیٹے یعنی فرشتے حاضِر ہویٔے تاکہ یَاہوِہ کے رُوبرو پیش ہُوں اَور شیطان بھی اُن کے ساتھ آیا تاکہ وہ بھی یَاہوِہ کے سامنے پیش ہو۔ <verse eid="JOB 2:1"/><verse number="2" style="v" sid="JOB 2:2"/>اَور یَاہوِہ نے شیطان سے پُوچھا، ”تُو کہاں سے آ رہاہے؟“</para>
  <para style="p" vid="JOB 2:2">شیطان نے یَاہوِہ کو جَواب دیا، ”میں پُورے زمین کی سَیر کرتا ہُوا اَور اُس میں اِدھر اُدھر گھُومتے پھرتے آ رہا ہُوں۔“<verse eid="JOB 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JOB 2:3"/>تَب یَاہوِہ نے شیطان سے پُوچھا، ”کیا تُونے میرے خادِم ایُّوب پر غور کیا ہے؟ کیونکہ پُوری زمین پر اُس کی مانند کامل اَور راستباز شخص کویٔی نہیں ہے جو خُدا سے ڈرتا اَور بدی سے دُور رہتا ہو۔ اَور وہ اَپنی راستبازی پر ابھی تک قائِم ہے، حالانکہ تُونے مُجھے بلاوجہ اُسے برباد کرنے کے لیٔے اُکسایا تھا۔“<verse eid="JOB 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOB 2:4"/>”کھال کے بدلے کھال!“ شیطان نے یَاہوِہ کو جَواب دیا۔ ”اِنسان اَپنی جان کو بچانے کی خاطِر اَپنا سَب کچھ لُٹا دے گا۔ <verse eid="JOB 2:4"/><verse number="5" style="v" sid="JOB 2:5"/>لیکن اَب ذرا اَپنا ہاتھ تو بڑھا اَور ایُّوب کے جِسم کو دُکھ تکلیف دے پھر دیکھنا کہ وہ آپ کے مُنہ پر ہی آپ کی تکفیر یقیناً کرنے لگے گا۔“<verse eid="JOB 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 2:6"/>یَاہوِہ نے شیطان سے کہا، ”بہت خُوب، وہ تیرے اِختیار میں ہے لیکن تُو اُس کی جان کو ضروُر محفوظ رکھنا۔“<verse eid="JOB 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOB 2:7"/>تَب شیطان یَاہوِہ کے حُضُور سے چلا گیا اَور اُس نے ایُّوب پر اَیسا حملہ کیا کہ اُن کے جِسم میں سَر سے پاؤں تک دردناک پھوڑے نکل آئے۔ <verse eid="JOB 2:7"/><verse number="8" style="v" sid="JOB 2:8"/>تَب ایُّوب ٹُوٹے ہُوئے مٹّی کے برتن کا ایک ٹکڑا لے کر راکھ میں بیٹھ گیٔے اَور اَپنا بَدن کھجلانے لگے۔<verse eid="JOB 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JOB 2:9"/>اُن کی بیوی نے ایُّوب سے کہا، ”کیا تُم اَب بھی اَپنی راستبازی پر قائِم رہوگے؟ خُدا پر لعنت بھیجو اَور مَر جاؤ۔“<verse eid="JOB 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JOB 2:10"/>ایُّوب نے جَواب دیا، ”تُم بےوقُوف عورت کی طرح باتیں کر رہی ہو۔ کیا ہم خُدا کی طرف سے صِرف سُکھ ہی قبُول کریں اَور دُکھ قبُول نہ کریں۔“</para>
  <para style="p" vid="JOB 2:10">اِن سَب باتوں میں، ایُّوب نے اَپنی زبان سے کویٔی گُناہ نہیں کیا۔<verse eid="JOB 2:10"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="11" style="v" sid="JOB 2:11"/>جَب ایُّوب کے تینوں دوستوں کو اُن کی تمام مُصیبتوں اَور دردناک حالات کی خبر مِلی جو ایُّوب پر نازل ہُوئی تھیں، تو تینوں اَپنے اَپنے گھر سے ایُّوب سے مِلنے آئے، تیمانؔ سے اِلیفزؔ، شوحی سے بِلددؔ اَور نَعمات سے صُوفرؔ۔ اِن تینوں نے آپَس میں عہد کیا تھا کہ جا کر ایُّوب سے ہمدردی جتائیں گے اَور اُنہیں تسلّی دیں گے۔ <verse eid="JOB 2:11"/><verse number="12" style="v" sid="JOB 2:12"/>جَب اُنہُوں نے ایُّوب کو دُور سے دیکھا تو بڑی مُشکل سے پہچان پایٔے۔ وہ رنجیدہ ہوکر زار زار رونے لگے اَور اَپنے لباس چاک کرکے اَپنے سَروں پر خاک ڈال لی۔<note caller="+" style="f"><char style="fr" closed="false">2‏:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="EZK 27:30-31">حزقی 27‏:30‏‑31</ref>‏</char></char></note> <verse eid="JOB 2:12"/><verse number="13" style="v" sid="JOB 2:13"/>پھر وہ سات دِن اَور سات رات تک آپ کے پاس زمین پر بیٹھے رہے اَور کچھ نہ کہہ سکے کیونکہ ایُّوب کی تکلیف کی شِدّت بَیان سے باہر تھی۔<verse eid="JOB 2:13"/></para>
  <chapter eid="JOB 2"/>
  <chapter number="3" style="c" sid="JOB 3"/>
  <para style="s1">ایُّوب کا پہلا بَیان</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 3:1"/>اِس کے بعد ایُّوب نے اَپنا مُنہ کھول کر اَپنی پیدائش کے دِن پر لعنت بھیجنے لگے۔ <verse eid="JOB 3:1"/><verse number="2" style="v" sid="JOB 3:2"/>ایُّوب نے فرمایا:<verse eid="JOB 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 3:3"/>”نابود ہو جائے وہ دِن جِس دِن میں پیدا ہُوا تھا،</para>
  <para style="q2" vid="JOB 3:3">اَور وہ رات بھی جِس میں یہ اعلان کیا گیا، ’پیٹ میں لڑکا حاملہ ہُواہے!‘<verse eid="JOB 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 3:4"/>وہ دِن تاریکی میں تبدیل ہو جائے؛</para>
  <para style="q2" vid="JOB 3:4">اَور خُدا آسمان سے بھی اُس کی طرف غور نہ کرے؛</para>
  <para style="q2" vid="JOB 3:4">اَور نہ ہی اُس پر کویٔی رَوشنی چمکے۔<verse eid="JOB 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 3:5"/>تاریکی اَور موت کا گہرا سایہ اُس پر قابض ہو؛</para>
  <para style="q2" vid="JOB 3:5">بدلی اُس پر ہمیشہ چھائی رہے؛</para>
  <para style="q2" vid="JOB 3:5">اَور وہ رَوشنی سے محروم ہوکر سخت دہشت زدہ ہو جائے۔<verse eid="JOB 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 3:6"/>گہری تاریکی اُس رات پر قابض ہو جائے؛</para>
  <para style="q2" vid="JOB 3:6">اُسے نہ تو سال کے دِنوں میں،</para>
  <para style="q2" vid="JOB 3:6">اَور نہ ہی کسی مہینے کے دِنوں میں دوبارہ شُمار کیا جائے۔<verse eid="JOB 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 3:7"/>کاش وہ رات بانجھ ہو جاتی؛</para>
  <para style="q2" vid="JOB 3:7">اَور اُس میں خُوشی کی کویٔی صدا سُنایٔی نہ دیتی۔<verse eid="JOB 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 3:8"/>وہ جو دِنوں پر لعنت بھیجتے رہتے ہیں،</para>
  <para style="q2" vid="JOB 3:8">اَور لِویاتان اَژدہے کو تحریک میں لانے کے قابل ہوتے ہیں،</para>
  <para style="q2" vid="JOB 3:8">وُہی اُس رات پر بھی لعنت کریں۔<verse eid="JOB 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 3:9"/>اُس کی صُبح کے سِتارے تاریک ہو جایٔیں؛</para>
  <para style="q2" vid="JOB 3:9">اَور دِن کی رَوشنی کا اِنتظار بے فائدہ ہی رہے</para>
  <para style="q2" vid="JOB 3:9">اَور نہ ہی وہ صُبح کی پہلی کرنوں کو دیکھنے پایٔے،<verse eid="JOB 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 3:10"/>کیونکہ اُس نے میری ماں کو مُجھے پیدا کرنے سے نہیں روکا،</para>
  <para style="q2" vid="JOB 3:10">ورنہ یہ تمام مُصیبت میری آنکھوں سے چھپی رہتی۔<verse eid="JOB 3:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 3:11"/>”میں پیدائش کے وقت ہی ہلاک کیوں نہ ہو گیا،</para>
  <para style="q2" vid="JOB 3:11">یا رحم سے نکلتے ہی مَر کیوں نہ گیا؟<verse eid="JOB 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 3:12"/>میرے اِستِقبال کے لیٔے گھُٹنے کیوں تھے</para>
  <para style="q2" vid="JOB 3:12">اَور ماں کی چھاتِیوں نے مُجھے دُودھ کیوں پِلایا؟<verse eid="JOB 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 3:13"/>ورنہ اِس وقت مَیں سکون سے لیٹا ہوتا؛</para>
  <para style="q2" vid="JOB 3:13">اَور آرام کی نیند سو رہا ہوتا۔<note caller="+" style="f"><char style="fr" closed="false">3‏:13 </char><char style="ft" closed="false">نیند موت کا عکس ہے (<char style="xt"><ref loc="DEU 31:16">اِست 31‏:16</ref>؛ <ref loc="PSA 13:3">زبُور 13‏:3</ref>؛ <ref loc="1CO 15:51">1 کُرن 15‏:51</ref>‏</char>)۔ اِس آیت کی دونوں سطریں موت کے استعارے پر مُشتمل ہیں: لیٹنا اَور سو جانا۔</char></note><verse eid="JOB 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 3:14"/>دُنیا کے بادشاہوں اَور مُشیروں کے ساتھ،</para>
  <para style="q2" vid="JOB 3:14">جنہوں نے اَپنے لیٔے مقبرے بنائے جو اَب کھنڈرات بَن کر رہ گیٔے ہیں،<verse eid="JOB 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 3:15"/>یا میں اُن حُکمرانوں کے ساتھ ہوتا جِن کے پاس سونا تھا،</para>
  <para style="q2" vid="JOB 3:15">اَور جنہوں نے اَپنے مکان چاندی سے بھر لیٔے تھے۔<verse eid="JOB 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 3:16"/>یا ایک ساقط حَمل کی مانند زمین کے اَندر ہی چھُپا رہتا،</para>
  <para style="q2" vid="JOB 3:16">یا اُس بچّہ کی طرح کیوں نہ دفنایا گیا جِس نے کبھی دِن کی رَوشنی ہی نہ دیکھی ہو؟<verse eid="JOB 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 3:17"/>وہاں بدکار اِنسان بھی اَپنی بے لگام حرکتوں سے بعض رہتے ہیں،</para>
  <para style="q2" vid="JOB 3:17">اَور خستہ حال بھی راحت پاتے ہیں۔<verse eid="JOB 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 3:18"/>وہاں قَیدی بھی اَپنی رِہائی کا لُطف اُٹھاتے ہیں؛</para>
  <para style="q2" vid="JOB 3:18">اَب اُنہیں پہرےداروں کا چِلّانا سُنایٔی نہیں دیتا۔<verse eid="JOB 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 3:19"/>ادنیٰ و اعلیٰ سَب وُہی ہیں،</para>
  <para style="q2" vid="JOB 3:19">اَور غُلام اَپنے آقا سے آزاد ہو چُکے ہیں۔<verse eid="JOB 3:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 3:20"/>”خُدا مُصیبت زدوں کو رَوشنی،</para>
  <para style="q2" vid="JOB 3:20">اَور تلخ جان والوں کو زندگی کیوں عطا کرتے ہیں،<verse eid="JOB 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 3:21"/>جو موت کا نہایت ہی بے تابی سے اِنتظار کرتے ہیں لیکن اُنہیں نصیب نہیں ہوتی،</para>
  <para style="q2" vid="JOB 3:21">وہ اُسے پوشیدہ خزانہ سے بھی زِیادہ تلاش کرتے ہیں، مگر پاتے نہیں،<verse eid="JOB 3:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 3:22"/>جَب اُنہیں قبر نصیب ہو جاتی ہے تو،</para>
  <para style="q2" vid="JOB 3:22">وہ نہایت شادمان اَور جَشن مناتے ہیں؟<verse eid="JOB 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 3:23"/>اَیسے شخص کو جِس کی راہ پوشیدہ ہے</para>
  <para style="q2" vid="JOB 3:23">زندگی کیوں ملتی ہے،</para>
  <para style="q2" vid="JOB 3:23">جِس کے خُدا نے سارے راستے بند کر دئیے ہیں؟<verse eid="JOB 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 3:24"/>غِذا کی بجائے مُجھے آہیں کھانے کو ملتی ہیں؛</para>
  <para style="q2" vid="JOB 3:24">میرا کراہنا پانی کی دھار کی طرح جاری ہے۔<verse eid="JOB 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 3:25"/>کیونکہ جِس بات کا مُجھے خوف تھا وُہی مُجھ پر آن پڑی؛</para>
  <para style="q2" vid="JOB 3:25">آخِر وُہی ہُوا جِس کا مُجھے ڈر تھا۔<verse eid="JOB 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 3:26"/>مُجھے نہ سکون حاصل ہے نہ اِطمینان؛</para>
  <para style="q2" vid="JOB 3:26">آرام مُیسّر نہیں، بس پریشانی ہی پریشانی ہے۔“<verse eid="JOB 3:26"/></para>
  <chapter eid="JOB 3"/>
  <chapter number="4" style="c" sid="JOB 4"/>
  <para style="s1">الیفزؔ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 4:1"/>تَب تیمانی شہری اِلیفزؔ نے ایُّوب کو جَواب دیا:<verse eid="JOB 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 4:2"/>”اگر کوئی آپ سے کوئی بات کرے تو کیا آپ صبر رکھ کر میری بات غور سے سنوگے؟</para>
  <para style="q2" vid="JOB 4:2">اِس لیٔے کہ کون اَپنا مُنہ بند کرکے چُپ رہ سَکتا ہے؟<verse eid="JOB 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 4:3"/>ذرا غور کرو آپ نے کس طرح کیٔی لوگوں کی ہدایت فرمائی،</para>
  <para style="q2" vid="JOB 4:3">اَور کس طرح آپ نے کمزور ہاتھوں کو تقویّت دی۔<verse eid="JOB 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 4:4"/>آپ کے الفاظ نے لڑکھڑاتے ہوؤں کو سہارا دیا؛</para>
  <para style="q2" vid="JOB 4:4">اَور آپ نے لرزتے ہُوئے گھٹنوں کو قُوّت بخشی۔<verse eid="JOB 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 4:5"/>لیکن اَب جَب آپ پر آفت آئی تو آپ نے ہمّت ہار دی؛</para>
  <para style="q2" vid="JOB 4:5">اُس نے آپ کو ہاتھ لگایا اَور آپ پریشان ہو گئے۔<verse eid="JOB 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 4:6"/>کیا آپ کو اَپنی راستی پر بھروسا نہیں</para>
  <para style="q2" vid="JOB 4:6">اَور اَپنے بے اِلزام طور طریقوں پر آپ کو کویٔی اُمّید نہیں؟<verse eid="JOB 4:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 4:7"/>”ذرا غور تو کرو، کیا کویٔی بے قُصُور کبھی ہلاک ہُواہے؟</para>
  <para style="q2" vid="JOB 4:7">یا راستباز کبھی نِیست نابود ہُوئے ہیں؟<verse eid="JOB 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 4:8"/>جہاں تک مَیں نے دیکھاہے کہ جو بدی کی کھیتی کا ہل چلاتے ہیں</para>
  <para style="q2" vid="JOB 4:8">اَور نُقصان کا بیج بوتے ہیں، وہ وَیسی ہی فصل کاٹتے بھی ہیں۔<verse eid="JOB 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 4:9"/>اَیسے لوگ خُدا کی ایک پھُونک سے ہلاک ہو جاتے ہیں؛</para>
  <para style="q2" vid="JOB 4:9">اَور اُن کے غضب کی آندھی سے فنا ہو جاتے ہیں۔<verse eid="JOB 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 4:10"/>شیر چاہے جِتنا دھاڑ مارے اَور غُرّائے،</para>
  <para style="q2" vid="JOB 4:10">پھر بھی خُونخوار شیر ببروں کے دانت توڑ دئیے جاتے ہیں۔<verse eid="JOB 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 4:11"/>شِکار نہ مِلنے کی وجہ سے شیر ہلاک ہو جاتا ہے،</para>
  <para style="q2" vid="JOB 4:11">اَور شیرنی کے بچّے پراگندہ ہو جاتے ہیں۔<verse eid="JOB 4:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 4:12"/>”ایک بات چُپکے سے مُجھ تک پہُنچائی گئی،</para>
  <para style="q2" vid="JOB 4:12">اَور میرے کانوں میں اُس کی آواز سُنایٔی دی۔<verse eid="JOB 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 4:13"/>رات کو مَیں نے ایک پریشان کر دینے والی رُویا دیکھی،</para>
  <para style="q2" vid="JOB 4:13">جَب اِنسان گہری نیند میں سویا ہوتاہے،<verse eid="JOB 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 4:14"/>تَب خوف اَور تھرتھراہٹ نے مُجھے آن دبوچا</para>
  <para style="q2" vid="JOB 4:14">اَور میری تمام ہڈّیوں کو جھنجوڑ ڈالا۔<verse eid="JOB 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 4:15"/>تَب ایک رُوح میرے سامنے سے گزری،</para>
  <para style="q2" vid="JOB 4:15">اَور میرے جِسم کے رونگٹے کھڑے ہو گئے۔<verse eid="JOB 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 4:16"/>وہ رُوح ایک جگہ کھڑی ہو گئی،</para>
  <para style="q2" vid="JOB 4:16">لیکن مَیں اُسے پہچان نہ پایا۔</para>
  <para style="q1" vid="JOB 4:16">بس ایک صورت سِی میری آنکھوں کے سامنے تھی،</para>
  <para style="q2" vid="JOB 4:16">پھر مُجھے ایک دھیمی آواز سُنایٔی دی:<verse eid="JOB 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 4:17"/>’کیا فانی اِنسان خُدا سے زِیادہ راستباز ہو سَکتا ہے؟</para>
  <para style="q2" vid="JOB 4:17">یا آدمی اَپنے خالق خُدا سے زِیادہ پاک ہو سَکتا ہے؟<verse eid="JOB 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 4:18"/>اگر خُدا اَپنے آسمانی خادِموں پر اِعتبار نہیں کرتا،</para>
  <para style="q2" vid="JOB 4:18">اَور اَپنے فرشتوں کو بھی خطاکار قرار ٹھہراتا ہے،<verse eid="JOB 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 4:19"/>تو پھر اُن کی حیثیت کیا ہے جو مٹّی کے گھروں میں رہتے ہیں،</para>
  <para style="q2" vid="JOB 4:19">جِن کی بُنیاد خاک میں ہے،</para>
  <para style="q2" vid="JOB 4:19">اَورجو کیڑے کی طرح مسل دئیے جاتے ہیں!<verse eid="JOB 4:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 4:20"/>صُبح کو تو وہ زندہ ہیں لیکن شام تک وہ فنا ہو جاتے ہیں،</para>
  <para style="q2" vid="JOB 4:20">وہ نِیست و نابود ہو جاتے ہیں اَور کسی کو کانوں کان خبر تک نہیں ہوتی۔<verse eid="JOB 4:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 4:21"/>کیا اُن کے خیمہ کی رسّیاں کھولی نہیں جاتی<note caller="+" style="f"><char style="fr" closed="false">4‏:21 </char><char style="fq" closed="false">رسّیاں کھولی نہیں جاتی </char><char style="ft" closed="false">اِس کے پاس جو کچھ ہے وہ سَب چھین لیا جاتا ہے۔</char></note> ہیں اَور اُن کا خیمہ گِر جاتا ہے،</para>
  <para style="q2" vid="JOB 4:21">اَور وہ جہالت میں مَر جاتے ہیں؟‘<verse eid="JOB 4:21"/></para>
  <para style="b"/>
  <chapter eid="JOB 4"/>
  <chapter number="5" style="c" sid="JOB 5"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 5:1"/>”ذرا آواز دو، کیا کویٔی ہے جو تُمہیں جَواب دے گا؟</para>
  <para style="q2" vid="JOB 5:1">تُم مُقدّسین میں سے کس کی طرف رُجُوع کروگے؟<verse eid="JOB 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 5:2"/>کیونکہ رنجیدگی بےوقُوف کو مار ڈالتی ہے،</para>
  <para style="q2" vid="JOB 5:2">اَور حَسد سادہ دِلوں کی جان لے لیتا ہے۔<verse eid="JOB 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 5:3"/>مَیں نے خُود ایک بےوقُوف کو جڑ پکڑتے دیکھاہے،</para>
  <para style="q2" vid="JOB 5:3">لیکن اَچانک اُس کا گھر لعنتی ہو گیا۔<verse eid="JOB 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 5:4"/>اُس کی اَولاد سلامتی سے دُور رہتی ہے،</para>
  <para style="q2" vid="JOB 5:4">اُنہیں عدالت میں کسی مُحافظ کے نہ ہونے سے روندا جاتا ہے۔<verse eid="JOB 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 5:5"/>بھُوکے اُس کی فصل کھا جاتے ہیں،</para>
  <para style="q2" vid="JOB 5:5">یہاں تک کہ کانٹے دار باڑوں میں محفوظ فصل بھی لے لیتے ہیں،</para>
  <para style="q2" vid="JOB 5:5">اَور لالچی اُس کی دولت نگل جاتے ہیں۔<verse eid="JOB 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 5:6"/>کیونکہ مُصیبت خاک میں سے نہیں نکلتی،</para>
  <para style="q2" vid="JOB 5:6">اَور نہ ہی آفت زمین سے اُگتی ہے۔<verse eid="JOB 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 5:7"/>جَیسے چنگاریاں اُوپر کی طرح ہی اُٹھتی ہیں۔</para>
  <para style="q2" vid="JOB 5:7">وَیسے ہی اِنسان بھی دُکھ اُٹھانے کے لیٔے پیدا ہُواہے۔<verse eid="JOB 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 5:8"/>”لیکن اگر مَیں تمہاری جگہ ہوتا تو میں خُدا سے اِلتجا کرتا؛</para>
  <para style="q2" vid="JOB 5:8">اَور مَیں اَپنا مُعاملہ خُدا کے سامنے رکھتا۔<verse eid="JOB 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 5:9"/>خُدا اِس قدر حیرت اَنگیز کام کرتے ہیں جو سمجھ سے باہر ہیں،</para>
  <para style="q2" vid="JOB 5:9">اَور اِتنے معجزے کرتے ہیں جنہیں گِنا نہیں جا سَکتا۔<verse eid="JOB 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 5:10"/>وہ رُوئے زمین پر مینہ برساتے ہیں؛</para>
  <para style="q2" vid="JOB 5:10">اَور کھیتوں کو سیراب کرتے ہیں۔<verse eid="JOB 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 5:11"/>وہ مسکینوں کو اُونچے مقاموں پر بِٹھاتے ہیں،</para>
  <para style="q2" vid="JOB 5:11">اَور ماتم کرنے والوں کو سلامتی بخشتے ہیں۔<verse eid="JOB 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 5:12"/>وہ عیّاروں کے منصُوبے ناکام کر دیتے ہیں،</para>
  <para style="q2" vid="JOB 5:12">تاکہ اُن کے ہاتھ ناکامی حاصل ہو۔<verse eid="JOB 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 5:13"/>وہ داناؤں کو اُن ہی کی چالاکی میں پھنسا دیتے ہیں،</para>
  <para style="q2" vid="JOB 5:13">اَور بدکار اِنسانوں کے منصُوبے مٹّی میں مِلا دیتے ہیں۔<verse eid="JOB 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 5:14"/>دِن کے وقت اُن پر اَندھیرا چھا جاتا ہے؛</para>
  <para style="q2" vid="JOB 5:14">اَور دوپہر کے وقت بھی وہ اَیسے ٹٹولتے پھرتے ہیں جَیسے رات کو۔<verse eid="JOB 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 5:15"/>حاجتمندوں کو وہ اُن کی مُنہ کی تلوار سے بچاتے ہیں؛</para>
  <para style="q2" vid="JOB 5:15">اَور اُنہیں زبردست کے قبضے سے مخلصی بخشتے ہیں۔<verse eid="JOB 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 5:16"/>چنانچہ مُحتاج اُمّید رکھتے ہیں،</para>
  <para style="q2" vid="JOB 5:16">اَور نااِنصافی اَپنا مُنہ بند کر لیتی ہے۔<verse eid="JOB 5:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 5:17"/>”مُبارک ہے وہ شخص جِس کی تنبیہ خُدا کرتے ہیں؛</para>
  <para style="q2" vid="JOB 5:17">چنانچہ قادرمُطلق کی تادیب کو حقیر نہ جانو۔<verse eid="JOB 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 5:18"/>کیونکہ وُہی زخمی کرتے ہیں لیکن مرہم پٹّی بھی باندھتے ہیں؛</para>
  <para style="q2" vid="JOB 5:18">وُہی مجروح کرتے ہیں لیکن اُن کے ہاتھ شفا بھی بخشتے ہیں۔<verse eid="JOB 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 5:19"/>خُدا تُمہیں چھ آفتوں سے بچائیں گے؛</para>
  <para style="q2" vid="JOB 5:19">اَور اگر سات بھی ہُوں تو بھی تُمہیں چھُونے نہ پائیں گی۔<verse eid="JOB 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 5:20"/>خشک سالی میں وہ تُمہیں موت سے بچائیں گے،</para>
  <para style="q2" vid="JOB 5:20">اَور جنگ میں تُمہیں تلوار کی دھار سے۔<verse eid="JOB 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 5:21"/>تُم زبان کے کوڑے سے محفوظ رکھے جاؤگے،</para>
  <para style="q2" vid="JOB 5:21">اَور جَب تباہی آئے گی تو تُمہیں خوف نہ ہوگا۔<verse eid="JOB 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 5:22"/>تُم بربادی اَور خشک سالی پر ہنسوگے،</para>
  <para style="q2" vid="JOB 5:22">اَور زمین کے جنگلی جانوروں سے خوف نہ کھاؤگے۔<verse eid="JOB 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 5:23"/>میدان کے پتّھروں سے تمہارا عہد ہوگا،</para>
  <para style="q2" vid="JOB 5:23">اَور جنگلی جانور تمہارے ساتھ اَمن سے رہیں گے۔<verse eid="JOB 5:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 5:24"/>تُم جانوگے کہ تمہارا خیمہ محفوظ ہے؛</para>
  <para style="q2" vid="JOB 5:24">تُم اَپنی مِلکیّت کا حِساب لوگے اَور کویٔی شَے غائب نہ پاؤگے۔<verse eid="JOB 5:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 5:25"/>تُمہیں مَعلُوم ہوگا کہ تمہاری اَولاد بہت ہوگی،</para>
  <para style="q2" vid="JOB 5:25">اَور تمہاری نَسل زمین کی گھاس کی طرح بڑھےگی۔<verse eid="JOB 5:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 5:26"/>جَیسے اناج کے پُولے اَپنے وقت پر اِکٹھّے کیٔے جاتے ہیں،</para>
  <para style="q2" vid="JOB 5:26">وَیسے ہی تُم بھی عمر رسیدہ ہوکر قبر تک پہُنچوگے۔<verse eid="JOB 5:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 5:27"/>”ہم نے اِس بات کی تحقیق کی ہے اَور اُسے صحیح پایا ہے۔</para>
  <para style="q2" vid="JOB 5:27">لہٰذا اِسے سُنو اَور اِسے اَپنی زندگی میں عَمل کرو۔“<verse eid="JOB 5:27"/></para>
  <chapter eid="JOB 5"/>
  <chapter number="6" style="c" sid="JOB 6"/>
  <para style="s1">ایُّوب</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 6:1"/>تَب ایُّوب نے جَواب دیا:<verse eid="JOB 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 6:2"/>”کاش کہ میری تکلیف کا اَندازہ لگایا جاتا</para>
  <para style="q2" vid="JOB 6:2">اَور میری ساری مُصیبت ترازو میں تولی جاتی!<verse eid="JOB 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 6:3"/>یقیناً وہ سمُندر کی ریت سے زِیادہ وزنی ہوتی،</para>
  <para style="q2" vid="JOB 6:3">مُجھے میرے جذبات نے بولنے پر مجبُور کر دیا ہے۔<verse eid="JOB 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 6:4"/>قادرمُطلق کے تیر مُجھ میں پیوست ہیں،</para>
  <para style="q2" vid="JOB 6:4">میری رُوح اُن کا زہر پی رہی ہے۔</para>
  <para style="q2" vid="JOB 6:4">خُدا کی دہشت میرے خِلاف صف آرا ہے<verse eid="JOB 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 6:5"/>جَب گورخر کو گھاس مِل جاتی ہے تو کیا اُس کا رینکنا بند نہیں ہو جاتا؟</para>
  <para style="q2" vid="JOB 6:5">یا بَیل کے پاس چارا ہو تو کیا اُس کا ڈکارنا موقُوف نہیں ہو جاتا؟<verse eid="JOB 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 6:6"/>کیا پھیکی چیز بغیر نمک کے کھائی جا سکتی ہے،</para>
  <para style="q2" vid="JOB 6:6">یا اَنڈے کی سفیدی میں کویٔی مزہ ہوتاہے۔<verse eid="JOB 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 6:7"/>میں اُس کھانے کو چھُونا بھی پسند نہ کروں گا،</para>
  <para style="q2" vid="JOB 6:7">اَیسی غِذا سے مُجھے گھِن آتی ہے۔<verse eid="JOB 6:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 6:8"/>”کاش کہ میری اِلتجا سُنی جاتی،</para>
  <para style="q2" vid="JOB 6:8">اَور خُدا میری اُمّید بر لاتا۔<verse eid="JOB 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 6:9"/>کہ خُدا مُجھے کُچل ڈالنے پر راضی ہوتا،</para>
  <para style="q2" vid="JOB 6:9">اَور اَپنا ہاتھ بڑھاتا اَور مُجھے ختم کر دیتا۔<verse eid="JOB 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 6:10"/>تاکہ مُجھے یہ تسلّی تو ہوتی،</para>
  <para style="q2" vid="JOB 6:10">کہ شدید درد کے باوُجُود میں خُوش رہا۔</para>
  <para style="q2" vid="JOB 6:10">اَور مَیں نے قُدُّوس خُدا کی باتوں کو ٹھکرایا نہیں۔<verse eid="JOB 6:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 6:11"/>”مُجھ میں اِس قدر ہمّت کہاں کہ اَب بھی کویٔی اُمّید رکھوں،</para>
  <para style="q2" vid="JOB 6:11">اَور کس توقع پر صبر کرتا رہُوں۔<verse eid="JOB 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 6:12"/>کیا مُجھ میں چٹّان کی سِی قُوّت ہے</para>
  <para style="q2" vid="JOB 6:12">یا میرا جِسم کانسے کا ہے؟<verse eid="JOB 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 6:13"/>اَب جَب کہ میں کامرانی سے محروم کر دیا گیا ہُوں</para>
  <para style="q2" vid="JOB 6:13">تو مُجھ میں اُتنی ہمّت کہاں کہ اَپنی مدد آپ کر سکوں۔<verse eid="JOB 6:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 6:14"/>”مایوس اِنسان چاہتاہے کہ اُس کے دوست مہربان رہیں،</para>
  <para style="q2" vid="JOB 6:14">خواہ اُس کے دِل سے قادرمُطلق کا خوف جاتا رہے۔<verse eid="JOB 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 6:15"/>لیکن میرے بھایٔی برساتی نالوں کی طرح ناقابلِ اِعتبار ہیں،</para>
  <para style="q2" vid="JOB 6:15">بَلکہ اَیسا دریا جو لبریز ہو جاتا ہے۔<verse eid="JOB 6:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 6:16"/>جَب برف پگھلتی ہے تو اُن کا پانی مَیلا ہو جاتا ہے،</para>
  <para style="q2" vid="JOB 6:16">اَور اُن میں طغیانی آجاتی ہے۔<verse eid="JOB 6:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 6:17"/>لیکن وہ خشک موسم میں غائب ہو جاتے ہیں،</para>
  <para style="q2" vid="JOB 6:17">اَور گرمیوں میں سُوکھ جاتے ہیں۔<verse eid="JOB 6:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 6:18"/>قافلے جو اَپنی راہ بدل لیتے ہیں،</para>
  <para style="q2" vid="JOB 6:18">اَور ویرانہ میں جا کر غائب ہو جاتے ہیں۔<verse eid="JOB 6:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 6:19"/>تیماؔ کے شہری کارواں پانی کی تلاش میں ہیں،</para>
  <para style="q2" vid="JOB 6:19">شیبا نامی جگہ کے سوداگر اَپنے سفر کے دَوران اُمّید لگائے بیٹھے ہیں۔<note caller="+" style="f"><char style="fr" closed="false">6‏:19 </char><char style="ft" closed="false">خیال کیا جاتا ہے کہ تیما خلیج عقبہ کے سَر کے جُنوب مشرق میں ایک نخلستان ہے۔ <char style="xt"><ref loc="ISA 21:14">یَشع 21‏:14</ref>؛ <ref loc="JER 25:23">یرم 25‏:23</ref>‏</char> بھی دیکھیں۔</char></note><verse eid="JOB 6:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 6:20"/>اُنہیں پُورا یقین تھا لیکن اُنہیں شرمندہ ہونا پڑا،</para>
  <para style="q2" vid="JOB 6:20">وہ وہاں پہُنچے تو صحیح لیکن مایوسی سے دوچار ہُوئے۔<verse eid="JOB 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 6:21"/>اَب تُم نے بھی ثابت کر دیا کہ تُم کسی کام کے نہیں،</para>
  <para style="q2" vid="JOB 6:21">تُم میری مُصیبت دیکھ کر خوفزدہ ہو گئے ہو۔<verse eid="JOB 6:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 6:22"/>کیا مَیں نے کبھی کہا، ’میری خاطِر کچھ دو؟</para>
  <para style="q2" vid="JOB 6:22">یا اَپنے مال میں سے میرے لیٔے کسی کو رشوت دو۔<verse eid="JOB 6:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 6:23"/>مُجھے دُشمن کے ہاتھ سے بچالو،</para>
  <para style="q2" vid="JOB 6:23">سنگدلوں کے شکنجہ سے مُجھے رِہائی دِلاؤ؟‘<verse eid="JOB 6:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 6:24"/>”مُجھے سمجھاؤ تو میں مان بھی جاؤں گا،</para>
  <para style="q2" vid="JOB 6:24">مُجھے بتاؤ کہ مَیں نے کہاں غلطی کی۔<verse eid="JOB 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 6:25"/>سچّی باتیں بڑی تکلیف دہ ہوتی ہیں!</para>
  <para style="q2" vid="JOB 6:25">لیکن تُم دلیلوں سے کیا ثابت کرنا چاہتے ہو؟<verse eid="JOB 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 6:26"/>کیا یہ کہ میری باتیں غلط ہیں؟</para>
  <para style="q2" vid="JOB 6:26">یا ایک مایوس اِنسان کے الفاظ کی کویٔی حقیقت نہیں؟<verse eid="JOB 6:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 6:27"/>تُم تو یتیم پر قُرعہ ڈالنے سے بھی نہ ہچکچاؤگے</para>
  <para style="q2" vid="JOB 6:27">اَور اگر اَپنے دوست کا سَودا کرنا پڑا تو وہ بھی کر گزروگے۔<verse eid="JOB 6:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 6:28"/>”لیکن اَب براہِ کرم مُجھ پر نگاہ کرو،</para>
  <para style="q2" vid="JOB 6:28">کیا مَیں تمہارے مُنہ پر جھُوٹ بولُوں گا؟<verse eid="JOB 6:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 6:29"/>رحم کرو، اِنصاف سے کام لو،</para>
  <para style="q2" vid="JOB 6:29">ایک بار پھر سوچ لو کیونکہ میری راستبازی کا اِمتحان لیا جا رہاہے۔<verse eid="JOB 6:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 6:30"/>کیا میرے لبوں پر کویٔی مکر کی بات ہے؟</para>
  <para style="q2" vid="JOB 6:30">کیا مُجھے اِتنی بھی سمجھ نہیں کہ بدی کو پہچان سکوں؟<verse eid="JOB 6:30"/></para>
  <para style="b"/>
  <chapter eid="JOB 6"/>
  <chapter number="7" style="c" sid="JOB 7"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 7:1"/>”کیا اِنسان زمین پر محنت و مشقّت نہیں کرتا؟</para>
  <para style="q2" vid="JOB 7:1">اَور کیا اُس کے دِن ایک مزدُور کے سے نہیں ہوتے؟<note caller="+" style="f"><char style="fr" closed="false">7‏:1 </char><char style="ft" closed="false"><char style="xt"><ref loc="JOB 14:5">ایُّو 14‏:5</ref>؛ <ref loc="JOB 13">13</ref>‏؛ <ref loc="JOB 14">14</ref>‏</char></char></note><verse eid="JOB 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 7:2"/>جَیسا کہ ایک غُلام شام ہونے کی راہ دیکھتا ہے،</para>
  <para style="q2" vid="JOB 7:2">اَور مزدُور اَپنی اُجرت کا منتظر رہتاہے،<verse eid="JOB 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 7:3"/>اِسی طرح میرے حِصّہ میں آنے والے مہینے فُضول ہیں،</para>
  <para style="q2" vid="JOB 7:3">اَور میری راتیں میری پریشانی کا باعث ہیں۔<verse eid="JOB 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 7:4"/>جَب مَیں لیٹتا ہُوں تو یہی سوچتا رہتا ہُوں، ’دِن کب نکلے گا؟‘</para>
  <para style="q2" vid="JOB 7:4">رات لمبی ہو جاتی ہے اَور مَیں صُبح تک کروٹیں بدلتا رہتا ہُوں۔<verse eid="JOB 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 7:5"/>میرا جِسم کیچوؤں اَور گارے سے ڈھکا ہے،</para>
  <para style="q2" vid="JOB 7:5">میری جلد پھٹ رہی ہے اَور میرے زخم سڑ رہے ہیں۔<note caller="+" style="f"><char style="fr" closed="false">7‏:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 14:11">یَشع 14‏:11</ref>‏</char></char></note><verse eid="JOB 7:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 7:6"/>”میرے دِن جُلاہے کی ڈھرکی<note caller="+" style="f"><char style="fr" closed="false">7‏:6 </char><char style="fq" closed="false">ڈھرکی </char><char style="ft" closed="false">جُلاہے کا ایک اوزار جِس سے وہ سُوت کو ایک طرف سے دُوسری طرف پھینکتے ہیں۔</char></note> سے بھی زِیادہ تیز رفتار ہیں،</para>
  <para style="q2" vid="JOB 7:6">جِن کی کوئی اُمّید باقی نہیں رہتی۔<verse eid="JOB 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 7:7"/>یا خُدا! یاد کریں کہ میری زندگی ہَوا کی مانند ہے؛</para>
  <para style="q2" vid="JOB 7:7">میری آنکھیں پھر کبھی خُوشی نہ دیکھیں گی۔<verse eid="JOB 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 7:8"/>وہ آنکھ جو مُجھے اَب دیکھ رہی ہے پھر کبھی نہ دیکھے گی؛</para>
  <para style="q2" vid="JOB 7:8">آپ کی آنکھیں میری جُستُجو میں ہوں گی لیکن مَیں نہ ہوں گا۔<verse eid="JOB 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 7:9"/>جِس طرح ایک بادل دفعتاً غائب ہو جاتا ہے اَور پھر نظر نہیں آتا،</para>
  <para style="q2" vid="JOB 7:9">اُسی طرح جو قبر میں اُتر جاتا ہے پھر کبھی نہیں لَوٹتا۔<verse eid="JOB 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 7:10"/>وہ اَپنے گھر پھر کبھی نہ لَوٹے گا؛</para>
  <para style="q2" vid="JOB 7:10">اُس کی جگہ اُسے پھر نہ پہچانے گی۔<verse eid="JOB 7:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 7:11"/>”چنانچہ مَیں خاموش نہ رہُوں گا؛</para>
  <para style="q2" vid="JOB 7:11">شدید رُوحانی تلخی کی حالت میں بولُوں گا،</para>
  <para style="q2" vid="JOB 7:11">جان کنی کے وقت شکایت کروں گا۔<verse eid="JOB 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 7:12"/>کیا میں سمُندر ہُوں یا کویٔی خوفناک بحری اَژدہا ہُوں،</para>
  <para style="q2" vid="JOB 7:12">کہ تُم نے مُجھ پر پہرا لگا دیا ہے؟<verse eid="JOB 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 7:13"/>جَب مَیں سوچتا ہُوں کہ میرا بِستر مُجھے آرام پہُنچائے گا</para>
  <para style="q2" vid="JOB 7:13">اَور میرا پلنگ میری تکلیف کم کر دے گا،<verse eid="JOB 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 7:14"/>تَب بھی آپ خوابوں سے مُجھے ڈراتے ہیں</para>
  <para style="q2" vid="JOB 7:14">اَور رُویتوں سے مُجھے دہشت دِلاتے ہیں،<verse eid="JOB 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 7:15"/>تاکہ میں پھانسی لے کر مَر جاؤں،</para>
  <para style="q2" vid="JOB 7:15">اَور میرا وُجُود باقی نہ رہے۔<verse eid="JOB 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 7:16"/>مُجھے اَپنی زندگی سے نفرت ہے، میں ہمیشہ زندہ نہیں رہُوں گا۔</para>
  <para style="q2" vid="JOB 7:16">مُجھے میرے حال پر چھوڑ دو کیونکہ میری زندگی کا اَب کویٔی مقصد نہیں۔<verse eid="JOB 7:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 7:17"/>”آخِر اِنسان کی بساط ہی کیا ہے کہ آپ اُسے سرفراز کریں،</para>
  <para style="q2" vid="JOB 7:17">اَور اُس کا خیال دِل میں لائیں،<verse eid="JOB 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 7:18"/>اَور ہر صُبح اُس کی خبر لیں</para>
  <para style="q2" vid="JOB 7:18">اَور ہر لمحہ اُسے آزماتے رہیں؟<verse eid="JOB 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 7:19"/>کیا آپ کبھی بھی اَپنی نگاہ میری طرف سے نہیں پھیریں گے،</para>
  <para style="q2" vid="JOB 7:19">اَور مُجھے پل بھرکے لیٔے بھی اکیلا نہیں چھوڑیں گے؟<verse eid="JOB 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 7:20"/>اَے بنی آدمؔ کے نگہبان!</para>
  <para style="q2" vid="JOB 7:20">اگر مَیں نے گُناہ کیا تو مَیں نے آپ کا کیا بگاڑا ہے؟</para>
  <para style="q1" vid="JOB 7:20">آپ نے مُجھے اَپنا نِشانہ کیوں بنایا؟</para>
  <para style="q2" vid="JOB 7:20">کیا مَیں آپ پر بوجھ بَن گیا ہُوں؟<verse eid="JOB 7:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 7:21"/>آپ میری خطائیں مُعاف کیوں نہیں کرتے</para>
  <para style="q2" vid="JOB 7:21">اَور میرے گُناہ کیوں نہیں بخشتے،</para>
  <para style="q1" vid="JOB 7:21">میں تو بہت جلد خاک میں مِل جاؤں گا؛</para>
  <para style="q2" vid="JOB 7:21">آپ مُجھے ڈھونڈیں گے پر میں نہ ملوں گا۔“<note caller="+" style="f"><char style="fr" closed="false">7‏:21 </char><char style="fq" closed="false">میں نہ ملوں گا۔ </char><char style="ft" closed="false">میں مَر جاؤں گا اَور دفن ہو جاؤں گا۔</char></note><verse eid="JOB 7:21"/></para>
  <chapter eid="JOB 7"/>
  <chapter number="8" style="c" sid="JOB 8"/>
  <para style="s1">بِلددؔ کا پہلا جَواب</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 8:1"/>تَب شوحی مُلک کا بِلددؔ کہنے لگا:<verse eid="JOB 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 8:2"/>”تُم کب تک بولتے رہوگے؟</para>
  <para style="q2" vid="JOB 8:2">تمہاری باتیں ایک تُند آندھی کی مانند ہیں۔<verse eid="JOB 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 8:3"/>کیا خُدا اِنصاف سے کام نہیں لیتا؟</para>
  <para style="q2" vid="JOB 8:3">کیا قادرمُطلق اِنصاف کا خُون کرتا ہے؟<verse eid="JOB 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 8:4"/>جَب تمہارے فرزندوں نے خُدا کے خِلاف گُناہ کیا،</para>
  <para style="q2" vid="JOB 8:4">خُدا نے اُنہیں اُن کے گُناہ کی سزا دی۔<verse eid="JOB 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 8:5"/>لیکن اگر تُم خُدا سے رُجُوع کروگے</para>
  <para style="q2" vid="JOB 8:5">اَور قادرمُطلق سے اِلتجا کروگے،<verse eid="JOB 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 8:6"/>اگر تُم پاک دِل اَور راستباز ہو،</para>
  <para style="q2" vid="JOB 8:6">تو خُدا اَب بھی تمہاری طرف مُتوجّہ ہوں گے</para>
  <para style="q2" vid="JOB 8:6">اَور تُمہیں اَپنے صحیح مقام پر بحال کریں گے۔<verse eid="JOB 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 8:7"/>تمہاری گذشتہ شان و شوکت کے مُقابلہ میں،</para>
  <para style="q2" vid="JOB 8:7">تمہارا مُستقبِل زِیادہ رَوشن ہوگا۔<verse eid="JOB 8:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 8:8"/>”پچھلے زمانہ کے لوگوں سے دریافت کرو</para>
  <para style="q2" vid="JOB 8:8">اَور پتہ لگاؤ کہ اُن کے آباؤاَجداد کی معلومات کیا تھیں،<verse eid="JOB 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 8:9"/>کیونکہ ہم تو کل ہی پیدا ہُوئے ہیں اَور کچھ بھی نہیں جانتے،</para>
  <para style="q2" vid="JOB 8:9">اَور ہمارے دِن زمین پر سایہ کی طرح ہیں۔<verse eid="JOB 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 8:10"/>کیا وہ آباؤاَجداد تُمہیں نہ بتائیں گے اَور نہ سکھائیں گے؟</para>
  <para style="q2" vid="JOB 8:10">کیا وہ اَپنی عقل کے دہانے نہ کھولیں گے؟<verse eid="JOB 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 8:11"/>جہاں دلدل نہیں کیا وہاں نرسل کا پَودا اُگ سَکتا ہے؟</para>
  <para style="q2" vid="JOB 8:11">کیا سَرکنڈا بغیر پانی کے بڑھ سَکتا ہے؟<verse eid="JOB 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 8:12"/>وہ ابھی ہرے ہی ہوتے ہیں اَور کاٹے جانے کے لائق بھی نہیں ہوتے،</para>
  <para style="q2" vid="JOB 8:12">کہ گھاس سے بھی پہلے سُوکھ جاتے ہیں۔<verse eid="JOB 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 8:13"/>خُدا کو بھُول جانے والوں کا یہی اَنجام ہوتاہے؛</para>
  <para style="q2" vid="JOB 8:13">اَور اِسی طرح بےدینوں کی اُمّید ٹوٹ جاتی ہے۔<verse eid="JOB 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 8:14"/>اَیسے آدمی کا اِعتماد کمزور ہو جاتا ہے؛</para>
  <para style="q2" vid="JOB 8:14">اَور اُس کا بھروسا مکڑی کا جالا ہے۔<verse eid="JOB 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 8:15"/>وہ اَپنے جالے کا سہارا لیتا ہے لیکن وہ ٹوٹ جاتا ہے؛</para>
  <para style="q2" vid="JOB 8:15">اَور اِتنا مضبُوط نہیں ہوتا کہ اُسے تھامے رہے۔<verse eid="JOB 8:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 8:16"/>وہ ایک پَودے کی مانند ہے جو دھوپ میں بھی سیراب رہتاہے،</para>
  <para style="q2" vid="JOB 8:16">جو اَپنی ڈالیاں باغ میں پھیلاتا ہے؛<verse eid="JOB 8:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 8:17"/>اُس کی جڑیں چٹّانوں کے انبار کو جکڑ لیتی ہیں</para>
  <para style="q2" vid="JOB 8:17">اَور پتّھروں میں جگہ ڈھونڈ کر پھیل جاتی ہیں۔<verse eid="JOB 8:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 8:18"/>لیکن جَب وہ اَپنی جگہ سے اُکھاڑ دیا جاتا ہے،</para>
  <para style="q2" vid="JOB 8:18">تَب وہ جگہ بھی اُس سے دست بردار ہو جاتی ہے</para>
  <para style="q2" vid="JOB 8:18">اَور کہتی ہے، ’مَیں نے تُمہیں کبھی نہیں دیکھا۔‘<verse eid="JOB 8:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 8:19"/>یقیناً اُس کی زندگی ختم ہو جاتی ہے،</para>
  <para style="q2" vid="JOB 8:19">اَور زمین سے دُوسرے پَودے اُگ پڑتے ہیں۔<verse eid="JOB 8:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 8:20"/>”خُدا کسی بے قُصُور اِنسان کو ہرگز نہیں ٹھکراتے</para>
  <para style="q2" vid="JOB 8:20">نہ بدکار اِنسان کے ہاتھ مضبُوط کرتے ہیں۔<verse eid="JOB 8:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 8:21"/>وہ اَب بھی تمہارا مُنہ ہنسی سے بھر دیں گے</para>
  <para style="q2" vid="JOB 8:21">اَور تمہارے لبوں پر خُوشی کے نعرے ہوں گے۔<verse eid="JOB 8:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 8:22"/>تمہارے دُشمن ندامت سے مُلبّس ہوں گے،</para>
  <para style="q2" vid="JOB 8:22">اَور بدکاروں کے خیمے اُکھاڑ دئیے جایٔیں گے۔“<verse eid="JOB 8:22"/></para>
  <chapter eid="JOB 8"/>
  <chapter number="9" style="c" sid="JOB 9"/>
  <para style="s1">ایُّوب</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 9:1"/>تَب ایُّوب نے جَواب دیا:<verse eid="JOB 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 9:2"/>”میں خُوب جانتا ہُوں کہ یہ سچ ہے۔</para>
  <para style="q2" vid="JOB 9:2">لیکن ایک فانی اِنسان خُدا کے حُضُور کیسے راستباز ٹھہر سَکتا ہے؟<verse eid="JOB 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 9:3"/>اگر وہ اُس سے بحث کرنا بھی چاہے،</para>
  <para style="q2" vid="JOB 9:3">تو اُن کی ہزار باتوں میں سے ایک کا بھی جَواب نہ دے سکےگا۔<verse eid="JOB 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 9:4"/>اُن کی حِکمت لا محدُود اَور طاقت بے اَندازہ ہے۔</para>
  <para style="q2" vid="JOB 9:4">کون اُن کے مُقابلہ میں کھڑا ہُوا اَور صحیح و سالِم بچ نِکلا؟<verse eid="JOB 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 9:5"/>وہ پہاڑوں کو ہٹا دیتے ہیں اَور اُنہیں خبر بھی نہیں ہو پاتی،</para>
  <para style="q2" vid="JOB 9:5">وہ اَپنے قہر میں اُنہیں تہہ و بالا کر دیتے ہیں۔<verse eid="JOB 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 9:6"/>اَور زمین کو اُس کی جگہ سے ہلا دیتے ہیں،</para>
  <para style="q2" vid="JOB 9:6">اَور اُس کے سُتون ڈگمگا جاتے ہیں۔<verse eid="JOB 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 9:7"/>وہ آفتاب کو حُکم دیتے ہیں تو وہ طُلوع نہیں ہوتا؛</para>
  <para style="q2" vid="JOB 9:7">وہ سِتاروں پر مُہر لگا دیتے ہیں۔<verse eid="JOB 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 9:8"/>وہ افلاک کو تنہا ہی تانتے ہیں</para>
  <para style="q2" vid="JOB 9:8">اَور سمُندر کی لہروں پر چلتے ہیں۔<verse eid="JOB 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 9:9"/>اُن ہی نے ثریّا اَور جبّار،</para>
  <para style="q2" vid="JOB 9:9">اَور جُنوب کے کواکب کو بنایا۔<verse eid="JOB 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 9:10"/>وہ بڑے حیرت اَنگیز کام کرتے ہیں جو عقل و فہم سے باہر ہیں،</para>
  <para style="q2" vid="JOB 9:10">اَور اَیسے معجزے جو لاتعداد ہیں۔<verse eid="JOB 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 9:11"/>جَب وہ میرے پاس سے گزرتے ہیں، میں اُنہیں دیکھ نہیں پاتا؛</para>
  <para style="q2" vid="JOB 9:11">جَب وہ گزر جاتے ہیں تو مُجھے پتہ بھی نہیں چلتا۔<verse eid="JOB 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 9:12"/>اگر وہ کچھ چھیننا چاہیں تو اُنہیں کون روک سَکتا ہے؟</para>
  <para style="q2" vid="JOB 9:12">اُن سے کون کہے، ’تُم کیا کر رہے ہو؟‘<verse eid="JOB 9:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 9:13"/>خُدا اَپنا غُصّہ نہیں روکتے؛</para>
  <para style="q2" vid="JOB 9:13">یہاں تک کہ راحبؔ<note caller="+" style="f"><char style="fr" closed="false">9‏:13 </char><char style="fq" closed="false">راحبؔ </char><char style="ft" closed="false">قدیم خوفناک بحری اَژدہا</char></note> کی ٹولیاں اُن کے قدموں میں جھُک جاتی ہیں۔<verse eid="JOB 9:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 9:14"/>”پھر میں اُن سے بحث کیسے کروں؟</para>
  <para style="q2" vid="JOB 9:14">اَپنی دلائل کے لیٔے الفاظ کہاں سے لاؤں؟<verse eid="JOB 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 9:15"/>میں بے قُصُور بھی ہوتا تو اُنہیں جَواب نہ دیتا؛</para>
  <para style="q2" vid="JOB 9:15">میں اَپنے مُنصِف سے صِرف رحم کی بھیک مانگتا۔<verse eid="JOB 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 9:16"/>اگر مَیں اُنہیں پُکارتا اَور وہ آ جاتے،</para>
  <para style="q2" vid="JOB 9:16">تو بھی میں یقین نہ کرتا، کہ وہ میری سُنیں گے۔<verse eid="JOB 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 9:17"/>وہ مُجھے طُوفان سے ریزہ ریزہ کر ڈالتے،</para>
  <para style="q2" vid="JOB 9:17">اَور بلاوجہ میرے زخموں کو بڑھا دیتے۔<verse eid="JOB 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 9:18"/>وہ مُجھے دَم بھی نہ لینے دیں گے،</para>
  <para style="q2" vid="JOB 9:18">بَلکہ میرے اُوپر مُصیبتوں کا پہاڑ کھڑا کر دیتے۔<verse eid="JOB 9:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 9:19"/>اگر طاقت کی بات ہو، تو وہ قادر ہیں!</para>
  <para style="q2" vid="JOB 9:19">اَور اگر اِنصاف کا مُعاملہ ہو تو میری باری کب آئے گی؟<verse eid="JOB 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 9:20"/>اگر مَیں بے قُصُور بھی ہوتا، تو میرا ہی مُنہ مُجھے مُلزم ٹھہراتا؛</para>
  <para style="q2" vid="JOB 9:20">اگر مَیں بےگُناہ ہوتا، تو وہ مُجھے گُنہگار قرار دیتا۔<verse eid="JOB 9:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 9:21"/>”حالانکہ میں بے قُصُور ہُوں،</para>
  <para style="q2" vid="JOB 9:21">مُجھے اَپنی زندگی کی پروا نہیں؛</para>
  <para style="q2" vid="JOB 9:21">میں اُسے حقیر سمجھتا ہُوں۔<verse eid="JOB 9:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 9:22"/>بات ایک ہی ہے، اِسی لیٔے میں کہتا ہُوں،</para>
  <para style="q2" vid="JOB 9:22">کہ خُدا بےگُناہ اَور بدکار اِنسان دونوں کو ہلاک کرتے ہیں۔<verse eid="JOB 9:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 9:23"/>جَب کویٔی آفت موت لے کر آتی ہے،</para>
  <para style="q2" vid="JOB 9:23">’تو وہ بے قُصُور کی بے بَسی کا مذاق اُڑاتی ہے۔‘<verse eid="JOB 9:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 9:24"/>جَب زمین پر بدکار لوگ قبضہ کرلیتے ہیں،</para>
  <para style="q2" vid="JOB 9:24">تو وہ اِنصاف کرنے والوں کی آنکھوں پر پٹّی باندھ دیتے ہیں۔</para>
  <para style="q2" vid="JOB 9:24">اگر یہ وُہی نہیں تو پھر کون ہے؟<verse eid="JOB 9:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 9:25"/>”میری زندگی کے دِن ہرکارے سے بھی زِیادہ تیزرَو ہیں؛</para>
  <para style="q2" vid="JOB 9:25">وہ میری خُوشی نہیں دیکھتے، بس پھُر سے اُڑ جاتے ہیں۔<verse eid="JOB 9:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 9:26"/>وہ اَیسے گزر جاتے ہیں، جَیسے نرسل کی کشتیاں،</para>
  <para style="q2" vid="JOB 9:26">جَیسے عُقاب جو اَپنے شِکار پر جھپٹ پڑتے ہیں۔<verse eid="JOB 9:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 9:27"/>اگر مَیں کہُوں، ’میں اَپنی شکایت بھُلادوں گا،</para>
  <para style="q2" vid="JOB 9:27">میں اَپنے چہرہ کی اُداسی کو مُسکراہٹ میں بدل دُوں گا،‘<verse eid="JOB 9:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 9:28"/>پھر بھی میں اَپنے سارے دُکھوں سے ڈرتا ہُوں،</para>
  <para style="q2" vid="JOB 9:28">کیونکہ مَیں جانتا ہُوں کہ آپ مُجھے بے قُصُور نہ ٹھہرائیں گے۔<verse eid="JOB 9:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 9:29"/>چونکہ میں تو پہلے ہی گُنہگار ٹھہرایا جاچُکا ہُوں،</para>
  <para style="q2" vid="JOB 9:29">بَری ہونے کے لیٔے عبث زحمت کیوں اُٹھاؤں؟<verse eid="JOB 9:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 9:30"/>اگر مَیں اَپنے آپ کو عرق سے دھو لُوں،</para>
  <para style="q2" vid="JOB 9:30">اَور اَپنے ہاتھ خُوب صَاف کرلُوں،<verse eid="JOB 9:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 9:31"/>تَب بھی آپ مُجھے کیچڑ میں دھکیل دیں گے،</para>
  <para style="q2" vid="JOB 9:31">یہاں تک کہ میرے کپڑے بھی مُجھ سے دُور بھاگیں گے۔<verse eid="JOB 9:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 9:32"/>”وہ میری طرح اِنسان نہیں کہ میں اُنہیں جَواب دُوں،</para>
  <para style="q2" vid="JOB 9:32">اَور عدالت میں ہم ایک دُوسرے کے مقابل کھڑے ہُوں۔<verse eid="JOB 9:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 9:33"/>کاش میرے اَور خُدا کے درمیان کویٔی ثالث ہوتا،</para>
  <para style="q2" vid="JOB 9:33">جو ہم دونوں پر اَپنا ہاتھ رکھتا،<verse eid="JOB 9:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 9:34"/>خُدا کی لاٹھی مُجھ پر سے ہٹا دیتا،</para>
  <para style="q2" vid="JOB 9:34">اَور اُس کے غضب سے مُجھے خوفزدہ نہ ہونے دیتا۔<verse eid="JOB 9:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JOB 9:35"/>تَب میں بولتا اَور اُس سے نہ ڈرتا،</para>
  <para style="q2" vid="JOB 9:35">لیکن فی الحال میں بذاتِ خُود کچھ نہیں کر سَکتا۔<verse eid="JOB 9:35"/></para>
  <para style="b"/>
  <chapter eid="JOB 9"/>
  <chapter number="10" style="c" sid="JOB 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 10:1"/>”میں اَپنی زندگی سے بیزار ہو چُکا ہُوں؛</para>
  <para style="q2" vid="JOB 10:1">لہٰذا میں دِل کھول کر شکوہ کروں گا۔</para>
  <para style="q2" vid="JOB 10:1">اَور تلخ رُوح کی بھڑاس نکال دُوں گا۔<verse eid="JOB 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 10:2"/>میں خُدا سے کہُوں گا کہ مُجھے قُصُوروار نہ ٹھہرا،</para>
  <para style="q2" vid="JOB 10:2">بَلکہ مُجھے بتا، کہ میرے خِلاف اِلزامات کیا ہیں۔<verse eid="JOB 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 10:3"/>کیا مُجھ پر ظُلم کرنے سے تُمہیں خُوشی ہوتی ہے،</para>
  <para style="q2" vid="JOB 10:3">اَور اَپنے ہاتھوں کی صنعت کی حقارت کرنا اَچھّا لگتا ہے،</para>
  <para style="q2" vid="JOB 10:3">تُو بدکار اِنسانوں کے منصُوبوں پر مُسکراتا ہے؟<verse eid="JOB 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 10:4"/>کیا تیری آنکھیں گوشت کی بنی ہُوئی ہیں؟</para>
  <para style="q2" vid="JOB 10:4">کیا تُو بشر کی مانند دیکھتا ہے؟<verse eid="JOB 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 10:5"/>کیا تیرے زندگی کے دِن فانی اِنسان کے دِنوں کی طرح ہیں،</para>
  <para style="q2" vid="JOB 10:5">اَور تیرے سال آدمی کے سالوں کی طرح،<verse eid="JOB 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 10:6"/>کیا تُو میری بُرائیاں ڈھونڈے،</para>
  <para style="q2" vid="JOB 10:6">اَور میری خطاؤں کی تفتیش کرے؟<verse eid="JOB 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 10:7"/>آپ کو علم ہے کہ میں مُجرم نہیں ہُوں،</para>
  <para style="q2" vid="JOB 10:7">اَور کویٔی شخص مُجھے آپ کے ہاتھ سے نہیں بچا سَکتا۔<verse eid="JOB 10:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 10:8"/>”تیرے ہی ہاتھوں نے مُجھے اِس شکل میں ڈھالا اَور بنایا،</para>
  <para style="q2" vid="JOB 10:8">کیا تُم اَب مُجھے بدل کر برباد کر دے گا؟<verse eid="JOB 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 10:9"/>یاد کر کہ تُونے مُجھے چکنی مٹّی کی طرح گوندھا۔</para>
  <para style="q2" vid="JOB 10:9">تو کیا اَب تُو مُجھے پھر خاک میں مِلائے گا؟<verse eid="JOB 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 10:10"/>کیا تُم نے مُجھے دُودھ کی طرح نہیں اُنڈیلا</para>
  <para style="q2" vid="JOB 10:10">اَور پنیر کی طرح نہیں جمایا؟<verse eid="JOB 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 10:11"/>پھر گوشت اَور پوست سے ملبوس کرکے</para>
  <para style="q2" vid="JOB 10:11">مُجھے ہڈّیوں اَور رگوں سے جوڑ نہیں دیا؟<verse eid="JOB 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 10:12"/>تُونے مُجھے زندگی دی اَور مُجھ پر رحم کیا،</para>
  <para style="q2" vid="JOB 10:12">اَور اَپنے فضل سے میری رُوح کی حِفاظت کی۔<verse eid="JOB 10:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 10:13"/>”لیکن یہ بات تُم نے اَپنے دِل میں چُھپائے رکھی،</para>
  <para style="q2" vid="JOB 10:13">اَور مَیں جانتا ہُوں کہ یہی تیرا منشا تھا کہ<verse eid="JOB 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 10:14"/>اگر مَیں گُناہ کروں تو تُو دیکھ لے گا</para>
  <para style="q2" vid="JOB 10:14">اَور مُجھے میری بدکاری کی سزا ضروُر دے گا۔<verse eid="JOB 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 10:15"/>اگر مَیں گُنہگار ہُوں، تو مُجھ پر افسوس!</para>
  <para style="q2" vid="JOB 10:15">میں تو بے قُصُور ہوتے ہُوئے بھی اَپنا سَر نہیں اُٹھا سَکتا،</para>
  <para style="q1" vid="JOB 10:15">کیونکہ مَیں شرم سے لبریز ہُوں،</para>
  <para style="q2" vid="JOB 10:15">اَور تکلیف میں ڈوبا ہُوا ہُوں۔<verse eid="JOB 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 10:16"/>اگر مَیں اَپنا سَر اُٹھاؤں، تو تُو مُجھے شیر کی طرح دبوچ لے گا،</para>
  <para style="q2" vid="JOB 10:16">اَور اَپنی دہشت اَنگیز قدر ت کا مظاہرہ کرےگا۔<verse eid="JOB 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 10:17"/>تُو میرے خِلاف نئے نئے گواہ لے آتا ہے</para>
  <para style="q2" vid="JOB 10:17">اَور اَپنا قہر مُجھ پر بڑھاتاہے؛</para>
  <para style="q2" vid="JOB 10:17">تیرے لشکر موجوں کی طرح مُجھ پر چڑھے آتے ہیں۔<verse eid="JOB 10:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 10:18"/>”پھر تُونے مُجھے میری ماں کے رحم سے نکالا ہی کیوں؟</para>
  <para style="q2" vid="JOB 10:18">اِس سے قبل کہ کویٔی آنکھ مُجھے دیکھتی کہ کاش میں مَر گیا ہوتا۔<verse eid="JOB 10:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 10:19"/>کاش کہ میں پیدا ہی نہ ہُوا ہوتا،</para>
  <para style="q2" vid="JOB 10:19">یا رحم سے سیدھا قبر میں پہُنچا دیا جاتا!<verse eid="JOB 10:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 10:20"/>کیا میری زندگی چند روزہ نہیں؟</para>
  <para style="q2" vid="JOB 10:20">مُجھے چھوڑ دے تاکہ میں چند لمحے خُوشی میں گزار سکوں۔<verse eid="JOB 10:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 10:21"/>اِس سے قبل کہ میں چلا جاؤں، جہاں سے کویٔی واپس نہیں آتا،<note caller="+" style="f"><char style="fr" closed="false">10‏:21 </char><char style="ft" closed="false">اُداسی اَور افراتفری کی سرزمین یہاں پاتال کی تفصیل کو بڑھاتی ہے۔</char></note></para>
  <para style="q2" vid="JOB 10:21">ظلمت اَور موت کے سایہ کی جگہ،<verse eid="JOB 10:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 10:22"/>وہ مقام جہاں راتیں بڑی تاریک،</para>
  <para style="q2" vid="JOB 10:22">سائے بڑے گہرے اَور ہر چیز بے ترتیب ہوتی ہے،</para>
  <para style="q2" vid="JOB 10:22">جہاں رَوشنی بھی تاریکی کی مانند ہے۔“<verse eid="JOB 10:22"/></para>
  <chapter eid="JOB 10"/>
  <chapter number="11" style="c" sid="JOB 11"/>
  <para style="s1">صُوفرؔ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 11:1"/>تَب نَعماتی باشِندہ صُوفرؔ نے جَواب دیا:<verse eid="JOB 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 11:2"/>”کیا اِن سَب باتوں کا جَواب نہ دیا جائے؟</para>
  <para style="q2" vid="JOB 11:2">اَور یہ بکواسی شخص چھوڑ دیا جائے؟<verse eid="JOB 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 11:3"/>کیا تمہاری بےہوُدہ باتیں سُن کر لوگ چُپ رہیں؟</para>
  <para style="q2" vid="JOB 11:3">تمہاری مذاق اُڑائے اَور کویٔی تُمہیں نہ ڈانٹے؟<verse eid="JOB 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 11:4"/>تُم خُدا سے کہتے ہو، ’میرے عقیدے بے عیب ہیں</para>
  <para style="q2" vid="JOB 11:4">اَور مَیں تمہاری نگاہ میں پاک ہُوں،‘<verse eid="JOB 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 11:5"/>کیا ہی اَچھّا ہو کہ خُدا بولیں،</para>
  <para style="q2" vid="JOB 11:5">اَور اَپنے لب تمہارے خِلاف کھولیں<verse eid="JOB 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 11:6"/>اَور تُم پر حِکمت کے راز فاش کر دیں،</para>
  <para style="q2" vid="JOB 11:6">کیونکہ اُس کے کیٔی پہلو ہوتے ہیں،</para>
  <para style="q2" vid="JOB 11:6">لیکن یہ جان لو، کہ خُدا نے تمہاری بعض خطاؤں پر پردہ ڈالا ہے۔<verse eid="JOB 11:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 11:7"/>”کیا تُم جُستُجو کرکے خُدا کے اسرار جان سکتے ہو؟</para>
  <para style="q2" vid="JOB 11:7">کیا تُم قادرمُطلق کی وسعتوں کو دریافت کر سکتے ہو؟<verse eid="JOB 11:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 11:8"/>وہ تو آسمان سے بھی زِیادہ اُونچی ہیں، تُم کیا کر سکتے ہو؟</para>
  <para style="q2" vid="JOB 11:8">وہ تو پاتال سے بھی زِیادہ گہری ہیں، تُم کیا جان سکتے ہو؟<verse eid="JOB 11:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 11:9"/>اُس کی ناپ زمین سے زِیادہ لمبی</para>
  <para style="q2" vid="JOB 11:9">اَور عرض سمُندر سے بھی زِیادہ چوڑا ہے۔<verse eid="JOB 11:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 11:10"/>”اگر خُدا آکر تُمہیں قَیدخانہ میں ڈال دیں</para>
  <para style="q2" vid="JOB 11:10">اَور تمہاری عدالت کریں، تو اُن کون روک سَکتا ہے؟<verse eid="JOB 11:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 11:11"/>وہ دھوکےبازوں کو خُوب پہچانتے ہیں؛</para>
  <para style="q2" vid="JOB 11:11">جَب وہ بدکاری دیکھتے ہیں تو کیا اُسے نہیں پہچانتے۔<verse eid="JOB 11:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 11:12"/>جِس طرح گورخر کا بچّہ اِنسان بَن کر پیدا نہیں ہو سَکتا</para>
  <para style="q2" vid="JOB 11:12">اُسی طرح بےوقُوف اِنسان بھی عقلمند نہیں بَن سَکتا۔<verse eid="JOB 11:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 11:13"/>”پھر بھی اگر تُم دِل سے اُن کی طرف راغِب ہو،</para>
  <para style="q2" vid="JOB 11:13">اَور اَپنے ہاتھ خُدا کی طرف بڑھاؤ،<verse eid="JOB 11:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 11:14"/>اگر تُم اَپنے گُناہ آلُودہ ہاتھ دھولو</para>
  <para style="q2" vid="JOB 11:14">اَور اَپنے خیمہ میں بدکاری کو پنپنے نہ دو،<verse eid="JOB 11:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 11:15"/>تَب تُم اَپنا مُنہ ندامت کے بغیر اُونچا کروگے؛</para>
  <para style="q2" vid="JOB 11:15">تُم ثابت قدم رہوگے اَور خوفزدہ نہ ہوگے۔<verse eid="JOB 11:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 11:16"/>تُم یقیناً اَپنی پریشانی بھُول جاؤگے،</para>
  <para style="q2" vid="JOB 11:16">محض اُس کی یاد بہہ جانے والے پانی کی طرح باقی رہ جائے گی۔<verse eid="JOB 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 11:17"/>زندگی دوپہر سے بھی زِیادہ رَوشن ہوگی،</para>
  <para style="q2" vid="JOB 11:17">اَور تاریکی صُبح کی مانند ہو جائیگی۔<verse eid="JOB 11:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 11:18"/>تُم اِطمینان پاؤگے کیونکہ اَیسی ہی اُمّید ہے؛</para>
  <para style="q2" vid="JOB 11:18">تُم اَپنے چاروں طرف نظر دَوڑاؤگے اَور مطمئن ہوکر آرام کروگے۔<verse eid="JOB 11:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 11:19"/>تُم لیٹ جاؤگے اَور کویٔی تُمہیں ڈرانے کا نہیں،</para>
  <para style="q2" vid="JOB 11:19">اَور کیٔی لوگ تمہاری مہربانی کے طلب گار ہوں گے۔<verse eid="JOB 11:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 11:20"/>لیکن بدکاروں کی آنکھیں دھُندلا جایٔیں گی،</para>
  <para style="q2" vid="JOB 11:20">اَور وہ بچ کر نکل نہ سکیں گے؛</para>
  <para style="q2" vid="JOB 11:20">اُن کی اُمّید موت کی ہچکی میں بدل جائے گی۔“<verse eid="JOB 11:20"/></para>
  <chapter eid="JOB 11"/>
  <chapter number="12" style="c" sid="JOB 12"/>
  <para style="s1">ایُّوب</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 12:1"/>تَب ایُّوب نے جَواب دیا:<verse eid="JOB 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 12:2"/>”بے شک تُم ہی وہ لوگ ہو،</para>
  <para style="q2" vid="JOB 12:2">جو حِکمت کو ساتھ لے کر مروگے!<verse eid="JOB 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 12:3"/>میں بھی تمہاری طرح سمجھ رکھتا ہُوں؛</para>
  <para style="q2" vid="JOB 12:3">میں تُم سے کسی طرح کم نہیں۔“</para>
  <para style="q2" vid="JOB 12:3">بھلا یہ سَب باتیں کون نہیں جانتا؟<verse eid="JOB 12:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 12:4"/>”میں اَپنے دوستوں کے لیٔے مذاق بَن چُکا ہُوں،</para>
  <para style="q2" vid="JOB 12:4">حالانکہ خُدا میری فریاد سُن کر جَواب دیتے رہے؛</para>
  <para style="q2" vid="JOB 12:4">لیکن مَیں راستباز اَور بےگُناہ ہوتے ہُوئے بھی لوگوں کی ہنسی کا باعث بنا رہا!“<verse eid="JOB 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 12:5"/>آسُودہ لوگ بدنصیبی کو حقارت کی نگاہ سے دیکھتے ہیں۔</para>
  <para style="q2" vid="JOB 12:5">وہ اُن کی قِسمت میں لکھی ہُوئی ہے جِن کے قدم پھسلتے رہتے ہیں۔<verse eid="JOB 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 12:6"/>ڈاکوؤں کے خیموں کو کویٔی نہیں چھیڑتا،</para>
  <para style="q2" vid="JOB 12:6">اَورجو لوگ خُدا کو غُصّہ دِلاتے ہیں وہ محفوظ رہتے ہیں،</para>
  <para style="q2" vid="JOB 12:6">اُن کا معبُود گویا اُن کے ہاتھ میں ہے!<verse eid="JOB 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 12:7"/>”جانوروں سے پُوچھو اَور وہ تُمہیں سکھائیں گے،</para>
  <para style="q2" vid="JOB 12:7">یا ہَوا کے پرندوں سے مَعلُوم کرو اَور وہ تُمہیں بتائیں گے؛<verse eid="JOB 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 12:8"/>یا زمین سے پُوچھو تو وہ تُمہیں سِکھائے گی،</para>
  <para style="q2" vid="JOB 12:8">سمُندر کی مچھلیاں تُمہیں بتائیں گی۔<verse eid="JOB 12:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 12:9"/>اِن سَب میں سے کون ہے جو نہیں جانتا،</para>
  <para style="q2" vid="JOB 12:9">کہ یہ سَب یَاہوِہ کے ہاتھ کے کام ہیں؟<verse eid="JOB 12:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 12:10"/>ہر مخلُوق کی زندگی</para>
  <para style="q2" vid="JOB 12:10">اَور تمام بنی آدمؔ کا دَم اُن کے ہاتھ میں ہے؟<verse eid="JOB 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 12:11"/>کیا کان باتوں کو نہیں پرکھ لیتا،</para>
  <para style="q2" vid="JOB 12:11">جَیسا کہ زبان کھانے کو چکھ لیتی ہے؟<verse eid="JOB 12:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 12:12"/>کیا، عمر رسیدہ میں حِکمت نہیں پائی جاتی؟</para>
  <para style="q2" vid="JOB 12:12">کیا طویل عمر سمجھ کو پُختہ نہیں کرتی؟<verse eid="JOB 12:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 12:13"/>”خُدا حِکمت اَور قُدرت کے مالک ہیں؛</para>
  <para style="q2" vid="JOB 12:13">مصلحت اَور دانائی بھی اُن ہی کی ہے۔<verse eid="JOB 12:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 12:14"/>جسے اُنہُوں نے ڈھا دیا، اُسے کویٔی دوبارہ کھڑا نہیں کر سَکتا؛</para>
  <para style="q2" vid="JOB 12:14">جسے اُنہُوں نے قَید کیا، اُسے کویٔی آزاد نہیں کر سَکتا۔<verse eid="JOB 12:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 12:15"/>اگر وہ مینہ روک دیں تو سُوکھا پڑ جاتا ہے؛</para>
  <para style="q2" vid="JOB 12:15">اَور اگر وہ اُسے برساتے رہیں تو زمین تباہ ہو جاتی ہے۔<verse eid="JOB 12:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 12:16"/>قُوّت اَور حِکمت خُدا کے ہاتھ میں ہے؛</para>
  <para style="q2" vid="JOB 12:16">فریب کھانے والا اَور فریبی دونوں اُن ہی کے ہیں۔<verse eid="JOB 12:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 12:17"/>وہ مُشیروں کو بے نقاب کرتے ہیں</para>
  <para style="q2" vid="JOB 12:17">اَور مُنصِفوں کو بےوقُوف بناتے ہیں۔<verse eid="JOB 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 12:18"/>وہ بادشاہوں کے کمربند اُترواکر</para>
  <para style="q2" vid="JOB 12:18">اُنہیں لنگوٹ پہناکر غُلام بنا دیتے ہیں۔<verse eid="JOB 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 12:19"/>وہ کاہِنوں کے کپڑے اُترواکر اُنہیں جَلاوطن کر دیتے ہیں</para>
  <para style="q2" vid="JOB 12:19">اَور جابروں کو نیچا دِکھانے ہیں۔<verse eid="JOB 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 12:20"/>وہ مُعتبر مُشیروں کے لب سِی دیتے ہیں</para>
  <para style="q2" vid="JOB 12:20">اَور بُزرگوں کی بصیرت چھین لیتے ہیں۔<verse eid="JOB 12:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 12:21"/>وہ اُمرا پر ذِلّت برساتے ہیں</para>
  <para style="q2" vid="JOB 12:21">اَور زور آوروں کو خالی ہاتھ کر دیتے ہیں۔<verse eid="JOB 12:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 12:22"/>وہ اَندھیروں میں چُھپے ہُوئے راز آشکار کرتے ہیں،</para>
  <para style="q2" vid="JOB 12:22">اَور گہرے سایوں کو رَوشنی میں لاتے ہیں۔<verse eid="JOB 12:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 12:23"/>وہ قوموں کو عظمت عطا فرماتے ہیں اَور وُہی اُنہیں تباہ کرتے ہیں؛</para>
  <para style="q2" vid="JOB 12:23">وہ قوموں کو وسعت بخشتے ہیں اَور وُہی اُن میں انتشار پیدا کر دیتے ہیں<verse eid="JOB 12:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 12:24"/>وہ دُنیا کے رہنماؤں کے ذہن کند کر دیتے ہیں؛</para>
  <para style="q2" vid="JOB 12:24">وہ اُنہیں بے راہ بیابان میں بھٹکا دیتے ہیں۔<verse eid="JOB 12:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 12:25"/>وہ اَندھیرے میں چراغ کے بغیر ٹٹولتے پھرتے ہیں؛</para>
  <para style="q2" vid="JOB 12:25">اَور اُنہیں متوالوں کی طرح لڑکھڑاتے رہنے پر مجبُور کر دیتے ہیں۔<verse eid="JOB 12:25"/></para>
  <para style="b"/>
  <chapter eid="JOB 12"/>
  <chapter number="13" style="c" sid="JOB 13"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 13:1"/>”میری آنکھوں نے یہ سَب کچھ دیکھ لیا ہے،</para>
  <para style="q2" vid="JOB 13:1">میرے کانوں نے سُنا اَور اُسے سمجھ لیا ہے۔<verse eid="JOB 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 13:2"/>جو تُم جانتے ہو اُسے میں بھی جانتا ہُوں؛</para>
  <para style="q2" vid="JOB 13:2">میں تُم سے کچھ کم نہیں۔<verse eid="JOB 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 13:3"/>لیکن مَیں قادرمُطلق سے گُفتگو کرنا چاہتا ہُوں،</para>
  <para style="q2" vid="JOB 13:3">اَور اَپنا دعویٰ خُدا کے حُضُور پیش کرنا چاہتا ہُوں۔<verse eid="JOB 13:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 13:4"/>لیکن تُم مُجھ پر تہمت لگاتے ہو؛</para>
  <para style="q2" vid="JOB 13:4">تُم سَب کے سَب نکمّے طبیب ہو!<verse eid="JOB 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 13:5"/>کاش تُم بالکُل خاموش ہو جاتے!</para>
  <para style="q2" vid="JOB 13:5">یہ تمہاری دانشمندی کا ثبوت ہوتا۔<verse eid="JOB 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 13:6"/>اَب میری دلیل سُنو؛</para>
  <para style="q2" vid="JOB 13:6">میرے مُنہ کے دعویٰ پر کان لگاؤ۔<verse eid="JOB 13:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 13:7"/>کیا تُم خُدا کی طرف سے شر اَنگیز بات کہو گے؟</para>
  <para style="q2" vid="JOB 13:7">اَور اُن کے حق میں فریب سے کام لوگے؟<verse eid="JOB 13:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 13:8"/>کیا تُم اُن کی طرفداری کروگے؟</para>
  <para style="q2" vid="JOB 13:8">کیا تُم خُدا کی طرف سے مُقدّمہ لڑوگے؟<verse eid="JOB 13:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 13:9"/>اگر وہ تمہاری تفتیش کریں، تو کیا یہ تمہارے حق میں اَچھّا ہوگا؟</para>
  <para style="q2" vid="JOB 13:9">کیا تُم خُدا کو دھوکا دے سکوگے جَیسے آدمیوں کو دیتے ہو؟<verse eid="JOB 13:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 13:10"/>اگر تُم نے خُفیہ طور پر طرفداری سے کام لیا</para>
  <para style="q2" vid="JOB 13:10">تو وہ تُمہیں ضروُر تنبیہ کریں گے۔<verse eid="JOB 13:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 13:11"/>کیا اُن کی شوکت تُمہیں ڈرائے گی نہیں؟</para>
  <para style="q2" vid="JOB 13:11">کیا تُم پر اُن کا خوف نہ چھا جائے گا؟<verse eid="JOB 13:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 13:12"/>تمہارے اُصُول راکھ کی تمثیلیں ہیں؛</para>
  <para style="q2" vid="JOB 13:12">اَور تمہاری فصیلیں مٹّی کی فصیلیں ہیں۔<verse eid="JOB 13:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 13:13"/>”خاموش رہو اَور مُجھے بولنے دو؛</para>
  <para style="q2" vid="JOB 13:13">پھر مُجھ پرجو گزرے سو گزرے۔<verse eid="JOB 13:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 13:14"/>میں خوامخواہ خطرہ کیوں مول لُوں</para>
  <para style="q2" vid="JOB 13:14">اَور اَپنی جان ہتھیلی پر کیوں رکھوں گا؟<verse eid="JOB 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 13:15"/>خواہ خُدا میرے قتل کا حُکم دے، پھر بھی میں اُن سے اُمّید رکھوں گا؛</para>
  <para style="q2" vid="JOB 13:15">اَور اُن کے رُوبرو حُجّت کرتا رہُوں گا۔<verse eid="JOB 13:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 13:16"/>یہی میری نَجات کا باعث ہوگا،</para>
  <para style="q2" vid="JOB 13:16">کیونکہ کویٔی بے دین خُدا کے سامنے آنے کی جَسارت نہ کرےگا!<verse eid="JOB 13:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 13:17"/>میری باتیں غور سے سُنو؛</para>
  <para style="q2" vid="JOB 13:17">جو کچھ میں کہتا ہُوں تمہارے کانوں میں پڑے۔<verse eid="JOB 13:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 13:18"/>اَب جَب کہ مَیں نے اَپنا دعویٰ دُرست کر لیا ہے،</para>
  <para style="q2" vid="JOB 13:18">مُجھے یقین ہے کہ فیصلہ میرے حق میں ہوگا۔<verse eid="JOB 13:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 13:19"/>اگر اَب بھی کویٔی میرے خِلاف اِلزام لگاتاہے،</para>
  <para style="q2" vid="JOB 13:19">تو میں چُپ سادھ لُوں گا اَور اَپنی جان دے دُوں گا۔<verse eid="JOB 13:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 13:20"/>”اَے خُدا، صِرف میری دو باتیں مان لیں،</para>
  <para style="q2" vid="JOB 13:20">پھر مَیں آپ سے چھُپا نہ رہُوں گا:<verse eid="JOB 13:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 13:21"/>اَپنا ہاتھ مُجھ سے دُور ہٹا لیں،</para>
  <para style="q2" vid="JOB 13:21">اَور مُجھے اَپنے غضب سے ڈرانا بند کر دیں۔<verse eid="JOB 13:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 13:22"/>تَب مُجھے طلب کریں اَور مَیں جَواب دُوں گا،</para>
  <para style="q2" vid="JOB 13:22">یا مُجھے بولنے دیں اَور آپ جَواب دیں۔<verse eid="JOB 13:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 13:23"/>آخِر مَیں نے کتنے جُرم اَور گُناہ کئے ہیں؟</para>
  <para style="q2" vid="JOB 13:23">مُجھے میری خطا اَور میرا گُناہ بتائیں۔<verse eid="JOB 13:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 13:24"/>آپ اَپنا چہرہ کیوں چھپاتے ہیں؟</para>
  <para style="q2" vid="JOB 13:24">اَور مُجھے اَپنا دُشمن کیوں سمجھتا ہے؟<verse eid="JOB 13:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 13:25"/>کیا آپ ہَوا کے اُڑائے ہُوئے پتّوں کو اَذیّت پہُنچائیں گے؟</para>
  <para style="q2" vid="JOB 13:25">کیا سُوکھنے بھُس کے پیچھے پڑیں گے؟<verse eid="JOB 13:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 13:26"/>کیونکہ آپ میرے خِلاف کڑوی باتیں لِکھتے ہیں</para>
  <para style="q2" vid="JOB 13:26">اَور میری جَوانی کے گُناہ مُجھ پر واپس لاتے ہیں۔<verse eid="JOB 13:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 13:27"/>آپ میرے پاؤں بِیڑیوں سے جکڑتے ہیں؛</para>
  <para style="q2" vid="JOB 13:27">اَور میرے پاؤؤں کے تلووں پر نِشان لگا کر</para>
  <para style="q2" vid="JOB 13:27">میری تمام راہوں کی سخت نِگرانی کرتے ہیں۔<verse eid="JOB 13:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 13:28"/>”پس اِنسان ایک سڑی ہُوئی چیز کی طرح ضائع ہو جاتا ہے،</para>
  <para style="q2" vid="JOB 13:28">گویا ایک کپڑے کی طرح، جسے کیڑا کھا گیا ہو۔<verse eid="JOB 13:28"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="JOB 13"/>
  <chapter number="14" style="c" sid="JOB 14"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 14:1"/>”اِنسان جو عورت سے پیدا ہوتاہے،</para>
  <para style="q2" vid="JOB 14:1">چند روزہ<note caller="+" style="f"><char style="fr" closed="false">14‏:1 </char><char style="fq" closed="false">چند روزہ </char><char style="ft" closed="false">یعنی کمزور اَور بےبس</char></note> ہے اَور مُصیبت کا مارا ہُوا بھی۔<verse eid="JOB 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 14:2"/>وہ پھُول کی طرح کھِلتا، اَور مُرجھا جاتا ہے؛</para>
  <para style="q2" vid="JOB 14:2">وہ تیزی سے گزرتے ہُوئے سایہ کی طرح قائِم نہیں رہتا۔<verse eid="JOB 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 14:3"/>کیا تُم اَیسے اِنسان پر اَپنی آنکھیں جمائے رکھتا ہے؟</para>
  <para style="q2" vid="JOB 14:3">کیا تُم میرے ساتھ عدالت میں جاؤگے؟<verse eid="JOB 14:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 14:4"/>وہ کون ہے جو ناپاک میں سے پاک شَے نکال سکے؟</para>
  <para style="q2" vid="JOB 14:4">کویٔی بھی نہیں!<verse eid="JOB 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 14:5"/>اِنسان کے دِن مُعیّن ہیں؛</para>
  <para style="q2" vid="JOB 14:5">تُم نے اُس کے مہینوں کی تعداد طے کر رکھی ہے</para>
  <para style="q2" vid="JOB 14:5">اَور اُس کی حُدوُد مُقرّر کر دی ہیں جنہیں وہ پار نہیں کر سَکتا۔<verse eid="JOB 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 14:6"/>چنانچہ اُس سے نظر ہٹا لیں اَور اُسے آرام کرنے دیں،</para>
  <para style="q2" vid="JOB 14:6">جَب تک کہ وہ ایک مزدُور کی طرح اَپنا دِن پُورا نہ کر لے۔<verse eid="JOB 14:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 14:7"/>”درخت کو تو اُمّید رہتی ہے؛</para>
  <para style="q2" vid="JOB 14:7">اگر اُسے کاٹ ڈالا جائے تو وہ پھر سے پھوٹ نکلے گا،</para>
  <para style="q2" vid="JOB 14:7">اَور اُس کی نئی کونپلیں معدوم نہ ہوں گی۔<verse eid="JOB 14:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 14:8"/>اگرچہ اُس کی جڑیں زمین میں پرانی ہو جایٔیں</para>
  <para style="q2" vid="JOB 14:8">اَور اُس کا تنا مٹّی میں گل جائے،<verse eid="JOB 14:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 14:9"/>تو بھی پانی کی خُوشبو ہی سے اُس میں شگوفے پھوٹ نکلیں گے</para>
  <para style="q2" vid="JOB 14:9">اَور وہ پَودے کی طرح شاخیں نکالے گا۔<verse eid="JOB 14:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 14:10"/>لیکن اِنسان مَرجاتا ہے اَور پھر نہیں اُٹھتا؛</para>
  <para style="q2" vid="JOB 14:10">وہ آخِری سانس لیتا ہے اَور باقی نہیں رہتا۔<verse eid="JOB 14:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 14:11"/>جِس طرح پانی سمُندر سے غائب ہو جاتا ہے</para>
  <para style="q2" vid="JOB 14:11">اَور دریا کی شاہراہ سُوکھ جاتی ہے،<verse eid="JOB 14:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 14:12"/>اُسی طرح اِنسان مرجاتا ہے اَور پھر نہیں اُٹھتا؛</para>
  <para style="q2" vid="JOB 14:12">جَب تک آسمان ٹل نہ جایٔیں اِنسان نہیں بیدار ہوں گے</para>
  <para style="q2" vid="JOB 14:12">نہ اَپنی نیند سے بیدار کئے جائیں گے۔<verse eid="JOB 14:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 14:13"/>”کاش کہ آپ مُجھے قبر میں چھُپا لیتے</para>
  <para style="q2" vid="JOB 14:13">اَور اَپنا غضب ٹلنے تک مُجھے چُھپائے رکھتے!</para>
  <para style="q1" vid="JOB 14:13">کاش کہ آپ میرے لیٔے کویٔی وقت مُقرّر کرتے</para>
  <para style="q2" vid="JOB 14:13">اَور پھر مُجھے یاد فرماتے!<verse eid="JOB 14:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 14:14"/>اگر اِنسان مَر جائے تو کیا وہ پھر سے جی سکےگا؟</para>
  <para style="q2" vid="JOB 14:14">اَپنی مشقّت کے تمام ایّام تک</para>
  <para style="q2" vid="JOB 14:14">میں اَپنی مخلصی کا منتظر رہُوں گا۔<verse eid="JOB 14:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 14:15"/>آپ آواز دیں گے اَور مَیں تُمہیں جَواب دُوں گا؛</para>
  <para style="q2" vid="JOB 14:15">آپ اَپنے ہاتھوں سے بنائی ہُوئی مخلُوق کی طرف متوجّہ ہوں گے۔<verse eid="JOB 14:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 14:16"/>تَب آپ میرے قدم ضروُر گنیں گے</para>
  <para style="q2" vid="JOB 14:16">لیکن میرے گُناہ کا حِساب نہ رکھیں گے۔<verse eid="JOB 14:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 14:17"/>میری خطائیں ایک تھیلی میں مُہر بند کر دی جایٔیں گی؛</para>
  <para style="q2" vid="JOB 14:17">آپ میرے گُناہ پر پردہ ڈالیں گے۔<verse eid="JOB 14:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 14:18"/>”لیکن جِس طرح ایک پہاڑ ریزہ ریزہ ہوکر گِر جاتا ہے،</para>
  <para style="q2" vid="JOB 14:18">اَور ایک چٹّان اَپنی جگہ سے ہٹائی جاتی ہے۔<verse eid="JOB 14:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 14:19"/>جِس طرح پانی پتّھروں کو گھِس ڈالتا ہے</para>
  <para style="q2" vid="JOB 14:19">اَور سیلاب مٹّی کو بہا لے جاتا ہے،</para>
  <para style="q2" vid="JOB 14:19">اُسی طرح آپ اِنسان کی اُمّید پر پانی پھیر دیتے ہیں۔<verse eid="JOB 14:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 14:20"/>آپ ہمیشہ کے لیٔے اُس پر غالب آتے ہیں اَور وہ چل بستا ہے؛</para>
  <para style="q2" vid="JOB 14:20">آپ اُس کا چہرہ بدل دیتے ہیں اَور وہ رحلت کر جاتا ہے۔<verse eid="JOB 14:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 14:21"/>اگر اُس کے بیٹے عزّت پاتے ہیں تو اُس کا بھی اُسے علم نہیں ہوتا؛</para>
  <para style="q2" vid="JOB 14:21">اَور اگر وہ ذلیل کئے جاتے ہیں تو اُنہیں خبر تک نہیں ہوتی۔<verse eid="JOB 14:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 14:22"/>وہ صِرف اَپنے ہی جِسم کا درد محسُوس کرتے ہیں</para>
  <para style="q2" vid="JOB 14:22">اَور صِرف اَپنے ہی لیٔے ماتم کرتے ہیں۔“<verse eid="JOB 14:22"/></para>
  <chapter eid="JOB 14"/>
  <chapter number="15" style="c" sid="JOB 15"/>
  <para style="s1">الیفزؔ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 15:1"/>تَب اِلیفزؔ تیمانی نے جَواب دیا:<verse eid="JOB 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 15:2"/>”کیا ایک عقلمند شخص بے تُکا جَواب دے</para>
  <para style="q2" vid="JOB 15:2">یا اَپنا پیٹ گرم مشرقی ہَوا سے بھر لے؟<verse eid="JOB 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 15:3"/>کیا وہ اَپنی بحث میں بے معنی الفاظ اِستعمال کرے،</para>
  <para style="q2" vid="JOB 15:3">یا اَیسی تقریریں جِن کی کویٔی قدر و قیمت نہ ہو؟<verse eid="JOB 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 15:4"/>لیکن تُم تو تقویٰ کو بیکار سمجھتے ہو</para>
  <para style="q2" vid="JOB 15:4">اَور خُدا کے خوف کو درگزر کرتے ہو۔<verse eid="JOB 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 15:5"/>تمہارا گُناہ تمہارا مُنہ کھُلواتا ہے؛</para>
  <para style="q2" vid="JOB 15:5">اَور تمہاری زبان سے عیّاری ظاہر ہوتی ہے۔<verse eid="JOB 15:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 15:6"/>خُود تمہارا مُنہ تُمہیں مُلزم ٹھہراتا ہے نہ کہ میرا؛</para>
  <para style="q2" vid="JOB 15:6">تمہارے ہی ہونٹ تمہارے خِلاف گواہی دیتے ہیں۔<verse eid="JOB 15:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 15:7"/>”کیا تُم ہی پہلا اِنسان ہو جو پیدا ہویٔے ہو؟</para>
  <para style="q2" vid="JOB 15:7">کیا تُم پہاڑوں سے پہلے وُجُود میں آئےتھے؟<verse eid="JOB 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 15:8"/>کیا تُم خُدا کی مشورت پر کان لگاتے ہو؟</para>
  <para style="q2" vid="JOB 15:8">یا حِکمت کو صِرف اَپنی حَد تک محدُود رکھتے ہو؟<verse eid="JOB 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 15:9"/>تُم اَیسی کون سِی بات جانتے ہو جو ہم نہیں جانتے؟</para>
  <para style="q2" vid="JOB 15:9">تُم میں اَیسی کیا بصیرت ہے جو ہم میں نہیں؟<verse eid="JOB 15:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 15:10"/>سفیدریش اَور بُزرگ لوگ ہماری جانِب ہیں،</para>
  <para style="q2" vid="JOB 15:10">جو تمہارے باپ سے بھی زِیادہ عمر رسیدہ ہیں۔<verse eid="JOB 15:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 15:11"/>کیا خُدا کی تسلّی تمہارے لیٔے کافی نہیں،</para>
  <para style="q2" vid="JOB 15:11">وہ الفاظ جو دھیرے سے مُجھے کہے گیٔے؟<verse eid="JOB 15:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 15:12"/>تمہارے دِل نے تُمہیں اَپنی طرف کیوں کھینچ لیا،</para>
  <para style="q2" vid="JOB 15:12">اَور تمہاری آنکھیں کیوں چوندھیا گئیں،<verse eid="JOB 15:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 15:13"/>یہاں تک کہ تُم خُدا کے خِلاف اَپنے غُصّہ کا مظاہرہ کرتے ہو</para>
  <para style="q2" vid="JOB 15:13">اَور اَپنے مُنہ سے اَیسی باتیں نکالتے ہو؟<verse eid="JOB 15:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 15:14"/>”اِنسان ہے ہی کیا، کہ وہ پاک ہو،</para>
  <para style="q2" vid="JOB 15:14">یا وہ جو عورت سے پیدا ہُوا راستباز کیسے ٹھہرے؟<verse eid="JOB 15:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 15:15"/>اگر خُدا اَپنے مُقدّسوں پر<note caller="+" style="f"><char style="fr" closed="false">15‏:15 </char><char style="fq" closed="false">مُقدّسوں پر </char><char style="ft" closed="false">فرشتوں</char></note> اِعتبار نہیں کرتا،</para>
  <para style="q2" vid="JOB 15:15">اگر آسمان بھی اُن کی نگاہ میں پاک نہیں ہیں۔<verse eid="JOB 15:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 15:16"/>تو پھر اِنسان کیا چیز ہے جو حقیر اَور فاسق ہے،</para>
  <para style="q2" vid="JOB 15:16">اَورجو بدی کو پانی کی طرح پی لیتا ہے!<verse eid="JOB 15:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 15:17"/>”تُم میری سُنو تو میں تُمہیں سمجھا دُوں گا؛</para>
  <para style="q2" vid="JOB 15:17">اَور بتاؤں گا کہ مَیں نے کیا دیکھاہے،<verse eid="JOB 15:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 15:18"/>وہ جِن کا عقلمندوں نے اعلان کیا،</para>
  <para style="q2" vid="JOB 15:18">جسے اَپنے آباؤاَجداد سے حاصل کرکے بِنا چُھپائے پیش کیا۔<verse eid="JOB 15:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 15:19"/>(صِرف اُن ہی کو مُلک دیا گیا تھا</para>
  <para style="q2" vid="JOB 15:19">اَور کویٔی بیگانہ اُن کے درمیان نہیں آیا):<verse eid="JOB 15:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 15:20"/>بدکار آدمی عمر بھر شدید درد سے کراہتا ہے۔</para>
  <para style="q2" vid="JOB 15:20">تمام عمر کی بے دردی سنگدل کے لیٔے جمع کر دی گئی ہے۔<verse eid="JOB 15:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 15:21"/>خوفناک آوازیں اُس کے کان میں گونجتی ہیں؛</para>
  <para style="q2" vid="JOB 15:21">اُس کی خُوشحالی کے وقت لُٹیرے<note caller="+" style="f"><char style="fr" closed="false">15‏:21 </char><char style="fq" closed="false">لُٹیرے </char><char style="ft" closed="false">ڈاکُو</char></note> اُس پر دھاوا بول دیتے ہیں۔<verse eid="JOB 15:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 15:22"/>اُسے تاریکی سے نکلنے کا بالکُل یقین نہیں؛</para>
  <para style="q2" vid="JOB 15:22">تلوار اُس کی منتظر ہے۔<verse eid="JOB 15:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 15:23"/>وہ روٹی کی جُستُجو میں مارا مارا پھرتاہے؛</para>
  <para style="q2" vid="JOB 15:23">اَور جانتا ہے کہ موت اَب قریب ہے۔<verse eid="JOB 15:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 15:24"/>مُصیبت اَور سخت تکلیف سے وہ نہایت خوفزدہ ہے؛</para>
  <para style="q2" vid="JOB 15:24">یہ آفتیں اُسے خوفزدہ کئے ہُوئے ہیں جَیسے کویٔی بادشاہ حملہ کرنے پر آمادہ ہو۔<verse eid="JOB 15:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 15:25"/>اِس لیٔے کہ وہ خُدا کو مُکّا دِکھاتا ہے</para>
  <para style="q2" vid="JOB 15:25">اَور قادرمُطلق کے خِلاف شیخی بگھارتا ہے۔<verse eid="JOB 15:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 15:26"/>ایک موٹی اَور مضبُوط سِپر سے مُسلّح ہوکر</para>
  <para style="q2" vid="JOB 15:26">اُس پر لپکتا ہے۔<verse eid="JOB 15:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 15:27"/>”حالانکہ اُس کا چہرہ چربی سے پھُولا ہُواہے</para>
  <para style="q2" vid="JOB 15:27">اَور اُس کی کمر کا گوشت لٹکنے لگا ہے،<verse eid="JOB 15:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 15:28"/>وہ ویران شہروں میں بسے گا</para>
  <para style="q2" vid="JOB 15:28">اَیسے مکانوں میں جِن میں کویٔی نہ رہتا ہو،</para>
  <para style="q2" vid="JOB 15:28">اَیسے گھروں میں جو نہایت خستہ حالت میں ہیں۔<verse eid="JOB 15:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 15:29"/>اُس کی دولتمندی ختم ہو جائے گی اَور اُس کا مال جاتا رہے گا،</para>
  <para style="q2" vid="JOB 15:29">نہ ہی اُس کی مِلکیّت وسیع ہوگی۔<verse eid="JOB 15:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 15:30"/>وہ اَندھیرے سے بچ کر نکل نہ سکےگا؛</para>
  <para style="q2" vid="JOB 15:30">بھڑکتی ہُوئی آگ کا شُعلہ اُس کی شاخوں کو جھُلس دے گا،</para>
  <para style="q2" vid="JOB 15:30">اَور خُدا کے مُنہ کا دَم اُسے اُڑا دے گا۔<verse eid="JOB 15:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 15:31"/>باطِل پر بھروسا کرکے وہ اَپنے آپ کو دھوکا نہ دے،</para>
  <para style="q2" vid="JOB 15:31">کیونکہ اُس کے بدلہ میں وہ کچھ نہ پایٔےگا۔<verse eid="JOB 15:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 15:32"/>اَپنے وقت سے پہلے ہی اُسے پُورا اجر مِل جائے گا،</para>
  <para style="q2" vid="JOB 15:32">اَور اُس کی شاخیں پھیل نہ پائیں گی۔<verse eid="JOB 15:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 15:33"/>وہ انگور کی اُس بیل کی طرح ہوگا جِس کے انگور پکنے سے پہلے ہی جھڑ جاتے ہیں،</para>
  <para style="q2" vid="JOB 15:33">یا زَیتُون کے اُس درخت کی طرح جِس کے پھُول گِر رہے ہُوں۔<verse eid="JOB 15:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 15:34"/>کیونکہ بےدینوں کی محفل ویران ہوگی،</para>
  <para style="q2" vid="JOB 15:34">اَور رشوت خوروں کے خیمے آگ کی نذر ہوں گے۔<verse eid="JOB 15:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JOB 15:35"/>وہ بدی کے حامل ہوتے ہیں اَور اُن سے بدی پیدا ہوتی ہے؛</para>
  <para style="q2" vid="JOB 15:35">اُن کے بطن میں فریب پرورِش پاتاہے۔“<verse eid="JOB 15:35"/></para>
  <chapter eid="JOB 15"/>
  <chapter number="16" style="c" sid="JOB 16"/>
  <para style="s1">ایُّوب</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 16:1"/>تَب ایُّوب نے جَواب دیا:<verse eid="JOB 16:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 16:2"/>”میں اِس طرح کی بہت سِی باتیں سُن چُکا ہُوں؛</para>
  <para style="q2" vid="JOB 16:2">تمہاری غم خواری کسی کام کی نہیں!<verse eid="JOB 16:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 16:3"/>کیا یہ طُول کلامی کبھی ختم نہ ہوگی؟</para>
  <para style="q2" vid="JOB 16:3">تُمہیں کیا تکلیف ہے کہ تُم حُجّت کئے جا رہے ہو؟<verse eid="JOB 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 16:4"/>اگر تُم میری جگہ ہوتے تو</para>
  <para style="q2" vid="JOB 16:4">میں بھی تمہاری طرح بولتا؛</para>
  <para style="q1" vid="JOB 16:4">تمہارے خِلاف باتیں گڑھتا</para>
  <para style="q2" vid="JOB 16:4">اَور تمہارے سامنے اَپنا سَر ہلاتا۔<verse eid="JOB 16:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 16:5"/>لیکن میرے مُنہ سے ہمّت اَفزا باتیں نکلیں گی؛</para>
  <para style="q2" vid="JOB 16:5">میرے لبوں کی غمگساری تُمہیں راحت پہُنچائے گی۔<verse eid="JOB 16:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 16:6"/>”لیکن جَب مَیں بولتا ہُوں تو میرا درد کم نہیں ہوتا؛</para>
  <para style="q2" vid="JOB 16:6">اَور اگر چُپ سادھ لُوں تَب بھی وہ مُجھے نہیں چھوڑتا۔<verse eid="JOB 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 16:7"/>اَے خُدا، آپ نے مُجھے تھکا دیا؛</para>
  <para style="q2" vid="JOB 16:7">آپ نے میرے سارے گھر بار کو تباہ کر دیا۔<verse eid="JOB 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 16:8"/>آپ نے مُجھے جکڑ لیا، میری حالت میری گواہ ہے؛</para>
  <para style="q2" vid="JOB 16:8">میرا لاغر بَدن کھڑا ہوکر میرے خِلاف گواہی دیتاہے۔<verse eid="JOB 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 16:9"/>خُدا مُجھ پر چڑھ آتے ہیں اَور اَپنے غضب میں مُجھے پھاڑ کر رکھ دیتے ہیں،</para>
  <para style="q2" vid="JOB 16:9">اَور وہ مُجھ پر دانت پیستے ہیں؛</para>
  <para style="q2" vid="JOB 16:9">اَور میرا مُخالف مُجھے آنکھیں دِکھاتا ہے۔<verse eid="JOB 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 16:10"/>لوگ مُنہ کھول کر میرا مذاق اُڑاتے ہیں؛</para>
  <para style="q2" vid="JOB 16:10">حقارت سے میرے گال پر تھپّڑ مارتے ہیں</para>
  <para style="q2" vid="JOB 16:10">اَور میرے خِلاف اِکٹھّے ہو جاتے ہیں۔<verse eid="JOB 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 16:11"/>خُدا نے مُجھے بُرے لوگوں کے حوالہ کر دیا</para>
  <para style="q2" vid="JOB 16:11">اَور مُجھے بدکاروں کے شکنجہ میں ڈال دیا۔<verse eid="JOB 16:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 16:12"/>میں بالکُل ٹھیک تھا، لیکن خُدا نے مُجھے چُورچُور کرکے رکھ دیا؛</para>
  <para style="q2" vid="JOB 16:12">اُنہُوں نے مُجھے گردن سے پکڑکر جھنجوڑ ڈالا۔</para>
  <para style="q1" vid="JOB 16:12">اُنہُوں نے مُجھے اَپنا نِشانہ بنایا،<verse eid="JOB 16:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="JOB 16:13"/>اُن کے تیر اَندازوں نے مُجھے گھیر رکھا ہے۔</para>
  <para style="q1" vid="JOB 16:13">وہ بے رحمی سے میرے گُردوں کو چھید ڈالتے ہیں۔</para>
  <para style="q2" vid="JOB 16:13">اَور میرے پِت کو زمین پر گراتے ہیں۔<verse eid="JOB 16:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 16:14"/>وہ مُجھ پر وار پر وار کئے جاتے ہیں؛</para>
  <para style="q2" vid="JOB 16:14">اَور ایک جنگجو سپاہی کی طرح مُجھ پر دھاوا بولتے ہیں۔<verse eid="JOB 16:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 16:15"/>”مَیں نے اَپنی جلد پر ٹاٹ سِی لیا ہے</para>
  <para style="q2" vid="JOB 16:15">اَور اَپنی عزّت مٹّی میں مِلا دی ہے۔<verse eid="JOB 16:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 16:16"/>میرا چہرہ روتے روتے سُرخ ہو گیا ہے،</para>
  <para style="q2" vid="JOB 16:16">اَور میری آنکھوں پر اَندھیرا چھا گیا ہے؛<verse eid="JOB 16:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 16:17"/>پھر بھی میرے ہاتھوں نے تشدّد سے کام نہیں لیا</para>
  <para style="q2" vid="JOB 16:17">اَور میری دعا پاک ہے۔<verse eid="JOB 16:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 16:18"/>”اَے زمین، میرے خُون پر پردہ نہ ڈال؛</para>
  <para style="q2" vid="JOB 16:18">میری فریاد کو کبھی سکون نہ ملے!<verse eid="JOB 16:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 16:19"/>اَب بھی میرا گواہ آسمان پر ہے؛</para>
  <para style="q2" vid="JOB 16:19">اَور میرا وکیل عالمِ بالا پر۔<verse eid="JOB 16:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 16:20"/>جَب میری آنکھیں خُدا کے حُضُور آنسُو بہاتی ہیں</para>
  <para style="q2" vid="JOB 16:20">میرا دوست میری شفاعت کرتا ہے؛<verse eid="JOB 16:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 16:21"/>جِس طرح ایک اِنسان اَپنے دوست کی وکالت کرتا ہے</para>
  <para style="q2" vid="JOB 16:21">اُسی طرح وہ خُدا سے اِنسان کی وکالت کرتا ہے۔<verse eid="JOB 16:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 16:22"/>”اَب چند سال جو باقی ہیں وہ بھی گزر جایٔیں گے</para>
  <para style="q2" vid="JOB 16:22">پھر مَیں سفر پر روانہ ہو جاؤں گا اَور واپس نہ آؤں گا۔<verse eid="JOB 16:22"/></para>
  <chapter eid="JOB 16"/>
  <chapter number="17" style="c" sid="JOB 17"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 17:1"/>میری رُوح شکستہ ہے،<note caller="+" style="f"><char style="fr" closed="false">17‏:1 </char><char style="fq" closed="false">رُوح شکستہ ہے، </char><char style="ft" closed="false">میری سانسیں ختم ہونے کے قریب ہیں۔</char></note></para>
  <para style="q2" vid="JOB 17:1">میرے زندگی کے دِن گھٹا کر کم کر دیئے گئے،</para>
  <para style="q2" vid="JOB 17:1">قبر میرے اِنتظار میں ہے۔<verse eid="JOB 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 17:2"/>یقیناً ٹھٹّھا کرنے والے مُجھے گھیرے ہُوئے ہیں؛</para>
  <para style="q2" vid="JOB 17:2">اُن کی اشتعال اَنگیزی میری نظروں کے سامنے ہے۔<verse eid="JOB 17:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 17:3"/>”یا خُدا، جو ضمانت آپ مُجھ سے چاہتے ہیں اُس کا اِنتظام کریں۔</para>
  <para style="q2" vid="JOB 17:3">اَور کون ہے جو میری ضمانت دے گا؟<verse eid="JOB 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 17:4"/>آپ نے اُنہیں دانشمندی سے محروم کر دیا؛</para>
  <para style="q2" vid="JOB 17:4">اِس لیٔے آپ اُنہیں کبھی سرفرازی نہ بخشیں گے۔<verse eid="JOB 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 17:5"/>اگر کویٔی اِنسان ذاتی مفاد کی خاطِر اَپنے دوستوں کو مُلزم قرار دیتاہے،</para>
  <para style="q2" vid="JOB 17:5">تو اُس کے بچّوں کی آنکھیں جاتی رہیں گی۔<verse eid="JOB 17:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 17:6"/>”خُدا نے مُجھے ہر کسی کے لیٔے ضرب المثل بنا رکھا ہے،</para>
  <para style="q2" vid="JOB 17:6">یعنی اَیسا آدمی جِس کے مُنہ پر لوگ تھُوکتے ہیں۔<verse eid="JOB 17:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 17:7"/>میری آنکھیں غم سے دھُندلا گئی ہیں؛</para>
  <para style="q2" vid="JOB 17:7">مُجھے ہر صورت سائے کی طرح لگتی ہے<verse eid="JOB 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 17:8"/>راستباز لوگ یہ دیکھ کر حیران ہو گئے؛</para>
  <para style="q2" vid="JOB 17:8">صادق بےدینوں کے خِلاف جوش میں آ گئے۔<verse eid="JOB 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 17:9"/>تو بھی راستباز ثابت قدم رہیں گے،</para>
  <para style="q2" vid="JOB 17:9">اَور صَاف ہاتھوں والے زورآور ہوں گے۔<verse eid="JOB 17:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 17:10"/>”لیکن تُم سَب واپس چلے آؤ، اَور پھر زور لگاؤ!</para>
  <para style="q2" vid="JOB 17:10">مُجھے تُم میں ایک بھی عقلمند نہ ملے گا۔<verse eid="JOB 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 17:11"/>میری زندگی کے دِن تمام ہو گئے، میرے منصُوبے مٹّی میں مِل گیٔے،</para>
  <para style="q2" vid="JOB 17:11">اَور میرے دِل کے ارمانوں پر پانی پھر گیا۔<verse eid="JOB 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 17:12"/>یہ لوگ رات کو دِن کہتے ہیں،</para>
  <para style="q2" vid="JOB 17:12">تاریکی کے ہوتے ہُوئے بھی کہتے ہیں کہ رَوشنی ہے۔<verse eid="JOB 17:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 17:13"/>اگر پاتال ہی وہ گھر ہے جِس کی میں اُمّید کروں،</para>
  <para style="q2" vid="JOB 17:13">اَور مَیں اَندھیرے میں اَپنا بِستر بچھا لُوں،<verse eid="JOB 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 17:14"/>اگر تعفّن کو اَپنا باپ کہنے لگوں،</para>
  <para style="q2" vid="JOB 17:14">اَور کیڑے کو اَپنی ماں یا بہن کہہ کے پُکاروں،<verse eid="JOB 17:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 17:15"/>تو پھر میری اُمّید کہاں رہی؟</para>
  <para style="q2" vid="JOB 17:15">اَور میرے لیٔے اُمّید کی توقع کسے ہوگی؟<verse eid="JOB 17:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 17:16"/>کیا وہ بھی پاتال کے دروازے تک میرے ساتھ چلے گی؟</para>
  <para style="q2" vid="JOB 17:16">کیا ہم ایک ساتھ خاک میں مِل جایٔیں گے؟“<verse eid="JOB 17:16"/></para>
  <chapter eid="JOB 17"/>
  <chapter number="18" style="c" sid="JOB 18"/>
  <para style="s1">بِلددؔ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 18:1"/>تَب بِلددؔ شوحی نے جَواب دیا:<verse eid="JOB 18:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 18:2"/>”آخِر تمہاری باتیں کب ختم ہُوں گی؟</para>
  <para style="q2" vid="JOB 18:2">تُم سمجھ سے کام لو تو ہم بات چیت کر سکتے ہیں۔<verse eid="JOB 18:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 18:3"/>ہم مویشیوں میں کیوں شُمار کیٔے جاتے ہیں؟</para>
  <para style="q2" vid="JOB 18:3">اَور تمہاری نگاہ میں بےوقُوف ٹھہرے ہیں؟<verse eid="JOB 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 18:4"/>تُم جو غُصّے میں خُود اَپنے ہی ٹکڑے ٹکڑے کر رہے ہو،</para>
  <para style="q2" vid="JOB 18:4">کیا تمہاری خاطِر زمین اُجڑ جائے گی؟</para>
  <para style="q2" vid="JOB 18:4">یا چٹّانیں اَپنی جگہ سے ہٹا دی جایٔیں گی؟<verse eid="JOB 18:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 18:5"/>”بدکار کا چراغ بُجھا دیا جاتا ہے؛</para>
  <para style="q2" vid="JOB 18:5">اُس کی آگ کا شُعلہ بُجھ کر رہ جاتا ہے۔<verse eid="JOB 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 18:6"/>اُس کے خیمہ کی رَوشنی تاریک ہو جاتی ہے؛</para>
  <para style="q2" vid="JOB 18:6">اُس کا چراغ خاموش ہو جاتا ہے۔<verse eid="JOB 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 18:7"/>اُس کی قُوّت کے قدم ڈگمگانے لگتے ہیں؛</para>
  <para style="q2" vid="JOB 18:7">اُس کے اَپنے منصُوبے اُسے نیچے گرا دیتے ہیں۔<verse eid="JOB 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 18:8"/>اُس کے پاؤں اُسے جال میں پھنسا دیتے ہیں</para>
  <para style="q2" vid="JOB 18:8">اَور وہ اُس کے پھندوں میں اُلجھ کر رہ جاتا ہے۔<verse eid="JOB 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 18:9"/>جال اُسے اِیڑی سے پکڑتا ہے</para>
  <para style="q2" vid="JOB 18:9">اَور بُری طرح جکڑ لیتا ہے۔<verse eid="JOB 18:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 18:10"/>کمند اُس کے لیٔے زمین میں چھپادی جاتی ہے؛</para>
  <para style="q2" vid="JOB 18:10">اَور شکنجہ اُس کی راہ میں پڑا رہتاہے۔<verse eid="JOB 18:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 18:11"/>دہشت ہر طرف سے اُسے گھبراہٹ میں مُبتلا کردیتی ہے</para>
  <para style="q2" vid="JOB 18:11">اَور ہر قدم پر اُس کا پیچھا کرتا ہے۔<verse eid="JOB 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 18:12"/>مُصیبت اُس کی بھُوکی ہے؛</para>
  <para style="q2" vid="JOB 18:12">اَور آفت اُس کے گرنے کا اِنتظار کرتی ہے۔<verse eid="JOB 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 18:13"/>وہ اُس کی جلد کو کُتر ڈالتی ہے؛</para>
  <para style="q2" vid="JOB 18:13">اَور موت کا پہلوٹھا اُس کے اَعضا کو چٹ کر جاتا ہے۔<verse eid="JOB 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 18:14"/>اُسے اُس کے خیمہ کی سلامتی سے محروم کر دیا جاتا ہے</para>
  <para style="q2" vid="JOB 18:14">اَور دہشت کے بادشاہ کے حُضُور پیش کیا جاتا ہے۔<verse eid="JOB 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 18:15"/>آگ اُس کے خیمہ میں بستی ہے؛</para>
  <para style="q2" vid="JOB 18:15">اَور جلتی ہُوئی گندھک اُس کے مَسکن پر بِکھیر دی جاتی ہے۔<verse eid="JOB 18:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 18:16"/>اُس کی جڑیں نیچے سے سُوکھ جاتی ہیں</para>
  <para style="q2" vid="JOB 18:16">اَور اُوپر اُس کی شاخیں مُرجھا جاتی ہیں۔<verse eid="JOB 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 18:17"/>زمین پر سے اُس کی یاد مِٹ جاتی ہے؛</para>
  <para style="q2" vid="JOB 18:17">اَور مُلک میں اُس کا نام تک باقی نہیں رہتا۔<verse eid="JOB 18:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 18:18"/>وہ اجالے سے اَندھیرے میں ہانک دیا جاتا ہے</para>
  <para style="q2" vid="JOB 18:18">اَور دُنیا سے جَلاوطن کر دیا جاتا ہے۔<verse eid="JOB 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 18:19"/>اُس کی قوم میں نہ اُس کی نَسل باقی رہے گی نہ بال بچّے،</para>
  <para style="q2" vid="JOB 18:19">اُس کے مکان میں رہنے والا کویٔی نہ ہوگا۔<note caller="+" style="f"><char style="fr" closed="false">18‏:19 </char><char style="ft" closed="false"><char style="xt"><ref loc="JOB 27:14">ایُّو 27‏:14</ref>‏</char></char></note><verse eid="JOB 18:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 18:20"/>آنے والی نَسلیں اُس کے اَنجام پر حیران ہُوں گی؛</para>
  <para style="q2" vid="JOB 18:20">جَیسے پہلے وقتوں کے لوگ خوفزدہ ہو گئے تھے۔<verse eid="JOB 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 18:21"/>یقیناً بدکاروں کے مَسکن اَیسے ہی ہوتے ہیں؛</para>
  <para style="q2" vid="JOB 18:21">اَورجو خُدا کو نہیں جانتا اُس کی جگہ اَیسی ہی ہوتی ہے۔“<verse eid="JOB 18:21"/></para>
  <chapter eid="JOB 18"/>
  <chapter number="19" style="c" sid="JOB 19"/>
  <para style="s1">ایُّوب اَور خُدا کی حاضِر جَوابی</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 19:1"/>تَب ایُّوب نے جَواب دیا:<verse eid="JOB 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 19:2"/>”تُم کب تک میری جان کھاتے رہوگے</para>
  <para style="q2" vid="JOB 19:2">اَور باتوں سے میرے ٹکڑے ٹکڑے کرتے رہوگے؟<verse eid="JOB 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 19:3"/>اَب تک دس بار تُم نے مُجھے ملامت کی ہے؛</para>
  <para style="q2" vid="JOB 19:3">مُجھ پر حملہ کرتے ہو، تُمہیں ذرا بھی شرم نہیں آتی۔<verse eid="JOB 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 19:4"/>اگر واقعی، میں راہ سے بھٹک گیا ہُوں،</para>
  <para style="q2" vid="JOB 19:4">تو میری خطا صِرف میرا اَپنا مُعاملہ ہے۔<verse eid="JOB 19:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 19:5"/>اگر حقیقت یہ ہے کہ تُم اَپنے آپ کو مُجھ سے برتر سمجھتے ہو</para>
  <para style="q2" vid="JOB 19:5">اَور میری تذلیل کو میرے خِلاف پیش کرتے ہو،<verse eid="JOB 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 19:6"/>تُم یہ جان لو کہ خُدا نے میرے ساتھ بےاِنصافی کی ہے</para>
  <para style="q2" vid="JOB 19:6">اَور مُجھے اَپنے جال سے گھیرلیا ہے۔<verse eid="JOB 19:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 19:7"/>”حالانکہ میں پُکار پُکار کر کہتا ہُوں، ’مُجھ پر ظُلم ہُواہے!‘ تَب بھی مُجھے کویٔی جَواب نہیں ملتا؛</para>
  <para style="q2" vid="JOB 19:7">حالانکہ میں مدد کے لیٔے دہائی دیتا ہُوں لیکن اِنصاف نہیں ملتا۔<verse eid="JOB 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 19:8"/>خُدا نے میرا راستہ اَیسا مسدود کر دیا ہے کہ میں گزر نہیں سَکتا؛</para>
  <para style="q2" vid="JOB 19:8">اُنہُوں نے میری راہوں پر تاریکی کا پردہ ڈال دیا ہے۔<verse eid="JOB 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 19:9"/>اُنہُوں نے مُجھے میری عزّت سے محروم کر دیا</para>
  <para style="q2" vid="JOB 19:9">اَور میرے سَر سے تاج اُتار ڈالا۔<verse eid="JOB 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 19:10"/>وہ مُجھے ہر طرف سے چیرپھاڑ کر ختم کر دیتے ہیں؛</para>
  <para style="q2" vid="JOB 19:10">اَور میری اُمّید کو درخت کی طرح اُکھاڑ ڈالتے ہیں<verse eid="JOB 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 19:11"/>اُن کا غُصّہ میرے خِلاف بھڑک اُٹھتا ہے؛</para>
  <para style="q2" vid="JOB 19:11">وہ مُجھے اَپنے دُشمنوں میں شُمار کرتا ہے۔<verse eid="JOB 19:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 19:12"/>اُس کی فَوجیں تیزی سے آگے بڑھتی ہیں؛</para>
  <para style="q2" vid="JOB 19:12">اَور اَپنے لیٔے راستہ بنا کر</para>
  <para style="q2" vid="JOB 19:12">میرے خیمہ کے چاروں طرف خیمہ زن ہو جاتی ہیں۔<verse eid="JOB 19:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 19:13"/>”اُنہُوں نے نے میرے بھائیوں کو مُجھ سے دُور کر دیا؛</para>
  <para style="q2" vid="JOB 19:13">اَور میرے شناسا مُجھ سے بالکُل بیگانہ ہو گئے ہیں۔<verse eid="JOB 19:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 19:14"/>میرے رشتہ دار مُجھے چھوڑکر چل دئیے؛</para>
  <para style="q2" vid="JOB 19:14">اَور میرے احباب مُجھے بھُول گیٔے۔<verse eid="JOB 19:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 19:15"/>میرے مہمان اَور میری خادِمائیں مُجھے اجنبی سمجھتی ہیں؛</para>
  <para style="q2" vid="JOB 19:15">مَیں اُن کی نگاہ میں بیگانہ ہُوں<verse eid="JOB 19:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 19:16"/>میں اَپنے خادِم کو بُلاتا ہُوں لیکن وہ جَواب نہیں دیتا،</para>
  <para style="q2" vid="JOB 19:16">حالانکہ میں اَپنے مُنہ سے اُس کی مِنّت کرتا ہُوں۔<verse eid="JOB 19:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 19:17"/>میری سانس سے میری بیوی کو گھِن آتی ہے؛</para>
  <para style="q2" vid="JOB 19:17">میرے اَپنے بھایٔی<note caller="+" style="f"><char style="fr" closed="false">19‏:17 </char><char style="fq" closed="false">اَپنے بھایٔی </char><char style="ft" closed="false">میرے بیٹے</char></note> مُجھے مکرُوہ سمجھتے ہیں۔<verse eid="JOB 19:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 19:18"/>چُھوٹے بچّے تک میری حقارت کرتے ہیں؛</para>
  <para style="q2" vid="JOB 19:18">مُجھے دیکھ کر میرا مضحکہ اُڑاتے ہیں۔<verse eid="JOB 19:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 19:19"/>میرے سبھی گہرے دوست مُجھ سے نفرت کرتے ہیں؛</para>
  <para style="q2" vid="JOB 19:19">اَور جنہیں میں پسند کرتا ہُوں وہ میرے خِلاف ہو گئے ہیں۔<verse eid="JOB 19:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 19:20"/>میں چمڑی اَور ہڈّیوں کے سِوا کچھ نہ رہا؛</para>
  <para style="q2" vid="JOB 19:20">میں پوپلا ہوکر رہ گیا۔<verse eid="JOB 19:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 19:21"/>”مُجھ پر ترس کھاؤ، اَے میرے دوستوں! ترس کھاؤ،</para>
  <para style="q2" vid="JOB 19:21">کیونکہ خُدا کا ہاتھ مُجھ پر بھاری ہے۔<verse eid="JOB 19:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 19:22"/>تُم خُدا کی طرح میرے پیچھے کیوں پڑے ہو؟</para>
  <para style="q2" vid="JOB 19:22">کیا میرے گوشت سے تمہارا پیٹ نہیں بھرا؟<verse eid="JOB 19:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 19:23"/>”کاش میرے الفاظ درج کئے جاتے،</para>
  <para style="q2" vid="JOB 19:23">کاش وہ کسی کِتاب میں قلم بندہو جاتے،<verse eid="JOB 19:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 19:24"/>کاش کہ وہ لوہے کے قلم سے سیسے پر نقش کئے جاتے،</para>
  <para style="q2" vid="JOB 19:24">یا پتّھر پر ہمیشہ کے لیٔے کندہ کر دئیے جاتے!<verse eid="JOB 19:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 19:25"/>میں جانتا ہُوں کہ میرا نَجات دِہندہ زندہ ہے،</para>
  <para style="q2" vid="JOB 19:25">اَور آخِرکار وہ زمین پر کھڑا ہوگا۔<note caller="+" style="f"><char style="fr" closed="false">19‏:25 </char><char style="ft" closed="false"><char style="xt"><ref loc="1JN 2:28">1 یُوح 2‏:28</ref>؛ <ref loc="ISA 45:5">یَشع 45‏:5</ref>‏</char></char></note><verse eid="JOB 19:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 19:26"/>حالانکہ میرا جِسم فنا ہو جائے گا،</para>
  <para style="q2" vid="JOB 19:26">میں اَپنے جِسم سمیت ہی خُدا کو دیکھوں گا؛<verse eid="JOB 19:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 19:27"/>میں ہی خُود اُنہیں دیکھوں گا</para>
  <para style="q2" vid="JOB 19:27">خُود اَپنی آنکھوں سے میں اُن پر نگاہ کروں گا، کویٔی اَور نہیں۔</para>
  <para style="q2" vid="JOB 19:27">(اُس گھڑی کے لیٔے) میرا دِل اَندر ہی اَندر کس قدر بے قرار ہو رہاہے!<verse eid="JOB 19:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 19:28"/>”اگر تُم کہو کہ ہم ایُّوب کے پیچھے پڑے ہی رہیں گے،</para>
  <para style="q2" vid="JOB 19:28">کیونکہ مُصیبت کی جڑ وُہی، ہے،<verse eid="JOB 19:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 19:29"/>تو تُمہیں خُود بھی تلوار سے ڈرنا چاہئے؛</para>
  <para style="q2" vid="JOB 19:29">کیونکہ خُدا کا قہر تلوار بَن کے تُم پر ٹُوٹے گا،</para>
  <para style="q2" vid="JOB 19:29">تَب تُم روزِ عدالت کی حقیقت سے واقف ہوگے۔“<verse eid="JOB 19:29"/></para>
  <chapter eid="JOB 19"/>
  <chapter number="20" style="c" sid="JOB 20"/>
  <para style="s1">صُوفرؔ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 20:1"/>تَب صُوفرؔ نَعماتی نے جَواب دیا:<verse eid="JOB 20:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 20:2"/>”میں اَپنے پریشان خیالات کے باعث جَواب دینے پر مجبُور ہُوں</para>
  <para style="q2" vid="JOB 20:2">کیونکہ مَیں بہت مُضطرب ہُوں۔<verse eid="JOB 20:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 20:3"/>میں تُم سے یہ تنبیہ سُن کر بے عزّتی محسُوس کر رہا ہُوں،</para>
  <para style="q2" vid="JOB 20:3">اَور میری سمجھ مُجھے جَواب دینے پر آمادہ کر رہی ہے۔<verse eid="JOB 20:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 20:4"/>”یقیناً تُم جانتے ہو کہ زمانہ قدیم سے یہی ہوتا آیا ہے،</para>
  <para style="q2" vid="JOB 20:4">جَب سے بنی نَوع اِنسان نے زمین پر قدم رکھا،<verse eid="JOB 20:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 20:5"/>بدکار کی عیش و عشرت چند روزہ ہیں،</para>
  <para style="q2" vid="JOB 20:5">اَور بے دین کی خُوشی دَم بھر کی ہوتی ہے۔<verse eid="JOB 20:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 20:6"/>خواہ اُس کا غُرور آسمان تک بُلند ہو جائے</para>
  <para style="q2" vid="JOB 20:6">اَور اُس کا سَر بادلوں کو چھُولے،<verse eid="JOB 20:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 20:7"/>وہ اَپنے فُضلہ کی طرح ہمیشہ کے لیٔے فنا ہو جائے گا؛</para>
  <para style="q2" vid="JOB 20:7">جنہوں نے اُسے دیکھاہے، پُوچھیں گے کہ وہ کہاں ہے؟<verse eid="JOB 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 20:8"/>وہ خواب کی طرح اُڑ جاتا ہے اَور پھر نہیں ملتا،</para>
  <para style="q2" vid="JOB 20:8">رات کی رُویا کی طرح دُورہو جاتا ہے۔<verse eid="JOB 20:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 20:9"/>جِن آنکھوں نے اُسے دیکھا تھا اُسے پھر نہ دیکھیں گی؛</para>
  <para style="q2" vid="JOB 20:9">وہ اُن کی قِیام گاہ کو خالی پائیں گی۔<verse eid="JOB 20:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 20:10"/>اُس کی اَولاد غریبوں سے بھیک مانگے گی؛</para>
  <para style="q2" vid="JOB 20:10">اُس کے اَپنے ہاتھ اُس کی دولت واپس دیں گے۔<verse eid="JOB 20:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 20:11"/>اُس کی ہڈّیوں میں سمائی ہُوئی جَوان قُوّت</para>
  <para style="q2" vid="JOB 20:11">اُس کے ساتھ خاک میں مِل جائے گی۔<verse eid="JOB 20:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 20:12"/>”خواہ بدی اُس کے مُنہ میں میٹھی لگے</para>
  <para style="q2" vid="JOB 20:12">اَور وہ اُسے زبان کے نیچے چھُپا لے،<verse eid="JOB 20:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 20:13"/>خواہ وہ اُسے باہر نکلنے نہ دے</para>
  <para style="q2" vid="JOB 20:13">اَور اُسے اَپنے مُنہ میں دبائے رکھے،<verse eid="JOB 20:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 20:14"/>تَب بھی اُس کا کھانا اُس کے پیٹ میں جا کر؛</para>
  <para style="q2" vid="JOB 20:14">سانپوں کے زہر میں تبدیل ہو جائے گا۔<verse eid="JOB 20:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 20:15"/>اُس نے جو دولت نگل رکھی ہے، اُسے اُگل دے گا؛</para>
  <para style="q2" vid="JOB 20:15">خُدا اُس کے پیٹ کو اُسے باہر نکالنے پر مجبُور کرےگا۔<verse eid="JOB 20:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 20:16"/>وہ افعی کا زہر چُوسے گا؛</para>
  <para style="q2" vid="JOB 20:16">اَور افعی کے دانت اُسے مار ڈالیں گے۔<verse eid="JOB 20:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 20:17"/>وہ جھرنوں کا لُطف نہ اُٹھا سکےگا،</para>
  <para style="q2" vid="JOB 20:17">نہ ہی شہد اَور ملائی کی بہتی ہُوئی دریاؤں کا۔<verse eid="JOB 20:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 20:18"/>جو چیز اُس نے مشقّت سے حاصل کی اُسے بغیر کھائے واپس کر دے گا؛</para>
  <para style="q2" vid="JOB 20:18">نہ ہی وہ اَپنے کاروبار کے منافع سے مستفید ہوگا۔<verse eid="JOB 20:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 20:19"/>کیونکہ اُس نے غریبوں پر ظُلم ڈھائے اَور اُنہیں اَور بھی کنگال بنا دیا؛</para>
  <para style="q2" vid="JOB 20:19">اَور اُس نے اُن گھروں پر قبضہ جمالیا جنہیں اُس نے نہیں بنایا تھا۔<verse eid="JOB 20:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 20:20"/>”اُس کی تمنّا ہرگز پُوری نہ ہوگی؛</para>
  <para style="q2" vid="JOB 20:20">اُس کی دولت اُس کے کام نہ آئے گی،<verse eid="JOB 20:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 20:21"/>اَیسی کویٔی شَے نہیں بچی جِس پر اُس نے ہاتھ نہ مارا ہو؛</para>
  <para style="q2" vid="JOB 20:21">اُس کی خُوشحالی قائِم نہ رہے گی۔<verse eid="JOB 20:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 20:22"/>فراوانی کے باوُجُود بھی تنگی اُسے آ پکڑے گی؛</para>
  <para style="q2" vid="JOB 20:22">مُصیبتوں کا پہاڑ اُس پر ٹوٹ پڑےگا۔<verse eid="JOB 20:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 20:23"/>ابھی وہ سیر بھی نہ ہُوا ہوگا،</para>
  <para style="q2" vid="JOB 20:23">کہ خُدا اَپنا قہر شدید اُس پر نازل کریں گے</para>
  <para style="q2" vid="JOB 20:23">اَور اُس پر مُکّے برسائیں گے۔<verse eid="JOB 20:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 20:24"/>چاہے وہ لوہے کے ہتھیار سے بچ کر بھاگ نکلے،</para>
  <para style="q2" vid="JOB 20:24">تیر کا کانسے کا سِرا اُسے چھید ڈالے گا۔<verse eid="JOB 20:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 20:25"/>وہ اُس کی پیٹھ میں سے گزر جائے گا،</para>
  <para style="q2" vid="JOB 20:25">اُس کی چمکدار نوک اُس کا جگر چاک کر دے گی۔</para>
  <para style="q1" vid="JOB 20:25">اَور اُس پر دہشت چھا جائے گی؛<verse eid="JOB 20:25"/></para>
  <para style="q2">
    <verse number="26" style="v" sid="JOB 20:26"/>مُکمّل تاریکی اُس کے خزانوں پر گھات لگائے بیٹھی ہے۔</para>
  <para style="q1" vid="JOB 20:26">آگ بھڑکنے سے پہلے ہی اُسے بھسم کر دے گی</para>
  <para style="q2" vid="JOB 20:26">اَور اُس کے خیمہ میں جو کچھ بچا ہوگا اُسے پھُونک ڈالے گی۔<verse eid="JOB 20:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 20:27"/>افلاک اُس کے گُناہ ظاہر کر دیں گے؛</para>
  <para style="q2" vid="JOB 20:27">زمین اُس کے خِلاف اُٹھ کھڑی ہوگی۔<verse eid="JOB 20:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 20:28"/>خُدا کے روز قہر کا تُند سیلاب،</para>
  <para style="q2" vid="JOB 20:28">اُس کے گھر کا مال و اَسباب بہا لے جائے گا۔<verse eid="JOB 20:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 20:29"/>خُدا نے یہ اَنجام بدکار آدمی کی تقدیر میں لِکھ دیا ہے،</para>
  <para style="q2" vid="JOB 20:29">اُس کے لیٔے خُدا کی مُقرّر کی ہُوئی مِیراث یہی ہے۔“<note caller="+" style="f"><char style="fr" closed="false">20‏:29 </char><char style="ft" closed="false"><char style="xt"><ref loc="JOB 27:13">ایُّو 27‏:13</ref>‏</char></char></note><verse eid="JOB 20:29"/></para>
  <chapter eid="JOB 20"/>
  <chapter number="21" style="c" sid="JOB 21"/>
  <para style="s1">ایُّوب</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 21:1"/>تَب ایُّوب نے جَواب دیا:<verse eid="JOB 21:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 21:2"/>”میری باتوں کو غور سے سُنو؛</para>
  <para style="q2" vid="JOB 21:2">یہ میری تسلّی کا باعث ہوگا۔<verse eid="JOB 21:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 21:3"/>جَب تک میں بولُوں، میری برداشت کرو،</para>
  <para style="q2" vid="JOB 21:3">اَور جَب مَیں بول چُکوں تَب میرا مضحکہ اُڑانا۔<verse eid="JOB 21:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 21:4"/>”کیا میری شکایت اِنسان سے ہے؟</para>
  <para style="q2" vid="JOB 21:4">پھر مَیں صبر کیسے کروں؟<verse eid="JOB 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 21:5"/>مُجھے دیکھو اَور تعجُّب کرو؛</para>
  <para style="q2" vid="JOB 21:5">اَور اَپنا ہاتھ اَپنے مُنہ پر رکھ لو۔<verse eid="JOB 21:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 21:6"/>جَب مَیں اِس بارے میں سوچتا ہُوں تو گھبرا جاتا ہُوں؛</para>
  <para style="q2" vid="JOB 21:6">اَور مُجھ پر لرزہ طاری ہو جاتا ہے۔<verse eid="JOB 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 21:7"/>بدکار کیوں جیتے رہتے ہیں،</para>
  <para style="q2" vid="JOB 21:7">خُوشحال اَور دولتمند ہو جاتے ہیں؟<note caller="+" style="f"><char style="fr" closed="false">21‏:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="JOB 12:6">ایُّو 12‏:6</ref>‏</char></char></note><verse eid="JOB 21:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 21:8"/>وہ اَپنے بچّوں کو اَپنے اِردگرد،</para>
  <para style="q2" vid="JOB 21:8">اَور اَپنی اَولاد اَپنی آنکھوں سے قائِم ہوتے دیکھتے ہیں۔<verse eid="JOB 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 21:9"/>اُن کے گھر محفوظ اَور خوف سے بَری ہیں؛</para>
  <para style="q2" vid="JOB 21:9">خُدا کی لاٹھی<note caller="+" style="f"><char style="fr" closed="false">21‏:9 </char><char style="fq" closed="false">خُدا کی لاٹھی </char><char style="ft" closed="false">سزا کی چھڑی</char></note> اُن پر نہیں پڑتی۔<verse eid="JOB 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 21:10"/>اُن کے سانڈ نَسل بڑھاتے رہتے ہیں؛</para>
  <para style="q2" vid="JOB 21:10">اُن کی گائیں وقت پر بچھڑا دیتی ہیں۔<verse eid="JOB 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 21:11"/>وہ اَپنے چُھوٹے بچّوں کو بھیڑوں کی طرح کھُلا چھوڑ دیتے ہیں؛</para>
  <para style="q2" vid="JOB 21:11">اَور اُن کے لڑکے اُچھلتے کودتے رہتے ہیں۔<verse eid="JOB 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 21:12"/>وہ دف اَور بربط کے ساتھ نغمہ گاتے ہیں؛</para>
  <para style="q2" vid="JOB 21:12">اَور بانسری کی آواز سُن کر خُوش ہونے لگتے ہیں۔<verse eid="JOB 21:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 21:13"/>وہ اَپنے سال خُوشحالی میں گزارتے ہیں،</para>
  <para style="q2" vid="JOB 21:13">اَور اِطمینان سے پاتال میں اُتر جاتے ہیں۔<verse eid="JOB 21:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 21:14"/>وہ خُدا سے کہتے ہیں کہ ہمیں آپ سے کویٔی مطلب نہیں!</para>
  <para style="q2" vid="JOB 21:14">ہم آپ کی راہیں جاننے کے خواہاں نہیں۔<verse eid="JOB 21:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 21:15"/>آخِر قادرمُطلق ہے کون جو ہم اُن کی خدمت کریں؟</para>
  <para style="q2" vid="JOB 21:15">اُن سے دعا کریں تو ہمیں کیا حاصل ہوگا؟<verse eid="JOB 21:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 21:16"/>لیکن اُن کی اِقبالمندی اُن کے اَپنے ہاتھ میں نہیں ہے،</para>
  <para style="q2" vid="JOB 21:16">بدکاروں کے منصُوبے میری سمجھ سے باہر ہیں۔<verse eid="JOB 21:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 21:17"/>”پھر بھی کتنی بار بدکار کا چراغ بُجھایا جاتا ہے؟</para>
  <para style="q2" vid="JOB 21:17">یا کتنی بار اُن پر آفت آتی ہے جِس کے وہ مُستحق ہوتے ہیں،</para>
  <para style="q2" vid="JOB 21:17">اَور کتنی بار اُن پر خُدا اَپنا قہر نازل کرتے ہیں؟<verse eid="JOB 21:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 21:18"/>اُن کی حالت اَیسی ہو جائے جَیسے ہَوا کے سامنے بھُوسی،</para>
  <para style="q2" vid="JOB 21:18">جَیسا کہ کٹی ہُوئی گھاس جسے آندھی اُڑا لے جاتی ہے؟<verse eid="JOB 21:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 21:19"/>کہتے ہیں کہ خُدا اِنسان کی سزا اُس کی اَولاد کے لیٔے رکھ چھوڑتے ہیں۔</para>
  <para style="q2" vid="JOB 21:19">لیکن ہونا تو یہ چاہئے کہ اِنسان کی سزا اُسی کو ملے تاکہ وہ اُسے جان سکے!<verse eid="JOB 21:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 21:20"/>اَور وہ اَپنی آنکھوں سے اَپنی تباہی دیکھ لے؛</para>
  <para style="q2" vid="JOB 21:20">وہ قادرمُطلق کا قہر بھی خُود ہی پیئے۔<verse eid="JOB 21:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 21:21"/>کیونکہ اُس کی اَپنی زندگی کی میعاد خاتِمہ پر ہوگی،</para>
  <para style="q2" vid="JOB 21:21">اُسے اَپنے خاندان کی کیا پروا ہوگی جسے وہ پیچھے چھوڑ جاتا ہے؟<verse eid="JOB 21:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 21:22"/>”کیا خُدا کو کویٔی علم سِکھا سَکتا ہے،</para>
  <para style="q2" vid="JOB 21:22">جَب کہ سرفرازوں تک کی بھی عدالت وُہی کرتے ہیں؟<verse eid="JOB 21:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 21:23"/>ایک شخص بھری جَوانی میں مَرجاتا ہے،</para>
  <para style="q2" vid="JOB 21:23">جَب کہ اُسے ہر طرح کا عیش و آرام مُیسّر ہوتاہے،<verse eid="JOB 21:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 21:24"/>اَور اُس کا جِسم توانا ہوتاہے،</para>
  <para style="q2" vid="JOB 21:24">اَور اُس کی ہڈّیاں گُودے سے بھری ہوتی ہیں۔<verse eid="JOB 21:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 21:25"/>دُوسرا شخص اَپنے جی میں تلخی سے مَرجاتا ہے،</para>
  <para style="q2" vid="JOB 21:25">وہ کسی اَچھّی چیز کا لُطف نہیں اُٹھاتا۔<verse eid="JOB 21:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 21:26"/>دونوں کے جِسم ساتھ ساتھ مٹّی میں پڑے رہتے ہیں،<note caller="+" style="f"><char style="fr" closed="false">21‏:26 </char><char style="fq" closed="false">مٹّی میں پڑے رہتے ہیں، </char><char style="ft" closed="false">وہ ایک جَیسے مَرتے ہیں اَور دفن ہوتے ہیں۔</char></note></para>
  <para style="q2" vid="JOB 21:26">اَور اُن میں کیڑے بھر جاتے ہیں۔<verse eid="JOB 21:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 21:27"/>”مَیں تمہارے خیالات کو بخُوبی جانتا ہُوں،</para>
  <para style="q2" vid="JOB 21:27">اَور اُن منصُوبوں کو بھی جو میرے خِلاف گڑھے جا رہے ہیں۔<verse eid="JOB 21:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 21:28"/>تُم پُوچھتے ہو، ’اَب اِس بڑے آدمی کا گھر کہاں رہا،</para>
  <para style="q2" vid="JOB 21:28">وہ خیمے کہاں گیٔے جہاں بدکار بستے تھے؟‘<verse eid="JOB 21:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 21:29"/>کیا تُم نے مُسافروں سے کبھی نہیں پُوچھا؟</para>
  <para style="q2" vid="JOB 21:29">تُم اُن کے نِشانات کو تو جھٹلا نہیں سکتے،<verse eid="JOB 21:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 21:30"/>کہ بُرا آدمی بھی آفت کے دِن تک بچا رہتاہے،</para>
  <para style="q2" vid="JOB 21:30">اَور غضب کے دِن حاضِر کیا جاتا ہے۔<verse eid="JOB 21:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 21:31"/>کون اُس کے مُنہ پر اُس کے چال چلن کی ملامت کرےگا؟</para>
  <para style="q2" vid="JOB 21:31">کون اُسے اُس کے کئے کی سزا دے گا؟<verse eid="JOB 21:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 21:32"/>اُسے قبر تک لے جایا جاتا ہے،</para>
  <para style="q2" vid="JOB 21:32">اَور اُس کے مزار پر پہرا بِٹھایا جاتا ہے۔<verse eid="JOB 21:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 21:33"/>وادی کی مٹّی اُسے مرغوب ہے؛</para>
  <para style="q2" vid="JOB 21:33">لوگوں کا ہُجوم<note caller="+" style="f"><char style="fr" closed="false">21‏:33 </char><char style="fq" closed="false">لوگوں کا ہُجوم </char><char style="ft" closed="false">جنازہ کا جلوس</char></note> اُس کے پیچھے چلے جا رہے ہیں،</para>
  <para style="q2" vid="JOB 21:33">جَیسے بے شُمار لوگ اُس سے پہلے چلے گیٔے۔<verse eid="JOB 21:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 21:34"/>”تُم فُضول باتوں سے مُجھے کیسے تسلّی دے سکتے ہو؟</para>
  <para style="q2" vid="JOB 21:34">جَب کہ تمہارے جَوابوں میں جھُوٹ کے سِوا اَور کچھ باقی نہیں بچا۔“<verse eid="JOB 21:34"/></para>
  <chapter eid="JOB 21"/>
  <chapter number="22" style="c" sid="JOB 22"/>
  <para style="s1">الیفزؔ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 22:1"/>تَب اِلیفزؔ تیمانی نے جَواب دیا:<verse eid="JOB 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 22:2"/>”کیا کویٔی اِنسان خُدا کے کام آسکتا ہے؟</para>
  <para style="q2" vid="JOB 22:2">کیا کویٔی عقلمند اِنسان بھی اُسے فائدہ پہُنچا سَکتا ہے؟<verse eid="JOB 22:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 22:3"/>تمہارے راستباز ہونے سے قادرمُطلق کو کیا خُوشی ملے گی؟</para>
  <para style="q2" vid="JOB 22:3">اَور اگر تمہاری راہیں راست ہُوں تو اُنہیں کیا فائدہ؟<verse eid="JOB 22:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 22:4"/>”کیا وہ تمہاری پاک دامنی کے باعث تُمہیں ملامت کرتا،</para>
  <para style="q2" vid="JOB 22:4">اَور تُمہیں عدالت میں لاتا ہے؟<verse eid="JOB 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 22:5"/>کیا تمہاری بدی بڑی نہیں؟</para>
  <para style="q2" vid="JOB 22:5">اَور کیا تمہارے گُناہ غَیر محدُود نہیں؟<verse eid="JOB 22:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 22:6"/>تُم نے اَپنے بھائیوں سے بلاوجہ ضمانت طلب کی؛</para>
  <para style="q2" vid="JOB 22:6">تُم نے لوگوں کے کپڑے اُتار لیٔے اَور اُنہیں برہنہ کر دیا؟<verse eid="JOB 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 22:7"/>تُم نے تھکے ماندوں کو پانی نہ پِلایا</para>
  <para style="q2" vid="JOB 22:7">اَور بھُوکوں کو کھانے سے محروم رکھا،<verse eid="JOB 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 22:8"/>حالانکہ تُم ایک زبردست آدمی تھے، زمینوں کے مالک تھے،</para>
  <para style="q2" vid="JOB 22:8">اَور ایک باعزّت اِنسان کی طرح اُن میں بسے ہُوئے تھے۔<verse eid="JOB 22:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 22:9"/>اَور تُم نے بیواؤں کو خالی ہاتھ لَوٹایا</para>
  <para style="q2" vid="JOB 22:9">اَور یتیموں کے بازو توڑ دئیے۔<verse eid="JOB 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 22:10"/>اِسی لیٔے تمہارے چاروں طرف پھندے لگے ہُوئے ہیں،</para>
  <para style="q2" vid="JOB 22:10">اَور ناگہانی خطرے تُمہیں خوفزدہ کرتے ہیں،<verse eid="JOB 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 22:11"/>آخِر اِس قدر تاریکی کیوں ہے کہ تُم دیکھ نہیں پاتے،</para>
  <para style="q2" vid="JOB 22:11">اَور سیلاب تُمہیں بہا لے جاتا ہے۔<verse eid="JOB 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 22:12"/>”کیا آسمان کی بُلندیوں میں خُدا نہیں ہے؟</para>
  <para style="q2" vid="JOB 22:12">دیکھو، بُلند سِتارے کس قدر شان سے چمکتے ہیں!<verse eid="JOB 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 22:13"/>پھر بھی تُم کہتے ہو کہ خُدا کیا جانتے ہیں؟</para>
  <para style="q2" vid="JOB 22:13">کیا وہ اَیسے اَندھیرے میں سے دیکھ کر اِنصاف کرتے ہیں؟<verse eid="JOB 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 22:14"/>جَب وہ گُنبَدِ افلاک میں گشت لگاتے ہیں</para>
  <para style="q2" vid="JOB 22:14">اَور گھنے بادل اُنہیں گھیر لیتے ہیں، تو وہ ہمیں دیکھ نہیں سکتے۔<verse eid="JOB 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 22:15"/>کیا تُم اِسی پرانی راہ پر چلتے رہوگے</para>
  <para style="q2" vid="JOB 22:15">جِس پر بدکار لوگ چلتے آئے ہیں؟<verse eid="JOB 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 22:16"/>وہ وقت سے قبل ہی اُٹھا لیٔے گیٔے،</para>
  <para style="q2" vid="JOB 22:16">سیلاب اُن کی بُنیادیں بہا لے گیا۔<verse eid="JOB 22:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 22:17"/>اُنہُوں نے خُدا سے کہا: ’ہمیں آپ سے کویٔی مطلب نہیں!‘</para>
  <para style="q2" vid="JOB 22:17">آپ جو قادرمُطلق ہیں ہمارا کیا بِگاڑ سکتے ہیں؟<verse eid="JOB 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 22:18"/>پھر بھی اُن ہی نے اُن کے گھر نِعمتوں سے بھر دئیے،</para>
  <para style="q2" vid="JOB 22:18">بدکاروں کے منصُوبے میری سمجھ سے باہر ہیں۔<verse eid="JOB 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 22:19"/>صادق اُن کی بربادی دیکھ کر خُوش ہوتے ہیں؛</para>
  <para style="q2" vid="JOB 22:19">اَور بے قُصُور یہ کہہ کر اُن کی ہنسی اُڑاتے ہیں،<verse eid="JOB 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 22:20"/>ہمارے دُشمن واقعی تباہ ہو گئے،</para>
  <para style="q2" vid="JOB 22:20">اَور آگ نے اُن کے خزانے بھسم کر دئیے۔<verse eid="JOB 22:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 22:21"/>”خُدا کی اِطاعت کر اَور اُن کے ساتھ سلامتی سے رہو؛</para>
  <para style="q2" vid="JOB 22:21">اِس سے تمہارے پاس خُوشحالی آئے گی۔<verse eid="JOB 22:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 22:22"/>اُن کی ہدایات کو قبُول کرو</para>
  <para style="q2" vid="JOB 22:22">اَور اُن کے کلام کو اَپنے دِل میں جگہ دو۔<verse eid="JOB 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 22:23"/>اگر تُم قادرمُطلق سے رُجُوع ہوگے تو بحال کئے جاؤگے:</para>
  <para style="q2" vid="JOB 22:23">بشرطیکہ تُم بدی کو اَپنے خیمہ سے دُور کرو،<verse eid="JOB 22:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 22:24"/>اَور اَپنے خزانوں کو خاک،</para>
  <para style="q2" vid="JOB 22:24">اَور اَپنے اوفیرؔ<note caller="+" style="f"><char style="fr" closed="false">22‏:24 </char><char style="fq" closed="false">اوفیرؔ </char><char style="ft" closed="false">اوفیرؔ سے مُراد اَچھّے مِعیار کا سونا ہے۔ اوفیرؔ ایک جگہ کا نام تھا جو اَپنے سونے کے لیٔے مشہُور تھا۔</char></note> کے سونے کو وادی کے پتّھروں کے برابر سمجھو۔<verse eid="JOB 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 22:25"/>تَب قادرمُطلق تمہارا خزانہ ہوں گے،</para>
  <para style="q2" vid="JOB 22:25">اَور تمہارے لیٔے خالص چاندی بَن جائیں گے۔<verse eid="JOB 22:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 22:26"/>تَب قادرمُطلق کی صحبت تمہاری لذّت کا باعث ہوگی،</para>
  <para style="q2" vid="JOB 22:26">اَور تُم اَپنا مُنہ خُدا کی طرف اُٹھاؤگے۔<verse eid="JOB 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 22:27"/>تُم اُن سے دعا کروگے اَور وہ تمہاری سُنیں گے،</para>
  <para style="q2" vid="JOB 22:27">اَور تُم اَپنی مَنّتیں پُوری کروگے۔<verse eid="JOB 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 22:28"/>جِس بات کا اِرادہ کروگے وہ پُوری ہوگی،</para>
  <para style="q2" vid="JOB 22:28">اَور تمہاری راہیں رَوشن ہُوں گی۔<verse eid="JOB 22:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 22:29"/>جَب لوگ پست کئے جایٔیں گے اَور ’تُم کہو گے کہ اُنہیں سنبھالیں!‘</para>
  <para style="q2" vid="JOB 22:29">تو خُدا گِرے ہوؤں کو بچا لیں گے۔<verse eid="JOB 22:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 22:30"/>خُدا بے قُصُور کو بھی نَجات دیں گے،</para>
  <para style="q2" vid="JOB 22:30">وہ تمہارے ہاتھوں کی پاکیزگی کے باعث نَجات پایٔےگا۔“<verse eid="JOB 22:30"/></para>
  <chapter eid="JOB 22"/>
  <chapter number="23" style="c" sid="JOB 23"/>
  <para style="s1">ایُّوب</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 23:1"/>تَب ایُّوب نے جَواب دیا:<verse eid="JOB 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 23:2"/>”آج بھی میری شکایت تلخ ہے؛</para>
  <para style="q2" vid="JOB 23:2">میرے کراہنے کے باوُجُود، خُدا کا ہاتھ مُجھ پر بھاری ہوتا جا رہاہے۔<verse eid="JOB 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 23:3"/>کاش کہ میں جانتا کہ خُدا مُجھے کہاں مِل سکتے ہیں؛</para>
  <para style="q2" vid="JOB 23:3">کاش کہ میں اُن کے مَسکن تک جا سَکتا!<verse eid="JOB 23:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 23:4"/>میں اَپنا حال اُن کے سامنے بَیان کرتا،</para>
  <para style="q2" vid="JOB 23:4">اَور اَپنے مُنہ سے دلائل پیش کرتا۔<verse eid="JOB 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 23:5"/>میں پتہ لگاتاکہ وہ مُجھے کیا جَواب دیں گے،</para>
  <para style="q2" vid="JOB 23:5">اَورجو کچھ وہ کہتے اُس پر غور کرتا۔<verse eid="JOB 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 23:6"/>کیا وہ اَپنی عظیم قُدرت سے میرا مُقابلہ کریں گے؟</para>
  <para style="q2" vid="JOB 23:6">نہیں، وہ مُجھے مُلزم نہ گردانیں گے۔<verse eid="JOB 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 23:7"/>وہاں ایک راستباز آدمی اُن کے ساتھ بحث کر سَکتا ہے،</para>
  <para style="q2" vid="JOB 23:7">اَور مَیں اَپنے مُنصِف<note caller="+" style="f"><char style="fr" closed="false">23‏:7 </char><char style="fq" closed="false">مُنصِف </char><char style="ft" closed="false">خُدا</char></note> کے ہاتھ سے ہمیشہ کے لیٔے رِہائی پاؤں گا۔<verse eid="JOB 23:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 23:8"/>”لیکن اگر مَیں مشرق کو جاتا ہُوں تو وہ وہاں نہیں ملتے؛</para>
  <para style="q2" vid="JOB 23:8">اَور اگر مغرب کو جاتا ہُوں تو اُنہیں وہاں بھی نہیں پاتا۔<verse eid="JOB 23:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 23:9"/>جَب وہ شمال میں مصروف رہتے ہیں، میں اُنہیں دیکھ نہیں پاتا؛</para>
  <para style="q2" vid="JOB 23:9">اَور جَب وہ جُنوب کا رخ کرتے ہیں، میری نگاہ اُن پر نہیں پڑتی۔<verse eid="JOB 23:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 23:10"/>لیکن وہ اُن راہ سے واقف ہیں جِس پر میں چلتا ہُوں؛</para>
  <para style="q2" vid="JOB 23:10">جَب وہ مُجھے پرکھ چُکیں گے تو میں بھٹّی سے کندن بَن کر نکلوں گا۔<verse eid="JOB 23:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 23:11"/>میرے پاؤں اُن کے نقش قدم پر چلتے رہتے ہیں؛</para>
  <para style="q2" vid="JOB 23:11">مَیں اُن کی راہ سے نہیں ہٹا۔<verse eid="JOB 23:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 23:12"/>مَیں نے اُن کے لبوں کے اَحکام کو نہیں ٹالا؛</para>
  <para style="q2" vid="JOB 23:12">اَور اُن کے مُنہ کی باتوں کو اَپنی روز کی روٹی سے بھی زِیادہ عزیز سمجھا۔<verse eid="JOB 23:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 23:13"/>”لیکن وہ اَپنی مرضی کے مالک ہیں۔ کون اُن کا اِرادہ بدل سَکتا ہے؟</para>
  <para style="q2" vid="JOB 23:13">وہ جو چاہتے ہیں اُسے کرکے رہتے ہیں۔<verse eid="JOB 23:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 23:14"/>جو کچھ میرے لیٔے قوانین مُقرّر کیا گیا ہے، وہ اُسے پُورا ہونے دیں گے،</para>
  <para style="q2" vid="JOB 23:14">اَور اَیسے اَور بھی کیٔی اُمور اُن کے سامنے ہیں۔<verse eid="JOB 23:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 23:15"/>اِسی لیٔے میں اُن کے سامنے جانے سے ڈرتا ہُوں؛</para>
  <para style="q2" vid="JOB 23:15">جَب مَیں اِن سَب باتوں کو سوچتا ہُوں تو مُجھ پر لرزہ طاری ہو جاتا ہے<verse eid="JOB 23:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 23:16"/>خُدا نے مُجھے بُزدل بنا دیا؛</para>
  <para style="q2" vid="JOB 23:16">قادرمُطلق نے مُجھے ہِراساں کر دیا۔<verse eid="JOB 23:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 23:17"/>پھر بھی میری زندگی کا چراغ خاموش نہیں ہُوا،</para>
  <para style="q2" vid="JOB 23:17">اُنہُوں نے موت کی گھنی تاریکی کو مُجھ سے دُور کر رکھا ہے۔<verse eid="JOB 23:17"/></para>
  <para style="b"/>
  <chapter eid="JOB 23"/>
  <chapter number="24" style="c" sid="JOB 24"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 24:1"/>”قادرمُطلق نے عدالت کے اوقات کیوں مُقرّر نہیں کیٔے؟</para>
  <para style="q2" vid="JOB 24:1">جو اُن کو جانتے ہیں اُنہیں بھی اَیسے دِنوں کی خبر نہیں؟<verse eid="JOB 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 24:2"/>لوگ حُدوُد کے پتّھروں کو سرکاتے ہیں؛</para>
  <para style="q2" vid="JOB 24:2">وہ گلّوں کو ہانک لے جاتے ہیں اَور اُنہیں چَرانے لگتے ہیں۔<verse eid="JOB 24:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 24:3"/>وہ یتیم کا گدھا چُرا لے جاتے ہیں</para>
  <para style="q2" vid="JOB 24:3">اَور بِیوہ کا بَیل رہن رکھ لیتے ہیں۔<verse eid="JOB 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 24:4"/>وہ مُحتاج کو راہ سے ہٹا دیتے ہیں</para>
  <para style="q2" vid="JOB 24:4">اَور مُلک کے تمام غریب چھپتے پھرتے ہیں۔<verse eid="JOB 24:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 24:5"/>ویرانہ کے گورخروں کی طرح،</para>
  <para style="q2" vid="JOB 24:5">غُربا اَپنی خُوراک کی تلاش میں مارے مارے پھرتے ہیں؛</para>
  <para style="q2" vid="JOB 24:5">اَور بنجر زمین اُن کے بچّوں کو خُوراک بہم پہُنچاتی ہے۔<verse eid="JOB 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 24:6"/>وہ کھیتوں میں سے چارا کاٹتے ہیں</para>
  <para style="q2" vid="JOB 24:6">اَور بدکاروں کے لیٔے تاکستانوں کے انگور توڑتے ہیں۔<verse eid="JOB 24:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 24:7"/>کپڑے نہ ہونے کے باعث وہ رات بھر ننگے پڑے رہتے ہیں؛</para>
  <para style="q2" vid="JOB 24:7">اَور سردی سے بچنے کے لیٔے اُن کے پاس اوڑھنے کو کچھ نہیں ہوتا۔<verse eid="JOB 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 24:8"/>وہ پہاڑوں کی بارش سے بھیگتے ہیں</para>
  <para style="q2" vid="JOB 24:8">اَور کویٔی پناہ نہ مِلنے پر چٹّانوں سے لپٹ جاتے ہیں۔<verse eid="JOB 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 24:9"/>یتیم کا بچّہ چھاتی سے جُدا کر دیا جاتا ہے؛</para>
  <para style="q2" vid="JOB 24:9">اَور غریب کا بچّہ قرض کے عوض گروی رکھ لیا جاتا ہے۔<verse eid="JOB 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 24:10"/>وہ کپڑوں کے بغیر ننگے پھرتے رہتے ہیں؛</para>
  <para style="q2" vid="JOB 24:10">اَور پُولے ڈھوتے ہُوئے بھی بھُوکے رہتے ہیں۔<verse eid="JOB 24:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 24:11"/>وہ تیل نکالنے کے لیٔے چٹّانوں پر زَیتُون کُچلتے ہیں؛</para>
  <para style="q2" vid="JOB 24:11">وہ مے کے حوضوں کے انگور روند کر اُن کا رس نکالتے ہیں لیکن خُود پیاسے رہتے ہیں۔<verse eid="JOB 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 24:12"/>مرنے والوں کے کراہنے کی آوازیں شہر سے اُٹھتی ہیں،</para>
  <para style="q2" vid="JOB 24:12">اَور زخمیوں کی جانیں دہائی دیتی ہیں۔</para>
  <para style="q2" vid="JOB 24:12">تو بھی خُدا کسی کو بدی کا ذمّہ دار نہیں ٹھہراتا۔<verse eid="JOB 24:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 24:13"/>”اَیسے بھی لوگ ہیں جو نُور سے بغاوت کرتے ہیں،</para>
  <para style="q2" vid="JOB 24:13">اَور اُس کی راہوں کو نہیں جانتے</para>
  <para style="q2" vid="JOB 24:13">نہ اُس کے سامنے آتے ہیں۔<verse eid="JOB 24:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 24:14"/>شام ہوتے ہی خُونی اُٹھ کھڑا ہوتاہے</para>
  <para style="q2" vid="JOB 24:14">اَور غریب اَور مُحتاج کو قتل کرتا ہے؛</para>
  <para style="q2" vid="JOB 24:14">اَور رات کو چور کی طرح نقب لگاتاہے۔<verse eid="JOB 24:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 24:15"/>زناکار کی آنکھ شام کی منتظر رہتی ہے؛</para>
  <para style="q2" vid="JOB 24:15">’وہ سوچتا ہے کہ اُس وقت کسی کی نگاہ مُجھ پر نہ پڑےگی،‘</para>
  <para style="q2" vid="JOB 24:15">اَور وہ اَپنا چہرہ چُھپائے پھرتاہے۔<verse eid="JOB 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 24:16"/>اَندھیرے میں یہ لوگ گھروں میں جا گھُستے ہیں،</para>
  <para style="q2" vid="JOB 24:16">لیکن دِن نکلتے ہی چھُپ جاتے ہیں؛</para>
  <para style="q2" vid="JOB 24:16">اُنہیں نُور سے کویٔی سروکار نہیں۔<verse eid="JOB 24:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 24:17"/>اُن سَب کی صُبح موت کے سایہ کی مانند ہے؛</para>
  <para style="q2" vid="JOB 24:17">تَب اُنہیں پتہ چلتا ہے کہ موت کے سایہ کی دہشت کیسی ہوتی ہے۔<verse eid="JOB 24:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 24:18"/>”پھر بھی وہ پانی کی سطح پر کا جھاگ ہیں؛</para>
  <para style="q2" vid="JOB 24:18">زمین پر اُن کا حِصّہ ملعُون قرار دیا گیا ہے،</para>
  <para style="q2" vid="JOB 24:18">تاکہ کویٔی تاکستانوں کو نہ جائے۔<verse eid="JOB 24:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 24:19"/>جِس طرح گرمی اَور خُشکی پگھلتی ہُوئی برف کو ہڑپ لیتی ہے،</para>
  <para style="q2" vid="JOB 24:19">اُسی طرح قبر گُنہگاروں کو کھا جاتی ہے۔<verse eid="JOB 24:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 24:20"/>(ماں کا) رحم اُن کو بھلا دیتاہے،</para>
  <para style="q2" vid="JOB 24:20">اَور کیڑا اُنہیں مزے سے کھاتا ہے؛</para>
  <para style="q1" vid="JOB 24:20">بُرے لوگوں کو کویٔی یاد نہیں کرتا</para>
  <para style="q2" vid="JOB 24:20">بَلکہ وہ درخت کی طرح کاٹ ڈالے جاتے ہیں۔<verse eid="JOB 24:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 24:21"/>وہ بانجھ اَور بے اَولاد عورت کو نگل جاتے ہیں،</para>
  <para style="q2" vid="JOB 24:21">اَور بِیوہ کے ساتھ ہمدردی نہیں جتاتے۔<verse eid="JOB 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 24:22"/>لیکن خُدا اَپنی قُوّت سے سُورماؤں کو گھسیٹ لے جاتے ہیں؛</para>
  <para style="q2" vid="JOB 24:22">حالانکہ وہ مضبُوطی سے قائِم نظر آتے ہیں لیکن اُن کی زندگی کا کویٔی بھروسا نہیں۔<verse eid="JOB 24:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 24:23"/>حالانکہ وہ اُنہیں سلامتی سے جینے دیتے ہیں،</para>
  <para style="q2" vid="JOB 24:23">لیکن اُن کی آنکھیں اُن کی راہوں پر لگی رہتی ہیں۔<verse eid="JOB 24:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 24:24"/>چند لمحوں کے لیٔے وہ سرفراز کئے جاتے ہیں اَور پھر چل بستے ہیں؛</para>
  <para style="q2" vid="JOB 24:24">وہ پست کئے جاتے ہیں اَوروں کی طرح دفن کیٔے جاتے ہیں؛</para>
  <para style="q2" vid="JOB 24:24">اَور اناج کی بالوں کی طرح کاٹ ڈالے جاتے ہیں۔<verse eid="JOB 24:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 24:25"/>”اگر یہ یُوں نہیں ہے تو کویٔی ہے جو مُجھے جھُوٹا ثابت کرے</para>
  <para style="q2" vid="JOB 24:25">اَور میری باتوں کو فُضول ٹھہرائے۔“<verse eid="JOB 24:25"/></para>
  <chapter eid="JOB 24"/>
  <chapter number="25" style="c" sid="JOB 25"/>
  <para style="s1">بِلددؔ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 25:1"/>تَب بِلددؔ شوحی نے جَواب دیا:<verse eid="JOB 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 25:2"/>”خُدا سلطنت اَور دبدبہ کے مالک ہیں؛</para>
  <para style="q2" vid="JOB 25:2">وہ آسمان کی بُلندیوں میں اَمن قائِم رکھتے ہیں۔<verse eid="JOB 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 25:3"/>کیا اُن کے لشکروں<note caller="+" style="f"><char style="fr" closed="false">25‏:3 </char><char style="fq" closed="false">لشکروں </char><char style="ft" closed="false">یا فرشتوں</char></note> کی تعداد گنی جا سکتی ہے؟</para>
  <para style="q2" vid="JOB 25:3">وہ کون ہے جِس پر اُن کا سُورج نہیں چمکتا؟<verse eid="JOB 25:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 25:4"/>پھر اِنسان کیسے خُدا کے حُضُور راست ٹھہر سَکتا ہے؟</para>
  <para style="q2" vid="JOB 25:4">جو عورت سے پیدا ہُوا ہو وہ کیسے پاک ہو سَکتا ہے؟<verse eid="JOB 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 25:5"/>جَب چاند بھی رَوشن نہیں</para>
  <para style="q2" vid="JOB 25:5">اَور سِتارے اُن کی نظر میں پاک نہیں،<verse eid="JOB 25:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 25:6"/>پھر بھلا اِنسان کا کیا ذِکر جو محض کیڑا ہے،</para>
  <para style="q2" vid="JOB 25:6">ایک آدمؔ زاد چیونٹی سے زِیادہ حیثیت نہیں رکھتا!“<verse eid="JOB 25:6"/></para>
  <chapter eid="JOB 25"/>
  <chapter number="26" style="c" sid="JOB 26"/>
  <para style="s1">ایُّوب</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 26:1"/>تَب ایُّوب نے جَواب دیا:<verse eid="JOB 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 26:2"/>”تُم نے ایک بےبس اِنسان کی کیسی مدد کی!</para>
  <para style="q2" vid="JOB 26:2">اَور ایک ناتواں بازو کو کیسے سنبھالا!<verse eid="JOB 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 26:3"/>ایک نادان کو کیسی صلاح دی!</para>
  <para style="q2" vid="JOB 26:3">تُم نے کیسی عظیم دانائی کا مظاہرہ کیا!<verse eid="JOB 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 26:4"/>تُم نے یہ باتیں کہاں سے سیکھی ہیں؟</para>
  <para style="q2" vid="JOB 26:4">اَور کس کی رُوح تُم میں ہوکر بولی ہے؟<verse eid="JOB 26:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 26:5"/>”مُردوں کی رُوحیں سخت عذاب میں ہیں،</para>
  <para style="q2" vid="JOB 26:5">وہ جو پانی کے نیچے ہیں اَور وہ سَب جو اُس میں رہتے ہیں لرزاں ہیں۔<verse eid="JOB 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 26:6"/>پاتال خُدا کے سامنے بے حجاب ہے؛</para>
  <para style="q2" vid="JOB 26:6">جہنّم بے پردہ ہو چُکی ہے۔<verse eid="JOB 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 26:7"/>خُدا شمال کو خلا میں پھیلا دیتے ہیں؛</para>
  <para style="q2" vid="JOB 26:7">اَور زمین کو بغیر سہارے کے لٹکاتے ہیں۔<verse eid="JOB 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 26:8"/>وہ پانی کو اَپنے بادلوں میں سمیٹ لیتے ہیں،</para>
  <para style="q2" vid="JOB 26:8">پھر بھی بادل اُن کے بوجھ سے پھٹتے نہیں۔<verse eid="JOB 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 26:9"/>وہ ماہِ کامل کا چہرہ،</para>
  <para style="q2" vid="JOB 26:9">اَپنے بادل پھیلا کر ڈھانک لیتے ہیں۔<verse eid="JOB 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 26:10"/>اُنہُوں نے پانی کی سطح پر اُفق کا دائرہ بنا دیا ہے</para>
  <para style="q2" vid="JOB 26:10">تاکہ رَوشنی اَور تاریکی کے درمیان حَد قائِم ہو جائے۔<verse eid="JOB 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 26:11"/>آسمان کے سُتون</para>
  <para style="q2" vid="JOB 26:11">اُن کی تادیب سے لرزنے لگتے ہیں،<verse eid="JOB 26:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 26:12"/>اَپنی قُدرت سے اُنہُوں نے سمُندر کو موجزن کیا؛</para>
  <para style="q2" vid="JOB 26:12">اَور اَپنی حِکمت سے راحبؔ کے ٹکڑے ٹکڑے کر دئیے۔<verse eid="JOB 26:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 26:13"/>اُن کی پھُونک<note caller="+" style="f"><char style="fr" closed="false">26‏:13 </char><char style="fq" closed="false">پھُونک </char><char style="ft" closed="false">رُوح</char></note> سے آسمان صَاف ہو گئے؛</para>
  <para style="q2" vid="JOB 26:13">اُن کے ہاتھ نے بڑے سانپ<note caller="+" style="f"><char style="fr" closed="false">26‏:13 </char><char style="fq" closed="false">بڑے سانپ </char><char style="ft" closed="false">ڈریگن</char></note> کو چھیدا ہے۔<verse eid="JOB 26:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 26:14"/>لیکن یہ تو اُن کے عجائب کی ایک جھلک ہے؛</para>
  <para style="q2" vid="JOB 26:14">اُن کی آواز کس قدر دھیمی سُنایٔی دیتی ہے!</para>
  <para style="q2" vid="JOB 26:14">پھر بھلا اُن کی جبّاری کی گرج سُننے کی کس کو سمجھ ہوگی؟“<verse eid="JOB 26:14"/></para>
  <chapter eid="JOB 26"/>
  <chapter number="27" style="c" sid="JOB 27"/>
  <para style="s1">ایُّوب کا آخِری بَیان</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 27:1"/>اَور ایُّوب نے اَپنی تمثیل جاری رکھی:<verse eid="JOB 27:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 27:2"/>”زندہ خُدا کی قَسم جنہوں نے مُجھ سے اِنصاف نہیں کیا،</para>
  <para style="q2" vid="JOB 27:2">اُن قادرمُطلق کی قَسم جنہوں نے میری جان کو تلخ کیا،<verse eid="JOB 27:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 27:3"/>جَب تک میرے جِسم میں جان ہے،</para>
  <para style="q2" vid="JOB 27:3">اَور خُدا کا دَم میرے نتھنوں میں ہے،<verse eid="JOB 27:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 27:4"/>میرے ہونٹوں پر دغا کی بات نہ آئے گی،</para>
  <para style="q2" vid="JOB 27:4">اَور میری زبان سے فریب کی بات نہ نکلے گی۔<verse eid="JOB 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 27:5"/>مَیں کبھی تسلیم نہ کروں گا کہ تُم راستی پر ہو؛</para>
  <para style="q2" vid="JOB 27:5">میں مَرتے دَم تک اَپنی دیانتداری پر قائِم رہُوں گا۔<verse eid="JOB 27:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 27:6"/>میں اَپنی راستبازی برقرار رکھوں گا اَور اُسے ہرگز نہ چھوڑوں گا؛</para>
  <para style="q2" vid="JOB 27:6">جَب تک میں زندہ ہُوں میرا ضمیر مُجھے ملامت نہ کرےگا۔<verse eid="JOB 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 27:7"/>”میرے دُشمن بدکاروں کی مانند ہُوں،</para>
  <para style="q2" vid="JOB 27:7">اَور میرے مُخالف ناراستوں کی طرح!<verse eid="JOB 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 27:8"/>جَب خُدا کا مُنکر<note caller="+" style="f"><char style="fr" closed="false">27‏:8 </char><char style="fq" closed="false">خُدا کا مُنکر </char><char style="ft" closed="false">یہاں تک کہ جَب خُدا بے دین کو ختم کر دیتاہے۔</char></note> مرتا ہے اَور خُدا اُس کی رُوح قبض کر لیتا ہے،</para>
  <para style="q2" vid="JOB 27:8">تو اُس کی کویٔی اُمّید باقی نہیں رہتی۔<verse eid="JOB 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 27:9"/>جَب اُس پر مُصیبت آتی ہے،</para>
  <para style="q2" vid="JOB 27:9">تو کیا خُدا اُس کی فریاد سُنتے ہیں؟<verse eid="JOB 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 27:10"/>کیا وہ قادرمُطلق سے خُوش ہوگا؟</para>
  <para style="q2" vid="JOB 27:10">کیا وہ ہر گھڑی خُدا سے دعا کرےگا؟<verse eid="JOB 27:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 27:11"/>”میں تُمہیں خُدا کی قُدرت کی تعلیم دُوں گا؛</para>
  <para style="q2" vid="JOB 27:11">قادرمُطلق کے طریقے تُم سے نہ چھُپاؤں گا۔<verse eid="JOB 27:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 27:12"/>تُم سَب نے خُود دیکھ لیا ہے۔</para>
  <para style="q2" vid="JOB 27:12">پھر یہ فُضول باتیں کیوں کرتے ہو؟<verse eid="JOB 27:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 27:13"/>”خُدا کی طرف سے بدکار اِنسان کا اَیسا ہی حَشر ہوتاہے،</para>
  <para style="q2" vid="JOB 27:13">قادرمُطلق ظالموں کو اَیسی ہی مِیراث دیتے ہیں:<verse eid="JOB 27:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 27:14"/>اُس کے بچّے کتنے ہی زِیادہ ہُوں، وہ تلوار کا لقمہ بنیں گے؛</para>
  <para style="q2" vid="JOB 27:14">اُس کی اَولاد بھُوکی مَرے گی۔<verse eid="JOB 27:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 27:15"/>جو باقی بچیں گے اُنہیں وَبا دفن کر دے گی،</para>
  <para style="q2" vid="JOB 27:15">اَور اُن کی بیوائیں اُن کے لیٔے ماتم نہ کریں گی۔<verse eid="JOB 27:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 27:16"/>خواہ وہ مٹّی کی طرح چاندی کا ڈھیر لگا لے</para>
  <para style="q2" vid="JOB 27:16">اَور گارے کی طرح کپڑوں کا ذخیرہ کر لے،<verse eid="JOB 27:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 27:17"/>وہ جو بھی جمع کرےگا اُسے راستباز پہنے گا،</para>
  <para style="q2" vid="JOB 27:17">اَور بے قُصُور اُس کی چاندی بانٹ لیں گے۔<verse eid="JOB 27:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 27:18"/>جو گھر وہ بناتا ہے وہ مکڑی کے گھر کی مانند ہے،</para>
  <para style="q2" vid="JOB 27:18">گویا ایک چوکیدار کی جھوپڑی۔<verse eid="JOB 27:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 27:19"/>دولتمندی کے بِستر پر اُس کی نیند ختم ہونے والی ہے؛</para>
  <para style="q2" vid="JOB 27:19">جَب اُس کی آنکھ کھُلے گی تو سَب کچھ جاچُکا ہوگا۔<verse eid="JOB 27:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 27:20"/>اُسے دہشتیں سیلاب کی طرح آ پکڑتی ہیں؛</para>
  <para style="q2" vid="JOB 27:20">رات کو طُوفان اُسے جھپٹ لیتا ہے۔<verse eid="JOB 27:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 27:21"/>مشرقی ہَوا اُسے اُڑا لے جاتی ہے اَور وہ جاتا رہتاہے؛</para>
  <para style="q2" vid="JOB 27:21">وہ اُسے اَپنی جگہ سے اُکھاڑ پھینکتی ہے۔<verse eid="JOB 27:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 27:22"/>وہ ہَوا<note caller="+" style="f"><char style="fr" closed="false">27‏:22 </char><char style="fq" closed="false">ہَوا </char><char style="ft" closed="false">خُدا</char></note> اُسے نہایت ہی بے رحمی سے اُکھاڑ پھیکتی ہے</para>
  <para style="q2" vid="JOB 27:22">جَیسے ہی وہ اُس کی زد سے بھاگنے کی کوشش کرتا ہے<verse eid="JOB 27:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 27:23"/>لوگ تالیاں بجا کر اُس کا مذاق اُڑاتے ہیں</para>
  <para style="q2" vid="JOB 27:23">اَور اُسے اُس کی جگہ سے دُور کھدیڑ دیتی ہے۔<verse eid="JOB 27:23"/></para>
  <chapter eid="JOB 27"/>
  <chapter number="28" style="c" sid="JOB 28"/>
  <para style="s1">درمیانی وفقہ: حِکمت کی بابت بَیان</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 28:1"/>چاندی کی کان ہوتی ہے</para>
  <para style="q2" vid="JOB 28:1">اَور سونے کی بھٹّی جہاں وہ کندن بنتا ہے۔<verse eid="JOB 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 28:2"/>لوہا زمین سے نکالا جاتا ہے،</para>
  <para style="q2" vid="JOB 28:2">اَور کانسے کچّی دھات میں سے گلایا جاتا ہے۔<verse eid="JOB 28:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 28:3"/>اِنسان تاریکی کی تہہ تک پہُنچتا ہے؛</para>
  <para style="q2" vid="JOB 28:3">اَور سنگریزوں کی جُستُجو میں</para>
  <para style="q2" vid="JOB 28:3">ظلمات کے گوشہ گوشہ کو چھان ڈالتا ہے۔<verse eid="JOB 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 28:4"/>وہ آبادی سے دُور کے اَیسی قِیام گاہوں میں سرنگ لگاتاہے،</para>
  <para style="q2" vid="JOB 28:4">جہاں آنے جانے والوں کے قدم نہیں پہُنچ پاتے؛</para>
  <para style="q2" vid="JOB 28:4">لوگوں سے دُور وہ جھولتا اَور لٹکتا ہے۔<verse eid="JOB 28:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 28:5"/>زمین جِس میں سے اناج اُگتا ہے،</para>
  <para style="q2" vid="JOB 28:5">اَندر ہی اَندر پلٹ دی جاتی ہے گویا اُس میں آگ لگ گئی ہو؛<verse eid="JOB 28:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 28:6"/>زمین کے پتّھروں میں نیلم،</para>
  <para style="q2" vid="JOB 28:6">اَور زمین کی خاک میں سونے کے ذرّے ملتے ہیں۔<verse eid="JOB 28:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 28:7"/>کویٔی شِکاری پرندہ وہ خُفیہ راہ نہیں جانتا،</para>
  <para style="q2" vid="JOB 28:7">نہ کسی باز کی آنکھ نے اُسے دیکھاہے۔<verse eid="JOB 28:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 28:8"/>درندے اُس پر قدم نہیں مارتے،</para>
  <para style="q2" vid="JOB 28:8">نہ کویٔی خُونخوار شیر اُدھر سے گزرتا ہے۔<verse eid="JOB 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 28:9"/>اِنسان کا ہاتھ چقماق کی چٹّان کو توڑ ڈالتا ہے،</para>
  <para style="q2" vid="JOB 28:9">اَور پہاڑوں کو جڑ سے اُلٹ دیتاہے۔<verse eid="JOB 28:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 28:10"/>وہ چٹّانوں میں سے سُرنگ کھودتا ہے؛</para>
  <para style="q2" vid="JOB 28:10">اُن کی آنکھیں اُن کے تمام خزانوں کو دیکھ لیتی ہیں۔<verse eid="JOB 28:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 28:11"/>وہ دریاؤں کے منبعوں کو کھوج نکالتے ہیں</para>
  <para style="q2" vid="JOB 28:11">اَور خُفیہ اَشیا رَوشنی میں لاتے ہیں۔<verse eid="JOB 28:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 28:12"/>”لیکن حِکمت کہاں مِل سکتی ہے؟</para>
  <para style="q2" vid="JOB 28:12">اَور سمجھ کہاں بستی ہے؟<verse eid="JOB 28:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 28:13"/>اِنسان اُن کی قدر و قیمت کا ادراک نہیں کر سَکتا:</para>
  <para style="q2" vid="JOB 28:13">وہ زندوں کی سرزمین میں نہیں پائی جاتی۔<verse eid="JOB 28:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 28:14"/>گہراؤ کہتاہے، ”وہ مُجھ میں نہیں“؛</para>
  <para style="q2" vid="JOB 28:14">اَور سمُندر کہتاہے، ”وہ میرے پاس نہیں ہے“؛<verse eid="JOB 28:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 28:15"/>اُسے خالص سونے سے خریدا نہیں جا سَکتا،</para>
  <para style="q2" vid="JOB 28:15">نہ ہی اُس کی قیمت چاندی سے اَدا کی جا سکتی ہے۔<verse eid="JOB 28:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 28:16"/>اوفیرؔ کے سونے سے اُس کی قیمت اَدا نہیں کی جا سکتی،</para>
  <para style="q2" vid="JOB 28:16">نہ ہی قیمتی سنگِ سُلیمانی اَور نیلم سے۔<verse eid="JOB 28:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 28:17"/>نہ سونا نہ بِلّوری شیشہ سے اُس کا مُقابلہ کیا جا سَکتا ہے،</para>
  <para style="q2" vid="JOB 28:17">نہ ہی اُسے جواہرات کے عوض حاصل کیا جا سَکتا ہے۔<note caller="+" style="f"><char style="fr" closed="false">28‏:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 8:10">امثا 8‏:10</ref>‏</char></char></note><verse eid="JOB 28:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 28:18"/>مرجان اَور بِلّور ناقابل ذِکر ہیں؛</para>
  <para style="q2" vid="JOB 28:18">حِکمت کی قیمت سنگِ یَشب سے کہیں زِیادہ ہے۔<verse eid="JOB 28:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 28:19"/>کُوشؔ کا پکھراج اُس کی برابری نہیں کر سَکتا؛</para>
  <para style="q2" vid="JOB 28:19">نہ ہی خالص سونے سے اُس کا مول ہو سَکتا ہے۔<note caller="+" style="f"><char style="fr" closed="false">28‏:19 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 8:19">امثا 8‏:19</ref>‏</char></char></note><verse eid="JOB 28:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 28:20"/>پھر، حِکمت کہاں سے آتی ہے؟</para>
  <para style="q2" vid="JOB 28:20">اَور سمجھ کہاں بستی ہے؟<verse eid="JOB 28:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 28:21"/>وہ ہر جاندار کی نگاہ سے پوشیدہ ہے،</para>
  <para style="q2" vid="JOB 28:21">ہَوا کے پرندوں سے بھی چھُپائی گئی ہے۔<verse eid="JOB 28:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 28:22"/>تباہی اَور موت یہ کہتے ہیں،</para>
  <para style="q2" vid="JOB 28:22">”اُس کی محض افواہ ہی ہمارے کانوں تک پہُنچی ہے۔“<note caller="+" style="f"><char style="fr" closed="false">28‏:22 </char><char style="ft" closed="false"><char style="xt"><ref loc="REV 9:11">مُکا 9‏:11</ref>‏</char></char></note><verse eid="JOB 28:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 28:23"/>خُدا اُس تک جانے والی راہ جانتے ہیں</para>
  <para style="q2" vid="JOB 28:23">اَور صِرف وُہی اُس کے مقام سے واقف ہیں،<verse eid="JOB 28:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 28:24"/>کیونکہ وہ زمین کی اِنتہا تک نظر کرتے ہیں</para>
  <para style="q2" vid="JOB 28:24">اَور آسمان کے نیچے کی ہر چیز کو بھی دیکھتے ہیں۔<note caller="+" style="f"><char style="fr" closed="false">28‏:24 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 11:4">زبُور 11‏:4</ref>‏</char></char></note><verse eid="JOB 28:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 28:25"/>جَب اُنہُوں نے ہَوا کا دباؤ مُقرّر کیا</para>
  <para style="q2" vid="JOB 28:25">اَور پانی کو پیمانہ سے ناپا،<verse eid="JOB 28:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 28:26"/>جَب اُنہُوں نے مینہ کے لیٔے حُکم جاری کیا</para>
  <para style="q2" vid="JOB 28:26">اَور برق و رَعد کی راہ مُقرّر کی،<verse eid="JOB 28:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 28:27"/>تَب اُنہُوں نے حِکمت پر نظر کی اَور اُس کا جائزہ لیا؛</para>
  <para style="q2" vid="JOB 28:27">اُسے قائِم کیا اَور اُسے پرکھا۔<verse eid="JOB 28:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 28:28"/>اَور خُدا نے اِنسان سے فرمایا،</para>
  <para style="q2" vid="JOB 28:28">”دیکھو، یَاہوِہ کا خوف ہی حِکمت ہے،</para>
  <para style="q2" vid="JOB 28:28">اَور بدی سے دُور رہنا دانشمندی ہے۔“<note caller="+" style="f"><char style="fr" closed="false">28‏:28 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 4:6">اِست 4‏:6</ref>‏</char></char></note><verse eid="JOB 28:28"/></para>
  <chapter eid="JOB 28"/>
  <chapter number="29" style="c" sid="JOB 29"/>
  <para style="s1">ایُّوب کا آخِری دفاع</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 29:1"/>ایُّوب نے اَپنی تمثیل جاری رکھی:<verse eid="JOB 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 29:2"/>”کاش میرے وہ گزرے مہینے پھر سے لَوٹ آئیں،</para>
  <para style="q2" vid="JOB 29:2">خصوصاً وہ دِن جَب خُدا میرے مُحافظ تھے،<verse eid="JOB 29:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 29:3"/>جَب خُدا کا چراغ میرے سَر پرروشن تھا</para>
  <para style="q2" vid="JOB 29:3">اَور اُن ہی کا نُور تاریکی میں میری رہنمائی کرتا تھا!<verse eid="JOB 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 29:4"/>آہ میں اُن دِنوں کے لئے ترستا ہُوں جَب میرا عالمِ شباب تھا،</para>
  <para style="q2" vid="JOB 29:4">جَب میرا خیمہ خُدا کی رِفاقت کے سایہ میں تھا،<verse eid="JOB 29:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 29:5"/>جَب قادرمُطلق ہُنوز میرے ساتھ تھے</para>
  <para style="q2" vid="JOB 29:5">اَور میرے بچّے مُجھے گھیرے رہتے تھے،<verse eid="JOB 29:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 29:6"/>جَب میرے پاؤں مکھّن سے دھوئے جاتے تھے</para>
  <para style="q2" vid="JOB 29:6">اَور چٹّانیں میرے لیٔے زَیتُون کے تیل کی دریا بہاتی تھیں۔<verse eid="JOB 29:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 29:7"/>”جَب مَیں شہر کے پھاٹک<note caller="+" style="f"><char style="fr" closed="false">29‏:7 </char><char style="fq" closed="false">شہر کے پھاٹک </char><char style="ft" closed="false">مُراد شہر کی دیوار کے اَندر، شہر کے دروازوں کے قریب کھُلا علاقہ ہے، جہاں شہر کی انتظامیہ کے اِجلاس منعقّد ہوتے تھے (<char style="xt"><ref loc="DEU 21:19">اِست 21‏:19</ref>‏</char>) قانُونی لین دین (<char style="xt"><ref loc="RUT 4:1">رُوتؔ 4‏:1</ref>‏،<ref loc="RUT 4:11">11</ref>‏</char>) یا بازار <char style="xt"><ref loc="2KI 7:1">2 سلا 7‏:1</ref>؛ <ref loc="2KI 18">18</ref>‏</char></char></note> پر جاتا تھا</para>
  <para style="q2" vid="JOB 29:7">اَور چَوک میں اَپنی نشست سنبھالتا تھا،<verse eid="JOB 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 29:8"/>تو جَوان مُجھے دیکھ کر پرے ہٹ جاتے تھے</para>
  <para style="q2" vid="JOB 29:8">اَور عمر رسیدہ لوگ اُٹھ کر کھڑے ہو جاتے تھے؛<verse eid="JOB 29:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 29:9"/>اُمرا خاموش ہو جاتے تھے</para>
  <para style="q2" vid="JOB 29:9">اَور اَپنے ہاتھ مُنہ پر رکھ لیتے تھے؛<verse eid="JOB 29:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 29:10"/>اُمرا چُپ سادھ لیتے تھے،</para>
  <para style="q2" vid="JOB 29:10">اَور اُن کی زبان تالُو سے چپک جاتی تھی۔<verse eid="JOB 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 29:11"/>جو میری بات سُنتا تھا ’مُجھے داد دیتا تھا،‘</para>
  <para style="q2" vid="JOB 29:11">اَورجو دیکھتا تھا میری تعریف کرتا تھا،<verse eid="JOB 29:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 29:12"/>کیونکہ جَب کویٔی غریب فریاد کرتا تو میں اُس کی دادرسی کرتا تھا،</para>
  <para style="q2" vid="JOB 29:12">اَور یتیم کی بھی، جِس کا کویٔی مددگار نہ ہوتا تھا۔<verse eid="JOB 29:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 29:13"/>دَم توڑتا ہُوا آدمی مُجھے دعا دیتا تھا؛</para>
  <para style="q2" vid="JOB 29:13">میں بِیوہ کے دِل کو شادمان کرتا تھا۔<verse eid="JOB 29:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 29:14"/>مَیں نے راستی کا لباس پہن رکھا تھا؛</para>
  <para style="q2" vid="JOB 29:14">اِنصاف میرا جُبّہ اَور عمامہ تھا۔<verse eid="JOB 29:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 29:15"/>میں اَندھوں کے لیٔے آنکھیں تھا</para>
  <para style="q2" vid="JOB 29:15">اَور لنگڑوں کے لیٔے پاؤں۔<verse eid="JOB 29:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 29:16"/>میں مُحتاجوں کے لیٔے باپ کی طرح تھا؛</para>
  <para style="q2" vid="JOB 29:16">اَور پردیسیوں کے مسائل حل کرتا تھا۔<verse eid="JOB 29:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 29:17"/>میں بدکاروں کے جبڑے توڑ ڈالتا تھا</para>
  <para style="q2" vid="JOB 29:17">اَور شِکار کو اُن کے دانتوں میں سے کھینچ نکالتا تھا۔<verse eid="JOB 29:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 29:18"/>”میرا خیال تھا کہ میں اَپنے ہی گھر میں مروں گا،</para>
  <para style="q2" vid="JOB 29:18">اَور میرے دِن ریت کے ذرّوں کی طرح لاتعداد ہوں گے۔<verse eid="JOB 29:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 29:19"/>میری جڑیں پانی تک پھیل جایٔیں گی،</para>
  <para style="q2" vid="JOB 29:19">اَور رات بھر میری شاخیں اوس سے تر رہیں گی۔<verse eid="JOB 29:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 29:20"/>میری عظمت مُجھ میں تازہ رہے گی،</para>
  <para style="q2" vid="JOB 29:20">میرے ہاتھ میں ہمیشہ نئی کمان رہے گی۔<verse eid="JOB 29:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 29:21"/>”لوگ مُجھے سُننے کے متمنّی رہتے تھے،</para>
  <para style="q2" vid="JOB 29:21">اَور میری مشورت کا اِنتظار کرتے تھے۔<verse eid="JOB 29:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 29:22"/>میرے بولنے کے بعد وہ پھر نہ بولتے تھے؛</para>
  <para style="q2" vid="JOB 29:22">میری باتیں اُن کے کانوں پر بار نہ ہوتی تھیں۔<verse eid="JOB 29:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 29:23"/>وہ میرا اَیسا اِنتظار کرتے تھے، جَیسے بارش کا،</para>
  <para style="q2" vid="JOB 29:23">اَور میرے الفاظ اَیسے پی لیتے تھے جَیسے وہ بہار کی بارش کے قطرے ہیں۔<verse eid="JOB 29:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 29:24"/>جَب مَیں اُن پر مُسکراتا تھا تو وہ مُشکل سے یقین کرتے تھے؛</para>
  <para style="q2" vid="JOB 29:24">میرے چہرے کی بشاشت ہی اُن کے لیٔے بیش قیمتی شَے تھی۔<verse eid="JOB 29:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 29:25"/>میں اُن کے لیٔے راہ چُنتا اَور اُن کے پیشوا کی حیثیت سے بیٹھتا تھا؛</para>
  <para style="q2" vid="JOB 29:25">میں اَیسے رہتا تھا جَیسے بادشاہ اَپنی فَوج میں؛</para>
  <para style="q2" vid="JOB 29:25">اَور مَیں غمزدہ کو تسلّی دیتا تھا۔<verse eid="JOB 29:25"/></para>
  <para style="b"/>
  <chapter eid="JOB 29"/>
  <chapter number="30" style="c" sid="JOB 30"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 30:1"/>”لیکن اَب وہ لوگ میرا مذاق اُڑاتے ہیں،</para>
  <para style="q2" vid="JOB 30:1">جو عمر میں مُجھ سے چُھوٹے ہیں،</para>
  <para style="q1" vid="JOB 30:1">اَور جِن کے آباؤاَجداد کو میں</para>
  <para style="q2" vid="JOB 30:1">اَپنے گلّہ کے کُتّوں کے ساتھ بھی رکھنا پسند نہ کرتا۔<verse eid="JOB 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 30:2"/>اُن کے ہاتھوں کی قُوّت میرے کس کام کی تھی،</para>
  <para style="q2" vid="JOB 30:2">جَب کہ اُن کی قُوّت جاتی رہی تھی؟<verse eid="JOB 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 30:3"/>افلاس اَور بھُوک سے بدحال ہوکر،</para>
  <para style="q2" vid="JOB 30:3">وہ گرم اَور خشک زمین پر</para>
  <para style="q2" vid="JOB 30:3">ویران، بنجر اَور تاریک مقاموں میں مارے مارے پھرتے تھے۔<verse eid="JOB 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 30:4"/>وہ گھنی جھاڑیوں میں سے نمکین ترکاری جمع کرتے تھے،</para>
  <para style="q2" vid="JOB 30:4">اَور جھاؤ کی جڑیں اُن کی غِذا تھیں۔<verse eid="JOB 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 30:5"/>وہ اَپنے مُعاشرے سے باہر نکال دئیے گئے،</para>
  <para style="q2" vid="JOB 30:5">لوگ اُن پر اَیسے چِلاّتے تھے جَیسا کہ وہ چور ہُوں۔<verse eid="JOB 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 30:6"/>اُنہیں سُوکھے دریاؤں کے راستوں میں،</para>
  <para style="q2" vid="JOB 30:6">چٹّانوں کے درمیان اَور زمین کے بھٹّوں میں رہنے پر مجبُور کیا جاتا تھا۔<verse eid="JOB 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 30:7"/>وہ جھاڑیوں کے درمیان رینکتے</para>
  <para style="q2" vid="JOB 30:7">اَور گھاس پھُوس میں اِدھر اُدھر پڑے رہتے تھے۔<verse eid="JOB 30:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 30:8"/>احمقوں اَور کمینوں کی طرح،</para>
  <para style="q2" vid="JOB 30:8">وہ زمین سے بے دخل کر دئیے گئے۔<verse eid="JOB 30:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 30:9"/>”اَور اَب اُن کے بیٹے مُجھ پر آوازے کستے ہیں؛</para>
  <para style="q2" vid="JOB 30:9">میں اُن کے لیٔے ضرب المثل بَن گیا ہُوں۔<verse eid="JOB 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 30:10"/>اُنہیں مُجھ سے گھِن آتی ہے اَور وہ مُجھ سے دُور کھڑے رہتے ہیں؛</para>
  <para style="q2" vid="JOB 30:10">اَور میرے مُنہ پر تھُوکنے سے نہیں ہچکچاتے۔<verse eid="JOB 30:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 30:11"/>اَب جَب کہ خُدا نے میری کمان ڈھیلی کر دی اَور مُجھے لاچار بنا دیا ہے،</para>
  <para style="q2" vid="JOB 30:11">اِس لیٔے وہ میرے سامنے بے لگام ہو گئے ہیں۔<verse eid="JOB 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 30:12"/>میری داہنی طرف سے ایک گِروہ دھاوا بولتا ہے؛</para>
  <para style="q2" vid="JOB 30:12">وہ میرے پاؤں کے لیٔے پھندا ڈالتے ہیں،</para>
  <para style="q2" vid="JOB 30:12">وہ میرا محاصرہ کر لینا چاہتے ہیں۔<verse eid="JOB 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 30:13"/>وہ میرے راستے کو بگاڑتے ہیں؛</para>
  <para style="q2" vid="JOB 30:13">اَور مُجھے تباہی اَور بربادی کی طرف لے جانا چاہتے ہیں،</para>
  <para style="q2" vid="JOB 30:13">گویا میرا کویٔی مددگار نہیں۔<verse eid="JOB 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 30:14"/>وہ اَیسے بڑھتے ہیں جَیسے کسی بڑے شگاف میں سے باہر نکلے ہیں؛</para>
  <para style="q2" vid="JOB 30:14">اَور کھنڈروں میں لُڑکتے ہُوئے آئے ہیں۔<verse eid="JOB 30:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 30:15"/>مُجھ پر دہشت طاری ہے؛</para>
  <para style="q2" vid="JOB 30:15">میری عظمت جا چُکی ہے جَیسے ہَوا اُسے اُڑا لے گئی ہو،</para>
  <para style="q2" vid="JOB 30:15">میری سلامتی بادل کی طرح غائب ہو چُکی ہے۔<verse eid="JOB 30:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 30:16"/>”اَور اَب میری جان نکلنے کو ہے؛</para>
  <para style="q2" vid="JOB 30:16">دُکھ کے دِنوں نے مُجھے جکڑ لیا ہے۔<verse eid="JOB 30:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 30:17"/>رات میری ہڈّیاں چھید ڈالتی ہے؛</para>
  <para style="q2" vid="JOB 30:17">درد جو مُجھے کھائے جا رہے ہیں، کبھی دَم نہیں لیتے۔<verse eid="JOB 30:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 30:18"/>اَپنی عظیم قُدرت میں خُدا میرے لیٔے پوشاک بَن جاتے ہیں</para>
  <para style="q2" vid="JOB 30:18">اَور میرا پیراہن مُجھے گریبان کی طرح لپیٹ لیتا ہے۔<verse eid="JOB 30:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 30:19"/>مُجھے کیچڑ میں پھینک دیا گیا ہے،</para>
  <para style="q2" vid="JOB 30:19">اَور مَیں خاک اَور راکھ بَن کر رہ گیا ہُوں۔<verse eid="JOB 30:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 30:20"/>”مَیں آپ سے فریاد کرتا ہُوں اَے خُدا، لیکن آپ جَواب نہیں دیتے؛</para>
  <para style="q2" vid="JOB 30:20">میں کھڑا ہوتا ہُوں لیکن آپ پروا بھی نہیں کرتے۔<verse eid="JOB 30:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 30:21"/>آپ مُجھ سے سنگدلی سے پیش آتے ہیں؛</para>
  <para style="q2" vid="JOB 30:21">اَپنے بازو کی قُوّت سے آپ مُجھ پر ٹوٹ پڑتے ہیں۔<verse eid="JOB 30:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 30:22"/>آپ مُجھے اُوپر اُٹھاکر ہَوا پر سوار کر دیتے ہیں؛</para>
  <para style="q2" vid="JOB 30:22">اَور طُوفان میں اُچھالتے ہیں۔<verse eid="JOB 30:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 30:23"/>میں جانتا ہُوں کہ آپ مُجھے موت تک پہُنچا دیں گے،</para>
  <para style="q2" vid="JOB 30:23">اُس جگہ تک جو سَب جانداروں کے لیٔے مُقرّر ہے۔<verse eid="JOB 30:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 30:24"/>”جَب کویٔی پست ہمّت اِنسان دُکھ کی حالت میں مدد کے لیٔے پُکارتا ہے،</para>
  <para style="q2" vid="JOB 30:24">تو کویٔی بھی اُس کی طرف مدد کا ہاتھ نہیں بڑھاتا۔<verse eid="JOB 30:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 30:25"/>کیا میں دردمند کے لیٔے نہیں رُویا؟</para>
  <para style="q2" vid="JOB 30:25">کیا میری جان غریب کے لیٔے آزردہ نہیں ہُوئی؟<verse eid="JOB 30:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 30:26"/>پھر بھی جَب مَیں نے بھلائی کی تمنّا کی بُرائی آئی؛</para>
  <para style="q2" vid="JOB 30:26">جَب مَیں نے رَوشنی کی توقع رکھی تو تاریکی چلی آئی۔<verse eid="JOB 30:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 30:27"/>میرے اَندر اُٹھا ہُوا طُوفان تھما ہی نہیں؛</para>
  <para style="q2" vid="JOB 30:27">مُصیبت کے دِن میرے سامنے ہیں۔<verse eid="JOB 30:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 30:28"/>میں کالا پڑتا جا رہا ہُوں، لیکن دھوپ سے نہیں؛</para>
  <para style="q2" vid="JOB 30:28">میں مجمع میں کھڑا ہوکر مدد کے لیٔے دہائی دیتا ہُوں۔<verse eid="JOB 30:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 30:29"/>میں گیدڑوں کا بھایٔی بَن گیا ہُوں،</para>
  <para style="q2" vid="JOB 30:29">اَور شتر مرغوں کا ساتھی۔<verse eid="JOB 30:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 30:30"/>میری جلد کالی پڑ گئی ہے اَور اُتری جا رہی ہے؛</para>
  <para style="q2" vid="JOB 30:30">میرا جِسم بُخار سے جَل رہاہے۔<verse eid="JOB 30:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 30:31"/>میری بربط سے ماتم کی دھُن،</para>
  <para style="q2" vid="JOB 30:31">اَور میری بانسری سے آہ و زاری کی آواز سُنایٔی دیتی ہے۔<verse eid="JOB 30:31"/></para>
  <para style="b"/>
  <chapter eid="JOB 30"/>
  <chapter number="31" style="c" sid="JOB 31"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 31:1"/>”مَیں نے اَپنی آنکھوں سے عہد کیا</para>
  <para style="q2" vid="JOB 31:1">کہ میں کسی جَوان لڑکی کو بُری نگاہ سے نہ دیکھوں گا۔<verse eid="JOB 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 31:2"/>بھلا خُدا کی طرف سے ہمیں کیا ورثہ نصیب ہوتاہے،</para>
  <para style="q2" vid="JOB 31:2">اَور عالی مقام میں قادرمُطلق کی طرف سے ہماری مِیراث کیا ہے؟<verse eid="JOB 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 31:3"/>کیا بدکار کے لیٔے بربادی،</para>
  <para style="q2" vid="JOB 31:3">اَور بدکاروں کے لیٔے تباہی نہیں؟<verse eid="JOB 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 31:4"/>کیا خُدا میری راہوں کو نہیں دیکھتا</para>
  <para style="q2" vid="JOB 31:4">اَور میرا ہر قدم شُمار نہیں کرتا؟<verse eid="JOB 31:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 31:5"/>”اگر مَیں بطالت کی راہ پر چلا ہُوں،</para>
  <para style="q2" vid="JOB 31:5">یا میرا پاؤں دغا کی طرف عجلت سے بڑھا ہو،<verse eid="JOB 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 31:6"/>تو خُدا مُجھے صحیح ترازو میں تو لیں۔</para>
  <para style="q2" vid="JOB 31:6">تاکہ وہ جان لیں کہ میں بےگُناہ ہُوں۔<verse eid="JOB 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 31:7"/>اگر میرے قدم راہ سے بھٹک گیٔے ہُوں،</para>
  <para style="q2" vid="JOB 31:7">اگر میرے دِل نے میری آنکھوں کی پیروی کی ہو،</para>
  <para style="q2" vid="JOB 31:7">یا اگر میرے ہاتھ آلُودہ ہُوں،<verse eid="JOB 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 31:8"/>تَب جو مَیں نے بویا اُسے دُوسرے کھایٔیں،</para>
  <para style="q2" vid="JOB 31:8">اَور میری فصلیں اُکھاڑ دی جایٔیں۔<verse eid="JOB 31:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 31:9"/>”اگر میرا دِل کسی عورت پر فریفتہ ہُوا ہو،</para>
  <para style="q2" vid="JOB 31:9">یا میں اَپنے پڑوسی کے دروازہ پر گھات میں بیٹھا ہُوں،<verse eid="JOB 31:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 31:10"/>تو میری بیوی دُوسرے شخص کا اناج پیسے،</para>
  <para style="q2" vid="JOB 31:10">اَور غَیر مَرد اُس کے ساتھ سوئیں۔<verse eid="JOB 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 31:11"/>کیونکہ یہ بڑی شرمناک بات ہوتی،</para>
  <para style="q2" vid="JOB 31:11">ایک اَیسا گُناہ ہوتا جسے حِساب میں لایا جاتا۔<verse eid="JOB 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 31:12"/>اَیسی آگ جو جَلا کر بھسم کردیتی؛</para>
  <para style="q2" vid="JOB 31:12">اُس نے میری تیّار فصل کو جڑ سے اُکھاڑ دیا ہوتا۔<verse eid="JOB 31:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 31:13"/>”اگر مَیں نے اَپنے خادِم یا خادِمہ سے نااِنصافی کی ہو</para>
  <para style="q2" vid="JOB 31:13">جَب اُنہیں مُجھ سے کویٔی شکایت تھی،<verse eid="JOB 31:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 31:14"/>تو خُدا کے سامنے میں کیا کروں گا؟</para>
  <para style="q2" vid="JOB 31:14">جَب بازپُرس ہوگی تو میں کیا جَواب دُوں گا؟<verse eid="JOB 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 31:15"/>کیا اُن ہی خُدا نے اُنہیں نہیں بنایا جنہوں نے مُجھے رحم میں بنایا؟</para>
  <para style="q2" vid="JOB 31:15">کیا اُن ہی نے ہمیں اَپنی اَپنی ماؤں کے اَندر تشکیل نہیں کیا؟<verse eid="JOB 31:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 31:16"/>”اگر مَیں نے مُحتاجوں کے مطالبے ٹھکرائے ہُوں</para>
  <para style="q2" vid="JOB 31:16">یا کسی بِیوہ کی آنکھوں کو ترسایا ہو،<verse eid="JOB 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 31:17"/>اگر مَیں فقط اَپنا ہی پیٹ بھرتا رہا،</para>
  <para style="q2" vid="JOB 31:17">اَور کبھی کسی یتیم کو روٹی تک نہ دی،<verse eid="JOB 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 31:18"/>لیکن مَیں اَپنی جَوانی سے ہی اُسے باپ کی طرح پالتا پوستا رہا ہُوں،</para>
  <para style="q2" vid="JOB 31:18">اَور اَپنی پیدائش سے ہی بِیوہ کا رہنما رہا ہُوں۔<verse eid="JOB 31:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 31:19"/>اگر مَیں نے کسی کو کپڑے نہ ہونے کی وجہ سے مَرتے دیکھا،</para>
  <para style="q2" vid="JOB 31:19">یا کسی مُحتاج کو بغیر لباس دیکھا،<verse eid="JOB 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 31:20"/>اَور اَپنی بھیڑوں کی اُون سے اُسے گرمی پہُنچانے کے لیٔے</para>
  <para style="q2" vid="JOB 31:20">اُس کے دِل نے مُجھے دعا نہ دی ہو،<verse eid="JOB 31:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 31:21"/>اگر مَیں نے کسی یتیم کے خِلاف اَپنا ہاتھ اُٹھایا ہو،</para>
  <para style="q2" vid="JOB 31:21">شہر کے دروازے<note caller="+" style="f"><char style="fr" closed="false">31‏:21 </char><char style="fq" closed="false">شہر کے دروازے </char><char style="ft" closed="false">عدالت</char></note> میں اَپنے رسوخ کے پیشِ نظر،<verse eid="JOB 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 31:22"/>تو میرا بازو میرے شانے سے الگ ہو جائے،</para>
  <para style="q2" vid="JOB 31:22">اَور جوڑ سے ٹوٹ جائے۔<verse eid="JOB 31:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 31:23"/>کیونکہ مُجھے خُدا کی طرف سے تباہی کا خوف تھا،</para>
  <para style="q2" vid="JOB 31:23">اَور اُس کی شوکت کے رُعب کی وجہ سے میں اَیسی حرکت نہ کر سَکا۔<verse eid="JOB 31:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 31:24"/>”اگر مَیں نے سونے پر بھروسا کیا ہو</para>
  <para style="q2" vid="JOB 31:24">اَور تپائے ہُوئے سونے سے کہا ہو کہ ’تُجھ میں میری سلامتی ہے،‘<verse eid="JOB 31:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 31:25"/>اگر مَیں اَپنی دولت کی فراوانی پر نازاں ہُوا ہُوں،</para>
  <para style="q2" vid="JOB 31:25">دولت جسے میرے ہاتھوں نے کمایا تھا،<verse eid="JOB 31:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 31:26"/>اگر مَیں نے سُورج کی رَوشنی پر</para>
  <para style="q2" vid="JOB 31:26">یا چاند پرجو خُوب شوکت سے گردش کرتا ہے نظر ڈالی ہو،<verse eid="JOB 31:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 31:27"/>یہاں تک کہ میرا دِل اَندر ہی اَندر اُن پر فریفتہ ہو گیا ہوتا،</para>
  <para style="q2" vid="JOB 31:27">اَور میرے ہاتھوں نے اُنہیں بوسہ دیا ہوتا،<verse eid="JOB 31:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 31:28"/>یہ بھی وہ گُناہ ہوتے جنہیں حِساب میں لایا جاتا،</para>
  <para style="q2" vid="JOB 31:28">کیونکہ اِن سے میری خُدا سے بےوفائی کا اِظہار ہوتا۔<verse eid="JOB 31:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 31:29"/>”اگر مَیں اَپنے دُشمن کی بدنصیبی پر خُوش ہُوا</para>
  <para style="q2" vid="JOB 31:29">یا اُس پر نازل شُدہ آفت سے شادمان ہُوا،<verse eid="JOB 31:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 31:30"/>مَیں نے اَپنے مُنہ کو اُس گُناہ سے باز رکھا</para>
  <para style="q2" vid="JOB 31:30">کہ اُس کی زندگی پر لعنت بھیجتا۔<verse eid="JOB 31:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 31:31"/>اگر میرے خاندان کے لوگوں نے کبھی نہ کہا ہو،</para>
  <para style="q2" vid="JOB 31:31">کہ اَیسا کون ہے جو ’ایُّوب کے دسترخوان سے سیر نہ ہُوا؟‘<verse eid="JOB 31:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 31:32"/>لیکن کسی پردیسی کو گلی میں رات کاٹنے کی ضروُرت نہ پڑی،</para>
  <para style="q2" vid="JOB 31:32">کیونکہ میرا دروازہ مُسافر کے لیٔے ہمیشہ کھُلا رہا۔<verse eid="JOB 31:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 31:33"/>اَپنی تقصیر اَپنے سینہ میں چھُپا کر،</para>
  <para style="q2" vid="JOB 31:33">اگر مَیں نے اَور بنی آدمؔ کی طرح اَپنے گُناہ پر پردہ ڈالا ہو<verse eid="JOB 31:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 31:34"/>کیا، مُجھے عوامُ الناس سے اِس قدر ڈر تھا؟</para>
  <para style="q2" vid="JOB 31:34">اَور کیا، برادری کی حقارت سے خوفزدہ تھا؟</para>
  <para style="q2" vid="JOB 31:34">کیا، مَیں خاموش ہو گیا اَور گھر سے باہر نہیں نِکلا؟<verse eid="JOB 31:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="JOB 31:35"/>(”کاش کہ کویٔی میری سُننے والا ہوتا!</para>
  <para style="q2" vid="JOB 31:35">لو اَب مَیں اَپنے مَحضرنامہ پر دستخط کرتا ہُوں، قادرمُطلق مُجھے جَواب دیں؛</para>
  <para style="q2" vid="JOB 31:35">میرا مُدّعی بھی اَپنا دعویٰ تحریر کرکے پیش کرے۔<verse eid="JOB 31:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JOB 31:36"/>یقیناً میں اُسے اَپنے کندھے پر لیٔے پھروں گا،</para>
  <para style="q2" vid="JOB 31:36">میں اُسے تاج کی طرح سَر پر رکھ لُوں گا۔<verse eid="JOB 31:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JOB 31:37"/>میں خُدا کو اَپنے ہر قدم کا حِساب دُوں گا؛</para>
  <para style="q2" vid="JOB 31:37">ایک حُکمراں کی طرح میں اُن کے پاس جاؤں گا۔)<verse eid="JOB 31:37"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="38" style="v" sid="JOB 31:38"/>”اگر میری زمین میرے خِلاف دہائی دیتی ہے</para>
  <para style="q2" vid="JOB 31:38">اَور اُس کی تمام کیاریاں آنسُوؤں سے تر ہیں،<verse eid="JOB 31:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="JOB 31:39"/>اگر مَیں نے بغیر قیمت اَدا کئے اُس کی پیداوار کھائی ہے</para>
  <para style="q2" vid="JOB 31:39">یا اُس کے مالکوں کی ہمّت پست کی ہے،<verse eid="JOB 31:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="JOB 31:40"/>تو اُس میں گیہُوں کے بدلے اُونٹ کٹارے</para>
  <para style="q2" vid="JOB 31:40">اَور جَو کی بجائے جنگلی گھاس اُگ جائے۔“</para>
  <para style="p" vid="JOB 31:40">ایُّوب کی تقریریں ختم ہُوئیں۔<verse eid="JOB 31:40"/></para>
  <chapter eid="JOB 31"/>
  <chapter number="32" style="c" sid="JOB 32"/>
  <para style="s1">اِلیہُوؔ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 32:1"/>تَب یہ تینوں دوست ایُّوب کو جَواب دینے سے باز آئے کیونکہ ایُّوب اَپنے آپ کو راستباز سمجھتے تھے۔ <verse eid="JOB 32:1"/><verse number="2" style="v" sid="JOB 32:2"/>لیکن بوزی براکیلؔ کا بیٹا اِلیہُوؔ<note caller="+" style="f"><char style="fr" closed="false">32‏:2 </char><char style="fq" closed="false">اِلیہُوؔ </char><char style="ft" closed="false">ایک تماشائی تھا۔</char></note> جو رامؔ کے خاندان سے تھا بےحد خفا ہُوا کیونکہ ایُّوب نے خُدا کو نہیں بَلکہ اَپنے آپ کو راست ٹھہرایا تھا۔ <verse eid="JOB 32:2"/><verse number="3" style="v" sid="JOB 32:3"/>وہ تینوں دوستوں سے بھی خفا تھے کیونکہ اُنہُوں نے ایُّوب کے خیالات کی تردید کرنے کی بجائے اُلٹا اُن ہی کو مُجرم قرار دیا۔ <verse eid="JOB 32:3"/><verse number="4" style="v" sid="JOB 32:4"/>اِلیہُوؔ ایُّوب سے گُفتگو کرنے سے اِس لیٔے رُکا رہا کہ وہ تینوں اُن سے عمر میں بڑے تھے۔ <verse eid="JOB 32:4"/><verse number="5" style="v" sid="JOB 32:5"/>لیکن جَب اِلیہُوؔ نے دیکھا کہ اُن تینوں دوستوں کے پاس کہنے کو اَور کچھ نہیں رہا تو اُس کا غُصّہ بھڑک اُٹھا۔<verse eid="JOB 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 32:6"/>چنانچہ بوزی براکیلؔ کے بیٹے اِلیہُوؔ نے کہا:</para>
  <para style="q1" vid="JOB 32:6">”میں جواں سال ہُوں،</para>
  <para style="q2" vid="JOB 32:6">اَور آپ لوگ ضعیف ہیں؛</para>
  <para style="q1" vid="JOB 32:6">اِسی لیٔے میں ڈرتا تھا،</para>
  <para style="q2" vid="JOB 32:6">اَور اَپنی رائے ظاہر کرنے کی ہمّت نہ کر پایا۔<verse eid="JOB 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 32:7"/>مَیں نے سوچا، ’سالخوردہ ہی بولیں،</para>
  <para style="q2" vid="JOB 32:7">عمر رسیدہ ہی حِکمت سکھائیں۔‘<verse eid="JOB 32:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 32:8"/>لیکن اِنسان میں رُوح ہے،</para>
  <para style="q2" vid="JOB 32:8">یعنی قادرمُطلق کا دَم جو اُسے خِرد بخشتا ہے۔<verse eid="JOB 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 32:9"/>صِرف بُوڑھے ہی عقلمند نہیں ہوتے،</para>
  <para style="q2" vid="JOB 32:9">نہ ہی صِرف عمر رسیدہ لوگ حقیقت کو سمجھتے ہیں۔<verse eid="JOB 32:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 32:10"/>”اِس لیٔے میں کہتا ہُوں کہ ’میری سُنو؛</para>
  <para style="q2" vid="JOB 32:10">اَب مَیں بھی اَپنی رائے ظاہر کرتا ہُوں۔‘<verse eid="JOB 32:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 32:11"/>جَب تک تُم بولتے رہے میں رُکا رہا،</para>
  <para style="q2" vid="JOB 32:11">جَب تُم الفاظ تلاش رہے تھے؛</para>
  <para style="q1" vid="JOB 32:11">مَیں تمہاری دلیلیں سُنتا رہا۔<verse eid="JOB 32:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="JOB 32:12"/>مَیں نے تمہاری باتوں پر خُوب غور کیا۔</para>
  <para style="q1" vid="JOB 32:12">لیکن تُم میں سے ایک نے بھی ایُّوب کو غلط ثابت نہیں کیا؛</para>
  <para style="q2" vid="JOB 32:12">تُم میں سے کسی نے بھی اُن کی دلیلوں کا جَواب نہیں دیا۔<verse eid="JOB 32:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 32:13"/>یہ نہ کہو، ’ہم بڑے دانشمند ہیں؛</para>
  <para style="q2" vid="JOB 32:13">خُدا ہی اُن کی تردید کر سکتے ہیں نہ کہ اِنسان۔‘<verse eid="JOB 32:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 32:14"/>لیکن ایُّوب نے مُجھے اَب تک اَپنی باتوں کا نِشانہ نہیں بنایا ہے،</para>
  <para style="q2" vid="JOB 32:14">اَور نہ میں اُنہیں تمہاری دلیلوں کی مدد سے جَواب دُوں گا۔<verse eid="JOB 32:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 32:15"/>”وہ ہمّت ہار گیٔے اَور اَب اُن کے پاس کہنے کو کچھ نہیں رہا،</para>
  <para style="q2" vid="JOB 32:15">اَب تو اُن کے پاس جَواب دینے کو الفاظ بھی نہ رہے۔<verse eid="JOB 32:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 32:16"/>کیا میں رُکا رہُوں، اَب جَب کہ وہ خاموش ہو گئے ہیں؟</para>
  <para style="q2" vid="JOB 32:16">وہ جَواب نہیں دیتے، وہ بولتے نہیں۔<verse eid="JOB 32:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 32:17"/>اَب مَیں ہی بولُوں گا؛</para>
  <para style="q2" vid="JOB 32:17">اَب مَیں بھی اَپنی رائے دُوں گا۔<verse eid="JOB 32:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 32:18"/>کیونکہ میرے پاس کہنے کو بہت کچھ ہے،</para>
  <para style="q2" vid="JOB 32:18">جو رُوح میرے اَندر ہے مُجھے مجبُور کر رہی ہے؛<verse eid="JOB 32:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 32:19"/>میں انگوری شِیرے سے بھرا ہُوا ہُوں جو باہر نکلنے کے لیٔے بیتاب ہے،</para>
  <para style="q2" vid="JOB 32:19">نئے انگوری شِیرے کی مَشکوں کی طرح جو پھٹنے کو ہُوں۔<verse eid="JOB 32:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 32:20"/>مُجھے بولنا ہی ہوگا تاکہ تسلّی پاؤں،</para>
  <para style="q2" vid="JOB 32:20">مُجھے اَپنے لب کھول کر جَواب دینا ہوگا۔<verse eid="JOB 32:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 32:21"/>میں کسی کی طرفداری نہ کروں گا،</para>
  <para style="q2" vid="JOB 32:21">نہ کسی اِنسان کی خُوشامد کروں گا؛<verse eid="JOB 32:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 32:22"/>کیونکہ اگر مَیں خُوشامد کرنے میں مہارت رکھتا،</para>
  <para style="q2" vid="JOB 32:22">تو میرا خالق خُدا مُجھے جلد اُٹھا لیتا۔<verse eid="JOB 32:22"/></para>
  <para style="b"/>
  <chapter eid="JOB 32"/>
  <chapter number="33" style="c" sid="JOB 33"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 33:1"/>”پھر بھی، اَے ایُّوب میری باتوں پر غور فرمائیے؛</para>
  <para style="q2" vid="JOB 33:1">میری ہر بات پر غور فرمائیے۔<verse eid="JOB 33:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 33:2"/>میں اَب اَپنا مُنہ کھولنے ہی کو ہُوں؛</para>
  <para style="q2" vid="JOB 33:2">اَور میرے الفاظ میری زبان پر ہیں۔<verse eid="JOB 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 33:3"/>میری باتیں ایک راستباز دِل سے نکل رہی ہیں؛</para>
  <para style="q2" vid="JOB 33:3">جو میں جانتا ہُوں اُسے میرے لب خُلوص سے بَیان کرتے ہیں۔<verse eid="JOB 33:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 33:4"/>خُدا کی رُوح نے مُجھے بنایا ہے؛</para>
  <para style="q2" vid="JOB 33:4">قادرمُطلق کا دَم مُجھے زندگی بخشتا ہے۔<verse eid="JOB 33:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 33:5"/>اگر ممکن ہو تو مُجھے جَواب دیں؛</para>
  <para style="q2" vid="JOB 33:5">تیّار ہو اَور میرا مُقابلہ کریں۔<verse eid="JOB 33:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 33:6"/>میں خُدا کے سامنے بالکُل آپ کی طرح ہُوں؛</para>
  <para style="q2" vid="JOB 33:6">میں بھی مٹّی سے بنایا گیا ہُوں۔<verse eid="JOB 33:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 33:7"/>میرا رُعب تُمہیں ہِراساں نہ کرے،</para>
  <para style="q2" vid="JOB 33:7">نہ میرا ہاتھ آپ پر بھاری ثابت ہو۔<verse eid="JOB 33:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 33:8"/>”مَیں نے تُمہیں بہت کچھ بولتے سُنا ہے،</para>
  <para style="q2" vid="JOB 33:8">ایک ایک لفظ سُنا ہے۔<verse eid="JOB 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 33:9"/>’میں پاک ہُوں اَور بےگُناہ؛</para>
  <para style="q2" vid="JOB 33:9">میں صَاف ہُوں اَور خطا سے آزاد۔<verse eid="JOB 33:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 33:10"/>پھر بھی خُدا نے مُجھ میں خامی پائی؛</para>
  <para style="q2" vid="JOB 33:10">وہ مُجھے اَپنا دُشمن سمجھتے ہیں۔<verse eid="JOB 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 33:11"/>وہ میرے پاؤں زنجیروں میں کستے ہیں؛</para>
  <para style="q2" vid="JOB 33:11">اَور میری سَب راہوں پر نظر رکھتے ہیں۔‘<verse eid="JOB 33:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 33:12"/>”لیکن مَیں تُمہیں کہتا ہُوں، اِس بات میں تُم حق پر نہیں ہو،</para>
  <para style="q2" vid="JOB 33:12">کیونکہ خُدا اِنسان سے عظیم ہیں۔<verse eid="JOB 33:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 33:13"/>تُم کیوں خُدا سے شکایت کرتے ہو</para>
  <para style="q2" vid="JOB 33:13">کہ وہ اِنسان کی کسی بات کا جَواب نہیں دیتے؟<verse eid="JOB 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 33:14"/>خُدا بولتے ضروُر ہیں، کبھی اِس طرح، کبھی اُس طرح،</para>
  <para style="q2" vid="JOB 33:14">خواہ اِنسان کو اُس کا احساس نہ ہو۔<verse eid="JOB 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 33:15"/>خواب میں، رات کی رُویا میں،</para>
  <para style="q2" vid="JOB 33:15">جَب لوگوں پر گہری نیند طاری ہوتی ہے،</para>
  <para style="q2" vid="JOB 33:15">اَور وہ اَپنے بِستر پر سوتے ہیں۔<verse eid="JOB 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 33:16"/>یا تو وہ اُن کے کانوں میں کچھ کہتے ہیں</para>
  <para style="q2" vid="JOB 33:16">اَور تنبیہ سے اُنہیں ڈراتے ہیں،<verse eid="JOB 33:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 33:17"/>تاکہ اِنسان اَپنے بدی سے باز رہے</para>
  <para style="q2" vid="JOB 33:17">اَور غُرور سے پرہیز کرے۔<verse eid="JOB 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 33:18"/>تاکہ اُس کی جان قبر سے بچے،</para>
  <para style="q2" vid="JOB 33:18">اَور اُس کی زندگی تلوار کی مار سے۔<verse eid="JOB 33:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 33:19"/>”یا اِنسان اَپنی ہڈّیوں کے مُستقِل کرب کے ساتھ</para>
  <para style="q2" vid="JOB 33:19">درد کے بِستر پر تنبیہ پایٔے،<verse eid="JOB 33:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 33:20"/>یہاں تک کہ اُس کا جی کھانے سے اُچاٹ ہو جائے</para>
  <para style="q2" vid="JOB 33:20">اَور اُس کی جان مرغوب غِذا سے بھی نفرت کرنے لگے۔<verse eid="JOB 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 33:21"/>اُس کا گوشت اَیسا سُوکھ جاتا ہے کہ دِکھائی نہیں دیتا،</para>
  <para style="q2" vid="JOB 33:21">اَور اُس کی ہڈّیاں جو پوشیدہ تھیں باہر نکل آتی ہیں۔<verse eid="JOB 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 33:22"/>اُس کی جان قبر کی گہرائی تک،</para>
  <para style="q2" vid="JOB 33:22">اَور اُس کی زندگی مُردوں کے پاس جا پہُنچتی ہے۔<verse eid="JOB 33:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 33:23"/>پھر بھی خُدا کے ہزاروں فرشتوں میں سے ایک،</para>
  <para style="q2" vid="JOB 33:23">جو اُس کا شفاعتی ہو</para>
  <para style="q2" vid="JOB 33:23">کہ اِنسان کو یہ بتائے کہ اُس کے حق میں کیا دُرست ہے،<verse eid="JOB 33:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 33:24"/>جو اُس پر مہربان ہو اَور کہے،</para>
  <para style="q2" vid="JOB 33:24">’اِسے قبر کی گہرائی میں جانے سے بچا؛</para>
  <para style="q2" vid="JOB 33:24">مُجھے اِس کا فدیہ مِل گیا ہے۔<verse eid="JOB 33:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 33:25"/>پھر اُس کا جِسم ایک بچّہ کے جِسم کی طرح تازہ ہو جائے گا؛</para>
  <para style="q2" vid="JOB 33:25">اَور اُس کی جَوانی بحال کر دی جائے گی۔‘<verse eid="JOB 33:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 33:26"/>وہ خُدا سے دعا کرتا ہے اَور وہ اُس پر مہربان ہوتے ہیں،</para>
  <para style="q2" vid="JOB 33:26">وہ خُدا کا چہرہ دیکھتا ہے اَور خُوشی سے چِلّا اُٹھتا ہے؛</para>
  <para style="q2" vid="JOB 33:26">خُدا اُس شخص کی صحت کو پُورا بحال کرتے ہیں۔<verse eid="JOB 33:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 33:27"/>پھر وہ لوگوں کے پاس آکر کہتاہے،</para>
  <para style="q2" vid="JOB 33:27">’مَیں نے گُناہ کیا اَور حق کو بدل دیا،</para>
  <para style="q2" vid="JOB 33:27">لیکن میرا وہ اَنجام نہ ہُوا جِس کا میں مُستحق تھا۔<verse eid="JOB 33:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 33:28"/>خُدا نے میری جان کو قبر میں جانے سے بچا لیا،</para>
  <para style="q2" vid="JOB 33:28">اَور مَیں رَوشنی کا لُطف اُٹھانے کے لیٔے جیئوں گا۔‘<verse eid="JOB 33:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 33:29"/>”خُدا اِنسان کے ساتھ یہ سَب</para>
  <para style="q2" vid="JOB 33:29">دو دفعہ بَلکہ تین دفعہ کرتے ہیں۔<verse eid="JOB 33:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 33:30"/>خُدا اُس کی جان قبر سے واپس لاتے ہیں،</para>
  <para style="q2" vid="JOB 33:30">تاکہ وہ زندگی کی رَوشنی سے رَوشن ہو۔<verse eid="JOB 33:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 33:31"/>”اَے ایُّوب، غور سے میری بات سُنو؛</para>
  <para style="q2" vid="JOB 33:31">خاموش رہو اَور مُجھے بولنے دو۔<verse eid="JOB 33:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 33:32"/>اگر تُمہیں کچھ کہنا ہے تو مُجھے جَواب دو؛</para>
  <para style="q2" vid="JOB 33:32">بولئے، کیونکہ مَیں چاہتا ہُوں کہ تُم سچّے ثابت ہو۔<verse eid="JOB 33:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 33:33"/>لیکن اگر نہیں تو میری سُنو؛</para>
  <para style="q2" vid="JOB 33:33">خاموش رہو اَور مَیں تُمہیں دانائی سِکھاؤں گا۔“<verse eid="JOB 33:33"/></para>
  <chapter eid="JOB 33"/>
  <chapter number="34" style="c" sid="JOB 34"/>
  <para style="p">
    <verse number="1" style="v" sid="JOB 34:1"/>تَب اِلیہُوؔ نے اَپنی بات جاری رکھی:<verse eid="JOB 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 34:2"/>”اَے عقلمند لوگوں، میری باتیں سُنو؛</para>
  <para style="q2" vid="JOB 34:2">اَے اہلِ علم، میری طرف کان لگاؤ۔<verse eid="JOB 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 34:3"/>کیونکہ کان باتوں کو پرکھتا ہے</para>
  <para style="q2" vid="JOB 34:3">جِس طرح زبان کھانے کو چکھتی ہے۔<verse eid="JOB 34:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 34:4"/>آؤ ہم خُود دیکھیں کہ سچ کیا ہے؛</para>
  <para style="q2" vid="JOB 34:4">آؤ ہم مِل کر سیکھیں کہ بھلائی کس میں ہے۔<verse eid="JOB 34:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 34:5"/>”ایُّوب دعویٰ کرتے ہیں، ’میں بے قُصُور ہُوں،‘</para>
  <para style="q2" vid="JOB 34:5">لیکن خُدا نے میری حق تلفی کی ہے۔<verse eid="JOB 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 34:6"/>اگرچہ میں حق پر ہُوں،</para>
  <para style="q2" vid="JOB 34:6">تو بھی میں جھُوٹا ٹھہرایا جاتا ہُوں؛</para>
  <para style="q1" vid="JOB 34:6">حالانکہ میں بے قُصُور ہُوں،</para>
  <para style="q2" vid="JOB 34:6">اُس نے مُجھے بُری طرح زخمی کر دیا ہے۔<verse eid="JOB 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 34:7"/>ایُّوب کی طرح اَور کون ہوگا،</para>
  <para style="q2" vid="JOB 34:7">جو ذِلّت کو پانی کی طرح پی جائے؟<verse eid="JOB 34:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 34:8"/>وہ بدکرداروں کی صحبت میں رہتے ہیں؛</para>
  <para style="q2" vid="JOB 34:8">اَور بدکاروں سے راہ و رسم رکھتے ہیں۔<verse eid="JOB 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 34:9"/>کیونکہ ایُّوب فرماتے ہیں، ’اِنسان کو کویٔی فائدہ نہیں</para>
  <para style="q2" vid="JOB 34:9">جَب وہ خُدا کو خُوش کرنے کی کوشش کرے۔‘<verse eid="JOB 34:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 34:10"/>”اِس لیٔے اَے اہلِ خِرد، میری سُنو،</para>
  <para style="q2" vid="JOB 34:10">یہ خُدا کے شایانِ شان نہیں کہ وہ بدی کریں،</para>
  <para style="q2" vid="JOB 34:10">یا قادرمُطلق کویٔی غلط کام کریں۔<verse eid="JOB 34:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 34:11"/>وہ اِنسان کو اُس کے اعمال کے مُطابق بدلہ دیتے ہیں؛</para>
  <para style="q2" vid="JOB 34:11">اَور اُس کے ساتھ وُہی کریں گے جِس کا وہ مُستحق ہوگا۔<verse eid="JOB 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 34:12"/>یہ ممکن ہی نہیں کہ خُدا بدی کریں،</para>
  <para style="q2" vid="JOB 34:12">یا قادرمُطلق اِنصاف سے کام نہ لیں۔<verse eid="JOB 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 34:13"/>کس نے اُنہیں زمین پر مامُور کیا؟</para>
  <para style="q2" vid="JOB 34:13">کس نے اُنہیں ساری دُنیا پر اِختیار بخشا؟<verse eid="JOB 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 34:14"/>اگر وہ چاہتے</para>
  <para style="q2" vid="JOB 34:14">تو وہ اَپنی رُوح اَور اَپنا دَم واپس لے لیتے،<verse eid="JOB 34:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 34:15"/>اَور تمام بنی نَوع اِنسان بیک وقت فنا ہو جاتے</para>
  <para style="q2" vid="JOB 34:15">اَور اِنسان خاک میں مِل جاتے۔<verse eid="JOB 34:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 34:16"/>”اگر آپ میں سمجھ ہے تو سُنیں؛</para>
  <para style="q2" vid="JOB 34:16">اَور میری باتوں پر کان لگائیں۔<verse eid="JOB 34:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 34:17"/>کیا وہ جسے اِنصاف سے نفرت ہو، حُکومت کر سَکتا ہے؟</para>
  <para style="q2" vid="JOB 34:17">کیا تُم خُدا کو جو عادل اَور قادر ہیں، مُلزم ٹھہراؤگے؟<verse eid="JOB 34:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 34:18"/>کیا وُہی نہیں جو بادشاہوں سے فرماتے ہیں کہ تُم نکمّے ہو،</para>
  <para style="q2" vid="JOB 34:18">اَور اشراف سے کہ تُم بدکارہو،<verse eid="JOB 34:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 34:19"/>جو اُمراؤں کی طرفداری نہیں کرتا</para>
  <para style="q2" vid="JOB 34:19">اَور دولتمندوں کو غریبوں پر ترجیح نہیں دیتا،</para>
  <para style="q2" vid="JOB 34:19">کیونکہ وہ سَب خُدا کے ہاتھ کی کاریگری ہیں؟<note caller="+" style="f"><char style="fr" closed="false">34‏:19 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 22:2">امثا 22‏:2</ref>؛ <ref loc="ROM 2:11">رُوم 2‏:11</ref>؛ <ref loc="JAS 2:1">یعقو 2‏:1</ref>‏</char></char></note><verse eid="JOB 34:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 34:20"/>وہ رات ہی رات میں کسی لمحہ مَر جاتے ہیں؛</para>
  <para style="q2" vid="JOB 34:20">لوگ لرزنے لگتے ہیں اَور چل بستے ہیں؛</para>
  <para style="q2" vid="JOB 34:20">سُورما ہاتھ لگائے بغیر اُٹھا لیٔے جاتے ہیں۔<verse eid="JOB 34:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 34:21"/>”خُدا کی آنکھیں اِنسان کی راہوں پر لگی رہتی ہیں؛</para>
  <para style="q2" vid="JOB 34:21">وہ اُن کی ہر روِش دیکھتے ہیں۔<verse eid="JOB 34:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 34:22"/>کویٔی اَیسی تاریک جگہ نہیں، نہ گہرا سایہ،</para>
  <para style="q2" vid="JOB 34:22">جہاں بدکار چھُپ سکیں۔<verse eid="JOB 34:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 34:23"/>خُدا کو کویٔی ضروُرت نہیں کہ وہ اِنسان کو اَپنی عدالت میں بُلائیں،</para>
  <para style="q2" vid="JOB 34:23">اَور اُس سے جرح کریں۔<verse eid="JOB 34:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 34:24"/>وہ زور آوروں کو بُلا تفتیش پاش پاش کر دیتے ہیں</para>
  <para style="q2" vid="JOB 34:24">اَور اُن کی جگہ دُوسروں کو مامُور کرتے ہیں۔<verse eid="JOB 34:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 34:25"/>کیونکہ وہ اُن کے اعمال کا حِساب رکھتے ہیں،</para>
  <para style="q2" vid="JOB 34:25">اَور رات کے وقت اُن کا تختہ اُلٹ دیتے ہیں، اَور وہ کُچل دئیے جاتے ہیں۔<verse eid="JOB 34:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 34:26"/>وہ اُنہیں اُن کی بدکاری کی سزا دیتے ہیں</para>
  <para style="q2" vid="JOB 34:26">اَیسی جگہ جہاں ہر کویٔی اُنہیں دیکھ سکے،<verse eid="JOB 34:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 34:27"/>کیونکہ اُنہُوں نے خُدا کی پیروی سے مُنہ موڑا</para>
  <para style="q2" vid="JOB 34:27">اَور خُدا کی کسی راہ کا لحاظ نہ کیا۔<verse eid="JOB 34:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 34:28"/>اُن کی وجہ سے غریبوں کی پُکار خُدا تک پہُنچی،</para>
  <para style="q2" vid="JOB 34:28">اَور اُنہُوں نے مُصیبت زدوں کی فریاد سُنی۔<verse eid="JOB 34:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 34:29"/>لیکن اگر آدمی خاموش رہے تو اُسے کون مُلزم ٹھہرائے گا؟</para>
  <para style="q2" vid="JOB 34:29">اگر وہ اَپنا مُنہ چھُپا لے تو کون اُسے دیکھ سکےگا؟</para>
  <para style="q1" vid="JOB 34:29">پھر بھی وہ ہر فرد اَور ہر قوم کے ساتھ یکساں سلُوک کرتے ہیں،<verse eid="JOB 34:29"/></para>
  <para style="q2">
    <verse number="30" style="v" sid="JOB 34:30"/>تاکہ خُدا کا مُنکر حُکومت نہ کر سکے،</para>
  <para style="q2" vid="JOB 34:30">اَور لوگوں کو پھندے میں پھنسانے سے باز رہے۔<verse eid="JOB 34:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 34:31"/>”ممکن ہے کہ کویٔی شخص خُدا سے کہے،</para>
  <para style="q2" vid="JOB 34:31">’میں گُنہگار ہُوں لیکن اَب اَیسا نہ کروں گا،<verse eid="JOB 34:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 34:32"/>جو مُجھے دِکھائی نہیں دیتا وہ مُجھے سکھائیں؛</para>
  <para style="q2" vid="JOB 34:32">اگر مَیں نے بُرائی کی ہے تو دوبارہ اَیسا نہ کروں گا۔‘<verse eid="JOB 34:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 34:33"/>کیا خُدا تمہاری مرضی کے مُطابق سزا دیں گے،</para>
  <para style="q2" vid="JOB 34:33">جَب کہ تُم تَوبہ کرنے سے اِنکار کرتے ہو؟</para>
  <para style="q1" vid="JOB 34:33">فیصلہ تُمہیں کرناہے نہ کہ مُجھے؛</para>
  <para style="q2" vid="JOB 34:33">اِس لیٔے جو کچھ تُم جانتے ہو مُجھے بتاؤ۔<verse eid="JOB 34:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 34:34"/>”اہلِ خِرد اعلان کرتے ہیں،</para>
  <para style="q2" vid="JOB 34:34">عقلمند لوگ جو میری بات سُنتے ہیں، مُجھ سے کہتے ہیں:<verse eid="JOB 34:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JOB 34:35"/>’ایُّوب نادانی سے بولتا ہے؛</para>
  <para style="q2" vid="JOB 34:35">اُن کی باتیں حِکمت سے خالی ہیں۔‘<verse eid="JOB 34:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JOB 34:36"/>کاش کہ ایُّوب سے</para>
  <para style="q2" vid="JOB 34:36">ایک بدکار کی طرح جَواب دینے کے لیٔے پُوری طرح تفتیش کی جاتی!<verse eid="JOB 34:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JOB 34:37"/>گُناہ کے ساتھ ساتھ وہ سرکشی بھی کرتے ہیں؛</para>
  <para style="q2" vid="JOB 34:37">اَور ہمارے درمیان حقارت آمیزی سے تالیاں بجاتے ہیں</para>
  <para style="q2" vid="JOB 34:37">اَور خُدا کے خِلاف بہت سِی باتیں بناتے ہیں۔“<verse eid="JOB 34:37"/></para>
  <chapter eid="JOB 34"/>
  <chapter number="35" style="c" sid="JOB 35"/>
  <para style="p">
    <verse number="1" style="v" sid="JOB 35:1"/>پھر اِلیہُوؔ نے مزید کہا:<verse eid="JOB 35:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 35:2"/>”کیا تیرا یہ کہنا صحیح ہے؟</para>
  <para style="q2" vid="JOB 35:2">’میں خُدا سے زِیادہ صادق ہُوں؟‘<verse eid="JOB 35:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 35:3"/>پھر بھی تُم اُس سے پُوچھتے ہو، ’مُجھے اُس سے کیا فائدہ،</para>
  <para style="q2" vid="JOB 35:3">اگر مَیں گُناہ نہ کروں تو میرا کیا بھلا ہوتاہے؟‘<verse eid="JOB 35:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 35:4"/>”مَیں تُمہیں جَواب دینا چاہوں گا،</para>
  <para style="q2" vid="JOB 35:4">اَور تیرے ساتھ تیرے دوستوں کو بھی۔<verse eid="JOB 35:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 35:5"/>افلاک کی طرف نظر اُٹھا اَور دیکھ؛</para>
  <para style="q2" vid="JOB 35:5">بادلوں کی طرف نگاہ کرجو تُجھ سے اِس قدر اُونچائی پر ہیں۔<verse eid="JOB 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 35:6"/>اگر تُو گُناہ کرتا ہے تو اُس سے خُدا کا کیا بگاڑتا ہے؟</para>
  <para style="q2" vid="JOB 35:6">اگر تیرے گُناہ بڑھ جایٔیں تو اُسے کیا ہوگا؟<verse eid="JOB 35:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 35:7"/>اگر تُو راستباز ہے تو اُسے کیا دیتاہے،</para>
  <para style="q2" vid="JOB 35:7">یا وہ تیرے ہاتھوں کیا پاتاہے؟<verse eid="JOB 35:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 35:8"/>تیری بدکاری صِرف تُجھ جَیسے اِنسان ہی پر اثر اَنداز ہوتی ہے،</para>
  <para style="q2" vid="JOB 35:8">اَور تیری راستبازی صِرف آدمؔ زاد پر۔<verse eid="JOB 35:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 35:9"/>”ظُلم کے بوجھ سے دَب کر لوگ چِلّا اُٹھتے ہیں؛</para>
  <para style="q2" vid="JOB 35:9">زورآور کے بازو سے مخلصی پانے کے لیٔے وہ دہائی دیتے ہیں۔<verse eid="JOB 35:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 35:10"/>لیکن کویٔی یہ نہیں کہتا کہ ’میرا بنانے والا خُدا کہاں ہے،</para>
  <para style="q2" vid="JOB 35:10">جو رات کے وقت نغمے عنایت کرتا ہے،<verse eid="JOB 35:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 35:11"/>جو ہمیں زمین کے جانوروں سے زِیادہ سِکھاتا ہے،</para>
  <para style="q2" vid="JOB 35:11">اَور ہَوا کے پرندوں سے زِیادہ عقلمند بناتا ہے۔‘<verse eid="JOB 35:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 35:12"/>لوگ مدد کی دہائی دیتے ہیں</para>
  <para style="q2" vid="JOB 35:12">اَور خُدا بدکاروں کے غُرور کی وجہ سے جَواب نہیں دیتا۔<verse eid="JOB 35:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 35:13"/>تُو یقین کر کہ خُدا اُن کی جھُوٹی فریاد نہیں سُنتا؛</para>
  <para style="q2" vid="JOB 35:13">اَور قادرمُطلق اُس کی طرف غور نہیں کرتا۔<verse eid="JOB 35:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 35:14"/>جَب تُو کہتاہے کہ تُو اُسے نہیں دیکھتا</para>
  <para style="q2" vid="JOB 35:14">تو پھر تُجھے کیسے مَعلُوم ہوگا؟</para>
  <para style="q1" vid="JOB 35:14">تیرا مُعاملہ اُس کے سامنے ہے</para>
  <para style="q2" vid="JOB 35:14">اَور تُمہیں اُس کا اِنتظار کرنا لازمی ہے،<verse eid="JOB 35:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 35:15"/>مزید یہ کہ، اگر اُس نے غُصّہ میں آکر سزا نہیں دی،</para>
  <para style="q2" vid="JOB 35:15">تو یہ مطلب نہیں کہ وہ بدکاری کو نظر میں لاتا ہی نہیں۔<verse eid="JOB 35:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 35:16"/>پس ایُّوب ایک بے معنی بحث کے لیٔے مُنہ کھولتے ہیں؛</para>
  <para style="q2" vid="JOB 35:16">اَور بغیر جانے بوجھے بولتے جاتے ہیں۔“<verse eid="JOB 35:16"/></para>
  <chapter eid="JOB 35"/>
  <chapter number="36" style="c" sid="JOB 36"/>
  <para style="p">
    <verse number="1" style="v" sid="JOB 36:1"/>اِلیہُوؔ نے اَپنا بَیان جاری رکھا:<verse eid="JOB 36:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 36:2"/>”ذرا صبر کریں، مُجھے بولنے دیں،</para>
  <para style="q2" vid="JOB 36:2">کیونکہ خُدا کے حق میں مُجھے کچھ اَور بھی کہنا ہے۔<verse eid="JOB 36:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 36:3"/>مَیں نے دُور دُور سے علم حاصل کیا ہے؛</para>
  <para style="q2" vid="JOB 36:3">میں اَپنے خالق کو عادل تسلیم کرتا ہُوں۔<verse eid="JOB 36:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 36:4"/>یقین رکھو کہ میری باتیں جھُوٹی نہیں ہیں؛</para>
  <para style="q2" vid="JOB 36:4">ایک کامل علم شخص، تمہارے ساتھ ہے۔<verse eid="JOB 36:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 36:5"/>”خُدا قادر ہیں لیکن وہ لوگوں کو حقیر نہیں جانتے؛</para>
  <para style="q2" vid="JOB 36:5">وہ قوی ہیں اَور اَپنے اِرادہ میں مصمّم۔<verse eid="JOB 36:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 36:6"/>وہ بدکار کو زندہ نہیں چھوڑتے</para>
  <para style="q2" vid="JOB 36:6">لیکن مُصیبت کے ماروں کو اُن کا حق بخشتے ہیں۔<verse eid="JOB 36:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 36:7"/>وہ راستبازوں کی طرف سے اَپنی نگاہ نہیں ہٹاتے؛</para>
  <para style="q2" vid="JOB 36:7">اَور اُنہیں بادشاہوں کے ساتھ تخت نشین کرتے ہیں،</para>
  <para style="q2" vid="JOB 36:7">اَور ہمیشہ کے لیٔے سرفراز کرتے ہیں۔<verse eid="JOB 36:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 36:8"/>لیکن اگر لوگ زنجیروں میں جکڑے ہُوئے ہیں،</para>
  <para style="q2" vid="JOB 36:8">اَور مُصیبت کی رسّیوں سے بندھے ہویٔے ہیں،<verse eid="JOB 36:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 36:9"/>تو وہ اُنہیں اُن کی کرتوتیں بتاتے ہیں،</para>
  <para style="q2" vid="JOB 36:9">اَور یہ کہ اُنہُوں نے تکبُّر میں گُناہ کیا۔<verse eid="JOB 36:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 36:10"/>وہ تادیب کے لیٔے اُن کے کان کھولتے ہیں،</para>
  <para style="q2" vid="JOB 36:10">اَور اُنہیں حُکم دیتے ہیں کہ اَپنی بدی سے باز آئیں۔<verse eid="JOB 36:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 36:11"/>اگر وہ حُکم مانیں اَور اُن کی اِطاعت کریں،</para>
  <para style="q2" vid="JOB 36:11">تو وہ اَپنی زندگی کے باقی بچے ایّام خُوشحالی میں</para>
  <para style="q2" vid="JOB 36:11">اَور زندگی آسودگی میں گُزاریں گے۔<verse eid="JOB 36:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 36:12"/>لیکن اگر وہ نہ سُنیں،</para>
  <para style="q2" vid="JOB 36:12">تو تلوار سے ہلاک ہوں گے</para>
  <para style="q2" vid="JOB 36:12">اَور بغیر علم کے وہ مَر جائیں گے۔<verse eid="JOB 36:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 36:13"/>”بےدینوں کے دِل میں خفگی بستی ہے؛</para>
  <para style="q2" vid="JOB 36:13">وہ اُنہیں قَید کرتے ہیں تَب بھی وہ مدد کے لیٔے دہائی نہیں دیتے۔<verse eid="JOB 36:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 36:14"/>وہ اَپنی جَوانی ہی میں مَر جاتے ہیں،</para>
  <para style="q2" vid="JOB 36:14">اُن کی زندگی بُتکدوں میں بدفعلوں کے درمیان برباد ہو جاتی ہے۔<note caller="+" style="f"><char style="fr" closed="false">36‏:14 </char><char style="ft" closed="false">مَذہبی عصمت فروشی کا رِواج، جِس کی کثرت سے بادشاہوں کی کِتاب میں مذمّت کی گئی ہے، کنعانیوں کی زرخیزی کی رسومات کا حِصّہ تھی۔</char></note><verse eid="JOB 36:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 36:15"/>جو مُصیبت زدہ ہیں خُدا اُنہیں اُن کی مُصیبت سے چھُٹکارا دیتے ہیں؛</para>
  <para style="q2" vid="JOB 36:15">اَور دُکھ درد کے ذریعہ اُن کے کان کھولتے ہیں۔<verse eid="JOB 36:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 36:16"/>”خُدا تُمہیں تنگی کے جَبڑوں سے نکال کر،</para>
  <para style="q2" vid="JOB 36:16">ایک اَیسی کشادہ جگہ لے جاتے ہیں،</para>
  <para style="q2" vid="JOB 36:16">جہاں تُم دسترخوان پر چُنے ہُوئے بہترین کھانوں سے لُطف اَندوز ہو سکتے ہو۔<verse eid="JOB 36:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 36:17"/>لیکن اِس وقت تُم اَیسی سزا پا رہے ہو جو ایک بدکار کو ملنی چاہئے تھی؛</para>
  <para style="q2" vid="JOB 36:17">پھر بھی فیصلہ اَور اِنصاف ہوکر ہی رہے گا۔<verse eid="JOB 36:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 36:18"/>خبردار، دولت تمہارا دِل نہ لُبھا لے؛</para>
  <para style="q2" vid="JOB 36:18">کویٔی بڑی رشوت تُمہیں گُمراہ نہ کر دے۔<verse eid="JOB 36:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 36:19"/>کیا تمہاری دولت یا قُوّت و توانائی</para>
  <para style="q2" vid="JOB 36:19">تُمہیں مُصیبت سے بچانے کے لیٔے کافی ہیں؟<verse eid="JOB 36:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 36:20"/>اُس رات کی تمنّا نہ کرو،</para>
  <para style="q2" vid="JOB 36:20">جِس میں لوگوں کو اُن کے گھروں سے اَچانک اُٹھالیا جاتا ہے۔<verse eid="JOB 36:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 36:21"/>بدی کی طرف مائل نہ ہو،</para>
  <para style="q2" vid="JOB 36:21">جسے تُم مُصیبتوں پر ترجیح دیتے ہویٔے نظر آتے ہو۔<verse eid="JOB 36:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 36:22"/>”خُدا کی قُدرت عظیم ہے۔</para>
  <para style="q2" vid="JOB 36:22">کیا کویٔی اُستاد اُن کی مانند ہے؟<verse eid="JOB 36:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 36:23"/>کس نے اُن کے لیٔے راہیں تجویز کیں،</para>
  <para style="q2" vid="JOB 36:23">یا اُن سے کہا ہو، ’تُم نے ناراستی کی ہے‘؟<verse eid="JOB 36:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 36:24"/>خُدا کے کاموں کی تعریف کرنا نہ بھُولو،</para>
  <para style="q2" vid="JOB 36:24">جنہیں لوگوں نے گانا گا کر اُن کی سِتائش کی ہے،<verse eid="JOB 36:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 36:25"/>تمام نَوع اِنسان نے اُنہیں دیکھاہے؛</para>
  <para style="q2" vid="JOB 36:25">لوگ دُور سے اُن پر نظر جمائے رہتے ہیں۔<verse eid="JOB 36:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 36:26"/>خُدا کس قدر عظیم ہیں، ہماری سمجھ سے باہر!</para>
  <para style="q2" vid="JOB 36:26">اُن کے برسوں کا شُمار دریافت سے باہر ہے!<verse eid="JOB 36:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 36:27"/>”وہ پانی کے قطروں کو اُوپر کھینچتے ہیں،</para>
  <para style="q2" vid="JOB 36:27">جو بخارات سے مینہ میں ڈھل کر چشموں میں گرتا ہے؛<verse eid="JOB 36:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 36:28"/>بادل اَپنی رطوبت اُنڈیل دیتے ہیں،</para>
  <para style="q2" vid="JOB 36:28">اَور بنی نَوع اِنسان پر کثرت سے بارش ہوتی ہے۔<verse eid="JOB 36:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 36:29"/>کون سمجھ سَکتا ہے کہ وہ بادلوں کو کیسے پھیلاتے ہیں،</para>
  <para style="q2" vid="JOB 36:29">یا اَپنی شہ نشین سے کیسے گرجتے ہیں؟<verse eid="JOB 36:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 36:30"/>دیکھو وہ اَپنی بجلی کو اَپنے چَوگرد کیسے مُنتشر کرتے ہیں،</para>
  <para style="q2" vid="JOB 36:30">جو سمُندر کی گہرائیوں کو بھی جگمگا دیتی ہے۔<verse eid="JOB 36:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 36:31"/>اُن ہی سے وہ قوموں میں اَپنا نظام قائِم کرتے ہیں</para>
  <para style="q2" vid="JOB 36:31">اَور اُنہیں کثرت سے خُوراک بہم پہُنچاتے ہیں۔<verse eid="JOB 36:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 36:32"/>وہ بجلی کو اَپنے ہاتھ میں لیتے ہیں</para>
  <para style="q2" vid="JOB 36:32">اَور حُکم دیتے ہیں کہ نِشانہ پر جا گِرے۔<verse eid="JOB 36:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 36:33"/>اُن کی گرج آنے والے طُوفان کا اعلان کرتی ہے؛</para>
  <para style="q2" vid="JOB 36:33">چَوپائے تک طُوفان کی آمد کی خبر کر دیتے ہیں۔<verse eid="JOB 36:33"/></para>
  <para style="b"/>
  <chapter eid="JOB 36"/>
  <chapter number="37" style="c" sid="JOB 37"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 37:1"/>”اِس بات سے بھی میرا دِل کانپتا ہے</para>
  <para style="q2" vid="JOB 37:1">اَور اَپنی جگہ سے اُچھل پڑتا ہے۔<verse eid="JOB 37:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 37:2"/>سُنو! خُدا کی آواز کی گرج سُنو،</para>
  <para style="q2" vid="JOB 37:2">اَور وہ زمزمہ جو اُن کے مُنہ سے نکلتا ہے۔<verse eid="JOB 37:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 37:3"/>وہ اَپنی بجلی کو سارے آسمان کے نیچے چمکاتے ہیں</para>
  <para style="q2" vid="JOB 37:3">اَور اُسے زمین کی اِنتہا تک پہُنچا دیتے ہیں۔<verse eid="JOB 37:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 37:4"/>اُس کے بعد اُن کے گرجنے کی آواز آتی ہے؛</para>
  <para style="q2" vid="JOB 37:4">وہ اَپنی جلالی آواز سے گرجتے ہیں۔</para>
  <para style="q1" vid="JOB 37:4">جَب اُن کی آواز گونجتی ہے،</para>
  <para style="q2" vid="JOB 37:4">تو وہ اُسے بالکُل نہیں روکتا۔<verse eid="JOB 37:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 37:5"/>خُدا کی آواز عجِیب و غریب طور پر گرجتی ہے؛</para>
  <para style="q2" vid="JOB 37:5">وہ غَیر مَعمولی کام کرتے ہیں جو ہماری سمجھ سے باہر ہیں۔<verse eid="JOB 37:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 37:6"/>وہ برف سے کہتے ہیں، ’تُو زمین پر گِر،‘</para>
  <para style="q2" vid="JOB 37:6">اَور مینہ سے ’تُو موسلادھار بارش بَن جا۔‘<verse eid="JOB 37:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 37:7"/>یُوں ہر شخص کو مشقّت سے روکتے ہیں،</para>
  <para style="q2" vid="JOB 37:7">تاکہ وہ تمام لوگ جنہیں خُدا نے بنایا ہے اُن کے کام کو جانیں۔<verse eid="JOB 37:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 37:8"/>جانور غاروں میں چھُپ جاتے ہیں؛</para>
  <para style="q2" vid="JOB 37:8">وہ اَپنی اَپنی ماند میں پڑے رہتے ہیں۔<verse eid="JOB 37:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 37:9"/>آندھی اَپنی جُنوب کی سمت سے نکل آتی ہے،</para>
  <para style="q2" vid="JOB 37:9">اَور تیز ہوایٔیں سردی لے آتی ہیں۔<verse eid="JOB 37:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 37:10"/>خُدا کے دَم سے برف جم جاتی ہے،</para>
  <para style="q2" vid="JOB 37:10">اَور وسیع سطحِ سمُندر منجمد ہو جاتی ہے۔<verse eid="JOB 37:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 37:11"/>وہ بادلوں میں رطوبت بھر دیتے ہیں؛</para>
  <para style="q2" vid="JOB 37:11">اَور اُن میں سے اَپنی بجلی مُنتشر کرتے ہیں۔<verse eid="JOB 37:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 37:12"/>خُدا کے اِشارے پر وہ تمام کرۂ زمین کا چکّر کاٹتے ہیں</para>
  <para style="q2" vid="JOB 37:12">تاکہ اُن کے حُکم کی تعمیل کریں۔<verse eid="JOB 37:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 37:13"/>کبھی اَپنی زمین کو سیراب کرنے اَور اَپنی مَحَبّت جتانے کے لیٔے۔<verse eid="JOB 37:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 37:14"/>”اَے ایُّوب اِسے سُنو؛</para>
  <para style="q2" vid="JOB 37:14">چُپکے رہو اَور خُدا کے حیرت اَنگیز کارناموں پر غور کرو۔<verse eid="JOB 37:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 37:15"/>کیا تُم جانتے ہو کہ خُدا بادلوں کو کیسے قابُو میں رکھتے ہیں</para>
  <para style="q2" vid="JOB 37:15">اَور اَپنی بجلی کیسے چمکاتے ہیں؟<verse eid="JOB 37:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 37:16"/>کیا تُم جانتے ہو کہ بادل اَپنا توازن کیسے قائِم رکھتا ہے؟</para>
  <para style="q2" vid="JOB 37:16">یہ اُسی علمِ کامل کے حیرت اَنگیز کارنامے ہیں۔<verse eid="JOB 37:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 37:17"/>جَب زمین پر جُنوبی ہَوا کے زیرِ اثر سنّاٹا ہو جاتا ہے،</para>
  <para style="q2" vid="JOB 37:17">تو تُم اَپنے لباس میں تپنے لگتے ہو۔<verse eid="JOB 37:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 37:18"/>کیا تُم آسمانوں کو پھیلانے میں اُس کی مدد کر سکتے ہو،</para>
  <para style="q2" vid="JOB 37:18">جو ڈھلے ہُوئے کانسے کے آئینہ کی مانند مضبُوط ہوتے ہیں؟<verse eid="JOB 37:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 37:19"/>”ہمیں بتاؤ کہ ہم خُدا سے کیا کہیں؛</para>
  <para style="q2" vid="JOB 37:19">کیونکہ ہم تو تاریکی میں ہیں ہم اُس سے بحث کرنے کے لیٔے دلائل کہاں سے لائیں۔<verse eid="JOB 37:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 37:20"/>کیا خُدا کو بتایا جائے کہ میں بولنا چاہتا ہُوں؟</para>
  <para style="q2" vid="JOB 37:20">اَیسی درخواست تو زندہ نگل لیٔے جانے کے مترادف ہوگی۔<verse eid="JOB 37:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 37:21"/>سُورج جِس آب و تاب سے آسمانوں میں چمکتا ہے،</para>
  <para style="q2" vid="JOB 37:21">کویٔی اُس کی طرف دیکھ نہیں سَکتا،</para>
  <para style="q2" vid="JOB 37:21">خصوصاً جَب ہَوا بادلوں کو صَاف کردیتی ہے۔<verse eid="JOB 37:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 37:22"/>شمال کی جانِب سے سُنہری کرنیں اَپنا جلوہ دِکھاتی ہیں</para>
  <para style="q2" vid="JOB 37:22">خُدا کی اِس مُہیب شوکت پر کس کی نظر ٹِکے گی۔<verse eid="JOB 37:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 37:23"/>قادرمُطلق تک ہماری رسائی نہیں ہو سکتی، وہ قُدرت میں اعلیٰ ہیں؛</para>
  <para style="q2" vid="JOB 37:23">وہ اَپنے عدل میں عظیم اَور راستبازی میں غنی ہیں، وہ ہم پر ظُلم نہیں کرتے۔<verse eid="JOB 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 37:24"/>اِسی لیٔے لوگ خُدا سے ڈرتے ہیں،</para>
  <para style="q2" vid="JOB 37:24">کیا اُنہیں دانا دِلوں کی پروا نہیں؟“<verse eid="JOB 37:24"/></para>
  <chapter eid="JOB 37"/>
  <chapter number="38" style="c" sid="JOB 38"/>
  <para style="s1">ایُّوب سے یَاہوِہ کی گُفتگو</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 38:1"/>تَب یَاہوِہ نے ایُّوب کو بگولے میں سے جَواب دیا:<verse eid="JOB 38:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 38:2"/>”یہ کون ہے جو فُضول باتوں سے</para>
  <para style="q2" vid="JOB 38:2">میری مشورت پر پردہ ڈال رہاہے؟<verse eid="JOB 38:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 38:3"/>مَرد کی مانند اَپنی کمر باندھو؛</para>
  <para style="q2" vid="JOB 38:3">میں تُم سے سوال پُوچھوں گا،</para>
  <para style="q2" vid="JOB 38:3">اَور تُم مُجھے جَواب دوگے۔<note caller="+" style="f"><char style="fr" closed="false">38‏:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="JOB 40:7">ایُّو 40‏:7</ref>‏</char></char></note><verse eid="JOB 38:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 38:4"/>”جَب مَیں نے زمین کی بُنیاد رکھی تَب تُم کہاں تھے؟</para>
  <para style="q2" vid="JOB 38:4">اگر تُم دانشمند ہو تو مُجھے بتاؤ۔<verse eid="JOB 38:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 38:5"/>کس نے اُس کی جِسامت کو قائِم کیا، کیا تُمہیں مَعلُوم ہے؟</para>
  <para style="q2" vid="JOB 38:5">کس نے اُسے پیمائشی جریب سے ناپا؟<verse eid="JOB 38:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 38:6"/>کس چیز پر اُس کی بُنیادیں ڈالی گئیں،</para>
  <para style="q2" vid="JOB 38:6">یا کس نے اُس کے کونےکا پتّھر رکھا؟<verse eid="JOB 38:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 38:7"/>جَب صُبح کے سِتارے مِل کر گا رہے تھے</para>
  <para style="q2" vid="JOB 38:7">اَور تمام ملائک<note caller="+" style="f"><char style="fr" closed="false">38‏:7 </char><char style="fq" closed="false">ملائک </char><char style="ft" closed="false">فرشتے</char></note> خُوشی سے للکار رہے تھے، تَب تُم کہاں تھے؟<verse eid="JOB 38:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 38:8"/>”کس نے سمُندر کو دروازوں سے بند کیا</para>
  <para style="q2" vid="JOB 38:8">جَب وہ اَیسا پھوٹ نِکلا گویا بطن سے،<verse eid="JOB 38:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 38:9"/>جَب مَیں نے بادلوں کو اُس کی پوشاک بنایا</para>
  <para style="q2" vid="JOB 38:9">اَور گہری تاریکی میں اُسے لپیٹ دیا،<verse eid="JOB 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 38:10"/>جَب مَیں نے اُس کے لئے حُدوُد مُقرّر کیں</para>
  <para style="q2" vid="JOB 38:10">اَور اُس کے دروازے اَور سلاخیں اَپنی اَپنی جگہ پیوست کیں،<verse eid="JOB 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 38:11"/>جَب مَیں نے سمُندر سے کہا: ’یہاں تک تُو آسکتا ہے، لیکن اُس کے آگے نہیں</para>
  <para style="q2" vid="JOB 38:11">یہیں پر تمہاری بپھری ہُوئی موجیں رُک جایٔیں‘؟<verse eid="JOB 38:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 38:12"/>”تُم نے کبھی صُبح کو حُکم دیا ہے،</para>
  <para style="q2" vid="JOB 38:12">یا طُلوع صُبح کو اَپنی جگہ بتایٔی ہے،<verse eid="JOB 38:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 38:13"/>تاکہ وہ زمین کو کناروں سے پکڑکر جھٹکائے</para>
  <para style="q2" vid="JOB 38:13">اَور بدکاروں کو اُس میں سے نکال دے۔<verse eid="JOB 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 38:14"/>جِس طرح چکنی مٹّی مُہر کے نیچے بدلتی ہے وَیسے ہی زمین بھی تشکیل پاتی ہے؛</para>
  <para style="q2" vid="JOB 38:14">اُس کے خدوخال پوشاک کی طرح نُمایاں ہوتے ہیں۔<verse eid="JOB 38:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 38:15"/>بدکاروں کو اُن کی رَوشنی سے محروم کر دیا جاتا ہے،</para>
  <para style="q2" vid="JOB 38:15">اَور اُن کا بُلند بازو توڑ دیا جاتا ہے۔<verse eid="JOB 38:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 38:16"/>”کیا تُم سمُندر کے چشموں میں اُترے ہو</para>
  <para style="q2" vid="JOB 38:16">یا اتھاہ گہرائیوں میں چلے ہو؟<verse eid="JOB 38:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 38:17"/>کیا موت کے دروازے تمہارے لیٔے کھولے گیٔے ہیں؟</para>
  <para style="q2" vid="JOB 38:17">کیا تُم نے موت کے سایہ کے پھاٹک دیکھے ہیں؟<verse eid="JOB 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 38:18"/>کیا تُم زمین کی پہنائی کو سمجھ پائے ہو؟</para>
  <para style="q2" vid="JOB 38:18">اگر تُم یہ سَب جانتے ہو تو مُجھے بتاؤ۔<verse eid="JOB 38:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 38:19"/>”نُور کے مَسکن کا راستہ کہاں ہے؟</para>
  <para style="q2" vid="JOB 38:19">اَور تاریکی کہاں رہتی ہے؟<verse eid="JOB 38:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 38:20"/>کیا تُم اُنہیں اُن کی جگہ لے جا سکتے ہو؟</para>
  <para style="q2" vid="JOB 38:20">تُمہیں اُن کی قِیام گاہوں کا راستہ مَعلُوم ہے؟<verse eid="JOB 38:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 38:21"/>یقیناً تُم جانتے ہو کیونکہ اُس وقت تُم پیدا ہو چُکے تھے!</para>
  <para style="q2" vid="JOB 38:21">اَور تُم اِتنے سال سے زندہ ہو!<verse eid="JOB 38:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 38:22"/>”کیا تُم برف کے مخزنوں میں داخل ہُوئے ہو</para>
  <para style="q2" vid="JOB 38:22">یا تُم نے اولوں کے انبار کو دیکھاہے،<verse eid="JOB 38:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 38:23"/>جنہیں مَیں نے مُصیبت کے اوقات،</para>
  <para style="q2" vid="JOB 38:23">اَور لڑائی اَور جنگ کے دِنوں کے لیٔے محفوظ رکھا ہے؟<verse eid="JOB 38:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 38:24"/>اِس جگہ کا راستہ کون سا ہے جہاں بجلی تقسیم ہوتی ہے،</para>
  <para style="q2" vid="JOB 38:24">یا وہ جگہ جہاں مشرقی ہوایٔیں زمین پر پھیلائی جاتی ہیں؟<verse eid="JOB 38:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 38:25"/>نیز سیلاب کے لیٔے نہریں کون کاٹتا ہے،</para>
  <para style="q2" vid="JOB 38:25">اَور طُوفان برق و باد کے لیٔے راہیں کون نکالتا ہے،<verse eid="JOB 38:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 38:26"/>تاکہ غَیر آباد زمین کو سیراب کرے،</para>
  <para style="q2" vid="JOB 38:26">اَور ایک بیابان میں، جِس میں کویٔی اِنسان نہیں رہتا،<verse eid="JOB 38:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 38:27"/>تاکہ ویران اَور بنجر زمین کی پیاس بُجھے</para>
  <para style="q2" vid="JOB 38:27">اَور اُس میں گھاس اُگ آئے؟<verse eid="JOB 38:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 38:28"/>کیا بارش کا کویٔی باپ ہے؟</para>
  <para style="q2" vid="JOB 38:28">یا اوس کے قطرے کون پیدا کرتا ہے؟<verse eid="JOB 38:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 38:29"/>برف کس کے بطن سے نکلتی ہے؟</para>
  <para style="q2" vid="JOB 38:29">آسمانوں سے پالے کون پیدا کرتا ہے<verse eid="JOB 38:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 38:30"/>کب پانی پتّھر کی طرح سخت ہو جاتا ہے،</para>
  <para style="q2" vid="JOB 38:30">اَور سمُندر کی سطح کب منجمد ہو جاتی ہے؟<verse eid="JOB 38:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 38:31"/>”کیا تُم ثریّا کو باندھ سکتے ہو؟</para>
  <para style="q2" vid="JOB 38:31">کیا تُم جبّار کی رسّیاں کھول سکتے ہو؟<note caller="+" style="f"><char style="fr" closed="false">38‏:31 </char><char style="ft" closed="false">ثریّا کے معنی سات سِتارے، اَور جبّار کے معنی درمیانی آسمان میں سِتاروں کا جھرمٹ۔</char></note><verse eid="JOB 38:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 38:32"/>کیا تُم کواکب<note caller="+" style="f"><char style="fr" closed="false">38‏:32 </char><char style="fq" closed="false">کواکب </char><char style="ft" closed="false">رَوشن سِتارے</char></note> کو اُن کے موسموں پر نکال سکتے ہو</para>
  <para style="q2" vid="JOB 38:32">یا بناتُ النّعش کی اُن کی سہیلیوں کے ساتھ رہبری کر سکتے ہو؟<note caller="+" style="f"><char style="fr" closed="false">38‏:32 </char><char style="ft" closed="false">شمال میں سِتاروں کو بڑا ریچھ اَور چھوٹا ریچھ کہتے ہیں۔</char></note><verse eid="JOB 38:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 38:33"/>کیا تُم افلاک کے آئین جانتے ہو؟</para>
  <para style="q2" vid="JOB 38:33">کیا تُم اُنہیں زمین پر قائِم کر سکتے ہو؟<verse eid="JOB 38:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 38:34"/>”کیا تُم بادلوں تک اَپنی آواز بُلند کر سکتے ہو</para>
  <para style="q2" vid="JOB 38:34">یا اُن کی موسلادھار بارش میں چھُپ سکتے ہو؟<verse eid="JOB 38:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JOB 38:35"/>کیا تُم بجلی کے کوندوں کو اُن کی راہ پر روانہ کر سکتے ہو؟</para>
  <para style="q2" vid="JOB 38:35">کیا وہ تُم سے کہتی ہے: مَیں حاضِر ہُوں؟<verse eid="JOB 38:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JOB 38:36"/>باطِن کو حِکمت سے کس نے مُزیّن کیا،</para>
  <para style="q2" vid="JOB 38:36">یا مُرغ کو فہم کس نے عطا کیا؟<verse eid="JOB 38:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JOB 38:37"/>کس میں اُتنی حِکمت ہے کہ بادلوں کو گِن سکے؟</para>
  <para style="q2" vid="JOB 38:37">آسمان کی مَشکوں کے مُنہ کون کھول سَکتا ہے۔<verse eid="JOB 38:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="JOB 38:38"/>جَب زمین تودہ بَن جاتی ہے،</para>
  <para style="q2" vid="JOB 38:38">اَور اُس کے ڈھیلے باہم چپک جاتے ہیں؟<verse eid="JOB 38:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="JOB 38:39"/>”کیا تُم شیرنی کے لیٔے شِکار مارتے ہو،</para>
  <para style="q2" vid="JOB 38:39">اَور شیروں کی بھُوک مٹاتے ہو<verse eid="JOB 38:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="JOB 38:40"/>جَب وہ اَپنی ماندوں میں دبک کر بیٹھتے ہیں،</para>
  <para style="q2" vid="JOB 38:40">یا گنُجان جھاڑیوں میں گھات لگا کر بیٹھتے ہیں؟<verse eid="JOB 38:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="JOB 38:41"/>پہاڑی کوّے کے لیٔے غِذا کون مُہیّا کرتا ہے،</para>
  <para style="q2" vid="JOB 38:41">جَب اُس کے بچّے خُدا سے فریاد کرتے،</para>
  <para style="q2" vid="JOB 38:41">اَور خُوراک کے بغیر اُڑتے پھرتے ہیں؟<verse eid="JOB 38:41"/></para>
  <para style="b"/>
  <chapter eid="JOB 38"/>
  <chapter number="39" style="c" sid="JOB 39"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 39:1"/>”کیا تُم جانتے ہو کہ پہاڑی بکریاں کب بچّے دیتی ہیں؟</para>
  <para style="q2" vid="JOB 39:1">اَور ہِرنی کب بچّے دیتی ہے؟<verse eid="JOB 39:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 39:2"/>کیا تُم اُن کے حَمل کے مہینوں کا شُمار رکھتے ہو؟</para>
  <para style="q2" vid="JOB 39:2">یا جانتے ہو، وہ کس موسم میں جنتی ہیں؟<verse eid="JOB 39:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 39:3"/>وہ جھکتی ہیں اَور اَپنا بچّہ دیتی ہیں؛</para>
  <para style="q2" vid="JOB 39:3">اَور دردِزہ سے رِہائی پاتی ہیں۔<verse eid="JOB 39:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 39:4"/>اُن کے بچّے جنگلوں میں بڑھتے اَور قُوّت پاتے ہیں؛</para>
  <para style="q2" vid="JOB 39:4">وہ چلے جاتے ہیں اَور اَپنی ماؤں کے پاس واپس نہیں آتے۔<verse eid="JOB 39:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 39:5"/>”گورخر کو کس نے آزاد کیا؟</para>
  <para style="q2" vid="JOB 39:5">اُس کے بند کس نے کھولے؟<verse eid="JOB 39:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 39:6"/>مَیں نے بنجر زمین کو اُس کا گھر بنایا،</para>
  <para style="q2" vid="JOB 39:6">اَور زمینِ شور کو اُس کا مَسکن۔<verse eid="JOB 39:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 39:7"/>شہر کا شوروغل اُس تک نہیں پہُنچ پاتا؛</para>
  <para style="q2" vid="JOB 39:7">وہ گاڑی بان کی ہُنکار نہیں سُنتا۔<verse eid="JOB 39:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 39:8"/>وہ چراگاہوں کی کھوج میں، پہاڑیوں پر گھُومتا ہے</para>
  <para style="q2" vid="JOB 39:8">اَور سبزہ زاروں کی جُستُجو میں لگا رہتاہے۔<verse eid="JOB 39:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 39:9"/>”کیا کویٔی جنگلی سانڈ تمہاری خدمت کرنے پر راضی ہوگا؟</para>
  <para style="q2" vid="JOB 39:9">کیا وہ تمہاری چرنی کے پاس رات کاٹے گا؟<verse eid="JOB 39:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 39:10"/>کیا تُم جنگلی سانڈ کو رسّی سے باندھ کر ریگھاری میں چلا سکتے ہو؟</para>
  <para style="q2" vid="JOB 39:10">کیا وہ تمہارے پیچھے پیچھے وادی میں ہل جوتیں گے؟<verse eid="JOB 39:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 39:11"/>کیا تُم اُس کی بڑی طاقت کی بنا پر اُس پر بھروسا کروگے؟</para>
  <para style="q2" vid="JOB 39:11">کیا تُم اَپنا بھاری کام اُس پر چھوڑ دوگے؟<verse eid="JOB 39:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 39:12"/>کیا تُم اُس سے اُمّید کروگے کہ وہ تمہاری فصل ڈھوئے</para>
  <para style="q2" vid="JOB 39:12">اَور اُسے تمہارے کھلیان میں جمع کرے؟<verse eid="JOB 39:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 39:13"/>”شتر مُرغ کے پر خُوشی سے پھڑپھڑاتے ہیں،</para>
  <para style="q2" vid="JOB 39:13">لیکن اُن کا لق لق کے</para>
  <para style="q2" vid="JOB 39:13">پر و بازو سے کیا مُقابلہ۔<verse eid="JOB 39:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 39:14"/>اُس کی مادہ اَپنے اَنڈے زمین پر چھوڑ جاتی ہے</para>
  <para style="q2" vid="JOB 39:14">اَور اُنہیں ریت میں گرم ہونے دیتی ہے۔<verse eid="JOB 39:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 39:15"/>لیکن بھُول جاتی ہے کہ کسی کا پاؤں اُنہیں کُچل سَکتا ہے،</para>
  <para style="q2" vid="JOB 39:15">یا کویٔی جنگلی جانور اُنہیں روند سَکتا ہے۔<verse eid="JOB 39:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 39:16"/>وہ اَپنے بچّوں پر سختی کرتی ہے، گویا وہ اُس کے اَپنے نہیں؛</para>
  <para style="q2" vid="JOB 39:16">اگر اُس کی محنت رائگاں جائے تو اُسے کیا پروا،<verse eid="JOB 39:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 39:17"/>کیونکہ خُدا نے اُسے حِکمت سے محروم رکھا ہے</para>
  <para style="q2" vid="JOB 39:17">نہ ہی اُسے فہم بخشا ہے۔<verse eid="JOB 39:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 39:18"/>پھر بھی جَب وہ دَوڑنے کے لیٔے اَپنے بازو پھیلاتی ہے،</para>
  <para style="q2" vid="JOB 39:18">تو گھوڑے اَور اُس کے سوار کو پیچھے چھوڑ دیتی ہے۔<verse eid="JOB 39:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 39:19"/>”کیا گھوڑے کو اُس کی طاقت تُم دیتے ہو</para>
  <para style="q2" vid="JOB 39:19">یا اُس کی گردن کو لہراتی ہُوئی ایال<note caller="+" style="f"><char style="fr" closed="false">39‏:19 </char><char style="fq" closed="false">ایال </char><char style="ft" closed="false">گھوڑے کی گردن کے لٹکے بال</char></note> تُم نے پہنائی ہے؟<verse eid="JOB 39:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 39:20"/>کیا تُم اُسے ٹِڈّی کی طرح کُداتے ہو،</para>
  <para style="q2" vid="JOB 39:20">جِس کی تیز ہنہناہٹ ہیبت پیدا کرتی ہے؟<verse eid="JOB 39:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 39:21"/>وہ شان سے اکڑتا ہے اَور زور سے کُھر مارتا ہے،</para>
  <para style="q2" vid="JOB 39:21">اَور جنگی میدان میں کود پڑتا ہے۔<verse eid="JOB 39:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 39:22"/>خوف اُس کے سامنے کیا ہے، وہ کسی شَے سے نہیں ڈرتا؛</para>
  <para style="q2" vid="JOB 39:22">نہ ہی تلوار سے مُنہ موڑتا ہے۔<verse eid="JOB 39:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 39:23"/>ترکش، چمکدار نیزہ اَور بھالا،</para>
  <para style="q2" vid="JOB 39:23">اُس کے بازو سے کھڑکھڑاتے ہُوئے نکل جاتے ہیں۔<verse eid="JOB 39:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 39:24"/>دیوانگی و جوش میں وہ زمین کھود ڈالتا ہے؛</para>
  <para style="q2" vid="JOB 39:24">نرسنگے کی آواز سُن کر وہ خاموش کھڑا ہی نہیں رہ سَکتا۔<verse eid="JOB 39:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 39:25"/>نرسنگے کی آواز سُن کر وہ ہنہناتا ہے گویا، ’آہا!‘ کہتا ہو،</para>
  <para style="q2" vid="JOB 39:25">اَور سپہ سالاروں کی للکار اَور لڑائی کے نعروں کا اَندازہ لگا لیتا ہے۔<verse eid="JOB 39:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 39:26"/>”کیا باز تمہاری حِکمت سے اُڑان بھرتاہے</para>
  <para style="q2" vid="JOB 39:26">اَور اَپنے بازو جُنوب کی طرف پھیلاتا ہے؟<verse eid="JOB 39:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 39:27"/>کیا عُقاب تمہارے حُکم سے بُلندی پر پرواز کرتا ہے</para>
  <para style="q2" vid="JOB 39:27">اَور چٹّان کی چوٹی پر اَپنا گھونسلہ بناتا ہے؟<verse eid="JOB 39:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 39:28"/>وہ چٹّان پر رہتاہے اَور رات کو وہیں بسیرا کرتا ہے؛</para>
  <para style="q2" vid="JOB 39:28">ایک پتھریلی ناہموار چٹّان اُس کی جائے پناہ ہے۔<verse eid="JOB 39:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 39:29"/>وہیں سے وہ اَپنا شِکار ڈھونڈتا ہے؛</para>
  <para style="q2" vid="JOB 39:29">جسے اُس کی آنکھیں دُور سے تاڑ لیتی ہیں۔<verse eid="JOB 39:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 39:30"/>اُس کے بچّوں کو خُون مرغوب ہے،</para>
  <para style="q2" vid="JOB 39:30">اَور جہاں مقتول ہیں وہاں وہ ہے۔“<note caller="+" style="f"><char style="fr" closed="false">39‏:30 </char><char style="ft" closed="false"><char style="xt"><ref loc="MAT 24:28">مت 24‏:28</ref>؛ <ref loc="LUK 17:37">لُوق 17‏:37</ref>‏</char></char></note><verse eid="JOB 39:30"/></para>
  <chapter eid="JOB 39"/>
  <chapter number="40" style="c" sid="JOB 40"/>
  <para style="p">
    <verse number="1" style="v" sid="JOB 40:1"/>تَب یَاہوِہ نے ایُّوب سے فرمایا:<verse eid="JOB 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 40:2"/>”جو قادرمُطلق کی شکایت کرتا ہے، کیا اُس کی تادیب نہیں ہونا چاہئے؟</para>
  <para style="q2" vid="JOB 40:2">جو خُدا پر اِلزام لگاتاہے اُسے اُن باتوں کا جَواب بھی دینا ہوگا۔“<verse eid="JOB 40:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JOB 40:3"/>تَب ایُّوب نے یَاہوِہ کو جَواب دیا:<verse eid="JOB 40:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 40:4"/>”میں ناچیز ہُوں۔ مَیں آپ کو کیسے جَواب دُوں؟</para>
  <para style="q2" vid="JOB 40:4">میں اَپنا ہاتھ اَپنے مُنہ پر رکھتا ہُوں۔<verse eid="JOB 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 40:5"/>میں ایک بار بول چُکا ہُوں لیکن مُجھے جَواب نہیں مِلا</para>
  <para style="q2" vid="JOB 40:5">بَلکہ دو بار، پر اَب اَور نہ بولُوں گا۔“<verse eid="JOB 40:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 40:6"/>تَب یَاہوِہ نے ایُّوب کو بگولے میں سے جَواب دیا:<verse eid="JOB 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 40:7"/>”مَرد کی مانند اَپنی کمر باندھو؛</para>
  <para style="q2" vid="JOB 40:7">میں تُم سے سوال کروں گا،</para>
  <para style="q2" vid="JOB 40:7">اَور تُم مُجھے جَواب دوگے۔<verse eid="JOB 40:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 40:8"/>”کیا، تُم میرے اِنصاف کو باطِل ٹھہراؤگے؟</para>
  <para style="q2" vid="JOB 40:8">خُود کو راست ٹھہرانے کے لیٔے کیا تُم مُجھے مُلزم قرار دوگے؟<verse eid="JOB 40:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 40:9"/>کیا تمہارا بازو خُدا کا سا ہے</para>
  <para style="q2" vid="JOB 40:9">اَور کیا، تُم اُن کی آواز کی طرح گرج سکتے ہو؟<verse eid="JOB 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 40:10"/>خُود کو جلال اَور شوکت سے آراستہ کرو،</para>
  <para style="q2" vid="JOB 40:10">اَور حشمت اَور جلال سے ملبوس ہو جاؤ۔<verse eid="JOB 40:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 40:11"/>اَپنے قہر کا سیلاب بہا دو،</para>
  <para style="q2" vid="JOB 40:11">ہر مغروُر اِنسان کو دیکھو اَور اُسے نیچا دِکھاؤ۔<verse eid="JOB 40:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 40:12"/>ہر مغروُر اِنسان پر نظر ڈالو اَور اُسے فروتن کرو،</para>
  <para style="q2" vid="JOB 40:12">بدکار جہاں کھڑے ہُوں وہیں اُنہیں پامال کر دو۔<verse eid="JOB 40:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 40:13"/>اُن سَب کو ایک ساتھ مٹّی میں دفن کر دو؛</para>
  <para style="q2" vid="JOB 40:13">اُن کے چہروں کو قبر میں کفن سے ڈھانک دو۔<verse eid="JOB 40:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 40:14"/>تَب میں خُود قائل ہو جاؤں گا،</para>
  <para style="q2" vid="JOB 40:14">کہ تمہارا اَپنا داہنا ہاتھ تُمہیں بچا سَکتا ہے۔<verse eid="JOB 40:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 40:15"/>”دریائی گھوڑے<note caller="+" style="f"><char style="fr" closed="false">40‏:15 </char><char style="fq" closed="false">دریائی گھوڑے </char><char style="ft" closed="false">ہپوپوٹیمس</char></note> کو دیکھو</para>
  <para style="q2" vid="JOB 40:15">جسے مَیں نے تمہارے ساتھ ساتھ بنایا،</para>
  <para style="q2" vid="JOB 40:15">جو بَیل کی طرح گھاس کھاتا ہے۔<verse eid="JOB 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 40:16"/>اُس کا زور اُس کی کمر میں ہے،</para>
  <para style="q2" vid="JOB 40:16">اَور اُس کے پیٹ کے پٹھّے کس قدر مضبُوط ہیں!<verse eid="JOB 40:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 40:17"/>اُس کی دُم دیودار کی طرح ہلتی ہے</para>
  <para style="q2" vid="JOB 40:17">اُس کی رانوں کی نسیں باہم مربوط ہیں؛<verse eid="JOB 40:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 40:18"/>اُس کی ہڈّیاں کانسے کی نلیوں کی طرح،</para>
  <para style="q2" vid="JOB 40:18">اَور اُس کے اَعضا لوہے کی سلاخوں کی مانند ہیں۔<verse eid="JOB 40:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 40:19"/>وہ خُدا کی تخلیق کا شاہکار ہے،</para>
  <para style="q2" vid="JOB 40:19">پھر بھی اُس کا خالق تلوار لے کر ہی اُس کے پاس آسکتا ہے۔<verse eid="JOB 40:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 40:20"/>پہاڑیاں اُس کے لیٔے چارا لاتی ہیں،</para>
  <para style="q2" vid="JOB 40:20">جہاں تمام جنگلی جانور آس پاس کھیلتے کودتے ہیں۔<verse eid="JOB 40:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 40:21"/>کنول کے پَودوں کے نیچے وہ لیٹتا ہے،</para>
  <para style="q2" vid="JOB 40:21">اَور دلدل کے سَرکنڈوں کی آڑ میں چھُپا رہتاہے۔<verse eid="JOB 40:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 40:22"/>کنول اَپنی چھاؤں میں اُسے چھُپا لیتے ہیں؛</para>
  <para style="q2" vid="JOB 40:22">دریا کے بید کے درخت اُسے گھیر لیتے ہیں۔<verse eid="JOB 40:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 40:23"/>اگر دریا میں باڑھ بھی ہو تو وہ نہیں گھبراتا؛</para>
  <para style="q2" vid="JOB 40:23">خواہ دریائے یردنؔ اُس کے مُنہ تک چڑھ آئے وہ محفوظ رہتاہے۔<verse eid="JOB 40:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 40:24"/>کیا کویٔی اُسے جَب وہ ہوشیار ہو تو پکڑ سَکتا ہے،</para>
  <para style="q2" vid="JOB 40:24">یا پھندا لگا کر اُس کی ناک چھید کر نتھ پہنا سَکتا ہے؟<verse eid="JOB 40:24"/></para>
  <para style="b"/>
  <chapter eid="JOB 40"/>
  <chapter number="41" style="c" sid="JOB 41"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 41:1"/>”کیا تُم لِویاتان<note caller="+" style="f"><char style="fr" closed="false">41‏:1 </char><char style="fq" closed="false">لِویاتان </char><char style="ft" closed="false">ایک بہت بڑی سمُندری مخلُوق مگرمچھ اُس کا ذِکر <char style="xt"><ref loc="JOB 3:8">ایُّو 3‏:8</ref>‏</char> میں بھی ہے۔</char></note> کو مچھلی پکڑنے والے کانٹے سے پانی میں سے کھینچ سکتے ہو؟</para>
  <para style="q2" vid="JOB 41:1">یا اُس کی زبان کو رسّی سے باندھ سکتے ہو؟<verse eid="JOB 41:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 41:2"/>کیا تُم اُس کی ناک میں رسّی ڈال سکتے ہو،</para>
  <para style="q2" vid="JOB 41:2">یا اُس کا جَبڑا کانٹے سے چھید سکتے ہو؟<verse eid="JOB 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 41:3"/>کیا وہ تمہاری مَنّت سماجت کرتا رہے گا؟</para>
  <para style="q2" vid="JOB 41:3">یا وہ تُم سے میٹھی میٹھی باتیں کرےگا؟<verse eid="JOB 41:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 41:4"/>کیا وہ تمہارے ساتھ کویٔی عہد باندھے گا</para>
  <para style="q2" vid="JOB 41:4">کہ تُم اُسے عمر بھرکے لیٔے غُلام بنا لوگے؟<verse eid="JOB 41:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 41:5"/>کیا تُم اُسے چڑیا کی طرح پالتو بنا سکوگے</para>
  <para style="q2" vid="JOB 41:5">یا اَپنی جَوان لڑکیوں<note caller="+" style="f"><char style="fr" closed="false">41‏:5 </char><char style="fq" closed="false">جَوان لڑکیوں </char><char style="ft" closed="false">خادِمائیں</char></note> کی خاطِر اُسے باندھ کر رکھوگے؟<verse eid="JOB 41:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 41:6"/>کیا تاجر اُس کا سَودا کریں گے؟</para>
  <para style="q2" vid="JOB 41:6">کیا وہ اُسے سوداگروں میں تقسیم کریں گے؟<verse eid="JOB 41:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 41:7"/>کیا تُم اُس کی کھال کو بھالوں سے</para>
  <para style="q2" vid="JOB 41:7">یا اُس کے سَر کو مچھیروں کی برچھیوں سے بھر سکتے ہو؟<verse eid="JOB 41:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 41:8"/>اگر تُم اَپنا ہاتھ اُس پر رکھو،</para>
  <para style="q2" vid="JOB 41:8">تو تُم اُس کشمش کو کبھی نہ بھُولوگے اَور پھر کبھی اَیسا نہ کروگے!<verse eid="JOB 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 41:9"/>اُسے قابُو میں کرنے کی ہر اُمّید جھُوٹی ہے؛</para>
  <para style="q2" vid="JOB 41:9">وہ ہمّت ہارتا ہے آدمی نیچے گِر جاتا ہے۔<verse eid="JOB 41:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 41:10"/>کویٔی اِس قدر تُندخو نہیں جو اُسے چھیڑنے کی جُرأت کرے۔</para>
  <para style="q2" vid="JOB 41:10">پھر وہ کون ہے جو میرے سامنے کھڑا ہو سکے؟<verse eid="JOB 41:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 41:11"/>کون ہے جو مُجھ سے دعویٰ کے ساتھ مطالبہ کرتا ہے جسے میں اَدا کروں؟</para>
  <para style="q2" vid="JOB 41:11">آسمان کے نیچے کی ہر شَے میری ہے۔<note caller="+" style="f"><char style="fr" closed="false">41‏:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="ROM 11:35-36">رُوم 11‏:35‏‑36</ref>‏</char></char></note><verse eid="JOB 41:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 41:12"/>”میں اُس کے اَعضا، اُس کی عظیم طاقت،</para>
  <para style="q2" vid="JOB 41:12">اَور اُس کے خُوبصورت ڈیل ڈول کے بارے میں بولنے سے باز نہ آؤں گا۔<note caller="+" style="f"><char style="fr" closed="false">41‏:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 1:25">پیدا 1‏:25</ref>‏</char></char></note><verse eid="JOB 41:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 41:13"/>اُس کے اُوپر کا لباس کون اُتار سَکتا ہے؟</para>
  <para style="q2" vid="JOB 41:13">اَور کون اُسے لگام دے گا؟<verse eid="JOB 41:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 41:14"/>اُس کے مُنہ کے دروازے کھولنے کی کون جُرأت کرےگا،</para>
  <para style="q2" vid="JOB 41:14">جو اُس کے دہشت ناک دانتوں کے دائرے سے گھرے ہُوئے ہیں؟<verse eid="JOB 41:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 41:15"/>اُس کی پیٹھ پر ڈھالیں صف آرا ہیں؛</para>
  <para style="q2" vid="JOB 41:15">جو نہایت مضبُوطی سے ایک دُوسرے سے جُڑی ہُوئی ہیں۔<verse eid="JOB 41:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 41:16"/>وہ ایک دُوسرے سے اِس قدر مِلی ہُوئی ہیں</para>
  <para style="q2" vid="JOB 41:16">کہ اُن کے درمیان سے ہَوا بھی گزر نہ سکے۔<verse eid="JOB 41:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 41:17"/>وہ باہم پیوستہ ہیں؛</para>
  <para style="q2" vid="JOB 41:17">اَور ایک دُوسرے سے اَیسی جُڑی ہُوئی ہیں کہ جُدا نہیں کی جا سکتیں۔<verse eid="JOB 41:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 41:18"/>اُس کی چھینک گویا رَوشنی کی شعائیں پھینکتی ہے؛</para>
  <para style="q2" vid="JOB 41:18">اَور اُس کی آنکھیں صُبح کی جھلملاتی کرنوں کی مانند ہیں۔<verse eid="JOB 41:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 41:19"/>اُس کے مُنہ سے جلتی ہُوئی مشعلیں نکلتی ہیں؛</para>
  <para style="q2" vid="JOB 41:19">گویا آگ کی چنگاریاں تیروں کی طرح اُڑتی ہُوں۔<verse eid="JOB 41:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 41:20"/>اُس کے نتھنوں سے اَیسا دُھواں نکلتا ہے</para>
  <para style="q2" vid="JOB 41:20">جَیسے اُبلتی ہُوئی دیگ سے جو جلتے ہویٔے سَرکنڈوں پر رکھی ہو۔<verse eid="JOB 41:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 41:21"/>اُس کا سانس کوئلوں کو دہکا دیتاہے،</para>
  <para style="q2" vid="JOB 41:21">اَور اُس کے مُنہ سے شُعلے لپکتے ہیں۔<verse eid="JOB 41:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 41:22"/>طاقت اُس کی گردن میں سمائی ہُوئی ہے؛</para>
  <para style="q2" vid="JOB 41:22">اَور دہشت اُس کے آگے آگے چلتی ہے۔<verse eid="JOB 41:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 41:23"/>اُس کے گوشت کی تہیں مضبُوطی سے جُڑی ہُوئی ہیں؛</para>
  <para style="q2" vid="JOB 41:23">جو بڑی پیوستہ اَور غَیر متحّرک ہیں۔<verse eid="JOB 41:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 41:24"/>اُس کا سینہ چٹّان کی طرح سخت ہے،</para>
  <para style="q2" vid="JOB 41:24">ہُوبہو چکّی کے نِچلے پاٹ کی طرح۔<verse eid="JOB 41:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 41:25"/>جَب خُدا اُٹھ کھڑا ہوتاہے تو بہادر لوگ ڈر جاتے ہیں؛</para>
  <para style="q2" vid="JOB 41:25">اِس سے قبل کہ وہ اُن پر ٹوٹ پڑے، وہ پیچھے ہٹ جاتے ہیں۔<verse eid="JOB 41:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 41:26"/>تلوار کا وار اُس پر کویٔی اثر نہیں کرتا،</para>
  <para style="q2" vid="JOB 41:26">نہ ہی نیزہ، تیر یا برچھی۔<note caller="+" style="f"><char style="fr" closed="false">41‏:26 </char><char style="ft" closed="false"><char style="xt"><ref loc="JOB 39:21-24">ایُّو 39‏:21‏‑24</ref>‏</char></char></note><verse eid="JOB 41:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 41:27"/>وہ لوہے کو بھُوسا سمجھتا ہے،</para>
  <para style="q2" vid="JOB 41:27">اَور کانسے کو سڑی ہُوئی لکڑی کی مانند۔<verse eid="JOB 41:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 41:28"/>تیر اُس کو بھگا نہیں پاتے؛</para>
  <para style="q2" vid="JOB 41:28">فلاخن کے پتّھر اُس کے لیٔے بھُوسا ہیں۔<verse eid="JOB 41:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 41:29"/>لٹھ اُسے گھاس کے تنکے مَعلُوم ہوتے ہیں؛</para>
  <para style="q2" vid="JOB 41:29">اَور برچھی کے کھڑکھڑانے پر وہ ہنستا ہے۔<verse eid="JOB 41:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 41:30"/>اُس کے نیچے کے حِصّے تیز ٹھیکروں کی مانند ہیں،</para>
  <para style="q2" vid="JOB 41:30">جو وزنی ہتھوڑے کی طرح مٹّی میں نِشان چھوڑ جاتے ہیں۔<verse eid="JOB 41:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 41:31"/>وہ گہراؤ کو اُبلتی ہُوئی دیگ کی طرح کھَولاتا ہے</para>
  <para style="q2" vid="JOB 41:31">اَور سمُندر کو مرہم (کے مرتبان) کی طرح ہلاتا ہے۔<verse eid="JOB 41:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 41:32"/>وہ اَپنے پیچھے پانی کی ایک چمکتی دمکتی ہموار لکیر چھوڑ جاتا ہے؛</para>
  <para style="q2" vid="JOB 41:32">جِس سے یہ لگتا ہے کہ گہراؤ سفید بالوں والا ہو گیا ہے۔<note caller="+" style="f"><char style="fr" closed="false">41‏:32 </char><char style="ft" closed="false"><char style="xt"><ref loc="JOB 38:30">ایُّو 38‏:30</ref>‏</char></char></note><verse eid="JOB 41:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 41:33"/>زمین پر اُس کا کویٔی ثانی نہیں</para>
  <para style="q2" vid="JOB 41:33">ایک بے خوف مخلُوق۔<verse eid="JOB 41:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 41:34"/>وہ بُلندیوں کو حقارت کی نظر سے دیکھتا ہے؛</para>
  <para style="q2" vid="JOB 41:34">وہ مغروُروں پر بادشاہی کرتا ہے۔“<verse eid="JOB 41:34"/></para>
  <chapter eid="JOB 41"/>
  <chapter number="42" style="c" sid="JOB 42"/>
  <para style="s1">ایُّوب کا جَواب</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 42:1"/>تَب ایُّوب نے یَاہوِہ کو جَواب دیا:<verse eid="JOB 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 42:2"/>”اَے یَاہوِہ، میں جانتا ہُوں کہ آپ سَب کچھ کر سکتے ہیں؛</para>
  <para style="q2" vid="JOB 42:2">آپ کا کویٔی منصُوبہ غَیر ممکن نہیں۔<note caller="+" style="f"><char style="fr" closed="false">42‏:2 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 19:21">امثا 19‏:21</ref>؛ <ref loc="ISA 14:27">یَشع 14‏:27</ref>؛ <ref loc="MRK 10:27">مرقُ 10‏:27</ref>‏</char></char></note><verse eid="JOB 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 42:3"/>آپ نے پُوچھا، یہ کون ہے جو نادانی سے میری مشورت پر پردہ ڈالتا ہے؟</para>
  <para style="q2" vid="JOB 42:3">یقیناً مَیں نے اَیسی باتیں کہیں جنہیں میں نہ سمجھتا تھا،</para>
  <para style="q2" vid="JOB 42:3">اَیسی چیزیں جنہیں جاننا میرے لیٔے بہت ہی عجِیب تھا۔<verse eid="JOB 42:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 42:4"/>”آپ نے کہا: ’اَب تُم سُنو، اَور مَیں بولُوں گا؛</para>
  <para style="q2" vid="JOB 42:4">میں تُم سے سوال پُوچھوں گا،</para>
  <para style="q2" vid="JOB 42:4">اَور تُم مُجھے جَواب دوگے۔‘<verse eid="JOB 42:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 42:5"/>میرے کانوں نے تمہارے بارے میں سُنا تھا،</para>
  <para style="q2" vid="JOB 42:5">لیکن اَب میری آنکھوں نے آپ کو دیکھ لیا ہے۔<verse eid="JOB 42:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 42:6"/>اِس لیٔے مُجھے اَپنے آپ سے نفرت ہے،</para>
  <para style="q2" vid="JOB 42:6">اَور مَیں خاک اَور راکھ<note caller="+" style="f"><char style="fr" closed="false">42‏:6 </char><char style="fq" closed="false">خاک اَور راکھ </char><char style="ft" closed="false">لوگ اَپنے غم کے اِظہار کے لیٔے لوگ اَپنے سَروں پر مٹّی چھڑکتے تھے۔</char></note> میں تَوبہ کرتا ہُوں۔“<verse eid="JOB 42:6"/></para>
  <para style="s1">اِختتام</para>
  <para style="p">
    <verse number="7" style="v" sid="JOB 42:7"/>جَب یَاہوِہ ایُّوب سے یہ باتیں فرما چُکے، تَب خُدا نے اِلیفزؔ تیمانی سے فرمایا: ”میں تُم سے اَور تمہارے دونوں دوستوں سے خفا ہُوں کیونکہ تُم نے میرے بارے میں وہ نہ کہا جو سچ ہے جَیسا کہ میرے خادِم ایُّوب نے کہا۔ <verse eid="JOB 42:7"/><verse number="8" style="v" sid="JOB 42:8"/>پس اَب سات بَیل اَور سات مینڈھے لے کر اَور میرے خادِم ایُّوب کے پاس جا کر اَپنے لیٔے سوختنی نذر پیش کرو۔ میرا خادِم ایُّوب تمہارے لیٔے دعا کرےگا، اَور مَیں اُس کی دعا قبُول کروں گا، اَور مَیں تمہاری حماقت کے مُطابق تُم سے سلُوک نہ کروں گا۔ تُم نے میرے بارے میں وہ نہیں کہا جو حق ہے جَیسے میرے خادِم ایُّوب نے کہاتھا۔“ <verse eid="JOB 42:8"/><verse number="9" style="v" sid="JOB 42:9"/>چنانچہ اِلیفزؔ تیمانی، بِلددؔ شوحی اَور صُوفرؔ نَعماتی نے جا کر وُہی کیا جو یَاہوِہ نے اُنہیں فرمایا تھا اَور یَاہوِہ نے ایُّوب کی دعا قبُول فرمائی۔<verse eid="JOB 42:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JOB 42:10"/>ایُّوب نے اَپنے دوستوں کے لیٔے دعا مانگی اَور اُس کے بعد یَاہوِہ نے ایُّوب کو پھر سے سرفراز کیا اَورجو اُن کے پاس پہلے تھا اُس سے بھی دُگنا زِیادہ دے دیا۔ <verse eid="JOB 42:10"/><verse number="11" style="v" sid="JOB 42:11"/>ایُّوب کے تمام بھایٔی اَور بہنیں اَور ہر کویٔی جو اُن کو پہلے سے جانتے تھے آئے اَور اُنہُوں نے ایُّوب کے گھر میں اُن کے ساتھ کھانا کھایا اَور اُن تمام بَلاؤں کے لیٔے جو یَاہوِہ نے ایُّوب پر بھیجی تھیں اُن کو تسلّی دی۔ اَور ہر ایک نے ایُّوب کو چاندی کا ایک ایک سِکّہ اَور سونے کی ایک ایک انگُوٹھی دی۔<note caller="+" style="f"><char style="fr" closed="false">42‏:11 </char><char style="ft" closed="false">یہ چاندی کا ایک بنا ہُوا ٹکڑا تھا جو سِکّے بنانے سے پہلے خریدوفروخت میں اِستعمال ہوتا تھا۔ سونے کی انگُوٹھی ایک زیور تھا جو عورتیں ناک میں پہنتی تھیں (<char style="xt"><ref loc="GEN 24:47">پیدا 24‏:47</ref>؛ <ref loc="ISA 3:21">یَشع 3‏:21</ref>‏</char>) اَور مَرد اَور عورتیں کانوں میں پہنتی تھیں (<char style="xt"><ref loc="GEN 35:4">پیدا 35‏:4</ref>؛ <ref loc="EXO 32:2-3">خُرو 32‏:2‏‑3</ref>؛ <ref loc="JDG 8:24">قُضا 8‏:24</ref>‏</char>)</char></note><verse eid="JOB 42:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JOB 42:12"/>یَاہوِہ نے ایُّوب کو اُن کے آخِری ایّام میں پہلے کی بہ نِسبت زِیادہ برکت بخشی۔ اُن کے پاس چودہ ہزار بھیڑیں، چھ ہزار اُونٹ، بَیل کی ایک ہزار جوڑیاں اَور ہزار گدھیاں ہو گئیں۔ <verse eid="JOB 42:12"/><verse number="13" style="v" sid="JOB 42:13"/>اَور اُن کے سات بیٹے اَور تین بیٹیاں بھی ہُوئیں۔ <verse eid="JOB 42:13"/><verse number="14" style="v" sid="JOB 42:14"/>ایُّوب نے پہلی بیٹی کا نام یمیمہؔ، دُوسری کا قصیاہؔ اَور تیسری کا قَرنؔ ہپّوک رکھا۔ <verse eid="JOB 42:14"/><verse number="15" style="v" sid="JOB 42:15"/>اُس ساری سرزمین میں اَیسی عورتیں کہیں بھی نہ تھیں جو ایُّوب کی بیٹیوں کی طرح خُوبصورت ہُوں اَور اُن کے باپ نے اُنہیں اُن کے بھائیوں کے ساتھ مِیراث دی۔<verse eid="JOB 42:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JOB 42:16"/>اُس کے بعد ایُّوب ایک سَو چالیس بَرس زندہ رہے اَور اَپنے بیٹوں اَور اُن کے بچّوں کی چوتھی پُشت تک دیکھی۔ <verse eid="JOB 42:16"/><verse number="17" style="v" sid="JOB 42:17"/>اَور اِس طرح ایُّوب نے بُوڑھے اَور ضعیف ہوکر وفات پائی۔<verse eid="JOB 42:17"/></para>
  <chapter eid="JOB 42"/>
</usx>
