<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CH" style="id">- Biblica® Open Urdu Contemporary Version</book>
  <para style="h">1 تواریخ</para>
  <para style="toc1">پہلا تواریخ کی کِتاب</para>
  <para style="toc2">1 تواریخ</para>
  <para style="toc3">1 توا</para>
  <para style="mt1">پہلا تواریخ</para>
  <para style="mt2">کی کِتاب</para>
  <chapter number="1" style="c" sid="1CH 1"/>
  <para style="s1">آدمؔ سے لے کر اَبراہامؔ تک کا شجرہ نَسب</para>
  <para style="s2">بنی نُوح</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 1:1"/>آدمؔ، شیتؔ، انُوشؔ،<verse eid="1CH 1:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 1:2"/>قینانؔ، مہلل ایل، یاردؔ،<verse eid="1CH 1:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 1:3"/>حنوخؔ، متُوسِلحؔ، لمکؔ،</para>
  <para style="li1" vid="1CH 1:3">نُوح۔<verse eid="1CH 1:3"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="4" style="v" sid="1CH 1:4"/>بنی نُوح: شِمؔ، حامؔ اَور یافیتؔ۔<verse eid="1CH 1:4"/></para>
  <para style="s2">یافیتؔ کی نَسل</para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 1:5"/>بنی یافیتؔ یہ ہیں:</para>
  <para style="li2" vid="1CH 1:5">گومرؔ، ماگوگؔ، مِدائی، یاوانؔ، تُوبل، میشکؔ اَور تیِراسؔ تھے۔<verse eid="1CH 1:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 1:6"/>بنی گومرؔ یہ ہیں:</para>
  <para style="li2" vid="1CH 1:6">اشکِنازؔ، ریفتؔ اَور توغرمہؔ تھے۔<verse eid="1CH 1:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 1:7"/>بنی یاوانؔ یہ ہیں:</para>
  <para style="li2" vid="1CH 1:7">اِلیشہؔ، ترشیشؔ، کِتّیمؔ اَور رودانیم<note caller="+" style="f"><char style="fr" closed="false">1‏:7 </char><char style="fq" closed="false">رودانیم </char><char style="ft" closed="false">کچھ نُسخوں میں دودانیمؔ لِکھا ہے۔</char></note> تھے۔<verse eid="1CH 1:7"/></para>
  <para style="s1">بنی حامؔ کا شجرہ نَسب</para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 1:8"/>بنی حامؔ یہ ہیں:</para>
  <para style="li2" vid="1CH 1:8">کُوشؔ، مِصر، فُوطؔ اَور کنعانؔ ہُوئے۔<verse eid="1CH 1:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 1:9"/>بنی کُوشؔ یہ ہیں:</para>
  <para style="li2" vid="1CH 1:9">سیبا، حَویلہؔ، سبتہؔ، رعماہؔ اَور سبتیکا۔</para>
  <para style="li1" vid="1CH 1:9">بنی رعماہؔ:</para>
  <para style="li2" vid="1CH 1:9">شیبا اَور دِدانؔ۔<verse eid="1CH 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 1:10"/>کُوشؔ نِمرودؔ کا باپ تھا،</para>
  <para style="li2" vid="1CH 1:10">نِمرودؔ جو رُوئے زمین پر پہلا زبردست سُورما کے طور پر مشہُور ہُوا۔<verse eid="1CH 1:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 1:11"/>بنی مِصر:</para>
  <para style="li2" vid="1CH 1:11">لُودیؔم، عنامیمؔ، لہابیمؔ، نفتوحیؔم، <verse eid="1CH 1:11"/><verse number="12" style="v" sid="1CH 1:12"/>فتروسیم، کسلوحیم (جِن سے فلسطینی قوم نکلی) اَور کفتُوری۔<verse eid="1CH 1:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 1:13"/>بنی کنعانؔ</para>
  <para style="li2" vid="1CH 1:13">اُس کا پہلوٹھا صیدونؔ پیدا ہُوا اَور حِتّی، <verse eid="1CH 1:13"/><verse number="14" style="v" sid="1CH 1:14"/>یبُوسی، امُوری، گِرگاشی، <verse eid="1CH 1:14"/><verse number="15" style="v" sid="1CH 1:15"/>حِوّیؔ، عَرکی، سیِنی، <verse eid="1CH 1:15"/><verse number="16" style="v" sid="1CH 1:16"/>اَروادیؔ، ضِماریؔ اَور حماتیؔ تھے۔<verse eid="1CH 1:16"/></para>
  <para style="s2">بنی شِمؔ</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 1:17"/>بنی شِمؔ یہ ہیں:</para>
  <para style="li2" vid="1CH 1:17">عیلامؔ، اشُور، اَرفاکسَدؔ، لُودؔ اَور ارام تھے۔</para>
  <para style="li1" vid="1CH 1:17">اَور بنی ارام یہ ہیں:</para>
  <para style="li2" vid="1CH 1:17">عُوضؔ، حُولؔ، گیتھرؔ اَور میشکؔ۔<verse eid="1CH 1:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 1:18"/>اَرفاکسَدؔ شِلحؔ کا باپ تھا،</para>
  <para style="li2" vid="1CH 1:18">اَور شِلحؔ عِبرؔ کا باپ تھا۔<verse eid="1CH 1:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 1:19"/>اَور عِبرؔ کے دو بیٹے پیدا ہویٔے:</para>
  <para style="li2" vid="1CH 1:19">ایک کا نام پِلِگ<note caller="+" style="f"><char style="fr" closed="false">1‏:19 </char><char style="fq" closed="false">پِلِگ </char><char style="ft" closed="false">یعنی تقسیم</char></note> تھا کیونکہ اُن کے ایّام میں دُنیا کے لوگ تمام زبانوں میں تقسیم ہُوئے تھے اَور اُن کے بھایٔی کا نام یُقطانؔ تھا۔<verse eid="1CH 1:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 1:20"/>بنی یُقطانؔ یہ ہیں:</para>
  <para style="li2" vid="1CH 1:20">اَلمُودادؔ، شِلفؔ، حَصارمِبیتؔھ، یِراحؔ، <verse eid="1CH 1:20"/><verse number="21" style="v" sid="1CH 1:21"/>ہَدورامؔ، اُوزالؔ، دِقلہؔ، <verse eid="1CH 1:21"/><verse number="22" style="v" sid="1CH 1:22"/>عُبالؔ یا عیبالؔ، اَبی ماایلؔ، شیبا، <verse eid="1CH 1:22"/><verse number="23" style="v" sid="1CH 1:23"/>اوفیرؔ، حَویلہؔ اَور یُوبابؔ پیدا ہویٔے۔ یہ سَب یُقطانؔ کے بیٹے تھے۔<verse eid="1CH 1:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 1:24"/>شِمؔ، اَرفاکسَدؔ، شِلحؔ،<verse eid="1CH 1:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 1:25"/>عِبرؔ، پِلِگ، رِعوؔ،<verse eid="1CH 1:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 1:26"/>سِروگ، ناحوؔر، تیراحؔ،<verse eid="1CH 1:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 1:27"/>اَبرامؔ (یعنی اَبراہامؔ)۔<verse eid="1CH 1:27"/></para>
  <para style="s1">اَبراہامؔ کا خاندان</para>
  <para style="lh">
    <verse number="28" style="v" sid="1CH 1:28"/>اَبراہامؔ کے بیٹے: اِصحاقؔ اَور اِشمعیل تھے۔<verse eid="1CH 1:28"/></para>
  <para style="s2">ہاگرؔ سے اَبراہامؔ کی اَولاد</para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 1:29"/>اُن کی نَسل یہ ہے:</para>
  <para style="li2" vid="1CH 1:29">اِشمعیل کا پہلوٹھا نبایوتؔ جو اُس کے بعد، قیدارؔ، ادبیلؔ، مبسامؔ، <verse eid="1CH 1:29"/><verse number="30" style="v" sid="1CH 1:30"/>مِشماعؔ، دُومہؔ، مَسّا، حددؔ، تیماؔ <verse eid="1CH 1:30"/><verse number="31" style="v" sid="1CH 1:31"/>یطُورؔ، نافیشؔ اَور قِدمہؔ۔</para>
  <para style="lf" vid="1CH 1:31">یہ بنی اِشمعیل تھے۔<verse eid="1CH 1:31"/></para>
  <para style="s1">قِطورہؔ سے اَبراہامؔ کی اَولاد</para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 1:32"/>اَبراہامؔ کی داشتہ قِطورہؔ کی اَولاد یہ ہیں:</para>
  <para style="li2" vid="1CH 1:32">زِمرانؔ، یُقشانؔ، مِدان،</para>
  <para style="li2" vid="1CH 1:32">مِدیان، اِشبقؔ اَور شُوعؔح۔</para>
  <para style="li1" vid="1CH 1:32">اَور بنی یُقشانؔ سے:</para>
  <para style="li2" vid="1CH 1:32">شیبا اَور دِدانؔ۔<verse eid="1CH 1:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 1:33"/>اَور بنی مِدیان یہ ہیں:</para>
  <para style="li2" vid="1CH 1:33">عیفاہؔ، عِفرؔ، حنوخؔ، اَبیداعؔ اَور اِلدعؔح تھے۔</para>
  <para style="lf" vid="1CH 1:33">یہ سَب قِطورہؔ کی اَولاد تھے۔<verse eid="1CH 1:33"/></para>
  <para style="s2">سارہؔ سے اَبراہامؔ کی اَولاد</para>
  <para style="lh">
    <verse number="34" style="v" sid="1CH 1:34"/>اَبراہامؔ اِصحاقؔ کے والد تھے۔</para>
  <para style="li1" vid="1CH 1:34">بنی اِصحاقؔ:</para>
  <para style="li2" vid="1CH 1:34">عیسَوؔ اَور اِسرائیل۔<verse eid="1CH 1:34"/></para>
  <para style="s1">عیسَوؔ کے بیٹے</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 1:35"/>عیسَوؔ کے بیٹے یہ ہیں:</para>
  <para style="li2" vid="1CH 1:35">اِلیفزؔ، رِعوایلؔ، یعُوسؔ، یعلامؔ اَور قورحؔ۔<verse eid="1CH 1:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 1:36"/>بنی اِلیفزؔ:</para>
  <para style="li2" vid="1CH 1:36">تیمانؔ، اومرؔ، ضیفوؔ، گعتامؔ اَور قِنٰز؛</para>
  <para style="li2" vid="1CH 1:36">تِمنع سے عمالیقؔ۔<verse eid="1CH 1:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 1:37"/>رِعوایلؔ کے بیٹے یہ ہیں:</para>
  <para style="li2" vid="1CH 1:37">ناحات، زیراحؔ، شمّہ اَور مِزّہؔ۔<verse eid="1CH 1:37"/></para>
  <para style="s1">اِدُوم میں شعِیرؔ کے لوگ</para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 1:38"/>بنی سِعِیؔر:</para>
  <para style="li2" vid="1CH 1:38">لوطانؔ، شوبلؔ، ضِبعونؔ اَور عناہؔ، دیشونؔ، ایضرؔ اَور دیشانؔ۔<verse eid="1CH 1:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 1:39"/>بنی لوطانؔ یہ ہیں:</para>
  <para style="li2" vid="1CH 1:39">حَوریؔ اَور ہومامؔ۔ لوطانؔ کی ایک بہن بھی تھی جِس کا نام تِمنؔا تھا۔<verse eid="1CH 1:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 1:40"/>بنی شوبلؔ یہ ہیں:</para>
  <para style="li2" vid="1CH 1:40">علوانؔ، مناحاتؔ، عیبالؔ، شِفوؔ اَور اونامؔ۔</para>
  <para style="li1" vid="1CH 1:40">بنی ضِبعونؔ یہ ہیں:</para>
  <para style="li2" vid="1CH 1:40">ایّہ اَور عنہؔ۔<verse eid="1CH 1:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 1:41"/>عناہؔ کا بیٹا دیشونؔ تھا۔</para>
  <para style="li1" vid="1CH 1:41">دیشونؔ کے بیٹے یہ ہیں:</para>
  <para style="li2" vid="1CH 1:41">حیمدانؔ، اِشبانؔ، اِترانؔ اَور کِرانؔ۔<verse eid="1CH 1:41"/></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 1:42"/>بنی ایضرؔ:</para>
  <para style="li2" vid="1CH 1:42">بِلہانؔ، زعوانؔ اَور عقانؔ۔<note caller="+" style="f"><char style="fr" closed="false">1‏:42 </char><char style="fq" closed="false">عقانؔ</char><char style="ft" closed="false">کچھ نُسخوں میں یعقانؔ لِکھا ہے</char></note></para>
  <para style="li1" vid="1CH 1:42">دیشانؔ<note caller="+" style="f"><char style="fr" closed="false">1‏:42 </char><char style="fq" closed="false">دیشانؔ </char><char style="ft" closed="false">کچھ نُسخوں میں دیشونؔ لِکھا ہے</char></note> کے بیٹے یہ ہیں:</para>
  <para style="li2" vid="1CH 1:42">عُوضؔ اَور اَرانؔ۔<verse eid="1CH 1:42"/></para>
  <para style="s1">مُلکِ اِدُوم کے حُکمران</para>
  <para style="lh">
    <verse number="43" style="v" sid="1CH 1:43"/>یہ وہ بادشاہ ہیں جو اِسرائیلی بادشاہوں سے پیشتر مُلک اِدُوم میں حُکمرانی کی:</para>
  <para style="li1" vid="1CH 1:43">بَیلعؔ بِن بعورؔ۔ اُس کے شہر کا نام دِنہاباؔ تھا۔<verse eid="1CH 1:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 1:44"/>بَیلعؔ کی وفات کے بعد، اُس کی جگہ پر زیراحؔ بِن یُوبابؔ بادشاہ بنا۔ وہ بُضراؔہ کا باشِندہ تھا۔<verse eid="1CH 1:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 1:45"/>اَور یُوبابؔ کی وفات کے بعد، حُشامؔ اُس کا جانشین ہُوا۔ جو تیمانیوں کے مُلک کا باشِندہ تھا۔<verse eid="1CH 1:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 1:46"/>حُشامؔ کی وفات کے بعد اُس کی جگہ پر ہددؔ بِن بِددؔ جِس نے مُوآب کے مُلک میں مِدیانیوں کو شِکست دی تھی بادشاہ بنا۔ اَور اُس کے شہر کا نام عَوِیتؔ تھا۔<verse eid="1CH 1:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 1:47"/>ہددؔ کی وفات کے بعد، شَملہؔ اُس کی جگہ بادشاہ بنا جو مَشرِقہؔ کا باشِندہ تھا۔<verse eid="1CH 1:47"/></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 1:48"/>شَملہؔ کی وفات کے بعد شاؤل اُس کا جانشین ہُوا جو دریائے فراتؔ کے کنارے کے رحوبوتھؔ کا باشِندہ تھا۔<verse eid="1CH 1:48"/></para>
  <para style="li1">
    <verse number="49" style="v" sid="1CH 1:49"/>شاؤل کی وفات کے بعد، اُس کی جگہ پر بَعل حنانؔ بِن عکبورؔ بادشاہ بنا۔<verse eid="1CH 1:49"/></para>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 1:50"/>بَعل حنانؔ بِن عکبورؔ کی وفات کے بعد اُس کی جگہ پر ہددؔ بادشاہ بنا۔ اُس کے شہر کا نام پؔاؤُ تھا اَور اُس کی بیوی کا نام مہیطبیلؔ تھا جو مطرِدؔ کی بیٹی اَور میضاہابؔ کی نواسی تھی۔ <verse eid="1CH 1:50"/><verse number="51" style="v" sid="1CH 1:51"/>اِس کے بعد حددؔ کی بھی وفات ہو گئی۔</para>
  <para style="b" vid="1CH 1:51"/>
  <para style="lh" vid="1CH 1:51">مُلکِ اِدُوم کے سرداروں کے نام یہ ہیں جو ہددؔ کے بعد حُکمرانی کئے:</para>
  <para style="li1" vid="1CH 1:51">تِمنؔا، عَلوہؔ، یتیتؔ، <verse eid="1CH 1:51"/><verse number="52" style="v" sid="1CH 1:52"/>اُہلِیبامہؔ، اَیلہ، پِنونؔ، <verse eid="1CH 1:52"/><verse number="53" style="v" sid="1CH 1:53"/>قِنٰز، تیمانؔ، مِبضارؔ، <verse eid="1CH 1:53"/><verse number="54" style="v" sid="1CH 1:54"/>مَگدِایلؔ اَور عِرامؔ۔</para>
  <para style="lf" vid="1CH 1:54">یہ سَب مُلکِ اِدُوم کے سرداروں کے نام ہیں۔<verse eid="1CH 1:54"/></para>
  <chapter eid="1CH 1"/>
  <chapter number="2" style="c" sid="1CH 2"/>
  <para style="s1">بنی اِسرائیل</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 2:1"/>بنی اِسرائیل یہ تھے: رُوبِنؔ، شمعُونؔ، لیوی، یہُوداہؔ، یِسَّکاؔر اَور زبُولُون، <verse eid="1CH 2:1"/><verse number="2" style="v" sid="1CH 2:2"/>دانؔ، یُوسیفؔ، بِنیامین، نفتالی، گادؔ اَور آشیر۔<verse eid="1CH 2:2"/></para>
  <para style="s1">یہُوداہؔ تا بنی حِضرونؔ</para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 2:3"/>بنی یہُوداہؔ:</para>
  <para style="li2" vid="1CH 2:3">عیرؔ، اَونانؔ اَور شِلحؔ۔ یہ تینوں یہُوداہؔ کی کنعانی بیوی بَت شُوعؔ کے بطن سے پیدا ہُوئے تھے۔</para>
  <para style="li2" vid="1CH 2:3">(یہُوداہؔ کا پہلوٹھا عیرؔ یَاہوِہ کی نظر میں بدکار تھا اِس لیٔے یَاہوِہ نے اُسے مار ڈالا۔)<verse eid="1CH 2:3"/></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 2:4"/>اَور یہُوداہؔ کی بہُو تامارؔ سے یہُوداہؔ کے بیٹے پیریزؔ اَور زیراحؔ پیدا ہُوئے۔</para>
  <para style="lf" vid="1CH 2:4">یہُوداہؔ کے کل پانچ بیٹے تھے۔<verse eid="1CH 2:4"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 2:5"/>بنی پیریزؔ:</para>
  <para style="li2" vid="1CH 2:5">حِضرونؔ اَور حمُولؔ۔<verse eid="1CH 2:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 2:6"/>بنی زیراحؔ:</para>
  <para style="li2" vid="1CH 2:6">زِمریؔ، ایتھانؔ، ہیمانؔ، کال کولؔ اَور داراؔ<note caller="+" style="f"><char style="fr" closed="false">2‏:6 </char><char style="fq" closed="false">داراؔ </char><char style="ft" closed="false">چند نُسخوں میں داردعؔ بھی لِکھا ہے۔</char></note>۔ کُل پانچ بیٹے تھے۔<verse eid="1CH 2:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 2:7"/>بنی کرمی:</para>
  <para style="li2" vid="1CH 2:7">عکار،<note caller="+" style="f"><char style="fr" closed="false">2‏:7 </char><char style="fq" closed="false">عکار </char><char style="ft" closed="false">یعنی عقانؔ</char></note> یعنی اِسرائیل کی مُصیبت، جِس نے مخصُوص کی ہُوئی چیزوں میں خیانت کرکے اِسرائیل کے لیٔے مُصیبت پیدا کی تھی۔<verse eid="1CH 2:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 2:8"/>ایتھانؔ کا بیٹا</para>
  <para style="li2" vid="1CH 2:8">عزریاہؔ تھا۔<verse eid="1CH 2:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 2:9"/>بنی حِضرونؔ جو اُس سے پیدا ہُوئے:</para>
  <para style="li2" vid="1CH 2:9">یرحمئیلؔ، رامؔ اَور کالبؔ۔<verse eid="1CH 2:9"/></para>
  <para style="s1">رامؔ بِن حِضرونؔ</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 2:10"/>رامؔ سے عَمّیندابؔ</para>
  <para style="li1" vid="1CH 2:10">اَور عَمّیندابؔ سے نحشونؔ پیدا ہُوئے۔ نحشونؔ بنی یہُوداہؔ کا سردار ہُوا۔<verse eid="1CH 2:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 2:11"/>نحشونؔ سالماؔ یا سَلمونؔ پیدا ہُوئے،</para>
  <para style="li2" vid="1CH 2:11">اَور سَلمونؔ سے بُوعزؔ،<verse eid="1CH 2:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 2:12"/>اَور بُوعزؔ سے عوبیدؔ پیدا ہُوا</para>
  <para style="li2" vid="1CH 2:12">اَور عوبیدؔ سے یِشائی۔<verse eid="1CH 2:12"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 2:13"/>بنی یِشائی یہ تھے:</para>
  <para style="li2" vid="1CH 2:13">اُس کا پہلوٹھا بیٹا اِلیابؔ؛ دُوسرا بیٹا ابینادابؔ اَور تیسرا بیٹا شِمعاؔ۔ <verse eid="1CH 2:13"/><verse number="14" style="v" sid="1CH 2:14"/>چوتھا بیٹا نتنی ایل،</para>
  <para style="li2" vid="1CH 2:14">اَور پانچواں بیٹا ردّای، <verse eid="1CH 2:14"/><verse number="15" style="v" sid="1CH 2:15"/>چھٹا بیٹا اوضمؔ</para>
  <para style="li2" vid="1CH 2:15">اَور ساتواں بیٹا داویؔد۔<verse eid="1CH 2:15"/></para>
  <para style="li2">
    <verse number="16" style="v" sid="1CH 2:16"/>اَور ضرویاہؔ اَور ابیگیلؔ اُن کی بہنیں تھیں۔</para>
  <para style="li3" vid="1CH 2:16">اَور ابیشائی، یُوآبؔ اَور عساہیلؔ یہ تینوں ضرویاہؔ کے بیٹے تھے۔<verse eid="1CH 2:16"/></para>
  <para style="li3">
    <verse number="17" style="v" sid="1CH 2:17"/>اَور ابیگیلؔ سے عماساؔ پیدا ہُوا اَور اُس کا باپ یترؔ اِشمعیلی تھا۔<verse eid="1CH 2:17"/></para>
  <para style="s2">کالبؔ بِن حِضرونؔ</para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 2:18"/>کالبؔ بِن حِضرونؔ کی بیوی عزُوباہ اَور یریعوتؔ سے یہ فرزند پیدا ہُوئے:</para>
  <para style="li2" vid="1CH 2:18">یشرؔ، شوبابؔ اَور اردونؔ۔<verse eid="1CH 2:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 2:19"/>اَور جَب عزُوباہ کی وفات ہو گئی تو کالبؔ نے اِفراتہؔ سے شادی کرلی۔ جِس کے بطن سے حُورؔ پیدا ہُوا۔<verse eid="1CH 2:19"/></para>
  <para style="li2">
    <verse number="20" style="v" sid="1CH 2:20"/>حُورؔ سے اوری پیدا ہُوا اَور اوری سے بصل ایل پیدا ہُوا۔<verse eid="1CH 2:20"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 2:21"/>اُس کے بعد حِضرونؔ گِلعادؔ کے باپ مکیرؔ کی بیٹی کے پاس گیا جِس سے اُس نے ساٹھ بَرس کی عمر میں بیاہ کیا تھا اَور اُس کے بطن سے سِگُوبؔ پیدا ہُوا۔<verse eid="1CH 2:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 2:22"/>اَور سِگُوبؔ سے یائیرؔ پیدا ہُوا جو گِلعادؔ کے مُلک کے تئیس شہروں پر مُسلّط تھا۔<verse eid="1CH 2:22"/></para>
  <para style="li2">
    <verse number="23" style="v" sid="1CH 2:23"/>(مگر گیشُور اَور ارام نے حوّوت یائیرؔ اَور قناتؔ پر اُس کے گِردونواح کے ساٹھ قصبوں پر قبضہ کر لیا)۔</para>
  <para style="lf" vid="1CH 2:23">یہ سَب گِلعادؔ کے باپ مکیرؔ کے بیٹے تھے۔<verse eid="1CH 2:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 2:24"/>اَور حِضرونؔ کے کالبؔ اِفراتہؔ میں مَر جانے کے بعد اُس کی بیوی ابیّاہؔ کے بطن سے اُس کا بیٹا اشہُورؔ پیدا ہُوا جو تقوعؔ کا باپ تھا۔<verse eid="1CH 2:24"/></para>
  <para style="s2">یرحمئیلؔ بِن حِضرونؔ</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 2:25"/>حِضرونؔ کے پہلوٹھے یرحمئیلؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 2:25">رامؔ اُس کا پہلوٹھا بیٹا تھا، بُونہؔ، اورنؔ، اوضمؔ اَور اخیاہؔ۔ <verse eid="1CH 2:25"/><verse number="26" style="v" sid="1CH 2:26"/>اَور یرحمئیلؔ کی ایک اَور بیوی تھی جِس کا نام عطارہؔ تھا؛ وہ اونامؔ کی ماں تھی۔<verse eid="1CH 2:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 2:27"/>یرحمئیلؔ کے پہلوٹھے رامؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 2:27">ماعصؔ، یمینؔ اَور عیقرؔ تھے۔<verse eid="1CH 2:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 2:28"/>اونامؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 2:28">شمّائیؔ اَور یدعؔ۔</para>
  <para style="li1" vid="1CH 2:28">اَور شمّائیؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 2:28">نادابؔ اَور ابیشُورؔ تھے۔ <verse eid="1CH 2:28"/><verse number="29" style="v" sid="1CH 2:29"/>ابیشُورؔ کی بیوی کا نام اَبی حائیل تھا، اُس کے بطن سے احبانؔ اَور مولِدؔ پیدا ہُوئے۔<verse eid="1CH 2:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 2:30"/>نادابؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 2:30">سِلِدؔ اَور افّائمؔ تھے لیکن سِلِدؔ بے اَولاد مَر گیا۔<verse eid="1CH 2:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 2:31"/>افّائمؔ کا بیٹا:</para>
  <para style="li2" vid="1CH 2:31">یَشعیؔ تھا جو شیشانؔ کا باپ تھا اَور شیشانؔ احلائی کا باپ تھا۔<verse eid="1CH 2:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 2:32"/>اَور شمّائیؔ کے بھایٔی یدعؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 2:32">یترؔ اَور یُوناتانؔ تھے۔ اَور یترؔ بے اَولاد مَر گیا۔<verse eid="1CH 2:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 2:33"/>یُوناتانؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 2:33">پِلیتھ اَور زازاؔ تھے۔</para>
  <para style="lf" vid="1CH 2:33">یہ یرحمئیلؔ کے خاندان سے تھے۔<verse eid="1CH 2:33"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 2:34"/>اَور شیشانؔ کا کویٔی بیٹا نہ تھا، صِرف بیٹیاں تھیں۔</para>
  <para style="li2" vid="1CH 2:34">اَور شیشانؔ کا ایک مِصری نوکر تھا جِس کا نام یارحاؔ تھا۔ <verse eid="1CH 2:34"/><verse number="35" style="v" sid="1CH 2:35"/>شیشانؔ نے اَپنی بیٹی کو اَپنے نوکر یارحاؔ سے بیاہ دیا اَور اُن کے ہاں عتّئیؔ پیدا ہُوا۔<verse eid="1CH 2:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 2:36"/>اَور عتّئیؔ سے ناتنؔ پیدا ہُوا،</para>
  <para style="li1" vid="1CH 2:36">اَور ناتنؔ سے زابادؔ،<verse eid="1CH 2:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 2:37"/>زابادؔ سے اِفلالؔ پیدا ہُوا،</para>
  <para style="li1" vid="1CH 2:37">اَور اِفلالؔ سے عوبیدؔ،<verse eid="1CH 2:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 2:38"/>اَور عوبیدؔ سے یہُو پیدا ہُوا،</para>
  <para style="li1" vid="1CH 2:38">اَور یہُو سے عزریاہؔ،<verse eid="1CH 2:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 2:39"/>اَور عزریاہؔ سے خلصؔ، پیدا ہُوا</para>
  <para style="li1" vid="1CH 2:39">اَور خلصؔ سے ایلعساہؔ،<verse eid="1CH 2:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 2:40"/>اَور ایلعساہؔ سے سِسمائیؔ پیدا ہُوا</para>
  <para style="li1" vid="1CH 2:40">اَور سِسمائیؔ سے شلُّومؔ،<verse eid="1CH 2:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 2:41"/>اَور شلُّومؔ سے یقامِیاہؔ پیدا ہُوا</para>
  <para style="li1" vid="1CH 2:41">اَور یقامِیاہؔ سے اِلیشمعؔ۔<verse eid="1CH 2:41"/></para>
  <para style="s2">کالبؔ کی برادری</para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 2:42"/>اَور یرحمئیلؔ کے بھایٔی کالبؔ کے بیٹے یہ ہیں:</para>
  <para style="li2" vid="1CH 2:42">میشاؔ اُس کا پہلوٹھا بیٹا تھا جو زِیفؔ کا باپ تھا،</para>
  <para style="li2" vid="1CH 2:42">اَور اُس کا بیٹا مریشہؔ جو حِبرونؔ کا باپ تھا۔<verse eid="1CH 2:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 2:43"/>بنی حِبرونؔ یہ ہیں:</para>
  <para style="li2" vid="1CH 2:43">قورحؔ، تپُّوحؔ، رِقمؔ اَور شِمعؔ۔<verse eid="1CH 2:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 2:44"/>اَور شِمعؔ سے رحامؔ پیدا ہُوا</para>
  <para style="li2" vid="1CH 2:44">اَور رحامؔ سے یُرقعامؔ۔</para>
  <para style="li1" vid="1CH 2:44">رِقمؔ سے شمّائیؔ پیدا ہُوا<verse eid="1CH 2:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 2:45"/>اَور شمّائیؔ سے معونؔ</para>
  <para style="li2" vid="1CH 2:45">اَور معونؔ سے بیت ضُورؔ پیدا ہُوا۔<verse eid="1CH 2:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 2:46"/>اَور کالبؔ کی داشتہ عیفاہؔ سے</para>
  <para style="li2" vid="1CH 2:46">حارانؔ، موضاؔ اَور گازیز پیدا ہُوئے</para>
  <para style="li2" vid="1CH 2:46">اَور حارانؔ سے گازیز۔<verse eid="1CH 2:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 2:47"/>بنی یہدائیؔ یہ ہیں:</para>
  <para style="li2" vid="1CH 2:47">رِگیمؔ، یُوتامؔ، گیشنؔ، پِلیتؔ، عیفاہؔ اَور شعفؔ۔<verse eid="1CH 2:47"/></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 2:48"/>اَور کالبؔ کی داشتہ معکہؔ</para>
  <para style="li2" vid="1CH 2:48">شِبرؔ اَور ترحاناؔ کی ماں تھی۔<verse eid="1CH 2:48"/></para>
  <para style="li2">
    <verse number="49" style="v" sid="1CH 2:49"/>اِس نے مدمنّہؔ کے باپ شعفؔ کو بھی پیدا کیا</para>
  <para style="li2" vid="1CH 2:49">اَور مکبینہؔ اَور گِبعؔ کے باپ شیوا کو بھی پیدا کیا۔</para>
  <para style="li1" vid="1CH 2:49">اَور کالبؔ کی ایک بیٹی عکسہؔ تھی۔<verse eid="1CH 2:49"/></para>
  <para style="lf">
    <verse number="50" style="v" sid="1CH 2:50"/>یہ سَب بنی کالبؔ تھے۔</para>
  <para style="b" vid="1CH 2:50"/>
  <para style="li1" vid="1CH 2:50">اِفراتہؔ کے پہلوٹھے حُورؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 2:50">قِریت یعریمؔ کا باپ شوبلؔ۔ <verse eid="1CH 2:50"/><verse number="51" style="v" sid="1CH 2:51"/>بیت لحمؔ کا باپ سالماؔ اَور بیت گادِرؔ کا باپ حارِف۔<verse eid="1CH 2:51"/></para>
  <para style="li1">
    <verse number="52" style="v" sid="1CH 2:52"/>اَور قِریت یعریمؔ کے باپ شوبلؔ کی نَسل:</para>
  <para style="li2" vid="1CH 2:52">ہاروایحؔ اَور مناحاتؔ کے آدھے لوگ، <verse eid="1CH 2:52"/><verse number="53" style="v" sid="1CH 2:53"/>اَور قِریت یعریمؔ کی برادری: یتری، پُوتیؔ، شُماتیؔ اَور مِشراعیؔ۔ اِن ہی سے زَوراہتیوں اَور اِشتاؤلیؔ نکلے ہیں۔<verse eid="1CH 2:53"/></para>
  <para style="li1">
    <verse number="54" style="v" sid="1CH 2:54"/>بنی سالماؔ:</para>
  <para style="li2" vid="1CH 2:54">بیت لحمؔ، نطُوفاتی، عطروتؔ بیت یُوآبؔ اَور مناحاتی کے آدھے لوگ اَور زوریتی، <verse eid="1CH 2:54"/><verse number="55" style="v" sid="1CH 2:55"/>اَور یعبِیضؔ کے باشِندے مُنشیوں کی برادری: تِرعاتی، شیمیتھائی اَور سُوکاتی۔ یہ وہ قینیؔ ہیں جو ریخابؔ کے گھرانے کے باپ حمّاتؔ کی نَسل سے تھے۔<verse eid="1CH 2:55"/></para>
  <chapter eid="1CH 2"/>
  <chapter number="3" style="c" sid="1CH 3"/>
  <para style="s2">بنی داویؔد</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 3:1"/>یہ داویؔد کے وہ بیٹے ہیں جو حِبرونؔ میں اُس سے پیدا ہُوئے:</para>
  <para style="b" vid="1CH 3:1"/>
  <para style="li1" vid="1CH 3:1">پہلوٹھا امنُونؔ جو یزرعیلی احِینوعمؔ کے بطن سے تھا۔</para>
  <para style="li1" vid="1CH 3:1">دُوسرا دانی ایل کرمِلی ابیگیلؔ کے بطن سے تھا۔<verse eid="1CH 3:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 3:2"/>تیسرا اَبشالومؔ جو گیشُور کے بادشاہ تلمی کی بیٹی معکہؔ کا بیٹا تھا۔</para>
  <para style="li1" vid="1CH 3:2">چوتھا ادُونیّاہؔ جو حگِیّت کے بطن سے تھا۔<verse eid="1CH 3:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 3:3"/>پانچواں شفطیاہؔ جو ابیطالؔ کے بطن سے تھا۔</para>
  <para style="li1" vid="1CH 3:3">اَور چھٹا اِترِعامؔ جو اُس کی بیوی عِگلاہؔ سے تھا۔<verse eid="1CH 3:3"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="4" style="v" sid="1CH 3:4"/>یہ چھ داویؔد سے حِبرونؔ میں پیدا ہُوئے جہاں اُس نے سات سال اَور چھ مہینے تک سلطنت کی۔</para>
  <para style="b" vid="1CH 3:4"/>
  <para style="b" vid="1CH 3:4"/>
  <para style="lh" vid="1CH 3:4">داویؔد نے یروشلیمؔ میں تینتیس سال تک بادشاہی کی۔ <verse eid="1CH 3:4"/><verse number="5" style="v" sid="1CH 3:5"/>وہاں یروشلیمؔ میں اُس کے جو بچّے پیدا ہُوئے یہ ہیں:</para>
  <para style="b" vid="1CH 3:5"/>
  <para style="li1" vid="1CH 3:5">شِمعاؔ،<note caller="+" style="f"><char style="fr" closed="false">3‏:5 </char><char style="fq" closed="false">شِمعاؔ </char><char style="ft" closed="false">کچھ نُسخوں میں شَمّوعؔ ہے</char></note> شوبابؔ، ناتنؔ اَور شُلومونؔ۔ یہ چاروں عمّی ایل کی بیٹی بَت شُوعؔ<note caller="+" style="f"><char style="fr" closed="false">3‏:5 </char><char style="fq" closed="false">بَت شُوعؔ </char><char style="ft" closed="false">دُوسرا نام بتشیبؔا بھی ہے</char></note> کے بطن سے تھے۔<verse eid="1CH 3:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 3:6"/>اَور یہ نَو یعنی اِبحارؔ، اِلیشمعؔ،<note caller="+" style="f"><char style="fr" closed="false">3‏:6 </char><char style="fq" closed="false">اِلیشمعؔ </char><char style="ft" closed="false">کچھ نُسخوں میں الِیشُوعؔ بھی لِکھا ہے۔</char></note> الیفلطؔ، <verse eid="1CH 3:6"/><verse number="7" style="v" sid="1CH 3:7"/>نوگاہؔ، نِفیگ، یافیعؔ، <verse eid="1CH 3:7"/><verse number="8" style="v" sid="1CH 3:8"/>اَور اِلیشمعؔ، الیدعؔ اَور الیفلطؔ کُل نَو فرزند۔<verse eid="1CH 3:8"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="9" style="v" sid="1CH 3:9"/>اَور داشتاؤں کے بیٹے جو اُن کے علاوہ تھے۔ یہ سَب داویؔد کے بیٹے تھے، اَور تامارؔ اُن کی بہن تھی۔<verse eid="1CH 3:9"/></para>
  <para style="s2">شاہانِ یہُوداہؔ</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 3:10"/>رحُبعامؔ بِن شُلومونؔ،</para>
  <para style="li1" vid="1CH 3:10">ابیّاہؔ بِن رحُبعامؔ،</para>
  <para style="li1" vid="1CH 3:10">آساؔ بِن ابیّاہؔ،</para>
  <para style="li1" vid="1CH 3:10">یہوشافاطؔ بِن آساؔ،<verse eid="1CH 3:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 3:11"/>یُورامؔ<note caller="+" style="f"><char style="fr" closed="false">3‏:11 </char><char style="fq" closed="false">یُورامؔ </char><char style="ft" closed="false">یہُورامؔ بھی کہا جاتا ہے</char></note> بِن یہوشافاطؔ،</para>
  <para style="li1" vid="1CH 3:11">احزیاہؔ بِن یُورامؔ،</para>
  <para style="li1" vid="1CH 3:11">یُوآشؔ بِن احزیاہؔ،<verse eid="1CH 3:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 3:12"/>اماضیاہؔ بِن یُوآشؔ،</para>
  <para style="li1" vid="1CH 3:12">عزریاہؔ بِن اماضیاہؔ</para>
  <para style="li1" vid="1CH 3:12">یُوتامؔ بِن عزریاہؔ،<verse eid="1CH 3:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 3:13"/>آحازؔ بِن یُوتامؔ،</para>
  <para style="li1" vid="1CH 3:13">حِزقیاہؔ بِن آحازؔ،</para>
  <para style="li1" vid="1CH 3:13">منشّہ بِن حِزقیاہؔ،<verse eid="1CH 3:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 3:14"/>امُونؔ بِن منشّہ،</para>
  <para style="li1" vid="1CH 3:14">یُوشیاہؔ بِن امُونؔ،<verse eid="1CH 3:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 3:15"/>یُوشیاہؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 3:15">پہلوٹھا یوحانانؔ،</para>
  <para style="li2" vid="1CH 3:15">دُوسرا یہُویقیمؔ،</para>
  <para style="li2" vid="1CH 3:15">تیسرا صِدقیاہؔ،</para>
  <para style="li2" vid="1CH 3:15">اَور چوتھا شلُّومؔ۔<verse eid="1CH 3:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 3:16"/>یہُویقیمؔ کے جانشین:</para>
  <para style="li2" vid="1CH 3:16">یہُویاکینؔ یا یکونیاہؔ بِن یہُویقیمؔ،</para>
  <para style="li2" vid="1CH 3:16">اَور صِدقیاہؔ بِن یہُویاکینؔ۔<verse eid="1CH 3:16"/></para>
  <para style="s1">جَلاوطنی کے بعد شاہی خاندان کا سلسلہ</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 3:17"/>یکونیاہؔ جو اسیر تھا اُس کے بیٹے یہ ہیں:</para>
  <para style="li2" vid="1CH 3:17">شیالتی ایل بِن یہُویاکینؔ <verse eid="1CH 3:17"/><verse number="18" style="v" sid="1CH 3:18"/>مالخیرمؔ، پِدائیاہؔ، شِیناضرّؔ، یقامِیاہؔ، ہوشمعؔ اَور نِدابیاہؔ<verse eid="1CH 3:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 3:19"/>پِدائیاہؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 3:19">زرُبّابِیل اَور شِمعیؔ۔</para>
  <para style="li1" vid="1CH 3:19">زرُبّابِیل کے بیٹے: مِشُلّامؔ اَور حننیاہؔ، اَور شلُومیتؔ اُن کی بہن تھی۔ <verse eid="1CH 3:19"/><verse number="20" style="v" sid="1CH 3:20"/>اَور پانچ اَور بھی بیٹے تھے: حشُوبہؔ، عوحیلؔ، بیرکیاہ، حسدیاہؔ، اَور یُوشب حسدؔ۔<verse eid="1CH 3:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 3:21"/>بنی حننیاہؔ:</para>
  <para style="li2" vid="1CH 3:21">پیلاطیاہؔ اَور یِشعیہ، اَور رِفایاہؔ کے بیٹے ارنانؔ، عبدیاہؔ اَور شِکنیاہؔ کے بیٹے۔<verse eid="1CH 3:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 3:22"/>بنی شِکنیاہؔ:</para>
  <para style="li2" vid="1CH 3:22">شمعیاہؔ بِن شِکنیاہؔ کے بیٹے یہ ہیں: حطُّوشؔ، اِگالؔ، برِیاہؔ، نعریاہؔ اَور شافاطؔ، کل چھ بھایٔی تھے۔<verse eid="1CH 3:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 3:23"/>نعریاہؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 3:23">الیوعینائی، حِزقیاہؔ اَور عزریقامؔ کل تین تھے۔<verse eid="1CH 3:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 3:24"/>اَور الیوعینائی کے بیٹے:</para>
  <para style="li2" vid="1CH 3:24">ہُوداویاہؔ، اِلیاشبؔ، پِلائییاہؔ، عقُّوبؔ، یوحانانؔ۔ دِلائیاہؔ اَور عنانیؔ۔ کل سات بھایٔی تھے۔<verse eid="1CH 3:24"/></para>
  <chapter eid="1CH 3"/>
  <chapter number="4" style="c" sid="1CH 4"/>
  <para style="s2">بنی یہُوداہؔ کے دیگر برادری</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 4:1"/>بنی یہُوداہؔ یہ ہیں:</para>
  <para style="li2" vid="1CH 4:1">پیریزؔ، حِضرونؔ، کرمی، حُورؔ، شوبلؔ،<verse eid="1CH 4:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 4:2"/>رِیایاہؔ بِن شوبلؔ سے یاحاتؔھ اَور یاحاتؔھ سے احُومائیؔ اَور لاہادؔ پیدا ہُوئے۔ یہ زَوراہتیوں کی برادری کے تھے۔<verse eid="1CH 4:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 4:3"/>اَور بنی عیطامؔ یہ ہیں:</para>
  <para style="li2" vid="1CH 4:3">یزرعیلؔ، اِشمع اَور اِدباشؔ۔ اَور اُن کی بہن کا نام ہاصلیلپونیؔ تھا۔ <verse eid="1CH 4:3"/><verse number="4" style="v" sid="1CH 4:4"/>اَور پنی ایل سے گدُورؔ پیدا ہُوئے اَور عزرؔ سے حُوشاہؔ پیدا ہُوئے۔</para>
  <para style="li1" vid="1CH 4:4">بیت لحمؔ کے باپ، اِفراتہؔ کے پہلوٹھے حُورؔ کے بیٹے یہ ہیں:<verse eid="1CH 4:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 4:5"/>اَور تقوعؔ بِن اشہُورؔ کی دو بیویاں تھیں: حیلاہؔ اَور نعراہؔ۔<verse eid="1CH 4:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 4:6"/>اَور نعراہؔ کے بطن سے احُوضّامؔ، حِفرؔ، تِمینیؔ اَور ہاحشتاریؔ پیدا ہُوئے۔ یہ سَب نعراہؔ کی اَولاد تھی۔<verse eid="1CH 4:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 4:7"/>حیلاہؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 4:7">ضرۃ، ضُحرؔ اَور اِتھننؔ تھے۔ <verse eid="1CH 4:7"/><verse number="8" style="v" sid="1CH 4:8"/>اَور کوزؔ سے عنُوبؔ اَور حضوبیباہؔ اَور حارومؔ کے بیٹے اَحرحیلؔ کی برادری میں پیدا ہُوئے تھے۔<verse eid="1CH 4:8"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9"/>اَور یعبِیضؔ اَپنے بھائیوں کی بہ نِسبت زِیادہ مُعزّز تھا اَور اُس کی ماں نے اُس کا نام یہ کہتے ہُوئے یعبِیضؔ رکھا، ”مَیں نے اُسے غم کے ساتھ پیدا کیا۔“ <verse eid="1CH 4:9"/><verse number="10" style="v" sid="1CH 4:10"/>اَور یعبِیضؔ نے اِسرائیل کے خُدا سے یہ دعا کی، ”کاش آپ مُجھے برکت دیں اَور میری سرحدوں کو بڑھائیں! اَور اِس کے علاوہ آپ کے ہاتھ میرے ساتھ ہُوں سَب بدکاریوں سے مُجھے دُور رکھیں تاکہ وہ میرے غم کا باعث نہ ہوں۔“ اَورجو کچھ اُس نے مانگا تھا، خُدا نے اُسے عطا فرمایا۔<verse eid="1CH 4:10"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 4:11"/>اَور شُوحاہؔ کے بھایٔی کلُوبؔ سے مِحیرؔ پیدا ہُوا جو اِشتُونؔ کا باپ تھا۔ <verse eid="1CH 4:11"/><verse number="12" style="v" sid="1CH 4:12"/>اِشتُونؔ سے بیت رافاؔ اَور پاسیخؔ۔ اَور تِحنّہ پیدا ہُوئے۔ تِحنّہ عیرؔ ناحسؔ کا باپ تھا۔ یہی رخاہؔ کی اَولاد ہیں۔<verse eid="1CH 4:12"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 4:13"/>بنی قِنٰز یہ ہیں:</para>
  <para style="li2" vid="1CH 4:13">عتنی ایل اَور سِرایاہؔ تھے۔</para>
  <para style="li1" vid="1CH 4:13">اَور بنی عتنی ایل یہ ہیں:</para>
  <para style="li2" vid="1CH 4:13">حتتؔ اَور معنوتائی تھے۔ <verse eid="1CH 4:13"/><verse number="14" style="v" sid="1CH 4:14"/>اَور معنوتائی سے عُفرہؔ پیدا ہُوا۔</para>
  <para style="li1" vid="1CH 4:14">اَور سِرایاہؔ سے یُوآبؔ پیدا ہُوا،</para>
  <para style="li2" vid="1CH 4:14">جو گے ہراشیمؔ کا باپ تھا۔ یہ گے ہراشیمؔ اِس لئے کہلائے کیونکہ یہ کاریگر تھے اَور کاریگروں کی وادی سے تعلّق رکھتے تھے۔<verse eid="1CH 4:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 4:15"/>اَور کالبؔ بِن یفُنّہؔ کے بیٹے یہ ہیں:</para>
  <para style="li2" vid="1CH 4:15">عِیرُوؔ، اَیلہ اَور ناعمؔ تھے۔</para>
  <para style="li1" vid="1CH 4:15">اَور بنی اَیلہ یہ ہیں:</para>
  <para style="li2" vid="1CH 4:15">قِنٰز۔<verse eid="1CH 4:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 4:16"/>بنی یہللِئیلؔ یہ ہیں:</para>
  <para style="li2" vid="1CH 4:16">زِیفؔ، زِیفاہؔ، تیرئیاؔ اَور اساريلؔ تھے۔<verse eid="1CH 4:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 4:17"/>بنی عزراہؔ یہ ہیں:</para>
  <para style="li2" vid="1CH 4:17">یترؔ، مِرِدؔ، عِفرؔ اَور یالونؔ؛</para>
  <para style="li1" vid="1CH 4:17">اَور مِرِدؔ کی ایک بیوی کے بطن سے مِریمؔ، شمّائیؔ اَور اِشتموُعؔ کے باپ اِشباحؔ پیدا ہُوئے۔ <verse eid="1CH 4:17"/><verse number="18" style="v" sid="1CH 4:18"/>یہ فَرعوہؔ کی بیٹی بتیاہؔ کے بطن سے پیدا ہُوئے۔ جِس سے مِرِدؔ نے شادی کی تھی۔</para>
  <para style="li1" vid="1CH 4:18">اُس کی یہُوداہؔ کے قبیلے کی یہُودی بیوی کے بطن سے گدُورؔ کے باپ یاردؔ، شوکوہؔ کے باپ حِبرؔ اَور زنوحؔ کے باپ یقُوتی ایل۔<verse eid="1CH 4:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 4:19"/>ناحمؔ کی بہن اَور ہُودیاہؔ کی بیوی کے بیٹے:</para>
  <para style="li2" vid="1CH 4:19">گارمی کے قعیلہؔ اَور معکاتی بِن اِشتموُعؔ تھے۔<verse eid="1CH 4:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 4:20"/>بنی شمعُونؔ یہ ہیں:</para>
  <para style="li2" vid="1CH 4:20">امنُونؔ، رِنّہؔ، بِن حاننؔ اَور تِیلونؔ۔</para>
  <para style="li1" vid="1CH 4:20">اَور بنی یَشعیؔ یہ ہیں:</para>
  <para style="li2" vid="1CH 4:20">زوحِتؔ اَور بِن زوحِتؔ۔<verse eid="1CH 4:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 4:21"/>بنی یہُوداہؔ یہ تھے:</para>
  <para style="li2" vid="1CH 4:21">شِلحؔ بِن یہُوداہؔ عیرؔ لِکاہؔ کا باپ تھا، لعدہؔ مریشہؔ کا باپ تھا جو بیت اشبیعؔ میں اُس برادری کے خاندان سے تھے جِس میں مہین کتان کے کپڑے کا کام ہوتا تھا؛<verse eid="1CH 4:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 4:22"/>اِن کے علاوہ یوقیمؔ اَور کوزیباؔ کے لوگ، اَور یُوآشؔ اَور سارفؔ جو مُوآب پر حُکومت کرتے رہے، پھر یَعشُوبی لحم کو لَوٹ گئے۔ یہ باتیں قدیم زمانہ کی تاریخ سے ماخوذ ہیں۔ <verse eid="1CH 4:22"/><verse number="23" style="v" sid="1CH 4:23"/>یہ سبھی کُمہار تھے جو نتائیمؔ اَور گِدیرہؔ کے باشِندے تھے؛ وہ وہاں بادشاہ کے ساتھ اُس کا کام کرنے کے لئے رہتے تھے۔<verse eid="1CH 4:23"/></para>
  <para style="s1">بنی شمعُونؔ</para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 4:24"/>بنی شمعُونؔ یہ ہیں:</para>
  <para style="li2" vid="1CH 4:24">نموایل، یمینؔ، یرِیبؔ، زیراحؔ اَور شاؤل۔<verse eid="1CH 4:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 4:25"/>اَور شاؤل کا بیٹا شلُّومؔ اَور شلُّومؔ کا بیٹا مبسامؔ اَور مبسامؔ کا بیٹا مِشماعؔ۔<verse eid="1CH 4:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 4:26"/>بنی مِشماعؔ یہ ہیں:</para>
  <para style="li2" vid="1CH 4:26">حمُّوایلؔ بِن مِشماعؔ، زکُورؔ بِن حمُّوایلؔ؛ اَور شِمعیؔ بِن زکُورؔ۔<verse eid="1CH 4:26"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27"/>شِمعیؔ کے سولہ بیٹے اَور چھ بیٹیاں تھیں لیکن اُس کے بھائیوں کی بہت اَولاد نہ ہُوئی۔ اِس لیٔے اُن کا برادری یہُوداہؔ کے لوگوں کی مانند زِیادہ نہ بڑھا۔ <verse eid="1CH 4:27"/><verse number="28" style="v" sid="1CH 4:28"/>وہ بیرشبعؔ، مولادہؔ، حضار شُعالؔ، <verse eid="1CH 4:28"/><verse number="29" style="v" sid="1CH 4:29"/>بِلہاہؔ، عضِمؔ، تولادؔ، <verse eid="1CH 4:29"/><verse number="30" style="v" sid="1CH 4:30"/>بیتُھوایلؔ، حُرمہؔ، صِقلاگ، <verse eid="1CH 4:30"/><verse number="31" style="v" sid="1CH 4:31"/>بیت مرکبوتؔ، حضار سُوسیمؔ، بیت بیؔری اَور شعریمؔ کے شہروں میں بستے تھے۔ داویؔد کی سلطنت تک یہی اُن کے شہر تھے۔ <verse eid="1CH 4:31"/><verse number="32" style="v" sid="1CH 4:32"/>اَور عیطامؔ، عینؔ، رِمّونؔ، توکنؔ اَور عشٰنؔ، اُن کے گِردونواح کے قصبے تھے یعنی پانچ قصبے تھے۔ <verse eid="1CH 4:32"/><verse number="33" style="v" sid="1CH 4:33"/>اَور اِن قصبوں کے اِردگرد کے دیہات تھے جو بَعل تک پھیلے ہُوئے تھے۔ یہ لوگ اِن ہی مقامات پر بسے ہُوئے تھے۔</para>
  <para style="b" vid="1CH 4:33"/>
  <para style="lh" vid="1CH 4:33">اَور وہ اَپنے نَسب نامے تحریری دستاویز کی صورت میں محفوظ رکھتے تھے جِن میں یہ نام مرقوم ہیں:<verse eid="1CH 4:33"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 4:34"/>مِشوبابؔ، یاملیخؔ؛</para>
  <para style="li1" vid="1CH 4:34">یوشاہؔ بِن اماضیاہؔ؛ <verse eid="1CH 4:34"/><verse number="35" style="v" sid="1CH 4:35"/>یُوایلؔ؛</para>
  <para style="li1" vid="1CH 4:35">یہُو بِن یُوشِبیاہؔ بِن سِرایاہؔ بِن عاسی ایل؛<verse eid="1CH 4:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 4:36"/>اَور الیوعینائی؛ یعقوباہؔ؛ یشوہایاہؔ؛</para>
  <para style="li1" vid="1CH 4:36">عسایاہؔ؛ عدی ایل؛ یِسیمی ایل؛ بِنایاہؔ؛<verse eid="1CH 4:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 4:37"/>اَور زیزاؔ بِن شِفعیؔ بِن الُّونؔ بِن یِدایاہؔ بِن شِمریؔ بِن شمعیاہؔ۔<verse eid="1CH 4:37"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="38" style="v" sid="1CH 4:38"/>جِن مَردوں کے نام اُوپر فہرست میں لکھے گیٔے وہ اَپنے اَپنے برادریوں کے سردار تھے۔</para>
  <para style="b" vid="1CH 4:38"/>
  <para style="p" vid="1CH 4:38">اَور اُن کے آبائی خاندان بہت بڑھتا چلا گیا، <verse eid="1CH 4:38"/><verse number="39" style="v" sid="1CH 4:39"/>اَور وہ گدُورؔ کے بیرونی علاقے تک یعنی اُس وادی کے مشرق تک اَپنے گلّوں کے لیٔے چراگاہیں ڈھونڈنے گیٔے۔ <verse eid="1CH 4:39"/><verse number="40" style="v" sid="1CH 4:40"/>وہاں اُنہُوں نے زرخیز اَور اَچھّی چراگاہ پائی اَور وہ قَطعہ زمین کشادہ، پُراَمن اَور پُرسکون تھا۔ پہلے وہاں بنی حامؔ بسے ہُوئے تھے۔<verse eid="1CH 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41"/>وہ مَرد جِن کے نام مُندرجہ ذیل فہرست میں دئیے گیٔے ہیں وہ شاہِ یہُودیؔہ حِزقیاہؔ کے ایّام میں آئے اَور اُنہُوں نے بنی حامؔ کی قِیام گاہوں پر حملہ کیا اَور معُونیم کو بھی جو وہاں تھے قتل کر دیا اَور اُنہیں مُکمّل طور پر تباہ کر دیا۔ اَب اُن کا نام و نِشان تک باقی نہیں۔ تَب وہ اُن کی جگہ رہنے لگے کیونکہ وہاں اُن کے گلّوں کے لیٔے چراگاہ تھی۔ <verse eid="1CH 4:41"/><verse number="42" style="v" sid="1CH 4:42"/>اَور پانچ سَو بنی شمعُونؔ نے بنی یَشعیؔ یعنی پیلاطیاہؔ، نعریاہؔ، رِفایاہؔ اَور عُزّی ایل کی زیرِ قیادت کوہِ سِعِیؔر پر حملہ کیا۔ <verse eid="1CH 4:42"/><verse number="43" style="v" sid="1CH 4:43"/>اَور اُنہُوں نے باقی بچے عمالیقیوں کو جو وہاں تھے قتل کر ڈالا اَور بنی شمعُونؔ تَب سے آج تک وہیں بسے ہُوئے ہیں۔<verse eid="1CH 4:43"/></para>
  <chapter eid="1CH 4"/>
  <chapter number="5" style="c" sid="1CH 5"/>
  <para style="s1">بنی رُوبِنؔ</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 5:1"/>اِسرائیل کے پہلوٹھے رُوبِنؔ کے بیٹے (وہ پہلوٹھا تھا لیکن جَب اُس نے اَپنے باپ کے بچھونے کو ناپاک کیا تو اُس کے پہلوٹھے ہونے کے حُقُوق یُوسیفؔ بِن اِسرائیل کے بیٹوں کو دئیے گیٔے اِس لیٔے نَسب نامہ میں اُس کا اندراج پہلوٹھے پن کے مُطابق نہ ہو سَکا حالانکہ یہ پہلوٹھا تھا۔ <verse eid="1CH 5:1"/><verse number="2" style="v" sid="1CH 5:2"/>اَور اگرچہ یہُوداہؔ اَپنے تمام بھائیوں سے زِیادہ طاقتور تھا اَور حُکمران اُسی میں سے نکلے لیکن پہلوٹھے کا حق یُوسیفؔ کا ہُوا)۔ <verse eid="1CH 5:2"/><verse number="3" style="v" sid="1CH 5:3"/>اِسرائیل کے پہلوٹھے رُوبِنؔ کے بیٹے یہ ہیں:</para>
  <para style="b" vid="1CH 5:3"/>
  <para style="li2" vid="1CH 5:3">حنوخؔ، پلوّؔ، حِضرونؔ اَور کرمی۔<verse eid="1CH 5:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 5:4"/>یُوایلؔ کے بیٹے یہ ہیں:</para>
  <para style="li2" vid="1CH 5:4">اُس کا بیٹا شمعیاہؔ اَور اُس کا بیٹا گوگ،</para>
  <para style="li2" vid="1CH 5:4">اَور اُس کا بیٹا شِمعیؔ، <verse eid="1CH 5:4"/><verse number="5" style="v" sid="1CH 5:5"/>اَور اُس کا بیٹا میکاہؔ،</para>
  <para style="li2" vid="1CH 5:5">اَور اُس کا بیٹا رِیایاہؔ اَور اُس کا بیٹا بَعل،<verse eid="1CH 5:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 5:6"/>اَور اُس کا بیٹا بِیرہ جِس کو تِگلتؔ پلیسِر شاہِ اشُور اسیر کرکے لے گیا۔ بِیرہ بنی رُوبِنؔ کا سردار تھا۔<verse eid="1CH 5:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 5:7"/>اُن کے رشتہ دار جِن کا اُن کے برادریوں کے لحاظ سے نَسب نامہ تحریر میں آیا یہ تھے:</para>
  <para style="li2" vid="1CH 5:7">سردار یعی ایل اَور زکریاؔہ، <verse eid="1CH 5:7"/><verse number="8" style="v" sid="1CH 5:8"/>اَور بَیلعؔ بِن عزازؔ بِن شِمعؔ بِن یُوایلؔ۔</para>
  <para style="b" vid="1CH 5:8"/>
  <para style="p" vid="1CH 5:8">وہ عروعؔر سے لے کر نبوؔ اَور بَعل مِعُون تک کے علاقہ میں بسے ہُوئے تھے۔ <verse eid="1CH 5:8"/><verse number="9" style="v" sid="1CH 5:9"/>اَور مشرق کی طرف وہ اُس سرزمین پر قابض تھے جو دریائے فراتؔ تک پھیلے ہُوئے صحرا کے کنارے تک ہے۔ کیونکہ گِلعادؔ میں اُن کے مویشی بہت بڑھ گیٔے تھے۔<verse eid="1CH 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 5:10"/>اُنہُوں نے شاؤل کے دَورِ حُکومت میں ہاگریؔ کے خِلاف جنگ شروع کی اَور اُنہیں شِکست دی اَور وہ گِلعادؔ کے تمام مشرقی علاقے کے ہاگریوں کی قِیام گاہوں پر قابض ہو گئے۔<verse eid="1CH 5:10"/></para>
  <para style="s1">گادؔ</para>
  <para style="lh">
    <verse number="11" style="v" sid="1CH 5:11"/>اَور بنی گادؔ بنی رُوبِنؔ کے مقابل مُلک باشانؔ میں سَلِکہؔ تک بسے ہُوئے تھے:<verse eid="1CH 5:11"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 5:12"/>اوّل یُوایلؔ تھا اَور شافامؔ دُوسرا اَور یعناعیؔ اَور شافاطؔ باشانؔ میں تھے۔<verse eid="1CH 5:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 5:13"/>اَور آبائی خاندانوں کے مُطابق اُن کے رشتہ دار یہ تھے:</para>
  <para style="li2" vid="1CH 5:13">مِیکاایلؔ، مِشُلّامؔ، شیبا، یورائیؔ، یعکانؔ، زیعؔا اَور عِبرؔ، کل سات آدمی۔<verse eid="1CH 5:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 5:14"/>یہ بنی اَبی حائیل بِن حُوریؔ بِن یاروحؔ بِن گِلعادؔ بِن مِیکاایلؔ بِن یشیشائیؔ بِن یاحدوؔ بِن بوز تھے۔<verse eid="1CH 5:14"/></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 5:15"/>احی عبدی ایل بِن گُونی اُن کے آبائی خاندانوں کا سردار تھا۔<verse eid="1CH 5:15"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="16" style="v" sid="1CH 5:16"/>بنی گادؔ باشانؔ کے شہروں میں، گِلعادؔ میں، اَور اُس کے دُور بیرونی شہروں میں اَور شارونؔ کی ساری چراگاہوں کے آخِری کناروں تک بسے ہُوئے تھے۔<verse eid="1CH 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 5:17"/>یہُودیؔہ کے بادشاہ یُوتامؔ اَور اِسرائیل کے بادشاہ یرُبعامؔ کے ایّام میں اِن سَب کو اُن نَسب ناموں میں درج کیا گیا تھا۔<verse eid="1CH 5:17"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18"/>اَور بنی رُوبِنؔ، بنی گادؔ اَور منشّہ کے آدھے قبیلہ میں چوالیس ہزار سات سَوساٹھ مَرد فَوجی خدمت کے لیٔے تیّار تھے یعنی تندرست و توانا مَرد جو سِپر بردار، شمشیر زن اَور تیر اَندازی میں ماہر تھے اَور جنگ آزمودہ تھے۔ <verse eid="1CH 5:18"/><verse number="19" style="v" sid="1CH 5:19"/>اُنہُوں نے ہاگریوں اَور اُن کے اِتّحادیوں یطُورؔ، نافیشؔ اَور نودابی قبیلوں پر حملہ کیا۔ <verse eid="1CH 5:19"/><verse number="20" style="v" sid="1CH 5:20"/>اَور خُدا نے ہاگریوں اَور اُن کے اِتّحادیوں کو اُن کے حوالہ کر دیا کیونکہ جنگ کے دَوران اُنہُوں نے خُدا سے دعا کی اَور خُدا نے اُن کی دعا قبُول فرمائی، اِس لیٔے کہ اُنہُوں نے اُن پر اِعتماد رکھا۔ <verse eid="1CH 5:20"/><verse number="21" style="v" sid="1CH 5:21"/>اُنہُوں نے ہاگریوں کے مویشیوں پر قبضہ کر لیا جو کہ پچاس ہزار اُونٹ، دو لاکھ پچاس ہزار بھیڑ بکریاں اَور دو ہزار گدھے تھے۔ اُنہُوں نے ایک لاکھ آدمیوں کو بھی قَید کر لیا۔ <verse eid="1CH 5:21"/><verse number="22" style="v" sid="1CH 5:22"/>اَور بہت سے آدمیوں کو قتل کر دیا کیونکہ وہ جنگ یَاہوِہ کی تھی۔ اَور وہ جَلاوطنی کے وقت تک اُس مُلک پر قابض رہے۔<verse eid="1CH 5:22"/></para>
  <para style="s1">منشّہ کا آدھا قبیلہ</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23"/>منشّہ کے آدھے قبیلہ کے لوگ بہت زِیادہ تھے اَور وہ باشانؔ سے لے کر بَعل حرمُونؔ یعنی سنیرؔ (کوہِ حرمُونؔ) تک پھیلے ہُوئے تھے۔<verse eid="1CH 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 5:24"/>اُن کے آبائی خاندانوں کے سردار یہ تھے: عِفرؔ، یَشعیؔ، الی ایل، عزری ایل، یرمیاہؔ، ہُوداویاہؔ اَور یحدی ایل۔ یہ بڑے دِلیر، جنگجو، نامور اَور اَپنے آبائی خاندانوں کے سردار تھے۔ <verse eid="1CH 5:24"/><verse number="25" style="v" sid="1CH 5:25"/>لیکن اُنہُوں نے اَپنے آباؤاَجداد کے خُدا سے بےوفائی کی اَور جِس مُلک کے باشِندوں کو خُدا نے اُن کے سامنے سے ہلاک کیا تھا اُن ہی کے معبُودوں کی پیروی کرکے اُنہُوں نے زناکاری کی۔ <verse eid="1CH 5:25"/><verse number="26" style="v" sid="1CH 5:26"/>تَب اِسرائیل کے خُدا نے شاہِ اشُور پُولؔ یعنی تِگلتؔ پلیسِر کے دِل میں جوش پیدا کیا اَور وہ رُوبِنیوں، گادّیوں اَور منشّہ کے آدھے قبیلہ کو اسیر کرکے لے گیا اَور اُنہیں حالاحؔ، حابُورؔ، ہاراؔ اَور دریائے گُوزانؔ کے پاس لے آیا اَور آج کے دِن تک وہ وہیں سکونت کر رہے ہیں۔<verse eid="1CH 5:26"/></para>
  <chapter eid="1CH 5"/>
  <chapter number="6" style="c" sid="1CH 6"/>
  <para style="s1">لیوی</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 6:1"/>بنی لیوی:</para>
  <para style="li2" vid="1CH 6:1">گیرشون، قُہات اَور مِراریؔ۔<verse eid="1CH 6:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 6:2"/>بنی قُہات:</para>
  <para style="li2" vid="1CH 6:2">عمرامؔ، اِضہاؔر، حِبرونؔ اَور عُزّی ايل۔<verse eid="1CH 6:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 6:3"/>اَور عمرامؔ کی اَولاد:</para>
  <para style="li2" vid="1CH 6:3">اَہرونؔ۔ مَوشہ اَور مِریمؔ۔</para>
  <para style="li1" vid="1CH 6:3">اَور بنی اَہرونؔ:</para>
  <para style="li2" vid="1CH 6:3">نادابؔ، اَبِیہُو، الیعزرؔ اَور اِتمارؔ۔<verse eid="1CH 6:3"/></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 6:4"/>الیعزرؔ سے فِنحاسؔ پیدا ہُوا،</para>
  <para style="li2" vid="1CH 6:4">اَور فِنحاسؔ سے ابیشُوعؔ،<verse eid="1CH 6:4"/></para>
  <para style="li2">
    <verse number="5" style="v" sid="1CH 6:5"/>اَور ابیشُوعؔ سے بُقّیؔ،</para>
  <para style="li2" vid="1CH 6:5">اَور بُقّیؔ سے عُزّی تھا،<verse eid="1CH 6:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 6:6"/>عُزّی سے زراخیاہؔ</para>
  <para style="li2" vid="1CH 6:6">اَور زراخیاہؔ سے مرایوتؔ۔<verse eid="1CH 6:6"/></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 6:7"/>اَور مرایوتؔ سے امریاہؔ</para>
  <para style="li2" vid="1CH 6:7">اَور امریاہؔ سے احِیطوبؔ۔<verse eid="1CH 6:7"/></para>
  <para style="li2">
    <verse number="8" style="v" sid="1CH 6:8"/>اَور احِیطوبؔ سے صدُوقؔ</para>
  <para style="li2" vid="1CH 6:8">اَور صدُوقؔ سے اخِیمعضؔ۔<verse eid="1CH 6:8"/></para>
  <para style="li2">
    <verse number="9" style="v" sid="1CH 6:9"/>اَور اخِیمعضؔ سے عزریاہؔ</para>
  <para style="li2" vid="1CH 6:9">اَور عزریاہؔ سے یوحانانؔ۔<verse eid="1CH 6:9"/></para>
  <para style="li2">
    <verse number="10" style="v" sid="1CH 6:10"/>اَور یوحانانؔ سے عزریاہؔ۔</para>
  <para style="li2" vid="1CH 6:10">یہ وُہی عزریاہؔ تھا جو شُلومونؔ کی مَعرفت سے تعمیر کردہ یروشلیمؔ کے بیت المُقدّس میں کاہِنؔ تھا۔<verse eid="1CH 6:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 6:11"/>اَور عزریاہؔ سے امریاہؔ پیدا ہُوا</para>
  <para style="li2" vid="1CH 6:11">اَور امریاہؔ سے احِیطوبؔ۔<verse eid="1CH 6:11"/></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 6:12"/>اَور احِیطوبؔ سے صدُوقؔ</para>
  <para style="li2" vid="1CH 6:12">اَور صدُوقؔ سے شلُّومؔ۔<verse eid="1CH 6:12"/></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 6:13"/>اَور شلُّومؔ سے خِلقیاہؔ</para>
  <para style="li2" vid="1CH 6:13">اَور خِلقیاہؔ سے عزریاہؔ۔<verse eid="1CH 6:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 6:14"/>اَور عزریاہؔ سے سِرایاہؔ</para>
  <para style="li2" vid="1CH 6:14">اَور سِرایاہؔ سے یہُوصدقؔ۔<verse eid="1CH 6:14"/></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 6:15"/>اَور جَب یَاہوِہ نے نبوکدنضرؔ کے ہاتھ سے یہُودیؔہ اَور یروشلیمؔ کو جَلاوطن کرایا تو یہُوصدقؔ بھی اسیروں میں شامل تھا۔<verse eid="1CH 6:15"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 6:16"/>بنی لیوی یہ ہیں:</para>
  <para style="li2" vid="1CH 6:16">گیرشون، قُہات اَور مِراریؔ ہیں۔<verse eid="1CH 6:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 6:17"/>گیرشون<note caller="+" style="f"><char style="fr" closed="false">6‏:17 </char><char style="fq" closed="false">گیرشون </char><char style="ft" closed="false">اِس کا دُوسرا نام گیرشوم بھی ہے۔</char></note> کے بیٹوں کے نام یہ ہیں:</para>
  <para style="li2" vid="1CH 6:17">لِبنیؔ اَور شِمعیؔ۔<verse eid="1CH 6:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 6:18"/>بنی قُہات:</para>
  <para style="li2" vid="1CH 6:18">عمرامؔ، اِضہاؔر، حِبرونؔ اَور عُزّی ايل۔<verse eid="1CH 6:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 6:19"/>بنی مِراریؔ:</para>
  <para style="li2" vid="1CH 6:19">محلیؔ اَور مُوشیؔ۔</para>
  <para style="b" vid="1CH 6:19"/>
  <para style="lh" vid="1CH 6:19">اَور لیویوں کے اُن کے آبائی برادریوں کے نَسب ناموں کے مُطابق گھرانے یہ ہیں:<verse eid="1CH 6:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 6:20"/>گیرشوم کا:</para>
  <para style="li2" vid="1CH 6:20">اُس کا بیٹا لِبنیؔ اَور اُس کا بیٹا یاحاتؔھ،</para>
  <para style="li2" vid="1CH 6:20">اَور اُس کا بیٹا زِمّہؔ <verse eid="1CH 6:20"/><verse number="21" style="v" sid="1CH 6:21"/>اَور اُس کا بیٹا یُوآخؔ،</para>
  <para style="li2" vid="1CH 6:21">اَور اُس کا بیٹا عِدّوؔ اَور اُس کا بیٹا زیراحؔ</para>
  <para style="li2" vid="1CH 6:21">اَور اُس کا بیٹا یاتیرائیؔ۔<verse eid="1CH 6:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 6:22"/>بنی قُہات:</para>
  <para style="li2" vid="1CH 6:22">اُس کا بیٹا عَمّیندابؔ، اُس کا بیٹا قورحؔ،</para>
  <para style="li2" vid="1CH 6:22">اُس کا بیٹا اَسّیر، <verse eid="1CH 6:22"/><verse number="23" style="v" sid="1CH 6:23"/>اُس کا بیٹا اِلقانہؔ،</para>
  <para style="li2" vid="1CH 6:23">اُس کا بیٹا اَبی آسفؔ، اُس کا بیٹا اَسّیر۔<verse eid="1CH 6:23"/></para>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 6:24"/>اُس کا بیٹا تحتؔ، اُس کا بیٹا اوری ایل،</para>
  <para style="li2" vid="1CH 6:24">اُس کا بیٹا عُزّیاہؔ اَور اُس کا بیٹا شاؤل۔<verse eid="1CH 6:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 6:25"/>اِلقانہؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 6:25">عماسیؔ اَور احیموتؔ۔<verse eid="1CH 6:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 6:26"/>اِلقانہؔ بِن احیموتؔ:</para>
  <para style="li2" vid="1CH 6:26">اُس کا بیٹا صُوفائیؔ، اُس کا بیٹا نحتؔ، <verse eid="1CH 6:26"/><verse number="27" style="v" sid="1CH 6:27"/>اُس کا بیٹا اِلیابؔ،</para>
  <para style="li2" vid="1CH 6:27">اُس کا بیٹا یروحامؔ، اُس کا بیٹا اِلقانہؔ</para>
  <para style="li2" vid="1CH 6:27">اَور اُس کا بیٹا شموایلؔ۔<verse eid="1CH 6:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 6:28"/>بنی شموایلؔ:</para>
  <para style="li2" vid="1CH 6:28">یُوایلؔ اُس کا پہلوٹھا</para>
  <para style="li2" vid="1CH 6:28">اَور دُوسرا بیٹا ابیّاہؔ۔<verse eid="1CH 6:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 6:29"/>بنی مِراریؔ:</para>
  <para style="li2" vid="1CH 6:29">محلیؔ، اُس کا بیٹا لِبنیؔ،</para>
  <para style="li2" vid="1CH 6:29">اُس کا بیٹا شِمعیؔ، اُس کا بیٹا عُزّاہ،<verse eid="1CH 6:29"/></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 6:30"/>اُس کا بیٹا شِمعاؔ، اُس کا بیٹا حگِّیاہؔ</para>
  <para style="li2" vid="1CH 6:30">اَور اُس کا بیٹا عسایاہؔ۔<verse eid="1CH 6:30"/></para>
  <para style="s1">بیت المُقدّس کے موسیقار</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31"/>وہ جنہیں داویؔد نے یَاہوِہ کے بیت المُقدّس میں عہد کے صندُوق کے لائے جانے کے بعد مُستقِل طور پر موسیقی کا نِگران مُقرّر کیا یہ ہیں: <verse eid="1CH 6:31"/><verse number="32" style="v" sid="1CH 6:32"/>اَور جَب تک شُلومونؔ یروشلیمؔ میں یَاہوِہ کے بیت المُقدّس نہ بنوا چُکا یہ لوگ خیمہ اِجتماع کے مَسکن کے سامنے موسیقی کا اہتمام کرتے رہے اَور مُقرّر کَردہ ضوابط کے مُطابق اَپنے اَپنے فرائض اَنجام دیتے رہے۔<verse eid="1CH 6:32"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="33" style="v" sid="1CH 6:33"/>وہ جنہوں نے اَپنے بیٹوں کے ہمراہ (خیمہ اِجتماع کے مَسکن کے سامنے موسیقی کے ذریعہ) خدمت کی یہ ہیں:</para>
  <para style="b" vid="1CH 6:33"/>
  <para style="li1" vid="1CH 6:33">قُہاتیوں میں سے:</para>
  <para style="li2" vid="1CH 6:33">ہیمانؔ موسیقار،</para>
  <para style="li2" vid="1CH 6:33">بِن یُوایلؔ بِن شموایلؔ،<verse eid="1CH 6:33"/></para>
  <para style="li2">
    <verse number="34" style="v" sid="1CH 6:34"/>بِن اِلقانہؔ بِن یروحامؔ</para>
  <para style="li2" vid="1CH 6:34">بِن الی ایل بِن توآحؔ،<verse eid="1CH 6:34"/></para>
  <para style="li2">
    <verse number="35" style="v" sid="1CH 6:35"/>بِن صُوفؔ بِن اِلقانہؔ</para>
  <para style="li2" vid="1CH 6:35">بِن ماحاتھؔ بِن عماسیؔ،<verse eid="1CH 6:35"/></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 6:36"/>بِن اِلقانہؔ بِن یُوایلؔ</para>
  <para style="li2" vid="1CH 6:36">بِن عزریاہؔ بِن صفنیاہؔ<verse eid="1CH 6:36"/></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 6:37"/>بِن تحتؔ بِن اَسّیر</para>
  <para style="li2" vid="1CH 6:37">بِن اَبی آسفؔ بِن قورحؔ<verse eid="1CH 6:37"/></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 6:38"/>بِن اِضہاؔر بِن قُہات</para>
  <para style="li2" vid="1CH 6:38">بِن لیوی بِن اِسرائیل؛<verse eid="1CH 6:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 6:39"/>اَور ہیمانؔ کا ہم خدمت بھایٔی آسفؔ جو بوقتِ خدمت اُس کے داہنے ہاتھ کھڑا ہوتا تھا یعنی</para>
  <para style="li2" vid="1CH 6:39">آسفؔ بِن بیرکیاہ بِن شِمعاؔ<verse eid="1CH 6:39"/></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 6:40"/>بِن مِیکاایلؔ بِن بعسیاہؔ</para>
  <para style="li2" vid="1CH 6:40">بِن ملکیاہؔ <verse eid="1CH 6:40"/><verse number="41" style="v" sid="1CH 6:41"/>بِن اتھنیؔ</para>
  <para style="li2" vid="1CH 6:41">بِن زیراحؔ بِن عدایاہؔ،<verse eid="1CH 6:41"/></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 6:42"/>بِن ایتھانؔ بِن زِمّہؔ</para>
  <para style="li2" vid="1CH 6:42">بِن شِمعیؔ <verse eid="1CH 6:42"/><verse number="43" style="v" sid="1CH 6:43"/>بِن یاحاتؔھ،</para>
  <para style="li2" vid="1CH 6:43">بِن گیرشوم بِن لیوی؛<verse eid="1CH 6:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 6:44"/>اَور اُن کے ہم خدمت بھائیوں میں سے بنی مِراریؔ جو اُس کے بائیں ہاتھ کھڑے ہوتے تھے:</para>
  <para style="li2" vid="1CH 6:44">یعنی ایتھانؔ بِن قیشی، بِن عبدی،</para>
  <para style="li2" vid="1CH 6:44">بِن مَلُّوکؔ، <verse eid="1CH 6:44"/><verse number="45" style="v" sid="1CH 6:45"/>بِن حشبیاہؔ</para>
  <para style="li2" vid="1CH 6:45">بِن اماضیاہؔ بِن خِلقیاہؔ<verse eid="1CH 6:45"/></para>
  <para style="li2">
    <verse number="46" style="v" sid="1CH 6:46"/>بِن امصیؔ بِن بانیؔ،</para>
  <para style="li2" vid="1CH 6:46">بِن شِمیرؔ، <verse eid="1CH 6:46"/><verse number="47" style="v" sid="1CH 6:47"/>بِن محلیؔ،</para>
  <para style="li2" vid="1CH 6:47">بِن مُوشیؔ بِن مِراریؔ،</para>
  <para style="li2" vid="1CH 6:47">بِن لیوی۔<verse eid="1CH 6:47"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48"/>اَور اُن کے دیگر بنی لیوی ساتھی خُدا کے گھر کے خیمہ (مَسکن) کی دیگر خدمات پر مُقرّر تھے۔ <verse eid="1CH 6:48"/><verse number="49" style="v" sid="1CH 6:49"/>لیکن اَہرونؔ اَور اُس کے بیٹے سوختنی نذر کی قُربانی کے مذبح اَور بخُور کی قُربان گاہ دونوں پر پاک ترین مقام کی ساری خدمت اَنجام دینے اَور اِسرائیل کے لیٔے کفّارہ دینے کے لیٔے جِس طرح خُدا کے خادِم مَوشہ نے حُکم دیا تھا قُربانی گذرانتے تھے۔<verse eid="1CH 6:49"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 6:50"/>اَور بنی اَہرونؔ یہ تھے:</para>
  <para style="li2" vid="1CH 6:50">اُس کا بیٹا الیعزرؔ، اُس کا بیٹا فِنحاسؔ،</para>
  <para style="li2" vid="1CH 6:50">اُس کا بیٹا ابیشُوعؔ، <verse eid="1CH 6:50"/><verse number="51" style="v" sid="1CH 6:51"/>اُس کا بیٹا بُقّیؔ،</para>
  <para style="li2" vid="1CH 6:51">اُس کا بیٹا عُزّی، اُس کا بیٹا زراخیاہؔ،<verse eid="1CH 6:51"/></para>
  <para style="li2">
    <verse number="52" style="v" sid="1CH 6:52"/>اُس کا بیٹا مرایوتؔ، اُس کا بیٹا امریاہؔ،</para>
  <para style="li2" vid="1CH 6:52">اُس کا بیٹا احِیطوبؔ، <verse eid="1CH 6:52"/><verse number="53" style="v" sid="1CH 6:53"/>اُس کا بیٹا صدُوقؔ</para>
  <para style="li2" vid="1CH 6:53">اَور اُس کا بیٹا اخِیمعضؔ۔<verse eid="1CH 6:53"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="54" style="v" sid="1CH 6:54"/>اُن کی خیمہ گاہوں کے مُطابق اُن کی آبادیوں کی سرحدیں اِس طرح مُقرّر کی گئیں (بنی اَہرونؔ میں سے قُہاتیوں کے برادریوں کو جو علاقے سُپرد کئے گیٔے یہ ہیں کیونکہ پہلا قُرعہ اُن کے نام کا نِکلا تھا):<verse eid="1CH 6:54"/></para>
  <para style="li1">
    <verse number="55" style="v" sid="1CH 6:55"/>اُنہیں یہُوداہؔ میں حِبرونؔ اَور اُس کے گِردونواح کی چراگاہیں دی گئیں۔ <verse eid="1CH 6:55"/><verse number="56" style="v" sid="1CH 6:56"/>(لیکن شہر کے اِردگرد کے کھیت اَور گاؤں یفُنّہؔ کے بیٹے کالبؔ کو دئیے گیٔے تھے۔) <verse eid="1CH 6:56"/><verse number="57" style="v" sid="1CH 6:57"/>پس بنی اَہرونؔ کو حِبرونؔ (پناہ کا ایک شہر) لِبناہؔ، یتّیرؔ، اِشتموُعؔ، <verse eid="1CH 6:57"/><verse number="58" style="v" sid="1CH 6:58"/>حیلِنؔ، دبیرؔ، <verse eid="1CH 6:58"/><verse number="59" style="v" sid="1CH 6:59"/>عشٰنؔ، یُوطّہؔ اَور بیت شِمِشؔ مع اُن کی چراگاہوں کے۔<verse eid="1CH 6:59"/></para>
  <para style="li1">
    <verse number="60" style="v" sid="1CH 6:60"/>اَورجو بِنیامین کے قبیلہ سے تھے اُنہیں گِبعونؔ، گِبعؔ، علیمتؔ اَور عناتوت سمیت اُن کی چراگاہوں کو دئیے گیٔے۔</para>
  <para style="lf" vid="1CH 6:60">یہ شہر جو قوہاتی برادریوں میں تقسیم کئے گیٔے تعداد میں کُل تیرہ تھے۔<verse eid="1CH 6:60"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="61" style="v" sid="1CH 6:61"/>منشّہ کے آدھے قبیلہ کی برادریوں میں سے دس شہر باقی بنی قُہات میں بذریعہ قُرعہ اَندازی تقسیم کئے گیٔے۔<verse eid="1CH 6:61"/></para>
  <para style="li1">
    <verse number="62" style="v" sid="1CH 6:62"/>گیرشون کے بیٹوں کو اُن کے برادریوں کے مُطابق یِسَّکاؔر کے برادری، آشیر کے قبیلہ، نفتالی کے قبیلہ اَور باشانؔ میں بسے ہُوئے منشّہ کے قبیلہ سے تیرہ شہر ملے۔<verse eid="1CH 6:62"/></para>
  <para style="li1">
    <verse number="63" style="v" sid="1CH 6:63"/>بنی مِراریؔ کو اُن کے برادریوں کے مُطابق رُوبِنؔ، گادؔ اَور زبُولُون کے قبیلوں سے بَارہ شہر ملے۔<verse eid="1CH 6:63"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="64" style="v" sid="1CH 6:64"/>یُوں بنی اِسرائیل نے لیویوں کو یہ شہر اَور اُن کی چراگاہیں بھی دے دیں۔<verse eid="1CH 6:64"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="65" style="v" sid="1CH 6:65"/>یہُوداہؔ، شمعُونؔ اَور بِنیامین کے قبیلوں سے اُنہیں وہ شہر جِن کا پہلے ذِکر ہو چُکاہے بذریعہ قُرعہ اَندازی دئیے گیٔے۔<verse eid="1CH 6:65"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="66" style="v" sid="1CH 6:66"/>بعض قُہاتی برادریوں کو اُن کے علاقہ کے طور پر اِفرائیمؔ کے قبیلہ سے شہر دئیے گیٔے۔<verse eid="1CH 6:66"/></para>
  <para style="li1">
    <verse number="67" style="v" sid="1CH 6:67"/>اِفرائیمؔ کے کوہستانی مُلک میں اُنہیں شِکیمؔ (پناہ کا ایک شہر) اَور گِزرؔ، <verse eid="1CH 6:67"/><verse number="68" style="v" sid="1CH 6:68"/>یُقمعامؔ، بیت حَورُونؔ، <verse eid="1CH 6:68"/><verse number="69" style="v" sid="1CH 6:69"/>ایّالونؔ، گاتؔھ رِمّونؔ، اِردگرد کی چراگاہوں سمیت دئیے گیٔے۔<verse eid="1CH 6:69"/></para>
  <para style="li1">
    <verse number="70" style="v" sid="1CH 6:70"/>اَور منشّہ کے آدھے قبیلہ میں سے بنی اِسرائیل نے عانیرؔ اَور بِلعاؔم مع اُن کی چراگاہوں کے بنی قُہات کے باقی برادریوں کو دئیے۔<verse eid="1CH 6:70"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="71" style="v" sid="1CH 6:71"/>بنی گیرشون کو مُندرجہ ذیل علاقے ملے:</para>
  <para style="li1" vid="1CH 6:71">منشّہ کے آدھے قبیلہ کے برادری سے اُن کو باشانؔ میں گولانؔ اَور عستاراتؔ اِردگرد کی چراگاہوں سمیت ملے؛<verse eid="1CH 6:71"/></para>
  <para style="li1">
    <verse number="72" style="v" sid="1CH 6:72"/>یِسَّکاؔر کے قبیلہ سے اُنہیں قِدِشؔ، دبیرتؔ، <verse eid="1CH 6:72"/><verse number="73" style="v" sid="1CH 6:73"/>راموتؔ اَور عنیمؔ اِردگرد کی چراگاہوں کی زمین سمیت ملے۔<verse eid="1CH 6:73"/></para>
  <para style="li1">
    <verse number="74" style="v" sid="1CH 6:74"/>اَور آشیر کے قبیلہ میں سے ماشالؔ، عبدونؔ، <verse eid="1CH 6:74"/><verse number="75" style="v" sid="1CH 6:75"/>حُقّوقؔ اَور رحوبؔ اِردگرد کی چراگاہوں سمیت ملے؛<verse eid="1CH 6:75"/></para>
  <para style="li1">
    <verse number="76" style="v" sid="1CH 6:76"/>اَور نفتالی کے قبیلہ میں سے گلِیل میں قِدِشؔ، حمّونؔ اَور قِریتائم مع اُن کی چراگاہوں کے ملے۔<verse eid="1CH 6:76"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="77" style="v" sid="1CH 6:77"/>اَور لیویوں میں سے باقی بنی مِراریؔ کو</para>
  <para style="li1" vid="1CH 6:77">جو زبُولُون کے قبیلہ میں سے، یُقنِعامؔ، قرتاہؔ،<note caller="+" style="f"><char style="fr" closed="false">6‏:77 </char><char style="fq" closed="false">قرتاہؔ </char><char style="ft" closed="false">کچھ نُسخوں میں یوقنیم، قرتاہؔ نہیں ہیں</char></note> رِمّونؔ، تبورؔ اِردگرد کی چراگاہوں سمیت ملے۔<verse eid="1CH 6:77"/></para>
  <para style="li1">
    <verse number="78" style="v" sid="1CH 6:78"/>اَور یردنؔ کے پار یریحوؔ کے مشرق میں رُوبِنؔ کے قبیلہ میں سے بیابان میں بضرؔ، یہصہؔ، <verse eid="1CH 6:78"/><verse number="79" style="v" sid="1CH 6:79"/>قدیموتؔ اَور مِفعتؔ مع چراگاہوں کے ساتھ ملے۔<verse eid="1CH 6:79"/></para>
  <para style="li1">
    <verse number="80" style="v" sid="1CH 6:80"/>اَور گادؔ کے قبیلہ میں سے گِلعادؔ میں راموتؔ، محنایمؔ، <verse eid="1CH 6:80"/><verse number="81" style="v" sid="1CH 6:81"/>حِشبونؔ یعزیرؔ جِن میں اِردگرد کی چراگاہیں بھی شامل تھیں۔<verse eid="1CH 6:81"/></para>
  <chapter eid="1CH 6"/>
  <chapter number="7" style="c" sid="1CH 7"/>
  <para style="s1">یِسَّکاؔر</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 7:1"/>بنی یِسَّکاؔر:</para>
  <para style="li2" vid="1CH 7:1">تولعؔ، پُوعہ، یَعشُوبؔ اَور شِمرون۔ کُل چار۔<verse eid="1CH 7:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 7:2"/>اَور بنی تولعؔ:</para>
  <para style="li2" vid="1CH 7:2">عُزّی، رِفایاہؔ، یری ایل، یحمائیؔ، اِبسامؔ اَور شموایلؔ جو اَپنے آبائی خاندانوں کے سردار تھے۔ داویؔد کے دَورِ حُکومت میں بنی تولعؔ کے جو افراد اَپنے نَسب ناموں میں بطور جنگجو درج کئے گیٔے وہ شُمار میں بائیس ہزار چھ سَو تھے۔<verse eid="1CH 7:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 7:3"/>عُزّی کا بیٹا اِزراحیاہؔ تھا۔</para>
  <para style="li1" vid="1CH 7:3">اِزراحیاہؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 7:3">مِیکاایلؔ، عبدیاہؔ، یُوایلؔ، یشیاہؔ۔ یہ پانچوں سَب کے سَب سردار تھے۔ <verse eid="1CH 7:3"/><verse number="4" style="v" sid="1CH 7:4"/>اُن کے آبائی نَسب ناموں کے مُطابق اُن کے پاس جنگ کے لیٔے تیّار چھتّیس ہزار جَوان تھے کیونکہ اُن کی بیویاں اَور بچّے بہت تھے۔<verse eid="1CH 7:4"/></para>
  <para style="lf">
    <verse number="5" style="v" sid="1CH 7:5"/>وہ رشتہ دار جو جنگجو مَرد تھے اَور یِسَّکاؔر کے تمام برادریوں سے تعلّق رکھتے تھے اُن کی کُل تعداد اُن کے نَسب ناموں کے مُطابق ستاسی ہزار تھی۔<verse eid="1CH 7:5"/></para>
  <para style="s1">بِنیامین</para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 7:6"/>بِنیامین کے تین بیٹے تھے:</para>
  <para style="li2" vid="1CH 7:6">بَیلعؔ، بِکیؔر اَور یدیع ایل۔<verse eid="1CH 7:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 7:7"/>بنی بَیلعؔ:</para>
  <para style="li2" vid="1CH 7:7">اِضبُنؔ، عُزّی، عُزّی ایل، یریموتؔ اَور عیری۔ یہ کل پانچ جو اَپنے آبائی خاندانوں کے سربراہ تھے۔ یہ اَپنے نَسب ناموں کے مُطابق بائیس ہزار چونتیس جنگجو مَرد تھے۔<verse eid="1CH 7:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 7:8"/>بنی بِکیؔر:</para>
  <para style="li2" vid="1CH 7:8">زمِیرہؔ، یُوآشؔ، الیعزرؔ، الیوعینائی، عُمریؔ، یریموتؔ، ابیّاہؔ، عناتوت اَور علیمتؔ۔ یہ سَب بِکیؔر کے بیٹے تھے <verse eid="1CH 7:8"/><verse number="9" style="v" sid="1CH 7:9"/>جو اَپنے آبائی خاندانوں کے سربراہ تھے۔ نَسب ناموں کے مُطابق اُن کے جنگجو مَردوں کی تعداد بیس ہزار دو سَو تھی۔<verse eid="1CH 7:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 7:10"/>یدیع ایل کا بیٹا:</para>
  <para style="li2" vid="1CH 7:10">بِلہانؔ تھا۔</para>
  <para style="li1" vid="1CH 7:10">بنی بِلہانؔ:</para>
  <para style="li2" vid="1CH 7:10">یعُوسؔ، بِنیامین، اہُودؔ، کنعانہؔ، زیتانؔ، ترشیشؔ اَور اخیشاحارؔ۔ <verse eid="1CH 7:10"/><verse number="11" style="v" sid="1CH 7:11"/>یدیع ایل کے یہ تمام بیٹے اَپنے آبائی خاندانوں کے سربراہ تھے۔ یہ سترہ ہزار دو سَو جنگجو مَرد تھے جو جنگ کے لیٔے تیّار رہتے تھے۔<verse eid="1CH 7:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 7:12"/>بنی عیرؔ: حُوشیمؔ یا شُفّیمؔ اَور حُفّیمؔ تھے اَور حُشیمؔ احیرؔ کے بیٹے تھے۔<verse eid="1CH 7:12"/></para>
  <para style="s1">نفتالی</para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 7:13"/>بنی نفتالی:</para>
  <para style="li2" vid="1CH 7:13">یحصیل، گُونی، یصرؔ اَور شلُّومؔ<note caller="+" style="f"><char style="fr" closed="false">7‏:13 </char><char style="fq" closed="false">شلُّومؔ </char><char style="ft" closed="false">کچھ نُسخوں میں شلّیمؔ ہے</char></note> یہ تمام بنی بِلہاہؔ تھے۔<verse eid="1CH 7:13"/></para>
  <para style="s1">بنی منشّہ</para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 7:14"/>بنی منشّہ:</para>
  <para style="li2" vid="1CH 7:14">منشّہ کے ایک بیٹے کا نام اَسری ایل تھا اَور اُس کی ارامی داشتہ کے بطن سے گِلعادؔ کا باپ مکیرؔ پیدا ہُوا۔ <verse eid="1CH 7:14"/><verse number="15" style="v" sid="1CH 7:15"/>حُفّیمؔ اَور شُفّیمؔ کی ایک بہن تھی جِس کا نام معکہؔ تھا جِس سے مکیرؔ نے بیاہ کر لیا۔ دُوسرے کا نام ضلافحادؔ تھا جِس کی صِرف بیٹیاں ہی تھیں۔ <verse eid="1CH 7:15"/><verse number="16" style="v" sid="1CH 7:16"/>مکیرؔ کی بیوی معکہؔ نے ایک بیٹے کو پیدا کیا اَور اُس کا نام پِریسؔ رکھا اَور اُس کے بھایٔی کا نام شِرِسؔ تھا اَور اُس کے بیٹے اولامؔ اَور رِقیمؔ تھے۔<verse eid="1CH 7:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 7:17"/>اولامؔ کا بیٹا:</para>
  <para style="li2" vid="1CH 7:17">بدانؔ تھا۔</para>
  <para style="li1" vid="1CH 7:17">یہ گِلعادؔ بِن مکیرؔ بِن منشّہ کے پرپوتے تھے۔<verse eid="1CH 7:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 7:18"/>اَور اُس کی بہن ہَمّولکِتؔ سے اِشہُودؔ، ابیعزیر اَور محلاہؔ پیدا ہُوئے۔<verse eid="1CH 7:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 7:19"/>اَور بنی شمیدعؔ یہ تھے:</para>
  <para style="li2" vid="1CH 7:19">احیانؔ، شِکیمؔ، لِقحی اَور انِیعامؔ۔<verse eid="1CH 7:19"/></para>
  <para style="s1">بنی اِفرائیمؔ</para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 7:20"/>بنی اِفرائیمؔ:</para>
  <para style="li2" vid="1CH 7:20">شُوتلحؔ، اُس کا بیٹا بیردؔ،</para>
  <para style="li2" vid="1CH 7:20">اُس کا بیٹا تحتؔ، اُس کا بیٹا اِلِیعدہ،</para>
  <para style="li2" vid="1CH 7:20">اُس کا بیٹا تحتؔ، <verse eid="1CH 7:20"/><verse number="21" style="v" sid="1CH 7:21"/>اُس کا بیٹا زابادؔ</para>
  <para style="li2" vid="1CH 7:21">اَور اُس کا بیٹا شُوتلحؔ،</para>
  <para style="li2" vid="1CH 7:21">عِزیرؔ اَور اِلِیعدؔ۔ دونوں کو گاتؔھ کے مقامی باشِندوں نے مار ڈالا جَب وہ اُن کے مویشی چھیننے کے لیٔے اُن پر حملہ آور ہُوئے۔ <verse eid="1CH 7:21"/><verse number="22" style="v" sid="1CH 7:22"/>اُن کے باپ اِفرائیمؔ نے بہت دِنوں تک اُن کا ماتم کیا اَور اُس کے رشتہ دار اُسے تسلّی دینے آئے۔ <verse eid="1CH 7:22"/><verse number="23" style="v" sid="1CH 7:23"/>اُس کے بعد وہ اَپنی بیوی کے پاس گیا اَور وہ حاملہ ہُوئی اَور ایک بیٹے کو پیدا کیا اَور اُس کا نام بریعہؔ<note caller="+" style="f"><char style="fr" closed="false">7‏:23 </char><char style="fq" closed="false">بریعہؔ </char><char style="ft" closed="false">یعنی آفت</char></note> رکھا کیونکہ اُس کے گھرانے پر آفت آئی تھی۔ <verse eid="1CH 7:23"/><verse number="24" style="v" sid="1CH 7:24"/>اُس کی بیٹی شِراہؔ جِس نے نشیبی اَور بالائی بیت حَورُونؔ کو اَور عُزّنؔ شِراہؔ کو بھی بنایا تھا۔<verse eid="1CH 7:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 7:25"/>اُس کا بیٹا رِفاحؔ تھا اَور اُس کا بیٹا رِشِفؔ</para>
  <para style="li2" vid="1CH 7:25">اَور اُس کا بیٹا تیلاحؔ اَور اُس کا بیٹا تحنؔ،<verse eid="1CH 7:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 7:26"/>اَور اُس کا بیٹا لعدانؔ اَور اُس کا بیٹا عمّیہُوؔد</para>
  <para style="li2" vid="1CH 7:26">اَور اُس کا بیٹا اِلیشمعؔ، <verse eid="1CH 7:26"/><verse number="27" style="v" sid="1CH 7:27"/>اَور اُس کا بیٹا نُونؔ</para>
  <para style="li2" vid="1CH 7:27">اَور اُس کا بیٹا یہوشُعؔ۔<verse eid="1CH 7:27"/></para>
  <para style="lf">
    <verse number="28" style="v" sid="1CH 7:28"/>اُن کی آراضی میں بستیاں یہ تھیں: بیت ایل اَور اُس کے گِردونواح کے دیہات، مشرق کی طرف نعرانؔ اَور مغرب کی طرف گِزرؔ اَور اُس کے دیہات اَور شِکیمؔ اَور اُس کے دیہات، عیّاہؔ اَور اُس کے دیہات تک۔ <verse eid="1CH 7:28"/><verse number="29" style="v" sid="1CH 7:29"/>اَور بنی منشّہ کی حُدوُد کے پاس بیت شانؔ اَور اُس کے دیہات، تعناکؔ، مگِدّوؔ اَور دورؔ اَور اُن کے دیہات۔ اِن میں بنی یُوسیفؔ بِن اِسرائیل کی بستیاں تھیں۔<verse eid="1CH 7:29"/></para>
  <para style="s1">آشیر</para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 7:30"/>بنی آشیر:</para>
  <para style="li2" vid="1CH 7:30">یِمنہؔ، اِشواہؔ، اِشویؔ، بریعہؔ اَور اُن کی بہن سراحؔ۔<verse eid="1CH 7:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 7:31"/>بریعہؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 7:31">حِبرؔ اَور مَلکی ایل جو بِرزائیتؔ کا باپ تھا۔<verse eid="1CH 7:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 7:32"/>اَور حِبرؔ سے یفلِیطؔ، شومیرؔ، حوتھامؔ اَور اُن کی بہن شُوعؔ پیدا ہُوئے۔<verse eid="1CH 7:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 7:33"/>بنی یفلِیطؔ:</para>
  <para style="li2" vid="1CH 7:33">پاساخؔ، بیمہالؔ اَور عسواتؔ۔</para>
  <para style="lf" vid="1CH 7:33">یہ بنی یفلِیطؔ ہیں<verse eid="1CH 7:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 7:34"/>اَور بنی شومیرؔ:</para>
  <para style="li2" vid="1CH 7:34">احی، روہگاہؔ، حُبّہؔ اَور ارام۔<verse eid="1CH 7:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 7:35"/>اَور اُس کے بھایٔی ہِیلمؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 7:35">صُوفح، یِمنہؔ، شِلشؔ اَور عملؔ۔<verse eid="1CH 7:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 7:36"/>بنی صُوفح:</para>
  <para style="li2" vid="1CH 7:36">سُعاحؔ، حارنیفرؔ، شُعالؔ، بیؔری اَور اِمراہؔ، <verse eid="1CH 7:36"/><verse number="37" style="v" sid="1CH 7:37"/>بضرؔ، ہُودؔ، شمّاؔ، شِلشہؔ، اِترانؔ اَور بِیراؔ۔<verse eid="1CH 7:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 7:38"/>اَور بنی یترؔ یا اِترانؔ:</para>
  <para style="li2" vid="1CH 7:38">یفُنّہؔ، پسپاؔ اَور آراؔ۔<verse eid="1CH 7:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 7:39"/>اَور بنی عُلّہؔ:</para>
  <para style="li2" vid="1CH 7:39">ارخؔ، حنّی ایل اَور رضیاہؔ۔<verse eid="1CH 7:39"/></para>
  <para style="lf">
    <verse number="40" style="v" sid="1CH 7:40"/>یہ تمام بنی آشیر تھے یعنی وہ جو اَپنے آبائی خاندانوں کے سربراہ، چیدہ افراد، زبردست سُورما اَور نُمایاں سربراہ تھے۔ اُن کے نَسب ناموں کے مُطابق جنگ کرنے کے لائق جَوانوں کی تعداد چھبّیس ہزار تھی۔<verse eid="1CH 7:40"/></para>
  <chapter eid="1CH 7"/>
  <chapter number="8" style="c" sid="1CH 8"/>
  <para style="s1">بنی ںبِنیامینی شاؤل کا نَسب نامہ</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 8:1"/>بِنیامین کا پہلوٹھا بیٹا بَیلعؔ تھا۔</para>
  <para style="li2" vid="1CH 8:1">اَشبیلؔ اُس کا دُوسرا بیٹا اَور احرحؔ تیسرا بیٹا تھا۔ <verse eid="1CH 8:1"/><verse number="2" style="v" sid="1CH 8:2"/>نُوحاہؔ چوتھا اَور رافاؔ پانچواں تھا۔<verse eid="1CH 8:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 8:3"/>بَیلعؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 8:3">ادّارؔ، گیراؔ، اَبِیہُودؔ، <verse eid="1CH 8:3"/><verse number="4" style="v" sid="1CH 8:4"/>ابیشُوعؔ، نَعمانؔ اَور احوحؔ <verse eid="1CH 8:4"/><verse number="5" style="v" sid="1CH 8:5"/>اَور گیراؔ، شپوپانؔ اَور حُورامؔ۔<verse eid="1CH 8:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 8:6"/>اہُودؔ کے بیٹے جو گِبعؔ میں رہنے والوں کے آبائی خاندانوں کے سربراہ تھے اَور جنہیں اسیر بنا کر مناحاتؔ لے جایا گیا تھا وہ یہ تھے:<verse eid="1CH 8:6"/></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 8:7"/>نَعمانؔ، اخیاہؔ اَور گیراؔ جِس نے اُنہیں مُلک بدر کیا اَور جِس سے عُزّاؔ اَور اخیہُودؔ پیدا ہُوئے۔<verse eid="1CH 8:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 8:8"/>اَور شحریمؔ سے مُوآب کے مُلک میں اَپنی دونوں بیویوں حُوشیمؔ اَور بعراہؔ کو چھوڑدینے کے بعد جو لڑکے پیدا ہُوئے یہ ہیں: <verse eid="1CH 8:8"/><verse number="9" style="v" sid="1CH 8:9"/>اُس کی بیوی ہُودشؔ کے بطن سے یُوبابؔ، ضِبیاہؔ، میشاؔ، اَور ملکامؔ، <verse eid="1CH 8:9"/><verse number="10" style="v" sid="1CH 8:10"/>اَور یعُوضؔ، سکیاہؔ اَور مِرمہؔ۔ اُس کے یہ بیٹے آبائی خاندانوں کے سربراہ تھے۔ <verse eid="1CH 8:10"/><verse number="11" style="v" sid="1CH 8:11"/>اَور حُوشیمؔ کے بطن سے ابِیطوبؔ اَور ایلپعلؔ۔<verse eid="1CH 8:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 8:12"/>اَور بنی ایلپعلؔ:</para>
  <para style="li2" vid="1CH 8:12">عِبرؔ، مِشعامؔ اَور شیمیدؔ (اُسی نے اُونوؔ اَور لُودؔ شہروں کو بنوایا اَور اُس کے گِردونواح کے دیہات آباد کئے)۔ <verse eid="1CH 8:12"/><verse number="13" style="v" sid="1CH 8:13"/>اَور بریعہؔ اَور شِمعؔ بھی ایّالونؔ کے باشِندوں کے درمیان آبائی خاندانوں کے سربراہ تھے اَور جنہوں نے گاتؔھ کے باشِندوں کو نکال دیا تھا۔<verse eid="1CH 8:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 8:14"/>اَور اخیوؔ، شاشقؔ، یریموتؔ، <verse eid="1CH 8:14"/><verse number="15" style="v" sid="1CH 8:15"/>زبدیاہؔ، عَرادؔ، عیدرؔ، <verse eid="1CH 8:15"/><verse number="16" style="v" sid="1CH 8:16"/>مِیکاایلؔ، اِسپاہؔ، یوحا جو بنی بریعہؔ تھے۔<verse eid="1CH 8:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 8:17"/>اَور زبدیاہؔ، مِشُلّامؔ، حزقی، حِبرؔ، <verse eid="1CH 8:17"/><verse number="18" style="v" sid="1CH 8:18"/>ایشمیرائی، یزلیہؔ اَور یُوبابؔ</para>
  <para style="li1" vid="1CH 8:18">جو بنی ایلپعلؔ تھے۔<verse eid="1CH 8:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 8:19"/>اَور یاقیمؔ، زکریؔ، زبدیؔ، <verse eid="1CH 8:19"/><verse number="20" style="v" sid="1CH 8:20"/>العینائی، ضِلّیتائیؔ، الی ایل، <verse eid="1CH 8:20"/><verse number="21" style="v" sid="1CH 8:21"/>عدایاہؔ، برایاہؔ اَور شمراتھؔ جو بنی شِمعیؔ تھے۔<verse eid="1CH 8:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 8:22"/>اِسفانؔ، عِبرؔ، الی ایل، <verse eid="1CH 8:22"/><verse number="23" style="v" sid="1CH 8:23"/>عبدونؔ، زکریؔ، حنانؔ، <verse eid="1CH 8:23"/><verse number="24" style="v" sid="1CH 8:24"/>حننیاہؔ، عیلامؔ، عنتوتیاہؔ، <verse eid="1CH 8:24"/><verse number="25" style="v" sid="1CH 8:25"/>یفدیاہؔ، پنی ایل جو بنی شاشقؔ تھے۔<verse eid="1CH 8:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 8:26"/>اَور شمشرئیؔ، شحاریاہؔ، عتلیاہؔ، <verse eid="1CH 8:26"/><verse number="27" style="v" sid="1CH 8:27"/>یعرشیاہؔ، ایلیّاہ اَور زکریؔ جو بنی یروحامؔ تھے۔<verse eid="1CH 8:27"/></para>
  <para style="lf">
    <verse number="28" style="v" sid="1CH 8:28"/>یہ تمام اَپنے آبائی خاندانوں کے نَسب نامے کے مُطابق سربراہ اَور سردار تھے اَور وہ یروشلیمؔ میں رہتے تھے۔<verse eid="1CH 8:28"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 8:29"/>اَور گِبعونؔ کا باپ یعی ایل گِبعونؔ میں رہتا تھا جِس کی</para>
  <para style="li2" vid="1CH 8:29">بیوی کا نام معکہؔ تھا۔ <verse eid="1CH 8:29"/><verse number="30" style="v" sid="1CH 8:30"/>اَور اُس کا پہلوٹھا بیٹا عبدونؔ تھا اُس کے بعد ضُورؔ، قیشؔ، بَعل، نیرؔ، نادابؔ، <verse eid="1CH 8:30"/><verse number="31" style="v" sid="1CH 8:31"/>گدُورؔ، اخیوؔ، زِکرؔ۔ <verse eid="1CH 8:31"/><verse number="32" style="v" sid="1CH 8:32"/>اَور مِقلوتؔ شِمعہؔ کا باپ تھا۔ یہ بھی اَپنے رشتہ داروں کے نزدیک یروشلیمؔ ہی میں رہتے تھے۔<verse eid="1CH 8:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 8:33"/>اَور نیرؔ سے قیشؔ پیدا ہُوا اَور قیشؔ سے شاؤل اَور شاؤل یُوناتانؔ، ملکِیشوعؔ، ابینادابؔ اَور اشبعلؔ کا باپ تھا۔<verse eid="1CH 8:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 8:34"/>اَور بنی یُوناتانؔ یہ ہیں:</para>
  <para style="li2" vid="1CH 8:34">مریبعلؔ جو میکاہؔ کا باپ تھا۔<verse eid="1CH 8:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 8:35"/>اَور بنی میکاہؔ:</para>
  <para style="li2" vid="1CH 8:35">پیتونؔ، ملِکؔ، تاریعؔ اَور آحازؔ۔<verse eid="1CH 8:35"/></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 8:36"/>اَور آحازؔ سے یہُوعدّہؔ، یہُوعدّہؔ سے علیمتؔ، عزماوتؔ اَور زِمریؔ پیدا ہُوئے۔ اَور زِمریؔ سے موضاؔ <verse eid="1CH 8:36"/><verse number="37" style="v" sid="1CH 8:37"/>اَور موضاؔ سے بِنعہؔ، بِنعہؔ کا بیٹا رافاؔ اَور رافاؔ کا بیٹا ایلعساہؔ اَور ایلعساہؔ کا بیٹا اضیلؔ۔<verse eid="1CH 8:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 8:38"/>اَور اضیلؔ کے چھ بیٹے تھے جِن کے نام یہ ہیں:</para>
  <para style="li2" vid="1CH 8:38">عزریقامؔ، بوخیرُوؔ، اِشمعیل، شعریاہؔ، عبدیاہؔ اَور حانانؔ۔ یہ تمام اضیلؔ کے بیٹے تھے۔<verse eid="1CH 8:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 8:39"/>اُس کے بھایٔی عیشقؔ کے بیٹے یہ ہیں:</para>
  <para style="li2" vid="1CH 8:39">اُس کا پہلوٹھا اولامؔ، دُوسرا بیٹا یعُوسؔ، اَور تیسرا الیفلطؔ۔ <verse eid="1CH 8:39"/><verse number="40" style="v" sid="1CH 8:40"/>اَور اولامؔ کے بیٹے زبردست سُورما اَور تیر اَنداز تھے اَور اُن کے بہت سے بیٹے اَور پوتے تھے جو کُل ڈیڑھ سَو تھے۔</para>
  <para style="li1" vid="1CH 8:40">یہ تمام بنی بِنیامین تھے۔<verse eid="1CH 8:40"/></para>
  <para style="b"/>
  <chapter eid="1CH 8"/>
  <chapter number="9" style="c" sid="1CH 9"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1"/>تمام بنی اِسرائیل اُن نَسب ناموں کے مُطابق گِنا گیا جو بنی اِسرائیل کے بادشاہوں کی کِتاب میں درج ہیں۔ یہُوداہؔ کے لوگ اَپنی دغابازی کے باعث گِرفتار ہُوئے اَور بابیل لے جائے گیٔے۔<verse eid="1CH 9:1"/></para>
  <para style="s1">یروشلیمؔ کے باشِندے</para>
  <para style="lh">
    <verse number="2" style="v" sid="1CH 9:2"/>اَورجو پہلے اَپنی مِلکیّت اَور اَپنے شہروں میں بسے وہ اِسرائیلی، کاہِنؔ، لیوی اَور بیت المُقدّس کے خُدّام تھے۔<verse eid="1CH 9:2"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="3" style="v" sid="1CH 9:3"/>اَور بنی یہُوداہؔ، بنی بِنیامین، بنی اِفرائیمؔ اَور بنی منشّہ کے وہ لوگ جو یروشلیمؔ میں رہتے تھے مُندرجہ ذیل تھے:<verse eid="1CH 9:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 9:4"/>عوطیؔ بِن عمّیہُوؔد بِن عُمریؔ بِن اِمریؔ بِن بانیؔ جو پیریزؔ بِن</para>
  <para style="li1" vid="1CH 9:4">یہُوداہؔ کی اَولاد میں سے تھا۔<verse eid="1CH 9:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 9:5"/>شیلونیوں میں سے:</para>
  <para style="li2" vid="1CH 9:5">عسایاہؔ اُس کا پہلوٹھا اَور اُس کے بیٹے۔<verse eid="1CH 9:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 9:6"/>بنی زیراحؔ میں سے:</para>
  <para style="li2" vid="1CH 9:6">یعوایلؔ،</para>
  <para style="lf" vid="1CH 9:6">یہُوداہؔ کے لوگوں کا شُمار جو یروشلیمؔ میں رہتے تھے چھ سَو نوّے تھا۔<verse eid="1CH 9:6"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="7" style="v" sid="1CH 9:7"/>بنی بِنیامین میں سے:</para>
  <para style="li1" vid="1CH 9:7">سلُّوؔ بِن مِشُلّامؔ بِن ہُوداویاہؔ بِن ہسّنوآہ؛<verse eid="1CH 9:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 9:8"/>اَور اِبنیاہؔ بِن یروحامؔ اَور اَیلہ بِن عُزّی بِن مِکریؔ؛</para>
  <para style="li1" vid="1CH 9:8">اَور مِشُلّامؔ بِن شفطیاہؔ بِن رِعوایلؔ بِن اِبنیاہؔ۔<verse eid="1CH 9:8"/></para>
  <para style="lf">
    <verse number="9" style="v" sid="1CH 9:9"/>بِنیامینیوں کے جو لوگ اَپنے نَسب ناموں کے مُطابق درج ہُوئے اُن کا شُمار نَو سَو چھپّن تھا۔ یہ تمام افراد اَپنے آبائی خاندانوں کے سردار تھے۔<verse eid="1CH 9:9"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="10" style="v" sid="1CH 9:10"/>اَور کاہِنوں میں سے:</para>
  <para style="li1" vid="1CH 9:10">یدعیاہؔ، یہُویرِیبؔ، یاکِن؛<verse eid="1CH 9:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 9:11"/>عزریاہؔ بِن خِلقیاہؔ بِن مِشُلّامؔ بِن صدُوقؔ بِن مرایوتؔ بِن احِیطوبؔ جو خُدا کے گھر کا مختار تھا۔<verse eid="1CH 9:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 9:12"/>عدایاہؔ بِن یروحامؔ بِن پشحُورؔ بِن ملکیاہؔ؛</para>
  <para style="li1" vid="1CH 9:12">اَور معسی بِن عدی ایل بِن یحزیراہؔ بِن مِشُلّامؔ بِن مسلّمیتؔ بِن اِمّیرؔ۔<verse eid="1CH 9:12"/></para>
  <para style="lf">
    <verse number="13" style="v" sid="1CH 9:13"/>وہ کاہِنؔ جو اَپنے آبائی خاندانوں کے سربراہ تھے شُمار میں ایک ہزار سات سَوساٹھ تھے۔ خُدا کے گھر میں خدمت کرنے کا کام اُن کے ذمّہ تھا۔<verse eid="1CH 9:13"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="14" style="v" sid="1CH 9:14"/>اَور لیویوں میں سے:</para>
  <para style="li1" vid="1CH 9:14">شمعیاہؔ بِن حشُوبؔ بِن عزریقامؔ جو</para>
  <para style="li1" vid="1CH 9:14">بنی مِراریؔ کے ایک فرد حشبیاہؔ کا بیٹا تھا؛ <verse eid="1CH 9:14"/><verse number="15" style="v" sid="1CH 9:15"/>بقبقّرؔ، حیریشؔ، گلالؔ</para>
  <para style="li1" vid="1CH 9:15">اَور متّنیاہؔ بِن میکاؔ بِن زکریؔ بِن آسفؔ؛<verse eid="1CH 9:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 9:16"/>عبدیاہؔ بِن شمعیاہؔ بِن گلالؔ بِن یدُوتونؔ؛</para>
  <para style="li1" vid="1CH 9:16">اَور بیرکیاہؔ بِن آساؔ بِن اِلقانہؔ جو نطُوفاتیوں کے دیہاتوں میں رہتے تھے۔<verse eid="1CH 9:16"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="17" style="v" sid="1CH 9:17"/>اَور دربانوں میں سے یہ لوگ تھے:</para>
  <para style="li1" vid="1CH 9:17">شلُّومؔ، عقُّوبؔ، طلمُونؔ، احیمانؔ اَور اُن کے بھایٔی۔ شلُّومؔ اُن کا سردار تھا۔ <verse eid="1CH 9:17"/><verse number="18" style="v" sid="1CH 9:18"/>یہ مشرق کی طرف بادشاہ کے محل کے دروازہ پر مُعیّن تھے اَور بنی لیوی کی لشکرگاہ کے نگہبان تھے۔<verse eid="1CH 9:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 9:19"/>اَور شلُّومؔ بِن قورؔے بِن اَبی آسفؔ بِن قورحؔ اَور اُس کے آبائی خاندان میں سے اُس کے ساتھی دربان (یعنی قوراحی) خیمہ کے پھاٹکوں کی نگہبانی کے ذمّہ دار تھے، بالکُل اُسی طرح جَیسے اُن کے آباؤاَجداد یَاہوِہ کے قِیام کے مدخل کی نگہبانی کے ذمّہ دار تھے۔<verse eid="1CH 9:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 9:20"/>اُس سے پیشتر فِنحاسؔ بِن الیعزرؔ دربانوں کا سردار تھا اَور یَاہوِہ اُس کے ساتھ تھے۔<verse eid="1CH 9:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 9:21"/>زکریاؔہ بِن مِشلمیاہؔ خیمہ اِجتماع کے دروازہ کا نگہبان تھا۔<verse eid="1CH 9:21"/></para>
  <para style="lf">
    <verse number="22" style="v" sid="1CH 9:22"/>وہ جو دربان ہونے کے لیٔے چُنے گیٔے کُل مِلا کر دو سَو بَارہ تھے۔ اُنہیں دیہات میں اُن کے نَسب ناموں کے مُطابق گِنا گیا۔</para>
  <para style="b" vid="1CH 9:22"/>
  <para style="p" vid="1CH 9:22">دربانوں کو اُن کے قابلِ اِعتبار منصب پر داویؔد اَور شموایلؔ غیب بین نے مُقرّر کیا تھا۔ <verse eid="1CH 9:22"/><verse number="23" style="v" sid="1CH 9:23"/>وہ اَور اُن کے بیٹے یَاہوِہ کے گھر یعنی مَسکن کے پھاٹکوں کی نگہبانی پر مامُور تھے۔ <verse eid="1CH 9:23"/><verse number="24" style="v" sid="1CH 9:24"/>دربان مشرق، مغرب، شمال اَور جُنوب میں چاروں طرف مُقرّر کئے گیٔے تھے <verse eid="1CH 9:24"/><verse number="25" style="v" sid="1CH 9:25"/>اَور اُن کے بھایٔی جو اَپنے اَپنے گاؤں میں تھے اُنہیں سات سات دِن کے بعد اَپنی اَپنی باری کے اوقات پر اَپنے فرائض کی ادائیگی کے لیٔے آنا پڑتا تھا۔ <verse eid="1CH 9:25"/><verse number="26" style="v" sid="1CH 9:26"/>مگر خُدا کے گھر کے حُجروں اَور خزانوں کی ذمّہ داری دربانوں کے چاروں لیوی سرداروں کے سُپرد تھی۔ <verse eid="1CH 9:26"/><verse number="27" style="v" sid="1CH 9:27"/>اَور وہ رات بھر نگہبانی کے لیٔے خُدا کے گھر کے پاس ہی رہتے تھے۔ اَور ہر صُبح اُسے کھولنے والی چابی اُن کے پاس رہتی تھی۔<verse eid="1CH 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28"/>اُن میں سے بعض افراد مَقدِس کی خدمات میں اِستعمال ہونے والے ظروف کے ناظِم تھے۔ وہ اُنہیں گِن کر مَقدِس کے اَندر لاتے تھے اَور گِن کر مَقدِس سے باہر لے جاتے تھے۔ <verse eid="1CH 9:28"/><verse number="29" style="v" sid="1CH 9:29"/>اُن میں سے بعض کے ذمّہ سازوسامان اَور پاک مَقدِس کی دیگر اَشیا، نیز مَیدہ، مَے اَور تیل، لوبان اَور خُوشبودار مَسالوں کی نگہداشت تھی۔ <verse eid="1CH 9:29"/><verse number="30" style="v" sid="1CH 9:30"/>مگر بعض کاہِنؔ خُوشبودار مَسالوں کو باہم مِلانے پر مامُور تھے۔ <verse eid="1CH 9:30"/><verse number="31" style="v" sid="1CH 9:31"/>اَور متّتیاہؔ نامی ایک لیوی کو جو بنی قورحؔ شلُّومؔ کا پہلوٹھا بیٹا تھا جسے نذر کی روٹی تیّار کرنے کی ذمّہ داری سُپرد کی گئی تھی۔ <verse eid="1CH 9:31"/><verse number="32" style="v" sid="1CH 9:32"/>اَور اُن کے بعض قُہاتی بھایٔی ہر سَبت کو نذر کی روٹیاں تیّار کرنے اَور اُنہیں ترتیب سے رکھنے پر مامُور تھے۔<verse eid="1CH 9:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33"/>اَور لیویوں کے آبائی خاندانوں کے سردار جو موسیقار تھے وہ مَقدِس کے حُجروں میں رہتے تھے اَور دیگر فرائض سے مُستثنیٰ تھے کیونکہ وہ دِن رات اَپنے کام میں مشغُول رہتے تھے۔<verse eid="1CH 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34"/>جَیسا کہ اُن کے نَسب ناموں میں درج ہے یہ سَب اَپنے اَپنے آبائی لیوی خاندانوں کے سربراہ اَور سردار تھے اَور یروشلیمؔ میں رہتے تھے۔<verse eid="1CH 9:34"/></para>
  <para style="s1">شاؤل کا نَسب نامہ</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 9:35"/>اَور گِبعونؔ کا باپ یعی ایل گِبعونؔ میں رہتا تھا۔</para>
  <para style="li2" vid="1CH 9:35">جِس کی بیوی کا نام معکہؔ تھا۔ <verse eid="1CH 9:35"/><verse number="36" style="v" sid="1CH 9:36"/>اَور اُس کا پہلوٹھا بیٹا عبدونؔ تھا۔ اُس کے بعد ضُورؔ، قیشؔ، بَعل، نیرؔ، نادابؔ، <verse eid="1CH 9:36"/><verse number="37" style="v" sid="1CH 9:37"/>گدُورؔ، اخیوؔ، زکریاؔہ اَور مِقلوتؔ، <verse eid="1CH 9:37"/><verse number="38" style="v" sid="1CH 9:38"/>اَور مِقلوتؔ شِمعامؔ کا باپ تھا۔ یہ بھی اَپنے رشتہ داروں کے نزدیک یروشلیمؔ ہی میں رہتے تھے۔<verse eid="1CH 9:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 9:39"/>اَور نیرؔ سے قیشؔ پیدا ہُوا اَور قیشؔ سے شاؤل،</para>
  <para style="li1" vid="1CH 9:39">اَور شاؤل یُوناتانؔ، ملکِیشوعؔ، ابینادابؔ اَور اشبعلؔ کا باپ تھا۔<verse eid="1CH 9:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 9:40"/>اَور بنی یُوناتانؔ یہ ہیں:</para>
  <para style="li2" vid="1CH 9:40">مریبعلؔ جو میکاہؔ کا باپ تھا۔<verse eid="1CH 9:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 9:41"/>اَور بنی میکاہؔ:</para>
  <para style="li2" vid="1CH 9:41">پیتونؔ، ملِکؔ، تحریعؔ اَور آحازؔ۔<verse eid="1CH 9:41"/></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 9:42"/>اَور آحازؔ سے یعرہؔ پیدا ہُوا اَور یعرہؔ سے علیمتؔ، عزماوتؔ اَور زِمریؔ پیدا ہُوئے۔ اَور زِمریؔ سے موضاؔ پیدا ہُوا <verse eid="1CH 9:42"/><verse number="43" style="v" sid="1CH 9:43"/>اَور موضاؔ سے بِنعہؔ اَور بِنعہؔ سے رِفایاہؔ اَور رِفایاہؔ سے ایلعساہؔ اَور</para>
  <para style="li1" vid="1CH 9:43">ایلعساہؔ سے اضیلؔ۔<verse eid="1CH 9:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 9:44"/>اضیلؔ کے چھ بیٹے تھے جِن کے نام یہ ہیں:</para>
  <para style="li2" vid="1CH 9:44">عزریقامؔ، بوخیرُوؔ، اِشمعیل، شعریاہؔ، عبدیاہؔ اَور حانانؔ۔ یہ اضیلؔ کے بیٹے تھے۔<verse eid="1CH 9:44"/></para>
  <chapter eid="1CH 9"/>
  <chapter number="10" style="c" sid="1CH 10"/>
  <para style="s1">شاؤل کا خُودکُشی کرنا</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1"/>اَور فلسطینی اِسرائیل سے لڑے اَور اِسرائیلی اُن کے سامنے سے بھاگے اَور بہت سے قتل ہوکر گِلبوعہؔ پہاڑی پر گِرے۔ <verse eid="1CH 10:1"/><verse number="2" style="v" sid="1CH 10:2"/>اَور فلسطینیوں نے شاؤل اَور اُس کے بیٹوں کا بڑی سرگرمی سے تعاقب کیا اَور اُس کے بیٹوں یُوناتانؔ، ابینادابؔ اَور ملکِیشوعؔ کو مار ڈالا۔ <verse eid="1CH 10:2"/><verse number="3" style="v" sid="1CH 10:3"/>جَب شاؤل کے اِردگرد جنگ بہت شدید ہو گئی اَور تیر اَندازوں نے اُسے جا لیا اَور تیروں سے اُسے زخمی کر دیا۔<verse eid="1CH 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 10:4"/>تَب شاؤل نے اَپنے سلاح بردار سے کہا، ”اَپنی تلوار کھینچ اَور میرے جِسم میں گھونپ دے ورنہ وہ نامختون آکر مُجھے چھید کر بے عزّت کر دیں گے۔“</para>
  <para style="p" vid="1CH 10:4">لیکن اُس کا سلاح بردار خوف اَور دہشت کے باعث اَیسا نہ کر سَکا۔ لہٰذا شاؤل نے اَپنی تلوار لی اَور اُس پر جا گرا۔ <verse eid="1CH 10:4"/><verse number="5" style="v" sid="1CH 10:5"/>جَب اُس کے سلاح بردار نے دیکھا کہ شاؤل مَر گیا تو وہ بھی اَپنی تلوار پر گرا اَور اُس کے ساتھ مَر گیا۔ <verse eid="1CH 10:5"/><verse number="6" style="v" sid="1CH 10:6"/>پس شاؤل اَور اُس کے تینوں بیٹے مَر گیٔے اَور اُس کا سارا خاندان نابود ہو گیا۔<verse eid="1CH 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7"/>جَب وادی کے تمام بنی اِسرائیل نے دیکھا کہ اِسرائیلی فَوج بھاگ گئی ہے اَور شاؤل اَور اُس کے بیٹے مَر گیٔے ہیں تو وہ بھی اَپنے شہروں کو چھوڑکر بھاگ نکلے اَور فلسطینی آئے اَور وہاں رہنے لگے۔<verse eid="1CH 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8"/>اگلے دِن جَب فلسطینی لاشوں کے کپڑے وغیرہ اُتارنے آئے تو اُنہُوں نے دیکھا کہ شاؤل اَور اُس کے بیٹوں کی لاشیں گِلبوعہؔ پہاڑ پر پڑی ہُوئی ہیں۔ <verse eid="1CH 10:8"/><verse number="9" style="v" sid="1CH 10:9"/>اِس لئے اُنہُوں نے اُسے برہنہ کیا اَور شاؤل کا سَر کاٹ لیا اَور اُس کے زرہ بکتر اُتار لیٔے اَور فلسطینیوں کے مُلک میں چاروں طرف اَپنے بُت خانوں میں اَور تمام لوگوں کے درمیان اِس خُوشخبری کا اعلان کرنے کے لیٔے قاصِد بھیجے۔ <verse eid="1CH 10:9"/><verse number="10" style="v" sid="1CH 10:10"/>اُنہُوں نے اُس کے زرہ بکتر کو اَپنے معبُودوں کے مَندِر میں رکھا اَور اُس کے سَر کو دگونؔ کے مَندِر میں ٹانگ دیا۔<verse eid="1CH 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11"/>جَب یبیسؔ گِلعادؔ کے تمام باشِندوں تک یہ خبر پہُنچی جو فلسطینیوں نے شاؤل سے کیا تھا سُنا <verse eid="1CH 10:11"/><verse number="12" style="v" sid="1CH 10:12"/>تو اُن کے تمام سُورما مَرد گیٔے اَور شاؤل اَور اُس کے بیٹوں کی لاشیں اُٹھاکر یبیسؔ میں لے آئے۔ اُنہُوں نے اُن کی ہڈّیاں یبیسؔ میں بلُوط کے درخت کے نیچے دفن کر دیں اَور سات دِن تک روزہ رکھا۔<verse eid="1CH 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13"/>شاؤل اِس لیٔے مَرا کہ اُس نے دغا کی تھی اَور یَاہوِہ کے حُکم کی خِلاف ورزی کی تھی یہاں تک کہ اُس نے اَپنی رہنمائی کے لیٔے اَرواح کو طلب کرنے والی عورت سے مشورہ کیا۔ <verse eid="1CH 10:13"/><verse number="14" style="v" sid="1CH 10:14"/>اَور یَاہوِہ سے دریافت نہ کیا۔ اِس لیٔے یَاہوِہ نے اُسے مار ڈالا اَور سلطنت یِشائی کے بیٹے داویؔد کے ہاتھوں میں دے دی۔<verse eid="1CH 10:14"/></para>
  <chapter eid="1CH 10"/>
  <chapter number="11" style="c" sid="1CH 11"/>
  <para style="s1">داویؔد کا اِسرائیل کا بادشاہ بننا</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1"/>تَب سَب اِسرائیلی حِبرونؔ میں داویؔد کے پاس جمع ہوکر کہنے لگے، ”ہم تمہارا اَپنا گوشت اَور خُون ہیں۔ <verse eid="1CH 11:1"/><verse number="2" style="v" sid="1CH 11:2"/>کچھ عرصہ پہلے جَب شاؤل بادشاہ تھا اُس وقت بھی اِسرائیل کی فَوجوں کی کمان تمہارے ہاتھ میں تھی اَور یَاہوِہ تمہارے خُدا نے تُمہیں فرمایا، ’تُم میری قوم اِسرائیل کی گلّہ بانی کروگے اَور تُم اُن کے حُکمران بَن جاؤگے۔‘ “<verse eid="1CH 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3"/>پس اِسرائیل کے سَب بُزرگ حِبرونؔ میں داویؔد بادشاہ کے پاس آئے، بادشاہ نے اُن کے ساتھ یَاہوِہ کے حُضُور عہد کیا، اَور اُنہُوں نے داویؔد کو مَسح کرکے اِسرائیل کا بادشاہ بنایا جَیسا کہ یَاہوِہ نے شموایلؔ کی مَعرفت وعدہ کیا تھا۔<verse eid="1CH 11:3"/></para>
  <para style="s1">داویؔد کا یروشلیمؔ کو فتح کرنا</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4"/>داویؔد اَور تمام بنی اِسرائیل نے یروشلیمؔ (یعنی یبُوس) پر چڑھائی کی اَور یبُوسیوں نے جو وہاں کے باشِندے تھے <verse eid="1CH 11:4"/><verse number="5" style="v" sid="1CH 11:5"/>یبُوسیوں نے داویؔد سے کہا، ”تُم یہاں داخل نہ ہو سکوگے۔“ تاہم داویؔد نے صِیّونؔ کا قلعہ فتح کر لیا جسے اَب داویؔد کا شہر کہتے ہیں۔<verse eid="1CH 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 11:6"/>داویؔد نے کہاتھا، ”جو کویٔی یبُوسیوں پر حملہ کرنے میں پہل کرےگا اُسے سپہ سالار بنا دیا جائے گا۔“ یُوآبؔ بِن ضرویاہؔ جو پہلے حملہ آور ہُوا سپہ سالار بنا دیا گیا۔<verse eid="1CH 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 11:7"/>اَور داویؔد قلعہ میں رہنے لگے اِس لیٔے یہ داویؔد کا شہر کہلانے لگا۔ <verse eid="1CH 11:7"/><verse number="8" style="v" sid="1CH 11:8"/>اُس نے مِلّوؔ سے لے کر اُس کے اِردگرد کے سارے علاقہ کو مضبُوط کیا اَور یُوآبؔ نے باقی شہر کی مرمّت کی <verse eid="1CH 11:8"/><verse number="9" style="v" sid="1CH 11:9"/>اَور داویؔد زِیادہ سے زِیادہ طاقتور ہوتے گئے کیونکہ قادرمُطلق یَاہوِہ خُدا اُن کے ساتھ تھے۔<verse eid="1CH 11:9"/></para>
  <para style="s1">داویؔد کے جنگجو لشکروں کے سردار</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10"/>اَور داویؔد کے لشکروں کے جنگجو سُورما یہ تھے جنہوں نے اُن کی حُکومت کی حمایت کی اَور سارے اِسرائیل کے ساتھ مِل کر اُنہیں بادشاہ بنایا تھا جَیسا کہ یَاہوِہ کا اِسرائیل سے وعدہ تھا۔ <verse eid="1CH 11:10"/><verse number="11" style="v" sid="1CH 11:11"/>داویؔد کے جنگجو سُورماؤں کی فہرست یہ ہے:</para>
  <para style="p" vid="1CH 11:11">یسُوبعامؔ بنی حکمُونیؔ جو اعلیٰ افسران تھا۔ اُس نے اَپنا نیزہ تین سَو آدمیوں کے خِلاف اُٹھایا اَور ایک ہی حملہ میں اُنہیں قتل کر ڈالا۔<verse eid="1CH 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12"/>اُس کے بعد الیعزرؔ بِن احُوحی دودائی یعنی دودوؔ تھا جو اُن تین جنگجو سُورماؤں میں سے ایک تھا۔ <verse eid="1CH 11:12"/><verse number="13" style="v" sid="1CH 11:13"/>وہ داویؔد کے ساتھ فسدمّیمؔ میں تھا جَب فلسطینی جنگ کے لیٔے وہاں جمع ہُوئے۔ وہاں ایک کھیت جَو سے بھرا ہُوا تھا۔ جہاں اِسرائیلی فَوج فلسطینیوں کے آگے سے بھاگی۔ <verse eid="1CH 11:13"/><verse number="14" style="v" sid="1CH 11:14"/>لیکن وہ کھیت کے درمیان پہُنچ کر مُقابلہ کے لیٔے ڈٹ گیٔے اَور اُن کا بچاؤ کیا اَور فلسطینیوں کو مار گرایا۔ یَاہوِہ کی مدد سے اُنہیں بڑی فتح حاصل ہُوئی۔<verse eid="1CH 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15"/>تیس سرداروں میں سے تین سردار چٹّان سے نیچے اُتر کر عدُلّامؔ کے غار میں داویؔد کے پاس آئے۔ جَب کہ اُس وقت فلسطینیوں کا ایک دستہ وادی رفائیمؔ میں چھاؤنی لگائے ہُوئے تھا۔ <verse eid="1CH 11:15"/><verse number="16" style="v" sid="1CH 11:16"/>اُس وقت داویؔد قلعہ میں تھے اَور فلسطینیوں کی چوکی بیت لحمؔ میں تھی۔ <verse eid="1CH 11:16"/><verse number="17" style="v" sid="1CH 11:17"/>اَور داویؔد کو شِدّت سے پیاس لگی اَور اُنہُوں نے کہا، ”کاش کویٔی مُجھے بیت لحمؔ کے پھاٹک کے نزدیک والے کنوئیں سے پانی لاکر پلائے!“ <verse eid="1CH 11:17"/><verse number="18" style="v" sid="1CH 11:18"/>تَب اُن تینوں نے فلسطینیوں کی صفوں کو چیر کر بیت لحمؔ کے نزدیک والے کنوئیں سے پانی بھرا، اَور داویؔد کے پاس لے آئے۔ لیکن اُنہُوں نے پینے سے اِنکار کیا اَور اُسے یَاہوِہ کے حُضُور اُنڈیل دیا۔ <verse eid="1CH 11:18"/><verse number="19" style="v" sid="1CH 11:19"/>اَور کہا، ”خُدا نہ کرے کہ میں اَیسا کروں۔ کیا میں اُن آدمیوں کا خُون پیوں جو اَپنی جان خطرے میں ڈال کر گیٔے؟“ لہٰذا داویؔد نے اُسے پینا نہ چاہا۔</para>
  <para style="p" vid="1CH 11:19">اُن تینوں جنگجو سُورماؤں نے اَیسے کیٔی کام اَنجام دئیے تھے۔<verse eid="1CH 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20"/>اَور یُوآبؔ بِن ضرویاہؔ کا بھایٔی ابیشائی بھی اُن تین جنگجو مَردوں کا سردار تھا۔ اُس نے اَپنا نیزہ تین سَو آدمیوں کے خِلاف اُٹھایا اَور اُنہیں قتل کر دیا لہٰذا وہ بھی اُن تینوں کی طرح مشہُور ہو گیا۔ <verse eid="1CH 11:20"/><verse number="21" style="v" sid="1CH 11:21"/>اُسے اُن تینوں سے دُگنا اِعزاز مِلا اَور وہ اُن کا سپہ سالار بنا لیکن وہ اُن پہلے والے تین سرداروں کا ہم پلّہ نہ ہو سَکا۔<verse eid="1CH 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22"/>بِنایاہؔ بِن یہُویدعؔ قبضی ایل کے ایک سُورما کا بیٹا تھا جِس نے کیٔی بڑے کارنامے اَنجام دئیے تھے۔ اُس نے مُوآب کے اریئیلؔ کے دو بہترین آدمیوں کو مار گرایا۔ ایک دِن جَب برف پڑ رہی تھی اُس نے ایک گڑھے میں اُتر کر ایک شیرببر کو بھی مارا۔ <verse eid="1CH 11:22"/><verse number="23" style="v" sid="1CH 11:23"/>اَور اُس نے ایک مِصری کو جو ساڑھے سات فُٹ لمبا تھا مار گرایا حالانکہ اُس مِصری کے ہاتھ میں جُلاہے کے شہتیر کا سا ایک نیزہ تھا۔ لیکن بِنایاہؔ ایک لاٹھی لے کر اُس کے پاس گیا، اُس مِصری کے ہاتھ سے نیزہ چھین لیا اَور اُسی کے نیزہ سے اُسے قتل کر دیا۔ <verse eid="1CH 11:23"/><verse number="24" style="v" sid="1CH 11:24"/>بِنایاہؔ بِن یہُویدعؔ نے اَیسے کیٔی کام کئے۔ وہ بھی اُن تین جنگجو سُورماؤں کی طرح مشہُور تھا۔ <verse eid="1CH 11:24"/><verse number="25" style="v" sid="1CH 11:25"/>وہ تیس سُورماؤں میں سَب سے زِیادہ مُعزّز سمجھا جاتا تھا لیکن وہ پہلے تین سُورماؤں کے برابر نہیں ہونے پایا۔ اَور داویؔد نے اُسے اَپنے مُحافظ دستہ کا سردار بنا دیا۔<verse eid="1CH 11:25"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="26" style="v" sid="1CH 11:26"/>دیگر جنگجو سُورما یہ تھے:</para>
  <para style="b" vid="1CH 11:26"/>
  <para style="li1" vid="1CH 11:26">یُوآبؔ کا بھایٔی عساہیلؔ،</para>
  <para style="li1" vid="1CH 11:26">بیت لحمؔ کا اِلحنانؔ بِن دُودؔو،<verse eid="1CH 11:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 11:27"/>حروری شمّوتھؔ</para>
  <para style="li1" vid="1CH 11:27">پلونی خلصؔ،<verse eid="1CH 11:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 11:28"/>تقوعؔ کے عیراؔ بِن عقیشؔ،</para>
  <para style="li1" vid="1CH 11:28">عناتوت سے ابیعزیر،<verse eid="1CH 11:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 11:29"/>حُوشاتی سِبّکائی،</para>
  <para style="li1" vid="1CH 11:29">احُوحی عیلیؔ،<verse eid="1CH 11:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 11:30"/>نطُوفاتی مہرائی،</para>
  <para style="li1" vid="1CH 11:30">نطُوفاتی حلید بِن بعناہ،<verse eid="1CH 11:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 11:31"/>بِنیامین کے خاندان سے گِبعہؔ کے اِتھائی بِن رِبائیؔ،</para>
  <para style="li1" vid="1CH 11:31">فِرعاتونی بِنایاہؔ،<verse eid="1CH 11:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 11:32"/>گعشؔ کی وادیوں کا باشِندہ حُورائی،</para>
  <para style="li1" vid="1CH 11:32">عرباتی اَبی ایل،<verse eid="1CH 11:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 11:33"/>باحارُومی عزماوتؔ، شعلبُونی الیحبہؔ،<verse eid="1CH 11:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 11:34"/>گیزونی بنی ہشیمؔ،</para>
  <para style="li1" vid="1CH 11:34">یُوناتانؔ بِن ہراری شاگیؔ،<verse eid="1CH 11:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 11:35"/>احی آم بِن ہراری سکارؔ،</para>
  <para style="li1" vid="1CH 11:35">اِلیفالؔ بِن اُورؔ،<verse eid="1CH 11:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 11:36"/>مکیراتی حِفرؔ، پلونی اخیاہؔ،<verse eid="1CH 11:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 11:37"/>کرمِلی حضرُوؔ،</para>
  <para style="li1" vid="1CH 11:37">نعرائیؔ بِن ازبائیؔ،<verse eid="1CH 11:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 11:38"/>ناتنؔ کا بھایٔی یُوایلؔ،</para>
  <para style="li1" vid="1CH 11:38">مبہارؔ بِن ہاگریؔ،<verse eid="1CH 11:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 11:39"/>صِلقؔ عمُّونی،</para>
  <para style="li1" vid="1CH 11:39">بیروتی نحریؔ جو یُوآبؔ بِن ضرویاہؔ کا سلاح بردار تھا۔<verse eid="1CH 11:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 11:40"/>یتری عیراؔ</para>
  <para style="li1" vid="1CH 11:40">یتری گاریبؔ،<verse eid="1CH 11:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 11:41"/>حِتّی اورِیّاہؔ،</para>
  <para style="li1" vid="1CH 11:41">زابادؔ بِن احلائی،<verse eid="1CH 11:41"/></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 11:42"/>بنی رُوبِنؔ کے خاندان کا عدینا بِن شیزاؔ جو رُوبِنیوں کا سردار تھا اَور جِس کے ساتھ تیس جَوان تھے۔<verse eid="1CH 11:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 11:43"/>حانانؔ بِن معکہؔ،</para>
  <para style="li1" vid="1CH 11:43">مِتھنی یہوشافاطؔ،<verse eid="1CH 11:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 11:44"/>عَستِراتی عُزّیاہؔ،</para>
  <para style="li1" vid="1CH 11:44">عروعری کے باشِندے حوتھامؔ کے بیٹے شاماعؔ اَور یعی ایل۔<verse eid="1CH 11:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 11:45"/>یدیع ایل بِن شِمریؔ</para>
  <para style="li1" vid="1CH 11:45">اَور اُس کا بھایٔی یوحا تیتصیؔ،<verse eid="1CH 11:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 11:46"/>محاوی الی ایل</para>
  <para style="li1" vid="1CH 11:46">اَور النعمؔ کے بیٹے یرِیبائیؔ</para>
  <para style="li1" vid="1CH 11:46">اَور یُوسویاہؔ اَور مُوآبی یِتھماہؔ۔<verse eid="1CH 11:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 11:47"/>الی ایل، عوبیدؔ اَور مضوبائی یعسی ایل۔<verse eid="1CH 11:47"/></para>
  <chapter eid="1CH 11"/>
  <chapter number="12" style="c" sid="1CH 12"/>
  <para style="s1">جنگجو مَردوں کا داویؔد سے اِتّحاد</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 12:1"/>یہ وہ مَرد تھے جو داویؔد کے پاس صِقلاگ میں اُس وقت آئےتھے جَب وہ شاؤل بِن قیشؔ کی حُضُوری سے روپوش ہو چُکاتھا (اَور وہ اُن بہادروں میں سے تھے جو جنگ میں اُس کے مددگار تھے۔ <verse eid="1CH 12:1"/><verse number="2" style="v" sid="1CH 12:2"/>وہ کمانوں سے مُسلّح تھے اَور اُلٹے یا سیدھے، دونوں ہاتھ سے تیر چلانے اَور فلاخن سے پتّھر مارنے میں ماہر تھے۔ اَور وہ بِنیامین کے قبیلہ سے تھے اَور شاؤل کے رشتہ دار تھے):<verse eid="1CH 12:2"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 12:3"/>احیعزر اُن کا سردار تھا اَور یُوآشؔ یہ دونوں گبعاتھی شِماعاؔ کے بیٹے تھے؛</para>
  <para style="li1" vid="1CH 12:3">یزی ایل اَور پِلیتؔ جو عزماوتؔ کے بیٹے تھے؛</para>
  <para style="li1" vid="1CH 12:3">براکاہؔ اَور عناتوتی یِہُو، <verse eid="1CH 12:3"/><verse number="4" style="v" sid="1CH 12:4"/>اَور گِبعونی اِشماعیاہؔ جو اُن تیسوں میں ایک جنگجو مَرد تھا اَورجو اُن تیسوں کا سردار تھا؛</para>
  <para style="li1" vid="1CH 12:4">یرمیاہؔ، یحزی ایل، یوحانانؔ، گِدیرہاتی یُوزبادؔ، <verse eid="1CH 12:4"/><verse number="5" style="v" sid="1CH 12:5"/>اِلعوزائی، یریموتؔ، بعلیاہؔ، شِماریاہؔ اَور حاروفی شفطیاہؔ،<verse eid="1CH 12:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 12:6"/>اِلقانہؔ، یشیاہؔ، عزرایلؔ، یُوعزرؔ اَور یسُوبعامؔ</para>
  <para style="li1" vid="1CH 12:6">جو قورحؔ کی نَسل تھے۔<verse eid="1CH 12:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 12:7"/>اَور یوعیلاہؔ اَور زبدیاہؔ جو یروحامؔ گدُورؔ کے بیٹے تھے۔<verse eid="1CH 12:7"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8"/>اَور بنی گادؔ میں سے بعض الگ ہوکر بیابان کے قلعہ میں داویؔد سے آ ملے۔ وہ زبردست جنگجو تھے اَور میدانِ جنگ میں اُترنے کے لیٔے تیّار تھے۔ وہ ڈھالوں اَور نیزوں سے مُسلّح تھے اَور اُن کے چہرے شیروں کے چہروں کی مانند تھے اَور وہ پہاڑی غزالوں کی طرح تیز رفتار تھے۔<verse eid="1CH 12:8"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 12:9"/>عزرؔ افسر اعلیٰ تھا،</para>
  <para style="li1" vid="1CH 12:9">عبدیاہؔ کا درجہ دُوسرا تھا اَور اِلیابؔ کا تیسرا،<verse eid="1CH 12:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 12:10"/>مشمنّہؔ چوتھا،</para>
  <para style="li1" vid="1CH 12:10">یرمیاہؔ پانچواں۔<verse eid="1CH 12:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 12:11"/>عتّئیؔ چھٹا۔ الی ایل ساتواں،<verse eid="1CH 12:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 12:12"/>یوحانانؔ آٹھواں، اِلزبادؔ نواں،<verse eid="1CH 12:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 12:13"/>یرمیاہؔ دسواں، مکبنّائی گیارھواں۔<verse eid="1CH 12:13"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14"/>یہ بنی گادؔ فَوج کے سپہ سالار تھے۔ اُن میں سَب سے چھوٹا سَو مَردوں کا مُقابلہ کر سَکتا تھا اَور سَب سے بڑا ہزار کا۔ <verse eid="1CH 12:14"/><verse number="15" style="v" sid="1CH 12:15"/>یہ وہ ہیں جو پہلے مہینے میں اُس وقت یردنؔ کے پار گیٔے جَب وہ طغیانی پر تھا اَور اُنہُوں نے وادیوں کے سَب لوگوں کو مشرق اَور مغرب کی طرف بھگا دیا۔<verse eid="1CH 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16"/>دیگر بنی بِنیامین اَور بنی یہُوداہؔ کے کچھ لوگ بھی قلعہ میں داویؔد کے پاس آئے۔ <verse eid="1CH 12:16"/><verse number="17" style="v" sid="1CH 12:17"/>داویؔد اُن کے اِستِقبال کو نکلے اَور اُن سے کہنے لگے، ”اگر تُم سلامتی کے ساتھ میری مدد کے لیٔے میرے پاس آئے ہو تو مَیں تُمہیں اَپنے ساتھ مِلانے کے لیٔے تیّار ہُوں لیکن اگر تُم غدّاری کرکے مُجھے میرے دُشمنوں کے حوالہ کرنے آئے ہو جَب کہ میرے ہاتھ ظُلم سے پاک ہیں تو ہمارے آباؤاَجداد کا خُدا اُسے دیکھیں اَور تُمہیں ملامت کریں۔“<verse eid="1CH 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18"/>تَب عماسیؔ پرجو اُن تیسوں کا سردار تھا پاک رُوح نازل ہُوا اَور فرمایا:</para>
  <para style="q1" vid="1CH 12:18">”اَے داویؔد! ہم تمہارے ہیں۔</para>
  <para style="q2" vid="1CH 12:18">اَے یِشائی کے بیٹے! ہم تمہارے ساتھ ہیں۔</para>
  <para style="q1" vid="1CH 12:18">آپ فتح مند ہُوں اَور فتح مند ہُوں،</para>
  <para style="q2" vid="1CH 12:18">اَورجو کوئی آپ کا مددگار ہو اُس کی بھی فتح ہو،</para>
  <para style="q3" vid="1CH 12:18">کیونکہ آپ کے خُدا آپ کی مدد کرتے ہیں۔“</para>
  <para style="p" vid="1CH 12:18">یہ سُن کر داویؔد نے اُنہیں قبُول کیا اَور اُنہیں اَپنے چھاپہ مار دستوں کے سردار بنا دیا۔<verse eid="1CH 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19"/>جَب داویؔد شاؤل کے خِلاف فلسطینیوں کے ساتھ جنگ کرنے کے لیٔے تیّار ہو ہی رہے تھے تبھی بنی منشّہ کے چند لوگ داویؔد کے ساتھ ہو گئے۔ (پھر بھی داویؔد فلسطینیوں کے ساتھ جنگ میں نہیں گئے کیونکہ فلسطینیوں کے حاکموں نے آپَس میں صلاح مشورہ کرکے اُن کو اِس شک کے ساتھ لَوٹا دیا، ”وہ تو اَپنے آقا شاؤل سے جا ملیں گے اَور ہم مارے جایٔیں گے۔“) <verse eid="1CH 12:19"/><verse number="20" style="v" sid="1CH 12:20"/>جَب داویؔد صِقلاگ کو گئے تو منشّہ میں سے جو لوگ اُن سے جا ملے وہ یہ تھے: عدناہؔ، یُوزبادؔ، یدیع ایل، مِیکاایلؔ، یُوزبادؔ، اِلیہُوؔ اَور ضِلّیتائیؔ جو بنی منشّہ میں ایک ایک ہزار جَوانوں کے سردار تھے۔ <verse eid="1CH 12:20"/><verse number="21" style="v" sid="1CH 12:21"/>اُنہُوں نے چھاپہ مار دستوں کے خِلاف داویؔد کی مدد کی کیونکہ وہ سَب زبردست جنگجو اَور لشکر کے سردار تھے۔ <verse eid="1CH 12:21"/><verse number="22" style="v" sid="1CH 12:22"/>اَور داویؔد کے مددگاروں کی تعداد روز بروز بڑھتی چلی گئی یہاں تک کہ ایک بڑی فَوج جمع ہو گئی جو خُدا کے لشکر کی مانند تھا۔<verse eid="1CH 12:22"/></para>
  <para style="s1">حِبرونؔ میں دیگر لوگوں کا داویؔد کے ساتھ شامل ہونا</para>
  <para style="lh">
    <verse number="23" style="v" sid="1CH 12:23"/>اَورجو لوگ جنگ کے لیٔے مُسلّح ہوکر حِبرونؔ میں داویؔد کے پاس آئے تاکہ یَاہوِہ کے فرمان کے مُطابق شاؤل کی مملکت اُس کے سُپرد کریں اُن کا شُمار یہ ہے:<verse eid="1CH 12:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 12:24"/>بنی یہُوداہؔ جو ڈھالیں اَور نیزے لیٔے ہُوئے جنگ کے لیٔے مُسلّح تھے، چھ ہزار آٹھ سَو؛<verse eid="1CH 12:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 12:25"/>بنی شمعُونؔ میں سے جنگ کے لیٔے تیّار جنگجو سات ہزار ایک سَو؛<verse eid="1CH 12:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 12:26"/>بنی لیوی میں سے چار ہزار چھ سَو، <verse eid="1CH 12:26"/><verse number="27" style="v" sid="1CH 12:27"/>جِن میں یہُویدعؔ بھی شامل تھا جو اَہرونؔ کے خاندان کا سردار تھا اَور جِس کے ساتھ تین ہزار سات سَو جَوان مَرد تھے <verse eid="1CH 12:27"/><verse number="28" style="v" sid="1CH 12:28"/>اَور صدُوقؔ ایک جَوان بہادر جنگجو اَور اُس کے آبائی خاندان کے بائیس سردار؛<verse eid="1CH 12:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 12:29"/>اَور بِنیامینیوں میں سے شاؤل کے تین ہزار رشتہ دار جِن میں بیشتر اُس وقت تک شاؤل کے گھرانے کے وفادار تھے؛<verse eid="1CH 12:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 12:30"/>اَور بنی اِفرائیمؔ میں سے بیس ہزار آٹھ سَو زبردست سُورما جو اَپنے آبائی برادریوں میں مشہُور و معروف آدمی تھے؛<verse eid="1CH 12:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 12:31"/>اَور منشّہ کے آدھے قبیلہ کے لوگ جو نام بنام بُلائے گیٔے کہ آکر داویؔد کو بادشاہ بنائیں اٹھّارہ ہزار تھے؛<verse eid="1CH 12:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 12:32"/>اَور بنی یِسَّکاؔر میں سے دو سَو سردار جو بڑے وقت شناس تھے کہ اِسرائیل کو کب کیا کرنا مُناسب ہے۔ وہ اَپنے تمام رشتہ داروں کے ساتھ تھے جو اُن کے فرمانبردار تھے؛<verse eid="1CH 12:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 12:33"/>اَور زبُولُون کے جَوان مَرد جو تجربہ کار فَوجی تھے اَور جنگ کے وقت بڑی ثابت قدمی سے داویؔد کی مدد کرنے کے لیٔے ہر قِسم کے ہتھیاروں سے لیس تھے جو شُمار میں پچاس ہزار تھے؛<verse eid="1CH 12:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 12:34"/>اَور نفتالی میں سے ایک ہزار افسران جِن کے ساتھ سینتیس ہزار سِپر اَور نیزہ بردار جَوان تھے؛<verse eid="1CH 12:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 12:35"/>اَور دانیوں میں سے اٹّھائیس ہزار چھ سَو جنگی فَوجی؛<verse eid="1CH 12:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 12:36"/>اَور بنی آشیر میں سے میدانِ جنگ کے لیٔے تیّار اَور تجربہ کار چالیس ہزار فَوجی؛<verse eid="1CH 12:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 12:37"/>اَور دریائے یردنؔ کے مشرق سے بنی رُوبِنؔ، بنی گادؔ اَور منشّہ کے آدھے قبیلہ کے جَوان مَرد جو ہر قِسم کے جنگی آلات سے لیس تھے ایک لاکھ بیس ہزار۔<verse eid="1CH 12:37"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="38" style="v" sid="1CH 12:38"/>یہ تمام جنگجو مَرد تھے جنہوں نے بطور فَوجی اَپنی خدمات پیش کیں۔</para>
  <para style="b" vid="1CH 12:38"/>
  <para style="p" vid="1CH 12:38">وہ داویؔد کو اِسرائیل کا بادشاہ بنانے کے لیٔے مصمّم اِرادے کے ساتھ حِبرونؔ میں آئے اَور باقی سَب اِسرائیلی بھی داویؔد کو بادشاہ بنانے پر مُتّفِق تھے۔ <verse eid="1CH 12:38"/><verse number="39" style="v" sid="1CH 12:39"/>اَور اُنہُوں نے وہاں تین دِن داویؔد کے ساتھ کھاتے پیتے گزارے کیونکہ اُن کے رشتہ داروں نے اُنہیں سَب کچھ مُہیّا کر دیا تھا۔ <verse eid="1CH 12:39"/><verse number="40" style="v" sid="1CH 12:40"/>اَور اُن کے وہ قریبی لوگ جو یِسَّکاؔر، زبُولُون اَور نفتالی کے علاقوں سے تھے وہ بھی گدھوں، اُونٹوں، خچّروں اَور بَیلوں پر اشیائے خُوردنی لاد کر لایٔے جو روٹیوں، مَیدہ سے بنے پکوان، اَنجیر کی ٹکیوں، کشمش کی ٹکیوں، مَے اَور تیل پر مُشتمل تھیں اَور مویشیوں اَور بھیڑوں کی کثیر تعداد اُن کے ساتھ تھی۔ اِس لیٔے کہ اِسرائیل میں جَشن منایا جا رہاتھا۔<verse eid="1CH 12:40"/></para>
  <chapter eid="1CH 12"/>
  <chapter number="13" style="c" sid="1CH 13"/>
  <para style="s1">عہد کے صندُوق کا واپس لایا جانا</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1"/>داویؔد نے اَپنے تمام سرداروں سے جو ہزاروں اَور سینکڑوں فَوجی دستوں کی قیادت کر رہے تھے صلاح مشورہ کیا۔ <verse eid="1CH 13:1"/><verse number="2" style="v" sid="1CH 13:2"/>اَور تَب داویؔد نے بنی اِسرائیل کی ساری جماعت سے کہا، ”اگر تُمہیں یہ اَچھّا لگے اَور اگر یہ یَاہوِہ ہمارے خُدا کی مرضی ہو تو آؤ ہم دُور دُور تک ہر طرف اِسرائیل کے تمام قصبوں میں اَپنے باقی بھائیوں اَور نواحی دار علاقوں میں اُن کے ساتھ رہنے والے کاہِنوں اَور لیویوں کو بھی کہلا بھیجیں کہ وہ آئیں اَور ہمارے ساتھ شامل ہو جایٔیں۔ <verse eid="1CH 13:2"/><verse number="3" style="v" sid="1CH 13:3"/>اَور ہم اَپنے خُدا کے عہد کے صندُوق کو پھر سے اَپنے پاس لے آئیں کیونکہ شاؤل کے دَورِ حُکومت میں ہم نے اُس کی پروا نہ کی۔“ <verse eid="1CH 13:3"/><verse number="4" style="v" sid="1CH 13:4"/>تمام جماعت اَیسا کرنے پر رضامند ہو گئی کیونکہ سَب لوگوں کو یہ تجویز اَچھّی مَعلُوم ہُوئی۔<verse eid="1CH 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5"/>تَب داویؔد نے مِصر کے دریا شیحُورؔ سے لے کر لیبو حماتؔ تک تمام اِسرائیلیوں کو جمع کیا تاکہ خُدا کے عہد کے صندُوق کو قِریت یعریمؔ سے لے آئیں۔ <verse eid="1CH 13:5"/><verse number="6" style="v" sid="1CH 13:6"/>اَور داویؔد اَور اُس کے ساتھ تمام اِسرائیلی بعلہؔ یعنی قِریت یعریمؔ کو جو یہُوداہؔ میں ہے گیٔے تاکہ یَاہوِہ خُدا کے عہد کے صندُوق کو وہاں سے لے آئیں جو وہاں کروبیوں کے درمیان تخت نشین یَاہوِہ کے نام سے مشہُور ہے۔<verse eid="1CH 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 13:7"/>اَور وہ خُدا کے صندُوق کو ابینادابؔ کے گھر سے ایک نئی بَیل گاڑی پر رکھ کر باہر نکلے جسے عُزّاہ اَور اخیوؔ ہانک رہے تھے۔ <verse eid="1CH 13:7"/><verse number="8" style="v" sid="1CH 13:8"/>اَور داویؔد اَور تمام بنی اِسرائیل خُدا کے حُضُور خُوب زور زور سے نغمہ گاتے اَور بربط، سِتار، دف، جھانجھ بجاتے اَور نرسنگے پھُونکتے ہُوئے چلے آتے تھے۔<verse eid="1CH 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9"/>جَب وہ کیدونؔ کے کھلیان پر پہُنچے تو عُزّاہ نے صندُوق کو سنبھالنے کے لیٔے اَپنا ہاتھ بڑھایا کیونکہ بَیلوں نے ٹھوکر کھائی تھی۔ <verse eid="1CH 13:9"/><verse number="10" style="v" sid="1CH 13:10"/>تَب یَاہوِہ کا قہر عُزّاہ پر بھڑکا اَور یَاہوِہ نے اُسے مار ڈالا۔ کیونکہ اُس نے صندُوق کو ہاتھ لگا کر غلطی کی تھی اِس لیٔے وہ وہیں خُدا کے حُضُور مَر گیا۔<verse eid="1CH 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11"/>داویؔد اِس بات سے بڑا غمگین ہُوا کیونکہ یَاہوِہ کا قہر عُزّاہ کے خِلاف بھڑکا تھا لہٰذا وہ جگہ آج تک پیریزؔ عُزّاہ<note caller="+" style="f"><char style="fr" closed="false">13‏:11 </char><char style="fq" closed="false">پیریزؔ عُزّاہ </char><char style="ft" closed="false">عُزّاؔ کا قہر بھڑکا</char></note> کہلاتی ہے۔<verse eid="1CH 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 13:12"/>اُس دِن داویؔد خُدا سے ڈر گئے اَور کہنے لگے کہ، ”میں خُدا کے عہد کے صندُوق کو اَپنے یہاں کیسے لاؤں؟“ <verse eid="1CH 13:12"/><verse number="13" style="v" sid="1CH 13:13"/>چنانچہ داویؔد خُدا کے عہد کے صندُوق کو اَپنے یہاں شہر داویؔد میں نہ لائے بَلکہ اُسے باہر ہی باہر گِتّی عوبیدؔ اِدُوم کے گھر لے گئے۔ <verse eid="1CH 13:13"/><verse number="14" style="v" sid="1CH 13:14"/>پس خُدا کے عہد کا صندُوق عوبیدؔ اِدُوم کے گھرانے کے ساتھ اُس گھر میں تین مہینے تک رکھا رہا اَور یَاہوِہ نے عوبیدؔ اِدُوم کے گھرانے اَور اُس کی ساری چیزوں کو برکت دی۔<verse eid="1CH 13:14"/></para>
  <chapter eid="1CH 13"/>
  <chapter number="14" style="c" sid="1CH 14"/>
  <para style="s1">داویؔد کا خاندان</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1"/>اَور شاہِ صُورؔ حِیرامؔ نے اَپنے قاصِدوں کے ہمراہ دیودار کی لکڑی، مِعمار اَور بڑھئی داویؔد کے پاس بھیجے تاکہ وہ اُن کے لیٔے محل بنائیں۔ <verse eid="1CH 14:1"/><verse number="2" style="v" sid="1CH 14:2"/>اَور داویؔد کو مَعلُوم ہو گیا کہ یَاہوِہ نے اُسے اِسرائیل کے بادشاہ کے طور پر قِیام بخشا ہے اَور اَپنی قوم اِسرائیل کی خاطِر اُس کی بادشاہی کو بڑا ممتاز کیا ہے۔<verse eid="1CH 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3"/>یروشلیمؔ میں داویؔد نے اَور بیویاں بیاہ لیں اَور اِس طرح وہ کیٔی بیٹوں اَور بیٹیوں کا باپ بَن گئے۔ <verse eid="1CH 14:3"/><verse number="4" style="v" sid="1CH 14:4"/>وہاں یروشلیمؔ میں اُن کے جو بچّے پیدا ہُوئے اُن کے نام یہ ہیں: شَمّوعؔ، شوبابؔ، ناتنؔ اَور شُلومونؔ، <verse eid="1CH 14:4"/><verse number="5" style="v" sid="1CH 14:5"/>اِبحارؔ، الِیشُوعؔ، الیپلطؔ، <verse eid="1CH 14:5"/><verse number="6" style="v" sid="1CH 14:6"/>نوگاہؔ، نِفیگ، یافیعؔ، <verse eid="1CH 14:6"/><verse number="7" style="v" sid="1CH 14:7"/>اِلیشمعؔ، بیعلیادعؔ<note caller="+" style="f"><char style="fr" closed="false">14‏:7 </char><char style="fq" closed="false">بیعلیادعؔ </char><char style="ft" closed="false">اِسے الیدعؔ بھی کہتے ہیں</char></note> اَور الیفلطؔ۔<verse eid="1CH 14:7"/></para>
  <para style="s1">داویؔد کا فلسطینیوں کو شِکست دینا</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8"/>جَب فلسطینیوں نے سُنا کہ داویؔد کو مَسح کرکے اِسرائیل کا بادشاہ بنایا گیا ہے تو وہ سَب لشکر کے ساتھ اِکٹھّے ہوکر اُنہیں تلاش کرنے نکل پڑے لیکن جَب داویؔد نے یہ سُنا تو وہ اُن کے مُقابلہ کو نکلے <verse eid="1CH 14:8"/><verse number="9" style="v" sid="1CH 14:9"/>اَور فلسطینی آئے اَور رفائیمؔ کی وادی میں پھیل گیٔے۔ <verse eid="1CH 14:9"/><verse number="10" style="v" sid="1CH 14:10"/>تَب داویؔد نے خُدا سے پُوچھا، ”کیا میں جا کر فلسطینیوں پر حملہ کر دُوں؟ کیا آپ اُنہیں میرے حوالے کر دیں گے؟“</para>
  <para style="p" vid="1CH 14:10">یَاہوِہ نے داویؔد کو جَواب دیا، ”جاؤ مَیں اُنہیں تمہارے حوالے کر دُوں گا۔“<verse eid="1CH 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11"/>اِس لئے داویؔد اَور اُس کے جَوان بَعل پراضیمؔ کو گئے اَور وہاں اُس نے اُنہیں شِکست دی اَور کہا، ”جَیسے اَچانک سیلاب کا پانی پھوٹ کر بہہ نکلتا ہے، وَیسے ہی خُدا نے میرے ہاتھ سے میرے دُشمنوں کو پھاڑ ڈالا ہے۔“ اِس لیٔے وہ جگہ بَعل پراضیمؔ<note caller="+" style="f"><char style="fr" closed="false">14‏:11 </char><char style="fq" closed="false">بَعل پراضیمؔ </char><char style="ft" closed="false">پھوٹ نکلنا</char></note> کہلائی۔ <verse eid="1CH 14:11"/><verse number="12" style="v" sid="1CH 14:12"/>فلسطینی اَپنے معبُود وہاں چھوڑ گیٔے تھے جنہیں داویؔد کے حُکم سے آگ کے سُپرد کیا گیا۔<verse eid="1CH 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13"/>فلسطینی ایک دفعہ پھر آئے اَور اُس وادی میں داخل ہو گئے۔ <verse eid="1CH 14:13"/><verse number="14" style="v" sid="1CH 14:14"/>داویؔد نے خُدا سے پھر پُوچھا اَور خُدا نے اُسے جَواب دیا، ”تُم اُن کا پیچھا کرنے کے بجائے کَترا کر آگے نکل جانا اَور بید کے درختوں کے سامنے سے اُن پر حملہ کرنا۔ <verse eid="1CH 14:14"/><verse number="15" style="v" sid="1CH 14:15"/>اَور جُوں ہی تُم بید کے درختوں کی پھُنگیوں میں قدموں کی آواز سُنو تو جلدی سے حرکت میں آجانا تاکہ وہ سمجھ لیں کہ یَاہوِہ فلسطینیوں کی فَوج کو مارنے کے لیٔے تمہارے آگے گئے ہیں۔“ <verse eid="1CH 14:15"/><verse number="16" style="v" sid="1CH 14:16"/>اَور داویؔد نے جَیسا خُدا نے اُسے فرمایا تھا کیا اَور وہ اَور اُس کے جَوان فلسطینیوں کی فَوج کو گِبعونؔ سے گِزرؔ تک قتل کرتے چلے گیٔے۔<verse eid="1CH 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17"/>داویؔد کی شہرت سَب مُلکوں میں پھیل گئی اَور یَاہوِہ نے سَب قوموں پر اُس کا خوف بِٹھا دیا۔<verse eid="1CH 14:17"/></para>
  <chapter eid="1CH 14"/>
  <chapter number="15" style="c" sid="1CH 15"/>
  <para style="s1">خُدا کے عہد کے صندُوق کا یروشلیمؔ لایا جانا</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1"/>جَب داویؔد، شہر داویؔد میں اَپنے لیٔے عمارتیں بنا چُکے تو اُس کے بعد اُنہُوں نے معبُود کے صندُوق کے لیٔے ایک جگہ تیّار کی اَور وہاں خیمہ کھڑا کیا۔ <verse eid="1CH 15:1"/><verse number="2" style="v" sid="1CH 15:2"/>تَب داویؔد نے کہا، ”لیویوں کے سِوا اَور کویٔی خُدا کے صندُوق کو ہاتھ نہ لگائے کیونکہ خُدا نے اُن کو ہی چُناہے کہ وہ خُدا کے صندُوق کو اُٹھایا کریں اَور ہمیشہ یَاہوِہ کے حُضُور خدمت اَنجام دیتے رہیں۔“<verse eid="1CH 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 15:3"/>اَور داویؔد نے سارے اِسرائیل کو یروشلیمؔ میں جمع کیا تاکہ یَاہوِہ کے صندُوق کو اُس جگہ لے آئیں جو اُنہُوں نے اُس کے لیٔے تیّار کی تھی۔<verse eid="1CH 15:3"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="4" style="v" sid="1CH 15:4"/>اَور داویؔد نے بنی اَہرونؔ اَور بنی لیوی کو جمع کیا۔<verse eid="1CH 15:4"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 15:5"/>جِن میں بنی قُہات میں سے</para>
  <para style="li2" vid="1CH 15:5">اوری ایل سردار اَور اُس کے ایک سَو بیس رشتہ دار؛<verse eid="1CH 15:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 15:6"/>بنی مِراریؔ میں سے</para>
  <para style="li2" vid="1CH 15:6">عسایاہؔ سردار اَور اُس کے دو سَو بیس رشتہ دار؛<verse eid="1CH 15:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 15:7"/>بنی گیرشوم میں سے</para>
  <para style="li2" vid="1CH 15:7">یُوایلؔ سردار اَور اُس کے ایک سَو تیس رشتہ دار؛<verse eid="1CH 15:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 15:8"/>اِلیضفنؔ میں سے</para>
  <para style="li2" vid="1CH 15:8">شمعیاہؔ سردار اَور اُس کے دو سَو رشتہ دار؛<verse eid="1CH 15:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 15:9"/>بنی حِبرونؔ میں سے</para>
  <para style="li2" vid="1CH 15:9">الی ایل سردار اَور اُس کے اسّی رشتہ دار؛<verse eid="1CH 15:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 15:10"/>بنی عُزّی ايل میں سے</para>
  <para style="li2" vid="1CH 15:10">عَمّیندابؔ سردار اَور اُس کے ایک سَو بَارہ رشتہ دار تھے۔<verse eid="1CH 15:10"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11"/>اَور داویؔد نے صدُوقؔ اَور ابیاترؔ کاہِنوں کو اَور اوری ایل، عسایاہؔ، یُوایلؔ، شمعیاہؔ، الی ایل اَور عَمّیندابؔ لیویوں کو بُلایا <verse eid="1CH 15:11"/><verse number="12" style="v" sid="1CH 15:12"/>اَور اُن سے فرمایا، ”تُم لیویوں کے آبائی خاندانوں کے سردار ہو؛ تُمہیں اَور تمہارے ہم خدمت لیوی ساتھیوں کو اَپنے آپ کو پاک کرناہے اَور یَاہوِہ اِسرائیل کے خُدا کے صندُوق کو اُس جگہ لانا ہے جو مَیں نے اُن کے لیٔے تیّار کی ہے۔ <verse eid="1CH 15:12"/><verse number="13" style="v" sid="1CH 15:13"/>کیونکہ جَب تُم لیویوں نے پہلی بار اُسے نہ اُٹھایا تو یَاہوِہ ہمارے خُدا کا قہر ہمارے خِلاف یَکایک بھڑک اُٹھا کیونکہ ہم نے اُن سے یہ نہ پُوچھا تھا کہ مُقرّرہ طریقہ کے مُطابق ہمیں یہ کام کس طرح اَنجام دینا چاہئے۔“ <verse eid="1CH 15:13"/><verse number="14" style="v" sid="1CH 15:14"/>تَب کاہِنوں اَور لیویوں نے اَپنے آپ کو پاک کیا تاکہ وہ یَاہوِہ اِسرائیل کے خُدا کے صندُوق کو لا سکیں۔ <verse eid="1CH 15:14"/><verse number="15" style="v" sid="1CH 15:15"/>اَور بنی لیوی نے خُدا کے صندُوق کو بَلّیوں سے اَپنے کندھوں پر اُٹھالیا جَیسا کہ مَوشہ نے یَاہوِہ کے کلام کے مُطابق حُکم دیا تھا۔<verse eid="1CH 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16"/>اَور داویؔد نے لیویوں کے سرداروں کو فرمایا کہ اَپنے بھائیوں میں سے گانے والوں کو مُقرّر کریں تاکہ موسیقی کے ساز یعنی سِتار، بربط اَور جھانجھ بجاتے ہُوئے زور زور سے خُوشی کے نغمہ گائیں۔<verse eid="1CH 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 15:17"/>پس لیویوں نے ہیمانؔ بِن یُوایلؔ کو اَور اُس کے بھائیوں میں سے آسفؔ بِن بیرکیاہ کو اَور اُن کے مِراریؔ بھائیوں میں سے ایتھانؔ بِن قُوشیّاہؔ کو مُقرّر کیا۔ <verse eid="1CH 15:17"/><verse number="18" style="v" sid="1CH 15:18"/>اَور اُن کے ساتھ اُن کے دُوسرے رشتہ داروں میں سے یہ لوگ تھے: زکریاؔہ، بین، یعزی ایل، شمیراموتؔ، یحی ایل، عُنّیؔ، اِلیابؔ، بِنایاہؔ، معسیاہؔ، متّتیاہؔ، الفِلہُوؔ، مِقنیاہؔ، عوبیدؔ اِدُوم اَور یعی ایل جو دربان تھے۔<verse eid="1CH 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19"/>موسیقار ہیمانؔ، آسفؔ اَور ایتھانؔ کو کانسے کی جھانجھوں کو زور زور سے بجانے کے لیٔے مُقرّر کیا گیا؛ <verse eid="1CH 15:19"/><verse number="20" style="v" sid="1CH 15:20"/>اَور زکریاؔہ، یعزی ایل یا عزی ایل، شمیراموتؔ، یحی ایل، عُنّیؔ، اِلیابؔ، معسیاہؔ، اَور بِنایاہؔ کے ذمّہ سِتار کو علاموت سُر کے مُطابق بجانا تھا۔ <verse eid="1CH 15:20"/><verse number="21" style="v" sid="1CH 15:21"/>اَور متّتیاہؔ، الفِلہُوؔ، مِقنیاہؔ، عوبیدؔ اِدُوم، یعی ایل اَور عززیاہؔ کے ذمّہ سِتار کو شمینِت سُر کے مُطابق بجانا تھا۔ <verse eid="1CH 15:21"/><verse number="22" style="v" sid="1CH 15:22"/>اَور قنانیاہؔ جو لیویوں کا سردار تھا گانے والوں کا ہادی تھا۔ یہ اُس کی ذمّہ داری تھی کیونکہ وہ موسیقی میں ماہر تھا۔<verse eid="1CH 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 15:23"/>اَور بیرکیاہؔ اَور اِلقانہؔ عہد کے صندُوق کے دربان تھے۔ <verse eid="1CH 15:23"/><verse number="24" style="v" sid="1CH 15:24"/>اَور شِبنیاہ، یہوشافاطؔ، نتنی ایل، عماسیؔ، زکریاؔہ، بِنایاہؔ اَور الیعزرؔ کاہِنوں کی ذمّہ داری یہ تھی کہ وہ خُدا کے عہد کے صندُوق کے آگے آگے نرسنگے پھُونکتے جایٔیں۔ اَور عوبیدؔ اِدُوم اَور یحیاہؔ بھی عہد کے صندُوق کے دربان تھے۔<verse eid="1CH 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25"/>تَب داویؔد اَور اِسرائیل کے بُزرگ اَور ہزار ہزار کے فَوجی دستوں کے سپہ سالار روانہ ہُوئے کہ یَاہوِہ کے عہد کے صندُوق کو عوبیدؔ اِدُوم کے گھر سے ناچتے گاتے ہُوئے لائیں۔ <verse eid="1CH 15:25"/><verse number="26" style="v" sid="1CH 15:26"/>چونکہ خُدا نے اُن لیویوں کی جو یَاہوِہ کے عہد کے صندُوق کو اُٹھائے ہُوئے تھے مدد کی تو اُنہُوں نے سات بَیل اَور سات مینڈھے قُربان کئے۔ <verse eid="1CH 15:26"/><verse number="27" style="v" sid="1CH 15:27"/>داویؔد، اَور سَب لیوی جو صندُوق کو اُٹھائے ہُوئے تھے اَور موسیقار اَور قنانیاہؔ جو گلوکاروں کا نِگراں تھا، کتانی لباس پہنے ہُوئے تھے اَور داویؔد بھی کتان کا افُود پہنے ہُوئے تھے۔ <verse eid="1CH 15:27"/><verse number="28" style="v" sid="1CH 15:28"/>یُوں سَب اِسرائیلی نعرے لگاتے، صوفار یعنی مینڈھوں کے سینگوں، تُرہیوں اَور جھانجھوں کی آواز کے ساتھ سِتار اَور بربط بجاتے ہُوئے یَاہوِہ کے عہد کے صندُوق کو لایٔے۔<verse eid="1CH 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29"/>اَور جَب یَاہوِہ کا عہد کا صندُوق داویؔد کے شہر میں داخل ہو رہاتھا تو شاؤل کی بیٹی میکلؔ نے ایک کھڑکی سے جھانکا اَور جَب اُس نے داویؔد کو رقص کرتے اَور خُوشی مناتے دیکھا تو اُس کے دِل میں داویؔد بادشاہ کے لیٔے حقارت پیدا ہو گئی۔<verse eid="1CH 15:29"/></para>
  <chapter eid="1CH 15"/>
  <chapter number="16" style="c" sid="1CH 16"/>
  <para style="s1">صندُوق سے پہلے خدمت کرنا</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1"/>تَب وہ خُدا کا صندُوق لے آئے اَور اُسے اُس خیمہ میں جو داویؔد نے اُس کے لیٔے کھڑا کیا تھا رکھ دیا اَور سوختنی نذریں اَور سلامتی کی نذریں خُدا کے حُضُور گذرانی۔ <verse eid="1CH 16:1"/><verse number="2" style="v" sid="1CH 16:2"/>اَور جَب داویؔد سوختنی نذریں اَور سلامتی کی نذریں چڑھا چُکے تو اُنہُوں نے قادرمُطلق یَاہوِہ<note caller="+" style="f"><char style="fr" closed="false">16‏:2 </char><char style="fq" closed="false">قادرمُطلق یَاہوِہ </char><char style="ft" closed="false">عِبرانی میں یَاہوِہ سباؤتھ یعنی لشکروں کے یَاہوِہ</char></note> کے نام سے لوگوں کو برکت دی۔ <verse eid="1CH 16:2"/><verse number="3" style="v" sid="1CH 16:3"/>اَور پھر ہر اِسرائیلی مَرد اَور عورت کو ایک ایک روٹی، گوشت کا ایک ٹکڑا اَور کھجور کی ٹکیا اَور ایک کشمش کی ٹکیا تقسیم کی۔<verse eid="1CH 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4"/>اَور داویؔد نے لیویوں میں سے بعض کو یَاہوِہ کے صندُوق کے آگے مناجات کرنے، شُکر گزاری کرنے اَور یَاہوِہ اِسرائیل کے خُدا کی حَمد و ثنا کرنے کی خدمات پر مُقرّر کیا۔ <verse eid="1CH 16:4"/><verse number="5" style="v" sid="1CH 16:5"/>آسفؔ افسر اعلیٰ تھا۔ زکریاؔہ اُس کا نائب تھا۔ اُس کے بعد یعزی ایل،<note caller="+" style="f"><char style="fr" closed="false">16‏:5 </char><char style="fq" closed="false">یعزی ایل </char><char style="ft" closed="false">یعنی یعی </char><char style="fqa" closed="false">ایل</char></note> شمیراموتؔ، یحی ایل، متّتیاہؔ، اِلیابؔ، بِنایاہؔ، عوبیدؔ اِدُوم اَور یعی ایل تھے۔ اُنہیں سِتار اَور بربط بجانے کی ذمّہ داری دی گئی اَور آسفؔ کا کام یہ تھا کہ وہ زور زور سے جھانجھ بجایا کرے۔ <verse eid="1CH 16:5"/><verse number="6" style="v" sid="1CH 16:6"/>اَور بِنایاہؔ اَور یحزی ایل کاہِنوں کی ذمّہ داری یہ تھی کہ وہ خُدا کے عہد کے صندُوق کے آگے دستور کے مُطابق نرسنگے بجایا کریں۔<verse eid="1CH 16:6"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7"/>پہلے اُسی دِن داویؔد نے آسفؔ اَور اُس کے ہم خدمت ساتھیوں کو ہدایت دی کہ وہ یَاہوِہ کی شُکر گُزاری کے لیٔے یہ زبُور گائیں:<verse eid="1CH 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8"/>یَاہوِہ کا شُکر بجا لاؤ۔ اُن کے نام سے دعا کرو؛</para>
  <para style="q2" vid="1CH 16:8">قوموں کو اُن کے کاموں کے بارے میں بتاؤ۔<verse eid="1CH 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9"/>اُن کی سِتائش میں گاؤ، اُن کی مدح سرائی کرو؛</para>
  <para style="q2" vid="1CH 16:9">اُن کے تمام حیرت اَنگیز کارناموں کا بَیان کرو۔<verse eid="1CH 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10"/>اُن کے پاک نام پر فخر کرو،</para>
  <para style="q2" vid="1CH 16:10">جو یَاہوِہ کے طالب ہیں اُن کے دِل شادمان ہوں۔<verse eid="1CH 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11"/>یَاہوِہ اَور اُن کی قُوّت کے طالب ہو؛</para>
  <para style="q2" vid="1CH 16:11">اَور ہمیشہ اُن کے دیدار کے خواہاں رہو۔<verse eid="1CH 16:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 16:12"/>اُن کے حیرت اَنگیز کارناموں کو جو اُنہُوں نے اَنجام دئیے،</para>
  <para style="q2" vid="1CH 16:12">اُن کے معجزات کو اَور اُن کے سُنائے ہُوئے فیصلوں کو یاد کرو،<verse eid="1CH 16:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 16:13"/>تُم جو اُن کے خادِم</para>
  <para style="q2" vid="1CH 16:13">اِسرائیل کی نَسل ہو، اَور تُم جو یعقوب کی اَولاد اَور اُن کے برگُزیدہ ہو!<verse eid="1CH 16:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14"/>وُہی یَاہوِہ، ہمارے خُدا ہیں؛</para>
  <para style="q2" vid="1CH 16:14">ساری دُنیا میں اُن ہی کے فیصلے رائج ہیں۔<verse eid="1CH 16:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15"/>وہ اَپنے عہد کو ہمیشہ یاد رکھتے ہیں،</para>
  <para style="q2" vid="1CH 16:15">یعنی اُس کلام کو جو اُنہُوں نے ہزار پُشتوں کے لیٔے فرمایاہے،<verse eid="1CH 16:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16"/>وہ عہد، جو اُنہُوں نے اَبراہامؔ سے باندھا،</para>
  <para style="q2" vid="1CH 16:16">اَور وہ قَسم، جو اُنہُوں نے اِصحاقؔ سے کھائی۔<verse eid="1CH 16:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 16:17"/>اَور اُسی کو اُنہُوں نے یعقوب کے لیٔے قوانین،</para>
  <para style="q2" vid="1CH 16:17">اَور اِسرائیل کے لیٔے اَبدی عہد ٹھہرایا:<verse eid="1CH 16:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18"/>مَیں کنعانؔ کا مُلک تُمہیں دُوں گا</para>
  <para style="q2" vid="1CH 16:18">جو تمہارا قَطعہ، موروثی حِصّہ ہوگا۔<verse eid="1CH 16:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19"/>اُس وقت خُدا کے لوگ تعداد میں بہت کم تھے،</para>
  <para style="q2" vid="1CH 16:19">یعنی بالکُل تھوڑے اَور اُس مُلک میں پردیسی تھے،<verse eid="1CH 16:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 16:20"/>وہ ایک قوم سے دُوسری قوم میں،</para>
  <para style="q2" vid="1CH 16:20">اَور ایک سلطنت سے دُوسری سلطنت میں پھرتے رہے۔<verse eid="1CH 16:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21"/>خُدا نے کسی آدمی کو اُن پر سِتم نہیں کرنے دیا؛</para>
  <para style="q2" vid="1CH 16:21">بَلکہ خُدا نے خُود بادشاہوں کو اُن کی خاطِر یہ تنبیہ دی:<verse eid="1CH 16:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 16:22"/>کہ میرے ممسوحوں کو مت چھُونا؛</para>
  <para style="q2" vid="1CH 16:22">اَور میرے نبیوں کو کویٔی نُقصان مت پہُنچانا۔<verse eid="1CH 16:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23"/>اَے سَب اہلِ زمین! یَاہوِہ کے لیٔے گاؤ؛</para>
  <para style="q2" vid="1CH 16:23">روز بروز اُن کی نَجات کی بشارت دو۔<verse eid="1CH 16:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24"/>قوموں میں یَاہوِہ کے جلال کا ذِکر کرو،</para>
  <para style="q2" vid="1CH 16:24">اَور اُمّتوں میں اُن کے حیرت اَنگیز کارناموں کا بَیان کرو۔<verse eid="1CH 16:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25"/>کیونکہ یَاہوِہ عظیم ہیں اَور ہر سِتائش کے لائق ہیں؛</para>
  <para style="q2" vid="1CH 16:25">اَور سَب معبُودوں سے بڑھ کر تعظیم کے لائق ہیں۔<verse eid="1CH 16:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26"/>کیونکہ قوموں کے سَب معبُود محض بُت ہیں،</para>
  <para style="q2" vid="1CH 16:26">لیکن یَاہوِہ نے آسمانوں کو بنایا۔<verse eid="1CH 16:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27"/>شان و شوکت اُن کے سامنے ہیں؛</para>
  <para style="q2" vid="1CH 16:27">اَور قُدرت اَور شادمانی اُن کی حُضُوری میں ہیں۔<verse eid="1CH 16:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28"/>اَے قوموں کے قبیلو! یَاہوِہ کے لیٔے،</para>
  <para style="q2" vid="1CH 16:28">جلال اَور قُوّت یَاہوِہ ہی کے لیٔے مخصُوص کرو،<verse eid="1CH 16:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 16:29"/>یَاہوِہ کے نام کی عظمت کو اُن ہی سے منسوب کرو۔</para>
  <para style="q2" vid="1CH 16:29">اُن کی حُضُوری میں اَپنے عطیات لے کر آؤ؛</para>
  <para style="q1" vid="1CH 16:29">پاکیزگی کی شوکت میں ہوکر یَاہوِہ کی عبادت کرو۔<verse eid="1CH 16:29"/></para>
  <para style="q2">
    <verse number="30" style="v" sid="1CH 16:30"/>اَے سَب اہلِ زمین، اُن کی حُضُوری میں کانپتے رہو!</para>
  <para style="q2" vid="1CH 16:30">دُنیا مضبُوطی سے قائِم ہے، اُسے سرکایا نہیں جا سَکتا۔<verse eid="1CH 16:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31"/>افلاک خُوش ہوں، اَور زمین شادمان ہو؛</para>
  <para style="q2" vid="1CH 16:31">وہ قوموں میں اعلان کریں کہ، ”یَاہوِہ سلطنت کرتے ہیں!“<verse eid="1CH 16:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32"/>سمُندر اَور اُس کی معموُری شور مچائے؛</para>
  <para style="q2" vid="1CH 16:32">میدان اَورجو کچھ اُن میں ہے، خُوشی منائے!<verse eid="1CH 16:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33"/>تَب جنگل کے سَب درخت گائیں گے،</para>
  <para style="q2" vid="1CH 16:33">وہ خُوشی سے یَاہوِہ کے حُضُور میں نعرے ماریں گے،</para>
  <para style="q2" vid="1CH 16:33">کیونکہ وہ دُنیا کی عدالت کرنے آ رہے ہیں۔<verse eid="1CH 16:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34"/>یَاہوِہ کا شُکر بجا لاؤ کیونکہ وہ بھلےہیں؛</para>
  <para style="q2" vid="1CH 16:34">اَور اُن کی شفقت اَبدی ہے۔<verse eid="1CH 16:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35"/>پُکار پُکار کر کہو کہ اَے مُنجّی خُدا، ”ہمیں بچا لیں؛</para>
  <para style="q2" vid="1CH 16:35">اَور قوموں میں سے جمع کر لیں اَور اُن سے ہمیں رِہائی عطا فرمائیں،</para>
  <para style="q1" vid="1CH 16:35">تاکہ ہم آپ کے پاک نام کا شُکر کریں،</para>
  <para style="q2" vid="1CH 16:35">اَور آپ کی سِتائش کرنے میں فخر محسُوس کریں۔“<verse eid="1CH 16:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36"/>بنی اِسرائیل کے خُدا یَاہوِہ،</para>
  <para style="q2" vid="1CH 16:36">اَزل سے اَبد تک مُبارک ہوں۔</para>
  <para style="m" vid="1CH 16:36">سَب لوگ کہیں: ”آمین“ اَور ”یَاہوِہ کی سِتائش کرو۔“<verse eid="1CH 16:36"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37"/>اَور داویؔد نے آسفؔ اَور اُس کے ہم خدمت ساتھیوں کو یَاہوِہ کے عہد کے صندُوق کے آگے چھوڑا تاکہ وہ وہاں اَپنی اَپنی ذمّہ داریوں کے مُطابق روزانہ خدمت کیا کریں۔ <verse eid="1CH 16:37"/><verse number="38" style="v" sid="1CH 16:38"/>اَور اُس نے عوبیدؔ اِدُوم اَور اُس کے اڑسٹھ ساتھیوں کو بھی اُس کے ہمراہ خدمت کرنے کے لیٔے وہاں چھوڑا اَور عوبیدؔ اِدُوم بِن یدُوتونؔ اَور حوساہؔ کو دربان بنا دیا۔<verse eid="1CH 16:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39"/>اَور داویؔد نے صدُوقؔ کاہِنؔ اَور اُس کے ہم خدمت ساتھیوں کو گِبعونؔ میں اُونچے مقام پر یَاہوِہ کے مَسکن کے آگے چھوڑا، <verse eid="1CH 16:39"/><verse number="40" style="v" sid="1CH 16:40"/>تاکہ وہ اُن سارے آئین کے مُطابق جو یَاہوِہ کی طرف سے اِسرائیل کو دی گئی ہیں ہر صُبح اَور شام سوختنی نذر کی قُربانی کے مذبح پر یَاہوِہ کے لیٔے سوختنی نذریں گذرانیں۔ <verse eid="1CH 16:40"/><verse number="41" style="v" sid="1CH 16:41"/>اَور اُن کے ساتھ ہیمانؔ اَور یدُوتونؔ اَور باقی مُنتخب لوگ تھے جنہیں نام بنام گِنا گیا تھا تاکہ یَاہوِہ کا شُکر کریں، ”کیونکہ یَاہوِہ کی شفقت اَبدی ہے۔“ <verse eid="1CH 16:41"/><verse number="42" style="v" sid="1CH 16:42"/>ہیمانؔ اَور یدُوتونؔ کے ذمّہ نرسنگے اَور جھانجھ بجانا اَور خُدا کے لئے مُقدّس نغموں کے لیٔے دیگر ساز بجانا تھا۔ اَور یدُوتونؔ کے بیٹے پھاٹکوں پر تعینات تھے۔<verse eid="1CH 16:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43"/>تَب سَب لوگ اَپنے اَپنے گھر چلے گیٔے اَور داویؔد بھی گھر لَوٹے تاکہ اَپنے گھرانے کو برکت دیں۔<verse eid="1CH 16:43"/></para>
  <chapter eid="1CH 16"/>
  <chapter number="17" style="c" sid="1CH 17"/>
  <para style="s1">داویؔد سے خُدا کا وعدہ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1"/>جَب داویؔد محل میں رہنے لگے تو اُنہُوں نے ناتنؔ نبی سے فرمایا، ”میں تو دیودار کے محل میں رہتا ہُوں۔ جَب کہ یَاہوِہ کا عہد کا صندُوق خیمہ میں ہے۔“<verse eid="1CH 17:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2"/>ناتنؔ نے داویؔد سے کہا، ”جو کچھ آپ کے دِل میں ہے اُسے کریں کیونکہ خُدا آپ کے ساتھ ہیں۔“<verse eid="1CH 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3"/>اَور اُسی رات خُدا کا کلام ناتنؔ پر نازل ہُوا:<verse eid="1CH 17:3"/></para>
  <para style="pm">
    <verse number="4" style="v" sid="1CH 17:4"/>”جاؤ اَور میرے خادِم داویؔد کو بتاؤ، ’جو کچھ یَاہوِہ یُوں فرماتے ہیں: میرے رہنے کے لیٔے تُم میرے لیٔے ایک گھر نہ بنانا۔ <verse eid="1CH 17:4"/><verse number="5" style="v" sid="1CH 17:5"/>کیونکہ جَب سے مَیں بنی اِسرائیل کو مِصر سے نکال لایا ہُوں، تَب سے آج کے دِن تک میں کسی گھر میں نہیں رہا بَلکہ ایک خیمہ سے دُوسرے خیمہ میں اَور ایک قِیام گاہ سے دُوسری قِیام گاہ میں مُنتقل ہوتا رہا ہُوں۔ <verse eid="1CH 17:5"/><verse number="6" style="v" sid="1CH 17:6"/>جہاں کہیں مَیں تمام بنی اِسرائیل کے ساتھ گیا کیا مَیں نے اُن کے سرداروں میں سے جِن کو مَیں نے اَپنی قوم اِسرائیل کی گلّہ بانی کرنے کا حُکم دیا تھا مَیں نے اُن میں سے کسی سے بھی کبھی کہا، ”تُم نے میرے لیٔے دیودار کی لکڑی کا گھر کیوں نہیں بنایا؟“ ‘<verse eid="1CH 17:6"/></para>
  <para style="pm">
    <verse number="7" style="v" sid="1CH 17:7"/>”پس تُم میرے خادِم داویؔد کو بتاؤ، قادرمُطلق یَاہوِہ<note caller="+" style="f"><char style="fr" closed="false">17‏:7 </char><char style="fq" closed="false">قادرمُطلق یَاہوِہ </char><char style="ft" closed="false">عِبرانی میں یَاہوِہ سباؤتھ یعنی لشکروں کے یَاہوِہ</char></note> یُوں فرماتے ہیں، ’مَیں نے تُمہیں چراگاہ میں سے جَب تُم بھیڑ بکریوں کے پیچھے پیچھے چلتے تھے تاکہ تُم میری قوم اِسرائیل کے حاکم ہو۔ <verse eid="1CH 17:7"/><verse number="8" style="v" sid="1CH 17:8"/>جہاں کہیں تُم گئے مَیں تمہارے ساتھ رہا اَور مَیں نے تمہارے سارے دُشمنوں کو تمہارے سامنے سے فنا کر دیا۔ اَب مَیں تمہارے نام کو رُوئے زمین کے عظیم آدمیوں کے ناموں کی مانند عظمت بخشوں گا۔ <verse eid="1CH 17:8"/><verse number="9" style="v" sid="1CH 17:9"/>اَور مَیں اَپنی قوم اِسرائیل کو ایک اَیسی سرزمین میں قائِم کروں گا جو اُن کا وطن ہوگا اَور اُنہیں وہاں سے کبھی نہ ہٹایا جا سکےگا۔ اَور بدکار لوگ اُنہیں دُکھ نہ دے سکیں گے جَیسا کہ وہ پہلے کیا کرتے تھے۔ <verse eid="1CH 17:9"/><verse number="10" style="v" sid="1CH 17:10"/>اَور جَیسا کہ وہ اُس وقت سے کرتے آ رہے ہیں جَب مَیں نے اَپنی قوم اِسرائیل پر قاضی مُقرّر کرنے کا حُکم دیا تھا اَور مَیں تُمہیں تمہارے سَب دُشمنوں پر غلبہ بخشوں گا۔</para>
  <para style="pm" vid="1CH 17:10">” ’اَور مَیں تُمہیں یہ بھی بتاتا ہُوں کہ یَاہوِہ تمہارے خاندان کو قائِم رکھیں گے اَور تُمہیں ایک شاہی خاندان کے طور پر قائِم کریں گے۔ <verse eid="1CH 17:10"/><verse number="11" style="v" sid="1CH 17:11"/>اَور جَب تمہارے دِن پُورے ہو جایٔیں گے تَب تُم دُنیا سے رخصت ہوکر اَپنے آباؤاَجداد سے جا مِلوگے۔ تَب مَیں تمہاری نَسل کو تمہارا جانشین بناؤں گا یعنی تمہارے بیٹوں میں سے ایک کو اَور مَیں اُس کی سلطنت کو استحکام بخشوں گا۔ <verse eid="1CH 17:11"/><verse number="12" style="v" sid="1CH 17:12"/>اَور وُہی میرے لیٔے گھر بنائے گا اَور مَیں اُس کے تخت کو اَبد تک قائِم رکھوں گا۔ <verse eid="1CH 17:12"/><verse number="13" style="v" sid="1CH 17:13"/>مَیں اُس کا باپ ہُوں گا اَور وہ میرا بیٹا ہوگا اَور میری رحمت اُس کے سَر سے کبھی نہیں جُدا ہوگی جَیسے مَیں نے اُن پر سے ہٹا لی تھی جو تُم سے پہلے حُکمران تھا۔ <verse eid="1CH 17:13"/><verse number="14" style="v" sid="1CH 17:14"/>اَور مَیں اُسے اَپنے گھر اَور اَپنی مملکت میں ہمیشہ تک قائِم رکھوں گا اَور اُس کا تخت اَبد تک قائِم رہے گا۔‘ “<verse eid="1CH 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15"/>چنانچہ ناتنؔ نے یہ ساری باتیں جسے یَاہوِہ نے رُویا میں دِکھایا تھا اُسے داویؔد کو کہہ سُنایٔیں۔<verse eid="1CH 17:15"/></para>
  <para style="s1">داویؔد کی دعا</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16"/>تَب داویؔد بادشاہ اَندر گئے اَور یَاہوِہ کے حُضُور بیٹھ کر کہنے لگے:</para>
  <para style="pm" vid="1CH 17:16">”اَے یَاہوِہ خُدا، مَیں کون ہُوں اَور میرا خاندان کیا ہے کہ آپ نے مُجھے یہ مقام عطا کیا۔ <verse eid="1CH 17:16"/><verse number="17" style="v" sid="1CH 17:17"/>اَور اَے خُدا آپ کی نظر میں یہ گویا کافی نہ تھا اِس لیٔے آپ نے اَپنے خادِم کے گھر کے مُستقبِل کے متعلّق بہت کچھ فرمایاہے۔ اَور آپ نے اَے یَاہوِہ خُدا، مُجھ پر اَیسی نظر کی ہے گویا مَیں تمام آدمیوں سے زِیادہ سربُلند ہُوں۔<verse eid="1CH 17:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="1CH 17:18"/>”آپ نے اَپنے خادِم کی جو عزّت اَفزائی کی ہے اُس کی نِسبت داویؔد آپ سے اَور زِیادہ کیا کہے؟ کیونکہ آپ اَپنے خادِم کو جانتے ہیں۔ <verse eid="1CH 17:18"/><verse number="19" style="v" sid="1CH 17:19"/>اَے یَاہوِہ آپ نے اَپنے خادِم کی خاطِر اَپنی ہی مرضی سے یہ سَب عظیم کام کر دِکھایا ہے اَور اَپنے سارے عظیم وعدے اَپنے خادِم پر ظاہر کئے ہیں۔<verse eid="1CH 17:19"/></para>
  <para style="pm">
    <verse number="20" style="v" sid="1CH 17:20"/>”اَے یَاہوِہ، آپ کی مانند اَیسا کویٔی نہیں اَور جَیسے ہم نے خُود اَپنے کانوں سے سُنا آپ کے سِوا اَور کویٔی خُدا نہیں ہے۔ <verse eid="1CH 17:20"/><verse number="21" style="v" sid="1CH 17:21"/>اَور رُوئے زمین پر آپ کی قوم اِسرائیل کی طرح اَور کون سِی قوم ہے جسے چھُڑانے کے لیٔے خُدا خُود آگے آیا، تاکہ اُسے اَپنی اُمّت بنا لے اَور اُسے مِصر کی غُلامی سے نَجات دِلائے اَور اُس کے سامنے سے دُوسری قوموں کو دُور کرکے بڑے عظیم اَور مُہیب کارنامے اَنجام دے اَور اَپنا نام بُلند کرے؟ <verse eid="1CH 17:21"/><verse number="22" style="v" sid="1CH 17:22"/>کیونکہ آپ نے اَپنی قوم اِسرائیل کو ہمیشہ کے لیٔے اَپنی قوم بنا لیا ہے اَور آپ نے اَپنے آپ کو اَے یَاہوِہ اُن کا خُدا مُقرّر کیا ہے۔<verse eid="1CH 17:22"/></para>
  <para style="pm">
    <verse number="23" style="v" sid="1CH 17:23"/>”اَور اَب اَے یَاہوِہ، اَپنے اُس وعدہ کو جو آپ کے خادِم اَور اُس کے گھرانے سے تعلّق رکھتا ہے اَبد تک قائِم رکھیں اَور جَیسا آپ نے وعدہ کیا وَیسا ہی کریں۔ <verse eid="1CH 17:23"/><verse number="24" style="v" sid="1CH 17:24"/>تاکہ ہمیشہ تک آپ کے نام کی عظمت ہو۔ تَب لوگ کہیں گے، ’قادرمُطلق یَاہوِہ اِسرائیل کے خُدا ہیں!‘ اَور آپ کے خادِم داویؔد کا گھرانا آپ کے حُضُور میں ہمیشہ قائِم رہے گا۔<verse eid="1CH 17:24"/></para>
  <para style="pm">
    <verse number="25" style="v" sid="1CH 17:25"/>”کیونکہ آپ نے اَے میرے خُدا اَپنے خادِم پر ظاہر کیا ہے کہ آپ ایک گھر تعمیر کریں گے۔ لہٰذا آپ کے خادِم نے آپ کے حُضُور دعا کرنے کا حوصلہ پایا۔ <verse eid="1CH 17:25"/><verse number="26" style="v" sid="1CH 17:26"/>اَے یَاہوِہ آپ ہی خُدا ہیں! اَور آپ نے اَپنے خادِم سے یہ پُرفضل وعدہ کیا ہے۔ <verse eid="1CH 17:26"/><verse number="27" style="v" sid="1CH 17:27"/>اَور آپ کو یہ پسند آیا ہے کہ آپ اَپنے خادِم کے گھرانے کو برکت بخشیں تاکہ وہ اَبد تک آپ کی نظر میں قائِم رہے۔ اَے یَاہوِہ، آپ نے اُسے برکت دی ہے چنانچہ وہ اَبد تک مُبارک ہے۔“<verse eid="1CH 17:27"/></para>
  <chapter eid="1CH 17"/>
  <chapter number="18" style="c" sid="1CH 18"/>
  <para style="s1">داویؔد کی فتوحات</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1"/>اِسی کے بعد، داویؔد نے فلسطینیوں کو شِکست دی اَور اُنہیں مغلُوب کیا، اَور گاتؔھ کو اَور اُس کے گِردونواح کے قصبوں کو جو فلسطینیوں کے زیرِ تسلُّط تھے اَپنے ہاتھ میں لے لیا۔<verse eid="1CH 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 18:2"/>داویؔد نے مُوآبیوں کو بھی شِکست دی اَور وہ اُس کے مطیع ہو گئے اَور خراج اَدا کرنے لگے۔<verse eid="1CH 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3"/>اِس کے علاوہ داویؔد نے ضوباہؔ حماتؔ کے بادشاہ ہددعزرؔ کو بھی شِکست دی جَب وہ دریائے فراتؔ تک کے علاقہ کو اَپنے قبضہ میں لینا چاہتا تھا۔ <verse eid="1CH 18:3"/><verse number="4" style="v" sid="1CH 18:4"/>اَور داویؔد کے ایک ہزار رتھ، سات ہزار رتھ بان اَور بیس ہزار پیادہ سپاہی پکڑ لئے۔ اُس نے ایک سَو رتھ کے گھوڑوں کے سِوا باقی سَب کی کونچیں کاٹ ڈالیں۔<verse eid="1CH 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5"/>اَور جَب دَمشق کے ارامی ضوباہؔ کے بادشاہ ہددعزرؔ کی مدد کو آئے تو داویؔد نے اُن میں سے بائیس ہزار کو قتل کیا۔ <verse eid="1CH 18:5"/><verse number="6" style="v" sid="1CH 18:6"/>اُس نے دَمشق کی ارامی سلطنت میں اَپنے فَوجیوں کی چوکیاں قائِم کیں اَور ارامی اُن کے مطیع ہو گئے اَور خراج اَدا کرنے لگے۔ اَور جہاں کہیں داویؔد گئے یَاہوِہ نے اُنہیں فتح بخشی۔<verse eid="1CH 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7"/>ہددعزرؔ کے فَوجی سرداروں کے پاس سونے کی ڈھالیں تھیں۔ داویؔد نے اُن پر قبضہ کر لیا اَور اُنہیں یروشلیمؔ لے آئے۔ <verse eid="1CH 18:7"/><verse number="8" style="v" sid="1CH 18:8"/>اَور داویؔد ہددعزرؔ کے قصبوں طیبحؔ<note caller="+" style="f"><char style="fr" closed="false">18‏:8 </char><char style="fq" closed="false">طیبحؔ </char><char style="ft" closed="false">کچھ نُسخوں میں طِبحتؔ بھی ہے۔</char></note> اَور کُونؔ سے بہت سا کانسا لائے جسے شُلومونؔ نے ایک بڑا حوض اَور سُتون اَور برتن بنانے کے لیٔے اِستعمال کیا۔<verse eid="1CH 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9"/>جَب حماتؔ کے بادشاہ توعُوؔ نے سُنا کہ داویؔد نے ضوباہؔ کے بادشاہ ہددعزرؔ کے تمام فَوج کو شِکست دے دی۔ <verse eid="1CH 18:9"/><verse number="10" style="v" sid="1CH 18:10"/>تَب توعُوؔ نے اَپنے بیٹے ہَدورامؔ کو داویؔد بادشاہ کے پاس بھیجا تاکہ اُنہیں سلام کرے اَور مُبارکباد دے کیونکہ داویؔد نے جنگ کرکے ہددعزرؔ کو مارا تھا کیونکہ ہددعزرؔ توعُوؔ سے جنگ کیا کرتا تھا، اَور ہَدورامؔ سونے، چاندی اَور کانسے کی ہر قِسم کی اَشیا اَپنے ساتھ نذرانہ کے طور پر لایاتھا۔<verse eid="1CH 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 18:11"/>جنہیں داویؔد بادشاہ نے یَاہوِہ کو نذر کر دیا جَیسا کہ اُنہُوں نے دیگر اَقوام یعنی اِدُوم، مُوآب، بنی عمُّون، فلسطینیوں اَور عمالیقؔ سے حاصل کَردہ چاندی اَور سونا یَاہوِہ کو نذر کیا تھا۔<verse eid="1CH 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12"/>ابیشائی بِن ضرویاہؔ نے وادی شور میں اٹھّارہ ہزار اِدُومیوں کو مارا <verse eid="1CH 18:12"/><verse number="13" style="v" sid="1CH 18:13"/>اَور اُس نے اِدُوم میں مُحافظ فَوجی چوکیاں قائِم کیں اَور تمام اِدُومی داویؔد کے مطیع ہو گئے اَور داویؔد جہاں بھی جاتے تھے یَاہوِہ اُنہیں فتح بخشتے تھے۔<verse eid="1CH 18:13"/></para>
  <para style="s1">داویؔد کے اہلکار</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14"/>داویؔد نے تمام اِسرائیل پر حُکمرانی کی اَور اَپنی ساری رعایا کے ساتھ نہایت ہی اِنصاف اَور راستی سے پیش آتے رہے۔<verse eid="1CH 18:14"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 18:15"/>اَور یُوآبؔ بِن ضرویاہؔ فَوج کا سپہ سالار تھا؛</para>
  <para style="li1" vid="1CH 18:15">اَور یہوشافاطؔ بِن احِیلودؔ مورّخ تھا؛<verse eid="1CH 18:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 18:16"/>اَور صدُوقؔ بِن احِیطوبؔ اَور اَبی ملیخ<note caller="+" style="f"><char style="fr" closed="false">18‏:16 </char><char style="fq" closed="false">اَبی ملیخ </char><char style="ft" closed="false">کچھ نُسخوں میں احِیملکؔ بھی لِکھا ہے۔</char></note> بِن ابیاترؔ کاہِنؔ تھے</para>
  <para style="li1" vid="1CH 18:16">اَور شاوساؔ مُنشی تھا۔<verse eid="1CH 18:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 18:17"/>اَور بِنایاہؔ بِن یہُویدعؔ کریتیوں اَور پِلیتھیوں کا اعلیٰ اہلکار تھا</para>
  <para style="li1" vid="1CH 18:17">اَور داویؔد کے بیٹے بادشاہ کے اعلیٰ حاکم<note caller="+" style="f"><char style="fr" closed="false">18‏:17 </char><char style="fq" closed="false">اعلیٰ حاکم </char><char style="ft" closed="false">مزید دیکھیں <char style="xt"><ref loc="2SA 18:17">2 سمو 18‏:17</ref>‏</char></char></note> تھے۔<verse eid="1CH 18:17"/></para>
  <chapter eid="1CH 18"/>
  <chapter number="19" style="c" sid="1CH 19"/>
  <para style="s1">بنی عمُّون سے جنگ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1"/>اِس کے بعد اَیسا ہُوا کہ بنی عمُّون کا بادشاہ ناحسؔ مَر گیا اَور اُس کا بیٹا اُس کی جگہ بادشاہ بنا۔ <verse eid="1CH 19:1"/><verse number="2" style="v" sid="1CH 19:2"/>تو داویؔد نے چاہا، ”وہ ناحسؔ کے بیٹے حنُونؔ پر مہربانی کرے کیونکہ اُس کے باپ نے مُجھ پر مہربانی کی تھی۔“ لہٰذا حنُونؔ سے اُس کے باپ کے بارے میں ہمدردی کا اِظہار کرنے کے لیٔے داویؔد نے قاصِدوں کا ایک وفد بھیجا۔</para>
  <para style="p" vid="1CH 19:2">جَب داویؔد کے آدمی بنی عمُّون کے مُلک میں حنُونؔ کے پاس اُسے تسلّی دینے آئے <verse eid="1CH 19:2"/><verse number="3" style="v" sid="1CH 19:3"/>تَب عمُّونی اُمرا نے حنُونؔ سے کہا، ”کیا تُو یہ خیال کرتا ہے کہ ہمدردی ظاہر کرنے کے لیٔے سفیر بھیج کر داویؔد تمہارے باپ کی عزّت اَفزائی کر رہے ہیں؟ کیا اُن کے سفیر تمہارے پاس مُلک کا حال دریافت کرنے، جاسُوسی کرنے اَور اُسے تباہ کرنے نہیں آئے؟“ <verse eid="1CH 19:3"/><verse number="4" style="v" sid="1CH 19:4"/>تَب حنُونؔ نے داویؔد کے سفیروں کو پکڑ لیا اَور پھر اُنہیں واپس بھیج دیا لیکن اُن کی حالت یہ تھی کہ اُن کی داڑھیاں اَور مونچھیں غائب تھیں اَور اُن کے زیرِ جامے کولہوں سے لے کر نیچے تک پھٹے ہُوئے تھے۔<verse eid="1CH 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 19:5"/>جَب کسی نے آکر داویؔد کو اُن آدمیوں کے بارے میں خبر دی تو داویؔد نے اُن کے اِستِقبال کے لیٔے قاصِد بھیجے کیونکہ وہ اُن کے سامنے آنے سے شرما رہے تھے۔ بادشاہ نے اُنہیں کہلا بھیجا، ”جَب تک تمہاری داڑھیاں نہ بڑھ جایٔیں تُم یریحوؔ میں ٹھہرے رہو۔ اُس کے بعد لَوٹ آنا۔“<verse eid="1CH 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6"/>جَب عمُّونیوں کو احساس ہُوا کہ وہ داویؔد کے غُصّے کا نِشانہ بننے والے ہیں تو حنُونؔ اَور بنی عمُّون نے ارام نحرائیمؔ یعنی مسوپتامیہؔ، ارام معکہؔ اَور ضوباہؔ سے رتھ اَور رتھ بان کرائے پر منگوانے کے لیٔے چونتیس ہزار کِلوگرام چاندی بھیجی۔ <verse eid="1CH 19:6"/><verse number="7" style="v" sid="1CH 19:7"/>اِس طرح اُنہُوں نے بتّیس ہزار رتھوں اَور رتھ بانوں نیز معکہؔ کے بادشاہ اَور اُس کی افواج کو کرائے پر لیا اَور وہ آکر میدباؔ کے سامنے خیمہ زن ہو گئے اَور بنی عمُّون اَپنے شہروں سے جمع ہُوئے اَور جنگ کرنے کو آئے۔<verse eid="1CH 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8"/>جَب داویؔد نے یہ سُنا تو اُس نے یُوآبؔ اَور سُورماؤں کے تمام فَوج کو بھیجا۔ <verse eid="1CH 19:8"/><verse number="9" style="v" sid="1CH 19:9"/>تَب بنی عمُّون نے باہر نکل کر اَپنے شہر کے پھاٹک کے پاس ہی لڑائی کے لیٔے صف باندھی جَب کہ وہ بادشاہ جو آئےتھے اُن سے الگ میدان میں تھے۔<verse eid="1CH 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10"/>جَب یُوآبؔ نے دیکھا کہ اُس کے آگے اَور پیچھے لڑائی کے لیٔے صف بندی ہو چُکی ہے تو اُس نے اِسرائیل کے بہترین فَوجیوں میں سے بعض کو چُن کر ارامیوں کے مقابل صف آرا کیا۔ <verse eid="1CH 19:10"/><verse number="11" style="v" sid="1CH 19:11"/>اَور باقی آدمیوں کو اَپنے بھایٔی ابیشائی کی قیادت میں عمُّونیوں کے خِلاف میدان میں اُتارا۔ <verse eid="1CH 19:11"/><verse number="12" style="v" sid="1CH 19:12"/>یُوآبؔ نے کہا، ”اگر ارامی مُجھ پر غالب آنے لگیں تو تُم میری مدد کے لیٔے بروقت پہُنچ جانا لیکن اگر عمُّونی تمہارے خِلاف زِیادہ طاقتور ثابت ہُوئے تو مَیں تمہاری مدد کے لئے بروقت پہُنچ جاؤں گا۔ <verse eid="1CH 19:12"/><verse number="13" style="v" sid="1CH 19:13"/>پس ہمّت باندھو اَور آؤ ہم اَپنی قوم اَور اَپنے خُدا کے شہروں کی خاطِر بہادری سے جنگ کریں اَور یَاہوِہ جو کچھ اُن کی نظر میں بہتر ہوگا وُہی کریں گے۔“<verse eid="1CH 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14"/>تَب یُوآبؔ اَور اُس کے لشکر کے آدمی ارامیوں سے لڑنے کے لیٔے آگے بڑھے اَور ارامی اُن کے سامنے سے بھاگ نکلے۔ <verse eid="1CH 19:14"/><verse number="15" style="v" sid="1CH 19:15"/>جَب عمُّونیوں نے دیکھا کہ ارامی بھاگ نکلے تو وہ بھی اُس کے بھایٔی ابیشائی کے سامنے سے بھاگ کر شہر کے اَندر چلے گیٔے۔ تَب یُوآبؔ واپس یروشلیمؔ چلا گیا۔<verse eid="1CH 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16"/>جَب ارامیوں نے دیکھا کہ اُنہُوں نے بنی اِسرائیل سے شِکست کھائی تو قاصِد بھیج کر دریائے فراتؔ کے پار کے ارامیوں کو بُلوا لیا جِن کی کمان ہددعزرؔ کے سپہ سالار سوفکؔ کے ہاتھ میں تھی۔<verse eid="1CH 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17"/>جَب داویؔد کو اِطّلاع پہُنچی تو اُس نے تمام اِسرائیل کو جمع کیا اَور دریائے یردنؔ کے پار جا اُترے اَور اُنہُوں نے پیش قدمی کرکے اُن کے خِلاف مورچے سنبھال لیٔے۔ اَور جَب داویؔد نے ارامیوں کو مُقابلہ کے لیٔے للکارا تو وہ اُن سے لڑے۔ <verse eid="1CH 19:17"/><verse number="18" style="v" sid="1CH 19:18"/>لیکن اِسرائیل نے اُنہیں شِکست دی اَور داویؔد نے ارامیوں کے سات ہزار رتھ بانوں اَور چالیس ہزار پیادہ فَوجیوں کو ہلاک کیا اَور اُن کے سپہ سالار سوفکؔ کو بھی قتل کر ڈالا۔<verse eid="1CH 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 19:19"/>جَب اُن تمام بادشاہوں نے جو ہددعزرؔ کے مطیع تھے دیکھا کہ وہ اِسرائیل سے شِکست کھا چُکے ہیں تو اُنہُوں نے داویؔد سے صُلح کرلی اُن کے مطیع ہو گئے۔</para>
  <para style="p" vid="1CH 19:19">اَور ارامی آئندہ کبھی بنی عمُّون کی مدد پر راضی نہ ہُوئے۔<verse eid="1CH 19:19"/></para>
  <chapter eid="1CH 19"/>
  <chapter number="20" style="c" sid="1CH 20"/>
  <para style="s1">ربّہؔ پر قبضہ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1"/>موسمِ بہار میں اُس وقت جَب بادشاہ جنگ کرنے نکلتے ہیں یُوآبؔ نے مُسلّح افواج کے ساتھ چڑھائی کی اَور بنی عمُّون کے مُلک کو اُجاڑ ڈالا اَور ربّہؔ کو چلےگئے اَور اُس کا محاصرہ کیا۔ لیکن داویؔد یروشلیمؔ میں ہی رہے۔ اَور یُوآبؔ نے ربّہؔ پر حملہ کرکے اُسے تباہ کر دیا۔ <verse eid="1CH 20:1"/><verse number="2" style="v" sid="1CH 20:2"/>اَور جَب داویؔد ربّہؔ پہُنچے تَب اُنہُوں نے اُن کے بادشاہ کے سَر سے سونے کا تاج اُتار لیا جِس کا وزن چونتیس کِلو تھا اَور اُس میں بیش قیمتی جواہر جڑے ہُوئے تھے۔ یہ تاج داویؔد کے سَر پر رکھا گیا۔ داویؔد کو اُس شہر سے لُوٹ کا اَور بھی بہت سا مال مِلا۔ <verse eid="1CH 20:2"/><verse number="3" style="v" sid="1CH 20:3"/>اَور داویؔد شہر کے باشِندوں کو وہاں سے نکال لائے اَور اُنہیں جتّھوں میں تقسیم کرکے اُنہیں آروں لوہے کی کُدالوں اَور کُلہاڑوں سے بیگار میں کام کرنے پر لگایا۔ داویؔد نے بنی عمُّون کے تمام شہروں سے اَیسا ہی سلُوک کیا۔ اُس کے بعد داویؔد اَور اُن کی تمام فَوج کے سارے آدمی یروشلیمؔ لَوٹ آئے۔<verse eid="1CH 20:3"/></para>
  <para style="s1">فلسطینیوں کے ساتھ جنگ</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4"/>اُس کے بعد گِزرؔ میں فلسطینیوں کے ساتھ جنگ شروع ہو گئی۔ تَب حُوشاتی سِبّکائی نے سپّائیؔ کو جو قدیم زمانے کے بڑے جِسامت والے اِنسانی رفائیمؔ کی نَسل سے تھا، قتل کیا اَور فلسطینی مغلُوب ہو گئے۔<verse eid="1CH 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5"/>فلسطینیوں کے ساتھ ایک اَور جنگ میں اِلحنانؔ بِن یائیرؔ نے گِتّی گولیتؔ کے بھایٔی لاحمیؔ کو جِس کے نیزے کی چھڑ جُلاہے کے شہتیر کے برابر تھی مار ڈالا۔<verse eid="1CH 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6"/>ایک اَور جنگ میں بھی جو گاتؔھ میں ہُوئی ایک بڑا قدآور آدمی تھا جِس کے ہر ہاتھ اَور ہر پاؤں کی چھ چھ اُنگلیاں تھیں یعنی کُل چوبیس تھیں۔ وہ بھی کسی رافاؔ کی نَسل سے تھا۔ <verse eid="1CH 20:6"/><verse number="7" style="v" sid="1CH 20:7"/>جَب اُس نے اِسرائیل کی توہین کی تو داویؔد کے بھایٔی شِمعاؔ کے بیٹے یُوناتانؔ نے اُسے مار ڈالا۔<verse eid="1CH 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8"/>یہ تمام لوگ گاتؔھ میں رافاؔ کی نَسل سے تھے اَور داویؔد اَور اُس کے آدمیوں کے ہاتھوں مارے گیٔے۔<verse eid="1CH 20:8"/></para>
  <chapter eid="1CH 20"/>
  <chapter number="21" style="c" sid="1CH 21"/>
  <para style="s1">داویؔد کا جنگجو مَردوں کا شُمار کرنا</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1"/>اِسرائیل کے خِلاف شیطان اُٹھ کھڑا ہُوا اَور اُس نے اِسرائیل کی مردُم شماری کرنے کے لیٔے داویؔد کو اُکسایا۔ <verse eid="1CH 21:1"/><verse number="2" style="v" sid="1CH 21:2"/>چنانچہ داویؔد نے یُوآبؔ سے اَور فَوج کے سپہ سالاروں سے فرمایا، ”جاؤ بیرشبعؔ سے لے کر دانؔ تک اِسرائیل کی مردُم شماری کرو اَور پھر واپس مُجھے اِطّلاع دو تاکہ مُجھے مَعلُوم ہو کہ وہ تعداد میں کتنے ہیں۔“<verse eid="1CH 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3"/>تَب یُوآبؔ نے کہا، ”یَاہوِہ اَپنے لوگوں کی تعداد جِتنی بھی ہے اُس سے سَو گُنا زِیادہ کرے۔ لیکن اَے میرے آقا بادشاہ کیا وہ سَب کے سَب میرے آقا کی رعِیّت نہیں ہیں؟ پھر میرے آقا اَیسا کیوں کرنا چاہتے ہیں؟ وہ اِسرائیل کے لیٔے خطا کا باعث کیوں بنے؟“<verse eid="1CH 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4"/>تاہم بادشاہ نے اَپنے فرمان سے یُوآبؔ کے اِعتراض کو مُسترد کر دیا۔ لہٰذا یُوآبؔ رخصت ہُوا اَور تمام اِسرائیل میں ہر جگہ گھُوم پھر کر واپس یروشلیمؔ لَوٹ آیا <verse eid="1CH 21:4"/><verse number="5" style="v" sid="1CH 21:5"/>اَور یُوآبؔ نے جنگجو مَردوں کی تعداد داویؔد کو بتایٔی۔ اَور تمام اِسرائیل میں گیارہ لاکھ شمشیر زن مَرد مَوجُود تھے جِن میں یہُوداہؔ کے چار لاکھ ستّر ہزار شمشیر زن مَرد بھی شامل تھے۔<verse eid="1CH 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 21:6"/>لیکن یُوآبؔ نے اِس مردُم شماری میں بنی لیوی اَور بنی بِنیامین کو شامل نہ کیا کیونکہ بادشاہ کا فرمان اُس کے نزدیک نامُناسب تھا۔ <verse eid="1CH 21:6"/><verse number="7" style="v" sid="1CH 21:7"/>یہ خُدا کی نظر میں بھی بُرا تھا اِس لیٔے خُدا نے اِسرائیل کو سزا دی۔<verse eid="1CH 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 21:8"/>تَب داویؔد نے خُدا سے دعا کی، ”مُجھ سے بڑا سنگین گُناہ ہُوا، مَیں نے اَیسا کام کیا۔ اَب مَیں آپ کی مِنّت کرتا ہُوں کہ اَپنے خادِم کا سنگین گُناہ دُور کر دیں کیونکہ مَیں نے یہ بڑی حماقت کی ہے۔“<verse eid="1CH 21:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9"/>اَور یَاہوِہ نے داویؔد کے غیب بین گادؔ سے فرمایا، <verse eid="1CH 21:9"/><verse number="10" style="v" sid="1CH 21:10"/>”جا اَور داویؔد کو بتا، ’یَاہوِہ یُوں فرماتے ہیں کہ مَیں تیرے سامنے تین بَلائیں لاتا ہُوں۔ اُن میں سے ایک چُن لے جسے مَیں تُجھ پر نازل کروں۔‘ “<verse eid="1CH 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11"/>تَب گادؔ نے داویؔد کے پاس جا کر فرمایا، ”یَاہوِہ یُوں فرماتے ہیں: ’آپ جسے چاہیں اُسے مُنتخب کر لیں: <verse eid="1CH 21:11"/><verse number="12" style="v" sid="1CH 21:12"/>یا تو قحط کے تین بَرس یا تمہارے دُشمنوں کی تلواریں تین بَرس تک تمہارا پیچھا کرتی رہیں اَور تُم اُن کے آگے بھاگتے پھرو یا تین دِن تک یَاہوِہ کی تلوار یعنی مُلک میں وَبا پھیلی رہے اَور یَاہوِہ کا فرشتہ اِسرائیل کے ہر حِصّہ میں تباہی مچاتا رہے۔‘ اَب سوچ لو کہ مَیں اَپنے بھیجنے والے کو کیا جَواب دُوں۔“<verse eid="1CH 21:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13"/>داویؔد نے گادؔ سے کہا، ”میں بڑی مُصیبت میں پھنس گیا ہُوں۔ مُجھے یَاہوِہ ہی کے ہاتھوں میں پڑنے دے کیونکہ وہ بڑے ہی رحیم ہیں۔ لیکن مُجھے آدمیوں کے ہاتھوں میں پڑنا منظُور نہیں۔“<verse eid="1CH 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14"/>تَب یَاہوِہ نے اِسرائیل میں وَبا بھیجی اَور اِسرائیل کے ستّر ہزار لوگ مَر گیٔے۔ <verse eid="1CH 21:14"/><verse number="15" style="v" sid="1CH 21:15"/>اَور یَاہوِہ نے ایک فرشتہ کو بھیجا کہ یروشلیمؔ کو تباہ کر ڈالے۔ لیکن جَب فرشتہ یہ کام کرنے لگا تو یَاہوِہ اُس تباہی کو دیکھ کر ملُول ہُوئے اَور اُنہُوں نے اُس فرشتہ سے جو لوگوں کو ہلاک کر رہاتھا فرمایا، ”بس کر، اَپنا ہاتھ روک لے!“ یَاہوِہ کا فرشتہ اُس وقت یبُوسی اُرنانؔ کے کھلیان کے پاس کھڑا تھا۔<verse eid="1CH 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16"/>اَور داویؔد نے اُوپر نگاہ کی تو دیکھا کہ یَاہوِہ کا فرشتہ آسمان اَور زمین کے درمیان کھڑا ہے اَور ایک شمشیرِ برہنہ اُس کے ہاتھ میں ہے جو یروشلیمؔ کی طرف بڑھی ہُوئی ہے۔ تَب داویؔد اَور بُزرگ ٹاٹ اوڑھے ہُوئے مُنہ کے بَل سَجدہ میں گِرے۔<verse eid="1CH 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 21:17"/>اَور داویؔد نے خُدا سے کہا، ”کیا وہ مَیں ہی نہیں تھا جِس نے جنگجو مَردوں کے گنے جانے کا حُکم دیا تھا؟ گُناہ تو مَیں نے کیا ہے، خطا تو مُجھ چرواہے سے ہُوئی ہے۔ اَور یہ تو محض بھیڑیں ہیں؟ اُنہُوں نے کیا کیا ہے؟ اَے یَاہوِہ میرے خُدا! آپ کا ہاتھ میرے اَور میرے خاندان کے خِلاف اُٹھے لیکن اِس وَبا کو اَپنے لوگوں کے درمیان سے اُٹھا لیں۔“<verse eid="1CH 21:17"/></para>
  <para style="s1">داویؔد کا ایک مذبح بنایا جانا</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18"/>تَب یَاہوِہ کے فرشتہ نے گادؔ کو حُکم دیا کہ جا اَور داویؔد سے کہہ کہ وہ یبُوسی اُرنانؔ کے کھلیان میں یَاہوِہ کے لیٔے ایک مذبح بنائے۔ <verse eid="1CH 21:18"/><verse number="19" style="v" sid="1CH 21:19"/>تَب داویؔد نے یَاہوِہ کے اُس حُکم کے مُطابق جو اُسے گادؔ کے ذریعہ دیا گیا تھا وہاں روانہ ہُوا۔<verse eid="1CH 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 21:20"/>اُس وقت اُرنانؔ گیہُوں کی بالوں میں سے دانے نکال رہاتھا۔ جَب وہ مُڑا تو اُس نے بھی فرشتہ کو دیکھا۔ اُس کے چاروں بیٹے جو اُس کے ساتھ تھے چھُپ گیٔے۔ <verse eid="1CH 21:20"/><verse number="21" style="v" sid="1CH 21:21"/>تَب داویؔد اُرنانؔ کے پاس پہُنچے اَور جَب ارنانؔ نے نگاہ کی اَور داویؔد کو دیکھا تو وہ کھلیان چھوڑکر داویؔد کے سامنے آکر زمین پر مُنہ کے بَل گرا۔<verse eid="1CH 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22"/>تَب داویؔد نے اُرنانؔ سے کہا، ”اَپنے کھلیان کی یہ جگہ مُجھے دے دے۔ میں چاہتا ہُوں کہ یہاں یَاہوِہ کے لیٔے ایک مذبح بناؤں تاکہ لوگ وَبا سے نَجات پائیں۔ اِسے مُجھے فروخت کر۔ میں پُوری قیمت دینے کو تیّار ہُوں۔“<verse eid="1CH 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23"/>اُرنانؔ نے داویؔد سے کہا، ”تُم اِسے لے لو اَور میرے آقا بادشاہ جَیسے آپ کو پسند ہو کریں۔ دیکھیں میں اِن بَیلوں کو سوختنی نذروں کے لیٔے، گاہنے کا اوزار ایندھن کے لیٔے اَور گیہُوں اناج کی نذر کے لیٔے بِلا قیمت دُوں گا۔“<verse eid="1CH 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24"/>لیکن داویؔد بادشاہ نے اُرنانؔ کو جَواب دیا، ”کہ نہیں، میں تو پُوری قیمت اَدا کرکے ہی رہُوں گا کیونکہ جو تمہارا ہے اُسے میں یَاہوِہ کے لیٔے ہرگز مُفت نہ لُوں گا۔ اَور نہ ہی اَیسی سوختنی نذر گذرانوں گا جِس پر میرا کچھ بھی خرچ نہ ہُوا ہو۔“<verse eid="1CH 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25"/>چنانچہ داویؔد نے اُرنانؔ کو اُس کھلیان کے لیٔے سات کِلو سونا دیا۔ <verse eid="1CH 21:25"/><verse number="26" style="v" sid="1CH 21:26"/>اَور داویؔد نے وہاں یَاہوِہ کے لیٔے مذبح بنایا اَور آتِشی قُربانیاں اَور سلامتی کی نذریں گذرانیں اَور اُنہُوں نے یَاہوِہ سے دعا کی اَور یَاہوِہ نے اُس کی دعا کے جَواب میں آسمان پر سے سوختنی نذر کی قُربانی کے مذبح پر آگ نازل فرمائی۔<verse eid="1CH 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27"/>اَور یَاہوِہ نے اُس فرشتہ کو حُکم دیا اَور اُس نے اَپنی تلوار پھر مِیان میں رکھ لی۔ <verse eid="1CH 21:27"/><verse number="28" style="v" sid="1CH 21:28"/>اُس وقت داویؔد نے یہ دیکھ کر کہ یَاہوِہ نے یبُوسی اُرنانؔ کے کھلیان ہی میں اُس کی دعا سُن لی ہے اُس نے وہیں قُربانی گذرانی۔ <verse eid="1CH 21:28"/><verse number="29" style="v" sid="1CH 21:29"/>کیونکہ اُس وقت یَاہوِہ کا مَسکن جسے مَوشہ نے بیابان میں بنایا تھا اَور سوختنی نذر کی قُربانی کا مذبح گِبعونؔ کی اُونچی جگہ پر تھا۔ <verse eid="1CH 21:29"/><verse number="30" style="v" sid="1CH 21:30"/>لیکن داویؔد خُدا کو سَجدہ کرنے کے لیٔے اُوپر نہ جا سکے کیونکہ وہ یَاہوِہ کے فرشتہ کی تلوار کے سبب سے خوفزدہ تھے۔<verse eid="1CH 21:30"/></para>
  <chapter eid="1CH 21"/>
  <chapter number="22" style="c" sid="1CH 22"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1"/>تَب داویؔد نے فرمایا، ”یہی یَاہوِہ خُدا کا بیت المُقدّس اَور اِسرائیل کی سوختنی نذر کی قُربانی کا مذبح ہے۔“<verse eid="1CH 22:1"/></para>
  <para style="s1">بیت المُقدّس کی تعمیر کے لیٔے تیّاریاں</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2"/>اَور داویؔد نے مُلک اِسرائیل میں رہنے والے پردیسیوں کو جمع کرنے کا حُکم دیا اَور اُن میں جتنے سنگ تراش تھے داویؔد نے اُنہیں خُدا کے گھر کی تعمیر کے لیٔے پتّھر تراشنے کے کام پر مُقرّر کیا۔ <verse eid="1CH 22:2"/><verse number="3" style="v" sid="1CH 22:3"/>اَور داویؔد نے دروازوں کے کواڑوں کی کیلوں اَور قبضوں کے لیٔے بہت سا لوہا فراہم کیا اَور کانسے بھی جِس کا وزن کرنا مُشکل تھا۔ <verse eid="1CH 22:3"/><verse number="4" style="v" sid="1CH 22:4"/>داویؔد نے دیودار کی بے شُمار لکڑی بھی فراہم کیں کیونکہ صیدونی اَور صُوری کثرت سے اُنہیں داویؔد کے پاس لاتے رہتے تھے۔<verse eid="1CH 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 22:5"/>اَور داویؔد نے کہا، ”میرا بیٹا شُلومونؔ کمسِن اَور ناتجربہ کار ہے اَور یَاہوِہ کے لیٔے تعمیر کیا جانے والا گھر نہایت ہی شاندار ہونا چاہئے تاکہ سَب ممالک میں اُس کی شہرت اَور نام ہو۔“ اِس لیٔے میں شُلومونؔ کے لیٔے سارا سامان تیّار رکھوں گا۔ چنانچہ داویؔد نے اَپنی وفات سے پیشتر خُوب تیّاری کی۔<verse eid="1CH 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6"/>تَب داویؔد نے اَپنے بیٹے شُلومونؔ کو بُلایا اَور یَاہوِہ، اِسرائیل کے خُدا کے لیٔے ایک گھر تعمیر کرنے کا کام اُس کے سُپرد کیا۔ <verse eid="1CH 22:6"/><verse number="7" style="v" sid="1CH 22:7"/>داویؔد نے شُلومونؔ سے فرمایا: ”میری دِلی تمنّا تھی کہ یَاہوِہ اَپنے خُدا کے نام کے لیٔے ایک گھر تعمیر کروں؛ <verse eid="1CH 22:7"/><verse number="8" style="v" sid="1CH 22:8"/>لیکن مُجھے یَاہوِہ کا یہ کلام پہُنچا، ’تُم نے بہت خُون بہایا ہے اَور بہت سِی جنگیں لڑی ہیں۔ اِس لیٔے تُم میرے نام کے لیٔے گھر نہ بنانا۔ تُم نے زمین پر میرے سامنے بہت خُونریزی کی ہے۔ <verse eid="1CH 22:8"/><verse number="9" style="v" sid="1CH 22:9"/>لیکن تمہارا بیٹا جو مَرد صُلح ہوگا اَور مَیں اُسے چاروں طرف کے دُشمنوں سے امان بخشوں گا۔ اُس کا نام شُلومونؔ<note caller="+" style="f"><char style="fr" closed="false">22‏:9 </char><char style="fq" closed="false">شُلومونؔ </char><char style="ft" closed="false">یعنی سلامتی سے مُناسبت</char></note> ہوگا اَور مَیں اُس کے دَورِ حُکومت میں اِسرائیل کو اَمن و سلامتی بخشوں گا۔ <verse eid="1CH 22:9"/><verse number="10" style="v" sid="1CH 22:10"/>اَور وُہی میرے نام کے لیٔے ایک گھر تعمیر کرےگا۔ وہ میرا بیٹا ہوگا اَور مَیں اُس کا باپ ہوں گا۔ اَور مَیں بنی اِسرائیل پر اُس کی بادشاہی کا تخت اَبد تک قائِم رکھوں گا۔‘<verse eid="1CH 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11"/>”اَب اَے میرے بیٹے، یَاہوِہ تمہارے ساتھ رہیں اَور تُم اِقبالمند ہو اَور یَاہوِہ اَپنے خُدا کا گھر بناؤ جَیسا کہ یَاہوِہ نے تمہارے حق میں فرمایاہے۔ <verse eid="1CH 22:11"/><verse number="12" style="v" sid="1CH 22:12"/>میری دعا ہے کہ یَاہوِہ تُمہیں شعور و فہم عطا کریں جَب وہ تُمہیں بنی اِسرائیل پر حُکمرانی بخشیں تاکہ تُم یَاہوِہ اَپنے خُدا کے آئین کے پابند رہو۔ <verse eid="1CH 22:12"/><verse number="13" style="v" sid="1CH 22:13"/>تَب تُم اِقبالمند ہوگے بشرطیکہ تُم اُن قوانین اَور آئین پرجو یَاہوِہ نے مَوشہ کو اِسرائیل کے لیٔے دئیے احتیاط کے ساتھ عَمل کرو۔ چنانچہ مضبُوط ہو جاؤ اَور حوصلہ رکھو اَور خوف نہ کرو اَور ہِراساں نہ ہو۔<verse eid="1CH 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14"/>”دیکھو مَیں نے بڑی محنت اَور کوشش سے یَاہوِہ کے بیت المُقدّس کے لیٔے تین ہزار چار سَو ٹن سونا، چونتیس ہزار ٹن چاندی اَور بے شُمار کانسے اَور لوہا جمع کر رکھا ہے۔ کیونکہ وہ کثرت سے ہیں اَور لکڑی اَور پتّھر بھی مَیں نے تیّار کئے ہیں اَور تُم اُنہیں اَور بڑھا سکتے ہو۔ <verse eid="1CH 22:14"/><verse number="15" style="v" sid="1CH 22:15"/>اَور تمہارے پاس بہت سے کاریگر مثلاً پتّھر کاٹنے والے، مِعمار، بڑھئی، نیز ہر قِسم کے ماہر فنکار مَوجُود ہیں۔ <verse eid="1CH 22:15"/><verse number="16" style="v" sid="1CH 22:16"/>سونا، چاندی، کانسے اَور لوہے میں بھی صنعت کاروں کی کثرت ہے۔ اَب اُٹھو اَور کام شروع کر دو اَور یَاہوِہ تمہارے ساتھ رہیں۔“<verse eid="1CH 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17"/>پھر داویؔد نے اِسرائیل کے سَب سرداروں کو اَپنے بیٹے شُلومونؔ کی مدد کرنے کا حُکم دیا۔ <verse eid="1CH 22:17"/><verse number="18" style="v" sid="1CH 22:18"/>اُس نے اُنہیں حُکم دیا، ”کیا یَاہوِہ تمہارے خُدا تمہارے ساتھ نہیں ہیں؟ اَور کیا اُنہُوں نے تُمہیں چاروں طرف سے آرام نہیں دیا ہے؟ کیونکہ یَاہوِہ نے اِس مُلک کے اصلی باشِندوں کو میرے ہاتھ میں کر دیا ہے اَور مُلک یَاہوِہ اَور اُن کے لوگوں کا محکُوم ہے۔ <verse eid="1CH 22:18"/><verse number="19" style="v" sid="1CH 22:19"/>چنانچہ اَب تُم دِل و جان سے یَاہوِہ اَپنے خُدا کی جُستُجو میں لگ جاؤ اَور یَاہوِہ خُدا کا پاک مَقدِس بنانا شروع کر دو تاکہ تُم یَاہوِہ کے عہد کے صندُوق کو اَور خُدا سے متعلّق پاک اَشیا کو اُس بیت المُقدّس میں لا سکو جو یَاہوِہ کے نام کے لیٔے تعمیر ہوگی۔“<verse eid="1CH 22:19"/></para>
  <chapter eid="1CH 22"/>
  <chapter number="23" style="c" sid="1CH 23"/>
  <para style="s1">بنی لیوی کی ذمّہ داریاں</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1"/>جَب داویؔد بُوڑھے اَور عمر رسیدہ ہو گئے تو اُنہُوں نے اَپنے بیٹے شُلومونؔ کو اِسرائیل کا بادشاہ مُقرّر کر دیا۔<verse eid="1CH 23:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2"/>داویؔد نے اِسرائیل کے تمام سرداروں، نیز کاہِنوں اَور لیویوں کو جمع کیا۔ <verse eid="1CH 23:2"/><verse number="3" style="v" sid="1CH 23:3"/>تیس بَرس اَور اُس سے زِیادہ عمر کے لیویوں کا شُمار کیا گیا تو وہ تعداد میں اڑتیس ہزار نکلے۔ <verse eid="1CH 23:3"/><verse number="4" style="v" sid="1CH 23:4"/>داویؔد نے فرمایا، ”اِن میں سے چوبیس ہزار یَاہوِہ کے بیت المُقدّس کے کام کی نِگرانی کریں گے اَور چھ ہزار اہلکار اَور مُنصِف ہوں گے، <verse eid="1CH 23:4"/><verse number="5" style="v" sid="1CH 23:5"/>اَور چار ہزار دربان ہوں گے اَور چار ہزار موسیقی کے اُن سازوں کے ساتھ جو مَیں نے مُہیّا کئے ہیں یَاہوِہ کی حَمد و ثنا کیا کریں گے۔“<verse eid="1CH 23:5"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="6" style="v" sid="1CH 23:6"/>اَور داویؔد نے اُنہیں لیوی کے بیٹوں گیرشون، قُہات اَور مِراریؔ کے ناموں سے گھرانوں میں تقسیم کیا۔<verse eid="1CH 23:6"/></para>
  <para style="s1">بنی گیرشون</para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 23:7"/>بنی گیرشون میں سے:</para>
  <para style="li2" vid="1CH 23:7">لعدانؔ اَور شِمعیؔ۔<verse eid="1CH 23:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 23:8"/>اَور لعدانؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 23:8">یحی ایل، زیتھامؔ اَور یُوایلؔ۔ کُل تین۔<verse eid="1CH 23:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 23:9"/>شِمعیؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 23:9">شلُوموتھؔ،<note caller="+" style="f"><char style="fr" closed="false">23‏:9 </char><char style="fq" closed="false">شلُوموتھؔ </char><char style="ft" closed="false">کچھ نُسخوں میں شلُومیتؔ بھی لِکھا ہے</char></note> حاضی ایل اَور حارانؔ، کُل تین</para>
  <para style="li2" vid="1CH 23:9">(یہ لعدانؔ کے آبائی خاندانوں کے سردار تھے۔)<verse eid="1CH 23:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 23:10"/>اَور شِمعیؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 23:10">یاحاتؔھ، زیزاؔ، یعُوسؔ اَور بریعہؔ۔</para>
  <para style="li2" vid="1CH 23:10">یہ چاروں شِمعیؔ کے بیٹے تھے۔<verse eid="1CH 23:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 23:11"/>(یاحاتؔھ پہلوٹھا تھا اَور زیزاؔ دُوسرا۔ لیکن یعُوسؔ اَور بریعہؔ کے بیٹے بہت نہ تھے۔ اِس لیٔے وہ ایک ہی آبائی خاندان میں گنے گیٔے جِن کے ذمّہ ایک ہی مُقرّرہ کام تھا۔)<verse eid="1CH 23:11"/></para>
  <para style="s1">بنی قُہات</para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 23:12"/>قُہات کے بیٹے:</para>
  <para style="li2" vid="1CH 23:12">عمرامؔ، اِضہاؔر، حِبرونؔ اَور عُزّی ايل۔ کُل چار۔<verse eid="1CH 23:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 23:13"/>عمرامؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 23:13">اَہرونؔ اَور مَوشہ۔</para>
  <para style="li2" vid="1CH 23:13">اَہرونؔ کو یہ اِعزاز دیا گیا کہ وہ اَور اُس کی نَسل اَبد تک پاک ترین مقام میں خدمت اَنجام دیں اَور یَاہوِہ کے آگے آتِشی قُربانیاں گزرانیں اَور بخُور جَلائیں اَور ہمیشہ اُن کا نام لے کر برکت دیں۔ <verse eid="1CH 23:13"/><verse number="14" style="v" sid="1CH 23:14"/>مَرد خُدا مَوشہ کے بیٹے لیوی کے قبیلہ میں شُمار کئے گیٔے۔<verse eid="1CH 23:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 23:15"/>مَوشہ کے بیٹے:</para>
  <para style="li2" vid="1CH 23:15">گیرشوم اَور الیعزرؔ۔<verse eid="1CH 23:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 23:16"/>گیرشوم کے بیٹے:</para>
  <para style="li2" vid="1CH 23:16">شُوبائیلؔ جو پہلوٹھا تھا۔<verse eid="1CH 23:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 23:17"/>الیعزرؔ کا بیٹا:</para>
  <para style="li2" vid="1CH 23:17">الیعزرؔ کا ایک ہی بیٹا رحابیّاہؔ تھا،</para>
  <para style="li2" vid="1CH 23:17">اُس کے علاوہ اُس کی اَور کوئی دُوسری اَولاد نہ تھی؛ لیکن رحابیّاہؔ کے بہت سے بیٹے پیدا ہُوئے۔<verse eid="1CH 23:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 23:18"/>اِضہاؔر کا بیٹا:</para>
  <para style="li2" vid="1CH 23:18">شلُومیتؔ جو خاندان کا سربراہ تھا۔<verse eid="1CH 23:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 23:19"/>حِبرونؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 23:19">یرِیاہؔ پہلوٹھا تھا، امریاہؔ دُوسرا،</para>
  <para style="li2" vid="1CH 23:19">یحزی ایل تیسرا اَور یُقمعامؔ چوتھا تھا۔<verse eid="1CH 23:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 23:20"/>عُزّی ايل کے بیٹے:</para>
  <para style="li2" vid="1CH 23:20">میکاہؔ پہلوٹھا تھا اَور یشیاہؔ دُوسرا۔<verse eid="1CH 23:20"/></para>
  <para style="s1">بنی مِراریؔ</para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 23:21"/>مِراریؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 23:21">محلیؔ اَور مُوشیؔ۔</para>
  <para style="li1" vid="1CH 23:21">محلیؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 23:21">الیعزرؔ اَور قیشؔ۔<verse eid="1CH 23:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 23:22"/>اَور الیعزرؔ کی وفات بغیر بیٹے کی ہی ہو گئی، اُس سے صِرف بیٹیاں پیدا ہُوئی تھیں۔ جِن کے چچازاد بھائیوں نے یعنی قیشؔ کے بیٹوں نے اُن سے شادیاں کر لیں۔<verse eid="1CH 23:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 23:23"/>مُوشیؔ کے تین بیٹے پیدا ہُوئے:</para>
  <para style="li2" vid="1CH 23:23">محلیؔ، عیدرؔ اَور یریموتؔ۔<verse eid="1CH 23:23"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="24" style="v" sid="1CH 23:24"/>لیوی کے بیٹے اَپنے اَپنے آبائی خاندانوں کے مُطابق یہی تھے یعنی آبائی خاندانوں کے سربراہوں کے طور پر اَپنے اَپنے ناموں کے تحت فرداً فرداً درج فہرست کئے گیٔے تھے۔ بیس بَرس یا اُس سے زِیادہ عمر کے یہی تھے جنہوں نے یَاہوِہ کے بیت المُقدّس میں خدمت کے کام کئے تھے۔ <verse eid="1CH 23:24"/><verse number="25" style="v" sid="1CH 23:25"/>کیونکہ داویؔد نے خیال کیا تھا، ”چونکہ یَاہوِہ اِسرائیل کے خُدا نے اَپنے لوگوں کو آرام بخشا ہے اَور وہ اَبد تک یروشلیمؔ میں سکونت کریں گے، <verse eid="1CH 23:25"/><verse number="26" style="v" sid="1CH 23:26"/>اَور آئندہ لیویوں کو بھی یَاہوِہ کے عہد کے صندُوق کو اَور اُس کے لیٔے وقف شُدہ ظروف کو اُٹھائے پھرنے کی خدمت نہ ہوگی۔“ <verse eid="1CH 23:26"/><verse number="27" style="v" sid="1CH 23:27"/>داویؔد کی سابقہ ہدایات کے مُطابق بیس بَرس اَور اُس سے زِیادہ عمر کے لیویوں کی مردُم شماری کی گئی تھی۔<verse eid="1CH 23:27"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="28" style="v" sid="1CH 23:28"/>لیویوں کا کام یہ تھا کہ وہ یَاہوِہ کے بیت المُقدّس میں اَہرونؔ کی نَسل کی مُختلف خدمات میں مدد کرنا۔ صحنوں اَور حُجروں کی نِگرانی میں، تمام مُقدّس برتنوں اَور اَشیا کو صَاف سُتھرا رکھنے میں اَور خُدا کے گھر کے دیگر فرائض کے کاموں میں اُن کی مدد کرنا شامل تھا۔ <verse eid="1CH 23:28"/><verse number="29" style="v" sid="1CH 23:29"/>اَور اِن کے علاوہ اُن کی جَوابدہی نذر کی روٹیاں، مَیدہ کے اناج کی نذر کی قُربانی، بے خمیری روٹیوں، توے پر پکی ہُوئی گول روٹیاں یا تلی ہُوئی چیزوں کی دیکھ بھال کرنا، اَور سَب کی تول اَور تمام پیمانوں کی نِگرانی کرنا۔ <verse eid="1CH 23:29"/><verse number="30" style="v" sid="1CH 23:30"/>اَور اُن کا یہ بھی فرض تھا کہ ہر صُبح و شام کھڑے ہوکر یَاہوِہ کی شُکر گزاری اَور سِتائش کریں <verse eid="1CH 23:30"/><verse number="31" style="v" sid="1CH 23:31"/>اَور سَبتوں، نئے چاند کی عیدوں اَور مُقرّرہ اِجتماعات میں کھڑے ہوکر یَاہوِہ کی شُکر گزاری اَور سِتائش کریں گے اَور ہمیشہ یَاہوِہ کی حُضُور پُوری تعداد میں سَب سوختنی نذریں گزرانیں جو اُس قائد کے مُطابق ہیں عَمل کریں۔<verse eid="1CH 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 23:32"/>اَور یُوں بنی لیوی اَپنے بھائیوں بنی اَہرونؔ کے ماتحت یَاہوِہ کے بیت المُقدّس میں خیمہ اِجتماع کی حِفاظت اَور پاک مقام کے ظروف کی نِگرانی کی خدمات اَنجام دیتے رہیں۔<verse eid="1CH 23:32"/></para>
  <chapter eid="1CH 23"/>
  <chapter number="24" style="c" sid="1CH 24"/>
  <para style="s1">کاہِنوں کی تقسیم</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1"/>اَور بنی اَہرونؔ کے فریق یہ تھے:</para>
  <para style="p" vid="1CH 24:1">اَہرونؔ کی اَولاد نادابؔ، اَبِیہُو، الیعزرؔ اَور اِتمارؔ۔ <verse eid="1CH 24:1"/><verse number="2" style="v" sid="1CH 24:2"/>لیکن نادابؔ اَور اَبِیہُو اَپنے باپ کے سامنے ہی مَر گیٔے اَور اُن کی اَولاد نہ تھی۔ لہٰذا الیعزرؔ اَور اِتمارؔ نے کہانت کے فرائض اَنجام دئیے۔ <verse eid="1CH 24:2"/><verse number="3" style="v" sid="1CH 24:3"/>الیعزرؔ کی اَولاد میں سے صدُوقؔ اَور اِتمارؔ کی اَولاد میں سے احِیملکؔ کی مدد سے داویؔد نے کاہِنوں کو اُن کی خدمت کی ترتیب کے مُطابق تقسیم کیا۔ <verse eid="1CH 24:3"/><verse number="4" style="v" sid="1CH 24:4"/>اَور اِتمارؔ کی اَولاد کی بہ نِسبت الیعزرؔ کی اَولاد میں قائد زِیادہ پایٔے گیٔے لہٰذا اُن کی تقسیم بھی اُسی نِسبت سے ہُوئی یعنی الیعزرؔ کی اَولاد میں سے آبائی خاندانوں کے سربراہ سولہ تھے اَور اِتمارؔ کی اَولاد میں سے آبائی خاندانوں کے سربراہ آٹھ تھے۔ <verse eid="1CH 24:4"/><verse number="5" style="v" sid="1CH 24:5"/>اَور اُنہُوں نے غَیر جانِبداری سے قُرعہ ڈال کر اُنہیں تقسیم کیا کیونکہ پاک مَقدِس کے اہلکاروں اَور خُدا کے سرداروں کی زِیادہ تعداد الیعزرؔ اَور اِتمارؔ دونوں کی اَولاد میں سے تھی۔<verse eid="1CH 24:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6"/>اَور نتنی ایل مُنشی کے بیٹے شمعیاہؔ نے جو لیویوں میں سے تھا بادشاہ اَور منصبداروں، صدُوقؔ کاہِنؔ، احِیملکؔ بِن ابیاترؔ اَور کاہِنوں اَور لیویوں کے آبائی خاندانوں کے سربراہوں کی مَوجُودگی میں اُن کے نام لکھے یعنی جَب الیعزرؔ کے ایک آبائی خاندان میں سے کویٔی نام لِکھّا جاتا تھا تو اِتمارؔ کے ایک آبائی خاندان سے بھی ایک نام لِکھّا جاتا تھا۔<verse eid="1CH 24:6"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 24:7"/>پہلا قُرعہ یہُویرِیبؔ کے نام کا نِکلا،</para>
  <para style="li1" vid="1CH 24:7">دُوسرا یدعیاہؔ کے نام کا،<verse eid="1CH 24:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 24:8"/>تیسرا حارِمؔ کا،</para>
  <para style="li1" vid="1CH 24:8">چوتھا سعوریمؔ کا،<verse eid="1CH 24:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 24:9"/>پانچواں ملکیاہؔ کا،</para>
  <para style="li1" vid="1CH 24:9">چھٹا مِیامِینؔ کا،<verse eid="1CH 24:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 24:10"/>ساتواں حقوضؔ کا،</para>
  <para style="li1" vid="1CH 24:10">آٹھواں ابیّاہؔ کا،<verse eid="1CH 24:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 24:11"/>نواں یہوشُعؔ کا،</para>
  <para style="li1" vid="1CH 24:11">دسواں شِکنیاہؔ کا،<verse eid="1CH 24:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 24:12"/>گیارہواں اِلیاشبؔ کا،</para>
  <para style="li1" vid="1CH 24:12">بارہواں یاقیمؔ کا،<verse eid="1CH 24:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 24:13"/>تیرہواں حُپّاہؔ کا،</para>
  <para style="li1" vid="1CH 24:13">چودہواں یشِبیابؔ کا،<verse eid="1CH 24:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 24:14"/>پندرہواں بِلگاہؔ کا،</para>
  <para style="li1" vid="1CH 24:14">سولہواں اِمّیرؔ کا،<verse eid="1CH 24:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 24:15"/>سترہواں حزیرؔ کا،</para>
  <para style="li1" vid="1CH 24:15">اٹھّارہواں حَفّضِیض کا،<verse eid="1CH 24:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 24:16"/>اُنّیسواں پِتھائیاہؔ کا،</para>
  <para style="li1" vid="1CH 24:16">بیسواں حزقی ایل کا،<verse eid="1CH 24:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 24:17"/>اِکیّسواں یاکِن کا،</para>
  <para style="li1" vid="1CH 24:17">بائیسواں گمولؔ کا،<verse eid="1CH 24:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 24:18"/>تئیسواں دِلائیاہؔ کا،</para>
  <para style="li1" vid="1CH 24:18">چوبیسواں معزیاہؔ کا۔<verse eid="1CH 24:18"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19"/>وہ یَاہوِہ کے بیت المُقدّس میں خدمت کے لیٔے اُس ترتیب کے مُطابق داخل ہوتے تھے جو اُن قوانین پر مَبنی تھی جنہیں اُن کے آباؤاَجداد اَہرونؔ نے اُن کے لیٔے مُقرّر کیا تھا ہُوبہو جَیسا کہ یَاہوِہ، اِسرائیل کے خُدا نے اُنہیں حُکم دیا تھا۔<verse eid="1CH 24:19"/></para>
  <para style="s1">باقی ماندہ بنی لیوی</para>
  <para style="lh">
    <verse number="20" style="v" sid="1CH 24:20"/>بقیّہ بنی لیوی کی تقسیم:</para>
  <para style="b" vid="1CH 24:20"/>
  <para style="li1" vid="1CH 24:20">عمرامؔ کے بیٹوں میں سے شُوبائیلؔ؛</para>
  <para style="li2" vid="1CH 24:20">شُوبائیلؔ کے بیٹوں میں سے یہدِیاہؔ۔<verse eid="1CH 24:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 24:21"/>رحابیّاہؔ کے بیٹوں میں پہلوٹھا یشیاہؔ تھا۔<verse eid="1CH 24:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 24:22"/>اِضہاریوں میں شلُوموتھؔ؛</para>
  <para style="li2" vid="1CH 24:22">اَور شلُوموتھؔ کے بیٹوں میں سے یاحاتؔھ۔<verse eid="1CH 24:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 24:23"/>اَور بنی حِبرونؔ میں سے:</para>
  <para style="li2" vid="1CH 24:23">یرِیاہؔ پہلا تھا، امریاہؔ دُوسرا، یحزی ایل تیسرا اَور یُقمعامؔ چوتھا تھا۔<verse eid="1CH 24:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 24:24"/>بنی عُزّی ايل میں سے: میکاہؔ؛</para>
  <para style="li2" vid="1CH 24:24">بنی میکاہؔ میں سے: شمیرؔ۔<verse eid="1CH 24:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 24:25"/>میکاہؔ کا بھایٔی: یشیاہؔ؛</para>
  <para style="li2" vid="1CH 24:25">بنی یشیاہؔ میں سے زکریاؔہ۔<verse eid="1CH 24:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 24:26"/>مِراریؔ کے بیٹے: محلیؔ اَور مُوشیؔ؛</para>
  <para style="li2" vid="1CH 24:26">یعزیاہؔ کا بیٹا: بِنُوؔ۔<verse eid="1CH 24:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 24:27"/>بنی مِراریؔ: یعزیاہؔ سے:</para>
  <para style="li2" vid="1CH 24:27">بِنُوؔ، شوہامؔ، زکُورؔ اَور عِبری۔<verse eid="1CH 24:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 24:28"/>محلیؔ سے: الیعزرؔ، جِس کا کویٔی بیٹا نہ تھا۔<verse eid="1CH 24:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 24:29"/>قیشؔ سے: قیشؔ کا بیٹا: یرحمئیلؔ۔<verse eid="1CH 24:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 24:30"/>اَور مُوشیؔ کے بیٹے: محلیؔ، عیدرؔ اَور یریموتؔ۔</para>
  <para style="b" vid="1CH 24:30"/>
  <para style="lf" vid="1CH 24:30">اَور بنی لیوی اَپنے آبائی خاندانوں کے مُطابق یہی تھے۔<verse eid="1CH 24:30"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="31" style="v" sid="1CH 24:31"/>اُنہُوں نے بھی اَپنے بھائیوں بنی اَہرونؔ کی طرح داویؔد بادشاہ اَور صدُوقؔ، احِیملکؔ اَور کاہِنوں اَور لیویوں کے آبائی خاندانوں کے سربراہوں کی مَوجُودگی میں اَپنا اَپنا قُرعہ ڈالا اَورجو حق آبائی خاندانوں کے سرداروں کا تھا وُہی حق اُن کے سَب سے چُھوٹے بھائیوں کے خاندانوں کا بھی تھا۔<verse eid="1CH 24:31"/></para>
  <chapter eid="1CH 24"/>
  <chapter number="25" style="c" sid="1CH 25"/>
  <para style="s1">موسیقار</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1"/>پھر داویؔد اَور فَوج کے سپہ سالاروں نے آسفؔ، ہیمانؔ اَور یدُوتونؔ کے بیٹوں میں سے بعضوں کو اِس خدمت کے لیٔے الگ کیا تاکہ وہ بربط، سِتار اَور جھانجھ کے ساتھ نبُوّت کریں۔ اَور جِن اَشخاص کو اِس خدمت کی مُختلف ذمّہ داریاں سُپرد کی گئیں وہ یہ ہیں،<verse eid="1CH 25:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 25:2"/>بنی آسفؔ میں سے:</para>
  <para style="li2" vid="1CH 25:2">زکُورؔ، یُوسیفؔ، نتنیاہؔ اَور آساریلاہؔ۔ آسفؔ کے یہ بیٹے اَپنے والد کی رہنمائی میں خدمت کرتے تھے اَور بادشاہ کی نِگرانی میں نبُوّت کرتے تھے۔<verse eid="1CH 25:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 25:3"/>بنی یدُوتونؔ میں سے:</para>
  <para style="li2" vid="1CH 25:3">گِدلیاہؔ، ضریؔ، یَشعیاہ، شِمعیؔ، حشبیاہؔ اَور متّتیاہؔ، یہ چھ اَپنے باپ یدُوتونؔ کے ماتحت تھے جو یَاہوِہ کی شُکر گزاری اَور حَمد میں بربط بجاتے ہُوئے نبُوّت کیا کرتے تھے۔<verse eid="1CH 25:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 25:4"/>اَور بنی ہیمانؔ میں سے:</para>
  <para style="li2" vid="1CH 25:4">بُقیّاہؔ، متّنیاہؔ، عُزّی ایل، شُوبائیلؔ، یریموتؔ، حننیاہؔ، حنانیؔ، اِلیاتھاہ، گدّالتیؔ، رومامتی عزرؔ، یُسبِقاشہؔ، ملُّوتیؔ، ہوتِیرؔ اَور محازیوتؔ۔ <verse eid="1CH 25:4"/><verse number="5" style="v" sid="1CH 25:5"/>یہ سَب بادشاہ کے غیب بین ہیمانؔ کے بیٹے تھے اَورجو نبُوّت کے ذریعہ یَاہوِہ کی تمجید کیا کرتے تھے۔ اَور خُدا کے وعدے کے مُطابق ہیمانؔ کو چودہ بیٹے اَور تین بیٹیاں ہُوئیں۔<verse eid="1CH 25:5"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="6" style="v" sid="1CH 25:6"/>یہ تمام یَاہوِہ کے بیت المُقدّس میں جھانجھ، سِتار اَور بربط کے ساتھ موسیقی کے لیٔے اَور خُدا کے گھر میں خدمت کے لیٔے اَپنے اَپنے باپ کے ماتحت تھے اَور آسفؔ، یدُوتونؔ اَور ہیمانؔ بادشاہ کے ماتحت تھے۔<verse eid="1CH 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 25:7"/>اَور اِن سَب کی تعداد جو یَاہوِہ کے لیٔے فن موسیقی میں ماہر تھے اَپنے رشتہ داروں کے ساتھ مِلا کر دو سَو اٹھاسی تھی۔ <verse eid="1CH 25:7"/><verse number="8" style="v" sid="1CH 25:8"/>اَور اُنہُوں نے چُھوٹے، بڑے اَور اُستاد، شاگرد کا اِمتیاز کئے بغیر ایک ہی طریقہ سے اَپنے اَپنے فرائض کے لیٔے قُرعہ ڈالا۔<verse eid="1CH 25:8"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 25:9"/>پہلا قُرعہ بنی آسفؔ کے نام کا تھا، جو یُوسیفؔ کے بیٹے اَور اُس کے رشتہ داروں کے لئے تھا جِن کی کُل تعداد بَارہ تھی۔</para>
  <para style="li1" vid="1CH 25:9">دُوسرا قُرعہ گِدلیاہؔ اَور اُس کے بَارہ بیٹوں اَور رشتہ داروں کے نام کا تھا۔<verse eid="1CH 25:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 25:10"/>تیسرا قُرعہ زکُورؔ اَور اُس کے بَارہ بیٹوں اَور رشتہ داروں کے نام کا تھا۔<verse eid="1CH 25:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 25:11"/>چوتھا قُرعہ یضریؔ کے،</para>
  <para style="li2" vid="1CH 25:11">اَور اُس کے بَارہ بیٹوں اَور رشتہ داروں کے نام کا تھا۔<verse eid="1CH 25:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 25:12"/>پانچواں نتنیاہؔ اَور اُس کے بَارہ بیٹوں اَور رشتہ داروں کے نام کا تھا۔<verse eid="1CH 25:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 25:13"/>چھٹا بُقیّاہؔ اَور اُس کے بَارہ بیٹوں اَور رشتہ داروں کے نام کا تھا۔<verse eid="1CH 25:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 25:14"/>ساتواں یساریلاہؔ اَور اُس کے بَارہ بیٹوں اَور رشتہ داروں کے نام کا تھا۔<verse eid="1CH 25:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 25:15"/>آٹھواں یِشعیہ اَور اُس کے بَارہ بیٹوں اَور رشتہ داروں کے نام کا تھا۔<verse eid="1CH 25:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 25:16"/>نواں متّنیاہؔ اَور اُس کے بَارہ بیٹوں اَور رشتہ داروں کے نام کا تھا۔<verse eid="1CH 25:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 25:17"/>دسواں شِمعیؔ اَور اُس کے بَارہ بیٹوں اَور رشتہ داروں کے نام کا تھا۔<verse eid="1CH 25:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 25:18"/>گیارھواں عزرایلؔ اَور اُس کے بَارہ بیٹوں اَور رشتہ داروں کے نام کا تھا۔<verse eid="1CH 25:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 25:19"/>بارھواں حشبیاہؔ اَور اُس کے بَارہ بیٹوں اَور رشتہ داروں کے نام کا تھا۔<verse eid="1CH 25:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 25:20"/>تیرہواں شُوبائیلؔ اَور اُس کے بَارہ بیٹوں اَور رشتہ داروں کے نام کا تھا۔<verse eid="1CH 25:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 25:21"/>چودھواں متّتیاہؔ اَور اُس کے بَارہ بیٹوں اَور رشتہ داروں کے نام کا تھا۔<verse eid="1CH 25:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 25:22"/>پندرھواں یریموتؔ اَور اُس کے بَارہ بیٹوں اَور رشتہ داروں کے نام کا تھا۔<verse eid="1CH 25:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 25:23"/>سولہواں حننیاہؔ اَور اُس کے بَارہ بیٹوں اَور رشتہ داروں کے نام کا تھا۔<verse eid="1CH 25:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 25:24"/>سترھواں یُسبِقاشہؔ اَور اُس کے بَارہ بیٹوں اَور رشتہ داروں کے نام کا تھا۔<verse eid="1CH 25:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 25:25"/>اٹھّارہواں حنانیؔ اَور اُس کے بَارہ بیٹوں اَور رشتہ داروں کے نام کا تھا۔<verse eid="1CH 25:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 25:26"/>اُنّیسواں ملُّوتیؔ اَور اُس کے بَارہ بیٹوں اَور رشتہ داروں کے نام کا تھا۔<verse eid="1CH 25:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 25:27"/>بیسواں اِلیاتھاہ اَور اُس کے بَارہ بیٹوں اَور رشتہ داروں کے نام کا تھا۔<verse eid="1CH 25:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 25:28"/>اِکیّسواں ہوتِیرؔ اَور اُس کے بَارہ بیٹوں اَور رشتہ داروں کے نام کا تھا۔<verse eid="1CH 25:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 25:29"/>بائیسواں گدّالتیؔ اَور اُس کے بَارہ بیٹوں اَور رشتہ داروں کے نام کا تھا۔<verse eid="1CH 25:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 25:30"/>تئیسواں محازیوتؔ اَور اُس کے بَارہ بیٹوں اَور رشتہ داروں کے نام کا تھا۔<verse eid="1CH 25:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 25:31"/>چوبیسواں رومامتی عزرؔ اَور اُس کے بَارہ بیٹوں اَور رشتہ داروں کے نام کا تھا۔<verse eid="1CH 25:31"/></para>
  <chapter eid="1CH 25"/>
  <chapter number="26" style="c" sid="1CH 26"/>
  <para style="s1">دربان</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 26:1"/>دربانوں کی تقسیم:</para>
  <para style="b" vid="1CH 26:1"/>
  <para style="lh" vid="1CH 26:1">بنی قورحؔ میں سے:</para>
  <para style="li1" vid="1CH 26:1">مِشلمیاہؔ بِن قورؔے جو بنی آسفؔ میں سے تھا۔ <verse eid="1CH 26:1"/><verse number="2" style="v" sid="1CH 26:2"/>اَور بِن مِشلمیاہؔ میں سے:</para>
  <para style="li2" vid="1CH 26:2">زکریاؔہ، پہلا؛ یدیع ایل، دُوسرا؛</para>
  <para style="li2" vid="1CH 26:2">زبدیاہؔ، تیسرا؛ یتنی ایل، چوتھا؛<verse eid="1CH 26:2"/></para>
  <para style="li2">
    <verse number="3" style="v" sid="1CH 26:3"/>عیلامؔ، پانچواں؛ یِہُوحنانؔ، چھٹا</para>
  <para style="li2" vid="1CH 26:3">اَور الِیہُوعنائی ساتواں۔<verse eid="1CH 26:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 26:4"/>اَور بنی عوبیدؔ اِدُوم میں سے:</para>
  <para style="li2" vid="1CH 26:4">شمعیاہؔ، پہلا؛ یہُوزبادؔ، دُوسرا؛</para>
  <para style="li2" vid="1CH 26:4">یُوآخؔ، تیسرا؛ سکارؔ، چوتھا؛</para>
  <para style="li2" vid="1CH 26:4">نتنی ایل، پانچواں؛ <verse eid="1CH 26:4"/><verse number="5" style="v" sid="1CH 26:5"/>عمّی ایل، چھٹا؛</para>
  <para style="li2" vid="1CH 26:5">اِشکارؔ، ساتواں؛ پیعُلّتائیؔ آٹھواں:</para>
  <para style="li2" vid="1CH 26:5">کیونکہ خُدا نے عوبیدؔ اِدُوم کو برکت بخشی تھی۔<verse eid="1CH 26:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 26:6"/>اَور اُس کے بیٹے شمعیاہؔ کے ہاں بھی بیٹے پیدا ہُوئے جو اَپنے آبائی خاندان میں سربراہ سمجھے جاتے تھے کیونکہ وہ نہایت لائق اِنسان تھے۔ <verse eid="1CH 26:6"/><verse number="7" style="v" sid="1CH 26:7"/>شمعیاہؔ کے بیٹے:</para>
  <para style="li2" vid="1CH 26:7">عُتنیؔ، رِفاایل، عوبیدؔ اَور اِلزبادؔ؛</para>
  <para style="li2" vid="1CH 26:7">اَور اُن کے رشتہ دار اِلیہُوؔ اَور سمکیاہؔ بھی بڑے طاقتور تھے۔<verse eid="1CH 26:7"/></para>
  <para style="lf">
    <verse number="8" style="v" sid="1CH 26:8"/>یہ سَب عوبیدؔ اِدُوم کی اَولاد میں سے تھے؛ اَور وہ اُن کے بیٹے اَور رشتہ دار بڑے طاقتور تھے اَور خدمت کرنے کے لئے لائق اِنسان تھے۔ یُوں کل بنی عوبیدؔ اِدُوم باسٹھ تھے۔<verse eid="1CH 26:8"/></para>
  <para style="lf">
    <verse number="9" style="v" sid="1CH 26:9"/>مِشلمیاہؔ کے بیٹے اَور رشتہ دار جو بڑے طاقتور تھے، اُن کی کُل تعداد اٹھّارہ تھی۔<verse eid="1CH 26:9"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 26:10"/>اَور بنی مِراریؔ میں سے حوساہؔ کے ہاں بیٹے تھے:</para>
  <para style="li2" vid="1CH 26:10">جِن میں شِمریؔ کا ایک پہلا درجہ تھا (حالانکہ وہ پہلوٹھا نہ تھا اُس کے باپ نے اُسے پہلوٹھا مُقرّر کیا تھا)،<verse eid="1CH 26:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 26:11"/>خِلقیاہؔ، دُوسرا؛ طبلیاہؔ، تیسرا؛</para>
  <para style="li2" vid="1CH 26:11">اَور زکریاؔہ، چوتھا تھا۔</para>
  <para style="lf" vid="1CH 26:11">حوساہؔ کے سَب بیٹے اَور رشتہ دار شُمار میں تیرہ تھے۔<verse eid="1CH 26:11"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="12" style="v" sid="1CH 26:12"/>دربانوں کے یہ فریق اَپنے بھائیوں کی طرح اَپنے سرداروں کی رہنمائی میں یَاہوِہ کے بیت المُقدّس میں خدمت کرنے کے فرائض اَدا کرتے تھے۔ <verse eid="1CH 26:12"/><verse number="13" style="v" sid="1CH 26:13"/>اَور اُنہُوں نے کیا چُھوٹے کیا ضعیف اَپنے اَپنے آبائی خاندانوں کے مُطابق بغیر کسی اِمتیاز کے یہ مَعلُوم کرنے کے لئے قُرعہ ڈالا کہ اُنہیں کس پھاٹک پر خدمت کرنی ہے۔<verse eid="1CH 26:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 26:14"/>اَور قُرعہ کے ذریعے مشرقی پھاٹک کی ذمّہ داری شلمیہؔ کے نام نکلی۔</para>
  <para style="li2" vid="1CH 26:14">پھر اُس کے بیٹے زکریاؔہ کے لیٔے بھی جو ایک دانشمند مُشیر تھا قُرعہ کے ذریعے شمالی پھاٹک کے لیٔے کی ذمّہ داری نکلی۔<verse eid="1CH 26:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 26:15"/>جُنوبی پھاٹک کے لیٔے قُرعہ عوبیدؔ اِدُوم کے نام نِکلا اَور مخزن کے لیٔے قُرعہ کے ذریعہ ذمّہ داری اُس کے بیٹوں کے نام نکلی۔<verse eid="1CH 26:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 26:16"/>پھر قُرعہ شُپّیمؔ اَور حوساہؔ کے نام مغربی پھاٹک کے لئے ذمّہ داری نکلی کہ وہ شلِّکتؔ پھاٹک کے پاس چڑھائی کی سڑک پر،</para>
  <para style="lh" vid="1CH 26:16">آمنے سامنے نِگرانی کیا کریں۔<verse eid="1CH 26:16"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 26:17"/>مشرق کی طرف روزانہ چھ لیوی تھے،</para>
  <para style="li1" vid="1CH 26:17">شمال کی طرف روزانہ چار،</para>
  <para style="li1" vid="1CH 26:17">جُنوب کی طرف روزانہ چار،</para>
  <para style="li1" vid="1CH 26:17">اَور مخزن پر ہر وقت دو مُقرّر تھے۔<verse eid="1CH 26:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 26:18"/>اَور مغرب کے پھاٹک کی طرف جدھر صحن تھا اُس کے اَندر دو اَور باہر سڑک پر چار تھے۔<verse eid="1CH 26:18"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="19" style="v" sid="1CH 26:19"/>یہ دربانوں کے فریق تھے جو بنی قورحؔ اَور بنی مِراریؔ تھے۔<verse eid="1CH 26:19"/></para>
  <para style="s1">خزانوں کے نِگران اَور دیگر منصبدار</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20"/>بنی لیوی میں سے اخیاہؔ خُدا کے گھر کے خزانوں اَور مخصُوص اَشیا کے خزانوں کا مختار تھا۔<verse eid="1CH 26:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 26:21"/>اَور بنی لعدانؔ میں سے یہ تھے یعنی اُن گیرشون کی اَولاد تھے جو لعدانؔ کے نَسل سے تھے یعنی لعدانؔ اَور گیرشون کے آبائی خاندانوں کے سربراہ تھے جِن میں سے ایک یحی ایلی تھا۔ <verse eid="1CH 26:21"/><verse number="22" style="v" sid="1CH 26:22"/>یحی ایلی کے بیٹے زیتھامؔ اَور اِس کا بھایٔی یُوایلؔ۔ وہ یَاہوِہ کے بیت المُقدّس کے خزانوں کے مختار تھے۔<verse eid="1CH 26:22"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="23" style="v" sid="1CH 26:23"/>عمرامیوں، اِضہاریوں، حِبرونیوں اَور عُزّی ایلیوں میں سے:<verse eid="1CH 26:23"/></para>
  <para style="b"/>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 26:24"/>بنی شُوبائیلؔ سے گیرشوم بِن مَوشہ خزانوں پر مختار تھا۔ <verse eid="1CH 26:24"/><verse number="25" style="v" sid="1CH 26:25"/>اَور اُس کے رشتہ دار الیعزرؔ کی جانِب سے اُس کا بیٹا رحابیّاہؔ اَور اُس کا بیٹا یَشعیاہ اَور اُس کا بیٹا یُورامؔ اَور اُس کا بیٹا زکریؔ اَور اُس کا بیٹا شلُومیتؔ۔<verse eid="1CH 26:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 26:26"/>شلُومیتؔ اَور اُس کے رشتہ دار اُن تمام اَشیا کے خزانوں کے مختار تھے جو داویؔد بادشاہ نے اَور آبائی خاندانوں کے اُن سربراہوں نے جو ہزاروں اَور سینکڑوں فَوجی دستوں کے اعلیٰ سرداروں اَور دیگر سپہ سالاروں نے نذر کی تھیں۔ <verse eid="1CH 26:26"/><verse number="27" style="v" sid="1CH 26:27"/>اُنہُوں نے مالِ غنیمت میں سے کچھ حِصّہ بچا کر یَاہوِہ کے بیت المُقدّس کی مرمّت کے لیٔے وقف کیا تھا۔ <verse eid="1CH 26:27"/><verse number="28" style="v" sid="1CH 26:28"/>اَورجو کچھ شموایلؔ غیب بین اَور شاؤل بِن قیشؔ، ابنیرؔ بِن نیرؔ اَور یُوآبؔ بِن ضرویاہؔ نے مخصُوص کیا تھا اَور دُوسری تمام مخصُوص اَشیا شلُومیتؔ اَور اُس کے رشتہ داروں کی نِگرانی میں تھیں۔<verse eid="1CH 26:28"/></para>
  <para style="li2">
    <verse number="29" style="v" sid="1CH 26:29"/>اَور اِضہاریوں میں سے:</para>
  <para style="li2" vid="1CH 26:29">قنانیاہؔ اَور اُس کے بیٹوں کو بیت المُقدّس سے باہر اِسرائیل پر حاکموں اَور قاضیوں کے فرائض اَنجام دینے کے لیٔے مُقرّر کیا گیا۔<verse eid="1CH 26:29"/></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 26:30"/>حِبرونیوں میں سے:</para>
  <para style="li2" vid="1CH 26:30">حشبیاہؔ اَور اُس کے رشتہ دار جو ایک ہزار سات سَو بہادر مَرد تھے یردنؔ کے پار مغرب کی طرف اِسرائیلیوں پر مُقرّر کئے گیٔے تاکہ وہ یَاہوِہ کے سَب کام اَور بادشاہ کی خدمت اَنجام دیں۔ <verse eid="1CH 26:30"/><verse number="31" style="v" sid="1CH 26:31"/>حِبرونیوں میں سے: اُن کے آبائی خاندانوں کے نَسب ناموں کے دستاویزوں کے مُطابق یرِیاہؔ اُن کا سردار تھا۔</para>
  <para style="li2" vid="1CH 26:31">داویؔد کے دَورِ حُکومت کے چالیسویں بَرس میں اِن دستاویزوں کے مُطابق مَعلُوم ہُوا کہ گِلعادؔ میں یعزیرؔ کے مقام پر حِبرونیوں میں کیٔی لائق اِنسان مَوجُود ہیں۔ <verse eid="1CH 26:31"/><verse number="32" style="v" sid="1CH 26:32"/>یرِیاہؔ کے دو ہزار سات سَو رشتہ دار تھے جو بڑے دِلیر اَور آبائی خاندانوں کے سربراہ تھے اَور داویؔد بادشاہ نے اُنہیں رُوبِنیوں، گادیوں اَور منشّہ کے آدھے قبیلہ پر خُدا کے سارے کاموں اَور شاہی مُعاملات کا مختار مُقرّر کر دیا تھا۔<verse eid="1CH 26:32"/></para>
  <chapter eid="1CH 26"/>
  <chapter number="27" style="c" sid="1CH 27"/>
  <para style="s1">فَوج کی تقسیم</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 27:1"/>یہ فہرست اِسرائیلیوں کی ہے یعنی آبائی خاندانوں کے سربراہوں، ہزاروں اَور سینکڑوں کے سپہ سالاروں اَور اُن کے افسران کی ہے جو سال بھر اَپنی ماہانہ باری کے مُطابق آتے جاتے رہتے تھے اَور فَوجی دستوں سے متعلّق تمام اُمور میں بادشاہ کی خدمت کرتے تھے۔ ہر دستہ چوبیس ہزار جَوانوں پر مُشتمل تھا۔<verse eid="1CH 27:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 27:2"/>یسُوبعامؔ بِن زبدیؔ ایل پہلے دستہ کا سربراہ تھا جسے پہلے مہینے میں خدمت کی ذمّہ داری سُپرد کی گئی تھی، اُس کے دستے میں چوبیس ہزار فَوجی تھے۔ <verse eid="1CH 27:2"/><verse number="3" style="v" sid="1CH 27:3"/>وہ بنی پیریزؔ کے خاندان سے تھا اَور پہلے مہینے کے لیٔے تمام فَوج کے افسروں کا اعلیٰ افسر تھا۔<verse eid="1CH 27:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 27:4"/>احُوحی دودائی دُوسرے مہینے کے لئے مُقرّر فَوجی دستے کا سپہ سالار تھا؛ اَور مِقلوتؔ اُس کے تابع تھا جو اُس کا ایک اہم افسر تھا۔ اُس کے دستے میں چوبیس ہزار فَوجی تھے۔<verse eid="1CH 27:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 27:5"/>تیسرے مہینے کے لیٔے تیسرا فَوجی سپہ سالار بِنایاہؔ بِن یہُویدعؔ کاہِنؔ تھا۔ وہ سپہ سالارِ اعلیٰ تھا اَور اُس کے فَوجی دستے میں چوبیس ہزار فَوجی تھے۔ <verse eid="1CH 27:5"/><verse number="6" style="v" sid="1CH 27:6"/>یہ وُہی بِنایاہؔ تھا جو تیسوں بہادروں میں سَب سے بڑا بہادر تھا۔ اُس کے بعد اُس کا بیٹا عمّیزابادؔ اُس دستے کے سپہ سالار کے طور پر مُنتخب تھا۔<verse eid="1CH 27:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 27:7"/>چوتھے مہینے کے لیٔے چوتھا سپہ سالار یُوآبؔ کا بھایٔی عساہیلؔ تھا۔ اُس کے بعد اُس کا بیٹا زبدیاہؔ سپہ سالار تھا۔ اُس کے دستے میں چوبیس ہزار فَوجی تھے۔<verse eid="1CH 27:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 27:8"/>پانچویں مہینے بنی اِضہارؔ کے خاندان سے پانچواں سپہ سالار شمہُوتؔ تھا اَور اُس کے دستے میں چوبیس ہزار فَوجی تھے۔<verse eid="1CH 27:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 27:9"/>چھٹے مہینے کے لیٔے تقوعؔ کا باشِندہ عیراؔ بِن عقیشؔ تھا۔ اُس کے دستے میں چوبیس ہزار فَوجی تھے۔<verse eid="1CH 27:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 27:10"/>ساتویں مہینے کے لیٔے ساتواں سپہ سالار بنی اِفرائیمؔ میں سے پلونی خلصؔ تھا۔ اُس کے دستے میں چوبیس ہزار فَوجی تھے۔<verse eid="1CH 27:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 27:11"/>آٹھویں مہینے کے لیٔے آٹھواں سپہ سالار بنی زیراحؔ کی نَسل سے حُوشاتی سِبّکائی تھا۔ اُس کے دستے میں چوبیس ہزار فَوجی تھے۔<verse eid="1CH 27:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 27:12"/>نویں مہینے کے لیٔے نواں سپہ سالار بنی بِنیامین میں سے عناتوت ابیعزیر تھا۔ اُس کے دستے میں چوبیس ہزار فَوجی تھے۔<verse eid="1CH 27:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 27:13"/>دسویں مہینے کے لیٔے دسواں سپہ سالار بنی زیراحؔ کی نَسل سے نطُوفاتی مہرائی تھا۔ اُس کے دستے میں چوبیس ہزار فَوجی تھے۔<verse eid="1CH 27:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 27:14"/>گیارھویں مہینے کے لیٔے گیارھواں سپہ سالار بنی اِفرائیمؔ میں سے فِرعاتونی بِنایاہؔ تھا۔ اُس کے دستے میں چوبیس ہزار فَوجی تھے۔<verse eid="1CH 27:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 27:15"/>بارہویں مہینے کے لیٔے بارھواں سپہ سالار بنی عتنی ایل میں سے نطُوفاتی حلدائی تھا۔ اُس کے دستے میں چوبیس ہزار فَوجی تھے۔<verse eid="1CH 27:15"/></para>
  <para style="s1">قبیلوں کے سردار</para>
  <para style="lh">
    <verse number="16" style="v" sid="1CH 27:16"/>بنی اِسرائیل کے قبیلوں کے سردار یہ تھے:</para>
  <para style="b" vid="1CH 27:16"/>
  <para style="li1" vid="1CH 27:16">بنی رُوبِنؔ پر الیعزرؔ بِن زکریؔ؛</para>
  <para style="li1" vid="1CH 27:16">بنی شمعُونی پر شفطیاہؔ بِن معکہؔ؛<verse eid="1CH 27:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 27:17"/>بنی لیوی پر حشبیاہؔ بِن قمُوایلؔ؛</para>
  <para style="li1" vid="1CH 27:17">بنی اَہرونؔ پر صدُوقؔ؛<verse eid="1CH 27:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 27:18"/>یہُوداہؔ پر، داویؔد کا ایک بھایٔی اِلیہُوؔ؛</para>
  <para style="li1" vid="1CH 27:18">یِسَّکاؔر پر عُمریؔ بِن مِیکاایلؔ؛<verse eid="1CH 27:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 27:19"/>زبُولُون پر اِشماعیاہؔ بِن عبدیاہؔ؛</para>
  <para style="li1" vid="1CH 27:19">نفتالی پر یریموتؔ بِن عزری ایل؛<verse eid="1CH 27:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 27:20"/>بنی اِفرائیمؔ پر ہوشِیعؔ بِن عززیاہؔ؛</para>
  <para style="li1" vid="1CH 27:20">منشّہ کے آدھے قبیلہ پر یُوایلؔ بِن پِدائیاہؔ؛<verse eid="1CH 27:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 27:21"/>گِلعادؔ میں منشّہ کے آدھے قبیلہ پر عِدّوؔ بِن زکریاؔہ؛</para>
  <para style="li1" vid="1CH 27:21">بِنیامین پر یعسی ایل بِن ابنیرؔ؛<verse eid="1CH 27:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 27:22"/>دانؔ پر عزرایلؔ بِن یروحامؔ؛</para>
  <para style="b" vid="1CH 27:22"/>
  <para style="lf" vid="1CH 27:22">یہ بنی اِسرائیل کے قبیلوں کے سردار تھے۔<verse eid="1CH 27:22"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23"/>داویؔد نے بیس بَرس یا اُس سے کم عمر کے مَردوں کا شُمار نہ کیا کیونکہ یَاہوِہ کا وعدہ تھا کہ میں بنی اِسرائیل کو آسمان کے تاروں کی مانند بڑھاؤں گا۔ <verse eid="1CH 27:23"/><verse number="24" style="v" sid="1CH 27:24"/>یُوآبؔ بِن ضرویاہؔ نے مَردوں کی گِنتی کا کام شروع کیا لیکن اُسے ختم نہ کر پایا۔ وجہ یہ تھی کہ اُس گِنتی کے باعث اِسرائیل پر قہر نازل ہُوا اَور باقیوں کی تعداد داویؔد بادشاہ کی تاریخ کی کتابوں میں درج نہ ہُوئی۔<verse eid="1CH 27:24"/></para>
  <para style="s1">بادشاہ کے مُختار</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 27:25"/>عزماوتؔ بِن عدی ایل شاہی مخزن پر مُقرّر تھا۔</para>
  <para style="li1" vid="1CH 27:25">اَور یُوناتانؔ بِن عُزّیاہؔ نواحی علاقوں، قصبوں، دیہات اَور چوکیوں کے گوداموں پر نِگران تھا۔<verse eid="1CH 27:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 27:26"/>عزری بِن کلُوبؔ کاشتکاری کے لیٔے کھیتوں میں کام کرنے والوں پر مُقرّر تھا۔<verse eid="1CH 27:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 27:27"/>راماتی شِمعیؔ انگوری باغات پر مُقرّر تھا۔</para>
  <para style="li1" vid="1CH 27:27">اَور شِفامی زبدیؔ انگوری باغ کی کاشتکاری کے لیٔے انگوری باغات کی پیداوار پر مُقرّر تھا۔<verse eid="1CH 27:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 27:28"/>اَور بَعل حنانؔ گِدیری مغربی کوہِ دامن میں زَیتُون کے باغوں اَور گُولر کے درختوں پر مُقرّر تھا۔</para>
  <para style="li1" vid="1CH 27:28">اَور یُوآشؔ زَیتُون کا تیل فراہم کرنے پر مُقرّر تھا۔<verse eid="1CH 27:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 27:29"/>اَور شارونی شطرائی شارونؔ علاقے کے گائے بَیلوں کے گلّوں پر مُقرّر تھا۔</para>
  <para style="li1" vid="1CH 27:29">اَور شافاطؔ بِن عدلائی وادیوں کے گلّوں پر مُقرّر تھا۔<verse eid="1CH 27:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 27:30"/>اَور اوبِلؔ اِشمعیلی اُونٹوں پر مُختار مُقرّر تھا۔</para>
  <para style="li1" vid="1CH 27:30">اَور مِرونوتی یہدِیاہؔ گدھوں پر مُقرّر تھا۔<verse eid="1CH 27:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 27:31"/>اَور ہاگریؔ یازِیزؔ بھیڑ بکریوں کے ریوڑوں پر مُختار مُقرّر تھا۔</para>
  <para style="lf" vid="1CH 27:31">یہ تمام وہ اہلکار تھے جو داویؔد بادشاہ کی مِلکیّت پر مُقرّر تھے۔<verse eid="1CH 27:31"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 27:32"/>اَور یُوناتانؔ داویؔد بادشاہ کا چچازاد جو کہ ایک دانشمند آدمی تھا بادشاہ کا کاتب اَور مُشیر تھا۔</para>
  <para style="li1" vid="1CH 27:32">اَور یحی ایل بِن حکمُونیؔ شہزادوں کا مُصاحب تھا۔<verse eid="1CH 27:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 27:33"/>اَور اخِیتُفلؔ بادشاہ کا مُشیر تھا۔</para>
  <para style="li1" vid="1CH 27:33">اَور ارکی حُوشائی بادشاہ کا ہمراز تھا۔<verse eid="1CH 27:33"/></para>
  <para style="lf">
    <verse number="34" style="v" sid="1CH 27:34"/>اَور یہُویدعؔ بِن بِنایاہؔ اَور ابیاترؔ اخِیتُفلؔ کے بعد اُن کی جگہ پر مُصاحب مُقرّر ہُوئے۔</para>
  <para style="li1" vid="1CH 27:34">اَور یُوآبؔ شاہی فَوج کا سپہ سالارِ اعلیٰ تھا۔<verse eid="1CH 27:34"/></para>
  <chapter eid="1CH 27"/>
  <chapter number="28" style="c" sid="1CH 28"/>
  <para style="s1">بیت المُقدّس کی تعمیر کے لیٔے داویؔد کی ہدایات</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1"/>اَور داویؔد بادشاہ نے بنی اِسرائیل کے تمام اُمرا کو یعنی بنی اِسرائیل کے قبیلوں کے افسران، بادشاہ کی مُلازمت میں، ہزاروں اَور سینکڑوں فَوجی دستوں کے سرداروں، بادشاہ اَور اُس کے بیٹوں کے مال و مویشیوں پر مُقرّر اہلکاروں، نیز شاہی محل کے خواجہ سراؤں، سُورماؤں اَور جنگجو بہادروں کو یروشلیمؔ میں جمع کیا۔<verse eid="1CH 28:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 28:2"/>تَب داویؔد بادشاہ اَپنے پاؤں پر اُٹھ کھڑے ہُوئے اَور فرمایا: ”اَے میرے بھائیوں اَور میرے لوگوں، میری سُنو! میرے دِل میں تھا کہ یَاہوِہ کے عہد کے صندُوق کے لیٔے آرامگاہ اَور اَپنے خُدا کے قدموں کے لیٔے مسند بناؤں اَور مَیں نے اُس کی تعمیر کرنے کی تیّاری بھی کی تھی۔ <verse eid="1CH 28:2"/><verse number="3" style="v" sid="1CH 28:3"/>لیکن خُدا نے مُجھ سے فرمایا، ’تُم میرے نام کے لیٔے گھر نہ بنانا کیونکہ تُم جنگجو مَرد ہو اَور تُم نے خُون بہایا ہے۔‘<verse eid="1CH 28:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 28:4"/>”تاہم یَاہوِہ، بنی اِسرائیل کے خُدا نے میرے تمام خاندان میں سے مُجھے ہمیشہ کے لیٔے بنی اِسرائیل کا بادشاہ ہونے کے واسطے مُنتخب کیا۔ خُدا نے بنی یہُوداہؔ کو رہنما ہونے کے لیٔے مُنتخب کیا اَور یہُوداہؔ کے گھرانے میں سے اُس نے میرے خاندان کو مُنتخب کیا اَور میرے باپ کے بیٹوں میں سے مُجھے تمام اِسرائیل کا بادشاہ مُقرّر کرنا پسند کیا۔ <verse eid="1CH 28:4"/><verse number="5" style="v" sid="1CH 28:5"/>یَاہوِہ نے مُجھے بہت سے بیٹے دئیے ہیں اَور میرے سَب بیٹوں میں سے اُس نے میرے بیٹے شُلومونؔ کو بنی اِسرائیل پر یَاہوِہ کی بادشاہی کے تخت پر تخت نشین ہونے کے واسطے مُنتخب کیا۔ <verse eid="1CH 28:5"/><verse number="6" style="v" sid="1CH 28:6"/>یَاہوِہ نے مُجھ سے فرمایا، ’تمہارا بیٹا شُلومونؔ میرے گھر اَور میری بارگاہوں کی تعمیر کرےگا کیونکہ مَیں نے اُسے اَپنا بیٹا ہونے کے لیٔے مُنتخب کیا ہے اَور مَیں اُس کا باپ ہوں گا۔ <verse eid="1CH 28:6"/><verse number="7" style="v" sid="1CH 28:7"/>اَور اگر وہ میرے اَحکام اَور قوانین پر عَمل کرنے میں ثابت قدم رہے جَیسا کہ آج کے دِن ہے تو مَیں اُس کی بادشاہی ہمیشہ تک قائِم رکھوں گا۔‘<verse eid="1CH 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8"/>”پس اَب مَیں تمام اِسرائیل اَور یَاہوِہ کی جماعت کے رُوبرو اَور یَاہوِہ کی حُضُوری میں تُم سے یہ کہتا ہُوں کہ تُم محتاط ہوکر یَاہوِہ اَپنے خُدا کے سَب اَحکام پر عَمل کرو تاکہ تُم اِس اَچھّے مُلک کے وارِث بنے رہو اَور بطور مِیراث ہمیشہ کے لیٔے اُسے اَپنی اَولاد کے لیٔے چھوڑ جاؤ۔<verse eid="1CH 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9"/>”اَور تُم اَے میرے بیٹے شُلومونؔ، اَپنے باپ کے خُدا کو پہچان اَور پُورے دِل و جان سے اُن کی خدمت کرو؛ کیونکہ یَاہوِہ سَب کے دِلوں کو جانچتے ہیں اَور ہر خیال اَور ہر اَندیشہ کو سمجھتے ہیں۔ اگر تُم اُنہیں ڈھونڈو تو وہ تُمہیں مِل جائیں گے؛ لیکن اگر تُم اُنہیں ترک کر دوگے تو وہ ہمیشہ کے لیٔے تُمہیں ردّ کر دیں گے۔ <verse eid="1CH 28:9"/><verse number="10" style="v" sid="1CH 28:10"/>پس غور کرو کیونکہ یَاہوِہ نے تُمہیں مُنتخب کیا ہے کہ تُم پاک مَقدِس کے لیٔے ایک گھر کی تعمیر کرو۔ لہٰذا کمر باندھ لو اَور اِس کام کو اَنجام دو۔“<verse eid="1CH 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11"/>تَب داویؔد نے اَپنے بیٹے شُلومونؔ کو بیت المُقدّس کے برامدے، اُس کی عمارتوں، گوداموں، اُس کے بالائی حِصّوں، اَندرونی کمروں اَور کفّارہ گاہ کی جگہ کے نقشے دئیے۔ <verse eid="1CH 28:11"/><verse number="12" style="v" sid="1CH 28:12"/>اَور بادشاہ نے اُسے اُن سَب چیزوں کے نقشے بھی دئیے جو پاک رُوح نے یَاہوِہ کے بیت المُقدّس کے صحنوں، اِردگرد کے حُجروں اَور خُدا کے بیت المُقدّس کے خزانوں اَور نذر کَردہ اَشیا کے خزانوں کے متعلّق اُن کے دِل میں ڈالے تھے۔ <verse eid="1CH 28:12"/><verse number="13" style="v" sid="1CH 28:13"/>اَور بادشاہ نے اُسے کاہِنوں اَور لیویوں کے فریقوں اَور یَاہوِہ کے بیت المُقدّس میں خدمت کرنے کے تمام کاموں نیزعبادت میں اِستعمال ہونے والی تمام اَشیا کے متعلّق ہدایات دیں۔ <verse eid="1CH 28:13"/><verse number="14" style="v" sid="1CH 28:14"/>داویؔد نے ہر قِسم کی خدمت میں کام آنے والے سونے کے ظروف کے لیٔے سونے کا وزن مُقرّر کیا اَور چاندی کے ظروف کے لیٔے چاندی کا وزن مُقرّر کیا۔ <verse eid="1CH 28:14"/><verse number="15" style="v" sid="1CH 28:15"/>اَور سونے کے چراغدان اَور اُن کے چراغوں کے لیٔے سونے کا وزن یعنی ہر چراغدان اَور اُس کے چراغ کا وزن اَور چاندی کے ہر چراغدان اَور اُس کے چراغ کا وزن ہر چراغدان کے اِستعمال کے مُطابق مُقرّر کیا۔ <verse eid="1CH 28:15"/><verse number="16" style="v" sid="1CH 28:16"/>اَور نذر کی روٹی کی میزوں کے واسطے ہر سونے کی میز کے لیٔے سونے کا وزن، چاندی کی میزوں کے لیٔے چاندی کا وزن؛ <verse eid="1CH 28:16"/><verse number="17" style="v" sid="1CH 28:17"/>کانٹوں، چھڑکنے والے پیالوں اَور صُراحیوں کے لیٔے خالص سونے کا وزن اَور سونے کی ہر ڈونگے کے لیٔے سونے کا وزن؛ چاندی کے ڈونگے کے لئے چاندی کا وزن <verse eid="1CH 28:17"/><verse number="18" style="v" sid="1CH 28:18"/>اَور بخُور کی قُربان گاہ کے لیٔے خالص سونے کا وزن۔ اَور داویؔد نے اُسے رتھ کا نقشہ بھی دیا جو اَیسا دِکھائی دیتا تھا گویا سونے کے کروبیم ہیں جو پر پھیلائے یَاہوِہ کے عہد کے صندُوق کو ڈھانکے ہُوئے ہیں۔<verse eid="1CH 28:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 28:19"/>داویؔد نے فرمایا، ”یَاہوِہ کا ہاتھ مُجھ پر تھا اَور اُنہُوں نے مُجھے سَب کچھ سمجھایا۔ اَب مَیں اِن سَب کاموں کی تفصیل لِکھ کر نقشوں سمیت تمہارے حوالے کرتا ہُوں۔“<verse eid="1CH 28:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20"/>اَور داویؔد نے اَپنے بیٹے شُلومونؔ سے یہ بھی فرمایا، ”مضبُوط ہو جاؤ اَور حوصلہ رکھو اَور اِس کام کو اَنجام دو۔ خوف نہ کرو اَور ہِراساں نہ ہو کیونکہ یَاہوِہ خُدا، میرے خُدا تمہارے ساتھ ہیں۔ اَور جَب تک یَاہوِہ کے بیت المُقدّس کی خدمت کا سارا کام پُورا نہ ہو جائے وہ تُمہیں نہ تو ہِراساں کریں گے، نہ ترک کریں گے۔ <verse eid="1CH 28:20"/><verse number="21" style="v" sid="1CH 28:21"/>کاہِنوں اَور لیویوں کے تمام فریق خُدا کے بیت المُقدّس کی ساری خدمت کے لیٔے تیّار ہیں اَور ہر طرح کی دستکاری میں ماہر آدمی ہر کام میں بخُوشی تمہاری مدد کریں گے اَور تمام اُمرا اَور تمام لوگ تمہارا ہر حُکم بجا لائیں گے۔“<verse eid="1CH 28:21"/></para>
  <chapter eid="1CH 28"/>
  <chapter number="29" style="c" sid="1CH 29"/>
  <para style="s1">بیت المُقدّس کی تعمیر کے واسطے نذریں</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1"/>اَور داویؔد بادشاہ نے ساری جماعت سے فرمایا، ”خُدا نے فقط میرے بیٹے شُلومونؔ کو مُنتخب کیا ہے اَور وہ ابھی لڑکا ہے اَور ناتجربہ کار ہے۔ یہ کام بڑا ہے کیونکہ یہ شاندار عمارت اِنسان کے لیٔے نہیں بَلکہ یَاہوِہ خُدا کے لیٔے ہے۔ <verse eid="1CH 29:1"/><verse number="2" style="v" sid="1CH 29:2"/>اَور جہاں تک مُجھ سے بَن پڑا مَیں نے اَپنے خُدا کے بیت المُقدّس کے لیٔے سونے کی چیزوں کے لیٔے سونا اَور چاندی کی چیزوں کے لیٔے چاندی، کانسے کی چیزوں کے لیٔے کانسا، لوہے کی چیزوں کے لیٔے لوہا، لکڑی کی چیزوں کے لیٔے لکڑیاں بھی کثیر تعداد میں جمع کرلی ہیں۔ مَیں نے اِن کے علاوہ عقِیق پتّھر اَور باقی بیش قیمتی پتّھر اَور پچّی کاری کے لیٔے رنگ برنگے کے سنگِ سُلیمانی اَور ہر قِسم کے بیش قیمت فیروزہ اَور سنگِ مرمر بکثرت فراہم کیا ہے۔ <verse eid="1CH 29:2"/><verse number="3" style="v" sid="1CH 29:3"/>اِن سَب کے علاوہ میرے خُدا کے بیت المُقدّس میں میرا دِل لگے رہنے کی وجہ سے اَپنے خُود کے خزانے میں سے سونے اَور چاندی، میں اَپنے خُدا کے بیت المُقدّس کے واسطے دے رہا ہُوں۔ یہ اُن سَب چیزوں کے علاوہ ہیں جو مَیں نے پہلے ہی سے اُس بیت المُقدّس کے لیٔے مُہیّا کی ہیں۔ <verse eid="1CH 29:3"/><verse number="4" style="v" sid="1CH 29:4"/>یعنی ایک لاکھ کِلو اوفیرؔ کا سونا اَور دو لاکھ پینتیس ہزار کِلو خالص چاندی، اَپنے خُدا کے بیت المُقدّس کی دیواروں پر منڈھنے کے لیٔے، <verse eid="1CH 29:4"/><verse number="5" style="v" sid="1CH 29:5"/>یہ سَب سونے اَور چاندی سے بننے والی دیگر اَشیا کے لیٔے دیتا ہُوں جو ماہر کاریگروں سے بنوائے جایٔیں گے۔ پس آپ لوگوں میں سے اَپنی دِلی خُوشی سے یَاہوِہ کے لیٔے مخصُوص کرنے کے واسطے نذرانے لانے کے لئے کون تیّار ہے؟“<verse eid="1CH 29:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6"/>تَب آبائی خاندانوں کے سرداروں اَور بنی اِسرائیل کے قبیلوں کے سرداروں، ہزاروں اَور سینکڑوں فَوجی دستوں کے سرداروں اَور شاہی کام کے نِگران منصبداروں نے اَپنی خُوشی سے آمادگی ظاہر کی۔ <verse eid="1CH 29:6"/><verse number="7" style="v" sid="1CH 29:7"/>اَور خُدا کے بیت المُقدّس کے کام کے لیٔے بنی اِسرائیل نے ایک سَو ستّر ٹن سونا اَور دس ہزار دِرہم<note caller="+" style="f"><char style="fr" closed="false">29‏:7 </char><char style="fq" closed="false">دس ہزار دِرہم </char><char style="ft" closed="false">تقریباً 84 کِلو</char></note> سونے کے سِکّے؛ تین سو چالیس ٹن چاندی، چھ سو دس ٹن کانسے اَور تین ہزار چار سَو ٹن لوہا نذرانے میں دیا۔ <verse eid="1CH 29:7"/><verse number="8" style="v" sid="1CH 29:8"/>اَور جِن کے پاس جواہر پتّھر تھے اُنہُوں نے اَپنے جواہر گیرشونی یحی ایل کے ہاتھ میں یَاہوِہ کے بیت المُقدّس کے خزانے کے لیٔے دے دئیے۔ <verse eid="1CH 29:8"/><verse number="9" style="v" sid="1CH 29:9"/>لوگ بڑے خُوش ہُوئے کہ اُن کے سرداروں نے اَپنی دِلی خُوشی اَور پُوری رضامندی سے یَاہوِہ کے لیٔے دیا۔ اَور داویؔد بادشاہ بھی نہایت شادمان ہُوئے۔<verse eid="1CH 29:9"/></para>
  <para style="s1">داویؔد کی دعا</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10"/>تَب داویؔد نے تمام جماعت کی مَوجُودگی میں یہ کہتے ہُوئے یَاہوِہ کی تعریف کی،</para>
  <para style="q1" vid="1CH 29:10">”اَے یَاہوِہ ہمارے باپ اِسرائیل کے خُدا،</para>
  <para style="q2" vid="1CH 29:10">آپ کی حَمد و سِتائش ابدُالآباد ہوتی رہے۔<verse eid="1CH 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 29:11"/>اَے یَاہوِہ، عظمت، قُدرت،</para>
  <para style="q2" vid="1CH 29:11">جلال، شان و شوکت،</para>
  <para style="q2" vid="1CH 29:11">یعنی آسمان اَور زمین کی ہر چیز آپ ہی کا ہے۔</para>
  <para style="q1" vid="1CH 29:11">اَے یَاہوِہ بادشاہی بھی آپ ہی کی ہے؛</para>
  <para style="q2" vid="1CH 29:11">اَور بطور حاکم آپ ہی سَب پر سرفراز ہیں۔<verse eid="1CH 29:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 29:12"/>اَور دولت اَور عزّت آپ کی طرف سے آتی ہیں؛</para>
  <para style="q2" vid="1CH 29:12">اَور آپ ہی سَب چیزوں پر حُکمران ہیں۔</para>
  <para style="q1" vid="1CH 29:12">اِختیار اَور قُدرت آپ ہی کے ہاتھ میں ہیں،</para>
  <para style="q2" vid="1CH 29:12">اَور سَب کو توانائی اَور سرفرازی آپ ہی بخشتے ہیں۔<verse eid="1CH 29:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 29:13"/>اِس لئے اَے ہمارے خُدا، ہم آپ کے شُکر گذار ہیں،</para>
  <para style="q2" vid="1CH 29:13">اَور آپ کے جلالی نام کی تعریف کرتے ہیں۔<verse eid="1CH 29:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14"/>”لیکن مَیں کون ہُوں اَور میرے لوگ کیا ہیں کہ اِس طرح فراخدلی سے دینے کے قابل ہوں؟ کیونکہ سَب چیزیں آپ ہی کی طرف سے ملتی ہیں اَورجو کچھ آپ کے ہاتھ سے ہمیں ملتا ہے اُسی میں سے ہم نے دیا ہے۔ <verse eid="1CH 29:14"/><verse number="15" style="v" sid="1CH 29:15"/>کیونکہ ہم آپ کی نظر میں پردیسی اَور مُسافر ہیں جَیسے ہمارے آباؤاَجداد تھے اَور ہمارے دِن رُوئے زمین پر سایہ کی مانند بے قِیام ہیں۔ <verse eid="1CH 29:15"/><verse number="16" style="v" sid="1CH 29:16"/>اَے یَاہوِہ ہمارے خُدا، یہ ساری چیزیں جو ہم نے جمع کی ہیں اِس لیٔے ہیں کہ آپ کے پاک نام کے لیٔے ایک بیت المُقدّس کی تعمیر کیا جائے۔ یہ ہمیں آپ ہی کے ہاتھ سے مِلی ہیں اَور اِن سَب کے مالک آپ ہی ہیں۔ <verse eid="1CH 29:16"/><verse number="17" style="v" sid="1CH 29:17"/>اَے میرے خُدا، میں یہ بھی جانتا ہُوں کہ آپ دِل کو جانچتے ہیں اَور دیانتداری میں آپ کی خُوشنودی ہے۔ مَیں نے یہ تمام چیزیں اَپنی صدق دِلی اَور نیک نیّت سے دی ہیں اَور مُجھے یہ دیکھ کر بڑی مسرّت حاصل ہُوئی ہے کہ آپ کے لوگ جو یہاں حاضِر ہیں یہ سَب کچھ اَپنی خُوشی سے دے رہے ہیں۔ <verse eid="1CH 29:17"/><verse number="18" style="v" sid="1CH 29:18"/>اَے یَاہوِہ، ہمارے آباؤاَجداد اَبراہامؔ، اِصحاقؔ اَور اِسرائیل کے خُدا، اَپنے لوگوں کے دِل میں یہ خواہش ہمیشہ قائِم رکھیں تاکہ اُن کے دِل ہمیشہ آپ کی طرف مائل رہیں <verse eid="1CH 29:18"/><verse number="19" style="v" sid="1CH 29:19"/>اَور میرے بیٹے شُلومونؔ کو اَیسا کامل دِل عطا کریں کہ وہ آپ کے اَحکام، رسمیں اَور قوانین پر عَمل کرے اَور اِس عظیم بیت المُقدّس کی تعمیر کرائے جِس کے لیٔے مَیں نے یہ سَب تیّاری کی ہے۔“<verse eid="1CH 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20"/>تَب داویؔد نے تمام جماعت سے فرمایا کہ، ”یَاہوِہ اَپنے خُدا کو مُبارک کہو۔“ تَب سَب نے یَاہوِہ اَپنے آباؤاَجداد کے خُدا کی حَمد و تعریف کی اَور سَر جھُکا کر یَاہوِہ اَور بادشاہ کے آگے سَجدہ کیا۔<verse eid="1CH 29:20"/></para>
  <para style="s1">شُلومونؔ کا بادشاہ تسلیم کیاجانا</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21"/>اَور اگلے دِن اُنہُوں نے یَاہوِہ کو ذبیحوں کی قُربانیاں اَور سوختنی نذریں گذرانیں یعنی ایک ہزار بَیل، ایک ہزار نر مینڈھے اَور ایک ہزار برّے اَور مے کی مشروبات نذر کے طور پر گذرانیں اَور بکثرت دیگر قُربانیاں گذرانی جو سارے اِسرائیل کے لیٔے تھیں۔ <verse eid="1CH 29:21"/><verse number="22" style="v" sid="1CH 29:22"/>اَور اُنہُوں نے اُس دِن بڑی خُوشی کے ساتھ یَاہوِہ کی حُضُوری میں کھایا پیا۔</para>
  <para style="p" vid="1CH 29:22">تَب اُنہُوں نے دُوسری مرتبہ داویؔد کے بیٹے شُلومونؔ کو بطور بادشاہ تسلیم کیا اَور اُسے حُکمران ہونے کے لئے صدُوقؔ کو کاہِنؔ ہونے کے لئے یَاہوِہ کی حُضُوری میں مَسح کیا۔ <verse eid="1CH 29:22"/><verse number="23" style="v" sid="1CH 29:23"/>تَب شُلومونؔ یَاہوِہ کے تخت پر اَپنے باپ داویؔد کی جگہ بطور بادشاہ تخت نشین ہُوئے۔ وہ بڑے اِقبالمند ہُوئے اَور سارا اِسرائیل اُن کا مطیع ہُوا۔ <verse eid="1CH 29:23"/><verse number="24" style="v" sid="1CH 29:24"/>تمام افسران اَور سُورماؤں، نیز داویؔد بادشاہ کے سَب بیٹوں نے شُلومونؔ بادشاہ کی اِطاعت کرنے کا عہد کیا۔<verse eid="1CH 29:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 29:25"/>یَاہوِہ نے سارے اِسرائیل کی نظر میں شُلومونؔ کو بڑی سرفرازی بخشی اَور اُسے اَیسی شاہانہ شان و شوکت عطا کی جو اُس سے پہلے اِسرائیل میں کسی بادشاہ کو نصیب نہ ہوئی تھی۔<verse eid="1CH 29:25"/></para>
  <para style="s1">داویؔد بادشاہ کی وفات</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26"/>اَور داویؔد بِن یِشائی سارے اِسرائیل کے بادشاہ تھے۔ <verse eid="1CH 29:26"/><verse number="27" style="v" sid="1CH 29:27"/>داویؔد نے چالیس بَرس تک اِسرائیل پر حُکمرانی کی یعنی سات سال حِبرونؔ میں اَور تینتیس سال یروشلیمؔ میں، <verse eid="1CH 29:27"/><verse number="28" style="v" sid="1CH 29:28"/>اَور داویؔد نے خُوب عمر رسیدہ ہوکر اَور دولت اَور عزّت سے آسُودہ ہوکر وفات پائی اَور اُس کا بیٹا شُلومونؔ بطور بادشاہ اُس کا جانشین ہُوا۔<verse eid="1CH 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 29:29"/>اَور داویؔد بادشاہ کے دَورِ حُکومت کے شروع سے لے کر آخِر تک کے اہم واقعات غیب بین شموایلؔ نبی کی تاریخ میں، ناتنؔ نبی کی تاریخ میں اَور غیب بین گادؔ کی تاریخ میں قلم بند ہیں۔ <verse eid="1CH 29:29"/><verse number="30" style="v" sid="1CH 29:30"/>یعنی اُن کی حُکومت اَور طاقت اَور اُن کے اَور اِسرائیل کے گِردوپیش کے واقعات اَور تمام دیگر مملکتوں کے حالات اُن میں تفصیل سے مندرج ہیں۔<verse eid="1CH 29:30"/></para>
  <chapter eid="1CH 29"/>
</usx>
