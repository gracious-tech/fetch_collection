<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MIC" style="id">- Biblica® Open Urdu Contemporary Version</book>
  <para style="h">میکاہؔ</para>
  <para style="toc1">میکاہ ؔ کی نبُوّت</para>
  <para style="toc2">میکاہؔ</para>
  <para style="toc3">میکاہؔ</para>
  <para style="mt1">میکاہ ؔ</para>
  <para style="mt2">کی نبُوّت</para>
  <chapter number="1" style="c" sid="MIC 1"/>
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1"/>سامریہؔ اَور یروشلیمؔ کی بابت یَاہوِہ کا کلام جو شاہانِ یہُوداہؔ یُوتامؔ و آحازؔ اَور حِزقیاہؔ کے ایّام میں موریشیت کے میکاہؔ پر رُویا میں نازل ہُوا۔<verse eid="MIC 1:1"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 1:2"/>اَے سَب لوگو، سُنو،</para>
  <para style="q2" vid="MIC 1:2">اَے زمین اَور اُس کی معموُری، کان لگاؤ،</para>
  <para style="q1" vid="MIC 1:2">تاکہ یَاہوِہ قادر، ہاں یَاہوِہ</para>
  <para style="q2" vid="MIC 1:2">اَپنے مُقدّس مَسکن سے تمہارے خِلاف گواہی دے۔<verse eid="MIC 1:2"/></para>
  <para style="s1">سامریہؔ اَور یروشلیمؔ کے خِلاف فیصلہ</para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 1:3"/>دیکھو! یَاہوِہ اَپنی قِیام گاہ سے باہر نکل رہے ہیں؛</para>
  <para style="q2" vid="MIC 1:3">وہ نیچے اُترا ہے تاکہ زمین کے اُونچے مقاموں کو پامال کرے۔<verse eid="MIC 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4"/>پہاڑ اُس کے نیچے پگھل جاتے ہیں</para>
  <para style="q2" vid="MIC 1:4">اَور وادیاں پھٹ جاتی ہیں،</para>
  <para style="q1" vid="MIC 1:4">جِس طرح موم آگ سے پگھل جاتا ہے،</para>
  <para style="q2" vid="MIC 1:4">اَور پانی ڈھلوان سے نیچے آتا ہے۔<verse eid="MIC 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 1:5"/>یہ سَب یعقوب کی سرکشی</para>
  <para style="q2" vid="MIC 1:5">اَور اِسرائیل کے گھرانے کے گُناہ کے باعث ہے۔</para>
  <para style="q1" vid="MIC 1:5">یعقوب کی سرکشی کیا ہے؟</para>
  <para style="q2" vid="MIC 1:5">کیا سامریہؔ نہیں؟</para>
  <para style="q1" vid="MIC 1:5">یہُوداہؔ کا اُونچا مقام کیا ہے؟</para>
  <para style="q2" vid="MIC 1:5">کیا یروشلیمؔ نہیں؟<verse eid="MIC 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 1:6"/>اِس لیٔے میں سامریہؔ کو کوڑے کرکٹ کا ڈھیر بنا دُوں گا،</para>
  <para style="q2" vid="MIC 1:6">اَور تاکستان لگانے کی جگہ کی مانند بناؤں گا۔</para>
  <para style="q1" vid="MIC 1:6">میں اُس کے پتّھروں کو وادی میں لُڑھکا دُوں گا</para>
  <para style="q2" vid="MIC 1:6">اَور اُس کی بُنیاد اُکھاڑ دُوں گا۔<verse eid="MIC 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 1:7"/>اُس کے سارے بُت چکنا چُور کر دئیے جایٔیں گے؛</para>
  <para style="q2" vid="MIC 1:7">اُس کے بُت خانوں کے تمام عطیات آگ میں جَلا دئیے</para>
  <para style="q1" vid="MIC 1:7">جایٔیں گے؛</para>
  <para style="q2" vid="MIC 1:7">میں اُس کی مورتیاں تباہ کر دُوں گا۔</para>
  <para style="q1" vid="MIC 1:7">کیونکہ اُس نے اُنہیں طوائفوں کی کمائی سے جمع کیا تھا،</para>
  <para style="q2" vid="MIC 1:7">اَور وہ پھر طوائف بازی کی کمائی کی طرح اِستعمال کئے جایٔیں گے۔<verse eid="MIC 1:7"/></para>
  <para style="s1">رونا اَور ماتم</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 1:8"/>اِس لیٔے مَیں نوحہ اَور ماتم کروں گا؛</para>
  <para style="q2" vid="MIC 1:8">مَیں ننگے پاؤں اَور ننگے بَدن پھروں گا۔</para>
  <para style="q1" vid="MIC 1:8">میں گیدڑ کی طرح چِلّاؤں گا</para>
  <para style="q2" vid="MIC 1:8">اَور اُلّو کی مانند غم کروں گا۔<verse eid="MIC 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 1:9"/>کیونکہ اسیری کا زخم لاعلاج ہے؛</para>
  <para style="q2" vid="MIC 1:9">وہ یہُوداہؔ تک آیا۔</para>
  <para style="q1" vid="MIC 1:9">وہ میرے لوگوں کے پھاٹک،</para>
  <para style="q2" vid="MIC 1:9">بَلکہ یروشلیمؔ تک آ پہُنچا۔<verse eid="MIC 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 1:10"/>گاتؔھ میں اُس کی خبر نہ دینا؛</para>
  <para style="q2" vid="MIC 1:10">ہرگز ماتم نہ کرو۔</para>
  <para style="q1" vid="MIC 1:10">بیت عُفرہؔ میں</para>
  <para style="q2" vid="MIC 1:10">خاک پر لوٹو۔<verse eid="MIC 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 1:11"/>اَے شفیرؔ میں رہنے والی،</para>
  <para style="q2" vid="MIC 1:11">تُو برہنہ ہوکر بے شرمی سے چلی جا۔</para>
  <para style="q1" vid="MIC 1:11">صانانؔ میں رہنے والے</para>
  <para style="q2" vid="MIC 1:11">باہر نہیں آئیں گے۔</para>
  <para style="q1" vid="MIC 1:11">بیت ایضلؔ ماتم میں ہے؛</para>
  <para style="q2" vid="MIC 1:11">اُس کی پناہ گاہ تُم سے لے لی گئی۔<verse eid="MIC 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 1:12"/>مروتؔ کے رہنے والے تڑپتے ہیں،</para>
  <para style="q2" vid="MIC 1:12">وہ درد سے چھُٹکارا پانے کے اِنتظار میں ہیں،</para>
  <para style="q1" vid="MIC 1:12">کیونکہ یَاہوِہ کی طرف سے بربادی آ گئی ہے،</para>
  <para style="q2" vid="MIC 1:12">بَلکہ یروشلیمؔ کے پھاٹک تک آ پہُنچی ہے۔<verse eid="MIC 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 1:13"/>لاکیشؔ میں رہنے والی،</para>
  <para style="q2" vid="MIC 1:13">رتھ میں گھوڑے جوت۔</para>
  <para style="q1" vid="MIC 1:13">صِیّونؔ کی بیٹی کے گُناہ کا آغاز</para>
  <para style="q2" vid="MIC 1:13">تُجھ سے ہی ہُوا،</para>
  <para style="q1" vid="MIC 1:13">کیونکہ اِسرائیل کے گُناہ،</para>
  <para style="q2" vid="MIC 1:13">تُجھ میں پایٔے گیٔے۔<verse eid="MIC 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 1:14"/>اِس لیٔے تُو مورشیت گاتؔ کو</para>
  <para style="q2" vid="MIC 1:14">جدائی کے تحفے دے۔</para>
  <para style="q1" vid="MIC 1:14">اَکزِیبؔ<note caller="+" style="f"><char style="fr" closed="false">1‏:14 </char><char style="fq" closed="false">اَکزِیبؔ </char><char style="ft" closed="false">یعنی فریب</char></note> کے شہر اِسرائیل کے بادشاہوں کے لیٔے</para>
  <para style="q2" vid="MIC 1:14">دغاباز ثابت ہوں گے۔<verse eid="MIC 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 1:15"/>اَے مریشہؔ کی رہنے والی</para>
  <para style="q2" vid="MIC 1:15">میں ایک فاتح کو تیرے خِلاف اُٹھاؤں گا۔</para>
  <para style="q1" vid="MIC 1:15">وہ جو اِسرائیل کی شوکت ہے</para>
  <para style="q2" vid="MIC 1:15">عدُلّامؔ میں آئے گی۔<verse eid="MIC 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 1:16"/>اَپنے خُوشی بخشنے والے</para>
  <para style="q2" vid="MIC 1:16">بچّوں کے ماتم میں سَر مُنڈوا؛</para>
  <para style="q1" vid="MIC 1:16">گِدھ کی طرح پرنُچے ہو جا،</para>
  <para style="q2" vid="MIC 1:16">کیونکہ وہ تیرے پاس سے جَلاوطنی میں چلے جایٔیں گے۔<verse eid="MIC 1:16"/></para>
  <chapter eid="MIC 1"/>
  <chapter number="2" style="c" sid="MIC 2"/>
  <para style="s1">اِنسان کے منصُوبے اَور خُدا کا اِرادہ</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 2:1"/>اُن پر افسوس جو بدی کا منصُوبہ باندھتے ہیں،</para>
  <para style="q2" vid="MIC 2:1">اَور بِستر پر پڑے ہُوئے شرارت کا منصُوبہ بناتے ہیں!</para>
  <para style="q1" vid="MIC 2:1">اَور صُبح ہوتے ہی اُس پر عَمل کرتے ہیں</para>
  <para style="q2" vid="MIC 2:1">کیونکہ وہ عَمل کرنے کی طاقت رکھتے ہیں۔<verse eid="MIC 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 2:2"/>وہ لالچ سے کھیتوں کو ضَبط کرلیتے ہیں،</para>
  <para style="q2" vid="MIC 2:2">اَور گھروں کو چھین لیتے ہیں۔</para>
  <para style="q1" vid="MIC 2:2">وہ لوگوں کو اُن کے گھروں سے،</para>
  <para style="q2" vid="MIC 2:2">اَور اَپنے ہم جنسوں کو اُن کی مِیراث سے محروم کر دیتے ہیں۔<verse eid="MIC 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 2:3"/>اِس لیٔے یَاہوِہ فرماتے ہیں:</para>
  <para style="q1" vid="MIC 2:3">”مَیں اُس قوم پر بربادی لانے کا اِرادہ کر رہا ہُوں،</para>
  <para style="q2" vid="MIC 2:3">جِس سے تُم خُود کو بچا نہ سکوگے۔</para>
  <para style="q1" vid="MIC 2:3">اَور اَب غُرور سے چل نہ سکوگے،</para>
  <para style="q2" vid="MIC 2:3">کیونکہ یہ مُصیبت کا وقت ہوگا۔<verse eid="MIC 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 2:4"/>اُس دِن لوگ تمہارا مذاق اُڑائیں گے؛</para>
  <para style="q2" vid="MIC 2:4">وہ اِس ماتم کے نغمہ سے تُم پر لَعن طَعن کریں گے:</para>
  <para style="q1" vid="MIC 2:4">’ہم بالکُل غارت ہو گئے؛</para>
  <para style="q2" vid="MIC 2:4">میرے لوگوں کی مِیراث تقسیم ہو گئی۔</para>
  <para style="q1" vid="MIC 2:4">اُس نے اُسے ہم سے جُدا کر دیا!</para>
  <para style="q2" vid="MIC 2:4">وہ ہمارے کھیت باغیوں کو دیتاہے۔‘ “<verse eid="MIC 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 2:5"/>اِس لیٔے یَاہوِہ کی جماعت میں کویٔی باقی نہ رہے گا</para>
  <para style="q2" vid="MIC 2:5">جو زمین کو قُرعہ ڈال کر بانٹے۔<verse eid="MIC 2:5"/></para>
  <para style="s1">جھُوٹے نبی</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 2:6"/>”نبُوّت نہ کرو،“ اُن کے نبی کہتے ہیں۔</para>
  <para style="q2" vid="MIC 2:6">”اُن باتوں کے لیٔے نبُوّت نہ کرو؛</para>
  <para style="q2" vid="MIC 2:6">رُسوائی ہم پر نہیں آئے گی۔“<verse eid="MIC 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 2:7"/>کیا یہ کہا جائے کہ یعقوب کے گھرانے:</para>
  <para style="q2" vid="MIC 2:7">”کیا یَاہوِہ کی رُوح ناراض ہو گئی ہے؟</para>
  <para style="q1" vid="MIC 2:7">کیا وہ اَیسے ہی کام کرتے ہیں؟“</para>
  <para style="b" vid="MIC 2:7"/>
  <para style="q1" vid="MIC 2:7">”کیا میری باتیں</para>
  <para style="q2" vid="MIC 2:7">راست رَو کے لیٔے مفید نہیں؟<verse eid="MIC 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 2:8"/>تھوڑی دیر پہلے میرے لوگ دُشمن کی طرح اُٹھے ہیں۔</para>
  <para style="q2" vid="MIC 2:8">تُم جنگ سے لَوٹنے والے</para>
  <para style="q1" vid="MIC 2:8">بےپروا راہ گیروں کے</para>
  <para style="q2" vid="MIC 2:8">نفیس لباس اُتار لیتے ہو،<verse eid="MIC 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 2:9"/>تُم میرے لوگوں کی عورتوں کو</para>
  <para style="q2" vid="MIC 2:9">اُن کے خُوشنما گھروں میں سے نکال دیتے ہو۔</para>
  <para style="q1" vid="MIC 2:9">تُم اُن کے بچّوں سے ہمیشہ کے لیٔے</para>
  <para style="q2" vid="MIC 2:9">میری برکتیں چھین لیتے ہو۔<verse eid="MIC 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 2:10"/>اُٹھو، چل دو!</para>
  <para style="q2" vid="MIC 2:10">کیونکہ یہ تمہاری آرامگاہ نہیں ہے،</para>
  <para style="q1" vid="MIC 2:10">یہ ناپاک ہو چُکی ہے،</para>
  <para style="q2" vid="MIC 2:10">اُس کی بربادی کا کویٔی علاج نہیں۔<verse eid="MIC 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 2:11"/>اگر کویٔی جھُوٹا یا دغاباز آکر کہے،</para>
  <para style="q2" vid="MIC 2:11">’میں تمہارے لیٔے کثرت سے شراب اَور مَے کی پیشن گوئی کروں گا،‘</para>
  <para style="q2" vid="MIC 2:11">تو وہ ہی اُن لوگوں کا نبی ہوگا۔<verse eid="MIC 2:11"/></para>
  <para style="s1">رِہائی کا وعدہ</para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 2:12"/>”اَے یعقوب، میں تُم سَب کو جمع کروں گا؛</para>
  <para style="q2" vid="MIC 2:12">میں اِسرائیل کے بقیّہ کو یقیناً جمع کروں گا۔</para>
  <para style="q1" vid="MIC 2:12">میں اُنہیں بھیڑ خانہ کی بھیڑوں کی طرح جمع کروں گا،</para>
  <para style="q2" vid="MIC 2:12">چراگاہ کے گلّے کی مانند جمع کروں گا؛</para>
  <para style="q2" vid="MIC 2:12">جگہ لوگوں سے بھر جائے گی۔<verse eid="MIC 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 2:13"/>کویٔی راستہ کھولنے والا اُن کے آگے آگے جائے گا؛</para>
  <para style="q2" vid="MIC 2:13">وہ پھاٹک توڑ کر باہر نکل جایٔیں گے۔</para>
  <para style="q1" vid="MIC 2:13">اُن کا بادشاہ یعنی یَاہوِہ،</para>
  <para style="q2" vid="MIC 2:13">اُن کے آگے آگے جائے گا۔“<verse eid="MIC 2:13"/></para>
  <chapter eid="MIC 2"/>
  <chapter number="3" style="c" sid="MIC 3"/>
  <para style="s1">سردار اَور نبیوں کو ڈانٹ</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 3:1"/>تَب مَیں نے کہا، یعقوب کے سردارو، سُنو،</para>
  <para style="q2" vid="MIC 3:1">اِسرائیل کے گھرانے کے حاکمو، سُنو!</para>
  <para style="q2" vid="MIC 3:1">کیا تُمہیں عدالت سے واقف نہیں ہونا چاہئے؟<verse eid="MIC 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 3:2"/>تُم جو نیکی سے نفرت کرتے ہو اَور بدی سے مَحَبّت رکھتے ہو؛</para>
  <para style="q2" vid="MIC 3:2">اَور لوگوں کی کھال اُتار لیتے ہو</para>
  <para style="q2" vid="MIC 3:2">اَور اُن کی ہڈّیوں سے گوشت نوچتے ہو۔<verse eid="MIC 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 3:3"/>اَور میرے لوگوں کا گوشت کھاتے ہو،</para>
  <para style="q2" vid="MIC 3:3">اُن کی کھال اُتارتے ہو</para>
  <para style="q1" vid="MIC 3:3">اُن کی ہڈّیوں کو توڑتے ہو؛</para>
  <para style="q2" vid="MIC 3:3">اَور اُنہیں ہانڈی اَور دیگ کے گوشت کی طرح</para>
  <para style="q2" vid="MIC 3:3">ٹکڑے ٹکڑے کرتے ہو۔<verse eid="MIC 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 3:4"/>تَب وہ یَاہوِہ کو پُکاریں گے،</para>
  <para style="q2" vid="MIC 3:4">لیکن وہ نہ سُنے گا۔</para>
  <para style="q1" vid="MIC 3:4">اُن کے بُرے اعمال کے سبب سے</para>
  <para style="q2" vid="MIC 3:4">وہ اُن سے اَپنا مُنہ پھیر لے گا۔<verse eid="MIC 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 3:5"/>یَاہوِہ یُوں فرماتے ہیں:</para>
  <para style="q1" vid="MIC 3:5">”اُن نبیوں کے لیٔے</para>
  <para style="q2" vid="MIC 3:5">جو میرے لوگوں کو گُمراہ کرتے ہیں،</para>
  <para style="q1" vid="MIC 3:5">اگر کویٔی اُنہیں کھانے کو دیتاہے،</para>
  <para style="q2" vid="MIC 3:5">تو وہ سلامتی ’سلامتی‘ پُکارتے ہیں؛</para>
  <para style="q1" vid="MIC 3:5">لیکن اگر کویٔی اُنہیں کھانے کو نہ دے،</para>
  <para style="q2" vid="MIC 3:5">تو وہ اُس سے لڑنے کو تیّار ہو جاتے ہیں۔<verse eid="MIC 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 3:6"/>اِس لیٔے اَب تمہارے اُوپر رات ہو جائے گی جِس میں رُویا نہ دیکھوگے،</para>
  <para style="q2" vid="MIC 3:6">تاریکی چھا جائے گی اَور تُم غیب بینی نہ کروگے۔</para>
  <para style="q1" vid="MIC 3:6">نبیوں کے اُوپر سُورج غروب ہو جائے گا،</para>
  <para style="q2" vid="MIC 3:6">اَور دِن اَندھیرا ہو جائے گا۔<verse eid="MIC 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 3:7"/>رَوشن ضمیر شرمندہ ہوں گے</para>
  <para style="q2" vid="MIC 3:7">اَور غیب بین بے عزّت ہوں گے۔</para>
  <para style="q1" vid="MIC 3:7">وہ اَپنا مُنہ چھُپا لیں گے</para>
  <para style="q2" vid="MIC 3:7">کیونکہ خُدا کی طرف سے کویٔی جَواب نہ ہوگا۔“<verse eid="MIC 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 3:8"/>لیکن مَیں یَاہوِہ کی رُوح کی قُوّت سے</para>
  <para style="q2" vid="MIC 3:8">بھر گیا ہُوں،</para>
  <para style="q1" vid="MIC 3:8">اَور اِنصاف اَور طاقت سے معموُر ہُوں،</para>
  <para style="q2" vid="MIC 3:8">تاکہ یعقوب کو اُس کی سرکشی،</para>
  <para style="q2" vid="MIC 3:8">اَور اِسرائیل کو اُس کے گُناہ بتاؤں۔<verse eid="MIC 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 3:9"/>اَے یعقوب کے گھرانے کے سردارو، سُنو،</para>
  <para style="q2" vid="MIC 3:9">اَور اِسرائیل کے گھرانے،</para>
  <para style="q1" vid="MIC 3:9">تُم جو اِنصاف کے خِلاف کرتے ہو</para>
  <para style="q2" vid="MIC 3:9">اَور راستی کو مروڑتے ہو، سُنو؛<verse eid="MIC 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 3:10"/>تُم جو صِیّونؔ کو خُونریزی سے،</para>
  <para style="q2" vid="MIC 3:10">اَور یروشلیمؔ کو شرارت سے تعمیر کرتے ہو۔<verse eid="MIC 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 3:11"/>اُس کے سردار رشوت لے کر اِنصاف کرتے ہیں،</para>
  <para style="q2" vid="MIC 3:11">اُس کے کاہِنؔ قیمت لے کر تعلیم دیتے ہیں،</para>
  <para style="q1" vid="MIC 3:11">اَور اُس کے نبی رُوپیہ لے کر قِسمت بتاتے ہیں۔</para>
  <para style="q2" vid="MIC 3:11">پھر بھی وہ یَاہوِہ کی طرف متوجّہ ہوتے ہیں،</para>
  <para style="q1" vid="MIC 3:11">”اَور کہتے ہیں، کیا یَاہوِہ ہمارے درمیان نہیں ہے؟</para>
  <para style="q2" vid="MIC 3:11">ہمارے اُوپر کویٔی بُلا نہیں آئے گی۔“<verse eid="MIC 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 3:12"/>اِس لیٔے صِیّونؔ تمہاری وجہ سے</para>
  <para style="q2" vid="MIC 3:12">کھیت کی طرح ہل سے جوتا جائے گا،</para>
  <para style="q1" vid="MIC 3:12">یروشلیمؔ کھنڈر ہو جائے گا،</para>
  <para style="q2" vid="MIC 3:12">ہیکل کا پہاڑ جھاڑیوں سے ڈھکا ہُوا</para>
  <para style="q2" vid="MIC 3:12">ٹیلہ بَن جائے گا۔<verse eid="MIC 3:12"/></para>
  <chapter eid="MIC 3"/>
  <chapter number="4" style="c" sid="MIC 4"/>
  <para style="s1">یَاہوِہ کا پہاڑ</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 4:1"/>آخِری دِنوں میں</para>
  <para style="q1" vid="MIC 4:1">یَاہوِہ کے ہیکل کا پہاڑ قائِم کیا جائے گا</para>
  <para style="q2" vid="MIC 4:1">اَورجو تمام پہاڑوں میں بُلند ہوگا؛</para>
  <para style="q1" vid="MIC 4:1">وہ اَور پہاڑوں سے اُونچا اُٹھایا جائے گا،</para>
  <para style="q2" vid="MIC 4:1">اَور تمام قوموں کا اُس پر تانتا لگا ہوگا۔<verse eid="MIC 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 4:2"/>بہت سِی قومیں آئیں گی اَور کہیں گی،</para>
  <para style="q1" vid="MIC 4:2">”آؤ یَاہوِہ کے گھر پر چڑھیں،</para>
  <para style="q2" vid="MIC 4:2">اَور یعقوب کے خُدا کے گھر میں داخل ہُوں۔</para>
  <para style="q1" vid="MIC 4:2">وہ ہمیں اَپنے آئین سکھائیں گے،</para>
  <para style="q2" vid="MIC 4:2">تاکہ ہم اُن کی راہوں پر چلیں۔“</para>
  <para style="q1" vid="MIC 4:2">کیونکہ شَریعت صِیّونؔ سے،</para>
  <para style="q2" vid="MIC 4:2">اَور یَاہوِہ کا کلام یروشلیمؔ سے صادر ہوگا۔<verse eid="MIC 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 4:3"/>وہ بہت سِی اُمّتوں کے درمیان عدالت کریں گے</para>
  <para style="q2" vid="MIC 4:3">اَور دُور دُور کی زورآور قوموں کے جھگڑوں کو مٹائیں گے۔</para>
  <para style="q1" vid="MIC 4:3">وہ اَپنی تلواریں پیٹ کر پھالیں،</para>
  <para style="q2" vid="MIC 4:3">اَور بھالوں کو ہنسوے بنائیں گے۔</para>
  <para style="q1" vid="MIC 4:3">ایک قوم دُوسری قوم پر تلوار نہ اُٹھائے گی،</para>
  <para style="q2" vid="MIC 4:3">اَور نہ جنگ کرنے کی تربّیت دے گی۔<verse eid="MIC 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 4:4"/>ہر آدمی اَپنی انگوری بیل،</para>
  <para style="q2" vid="MIC 4:4">اَور اَنجیر کے درخت کے نیچے بیٹھے گا،</para>
  <para style="q1" vid="MIC 4:4">اَور کویٔی اُنہیں نہ ڈرائے گا،</para>
  <para style="q2" vid="MIC 4:4">کیونکہ قادرمُطلق یَاہوِہ نے فرمایاہے۔<verse eid="MIC 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 4:5"/>سَب قومیں،</para>
  <para style="q2" vid="MIC 4:5">اَپنے معبُودوں کے نام سے چلیں گی؛</para>
  <para style="q1" vid="MIC 4:5">پر ہم لوگ اَبد تک،</para>
  <para style="q2" vid="MIC 4:5">یَاہوِہ اَپنے خُدا کے نام سے چلیں گے۔<verse eid="MIC 4:5"/></para>
  <para style="s1">یَاہوِہ کا منصُوبہ</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 4:6"/>”اُس روز،“ یَاہوِہ فرماتے ہیں،</para>
  <para style="q2" vid="MIC 4:6">”میں لنگڑوں کو جمع کروں گا،</para>
  <para style="q2" vid="MIC 4:6">جَلاوطنوں کو،</para>
  <para style="q2" vid="MIC 4:6">اَور اُنہیں جنہیں مَیں نے دُکھ دیا ہے، جمع کروں گا۔<verse eid="MIC 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 4:7"/>لنگڑوں کو بقیّہ،</para>
  <para style="q2" vid="MIC 4:7">اَور جَلاوطنوں کو زورآور قوم بناؤں گا۔</para>
  <para style="q1" vid="MIC 4:7">اُس دِن سے یَاہوِہ کوہِ صِیّونؔ میں،</para>
  <para style="q2" vid="MIC 4:7">ہمیشہ تک اُن پر سلطنت کرےگا۔<verse eid="MIC 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 4:8"/>اَور اَے گلّے کے رَوشنی کے مینار،</para>
  <para style="q2" vid="MIC 4:8">اَے صِیّونؔ کی بیٹی کے قلعے،</para>
  <para style="q1" vid="MIC 4:8">تیری بابت یہ ہے کہ تیری پہلی سلطنت تُجھے ملے گی؛</para>
  <para style="q2" vid="MIC 4:8">یروشلیمؔ کی بیٹی کو بادشاہی ملے گی۔“<verse eid="MIC 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 4:9"/>اَب تُو کیوں چِلّاتی ہے۔</para>
  <para style="q2" vid="MIC 4:9">کیا تیرا کویٔی بادشاہ نہیں ہے؟</para>
  <para style="q1" vid="MIC 4:9">کیا تُجھے صلاح دینے والا مِٹ گیا،</para>
  <para style="q2" vid="MIC 4:9">کہ تُو دردِزہ کی سِی تکلیف میں مبتلا ہے؟<verse eid="MIC 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 4:10"/>اَے صِیّونؔ کی بیٹی،</para>
  <para style="q2" vid="MIC 4:10">تو زچّہ کی مانند درد سے تکلیف اُٹھا رہی ہے،</para>
  <para style="q1" vid="MIC 4:10">اَب تُجھے کھُلے میدان میں جا کر رہنے کے لیٔے،</para>
  <para style="q2" vid="MIC 4:10">شہر کو چھوڑ دینا چاہئے۔</para>
  <para style="q1" vid="MIC 4:10">تُو بابیل کو جائے گی؛</para>
  <para style="q2" vid="MIC 4:10">وہاں تُو رِہائی پایٔے گی۔</para>
  <para style="q1" vid="MIC 4:10">وہیں یَاہوِہ تُجھے،</para>
  <para style="q2" vid="MIC 4:10">تیرے دُشمنوں کے ہاتھ سے چھُڑائیں گے۔<verse eid="MIC 4:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 4:11"/>لیکن اَب بہت سِی قومیں،</para>
  <para style="q2" vid="MIC 4:11">تیرے خِلاف جمع ہو گئی ہیں۔</para>
  <para style="q1" vid="MIC 4:11">وہ کہتی ہیں، ”صِیّونؔ کو ناپاک ہونے دو،</para>
  <para style="q2" vid="MIC 4:11">اَور ہماری آنکھیں اُس کی رُسوائی دیکھیں!“<verse eid="MIC 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 4:12"/>لیکن وہ یَاہوِہ کے خیالات سے،</para>
  <para style="q2" vid="MIC 4:12">واقف نہیں؛</para>
  <para style="q1" vid="MIC 4:12">وہ اُس کے منصُوبہ کو نہیں سمجھتے،</para>
  <para style="q2" vid="MIC 4:12">جو اُن کو کھلیان کے پُولوں کی طرح جمع کرتے ہیں۔<verse eid="MIC 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 4:13"/>اَے صِیّونؔ کی بیٹی، اُٹھ اَور کُچل،</para>
  <para style="q2" vid="MIC 4:13">کیونکہ مَیں تُجھے لوہے کے سینگ،</para>
  <para style="q1" vid="MIC 4:13">اَور کانسے کے کھُر دُوں گا،</para>
  <para style="q2" vid="MIC 4:13">اَور تُو بہت سِی قوموں کے ٹکڑے کر ڈالے گی۔</para>
  <para style="q1" vid="MIC 4:13">اَور اُن کے ناجائز آمدنی کے ذخیروں کو خُدا کی نذر کرےگی،</para>
  <para style="q2" vid="MIC 4:13">اَور اُن کے مال کو زمین کے مالک، یَاہوِہ خُدا کے حُضُور میں لایٔے گی۔<verse eid="MIC 4:13"/></para>
  <chapter eid="MIC 4"/>
  <chapter number="5" style="c" sid="MIC 5"/>
  <para style="s1">بیت لحمؔ میں سے ایک وعدہ کیا ہُوا حاکم</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 5:1"/>اَے لشکروں کے شہر، لشکروں کو جمع کرو،</para>
  <para style="q2" vid="MIC 5:1">کیونکہ ہمارے خِلاف ایک محاصرہ ہونے والا ہے۔</para>
  <para style="q1" vid="MIC 5:1">وہ اِسرائیل کے حاکم کے گال پر،</para>
  <para style="q2" vid="MIC 5:1">سلاخ سے ماریں گے۔<verse eid="MIC 5:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 5:2"/>لیکن اَے بیت لحمؔ اِفراتہؔ،</para>
  <para style="q2" vid="MIC 5:2">تُو جو یہُوداہؔ کی برادری میں سَب سے چھوٹاہے، تو بھی تُجھ میں سے</para>
  <para style="q1" vid="MIC 5:2">میرے لیٔے ایک حاکم برپا ہوگا</para>
  <para style="q2" vid="MIC 5:2">جو سارے اِسرائیل پر حُکومت کرےگا،</para>
  <para style="q1" vid="MIC 5:2">وہ ایّام اَزل سے ہے،</para>
  <para style="q2" vid="MIC 5:2">اُس کا ظہُور قدیم زمانے سے ہے۔<verse eid="MIC 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 5:3"/>اِس لیٔے اِسرائیل کو اُس وقت تک چھوڑ دیا جائے گا،</para>
  <para style="q2" vid="MIC 5:3">جَب تک کہ زچّہ کے یہاں وِلادت نہ ہو جائے،</para>
  <para style="q1" vid="MIC 5:3">اَور اُس کے باقی بھایٔی واپس آکر،</para>
  <para style="q2" vid="MIC 5:3">اِسرائیل سے مِل نہ جایٔیں۔<verse eid="MIC 5:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 5:4"/>وہ کھڑا ہوگا،</para>
  <para style="q2" vid="MIC 5:4">اَور یَاہوِہ کی قُدرت،</para>
  <para style="q1" vid="MIC 5:4">اَور یَاہوِہ کے نام کی عظمت سے،</para>
  <para style="q2" vid="MIC 5:4">اُس کے گلّے کی گلّہ بانی کرےگا۔</para>
  <para style="q1" vid="MIC 5:4">وہ محفوظ رہیں گے،</para>
  <para style="q2" vid="MIC 5:4">تَب وہ زمین کی اِنتہا تک بُزرگ ہوگا۔<verse eid="MIC 5:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 5:5"/>اَور وہ ہماری سلامتی ہوگا۔</para>
  <para style="q2" vid="MIC 5:5">جَب اشُور ہمارے مُلک پر حملہ کرےگا،</para>
  <para style="q2" vid="MIC 5:5">اَور ہمارے محلوں میں قدم رکھےگا،</para>
  <para style="q1" vid="MIC 5:5">تو ہم اُس کے خِلاف سات چرواہے،</para>
  <para style="q2" vid="MIC 5:5">بَلکہ آٹھ آدمیوں کے سردار بھی کھڑے کریں گے۔<verse eid="MIC 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 5:6"/>وہ اشُور کی سرزمین پر تلوار سے،</para>
  <para style="q2" vid="MIC 5:6">اَور نِمرودؔ کے مُلک پر ننگی تلوار سے حُکمرانی کریں گے۔</para>
  <para style="q1" vid="MIC 5:6">جَب اشُور ہمارے مُلک پر حملہ کرےگا،</para>
  <para style="q2" vid="MIC 5:6">اَور ہماری سرحدوں میں داخل ہوگا،</para>
  <para style="q2" vid="MIC 5:6">تو وہ ہمیں اشُور سے رِہائی بخشےگا۔<verse eid="MIC 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 5:7"/>یعقوب کا بقیّہ،</para>
  <para style="q2" vid="MIC 5:7">بہت سِی قوموں کے لیٔے اَیسا ہوگا،</para>
  <para style="q1" vid="MIC 5:7">جَیسے یَاہوِہ کی طرف سے اوس،</para>
  <para style="q2" vid="MIC 5:7">اَور گھاس کے اُوپر بارش،</para>
  <para style="q1" vid="MIC 5:7">جو نہ آدمی کا اِنتظار کرتی ہے،</para>
  <para style="q2" vid="MIC 5:7">اَور نہ کسی اِنسان کے لیٔے ٹھہرتی ہے۔<verse eid="MIC 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 5:8"/>یعقوب کا بقیّہ قوموں میں،</para>
  <para style="q2" vid="MIC 5:8">اَور بہت سِی اُمّتوں کے درمیان،</para>
  <para style="q1" vid="MIC 5:8">اَیسا ہوگا جَیسے شیرببر جنگلی جانوروں میں،</para>
  <para style="q2" vid="MIC 5:8">یا جَوان شیر بھیڑوں کے گلّے میں،</para>
  <para style="q1" vid="MIC 5:8">جَب وہ اُن کے درمیان سے نکلتا ہے تو اُنہیں روندتا اَور پھاڑتا ہے،</para>
  <para style="q2" vid="MIC 5:8">اَور کویٔی اُنہیں بچا نہیں سَکتا۔<verse eid="MIC 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 5:9"/>تیرا ہاتھ فتح مندی کے ساتھ تیرے دُشمن پر اُٹھے گا،</para>
  <para style="q2" vid="MIC 5:9">اَور تیرے سَب دُشمن برباد ہو جایٔیں گے۔<verse eid="MIC 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 5:10"/>”اُس روز،“ یَاہوِہ فرماتے ہیں،</para>
  <para style="q1" vid="MIC 5:10">”مَیں تیرے گھوڑوں کو جو تیرے درمیان ہیں، کاٹ ڈالوں گا،</para>
  <para style="q2" vid="MIC 5:10">اَور تیرے رتھوں کو برباد کر دُوں گا۔<verse eid="MIC 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 5:11"/>مَیں تیرے مُلک کے شہروں کو برباد کر دُوں گا،</para>
  <para style="q2" vid="MIC 5:11">اَور تیرے سَب قلعوں کو ڈھا دُونگا۔<verse eid="MIC 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 5:12"/>مَیں تیری جادُوگری ختم کر دُوں گا،</para>
  <para style="q2" vid="MIC 5:12">اَور تیرے فالگیر پھر کبھی فال نہ نکالیں گے۔<verse eid="MIC 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 5:13"/>مَیں تیری کھودی ہُوئی مورتوں نِیست کر دُوں گا،</para>
  <para style="q2" vid="MIC 5:13">اَور تیرے درمیان سے تیرے مُقدّس پتّھروں کو برباد کر دُوں گا؛</para>
  <para style="q1" vid="MIC 5:13">تُو پھر کبھی اَپنے ہاتھوں کی کاریگری کو،</para>
  <para style="q2" vid="MIC 5:13">سَجدہ نہ کرےگا۔<verse eid="MIC 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 5:14"/>مَیں تیرے اشیراہؔ کے سُتونوں کو تیرے درمیان سے اُکھاڑ دُوں گا،</para>
  <para style="q2" vid="MIC 5:14">اَور تیرے شہروں کو غارت کر دُوں گا۔<verse eid="MIC 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 5:15"/>میں اُن قوموں پر جنہوں نے میری فرمانبرداری نہیں کی،</para>
  <para style="q2" vid="MIC 5:15">اَپنا قہر نازل کرکے اِنتقام لُوں گا۔“<verse eid="MIC 5:15"/></para>
  <chapter eid="MIC 5"/>
  <chapter number="6" style="c" sid="MIC 6"/>
  <para style="s1">اِسرائیل کے خِلاف خُدا کی شکایت</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1"/>یَاہوِہ کا فرمان سُن:</para>
  <para style="q1" vid="MIC 6:1">”اُٹھ، پہاڑوں کے سامنے اَپنا مُعاملہ پیش کر؛</para>
  <para style="q2" vid="MIC 6:1">اَور ٹیلے تیرے بَیان کو سُنیں۔<verse eid="MIC 6:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 6:2"/>”اَے پہاڑو اَور اَے زمین کی غَیر فانی بُنیادو،</para>
  <para style="q2" vid="MIC 6:2">یَاہوِہ کا اِلزام سُنو۔</para>
  <para style="q1" vid="MIC 6:2">کیونکہ اَپنے لوگوں کے خِلاف یَاہوِہ کا ایک مُقدّمہ ہے؛</para>
  <para style="q2" vid="MIC 6:2">وہ اِسرائیل پر فردِ جُرم لگاتاہے۔<verse eid="MIC 6:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 6:3"/>”اَے میرے لوگو، مَیں نے تُم سے کیا کیا؟</para>
  <para style="q2" vid="MIC 6:3">اَور تمہارے اُوپر کیسے بوجھ لادا؟ جَواب دو۔<verse eid="MIC 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 6:4"/>میں تُمہیں مُلک مِصر سے نکال کر باہر لایا،</para>
  <para style="q2" vid="MIC 6:4">اَور فدیہ دے کر غُلامی کے مُلک سے چھُڑایا۔</para>
  <para style="q1" vid="MIC 6:4">مَیں نے مَوشہ، اَہرونؔ اَور مِریمؔ کو،</para>
  <para style="q2" vid="MIC 6:4">تمہاری رہنمائی کے لیٔے بھیجا۔<verse eid="MIC 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 6:5"/>میرے لوگو، یاد کرو،</para>
  <para style="q2" vid="MIC 6:5">کہ شاہِ مُوآب بلقؔ نے تُمہیں کیا مشورہ دیا،</para>
  <para style="q2" vid="MIC 6:5">اَور بِلعاؔم بِن بعورؔ کے بیٹے بِلعاؔم نے اُسے کیا جَواب دیا۔</para>
  <para style="q1" vid="MIC 6:5">شِطِّیمؔ سے گِلگالؔ تک کے اَپنے سفر کو یاد کرو،</para>
  <para style="q2" vid="MIC 6:5">تاکہ یَاہوِہ کے راستبازی کے کاموں کو جان لو۔“<verse eid="MIC 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 6:6"/>میں کیا لے کر یَاہوِہ کے حُضُور میں آؤں،</para>
  <para style="q2" vid="MIC 6:6">اَور خدائے تعالیٰ کو کیسے سَجدہ کروں؟</para>
  <para style="q1" vid="MIC 6:6">کیا سوختنی نذروں،</para>
  <para style="q2" vid="MIC 6:6">اَور ایک سالہ بچھڑوں کے ساتھ اُس کے حُضُور میں آؤں؟<verse eid="MIC 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 6:7"/>کیا یَاہوِہ ہزار مینڈھوں،</para>
  <para style="q2" vid="MIC 6:7">اَور تیل کی دس ہزار نہروں سے خُوش ہونگے؟</para>
  <para style="q1" vid="MIC 6:7">کیا میں اَپنی سرکشی کے عوض اَپنے پہلوٹھے کو دُوں،</para>
  <para style="q2" vid="MIC 6:7">اَپنی جَوانی کے پھل کو اَپنی جان کے گُناہوں کے بدلے میں دے دُوں؟<verse eid="MIC 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 6:8"/>اَے اِنسان، اُنہُوں نے تُجھے دِکھا دیا کہ نیکی کیا چیز ہے،</para>
  <para style="q2" vid="MIC 6:8">اَور یَاہوِہ تُجھ سے کیا چاہتے ہیں؟</para>
  <para style="q1" vid="MIC 6:8">یہ کہ تُو اِنصاف اَور رحمدلی کو عزیز رکھے،</para>
  <para style="q2" vid="MIC 6:8">اَور اَپنے خُدا کے سامنے فروتنی سے چلے۔<verse eid="MIC 6:8"/></para>
  <para style="s1">اِسرائیل کی خطا اَور سزا</para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 6:9"/>سُنو، یَاہوِہ شہر کو پُکارتے ہیں۔</para>
  <para style="q2" vid="MIC 6:9">آپ کے نام سے ڈرنا حِکمت ہے۔</para>
  <para style="q2" vid="MIC 6:9">”عصا اَور اُس کے مُقرّر کرنے والے کی سُنو۔<verse eid="MIC 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 6:10"/>اَے بدکار گھرانے، کیا میں اَب بھی تیرا ناجائز منافع،</para>
  <para style="q2" vid="MIC 6:10">اَور کم پیمانے کو جو نفرت کا باعث ہیں، بھُول جاؤں؟<verse eid="MIC 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 6:11"/>کیا میں اَیسے آدمی کو چھوڑ دُوں جو دغا کے ترازو رکھتا ہے،</para>
  <para style="q2" vid="MIC 6:11">اَور غلط باٹوں کا تھیلہ رکھتا ہے؟<verse eid="MIC 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 6:12"/>تمہارے دولتمند ظالِم ہیں؛</para>
  <para style="q2" vid="MIC 6:12">تمہارے باشِندے جھُوٹ بولتے ہیں۔</para>
  <para style="q2" vid="MIC 6:12">اُن کی زبانیں دغابازی کی باتیں کرتی ہیں۔<verse eid="MIC 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 6:13"/>اِس لیٔے مَیں نے تُجھے غارت کرنا،</para>
  <para style="q2" vid="MIC 6:13">اَور تیرے گُناہوں کے سبب سے تُجھے برباد کرنا شروع کر دیا ہے۔<verse eid="MIC 6:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 6:14"/>تُو کھائے گا پر آسُودہ نہ ہوگا؛</para>
  <para style="q2" vid="MIC 6:14">تیرا پیٹ نہ بھرے گا۔</para>
  <para style="q1" vid="MIC 6:14">جمع کرےگا لیکن بچا نہ پایٔےگا،</para>
  <para style="q2" vid="MIC 6:14">کیونکہ جو کچھ تُو بچائے گا میں اُسے تلوار کے حوالہ کر دُوں گا۔<verse eid="MIC 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 6:15"/>تُو بوئے گا پر فصل نہ پایٔےگا؛</para>
  <para style="q2" vid="MIC 6:15">زَیتُون کا تیل نکالے گا لیکن اِستعمال نہ کرےگا،</para>
  <para style="q2" vid="MIC 6:15">انگور روندےگا پر مَے نہ پیئے گا۔<verse eid="MIC 6:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 6:16"/>تُو عُمریؔ کے قوانین،</para>
  <para style="q2" vid="MIC 6:16">اَور احابؔ کے خاندان کے اعمال کی پیروی کرتا ہے،</para>
  <para style="q2" vid="MIC 6:16">اَور اُن کے رِواج مانتا ہے۔</para>
  <para style="q1" vid="MIC 6:16">اِس لیٔے مَیں تُجھے ویران کروں گا،</para>
  <para style="q2" vid="MIC 6:16">اَور تیرے لوگوں کو مذاق کا باعث بناؤں گا؛</para>
  <para style="q2" vid="MIC 6:16">وہ ساری قوموں میں تمسخر کا باعث بنیں گے۔“<verse eid="MIC 6:16"/></para>
  <chapter eid="MIC 6"/>
  <chapter number="7" style="c" sid="MIC 7"/>
  <para style="s1">اِسرائیل کی مُصیبت</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 7:1"/>دُوسری مُصیبت کتنی بڑی ہے!</para>
  <para style="q1" vid="MIC 7:1">مَیں اُس آدمی کی مانند ہُوں</para>
  <para style="q2" vid="MIC 7:1">جو انگور توڑنے کے وقت گرمیوں کا پھل جمع کرتا ہے؛</para>
  <para style="q1" vid="MIC 7:1">لیکن اُسے کھانے کے لیٔے انگور کا ایک گُچّھا بھی نہیں،</para>
  <para style="q2" vid="MIC 7:1">اَور نہ میرا مَن چاہا اَنجیر کا پہلا پھل ہے۔<verse eid="MIC 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 7:2"/>نیک آدمی زمین پر سے مٹا دئیے گیٔے؛</para>
  <para style="q2" vid="MIC 7:2">ایک راستباز بھی باقی نہیں۔</para>
  <para style="q1" vid="MIC 7:2">سَب لوگ خُون کی گھات میں لگے ہُوئے ہیں؛</para>
  <para style="q2" vid="MIC 7:2">ہر آدمی جال بچھا کر اَپنے بھایٔی کا شِکار کرتا ہے۔<verse eid="MIC 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 7:3"/>اُن کے دونوں ہاتھ بدی کرنے میں ماہر ہیں؛</para>
  <para style="q2" vid="MIC 7:3">حاکم تحفے طلب کرتے ہیں،</para>
  <para style="q1" vid="MIC 7:3">مُنصِف رشوت لیتا ہے،</para>
  <para style="q2" vid="MIC 7:3">زبردست جو چاہتے ہیں، اُن سے کرواتے ہیں۔</para>
  <para style="q2" vid="MIC 7:3">وہ سَب مِل کر سازش کرتے ہیں۔<verse eid="MIC 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 7:4"/>اُن میں کا سَب سے اَچھّا اُونٹ کٹارے کی مانند ہے،</para>
  <para style="q2" vid="MIC 7:4">اَور سَب سے راستباز خاردار جھاڑی سے بدتر ہے۔</para>
  <para style="q1" vid="MIC 7:4">وہ دِن آ گیا ہے جَب خُدا تمہارے درمیان آئیں گے۔</para>
  <para style="q2" vid="MIC 7:4">وہ دِن جَب پہرےدار خطرے کی گھنٹی بجایئں گے۔</para>
  <para style="q2" vid="MIC 7:4">اَب تمہاری پریشانی کا دِن ہے۔<verse eid="MIC 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 7:5"/>پڑوسی پر بھروسا مت کر،</para>
  <para style="q2" vid="MIC 7:5">دوست پر اِعتماد نہ کر۔</para>
  <para style="q1" vid="MIC 7:5">اَپنی پیاری بیوی پر اِعتبار نہ کر،</para>
  <para style="q2" vid="MIC 7:5">اَپنی بات میں خبردار رہ۔<verse eid="MIC 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 7:6"/>کیونکہ بیٹا اَپنے باپ سے حقارت کرتا ہے،</para>
  <para style="q2" vid="MIC 7:6">بیٹی اَپنی ماں کی،</para>
  <para style="q1" vid="MIC 7:6">اَور بہُو اَپنی ساس کے خِلاف میں کھڑی ہو جاتی ہے۔</para>
  <para style="q2" vid="MIC 7:6">آدمی کے دُشمن اُس کے گھر ہی کے لوگ ہوتے ہیں۔<verse eid="MIC 7:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 7:7"/>لیکن مَیں پُر اُمّید ہوکر یَاہوِہ کی راہ دیکھوں گا،</para>
  <para style="q2" vid="MIC 7:7">مَیں اَپنے مُنجّی خُدا کا اِنتظار کروں گا؛</para>
  <para style="q2" vid="MIC 7:7">میرے خُدا میری سُنیں گے۔<verse eid="MIC 7:7"/></para>
  <para style="s1">اِسرائیل اُٹھے گا</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 7:8"/>اَے میرے دُشمن مُجھ پر خُوش نہ ہو!</para>
  <para style="q2" vid="MIC 7:8">اگرچہ مَیں گِر پڑا ہُوں لیکن اُٹھ کھڑا ہُوں گا۔</para>
  <para style="q1" vid="MIC 7:8">چاہے مَیں اَندھیرے میں ہُوں،</para>
  <para style="q2" vid="MIC 7:8">پھر بھی یَاہوِہ میری رَوشنی ہوں گے۔<verse eid="MIC 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 7:9"/>کیونکہ مَیں نے اُن کے خِلاف گُناہ کیا ہے،</para>
  <para style="q2" vid="MIC 7:9">جَب تک وہ میرا مُقدّمہ نہ لڑے،</para>
  <para style="q1" vid="MIC 7:9">اَور میرا حق ثابت نہ کرے۔</para>
  <para style="q2" vid="MIC 7:9">جب تک وہ مُجھے رَوشنی میں نہیں لایٔے گا؛</para>
  <para style="q1" vid="MIC 7:9">تب تک مَیں اُن کی راستبازی نہ دیکھوں گا۔</para>
  <para style="q2" vid="MIC 7:9">اَور مَیں یَاہوِہ کے قہر کو برداشت کروں گا،<verse eid="MIC 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 7:10"/>تَب میرا دُشمن اُس کو دیکھے گا،</para>
  <para style="q2" vid="MIC 7:10">اَور شرمندہ ہوگا،</para>
  <para style="q1" vid="MIC 7:10">وہ جِس نے مُجھ سے کہاتھا،</para>
  <para style="q2" vid="MIC 7:10">کہ یَاہوِہ تیرا خُدا کہاں ہے؟</para>
  <para style="q1" vid="MIC 7:10">میری آنکھیں اُس کا زوال دیکھیں گی؛</para>
  <para style="q2" vid="MIC 7:10">اَب بھی وہ پیروں کے نیچے کُچلی جائے گی،</para>
  <para style="q2" vid="MIC 7:10">جِس طرح گلیوں میں کیچڑ روندی جاتی ہے۔<verse eid="MIC 7:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 7:11"/>تمہاری فصیلیں تعمیر کرنے،</para>
  <para style="q2" vid="MIC 7:11">اَور تمہاری حُدوُدیں بڑھانے کا وقت آئے گا۔<verse eid="MIC 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 7:12"/>اُس دِن لوگ تیرے پاس آئیں گے،</para>
  <para style="q2" vid="MIC 7:12">اشُور اَور مِصر کے شہروں سے تیرے پاس آئیں گے،</para>
  <para style="q1" vid="MIC 7:12">بَلکہ مِصر سے دریائے فراتؔ،</para>
  <para style="q2" vid="MIC 7:12">اَور سمُندر اَور پہاڑ سے پہاڑ تک،</para>
  <para style="q2" vid="MIC 7:12">قومیں تیرے پاس آئیں گی۔<verse eid="MIC 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 7:13"/>زمین اَپنے باشِندوں کے کاموں کے سبب سے،</para>
  <para style="q2" vid="MIC 7:13">ویران ہو جائے گی۔<verse eid="MIC 7:13"/></para>
  <para style="s1">دعا اَور تمجید</para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 7:14"/>اَپنے لوگوں، یعنی اَپنی مِیراث کے</para>
  <para style="q2" vid="MIC 7:14">گلّوں کی گلّہ بانی عصا سے کر،</para>
  <para style="q1" vid="MIC 7:14">جو جنگل میں زرخیز چراگاہوں میں،</para>
  <para style="q2" vid="MIC 7:14">تنہا رہتے ہیں۔</para>
  <para style="q1" vid="MIC 7:14">اُنہیں باشانؔ اَور گِلعادؔ میں،</para>
  <para style="q2" vid="MIC 7:14">قدیم زمانہ کی طرح چرنے دے۔<verse eid="MIC 7:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 7:15"/>جَیسے مَیں نے تُجھے مِصر سے نکلنے کے دِنوں میں دِکھائے تھے،</para>
  <para style="q2" vid="MIC 7:15">مَیں اُن کو اَپنے عجائب دِکھاؤں گا۔<verse eid="MIC 7:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 7:16"/>قومیں دیکھیں گی اَور شرمندہ ہُوں گی،</para>
  <para style="q2" vid="MIC 7:16">اُن سے اُن کی تمام قُوّت چھین لی جائے گی۔</para>
  <para style="q1" vid="MIC 7:16">وہ اَپنے مُنہ پر اَپنا ہاتھ رکھیں گے،</para>
  <para style="q2" vid="MIC 7:16">اَور اُن کے کان بہرے ہو جایٔیں گے۔<verse eid="MIC 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="MIC 7:17"/>وہ سانپ کی طرح خاک چاٹیں گے،</para>
  <para style="q2" vid="MIC 7:17">اَور زمین پر رینگنے والے کیڑوں کی طرح،</para>
  <para style="q1" vid="MIC 7:17">کانپتے ہُوئے اَپنی ماندوں سے باہر آئیں گے؛</para>
  <para style="q2" vid="MIC 7:17">ڈرتے ڈرتے ہمارے یَاہوِہ خُدا کی طرف آئیں گے،</para>
  <para style="q2" vid="MIC 7:17">اَور آپ سے نہ ڈریں گے۔<verse eid="MIC 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MIC 7:18"/>آپ جَیسا خُدا کون ہے،</para>
  <para style="q2" vid="MIC 7:18">جو گُناہ مُعاف کرتا ہے،</para>
  <para style="q2" vid="MIC 7:18">اَور اَپنی مِیراث کے بقیّہ کی خطاؤں کو بخشتا ہے؟</para>
  <para style="q1" vid="MIC 7:18">وہ اَپنا قہر ہمیشہ کے لیٔے نہیں رکھ چھوڑتا،</para>
  <para style="q2" vid="MIC 7:18">بَلکہ رحم کرنے سے خُوش ہوتاہے۔<verse eid="MIC 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MIC 7:19"/>آپ پھر ہم پر رحم فرمایٔے گا؛</para>
  <para style="q2" vid="MIC 7:19">آپ ہمارے گُناہوں کو پیروں تلے کُچلے گا،</para>
  <para style="q2" vid="MIC 7:19">اَور ہماری سَب بدکاریوں کو سمُندر کی تہہ میں ڈال دے گا۔<verse eid="MIC 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MIC 7:20"/>آپ یعقوب کے گھرانے سے وفا شعاری کرےگا،</para>
  <para style="q2" vid="MIC 7:20">اَور اَبراہامؔ کو شفقت دِکھائے گا،</para>
  <para style="q1" vid="MIC 7:20">جِس کی بابت آپ نے قدیم زمانوں میں،</para>
  <para style="q2" vid="MIC 7:20">ہمارے باپ دادوں سے قَسم کھائی تھی۔<verse eid="MIC 7:20"/></para>
  <chapter eid="MIC 7"/>
</usx>
