<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="OBA" style="id">- Biblica® Open Urdu Contemporary Version</book>
  <para style="h">عبدیاہؔ</para>
  <para style="toc1">عبدیاہؔ کی نبُوّت</para>
  <para style="toc2">عبدیاہؔ</para>
  <para style="toc3">عبد</para>
  <para style="mt1">عبدیاہؔ</para>
  <para style="mt2">کی نبُوّت</para>
  <chapter number="1" style="c" sid="OBA 1"/>
  <para style="s1">عبدیاہؔ کی رُویا</para>
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1"/>عبدیاہؔ نبی کی رُویا۔</para>
  <para style="b" vid="OBA 1:1"/>
  <para style="b" vid="OBA 1:1"/>
  <para style="p" vid="OBA 1:1">یَاہوِہ قادر اِدُوم کی بابت یُوں فرماتے ہیں،</para>
  <para style="q1" vid="OBA 1:1">ہم نے یَاہوِہ کی جانِب سے ایک پیغام سُنا ہے،</para>
  <para style="q2" vid="OBA 1:1">اَور اُن قوموں کے درمیان پیغام سُنانے کو ایک قاصِد روانہ کیا گیا ہے،</para>
  <para style="q2" vid="OBA 1:1">اُٹھو، آؤ ہم اِدُوم کے خِلاف جنگ کرنے کو چلیں۔<verse eid="OBA 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2"/>دیکھو، اَب مَیں تُمہیں مُختلف قوموں کے درمیان چھوٹا بناؤں گا؛</para>
  <para style="q2" vid="OBA 1:2">تُم پُوری طرح سے ذلیل ہوگے۔<verse eid="OBA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3"/>تمہارے تکبُّر دِل نے تُمہیں فریب دیا ہے،</para>
  <para style="q2" vid="OBA 1:3">اَے چٹّانوں کے شگاف میں رہنے والے،</para>
  <para style="q2" vid="OBA 1:3">اَور بُلندیوں پر اَپنا مکان تعمیر کرنے والے،</para>
  <para style="q1" vid="OBA 1:3">تُم جو اَپنے دِل میں کہتے ہو،</para>
  <para style="q2" vid="OBA 1:3">کس میں اِتنی قُوّت ہے جو مُجھے نیچے زمین پر لا سکے؟<verse eid="OBA 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4"/>یَاہوِہ فرماتے ہیں،</para>
  <para style="q2" vid="OBA 1:4">اگرچہ تُم عُقاب کی مانند بُلندی پر پرواز کرو</para>
  <para style="q2" vid="OBA 1:4">اَور سِتاروں پر اَپنا گھونسلہ تعمیر کرو،</para>
  <para style="q2" vid="OBA 1:4">تو بھی مَیں تُمہیں وہاں سے بھی نیچے اُتاروں گا۔<verse eid="OBA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5"/>اگر تمہارے گھر میں چور آ جایٔیں،</para>
  <para style="q2" vid="OBA 1:5">یا رات کو ڈاکُو آ جایٔیں،</para>
  <para style="q1" vid="OBA 1:5">تو کیا وہ جِتنا چاہتے،</para>
  <para style="q2" vid="OBA 1:5">اُتنا مال لُوٹ کر نہ لے جائیں گے؟</para>
  <para style="q1" vid="OBA 1:5">اگر انگور توڑنے والے تمہارے پاس آتے،</para>
  <para style="q2" vid="OBA 1:5">تو کیا وہ کچھ انگور چھوڑ نہ جاتے؟<verse eid="OBA 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6"/>لیکن عیسَوؔ کو اِس قدر لُوٹا جائے گا،</para>
  <para style="q2" vid="OBA 1:6">کہ لوگ اُس کے پوشیدہ خزانے ڈھونڈ لیں گے۔<verse eid="OBA 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7"/>اَور تمہارے سارے حمایتی تُمہیں سرحد تک کھدیڑ دیں گے؛</para>
  <para style="q2" vid="OBA 1:7">تمہارے دوست تُم سے دغا کریں گے اَور تُمہیں اَپنے قبضے میں کر لیں گے؛</para>
  <para style="q1" vid="OBA 1:7">جو تمہاری روٹی کھاتے ہیں وُہی تمہارے لئے جال بچھائیں گے،</para>
  <para style="q2" vid="OBA 1:7">لیکن تُمہیں اِس کا پتہ بھی نہ چلے گا۔<verse eid="OBA 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8"/>یَاہوِہ اعلان کرتے ہیں،</para>
  <para style="q2" vid="OBA 1:8">اُس دِن، کیا مَیں اِدُوم کے عقلمندوں</para>
  <para style="q2" vid="OBA 1:8">اَور عیسَوؔ کے پہاڑی صاحبِ فہم باشِندوں کو تباہ نہ کروں گا؟<verse eid="OBA 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9"/>اَے تیمانؔ، تمہارے بہادر خوفزدہ ہوں گے،</para>
  <para style="q2" vid="OBA 1:9">اَور عیسَوؔ کا ہر پہاڑی باشِندہ</para>
  <para style="q2" vid="OBA 1:9">ہلاک کر دیا جائے گا۔<verse eid="OBA 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10"/>اَے عیسَوؔ، اُس ظُلم کے سبب سے جو تُونے اَپنے بھایٔی یعقوب پر کیا تھا،</para>
  <para style="q2" vid="OBA 1:10">تُو بہت شرمندہ ہوگا؛</para>
  <para style="q2" vid="OBA 1:10">اَور ہمیشہ کے لیٔے تباہ ہو جائے گا۔<verse eid="OBA 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11"/>جِس دِن پردیسی لوگ اُن کے شہروں میں داخل ہُوئے،</para>
  <para style="q2" vid="OBA 1:11">اُس دِن تُم دُور کھڑے ہُوئے سَب دیکھ رہے تھے،</para>
  <para style="q2" vid="OBA 1:11">وہ اُس کی دولت لُوٹ کر لے گیٔے،</para>
  <para style="q1" vid="OBA 1:11">اَور یروشلیمؔ کو ہڑپنے کے لیٔے قُرعے ڈالے،</para>
  <para style="q2" vid="OBA 1:11">تو اُس وقت تُم بھی اُس کے دُشمنوں کی مانند سلُوک کر رہے تھے۔<verse eid="OBA 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12"/>تمہارے لئے یہ مُناسب نہیں تھا کہ تُم اَپنے بھائیوں کے مُصیبت کے دِنوں میں</para>
  <para style="q2" vid="OBA 1:12">خاموشی سے کھڑے ہوکر دیکھتے رہتے،</para>
  <para style="q1" vid="OBA 1:12">اَور بنی یہُوداہؔ کی ہلاکت کے دِن شادمان ہوتا،</para>
  <para style="q2" vid="OBA 1:12">اَور اُن کی مُصیبت کے دِنوں میں شیخی مارتا۔<verse eid="OBA 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13"/>تُمہیں مُناسب نہ تھا کہ تُم میرے لوگوں کی مُصیبت کے دِنوں میں،</para>
  <para style="q2" vid="OBA 1:13">اُن کے پھاٹکوں میں گھُستے،</para>
  <para style="q1" vid="OBA 1:13">اَور اُن کی تباہی کے دِن</para>
  <para style="q2" vid="OBA 1:13">خاموش رہ کر دُور کھڑا ہوکر تماشا دیکھتے رہتے،</para>
  <para style="q1" vid="OBA 1:13">اَور اُن کی تباہی کے دِن</para>
  <para style="q2" vid="OBA 1:13">اُن کا مال لُوٹتے۔<verse eid="OBA 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14"/>تمہارے لئے یہ مُناسب نہ تھا کہ اَپنی جان بچا کر فرار ہونے والوں کا</para>
  <para style="q2" vid="OBA 1:14">سَر قلم کرنے کو چوراہوں پر کھڑے ہوتے،</para>
  <para style="q1" vid="OBA 1:14">اَور اُن کی مُصیبت کے دِنوں میں</para>
  <para style="q2" vid="OBA 1:14">زندہ بچے ہوؤں کو اُن کے دُشمنوں کے حوالہ کرتے۔<verse eid="OBA 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15"/>کیونکہ سَب قوموں کے واسطے،</para>
  <para style="q2" vid="OBA 1:15">یَاہوِہ کا مُقرّر دِن نزدیک ہے،</para>
  <para style="q2" vid="OBA 1:15">جَیسا تُم نے کیا ہے وَیسا ہی تمہارے ساتھ بھی کیا جائے گا؛</para>
  <para style="q2" vid="OBA 1:15">تمہارا کیا ہُوا تمہارے ہی سَر پر آئے گا۔<verse eid="OBA 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16"/>جِس طرح تُم نے میرے مُقدّس پہاڑ پر وہ پیالہ پیا،</para>
  <para style="q2" vid="OBA 1:16">اُسی طرح سَب قومیں مُتواتر پیئیں گی؛</para>
  <para style="q1" vid="OBA 1:16">وہ پیتی رہیں گی</para>
  <para style="q2" vid="OBA 1:16">اَور اَیسی ہو جائیں گی گویا کبھی وُجُود میں ہی نہیں تھیں۔<verse eid="OBA 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17"/>لیکن رِہائی کوہِ صِیّونؔ پر مَوجُود ہوگی؛</para>
  <para style="q2" vid="OBA 1:17">اَور وہ مُقدّس مقام ہوگا،</para>
  <para style="q2" vid="OBA 1:17">اَور بنی یعقوب اَپنی مِیراث پر قابض ہوں گے۔<verse eid="OBA 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18"/>بنی یعقوب آگ کی مانند</para>
  <para style="q2" vid="OBA 1:18">اَور بنی یُوسیفؔ شُعلہ کی مانند ہوں گے؛</para>
  <para style="q1" vid="OBA 1:18">اَور بنی عیسَوؔ بچے ہُوئے بھُوسے کی مانند ہوں گے،</para>
  <para style="q2" vid="OBA 1:18">جنہیں وہ آگ میں جَلا کر ہلاک کر دیں گے۔</para>
  <para style="q1" vid="OBA 1:18">اَور بنی عیسَوؔ کے نَسل میں سے</para>
  <para style="q2" vid="OBA 1:18">کویٔی بھی باقی نہ بچے گا۔</para>
  <para style="q1" vid="OBA 1:18">کیونکہ یہ یَاہوِہ کا فرمان ہے۔<verse eid="OBA 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19"/>اَور نِیگیوؔ کے باشِندوں کا</para>
  <para style="q2" vid="OBA 1:19">عیسَوؔ کے پہاڑ پر کا اِختیار ہو جائے گا،</para>
  <para style="q1" vid="OBA 1:19">اَور میدان کے باشِندے</para>
  <para style="q2" vid="OBA 1:19">فلسطین مُلک کے مالک ہوں گے۔</para>
  <para style="q1" vid="OBA 1:19">وہ اِفرائیمؔ اَور سامریہؔ کے کھیتوں پر قابض ہوں جائیں گے،</para>
  <para style="q2" vid="OBA 1:19">اَور بِنیامین گِلعادؔ پر قابض ہو جائے گا۔<verse eid="OBA 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20"/>اَور بنی اِسرائیل کے سَب جَلاوطن لوگ</para>
  <para style="q2" vid="OBA 1:20">جو کنعانؔ میں صارفت تک ہیں</para>
  <para style="q1" vid="OBA 1:20">اَور یروشلیمؔ کے وہ جَلاوطن جو سفارادؔ میں ہیں</para>
  <para style="q2" vid="OBA 1:20">وہ نِیگیوؔ کے شہروں پر قابض ہو جائیں گے۔<verse eid="OBA 1:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21"/>اَور رِہائی دینے والے کوہِ صِیّونؔ پر چڑھیں گے</para>
  <para style="q2" vid="OBA 1:21">تاکہ عیسَوؔ کے پہاڑ پر حُکمرانی کریں۔</para>
  <para style="q2" vid="OBA 1:21">اَور سلطنت یَاہوِہ کی ہو جائے گی۔<verse eid="OBA 1:21"/></para>
  <chapter eid="OBA 1"/>
</usx>
