<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Biblica® Open Urdu Contemporary Version</book>
  <para style="h">2 یُوحنّا</para>
  <para style="toc1">یُوحنّا کا دُوسرا خط</para>
  <para style="toc2">2 یُوحنّا</para>
  <para style="toc3">2 یُوح</para>
  <para style="mt1">یُوحنّا</para>
  <para style="mt2">کا دُوسرا خط</para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="po">
    <verse number="1" style="v" sid="2JN 1:1"/>بُزرگ<note caller="+" style="f"><char style="fr" closed="false">1‏:1 </char><char style="fq" closed="false">بُزرگ </char><char style="ft" closed="false">پہلی صَدی میں بُزرگ کا لقب صِرف اُنہیں حاصل تھا جو خُداوؔند یِسوعؔ المسیح کے چشم دید گواہ تھے۔‏</char></note> حضرت یُوحنّا کی جانِب سے،</para>
  <para style="po" vid="2JN 1:1">اُس برگُزیدہ خاتُون<note caller="+" style="f"><char style="fr" closed="false">1‏:1 </char><char style="fq" closed="false">برگُزیدہ خاتُون </char><char style="ft" closed="false">یعنی جماعت جسے یہ خط لِکھّا گیا تھا۔‏</char></note> اَور اُس کے فرزندوں کے نام خط جِن سے میں سچّی مَحَبّت رکھتا ہوں اَور نہ صِرف میں بَلکہ وہ سَب مُومِنین کو بھی جو حق سے واقف ہیں۔ <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>اَور یہ مَحَبّت اُس سچّائی کے سبب سے ہے جو ہمارے اَندر رہتاہے اَور ہمیشہ تک ہمارے ساتھ رہے گا۔<verse eid="2JN 1:2"/></para>
  <para style="po">
    <verse number="3" style="v" sid="2JN 1:3"/>خُدا باپ اَور خُدا کے بیٹے یِسوعؔ المسیح کی طرف سے فضل، رحم اَور اِطمینان، سچّائی اَور مَحَبّت میں ہمارے ساتھ قائِم رہے گی۔<verse eid="2JN 1:3"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>مُجھے بڑی خُوشی ہُوئی، جَب مُجھے پتا چلا کہ تیرے کچھ فرزند اُس حُکم کے مُطابق سچّائی پر عَمل کر رہے ہیں جو ہمیں باپ کی طرف سے مِلا ہے۔ <verse eid="2JN 1:4"/><verse number="5" style="v" sid="2JN 1:5"/>اَور اَب اَے عزیزہ خاتُون! مَیں تُجھے کویٔی نیا حُکم نہیں بَلکہ صِرف وُہی جو شروع سے ہی ہمارے پاس ہے، لِکھ رہا ہُوں اَور تُم سے مِنّت کرتا ہُوں کہ ہم ایک دُوسرے سے مَحَبّت رکھیں۔ <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>اَور مَحَبّت اِس میں ہے کہ ہم خُدا کے حُکموں پر فرمانبرداری سے چلیں۔ یہ وُہی حُکم ہے جو تُم نے شروع سے سُنا ہے کہ تُم مَحَبّت سے زندگی بسر کرو۔<verse eid="2JN 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7"/>کیونکہ بہت سے اَیسے گُمراہ کرنے والے دُنیا میں نکل چُکے ہیں جو یہ نہیں مانتے ہیں کہ یِسوعؔ المسیح مُجسّم ہوکر آئے ہیں، اَیسا ہر شخص گُمراہ کرنے والا اَور مُخالف المسیح یعنی دَجّال ہے۔ <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>خبردار رہو کہ جو محنت ہم نے کی ہے وہ تمہارے سبب سے ضائع نہ ہو جائے بَلکہ تُمہیں اُس کا مُکمّل اجر ملے۔ <verse eid="2JN 1:8"/><verse number="9" style="v" sid="2JN 1:9"/>جو کویٔی بھٹک کر آگے بڑھ جاتا ہے اَور المسیح کی تعلیم پر قائِم نہیں رہتاہے، اُس میں خُدا نہیں ہے۔ اَورجو اُس کی تعلیم پر قائِم رہتاہے تو اُس کے پاس باپ اَور بیٹا دونوں ہیں۔ <verse eid="2JN 1:9"/><verse number="10" style="v" sid="2JN 1:10"/>اگر کویٔی تمہارے پاس آئے مگر یہ تعلیم نہ دے تو اُسے گھر میں داخل مت ہونے دینا اَور نہ ہی اُسے سلام کرنا۔ <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>کیونکہ جو کویٔی اَیسے شخص کا خیرمقدم کرتا ہے وہ اُن کے بُرے کاموں میں شریک ہوتاہے۔<verse eid="2JN 1:11"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>مُجھے بہت سِی باتیں تُم کو لِکھنا ہیں، مگر میں اُنہیں کاغذ<note caller="+" style="f"><char style="fr" closed="false">1‏:12 </char><char style="ft" closed="false">کاغذ اصل میں پیپرس کی چادر کا حوالہ دیتاہے۔‏</char></note> پر روشنائی سے لِکھنا نہیں چاہتا؛ بَلکہ اُمّید رکھتا ہُوں کہ تمہارے پاس آکر رُوبرو مُلاقات اَور گُفتگو کروں تاکہ ہماری خُوشی مُکمّل ہو جائے۔<verse eid="2JN 1:12"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13"/>تیری برگُزیدہ بہن کے فرزند یعنی جماعت کے مُومِنین تُجھے سلام کہتے ہیں۔<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
