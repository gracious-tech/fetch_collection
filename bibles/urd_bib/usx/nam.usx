<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- Biblica® Open Urdu Contemporary Version</book>
  <para style="h">ناحُومؔ</para>
  <para style="toc1">ناحُومؔ کی نبُوّت</para>
  <para style="toc2">ناحُومؔ</para>
  <para style="toc3">ناحُومؔ</para>
  <para style="mt1">ناحُومؔ</para>
  <para style="mt2">کی نبُوّت</para>
  <chapter number="1" style="c" sid="NAM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1"/>نینوہؔ کی بابت نبُوّت۔ ناحُومؔ القوشی کی رُویا کی کِتاب۔<verse eid="NAM 1:1"/></para>
  <para style="b"/>
  <para style="s1">نینوہؔ کے خِلاف یَاہوِہ کا قہر</para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 1:2"/>یَاہوِہ غیّور ہیں اَور اِنتقام لینے والے خُدا ہیں؛</para>
  <para style="q2" vid="NAM 1:2">یَاہوِہ اِنتقام لیتے ہیں اَور غضب سے معموُر ہیں۔</para>
  <para style="q1" vid="NAM 1:2">یَاہوِہ اَپنے مُخالفوں سے اِنتقام لیتے ہیں</para>
  <para style="q2" vid="NAM 1:2">اَور اَپنے دُشمنوں کے خِلاف اَپنے قہر کو نازل کرتے ہیں۔<verse eid="NAM 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 1:3"/>یَاہوِہ قہر کرنے میں دھیمے اَور قُوّت میں غنی ہیں؛</para>
  <para style="q2" vid="NAM 1:3">یَاہوِہ مُجرم کو بے سزا نہ چھوڑیں گے۔</para>
  <para style="q1" vid="NAM 1:3">اُن کی راہ بگُولہ اَور گِردباد میں سے ہوکر گُزرتی ہے</para>
  <para style="q2" vid="NAM 1:3">اَور بادل اُن کے پاؤں کی گَرد ہیں۔<verse eid="NAM 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 1:4"/>وہ سمُندر کو ڈانٹتے ہیں اَور اُسے سُکھا دیتے ہیں؛</para>
  <para style="q2" vid="NAM 1:4">وہ سَب دریاؤں کو سُکھا دیتے ہیں۔</para>
  <para style="q1" vid="NAM 1:4">باشانؔ اَور کرمِلؔ سُوکھ جاتے ہیں</para>
  <para style="q2" vid="NAM 1:4">اَور لبانونؔ کی کونپلیں مُرجھا جاتی ہیں۔<verse eid="NAM 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 1:5"/>اُن کے سامنے پہاڑ کانپتے ہیں</para>
  <para style="q2" vid="NAM 1:5">اَور ٹیلے پگھل جاتے ہیں۔</para>
  <para style="q1" vid="NAM 1:5">اُن کے سامنے تمام دُنیا</para>
  <para style="q2" vid="NAM 1:5">اَور اُن میں رہنے والے تھرتھراتے ہیں۔<verse eid="NAM 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 1:6"/>اُن کے قہر کا سامنا کون کر سکتا ہے؟</para>
  <para style="q2" vid="NAM 1:6">اَور کون اُن کے ہیبت ناک غضب کو برداشت کر سَکتا ہے؟</para>
  <para style="q1" vid="NAM 1:6">اُن کا غُصّہ آگ کی طرح نازل ہوتاہے؛</para>
  <para style="q2" vid="NAM 1:6">اُن کے سامنے چٹّانیں لرز جاتی ہیں۔<verse eid="NAM 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 1:7"/>یَاہوِہ بھلےہیں اَور،</para>
  <para style="q2" vid="NAM 1:7">مُصیبت میں پناہ گاہ ہیں۔</para>
  <para style="q1" vid="NAM 1:7">جو اُن پر توکّل رکھتے ہیں، وہ اُن کی فکر کرتے ہیں،<verse eid="NAM 1:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="NAM 1:8"/>لیکن وہ ایک بڑے سیلاب سے</para>
  <para style="q1" vid="NAM 1:8">نینوہؔ کو تباہ کر دیں گے؛</para>
  <para style="q2" vid="NAM 1:8">وہ اَپنے دُشمنوں کو تاریکی میں کھدیڑ دیں گے۔<verse eid="NAM 1:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 1:9"/>یَاہوِہ کے خِلاف جو بھی منصُوبہ باندھیں گے</para>
  <para style="q2" vid="NAM 1:9">وہ اُسے مٹا دیں گے؛</para>
  <para style="q2" vid="NAM 1:9">مُصیبت دوبارہ نہ آئے گی۔<verse eid="NAM 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 1:10"/>کیونکہ چاہے اُن کے دُشمن اُلجھے ہُوئے کانٹوں کی مانند پیچیدہ</para>
  <para style="q2" vid="NAM 1:10">اَور اَپنی مَے سے متوالے ہوں؛</para>
  <para style="q2" vid="NAM 1:10">تَو بھی وہ سُوکھنے کھونٹوں کی طرح جَل کر بھسم ہو جایٔیں گے۔<verse eid="NAM 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 1:11"/>اَے نینوہؔ، تُجھ میں سے ایک شخص نِکلا ہے،</para>
  <para style="q2" vid="NAM 1:11">جو یَاہوِہ کے خِلاف بُرے منصُوبہ باندھتا ہے</para>
  <para style="q2" vid="NAM 1:11">اَور بُرائی کی سازش کرتا ہے۔<verse eid="NAM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NAM 1:12"/>یَاہوِہ یُوں فرماتے ہیں:</para>
  <para style="q1" vid="NAM 1:12">اگرچہ اُن کے مددگار بے شُمار ہیں،</para>
  <para style="q2" vid="NAM 1:12">تو بھی وہ نِیست و نابود کر دئیے جایٔیں گے اَور وہ مِٹ جایٔیں گے۔</para>
  <para style="q1" vid="NAM 1:12">اَے یہُوداہؔ، اگرچہ مَیں نے تُجھے بہت ستایا ہے،</para>
  <para style="q2" vid="NAM 1:12">تو بھی پھر کبھی مَیں تُجھے اَور دُکھ نہ دُوں گا۔<verse eid="NAM 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 1:13"/>اَب مَیں تمہاری گردن پر رکھے اُن کا جُوا توڑ ڈالُوں گا</para>
  <para style="q2" vid="NAM 1:13">اَور تمہاری بِیڑیوں کو ٹکڑے ٹکڑے کر دُوں گا۔<verse eid="NAM 1:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 1:14"/>اَے نینوہؔ، تمہاری بابت یَاہوِہ نے ایک حُکم دیا ہے،</para>
  <para style="q2" vid="NAM 1:14">تمہاری نَسل باقی نہ رہے گی،</para>
  <para style="q1" vid="NAM 1:14">میں تمہاری کھودی ہُوئی مورتوں اَور ڈھالے ہُوئے بُتوں کو</para>
  <para style="q2" vid="NAM 1:14">جو تمہارے معبُودوں کے بُت خانوں میں رکھی ہیں، تباہ کر دُوں گا۔</para>
  <para style="q1" vid="NAM 1:14">چونکہ تُو نکمّا ہے،</para>
  <para style="q2" vid="NAM 1:14">اِس لئے میں تمہاری قبر کھودوں گا۔<verse eid="NAM 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 1:15"/>اُن پہاڑوں کی طرف نظر اُٹھاکر،</para>
  <para style="q2" vid="NAM 1:15">اُس کے پاؤں کو دیکھ جو خُوشخبری لاتا،</para>
  <para style="q2" vid="NAM 1:15">اَور سلامتی کا اعلان کرتا ہے!</para>
  <para style="q1" vid="NAM 1:15">اَے یہُوداہؔ، اَپنی عیدیں منا،</para>
  <para style="q2" vid="NAM 1:15">اَور اَپنی مَنّتیں پُوری کر۔</para>
  <para style="q1" vid="NAM 1:15">کیونکہ پھر بدکار تُجھ پر حملہ نہ کریں گے؛</para>
  <para style="q2" vid="NAM 1:15">کیونکہ وہ مُکمّل طور سے فنا کر دئیے جایٔیں گے۔<verse eid="NAM 1:15"/></para>
  <chapter eid="NAM 1"/>
  <chapter number="2" style="c" sid="NAM 2"/>
  <para style="s1">نینوہؔ برباد ہوگا</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 2:1"/>اَے نینوہؔ، ایک حملہ آور تُجھ پر چڑھ آیا ہے،</para>
  <para style="q2" vid="NAM 2:1">اَپنے قلعہ کو محفوظ رکھ،</para>
  <para style="q2" vid="NAM 2:1">راہ کی نگہبانی کر،</para>
  <para style="q2" vid="NAM 2:1">کمر کس لے،</para>
  <para style="q2" vid="NAM 2:1">اَور اَپنی ساری طاقت کو جمع کر۔<verse eid="NAM 2:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 2:2"/>یَاہوِہ یعقوب کی ساری شان و شوکت کو،</para>
  <para style="q2" vid="NAM 2:2">اِسرائیل کی شان کی مانند بحال کرےگا،</para>
  <para style="q1" vid="NAM 2:2">اگرچہ غارت کرنے والوں نے اُنہیں غارت کر دیا ہے</para>
  <para style="q2" vid="NAM 2:2">اَور اُن کے تاک کی شاخوں کو اُجاڑ دیا ہے۔<verse eid="NAM 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 2:3"/>تیّاری کے دِن اُس کے جنگی بہادروں کی ڈھالیں سُرخ ہیں؛</para>
  <para style="q2" vid="NAM 2:3">جنگی مَرد قِرمزی لباس پہنے ہیں۔</para>
  <para style="q1" vid="NAM 2:3">تیّاری کے دِن اُن کے رتھوں کی فولاد چمچماتی ہے؛</para>
  <para style="q2" vid="NAM 2:3">صنوبر کے نیزے لہرا رہے ہیں۔<verse eid="NAM 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 2:4"/>راستوں پر رتھ تیزی سے دَوڑ رہے ہیں،</para>
  <para style="q2" vid="NAM 2:4">وہ چَوک کے میدان میں اِدھر سے اُدھر دَوڑ رہے ہیں۔</para>
  <para style="q1" vid="NAM 2:4">وہ مشعلوں کی مانند دِکھائی دیتے ہیں؛</para>
  <para style="q2" vid="NAM 2:4">وہ بجلی کی مانند کوند رہے ہیں۔<verse eid="NAM 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 2:5"/>وہ اَپنے مُنتخب فَوجیوں کو بُلاتا ہے،</para>
  <para style="q2" vid="NAM 2:5">پر وہ اَپنے راستوں پر ٹھوکر کھاتے ہیں۔</para>
  <para style="q1" vid="NAM 2:5">اَور شہرپناہ سے ٹکراتے ہیں؛</para>
  <para style="q2" vid="NAM 2:5">حِفاظت کرنے والی آڑ اَپنی جگہ پر رکھ دی گئی ہے۔<verse eid="NAM 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 2:6"/>دریاؤں کے پھاٹک کھُل جاتے ہیں،</para>
  <para style="q2" vid="NAM 2:6">اَور محل ڈھیر ہوکر رہ جاتے ہیں۔<verse eid="NAM 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 2:7"/>یہ طے ہو چُکاہے کہ شہر والے،</para>
  <para style="q2" vid="NAM 2:7">جَلاوطنی میں لے جائے جایٔیں۔</para>
  <para style="q1" vid="NAM 2:7">اُن کی لونڈیاں قُمریوں کی طرح ماتم کریں،</para>
  <para style="q2" vid="NAM 2:7">اَور چھاتِیاں پیٹیں۔<verse eid="NAM 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 2:8"/>نینوہؔ ایک حوض کی مانند ہے،</para>
  <para style="q2" vid="NAM 2:8">اُس کا پانی نکالا جا رہاہے۔</para>
  <para style="q1" vid="NAM 2:8">لوگ چِلاّتے ہیں، ”ٹھہرو، ٹھہرو،“</para>
  <para style="q2" vid="NAM 2:8">پر کویٔی مُڑ کر نہیں دیکھتا۔<verse eid="NAM 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 2:9"/>چاندی لُوٹو!</para>
  <para style="q2" vid="NAM 2:9">سونا لُوٹو!</para>
  <para style="q1" vid="NAM 2:9">مال کی کویٔی اِنتہا نہیں،</para>
  <para style="q2" vid="NAM 2:9">خزانوں میں دولت کثرت سے ہے!<verse eid="NAM 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 2:10"/>وہ خالی ہے، لُوٹ لیا گیا ہے، ویران ہے!</para>
  <para style="q2" vid="NAM 2:10">دِل پگھل جاتے ہیں، گھُٹنے لڑکھڑاتے ہیں،</para>
  <para style="q2" vid="NAM 2:10">جِسم کانپتے ہیں، ہر چہرہ زرد ہو جاتا ہے۔<verse eid="NAM 2:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 2:11"/>اَب شیر کی ماند کہاں ہے،</para>
  <para style="q2" vid="NAM 2:11">وہ جگہ جہاں وہ اَپنے بچّوں کو خُوراک کھِلاتے تھے،</para>
  <para style="q1" vid="NAM 2:11">شیر، شیرنی اَور اُن کے بچّے کہاں گیٔے،</para>
  <para style="q2" vid="NAM 2:11">جہاں وہ بے خوف پھرا کرتے تھے؟<verse eid="NAM 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 2:12"/>شیرببر اَپنے بچّوں کے لیٔے بہت شِکار مارتا تھا،</para>
  <para style="q2" vid="NAM 2:12">اَور اَپنی شیرنی کے لیٔے شِکار کا گلا گھونٹتا تھا،</para>
  <para style="q1" vid="NAM 2:12">اَور اَپنی ماندوں کو شِکار سے،</para>
  <para style="q2" vid="NAM 2:12">اَور غاروں کو پھاڑے ہوئے جانوروں سے بھر دیتا تھا۔<verse eid="NAM 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 2:13"/>قادرمُطلق یَاہوِہ فرماتے ہیں،</para>
  <para style="q2" vid="NAM 2:13">”مَیں تیرا مُخالف ہُوں،</para>
  <para style="q1" vid="NAM 2:13">مَیں تمہارے رتھوں کو دُھواں بنا دُوں گا،</para>
  <para style="q2" vid="NAM 2:13">اَور تلوار تمہارے جَوان شیروں کو نگل جائے گی۔</para>
  <para style="q2" vid="NAM 2:13">میں زمین پر تمہارے لیٔے کویٔی شِکار نہیں چھوڑوں گا۔</para>
  <para style="q1" vid="NAM 2:13">تمہارے قاصِدوں کی آوازیں،</para>
  <para style="q2" vid="NAM 2:13">پھر کبھی سُنایٔی نہ دیں گی۔“<verse eid="NAM 2:13"/></para>
  <chapter eid="NAM 2"/>
  <chapter number="3" style="c" sid="NAM 3"/>
  <para style="s1">نینوہؔ پر ماتم</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 3:1"/>خُونی شہر پر افسوس،</para>
  <para style="q2" vid="NAM 3:1">وہ جھُوٹ</para>
  <para style="q1" vid="NAM 3:1">اَور غارت گری سے بھرا ہُواہے</para>
  <para style="q2" vid="NAM 3:1">وہ کبھی جُرم سے باز نہیں رہتا!<verse eid="NAM 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 3:2"/>چابک کے چٹخنے کی آواز،</para>
  <para style="q2" vid="NAM 3:2">پہیّوں کی کھڑکھڑاہٹ،</para>
  <para style="q1" vid="NAM 3:2">گھوڑوں کی ٹاپ،</para>
  <para style="q2" vid="NAM 3:2">اَور رتھوں کے ہچکولوں کی آواز!<verse eid="NAM 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 3:3"/>حملہ آور لشکر،</para>
  <para style="q2" vid="NAM 3:3">تلواروں کی چمک،</para>
  <para style="q2" vid="NAM 3:3">اَور بھالوں کی جھلک!</para>
  <para style="q1" vid="NAM 3:3">مقتولوں کے ڈھیر،</para>
  <para style="q2" vid="NAM 3:3">لاشوں کے انبار،</para>
  <para style="q1" vid="NAM 3:3">بے شُمار لاشیں،</para>
  <para style="q2" vid="NAM 3:3">جِن سے لوگ ٹھوکریں کھاتے ہیں۔<verse eid="NAM 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 3:4"/>یہ سَب اُس کسبی اَور فاحِشہ کی بدکاری کے سبب سے ہے،</para>
  <para style="q2" vid="NAM 3:4">جِس نے فاحِشہ پن سے قوموں کو،</para>
  <para style="q1" vid="NAM 3:4">اَور جادُو سے لوگوں کو</para>
  <para style="q2" vid="NAM 3:4">غُلام بنا لیا ہے۔<verse eid="NAM 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 3:5"/>قادرمُطلق یَاہوِہ فرماتے ہیں کہ مَیں تیرا مُخالف ہُوں۔</para>
  <para style="q2" vid="NAM 3:5">مَیں تُجھے تمہارے مُنہ تک ننگا کروں گا۔</para>
  <para style="q1" vid="NAM 3:5">اَور قوموں کو تیرا ننگا پن دِکھاؤں گا،</para>
  <para style="q2" vid="NAM 3:5">اَور مملکتوں کو تمہاری برہنگی دِکھاؤں گا۔<verse eid="NAM 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 3:6"/>مَیں تمہارے اُوپر گندگی ڈالُوں گا،</para>
  <para style="q2" vid="NAM 3:6">میں نفرت کا سلُوک کروں گا</para>
  <para style="q2" vid="NAM 3:6">تُجھے رُسوا کروں گا۔<verse eid="NAM 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 3:7"/>جو کویٔی تُجھ پر نظر کرےگا بھاگ جائے گا،</para>
  <para style="q2" vid="NAM 3:7">اَور کہے گا نینوہؔ برباد ہو رہاہے، کون اُس کے لیٔے ماتم کرےگا؟</para>
  <para style="q2" vid="NAM 3:7">مَیں تمہارے لیٔے تسلّی دینے والا کہاں سے لاؤں؟<verse eid="NAM 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 3:8"/>کیا تُو تھیبیس سے بڑھ کر ہے،</para>
  <para style="q2" vid="NAM 3:8">جو دریائے نیل پر بسا ہُواہے،</para>
  <para style="q2" vid="NAM 3:8">اَور اُس کے چاروں طرف پانی ہے؟</para>
  <para style="q1" vid="NAM 3:8">ندی اُس کی مُحافظ تھی،</para>
  <para style="q2" vid="NAM 3:8">اَور پانی اُس کی دیوار تھا۔<verse eid="NAM 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 3:9"/>کُوشؔ اَور مِصر اُس کی بے اِنتہا طاقت تھے؛</para>
  <para style="q2" vid="NAM 3:9">فُوطؔ اَور لیبیا اُس کے حمایتی تھے۔<verse eid="NAM 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 3:10"/>تو بھی وہ اسیر ہُوا اَور جَلاوطنی میں گیا۔</para>
  <para style="q2" vid="NAM 3:10">ہر گلی کے نکّڑ پر</para>
  <para style="q1" vid="NAM 3:10">اُس کے دُودھ پیتے بچّے پٹک کر ٹکڑے کر دئیے گیٔے۔</para>
  <para style="q2" vid="NAM 3:10">اُس کے مُعزّز</para>
  <para style="q1" vid="NAM 3:10">لوگوں پر قُرعہ ڈالے گیٔے،</para>
  <para style="q2" vid="NAM 3:10">اَور اُس کے سارے بُزرگ زنجیروں میں جکڑ دئیے گیٔے۔<verse eid="NAM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 3:11"/>تُو بھی متوالا ہو جائے گا؛</para>
  <para style="q2" vid="NAM 3:11">تُو دُشمن سے بچنے کے لیٔے پناہ مانگے گا</para>
  <para style="q2" vid="NAM 3:11">اَور خُود کو چُھپائے گا۔<verse eid="NAM 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 3:12"/>تمہارے سارے قلعے اَنجیر کے درختوں کی مانند ہوں گے</para>
  <para style="q2" vid="NAM 3:12">جِن پر پہلی فصل کے پکے پھل لگے ہُوں؛</para>
  <para style="q1" vid="NAM 3:12">جَب اُن کو ہلایا جاتا ہے،</para>
  <para style="q2" vid="NAM 3:12">تو کھانے والے کے مُنہ میں پھل گرتا ہے۔<verse eid="NAM 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 3:13"/>اَپنے جنگی بہادروں کو دیکھ۔</para>
  <para style="q2" vid="NAM 3:13">تمہارے مَرد عورتیں بَن گیٔے ہیں!</para>
  <para style="q1" vid="NAM 3:13">تمہارے مُلک کے پھاٹک</para>
  <para style="q2" vid="NAM 3:13">تمہارے دُشمنوں کے لیٔے کھُل گیٔے ہیں؛</para>
  <para style="q2" vid="NAM 3:13">آگ اڑبنگوں کو کھا گئی۔<verse eid="NAM 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 3:14"/>محاصرے کے لیٔے پانی بھر لے،</para>
  <para style="q2" vid="NAM 3:14">اَپنے قلعوں کو مضبُوط کر!</para>
  <para style="q1" vid="NAM 3:14">مٹّی تیّار کر،</para>
  <para style="q2" vid="NAM 3:14">روند کر مَسالہ بنا،</para>
  <para style="q2" vid="NAM 3:14">اینٹ کے سانچے کی مرمّت کر!<verse eid="NAM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 3:15"/>وہاں آگ تُجھے کھا جائے گی؛</para>
  <para style="q2" vid="NAM 3:15">تلوار تُجھے کاٹ ڈالے گی</para>
  <para style="q2" vid="NAM 3:15">اَور ٹِڈّی کی طرح تُجھے کھا جائے گی۔</para>
  <para style="q1" vid="NAM 3:15">ٹِڈّیوں کی طرح</para>
  <para style="q2" vid="NAM 3:15">اَپنا شُمار بڑھا!<verse eid="NAM 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="NAM 3:16"/>تُم نے اَپنے سوداگروں کو</para>
  <para style="q2" vid="NAM 3:16">آسمان کے سِتاروں سے زِیادہ بڑھا لیا ہے،</para>
  <para style="q1" vid="NAM 3:16">لیکن وہ ٹِڈّیوں کی طرح چٹ کرکے</para>
  <para style="q2" vid="NAM 3:16">اُڑ جاتے ہیں۔<verse eid="NAM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="NAM 3:17"/>تمہارے مُحافظ ٹِڈّیوں کے غول کی مانند ہیں،</para>
  <para style="q2" vid="NAM 3:17">تمہارے سردار ٹِڈّیوں کے غول کی طرح ہیں</para>
  <para style="q2" vid="NAM 3:17">جِس کی ٹِڈّیاں سردی کے دِن دیوار کے شگافوں میں پناہ لیتی ہیں۔</para>
  <para style="q1" vid="NAM 3:17">لیکن سُورج نکلتے ہی اُڑ جاتی ہیں،</para>
  <para style="q2" vid="NAM 3:17">کویٔی نہیں جانتا کہاں۔<verse eid="NAM 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="NAM 3:18"/>اَے اشُور کے بادشاہ، تمہارے چرواہے اُونگھتے ہیں؛</para>
  <para style="q2" vid="NAM 3:18">تمہارے سردار آرام سے سَو رہے ہیں۔</para>
  <para style="q1" vid="NAM 3:18">تمہاری رعایا پہاڑوں پر مُنتشر ہو گئی</para>
  <para style="q2" vid="NAM 3:18">اُنہیں جمع کرنے والا کویٔی نہیں۔<verse eid="NAM 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NAM 3:19"/>کویٔی چیز تمہارے زخموں کو شفا نہیں دے سکتی؛</para>
  <para style="q2" vid="NAM 3:19">تیرا زخم لاعلاج ہے۔</para>
  <para style="q1" vid="NAM 3:19">جو کویٔی تمہارے بارے میں سُنتا ہے</para>
  <para style="q2" vid="NAM 3:19">وہ تمہاری بربادی پر خُوش ہوکر تالی بجاتا ہے،</para>
  <para style="q1" vid="NAM 3:19">کیونکہ کون ہے</para>
  <para style="q2" vid="NAM 3:19">جِس نے تیرا ظُلم نہیں سہا؟<verse eid="NAM 3:19"/></para>
  <chapter eid="NAM 3"/>
</usx>
