<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Biblica® Open Urdu Contemporary Version</book>
  <para style="h">یُوایلؔ</para>
  <para style="toc1">یُوایلؔ کی نبُوّت</para>
  <para style="toc2">یُوایلؔ</para>
  <para style="toc3">یُوایلؔ</para>
  <para style="mt1">یُوایلؔ</para>
  <para style="mt2">کی نبُوّت</para>
  <chapter number="1" style="c" sid="JOL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1"/>یَاہوِہ کا کلام جو پتھوایلؔ کے بیٹے یُوایلؔ پر نازل ہُوا۔<verse eid="JOL 1:1"/></para>
  <para style="b"/>
  <para style="s1">ٹِڈّیوں کا حملہ</para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2"/>اَے رہنماؤں سُنو؛</para>
  <para style="q2" vid="JOL 1:2">اَے مُلک کے تمام باشِندو کان لگا کر میری بات سُنو۔</para>
  <para style="q1" vid="JOL 1:2">کیا تمہارے یا، آپ کے آباؤاَجداد کے زمانے میں؟</para>
  <para style="q2" vid="JOL 1:2">تمہارے آباؤاَجداد کے ایّام میں کبھی اَیسا ہُوا؟<verse eid="JOL 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3"/>اَپنی اَولاد سے اُس کا تذکرہ کرو،</para>
  <para style="q2" vid="JOL 1:3">اَور تمہاری اَولاد اَپنی اَولاد کو،</para>
  <para style="q2" vid="JOL 1:3">اَور اُن کی اَولاد آنے والی نَسل کو بتائیں۔<verse eid="JOL 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4"/>جو کچھ ٹِڈّیوں کے غول سے بچا</para>
  <para style="q2" vid="JOL 1:4">اُسے بڑی ٹِڈّیوں نے کھا لیا؛</para>
  <para style="q1" vid="JOL 1:4">اَورجو بڑی ٹِڈّیوں نے چھوڑ دیا</para>
  <para style="q2" vid="JOL 1:4">اُسے جَوان ٹِڈّیوں نے کھا لیا؛</para>
  <para style="q1" vid="JOL 1:4">اَورجو جَوان ٹِڈّیوں نے چھوڑ دیا</para>
  <para style="q2" vid="JOL 1:4">اُسے دُوسری ٹِڈّیوں نے کھا لیا۔<verse eid="JOL 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5"/>اَے متوالوں، جاگو اَور رو!</para>
  <para style="q2" vid="JOL 1:5">اَے مَے نوشی کرنے والوں، ماتم کرو؛</para>
  <para style="q1" vid="JOL 1:5">نئی مَے کی خاطِر ماتم کرو،</para>
  <para style="q2" vid="JOL 1:5">کیونکہ وہ تمہارے لبوں سے چھین لی گئی ہے۔<verse eid="JOL 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6"/>ایک قوم نے میرے مُلک پر حملہ کر دیا ہے؛</para>
  <para style="q2" vid="JOL 1:6">اُن کی زبردست فَوج اَور تعداد میں بے شُمار ہے؛</para>
  <para style="q1" vid="JOL 1:6">اُن کے دانت شیرببر کے دانتوں کی مانند ہیں،</para>
  <para style="q2" vid="JOL 1:6">اَور اُن کی داڑھیں شیرنی کی داڑھوں کے مانند ہیں۔<verse eid="JOL 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7"/>اُس قوم نے میری انگور کی بَیلوں کو اُجاڑ ڈالا</para>
  <para style="q2" vid="JOL 1:7">اَور میرے اَنجیر کے درختوں کو تباہ کر دیا ہے۔</para>
  <para style="q1" vid="JOL 1:7">اُنہُوں نے اُن کی چھال چھیل ڈالی</para>
  <para style="q2" vid="JOL 1:7">اَور اُنہیں پھینک دیا ہے،</para>
  <para style="q2" vid="JOL 1:7">جِس سے اُن کی شاخیں سفید ہو گئیں ہیں۔<verse eid="JOL 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8"/>جِس طرح دُلہن اَپنے جَوان خَاوند کے لئے ٹاٹ پہن کر ماتم کرتی ہے</para>
  <para style="q2" vid="JOL 1:8">ٹھیک اُسی طرح تُم بھی ماتم کرو۔<verse eid="JOL 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9"/>اناج کی نذریں اَور تپاون نذریں،</para>
  <para style="q2" vid="JOL 1:9">یَاہوِہ کے گھر سے موقُوف ہو چُکے ہیں۔</para>
  <para style="q1" vid="JOL 1:9">یَاہوِہ کی حُضُوری میں خدمت گذار کاہِنؔ</para>
  <para style="q2" vid="JOL 1:9">ماتم کر رہے ہیں۔<verse eid="JOL 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10"/>کھیت تباہ ہو گئے،</para>
  <para style="q2" vid="JOL 1:10">اَور زمین خشک ہو گئی؛</para>
  <para style="q1" vid="JOL 1:10">اناج برباد ہو گیا،</para>
  <para style="q2" vid="JOL 1:10">اَور نئی مَے سُوکھ گئی،</para>
  <para style="q2" vid="JOL 1:10">اَور زَیتُون کا تیل ختم ہو گیا۔<verse eid="JOL 1:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11"/>اَے کِسانوں، مایوس ہو جاؤ،</para>
  <para style="q2" vid="JOL 1:11">اَے تاکستان کے باغبانوں، نوحہ کرو؛</para>
  <para style="q1" vid="JOL 1:11">گیہُوں اَور جَو کے لیٔے ماتم کرو،</para>
  <para style="q2" vid="JOL 1:11">کیونکہ کھیتوں کی فصل برباد ہو چُکی ہیں۔<verse eid="JOL 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12"/>انگور کی بیل سُوکھ گئی</para>
  <para style="q2" vid="JOL 1:12">اَور اَنجیر کا درخت مُرجھاگیا؛</para>
  <para style="q1" vid="JOL 1:12">انار، کھجور اَور سیب کے درخت</para>
  <para style="q2" vid="JOL 1:12">الغرض کھیت کے تمام درخت سُوکھ گیٔے ہیں۔</para>
  <para style="q1" vid="JOL 1:12">یقیناً بنی آدمؔ کی خُوشی بھی</para>
  <para style="q2" vid="JOL 1:12">مُرجھا گئی ہے۔<verse eid="JOL 1:12"/></para>
  <para style="s1">نوحہ خوانی</para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13"/>اَے کاہِنوں، ٹاٹ پہن لو اَور ماتم کرو؛</para>
  <para style="q2" vid="JOL 1:13">اَے مذبح کے خدمت گزارو، ماتم کرو۔</para>
  <para style="q1" vid="JOL 1:13">اَے میرے خُدا کے خدمت گزارو،</para>
  <para style="q2" vid="JOL 1:13">آؤ اَور ٹاٹ اوڑھے ہُوئے رات گُزارو؛</para>
  <para style="q1" vid="JOL 1:13">کیونکہ اناج کی نذر اَور تپاون کی نذر کی قُربانیاں</para>
  <para style="q2" vid="JOL 1:13">تمہارے خُدا کے گھر سے موقُوف ہو چُکے ہیں۔<verse eid="JOL 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14"/>مُقدّس روزہ کا اعلان کرو؛</para>
  <para style="q2" vid="JOL 1:14">اَور مُقدّس اِجتماع طلب کرو۔</para>
  <para style="q1" vid="JOL 1:14">رہنماؤں کو</para>
  <para style="q2" vid="JOL 1:14">اَور مُلک کے تمام باشِندوں کو</para>
  <para style="q1" vid="JOL 1:14">یَاہوِہ اَپنے خُدا کے گھر میں آنے کا فرمان سُناؤ،</para>
  <para style="q2" vid="JOL 1:14">اَور یَاہوِہ سے فریاد کرو۔<verse eid="JOL 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15"/>اُس دِن پر افسوس!</para>
  <para style="q2" vid="JOL 1:15">کیونکہ یَاہوِہ کا دِن نزدیک ہے،</para>
  <para style="q2" vid="JOL 1:15">اَور وہ قادرمُطلق کی طرف سے تباہی کی مانند آئے گا۔<verse eid="JOL 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16"/>کیا ہماری اَپنی آنکھوں کے سامنے</para>
  <para style="q2" vid="JOL 1:16">رسد موقُوف نہیں ہُوئی۔</para>
  <para style="q1" vid="JOL 1:16">اَور ہمارے خُدا کے گھر سے</para>
  <para style="q2" vid="JOL 1:16">خُوشی اَور شادمانی جاتی نہ رہی؟<verse eid="JOL 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17"/>مٹّی کے ڈھیلوں کے نیچے</para>
  <para style="q2" vid="JOL 1:17">بیج جھُلس گیٔے۔</para>
  <para style="q1" vid="JOL 1:17">گودام خستہ حال ہیں،</para>
  <para style="q2" vid="JOL 1:17">اَور کھتّے توڑ دئیے گیٔے ہیں،</para>
  <para style="q2" vid="JOL 1:17">کیونکہ کھیتی سُوکھ گی ہے۔<verse eid="JOL 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18"/>مویشی کیسے کراہ رہے ہیں!</para>
  <para style="q2" vid="JOL 1:18">ریوڑ چکّر کاٹ رہے ہیں</para>
  <para style="q1" vid="JOL 1:18">کیونکہ اُن کے لیٔے چراگاہ نہیں ہے؛</para>
  <para style="q2" vid="JOL 1:18">یہاں تک کہ بھیڑوں کے گلّے بھی بدحال ہیں۔<verse eid="JOL 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19"/>اَے یَاہوِہ، مَیں آپ کے حُضُور میں فریاد کرتا ہُوں،</para>
  <para style="q2" vid="JOL 1:19">کیونکہ آگ نے بیابان کی چراگاہوں کو بھسم کر ڈالا ہے</para>
  <para style="q2" vid="JOL 1:19">اَور شُعلوں نے جنگل کے تمام درختوں کو جَلا ڈالا ہے۔<verse eid="JOL 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20"/>یہاں تک کی جنگلی جانور بھی آپ کے لیٔے ہانپتے ہیں؛</para>
  <para style="q2" vid="JOL 1:20">پانی کے چشمے سُوکھ چُکے ہیں</para>
  <para style="q2" vid="JOL 1:20">اَور آگ نے بیابان کی چراگاہوں کو بھسم کر ڈالا ہے۔<verse eid="JOL 1:20"/></para>
  <chapter eid="JOL 1"/>
  <chapter number="2" style="c" sid="JOL 2"/>
  <para style="s1">ٹِڈّیوں کی فَوج</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1"/>صِیّونؔ میں نرسنگا پھُونکو؛</para>
  <para style="q2" vid="JOL 2:1">میرے کوہِ مُقدّس پر خطرہ کی خبر سُناؤ۔</para>
  <para style="b" vid="JOL 2:1"/>
  <para style="q1" vid="JOL 2:1">مُلک کے تمام باشِندے تھرتھرائیں،</para>
  <para style="q2" vid="JOL 2:1">کیونکہ یَاہوِہ کا دِن آ رہاہے۔</para>
  <para style="q1" vid="JOL 2:1">وہ بالکُل قریب آ گیا ہے۔<verse eid="JOL 2:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="JOL 2:2"/>وہ تاریکی اَور اُداسی کا،</para>
  <para style="q2" vid="JOL 2:2">اَور کالے بادل اَور ظلمت کا دِن ہے۔</para>
  <para style="q1" vid="JOL 2:2">جَیسے پہاڑوں پر صُبح کی رَوشنی پھیلتی ہے</para>
  <para style="q2" vid="JOL 2:2">وَیسے ہی ایک بڑی اَور زبردست فَوج آ رہی ہے،</para>
  <para style="q1" vid="JOL 2:2">اَیسا جو قدیم زمانہ میں کبھی نہیں ہُوا تھا</para>
  <para style="q2" vid="JOL 2:2">اَور نہ ہی مُستقبِل میں کبھی اَیسا ہوگا۔<verse eid="JOL 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3"/>اُن کے آگے آگے آگ بھسم کرتی جاتی ہے،</para>
  <para style="q2" vid="JOL 2:3">اَور اُن کے پیچھے شُعلے کی لپٹیں ہیں۔</para>
  <para style="q1" vid="JOL 2:3">اُن کے سامنے کی زمین باغِ عدنؔ کی مانند ہے،</para>
  <para style="q2" vid="JOL 2:3">اَور اُن کے پیچھے ایک ویران بیابان ہے۔</para>
  <para style="q2" vid="JOL 2:3">کویٔی چیز اُن سے نہیں بچ پاتی۔<verse eid="JOL 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4"/>اُن کی شکل گھوڑوں کی مانند ہے؛</para>
  <para style="q2" vid="JOL 2:4">اَور وہ فَوجی گُھڑسوار کی سرپٹ دَوڑتے ہیں۔<verse eid="JOL 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5"/>اُن کے آگے بڑھنے کی آواز گویا</para>
  <para style="q2" vid="JOL 2:5">پہاڑوں کی چوٹیوں پر دَوڑنے والے رتھوں کی مانند ہے،</para>
  <para style="q1" vid="JOL 2:5">وہ شُعلہ زن کی مانند بھُوسے کو بھسم کردیتی ہے،</para>
  <para style="q2" vid="JOL 2:5">اَور وہ میدانِ جنگ کے لئے تیّار ایک زبردست فَوج کی مانند ہیں۔<verse eid="JOL 2:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6"/>اُن کے سامنے قومیں خوفزدہ ہو جاتی ہیں؛</para>
  <para style="q2" vid="JOL 2:6">اَور ہر ایک چہرہ خوف سے پیلا پڑ جاتا ہے۔<verse eid="JOL 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7"/>وہ جنگی سُورماؤں کی طرح چلتے ہیں؛</para>
  <para style="q2" vid="JOL 2:7">اَور جنگی سپاہیوں کی طرح دیواروں پر چڑھ جاتے ہیں۔</para>
  <para style="q1" vid="JOL 2:7">وہ سَب ایک ہی صف ہیں چلتے ہیں،</para>
  <para style="q2" vid="JOL 2:7">اَور اَپنی صف نہیں توڑتے۔<verse eid="JOL 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8"/>وہ ایک دُوسرے کو دھکّا نہیں دیتے؛</para>
  <para style="q2" vid="JOL 2:8">ہر ایک سیدھا آگے کو کُوچ کرتا ہے۔</para>
  <para style="q1" vid="JOL 2:8">وہ جنگی مورچوں کو بغیر</para>
  <para style="q2" vid="JOL 2:8">اَپنی صف کو توڑے آگے بڑھتے ہیں۔<verse eid="JOL 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9"/>وہ شہر پر ٹوٹ پڑتے ہیں؛</para>
  <para style="q2" vid="JOL 2:9">اَور دیوار پر دَوڑتے ہیں۔</para>
  <para style="q1" vid="JOL 2:9">وہ گھروں پر چڑھ جاتے ہیں؛</para>
  <para style="q2" vid="JOL 2:9">اَور چوروں کی مانند کھڑکیوں سے گھُس جاتے ہیں۔<verse eid="JOL 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10"/>اُن کے سامنے زمین کانپتی ہے،</para>
  <para style="q2" vid="JOL 2:10">اَور آسمان لرزتا ہے،</para>
  <para style="q1" vid="JOL 2:10">آفتاب اَور مَہتاب تاریک ہو جاتے ہیں،</para>
  <para style="q2" vid="JOL 2:10">اَور سِتارے چمکنا چھوڑ دیتے ہیں۔<verse eid="JOL 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11"/>یَاہوِہ اَپنی فَوج کے آگے ہوکر</para>
  <para style="q2" vid="JOL 2:11">بُلند آواز سے گرجتا ہے؛</para>
  <para style="q1" vid="JOL 2:11">کیونکہ اُن کی فَوج لاتعداد ہے،</para>
  <para style="q2" vid="JOL 2:11">اَور اُن کے حُکم بردار زبردست ہیں۔</para>
  <para style="q1" vid="JOL 2:11">یَاہوِہ کا دِن عظیم ہے؛</para>
  <para style="q2" vid="JOL 2:11">وہ نہایت خوفناک ہے۔</para>
  <para style="q2" vid="JOL 2:11">کون اُسے برداشت کر سکےگا؟<verse eid="JOL 2:11"/></para>
  <para style="s1">اَپنے دِل کو چاک کرو</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12"/>یَاہوِہ یُوں فرماتے ہیں، اَب بھی،</para>
  <para style="q2" vid="JOL 2:12">اَپنے پُورے دِل سے،</para>
  <para style="q2" vid="JOL 2:12">روزہ رکھ کر روتے اَور ماتم کرتے ہُوئے میری طرف لَوٹ آؤ۔<verse eid="JOL 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13"/>اَپنے کپڑوں کو نہیں</para>
  <para style="q2" vid="JOL 2:13">بَلکہ اَپنے دِل کو چاک کرو۔</para>
  <para style="q1" vid="JOL 2:13">یَاہوِہ اَپنے خُدا کی طرف لَوٹو،</para>
  <para style="q2" vid="JOL 2:13">کیونکہ وہ نہایت کریم اَور رحیم ہے،</para>
  <para style="q1" vid="JOL 2:13">قہر کرنے میں دھیما اَور شفقت میں غنی ہے،</para>
  <para style="q2" vid="JOL 2:13">اَور وہ عذاب نازل کرنے سے باز رہتاہے۔<verse eid="JOL 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14"/>کون جانتا ہے؟ شاید وہ پلٹ کر رحم کھائے</para>
  <para style="q2" vid="JOL 2:14">اَور اَیسی برکت دے جائے۔</para>
  <para style="q1" vid="JOL 2:14">جو یَاہوِہ تمہارے خُدا کے لیٔے</para>
  <para style="q2" vid="JOL 2:14">اناج کی نذر اَور تپاون کی نذر کی قُربانی ہو۔<verse eid="JOL 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15"/>صِیّونؔ میں نرسنگا پھُونکو،</para>
  <para style="q2" vid="JOL 2:15">مُقدّس روزہ کا اعلان کرو،</para>
  <para style="q2" vid="JOL 2:15">اَور مُقدّس اِجتماع طلب کرو۔<verse eid="JOL 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16"/>لوگوں کو جمع کرو،</para>
  <para style="q2" vid="JOL 2:16">اِجتماع کو مُقدّس کرو؛</para>
  <para style="q1" vid="JOL 2:16">رہنماؤں کو جمع کرو،</para>
  <para style="q2" vid="JOL 2:16">بچّوں اَور شیرخواروں کو بھی جمع کرو۔</para>
  <para style="q1" vid="JOL 2:16">دُلہا اَپنے کوہبر</para>
  <para style="q2" vid="JOL 2:16">اَور دُلہن اَپنی خلوت گاہ سے نکل آئے۔<verse eid="JOL 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17"/>یَاہوِہ کے خدمت گزار کاہِنؔ،</para>
  <para style="q2" vid="JOL 2:17">بیت المُقدّس کی دیوڑھی اَور قُربان گاہ کے درمیان رو رو کر کہیں۔</para>
  <para style="q2" vid="JOL 2:17">اَے یَاہوِہ، ”اَپنے لوگوں پر رحم کیجئے۔</para>
  <para style="q2" vid="JOL 2:17">اَپنی مِیراث کی توہین نہ ہونے دیں،</para>
  <para style="q2" vid="JOL 2:17">اَور نہ ہی اُنہیں غَیر قوموں میں ضرب المثل بننے دیں۔</para>
  <para style="q1" vid="JOL 2:17">وہ لوگوں کے درمیان یہ کیوں کہیں کہ</para>
  <para style="q2" vid="JOL 2:17">اُن کا خُدا کہاں ہے؟“<verse eid="JOL 2:17"/></para>
  <para style="s1">یَاہوِہ کا جَواب</para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18"/>تَب یَاہوِہ کو اَپنے مُلک کے لیٔے غیرت آئی</para>
  <para style="q2" vid="JOL 2:18">اَور وہ اَپنے لوگوں پر رحم کیا۔<verse eid="JOL 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JOL 2:19"/>تَب یَاہوِہ نے اَپنی قوم سے مُخاطِب ہُوا:</para>
  <para style="q1" vid="JOL 2:19">”مَیں تمہارے لیٔے اناج، نئی مَے اَور زَیتُون کے تیل بھیج رہا ہُوں،</para>
  <para style="q2" vid="JOL 2:19">جِن سے تُم سیر ہوگے؛</para>
  <para style="q1" vid="JOL 2:19">اَور مَیں پھر کبھی قوموں کے درمیان</para>
  <para style="q2" vid="JOL 2:19">تمہاری رُسوائی نہ ہونے دُوں گا۔<verse eid="JOL 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20"/>”مَیں شمالی فَوج کو تُم سے بہت دُور کر دُوں گا،</para>
  <para style="q2" vid="JOL 2:20">اَور اُسے خشک اَور بنجر مُلک میں دھکیل دُوں گا،</para>
  <para style="q1" vid="JOL 2:20">اُس کی صفیں مشرقی بحرمُردار میں</para>
  <para style="q2" vid="JOL 2:20">اَور صفیں مغربی بحرِ رُوم میں ڈُوب جایٔیں گی۔</para>
  <para style="q1" vid="JOL 2:20">اَور اُس سے بدبُو اُٹھے گی؛</para>
  <para style="q2" vid="JOL 2:20">جِس سے بُو پھیلے گی۔“</para>
  <para style="b" vid="JOL 2:20"/>
  <para style="q1" vid="JOL 2:20">یقیناً اُنہُوں نے نہایت بُرے کام کئے ہیں۔<verse eid="JOL 2:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="JOL 2:21"/>اَے مُلکِ یہُوداہؔ، تُو مت ڈر؛</para>
  <para style="q2" vid="JOL 2:21">شادمان ہو اَور خُوشی منا۔</para>
  <para style="q1" vid="JOL 2:21">یقیناً یَاہوِہ نے بڑے بڑے کام کئے ہیں۔<verse eid="JOL 2:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="JOL 2:22"/>اَے جنگلی جانوروں، تُم مت ڈرو،</para>
  <para style="q2" vid="JOL 2:22">کیونکہ بیابان کی چراگاہیں ہری بھری ہو رہی ہیں۔</para>
  <para style="q1" vid="JOL 2:22">درختوں پر پھل لگ رہے ہیں؛</para>
  <para style="q2" vid="JOL 2:22">اَنجیر کے درخت اَور انگور کی بیلیں اَپنی پیداوار دے رہے ہیں۔<verse eid="JOL 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23"/>اَے صِیّونؔ کے لوگوں، خُوش ہو جاؤ،</para>
  <para style="q2" vid="JOL 2:23">یَاہوِہ اَپنے خُدا میں شادمان ہو،</para>
  <para style="q1" vid="JOL 2:23">کیونکہ اُس نے اَپنی صداقت سے</para>
  <para style="q2" vid="JOL 2:23">تُمہیں خزاں کے موسم کی بارش بخشی۔</para>
  <para style="q1" vid="JOL 2:23">یعنی خزاں اَور بہار دونوں موسموں میں،</para>
  <para style="q2" vid="JOL 2:23">پہلے کی طرح ہی مینہ برسائے گا۔<verse eid="JOL 2:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24"/>کھلیان اناج سے بھر جایٔیں گے؛</para>
  <para style="q2" vid="JOL 2:24">اَور حوض نئی مے اَور زَیتُون کے تیل سے لبریز ہوں گے۔<verse eid="JOL 2:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25"/>اَور جِن سالوں کی پیداوار ٹِڈّیوں نے کھا لی ہیں،</para>
  <para style="q2" vid="JOL 2:25">یعنی اُن بڑی اَور چُھوٹی ٹِڈّیوں نے</para>
  <para style="q2" vid="JOL 2:25">میں اُس نُقصان کی بھرپائی کر دُوں گا۔</para>
  <para style="q2" vid="JOL 2:25">جسے ٹِڈّیوں کی فَوج نے کھا لیا</para>
  <para style="q2" vid="JOL 2:25">یعنی اُس زبردست فَوج نے جنہیں مَیں نے تمہارے درمیان بھیجا تھا۔<verse eid="JOL 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26"/>تُم پیٹ بھرکے کھاؤگے اَور سیر ہوگے،</para>
  <para style="q2" vid="JOL 2:26">اَور یَاہوِہ اَپنے خُدا کے نام کی تمجید کروگے،</para>
  <para style="q2" vid="JOL 2:26">جنہوں نے تمہارے لیٔے عجِیب و غریب کام کئے ہیں؛</para>
  <para style="q2" vid="JOL 2:26">میرے لوگ پھر کبھی شرمندہ نہ ہوں گے۔<verse eid="JOL 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27"/>تَب تُم جان لوگے کہ میں اِسرائیل میں سکونت پذیر ہُوں،</para>
  <para style="q2" vid="JOL 2:27">اَور یہ بھی کہ مَیں یَاہوِہ تمہارا خُدا ہُوں،</para>
  <para style="q2" vid="JOL 2:27">اَور کویٔی دُوسرا نہیں ہے؛</para>
  <para style="q1" vid="JOL 2:27">میرے لوگ پھر کبھی شرمندہ نہ ہوں گے۔<verse eid="JOL 2:27"/></para>
  <para style="s1">یَاہوِہ کا دِن</para>
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28"/>اَور اِس کے بعد،</para>
  <para style="q2" vid="JOL 2:28">مَیں تمام لوگوں پر اَپنا رُوح نازل کروں گا۔</para>
  <para style="q1" vid="JOL 2:28">تمہارے بیٹے اَور بیٹیاں نبُوّت کریں گی،</para>
  <para style="q2" vid="JOL 2:28">تمہارے بُزرگ خواب دیکھیں گے،</para>
  <para style="q2" vid="JOL 2:28">اَور تمہارے نوجوان رُویا دیکھیں گے۔<verse eid="JOL 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29"/>اُن دِنوں میں، میں اَپنے خادِم اَور خادِموں پر بھی،</para>
  <para style="q2" vid="JOL 2:29">اَپنا رُوح نازل کروں گا۔<verse eid="JOL 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30"/>میں اُوپر آسمان میں</para>
  <para style="q2" vid="JOL 2:30">اَور نیچے زمین پر معجزے دِکھاؤں گا،</para>
  <para style="q2" vid="JOL 2:30">یعنی خُون، اَور آگ اَور گاڑھا دُھواں۔<verse eid="JOL 2:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31"/>اِس سے پہلے کہ یَاہوِہ کا خوفناک روزِ عظیم آئے،</para>
  <para style="q2" vid="JOL 2:31">آفتاب تاریک ہو</para>
  <para style="q2" vid="JOL 2:31">اَور ماہتاب خُون کی طرح سُرخ ہو جائے گا۔<verse eid="JOL 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32"/>اَورجو کویٔی یَاہوِہ کا نام لے کر</para>
  <para style="q2" vid="JOL 2:32">پُکارے گا نَجات پایٔےگا؛</para>
  <para style="q1" vid="JOL 2:32">کیونکہ یَاہوِہ کے قول کے مُطابق</para>
  <para style="q2" vid="JOL 2:32">کوہِ صِیّونؔ پر اَور یروشلیمؔ میں</para>
  <para style="q2" vid="JOL 2:32">جِن باقی بچے لوگوں کو</para>
  <para style="q1" vid="JOL 2:32">یَاہوِہ بُلائیں گے</para>
  <para style="q2" vid="JOL 2:32">وہ نَجات پائیں گے۔<verse eid="JOL 2:32"/></para>
  <chapter eid="JOL 2"/>
  <chapter number="3" style="c" sid="JOL 3"/>
  <para style="s1">قوموں کا اِنصاف</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 3:1"/>اُن ایّام میں اَور اُس وقت،</para>
  <para style="q2" vid="JOL 3:1">جَب مَیں یہُودیؔہ اَور یروشلیمؔ کے لوگوں کو اسیری سے چھُڑا لاؤں گا،<verse eid="JOL 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2"/>تَب میں سَب قوموں کو جمع کرکے</para>
  <para style="q2" vid="JOL 3:2">اُنہیں یہوشافاطؔ کی وادی میں لے آؤں گا۔</para>
  <para style="q1" vid="JOL 3:2">وہاں میں اَپنی مِیراث یعنی اَپنی قوم اِسرائیل کے متعلّق</para>
  <para style="q2" vid="JOL 3:2">اُن کے خِلاف فیصلہ کروں گا،</para>
  <para style="q1" vid="JOL 3:2">کیونکہ اُنہُوں نے میرے لوگوں کو مُختلف قوموں میں بِکھیر دیا تھا</para>
  <para style="q2" vid="JOL 3:2">اَور میرے مُلک کو تقسیم کر دیا۔<verse eid="JOL 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3"/>اُنہُوں نے میرے لوگوں کے لیٔے قُرعہ ڈالا</para>
  <para style="q2" vid="JOL 3:3">اَور کسبیوں کے بدلے میں لڑکوں کا سَودا کیا؛</para>
  <para style="q2" vid="JOL 3:3">اَور لڑکیوں کو فروخت کیا، تاکہ وہ مَے نوشی کریں۔<verse eid="JOL 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4"/>”اَب اَے صُورؔ اَور صیدونؔ اَور فلسطین کے تمام علاقہ، تُمہیں میرے خِلاف کیا شکایت ہے؟ کیا تُم مُجھے میرے کسی کام کا صِلہ دے رہے ہو؟ اگر تُم مُجھے لَوٹا بھی رہے ہو تو میں فوراً نہایت عجلت سے جو کچھ تُم نے کیا ہُواہے، تمہارے ہی سَروں پر ڈال دُوں گا۔ <verse eid="JOL 3:4"/><verse number="5" style="v" sid="JOL 3:5"/>کیونکہ تُم نے میری چاندی اَور میرا سونا لے لیا اَور میرے نفیس خزانے اَپنے مَندِروں میں رکھ لیا ہے۔ <verse eid="JOL 3:5"/><verse number="6" style="v" sid="JOL 3:6"/>تُم نے یہُودیؔہ اَور یروشلیمؔ کے لوگوں کو یُونانیوں کے ہاتھ فروخت کیا تاکہ تُم اُنہیں اُن کے مادرِ وطن سے دُور کر دو۔<verse eid="JOL 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOL 3:7"/>”دیکھو، میں اُنہیں اُن مقامات سے جہاں تُم نے اُنہیں بیچا ہے اُبھاروں گا اَور تُم نے جو کچھ کیا اُسے تمہارے سَر پر لَوٹاؤں گا۔ <verse eid="JOL 3:7"/><verse number="8" style="v" sid="JOL 3:8"/>مَیں تمہارے بیٹوں اَور بیٹیوں کو اہلِ یہُوداہؔ کے ہاتھ بیچوں گا اَور وہ اُنہیں شبائیوں کے ہاتھ فروخت کریں گے جو بہت دُور رہنے والی قوم ہے۔“ یہی یَاہوِہ کا فرمان ہے۔<verse eid="JOL 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9"/>مُختلف قوموں میں اعلان کرو،</para>
  <para style="q2" vid="JOL 3:9">جنگ کی تیّاری کرو!</para>
  <para style="q1" vid="JOL 3:9">سپاہیوں کو جگاؤ!</para>
  <para style="q2" vid="JOL 3:9">تمام جنگجو مَرد قریب آکر حملہ کریں۔<verse eid="JOL 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10"/>اَپنے اَپنے ہلوں کے پھالوں کو پیٹ کر تلواریں</para>
  <para style="q2" vid="JOL 3:10">اَور اَپنے اَپنے درانتیوں کو پیٹ کر نیزے بنالو۔</para>
  <para style="q1" vid="JOL 3:10">جو کمزور ہو وہ بھی کہے کہ</para>
  <para style="q2" vid="JOL 3:10">”میں زورآور ہُوں!“<verse eid="JOL 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11"/>اَے اِردگرد کی تمام قوموں جلدی آ جاؤ،</para>
  <para style="q2" vid="JOL 3:11">اَور وہاں جمع ہو جاؤ۔</para>
  <para style="b" vid="JOL 3:11"/>
  <para style="q1" vid="JOL 3:11">اَے یَاہوِہ اَپنے جنگجو سپاہیوں کو لے آ!<verse eid="JOL 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12"/>”قومیں جاگ اُٹھیں؛</para>
  <para style="q2" vid="JOL 3:12">اَور وہ یہوشافاطؔ کی وادی کی طرف کوچ کریں،</para>
  <para style="q1" vid="JOL 3:12">کیونکہ مَیں وہاں تخت نشین ہوکر</para>
  <para style="q2" vid="JOL 3:12">چاروں طرف کی سَب قوموں کا اِنصاف کروں گا۔<verse eid="JOL 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13"/>درانتی لگاؤ،</para>
  <para style="q2" vid="JOL 3:13">کیونکہ فصل پک گئی ہے۔</para>
  <para style="q1" vid="JOL 3:13">آؤ اَور انگوروں کو روندو،</para>
  <para style="q2" vid="JOL 3:13">کیونکہ کی انگوری حوض لبالب بھرا ہے</para>
  <para style="q2" vid="JOL 3:13">اَور حوض لبریز ہے۔</para>
  <para style="q1" vid="JOL 3:13">کیونکہ اُن کی بدکاری بہت بڑی ہے!“<verse eid="JOL 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14"/>فیصلہ کی وادی میں</para>
  <para style="q2" vid="JOL 3:14">ہُجوم ہی ہُجوم ہے!</para>
  <para style="q1" vid="JOL 3:14">کیونکہ فیصلہ کی وادی میں</para>
  <para style="q2" vid="JOL 3:14">یَاہوِہ کا دِن نزدیک ہے۔<verse eid="JOL 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15"/>آفتاب اَور مَہتاب تاریک ہو جایٔیں گے،</para>
  <para style="q2" vid="JOL 3:15">اَور سِتارے بے نُور ہو جایٔیں گے۔<verse eid="JOL 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16"/>یَاہوِہ صِیّونؔ سے دہاڑے گا</para>
  <para style="q2" vid="JOL 3:16">اَور یروشلیمؔ سے گرجے گا؛</para>
  <para style="q2" vid="JOL 3:16">جِس سے آسمان اَور زمین کانپ اُٹھیں گے۔</para>
  <para style="q1" vid="JOL 3:16">لیکن یَاہوِہ اَپنے لوگوں کے لیٔے پناہ گاہ،</para>
  <para style="q2" vid="JOL 3:16">اَور بنی اِسرائیل کے لیٔے قلعہ ہوگا۔<verse eid="JOL 3:16"/></para>
  <para style="s1">خُدا کے لوگوں کے لیٔے برکتیں</para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17"/>”تَب تُم جان لوگے کہ میں یَاہوِہ تمہارا خُدا،</para>
  <para style="q2" vid="JOL 3:17">اَپنے مُقدّس پہاڑ صِیّونؔ میں سکونت کرتا ہُوں۔</para>
  <para style="q1" vid="JOL 3:17">یروشلیمؔ مُقدّس مقام ہوگا؛</para>
  <para style="q2" vid="JOL 3:17">اَور پردیسی پھر کبھی اُس پر حملہ نہیں کریں گے۔<verse eid="JOL 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18"/>”اُس وقت پہاڑوں پر سے نئی مَے ٹپکے گی،</para>
  <para style="q2" vid="JOL 3:18">اَور ٹیلوں پر سے دُودھ بہے گا؛</para>
  <para style="q2" vid="JOL 3:18">اَور یہُوداہؔ کے تمام نالوں میں پانی بہنا جاری رہے گا۔</para>
  <para style="q1" vid="JOL 3:18">اَور یَاہوِہ کے گھر میں سے ایک چشمہ پھوٹ نکلے گا</para>
  <para style="q2" vid="JOL 3:18">جو شِطِّیمؔ کی وادی کو سیراب کرےگا۔<verse eid="JOL 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19"/>چونکہ اُنہُوں نے یہُوداہؔ پر ظُلم ڈھائے،</para>
  <para style="q2" vid="JOL 3:19">اَور اُن کے مُلک میں بےگُناہوں کا خُون بہایا،</para>
  <para style="q1" vid="JOL 3:19">اِس لیٔے مِصر ویران ہو جائے گا،</para>
  <para style="q2" vid="JOL 3:19">اَور اِدُوم ریگستان بَن جائے گا۔<verse eid="JOL 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20"/>لیکن یہُودیؔہ اَب سے اَبد تک آباد رہے گا</para>
  <para style="q2" vid="JOL 3:20">اَور یروشلیمؔ پُشت در پُشت قائِم رہے گے۔<verse eid="JOL 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21"/>کیا مَیں اُن بےگُناہوں کے قتل کا اِنتقام لئے بغیر جانے دُوں،</para>
  <para style="q2" vid="JOL 3:21">نہیں، بالکُل نہیں۔“</para>
  <para style="b" vid="JOL 3:21"/>
  <para style="qc" vid="JOL 3:21">یَاہوِہ صِیّونؔ میں سکونت پذیر ہے۔<verse eid="JOL 3:21"/></para>
  <chapter eid="JOL 3"/>
</usx>
