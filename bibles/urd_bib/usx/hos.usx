<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HOS" style="id">- Biblica® Open Urdu Contemporary Version</book>
  <para style="h">ہوشِیعؔ</para>
  <para style="toc1">ہوشِیعؔ کی نبُوّت</para>
  <para style="toc2">ہوشِیعؔ</para>
  <para style="toc3">ہوش</para>
  <para style="mt1">ہوشِیعؔ</para>
  <para style="mt2">کی نبُوّت</para>
  <chapter number="1" style="c" sid="HOS 1"/>
  <para style="p">
    <verse number="1" style="v" sid="HOS 1:1"/>شاہانِ یہُوداہؔ عُزّیاہؔ، یُوتامؔ، آحازؔ اَور حِزقیاہؔ اَور شاہ اِسرائیل یرُبعامؔ بِن یہُوآشؔ کے عہد میں یَاہوِہ کا یہ کلام بیؔری کے بیٹے ہوشِیعؔ پر نازل ہُوا۔<verse eid="HOS 1:1"/></para>
  <para style="b"/>
  <para style="s1">ہوشِیعؔ کے بیوی اَور بچّے</para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 1:2"/>جَب یَاہوِہ نے ہوشِیعؔ کی مَعرفت بات کرنا شروع کیا تَب یَاہوِہ نے اُس سے فرمایا، ”جا اَور ایک فاحِشہ کو اَپنی بیوی بنا لے اَور بدکاری کی اَولاد کو اَپنا لے کیونکہ مُلک نے یَاہوِہ کو چھوڑکر نہایت شرمناک بےوفائی کا مُجرم ہے۔“ <verse eid="HOS 1:2"/><verse number="3" style="v" sid="HOS 1:3"/>چنانچہ اُس نے دِبلائمؔ کی بیٹی گومرؔ سے شادی کرلی اَور وہ حاملہ ہُوئی اَور اُن کے ہاں بیٹا پیدا ہُوا۔<verse eid="HOS 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 1:4"/>تَب یَاہوِہ نے ہوشِیعؔ سے فرمایا، ”اُس کا نام یزرعیلؔ<note caller="+" style="f"><char style="fr" closed="false">1‏:4 </char><char style="fq" closed="false">یزرعیلؔ </char><char style="ft" closed="false">خُدا بیج بوتے ہیں</char></note> رکھ کیونکہ مَیں بہت جلد یِہُو کے خاندان سے یزرعیلؔ کے خُون کا بدلہ لُوں گا اَور مَیں اِسرائیل کی بادشاہی کا خاتِمہ کر دُوں گا۔“ <verse eid="HOS 1:4"/><verse number="5" style="v" sid="HOS 1:5"/>اُس دِن مَیں یزرعیلؔ کی وادی میں اِسرائیل کی کمان توڑ دُوں گا۔<verse eid="HOS 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HOS 1:6"/>گومرؔ پھر سے حاملہ ہویٔی اَور اُن کے ہاں بیٹی پیدا ہُوئی۔ تَب یَاہوِہ نے ہوشِیعؔ سے فرمایاہے، ”اُس کا نام لورُحامہؔ<note caller="+" style="f"><char style="fr" closed="false">1‏:6 </char><char style="fq" closed="false">لورُحامہؔ </char><char style="ft" closed="false">یہ رحم سے نامحروم رہی</char></note> رکھ کیونکہ مَیں اِسرائیل کے گھرانے پر پھر کبھی رحم نہ کروں گا تاکہ کسی طرح اُن کے گُناہ مُعاف کروں۔ <verse eid="HOS 1:6"/><verse number="7" style="v" sid="HOS 1:7"/>لیکن مَیں یہُوداہؔ کے گھرانے پر رحم کروں گا اَور اُنہیں بچاؤں گا۔ لیکن کمان، تلوار یا جنگ یا گھوڑوں اَور سواروں سے نہیں بَلکہ یَاہوِہ اُن کے خُدا کے ذریعہ۔“<verse eid="HOS 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 1:8"/>لورُحامہؔ کا دُودھ چھُڑانے کے بعد گومرؔ کے ہاں دُوسرا بیٹا پیدا ہُوا۔ <verse eid="HOS 1:8"/><verse number="9" style="v" sid="HOS 1:9"/>تَب یَاہوِہ نے فرمایا، ”اُس کا نام لُو عمّی<note caller="+" style="f"><char style="fr" closed="false">1‏:9 </char><char style="fq" closed="false">لُو عمّی </char><char style="ft" closed="false">میری اُمّت نہیں ہو</char></note> رکھنا کیونکہ تُم میری اُمّت نہیں ہو، نہ میں تمہارا خُدا ہُوں۔<verse eid="HOS 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HOS 1:10"/>”پھر بنی اِسرائیل سمُندر کے کنارے کی ریت کی مانند ہوں گے جسے ناپا یا گِنا نہیں جا سَکتا اَور جہاں اُن سے یہ کہا گیا تھا، ’تُم میری اُمّت نہیں ہو،‘ وہاں، اُنہیں زندہ خُدا کے فرزند کہا جائے گا۔ <verse eid="HOS 1:10"/><verse number="11" style="v" sid="HOS 1:11"/>بنی یہُوداہؔ اَور بنی اِسرائیل پھر سے مُتّحد ہوکر اَپنے لیٔے ایک رہنما مُقرّر کر لیں گے اَور اُس مُلک سے نکل آئیں گے کیونکہ یزرعیلؔ کا دِن عظیم ہوگا۔<verse eid="HOS 1:11"/></para>
  <chapter eid="HOS 1"/>
  <chapter number="2" style="c" sid="HOS 2"/>
  <para style="p">
    <verse number="1" style="v" sid="HOS 2:1"/>”اَپنے بھائیوں کے لیٔے، ’میرے لوگو اَور اَپنی بہنوں کے لیٔے میری پیاریو کہا کرو۔‘<verse eid="HOS 2:1"/></para>
  <para style="s1">اِسرائیل کو سزا دے کر بحال کیاجانا</para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 2:2"/>”اَپنی ماں کی تادیب کرو، اُس کو تنبیہ دو،</para>
  <para style="q2" vid="HOS 2:2">کیونکہ وہ میری بیوی نہیں ہے،</para>
  <para style="q2" vid="HOS 2:2">اَور نہ مَیں اُس کا خَاوند ہُوں۔</para>
  <para style="q1" vid="HOS 2:2">وہ اَپنے چہرہ پر سے بدکاری کا عکس</para>
  <para style="q2" vid="HOS 2:2">اَور اَپنی چھاتِیوں کے بیچ سے بےوفائی دُور کرے۔<verse eid="HOS 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 2:3"/>ورنہ میں اُسے بے پردہ کر دُوں گا</para>
  <para style="q2" vid="HOS 2:3">اَور اُسے اَیسی برہنہ کر دُوں گا جَیسی وہ اَپنی پیدائش کے دِن تھی؛</para>
  <para style="q1" vid="HOS 2:3">مَیں اُسے بیابان کے مانند کر دُوں گا،</para>
  <para style="q2" vid="HOS 2:3">اَور اُسے خشک زمین بنا کر،</para>
  <para style="q2" vid="HOS 2:3">پیاس سے مار ڈالُوں گا۔<verse eid="HOS 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 2:4"/>مَیں اُس کے بچّوں سے مَحَبّت نہ رکھوں گا،</para>
  <para style="q2" vid="HOS 2:4">کیونکہ وہ زنا کی اَولاد ہیں۔<verse eid="HOS 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 2:5"/>اُن کی ماں نے بےوفائی کی</para>
  <para style="q2" vid="HOS 2:5">اَور ذِلّت کے ساتھ حاملہ ہُوئی۔</para>
  <para style="q1" vid="HOS 2:5">اُس نے کہا، ’مَیں اَپنے عاشقوں کے پیچھے چلی جاؤں گی،</para>
  <para style="q2" vid="HOS 2:5">جو مُجھے اَپنی روٹی اَور اَپنا پانی،</para>
  <para style="q2" vid="HOS 2:5">اَور اَپنے اُونی اَور کتانی کپڑے اَور اَپنا روغن اَور اَپنی مَے دیتے ہیں۔<verse eid="HOS 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 2:6"/>اِس لیٔے میں کانٹے دار جھاڑیوں سے اُس کی راہ روک دُوں گا؛</para>
  <para style="q2" vid="HOS 2:6">اَور اَیسی دیوار کھڑی کروں گا کہ وہ اَپنی راہ نہ پا سکے۔‘<verse eid="HOS 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 2:7"/>اَور اَپنے عاشقوں کا تعاقب کرےگی لیکن اُن سے جا نہ ملے گی؛</para>
  <para style="q2" vid="HOS 2:7">وہ اُنہیں ڈھونڈے گی لیکن نہ پایٔے گی۔ تَب وہ کہےگی،</para>
  <para style="q1" vid="HOS 2:7">مَیں اَپنے خَاوند کے پاس واپس چلی جاؤں گی جَیسے پہلے</para>
  <para style="q2" vid="HOS 2:7">اُس کے پاس تھی،</para>
  <para style="q2" vid="HOS 2:7">کیونکہ تَب مَیں آج سے بہتر حالت میں تھی۔<verse eid="HOS 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 2:8"/>وہ نہیں جانتی کہ مَیں نے ہی</para>
  <para style="q2" vid="HOS 2:8">اُس کے لیٔے اناج، نئی مَے اَور روغن مہیا کیا،</para>
  <para style="q1" vid="HOS 2:8">اَور اُس پر چاندی اَور سونا نذر کیا،</para>
  <para style="q2" vid="HOS 2:8">جسے اُنہُوں نے بَعل کے لیٔے اِستعمال کیا۔<verse eid="HOS 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 2:9"/>”اِس لیٔے مَیں اَپنا اناج فصل کے وقت،</para>
  <para style="q2" vid="HOS 2:9">اَور اَپنی نئی مَے جَب وہ تیّار ہو، اُس سے چھین لُوں گا۔</para>
  <para style="q1" vid="HOS 2:9">مَیں اَپنا اُون اَور کتان بھی واپس لُوں گا،</para>
  <para style="q2" vid="HOS 2:9">جو اُس کی برہنگی پر پردہ ڈالنے کے لیٔے تھے۔<verse eid="HOS 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 2:10"/>چنانچہ اَب مَیں اُس کی برہنگی</para>
  <para style="q2" vid="HOS 2:10">اُس کے عاشقوں کے سامنے بے پردہ کر دُوں گا؛</para>
  <para style="q2" vid="HOS 2:10">اَور کویٔی اُسے میرے ہاتھ سے چھین نہ لے گا۔<verse eid="HOS 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 2:11"/>مَیں اُس کے تمام جَشن؛</para>
  <para style="q2" vid="HOS 2:11">اُس کی سالانہ عیدیں، اُس کے نئے چاند،</para>
  <para style="q2" vid="HOS 2:11">اُس کی سَبتیں، الغرض اُس کی تمام مُقرّرہ عیدوں کو موقُوف کر دُوں گا۔<verse eid="HOS 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 2:12"/>مَیں اُس کے انگور اَور اَنجیر کے درختوں کو تباہ کر دُوں گا،</para>
  <para style="q2" vid="HOS 2:12">جسے وہ اَپنے عاشقوں کی طرف سے مِلی ہُوئی اُجرت بتاتی ہے؛</para>
  <para style="q1" vid="HOS 2:12">مَیں اُنہیں جنگل بنا دُوں گا،</para>
  <para style="q2" vid="HOS 2:12">اَور جنگلی جانور اُنہیں کھا جایٔیں گے۔<verse eid="HOS 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 2:13"/>جتنے دِنوں تک اُس نے بَعل معبُودوں کے لیٔے بخُور جَلایا؛</para>
  <para style="q2" vid="HOS 2:13">اِتنے دِنوں کے لیٔے مَیں اُسے سزا دُوں گا؛</para>
  <para style="q1" vid="HOS 2:13">وہ انگُوٹھیوں اَور زیوروں سے آراستہ ہوکر،</para>
  <para style="q2" vid="HOS 2:13">اَپنے عاشقوں کے پیچھے گئی،</para>
  <para style="q2" vid="HOS 2:13">لیکن مُجھے بھُول گئی،“ یَاہوِہ فرماتے ہیں۔<verse eid="HOS 2:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 2:14"/>اِس لیٔے اَب مَیں اُسے پھُسلا کر؛</para>
  <para style="q2" vid="HOS 2:14">بیابان میں لے جاؤں گا</para>
  <para style="q2" vid="HOS 2:14">اَور اُس سے نرم دِلی سے باتیں کروں گا۔<verse eid="HOS 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 2:15"/>وہاں مَیں اُسے اُس کے تاکستان لَوٹا دُوں گا،</para>
  <para style="q2" vid="HOS 2:15">اَور وادیِ عکورؔ<note caller="+" style="f"><char style="fr" closed="false">2‏:15 </char><char style="fq" closed="false">وادیِ عکورؔ </char><char style="ft" closed="false">مُصیبت کی وادی</char></note> کو درِ اُمّید بنا دُوں گا۔</para>
  <para style="q1" vid="HOS 2:15">وہاں وہ اَپنے ایّام جَوانی کی مانند نغمہ سِرا ہوگی،</para>
  <para style="q2" vid="HOS 2:15">اُس دِن کی طرح جَب وہ مِصر سے نکل آئی تھی۔<verse eid="HOS 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 2:16"/>”اُس دِن،“ یَاہوِہ فرماتے ہیں،</para>
  <para style="q2" vid="HOS 2:16">”تُو مُجھے اَپنا خَاوند کہہ کر پُکارے گی؛</para>
  <para style="q2" vid="HOS 2:16">اَور پھر کبھی مُجھے اَپنا آقا<note caller="+" style="f"><char style="fr" closed="false">2‏:16 </char><char style="fq" closed="false">آقا </char><char style="ft" closed="false">عِبرانی میں میرا بَعل</char></note> نہ کہےگی۔<verse eid="HOS 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 2:17"/>مَیں اُس کے لبوں پر سے بَعل معبُودوں کے نام ہٹا دُوں گا؛</para>
  <para style="q2" vid="HOS 2:17">اَور پھر کبھی اُن کے نام نہ لیٔے جایٔیں گے۔<verse eid="HOS 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 2:18"/>اُس وقت مَیں اُن کے لیٔے</para>
  <para style="q2" vid="HOS 2:18">زمین کے جانوروں اَور ہَوا کے پرندوں</para>
  <para style="q2" vid="HOS 2:18">اَور زمین پر رینگنے والے جانداروں کے ساتھ عہد باندھوں گا۔</para>
  <para style="q1" vid="HOS 2:18">مَیں مُلک میں سے</para>
  <para style="q2" vid="HOS 2:18">کمان، تلوار اَور جنگ کو الگ کر دُوں گا،</para>
  <para style="q2" vid="HOS 2:18">تاکہ سَب لوگ سکون اَور اِطمینان سے آرام کر سکیں۔<verse eid="HOS 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 2:19"/>اَور مَیں ہمیشہ کے لیٔے تُجھے اَپنا بنا لُوں گا؛</para>
  <para style="q2" vid="HOS 2:19">اَور تُجھ سے راستبازی اَور اِنصاف</para>
  <para style="q2" vid="HOS 2:19">اَور مَحَبّت اَور شفقت کے ساتھ رشتہ جوڑوں گا۔<verse eid="HOS 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="HOS 2:20"/>مَیں تُجھے وفاداری سے اَپنے ساتھ نامزد کروں گا،</para>
  <para style="q2" vid="HOS 2:20">اَور تُو یَاہوِہ کو قبُول کر لے گی۔<verse eid="HOS 2:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="HOS 2:21"/>”اَور اُس دِن مَیں سُنوں گا،“</para>
  <para style="q2" vid="HOS 2:21">یَاہوِہ یُوں فرماتے ہیں،</para>
  <para style="q1" vid="HOS 2:21">مَیں آسمانوں کی سُن کر اُسے جَواب دوں گا،</para>
  <para style="q2" vid="HOS 2:21">اَور وہ زمین کو جَواب دیں گے؛<verse eid="HOS 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="HOS 2:22"/>اَور زمین اناج</para>
  <para style="q2" vid="HOS 2:22">نئی مَے اَور روغن کی سُنے گی،</para>
  <para style="q2" vid="HOS 2:22">اَور وہ یزرعیلؔ کو جَواب دیں گے۔<verse eid="HOS 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="HOS 2:23"/>مَیں خُود اُسے اَپنے لیٔے مُلک میں لگاؤں گا؛</para>
  <para style="q2" vid="HOS 2:23">جسے مَیں نے لورُحامہؔ (جو رحم سے نامحروم رہی) اُس پر رحم کروں گا۔</para>
  <para style="q1" vid="HOS 2:23">اَور جنہیں لُو عمّی (میری اُمّت نہیں) کہا گیا اُنہیں تُم میرے</para>
  <para style="q2" vid="HOS 2:23">اُمّت ہو کہُوں گا؛</para>
  <para style="q2" vid="HOS 2:23">اَور وہ کہیں گے، آپ میرے خُدا ہیں۔<verse eid="HOS 2:23"/></para>
  <chapter eid="HOS 2"/>
  <chapter number="3" style="c" sid="HOS 3"/>
  <para style="s1">ہوشِیعؔ کا اَپنی بیوی سے مِلاپ</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 3:1"/>یَاہوِہ نے مُجھ سے فرمایا، ”جا اَور اَپنی بیوی سے پھر مَحَبّت جتا حالانکہ وہ کسی اَور کی محبُوبہ ہے اَور زانیہ ہے۔ اُس سے مَحَبّت کر جِس طرح یَاہوِہ اِسرائیلیوں سے مَحَبّت کرتے ہیں حالانکہ وہ دُوسرے معبُودوں کی طرف مُڑتے ہیں اَور مُقدّس کشمش کی ٹکیوں کو پسند کرتے ہیں۔“<verse eid="HOS 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 3:2"/>چنانچہ اُسے مَیں چاندی کے پندرہ ثاقل<note caller="+" style="f"><char style="fr" closed="false">3‏:2 </char><char style="fq" closed="false">پندرہ ثاقل </char><char style="ft" closed="false">تقریباً ایک سَو ستّر گرام</char></note> اَور ایک حُومر اَور ایک لیتھیک<note caller="+" style="f"><char style="fr" closed="false">3‏:2 </char><char style="fq" closed="false">ایک لیتھیک </char><char style="ft" closed="false">تقریباً ایک سَو پچیانوے کِلوگرام</char></note> جَو کے عِوض خرید لایا۔ <verse eid="HOS 3:2"/><verse number="3" style="v" sid="HOS 3:3"/>پھر مَیں نے اُس سے کہا، ”تُجھے میرے ساتھ بہت دِنوں تک رہنا ہے بدکاری نہ کر، نہ کسی غَیر مَرد سے ناجائز تعلّقات رکھ اَور مَیں تمہارے ساتھ وَیسا ہی سلُوک کروں گا۔“<verse eid="HOS 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 3:4"/>کیونکہ بنی اِسرائیل بہت دِنوں تک بغیر بادشاہ یا حاکم، بغیر قُربانی یا مُقدّس پتّھروں اَور افُود یا خانگی معبُودوں کے بغیر رہیں گے۔ <verse eid="HOS 3:4"/><verse number="5" style="v" sid="HOS 3:5"/>اُس کے بعد بنی اِسرائیل لَوٹ آئیں گے اَور یَاہوِہ اَپنے خُدا اَور اَپنے بادشاہ داویؔد کو تلاش کریں گے اَور آخِری دِنوں میں وہ کانپتے ہُوئے یَاہوِہ کے پاس آئیں گے اَور اُن کی رحمت کے طالب ہوں گے۔<verse eid="HOS 3:5"/></para>
  <chapter eid="HOS 3"/>
  <chapter number="4" style="c" sid="HOS 4"/>
  <para style="s1">اِسرائیل کے خِلاف اِلزام</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 4:1"/>اَے بنی اِسرائیل، یَاہوِہ کا کلام سُنو،</para>
  <para style="q2" vid="HOS 4:1">کیونکہ یَاہوِہ کو تمہارے خِلاف جو اِس مُلک میں رہتے ہو</para>
  <para style="q2" vid="HOS 4:1">اِلزام لگانا ہے:</para>
  <para style="q1" vid="HOS 4:1">”اِس مُلک میں نہ تو وفاداری ہے نہ مَحَبّت،</para>
  <para style="q2" vid="HOS 4:1">اَور نہ ہی خُدا شناسی ہے۔<verse eid="HOS 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 4:2"/>یہاں صِرف لعنت، دروغ گوئی اَور گوشت و خُون،</para>
  <para style="q2" vid="HOS 4:2">اَور چوری اَور زناکاری ہے؛</para>
  <para style="q1" vid="HOS 4:2">وہ تمام حُدوُد توڑتے ہیں،</para>
  <para style="q2" vid="HOS 4:2">اَور خُون پر خُون ہوتاہے۔<verse eid="HOS 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 4:3"/>اِس لیٔے مُلک کی زمین سُوکھ جاتی ہے،</para>
  <para style="q2" vid="HOS 4:3">اَور اُس کے باشِندے ناتواں ہو رہے ہیں؛</para>
  <para style="q1" vid="HOS 4:3">اَور زمین کے جانور اَور ہَوا کے پرندے</para>
  <para style="q2" vid="HOS 4:3">اَور سمُندر کی مچھلیاں مَر رہی ہیں۔<verse eid="HOS 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 4:4"/>”لیکن کویٔی شخص اِلزام نہ لگائے،</para>
  <para style="q2" vid="HOS 4:4">نہ کویٔی شخص دُوسرے پر تہمت لگائے،</para>
  <para style="q1" vid="HOS 4:4">کیونکہ تمہارے لوگ اُن کی مانند ہیں</para>
  <para style="q2" vid="HOS 4:4">جو کاہِنؔ کے خِلاف اِلزام لگاتے ہیں۔<verse eid="HOS 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 4:5"/>تُم دِن اَور رات کو ٹھوکر کھاتے ہو،</para>
  <para style="q2" vid="HOS 4:5">اَور تمہارے ساتھ نبی بھی ٹھوکر کھاتے ہیں</para>
  <para style="q1" vid="HOS 4:5">اِس لیٔے میں تیری ماں کو تباہ کروں گا۔<verse eid="HOS 4:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 4:6"/>میرے لوگ علمی مَعرفت کے نہ ہونے سے تباہ ہو گئے۔</para>
  <para style="b" vid="HOS 4:6"/>
  <para style="q1" vid="HOS 4:6">”چونکہ تُم نے علمی مَعرفت کو ٹھکرایا،</para>
  <para style="q2" vid="HOS 4:6">اِس لیٔے مَیں بھی تُمہیں اَپنی کہانت سے ٹھکراتا ہُوں؛</para>
  <para style="q1" vid="HOS 4:6">چونکہ تُم نے اَپنے خُدا کے آئین کو بھلا دیا ہے،</para>
  <para style="q2" vid="HOS 4:6">اِس لیٔے مَیں بھی تمہاری اَولاد کو بھُول جاؤں گا۔<verse eid="HOS 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 4:7"/>جوں جوں کاہِنوں کی تعداد بڑھتی گئی،</para>
  <para style="q2" vid="HOS 4:7">وہ میرے خِلاف اَور بھی گُناہ کرتے گیٔے؛</para>
  <para style="q2" vid="HOS 4:7">اُنہُوں نے اَپنے جلالی خُدا کو محض رُسوا شَے کے مُعاوضہ میں بدل دیا۔<verse eid="HOS 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 4:8"/>وہ میرے لوگوں کے گُناہوں پر پلتے ہیں</para>
  <para style="q2" vid="HOS 4:8">اَور اُن کی شرارت سے لُطف اَندوز ہوتے ہیں۔<verse eid="HOS 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 4:9"/>پس جَیسا لوگوں کا حال وَیسا ہی کاہِنوں کا حال ہوگا،</para>
  <para style="q2" vid="HOS 4:9">مَیں اُن دونوں کو اُن کی روِشوں کی سزا دُوں گا</para>
  <para style="q2" vid="HOS 4:9">اَور اُنہیں اُن کے اعمال کا بدلہ دُوں گا۔<verse eid="HOS 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 4:10"/>”وہ کھا تو لیں گے لیکن آسُودہ نہ ہوں گے؛</para>
  <para style="q2" vid="HOS 4:10">وہ جِسم فروشی میں لگے رہیں گے</para>
  <para style="q1" vid="HOS 4:10">لیکن بڑھیں گے نہیں،</para>
  <para style="q2" vid="HOS 4:10">کیونکہ اُنہُوں نے یَاہوِہ کو ترک کر دیا <verse eid="HOS 4:10"/><verse number="11" style="v" sid="HOS 4:11"/>تاکہ اَپنے آپ کو جِسم فروشی،</para>
  <para style="q1" vid="HOS 4:11">اَور پرانی اَور نئی مَے کے حوالہ کر سکیں،</para>
  <para style="q2" vid="HOS 4:11">جِس سے میرے لوگوں کی دانش جاتی رہے۔<verse eid="HOS 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 4:12"/>وہ لکڑی کے بُت سے مشورہ لیتے ہیں</para>
  <para style="q2" vid="HOS 4:12">اَور عصائے الٰہی سے جَواب پاتے ہیں۔</para>
  <para style="q1" vid="HOS 4:12">جِسم فروشی کی رُوح اُنہیں گُمراہ کرتی ہے؛</para>
  <para style="q2" vid="HOS 4:12">اَور وہ اَپنے خُدا بےوفائی کرتے ہیں۔<verse eid="HOS 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 4:13"/>وہ پہاڑوں کی چوٹیوں پر قُربانیاں گزرانتے ہیں</para>
  <para style="q2" vid="HOS 4:13">اَور ٹیلوں پر اَور بلُوط، بید</para>
  <para style="q1" vid="HOS 4:13">اَور بطم کے در درختوں کے خُوشگوار سائے میں</para>
  <para style="q2" vid="HOS 4:13">بخُور جَلاتے ہیں۔</para>
  <para style="q1" vid="HOS 4:13">اِس لیٔے تمہاری بیٹیاں جِسم فروشی پر</para>
  <para style="q2" vid="HOS 4:13">اَور تمہاری بہوئیں زنا پر اُتر آتی ہیں۔<verse eid="HOS 4:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 4:14"/>”جَب تمہاری بیٹیاں فحاشی پر اُتر آتی ہیں</para>
  <para style="q2" vid="HOS 4:14">تَب مَیں اُنہیں سزا نہ دُوں گا،</para>
  <para style="q1" vid="HOS 4:14">نہ تمہاری بہوؤں کو</para>
  <para style="q2" vid="HOS 4:14">جَب وہ زنا کر بیٹھتی ہیں،</para>
  <para style="q1" vid="HOS 4:14">کیونکہ مَرد خُود کسبیوں کے ہمنوا ہوتے ہیں</para>
  <para style="q2" vid="HOS 4:14">اَور دیوداسیوں کے ساتھ قُربانیاں گزرانتے ہیں۔</para>
  <para style="q2" vid="HOS 4:14">ناسمجھ لوگ تباہ ہو جایٔیں گے۔<verse eid="HOS 4:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 4:15"/>”اَے بنی اِسرائیل، خواہ تُم زناکاری کرو،</para>
  <para style="q2" vid="HOS 4:15">لیکن بنی یہُوداہؔ کو گُنہگار نہ ہونے دو۔</para>
  <para style="b" vid="HOS 4:15"/>
  <para style="q1" vid="HOS 4:15">”تُم گِلگالؔ کو نہ جاؤ؛</para>
  <para style="q2" vid="HOS 4:15">نہ ہی بیت آوِنؔ تک جاؤ۔</para>
  <para style="q2" vid="HOS 4:15">اَور نہ یَاہوِہ کی، ’حیات کی قَسم کھاؤ!‘<verse eid="HOS 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 4:16"/>بنی اِسرائیل ایک ضِدّی بچھیا کی مانند، ضِدّی ہیں۔</para>
  <para style="q2" vid="HOS 4:16">پھر یَاہوِہ اُنہیں برّوں کی مانند</para>
  <para style="q2" vid="HOS 4:16">چراگاہ میں کیوں کر چَرائے؟<verse eid="HOS 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 4:17"/>اِفرائیمؔ بُتوں سے مِل گیا؛</para>
  <para style="q2" vid="HOS 4:17">اُسے اکیلا چھوڑ دو!<verse eid="HOS 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 4:18"/>حالانکہ اُن کے جام صبوحی ہٹائے گیٔے،</para>
  <para style="q2" vid="HOS 4:18">حالانکہ وہ مےخواری سے آسُودہ ہو چُکے ہیں۔</para>
  <para style="q1" vid="HOS 4:18">پھر بھی وہ اَپنی جِسم فروشی جاری رکھتے ہیں؛</para>
  <para style="q2" vid="HOS 4:18">اُن کے حُکمرانوں کو شرمناک روِشیں زِیادہ عزیز ہیں۔<verse eid="HOS 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 4:19"/>گِردباد اُنہیں تیزی سے اُڑا لے جائے گا</para>
  <para style="q2" vid="HOS 4:19">اَور اُن کی قُربانیاں اُنہیں رُسوا کریں گی۔<verse eid="HOS 4:19"/></para>
  <chapter eid="HOS 4"/>
  <chapter number="5" style="c" sid="HOS 5"/>
  <para style="s1">اِسرائیل کے خِلاف فیصلہ</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 5:1"/>”اَے کاہِنوں یہ سُنو!</para>
  <para style="q2" vid="HOS 5:1">اَے بنی اِسرائیل دھیان دو!</para>
  <para style="q1" vid="HOS 5:1">اَے شاہی خاندان! سُنو،</para>
  <para style="q2" vid="HOS 5:1">تمہارے خِلاف یُوں فیصلہ کیا گیا ہے:</para>
  <para style="q1" vid="HOS 5:1">تُم مِصفاہؔ میں پھندا،</para>
  <para style="q2" vid="HOS 5:1">اَور تبورؔ پر پھیلا ہُوا جال بَن گیٔے ہو۔<verse eid="HOS 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 5:2"/>باغی خُونریزی میں غرق ہو گئے۔</para>
  <para style="q2" vid="HOS 5:2">لیکن مَیں اُن سَب کی تادیب کروں گا۔<verse eid="HOS 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 5:3"/>مَیں اِفرائیمؔ کے تمام بھید جانتا ہُوں؛</para>
  <para style="q2" vid="HOS 5:3">اَور اِسرائیل بھی مُجھ سے پوشیدہ نہیں ہے۔</para>
  <para style="q1" vid="HOS 5:3">اَے اِفرائیمؔ، تُو اَب جِسم فروشی کی طرف مائل ہو گیا؛</para>
  <para style="q2" vid="HOS 5:3">اَور اِسرائیل بھی بگڑ چُکاہے۔<verse eid="HOS 5:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 5:4"/>”اُن کے اعمال اُنہیں اَپنے خُدا کی طرف</para>
  <para style="q2" vid="HOS 5:4">رُجُوع ہونے کی اِجازت نہیں دیتے۔</para>
  <para style="q1" vid="HOS 5:4">اُن کے دِل میں جِسم فروشی کی رُوح سمائی ہُوئی ہے؛</para>
  <para style="q2" vid="HOS 5:4">وہ یَاہوِہ کو نہیں جانتے۔<verse eid="HOS 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 5:5"/>اِسرائیل کی ضِد اُن کے خِلاف گواہی دیتی ہے؛</para>
  <para style="q2" vid="HOS 5:5">اَور بنی اِسرائیل، یہاں تک کہ اِفرائیمؔ بھی، اَپنے گُناہوں</para>
  <para style="q1" vid="HOS 5:5">میں ٹھوکر کھائیں گے؛</para>
  <para style="q2" vid="HOS 5:5">اَور اُن کے ساتھ یہُوداہؔ بھی ٹھوکر کھائے گا۔<verse eid="HOS 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 5:6"/>جَب وہ اَپنے گلّوں اَور ریوڑوں کے ساتھ</para>
  <para style="q2" vid="HOS 5:6">یَاہوِہ کی تلاش میں نکلتے ہیں،</para>
  <para style="q1" vid="HOS 5:6">تو وہ اُنہیں نہیں پائیں گے؛</para>
  <para style="q2" vid="HOS 5:6">کیونکہ وہ اُن سے دُورہو چُکے ہیں۔<verse eid="HOS 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 5:7"/>اُنہُوں نے یَاہوِہ سے بےوفائی کی ہے؛</para>
  <para style="q2" vid="HOS 5:7">کیونکہ وہ ناجائز اَولاد پیدا کرتے ہیں۔</para>
  <para style="q1" vid="HOS 5:7">اَب اُن کے نئے چاند کے تہوار</para>
  <para style="q2" vid="HOS 5:7">اُنہیں اَور اُن کے کھیتوں کو کھا جایٔیں گے۔<verse eid="HOS 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 5:8"/>”گِبعہؔ میں نرسنگا،</para>
  <para style="q2" vid="HOS 5:8">اَور رامہؔ میں قَرنا پھُونکو۔</para>
  <para style="q1" vid="HOS 5:8">بیت آوِنؔ میں جنگ کی للکار دو؛</para>
  <para style="q2" vid="HOS 5:8">اَے بِنیامین، آگے بڑھ۔<verse eid="HOS 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 5:9"/>حِساب کے دِن</para>
  <para style="q2" vid="HOS 5:9">اِفرائیمؔ ویران ہو جائے گا۔</para>
  <para style="q1" vid="HOS 5:9">جو یقیناً ہونے والا ہے</para>
  <para style="q2" vid="HOS 5:9">اُسے مَیں نے اِسرائیل کے قبائل کو جتا دیا ہے۔<verse eid="HOS 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 5:10"/>بنی یہُوداہؔ کے اُمرا اُن لوگوں کی مانند ہیں</para>
  <para style="q2" vid="HOS 5:10">جو سرحدوں کے نِشان ہٹاتے ہیں۔</para>
  <para style="q1" vid="HOS 5:10">مَیں پانی کے سیلاب کی طرح اَپنا قہر</para>
  <para style="q2" vid="HOS 5:10">اُن پر اُنڈیل دُوں گا۔<verse eid="HOS 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 5:11"/>اِفرائیمؔ مظلوم ہُوا،</para>
  <para style="q2" vid="HOS 5:11">اَور سزا سے روندا گیا،</para>
  <para style="q2" vid="HOS 5:11">کیونکہ وہ بُتوں کی تقلید پر قانع ہے۔<verse eid="HOS 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 5:12"/>مَیں اِفرائیمؔ کے لیٔے کیڑے کے مانند،</para>
  <para style="q2" vid="HOS 5:12">اَور بنی یہُوداہؔ کے لیٔے گھن کی مانند ہُوں۔<verse eid="HOS 5:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 5:13"/>”جَب اِفرائیمؔ نے اَپنی بیماری،</para>
  <para style="q2" vid="HOS 5:13">اَور بنی یہُوداہؔ نے اَپنے زخم دیکھے،</para>
  <para style="q1" vid="HOS 5:13">تَب اِفرائیمؔ نے اشُور کا رُخ کیا،</para>
  <para style="q2" vid="HOS 5:13">اَور عظیم بادشاہ سے مدد کی درخواست کی۔</para>
  <para style="q1" vid="HOS 5:13">لیکن وہ تُجھے شفا نہیں دے سَکتا،</para>
  <para style="q2" vid="HOS 5:13">نہ تیرے زخم ٹھیک کر سَکتا ہے۔<verse eid="HOS 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 5:14"/>مَیں اِفرائیمؔ کے لیٔے شیرببر کی مانند</para>
  <para style="q2" vid="HOS 5:14">اَور بنی یہُوداہؔ کے لیٔے بڑے شیر کی مانند ہُوں گا۔</para>
  <para style="q1" vid="HOS 5:14">مَیں اُنہیں پھاڑ کر اُن کے ٹکڑے ٹکڑے کر دُوں گا اَور چلا جاؤں گا؛</para>
  <para style="q2" vid="HOS 5:14">مَیں اُنہیں لے جاؤں گا اَور کویٔی اُنہیں چھُڑانے والا نہ ہوگا۔<verse eid="HOS 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 5:15"/>پھر جَب تک وہ اَپنے گُناہوں کا اقرار نہیں کرتے</para>
  <para style="q2" vid="HOS 5:15">مَیں اَپنے غار کو واپس چلا جاؤں گا۔</para>
  <para style="q1" vid="HOS 5:15">وہ میرا چہرہ ڈھونڈیں گے؛</para>
  <para style="q2" vid="HOS 5:15">اَور اَپنی مُصیبت میں بڑی سرگرمی سے مُجھے ڈھونڈیں گے۔“<verse eid="HOS 5:15"/></para>
  <chapter eid="HOS 5"/>
  <chapter number="6" style="c" sid="HOS 6"/>
  <para style="s1">اِسرائیل تائب نہ ہُوا</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 6:1"/>چلو، ہم یَاہوِہ کی طرف لَوٹ چلیں۔</para>
  <para style="q1" vid="HOS 6:1">اُنہُوں نے ہمیں پھاڑ کر ٹکڑے ٹکڑے کر دیا</para>
  <para style="q2" vid="HOS 6:1">لیکن وہ ہمیں شفا بخشیں گے؛</para>
  <para style="q1" vid="HOS 6:1">اُنہُوں نے ہمیں زخمی کیا ہے</para>
  <para style="q2" vid="HOS 6:1">لیکن وُہی ہماری چوٹیوں پر پٹّی باندھیں گے۔<verse eid="HOS 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 6:2"/>دو دِنوں کے بعد وہ ہمیں جَلائیں گے؛</para>
  <para style="q2" vid="HOS 6:2">اَور تیسرے دِن وہ ہمیں بحال کریں گے،</para>
  <para style="q2" vid="HOS 6:2">تاکہ ہم اُن کی حُضُوری میں جئیں۔<verse eid="HOS 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 6:3"/>آؤ ہم یَاہوِہ کو قبُول کریں؛</para>
  <para style="q2" vid="HOS 6:3">آؤ ہم اُنہیں قبُول کرنے کی کوشش کریں۔</para>
  <para style="q1" vid="HOS 6:3">جِس طرح آفتاب کا طُلوع ہونا یقینی اَمر ہے،</para>
  <para style="q2" vid="HOS 6:3">اِسی طرح وہ ظاہر ہوں گے؛</para>
  <para style="q1" vid="HOS 6:3">وہ موسمِ سرما کے مینہ کی مانند ہمارے پاس آئیں گے،</para>
  <para style="q2" vid="HOS 6:3">گویا موسمِ بہار کی برسات کی مانند جو زمین کو سیراب کرتی ہے۔<verse eid="HOS 6:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 6:4"/>اَے اِفرائیمؔ، مَیں تیرے ساتھ کیا کروں؟</para>
  <para style="q2" vid="HOS 6:4">اَے بنی یہُوداہؔ، مَیں تیرے ساتھ کیا کروں؟</para>
  <para style="q1" vid="HOS 6:4">کیونکہ تمہاری مَحَبّت صُبح کے کُہر،</para>
  <para style="q2" vid="HOS 6:4">اَور علی الصبح کی اوس کی مانند ہے جو غائب ہو جاتی ہے۔<verse eid="HOS 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 6:5"/>اِس لیٔے مَیں نے تُمہیں اَپنے نبیوں کے ذریعہ کاٹ کر ٹکڑے</para>
  <para style="q2" vid="HOS 6:5">ٹکڑے کر ڈالا،</para>
  <para style="q1" vid="HOS 6:5">اَور اَپنے مُنہ کے کلام سے مار ڈالا؛</para>
  <para style="q2" vid="HOS 6:5">میرے فیصلے بجلی کی مانند تُم پر چمکے۔<verse eid="HOS 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 6:6"/>کیونکہ مَیں قُربانی سے زِیادہ رحم دِلی کو پسند کرتا ہُوں،</para>
  <para style="q2" vid="HOS 6:6">اَور سوختنی نذروں سے بڑھ کر خُدا شناسی چاہتا ہُوں۔<verse eid="HOS 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 6:7"/>اُنہُوں نے آدمؔ کی مانند عہد توڑ دیا۔</para>
  <para style="q2" vid="HOS 6:7">اُنہُوں نے وہاں مُجھ سے بےوفائی کی۔<verse eid="HOS 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 6:8"/>گِلعادؔ بدکاروں کی بستی ہے،</para>
  <para style="q2" vid="HOS 6:8">جہاں کے نقش قدم خُون آلُودہ ہیں۔<verse eid="HOS 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 6:9"/>جِس طرح رَہزنوں کے غول کسی شخص کے گھات میں بیٹھے رہتے ہیں،</para>
  <para style="q2" vid="HOS 6:9">اُسی طرح کاہِنوں کے گِروہ بھی کرتے ہیں؛</para>
  <para style="q1" vid="HOS 6:9">وہ شِکیمؔ کی راہ میں قتل کرتے ہیں</para>
  <para style="q2" vid="HOS 6:9">اَور بدکاری کے جرائم کرتے ہیں۔<verse eid="HOS 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 6:10"/>مَیں نے اِسرائیل کے گھرانے میں</para>
  <para style="q2" vid="HOS 6:10">ایک ہولناک شَے دیکھی ہے۔</para>
  <para style="q1" vid="HOS 6:10">وہاں اِفرائیمؔ جِسم فروشی کرتا ہے</para>
  <para style="q2" vid="HOS 6:10">اَور اِسرائیل ناپاک ہوتاہے۔<verse eid="HOS 6:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 6:11"/>تیرے لیٔے بھی اَے بنی یہُوداہؔ،</para>
  <para style="q2" vid="HOS 6:11">فصل کا وقت مُقرّر کیا جا چُکاہے۔</para>
  <para style="b" vid="HOS 6:11"/>
  <para style="q1" vid="HOS 6:11">جَب بھی مَیں اَپنے لوگوں کے قدیم ایّام کو بحال کروں گا،<verse eid="HOS 6:11"/></para>
  <chapter eid="HOS 6"/>
  <chapter number="7" style="c" sid="HOS 7"/>
  <para style="q2">
    <verse number="1" style="v" sid="HOS 7:1"/>اَور جَب کبھی مَیں اِسرائیل کو شفا بخشوں گا،</para>
  <para style="q1" vid="HOS 7:1">تَب اِفرائیمؔ کے گُناہ ظاہر ہو جایٔیں گے</para>
  <para style="q2" vid="HOS 7:1">اَور سامریہؔ کے جرائم آشکارا ہوں گے۔</para>
  <para style="q1" vid="HOS 7:1">وہ دغاباز ہیں،</para>
  <para style="q2" vid="HOS 7:1">چور گھر میں گھُس آتے ہیں،</para>
  <para style="q2" vid="HOS 7:1">اَور ڈاکُو سڑکوں پر لُوٹ لیتے ہیں۔<verse eid="HOS 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 7:2"/>لیکن اُنہیں احساس نہیں ہوتا</para>
  <para style="q2" vid="HOS 7:2">کہ مُجھے اُن کے تمام بُرے اعمال یاد ہیں۔</para>
  <para style="q1" vid="HOS 7:2">اُن کے گُناہوں نے اُنہیں گھیرلیا ہے؛</para>
  <para style="q2" vid="HOS 7:2">وہ ہمیشہ میرے سامنے رہتے ہیں۔<verse eid="HOS 7:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 7:3"/>وہ اَپنی شرارت سے بادشاہ کا دِل بہلاتے ہیں؛</para>
  <para style="q2" vid="HOS 7:3">اَور اَپنی دروغ گوئی سے اُمرا کو خُوش رکھتے ہیں۔<verse eid="HOS 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 7:4"/>وہ سَب زناکار ہیں،</para>
  <para style="q2" vid="HOS 7:4">جو تنور کی مانند جلتے رہتے ہیں</para>
  <para style="q1" vid="HOS 7:4">جِس کی آگ پکانے والے کو</para>
  <para style="q2" vid="HOS 7:4">آٹا گُوندھنے سے لے کر اُس کے اُبھر آنے تک</para>
  <para style="q2" vid="HOS 7:4">تیز کرنے کی ضروُرت نہیں ہوتی۔<verse eid="HOS 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 7:5"/>ہمارے بادشاہ کے جَشن کے دِن</para>
  <para style="q2" vid="HOS 7:5">اُمرا مَے سے مخمور ہو گئے،</para>
  <para style="q2" vid="HOS 7:5">اَور اُس نے مسخروں سے ہاتھ مِلائے۔<verse eid="HOS 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 7:6"/>اُن کے دِل تنور کی مانند ہیں؛</para>
  <para style="q2" vid="HOS 7:6">اَور وہ سازش کے ساتھ اُن سے ملتے ہیں۔</para>
  <para style="q1" vid="HOS 7:6">اُن کا جذبہ تمام رات اَندر ہی اَندر دہکتا رہتاہے؛</para>
  <para style="q2" vid="HOS 7:6">اَور صُبح کو آگ کے شُعلوں کی مانند بھڑک اُٹھتا ہے۔<verse eid="HOS 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 7:7"/>وہ سَب کے سَب تنور کی مانند گرم رہتے ہیں؛</para>
  <para style="q2" vid="HOS 7:7">اَور اَپنے حُکمرانوں کو کھا جاتے ہیں۔</para>
  <para style="q1" vid="HOS 7:7">اُن کے تمام بادشاہ مارے جاتے ہیں،</para>
  <para style="q2" vid="HOS 7:7">لیکن اُن میں سے کویٔی مُجھے نہیں پُکارتا۔<verse eid="HOS 7:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 7:8"/>اِفرائیمؔ مُختلف قوموں سے مِل جُل گیا ہے؛</para>
  <para style="q2" vid="HOS 7:8">اِفرائیمؔ ایک چپاتی ہے جو پلٹی نہ گئی ہو۔<verse eid="HOS 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 7:9"/>پردیسیوں نے اُس کی قُوّت کو توڑ ڈالا،</para>
  <para style="q2" vid="HOS 7:9">لیکن اُسے اُس کا احساس نہیں ہے۔</para>
  <para style="q1" vid="HOS 7:9">اُس کے بال سفید ہو گئے ہیں،</para>
  <para style="q2" vid="HOS 7:9">لیکن اُس کا بھی اُسے علم نہیں ہے۔<verse eid="HOS 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 7:10"/>اِسرائیل کی ضِد اُس کے خِلاف گواہی دے رہی ہے،</para>
  <para style="q2" vid="HOS 7:10">لیکن اُن سَب کے باوُجُود بھی</para>
  <para style="q1" vid="HOS 7:10">وہ یَاہوِہ اَپنے خُدا کی طرف نہیں لَوٹتا</para>
  <para style="q2" vid="HOS 7:10">اَور نہ ہی اُن کا طالب ہوتاہے۔<verse eid="HOS 7:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 7:11"/>اِفرائیمؔ ایک فاختہ کی مانند ہے،</para>
  <para style="q2" vid="HOS 7:11">جو نادان ہے اَور جسے بآسانی بہکایا جا سَکتا ہے۔</para>
  <para style="q1" vid="HOS 7:11">کبھی تو وہ مِصر کو پُکارتے ہیں،</para>
  <para style="q2" vid="HOS 7:11">اَور کبھی اشُور کی جانِب رُخ کرتے ہیں۔<verse eid="HOS 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 7:12"/>جَب وہ جایٔیں گے تَب مَیں اَپنا جال اُن پر پھیلاؤں گا؛</para>
  <para style="q2" vid="HOS 7:12">اَور اُنہیں ہَوا کے پرندوں کی طرح نیچے کھینچ لاؤں گا۔</para>
  <para style="q1" vid="HOS 7:12">اَور جَب مَیں اُنہیں یکجا ہوتے سُنوں گا،</para>
  <para style="q2" vid="HOS 7:12">تَب مَیں اُنہیں پکڑوں گا۔<verse eid="HOS 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 7:13"/>اُن پر افسوس،</para>
  <para style="q2" vid="HOS 7:13">کیونکہ وہ مُجھ سے بھٹک گیٔے ہیں!</para>
  <para style="q1" vid="HOS 7:13">وہ برباد ہو جایٔیں،</para>
  <para style="q2" vid="HOS 7:13">کیونکہ اُنہُوں نے میرے خِلاف بغاوت کی ہے!</para>
  <para style="q1" vid="HOS 7:13">مَیں اُن کا فدیہ دینا چاہتا ہُوں</para>
  <para style="q2" vid="HOS 7:13">لیکن وہ میرے خِلاف دروغ گوئی کرتے ہیں۔<verse eid="HOS 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 7:14"/>وہ اَپنے دِل سے مُجھ سے فریاد نہیں کرتے</para>
  <para style="q2" vid="HOS 7:14">لیکن اَپنے بِستروں پر پڑے ہُوئے آہ و زاری کرتے ہیں۔</para>
  <para style="q1" vid="HOS 7:14">وہ اناج اَور نئی مَے کی خاطِر اِکٹھّے ہو جاتے ہیں</para>
  <para style="q2" vid="HOS 7:14">لیکن مُجھ سے مُنہ موڑ لیتے ہیں۔<verse eid="HOS 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 7:15"/>مَیں نے اُنہیں تربّیت دی اَور تقویّت بخشی،</para>
  <para style="q2" vid="HOS 7:15">لیکن وہ میرے خِلاف بُرے منصُوبے باندھتے ہیں۔<verse eid="HOS 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 7:16"/>وہ خُداتعالیٰ کی طرف نہیں لَوٹتے؛</para>
  <para style="q2" vid="HOS 7:16">وہ ناقص کمان کی مانند ہیں۔</para>
  <para style="q1" vid="HOS 7:16">اُن کے اُمرا اَپنے گُستاخ کلام کے سبب سے</para>
  <para style="q2" vid="HOS 7:16">تلوار سے مارے جایٔیں گے۔</para>
  <para style="q1" vid="HOS 7:16">اِسی لیٔے مُلک مِصر میں</para>
  <para style="q2" vid="HOS 7:16">اُن کا مذاق اُڑایا جائے گا۔<verse eid="HOS 7:16"/></para>
  <chapter eid="HOS 7"/>
  <chapter number="8" style="c" sid="HOS 8"/>
  <para style="s1">اِسرائیل گِردباد کی فصل کاٹے گا</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 8:1"/>نرسنگا اَپنے ہونٹوں سے لگا لو! چونکہ لوگوں نے میرا</para>
  <para style="q2" vid="HOS 8:1">عہد توڑا اَور میری آئین کے خِلاف بغاوت کی</para>
  <para style="q2" vid="HOS 8:1">اِس لیٔے ایک عُقاب یَاہوِہ کے گھر کے اُوپر ٹوٹ پڑا ہے۔<verse eid="HOS 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 8:2"/>اِسرائیل مُجھے پُکار کر کہتاہے،</para>
  <para style="q2" vid="HOS 8:2">اَے ہمارے خُدا، ہم آپ کو قبُول کرتے ہیں!<verse eid="HOS 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 8:3"/>لیکن اِسرائیل نے بھلائی کو ٹھکرا دیا؛</para>
  <para style="q2" vid="HOS 8:3">اِس لیٔے ایک دُشمن اُس کا تعاقب کرےگا۔<verse eid="HOS 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 8:4"/>وہ میری رضامندی کے بغیر بادشاہوں کو مُقرّر کرتے ہیں؛</para>
  <para style="q2" vid="HOS 8:4">اَور میری تصدیق کے بغیر اُمرا کا انِتخاب کرتے ہیں۔</para>
  <para style="q1" vid="HOS 8:4">اَپنی چاندی اَور سونے سے</para>
  <para style="q2" vid="HOS 8:4">خُود اَپنی تباہی کے لیٔے</para>
  <para style="q2" vid="HOS 8:4">وہ اَپنے لیٔے بُت بناتے ہیں۔<verse eid="HOS 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 8:5"/>اَے سامریہؔ! اَپنے بچھڑے نُما بُت کو پھینک دے،</para>
  <para style="q2" vid="HOS 8:5">میرا قہر اُن کے خِلاف بھڑک اُٹھتا ہے۔</para>
  <para style="q2" vid="HOS 8:5">وہ کب تک پاکیزگی سے عاجز رہیں گے؟<verse eid="HOS 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 8:6"/>وہ اِسرائیل میں بنائے گیٔے ہیں!</para>
  <para style="q2" vid="HOS 8:6">یہ بچھڑا جسے ایک کاریگر نے بنایا؛</para>
  <para style="q1" vid="HOS 8:6">خُدا نہیں ہے۔</para>
  <para style="q2" vid="HOS 8:6">سامریہؔ کے اُس بچھڑے کے</para>
  <para style="q2" vid="HOS 8:6">ٹکڑے ٹکڑے کئے جایٔیں گے۔<verse eid="HOS 8:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 8:7"/>وہ ہَوا بوتے ہیں</para>
  <para style="q2" vid="HOS 8:7">اَور گِردباد کی فصل کاٹتے ہیں۔</para>
  <para style="q1" vid="HOS 8:7">نہ ڈنٹھل میں بالیں لگتی ہیں؛</para>
  <para style="q2" vid="HOS 8:7">نہ اُس میں سے اناج پیدا ہوگا۔</para>
  <para style="q1" vid="HOS 8:7">اَور اگر اُس میں سے اناج پیدا بھی ہو جائے،</para>
  <para style="q2" vid="HOS 8:7">تو پردیسی اُسے چٹ کر جایٔیں گے۔<verse eid="HOS 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 8:8"/>اِسرائیل نگلا جا چُکاہے؛</para>
  <para style="q2" vid="HOS 8:8">اَب وہ قوموں کے درمیان</para>
  <para style="q2" vid="HOS 8:8">ایک ناکارہ شَے کی مانند ہے۔<verse eid="HOS 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 8:9"/>ایک گورخر کی مانند اکیلے بھٹکتے ہُوئے</para>
  <para style="q2" vid="HOS 8:9">وہ اشُور کو چلے گیٔے۔</para>
  <para style="q2" vid="HOS 8:9">اِفرائیمؔ اَپنے یاروں کے ہاتھ بِک چُکاہے۔<verse eid="HOS 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 8:10"/>خواہ اُنہُوں نے اَپنے آپ کو مُختلف قوموں کے درمیان بیچ دیا،</para>
  <para style="q2" vid="HOS 8:10">لیکن مَیں اَب اُنہیں جمع کروں گا۔</para>
  <para style="q1" vid="HOS 8:10">وہ ایک زبردست بادشاہ کے ظُلم کا شِکار ہوکر</para>
  <para style="q2" vid="HOS 8:10">ناتواں ہوتے جایٔیں گے۔<verse eid="HOS 8:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 8:11"/>حالانکہ اِفرائیمؔ نے گُناہ کی قُربانیوں کے لیٔے قُربان گاہیں تعمیر کیں،</para>
  <para style="q2" vid="HOS 8:11">لیکن یہ اَب گُنہگاری کی قُربان گاہیں بَن گئی ہیں۔<verse eid="HOS 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 8:12"/>حالانکہ مَیں نے اُن کے لیٔے اَپنی آئین کی کیٔی چیزیں لِکھ دیں،</para>
  <para style="q2" vid="HOS 8:12">لیکن اُنہُوں نے اُنہیں پرایا سمجھا۔<verse eid="HOS 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 8:13"/>وہ میرے حق میں قُربانیاں گزرانتے ہیں</para>
  <para style="q2" vid="HOS 8:13">اَور وہ اُن کا گوشت کھاتے ہیں،</para>
  <para style="q1" vid="HOS 8:13">لیکن یَاہوِہ اُن سے خُوش نہیں ہوتے۔</para>
  <para style="q2" vid="HOS 8:13">اَب وہ اُن کی شرارت یاد کریں گے</para>
  <para style="q1" vid="HOS 8:13">اَور اُن کے گُناہوں کی سزا دیں گے:</para>
  <para style="q2" vid="HOS 8:13">اَور وہ مِصر لَوٹ جایٔیں گے۔<verse eid="HOS 8:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="HOS 8:14"/>اِسرائیل اَپنے خالق کو فراموش کر چُکاہے</para>
  <para style="q1" vid="HOS 8:14">اَور اُس نے محل تعمیر کئے؛</para>
  <para style="q2" vid="HOS 8:14">بنی یہُوداہؔ نے کیٔی شہروں کو مُستحکم کر لیا۔</para>
  <para style="q1" vid="HOS 8:14">لیکن مَیں اُن کے شہروں پر آگ نازل کروں گا</para>
  <para style="q2" vid="HOS 8:14">جو اُن کے قلعوں کو بھسم کر دے گی۔<verse eid="HOS 8:14"/></para>
  <chapter eid="HOS 8"/>
  <chapter number="9" style="c" sid="HOS 9"/>
  <para style="s1">اِسرائیل کی سزا</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 9:1"/>اَے اِسرائیل مسرُور نہ ہو؛ دُوسری قوموں کی طرح شادمان نہ ہو۔</para>
  <para style="q2" vid="HOS 9:1">کیونکہ تُونے اَپنے خُدا سے بےوفائی کی ہے؛</para>
  <para style="q2" vid="HOS 9:1">تُو ہر کھلیان پر فاحِشہ کی اُجرت کو پسند کرتا ہے۔<verse eid="HOS 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 9:2"/>کھلیان اَور مَے نچُوڑنے کے انگوری حوض لوگوں کا پیٹ نہیں بھریں گے؛</para>
  <para style="q2" vid="HOS 9:2">اَور نئی مَے اُنہیں دھوکا دے گی۔<verse eid="HOS 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 9:3"/>وہ یَاہوِہ کے مُلک میں نہ رہیں گے؛</para>
  <para style="q2" vid="HOS 9:3">اِفرائیمؔ مِصر کو لَوٹے گا</para>
  <para style="q2" vid="HOS 9:3">اَور اشُور میں ناپاک غِذا کھائے گا۔<verse eid="HOS 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 9:4"/>وہ یَاہوِہ کے لیٔے مَے کا تپاون نہ دیں گے،</para>
  <para style="q2" vid="HOS 9:4">نہ ہی اُن کی قُربانیاں اُن کو مقبُول ہُوں گی۔</para>
  <para style="q1" vid="HOS 9:4">اَیسی قُربانیاں اُن کے لیٔے ماتم کرنے والوں کی روٹی کی مانند ہُوں گی؛</para>
  <para style="q2" vid="HOS 9:4">جتنے لوگ اُسے کھایٔیں گے وہ سَب ناپاک ہوں گے۔</para>
  <para style="q1" vid="HOS 9:4">یہ غِذا صِرف اُن ہی کے لیٔے ہوگی؛</para>
  <para style="q2" vid="HOS 9:4">یہ یَاہوِہ کے بیت المُقدّس میں نہ آئے گی۔<verse eid="HOS 9:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 9:5"/>اَپنی مُقرّرہ عیدوں کے موقعوں پر،</para>
  <para style="q2" vid="HOS 9:5">اَور یَاہوِہ کے تہوار کے دِنوں میں تُم کیا کروگے؟<verse eid="HOS 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 9:6"/>خواہ وہ تباہی سے بچ بھی جایٔیں،</para>
  <para style="q2" vid="HOS 9:6">تو بھی مِصر اُنہیں جمع کرےگا،</para>
  <para style="q1" vid="HOS 9:6">اَور میمفِسؔ اُنہیں دفن کرےگا۔</para>
  <para style="q2" vid="HOS 9:6">اُن کی چاندی کے خزانے جھاڑیاں چھین لیں گی،</para>
  <para style="q2" vid="HOS 9:6">اَور کانٹے اُن کے خیموں پر پھیل جایٔیں گے۔<verse eid="HOS 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 9:7"/>سزا کے دِن آ رہے ہیں،</para>
  <para style="q2" vid="HOS 9:7">اَور حِساب کے دِن نزدیک ہیں۔</para>
  <para style="q1" vid="HOS 9:7">اِسرائیل اُسے جان لے۔</para>
  <para style="q2" vid="HOS 9:7">تیرے گُناہوں کی کثرت</para>
  <para style="q1" vid="HOS 9:7">اَور تیری عداوت کی شِدّت کے باعث،</para>
  <para style="q2" vid="HOS 9:7">نبی احمق سمجھا جاتا ہے،</para>
  <para style="q2" vid="HOS 9:7">اَور اِلہام یافتہ اِنسان مجنوں قرار دیا جاتا ہے۔<verse eid="HOS 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 9:8"/>نبی میرے خُدا سمیت،</para>
  <para style="q2" vid="HOS 9:8">اِفرائیمؔ کا نگہبان ہے،</para>
  <para style="q1" vid="HOS 9:8">پھر بھی اَپنی تمام راہوں میں صیّادی پھندے،</para>
  <para style="q2" vid="HOS 9:8">اَور خُدا کے گھر میں عداوت اُس کے منتظر ہوتے ہیں۔<verse eid="HOS 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 9:9"/>گِبعہؔ کے دِنوں کی طرح،</para>
  <para style="q2" vid="HOS 9:9">وہ بداخلاقی میں غرق ہو چُکے ہیں۔</para>
  <para style="q1" vid="HOS 9:9">خُدا اُن کی شرارت کو یاد کرےگا</para>
  <para style="q2" vid="HOS 9:9">اَور اُنہیں اُن کے گُناہوں کی سزا دے گا۔<verse eid="HOS 9:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 9:10"/>جَب مَیں نے اِسرائیل کو پایا،</para>
  <para style="q2" vid="HOS 9:10">تو وہ گویا بیابان کے انگوروں کی مانند تھے؛</para>
  <para style="q1" vid="HOS 9:10">اَور جَب مَیں نے تمہارے آباؤاَجداد کو دیکھا،</para>
  <para style="q2" vid="HOS 9:10">تو یُوں لگاکہ مَیں اَنجیر کے درخت پر پہلا پھل دیکھ رہا ہُوں۔</para>
  <para style="q1" vid="HOS 9:10">لیکن جَب وہ بَعل پعورؔ کے پاس آئے،</para>
  <para style="q2" vid="HOS 9:10">تَب اَپنے آپ کو اُس شرمناک بُت کے لیٔے مخصُوص کیا</para>
  <para style="q2" vid="HOS 9:10">اَور جِس چیز کو عزیز رکھتے تھے اُسی کی مانند حقیر بَن گیٔے۔<verse eid="HOS 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 9:11"/>اِفرائیمؔ کی شان و شوکت پرندہ کی مانند اُڑ جائے گی۔</para>
  <para style="q2" vid="HOS 9:11">اُن میں نہ پیدائش ہوگی، نہ حاملہ کا وُجُود ہوگا، بَلکہ قرارِ حَمل</para>
  <para style="q2" vid="HOS 9:11">بھی موقُوف ہو جائے گا۔<verse eid="HOS 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 9:12"/>اگر وہ بچّوں کی پرورش کر بڑا بھی کر لیں،</para>
  <para style="q2" vid="HOS 9:12">تو بھی مَیں ہر ایک بشر کو چھین لُوں گا۔</para>
  <para style="q1" vid="HOS 9:12">جَب مَیں اُن سے دُورہو جاؤں گا</para>
  <para style="q2" vid="HOS 9:12">تَب اُن کی حالت اَور افسوس ناک ہوگی!<verse eid="HOS 9:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 9:13"/>مَیں نے اِفرائیمؔ کو صُورؔ کی طرح،</para>
  <para style="q2" vid="HOS 9:13">خُوشنما جگہ میں لگا ہُوا دیکھا۔</para>
  <para style="q1" vid="HOS 9:13">لیکن اِفرائیمؔ اَپنے بچّوں کو</para>
  <para style="q2" vid="HOS 9:13">قاتل کے سامنے لے آئے گا۔<verse eid="HOS 9:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 9:14"/>اَے یَاہوِہ اُنہیں دیجئے۔</para>
  <para style="q2" vid="HOS 9:14">لیکن آپ اُنہیں کیا دیں گے؟</para>
  <para style="q1" vid="HOS 9:14">آپ اُنہیں اَیسے رحم دیں جِن میں حَمل ساقط ہو جاتے ہُوں</para>
  <para style="q2" vid="HOS 9:14">اَور اَیسی چھاتِیاں جو خشک ہُوں۔<verse eid="HOS 9:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 9:15"/>گِلگالؔ میں اُن کی تمام شرارت کی وجہ سے،</para>
  <para style="q2" vid="HOS 9:15">مَیں نے اُن سے وہاں نفرت کی۔</para>
  <para style="q1" vid="HOS 9:15">اُن کے گُناہ آلُودہ اعمال کی وجہ سے،</para>
  <para style="q2" vid="HOS 9:15">مَیں اُنہیں اَپنے گھر سے نکال دُوں گا۔</para>
  <para style="q1" vid="HOS 9:15">مَیں اَب اَور اُن سے مَحَبّت نہ رکھوں گا؛</para>
  <para style="q2" vid="HOS 9:15">اُن کے تمام اُمرا باغی ہیں۔<verse eid="HOS 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 9:16"/>اِفرائیمؔ مُرجھاگیا ہے،</para>
  <para style="q2" vid="HOS 9:16">اُن کی جڑ سُوکھ گئی ہے،</para>
  <para style="q1" vid="HOS 9:16">اَور اُن پر پھل نہیں آتا۔</para>
  <para style="q2" vid="HOS 9:16">اگر وہ بچّے جنیں بھی،</para>
  <para style="q2" vid="HOS 9:16">تو مَیں اُن کے دُلاروں کو قتل کر دُوں گا۔<verse eid="HOS 9:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 9:17"/>میرے خُدا اُنہیں ردّ کر دیں گے</para>
  <para style="q2" vid="HOS 9:17">کیونکہ اُنہُوں نے اُن کا حُکم نہ مانا؛</para>
  <para style="q2" vid="HOS 9:17">وہ مُختلف قوموں کے درمیان بھٹکتے پھریں گے۔<verse eid="HOS 9:17"/></para>
  <para style="b"/>
  <chapter eid="HOS 9"/>
  <chapter number="10" style="c" sid="HOS 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 10:1"/>اِسرائیل ایک لہلہاتی ہُوئی انگور کی بیل تھا؛</para>
  <para style="q2" vid="HOS 10:1">جِس میں کثرت سے پھل لگے جوں جوں</para>
  <para style="q1" vid="HOS 10:1">اُس کا پھل بڑھتا گیا،</para>
  <para style="q2" vid="HOS 10:1">اُس نے زِیادہ مذبحے تعمیر کئے؛</para>
  <para style="q1" vid="HOS 10:1">جوں جوں اُس کی زمین سدھرتی گئی،</para>
  <para style="q2" vid="HOS 10:1">اُسی قدر وہ مُقدّس سُتون آراستہ کرتا گیا۔<verse eid="HOS 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 10:2"/>اُن کا دِل دغاباز ہے،</para>
  <para style="q2" vid="HOS 10:2">اَور اَب وہ اَپنے گُناہ کا بار اُٹھائیں۔</para>
  <para style="q1" vid="HOS 10:2">یَاہوِہ اُن کے مذبحوں کو تباہ کر دیں گے</para>
  <para style="q2" vid="HOS 10:2">اَور اُن کے مُقدّس سُتون بھی گرا دیں گے۔<verse eid="HOS 10:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 10:3"/>تَب وہ کہیں، ”گے ہمارا کویٔی بادشاہ نہیں</para>
  <para style="q2" vid="HOS 10:3">کیونکہ ہم نے یَاہوِہ کی تعظیم نہ کی۔</para>
  <para style="q1" vid="HOS 10:3">لیکن ہمارا کویٔی بادشاہ ہوتا بھی،</para>
  <para style="q2" vid="HOS 10:3">تو وہ ہمارے لیٔے کیا کرتا؟“<verse eid="HOS 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 10:4"/>وہ باتیں بہت بناتے ہیں،</para>
  <para style="q2" vid="HOS 10:4">جھُوٹی قَسمیں کھا کھا کر</para>
  <para style="q2" vid="HOS 10:4">عہدوپیمان کرتے ہیں؛</para>
  <para style="q1" vid="HOS 10:4">اِس لیٔے اُن کے جُتے ہُوئے کھیت میں اُگی ہُوئی زہریلی بُوٹیوں کی مانند</para>
  <para style="q2" vid="HOS 10:4">اُن میں مُقدّمے کھڑے ہو جاتے ہیں۔<verse eid="HOS 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 10:5"/>سامریہؔ کے باشِندے۔</para>
  <para style="q2" vid="HOS 10:5">بیت آوِنؔ<note caller="+" style="f"><char style="fr" closed="false">10‏:5 </char><char style="fq" closed="false">بیت آوِنؔ </char><char style="ft" closed="false">دُوسرا نام بیت ایل کے بگڑ جانے پر اِسے بدی کا گھر سے پُکارا</char></note> کے بچھڑے کے بُت کے لیٔے خوفزدہ ہوں گے۔</para>
  <para style="q1" vid="HOS 10:5">اُن کے لوگ اُن کے لیٔے ماتم کریں گے،</para>
  <para style="q2" vid="HOS 10:5">اَور اُن کے بُت پرست کاہِنؔ بھی،</para>
  <para style="q1" vid="HOS 10:5">جو اُن کی شان و شوکت سے شادمان تھے،</para>
  <para style="q2" vid="HOS 10:5">کیونکہ اَب وہ اُن کے درمیان سے ہٹا کر جَلاوطن کیا گیا۔<verse eid="HOS 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 10:6"/>اُسے اشُور لے جایا جائے گا</para>
  <para style="q2" vid="HOS 10:6">اَور عظیم بادشاہ کی نذر کیا جائے گا۔</para>
  <para style="q1" vid="HOS 10:6">اِفرائیمؔ ندامت اُٹھائے گا؛</para>
  <para style="q2" vid="HOS 10:6">اَور اِسرائیل اَپنے غَیر قوموں کی مشورت سے شرمندہ ہوگا۔<verse eid="HOS 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 10:7"/>سامریہؔ اَور اُس کا بادشاہ</para>
  <para style="q2" vid="HOS 10:7">پانی کی سطح پر بہنے والی ٹہنی کی مانند بہہ جایٔیں گے۔<verse eid="HOS 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 10:8"/>اَور شرارت سے پُر اُونچے مقامات</para>
  <para style="q2" vid="HOS 10:8">جو اِسرائیل کے گُناہ ہیں تباہ کئے جایٔیں گے۔</para>
  <para style="q1" vid="HOS 10:8">اُن کے مذبحوں پر</para>
  <para style="q2" vid="HOS 10:8">کانٹے اَور خاردار جھاڑیاں چھا جایٔیں گی۔</para>
  <para style="q1" vid="HOS 10:8">تَب وہ پہاڑوں سے کہیں گے، ”ہمیں چھُپا لو!“</para>
  <para style="q2" vid="HOS 10:8">اَور ٹیلوں سے کہیں گے، کہ ہم پر گِر پڑو!<verse eid="HOS 10:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 10:9"/>اَے اِسرائیل تُو گِبعہؔ کے ایّام سے گُناہ کرتا آیا ہے،</para>
  <para style="q2" vid="HOS 10:9">اَور تُو ابھی تک وہیں ہے۔</para>
  <para style="q1" vid="HOS 10:9">کیا گِبعہؔ میں</para>
  <para style="q2" vid="HOS 10:9">جنگ بدکاروں تک نہیں جا پہُنچی؟<verse eid="HOS 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 10:10"/>جَب مَیں چاہُوں اُنہیں سزا دُوں گا؛</para>
  <para style="q2" vid="HOS 10:10">مُختلف قوموں کو اُن کے خِلاف جمع کیا جائے گا</para>
  <para style="q2" vid="HOS 10:10">تاکہ اُن کے دوہرے گُناہ کے سبب سے اُنہیں جکڑ لیں۔<verse eid="HOS 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 10:11"/>اِفرائیمؔ تربّیت یافتہ بچھیا ہے</para>
  <para style="q2" vid="HOS 10:11">جو اناج گاہنا پسند کرتی ہے؛</para>
  <para style="q1" vid="HOS 10:11">چنانچہ مَیں اُس کی خُوبصورت گردن پر</para>
  <para style="q2" vid="HOS 10:11">جُوا رکھ دُوں گا۔</para>
  <para style="q1" vid="HOS 10:11">اَور اِفرائیمؔ کو ہانکوں گا،</para>
  <para style="q2" vid="HOS 10:11">یہُوداہؔ کو ہل چلانا ہوگا،</para>
  <para style="q2" vid="HOS 10:11">اَور یعقوب ڈھیلے توڑے گا۔<verse eid="HOS 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 10:12"/>اَپنے لیٔے راستبازی بوؤ،</para>
  <para style="q2" vid="HOS 10:12">اَور شفقت کے پھل حاصل کرو،</para>
  <para style="q2" vid="HOS 10:12">اَپنی اُفتادہ زمین جو تو؛</para>
  <para style="q1" vid="HOS 10:12">کیونکہ اَب یَاہوِہ کے طالب ہونے کا موقع ہے،</para>
  <para style="q2" vid="HOS 10:12">تاکہ وہ آئیں</para>
  <para style="q2" vid="HOS 10:12">اَور تُم پر راستی برسائیں۔<verse eid="HOS 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 10:13"/>لیکن تُم نے شرارت بوئی،</para>
  <para style="q2" vid="HOS 10:13">اَور بدی کی فصل کاٹی،</para>
  <para style="q1" vid="HOS 10:13">تُم نے فریب کا پھل کھایا ہے۔</para>
  <para style="q2" vid="HOS 10:13">چونکہ تُم نے خُود اَپنی قُوّت پر</para>
  <para style="q2" vid="HOS 10:13">اَور اَپنے لاتعداد سپاہیوں پر اِعتماد کیا۔<verse eid="HOS 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 10:14"/>اِس لیٔے تیرے لوگوں کے خِلاف لڑائی کی للکار اُٹھے گی،</para>
  <para style="q2" vid="HOS 10:14">تاکہ تیرے سَب قلعے اَیسے مِسمار کئے جایٔیں گے۔</para>
  <para style="q1" vid="HOS 10:14">جَیسے شلمنؔ نے لڑائی کے وقت بیت اربیلؔ کو مِسمار کیا تھا،</para>
  <para style="q2" vid="HOS 10:14">اَور ماؤں کو اُن کے بچّوں سمیت زمین پر پٹکا گیا تھا۔<verse eid="HOS 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 10:15"/>چونکہ تیری خباثت اِس قدر زِیادہ ہے،</para>
  <para style="q2" vid="HOS 10:15">اِس لیٔے اَے بیت ایل تیرے ساتھ بھی اَیسا ہی سلُوک کیا جائے گا۔</para>
  <para style="q1" vid="HOS 10:15">جَب وہ دِن آئے گا،</para>
  <para style="q2" vid="HOS 10:15">تَب اِسرائیل کا بادشاہ فنا ہو جائے گا۔<verse eid="HOS 10:15"/></para>
  <chapter eid="HOS 10"/>
  <chapter number="11" style="c" sid="HOS 11"/>
  <para style="s1">اِسرائیل سے خُدا کی مَحَبّت</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 11:1"/>جَب اِسرائیل بچّہ ہی تھا کہ مَیں نے</para>
  <para style="q2" vid="HOS 11:1">اُس سے مَحَبّت کی، اَور اَپنے بیٹے کو مِصر سے بُلایا۔<verse eid="HOS 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 11:2"/>لیکن جِتنا زِیادہ میں اِسرائیل کو بُلاتا گیا،</para>
  <para style="q2" vid="HOS 11:2">وہ مُجھ سے اَور دُور جاتے رہے۔</para>
  <para style="q1" vid="HOS 11:2">اُنہُوں نے بَعل معبُودوں کے لیٔے قُربانیاں پیش کیں</para>
  <para style="q2" vid="HOS 11:2">اَور بُتوں کے سامنے بخُور جَلایا۔<verse eid="HOS 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 11:3"/>مَیں نے اِفرائیمؔ کو چلنا سِکھایا،</para>
  <para style="q2" vid="HOS 11:3">اَور اُنہیں گود میں اُٹھایا؛</para>
  <para style="q1" vid="HOS 11:3">لیکن اُنہُوں نے یہ نہ جانا</para>
  <para style="q2" vid="HOS 11:3">کہ مَیں نے ہی اُنہیں شفا بخشی۔<verse eid="HOS 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 11:4"/>مَیں اُنہیں اِنسانی شفقت کی رسّیوں،</para>
  <para style="q2" vid="HOS 11:4">اَور مَحَبّت کے رشتہ میں جکڑ کر لے گیا؛</para>
  <para style="q1" vid="HOS 11:4">مَیں نے اُن کی گردن پر سے جُوا ہٹایا</para>
  <para style="q2" vid="HOS 11:4">اَور جھُک کر اُنہیں کھانا کھِلایا۔<verse eid="HOS 11:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 11:5"/>اَب جَب کہ وہ تَوبہ کرنے سے اِنکار کرتے ہیں</para>
  <para style="q2" vid="HOS 11:5">تو کیا وہ مِصر نہ لَوٹیں گے</para>
  <para style="q2" vid="HOS 11:5">اَور کیا شاہِ اشُور اُن پر حُکومت نہ کرےگا؟<verse eid="HOS 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 11:6"/>اُن کے شہروں میں تلواریں چلیں گی،</para>
  <para style="q2" vid="HOS 11:6">اُن کے پھاٹکوں کے اڑبنگوں کو تباہ کر دیا جائے گا</para>
  <para style="q2" vid="HOS 11:6">اَور اُن کے منصُوبوں کو خاک میں مِلا دیا جائے گا۔<verse eid="HOS 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 11:7"/>میرے لوگ مُجھ سے برگشتہ ہونے پر آمادہ ہیں۔</para>
  <para style="q2" vid="HOS 11:7">خواہ وہ خُداتعالیٰ کو پُکاریں،</para>
  <para style="q2" vid="HOS 11:7">تو بھی وہ اُن کو ہرگز اِعزاز نہ بخشیں گے۔<verse eid="HOS 11:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 11:8"/>اَے اِفرائیمؔ! مَیں تُجھ سے کیسے دست بردار ہو جاؤں؟</para>
  <para style="q2" vid="HOS 11:8">اَور اَے اِسرائیل مَیں تُجھے کیسے ترک کروں؟</para>
  <para style="q1" vid="HOS 11:8">مَیں تیرے ساتھ اَدمہؔ کی مانند کیسے سلُوک کروں؟</para>
  <para style="q2" vid="HOS 11:8">اَور تُجھے ضبوئیمؔ کی مانند کیسے بناؤں؟</para>
  <para style="q1" vid="HOS 11:8">میرے دِل میں تغیُّر آ چُکاہے؛</para>
  <para style="q2" vid="HOS 11:8">اَور میری تمام شفقت اُمنڈ آئی ہے۔<verse eid="HOS 11:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 11:9"/>مَیں اَپنے قہر شدید کو بھڑکنے نہ دُوں گا،</para>
  <para style="q2" vid="HOS 11:9">نہ مَیں پلٹ کر اِفرائیمؔ کو تباہ کروں گا۔</para>
  <para style="q1" vid="HOS 11:9">کیونکہ مَیں خُدا ہُوں، اِنسان نہیں۔</para>
  <para style="q2" vid="HOS 11:9">تمہارے درمیان سکونت کرنے والا قُدُّوس ہُوں۔</para>
  <para style="q2" vid="HOS 11:9">مَیں قہر لے کر نہ آؤں گا۔<verse eid="HOS 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 11:10"/>وہ یَاہوِہ کی پیروی کریں گے؛</para>
  <para style="q2" vid="HOS 11:10">وہ شیرببر کی طرح گرجیں گے۔</para>
  <para style="q1" vid="HOS 11:10">اَور جَب وہ گرجیں گے،</para>
  <para style="q2" vid="HOS 11:10">تَب اُن کے بچّے تھرتھراتے ہُوئے مغرب سے آئیں گے۔<verse eid="HOS 11:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 11:11"/>یَاہوِہ یُوں فرماتے ہیں۔ وہ مِصر کے پرندوں</para>
  <para style="q2" vid="HOS 11:11">اَور اشُور کے کبُوتروں کی مانند،</para>
  <para style="q1" vid="HOS 11:11">کانپتے ہُوئے آئیں گے۔</para>
  <para style="q2" vid="HOS 11:11">اَور مَیں اُنہیں اُن کے گھروں میں بساؤں گا،<verse eid="HOS 11:11"/></para>
  <para style="s1">اِسرائیل کا گُناہ</para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 11:12"/>اِفرائیمؔ نے دغا سے،</para>
  <para style="q2" vid="HOS 11:12">اَور اِسرائیل کے گھرانے نے مکّاری سے مُجھے گھیر رکھا ہے۔</para>
  <para style="q1" vid="HOS 11:12">اَور یہُوداہؔ خُدا کے خِلاف بے قابو ہے،</para>
  <para style="q2" vid="HOS 11:12">یہاں تک کہ وفادار قُدُّوس کے خِلاف بے قابُو بنا رہتاہے۔<verse eid="HOS 11:12"/></para>
  <chapter eid="HOS 11"/>
  <chapter number="12" style="c" sid="HOS 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 12:1"/>اِفرائیمؔ ہَوا کھا کر پیٹ بھرتاہے؛</para>
  <para style="q2" vid="HOS 12:1">وہ دِن بھر بادِ مشرق کا پیچھا کرتا رہتاہے</para>
  <para style="q1" vid="HOS 12:1">اَور لگاتار دروغ گوئی اَور تشدّد کو فروغ دیتاہے۔</para>
  <para style="q2" vid="HOS 12:1">وہ اشُور کے ساتھ عہد کرتا ہے</para>
  <para style="q2" vid="HOS 12:1">اَور مِصر کو زَیتُون کا تیل بھیجتا ہے۔<verse eid="HOS 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 12:2"/>یَاہوِہ کو یہُودیؔہ کے خِلاف بھی شکایت ہے؛</para>
  <para style="q2" vid="HOS 12:2">وہ یعقوب کو اُس کی روِشوں کے مُطابق سزا دیں گے</para>
  <para style="q2" vid="HOS 12:2">اَور اُن کے اعمال کے مُطابق صِلہ دیں گے۔<verse eid="HOS 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 12:3"/>اُس نے رحم میں اَپنے بھایٔی کی اِیڑی پکڑی؛</para>
  <para style="q2" vid="HOS 12:3">اَور بڑا ہوکر خُدا کے ساتھ کُشتی لڑی۔<verse eid="HOS 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 12:4"/>وہ فرشتہ سے بھی لڑا اَور اُس پر غالب آیا؛</para>
  <para style="q2" vid="HOS 12:4">وہ رُویا اَور اُن سے مِنّت کی۔</para>
  <para style="q1" vid="HOS 12:4">اُس نے خُدا کو بیت ایل میں پایا</para>
  <para style="q2" vid="HOS 12:4">اَور وہاں اُن سے بات چیت کی۔<verse eid="HOS 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 12:5"/>یعنی قادرمُطلق یَاہوِہ خُدا سے،</para>
  <para style="q2" vid="HOS 12:5">جِن کا ممتاز نام یَاہوِہ ہے!<verse eid="HOS 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 12:6"/>لیکن تُو اَپنے خُدا کی طرف لَوٹ جا؛</para>
  <para style="q2" vid="HOS 12:6">مَحَبّت اَور اِنصاف کو قائِم رکھ،</para>
  <para style="q2" vid="HOS 12:6">اَور ہمیشہ اَپنے خُدا کا منتظر رہ۔<verse eid="HOS 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 12:7"/>سوداگر جھُوٹا ترازو اِستعمال کرتا ہے؛</para>
  <para style="q2" vid="HOS 12:7">وہ دھوکا دہی سے مَحَبّت کرتا ہے۔<verse eid="HOS 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 12:8"/>اِفرائیمؔ شیخی مارتا ہے کہ،</para>
  <para style="q2" vid="HOS 12:8">مَیں بہت بڑا رئیس ہُوں مَیں دولتمند بَن گیا ہُوں۔</para>
  <para style="q1" vid="HOS 12:8">میری اِس قدر دولت کے باعث</para>
  <para style="q2" vid="HOS 12:8">وہ مُجھ میں کویٔی بُرائی یا گُناہ نہ پائیں گے۔<verse eid="HOS 12:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 12:9"/>مَیں یَاہوِہ تمہارا خُدا ہُوں،</para>
  <para style="q2" vid="HOS 12:9">جو تُمہیں مِصر میں سے نکال لایا؛</para>
  <para style="q1" vid="HOS 12:9">مَیں تُمہیں پھر خیموں میں اَیسا بساؤں گا،</para>
  <para style="q2" vid="HOS 12:9">جَیسے تمہاری مُقرّرہ عیدوں کے ایّام میں ہُوا کرتا تھا۔<verse eid="HOS 12:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 12:10"/>مَیں نے نبیوں سے کلام کیا،</para>
  <para style="q2" vid="HOS 12:10">اُنہیں بہت سِی رُویتیں دِکھائیں</para>
  <para style="q2" vid="HOS 12:10">اَور اُن کی مَعرفت تمثیلیں بتائیں۔<verse eid="HOS 12:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 12:11"/>کیا گِلعادؔ بدکار ہے؟</para>
  <para style="q2" vid="HOS 12:11">اُس کے لوگ ناکارہ ہیں!</para>
  <para style="q1" vid="HOS 12:11">کیا گِلگالؔ میں بَیل ذبح کئے جاتے ہیں؟</para>
  <para style="q2" vid="HOS 12:11">اُن کے مذبحے جُتے ہُوئے کھیت میں</para>
  <para style="q2" vid="HOS 12:11">پڑے ہُوئے پتّھروں کے ڈھیر کی مانند ہوں گے۔<verse eid="HOS 12:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 12:12"/>یعقوب ارام کے مُلک کو فرار ہو گیا؛</para>
  <para style="q2" vid="HOS 12:12">اَور اِسرائیل نے بیوی کی خاطِر خدمت کی،</para>
  <para style="q1" vid="HOS 12:12">اَور اُس کی قیمت چُکانے کے لیٔے گلّہ بانی کی۔<verse eid="HOS 12:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="HOS 12:13"/>یَاہوِہ ایک نبی کے ذریعہ اِسرائیل کو مِصر سے نکال لائے،</para>
  <para style="q2" vid="HOS 12:13">ایک نبی ہی کے ذریعہ اُنہُوں نے اُن کی خبرگیری کی۔<verse eid="HOS 12:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 12:14"/>لیکن اِفرائیمؔ نے یَاہوِہ کو شدید غُصّہ دِلایا؛</para>
  <para style="q2" vid="HOS 12:14">اِس لیٔے اُس کا خُداوؔند اُس کی خُونریزی کا گُناہ اِسی کی گردن پر رکھیں گے</para>
  <para style="q2" vid="HOS 12:14">اَور اُسے اَپنی توہین کا صِلہ دیں گے۔<verse eid="HOS 12:14"/></para>
  <chapter eid="HOS 12"/>
  <chapter number="13" style="c" sid="HOS 13"/>
  <para style="s1">اِسرائیل کے خِلاف قہر یَاہوِہ</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 13:1"/>جَب اِفرائیمؔ بولتا تھا تو لوگ کانپ اُٹھتے تھے؛</para>
  <para style="q2" vid="HOS 13:1">اُسے اِسرائیل میں اِعزاز بخشا گیا۔</para>
  <para style="q2" vid="HOS 13:1">لیکن وہ بَعل کی عبادت کرنے سے گُنہگار ٹھہرا اَور مَر گیا۔<verse eid="HOS 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 13:2"/>اَب وہ اَور بھی گُناہ کرتے ہیں؛</para>
  <para style="q2" vid="HOS 13:2">اَور اَپنی چاندی سے اَپنے لیٔے بُت بناتے ہیں،</para>
  <para style="q1" vid="HOS 13:2">جو نہایت ماہر بُت تراش کی تراشی ہُوئی مورتیں ہیں،</para>
  <para style="q2" vid="HOS 13:2">اَور سَب کی سَب دستکاروں کی دستکاری ہیں۔</para>
  <para style="q1" vid="HOS 13:2">اُن لوگوں کے متعلّق کہا جاتا ہے کہ،</para>
  <para style="q2" vid="HOS 13:2">وہ اِنسان کی قُربانی گزرانتے ہیں!</para>
  <para style="q2" vid="HOS 13:2">اَور بچھڑوں کے بُتوں کو چُومتے ہیں۔<verse eid="HOS 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 13:3"/>لہٰذا وہ صُبح کے کُہر،</para>
  <para style="q2" vid="HOS 13:3">اَور علی الصبح کی غائب ہونے والی اوس،</para>
  <para style="q1" vid="HOS 13:3">اَور کھلیان سے اُڑنے والی بھُوسی،</para>
  <para style="q2" vid="HOS 13:3">یا کھڑکی میں سے نکلتے ہُوئے دھوئیں کی مانند ہوں گے۔<verse eid="HOS 13:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 13:4"/>لیکن مَیں یَاہوِہ تمہارا خُدا ہُوں،</para>
  <para style="q2" vid="HOS 13:4">جو تُمہیں مُلکِ مِصر سے نکال لایا۔</para>
  <para style="q1" vid="HOS 13:4">تُم میرے سِوا کسی کو اَور خُدا کرکے نہ ماننا،</para>
  <para style="q2" vid="HOS 13:4">اَور میرے سِوا کویٔی اَور مُنجّی نہیں۔<verse eid="HOS 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 13:5"/>مَیں نے بیابان میں،</para>
  <para style="q2" vid="HOS 13:5">یعنی چلچلاتی ہُوئی دھوپ کے مُلک میں تمہاری خبرگیری کی۔<verse eid="HOS 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 13:6"/>جَب مَیں اُنہیں کھانا کھِلاتا تو وہ سیر ہو جاتے؛</para>
  <para style="q2" vid="HOS 13:6">اَور جَب وہ سیر ہو گئے تو مغروُر ہو گئے؛</para>
  <para style="q2" vid="HOS 13:6">تَب وہ مُجھے فراموش کر بیٹھے۔<verse eid="HOS 13:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 13:7"/>اِس لیٔے مَیں اُن پر شیرببر کی طرح جھپٹ پڑوں گا،</para>
  <para style="q2" vid="HOS 13:7">اَور چیتے کی مانند راہ میں گھات لگائے بیٹھا رہُوں گا۔<verse eid="HOS 13:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 13:8"/>میں اُس ریچھنی کی مانند جِس کے بچّے چھین لیٔے گیٔے ہُوں،</para>
  <para style="q2" vid="HOS 13:8">اُن پر حملہ کروں گا اَور اُنہیں پھاڑ کر رکھ دُوں گا۔</para>
  <para style="q1" vid="HOS 13:8">ایک شیرببر کی مانند میں اُنہیں نگل جاؤں گا،</para>
  <para style="q2" vid="HOS 13:8">ایک جنگلی جانور اُنہیں پھاڑ ڈالے گا۔<verse eid="HOS 13:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 13:9"/>اَے اِسرائیل تُو تباہ ہو چُکاہے،</para>
  <para style="q2" vid="HOS 13:9">کیونکہ تُو میرا یعنی اَپنے مددگار کا مُخالف ہے۔<verse eid="HOS 13:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 13:10"/>تیرا وہ بادشاہ کہاں ہے جو تُجھے بچائے؟</para>
  <para style="q2" vid="HOS 13:10">تیرے تمام شہروں کے وہ اُمرا کہاں ہیں،</para>
  <para style="q1" vid="HOS 13:10">جِن کے متعلّق تُونے کہاتھا،</para>
  <para style="q2" vid="HOS 13:10">مُجھے بادشاہ اَور اُمرا عنایت کر؟<verse eid="HOS 13:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 13:11"/>اِس لیٔے اَپنے قہر میں مَیں نے تُجھے بادشاہ دیا،</para>
  <para style="q2" vid="HOS 13:11">اَور اَپنے غضب میں اُسے مٹا دیا۔<verse eid="HOS 13:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 13:12"/>اِفرائیمؔ کی خطا جمع کی گئی،</para>
  <para style="q2" vid="HOS 13:12">اَور اُس کے گُناہ درج کئے گیٔے۔<verse eid="HOS 13:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 13:13"/>وہ دردِزہ کی مانند تکلیف میں مُبتلا ہے،</para>
  <para style="q2" vid="HOS 13:13">لیکن وہ ایک بے عقل بچّہ ہے؛</para>
  <para style="q1" vid="HOS 13:13">کیونکہ جَب وقت قریب آتا ہے،</para>
  <para style="q2" vid="HOS 13:13">تَب وہ رحم کے مُنہ تک نہیں آتا۔<verse eid="HOS 13:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 13:14"/>”مَیں اُنہیں قبر کے قابُو سے چھُڑا دُوں گا؛</para>
  <para style="q2" vid="HOS 13:14">اَور اُنہیں موت سے رِہائی بخشوں گا۔</para>
  <para style="q1" vid="HOS 13:14">اَے موت تیری وَبا کہاں ہے؟</para>
  <para style="q2" vid="HOS 13:14">اَے قبر تیری ہلاکت کہاں ہے؟</para>
  <para style="b" vid="HOS 13:14"/>
  <para style="q1" vid="HOS 13:14">”مَیں ہرگز رحم نہ کروں گا،<verse eid="HOS 13:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="HOS 13:15"/>چاہے وہ اَپنے بھائیوں کے درمیان بڑھتا رہے۔</para>
  <para style="q2" vid="HOS 13:15">یَاہوِہ کی طرف سے بادِ مشرق آئے گی،</para>
  <para style="q1" vid="HOS 13:15">جو بیابان کی جانِب سے چلے گی؛</para>
  <para style="q2" vid="HOS 13:15">اُس کا سوتا سُوکھ جائے گا</para>
  <para style="q1" vid="HOS 13:15">اَور اُس کا چشمہ خشک ہو جائے گا۔</para>
  <para style="q2" vid="HOS 13:15">اُس کے گودام میں سے</para>
  <para style="q2" vid="HOS 13:15">تمام خزانے لُوٹ لیٔے جایٔیں گے۔<verse eid="HOS 13:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 13:16"/>سامریہؔ کے باشِندے اَپنی خطاؤں کا بوجھ اُٹھائیں گے،</para>
  <para style="q2" vid="HOS 13:16">کیونکہ اُنہُوں نے اَپنے خُدا کے خِلاف بغاوت کی ہے۔</para>
  <para style="q1" vid="HOS 13:16">وہ تلوار سے مارے جایٔیں گے؛</para>
  <para style="q2" vid="HOS 13:16">اَور اُن کے چُھوٹے بچّے زمین پر پٹکے جایٔیں گے،</para>
  <para style="q2" vid="HOS 13:16">اَور اُن کی حاملہ عورتیں چیر ڈالی جایٔیں گی۔“<verse eid="HOS 13:16"/></para>
  <chapter eid="HOS 13"/>
  <chapter number="14" style="c" sid="HOS 14"/>
  <para style="s1">رحمت کی خاطِر تَوبہ</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 14:1"/>اَے اِسرائیل، یَاہوِہ اَپنے خُدا کی طرف لَوٹ آ۔</para>
  <para style="q2" vid="HOS 14:1">تیرے گُناہ تیرے زوال کا باعث بَن چُکے ہیں!<verse eid="HOS 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 14:2"/>کلام اَپنے ساتھ لے کر</para>
  <para style="q2" vid="HOS 14:2">یَاہوِہ کی طرف لَوٹ آ۔</para>
  <para style="q1" vid="HOS 14:2">اُن سے کہہ:</para>
  <para style="q2" vid="HOS 14:2">”ہمارے تمام گُناہ بخش دیں</para>
  <para style="q1" vid="HOS 14:2">اَور فضل سے ہمیں قبُول فرمائیں،</para>
  <para style="q2" vid="HOS 14:2">تاکہ ہم اَپنے لبوں سے شُکر گزاری کی قُربانی اَدا کریں۔<verse eid="HOS 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 14:3"/>اشُور ہمیں بچا نہیں سَکتا؛</para>
  <para style="q2" vid="HOS 14:3">نہ ہم جنگی گھوڑوں پر سوار ہوں گے۔</para>
  <para style="q1" vid="HOS 14:3">ہم پھر کبھی اَپنے ہاتھوں سے تراشی ہُوئی چیزوں کو</para>
  <para style="q2" vid="HOS 14:3">’ہمارے معبُود‘ نہ کہیں گے،</para>
  <para style="q2" vid="HOS 14:3">کیونکہ یتیموں کو آپ ہی میں شفقت ملتی ہے۔“<verse eid="HOS 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 14:4"/>”مَیں اُن کی برگشتگی کو ٹھیک کر دُوں گا</para>
  <para style="q2" vid="HOS 14:4">اَور اُن سے بےحد مَحَبّت رکھوں گا،</para>
  <para style="q2" vid="HOS 14:4">کیونکہ میرا قہر اُن پر سے ٹل گیا ہے۔<verse eid="HOS 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 14:5"/>مَیں اِسرائیل کے لیٔے اوس کی مانند ہُوں گا؛</para>
  <para style="q2" vid="HOS 14:5">اَور وہ شُوشنؔ کی مانند پھُولے گا۔</para>
  <para style="q1" vid="HOS 14:5">اَور لبانونؔ کے دیودار کی مانند</para>
  <para style="q2" vid="HOS 14:5">اَپنی جڑیں پھیلائے گا؛<verse eid="HOS 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 14:6"/>اُس کی ملائم کونپلیں بڑھیں گی۔</para>
  <para style="q2" vid="HOS 14:6">اُس کی شوکت زَیتُون کے درخت کی مانند ہوگی،</para>
  <para style="q2" vid="HOS 14:6">اَور اُس کی خُوشبو لبانونؔ کے دیودار کے مانند ہوگی۔<verse eid="HOS 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 14:7"/>لوگ پھر سے اُس کے سایہ میں بسیں گے۔</para>
  <para style="q2" vid="HOS 14:7">اَور وہ اناج کی مانند بڑھےگا۔</para>
  <para style="q1" vid="HOS 14:7">وہ انگور کی بیل کی مانند شگفتہ ہوگا،</para>
  <para style="q2" vid="HOS 14:7">اَور اُس کی شہرت لبانونؔ کی مَے کی مانند ہوگی۔<verse eid="HOS 14:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 14:8"/>اَے اِفرائیمؔ مُجھے بُتوں سے اَور کیا سروکار ہے؟</para>
  <para style="q2" vid="HOS 14:8">مَیں اُسے جَواب دُوں گا اَور اُس کی خبرگیری کروں گا۔</para>
  <para style="q1" vid="HOS 14:8">مَیں صنوبر کے سرسبز درخت کی مانند ہُوں؛</para>
  <para style="q2" vid="HOS 14:8">تُو مُجھ ہی سے برومند ہُوا۔“<verse eid="HOS 14:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 14:9"/>دانشمند کون ہے؟ وُہی اُن چیزوں کو سمجھ پایٔےگا۔</para>
  <para style="q2" vid="HOS 14:9">دُور اَندیش کون ہے؟ وُہی اُنہیں جان لے گا۔</para>
  <para style="q1" vid="HOS 14:9">کیونکہ یَاہوِہ کی راہیں راست ہیں؛</para>
  <para style="q2" vid="HOS 14:9">اَور راستباز اُن پر چلتے ہیں،</para>
  <para style="q2" vid="HOS 14:9">لیکن باغی اُن میں ٹھوکر کھاتے ہیں۔<verse eid="HOS 14:9"/></para>
  <chapter eid="HOS 14"/>
</usx>
