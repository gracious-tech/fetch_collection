<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Biblica® Open Urdu Contemporary Version</book>
  <para style="h">عامُوسؔ</para>
  <para style="toc1">عامُوسؔ کی نبُوّت</para>
  <para style="toc2">عامُوسؔ</para>
  <para style="toc3">عامُوسؔ</para>
  <para style="mt1">عامُوسؔ</para>
  <para style="mt2">کی نبُوّت</para>
  <chapter number="1" style="c" sid="AMO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1"/>عامُوسؔ نبی کا کلام جو تقوعؔ کے ایک چرواہے تھے۔ اُنہُوں نے زلزلہ سے دو سال پہلے بنی اِسرائیل کی بابت رُویا دیکھی، جَب شاہِ یہُودیؔہ عُزّیاہؔ اَور یرُبعامؔ بِن یہُوآشؔ مُلکِ اِسرائیل کا بادشاہ تھا۔<verse eid="AMO 1:1"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2"/>عامُوسؔ نبی نے فرمایا،</para>
  <para style="q1" vid="AMO 1:2">یَاہوِہ صِیّونؔ سے دہاڑتے ہیں</para>
  <para style="q2" vid="AMO 1:2">اَور یروشلیمؔ سے گرجتے ہیں،</para>
  <para style="q1" vid="AMO 1:2">چرواہوں کی چراگاہیں سُوکھ رہی ہیں،</para>
  <para style="q2" vid="AMO 1:2">اَور کرمِلؔ کی چوٹی مُرجھا رہی ہے۔<verse eid="AMO 1:2"/></para>
  <para style="s1">بنی اِسرائیل کے ہمسایوں پر فیصلہ</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3"/>یَاہوِہ یُوں فرماتے ہیں،</para>
  <para style="q1" vid="AMO 1:3">دَمشق شہر کے تین</para>
  <para style="q2" vid="AMO 1:3">نہیں بَلکہ چار گُناہوں کے باعث، مَیں اُسے بے سزا نہیں چھوڑوں گا۔</para>
  <para style="q2" vid="AMO 1:3">کیونکہ اُس نے گِلعادؔ کو</para>
  <para style="q2" vid="AMO 1:3">لوہے کے دھاردار آہنی اوزار سے روند ڈالا۔<verse eid="AMO 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 1:4"/>میں حزائیلؔ کے گھرانے پر آگ نازل کروں گا</para>
  <para style="q2" vid="AMO 1:4">جو بِن ہددؔ کے شاہی محلوں کو جَلا کر راکھ کر دے گی۔<verse eid="AMO 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 1:5"/>میں دَمشق کے پھاٹکوں کو توڑ دُوں گا؛</para>
  <para style="q2" vid="AMO 1:5">اَور آوِنؔ کی وادی<note caller="+" style="f"><char style="fr" closed="false">1‏:5 </char><char style="fq" closed="false">آوِنؔ کی وادی </char><char style="ft" closed="false">یعنی شرارت</char></note> کے بادشاہ کو</para>
  <para style="q1" vid="AMO 1:5">اَور اُس کو جو بیت عدنؔ پر حُکمرانی کرتا ہے ہلاک کر دُوں گا</para>
  <para style="q2" vid="AMO 1:5">اَور ارامی لوگ جَلاوطن ہوکر قیرؔ کو جایٔیں گے۔</para>
  <para style="q2" vid="AMO 1:5">یہی یَاہوِہ کا فرمان ہے۔<verse eid="AMO 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6"/>یَاہوِہ یُوں فرماتے ہیں،</para>
  <para style="q1" vid="AMO 1:6">غزّہؔ کے تین بَلکہ چار گُناہوں کے باعث،</para>
  <para style="q2" vid="AMO 1:6">مَیں اُسے سزا دینے سے باز نہیں آؤں گا۔</para>
  <para style="q1" vid="AMO 1:6">کیونکہ اُس نے پُوری قوم کو اسیر کر لیا</para>
  <para style="q2" vid="AMO 1:6">اَور اُنہیں اِدُوم کے ہاتھ بیچ دیا۔<verse eid="AMO 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 1:7"/>اِس لئے مَیں غزّہؔ کے شہرپناہ پر آگ بھیجوں گا</para>
  <para style="q2" vid="AMO 1:7">جو اُس کے شاہی محلوں کو جَلا کر راکھ کر دے گی۔<verse eid="AMO 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 1:8"/>مَیں شاہِ اشدُودؔ کو</para>
  <para style="q2" vid="AMO 1:8">اَور شاہِ اشقلونؔ کو ہلاک کر دُوں گا۔</para>
  <para style="q1" vid="AMO 1:8">مَیں عقرونؔ کے خِلاف اَپنا ہاتھ بڑھاؤں گا،</para>
  <para style="q2" vid="AMO 1:8">جَب تک کہ آخِری فلسطینی ہلاک نہ ہو جائے،</para>
  <para style="q2" vid="AMO 1:8">یہی یَاہوِہ قادر کا فرمان ہے۔<verse eid="AMO 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9"/>یَاہوِہ یُوں فرماتے ہیں،</para>
  <para style="q1" vid="AMO 1:9">مَیں صُورؔ کے تین بَلکہ اُس کے چار گُناہوں کے باعث،</para>
  <para style="q2" vid="AMO 1:9">مَیں اُسے بے سزا نہ چھوڑوں گا۔</para>
  <para style="q1" vid="AMO 1:9">کیونکہ اُس نے سَب کو اسیر کرکے اُنہیں اِدُوم کو بیچ دیا،</para>
  <para style="q2" vid="AMO 1:9">اَور برادرانہ عہد کا لحاظ نہ کیا،<verse eid="AMO 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 1:10"/>اِس لیٔے مَیں صُورؔ کی شہرپناہ پر آگ نازل کروں گا</para>
  <para style="q2" vid="AMO 1:10">جو اُس کے شاہی محلوں کو جَلا کر راکھ کر دے گی۔<verse eid="AMO 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11"/>یَاہوِہ یُوں فرماتے ہیں،</para>
  <para style="q1" vid="AMO 1:11">اِدُوم کے تین بَلکہ چار گُناہوں کے باعث،</para>
  <para style="q2" vid="AMO 1:11">مَیں اُسے بے سزا نہ چھوڑوں گا۔</para>
  <para style="q1" vid="AMO 1:11">کیونکہ اُس نے بےرحم ہوکر، اَپنے بھائیوں کو تلوار لے کر رگیدا،</para>
  <para style="q2" vid="AMO 1:11">اَور مُلک کی عورتوں کا قتل عام کیا</para>
  <para style="q1" vid="AMO 1:11">اَور اُس کا قہر ہمیشہ بھڑکتا رہا،</para>
  <para style="q2" vid="AMO 1:11">اَور اُس کا غضب کبھی ختم نہ ہُوا۔<verse eid="AMO 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 1:12"/>مَیں تیمانؔ پر آگ نازل کروں گا،</para>
  <para style="q2" vid="AMO 1:12">جو بُضراؔہ کے شاہی محلوں کو جَلا کر راکھ کر دے گی۔<verse eid="AMO 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13"/>یَاہوِہ یُوں فرماتے ہیں،</para>
  <para style="q1" vid="AMO 1:13">عمُّون کے تین بَلکہ چار گُناہوں کے باعث</para>
  <para style="q2" vid="AMO 1:13">مَیں اُسے بے سزا نہ چھوڑوں گا۔</para>
  <para style="q1" vid="AMO 1:13">کیونکہ اُس نے اَپنی سرحدوں کو بڑھانے کے لیٔے</para>
  <para style="q2" vid="AMO 1:13">گِلعادؔ کی حاملہ عورتوں کے پیٹ چاک کئے،<verse eid="AMO 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 1:14"/>جَب جنگ کے وقت شوروغل ہو رہے ہوں گے،</para>
  <para style="q2" vid="AMO 1:14">جَب زبردست طُوفان اَور قتل عام ہو رہے ہوں گے</para>
  <para style="q1" vid="AMO 1:14">اُس وقت، مَیں ربّہؔ کی شہرپناہ پر آگ نازل کروں گا</para>
  <para style="q2" vid="AMO 1:14">جو اُس کے شاہی محلوں کو جَلا کر راکھ کر دے گی۔<verse eid="AMO 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 1:15"/>یَاہوِہ فرماتے ہیں،</para>
  <para style="q2" vid="AMO 1:15">عمُّون کا بادشاہ اَپنے حاکموں کے ساتھ،</para>
  <para style="q2" vid="AMO 1:15">اسیری میں جائے گا۔<verse eid="AMO 1:15"/></para>
  <chapter eid="AMO 1"/>
  <chapter number="2" style="c" sid="AMO 2"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1"/>یَاہوِہ یُوں فرماتے ہیں،</para>
  <para style="q1" vid="AMO 2:1">مُوآب کے تین بَلکہ چار گُناہوں کے باعث</para>
  <para style="q2" vid="AMO 2:1">مَیں اُسے بے سزا نہیں چھوڑوں گا۔</para>
  <para style="q1" vid="AMO 2:1">کیونکہ اُس نے اِدُوم کے بادشاہ کی ہڈّیوں کو</para>
  <para style="q2" vid="AMO 2:1">جَلا کر راکھ کر دیا تھا۔<verse eid="AMO 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 2:2"/>اِس لئے مَیں مُوآب پر بڑی آگ نازل کروں گا</para>
  <para style="q2" vid="AMO 2:2">جو قِریوتؔ کے شاہی محلوں کو جَلا کر راکھ کر دے گی۔</para>
  <para style="q1" vid="AMO 2:2">مُوآب جنگ کی للکار</para>
  <para style="q2" vid="AMO 2:2">اَور نرسنگوں کی آواز کے شور و غُل کے درمیان مَرے گا۔<verse eid="AMO 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 2:3"/>یَاہوِہ فرماتے ہیں،</para>
  <para style="q2" vid="AMO 2:3">مَیں اُس کے حُکمران کو</para>
  <para style="q2" vid="AMO 2:3">اُس کے حاکموں کے ساتھ غارت کروں گا۔<verse eid="AMO 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4"/>یَاہوِہ یُوں فرماتے ہیں،</para>
  <para style="q1" vid="AMO 2:4">مَیں بنی یہُوداہؔ کے تین بَلکہ چار گُناہوں کے باعث</para>
  <para style="q2" vid="AMO 2:4">مَیں اُسے بے سزا نہ چھوڑوں گا۔</para>
  <para style="q1" vid="AMO 2:4">کیونکہ اُنہُوں نے یَاہوِہ کے آئین کو ترک کر دیا</para>
  <para style="q2" vid="AMO 2:4">اَور اُن کے قوانین پر عَمل نہیں کیا،</para>
  <para style="q1" vid="AMO 2:4">اُن کے جھُوٹے معبُودوں نے ہی اُنہیں</para>
  <para style="q2" vid="AMO 2:4">جِن کی اُن کے آباؤاَجداد پیروی کرتے تھے گُمراہ کیا۔<verse eid="AMO 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 2:5"/>مَیں یہُوداہؔ پر آگ نازل کروں گا</para>
  <para style="q2" vid="AMO 2:5">جو یروشلیمؔ کے شاہی محلوں کو جَلا کر راکھ کر دے گی۔<verse eid="AMO 2:5"/></para>
  <para style="s1">بنی اِسرائیل کا اِنصاف</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6"/>یَاہوِہ یُوں فرماتے ہیں،</para>
  <para style="q1" vid="AMO 2:6">بنی اِسرائیل کے تین بَلکہ چار گُناہوں کی باعث</para>
  <para style="q2" vid="AMO 2:6">مَیں اُسے بے سزا نہ چھوڑوں گا۔</para>
  <para style="q1" vid="AMO 2:6">وہ چاندی کے لیٔے راستباز کو،</para>
  <para style="q2" vid="AMO 2:6">اَور ایک جوڑی جُوتی کی خاطِر حاجت مند کو بیچ دیتے ہیں۔<verse eid="AMO 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 2:7"/>وہ کنگال کے سَر کو اَیسا کُچلتے ہیں</para>
  <para style="q2" vid="AMO 2:7">جَیسے زمین پر دُھول کو روندا جاتا ہے</para>
  <para style="q2" vid="AMO 2:7">وہ مظلوموں کو اِنصاف نہیں دیتے۔</para>
  <para style="q1" vid="AMO 2:7">باپ اَور بیٹا دونوں ایک ہی لڑکی سے ہم بِستر ہوتے ہیں،</para>
  <para style="q2" vid="AMO 2:7">اَور اَیسا کرکے وہ میرے پاک نام کو ناپاک کرتے ہیں۔<verse eid="AMO 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 2:8"/>وہ ہر مذبح کے بازو میں</para>
  <para style="q2" vid="AMO 2:8">گروی رکھے ہُوئے کپڑوں پر لیٹتے ہیں۔</para>
  <para style="q1" vid="AMO 2:8">اَور اَپنے معبُودوں کے گھر میں</para>
  <para style="q2" vid="AMO 2:8">جرمانے کی رقم سے مَے نوشی کرتے ہیں۔<verse eid="AMO 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 2:9"/>مَیں نے ہی اُن کے سامنے امُوریوں کو نِیست و نابود کیا،</para>
  <para style="q2" vid="AMO 2:9">حالانکہ امُوری دیودار کی طرح اُونچے</para>
  <para style="q2" vid="AMO 2:9">اَور بلُوط کے درخت کی مانند مضبُوط تھے۔</para>
  <para style="q1" vid="AMO 2:9">ہاں مَیں نے ہی اُوپر سے اُن کا پھل</para>
  <para style="q2" vid="AMO 2:9">اَور نیچے سے اُن کی جڑیں کاٹ دی۔<verse eid="AMO 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 2:10"/>اَور مَیں ہی تُمہیں مِصر سے باہر نکال کر لایا،</para>
  <para style="q2" vid="AMO 2:10">اَور چالیس بَرس تک بیابان میں تمہاری رہبری کرتا رہا،</para>
  <para style="q2" vid="AMO 2:10">تاکہ تُم امُوریوں کے مُلک پر قابض ہو جاؤ۔<verse eid="AMO 2:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 2:11"/>یَاہوِہ فرماتے ہیں،</para>
  <para style="q2" vid="AMO 2:11">مَیں نے ہی تمہارے بیٹوں میں سے نبی</para>
  <para style="q1" vid="AMO 2:11">اَور تمہارے جَوانوں میں سے نذیر برپا کئے۔</para>
  <para style="q2" vid="AMO 2:11">اَے بنی اِسرائیل، کیا یہ سچ نہیں ہے؟<verse eid="AMO 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 2:12"/>لیکن تُم نے نذیروں کو مَے پلائی</para>
  <para style="q2" vid="AMO 2:12">اَور نبیوں کو حُکم دیا کہ نبُوّت نہ کریں۔<verse eid="AMO 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 2:13"/>اِس لئے اَب مَیں تُم کو اَیسا کُچل دُوں گا</para>
  <para style="q2" vid="AMO 2:13">جَیسے گلّے سے بھری ہُوئی گاڑی کُچلتی ہے۔<verse eid="AMO 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 2:14"/>تیز رفتار سے دَوڑنے والا بھی نہ بچنے پایٔےگا،</para>
  <para style="q2" vid="AMO 2:14">اَور زورآور کی طاقت جاتی رہے گی،</para>
  <para style="q2" vid="AMO 2:14">اَور سُورما بھی اَپنی جان بچا نہ سکےگا۔<verse eid="AMO 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 2:15"/>تیر اَنداز کھڑا نہ رہ سکےگا،</para>
  <para style="q2" vid="AMO 2:15">اَور تیز دَوڑنے والا فَوجی بھی بھاگ نہ پائے گا،</para>
  <para style="q2" vid="AMO 2:15">اَور گُھڑسوار بھی اَپنی جان نہ بچا سکےگا۔<verse eid="AMO 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 2:16"/>اُس دِن بڑے بڑے سُورما بھی</para>
  <para style="q2" vid="AMO 2:16">اَپنے کپڑے چھوڑکر بھاگ جائیں گے۔ یہ یَاہوِہ کا فرمان ہے۔<verse eid="AMO 2:16"/></para>
  <chapter eid="AMO 2"/>
  <chapter number="3" style="c" sid="AMO 3"/>
  <para style="s1">بنی اِسرائیل کے خِلاف گواہوں کا بُلایا جانا</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1"/>اَے بنی اِسرائیل، یَاہوِہ کا یہ کلام سُنو اِس پُورے خاندان کے خِلاف جسے مَیں مِصر سے باہر نکال کر لایا:<verse eid="AMO 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 3:2"/>”دُنیا کے سَب گھرانوں میں سے</para>
  <para style="q2" vid="AMO 3:2">مَیں نے صِرف تُمہیں مُنتخب کیا ہے؛</para>
  <para style="q1" vid="AMO 3:2">اِس لیٔے مَیں تُمہیں تمہارے سارے</para>
  <para style="q2" vid="AMO 3:2">گُناہوں کی سزا دُوں گا۔“<verse eid="AMO 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 3:3"/>کیا یہ ممکن ہے کہ بغیر آپسی رضامندی کے</para>
  <para style="q2" vid="AMO 3:3">دو شخص ایک ساتھ چل سکتے ہیں؟<verse eid="AMO 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 3:4"/>کیا شیر بغیر شِکار پائے</para>
  <para style="q2" vid="AMO 3:4">جنگل میں گرجتا ہے؟</para>
  <para style="q1" vid="AMO 3:4">اگر شیر نے کچھ شِکار نہ کیا ہو</para>
  <para style="q2" vid="AMO 3:4">تو کیا وہ اَپنی ماند میں غُرّا سَکتا ہے؟<verse eid="AMO 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 3:5"/>اگر جال نہ لگایا گیا ہو</para>
  <para style="q2" vid="AMO 3:5">تو کیا پرندہ اُس میں پھنس سکتا ہے؟</para>
  <para style="q1" vid="AMO 3:5">کیا پھندا جَب تک کہ اُس میں کچھ پھنسا نہ ہو</para>
  <para style="q2" vid="AMO 3:5">زمین پر سے اُچھل سَکتا ہے؟<verse eid="AMO 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 3:6"/>جَب شہر میں نرسنگے کی آواز بُلند ہوتی ہے،</para>
  <para style="q2" vid="AMO 3:6">تو کیا لوگ کانپ نہیں جاتے؟</para>
  <para style="q1" vid="AMO 3:6">کیا یَاہوِہ کے بھیجے بغیر ہی</para>
  <para style="q2" vid="AMO 3:6">کسی شہر پر آفت آتی ہے۔<verse eid="AMO 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 3:7"/>یقیناً، یَاہوِہ قادر اَپنے خادِم نبیوں پر</para>
  <para style="q2" vid="AMO 3:7">اَپنا منصُوبہ ظاہر کئے بغیر</para>
  <para style="q2" vid="AMO 3:7">کچھ بھی نہیں کرتے۔<verse eid="AMO 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 3:8"/>جَب شیر گرجتا ہے۔</para>
  <para style="q2" vid="AMO 3:8">تو کون ہے جو خوف نہ کھائے گا؟</para>
  <para style="q1" vid="AMO 3:8">یَاہوِہ قادر نے کلام کیا ہے۔</para>
  <para style="q2" vid="AMO 3:8">تُو کون ہے جو نبُوّت نہ کرےگا؟<verse eid="AMO 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 3:9"/>اشدُودؔ کے شاہی محلوں</para>
  <para style="q2" vid="AMO 3:9">اَور مِصر کے شاہی محلوں میں مُنادی کرو</para>
  <para style="q1" vid="AMO 3:9">سَب کوہِ سامریہؔ پر جمع ہو جاؤ؛</para>
  <para style="q2" vid="AMO 3:9">اَور دیکھو اُس میں کیسا ہنگامہ</para>
  <para style="q2" vid="AMO 3:9">اَور اُس کے لوگوں کے درمیان کیسا ظُلم ہے۔<verse eid="AMO 3:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 3:10"/>یَاہوِہ فرماتے ہیں: جو لوگ اَپنے شاہی محلوں میں لُوٹ مار کرتے ہیں</para>
  <para style="q2" vid="AMO 3:10">اَور مالِ غنیمت جمع کرتے ہیں،</para>
  <para style="q2" vid="AMO 3:10">وہ نیکی کرنا جانتے ہی نہیں۔<verse eid="AMO 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 3:11"/>چنانچہ یَاہوِہ قادر یُوں فرماتے ہیں،</para>
  <para style="q1" vid="AMO 3:11">ایک دُشمن تمہارے مُلک کا محاصرہ کرےگا؛</para>
  <para style="q2" vid="AMO 3:11">وہ تمہارے شاہی قلعوں کو ڈھا دے گا،</para>
  <para style="q2" vid="AMO 3:11">اَور تمہارے شاہی محلوں کو لُوٹ لے گا۔<verse eid="AMO 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12"/>یَاہوِہ یُوں فرماتے ہیں،</para>
  <para style="q1" vid="AMO 3:12">جِس طرح سے چرواہا ٹانگوں کی دو ہڈّی یا کان کا ایک ٹکڑا ہی،</para>
  <para style="q2" vid="AMO 3:12">شیر کے مُنہ سے چُھڑا پاتاہے،</para>
  <para style="q1" vid="AMO 3:12">اُسی طرح بنی اِسرائیل بھی جو سامریہؔ میں سکونت کرتے ہیں،</para>
  <para style="q2" vid="AMO 3:12">اَیسے بچائے جائیں گے جَیسے پلنگ کا گوشہ</para>
  <para style="q2" vid="AMO 3:12">اَور پلنگ سے کپڑے کا ایک ٹکڑا۔<verse eid="AMO 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13"/>یَاہوِہ قادرمُطلق خُدا فرماتے ہیں، سُنو اَور یعقوب کے گھرانے کے خِلاف گواہی دو۔<verse eid="AMO 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 3:14"/>جِس دِن مَیں بنی اِسرائیل کو اُس کے گُناہوں کی سزا دُوں گا،</para>
  <para style="q2" vid="AMO 3:14">تو مَیں بیت ایل کے مذبحوں کو نِیست و نابود کر دُوں گا؛</para>
  <para style="q1" vid="AMO 3:14">اَور مذبح کے سینگ کاٹ کر</para>
  <para style="q2" vid="AMO 3:14">زمین پر گرا دئیے جایٔیں گے۔<verse eid="AMO 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 3:15"/>یَاہوِہ اعلان فرماتے ہیں،</para>
  <para style="q2" vid="AMO 3:15">مَیں سردیوں اَور گرمیوں کے</para>
  <para style="q1" vid="AMO 3:15">رِہائشی گھروں کو نِیست و نابود کر دُوں گا؛</para>
  <para style="q2" vid="AMO 3:15">اَور ہاتھی دانت سے سجائے ہُوئے گھر ویران کر دئیے جایٔیں گے،</para>
  <para style="q1" vid="AMO 3:15">اَور محلوں کو گرا دیا جائے گا۔<verse eid="AMO 3:15"/></para>
  <chapter eid="AMO 3"/>
  <chapter number="4" style="c" sid="AMO 4"/>
  <para style="s1">بنی اِسرائیل کا خُدا کی طرف رُجُوع نہ ہونا</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 4:1"/>اَے باشانؔ کی گایوں، ”تُم یہ کلام سُنو! تُم جو کوہِ سامریہؔ پر رہتی ہو،</para>
  <para style="q2" vid="AMO 4:1">اَے عورتوں تُم جو غریبوں کو ستاتی ہو اَور ضروُرت مندوں کو کُچلتی ہو</para>
  <para style="q2" vid="AMO 4:1">اَور اَپنے شوہروں سے کہتی ہو کہ ہماری مَے نوشی کے لیٔے کچھ لاؤ!“<verse eid="AMO 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 4:2"/>یَاہوِہ قادر اَپنی پاکیزگی کی قَسم کھا کر فرماتے ہیں</para>
  <para style="q2" vid="AMO 4:2">دیکھو، مُستقبِل میں تُم پر اَیسے دِن ضروُر آنے والے ہیں،</para>
  <para style="q1" vid="AMO 4:2">جَب تمہاری ناک میں کانٹا پھنسا کر لے جایا جائے گا،</para>
  <para style="q2" vid="AMO 4:2">اَور تمہاری اَولادوں کو مچھلی پکڑنے والے کانٹے میں پھنسا کر لے جایا جائے گا۔<verse eid="AMO 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 4:3"/>یَاہوِہ فرماتے ہیں،</para>
  <para style="q2" vid="AMO 4:3">تُم مَیں سے ہر ایک دیوار کی دراڑوں سے ہوکر</para>
  <para style="q1" vid="AMO 4:3">سیدھے باہر فرار ہو جاؤگے</para>
  <para style="q2" vid="AMO 4:3">اَور تُمہیں حرمُونؔ کی طرف پھینک دیا جائے گا۔<verse eid="AMO 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 4:4"/>بیت ایل میں جاؤ اَور گُناہ کرو؛</para>
  <para style="q2" vid="AMO 4:4">گِلگالؔ میں جا کر اَور زِیادہ گُناہ کرو۔</para>
  <para style="q1" vid="AMO 4:4">ہر صُبح کو اَپنی قُربانیاں،</para>
  <para style="q2" vid="AMO 4:4">اَور ہر تیسرے روز اَپنی دہ یکی لاؤ۔<verse eid="AMO 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 4:5"/>یَاہوِہ قادر فرماتے ہیں،</para>
  <para style="q2" vid="AMO 4:5">خمیری روٹی کے شُکر گُزاری کی نذر آگ میں گذرانو</para>
  <para style="q1" vid="AMO 4:5">اَور اَپنی رضا کی قُربانیاں پر فخر کرو،</para>
  <para style="q2" vid="AMO 4:5">اَور اَے بنی اِسرائیل اُن قُربانیوں پر فخر کرو،</para>
  <para style="q2" vid="AMO 4:5">کیونکہ تُم کو اَیسا کرنا پسند ہے۔<verse eid="AMO 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 4:6"/>یَاہوِہ فرماتے ہیں،</para>
  <para style="q2" vid="AMO 4:6">مَیں نے تُمہیں ہر شہر میں خالی پیٹ رکھا</para>
  <para style="q1" vid="AMO 4:6">اَور ہر شہر میں روٹی کی کمی دی،</para>
  <para style="q2" vid="AMO 4:6">پھر بھی تُم میری طرف رُجُوع نہ لائے۔<verse eid="AMO 4:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 4:7"/>اگرچہ مَیں نے بارش کو اُس وقت تک روک دیا</para>
  <para style="q2" vid="AMO 4:7">جَب فصل پکنے میں تین مہینے باقی تھے۔</para>
  <para style="q1" vid="AMO 4:7">تَب مَیں نے بارش روکے رکھی،</para>
  <para style="q2" vid="AMO 4:7">مَیں نے ایک شہر پر بارش کی اَور دُوسرے سے روک رکھی۔</para>
  <para style="q1" vid="AMO 4:7">ایک کھیت پر بارش ہوئی؛</para>
  <para style="q2" vid="AMO 4:7">اَور دُوسرا کھیت بارش نہ ہونے کے باعث سُوکھ گیا۔<verse eid="AMO 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 4:8"/>لوگ پانی کی تلاش میں ایک بستی سے دُوسری بستی میں مارے مارے پھرتے رہے،</para>
  <para style="q2" vid="AMO 4:8">لیکن اُنہیں پینے کا پانی نہیں مِلا،</para>
  <para style="q1" vid="AMO 4:8">یَاہوِہ فرماتے ہیں،</para>
  <para style="q2" vid="AMO 4:8">پھر بھی تُم میری طرف رُجُوع نہ ہُوئے۔<verse eid="AMO 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 4:9"/>کیٔی مرتبہ مَیں نے تمہارے باغوں اَور تاکستانوں پر،</para>
  <para style="q2" vid="AMO 4:9">بادِ سموم اَور پھپھُوندی سے مارا۔</para>
  <para style="q1" vid="AMO 4:9">ٹِڈّیوں نے تمہارے اَنجیر اَور زَیتُون کے درختوں کو چٹ کر لیا،</para>
  <para style="q2" vid="AMO 4:9">یَاہوِہ کا فرمان ہے،</para>
  <para style="q2" vid="AMO 4:9">تو بھی تُم میری طرف رُجُوع نہ ہُوئے،<verse eid="AMO 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 4:10"/>مَیں نے تمہارے اُوپر وَبا بھیجی</para>
  <para style="q2" vid="AMO 4:10">جَیسی کہ مِصر میں بھیجی تھی۔</para>
  <para style="q1" vid="AMO 4:10">مَیں نے تمہارے جَوانوں کو تلوار سے قتل کیا</para>
  <para style="q2" vid="AMO 4:10">اَور تمہارے گھوڑے چھین لئے۔</para>
  <para style="q1" vid="AMO 4:10">مَیں نے تمہارے نتھنوں کو لشکرگاہ کی بدبُو سے بھر دیا،</para>
  <para style="q2" vid="AMO 4:10">یَاہوِہ کا فرمان ہے،</para>
  <para style="q2" vid="AMO 4:10">تو بھی تُم میری طرف رُجُوع نہ ہُوئے۔<verse eid="AMO 4:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 4:11"/>مَیں نے تُم میں سے بعض کو</para>
  <para style="q2" vid="AMO 4:11">سدُومؔ اَور عمورہؔ کی طرح نِیست و نابود کر دیا۔</para>
  <para style="q1" vid="AMO 4:11">تُم اُس جلتی ہُوئی لکڑی کی مانند تھے جو گویا آگ میں سے نکالی گئی ہو،</para>
  <para style="q2" vid="AMO 4:11">تو بھی تُم میری طرف رُجُوع نہ ہُوئے،</para>
  <para style="q2" vid="AMO 4:11">یہ یَاہوِہ کا فرمان ہے۔<verse eid="AMO 4:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 4:12"/>اِس لیٔے، اَے بنی اِسرائیل مَیں تمہارے ساتھ یہ کروں گا،</para>
  <para style="q2" vid="AMO 4:12">اَور چونکہ مَیں تمہارے ساتھ یہ کروں گا،</para>
  <para style="q2" vid="AMO 4:12">اِس لیٔے، اَے بنی اِسرائیل تُو اَپنے خُدا سے مِلنے کی تیّاری کر۔<verse eid="AMO 4:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13"/>جِس نے پہاڑوں کو،</para>
  <para style="q2" vid="AMO 4:13">اَور ہَوا کو خلق کیا،</para>
  <para style="q2" vid="AMO 4:13">اَورجو اَپنے خیالات اِنسانوں پر ظاہر کرتے ہیں،</para>
  <para style="q1" vid="AMO 4:13">جو صُبح کو تاریکی میں تبدیل کرتے ہیں،</para>
  <para style="q2" vid="AMO 4:13">اَور زمین کے اُونچے مقامات پر چلتے ہیں،</para>
  <para style="q2" vid="AMO 4:13">اُن کا نام یَاہوِہ قادرمُطلق خُدا ہے۔<verse eid="AMO 4:13"/></para>
  <chapter eid="AMO 4"/>
  <chapter number="5" style="c" sid="AMO 5"/>
  <para style="s1">نوحہ اَور تَوبہ کے لیٔے بُلانا</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1"/>اَے بنی اِسرائیل یہ کلام سُنو۔ مَیں یہ نوحہ تمہاری بابت کر رہا ہُوں،<verse eid="AMO 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2"/>کنواری اِسرائیل گِر گئی</para>
  <para style="q2" vid="AMO 5:2">اَور پھر کبھی نہیں اُٹھے گی،</para>
  <para style="q1" vid="AMO 5:2">وہ اَپنے ہی مُلک میں تنہا چھوڑ دی گئی</para>
  <para style="q2" vid="AMO 5:2">اَور کویٔی اُس کو اُٹھانے والا نہیں۔<verse eid="AMO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3"/>یَاہوِہ قادر یُوں فرماتے ہیں،</para>
  <para style="q1" vid="AMO 5:3">تمہارا شہر اِسرائیل جو ایک ہزار سُورماؤں کو لے کر آگے کوچ کرتا تھا</para>
  <para style="q2" vid="AMO 5:3">اُس میں سے صِرف سَو باقی رہ جایٔیں گے؛</para>
  <para style="q1" vid="AMO 5:3">اَور تمہارے قصبے جِس میں سے سَو نکلتے تھے</para>
  <para style="q2" vid="AMO 5:3">اُس میں دس ہی باقی رہ جایٔیں گے۔<verse eid="AMO 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4"/>یَاہوِہ بنی اِسرائیل سے یُوں فرماتے ہیں،</para>
  <para style="q1" vid="AMO 5:4">تُم میری تلاش کرو اَور زندہ رہو؛<verse eid="AMO 5:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="AMO 5:5"/>بیت ایل کے طالب نہ بنو،</para>
  <para style="q1" vid="AMO 5:5">گِلگالؔ میں داخل مت ہو،</para>
  <para style="q2" vid="AMO 5:5">بیرشبعؔ کو نہ جاؤ،</para>
  <para style="q1" vid="AMO 5:5">کیونکہ گِلگالؔ ضروُر اسیری میں جائے گا،</para>
  <para style="q2" vid="AMO 5:5">اَور بیت ایل کا نام و نِشان مِٹ جائے گا۔<verse eid="AMO 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 5:6"/>یَاہوِہ کی تلاش کرو اَور زندہ رہو،</para>
  <para style="q2" vid="AMO 5:6">اَیسا نہ ہو کہ وہ آگ کی مانند بنی یُوسیفؔ پر بھڑکے؛</para>
  <para style="q1" vid="AMO 5:6">اَور اُسے نگل جائے،</para>
  <para style="q2" vid="AMO 5:6">اَور بیت ایل میں اُسے بُجھانے والا کوئی نہ ہو۔<verse eid="AMO 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 5:7"/>اَیسے لوگ ہیں جو اِنصاف کو تلخی میں بدل دیتے ہیں،</para>
  <para style="q2" vid="AMO 5:7">اَور راستبازی کو خاک میں مِلانے والوں،<verse eid="AMO 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8"/>جِس نے ثریّا اَور جبّار بنایا ہے،</para>
  <para style="q2" vid="AMO 5:8">جو اَندھیرے کو صُبح کی رَوشنی میں،</para>
  <para style="q2" vid="AMO 5:8">اَور دِن کو رات کے اَندھیرے میں تبدیل کرتے ہیں،</para>
  <para style="q1" vid="AMO 5:8">جو سمُندر کے پانی کو بُلاتے ہیں</para>
  <para style="q2" vid="AMO 5:8">اَور روئے زمین پر اُنڈیل دیتے ہیں۔</para>
  <para style="q2" vid="AMO 5:8">اُن کا نام یَاہوِہ ہے۔<verse eid="AMO 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 5:9"/>وہ پَلک جھپکتے ہی قلعہ کو نِیست و نابود کر دیتے ہیں،</para>
  <para style="q2" vid="AMO 5:9">اَور فصیلدار شہر کو تباہ کر دیتے ہیں۔<verse eid="AMO 5:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 5:10"/>اَیسے لوگ ہیں جو عدالت میں اِنصاف کو قائِم کرنے والوں سے عداوت رکھتے ہیں،</para>
  <para style="q2" vid="AMO 5:10">اَورجو سچ کہتاہے اُسے حقیر سمجھتے ہیں۔<verse eid="AMO 5:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 5:11"/>تُم غریبوں کے بھُوسے پر بھی محصُول لیتے ہو،</para>
  <para style="q2" vid="AMO 5:11">اَور اُن کے اناج پر بھی زبردستی محصُول لگاتے ہو۔</para>
  <para style="q1" vid="AMO 5:11">اِس لئے اگر تُم نے اَپنے لئے پتّھروں کے محلوں کو بھی تعمیر کیا ہو تو بھی،</para>
  <para style="q2" vid="AMO 5:11">تُم اُس میں رہنے نہ پاؤگے؛</para>
  <para style="q1" vid="AMO 5:11">اگرچہ تُم نے نفیس تاکستان بھی لگائے ہوں</para>
  <para style="q2" vid="AMO 5:11">تو بھی تُم اُن کی مَے نہ پی سکوگے۔<verse eid="AMO 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 5:12"/>کیونکہ مَیں تمہاری بے شُمار خطاؤں</para>
  <para style="q2" vid="AMO 5:12">اَور گُناہِ عظیم سے واقف ہُوں۔</para>
  <para style="b" vid="AMO 5:12"/>
  <para style="q1" vid="AMO 5:12">تُم نیکوکار کو ستاتے ہو اَور رشوت لیتے ہو</para>
  <para style="q2" vid="AMO 5:12">اَور اَپنی عدالت میں غریبوں کو اِنصاف سے محروم رکھتے ہو۔<verse eid="AMO 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 5:13"/>اِس لیٔے اَیسے وقت میں دانا چُپ رہتاہے</para>
  <para style="q2" vid="AMO 5:13">کیونکہ وقت بُرا ہے۔<verse eid="AMO 5:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 5:14"/>بدی کے نہیں بَلکہ نیکی کے طالب ہو</para>
  <para style="q2" vid="AMO 5:14">تاکہ تُم زندہ رہو۔</para>
  <para style="q1" vid="AMO 5:14">تَب یَاہوِہ قادرمُطلق خُدا تمہارے ساتھ رہیں گے،</para>
  <para style="q2" vid="AMO 5:14">جَیسا کہ تمہارا دعویٰ ہے کہ وہ تمہارے ساتھ ہیں۔<verse eid="AMO 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 5:15"/>بدی سے نفرت رکھو اَور نیکی سے مَحَبّت؛</para>
  <para style="q2" vid="AMO 5:15">عدالت میں اِنصاف قائِم کرو۔</para>
  <para style="q1" vid="AMO 5:15">شاید یَاہوِہ قادرمُطلق خُدا بنی یُوسیفؔ کے</para>
  <para style="q2" vid="AMO 5:15">بقیّہ پر رحم کرے۔<verse eid="AMO 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16"/>اِس لیٔے خُداوؔند یَاہوِہ قادرمُطلق خُدا فرماتے ہیں:</para>
  <para style="q1" vid="AMO 5:16">سَب گلیوں میں نوحہ ہوگا</para>
  <para style="q2" vid="AMO 5:16">اَور ہر چوراہے پر آہ و ماتم ہوگا۔</para>
  <para style="q1" vid="AMO 5:16">کِسانوں کو ماتم کرنے کے لیٔے</para>
  <para style="q2" vid="AMO 5:16">اَور نوحہ گِر، نوحہ کرنے کے لیٔے بُلائے جایٔیں گے۔<verse eid="AMO 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 5:17"/>سَب تاکستانوں میں ماتم ہوگا،</para>
  <para style="q2" vid="AMO 5:17">کیونکہ مَیں تمہارے درمیان ہوکر گزروں گا،</para>
  <para style="q2" vid="AMO 5:17">یَاہوِہ کا یہ فرمان ہے،<verse eid="AMO 5:17"/></para>
  <para style="s1">یَاہوِہ کا دِن</para>
  <para style="q1">
    <verse number="18" style="v" sid="AMO 5:18"/>تُم پر ہائے،</para>
  <para style="q2" vid="AMO 5:18">جو یَاہوِہ کے دِن کی آرزُو کرتے ہو،</para>
  <para style="q1" vid="AMO 5:18">تُم یَاہوِہ کے دِن کی آرزُو کیوں کرتے ہو؟</para>
  <para style="q2" vid="AMO 5:18">وہ تو تاریکی کا دِن ہوگا، رَوشنی کا نہیں۔<verse eid="AMO 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="AMO 5:19"/>وہ دِن اَیسا ہوگا گویا کویٔی آدمی شیرببر سے اَپنی جان بچا کے بھاگے</para>
  <para style="q2" vid="AMO 5:19">اَور راستہ میں اُسے ریچھ مِل جائے،</para>
  <para style="q1" vid="AMO 5:19">یا اَپنے گھر میں داخل ہو جائے</para>
  <para style="q2" vid="AMO 5:19">اَور آرام فرمانے کو اَپنا ہاتھ دیوار پر ٹیکے</para>
  <para style="q2" vid="AMO 5:19">اَور سانپ اُسے کاٹ لے۔<verse eid="AMO 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="AMO 5:20"/>کیا یَاہوِہ کا دِن سخت تاریکی کا نہ ہوگا، رَوشنی کا نہیں۔</para>
  <para style="q2" vid="AMO 5:20">گہری تاریکی جِس میں رَوشنی کی ایک کِرن بھی نہ ہوگی؟<verse eid="AMO 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="AMO 5:21"/>مَیں تمہاری عیدوں کو مکرُوہ سمجھتا ہُوں، مُجھے اُن سے نفرت ہے؛</para>
  <para style="q2" vid="AMO 5:21">اَور تمہارا اِجتماعات میرے لیے بدبودار ہیں۔<verse eid="AMO 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="AMO 5:22"/>اگرچہ تُم میرے لیٔے سوختنی نذریں اَور اناج کی نذریں گزرانتے ہو،</para>
  <para style="q2" vid="AMO 5:22">لیکن مَیں اُنہیں قبُول نہیں کروں گا۔</para>
  <para style="q1" vid="AMO 5:22">اگر تُم بہترین سلامتی کی نذر کی قُربانیاں گزرانو،</para>
  <para style="q2" vid="AMO 5:22">تو بھی مَیں اُن کا کویٔی لحاظ نہ کروں گا۔<verse eid="AMO 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="AMO 5:23"/>اَپنے نغموں کی آواز مُجھ سے دُور کرو!</para>
  <para style="q2" vid="AMO 5:23">مَیں تمہاری بربط کی آواز نہ سُنوں گا۔<verse eid="AMO 5:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="AMO 5:24"/>بَلکہ اِنصاف کو دریا کی مانند،</para>
  <para style="q2" vid="AMO 5:24">اَور صداقت کو کبھی نہ سوکھنے والے چشمے کی مانند جاری رکھو!<verse eid="AMO 5:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="AMO 5:25"/>”اَے بنی اِسرائیل کیا تُم چالیس بَرس تک بیابان میں</para>
  <para style="q2" vid="AMO 5:25">میرے لیٔے قُربانیاں کرتے اَور نذریں لاتے رہے؟<verse eid="AMO 5:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="AMO 5:26"/>تُم تو اَپنے بادشاہ کا مزار،</para>
  <para style="q2" vid="AMO 5:26">اَور اَپنے بُتوں کا سُتون</para>
  <para style="q2" vid="AMO 5:26">اَور اَپنے معبُودوں کے سِتارے کو لیٔے پھرتے تھے،</para>
  <para style="q2" vid="AMO 5:26">جنہیں تُم نے اَپنے لیٔے بنایا تھا۔<verse eid="AMO 5:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="AMO 5:27"/>لہٰذا مَیں تُمہیں دَمشق سے بھی آگے جَلاوطن کرکے بھیجوں گا،“</para>
  <para style="q2" vid="AMO 5:27">یَاہوِہ کا یہ فرمان ہے، جِن کا نام قادرمُطلق خُدا ہے۔<verse eid="AMO 5:27"/></para>
  <chapter eid="AMO 5"/>
  <chapter number="6" style="c" sid="AMO 6"/>
  <para style="s1">مطمئن لوگوں پر افسوس</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 6:1"/>افسوس تُم پر، جو صِیّونؔ میں عیش و آرام سے زندگی بسر کرتے ہو،</para>
  <para style="q2" vid="AMO 6:1">اَور ہائے تُم پرجو کوہِ سامریہؔ پر محفوظ محسُوس کرتے ہو،</para>
  <para style="q1" vid="AMO 6:1">اَور تُم سوچتے ہو کہ تُم اعلیٰ قوم کے مشہُور لوگ ہو،</para>
  <para style="q2" vid="AMO 6:1">جِن کے پاس بنی اِسرائیل آتے ہیں!<verse eid="AMO 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 6:2"/>تُم کَلنہؔ کو جاؤ اَور اُس پر نظر کرو؛</para>
  <para style="q2" vid="AMO 6:2">پھر وہاں سے بڑے حماتؔ شہر کو جاؤ،</para>
  <para style="q2" vid="AMO 6:2">اَور پھر نیچے فلسطینیوں کے گاتؔھ کو جاؤ۔</para>
  <para style="q1" vid="AMO 6:2">کیا وہ تمہاری دو مملکتوں سے بہتر ہیں؟</para>
  <para style="q2" vid="AMO 6:2">کیا اُن کا مُلک تمہارے مُلک سے بڑا ہے؟<verse eid="AMO 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 6:3"/>تُم میرے قہر کے دِن کو مُلتوی کرتے ہو</para>
  <para style="q2" vid="AMO 6:3">اَور دہشت کی سلطنت کو نزدیک لے آتے ہو۔<verse eid="AMO 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 6:4"/>تُم ہاتھی دانت سے مُزیّن پلنگ پر لیٹتے ہو</para>
  <para style="q2" vid="AMO 6:4">اَور اَپنے بِستر پر آرام طلبی سے پاؤں پھیلاتے ہو۔</para>
  <para style="q1" vid="AMO 6:4">اَور اَپنے پسندیدہ برّے</para>
  <para style="q2" vid="AMO 6:4">اَور فربہ بچھڑے کھاتے ہو۔<verse eid="AMO 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 6:5"/>تُم داویؔد کی مانند اَپنے بربط پر گاتے ہو</para>
  <para style="q2" vid="AMO 6:5">اَور موسیقی کے ساز ایجاد کرتے ہو۔<verse eid="AMO 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 6:6"/>تُم لبریز پیالوں سے مَے نوشی کرتے ہو</para>
  <para style="q2" vid="AMO 6:6">اَور بہترین عطر اِستعمال کرتے ہو،</para>
  <para style="q2" vid="AMO 6:6">لیکن تُم بنی یُوسیفؔ کی تباہی پر غم نہیں کرتے۔<verse eid="AMO 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 6:7"/>اِس لیٔے تُم لوگ سَب سے پہلے اسیری میں جاؤگے؛</para>
  <para style="q2" vid="AMO 6:7">تمہاری دعوت و عشرت کا خاتِمہ ہو جائے گا۔<verse eid="AMO 6:7"/></para>
  <para style="s1">یَاہوِہ کا اِسرائیل کے غُرور سے نفرت کرنا</para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8"/>یَاہوِہ قادر نے اَپنی ہی ذات کی قَسم کھائی ہے، اَور یَاہوِہ قادرمُطلق خُدا یہ اعلان کرتے ہیں،</para>
  <para style="q1" vid="AMO 6:8">مَیں یعقوب کے غُرور سے عداوت رکھتا ہُوں</para>
  <para style="q2" vid="AMO 6:8">اُس کے شاہی محلوں سے مُجھے نفرت ہے؛</para>
  <para style="q1" vid="AMO 6:8">مَیں اِس شہر اَور اِس کے باشِندوں کو</para>
  <para style="q2" vid="AMO 6:8">اَور اِس کی سبھی چیزوں کو اُس کے دُشمنوں کے حوالہ کر دُوں گا۔<verse eid="AMO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9"/>اگر کسی گھر میں دس آدمی بھی باقی ہوں گے تو بھی وہ مَر جایٔیں گے۔ <verse eid="AMO 6:9"/><verse number="10" style="v" sid="AMO 6:10"/>اَور جَب کوئی رشتہ دار اُن کی لاشوں کو جَلانے کے لیٔے گھر سے باہر لے جانے کو آئے اَور وہاں چھُپے ہُوئے کسی آدمی سے پُوچھے، ”کیا تمہارے ساتھ کویٔی اَور ہے؟“ اَور وہ جَواب دے، نہیں، تَب وہ کہے، ”چُپ رہ۔ ہمیں یَاہوِہ کا نام نہیں لیناہے۔“<verse eid="AMO 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 6:11"/>کیونکہ یَاہوِہ نے حُکم دیا ہے،</para>
  <para style="q2" vid="AMO 6:11">اَور وہ بڑے گھر کو ٹکڑے ٹکڑے کر دے گا</para>
  <para style="q2" vid="AMO 6:11">اَور چُھوٹے گھر کو چکنا چُور کر دے گا۔<verse eid="AMO 6:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 6:12"/>کیا چٹّانوں پر گھوڑے دَوڑتے ہیں؟</para>
  <para style="q2" vid="AMO 6:12">کیا وہاں بَیلوں سے ہل چلایا جاتا ہے؟</para>
  <para style="q1" vid="AMO 6:12">لیکن تُم نے اِنصاف کو زہر میں</para>
  <para style="q2" vid="AMO 6:12">اَور صداقت کو تلخی میں بدل دیا ہے۔<verse eid="AMO 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 6:13"/>تُم جو لُو دِبارؔ<note caller="+" style="f"><char style="fr" closed="false">6‏:13 </char><char style="fq" closed="false">لُو دِبارؔ </char><char style="ft" closed="false">یعنی بے فُضول</char></note> کی فتح پر خُوش ہو۔</para>
  <para style="q2" vid="AMO 6:13">اَور کہتے ہو کیا، ”ہم نے اَپنی طاقت سے قرنَیمؔ<note caller="+" style="f"><char style="fr" closed="false">6‏:13 </char><char style="fq" closed="false">قرنَیمؔ </char><char style="ft" closed="false">یعنی </char><char style="fqa" closed="false">سینگ </char><char style="ft" closed="false">یہاں طاقت کی علامت ہے۔</char></note> نہیں لیا؟“<verse eid="AMO 6:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 6:14"/>کیونکہ یَاہوِہ قادرمُطلق خُدا اعلان کرتے ہیں،</para>
  <para style="q2" vid="AMO 6:14">اَے بنی اِسرائیل، مَیں تمہارے خِلاف ایک قوم کو بھڑکاؤں گا،</para>
  <para style="q1" vid="AMO 6:14">جو تُمہیں لیبو حماتؔ سے لے کر</para>
  <para style="q2" vid="AMO 6:14">عراباہؔ کی وادی تک ستائے گی۔<verse eid="AMO 6:14"/></para>
  <chapter eid="AMO 6"/>
  <chapter number="7" style="c" sid="AMO 7"/>
  <para style="s1">ٹِڈّیاں، آگ اَور ایک ساہول</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1"/>یَاہوِہ قادر نے مُجھے یہ دِکھایا: شاہی حِصّے کی فصل کٹنے کے بعد، جَب دُوسری فصل آنے والی تھی، تَب یَاہوِہ ٹِڈّیوں کا ایک غول تیّار کر رہے تھے۔ <verse eid="AMO 7:1"/><verse number="2" style="v" sid="AMO 7:2"/>جَب ٹِڈّیاں زمین کی سَب گھاس کو بالکُل چٹ کر گئیں، تَب مَیں نے زور سے چِلّاکر فریاد کی، ”اَے یَاہوِہ قادر، مُعاف کریں، یعقوب کیسے زندہ رہ سَکتا ہے؟ وہ تو بہت ہی چھوٹاہے!“<verse eid="AMO 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3"/>پس یَاہوِہ نے رحم کیا اَور اَپنے کام کو روک دیا۔</para>
  <para style="p" vid="AMO 7:3">اَور فرمایا، ”اَب اَیسا نہیں ہوگا۔“<verse eid="AMO 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4"/>یَاہوِہ قادر نے مُجھے یہ دِکھایا: یَاہوِہ قادر نے اِنصاف کرنے کے لیٔے آگ کو بُلایا۔ اَور اُس آگ نے گہرے سمُندر کو سُکھا دیا اَور زمین کو نگل گئی۔ <verse eid="AMO 7:4"/><verse number="5" style="v" sid="AMO 7:5"/>تَب مَیں چِلّایا، ”اَے یَاہوِہ قادر، مَیں آپ سے مِنّت کرتا ہُوں، اِسے روک دیجئے! یعقوب کیسے زندہ رہ سَکتا ہے؟ وہ تو بہت ہی چھوٹاہے۔“<verse eid="AMO 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6"/>تَب یَاہوِہ نے اُس آفت کو ٹال دیا،</para>
  <para style="p" vid="AMO 7:6">اَور پھر یَاہوِہ قادر نے فرمایا، ”اَب اَیسا نہیں ہوگا۔“<verse eid="AMO 7:6"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7"/>پھر خُداوؔند نے مُجھے یہ دِکھایا: خُداوؔند اَپنے ایک ہاتھ میں ایک ساہول لئے ہُوئے ساہول کی ایک دیوار پر کھڑے ہیں۔ <verse eid="AMO 7:7"/><verse number="8" style="v" sid="AMO 7:8"/>اَور یَاہوِہ نے مُجھ سے پُوچھا، ”اَے عامُوسؔ، تُمہیں کیا دِکھائی دے رہاہے؟“</para>
  <para style="p" vid="AMO 7:8">مَیں نے جَواب دیا، ”ایک ساہول،“</para>
  <para style="p" vid="AMO 7:8">تَب خُداوؔند نے مُجھ سے فرمایا، ”دیکھو، مَیں اَپنی قوم بنی اِسرائیل میں ساہول لگاؤں گا اَور اَب مَیں اُن کو سزا دئیے بغیر نہ چھوڑوں گا۔<verse eid="AMO 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 7:9"/>”اِصحاقؔ کے اُونچے مقامات تباہ کئے جایٔیں گے</para>
  <para style="q2" vid="AMO 7:9">اَور بنی اِسرائیل کے مُقدّس مقام ویران ہو جایٔیں گے؛</para>
  <para style="q2" vid="AMO 7:9">اَور مَیں تلوار لے کر بنی یرُبعامؔ پر حملہ کروں گا۔“<verse eid="AMO 7:9"/></para>
  <para style="s1">عامُوسؔ اَور اماضیاہؔ</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10"/>تَب بیت ایل کے کاہِنؔ اماضیاہؔ نے شاہِ اِسرائیل یرُبعامؔ کو خبر بھیجی: ”عامُوسؔ نبی بنی اِسرائیل کے دِل میں آپ کے خِلاف فتنہ کھڑا کر رہاہے۔ مُلک اُس کی سَب باتوں کو برداشت نہیں کر سَکتا۔ <verse eid="AMO 7:10"/><verse number="11" style="v" sid="AMO 7:11"/>کیونکہ عامُوسؔ یُوں کہہ رہاہے،</para>
  <para style="q1" vid="AMO 7:11">” ’یرُبعامؔ تلوار سے ماراجائے گا،</para>
  <para style="q2" vid="AMO 7:11">اَور بنی اِسرائیل یقیناً! اَپنے وطن سے دُور ہوکر</para>
  <para style="q2" vid="AMO 7:11">اسیری میں چلا جائے گا۔‘ “<verse eid="AMO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12"/>تَب اماضیاہؔ نے عامُوسؔ سے کہا، ”اَے نبی یعنی غیب کی باتیں کہنے والے، یہاں سے دفع ہو جا، اَور مُلکِ یہُودیؔہ کو بھاگ جا، وہیں اَپنی روٹی کما اَور وہیں اَپنی نبُوّت کر۔ <verse eid="AMO 7:12"/><verse number="13" style="v" sid="AMO 7:13"/>اَب بیت ایل میں اَور نبُوّت نہ کرنا کیونکہ یہ بادشاہ کا پاک مَقدِس اَور سلطنت کی عبادت گاہ ہے۔“<verse eid="AMO 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14"/>عامُوسؔ نبی نے اماضیاہؔ کو جَواب دیا، ”مَیں نہ نبی تھا اَور نہ نبی کا بیٹا ہُوں، مَیں تو ایک چرواہا اَور گُولر کے درختوں کی دیکھ بھال کرنے والا تھا۔ <verse eid="AMO 7:14"/><verse number="15" style="v" sid="AMO 7:15"/>لیکن یَاہوِہ نے مُجھے ریوڑ کی دیکھ بھال کرنے کے کام سے بُلاکر مُجھ سے فرمایا، ’جاؤ، میری قوم بنی اِسرائیل سے نبُوّت کرو۔‘ <verse eid="AMO 7:15"/><verse number="16" style="v" sid="AMO 7:16"/>اِس لئے اَب تُم یَاہوِہ کا کلام سُن، تُم کہتے ہو،</para>
  <para style="q1" vid="AMO 7:16">” ’بنی اِسرائیل کے خِلاف نبُوّت نہ کر،</para>
  <para style="q2" vid="AMO 7:16">اَور بنی اِصحاقؔ کے خِلاف کلام کرنا بند کر۔‘<verse eid="AMO 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="AMO 7:17"/>”اِس لیٔے یَاہوِہ یُوں فرماتے ہیں،</para>
  <para style="q1" vid="AMO 7:17">” ’تمہاری بیوی شہر میں فاحِشہ بَن جائے گی،</para>
  <para style="q2" vid="AMO 7:17">اَور تمہارے بیٹے اَور بیٹیاں تلوار سے قتل کئے جایٔیں گے۔</para>
  <para style="q1" vid="AMO 7:17">تمہاری زمین ناپ کر تقسیم کی جائے گی،</para>
  <para style="q2" vid="AMO 7:17">اَور تُم خُود ایک بُت پرست مُلک میں مروگے۔</para>
  <para style="q1" vid="AMO 7:17">اَور یقیناً بنی اِسرائیل اَپنے وطن سے دُور،</para>
  <para style="q2" vid="AMO 7:17">جَلاوطنی میں چلا جائے گا۔‘ “<verse eid="AMO 7:17"/></para>
  <chapter eid="AMO 7"/>
  <chapter number="8" style="c" sid="AMO 8"/>
  <para style="s1">پکے ہُوئے پھلوں کا رُویا</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1"/>یَاہوِہ قادر نے مُجھے پکے ہُوئے پھلوں کی ایک ٹوکری دِکھائی۔ <verse eid="AMO 8:1"/><verse number="2" style="v" sid="AMO 8:2"/>اُنہُوں نے مُجھ سے پُوچھا، ”اَے عامُوسؔ، تُو کیا دیکھتا ہے؟“</para>
  <para style="p" vid="AMO 8:2">مَیں نے جَواب دیا، ”پکے ہُوئے پھلوں کی ایک ٹوکری۔“</para>
  <para style="p" vid="AMO 8:2">تَب یَاہوِہ نے مُجھ سے فرمایا، ”میری قوم بنی اِسرائیل کا وقت پُورا<note caller="+" style="f"><char style="fr" closed="false">8‏:2 </char><char style="fq" closed="false">وقت پُورا </char><char style="ft" closed="false">اصل عِبرانی میں وقت پک چُکاہے</char></note> ہو گیا ہے؛ اَب مَیں اُنہیں نہیں چھوڑوں گا۔“<verse eid="AMO 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 8:3"/>یَاہوِہ قادر فرماتے ہیں، ”اُس دِن، بیت المُقدّس کے نغمے ماتم میں تبدیل ہو جایٔیں گے۔ ہر طرف بہت سِی لاشیں پڑی ہوں گی اَور خاموشی چھائی ہوگی!“<verse eid="AMO 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 8:4"/>تُم جو ضروُرت مندوں کو کُچلتے رہتے ہو</para>
  <para style="q2" vid="AMO 8:4">اَور مُلک کے مسکینوں کو مٹاتے رہتے ہو، یہ کلام سُنو۔<verse eid="AMO 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 8:5"/>تُم کہتے ہو،</para>
  <para style="q1" vid="AMO 8:5">”نئے چاند کی عید کب گزرے گی</para>
  <para style="q2" vid="AMO 8:5">تاکہ ہم اَپنا اناج فروخت کریں،</para>
  <para style="q1" vid="AMO 8:5">سَبت کا دِن کب ختم ہوگا</para>
  <para style="q2" vid="AMO 8:5">تاکہ ہم گیہُوں کے فروخت کے واسطے اَپنے کھتّے کھولیں؟“</para>
  <para style="q1" vid="AMO 8:5">تُم ایفہ کو چھوٹا</para>
  <para style="q2" vid="AMO 8:5">اَور ثاقل کو ناپ میں بڑا کرتے ہو،</para>
  <para style="q2" vid="AMO 8:5">اَور دغابازی کے ترازو سے ٹھگتے ہو،<verse eid="AMO 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 8:6"/>تُم مسکینوں کو رُوپیہ سے</para>
  <para style="q2" vid="AMO 8:6">اَور حاجت مند کو ایک جوڑی جُوتے سے خریدتے ہو،</para>
  <para style="q2" vid="AMO 8:6">اَور گیہُوں کے ساتھ پھٹکن بھی بیچتے ہو۔<verse eid="AMO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7"/>یَاہوِہ یعقوب کی حشمت کی قَسم کھا کر فرماتے ہیں، ”جو کچھ اُنہُوں نے کیا ہے، مَیں اُن میں سے ایک کو بھی نہ بھُولوں گا۔<verse eid="AMO 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 8:8"/>”کیا اِس سبب سے زمین نہ تھرتھرائے گی،</para>
  <para style="q2" vid="AMO 8:8">اَور اُن کے ہر باشِندے ماتم نہ کریں گے؟</para>
  <para style="q1" vid="AMO 8:8">سارا مُلک دریائے نیل کی مانند ہوگا</para>
  <para style="q2" vid="AMO 8:8">جو اُفنے گی، پھر اُس میں لہریں اُٹھے گا،</para>
  <para style="q2" vid="AMO 8:8">اَور پھر وہ مُلک مِصر کے دریائے کی مانند بالکُل پُرسکون ہو جایٔےگا۔“<verse eid="AMO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 8:9"/>یَاہوِہ قادر اعلان کرتے ہیں،</para>
  <para style="q1" vid="AMO 8:9">”اُس دِن، مَیں آفتاب کو دوپہر کے وقت غروب کروں گا</para>
  <para style="q2" vid="AMO 8:9">اَور زمین پر دِن میں ہی تاریکی کر دُوں گا۔<verse eid="AMO 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 8:10"/>مَیں تمہاری عیدوں کو ماتم میں</para>
  <para style="q2" vid="AMO 8:10">اَور تمہارے نغموں کو نوحے میں تبدیل کر دُوں گا۔</para>
  <para style="q1" vid="AMO 8:10">اَور تُم سَب کو ٹاٹ پہناؤں گا</para>
  <para style="q2" vid="AMO 8:10">اَور تُم سَب کے سَر کو گنجا کر دُوں گا۔</para>
  <para style="q1" vid="AMO 8:10">اَور اَیسا ماتم برپا کروں گا جَیسے اِکلوتے بیٹے کی خاطِر ہوتاہے</para>
  <para style="q2" vid="AMO 8:10">اَور اُس کا اَنجام روزِ تلخ جَیسا ہوگا۔“<verse eid="AMO 8:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 8:11"/>یَاہوِہ قادر فرماتے ہیں، ”وہ دِن آ رہے ہیں،</para>
  <para style="q2" vid="AMO 8:11">جَب مَیں اُس مُلک میں قحط نازل کروں گا،</para>
  <para style="q1" vid="AMO 8:11">جو نہ روٹی کا نہ پانی کا،</para>
  <para style="q2" vid="AMO 8:11">بَلکہ خُدا کے کلام کا قحط ہوگا۔<verse eid="AMO 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 8:12"/>لوگ یَاہوِہ کے کلام کی تلاش میں،</para>
  <para style="q2" vid="AMO 8:12">سمُندر سے سمُندر تک</para>
  <para style="q1" vid="AMO 8:12">اَور شمال سے مشرق تک بھٹکتے پھریں گے؛</para>
  <para style="q2" vid="AMO 8:12">لیکن کہیں نہ پائیں گے۔<verse eid="AMO 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 8:13"/>”اُس دِن</para>
  <para style="q1" vid="AMO 8:13">”حسین عورتیں اَور جَوان مَرد</para>
  <para style="q2" vid="AMO 8:13">پیاس سے بے ہوش ہو جایٔیں گے۔<verse eid="AMO 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 8:14"/>جو لوگ سامریہؔ کے خطا کی قَسم کھا کر کہتے ہیں،</para>
  <para style="q2" vid="AMO 8:14">’دانؔ کے معبُود کے حیات کی قَسم،‘</para>
  <para style="q2" vid="AMO 8:14">یا ’بیرشبعؔ کے معبُود کے حیات کی قَسم،‘</para>
  <para style="q2" vid="AMO 8:14">وہ اَیسے گریں گے گویا پھر کبھی نہ اُٹھیں گے۔“<verse eid="AMO 8:14"/></para>
  <chapter eid="AMO 8"/>
  <chapter number="9" style="c" sid="AMO 9"/>
  <para style="s1">بنی اِسرائیل کا ہلاک کیاجانا</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1"/>مَیں نے خُداوؔند کو مذبح کے پاس کھڑے دیکھا، اَور اُنہُوں نے فرمایا،</para>
  <para style="q1" vid="AMO 9:1">سُتونوں کے سَر پر اَیسا مارو</para>
  <para style="q2" vid="AMO 9:1">کہ دہلیز ہِل جایٔیں۔</para>
  <para style="q1" vid="AMO 9:1">اَور اُن کو سَب لوگوں کے سَروں پر گرا دو؛</para>
  <para style="q2" vid="AMO 9:1">اَورجو باقی بچیں گے، اُنہیں مَیں تلوار سے قتل کروں گا۔</para>
  <para style="q1" vid="AMO 9:1">اُن میں سے ایک بھی بھاگ نہ سکےگا</para>
  <para style="q2" vid="AMO 9:1">اَورجو بچنے کی کوشش کرےگا وہ بھی بچ نہ پایٔےگا۔<verse eid="AMO 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 9:2"/>اگر وہ (پاتال) کی گہرائی میں بھی چلے جایٔیں،</para>
  <para style="q2" vid="AMO 9:2">تو میرا ہاتھ اُنہیں وہاں سے کھینچ نکالے گا۔</para>
  <para style="q1" vid="AMO 9:2">اگر وہ آسمان پر چڑھ جایٔیں،</para>
  <para style="q2" vid="AMO 9:2">تو مَیں وہاں سے بھی اُن کو اُتار لاؤں گا اَور پکڑ لُوں گا۔<verse eid="AMO 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 9:3"/>اگر وہ کوہِ کرمِلؔ کی چوٹی پر جا چھپیں،</para>
  <para style="q2" vid="AMO 9:3">تو بھی مَیں اُن کو وہاں سے ڈھونڈ کر پکڑ لُوں گا۔</para>
  <para style="q1" vid="AMO 9:3">اگرچہ وہ سمُندر کی تہہ میں چھُپ جائیں،</para>
  <para style="q2" vid="AMO 9:3">تو وہاں مَیں سانپ کو اُنہیں ڈسنے کا حُکم دُوں گا۔<verse eid="AMO 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 9:4"/>اگر اُن کے دُشمن اُن کو اسیر کرکے لے جایٔیں،</para>
  <para style="q2" vid="AMO 9:4">تو مَیں وہاں تلوار کو حُکم دُوں گا کہ اُنہیں قتل کرے۔</para>
  <para style="b" vid="AMO 9:4"/>
  <para style="q1" vid="AMO 9:4">مَیں اُن کی بھلائی کے لیٔے نہیں</para>
  <para style="q2" vid="AMO 9:4">بَلکہ اُن کی بُرائی کے لیٔے اُن پر نگاہ رکھوں گا۔<verse eid="AMO 9:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5"/>خُداوؔند، قادرمُطلق یَاہوِہ،</para>
  <para style="q1" vid="AMO 9:5">جو زمین کو چھُوتے ہیں تو وہ پگھل جاتی ہے،</para>
  <para style="q2" vid="AMO 9:5">اَور اُن کے سَب باشِندے ماتم کرتے ہیں؛</para>
  <para style="q1" vid="AMO 9:5">سارا مُلک دریائے نیل کی مانند اُفان مارتا ہے،</para>
  <para style="q2" vid="AMO 9:5">اَور پھر دریائے مِصر کی مانند پُرسکون ہو جاتا ہے۔<verse eid="AMO 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6"/>خُدا آسمان پر اَپنے بالاخانے تعمیر کرتے ہیں،</para>
  <para style="q2" vid="AMO 9:6">اَور اُنہُوں نے زمین پر اَپنے گُنبَد کی بُنیاد رکھی ہے،</para>
  <para style="q1" vid="AMO 9:6">جو سمُندر کے پانی کو بُلاتے ہیں</para>
  <para style="q2" vid="AMO 9:6">اَور رُوئے زمین پر بارش کرتے ہیں۔</para>
  <para style="q2" vid="AMO 9:6">اُن کا نام یَاہوِہ ہے۔<verse eid="AMO 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 9:7"/>اَے بنی اِسرائیل،</para>
  <para style="q2" vid="AMO 9:7">کیا تُم میرے لیٔے اہلِ کُوشؔ کی مانند نہیں ہو؟</para>
  <para style="q2" vid="AMO 9:7">یَاہوِہ اعلان کرتے ہیں،</para>
  <para style="q1" vid="AMO 9:7">کیا مَیں بنی اِسرائیل کو مُلک مِصر سے،</para>
  <para style="q2" vid="AMO 9:7">فلسطینیوں کو مُلک کفتُور سے،</para>
  <para style="q2" vid="AMO 9:7">اَور ارامیوں کو مُلک قیرؔ سے باہر نہیں نکال لایا ہُوں؟<verse eid="AMO 9:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 9:8"/>یقیناً یَاہوِہ قادر کی آنکھیں</para>
  <para style="q2" vid="AMO 9:8">اُن گُنہگار مُلکوں پر لگی ہُوئیں ہیں۔</para>
  <para style="q1" vid="AMO 9:8">یَاہوِہ فرماتے ہیں،</para>
  <para style="q2" vid="AMO 9:8">مَیں اُنہیں رُوئے زمین سے</para>
  <para style="q1" vid="AMO 9:8">نِیست و نابود کر دُوں گا۔</para>
  <para style="q2" vid="AMO 9:8">مگر بنی یعقوب کو پُوری طرح</para>
  <para style="q2" vid="AMO 9:8">نِیست و نابود نہیں کروں گا۔<verse eid="AMO 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 9:9"/>کیونکہ مَیں حُکم دُوں گا،</para>
  <para style="q2" vid="AMO 9:9">اَور مَیں سَب قوموں کے درمیان</para>
  <para style="q2" vid="AMO 9:9">بنی اِسرائیل کو اَیسا جھاڑوں گا</para>
  <para style="q1" vid="AMO 9:9">گویا کسی چھلنی میں اناج کو چھانا جاتا ہے،</para>
  <para style="q2" vid="AMO 9:9">اَور ایک دانہ بھی زمین پر نہیں گرتا ہے۔<verse eid="AMO 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 9:10"/>میرے لوگوں کے درمیان سے تمام گُنہگار</para>
  <para style="q2" vid="AMO 9:10">جو یہ کہتے ہیں،</para>
  <para style="q1" vid="AMO 9:10">نہ تو ہمارے اُوپر کوئی آفت آئے گی اَور نہ ہی آفت سے ہمارا سامنا ہوگا،</para>
  <para style="q2" vid="AMO 9:10">وہ سَب کے سَب تلوار سے ہلاک کئے جایٔیں گے۔<verse eid="AMO 9:10"/></para>
  <para style="s1">بنی اِسرائیل کی بحالی</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11"/>اُس دِن</para>
  <para style="q1" vid="AMO 9:11">مَیں داویؔد کے گِرے ہُوئے خیمہ کو کھڑا کروں گا۔</para>
  <para style="q2" vid="AMO 9:11">اَور اُس کی تمام ٹُوٹی دیواروں کی مرمّت کروں گا،</para>
  <para style="q2" vid="AMO 9:11">اَور اُس کے کھنڈروں کو</para>
  <para style="q2" vid="AMO 9:11">پھر سے پہلے جَیسا تعمیر کروں گا۔<verse eid="AMO 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 9:12"/>تاکہ وہ اِدُوم کے بچے ہُوئے لوگوں کو،</para>
  <para style="q2" vid="AMO 9:12">اَور اُن سَب غَیریہُودی قوموں کو اَپنے قبضے میں کر لے جو میری ہیں،</para>
  <para style="q2" vid="AMO 9:12">یہ اُن ہی یَاہوِہ کا اعلان ہے جو یہ سَب کام کرنے والے ہیں۔<verse eid="AMO 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 9:13"/>یَاہوِہ فرماتے ہیں، اَیسے دِن آ رہے ہیں،</para>
  <para style="q1" vid="AMO 9:13">جَب ہل جوتنے والا فصل کاٹنے والے سے</para>
  <para style="q2" vid="AMO 9:13">اَور انگور روندنے والا، پَودا لگانے والے سے آگے نکل جائے گا۔</para>
  <para style="q1" vid="AMO 9:13">اَور پہاڑوں سے نئی مَے ٹپکے گی</para>
  <para style="q2" vid="AMO 9:13">اَور ساری پہاڑیوں سے بہہ جائے گا۔<verse eid="AMO 9:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="AMO 9:14"/>اَور مَیں اَپنی قوم بنی اِسرائیل کو اسیری سے واپس لَوٹا لاؤں گا۔</para>
  <para style="b" vid="AMO 9:14"/>
  <para style="q1" vid="AMO 9:14">وہ اُجڑے شہروں کو تعمیر کرکے اُن میں سکونت کریں گے۔</para>
  <para style="q2" vid="AMO 9:14">وہ تاکستان لگائیں گے اَور اُن کی مَے پیئیں گے؛</para>
  <para style="q2" vid="AMO 9:14">وہ باغ لگائیں گے اَور اُن کے پھل کھایٔیں گے۔<verse eid="AMO 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15"/>مَیں بنی اِسرائیل کو اُنہیں کے مُلک میں قائِم کروں گا،</para>
  <para style="q2" vid="AMO 9:15">اَور وہ پھر کبھی اَپنے وطن سے جو مَیں نے اُنہیں بخشا ہے</para>
  <para style="q2" vid="AMO 9:15">نکالے نہ جایٔیں گے،</para>
  <para style="m" vid="AMO 9:15">یہی یَاہوِہ تمہارے خُدا کا فرمان ہے۔<verse eid="AMO 9:15"/></para>
  <chapter eid="AMO 9"/>
</usx>
