<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Biblica® Open Urdu Contemporary Version</book>
  <para style="h">فِلیمون</para>
  <para style="toc1">فِلیمون کے نام پَولُسؔ کا خط</para>
  <para style="toc2">فِلیمون</para>
  <para style="toc3">فِلی</para>
  <para style="mt1">فِلیمون</para>
  <para style="mt2">کے نام پَولُسؔ کا خط</para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="po">
    <verse number="1" style="v" sid="PHM 1:1"/>خُداوؔند المسیح یِسوعؔ کی خاطِر قَیدی پَولُسؔ اَور ہمارے بھایٔی تِیمُتھِیُس کی جانِب سے،<note caller="+" style="f"><char style="fr" closed="false">1‏:1 </char><char style="ft" closed="false">حضرت پَولُسؔ نے ہی اِس خط کو لِکھّا تھا۔ اَور سِلوانُسؔ اَور تِیمُتھِیُس صِرف آداب و تسلیمات میں حضرت پَولُسؔ کے ساتھ شامل ہُوئے تھے۔‏</char></note></para>
  <para style="po" vid="PHM 1:1">ہمارے عزیز ہم خدمت فِلیمون، <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/>اَور بہن اَفّیہؔ، اَور بھایٔی اَرخِپُّسؔ جو ہم فَوجی ہے اَور اُس جماعت کے نام خط جو فِلیمون کے گھر میں جمع ہوتی ہے۔<verse eid="PHM 1:2"/></para>
  <para style="po">
    <verse number="3" style="v" sid="PHM 1:3"/>ہمارے خُدا باپ اَور خُداوؔند یِسوعؔ المسیح کی طرف سے تُمہیں فضل اَور اِطمینان حاصل ہوتا رہے۔<verse eid="PHM 1:3"/></para>
  <para style="s1">دعا اَور شُکر گُزاری</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4"/>اَپنی دعاؤں مَیں تُجھے یاد کرتے ہویٔے میں ہمیشہ اَپنے خُدا کا شُکر اَدا کرتا ہُوں، <verse eid="PHM 1:4"/><verse number="5" style="v" sid="PHM 1:5"/>کیونکہ مَیں سُنتا ہُوں کہ تُم خُدا کے سَب مُقدّسین سے مَحَبّت رکھتے ہو اَور تمہارا ایمان خُداوؔند یِسوعؔ پر ہے۔ <verse eid="PHM 1:5"/><verse number="6" style="v" sid="PHM 1:6"/>میری دعا ہے کہ کاش ایمان میں ہمارے ساتھ تمہاری شراکت المسیح کی خاطِر ہماری طرف سے تقسیم کی جانے والی ہر اَچھّی چیز کے بارے میں تمہاری سمجھ کو گہرا اَور مؤثر کرے۔ <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>اَے بھایٔی! مُجھے تیری مَحَبّت سے بہت خُوشی اَور تسلّی ہُوئی ہے کیونکہ تُونے مُقدّسین کے دِلوں کو تازہ کیا ہے۔<verse eid="PHM 1:7"/></para>
  <para style="s1">اُنیسمُسؔ کے لیٔے پَولُسؔ کی اِلتجا</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>پس اگرچہ المسیح میں مُجھے تُمہیں یہ حُکم دینے کا اِختیار ہے کہ تُجھے کیا کرنا چاہئے، <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>لیکن پھر بھی میں بُوڑھا پَولُسؔ جو اِس وقت خُداوؔند المسیح یِسوعؔ کی خاطِر قَیدی ہُوں اَور مَحَبّت کے ساتھ تُم سے درخواست کرنا مُناسب سمجھتا ہُوں۔ <verse eid="PHM 1:9"/><verse number="10" style="v" sid="PHM 1:10"/>لہٰذا میں اَپنے بیٹے اُنیسمُسؔ<note caller="+" style="f"><char style="fr" closed="false">1‏:10 </char><char style="fq" closed="false">اُنیسمُسؔ </char><char style="ft" closed="false">معنی </char><char style="fqa" closed="false">مفید ہے۔‏</char></note> کے لیٔے تُم سے عرض کرتا ہُوں جو میرے قَید کے دَوران المسیح پر ایمان لانے سے گویا میرا رُوحانی بیٹا بَن گیا ہے۔ <verse eid="PHM 1:10"/><verse number="11" style="v" sid="PHM 1:11"/>پہلے تو وہ تمہارے کسی کام کا نہ تھا لیکن اَب وہ تیرے اَور میرے دونوں کے لیٔے بڑے کام کا ہے۔<verse eid="PHM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12"/>اَب مَیں اُسے یعنی اَپنے لختِ جِگر کو تیرے پاس واپس بھیج رہا ہُوں۔ <verse eid="PHM 1:12"/><verse number="13" style="v" sid="PHM 1:13"/>حالانکہ اُسے میں اَپنے ہی پاس رکھنا چاہتا تھا تاکہ وہ تمہاری جگہ پر اِس قَید میں جو خُوشخبری سُنانے کی خاطِر ہے، میری خدمت کرے۔ <verse eid="PHM 1:13"/><verse number="14" style="v" sid="PHM 1:14"/>لیکن تیری رضامندی کے بغیر میں کچھ نہیں کرنا چاہتا تھا، تاکہ جو بھی مہربانی تُو کرے وہ مجَبُوری میں نہیں لیکن اَپنی مرضی سے کرے۔ <verse eid="PHM 1:14"/><verse number="15" style="v" sid="PHM 1:15"/>شاید اُنیسمُسؔ تُجھ سے تھوڑی دیر کے واسطے اِس لیٔے جُدا ہُوا تھا تاکہ وہ ہمیشہ تمہارے ساتھ رہے۔ <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>مگر اَب سے غُلام کی طرح نہیں بَلکہ غُلام سے بہتر یعنی ایک عزیز بھایٔی کی طرح سلُوک کرنا، جو ایک ساتھی مُومِن کے طور پر مُجھے نہایت عزیز ہو اَور مُجھ سے بھی زِیادہ خُداوؔند میں اَور ایک بھایٔی کے طور پر تُجھے عزیز ہو۔<verse eid="PHM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17"/>پس اگر تُم مُجھے اَپنا ساتھی سمجھتا ہو تو اُنیسمُسؔ کو بھی وَیسے ہی قبُول کرنا جَیسے تُم مُجھے کرتے ہو۔ <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>اَور اگر اُس نے تیرا کچھ نُقصان کیا ہے یا اُس پر تیرا کچھ قرض ہے تو اُسے میرے نام لِکھ لینا۔ <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>میں پَولُسؔ اَپنے ہاتھ سے یہ لِکھتا ہُوں کہ تُجھے اَدا کر دُوں گا۔ یہ لکھنے کی کویٔی ضروُرت نہیں کہ میرا قرض جو تُجھ پر ہے وہ تُم خُود ہی ہو۔ <verse eid="PHM 1:19"/><verse number="20" style="v" sid="PHM 1:20"/>اَے بھایٔی! میں چاہتا ہوں کہ مُجھے تیری طرف سے خُداوؔند میں مدد حاصل ہو، اَور المسیح میں میرے دِل کو تازگی ملے۔ <verse eid="PHM 1:20"/><verse number="21" style="v" sid="PHM 1:21"/>تیری فرمانبرداری پر یقین کرکے تُجھے لِکھ رہا ہُوں۔ کیونکہ مَیں جانتا ہُوں کہ جو کچھ میں کہتا ہوں، تُم اُس سے بھی زِیادہ کروگے۔<verse eid="PHM 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PHM 1:22"/>اِس کے علاوہ میرے قِیام کے لیٔے مہمان خانہ تیّار رکھنا کیونکہ مُجھے اُمّید ہے کہ تُم لوگوں کی دعاؤں کے جَواب میں خُدا مُجھے قَید سے آزاد کر تمہارے درمیان پہُنچا دے گا۔<verse eid="PHM 1:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>اِپفِراسؔ جو المسیح یِسوعؔ میں میرا ساتھی قَیدی تُمہیں سلام کہتاہے۔<verse eid="PHM 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PHM 1:24"/>اَور مرقُسؔ، ارِسترخُسؔ، دیماسؔ اَور لُوقا جو میرے ہم خدمت ہیں، تُمہیں سلام کہتے ہیں۔<verse eid="PHM 1:24"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25"/>خُداوؔند یِسوعؔ المسیح کا فضل تمہاری سَب کی رُوح کے ساتھ ہوتا رہے۔ آمین۔<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
