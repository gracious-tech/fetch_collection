<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LUK" style="id">- Geji Gospel of Luke</book>
  <para style="h">Lukka</para>
  <para style="toc3">Luk</para>
  <para style="toc2">Lukka</para>
  <para style="toc1">Lukka</para>
  <para style="mt2">Ga̱ɓa ma̱n ta̱mti tumal</para>
  <para style="mt1">Lukka</para>
  <chapter number="1" style="c" sid="LUK 1" />
  <para style="s">Ndat zhila ga̱ɓa</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1" />Mbala̱n wonti lish ga̱ɓa ten ilgwe pi ka̱ tlo ga̱na̱n wu. <verse eid="LUK 1:1" /><verse number="2" style="v" sid="LUK 1:2" />Sa̱ lish ilgwe ma̱ kumi mal ma̱jwe yeni na̱ gwel gwasa̱n tet ten ndat zhile wu, a zhel ma̱n dla̱mti ga̱ɓa ga̱ Nya ka̱ɗe si. <verse eid="LUK 1:2" /><verse number="3" style="v" sid="LUK 1:3" />Yek laki, ami mago a bodla̱l ga̱ɓe i'e wugo, yek a yeni go mbun ɗe ta lishik kangwe ni wu, ma̱n nalti Tiyopolos, <verse eid="LUK 1:3" /><verse number="4" style="v" sid="LUK 1:4" />ta̱k yisi ɗe ilgwe ka̱ kumi go gem ka̱n.<verse eid="LUK 1:4" /></para>
  <para style="s">Yen shinti ga̱ Nya dla̱m za̱t ga̱ Yohana ma̱n baptisma</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5" />Ka̱ gin gwe ɗe Hiridus ni ɗe guu ka̱ atl ga̱ Yehudiya wu, ma̱n Pa̱ris gon, asa̱ mbet ɗe Zakariya, gwe ni ka̱ mbala̱n ga̱ Abija bal ma̱n da̱nti ka̱ bii ngemti Nya ga̱ cina. Shin ga̱ kili ga̱ Zakariya ka̱ɗe Alisabatu, ti mago ma̱n ga̱s ga̱ Haruna bal ma̱n da̱nti ka̱ bii ngemti Nya ga̱ cina wu. <verse eid="LUK 1:5" /><verse number="6" style="v" sid="LUK 1:6" />Mas jwasa̱n sa̱ pa̱l hwa da̱nti gwe Nya lami wu, sa̱ kop mba̱t ga̱ Nya na̱k kangwe ta̱ lami ta̱ mbala̱n koɓi wu. <verse eid="LUK 1:6" /><verse number="7" style="v" sid="LUK 1:7" />A ba̱ mil nisi ɗa̱ so. Na̱k ɗe Alisabatu wo ba̱ ma̱n za̱t yen ka̱ɗe ti sowu, a mas jwasa̱n go sa̱ koli wi.<verse eid="LUK 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8" />Gas gon Zakariya na̱ma pa̱lti wul ka̱ lubii ga̱ Nya ɗe cin pa̱lti wul gwasa̱n ka̱ bii ngemti Nyami balla̱t tet wu. <verse eid="LUK 1:8" /><verse number="9" style="v" sid="LUK 1:9" />Na̱k kangwe a ma̱n Pa̱rismi kul pa̱li wu. Yek sa̱ botl Zakariya ta̱s te ka̱ lubii ga̱ Nyami ta̱s kwel turare ma̱n ta̱mti wusa̱n. Yek ta̱ te giɓi. <verse eid="LUK 1:9" /><verse number="10" style="v" sid="LUK 1:10" />A mbala̱n wonti ni deɓa̱l asa̱ na̱ma ngemti Nya ɗe Zakariya na̱ma kwelti turare wu.<verse eid="LUK 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11" />Ta̱ ni nugo, yek yen shinti ga̱ Nya ka̱wu ten ka̱t ang shinti a malka̱n lu kwelti turare. <verse eid="LUK 1:11" /><verse number="12" style="v" sid="LUK 1:12" />Yek ɓanti ci Zakariya, ɗe ta̱ yen yen shinti ga̱ Nyami wu. <verse eid="LUK 1:12" /><verse number="13" style="v" sid="LUK 1:13" />Yek yen shinti ga̱ Nyami wulti ɗe, &lt;&lt;Ba̱ ɓanti cik so Zakariya, Nya kum ngemti gwe ka̱ ngemti wu yi. Kili gwa Alisabatu a zik yen aka̱ zit shin ɗe Yohana.&gt;&gt;<verse eid="LUK 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 1:14" />&lt;&lt;Sa za̱t wugo, ka pa̱l hwol tuki,</para>
  <para style="q2" vid="LUK 1:14">a mbala̱n wonti a pa̱l hwol tuk na̱ za̱t gwas pak.<verse eid="LUK 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LUK 1:15" />Yeni a da̱n ɗe bal mbala̱n mal Nya.</para>
  <para style="q2" vid="LUK 1:15">Ta tla ɗuk so a ba̱ta tla mas ilgwe a gillit gaa ka̱wu so.</para>
  <para style="q2" vid="LUK 1:15">Sa njika̱n mbadl gwas na̱ Shishi ga̱ Nya ata̱ yi ka̱ tuk ga̱ ana gwasi.<verse eid="LUK 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="LUK 1:16" />Tik ka palli ma̱n Yisiraila wonti mal Bagaa Nya gwasa̱n.<verse eid="LUK 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LUK 1:17" />Ta tuli Bagaa Yesu cina, ata̱ pa̱l wul na̱ nda̱lti na̱k gwe Iliya ma̱n dla̱mti ga̱ɓa ga̱ Nya pa̱li wu.</para>
  <para style="q2" vid="LUK 1:17">Ta tulli ta̱mti da̱nti ka̱ tlo ga̱ mil suk ma̱n za̱t jwasa̱n.</para>
  <para style="q2" vid="LUK 1:17">Ta palli mbala̱n ma̱n la̱shi kumti bi asa̱ da̱n ɗe ma̱n kumti bi suk ma̱n pa̱lti zok wul.</para>
  <para style="q1" vid="LUK 1:17">Na̱ nu ka̱n ta la̱ka̱mi Yesu mbala̱n jwasi.&gt;&gt;<verse eid="LUK 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18" />Yek Zakariya wul yen shinti ga̱ Nyami ɗe, &lt;&lt;Ɗa̱ nii ka̱n ba yisi ɗe ilgwe ka̱ dla̱m go a pi nu gwi? Na̱k ɗe ami wo kol mbala̱n ka̱ ɓali a kili gi mago ta koli wu?&gt;&gt; <verse eid="LUK 1:18" /><verse number="19" style="v" sid="LUK 1:19" />Yek yen shinti ga̱ Nyami wulti ɗe, &lt;&lt;Amik ɗe Jibirailu gwe na̱ma da̱nti mal Nya wu. Nya shina̱n ɗe ta hwik ga̱ɓa ma̱n ta̱mti gee. <verse eid="LUK 1:19" /><verse number="20" style="v" sid="LUK 1:20" />Yek yekgu ka̱ nge ga̱ɓa gini, ama a da̱n ɗe gem kume multi njika̱n wu. Yek laki ɗe ningo ka po man ga̱ɓa so, se gas gwe sa̱ zi yeni wu.&gt;&gt;<verse eid="LUK 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21" />Mbala̱n na̱ma ɓa̱tti yilti ga̱ Zakariya, yek sa̱ njel daamti gwasa̱n ɗe yek laki ɗe ba̱ta̱ yil tet ba̱le so ye. <verse eid="LUK 1:21" /><verse number="22" style="v" sid="LUK 1:22" />Ta̱ yil tet wugo yek ba̱ta̱ man ga̱ɓa so, yek sa̱ yisi ɗe Nya ɓulit gwel yek ta̱ yen ilgon ka̱ lubii ga̱ Nyami. Yek ta̱ ngusi ga̱ɓa na̱ ang ama ba̱ta̱ man ga̱ɓa na̱ bi gwas so.<verse eid="LUK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23" />Multi ga̱ pa̱lti wul gwasa̱n ka̱ bii ngemti Nyami paki wugo, yek ta̱ li ga̱zi. <verse eid="LUK 1:23" /><verse number="24" style="v" sid="LUK 1:24" />La̱m multi wugo, yek kili gwas Alisabatu mbi yen, yek ta̱ hwuda̱l gaa gwas ka a gibboo ga̱ lip ɗe namtan. <verse eid="LUK 1:24" /><verse number="25" style="v" sid="LUK 1:25" />Yek ta̱ wule, &lt;&lt;Nya yen gonti ga̱na̱n yek ta̱ ba̱lni yen wi. Ta̱ kami nsha gwe a cin ka̱ mbala̱n wu ka̱wi.&gt;&gt;<verse eid="LUK 1:25" /></para>
  <para style="s">Yen shinti ga̱ Nya dla̱m za̱t ga̱ Yesu</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26" />Alisabatu njika̱n lip ɗe mukka na̱ yen tuk wugo, yek Nya shin yen shinti gwasi asa̱ mbet ɗe Jibirailu ka̱ ba̱n gon asa̱ mbe ɗe Nazarat ka̱ atl ga̱ Galili. <verse eid="LUK 1:26" /><verse number="27" style="v" sid="LUK 1:27" />Ta̱ shinti mal yen kili gon gwe ba̱ta̱ ɓo yis maani sowu asa̱ mbet ɗe Maryam, ti ka̱n ma̱lgon asa̱ mbet ɗe Yusupu na̱ma kopti gwas ɗe yen kili gwas wu. Yusupu wo ma̱n ga̱s ga̱ gus guu ga̱ ma̱n Yisiraila gwe asa̱ mbet ɗe Dauda wu ka̱n. <verse eid="LUK 1:27" /><verse number="28" style="v" sid="LUK 1:28" />Yek yen shinti ga̱ Nyami tul mal Maryam, yek ta̱ wulti ɗe, &lt;&lt;A na̱ma ga̱ɓet gwa na̱ hwol tuki ki ɗe ka̱ mbi hwa wul sut mal Nya wu. Guu ga̱ Nya ni sukki.&gt;&gt;<verse eid="LUK 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29" />Maryam kum ga̱ɓetisi wugo, yek ɓanti citi, yek ta̱ daamti ɗe, &lt;&lt;Yek yen shinti ga̱ Nyami a hwit ye?&gt;&gt; <verse eid="LUK 1:29" /><verse number="30" style="v" sid="LUK 1:30" />Yek yen shinti ga̱ Nyami wulti ɗe, &lt;&lt;Ba̱ ɓanti cik so Maryam, ka̱ mbi hwa wul sut mal Nya. <verse eid="LUK 1:30" /><verse number="31" style="v" sid="LUK 1:31" />Ka mbi yen tuki, aka̱ zi yen maani, aka̱ zit shin ɗe Yesu. <verse eid="LUK 1:31" /><verse number="32" style="v" sid="LUK 1:32" />Ta da̱n ɗe kaksha mbala̱n, asa̱ mbet ɗe yen ga̱ Guu ga̱ Nya ma̱n nalti. Nya Bal Kakshe a ba̱lti nalti ga̱ ma̱n za̱t ga̱ koli gwasi Dauda. <verse eid="LUK 1:32" /><verse number="33" style="v" sid="LUK 1:33" />Tik ka da̱n ɗe guu gwe ba̱ pakti niɗɗa̱ sowu ga̱ ma̱n Yisiraila, ta da̱n ɗe guu ga̱ Israila gwe ba̱ a paki sowu.&gt;&gt;<verse eid="LUK 1:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34" />Yek Maryam ngem yen shinti ga̱ Nyami ɗe, &lt;&lt;Ɗa̱ nii ka̱n a pi nu gwi, ɗe ba ɓo yis maani sowu?&gt;&gt;<verse eid="LUK 1:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35" />Yek yen shinti ga̱ Nyami wulti ɗe, &lt;&lt;Shishi ga̱ Nya a su sut tenki. Nda̱lti ga̱ Guu ga̱ Nya a yitlak ka, na̱k ɗe nu ka̱n ni wu, yen gwe ka za̱t go sa mbet ɗe Yen ga̱ Nya. <verse eid="LUK 1:35" /><verse number="36" style="v" sid="LUK 1:36" />Yilka gwa Alisabatu mago yen nit tuki ka̱ kolit gwasi, a mbala̱n kul wule, ti wo ma̱n za̱t yen ka̱ so, yekgu ta̱ ɓal ka̱ lip ɗe mukka gwasi. <verse eid="LUK 1:36" /><verse number="37" style="v" sid="LUK 1:37" />Ilgon kan Nya gaa so.&gt;&gt;<verse eid="LUK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38" />Yek Maryam wul yen shinti ga̱ Nyami ɗe, &lt;&lt;Ami wo zhel ga̱ Nya ka̱n, ha̱n ta̱ da̱n na̱k gwe ka̱ dla̱m wu.&gt;&gt; Yek yen shinti ga̱ Nyami zigaa.<verse eid="LUK 1:38" /></para>
  <para style="s">Maryam la ga̱ɓet ga̱ Alisabatu</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39" />Kaal ɗa̱ la̱mti multi, yek Maryam li ka̱ ba̱n gon ɗe ni ten za̱nda̱l wu ka̱ atl ga̱ Yehudiya ba̱le-ba̱le, <verse eid="LUK 1:39" /><verse number="40" style="v" sid="LUK 1:40" />Yek ta̱ te ka̱ lubii ga̱ Zakariya, yek ta̱ ga̱ɓe Alisabatu. <verse eid="LUK 1:40" /><verse number="41" style="v" sid="LUK 1:41" />Na̱ kumti yal ga̱ɓet ga̱ Maryam, yek yen gwe ni Alisabatu tuk wu nwuti, yek mbadl ga̱ Alisabatu njika̱n na̱ Shishi ga̱ Nya. <verse eid="LUK 1:41" /><verse number="42" style="v" sid="LUK 1:42" />Yek ta̱ wul Maryam na̱ nda̱lti ɗe, &lt;&lt;Ki wo ma̱n mbit hwa wul ga̱ Nya ka̱n man mas modli, a yen gwe ka za̱t wu mago ma̱n mbit hwa wul ka̱ pak! <verse eid="LUK 1:42" /><verse number="43" style="v" sid="LUK 1:43" />Hwa wul yek a mbi na̱n ye, ɗe ana ga̱ Bagaa gi li tet mala̱n wu? <verse eid="LUK 1:43" /><verse number="44" style="v" sid="LUK 1:44" />Na̱ kumti yal ga̱ɓet gwa Maryam, yek yen ga̱ nii tuk wu nwuti na̱ hwol tuki. <verse eid="LUK 1:44" /><verse number="45" style="v" sid="LUK 1:45" />Ki wo ma̱n mbit hwa wul ga̱ Nya ka̱n na̱k ɗe ka̱ zi mbadl ɗe ga̱ɓa gwe Nya shinik lu sut na̱ nali wu pi wu.&gt;&gt;<verse eid="LUK 1:45" /></para>
  <para style="s">Koo ta̱sti Nya ga̱ Maryam</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46" />Yek Maryam ballit ɗe,</para>
  <para style="q1" vid="LUK 1:46">&lt;&lt;Bagaa Nya ka̱n mbadl gi na̱ma ta̱sti gwasi,<verse eid="LUK 1:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="LUK 1:47" />Na̱k ɗe tik ɗe ma̱n kisti gi wu.<verse eid="LUK 1:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48" />Na̱k ɗe ta̱ yisi lu wu, ko ɗe ami wo zhel gwas ka̱n gwe ba̱ ani ten bi ilgon sowu.</para>
  <para style="q2" vid="LUK 1:48">Ningo gin ten gin sa mbe ɗe ma̱n mbit hwa wul ga̱ Nya.<verse eid="LUK 1:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="LUK 1:49" />Na̱k ɗe Nya Bal Kakshe wo ma̱n nalti ka̱wu ta̱ pa̱li kiɗi wul,</para>
  <para style="q2" vid="LUK 1:49">shin gwas ka̱ɗe ma̱n cilti.<verse eid="LUK 1:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50" />A ta̱ yen gonti ga̱ ma̱jwe ɓantit wu gin ten gin.<verse eid="LUK 1:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51" />Na̱ ang gwas ma̱n nda̱lti ka̱n ta̱ pa̱l kiɗi wul,</para>
  <para style="q2" vid="LUK 1:51">yek ta̱ cat ma̱n nali gaa ka suk mas wul jwe nisi ka̱ mbadl wu.<verse eid="LUK 1:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52" />Yek ta̱ yilli kiɗi guu ɗa̱ka̱ gobdlan gwasa̱n ka,</para>
  <para style="q2" vid="LUK 1:52">yek ta̱ ba̱l nalti ma̱jwe sa̱ mbulsi wu.<verse eid="LUK 1:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53" />Yek ta̱ ba̱l hwa wul ma̱jwe ni ka̱ kuza̱n wu,</para>
  <para style="q2" vid="LUK 1:53">yek ta̱ mbol ma̱n wul koo ami.<verse eid="LUK 1:53" /></para>
  <para style="q1">
    <verse number="54-55" style="v" sid="LUK 1:54-55" />A ta̱ zi ang ten zhel jwasi ma̱n Yisiraila</para>
  <para style="q2" vid="LUK 1:54-55">na̱k ɗe a ba̱ta ma̱sa̱n ga̱ɓa gwe ta̱ dla̱lli ka̱ dlo gwas suksi gwe ɗe ba̱ a paki sowu so.</para>
  <para style="q2" vid="LUK 1:54-55">A ta̱ kul yen gonti ga̱ koli ga̱na̱n Ibirahim suk ma̱jwasi gin ten gin,</para>
  <para style="q2" vid="LUK 1:54-55">na̱k gwe ta̱ dla̱mi ma̱ jina̱n ji cina wu.&gt;&gt;<verse eid="LUK 1:54-55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56" />Yek Maryam da̱m suk Alisabatu lip ɗe mekan yek paa ta̱ pal ga̱zi.<verse eid="LUK 1:56" /></para>
  <para style="s">Za̱t ga̱ Yohana ma̱n baptisma</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57" />Yek za̱t yen ga̱ Alisabatu tul wi yek ta̱ zi yen maani. <verse eid="LUK 1:57" /><verse number="58" style="v" sid="LUK 1:58" />Yek ga̱ɓe ma̱tl ɗa̱nka̱ yela̱n da̱nti gwas ka suk yilkeni, kangwe Nya yen gonti gwas i'e wu, yek mas mbala̱n pa̱l hwol tuk sukti. <verse eid="LUK 1:58" /><verse number="59" style="v" sid="LUK 1:59" />Yeni mul ɗe wusupsi na̱ za̱t wugo, yek sa̱ sa̱lti, yek yilkeni ji Alisabatu mogaa mas suk yela̱n jwasi gas sa̱lti ga̱ yeni, yek sa̱ lami ɗe ta̱s zit shin ga̱ koli gwasi Zakariya. <verse eid="LUK 1:59" /><verse number="60" style="v" sid="LUK 1:60" />Yek gasa̱l gwas wulsi ɗe, &lt;&lt;Nuk so, ɗe Yohana ka̱n ka mbeti.&gt;&gt; <verse eid="LUK 1:60" /><verse number="61" style="v" sid="LUK 1:61" />Yek sa̱ wulti ɗe, &lt;&lt;Yek nu ye? Ka̱ ga̱s gwaka̱n wo ma̱n shin wu ni ɗa̱ so.&gt;&gt; <verse eid="LUK 1:61" /><verse number="62" style="v" sid="LUK 1:62" />Yek sa̱ pa̱li kolisi na̱ ang ɗe, nii ka̱n sa mbe shin ga̱ yeni gwi? <verse eid="LUK 1:62" /><verse number="63" style="v" sid="LUK 1:63" />Yek ta̱ ngwe ɗe ta̱s ba̱lti wul lishti, yek ta̱ lishi ɗe, &lt;&lt;Shin gwas ka̱ɗe Yohana.&gt;&gt; Na̱ kumti nu yek mbadl tatlisi. <verse eid="LUK 1:63" /><verse number="64" style="v" sid="LUK 1:64" />Zakariya na̱ma lishti shin ga̱ yeni, yek bi ɓuliti yek ta̱ nda ga̱ɓa. Yek ta̱ njel ta̱sti ga̱ Nya. <verse eid="LUK 1:64" /><verse number="65" style="v" sid="LUK 1:65" />Yek ɓanti ci yela̱n da̱nti jwasi yek sa̱ ngusi dla̱mti ilgwe pi wu mas ten za̱nda̱l atl ga̱ Yehudiya. <verse eid="LUK 1:65" /><verse number="66" style="v" sid="LUK 1:66" />Mas ma̱jwe kum ga̱ɓe jo yek ili cisi ɓanti, yek sa̱ ngem yilkeni ɗe, &lt;&lt;Ɗe yek yeni a da̱n ye?&gt;&gt; Na̱k ɗe ang ga̱ Nya ma̱n nda̱lti ni tenti nu wu.<verse eid="LUK 1:66" /></para>
  <para style="s">Koo ta̱sti Nya ga̱ Zakariya</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67" />Yek Shishi ga̱ Nya njika̱n mbadl ga̱ Zakariya aba ga̱ Yohana yek ta̱ dla̱m ga̱ɓa ga̱ Nya ten ilgwe a ya pi wu, yek ta̱ wule,<verse eid="LUK 1:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68" />&lt;&lt;Ma̱ ta̱sa̱n Nya ga̱ ma̱n Yisiraila</para>
  <para style="q2" vid="LUK 1:68">na̱k ɗe ta̱ na̱ma tulla̱t ga̱ ma̱n kisti ga̱ mbala̱n jwas wu.<verse eid="LUK 1:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69" />Ta̱ ɓalma shinti ga̱ bal ma̱n kisti ga̱na̱n suɗi</para>
  <para style="q2" vid="LUK 1:69">tet ka̱ ga̱s ga̱ zhel gwasi Dauda guu.<verse eid="LUK 1:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70" />Na̱k kangwe Nya dla̱mi ma̱n dla̱mti ga̱ɓa gwas ji cina wu.<verse eid="LUK 1:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71" />Ningo ta̱ ɓalma shinti ga̱ ma̱n kisti ga̱na̱n, ta̱s kisnii ɗa̱ka̱ ang ji mas ma̱n nget ga̱na̱n ka.<verse eid="LUK 1:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72" />Na̱k kangwe ta̱ wula̱nni ɗe ta yen gonti ji kolsi jina̱n wu,</para>
  <para style="q2" vid="LUK 1:72">a ba̱ta ma̱sa̱n zok ga̱ɓa gwe ta̱ dla̱lli ka̱ dlo gwas suksi wu so,<verse eid="LUK 1:72" /></para>
  <para style="q1">
    <verse number="73" style="v" sid="LUK 1:73" />Yek ɗe ga̱ɓa gwe ta̱ dla̱lli ka̱ dlo gwas suk koli ga̱na̱n Ibirahim wu.<verse eid="LUK 1:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="LUK 1:74" />Ta̱ hwini ɗe ta kisnii ɗa̱ mal ma̱n nget ga̱na̱n ka,</para>
  <para style="q2" vid="LUK 1:74">kangwe ba̱ ɓanti kopti gwas a cinni sowu,<verse eid="LUK 1:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="LUK 1:75" />Na̱ zok mbadli suk pa̱lti hwa wul ka̱ da̱nti ga̱na̱n mas a cina ɗatka.<verse eid="LUK 1:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76" />Ki nak en yen gi go, sa mbek ɗe ma̱n dla̱mti ga̱ɓa ga̱ Nya Bal Kakshe,</para>
  <para style="q2" vid="LUK 1:76">kik ɗe ma̱n la̱ka̱nti mbadl ga̱ mbala̱n ji Nya, na̱k ɗe ka tuli Almasihu cina aka̱ la̱ka̱mit tantu tulti wu,<verse eid="LUK 1:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77" />Kik ka hwi mbala̱n jwasi kangwe sa mbi kisti wu,</para>
  <para style="q2" vid="LUK 1:77">ten taasti byas wul jwasa̱n ka.<verse eid="LUK 1:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78" />Na̱k ɗe Nya wo ma̱n yenti gonti ka̱n i'e wu,</para>
  <para style="q2" vid="LUK 1:78">ta shin Almasihu suɗi na̱k gwe a cin yil tot na̱ cilti wu.<verse eid="LUK 1:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79" />A cilti gwisi ka cilli ma̱n da̱nti ka̱ da̱mshal suk ma̱jwe ni ka̱ da̱n-da̱n ma̱shka̱n wu,</para>
  <para style="q2" vid="LUK 1:79">ata̱ koɓi na̱mi ten tantu ta̱mti mbadli.&gt;&gt;<verse eid="LUK 1:79" /></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80" />Yek Yohana nali yek ta̱ nda̱li ata̱ na̱ma ɓotlka̱n, yek ta̱ da̱m ka̱ la̱ɓi se na̱k ta̱ nda dla̱mti ga̱ɓa ka̱ dlo ga̱ ma̱n Yisiraila.<verse eid="LUK 1:80" /></para>
  <chapter eid="LUK 1" />
  <chapter number="2" style="c" sid="LUK 2" />
  <para style="s">Za̱t ga̱ Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1" />Ni nu ka̱ multi jon, yek ga̱ɓa yil sut mal guu ga̱ ma̱n atl ga̱ Rom asa̱ mbet ɗe Kaisar Ogostus, ɗe ngetli ka̱n ta̱s dla̱m wonta̱t ga̱ ma̱jwe ni ka̱ atl gwas wu mas na̱ shin gwasa̱n. <verse eid="LUK 2:1" /><verse number="2" style="v" sid="LUK 2:2" />Yek ɗe ndat zhila dla̱mti wonta̱t ga̱ mbala̱n ka̱ multi jwe Kiriniyas ni ɗe gobna ga̱ Siriya wu. <verse eid="LUK 2:2" /><verse number="3" style="v" sid="LUK 2:3" />Yek mbala̱n li mas jwasa̱n ta̱s dla̱msi ɗa̱nka̱ ba̱n jwasa̱n ka. <verse eid="LUK 2:3" /><verse number="4" style="v" sid="LUK 2:4" />Na̱k ɗe Yusupu wo ma̱n ga̱s ga̱ Dauda ka̱wu, yek ta̱ zak Nazarat ka̱ atl ga̱ Galili yek ta̱ li ka̱ ba̱n Baitalami ka̱ atl ga̱ Yehudiya. Ba̱n gwe sa̱ zi Dauda ma̱lgwe tik ɗe gus guu gwasa̱n wu. <verse eid="LUK 2:4" /><verse number="5" style="v" sid="LUK 2:5" />Yusupu mago ta̱ su ta̱s dla̱msi suk Maryam yen kili gwe ta̱ na̱ma kopti gwas wu. A yen nit tuki. <verse eid="LUK 2:5" /><verse number="6" style="v" sid="LUK 2:6" />Sa̱ ni Baitalami nugo yek za̱t yen tuliti. <verse eid="LUK 2:6" /><verse number="7" style="v" sid="LUK 2:7" />Yek ta̱ zi yen cina gwasi yen maani yek ta̱ kusti ka na̱ wul lut yen kaali. Yek ta̱ lakti ka̱ wul tlat ze ji tla na̱k ɗe ba̱sa̱ mbi punka ka̱ lubii gwe a ma̱nda̱ki shuk wu sowu.<verse eid="LUK 2:7" /></para>
  <para style="s">Ma̱n kyo suk mil shinti ga̱ Nya</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8" />A ma̱n kyo na̱ma multi ten dii atli njaa ka̱ lwisi, asa̱ na̱ma ɓa̱tti mba̱la jwasa̱n ka̱ gasi. <verse eid="LUK 2:8" /><verse number="9" style="v" sid="LUK 2:9" />Ba̱ na̱ yisti gwasa̱n so, yek yen shinti ga̱ Nya tuli yek ta̱ dla̱l malsi, yek nalti ga̱ guu ga̱ Nya cilli lwisi ka. Yek ɓanti cisi i'e. <verse eid="LUK 2:9" /><verse number="10" style="v" sid="LUK 2:10" />Yek yen shinti wulsi ɗe, &lt;&lt;Ba̱ ɓanti ciki so, ga̱ɓa ga̱ Nya ma̱n ta̱mti, ma̱n hwolla̱t mbadl ka̱n a tullikii gwe ni ɗe ga̱ mbala̱n mas wu. <verse eid="LUK 2:10" /><verse number="11" style="v" sid="LUK 2:11" />Ase go ka̱ bal ba̱n ga̱ Dauda sa̱ zikii ma̱lgwe ɗe ta kis mbala̱n ɗa̱ka̱ byas wul ka̱wu, asa̱ mbet ɗe Almasihu Bagaa. <verse eid="LUK 2:11" /><verse number="12" style="v" sid="LUK 2:12" />Ilgwe ka yeni wuggu, ka mbi yen ga̱ kusi ka̱ wul lut yen kaali a atli ka̱ wul tlat ze ji tla.&gt;&gt; <verse eid="LUK 2:12" /><verse number="13" style="v" sid="LUK 2:13" />A ba̱ ma̱lgon ɓo kum ga̱ɓe so, yek wonti mil shinti ji Nya suk yen shinti gon wu, njel ta̱sti ga̱ Nya ɗe, <verse eid="LUK 2:13" /><verse number="14" style="v" sid="LUK 2:14" />&lt;&lt;Nalti ga̱ Nya Bal Kakshe to nya ka, ten dii atl wo ta̱mi mbadl ga̱ mbala̱n jwe ta̱ na̱ma hwol tuk na̱ si wu.&gt;&gt; <verse eid="LUK 2:14" /><verse number="15" style="v" sid="LUK 2:15" />Sa̱ ni nugo, yek mil shinti ji Nyami zaksi yek sa̱ pal to nya ka, yek ma̱n kyoɓi wul yilkeni ɗe, &lt;&lt;Mi mago ma̱ ɓo su Baitalamisi pak, ta̱n sak yena̱n ilgwe na̱ma pa̱t wu, gwe ɗe Bagaa Nya hwini wu.&gt;&gt; <verse eid="LUK 2:15" /><verse number="16" style="v" sid="LUK 2:16" />Yek sa̱ li ka̱ ba̱mi ɓaa-ɓaa, yek sa̱ mbi ka̱ Maryam suk Yusupu suk yen la̱li gwasa̱n ata̱ ni atli ka̱ wul tlat ze ji tla. <verse eid="LUK 2:16" /><verse number="17" style="v" sid="LUK 2:17" />Yek ma̱n kyoɓi yenti wugo, yek sa̱ dla̱misi ilgwe yen shinti ga̱ Nya hwisi ten yen ni wu. <verse eid="LUK 2:17" /><verse number="18" style="v" sid="LUK 2:18" />Mas ma̱jwe kum ga̱ɓa gwe ma̱n kyo ju dla̱m wu, yek sa̱ ngip bi ka̱ ang asa̱ na̱ma yenti wul cit ɓanti ten ilgwe ma̱n kyoɓi dla̱m wu. <verse eid="LUK 2:18" /><verse number="19" style="v" sid="LUK 2:19" />Yek Maryam ngip ga̱ɓe mas ka̱ mbadl gwasi, yek ta̱ ngusi daamti gwas a dani. <verse eid="LUK 2:19" /><verse number="20" style="v" sid="LUK 2:20" />Yek ma̱n kyoɓi pal ga̱za̱n na̱ hwol tuki, na̱ ta̱sti nalti ga̱ Nya na̱ ilgwe sa̱ kumi yek sa̱ yeni wu ndakce na̱k kangwe yen shinti ga̱ Nya hwisi wu.<verse eid="LUK 2:20" /></para>
  <para style="s">Za̱t shin ga̱ Yesu</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21" />Yeni njika̱n multi na̱ wusupsi wugo, yek sa̱ sa̱lti, yek sa̱ zit shin ɗe Yesu, shin gwe yen shinti ga̱ Nya ba̱li a ba̱sa̱ ɓo mbi tuk gwas sowu.<verse eid="LUK 2:21" /></para>
  <para style="p">
    <verse number="22-24" style="v" sid="LUK 2:22-24" />Yek multi jwe a kili ma̱n za̱t yen kul pa̱li na̱ da̱ska̱n njika̱n wugo, yek Maryam suk Yusupu li ka̱ lubii ga̱ Nya a Wurshelima na̱k gwe dla̱m ka̱ mba̱t ga̱ Musa wu. Yek sa̱ taki wul Nya kangwe mba̱t gwe Nya ba̱l Musa dla̱m wu, &lt;&lt;Kulu me ɗe lop sogo mil kulu boo ɗe lop,&gt;&gt; ka̱n sa mboshi asa̱ taki Nya. Yek sa̱ ta̱la Yesu Wurshelima ta̱s takiti Nya, na̱k gwe mba̱t gwe Nya ba̱l Musa dla̱m wu, &lt;&lt;Mas yen maani gwe ɗe yen cingo, ta da̱n ɗe ma̱n la̱shi da̱ska̱n ga̱ Nya.&gt;&gt;<verse eid="LUK 2:22-24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25" />Ka̱ multi jwisi wo, a ma̱lgon ni ɗa̱ a Wurshelima asa̱ mbet ɗe Saminu, ma̱n zok mbadl gon a hwa zhel ga̱ Nya ka̱ɗe ti. Ta̱ na̱ma ɓa̱tti ma̱lgwe a kis ma̱n Yisiraila wu. A Shishi ga̱ Nya ni sukti. <verse eid="LUK 2:25" /><verse number="26" style="v" sid="LUK 2:26" />Shishi ga̱ Nya hwit ɗe ta ɓo ma̱sh so se ta̱ yen Almasihu gwe Nya a shinti sut wu. <verse eid="LUK 2:26" /><verse number="27" style="v" sid="LUK 2:27" />Yek Shishi ga̱ Nya ta̱la Saminu ka̱lu lubii ga̱ Nyami lu gwe ka̱ Maryam suk Yusupu ta̱la Yesu ta̱s pa̱lit na̱k gwe mba̱t ga̱ Musa dla̱m wu. <verse eid="LUK 2:27" /><verse number="28" style="v" sid="LUK 2:28" />Yek Saminu kan yeni ka̱ ang gwasi yek ta̱ ta̱s Nya, yek ta̱ wule,<verse eid="LUK 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29" />&lt;&lt;Bagaa Nya , ningo zhel gwa a ma̱sh na̱ ta̱mi mbadli, na̱k kangwe ka̱ dla̱mi wu.<verse eid="LUK 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30" />Na̱k ɗe gwel gi yen kisti gwa wu,<verse eid="LUK 2:30" /></para>
  <para style="q2">
    <verse number="31" style="v" sid="LUK 2:31" />kisti gwe ka̱ pa̱li mas mbala̱n wu.<verse eid="LUK 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32" />Tik ɗe cilti gwe a cilli ma̱jwe ba̱ Ma̱n Yehuda ka̱ sowu,</para>
  <para style="q2" vid="LUK 2:32">a tik ɗe ma̱lgwe ma̱n Yisiraila a nda̱l ka̱ti wu.&gt;&gt;<verse eid="LUK 2:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33" />Yek aba gwasi suk ana gwas ngip bi ka̱ ang na̱ cit ɓanti na̱ ilgwe Saminu dla̱m ten yen gwasa̱n wu. <verse eid="LUK 2:33" /><verse number="34" style="v" sid="LUK 2:34" />Yek Saminu ngem Nya ta̱s ba̱lsi zok wul gwasi, yek ta̱ hwi ana gwas Maryam ɗe, &lt;&lt;Yen ga̱n go mbala̱n wonti ka̱ Israila a ngeti asa̱ nda, a wonti a lamti asa̱ dla̱li, a ta da̱n ɗe lal gwe ba̱ mbala̱n lami sowu. <verse eid="LUK 2:34" /><verse number="35" style="v" sid="LUK 2:35" />Na̱ nu ka̱n wul jwe sa̱ zi ka̱ mbadl gwasa̱n wu a yil deɓa̱l. Ilga̱n a ciki na̱k wule puka ka̱ tul mbadl gwa.&gt;&gt;<verse eid="LUK 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36" />Kol gasa̱l ma̱n dla̱mti ga̱ɓa ga̱ Nya gon ni ɗa asa̱ mbet ɗe Hannatu, yen ga̱ Panuwel ma̱n ga̱s ga̱ Ashiru. Ta̱ da̱n bii kos gin ɗe nitgi, <verse eid="LUK 2:36" /><verse number="37" style="v" sid="LUK 2:37" />yek kos gwas ma̱shi, yek ta̱ ɓal ka̱ gin ɗe kutl na̱ wusupsi na̱ wupsi. Ba̱ta huul na̱ lubii ga̱ Nya so, ata̱ ngem Nya na̱ ka̱ cin na̱ ka̱ gasi ata̱ pa̱l ka̱lka̱ze pak. <verse eid="LUK 2:37" /><verse number="38" style="v" sid="LUK 2:38" />Yek ta̱ li mal ka̱ Saminu suk ka̱ Maryam ka̱lu bii ngemti Nyami, yek ta̱ ngusi hwol tuk na̱ Nya yek ta̱ hwi ga̱ɓa mbala̱n jwe na̱ma ɓa̱tti kisti ga̱ Wurshelima wu ten yeni. <verse eid="LUK 2:38" /><verse number="39" style="v" sid="LUK 2:39" />Ka̱ Yusupu suk Maryam pak pa̱lti ilgwe mba̱t ga̱ Musa dla̱m ɗe ta̱s pa̱li wugo, yek sa̱ pal ga̱za̱n a Nazarat ka̱ atl ga̱ Galili. <verse eid="LUK 2:39" /><verse number="40" style="v" sid="LUK 2:40" />Yek yeni nali yek ta̱ nda̱li, yek ta̱ njika̱n na̱ ɓotlka̱n yisti wul, a hwa wul ga̱ Nya ni sukti.<verse eid="LUK 2:40" /></para>
  <para style="s">Yesu ga̱ɓa suk kiɗi ma̱n lishti ata̱ yi nak'eni</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41" />Mas gin, a aba suk ana ga̱ Yesu li Wurshelima ta̱s pa̱l Motgaa daamti ɗakcit boo ji Israila. <verse eid="LUK 2:41" /><verse number="42" style="v" sid="LUK 2:42" />Yesu njika̱n gin kutl cet lop wugo, yek sa̱ to na̱k gwe asa̱ kul pa̱li wu. <verse eid="LUK 2:42" /><verse number="43" style="v" sid="LUK 2:43" />Sa̱ pak motgaami wi ɗe sa̱ ɓa pal ga̱za̱n go yek Yesu sa tukaali a Wurshelima, aba̱ abe suk ane yisi so. <verse eid="LUK 2:43" /><verse number="44" style="v" sid="LUK 2:44" />Sa̱ da̱m gwa we ta̱ ni suksi ka̱ mbala̱n, yek ba̱ ni nu so. Yek paa sa̱ nda ngot gwas ka̱ yilkeni suk ma̱jwe sa̱ yissi ju asa̱ nda cin ten a la̱t wi. <verse eid="LUK 2:44" /><verse number="45" style="v" sid="LUK 2:45" />Yek ba̱sa̱ yenti so. Yek sa̱ pal te Wurshelima ka ten ngot gwasi. <verse eid="LUK 2:45" /><verse number="46" style="v" sid="LUK 2:46" />Sa̱ mul ɗe mekan ten ngot gwas wugo, yek sa̱ lak mbit ka̱ dlo ji ma̱n lishti ka̱ lubii ga̱ Nya, ata̱ na̱ma kumti gwasa̱n ata̱ na̱ma bodla̱lti gwasa̱n na̱ kumti ga̱s wul. <verse eid="LUK 2:46" /><verse number="47" style="v" sid="LUK 2:47" />Mas ma̱jwe kumti jo yek sa̱ ngip bi ka̱ ang a ɓanti na̱ma cit gwasa̱n na̱ yisti wul gwasi na̱ kangwe ata̱ ballisi ga̱ɓa wu. <verse eid="LUK 2:47" /><verse number="48" style="v" sid="LUK 2:48" />Aba gwas suk ana gwas mbit wugo, yek ɓanti cisi, ɗe sa̱ yenti ka̱ dlo ga̱ ma̱n lishti wu, yek ana gwas wulti ɗe, &lt;&lt;Ma̱ na̱ma ta ngot gwa suk aba gwa yek laki yek ka̱ pa̱lini nu ye?&gt;&gt; <verse eid="LUK 2:48" /><verse number="49" style="v" sid="LUK 2:49" />Yek ta̱ wulsi ɗe, &lt;&lt;Yek laki ɗe ka̱ na̱ma ngot gi ye? Ka̱ yisi ɗe ngetli ka̱n nii ɗe ta̱ pa̱l wul ga̱ aba gi sa?&gt;&gt; <verse eid="LUK 2:49" /><verse number="50" style="v" sid="LUK 2:50" />Yek ba̱sa̱ yis ilgwe ta̱ nisi ma dla̱mti wu so. <verse eid="LUK 2:50" /><verse number="51" style="v" sid="LUK 2:51" />Yek ta̱ kopsi yek sa̱ li Nazarat ata̱ na̱ma kopti ga̱ɓa gwasa̱n. Yek ana gwas ngip ili mas ka̱ mbadl gwasi. <verse eid="LUK 2:51" /><verse number="52" style="v" sid="LUK 2:52" />Yek Yesu ngusi nalti ata̱ na̱ma ɓotlka̱n yisti wul suk hwol hwula̱n mal Nya suk mal mbala̱n.<verse eid="LUK 2:52" /></para>
  <chapter eid="LUK 2" />
  <chapter number="3" style="c" sid="LUK 3" />
  <para style="s">Ga̱ɓa ga̱ Yohana ma̱n baptisma</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1" />Ka̱ gin ɗe kutl cet namtan ɗe Kaisar Tiberiyas ni ɗe bal guu ka̱ atl ga̱ Rom. A Bilatus ni ɗe gobna ga̱ ma̱n Yehudiya. A Hiridus ka̱ɗe guu ga̱ ma̱n Galili. Yilka gwas Pilip wo ata̱ ni ɗe guu ga̱ ma̱n Ituriya suk Tarakanitus. A Lisaniyas ni ɗe guu ga̱ ma̱n Abilen. <verse eid="LUK 3:1" /><verse number="2" style="v" sid="LUK 3:2" />Ka̱ Anana suk Kayapas ka̱ɗe kiɗi ma̱n Pa̱ris. Yek Nya ga̱ɓa suk Yohana yen ga̱ Zakariya ata̱ na̱ma da̱nti ka̱ la̱ɓi. <verse eid="LUK 3:2" /><verse number="3" style="v" sid="LUK 3:3" />Yek ta̱ ngusi ma̱tlti ɗa̱nka̱ ba̱n jwe ni njaa mal dla̱lka gon asa̱ mbe ɗe Yodan wu ata̱ nima hwit ga̱ɓa mbala̱n ɗe, ta̱s cit atl gaa mal Nya ta̱s taasisi byas wul jwasa̱n ka asa̱ pa̱lisi baptisma.<verse eid="LUK 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 3:4" />Na̱k gwe ni ga̱ lishi ka̱ lishti ga̱ Ishaya ma̱n dla̱mti ga̱ɓa ga̱ Nya ɗe:</para>
  <para style="q1" vid="LUK 3:4">&lt;&lt;Tik ɗe yal gwe na̱ma takti bi na̱ nda̱lti ka̱ la̱ɓi gwe na̱ma wulti ga̱ mbala̱n ɗe,</para>
  <para style="q2" vid="LUK 3:4">&lt;La̱ka̱mi Bagaa tantu gwaka̱n, la̱ka̱ma̱n da̱nti gwaka̱n.<verse eid="LUK 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5" />Njika̱ma̱n gora̱ndla̱n ka.</para>
  <para style="q2" vid="LUK 3:5">Taka̱n tantu jwe kontan ka̱ju ka.<verse eid="LUK 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6" />Na̱ nu ka̱n mas mbala̱n a yen kisti ga̱ Nya.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">Yen</char><char style="xt"><ref loc="ISA 40:3-5">Ish 40:3-5</ref></char>.</note><verse eid="LUK 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7" />Yek Yohana hwi mbala̱n jwe ɗe mogaa ta̱s pa̱lisi baptisma wu ɗe, &lt;&lt;Ɓuɓul na̱k kii, wok hwikii ɗe ta̱k aɓii lilti mbadl ga̱ Nya ma̱n tulti wo? <verse eid="LUK 3:7" /><verse number="8" style="v" sid="LUK 3:8" />Pa̱la̱n ilgwe a mbok ang ten cit atl gaa gwaka̱n wu. Ba̱k wula̱n ɗe kii wo ma̱n ga̱s ga̱ Ibirahim wo ka̱ ni ka̱ ma̱n pa̱lti byas wul so so, nu ka̱n ni so. Nya a man palla̱t mil ye asa̱ da̱n ɗe mil ji Ibirahim. <verse eid="LUK 3:8" /><verse number="9" style="v" sid="LUK 3:9" />Na̱k ninge mago bi ndal ni ten zhila tlindi, mas tlindi jwe wut mil sogo a wotl ka a wut ka̱ wutu.&gt;&gt;<verse eid="LUK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10" />Yek mbala̱mi kum ga̱zi ɗe, &lt;&lt;Yek ma pa̱li ye?&gt;&gt;<verse eid="LUK 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11" />Yek Yohana wulsi ɗe, &lt;&lt;Ma̱lgwe luka̱l ɗe lop niɗɗa̱ wu, ata̱ ba̱l ɗe na̱m ma̱lgwe niɗɗa̱ sowu; a ma̱lgwe ilga̱ nguki niɗɗa̱ wu ta̱s pa̱li nu pak.&gt;&gt;<verse eid="LUK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12" />Ma̱n kanti wulpi boo tul mal Yohana ta̱s pa̱lisi baptisma, yek sa̱ ngemti ɗe, &lt;&lt;Ma̱n lishti, yek ma pa̱li ye?&gt;&gt;<verse eid="LUK 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13" />Yek Yohana wulsi ɗe, &lt;&lt;Mboka̱n ang ten gem gwaka̱n, ba̱k kama̱n wulpi boo mal mbala̱n nal man kangwe sa̱ zikii kanti wu so.&gt;&gt;<verse eid="LUK 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 3:14" />Yek ma̱n hapti tlo jon kum ga̱zi ɗe, &lt;&lt;Yek ma pa̱li ye?&gt;&gt;</para>
  <para style="p" vid="LUK 3:14">Yek Yohana ballisi ɗe, &lt;&lt;Ba̱k kama̱n wulpi mal mbala̱n ngetli so, a ba̱k sheli lal ma̱lgon gaa so. Dlo mbadl na̱ ɓatlti gwaka̱n.&gt;&gt;<verse eid="LUK 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15" />Mbala̱n mas na̱ma ɓa̱tti tulti ga̱ Almasihu ba̱le, sa̱ lami ta̱s yisi ko gwa Yohana ka̱ɗe Almasihu.<note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false">Sogo</char><char style="fqa" closed="false">Kiristi</char></note> <verse eid="LUK 3:15" /><verse number="16" style="v" sid="LUK 3:16" />Yek Yohana nda̱kisi ɗe, &lt;&lt;Ami wo na̱ ze ka̱n a pa̱likii baptisma, ama bal ma̱lgon a ya tuli ma̱lgwe nal mana̱n wu, ta̱ man ngetl ga̱ ta pa̱tl kapta̱lan gwasi. Tik ka pa̱likii baptisma na̱ Shishi ga̱ Nya suk wutu. <verse eid="LUK 3:16" /><verse number="17" style="v" sid="LUK 3:17" />Ta huul tlo ga̱ gwesi suk ka̱pti na̱ gal pelti wul gwasi. Ta taas lu cokti tul gwas ka mas ata̱ wut gwesi ka̱ nhu gwasi. Ka̱pti wo ata̱ kweli ka na̱ wutu gwe ba̱ a mba̱sh sowu.&gt;&gt;<verse eid="LUK 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 3:18" />Yohana hwisi wunda̱l ga̱ɓa jwisi wonti ma̱n nda̱lti ɗe ta̱ nisi ma hwit ga̱ɓa ma̱n ta̱mti wu.<verse eid="LUK 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 3:19" />Yohana ga̱ɓa ten Hiridus guu ten hapti gwe ta̱ hap kili ga̱ Pilip yilka gwas wu, suk byas wul jwe ta̱ pa̱li wonti wu. <verse eid="LUK 3:19" /><verse number="20" style="v" sid="LUK 3:20" />Yek Hiridus guu yitla Yohana ka̱ bii gwe asa̱ tel ma̱n pa̱lti byas wul wu, ɗa̱ ten byas wul jwe ta̱ pa̱li wu.<verse eid="LUK 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21" />Gas gon sa̱ nima pa̱lti baptisma mbala̱n wonti. Yek Yesu na̱ gaa gwas mago yek sa̱ pa̱liti. Ta na̱ma ngemti Nya nugo, yek tlo nya ɓuli. <verse eid="LUK 3:21" /><verse number="22" style="v" sid="LUK 3:22" />Yek Shishi ga̱ Nya yil sut nya na̱k kulu yek ta̱ dla̱l ten Yesu. Yek ga̱ɓa wul sut nya ɗe, &lt;&lt;Kik ɗe yen gi gwe a lamki wu. A na̱ma hwol tuk na̱ ki i'e.&gt;&gt;<verse eid="LUK 3:22" /></para>
  <para style="s">Dla̱mti ga̱s ga̱ Yesu</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23" />Yesu ni ka̱ gin ɗe kutl ɗe mekan ɗe ta̱ nda dla̱mti ga̱ɓa ga̱ Nya mbala̱n wu, ka̱ yisti ga̱ mbala̱n wo Yesu wo yen ga̱ Yusupu ka̱n,</para>
  <para style="li1" vid="LUK 3:23">Yusupu wo yen ga̱ Heli.<verse eid="LUK 3:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="LUK 3:24" />Heli yen ga̱ Matat,</para>
  <para style="li1" vid="LUK 3:24">Matat yen ga̱ Lawi,</para>
  <para style="li1" vid="LUK 3:24">Lawi yen ga̱ Malki,</para>
  <para style="li1" vid="LUK 3:24">Malki yen ga̱ Jannai,</para>
  <para style="li1" vid="LUK 3:24">Jannai yen ga̱ Yusupu.<verse eid="LUK 3:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="LUK 3:25" />Yusupu yen ga̱ Matatiya,</para>
  <para style="li1" vid="LUK 3:25">Matatiya yen ga̱ Emos,</para>
  <para style="li1" vid="LUK 3:25">Emos yen ga̱ Nahu,</para>
  <para style="li1" vid="LUK 3:25">Nahu yen ga̱ Azariya,</para>
  <para style="li1" vid="LUK 3:25">Azariya yen ga̱ Esli,</para>
  <para style="li1" vid="LUK 3:25">Esli yen ga̱ Najaya.<verse eid="LUK 3:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="LUK 3:26" />Najaya yen ga̱ Ma'ata,</para>
  <para style="li1" vid="LUK 3:26">Ma'ata yen ga̱ Matatiya,</para>
  <para style="li1" vid="LUK 3:26">Matatiya yen ga̱ Shimeya,</para>
  <para style="li1" vid="LUK 3:26">Shimeya yen ga̱ Yusupu,</para>
  <para style="li1" vid="LUK 3:26">Yusupu yen ga̱ Yoda.<verse eid="LUK 3:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="LUK 3:27" />Yoda yen ga̱ Yowana,</para>
  <para style="li1" vid="LUK 3:27">Yowana yen ga̱ Repaya,</para>
  <para style="li1" vid="LUK 3:27">Repaya yen ga̱ Zerubabel,</para>
  <para style="li1" vid="LUK 3:27">Zerubabel yen ga̱ Shayeltiyel,</para>
  <para style="li1" vid="LUK 3:27">Shayeltiyel yen ga̱ Niri.<verse eid="LUK 3:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="LUK 3:28" />Niri yen ga̱ Malki,</para>
  <para style="li1" vid="LUK 3:28">Malki yen ga̱ Addi,</para>
  <para style="li1" vid="LUK 3:28">Addi yen ga̱ Kosama,</para>
  <para style="li1" vid="LUK 3:28">Kosama yen ga̱ Almadama,</para>
  <para style="li1" vid="LUK 3:28">Almadama yen ga̱ Er.<verse eid="LUK 3:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="LUK 3:29" />Er yen ga̱ Yosi,</para>
  <para style="li1" vid="LUK 3:29">Yosi yen ga̱ Eliyeza,</para>
  <para style="li1" vid="LUK 3:29">Eliyeza yen ga̱ Yorima,</para>
  <para style="li1" vid="LUK 3:29">Yorima yen ga̱ Matat,</para>
  <para style="li1" vid="LUK 3:29">Matat yen ga̱ Lawi.<verse eid="LUK 3:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="LUK 3:30" />Lawi yen ga̱ Saminu,</para>
  <para style="li1" vid="LUK 3:30">Saminu yen ga̱ Yehuda,</para>
  <para style="li1" vid="LUK 3:30">Yehuda yen ga̱ Yusupu,</para>
  <para style="li1" vid="LUK 3:30">Yusupu yen ga̱ Yonam,</para>
  <para style="li1" vid="LUK 3:30">Yonam yen ga̱ Eliyakim.<verse eid="LUK 3:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="LUK 3:31" />Eliyakim yen ga̱ Malaya,</para>
  <para style="li1" vid="LUK 3:31">Malaya yen ga̱ Mainana,</para>
  <para style="li1" vid="LUK 3:31">Mainana yen ga̱ Matata,</para>
  <para style="li1" vid="LUK 3:31">Matata yen ga̱ Natan,</para>
  <para style="li1" vid="LUK 3:31">Natan yen ga̱ Dauda.<verse eid="LUK 3:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="LUK 3:32" />Dauda yen ga̱ Yesse,</para>
  <para style="li1" vid="LUK 3:32">Yesse yen ga̱ Obida,</para>
  <para style="li1" vid="LUK 3:32">Obida yen ga̱ Bo'aza,</para>
  <para style="li1" vid="LUK 3:32">Bo'aza yen ga̱ Salmon,</para>
  <para style="li1" vid="LUK 3:32">Salmon yen ga̱ Nashon.<verse eid="LUK 3:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="LUK 3:33" />Nashon yen ga̱ Aminadab,</para>
  <para style="li1" vid="LUK 3:33">Aminadab yen ga̱ Aram,</para>
  <para style="li1" vid="LUK 3:33">Aram yen ga̱ Hesruna,</para>
  <para style="li1" vid="LUK 3:33">Hesruna yen ga̱ Peresa,</para>
  <para style="li1" vid="LUK 3:33">Peresa yen ga̱ Yehuda.<verse eid="LUK 3:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="LUK 3:34" />Yehuda yen ga̱ Yakubu,</para>
  <para style="li1" vid="LUK 3:34">Yakubu yen ga̱ Ishaku,</para>
  <para style="li1" vid="LUK 3:34">Ishaku yen ga̱ Ibirahim,</para>
  <para style="li1" vid="LUK 3:34">Ibirahim yen ga̱ Tera,</para>
  <para style="li1" vid="LUK 3:34">Tera yen ga̱ Nahor.<verse eid="LUK 3:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="LUK 3:35" />Nahor yen ga̱ Seruk,</para>
  <para style="li1" vid="LUK 3:35">Seruk yen ga̱ Reza,</para>
  <para style="li1" vid="LUK 3:35">Reza yen ga̱ Pelek,</para>
  <para style="li1" vid="LUK 3:35">Pelek yen ga̱ Eba,</para>
  <para style="li1" vid="LUK 3:35">Eba yen ga̱ Shela.<verse eid="LUK 3:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="LUK 3:36" />Shela yen ga̱ Kenan,</para>
  <para style="li1" vid="LUK 3:36">Kenan yen ga̱ Arpakshad,</para>
  <para style="li1" vid="LUK 3:36">Arpakshad yen ga̱ Shem,</para>
  <para style="li1" vid="LUK 3:36">Shem yen ga̱ Nuhu,</para>
  <para style="li1" vid="LUK 3:36">Nuhu yen ga̱ Lamek.<verse eid="LUK 3:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="LUK 3:37" />Lamek yen ga̱ Metusela,</para>
  <para style="li1" vid="LUK 3:37">Metusela yen ga̱ Enok,</para>
  <para style="li1" vid="LUK 3:37">Enok yen ga̱ Yared,</para>
  <para style="li1" vid="LUK 3:37">Yared yen ga̱ Mahalalel,</para>
  <para style="li1" vid="LUK 3:37">Mahalalel yen ga̱ Kenan.<verse eid="LUK 3:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="LUK 3:38" />Kenan yen ga̱ Enosh,</para>
  <para style="li1" vid="LUK 3:38">Enosh yen ga̱ Shitu,</para>
  <para style="li1" vid="LUK 3:38">Shitu yen ga̱ Adamu,</para>
  <para style="li1" vid="LUK 3:38">Adamu wo ga̱ Nya.<verse eid="LUK 3:38" /></para>
  <chapter eid="LUK 3" />
  <chapter number="4" style="c" sid="LUK 4" />
  <para style="s">Sheɗan cinga̱l Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1" />Yek Shishi ga̱ Nya njika̱n Yesu, yek ta̱ zak lu dla̱lka Yodan, yek Shishi ga̱ Nyami ta̱lat ka̱ la̱ɓi, <verse eid="LUK 4:1" /><verse number="2" style="v" sid="LUK 4:2" />ka̱lu gwe Sheɗan cinga̱lti wu. Multi ɗe kutl ɗe wupsi a ba̱ta̱ nguk ilgon so, a kuza̱n ɓalma tlot gwas i'e. <verse eid="LUK 4:2" /><verse number="3" style="v" sid="LUK 4:3" />Yek Sheɗan wulti ɗe, &lt;&lt;Kume ki wo Yen ga̱ Nya ka̱go, palli ye ga̱n ɗe burodi.&gt;&gt;<verse eid="LUK 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4" />Yek Yesu wulti ɗe, &lt;&lt;Ni ga̱ lishi ɗe, &lt;Ilga̱ nguki na̱ ngus ka̱ɗe ma̱n lakti mbala̱n asa̱ da̱n na̱ mbadl so.&gt; &gt;&gt; <note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">Yen</char><char style="xt"><ref loc="DEU 8:3">K. M. 8:3</ref></char>. </note><verse eid="LUK 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5" />Yek Sheɗan tolti ten tlal lu gon, yek ta̱ mbokit ang ten dii atli na̱ mas wul jwe ni giɓi wu ka̱ nak da̱nti. <verse eid="LUK 4:5" /><verse number="6" style="v" sid="LUK 4:6" />Yek Sheɗan wulti ɗe, &lt;&lt;Ba palla̱k ɗe bagaa ga̱ mas mbuni wul jimi, mas ji ka̱n, a ba mani ba̱lti ma̱lgwe a lamit wu. <verse eid="LUK 4:6" /><verse number="7" style="v" sid="LUK 4:7" />Ba ba̱lki mas, kume ka̱ ngus atli yek ka̱ ba̱la̱n nalti wu.&gt;&gt;<verse eid="LUK 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8" />Yek Yesu ballit ɗe, &lt;&lt;Ni ga̱ lishi ɗe, &lt;Bagaa Nya gwa na̱ ngus ka̱n ka ba̱lti nalti, ti na̱ ngus ka̱n ka da̱n ɗe zhel gwasi.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">Yen</char><char style="xt"><ref loc="DEU 6:13">K. M. 6:13</ref></char>.</note><verse eid="LUK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9" />Yek Sheɗan ta̱lat Wurshelima, yek ta̱ tolti ten gaa lubii ga̱ Nya, yek ta̱ wulti ɗe, &lt;&lt;Kumɗe Yen ga̱ Nya ka̱ɗe ki wu, ɗakci lu suɗi, <verse eid="LUK 4:9" /><verse number="10" style="v" sid="LUK 4:10" />na̱k gwe ni ga̱ lishi ɗe, &lt;Nya a shin mil shinti jwas suɗi <verse eid="LUK 4:10" /><verse number="11" style="v" sid="LUK 4:11" />asa̱ ngipki na̱ ang gwasa̱n. A ba̱ka ɓo asa̱n ten ye so.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="ft" closed="false">Yen</char><char style="xt"><ref loc="PSA 91:11">Zab 91:11</ref>,<ref loc="PSA 91:12">12</ref></char>. </note><verse eid="LUK 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12" />Yek Yesu wulti ɗe, &lt;&lt;Ni ga̱ lishi ɗe, &lt;Ba̱k cinga̱l Bagaa Nya gwa so.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false">Yen</char><char style="xt"><ref loc="DEU 6:16">K. M. 6:16</ref></char>.</note><verse eid="LUK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13" />Sheɗan pak cinga̱lti ga̱ Yesu wugo, yek ta̱ zakti, yek ta̱ ɓa̱t zobsi cin gon ɗa.<verse eid="LUK 4:13" /></para>
  <para style="s">Sa̱ nge Yesu a Nazarat</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14" />Yek Yesu pal te atl ga̱ Galili ka a mbadl gwas ni ga̱ njikmi na̱ nda̱lti Shishi ga̱ Nya, yek mbala̱n wonti kum ga̱ɓa tenti mas ka̱ atli. <verse eid="LUK 4:14" /><verse number="15" style="v" sid="LUK 4:15" />A ta̱ kul hwi ga̱ɓa mbala̱n ka̱lu motgaa ga̱ gwasa̱n, a mas mbala̱n ta̱sti. <verse eid="LUK 4:15" /><verse number="16" style="v" sid="LUK 4:16" />Yek Yesu li ka̱ nak'en ba̱n gon asa̱ mbe ɗe Nazarat, ka̱lu gwe ta̱ nal wu, yek ta̱ te ka̱lu motgaa gwasa̱n na̱k kangwe ata̱ kul pa̱li gas shukti wu. <verse eid="LUK 4:16" /><verse number="17" style="v" sid="LUK 4:17" />Yek sa̱ ba̱lti lishti gwe Ishaya yen shinti dla̱mti ga̱ɓa ga̱ Nya lish wu. Yek ta̱ ɓul lu gwe lishtisi wuli ɗe,<verse eid="LUK 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18" />&lt;&lt;Shishi ga̱ Nya ni ka̱ ami,</para>
  <para style="q2" vid="LUK 4:18">Nya botla̱n ɗe ta dla̱mi ga̱ɓa ma̱n ta̱mti ma̱jwe ba̱ ilgon nisi ɗa̱ sowu.</para>
  <para style="q1" vid="LUK 4:18">Ta̱ shina̱n ɗe ta hwi ma̱jwe ni ga̱ ɓali wu ɗe sa pa̱tlsi,</para>
  <para style="q2" vid="LUK 4:18">Dwa mago sa yen lu,</para>
  <para style="q1" vid="LUK 4:18">A ta yilli ma̱jwe ni ka̱ bomti da̱nti suk baboo jwasa̱n wu ka̱ pak,<verse eid="LUK 4:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="LUK 4:19" />Ta hwisi ɗe, gin gwe Nya a kis mbala̱n jwas wu tul wi.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:19 </char><char style="ft" closed="false">Yen</char><char style="xt"><ref loc="ISA 61:1">Ish 61:1</ref>,<ref loc="ISA 61:2">2</ref></char>.</note><verse eid="LUK 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20" />Yek ta̱ le lishtisi ka yek ta̱ ba̱l ma̱n da̱nti ka̱lu motgaami. Yek ta̱ da̱m na̱ zhila. Ma̱jwe ni ka̱lu motgaami jo yek sa̱ wutit gwel. <verse eid="LUK 4:20" /><verse number="21" style="v" sid="LUK 4:21" />Yek ta̱ wulsi ɗe, &lt;&lt;Ga̱ɓa gee da̱n ɗe gem malkii ase wi.&gt;&gt;<verse eid="LUK 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22" />Mas mbala̱n jwe ni ka̱li wu dla̱m hwa ga̱ɓa tenti. Yek ɓanti cisi ten ga̱ɓa gwe ta̱ dla̱m wu. Yek sa̱ wuli ɗe, &lt;&lt;Ɗa̱ nii ka̱n a pi nu gwi? Ko yen ga̱n go tik ɗe yen ga̱ Yusupu wu so?&gt;&gt;<verse eid="LUK 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23" />Yek Yesu wulsi ɗe, &lt;&lt;A yisi ɗe ka dla̱m ga̱ɓa tena̱n nu ɗe, &lt;Ma̱n ba̱lti ika̱n, ndok gaa gwa la.&gt; Ilgwe ka̱ lam dla̱mti go yek ɗe, &lt;Yek laki ɗe ba̱ka̱ pa̱l wul cit ɓanti ka ba̱n gwa na̱k gwe ka̱ pa̱li a Kaparnahum so ye?&gt; &gt;&gt;<verse eid="LUK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 4:24" />Yek Yesu po hwisi ɗe, &lt;&lt;Gem ka̱n, ma̱n dla̱mti ga̱ɓa ga̱ Nya a mbi nalti ka̱ ba̱n gwas so. <verse eid="LUK 4:24" /><verse number="25" style="v" sid="LUK 4:25" />Gem, guli modli ni ɗa̱ wonti ka̱ atl ga̱ Israila ka̱ gin gwe Iliya ma̱n dla̱mti ga̱ɓa ga̱ Nya ni ka̱ atli wu. Gin ɗe mekan na̱ tatlti tlo, ɗe ba̱ ze nda sowu, yek kuza̱n tlo mbala̱n mas ka̱ atl ga̱ Israila. <verse eid="LUK 4:25" /><verse number="26" style="v" sid="LUK 4:26" />Ama ba̱ Nya shin Iliya mal modli ju so. Yek ta̱ shinti mal guli kili gon a Zarepat ma̱n da̱nti ka̱ atl ga̱ Sidon. <verse eid="LUK 4:26" /><verse number="27" style="v" sid="LUK 4:27" />Sogo ɓo daama̱nki ten Ilisha ma̱n dla̱mti ga̱ɓa ga̱ Nya ma̱lgwe laki yek Naaman ndoki ɗa̱ka̱ cwo gita ka̱wu, a Naaman wo ma̱n Siriya ka̱n, a ma̱n cwo gita ni ɗa wonti ka̱ Israila jwe na̱ma lamti ndokti wu.&gt;&gt; <verse eid="LUK 4:27" /><verse number="28" style="v" sid="LUK 4:28" />Yek sa̱ kumi nu wugo, yek mbadl lili ma̱jwe ni ka̱lu motgaami wu. <verse eid="LUK 4:28" /><verse number="29" style="v" sid="LUK 4:29" />Yek sa̱ tlinya na̱ apti, yek sa̱ tol Yesu ten za̱nda̱l ba̱mi. Sa̱ na̱ma lamti ta̱s jekti sut ten za̱nda̱li. <verse eid="LUK 4:29" /><verse number="30" style="v" sid="LUK 4:30" />Yek Yesu yil ɗa̱ka̱ tlo gwasa̱n ka yek ta̱ zigaa.<verse eid="LUK 4:30" /></para>
  <para style="s">Yesu mbol ma̱zhe ɗa̱ka̱ ma̱lgon ka</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31" />Yek Yesu li Kaparnahum ba̱n gon ka̱ atl ga̱ Galili, yek ta̱ nisi ma ga̱ɓa ka̱lu motgaa gwasa̱n gas shukti. <verse eid="LUK 4:31" /><verse number="32" style="v" sid="LUK 4:32" />Ka̱ lwisi mago ɓanti ci mbala̱n ten ilgwe ta̱ dla̱m wu na̱k ɗe mas ga̱ɓa gwas wo kiɗi ga̱ɓa ka̱wu. <verse eid="LUK 4:32" /><verse number="33" style="v" sid="LUK 4:33" />A Yesu ni ka̱lu motgaa, yek ma̱n byas ma̱zhe gon njel tlilti yal nya ɗe, <verse eid="LUK 4:33" /><verse number="34" style="v" sid="LUK 4:34" />&lt;&lt;Tli ɗa̱ mal ni ka̱! Yek mo ni sukki ye, Yesu ga̱ ma̱n Nazarat? Ka̱ sa tlot ga̱na̱n kaa? A yisi, ki wo ma̱n cilti ka̱n gwe Nya shinti sut ɗu.&gt;&gt;<verse eid="LUK 4:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35" />Yek Yesu dla̱lla̱t ka, yek ta̱ wulti ɗe, &lt;&lt;Da̱m mbetlak!&gt;&gt; Yek ta̱ po wul ma̱zhesi ɗe, &lt;&lt;Yil ɗa̱ka̱ ti ka.&gt;&gt; Yek ma̱zhesi jek ma̱li a atli ka̱ tlo mbala̱n yek ta̱ yil ɗa̱ka̱ ma̱li ka kangwe ba̱ta̱ kumit cwo sowu.<verse eid="LUK 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36" />Yek ɓanti ci mbala̱n yek sa̱ wuli ɗe, &lt;&lt;Nda̱lti yek ni ga̱ɓa ga̱ ma̱lga̱n ɗa̱ nu ye, ɗe mas na̱ ma̱zhe mago asa̱ kum ga̱ɓa gwas wu?&gt;&gt; <verse eid="LUK 4:36" /><verse number="37" style="v" sid="LUK 4:37" />Yek ga̱ɓa ten ilgwe ta̱ pa̱li wu ma̱tl ɗa̱nka̱ ba̱mi ka.<verse eid="LUK 4:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38" />Yek Yesu yil ɗa̱ka̱ lu motgaa ga̱ gwasa̱n ka, yek ta̱ li lubii ɗa̱ Siman. <verse eid="LUK 4:38" /><verse number="39" style="v" sid="LUK 4:39" />Yek Yesu ngus malti yek ta̱ matl cwoɓi, yek cwoɓi zakti yek ta̱ tlinya ninge-ninge yek ta̱ njelisi pa̱lti wul.<verse eid="LUK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40" />Cin ɓal njaa ta̱ nda bii go yek wonti mbala̱n ma̱n cwo tul malti yek ta̱ ngusi za̱t ang gwas tensi asa̱ na̱ma ndokti, <verse eid="LUK 4:40" /><verse number="41" style="v" sid="LUK 4:41" />ma̱zhe mago sa̱ yil ɗa̱ka̱ mbala̱n ka wonti asa̱ na̱ma lakti yal asa̱ na̱ma wulti ɗe, &lt;&lt;Kik ɗe Yen ga̱ Nya.&gt;&gt; Yek ta̱ matlsi yek ba̱ta̱ zaksi ta̱s ga̱ɓa so na̱k ɗe sa̱ yisi ɗe tik ɗe Almasihu wu.<verse eid="LUK 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42" />Lu tlo wugo, yek Yesu li ka̱lu gon na̱ ngusi, a mbala̱mi na̱ma ta ngot gwasi yek sa̱ mbit wugo yek sa̱ wulti ɗe ba̱s zigaa ata̱ zaksi so. <verse eid="LUK 4:42" /><verse number="43" style="v" sid="LUK 4:43" />Ama yek ta̱ wule, &lt;&lt;Ngetli ka̱n nii ɗe ta dla̱m ga̱ɓa ma̱n ta̱mti ten kangwe mbala̱n a kan Nya ɗe guu ka̱ mbadl gwasa̱n wu, na̱k ɗe yek laki yek sa̱ shina̱n sut ɗu.&gt;&gt; <verse eid="LUK 4:43" /><verse number="44" style="v" sid="LUK 4:44" />Yek ta̱ ngusi dla̱mti ga̱ɓa ka̱lu motgaa ji Ma̱n Yehuda a Yehudiya.<verse eid="LUK 4:44" /></para>
  <chapter eid="LUK 4" />
  <chapter number="5" style="c" sid="LUK 5" />
  <para style="s">Yesu mbe ma̱n kopti jwas ji cina</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1" />Gas gon, Yesu na̱ma dla̱mti ga̱ɓa ga̱ Nya ten bi bal ze gon asa̱ mbe ɗe Jeneselet. Yek mbala̱n wonti da̱n njaa malti ta̱s kumti. <verse eid="LUK 5:1" /><verse number="2" style="v" sid="LUK 5:2" />Yek ta̱ yen jirgi ze jon ɗe lop jwe ba̱ ma̱lgon ni giɓi sowu ten bi bal zesi, ji ma̱n dopti kwesi, sa̱ wut ka̱li, asa̱ na̱ma polti wul dopti kwes gwasa̱n. <verse eid="LUK 5:2" /><verse number="3" style="v" sid="LUK 5:3" />Yek ta̱ te ka̱ jirgi zesi ga̱ Siman Biturus wu. Yek ta̱ ngem Siman Biturus ta̱s nak jek jirgi te ka̱ zesi ka̱. Yek ta̱ da̱m ka̱ jirgi zesi yek ta̱ nde hwit ga̱ɓa mbala̱n. <verse eid="LUK 5:3" /><verse number="4" style="v" sid="LUK 5:4" />Ta̱ pak ga̱ɓe wugo, yek ta̱ wul Siman Biturus ɗe, &lt;&lt;Nii go li ka̱lu gwe dlunti mani wu, aka̱ lak wul dopti kwes gwa ka̱ zesi, ka doɓi wonti.&gt;&gt;<verse eid="LUK 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5" />Yek Siman Biturus wule, &lt;&lt;Ma̱n lishti, ma̱ mul ten dipti ze a ba̱ma̱ dop ilgon so, ama na̱k ɗe ka̱ dla̱m nugo ma po lak wul dopti kwesi ka̱ zesi ɗa.&gt;&gt; <verse eid="LUK 5:5" /><verse number="6" style="v" sid="LUK 5:6" />Sa̱ lak wul dopti kwesi wugo, yek njika̱n ka na̱ kwesi hal ɓa nda keshti. <verse eid="LUK 5:6" /><verse number="7" style="v" sid="LUK 5:7" />Yek sa̱ mbe yilkeni jwasa̱n jwe ni te ka̱ zopsi jirgi gon ka̱wu ta̱s lak zisi ang. Yek sa̱ li teɗi yek sa̱ zisi ang, yek jirgi pak lop njika̱n ka na̱ kwesi na̱k wule a su ga̱s gaa ze.<verse eid="LUK 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 5:8" />Siman Biturus yen ilgwe na̱ma pa̱t wu wugo, yek ta̱ ngus na̱ gaa hwula̱n a cina ɗa̱ Yesu ka, yek ta̱ wule, &lt;&lt;Bagaa, a na̱ma ngemti gwa ta̱k zaka̱nni, ma̱n pa̱lti byas wul ka̱ɗe ami.&gt;&gt; <verse eid="LUK 5:8" /><verse number="9" style="v" sid="LUK 5:9" />Na̱ Siman Biturus na̱ ma̱jwe ni sukti wu yen kangwe sa̱ dop kwesi wugo yek ili ngusisi cit ɓanti. <verse eid="LUK 5:9" /><verse number="10" style="v" sid="LUK 5:10" />Yela̱n dopti kwes jwasi, ka̱ Yakubu suk Yohana mil ji Zabadi mago ili cisi ɓanti pak. Yek Yesu wul Siman Biturus ɗe, &lt;&lt;Ba̱ ɓanti cik so, ndok ase, mbala̱n ka̱n ka ngusi dopti gwasa̱n kwes ka po ni so.&gt;&gt; <verse eid="LUK 5:10" /><verse number="11" style="v" sid="LUK 5:11" />Sa̱ na̱ma yilti tot ten bi cikɗi, yek sa̱ zak mas wul jwasa̱n yek sa̱ kop Yesu.<verse eid="LUK 5:11" /></para>
  <para style="s">Yesu ndok ma̱n gita gon</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12" />Yesu ni ka̱ ba̱n gon nu go, yek ta̱ mo suk ma̱n bal cwo gita gon, yek ma̱li yen Yesu wugo, yek ta̱ ngus a cina ɗatka yek ta̱ ngusa̱l gaa gwas atli. Yek ta̱ ngem Yesu ɗe, &lt;&lt;Bagaa, kume ka̱ lami go aka̱ ndoka̱nni.&gt;&gt;<verse eid="LUK 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13" />Yek Yesu tak ang, yek ta̱ ta̱n ma̱li, yek ta̱ wulti ɗe, &lt;&lt;A lami wi, ndoki,&gt;&gt; na̱ dla̱mti nu, yek ma̱li ndoki.<verse eid="LUK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 5:14" />Yek Yesu wulti ɗe, &lt;&lt;Ba̱k hwi ma̱lgon so, ama li mal ma̱n Pa̱ris ta̱s yenki aka̱ ba̱lti ilgwe ta taki Nya wu, na̱k gwe ni ka̱ mba̱t ga̱ Musa wu. Na̱ nu ka̱n mas mbala̱n a yisi ɗe ka̱ ndoki wi.&gt;&gt;<verse eid="LUK 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15" />Mas na̱ ndwal ga̱ɓa gwe Yesu ba̱l ma̱li wu, yek ga̱ɓa tenti ngusi ma̱tlti ka̱ mbala̱n. Yek mbala̱n wonti ngusi la̱t tet malti ta̱s kumti, si mago ta̱s ndokti ɗa̱ka̱ cwo gwasa̱n ka. <verse eid="LUK 5:15" /><verse number="16" style="v" sid="LUK 5:16" />A Yesu kul yil ɗa̱ka̱ mbala̱n ka, ata̱ la ngem Nya ka̱ me.<verse eid="LUK 5:16" /></para>
  <para style="s">Yesu ndok ma̱lgwe tli tlet ka̱wu</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17" />Gas gon Yesu nima hwit ga̱ɓa mbala̱n ka̱ ba̱n gon, a ma̱n Paresi suk ma̱n yisti mba̱t ga̱ Musa jwe yil tet ka̱ atl ga̱ Galili suk Yehudiya suk tet ka̱ bal ba̱n Wurshelima wu ni na̱ zhila njaa ka̱li. A nda̱lti gwe Nya ba̱l Yesu ta̱s ndok mbala̱n wu ni tenti. <verse eid="LUK 5:17" /><verse number="18" style="v" sid="LUK 5:18" />Yek ma̱jon kan ma̱lgon ɗe asa̱n tlet ka̱wu ten lumulti, sa̱ na̱ma tlot gwasa̱n ta̱s telti gibboo ta̱s lakti atli a cina ɗa̱ Yesu ka. <verse eid="LUK 5:18" /><verse number="19" style="v" sid="LUK 5:19" />Yek ba̱sa̱ mbi tantu so na̱k ɗe mbala̱n wonti hwo wu. Sa̱ yeni nu wugo, yek sa̱ tolti ten gaa bii yek sa̱ ɓul gaa biimi yek sa̱ yilla̱t suɗi ten lumulti gwasi, yek sa̱ mulla̱t atli ka̱ tlo ga̱ mbala̱n a cina ɗa̱ Yesu ka. <verse eid="LUK 5:19" /><verse number="20" style="v" sid="LUK 5:20" />Yek Yesu yen za̱t mbadl ten Nya gwasa̱n wugo, yek ta̱ wul ma̱n cwoɓi ɗe, &lt;&lt;Sa̱ taas byas wul jwa ka̱wi.&gt;&gt;<verse eid="LUK 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21" />Yek ma̱n Paresi suk ma̱n yisti mba̱t ga̱ Musa ngusi nala̱nti ɗe, &lt;&lt;Wok ɗe ga̱n ɗe paa ta̱ dla̱m ga̱ɓa mbulti ga̱ Nya nu wo? Nya na̱ ngus ka̱ɗe ma̱n manti taasti byas wul ga̱ mbala̱n ka.&gt;&gt;<verse eid="LUK 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22" />Na̱k ɗe Yesu yis ilgwe sa̱ na̱ma daamti gwasa̱n dani wu, yek ta̱ wulsi ɗe, &lt;&lt;Yek laki ɗe ka̱ na̱ma daamti gwaka̱n nu ye? <verse eid="LUK 5:22" /><verse number="23" style="v" sid="LUK 5:23" />Gwik bom so mani gwi, na̱ ta̱ mbala̱n wule, &lt;Sa̱ taas byas wul jwa ka̱wi,&gt; sogo ta̱s wule &lt;Tlinya ta̱k zigaa?&gt; <verse eid="LUK 5:23" /><verse number="24" style="v" sid="LUK 5:24" />Ama ta̱k yisi ɗe ami Yen ga̱ Mbala̱n man taasti byas wul ji mbala̱n ka ten dii atli.&gt;&gt; Yek ta̱ wul ma̱lgwe asa̱mi tlet ka̱wi ɗe, &lt;&lt;Tlinya ta̱k kan lumulti gwa ta̱k li gee.&gt;&gt;<verse eid="LUK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 5:25" />Ninge yek ma̱li tlinya ten gwel ga̱ mbala̱n wonti yek ta̱ tlil lumulti gwasi yek ta̱ pal ga̱zi ata̱ na̱ma ta̱sti ga̱ Nya. <verse eid="LUK 5:25" /><verse number="26" style="v" sid="LUK 5:26" />Mas jwasa̱n yek sa̱ ngip bi ka̱ ang ɗe ɓanti ɓa cisi wu. Yek sa̱ ngusi ta̱sti ga̱ Nya asa̱ na̱ma wulti ɗe, &lt;&lt;Ase ka̱n ma̱ yen wul cit ɓanti.&gt;&gt;<verse eid="LUK 5:26" /></para>
  <para style="s">Yesu mbe Lawi</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27" />Kaal ɗa̱ nu, yek Yesu yil ɗa̱ka̱ ba̱n gwe ta̱ nima hwit ga̱ɓa mbala̱n wu ka, yek ta̱ yen ma̱n kanti wulpi boo gon asa̱ mbet ɗe Lawi.<note caller="+" style="f"><char style="fr" closed="false">5:27 </char><char style="ft" closed="false">Sogo</char><char style="fqa" closed="false">Matiyu</char></note> Ata̱ ni na̱ zhila ka̱lu kanti wulpi boomi. Yek Yesu wulti ɗe, &lt;&lt;Li te ta̱k koɓa̱nni.&gt;&gt; <verse eid="LUK 5:27" /><verse number="28" style="v" sid="LUK 5:28" />Yek ta̱ zak kanti wulpi boomi yek ta̱ kop Yesu. <verse eid="LUK 5:28" /><verse number="29" style="v" sid="LUK 5:29" />Yek Lawi mbe motgaa hwol tuki a lubii ɗatka ta̱ mbala̱n yen nalti ga̱ Yesu. Ma̱n kanti wulpi boo wonti suk ma̱jon asa̱ na̱ma ngukti wul suksi. <verse eid="LUK 5:29" /><verse number="30" style="v" sid="LUK 5:30" />Yek ma̱n Paresi suk ma̱n yisti mba̱t ga̱ Musa jon nda nala̱nti asa̱ na̱ma wulti ga̱ ma̱n kopti ji Yesu ɗe, &lt;&lt;Yek laki ɗe ka̱a̱ na̱ma ngukti aka̱a̱ na̱ma tlati suk ma̱n kanti wulpi boo suk ma̱n pa̱lti byas wul ye?&gt;&gt;<verse eid="LUK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31" />Yek Yesu wulsi ɗe, &lt;&lt;Ma̱jwe ba̱ cwo na̱ma cit gwasa̱n sogo, sa ngo ma̱n ika̱n so, se ma̱n cwo. <verse eid="LUK 5:31" /><verse number="32" style="v" sid="LUK 5:32" />A tul ɗe ta mbe ma̱n pa̱lti zok wul so, ama ma̱n pa̱lti byas wul ta̱s ci atl gaa mal Nya.&gt;&gt;<verse eid="LUK 5:32" /></para>
  <para style="s">Kumti ga̱zi ten ka̱lka̱ze ngemti Nya</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33" />Yek ma̱jon wul Yesu ɗe, &lt;&lt;Ma̱n kopti ji Yohana wo asa̱ pa̱l ka̱lka̱ze ngemti Nya nja-nja, mil lishti ji ma̱n Paresi mago nu. Ama ma̱n kopti jwa wo ba̱sa pa̱li nu so na̱k ɗe asa̱ nguk wul asa̱ tla ze mas cin wu.&gt;&gt;<verse eid="LUK 5:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34" />Yek Yesu ballisi ɗe, &lt;&lt;Ka̱ yeni go yela̱n ji pyal kos a pa̱l ka̱lka̱ze ngemti Nya a pyal kos yi suksi a? <verse eid="LUK 5:34" /><verse number="35" style="v" sid="LUK 5:35" />Ama gas gwe sa̱ kan pyal kos ka̱wu ka̱n sa̱ pa̱l ka̱lka̱ze ngemti Nya.&gt;&gt;<verse eid="LUK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36" />Yek Yesu mwesi ga̱ɓa gon ɗe, &lt;&lt;Mbala̱n a kesh pyal luka̱l ata̱ dla̱m ten gusi so. Kume ta̱ pa̱li nugo, ta kesh pyal luka̱l gwas ka. A ba̱ pyalisi a mbun ten gusi so. <verse eid="LUK 5:36" /><verse number="37" style="v" sid="LUK 5:37" />A ba̱ mbala̱n a shot pyal ze inabi ka̱ gus zwi kuul so ɗe kume ta̱ pa̱li nugo, gus zwi kuli a mbutl ka, a ze inabisi a shot ka, a zwi kuli mago a lilka. <verse eid="LUK 5:37" /><verse number="38" style="v" sid="LUK 5:38" />Pyal ze inabi wo ka̱ pyal zwi kuul ka̱n asa̱ shoti. <verse eid="LUK 5:38" /><verse number="39" style="v" sid="LUK 5:39" />A ba̱ mbala̱n a lam tlat pyal ze inabi kaal ɗa̱ ta̱ tla gusi wi so, ta wule, gusi wu ta̱m man pyali wu.&gt;&gt;<verse eid="LUK 5:39" /></para>
  <chapter eid="LUK 5" />
  <chapter number="6" style="c" sid="LUK 6" />
  <para style="s">Ga̱ɓa ten gas shukti</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1" />Gas shukti ga̱ Ma̱n Yehuda gon yek Yesu suk ma̱n kopti jwas koɓi tuka̱ zhin alkama gon yek sa̱ ngusi celti gaa alkame asa̱ na̱ma wumti asa̱ na̱ma ngukti. <verse eid="LUK 6:1" /><verse number="2" style="v" sid="LUK 6:2" />Yek ma̱n Paresi jon wulsi ɗe, &lt;&lt;Yek laki ɗe ka̱ na̱ma pa̱lti ilgwe ba̱ mbun ɗe ta̱ mbala̱n pa̱li gas shukti wu na̱k gwe ni ga̱ lishi ka̱ mba̱t ga̱ Musa so gwe?&gt;&gt; <verse eid="LUK 6:2" /><verse number="3" style="v" sid="LUK 6:3" />Yek Yesu ballisi ɗe, &lt;&lt;Ka̱ yisa̱n ilgwe Dauda pa̱li ɗe kuza̱n na̱ma tlot gwasi suk yela̱n jwas wu sa? <verse eid="LUK 6:3" /><verse number="4" style="v" sid="LUK 6:4" />Kangwe ɗe ta̱ te ka̱ bii ga̱ Nya yek ta̱ kan burodi gwe sa̱ zi ka̱ biimi wu, yek ta̱ nguki hal yek ta̱ ba̱l naami ma̱n kopti jwasi, gwe mbun ɗe ta̱ mbala̱n mas nguk sowu, se ma̱n da̱nti ka̱ biimi. Nu ka̱n mba̱t ga̱ Musa dla̱m pak.&gt;&gt; <verse eid="LUK 6:4" /><verse number="5" style="v" sid="LUK 6:5" />Yek Yesu po dla̱misi ɗa̱ɗe, &lt;&lt;Ami Yen ga̱ Mbala̱n wo, amik ɗe bagaa ga̱ gas shukti.&gt;&gt;<verse eid="LUK 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6" />Gas shukti ga̱ Ma̱n Yehuda gon ɗa, yek Yesu te ka̱lu motgaa ga̱ gwasa̱n ata̱ nisi ma ga̱ɓa, a ma̱lgon ni ka̱li ɗe ang shinti gwas tla ka̱wu. <verse eid="LUK 6:6" /><verse number="7" style="v" sid="LUK 6:7" />Yek ma̱n yisti mba̱t ga̱ Musa suk ma̱n Paresi wuti gwel Yesu ta̱s ɓo yeni, ko ta ɗakca̱n mba̱t ga̱ Musa ata̱ ndokti mbala̱n gas shukti, ta̱s mbi byas ilgon tenti. <verse eid="LUK 6:7" /><verse number="8" style="v" sid="LUK 6:8" />A Yesu yis ilgwe sa̱ na̱ma daamti gwasa̱n dani wu. Yek ta̱ wul ma̱li ɗe, &lt;&lt;Tlinya ta̱k dla̱l a nde,&gt;&gt; yek ma̱li tlinya yek ta̱ dla̱l a cina ɗaasika. <verse eid="LUK 6:8" /><verse number="9" style="v" sid="LUK 6:9" />Yek Yesu wulsi ɗe, &lt;&lt;A na̱ma ngemti gwaka̱n, cin pa̱lti byas wul ka̱ɗe ga̱n ma, ko ga̱ pa̱lti hwa wul, ta̱ yilli mbadl kaa ko ta̱ tlo mbadli?&gt;&gt; <verse eid="LUK 6:9" /><verse number="10" style="v" sid="LUK 6:10" />Yek ta̱ ngusi yenti gwasa̱n na̱m-na̱m, yek ta̱ wul ma̱li ɗe, &lt;&lt;Tak ang gwa,&gt;&gt; yek ta̱ tak ami go ndoki wi. <verse eid="LUK 6:10" /><verse number="11" style="v" sid="LUK 6:11" />Ten nu ka̱n yek mbadl lili ma̱n yisti mba̱t ga̱ Musa suk ma̱n Paresi i'e. Yek sa̱ nda ga̱ɓa ten ilgwe sa pa̱lit wu.<verse eid="LUK 6:11" /></para>
  <para style="s">Yesu botl ma̱n kopti jwas ɗe kutl cet lop</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12" />Ka̱ multi jwisi, yek Yesu to ten tla̱da̱l, ta̱s ngem Nya, yek ta̱ mul ten ngemti Nya. <verse eid="LUK 6:12" /><verse number="13" style="v" sid="LUK 6:13" />Yek lu tlo wugo, yek ta̱ mbe ma̱n kopti jwasi mas jwasa̱n. Yek ta̱ botl ɗe kutl cet lop ka̱si, yek ta̱ mbesi ɗe mil shinti ji botli. <verse eid="LUK 6:13" /><verse number="14" style="v" sid="LUK 6:14" />Ka̱ Siman gwe Yesu zit shin ɗe Biturus wu, suk yilka gwasi Andarawus, suk Yakubu suk Yohana suk Pilip suk Bartilomi <verse eid="LUK 6:14" /><verse number="15" style="v" sid="LUK 6:15" />suk Matta suk Tomas suk Yakubu yen ga̱ Halpa suk Siman gwe asa̱ mbet ɗe ma̱n lamti ji mbala̱n ga̱ atl gwas wu. <verse eid="LUK 6:15" /><verse number="16" style="v" sid="LUK 6:16" />Suk Yehuda yen ga̱ Yakubu suk Yehuda Iskariyoti ma̱lgwe ba̱l bi ga̱ Yesu ta̱s tlot wu. <verse eid="LUK 6:16" /><verse number="17" style="v" sid="LUK 6:17" />Yek Yesu yil sut ka̱ tla̱da̱l suk ma̱n kopti jwasi. Yek ta dla̱l ten bal dii atl gon suk mbala̱n wonti suk ma̱n kopti jwasi. Ka̱ lwisi mago a wonti mbala̱n tet ɗa̱nka̱ atl ga̱ Yehudiya suk Wurshelima suk tet ka̱ atl ga̱ Taya suk Sidon jwe ni ten bi bal ze wu ni ɗa. <verse eid="LUK 6:17" /><verse number="18" style="v" sid="LUK 6:18" />Sa̱ li tet ɗe ta̱s kumti asa̱ mbi ndokti ɗa̱ka̱ cwo gwasa̱n ka, ma̱jwe duu ma̱zhe dopsi mago yek sa̱ ndoki pak. <verse eid="LUK 6:18" /><verse number="19" style="v" sid="LUK 6:19" />Yek mas mbala̱n dlosi ɗe ta̱s ta̱nti na̱ ang na̱k ɗe nda̱lti na̱ma yilti tet tenti wu. Yek mas jwasa̱n sa̱ ndoki.<verse eid="LUK 6:19" /></para>
  <para style="s">Mbit hwa wul ga̱ Nya suk byasi</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20" />Yek Yesu yen ma̱n kopti jwasi, yek ta̱ wulsi ɗe, &lt;&lt;Kii wo ma̱n mbit hwa wul ga̱ Nya ka̱n kii ɗe ba̱ ilgon ni kii ɗa̱ sowu. Na̱ nu ka̱n Nya a da̱n ɗe guu ka̱ mbadl gwaka̱n. <verse eid="LUK 6:20" /><verse number="21" style="v" sid="LUK 6:21" />Kii wo ma̱n mbit hwa wul ga̱ Nya ka̱n kii ɗe kuza̱n na̱ma tlot gwaka̱n ninge wu, na̱ nu ka̱n gas gon wo a kumkii. Kii wo ma̱n mbit hwa wul ga̱ Nya ka̱n kii ɗe ka̱ na̱ma kulu ninge wu, na̱ nu ka̱n gasi gon wo ka gitli. <verse eid="LUK 6:21" /><verse number="22" style="v" sid="LUK 6:22" />Kii wo ma̱n mbit hwa wul ga̱ Nya ka̱n kii ɗe mbala̱n na̱ma nget gwaka̱n, yek sa̱ yilla̱kii ɗa̱ka̱ dlo gwasa̱n ka, asa̱ na̱ma byalti gwaka̱n, asa̱ na̱ma wulti gwaka̱n ɗe, &lt;Kii wo ma̱n byas mbadl ka̱n,&gt; na̱k ɗe ma̱n kopti ga̱ Yen ga̱ Mbala̱n ka̱ɗe kii wu. <verse eid="LUK 6:22" /><verse number="23" style="v" sid="LUK 6:23" />Pa̱la̱n hwol tuki aka̱ lak icin! Bal ɓatlti na̱ma ɓa̱tti gwaka̱n to nya ka. Daama̱n kangwe kolsi jwasa̱n pa̱li ma̱n dla̱mti ga̱ɓa ga̱ Nya tek wu. <verse eid="LUK 6:23" /><verse number="24" style="v" sid="LUK 6:24" />Ka da̱n ɗe wul cit gonti kii ɗe wul ni kii ɗa̱ wu, ninge ka̱ɗe hwol tuk gwaka̱n. <verse eid="LUK 6:24" /><verse number="25" style="v" sid="LUK 6:25" />Ka da̱n ɗe wul cit gonti kii ɗe kuza̱n na̱ma tlot gwaka̱n so ni wu, na̱ nu ka̱n kuza̱n a ya tlokii gas gon. Ka da̱n ɗe wul cit gonti kii ɗe ka̱ na̱ma gitlti ni wu, na̱ nu ka̱n ka ya lak pa̱l duu tuki aka̱ na̱ma kulu. <verse eid="LUK 6:25" /><verse number="26" style="v" sid="LUK 6:26" />Ka da̱n ɗe wul cit gonti kii ɗe mbala̱n na̱ma ta̱sti gwaka̱n wu. Nu ka̱n kolsi jwasa̱n ta̱s ma̱n shelti lal yisti ga̱ɓa ga̱ Nya pak.<verse eid="LUK 6:26" /></para>
  <para style="s">Lama̱n ma̱n nget gwaka̱n</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27" />&lt;&lt;A ni kii ma hwiti, kii ɗe ka̱ na̱ma kumti gi wu, lama̱n ma̱n nget gwaka̱n. A ka̱ pa̱lisi hwa wul. <verse eid="LUK 6:27" /><verse number="28" style="v" sid="LUK 6:28" />Pa̱li hwa wul ma̱n byalti jwaka̱n, aka̱a̱ ngemi Nya ma̱jwe pa̱likii ngalci wu. <verse eid="LUK 6:28" /><verse number="29" style="v" sid="LUK 6:29" />Kume ma̱lgon ɓek kalka̱ng ten ka̱t ang shinti wu, ballit ka̱t ang yali pak. A kume ma̱lgon lam wul yitlat gwa wu, ba̱lti luka̱l gwa pak. <verse eid="LUK 6:29" /><verse number="30" style="v" sid="LUK 6:30" />Mas ma̱lgwe ngemik wul go aka̱ ba̱lti. A ma̱lgwe kamit wul ka ngetli go ba̱k wule ta̱s pallik so. <verse eid="LUK 6:30" /><verse number="31" style="v" sid="LUK 6:31" />Pa̱li hwa wul mbala̱n na̱k gwe ka̱ lami ɗe ta̱s pa̱likii wu. <verse eid="LUK 6:31" /><verse number="32" style="v" sid="LUK 6:32" />Ɗe kume ma̱jwe lamkii wu ka̱n ka̱a̱ lamsi na̱ ngusa̱n go, ɗa̱ nii ka̱n ka mbi hwa wul gwi? Ma̱n pa̱lti byas wul mago sa̱ lam ma̱n lamti jwasa̱n. <verse eid="LUK 6:32" /><verse number="33" style="v" sid="LUK 6:33" />A kume ma̱jwe pa̱likii hwa wul ka̱n, aka̱a̱ pa̱lisi na̱ ngusa̱n go, yek hul dlo gwaka̱n suk ma̱n pa̱lti byas wul ye? Ma̱n pa̱lti byas wul mago asa̱ pa̱li nu. <verse eid="LUK 6:33" /><verse number="34" style="v" sid="LUK 6:34" />Ɗe kume ma̱jwe asa̱ ɓatlkii wu ka̱n ka ba̱lsi duul go, ɗa̱ nii ka̱n ka̱ mbi hwa wul gwi? Ma̱n pa̱lti byas wul mago asa̱ pa̱li yilkeni nu ta̱s ɓatlsi ɗa. <verse eid="LUK 6:34" /><verse number="35" style="v" sid="LUK 6:35" />Ama, kii wo lama̱n ma̱n nget gwaka̱n, aka̱a̱ pa̱lisi hwa wul. Ba̱lini a ba̱k za̱n mbadl palla̱ti so. Apaa ka̱a̱ mbi bal ɓatlti aka̱a̱ da̱n ɗe mil ji Nya Bal Kakshe. A ta̱ pa̱li hwa wul ma̱jwe ba̱sa pa̱l hwol tuk sowu suk ma̱n ngalci. <verse eid="LUK 6:35" /><verse number="36" style="v" sid="LUK 6:36" />Da̱ma̱n ɗe ma̱n yenti gonti ji mbala̱n na̱k kangwe Aba gwaka̱n ni ɗe ma̱n yenti gonti wu.<verse eid="LUK 6:36" /></para>
  <para style="s">Ba̱k lila̱n yilkeni ka̱ so</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37" />&lt;&lt;Ba̱k zi byas wul ma̱lgon so, kii mago sa zikii so pak. Ba̱k pa̱li byas da̱mti ma̱lgon so, kii mago ma̱lgon a pa̱likii so. Taasa̱n byas wul ji mbala̱n ɗa̱ ten mbadl ka, kii mago sa taas gwaka̱n ka. <verse eid="LUK 6:37" /><verse number="38" style="v" sid="LUK 6:38" />Ba̱lini, kii mago sa ba̱lkii. Gal ga̱ njikmi i'e, hal a ngusi shoti, hal a shoti ki naami ka̱ ang luka̱l, gal gwe ka̱a̱ cinga̱li na̱ nali go, kii mago na̱ nali ka̱n a cinga̱likii.&gt;&gt;<verse eid="LUK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39" />Yek Yesu hwisi ga̱ɓa gon ɗe, &lt;&lt;Ɗa̱ nii ka̱n dwa a nde dwa cina gwi? Kume pi nugo, mas jwasa̱n sa nda ka̱ shu. <verse eid="LUK 6:39" /><verse number="40" style="v" sid="LUK 6:40" />Yen lishti a nal man ma̱n lishti gwas so. Ama yen ma̱n lishti gwe pak lishti gwas wugo ta̱ da̱m na̱k ma̱n lishti gwasi. <verse eid="LUK 6:40" /><verse number="41" style="v" sid="LUK 6:41" />Ka̱ man yenti yen coklan ka̱ gwel ga̱ yilka gwa ama ba̱ka̱ man yenti guda̱l yencin gwe ni ka̱ gwel gwa wu so <verse eid="LUK 6:41" /><verse number="42" style="v" sid="LUK 6:42" />Ɗa̱ nii ka̱n kama̱n wulti ga̱ yilka gwa ɗe, &lt;Yilka gini, ha̱nta yillik yen coklan ga̱ ka̱ gwel wu ka,&gt; a yekgu go ba̱ka̱ man yenti ga̱ bal guda̱l yencin gwe ni ka̱ gweli gwa wu sowu? ki ma̱n pa̱lti riya, nda ndusti guda̱l yencin gwe nikka̱ gwel wu ka, kangwe ka man yenti lu i'e aka̱ ndusi nak coklan gwe ni ka̱ gwel ga̱ yilka gwa wu ka.<verse eid="LUK 6:42" /></para>
  <para style="s">Yisti tlindi ten yandi gwasi</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43" />&lt;&lt;Hwa tlindi wuta̱n byas yandi so aba̱ byas tlindi wut hwa yandi so. <verse eid="LUK 6:43" /><verse number="44" style="v" sid="LUK 6:44" />Tlindi wo ten yandi gwas ka̱n a mbala̱n yisi. Ka kotl tula̱n tet ten tlindi iil so, sogo yandi inabi tet ten tlindi tula̱n so. <verse eid="LUK 6:44" /><verse number="45" style="v" sid="LUK 6:45" />A hwa mbala̱n pa̱l hwa wul na̱k ɗe hwa wul ka nik ka mbadli wu, a byas mbala̱n wo byas wul ka̱n ata̱ pa̱li, na̱k ɗe byas wul ka̱ nit ka̱ mbadli wu. Ilgwe ni ka̱ mbadl go, yek ka̱n a bi dla̱mi.<verse eid="LUK 6:45" /></para>
  <para style="s">Lakti zhila kinti bii ten pa</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46" />&lt;&lt;Yek laki aka̱ mbe ɗe Bagaa ye? Ɗe ka̱ nge pa̱lti ilgwe a hwiki ɗe ta̱k pa̱li wu? <verse eid="LUK 6:46" /><verse number="47" style="v" sid="LUK 6:47" />Ma̱lgwe li tet mala̱nni yek ta̱ kati ka̱n yek ta̱ pa̱l ilgwe a hwit ɗe ta̱s pa̱li go, ba hwiki wunda̱l ga̱ ma̱li. <verse eid="LUK 6:47" /><verse number="48" style="v" sid="LUK 6:48" />Ta̱ ni na̱k ma̱lgwe ɗe ta̱ ɓa kin bii gwas go, yek ta̱ ɗuk atl dlunti, yek ta̱ lak zhila kinti biimi ten pa, yek dla̱lka njika̱n wugo, yek ze tak ɓo biimi, ama ba̱ nda so. Na̱k ɗe zhila biimi wo ten pa ka̱n ni wu. <verse eid="LUK 6:48" /><verse number="49" style="v" sid="LUK 6:49" />Mas ma̱lgwe kum ga̱ɓa gini a ba̱ta̱ pa̱l ilgwe a hwit ɗe ta̱s pa̱li wu sogo, na̱k ma̱lgwe ta̱ kin bii gwas ɗe ba̱ta̱ nda zhila biimi hwaɓi sowu ka̱n ta̱ ni, yek dla̱lka njika̱n wugo, yek ze ɓo biimi wugo yek pa̱l byas ndati.&gt;&gt;<verse eid="LUK 6:49" /></para>
  <chapter eid="LUK 6" />
  <chapter number="7" style="c" sid="LUK 7" />
  <para style="s">Yesu ndok zhel ga̱ bal ma̱n hapti tlo ga̱ ma̱n Roma gon</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1" />Yesu paki dla̱mti mas ga̱ɓe jwisi mbala̱n wugo, yek ta̱ li ka̱ ba̱n Kaparnahum. <verse eid="LUK 7:1" /><verse number="2" style="v" sid="LUK 7:2" />Yek zhel ga̱ bal ma̱n hapti tlo ga̱ ma̱n Roma gon ka̱wu na̱ cwo na̱k wule ta ma̱shinni, a ma̱n hapti dlomi lam zheli i'e. <verse eid="LUK 7:2" /><verse number="3" style="v" sid="LUK 7:3" />Ma̱n hapti dlomi kum bi ga̱ Yesu wugo, yek ta̱ shin kiɗi Ma̱n Yehuda jon ta̱s ngem Yesu ta̱s lak ndok zhel gwasi. <verse eid="LUK 7:3" /><verse number="4" style="v" sid="LUK 7:4" />Sa̱ li mal Yesu wugo, yek sa̱ ngemti i'e, yek sa̱ wulti ɗe, &lt;&lt;Mbun ɗe ta̱k ndok zhel ga̱ ma̱lga̱n, <verse eid="LUK 7:4" /><verse number="5" style="v" sid="LUK 7:5" />na̱k ɗe ta̱ lam mbala̱n jina̱n hal ta̱ kinini lu motgaa wu.&gt;&gt; <verse eid="LUK 7:5" /><verse number="6" style="v" sid="LUK 7:6" />Yek Yesu li suksi. Ta̱ ɓal njaa ta̱s mbuki lubiimi go, yek bal ma̱n hapti dlomi shin yela̱n jwasi ta̱s hwi Yesu ɗe, &lt;&lt;Ki wo ma̱n nalti ka̱n, ba̱k nol gaa gwa so, a mbuki ta̱k li tet lubii ɗaaka so. <verse eid="LUK 7:6" /><verse number="7" style="v" sid="LUK 7:7" />Yek laki yek baa mbuki ɗe ta li tet malki so. Ga̱ɓa ka̱li, zhel gi a ndoki. <verse eid="LUK 7:7" /><verse number="8" style="v" sid="LUK 7:8" />Ami mago a ang ɗa̱ ma̱lgwe nii cina wu ka̱n a ni, a ma̱n hapti tlo jon nii atl ɗaaka pak, aa kul wul ga̱n ɗe, &lt;Li ka̱lu gee,&gt; ata̱ li; aa po wul ga̱n ɗe, &lt;Li te,&gt; ata̱ li te. A kume a wul zhel gi ɗe, &lt;Pa̱li na̱k ga̱n wu,&gt; ata̱ pa̱li.&gt;&gt;<verse eid="LUK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9" />Yesu kumi nu wugo yek ta̱ ngip bi ka̱ ang, ɗe ta̱ yen za̱t mbadl ten Nya ga̱ ma̱li wu, yek ta̱ balla̱t mal mbala̱n jwe na̱ma kopti gwas wu, yek ta̱ wulsi ɗe, &lt;&lt;A ni kii ma hwiti, ka̱ ma̱n Yisiraila mago, a yen ma̱n za̱t mbadl ten Nya na̱ nda̱lti na̱k ga̱ ma̱lga̱n so.&gt;&gt; <verse eid="LUK 7:9" /><verse number="10" style="v" sid="LUK 7:10" />Ma̱jwe ma̱n hapti dlomi shinsi wu pal tek wugo yek sa̱ mbi go zhel ga̱ ma̱li ndoki wi.<verse eid="LUK 7:10" /></para>
  <para style="s">Yesu palli yen ga̱ guli kili gon gwe ma̱sh wu kaami</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11" />Ɓo la̱m da̱nti so, yek Yesu lika̱ nak'en ba̱n gon asa̱ mbe ɗe Nayin a ma̱n kopti jwas suk mbala̱n wonti na̱ma kopti gwasi. <verse eid="LUK 7:11" /><verse number="12" style="v" sid="LUK 7:12" />Sa̱ ɓal njaa ta̱s te ka̱ bi dlaboo ba̱mi go, yek ma̱jon ka̱wu na̱ hwuu ga̱ yen gon, a tik ɗe yen ga̱ kili gwe kos ma̱shit ka̱wu na̱ ngusi, a mbala̱n wonti na̱ma kopti gwasa̱n. <verse eid="LUK 7:12" /><verse number="13" style="v" sid="LUK 7:13" />Yek Yesu yen kilisi wugo, yek gonti gwas citi, yek ta̱ wulti ɗe, &lt;&lt;Po kul so.&gt;&gt; <verse eid="LUK 7:13" /><verse number="14" style="v" sid="LUK 7:14" />Yek Yesu lak ta̱n wul kanti hwuunisi na̱ ang yek ma̱jwe kan hwuunisi wu dla̱li, yek ta̱ wule, &lt;&lt;Yen mbala̱n, tlinya!&gt;&gt; <verse eid="LUK 7:14" /><verse number="15" style="v" sid="LUK 7:15" />Yek yeni tlinya yek ta̱ njel ga̱ɓa. Yek Yesu ba̱ltiti ana gwasi. <verse eid="LUK 7:15" /><verse number="16" style="v" sid="LUK 7:16" />Yek ɓanti ci mbala̱n mas jwasa̱n, yek sa̱ ba̱l nalti Nya asa̱ na̱ma wulti ɗe, &lt;&lt;Bal ma̱n dla̱mti ga̱ɓa ga̱ Nya tulini wi. Nya su suɗi ta̱s kis mbala̱n jwas wi.&gt;&gt; <verse eid="LUK 7:16" /><verse number="17" style="v" sid="LUK 7:17" />Yek ga̱ɓa ten ilgwe Yesu pa̱li wu ma̱tl ɗa̱nka̱ Yehudiya ka suk ba̱n jwe ni njaa wu.<verse eid="LUK 7:17" /></para>
  <para style="s">Ma̱n kopti ji Yohana ma̱n baptisma li mal Yesu</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18" />Ma̱n kopti ji Yohana ma̱n baptisma hwi Yohana mas wul jwe Yesu na̱ma pa̱lti wu wugo, yek ta̱ mbe ɗe lop ka̱si. <verse eid="LUK 7:18" /><verse number="19" style="v" sid="LUK 7:19" />Yek ta̱ shinsi mal Yesu ta̱s kum ga̱zi ɗe, &lt;&lt;Kik ɗe ma̱lgwe a tul gwa? Ko ta̱n ɓa̱tti ta̱ yi suɗi?&gt;&gt;<verse eid="LUK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20" />Sa̱ li mal Yesu wugo yek sa̱ wulti ɗe, &lt;&lt;Yohana ma̱n baptisma shinnii malki ta̱n kum ga̱zi ɗe, ko kik ɗe ma̱lgwe a tul wu? Ko ta̱n ɓa̱tti ta̱ yi suɗi?&gt;&gt;<verse eid="LUK 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21" />Sa̱ ni ka̱li nugo, yek Yesu ndok mbala̱n wonti ɗa̱ka̱ cwo jwasa̱n ka, yek ta̱ yilli ma̱zhe ɗa̱ka̱ mbala̱n ka, yek ta̱ ɓuli gwel dwa wonti. <verse eid="LUK 7:21" /><verse number="22" style="v" sid="LUK 7:22" />Yek Yesu hwi mil shinti ɗe, &lt;&lt;Lak hwi Yohana wul jwe ka̱a̱ kumi yek ka̱a̱ yeni wu, gwel ji dwa ɓuli, ma̱jwe man la̱t na̱ asa̱n sowu li na̱ asa̱n, ma̱n cwo gita ndoki, a ma̱jwe kum ka̱n sowu kum ka̱n, a ma̱jwe ma̱sh ju tli ɗa̱ka̱ ma̱shka̱n ka, ma̱jwe ba̱ ilgon nisi ɗa̱ sowu kum ga̱ɓa ga̱ Nya ma̱n ta̱mti. <verse eid="LUK 7:22" /><verse number="23" style="v" sid="LUK 7:23" />Nya a ba̱l hwa wul ma̱jwe zak za̱t mbadl tena̱n sowu.&gt;&gt;<verse eid="LUK 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24" />Kaal ɗa̱ za̱t gaa ga̱ ma̱n kopti ji Yohana, yek Yesu nde ga̱ɓa mbala̱mi tenti ɗe, &lt;&lt;Wok nii ka̱ la̱ɓ ɗe ka̱ la yenti gwas wo? Ko ma̱lgwe ni na̱k tlal me jwe yeta̱l na̱ma nwuti wu ka̱n ka̱ la yenti? <verse eid="LUK 7:24" /><verse number="25" style="v" sid="LUK 7:25" />Yek wok ka̱ la yenti gwas wo? Ma̱lgwe kinti na̱ hwa luka̱l gwa? Ma̱n lakti hwa luka̱l suk ma̱n da̱nti ta̱mti wo ɗa̱ guu ka̱n asa̱ ni. <verse eid="LUK 7:25" /><verse number="26" style="v" sid="LUK 7:26" />Yek wok ka̱ la yenti wo? Ma̱n dla̱mti ga̱ɓa ga̱ Nya ma? Nu ka̱n ni, ta̱ nal ma̱n dla̱mti ga̱ɓa ga̱ Nya pamma. <verse eid="LUK 7:26" /><verse number="27" style="v" sid="LUK 7:27" />Ti ka̱n ga̱ɓa ga̱ Nya dla̱m ɗe,</para>
  <para style="q1" vid="LUK 7:27">&lt;&lt;&lt;Yen shinti gi a tulik cina,</para>
  <para style="q2" vid="LUK 7:27">ma̱lgwe a la̱ka̱mik lu apaa ka̱ nda tulti wu.&gt;<verse eid="LUK 7:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="LUK 7:28" />A ni kii ma hwiti, mas mbala̱n za̱ti ga̱ modli, gon nal na̱k Yohana so, ama ma̱lgwe tik ɗe nak'eni ka̱ ma̱jwe kan Nya ɗe guu ka̱ mbadl gwasa̱n wu nal manti.&gt;&gt; <verse eid="LUK 7:28" /><verse number="29" style="v" sid="LUK 7:29" />Mas ma̱jwe kum ga̱ɓe wu, mas na̱ ma̱n kanti wulpi boo sa̱ kan ka̱ mbadl gwasa̱n ɗe, tantu ga̱ Nya wo gem ka̱n, na̱k ɗe Yohana pa̱lisi baptisma wu. <verse eid="LUK 7:29" /><verse number="30" style="v" sid="LUK 7:30" />Ama yek ma̱n Paresi suk ma̱n yisti mba̱t ga̱ Musa nge kopti ilgwe Nya lamisi kopti wu, na̱k ɗe sa̱ nge ta̱ Yohana pa̱lisi baptisma wu.<verse eid="LUK 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31" />Yek Yesu wule, &lt;&lt;Yek mbala̱n ten dii atl ninge ndaali ye? Ndakce suk yek sa̱ ni ye? <verse eid="LUK 7:31" /><verse number="32" style="v" sid="LUK 7:32" />Sa̱ ni ndakce suk mil mbala̱n jwe ni ka̱lu motgaa wu ɗe sa̱ wul yilkeni ɗe,</para>
  <para style="q1" vid="LUK 7:32">&lt;&lt;&lt;Ma̱ hotiki mba̱zhel, yek ka̱ nge dlalti,</para>
  <para style="q2" vid="LUK 7:32">ma̱ wul koo ma̱shka̱n yek ka̱ nge kulu.&gt;<verse eid="LUK 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 7:33" />&lt;&lt;Ɗe Yohana ma̱n baptisma tul go, a ba̱ta̱ nguk wul so, ba̱ta̱ tla ze inabi so, ama yek ka̱ wule, &lt;Ma̱n ma̱zhe ka̱ɗe ti.&gt; <verse eid="LUK 7:33" /><verse number="34" style="v" sid="LUK 7:34" />Yek ami Yen ga̱ Mbala̱n tuli, a na̱ma ngukti wul a na̱ma tlati yek ka̱ wule, &lt;Ɓo yena̱nti ta̱ nguk wul hwo ata̱ tla ze inabi i'e pak, yela̱n ji ma̱n kanti wulpi boo suk ma̱n pa̱lti byas wul.&gt; <verse eid="LUK 7:34" /><verse number="35" style="v" sid="LUK 7:35" />Mas na̱ nu go, ma̱jwe kan ɓotlka̱n gwe a Nya ba̱li wugo, sa̱ yisi ɗe ɓotlka̱mi wo gem ka̱n.&gt;&gt;<verse eid="LUK 7:35" /></para>
  <para style="s">Kili ma̱n pa̱lti byas wul gon pi mil Yesu</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36" />Yek ba Paresi gon asa̱ mbet ɗe Siman mbe Yesu ta̱s nguk wul a lubii ɗatka, yek Yesu li lubiimi yek ta̱ da̱n na̱ zhila ta̱s nguki. Nu ka̱n a Ma̱n Yehuda pa̱li, kumɗe sa̱ ɓa nguk wul go asa̱ tlalti asa̱n a atli. <verse eid="LUK 7:36" /><verse number="37" style="v" sid="LUK 7:37" />A kili gon ni ka̱ ba̱mi gwe pa̱l byas wul ka̱ da̱nti gwas wu. Yek ta̱ kumi ɗe Yesu na̱ma ngukti wul a lubii ɗa̱ ba Paresi wu ka, yek ta̱ kan bunta̱n mil gon teɗi na̱ mil ma̱n ta̱mi wusa̱n gwe asa̱ wul na̱ bal wulpi wu. <verse eid="LUK 7:37" /><verse number="38" style="v" sid="LUK 7:38" />Yek ta̱ lak dla̱l a malka̱n ɗa̱ Yesu ka, ata̱ na̱ma kulu, a luu gwas na̱ma lokti ten asa̱n ga̱ Yesu. Yek ta̱ taasi ka na̱ ma̱dla̱n gaa gwasi. Yek ta̱ ngusi swatti asa̱n ga̱ Yesu ata̱ na̱ma pa̱t mil dani. <verse eid="LUK 7:38" /><verse number="39" style="v" sid="LUK 7:39" />Yek ba Paresi wu yen ilgwe kili wu na̱ma pa̱lti wu wugo yek ta̱ wul ka̱ mbadl gwas ɗe, &lt;&lt;Ma̱lga̱n go, Nya ka shinti ɗe ma̱n dla̱mti ga̱ɓa gwas go ɗa ta yis wunda̱l kili gwe na̱ma ta̱nti gwas wu ɗe ma̱n pa̱lti byas wul ka̱n.&gt;&gt;<verse eid="LUK 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40" />Yek Yesu wul ba Paresisi ɗe, &lt;&lt;A lamik hwit ilgon.&gt;&gt;</para>
  <para style="p" vid="LUK 7:40">Yek ta̱ wulti ɗe, &lt;&lt;Hwini, ma̱n lishti.&gt;&gt;<verse eid="LUK 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41" />Yek Yesu wule, &lt;&lt;Ma̱lgon na̱ma kopti ji mbala̱n ɗe lop jon wulpi, gon wo ta̱ na̱ma kopti gwas wulpi gwe asa̱ ɓatl zhel ka̱ gin ɗe na̱m na̱ tatlti tlo wu, a gon wo ta̱ na̱ma kopti gwas wulpi gwe asa̱ ɓatl zhel ka̱ multi ɗe kutl ɗe namtan wu. <verse eid="LUK 7:41" /><verse number="42" style="v" sid="LUK 7:42" />Yek ba̱sa̱ ɓatl dani sogo, yek ta̱ zakisi mas jwasa̱n. Ka̱ yenti gwa wo gwik ka lamti mani gwi?&gt;&gt;<verse eid="LUK 7:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43" />Yek Siman wulti ɗe, &lt;&lt;Ka̱ yenti gi wo ma̱lgwe wulpi gwas wu nal mani wu.&gt;&gt; Yek Yesu wule, &lt;&lt;Gem ka̱n ka̱ dla̱mi.&gt;&gt; <verse eid="LUK 7:43" /><verse number="44" style="v" sid="LUK 7:44" />Yek ta̱ balla̱t mal kilisi yek ta̱ wul Siman ɗe, &lt;&lt;Ɓo yen kili gee, a te boo ɗakka ba̱ka̱ ba̱la̱n ze ta pol asa̱n gi so, ama yek ta̱ pol asa̱n gi ka na̱ luu gwasi yek ta̱ taasi ka na̱ ma̱dla̱n gaa gwasi. <verse eid="LUK 7:44" /><verse number="45" style="v" sid="LUK 7:45" />Na̱k a te boo ɗakka, ka̱ ga̱ɓe i'e so a ba̱ka ngiɓa̱n ni yek ka̱ wup kaal ka̱n gi so, ama na̱k a te teɗi yek kili ga̱n na̱ma ta wupti asa̱n gini. Pa̱lti ji Ma̱n Yehuda ka̱n kume sa̱ ɓa ga̱ɓe yilkeni go, asa̱ ngipsi te tlo ka asa̱ wup ga̱ska̱n gwasa̱n sogo ang gwasa̱n. <verse eid="LUK 7:45" /><verse number="46" style="v" sid="LUK 7:46" />Ka̱ pi mil ten gaa so, ama ti wo ta̱ na̱ma tuksa̱t mil ten asa̱n gini. <verse eid="LUK 7:46" /><verse number="47" style="v" sid="LUK 7:47" />Yek laki a nikma hwiti ɗe, wonti byas wul jwas jo mas a taasit ka̱wi na̱k ɗe ta̱ lama̱n i'e wu. Ma̱lgwe sa̱ taasit njet byas wul ka̱go, njet ka̱n ata̱ pa̱l lamti gwasi.&gt;&gt; <verse eid="LUK 7:47" /><verse number="48" style="v" sid="LUK 7:48" />Yek ta̱ wul kilisi ɗe, &lt;&lt;Sa̱ taas byas wul jwa ka̱wi.&gt;&gt;<verse eid="LUK 7:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49" />Yek ma̱nda̱ki jwe na̱ma ngukti wul suksi wu wul yilkeni ɗe, &lt;&lt;Wok ɗe ga̱n ɗe hal ata̱ taas byas wul ga̱ mbala̱n ka̱go?&gt;&gt;<verse eid="LUK 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50" />Yek Yesu wul kilisi ɗe, &lt;&lt;Za̱t mbadl ten Nya gwa kiski wi; zigaa na̱ ta̱mi mbadli.&gt;&gt;<verse eid="LUK 7:50" /></para>
  <chapter eid="LUK 7" />
  <chapter number="8" style="c" sid="LUK 8" />
  <para style="s">Modli jon kop Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1" />Nak la̱m da̱nti wugo, yek Yesu ma̱tl ɗa̱nka̱ kiɗi ba̱n ka suk nak mili ata̱ na̱ma dla̱mti ga̱ɓa ma̱n ta̱mti ten kangwe mbala̱n a kan Nya ɗe guu ka̱ mbadl gwasa̱n wu, a ma̱n kopti jwas ɗe kutl cet lop ju ni sukti. <verse eid="LUK 8:1" /><verse number="2" style="v" sid="LUK 8:2" />Suk modli jon jwe sa̱ yilli ma̱zhe ɗa̱ka̱si ka yek sa̱ ba̱lsi ndokti wu, ka̱ Maryam ma̱n Maga̱dala ma̱lgwe sa̱ yillit ma̱zhe ɗe nitgi ka̱wu, <verse eid="LUK 8:2" /><verse number="3" style="v" sid="LUK 8:3" />Suk Yuwana kili ga̱ Kuza gwe ata̱ pa̱li wul Hiridus guu wu, suk Suzana, suk modli wonti jwe na̱ma pa̱lti wul suk Yesu suk ma̱n kopti jwas ɗe kutl cet lop ju na̱ wul ang jwasa̱n wu.<verse eid="LUK 8:3" /></para>
  <para style="s">Cinga̱lti ga̱ɓa ten ma̱n zhin gwe cat wunda̱l wu</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4" />A mbala̱n na̱ma ta motgaa mal Yesu tet ka̱ ba̱n ɗa̱nka, yek Yesu wule, &lt;&lt;Ha̱nta ɓo hwikii ga̱ɓa gon. <verse eid="LUK 8:4" /><verse number="5" style="v" sid="LUK 8:5" />Ma̱lgon la catti wunda̱l ka̱ zhin gwasi, ta̱ na̱ma catti wuda̱li nugo, yek naami lok ten tantu yek mbala̱n koɓi dani yek yatl ɗakmi ka. <verse eid="LUK 8:5" /><verse number="6" style="v" sid="LUK 8:6" />Yek naami lok ka̱ gokca, yek te wugo yek lada̱l ka, na̱k ɗe ba̱ lwisi ni diki i'e sowu. <verse eid="LUK 8:6" /><verse number="7" style="v" sid="LUK 8:7" />Yek naami lok ka̱ iili, yek nal suk iili, yek iili ngap ka yek ba̱ kiɗi so. <verse eid="LUK 8:7" /><verse number="8" style="v" sid="LUK 8:8" />Yek naa wuda̱li jon lok ka̱ hwa lu yek sa̱ kiɗi, yek pa̱l gwe nal.&gt;&gt; Yesu pak ga̱ɓe wugo, yek ta̱ ga̱ɓa na̱ nda̱lti ɗe, &lt;&lt;Ma̱lgwe ka̱n kumti niɗɗa̱ go, ha̱n ta̱s kumi.&gt;&gt;<verse eid="LUK 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9" />Yek ma̱n kopti jwas ngemti ilgwe ta̱ lamisi dla̱mti ka̱ ga̱ɓe wu. <verse eid="LUK 8:9" /><verse number="10" style="v" sid="LUK 8:10" />Yek ta̱ wulsi ɗe, &lt;&lt;Kii wo sa̱ ba̱lkii yisti wul gwe ni ga̱ hwuda̱li ga̱ kangwe mbala̱n a kan Nya ɗe guu ka̱ mbadl gwasa̱n wu, ama naa mbala̱n wo, a hwisi ga̱ɓa ga̱ hwuda̱li kangwe, &lt;ko ta̱s yeni, sa man yenti so, ko ta̱s kumi, sa yis gaami so.&gt;<note caller="+" style="f"><char style="fr" closed="false">8:10 </char><char style="ft" closed="false">Yen <char style="xt"><ref loc="ISA 6:9">Ish 6:9</ref></char>.</char></note><verse eid="LUK 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11" />&lt;&lt;Ilgwe a lamikii dla̱mti go yek ɗe, wunda̱l go yek ɗe ga̱ɓa ga̱ Nya. <verse eid="LUK 8:11" /><verse number="12" style="v" sid="LUK 8:12" />Jwe lok ten tantu go sa̱ ni na̱k ma̱jwe kum ga̱ɓe yek Sheɗan kan ɗa̱ ten mbadl gwasa̱n ka, ba̱s zi mbadl gwasa̱n ten Nya asa̱ mbi kisti so. <verse eid="LUK 8:12" /><verse number="13" style="v" sid="LUK 8:13" />Wuda̱l jwe lok ka̱ gokca go sa̱ ni na̱k ma̱jwe kum ga̱ɓe yek sa̱ kan na̱ hwol tuki, ama yek ba̱ dlunti ka̱si so. Sa̱ ba̱l gem njet yek bomti tulisi wugo yek sa̱ pal na̱ kaali. <verse eid="LUK 8:13" /><verse number="14" style="v" sid="LUK 8:14" />Wuda̱l jwe lok ka̱ iil go sa̱ ni na̱k ma̱jwe kum ga̱ɓe ama yek da̱nti ga̱ se na̱ ayo suk lamti wul ji dii atli suk kumti ta̱mti da̱nti ngapsi yek ba̱ za̱t mbadl ten Nya gwasa̱n nda̱l so. <verse eid="LUK 8:14" /><verse number="15" style="v" sid="LUK 8:15" />A wunda̱l jwe lok ka̱ hwa lu go, sa̱ ni na̱k ma̱jwe kum ga̱ɓe wu, yek sa̱ ngiɓi ka̱ mbadl gwasa̱n yek sa̱ tlo mbadli yek za̱t mbadl ten Nya gwasa̱n nda̱li, yek sa̱ pa̱l hwa da̱nti.<verse eid="LUK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16" />&lt;&lt;Mbala̱n a lak wutu ten pitila ata̱ yitle ka na̱ ka̱sa̱l so, sogo ata̱ zi te ga̱s gobdlan ka̱ so, ama ta zi ten wul za̱ti kangwe mas ma̱n tet ka̱ biimi a yen cilti wu. <verse eid="LUK 8:16" /><verse number="17" style="v" sid="LUK 8:17" />Mas ilgwe ni ga̱ hwuda̱li go a yil deɓa̱l, a mas ilgwe ni ga̱ yitle go a ɓuli. <verse eid="LUK 8:17" /><verse number="18" style="v" sid="LUK 8:18" />Pa̱n ɗem'ɗem na̱ kangwe aka̱ kat ka̱n wu, na̱k ɗe ma̱lgwe ilgon niɗɗa̱ wu, sa mba̱lit dani, a ma̱lgwe ba̱ ilgon niɗɗa̱ sogo nak njeti gwe niɗɗa̱ wu mago sa kamit ka.&gt;&gt;<verse eid="LUK 8:18" /></para>
  <para style="s">Ana suk yilkeni ji Yesu tul malti</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19" />Yek ana suk yilkeni ji Yesu tul malti, ama yek ba̱sa̱ mbi mbukti lu malti so na̱k ɗe mbala̱n wonti hwo wu. <verse eid="LUK 8:19" /><verse number="20" style="v" sid="LUK 8:20" />Yek ma̱lgon wul Yesu ɗe, &lt;&lt;Ana gwa suk yilkeni jwa ni deɓa̱l sa̱ na̱ma lamti yenti gwa.&gt;&gt; <verse eid="LUK 8:20" /><verse number="21" style="v" sid="LUK 8:21" />Yek Yesu wulti ɗe, &lt;&lt;Ana gini suk yilkeni ji ka̱ɗe ma̱jwe kum ga̱ɓa ga̱ Nya yek sa̱ koɓi wu.&gt;&gt;<verse eid="LUK 8:21" /></para>
  <para style="s">Yesu dla̱lli yeta̱l ze ka</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22" />Gas gon yek Yesu wul ma̱n kopti jwas ɗe, &lt;&lt;Ma̱ la̱n te ten ka̱t bi cikɗi ga̱ tekgu ka.&gt;&gt; Yek sa̱ te ka̱ jirgi ze yek sa̱ njel la̱ti. <verse eid="LUK 8:22" /><verse number="23" style="v" sid="LUK 8:23" />Sa̱ na̱ma la̱t nugo, yek yeba̱l kan Yesu, yek bal yeta̱l gon tli tot ka̱ zesi, yek ɓanti dopsi na̱k ɗe zesi ɓalma tet ka̱ jirgi wu.<verse eid="LUK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 8:24" />Yek ma̱n kopti jwas pa̱da̱lti yek sa̱ wulti na̱ nda̱lti ɗe, &lt;&lt;Ma̱n lishti, tlinya ka, ma̱ ɓa lam ma̱shka̱n!&gt;&gt; Yek Yesu tlinya yek ta̱ matl yeta̱li suk ze gwe na̱ma tlit wu, yek zesi mul atli.<verse eid="LUK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 8:25" />Yek Yesu ngemsi ɗe, &lt;&lt;Za̱t mbadl gwaka̱n ɓal ko?&gt;&gt; Yek ɓanti cisi, yek sa̱ wul yilkeni ɗe, &lt;&lt;Wok ɗe ga̱n ɗe paa ata̱ matl yeta̱l suk ze gwe na̱ma tlit wu asa̱ kum ga̱ɓa gwas nu wo?&gt;&gt;<verse eid="LUK 8:25" /></para>
  <para style="s">Yesu ndok ma̱n ma̱zhe</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26" />Yek Yesu suk ma̱n kopti jwas ngusi la̱t ten ze yek sa̱ mbuki ten ka̱t atl ga̱ Garasina gwe ni ten ka̱t ang gon ga̱ zesi wu. <verse eid="LUK 8:26" /><verse number="27" style="v" sid="LUK 8:27" />Yek Yesu yil tot ten bi cikɗi wugo, yek ma̱n ma̱zhe gon ka̱wu koo tlisi gwe ata̱ da̱m ka̱lu gwe asa̱ lep mbala̱n wu, ata̱ mul wonti ka̱li wi. <verse eid="LUK 8:27" /><verse number="28" style="v" sid="LUK 8:28" />Na̱ yenti ga̱ Yesu, yek ta̱ nda a cina ɗatka yek ta̱ des lee, yek ta̱ wule, &lt;&lt;Yek moo sukki ye, Yesu, yen ga̱ Nya Bal Kakshe? A na̱ma ngemti gwa ba̱k nola̱n so.&gt;&gt; <verse eid="LUK 8:28" /><verse number="29" style="v" sid="LUK 8:29" />Ta̱ dla̱m nu ɗe ta̱ Yesu huulti suk ma̱zhesi. A ma̱zhesi kul ɓoti ko ɗe asa̱n suk ang gwas wo ga̱ ɓali ka̱n ni na̱ zaa ga̱lla wu, a ma̱n ɓa̱tti gwas ni malti ama ata̱ ɓatl ka a ma̱zhesi mbolti te ka̱ me ka.<verse eid="LUK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30" />Yek Yesu ngemti ɗe shin gwa ka̱ɗe wokko?</para>
  <para style="p" vid="LUK 8:30">Yek ta̱ wule, &lt;&lt;Wonti.&gt;&gt; Na̱k ɗe ma̱zhe jwe ni ka̱ti go wonti ka̱n sa̱ ni wu. <verse eid="LUK 8:30" /><verse number="31" style="v" sid="LUK 8:31" />Yek ma̱zhesi ngusi ngemti ga̱ Yesu ba̱s mbolsi te ka̱lu gwe sa da̱n ka̱ bomti wu so. <verse eid="LUK 8:31" /><verse number="32" style="v" sid="LUK 8:32" />A wonti alade jon na̱ma kyo ten za̱nda̱l njaa mal bal zesi, yek ma̱zhesi ngem Yesu ɗe ta̱s zaksi ta̱s te gipsi, yek ta̱ zaksi. <verse eid="LUK 8:32" /><verse number="33" style="v" sid="LUK 8:33" />Yek sa̱ yil ɗa̱ka̱ ma̱li ka yek sa̱ te ka̱ aladesi, yek aladesi tli na̱ apti yek sa̱ lok ka̱ bal zesi yek sa̱ ma̱shi.<verse eid="LUK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34" />Yek ma̱n kyo aladesi yeni nu wugo, yek sa̱ aɓi yek sa̱ lak hwi mbala̱n ɗa̱nka̱ ba̱n ka. <verse eid="LUK 8:34" /><verse number="35" style="v" sid="LUK 8:35" />Yek mbala̱mi yili ta̱s lak yen ilgwe pi wu, yek sa̱ li tet mal Yesu wugo, yek sa̱ yen ma̱lgwe ma̱zhe yil ɗa̱ka̱ ti ka̱wu njaa mal Yesu na̱ luka̱l ten tli ata̱ ɓal hwaɓi, yek ɓanti njel cit gwasa̱n. <verse eid="LUK 8:35" /><verse number="36" style="v" sid="LUK 8:36" />Yek ma̱jwe ni ka̱li ɗe ili pi wu, ngusi hwiti mbala̱n kangwe Yesu ndok ma̱li wu. <verse eid="LUK 8:36" /><verse number="37" style="v" sid="LUK 8:37" />Yek mas mbala̱n ka̱ atl ga̱ Garasina ngem Yesu ta̱s zak ba̱mi na̱k ɗe ɓanti cisi i'e wu. Yek Yesu ɓa te ka̱ jirgi ta̱s zigaa go, <verse eid="LUK 8:37" /><verse number="38" style="v" sid="LUK 8:38" />yek ma̱lgwe ta̱ yillit ma̱zhesi ka̱wu ngemti ɗe, &lt;&lt;Ba kopki,&gt;&gt; ama yek ba̱ Yesu zigaa sukti so. <verse eid="LUK 8:38" /><verse number="39" style="v" sid="LUK 8:39" />Yek Yesu wulti ɗe, &lt;&lt;Pal gee ta̱k dla̱m ilgwe Nya pa̱lik wu.&gt;&gt; Yek ma̱li li ka̱ bal ba̱mi yek ta̱ ngusi dla̱mti ilgwe Yesu pa̱lit wu.<verse eid="LUK 8:39" /></para>
  <para style="s">Yesu palli yen kili gon kaami</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40" />Yek Yesu pal te ten ka̱t bi bal ze gon wu ka̱wu yek mbala̱n wonti pa̱lit ɗem, na̱k ɗe ti ka̱n sa̱ na̱ma ɓa̱tti gwas wu. <verse eid="LUK 8:40" /><verse number="41" style="v" sid="LUK 8:41" />Yek ma̱lgon ka̱wu asa̱ mbet ɗe Yayirus, bali ka̱n ka̱lu motgaa ga̱ gwasa̱n, yek ta̱ lak ngus a cina ɗa̱ Yesu ka ata̱ na̱ma ngemti gwas ɗe ta̱s li tet lubii ɗatka. <verse eid="LUK 8:41" /><verse number="42" style="v" sid="LUK 8:42" />Yen gwas ɗe na̱m ga̱ ma̱dli ma̱n gin ɗe kutl cet lop ɓal njaa ta̱s ma̱shi. Yek Yesu ɓal ten tantu la̱t lubiimi go yek mbala̱n wonti ngusi kopti gwasi asa̱ na̱ma ɗamti njaa malti. <verse eid="LUK 8:42" /><verse number="43" style="v" sid="LUK 8:43" />A kili gon ni ka̱ mbala̱mi gwe pa̱l gin ɗe kutl cet lop a hwulan nitma shoti wu, a ba̱ta̱ mbi ma̱lgwe a ndokti wu so. <verse eid="LUK 8:43" /><verse number="44" style="v" sid="LUK 8:44" />Yek ta̱ te teka̱ mbala̱mi ka yek ta̱ li tukaal ɗa̱ Yesu ka yek ta̱ ta̱n bi luka̱l gwasi, ninge-ninge yek shoti hwulami tlo ang. <verse eid="LUK 8:44" /><verse number="45" style="v" sid="LUK 8:45" />Yek Yesu wule, &lt;&lt;Wok ta̱na̱n wo?&gt;&gt;</para>
  <para style="p" vid="LUK 8:45">Yek kokko wule tik so, yek Siman Biturus wule, &lt;&lt;Ma̱n lishti, mbala̱n wonti lakki tlo, asa̱ na̱ma ngapti gwa.&gt;&gt;<verse eid="LUK 8:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46" />Yek Yesu wule, &lt;&lt;Ma̱lgon ta̱na̱nni, a kum nda̱lti yil tet ka̱ ami.&gt;&gt; <verse eid="LUK 8:46" /><verse number="47" style="v" sid="LUK 8:47" />Yek kilisi yeni go sa̱ yisit lu ka̱wi, yek ta̱ yil teɗi a tli gwas na̱ma da̱dalti yek ta̱ lak ngus a cina ɗa̱ Yesu ka, yek ta̱ dla̱mit ilgwe laki ɗe ta̱ ta̱nti wu suk kangwe ta̱ mbi ndokti ka̱li wu a cina ɗa̱ mbala̱n mas. <verse eid="LUK 8:47" /><verse number="48" style="v" sid="LUK 8:48" />Yek Yesu wulti ɗe, &lt;&lt;Kili mbala̱n, za̱t mbadl ten Nya gwa ndokki wi, zigaa na̱ ta̱mi mbadli.&gt;&gt;<verse eid="LUK 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49" />A ba̱ Yesu ɓo pak ga̱ɓe so, yek yen shinti ka̱ ɓal wu tet lubii ɗa̱ Yayirus ka, yek ta̱ hwi Yayirus ɗe, &lt;&lt;Ba̱ ma̱n lishtisi po tlamba la̱t tet so, yeni ma̱sh wi.&gt;&gt; <verse eid="LUK 8:49" /><verse number="50" style="v" sid="LUK 8:50" />Yek Yesu kumi nu wugo, yek ta̱ wul Yayirus ɗe, &lt;&lt;Ba̱ ɓanti cik so, zi mbadl ɗe ta tli ɗa̱ka̱ ma̱shka̱n ka.&gt;&gt; <verse eid="LUK 8:50" /><verse number="51" style="v" sid="LUK 8:51" />Sa̱ mbuk lu lubiimi wugo, yek ba̱ta̱ zak ma̱lgon ta̱s te ka̱ biimi sukti so se Biturus suk Yohana suk Yakubu suk aba na̱ ana ga̱ yeni. <verse eid="LUK 8:51" /><verse number="52" style="v" sid="LUK 8:52" />Mas mbala̱n jwe ni ka̱ lubiimi go yek sa̱ pita kulu asa̱ na̱ma desti lee na̱ ma̱shka̱n ga̱ yen kilisi. Yek Yesu wulsi ɗe, &lt;&lt;Po kula̱n so, yen kilisi ɓo ma̱sh so, yeba̱l ka̱n ta̱ na̱ma ndeti.&gt;&gt; <verse eid="LUK 8:52" /><verse number="53" style="v" sid="LUK 8:53" />Yek sa̱ mboshu ka̱ ga̱ɓe yek sa̱ gitlti, na̱k ɗe sa̱ yisi ɗe ta̱ ma̱sh wu. <verse eid="LUK 8:53" /><verse number="54" style="v" sid="LUK 8:54" />Yek Yesu ngip ang ga̱ yeni, yek ta̱ ga̱ɓa na̱ nda̱lti ɗe, &lt;&lt;Yen mbala̱n, tlinya.&gt;&gt; <verse eid="LUK 8:54" /><verse number="55" style="v" sid="LUK 8:55" />Yek mbadl gwas palli, yek ta̱ tlinya ninge, yek Yesu wulsi ɗe ta̱s ba̱lti ilga̱ nguki. <verse eid="LUK 8:55" /><verse number="56" style="v" sid="LUK 8:56" />Yek ma̱n za̱t ga̱ yeni ngip bi ka̱ ang. Ama yek Yesu wulsi ɗe ba̱s hwi ma̱lgon so.<verse eid="LUK 8:56" /></para>
  <chapter eid="LUK 8" />
  <chapter number="9" style="c" sid="LUK 9" />
  <para style="s">Yesu shin ma̱n kopti jwas ɗe kutl cet lop</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1" />Yesu mo mil shinti ji botli jwas ɗe kutl cet lop wu, yek ta̱ ba̱lsi nda̱lti ta̱s yilli mas ma̱zhe ka suk ta̱s ndok mbala̱n ma̱n cwo wonti, <verse eid="LUK 9:1" /><verse number="2" style="v" sid="LUK 9:2" />yek ta̱ shinsi ta̱s dla̱misi ga̱ɓa ten kangwe mbala̱n a kan Nya ɗe guu ka̱ mbadl gwasa̱n wu a ta̱s ndok mbala̱n. <verse eid="LUK 9:2" /><verse number="3" style="v" sid="LUK 9:3" />Ta̱ wulsi ɗe, &lt;&lt;Ba̱k kama̱n ilgon ang so ɗe ka̱ɓa li wu, ba̱k kama̱n sada so, a ba̱k kama̱n ngura so, a ba̱k kama̱n ilga̱ nguki so, a ba̱k kama̱n wulpi so, a ba̱k kama̱n luka̱l ɗe lop so. <verse eid="LUK 9:3" /><verse number="4" style="v" sid="LUK 9:4" />Mas lubii gwe sa̱ kan ki wu, da̱ma̱n ka̱li, se gas gwe ka zigaa wu. <verse eid="LUK 9:4" /><verse number="5" style="v" sid="LUK 9:5" />Mas ba̱n gwe nge kanti gwaka̱n wu, ka̱ɓa zak ba̱mi go aka̱ bat kushka ga̱ ba̱mi ɗa̱ ten asa̱n gwaka̱n ka, yek ka da̱n ɗe ilgwe a daamisi ga̱ɓa gwe ka̱ hwisi wu.&gt;&gt; <verse eid="LUK 9:5" /><verse number="6" style="v" sid="LUK 9:6" />Yek sa̱ yili yek sa̱ ngusi tet ɗa̱nka̱ ba̱mi ka asa̱ na̱ma dla̱mti ga̱ɓa ga̱ Nya ma̱n ta̱mti asa̱ na̱ma ndokti ga̱ ma̱n cwo mas lu gwe sa̱ li wu.<verse eid="LUK 9:6" /></para>
  <para style="s">Mbadl ga̱ Hiridus guu hwot ka</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7" />Yek Hiridus guu kum ilgwe na̱ma pa̱t wu wugo yek ili hwotti i'e. Naa mbala̱n wule, Yohana ma̱n baptisma ka̱n Nya palla̱t na̱ mbadli. <verse eid="LUK 9:7" /><verse number="8" style="v" sid="LUK 9:8" />Naa mbala̱mi jon wule Iliya ka̱ palli. Naami wo sa̱ wule ɗe na̱m ka̱ ma̱n dla̱mti ga̱ɓa ga̱ Nya ji cina ka̱n Nya palla̱t kaami. <verse eid="LUK 9:8" /><verse number="9" style="v" sid="LUK 9:9" />Yek Hiridus wule, &lt;&lt;Yohana wo a laki yek sa̱ kotlit gaa ka̱wi, wok ɗe gwe a yima kumti wul wonti tenti go?&gt;&gt; Yek ta̱ ngwe ta̱s yenti.<verse eid="LUK 9:9" /></para>
  <para style="s">Yesu ba̱l ilga̱ nguki mbala̱n zamba̱l ɗe kutl ɗe namtan (5,000)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10" />Mil shinti ji botlisi pal wugo, yek sa̱ hwi Yesu ilgwe sa̱ pa̱li wu, yek ta̱ li ka̱ ba̱n gon asa̱ mbe ɗe Betsaida suk mil shinti jwasi na̱ ngusa̱n. <verse eid="LUK 9:10" /><verse number="11" style="v" sid="LUK 9:11" />Mbala̱n yeni nu wugo, yek sa̱ kopti wonti, yek ta̱ kan ma̱nda̱ki gwasa̱n yek ta̱ hwisi ga̱ɓa ten kangwe mbala̱n a kan Nya ɗe guu ka̱ mbadl gwasa̱n wu, yek ta̱ ndok ma̱n cwo. <verse eid="LUK 9:11" /><verse number="12" style="v" sid="LUK 9:12" />Cin ɓal njaa ta̱ nda bii go, yek ma̱n kopti ɗe kutl cet lop ju, li tet malti yek sa̱ wulti ɗe, &lt;&lt;Hwi mbala̱n jee ta̱s zigaa ta̱s lak ngo ilga̱ nguki suk lu gwe sa mul wu ɗa̱nka̱ ba̱n jwe ni njaa wu ka, a ɗee ɗe ma̱ na̱n go, a kansi so, aba̱ ilga̱ nguki ni ɗa̱ so.&gt;&gt; <verse eid="LUK 9:12" /><verse number="13" style="v" sid="LUK 9:13" />Yek Yesu wulsi ɗe, &lt;&lt;Ba̱la̱nsi ilga̱ nguki ci la,&gt;&gt; yek sa̱ wule, &lt;&lt;Burodi ɗe namtan suk kwes ɗe lop ka̱ nini ɗa, kume nuk go ta̱n lak wuli ilga̱ nguki mbala̱mi teɗi.&gt;&gt; <verse eid="LUK 9:13" /><verse number="14" style="v" sid="LUK 9:14" />Maani zamba̱l kutl ɗe namtan ka̱ ni ka̱li. Yek ta̱ wul ma̱n kopti jwas ɗe, &lt;&lt;Moosi kutl ɗe namtan-namtan asa̱ da̱m na̱ zhila.&gt;&gt; <verse eid="LUK 9:14" /><verse number="15" style="v" sid="LUK 9:15" />Yek sa̱ pa̱li nu, yek mas jwasa̱n sa̱ da̱m atli. <verse eid="LUK 9:15" /><verse number="16" style="v" sid="LUK 9:16" />Yek Yesu kan burodi ɗe namtan wu, yek ta̱ tlil gaa nya yek ta̱ pa̱l hwol tuk na̱ Nya, yek ta̱ cal burodisi yek ta̱ ba̱l ma̱n kopti jwasi yek sa̱ hwuli mbala̱mi. <verse eid="LUK 9:16" /><verse number="17" style="v" sid="LUK 9:17" />Yek sa̱ nguki yek kumsi yek sa̱ mo naami gwe sa wu hal njika̱n ga̱ɗa kutl cet lop.<verse eid="LUK 9:17" /></para>
  <para style="s">Biturus dla̱m ɗe Yesu ka̱ɗe Almasihu</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18" />Gas gon, Yesu na̱ma ngemti Nya na̱ ngusi yek ma̱n kopti jwas li tet malti yek ta̱ ngemsi ɗe, &lt;&lt;Mbala̱n wule wok ɗe ami wo?&gt;&gt; <verse eid="LUK 9:18" /><verse number="19" style="v" sid="LUK 9:19" />Yek sa̱ wulti ɗe, &lt;&lt;Mbala̱n wule Yohana ma̱n baptisma ka̱ɗe ki, naami wo sa̱ wule Iliya, a naami wo sa̱ wule ɗe na̱m ka̱ ma̱n dla̱mti ga̱ɓa ga̱ Nya ji cina ka̱n Nya palla̱t kaami wi.&gt;&gt; <verse eid="LUK 9:19" /><verse number="20" style="v" sid="LUK 9:20" />Yek ta̱ wulsi ɗe, &lt;&lt;A kii hwa? Ɗe wok ka̱a̱ yisa̱n wo?&gt;&gt; Yek Siman Biturus wulti ɗe, &lt;&lt;Kik ɗe Almasihu gwe Nya shinti sut wu.&gt;&gt; <verse eid="LUK 9:20" /><verse number="21" style="v" sid="LUK 9:21" />Yek Yesu hwisi ɗe ba̱s hwi ma̱lgon so. <verse eid="LUK 9:21" /><verse number="22" style="v" sid="LUK 9:22" />Yek ta̱ wulsi ɗe, &lt;&lt;Ngetli ka̱n ta̱ Yen ga̱ Mbala̱n tla bomti ten wul wonti, a kiɗi mbala̱n suk kiɗi ma̱n Pa̱ris suk ma̱n yisti mba̱t ga̱ Musa a ngeti, a mbala̱n a tloti. Ama ten ndat cin na̱ mekan wo Nya a palla̱t kaami.&gt;&gt; <verse eid="LUK 9:22" /><verse number="23" style="v" sid="LUK 9:23" />Yek ta̱ wul mbala̱mi mas jwasa̱n ɗe, &lt;&lt;Mas ma̱lgwe lam da̱nti ɗe ma̱n kopti gi go, se ta̱ nge gaa gwasi, ata̱ lam tet ka̱ bomti ten da̱nti ɗe ma̱n kopti gini ko gasi. <verse eid="LUK 9:23" /><verse number="24" style="v" sid="LUK 9:24" />Na̱ nu ka̱n mas ma̱lgwe lam gaa gwas man kopti gi go, ta mbi Nya boo so. Ama ma̱lgwe ba̱l gaa gwas ten kopti gi go, ta mbi Nya boo. <verse eid="LUK 9:24" /><verse number="25" style="v" sid="LUK 9:25" />Yek ɗe ta̱mti ga̱ mbala̱n ye, ɗe ta̱ mbi mas hwa wul ten dii atli a ba̱ta̱ mbi Nya boo sowu? <verse eid="LUK 9:25" /><verse number="26" style="v" sid="LUK 9:26" />Na̱ nu ka̱n mas ma̱lgwe nsha kopti gi citi suk ga̱ ga̱ɓa gi go, nsha yisti gwas a cinni ami Yen ga̱ Mbala̱n ɗe a pal sut na̱ nalti gini suk nalti ga̱ bal Aba gini suk ga̱ mil shinti ga̱ Nya ma̱n cilti wu. <verse eid="LUK 9:26" /><verse number="27" style="v" sid="LUK 9:27" />Gem ka̱n a ni kii ma hwiti ɗe ma̱jon ni ka̱ kii jwe sa ma̱sh so se sa̱ yen gas gwe Nya a da̱n ɗe guu ka̱ mbadl gwasa̱n wu.&gt;&gt;<verse eid="LUK 9:27" /></para>
  <para style="s">Balla̱t ga̱ Yesu</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28" />Kaal ɗa̱ multi ɗe wusupsi ɗe Yesu pak dla̱mti ga̱ɓa wu, yek ta̱ kan ka̱ Biturus suk Yohana suk Yakubu, yek ta̱ to ka̱ tla̱da̱l suksi ta̱s ngem Nya. <verse eid="LUK 9:28" /><verse number="29" style="v" sid="LUK 9:29" />Ta̱ ɓalma ngemti Nya go, yek cinagwel gwas balla̱ti, yek luka̱l gwas pal hwoli na̱ cilti hal na̱ma zhila̱kti gwel. <verse eid="LUK 9:29" /><verse number="30" style="v" sid="LUK 9:30" />Sa̱ ni nugo yek mbala̱n ɗe lop ka̱wu, ka̱ Musa suk Iliya <verse eid="LUK 9:30" /><verse number="31" style="v" sid="LUK 9:31" />ka̱ nalti ga̱ Nya asa̱ na̱ma ga̱ɓa sukti ten bi gas gwe ta pal to Nya ka̱wu suk ma̱shka̱n gwe ta ma̱sh a Wurshelima ta̱s njika̱n ilgwe Nya dla̱m wu. <verse eid="LUK 9:31" /><verse number="32" style="v" sid="LUK 9:32" />Biturus suk ma̱jwe ni sukti wu dlenti ka̱ yeba̱l wi, ama yek sa̱ pa̱da̱l wugo yek sa̱ yen nalti gwasi suk mbala̱n ɗe lop jwe ni sukti wu. <verse eid="LUK 9:32" /><verse number="33" style="v" sid="LUK 9:33" />Mbala̱n ɗe loɓi ɓa lam za̱tgaa go, yek Biturus wul Yesu ɗe, &lt;&lt;Ma̱n lishti, mbuni ɗe ma̱ na̱n a ɗee wu, ha̱n ta̱n pa̱likii mil bii ɗe mekan, gon wo gwa a gon wo ga̱ Musa a gon wo ga̱ Iliya.&gt;&gt; A ba̱ Biturus yis ilgwe ta̱ na̱ma dla̱mti wu so. <verse eid="LUK 9:33" /><verse number="34" style="v" sid="LUK 9:34" />Ta̱ na̱ma dla̱mti nugo, yek kaluntun yitlasi ka, yek ɓanti njel cit gwasa̱n. <verse eid="LUK 9:34" /><verse number="35" style="v" sid="LUK 9:35" />Yek ga̱ɓa wul sut ka̱ kaluntumi ɗe, &lt;&lt;Ga̱n go tik ɗe yen gi gwe a botlti wu, kuma̱n ga̱ɓa gwasi.&gt;&gt; <verse eid="LUK 9:35" /><verse number="36" style="v" sid="LUK 9:36" />Yek ga̱ɓe paki wugo, yek sa̱ yen Yesu na̱ ngusi. Yek ba̱sa̱ hwi ma̱lgon ilgwe pi wu ka̱ multi jwisi so se ka̱ kaali.<verse eid="LUK 9:36" /></para>
  <para style="s">Yesu ndok yen gon ma̱n ma̱zhe</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37" />Kaal ɗa̱ multi ɗe na̱m, yek sa̱ yil sut ɗa̱ka̱ tla̱nda̱li ka̱ wugo yek mbala̱n wonti mbi Yesu. <verse eid="LUK 9:37" /><verse number="38" style="v" sid="LUK 9:38" />Yek ma̱lgon ka̱ mbala̱mi wule, &lt;&lt;Ma̱n lishti, a na̱ma ngemti gwa ta̱k yen gonti ga̱ yen gini, tik ni ɗa na̱ ngusi. <verse eid="LUK 9:38" /><verse number="39" style="v" sid="LUK 9:39" />A ma̱zhe kul twet ka̱ gaa, ata̱ lak yal, a ma̱zhesi ɓot ten atli, a bi gwas yilli hwol ɓaka̱n. A ba̱ta zakti so se ta̱ kumit cwo na̱k wule ta tloti. <verse eid="LUK 9:39" /><verse number="40" style="v" sid="LUK 9:40" />Yek a ngem ma̱n kopti jwa ta̱s yilla̱si ka yek ba̱sa mani so.&gt;&gt; <verse eid="LUK 9:40" /><verse number="41" style="v" sid="LUK 9:41" />Yek Yesu wulsi ɗe, &lt;&lt;Kii mbala̱n ji se wo ka̱a̱ zi mbadl ten Nya so a ma̱n yokit ka̱ɗe kii, hal a gasi ka̱n ba da̱n sukkii a na̱ma tlot mbadl na̱ la̱shi za̱t mbadl gwaka̱n ten Nya gwi? Ta̱la yeni teɗi.&gt;&gt; <verse eid="LUK 9:41" /><verse number="42" style="v" sid="LUK 9:42" />Yeni ɓa li tet mal Yesu go yek ma̱zhesi ɓot ten atli. Yek Yesu matl ma̱zhesi, yek ta̱ ndok yeni, yek ta̱ ba̱ltiti aba gwasi. <verse eid="LUK 9:42" /><verse number="43" style="v" sid="LUK 9:43" />Yek ɓanti cisi, ɗe sa̱ yen nalti ga̱ Nya wu yek sa̱ ngip bi ka̱ ang.</para>
  <para style="s" vid="LUK 9:43">Yesu po dla̱m kangwe ta ma̱sh wu ɗa</para>
  <para style="p" vid="LUK 9:43">A sa̱ yima yenti wul cit ɓanti gwe Yesu pa̱li wu, yek ta̱ wul ma̱n kopti jwas ɗe, <verse eid="LUK 9:43" /><verse number="44" style="v" sid="LUK 9:44" />&lt;&lt;Ba̱k ma̱sa̱na̱n ilgwe ba hwikii wu so. Sa ba̱l bi gini ami Yen ga̱ Mbala̱n a ang ɗa̱ byas mbala̱n ka.&gt;&gt; <verse eid="LUK 9:44" /><verse number="45" style="v" sid="LUK 9:45" />Ama yek ba̱sa̱ yis ilgwe ta̱ nisi ma hwiti wu so, ga̱ hwuda̱li ka̱n ni malsi, a ɓanti kumti ga̱zi na̱ma cit gwasa̱n.<verse eid="LUK 9:45" /></para>
  <para style="s">Ga̱ɓa ten ma̱lgwe a da̱n ɗe bali wu</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46" />Yek ga̱ɓa nda ka̱ dlo ji ma̱n kopti ji Yesu ten ɗe wok ka da̱n ɗe bali ka̱si wo. <verse eid="LUK 9:46" /><verse number="47" style="v" sid="LUK 9:47" />Yek Yesu yis daamti gwasa̱n yek ta̱ kan nak'en yen gon yek ta̱ za̱t njaa malti. <verse eid="LUK 9:47" /><verse number="48" style="v" sid="LUK 9:48" />Yek ta̱ wulsi ɗe, &lt;&lt;Mas ma̱lgwe kan nak'en yen mbala̱n na̱k ga̱n ka̱ lal gi go, ami ka̱n ta̱ kama̱nni. A ma̱lgwe kama̱n go, ta̱ kan ma̱lgwe shina̱n sut wu. Ma̱lgwe tik ɗe nak'eni ka̱ kii mas go, tik ɗe bali.&gt;&gt;<verse eid="LUK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49" />Yek Yohana wul Yesu ɗe, &lt;&lt;Ma̱n lishti, ma̱ yen ma̱lgon ta̱ na̱ma yilla̱t ga̱ ma̱zhe ka ka̱ shin gwa, yek ma̱ hwit ɗe ta̱s zaki na̱k ɗe ba̱ta̱ ni ka̱ mi sowu.&gt;&gt; <verse eid="LUK 9:49" /><verse number="50" style="v" sid="LUK 9:50" />Yek Yesu wulsi ɗe, &lt;&lt;Zaka̱nti, ma̱jwe ngekii sogo gwaka̱n ka̱n.&gt;&gt;<verse eid="LUK 9:50" /></para>
  <para style="s">Mbala̱n ji ba̱n gon a Samariya nge Yesu</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51" />Ta̱ ɓal njaa ta̱s pal to Nya ka̱go yek ta̱ zi ka̱ mbadl gwas ɗe ta li Wurshelima. <verse eid="LUK 9:51" /><verse number="52" style="v" sid="LUK 9:52" />Yek ta̱ shin mil shinti cina ɗati ta̱s la̱ka̱misi lu ka̱ ba̱n Samariya gon. <verse eid="LUK 9:52" /><verse number="53" style="v" sid="LUK 9:53" />Yek ma̱n ba̱mi nge kanti ga̱ Yesu na̱k ɗe sa̱ yisi ɗe a Wurshelima ka̱n ta̱ lam sut wu. <verse eid="LUK 9:53" /><verse number="54" style="v" sid="LUK 9:54" />Ma̱n kopti jwasi ka̱ Yakubu suk Yohana yeni nu wugo, yek sa̱ wul Yesu ɗe, &lt;&lt;Bagaa, ka̱ lami ta̱n mbe wutu sut nya ta̱ kwelsi ka?&gt;&gt; <verse eid="LUK 9:54" /><verse number="55" style="v" sid="LUK 9:55" />Yek Yesu balla̱t malsi yek ta̱ matlsi. <verse eid="LUK 9:55" /><verse number="56" style="v" sid="LUK 9:56" />Yek sa̱ li ka̱ ba̱mi gon.<verse eid="LUK 9:56" /></para>
  <para style="s">Bomti kopti ga̱ Yesu</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57" />Sa̱ na̱ma la̱t ten tantu, yek ma̱lgon wul Yesu ɗe, &lt;&lt;Ba kopki mas lu gwe ka li wu.&gt;&gt; <verse eid="LUK 9:57" /><verse number="58" style="v" sid="LUK 9:58" />Yek Yesu wulti ɗe, &lt;&lt;Gwengwen wo shu da̱nti nisi ɗa, yatl mago lumulti nisi ɗa, ama ami Yen ga̱ Mbala̱n wo lumulti niɗɗa̱ so.&gt;&gt; <verse eid="LUK 9:58" /><verse number="59" style="v" sid="LUK 9:59" />Yek ta̱ po wul ma̱lgon ɗa̱ɗe, &lt;&lt;Koɓa̱nni.&gt;&gt; Yek ma̱li wulti ɗe, &lt;&lt;Bagaa, ha̱nta ɓa̱t ma̱shka̱n ga̱ aba gini aa lepti paa.&gt;&gt; <verse eid="LUK 9:59" /><verse number="60" style="v" sid="LUK 9:60" />Yek Yesu wulti ɗe, &lt;&lt;Zak ma̱jwe ma̱sh wu ta̱s lep yilkeni jwasa̱n, ama ki wo lak dla̱mi mbala̱n ga̱ɓa ten kangwe sa kan Nya ɗe guu ka̱ mbadl gwasa̱n wu.&gt;&gt; <verse eid="LUK 9:60" /><verse number="61" style="v" sid="LUK 9:61" />Yek ma̱lgon po wulti ɗa̱ɗe, &lt;&lt;Bagaa, ami wo ba kopki, ama ha̱nta lak palli bi a lubii paa.&gt;&gt; <verse eid="LUK 9:61" /><verse number="62" style="v" sid="LUK 9:62" />Yek Yesu wulti ɗe, &lt;&lt;Mas ma̱lgwe nda gut zhin na̱ gil tla ata̱ na̱ma celti gwel kaal go, ta man kanti ga̱ Nya ɗe guu ka̱ mbadl gwas so.&gt;&gt;<verse eid="LUK 9:62" /></para>
  <chapter eid="LUK 9" />
  <chapter number="10" style="c" sid="LUK 10" />
  <para style="s">Yesu shin mbala̱n ɗe kutl ɗe nitgi na̱ lop jon</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1" />Kaal ɗa̱ nugo yek Bagaa Yesu botl mbala̱n ɗe kutl ɗe nitgi na̱ lop jon yek ta shinsi lop-lop ka̱ ba̱n jwe ta̱ lam la̱t na̱ gaa gwas wu. <verse eid="LUK 10:1" /><verse number="2" style="v" sid="LUK 10:2" />Yek ta̱ wulsi ɗe, &lt;&lt;Zhimi nali, aba̱ ma̱n wotlti wonti so. Ngema̱n ma̱n zhimi, ta̱s shin ma̱n wotlti teɗi ta̱s wotli. <verse eid="LUK 10:2" /><verse number="3" style="v" sid="LUK 10:3" />La̱nni, a shinti, na̱k mil mba̱la ka̱ tlo ji hwuli. <verse eid="LUK 10:3" /><verse number="4" style="v" sid="LUK 10:4" />Ba̱k kama̱n wulpi ko ngura ko kapta̱lan ang so, a ba̱k da̱ma̱n ɗe ka ga̱ɓe ma̱lgon ten tantu so.<verse eid="LUK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 10:5" />&lt;&lt;Mas lubii gwe ka̱ te giɓi wu aka̱ wule, &lt;Ta̱mi mbadl ka̱ lubii gee.&gt; <verse eid="LUK 10:5" /><verse number="6" style="v" sid="LUK 10:6" />Kume ma̱n hwol tuk ni ka̱ lubiimi go hwol tuk gwaka̱n a da̱miti. A kume ma̱n hwol tuk ni ka̱ lubiimi sowu, ta̱mi mbadl gwaka̱n a pallikii. <verse eid="LUK 10:6" /><verse number="7" style="v" sid="LUK 10:7" />Da̱ma̱n ka̱ lubiimi aka̱ nguki aka̱ tla mas ilgwe sa̱ ba̱lkii wu na̱k ɗe ma̱lgwe pa̱l ilga̱ pa̱li go ta mbi ɓatlti gwasi wu. Ba̱k koɓa̱n lubii ɗa̱nka̱ so.<verse eid="LUK 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 10:8" />&lt;&lt;Kume ka̱a̱ te ka̱ ba̱n yek sa̱ pikii ɗem wu, nguka̱n mas ilgwe sa̱ ba̱lkii wu. <verse eid="LUK 10:8" /><verse number="9" style="v" sid="LUK 10:9" />Ndoka̱n ma̱n cwo ka̱ ba̱mi aka̱ hwisi ɗe, &lt;Cin gwe mbala̱n a kan Nya ɗe guu ka̱ mbadl gwasa̱n wu ɓal njaa malkii.&gt; <verse eid="LUK 10:9" /><verse number="10" style="v" sid="LUK 10:10" />Ama kume ka̱a̱ te ka̱ ba̱n yek ba̱sa̱ pikii ɗem sogo, aka̱ yil ɗa̱n ten tantu ba̱mi ka aka̱ wulsi ɗe, <verse eid="LUK 10:10" /><verse number="11" style="v" sid="LUK 10:11" />&lt;Kushka ga̱ ba̱n gwaka̱n mago ma bat ɗa̱ ten asa̱n ga̱na̱n ka̱wi. Ama ta̱k yisi ɗe cin gwe mbala̱n a kan Nya ɗe guu ka̱ mbadl gwasa̱n ɓal njaa malki.&gt; <verse eid="LUK 10:11" /><verse number="12" style="v" sid="LUK 10:12" />A ni kii ma hwiti ɗe, gas pakti ga̱ dii atl wo, Nya a yen gonti ga̱ ma̱n Sodom man ma̱n ba̱n wu.<verse eid="LUK 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13" />&lt;&lt;Ka̱a̱ da̱n ɗe wul cit gonti wi ma̱n Korazin suk Betsaida, wul cit ɓanti gwe sa̱ pa̱likii wu ka̱n sa pa̱li ma̱n Taya suk ma̱n Sidon go, sa ci atl gaa wi ba̱ sen so. Sa lak gus luka̱l asa̱ da̱n ka̱ mba̱tla̱l asa̱ daamsi ten byas wul jwe sa̱ pa̱li wu. <verse eid="LUK 10:13" /><verse number="14" style="v" sid="LUK 10:14" />Gas pakti ga̱ dii atl wo, Nya a yen gonti ga̱ ma̱n Taya suk Sidon mankii. <verse eid="LUK 10:14" /><verse number="15" style="v" sid="LUK 10:15" />Kii ma̱n Kaparnahum, ka̱ da̱ma̱n gwa we Nya a kankii to nya ka? Ko njaa! Nya a sulkii aka̱ da̱nti ga̱ ma̱n ma̱shka̱n.<note caller="+" style="f"><char style="fr" closed="false">10:15 </char><char style="ft" closed="false">Na̱ bi Giris sa̱ mbe ɗe </char><char style="fqa" closed="false">Hadis </char></note><verse eid="LUK 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16" />&lt;&lt;Mas ma̱lgwe kum ga̱ɓa gwaka̱n go ta̱ kumti ga̱ɓa gini wi, mas ma̱lgwe nge kumti ga̱ɓa gwaka̱n go ta̱ nge kumti ga̱ɓa gini, mas ma̱lgwe nge kumti ga̱ɓa gi go ta̱ nge Nya ma̱lgwe shina̱n wu.&gt;&gt;<verse eid="LUK 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17" />Yek mbala̱n ɗe kutl ɗe nitgi na̱ lop ju palli na̱ hwol tuki yek sa̱ wul Yesu ɗe, &lt;&lt;Bagaa, ma̱zhe mago asa̱ kum ga̱ɓa ga̱na̱n ɗe ma̱ hwisi ga̱ɓa ka̱ shin gwa wu.&gt;&gt;<verse eid="LUK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18" />Yek Yesu wulsi ɗe, &lt;&lt;A yen Sheɗan nda sut nya na̱k nyaze gwe ci bi sut nya wu. <verse eid="LUK 10:18" /><verse number="19" style="v" sid="LUK 10:19" />A ba̱lki nda̱lti gwe ka li ka̱ dlo ji wuci suk yenda̱l a ba̱sa pa̱likii ilgon sowu, aka̱ mani na̱ ma̱n nget gwaka̱n Sheɗan. <verse eid="LUK 10:19" /><verse number="20" style="v" sid="LUK 10:20" />Mas na̱ nu, ba̱k pa̱la̱n hwol tuk ɗe ma̱zhe kum ga̱ɓa gwaka̱n so, ama pa̱la̱n hwol tuk ɗe shin gwaka̱n ni ga̱ lishi a nya.&gt;&gt;<verse eid="LUK 10:20" /></para>
  <para style="s">Yesu pa̱l hwol tuk na̱ Nya</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21" />Ka̱ multi jwisi, yek Yesu njika̱n na̱ hwol tuk ga̱ Shishi ga̱ Nya yek ta̱ wule, &lt;&lt;A pa̱l hwol tuk na̱ ki, Aba gini, Bagaa ga̱ nya suk dii atli, ɗe ka̱ hwuda̱li mas wul ju ma̱n ɓotlka̱n suk ma̱n yisti wul, yek ka̱ ba̱l yisti nak mil mbala̱n wu. Nu ka̱n ni, Aba, ɗe mbuniki ta̱k pa̱li nu wu.<verse eid="LUK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22" />&lt;&lt;Aba gi ba̱la̱n wul mas. Ma̱lgon yis yeni wu so, se Abe na̱ ngusi. A ba̱ ma̱lgon yis Abe so se yeni suk ma̱jwe yeni lami ɗe ta̱ ba̱lsi yisti wu.&gt;&gt;<verse eid="LUK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23" />Yek Yesu balla̱t mal ma̱n kopti jwasi, yek ta̱ hwisi na̱ ngusa̱n ɗe, &lt;&lt;Kii wo ma̱n mbit hwa wul ka̱n ɗe gwel gwaka̱n yenikii ilgwe ka̱ yeni wu. <verse eid="LUK 10:23" /><verse number="24" style="v" sid="LUK 10:24" />A ni kii ma hwiti, ma̱n dla̱mti ga̱ɓa ga̱ Nya wonti suk guu lami ta̱s yen ilgwe ka̱ yeni, yek ba̱sa̱ yeni so, ta̱s kum ilgwe ka̱ kumi wu yek ba̱sa̱ kumi so.&gt;&gt;<verse eid="LUK 10:24" /></para>
  <para style="s">Cinga̱lti ga̱ɓa ten lamti ga̱ yela̱n da̱nti</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25" />Gas gon ma̱n yisti mba̱t ga̱ Musa gon tlinya ka̱ mbala̱n ta̱s cinga̱l yisti Yesu, yek ta̱ wulti ɗe, &lt;&lt;Ma̱n lishti, yek nii ngetli ɗe ta pa̱li a mbi Nya boo ye?&gt;&gt;<verse eid="LUK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26" />Yek Yesu ballit ɗe, &lt;&lt;Yek mba̱t ga̱ Musa dla̱m ye? Nii ka̱n ka̱ yisi gwi?&gt;&gt;<verse eid="LUK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27" />Yek ma̱li wule, &lt;&lt; &lt;Lam Bagaa Nya gwa na̱ mas mbadl gwa<note caller="+" style="f"><char style="fr" closed="false">10:27 </char><char style="ft" closed="false">Yen <char style="xt"><ref loc="DEU 6:5">K. M. 6:5</ref></char>.</char></note> na̱ mas yisti gwa na̱ mas nda̱lti gwa, aka̱ lam yela̱n da̱nti gwa na̱k gaa gwa.&gt;<note caller="+" style="f"><char style="fr" closed="false">10:27 </char><char style="ft" closed="false">Yen <char style="xt"><ref loc="LEV 19:18">Lib 19:18</ref></char>.</char></note> &gt;&gt;<verse eid="LUK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28" />Yek Yesu wule, &lt;&lt;Gem ka̱n ka̱ dla̱mi, ka̱ pa̱li nugo, ka mbi Nya boo.&gt;&gt; <verse eid="LUK 10:28" /><verse number="29" style="v" sid="LUK 10:29" />Yek ba̱ ma̱li lami ɗe ta̱ Yesu ngipti na̱ byas wul so, yek ta̱ wule, &lt;&lt;Wok ɗe yela̱n da̱nti gi wo?&gt;&gt;<verse eid="LUK 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30" />Yek Yesu hwisi ga̱ɓa gon yek ta̱ wule, &lt;&lt;Gas gon ma̱lgon yil sut Wurshelima ta su Jeriko, yek ta̱ mo suk kiɗi muka̱l ma̱n ɓa̱tti tantu. Yek sa̱ dopti, yek sa̱ ɓoti, yek sa̱ yemit wul ka, yek sa̱ zakti a atli na̱k hwuuni. <verse eid="LUK 10:30" /><verse number="31" style="v" sid="LUK 10:31" />Yek bal ma̱n Pa̱ris gon yil sut Wurshelima pak, yek ta̱ yen ma̱lgwe muka̱l dopti yek sa̱ ɓot wu, yek ta̱ tlat a malka̱n ɗatka yek ta̱ zigaa ilgon gwasi. <verse eid="LUK 10:31" /><verse number="32" style="v" sid="LUK 10:32" />Yek yen shinti ga̱ bal ma̱n da̱nti ka̱ bii ngemti Nyami koɓi tuka̱li pak yek ta̱ yenti a atli, yek ta̱ zigaa ilgon gwas pak. <verse eid="LUK 10:32" /><verse number="33" style="v" sid="LUK 10:33" />Ni nugo, yek ma̱lgon yil tot Samariya yek ta̱ yen ma̱li a atli yek gonti gwas citi. <verse eid="LUK 10:33" /><verse number="34" style="v" sid="LUK 10:34" />Yek ta̱ li tet malti yek ta̱ polit lu gwe sa̱ wotlti wu ka, yek ta̱ wutit ika̱n dani. Yek ta̱ kanti ten zhaki gwasi yek ta̱ ta̱lat ka̱lu multi ga̱ ma̱nda̱ki. <verse eid="LUK 10:34" /><verse number="35" style="v" sid="LUK 10:35" />Sa̱ mul ɗe na̱m wugo, yek ta̱ ba̱l wulpi ma̱n lubiimi. Yek ta̱ wulti ɗe, &lt;Yeni ma̱li gee, kume ka̱ tlo wulpi nal man gwe a ba̱lki wugo ba palliki ɗe a pal wu.&gt; &gt;&gt;<verse eid="LUK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36" />Yek Yesu ngem ma̱n yisti mba̱ti ɗe, &lt;&lt;Ka̱ mbala̱n ɗe mekan jo, wok ɗe yela̱n da̱nti ga̱ ma̱lgwe te ang ɗa̱ muka̱l go?&gt;&gt;<verse eid="LUK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37" />Yek ma̱li balli Yesu ɗe, &lt;&lt;Ma̱lgwe yen gonti ga̱ ma̱li wu.&gt;&gt; Yek Yesu wulti ɗe, &lt;&lt;Ki mago lak pa̱li nu.&gt;&gt;<verse eid="LUK 10:37" /></para>
  <para style="s">Yesu tul a lubii ɗa̱ Marta suk Maryam ka</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38" />Yesu suk ma̱n kopti jwas ni ten tantu Wurshelima yek sa̱ te ka̱ yen ba̱n gon gwe kili gon asa̱ mbet ɗe Marta kan ma̱nda̱ki gwasi a lubii ɗaat ka̱wu. <verse eid="LUK 10:38" /><verse number="39" style="v" sid="LUK 10:39" />A yilka gon ni Marta ɗa asa̱ mbet ɗe Maryam ma̱lgwe da̱m njaa mal Bagaa Yesu ata̱ na̱ma kumti ga̱ɓa gwas wu. <verse eid="LUK 10:39" /><verse number="40" style="v" sid="LUK 10:40" />Marta wo ta̱ na̱ma ta pa̱lti ilga̱ nguki, yek ta̱ li mal Yesu yek ta̱ wulti ɗe, &lt;&lt;Bagaa, ka̱ yen kangwe yilka gi zaka̱n na̱ ngwe ɗe a na̱ma pa̱lti mas wul wu sa, hwiti ta̱s lak zi ang.&gt;&gt;<verse eid="LUK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41" />Yek Bagaa Yesu wulti ɗe, &lt;&lt;Marta, mbadl gwa tli ten ga̱ɓa ga̱n, wul wonti na̱ma hwotti gwa. <verse eid="LUK 10:41" /><verse number="42" style="v" sid="LUK 10:42" />Wul ɗe na̱m ka̱n ka daamki dani. Maryam botl ilgwe mbun wu aba̱ ma̱lgon a kamit ka̱ so.&gt;&gt;<verse eid="LUK 10:42" /></para>
  <chapter eid="LUK 10" />
  <chapter number="11" style="c" sid="LUK 11" />
  <para style="s">Yesu dla̱m kangwe ma̱n kopti jwas a ngem Nya wu</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1" />Gas gon, Yesu na̱ma ngemti Nya ka̱lu gon. Ta̱ paki wugo, yek ɗe na̱m ka̱ ma̱n kopti jwas wulti ɗe, &lt;&lt;Bagaa, mbokinii ang ten kangwe ma ngem Nya wu, na̱k kangwe Yohana mboki ang ma̱n kopti jwas wu.&gt;&gt; <verse eid="LUK 11:1" /><verse number="2" style="v" sid="LUK 11:2" />Yek Yesu wulsi ɗe, &lt;&lt;Ka̱a̱ ɓa ngem Nya go aka̱ wule, &lt;Nya bal Aba, ta̱ nalli shin gwa ma̱n cilti, da̱m ɗe guu ka̱ mbala̱n mas ten dii atli. <verse eid="LUK 11:2" /><verse number="3" style="v" sid="LUK 11:3" />Ba̱lnii ilga̱ nguki ga̱ mas cin. <verse eid="LUK 11:3" /><verse number="4" style="v" sid="LUK 11:4" />A ka̱ taasini byas wul jina̱n ka na̱k gwe ama̱ taas ga̱ yilkeni ɗa̱ ten mbadl ga̱na̱n ka̱wu. Ba̱k zakni ta̱n pa̱l byas wul so.&gt; &gt;&gt;<verse eid="LUK 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5" />Yek Yesu po wul ma̱n kopti jwas ɗa̱ɗe, &lt;&lt;Wok nii ka̱ kii gwe ɗe ta li mal yela̱n da̱nti gwasi ka̱ tlo gasi ata̱ ngemit duul burodi ɗe mekan, yek ta̱ wulti ɗe, <verse eid="LUK 11:5" /><verse number="6" style="v" sid="LUK 11:6" />&lt;Yekgu yela̱n gon gi tul mala̱nni tet ka̱lu gon, aba̱ ilga̱ nguki gwe ba ba̱lti wu ni ɗa̱ so.&gt;<verse eid="LUK 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 11:7" />&lt;&lt;A paa yela̱n da̱nti gwe ta̱ la ngot burodi malti wu wul tet punka ɗe, &lt;Ba̱k hwota̱n so, ma̱ le dlabii ga̱na̱n ka̱wi, ma̱ mul atl wi suk mil jini bama̱n tlat nya a ba̱lki ilgon so.&gt; <verse eid="LUK 11:7" /><verse number="8" style="v" sid="LUK 11:8" />A ni kii ma hwiti ɗe ta tlinya ata̱ ba̱lti ilgon ten ɗe ti wo yela̱n da̱nti gwas so, ama na̱k ɗe ta̱ ngaɓit na̱k ngemti wu ta tlinya ata̱ ba̱lti mas ilgwe ta̱ lami wu.<verse eid="LUK 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9" />&lt;&lt;A ni kii ma hwiti ɗa̱ɗe, pa̱nta ngemti, Nya a ba̱lkii. Pa̱nta ngoti, ka mbi. Pa̱nta kotlti dlabiimi, Nya a ɓulikii. <verse eid="LUK 11:9" /><verse number="10" style="v" sid="LUK 11:10" />Mas ma̱lgwe ngemi go, Nya a ba̱lti. Ma̱lgwe ngwe go, ta mbi. Ma̱lgwe ɓo dlabiimi go, Nya a ɓuliti.<verse eid="LUK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 11:11" />&lt;&lt;Wok yen gwas a ngemit kwes ka̱ kii, ata̱ ba̱lti wuci wo? <verse eid="LUK 11:11" /><verse number="12" style="v" sid="LUK 11:12" />Sogo, ta̱ yen gwas ngemit mbutli, ata̱ ba̱lti yenda̱l wo? <verse eid="LUK 11:12" /><verse number="13" style="v" sid="LUK 11:13" />Kume kii ma̱n pa̱lti byas wul yek ka̱ yis kangwe ka ba̱l hwa wul mil jwaka̱n go, ɗa̱ nii ka̱n a kan bal Aba ga̱na̱n ga̱ to nya ka̱wu gaa gwi, ti ɗe ta ba̱l Shishi ga̱ Nya ma̱jwe ngemti wu.&gt;&gt;<verse eid="LUK 11:13" /></para>
  <para style="s">Yesu mbol guu ma̱zhe</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14" />Gas gon Yesu na̱ma yilla̱t ga̱ ma̱zhe gwe ba̱ta ga̱ɓa sowu ɗa̱ka̱ ma̱lgon ka. Yek ma̱zhesi yil ka̱ wugo, yek ma̱li ga̱ɓa yek ɓanti ci mbala̱n. <verse eid="LUK 11:14" /><verse number="15" style="v" sid="LUK 11:15" />Yek naa mbala̱mi wule, &lt;&lt;Guu ga̱ ma̱zhe ka̱ ba̱lti nda̱lti yilla̱t ma̱zhe ka.&gt;&gt; <verse eid="LUK 11:15" /><verse number="16" style="v" sid="LUK 11:16" />Naa mbala̱mi jon lami ta̱s yen ilgwe ta pa̱li wu, yek sa̱ wulti ɗe, &lt;&lt;Pa̱lini wul cit ɓanti, ta̱n yisi ɗe sut mal nya ka̱n ka̱ ni.&gt;&gt;<verse eid="LUK 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 11:17" />Yek Yesu yis daamti gwasa̱n wugo yek ta̱ wulsi ɗe, &lt;&lt;Kume mbala̱n ka̱ ba̱n ɗe na̱m dlansi ten tli gwasa̱n go, ba̱mi a dla̱l so, nu ka̱n mas lubii gwe calti ɗe lop asa̱ na̱ma nget ji yilkeni go lubiimi a nda. <verse eid="LUK 11:17" /><verse number="18" style="v" sid="LUK 11:18" />Kume Sheɗan calti ɗe lop ata̱ na̱ma nget ga̱ gaa gwas go, nii ka̱n nalti gwas a dla̱l gwi? Ka̱a̱ wule, na̱ nda̱lti ga̱ guu ma̱zhe ka̱n a na̱ma yilla̱t ga̱ ma̱zhe ka. <verse eid="LUK 11:18" /><verse number="19" style="v" sid="LUK 11:19" />Kume ka̱ wule, na̱ nda̱lti ga̱ guu ma̱zhe ka̱n a na̱ma yilla̱t ma̱zhe ka̱go, a kii hwa, na̱ nda̱lti ga̱ wok aka̱ yilli ma̱zhesi ka̱ wo? <verse eid="LUK 11:19" /><verse number="20" style="v" sid="LUK 11:20" />Ama kume na̱ nda̱lti ga̱ Nya ka̱n a na̱ma yilla̱t ga̱ ma̱zhe ka̱go, cin gwe mbala̱n a kan Nya ɗe guu ka̱ mbadl gwasa̱n wu ɓa tuli.<verse eid="LUK 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21" />&lt;&lt;Kume nda̱li mbala̱n na̱ buula gwas da̱n na̱ ka̱n gaa ten ɓa̱t boo gwas go, ilgon a ta̱n wul lubii gwas so. <verse eid="LUK 11:21" /><verse number="22" style="v" sid="LUK 11:22" />Ama kume ma̱lgwe nda̱l manti wu tuli, yek ta̱ ndat na̱ dlanti, yek ta̱ man ngetl gwas go ta yem mas buula jwas jwe ta̱ nda̱l giɓi wu ka, ata̱ hwuli mbala̱n mas wul jwasi.<verse eid="LUK 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23" />&lt;&lt;Ma̱lgwe ni suk ami sogo, nget ka̱n ta̱ na̱ma nget gini; ma̱lgwe na̱ma mooti suk ami sogo, ta̱ na̱ma catti ka. <verse eid="LUK 11:23" /><verse number="24" style="v" sid="LUK 11:24" />A kume duu ma̱zhe yil ɗa̱ka̱ tli ga̱ mbala̱n ka̱ wu, ata̱ ngusi ma̱tlti ɗa̱nka̱ me ka ka̱lu gwe ba̱ ze ni ɗa̱ sowu ta̱s mbi lu shukti. Kume ta̱ mbi sowu, apaa ta̱ wule, &lt;Ha̱n ta̱ pal te ka̱ ma̱lgwe a yil tet wu ka.&gt; <verse eid="LUK 11:24" /><verse number="25" style="v" sid="LUK 11:25" />Kume ta̱ lak mbi mbadl ma̱li sa̱ taasi ka yek sa̱ la̱ka̱mi ka̱ wu, <verse eid="LUK 11:25" /><verse number="26" style="v" sid="LUK 11:26" />ata̱ lak yem ma̱zhesi jon teɗi ɗe nitgi jwe yoki manti wu ta̱s lak da̱n ka̱li. Pakti da̱nti ga̱ ma̱llu a lil man kangwe ta̱ nda zhile wu.&gt;&gt;<verse eid="LUK 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27" />Yesu dla̱m nu wugo, yek kili gon wulti na̱ nda̱lti ɗe, &lt;&lt;Ta Nya ba̱l hwa wul kili gwe zaki yek ta̱ ngipki yek ka̱ nal wu.&gt;&gt;<verse eid="LUK 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28" />Yek Yesu wulti ɗe, &lt;&lt;Nu ka̱n ni, ama ma̱jwe kum ga̱ɓa ga̱ Nya yek sa̱ koɓi wu mbi hwa wul mani.&gt;&gt;<verse eid="LUK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29" />Mbala̱n ngusi mba̱lti wonta̱t mal Yesu wu, yek ta̱ nda wulti gwasa̱n ɗe, &lt;&lt;Mbala̱n ji se wo byas mbala̱n ka̱n, lamti gwasa̱n wo ta̱ pa̱lisi wul cit ɓanti ama ba̱sa yeni so se ga̱ Yona wu. <verse eid="LUK 11:29" /><verse number="30" style="v" sid="LUK 11:30" />Na̱k gwe Yona da̱n ɗe wul cit ɓanti mal ma̱n Neniba wu, nu ka̱n ami Yen ga̱ Mbala̱n a da̱mi mbala̱n ji se. <verse eid="LUK 11:30" /><verse number="31" style="v" sid="LUK 11:31" />Gas pakti ga̱ dii atl wo, guu ga̱ ma̱dli tet Sheba a kudu a tlinya suk mbala̱n ji se, ata̱ hwisi ɗe sa̱ pa̱l hwa wul so. Ta̱ tul tet dlenti ta̱s kum ga̱ɓa ɓotlka̱n ga̱ guu Sulemanu, yek ma̱lgwe man Sulemanu wuk ɓal wu. <verse eid="LUK 11:31" /><verse number="32" style="v" sid="LUK 11:32" />Gas pakti ga̱ dii atl wo, ma̱n Neniba a tlinya suk mbala̱n ji se asa̱ hwisi ɗe sa pa̱l hwa wul so na̱k ɗe si wo sa̱ ci atl gaa ɗe Yona hwisi ga̱ɓa ga̱ Nya wu, a yekgu ma̱lgwe man Yona wuk ɓal wu.<verse eid="LUK 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33" />&lt;&lt;Mbala̱n a lak wutu ten pitila ata̱ hwuda̱li ka̱ so, sogo ata̱ yitle ka na̱ gal so, ama ta zi ka̱lu gwe mas ma̱lgwe te ka̱ biimi wu a yen cilti wu. <verse eid="LUK 11:33" /><verse number="34" style="v" sid="LUK 11:34" />Gwel ka̱ɗe cilti ga̱ tli, kume gwel gwa ni hwaɓi wu, tli gwa ani na̱ cilti, ama kume gwel gwa ni hwaɓi sogo, mas tli gwa ani ka̱ da̱mshal. <verse eid="LUK 11:34" /><verse number="35" style="v" sid="LUK 11:35" />Pa̱n ɗem'ɗem ba̱ cilti gwaka̱n da̱n ɗe da̱mshal so. <verse eid="LUK 11:35" /><verse number="36" style="v" sid="LUK 11:36" />Kume mas tli gwa ni na̱ cilti wu, da̱mshal ani kii ɗa̱ so, mas a da̱m na̱ cilti na̱k gwe a pitila cilli lu wu.&gt;&gt;<verse eid="LUK 11:36" /></para>
  <para style="s">Yesu wule Nya a dop kiɗi Ma̱n Yehuda na̱ byas wul jwasa̱n</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37" />Yesu pak ga̱ɓe wugo, yek ba Paresi gon mbet a lubii ɗatka ta̱s nguk wul, yek Yesu li ka̱ lubiimi ta̱s nguki. <verse eid="LUK 11:37" /><verse number="38" style="v" sid="LUK 11:38" />Yek ba Paresisi yeni ɗe Yesu pol ang paa ta̱ nda ngukti na̱k kangwe a Ma̱n Yehuda pa̱li wu sogo, yek ili hwotti.<verse eid="LUK 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 11:39" />Yek Yesu wulti ɗe, &lt;&lt;Kii ma̱n Paresi wo aka̱ pol mbuka ze suk gali, ama mbadl gwaka̱n ni ga̱ njikmi na̱ lamti mot wul suk yokiti. <verse eid="LUK 11:39" /><verse number="40" style="v" sid="LUK 11:40" />Ka̱dla̱n ka̱ɗe kii, ka̱ yisi ɗe Nya gwe pa̱l tukaali wu ka̱ pa̱l tugiɓi pak sa? <verse eid="LUK 11:40" /><verse number="41" style="v" sid="LUK 11:41" />Ka ba̱l ilga̱ nguki ma̱jwe ba̱ ilgon nisi ɗa̱ sowu tot ka̱ gal gwe aka̱ poli wu, a mbuni kii mal Nya mani.<verse eid="LUK 11:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42" />&lt;&lt;Ka̱a̱ da̱n ɗe wul cit gonti wi ma̱n Paresi, na̱k ɗe aka̱ ba̱l Nya ɗe na̱m ka̱ kutl ka̱ wul jwe aka̱ mbi wu na̱k wul wolo suk dik daa suk mitlgulu suk ngum, ama zok da̱nti suk lamti Nya wo yek ba̱ hwotkii so. Ngetli ka̱n ta̱k koɓa̱n jwisi, ama ba̱k zaka̱n jon ju so.<verse eid="LUK 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43" />&lt;&lt;Ka̱a̱ da̱n ɗe wul cit gonti wi ma̱n Paresi, na̱k ɗe lamti gwaka̱n wo ta̱s ba̱lkii hwa lu da̱nti ka̱lu motgaa ga̱ gwasa̱n ata̱ mbala̱n pita ga̱ɓet gwaka̱n ka̱lu motgaa wulti wul.<verse eid="LUK 11:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 11:44" />&lt;&lt;Ka̱a̱ da̱n ɗe wul cit gonti wi, kii ma̱n Paresi na̱k gaa zukɗi gwe ba̱ mbala̱n a yeni sowu ka̱n ka̱ ni, jwe mbala̱n jwaka̱n na̱ma la̱t dani a ba̱sa̱ yisi ɗe yek ka laki asa̱ da̱n ɗe ma̱n da̱ska̱n sowu.&gt;&gt;<verse eid="LUK 11:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45" />Yek gon ka̱ ma̱n yisti mba̱t ga̱ Musa wul Yesu ɗe, &lt;&lt;Ma̱n lishti, kume ka̱ dla̱m nugo, mi mago ka̱ byal nii.&gt;&gt;<verse eid="LUK 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46" />Yek Yesu wule, &lt;&lt;Ka̱a̱ da̱n ɗe wul cit gonti wi, kii ma̱n yisti mba̱t ga̱ Musa, na̱k ɗe ka̱a̱ zi diɓa̱l mba̱t mbala̱n ama kii wo ba̱ka zisi ang ta̱s man kopti ɗa̱ sowu.<verse eid="LUK 11:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 11:47" />&lt;&lt;Ka̱a̱ da̱n ɗe wul cit gonti wi na̱k ɗe ka̱a̱ kin gaa zukɗi ga̱ ma̱n dla̱mti ga̱ɓa ga̱ Nya mbuni jwe ma̱jwaka̱n ji cina tlosi wu. <verse eid="LUK 11:47" /><verse number="48" style="v" sid="LUK 11:48" />Kii na̱ gaa gwaka̱n, ka̱ yisi yek ka̱ kan ka̱ mbadl gwaka̱n ilgwe mbala̱n jwaka̱n ji cina pa̱li wu. Sa̱ tlo ma̱n dla̱mti ga̱ɓa ga̱ Nya yek kii ne go yek ka̱ kop kaal gwasa̱n ɗe ka̱ kin gaa zukɗi jwasa̱n mbuni wu. <verse eid="LUK 11:48" /><verse number="49" style="v" sid="LUK 11:49" />Yek laki yek Nya wul ka̱ yisti gwas ɗe, &lt;Ba shinisi lu na̱ mil shinti ga̱ɓa ga̱ Nya suk mil shinti ji botli, mbala̱n a tlo naami, asa̱ nol naami.&gt; <verse eid="LUK 11:49" /><verse number="50" style="v" sid="LUK 11:50" />Na̱ nu ka̱n Nya a dop mbala̱n ji se na̱ byas wul jwasa̱n ɗe sa tlo mas ma̱n dla̱mti ga̱ɓa ga̱ Nya tet ten ndat zhila da̱nti ka̱ dii atli. <verse eid="LUK 11:50" /><verse number="51" style="v" sid="LUK 11:51" />Nde tet ten hwulan ga̱ Habila yek su sut ten ga̱ Zakariya, ma̱lgwe sa̱ tlot ka̱ tlo ga̱ lu takti wul Nya ka̱lu ma̱n cilti ka̱ lubii ga̱ Nya wu. <note caller="+" style="f"><char style="fr" closed="false">11:51 </char><char style="ft" closed="false">Yen <char style="xt"><ref loc="GEN 4:2">L. Z. 4:2</ref>; <ref loc="1CH 24:20-21">1Lab 24:20-21</ref></char>.</char></note> Gem ka̱n a ni kii ma hwiti, sa dop mbala̱n ji se na̱ mas byas wul jwisi.<verse eid="LUK 11:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52" />&lt;&lt;Ka̱a̱ da̱n ɗe wul cit gonti wi, kii ma̱n yisti mba̱t ga̱ Musa, na̱k ɗe ka̱a̱ yis mba̱ti yek ka̱a̱ nge kopti kii gaa gwaka̱n, a ba̱ka̱a̱ zak ma̱lgon ta̱s yisi so.&gt;&gt;<verse eid="LUK 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53" />Yesu zak lwisi wugo, yek ma̱n yisti mba̱t ga̱ Muse suk ma̱n Paresi nda ngabti gwasi, yek sa̱ ngusit ngot bi na̱ kumti ga̱s wul wonti. <verse eid="LUK 11:53" /><verse number="54" style="v" sid="LUK 11:54" />Sa̱ na̱ma ngoti ta̱s telti ka̱ ga̱ɓa gwe ba̱ta man yilti ɗa̱ giɓi ka̱ sowu a ta̱s dla̱m ilgwe ba̱ yek sowu.<verse eid="LUK 11:54" /></para>
  <chapter eid="LUK 11" />
  <chapter number="12" style="c" sid="LUK 12" />
  <para style="s">Yesu da̱li ka̱n ma̱n kopti jwasi yek ta̱ nda̱llisi mbadli</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1" />Yek mbala̱n wonti mogaa mal Yesu hal wonta̱t gwasa̱n laki yek sa̱ na̱ma za̱t asa̱n ten ji yilkeni, yek Yesu nde hwit ga̱ɓa ma̱n kopti jwasi yek ta̱ wulsi ɗe, &lt;&lt;Pa̱n ɗem'ɗem ba̱k shela̱n lal yisti Nya na̱k ga̱ ma̱n Paresi wu ka̱ da̱nti gwaka̱n so. <verse eid="LUK 12:1" /><verse number="2" style="v" sid="LUK 12:2" />Ilgon ni ga̱ hwuda̱li gwe ba̱ a yil deɓa̱l sowu so. Sogo ga̱ hwuda̱li ɗe ba̱ mbala̱n a yisi sowu so. <verse eid="LUK 12:2" /><verse number="3" style="v" sid="LUK 12:3" />Ilgwe ka̱a̱ dla̱m ka̱ da̱mshal go a yil ten cilti. Ilgwe ka̱ dla̱m ga̱ hwuda̱li te punka ka̱go a kumi ten za̱nda̱l.<verse eid="LUK 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4" />&lt;&lt;A ni kii ma hwiti kii yela̱n jini, ba̱k ɓanti ma̱jwe a tloki wu, kaal ɗa̱ nugo a ba̱sa po man pa̱lti ilgon sowu so. <verse eid="LUK 12:4" /><verse number="5" style="v" sid="LUK 12:5" />Ama ba hwiki ma̱lgwe ka ɓantit wu, tik ɗe Nya ma̱lgwe kaal ɗa̱ tlot ga̱ tlisi ta man lakti gwaka̱n ka̱ boo wutu. Gem, ɓantiti. <verse eid="LUK 12:5" /><verse number="6" style="v" sid="LUK 12:6" />Ale yatl ɗe namtan wo kobo ɗe lop ka̱n asa̱ wul ka̱ nwa? Mas na̱ nu, Nya ma̱sa̱n gon gwasa̱n so. <verse eid="LUK 12:6" /><verse number="7" style="v" sid="LUK 12:7" />Ma̱dla̱n gaa gwaka̱n mago ga̱ dla̱mi ka̱n ni mas. Ba̱ ɓanti cikii so, ka̱ ni hwaɓi man wonti yadli.<verse eid="LUK 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8" />&lt;&lt;A ni kii ma hwiti ɗe mas ma̱lgwe dla̱m ka̱ mbala̱n ɗe ta̱ yisa̱n go, ami Yen ga̱ Mbala̱n a yisti a cina ɗa̱ mil shinti ji Nya ka. <verse eid="LUK 12:8" /><verse number="9" style="v" sid="LUK 12:9" />Ma̱lgwe nge yisti gi a cina ɗa mbala̱n ka̱go, ami mago ba nge yisti gwas a cina ɗa̱ mil shinti ji Nya ka. <verse eid="LUK 12:9" /><verse number="10" style="v" sid="LUK 12:10" />Mas ma̱lgwe dla̱m ga̱ɓa mbulti ten ami Yen ga̱ Mbala̱n go sa taasit ka, ama ma̱lgwe dla̱m ga̱ɓa nget ga̱ Shishi ga̱ Nya go sa taasit ka̱ so.<verse eid="LUK 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11" />&lt;&lt;Kume sa̱ ta̱lakii ka̱lu motgaa ga̱ gwasa̱n sogo mal guu ji ba̱n sogo mal kiɗi ma̱n ba̱n, ba̱ hwotkii ɗe nii ka̱n ka yilli gaa gwaka̱n suk ilgwe ka dla̱m wu so <verse eid="LUK 12:11" /><verse number="12" style="v" sid="LUK 12:12" />na̱k ɗe Shishi ga̱ Nya a ba̱lkii ilgwe ka dla̱m ka̱li wu.&gt;&gt;<verse eid="LUK 12:12" /></para>
  <para style="s">Cinga̱lti ga̱ɓa ten ka̱dla̱n ma̱n wul ang gon</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13" />Yek ma̱lgon tet ka̱ mbala̱n wulti ɗe, &lt;&lt;Ma̱n lishti, hwi yilka gini ta̱s huulini ilgwe aba ga̱na̱n ma̱shi yek ta̱ zakini wu.&gt;&gt;<verse eid="LUK 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14" />Yek Yesu wulti ɗe, &lt;&lt;Ba mbala̱n, wok za̱n ɗe ma̱n huulti ga̱ɓa ka̱ tlo gwaka̱n wo?&gt;&gt; <verse eid="LUK 12:14" /><verse number="15" style="v" sid="LUK 12:15" />Yek ta̱ wulti ɗe, &lt;&lt;Pa̱n ɗem'ɗem ba̱k za̱n mbadl gwaka̱n ten mot wul wonti so, na̱k ɗe yek ka laki a mbala̱n mbi mbadl sowu.&gt;&gt;<verse eid="LUK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16" />Yek ta̱ cinga̱lisi ga̱ɓa gon ɗe, &lt;&lt;Ma̱n wul ang gon ka̱n, zhin mbunit i'e. <verse eid="LUK 12:16" /><verse number="17" style="v" sid="LUK 12:17" />Yek ta̱ daamti ka̱ mbadl gwas ɗe, &lt;Nhu gwe ba wut wul zhin wu njika̱n ka̱wi.&gt;<verse eid="LUK 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 12:18" />&lt;&lt;Yek ta̱ po wul ka̱ mbadl gwas ɗa̱ɗe, &lt;Ilgwe ba pa̱li go, ba tatl nhu jin ka a kin kiɗi a wut mas wul zhin gini suk wul ji giɓi. <verse eid="LUK 12:18" /><verse number="19" style="v" sid="LUK 12:19" />A paa a wul gaa gi ɗe, &lt;&lt;Wul wonti nik ɗa gwe a ta̱lak gin wonti wu, shuk ilgon gwa, aka̱ ngusi kumti ta̱mti.&gt;&gt; &gt;<verse eid="LUK 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 12:20" />&lt;&lt;Yek Nya wulti ɗe, &lt;Ki wo ka̱dla̱n ka̱n, ka̱ gas nge ka̱n ka ma̱shi, ta ɓo yen ma̱lgwe a nguk ilga̱n ɗe ka̱ mwe gaa gwa wu.&gt; &gt;&gt;<verse eid="LUK 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21" />Yek Yesu wuli ɗe, &lt;&lt;Nu ka̱n ani mal ma̱jwe mwe wul gaa gwasa̱n ten dii atli ama mal Nya wo ba̱ ilgon nisi ɗa̱ sowu.&gt;&gt;<verse eid="LUK 12:21" /></para>
  <para style="s">Yesu nda̱li mbadli ma̱n kopti jwasi ta̱s zi mbadl ten Nya</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22" />Yek Yesu hwi ma̱n kopti jwas ɗe, &lt;&lt;A ni kii ma hwiti, ba̱ ilga̱ nguki suk luka̱l gwe ka lak wu hwotkii so. <verse eid="LUK 12:22" /><verse number="23" style="v" sid="LUK 12:23" />Kangwe ka da̱n wu manikii ilga̱ nguki sa? A ba̱ tli gwaka̱n manikii luka̱l sa? <verse eid="LUK 12:23" /><verse number="24" style="v" sid="LUK 12:24" />Ɓo yena̱n yadli, ba̱sa ɓak zhin so a ba̱sa wotl so. A ba̱ nhu wutti ilga̱ nguki nisi ɗa̱ so, na̱k ɗe Nya ka̱ nisi ma ba̱lti ilga̱ nguki wu. Nya lamkii man kangwe ta lam yatl wu sa? <verse eid="LUK 12:24" /><verse number="25" style="v" sid="LUK 12:25" />Wok nii ka̱ kii ɗe ilgwe hwotti wu a mba̱lit multi ɗe na̱m dani wo? <verse eid="LUK 12:25" /><verse number="26" style="v" sid="LUK 12:26" />Kume ka̱a̱ mani pa̱lti nak mil wul gaa gwaka̱n nu sogo, yek laki yek ka̱a̱ na̱ma hwotti mbadl gwaka̱n ye?<verse eid="LUK 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 12:27" />&lt;&lt;Ɓo yena̱n mbuni buzha ka̱ me kangwe asa̱ nal wu, ba̱sa pa̱l ilgon so, a ba̱sa pa̱li luka̱l gaa gwasa̱n so. Ama ko ta̱ Sulemanu guu na̱ nalti gwas mago ta̱ ɓo taɓa kinti gwas mbuni nu so. <verse eid="LUK 12:27" /><verse number="28" style="v" sid="LUK 12:28" />Kii ɗe ba̱ za̱t mbadl gwaka̱n ten Nya nda̱l sowu, kume nu ka̱n Nya pa̱l buzha ka̱ me mbuni jwe ase go sa̱ ni ɗa ama ayo go asa̱ lak ka̱ wutu wu, a kii ka̱n ba̱ta ba̱lkii luka̱l gwe ka lak wu sa? <verse eid="LUK 12:28" /><verse number="29" style="v" sid="LUK 12:29" />Ba̱k za̱n mbadl gwaka̱n ten ilga̱ nguki suk ilga̱ tle so, mas ba̱ hwotkii so. <verse eid="LUK 12:29" /><verse number="30" style="v" sid="LUK 12:30" />Mbala̱n ga̱ dii atl mas ɗe ba̱sa̱ yis Nya sowu na̱ma ngot wul jwisi, ama kii wo Aba gwaka̱n yisi ɗe ka̱ lami ta̱ wul jwisi ni kii ɗa̱. <verse eid="LUK 12:30" /><verse number="31" style="v" sid="LUK 12:31" />Dloka̱ma̱nkii ta̱k kama̱n Nya ɗe guu ka̱ mbadl gwaka̱n, Nya a ba̱lkii mas wul jwisi.<verse eid="LUK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32" />&lt;&lt;Ko ɗe ba̱ka̱a̱ wonti sogo, ba̱ ɓanti cikii so, na̱k ɗe bal Aba gwaka̱n pa̱l hwol tuk ɗe ta̱ telkii ka̱ boo gwas wu. <verse eid="LUK 12:32" /><verse number="33" style="v" sid="LUK 12:33" />Wula̱n wul jwaka̱n ka aka̱a̱ ba̱l wulpi ma̱jwe ba̱ ilgon nisi ɗa̱ sowu. Za̱n wul jwaka̱n to nya ka, ka̱lu gwe ba̱ a lil ka̱ sowu, lu gwe muka̱l a mukli so, aba̱ da̱kmbi a lili ka̱ so. <verse eid="LUK 12:33" /><verse number="34" style="v" sid="LUK 12:34" />Lu gwe wul jwaka̱n ni go ka̱li ka̱n mbadl gwaka̱n ani pak.<verse eid="LUK 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35" />&lt;&lt;Da̱ma̱n na̱ ka̱n gaa, ta̱ wutu yenti lu gwaka̱n cili, <verse eid="LUK 12:35" /><verse number="36" style="v" sid="LUK 12:36" />na̱k zhel jwe na̱ma ɓa̱tti ga̱ baboo gwasa̱n ta̱s pal tet ka̱lu motgaa hapti wu. Ta̱ pal wugo ata̱ ɓwesi dlabi asa̱ ɓuliti ninge. <verse eid="LUK 12:36" /><verse number="37" style="v" sid="LUK 12:37" />Zhel ju a mbi hwa wul kume baboomi palli a ba̱sa ɓo nde yeba̱l sowu. A ni kii ma hwit gem ɗe, ta ndus bal luka̱l gwe ta̱ lak wu ka, ata̱ wulsi ɗe ta̱s da̱m atli ta̱s nguk wul, ata̱ kopsi gaa-gaa ata̱ ba̱lsi ilga̱ nguki. <verse eid="LUK 12:37" /><verse number="38" style="v" sid="LUK 12:38" />Zhel jo ma̱n mbit hwa wul ka̱n kume baboomi pal ka̱ tlo gas wu, sogo ka̱ bultlwe ata̱ mbisi ten ɓa̱tti gwas wu. <verse eid="LUK 12:38" /><verse number="39" style="v" sid="LUK 12:39" />Ama ta̱k yisi ɗe, kume baboo a yis tulti ga̱ muka̱l go, ta zakti asa̱ tet lubii asa̱ lilit wul ka̱ so. <verse eid="LUK 12:39" /><verse number="40" style="v" sid="LUK 12:40" />Kii mago, da̱ma̱n na̱ ka̱n gaa, na̱k ɗe ami Yen ga̱ Mbala̱n ba palli gas gwe ba̱ka̱ ɓo zi tulti gi sowu.&gt;&gt;<verse eid="LUK 12:40" /></para>
  <para style="s">Zhel ma̱n gem suk zhel ma̱n la̱shi gem</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41" />Yek Biturus wul Yesu ɗe, &lt;&lt;Bagaa, cinga̱lti ga̱ɓa ga̱n go ten mi na̱ ngwe na̱n ma, ko ten mas mbala̱n?&gt;&gt;<verse eid="LUK 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42" />Yek Yesu wule, &lt;&lt;Wok ɗe ma̱n pa̱lti wul gibboo ga̱ baboo gwas ɗe ma̱n gem, ma̱n zok mbadli suk ma̱n ɓotlka̱n go? Ti ka̱n baboomi a zakit yenti lubii gwasi, ata̱ ba̱l zheli jon ju ilga̱ nguki na̱k gwe sa̱ zit pa̱lti wu. <verse eid="LUK 12:42" /><verse number="43" style="v" sid="LUK 12:43" />Zhel go ma̱n mbit zok wul ka̱n ɗe baboo gwas a pal tet ka̱lu gwe ta̱ li wu ata̱ mbit ten pa̱lti hwa wul nu wu. <verse eid="LUK 12:43" /><verse number="44" style="v" sid="LUK 12:44" />A ni kii hwiti gem ɗe, ta palli zhel wu ɗe bagaa ga̱ wul jwasi mas. <verse eid="LUK 12:44" /><verse number="45" style="v" sid="LUK 12:45" />Ama kume zhel wu wul ka̱ mbadl gwas ɗe, &lt;Baboo gi pal ba̱le so,&gt; yek ta̱ njel ɓot ji zheli jon ju na̱ modli na̱ maani, yek ta̱ njel tlati suk ngukti yek gaa ɓa gillit ka, <verse eid="LUK 12:45" /><verse number="46" style="v" sid="LUK 12:46" />baboo ga̱ zhel wu a palli gas gwe ba̱ta̱ yisi sowu. Baboomi a pa̱lit byas ɓoti ata̱ keshti ka ata̱ za̱t ndakce suk ma̱jwe ba̱ gem nisi ɗa̱ sowu.<verse eid="LUK 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47" />&lt;&lt;Zhel gwe yis ilgwe baboo gwas lami yek ba̱ta̱ zi ka̱ mbadl gwas ɗe ta̱s pa̱li sogo, sa pa̱lit byas ɓoti. <verse eid="LUK 12:47" /><verse number="48" style="v" sid="LUK 12:48" />Ama ma̱lgwe ba̱ta̱ yis ilgwe baboo gwas lami sowu, yek ta̱ pa̱l wul ɓot go, njet ka̱n sa ɓoti. Mas ma̱lgwe sa̱ ba̱lti wul nal go, sa ngo wul nal malti. Ma̱lgwe sa̱ ba̱lti nal mani go, nu ka̱n sa ngwe malti.<verse eid="LUK 12:48" /></para>
  <para style="s">Yesu mbe mbala̱n ta̱s yis ilgwe na̱ma pa̱t wu</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49" />&lt;&lt;Wutu ka̱n a tuli ta laki mbala̱n ten dii atli, lamti gi wo ta̱ wuti tlo. <verse eid="LUK 12:49" /><verse number="50" style="v" sid="LUK 12:50" />Baptisma gwe sa pa̱li wu ni ɗa̱, a mbadl gi tli wi i'e ta̱s pa̱li ni. <verse eid="LUK 12:50" /><verse number="51" style="v" sid="LUK 12:51" />Ka̱ da̱ma̱n gwa we ta̱mti ga̱ mbadl ka̱n a tullikii ten dii atli a? Ko njaa, a ni kii ma hwiti ɗe, huulti tlo ji yilkeni suk yilkeni ka̱n a tulli. <verse eid="LUK 12:51" /><verse number="52" style="v" sid="LUK 12:52" />Ndok ase, mbala̱n ɗe namtan ka̱ lubii a huul ɗe lop. Ɗe lop na̱ma nget ga̱ ɗe mekan, a ɗe mekan na̱ma nget ga̱ ɗe lop. <verse eid="LUK 12:52" /><verse number="53" style="v" sid="LUK 12:53" />Tlo gwasa̱n a hwuli, aba na̱ma nget ga̱ yen, a yen na̱ma nget ga̱ aba. Ana na̱ma nget ga̱ yen gwas ga̱ ma̱dli, yeni mago ata̱ na̱ma nget ga̱ ana gwasi. Nkwe ga̱ ma̱dli na̱ma nget ga̱ kili ga̱ yen gwasi. A kili ga̱ yeni na̱ma nget ga̱ ana ga̱ kos gwasi.&gt;&gt;<verse eid="LUK 12:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54" />Yek Yesu po wul mbala̱n ɗa̱ɗe, &lt;&lt;Kume ka̱a̱ yen nyaze tli tot wugo, aka̱a̱ wule ze a nda a zesi nda kuwa. <verse eid="LUK 12:54" /><verse number="55" style="v" sid="LUK 12:55" />Kume ka̱ kum yeta̱l ɓalma hotti tet go, aka̱ wule wutu cin a tuli, a wutu cinmi tul kuwa. <verse eid="LUK 12:55" /><verse number="56" style="v" sid="LUK 12:56" />Ki ma̱n pa̱lti riya, ka̱ man yisti kangwe a wul pi ten dii atli suk to nya ka̱wu, ama yisti wul gwe na̱ma pa̱t ningo yek kanki gaa.<verse eid="LUK 12:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57" />&lt;&lt;Yek laki a ba̱ka daamki ta̱k yisa̱n ilgwe mbun ɗe ta̱k pa̱li wu so ye? <verse eid="LUK 12:57" /><verse number="58" style="v" sid="LUK 12:58" />Kume ma̱lgon mbet a dlaboo kisti ga̱ɓa wu, tloki ta̱k la̱ka̱n tlo gwa sukti ten tantu, kume ka̱ nge go, ta ta̱lak dlaboo mal ma̱n ndoka̱lti ga̱ɓa asa̱ telki ka̱lu gwe asa̱ le ma̱n pa̱lti byas wul wu. <verse eid="LUK 12:58" /><verse number="59" style="v" sid="LUK 12:59" />A nikma hwiti ɗe, ka yil ɗa̱ka̱ lwisi ka̱ so se ka̱ ɓatl ilgwe sa̱ mboshik wu mas.&gt;&gt;<verse eid="LUK 12:59" /></para>
  <chapter eid="LUK 12" />
  <chapter number="13" style="c" sid="LUK 13" />
  <para style="s">Cin atl gaa sogo aka̱ ma̱shi</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1" />Ka̱ multi jwisi ɗe Yesu nisi ma hwit ga̱ɓa wu, yek ma̱jon ɗe sa̱ ni ka̱li wu dla̱mi Yesu ma̱n Galili jwe Bilatus laki yek sa̱ tlosi asa̱ na̱ma mboshti mba̱la sogo mal ta̱s tak Nya wu. <verse eid="LUK 13:1" /><verse number="2" style="v" sid="LUK 13:2" />Yek Yesu nda̱kisi ɗe, &lt;&lt;Na̱k ɗe ma̱n Galili ju ma̱sh nugo, ka̱ da̱ma̱n gwa we sa̱ pa̱l byas wul man naa mbala̱n mas a Galili a? <verse eid="LUK 13:2" /><verse number="3" style="v" sid="LUK 13:3" />Ko njaa, a ni kii ma hwiti ɗe kume ka̱ ci atl gaa sogo nu ka̱n ka ma̱shi mas jwaka̱n na̱k gwasa̱n wu. <verse eid="LUK 13:3" /><verse number="4" style="v" sid="LUK 13:4" />Ko mbala̱n ɗe kutl cet wusupsi jwe tlal bii ndesi gaa a Siluwam yek sa̱ ma̱sh go sa̱ pa̱l byas wul man mas ma̱n Wurshelima? <verse eid="LUK 13:4" /><verse number="5" style="v" sid="LUK 13:5" />Ko njaa, a ni kii ma hwiti, kume ka̱ ci atl gaa sogo nu ka̱n mas jwaka̱n ka ma̱shi na̱k gwasa̱n wu.&gt;&gt;<verse eid="LUK 13:5" /></para>
  <para style="s">Cinga̱lti ga̱ɓa ten tlindi tula̱n</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6" />Yek Yesu cinga̱lisi ga̱ɓa gon ɗe, &lt;&lt;Ma̱lgon pa̱l zhin yandi inabi gwasi yek ta̱ ɓak tlindi tula̱n a giɓi, yek ta̱ li ka̱ zhimi ta̱s kotl yandi tula̱mi ama yek ba̱ta̱ mbi ilgon dani so. <verse eid="LUK 13:6" /><verse number="7" style="v" sid="LUK 13:7" />Yek ta̱ wul ma̱lgwe zhimi nit ang wu ɗe, &lt;Gin naa ɗe mekan ka̱ ɓal gee ɗe a na̱ma tulti ngot yandi a dani a ba̱ba mbi ilgon sowu. Yek laki ɗe ma̱ zak tlindi tula̱n ga̱n ka̱lu gwe ma ɓaka̱n yandi inabi ka̱li gwe? Wotl ka!&gt; <verse eid="LUK 13:7" /><verse number="8" style="v" sid="LUK 13:8" />Yek ma̱lgwe zhimi nit ang wu wule, &lt;Bagaa, ɓo zaki ta̱ po pa̱l gin ɗe na̱m ɗa̱ paa. Ba hwokit atl ɗa̱ zhila ka a wutit taki. <verse eid="LUK 13:8" /><verse number="9" style="v" sid="LUK 13:9" />Kume guli wu aka̱ zaki, kume guli sowu aka̱ laki a wotl ka.&gt; &gt;&gt;<verse eid="LUK 13:9" /></para>
  <para style="s">Yesu ndok kili gon gas shukti</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10" />Gas gon Yesu na̱ma hwit ga̱ɓa mbala̱n ka̱lu motgaa ga̱ gwasa̱n gas shukti gwasa̱n. <verse eid="LUK 13:10" /><verse number="11" style="v" sid="LUK 13:11" />A kili gon ɗe ma̱zhe laki yek cwo tlet tli ka̱wu ni ka̱li, ta̱ ɓal ka̱ gin ɗe kutl cet wusupsi ata̱ ni kontami. A ba̱ta man takti gwas so ko njet. <verse eid="LUK 13:11" /><verse number="12" style="v" sid="LUK 13:12" />Yesu yenti wugo yek ta̱ mbet tet malti yek ta̱ wulti ɗe, &lt;&lt;Kili mbala̱n, ka̱ mbi ndokti ɗa̱ka̱ cwo gwa ka̱wi.&gt;&gt; <verse eid="LUK 13:12" /><verse number="13" style="v" sid="LUK 13:13" />Yek Yesu zi kilisi ang ten gaa, yek ninge tli gwas taki yek ta̱ ngusi ta̱sti ga̱ Nya.<verse eid="LUK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14" />Yek mbadl lili bali ga̱ lu motgaami ɗe Yesu ndok ma̱lgon gas shukti gwasa̱n wu. Yek ta̱ wul mbala̱n ɗe, &lt;&lt;Cin ɗe mukka ka̱n sa̱ ba̱la̱nnii ka̱n mba̱t ga̱ Musa ɗe ta̱n pa̱la̱n wul jina̱n, tula̱n ka̱ multi jwisi ta̱s ndokkii ama ba̱ ɗe gas shukti ga̱na̱n so.&gt;&gt;<verse eid="LUK 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15" />Yek Yesu ballit ɗe, &lt;&lt;Kii ma̱n pa̱lti riya, ka̱a̱ kul pa̱tl tla suk zhaki jwaka̱n aka̱ ta̱lasi ka̱lu gwe sa tla ze wu gas shukti sa? <verse eid="LUK 13:15" /><verse number="16" style="v" sid="LUK 13:16" />Kili ga̱n ɗe ga̱s ga̱ Ibirahim gwe Sheɗan lakit cwo hal ta̱ ɓal ka̱ gin ɗe kutl cet wusupsi go mbun ɗe ta ndokti gas shukti sa?&gt;&gt; <verse eid="LUK 13:16" /><verse number="17" style="v" sid="LUK 13:17" />Ta̱ dla̱m nu wugo yek nsha ci mas ma̱n nget gwasi, yek naa mbala̱mi ngusi hwol tuki ɗe sa̱ yen wul cit ɓanti gwe Yesu na̱ma pa̱lti wu.<verse eid="LUK 13:17" /></para>
  <para style="s">Yesu cinga̱l Nya ɗe guu ka̱ mbadl ga̱ mbala̱n suk gwe mbukla</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18" />Yek Yesu wule, &lt;&lt;Nii ka̱n kanti ga̱ Nya ɗe guu ka̱ mbadl ga̱ mbala̱n ni gwi, na̱ yek ba cinga̱li ye? <verse eid="LUK 13:18" /><verse number="19" style="v" sid="LUK 13:19" />Kanti ga̱ Nya ɗe guu ka̱ mbadl wo, na̱k gwe mbukla ka̱n ni, gwe ma̱lgon ɓak ka̱ zhin gwasi yek nali yek da̱n ɗe bal tlindi, yek yatl pa̱l bii jwasa̱n ten mil ami.&gt;&gt;<verse eid="LUK 13:19" /></para>
  <para style="s">Cinga̱lti ga̱ɓa ten yiis</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20" />Yek Yesu po kum ga̱zi ɗa̱ɗe, &lt;&lt;Na̱ yek ba cinga̱l Nya ɗe guu ka̱ mbadl ga̱ mbala̱n ye? <verse eid="LUK 13:20" /><verse number="21" style="v" sid="LUK 13:21" />Kanti ga̱ Nya ɗe guu ka̱ mbadl wo, na̱k yiis ka̱n ni gwe a modli la̱ski njet ka̱ apti a to wu.&gt;&gt;<verse eid="LUK 13:21" /></para>
  <para style="s">Ngaɓi dlabii</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22" />Yek Yesu ɓa li a Wurshelima go yek ta̱ koɓi ɗa̱nka̱ kiɗi suk nak mil ba̱n ka ata̱ nisi ma hwit ga̱ɓa. <verse eid="LUK 13:22" /><verse number="23" style="v" sid="LUK 13:23" />Yek ma̱lgon ngemti ɗe, &lt;&lt;Bagaa, ma̱jwe Nya a kissi go njet ka?&gt;&gt;</para>
  <para style="p" vid="LUK 13:23">Yek ta̱ wulsi ɗe, <verse eid="LUK 13:23" /><verse number="24" style="v" sid="LUK 13:24" />&lt;&lt;Dloka̱ma̱nkii ta̱k koɓi tuka̱ ngaɓi dlabii na̱k ɗe mbala̱n wonti a ngwe ta̱s koɓi tuka̱li ama ba̱sa mani sowu. <verse eid="LUK 13:24" /><verse number="25" style="v" sid="LUK 13:25" />Kume baboomi tlinya yek ta̱ le dlabiimi ka̱wu, kaa dla̱l a deɓa̱l aka̱ ngusi ɓot dlabiimi aka̱ na̱ma ngemti gwas ɗe, &lt;Bagaa, ɓulinii dlabiimi.&gt;</para>
  <para style="p" vid="LUK 13:25">&lt;&lt;A paa ta̱ balli kii ɗe, &lt;A yis kii so, aba̱ a yis lu gwe ka̱a̱ yil tet wu so.&gt;<verse eid="LUK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 13:26" />&lt;&lt;A paa ka̱a̱ wulti ɗe, &lt;Mi ɗe ma̱ nguk wul yek ma̱ tla sukki wu aka̱ dla̱m ga̱ɓa ɗa̱n ten tantu ba̱n ga̱na̱n ka.&gt;<verse eid="LUK 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 13:27" />&lt;&lt;A ta̱ po balli kii ɗe, &lt;A yiskii so, a baa yis lu gwe ka̱ yil tet wu so. Tli ɗa̱ mala̱n ka kii ma̱n pa̱lti byas wul.&gt;<verse eid="LUK 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 13:28" />&lt;&lt;Kume ka̱a̱ yen ka̱ Ibirahim suk Ishaku suk Yakubu suk mas ma̱n dla̱mti ga̱ɓa ga̱ Nya ka̱ dlo ga̱ ma̱jwe kan Nya ɗe guu ka̱ mbadl gwasa̱n wu, a kii wo yek sa̱ mbolkii go, ka̱li ka̱n ka kuli aka̱ as ang bi. <verse eid="LUK 13:28" /><verse number="29" style="v" sid="LUK 13:29" />Mbala̱n a yil tet tucina suk tet tukaali suk tet ten ang shinti suk ang yali ga̱ mas dii atli, asa̱ da̱n ka̱lu motgaa hwol tuki suk ma̱jwe kan Nya ɗe guu ka̱ mbadl gwasa̱n wu. <verse eid="LUK 13:29" /><verse number="30" style="v" sid="LUK 13:30" />Na̱ nu ka̱n ma̱jwe nde ba̱le wu a pal tukaali, ma̱jwe nde ka̱ kaali wu a pal cina.&gt;&gt;<verse eid="LUK 13:30" /></para>
  <para style="s">Yesu yen gonti ga̱ Wurshelima</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31" />Yesu ni nugo yek ma̱n Paresi jon li tet malti, yek sa̱ wulti ɗe, &lt;&lt;Zigaa ɗa̱ ka̱lu ga̱n ka, na̱k ɗe Hiridus guu na̱ma ngot gwa ta̱s tloki wu.&gt;&gt;<verse eid="LUK 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32" />Yek Yesu wulsi ɗe, &lt;&lt;Lak wula̱n ma̱n byas mbadl wu ɗe, &lt;Ase suk ayo wo ba yilli ma̱zhe ɗa̱ka̱ mbala̱n ka, a ba ndok mbala̱n pak. Tli wu ka̱n ba paki.&gt; <verse eid="LUK 13:32" /><verse number="33" style="v" sid="LUK 13:33" />Mas na̱ nu ngetli ka̱n ni ɗe ta ci cina na̱ la̱t ka̱lu gwe ba li wu, ase suk ayo suk tli wu, na̱k ɗe sa man tlot ma̱n dla̱mti ga̱ɓa ga̱ Nya ka̱lu gon so se a Wurshelima wu.<verse eid="LUK 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34" />&lt;&lt;Kii ma̱n Wurshelima ɗe ka̱a̱ tlo ma̱n dla̱mti ga̱ɓa ga̱ Nya yek ka̱ lak ma̱jwe sa̱ shinsi malkii na̱ ye wu, asa̱mi ɗe na̱mi ka̱n a lam mot gwaka̱n na̱k gwe a ana kol moo mil jwas ka̱ bibaku gwas wu, ama yek ka̱a̱ nge. <verse eid="LUK 13:34" /><verse number="35" style="v" sid="LUK 13:35" />Yekgu sa̱ zakikii lubii gwaka̱n wi koni. A ni kii ma hwiti ɗe, kaa po yena̱n so se gas gwe ka̱a̱ wule, &lt;Ma̱n mbit hwa wul ga̱ Nya ka̱ɗe ma̱lgwe na̱ma tulti ka̱ shin ga̱ Bagaa Nya wu.&gt; &gt;&gt;<verse eid="LUK 13:35" /></para>
  <chapter eid="LUK 13" />
  <chapter number="14" style="c" sid="LUK 14" />
  <para style="s">Yesu ndok ma̱n cwo gon gas shukti</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1" />Gas shukti ga̱ Ma̱n Yehuda, yek Yesu te ka̱ lubii ga̱ bali ga̱ ma̱n Paresi gon ta̱s nguk wul yek mbala̱n wutit gwel ta̱s yen ilgwe ta pa̱li wu. <verse eid="LUK 14:1" /><verse number="2" style="v" sid="LUK 14:2" />Yek ma̱lgon ka̱wu na̱ ang na̱ asa̱n gwasi mas kiɗi ka, ta̱ li tet mal Yesu. <verse eid="LUK 14:2" /><verse number="3" style="v" sid="LUK 14:3" />Yek Yesu ngem ma̱n yisti mba̱t ga̱ Musa suk ma̱n Paresi ɗe, &lt;&lt;Mba̱t ga̱na̱n ba̱li ɗe ta̱ ndok mbala̱n gas shukti a?&gt;&gt; <verse eid="LUK 14:3" /><verse number="4" style="v" sid="LUK 14:4" />Yek ba̱sa̱ wule ilgon so. Yek Yesu ta̱n ma̱n cwoɓi yek ta̱ ndokti yek ta̱ wulti ɗe, &lt;&lt;Zigaa ilgon gwa.&gt;&gt; <verse eid="LUK 14:4" /><verse number="5" style="v" sid="LUK 14:5" />Yek Yesu ngem mbala̱mi ɗe, &lt;&lt;Kume yen sogo tla gwaka̱n nda ka̱ shu gas shukti go, ka yilla̱t ka ba̱le-ba̱le so ɗe gas shukti a?&gt;&gt; <verse eid="LUK 14:5" /><verse number="6" style="v" sid="LUK 14:6" />Yek ba̱sa̱ mbi ilga̱ dla̱mi so.<verse eid="LUK 14:6" /></para>
  <para style="s">Nya nalli ma̱jwe palli gaa gwasa̱n ɗe ilgon sowu</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7" />Na̱k Yesu yen ma̱jon ka̱ mbala̱n jwe sa̱ mbesi ta̱s nguk wul wu na̱ma botlti hwa lu da̱nti ga̱ kiɗi mbala̱n wu, yek ta̱ cinga̱lisi ga̱ɓa gon ɗe, <verse eid="LUK 14:7" /><verse number="8" style="v" sid="LUK 14:8" />&lt;&lt;Kume ma̱lgon mbek ka̱lu motgaa hapti wu, ba̱k lak da̱n ka̱lu da̱nti ga̱ kiɗi mbala̱n so, gon asa̱ mbe ma̱lgwe nal man ki wu. <verse eid="LUK 14:8" /><verse number="9" style="v" sid="LUK 14:9" />Ma̱lgwe mbekii mas jwaka̱n wu tul wugo, ta wule, &lt;Tlinya ka ta̱k ba̱l lu,&gt; nsha a ciki na̱k ɗe ka pal ka̱lu da̱nti gwe ba̱ nal na̱k gon wu sowu. <verse eid="LUK 14:9" /><verse number="10" style="v" sid="LUK 14:10" />Ama kume sa̱ mbek ka̱lu motgaa wugo aka̱ ngo lu da̱nti ga̱ ma̱jwe ba̱sa̱ ni ten bi ilgon sowu. Kume ma̱lgwe mbek wu tul wugo ta̱ wulki ɗe, &lt;Yela̱n gini, li te ta̱k da̱n a nde.&gt; A laki, a ma̱jwe ni ka̱li wu yen nalti gwa. <verse eid="LUK 14:10" /><verse number="11" style="v" sid="LUK 14:11" />Mas ma̱lgwe nalli gaa gwas go mbala̱n a palla̱t ɗe ilgon so, ama ma̱lgwe palli gaa gwas ɗe ilgon sogo, mbala̱n a nalla̱ti.&gt;&gt;<verse eid="LUK 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12" />Yek Yesu wul ma̱lgwe mbet ka̱lu motgaami wu ɗe, &lt;&lt;Kume ka̱ ɓa mbe mbala̱n ta̱s nguk wul a lubii ɗakka sogo ka̱lu motgaa hwol tuk wu, ba̱k mbe yela̱n jwa suk yilkeni jwa suk ma̱jwa suk yela̱n da̱nti jwa ma̱n wul ang so, na̱k ɗe gas gon wo sa mbek ka̱lu motgaa gwasa̱n pak asa̱ pa̱lik ilgwe ka̱ pa̱lisi wu. <verse eid="LUK 14:12" /><verse number="13" style="v" sid="LUK 14:13" />Ama kume ka̱ ɓa mbe ma̱jon ka̱lu motgaa hwol tuki go, aka̱ mbe ma̱jwe ba̱ ilgon nisi ɗa sowu suk ma̱jwe man la̱t na̱ asa̱n sowu, suk ma̱jwe tli gwasa̱n tla ka̱wu suk dwa. <verse eid="LUK 14:13" /><verse number="14" style="v" sid="LUK 14:14" />Na̱ nu ka̱n ka mbi hwa wul ga̱ Nya, na̱k ɗe si wo sa man ɓatlti gwa sowu. Nya ka ɓatlki gas gwe ma̱n pa̱lti zok wul a tlinya tot ka̱ gaa zukɗi gwasa̱n kaami wu.&gt;&gt;<verse eid="LUK 14:14" /></para>
  <para style="s">Cinga̱lti ga̱ɓa ten bal motgaa hwol tuki</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15" />Yek ma̱lgon ɗe ta̱ ni suksi wu kumi nu wugo yek ta̱ wule, &lt;&lt;Ma̱n mbit hwa wul ga̱ Nya ka̱ɗe ma̱lgwe a nguk wul ka̱ motgaa hwol tuki suk ma̱jwe kan Almasihu ɗe guu ka̱ mbadl gwasa̱n wu.&gt;&gt; <verse eid="LUK 14:15" /><verse number="16" style="v" sid="LUK 14:16" />Yek Yesu wulti ɗe, &lt;&lt;Ma̱lgon ni ɗa, ta̱ mbe mbala̱n wonti ka̱lu bal motgaa ngukti wul gwe ta pa̱li wu. <verse eid="LUK 14:16" /><verse number="17" style="v" sid="LUK 14:17" />Yek motgaami ɓalɗa̱ go yek ta̱ shin zhel gwasi ta̱s hwi ma̱jwe ta̱ mbesi ka̱lu motgaami wu ta̱s li te. <verse eid="LUK 14:17" /><verse number="18" style="v" sid="LUK 14:18" />Yek mas jwasa̱n sa̱ ngusi dla̱mti iljwe a laki a ba̱sa mbi la̱t ka̱lu motgaami sowu. Yek gwe nda ga̱ɓa wu wule, &lt;Aya wul lu zhin, a lam la̱t yenti.&gt; Yek ta̱ wule ta̱ ma̱li tlo mbadli. <verse eid="LUK 14:18" /><verse number="19" style="v" sid="LUK 14:19" />Yek gon po wule, &lt;Aya wul tla gut zhin ɗe kutl, ba ta̱lasi ta̱s nda gut zhin, lak wul ma̱li ɗe ta̱s tlo mbadli.&gt; <verse eid="LUK 14:19" /><verse number="20" style="v" sid="LUK 14:20" />Yek gon po wule, &lt;Ka̱ multi jee ka̱n aya pa̱l pyal kili. Ba mbi la̱t so.&gt; <verse eid="LUK 14:20" /><verse number="21" style="v" sid="LUK 14:21" />Yek zheli lak hwi baboomi mas ilgwe sa̱ hwit wu. Yek mbadl ga̱ baboomi lil i'e yek ta̱ wul zheli ɗe, &lt;Li ka̱ ba̱mi aka̱ ma̱tl ɗa̱nka aka̱ mbe ma̱jwe ba̱ ilgon nisi ɗa̱ sowu suk ma̱jwe man la̱t na̱ asa̱n sowu suk ma̱jwe tli gwasa̱n tla ka̱wu suk dwa.&gt; <verse eid="LUK 14:21" /><verse number="22" style="v" sid="LUK 14:22" />Yek ta̱ pal wugo, yek ta̱ wul baboomi ɗe, &lt;Baboo, a pa̱l ilgwe ka̱ dla̱m wu yi, ama hal ninge naa lu yi.&gt; <verse eid="LUK 14:22" /><verse number="23" style="v" sid="LUK 14:23" />Yek baboomi wulti ɗe, &lt;Kop tantu ta̱k li ka̱ nak mil ba̱n ta̱k mbe mbala̱n teɗi ta̱ lwisi njika̱n.&gt; <verse eid="LUK 14:23" /><verse number="24" style="v" sid="LUK 14:24" />A ni kii ma hwiti ɗe ma̱jwe sa̱ mbesi cina ka̱lu motgaami jo, gon a tul ɗe ta̱s la̱m ilga̱ nguki ga̱ motgaa hwol tuk gwe a pa̱li wu so.&gt;&gt;<verse eid="LUK 14:24" /></para>
  <para style="s">Bomti kopti ga̱ Yesu</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25" />Mbala̱n wonti na̱ma kopti ga̱ Yesu yek ta̱ balla̱t malsi yek ta̱ wulsi ɗe, <verse eid="LUK 14:25" /><verse number="26" style="v" sid="LUK 14:26" />&lt;&lt;Mas ma̱lgwe lam kopti gini a ba̱ta̱ nge aba gwasi suk ana gwasi suk kili gwasi suk mil jwasi suk yilkeni modli suk maani, yek ta̱ nge gaa gwas pak sogo, ta man da̱nti ɗe ma̱n kopti gi so. <verse eid="LUK 14:26" /><verse number="27" style="v" sid="LUK 14:27" />Mas ma̱lgwe kan bomti gwe ni ka̱ kopti gi sogo, ta̱ ɓo mbuk da̱nti ɗe ma̱n kopti gi so.<verse eid="LUK 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28" />&lt;&lt;Kume ka̱ lam kinti lubii ma̱n wulpi go, se ka̱ da̱mi yek ka̱ yen kangwe ka pa̱li wu suk wulpi gwe a kinik lubiimi wu, ko ilgwe nik ɗa̱ wu a kumik kinti lubiimi. <verse eid="LUK 14:28" /><verse number="29" style="v" sid="LUK 14:29" />Kume ka̱ lak zhila biimi yek ba̱ka̱ man pakti kinti sogo, mbala̱n a gitliki. <verse eid="LUK 14:29" /><verse number="30" style="v" sid="LUK 14:30" />Sa wule, &lt;Ma̱lga̱n go ka̱dla̱n ka̱n, ta̱ nda kinti bii yek ba̱ta̱ man pakti so.&gt;<verse eid="LUK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31" />&lt;&lt;Sogo kume guu ga̱ ba̱n gon gwe ma̱n hapti dlo jwas wo zangu ɗe kutl wu a la dlanti suk guu ga̱ ba̱mi gon gwe ma̱n hapti dlo jwas wo zangu ɗe kutl ɗe lop wu. A ba̱ta da̱n ɗe ta̱s yeni ko ta mana̱n dlanti suk guu gwisi so so? <verse eid="LUK 14:31" /><verse number="32" style="v" sid="LUK 14:32" />Kume ta mani sogo, ata̱ shin mil shinti mal guumi, ata̱ yi dlenti, ta̱s ngo ta̱mti da̱nti ka̱ dlo gwas sukti. <verse eid="LUK 14:32" /><verse number="33" style="v" sid="LUK 14:33" />Nu ka̱n kume ka̱ zak mas wul jwaka̱n sogo, ka man da̱nti ɗe ma̱n kopti gi so.<verse eid="LUK 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34" />&lt;&lt;Kwi wo hwa wul ka̱n, ama lilka̱ wugo, na̱ yek a la̱kmi ye? <verse eid="LUK 14:34" /><verse number="35" style="v" sid="LUK 14:35" />Mbala̱n a po pa̱l ilgon na̱ nali so na̱k ɗe ba̱sa wuti wo ka̱ zhin sowu. Wutti ka̱n sa wut ka. Ma̱lgwe ka̱n kumti niɗɗa̱ wu, ha̱n ta̱s kumi.&gt;&gt;<verse eid="LUK 14:35" /></para>
  <chapter eid="LUK 14" />
  <chapter number="15" style="c" sid="LUK 15" />
  <para style="s">Cinga̱lti ga̱ɓa ten mba̱la gwe gil ka̱wu</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1" />Gas gon, ma̱n kanti wulpi boo suk ma̱jwe ba̱sa pa̱l hwa wul sowu tul mal Yesu wonti ta̱s kum ga̱ɓa gwasi. <verse eid="LUK 15:1" /><verse number="2" style="v" sid="LUK 15:2" />Yek ma̱n Paresi suk ma̱n yisti mba̱t ga̱ Musa nda nala̱nti ɗe Yesu kan ma̱nda̱ki ga̱ ma̱jwe ba̱sa pa̱l hwa wul sowu ata̱ na̱ma ngukti wul suksi.<verse eid="LUK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 15:3" />Yek Yesu hwisi ga̱ɓa gon ɗe, <verse eid="LUK 15:3" /><verse number="4" style="v" sid="LUK 15:4" />&lt;&lt;Wok ka̱ kii gwe ɗe mba̱la ɗe kutl ɗe kutl a nit ɗa a ɗe na̱m gil ka, a ba̱ta zak kutl ɗe topsi na̱ topsi ka̱lu ɗe na̱m ka̱ me ata̱ la ngot ga̱ ɗe na̱m wu se ta̱ mbit so wo? <verse eid="LUK 15:4" /><verse number="5" style="v" sid="LUK 15:5" />Ta̱ mbit wugo ata̱ pa̱l hwol tuki ata̱ kanti a yal. <verse eid="LUK 15:5" /><verse number="6" style="v" sid="LUK 15:6" />A ta̱ ta̱lat lubii apaa ta̱ mbe yela̱n jwasi suk yela̱n da̱nti ta̱s pa̱l hwol tuk sukti na̱k ɗe ta̱ mbi mba̱la gwas gwe gil ka̱wu. <verse eid="LUK 15:6" /><verse number="7" style="v" sid="LUK 15:7" />A ni kii ma hwiti ɗe, nu ka̱n Nya suk mil shinti jwas a pa̱l hwol tuki nal na̱ ma̱n byas wul ɗe na̱m gwe ci atl gaa mal Nya wu man ma̱n pa̱lti zok wul ɗe kutl ɗe topsi na̱ topsi jwe a po ci atl gaa sowu.<verse eid="LUK 15:7" /></para>
  <para style="s">Cinga̱lti ga̱ɓa ten wulpi gwe gil ka̱wu</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8" />&lt;&lt;Sogo ta̱ wulpi ni kili mbala̱n gon ɗa azurfa ɗe kutl, yek ɗe na̱m gil ka. Ta ɓa̱s wutu ata̱ taas gibboomi ka ata̱ ngwe mas lu gwe ni wu se ta mbi. <verse eid="LUK 15:8" /><verse number="9" style="v" sid="LUK 15:9" />Kume ta̱ mbi wugo, ta̱ mbe yela̱n jwasi suk yela̱n da̱nti ta̱s pa̱l hwol tuk sukti na̱k ɗe ta mbi wulpi gwas gwe gil ka̱wu. <verse eid="LUK 15:9" /><verse number="10" style="v" sid="LUK 15:10" />A ni kii ma hwiti ɗe, nu ka̱n ani ɗe wul hwol tuk mal Nya suk mil shinti jwasi ɗe ma̱n byas wul ɗe na̱m ci atl gaa wu.&gt;&gt;<verse eid="LUK 15:10" /></para>
  <para style="s">Cinga̱lti ga̱ɓa ten yen gwe gil ka̱wu</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11" />Yek Yesu wule, &lt;&lt;Ma̱lgon ni ɗa̱ ma̱n mil maani ɗe lop. <verse eid="LUK 15:11" /><verse number="12" style="v" sid="LUK 15:12" />Yek ma̱ngaɓi wu wul aba gwasa̱n ɗe, &lt;A lami ɗe ta̱k ba̱la̱n gi ka̱ ilgwe ka zaki ni kaal ɗa̱ ma̱shka̱n gwa wu ninge, ba ɓa̱ti ta̱k ma̱sh paa so.&gt; Yek abe huulisi wul jwasi.<verse eid="LUK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 15:13" />&lt;&lt;La̱m multi wugo yek yeni yem wul jwasi mas yek ta̱ zigaa ka̱ atl gon dlenti, yek ta̱ lil mas wul jwas ka ten byas da̱nti. <verse eid="LUK 15:13" /><verse number="14" style="v" sid="LUK 15:14" />Yek wul jwas paki ka̱wu, yek bal kuza̱n gon te ka̱ ba̱mi, yek yeni te ka̱ bomti na̱k ɗe ilgon poyit sowu. <verse eid="LUK 15:14" /><verse number="15" style="v" sid="LUK 15:15" />Yek ta̱ ngo ilga̱ pa̱li mal ma̱lgon ka̱ ba̱mi yek ma̱li ba̱lti kyo alade gwasi. <verse eid="LUK 15:15" /><verse number="16" style="v" sid="LUK 15:16" />Yek ba̱sa̱ ba̱lti ilga̱ nguki so, yek ta̱ lami ɗe ta̱s nguk ilga̱ nguki ga̱ aladesi. Yek ba̱ta̱ mbi so.<verse eid="LUK 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 15:17" />&lt;&lt;Yek ta̱ lak pal ka̱ hwa daamti gwas wugo yek ta̱ wul ka̱ mbadl gwas ɗe, &lt;Zhel ji aba gi na̱ma ngukti asa̱ na̱ma tlati, a ilga̱ nguki nisi ɗa nal, ama ami wo amikgu ten tlat kuza̱n wule ba ma̱shinni. <verse eid="LUK 15:17" /><verse number="18" style="v" sid="LUK 15:18" />Ba pal to mal aba gi ka aa wulti ɗe: Aba, a pa̱li Nya byas wul yek a pa̱lik pak. <verse eid="LUK 15:18" /><verse number="19" style="v" sid="LUK 15:19" />A po mbuk da̱nti ɗe yen gwa so, kama̱n na̱k zhel gwa.&gt;<verse eid="LUK 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 15:20" />&lt;&lt;Yek ta̱ nda tantu ka̱li taɓa to mal aba gwasi.</para>
  <para style="p" vid="LUK 15:20">&lt;&lt;Ama yek abe yisti tet dlenti yek gonti gwas citi yek ta̱ tlinya na̱ apti yek ta̱ ngipti te dlo ka yek ta̱ ngusi swatti gwasi.<verse eid="LUK 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 15:21" />&lt;&lt;Yek yeni wulti ɗe, &lt;Aba, a pa̱li byas wul Nya yek a pa̱lik pak, a po mbuki ta̱k mbe ɗe yen gwa so.&gt;<verse eid="LUK 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 15:22" />&lt;&lt;Yek abe wul zhel gwas ɗe, &lt;La̱n na̱ apti ta̱k kama̱n luka̱l gwe mbun mani wu teɗi suk zobbe suk kapta̱lan. <verse eid="LUK 15:22" /><verse number="23" style="v" sid="LUK 15:23" />Aka̱ dop tla gwe bas mani wu teɗi aka̱ mboshi ama̱ palla̱n hwol tuki. <verse eid="LUK 15:23" /><verse number="24" style="v" sid="LUK 15:24" />Na̱k ɗe yen gi go ta̱ ma̱shi yek ningo ta pal wi, ta̱ gilka yek ningo a mbit wi.&gt; Yek sa̱ pa̱l hwol tuk i'e.<verse eid="LUK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25" />&lt;&lt;A ba̱ ma̱nkolisi ni lubii so ata̱ ni ka̱ zhin, yek ta̱ pal wugo yek ta̱ ngusi kumti ɓot gan-gan suk wulti koo suk dlalti a lubii ɗaasika. <verse eid="LUK 15:25" /><verse number="26" style="v" sid="LUK 15:26" />Yek ta̱ mbe zhel gon gwasa̱n ta̱s kum ga̱s ilgwe na̱ma pa̱t wu? <verse eid="LUK 15:26" /><verse number="27" style="v" sid="LUK 15:27" />Yek zheli wulti ɗe, &lt;Ma̱ngaɓi gwa ka̱ pal wi, yek aba gwaka̱n laki yek sa̱ mbosh tla gwe bas mani wu ta̱ mbala̱n pa̱l hwol tuk sukti na̱k ɗe yilka gwa pal boo ka̱ ta̱mti wu.&gt;<verse eid="LUK 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28" />&lt;&lt;Yek mbadl lili ma̱nkolisi i'e yek ta̱ nge tet gibboo, yek abe yil tot gibboomi yek ta̱ ba̱lti bi ta̱s te gibboo. <verse eid="LUK 15:28" /><verse number="29" style="v" sid="LUK 15:29" />Yek ta̱ wule abe ɗe, &lt;Yek na̱k gwe? Mas da̱nti gwe a da̱n sukki wu, a nikma pa̱lti wul na̱k zhel, a mas ilgwe ka̱ lami go a pa̱liki, ama ko ga̱ cin ɗe na̱m ka̱ pa̱li ilgon nu so, a ba̱ka̱ ba̱la̱n ko ta̱ yen mal ɗe ta mboshi a mo mbala̱n ji so. <verse eid="LUK 15:29" /><verse number="30" style="v" sid="LUK 15:30" />Ama yek yen gwa pal wi kaal ɗa̱ tlot wulpi gwa ka ten muka̱l modli, yek ka̱ mbe mbala̱n yek ka̱ mboshit tla gwe bas mani wu.&gt;<verse eid="LUK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 15:31" />&lt;&lt;Yek abe wulti ɗe, &lt;Yen gini, ka̱ ni suk ami ko gasi, mas wul ji wo jwaka̱n. <verse eid="LUK 15:31" /><verse number="32" style="v" sid="LUK 15:32" />Mbun ɗe ta̱n pa̱l hwol tuki na̱k ɗe yilka gwa ma̱shi yek ta̱ tli ɗa̱ka̱ ma̱shka̱n ka wu, ta̱ gili yek ningo ta̱ pal boo wu.&gt; &gt;&gt;<verse eid="LUK 15:32" /></para>
  <chapter eid="LUK 15" />
  <chapter number="16" style="c" sid="LUK 16" />
  <para style="s">Cinga̱lti ga̱ɓa ten ma̱lgon ɗe ba̱ta̱ pa̱l gem ten ngipti wul ga̱ baboo gwas sowu</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1" />Yek Yesu wul ma̱n kopti jwas ɗe, &lt;&lt;Ma̱n wul gon ni ɗa gwe kan ma̱lgwe a pa̱lit wulbo gwas wu, ama yek ta̱ lak kumi ɗe ma̱li nitma lilti wul ka. <verse eid="LUK 16:1" /><verse number="2" style="v" sid="LUK 16:2" />Yek baboomi mbet su gibboo ka, yek ta̱ wulti ɗe, &lt;A kumi ɗe ka̱ nima lilti wul ka. Lak hwi kangwe ka̱ na̱ma pa̱lti wulbo gi wu ga̱ la̱shi, ka po da̱n ɗe ma̱n pa̱lti wul ga̱ boo gi so.&gt;<verse eid="LUK 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 16:3" />&lt;&lt;Yek ma̱li wul ka̱ mbadl gwas ɗe, &lt;Baboo gi mbola̱n wugo, ba pa̱n nii? Na̱k ɗe ba̱ nda̱lti kolti zhin ka̱ niɗɗa̱ sowu, a nsha ngemti wul ka cin wu.&gt; <verse eid="LUK 16:3" /><verse number="4" style="v" sid="LUK 16:4" />Yek ta̱ po wule, &lt;A yis ilgwe ba pa̱li ɗe ta̱ naa mbala̱n pa̱l ɗem na̱ ami a lubii ɗaasika wu wi.&gt;<verse eid="LUK 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5" />&lt;&lt;Yek ta̱ mbe mas ma̱jwe baboo gwas na̱ma kopti gwasa̱n duul wu, yek ta̱ ngem ma̱lgwe la̱t tet cina wu ɗe, &lt;Na̱mi kan baboo gi na̱ma kopti gwa?&gt;<verse eid="LUK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 16:6" />&lt;&lt;Yek ta̱ wulti ɗe, &lt;Ta̱ na̱ma kopti gi bunta̱n mili zamba̱l ɗe wusupsi.&gt; Yek ma̱li wulti ɗe, &lt;Da̱m atli ta̱k lish zamba̱l ɗe wupsi.&gt;<verse eid="LUK 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 16:7" />&lt;&lt;Yek ta̱ po ngem gon ɗa̱ɗe, &lt;A kii hwa, na̱mi kan ta̱ na̱ma kopti gwa?&gt;</para>
  <para style="p" vid="LUK 16:7">&lt;&lt;Yek ta̱ wulti ɗe, &lt;Bal ngura zamba̱l ɗe na̱m ga̱ alkama.&gt;</para>
  <para style="p" vid="LUK 16:7">&lt;&lt;Yek ta̱ wulti ɗe, &lt;Kan wul lishti ta̱k lish kutl ɗe wusupsi.&gt;<verse eid="LUK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 16:8" />&lt;&lt;Yek baboomi kum ilgwe ma̱n pa̱lti wulbo gwas na̱ma pa̱lti wu wugo, yek ta̱ ta̱s byas ɓotlka̱n gwasi, na̱k ɗe mbala̱n ji ninge man pa̱t na̱ mbala̱n jwasa̱n ji se man ma̱jwe ni ka̱ cilti ga̱ Nya wu.&gt;&gt; <verse eid="LUK 16:8" /><verse number="9" style="v" sid="LUK 16:9" />Yek Yesu po wule, &lt;&lt;A ni kii ma hwiti, pa̱la̱n wul na̱ wul ang gwaka̱n ta̱k mbi yela̱n ɗa. Na̱ nu ka̱n kume wul gwaka̱n paki wugo sa pikii ɗem ka̱ boo ga̱ Nya.<verse eid="LUK 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 16:10" />&lt;&lt;Ma̱lgwe pa̱l gem ten ngipti nak'en wul go, ta man pa̱lti gem ten ngipti kakshe. Ma̱lgwe pa̱l gem ten nak'en wul sogo, ta mani ten kakshe so pak. <verse eid="LUK 16:10" /><verse number="11" style="v" sid="LUK 16:11" />A kume ka̱ pa̱l gem ten ngipti wul ji dii atl sogo, wok ka ba̱lkii hwa wul ga̱ Nya wo? <verse eid="LUK 16:11" /><verse number="12" style="v" sid="LUK 16:12" />A kume ka̱ pa̱l gem ten ngipti wul ji ma̱lgon sogo, wok ka ba̱lkii gwaka̱n wo?<verse eid="LUK 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13" />&lt;&lt;Mbala̱n a man da̱nti ɗe zhel ga̱ baboo ɗe lop so, a kume ta̱ pa̱li nu go, ta nge gon ata̱ lam gon, sogo a ta pa̱li hwa wul gon ata̱ mbul gon. Ka man da̱nti ɗe zhel ga̱ Nya suk zhel ga̱ wulpi so.&gt;&gt;<verse eid="LUK 16:13" /></para>
  <para style="s">Yesu hwi ga̱ɓa ma̱n Paresi</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14" />Na̱k ɗe ma̱n Paresi wo ma̱n lamti wulpi ka̱n i'e wu, yek sa̱ kumi nu wugo yek sa̱ desit njwaa. <verse eid="LUK 16:14" /><verse number="15" style="v" sid="LUK 16:15" />Yek ta̱ wulsi ɗe, &lt;&lt;Kik ɗe ma̱n lamti ɗe ta̱ mbala̱n yenki ɗe ma̱n zok mbadli, ama Nya yis mbadl gwaka̱n. Ilgwe mbala̱n yeni ɗe hwaɓi go, yek ka̱n Nya a ngeti.&gt;&gt;<verse eid="LUK 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16" />Yek Yesu po wul ma̱n Paresisi ɗa̱ɗe, &lt;&lt;Mba̱t ga̱ Musa suk lishti ji ma̱n dla̱mti ga̱ɓa ga̱ Nya ka̱ ni ɗa, yek Yohana ma̱n baptisma tuli, ama na̱k sa̱ dla̱m ga̱ɓa ma̱n ta̱mti ten kangwe mbala̱n a kan Nya ɗe guu ka̱ mbadl gwasa̱n wu, yek mbala̱n na̱ma tlot gwasa̱n i'e ta̱s te giɓi. <verse eid="LUK 16:16" /><verse number="17" style="v" sid="LUK 16:17" />Tlo nya suk dii atl a man pakti ama ko njet ka̱ mba̱t ga̱ Musa wo gon a paki so.<verse eid="LUK 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18" />&lt;&lt;A ma̱lgwe huul suk kili gwasi yek ta̱ kan zopsi kili go ta̱ na̱ma pa̱t pa̱la̱n, a ma̱lgwe kan kili gwe huul suk kos gwas go, sa̱ na̱ma pa̱t pa̱la̱n pak.&gt;&gt;<verse eid="LUK 16:18" /></para>
  <para style="s">Yesu dla̱m ga̱ɓa ten ma̱n wul gon suk ma̱lgwe ba̱ ilgon niɗɗa̱ sowu</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19" />Yek Yesu wule, &lt;&lt;Ma̱lgon ni ɗa̱ ma̱n wul, ata̱ lak luka̱l ma̱n wulpi ata̱ nguk hwa ilga̱ nguki ko gasi. <verse eid="LUK 16:19" /><verse number="20" style="v" sid="LUK 16:20" />A ma̱lgon ni ten bi dlaboo gwasi asa̱ mbet ɗe Liazaru ma̱lgwe tli gwas wo mas usu wu a ma̱n ngemti wul ka̱ɗe ti. <verse eid="LUK 16:20" /><verse number="21" style="v" sid="LUK 16:21" />A Liazaru ɓa̱t ilga̱ nguki gwe a lok sut ten lu ngukti ga̱ ma̱n wul wu, a kaɗi la̱pti usu gwe nit ten tli wu.<verse eid="LUK 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22" />&lt;&lt;Ni nugo yek Liazaru lak ma̱shi yek mil shinti ji Nya sak kanti yek sa̱ ba̱lti hwa lu da̱nti ka̱ boo ga̱ Nya ka̱lu gwe Ibirahim ni wu. Yek ma̱n wul wu mago yek ta̱ lak ma̱shi yek sa̱ lepti. <verse eid="LUK 16:22" /><verse number="23" style="v" sid="LUK 16:23" />Yek mbadl gwas li ka̱lu da̱nti ga̱ ma̱n ma̱shka̱n yek ta̱ da̱n ka̱ bomti, yek ta̱ yen Liazaru suk Ibirahim tet dlenti. <verse eid="LUK 16:23" /><verse number="24" style="v" sid="LUK 16:24" />Yek ta̱ taki bi Ibirahim yek ta̱ wulti ɗe, &lt;Aba Ibirahim, yen gonti gini, aka̱ shin Liazaru ta̱s lak yen ang gwas ka̱ ze ta̱s nak laki sut ten la̱ka ne ta kum nda̱ɗiti ka̱ bomti ka̱n ani i'e ka̱ wutu.&gt;<verse eid="LUK 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25" />&lt;&lt;Yek Ibirahim wulti ɗe, &lt;Yen mbala̱n, daamki ɗe ka̱ yi ten dii atl go, hwa wul nik ɗa̱ a Liazaru ni ka̱ bomti, ama ningo ta̱ ɓal ka̱ ta̱mti a mala̱nni a ki wo ka̱ ni ka̱lu bomti. <verse eid="LUK 16:25" /><verse number="26" style="v" sid="LUK 16:26" />A ban na̱ nu mago, bal buu ni ka̱ tlo ga̱na̱n sukki kangwe mas ma̱lgwe ni tumalki wu a man la̱t tet ka̱lu gwe ma̱ ni wu so, aba̱ ma̱lgwe ni tumalni wu a man ɗakciti tumalki so.&gt;<verse eid="LUK 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 16:27" />&lt;&lt;Yek ma̱n wuli wulti ɗe, &lt;Aba Ibirahim, a na̱ma ngemti gwa, ta̱k shin Liazaru ta̱s su lubii ɗa̱ aba gi ka. <verse eid="LUK 16:27" /><verse number="28" style="v" sid="LUK 16:28" />Yilkeni ni ɗa ɗe namtan ta̱s suk hwisi ba̱s kop tantu gwe a koɓi wu asa̱ li tet ka̱lu bomti ga̱n so.&gt;<verse eid="LUK 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29" />&lt;&lt;Yek Ibirahim wule, &lt;Mba̱t ga̱ Musa suk lishti ga̱ ma̱n dla̱mti ga̱ɓa ga̱ Nya nisi ɗa̱ ta̱s katisi ka̱n.&gt;<verse eid="LUK 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 16:30" />&lt;&lt;Yek ma̱n wuli wulti ɗe, &lt;Nuk so Aba Ibirahim, kume ma̱lgon yil tot ka̱ hwu mbala̱n yek ta̱ li malsi go sa kumi asa̱ cit atl gaa.&gt;<verse eid="LUK 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 16:31" />&lt;&lt;Ama yek Ibirahim wulti ɗe, &lt;Kume sa̱ kum ilgwe mba̱t ga̱ Musa suk lishti ji ma̱n dla̱mti ga̱ɓa ga̱ Nya nisi ma dla̱mti wu sogo, ko ta̱ ma̱lgon tlinya tot ka̱ gaa zukɗi kaami sa kumti so.&gt; &gt;&gt;<verse eid="LUK 16:31" /></para>
  <chapter eid="LUK 16" />
  <chapter number="17" style="c" sid="LUK 17" />
  <para style="s">Ga̱ɓa ten pa̱lti byas wul suk taasti ka</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1" />Yek Yesu wul ma̱n kopti jwas ɗe, &lt;&lt;Wul jwe a lak mbala̱n ten pa̱lti byas wul go a tuli, ama ma̱lgwe wul jwisi a tul tumalti go ta da̱m ɗe wul cit gonti. <verse eid="LUK 17:1" /><verse number="2" style="v" sid="LUK 17:2" />Ɗa̱ gwe ta̱ ma̱lgon lak ɗe na̱m ka̱ nak mil jee ta̱s pa̱l byas wul go, a maniti ta̱s ɓalit ye na̱kti hwoo a yal asa̱ lakti ka̱ bal ze. <verse eid="LUK 17:2" /><verse number="3" style="v" sid="LUK 17:3" />Pa̱n ɗem'ɗem na̱ gaa gwaka̱n.</para>
  <para style="p" vid="LUK 17:3">&lt;&lt;Kume yilka gwa pa̱lik byas wul wu, aka̱ matlti, a kume ta̱ ci atl gaa wu, aka̱ taasi ɗa̱ ten mbadl ka. <verse eid="LUK 17:3" /><verse number="4" style="v" sid="LUK 17:4" />Kume ta̱ pa̱lik byas wul asa̱mi ɗe nitgi ten cin ɗe na̱m ata̱ na̱ma palti tet malki asa̱mi ɗe nitgi ata̱ na̱ma cit atl gaa wu, aka̱ taasi ɗa̱ ten mbadl ka.&gt;&gt;<verse eid="LUK 17:4" /></para>
  <para style="s">Mba̱lini za̱t mbadl ten Nya dani</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5" />Yek mil shinti ji botlisi wul Bagaa ɗe, &lt;&lt;Mba̱lini za̱t mbadl ten Nya dani.&gt;&gt;<verse eid="LUK 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6" />Yek ta̱ wulsi ɗe, &lt;&lt;Kume za̱t mbadl ten Nya ni kii ɗa njet na̱k gwe daazi wu, ka man wulti ga̱ tlindi ga̱n ɗe, &lt;Ndus ɗa̱ka̱ lu gee ka ta̱k sak dla̱l ka̱ bal ze,&gt; a ilgwe ka̱a̱ dla̱m wu pi.<verse eid="LUK 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7" />&lt;&lt;Kume zhel ni gon gwaka̱n ɗa a zheli nitma kolti zhin sogo kyo mba̱la, a na̱ palti ga̱ zheli tet ka̱ zhin, a ma̱li wulti ɗe, &lt;Li te ta̱k da̱m na̱ zhila ta̱k nguk wul la?&gt; <verse eid="LUK 17:7" /><verse number="8" style="v" sid="LUK 17:8" />Ba̱ta wulti ɗe, &lt;Lak pa̱li ilga̱ nguki aka̱ ɓa̱tti ta nguki aa tla ze apaa ka̱ po nguki aka̱ tla pak&gt; sa? <verse eid="LUK 17:8" /><verse number="9" style="v" sid="LUK 17:9" />Ta pa̱l hwol tuk na̱ zheli na̱k ɗe ta̱ kop ga̱ɓa gwas wu?&gt;&gt; <verse eid="LUK 17:9" /><verse number="10" style="v" sid="LUK 17:10" />Yek Yesu po wulsi ɗa̱ɗe, &lt;&lt;Kii mago nu ka̱n, kume ka̱ pa̱l mas ilgwe sa̱ hwikii ɗe ta̱k pa̱li wu, ka wule, &lt;Mi wo zhel ka̱n jwe ba̱ma̱ ni ten bi ilgon sowu, mi wo ilgwe mbun ɗe ta̱n pa̱li wu ka̱n ma̱ na̱ma pa̱lti.&gt; &gt;&gt;<verse eid="LUK 17:10" /></para>
  <para style="s">Ma̱n gita ɗe kutl mbi ndokti</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11" />A Yesu ni ten tantu la̱t Wurshelima, yek ta̱ yil ka̱ tlo ga̱ Samariya suk Galili. <verse eid="LUK 17:11" /><verse number="12" style="v" sid="LUK 17:12" />Yek ta̱ ɓa te ka̱ nak'en ba̱n gon nu go yek ma̱n cwo gita jon ka̱ju si ɗe kutl, yek sa̱ dla̱l te dlenti ka. <verse eid="LUK 17:12" /><verse number="13" style="v" sid="LUK 17:13" />Yek sa̱ tak bi na̱ nda̱lti ɗe, &lt;&lt;Yesu, ma̱n lishti, yen gonti ga̱na̱n.&gt;&gt;<verse eid="LUK 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14" />Yek ta̱ yensi wugo, yek ta̱ wulsi ɗe, &lt;&lt;La̱n mal ma̱n Pa̱ris ta̱s yisi ɗe ka̱a̱ ndoki wi.&gt;&gt; Sa̱ ɓal ten tantu la̱t go, yek sa̱ ndoki.<verse eid="LUK 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 17:15" />Yek ɗe na̱m ka̱si yeni ɗe ta̱ ndoki wugo, yek ta̱ pal tet mal Yesu, ata̱ na̱ma ta̱sti ga̱ Nya na̱ nda̱li yal. <verse eid="LUK 17:15" /><verse number="16" style="v" sid="LUK 17:16" />Yek ta̱ lak ngus a cina ɗa̱ Yesu ka, yek ta̱ ngusa̱l gaa gwas atli, yek ta̱ pa̱l hwol tuk na̱ Yesu. A ti wo ma̱n Samariya ka̱n.<verse eid="LUK 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 17:17" />Yek Yesu wule, &lt;&lt;A wule mbala̱n ɗe kutl ka̱ mbi ndokti nwa? Na̱ topsi jon ju ɓal ko? <verse eid="LUK 17:17" /><verse number="18" style="v" sid="LUK 17:18" />Yek ba̱ ma̱lgon pal tet ɗe ta̱s ba̱l nalti Nya so se ma̱nda̱ki ga̱n ma?&gt;&gt; <verse eid="LUK 17:18" /><verse number="19" style="v" sid="LUK 17:19" />Yek Yesu wul ma̱li ɗe, &lt;&lt;Tlinya ta̱k zigaa, za̱t mbadl ten Nya gwa ndokki wi.&gt;&gt;<verse eid="LUK 17:19" /></para>
  <para style="s">Palti sut ga̱ Yen ga̱ Mbala̱n</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20" />Gas gon, yek ma̱n Paresi ngem Yesu ɗe, &lt;&lt;A gasi ka̱n ma yen tulti ga̱ Almasihu ɗe guu gwi?&gt;&gt; Yek Yesu wulsi ɗe, &lt;&lt;Gas gwe Almasihu a da̱n ɗe guu ka̱ mbadl ga̱ mbala̱n go mbala̱n a man yenti na̱ gwel so, <verse eid="LUK 17:20" /><verse number="21" style="v" sid="LUK 17:21" />aba̱ mbala̱n a wule &lt;Yek ɓal ga̱n&gt; sogo &lt;Yek tekgu&gt; so, na̱k ɗe ka̱ tlo gwaka̱n ka̱n ni wu.&gt;&gt;<verse eid="LUK 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22" />Yek Yesu po wul ma̱n kopti jwas ɗa̱ɗe, &lt;&lt;Gas gwe ka lam yenti palti sut gini Yen ga̱ Mbala̱n wu ni teɗi ama ba̱ka yeni so. <verse eid="LUK 17:22" /><verse number="23" style="v" sid="LUK 17:23" />Mbala̱n a shelkii ɗe, &lt;Tik tekgu,&gt; sogo &lt;Tik gee,&gt; ama ba̱k koɓa̱n ga̱ɓa gwasa̱n so. <verse eid="LUK 17:23" /><verse number="24" style="v" sid="LUK 17:24" />Gas palti sut gini Yen ga̱ Mbala̱n wo mbala̱n mas a yena̱nni na̱k gwe a nyaze ci bi a cilti yil tet ten ka̱t dii atl gon a li ten ka̱ti gon wu. <verse eid="LUK 17:24" /><verse number="25" style="v" sid="LUK 17:25" />Ama na̱k jwisi a ɓo pi so se ami Yen ga̱ Mbala̱n tla bomti nal paa a mbala̱n ji se a nge pak.<verse eid="LUK 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 17:26" />&lt;&lt;Na̱k gwe pi ka̱ gin ga̱ Nuhu wu nu ka̱n a pi ten gin gwe ba pal sut ten dii atl wu. <verse eid="LUK 17:26" /><verse number="27" style="v" sid="LUK 17:27" />Mbala̱n a na̱ma ngukti, asa̱ na̱ma tlati, sa̱ na̱ma hapti modli asa̱ na̱ma hapti mil jwasa̱n ka. Na̱ nu ka̱n yek cin gwe Nuhu te ka̱ jirgi wu tuli, yek bal ze yil sut tu nya suk tot tu atli yek tlo mbala̱n ka mas.<verse eid="LUK 17:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 17:28" />&lt;&lt;Nu ka̱n pi ka̱ gin ga̱ Lutu pak mbala̱n na̱ma ngukti suk tlati, asa̱ na̱ma wulti wul suk wulti ka, sa̱ na̱ma ɓakti zhin asa̱ na̱ma kinti bii. <verse eid="LUK 17:28" /><verse number="29" style="v" sid="LUK 17:29" />Ama gas gwe Lutu zak ba̱n Sodom wu, yek wutu suk wutu na̱k ze ngusi shoti sut nya yek tlosi ka mas.<verse eid="LUK 17:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 17:30" />&lt;&lt;Nu ka̱n ani ten gas gwe ami Yen ga̱ Mbala̱n a pal sut wu. <verse eid="LUK 17:30" /><verse number="31" style="v" sid="LUK 17:31" />Ten cin gwisi wo, ma̱lgwe ni to ten tlal bii gwas ka̱go ba̱s yil sut ɗe ta yem wul jwas ɗa̱ gibboo ka̱ so. Nu ka̱n mas ma̱lgwe li ka̱ zhin wu ba̱s pal lubii so. <verse eid="LUK 17:31" /><verse number="32" style="v" sid="LUK 17:32" />Ɓo daama̱nkii ten kili ga̱ Lutu. <verse eid="LUK 17:32" /><verse number="33" style="v" sid="LUK 17:33" />Mas ma̱lgwe nge ten mbadl gwas go ta mbi so ama ma̱lgwe ba̱l mbadl gwas go za̱ti ka̱n ta̱ zit ka. <verse eid="LUK 17:33" /><verse number="34" style="v" sid="LUK 17:34" />A ni kii ma hwiti ɗe, ten gas gwe na̱k gwisi a pi wu, mbala̱n ɗe lop ani ten lumulti ɗe na̱m, Nya a kan gon ata̱ zak gon. <verse eid="LUK 17:34" /><verse number="35" style="v" sid="LUK 17:35" />Modli ɗe lop a na̱ma na̱kti hwoo, Nya a kan gon ata̱ zak gon. <verse eid="LUK 17:35" /><verse number="36" style="v" sid="LUK 17:36" />Mbala̱n ɗe lop ani ka̱ zhin, Nya a kan gon ata̱ zak gon ka̱li.&gt;&gt;<verse eid="LUK 17:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37" />Yek ma̱n koptisi ngem Yesu ɗe, &lt;&lt;A'ako ka̱n na̱k gwisi a pi ko?&gt;&gt;</para>
  <para style="p" vid="LUK 17:37">Yek ta̱ wulsi ɗe, &lt;&lt;Ka̱ lu gwe hwu wul ni go, ka̱li ka̱n a zhipki mogaa.&gt;&gt;<verse eid="LUK 17:37" /></para>
  <chapter eid="LUK 17" />
  <chapter number="18" style="c" sid="LUK 18" />
  <para style="s">Cinga̱lti ga̱ɓa ten guli kili gon suk ma̱n kisti ga̱ɓa</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1" />Yek Yesu hwi cinga̱lti ga̱ɓa ma̱n kopti jwasi, kangwe sa ngusi tlot gwasa̱n ten ngemti Nya a ba̱s nak sowu. <verse eid="LUK 18:1" /><verse number="2" style="v" sid="LUK 18:2" />Yek ta̱ wulsi ɗe, &lt;&lt;Ma̱n kisti ga̱ɓa gon ni ɗa̱ ka̱ ba̱n gon, ma̱lgwe ba̱ta̱ ɓanti Nya so a ba̱ta̱ yen gonti ga̱ ma̱lgon sowu. <verse eid="LUK 18:2" /><verse number="3" style="v" sid="LUK 18:3" />A guli kili gon ni ka̱ ba̱mi pak, yek ta̱ ngusi la̱t mal ma̱n kisti ga̱ɓe ta̱s pa̱lit hwa kisti ga̱ɓa ka̱ dlo gwas suk ma̱n nget gwasi.<verse eid="LUK 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 18:4" />&lt;&lt;Yek ma̱n kisti ga̱ɓe nda ngeti, ama yek ta̱ lak wul ka̱ mbadl gwas ɗe, &lt;Ko ɗe a ɓanti Nya so aba̱ ma̱lgon hwota̱n sowu, <verse eid="LUK 18:4" /><verse number="5" style="v" sid="LUK 18:5" />ama na̱k ɗe guli kili ga̱n twe gaa na̱ ngemti wu, ba pa̱lit ilgwe ta̱ lami wu ta̱s zaka̱nni ta shuki.&gt; &gt;&gt;<verse eid="LUK 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6" />Yek Yesu Bagaa wulsi ɗe, &lt;&lt;Ɓo kuma̱n ilgwe ma̱n kisti ga̱ɓa gwe ba̱ta pa̱l gem ka kisti ga̱ɓa gwas sowu dla̱m wu. <verse eid="LUK 18:6" /><verse number="7" style="v" sid="LUK 18:7" />A ba̱ Nya a pa̱li ma̱jwe ta̱ botlsi wu hwa wul jwe sa̱ na̱ma ngemti gwas wu na̱k ɗe sa̱ na̱ma ngemti gwasi na̱ ka̱ cin na̱ ka̱ gas wu sa? Ka̱ yeni go ta ba̱lsi ilgwe sa̱ lami wu ba̱le sa? <verse eid="LUK 18:7" /><verse number="8" style="v" sid="LUK 18:8" />A ni kii ma hwiti ɗe ta ba̱lsi ilgwe sa̱ na̱ma ngemti gwas wu ba̱le-ba̱le. Ama kume ami Yen ga̱ Mbala̱n pal sut ten dii atl wugo, ba ya mbi ma̱n za̱t mbadl tena̱n ma?&gt;&gt;<verse eid="LUK 18:8" /></para>
  <para style="s">Cinga̱lti ga̱ɓa ten ba ma̱n Paresi gon suk ma̱n kanti wulpi boo</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9" />Yek Yesu po hwi cinga̱lti ga̱ɓa ma̱jwe palli gaa gwasa̱n ɗe ma̱n pa̱lti zok wul yek sa̱ mbul mas naa mbala̱n wu, <verse eid="LUK 18:9" /><verse number="10" style="v" sid="LUK 18:10" />yek ta̱ wulsi ɗe, &lt;&lt;Ma̱jon ɗe lop te ka̱lu lubii ga̱ Nya ta̱s ngemti Nya. Gon wo ba Paresi a gon wo ma̱n kanti wulpi boo. <verse eid="LUK 18:10" /><verse number="11" style="v" sid="LUK 18:11" />Yek ba Paresi wu tlinya ta̱s ngemi Nya gaa gwasi yek ta̱ wule, &lt;Nya a pa̱l hwol tuki na̱k ɗe ami wo ba̱ na̱k ma̱jwe asa̱ te mbala̱n ga̱zi, asa̱ pa̱l byas wul, asa̱ kop modli wu ka̱n ani so. A ba̱ na̱k ma̱n kanti wulpi boo ga̱ tekgu ka̱n ani so. <verse eid="LUK 18:11" /><verse number="12" style="v" sid="LUK 18:12" />Aa kul pa̱l ka̱lka̱ze asa̱mi ɗe lop ka̱ multi ɗe nitgi, aa ba̱l ɗe na̱m ka̱ kutl ga̱ mas ilgwe ni ɗa̱ wu.&gt;<verse eid="LUK 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13" />&lt;&lt;Yek ma̱n kanti wulpi boo wu dla̱l te dlenti ka, yek ta̱ kin gaa gwas giɓi, yek ta̱ zi ang gwas ten ngetli, yek ta̱ wule, &lt;Nya, yen gonti gini, ami wo ma̱n pa̱lti byas wul ka̱n.&gt; &gt;&gt;<verse eid="LUK 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 18:14" />Yek Yesu wule, &lt;&lt;A ni kii ma hwiti, ma̱n kanti wulpi boo wu li ga̱s na̱ zok mbadli na̱k ɗe Nya taas byas wul jwas ka̱wu, ba̱ na̱k ga̱ ba Paresi wu so, na̱k ɗe mas ma̱lgwe nalli gaa gwas go sa nalla̱t so, ama ma̱lgwe nalli gaa gwas sogo, sa nalla̱ti.&gt;&gt;<verse eid="LUK 18:14" /></para>
  <para style="s">Yesu pa̱li ɗem mil mbala̱n</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15" />Yek ma̱jon tulli mil jwasa̱n mal Yesu ta̱s wutisi ang gaa ata̱ ngemisi Nya. Yek ma̱n kopti jwas yeni nu wugo yek sa̱ matlsi. <verse eid="LUK 18:15" /><verse number="16" style="v" sid="LUK 18:16" />Ama yek Yesu mbe mil mbala̱mi tet malti yek ta̱ wule, &lt;&lt;Zaka̱n mil mbala̱n ta̱s li tet mala̱nni, ba̱k mbola̱nsi so, na̱k ɗe Nya ka̱ɗe guu ga̱ mbala̱n ma̱n wunda̱l mbadl gwasa̱n wu.&gt;&gt; <verse eid="LUK 18:16" /><verse number="17" style="v" sid="LUK 18:17" />Yek Yesu wulsi ɗe, &lt;&lt;A ni kii ma hwit gem ɗe mas ma̱lgwe kan Nya ɗe guu ka̱ mbadl gwas na̱k ga̱ yen mbala̱n sogo Nya a da̱n ɗe guu gwas so.&gt;&gt;<verse eid="LUK 18:17" /></para>
  <para style="s">Ma̱n wul gon ga̱ɓa suk Yesu</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18" />Yek bali ga̱ ma̱n Yehuda gon wul Yesu ɗe, &lt;&lt;Hwa ma̱n lishti, yek nii ngetli ɗe ta pa̱li a mbi Nya boo ye?&gt;&gt;<verse eid="LUK 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19" />Yek Yesu wulti ɗe, &lt;&lt;Yek laki yek ka̱ mbe ɗe &lt;hwaɓi&gt; ye? Ma̱lgon ni hwaɓi so se Nya. <verse eid="LUK 18:19" /><verse number="20" style="v" sid="LUK 18:20" />Ka̱ yis ilgwe mba̱t ga̱ Musa dla̱m wu ɗe, &lt;Ba̱k kop modli so, a ba̱k tlo ma̱lgon so, a ba̱k pi muka̱l so, a ba̱k sheli lal ma̱lgon gaa so. A ka̱ ba̱l nalti aba gwa suk ana gwa.&gt; &gt;&gt;<verse eid="LUK 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21" />Yek ma̱li wule, &lt;&lt;Mas jo a koɓi wi aa yi nak'eni.&gt;&gt;<verse eid="LUK 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22" />Yek Yesu kumi nu wugo yek ta̱ wul ma̱li ɗe, &lt;&lt;Wul ɗe na̱m yii gwe ba̱ka̱ ɓo pa̱li sowu, yek ɗe, lak wul wul jwa ka mas aka̱ ba̱l wulpi ma̱jwe ba̱ ilgon nisi ɗa̱ sowu ta̱k mbi wul to nya ka̱ɗa, a paa ka̱ li te aka̱ koɓa̱nni.&gt;&gt;<verse eid="LUK 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 18:23" />Yek ta̱ kumi nu wugo yek mbadl liliti na̱k ɗe ti wo ma̱n wul ka̱n i'e wu. <verse eid="LUK 18:23" /><verse number="24" style="v" sid="LUK 18:24" />Yesu yeni ɗe mbadl lili ma̱li wugo yek ta̱ wule, &lt;&lt;A bomi ta̱ ma̱n wul kan Nya ɗe guu ka̱ mbadl gwasa̱n. <verse eid="LUK 18:24" /><verse number="25" style="v" sid="LUK 18:25" />Ma̱n wul a man kanti ga̱ Nya ɗe guu ka̱ mbadl gwasa̱n so na̱k kangwe a bomi rakumi gaa ta̱s te ka̱ shu alipla wu.&gt;&gt;<verse eid="LUK 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26" />Mbala̱n kumi nu wugo yek sa̱ ngem Yesu ɗe, &lt;&lt;Kume nu ka̱n ni go wok Nya kisti wo?&gt;&gt;<verse eid="LUK 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27" />Yek Yesu wulsi ɗe, &lt;&lt;Ilgwe man ngetl ga̱ mbala̱n go mal Nya wo man pa̱t ka̱n.&gt;&gt;<verse eid="LUK 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28" />Yek Biturus wulti ɗe, &lt;&lt;Yekgu ma̱ zak wul jina̱n wi mas yek ma̱ kopki.&gt;&gt;<verse eid="LUK 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29" />Yek Yesu wule, &lt;&lt;A yisi nu yek laki yek a ni kii ma hwit gem ɗe, mas ma̱lgwe zak lubii suk kili suk yilkeni suk ma̱n za̱t jwasi suk mil jwasi ten kanti ga̱ Nya ɗe guu ka̱ mbadl gwas go, <verse eid="LUK 18:29" /><verse number="30" style="v" sid="LUK 18:30" />ta mbi wul nal ninge. Kaal ɗa̱ ma̱shka̱n gwas wo ata̱ mbi Nya boo.&gt;&gt;<verse eid="LUK 18:30" /></para>
  <para style="s">Yesu po dla̱m wunda̱l ma̱shka̱n gwe ta̱ ma̱sh wu</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31" />Yek Yesu mo ma̱n kopti jwas ɗe kutl cet lop ju ka̱lu ɗe na̱m yek ta̱ wulsi ɗe, &lt;&lt;Ma to Wurshelima, a mas iljwe ma̱n dla̱mti ga̱ɓa ga̱ Nya lishi ten ami Yen ga̱ Mbala̱n wu a da̱n ɗe gem. <verse eid="LUK 18:31" /><verse number="32" style="v" sid="LUK 18:32" />Sa ba̱l bi gi ma̱jwe ba̱ Ma̱n Yehuda ka̱ sowu, asa̱ wuli wul jon, asa̱ byala̱nni, asa̱ ba̱ze ɓaka̱n ten tli. <verse eid="LUK 18:32" /><verse number="33" style="v" sid="LUK 18:33" />Sa ɓo na̱ tlemndi, asa̱ tloni. Ama ba nda cin ɗe mekan wugo ba tli ɗa̱ka̱ ma̱shka̱n ka.&gt;&gt;<verse eid="LUK 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34" />Ama yek ba̱sa̱ yis ilgwe ta̱ nisi ma hwiti wu so. Sa̱ hwuda̱lisi ga̱ɓe ka yek laki ɗe ba̱sa̱ yis gaami sowu.<verse eid="LUK 18:34" /></para>
  <para style="s">Yesu ndok dwa ma̱n ngemti wul gon</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35" />Yek Yesu ɓal njaa a Jeriko go yek dwa gon ka̱wu na̱ zhila ata̱ na̱ma ngemti wul ten bi tantu. <verse eid="LUK 18:35" /><verse number="36" style="v" sid="LUK 18:36" />Ta̱ kum la̱t ga̱ wonti mbala̱n wugo yek ta̱ kum ga̱zi ɗe, &lt;&lt;Yek na̱ma pa̱t ye?&gt;&gt;<verse eid="LUK 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 18:37" />Yek sa̱ wulti ɗe, &lt;&lt;Yesu ga̱ Nazarat ka̱ na̱ma la̱ti.&gt;&gt;<verse eid="LUK 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38" />Yek ta̱ tlil yal nya na̱ nda̱lti yek ta̱ wule, &lt;&lt;Yesu ga̱s ga̱ Dauda guu Israila, yen gonti gini.&gt;&gt;<verse eid="LUK 18:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39" />Yek ma̱jwe ni cina wu matlti ɗe ta̱s zak ga̱ɓa, ama yek ta̱ mba̱l tlilti yal nya dani yek ta̱ wule, &lt;&lt;Ga̱s ga̱ Dauda guu Israila, yen gonti gini.&gt;&gt;<verse eid="LUK 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40" />Yek Yesu dla̱li yek ta̱ hwisi ɗe ta̱s ta̱la dwami tet malti. Ta̱ ɓal njaa mal Yesu go yek Yesu ngemti ɗe, <verse eid="LUK 18:40" /><verse number="41" style="v" sid="LUK 18:41" />&lt;&lt;Yek ka̱ lami ɗe ta pa̱lik ye?&gt;&gt;</para>
  <para style="p" vid="LUK 18:41">Yek ta̱ wule, &lt;&lt;Bagaa, lamti gi wo ta̱ gwel gi ɓuli ta yen lu.&gt;&gt;<verse eid="LUK 18:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42" />Yek Yesu wulti ɗe, &lt;&lt;Ta̱ gwel gwa ɓuli ta̱k yen lu. Za̱t mbadl ten Nya gwa ndokki wi.&gt;&gt; <verse eid="LUK 18:42" /><verse number="43" style="v" sid="LUK 18:43" />Yesu na̱ma dla̱mti nu yek gwel gwas ɓuli yek ta̱ yen lu yek ta̱ kop Yesu ata̱ nima ba̱lti nalti Nya. Mbala̱n yeni nu wugo yek mas jwasa̱n sa̱ ta̱s Nya.<verse eid="LUK 18:43" /></para>
  <chapter eid="LUK 18" />
  <chapter number="19" style="c" sid="LUK 19" />
  <para style="s">Yesu kis Zakka ma̱n kanti wulpi boo gon</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1" />Yek Yesu koɓi tuka̱ ba̱n Jeriko. <verse eid="LUK 19:1" /><verse number="2" style="v" sid="LUK 19:2" />A ma̱lgon ni ɗa asa̱ mbet Zakka, bali ga̱ ma̱n kanti wulpi boo ka̱ɗe ti. A ma̱n wul ka̱ pak. <verse eid="LUK 19:2" /><verse number="3" style="v" sid="LUK 19:3" />Ta̱ na̱ma lamti ta̱s yen Yesu, ama ba̱ta̱ mani so na̱k ɗe ti wo ndoklan mbala̱n ka̱wu, a mbala̱n wonti ka̱li. <verse eid="LUK 19:3" /><verse number="4" style="v" sid="LUK 19:4" />Yek ta̱ ap te cina ka, yek ta̱ to ka̱ tlindi la̱ngali tu ka̱lu gwe Yesu a koɓi wu ta̱s yenti ɗa.<verse eid="LUK 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 19:5" />Yek Yesu ɓal ga̱s la̱ngali go yek ta̱ lak gaa nya yek ta̱ wulti ɗe, &lt;&lt;Zakka, yil suɗi, ma̱nda̱ki gwa ka̱ɗe ami ase.&gt;&gt; <verse eid="LUK 19:5" /><verse number="6" style="v" sid="LUK 19:6" />Yek ta̱ yil sut na̱ apti, yek ta̱ pa̱lit ɗem na̱ hwol tuki.<verse eid="LUK 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 19:7" />Mas mbala̱mi yeni nu wugo, yek sa̱ njel nala̱nti ɗe, &lt;&lt;Ɗa̱ ma̱n pa̱lti byas wul ka̱n ta li.&gt;&gt;<verse eid="LUK 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8" />Sa̱ ɓal lubiimi go, yek Zakka tlinya yek ta̱ wule, &lt;&lt;Bagaa, ba ba̱l tatlti dlo ga̱ wul jini ma̱jwe a yemisi wulpi ka̱wu, a ma̱jwe ba̱ ilgon nisi ɗa̱ sogo ba ba̱lsi, a ma̱jwe a tesi ga̱zi go ba pallisi asa̱mi ɗe wupsi.&gt;&gt;<verse eid="LUK 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9" />Yek Yesu wulti ɗe, &lt;&lt;Ase go kisti tuli ma̱n lubii ga̱n wi, na̱k ɗe Zakka mago ga̱s ga̱ Ibirahim ka̱wu. <verse eid="LUK 19:9" /><verse number="10" style="v" sid="LUK 19:10" />A ami Yen ga̱ Mbala̱n a tul ɗe ta ngo ma̱jwe gil ka̱wu ta kissi.&gt;&gt;<verse eid="LUK 19:10" /></para>
  <para style="s">Cinga̱lti ga̱ɓa ten zhel ma̱n gem suk gwe ba̱ gem niɗɗa̱ sowu</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11" />Sa̱ nima kati ka̱n Yesu nugo, yek ta̱ cinga̱lisi ga̱ɓa gon, na̱k ɗe ta̱ ɓal njaa ka̱ bal ba̱n Wurshelima wu, a mbala̱mi da̱n gwa we Almasihu a tul ɗe guu ten dii atli ninge-ninge. <verse eid="LUK 19:11" /><verse number="12" style="v" sid="LUK 19:12" />Yek ta̱ wule, &lt;&lt;Bal ma̱lgon ni ɗa gwe sa̱ mbet ka̱ dlenti atl gon ta̱s ba̱lti guu a paa ta̱ pal tet ka̱ atl gwasi. <verse eid="LUK 19:12" /><verse number="13" style="v" sid="LUK 19:13" />Yek ta̱ mbe ɗe kutl ka̱ zhel jwasi yek ta̱ ba̱lsi wulpi na̱k kangwe zhel a mbi ka̱ lip ɗe mekan wu mas jwasa̱n, yek ta̱ wulsi ɗe, &lt;Ngusi balla̱t wulpi se gas gwe a pal wu.&gt; Yek ta̱ zigaa.<verse eid="LUK 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 19:14" />&lt;&lt;A ba̱ ma̱n atli lami ɗe ta̱s da̱n ɗe guu gwasa̱n so, yek sa̱ shin mil shinti kaal ɗa̱ ti ta̱s lak dla̱m ɗe sa̱ lamti ɗe guu so.<verse eid="LUK 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15" />&lt;&lt;Sa̱ ba̱lti guumi wugo yek ta̱ pal tet ka̱ atli, yek ta̱ mbe zhel jwe ta̱ ba̱lsi wulpi ɗe ta̱s ngusi balla̱ti wu, ta̱s ɓo yeni na̱mi kan ta̱ mbi mba̱lti dani.<verse eid="LUK 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 19:16" />&lt;&lt;Yek gon li tet malti yek ta̱ wulti ɗe, &lt;Baboo, wulpi gwe ka̱ ba̱la̱n go a mbi ɗe kutl dani wi.&gt;<verse eid="LUK 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 19:17" />&lt;&lt;Yek baboomi wulti ɗe, &lt;Mbun wi, ka̱ pa̱l gem ten nak'en wul, ba za̱k ɗe guu ga̱ kiɗi ba̱n ɗe kutl.&gt;<verse eid="LUK 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 19:18" />&lt;&lt;Yek zheli na̱ lop wu wul baboomi ɗe, &lt;A mbi mba̱lti ɗe namtan ten gwe ka̱ ba̱la̱n wu.&gt;<verse eid="LUK 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 19:19" />&lt;&lt;Yek baboomi wulti ɗe, &lt;Ka da̱n ɗe guu ga̱ kiɗi ba̱n ɗe namtan.&gt;<verse eid="LUK 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 19:20" />&lt;&lt;Yek zhel na̱ mekan wul baboomi ɗe, &lt;Baboo, kan wulpi gwa, ɓanti gwa cinni yek a kus ka̱ nak'en tutul yek a hwuda̱li ka. <verse eid="LUK 19:20" /><verse number="21" style="v" sid="LUK 19:21" />Na̱k ɗe kyo ba̱ mbala̱n a yis gaa gwa sowu, a da̱nti sukki bomi, a lamti wul ten koo lu ka̱wu, na̱k ɗe aka̱ wotl ilgwe ba̱ kik ɓak sowu.&gt;<verse eid="LUK 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 19:22" />&lt;&lt;Yek ta̱ wulti ɗe, &lt;Kiyo byas zhel ka̱n, ba nolki na̱k gwe ka̱ yisa̱n wu. Kume ka̱ yisi ɗe ami wo ma̱n bomti ka̱n a ma̱n lamti wul ten koo lu suk ma̱n wotlti ilgwe ba̱ amik ɓak sowu, <verse eid="LUK 19:22" /><verse number="23" style="v" sid="LUK 19:23" />yek laki yek ba̱ka̱ ngusi balla̱t wulpi gini kangwe a pal wugo aa mbi ilgwe mba̱l tli dani wu so ye? Na̱k ɗe ka̱ yisi ɗe nu ka̱n ani wu?&gt;<verse eid="LUK 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 19:24" />&lt;&lt;Yek ta̱ wul ma̱jwe ni ka̱li wu ɗe, &lt;Kama̱n ɗe na̱mi gwe nit ang wu ka aka̱ ba̱l ma̱n ɗe kutl wu.&gt;<verse eid="LUK 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 19:25" />&lt;&lt;Yek sa̱ wulti ɗe, &lt;Baboo, ɗe kutl ka̱ nit ang ca.&gt;<verse eid="LUK 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 19:26" />&lt;&lt;Yek baboomi wulsi ɗe, &lt;Ɓo kumini, mas ma̱lgwe ilgon niɗɗa̱ wu sa mba̱lit dani, a ma̱lgwe ba̱ ilgon niɗɗa̱ sowu, nak njeti gwe niɗɗa̱ wu mago sa kamit ka. <verse eid="LUK 19:26" /><verse number="27" style="v" sid="LUK 19:27" />Mbe ma̱jwe nge ɗe guu gwasa̱n wu teɗi, aka̱ tlosi ka ten gwel gini.&gt; &gt;&gt;<verse eid="LUK 19:27" /></para>
  <para style="s">Yesu mbuk lu Wurshelima</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28" />Yek Yesu dla̱m nu wugo, yek ta̱ ngusi tot Wurshelima. <verse eid="LUK 19:28" /><verse number="29" style="v" sid="LUK 19:29" />Ta̱ ɓal njaa ka̱ ba̱n jwe asa̱ mbe ɗe Betapaji suk Betani jwe ni ten malka̱n yen tla̱da̱l gwe asa̱ mbe ɗe Za̱nda̱l Tlindi Zetun wu, yek ta̱ mbe ma̱n kopti jwas ɗe lop. Yek ta̱ wulsi ɗe, <verse eid="LUK 19:29" /><verse number="30" style="v" sid="LUK 19:30" />&lt;&lt;La̱n ka̱ ba̱n gwe ni cina ɗa ni wu. Ka̱ te ka̱ ba̱mi wu ka mbi yen zhaki gon ga̱ ɓali gwe ba̱ ma̱lgon ɓo to tenti sowu, aka̱ pa̱tlti, aka̱ li tet na̱ ti. <verse eid="LUK 19:30" /><verse number="31" style="v" sid="LUK 19:31" />Kume ma̱lgon ngemkii ɗe, &lt;Yek laki ɗe ka̱ na̱ma pa̱tlti gwas ye wu?&gt; Aka̱ wulti ɗe, &lt;Bagaa ka̱ na̱ma lamti gwasi.&gt; &gt;&gt;<verse eid="LUK 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32" />Yek ma̱jwe ta̱ shinsi wu lak mbi zhaki na̱k gwe ta̱ hwisi wu. <verse eid="LUK 19:32" /><verse number="33" style="v" sid="LUK 19:33" />Yek sa̱ ɓa pa̱tlti wu yek manti ka̱ ɓal wu yek ta̱ ngemsi ɗe, &lt;&lt;Yek laki ɗe ka̱ na̱ma pa̱tlti gwas ye?&gt;&gt;<verse eid="LUK 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34" />Yek sa̱ wulti ɗe, &lt;&lt;Bagaa ka̱ na̱ma lamti gwasi.&gt;&gt;<verse eid="LUK 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 19:35" />Yek sa̱ ta̱lat mal Yesu, yek sa̱ wut luka̱l ten zhaki, yek sa̱ zi Yesu tenti. <verse eid="LUK 19:35" /><verse number="36" style="v" sid="LUK 19:36" />Sa̱ na̱ma la̱t wugo, yek mbala̱n ngusi talti luka̱l jwasa̱n ten tantu.<verse eid="LUK 19:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37" />Ta̱ ɓal njaa ka̱lu gwe tantu yil sut ka̱ Za̱nda̱l Tlindi Zetun wu, yek ma̱n kopti jwas mas njel pa̱lti hwol tuki asa̱ na̱ma ta̱sti ga̱ Nya na̱ nda̱li yal na̱k ɗe sa̱ yen kiɗi wul cit ɓanti jwe ta̱ pa̱li wu. <verse eid="LUK 19:37" /><verse number="38" style="v" sid="LUK 19:38" />Yek sa̱ ngusi wulti ɗe,</para>
  <para style="q1" vid="LUK 19:38">&lt;&lt;Ma̱n mbit hwa wul ga̱ Nya ka̱ɗe guu gwe na̱ma tulti ka̱ shin ga̱ Bagaa wu!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">19:38 </char><char style="ft" closed="false">Yen <char style="xt"><ref loc="PSA 118:26">Zab 118:26</ref> </char></char></note></para>
  <para style="q1" vid="LUK 19:38">&lt;&lt;Ta̱mti mbadl ga̱ mbala̱n mal Nya. Ma̱ ba̱l nalti Nya Bal Kakshe.&gt;&gt;<verse eid="LUK 19:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39" />A ma̱n Paresi jon ni suksi, yek sa̱ wul Yesu ɗe, &lt;&lt;Ma̱n lishti, matl ma̱n kopti jwa ta̱s zak ga̱ɓa.&gt;&gt; <verse eid="LUK 19:39" /><verse number="40" style="v" sid="LUK 19:40" />Yek ta̱ ballisi ɗe, &lt;&lt;A ni kii ma hwiti, kume ma̱jin zak ga̱ɓa wu, ye a ga̱ɓa ka̱ lal gwasa̱n.&gt;&gt;<verse eid="LUK 19:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41" />Yek sa̱ ɓal njaa a Wurshelima go yek Yesu yen bal ba̱mi yek cit gonti yek ta̱ kuli. <verse eid="LUK 19:41" /><verse number="42" style="v" sid="LUK 19:42" />Yek ta̱ hwi ba̱n Wurshelima ɗe, &lt;&lt;Na̱k wule ka̱a̱ yisa̱n tantu mbit hwol tuki ka̱ multi jwaka̱n, ama ga̱ hwuda̱li ka̱n ni kii. <verse eid="LUK 19:42" /><verse number="43" style="v" sid="LUK 19:43" />Cin gwe ma̱n nget gwaka̱n a ganda̱l ba̱n gwaka̱n na̱ sa̱ba̱l ɗe ta̱s dlansi sukkii wu ni teɗi, a ma̱n hapti dlo a ngaɓikii ka̱ mas da̱nti gwaka̱n. <verse eid="LUK 19:43" /><verse number="44" style="v" sid="LUK 19:44" />Sa catkii ɗa̱nka na̱m-na̱m, asa̱ tlo ma̱n ba̱n jwaka̱n ka mas, asa̱ jek bii jwaka̱n ka na̱k ɗe ba̱ka̱a̱ kan ɗe Nya tuli ta̱s kiskii sowu.&gt;&gt;<verse eid="LUK 19:44" /></para>
  <para style="s">Yesu mbol ma̱n wulti wul ɗa̱ka̱ lubii ga̱ Nya ka</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45" />Yek Yesu li ka̱lu lubii ga̱ Nya yek ta̱ nda mbolti ji ma̱n wulti wul ka jwe ni ka̱ lubii ga̱ Nyami wu. <verse eid="LUK 19:45" /><verse number="46" style="v" sid="LUK 19:46" />Yek ta̱ wulsi ɗe, &lt;&lt;Nya dla̱m ka̱ lishti ɗe, &lt;Lubii gi a da̱m ɗe lu ngemti gini,&gt;<note caller="+" style="f"><char style="fr" closed="false">19:46 </char><char style="ft" closed="false">Yen <char style="xt"><ref loc="ISA 56:7">Ish 56:7</ref></char>.</char></note> ama yek ka̱ palli ɗe, &lt;lu hwunti ji kiɗi muka̱l wi.&gt;<note caller="+" style="f"><char style="fr" closed="false">19:46 </char><char style="ft" closed="false">Yen <char style="xt"><ref loc="JER 7:11">Irm 7:11</ref></char>.</char></note> &gt;&gt;<verse eid="LUK 19:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47" />Yek ta̱ ngusisi hwit ga̱ɓa ka̱lu lubii ga̱ Nyami mas cin, ama yek kiɗi ma̱n da̱nti ka̱ bii ngemti Nyami suk ma̱n yisti mba̱t ga̱ Musa suk kiɗi ji ma̱n ba̱mi njel ngot tantu gwe sa tlot wu. <verse eid="LUK 19:47" /><verse number="48" style="v" sid="LUK 19:48" />Yek ba̱sa̱ mbi so, na̱k ɗe ma̱jwe ni ka̱li wu na̱ma kumti ta̱mti ga̱ɓa gwas wu.<verse eid="LUK 19:48" /></para>
  <chapter eid="LUK 19" />
  <chapter number="20" style="c" sid="LUK 20" />
  <para style="s">Sa̱ ngem Yesu nda̱lti pa̱lti wul gwasi</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1" />Gas gon Yesu nima hwit ga̱ɓa mbala̱n ata̱ nisi ma dla̱mti ga̱ɓa ma̱n ta̱mti ka̱ lubii ga̱ Nya. Yek kiɗi ma̱n da̱nti ka̱ bii ngemti Nyami suk ma̱n yisti mba̱t ga̱ Musa suk kiɗi ji ma̱n ba̱mi li teɗi. <verse eid="LUK 20:1" /><verse number="2" style="v" sid="LUK 20:2" />Yek sa̱ wulti ɗe, &lt;&lt;Hwinii, na̱ wunda̱l nda̱lti gwik ka̱ na̱ma pa̱lti wul jin jwi? Wok ba̱lki nda̱lti gwisi wo?&gt;&gt; <verse eid="LUK 20:2" /><verse number="3" style="v" sid="LUK 20:3" />Yek Yesu wulsi ɗe, &lt;&lt;Am mago ba ngemkii ta̱k hwini nini: <verse eid="LUK 20:3" /><verse number="4" style="v" sid="LUK 20:4" />Baptisma gwe Yohana pa̱li mbala̱n go sut mal Nya ka̱n ni ya? Ko ga̱ mbala̱n ka̱n?&gt;&gt;<verse eid="LUK 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5" />Yek sa̱ ngusi ga̱ɓa dani ka̱ dlo gwasa̱n, yek sa̱ wule, &lt;&lt;Kume ma̱ wuli ɗe, sut mal Nya ka̱go, ta wule, yek laki ɗe ba̱ma̱ kama̱n ga̱ɓa gwas so ye? <verse eid="LUK 20:5" /><verse number="6" style="v" sid="LUK 20:6" />A kume ma̱ wuli ɗe ga̱ mbala̱n ka̱go, mas mbala̱n jin a laka̱nni na̱ ye na̱k ɗe mas jwasa̱n sa̱ kan ɗe Yohana ma̱n baptisma wo ma̱n dla̱mti ga̱ɓa ga̱ Nya ka̱wu.&gt;&gt;<verse eid="LUK 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 20:7" />Yek sa̱ wul Yesu ɗe, &lt;&lt;Ma̱ yis lu gwe baptisma ga̱ Yohana yil tet wu so.&gt;&gt;<verse eid="LUK 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8" />Yek Yesu wulsi ɗe, &lt;&lt;Am mago ba hwikii na̱ nda̱lti gwe a na̱ma pa̱lti wul wu so.&gt;&gt;<verse eid="LUK 20:8" /></para>
  <para style="s">Cinga̱lti ga̱ɓa ten byas ma̱n kolti zhin</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9" />Yek Yesu cinga̱li ga̱ɓa mbala̱n yek ta̱ wulsi ɗe, &lt;&lt;Ma̱lgon ni ɗa̱ gwe ɓak zhin inabi gwas wu, yek ta̱ ba̱l ma̱jon ta̱s kolit zhimi, yek ta̱ li ka̱ ba̱n gon dlenti yek ta̱ mul tu gon wonti. <verse eid="LUK 20:9" /><verse number="10" style="v" sid="LUK 20:10" />Kotlti yandi inabisi ɓal go yek ta̱ shin zhel gwas mal ma̱jwe ta̱ ba̱lsi kolti zhimi wu ta̱s kotlit yandi inabisi teɗi, yek sa̱ ɓo zheli, yek sa̱ mbolti koo ami. <verse eid="LUK 20:10" /><verse number="11" style="v" sid="LUK 20:11" />Yek ta̱ po shin zobsi zheli gon, yek sa̱ po ɓot ɗa yek sa̱ byalti yek sa̱ mbolti koo ami pak. <verse eid="LUK 20:11" /><verse number="12" style="v" sid="LUK 20:12" />Yek ta̱ po shin zheli ga̱ na mekan ɗa, yek sa̱ pa̱lit byas ɓoti yek sa̱ mbolti koo ami ɗa̱ pak.<verse eid="LUK 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 20:13" />&lt;&lt;Yek ma̱n zhimi wule, &lt;Ningo yek ba pa̱li ye?&gt; Yek ta̱ po wule, &lt;Ba shin yen gini gwe a lamti wu, a yisi ɗe sa ba̱lti nalti.&gt;<verse eid="LUK 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 20:14" />&lt;&lt;Yek ma̱n kolti zhimi yenti wugo, yek sa̱ wule, &lt;Yen ga̱ ma̱n zhimi ka̱ ɓallu, ti ka̱n zhimi a pal ɗe gwasi kaal ɗa̱ ma̱shka̱n ga̱ abe. Ma̱ tloti, ta̱ zhimi da̱n ɗe ga̱na̱n.&gt; <verse eid="LUK 20:14" /><verse number="15" style="v" sid="LUK 20:15" />Yek sa̱ yilla̱t ɗa̱ka̱ zhimi ka yek sa̱ tloti.</para>
  <para style="p" vid="LUK 20:15">&lt;&lt;Yek ma̱n zhin wu a pa̱li ma̱ju ye? <verse eid="LUK 20:15" /><verse number="16" style="v" sid="LUK 20:16" />Ta tlosi ka ata̱ ba̱l zhimi ma̱jon.&gt;&gt;</para>
  <para style="p" vid="LUK 20:16">Yek mbala̱n kumi nu wugo yek sa̱ wule, &lt;&lt;Ba Nya zaki ta̱ pi nu so.&gt;&gt;<verse eid="LUK 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17" />Yek Yesu wutisi gwel, yek ta̱ wulsi ɗe, &lt;&lt;Yek ɗe gaa ga̱ ga̱ɓa ga̱n ɗe sa̱ lishi gwe,</para>
  <para style="q1" vid="LUK 20:17">&lt;&lt; &lt;Ye gwe ma̱n kinti bii nge wu, yek pal ɗe hwa ye kinti bii?&gt;<note caller="+" style="f"><char style="fr" closed="false">20:17 </char><char style="ft" closed="false">Yen <char style="xt"><ref loc="PSA 118:22">Zab 118:22</ref></char></char></note><verse eid="LUK 20:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="LUK 20:18" />Mas ma̱lgwe nda ten ye wugo, ta caccal ka, a ma̱lgwe ye wu ndet gaa go, a na̱kti ka na̱k apti.&gt;&gt;<verse eid="LUK 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19" />Yek ma̱n yisti mba̱t ga̱ Musa suk kiɗi ma̱n Pa̱ris ngwe ta̱s dop Yesu ka̱li na̱k ɗe sa̱ yisi ɗe tensi ka̱n ta̱ cinga̱l ga̱ɓa gwisi wu. Ama yek ɓanti ga̱ mbala̱n cisi.<verse eid="LUK 20:19" /></para>
  <para style="s">Ɓatlti wulpi boo ga̱ Kaisar</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 20:20" />Yek kiɗi ji Ma̱n Yehuda shin ma̱jon jwe palli gaa gwasa̱n ɗe hwa mbala̱n wu ta̱s dop Yesu na̱ byas ɓotlka̱n ka̱ ga̱ɓa suk kumti ga̱s wul gwe sa pa̱lit wu ta̱s ba̱ltiti gobna ga̱ atli asa̱ dopti ɗa. <verse eid="LUK 20:20" /><verse number="21" style="v" sid="LUK 20:21" />Yek sa̱ wulti ɗe, &lt;&lt;Ma̱n lishti, ma̱ yisi ɗe ga̱ɓa gwa wo gem ka̱n aka̱ palli mbala̱n mas ndakce, aka̱ dla̱mi mbala̱n gem kangwe sa yis Nya wu. <verse eid="LUK 20:21" /><verse number="22" style="v" sid="LUK 20:22" />Mbun ɗe ta̱n ɓatl Kaisar guu wulpi boo ga̱na̱n ma?&gt;&gt;<verse eid="LUK 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23" />Yek Yesu yis byas ɓotlka̱n gwasa̱n yek ta̱ wulsi ɗe, <verse eid="LUK 20:23" /><verse number="24" style="v" sid="LUK 20:24" />&lt;&lt;Ɓo za̱n wulpi ta ɓo yeni. Shishi suk shin ga̱ wok ni dani wo?&gt;&gt; Yek sa̱ wulti ɗe, &lt;&lt;Ga̱ Kaisar.&gt;&gt; <verse eid="LUK 20:24" /><verse number="25" style="v" sid="LUK 20:25" />Yek Yesu wulsi ɗe, &lt;&lt;Ba̱la̱n Kaisar wul jwasi, aka̱ ba̱l Nya wul jwas pak.&gt;&gt;<verse eid="LUK 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26" />Yek ba̱sa̱ mbi byas wul ka̱ iljwe ta̱ dla̱m ka̱ mbala̱n wu so, yek ba̱sa̱ po man ga̱ɓa so na̱k ɗe kangwe ta̱ ballisi ga̱ɓe cisi ɓanti wu.<verse eid="LUK 20:26" /></para>
  <para style="s">Kumti ga̱si ten tlit ɗa̱ka̱ ma̱shka̱n ka</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27" />Yek kiɗi ji Ma̱n Yehuda jon jwe asa̱ mbesi ɗe ma̱n Saduki ju, jwe asa̱ kul wule ma̱jwe ma̱sh wu jo sa po tli ɗa̱ka̱ ma̱shka̱n ka sowu tul mal Yesu ta̱s ngemti. Yek sa̱ wulti ɗe, <verse eid="LUK 20:27" /><verse number="28" style="v" sid="LUK 20:28" />&lt;&lt;Ma̱n lishti, Musa lishi nii ka̱ mba̱t ɗe, kume ma̱lgon ma̱shi yek ta̱ zak kili gwasi a ba̱ta̱ zi yen sukti sogo, a yilka gwas hap kilisi ta̱s zi yen yilka gwasi.&gt;&gt; <verse eid="LUK 20:28" /><verse number="29" style="v" sid="LUK 20:29" />Yek sa̱ wule, &lt;&lt;Ma̱jon si ɗe nitgi, mas jwasa̱n yilkeni ka̱n. Kakshe gwasa̱n ma̱shi yek ta̱ zak kili gwasi a ba̱ta̱ zi yen sukti so. <verse eid="LUK 20:29" /><verse number="30" style="v" sid="LUK 20:30" />Yek gwe kopti wu hap kilisi yek ta̱ lak ma̱shi a ba̱ta̱ zi yen sukti so pak. <verse eid="LUK 20:30" /><verse number="31" style="v" sid="LUK 20:31" />Yek na̱ mekan gwasa̱n hap kilisi pak. Na̱nu-na̱nu yek mas jwasa̱n hap kilisi asa̱ na̱ma ma̱shka̱n a ba̱sa̱ zi yen sukti so. <verse eid="LUK 20:31" /><verse number="32" style="v" sid="LUK 20:32" />Yek kilisi lak ma̱sh pak. <verse eid="LUK 20:32" /><verse number="33" style="v" sid="LUK 20:33" />Gas tlit ga̱ dii atl wo wok ka̱ ni ɗe kos gwas wo na̱k ɗe mas jwasa̱n sa̱ hapti wu?&gt;&gt;<verse eid="LUK 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34" />Yek Yesu wulsi ɗe, &lt;&lt;Mbala̱n ji se na̱ma hapti modli asa̱ na̱ma hapti jwasa̱n ka. <verse eid="LUK 20:34" /><verse number="35" style="v" sid="LUK 20:35" />Ama ma̱jwe mbun ɗe Nya a palla̱si kaami gas tlit ga̱ dii atl go, hapti po yi ka̱ dlo gwasa̱n so. <verse eid="LUK 20:35" /><verse number="36" style="v" sid="LUK 20:36" />A ba̱sa po ma̱sh so, sa pal ndakce suk mil shinti ji Nya. Sa pal ɗe mil ji Nya na̱k ɗe Nya a palla̱si kaami wu. <verse eid="LUK 20:36" /><verse number="37" style="v" sid="LUK 20:37" />Na̱k gwe Musa lishi ɗe ma̱jwe ma̱sh jo sa palla̱si kaami ɗe ta̱ ga̱ɓa ten lu me gwe wutu ci wu ka̱lu gwe Nya wulti ɗe, &lt;Amik ɗe Nya ga̱ Ibirahim suk ga̱ Ishaku suk ga̱ Yakubu.&gt;<note caller="+" style="f"><char style="fr" closed="false">20:37 </char><char style="ft" closed="false">Yen <char style="xt"><ref loc="EXO 3:6">Yil 3:6</ref></char></char></note> <verse eid="LUK 20:37" /><verse number="38" style="v" sid="LUK 20:38" />Ti wo Nya ga̱ ma̱n ma̱shka̱n ka̱ so, ama Nya ga̱ ma̱jwe ni na̱ mbadl wu ka̱n, na̱k ɗe malti wo mas mbala̱n wo mbadl nisi ɗa̱ wu.&gt;&gt;<verse eid="LUK 20:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39" />Yek jon ka̱ ma̱n yisti mba̱t ga̱ Musa wulti ɗe, &lt;&lt;Ma̱n lishti, ka̱ hwini gem.&gt;&gt; <verse eid="LUK 20:39" /><verse number="40" style="v" sid="LUK 20:40" />Yek ba̱sa̱ po man kumti ga̱s ilgon malti so.<verse eid="LUK 20:40" /></para>
  <para style="s">Kumti ga̱si ten Almasihu</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41" />Yek Yesu ngemsi ɗe, &lt;&lt;Ɗa̱ nii ka̱n mbala̱n a wule Almasihu wo yen ga̱ Dauda guu gwi? <verse eid="LUK 20:41" /><verse number="42" style="v" sid="LUK 20:42" />Na̱k ɗe Dauda dla̱m ka̱ lishti ga̱ Zabura ɗe,</para>
  <para style="q1" vid="LUK 20:42">&lt;&lt; &lt;Nya wul Bagaa gi ɗe:</para>
  <para style="q2" vid="LUK 20:42">&lt;&lt;Da̱n ten ang shinti gini<verse eid="LUK 20:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="LUK 20:43" />se a laki yek ka̱ man ngetl ga̱ ma̱n nget gwa</para>
  <para style="q2" vid="LUK 20:43">yek a palli guu suk mbala̱n gwasa̱n a atl ɗakka.&gt;&gt; &gt;<note caller="+" style="f"><char style="fr" closed="false">20:43 </char><char style="ft" closed="false">Yen <char style="xt"><ref loc="PSA 110:1">Zab 110:1</ref></char></char></note><verse eid="LUK 20:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="LUK 20:44" />Na̱k ɗe Dauda guu mbet ɗe Bagaa go, ɗa̱ nii ka̱n ta ni ɗe yen gwas gwi?&gt;&gt;<verse eid="LUK 20:44" /></para>
  <para style="s">Yesu ɓuli gal ɗa̱ gaa ma̱n yisti mba̱t ga̱ Musa ka</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45" />Yek Yesu dla̱mi mas ma̱n kopti jwas a cina ɗa̱ mbala̱n wonti ɗe, <verse eid="LUK 20:45" /><verse number="46" style="v" sid="LUK 20:46" />&lt;&lt;Pa̱n ɗem'ɗem suk ma̱n yisti mba̱t ga̱ Musa na̱k ɗe asa̱ lak bal luka̱l asa̱ ngusi ma̱tlti ɗa̱nka ta̱ mbala̱n ga̱ɓesi ka̱lu motgaa ji mbala̱n ɗa, asa̱ lami ɗe ta̱ mbala̱n ba̱lsi lu da̱nti ji kiɗi mbala̱n ka̱lu motgaa ga̱ gwasa̱n suk ka̱lu motgaa hwol tuki. <verse eid="LUK 20:46" /><verse number="47" style="v" sid="LUK 20:47" />Sik ɗe ma̱jwe asa̱ yemi wul guli modli ka asa̱ pa̱l tlal ngemti Nya ka̱ mbala̱n ta̱s yensi ɗa. Yek laki ɗe Nya a nolsi nal man mas mbala̱n.&gt;&gt;<verse eid="LUK 20:47" /></para>
  <chapter eid="LUK 20" />
  <chapter number="21" style="c" sid="LUK 21" />
  <para style="s">Ba̱lti wulpi ga̱ guli kili gon</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1" />Yek Yesu tlil gaa nya yek ta̱ yen ma̱n wul sa̱ na̱ma wutti wulpi ka̱ wul wutti ka̱ lubii ga̱ Nya. <verse eid="LUK 21:1" /><verse number="2" style="v" sid="LUK 21:2" />Yek ta̱ yen guli kili gon gwe ba̱ ilgon niɗɗa̱ sowu ta̱lak ba̱l nak njet wulpi gwe niɗɗa̱ wu mas. <verse eid="LUK 21:2" /><verse number="3" style="v" sid="LUK 21:3" />Yek Yesu wule, &lt;&lt;A ni kii ma hwit gem ɗe, wulpi gwe guli kili wu ba̱li wu man ga̱ naa mbala̱n mas. <verse eid="LUK 21:3" /><verse number="4" style="v" sid="LUK 21:4" />Na̱k ɗe si wo njet ka̱n sa̱ ba̱li tet ka̱ nali gwe nisi ɗa̱ wu, ama kili go njeti gwe niɗɗa̱ wu ka̱n ta̱ wuti mas.&gt;&gt;<verse eid="LUK 21:4" /></para>
  <para style="s">Yesu dla̱m ilgwe a ya pi wu</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5" />Yek jon ka̱ ma̱n kopti ji Yesu nda ga̱ɓa ten kangwe sa̱ kin lubii ga̱ Nya na̱ hwa ye suk kangwe sa̱ la̱ka̱mi na̱ wul jwe mbala̱n ba̱li ɗe ga̱ pa̱lti wul ka̱ bii ngemti Nya wu. Yek Yesu wulsi ɗe, <verse eid="LUK 21:5" /><verse number="6" style="v" sid="LUK 21:6" />&lt;&lt;Na̱k gwe ka̱ na̱ma yenti wul jin ju, cin ni teɗi gwe mas ye jwe ka̱ na̱ma yenti wu sa zak gon ten yilka gwas so, mas sa jek ka.&gt;&gt; <verse eid="LUK 21:6" /><verse number="7" style="v" sid="LUK 21:7" />Yek sa̱ wulti ɗe, &lt;&lt;Ma̱n lishti, a gasi ka̱n na̱k gwisi a pi gwi? A yek ma yeni ama̱ yisi ɗe na̱k gwisi ɓal njaa ta pi ye?&gt;&gt; <verse eid="LUK 21:7" /><verse number="8" style="v" sid="LUK 21:8" />Yek Yesu ballisi ɗe, &lt;&lt;Pa̱n ɗem'ɗem ba̱ ma̱lgon shelkii so na̱k ɗe mbala̱n wonti a tuli asa̱ wulkii ɗe sik ɗe ami, asa̱ po wule, &lt;Tlit ga̱ dii atl ɓal njaa.&gt; Ba̱k koɓa̱nsi so. <verse eid="LUK 21:8" /><verse number="9" style="v" sid="LUK 21:9" />Kume ka̱ kum dlanti ɗa̱nka suk la̱shi da̱nti ta̱mti wu, ba̱ ɓanti cikii so, na̱k ɗe ngetli ka̱n ta̱ na̱k gwisi pi wu. Ama ba̱ yek ɓo ni ɗe tlit ga̱ dii atl so.&gt;&gt; <verse eid="LUK 21:9" /><verse number="10" style="v" sid="LUK 21:10" />Yek ta̱ ngusi wulti gwasa̱n ɗe, &lt;&lt;Mbala̱n ji atl gon a dlansi suk mbala̱n ji atli gon. A mbala̱n ka̱ atl ga̱ guu gon a dlansi suk mbala̱n ga̱ guumi gon pak. <verse eid="LUK 21:10" /><verse number="11" style="v" sid="LUK 21:11" />Dii atl a wu na̱ nda̱lti a kuza̱n a tlo mbala̱n, a mbala̱n wonti ɗa̱nka a ma̱sh na̱ byas cwo. A kiɗi wul cit ɓanti a pi sut nya. <verse eid="LUK 21:11" /><verse number="12" style="v" sid="LUK 21:12" />Ama na̱k jwisi a ɓo pi so se sa̱ dopkii yek sa̱ lakkii ka̱ bomti. A sa̱ ta̱lakii mal ma̱n kisti ga̱ɓa ka̱lu motgaa ji Ma̱n Yehuda asa̱ ɓalkii asa̱ za̱kii ka̱lu gwe asa̱ zi ma̱n pa̱lti byas wul ju. A sa̱ ta̱lakii a cina ɗa̱ guu ji ba̱n suk kiɗi jwasa̱n ten ɗe ka̱a̱ zi mbadl tena̱n ni. <verse eid="LUK 21:12" /><verse number="13" style="v" sid="LUK 21:13" />Na̱ nu ka̱n ka mbi tantu gwe ka hwisi ga̱ɓa tena̱n wu. <verse eid="LUK 21:13" /><verse number="14" style="v" sid="LUK 21:14" />Ba̱ ilgwe ka dla̱m a cina ɗaasika wu hwotkii so. <verse eid="LUK 21:14" /><verse number="15" style="v" sid="LUK 21:15" />Ba hwikii ilgwe ka dla̱m wu suk ɓotlka̱n ga̱ɓa kangwe ma̱n nget gwaka̱n a man nget ga̱ɓa gwaka̱n sowu. <verse eid="LUK 21:15" /><verse number="16" style="v" sid="LUK 21:16" />Ma̱n za̱t jwaka̱n suk yilkeni jwaka̱n suk yela̱n jwaka̱n a ba̱l bi ga̱ jon jwaka̱n ɗe ta̱s tlokii. <verse eid="LUK 21:16" /><verse number="17" style="v" sid="LUK 21:17" />Mas mbala̱n a ngekii na̱k ɗe ka̱a̱ zi mbadl tena̱n wu. <verse eid="LUK 21:17" /><verse number="18" style="v" sid="LUK 21:18" />Ama ko ɗe na̱m ka̱ ma̱dla̱n gaa gwaka̱n mago gon a gil ka̱ so. <verse eid="LUK 21:18" /><verse number="19" style="v" sid="LUK 21:19" />Kume ka̱ dlo mbadl go Nya a kiskii.&gt;&gt;<verse eid="LUK 21:19" /></para>
  <para style="s">Yesu dla̱m kangwe ba̱n Wurshelima a nda wu</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20" />Yek Yesu wulsi ɗa̱ɗe, &lt;&lt;Kume ka̱a̱ yen ma̱n hapti dlo ganda̱l Wurshelima wugo, ta̱k yisi ɗe ndat ga̱ ba̱mi ɓal njaa. <verse eid="LUK 21:20" /><verse number="21" style="v" sid="LUK 21:21" />Ma̱jwe ni ka̱ atl ga̱ Yehudiya go sa ap to ka̱ tla̱da̱l ka. A ma̱jwe ni ka̱ ba̱n Wurshelima wu yil ɗa̱ka̱ ba̱mi ka. Ma̱jwe ni ka̱ nak mil ba̱n jo ba̱s te ka̱ bal ba̱mi so. <verse eid="LUK 21:21" /><verse number="22" style="v" sid="LUK 21:22" />Ka̱ multi jwisi ka̱n Nya a nol mbala̱n, ta̱ ga̱ɓa gwe mil shinti dla̱mti ga̱ɓa ga̱ Nya lishi wu da̱n ɗe gem. <verse eid="LUK 21:22" /><verse number="23" style="v" sid="LUK 21:23" />Modli ma̱n mil tuki suk ma̱n mil kaal a da̱n ɗe wul cit gonti ka̱ multi jwisi na̱k ɗe bal bomti a te ka̱ atli a lilti mbadl ga̱ Nya a su sut ten mbala̱mi wu. <verse eid="LUK 21:23" /><verse number="24" style="v" sid="LUK 21:24" />Sa tlo jon jwaka̱n ka̱ dlanti a jon wo sa palla̱si ɗe zhel ɗa̱nka̱ atl jon ka. Ma̱jwe ba̱ Ma̱n Yehuda ka̱ sowu a ngaɓi Wurshelima se multi jwasa̱n njika̱n.<verse eid="LUK 21:24" /></para>
  <para style="s">Palti ga̱ Yen ga̱ Mbala̱n</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25" />&lt;&lt;Mbala̱n a yen wul cit ɓanti ten cin suk ten liɓi suk ten kyadla̱l. A ten dii atl wo mbadl ga̱ mbala̱n a lus ka na̱k ɗe ɓanti a cisi i'e ɗe bal ze nwuti wu. <verse eid="LUK 21:25" /><verse number="26" style="v" sid="LUK 21:26" />Na̱k wule mbala̱n a na kotla̱n mbadl ka na̱ ɓanti, a bi mbadl gwasa̱n a ngusi ɓoti na̱k ɗe dlo nya a wu wu. <verse eid="LUK 21:26" /><verse number="27" style="v" sid="LUK 21:27" />A paa mas mbala̱n yena̱nni Yen ga̱ Mbala̱n ka̱ nyaze, ka̱ nda̱lti suk bal nalti gini. <verse eid="LUK 21:27" /><verse number="28" style="v" sid="LUK 21:28" />Kume ka̱ yeni ɗe nu ɓa pi wu, dla̱la̱n nda̱li, kisti gwaka̱n ka̱ ɓal njaa.&gt;&gt;<verse eid="LUK 21:28" /></para>
  <para style="s">Cinga̱lti ga̱ɓa ga̱ Yesu ten tlindi tula̱n</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29" />Yek Yesu cinga̱lisi ga̱ɓa gon ɗe, &lt;&lt;Ɓo yena̱n tlindi tula̱n suk naa tlindi, <verse eid="LUK 21:29" /><verse number="30" style="v" sid="LUK 21:30" />kume sa̱ nda telti pyal daa wugo, aka̱ yisi ɗe watla̱n ɓal njaa. <verse eid="LUK 21:30" /><verse number="31" style="v" sid="LUK 21:31" />Nu ka̱n kume ka yen iljwe a hwikii wu ɓa pi wu ta̱k yisi ɗe kanti ga̱ Nya ɗe guu ka̱ mbadl ga̱ mbala̱n ɓal njaa. <verse eid="LUK 21:31" /><verse number="32" style="v" sid="LUK 21:32" />A ni kii ma hwit gem ɗe jon ka̱ mbala̱n ji se a ɓo ma̱sh so ɗe mas wul jwisi a pi wu. <verse eid="LUK 21:32" /><verse number="33" style="v" sid="LUK 21:33" />Dlo nya suk dii atl a paki ama ko njet ka̱ ga̱ɓa gi wo a paki so.<verse eid="LUK 21:33" /></para>
  <para style="s">Ga̱ɓa ga̱ Yesu ten da̱nti na̱ ka̱n gaa</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34" />&lt;&lt;Pa̱n ɗem'ɗem na̱ gaa gwaka̱n, ba̱ za̱t mbadl ten ngukti wul suk tlat wul jwe a gillikii gaa ka̱wu suk daamti ten wul ji dii atl lil da̱nti gwaka̱n ka̱ so. Ɗe ba̱ nuk sogo, cin gwisi a tuli gasi gwe ba̱ka̱ yisi sowu, <verse eid="LUK 21:34" /><verse number="35" style="v" sid="LUK 21:35" />na̱k gwe a tarko dop wul wu. Nu ka̱n cimi a tuli mas mbala̱n ga̱ dii atli. <verse eid="LUK 21:35" /><verse number="36" style="v" sid="LUK 21:36" />Da̱ma̱n na̱ ka̱n gaa aka̱ na̱ma ngemti Nya ta̱k mana̱n yilti ɗa̱ka̱ wul jwisi ka aka̱ man dla̱lti a cina ɗaaka Yen ga̱ Mbala̱n.&gt;&gt;<verse eid="LUK 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37" />Yek Yesu ngusi hwit ga̱ɓa mbala̱n ka̱ lubii ga̱ Nya mas cin, sukti ɓal go ata̱ to ten Za̱nda̱l Tlindi Zetun ata̱ mul to ka. <verse eid="LUK 21:37" /><verse number="38" style="v" sid="LUK 21:38" />Na̱ gasi ɓal go a mas mbala̱n mogaa ka̱ lubii ga̱ Nya ta̱s katit ka̱n.<verse eid="LUK 21:38" /></para>
  <chapter eid="LUK 21" />
  <chapter number="22" style="c" sid="LUK 22" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1" />Cin Motgaa bukti burodi gwe ba̱ yiis ni giɓi sowu gwe a Ma̱n Yehuda mbe ɗe Motgaa daamti ɗakcit boo ji Israila wu ɓal njaa go, <verse eid="LUK 22:1" /><verse number="2" style="v" sid="LUK 22:2" />yek kiɗi ma̱n Pa̱ris suk ma̱n yisti mba̱t ga̱ Musa ngusi ngot ga̱ Yesu ta̱s laki ta̱s tloti mukli na̱k ɗe ɓanti ga̱ mbala̱n cisi wu. <verse eid="LUK 22:2" /><verse number="3" style="v" sid="LUK 22:3" />Yek Sheɗan te ka̱ mbadl ga̱ Yehuda gwe asa̱ mbet ɗe Iskariyoti wu, ɗe na̱m ka̱ ma̱n kopti botli jwas ɗe kutl cet lop ju. <verse eid="LUK 22:3" /><verse number="4" style="v" sid="LUK 22:4" />Yek Yehuda li mal kiɗi ma̱n da̱nti ka̱ bii ngemti Nya suk ma̱n hapti dlo jwasa̱n ta̱s dla̱m suksi kangwe ta ba̱lsi Yesu wu. <verse eid="LUK 22:4" /><verse number="5" style="v" sid="LUK 22:5" />Yek sa̱ pa̱l hwol tuk i'e yek sa̱ dla̱m sukti ɗe sa ba̱lti wulpi. <verse eid="LUK 22:5" /><verse number="6" style="v" sid="LUK 22:6" />Yek Yehuda nda̱kisi ɗe ta̱ ba̱lsi Yesu. Yek ta̱ ngo tantu gwe ta ba̱lsiti aba̱ ma̱lgon ni ka̱li sowu.<verse eid="LUK 22:6" /></para>
  <para style="s">Yesu nguk burodi suk ma̱n kopti jwasi</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7" />Cin Motgaa bukti burodi gwe ba̱ yiis ni giɓi sowu balla̱t tet wi gas gwe a mas lubii ka̱ ba̱n Israila mbosh yen bagalla asa̱ taki Nya wu. <verse eid="LUK 22:7" /><verse number="8" style="v" sid="LUK 22:8" />Yek Yesu shin Biturus suk Yohana ta̱s lak la̱ka̱misi lu gwe sa nguk wul ka̱ Motgaami wu.<verse eid="LUK 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 22:9" />Yek sa̱ ngemti ɗe, &lt;&lt;A'ako ka̱n ka̱ lami ɗe ta̱n pa̱li ko?&gt;&gt;<verse eid="LUK 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 22:10" />Yek ta̱ wulsi ɗe, &lt;&lt;Ka̱a̱ te ka̱ ba̱mi wugo ka mbi ma̱lgon na̱ tat ze a gaa aka̱ kopti ka̱ lubii gwe ta te wu, <verse eid="LUK 22:10" /><verse number="11" style="v" sid="LUK 22:11" />aka̱a̱ wul baboomi ɗe, &lt;Ma̱n lishti ka̱ shinnii ɗe ta̱n ngemki ɗe a'ako ka̱n ta nguk wul ga̱ Motgaa daamti ɗakcit boo ji Israila suk ma̱n kopti jwas ko?&gt; <verse eid="LUK 22:11" /><verse number="12" style="v" sid="LUK 22:12" />Ta mbokikii ang ten bal punka gon to ka̱ tlal bii ka na̱ gobdlan a giɓi. Ka̱li ka̱n ka la̱ka̱mini lu.&gt;&gt;<verse eid="LUK 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 22:13" />Yek sa̱ li wugo, yek sa̱ lak mbi mas na̱k gwe ta̱ hwisi wu. Yek sa̱ la̱ka̱n lwisi.<verse eid="LUK 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14" />Yek sukti ɓal ɗe nguktisi ka̱ ɓal go, yek Yesu da̱m na̱ zhila suk mil shinti ji botli jwasi ta̱s nguki. <verse eid="LUK 22:14" /><verse number="15" style="v" sid="LUK 22:15" />Yek ta̱ wulsi ɗe, &lt;&lt;A lami i'e ɗe ta nguk wul sukkii ten Motgaa daamti ɗakcit boo ji Israila a paa a nda tlat bomti. <verse eid="LUK 22:15" /><verse number="16" style="v" sid="LUK 22:16" />A ni kii ma hwiti ɗe, ndok ten gee ba po nguk wul sukkii ka̱ Motgaami na̱k ga̱n so se gas gwe ma pa̱la̱n bal Motgaa to nya ka ka̱lu gwe ma̱jwe Nya kissi wu a mogaa wu.&gt;&gt;<verse eid="LUK 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 22:17" />Yek ta̱ kan mbuka ze inabi yek ta̱ pa̱l hwol tuk na̱ Nya yek ta̱ wulsi ɗe, &lt;&lt;Kama̱nnii ta̱k huuliini. <verse eid="LUK 22:17" /><verse number="18" style="v" sid="LUK 22:18" />A ni kii ma hwiti ɗe, ndok ten gee ba po tla ze inabi sukkii so se gas gwe ma̱ moo mal guu ga̱ Nya wu.&gt;&gt;<verse eid="LUK 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19" />Yek ta̱ kan burodi yek ta̱ pa̱l hwol tuk na̱ Nya yek ta̱ caccali yek ta̱ ba̱lsi yek ta̱ wulsi ɗe, &lt;&lt;Ga̱n go tlu tli gi ka̱n gwe a ba̱li ka̱ lal gwaka̱n wu, ngusi pa̱lti nu aka̱ na̱ma daamti gini.&gt;&gt;<verse eid="LUK 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 22:20" />Sa̱ nguk wugo, yek ta̱ po kan mbuke yek ta̱ wule, &lt;&lt;Mbuka ga̱n go ga̱ pyal dla̱lla̱t ga̱ɓa ka̱n gwe ni ka̱ hwulan gi ɗe ba shoti ka̱ lal gwaka̱n wu. <verse eid="LUK 22:20" /><verse number="21" style="v" sid="LUK 22:21" />Ama ma̱lgwe a ba̱l bi gi wuggu ta̱ na̱ma ngukti wul suk ami. <verse eid="LUK 22:21" /><verse number="22" style="v" sid="LUK 22:22" />Ami Yen ga̱ Mbala̱n ba ma̱shi na̱k kangwe Nya pa̱li wu, ama ma̱lgwe a ba̱l bi gi ɗe ta̱s tlo go, ta da̱n ɗe wul cit gonti.&gt;&gt; <verse eid="LUK 22:22" /><verse number="23" style="v" sid="LUK 22:23" />Yek ma̱n kopti jwas njel ngemti ji yilkeni ɗe wok ka pa̱l ilgon nu ka̱ mi wo?<verse eid="LUK 22:23" /></para>
  <para style="s">Ga̱ɓa ten ma̱lgwe a da̱n ɗe kakshe wu</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24" />Yek ga̱ɓa te ka̱ dlo ga̱ ma̱n kopti ji Yesu ten ɗe wok ka da̱n ɗe kakshe ka̱si wo. <verse eid="LUK 22:24" /><verse number="25" style="v" sid="LUK 22:25" />Yek Yesu wulsi ɗe, &lt;&lt;Guu ji ma̱jwe ba̱sa̱ yis Nya sogo, asa̱ pa̱li wul mbala̱n jwasa̱n ta̱s yisi ɗe nda̱lti guu nisi ɗa, asa̱ lami ɗe ta̱ mbala̱n kansi ɗe ma̱n pa̱lti hwa wul. <verse eid="LUK 22:25" /><verse number="26" style="v" sid="LUK 22:26" />Ama kii wo ba̱ ni nu malkii so. Ha̱n ta̱ ma̱lgwe ni ɗe kakshe ka̱ kii wu da̱n na̱k nak'eni, a ma̱lgwe ni ɗe bali ka̱ kii wu da̱n na̱k zhel. <verse eid="LUK 22:26" /><verse number="27" style="v" sid="LUK 22:27" />Wok nal mani wo, ma̱lgwe na̱ma ngukti wul gwa ko ma̱lgwe na̱ma huulti ilga̱ ga̱ nguki wu? Ma̱lgwe na̱ma ngukti wu ka̱ɗe kakshe. Ama yek amikgu ka̱ dlo gwaka̱n na̱k ma̱n huulti ilga̱ ga̱ nguki. <verse eid="LUK 22:27" /><verse number="28" style="v" sid="LUK 22:28" />Kiik dla̱l na̱ gem suk ami ka̱ bomti jwe a tla wu. <verse eid="LUK 22:28" /><verse number="29" style="v" sid="LUK 22:29" />Na̱k gwe Aba gi palla̱n ɗe guu wu, nu ka̱n kii mago a palla̱kii ɗe guu wi pak. <verse eid="LUK 22:29" /><verse number="30" style="v" sid="LUK 22:30" />Ka nguki aka̱ tla aka̱ ngukti wul gini ka̱lu gwe a ni ɗe guu wu, aka̱ da̱n ka̱ gobdlan guu aka̱ da̱n ɗe ma̱n kisti ga̱ɓa ga̱ ma̱n ga̱s ga̱ Israila ɗe kutl cet lop ju.&gt;&gt;<verse eid="LUK 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31" />Yek Yesu wule, &lt;&lt;Siman Biturus, ɓo kumi, Sheɗan ngwe i'e ta̱s pelkii na̱k gwe asa̱ pel gwe alkama ɗa̱ka̱ ka̱pti ka̱wu. <verse eid="LUK 22:31" /><verse number="32" style="v" sid="LUK 22:32" />Ama a nikma ngemti Nya ɗe ta̱ za̱t mbadl gwa dla̱l ten Nya, a kume ka̱ balla̱k tet mala̱n wugo, aka̱ nda̱li mbadl yilkeni jwa.&gt;&gt;<verse eid="LUK 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33" />Yek Biturus wulti ɗe, &lt;&lt;Bagaa, ko ta̱ ka̱ bii gwe asa̱ ɓal mbala̱n wu ka̱ mago, ba te sukki, a kume ma̱shka̱n ka̱ ma wu, ba ma̱sh sukki.&gt;&gt;<verse eid="LUK 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34" />Yek Yesu wulti ɗe, &lt;&lt;A nikma hwiti ɗe, ka nge yisti gini asa̱mi ɗe mekan ka̱ gas ga̱n a paa gunda kol nda lakti yal ka̱ bultlwe.&gt;&gt;<verse eid="LUK 22:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35" />Yek Yesu ngem ma̱n kopti jwas ɗe, &lt;&lt;A shinkii ba̱ na̱ wulpi so aba̱ na̱ ngura so aba̱ na̱ kapta̱lan sogo, yek ka̱ mbi so ye?&gt;&gt;</para>
  <para style="p" vid="LUK 22:35">Yek sa̱ wule, &lt;&lt;Ma̱ mbi mas wul.&gt;&gt;<verse eid="LUK 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36" />Yek ta̱ wulsi ɗe, &lt;&lt;Ninga̱n go mas ma̱lgwe wulpi suk ngura niɗɗa̱ wu ta̱s kami ata̱ ngiɓi. Mas ma̱lgwe bal puka niɗɗa̱ sogo, ta̱s wul luka̱l gwas ka ata̱ wuli. <verse eid="LUK 22:36" /><verse number="37" style="v" sid="LUK 22:37" />A ni kii ma hwiti ɗe, ngetli ka̱n ta̱ ilgwe sa̱ lishi tena̱n ka̱ lishti ji ma̱n dla̱mti ga̱ɓa ga̱ Nya wu da̱n ɗe gem, gwe wuli ɗe, &lt;Yek sa̱ palla̱t ndakce suk ma̱n pa̱lti byas wul.&gt; Ilgwe sa̱ lishi tena̱n wu ɓalma da̱nti ɗe gem.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">22:37 </char><char style="ft" closed="false">Yen <char style="xt"><ref loc="ISA 53:12">Ish 53:12</ref></char></char></note><verse eid="LUK 22:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38" />Yek ma̱n kopti jwas wulti ɗe, &lt;&lt;Bagaa, kiɗi puka ɗe lop ka̱ju.&gt;&gt;</para>
  <para style="p" vid="LUK 22:38">Yek Yesu wulsi ɗe, &lt;&lt;Kumi wi.&gt;&gt;<verse eid="LUK 22:38" /></para>
  <para style="s">Sa̱ dop Yesu</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39" />Yek Yesu zak ba̱mi yek ta̱ to ka̱ Za̱nda̱l Tlindi Zetun na̱k gwe ata̱ kul pa̱li wu, yek ma̱n kopti jwas kopti. <verse eid="LUK 22:39" /><verse number="40" style="v" sid="LUK 22:40" />Ta̱ to ka̱ tla̱nda̱li wugo, yek ta̱ wulsi ɗe, &lt;&lt;Ngema̱n Nya, ba̱ Sheɗan lakkii ten pa̱lti byas wul so.&gt;&gt; <verse eid="LUK 22:40" /><verse number="41" style="v" sid="LUK 22:41" />Yek ta̱ nak ɗam ɗa̱ malsi ka njet, yek ta̱ ngus atli yek ta̱ ngem Nya. <verse eid="LUK 22:41" /><verse number="42" style="v" sid="LUK 22:42" />Yek ta̱ wule, &lt;&lt;Aba, ka̱ lami go aka̱ kami bomti ga̱n ka, ko ɗe ba̱ lamti gi ka̱ sowu, ama kangwe ka̱ lami wu.&gt;&gt; <verse eid="LUK 22:42" /><verse number="43" style="v" sid="LUK 22:43" />Ta̱ na̱ma ngemti Nya nugo yek yen shinti sut nya ka̱ ɓallu yek ta̱ ngusit nda̱lla̱t mbadli. <verse eid="LUK 22:43" /><verse number="44" style="v" sid="LUK 22:44" />Na̱k ɗe ta̱ ni ka̱ bomti wu, yek ta̱ dlot ten ngemti Nya hal lwani nitma lokti na̱k guda̱l hwulan.<note caller="+" style="f"><char style="fr" closed="false">22:44 </char><char style="ft" closed="false">Ka̱ lishti jon ji cina wo, lu ndati ɗe 43 suk 44 ni giɓi so</char></note><verse eid="LUK 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45" />Ta̱ pak ngemti Nyami wugo, yek ta̱ pal te mal ma̱n kopti jwas ka yek ta̱ mbisi go sa̱ na̱ma ndet yeba̱l, na̱k ɗe sa̱ ni ka̱ duu tuk wu. <verse eid="LUK 22:45" /><verse number="46" style="v" sid="LUK 22:46" />Yek ta̱ wulsi ɗe, &lt;&lt;Yek laki ɗe ka̱a̱ na̱ma ndet yeba̱l ye? Tla̱nnya ta̱k ngema̱n Nya ba̱ Sheɗan lakkii ten ndat so.&gt;&gt;<verse eid="LUK 22:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47" />Ta̱ nisi ma ga̱ɓa nugo yek ma̱jon ka̱ju wonti sa̱ sa dopti gwasi. Yehuda, gon ka̱ ma̱n kopti jwas ɗe kutl cet lop ju ka̱ tulla̱si. Yek Yehuda ɗam njaa mal Yesu yek ta̱ swatti. <verse eid="LUK 22:47" /><verse number="48" style="v" sid="LUK 22:48" />Yek Yesu wulti ɗe, &lt;&lt;Yehuda, na̱ swatti ka̱n ka ba̱l bi gi Yen ga̱ Mbala̱n ma?&gt;&gt;<verse eid="LUK 22:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49" />Yek ma̱n kopti jwe ni suk Yesu wu yeni nu wugo yek sa̱ ngem Yesu ɗe, &lt;&lt;Bagaa, ta̱n kan kiɗi puka ta̱n dlanni suksi a?&gt;&gt; <verse eid="LUK 22:49" /><verse number="50" style="v" sid="LUK 22:50" />Yek gon ka̱ ma̱n kopti ji Yesu wotl zhel ga̱ bal ma̱n Pa̱ris gon hal yek ta̱ kotlit ka̱n ga̱ ka̱t ang shinti ka.<verse eid="LUK 22:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51" />Yek Yesu wulsi ɗe, &lt;&lt;Zaka̱nsi!&gt;&gt; Yek ta̱ ta̱n ka̱n ga̱ ma̱lgwe sa̱ wotlit ka̱wu yek ka̱mi ndoki.<verse eid="LUK 22:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52" />Yek Yesu wul kiɗi ma̱n da̱nti ka̱ bii ngemti Nyami suk ma̱n hapti dlo jwasa̱n suk kiɗi jwasa̱n jwe tul ɗe ta̱s dopti wu ɗe, &lt;&lt;Ka̱a̱ li tet na̱ kiɗi puka suk sada ta̱k doɓa̱n ninini, muka̱l ka̱ɗe ami a? <verse eid="LUK 22:52" /><verse number="53" style="v" sid="LUK 22:53" />A ni sukkii mas cin ka̱lu lubii ga̱ Nya yek ba̱ka̱ doɓa̱n so, yek ninge ka̱n ka̱a̱ ya mbi tantu dopti gini ka̱ nda̱lti byas wul ga̱ da̱mshal.&gt;&gt;<verse eid="LUK 22:53" /></para>
  <para style="s">Biturus nge yisti ga̱ Yesu</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54" />Yek sa̱ dop Yesu, yek sa̱ zigaa na̱ ti, yek sa̱ ta̱lat ka̱ boo ga̱ bal ma̱n Pa̱ris. Yek Biturus ngusi kopti gwasa̱n tet dlenti. <verse eid="LUK 22:54" /><verse number="55" style="v" sid="LUK 22:55" />Yek sa̱ hot wutu a dii boo lubiimi wugo, yek sa̱ da̱m atli, Biturus mago yek ta̱ da̱m suksi njaa mal wuti. <verse eid="LUK 22:55" /><verse number="56" style="v" sid="LUK 22:56" />Yek ɗe na̱m ka̱ mil modli jwe na̱ma pa̱lti wul ka̱ lubiimi wu yenti wugo, yek ta̱ wutit gwel, yek ta̱ wule, &lt;&lt;Ma̱lga̱n go suk Yesu ka̱n ta̱ ni.&gt;&gt;<verse eid="LUK 22:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57" />Yek Biturus wule, &lt;&lt;Suk Yesu ka̱n a ni so, a yisti so pamma.&gt;&gt;<verse eid="LUK 22:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58" />La̱m da̱nti wugo, yek ma̱lgon po yis Biturus ɗa, yek ta̱ wule, &lt;&lt;Ki mago gon gwasa̱n ka̱n.&gt;&gt;</para>
  <para style="p" vid="LUK 22:58">Yek Biturus wule, &lt;&lt;Amik so.&gt;&gt;<verse eid="LUK 22:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59" />Nak po la̱m da̱nti tek wugo, yek ma̱lgon po wulti ɗe, &lt;&lt;Gem, ma̱lga̱n go suk Yesu ka̱n ta̱ ni. Na̱k ɗe ti mago ma̱n Galili ka̱wu.&gt;&gt; <verse eid="LUK 22:59" /><verse number="60" style="v" sid="LUK 22:60" />Yek Biturus wule, &lt;&lt;A yis ilgwe ka̱ na̱ma dla̱mti wu so pamma.&gt;&gt; Ta̱ na̱ma dla̱mti nugo yek gunda kol lak yal ka̱ bultlwe.<verse eid="LUK 22:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 22:61" />Yek Bagaa Yesu balla̱ti, yek ta̱ wuti gwel Biturus, yek Biturus daam ilgwe Yesu hwit wu ɗe, &lt;&lt;Ka nge yisti gini asa̱mi ɗe mekan a paa gunda kol nda lakti yal ase ka̱ bultlwe.&gt;&gt; <verse eid="LUK 22:61" /><verse number="62" style="v" sid="LUK 22:62" />Yek Biturus yil deɓa̱l yek ta̱ kul i'e.<verse eid="LUK 22:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63" />Yek ma̱jwe na̱ma da̱nti mal Yesu wu ndet wulti wul jon asa̱ na̱ma ɓot gwasi. <verse eid="LUK 22:63" /><verse number="64" style="v" sid="LUK 22:64" />Yek sa̱ ɓalit gwel ka, yek sa̱ njel wulti gwas ɗe, &lt;&lt;Hwini ma̱lgwe ɓok wu ta̱n yisi ɗe ki wo ma̱n dla̱mti ga̱ɓa ga̱ Nya ka̱n.&gt;&gt; <verse eid="LUK 22:64" /><verse number="65" style="v" sid="LUK 22:65" />Yek sa̱ ngusi byalti gwasi.<verse eid="LUK 22:65" /></para>
  <para style="s">Yesu a cina ɗa̱ kiɗi ji Ma̱n Yehuda ka</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66" />Lu tlo wugo, yek kiɗi ma̱n ba̱n suk kiɗi ma̱n da̱nti ka̱ lubii ga̱ Nya suk ma̱n lishti mba̱t ga̱ Musa mogaa, yek ma̱n hapti dlo tulli Yesu malsi. <verse eid="LUK 22:66" /><verse number="67" style="v" sid="LUK 22:67" />Yek sa̱ wulti ɗe, &lt;&lt;Kume kik ɗe Almasihu<note caller="+" style="f"><char style="fr" closed="false">22:67 </char><char style="ft" closed="false">Sogo </char><char style="fqa" closed="false">Kiristi</char></note> go, hwinii.&gt;&gt;</para>
  <para style="p" vid="LUK 22:67">Yek Yesu wulsi ɗe, &lt;&lt;Kume a hwikii mago ka kan ga̱ɓa gi so. <verse eid="LUK 22:67" /><verse number="68" style="v" sid="LUK 22:68" />A kume a kum ga̱s ilgon malkii go ka balli so. <verse eid="LUK 22:68" /><verse number="69" style="v" sid="LUK 22:69" />Ama ndok ase, ami Yen ga̱ Mbala̱n a da̱n ten ka̱t ang shinti ga̱ Nya Bal Kakshe.&gt;&gt;<verse eid="LUK 22:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70" />Yek mas jwasa̱n ngemti ɗe, &lt;&lt;Kik ɗe Yen ga̱ Nyami a?&gt;&gt;</para>
  <para style="p" vid="LUK 22:70">Yek ta̱ wulsi ɗe, &lt;&lt;Gem ka̱n ka̱a̱ dla̱mi, nu ka̱n ni.&gt;&gt;<verse eid="LUK 22:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71" />Yek sa̱ wule, &lt;&lt;Yek ma̱ yii ma ɓa̱tti ye, na̱k ɗe ma̱ kumi tet bi ɗatka wu?&gt;&gt;<verse eid="LUK 22:71" /></para>
  <chapter eid="LUK 22" />
  <chapter number="23" style="c" sid="LUK 23" />
  <para style="s">Yesu a cina ɗa̱ Bilatus ka</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1" />Yek mas kiɗi ji ma̱n Yehudasi tlinya yek sa̱ ta̱la Yesu mal Bilatus gobna, <verse eid="LUK 23:1" /><verse number="2" style="v" sid="LUK 23:2" />yek sa̱ ndet za̱t duu gaa ɗe, &lt;&lt;Ma̱ mbi ma̱lga̱n ten gilla̱t ga̱ mbala̱n jina̱n ɗe ba̱s ba̱l wulpi boo gwasa̱n Kaisar guu so. A ta̱ na̱ma wulti ɗe tik ɗe Almasihu guu.&gt;&gt;<verse eid="LUK 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3" />Yek Bilatus ngem Yesu ɗe, &lt;&lt;Kik ɗe guu ga̱ ma̱n Yehuda?&gt;&gt;</para>
  <para style="p" vid="LUK 23:3">Yek Yesu wule, &lt;&lt;Nu ka̱n ni.&gt;&gt;<verse eid="LUK 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4" />Yek Bilatus hwi kiɗi ma̱n da̱nti ka̱ lubii ga̱ Nyami suk naa mbala̱n ɗe, &lt;&lt;Yek laki yek ka̱a̱ tulla̱t ye? Ami wo a mbi byas ilgwe ta̱ pa̱li wu so.&gt;&gt;<verse eid="LUK 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 23:5" />Yek mbala̱mi ngusi wulti ɗe, &lt;&lt;Ga̱ɓa gwe ata̱ hwi mbala̱n wu ka̱ɗe ma̱n tlilti mbadl gwasa̱n ka̱ mas ba̱n ji Yehudiya, tet Galili ka̱n ta̱ nde, yek tik ɓallu a ɗee.&gt;&gt;<verse eid="LUK 23:5" /></para>
  <para style="s">Sa̱ ta̱la Yesu mal Hiridus</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6" />Bilatus kumi nu wugo yek ta̱ kum ga̱zi ɗe ko Yesu wo ma̱n Galili ka̱ɗe ti. Yek sa̱ wulti ɗe ma̱n Galili ka̱n. <verse eid="LUK 23:6" /><verse number="7" style="v" sid="LUK 23:7" />Bilatus kumi ɗe Yesu wo ka̱ atl ga̱ Hiridus guu ka̱n ta̱ ni wu, yek ta̱ wulsi ɗe, ta̱s ta̱lat malti na̱k ɗe Hiridus guu ni Wurshelima ka̱ multi jwisi wu.<verse eid="LUK 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8" />Hiridus guu yen Yesu wugo, yek ta̱ pa̱l hwol tuki i'e na̱k ɗe ta̱ la̱m multi ata̱ na̱ma kumti ga̱ɓa tenti wu. Ta̱ lami ta̱s yen wul cit ɓanti gwe a Yesu pa̱li wu. <verse eid="LUK 23:8" /><verse number="9" style="v" sid="LUK 23:9" />Yek ta̱ kum ga̱s wul wonti mal Yesu ama yek ba̱ Yesu wulti ɗe ilgon so. <verse eid="LUK 23:9" /><verse number="10" style="v" sid="LUK 23:10" />Kiɗi ma̱n da̱nti ka̱ lubii ga̱ Nya suk ma̱n yisti mba̱t ga̱ Musa ni ka̱li asa̱ na̱ma ta dla̱mti byas wul tenti. <verse eid="LUK 23:10" /><verse number="11" style="v" sid="LUK 23:11" />Yek Hiridus suk ma̱n hapti dlo jwas wulit wul jon, yek sa̱ wulit wul jon yek sa̱ lakit bal luka̱l, yek sa̱ palla̱t su mal Bilatus ka. <verse eid="LUK 23:11" /><verse number="12" style="v" sid="LUK 23:12" />Ndok ten gasi, yek Hiridus suk Bilatus da̱n ɗe yela̱n, na̱k ɗe yela̱n dlanti ka̱ɗe si wu.<verse eid="LUK 23:12" /></para>
  <para style="s">Sa̱ ba̱l bi ga̱ Yesu ta̱s tloti</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13" />Yek Bilatus mo kiɗi ma̱n da̱nti ka̱ bii ngemti Nya suk kiɗi ji ma̱n ba̱mi suk mbala̱mi mas. <verse eid="LUK 23:13" /><verse number="14" style="v" sid="LUK 23:14" />Yek ta̱ wulsi ɗe, &lt;&lt;Ka̱a̱ tulli ma̱lga̱n mala̱n ɗe ta̱ na̱ma gilla̱t ga̱ mbala̱n, ama yek a bodla̱lti yek baa mbit na̱ byas ilgon so. <verse eid="LUK 23:14" /><verse number="15" style="v" sid="LUK 23:15" />A ba̱ Hiridus mbit na̱ byas ilgon so pak, yek laki yek ta̱ palla̱t tet mala̱nni. Kiik ka yeni wu, ta̱ pa̱l ilgwe a laki ɗe ta̱n tlot wu so. <verse eid="LUK 23:15" /><verse number="16" style="v" sid="LUK 23:16" />Yek laki ɗe ɓot ka̱n ba ɓoti a paa a zakti.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">23:16 </char><char style="ft" closed="false">Ka̱ lishti jon ji cina wo sa lishi ɗe, </char><char style="fqa" closed="false">ti. </char><char style="fv" closed="false">17 </char><char style="fqa" closed="false">Ka̱ Motgaa daamti ɗakcit boo ji Israila gwisi ka̱n a Bilatus kul laki asa̱ zak ɗe na̱m ka̱ ma̱jwe sa̱ ɓalsi ju. </char></note><verse eid="LUK 23:16" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18" />Yek mbala̱mi ɓel bi yek sa̱ ngusi wulti na̱ nda̱lti ɗe, &lt;&lt;Za̱n gaa na̱ ma̱lga̱n! A ka̱ zakini Barabas.&gt;&gt; <verse eid="LUK 23:18" /><verse number="19" style="v" sid="LUK 23:19" />Barabas tulli dlanti ka̱ dlo ga̱ mbala̱n a Wurshelima, yek ta̱ po tlo ma̱lgon. Yek laki yek sa̱ ɓalti.<verse eid="LUK 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20" />Yek Bilatus wulsi ɗa̱ɗe, ta̱ lami ɗe ta̱s zak Yesu. <verse eid="LUK 23:20" /><verse number="21" style="v" sid="LUK 23:21" />Yek sa̱ ngusi dla̱mti na̱ nda̱lti ɗe, &lt;&lt;Ɓaka̱nti ten guda̱l yencin ta̱s ma̱shi!&gt;&gt;<verse eid="LUK 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22" />Yek Bilatus po wulsi asa̱mi na mekan ɗe, &lt;&lt;Yek laki ɗe ka̱ lami ta̱ ma̱lga̱n ma̱shi ye? Byas wul yek ta̱ pa̱li ye? A mbit na̱ byas ilgwe a laki ta tlot wu so. Ba laki asa̱ ɓot na̱ tlemndi a paa a zakti.&gt;&gt;<verse eid="LUK 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23" />Ama yek sa̱ nge, yek sa̱ ngusi wulti na̱ nda̱lti ɗe, &lt;&lt;Ɓaka̱nti ten guda̱l yencin!&gt;&gt; Yek ga̱ɓe gwasa̱n wu ka̱ dla̱li. <verse eid="LUK 23:23" /><verse number="24" style="v" sid="LUK 23:24" />Yek Bilatus pa̱lisi ilgwe sa̱ lami wu. <verse eid="LUK 23:24" /><verse number="25" style="v" sid="LUK 23:25" />Yek ta̱ zakisi Barabas, ma̱lgwe sa̱ ɓalti ten ɗe ta̱ tlo ma̱lgon wu, yek ta̱ ba̱lsi Yesu ta̱s pa̱lit ilgwe sa̱ lami wu.<verse eid="LUK 23:25" /></para>
  <para style="s">Sa̱ ɓak Yesu ten guda̱l yencin</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26" />Ma̱n hapti dlo na̱ma za̱t gaa na̱ Yesu nugo, yek sa̱ mo suk ma̱lgon asa̱ mbet ɗe Siman ma̱n ba̱n Sayirin ta̱ na̱ma la̱t Wurshelima. Yek sa̱ dopti yek sa̱ zit guda̱l yencin gwe sa̱ ɓak Yesu dani wu gaa, yek sa̱ lakti ta̱s kop Yesu na̱ nali. <verse eid="LUK 23:26" /><verse number="27" style="v" sid="LUK 23:27" />A mbala̱n wonti na̱ma kopti gwasa̱n suk modli jon asa̱ na̱ma desti lee. <verse eid="LUK 23:27" /><verse number="28" style="v" sid="LUK 23:28" />Yek Yesu balla̱ti, yek ta̱ wulsi ɗe, &lt;&lt;Modli Wurshelima, po kuli ninini gaa so, kuli gaa gwaka̱n suk mil jwaka̱n. <verse eid="LUK 23:28" /><verse number="29" style="v" sid="LUK 23:29" />Gas gon wo ka wule, &lt;Modli jwe zi yen so, a ba̱sa̱ lu mil kaal sogo ma̱n hwol tuk ka̱ɗe si.&gt; <verse eid="LUK 23:29" /><verse number="30" style="v" sid="LUK 23:30" />Ten gasisi ka̱n</para>
  <para style="q1" vid="LUK 23:30">&lt;&lt; &lt;mbala̱n a wul tla̱da̱l ɗe, &lt;&lt;Ndenii sut gaa,&gt;&gt;</para>
  <para style="q2" vid="LUK 23:30">asa̱ wul za̱nda̱l ɗe, &lt;&lt;Yitlani ka.&gt;&gt; &gt;<note caller="+" style="f"><char style="fr" closed="false">23:30 </char><char style="ft" closed="false">Yen <char style="xt"><ref loc="HOS 10:8">Hos 10:8</ref> </char></char></note><verse eid="LUK 23:30" /></para>
  <para style="m">
    <verse number="31" style="v" sid="LUK 23:31" />Kume sa̱ pa̱li nu a tlindi yi diki go, nii ka̱n a pi gwi ɗe tlindi koo wu?&gt;&gt;<verse eid="LUK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32" />Yek sa̱ ta̱la mbala̱n ɗe lop jon jwe pa̱l byas wul wu ta̱s tlosi pak suk Yesu. <verse eid="LUK 23:32" /><verse number="33" style="v" sid="LUK 23:33" />Yek sa̱ ta̱lasi ka̱lu gwe asa̱ mbe ɗe &lt;&lt;Is Gaa&gt;&gt; wu. Ka̱li ka̱n sa̱ ɓakti ten guda̱l yencin suk mbala̱n ɗe lop jwe pa̱l byas wul ju. Gon ni ten guda̱l yencin ten ka̱t ang shinti gwasi a gon wo ten ka̱t ang yali gwasi. <verse eid="LUK 23:33" /><verse number="34" style="v" sid="LUK 23:34" />Yek Yesu wule, &lt;&lt;Aba, taasi ma̱jin byas wul jwasa̱n ka, na̱k ɗe ba̱sa̱ yis ilgwe sa̱ na̱ma pa̱lti wu sowu.&gt;&gt; Yek sa̱ huul luka̱l ga̱ Yesu ka̱ dlo gwasa̱n ten botlti ga̱ ma̱lgwe a kan wu.<verse eid="LUK 23:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 23:35" />Yek mbala̱n ngusi yenti ga̱ Yesu, yek kiɗi jwasa̱n wulit wul jon ɗe, &lt;&lt;Ta̱ kis naa mbala̱n, ta̱s kis gaa gwas la kume tik ɗe Almasihu gwe Nya botlti wu.&gt;&gt;<verse eid="LUK 23:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 23:36" />Yek ma̱n hapti dlo jwe ɓakti ten guda̱l yencimi wu wulit wul jon, yek sa̱ takit mbayi ze. <verse eid="LUK 23:36" /><verse number="37" style="v" sid="LUK 23:37" />Yek sa̱ wulti ɗe, &lt;&lt;Kume kik ɗe guu ga̱ ma̱n Yehuda go, kis gaa gwa la.&gt;&gt;<verse eid="LUK 23:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38" />Yek sa̱ lishi ten guda̱l yencimi to gaa ɗatka̱ɗe, &lt;&lt;Ma̱lga̱n ka̱ɗe guu ga̱ ma̱n Yehuda.&gt;&gt;<verse eid="LUK 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39" />Yek ɗe na̱m ka̱ ma̱jwe pa̱l byas wul ɗe sa̱ ɓaksi ten guda̱l yencin mal Yesu wu, hwit byas ga̱ɓa ɗe, &lt;&lt;Ale kik ɗe Almasihu nwa? Kis gaa gwa aka̱ kisnii pak la.&gt;&gt; <verse eid="LUK 23:39" /><verse number="40" style="v" sid="LUK 23:40" />Yek ma̱li gon wu matlti yek ta̱ wulti ɗe, &lt;&lt;Ɓanti ga̱ Nya mago cik sa? Ɗe ilgwe sa̱ pa̱lini wu ka̱n sa̱ pa̱lit wu. <verse eid="LUK 23:40" /><verse number="41" style="v" sid="LUK 23:41" />Mi wo byas ilgwe ma̱ pa̱li wu mbuki ta̱s pa̱lini nu, ama ma̱lga̱n go ta̱ pa̱l byas ilgon so.&gt;&gt;<verse eid="LUK 23:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 23:42" />Yek ta̱ wul Yesu ɗe, &lt;&lt;A ka̱ yisi lu ne, kume ka̱ ɓal ɗe guu wu.&gt;&gt;<verse eid="LUK 23:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43" />Yek Yesu wulti ɗe, &lt;&lt;A nikma hwit gem ɗe, ase go ka da̱n suk ami ka̱ Boo ga̱ Nya.&gt;&gt;<verse eid="LUK 23:43" /></para>
  <para style="s">Ma̱shka̱n ga̱ Yesu</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44" />Sa̱ ni nugo, ka̱ dlo cin, yek da̱mshal yitla lu ka mas, se na̱k cin celti. <verse eid="LUK 23:44" /><verse number="45" style="v" sid="LUK 23:45" />Yek cin zak cilti, yek labule ga̱ lubii ga̱ Nya kesh su dlo ka. <verse eid="LUK 23:45" /><verse number="46" style="v" sid="LUK 23:46" />Yek Yesu wul na̱ nda̱lti ɗe, &lt;&lt;Aba gini, ka̱ ang gwaka̱n a zi mbadl gini.&gt;&gt; Ta̱ dla̱m nu wugo, yek ta̱ ma̱shi.<verse eid="LUK 23:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47" />Yek bal ma̱n hapti tlo ga̱ ma̱n Roma gwe ni ka̱li wu yeni nu wugo, yek ta̱ ta̱s Nya, yek ta̱ wule, &lt;&lt;Gem, ma̱lga̱n go zok mbala̱n ka̱n.&gt;&gt; <verse eid="LUK 23:47" /><verse number="48" style="v" sid="LUK 23:48" />Yek mas ma̱jwe mogaa ta̱s yen ilgwe a pi wu yeni nu wugo, yek sa̱ ɓo ang ten ngetli, yek sa̱ zigaa. <verse eid="LUK 23:48" /><verse number="49" style="v" sid="LUK 23:49" />Yek mas ma̱jwe yis Yesu, suk modli jwe kopti tet Galili wu dla̱l tet dlenti, yek sa̱ ngusi yenti ilgwe na̱ma pa̱t wu.<verse eid="LUK 23:49" /></para>
  <para style="s">Lepti ga̱ Yesu</para>
  <para style="p">
    <verse number="50-51" style="v" sid="LUK 23:50-51" />Ma̱lgon ni ɗa asa̱ mbet ɗe Yusupu ma̱n pa̱lti zok wul gon. Ta̱ na̱ma hwol tuk ten ɓa̱tti ga̱ Nya ta̱s tul ɗe guu ka̱ mbadl ga̱ mbala̱n. Ti wo ma̱n ba̱n ga̱ Yehuda gon ka̱n gwe asa̱ mbe ɗe Arimatiya wu, a bal mbala̱n ga̱ ma̱n Yehuda ka̱ pak. Ama ba̱ta̱ mo bi suksi ten ilgwe sa̱ pa̱li Yesu wu so. <verse eid="LUK 23:50-51" /><verse number="52" style="v" sid="LUK 23:52" />Yek ta̱ li mal Bilatus yek ta̱ ngemti ta̱s ba̱lti hwuu ga̱ Yesu. Yek ta̱ zakti ta̱s lak kami. <verse eid="LUK 23:52" /><verse number="53" style="v" sid="LUK 23:53" />Yek Yusupu shit hwuunisi sut ɗa̱ ten guda̱l yencimi ka, yek ta̱ kus ka ka̱ mbuni hwol luka̱l yek ta̱ zi ka̱ gaa zukɗi gwe sa̱ tlat ka̱ paa a ba̱sa̱ ɓo lep ma̱lgon giɓi sowu. <verse eid="LUK 23:53" /><verse number="54" style="v" sid="LUK 23:54" />A cin la̱ka̱nti wul ka̱n na̱k ɗe gas shukti ɓal njaa wu.<verse eid="LUK 23:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55" />Yek modli jwe kop Yesu tet Galili wu li suk Yusupu yek sa̱ yen gaa zukɗisi suk kangwe sa̱ zi hwuu ga̱ Yesu a giɓi wu. <verse eid="LUK 23:55" /><verse number="56" style="v" sid="LUK 23:56" />Yek sa̱ li ga̱za̱n yek sa̱ la̱ka̱n turare suk mil tuksa̱ti, yek sa̱ shuki ten gas shukti na̱k gwe mba̱t ga̱ Musa dla̱m wu.<verse eid="LUK 23:56" /></para>
  <chapter eid="LUK 23" />
  <chapter number="24" style="c" sid="LUK 24" />
  <para style="s">Palti ga̱ Yesu kaami</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1" />Gas ndat multi ɗe na̱m ga̱ nitgi kaal ɗa̱ gas shukti ka̱ bultlwe yek modli ju li ka̱ gaa zukɗi ga̱ Yesu na̱ turare gwasa̱n. <verse eid="LUK 24:1" /><verse number="2" style="v" sid="LUK 24:2" />Yek sa̱ mbi go sa̱ guda̱l bal ye gwe sa̱ zi ten bi gaa zukɗisi wu ka̱wi. <verse eid="LUK 24:2" /><verse number="3" style="v" sid="LUK 24:3" />Yek modlisi te ka̱ gaa zukɗisi wugo yek ba̱sa̱ mbi hwuu ga̱ Yesu Bagaa a giɓi so. <verse eid="LUK 24:3" /><verse number="4" style="v" sid="LUK 24:4" />Sa̱ na̱ma daamti gwasa̱n nugo yek ma̱jon ka̱ju si ɗe lop a malsi na̱ hwol luka̱l ma̱n cilti i'e. <verse eid="LUK 24:4" /><verse number="5" style="v" sid="LUK 24:5" />Ɓanti ɓa cisi go yek sa̱ ngusa̱l gaa gwasa̱n atli. Yek mbala̱mi wulsi ɗe, &lt;&lt;Yek laki ɗe ka̱ na̱ma ngot ga̱ ma̱lgwe ni kaami wu ka̱ hwuu mbala̱n ye? <verse eid="LUK 24:5" /><verse number="6" style="v" sid="LUK 24:6" />Ta̱ po yi ɗee so, ta̱ tli ɗa̱ka̱ ma̱shka̱n ka wu na̱k gwe ta̱ dla̱mi ata̱ yi sukkii a Galili wu. <verse eid="LUK 24:6" /><verse number="7" style="v" sid="LUK 24:7" />Ɗe ta̱ wulkii ɗe sa ba̱l bi ga̱ Yen ga̱ Mbala̱n a ang ɗa̱ ma̱n pa̱lti byas wul ka asa̱ ɓakti ten guda̱l yencin, a ten gas na̱ mekan wo ata̱ tli ɗa̱ka̱ ma̱shka̱n ka.&gt;&gt; <verse eid="LUK 24:7" /><verse number="8" style="v" sid="LUK 24:8" />Yek ga̱ɓe te modlisi ka̱n,<verse eid="LUK 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 24:9" />Yek sa̱ pal tet ka̱lu gaa zukɗisi wugo, yek sa̱ hwi mil shinti ji botli ga̱ Yesu ɗe kutl cet na̱m ju suk mas ma̱jwe ni ka̱li wu. <verse eid="LUK 24:9" /><verse number="10" style="v" sid="LUK 24:10" />Modli jwe li ka̱lu gaa zukɗisi jo sik ɗe, Maryam Maga̱dala suk Yuwana suk Maryam ana ga̱ Yakubu suk naa modli jwe ni suksi wu. <verse eid="LUK 24:10" /><verse number="11" style="v" sid="LUK 24:11" />Ama yek mil shinti ji botlisi palli ga̱ɓe ɗe jetiti yek ba̱sa̱ kan so. <verse eid="LUK 24:11" /><verse number="12" style="v" sid="LUK 24:12" />Yek Biturus tlinya na̱ apti ta̱s lak yen ilgwe modli ju dla̱m wu, yek ta̱ kus gaa zukɗisi, yek ta̱ yen luka̱l gwe sa̱ lep hwuuni ga̱ Yesu a giɓi wu ten ka̱ti gon, yek ta̱ pal lubii a ili nitma cit ɓanti ata̱ na̱ma daamti gwas a dani.<verse eid="LUK 24:12" /></para>
  <para style="s">Ma̱n kopti ji Yesu ɗe lop mo sukti ten tantu Imawus</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13" />Ten gasisi, yek ma̱n kopti ji Yesu jon ɗe lop na̱ma la̱t ten tantu ba̱n gon asa̱ mbe ɗe Imawus, dlenta̱t ga̱ Imawus tet Wurshelima wo mil ɗe nitgi ka̱n. <verse eid="LUK 24:13" /><verse number="14" style="v" sid="LUK 24:14" />Asa̱ na̱ma ga̱ɓa ka̱ dlo gwasa̱n ten mas wul jwe pi wu. <verse eid="LUK 24:14" /><verse number="15" style="v" sid="LUK 24:15" />Sa̱ na̱ma ga̱ɓa asa̱ na̱ma daamti gwasa̱n nugo yek Yesu ka̱wu yek ta̱ njel la̱t suksi. <verse eid="LUK 24:15" /><verse number="16" style="v" sid="LUK 24:16" />Ama yek ba̱sa̱ yisi ɗe Yesu ka̱ ni malsi so.<verse eid="LUK 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 24:17" />Yek ta̱ ngemsi ɗe, &lt;&lt;Yek ka̱a̱ na̱ma dla̱mti ten tantu na̱n ye?&gt;&gt;</para>
  <para style="p" vid="LUK 24:17">Yek sa̱ dla̱l ka̱li asa̱ na̱ma duu tuki. <verse eid="LUK 24:17" /><verse number="18" style="v" sid="LUK 24:18" />Yek gon gwasa̱n asa̱ mbet ɗe Kiliyopas ngemti ɗe, &lt;&lt;Kik ɗe ma̱nda̱ki na̱ ngwe a Wurshelima ɗe ba̱ka̱ yis iljwe na̱ma pa̱t ka̱ multi jin so gwa?&gt;&gt;<verse eid="LUK 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19" />Yek Yesu ngemsi ɗe, &lt;&lt;Yek pi ye?&gt;&gt;</para>
  <para style="p" vid="LUK 24:19">Yek sa̱ wulti ɗe, &lt;&lt;Iljwe pi ten bi ga̱ Yesu ma̱n Nazarat wu ma̱n dla̱mti ga̱ɓa ga̱ Nya, ma̱n nda̱li ga̱ɓa a ma̱n pa̱lti kiɗi wul a cina ɗa̱ Nya suk mas mbala̱n wu. <verse eid="LUK 24:19" /><verse number="20" style="v" sid="LUK 24:20" />Yek kiɗi ma̱n da̱nti ka̱ bii ngemti Nya suk kiɗi jina̱n ba̱ltiti ma̱n tlot gwasi yek sa̱ ɓakti ten guda̱l yencin. <verse eid="LUK 24:20" /><verse number="21" style="v" sid="LUK 24:21" />Ma̱ lak mbadl ɗe tik ka yilli ma̱n Yisiraila tet ɗa̱ka̱ ang ga̱ ma̱n nget ga̱na̱n ka, ama yek multi ɗe mekan ka̱ ɓali na̱ pa̱t ga̱ ili. <verse eid="LUK 24:21" /><verse number="22" style="v" sid="LUK 24:22" />Yek modli jon ka̱ mbala̱n jina̱n cini ɓanti ɗe sa̱ yil ka̱ bultlwe yek sa̱ li ka̱lu gaa zukɗisi, <verse eid="LUK 24:22" /><verse number="23" style="v" sid="LUK 24:23" />yek ba̱sa̱ mbi hwuu gwas so. Yek sa̱ pal teɗi yek sa̱ hwini ɗe, gwel gwasa̱n ɓuli yek sa̱ yen mil shinti ji Nya jwe wulsi ɗe Yesu tli ɗa̱ka̱ ma̱shka̱n ka wi. <verse eid="LUK 24:23" /><verse number="24" style="v" sid="LUK 24:24" />Yek jon ka̱ mi li ka̱lu gaa zukɗisi pak yek sa̱ mbi go ta̱ po yi so na̱k gwe modli ju dla̱m wu.&gt;&gt;<verse eid="LUK 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25" />Yek Yesu wulsi ɗe, &lt;&lt;Kii wo ka̱ ka̱dla̱n hwo, a yisti mas wul jwe ma̱n dla̱mti ga̱ɓa ga̱ Nya lishi wu bomikii gaa! <verse eid="LUK 24:25" /><verse number="26" style="v" sid="LUK 24:26" />Ngetli ka̱n ta̱ Almasihu tla bomti nu apaa ta̱ da̱n ka̱ nalti gwasi.&gt;&gt; <verse eid="LUK 24:26" /><verse number="27" style="v" sid="LUK 24:27" />Yek ta̱ ndesi ga̱ɓa ten lishti ga̱ Musa suk mas ga̱ ma̱n dla̱mti ga̱ɓa ga̱ Nya jwe lish ga̱ɓa tenti wu.<verse eid="LUK 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28" />Yek sa̱ ɓal njaa a Imawus go, yek Yesu pi wule ta zaka̱nsi ta̱s li cina. <verse eid="LUK 24:28" /><verse number="29" style="v" sid="LUK 24:29" />Yek sa̱ ngemti ta̱s da̱n suksi ka̱ ba̱mi na̱k ɗe sukti ka̱ ɓallu, a cin nda bii wi. Yek ta̱ kopsi ka̱lu gwe sa mullu.<verse eid="LUK 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 24:30" />Yek sa̱ da̱m na̱ zhila ta̱s nguk wul wugo, yek ta̱ kan burodi yek ta̱ pa̱l hwol tuk na̱ Nya yek ta̱ caali yek ta̱ huulisi. <verse eid="LUK 24:30" /><verse number="31" style="v" sid="LUK 24:31" />Yek ninge yek sa̱ yisti, njet go yek ta̱ gilisi ka. <verse eid="LUK 24:31" /><verse number="32" style="v" sid="LUK 24:32" />Yek sa̱ wul ka̱ dlo gwasa̱n ɗe, &lt;&lt;Ta̱ hwini ga̱ɓa ga̱ Nya ten Almasihu ten tantu go, yek ba̱ mbadl kweka̱mini ka̱sa?&gt;&gt;<verse eid="LUK 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 24:33" />Yek sa̱ tlinya yek sa̱ pal su Wurshelima ka, yek sa̱ mbi ma̱n kopti jwas ɗe kutl cet na̱m suk ma̱jwe ni suksi ju. <verse eid="LUK 24:33" /><verse number="34" style="v" sid="LUK 24:34" />Yek mas ma̱n koptisi ngusi wulti ɗe, &lt;&lt;Gem ka̱n, Yesu Bagaa tli ɗa̱ka̱ ma̱shka̱n ka wi yek ta̱ mo suk Biturus.&gt;&gt; <verse eid="LUK 24:34" /><verse number="35" style="v" sid="LUK 24:35" />Yek sa̱ dla̱m ilgwe pi ten tantu Imawus wu suk kangwe sa̱ yisti ɗe ta̱ huulisi burodi wu.<verse eid="LUK 24:35" /></para>
  <para style="s">Iljwe Yesu zaki ma̱n kopti jwas ɗe ta̱s pa̱li wu</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36" />Sa̱ na̱ma ga̱ɓe nugo yek Yesu ka̱ ɓallu na̱ gaa gwasi, yek ta̱ dla̱l ka̱ dlo gwasa̱n, yek ta̱ wulsi ɗe, &lt;&lt;Ta̱ mbadl gwaka̱n ta̱mi.&gt;&gt;<verse eid="LUK 24:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37" />Yek ɓanti cisi mas jwasa̱n, sa̱ da̱m gwa we lul ka̱n sa̱ yenti. <verse eid="LUK 24:37" /><verse number="38" style="v" sid="LUK 24:38" />Yek ta̱ ngemsi ɗe, &lt;&lt;Yek ka cikii ɓanti nu ɗe ba̱ mbadl dla̱likii so ye? <verse eid="LUK 24:38" /><verse number="39" style="v" sid="LUK 24:39" />Ɓo yena̱n ang suk asa̱n gini, ami ka̱n na̱ gaa gini, ta̱na̱nni nini ta̱k ɓo kumini. Lul ka̱ɗe ami so, lul wo tli niɗɗa̱ na̱k gi wu so.&gt;&gt;<verse eid="LUK 24:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 24:40" />Ta̱ dla̱m nu wugo, yek ta̱ mbokisi ang ten ang suk asa̱n gwasi. <verse eid="LUK 24:40" /><verse number="41" style="v" sid="LUK 24:41" />A ba̱ mbadl gwasa̱n ɓo dla̱l so, na̱k ɗe ili cisi ɓanti ama asa̱ na̱ma hwol tuk pak. Yek ta̱ ngemsi ɗe, &lt;&lt;Ilga̱ nguki ni kii ɗa a ɗee ma?&gt;&gt; <verse eid="LUK 24:41" /><verse number="42" style="v" sid="LUK 24:42" />Yek sa̱ ba̱lti kwes ga̱ buki. <verse eid="LUK 24:42" /><verse number="43" style="v" sid="LUK 24:43" />Yek ta̱ kami yek ta̱ nguki asa̱ na̱ma yenti.<verse eid="LUK 24:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44" />Yek ta̱ wulsi ɗe, &lt;&lt;Ilgwe a hwikii ɗe a yi sukkii wuggu, mas iljwe sa̱ dla̱m tena̱n ka̱ mba̱t ga̱ Musa, suk iljwe ma̱n dla̱mti ga̱ɓa ga̱ Nya lishi, suk ka̱ Zabura wu a da̱m ɗe gem.&gt;&gt;<verse eid="LUK 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45" />Yek ta̱ ɓul mbadl gwasa̱n kangwe sa yis lishti ga̱ ga̱ɓa ga̱ Nya wu. <verse eid="LUK 24:45" /><verse number="46" style="v" sid="LUK 24:46" />Yek ta̱ wulsi ɗe, &lt;&lt;Ilgwe ni ga̱ lishi wuggu, Almasihu a tla bomti ata̱ ma̱shi, a ten ndat cin na mekan wo ta tli ɗa̱ka̱ ma̱shka̱n ka. <verse eid="LUK 24:46" /><verse number="47" style="v" sid="LUK 24:47" />A paa sa̱ hwi ga̱ɓa mbala̱n ten dii atl ɗa̱nka, ten bi cit atl gaa mal Nya suk taasti byas wul jwasa̱n ka ka̱ shin gwasi. Tet Wurshelima ka̱n sa nde. <verse eid="LUK 24:47" /><verse number="48" style="v" sid="LUK 24:48" />Kik ka yen wul jwisi na̱ gwel gwaka̱n, aka̱a̱ dla̱mi mbala̱n. <verse eid="LUK 24:48" /><verse number="49" style="v" sid="LUK 24:49" />Yekgu ba shinikii lu na̱ ma̱lgwe aba gi dla̱lli ga̱ɓa ɗe ta ba̱li wu, ama ɓa̱ti ka̱ bal ba̱mi se Nya ba̱lkii nda̱lti sut paa.&gt;&gt;<verse eid="LUK 24:49" /></para>
  <para style="s">Kanti ga̱ Yesu to nya ka</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50" />La̱m multi wugo, yek Yesu yilli ma̱n kopti jwas te kaal bal ba̱n Wurshelima ka, yek sa̱ li Betani. Yek ta̱ tlil ang gwas nya, yek ta̱ ngemisi hwa wul ga̱ Nya. <verse eid="LUK 24:50" /><verse number="51" style="v" sid="LUK 24:51" />Ta̱ nisi ma ngemti hwa wul ga̱ Nya nugo, yek ta̱ huul suksi, yek sa̱ kanti to nya ka. <verse eid="LUK 24:51" /><verse number="52" style="v" sid="LUK 24:52" />Yek sa̱ ngus atli, yek sa̱ ba̱lti nalti. Yek sa̱ pal te Wurshelima ka na̱ hwol tuki i'e, <verse eid="LUK 24:52" /><verse number="53" style="v" sid="LUK 24:53" />yek sa̱ ngusi la̱t ka̱ lubii ga̱ Nya mas cin, asa̱ na̱ma ta̱sti ga̱ Nya Bal Kakshe.<verse eid="LUK 24:53" /></para>
  <chapter eid="LUK 24" />
</usx>