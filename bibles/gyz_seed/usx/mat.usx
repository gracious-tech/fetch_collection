<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">MATHEW - Geji New Testament</book>
  <para style="h">Matiyu</para>
  <para style="toc1">Matiyu</para>
  <para style="toc2">Matiyu</para>
  <para style="toc3">Mat</para>
  <para style="mt2">Ga̱ɓa ma̱n ta̱mti tumal</para>
  <para style="mt1">Matiyu</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Dla̱mti ma̱jwe Yesu Almasihu yil tet tumalsi wu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Ga̱n ka̱ɗe taka̱rda gwe na̱ma mbokti ang ten mbala̱n jwe Yesu Almasihu yen ga̱ Dauda, yen ga̱ Iba̱rahim yil tet tumalsi wu.<verse eid="MAT 1:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="MAT 1:2" />Iba̱rahim ka̱ɗe aba ga̱ Ishaku,</para>
  <para style="li2" vid="MAT 1:2">Ishaku ka̱ zi Yakubu,</para>
  <para style="li2" vid="MAT 1:2">Yek Yakubu zi Yehuda suk yilkeni jwasi,<verse eid="MAT 1:2" /></para>
  <para style="li2">
    <verse number="3" style="v" sid="MAT 1:3" />Yehuda ka̱ɗe aba ga̱ Peres suk Zera, ana gwasa̱n ka̱ɗe Tamar.</para>
  <para style="li2" vid="MAT 1:3">Peres ka̱ zi Heza̱ron,</para>
  <para style="li2" vid="MAT 1:3">Yek Heza̱ron zi Aram,<verse eid="MAT 1:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="MAT 1:4" />Aram ka̱ zi Aminadab,</para>
  <para style="li2" vid="MAT 1:4">Aminadab ka̱ zi Nashon,</para>
  <para style="li2" vid="MAT 1:4">Yek Nashon zi Salmon,<verse eid="MAT 1:4" /></para>
  <para style="li2">
    <verse number="5" style="v" sid="MAT 1:5" />Salmon ka̱ zi Bo'az ma̱lgwe ana gwas ka̱ɗe Rahab wu.</para>
  <para style="li2" vid="MAT 1:5">Bo'az ka̱ zi Obida ma̱lgwe ana gwas ka̱ɗe Rut wu.</para>
  <para style="li2" vid="MAT 1:5">Yek Obida zi Yese,<verse eid="MAT 1:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="MAT 1:6" />Yese ka̱ zi Dauda guu,</para>
  <para style="li2" vid="MAT 1:6">Dauda ka̱ zi Sulemanu ma̱lgwe ana gwas wo, tek go kili ga̱ Wuriya ka̱ɗe ti wu.<verse eid="MAT 1:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="MAT 1:7" />Yek Sulemanu guu zi Rehobowam.</para>
  <para style="li2" vid="MAT 1:7">Yek Rehobowam zi Abija,</para>
  <para style="li2" vid="MAT 1:7">Abija ka̱ zi Asa, <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />Asa ka̱ zi Yehoshapat.</para>
  <para style="li2" vid="MAT 1:8">Yek Yehoshapat zi Joram,</para>
  <para style="li2" vid="MAT 1:8">Joram ka̱ zi Yuziya.<verse eid="MAT 1:8" /></para>
  <para style="li2">
    <verse number="9" style="v" sid="MAT 1:9" />Yek Yuziya zi Jotam,</para>
  <para style="li2" vid="MAT 1:9">Jotam ka̱ zi Ahaz,</para>
  <para style="li2" vid="MAT 1:9">Ahaz ka̱ zi Hezekiya. <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Yek Hezekiya zi Manasa,</para>
  <para style="li2" vid="MAT 1:10">Manasa ka̱ zi Amon,</para>
  <para style="li2" vid="MAT 1:10">Amon ka̱ zi Josiya.<verse eid="MAT 1:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="MAT 1:11" />Yek Josiya zi Yekoniya suk yilkeni jwasi ka̱ sa'i gwe sa̱ yem ma̱n Yehuda ɗe zhel a Babila wu.<verse eid="MAT 1:11" /></para>
  <para style="li">
    <verse number="12" style="v" sid="MAT 1:12" />Kaal ɗa̱ da̱mti zhel gwasa̱n a Babila, yek Yekoniya zi Shayeltiyel,</para>
  <para style="li2" vid="MAT 1:12">Shayeltiyel ka̱ zi Zerubabel.<verse eid="MAT 1:12" /></para>
  <para style="li2">
    <verse number="13" style="v" sid="MAT 1:13" />Yek Zerubabel zi Abihud,</para>
  <para style="li2" vid="MAT 1:13">Abihud ka̱ zi Eliyakim,</para>
  <para style="li2" vid="MAT 1:13">Eliyakim zi Azor.<verse eid="MAT 1:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="MAT 1:14" />Yek Azor zi Zadok,</para>
  <para style="li2" vid="MAT 1:14">Zadok ka̱ zi Akim.</para>
  <para style="li2" vid="MAT 1:14">Akim zi Eliyud.<verse eid="MAT 1:14" /></para>
  <para style="li2">
    <verse number="15" style="v" sid="MAT 1:15" />Yek Eliyud zi Eliyaza,</para>
  <para style="li2" vid="MAT 1:15">Eliyaza ka̱ zi Matan,</para>
  <para style="li2" vid="MAT 1:15">Matan ka̱ zi Yakubu. <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />Yek Yakubu zi Yusupu kos ga̱ Maryam ma̱lgwe zi Yesu gwe asa̱ mbet ɗe Almasihu wu.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Tet ten Iba̱rahim hal yek la Dauda mbala̱n ɗe kutl cet wupsi ka̱n. A Tet ten Daude yek la da̱mti zhel gwasa̱n a Babila go mbala̱n ɗe kutl cet wupsi ka̱ pak. Tet ten da̱mti zhel gwasa̱n a Babila yek la Almasihu mago mbala̱n ɗe kutl cet wupsi ka̱n.<verse eid="MAT 1:17" /></para>
  <para style="s">Za̱t ga̱ Yesu Almasihu</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Kangwe za̱t ga̱ Yesu Almasihu ni wu wuggu. A Yusupu yi ɗe yen kos ga̱ Maryam ana ga̱ Yesu, tun ba̱sa̱ ɓo pa̱l hapti so yek ta̱ mbi yen tuki tumal Shishi ga̱ Nya a ba̱ta̱ ɓo yis maani so. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Ama na̱k ɗe hwa mbala̱n ka̱ɗe Yusupu yen kos gwas wu, yek ba̱ta̱ lami ɗe ta̱s lak Maryam ka̱ nsha ka̱ dlo mbala̱n so. Yek ta̱ gwe ta̱s zakti mukli.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />Ama tun a ta̱ yima daamti gwas ten pa̱lti nu, yek Yen shinti ga̱ Nya tul malti ka̱ tlunka̱ti. Yek ta̱ wulti ɗe, Yusupu yen ga̱ Dauda, kan Maryam ɗe kili gwa, ba̱ ɓanti cik so, yen tuk gwe ta̱ mbi go sut mal Shishi ga̱ Nya ka̱n. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Ta zi yen, aka̱ zit shin ɗe Yesu, na̱k ɗe tik ka kis mbala̱n jwas ɗa̱ka̱ pa̱lti byas wul ka̱wu.<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Ili pi na̱k gwisi ta̱ ga̱ɓa gwe Nya dla̱m tumal ma̱n dla̱mti ga̱ɓa gwas wu njika̱n. <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />Ga̱ɓa gwe wule, &lt;&lt;Yek ge yen kili gwe ɓo yis maani sowu a mbi yen tuki, ata̱ zi yen maani, asa zit shin ɗe Imanuwel.&gt;&gt; Gwe yek ɗe, &lt;&lt;Nya ni sukmi wu.&gt;&gt;<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Ɗe Yusupu pa̱da̱l tet yemba̱l wu, yek ta̱ kop ilgwe yen shinti ga̱ Nyami hwit ɗe ta̱s pa̱li wu, yek ta̱ hap Maryam ɗe kili gwasi. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Ama yek ba̱ta̱ yisti so se na̱k ta̱ zi yen cina gwasi, yek ta̱ zit shin ɗe Yesu.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Tulti ga̱ ma̱n yisti kyatla̱l tet gaba̱s</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Sa̱ zi Yesu ka̱ ba̱n Baitalami ka̱ atl ga̱ Yehudiya, ka̱ sa'i gwe Hiridus ni ɗe bal guu wu, yek ma̱n yisti kyatla̱l jon tet gaba̱s tul Wurshelima, Yek sa̱ kum ga̱zi ɗe, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />&lt;&lt;Guu ga̱ ma̱n Yehuda gwe sa̱ ya za̱t wuk gwi? Ma̱ yen kyatla̱l gwas a tu gaba̱s, yek ka̱n ma̱ tuli ta̱n ngusit atli.&gt;&gt; <verse eid="MAT 2:2" /><verse number="3" style="v" sid="MAT 2:3" />Hiridus guu kumi nu wugo, yek ili hwotti suk mas ma̱n Wurshelima i'e. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Yek Hiridus guu mo mas kiɗi ma̱n Pa̱ris suk ma̱n yisti mba̱t ga̱ɓa ga̱ Musa yek ta̱ ngemsi ɗe, &lt;&lt;Ɓohwe a'ako ka̱n ma̱n dla̱mti ga̱ɓa Nya wule sa zi Almasihu ko?&gt;&gt; <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Yek sa̱ ballit ɗe, &lt;&lt;Ka̱ ba̱n Baitalami ka̱ atl ga̱ Yehudiya,&gt;&gt; na̱k ɗe ma̱n dla̱mti ga̱ɓa ga̱ Nya lishi ɗe,<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />&lt;&lt; &lt;Ki ba̱n Baitalami ga̱ atl ga̱ Yehudiya,</para>
  <para style="q2" vid="MAT 2:6">ko njaa, kik ɗe nak'eni ka̱ ba̱n jwe ni ka̱ atl ga̱ Yehudiya wu so,</para>
  <para style="q1" vid="MAT 2:6">ten ɗe ka̱ ki ka̱n sa zi bal guu gon,</para>
  <para style="q2" vid="MAT 2:6">ma̱lgwe a da̱m ɗe bacina ga̱ mbala̱n ji ma̱n Yisiraila ata̱ pi kyo gwasa̱n wu.&gt; &gt;&gt;<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Yek Hiridus guu mbe mbala̱mi mukli, yek ta̱ kum ga̱z ga̱ sa'i gwe kyadla̱li yil wu. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Yek ta̱ wulsi ɗe, &lt;&lt;Lak ngo yenni i'e, kume ka̱ mbit wu, a ka̱a̱ lak hwini nini ammago ba lak ngusit atl pak.&gt;&gt;<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Ɗe sa̱ kum ga̱ɓa ga̱ guumi wu, yek sa̱ zigaa. Yek kyatla̱l gwe sa̱ yeni wu ngusi kopti na̱ si yek lak dla̱l sut gaa ga̱ lubii gwe yeni ni wu. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Sa̱ yen kyadla̱li wugo yek sa̱ pa̱l hwol tuk i'e. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Ɗe sa̱ te ka̱ lubiimi wugo, yek sa̱ yen yeni suk Maryam ana gwasi yek sa̱ ngus a cina ɗatka̱. Yek sa̱ ɓul ngura jwasa̱n yek sa̱ ba̱lti zinariya, suk luban, suk mur. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Ama yek yen shinti ga̱ Nya da̱lisi ka̱ng ka̱ tlunka̱t ɗe ba̱s koɓi tumal Hiridus so, yek sa̱ pal ga̱za̱n tu ten zobsi tantu.<verse eid="MAT 2:12" /></para>
  <para style="s">Apti te Masar ka</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Ma̱n yisti kyadla̱li zigaa wugo yek yen shinti ga̱ Nya ga̱ɓa suk Yusupu ka̱ tlunka̱ti yek ta̱ wulti ɗe, &lt;&lt;Tlinya ta̱k kan yeni suk ana gwasi ta̱k aɓa̱n te Masar ka, ta̱k da̱ma̱n teka se a hwikii ilgwe kaa pa̱li ka̱ kaali wu ten ɗe Hiridus a ngwe ta̱s tlo yeni.&gt;&gt; <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Yek Yusupu tlinya yek ta̱ kan yeni suk ane ka̱ gasi yek sa̱ ap te Masar ka, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />yek sa̱ da̱n a Masar hal se sa'i gwe Hiridus guu ma̱sh wu. Na̱k gwisi pi ta̱ njika̱n ga̱ɓa gwe Nya dla̱m tumal ma̱n dla̱mti ga̱ɓa gwas wu ɗe, &lt;&lt;Tet Masar ka̱n a mbe yen gini.&gt;&gt;<verse eid="MAT 2:15" /></para>
  <para style="s">Tlot mil maani ka̱ atl ga̱ Yehudiya</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Ɗe Hiridus guu lak yisi ɗe ma̱n yisti kyadla̱li palla̱t ɗe ka̱dla̱n wugo, yek mbadl gwas lil i'e, yek ta̱ laki ta̱s tlo mas mil maani ji ba̱n Baitalami suk jwe ni njaa ka̱li wu ka. Yek sa̱ tlo mas mil mani ma̱n gin ɗe lop suk ji atl ɗaasi ka ndakce na̱ sa'i gwe ma̱n yisti kyadla̱li hwit wu. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Gwisi ka̱ɗe sa'i gwe sa̱ njika̱n ga̱ɓa gwe Irimiya ma̱n dla̱mti ga̱ɓa ga̱ Nya dla̱m wu ɗe,<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />&lt;&lt;Sa̱ kum yal gon ka̱ ba̱n Rama,</para>
  <para style="q2" vid="MAT 2:18">Yal kulu na̱ du tuk i'e.</para>
  <para style="q1" vid="MAT 2:18">Rahila ka̱ na̱ma kulu ten bi mil jwasi</para>
  <para style="q2" vid="MAT 2:18">ta̱ nge sheltidli,</para>
  <para style="q1" vid="MAT 2:18">na̱k ɗe sa̱ tlwet mil ka̱wu.&gt;&gt;<verse eid="MAT 2:18" /></para>
  <para style="s">Zakti Masar</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Ama kaal ɗa̱ ma̱shka̱n ga̱ Hiridus guu, yek yen shinti ga̱ Nya tul mal Yusupu ka̱ tlunka̱ti a Masar. <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />Yek ta̱ wulti ɗe &lt;&lt;Tlinya ta̱k kan yeni suk ana gwasi ta̱k pala̱n teka̱ atl ga̱ Yisiraila ka, na̱k ɗe mbala̱n jwe sa̱ na̱ma la̱mti tlot ga̱ yeni go sa̱ ma̱sh wu.&gt;&gt;<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />Yek Yusupu kan yeni suk ane yek sa̱ pal teka̱ atl ga̱ Yisiraila ka. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Ama yek ta̱ kumi ɗe Alkilawus ka̱ da̱n ɗe guu ka̱ lal ga̱ aba gwas Hiridus a tik ɓal ɗe guu ga̱ atl Yehudiya wu, yek ɓanti la̱t ka̱li citi. Ama ɗe Nya da̱lit ka̱ng ka̱ tlunka̱t ɗe ba̱s li ka̱li tu ka̱li sowu, yek ta̱ li tu Galili. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />Yek ta̱ lak da̱n ka̱ ba̱n gwe asa̱ mbe ɗe Nazarat wu. Na̱ nu ka̱n ilgwe ma̱n dla̱mti ga̱ɓa ji Nya dla̱m wu da̱n ɗe gem, gwe wule, &lt;&lt;Sa mbet ɗe ma̱n Nazarat wu.&gt;&gt;<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Lakti icin ga̱ Yohana ma̱n baptisma</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Ka̱ multi jwisi wo yek Yohana ma̱n baptisma yil deɓa̱l yek ta̱ ngusi lakti icin ka̱ me ka̱ atl ga̱ Yehudiya, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />yek ta̱ wul mbala̱n ɗe, &lt;&lt;Cin atl gaa na̱k ɗe kanti ga̱ Nya ɗe guu ga̱na̱n ɓal njaa wu.&gt;&gt; <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Ma̱lga̱n go tik ɗe ma̱lgwe Ishaya ma̱n dla̱mti ga̱ɓa ga̱ Nya ga̱ɓa tenti wu, ɗe ta̱ wule,</para>
  <para style="q1" vid="MAT 3:3">&lt;&lt;Yal ga̱ ma̱lgwe na̱ma takti bi ka̱ me wu, gwe na̱ma wulti ɗe,</para>
  <para style="q1" vid="MAT 3:3">&lt;La̱ka̱mi Bagaa tantu gwe ta koɓi wu,</para>
  <para style="q2" vid="MAT 3:3">La̱ka̱miti tantu ta̱ni ɗe taki.&gt; &gt;&gt;<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />A Yohana lak luka̱l ma̱dla̱n rakumi ata̱ hap dlo gwas na̱ kul, ka̱ɓa suk duu ka̱ɗe ilga̱ nguki gwasi. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Yek mas ma̱n Wurshelima suk Yehudiya suk mas atl jwe ni njaa mal dla̱lka Yodan wu ngusi la̱t malti. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Yek sa̱ ngusi dla̱mti byas wul jwasa̱n ata̱ nisi ma pa̱lti baptisma ka̱ dla̱lka Yodan.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Yek Yohana yen ma̱n Paresi suk ma̱n Saduki wonti sa̱ na̱ma tulti malti ta̱s pa̱lisi baptisma wu, yek ta̱ wulsi ɗe. &lt;&lt;mil woka̱nzi na̱kkii, wok da̱likii ka̱ng ɗe ta̱k aɓi lilti mbadl ga̱ Nya ma̱n tulti wu wo?&gt;&gt; <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Pa̱la̱n wul jwe a mbok ang ten cit atl gaa gwaka̱n wu. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Ba̱k ɓo ngetl ɗe kii wo Iba̱rahim ka̱ɗe aba gwaka̱n so, Nya a mani palti mil Iba̱rahim na̱ ye jin. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Na̱k ninge mago ndal ni ten zhila tlindi, mas tlindi gwe wut hwa mil sogo sa wotl ka asa̱ lak ka̱ wutu. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />Ami wo na̱ ze ka̱n a nikii ma pa̱lti baptisma ta̱ mbok ang ɗe ka̱a̱ ci atl gaa mal Nya wi, ama kaal ɗa̱ ami wo ma̱lgon a tuli ma̱lgwe nal mana̱n wu, ma̱lgwe kapta̱lan gwas mago a mbuki ta tusit ka̱ sowu. Tik ka pa̱likii baptisma na̱ Shishi ga̱ Nya suk wutu. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Gal pelti wul gwas nit ang, ta taas lu pelti wul gwas ka, ata̱ pel ka̱pti ɗa̱ka̱ gwe wo ka, ata̱ wut gwesi ka̱ nhu gwasi, apaa ta̱ kwel ka̱pti ka na̱ wutu gwe ba̱ a mba̱shdli sowu.<verse eid="MAT 3:12" /></para>
  <para style="s">Sa̱ pa̱li baptisma Yesu</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Ka̱ sa'i gwisi wo yek Yesu yil tet Galili yek ta̱ li dla̱lka Yodan ta̱ Yohana pa̱lit baptisma. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Ama yek Yohana nda ngeti ɗe ta pa̱lit baptisma so, yek ta̱ wul Yesu ɗe, &lt;&lt;Amik ka li malki ta̱k pa̱li baptisma ama yek kik li tet ɗa?&gt;&gt; <verse eid="MAT 3:14" /><verse number="15" style="v" sid="MAT 3:15" />Yek Yesu wulti ɗe, &lt;&lt;Ningo zaki ta̱ na̱k gwisi pi ta̱n pa̱l mas ilgwe ni ndakce mal Nya wu.&gt;&gt; Yek paa Yohana ba̱l gaa gwasi yek ta̱ pa̱li Yesu baptisma.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Ɗe sa̱ pa̱li baptisma Yesu wu, ɗe ta̱ yil tot ɗa̱ka̱ ze ka̱ wugo yek dlo nya ɓuli, yek ta̱ yen Shishi ga̱ Nya na̱k kulu sut nya yek ta̱ sak dla̱l tenti. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Yek yal ga̱ɓa gon sut nya wuli ɗe, &lt;&lt;Ga̱n go yen gi ka̱n a lamti, a na̱ma kumti ta̱mti gwas i'e.&gt;&gt;<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Sheɗan cinga̱l Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Yek Shishi ga̱ Nya ta̱la Yesu ka̱ me ta̱ Sheɗan cinga̱lti. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Ta̱ pa̱l ka̱lka̱ze multi ɗe kutl ɗe wupsi na̱ ka̱ cin na̱ ka̱ gas wu, yek kuza̱n njel tlot gwasi i'e. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Yek Sheɗan ma̱n cinga̱ltisi li tet malti yek ta̱ wulti ɗe, &lt;&lt;Kume ki wo yen ga̱ Nya ka̱ɗe ki wu, hwi ye jin ɗe ta̱s pal ɗe ilga̱ nguki.&gt;&gt;<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Yek Yesu wulti ɗe, &lt;&lt;Ni ga̱ lishi ka̱ ga̱ɓa ga̱ Nya ɗe, &lt;Ilga̱ nguki tokte ka̱ɗe ma̱n keta̱lti ga̱ mbala̱n so, ama mas ga̱ɓa gwe a yil sut mal Nya wu.&gt; &gt;&gt;<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Yek Sheɗan ta̱lat Wurshelima ba̱n gwe Nya botli wu, Yek ta̱ tolti to ten gaa lubii ga̱ Nya ka, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />Yek ta̱ wulti ɗe, &lt;&lt;Kume yen ga̱ Nya ka̱ɗe ki go ɗakci su ka, na̱k ɗe ni ga̱ lishi ɗe,</para>
  <para style="q1" vid="MAT 4:6">&lt;&lt; &lt;Nya a hwi mil shinti jwas ga̱ɓa tenki</para>
  <para style="q2" vid="MAT 4:6">asa̱ ngibki ka na̱ ang gwasa̱n,</para>
  <para style="q1" vid="MAT 4:6">kangwe ka ɓo asa̱n ten ye sowu.&gt; &gt;&gt;<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Yek Yesu wulti ɗe, &lt;&lt;Ni ga̱ lishi pak ɗe, &lt;Ba̱k cinga̱l Nya Bagaa gwa so.&gt; &gt;&gt;<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Yek Sheɗan po ta̱lat ten tlal tla̱nda̱l gon, yek ta̱ mbokit ang ten guu ji dii atli suk mbunti jwasa̱n. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Yek ta̱ wulti ɗe, &lt;&lt;Ba ba̱lki mas wul jimi, ɗe kume ka̱ ngus atli yek ka̱ ba̱la̱n nalti wu.&gt;&gt;<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Yek Yesu wulti ɗe, &lt;&lt;Tli ɗa̱ mala̱n ka Sheɗan, ni ga̱ lishi ka̱ ga̱ɓa ga̱ Nya ɗe, &lt;Ngusi atl Nya Bagaa gwa, a ti na̱ ngus ka̱n ka kumit bi.&gt; &gt;&gt;<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Yek Sheɗan zakti, yek mil Shinti ji Nya tuli yek sa̱ nda̱llit gahwula̱n.<verse eid="MAT 4:11" /></para>
  <para style="s">Yesu nda pa̱lti wul gwas a Galili</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Yesu kumi ɗe sa̱ le Yohana ka̱wu yek ta̱ zak luisi yek ta̱ li ka̱ ka̱t atl ga̱ Galili. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Yek ta̱ zak Nazarat yek ta̱ li Kaparnahum ba̱n gwe ni njaa ten bi bal dla̱lka Galili ka̱ ka̱t atl ga̱ Zabalun suk Naptali wu. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Na̱k gwisi pi ten ɗe ta̱ ilgwe Ishaya ma̱n dla̱mti ga̱ɓa ga̱ Nya dla̱m wu njika̱n ga̱ɓa gwe wuli ɗe,<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />&lt;&lt;Ka̱t atl ga̱ Zabalun suk ga̱ Naptali gwe ni ka̱ Galili,</para>
  <para style="q2" vid="MAT 4:15">Lu ga̱ ma̱jwe ba̱ ma̱n Yehuda ka̱ sowu,</para>
  <para style="q2" vid="MAT 4:15">lu gwe lak gaa tu bal ze hal yek ɗakci dla̱lka Yodan wu<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Ma̱jwe sa̱ na̱ma da̱mti ka̱ da̱mshal wu</para>
  <para style="q2" vid="MAT 4:16">sa̱ yen bal cilti wi.</para>
  <para style="q1" vid="MAT 4:16">Mbala̱n jwe sa̱ na̱ma da̱mti ka̱ da̱n-da̱n ma̱shka̱n go</para>
  <para style="q2" vid="MAT 4:16">Cilti a yilisi tot wi.&gt;&gt;<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Ka̱ sa'i gwisi ka̱n Yesu nde dla̱mti ga̱ɓa mbala̱n ɗe, &lt;&lt;Cin atl gaa, na̱k ɗe kanti Nya ɗe guu ga̱na̱n njaa wu.&gt;&gt;<verse eid="MAT 4:17" /></para>
  <para style="s">Yesu mbe ma̱n dipti ze ɗe wupsi</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Ta̱ na̱ma la̱t ten bi bal dla̱lka Galili nu go, yek ta̱ yen Siman gwe asa̱ mbet ɗe Biturus wu suk yilka gwasi Andarawus asa̱ na̱ma dipti ze na̱ wul dopti kwes gwasa̱n. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Yek Yesu wulsi ɗe, &lt;&lt;Koɓa̱nni nini ba palla̱ki ɗe ma̱n ngot mbala̱n na̱k gwe aka̱ dop kwes wu.&gt;&gt; <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Nige-nige yek sa̱ lak wul dopti kwes gwasa̱n ka yek sa̱ kopti.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Sa̱ na̱ma la̱t nugo yek Yesu yen Yakubu suk Yohana yilka gwasi. Si wo mil ji Zabadi ka̱n, Yesu mbisi asa̱ na̱ma la̱ka̱nti wul dopti kwesi suk aba gwasa̱n ka̱ jirgi ze. Yek ta̱ mbesi, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />yek nige-nige yek sa̱ zak jirgi suk aba gwasa̱n yek sa̱ kopti.<verse eid="MAT 4:22" /></para>
  <para style="s">Yesu zi ang wonti mbala̱n</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Yek Yesu matl ka̱ mas ka̱t atl Galili ata̱ nima mbokti ang mbala̱n ten ga̱ɓa ga̱ Nya ka̱ lu motgaa gwasa̱n ata̱ nisi ma̱ dla̱mti ga̱ɓa ma̱n ta̱mti ten bi kanti Nya ɗe guu gwasa̱n. Yek ta̱ pita ndokti mas cwo suk la̱shi kumti ta̱mti ga̱ dli ji mbala̱n. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Yek bi gwas ma̱tl ka̱ mas atl ga̱ Siriya, yek ma̱n ba̱mi ngusi tulla̱t ji mbala̱n jwasa̱n jwe dli ta̱misi bi sowu. Na̱ ma̱jwe sa̱ citi ka̱ na̱ cwo wonti wu, suk ma̱jwe na̱ma kumti dli suk ma̱jwe yeta̱l ni ka̱si ju, suk ma̱n maparpaɗa suk ma̱jwe dli jwasa̱n tla ka̱wu, yek ta̱ ndoksi mas jwasa̱n. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Yek mbala̱n wonti, ma̱n Galili, suk ma̱n Dikapolis, suk ma̱n Wurshelima, suk ma̱n Yehudiya hal suk ma̱jwe ni tu ten ka̱ti gon ga̱ dla̱lka Yodani wu kop kaal ga̱ Yesu.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Mbok ang ten wul ga̱ Yesu ten tla̱nda̱l</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Yesu yeni ɗe mbala̱n wonti mogaa wu, yek ta̱ to ten tla̱nda̱l ilgon gwasi. Ta̱ da̱n na̱ zhila wu, yek mil lishti jwas li tet malti. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Yek ta̱ njelisi mbokti ang ten wul ɗe,<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />&lt;&lt;Ma̱n albarka ka̱ɗe ma̱jwe yis la̱shi nda̱lti gwasa̱n ten bi wul ji Nya wu,</para>
  <para style="q2" vid="MAT 5:3">ten ɗe guu ga̱ Nya wo gwasa̱n ka̱n.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Ma̱n albarka ka̱ɗe ma̱jwe asa̱ pa̱l duu tuk wu,</para>
  <para style="q2" vid="MAT 5:4">ten ɗe sa wutisi bi tang ten mbadl wu.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Ma̱n albarka ka̱ɗe ma̱jwe ba̱sa palli gaa gwasa̱n ɗe ilgon sowu</para>
  <para style="q2" vid="MAT 5:5">ten ɗe sa mbi wul ji dii atli.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Ma̱n albarka ka̱ɗe ma̱jwe sa̱ na̱ma kuza̱n suk ka̱lka̱ze ɗe ta̱s pa̱l ilgwe ni ndakce wu,</para>
  <para style="q2" vid="MAT 5:6">ten ɗe tuk gwasa̱n a njika̱n.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Ma̱n albarka ka̱ɗe ma̱jwe asa̱ yen gonti wu</para>
  <para style="q2" vid="MAT 5:7">ten ɗe si mago sa yen gonti gwasa̱n wu.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Ma̱n albarka ka̱ɗe ma̱jwe mbadl jwasa̱n ni mbuni wu</para>
  <para style="q2" vid="MAT 5:8">ten ɗe sa yen Nya.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Ma̱n albarka ka̱ɗe ma̱jwe asa̱ la̱ka̱n dlo ga̱ mbala̱n wu</para>
  <para style="q2" vid="MAT 5:9">ten ɗe sa mbesi ɗe mil ji Nya.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Ma̱n albarka ka̱ɗe ma̱jwe sa̱ na̱ma tlat bomti ten pa̱lti wul ndakce wu</para>
  <para style="q2" vid="MAT 5:10">ten ɗe boo ga̱ Nya wo gwasa̱n ka̱n.<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />&lt;&lt;Kii wo ma̱n albarka ka̱n ka̱ sa'i gwe mbala̱n byalkii yek sa̱ lakkii ka̱ bomti yek sa̱ shelikii lal gaa ga̱ pa̱lti mas byas wul ten bi gi wu. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Ta̱ mbadl gwaka̱n ta̱mi aka̱a̱ pa̱l hwol tuki i'e na̱k ɗe Nya a ɓatlkii nal ka̱ boo gwas wu, nu ka̱n sa̱ lak ma̱n dla̱mti ga̱ɓa ga̱ Nya jwe tulikii cina ju ka̱ bomti.<verse eid="MAT 5:12" /></para>
  <para style="s">Mbokti ang ten kwi suk cilti</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />&lt;&lt;Kii wo kik ɗe kwi ga̱ dii atli, kume kwi po ta̱m sogo, ɗa̱ nii ka̱n sa palli ta̱mti gwi? Ma̱lgon a po pa̱l ilgon na̱ nali so, ama sa wut ka a mbala̱n li na̱ asa̱n a dani.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />&lt;&lt;Kik ɗe cilti ga̱ dii atli. Ai ba̱n gwe ni ten za̱nda̱l go sa mana̱n hwunda̱lti ka̱ so. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Mbala̱n laka̱n wutu ka̱ pitila asa̱ yitle ka na̱ gal so, ama asa̱ sa̱ zi ten lu za̱ti. Kangwe a cili, a mbala̱n yen lu ka̱ lubiimi wu. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Na̱k gwisi ka̱n ha̱n ta̱ cilti gwaka̱n ngusi cilti, ta̱ mbala̱n yen hwa pa̱t gwaka̱n asa̱ ta̱s shin ga̱ Aba gwaka̱n gwe ta̱ ni to nya ka̱wu.<verse eid="MAT 5:16" /></para>
  <para style="s">Ga̱ɓa ga̱ Yesu ten mba̱t ga̱ɓa ga̱ Musa</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />&lt;&lt;Ba̱k da̱ma̱n gwa we a tuli, ta tlok Mba̱t Ga̱ɓa ga̱ Musa suk Lishti ji ma̱n Dla̱mti Ga̱ɓa ga̱ Nya ka̱ so, a tul ɗe ta tlok ka̱ so a ma a tul ɗe ta njika̱mi ka. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Gem ka̱n dlo nya suk dii atl a taas ka, ama ko ta̱ ilgwe ni ɗe nak'eni ka̱ Mba̱t Ga̱ɓa ga̱ Musa, mago a tlokdli ka̱ so se njika̱n mas. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Ten na̱k gwisi ka̱n mas ma̱lgwe nge kopti mba̱ti gon a giɓi, ko ta̱ mba̱ti gwisi ka̱ni ɗe gwe nda nak'eni mani wu, yek ta̱ mboki ang mbala̱n ɗe ta̱s pa̱li nugo, sa mbet ɗe ma̱lgwe ni nak'eni ka̱ guu ga̱ Nya. A mas ma̱lgwe kop mba̱t ga̱ɓe yek ta̱ mboki ang mbala̱n dani go sa mbet ɗe kakshe a guu ga̱ Nya. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />A nikii ma hwiti, kume pa̱lti wul ndakce gwaka̱n man ga̱ ma̱n Paresi suk ma̱n mbokti ang mbala̱n ten Mba̱t Ga̱ɓa ga̱ Musa wu sowu, kaa te ka̱ guu ga̱ Nya so.<verse eid="MAT 5:20" /></para>
  <para style="s">Mbotik ang ga̱ Yesu ten lilti mbadli</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />&lt;&lt;Ka̱a̱ kumi ɗe tet go sa̱ dla̱mi mbala̱n jina̱n ɗe &lt;ba̱k tlo mbala̱n so, ma̱jwe tlo mbala̱n go sa nolti.&gt; <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Ama ami wo a nikii ma hwiti ɗe mas ma̱lgwe mbadl lilit na̱ yilka gwas go sa nolti. A ma̱lgwe hwi yilka ɗe, &lt;Ki wo mbala̱n ga̱ koo lu,&gt; sa nolti, a ma̱lgwe wul yilka gwas ɗe, &lt;Ki wo ka̱dla̱n ka̱ɗe ki wu!&gt; Mbun ɗe ta̱ lakti buu wutu.<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />&lt;&lt;Na̱ nu ka̱n kume ka̱ ɓa ba̱l wul ka̱ lu takti wul, yek ka̱ daami go ma̱lgon na̱ma lilti mbadl na̱ ki wu, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />lak la̱ka̱n dlo gwa suk ma̱li pa apaa ka̱ nda takti wuli.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />&lt;&lt;La̱ka̱n dlo gwa suk ma̱lgwe ta̱lak dlaboo wu ba̱le-ba̱le a ka̱yi ten tantu la̱t ka̱ lu kisti ga̱ɓe. La̱ka̱n dlo gwa sukti, ka̱ pa̱li nu sowu ta lakki ka̱ ang ga̱ ma̱n kisti ga̱ɓa, a ma̱n kisti ga̱ɓe lakki ka̱ ang ga̱ ma̱n hapti dlo asa̱ lek ka ka̱ lu gwe asa̱ le ma̱n pa̱lti byas wullu. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />A nikma hwiti ɗe gem kaman yilti ka̱ so, se ka̱ ɓatl mas ilgwe ma̱n kisti ga̱ɓa tlwek ɗe ta̱k ɓatl wu.<verse eid="MAT 5:26" /></para>
  <para style="s">Mbokti ang ɗe ba̱k pi suk kili ga̱ ma̱lgon so</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />&lt;&lt;Ka̱a̱ kume ɗe tek go sa̱ dla̱m ɗe &lt;ba̱k pa̱n pa̱la̱n so.&gt; <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Ama ami wo a nikii ma hwiti ɗe mas ma̱lgwe yen kili mbala̱n yek ta̱ lam multi sukti go ma̱li pi pa̱la̱n sukti ka̱ mbadl gwas wi. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Kume gwel gwa ka̱ti ga̱ ang shinti ka̱ɗe ma̱n lakti gwa ten pa̱lti byas wullu, yilli ka aka̱ lakka. A mani ki ta̱ ka̱t dli gon gwa ka̱ ni ɗa̱ so ɗa̱ gwe ta̱s lak mas dli gwa ka̱ buu wutu wu. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />A kume a ang shinti gwa ka̱ɗe ma̱n lakti aka̱ pa̱l byas wullu, kotl ka ta̱k lakka. A maniki ta̱ ka̱t dli gon gwa ka̱ ni ɗa̱ so ɗa̱ gwe ta̱s lak mas dli gwa ka̱ buu wutu wu.<verse eid="MAT 5:30" /></para>
  <para style="s">Mbokti ang ten zakti kili punka</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />&lt;&lt;Tek go sa̱ wulsi ɗe, &lt;Mas ma̱lgwe lam zakti ga̱ kili gwas go ta̱s ba̱lti lishti zakti.&gt; <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Ama a nikii ma hwiti ɗe mas ma̱lgwe zak kili gwasi aba ten pa̱t pa̱la̱n ka̱n ta̱ mbit sogo ta̱ lakti ten pa̱t pala̱n wi. A ma̱lgwe hap kili gwe sa̱ zakti go, ta̱ na̱ma pa̱t pa̱la̱n sukti.<verse eid="MAT 5:32" /></para>
  <para style="s">Mbokti ang ga̱ Yesu ten bi mot ga̱ɓa suk Nya</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />&lt;&lt;Ka̱a̱ po kume ɗa̱ɗe tek go sa̱ hwi mbala̱n ɗe, &lt;Ba̱s mo ga̱ɓa suk Nya ten lal so, ama ta̱s pa̱l ilgwe sa̱ mo ga̱ɓa na̱ Nya dani.&gt; <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Ama ami wo a nikii ma hwiti ɗe, ba̱k mo ga̱ɓa suk Nya so. Ba̱k mo ga̱ɓa na̱ dlo nya so na̱k ɗe yek ɗe lu da̱nti ga̱ Guu Nya wu. <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />A ba̱k mwe na̱ dii atl so, na̱k ɗe yek ɗe lu za̱t asa̱n gwas wu, ba̱k mwe na̱ Wurshelima so pak, ai yek ɗe ba̱n ga̱ Bal Guu. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Ba̱k mo ga̱ɓa na̱ gaa gwa so, na̱k ɗe ka man palla̱t ga̱ ma̱dla̱n ɗe na̱m ga̱ gaa gwa hwoli sogo duuni dani sowu. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Ka̱ mas ilgwe kaa dla̱m wu ta̱ ga̱ɓa gwaka̱n dla̱l ten &lt;Yii&gt; sogo &lt;Wowo.&gt; Kume ɗakci nu wu, tet mal Ma̱n Ngalci wu ka̱n yil teɗi.<verse eid="MAT 5:37" /></para>
  <para style="s">Mbokti ang ga̱ Yesu ten palla̱t ami</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />&lt;&lt;Ka̱a̱ kumi ɗe tek go sa̱ dla̱m ɗe &lt;Gwel ka̱ lal ga̱ gwel, shin ka̱ lal ga̱ shin.&gt; <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Ama ami wo a nikii ma hwiti ɗe, ba̱k nge ɗe ta̱ mbala̱n tekii ga̱zi so. Kume ma̱lgon ɓek kalka̱ng ten ka̱t ang shinti go, ballit ka̱ti ga̱ ang yali wu pak. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Kume ma̱lgon ta̱lak dlaboo ten bi kuka̱l gwa ga̱ tugiɓi go, ba̱lti luka̱l ga̱ tukaali pak. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Kume ma̱lgon zik ngetli ta̱k li sukti dlenta̱t ga̱ mil ɗe na̱m wu, li sukti hal mil ɗe lop. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Mas ma̱lgwe ngemik wul go patti ɗa̱ so, a ma̱lgwe ngemik dul go ba̱lti.<verse eid="MAT 5:42" /></para>
  <para style="s">Lam ma̱n nget gwa</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />&lt;&lt;Ka̱a̱ kumi tek go sa̱ dla̱m ɗe, &lt;Lam yilka gwa, aka̱ nge ma̱n nget gwa.&gt; <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Ama ami wo a nikii ma hwiti ɗe ta̱k lama̱n ma̱jwe ngekii wu, ngemi Nya ma̱jwe nikii ma cit dlelngapcan wu. <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />Kume ka̱ pa̱li na̱k gwisi go kaa da̱m ɗe mil ji Aba gwaka̱n gwe ni to nya ka̱wu, ti ɗe ata̱ laki a cin yili hwa mbala̱n suk byasi, ata̱ laki a ze nde ma̱n pa̱lti wul ndakce suk ma̱n pa̱lti byasi. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Kume ma̱jwe sa̱ lamkii wu ka̱n aka̱a̱ lamsi na̱ ngusa̱n go, ɗa̱ni ka̱n sa ɓatlkii gwi? Ai ko ta̱ ma̱n kanti wulpi boo mago na̱k gwe aka̱a̱ pa̱li wu ka̱n asa̱ pa̱li. <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />A kume yilkeni jwaka̱n ka̱n aka̱a̱ ga̱ɓesi na̱ ngusa̱n go, na̱ yek ka̱a̱ man naa mbala̱n ye? Ai mbala̱n jwe ɗe ma̱n Yehuda ka̱ sowu mago nu ka̱n asa̱ pa̱li. <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Nuk go da̱ma̱n ga̱ njikmi na̱k kangwe ga̱ Aba gwaka̱n gwe ni nya wu njika̱n wu.&gt;&gt;<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Mbokti ang ga̱ Yesu ten ba̱lti wul</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />&lt;&lt;Pa̱n ɗem-ɗem ba̱k pa̱la̱n hwa wul ten ɗe ta̱ mbala̱n yeni asa̱ ta̱skii so. Kume ka̱a̱ pa̱li nu go, kaa mbi ɓatlti mal Aba gwaka̱n gwe ni nya wu so.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />&lt;&lt;Kume ka̱a̱ ɓa ba̱l wul ma̱n la̱shi wul wu, ba̱k pa̱nta ga̱ɓa dani na̱k gwe a ma̱n riya pa̱li ka̱ lu motgaa gwasa̱n suk ɗa̱n ten tantu ka̱ ten ɗe ta̱ mbala̱n ta̱ssi wu so. Gem, amik ka hwikii ge sa̱ mbi ɓatlti gwasa̱n wi. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Ama kume ka̱a̱ ɓa ba̱l wul ma̱n la̱shi wul wu, ba̱k zaki ni a ang yali gwaka̱n yis ilgwe ang shinti na̱ma pa̱lti wu so. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Kangwe ba̱lti wul gwaka̱n a ni ga̱ hwunda̱li wu, a Aba gwaka̱n ɗe ata̱ yen wul gwe a mbala̱n pa̱li ga̱ hwunda̱li wu ɓatlkii.<verse eid="MAT 6:4" /></para>
  <para style="s">Mbokti ang ga̱ Yesu ten ngemti Nya</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />&lt;&lt;Kume ka̱a̱ ɓa ngem Nya go, ba̱k pa̱li na̱k ma̱n pa̱lti riya so, na̱k ɗe si wo asa̱ laam ngemti Nya a nya ɗa̱nka̱ lu motgaa gwasa̱n ka suk ɗa̱n ten tantu ka kangwe mbala̱n a yensi dani wu. Gem, amik ka hwikii ge sa̱ mbi ɓatlti gwasa̱n. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Ama kume ka̱a̱ ɓa ngem Nya go te punka, aka̱a̱ le dlabii ka aka̱a̱ ngem Aba gwaka̱n gwe ba̱ mbala̱n a yenti dani sowu. Ti ɗe ata̱ yen mas ilgwe ni ga̱ hwunda̱li ka̱wu ta ɓatlkii. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />Kume ka̱a̱ ɓa ngem Nya go, ba̱k pa̱nta ka̱pti ga̱ɓa ten wul ɗe na̱m na̱k ma̱jwe asa̱ pa̱l wul na̱k wule si wo hwa mbala̱n ka̱ɗe si wu so. Sa̱ da̱ma̱n gwa we ten ka̱pti ga̱ɓa gwasa̱n ka̱n ta katisi ka̱ng. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Ba̱k pa̱li na̱k gwasa̱n wu so na̱k ɗe Aba gwaka̱n yis ilgwe ka̱a̱ lami tun a ba̱ka̱a̱ ɓo ngemti sowu.<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />&lt;&lt;Nuk'wu, kume ka̱ ɓa ngem Nya go aka̱a̱ wuli ɗe,</para>
  <para style="q1" vid="MAT 6:9">&lt;&lt; &lt;Aba ga̱na̱n gwe ni to nya ka̱wu,</para>
  <para style="q1" vid="MAT 6:9">ha̱n ta̱ mbala̱n ɓanti shin gwa<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Ha̱n ta̱ da̱mti gwa ɗe guu tuli.</para>
  <para style="q1" vid="MAT 6:10">Ha̱n ta̱ ilgwe ka̱ lami wu pi</para>
  <para style="q2" vid="MAT 6:10">ten dii atli na̱k gwe a pi to nya ka̱wu.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Ba̱lni ilgwe ma guk ase wu.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />Taasini mas byas wul jina̱n ka</para>
  <para style="q2" vid="MAT 6:12">na̱k gwe ama̱ taasi ma̱jwe asa̱ pa̱lini byas wul wu.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Ba̱k zakni ta̱n nda so ɗe kume sa̱ ɓa cinga̱lni wu.</para>
  <para style="q1" vid="MAT 6:13">Ama aka̱a̱ te ka̱ dlo ga̱na̱n suk Ma̱n Ngalci wu.&gt;<verse eid="MAT 6:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14" />Kume ka̱a̱ taasi byas wul ma̱jwe pa̱likii byas wul wu, Aba gwaka̱n gwe ni to nya ka̱wu mago ta taasikii gwaka̱n ka. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Ama kume ka̱a̱ taasi byas wul ma̱jwe sa̱ pa̱likii byas wul wu ka̱ sogo, Aba gwaka̱n mago ta taasikii gwaka̱n wu ka̱ so.<verse eid="MAT 6:15" /></para>
  <para style="s">Mbokti ang ga̱ Yesu ten ka̱lka̱ze</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />&lt;&lt;A kume ka̱ ɓa pa̱l ka̱lka̱ze wu, ba̱k docina̱n cina gwel na̱k ma̱n pa̱lti riya so, na̱k ɗe si wo asa̱ docin cina gwel ta̱ mbala̱n yeni asa̱ yisi ɗe sa̱ na̱ma ka̱lka̱ze wu. Gem, amik ka hwikii ge sa̱ mbi ɓatlti gwasa̱n wi. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Ama kume ka̱a̱ pa̱l ka̱lka̱ze go aka̱ pola̱n gwel gwaka̱n ka aka̱a̱ tuksi mili ten gaa, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />ba̱ mbala̱n yenkii asa̱ yisi ɗe ka̱a̱ na̱ma pa̱lti ka̱lka̱ze so, ama Aba gwaka̱n ɗe ata̱ yen mas ilgwe ni ga̱ hwunda̱li ka̱wu a ɓatlkii.<verse eid="MAT 6:18" /></para>
  <para style="s">Mbokti ang ten bi mot wul to nya ka</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />&lt;&lt;Ba̱k mwe wul gaa gwaka̱n ten dii atl so, lu gwe a da̱kmbi lili ka, a kaci ka̱ wu. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Mwe wul gwaka̱n to nya ka, ka̱ lu gwe da̱kmbi a lili ka̱ so, a ba̱ a kaci ka̱ so wu. Muka̱l mago sa man teti asa̱ muka̱li ka̱ so. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Ten ɗe ka̱ lu gwe wul gwaka̱n ni wu, ka̱li ka̱n mbadl gwaka̱n ni pak.<verse eid="MAT 6:21" /></para>
  <para style="s">Cilti ga̱ dli</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />&lt;&lt;Gwel ka̱ɗe cilti ga̱ dli. Kume gwel gwa ni hwaɓi wu, dli gwa a ni cili. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Ama ɗe kume cilti ga̱ dli gwa wo da̱mshal ka̱ go, gem da̱mshal gwe ka̱ ni giɓi go bali ka̱n.<verse eid="MAT 6:23" /></para>
  <para style="s">Da̱mti ɗe zhel ga̱ Nya suk da̱mti ɗe zhel ga̱ wulpi</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />&lt;&lt;Mbala̱n a man da̱n ɗe zhel ga̱ bagaa ɗe lop ka̱ sa'i ɗe na̱m so. Ngetli ka̱n ta̱s lam gon ata̱ nge gon, sogo ta̱s kumi bi gon ata̱ nge kumti bi gon. Mbala̱n a man da̱mti ɗe zhel ga̱ Nya suk lamti wulpi so.<verse eid="MAT 6:24" /></para>
  <para style="s">Ba̱ ilgon hwotkii so</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />&lt;&lt;Ten na̱k gwisi ka̱n, a nikii ma hwiti ɗe ba̱k hwota̱n gaa gwaka̱n ka̱ da̱mti gwaka̱n so, ten bi ilgwe kaa nguk wu, suk ilgwe kaa tla wu sogo luka̱l gwe kaa lak wu. Ase mbadl ga̱ mbala̱n mana̱n ilga̱ nguki sa? Aba̱ dli ga̱ mbala̱n mana̱n luka̱l ga̱ laki sa? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Ɓo yena̱n yadl la, ba̱sa ɓak zhin so, ba̱sa wotl wul zhin so, a ba̱sa moo wul ka̱ nhu so. Ama Aba gwe ni nya wu na̱ma citi na̱ si. Ka̱a̱ yisi ɗe ka̱a̱ nal man yadl mal Nya sa? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Wok ni ka̱ kii gwe ɗe wul hwotti wugo ta mani mba̱lti gaa gwas ko ta̱ sa'i ɗe na̱m dani wo?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />&lt;&lt;Yek laki yek luka̱l gwe kaa lak wu a hwotkii ye? Ɓo yena̱n buzha ɗe asa̱ kiɗi ka̱ me wu la, kangwe ba̱sa pa̱l ilgon so, a ba̱sa pi luka̱l so wu. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Mas na̱ na̱k gwisi, ko ta̱ Sulemanu guu na̱ mas nalti gwas mago, ta̱ kin mbuni luka̱l yek ta̱ kinti ka na̱k ɗe na̱m ka̱ buzha jin so. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Ɗe hal Nya kin buzha ka̱ me ka na̱ mbunti wu, si ɗe sa̱ ni ɗa ase, ama ayo asa̱ kweli ka ka̱ wutu wugo, se kii ka̱n ba̱ Nya a pa̱likii sa? Kii mbala̱n jwe ba̱sa̱ nga̱sti ten Nya sowu! <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Na̱ nu ka̱n ba̱k hwota̱n gaa gwaka̱n aka̱a̱ na̱ma wulti ɗe, &lt;Yek ma nguka̱n ye?&gt; Sogo &lt;Yek ma tla ye?&gt; Sogo &lt;Yek ma laka̱n ye?&gt; <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Ma̱jwe sa̱ yis Nya sogo sik ɗe ma̱n ngot wunda̱l ji wul jimi, ama kii wo Aba gwaka̱n gwe ni to nya ka̱wu yisi ɗe ka̱a̱ lam wul jwisi mas. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Ama ngo guu ga̱ Nya suk pa̱lti wul ndakce gwasi, apaa ta̱ mba̱likii mas naa wul jwisi. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Ten na̱k gwisi ka̱n, ba̱k hwota̱n gaa gwaka̱n na̱ wul jwe a pi ayo wu so, ayo a tul na̱ wul jwasi. Hwotti ga̱ ase kumkii wi.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Ba̱k zi du gaa yilkeni jwaka̱n so</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />&lt;&lt;Ba̱k zi du gaa ma̱lgon so, kii mago ma̱lgon a zikii so. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Ten ɗe na̱ wunda̱l kisti ga̱ɓa gwe ka̱ pa̱li mbala̱n go, wunda̱lisi ka̱n sa pa̱liki. Gal cinga̱lti wul gwe ka̱ cinga̱li mbala̱n ɗa̱ go na̱ nali ka̱n sa cinga̱liki.<verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />&lt;&lt;Yek laki ɗe ka̱ na̱ma za̱t gwel ten nak'en ilgon ɗe ni yilka gwa gwel wu, ama yek ba̱ bali gwe ni ka̱ gwa wu hwotki so ye? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Ɗa̱ nii ka̱n ka wul yilka gwa ɗe, &lt;Ha̱n ta yillik nak'en ilga̱n ɗe nik ka̱ gwel wu ka,&gt; Ama a ki wo bali ka̱ ni ka̱ gweli gwa wu gwi? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Ki ma̱n riya, yilli bal ilgwe nikka̱ gwel wu ka, ta̱k man yenti lu i'e ɗa apaa ka̱ man yilla̱t nak'en ilgon gwe ni ka̱ gwel ga̱ yilka gwa wu ka.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />&lt;&lt;Ba̱k ba̱la̱n kaɗi wul gwe sa̱ botli ka̱wu so. A ba̱k ba̱la̱n zok mbuni ye Alade so. Ten ɗe sa li na̱ asa̱n dani, asa̱ palikii gaa asa̱ kumikii cwo.<verse eid="MAT 7:6" /></para>
  <para style="s">Ngweni, ngemini, kotla̱n bi dlabiimi</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />&lt;&lt;Pa̱nta ngemti sa ba̱lkii, ngweni kaa mbi, kotla̱n bi dlabii sa ɓulikii. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Mas ma̱lgwe ngemi go sa ba̱lti, a ma̱lgwe ngwe go ta mbi. Ma̱lgwe ngusi kotlti bi dlabii go sa ɓuliti.<verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />&lt;&lt;Ka̱ kii wo wok ɗe gwe ɗe yen gwas a ngemit ba̱redi ata̱ ba̱lti ye wo? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Sogo ta̱s ngemit kwesi ata̱ ba̱lti wuci wo? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Kii ɗe ma̱n ngalci wu mago yek ka̱a̱ yis kangwe kaa ba̱l hwa wul mil jwaka̱n wu, Aba gwaka̱n gwe ɗe ta̱ ni to nya ka̱wu pa? Ai ta ba̱la̱n hwa wul ma̱jwe sa̱ ngemit wu. <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />Ilgwe ka̱a̱ lami ɗe ta̱ mbala̱n pa̱likii wu, kii mago pa̱lisi nu pak. Nu ka̱n Mba̱t Ga̱ɓa ga̱ Musa suk taka̱rda ji ma̱n dla̱mti ga̱ɓa ga̱ Nya mbok ang.<verse eid="MAT 7:12" /></para>
  <para style="s">Mbok ang ten kopti ngaptlan tantu</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />&lt;&lt;Koɓi tu ka̱ ngaɓi tantu na̱k ɗe tantu gwe a ta̱la mbala̱n ka̱ buu wutu go alti ka̱n ni wu. Kopti tantu gwisi wo bom so, a ma̱jwe asa̱ koɓi go wonti ka̱n sa̱ni. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Tantu gwe a mbala̱n koɓi asa̱ mbi mbadl go ngaptlan ka̱n ni, a kopti gwas bomi. Mbala̱n jwe asa̱ koɓi tu ka̱li go sa̱ wonti so.<verse eid="MAT 7:14" /></para>
  <para style="s">Tumal yandi ga̱ tlindi ka̱n asa̱ yis tlindi wul</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />&lt;&lt;Pa̱n ɗem-ɗem na̱ ma̱n dla̱mti ga̱ɓa ga̱ Nya ga̱ la̱li, ma̱jwe asa̱ tul malkii na̱k wule mba̱la ka̱n ama kaɗila̱p jwe kuza̱n na̱ma tlot gwasa̱n i'e ka̱ɗe si wu. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Tumal pa̱t jwasa̱n ka̱n kaa yissi. Kaa man kotlti yandi inabi ten tlindi zhina a? Ko a ma̱n kotlti yandi tula̱n ten tlindi wuɓa̱l la? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />A na̱k gwisi ka̱n mas hwa tlindi wo ata̱ wut hwa yandi, a byasi wo ata̱ wut byas yandi. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Hwa tlindi wo ba̱ a wut byas yandi so, a ba̱ a byas tlindi a wut hwa yandi so. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Kume nuk go, mas tlindi gwe wut hwa yandi sogo asa̱ wotl ka asa̱ wut ka̱ wutu. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Ten na̱k gwisi ka̱n kaa yis ma̱n dla̱mti ga̱ ɓa ga̱ Nya ji lali tu ten pa̱t jwasa̱n.<verse eid="MAT 7:20" /></para>
  <para style="s">A yiskii so</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />&lt;&lt;Mas ma̱jwe asa̱ mbe ɗe Bagaa wu kaa te ka̱ guu ga̱ Nya so, ama se ma̱jwe asa̱ pa̱l ilgwe Aba gi gwe ni wu nya lami wu. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Ten cin gwisi wo, mbala̱n wonti a wula̱n ɗe, &lt;Bagaa, Bagaa! Ale ma̱ laki mbala̱n icin ten ga̱ɓa ga̱ Nya na̱ shin gwa na̱? Ale ma̱ yilla̱n ma̱zhe ɗa̱ka̱ mbala̱n ka na̱ shin gwa na̱? A ma̱ pa̱l wul cit ɓanti wonti na̱ shin gwa.&gt; <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Apaa a wulsi ɗe, &lt;A yiskii so, tli ɗa̱ mala̱n ka, kii ma̱n palti byas wul!&gt;<verse eid="MAT 7:23" /></para>
  <para style="s">Mbala̱n ɗe lop ma̱n kinti bii</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />&lt;&lt;Ten na̱k gwisi ka̱n, mas ma̱lgwe kum ga̱ɓa gini yek ta̱ koɓi go, ta da̱m na̱k ma̱n ɓotlka̱n yisti wul gwe kin lubii ten pa wu. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Ɗe ze nda wi ɗe dla̱lka njika̱n wu, yek yeta̱l tli toɗi yek ɓo lubiimi, ama yek ba̱ nda so na̱k ɗe ten pa ka̱n ta̱ lak zhila lubii wu. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Ama mas ma̱lgwe kum ga̱ɓa gi ga̱n yek ta̱ nge kopti go, ta da̱m na̱k ka̱dla̱n gwe kin lubii ten yelsi wu. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Ɗe ze nda wi ɗe dla̱lka njika̱n, yek yeta̱l tak ɓo lubiimi wu, yek lubiimi nda ka, byas ndati.&gt;&gt;<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Yesu pak wul jwisi wu, yek ɓanti ci mbala̱n ten kangwe ta̱ hwisi ga̱ɓe wu, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />na̱k ɗe ta̱ hwisi ga̱ɓa na̱k ma̱n iko gon, ba̱ ɗe na̱k kangwe a ma̱n yisti Mba̱t Ga̱ɓa ga̱ Musa pa̱li wu so.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Yesu ndok ma̱n cwo gita gon</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Yesu yil sut ɗa̱ka̱ tla̱nda̱li ka̱wu, yek mbala̱n wonti kopti. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Yek ma̱n gita gon li tet malti, yek ta̱ ngusit atli yek ta̱ ba̱lti nalti. Yek ta̱ wulti ɗe, &lt;&lt;Bagaa, kume ta̱mik ɗa̱ go ka palla̱n ɗe ma̱n la̱shi da̱ska̱n.&gt;&gt;<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Yek Yesu tak ang yek ta̱ ta̱nti, yek ta̱ wuli ɗe, &lt;&lt;Ta̱ ta̱mi ɗa, da̱m ɗe ma̱n la̱shi da̱ska̱n.&gt;&gt; Yek ma̱li ndoki ka̱li-ka̱li. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Yek Yesu wulti ɗe, &lt;&lt;Ba̱k hwi ma̱lgon ilga̱n so, ama li ta̱ ma̱n Pa̱ris ɓo yenki aka̱ ba̱l wul sadaka na̱k gwe Mba̱t Ga̱ɓa ga̱ Musa dla̱m wu. Pa̱li na̱k gwisi ta̱ mbala̱n yisi ɗe ka̱ ndoki wi.&gt;&gt;<verse eid="MAT 8:4" /></para>
  <para style="s">Yesu ndok zhel ga̱ bal ma̱n hapti dlo gon</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Yesu te ka̱ ba̱n Kaparnahum wu, yek bali ga̱ ma̱n hapti dlo ga̱ Roma gon li tet malti yek ta̱ ngemti ɗe ta̱s zit ang ne. <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />Yek ta̱ wulti ɗe, &lt;&lt;Bagaa, zhel gi ni lubii a atli za̱tak dli tlet ka, ta̱ na̱ma tlat bomti i'e.&gt;&gt;<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Yek Yesu wulti ɗe, &lt;&lt;Ba li a lak ndokti.&gt;&gt;<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Yek ma̱li wulti ɗe, &lt;&lt;Bagaa, a mbuki ta̱k li tet ɗa ka̱ so, ga̱ɓa kawei zhel gi a ndoki. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Na̱k ɗe ami mago a atl ɗa̱ ma̱lgon ka ka̱n ani, a ma̱n hapti dlo jon ni atl ɗa ka̱ pak wu. A wul gon ɗe, &lt;Li te du,&gt; ata̱ li. A po wul gon ɗe, &lt;Li teɗi,&gt; ata̱ li te. A wul zhel gi ɗe &lt;Pa̱li na̱k ga̱n,&gt; ata̱ pa̱li nu wu.&gt;&gt;<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Yesu kum ga̱ɓa ga̱mi wugo, yek ta̱ ngip bi ka̱ ang yek ta̱ wul ma̱jwe sa̱ na̱ma kopti kaal gwas wu ɗe, &lt;&lt;Gem a mik kaa hwikii ge, ka̱ ma̱n Yisiraila mago a ɓo yen ma̱lgwe nga̱sti ten Nya gwas nda̱l na̱k ga̱ ma̱lga̱n wu so.&gt;&gt; <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />A niki ma hwiti ɗe ma̱jwe ba̱ ma̱n Yehuda ka̱ sowu na̱k ma̱lga̱n wonti a yil tet tu gaba̱s suk tet tu yemma asa̱ da̱m na̱ zhila asa̱ nguk wul suk Iba̱rahim suk Ishaku suk Yakubu ka̱ guu ga̱ Nya. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Ama ma̱jwe mbun ɗe ta̱ sik ni ɗe mil guumi go sa laksi to deɓa̱l ka ka̱ duu da̱mshal, a duk ka̱n sa kuli asa̱ as ang bi.<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Yek Yesu wul ma̱n hapti dlomi ɗe, &lt;&lt;Zigaa, a piki na̱k kangwe ka̱ nga̱ski ten Nya ɗe ta̱ pik wu.&gt;&gt; Yek zhel ga̱ ma̱n hapti dlomi ndoki ka̱li-ka̱li.<verse eid="MAT 8:13" /></para>
  <para style="s">Yesu ndok nkwe ga̱ Biturus</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Ɗe Yesu te lubii ɗa̱ Biturus ka̱ wu, yek ta̱ mbi nkwe ga̱ Biturus ten zazzaɓi. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Yek Yesu ta̱n ang gwasi, yek zazzaɓi zakti, yek ta̱ tlinya yek ta̱ pa̱lit wul.<verse eid="MAT 8:15" /></para>
  <para style="s">Yesu ndok wonti mbala̱n ka̱ sukti</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Ɗe sukti pi wugo, yek sa̱ tullit mbala̱n jwe ma̱zhe ni ka̱si ju wonti. Yek ta̱ yilli ma̱zhesi ka na̱ ga̱ɓa ga̱ bi gwasi, yek ta̱ ndok mas ma̱jwe dli ta̱mi bi sowu. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Na̱k gwisi pi ten ɗe ta̱ ilgwe Ishaya ma̱n dla̱mti ga̱ɓa ga̱ Nya dla̱m wu njika̱n. Ga̱ɓa gwe wule,</para>
  <para style="q1" vid="MAT 8:17">&lt;&lt;Ta̱ yem cwo jina̱n ka</para>
  <para style="q2" vid="MAT 8:17">yek ta̱ hwula̱nni na̱ la̱shi kumti ta̱mti ga̱ dli jina̱n.&gt;&gt;<verse eid="MAT 8:17" /></para>
  <para style="s">Ma̱jwe sa̱ wule sa kop Yesu wu</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Yesu yeni wi ɗe mbala̱n wonti ganda̱lti wu, yek ta̱ laki ɗe ta̱s ɗakci bal dla̱lke ta̱s pal tu ten ka̱ti gwe ni tu te duk wu. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Yek ma̱n yisti Mba̱t Ga̱ɓa ga̱ Musa gon li tet malti, yek ta̱ wulti ɗe, &lt;&lt;Ma̱n lishti, ba̱ kopki mas lu gwe ka li wu.&gt;&gt;<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Yek Yesu wulti ɗe, &lt;&lt;Gwen-gwen wo shu nisi ɗa, a yadl mago bii nisi ɗa, ama ami yen ga̱ mbala̱n wo lu multi ni ɗa̱ so.&gt;&gt;<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Yek ɗe na̱m ka̱ mil lishti ji Yesu wulti ɗe, &lt;&lt;Bagaa, zaka̱nni ta lak lep aba gi paa, apaa a lak kopki.&gt;&gt;<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Yek Yesu wulti, &lt;&lt;Zak hwu mbala̱n ta̱s lep yilkeni jwasa̱n.&gt;&gt;<verse eid="MAT 8:22" /></para>
  <para style="s">Yesu matl yeta̱l nyaze</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Yek Yesu te ka̱ jirgi ze, yek mil lishti jwas kopti. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Sa̱ ni nugo yek ba̱l yeta̱l nyaze gon tli tot ten bal dla̱lke hal yek zesi tlinya na̱k wule a cin jirgi na̱ gaa. Ama a Yesu na̱ma ndet yemba̱l. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Yek mil lishti jwas sak pa̱da̱lti, yek sa̱ wulti ɗe, &lt;&lt;Bagaa kisni ne, ma̱ ɓa su ga̱z gaa ze!&gt;&gt;<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Yek Yesu wulsi ɗe, &lt;&lt;Yek laki yek ɓanti a cikii ye? Kii ma̱jwe ba̱ nga̱sti ten Nya gwaka̱n nda̱l sowu.&gt;&gt; Yek ta̱ tlinya yek ta̱ matl yeta̱li suk zesi. Yek mas tlo ang, yek lu da̱m mbetlak.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Yek mbala̱n ngip bi ka̱ ang, yek sa̱ ngusi wulti ka̱ dlo gwasa̱n ɗe, &lt;&lt;Wok ɗe ga̱n ɗe hal yeta̱l suk kapsi ze mago asa̱ kumit bi go?&gt;&gt;<verse eid="MAT 8:27" /></para>
  <para style="s">Ndokti ga̱ ma̱n ma̱zhe a Gadasina</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Yesu mbuk lu ka̱ ka̱t atl ga̱ Garasina wu, yek ma̱n ma̱zhe jon ɗe lop jwe asa̱ da̱m ka̱ gazukɗi mo sukti. Ma̱n ma̱zhe jwisi wo sa̱ da̱m ɗe wul cit ɓanti i'e wi, hal sa̱ laki yek ba̱ mbala̱n po man kopti tu ten tantu gwisi so. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Yek sa̱ des le yek sa̱ wuli ɗe, &lt;&lt;Yek ɗe ze gwa suk mi ye, ki Yen ga̱ Nya? Ka̱ tul ɗe ta̱k nolni a ba̱ multi ɓo njika̱n sa?&gt;&gt;<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Ka̱ sa'isi wo a alade jon ni njaa ka̱li sa̱ na̱ma kyo. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Yek ma̱zhesi ngem Yesu ɗe, &lt;&lt;Kume ɗe ka̱ yilla̱ni ka̱wu, aka̱ zakni ta̱n te ka̱ alade ju.&gt;&gt;<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Yek Yesu wulsi ɗe, &lt;&lt;Yilla̱n te ka.&gt;&gt; Yek sa̱ yil ɗa̱ka̱ mbala̱mi ka, yek sa̱ lak te ka̱ aladesi. Yek mas aladesi lok su ka̱ zesi ka yek sa̱ ma̱shi. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Yek ma̱n kyo aladesi lak dla̱mi mbala̱n wul mas jwisi na̱ ilgwe pi na̱ ma̱n ma̱zhe ju pak. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Yek mas ma̱n ba̱mi yil suɗi ta̱s yen Yesu, sa̱ yenti wugo yek sa̱ ngemti ta̱s zakisi ka̱t atl gwasa̱n.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">Yesu ndok ma̱lgwe dli gwas tla ka̱wu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Yek Yesu te ka̱ jirgi ze, yek ta̱ pal te ka̱ ba̱n gwas ka. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Yek ma̱jon tulli ma̱lgwe dli tlet ka̱wu malti a atl ten lumulti. Ta̱ yen nga̱sti ten Nya gwasa̱n wu, yek ta̱ wul ma̱n cwoɓi ɗe, &lt;&lt;Yen gini ba̱ ilgon hwotki so, sa̱ taasik byas wul gwa ka̱wi.&gt;&gt;<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Na̱ kumti na̱k gwisi, yek ma̱n yisti Mba̱t Ga̱ɓa ga̱ Musa jon wul yilkeni jwasa̱n ɗe, &lt;&lt;Ma̱lga̱n na̱ma cutgaa suk Nya!&gt;&gt;<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Na̱k ɗe Yesu yis ilgwe sa̱ na̱ma daamti gwasa̱n dani wu, yek ta̱ wulsi ɗe, &lt;&lt;Yek laki ɗe ka̱a̱ na̱ma daamti byas wul ka̱ mbadl gwaka̱n ye? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Gwik bom so gwi? na̱ ta̱ wule, &lt;Sa̱ taasik byas wul gwa ka̱wi.&gt; Sogo ta̱ wule, &lt;Tlinya ta̱k zigaa?&gt; <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Ama a na̱ma lamti ta̱k yisi ɗe iko ni yen ga̱ mbala̱n ɗa ta̱s taasi byas wul mbala̱n ka ten dii atli.&gt;&gt; Yek ta̱ wul ma̱lgwe dli tlet ka̱wu ɗe, &lt;&lt;Tlinya ta̱k kan lumulti gwa ta̱k li lubii.&gt;&gt; <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Yek ma̱li tlinya yek ta̱ li ga̱s lubii. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Wonti mbala̱mi yeni nu wu, yek ɓanti cisi, yek sa̱ ba̱l nalti Nya ɗe ta̱ ba̱l iko pa̱lti na̱k gwisi mbala̱n wu.<verse eid="MAT 9:8" /></para>
  <para style="s">Yesu mbe Matiyu</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Ɗe Yesu ci cina na̱ za̱tgaa wu, yek ta̱ yen ma̱lgon gwe asa̱ mbet ɗe Matiyu ata̱ ni na̱ zhila ka̱ lu kanti wulpi boo. Yek ta̱ wulti ɗe, &lt;&lt;Koɓa̱nni,&gt;&gt; Yek ta̱ tlinya yek ta̱ kopti.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Kaal na̱k gwisi ɗe ka̱a̱ Yesu suk mil lishti jwas ɓa nguk wul ka̱ lubii ga̱ Matiyu wu, yek ma̱n kanti wulpi boo suk ma̱n pa̱lti byas wul wonti tuli, yek sa̱ lak da̱n na̱ zhila mal Yesu suk mil lishti jwasi yek sa̱ nguk wul. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Ɗe ma̱n Paresi yeni nu wugo, yek sa̱ wul mil lishtisi ɗe, &lt;&lt;Yek laki ɗe ma̱n lishti gwaka̱n na̱ma ngukti wul suk ma̱n kanti wulpi boo suk &lt;ma̱n pa̱lti byas wul ye&gt;?&gt;&gt;<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Yesu kumi nu wugo yek ta̱ wulsi ɗe, &lt;&lt;Ma̱jwe ba̱ cwo na̱ma cit gwasa̱n sowu ngo ma̱n ika̱n so, se ma̱n cwo. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Ama a lamti ta̱k sak yena̱n ilgwe ga̱ɓa ga̱na̱n mbokti ang dani wu, ga̱ɓa ɗe ta̱ wuli ɗe, &lt;Yenti gonti ka̱n a lami, ba̱ ɗe we sadaka so.&gt; Ten na̱k gwisi ka̱n, a tul ɗe ta̱ mbe ma̱n wul ndakce so, ma̱n pa̱lti byas wul ka̱n a tuli mbet gwasa̱n.&gt;&gt;<verse eid="MAT 9:13" /></para>
  <para style="s">Kumti ga̱zi ten pa̱lti ka̱lka̱ze</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Ka̱ sa'i gwisi, yek mil lishti ji Yohana tul mal Yesu yek sa̱ ngemti ɗe, &lt;&lt;Yek laki ɗe na̱ mi, na̱ ma̱n Paresi a ma̱ pa̱l ka̱lka̱ze ama mil lishti jwa wo ba̱sa pa̱li so ye?&gt;&gt;<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Yek Yesu wulsi ɗe, &lt;&lt;Yela̱n ji pyal kos a pa̱l duu tuki a pyal kosi yi suksi ya? Ai multi jwe sa kamisi pyal kosi ka̱wu yi teɗi, ka̱ sa'isi ka̱n sa pa̱l ka̱lka̱ze.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />&lt;&lt;Ai ma̱lgon kama̱n pyal yadi ata̱ tla̱m keshti ga̱ gus ka na̱ nali so, kume ta̱ pa̱li nugo gus luka̱li a kesh ka man kangwe kesh cina wu. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />A ba̱ mbala̱n a shot pyal ze inabi ka̱ gus ngura kul so. Kume ta̱ pa̱li nu go, ngure a kesh ka a ze inabisi shot te atl ka a yekge ngure lil ka̱ wi. Pyal ze inabi wo ka̱ pyal ngura kul ka̱n a shoti. Pa̱lti na̱k gwisi ka laki asa̱ mbi ze inabisi suk ngura kuli.&gt;&gt;<verse eid="MAT 9:17" /></para>
  <para style="s">Ndokti ga̱ kili ma̱n cwo suk palti kaami ga̱ yen kili gwe ma̱sh wu</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Yesu nisi ma ga̱ɓa nu go yek bacina ga̱ lu motgaa ga̱ ma̱n Yehuda gon tuli, yek ta̱ ngus atl a cina ɗatka, yek ta̱ wulti ɗe, &lt;&lt;Ninge ninge ka̱n yen gi ya ma̱shi, ama lite ta̱k ta̱nti ta pal kaami.&gt;&gt; <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Yek Yesu tlinya yek ta̱ kopti suk mil shinti jwas ji botli.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Yek kili gon gwe ta̱ pa̱l gin ɗe kutl cet lop a hwulan nitma shotti wu, li tet tu tukaal ga̱ Yesu, yek ta̱ ta̱n bi luka̱l gwasi. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Na̱k ɗe ta̱ wuli ka̱ mbadl gwas ɗe, &lt;&lt;Ko ta̱ luka̱l gwas ka̱n a ta̱ ni go, ba ndoki.&gt;&gt;<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Yek Yesu balla̱ti yek ta̱ yenti wu yek ta̱ wulti ɗe, &lt;&lt;Yen gini ba̱ ilgon hwotki so, nga̱sti ten Nya gwa ndoki wi.&gt;&gt; yek ta̱ ndoki ka̱li-ka̱li.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Ɗe Yesu mbuk lu ɗa̱ bacinesi ka̱wu, yek ta̱ mbi mbala̱n asa̱ na̱ma hotti sheta̱l asa̱ na̱ma shila̱n ka̱li. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Yek Yesu wule, &lt;&lt;Ba̱la̱nni nini lu, yen kilisi ɓo ma̱sh so, yemba̱l ka̱n ta̱ na̱ma ndeti.&gt;&gt; Yek sa̱ gitliti. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Sa̱ yilli mbala̱mi deɓa̱l wu, yek Yesu te ka̱ giɓi yek ta̱ ngiɓi ang yen kilisi, yek ta̱ tlinya. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Yek ga̱ɓa gwisi ma̱tl ka̱ ka̱t atl gwisi mas.<verse eid="MAT 9:26" /></para>
  <para style="s">Yesu ndok dwa</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Yek Yesu li cina wu, yek dwa ɗe lop jon kopti, asa̱ na̱ma wulti to nya ka̱ɗe, &lt;&lt;Yesu yen ga̱ Dauda yen gonti ga̱na̱n ne!&gt;&gt;<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Ɗe Yesu te ka̱ lubii gon wu, yek dwami li tet malti. Yek Yesu wulsi ɗe, &lt;&lt;Ka̱a̱ kan ka̱ mbadl ɗe ba man ndokti gwaka̱n ma?&gt;&gt;</para>
  <para style="p" vid="MAT 9:28">Yek sa̱ wule, &lt;&lt;Yii, Bagaa, ka mani.&gt;&gt;<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Yek Yesu ta̱n gwel gwasa̱n, yek ta̱ wule, &lt;&lt;Ha̱n ta̱ pikii na̱k gwe ka̱a̱ kan ka̱ mbadl wu,&gt;&gt; <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Ɗe Yesu dlam nu wu, yek gwel gwasa̱n ɓuli. Yek ta̱ da̱lisi ka̱ng i'e, yek ta̱ wulsi ɗe, &lt;&lt;ba̱k dla̱mi ma̱lgon ilga̱n so.&gt;&gt; <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Ama yek sa̱ ngusi dla̱mti ilgwe ta̱ pa̱lisi wu ka̱ ka̱t atli mas.<verse eid="MAT 9:31" /></para>
  <para style="s">Yesu ndok ma̱lgwe ba̱ta ga̱ɓa dani sowu</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Ɗe sa̱ ɓa zak ba̱mi go, yek ma̱jon tulli ma̱lgon gwe ma̱zhe ngiɓit bi ka̱wu yek ba̱ta ga̱ɓa dani sowu. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Yesu yilli ma̱zhesi ɗa̱ka̱ ma̱li ka̱wu, yek ma̱li njel ga̱ɓa. Yek ma̱jwe ni ka̱li wu ngip bi ka̱ ang, yek sa̱ wule, &lt;&lt;Ma̱ ɓo taɓa yenti ilgon nu ka̱ ma̱n Yisiraila so.&gt;&gt;<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Yek ma̱n Paresi wule, &lt;&lt;Na̱ iko ga̱ guu ma̱zhe ka̱n ta̱ na̱ma yilla̱t ma̱zhe ka.&gt;&gt;<verse eid="MAT 9:34" /></para>
  <para style="s">Yesu yen gonti ga̱ mbala̱n</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Yek Yesu ngusi ma̱tlti yek ta̱ ngash kiɗi ba̱n suk nak mili mas ata̱ na̱ma dla̱mti ta̱mi ga̱ɓa ka̱ lu motgaa jwasa̱n ten bi guu ga̱ Nya, ata̱ na̱ma ndokti ga̱ wunda̱l ji co mas suk ma̱jwe dli ta̱misi bi sowu. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Ama ɗe ta̱ yen mbala̱n wonti mogaa wu, yek gonti gwasa̱n citi na̱k ɗe sa̱ na̱ma tlat bomti asa̱ cac-cal ɗa̱nka̱ wu, na̱k wule mba̱la jwe ma̱n kyo nisi ɗa̱ sowu. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Yek ta̱ wul mil lishti jwas ɗe, &lt;&lt;Wotlti zhimi nali, ama ma̱n wotlti wo sa̱ wonti so. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Ngema̱n Bagaa ga̱ wotlti zhimi ta̱s mba̱l ma̱n wotlti zhimi jon.&gt;&gt;<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Yesu shin mil lishti ɗe kutl cet lop</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Yek ta̱ mbe mil lishti jwas ɗe kutl cet lop ju yek ta̱ ba̱lsi iko ta̱s man yilla̱t ɗa̱ yeta̱l ka a ta̱s man ndokti ga̱ mas co suk ma̱jwe dli ta̱misi bi sowu. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Shin ji mil shinti ji botlisi ka̱ɗe ɗe, Siman gwe asa̱ mbet ɗe Biturus wu, suk yilka gwasi Andarawus, suk Yakubu yen ga̱ Zabadi suk yilka gwasi Yohana, <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />suk Pilibus, suk Bartalomi, suk Tomas, suk Matiyu ma̱n kanti wulpi boo, suk Yakubu yen ga̱ Halpa, suk Tadiwus, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />suk Siman ma̱n Kan'ana suk Yehuda Iskariyoti ma̱lgwe ba̱l bi Yesu wu.<verse eid="MAT 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Mil shinti ɗe Kutl cet ɗe lop jimi ka̱n Yesu shinsi, yek ta̱ lakisi icin kaal ɗe, &lt;&lt;Ba̱k la̱n mal ma̱jwe ba̱ Ma̱n Yehuda ka̱ sowu so, a ba̱k te ka̱ ba̱n Samariya so. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Ama la̱n mal ma̱n Yisiraila jwe gil ka̱wu. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />La̱nni a ka̱a̱ hwi mbala̱n ɗe, &lt;Kanti ga̱ Nya ɗe guu ga̱na̱n ɓal njaa.&gt; <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Ndoka̱n ma̱jwe dli ta̱misi bi sowu, palla̱n ma̱jwe ma̱sh wu kaami, ndoka̱n ma̱n gita ka ta̱s pal ɗe ma̱n la̱shi da̱ska̱n, a ka̱a̱ yilli mbala̱n yeta̱l ka. Ten koo lu ka̱n sa̱ ba̱lkii, kii mago ba̱li ten koo lu pak. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Ka̱a̱ ɓa li wu ba̱k kama̱n wulpi ga̱ zinariya sogo ga̱ zil ga̱lla sogo ga̱ hwol ga̱lla ka̱ aljihu gwaka̱n so. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />A ba̱k kama̱n ngura sogo mayafi sogo luka̱l ɗe lop suk kapta̱lan suk sanda so. Ten ɗe ma̱n pa̱lti wul wo mbun ɗe ta̱s mbi ilga̱ nguki ka̱ pa̱lti wul gwasi.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />&lt;&lt;Mas ba̱n gwe ka̱li wu, ngo hwa mbala̱n ka̱ ba̱mi a ka̱a̱ te lubii ɗatka aka̱a̱ da̱m ka̱li hal se gas gwe ka̱ zak ba̱mi wu. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Kume ka̱ te ka̱ lubiimi wugo a ka̱a̱ wulisi sallama. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Kume hwa mbala̱n ni ka̱ lubiimi ta mbi sallama gwaka̱n. Kume hwa mbala̱n ni ka̱ lubiimi sowu, sallama gwaka̱n a pallikii. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Mas ma̱lgwe nge kanti gwaka̱n sogo ma̱lgwe nge kumti ga̱ɓa gwaka̱n wu, a ka̱a̱ bat kushka gwe nikii ten asa̱n ka ɗe ka̱a̱ ɓa zak lubiimi wu, sogo ɗe ka̱a̱ ɓa zak ba̱mi wu. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Gem amik ka hwik ge, ten gas kisti ga̱ɓa wo, Nya a dlwe mbadl ma̱n Sodom suk ma̱n Gomora man ma̱n ba̱n jwisi.<verse eid="MAT 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />&lt;&lt;Yekgu a na̱ma shinti gwaka̱n na̱k mba̱la jwe sa̱ te ka̱ dlo ga̱ kaɗila̱p wu. Yek laki yek a nikii ma hwiti ɗe ta̱k da̱ma̱n na̱ ɓotlka̱n na̱k wuci, ama da̱ma̱n ɗe ma̱jwe ba̱sa pi ɓarna sowu na̱k kulu.<verse eid="MAT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 10:17" />&lt;&lt;Pa̱n ɗem ɗem na̱ mbala̱n na̱k ɗe sa man ta̱lat gwaka̱n dlaboo, asa̱ ɓoki ka̱ lu motgaa gwasa̱n wu. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />A sa ta̱lakii a cina ji bacina suk ma̱n kisti ga̱ɓa suk guu jwasa̱n ta̱ da̱misi ɗe sheda suk ma̱jwe ba̱ Ma̱n Yehuda ka̱ sowu. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Kume sa̱ ta̱lakii malsi wu, ba̱ kangwe kaa ga̱ɓa wu sogo ilgwe kaa dla̱m wu hwotkii so, ten ɗe sa ba̱lkii ilgwe kaa dla̱m wu ka̱ sa'i gwisi, <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />na̱k ɗe ba̱ kik ka ga̱ɓa so, ama Shishi ga̱ Aba gwaka̱n ka ga̱ɓa tumalkii wu.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />&lt;&lt;Yilka a ba̱l bi ga̱ yilka gwasi asa̱ tloti, a aba a ba̱l bi ga̱ yen gwasi. Mil a tli ma̱n za̱t jwasa̱n gaa hal asa̱ laki ta̱s tlosi. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Mas mbala̱n a ngekii ten bi shin gini. Ama mas ma̱lgwe dlo mbadl hal pakti go tik ka mbi kisti. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Kume sa̱ lakkii ka̱ bomti ka̱ ba̱n ga̱n wu, aɓa̱n te ka̱ ba̱mi ga̱n ka. Gem amik ka hwikii ge, kaa ɓo pak ma̱tlti ɗa̱nka̱ ba̱n ji Yisiraila ka̱ so Yen ga̱ Mbala̱n a pali.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />&lt;&lt;Yen lishti nal man ma̱n lishti gwas so, a ba̱ zhel nal man baboo gwas so. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Ai pa̱li wi, ɗe yen lishti da̱n na̱k ma̱n lishti gwasi, a zhel da̱n na̱k baboo gwas wu. Kume sa̱ mbe baboomi ɗe Ba'alzabul Guu Ma̱zhe go, ɗe yek sa mbe mil boo gwas ye?<verse eid="MAT 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />&lt;&lt;A nikii ma hwiti ba̱ ɓanti gwasa̱n cikii so, na̱k ɗe ba̱ ilgon ni ga̱ yitle gwe ba̱sa ɓul ka̱ sowu. A ba̱ ilgon ni ga̱ hwunda̱li ka, gwe ba̱ mbala̱n a yilli ten dii sowu. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Ilgwe a hwikii ka̱ da̱mshal wu, dla̱ma̱n ka̱ dlo cin, ilgwe sa̱ hwikii ka̱ shu ka̱ng go, laka̱n icin gwas ten gaa bii. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Ba̱k ɓanti ma̱jwe asa̱ tlo dli ga̱ mbala̱n ama ba̱sa man tlot ga̱ mbadl gwas sowu so. Ama ɓanti ma̱lgwe ta man tlot ga̱ dlisi ata̱ man lakti ga̱ mbadli ka̱ buu wutu wu. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Ale asa̱ wul yadl ba̱lba̱l ɗe lop ka wulpi ga̱lla ɗe na̱m na̱? Ama ko gon gwasa̱n a nda ten atl ɗe ba̱na̱ yisti ga̱ Aba gwaka̱n gwe ni nya wu ka̱ sowu. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Ai ko ta̱ ma̱dla̱n gaa gwaka̱n mago ga̱ dla̱mi ka̱n ni malti. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Ten na̱k gwisi ai kaa mana̱n ba̱lba̱l wonti na̱ nalti.&gt;&gt;<verse eid="MAT 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />&lt;&lt;Mas ma̱lgwe mbok ang ɗe ti wo gi ka̱n a cina ga̱ mbala̱n wu, ammago ba mbok ang tenti ɗe gini, a cina ɗa̱ Aba gi gwe ni to nya ka̱ wu. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Ama mas ma̱lgwe nge mbokti ang ɗe ti wo gi ka̱n mal mbala̱n go, ammago ba nge mbokti ang tenti ɗe gini a cina ɗa̱ Aba gi gwe ni to nya ka̱wu.&gt;&gt;<verse eid="MAT 10:33" /></para>
  <para style="s">Dlanti ka̱n a tulli, ta̱mi da̱nti ka̱n a tulli so</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />&lt;&lt;Ba̱k da̱ma̱n gwa we ta̱mti da̱nti ka̱n a tulli ten dii atl so. Ta̱mti da̱mti ka̱n a tulli so dlanti ka̱n a tulli. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Na̱k ɗe a tul ɗe</para>
  <para style="q1" vid="MAT 10:35">&lt;&lt; &lt;ta mo yen mani suk aba gwasi,</para>
  <para style="q2" vid="MAT 10:35">a mo yen kili suk ana gwasi,</para>
  <para style="q1" vid="MAT 10:35">ta mo nkwe suk aka gwasi,<verse eid="MAT 10:35" /></para>
  <para style="q2">
    <verse number="36" style="v" sid="MAT 10:36" />ma̱n boo ga̱ mbala̱n a da̱m ɗe yela̱n dlanti jwasi.&gt;<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />&lt;&lt;Mas ma̱lgwe lam aba gwasi sogo ana gwas mana̱n go ma̱li mbuk da̱nti ɗe ma̱n kopti gi so. A ma̱lgwe lam yen gwas ga̱ maani sogo ga̱ ma̱dli mana̱n go, ma̱li mbuk da̱nti ɗe ma̱n kopti gi so. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Mas ma̱lgwe kan bomti na̱k guda̱l yencin gaa ta̱s koɓa̱n sowu, ma̱li mbuk da̱nti ɗe ma̱n kopti gi so. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Mas ma̱lgwe lam mbadl gwas go, ta hwul na̱ mbadl gwasi, ama ma̱lgwe hwul na̱ mbadl gwas ten bi gi go ta mbi mbadl gwasi.<verse eid="MAT 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />&lt;&lt;Mas ma̱lgwe kankii go ami ka̱n ta̱ kama̱nni. Ma̱lgwe kama̱n go, ma̱lgwe shina̱n wu ka̱n ta̱ kanti. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Mas ma̱lgwe kan ma̱n dla̱mti ga̱ɓa ga̱ Nya ten ɗe ti wo ma̱n dla̱mti ga̱ɓa ga̱ Nya ka̱wu, ma̱li a mbi albarka gwe tumal ma̱n dla̱mti ga̱ɓe. A mas ma̱lgwe kan ma̱n pa̱lti wul ndakce ten ɗe ti wo ma̱n pa̱lti wul ndakce ka̱wu, ma̱li a mbi albarka tumal ma̱n pa̱lti wul ndakce. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />A mas ma̱lgwe ba̱l ko ta̱ mbuka ze ɗe na̱m nak mil jin ten ɗe si wo mil lishti ji wu, Gem amik ka hwikii ge, ta sa ba ɓatlti so.&gt;&gt;<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Yohana ma̱n baptisma shin mil lishti jwasi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Yesu paki hwit ga̱ɓa mil shinti jwas ji botli ɗe kutl cet lop ju wu, yek ta̱ zak luisi yek ci ta̱ cina na̱ za̱tgaa yek ta̱ te ka̱ ba̱n jwe ni ka̱ ka̱t atl ga̱ Galili wu ata̱ nisi ma mbokti ang suk lakti icin ten ga̱ɓa ga̱ Nya.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Ka̱ sa'isi wo a Yohana ma̱n baptisma ni ga̱ le ka, ɗe ta̱ kum ilgwe Yesu na̱ma pa̱lti wu wu, yek ta̱ shin mil lishti jwas malti, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />ta̱s kum ga̱zi ɗe, &lt;&lt;Kik ɗe ma̱n tulti gwa, ko ta̱n zi gwel tulli ga̱ ma̱lgon?&gt;&gt;<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Yek Yesu wulsi, &lt;&lt;Lak hwi Yohana ilgwe ka̱a̱ kumi yek ka̱a̱ yeni wu. <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Dwa ɓa yenti lu, kulki ɓa li na̱ asa̱n, ma̱n gita na̱ma palti ɗe ma̱n la̱shi da̱ska̱n, ma̱jwe kum ka̱ng sowu ɓa kum ka̱ng, asa̱ na̱ma palla̱t ɗa̱ ma̱jwe ma̱sh wu kaami, a ma̱jwe ba̱ ilgon nisi ɗa̱ sowu na̱ma kumti ga̱ɓa ma̱n ta̱mti. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Ma̱n albarka ka̱ɗe ma̱lgwe ba̱ta kot asa̱n ten bi gi sowu.&gt;&gt;<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Ɗe mil shinti ji Yohana zigaa wu, yek Yesu njeli hwit ga̱ɓa wonti mbala̱n ten bi Yohana, yek ta̱ wulsi ɗe, &lt;&lt;Ɓohwe yek ka̱a̱ la yenti ka̱ me ye na̱? Tlal me jwe a yeta̱l wuni ka̱n ka̱a̱ sa yenti ya? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Kume nuk sogo, to yek a ka̱a̱ sa yenti ye? Ka̱a̱ da̱ma̱n we ma̱lgon ka̱n kaa yenti na̱ mbuni luka̱l ten dli ya? Wowo, ma̱jwe asa̱ lak mbuni luka̱l jwo ka̱ dlaboo ga̱ guu ka̱n asa̱ da̱mi. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />To, yek aka̱a̱ sa yenti ye? Ma̱n dla̱mti ga̱ɓa ga̱ ka̱n ka̱a̱ sa yenti gwas a? Yii, amik ka hwikii ge, ta̱ man ma̱n dla̱mti ga̱ɓa ga̱ Nya na̱ nalti pamma. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Tik ɗe ma̱lgwe taka̱rda ga̱ɓa tenti ɗe,</para>
  <para style="q1" vid="MAT 11:10">&lt;&lt; &lt;Yekgu ba lak yen shinti gini ta̱s tulik cina</para>
  <para style="q2" vid="MAT 11:10">tik ɗe ma̱lgwe ta la̱ka̱mik lu wu.&gt;<verse eid="MAT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />&lt;&lt;Gem amik ka hwiti ge, ka̱ mas mbala̱n jwe modli wutsi go gon na̱k man Yohana ma̱n baptisma so. Ama ma̱lgwe tik ɗe nak'eni ka̱ guu ga̱ Nya wu nal man Yohana ma̱n baptisma. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Tun tet ka̱ multi ji Yohana ma̱n baptisma hal yek la ase, guu ga̱ Nya na̱ma tlat bomti, a ma̱jwe nit ma ba̱lti bomti na̱ma lamti ta̱s kan guumi ka na̱ nda̱lti. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Na̱k ɗe mas Mba̱t Ga̱ɓa ga̱ Musa suk lishti ji ma̱n dla̱mti ga̱ɓa ga̱ Nya, dla̱m ga̱ɓa ten bi guumi a ba̱ Yohana ɓo tul sowu. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Kume kaa kan ilgwe sa̱ dla̱m wu, Yohana ka̱ɗe Iliya gwe sa̱ dla̱m ga̱ɓa ɗe ta tullu. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Mas ma̱lgwe ka̱ng kumti ga̱ɓa niɗɗa̱ wu ta̱s kumi.&gt;&gt;<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />&lt;&lt;Na̱ yek ba cinga̱l mbala̱n ji se ye? Na̱k mil mbala̱n jwe ni ka̱ lu jetit gwasa̱n wu ka̱n sa̱ ni, jwe sa̱ na̱ma mbet ga̱ yela̱n jetit jwasa̱n asa̱ na̱ma wulti ɗe,<verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />&lt;&lt; &lt;ma̱ hotikii mba̱zhel</para>
  <para style="q2" vid="MAT 11:17">yek ba̱ka̱a̱ dlal so,</para>
  <para style="q1" vid="MAT 11:17">yek ma̱ wulikii koo multi ma̱shka̱n</para>
  <para style="q2" vid="MAT 11:17">yek ba̱ka̱a̱ kul so.&gt;<verse eid="MAT 11:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18" />Na̱k ɗe Yohana tuli ba̱ta̱ nguki ata̱ tla i'e so yek sa̱ wule, &lt;ma̱n yeta̱l ka̱ɗe ti.&gt; <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Yek Yen ga̱ Mbala̱n tul wu ata̱ nguki ata̱ tlat, yek sa̱ wule, &lt;Ma̱lga̱n nguk wul hwo ata̱ tla wul hwo, yela̱n ga̱ ma̱n kanti wulpi boo suk &lt;&lt;ma̱n pa̱lti byas wul.&gt;&gt; &gt; Ama mas na̱ nu mbala̱n yen ɓotlka̱n yisti wul ga̱ Nya tumal pa̱lti wul gwasi.&gt;&gt;<verse eid="MAT 11:19" /></para>
  <para style="s">Ba̱n jwe nge cit atl gaa wu</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Yek ta̱ njeli da̱lti ka̱ng ba̱n jwe ta̱ pa̱l wul jwe a lak mbala̱n ten ngipti bi ang yek sa̱ nge cit atl gaa wu. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />Yek ta̱ wule, &lt;&lt;Kii wo wul cit gonti ka̱n ma̱n Korazin! Kii wo wul cit gonti ka̱n ma̱n Betsaida! Wul ngipti bi ang gwe sa̱ pa̱li malkii go, ɗe da a Taya suk Sidon ka̱n sa pa̱li go da sa ci atl gaa, asa̱ lak gus luka̱l asa̱ cat mba̱tla̱l ten gaa jwasa̱n asa̱ na̱ma ba̱lti bi. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />A nikii ma hwiti ɗe, ten gas kisti ga̱ɓa wo Nya a dlo mbadl na̱ ma̱n Taya suk Sidon mankii. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Kii ma̱n Kaparnahum, ka̱a̱ da̱ma̱n gwa we sa tlilkii to nya ka? Wowo, ai ka̱ atl ka̱n sa sulkii, ka̱ lu da̱mti ga̱ ma̱jwe ma̱sh wu. Wul ngipti bi ang gwe sa̱ pa̱li ka̱ ba̱n gwaka̱n wu ka̱n sa pa̱li a Sodom go da a yi hal ase. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />A nikii ma hwiti ɗe ten cin kisti ga̱ɓa wo sa yen gonti ga̱ Sodom mankii.&gt;&gt;<verse eid="MAT 11:24" /></para>
  <para style="s">La̱n tet mala̱nni ta̱k mbi shukti</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Ka̱ sa'i gwisi wo, yek Yesu wule, &lt;&lt;A pa̱l hwol tuk na̱ki Buka, Bagaa ga̱ dii atli suk dlo nya na̱k ɗe ka̱ hwunda̱li wul jwisi ma̱n ɓotlka̱n yisti wul suk ma̱jwe yisti nisi ɗa̱ wu, ama yek ka̱a̱ mboki ang mil mbala̱n dani. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Yii Aba, ten na̱k gwisi ka̱ ta̱n yeniki.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />&lt;&lt;Mas wul wo Aba gi ka̱ ba̱la̱nni. Ma̱lgon yis Buke so se Yeni, a ba̱ ma̱lgon yis Yeni so se Buke suk ma̱lgwe yeni hwit bi ga̱ Buke wu.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />&lt;&lt;La̱n tet mala̱nni mas jwaka̱n, kii ɗe ka̱a̱ nak wi aka̱a̱ na̱ma tlat bomti na̱ wul ma̱n diɓa̱lti gaa wu, ami wo ba ba̱lkii shukti. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Kama̱n ilgwe a dla̱m wu na̱k gwe a tla kan guda̱l yencin ka̱ yal gwas wu, pa̱la̱n ilgwe a mbokikii ang dani wu, na̱k ɗe ami wo ma̱n kumti bi ka̱n a ma̱n ngusa̱lti gaa atl ka̱n, apaa ka̱a̱ mbi shukti ga̱ mbadl gwaka̱n. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Ten ɗe guda̱l yencin gini gwe yek ɗe ilgwe a dla̱m wu bom so, a ba̱ wul ji diɓa̱l so.&gt;&gt;<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Kumti ga̱zi ten cin shukti ga̱ ma̱n Yehuda</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Ka̱ multi jwisi ten gas Asabar cin shukti ga̱ ma̱n Yehuda, a Yesu suk mil lishti jwas na̱ma yilti ka̱ zhin alkama gon a kuza̱n ɓa tlo mil lishtisi, yek mil lishtisi njel celti gaa alkama asa̱ na̱ma ngukti. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Ɗe ma̱n Paresi yensi wu, yek sa̱ wulti ɗe, &lt;&lt;Ɓo yen ilgwe mil lishti jwa na̱ma pa̱lti gas Asabar wu, ko ɗe Mba̱t Ga̱ɓa ga̱ Musa wule ba̱ mbala̱n pa̱li so wu.&gt;&gt;<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Yek Yesu ballisi ɗe, &lt;&lt;Ase, ka̱a̱ yena̱n ilgwe sa̱ lishi ten Dauda guu suk yela̱n la̱t jwasi ɗe kuza̱n ɓa tlosi wu sa? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Ai, ta̱ te ka̱ lubii ga̱ Nya, yek sa̱ kan burodi gwe sa̱ zi ka̱wu yek sa̱ nguki, ko ɗe mbun ɗe ta̱ ma̱lgon nguk so se ma̱n Pa̱rismi na̱ ngusa̱n wu. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Ko ka̱a̱ ɓo yeni ga̱ lishi ka̱ Mba̱t Ga̱ɓa ga̱ Musa ɗe, a ma̱n Pa̱ris pa̱l ilgwe ba̱ yek sowu ka̱ lubii ga̱ Nyami gas shukti, ama yek ba̱ ni ɗe we sa̱ cel mba̱t ga̱ɓe ka̱ so sa? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />A nikii ma hwiti ɗe ma̱lgwe ta̱ nal man lubii ga̱ Nya wuggu. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Da kaa yis ilgwe laki yek ga̱ɓa ga̱ Nya wuli ɗe, &lt;Yenti gonti ka̱n a lami ba̱ ɗe we takti wul so.&gt; Da kaa yen ma̱n la̱shi pa̱lti ilgwe ba̱ yek sowu na̱ byas wul so. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Ten ɗe Yen ga̱ Mbala̱n wo Bagaa ga̱ gas shukti ka̱n.&gt;&gt;<verse eid="MAT 12:8" /></para>
  <para style="s">Yesu ndok ma̱lgwe ang gwas tla ka̱wu</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Yesu zak lwisi wugo, yek ta̱ te ka̱ lu motgaa gwasa̱n, <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />a ma̱lgon ni ɗa ka̱li gwe ang gwas tla ka̱wu. Yek ma̱n Paresi ngem Yesu ɗe, &lt;&lt;Mbun ɗe ta̱ ndok mbala̱n gas shukti ya?&gt;&gt; Sa̱ ngem ti nu ta̱s man dopti gwas na̱ pa̱lti wul gas shukti.<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Yesu wulsi ɗe, &lt;&lt;Wok ka̱ kii gwe ɗe mba̱la a niɗɗa, a mba̱le nda ka̱ shu gas shukti a ba̱ta yilla̱t ɗa̱ka̱ shusi ka ten gas shukti so wo? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Ai mbala̱n mana̱n mba̱la i'e? Ten na̱k gwisi ka̱n, sa̱ dla̱m ɗe ba̱ mbala̱n pa̱l hwa wul gas shukti so so.&gt;&gt;<verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />Yek ta̱ wul ma̱li ɗe, &lt;&lt;Tak ang gwa,&gt;&gt; yek ta̱ taki. Yek ami ndoki, yek pal na̱k gon wu. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Yek ma̱n Paresi yili, yek sa̱ tak dla̱m ga̱ɓa ten kangwe sa pi asa̱ tlo Yesu wu.<verse eid="MAT 12:14" /></para>
  <para style="s">Ga̱ɓa ga̱ Ishaya ma̱n dla̱mti ga̱ɓa ga̱ Nya njika̱n wi</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Ɗe Yesu yisi nu wugo, yek ta̱ zak lwisi, yek mbala̱n wonti kop kaal gwasi, yek ta̱ ndok mas ma̱n cwo jwe sa̱ ni ka̱si wu. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Yek ta̱ hwisi ɗe ba̱s dla̱mi mbala̱n ilgon tenti so. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Ili pi nu ten ɗe ta̱ ga̱ɓa gwe Nya dla̱mi tumal Ishaya wu njika̱n ɗa, ga̱ɓa gwe wule,<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />&lt;&lt;Zhel gi gwe a botli wu ka̱wu,</para>
  <para style="q2" vid="MAT 12:18">a lamti a nima hwol tuk na̱ ti i'e.</para>
  <para style="q1" vid="MAT 12:18">Ba njika̱nti na̱ Shishi gini</para>
  <para style="q2" vid="MAT 12:18">ata̱ pa̱li mas ka̱t atl ji ba̱n kisti ga̱ɓa ga̱ gem.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Ta dla̱k ga̱ɓa suk ma̱lgon so, a ba̱ta tlil yal gwas nya so,</para>
  <para style="q2" vid="MAT 12:19">a ba̱sa kum yal gwas ɗa̱n ten tantu ka̱ so.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Ta pak celti mamo gwe ɓal njaa ta̱ cel ka̱wu so,</para>
  <para style="q2" vid="MAT 12:20">a ba̱ta mba̱sh pitila gwe ɓa lam ma̱shka̱n wu so.</para>
  <para style="q1" vid="MAT 12:20">se ta̱ laki yek pa̱lti gem ci ba̱n.<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />Ma̱jwe ba̱ Ma̱n Yehuda ka̱ sowu a zi mbadl tenti.&gt;&gt;<verse eid="MAT 12:21" /></para>
  <para style="s">Yesu suk Ba'alzabul Guu Ma̱zhe</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Yek sa̱ tullit ma̱n ma̱zhe gon, ma̱li wo ta̱ ga̱ɓa dani so, a dwa ka̱n yek Yesu ndokti yek ta̱ man ga̱ɓa suk yenti lu. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Yek ɓanti ci mas mbala̱n jwe ni ka̱li wu. Yek sa̱ wule, &lt;&lt;Ɓohwe, ale ma̱lga̱n go yen ga̱ Dauda ka̱n na̱?&gt;&gt;<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Ama ma̱n Paresi kumi nu wu, yek sa̱ wule, &lt;&lt;Ai na̱ iko ga̱ Ba'alzabul Guu Ma̱zhe ka̱n ma̱lga̱n na̱ma yilla̱t ga̱ yeta̱l ka.&gt;&gt;<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Na̱k ɗe Yesu yis daamti gwasa̱n wu, yek ta̱ wulsi ɗe, &lt;&lt;Mas guu gwe mbala̱n jwas tatl gaa gwasa̱n ɗe lop ten nget ga̱ yilkeni jwasa̱n go ba̱mi a dla̱l so. A mas ba̱n sogo boo gwe a mbala̱n jwasa̱n tatl gaa gwasa̱n ɗe lop ten nget ga̱ yilkeni jwasa̱n go, ba̱mi sogo boomi a dla̱l so pak. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Kume Sheɗan ka̱ yilli Sheɗan go, ɗa̱ ni ka̱n ba̱n gwas a dlal gwi? Na̱k ɗe ta̱ na̱ma dlanti suk gaa gwas wu. <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />A kume na̱ iko ga̱ Ba'alzabul ka̱n a na̱ma yilla̱t ga̱ ma̱zhe ka̱wu, mil lishti jwaka̱n wo na̱ iko ga̱ wok asa̱ yilli ka̱ wo? Sik ka da̱mikii ɗe ma̱n kisti ga̱ɓa. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Ama kume na̱ iko ga̱ Shishi ga̱ Nya ka̱n a na̱ma yilla̱t ma̱zhe ka̱ wu, Nya ɗe guu tulikii wi.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />&lt;&lt;Sogo ɗa̱ nii ka̱n ma̱lgon a man tet ka̱ lubii ga̱ nda̱li mbala̱n ata̱ yemit wul ka̱ gwi? Se ta̱ ɓal ma̱n lubiimi ka̱ paa ata̱ manit yemti wul ka.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />&lt;&lt;Ma̱lgwe ni suk ami sowu, ma̱li na̱ma nget gini. A ma̱lgwe zi ang ten moti sowu catti ka̱n ma̱li na̱ma catti ka. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Yek laki yek a nikii ma hwiti ɗe, sa man taasti ga̱ mas byas wul suk ga̱ɓa mbulti Nya ga̱ mbala̱n ka, ama ma̱lgwe dla̱m byas ga̱ɓa ten Shishi ga̱ Nya go sa taasit ka̱ so. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Mas ma̱lgwe dla̱m ga̱ɓa mbulti ten Yen ga̱ Mbala̱n go sa taasit ka. Ama mas ma̱lgwe dla̱m ga̱ɓa mbulti ten Shishi ga̱ Nya go sa taasit ka̱ so, ko na̱k ninge sogo cin ga̱ ayo.<verse eid="MAT 12:32" /></para>
  <para style="s">Tlindi suk yandi gwasi</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />&lt;&lt;A hwa tlindi wut hwa yandli. Ama kume tlindi wo lili ka̱wu, a wut lili yandi. Tu ten wunda̱l ga̱ yandi ka̱n a mbala̱n yis wunda̱l ga̱ tlindi. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Wonti woka̱nzi na̱kkii nini, ɗa̱ ni ka̱n kaa dla̱m hwa wul gwi? Ai ilgwe ni ka̱ mbadl wu ka̱n a bi dla̱mi. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Hwa mbala̱n wo ata̱ yilli hwa wul tet ka̱ hwa wul gwe ta̱ zi ka̱ mbadl gwas wu, a byas mbala̱n wo ata̱ yilli byas wul tet ka̱ byas wul gwe ta̱ zi ka̱ mbadl gwas wu. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Ama amik ka hwikii ge, mbala̱n a dla̱m mas byas ilgwe sa̱ dla̱m wu ten cin ga̱ ayo cin kisti ga̱ɓa. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Sa kisik ga̱ɓa ten ilgwe ka̱ dla̱m wu, gon a ilgwe ka̱ dla̱m laki aka̱ ni ɗe ma̱n pa̱lti wul ndakce sogo ma̱n pa̱lti byas wul.&gt;&gt;<verse eid="MAT 12:37" /></para>
  <para style="s">Lal ga̱ Yona</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Yek ma̱n Paresi suk ma̱n yisti Mba̱t Ga̱ɓa ga̱ Musa jon wulti ɗe, &lt;&lt;Ma̱n lishti, ma̱ na̱ma lamti ta̱k pa̱lini wul ngipti bi ang gwe a mbok ang ɗe ki wo sut mal Nya ka̱n ka̱ ni wu.&gt;&gt;<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Yek ta̱ ballisi ɗe, &lt;&lt;Byas mbala̱n ji ase ma̱n la̱shi pa̱lti gem na̱ma lamti yenti wul ngipti bi ang gwe a da̱misi ɗe lal wu, ama sa zisi lal gon so, seko wunda̱l lal ga̱ Yona ma̱n dla̱mti ga̱ɓa ga̱ Nya wu. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Na̱k kangwe Yona pa̱l multi ɗe mekan cin suk gasi ka̱ tuk ga̱ bal kwes wu, na̱k gwisi ka̱n Yen ga̱ Mbala̱n a mul ɗe mekan cin suk gasi ga̱ leɓi ka̱ atli. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Ten cin ga̱ ayo ma̱n Neniba a tlinya suk mbala̱n ji se ta̱s mbokisi ang ɗe sa̱ pa̱l ilgwe ba̱ yek sowu. Na̱k ɗe ma̱n Neniba ci atl gaa ten byas wul gwasa̱n na̱ kumti dla̱mti ga̱ɓa ga̱ Yona, ama ma̱lgwe nal man Yona wuggu! <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Ten cin ga̱ ayo Guu ga̱ Ma̱dli Sheba a tlinya suk mbala̱n ji se ta̱s mbokisi ang ɗe sa̱ pa̱l ilgwe ba̱ yek sowu. Ten ɗe ta̱ tli tet ka̱ dlenti lu ta̱s kati ka̱ng wunda̱l ga̱ ɓotlka̱n yisti ga̱ɓa ga̱ Sulemanu guu, ama ma̱lgwe nal man Sulemanu wuggu!<verse eid="MAT 12:42" /></para>
  <para style="s">Pa̱lti ga̱ byas ma̱zhe</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />&lt;&lt;Kume byas ma̱zhe yil ɗa̱ka̱ mbala̱n ka̱wu, ata̱ ngusi matlti ɗa̱nka̱ lu jwe ze ni ɗa̱ sowu ten ngot lu gwe ta shuk wu ama a ba̱ta mbi so. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Apaa ata̱ wul gaa gwas ɗe, &lt;Ba pal teka̱ lubii gwe a zaki wu ka.&gt; Kume ta̱ pali yek ta̱ mbi lubiimi go sa̱ taasi ka yek sa̱ la̱ka̱mi ka a ba̱ ma̱lgon ni giɓi sowu. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Ta sak mbe byas ma̱zhe jwe ngalci manti wu ɗe nitgi teɗi, asa̱ sak da̱m giɓi. Ka̱ kaali wo a da̱mti ga̱ ma̱li lil man kangwe ta̱ni tek wu. Na̱k gwisi ka̱n a pi na̱ byas mbala̱n ji ase.&gt;&gt;<verse eid="MAT 12:45" /></para>
  <para style="s">Ana ga̱ Yesu suk yilkeni jwas tul malti</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Ata̱ yima hwit ga̱ɓa mbala̱n jwe mo gaa wu nu wugo, yek ana gwas suk yilkeni jwas tuli yek sa̱ dla̱l a deɓa̱l, sa̱ na̱ma lamti ta̱s ga̱ɓa sukti. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Yek ma̱lgon wulti ɗe, &lt;&lt;Ana gwa ka̱wu suk yilkeni jwa a deɓa̱l, sa̱ na̱ma lamti ta̱s ga̱ɓa sukki.&gt;&gt;<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />Yek ta̱ ballit ɗe, &lt;&lt;Wok ɗe ana gi suk yilkeni ji wo?&gt;&gt; <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Yek ta̱ mbok ang ten mil lishti jwasi, yek ta̱ dla̱m ɗe, &lt;&lt;Ana gi suk yilkeni ji ka̱wu aɗe. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Mas ma̱lgwe pa̱l ilgwe Aba gi gwe ni to nya ka̱wu lami wu, ma̱li ka̱ɗe ana gini a tik ɗe yilka gini ga̱ maani suk ga̱ modli.&gt;&gt;<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Cinga̱lti ga̱ɓa na̱ ma̱n ɓakti zhin</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Yek Yesu yil ɗa̱ka̱ lubiimi ka ten cin jwisi, yek ta̱ sak da̱m ten bi bal ze. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Yek mbala̱n ngusi motgaa malti hal yek sa̱ luk lakti dlo se na̱k ta̱ sak te ka̱ jirgi ze yek ta̱ da̱m giɓi, a mbala̱mi ni ten bicikɗi. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Yek ta̱ hwisi ga̱ɓa wonti na̱ cinga̱lti ga̱ɓa, yek ta̱ dla̱m ɗe, &lt;&lt;Ma̱n kolti zhin gon yil ɗe ta la ɓakti zhin gwasi. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Ta̱ na̱ma catti wunda̱l gwas nugo, yek jon lok ten tantu yek yadl sak ɗaka̱mi ka. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Yek wunda̱li jon lok ka̱ gacal, lu gwe ba̱ atl ni ka̱li i'e sowu. Yek te ba̱le-ba̱le na̱k ɗe atl nal ka̱li sowu. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Ama ɗe cin mat wugo yek ilgwe sa̱ ɓak wu lada̱l ka yek nko ka, na̱k ɗe tla̱lki nisi ɗa i'e sowu. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Wunda̱li jon lok ka̱ lu gwe il ni ka̱li wu, yek ili kiɗi yek ngip ilgwe sa̱ ɓak wu ka. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Yek jon lok ka̱ hwa lu, yek ilgwe sa̱ ɓak wu pa̱l gwe i'e. Jon wo ɗe zaba̱l, jon wo ɗe kutl ɗe mukka a jon wo ɗe kutl ɗe mekan. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Ma̱lgwe ka̱ng kumti niɗɗa̱ go, ta̱s kum ga̱ɓa ga̱mi.&gt;&gt;<verse eid="MAT 13:9" /></para>
  <para style="s">Ilgwe laki a Yesu hwi ga̱ɓa mbala̱n na̱ cinga̱lti ga̱ɓa wu</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Yek mil lishti jwas tul malti yek sa̱ ngemti ɗe, &lt;&lt;Yek laki aka̱ hwi mbala̱n ga̱ɓa na̱ cinga̱lti ga̱ɓa ye?&gt;&gt;<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Yek ta̱ ballisi ɗe, &lt;&lt;Nya ba̱lkii yisti wul ga̱ hwunda̱li gwe ni guu ga̱ Nya wu, ama si wo sa̱ ba̱lsi so. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Mas ma̱lgwe wul niɗɗa̱ go, sa mba̱lit ɗa, kangwe wul a nit ɗa nal wu. A mas ma̱lgwe wul niɗɗa̱ sowu, naki gwe niɗɗa̱ wu mago sa kamit ka. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Ilgwe laki a dla̱mti wul na̱ cinga̱lti ga̱ɓa go yek ɗe,</para>
  <para style="q1" vid="MAT 13:13">&lt;&lt;Ko ta̱s kusi, sa yenni so,</para>
  <para style="q2" vid="MAT 13:13">Ko ta̱s ka̱t ka̱ng sa kumi, a ba̱sa yis gaami so.<verse eid="MAT 13:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14" />Gem ilgwe Ishaya ma̱n dla̱mti ga̱ɓa ga̱ Nya dla̱m tensi wu njika̱n wi, ɗe ta̱ wule</para>
  <para style="q1" vid="MAT 13:14">&lt;&lt; &lt;Kaa ngusi kumti ga̱ɓa, ama kaa yis gaa ga̱ ilgwe ka̱a̱ kumi wu so</para>
  <para style="q2" vid="MAT 13:14">Kaa ngusi yenti wul, ama kaa yis ilgwe ka̱a̱ yenni wu so.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Na̱k ɗe mas jwasa̱n mbadl ka̱nga̱lisi ka̱wu,</para>
  <para style="q2" vid="MAT 13:15">Ba̱ ka̱ng gwasa̱n a kum ga̱ɓa so,</para>
  <para style="q2" vid="MAT 13:15">a yekgu sa̱ yitla gwel gwasa̱n ka̱wi.</para>
  <para style="q1" vid="MAT 13:15">Sa lak yen wul na̱ gwel gwasa̱n,</para>
  <para style="q2" vid="MAT 13:15">sa lak kum ga̱ɓa na̱ ka̱ng gwasa̱n.</para>
  <para style="q2" vid="MAT 13:15">Ten ɗe ba̱ mbadl gwasa̱n yis gaami so</para>
  <para style="q2" vid="MAT 13:15">hal asa̱ pal tet mala̱nni</para>
  <para style="q2" vid="MAT 13:15">ten ɗe ta ndoksi.&gt;<verse eid="MAT 13:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />Ama kii wo ma̱n albarka ka̱n, na̱k ɗe a gwel gwaka̱n yen wul a ka̱ng gwaka̱n kum ga̱ɓa wu. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Gem amik ka hwikii ge, ma̱n dla̱mti ga̱ɓa ga̱ Nya suk mbala̱n ma̱n pa̱lti wul ndakce wonti lami ta̱s yen ilgwe ka̱a̱ na̱ma yenti wu, ama yek ba̱sa̱ yeni so. Asa̱ lami ɗe ta̱s kum ga̱ɓa gwe ka̱a̱ na̱ma kumti wu ama yek ba̱sa̱ kumi so.<verse eid="MAT 13:17" /></para>
  <para style="s">Ilgwe cinga̱lti ga̱ɓa na̱ ma̱n ɓakti zhin na̱ma mbokti ang dani wu</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />&lt;&lt;Kati ka̱ng ilgwe cinga̱lti ga̱ɓa na̱ ma̱n ɓakti zhin na̱ma mbokti ang dani wu. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Kume mbala̱n kum ga̱ɓa ten guumi yek ba̱ta̱ yis gaa ga̱ ilgwe ga̱ɓe dla̱m wu sowu, a sheɗan tulli ata̱ yem ga̱ɓe ɗa̱ka̱ mbadl ga̱ ma̱li ka. Gwisi ka̱ɗe wunda̱l gwe lok ten tantu wu. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Wuda̱li gwe lok ka̱ gacal go, yek ɗe ma̱lgwe kum ga̱ɓe wugo ata̱ nda̱ki ba̱le-ba̱le na̱ hwol tuk wu. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Ama na̱k ɗe ga̱ɓe lak kiɗi tla̱lki ka̱ mbadl gwas sowu, ba̱ ga̱ɓe a dla̱l ka̱ti so, ka̱ sa'i hwottidli suk bomti tul ten bi ga̱ɓe wugo ata̱ pal na̱ kaali ba̱le-ba̱le. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Wuda̱li jwe lok ka̱ ili go, yek ɗe mbala̱n jwe asa̱ kum ga̱ɓe, ama a hwottidli ga̱ dii atl ge suk laamti wulpi laki a ba̱ ga̱ɓe a nali ta̱ wut mil so. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />A wunda̱li jwe lok ka̱ hwa lu go na̱k mbala̱n jwe sa̱ kum ga̱ɓe yek sa̱ yis gaami wu ka̱n. A ga̱ɓe laksi ten wutti mil jwe wonta̱t ji jon la zamba̱l, jon wo kutl ɗe nitgi, a jon wo kutl ɗe mekan.&gt;&gt;<verse eid="MAT 13:23" /></para>
  <para style="s">Cinga̱lti ga̱ɓa na̱ ɓakti byas alkama ka̱ zhin</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Yek Yesu cinga̱ltisi ga̱ɓa gon ɗa, yek ta̱ dla̱m ɗe, &lt;&lt;Guu ga̱ Nya wo na̱k ma̱lgon gwe ɓak hwa wunda̱l alkama ka̱ zhin gwas wu ka̱n, <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />yek gas gon ka̱ gasi a mbala̱n ni atli yek yela̱n dlanti gwas sak ɓak byas wunda̱l alkama ka̱ zhimi yek paa ta̱ zigaa ilgon gwasi. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Ɗe hwa alkame tlal ɗe mbutl gaa wu, yek byas alkame tlal pak.<verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />&lt;&lt;Yek zhel ji ma̱li li tet malti yek sa̱ wulti ɗe, &lt;Bagaa, a wule hwa wunda̱l alkama ka̱n ka̱ ɓak ka̱ zhin gwa wu na̱? Yek ɗa̱ nii ka̱n byas alkama yil tot giɓi gwi?&gt;<verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />&lt;&lt;Yek ta̱ wulsi ɗe, &lt;Yela̱n dlanti gi ka̱ sak ɓaki.&gt;</para>
  <para style="p" vid="MAT 13:28">&lt;&lt;Yek zheli wulti ɗe, &lt;Ka̱ lami ɗe ta̱n sak ndus byas alkame ɗa̱ka̱ zhimi ka?&gt;<verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />&lt;&lt;Yek ta̱ wulsi ɗe, &lt;Wowo, gon a ten ndusti byas alkame ka, aka̱a̱ lak ndus hwaɓi jon ka. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Zaka̱nsi ta̱s kiɗi ka̱ lu ɗe na̱m hal se ka̱ gisi. Kume sa'i tloti ɓal go ba hwi ma̱n tloti ɗe, tlo byas alkame ka aka̱a̱ ɓal na̱ zaa, gaami-gaami aka̱a̱ kweli ka, apaa ka̱a̱ mo hwa alkame a ka̱a̱ wut ka̱ nhu gini.&gt; &gt;&gt;<verse eid="MAT 13:30" /></para>
  <para style="s">Cinga̱lti ga̱ɓa na̱ gwe mastat</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Yek Yesu po cinga̱lisi ga̱ɓa gon ɗa, yek ta̱ wulsi ɗe, &lt;&lt;Guu ga̱ Nya wo na̱k gwe mastat gwe ma̱lgon kaami yek ta̱ ɓak ka̱ zhin gwas wu ka̱n. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Ko ɗe gwe mastat wo nda nak'eni man mas gwe wullu, ama kume tlindi gwas nallu go a da̱m ɗe bal tlindi man mas naa tlindi a yatl lak bii gwasa̱n ka̱ mil ami.&gt;&gt;<verse eid="MAT 13:32" /></para>
  <para style="s">Cinga̱lti ga̱ɓa na̱ yiis</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Yek ta̱ hwisi cinga̱lti ga̱ɓe gon ɗa yek ta̱ dla̱m ɗe, &lt;&lt;Guu ga̱ Nya wo na̱k yiis gwe kili gon lak ka̱ apti gal cinga̱lti ɗe mekan, yek ta̱ ngusi wuti hal yek yiisi ngashi wu ka̱n.&gt;&gt;<verse eid="MAT 13:33" /></para>
  <para style="s">Yesu ga̱ɓa na̱ cinga̱lti ga̱ɓa</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Yesu hwi mbala̱n wul jin mas na̱ cinga̱lti ga̱ɓa, ba̱ta dla̱misi ilgon ba cinga̱lti ga̱ɓa so. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Na̱ nu ka̱n ta̱ njika̱n ilgwe Ishaya ma̱n dla̱mti ga̱ɓa ga̱ Nya dla̱m wu gwe wule,</para>
  <para style="q1" vid="MAT 13:35">&lt;&lt;Ba ɓul bi gini a hwisi wul na̱ cinga̱lti ga̱ɓa,</para>
  <para style="q2" vid="MAT 13:35">Ba hwisi wul jwe ni ga̱ hwunda̱li ka tun tet ten lakti zhila dii atl wu.&gt;&gt;<verse eid="MAT 13:35" /></para>
  <para style="s">Ilgwe cinga̱lti ga̱ɓa na̱ ma̱n ɓakti zhin na̱ma mbokti ang dani wu</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Yek Yesu zak lu gwe wonti mbala̱mi ni wu, yek ta̱ te giɓ boo. Yek mil lishti jwas te malti yek sa̱ wulti ɗe, &lt;&lt;Ɓo hwini ilgwe cinga̱lti ga̱ɓa ten byas alkama ka̱ zhin na̱ma mbokti ang dani wu.&gt;&gt;<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Yek ta̱ wulsi ɗe, &lt;&lt;Yen ga̱ mbala̱n ka̱ɗe ma̱n ɓakti hwa wunda̱l alkama ka̱ zhimi, <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />a dii atl ka̱ɗe zhimi, hwa wunda̱l alkame ka̱ɗe mil guumi, byas alkame ka̱ɗe mil ji Ma̱n Ngalci, <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />a yela̱n dlantisi ɗe ta̱ ɓak byas alkame wu ka̱ɗe Ibilis. Wotlti zhimi ka̱ɗe pakti ga̱ dii atli, a man wotlti zhimi ka̱ɗe mil shinti ji Nya.<verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />&lt;&lt;Na̱k kangwe asa̱ mo byas alkama asa̱ kweli ka na̱ wutu wu, na̱k gwisi ka̱n sa pa̱li ka̱ pakti ga̱ dii atli. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Yen ga̱ Mbala̱n a shin mil shinti jwasi asa̱ mo wul jwe a lak mbala̱n ten pa̱lti byas wul wu suk mas ma̱n pa̱lti ngalci, asa̱ mbolsi ɗa̱ka̱ guu gwas ka. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />A paa asa̱ wutsi su ka̱ buu wutu ma̱n cicit ka, ka̱li ka̱n sa kuli asa̱ na̱ma asti ang bi. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Ka̱ sa'i gwisi ka̱n ma̱n pa̱lti wul ndakce a cil na̱k cin, ka̱ guu ga̱ Aba gwasa̱n. Ta̱ mas ma̱n ka̱ng kumti kum ga̱ɓa ga̱n.<verse eid="MAT 13:43" /></para>
  <para style="s">Cinga̱lti ga̱ɓa na̱ zok wul ang gwe ni hwunda̱li ka</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />&lt;&lt;Guu ga̱ Nya wo na̱k zok wul gwe sa̱ hwunda̱li ka ka̱ zhin wu ka̱n, gwe ɗe ma̱lgon te dani wu yek ta̱ po hwunda̱li ka̱ ɗa. Ten bi hwol tuk gwasi yek ta̱ wul mas wul jwas ka yek ta̱ sak wul zhimi na̱ wulpi.&gt;&gt;<verse eid="MAT 13:44" /></para>
  <para style="s">Cinga̱lti ga̱ɓa na̱ zok mbuni ye</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />&lt;&lt;Guu ga̱ Nya wo na̱k wule ma̱n wulti wul ka, gwe na̱ma ngot zok mbuni ye, <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />yek ma̱li mbi zok ye gon ma̱n mbunti i'e, yek ta̱ sak wul mas wul jwas ka yek paa ta̱ wul yesi na̱ wulpisi.<verse eid="MAT 13:46" /></para>
  <para style="s">Cinga̱lti ga̱ɓa na̱ dipti ze</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />&lt;&lt;Guu ga̱ Nya wo na̱k wul dipti ze gwe sa̱ lak ka̱ bingi ze yek dop wunda̱l kwes wonti, <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />ɗe njika̱n wugo, yek ma̱n dopti kwesi dla̱k wul dipti zesi to ten bicikɗi ka. Yek sa̱ da̱m na̱ zhila yek sa̱ ɗaka̱m hwa kwesi yek sa̱ mosi ka̱ ga̱ɗa, ama byas kwesi wo yek sa̱ wut ka. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Na̱k gwisi ka̱n sa pa̱li ten pakti ga̱ dii atli, mil shinti ji Nya a tuli asa̱ hwul dlo ga̱ ma̱n pa̱lti wul ndakce suk ma̱n ngalci <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />asa̱ wut ma̱n ngalci ka̱ buu wutu ma̱n ciciti, ka̱li ka̱n sa kuli asa̱ na̱ma asti ang bi.&gt;&gt;<verse eid="MAT 13:50" /></para>
  <para style="s">Cinga̱lti ga̱ɓa na̱ gus wul ang suk pyali</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Yek Yesu ngemsi ɗe, &lt;&lt;Ka̱a̱ yis gaa ga̱ wul jin mas a?&gt;&gt;</para>
  <para style="p" vid="MAT 13:51">Yek sa̱ ballit ɗe, &lt;&lt;Yii Bagaa.&gt;&gt;<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Yek ta̱ wulsi ɗe, &lt;&lt;Ten na̱k gwisi ka̱n, ma̱n lishti Mba̱t Ga̱ɓa ga̱ Musa gwe da̱m ɗe yen lishti ka̱ guu ga̱ Nya go, na̱k ba boo gwe ata̱ yilli pyal wul suk gus wul tot ka̱ bii wul ang gwas wu ka̱n ta̱ni.&gt;&gt;<verse eid="MAT 13:52" /></para>
  <para style="s">Sa̱ nge Yesu a Nazarat</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Ɗe ta̱ pak dla̱mti cinga̱lti ga̱ɓa jin wugo, yek ta̱ zak luisi. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Yek ta̱ pal ba̱n gwasi yek ta̱ njeli mbokti ang mbala̱n ten ga̱ɓa ga̱ Nya ka̱ lu motgaa gwasa̱n yek mbala̱mi ngip bi ka̱ ang. Yek sa̱ ngusi dla̱mti ɗe, &lt;&lt;A ako ka̱n ma̱lga̱n mbi wunda̱l ɓotlka̱n yis wul jin, suk iko pa̱lti wul ngipti bi ang ga̱n ko? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Ale tik ɗe yen ga̱ kapinta wu na̱? ale gasa̱l gwas ka̱ɗe Maryam na̱? A yilkeni jwas ka̱ɗe ka̱a̱ Yakubu, suk Yusupu, suk Siman suk Yehuda na̱? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />A yilkeni jwas ji ma̱dli mago sa̱ na̱n ɗe sa? Tet ako ka̱n ma̱lga̱n mbi mas wul jimi ko?&gt;&gt; <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Yek mbadl lilisi na̱ ti.</para>
  <para style="p" vid="MAT 13:57">Yek Yesu wulsi ɗe, &lt;&lt;Asa̱ ba̱l nalti ma̱n dla̱mti ga̱ɓa ga̱ Nya ko ako, ama ka̱ ba̱n gwasi suk lubii gwas wo ba̱sa ba̱lti nalti so.&gt;&gt;<verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />Na̱k ɗe sa̱ nga̱ssi tenti sowu, yek ba̱ta̱ pa̱l wul ngipti bi ang ka̱li i'e so.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Ma̱shka̱n ga̱ Yohana ma̱n baptisma</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Ka̱ multi jwisi yek Hiridus Antipas guu kum ga̱ɓa ten Yesu. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Yek ta̱ wul ma̱jwe asa̱ pa̱lit wullu ɗe, &lt;&lt;Ma̱lga̱n co Yohana ma̱n baptisma ka̱n Nya palla̱t kaami! Yek laki yek iko pa̱lti wul ngipti bi ang nit ɗa na̱k gwisi.&gt;&gt;<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Tek go a Hiridus laki yek sa̱ dop Yohana yek sa̱ ɓalti, yek sa̱ let ka ten bi ga̱ Hirodiya, kili ga̱ Pilip yilka gwas wi. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Na̱k ɗe a Yohana kul hwi Hiridus ɗe, &lt;&lt;Mbun ɗe ta̱k kan Hirodiya ɗe kili gwa so!&gt;&gt; <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Hiridus lami ɗe ta̱s tlo Yohana ka, ama yek ɓanti ga̱ mbala̱n citi, na̱k ɗe sa̱ kan ɗe Yohana wo ma̱n dla̱mti ga̱ɓa ga̱ Nya ka̱ɗe ti wu.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Ama yek cin za̱t ga̱ Hiridus balla̱t tet wu go, yek yen kili ga̱ Hirodiya dlal a cina ga̱ ma̱nda̱ki jwe tul ka̱ biki hwol tukisi, yek dlaltisi ta̱mit ɗa i'e <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />yek Hiridus mo ga̱ɓa na̱ Nya yek ta̱ pa̱lit alkawol ɗe ta balti mas ilgwe ta̱ ngemi wu. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Yek ana gwas hwit ilgwe ta ngemi wu, yek yen kilisi wul Hiridus ɗe, &lt;&lt;Ba̱la̱n gaa ga̱ Yohana ma̱n Baptisma aɗe ka̱ gali nige-nige!&gt;&gt; <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Yek ga̱ɓe hwot guumi i'e, ama na̱k ɗe ta̱ mo ga̱ɓa na̱ Nya, a ma̱nda̱ki jwas ka̱ ju ka̱li wu, yek ta̱ dla̱m ɗe ta̱ ba̱lti ilgwe ta̱ lami wu. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Yek ta̱ shinlu yek sa̱ kotli gaa Yohana ka ata̱ ni ga̱ le ka, <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />yek sa̱ tulli gaami ka̱ gali yek sa̱ ba̱l yen kilisi, yek ta̱ ta̱le gasa̱l gwasi. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Yek mil lishti ji Yohana sak kan dli gwasi yek sa̱ lepti ka, Yek pa sa̱ sak hwi Yesu ilgwe pi wu.<verse eid="MAT 14:12" /></para>
  <para style="s">Yesu ba̱l mbala̱n zangu ɗe namtan ilga̱ nguki</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Ɗe Yesu kum ilgwe pi wugo, yek ta̱ te ka̱ jirgi ze, yek ta̱ li ka̱ lu gwe mbala̱n ni ɗa̱ sowu ta̱s da̱m na̱ ngus ɗa. Ama yek mbala̱mi kum lu gwe ta̱ ni wu, Yek sa̱ zak ba̱n jwasa̱n yek sa̱ kopti ten asa̱n. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Ɗe Yesu yil ɗa̱ka̱ jirgi ze ka̱ wu, yek ta̱ yen motgaa ga̱ wonti mbala̱n, yek ta̱ yen gonti jwasa̱n yek ta̱ ndok ma̱jwe dli ta̱misi bi sowu.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Sukti pi wugo, yek mil lishti jwas tul malti yek sa̱ wulti ɗe, &lt;&lt;Sukti ka̱ ɓali, a lu ge go lubii ni ɗa̱ ka̱li so. Palli bi mbala̱mi ta̱s li ɗa̱nka̱ mil ba̱n jwe ni njaa wu ka, ta̱s wuli gaa gwasa̱n ilga̱ nguki ɗa.&gt;&gt;<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Yek Yesu wulsi ɗe, &lt;&lt;Ni ngetli ɗe ta̱s zigaa so. Ba̱la̱nsi ilgon ta̱s nguki.&gt;&gt;<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Yek sa̱ ballit ɗe, &lt;&lt;Ilgon nini ang aɗe so, se nak ba̱redi ɗe namtan suk kwes ɗe lop.&gt;&gt;<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Yek ta̱ wulsi ɗe, &lt;&lt;Ta̱leni nini teɗi.&gt;&gt; <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Yek ta̱ wul mbala̱mi ɗe ta̱s da̱m na̱ zhila ten me. Yek ta̱ kan ba̱redi ɗe namtami suk kwes ɗe loɓi yek ta̱ lak gaa nya, yek ta̱ pa̱l hwol tuk na̱ Nya yek ta̱ cac-cal ba̱redisi. Yek pa ta̱ ba̱l mil lishti jwasi yek sa̱ ngusi ba̱lti mbala̱n. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Yek mas mbala̱mi nguki yek kumsi. Yek mil lishtisi mo losa̱li jwe sa wu, hal yek njika̱n ga̱ɗa ɗe kutl cet lop. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Wonta̱t ga̱ ma̱jwe nguk wu, pa̱l mani ɗe zangu namtan ba̱n na̱ modli suk mil mbala̱n.<verse eid="MAT 14:21" /></para>
  <para style="s">Yesu li na̱ asa̱n ten gaa ze</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Sa̱ na̱ma pakti, yek Yesu laki yek mil lishti jwas te ka̱ jirgi ze yek sa̱ ndet cina ten la̱t tu ten ka̱ti gon ga̱ zesi, a ti gaa gwas wo ta̱ yima palla̱t bi motgaa wonti mbala̱mi. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Ta̱ pallisi bi paki wu yek ta̱ to ten za̱nda̱l tla̱nda̱l ta̱s ngem Nya. Hal yek sukti luk pi ata̱ yi ka̱li ti na̱ ngusi. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Ama a jirgi ɓal teka̱ dlo bal ze ka, a kapsi ze na̱ma jekti ga̱ jirgi ɗa̱n ka na̱k ɗe yeta̱l na̱ma wulti tet tu cina ga̱ jirgi wu.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />Yek Yesu li malsi na̱ asa̱n ten gaa zesi ka̱ bultlwe ga̱ cina. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Mil lishtisi yenti ten la̱t na̱ asa̱n ten gaa ze wugo yek ɓanti cisi. Yek sa̱ wuli ɗe, &lt;&lt;Gu co lul ka̱n!&gt;&gt; Yek sa̱ lak yal na̱ ɓanti.<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Yek Yesu ga̱ɓesi yek ta̱ wulsi ɗe, &lt;&lt;Ba̱ ilgon hwotkii so! Ami ka̱n, ba̱ ɓanti cikii so!&gt;&gt;<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Yek Biturus wulti ɗe, &lt;&lt;Bagaa, kume kik go, wula̱n ɗe ta li tet malki ten gaa zesi.&gt;&gt;<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Yek ta̱ wulti ɗe, &lt;&lt;Li teɗi.&gt;&gt;</para>
  <para style="p" vid="MAT 14:29">Yek Biturus yil ɗa̱ka̱ jirgi ka, yek ta̱ njel la̱t mal Yesu ten gaa zesi. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Ama ɗe Biturus kum nda̱lti ga̱ yeta̱li wu, yek ɓanti njel cit gwasi yek ta̱ njel sut ga̱z gaa ze. Ɗe ta̱ ɓa su ga̱z gaa ze wu, yek ta̱ lak yal, yek ta̱ wuli ɗe, &lt;&lt;Kisa̱n ne, Bagaa!&gt;&gt;<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Yek Yesu tak ang gwasi ba̱le-ba̱le yek ta̱ ngiɓit ang yek ta̱ da̱lti toɗi, yek ta̱ wulti ɗe, &lt;&lt;Ki ɗe ba̱ nga̱sti ten Nya gwa nda̱l sowu, yek lakki ten celti ka̱ mbadl ye?&gt;&gt;<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Yek sa̱ te ka̱ jirgi mas jwasa̱n, yek paa yeta̱li mul atli. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Yek ma̱jwe sa̱ ni ka̱ jirgi wu ngusit atli, asa̱ na̱ma wulti ɗe, &lt;&lt;Gem ka̱n, yen ga̱ Nya ka̱ɗe ki!&gt;&gt;<verse eid="MAT 14:33" /></para>
  <para style="s">Yesu ndok mbala̱n ka̱ ka̱t atl ga̱ Genisarat</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Ɗe sa̱ ɗakci bal zesi wugo yek sa̱ yil to ten bi cikɗi gwe ni njaa mal atl ga̱ Genisarat wu ka. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Ma̱n ba̱mi yisi ɗe Yesu ka̱ɗe gwisi wu, yek sa̱ shini lu mas mbala̱n jwasa̱n, yek mbala̱mi tulli mas mbala̱n jwasa̱n jwe dli ta̱misi bi sowu malti, <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />yek sa̱ ngemti ɗe ta̱s nak ta̱n ko ta̱ bi luka̱l gwas ne, yek mas ma̱jwe ta̱ni wu mbi ndokti.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">Ilgwe a bacina ji ma̱n Yehuda pa̱li wu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Yek ma̱n Paresi suk ma̱n yisti mba̱t ga̱ɓa ga̱ Musa jon tet Wurshelima tul mal Yesu yek sa̱ ngemti ɗe, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />&lt;&lt;Yek laki a mil lishti jwa nge kopti wul jwe a kiɗi jina̱n pa̱li wu ye? Ɗe si wo ba̱sa pol ang ka̱ pa so, ɗe sa̱ ɓa nguk wullu!&gt;&gt;<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Yek Yesu wulsi ɗe, &lt;&lt;A kii, yek laki ɗe aka̱a̱ cel mba̱t ga̱ɓa ga̱ Nya ka, ten bi pa̱lti wul jwaka̱n ye? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Ai Nya dla̱ma̱n ɗe, &lt;Ta̱ mbala̱n ba̱l nalti aba suk ana gwasi,&gt; a &lt;ma̱lgwe byal aba, sogo ana gwas go, ngetli ka̱n ta̱ tlot ka.&gt; <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Ama kii wo aka̱a̱ mboki ang mbala̱n ɗe, kume ilgon ni mbala̱n ɗa gwe ta ba̱l aba sogo ana gwasi ten ɗe ta̱s zisi ang wu ni ma̱li ngetli ɗe ta̱s zisi ang so, ten ɗe ta manisi wulti ɗe &lt;Mas ilgwe gwe a lamikii ba̱lti go, a pa̱l alkawol wi ɗe ba ba̱l Nya.&gt; <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Na̱k gwisi mbok ang ɗe, po yi ma̱li ngetli ɗe ta̱s ba̱l nalti aba suk ana gwas so.<note caller="+" style="f"><char style="fr" closed="false">15:6 </char><char style="ft" closed="false">Ka̱ lishtisi jon wo sa̱ lishi ɗe</char><char style="fqa" closed="false">Aba sogo ana gwasi</char></note> Na̱ pa̱lti wul gwaka̱n na̱k gwisi ka̱n ka̱a̱ palli ga̱ɓa ga̱ Nya ten koo lu. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Kii ma̱n pa̱lti riya! Ilgwe Ishaya ma̱n dla̱mti ga̱ɓa ga̱ Nya dla̱m tenkii ni ndakce gwe wule!<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />&lt;&lt; &lt;Na̱ kul bi ka̱n a mbala̱n jin ba̱la̱n nalti,</para>
  <para style="q2" vid="MAT 15:8">ama mbadl jwasa̱n dlenti suk ami.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Ten koo lu ka̱n asa̱ ngusi atli,</para>
  <para style="q2" vid="MAT 15:9">asa mbok ang ten mba̱t ga̱ɓa ga̱ mbala̱n ɗe ga̱ɓa ga̱ Nya.&gt;<note caller="+" style="f"><char style="fr" closed="false">15:9 </char><char style="ft" closed="false">Yen<char style="xt"><ref loc="ISA 29:13">Ish 29:13</ref></char> </char></note>&gt;&gt;<verse eid="MAT 15:9" /></para>
  <para style="s">Ilgwe a lil mbala̱n ka̱wu</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Yek Yesu mbe mbala̱mi yek ta̱ wulsi ɗe, &lt;&lt;Kuma̱n ga̱ɓa ga̱n aka̱a̱ yis gaami! <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Ilgwe a su tu ka̱ bi wu ka̱ɗe ma̱n lilti ga̱ mbala̱n ka̱ so, ama ilgwe a yil tot tu ka̱ bi ga̱ mbala̱n wu ka̱ɗe ma̱n lilti gwas ka.&gt;&gt;<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Yek mil lishtisi tul malti yek sa̱ wulti ɗe, &lt;&lt;Ama ka̱ yisi ɗe ilgwe ka̱ dla̱m wu nda ma̱n Paresi mbadl a?&gt;&gt;<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Yek ta̱ ballisi ɗe, &lt;&lt;Mas ilgwe ba̱ Aba gini, gwe ni Nya wu ka̱ ɓak sogo sa tus ɗa̱ ten zhila gwas ka. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Hwula̱nkii suksi, si wo dwa ka̱n, ama asa̱ nde dwa cina. A kume dwa ka̱ nde dwa cina go, mas jwasa̱n sa lok ka̱ shu.&gt;&gt;<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Yek Biturus wulti ɗe, &lt;&lt;Yillini gaa ga̱ cinga̱lti ga̱ɓa gwisi.&gt;&gt;<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />Yek Yesu wulsi ɗe, &lt;&lt;Ase hal ninge ka̱a̱ po yisa̱n gaami sa? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Ka̱a̱ ɓo yisi ɗe mas ilgwe a su tu ka̱ bi mbala̱n go ka̱ tuk ka̱n a su, apaa ka̱ kaali wo a yil ɗa̱ka̱ ma̱li ka̱sa? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Ama wul jwe a yil tot ka̱ bi go, wul jwe nit ka̱ mbadl wu ka̱n, a yek ɗe ma̱n lilti ga̱ mbala̱n ka. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Ten ɗe tot ka̱ mbadl ka̱n a byas daamti ngusi yilti. Wuda̱l ji tlot mbala̱n, suk lamti pa̱t pa̱la̱n, suk mas byas pa̱t suk modli, suk pa̱t muka̱l, suk shelti lal mbala̱n gaa, suk lil shin mbala̱n ka. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Wul jimi ka̱ɗe ma̱n lilti ga̱ mbala̱n ka, ama ngukti wul na̱ duu ang wo lil mbala̱n so.&gt;&gt;<verse eid="MAT 15:20" /></para>
  <para style="s">Nga̱sti ten Nya ga̱ kili gon</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Ɗe Yesu zak luisi wu yek ta̱ li ka̱ ka̱t atl ga̱ Taya suk Sidon. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Yek kili Kan'ana gon gwe ni ka̱li wu tul malti yek ta̱ tlil yal nya yek ta̱ wulti ɗe, &lt;&lt;Yen gonti gi ne, Bagaa yen ga̱ Dauda! Ma̱zhe jon na̱ma nolti ga̱ yen gini i'e.&gt;&gt;<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Ama yek ba̱ Yesu wulti ɗe ilgon so. Yek mil lishti jwas tul malti yek sa̱ ngemti yek sa̱ wulti ɗe, &lt;&lt;Mbol kili ga̱n ne, ten ɗe ta̱ na̱ma kopti ata̱ na̱ma hwotti ga̱na̱n na̱ tlilti yal nya.&gt;&gt;<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Yek ta̱ wulsi ɗe, &lt;&lt;Mal mba̱la ji Yisiraila jwe gil ju na̱ ngusa̱n ka̱n sa̱ shina̱nni.&gt;&gt;<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Yek kilisi sak ngus na̱ gahwula̱n a cina gwasi, yek ta̱ wulti ɗe, &lt;&lt;Zi ang ne, Bagaa!&gt;&gt;<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Yek ta̱ wulti ɗe, &lt;&lt;Mbun ɗe ta kan ilga̱ nguki ga̱ mil lubii a ba̱l kaɗi so.&gt;&gt;<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />Yek kilisi wulti ɗe, &lt;&lt;Go nu ka̱n, ama ai kaɗi nguk ilga̱ nguki gwe a yili baboo gwas ɗa̱ ang ka a nda sut ga̱s tebul wu.&gt;&gt;<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Yek Yesu wulti ɗe, &lt;&lt;Kili mbala̱n, nga̱ski ten Nya nda̱li! Ka̱ mbi ilgwe ka̱ ngemi wu wi.&gt;&gt; Yek yen ga̱ kilisi mbi ndokti na̱ dla̱mti gwas na̱k gwisi.<verse eid="MAT 15:28" /></para>
  <para style="s">Yesu ndok wonti mbala̱n</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Tet ka̱li go, yek Yesu koɓi tu bal ze ga̱ Galili. Yek ta̱ to ten tla̱nda̱l yek ta̱ da̱m na̱ zhila. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Mbala̱n wonti tul malti, sa̱ tulit kulki, suk dwa suk ma̱n gita suk bebe, suk naami jon wonti yek sa̱ wutsi atl a cina gwasi yek ta̱ ndoksi. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Yek mbala̱mi ngip bi ang ɗe sa̱ yen bebe ten ga̱ɓa, a ma̱n gita ndok wi, a kulki ɓa li na̱ asa̱n, suk dwa ten yenti lu wu. Yek sa̱ ta̱s Nya ga̱ ma̱n Yisiraila.<verse eid="MAT 15:31" /></para>
  <para style="s">Yesu ba̱l mbala̱n zangu ɗe wupsi ilga̱ nguki</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Yek Yesu mbe mil lishti jwasi yek ta̱ wulsi ɗe, &lt;&lt;A na̱ma yenti gonti ga̱ mbala̱n jin, sa̱ mul ɗe mekan aɗe mala̱n wi a ba̱sa̱ nguk ilgon so. A lamisi palla̱t bi asa̱ yi kuza̱mi so, ten ɗe gon asa̱ ngusi pa̱lti gwel ma̱shka̱n ten tantu na̱ kuza̱n.&gt;&gt;<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Yek mil lishtisi wulti ɗe, &lt;&lt;Ako ka̱n ma mbi ilga̱ nguki gwe a kum wonti mbala̱n jin ka̱ me ga̱n ko?&gt;&gt;<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Yek ta̱ ngemsi ɗe, &lt;&lt;Ba̱redi ɗe na̱mi ka̱ nikii ang?&gt;&gt;</para>
  <para style="p" vid="MAT 15:34">Yek sa̱ wulti ɗe, &lt;&lt;Ɗe mukka suk nak kwes jon.&gt;&gt;<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Yek ta̱ wul wonti mbala̱mi ɗe ta̱s da̱m atli. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Yek ta̱ kan ba̱redi ɗe mukke suk kwesisi yek ta̱ pa̱l hwol tuk na̱ Nya, yek ta̱ cac-cali yek ta̱ ba̱l mil lishtisi yek sa̱ ba̱l mbala̱mi. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Yek ko wokko nguki yek kumti. Ka̱ kaali yek mil lishtisi yem ga̱ɗa ɗe mukka ga̱ losa̱li gwe mbala̱mi zaki wu. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Wonta̱t ga̱ mani jwe nguk go sa̱ la zangu ɗe namtan ban na̱ modli suk mil mbala̱n. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Yesu palli bi wonti mbala̱mi wugo yek ta̱ te ka̱ jirgi ze yek ta̱ li ten ka̱t atl ga̱ Magadan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">Lamti yenti lali sut nya</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Yek ma̱n Paresi suk ma̱n Saduki jon tul mal Yesu, yek sa̱ ngemti ɗe ta̱s mbokisi ang ten lal gwe a mbok ang ɗe ti wo sut mal nya ka̱n ta̱ ni wu.<verse eid="MAT 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2" />Yek ta̱ nda̱kisi ɗe, &lt;&lt;Kume cin ɓa ndabi go, aka̱a̱ wule &lt;Ayo go lu a ta̱mi, dlo nya ka̱ zwila̱n wu.&gt; <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />A kume ka̱a̱ yen lu zwila̱n ka, ɗe nyaze na̱ma tlil tot na̱ gasi wo wugo aka̱a̱ wule, &lt;Ase go ze a nda.&gt; Ka̱a̱ yis wul jwe a pi ka̱ dlo nya wu, ama yek ba̱ka̱a̱ yis gaa ga̱ lal ji multi ga̱ se so. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Mbala̱n ji se wo byasi suk ma̱n la̱shi ngipti alkawol ka̱n, sa̱ na̱ma lamti ɗe ta̱s yen lali, ama ba̱sa mbokisi ang ten lal gon so se wunda̱l ga̱ Yona wu.&gt;&gt; Yek Yesu zaksi yek ta̱ zigaa.<verse eid="MAT 16:4" /></para>
  <para style="s">Tloka̱l mbokti ang ga̱ ma̱n Paresi suk ma̱n Saduki</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Sa̱ ɗakci bal zesi tu te duk wu, ase mil lishti jwas lak ma̱sa̱n yek ba̱sa̱ kan ba̱redi so. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Yesu wulsi ɗe, &lt;&lt;Pa̱n ɗem-ɗem na̱ yiis ga̱ ma̱n Paresi suk ma̱n Saduki.&gt;&gt;<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />Yek sa̱ ngusi ga̱ɓa ka̱ dlo gwasa̱n yek sa̱ dla̱m ɗe, &lt;&lt;Ilgwe laki yek ta̱ dla̱m nugo, na̱kka̱n ma̱ kama̱n ba̱redi ang so.&gt;&gt;<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Yesu yis ilgwe sa̱ na̱ma dla̱mti wu, yek ta̱ wulsi ɗe, &lt;&lt;Kii ɗe ba̱ nga̱sti ten Nya gwaka̱n nda̱l sowu! Yek laki yek ka̱a̱ na̱ma ga̱ɓa ten bi la̱shi ba̱redi ye? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Hal ase ka̱a̱ ɓo yis gaami sa? Kangwe a cal ba̱redi ɗe namtan yek mbala̱n ɗe zangu namtan nguk wu ma̱snikii ka̱wu nwa? Ga̱ɗa ɗe na̱mi ka̱n ka̱a̱ me ga̱ ilgwe ɗe sa wu? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Sogo ba̱redi ɗe nitgi gwe a ba̱l mbala̱n zangu ɗe wupsi yek sa̱ nguk wu. Ga̱ɗa ɗe na̱mi ka̱n ka̱a̱ me ga̱ ilgwe ɗe sa wu? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Yek laki ɗe yek ba̱ka̱a̱ yisi ɗe ten bi ba̱redi ka̱n a nikii ma ga̱ɓa so ye? Ai ilgwe a nikii ma hwiti go yek ɗe ta̱k hwula̱nkii na̱ yiis ga̱ ma̱n Paresi suk ma̱n Saduki.&gt;&gt; <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Yek pa sa̱ yis gaami ɗe ten bi yiis gwe asa̱ laki ba̱redi wu ka̱n ta̱ nisi ma ga̱ɓa so, ten ɗe ta̱s hwul gaa gwasa̱n na̱ mbok ang ga̱ ma̱n Paresi suk ma̱n Saduki ka̱n.<verse eid="MAT 16:12" /></para>
  <para style="s">Biturus dla̱m ɗe Yesu ka̱ɗe Almasihu</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Ɗe Yesu mbuki ten ka̱t atl ga̱ Kaisariya Pilibi wu, yek ta̱ ngem mil lishti jwas ɗe, &lt;&lt;Ɗe wok a mbala̱n mbe yen ga̱ mbala̱n wo?&gt;&gt;<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />Yek sa̱ wulti ɗe, &lt;&lt;A jon dla̱m ɗe Yohana ma̱n baptisma, jon wo asa̱ dla̱m ɗe Iliya, a jon wo asa̱ dla̱m ɗe Irimiya sogo gon ka̱ ma̱n dla̱mti ga̱ɓa ga̱ Nya.&gt;&gt;<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />Yek ta̱ ngemsi ɗe, &lt;&lt;A kii pa, ka̱ yenti gwaka̱n wo, wok ɗe ami wo?&gt;&gt;<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />Yek Biturus wulti ɗe, &lt;&lt;Kik ɗe Almasihu yen Nya gwe ni kaami wu.&gt;&gt;<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Yek Yesu wulti ɗe, &lt;&lt;Ki wo ma̱n albarka ka̱n, Siman yen ga̱ Yona. Ten ɗe mbala̱n ka̱ mbokik ang ten na̱k gwisi so, Aba gi gwe ta̱ ni to nya ka̱wu ka̱n. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Ama amik ka hwik ge, kik ɗe Biturus a ten ye ga̱n ka̱n ba kin motgaa ga̱ ma̱n kopti gini, iko ga̱ ma̱shka̱n a ci ba̱n ten mot gaami so. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Ba ba̱lki wul ɓulti dlabii ga̱ guu ga̱ Nya, mas ilgwe ka̱ ɓal ka ten dii atl go ta̱ ni ɗe ilgwe sa̱ ɓal ka a nya wu. A mas ilgwe ka̱ pa̱tl ka ten dii atl go ta̱ ni ɗe ilgwe sa̱ pa̱tl ka a nya wu.&gt;&gt; <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Yek Yesu da̱li ka̱ng mil lishti jwas i'e ɗe ba̱s hwi mbala̱n ɗe tik ɗe Almasihu so.<verse eid="MAT 16:20" /></para>
  <para style="s">Yesu dla̱m ga̱ɓa ten kangwe ma̱shka̱n gwas ani wu</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Kan tet ka̱ sa'i gwisi, yek Yesu nde hwit ga̱ɓa mil lishti jwas ten ɗe ngetli ka̱n ta̱s su Wurshelima ta̱s tla wonti bomti ka̱ ang ga̱ bacina ji ma̱n Yehuda suk kiɗi ma̱n Pa̱ris suk ma̱n yisti Mba̱t Ga̱ɓa ga̱ Musa, hal asa̱ tlot ka, ama ten cin na mekan wo ta pal kaami.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Yek Biturus mbet te malka̱mi ka yek ta̱ matlti yek ta̱ wulti ɗe, &lt;&lt;Nya a kan so, go ma̱n pa̱t tenki ka̱ so.&gt;&gt;<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Yek Yesu bala̱t tet tu malti yek ta̱ wulti ɗe, &lt;&lt;Hwulki suk ami Sheɗan. Ka laka̱n ten pa̱lti byas wul, na̱k ɗe pa̱lti wul ga̱ Nya nik mbadl so, se ga̱ mbala̱n wu.&gt;&gt;<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Yek Yesu wul mil lishti jwas ɗe, &lt;&lt;Mas ma̱lgwe a koɓa̱n go, ta̱s nge gaa gwasi ata̱ kan guda̱l yencin ɓakti gaa gwasi ata̱ koɓa̱nni. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Mas ma̱lgwe na̱ma lamti kisti mbadl gwas go ta mbi mbadli so, ama ma̱lgwe hwul na̱ mbadl gwas ten bi go ta mbi mbadli. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Yek ɗe ta̱mti ga̱ mbala̱n ye, ɗe ta̱ mbi mas wul ga̱ dii atli ge, ama yek ta̱ hwul suk mbadl gwas wu? Sogo yek mbala̱n a man ba̱lti ka̱ lal ga̱ mbadl gwas ye? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Yen ga̱ Mbala̱n a ya tul suk mil shinti jwasi ka̱ nalti ga̱ Aba gwasi ata̱ ɓatl mas mbala̱n, ta ba̱l ko wokko ten pa̱lti wul gwasi. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Gem, amik ka hwikii ge, ma̱jon ni ɗa a nya aɗe ka̱ kii, ma̱jwe sa ma̱sh so se sa̱ yen palti ga̱ Yen ga̱ Mbala̱n ka̱ iko guu gwas wu.&gt;&gt;<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Balla̱ti ga̱ dli ga̱ Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Kaal ɗa̱ multi ɗe mukka, yek Yesu kan Biturus suk Yakubu suk yilka ga̱ Yukubu gwe asa̱ mbet ɗe Yohana wu, yek sa̱ to ka̱ tlal tla̱nda̱l gon si na̱ ngusa̱n. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Sa̱ ni nu go, yek dli gwas balla̱ti asa̱ na̱ma yenti. Yek cina gwel gwas cil ka na̱k wule cin, yek luka̱l gwas hwoli ka pat. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Ba̱le-ba̱le yek ka̱a̱ Musa suk Iliya yilisi asa̱ na̱ma ga̱ɓa suk Yesu.<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />Yek Biturus wulti ɗe, &lt;&lt;Bagaa, mbun wi na̱k ɗe ma̱ ni ɗa aɗe wu, kume ta̱mik ɗa̱ go, ma lak bii bukka ɗe mekan, ɗe na̱m wo gwa, gon wo ga̱ Musa a gon wo ga̱ Iliya.&gt;&gt;<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />A ta̱ yima ga̱ɓa nugo, yek kaluntun ma̱n cilti gon yitlasi ka, yek sa̱ kum yal ga̱ɓa gon a giɓi ten wulti ɗe, &lt;&lt;Ga̱n go yen gi ka̱n a lamti, a na̱ma kumti ta̱mti gwas i'e. Katiti ka̱ng!&gt;&gt;<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Mil lishtisi kum ga̱ɓa gwisi wugo, yek sa̱ lok te atl ka na̱ ɓanti. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Yek Yesu ta̱nsi yek ta̱ wulsi ɗe, &lt;&lt;Tla̱nnya ka, ba̱ ɓanti cikii so.&gt;&gt; <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Sa̱ tlil gaa nya wugo, yek ba̱sa̱ po yen ma̱lgon so, se Yesu na̱ ngusi.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Sa̱ ɓa yil sut ɗa̱ka̱ tla̱nda̱li ka̱wu, yek Yesu hwisi ɗe, &lt;&lt;Ba̱k hwi ma̱lgon ilgwe ka̱a̱ yeni wu so, se Yen ga̱ Mbala̱n pal kaami tot ɗa̱ka̱ gazukɗi pa.&gt;&gt;<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Yek mil lishtisi wulti ɗe, &lt;&lt;Yek laki a ma̱n yisti mba̱t ga̱ɓa ga̱ Musa dla̱m ɗe se Iliya tul pa ye?&gt;&gt;<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Yek Yesu wulsi ɗe, &lt;&lt;Gem, Iliya a tuli ta̱s la̱ka̱n wul mas ɗa. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Ama amik ka hwikii ge Iliya tul wi yek ba̱ mbala̱n yisti so, yek sa̱ pa̱lit ilgwe sa̱ lami wu. A na̱k gwisi ka̱n Yen ga̱ Mbala̱n a tla bomti ka̱ ang gwasa̱n pak.&gt;&gt; <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Yek mil lishtisi yisi ɗe ta̱ nisi ma ga̱ɓa ten Yohana ma̱n Baptisma.<verse eid="MAT 17:13" /></para>
  <para style="s">Yesu ndok yen ma̱n maparpaɗa</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Sa̱ pal tet ka̱ mbala̱n wugo, yek ma̱lgon li tet ma̱l Yesu yek ta̱ ngus a cina ɗatka. <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />Yek ta̱ wulti ɗe, &lt;&lt;Bagaa yen gonti ga̱ yen gi ne. Cwo maparpaɗa nima cit gwasi ata̱ na̱ma tlat bomti i'e. A cwoɓi ngusi lakti gwas ka̱ wutu sogo ka̱ ze. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />A ta̱la̱t mal mil lishti jwa, ama yek ba̱sa̱ man ndokti gwas so.&gt;&gt;<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Yek Yesu wulsi ɗe, &lt;&lt;Kii mbala̱n ji se, ma̱jwe ba̱sa̱ ba̱l gem na̱ Nya sowu, asa̱ ka̱nga̱l mbadl jwasa̱n ka̱ wu! Hal a gasi ka̱n ba pita da̱mti sukkii gwi? Hal a gasi ka̱n ba ngusi dlot mbadl na̱kii gwi? Ta̱leni nini yeni teɗi.&gt;&gt; <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Yek Yesu matl ma̱zhesi yek ta̱ yil ɗa̱ka̱ yeni ka yek ta̱ ndoki ka̱li-ka̱li.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Yek mil lishtisi li mal Yesu ka̱ sa'i gwe mbala̱n po yi malti sowu yek sa̱ ngemti ɗe, &lt;&lt;Yek laki yek ba̱ma̱ man yilla̱t ga̱ ma̱zhesi ka̱ so ye?&gt;&gt;<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Yek Yesu wulsi ɗe, &lt;&lt;Ilgwe laki go, yek ɗe ka̱a̱ nga̱skii ten Nya i'e so. Gem amik ka hwikii ge, ɗe kume nga̱sti ten Nya gwaka̱n nal na̱k gwe mastat go, kaa mani aka̱a̱ wul tla̱nda̱l ge ɗe, &lt;Tli ɗa̱ ɗe ka ta̱k li te du,&gt; a tla̱nda̱li li ka̱li. A ba̱ ilgon a kankii gaa so.&gt;&gt; <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />Wuda̱li go ba̱sa yil so se na̱ ngemti Nya suk pa̱lti ka̱lka̱ze ze.<verse eid="MAT 17:21" /></para>
  <para style="s">Yesu po dla̱m wunda̱l ma̱shka̱n gwe ta pa̱li wu ɗa</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Mil lishtisi mogaa ka̱ lu ɗe na̱m a Galili wu, yek ta̱ wulsi ɗe, &lt;&lt;Sa ba̱l bi ga̱ Yen ga̱ Mbala̱n ka̱ ang ga̱ mbala̱n <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />sa tloti. Ama ten cin na mekan wo ta palla̱t kaami.&gt;&gt; Yek ili hwot mil lishtisi i'e.<verse eid="MAT 17:23" /></para>
  <para style="s">Ga̱ɓa ten ɓatlti wulpi boo lubii ga̱ Nya</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Yesu suk mil shinti jwas mbuki ba̱n Kaparnahum wugo yek ma̱n kanti wulpi boo lubii ga̱ Nya tul mal Biturus Yek sa̱ wulti ɗe, &lt;&lt;Ma̱n lishti gwaka̱n ɓatla̱n wulpi boo lubii ga̱ Nya sa?&gt;&gt;<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />Yek Biturus wulsi ɗe, &lt;&lt;Ata̱ ɓatli.&gt;&gt;</para>
  <para style="p" vid="MAT 17:25">Biturus te gibboo wugo yek Yesu wulti ɗe, &lt;&lt;Siman, yek ɗe daamti gwa ye? Ka̱ ɓa yeni go tet mal ka̱ wokko ka̱n a guu ji ma̱n dii atl ga̱n kan wulpi boo wo na̱? Tet mal mbala̱n ji ba̱mi nwa ko mal ma̱nda̱ki?&gt;&gt;<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />Yek Biturus wulti ɗe, &lt;&lt;Tet mal ma̱nda̱ki.&gt;&gt;</para>
  <para style="p" vid="MAT 17:26">Yek Yesu wulti ɗe, &lt;&lt;Gwisi na̱ma mbokti ang ɗe ba̱ mil ji ba̱mi a ɓatl so.&gt;&gt; <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />&lt;&lt;Ama ten ɗe ma lak ndesi mbadli, su bal ze ta̱k suk lak wul dopti kwesi. Ɓul bi ga̱ kwes gwe ka doɓi na na̱m wu, ka mbi wulpi zil ga̱lla gwe a mbuk ɓatlti wulpi boo gi suk gwa wu. A pa ka̱ kan wulpi aka̱ ɓatlsi na̱ nali.&gt;&gt;<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Kakshe ka̱ guu ga̱ Nya</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Ka̱ sa'i gwisi wo yek mil lishtisi li mal Yesu yek sa̱ ngemti ɗe, &lt;&lt;Wok ɗe kakshe ka̱ guu ga̱ Nya wo na̱?&gt;&gt;<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />Yek ta̱ mbe na̱k'en yen gon tet ɗe ta̱s dla̱l ka̱ dlo gwasa̱n, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />yek ta̱ wulsi ɗe, &lt;&lt;Amik ka hwikii ge, ɗe kume ka̱a̱ palli gwaka̱n pal na̱k mil mbala̱n sowu, kaa mbi guu ga̱ Nya so. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Ten na̱k gwisi ka̱n mas, ma̱lgwe palli gaa gwas na̱k nak'en yen ga̱n go ma̱li ka̱ɗe kakshe ka̱ guu ga̱ Nya.<verse eid="MAT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 18:5" />&lt;&lt;Mas ma̱lgwe kan yen mbala̱n na̱k ga̱n ka̱ shin gi go ami ka̱n ta̱ kama̱nni.<verse eid="MAT 18:5" /></para>
  <para style="s">Wul lakti ga̱ mbala̱n ten ndati</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />&lt;&lt;Ama mas ma̱lgwe lak ɗe na̱m ka̱ mil jin ɗe sa̱ nga̱ssi tena̱n wu ten pa̱lti byas wul go, a maniti ɗe ta̱s ɓalit ye na̱kti hwo yal asa̱ lakti ka̱ bal ze.<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />&lt;&lt;Mbala̱n ji dii atl ge wo wul cit gonti ka̱n, na̱ wul wonti jwe a lak mbala̱n ten pa̱lti byas wul wu! Ni ngetli ɗe ta̱ wul jwe a lak mbala̱n ten pa̱lti byas wul wu tuli, ama ma̱lgwe tulli wuli go wul cit gonti ka̱n. <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Kume a ang gwa sogo asa̱n gwa laki a ka̱ pa̱l byas wullu, kotl ka aka̱ lak ka. A manik ɗe ta̱k mbi mbadl ma̱n la̱shi pakti na̱ ang ɗe na̱m sogo asa̱n ɗe na̱m, ɗa̱ gwe ta̱s lakki ka̱ buu wutu gwe ba̱ a mba̱shdli so na̱ ang jwa suk asa̱n jwa wu. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />A kume a gwel gwa lakki ten pa̱lti byas wullu, yilli ka aka̱ lak ka! A manik ɗe ta̱k mbi mbadl ma̱n la̱shi pakti na̱ gwel ɗe na̱m, ɗa̱ gwe ta̱s lakki ka̱ buu wutu na̱ gwel jwa wu.<verse eid="MAT 18:9" /></para>
  <para style="s">Cinga̱lti ga̱ɓa na̱ mba̱la gwe gillu</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />&lt;&lt;Kii dai pa̱n ɗem-ɗem ba̱k mbula̱n gon ka̱ nak mil jin so. A nikii ma hwiti, mil shinti ji Nya jwe sa̱ na̱ma ɓa̱tti gwasa̱n wu ni to nya ka a cina ga̱ Aba gini cin suk gasi. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />Yen ga̱ Mbala̱n tul ɗe ta̱s kis ma̱jwe gillu.<note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">Ka̱ lishtisi jon ji cina wo, lu ndati ɗe 11 ni ɗa̱ so.</char></note><verse eid="MAT 18:11" /></para>
  <para style="s">Cinga̱lti ga̱ɓa na̱ mba̱la gwe gillu</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />&lt;&lt;Nik ka̱a̱ yeni gwi na̱? Kume mba̱la zamba̱l ɗe na̱m ni ma̱n kyo ɗa yek gon gwasa̱n gil ka̱ go, ta zaka̱n naami ɗe kutl topsi na̱ topsi ju ten pa̱t kyo ata̱ sa ngot ga̱ mba̱le gwe gillu sa? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Gem, amik ka hwikii ge, kume ta̱ mbit ɗu go, a pa̱l hwol tuk na̱ ti man ɗe kutl topsi na̱ topsi jwe ba̱sa̱ gillit ka̱ so ju. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Na̱k gwisi ka̱n Aba gwaka̱n gwe ni to nya ka̱wu lami ɗe ta̱ ɗe na̱m ka̱ nak mil jin gil ka̱ so.<verse eid="MAT 18:14" /></para>
  <para style="s">Kume gon gwaka̱n pa̱li byas wul yilka gwas wu</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />&lt;&lt;Kume yilka gwa pa̱lik byas wul wu, li malti aka̱ hwit byas ilgwe ta̱ pa̱lik wu, kii sukti kii na̱ ngweka̱n. Kume ta̱ katik ka̱n wu ka̱ palli yilka gwa ten tantu wi. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Ama kume ta̱ nge kumti gwa wu, ngo mbala̱n ɗe na̱m sogo mbala̱n ɗe lop aka̱ li malti, kangwe asa̱ wule ɗe, &lt;Ten ga̱ɓa ga̱ mbala̱n ɗe lop sogo ɗe mekan ka̱n asa̱ dla̱lli mas ga̱ɓa.&gt;<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="ft" closed="false">Yen</char><char style="xt" closed="false"><ref loc="DEU 19:15">K. M. 19:15</ref></char></note> <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Kume ta̱ nge kumti gwasa̱n wu, hwi motgaa ga̱ ma̱n kopti. A kume ta̱ nge kumti ga̱ motgaa ga̱ ma̱n kopti go, aka̱ palla̱t na̱k ma̱lgwe ɓo yis Nya sowu sogo na̱k ma̱n pa̱lti byas wul gwe nge cit atl gaa wu.<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />&lt;&lt;Amik ka hwikii ge, mas ilgwe ka̱ ɓal ka ten dii atl go ta̱ ni ɗe ilgwe sa̱ ɓal ka a nya wu. A mas ilgwe ka̱ pa̱tl ka ten dii atl go ta̱ ni ɗe ilgwe sa̱ pa̱tl ka a nya wu.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />&lt;&lt;Amik ka hwikii wu ɗa̱ɗe, kume mbala̱n ɗe lop ka̱ kii ten dii atl dla̱lli ga̱ɓa ɗe sa ngem ilgon go, Aba gi ɗe ta̱ ni nya wu a pa̱lisi. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Ten ɗe, kume mbala̱n ɗe lop sogo ɗe mekan mogaa na̱<note caller="+" style="f"><char style="fr" closed="false">18:20 </char><char style="ft" closed="false">Sogo</char><char style="fqa" closed="false">ka̱</char></note> shin gi go, ani suksi.&gt;&gt;<verse eid="MAT 18:20" /></para>
  <para style="s">Cinga̱lti ga̱ɓa na̱ zhel gwe ba̱ta taas wul ɗa̱ ten mbadl ka̱ sowu</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Yek Biturus li mal Yesu yek ta̱ ngemti ɗe, &lt;&lt;Bagaa asa̱mi ɗe na̱mi ka̱n yilka gi a pa̱li byas wul a taasit ka̱ gwi? Asa̱mi ɗe nitgi ya?&gt;&gt;<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Yek Yesu ballit ɗe, &lt;&lt;Amik ka hwikii ge asa̱mi ɗe nitgi tokte ka̱ so, ama se la asa̱mi ɗe kutl nitgi ɗe nitgi.<verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />&lt;&lt;Guu ga̱ Nya wo na̱k wule guu gwe lami ɗe, ta̱s dla̱m wul ang gwas gwe ni a ang ga̱ zhel jwas wu ka̱n. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Ɗe guumi ɓa dla̱m go, yek sa̱ tullit ma̱lgon gwe ta̱ na̱ma kopti gwas wulpi zil ga̱lla wonti gwe ɗe hal ma̱li a ma̱shi a ba̱ta man ɓatlti sowu. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Na̱k ɗe ma̱li a man ɓatlti gwas sowu, yek guumi dla̱m ɗe ta̱ wulti ka suk kili gwasi suk mil jwasi suk mas ilgwe niɗɗa̱ wu ta̱ ɓatlti wulpi gwas ɗa.<verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />&lt;&lt;Yek zheli ngus na̱ gahwula̱n a cina gwasi yek ta̱ ngemti yek wulti ɗe, &lt;Dlo mbadl na̱ ami, ba ɓatlki mas wulpi gwa.&gt; <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Yek guumi yen gonti gwasi yek ta̱ taasi ma̱li mas duli ka yek ta̱ zakti.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />&lt;&lt;Ama yek na̱ yilti ga̱ zhel gwisi yek ta̱ mo suk yela̱n pa̱lti wul gwas gon, gwe ta̱ na̱ma kopti gwas wulpi zil ga̱lla gwe ba̱ nal sowu, yek ta̱ ngiɓit yal luka̱l ata̱ nitma wulti ɗe, &lt;Ɓatla̱n wulpi gwe a na̱ma kopti gwa wu.&gt;<verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />&lt;&lt;Yek zheli gwisi ngus na̱ gahwula̱n yek ta̱ ngemti ɗe, &lt;Dlo mbadl na̱ ami, ba ɓatlki wulpi gwa!&gt;<verse eid="MAT 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30" />&lt;&lt;Ama yek zheli nge kumti gwasi yek ta̱ sak let ka ka̱ lu leti, ten ɗe se ta̱ ɓatlti wulpi gwasi mas. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Naa zhel ji ma̱li yen ilgwe pi wu wugo yek mbadl jwasa̱n lili, yek sa̱ sak hwi guu gwasa̱mi mas ilgwe pi wu.<verse eid="MAT 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32" />&lt;&lt;Yek guumi mbe zheli malti, yek ta̱ wulti ɗe, &lt;Ki wo byas zhel ka̱n.&gt; A taasik mas dul gwe a na̱ma kopti gwa wu ka na̱k ɗe ka̱ ngema̱n ɗe ta taasik ka̱wu. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Ki wo mbuna̱n ɗe ta̱k yen gonti ga̱ yilka gwa zhel na̱k gwe a yen gonti gwa wu sa? <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Mbadl lili guumi i'e yek ta̱ laki yek sa̱ nol zheli ka, se na̱k ta̱ ɓatlti mas dul gwe nit gaa wu.&gt;&gt;<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />&lt;&lt;Nu ka̱n Aba gi gwe ni nya wu a pa̱li ko wokko ka̱ kii ɗe ba̱ta taasi yilkeni jwas byas wul ka̱ sowu.&gt;&gt;<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Mbokti ang ga̱ Yesu ten zakti kili punka</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Ɗe Yesu pak dla̱mti wul jimi wugo, yek ta̱ zak ka̱t atl ga̱ Galili yek ta̱ li ka̱t atl ga̱ Yehudiya, lu gwe ni tu te duk ɗa̱ dla̱lka Yodan wu. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Yek mbala̱n wonti kopti yek ta̱ ndok ma̱n cwo ka̱li.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Yek ma̱n Paresi jon tul malti ɗe sa cinga̱lti na̱ kumti ga̱s wul, yek sa̱ wulti ɗe, &lt;&lt;Ko Mba̱t Ga̱ɓe kama̱n ɗe ta̱ mbala̱n zak kili gwas ten bi ilgon na̱?&gt;&gt;<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Yek ta̱ ballisi ɗe, &lt;&lt;Ase ka̱a̱ ɓo yenni ga̱ lishi ɗe, &lt;Ten ndat zhile wo, ti ɗe ta̱ pa̱l mas wul go, ta̱ pa̱lsi ba mani suk kili mbala̱n.&gt; <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />Yek ta̱ wule, &lt;Ten na̱k gwisi ka̱n, a ba mani zak aba suk ana gwasi ata̱ ngatli kili gwas dli, a si ɗe loɓi da̱m ɗe dli ɗe na̱m&gt;<note caller="+" style="f"><char style="fr" closed="false">19:5 </char><char style="ft" closed="false">Yen </char><char style="xt" closed="false"><ref loc="GEN 2:24">L. Z. 2:24</ref></char></note> <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Yek laki yek ba̱sa po yi ɗe mbala̱n ɗe lop so, ama ɗe na̱m ka̱ ɓali. Ten na̱k gwisi ka̱n, mas ilgwe Nya palli ɗe na̱m wu, ba̱ ma̱lgon hwuli so.&gt;&gt;<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Yek sa̱ ngemti ɗe, &lt;&lt;Ɗe nuk go yek laki yek Musa dla̱m ɗe kume mbala̱n a zak kili gwas go ta̱s ba̱lti lishti zakti ye?&gt;&gt;<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Yek Yesu wulsi ɗe, &lt;&lt;Nda̱lli gaa gwaka̱n ka̱ laki yek Musa kamikii ɗe ta̱k zaka̱n modli jwaka̱n. Ama tet ten ndat zhile wo nuk ni so. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Amik ka hwikii wu ɗa̱ɗa, mas ma̱lgwe zak kili gwasi yek ta̱ hap zopsi a ba̱ ten bi pa̱t-pa̱la̱n ka̱ sowu, ma̱li na̱ma pa̱t pa̱la̱n sukti.&gt;&gt;<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Yek mil shinti jwas wulti ɗe, &lt;&lt;Ɗe kume nu ka̱n ni ka̱ dlo ga̱ kos suk kili gwas go, la̱shi hapti man hapti.&gt;&gt;<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Yek Yesu ballisi ɗe, &lt;&lt;Mas mbala̱n ka kan ga̱ɓa ga̱n so, se ko ma̱jwe Nya kamisi wu. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Mbala̱mi jon wo sa̱ laksi go maani ka̱ so, a jon wo pa̱lti ka̱n mbala̱n pa̱lisi na̱k gwisi, a jon wo sik nge hapti ten bi guu ga̱ Nya. Mas ma̱lgwe a man kanti ga̱ɓa ga̱n go ta̱s kaami.&gt;&gt;<verse eid="MAT 19:12" /></para>
  <para style="s">Yesu laki albarka mil mbala̱n</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Yek sa̱ tulli mil mbala̱n mal Yesu ta̱s wutisi ang gaa ata̱ ngemisi Nya. Ama yek mil lishti jwas matl ma̱jwe tulla̱si wu.<verse eid="MAT 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14" />Yek Yesu wulsi ɗe, &lt;&lt;Zaka̱n nak mil mbala̱n ta̱s tul mala̱nni ba̱k mbola̱nsi ka̱ so, ten ɗe guu ga̱ Nya wo ga̱ wunda̱l gwasa̱n ka̱n.&gt;&gt; <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Ta̱ wutisi ang albarka gaa wugo yek ta̱ zak luisi.<verse eid="MAT 19:15" /></para>
  <para style="s">Samali ma̱n wul ang</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Sa̱ ni nugo yek ma̱lgon tul mal Yesu yek ta̱ wulti ɗe, &lt;&lt;Ma̱n lishti, wunda̱l hwa wul gwik ni ngetli ɗe ta pa̱li a mbi mbadl gwe ba̱ a paki sowu gwi?&gt;&gt;<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />Yek Yesu ballit ɗe, &lt;&lt;Yek laki ɗe ka̱ ngema̱n ten bi hwa wul ye? Ai Nya na̱ ngus ka̱ɗe hwa wul! Kume ka̱ na̱ma lamti ta̱k mbi mbadl gwe ba̱ a paki sowu go kop mba̱t ga̱ɓa ju.&gt;&gt;<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Yek ma̱li ngem Yesu ɗe, &lt;&lt;Mba̱t ga̱ɓe jwi?&gt;&gt;</para>
  <para style="p" vid="MAT 19:18">Yek ta̱ ballit ɗe, &lt;&lt; &lt;Tlo mbala̱n so, pi suk kili ga̱ ma̱lgon so, pi muka̱l so, sheli lal ma̱lgon gaa so, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />ba̱l nalti aba suk ana gwa,&gt;<note caller="+" style="f"><char style="fr" closed="false">19:19 </char><char style="ft" closed="false">Yen</char><char style="xt" closed="false"><ref loc="EXO 20:12-16">Yil 20:12-16</ref>; </char><char style="xt" closed="false"><ref loc="DEU 5:16-20">K. M. 5:16-20</ref></char></note> aka̱ &lt;lam yela̱n da̱mti gwa na̱k gwe ka̱ lam gaa gwa wu.&gt;<note caller="+" style="f"><char style="fr" closed="false">19:19 </char><char style="ft" closed="false">Yen </char><char style="xt" closed="false"><ref loc="LEV 19:18">Lib 19:18</ref></char></note> &gt;&gt;<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Yek samali wul Yesu ɗe, &lt;&lt;A kop mba̱t ga̱ɓa jwisi wi, yek yi kaal ye?&gt;&gt;<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Yek Yesu wulti ɗe, &lt;&lt;Kume ka̱ na̱ma lamti ta̱k da̱m njikmi go, sak wul mas wul jwa ka, aka̱ ba̱l wulpi ma̱n la̱shi wul ka da̱m ɗe ma̱n wul ang a nya. Apaa aka̱ lak koɓa̱nni.&gt;&gt;<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />Yen samali kumi nu wugo yek ta̱ zigaa na̱ lilti mbadli, na̱k ɗe ti wo ma̱n wul ang i'e ka̱ɗe ti wu.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Yek Yesu wul mil lishti jwas ɗe, &lt;&lt;Gem amik ka hwikii ge, a bom i'e ta̱ ma̱n wul ang te ka̱ guu ga̱ Nya. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Ta ɓo hwikii ɗa̱ɗa, gara ta̱ rakumi koɓi tu ka̱ shu alipla ɗa̱ gwe ta̱ ma̱n wul ang te ka̱ Nya ɗe guu wu.&gt;&gt;<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Mil lishtisi kumi nu wugo yek ngip ang bi i'e yek sa̱ ngemti ɗe, &lt;&lt;Ɗe nu ka̱ go, yek wok ka mbi kisti wo?&gt;&gt;<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Yek Yesu wutisi gwel yek ta̱ dla̱m ɗe, &lt;&lt;Mal mbala̱n wo, go ma̱n pa̱t ka̱ so! Ama mal Nya wo ko yek ke a man pa̱ti.&gt;&gt;<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Yek Biturus ballit ɗe, &lt;&lt;Mi wo ma̱ zak wul wi mas ten bi kopti gwa! Yek ɗe ilgwe ma mbi wu ye?&gt;&gt;<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Yek Yesu wulsi ɗe, &lt;&lt;Gem amik ka hwikii ge, ka̱ multi ma̱n tulti ka̱ sa'i gwe Yen ga̱ Mbala̱n a da̱m ten gobdlan guu gwas ma̱n nalti wu, kii ɗe ka̱a̱ koɓa̱n wu mago kaa da̱m ten gobdlan kutl cet lop, aka̱a̱ kissi ga̱ɓa ma̱n boo ɗe kutl ɗe lop ji Yisiraila ju. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Apaa mas ma̱lgwe zak lubii jwasi sogo yilkeni jwasi sogo aba sogo ana sogo mil mbala̱n sogo zhin gwasa̱n ten bi gi wu mbi asa̱mi ɗe zaba̱l ga̱ ilgwe sa̱ zaki wu. Asa mbi mbadl gwe ba̱ a paki sowu pak. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Ama mbala̱n wonti jwe sik ɗe ji cina ju a pal ɗe ma̱ji tukaali, a ma̱jwe sik ɗe ji tukaal ju a pal ɗe ma̱ji cina.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Cinga̱lti ga̱ɓa na̱ ma̱n kolti zhin ka̱ zhin inabi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />&lt;&lt;Guu ga̱ Nya wo na̱k ma̱n zhin gon gwe yil na̱ gasi ta̱s ngo ma̱jwe a kolit zhin ka̱ zhin inabi gwas wu ka̱n. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Ta̱ pa̱l ga̱m suksi ten ɗe ta ɓatlsi na̱ wulpi dinari ɗe na̱m ɗe na̱m ten ndat cin gwasa̱n, yek ta̱ laksi ka̱ zhin inabi gwasi.<verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />&lt;&lt;Yek ta̱ yili ka̱ sa'i ga̱lla ɗe topsi, yek ta̱ yen mbala̱mi jon ten da̱mti ten koo lu ka̱ lu wulti wul ka. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Yek ta̱ wulsi ɗe, &lt;Kii mago sak kola̱n zhin ka̱ zhin inabi gini, ba ɓatlkii kangwe mbun ɗe ta ɓatl wu.&gt; <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Yek sa̱ li ka̱ zhimi.</para>
  <para style="p" vid="MAT 20:5">&lt;&lt;Yek ta̱ yil ɗa ka̱ dlo cin suk ka̱ sa'i ga̱lla ɗe mekan ka̱ sukti yek ta̱ po pa̱li na̱k gwisi ɗa. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Ta̱ po yil ɗa sa'i ga̱lla ɗe namtan ka̱ sukti yek ta̱ po yen ma̱jon ɗa a nya ba̱sa̱ na̱ma pa̱lti ilgon so, yek ta̱ wulsi ɗe, &lt;Yek laki yek ka̱a̱ nda cin ten koo lu nu ye?&gt; &gt;&gt;<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />&lt;&lt;Yek sa̱ ballit ɗe, &lt;Ilgwe laki go, na̱kka̱n ma̱lgwe ilgwe ma pa̱li wu so.&gt;</para>
  <para style="p" vid="MAT 20:7">&lt;&lt;Yek ta̱ wulsi ɗe, &lt;Kii mago sak kola̱n zhin ka̱ zhin ɗaaka.&gt;<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />&lt;&lt;Cin nda bii wugo yek ma̱n zhimi wul ma̱lgwe ata̱ zit ang ten yenti zhimi wu ɗe, &lt;Mbe ma̱n kolti zhin ju ta̱k ɓatlsi. Nda zhila ɓatlisi na̱ ma̱jwe pak kaal ten la̱t ka̱ zhimi wu, aka̱ paki na̱ ma̱jwe nda cina ten la̱t wu.&gt;<verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />&lt;&lt;Yek ma̱jwe sa̱ mbesi ka̱ sa'i ga̱lla ɗe namtan wu tulli, yek sa̱ ba̱lsi ko wokko wulpi ndat cin. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Yek ma̱jwe li tet ka̱ zhimi cina wu da̱m gwa we sa ba̱lsi wulpi ta̱ man ko wokko. Ama yek sa̱ ba̱l ko wokko wulpi ndat cin pak. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Ɗe sa̱ kan wulpi wugo, yek sa̱ njet nala̱nti ten ma̱n zhimi. <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />Asa̱ na̱ma wulti ɗe, &lt;Ma̱jin ɗe sa̱ ya tul ka̱ kaali go sa'i ɗena̱m ka̱n sa̱ pa̱li ka̱ zhimi, ama yek ka̱ ɓatlsi ndakce sukmi ɗe ma nda cin ten kolti zhin wu.&gt;<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />&lt;&lt;Ama yek ta̱ balli gon gwasa̱n ɗe, &lt;Yela̱n gini, a tek ga̱zi so. Ale ga̱m ka̱n ma̱ pa̱li sukkii ten ɗe ta ɓatlkii wulpi dinari ɗe na̱m ɗe na̱m na̱? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Kan wulpi gwa ta̱k zigaa. A mik lami ɗe ta ba̱l ma̱jwe sa̱ ya tul ka̱ kaali wu ndakce sukkii. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Ko ba mana̱n pa̱lti ilgwe a lami wu na̱ wul gi so? Ko daka̱lti ga̱ alheri gwe a pa̱li wu ka̱n ka̱ na̱ma pa̱lti.&gt;<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />&lt;&lt;Na̱k gwisi ka̱n, ma̱ji tukaali pal ɗe ji cina, a ji cina pal ɗe ma̱ji tukaali.&gt;&gt;<verse eid="MAT 20:16" /></para>
  <para style="s">Yesu po dla̱m ga̱ɓa ten bi ma̱shka̱n gwas ɗa</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />A Yesu suk mil lishti jwas na̱ma la̱t Wurshelima yek ta mbesi te kaali ka yek ta̱ wulsi ɗe, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />&lt;&lt;Yek gu ma̱ ɓa la̱n Wurshelima. Apaa sa̱ tak yen ga̱ mbala̱n ka̱ ang ga̱ kiɗi ma̱n Pa̱ris suk ma̱n yisti Mba̱t Ga̱ɓa ga̱ Musa, sa pa̱lit kisti ga̱ɓa ɗe ta̱ tlot ka. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />Asa̱ takti ka̱ ang ga̱ ma̱jwe ba̱ ma̱n Yehuda ka̱ so wu, sa hwit ga̱ɓa mbulti asa̱ ɓoti asa̱ ɓakti ka ten guda̱l yencin. Ama ten cin na mekan wo sa palla̱t kaami!&gt;&gt;<verse eid="MAT 20:19" /></para>
  <para style="s">Ilgwe ana ga̱ Yakubu suk Yohana ngemi wu</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Ka̱ sa'i gwisi wo yek ana ga̱ mil ji Zabadi tul mal Yesu suk mil jwasi, yek ta̱ ngus atl a cina gwasi tas ngemit ilgon.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Yek Yesu wulti ɗe, &lt;&lt;Yek ka lami kam ye?&gt;&gt;</para>
  <para style="p" vid="MAT 20:21">Yek ta̱ wulti ɗe, &lt;&lt;A na̱ma lamti ta̱k laki ta̱ mil ji jee da̱m malki, ta̱ gon da̱m ten ang shinti, a gon wo ten ang yali gwa ka̱ guu gwa.&gt;&gt;<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Yek Yesu wul mili ɗe, &lt;&lt;Ka̱a̱ yis ilgwe ka̱a̱ na̱ma ngemti wu so, kaa man tlat bomti gwe ba tla gwa?&gt;&gt;</para>
  <para style="p" vid="MAT 20:22">Yek sa̱ ballit ɗe, &lt;&lt;Ma mani,&gt;&gt;<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Yek Yesu wulsi ɗe, &lt;&lt;Yii kaa man tlat bomti gwe ba tla wu, ama ma̱lgwe a da̱m ten ang shinti suk ang yali gi go, amik ka lak ma̱li so. Lu da̱mti jwisi wo ji ma̱jwe Aba gi gwe ni nya wu a botli wu ka̱n.&gt;&gt;<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Ɗe naa mil lishti jwas ɗe kutl ju kumi nu wugo, yek mbadl jwasa̱n lil na̱ yilkeni ɗe loɓi. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Yek Yesu mbesi ka̱ lu ɗena̱m mas jwasa̱n yek ta̱ wulsi ɗe, &lt;&lt;Ka̱a̱ yis kangwe a guu ji ma̱jwe ba̱ ma̱n Yehuda ka̱ sowu pa̱l iko ten ma̱ jwasa̱n wu. Ko ta̱ bacina jwasa̱n mago asa̱ pa̱li na̱k gwisi. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Ama kii wo ba̱ ni na̱k gwisi ka̱ dlo gwaka̱n so. Mas ma̱lgwe na̱ma lamti ta̱s da̱m ɗe kakshe ka̱ kii go, ngetli ka̱n ta̱s da̱mikii ɗe ma̱n pa̱lti wul. <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />A mas ma̱lgwe na̱ma lamti ta̱s da̱m ɗe bacina gwaka̱n go, ngetli ka̱n ta̱s da̱mikii ɗe zhel, <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />na̱k gwisi ka̱n yen ga̱ mbala̱n tul ɗe ta̱ ma̱lgon pa̱lit wul so, ama ta̱ tul ɗe pa̱l wul, ata̱ ba̱l mbadl gwasi, ten ɗe ta̱ mbala̱n wonti mbi kis ɗa̱.&gt;&gt;<verse eid="MAT 20:28" /></para>
  <para style="s">Yesu ndok dwa ɗe lop</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Ɗe Yesu suk mil lishti jwas ɓa zak ba̱n Yeriko go, yek wonti mbala̱n kopti. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />A dwa ɗe lop jon ni na̱ zhila ten bi tantu, sa̱ kumi ɗe Yesu na̱ma la̱t wugo, yek sa̱ njel wulti to nya ka̱ɗe, &lt;&lt;Bagaa Yen ga̱ Dauda, yen gonti ga̱na̱n ne!&gt;&gt;<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Yek mbala̱mi matlsi yek sa̱ wulsi ɗe ta̱s da̱m mbetlak, ama yek sa̱ wuli to nya ka̱ɗe, &lt;&lt;Bagaa, Yen ga̱ Dauda yen gonti ga̱na̱n ne!&gt;&gt;<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Yek Yesu dla̱l ka yek ta̱ wulsi ɗe, &lt;&lt;Yek ka̱a̱ na̱ma lamti ta pa̱likii ye?&gt;&gt;<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />Yek sa̱ nda̱kit ɗe, &lt;&lt;Bagaa ma̱ na̱ma lamti ta̱n man yenti lu.&gt;&gt;<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Yek Yesu yen gonti gwasa̱n yek ta̱ ta̱n gwel jwasa̱n. Yek sa̱ njel yenti lu ka̱li-ka̱li yek sa̱ kop kaal gwasi.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Yesu te ka̱ ba̱n Wurshelima</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Ɗe Yesu suk mil lishti jwas mbuki nak'en ba̱n Betapaj njaa a Wurshelima ten Za̱nda̱l Tla̱nda̱l Zetun wu, yek ta̱ shin mil lishti jwas ɗe lop te cina gwasa̱n ka. <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />Yek ta̱ wulsi ɗe, &lt;&lt;La̱n te ka̱ ba̱n gwe nikii cina wu ka, kaa yen zhaki suk yen gwas ga̱ ɓali ka ka̱ ba̱mi. Pa̱tlini nini si teɗi. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />A kume ma̱lgon wulkii ɗe ilgon go, aka̱a̱ hwit ɗe Bagaa na̱ma lamti gwasa̱n ata ya palla̱si teɗi.&gt;&gt;<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Pi na̱k gwisi ta̱ njika̱n ilgwe ma̱n dla̱mti ga̱ɓa ga̱ Nya dla̱m wu ɗe,<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />&lt;&lt;Hwi ma̱n Sihiyona ɗe,</para>
  <para style="q2" vid="MAT 21:5">&lt;Ɓo yeni ni guu gwaka̱n ka tulikii wu,</para>
  <para style="q1" vid="MAT 21:5">ma̱n kumti bi ka̱ɗe ti, ta̱ to ten zhaki,</para>
  <para style="q2" vid="MAT 21:5">ten yen zhaki ka̱n ta̱ na̱ma la̱ti.&gt; &gt;&gt;<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Yek mil lishtisi sak pa̱l ilgwe Yesu hwisi ɗe ta̱s pa̱li wu. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Yek sa̱ tulli zhaki suk yen gwasi, yek sa̱ wut luka̱l jwasa̱n tensi ten ɗe ta̱ Yesu to ta̱s da̱mi. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Yek wonti mbala̱n wut luka̱l jwasa̱n ten tantu, yek jon jwasa̱n kotl daa tet ten tlindi yek sa̱ ta̱tali ten tantu. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Yek mbala̱n jwe sa̱ nit tu cina ju, suk jwe sa̱ nit tu tukaal wu ngusi wulti to nya ka̱ɗe,</para>
  <para style="q1" vid="MAT 21:9">&lt;&lt;Hosana ga̱ yen Dauda!&gt;&gt;</para>
  <para style="q2" vid="MAT 21:9">&lt;&lt;Ma̱lgwe tul na̱ shin ga̱ Bagaa go, ma̱n albarka ka̱n!&gt;&gt;</para>
  <para style="q1" vid="MAT 21:9">&lt;&lt;Hosana ga̱ Ma̱n Nalti!&gt;&gt;<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Ɗe Yesu te Wurshelima wugo yek mas ba̱mi hwot ka na̱ bi gwasi. Yek ma̱n ba̱mi ngusi kumti ga̱zi ɗe, &lt;&lt;Wok ɗe gwisi wo na̱?&gt;&gt;<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Yek mbala̱n jwe na̱ma kopti kaal gwas wu nda̱kisi ɗe, &lt;&lt;Yesu ka̱n, ma̱n dla̱mti ga̱ɓa tet Nazarat ka̱ atl ga̱ Galili.&gt;&gt;<verse eid="MAT 21:11" /></para>
  <para style="s">Yesu mbol ma̱n wulti wul ɗa̱ka̱ lubii ga̱ Nya ka</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Yek Yesu te ka̱ lubii ga̱ Nya yek ta̱ mbol ma̱jwe asa̱ wul wul ka ka̱li wu. Yek ta̱ jek tebul ji ma̱jwe asa̱ balli wulpi mbala̱n wu ka, suk gobdlan ji ma̱jwe asa̱ wul kulu ka̱ ju ka. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Yek ta̱ wulsi ɗe, &lt;&lt;Ni ga̱ lishi ɗe, &lt;Sa mbe lubii gi ɗe lubii ngemti Nya,&gt; ama yek ka̱a̱ palli ɗe lu hwunti ji muka̱l wi.&gt;&gt;<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Yek dwa suk ma̱jwe ka̱t dli jon jwasa̱n tla ka̱ ju tul malti ka̱ lubii ga̱ Nyami, yek ta̱ ndoksi. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Ama yek kiɗi ma̱n Pa̱ris suk ma̱n yisti Mba̱t Ga̱ɓa ga̱ Musa yen wul ngipti bi ang gwe ta̱ pa̱li wu, suk kangwe mil mbala̱n na̱ma wulti to nya ka̱ɗe, &lt;&lt;Hosana ga̱ Yen ga̱ Dauda wu,&gt;&gt; Yek mbadl gwasa̱n lili.<verse eid="MAT 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16" />Yek sa̱ ngemti ɗe, &lt;&lt;Ama ka̱ na̱ma kumti ilgwe mil jee na̱ma dla̱mti gwa?&gt;&gt;</para>
  <para style="p" vid="MAT 21:16">Yek Yesu ballisi ɗe, &lt;&lt;Yii, ka̱a̱ ɓo taɓa dla̱mti luisi ka̱ ga̱ɓa Nya so nwa?&gt;&gt;</para>
  <para style="q1" vid="MAT 21:16">&lt;&lt;Ɗe, &lt;Ka lak mil mbala̱n suk mil la̱li ten ta̱sti gwa!&gt; &gt;&gt;<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Yek ta̱ zaksi ka̱li, yek ta̱ li ba̱n Betani yek ta̱ mul ka̱li.<verse eid="MAT 21:17" /></para>
  <para style="s">Yesu pa̱li tlindi tula̱n bi gaa</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Lu tlo wi ɗe ta̱ dop tantu palti tot ka̱ ba̱n wugo yek kuza̱n njel tlot gwasi. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Yek ta̱ yen tlindi tula̱n ten bi tantu yek ta̱ li mali ama yek ba̱ta̱ mbi ilgon dani so se daa. Yek ta̱ wul tula̱mi ɗe, &lt;&lt;Ba̱k po wut mil so hal pakti gwa!&gt;&gt; Yek tlindi koo ka ka̱li-ka̱li.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Mil lishtisi yeni nu wugo, yek sa̱ ngip ang bi Yek sa̱ ngemti ɗe, &lt;&lt;Ɗa̱ nii ka̱n tlindi koo ka ba̱le-ba̱le nu gwi?&gt;&gt; <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />Yek Yesu ballisi ɗe, &lt;&lt;Gem amik kaa hwikii ge, ɗe kume ka̱a̱ nga̱skii ten Nya yek ba̱ka̱a̱ cel ka̱ mbadl sowu, ilgwe mbi tula̱n ga̱n ka̱n kaa man lakti a pi tokte so. Ama kaa mani wulti tla̱nda̱l ga̱n ɗe, &lt;Tlinya ta̱k suk nda ka̱ bal ze,&gt; a pi na̱k gwe ka̱a̱ dla̱m wu. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Ɗe kume ka̱a̱ ba̱l gem go, kaa mbi mas ilgwe ka̱a̱ ngemi ten ga̱ɓa suk Nya wu.&gt;&gt;<verse eid="MAT 21:22" /></para>
  <para style="s">Kumti ga̱zi ten iko pa̱lti wul ga̱ Yesu</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Ɗe Yesu te ka̱ lubii ga̱ Nya ɗe ta̱ ɓa hwi ga̱ɓa mbala̱n wu, yek kiɗi ma̱n pa̱lti wul ka̱ lubiimi suk bacina ji Ma̱n Yehuda tul malti yek sa̱ ngemti ɗe, &lt;&lt;Na̱ wunda̱l ga̱ iko gwi ka̱n ka̱ na̱ma pa̱lti wul jin jwi? Wok ba̱lki iko pa̱lti wul jimi wo?&gt;&gt;<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Yek Yesu ballisi ɗe, &lt;&lt;Kii mago ba ngemkii wul ɗe na̱m. Kume ka̱a̱ dla̱mi go ba hwikii wunda̱l ga̱ iko gwe a na̱ma pa̱lti wul jin ɗa̱ wu. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Baptisma ga̱ Yohana go tet ko ka̱n yil ko? Sut mal Nya ma, ko tet mal mbala̱n ka̱n.&gt;&gt;</para>
  <para style="p" vid="MAT 21:25">Yek sa̱ dla̱m ga̱ɓa a dani ka̱ dlo gwasa̱n, yek sa̱ dla̱m ɗe, &lt;&lt;Kume ma̱ wuli ɗe, &lt;Sut mal Nya wu,&gt; ta ngema̱nni ɗe, &lt;Yek laki yek ba̱ka̱a̱ ba̱l gem ɗa̱ so ye?&gt; <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />A kume ma̱ dla̱ma̱n ɗe, &lt;Tet mal mbala̱n ka̱wu,&gt; ma na̱mma ɓanti ga̱ ilgwe mbala̱n a manini pa̱lti wu, na̱k ɗe mas mbala̱n kan ɗe Yohana wo ma̱n dla̱mti ga̱ɓa ga̱ Nya ka̱ wu.&gt;&gt;<verse eid="MAT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27" />Nuk laki yek sa̱ balli Yesu ɗe, &lt;&lt;Ma̱ yisi so.&gt;&gt;</para>
  <para style="p" vid="MAT 21:27">Yek ta̱ wulsi ɗe, &lt;&lt;Ami mago ba hwikii wunda̱l iko pa̱lti wul gwe a nima pa̱lti wul jin na̱ nali wu so.<verse eid="MAT 21:27" /></para>
  <para style="s">Cinga̱lti ga̱ɓa na̱ ma̱lgon suk mil jwas ɗe lop</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />&lt;&lt;Yek ɗe daamti gwaka̱n ye? Ma̱n mil mani ɗe lop gon ni ɗa. Ta̱ wul kaksha yen gwas ɗe, &lt;Yen gini, lak kol zhin ka̱ zhin inabi ase.&gt;<verse eid="MAT 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29" />&lt;&lt;Yek yeni ballit ɗe, &lt;Ba li so,&gt; ama yek ta̱ lak daamti ka̱ kaali yek ta̱ li ka̱ zhimi.<verse eid="MAT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30" />&lt;&lt;Yek abe li mal ma̱ngaɓisi yek ta̱ hwit ilgwe ta̱ hwi kakshesi wu. Yek ta̱ ballit ɗe, &lt;To, bali aba gini,&gt; ama yek ba̱ta̱ li ka̱ zhimi so.<verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />&lt;&lt;Wok ɗe ma̱lgwe pa̱l ilgwe aba gwas lami wu ka̱ mil ɗe loɓi go?&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">Yek sa̱ ballit ɗe, &lt;&lt;Ga̱ cinesi.&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">Yek Yesu wulsi ɗe, &lt;&lt;Gem amik ka hwikii ge, ma̱n kanti wulpi boo suk ma̱n pa̱t-pa̱la̱n a te ka̱ Nya ɗe guu cina ɗa kii. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Ai Yohana ma̱n baptisma tula̱n ɗe ta̱s mbokikii ang ten kangwe kaa pa̱l zok wul wu, yek ka̱a̱ nge ba̱lti gem na̱ ti. Ama ma̱n kanti wulpi boo suk ma̱n pa̱t-pa̱la̱n ba̱l gem na̱ ti. Ko ɗe ka̱a̱ yeni nu ma wu ama yek ba̱ka̱a̱ ci atl gaa yek ka̱a̱ ba̱l gem na̱ ti so.<verse eid="MAT 21:32" /></para>
  <para style="s">Cinga̱lti ga̱ɓa ten ma̱n kolti zhin jwe kan haya zhin inabi wu</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />&lt;&lt;Ɓo kuma̱n cinga̱lti ga̱ɓe gon ɗa, ma̱n zhin gon ɓak inabi. Yek ta̱ ganda̱li ka na̱ bal sa̱mba̱l, yek ta̱ ɗuk shu cetti ze inabi a giɓi, yek ta̱ kin lu da̱mti ga̱ ma̱n ɓa̱tti. Yek pa ta̱ ba̱l mil haya zhimi yek ta̱ li ka̱ atl gon. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Ɗe gis ga̱ inabi tul wugo yek ta̱ shin zhel jwas mal mil haye, ten ɗe ta̱s kamit yandi inabisi gwasi.<verse eid="MAT 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35" />&lt;&lt;Ama yek mil haye dop zhel jwasi, yek sa̱ ɓo gon, yek sa̱ tlo gon, yek sa̱ lak gon na̱ ye. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Yek ta̱ shin zheli jon jwe wonti man ji cina ju malsi, yek sa̱ po pa̱lisi na̱k kangwe sa̱ pa̱li ji cina ju. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Ka̱ kaali wo, yek ma̱n zhimi shin yen gwas malsi. Ta̱ wuli ɗe, &lt;Sa yena̱n nalti ga̱ yen gini.&gt;<verse eid="MAT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38" />&lt;&lt;Ama yek mil haye yen yeni wugo, yek sa̱ wul yilkeni jwasa̱n ɗe, &lt;Ma̱lga̱n ka̱ɗe ma̱n cit gadosi. Ma̱ tloti ka ta̱ gado gwas da̱m ɗe ga̱na̱n.&gt; <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Yek sa̱ dopti yek sa̱ lakti te kaal bal sa̱mba̱l ga̱ zhimi ka yek sa̱ tloti.<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />&lt;&lt;To, ɗe ma̱n zhimi pal wugo yek ta pa̱li mil haya jwisi ye?&gt;&gt;<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />Yek sa̱ ballit ɗe, &lt;&lt;Gem ka̱ go ta tlo ma̱n ngalci jwisi ka, ata̱ ba̱l zhimi ma̱jwe a ba̱lti wul zhimi gwas ka̱ gis wu.&gt;&gt;<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Yek Yesu wulsi ɗe, &lt;&lt;A ka̱a̱ kumi ka̱ ga̱ɓa ga̱ Nya sa? Ai na̱n ga̱ lishi ɗe,</para>
  <para style="q1" vid="MAT 21:42">&lt;&lt; &lt;Ye gwe ma̱n kinti bii nge wu,</para>
  <para style="q2" vid="MAT 21:42">yek ɓal ɗe ye gwe ni hwaɓi ka̱ kinti biimi man naami wu</para>
  <para style="q1" vid="MAT 21:42">Gwisi wo pa̱lti ga̱ Bagaa ka̱n,</para>
  <para style="q2" vid="MAT 21:42">a wul ngipti bi ang ka̱n a mala̱nni.&gt;<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />&lt;&lt;Ten gwisi ka̱n a nikii ma hwiti ɗe, Sa kan Nya ɗe guu ɗa̱ ang gwaka̱n ka asa̱ ba̱l ma̱jwe sa pa̱l hwa wul wu. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Ma̱lgwe nda ten yesi go ta caccal ka, a ma̱lgwe yesi ndet gaa go a nolti na̱k apti.&gt;&gt;<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Ɗe kiɗi ma̱n Pa̱ris suk ma̱n Paresi kum cinga̱lti ga̱ɓa jimi wu, yek sa̱ yisi ɗe tensi ka̱n ta̱ na̱ma mbokti ang. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Yek sa̱ lam dopti gwasi ama yek ɓanti ga̱ wonti mbala̱n jwe ni ka̱li wu cisi na̱k ɗe mbala̱mi kan ɗe ti wo ma̱n dla̱mti ga̱ɓa ga̱ Nya ka̱ɗe ti wu.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Cinga̱lti ga̱ɓa ten biki hapti</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Yek Yesu po hwisi cinga̱lti ga̱ɓa gon ɗa yek ta̱ wulsi ɗe, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />&lt;&lt;Guu ga̱ Nya wo na̱k ta̱ guu gwe pa̱li yen gwas shiri biki hapti ka̱n. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Yek ta̱ shin zhel jwas mal ma̱jwe ta̱ shinisi lu ɗe ta̱s tul wu, ama yek ba̱ ma̱jwe ta̱ shinisi lu wu tul so.<verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />&lt;&lt;Yek ta̱ shin zheli jon malsi ɗa, yek ta̱ wulsi ɗe, &lt;Hwi ma̱jwe a shinisi lu ju ɗe, a pak za̱t ilga̱ nguki wi. Sa mbosh basi tla suk tla jwe sa̱ keta̱lsi ɗe ji biki wu wi, ma̱ pak la̱ka̱nti ko yek ke wi. La̱n tet ka̱ lu biki haptisi.&gt;<verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />&lt;&lt;Ama yek ba̱sa̱ kat ka̱ng so yek sa̱ zigaa ilgon gwasa̱n. Yek gon li ka̱ zhin gwasi, yek gon la wulti wul ka. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Yek naami jwasa̱n dop zheli yek sa̱ ɓosi hal yek sa̱ tlosi ka. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Yek mbadl ga̱ guumi lil i'e. Yek ta̱ shin ma̱n hapti dlo jwasi yek sa̱ tlo ma̱n tlot mbala̱n jwisi ka, yek sa̱ kwel ba̱mi ka.<verse eid="MAT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8" />&lt;&lt;Yek ta̱ wul zhel jwas ɗe, &lt;Pak pa̱lti shiri biki wi, ama ma̱jwe a shinisi lu ɗe ta̱s tul go mbun ɗe ta̱s sa biki so. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Ningo la̱n ɗa̱n ten tantu ka ta̱k mbe mas ma̱jwe ka̱a̱ mbisi wu tet ka̱ lu biki.&gt; <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Yek zheli li ɗa̱n ten bal tantu ka yek sa̱ mbe mas ma̱jwe sa̱ mbisi ju teɗi. Na̱ hwa mbala̱n suk mbala̱n ji koo lu se na̱k lu biki hapti njika̱n ka na̱ ma̱nda̱ki.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />&lt;&lt;Ama yek guu te ka̱ lu biki ɗe ta̱s yen kangwe ni wu, wugo yek ta̱ yen ma̱lgon gwe ba̱ta̱ lak luka̱l biki sowu. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Yek guumi ngemti ɗe, &lt;Yela̱n gini, ɗa̱ nii ka̱n ka̱ te tet aɗe ba̱na̱ luka̱l biki so gwi?&gt; Yek ba̱ ma̱li mbi ilga̱ dla̱mi so.<verse eid="MAT 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13" />&lt;&lt;Yek guumi wul ma̱jwe asa̱ pa̱lit wul wu ɗe, &lt;Ɓala̱n asa̱n gwas ka suk ang gwasi ta̱k la̱ka̱nti te ka̱ duu da̱mshal ka. Ka̱ lu gwisi ka̱n ta̱ kuli ata̱ as ang bi.&gt;<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />&lt;&lt;Ai wonti mbala̱n ka̱n sa̱ shinisi lu, ama mbala̱n ji botli wo sa̱ wonti so.&gt;&gt;<verse eid="MAT 22:14" /></para>
  <para style="s">Kumti ga̱zi ten bi ɓatlti wulpi boo ga̱ Kaisar</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Yek ma̱n Paresi lak dla̱m ga̱ɓa ka̱ dlo gwasa̱n ten kangwe sa pi asa̱ dopti ka̱ ga̱ɓa gwas wu. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Yek sa̱ shin mil lishti jwasa̱n suk mbala̱n ji Hiridus jon yek sa̱ wulti ɗe, &lt;&lt;Ma̱n lishti, ma̱ yisi ɗe ki wo ma̱n gem ka̱n, aka̱ nima mbokti ang mbala̱n ten ga̱ɓa ga̱ Nya na̱ gem. Ka̱ kan mas mbala̱n gaa ɗe na̱m, ba̱ka ba̱l jon nalti man jon so. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Ningo ɓo hwini, yek ɗe daamti gwa ye? Mbun ɗe ta̱n ɓatl wulpi boo ga̱ guu Kaisar a ko mbuna̱n so?&gt;&gt;<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Ama na̱k ɗe Yesu yis byas daamti ga̱ mbadl gwasa̱n wu, yek ta̱ wulsi ɗe, &lt;&lt;Yek laki yek ka̱a̱ na̱ma lamti cinga̱lti gi ye, kii ma̱n pa̱lti riya!&gt;&gt; <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />&lt;&lt;Ɓo mbokini nini ang ten wulpi gwe asa̱ ɓatl wulpi boomi ɗa̱ wu.&gt;&gt; Yek sa̱ ba̱lti wulpi dinari. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Yek ta̱ ngemsi ɗe, &lt;&lt;Hoto suk shin ga̱ wok ɗe ga̱n wo?&gt;&gt;<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />Yek sa̱ ballit ɗe, &lt;&lt;Kaisar.&gt;&gt;</para>
  <para style="p" vid="MAT 22:21">Yek ta̱ wulsi ɗe, &lt;&lt;Ba̱la̱n Kaisar wul ga̱ Kaisar, aka̱a̱ ba̱l Nya wul ga̱ Nya.&gt;&gt;<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Sa̱ kumi nu wugo yek ngip bi ang, yek sa̱ zakti yek sa̱ zigaa.<verse eid="MAT 22:22" /></para>
  <para style="s">Kumti ga̱zi ten bi palti kaami</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Ten cin gwisi ka̱n ma̱n Saduki ma̱jwe asa̱ wuli ɗe, mbala̱n a pal kaami sowu tul mal Yesu, yek sa̱ ngemti. <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />Yek sa̱ wuli ɗe, &lt;&lt;Ma̱n lishti, Musa wuli ɗe, kume mbala̱n ma̱shi a ba̱ ta̱ ɓo zi yen sowu. Ta̱ ma̱ngaɓi gwas kan kili gwe ta̱ zakti wu ta̱s zi yen yilka gwasi. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />To, ma̱jon ni ɗa yilkeni ɗe nitgi ka̱ mi. Kakshe gwasa̱n pa̱l hapti hal yek ta̱ ma̱shi a ba̱ta̱ ɓo zi yen so, yek ma̱ngaɓi gwas hap kilisi ɗe ta̱ zakti wu. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Na̱k gwisi pi na̱ na loɓi suk na mekami hal yek la na nitgisi. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Ka̱ kaali wo yek kilisi lak ma̱shi. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Yek ningo, ten cin gwe mbala̱n a pal kaami go, ɗe kili ga̱ wok tani wo, na̱k ɗe mas jwasa̱n sa̱ hapti wu?&gt;&gt;<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Yek Yesu ballisi ɗe, &lt;&lt;Daamti gwaka̱n ka̱ni hwaɓi so, na̱kka̱n ka̱a̱ yis ilgwe sa̱ lishi ka̱ ga̱ɓa ga̱ Nya wu so a ba̱ka̱a̱ yis iko ga̱ Nya so. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Ten ɗe ten cin gwe mbala̱n a pal kaami go mbala̱n a pa̱l hapti so a ba̱sa hap ka̱ so, ama sa da̱m na̱k mil shinti ji Nya. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Ningo ten bi palti kaami ga̱ mbala̱n wo, ka̱a̱ dla̱ma̱n ilgwe Nya hwikii wu sa? <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />Ɗe ta̱ wule, &lt;Amik ɗe Nya ga̱ Iba̱rahim, Nya ga̱ Ishaku suk Nya ga̱ Yakubu.&gt; Nya ga̱ ma̱jwe ni kaami ka̱ɗe ti, ba̱ ɗe we Nya ga̱ hwu so.&gt;&gt;<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Mbala̱mi kum ilgwe ta̱ dla̱m wugo yek sa̱ ngip bi ang ten wunda̱l ga̱ mbokti ang gwasi.<verse eid="MAT 22:33" /></para>
  <para style="s">Mba̱t ga̱ɓa gwe nal mani wu</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Ma̱n Paresi kum kangwe Yesu man ngetl ga̱ ma̱n Saduki wugo yek sa̱ mogaa. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Yek gon gwasa̱n ma̱n yisti Mba̱t Ga̱ɓa ga̱ Musa i'e ngem Yesu ten ɗe ta cinga̱lti.<verse eid="MAT 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 22:36" />Yek ta̱ wulti ɗe, &lt;&lt;Ma̱n lishti, Gwik nal mani ka̱ Mba̱t Ga̱ɓa ga̱ Musa gwi?&gt;&gt; <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />Yek Yesu ballit ɗe, &lt;&lt; &lt;Lam Nya Bagaa gwa na̱ mas mbadl gwa, na̱ mas da̱mti gwa, suk mas daamti gwa.&gt; <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Yek ɗe lakti zhila ga̱ mba̱t ga̱ɓa a yek ɗe gwe nal mani wu. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />A gwe kop kaali go na̱k gwisi ka̱n ni. Yek ɗe, &lt;Lam yela̱n da̱mti gwa na̱k kangwe ka̱ lam gaa gwa wu.&gt; <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Mas lishti ga̱ Mba̱t Ga̱ɓa ga̱ Musa suk ji Ma̱n Dla̱mti Ga̱ɓa ga̱ Nya dla̱l ten mba̱t ga̱ɓa ɗe lop jimi.&gt;&gt;<verse eid="MAT 22:40" /></para>
  <para style="s">Kumti ga̱zi ten Almasihu</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Ma̱n Paresi mogaa ka̱ lu ɗe na̱m wugo, yek Yesu ngemsi ɗe, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />&lt;&lt;Yek ɗe daamti gwaka̱n ten Almasihu ye? Yen ga̱ wok ɗe ti wo?&gt;&gt;</para>
  <para style="p" vid="MAT 22:42">Yek sa̱ ballit ɗe, &lt;&lt;Yen ga̱ Dauda,&gt;&gt; ka̱n. <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />Yek ta̱ wulsi ɗe, &lt;&lt;Yek laki yek Shishi ga̱ Nya lak Dauda ten mbet gwas ɗe &lt;Bagaa&gt; ye? Na̱k ɗe Dauda dla̱m ɗe,<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />&lt;&lt; &lt;Bagaa hwi Bagaa gi ɗe,</para>
  <para style="q2" vid="MAT 22:44">Da̱m ten ka̱t ang shinti gini</para>
  <para style="q1" vid="MAT 22:44">se a palli ma̱n nget jwa</para>
  <para style="q2" vid="MAT 22:44">a atl ɗaaki.&gt; &gt;&gt;<verse eid="MAT 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 22:45" />&lt;&lt;Ɗe kume Dauda mbet ɗe, &lt;Bagaa&gt; go, ɗa̱ nii ka̱n ta̱ nit ɗe yen gwi?&gt;&gt; <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Yek ba̱ ma̱lgon manit balla̱t ilgon so. Kan ten cin gwisi yek ba̱ gon gwasa̱n po mbi nda̱li gahwula̱n ngemti gwas ten bi ilgon so.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Yesu ɓuli ma̱n yisti Mba̱t Ga̱ɓa ga̱ Musa suk ma̱n Paresi gal ɗa̱ gaa ka</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Ɗe mbala̱n mogaa wonti suk mil lishti jwas wugo, yek Yesu wulsi ɗe, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />&lt;&lt;Ma̱n yisti Mba̱t Ga̱ɓa ga̱ Musa suk Ma̱n Paresi ka̱ɗe ma̱jwe Nya ba̱lsi iko mbokti ang ten Mba̱t Ga̱ɓa wu. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Ten na̱k gwisi ka̱n, pa̱la̱n mas ilgwe asa̱ mbokikii ang dani. Koɓa̱n ga̱ɓa gwasa̱n ama ba̱k pa̱la̱n ilgwe asa̱ pa̱li wu so, na̱k ɗe ba̱sa kop ilgwe asa̱ mbok ang dani wu sowu. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Asa̱ ɓal wul ma̱n diɓa̱lti gwe a bomi kanti gaa mbala̱n wu, asa̱ zi ma̱n kanti ka̱ yal. Ama ba̱sa̱ zi ma̱n kanti wuli ang so ko ta̱ na̱ yen ang.<verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />&lt;&lt;Mas wul jwe asa̱ pa̱li go ten ɗe ta̱ mbala̱n yensi ɗa ka̱n. Asa̱ ɓal bal kumshi taka̱rda gwe sa̱ lish ga̱ ga̱ɓa ga̱ Nya a giɓi wu, asa̱ ɓal ten bicina jwasa̱n. Asa̱ pa̱l tlal rasa gwe a ta̱n atl wu, ɗa̱n ten bi luka̱l jwasa̱n ka. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Sa̱ lam gobdlan ji kiɗi mbala̱n ka̱ lu biki, asa̱ lam mbuni gobdlan ka̱ lu motgaa jwasa̱n hwo. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Asa̱ lami ɗe ta̱ ngusi ga̱ɓet gwasa̱n ka̱ motgaa ga̱ wonti mbala̱n ta̱s mbesi ɗe, &lt;Ma̱n lishti.&gt;<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />&lt;&lt;Ama kii wo ba̱ ma̱lgon mbekii ɗe, &lt;Ma̱n lishti so,&gt; ten ɗe kii wo Bagaa gwaka̱n ɗe na̱m ka̱n, mas jwaka̱n wo yilkeni ka̱n. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />A ba̱k mbe ma̱lgon ten dii atl ge ɗe, &lt;Aba&gt; so, Aba gwaka̱n wo ɗe na̱m ka̱n gwe ni ta̱ to nya ka̱wu. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />A ba̱s mbekii ɗe &lt;bacina&gt; so, Ten ɗe na̱ ngus ka̱ɗe bacina gwaka̱n. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Ma̱lgwe tik ɗe kakshe gwaka̱n go ta̱s da̱mikii ɗe zhel. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Mas ma̱lgwe ba̱l nalti gaa gwas go, sa shitit gaa sut atli. Ama mas ma̱lgwe shit gaa gwas sut atl go, sa palla̱t ɗe kakshe.<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />&lt;&lt;Kii wo wul cit gonti ka̱n, kii ma̱n yisti mba̱t ga̱ɓa ga̱ Musa suk ma̱n Paresi, kii ma̱n pa̱lti riya! Ka̱a̱ yitle mbala̱n dla̱bii tet ka̱ guu ga̱ nya ka. Kii gaa gwaka̱n wo ka̱a̱ te so, a ba̱ka̱a̱ zak ma̱jwe sa̱ na̱ma lamti tet wu ta̱s te so. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />Kii wo wul cit gonti ka̱n, kii ma̱n lishti Mba̱t Ga̱ɓa ga̱ Musa suk ma̱n Paresi, kii ma̱n pa̱lti riya! A ka̱a̱ nguki wul ang modli jwe kos ma̱shisi ka̱wu ka, aka̱a̱ ngusi pa̱lti tlal ngemti Nya ten ɗe ta̱ mbala̱n yenkii ɗa. Ten na̱k gwisi ka̱n, sa nolkii na̱ bomti i'e.<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">Ka̱ lishti jon ji cina wo ndati ɗe 14 ni ɗa̱ so </char></note><verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />&lt;&lt;Kii wo wul cit gonti ka̱n, kii ma̱n yisti Mba̱t Ga̱ɓa ga̱ Musa suk ma̱n Paresi, kii ma̱n pa̱lti riya! Aka̱a̱ ɗakci bal ze, aka̱a̱ li dlenti ba̱n ten ɗe ta̱k mbi ma̱n kopti ɗe na̱m. Ama kume ma̱li te ka̱ koptisi wugo, aka̱a̱ palla̱t ɗe yen buu wutu mankii gaa gwaka̱n asa̱mi ɗe lop.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />&lt;&lt;Kii wo wul cit gonti ka̱n, kii dwa bacina! Ka̱a̱ wuli ɗe, &lt;Mas ma̱lgwe mo ga̱ɓa suk lubii ga̱ Nya go ilgon ni ɗa̱ so, ama ma̱lgwe mo ga̱ɓa na̱ zinariya gwe ni ka̱ lubii ga̱ Nyami go, ngetli ka̱n ta̱s pa̱l ilgwe ta̱ wuli ɗe ta pa̱li wu.&gt; <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Kii dwa ka̱dla̱n gwik ɗe kakshe gwi, zinariye ya ko lubii ga̱ Nyami ɗe a palli zinariye zoki wu? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Ka̱a̱ po wuli ɗe, &lt;Kume mbala̱n mo ga̱ɓa na̱ bagadi go ilgon ka̱ so, ama kume mbala̱n mo ga̱ɓa na̱ wul gwe sa̱ taki Nya ten bagadi go ngetli ka̱n ta̱s pa̱l ilgwe ta̱ wuli ɗe ta pa̱li wu.&gt; <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Kii dwa! Gwik ɗe kakshe gwi, ilgwe sa̱ taki Nya gwa ko bagadi ɗe a palli ili zoki wu? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Ten na̱k gwisi ka̱n ma̱lgwe mo ga̱ɓa na̱ bagadi go ma̱li mo ga̱ɓa na̱ nali suk mas ilgwe ni dani wu. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />A ma̱lgwe mo ga̱ɓa na̱ lubii ga̱ Nya go, ma̱li mo ga̱ɓa na̱ nali suk ma̱lgwe a ta̱ da̱m giɓi wu. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />A mas ma̱lgwe mo ga̱ɓa suk nya go, ma̱li mo ga̱ɓa na̱ gobdlan guu ga̱ Nya suk Nya gaa gwasi.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />&lt;&lt;Kii wo wul cit gonti ka̱n, kii ma̱n mbokti ang ten Mba̱t Ga̱ɓa ga̱ Musa suk ma̱n Paresi, kii ma̱n pa̱lti riya! Aka̱a̱ ba̱l zakka ga̱ wul yaji suk daa wolo, ama yek ka̱a̱ zak wul jwe mbun mani ka̱ Mba̱t Ga̱ɓe wu. Ka̱a̱ zak pa̱lti gem, suk yenti gonti suk nga̱sti ten Nya. Jimi ka̱ɗe wul jwe mbun ɗe ta̱k pa̱li wu, ama ba̱k zaka̱n pa̱lti jon ju so. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Kii dwa bacina! Aka̱a̱ cinda̱l ze ga̱ tle gwaka̱n ka ten ɗe ka lak sa̱nga nak'en kwaro, ama aka̱a̱ sa̱nga rakumi!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />&lt;&lt;Kii wo wul cit gonti ka̱n, kii ma̱n mbokti ang ten Mba̱t Ga̱ɓa ga̱ Musa suk ma̱n Paresi! Kii ma̱n pa̱lti riya! Aka̱a̱ pol tukaal ga̱ kopi suk gal ka, ama tugiɓi wo ga̱ njika̱mi ka na̱ byas wul gwaka̱n suk tet ga̱zi mbala̱n suk lamti gaa gwaka̱n. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Ki dwa ma̱n Paresi! Nde na̱ polti tugiɓi ga̱ kopisi suk gali ka apaa tukaalisi poldli pak.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />&lt;&lt;Kii wo wul cit gonti ka̱n, kii ma̱n mbokti ang ten Mba̱t Ga̱ɓa ga̱ Musa suk ma̱n Paresi, kii ma̱n pa̱lti riya! Kii wo na̱k gazukɗi jwe sa̱ ɓesi hwol atl wu ka̱n, ham ka̱a̱ ta̱n yeni tu tukaal hwo, ama tugiɓi wo is ji ma̱jwe ma̱sh wu suk mas wunda̱l ga̱ da̱ska̱n wonti ka̱ni giɓi. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Na̱k gwisi ka̱n tu tukaal gwaka̱n wo aka̱a̱ mboki ang mbala̱n ɗe kii wo ma̱n pa̱lti wul ndakce ka̱n, ama tu tugiɓi wo ka̱a̱ njika̱n na̱ shelti mbala̱n suk ngalci.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />&lt;&lt;Kii wo wul cit gonti ka̱n, kii ma̱n mbokti ang ten mba̱t ga̱ɓa ga̱ Musa suk ma̱n Paresi, kii ma̱n pa̱lti riya! Aka̱a̱ kin gazukɗi ji ma̱n dla̱mti ga̱ɓa ga̱ Nya, aka̱a̱ ɓe gazukɗi ji ma̱n pa̱lti wul ndakce ado. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Aka̱a̱ wuli ɗe, &lt;Ma na̱n ɗa ka̱a̱ multi ji ma̱n za̱t jina̱n go, mi wo ma mo ang suksi ten tlot ji ma̱n dla̱mti ga̱ɓa ga̱ Nya so.&gt; <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Na̱ nu ka̱n ka̱a̱ mbok ang ɗe kii wo mil ji ma̱jwe sa tlo ma̱n dla̱mti ga̱ɓa ga̱ Nya ju ka̱n. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Ten na̱k gwisi ka̱n paka̱n pa̱lti ilgwe ma̱n ngalci suk ma̱n za̱t jwaka̱n lak zhile wu!<verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />&lt;&lt;Kii wuci, mil woka̱nzi na̱k kii nini! Ɗa̱ nii ka̱n kaa yilli gaa gwaka̱n ɗa̱ka̱ nolti ga̱ buu wutu ka̱ gwi? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Ten na̱k gwisi ka̱n ba shinikii lu na̱ ma̱n dla̱mti ga̱ ga̱ɓa Nya, suk ma̱n ɓotlka̱n yisti wul, suk ma̱n mbokti ang ten mba̱t ga̱ɓa ga̱ Musa. Kaa tlo jon jwasa̱n, akaa ɓak jon jwasa̱n ka ten guda̱l yencin, a jon jwasa̱n wo kaa ɓosi ɗa̱nka̱ lu motgaa jwaka̱n ka, kaa ngusisi kopti gwasa̱n ba̱n-ba̱n aka̱a̱ laksi ka̱ bomti. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Ba shin ma̱ jwisi suɗi ten ɗe ta̱ mas hwulan ji ma̱n pa̱lti wul ndakce jwe sa tlosi ten dii atl wu da̱mikii gaa. Kan tet ten hwulan ga̱ Habila ma̱n pa̱lti wul ndakce, hal yek la ga̱ Zakariya yen ga̱ Berekiya, ma̱lgwe ka̱a̱ tlot ka ka̱ dlo ga̱ lu ma̱n cilti suk bagadi takti wul Nya wu. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Gem amik ka hwikii ge, mas wul jimi a mbi mbala̱n ji se.<verse eid="MAT 23:36" /></para>
  <para style="s">Yesu hwotdli na̱ Wurshelima i'e</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />&lt;&lt;Anya ma̱n Wurshelima, ma̱n Wurshelima! Ba̱n ma̱n tlot ɗa̱ ma̱n dla̱mti ga̱ɓa ji Nya, suk lakti ga̱ ma̱jwe sa̱ shinsi malki wu na̱ ye! Kangwe a lami ɗe ta moo mil jwa ɗe na̱m, na̱k gwe a kol moo mil jwas ka̱ bibaku gwas wu, ama yek ka̱ nge wu. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Ɓo yeni, ningo sa̱ zakik lubii gwa ɗe kupayi wi. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Ten na̱k gwisi ka̱n, amik ka hwikii ge, kaa po yena̱n so se gas gwe ka̱a̱ wuli ɗe, &lt;Ma̱n albarka ka̱ɗe ma̱lgwe na̱ma tulti na̱ shin ga̱ Bagaa wu.&gt; &gt;&gt;<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">Yesu dla̱m kangwe sa̱ jek lubii ga̱ Nya ka̱wu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Ɗe Yesu zak lubii ga̱ Nya wu, ta̱ na̱ma za̱tgaa nugo yek mil lishti jwas mbokit ang ten kinti bii jwe ni ka̱ lubii ga̱ Nyami wu. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Yek Yesu wulsi ɗe, &lt;&lt;Ka̱a̱ yen kinti bii jee ya! Gem amik ka hwiki ge, ko sa zak ye gon ten gon so, sa cac-cati ka mas.&gt;&gt;<verse eid="MAT 24:2" /></para>
  <para style="s">Ndat zhila tlat bomti</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Ɗe Yesu da̱m na̱ zhila ten Za̱nda̱l Tla̱nda̱l Zetun wu, yek mil lishti jwas li malti si na̱ ngusa̱n. Yek sa̱ wulti ɗe, &lt;&lt;Hwini, a gasi ka̱n ilga̱mi a pi gwi? Yek ɗe lal ga̱ palti gwa suk ga̱ pakti dii atl gwi?&gt;&gt;<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Yek Yesu ballisi ɗe, &lt;&lt;Da̱ma̱n na̱ ka̱ng gaa ba̱k zaki ni a ma̱lgon shelkii so. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Ten ɗe mbala̱n wonti a tul na̱ shin gini, a ngusi wulti ɗe, &lt;Amik ɗe Almasihu,&gt;<note caller="+" style="f"><char style="fr" closed="false">24:5 </char><char style="ft" closed="false">Sogo</char><char style="fqa" closed="false">Kiristi</char><char style="ft" closed="false">. Na̱k gwisi ni ka̱ ndati 23</char></note> asa̱ shel mbala̱n wonti wu. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Kaa kum wonti dlanti suk wonti ga̱ɓa ten bi dlanti, ama ba̱ hwotkii so. Ngetli ka̱n ta̱ wul jwisi pi, ama paktisi ɓo tul so. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Mbala̱n a tli mbala̱n jon gaa, a guu tli guumi jon gaa. A pa̱l kuza̱n suk nwuti ga̱ atl ɗa̱nka. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Mas wul jimi wo ndat zhila tlat bomti ka̱ yi.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />&lt;&lt;Apaa sa̱ lakkii ka̱ ang ga̱ ma̱jwe a nolkii wu hal asa̱ tlokii. Mas mbala̱n a ngekii ten bi gini. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Ka̱ sa'i gwisi wo mbala̱n wonti a pal na̱ kaali, sa ba̱l bi ga̱ yilkeni jwasa̱n, asa nge yilkeni jwasa̱n. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Ma̱n dla̱mti ga̱ɓa ga̱ Nya ji lali wonti a yili asa shel mbala̱n wonti. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Na̱k ɗe pa̱t ngalci a mba̱ldli i'e wu, lamti ga̱ mbala̱n wonti a nda̱ɗi ka. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Ama mas ma̱lgwe dlo mbadli yek ta̱ ta̱le paktisi go ta mbi kisti. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Asa lak cin ten ta̱mi ga̱ɓa ga̱ guu ga̱ Nya mal mas mbala̱n, ta̱ da̱misi ɗe sheda apaa paktisi tuli.<verse eid="MAT 24:14" /></para>
  <para style="s">Byas bomti</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />&lt;&lt;Ten na̱k gwisi ka̱n, kume ka̱a̱ yen &lt;lili wul cit daɗi,&gt; gwe Daniyel ma̱n dla̱mti ga̱ɓa ga̱ Nya dla̱m ɗe sa dla̱lli ka̱ Lu ma̱n Cilti wu,<note caller="+" style="f"><char style="fr" closed="false">24:15 </char><char style="ft" closed="false">Yen</char><char style="xt" closed="false"><ref loc="DAN 9:27">Dan 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="DAN 12:11">12:11</ref></char></note> ta̱ ma̱lgwe na̱ma dla̱mti lishti wu yis gaami, <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />ta̱ ma̱jwe ni Yehudiya wu ap to ka̱ tla̱da̱l ka. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Ba̱ ma̱lgwe ni ten gaa bii wu, wuli ɗe ta suk kan ilgon a giɓ boo so. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Ba̱ ma̱lgwe ni ka̱ zhin wu wule ta pal tet lubii ta̱s kan godo gwas so. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Modli ma̱n mil tuk suk ma̱n mil kaal a da̱m ɗe wul cit gonti ka̱ multi jwisi. <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Ngema̱n Nya ɗe ba̱ apti gwisi tulikii ka̱ sa'i nda̱ɗiti sogo ten cin shukti so. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Na̱k ɗe ka̱ sa'isi wo mbala̱n a te ka̱ bomti ma̱n ciciti, wunda̱li gwe ba̱ ɓo taɓa pa̱t so tun na̱k sa̱ lak zhila ga̱ dii atli hal ase wu, a ba̱ gon a po tul na̱k gwisisi sowu. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Sa hul wonta̱t ga̱ multi jwisi ka̱ sogo, ko ma̱lgon a sa kaami so, ama ten bi ga̱ mbala̱n ji botlisi yek laki yek sa hul wonta̱t ga̱ multi jwisi ka. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />Ka̱ multi jwisi wo kume ma̱lgon wulkii ɗe, &lt;Ɓo yeni ni, Almasihu ka̱ ka̱wu aɗe sogo te duk go!&gt; Ba̱k kama̱n so. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Na̱k ɗe Almasihu ji lali suk ma̱n dla̱mti ga̱ɓa ga̱ Nya ji lali wonti a yili. Asa̱ pa̱l kiɗi lali suk wul ngipti ang bi ta̱s gilli mbala̱n ɗa, hal kume ma̱n pa̱t ka̱ go sa gilli mbala̱n ji botli pak. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />To ɓo yeni ni, yekgu a hwikii wi ba̱le.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />&lt;&lt;Ten na̱k gwisi ka̱n, kume sa̱ wulkii ɗe, &lt;Tik tek gu te ka̱ la̱p ka̱wu,&gt; ba̱k la̱n so. A kume sa̱ wulkii ɗe, &lt;Ta̱ni to ka̱ punka ga̱ hwunda̱li ka̱wu,&gt; ba̱k kama̱n so. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Na̱k ɗe na̱k kangwe a nyaze cibi, a cilli lu gaba̱s suk yemma wu, na̱k gwisi ka̱n palti ga̱ Yen ga̱ Mbala̱n ani. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Ai mas lu gwe hwu tlu ni go, ka̱li ka̱n a zhipki mogaa.<verse eid="MAT 24:28" /></para>
  <para style="s">Palti sut ga̱ Yen ga̱ Mbala̱n</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />&lt;&lt;Na̱ pakti tlat bomti giɓi jimi,</para>
  <para style="q1" vid="MAT 24:29">&lt;&lt; &lt;Cin a pal duuni</para>
  <para style="q2" vid="MAT 24:29">a ba̱ lip a po cil so.</para>
  <para style="q1" vid="MAT 24:29">kyadla̱l a lok sut nya,</para>
  <para style="q2" vid="MAT 24:29">Sa nwu kiɗi wul ji nya.&gt;<verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />&lt;&lt;Apaa ka̱ yen lal ga̱ Yen ga̱ Mbala̱n ka̱ dlo nya, mas mbala̱n ji dii atl kul ten ɓanti. Sa yen tulti ga̱ Yen ga̱ Mbala̱n ten nyaze, na̱ iko suk nalti i'e. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Ta̱ shin mil shinti jwasi asa̱ hot noo teti, asa̱ moo mbala̱n ji botli jwas tet tu gaba̱s suk yemma suk kudu suk arewa, suk tet ten mas dii atli.<verse eid="MAT 24:31" /></para>
  <para style="s">Mbokti ang ten tlindi tula̱n</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />&lt;&lt;Ta̱ tlindi tula̱n da̱mikii ɗe wul mbokti ang, kume mil ang gwas ɓa pal zela̱ɗi yek nda telti daa wugo, a ka̱a̱ yisi ɗe watla̱n ɓal njaa. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Na̱k gwisi ka̱n, hal kume ka̱a̱ yen mas wul jimi ɗe a hwikii wu ten pa̱t wugo, yisi ɗe sa'isi ɓal njaa, ɓal ten bi dlabii. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Gem amik ka hwikii ge, mbala̱n ji se a ma̱sh so, se mas wul jin pi pa. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Dlo nya suk dii atl a taas ka, ama ga̱ɓa gi wo a taasdli so ko njet.<verse eid="MAT 24:35" /></para>
  <para style="s">Ma̱lgon yis sa'i gwe Yesu a pal wu so</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />&lt;&lt;Ma̱lgon yis cimi sogo sa'isi gwe wul jimi a pi wu so, na̱ mil shinti ji Nya, hal Yeni se Abe na̱ ngusi. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Na̱k kangwe pi ka̱ multi ji Nuhu go, na̱k gwisi ka̱n a pi ten palti ga̱ Yen ga̱ Mbala̱n. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Tun ka̱ sa'i gwe ba̱ ze ga̱ Nuhu ɓo yitla dii atl ka̱ sowu, mbala̱n na̱ma ngukti wul asa̱ na̱ma tlati, asa̱ na̱ma pa̱lti hapti, asa̱ na̱ma hapti ka hal yek la sa'i gwe Nuhu te ka̱ jirgi ze wu, <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />a ba̱sa̱ yisi ɗe ilgon a pi so, se na̱k zesi tuli yek yemsi ka̱wu. Na̱k gwisi ka̱n a pi ten palti ga̱ Yen ga̱ Mbala̱n. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Ka̱ sa'i gwisi wo mbala̱n ɗe lop ani ka̱ zhin, sa kan gon asa̱ zak gon. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Modli ɗe lop a nima na̱kti hwo ten hwo, sa kan gon asa̱ zak gon.<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />&lt;&lt;Ten na̱k gwisi ka̱n, da̱ma̱n na̱ ka̱ng gaa na̱k ɗe ba̱ka̱a̱ yis cin gwe Bagaa gwaka̱n a pal dani wu sowu. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Ama yisi ɗe, ai ba boo a yisa̱n ka̱ sa'i gwe muka̱l a tul wugo, ta zakini a yemba̱l kanti so, a ba̱ta zaki a muka̱li tet ka̱ lubii so. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Na̱k gwisi ka̱n, kii mago da̱ma̱n na̱ ka̱ng gaa ko a gasi, na̱k ɗe Yen ga̱ Mbala̱n a tul ka̱ sa'i gwe ba̱ka̱a̱ zi ɗe ta tul wu sowu.<verse eid="MAT 24:44" /></para>
  <para style="s">Zhel ma̱n pa̱lti gem suk ma̱n la̱shi pa̱lti gem</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />&lt;&lt;Wok ɗe zhel ma̱n pa̱lti gem, ma̱n ɓolka̱n yisti wul, gwe bagaa gwas a zak zhel jwas ka̱ ang gwasi ɗe ta̱s ba̱lsi wul ga̱ nguki ka̱ sa'i ngukti wul gwi? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Ma̱n albarka ka̱ɗe zhel gwe bagaa gwas a pali ata̱ mbit ten pa̱lti ilgwe ta̱ zit wu. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Gem amik ka hwikii ge, ta palla̱t ɗe bacina ten mas wul gwasi. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Ama kume ɗe zheli wo ma̱n ngalci ka̱wu ta̱ dla̱m ka̱ mbadl gwas ɗe, &lt;Bagaa gi a pal ba̱le so,&gt; <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />yek ta̱ nda ɓot ɗa̱ zhel yilkeni jwasi yek ta̱ njel ngukti wul ata̱ na̱ma tlatdli suk ma̱n tlati-tlati. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Bagaa ga̱ zheli a pal ten cin gwe ba̱ta̱ zi ɗe ta pal dani sowu, ka̱ sa'i gwe ba̱ta̱ yisi sowu. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Bagaami a pa̱lit byas ɓoti ata̱ nolti suk ma̱n pa̱lti riya, ka̱li ka̱n ta kuli ta̱ as ang bi.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">Cinga̱lti ga̱ɓa na̱ mil modli ɗe kult</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />&lt;&lt;Ka̱ sa'isi wo guu ga̱ Nya a ni na̱k mil modli ɗe kult jwe sa̱ yem pitila jwasa̱n ta̱s sa ɓa̱tti ga̱ yen kos wu. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Ɗe namtan ka̱si wo ka̱dla̱n ka̱n, a ɗe namtam wo ɓotli. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Ka̱ sa'i gwe ka̱dla̱mi ju ɓa kan pitilla jwasa̱n go yek ba̱sa̱ kan mil gwe sa mba̱li ka̱ pitile wu ang so. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Ama ma̱n ɓotlka̱n jo yek sa̱ kan mili ɗa̱nka̱ bunta̱n mil jwasa̱n ka, ɗe sa̱ ɓa kan pitila jwasa̱n wu. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Yek ba̱ yen kosi tul ba̱le so, yek mas mil modlisi njel pa̱t genga̱ɗi hal yek sa̱ yemba̱l ka mas jwasa̱n.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />&lt;&lt;Ɗe te ka̱ dlo gas ka ka̱ ɓal go, yek sa̱ kum shele ɗe, &lt;Yen kosi ka̱ ɓal wu, la̱n teɗi ta̱k mbiti.&gt;<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />&lt;&lt;Yek mil modlisi tlinya mas jwasa̱n yek sa̱ njel la̱ka̱nti pitila jwasa̱n. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Yek ka̱dla̱mi ju wul ma̱n ɓotlka̱n ju ɗe, &lt;Nak ɓesini mil jwaka̱n ne, pitila jina̱n na̱ma ma̱shka̱n.&gt;<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />&lt;&lt;Yek sa̱ wulsi ɗe, &lt;Wowo, mili a kumini sukkii so. Kaa sak wul gwaka̱n tet mal ma̱n wulti ka̱wu a mani.&gt;<verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />&lt;&lt;Ɗe sa̱ sa wulti mili wugo yek yen kosi mbuk lu. Yek ma̱jwe ta̱ mbisi na̱ shiri wu te ka̱ lu biki sukti, yek paa sa̱ le dlabii ka.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />&lt;&lt;Ka̱ kaali wo yek ka̱dla̱n mil modli ju pali, yek sa̱ wuli ɗe, &lt;Bagaa, Bagaa, nak ɓulini dlabii ka!&gt;<verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />&lt;&lt;Ama yek ta̱ wulsi ɗe, &lt;Gem, amik ka hwikii ge, a yiskii so.&gt;<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />&lt;&lt;Ten na̱k gwisi, se ta̱k da̱ma̱n na̱ ka̱ng gaa, na̱k ɗe ba̱ka̱a̱ yis cimi sogo sa'isi sowu.<verse eid="MAT 25:13" /></para>
  <para style="s">Mbokti ang ten pa̱lti gem</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />&lt;&lt;Na̱k gwisi ka̱n, guu ga̱ Nya wo na̱k ma̱lgwe a pi tafiya yek ta̱ mbe zhel jwasi, yek ta̱ zak wul ang gwas ka̱ ang jwasa̱n wu ka̱n. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Yek ta̱ hwulisi wulpi zinariya. Ta̱ ba̱l gon gwasa̱n ngura zinariya ɗe namtam, ta̱ ba̱l gon ngura zinariya ɗe lop, yek pa ta̱ ba̱l gon ngura zinariya ɗe na̱m. Ta̱ ba̱lsi na̱k gwisi, ko wokko ten nda̱lti gwasi yek pa zigaa. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Yek ma̱lgwe ta̱ ba̱lti wulpi ngura zinariya ɗe namtam wu kan gwas wu, yek ta̱ ngusi wulti wul ka na̱ nali hal yek ta̱ mbi wulpi ngura zinariya ɗe namtam dani. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Nu ka̱n ma̱lgwe ta̱ ba̱lti ngura ɗe lop wu pa̱li, ti mago yek ta̱ mbi mba̱lti wulpi zinariya ngura ɗe lop dani. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Ama yek ma̱lgwe kan wulpi ngura zinariya ɗe na̱m wu lak ɗuk shu ka̱ atli, yek ta̱ hwunda̱l wulpi ga̱ ba boo gwas ka a giɓi.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />&lt;&lt;Pa̱l tlal multi wugo yek ba boo ga̱ zhel jwisi pali ta̱s dla̱m wulpi suksi. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Yek zhel gwe kan wulpi ngura zinariya ɗe namtan wu te malti yek ta̱ ba̱lti zinariya jon ɗe ngura namtan ɗa, yek ta̱ hwit ɗe, &lt;Ba boo gini, ka̱ ba̱la̱n wulpi ngura zinariya ɗe namtan. Ama yekgu a mbi ɗe ngura namtan dani wi.&gt;<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />&lt;&lt;Yek ba boo gwas wulti ɗe, &lt;Madalla, hwa zhel ma̱n pa̱lti gem, ka̱ pa̱l gem ten wul njet, ningo ba palla̱k ɗe bagaa ga̱ wul wonti. Te sut mala̱nni ta̱k tla ta̱mi mbadl ga̱ ba boo gwa!&gt;<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />&lt;&lt;Yek zhel gwe kan wulpi ngura zinariya ɗe lop wu te malti, yek ta̱ ba̱lti zinariya jon ngura ɗe lop ɗa, yek ta̱ hwit ɗe, &lt;Ba boo gini, ka̱ ba̱la̱n wulpi ngura zinariya ɗe lop. Ama yekgu a mbi ngura ɗe lop dani wi.&gt;<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />&lt;&lt;Yek ba boo gwas wulti ɗe, &lt;Madalla, hwa zhel, ma̱n pa̱lti gem, ka̱ pa̱l gem ten wul njet, ningo ba palla̱k ɗe bagaa ga̱ wul wonti. Te sut mala̱nni ta̱k tla ta̱mi mbadl ga̱ ba boo gwa!&gt;<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />&lt;&lt;Yek ma̱lgwe kan wulpi ngura zinariya ɗe na̱m wu tuli. Yek ta̱ dla̱m ɗe, &lt;Ba boo, a yisi ɗe ki wo wunda̱l ma̱lgwe ba̱ mbala̱n a yis gaa gwas sowu ka̱n, a ka̱ wotl zhin ka̱ lu gwe ba̱ka̱ ɓak sowu, a ki wo ma̱n lamti wul ga̱ ten koo lu ka̱n. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Na̱k gwisi ka̱ laki yek ɓanti cinni yek a sak ɗuk shu ka̱ atli, yek a hwunda̱l ngura zinariya gwa ka a giɓi. Ningo kan il gwa.&gt;<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />&lt;&lt;Yek ba boo gwas wulti ɗe, &lt;Ki wo byas zhel ma̱n laka̱l! Ashe ka̱ yisi ɗe ami wo a wotl zhin ka̱ lu gwe ba ɓak sowu, a mo wul ka̱ lu gwe ba̱ cat wunda̱l so gwa? <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Ai da ka lakini nini wulpi gi ka̱ banki, kangwe ɗe ba pal wugo a mbi mba̱lti ten gaami wu.&gt;<verse eid="MAT 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28" />&lt;&lt;Yek ba boomi wuli ɗe, &lt;Kama̱n wulpi ɗa̱ka̱ ang gwas ka, ta̱k ba̱la̱n ma̱n ngura ɗe kutl wu. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Ten ɗe mas ma̱lgwe ilgon niɗɗa̱ go sa mba̱liti ta̱s mbi nal. Ama ma̱lgwe ilgon niɗɗa̱ sowu go, na̱k ilgwe niɗɗa̱ wu mago sa kamit ɗa̱ ang ka. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Ningo laka̱n zhel ga̱ ten koo lu wu, te ka̱ duu da̱mshal ka. Aduk ka̱n ta kuli ata̱ as ang bi.&gt;<verse eid="MAT 25:30" /></para>
  <para style="s">Kisti ga̱ɓa ten cin ga̱ ayo</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />&lt;&lt;Sa'i gwe yen ga̱ mbala̱n a tul ka̱ nalti gwasi suk mas mil shinti ji Nya wu, ta da̱m ka̱ gobdlan guu gwas ma̱n nalti. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Sa moo mas mbala̱n ji dii atl a cina gwasi, ta hwulsi kak-kak na̱k kangwe a ma̱n kyo hwul mba̱la suk mal wu. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Ta wut mba̱le tu ten ang shinti, ata̱ wut mali tu ten ang yali gwasi.<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />&lt;&lt;Apaa guumi wul ma̱jwe sa̱ ni tu ten ang shinti gwas wu ɗe, &lt;La̱n teɗi, kii ɗe Aba pa̱likii albarka wu! Kama̱n guu gwe sa̱ shiryekii tun ba̱sa̱ ɓo pa̱l dii atl sowu. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Ten ɗe kuza̱n tloni yek ka̱a̱ ba̱la̱n ilga̱ nguki, a ka̱lka̱ze tloni yek ka̱a̱ ba̱la̱n ze yek a tla, a ni ɗe ma̱nda̱ki yek ka̱a̱ kama̱n ka̱ lubii gwaka̱n, <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />ɗe luka̱l ni ɗa̱ sowu yek ka̱a̱ ba̱la̱n luka̱l, a pa̱l cwo yek ka̱a̱ ga̱ɓeni, ani ga̱ le ka yek ka̱a̱ sa yenti gini.&gt;<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />&lt;&lt;Apaa ma̱n pa̱lti wul ndakce ballit ɗe, &lt;Bagaa, a gasi ka̱n ma̱ yenki a kuza̱n na̱ma tlot gwa yek ma̱ ba̱lki ilga̱ nguki, sogo a ka̱lka̱ze na̱ma tlot gwa yek ma̱ ba̱lki ze yek ka̱ tla gwi? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />A agasi ka̱n ma̱ yenki aka̱ ni ɗe ma̱nda̱ki yek ma̱ kanki ka̱ lubii ga̱na̱n, sogo a ba̱ luka̱l nik ɗa̱ so yek ma̱ ba̱lki luka̱l gwi? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />A gasi ka̱n ma̱ yenki aka̱ na̱ma cwo sogo ga̱ le ka yek ma̱ sak yenki gwi?&gt;<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />&lt;&lt;Guumi a ballisi ɗe, &lt;Gem amik ka hwiki ge, na̱k ɗe ka̱a̱ pa̱li na̱k mil yilkeni ji jee go, ami ka̱n ka̱a̱ pa̱lini.&gt;<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />&lt;&lt;Apaa guumi wul ma̱jwe sa̱ ni tu ten ang yali gwas wu ɗe, &lt;Tli ɗa̱ mala̱n ka, kii ɗe bi nikii gaa wu, te teka̱ buu wutu gwe ba̱ a mba̱shdli sowu gwe sa̱ pa̱li sheɗan suk mil shinti jwas ju. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Ten ɗe kuza̱n tloni yek ba̱ka̱a̱ ba̱la̱n ilga̱ nguki so, a ka̱lka̱ze tloni yek ba̱ka̱a̱ ba̱la̱n ze yek a tla so, <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />a ni ɗe ma̱nda̱ki yek ba̱ka̱a̱ kama̱n ka̱ lubii gwaka̱n so, ɗe luka̱l ni ɗa̱ sowu yek ba̱ka̱a̱ ba̱la̱n luka̱l so, a pa̱l cwo yek ba̱ka̱a̱ kula so, ani ka̱ lu leti ka yek ba̱ka̱a̱ sak yena̱n so.&gt;<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />&lt;&lt;Si mago, sa ballit ɗe, &lt;Bagaa, a gasi ka̱n ma̱ yenki a kuza̱n na̱ma tlot gwa yek ba̱ma̱ ba̱lki ilga̱ nguki so, sogo a ka̱lka̱ze na̱ma tlot gwa yek ba̱ma̱ ba̱lki ze yek ka̱ tla so, sogo aka̱ ni ɗe ma̱nda̱ki yek ba̱ma̱ kanki ka̱ lubii ga̱na̱n so, sogo a ba̱ luka̱l nik ɗa̱ so yek ba̱ma̱ ba̱lki luka̱l so, sogo aka̱ na̱ma cwo sogo aka̱ ni ga̱ le ka yek ba̱ma̱ sak yenki so gwi?&gt;<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />&lt;&lt;Apaa ta̱ ballisi ɗe, &lt;Gem amik ka hwiki ge, na̱k ɗe ka̱a̱ nge pa̱lti na̱k mil yilkeni ji jee wu, ami ka̱n ka̱a̱ nge pa̱lti.&gt;<verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />&lt;&lt;Ma̱ jimi a te ka̱ bal bomti gwe ba̱ pakti niɗɗa̱ sowu, a ma̱n pa̱lti wul ndakce te ka̱ da̱mti gwe a paki sowu.&gt;&gt;<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Bacina ji ma̱n Yehuda dla̱lli ga̱ɓa ɗe ta̱s tlo Yesu ka</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Ɗe Yesu pak dla̱mti mas ga̱ɓa jimi wu, yek ta̱ wul mil lishti jwas ɗe, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />&lt;&lt;Ka̱a̱ yisi ɗe biki ɗakciti wo multi ɗe lop ka̱ ɓali, asa ba̱l Yen ga̱ Mbala̱n ta̱s pakti ten guda̱l yencin.&gt;&gt;<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Yek kiɗi ma̱n Pa̱ris suk bacina ji mbala̱n mogaa ka̱ lubii ga̱ bali ga̱ ma̱n pa̱lti wul ka̱ biimi gwe asa̱ mbet ɗe Kayapas wu, <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />yek sa̱ dla̱lli ga̱ɓa ten kangwe sa pi asa̱ dop Yesu asa̱ tlot ka mbukli wu. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Ama yek sa̱ wuli ɗe, &lt;&lt;Ba̱ ɗe ka̱ sa'i biki so, sogo mbala̱n a tlil dlanti.&gt;&gt;<verse eid="MAT 26:5" /></para>
  <para style="s">Sa̱ tuksi Yesu mil ma̱n ta̱mi wusa̱n a Betani</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />To a Yesu ni ka̱ ba̱n Betani ka̱ lubii ga̱ ma̱lgwe asa̱ mbet ɗe Siman ma̱n gita wu, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />yek kili gon tul malti na̱ bunta̱n mili gwe sa̱ pa̱li na̱ ye onis wu, bunta̱mi ni ga̱ njikmi na̱ mil ma̱n ta̱mi wusa̱n ma̱n wulpi i'e. Ɗe Yesu ɓa nguk wul wu, yek ta̱ shotit mili sut ten gaa.<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />Ama ɗe mil lishti jwas yeni nu wugo yek mbadl lilisi yek sa̱ wul yilkeni jwasa̱n ɗe, &lt;&lt;Ai, go lilti wul ka ka̱n. <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Ten ɗe sa wulla̱n mil ga̱n ka̱ go, ai sa mbi bal wulpi asa̱ hwuli ma̱n la̱shi wul.&gt;&gt;<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Na̱k ɗe Yesu yis ilgwe sa̱ na̱ma dla̱mti wu, yek ta̱ wulsi ɗe, &lt;&lt;Yek laki ɗe ka̱a̱ na̱ma hwotti ga̱ kili ga̱n ye? Ai hwa wul ka̱n ta̱ pa̱lini. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Ma̱n la̱shi wul ni ɗa malkii ko a gasi, ama ami wo ko a gasi ka̱n bani sukkii so. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Mil ga̱n ɗe ta̱ shoti gaa wu, shiryat ka̱n ta̱ shirya dli gini ten ɗe ta̱s leɓa̱nni. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Gem amik ka hwikii ge, mas lu gwe sa lak icin ga̱ ta̱mi ga̱ɓa ga̱n ten dii atl go se sa̱ dla̱m ilgwe kili ga̱n pa̱li wu ten bi daamti gwasi.&gt;&gt;<verse eid="MAT 26:13" /></para>
  <para style="s">Yehuda ba̱l bi ga̱ Yesu</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Yek gon ka̱ mil shinti ɗe kutl cet lop ju, gwe asa̱ mbet ɗe Yehuda Iskariyoti wu li mal kiɗi ma̱n Pa̱ris, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />yek ta̱ ngemsi ɗe, &lt;&lt;Kume a ba̱lkii ti go yek kaa ba̱la̱n ye?&gt;&gt; Yek sa̱ ba̱lti wulpi hwol ga̱lla ɗe kutl ɗe mekan. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Tun tet ka̱ sa'i gwisi yek ta̱ njel ngot tantu gwe ta koɓi ta̱s ba̱lsi Yesu wu.<verse eid="MAT 26:16" /></para>
  <para style="s">Yesu nguk wul ga̱ Biki Ɗakciti suk mil lishti jwasi</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Ten cin na ɗe na̱m ga̱ Motgaa Burodi Ma̱n La̱shi Yis, yek mil lishtisi tul mal Yesu yek sa̱ wulti ɗe, &lt;&lt;A ako ka̱n ka̱ lami ɗe ta̱n shiryek ngukti wul Biki Ɗakcitisi ko?&gt;&gt;<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Yek ta̱ ballisi ɗe, &lt;&lt;Te ka̱ ba̱n mal ma̱lgon aka̱a̱ wulti ɗe, &lt;Ma̱n lishti dla̱m ɗe, sa'i gwas ɓal njaa. Ta nguk wul Biki Ɗakciti suk mil lishti jwas a lubii ɗakka.&gt; &gt;&gt; <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Yek mil lishtisi pa̱li na̱k gwe Yesu zisi wu, yek sa̱ sak shiryesi ilga̱ nguki ga̱ Biki Ɗakcitisi.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Ɗe sukti ka̱ ɓal ɗe nguktisi ka̱ ɓal wu, yek Yesu da̱m na̱ zhila suk mil lishti ɗe kutl cet lop ju ta̱s nguki. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Sa̱ na̱ma ngukti wuli nugo yek ta̱ wulsi ɗe, &lt;&lt;Gem amik ka hwikii ge, ɗe na̱m tet ka̱ kii a ba̱l bi gini.&gt;&gt;<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Yek ili hwotsi i'e, yek sa̱ ngusit wulti ɗe, &lt;&lt;Ko ami ka̱n, Bagaa?&gt;&gt;<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Yek ta̱ ballisi ɗe, &lt;&lt;Ma̱lgwe na̱ma sulti ang suk ami ka̱ gal wu ka̱ɗe ma̱n ba̱lti bi gini. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Yen ga̱ Mbala̱n a ma̱shi na̱k kangwe sa̱ lish ga̱ɓa tenti wu, ama ma̱lgwe a ba̱l bi gwas wu da̱m ɗe wul cit gonti wi! Sa za̱t so mago, da a maniti.&gt;&gt;<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Yek Yehuda, ma̱lgwe ba̱l bi gwas wu dla̱m ɗe, &lt;&lt;Ma̱n Lishti, ko ami ka̱n?&gt;&gt; Yek Yesu nda̱kit ɗe, &lt;&lt;Ka̱ dla̱m na̱ bi gwa wi ɗe ki ka̱n.&gt;&gt;<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Asa̱ na̱ma ngukti nu wu yek ta̱ kan burodi yek ta̱ pi godiya Nya yek ta̱ cac-cali, yek ta̱ ba̱l mil lishti jwasi yek ta̱ wulsi ɗe, &lt;&lt;Kama̱nni ta̱k nguka̱nni. Ga̱n go tlu dli gi ka̱n.&gt;&gt;<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Yek ta̱ kan yen mbuke yek ta̱ pi godiya Nya yek ta̱ takisi yek ta̱ wule, &lt;&lt;Tlani mas jwaska̱n. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Ga̱n go hwulan gi ka̱n, gwe yek ɗe pyal dla̱lla̱t ga̱ɓa wu. Hwulan gwe sa̱ shoti ten ɗe ta̱ mbala̱n wonti mbi taasti byas wul jwasa̱n ka̱ ɗa̱ wu. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />A ni kii ma hwiti ɗe, ndok ten ge ba po tla ze inabi so se gas gwe ba tla pyal zesi gon sukkii ka̱ guu ga̱ Aba gi wu.&gt;&gt;<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Ɗe Yesu suk mil lishti jwas wul koo wu, yek sa̱ yili, yek sa̱ to ten Za̱nda̱l Tla̱nda̱l Zetun.<verse eid="MAT 26:30" /></para>
  <para style="s">Biturus a nge yisti ga̱ Yesu</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Yek Yesu hwisi ɗe, &lt;&lt;Kaa aɓi mas jwaka̱n aka̱a̱ zaka̱n ka̱ gas ge, ten bi ilgwe a pi na̱ ami wu. Na̱k gwe ni ga̱ lishi ɗe,</para>
  <para style="q1" vid="MAT 26:31">&lt;&lt; &lt;Ba ɓo ma̱n kyoɓi,</para>
  <para style="q2" vid="MAT 26:31">a tunga mba̱la jwas cat ka̱.&gt;<verse eid="MAT 26:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />Ama kume a pal kaami wugo, ba li Galili cina ɗaakii.&gt;&gt;<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Yek Biturus wulti ɗe, &lt;&lt;Ko ta̱s ap ka mas jwasa̱n ten bi ga̱ ilgwe a mbik wu mago, ami wo ba ap so.&gt;&gt;<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Yek Yesu ballit ɗe, &lt;&lt;Gem amik hwik ge, ka nge yisti gini asa̱mi ɗe mekan ka̱ gas ga̱n a paa gunda kol nda lakti yal.&gt;&gt;<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Yek Biturus dla̱m ɗe, &lt;&lt;Ko ta̱ ma̱shka̱n ka̱n ba ma̱sh sukki, ba nge yisti gwa so.&gt;&gt; Yek mas mil lishtisi dla̱m na̱k gwas wu pak.<verse eid="MAT 26:35" /></para>
  <para style="s">Yesu ngem Nya a Gesa̱mani</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Yek paa Yesu suk mil shinti jwas li ka̱ lu gwe asa̱ mbe ɗe Getsa̱mani wu, gwe yek ɗe lu cetti mil Zetun wu. Yek ta̱ wulsi ɗe, &lt;&lt;Da̱ma̱n aɗe ami wo ba tok ngem Nya to du.&gt;&gt; <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Yek ta̱ kan Biturus suk mil ɗe lop ji Zabadi ju, ka̱a̱ Yakubu suk Yohana, yek ta̱ njel pa̱lti duu tuki yek ta̱ hwotdli i'e. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Yek ta̱ wulsi ɗe, &lt;&lt;Duu tuk gwe ni ka̱ mbadl gi wu a man tlot gini. Da̱ma̱n aɗe suk ami, ba̱k ndema̱n yemba̱l so.&gt;&gt;<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Yek ta̱ nak ɗam ɗa̱ malsi ka njet, yek ta̱ ngus atli yek ta̱ ngem Nya. Yek ta̱ wule, &lt;&lt;Aba gini, kume ɗe ma̱n pa̱t ka̱ wu, kami mbuka bomti ga̱n ka. Ko ɗe ba̱ ɗe ilgwe a lami wu ka̱n a pa̱li sowu, ama ta̱ pa̱l ilgwe ka̱ lami wu.&gt;&gt;<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Yek ta̱ pal tet mal mil lishtisi yek ta̱ mbisi ten ndet yemba̱l. Yek ta̱ ngem Biturus ɗe &lt;&lt;Ashe kaa mana̱n da̱mti kaami suk ami ko ta̱ ga̱ sa'i ɗe na̱m sa?&gt;&gt; <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Yek ta̱ wulsi ɗe, &lt;&lt;Da̱mti kaami ta̱k ga̱ɓa suk Nya, kangwe kaa te ka̱ cinga̱lti so wu. Shishi lami ama dli gwaka̱n ka̱ nda̱l so.&gt;&gt;<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Yek ta̱ pal to ka asa̱mi na lop yek ta̱ ga̱ɓa suk Nya yek ta̱ wule, &lt;&lt;Aba gini, kume ni ngetli ɗe ta tla mbuka bomti ga̱n wu. To, ta̱ ilgwe ka̱ lami wu pi.&gt;&gt;<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />Ɗe ta̱ po pal tet wu, yek ta̱ mbisi ten ndet yemba̱li ɗa, na̱k ɗe gwel jwasa̱n njika̱n ka na̱ yemba̱l wu. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Yek ta̱ zaksi ka̱li, yek ta̱ po pal te ka asa̱mi na mekan yek ta̱ ga̱ɓa suk Nya yek ta̱ kaɓa̱l ga̱ɓa gwe ta̱ dla̱m tet wu ɗa.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />Yek paa ta̱ pal te mal mil lishtisi ka yek ta̱ hwisi ɗe, &lt;&lt;Hal ninge ka̱a̱ yima ndet yemba̱l aka̱a̱ na̱ma shukti ya? To, ningo sa'isi pi wi, sa tak Yen ga̱ Mbala̱n ka̱ ang ga̱ ma̱n pa̱lti byas wul. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Tla̱nnya, ta̱n za̱ngaa! Ma̱n ba̱lti bi gi ka̱ ɓal tet wu!&gt;&gt;<verse eid="MAT 26:46" /></para>
  <para style="s">Sa̱ dop Yesu</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Ta̱ nisi ma ga̱ɓa nugo yek Yehuda, gon ka̱ ma̱n kopti jwas ɗe kutl cet lop ju mbuk lu tet malsi. Yehude tul suk wonti mbala̱n ma̱n kiɗi puka, suk sanda ɗa̱n ang jwasa̱n ka. Ma̱jwe kiɗi ma̱n Pa̱ris suk bacina ji mbala̱n ka̱ shinsi tet wu. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />To, ma̱n ba̱lti bisi dla̱lli lal suksi ten ɗe, &lt;&lt;Ma̱lgwe a njop bi gi ten kalka̱ng gwas wu ka̱ɗe ma̱li! Doɓa̱nti.&gt;&gt; <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Yehuda na̱ma mbukti lu, yek ta̱ lak ngip Yesu te dlo ka yek ta̱ wulti ɗe, &lt;&lt;Sallama gwa, Ma̱n Lishti!&gt;&gt; Yek pa ta̱ njop bi gwas ten kalka̱ng gwasi.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Yek Yesu ballit ɗe, &lt;&lt;Yela̱n gini, pa̱l ilgwe tulla̱k wu.&gt;&gt;</para>
  <para style="p" vid="MAT 26:50">Yek wonti mbala̱n ɗam teɗi, yek sa̱ dop Yesu yek sa̱ ngipti. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Sa̱ yeni nu wugo, yek gon ka̱ mbala̱n jwe sa̱ ni suk Yesu wu, yilli bal puka. Yek ta̱ wotl zhel ga̱ bal ma̱n Pa̱ris te ka̱ng ka, yek ta̱ kotlit ka̱ng ka.<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />Yek Yesu wulti ɗe, &lt;&lt;Palli bal puka gwa ka̱ ka̱pta̱mi, na̱k ɗe mas ma̱lgwe kan bal puka go, bal puka ka tlot wu. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Ka̱a̱ da̱ma̱n gwa we ba lami go ba ga̱ɓa suk Aba gini ata̱ zi-ang, ata̱ shini lu na̱ mil shinti jwas wonti man motgaa ga̱ ma̱n hapti dlo ɗe kutl cet lop sa? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Ama ɗa̱ ni ka̱n a njika̱n ilgwe ga̱ɓa ga̱ Nya dla̱m ɗe ngetli ka̱n ta̱ pi wu gwi?&gt;&gt;<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Ka̱ sa'i gwisi wo yek Yesu wul wonti mbala̱mi ɗe, &lt;&lt;Ka̱a̱ li tet na̱ kiɗi puka suk sanda ta̱k doɓa̱nni nini, ma̱n ɓa̱tti tantu ka̱ɗe ami a? A da̱m na̱ zhila ko gasi gwik-gwi ka̱ lubii ga̱ Nya, yek a mboki ang mbala̱n ten ga̱ɓa ga̱ Nya ama yek ba̱ka̱a̱ doɓa̱n so. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Ama mas wul jin pi, ten ɗe ta̱ lishti ji ma̱n dla̱mti ga̱ɓa ji Nya njika̱n ɗa.&gt;&gt; Na̱ kumti na̱k gwisi yek mil lishti jwas zakti yek sa̱ ap ka.<verse eid="MAT 26:56" /></para>
  <para style="s">Sa̱ ta̱la Yesu bal dlaboo sanhiridin</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Yek ma̱jwe dop Yesu ju ta̱lat mal Kayapas, bacina ga̱ ma̱n Pa̱ris, ka̱ li ka̱n ma̱n yisti Mba̱t Ga̱ɓa ga̱ Musa suk kiɗi ji mbala̱n mogaa. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Ama yek Biturus ngusi kopti gwasa̱n tet dlenti, hal yek ta̱ lak mbuki ka̱ dii boo lubii ga̱ bacina ga̱ ma̱n pa̱lti wul ga̱ lubii ga̱ Nyami. Yek ta̱ da̱m atl mal ma̱n ɓa̱tti lubii ga̱ Nya ta̱s yen ilgwe a pi wu.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />Yek ma̱n Pa̱ris suk ma̱n da̱mti dlaboo Sanhidirin ngusi ngot lal gwe sa sheli Yesu gaa ta̱s man tlot gwas ɗa. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Ama yek ba̱sa̱ mbi ilgwe sa man dla̱mti wu so, ko ɗe mbala̱n wonti shelit lal gaa wu.</para>
  <para style="p" vid="MAT 26:60">Ka̱ kaali yek mbala̱n ɗe lop lak yil toɗi <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />yek sa̱ wule, &lt;&lt;Ma̱lga̱n dla̱m ɗe, &lt;Ba man jekti lubii ga̱ Nya ka, a kin lisi ten multi ɗe mekan.&gt; &gt;&gt;<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Yek bacina ga̱ ma̱n Pa̱ris tlinya yek ta̱ wul Yesu ɗe, &lt;&lt;Ka mana̱n balla̱t ilgon sa? A sheda jin ɗe sa̱ na̱ma dla̱mti tenki wu pa?&gt;&gt; <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Ama yek Yesu da̱m mbetlak.</para>
  <para style="p" vid="MAT 26:63">Yek bacina ga̱ ma̱n Pa̱ris wulti ɗe, &lt;&lt;A mok na̱ shin ga̱ Nya ma̱n mbadli. Dla̱mini, kik ɗe Almasihu yen ga̱ Nya ma?&gt;&gt;<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Yek Yesu ballit ɗe, &lt;&lt;Yii, nu ka̱n. Ama amik ka hwikii ge, ndok ase kaa yen Yen ga̱ Mbala̱n ta̱ da̱m ten ka̱t ang shinti ga̱ Nya Ma̱n Ikosi ten tulti ka̱ kaluntun ka̱ dlo nya.&gt;&gt;<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Yek bacina ga̱ ma̱n Pa̱rismi kesh luka̱l jwas ka na̱ lilti mbadli, yek ta̱ wule, &lt;&lt;Ka̱a̱ kum ga̱ɓa cutgaa suk Nya gwe ta̱ dla̱m wu wi! Sheda yek ma̱ yima ɓa̱tti ye? Ningo ka̱a̱ kum ga̱ɓa cutgaa suk Nya tet bi gwas wi. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Yek ɗe daamti gwaka̱n a dani ye?&gt;&gt;</para>
  <para style="p" vid="MAT 26:66">Yek sa̱ ballit ɗe, &lt;&lt;Mbun ɗe ta̱ tlot ka.&gt;&gt;<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Yek sa̱ ba̱zet ɓaka̱n ten cina gwel, yek sa̱ ɓok-ɓoti, yek jon jwasa̱n ɓet kalka̱ng, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />asa̱ na̱ma wulti ɗe, &lt;&lt;Ɓo hwini ga̱ɓa ga̱ Nya ɗe kume kik ɗe Almasihu wu, dla̱mini ma̱lgwe ɓok wu?&gt;&gt;<verse eid="MAT 26:68" /></para>
  <para style="s">Biturus nge yisti ga̱ Yesu</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Ka̱ sa'i gwisi wo a Biturus ni na̱ zhila ka̱ gip boomi nugo, yek ɗe na̱m ka̱ mil modli jwe asa̱ pa̱l wul ka̱ lubiimi wu li malti, yek ta̱ wulti ɗe, &lt;&lt;Ki mago suk Yesu ma̱n Galili wu ka̱n ka̱ ni.&gt;&gt;<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Yek Biturus nge yisti ga̱ Yesu a cina ɗa̱ mas jwasa̱n ka, yek ta̱ wule, &lt;&lt;Ami wo a yis ga̱ɓa gwe ka̱ na̱ma dla̱mti wu so.&gt;&gt;<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Yek ta̱ yil to dlaboo ka, yek yen kili gon po yenti ɗa, yek ta̱ wul ma̱jwe ni ka̱li wu ɗe, &lt;&lt;Ma̱lga̱n ni suk Yesu ba Nazarat.&gt;&gt;<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Yek Biturus po nge yisti ɗa, hal yek ta̱ mo ga̱ɓa na̱ Nya, yek ta̱ wule, &lt;&lt;Ami wo a yis ma̱li so!&gt;&gt;<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Po la̱m da̱nti wugo, yek ma̱jwe na̱ma dla̱lti ka̱li wu li mal Biturus, yek sa̱ wulti ɗe, &lt;&lt;Ki mago gon gwasa̱n ka̱n. Kangwe aka̱ ga̱ɓa wu ɓulik gal ɗa̱ gaa ka̱ wi.&gt;&gt;<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Yek Biturus njeli pa̱lti bi gaa gaa gwasi, ata̱ na̱ma mot ga̱ɓa na̱ Nya ten wulti ɗe, &lt;&lt;A yis ma̱li so!&gt;&gt;</para>
  <para style="p" vid="MAT 26:74">Ta̱ na̱ma dla̱mti nugo yek gunda kol lak yal. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Yek Biturus daam ga̱ɓa gwe Yesu hwit wu, &lt;&lt;Ka nge yisti gini asa̱mi ɗe mekan a paa gunda kol nda lakti yal.&gt;&gt; Yek Biturus yil deɓa̱l yek ta̱ kul i'e.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">Sa̱ ta̱la Yesu a cina ga̱ Bilatus gobna</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Lu tlo wugo, yek kiɗi ma̱n Pa̱ris suk bacina ga̱ mbala̱n dla̱lli ga̱ɓa ɗe ta̱s tlo Yesu ka. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Yek sa̱ ɓalti ka, yek sa̱ yilla̱t deɓa̱l yek sa̱ ta̱lat mal Bilatus gobna.<verse eid="MAT 27:2" /></para>
  <para style="s">Yehuda tlo gaa gwasi</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Ɗe Yehuda ɗe tik ba̱l bi gwas wu yeni ɗe sa̱ dla̱lli ga̱ɓa ɗe sa tlo Yesu ka̱wu, yek ta̱ pa̱l duu tuk na̱ gaa gwasi. Yek ta̱ pal tet mal kiɗi ma̱n Pa̱ris suk bacina ga̱ mbala̱mi, yek ta̱ pallisi wulpi hwol ga̱lla ɗe kutl ɗe mekami. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Yek ta̱ wulsi ɗe, &lt;&lt;A pa̱l byas wul wi, a ba̱l bi ga̱ ma̱lgwe ba̱ta̱ pa̱l byas ilgon sowu ten ɗe ta̱ tlot ka.&gt;&gt;</para>
  <para style="p" vid="MAT 27:4">Yek sa̱ ballit ɗe, &lt;&lt;Yek ɗe biki ga̱na̱n ye? Go ai ki ka̱n hwotki.&gt;&gt;<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Yek Yehuda shot wulpi ka ka̱ lubii ga̱ Nyami yek ta̱ zak luisi. Yek ta̱ zigaa yek ta̱ sak lak zaa yal yek ta̱ tlo gaa gwasi.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />Yek kiɗi ma̱n Pa̱ris yem wulpi, yek sa̱ wule, &lt;&lt;Mbun ɗe ta̱n wutta̱n wulpi ga̱n ka̱ lu mot wulpi ga̱ lubii ga̱ Nya so, na̱k ɗe wulpi hwulan ka̱ wu.&gt;&gt; <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Yek sa̱ moo bi gwasa̱n yek sa̱ dla̱lli ga̱ɓa a dani, yek sa̱ wul lu ga̱ ma̱n kinti cikɗa na̱ wulpi, ten ɗe ta̱s ngusi lepti ji ma̱nda̱ki ka̱li. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Ten na̱k gwisi ka̱ laki asa̱ mbe lu gwisi ɗe Lu Hwulan hal cin ga̱ ase. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Na̱ nu ka̱n ga̱ɓa gwe Irimiya ma̱n dla̱mti ga̱ɓa Nya dla̱m wu njika̱n. Ga̱ɓa gwe wule, &lt;&lt;Yek sa̱ kan wulpi hwol ga̱lla ɗe kutl ɗe mekan, wulpi gwe ma̱n Yisiraila pa̱l ga̱m gwas ɗa̱ wu, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />yek sa̱ wul lu ga̱ ma̱n kinti cikɗa na̱ nali na̱k gwe Nya dla̱lli ɗe ta̱ pi tena̱n wu.&gt;&gt;<verse eid="MAT 27:10" /></para>
  <para style="s">Bilatus gobna ngem Yesu</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />To, ka̱ sa'i gwe Yesu ni cina ga̱ gobna wu, yek gobne ngemti ɗe, &lt;&lt;Kik ɗe guu ga̱ ma̱n Yehuda nwa?&gt;&gt;</para>
  <para style="p" vid="MAT 27:11">Yek Yesu ballit ɗe, &lt;&lt;Yii, nu ka̱n ni.&gt;&gt;<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Ama sa'i gwe kiɗi ma̱n Pa̱ris suk bacina ji mbala̱n dla̱mit byas wul gaa go, yek ba̱ Yesu wule ilgon so. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Yek Bilatus ngemti ɗe, &lt;&lt;Ka̱ kuma̱n byas wul jwe sa̱ zik gaa wu sa?&gt;&gt; <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Ama yek ba̱ Yesu ballit ɗe ilgon so, yek ili ci ɓanti gobne i'e.<verse eid="MAT 27:14" /></para>
  <para style="s">Bilatus kis ga̱ɓa ɗe ta̱ tlo Yesu ka</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />To, ka̱ sa'i Biki Ɗakcitisi wo, gobna ku na̱ ɓulti ma̱l ga̱ le ka ɗe na̱m gwe mbala̱n botli wu wi. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Ka̱ sa'i gwisi wo a ma̱l ga̱ le ka gon gwe mbala̱n yisti i'e wu ni ang, ma̱lgwe asa mbet ɗe Barabas wu. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Ɗe mbala̱mi mogaa wu, yek Bilatus ngemsi ɗe, &lt;&lt;Gwik ka̱a̱ lami ɗe ta zakti gwi, Barabas a, sogo Yesu ɗe asa̱ mbet Almasihu wu?&gt;&gt; <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Na̱k ɗe Bilastus yisi ɗe daka̱lti ka̱ laki yek sa̱ tulli Yesu a malti wu.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />A Bilastus ni ga̱ da̱mi na̱ zhila ten gobdlan kisti ga̱ɓa nugo yek kili gwas shinlu ɗe ta̱s wulti ɗe, &lt;&lt;Yil ɗa̱ka̱ tantu ga̱ ma̱l wu ɗe ba̱ta̱ pa̱l byas ilgon sowu ka, na̱k ɗe a ci ka̱ dli i'e na̱ tlunka̱t tenti wu.&gt;&gt;<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Ama yek kiɗi ma̱n Pa̱ris suk bacina ji mbala̱n cok mbala̱mi ɗe ta̱s wule ɗe ta̱s zak Barabas ta̱s tlo Yesu ka.<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />Yek gobne ngemsi ɗe, &lt;&lt;Gwik ka̱a̱ lami ɗe ta zakikii ti ka̱ mbala̱n ɗe loɓi jwi?&gt;&gt;</para>
  <para style="p" vid="MAT 27:21">Yek sa̱ ballit ɗe, &lt;&lt;Barabas,&gt;&gt;<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />Yek Bilatus ngemsi ɗe, &lt;&lt;A yek ba pa̱li na̱ Yesu ɗe asa̱ mbet ɗe Almasihu wu ye?&gt;&gt;</para>
  <para style="p" vid="MAT 27:22">Yek sa̱ ballit ɗe, &lt;&lt;Ɓakti ka ten guda̱l yencin!&gt;&gt;<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Yek ta̱ ngemsi ɗe, &lt;&lt;Ten ɗe yek ke? Byas wul yek ta̱ pa̱li ye?&gt;&gt;</para>
  <para style="p" vid="MAT 27:23">Ama yek sa̱ mba̱l yal gwasa̱n ten wulti to nya ka̱ɗe, &lt;&lt;Ɓakti ka ten guda̱l yencin!&gt;&gt;<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Bilatus yeni ɗe ta man pa̱lti ilgon dani so, a yekgu mbala̱mi ɓa lam tlilti dlanti wu, yek ta̱ kan ze yek ta̱ pol ang gwas ka ten yenti ga̱ gwel ga̱ mbala̱mi ata̱ na̱ma dla̱mti ɗe, &lt;&lt;Ami wo ze gi ni ka̱ alhaki ga̱ hwulan ga̱ ma̱n la̱shi pa̱lti byas wul ga̱n so, go ze gwaka̱n ka̱n.&gt;&gt;<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Yek mas mbala̱mi ballit ɗe, &lt;&lt;Ha̱n ta̱ alhaki ga̱ hwulan gwas ni ten gaa ga̱na̱n mi suk mil jina̱n.&gt;&gt;<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Yek ta̱ zakisi Barabas. Yek ta̱ laki yek sa̱ ɓo Yesu, yek paa ta̱ ba̱lsiti ɗe ta̱s ɓakti ka ten guda̱l yencin.<verse eid="MAT 27:26" /></para>
  <para style="s">Ma̱n wuli Yesu ga̱ɓa mbulti</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Kaal na̱k gwisi, yek ma̱n hapti dlomi ji gobna ta̱la Yesu ka̱ pada ga̱ gobne, yek sa̱ mwet motgaa ji ma̱n hapti dlo ga̱ atli gaa. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Yek sa̱ ndusit wul ɗa̱ ten dli ka yek sa̱ lakit zil luka̱l gon wunda̱li ji guu, <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />yek sa̱ pa̱l tagiya guu gon na̱ ili yek sa̱ kinit gaa, yek sa̱ lakit sanda ka̱ ang shinti gwasi, yek sa̱ ngusi ngusti a cina gwasi asa̱ nitma wulti ga̱ɓa mbulti ɗe, &lt;&lt;Na̱ nalti gwa, guu ga̱ ma̱n Yehuda!&gt;&gt; <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Yek sa̱ ba̱zet ɓaka̱n, yek sa̱ kan sande yek sa̱ ngusit ɓot gaa ɗa. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Ɗe sa̱ wulit ga̱ɓa mbultisi paki wu, yek sa̱ ndusit zil luka̱li ka, yek sa̱ lakit luka̱l gwas lisi. Yek sa̱ zigaa sukti ten ɗe sa sak ɓakti ka ten guda̱l yencin.<verse eid="MAT 27:31" /></para>
  <para style="s">Sa̱ Ɓak Yesu ka ten guda̱l yencin</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Sa̱ na̱ma za̱tgaa nugo yek sa̱ mo suk ma̱n Sayirin gon, ma̱lgwe asa̱ mbet ɗe Siman wu, yek sa̱ zit ngetli ɗe ta̱s kan guda̱l yencin gwe sa ɓak Yesu ka a dani wu. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Yek sa̱ mbuki ka̱lu gwe asa̱ mbe ɗe Golgota, gwe yek ɗe Is Gaa wu. <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Yek sa̱ ba̱l Yesu ze inabi ga̱ kutltli suk yoki ilgon ɗe ta̱s tla, ama ta̱ lami ɗe ta̱ kum yokit ɗu go yek ta̱ nge tlati. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Ɗe sa̱ ɓakti ka ten guda̱l yencin wu, yek sa̱ lak guria ten ɗe ta̱s hwul luka̱l gwas ɗa. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Ka̱ kaali wo, yek sa̱ da̱m na̱ zhila ka̱li yek sa̱ ngusi ɓa̱tti gwasi. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Yek sa̱ zi lishti gwe dla̱m byas ilgwe ta̱ pa̱li wu dap ten gaa gwasi, gwe sa̱ lishi ɗe: GA̱N GO TIK ƊE YESU, GUU GA̱ MA̱N YEHUDA. <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Yek sa̱ ɓak muka̱l ma̱n ɓa̱tti tantu ɗe lop jon ka ten guda̱l yencin sukti, gon wo ten ka̱t ang shinti a gon wo ten ka̱t ang yali gwasi. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Yek ma̱n kopti tu ka̱li ngusit wulti ga̱ɓa mbulti asa̱ na̱ma wotlti gaa jwasa̱n, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />yek sa̱ ngusi wulti ɗe, &lt;&lt;Ki ɗe ka̱ dla̱m ɗe ka jek lubii ga̱ Nya ka aka̱ kin lisi ka̱ multi ɗe mekan wu! Kis gaa gwa la! Kume ki wo yen ga̱ Nya ke ki wu, yil sut ɗa̱ ten guda̱l yencimi ka̱ la!&gt;&gt;<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Na̱k gwisi ka̱n kiɗi ma̱n Pa̱ris suk ma̱n yisti mba̱t ga̱ɓa ga̱ Musa suk bacina ji mbala̱n wulit ga̱ɓa mbulti. <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />Yek sa̱ wuli ɗe, &lt;&lt;Ta̱ kis naa mbala̱n, ama yek ba̱ta̱ kis gaa gwas dani so. Kume ti wo guu ga̱ ma̱n Yisiraila ka̱ go ta̱s yil sut ɗa̱ ten guda̱l yencimi ka̱ la, apaa ma̱ ba̱l gem na̱ ti. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Ta̱ nga̱sti ten Nya, ha̱n ta̱ Nyami kisti ninge ɗe ta̱mit ɗa̱ wu, na̱k ɗe ta̱ dla̱m ɗe, &lt;Ami wo Yen ga̱ Nya ka̱ɗe ami wu.&gt; &gt;&gt; <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Na̱k gwisi ka̱n muka̱l jwe sa̱ ɓaksi ka ten guda̱l yencin sukti ju wulit zobi pak.<verse eid="MAT 27:44" /></para>
  <para style="s">Ma̱shka̱n ga̱ Yesu</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Tun tet ka̱ tlo cin, yek da̱mshal yitla atli ka mas, se na̱k cin celti ta̱ la sa'i ga̱lla ɗe mekan ga̱ ka̱ sukti. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Ta̱ la sa'i ga̱lla ɗe mekan ga̱ ka̱ sukti go yek Yesu tlil yal gwas nya yek ta̱ wuli ɗe, &lt;&lt;Eloyi, Eloyi, lama sabaktani?&gt;&gt; Ilgwe yek ɗe. &lt;&lt;Nya gini, Nya gini, yek laki yek ka̱ laka̱n ka̱ ye?&gt;&gt;<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Ma̱jwe ni ka̱li wu kum ilgwe ta̱ dla̱m wu, wugo yek sa̱ wuli ɗe, &lt;&lt;Ta̱ ɓa mbe Iliya suɗi.&gt;&gt;<verse eid="MAT 27:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48" />Yek gon gwasa̱n yem na̱ apti yek ta̱ kan wushgali, yek ta̱ lak ka̱ ze inabi gwe mbayi wu, yek ta̱ ɓak ten sanda yek ta̱ takit ɗe ta̱s tla. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Yek naami jwasa̱n wuli ɗe, &lt;&lt;Ɓo zaka̱nti ta̱n ɓo yeni ni, ko Iliya a suk kisa̱nti.&gt;&gt;<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Yek Yesu po tlil yal gwas nya ɗa na̱ nda̱lti, yek paa ta̱ kotl mbadl ka.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Yek labule ga̱ lubii ga̱ Nya kesh su tlo ka, kan sut tu nya hal sut tu atli. Yek atl nwuti yek kiɗi ye tat-tatli. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Yek gazukɗi ɓu-ɓuli yek mbala̱n ji botli jwe ma̱sh wu wonti pal kaami. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Yek sa̱ yil tot ɗa̱ka̱ gazukɗi jwasa̱n ka, ɗe Yesu pal kaami tot ka̱ gazukɗi wu, yek sa̱ li ka̱ ba̱n ma̱n cilti ga̱ Nya yek sa̱ ngusi mbok ang ten gaa jwasa̱n mal mbala̱n wonti.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Ka̱ sa'i gwe bal ma̱n hapti dlo ga̱ Roma suk ma̱jwe sa̱ na̱ma ɓa̱tti gwas wu yen kangwe lu nwuti suk mas wul jwe pi wu wu, yek ɓanti cisi i'e yek sa̱ dla̱m ɗe, &lt;&lt;Gem, ma̱lga̱n go yen ga̱ Nya ka̱n!&gt;&gt;<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Ama a wonti modli jon jwe sa̱ kop Yesu tun tet Galili ɗe asa̱ ngusit pa̱lti wul wu. Modli jwisi dla̱l te dlenti ka yek sa̱ ngusi yenti wul jwe na̱ma pa̱t wu. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Modli jimi ka̱ɗe ka̱a̱ Maryam ma̱n Maga̱dala, suk Maryam ana ga̱ Yakubu suk Yusupu, suk ana ji mil ji Zabadi ju.<verse eid="MAT 27:56" /></para>
  <para style="s">Lepti ga̱ Yesu</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Ɗe sukti pi wugo, yek ma̱n wul ang gon ma̱n Arimatiya, ma̱lgwe shin gwas ka̱ɗe Yusupu wu tuli. Yusupu wo yen lishti ga̱ Yesu ka̱n. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Ta̱ li mal Bilatus yek ta̱ ngemti ɗe ta̱s ba̱lti hwu dli ga̱ Yesu yek Bilatus laki yek sa̱ ba̱lti. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Yek Yusupu kan hwuunisi yek ta̱ lak ka̱ zani leni ma̱n mbunti, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />yek ta̱ za̱t ka̱ pyal gazukɗi gwasi, gwe ta̱ ɗuk ka̱ ye wu. Yek ta̱ jek bal ye gon ten bisi yek paa ta̱ zigaa. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Ama ka̱ sa'i gwisi wo aka̱a̱ Maryam ma̱n Maga̱dala, suk Maryami gon wu ni na̱ zhila tu te duk ɗa̱ gazukɗisi ka.<verse eid="MAT 27:61" /></para>
  <para style="s">Ma̱n ɓa̱tti ga̱ gazukɗi ga̱ Yesu</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Ten cin gwe kop kaali wu, gwe yek ɗe cin gwe kop kaal ga̱ cin pa̱lti shiri wu. Yek kiɗi ma̱n Pa̱ris suk ma̱n yisti Mba̱t Ga̱ɓa ga̱ Musa mogaa mal Bilatus. <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />Yek sa̱ dla̱m ɗe, &lt;&lt;Na̱ nalti gwa, ma̱ daam ilgwe ma̱n gilla̱t mbala̱n ga̱n dla̱m ɗe ta̱ yi kaami wu. Ta̱ wuli ɗe, &lt;Ka̱ kaal ga̱ multi ɗe mekan wo ba pal kaami.&gt; <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Ten na̱k gwisi ka̱n ningo laki ta̱ ɓa̱t gazukɗisi i'e hal se pa̱l multi ɗe mekami. Sogo mil lishti jwas a lak muka̱l hwu gwas ka asa̱ hwi mbala̱n ɗe ta̱ pal kaami wi. Kume pi nu go, gilla̱t gwe sa gilli mbala̱n ka̱ kaali wu a man ga̱ cine na̱ lilti.&gt;&gt;<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />Yek Bilatus ballisi ɗe, &lt;&lt;Yema̱n ma̱n hapti dlo, ta̱k suk ɓa̱ta̱n luisi, kan gwe ka man ɓa̱tti wu.&gt;&gt; <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Yek sa̱ sak ɓa̱tti gazukɗisi ka, yek sa̱ ɓo hatimi ga̱ guu ten ye gazukɗisi, yek sa wut ma̱n hapti dlo ten ɓa̱tti luisi.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Palti kaami ga̱ Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Ɗe gas shukti shige wu, ka̱ bultlwe ga̱ gas lahadi, yek Maryam ma̱n Maga̱dala suk Maryam gon wu sa yenti gazukɗisi.<verse eid="MAT 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2" />Yek atl nwuti i'e, ten ɗe yen shinti ga̱ Nya gon yil sut nya. Yek ta̱ sak guda̱l ye ga̱ ten bi gazukɗisi ka, yek ta̱ da̱m ten yesi. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Yen shinti ga̱ Nyami ngusi cilti na̱k cit bi ga̱ nyaze, a luka̱l gwas wo hwoli pat na̱k apda̱ga. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Ma̱n ɓa̱tti gazukɗisi yenti wugo yek ɓanti gwas cisi i'e, hal yek sa̱ lok te atl ka na̱k ma̱jwe ma̱sh wu.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Yek yen shinti ga̱ Nyami wul modlisi ɗe, &lt;&lt;Ba̱k ɓanti so, a yisi ɗe Yesu ka̱n ka̱a̱ na̱ma ngot gwasi gwe sa̱ ɓakti ka ten guda̱l yencin wu. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Ta̱ni aɗe so, ta̱ pal kaami wi na̱k gwe ta̱ dla̱m wu. La̱n teɗi ta̱k yena̱n lu gwe sa̱ mulla̱t atl wu. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Ningo, la̱n na̱ aniya ta̱k sak hwi mil lishti jwas ɗe, &lt;Ta̱ pal kaami wi, a ningo ta suikii Galili cina. a Galilisi ka̱n kaa yenti.&gt; A mi wo ilgwe tulla̱n wuggu.&gt;&gt;<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Yek modlisi zak gazukɗisi ɓa-ɓa a ɓanti na̱ma cit gwasa̱n, ama a mbadl jwasa̱n njika̱n na̱ hwol tuki, yek sa̱ yem na̱ apti ta̱s sak hwi mil lishti jwasi. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Yek Yesu na̱ gaa gwas mo suksi yek ta̱ wulisi ɗe, &lt;&lt;Sallama gwaka̱n.&gt;&gt; Yek sa̱ ɗam tet malti yek sa̱ ngip asa̱n gwasi yek sa̱ ngusit atli. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Yek Yesu wulsi ɗe, &lt;&lt;Ba̱ ɓanti cikii so. La̱n ni ta̱k sak hwi yilkeni ji ɗe ta̱s li Galili, ka̱li ka̱n sa yena̱nni.&gt;&gt;<verse eid="MAT 28:10" /></para>
  <para style="s">Ma̱n hapti dlo ma̱n ɓa̱tti gazukɗi dla̱m ilgwe pi wu</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />A modlisi na̱ma za̱tgaa nugo yek jon ka̱ ma̱n hapti dlo ju te ka̱ ba̱n, yek sa̱ dla̱mi kiɗi ma̱n Pa̱ris mas ilgwe pi wu. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Ɗe kiɗi ma̱n Pa̱rismi suk bacina ji mbala̱n pa̱l da̱mti wu, yek sa̱ dla̱lli ga̱ɓa yek sa̱ ba̱l ma̱n hapti dlomi bal wulpi, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />yek sa̱ wulsi ɗe, &lt;&lt;Hwi mbala̱n ɗe, &lt;Mil lishiti jwas ka̱a̱ sak muka̱l hwu gwas ka, ka̱ sa'isi wo ama̱ na̱ma ndet yemba̱l.&gt; <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Kume ga̱ɓe mbuki mal gobna go, ma ga̱ɓa sukti kangwe kaa te ka̱ bomti sowu.&gt;&gt; <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Yek ma̱n hapti dlomi kan wulpi, yek sa̱ pa̱li kangwe sa̱ wulsi ɗe ta̱s pa̱li wu. Ga̱ɓa gwisi ka̱n a ma̱n Yehuda dla̱mi, hal cin ga̱ se.<verse eid="MAT 28:15" /></para>
  <para style="s">Aiki gwe Yesu zi mil shinti jwas pa̱lti wu</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />To, yek mil lishti ɗe kutl cet na̱m ju li Galili, yek sa̱ to ten Za̱nda̱l Tla̱nda̱l gwe ta̱ hwisi ɗe ta̱s mogaa ka̱li wu. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Ɗe sa̱ yenti wu, yek sa̱ ngusit atli. Ama yek jon jwasa̱n tatl mbadl jwasa̱n tenti. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Yek Yesu ɗam njaa tet malsi yek ta̱ wulsi ɗe, &lt;&lt;Sa̱ ba̱la̱n mas iko to nya ka suk ten dii atl wi. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Ten na̱k gwisi, ningo sak hwi mas mbala̱n ji dii atl ɗe ta̱s koɓa̱nni, laka̱nsi ta̱s da̱m ɗe mil lishti jini, aka̱a̱ nisi ma pa̱lti baptisma na̱ shin ga̱ Aba suk ga̱ Yen suk ga̱ Shishi ga̱ Nya. <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />Aka̱a̱ nisi ma mbokti ang ɗe ta̱s kop wul jwe a zi kii pa̱lti wu. Yekgu ani sukkii ko agasi hal se cin gwe dii atl a paki wu.&gt;&gt;<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>