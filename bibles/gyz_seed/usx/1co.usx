<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Geji New Testament</book>
  <para style="h">1 MA̱N KORINTI</para>
  <para style="toc1">1 Ma̱n Korinti</para>
  <para style="toc2">1 Ma̱n Korinti</para>
  <para style="toc3">1Kor</para>
  <para style="mt2">Lishti gwe Bulus lishi ma̱n kopti ji Apisa wu na na̱m. Yek ɗe lishti gwe ama̱ mbe ɗe</para>
  <para style="mt1">Ma̱n Korinti</para>
  <para style="imt">Ndat zhila ga̱ɓa</para>
  <para style="ip">Bulus yen shinti ga̱ botli ka̱ lish ga̱ɓa ge. Gini ɗe 55 kaal ɗa̱ ma̱shka̱n ga̱ Yesu, ata̱ yi ka̱ ba̱n Apisa ka̱ atl ga̱ nak'en Asiya. Ɗe Bulusi yima ma̱tlti dla̱mti ga̱ɓa ma̱n ta̱mti ten Yesu wu, ten asa̱mi na lop yek ta̱ lak zhila motgaa kopti a Korinti. ba̱n Korinti wo alti ba̱n ka̱n ka̱ atl ga̱ Giris. Alti ka̱n dlo ga̱ wulti wul suk wulti ka ni, a yek ɗe dlo lu ngot Nya boo suk pa̱lti wul ga̱ mbala̱n. Gon a Bulus lishi ga̱ɓa motgaa ma̱n kopti ji ba̱n Korinti asa̱mi ɗe wupsi, ama lishti jwe ta̱ pa̱li na na̱m suk na loɓi jwo gil ka̱ wi. Lishti jwe ama̱ mbe ɗe na na̱m suk na lop go, jwe ta̱ pa̱li na̱ loɓi suk mekami ka̱n.</para>
  <para style="ip">Kaal ɗa̱ zakti Korinti ga̱ Bulus yek bi mbokti ang ten hwa ga̱ɓa ga̱ Nya suk ga̱ɓa ten wul ga̱ dli ga̱ mbala̱n ngusi hwotti ga̱ motgaa ma̱n kopti, yek sa̱ shini lu Bulus na̱ ga̱ɓa ga̱ lishi ta̱s kum ga̱z ga̱ wul jwisi. Ama dlip Bulus ɓa ballisi ga̱ɓa go ba̱ a ni ten palti ɗe kumti ga̱ zisi gwe ta̱ ma ga̱ɓa dani wuggu so. Dla̱kti ga̱ɓa ngusi tet ka̱ dlo gwasa̱n ten bi pa̱lti wul ga̱ ma̱n Yehuda suk ga̱ ma̱n Giris. Madl a modli yitla gaa ka ka̱ mbala̱n, asa̱ da̱m a tu kaali ka̱ lu motgaa. Yek ma̱n Yehuda ma̱n kopti ngusi za̱t gwel modli Giris ma̱n kopti ɗe ta̱s pa̱li na̱k jwasa̱n wu.</para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />Ami Bulus ɗe Nya mbeni ta da̱n ɗe yen shinti ga̱ botli ga̱ Yesu Almasihu na̱k kangwe ta̱ pa̱li wu. Amik lish ga̱ɓa ge suk yilka ma̱n kopti gwe asa̱ mbet ɗe Sastanis wu.<verse eid="1CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 1:2" />Kii motgaa ma̱n kopti jwe ni ka̱ ba̱n Korinti wu, suk jwe Nya botlsi yek ta̱ polsi ka yek sa̱ da̱n ɗe ma̱n hwa mbadl wu, suk mas ma̱jwe asa̱ ngem Nya ka̱ shin ga̱ Yesu mas lu gwe sa̱ ni wu, na̱k ɗe tik ɗe Bagaa ga̱na̱n suksi wu. <verse eid="1CO 1:2" /><verse number="3" style="v" sid="1CO 1:3" />Ha̱n ta̱ yenti gonti na̱ ta̱mi mbadl sut mal Nya Buka ga̱na̱n suk mal Yesu Bagaa da̱n ka̱ mbadl gwaka̱n.<verse eid="1CO 1:3" /></para>
  <para style="s">Bulus pa̱l hwol tuki</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />A pa̱l hwol tuk na̱ Nya dlip na̱k ɗe ka̱a̱ mbi alheri tumal Almasihu Yesu wu. <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />Tumalti ka̱n ka̱a̱ mbi mas hwa wul, ten mas tantu ka̱ mas ga̱ɓa gwaka̱n, suk mas yisti wul gwaka̱n, <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />na̱k ɗe ga̱ɓa gwe ma̱ hwikii ten Yesu go mbala̱n yeni ten pa̱t gwaka̱n wu. <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />Yek laki ɗe ka̱a̱ mbi mas ba̱lti wul ji Shishi ga̱ Nya ɗe ka̱a̱ na̱ma za̱t gwel ten palti sut ga̱ Yesu Almasihu Bagaa wu. <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />Ta nda̱llikii gahwula̱n se gas gwe ta pal sut ɗu. Ta̱k da̱ma̱n ɗe ma̱n la̱shi pa̱lti byas wul ten gas palti ga̱ Almasihu Yesu. <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />Nya ɗe ta̱ mbekii ten ɗe ta̱k cugaa suk Yen gwasi Yesu Almasihu go, ma̱n njika̱nti ga̱ɓa gwas ka̱n.<verse eid="1CO 1:9" /></para>
  <para style="s">La̱shi mot bi ka̱ dlo ga̱ ma̱n kopti</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />A na̱ma ngemti gwaka̱n yilkeni jini ka̱ shin ga̱ Yesu Almasihu ta̱ bi gwaka̱n ni ɗe na̱m. Ba̱k da̱ma̱n kak-kak so, mo gaa gwaka̱n ta̱k da̱ma̱n na̱ mbadl ɗena̱m suk daamti ɗena̱m. <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />Yilkeni jini, ma̱jon ka̱ boo ga̱ Kuluwi hwi ɗe ka̱a̱ na̱ma dla̱kti ga̱ɓa ka̱ dlo gwaka̱n. <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" />Ilgwe a nikii ma hwiti go yek ɗe, gon gwaka̱n wule, &lt;&lt;Bulus ka̱n ta̱ na̱ma kopti gwasi,&gt;&gt; a gon wule, &lt;&lt;Ami wo Apolos,&gt;&gt; a gon wule, &lt;&lt;Ami wo Kepas,&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">Kepas ka̱ɗe Biturus</char></note> a gon wo, &lt;&lt;Ami wo Almasihu.&gt;&gt; <verse eid="1CO 1:12" /><verse number="13" style="v" sid="1CO 1:13" />Yesu wo ɗe na̱mi ka̱n ta̱ ni? Bulus ka̱n sa̱ ɓakti ka ten guda̱l yencin ka̱ lal gwaka̱n ma? Ka̱<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">Sogo </char><char style="fqa" closed="false">ka̱</char><char style="ft" closed="false">lu ndat ga̱ɓa 15 </char></note> shin ga̱ Bulus ka̱n sa̱ pa̱likii baptisma nwa?<verse eid="1CO 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 1:14" />A pa̱l hwol tuk na̱ Nya na̱k ɗe a pa̱li baptisma ma̱lgon so, ban na̱ Kiribus suk Gayus sowu. <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />Yek laki ma̱lgon a man wulti ɗe sa̱ pa̱lit baptisma ka̱ shin gi so. <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" />A po pa̱li baptisma ma̱n boo ga̱ Sitipanus pak. Ban na̱ ma̱ ju sogo, ka̱ daamti gi wo a po pa̱li baptisma ma̱lgon so. <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />Yesu shina̱n ɗe ta pa̱l baptisma so. Ta̱ shina̱n ɗe ta dla̱mi ga̱ɓa ma̱n ta̱mti mbala̱n, ba̱ ɗe ta ga̱ɓa na̱ manti ga̱ mbala̱n so, ta̱ mbala̱n yis nda̱lti ɓakti ga̱ Yesu ka ten guda̱l yencin.<verse eid="1CO 1:17" /></para>
  <para style="s">Yesu ka̱ɗe ɓotlka̱n ga̱ Nya suk nda̱lti gwasi</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />Ɓakti gwe sa̱ ɓak Yesu ka ten guda̱l yencin wu mal ma̱jwe gil go, ɗe ka̱dla̱n ka̱n ni. Ama mal ni ɗe ma̱ mbi kisti go, bi ɓakti ga̱ Yesu ten guda̱l yencin wo nda̱lti ga̱ Nya ka̱n <verse eid="1CO 1:18" /><verse number="19" style="v" sid="1CO 1:19" />Na̱k gwe ni ga̱ lishi ka̱ ga̱ɓa ga̱ Nya wu ɗe,</para>
  <para style="q1" vid="1CO 1:19">&lt;&lt;Ba lil ɓotlka̱n ga̱ ma̱jwe da̱m gwa we sa̱ ɓotl wu ka.</para>
  <para style="q2" vid="1CO 1:19">Ba cat byas ɓotlka̱n ga̱ ma̱n ɓotlka̱n ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false">Yen </char><char style="xt"><ref loc="ISA 29:14">Ish 29:14</ref></char>.</note><verse eid="1CO 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 1:20" />Ma̱n ɓotlka̱n na̱n ko? Ma̱n yisti mba̱t ga̱ɓa ga̱ Musa ka̱ jwi? Ma̱jwe da̱ma̱n gwa we sa̱ yis mas wul wuk gwi? Nya ɓo mbok ang ten byas ɓotlka̱n ga̱ mbala̱n ten dii atl ɗe ka̱dla̱n sa? <verse eid="1CO 1:20" /><verse number="21" style="v" sid="1CO 1:21" />Ten ɗe Nya tumal ɓotlka̱n yisti wul gwasi, yek ta̱ laki yek ba̱ mbala̱n ji dii atl man yisti gwas tumal ɓotlka̱n yisti wul gwasa̱n so. Ka̱ lal ga̱ na̱k gwisi wo yek Nya lami ɗe ta̱s kis ma̱jwe nga̱ssi tenti wu tumal lakti icin ten ga̱ɓa ma̱n ta̱mti gwe mbala̱n kan ɗe ka̱dla̱n wu. <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />Ma̱n Yehuda wo sa̱ na̱ma lamti yenti wul cit ɓanti, a ma̱n Giris wo sa̱ na̱ma ngot ɓotlka̱n yisti wul. <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />Ama mi wo bi ga̱ Yesu gwe sa̱ ɓakti ka ten guda̱l yencin wu ka̱n ma̱ na̱ma dla̱mti. Ga̱ɓa gwe a lak ma̱n Yehuda ten kotti asa̱n, a mal ma̱jwe ba̱ ma̱n Yehuda ka̱ sogo ɗe ka̱dla̱n ka̱n ni wu. <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />Ama mal ma̱jwe Nya mbesi go, ko ta̱ ma̱n Yehuda ko ta̱ ma̱jwe ba̱ ma̱n Yehuda ka̱ sowu Yesu ka̱ɗe nda̱lti ga̱ Nya suk yisti wul gwasi. <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />Mas ilgwe Nya pa̱li yek mbala̱n yeni wule ka̱dla̱n ka̱wu man ɓotlka̱n yisti wul ga̱ mbala̱n, a ilgwe Nya pa̱li yek mbala̱n yeni wule la̱shi manti ka̱wu, man manti wul ga̱ mbala̱n.<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />Ɓo daama̱nkii ten kangwe ka̱a̱ ni ɗe Nya mbekii wu yilkeni jini, na̱m na̱m ka̱ kii ka̱ɗe ma̱n ɓotlka̱n na̱k gwe a mbala̱n yen ɓotlka̱n wu. Na̱m na̱m ka̱ kii ka̱ da̱n ɗe kiɗi mbala̱n wi, a na̱m na̱m ka̱ kii ka̱ɗe mil ji kiɗi mbala̱n. <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />Nya botl ilgwe mbala̱n kan ɗe ka̱dla̱n wu ta̱s laki ta̱ nsha ci ma̱n ɓotlka̱n ten dii atli. Nya botl wul jwe mbala̱n mbuli wu ta̱ nsha ci ma̱jwe nda̱l wu. <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />Wul ji dii atl jwe mbala̱n yeni ɗe hwaɓi ka̱ so jwe sa̱ mbuli wu ɗe a ba̱ ni ten bi ilgon malsi sowu, yek ka̱n Nya botli ta̱s cat wul jwe mbala̱n yeni ɗe hwaɓi wu ka. <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />Nya pa̱li nu ba̱ ma̱lgon ɓo ngetl ɗe ti wo ta̱ mbuk ilgon a cina ɗatka̱ so. <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />Nya ka̱ laki yek ma̱ pala̱n ɗe ma̱n kopti ga̱ Yesu, a tik laki yek Almasihu da̱mini ɗe ɓotlka̱n yisti wul. Tumalti ka̱n Nya palla̱nni ɗe mbala̱n jwasi yek ta̱ yilla̱ni ka yek ta̱ kisni ɗa̱ka̱ da̱nti ɗe zhel ga̱ pa̱lti byas wul ka tumal Yesu. <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />Nu ka̱n ni ka̱ lishti ga̱ɓa ga̱ Nya ɗe, &lt;&lt;Mas ma̱lgwe ɓo ngetl ɗe ta̱ mbuk pa̱lti ilgon go, ta̱s ɓo ngetl na̱ Nya.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">1:31 </char><char style="ft" closed="false">Yen </char><char style="xt"><ref loc="JER 9:24">Irm 9:24</ref></char>.</note><verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="s">Ga̱ɓa ten Almasihu gwe sa̱ ɓakti ten guda̱l yencin wu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />Yilkeni jini, ɗe a tul malki ɗe ta hwikii ilgwe ni ga̱ hwuda̱li<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">Lishti jwon wo ni sa̱ lishi ɗe, Dla̱m hwikii ga̱ɓa Nya ɗe ni ga̱ hwuda̱li wu</char></note> ɗe Nya dla̱m go, a tul na̱ manti bi suk ɓotlka̱n ga̱ mbala̱n suk yisti wul ga̱ gaa gi so. <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />A zi ka̱ mbadl gi ɗe da̱nti gi sukkii wo, ba ga̱ɓe kii ten ilgon so se ten bi ga̱ Yesu Almasihu gwe sa̱ ɓakti ka ten guda̱l yencin wu. <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" />Ɗe a nda tulti malkii go, dli nda̱li so, ɓanti cinni yek dli gi ngusi da̱dalti. <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />Ga̱ɓa gi wo na̱ manti bi suk ɓotlka̱n ga̱ mbala̱n ka̱ so ama na̱ nda̱lti ga̱ Shishi ga̱ Nya ka̱n. <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />Ba̱k nga̱sa̱nkii ten ɓotlka̱n ga̱ mbala̱n so, ama nga̱sa̱nkii ten nda̱lti ga̱ Nya.<verse eid="1CO 2:5" /></para>
  <para style="s">Ɓotlka̱n yisti wul gwe a Nya ba̱li wu</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />Mas na̱ na̱k gwisi ma̱ na̱ma lakti icin ten ga̱ɓa ɓotlka̱n yisti wul mal ma̱jwe nda̱l ten nga̱sti ten ya gwasa̱n wu. Ga̱n go wunda̱l ga̱ ɓotlka̱n yisti wul ga̱ mbala̱n ji se ɗe sa̱ ni ten dii atl wu ka̱ so. A ba̱ wunda̱l ɓotlka̱n yisti wul ga̱ guu ji niige gwe a paki wuk so, <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />ama ma̱ na̱ma ga̱ɓa ten ɓotlka̱n ga̱ Nya gwe ni ga̱ hwuda̱li wu. Nya pa̱l wunda̱l ɓotlka̱n gwisi ta̱n mbi nalti ɗa. Nyami pa̱li nu a ba̱ta̱ ɓo pa̱l dii atl so. <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />Guu ji dii atl mas yis gaa ga̱ ɓotlka̱n ga̱ Nya gwisi so, sa yisi go sa ɓak Bagaa ga̱na̱n ma̱n nalti ka ten guda̱l yencin so. <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />Ama ni ga̱ lishi ka̱ ga̱ɓa ga̱ Nya ɗe,</para>
  <para style="q1" vid="1CO 2:9">&lt;&lt;Ilgwe Nya zi ma̱jwe lamti wugo</para>
  <para style="q2" vid="1CO 2:9">ma̱lgon ɓo yeni so zam,</para>
  <para style="q1" vid="1CO 2:9">a ba̱ ma̱lgon ɓo kumi so,</para>
  <para style="q2" vid="1CO 2:9">a ba̱ ma̱lgon ɓo daamti ɗe a pi nu so.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">Yen </char><char style="xt"><ref loc="ISA 64:4">Ish 64:4</ref></char>.</note><verse eid="1CO 2:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10" />Ama yek Nya mbokinii ang ten wul jwisi wi tumal Shishi gwas ma̱n cilti.</para>
  <para style="p" vid="1CO 2:10">Shishi ga̱ Nyami wo ata̱ bodla̱l mas wul, mas na̱ wul ji Nya jwe ni dlunti gwe a bomi mbala̱n ta̱s yisi wu. <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />Wok ka yis daamti ga̱ ma̱lgon wo ɗe ba̱ mbadl ga̱ ma̱li ka̱ sowu? Nu ka̱n yisti mbadl ga̱ Nya mago se Shishi ga̱ Nya. <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />Mi wo shishi ga̱ dii atl ka̱n ma̱ kan so, ama Shishi gwe yil sut mal Nya wu ka̱n ma kaami, ta̱n yisa̱n ilgwe Nya ba̱la̱nni ten koo lu wu. <verse eid="1CO 2:12" /><verse number="13" style="v" sid="1CO 2:13" />Ilgwe ma̱ nikii ma hwiti go, ma̱ na̱ma dla̱mti na̱ ɓotlka̱n ga̱ mbala̱n so, ma̱ na̱ma dla̱mti na̱k gwe Shishi ga̱ Nya mbokinii ang dani wu. Ma̱ nima dla̱mti ma̱jwe Shishi ga̱ Nya na̱ma kopti na̱ si<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">Sogo ɗe, </char><char style="fqa" closed="false">Mbokti ang ten ga̱ɓa gem ga̱ Shishi ga̱ Nya na̱ma kopti</char></note> wu gem gwe ni ka̱ Shishi ga̱ Nyami wu. <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />Ma̱lgwe ba̱ Shishi ga̱ Nya na̱ma kopti na̱ti sogo ta kan ilgwe yil tet mal Shishi ga̱ Nya wu so, na̱k ɗe malti wo ka̱dla̱n ka̱wu, a ba̱ta yis gaami so na̱k ɗe tumal Shishi ga̱ Nyami ka̱n a mbala̱n yis gaami wu. <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />Ma̱lgwe Shishi ga̱ Nya na̱ma kopti na̱ ti go, ata cinga̱l mas wul, ama ti wo ba̱ ma̱lgon a cinga̱l ti so.<verse eid="1CO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CO 2:16" />&lt;&lt;Wok yis daamti ga̱ Bagaa wo,</para>
  <para style="q2" vid="1CO 2:16">ɗe hal ta mbokit ang ten ilgon wu?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">Yen </char><char style="xt"><ref loc="ISA 40:13">Ish 40:13</ref></char>. </note></para>
  <para style="m" vid="1CO 2:16">Ama daamti ga̱na̱n wo ga̱ Almasihu wu ka̱n.<verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s">Yela̱n jini zhel ji Nya</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />Yilkeni jini, ba ga̱ɓekii na̱k ma̱jwe Shishi ga̱ Nya na̱ma kopti na̱ si wu so, ama na̱k naa mbala̱n ji dii atli, na̱k mil la̱li ka̱ kopti ga̱ Yesu. <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" />A ba̱lkii ze nii ba̱ ɗe nda̱li shin so, na̱k ɗe ka̱a̱ ɓo mbuk ngukti sowu. Na̱k niige mago ka̱ ɓo mbuki so. <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />Na̱k naa mbala̱n ji dii atl ka̱n ka̱a̱ yima da̱mti, na̱k ɗe ka̱a̱ yima daka̱lti, aka̱a̱ yima dla̱kti ga̱ɓa ka̱ dlo gwaka̱n wu. Na̱k niige mago pa̱lti wul gwaka̱n wo ga̱ dli ka̱ yi. Ka̱a̱ yima pa̱lti wul na̱k ma̱n dii atli. <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" />Kume gon wule, &lt;&lt;Ami wo ga̱ Bulus ka̱n,&gt;&gt; A gon wule, &lt;&lt;Ami wo ga̱ Apolos,&gt;&gt; go ndakce ka̱n ka̱a̱ yi suk na ma̱n dii atl sa?<verse eid="1CO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5" />Ta ngemkii, wok ɗe Apolos wo? A wok ɗe Bulus wo? Zhel ji Nya ka̱n jwe ka̱a̱ nga̱skii ten Yesu tumalsi, ko gwik-gwi ta̱ pa̱l wul kangwe Nya ba̱lti ta̱s pa̱li wu. <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" />Amik ɓak wuda̱li, yek Apolos ba̱l ze, ama Nya ka̱ laki yek nali. <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />Na̱ nu ka̱n, na̱ ma̱lgwe ɓak wuda̱li wu, na̱ ma̱lgwe ba̱l ze wu, ko gon ni ten bi ilgon so se Nya na̱ ngusi ti ɗe ta̱ laki yek nal wu. <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />Na̱ ma̱lgwe ɓak wuda̱li wu, na̱ ma̱lgwe ba̱l ze wu, mas jwasa̱n wo wul ɗena̱m ka̱ ni ka̱ mbadl gwasa̱n. A ko gwik-gwi Nya a ɓatlti ndakce na̱ kangwe ta̱ pa̱l wul wu. <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />Mi wo yela̱n ten pa̱lti wul ga̱ Nya ka̱n. A kii wo zhin ga̱ Nya ka̱n, a bii gwe Nya kin wu ka̱n.<verse eid="1CO 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 3:10" />Na̱k gwe Nya ba̱la̱n manti wu, a lak zhila kinti biimi na̱k ma̱n manti kinti bii i'e, a ma̱lgon na̱ma mba̱lti kinti dani. Ama mas ma̱lgwe a kin biimi go ta̱s pi ɗem-ɗem na̱ kangwe ta kin biimi wu. <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />Ma̱lgon a po man lakti zobsi zhila biimi gon ban na̱ gwe a lak wu so, gwe Yesu Almasihu ka̱ɗe zhile wu. <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />Kume ma̱lgon kin ten zhila bii gwisi na̱ zinariya sogo na̱ hwol muni, sogo mbuni sunka̱n sogo na̱ yencin sogo na̱ koo me, sogo na̱ mamo. <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />Ilgwe ta̱ pa̱li wu a yil deɓa̱l, na̱k ɗe gas gwe a yil ten cilti wu ni tet wu. Nya a cinga̱l pa̱lti wul ga̱ mas mbala̱n na̱ wutu a wuti ka cinga̱l pa̱lti wul ga̱ ma̱li. <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />Kume kinti gwe ta̱ kin ten zhila biimi wu kwel ka̱ sowu, ma̱lgwe kin wu a mbi ɓatlti gwasi. <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />Ama kume kinti biimi kwel ka̱wu, ma̱li a sa ang kooni, ti gaa gwas wo ta mbi kisti ama na̱k ma̱lgwe koɓi tu ka̱ wutu wu.<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />Ka̱a̱ yisi ɗe kii wo bii ga̱ Nya ka̱sa? A Shishi ga̱ Nya na̱ma da̱nti ka̱ kii sa? <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />Mas ma̱lgwe lil bii ga̱ Nya ka̱go, Nya a lilti ka, na̱k ɗe bii ga̱ Nya wo da̱ska̱n ni giɓi sowu, a kik ɗe bii gwisi.<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />Ba̱k shela̱n gaa gwaka̱n so, mas ma̱lgwe da̱m gwa we ta̱ ɓotl na̱k ninge wu, ta̱s palli gaa gwas ɗe ka̱dla̱n ta̱s da̱n ɗe ma̱n ɓotlka̱n ɗa. <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />Ilgwe mbala̱n ji dii atli yeni ɗe ɓotlka̱n go, mal Nya wo ɗe ka̱dla̱n ka̱n ni. Na̱k gwe ni ga̱ lishi ka̱ ga̱ɓa ga̱ Nya wu, &lt;&lt;Nya dop ma̱n ɓotlka̱n ka̱ ɓotlka̱n gwasa̱n.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:19 </char><char style="ft" closed="false">Yen </char><char style="xt"><ref loc="JOB 5:13">Ayu 5:13</ref></char>.</note> <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />Ni ga̱ lishi ka̱ ga̱ɓa ga̱ Nya ɗe, &lt;&lt;Bagaa yisi ɗe daamti ga̱ ma̱n ɓotlka̱n wo ni ten bi ilgon so.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:20 </char><char style="ft" closed="false">Yen </char><char style="xt"><ref loc="PSA 94:11">Zab 94:11</ref></char>.</note> <verse eid="1CO 3:20" /><verse number="21" style="v" sid="1CO 3:21" />Yek laki ba̱ ma̱lgon ɓo ngetl ten ilgwe ma̱lgon a pa̱li wu so, mas wul wo gwaka̱n ka̱n. <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />Ko ta̱ Bulus, ko ta̱ Apolos, ko ta̱ Kepas,<note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="ft" closed="false">Ti ka̱n asa̱ mbet Biturus </char></note> ko ta̱ dii atli, ko ta̱ mbadli, ko ta̱ ma̱shka̱n, ko ta̱ ilgwe na̱ma pa̱t nin wu, ko ta̱ ilgwe a pi a cina wu, mas gwaka̱n ka̱n. <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />A kii wo ga̱ Almasihu ka̱n, a Almasihu wo ga̱ Nya.<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s">Mil shinti ji ɓotli ji Almasihu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />Kama̱nni ɗe zhel ji Almasihu ma̱jwe Nya ba̱lsi gem gwas gwe ni ga̱ hwuda̱li wu. <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />Ngetli ka̱n ta̱ ma̱jwe sa̱ ba̱lsi za̱t ilgon wu pa̱l gem. <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />Ami wo hwota̱n so kume kii, sogo ma̱jon kis ga̱ɓa tena̱n wu. Ami mago a cinga̱l gaa gi so. <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />Ami wo a yis byas wul gwe a pa̱li wu so, ama ba̱ ɗe we na̱kka̱n a pa̱l byas wul so so, Nya ka cinga̱la̱nni. <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />Ten na̱k gwisi ka̱n ba̱k cinga̱la̱n ma̱lgon a ba̱ cin cinga̱lti ɓo tul so so. Ɓa̱ta̱n cin gwe Bagaa a tul wu, ta yilli ilgwe ni ga̱ hwuda̱li ka ka̱ da̱mshal wu, suk ilgwe ni ka̱ mbadl ga̱ mbala̱n wu mas. Ten cin gwisi ka̱n mbala̱n a mbi ta̱sti mal Nya.<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />Yilkeni jini, a cinga̱likii ga̱ɓa ten Apolos suk ami ta hwikii ga̱ɓa jwisi, ta̱k yisa̱n gaa ga̱ ga̱ɓa gwe wule, &lt;&lt;Ba̱k ɗakca̱n ilgwe ni ga̱ lishi wu so.&gt;&gt; Yek laki ba̱ ma̱lgon kan ɗe ma̱n lishti gwas man ga̱ ma̱lgon so. <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />Wok hwik ɗe ka̱ man ma̱lgon wo? Yek nik ɗa̱ɗe ba̱ Nya ka̱ ba̱lki so ye. A Kume Nya ka̱ ba̱lki wu, yek laki yek ka̱ na̱ma ɓot ngetli wule ba̱lti ka̱n sa̱ ba̱lki so ye?<verse eid="1CO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8" />To ka̱a̱ mbi mas ilgwe ka̱a̱ lami wu wi. Ka̱a̱ ɓal ɗe ma̱n wul ang, aka̱a̱ ɓal na̱k guu, a mi wo ba̱ma̱ ni ten bi ilgon so. Guu ga̱ gem kani ɗe kii wu, ma da̱ma̱n wi ɗe guumi sukkii. <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />Yenti gi wo mi mil shinti ji botli ji Almasihu mik ni kaali ten mas wul, na̱k ma̱jwe sa̱ kis ga̱ɓa ɗe ta̱s tlosi ka ka̱ dlo ga̱ mbala̱n wu. Ma̱ pal ɗe ma̱jwe mbala̱n ji dii atli, suk mil shinti ji Nya suk mas ma̱jwe mbala̱n zinii gwel wu. <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />Mi wo ma̱ pal ɗe ka̱dla̱n ka̱ Almasihu ki wo yek ka̱ pal ɗe ma̱n ɓotlka̱n ka̱ Almasihu. Mi wo ma̱ nda̱l so ama ki wo ka̱ nda̱li. Ka̱ mbi nalti wi, ama mi wo ma̱lgon nalla̱ni so. <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />Na̱k nin mago kuza̱n suk ka̱lka̱ze na̱ma tlot ga̱na̱n, a ba̱ hwa tutul gwe ma lak wu nini ɗa̱ so, mbala̱n na̱ma ɓot ga̱na̱n, lubiii mago nini ɗa̱ so. <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" />Ama̱ ngo wul na̱ gaa ga̱na̱n. Mbala̱n pa̱lini bi wu, ama̱ ngemisi hwa wul ga̱ Nya. A kume sa̱ cini dlelngapcan wu, ama̱ dlo mbadli. <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />Sa̱ byalni wu, ama̱ hwisi hwa ga̱ɓa, mas na̱ nu mas mbala̱n ten dii atl na̱ma mbulti ga̱na̱n, sa̱ palla̱ni na̱k bi zukɗi ten dii atli. Ilgwe sa̱ na̱ma pa̱lti wuggu.<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />A lishikii ga̱ɓa ge ba̱ ɗe ta̱ nsha cikii so, ama ta matlkii na̱k gwe a aba matl mil jwas jwe ta̱ lamsi wu. <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />Ko ta̱ ma̱n lishti jwaka̱n ka̱ Almasihu wonti yek sa̱ la zaba̱l ɗe kutl, aba nikii ɗa wonti so. Amik da̱n ɗe aba gwaka̱n ka̱ Yesu Almasihu wi, na̱k ɗe a tullikii ga̱ɓa ma̱n ta̱mti wu. <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" />na̱k ɗe nuk ni wu, a na̱ma ngemti gwaka̱n ta̱k pa̱la̱n ilgwe ka̱ yena̱n ten pa̱lti wu. <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />Yek laki ɗe yek a shin Timoti malkii, yen gi ka̱n gwe a lamti wu. Ti wo ma̱n pa̱l gem ka̱n ten kopti ga̱ Bagaa. Ta daamikii ilgwe a na̱ma pa̱lti ka̱ kopti ga̱ Yesu Almasihu wu, na̱k kangwe ɗe a mboki ang mas motgaa ga̱ ma̱n kopti ko ako.<verse eid="1CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18" />Jon jwaka̱n ɓa yeni go ba po tul malkii so, yek laki yek sa̱ na̱ma nalti gaa. <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />Ba tul malkii njet ɗe kume Nya lami wu. Apaa a bodla̱l ilgwe ma̱n nalti gaa ju na̱ma dla̱mti wu suk nda̱lti gwe sa̱ dla̱m ga̱ɓa jwisi na̱ nali wu. <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />na̱k ɗe Nya ɗe guu wo ten manti ga̱ɓa ka̱n ni sowu, ama ka̱ nda̱lti ga̱ Nya ka̱n ni. <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />Botla̱n gon ta tul malkii na̱ tlemndi ya? ko ta tul na̱ ga̱ɓa ma̱n mulla̱t mbadli ka̱ lamti?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s">Mbola̱n ma̱n pa̱t pa̱la̱n</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />Sa̱ hwi ɗe jon jwaka̱n na̱ma pa̱t suk ma̱dli jwe ba̱ gwasa̱n ka̱ sowu, gwe hal ma̱lgon pi suk kili ga̱ aba gwasi, ma̱jwe ba̱sa̱ yis Nya so mago sa̱ pa̱li so. <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />Ama yek ka̱a̱ na̱ma ɓot ngetl ɗe ka̱a̱ mbuki wi! Yek ba̱ mbadl lili kii yek ka̱a̱ yilli ma̱n pa̱lti wuda̱li gwisi ɗa̱ka̱ dlo gwaka̱n ka̱ sa? <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />Ko ɗe a ni sukkii ka̱ dli sowu, ama mbadl gi ni sukkii. Ka̱ shin ga̱ Bagaa Yesu hal a nol ma̱lgwe pa̱li na̱k gwisi wu wi, na̱k wule a na̱n ka̱li. <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />Kume ka̱ mogaa ka̱ shin ga̱ Yesu Bagaa wu, a mbadl gi ni sukkii, a nda̱lti ga̱ Yesu Bagaa ni ɗa <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />Taki ma̱llu Sheɗa̱n, ta̱ pa̱lti byas wul ka̱ dli<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="ft" closed="false">Sogo</char><char style="fqa" closed="false">ga̱ dli ga̱ ma̱li</char><char style="ft" closed="false">, sogo kangwe dlisi </char></note> ga̱ ma̱li ma̱shi, apaa shishi ga̱ ma̱li mbi kisti ten cin ga̱ Bagaa.<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />Ɓot ngetl gwaka̱n wo ten koo lu ka̱n. Ka̱ yisi ɗe yist wo njet ka̱n asa̱ la̱ski ka̱ guda̱l ba̱redi a ngashi mas sa? <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />Yilla̱n gus yis ka ta̱k pala̱n ɗe pyal guda̱l ba̱redi gwe ba̱ yis ni giɓi sowu, na̱k gwe ka̱a̱ kul ni wu. Na̱k ɗe sa̱ mbosh yen bagalla motgaa ɗakciti wi, tik ɗe Almasihu. <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />Na̱k ɗe nu ka̱wu, ma̱ pa̱la̱n motgaa ɗakcitisi ba̱na̱ gus yis so, yis ga̱ ngalci suk yokiti. Ama pa̱la̱n motgaami na̱ ba̱redi gwe ba̱ yis ni giɓi sowu, gwe sa̱ pa̱li na̱ hwa mbadli suk na̱ gem wu.<verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />A lishikii ten ga̱ cina ɗe, ba̱k cugaa suk ma̱n pa̱t pa̱la̱n so, <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />a nima dla̱mti ga̱ɓa ga̱n, ba̱ ɗe suk ma̱n pa̱t pa̱la̱n, suk ma̱n lamti mot wul nal, suk muka̱l suk ma̱n waal ji dii atl ga̱n ka̱ so. Kume na̱ si ka̱wu, se ko ta̱k zaka̱n dii atli. <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />Ama a nikii ma lishti ɗe ba̱k cugaa suk ma̱lgwe ata̱ mbe gaa gwas ɗe ma̱n kopti, ama ata̱ pi pa̱la̱n, ata̱ lam mot wul wonti, ata̱ pa̱l waali, ata̱ sheli lal mbala̱n gaa, ata̱ tla ɗuki, sogo ata̱ te mbala̱n ga̱zi, ata̱ dla̱m byas ga̱ɓa ten mbala̱n, ngukti wul mago ba̱k nguka̱n suk wunda̱l ga̱ ma̱llu so.<verse eid="1CO 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12" />Yek ɗe ze gi na̱ kisti ga̱ɓa ma̱jwe ba̱sa̱ ɓo ni ɗe ma̱n kopti so wu ye? Ase ma̱jwe sa̱ni ka̱ motgaa kopti ju ka̱n kaa kisi ga̱ɓa so nwa? <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />Nya ka kisi ga̱ɓa ma̱jwe ba̱sa̱ ɓo ni ɗe ma̱n kopti sowu. &lt;&lt;Mbola̱n byas ma̱lgwe ni ka̱ kii wu ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="ft" closed="false">Yen </char><char style="xt"><ref loc="DEU 17:7">K. M. 17:7</ref>; <ref loc="DEU 19:1">K. M. 19:1</ref>; <ref loc="DEU 21:21">K. M. 21:21</ref>; <ref loc="DEU 22:21">K. M. 22:21</ref>; <ref loc="DEU 24:7">K. M. 24:7</ref></char>. </note><verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s">Ba̱k ta̱la yilkeni ma̱n kopti dlaboo so</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />Kume ilgon te ka̱ dlo ga̱ ma̱lgon suk yilka gwas ma̱n kopti go ba̱ta ta̱le mal mbala̱n ji Nya sa? A mal ma̱jwe ba̱ ma̱n kopti ka̱ sowu ka̱n ta̱le a? <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />Ka̱a̱ yisi ɗe mbala̱n ji Nya ka kisi ga̱ɓa ma̱n dii atl sa? Na̱k ɗe kik ka kisi ga̱ɓa ma̱n dii atl go, ba̱ ka man kisti ga̱ɓa ten nak mil wul jwisi sa? <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />Ka̱a̱ yisi ɗe mik ka kisi ga̱ɓa mil shinti ji Nya sa? Na̱k ɗe mik ka kisi ga̱ɓa mil shinti ji Nya wu, yek ka laki a wul ji dii atli kama̱nni gaa ye? <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />Na̱k ɗe nu ka̱wu kume wunda̱l ga̱ɓa jwisi te dlo gwaka̱n wu, botla̱n ma̱jwe a da̱n ɗe ma̱n kisti ga̱ɓa wu ko ba̱sa̱ ni ten bi ilgon so.<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">Sogo </char><char style="fqa" closed="false">ka botl ma̱n kisti ga̱ɓa ka̱ mbala̱n jwe mani ka̱ motgaa ma̱n kopti sa</char></note> <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />A hwikii nu ka̱n ta̱ nsha cikii ɗa, ɓohwe ma̱lgon ma̱n ɓotlka̱n ka̱ kii gwe a ma̱n kisti ga̱ɓa ka̱ dlo ga̱ yilkeni ma̱n kopti kume ɗe ilgon te ka̱ dlo gwasa̱n wu nikii ɗa̱ sa? <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />Ama yek a ma̱n kopti ta̱la yilka gwas ma̱n kopti ka̱ lu kisti ga̱ɓa mal ma̱jwe ba̱ ma̱n kopti ka̱ sowu.<verse eid="1CO 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7" />Na̱k ɗe aka̱a̱ ta̱la yilkeni mal ma̱jwe ba̱ ma̱n kopti ka̱ so ta̱s kisisi ga̱ɓa go, yek ɗe ndat gwaka̱n. Yek laki ba̱ka dlo mbadl na̱ ilgwe sa̱ pa̱lik wu so ye? Dlanti suk yilkeni mago wul nsha ka̱n. Ka dlo mbadl na̱ byas ilgwe yilka gwa pa̱lik wu, a manikii. Yek laki ɗe ba̱ka zaki ta̱ yilkeni pa̱likii byas wul so ye? Yek laki ɗe ba̱ka zaki ta̱s tekii ga̱zi so ye? <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />Ama yek kii na̱ gaa gwaka̱n mago ka̱a̱ pa̱li byas wul yilkeni a ka̱a̱ te ma̱n kopti ga̱zi.<verse eid="1CO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 6:9" />Ka̱ yisi ɗe Nya ɗe guu wo ga̱ ma̱n ngalci ka̱ so sa? Ba̱ ma̱lgon shelki so, na̱ ma̱n pa̱t pa̱la̱n, na̱ ma̱n waali, na̱ ma̱jwe asa̱ mul suk yilkeni ten tantu gwe ba̱ mbun sowu. Na̱ maani ma̱n ngot modli, na̱ maani ma̱n pa̱t suk maani sogo modli ma̱n pa̱t suk modli, <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />na̱ muka̱l, na̱ ma̱n lamti wul ga̱ mbala̱n, na̱ ma̱n tlak ɗuki, na̱ ma̱n hwit byas ga̱ɓa mbala̱n, na̱ ma̱jwe asa̱ te ga̱zi mbala̱n wu, mas jwasa̱n sa̱ mbi Nya ɗe guu so <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />Nu ka̱n jon jwaka̱n ni tek wu, ama yek sa̱ polkii ka, yek sa̱ palla̱kii ɗe ma̱n cilti, yek sa̱ po palla̱kii ɗe ma̱n la̱shi byas wul ka̱ shin ga̱ Yesu Almasihu tumal Shishi ga̱ Nya.<verse eid="1CO 6:11" /></para>
  <para style="s">Ga̱ɓa ten ma̱n pa̱t pa̱la̱n</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />&lt;&lt;Sa̱ zaka̱nni ta̱n pa̱la̱n mas wul, ama ba̱ mas wul ka̱ ni hwaɓi mala̱n so. Ba man pa̱lti mas wul, ama ba̱ da̱n ɗe zhel ga̱ ilgon so.&gt;&gt; <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />Ama ma̱jon a wule, &lt;&lt;Sa̱ pa̱l shin ɗe ga̱ tuki, a tuk wo sa̱ pa̱li ɗe ga̱ shin,&gt;&gt; Ama Nya a lilsi ka mas. Sa̱ pa̱l dli go ba̱ ɗe ta̱ mbala̱n pi pa̱la̱n na̱ nali ka̱ so, sa̱ pa̱l dlisi ka̱n ten ɗe ga̱ Bagaa, ten na̱k gwisi ka̱n dli gwa wo ga̱ Bagaa ka̱n. <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />Na̱k gwe nda̱lti ga̱ Nya tlil Bagaa kaal ɗa̱ ma̱shka̱n gwasi yek ta̱ pal kaami wu, nu ka̱n Bagaami a tlila̱nni ka̱ nda̱lti gwas pak. <verse eid="1CO 6:14" /><verse number="15" style="v" sid="1CO 6:15" />Ka̱a̱ yisi ɗe dli ga̱ mas ma̱n kopti wo ka̱t dli ga̱ Almasihu ka̱ sa? Mbun ɗe ta̱n kama̱n dli ga̱ Almasihu a mwe suk kili ma̱n kopti maani ya? Ko njaa! <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />Ka̱a̱ yisi ɗe mas ma̱lgwe moo dli gwas suk kili ma̱n kopti maani go, dli gwas ɓal ɗena̱m sukti sa? Na̱k gwe ga̱ɓa ga̱ Nya dla̱m wu ɗe, &lt;&lt;Mbala̱n ɗe loɓi, sa pal ɗe dli ɗena̱m.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false">Yen </char><char style="xt"><ref loc="GEN 2:24">L. Z. 2:24</ref></char>. </note> <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />Ama mas ma̱lgwe mo gaa suk Bagaa go, ta̱ pal ɗena̱m sukti wi ka̱ shishi gwasi.<verse eid="1CO 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18" />Aɓi pa̱t pa̱la̱n, mas byas wul jwe mbala̱n pa̱li go, ta̱n dli gwas so, ama ma̱lgwe pi pa̱la̱n go, ta̱ te dli gwas ga̱zi. <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" />Ka̱a̱ yisi ɗe dli gwaka̱n wo boo ga̱ Shishi ga̱ Nya gwe ni ka̱ kii wu ka̱ sa? Gwe Nya ba̱lkii wu. Ka̱a̱ po yi ɗe ga̱ gaa gwaka̱n so. <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />Nya wulkii wi. Na̱k ɗe nuk ni wu, nalla̱n Nya na̱ dli gwaka̱n.<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s">Kumti ga̱zi ten hapti</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />Ten bi wul jwe ka̱ lishi wu, mbun ɗe ta̱ mbala̱n pa̱l hapti so.<note caller="+" style="f"><char style="fr" closed="false">7:1 </char><char style="ft" closed="false">Sogo </char><char style="fqa" closed="false">&lt;&lt;Mbun ɗe ba̱ mbala̱n ɓo pi suk modli so.&gt;&gt;</char></note> <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />Ama na̱k ɗe pa̱t pa̱la̱n nal ka̱ dlo gwaka̱n wu, ta̱ mas maani suk modli pa̱l hapti. <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />Ta̱ kos pa̱li ilgwe ni ngetli ɗe ta̱s pa̱li kili gwas wu, a kili mago ta̱s pa̱l ilgwe ni ngetli ɗe ta̱s pa̱li kos gwas wu. <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />Dli ga̱ kilisi wo gwas ka̱ so, ga̱ kosi ka̱n, a dli kosi wo gwas ka̱ so, ga̱ kilisi ka̱ pak. <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />Ba̱k nge ten dli jwaka̱n yilkeni so, se ko na̱ lamti gwaka̱n ga̱ nak njet da̱nti ta̱k ngema̱n Nya ɗa, apaa ka̱ palli mot gwaka̱n, ba̱ guu ma̱zhe cinga̱lkii so ɗa, na̱k ɗe ba̱ka̱a̱ man dlot mbadl na̱ la̱shi mot gwaka̱n sowu. <verse eid="1CO 7:5" /><verse number="6" style="v" sid="1CO 7:6" />Amik ni kii ma hwit ga̱ɓa ge, Nya ka̱ wule ta hwikii so. <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />Lamti gi kani wu, a mbala̱n mas ni na̱k ami. Ama ko wokko na̱ manti gwe Nya ba̱lti wu. Ta̱ ba̱l manti pa̱lti ilga̱n ma̱lgon, zobsi ma̱lgon wo yek ta̱ ba̱lti manti pa̱lti ili gon.<verse eid="1CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8" />Yenti gi wo mbun ɗe ta̱ ma̱jwe ɓo pa̱l hapti sowu suk modli jwe maani jwasa̱n ma̱sh wu da̱m ba̱ hapti so, ta̱s da̱n na̱k ami. <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />Sa pa̱l hapti go a mani si, ɗa̱ gwe ta̱ lamti modli sogo lamti maani man ngetl gwasa̱n wu.<verse eid="1CO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10" />Ma̱jwe pa̱l hapti wu, ha̱n ta hwikii mba̱t ge, amik dla̱m so, Bagaa ka̱ dla̱mi ɗe, &lt;&lt;Ba̱ kili huul suk kos gwas so.&gt;&gt; <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />Ama kume kili a hul suk kos gwas wu, ba̱s po hap ma̱lgon so, seko ta̱s pal mal kos gwasi. Koosi mago ba̱s hul suk kili gwas so.<verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />Ga̱ɓa gwe ba hwi naa mbala̱n go yek ɗe, ko ɗe amik dla̱mi, Bagaa ka̱ dla̱m sowu, yek ɗe kume kili ni ma̱n kopti ɗa, a kili si wo ba̱ ma̱n kopti ka̱ so, ata̱ lam da̱nti suk kos gwas wu, ba̱s hul sukti so. <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />A kume kilisi ka̱ɗe ma̱n koptisi a koosi wo ba̱ ma̱n kopti ka̱ sowu, ata lam da̱nti suk kilisi wu, ba̱ kilisi hul sukti so. <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />A dla̱m nu na̱k ɗe kosi ɗe ba̱ ma̱n kopti ka̱ sogo sa̱ polti ka̱wi tumal da̱nti suk kili gwasi. Nu ka̱n, kili gwe ba̱ ma̱n kopti ka̱ sowu, sa̱ polti ka̱wi tumal da̱nti gwas suk kos gwas ɗe ma̱n kopti wu. Nuk kani sogo mil jwasa̱n ani ga̱ poli so, ama yek gu ningo sa̱ polsi ka̱wi.<verse eid="1CO 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 7:15" />Ama kume ma̱lgwe ba̱ ma̱n kopti ka̱ so ka̱ lam zakti ga̱ ma̱n koptisi wu, ta̱s hwuli. Kume pi nu wu, ma̱n koptisi pa̱l byas wul so, na̱k ɗe Nya mbeni ta̱n da̱ma̱n na̱ ta̱mi mbadl suk mas mbala̱n wu. <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />Ki kili ma̱n kopti wu ka̱ yisi ya, a ɗe kik ka pa̱l tantu kisti ga̱ kos gwa wu? Ki kos wu ka̱ yisi ya, a ɗe kik ka pa̱l tantu kisti ga̱ kili gwa wu?<verse eid="1CO 7:16" /></para>
  <para style="s">Wunda̱l da̱nti gwe Nya lami wu</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />Ha̱n ta̱ ko wokko pa̱l wunda̱l da̱nti gwe Nya ba̱lti ɗe ta̱s da̱ma̱n wu suk kangwe Nya mbet ɗe ta̱s pa̱li wu. Mba̱t gwe a ba̱l mas ma̱n kopti wuggu. <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />Ma̱lgwe sa̱ sa̱lti paa yek Nya mbet go, ba̱s ngwe ɗe ta̱s da̱m ba sa̱lti so. A ma̱lgwe Nya mbeti a ba̱sa̱ ɓo sa̱lti sogo, ba̱s ngwe ɗe ta̱s sa̱lti so. <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />Na̱ sa̱lti na̱ la̱shi sa̱lti, ko gon ni ten bi ilgon so. Ilgwe mani go yek ɗe kopti mba̱t ga̱ Nya. <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />Ha̱n ta̱ mas jwaka̱n da̱m na̱k gwe ka̱a̱ ni ɗe Nya mbekii wu. <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />Zhel ka̱ɗe kii ɗe Nya mbekii gwa? ba̱ hwotkii so, a kume ka ɓatl gaa gwaka̱n wu, ba̱k nge so. <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />Nu ka̱n kume Nya mbe mbala̱n ata̱ ni ɗe zhel go, mal Bagaa wo sa̱ ɓatlti wi. A ma̱lgwe Nya mbeti a ba̱ta̱ ni ɗe zhel sogo ta̱ da̱n ɗe zhel ga̱ Almasihu wi. <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />Almasihu wulkii na̱ bal ɓatlti wi, Na̱ nu ka̱n ba̱k da̱ma̱n ɗe zhel ga̱ mbala̱n so. <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />Yilkeni jini, kangwe ɗe paa Nya mbekii wu, da̱ma̱n suk Nya nu.<verse eid="1CO 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />Ten mil modli jwe ba̱sa̱ ɓo pa̱l hapti sowu, Bagaa hwi ilgon tensi so ama ba dla̱m ilgwe a yeni ɗe mbun wu na̱k ɗe ka̱a̱ yisi ɗe ami wo ma̱n pa̱lti gem ka̱n tumal yenti gonti ga̱ Bagaa wu. <verse eid="1CO 7:25" /><verse number="26" style="v" sid="1CO 7:26" />A yeni go mbun ɗe ta̱k da̱ma̱n na̱k gwe ka̱ ni wu na̱k ɗe mbala̱n ɓal ka̱ bomti wu. wul jwisi na̱ma pa̱t nu wu. <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />A kume ka̱ pa̱l hapti wu, ba̱k ɓatla̱n ka̱ so. Kume ka̱ ɓo pa̱l hapti sowu, ngo hapti so. <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />Kume ka̱ pa̱l hapti wu, ka̱ pa̱l byas wul so. Kume yen kili pa̱l hapti wu, ta̱ pa̱l byas wul so. Ama ma̱jwe pa̱l hapti go sa tla bomti nal na̱ ngipti lubiii, yek laki yek a lami ɗe ta yilla̱kii ɗa̱ka̱ bomti gwisi ka.<verse eid="1CO 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29" />Yilkeni, ilgwe a na̱ma dla̱mti go yek ɗe, multi gwe sa̱ zi go ɓal njaa. Kan ase ma̱jwe pa̱l hapti wu, ta̱s da̱n na̱k wule sa̱ ɓo pa̱la̱n hapti so. <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />Ma̱jwe na̱ma duu tuk wu ta̱s da̱n na̱k wule sa̱ na̱nma duu tuk so, ma̱jwe na̱ma hwol tuk wu ta̱s da̱n wule sa̱ na̱nma hwol tuk so, ma̱jwe wul wul wu ta̱s da̱n wule wuli wo gwasa̱n ka̱ so <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />Ma̱jwe na̱ma pa̱lti wul na̱ wul ga̱ dii atl go ba̱s zi mbadl dani so, na̱k ɗe a paki wu.<verse eid="1CO 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32" />A lami ɗe ta̱k gulsa̱la̱n gaa gwaka̱n so. Ma̱lgwe ɓo pa̱l hapti sogo, wul ga̱ Bagaa ka̱ hwotti i'e. <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />Ama ma̱lgwe pa̱l hapti wugo, daamti gwas wo ten wul ga̱ dii atl ka̱n ni, kangwe ta mulli mbadl kili gwas wu. <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />Mbadl gwas wo ga̱ caali ka̱n ni. Nu ka̱n, kili gwe ba̱ kos niɗɗa̱ sowu, suk yen kili gwe ba̱ta̱ ɓo pa̱l hapti sowu, a wul ga̱ Bagaa hwotti i'e ta̱s da̱n zoki ka̱ Shishi. Kili gwe pa̱l hapti go a wul ga̱ dii atl hwotti ta̱s pa̱li kos gwas ilgwe ta̱ lami wu. <verse eid="1CO 7:34" /><verse number="35" style="v" sid="1CO 7:35" />A nikii ma dla̱mti nu ta̱ mbunikii. Ba̱ ɗe we ta palla̱kii ɗokco ka̱ so, ama ta̱k ngusi atl Nya ba̱ ilgon gulsa̱lkii so.<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />Kume ma̱lgon ndal yen kili ɗe ta hapti, ama yek ta̱ yeni go ta̱ pa̱lit ilgwe ɗe ba̱ yek sowu a ta̱ ɓa koli ka, ama mas nu ta̱ lami ɗe ta̱s hapti wu. Ta̱s hapti, ta̱ pa̱l byas wul so. <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />Ama ma̱lgwe zi ka̱ mbadl ɗe ta hap yen kilisi so, a ba̱ ma̱lgon mbuki ta̱s zit ngetl sowu, ti mago ta̱ pa̱l hwa wul ɗe ta̱ hap yen kilisi sowu. <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />Ma̱lgwe hap yen kilisi gwe ta̱ ndalti wu pa̱l hwa wul, ama ma̱lgwe hapti sowu pa̱l hwa wul mani.<note caller="+" style="f"><char style="fr" closed="false">7:38 </char><char style="ft" closed="false">Sogo</char><char style="fv" closed="false">36</char><char style="fqa" closed="false">Ma̱lgwe da̱m gwa we ta̱ na̱ma kulati na̱ yen gwas gwe ɓa koli wu, sowu </char></note><verse eid="1CO 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39" />Kili a hul suk kos gwas so kume ba̱ kosi ɓo ma̱sh sowu. Ama kosi ma̱sh wu, ta man hapti ga̱ mas ma̱lgwe ta̱ lami wu, ama ngetl ka̱n ta̱ ma̱lgwe ta hapti wu ni ɗe ma̱n kopti ga̱ Bagaa Yesu. <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />Ka̱ yenti gi wo, ta pa̱l hapti sogo ta kum ta̱mti mani, ka̱ yenti gi wo Shishi ga̱ Nya.<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s">Ilga̱ nguki gwe sa̱ taki gunki wu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />Ningo ten bi ilga̱ nguki gwe sa̱ taki gunki wu, mas jina̱n ma̱ yisa̱n wul wi, ko ɗe yistisi wo a lak mbala̱n ten nalti gaa, ama lamti yilkeni wo a laki a mbala̱n zi-ang mas mbala̱n. <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />Ma̱lgwe kan ɗe ta̱ yis ilgon go, ta̱ ɓo yisi na̱k gwe mbun ɗe ta̱s yisi wu so. <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />Ama ma̱lgwe lam Nya go, Nya yisti.<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />Ten bi ilga̱ nguki gwe sa̱ taki gunki go, ma̱ yisi ɗe gunki wo ta̱ ni ten bi ilgon ten dii atl ge so. Ma̱lgwe mbuki ta̱ mbala̱n ngusit atl go ɗe na̱m ka̱n. <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />Ko ɗe wul jwe a mbala̱n ngusisi atl wu ni ɗa̱ ten dii atli, sogo to dlo nya ka, na̱k ɗe wul jwe a mbala̱n ngusisi atli suk baboo ni ɗa wonti wu, <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />mas na̱ nu, mi wo ma̱ yisi ɗe ma̱lgwe mbuki ɗe ta̱ mbala̱n ngusit atl go ɗena̱m ka̱n, tik ɗe Buka. Tik pa̱l mas wul, ti ka̱n ma̱ na̱ma da̱nti gwasi. Bagaa mago ɗena̱m ka̱n, tik ɗe Yesu Almasihu ma̱lgwe tumalti ka̱n mas wul pi wu. Mi mago ti ka̱n ma̱ nitma da̱nti.<verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />Ama mas mbala̱n ka̱ yis gem gwisi so. Naa mbala̱n wo sa̱ ku na̱ gunki ka̱ lu waal wi. Hal ninge mago kume sa̱ nguk wul jwisi wu, asa̱ da̱ma̱n gwa we gwe sa̱ taki gunki wu ka̱n. Na̱k ɗe mbadl gwasa̱n kamisi nu sowu, sa̱ ɓa yeni go sa̱ pa̱l ilgwe ba̱ yek sowu. <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />Ilga̱ nguki a ta̱lani njaa mal Nya so; kume ma̱ nguka̱n sowu, mba̱li ni ilgon so, a kume ma̱ nguk wu, mba̱li ni ilgon dani so.<verse eid="1CO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9" />Pa̱n ɗem-ɗem na̱ pa̱lti ilgwe sa̱ zakkii ɗe ta̱k pa̱li wu, ba̱k laka̱n ma̱jwe nga̱sti gwasa̱n ten Yesu ɓo nda̱l sowu ten ndat so. <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />Kume ma̱jwe nga̱sti gwasa̱n ten Yesu ɓo nda̱l sowu yen ki ten ngukti ilga̱ nguki gwe sa̱ taki gunki ka̱ lu waal wu, ki ɗe ka̱ yisi man si wu, a laki asa̱ ngusi ngukti ilga̱ nguki gwe sa̱ taki gunkisi ka̱ lu waal wu sa? <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />Na̱ nu ka̱n yilka gwe nga̱sti gwas ten Yesu ɓo nda̱l sowu, gwe Yesu ma̱sh a gaa gwas go, yisti gwa a laki ata̱ zak nga̱sti gwas ten Yesu sa? <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />Kume ka̱ pa̱li byas wul yilka gwa nu hal yek ba̱ta̱ man yisti dlo ga̱ byas wul suk hwaɓi sowu, Yesu ka̱n ka̱ pa̱lit byas wul. <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />Yek laki kume ilgwe a na̱ma ngukti wu a laki a yilka gi pa̱l byas wul wu, ba po nguk tlu so ba lak laki a yilka gi nda.<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s">Ilgwe mbun ɗe ta̱ yen shinti ga̱ ɓotli ga̱ Yesu mbi wu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />A ɓo mbi gaa gi sa? A mi wo yen shinti ga̱ botli ga̱ Yesu ka̱sa? A yena̱n Yesu sa? Tumala̱n ka̱n ka̱a̱ da̱n ɗe ma̱n kopti sa? <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />Kume mal naa mbala̱n wo yen shinti ga̱ botli ga̱ Yesu ka̱ɗe ami sogo, ama kii wo ka̱a̱ yisi ɗe ami wo yen shinti botli ga̱ Yesu ka̱n, na̱k ɗe da̱nti gwaka̱n ɗe ma̱n kopti, mbok ang ɗe ami wo yen shinti ga̱ Yesu ka̱wu.<verse eid="1CO 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3" />Ilgwe ba hwi ma̱jwe na̱ma kumti ga̱zi ɗe ko ami wo yenti shinti ga̱ botli ga̱ Yesu ka̱ɗe ami wuggu. <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />Ngetli ka̱n ta̱s ba̱lni ilga̱ nguki suk ga̱ tle sa̱? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />Ma mana̱n hapti kili ma̱n kopti na̱k gwe naa mil shinti ji botli ga̱ Yesu suk yilkeni ji Yesu suk Kepas pa̱li wu sa<note caller="+" style="f"><char style="fr" closed="false">9:5 </char><char style="ft" closed="false">Ti ka̱n asa̱ po mbet, Biturus</char></note>? <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />Ko ami suk Barnabas na̱ ngwena̱n ka̱n nini ngetli ta̱n ngo ilga̱ nguki na̱ gaa ga̱na̱n?<verse eid="1CO 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 9:7" />Ma̱n hapti dlo gwik ka kan diɓa̱lti ilga̱ nguki ga̱ gaa gwas gwi? Wok ka ɓak zhin inabi a ba̱ ta nguk yandi so wo? Wok ka pi kyo tunga tla a ba̱ta tla zeni gwasa̱n so wo? <verse eid="1CO 9:7" /><verse number="8" style="v" sid="1CO 9:8" />Ilga̱n ɗe a dla̱m go, ka̱a̱ ɓa yeni go daamti gi ga̱ mbala̱n ka? Mba̱t gwe Nya ba̱l Musa mago nu ka̱n dla̱m sa? <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" />Nu ka̱n sa̱ lishi ka̱ mba̱t gwe Nya ba̱l Musa wu, &lt;&lt;Ba̱k kusi bi tla ka̱ so kume ta̱ na̱ma ɓot alkama wu.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:9 </char><char style="ft" closed="false">Yen </char><char style="xt"><ref loc="DEU 25:4">K. M. 25:4</ref></char>. </note> Ka̱a̱ da̱ma̱n gwa we ten tla ka̱n Nya na̱ma ga̱ɓa a? <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />Tenni ka̱n sa̱ lish ga̱ɓa gwisi sa? Gem tenni ka̱n sa̱ lishi. Na̱ ma̱n gut zhin na̱ ma̱n cokti alkama mas jwasa̱n sa̱ zi mbadl ka̱n ten ilgwe sa mbi wu. <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" />Na̱k gwe ma̱ ɓak ga̱ɓa ga̱ Nya ka̱ mbadl gwaka̱n na̱k kangwe asa̱ ɓak gwe wunda̱l ka̱ zhin wu, byas wul ka kume ma̱ mbi ilgon malki wu? <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />Kume ma̱jon man pa̱lti nu wu, ma̱ mbuki ta̱n pa̱li man gwasa̱n wu. Mas na̱ nugo, yek ba̱ma pa̱l ilgwe ma̱ mbuki ɗe ta̱n pa̱li wu so.</para>
  <para style="p" vid="1CO 9:12">Yek ma̱ dlo mbadl na̱ mas wul ɗa̱ gwe ta̱n tulli ilgwe a dla̱lli ga̱ɓa ga̱ Nya wu ka. <verse eid="1CO 9:12" /><verse number="13" style="v" sid="1CO 9:13" />Ka̱a̱ yisi ɗe ma̱jwe pa̱l wul ka̱ bii ngemti Nya go ilgwe a mbala̱n tulli ka̱li wu ka̱ɗe ilga̱ nguki gwasa̱n sa? A ma̱jwe ɗe asa̱ taki wul Nya ka̱ lu taktisi go a giɓi ka̱n asa̱ mbi ilga̱ nguki gwasa̱n sa? <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" />Nu ka̱n Nya dla̱m ɗe, &lt;&lt;Ma̱jwe dla̱m ga̱ɓa ma̱n ta̱mti go, ta̱s mbi ilga̱ nguki gwasa̱n tumal dla̱mti ga̱ɓa ma̱n ta̱mti.&gt;&gt;<verse eid="1CO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15" />A ɓo taɓa wulti ɗe ta̱k pa̱lini nini wul jwisi so, nin mago ba̱ ɗe we na̱kka̱n a nikii ma lishti ta̱k pa̱lini nini so. Ma̱shka̱n manini ɗa̱ gwe ta̱s le bi ka a ba̱ ba man ɓot ngetl ten iljin ɗe a dla̱m wu sowu. <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />Dla̱mti ga̱ɓa ma̱n ta̱mti a laki a ɓo ngetl ɗe a mbuki so, na̱k ɗe ngetli ka̱n nini ta pa̱li wu. Ba da̱n ɗe wul cit gonti kume a dla̱m ga̱ɓa ma̱n ta̱mti sowu. <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />Kume lamti gi kani ɗe a na̱ma dla̱mti ga̱ɓa ma̱n ta̱mti wu, ngetli ka̱n ta̱s ɓatla̱nni. Ama na̱k ɗe ba̱ lamti gi ka̱ sowu, yek ɓal ɗe ilga̱ pa̱li gini. <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />Yek na̱ yek sa ɓatla̱n ye? Ilgwe sa ɓatla̱n na̱ na̱li go yek ɗe, kume a dla̱m ga̱ɓa ma̱n ta̱mti wu, ta pa̱li ten koo lu, ba wule ta̱s ba̱la̱n mas ilgwe ni ngetli ɗe ta̱s ba̱la̱n wu so ɗe a na̱ma dla̱mti ga̱ɓa ma̱n ta̱mti wu.<verse eid="1CO 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />Ko ɗe ami wo zhel ga̱ ma̱lgon ka̱ sowu, ama yek a palli gaa gi ɗe zhel ga̱ mas mbala̱n ta dla̱k mbala̱n wonti tet mal Yesu na̱ mas manti gini. <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />A pal mal ma̱n Yehuda wu, a palli gaa gi na̱ksi ta man ta̱lat gwasa̱n tet mal Yesu. A kume a pal mal ma̱n kopti mba̱t ga̱ɓa ga̱ Musa wu, a palli gaa gi na̱k ma̱n kopti mba̱t ga̱ Muse, (Ko ɗe mba̱ti ni gaa sowu). A pa̱li nu, ta man dla̱kti ga̱ ma̱jwe na̱ma kopti mba̱ti wu. <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />Kume a ni suk ma̱jwe ma̱n Yehuda ka̱ sowu, a palli gaa gi na̱k ma̱lgwe mba̱t nit gaa sowu (Ba̱ ɗe we a kop mba̱t ka̱ so so, mba̱t ga̱ Almasihu ka̱n a na̱ma kopti). Ta man dla̱kti ga̱ ma̱jwe mba̱t nisi gaa wu. <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />Kume a ɓal suk ma̱jwe nga̱sti gwasa̱n ten Yesu ɓo nda̱l sowu. A palli gaa gi na̱ksi ta dla̱ksi tet ɗa. A palli gaa gi ɗe wul wonti mal mbala̱n ta man dla̱kti gwasa̱n tet ɗa. <verse eid="1CO 9:22" /><verse number="23" style="v" sid="1CO 9:23" />A pa̱l mas wul jwisi ta ma̱dla̱l ga̱ɓa ma̱n ta̱mti, ta mbi hwa wul gini gwe ni ka̱ dla̱mti ga̱ɓa ma̱n ta̱mti wu.<verse eid="1CO 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 9:24" />Ka̱a̱ yisi ɗe ma̱jwe asa̱ pa̱l jetit tet yilkeni go, mbala̱n ɗe na̱m ka̱ɗe ma̱n tet gwasa̱n mas asa̱ ɓatlti sa? Aɓa̱nni ta̱k mbi ɓatlti. <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />Ma̱jwe asa̱ jeti go, asa̱ nol gaa gwasa̱n i'e ta̱s mbi ɓatlti gwe a paki wu. Ama mi wo ɓatlti gwe ma̱ na̱ma ngoti go gwe ba̱ a paki sowu ka̱n. <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />Yek laki ɗe apti gwe a na̱ma pa̱lti go ten koo lu ka̱ so, a dlanti gi wo na̱k ma̱n ɓot yeta̱l ka̱ so. <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />A nol dli gini yek a palli dlisi ɗe zhel gini. Ba̱ Nya la̱ka̱n ka̱ so kume a pak dla̱mti ga̱ɓa ma̱n ta̱mti wu.<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s">Matlti ten ngusti atl gunki</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />Yilkeni jini, a lami ɗe ta̱k yisi ɗe aba jina̱n tet go mas jwasa̱n sa̱ ni ga̱s nyaze, yek sa̱ koɓi ka̱ dlo bal dla̱lka ma̱n tlal me. <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />Yek sa̱ pa̱lisi baptisma ka̱ ɓondi suk ka̱ bal zesi ka̱ da̱nti gwasa̱n ɗe ma̱n kopti ga̱ Musa. <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />Mas jwasa̱n sa̱ nguk ilga̱ nguki ga̱ Shishi wunda̱li ɗena̱m. <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />Mas jwasa̱n sa̱ tla wul ga̱ tle ga̱ Shishi wunda̱li ɗena̱m. Sa̱ tla tet ka̱ paa ga̱ Shishi gwe ngusi kopti gwasa̱n wu. Paa gwisi wo yek ɗe Almasihu. <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />Ama mas na̱ nu, yek ba̱ Nya pa̱l hwol tuk na̱ wonti ka̱si so. Yek hwu gwasa̱n cat ɗa̱nka̱ me ka.<verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />Wul jwisi pi ta̱n yeni ni<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="ft" closed="false">Sogo </char><char style="fqa" closed="false">wunda̱l ji</char><char style="ft" closed="false">ni ka̱ lu ndati ɗe 11 pak</char></note> ba̱n za̱n mbadl ten byas wul na̱k gwe sa̱ pa̱li wu so. <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />Ba̱k ngusi atl gunki na̱k gwe jon jwasa̱n pa̱li wu so. Na̱k gwe ni ga̱ lishi wu ɗe, &lt;&lt;Yek mbala̱mi da̱m na̱ zhila yek sa̱ nguk wul, yek sa̱ tla, yek sa̱ tlinya yek sa̱ dlali, na̱k ma̱n waali.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="xt"><ref loc="EXO 32:6">Yil 32:6</ref></char>. </note> <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />Ba̱n pa̱n pa̱la̱n na̱k gwe sa̱ pa̱li wu so, gwe laki yek zangu ɗe kutl ɗe lop na̱ mekan ka̱si ma̱sh ten cin ɗe na̱m. <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />Ba̱n cinga̱la̱n Nya na̱k gwe jon jwasa̱n pa̱li wu so. Yek laki yek wuci assi yek sa̱ ma̱shi. <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />Ba̱k nala̱ma̱nni na̱k gwe jon jwasa̱n pa̱li wu so hal yek Yen Shinti ga̱ Nya ma̱n tloti tlosi ka̱wu.<verse eid="1CO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11" />Mas wul jwisi pi ta̱n yeni ni. Yek sa̱ lishi ta̱s da̱lini ka̱ng ɗa mi ɗe ma̱ na̱n ka̱ pakti multi wu. <verse eid="1CO 10:11" /><verse number="12" style="v" sid="1CO 10:12" />Yek laki kume ka̱ da̱ma̱n gwa we ka̱ dla̱l nda̱li wu, pi ɗem-ɗem. <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />Kangwe sa̱ cinga̱lkii wu mas, yisi ɗe sa̱ cinga̱l ma̱jon nu wi pak. Na̱k ɗe Nya wo ma̱n pa̱lti gem ka̱n, ta zak cinga̱lti gwe a man ngetl gwaka̱n wu a mbikii so. Kume sa̱ cinga̱lkii wu, ta pa̱likii tantu gwe ka yil wu aka̱a̱ man dla̱lti.<verse eid="1CO 10:13" /></para>
  <para style="s">Ngukti ka̱ gal ga̱ Almasihu suk ga̱ gunki</para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />Yela̱n jini kii ɗe a lamkii wu, aɓi ngusti atl gunki. <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />Ga̱ɓa ga̱n go ma̱n ɓotlka̱n ka̱n a nisi ma hwiti, ɓo daama̱nkii ten ilgwe a dla̱m wu. <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" />Mbuka hwa wul ga̱ Nya gwe a ma̱ pa̱la̱n hwol tuk na̱ nali go yek laki yek ma̱ palla̱n ɗe na̱m ka̱ hwulan ga̱ Yesu sa? Burodi gwe a ma̱ cali go, yek ɗe ma̱n lakti a ma̱ palla̱n ɗe na̱m ka̱ dli ga̱ Almasihu sa? <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />Na̱k ɗe ba̱redi ɗe na̱m ka̱wu, mi ɗe ma̱na̱n wonti go ɗena̱m ka̱n ma̱na̱nni, na̱k ɗe ba̱redi ɗena̱m ka̱n ma̱ nguka̱n wu.<verse eid="1CO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18" />Ɓo yena̱n ma̱n Yisiraila la, ma̱jwe asa̱ nguk ilgwe asa̱ mboshi Nya go, ɗena̱m ka̱n sa̱ni ka̱ ngukti ilgwe sa̱ taki Nyami wu sa? <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />Yek a lamikii dla̱mti a ɗe ye? Ɗe ilgwe asa̱ mboshi gunki go hwa wul laa? Ko ɗe gunki wo hwa wul ka̱n? <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />Ko njet, ilgwe a ma̱n waali mbosh wu ka̱n a na̱ma ga̱ɓa dani. Ma̱n waal wo ma̱zhe ka̱n asa̱ mboshisi wul, Nya ka̱n asa̱ mboshit so. A lami ɗe ta̱ ilgon mokii suk ma̱zhe so. <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />Kaa tla ka̱ mbuka ga̱ Bagaa aka̱ po tla ka̱ mbuka ga̱ ma̱zhe so. Ka nguk ten tebur ga̱ Almasihu aka̱ po nguk ten tebur ga̱ ma̱zhe so. <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />Ma̱ na̱mma lamti ta̱ daka̱lti ga̱ Bagaa tli ya. Ma̱ nda̱la̱n manti ya?<verse eid="1CO 10:22" /></para>
  <para style="s">Pa̱la̱n mas wul ta̱ mbala̱n ba̱l nalti Nya</para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />Mbala̱n na̱ma wulti ɗe, &lt;&lt;Sa̱ zaka̱nni ta̱n pa̱la̱n mas wul,&gt;&gt; ama ba̱ mas wul ka̱ mbunikii so. A sa̱ na̱ma wulti ɗe, &lt;&lt;Sa̱ za̱ka̱nni ta̱n pa̱la̱n mas wul.&gt;&gt; ama ba̱ mas wul ka̱ɗe man taimakat ga̱ mbala̱n so.<note caller="+" style="f"><char style="fr" closed="false">10:23 </char><char style="ft" closed="false">Yen </char><char style="xt"><ref loc="1CO 6:2">1Kor 6:2</ref></char>. </note> <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />Ba̱ ilga̱ gaa gwa na̱ ngwe hwotki so, ama ta̱ wul ji naa mbala̱n hwotki pak.<verse eid="1CO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25" />Nguka̱n mas tlu gwe asa̱ wul ka ka̱ lu motgaa wu, ba̱k kuma̱n ga̱z ga̱ lu gwe yil tet wu so. Ba̱ mbadl gwaka̱n gulsi ka ten lu gwe yil tet wu so <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />Na̱k gwe ga̱ɓa ga̱ Nya dla̱m wu, &lt;&lt;Dii atli na̱ mas ilgwe ni giɓi wu, ga̱ Bagaa ka̱n.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:26 </char><char style="xt"><ref loc="PSA 6:1">Zab 6:1</ref></char>. </note><verse eid="1CO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27" />Kume ma̱jwe ba̱ ma̱n kopti ka̱ sowu mbekii ɗe ta̱k nguka̱n wul a ɗaasi ka̱wu, nguka̱n mas ilgwe sa̱ ba̱lkii wu ba̱k kuma̱n ga̱zi so ba̱ hwot mbadl gwaka̱n so ɗa. <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />Ama kume ma̱lgon wulkii ɗe tlu ga̱n go gunki ka̱n sa̱ mboshit wu, ba̱k nguka̱n so, a gaa ga̱ ma̱li, a ki mago mbadl a ta̱mik so<note caller="+" style="f"><char style="fr" closed="false">10:28 </char><char style="ft" closed="false">Ka̱ lishti jwon wo ɗe, </char><char style="fqa" closed="false">Daamti ka̱ɗe &lt;&lt;dii atl wo ga̱ Nya ka̱n na̱ mas wul jwe ni giɓi wu.&gt;&gt;</char></note> <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />Ba̱ ɗe kangwe ka̱ daamkii dani wu so, ama kangwe ma̱li a daamti wu. Gon a ma̱lgon wule, &lt;&lt;Yek ka laki a ilgwe mbadl gi lami wu da̱n ɗe wul ga̱ɓa mal ma̱lgon ye?&gt;&gt; <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />Kume a nguk wul a nima pa̱lti hwol tuk na̱ Nya go, yek ka laki a ma̱lgon yena̱n na̱ duu gwel ten ilgwe a nguki a na̱ma pa̱lti hwol tuk na̱ Nya gwe?<verse eid="1CO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31" />Mas ilgwe kaa pa̱li wu, ko ngukti ko tlati, pa̱lini mas ta̱ Nya mbi nalti. <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />Ba̱k laka̱n ma̱lgon ta̱s pa̱l byas wul so, ko ta̱ ma̱n Yehuda, ko ta̱ ma̱jwe ba̱ ma̱n Yehuda ka̱ sowu, ko ta̱ motgaa ga̱ ma̱n kopti ga̱ Yesu. <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />Pa̱li na̱k gwe a na̱ma pa̱lti wu, a na̱ma dlot gini ta pa̱l ilgwe mas mbala̱n a kum ta̱mti na̱ mas ilgwe a na̱ma pa̱lti wu. A pa̱l wul a gaa gi na̱ nge so, ama a gaa ga̱ ta̱ mbala̱n wonti mbi kisti ɗa.<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="nb">
    <verse number="1" style="v" sid="1CO 11:1" />Pa̱la̱n ilgwe a pa̱li wu na̱k gwe a pa̱l ilgwe Almasihu pa̱li wu.<verse eid="1CO 11:1" /></para>
  <para style="s">Ga̱ɓa ten yitlat gaa ga̱ modli</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />A ta̱skii na̱k ɗe ba̱kaa ma̱sa̱na̱n ka̱ mas ilgwe ka̱a̱ na̱ma pa̱lti sowu, ka̱a̱ ngip ilgwe a mbokikii ang dani wu<note caller="+" style="f"><char style="fr" closed="false">11:2</char><char style="ft" closed="false">Sogo</char><char style="fqa" closed="false">Kangwe asa̱ pa̱l wul wu</char></note> na̱k gwe ka̱a̱ kumi wu.<verse eid="1CO 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 11:3" />A lami ɗe ta̱k yisi ɗe Almasihu ka̱ɗe bacina ga̱ mas maani, a maani ka̱ɗe bacina ga̱ modli. A Nya ka̱ɗe bacina ga̱ Almasihu. <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />Mas maani gwe ngem Nya, sogo ta̱ dla̱m ga̱ɓa ga̱ Nya na̱ gaa ga̱ yitle ka̱ go, ta̱ mbul bacina gwasi. <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />Mas kili gwe ngem Nya, sogo ta̱ dla̱m ga̱ɓa Nya a ba̱ta̱ yitla gaa gwas ka̱ sogo, ta̱ mbul bacina gwasi. Ndakce suk ta̱s wutl gaami ka ka̱n. <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />Kume kili mbala̱n a yitla gaa gwas ka̱ sowu, ta̱s wutl ka. A kume wutlti ka sogo pashti ka cit nsha wu, ta̱s yitle ka. <verse eid="1CO 11:6" /><verse number="7" style="v" sid="1CO 11:7" />Ba maani wo mbun ɗe ta̱s yitla gaa gwas ka̱ so, na̱k ɗe maani wo ta̱ mbok ang ten kangwe Nya ni suk nalti gwas wu. Ama modli wo ta̱ mbok ang ten nalti ga̱ maani.<note caller="+" style="f"><char style="fr" closed="false">11:7 </char><char style="ft" closed="false">11:4-7 </char><char style="ft" closed="false">Sogo </char><char style="fv" closed="false">4 </char><char style="fqa" closed="false">Mas ba maani gwe ta̱ ngem Nya sogo dla̱m ilgwe aya pi wu na̱ tlal ma̱dla̱n gaa go ta̱ mbul gaa gwasi. </char><char style="fv" closed="false">5</char><char style="fqa" closed="false">A mas kili gwe ta̱ ngem Nya sogo dla̱m ilgwe aya pi wu a ba̱ta̱ yitla gaa gwas ka̱ so go ta̱ mbul gaa gwasi. Ta̱ kak-kak suk modli jwe asa̱ yil ɗa̱ka̱ tantu jwasa̱n ka̱wu so. </char><char style="fv" closed="false">6 </char><char style="fqa" closed="false">Kume kili mbala̱n yitla gaa gwas sogo, ta̱s ni ɗe kili gwe sa̱ yisti na̱ wutlti gaa wu, ama na̱k ɗe ɗe wul nsha ka̱n ta̱ kili mbala̱n wutl gaa ka̱wu, ta̱s zaki ta̱ ma̱dla̱n gaami te ɗa. </char><char style="fv" closed="false">7</char><char style="fqa" closed="false">Ba maani mbun ɗe ta̱s zak tlal ma̱dla̱n gaa so</char></note> <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />Maani wo tet ten kili mbala̱n ka̱n ta̱ yil so, ama modli wo tet ka̱ ba maani ka̱n ta̱ yili. <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />Sa̱ pa̱l maani a gaa ga̱ modli so, ama sa̱ pa̱l modli a gaa ga̱ maani. <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />Yek laki yek ni ngetli ta̱ kili mbala̱n yitla gaa gwas ka, ta̱s mbok ang ɗe ta̱ ni atl ɗa̱ ba maani, na̱k ɗe Mil Shinti ji Nya na̱ma yenti wu.<verse eid="1CO 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 11:11" />Mas na̱ nu, ka̱ kopti ga̱ Bagaa wo, modli ni kak-kak suk maani so, a ba̱ maani ni kak-kak suk modli so. <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />Na̱k gwe ɗe modli wo tet ten maani ka̱n ta̱ yil wu, nu ka̱n, maani mago modli ka̱ za̱ti. Ama mas wul wo sut mal Nya ka̱n yili. <verse eid="1CO 11:12" /><verse number="13" style="v" sid="1CO 11:13" />Ɓo yeni na̱ gaa gwaka̱n, mbun ɗe ta̱ kili mbala̱n ngem Nya a gaa gwas ni ga̱ ɓuli ka̱ lu motgaa ga̱ ma̱n kopti ya? <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />Ai pa̱lti ga̱ ba maani mboka̱n ang ɗe wul nsha ka̱n ta̱s zak ma̱dla̱n gaa gwasi ta̱ tlali. <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />Ama kume ma̱dla̱n gaa ga̱ kili mbala̱n tlal go nalti ka̱n a malti, na̱k ɗe Nya pa̱lit ma̱dla̱mi ta̱ yitlet gaa ka̱wu. <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />Kume ma̱lgon lam dla̱kti ga̱ɓa ten ga̱ɓa gwisi go, mi wo ma̱ yis ilgon so ban na̱ gwisi sowu, a motgaa ga̱ ma̱n kopti mago nu.<verse eid="1CO 11:16" /></para>
  <para style="s">Da̱lti ka̱n ten ngukti wul ga̱ Bagaa Yesu</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />Ten iljin ɗe ba hwikii go, ba ta̱skii so, na̱k ɗe motgaa gwaka̱n wo hwa motgaa ka̱ sowu. <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />Ten ndat zhile wo a kumi ɗe kume ka̱a̱ mogaa wu, a ba̱ bi gwaka̱n a ni ɗe na̱m so, yek a ɓa kan naa ga̱ɓa jon ɗe gem. <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />Nuk ni, bi gwaka̱n a ni ɗe na̱m so, ta̱ mbala̱n yis ma̱jwe na̱ma kopti Nya na̱ gem wu ɗa. <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />Ka̱a̱ mogaa wugo, ngukti wul ga̱ Bagaa ka̱n aka̱a̱ nguk so. <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />Ka̱a̱ mogaa wi ɗe ka̱a̱ ɓa nguk wul go ko wokko ata̱ nguk gwasi. Kuza̱n na̱ma tlot ga̱ ma̱li gon a ma̱li gon wo ta̱ nguk wi hal ɓa tloti. <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />Lubii nikii ɗa gwe kaa ngukii aka̱a̱ tla a giɓi sa? Ko motgaa ga̱ ma̱n kopti ka̱n kaa mbuli? Ko ma̱jwe ba̱ ilgon nisi ɗa̱ sowu ka̱n ka̱a̱ lami ɗe ta̱ nsha cisi? Yek ka̱a̱ lami ɗe ta hwikii ye, ni wu? Ta ta̱skii ten ilgwe ka̱a̱ na̱ma pa̱lti gwa? Ko njaa, ba ta̱skii so.<verse eid="1CO 11:22" /></para>
  <para style="s">Ndat ngukti wul ga̱ Bagaa</para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23" />Ilgwe a nikii ma hwiti go yek ɗe, ten gas gwe sa̱ ba̱l bi ga̱ Bagaa Yesu wu yek ta̱ kan ba̱redi. <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />Ta̱ pa̱l hwol tuk na̱ Nya wugo, yek ta̱ caali, yek ta̱ wule, &lt;&lt;Ga̱n go dli gi ka̱n, gwe Nya ba̱li ga̱ kisti gwaka̱n wu. ngusi pa̱lti nu, ta̱k daama̱n ninini ɗa.&gt;&gt; <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />Yek ta̱ po pa̱li nu ɗa kaal ɗa̱ ngukti wul ga̱ ka̱ gasisi, yek ta̱ kan mbuke, yek ta̱ wule, &lt;&lt;Mbuka ga̱n go yek ɗe ga̱ pyal dla̱lla̱t ga̱ɓa ga̱ hwulan gini. Dlip ka̱a̱ tla wugo aka̱a̱ ngusi daamti gini.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">11:25 </char><char style="ft" closed="false">Yen </char><char style="xt" closed="false"><ref loc="EXO 24:6-8">Yil 24:6-8</ref>; </char><char style="xt"><ref loc="JER 31:31-34">Irm 31:31-34</ref></char>. </note> <verse eid="1CO 11:25" /><verse number="26" style="v" sid="1CO 11:26" />Dlip kume ka̱a̱ nguk ba̱redisi yek ka̱a̱ tla ka̱ mbuke wu, ka̱a̱ na̱ma ga̱ɓa ten bi ma̱shka̱n ga̱ Bagaa se gas gwe ta pal sut wu.<verse eid="1CO 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 11:27" />Yek laki, mas ma̱lgwe nguk ba̱redisi yek ta̱ tla ka̱ mbuka ga̱ Bagaa ba̱ kangwe mbun ɗe ta̱s pa̱li wu sogo, ta̱ pa̱li byas wul dli ga̱ Bagaa suk hwulan gwas wi. <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />Ta̱ mbala̱n daamti paa apaa ta̱ nguk ba̱redisi ata̱ tla ka̱ mbuke. <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />Mas ma̱lgwe nguk ba̱redisi yek ta̱ tla ka̱ mbuke a ba̱ta̱ yis da̱mti ga̱ dli Bagaa, ngukti suk tlatisi ɗe ta̱ pa̱li go ta̱ nima tulla̱t nolti gaa gwasi. <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />Yek laki yek ba̱ mbala̱n wonti ka̱ kii nda̱l so, a jon wo cwo na̱ma cit gwasa̱n, a jon wo yek sa̱ ma̱shi. <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />Ama kume ma̱ nola̱n gaa ga̱na̱n paa go, Nya a nola̱nni so. <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />A kume Bagaa ka̱ nola̱nni wu, ta nola̱nni ba̱s nola̱nni suk naa mbala̱n ji dii atl so.<verse eid="1CO 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33" />Yek laki yek a nikii ma hwiti ɗe, kume ka̱a̱ mogaa wi ɗe ta̱k nguka̱n ilga̱ nguki ga̱ Bagaa go, ɓa̱ta̱n yilkeni. <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />Ma̱lgwe kuza̱n na̱ma tlot gwas go, ta̱s nguk wul gwas a lubii, ba̱ motgaa gwaka̱n laki a Nya nolkii so.</para>
  <para style="p" vid="1CO 11:34">Naa wul jwe yi kaal go, a tul wugo ba hwikii ilgwe kaa pa̱li wu.<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s">Manti pa̱lti wul gwe a Shishi Ga̱ Nya ma̱n Cilti ba̱li wu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />Yilkeni jini, a lami ɗe ta̱k da̱ma̱n na̱ lashi yisti ten ba̱lti ba̱lti jwe a Shishi ga̱ Nya ba̱li wu so. <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />Ka̱a̱ yisi ɗe, ɗe ba̱ka̱a̱ ɓo ni ɗe ma̱n kopti sogo, sa̱ ngusi gilla̱t gwaka̱n yek ka̱a̱ kop gunki ɗe ba̱sa nwusi sowu. <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />Ten na̱k gwisi ka̱n a lami ɗe ta̱k yisi ɗe, ba ma̱lgwe a man wulti ɗe sa̱ pa̱li bi gaa Yesu tumal Shishi ga̱ Nya wu. Aba̱ ma̱lgon a man wulti ɗe &lt;&lt;Yesu wo Bagaa,&gt;&gt; kan se ma̱lgwe Shishi ga̱ Nya koɓi na̱ti wu.<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />Wul jwe a Shishi ga̱ Nya ba̱li wu wonti ama Shishi ga̱ Nya wo ɗe na̱m ka̱n. <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />Tantu gwe a mbala̱n pa̱li wul Nya wu wonti, ama Nya ɗe na̱m ka̱n asa̱ pa̱lit wuli. <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />Pa̱lti wul ni ɗa wonti, ama Bagaa ka̱ɗe ma̱n lakti a mbala̱n man pa̱lti.<verse eid="1CO 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 12:7" />Nya ba̱l manti pa̱lti wul mas mbala̱n ta̱s mbok ang ɗe Shishi ga̱ Nyami ni ka̱ti, ta̱ ko wokko mbi hwa wul a giɓi. <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />Ma̱li gon wo ta̱ ba̱lti manti ga̱ɓa kangwe ta ga̱ɓa na̱ ɓotlka̱n yisti wul tumal Shishi ga̱ Nya wu. Ma̱li gon wo yek ta̱ mbi manti ga̱ɓa gwe yisti ni giɓi nal wu tumal Shishi ga̱ Nya. <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />Gon wo yek ta̱ ba̱lti nda̱lti nga̱sti ten Nya ba̱na̱ ɓanti so tumal Shishi ga̱ Nyami. A gon wo yek ta̱ ba̱lti manti ndokti mbala̱n tumal Shishi ga̱ Nyami. <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />Ma̱li gon wo yek ta̱ ba̱lti manti pa̱lti ilgwe a ci ɓanti mbala̱n wu, gon wo yek ta̱ ba̱lti manti dla̱mti ilgwe Nya hwit ɗe ta̱s dla̱m wu. Ma̱li gon wo yek ta̱ ba̱lti yisti kangwe ta hul dlo ga̱ Shishi ga̱ Nya suk gwe ba̱ shishi ga̱ Nya ka̱ sowu. Gon wo yek ta̱ ba̱lti manti ga̱ɓa na̱ bi wonti,<note caller="+" style="f"><char style="fr" closed="false">12:10 </char><char style="ft" closed="false">Sogo</char><char style="fqa" closed="false">bi jwe ba̱ gwas ka̱ sowu</char><char style="ft" closed="false">, nuk ni ka̱ ndati ɗe 28 pak</char></note> gon wo yek ta̱ ba̱lti manti balla̱t ga̱ɓa gwe sa̱ dla̱mti na̱ zobsi bi wu.<note caller="+" style="f"><char style="fr" closed="false">12:10 </char><char style="ft" closed="false">Sogo</char><char style="fqa" closed="false">bi jwe ba̱ gwas ka̱ sowu</char><char style="ft" closed="false">, nuk ni ka̱ ndati ɗe 28 pak</char></note> <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />Mas jwisi wo Shishi ga̱ Nyami ka̱ɗe ma̱n ba̱lti na̱ ngusi. Ata̱ ba̱l ko wokko kangwe ta̱ lami wu.<verse eid="1CO 12:11" /></para>
  <para style="s">Dli ɗena̱m na̱ ka̱ti wonti</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />Na̱k gwe dli ga̱ mbala̱n wo ɗena̱m ka̱wu. Ko ɗe ka̱t dlisi wonti wu ama dlisi wo ɗena̱m ka̱n ni. Nu ka̱n dli ga̱ Almasihu ni pak. <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />Mas jina̱n sa̱ pa̱lini baptisma tumal<note caller="+" style="f"><char style="fr" closed="false">12:13 </char><char style="ft" closed="false">Sogo</char><char style="fqa" closed="false">na̱</char><char style="ft" closed="false">, sogo </char><char style="fqa" closed="false">ka̱ </char></note> Shishi ga̱ Nya ɗena̱m ka̱ dli ɗena̱m, na̱ ma̱n Yehuda, na̱ ma̱jwe ba̱ ma̱n Yehuda ka̱ sowu, na̱ zhel, na̱ ma̱jwe ba̱ zhel ka̱ sowu, yek mas jina̱n ma̱ tla ka̱ Shishi ɗe na̱m.<verse eid="1CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14" />Dli ga̱ mbala̱n wo ka̱ti wonti ka̱ mo, ka̱ti ɗena̱m ka̱ so. <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />Kume asa̱n wule, &lt;&lt;Ami wo ang ka̱ so, ka̱t dlisi ka̱ɗe ami so.&gt;&gt; A laki a ba̱ asa̱n ani ɗe ka̱t dlisi sa? <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />A Kume ka̱ng wule, &lt;&lt;Na̱k ɗe ami wo gwel ka̱ sowu, ka̱t dlisi ka̱ɗe ami so.&gt;&gt; A laki a ba̱ ka̱ng ani ɗe ka̱t dlisi sa? <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />Kume mas dli wo gwel kani go, ɗa̱ nii ka̱n ma̱li a kum ga̱ɓa gwi? A kume mas dlisi wo ka̱ng ka̱ go, ɗa̱ nii ka̱n ma̱li a kum wusa̱n gwi? <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />Ama yek Nya zi ka̱t dlisi ko gwik-gwi ka̱ lu gwe ta̱ lami wu. <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />Kume ka̱ti ɗena̱m ka̱ go, dlisi na̱n ko? <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />Na̱k kangwe ni wu, ka̱t dlisi wo wonti ka̱n ama dlisi wo ɗena̱m ka̱n ni.<verse eid="1CO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21" />Gwel a wul ang ɗe, &lt;&lt;Yek ba pa̱li na̱ki ye so!&gt;&gt; A ba̱ asa̱n a wul gaa ɗe, &lt;&lt;Yek ba pa̱li na̱ki ye so!&gt;&gt; <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />Nuk ni so, ka̱t dli gwe ma̱ yeni ɗe ni ten bi ilgon sowu, ni hwaɓi i'e mal dlisi. <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />Ka̱t dli gwe ma̱ yeni ɗe nal sowu, yek ka̱n ama̱ ngala̱mi ni. A ka̱t dli gwe mbun ɗe ta̱n yilli deɓa̱l sogo, yek ka̱n a ma̱ hwuda̱li ka. <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />Ama ka̱t dli gwe ta̱n yeni go ba̱ ɗe se ma̱ pa̱lisi ilgon so. Nya pa̱li na̱k gwisi yek ta̱ palli ka̱t dlisi jwe ta̱n yeni sowu, ɗe ma̱n nalti, <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />ba̱ la̱shi motgaa ni ka̱ dlisi so ɗa, se ko ta̱ ka̱t dlisi zi-ang yilkeni. <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />Kume ka̱t dli ɗena̱m kum cwo wu, a mas dlisi kum ciciti. A kume sa̱ ta̱s ɗena̱m wu, a mas dlisi pa̱l hwol tuki.<verse eid="1CO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27" />Kii wo dli ga̱ Almasihu ka̱n, a ko wokko ka̱t dlisi gon gwas ka̱n. <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" />Ka̱ lu motgaa ga̱ ma̱n kopti wo, yek Nya botl mil shinti jwasi. Na lop wo yek ta̱ botl jon ɗe ma̱n dla̱mti ga̱ɓa ga̱ Nya. Na mekan wo yek ta̱ botl jon ɗe ma̱n mbokti ang ten ga̱ɓa ga̱ Nya. Jon wo ta̱s pa̱l wul cit ɓanti. Jon wo ta̱s ndok mbala̱n. Jon wo ta̱s zi-ang mbala̱n. Jon wo ta̱s da̱n ɗe bacina. Jon wo ta̱s man ga̱ɓa na̱ zobsi bi kak-kak. <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />Mas jwasa̱n ka̱ɗe mil shinti ji botli ya? Ko mas ka̱ɗe mil shinti dla̱mti ga̱ɓa ga̱ Nya? Mas ka̱ɗe ma̱n mbokti ang ten ga̱ɓa ga̱ Nya ma? Mas ka̱ɗe ma̱n pa̱lti wul cit ɓanti ya? <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />Mas jwasa̱n ka̱ɗe man ndokti mbala̱n ma? mas jwasa̱n ka̱ man ga̱ɓa na̱ zobsi bi ya?<note caller="+" style="f"><char style="fr" closed="false">12:30 </char><char style="ft" closed="false">Sogo</char><char style="fqa" closed="false">bi jwe ba̱ gwaka̱n ka̱ sowu nwa </char></note> Mas jwasa̱n ka̱ man bala̱t zobsi bi ga̱ɓe ya? <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />Lama̱n ba̱lti wul jwe nal mani wu.<note caller="+" style="f"><char style="fr" closed="false">12:31 </char><char style="ft" closed="false">Sogo</char><char style="fqa" closed="false">Ama ta̱k lama̱n ba̱lti nal mani i'e </char></note></para>
  <para style="p" vid="1CO 12:31">Ba tuli a mbokikii ang ten tantu gwe mani wu mas.<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s">Lamti ka̱ɗe bali</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />Kume a man ga̱ɓa na̱ bi ga̱ mbala̱n mas<note caller="+" style="f"><char style="fr" closed="false">13:1 </char><char style="ft" closed="false">Sogo </char><char style="fqa" closed="false">manti ga̱ɓa na̱ wonti bi </char></note> suk na̱ bi ga̱ mil shinti ji Nya, ama yek ba̱ a lam mbala̱n sogo, na̱k ma̱n ɓot kwelalan sogo ɓot ga̱lla ma̱n tot nya ka̱n ani. <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" />Kume a man dla̱mti ilgwe Nya hwi ɗe ta dla̱m wu, a kume a yis mas ilgwe ni ga̱ hwuda̱li suk wul mas wu, a kume nga̱sti gi ten Nya a man ɗamba̱lti tla̱da̱l ama yek baa lam mbala̱n sogo, ani ten bi ilgon so. <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />Kume a ba̱l mas ilgwe ni ɗa̱ wu ma̱jwe ba̱ ilgon nisi ɗa̱ sowu, yek a ba̱l dli gini ta̱s kweli ka,<note caller="+" style="f"><char style="fr" closed="false">13:3 </char><char style="ft" closed="false">Ka̱ lishti jon tek wo </char><char style="fqa" closed="false">ta̱ dli gi mbutl ka </char></note> ama baa lam mbala̱n sowu, ba mbi ilgon so.<verse eid="1CO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4" />Lamti wo dlot mbadl ka̱n, lamti pa̱l hwa wul. Lamti pa̱l duu tuk na̱ mbit wul ga̱ ma̱lgon so, a ba̱ a lak mbala̱n ata̱ ɓo getl ɗe ta̱ mbuki wi so. Lamti lak nalti gaa sogo lamti gaa so. <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />Lamti lak tlilti gaa so a ba̱ta̱ lak lamti gaa so. Ba̱ta lil mbadl ba̱le so. Lamti wo ata̱ dlo mbadl hal pakti da̱nti <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />Lamti kum ta̱mti ten yokit so ama ata̱ kum ta̱mti kume gem pi wu. <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />Lamti dlo mbadl ka̱ mas da̱nti. Lamti nga̱s ten Nya ka̱ mas wul. Lamti zi mbadl ten Nya ka̱ mas wul. Aba̱ za̱t mbadl gwas a paki so, ata̱ yisi ɗe nda̱lti gwas wo ten Nya ka̱n ni, ata̱ dlo mbadl na̱ mas ilgwe pi wu.<verse eid="1CO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8" />Lamti a paki so. Ama dla̱mti ga̱ɓa ga̱ Nya tumal mil shinti jwas a paki. Ga̱ɓa na̱ zobsi bi a paki. Yisti wul mago a paki. <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />Yisti wul ga̱ mbala̱n wo njika̱n so, ga̱ɓa ga̱ Nya ɗe a mbala̱n dla̱m go njika̱n so. <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />Ama ilgwe njika̱n wu tul wu, gwe njika̱n sowu a gilka. <verse eid="1CO 13:10" /><verse number="11" style="v" sid="1CO 13:11" />Ɗe a yi ɗe yen mbala̱n go, ga̱ɓa gi wo ga̱ yen mbala̱n ka̱n, a daamti gi wo ga̱ yen mbala̱n ka̱n, pa̱lti wul gi mago ga̱ yen mbala̱n ka̱n. Ama yek a nal wugo, yek a lak pa̱t mil mbala̱n ka. <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />Ningo yenti lu ga̱na̱n wo shish-shiti ka̱n na̱k ma̱n yenti lu ka̱ boka, ama ten gasisi ka̱n ma yen gwel suk gwel. Ilgwe a yisi ningo njika̱n so, ama ten gasi wo ba yis wul mas kangwe Nya yisa̱n wu.<verse eid="1CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13" />Ningo wul ɗe mekan ni ɗa jwe sa wu. Sik ɗe, nga̱sti ten Nya, suk za̱t mbadli suk Lamti. Ama gwe nal mani mas go yek ɗe lamti.<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s">Ga̱ɓa na̱ zobsi bi suk dla̱mti ga̱ɓa ga̱ Nya</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />Koɓa̱n tantu lamti aka̱a̱ ngo ilgwe a Shishi ga̱ Nya ba̱li wu i'e, tun na̱k ba̱ dla̱mti ga̱ɓa ga̱ Nya so. <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />Ma̱lgwe ga̱ɓa na̱ zobsi bi<note caller="+" style="f"><char style="fr" closed="false">14:2 </char><char style="ft" closed="false">Sogo</char><char style="fqa" closed="false">bi jwe ba̱ gwaka̱n ka̱ sowu</char><char style="ft" closed="false">, nuk ni ka̱ ndati ɗe 4, 13, 14, 19, 26 suk 27</char></note> go, mbala̱n ka̱n ta̱ nisi ma ga̱ɓa so, Nya ka̱n. na̱k ɗe ma̱lgon yis ilgwe ta̱ na̱ma dla̱mti wu sowu. Wul jwe ni ga̱ hwuda̱li wu ka̱n ta̱ na̱ma dla̱mti na̱k gwe Shishi ga̱ Nya koɓi na̱ ti wu<note caller="+" style="f"><char style="fr" closed="false">14:2 </char><char style="ft" closed="false">Sogo</char><char style="fqa" closed="false">Tumal Shishi ga̱ Nya </char></note> <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />Ama ma̱lgwe dla̱m ga̱ɓa ga̱ Nya go, mbala̱n ka̱n ta̱ nisi ma ga̱ɓa ta̱s zisi ang ata̱ mullisi mbadli ata̱ nda̱llisi daala. <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />Ma̱lgwe ga̱ɓa na̱ zobsi bi go gaa gwas ka̱n ta̱ na̱ma kinti. Ama ma̱lgwe dla̱m ga̱ɓa ga̱ Nya go ta̱ na̱ma kinti ga̱ mas ma̱n kopti jwe mogaa wu. <verse eid="1CO 14:4" /><verse number="5" style="v" sid="1CO 14:5" />A lami ɗe ta̱ mas jwaka̱n ga̱ɓa na̱ zobsi bi,<note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="ft" closed="false">Sogo</char><char style="fqa" closed="false">bi jwe ba̱ gwaka̱n ka̱ sowu</char><char style="ft" closed="false">, nuk ni ka̱ ndati ɗe 6, 18, 14, 22, 23 suk 39</char></note> ama a lami ɗe ta̱k dla̱ma̱n ga̱ɓa ga̱ Nya mani. Ma̱lgwe dla̱m ga̱ɓa ga̱ Nya wu, ta̱ man ma̱n ga̱ɓa na̱ zobsi bi. seko kume ma̱n ga̱ɓa na̱ zobsi bisi a balli wu, ta̱ kin motgaa ga̱ ma̱n kopti.<verse eid="1CO 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 14:6" />Yilkeni jini, kume a tul malkii yek a hwikii ga̱ɓa na̱ zobsi bi go, yek ka mbi tena̱n ye? Ama kume a hwikii ilgwe Nya ɓuli gwel yek a yeni wu, sogo yisti wul sogo dla̱mti ga̱ɓa ga̱ Nya, yek a mbokikii ang ten ga̱ɓa ga̱ Nya go a mani kii. <verse eid="1CO 14:6" /><verse number="7" style="v" sid="1CO 14:7" />Ko ta̱ ilgwe ba̱ mbadl nisi ɗa̱ sowu na̱k mba̱zhel suk molo, kume yal gwasa̱n yil i'e sogo ɗa̱ nii ka̱n mbala̱n a kumi gwi. <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />A kume ba̱sa̱ hot sheta̱l kangwe asa̱ hot wu sogo, ɗa̱ nii ka̱n mbala̱n a yili dlanti gwi? <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />Nu ka̱n kume ka̱a̱ hwi ga̱ɓa mbala̱n na̱ bi gwe ba̱sa̱ yisi sogo, sa yisa̱n ilgwe ka̱a̱ dla̱m wu ɗa̱ nii? Ga̱ɓa gwe ka̱ dla̱m wu a kop yeta̱l. <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />Bi ga̱ɓa ni ɗa wonti ten dii atli, a ko gwik-gwi na̱ gaa gwasi. <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />Kume a man bi ga̱ mbala̱n sogo ɗe ma̱nda̱ki ka̱n ani mal ma̱li a ma̱li mago ɗe ma̱nda̱ki ka̱n ta nini. <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />Na̱k ɗe ka̱ lam manti pa̱lti wul gwe a Shishi ga̱ Nya ba̱li i'e wu, ngo gwe a kin ma̱n kopti wu.<verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />Yek laki ningo mas ma̱n ga̱ɓa na̱ zobsi bi wo, ta̱s ngem Nya ta̱s ba̱lti manti balla̱t ga̱ɓe. <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />Kume a ga̱ɓa suk Nya na̱ zobsi bi wu, Shishi ga̱ Nya ka̱ɗe ma̱n ga̱ɓa suk Nya, a yis ilgwe a dla̱m wu so. <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />Yek ba pa̱li ye ni wu? Ba ga̱ɓa suk Nya ka̱ shishi gini. Ba wul koo ta̱s ga̱ Nya ka̱ daamti gini. Ba wul koo ka̱ daamti gini. <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />Kume ka̱ gode Nya na̱ shishi gwa na̱ ngwe go, ɗa̱ nii ka̱n ma̱lgwe ba̱ta̱ yis ilgwe ka̱ na̱ma dla̱mti sowu a wule amin, na̱k ɗe ta̱ yis ilgwe ka̱ na̱ma dla̱mti sowu gwi? <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />Ka̱ na̱ma pit godiya Nya i'e, ama ma̱l go ka̱ mba̱lti na̱ ilgon so.<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />A pa̱l hwol tuk na̱ Nya na̱k ɗe a man ga̱ɓa na̱ zobsi bi man kii mas wu. <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />Ama ka̱ lu motgaa ga̱ ma̱n kopti wo, ta dla̱mti ga̱ɓa ɗe namtan gwe mbala̱n a yis gaami wu manii ga̱ɓa na̱ zobsi bi zangu ɗe kutl.<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />Yilkeni jini ma̱n kopti, daama̱nkii na̱k mil mbala̱n so. Ten yokit wo, aka̱a̱ da̱m na̱k mil la̱li, ama ta̱ daamti gwaka̱n ni na̱k kiɗi mbala̱n. <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />Na̱k gwe ni ga̱ lishi ka̱ ga̱ɓa ga̱ Nya wu ɗe,</para>
  <para style="q1" vid="1CO 14:21">&lt;&lt;Ba ga̱ɓe mbala̱n jin na̱ pyal bi</para>
  <para style="q2" vid="1CO 14:21">suk ma̱nda̱ki bi.</para>
  <para style="q1" vid="1CO 14:21">Ko na̱ nu, sa kati ka̱n ga̱ɓa gi so,&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">14:21 </char><char style="ft" closed="false">Yen </char><char style="xt"><ref loc="ISA 28:11">Ish 28:11</ref>,<ref loc="ISA 28:12">12</ref></char>. </note></para>
  <para style="q2" vid="1CO 14:21">Bagaa ka̱ dla̱m nu.<verse eid="1CO 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22" />Ga̱ɓa na̱ zobsi bi wo ga̱ ma̱n kopti ka̱ so ama ta̱ ma̱jwe ba̱ ma̱n kopti ka̱ sowu yeni asa̱ kaami. Ama dla̱mti ga̱ɓa ga̱ Nya wo a gaa ga̱ ma̱n kopti ka̱n asa̱ pa̱li, a gaa ga̱ ma̱jwe ba̱ ma̱n kopti ka̱ sowu ka̱ so. <verse eid="1CO 14:22" /><verse number="23" style="v" sid="1CO 14:23" />Kume ma̱n kopti mogaa mas wu yek ko wokko na̱ma ga̱ɓa na̱ zobsi bi, yek ma̱jwe ba̱sa̱ yis ilgwe ka̱a̱ na̱ma pa̱lti sowu,<note caller="+" style="f"><char style="fr" closed="false">14:23 </char><char style="ft" closed="false">Sogo</char><char style="fqa" closed="false">jon ngusi kumti ga̱zi </char></note> sogo ma̱jwe ba̱ ma̱n kopti ka̱ sowu tul ka̱li go, sa wule booli ka̱ kankii sa? <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />Ama kume ka̱a̱ na̱ma dla̱mti ga̱ɓa ga̱ Nya mas jwaka̱n ka̱n yek ma̱lgwe ba̱ ma̱n kopti ka̱ sowu sogo ma̱lgwe ba̱ta̱ yis ilgwe na̱ma pa̱t wu sowu te tet go ai ga̱ɓe a ta̱na̱n mbadl gwasi ata̱ ci atl gaa. <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />Na̱k ɗe ilgwe ni ga̱ hwuda̱li ka̱ mbadl gwas wu yil deɓa̱l wu, ta ngus a cina ɗa̱ Nya ka ata̱ wule gem Nya ni ka̱ kii.<verse eid="1CO 14:25" /></para>
  <para style="s">Kangwe mbun ɗe ta̱ mbala̱n ngusi Nya atl wu</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />Nikma pa̱li gwi yilkeni jini? Kume ka̱ mogaa wu, ta gon na̱ma wulti koo ta̱s ga̱ Nya, a gon nima mbokti ang wul mbala̱n, a gon na̱ma dla̱mti ilgwe Nya ɓulit gwel yek ta̱ yeni wu, a gon na̱ma ga̱ɓa na̱ zobsi bi, a gon na̱ma balla̱t zobsi bisi. Mas ilgwe kaa pa̱li go, pa̱lini kangwe ka nda̱lli daala yilkeni ma̱n kopti wu. <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />Kume ma̱lgon a ga̱ɓa na̱ zobsi bi wu, mbun ɗe ta̱ mbala̱n ɗe lop sogo ɗe mekan ga̱ɓa na̱ zobsi bi. Ga̱n paki wu, a ga̱n po ga̱ɓa ne, a ma̱lgon na̱ma balla̱t ilgwe sa̱ dla̱m wu. <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />Kume ma̱n balla̱ti ni ɗa̱ sogo, ta̱ ma̱n ga̱ɓa na̱ zobsi bi da̱n mbetlak ka̱ motgaa ga̱ ma̱n kopti, ta̱s dla̱mi gaa gwasa̱n suk Nya.<verse eid="1CO 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 14:29" />Ta̱ mbala̱n ɗe lop sogo ɗe mekan dla̱m ga̱ɓa ga̱ Nya, a naami bodla̱l ilgwe sa dla̱m wu. <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />Kume ma̱lgon na̱ma dla̱mti ga̱ɓa ga̱ Nya, yek Nya hwi ilgon ma̱li gon gwe ni na̱ zhila wu, ta̱ ma̱lgwe na̱ma ga̱ɓa wu zak ga̱ɓa. <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />Na̱ nu ka̱n mas jwaka̱n na̱m na̱m ka dla̱m ga̱ɓa ga̱ Nya ta̱ mas mbala̱n mbi yisti a nda̱lla̱si gahwula̱n. <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />Shishi dla̱mti ga̱ɓa ga̱ Nya ni ang ɗa̱ mil shinti dla̱mti ga̱ɓa ga̱ Nya. <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />Nya ga̱na̱n wo ga̱ gulsa̱t lu ka̱ so, ama ma̱n mulla̱t mbadl ka̱n,</para>
  <para style="p" vid="1CO 14:33">Na̱k gwe asa̱ pa̱li ka̱ lu motgaa ga̱ ma̱n kopti wu. <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />Modli wo ta̱s da̱n mbetlak ka̱ motgaa ga̱ ma̱n kopti, sa̱ ba̱lsi bi ga̱ɓa so. Ta̱s kop ilgwe ni wu na̱k gwe mba̱t ga̱ɓa ga̱ Musa dla̱m wu. <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />Kume sa̱ lam kumti ga̱s ilgon go, ta̱s ngem maani jwasa̱n a lubii, wul nsha ka̱n ta̱ modli ga̱ɓa ka̱ lu motgaa ga̱ ma̱n kopti.<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />Yenti gwaka̱n go ga̱ɓa Nya wo tet ka̱ kii ka̱n yilla? Ko kii na̱ ngweka̱n ka̱n sa̱ ndekii hwit ga̱ɓa ga̱ Nya? <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />Kume ma̱lgon kan ɗe ti wo ma̱n dla̱mti ga̱ɓa ga̱ Nya ka̱ɗe ti wu, sogo Shishi ga̱ Nya ba̱lti manti ta̱s yisi ɗe ilgwe a na̱ma lishti go Bagaa ka̱ hwini. <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />Mas ma̱lgwe kan ɗe ilgwe a na̱ma dla̱mti go ni ten bi ilgon sowu, ti mago ba̱k kama̱nti ɗe ilgon so.<note caller="+" style="f"><char style="fr" closed="false">14:38 </char><char style="ft" closed="false">Lishti jon wo </char><char style="fqa" closed="false">ma̱lgwe yis gaami sogo ba̱s yis gaami so la </char></note><verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />Yilkeni jini, dloka̱ma̱nkii ta̱k dla̱ma̱n ga̱ɓa ga̱ Nya i'e, ama ba̱k hana ga̱ɓa na̱ zobsi bi so. <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />Mas ilgwe kaa pa̱li wu, pa̱lini kangwe mbun ɗe ta̱k pa̱li wu.<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s">Palti ga̱ Almasihu kaami</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />Yilkeni jini, ha̱nta daamikii ga̱ɓa ma̱n ta̱mti gwe a hwikii wu, gwe ɗe ka̱a̱ kan ka̱ mbadl gwaka̱n yek ka̱a̱ ngiɓi wu. <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />Ga̱ɓa ma̱n ta̱mti ɗe a hwikii go yek laki yek ka̱a̱ mbi kisti ɗe kume ga̱ɓa gwe a hwikii wu dla̱l ka̱ mbadl gwaka̱n wu. a kume ga̱ɓe dla̱l sowu za̱t mbadl gwaka̱n ten Almasihu wo ten koo lu ka̱n ni.<verse eid="1CO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3" />Ilgwe Nya ba̱la̱n go yek ka̱n a ba̱lkii gwe mbun man mas wul wu, ɗe Almasihu ma̱shi na̱k gwe ni ga̱ lishi ka̱ ga̱ɓa ga̱ Nya wu. <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" />Yek sa̱ lepti, yek Nya palla̱t kaami na̱k gwe ga̱ɓa ga̱ Nyami dla̱m wu. <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" />Yek ta̱ tuli Biturus,<note caller="+" style="f"><char style="fr" closed="false">15:5 </char><char style="ft" closed="false">Na̱ bi Giris wo </char><char style="fqa" closed="false">Kepas</char></note> yek ta̱ po tuli mil shinti ji botlisi ɗe kutl cet lop ju. <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />Yek ta̱ tuli ma̱n kopti jwas jwe wonti man zamba̱l ɗe namtan ju, jwe jon jwasa̱n yi kaami wu, ko ɗe jon wo sa̱ ma̱sh wu. <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />Yek ta̱ po tuli Yakubu pak. Kaal ɗa̱ nugo yek ta̱ tuli mas mil shinti jwas ji botli. <verse eid="1CO 15:7" /><verse number="8" style="v" sid="1CO 15:8" />Yek ta̱ ɓa kul bisi go yek ta̱ tulini ami ɗe baa ni ten bi ilgon sowu.<verse eid="1CO 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 15:9" />Amik ɗe nak'eni ga̱ mil shinti ji Almasihu mas, mbun ɗe ta̱s mbe ɗe yen shinti ga̱ Almasihu so pamma na̱k gwe tet go a ci dletlnapcan motgaa ga̱ ma̱n kopti i'e wu. <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />Ama na̱k ɗe Nya yen gonti gi wu, yek ta̱ palla̱n na̱k ga̱n ɗe ani wu. A yenti gonti gwas wo ba̱ ni ten koo lu so. Ilgwe a pa̱li wu man ji naa mil shinti ji botli mas. Ko ɗe manti gi ka̱ so ama yenti gonti ga̱ Nya ka̱ laki yek a mani wu. <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />Na̱ ga̱ɓa gwe a dla̱m ten Almasihu wu, na̱ gwe sa̱ dla̱m wu mas ɗe na̱m ka̱n, a dani ka̱n ka̱a̱ zi mbadli.<verse eid="1CO 15:11" /></para>
  <para style="s">Ma̱jwe ma̱sh wu a pal kaami</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />Na̱k ɗe ma̱ na̱ma lakti icin ten bi palti kaami ga̱ Yesu go, yek laki yek jon jwaka̱n na̱ma wulti ɗe ma̱jwe ma̱sh wu a pal kaami so ye? <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />Kume ma̱jwe ma̱sh wu a pal kaami sowu, Yesu mago ta̱ pal kaami so. <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />A kume Yesu pal kaami sowu, ga̱ɓa ga̱ Nya gwe ma̱ hwikii go ni ten bi ilgon so, a za̱t mbadl gwaka̱n mago nu. <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />Ama cina ɗa̱ na̱k gwisi, a na̱k wule, ma̱ na̱ma kopti kaal ga̱ lal ten Nya, na̱k ɗe ma̱ wule ta̱ tlil Yesu tet ɗa̱ka̱ ma̱shka̱n ka̱wu. Kume Almasihu tli tet ɗa̱ka̱ ma̱shka̱n ka̱ sowu, ma̱jwe ma̱sh go gem ka̱n sa tli tet ɗa̱ka̱ ma̱shka̱n so. <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />A kume ma̱jwe ma̱sh wu a tli tet ɗa̱ka̱ ma̱shka̱n ka̱ sowu, Yesu mago ta̱ tli so. <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />Kume sa̱ tlil Yesu tet ka̱ ma̱shka̱n sowu, nga̱sti gwaka̱n ten Yesu wo ten koo lu ka̱n ni. A hal ninge ka̱ yi ka̱ pa̱lti byas wul gwaka̱n. <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />Ten na̱k gwisi ka̱n ma̱n kopti jwe sa̱ ma̱sh wu gil ka̱wi miti-miti. <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />Kume za̱t mbadl ga̱na̱n ten Yesu wo tokte ten da̱nti ga̱n ka̱wu, ma da̱ma̱n ɗe wul cit gonti man mas naa mbala̱n.<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />Ama gem ka̱n, sa̱ tlil Yesu ɗa̱ka̱ ma̱shka̱n ka, Gwisi ka̱ mbok ang ɗe sa tlil ma̱jwe ma̱shka̱n wu ɗa̱ka̱ ma̱shka̱n ka. <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />Na̱k ɗe ma̱shka̱n tul tumal mbala̱n wu, nu ka̱n mbala̱n a tli ɗa̱ka̱ ma̱shka̱n ka tumal mbala̱n. <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />Na̱k gwe mas mbala̱n ma̱sh tumal ilgwe Adamu pa̱li wu, nu ka̱n mas mbala̱n a tli ɗa̱ka̱ ma̱shka̱n ka tumal ilgwe Almasihu pa̱li wu. <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />Ama tlit ɗa̱ka̱ ma̱shka̱mi wo jon a tli apaa jon po tli. Almasihu ka̱ tli cina, apaa ma̱jwe ni ɗe jwas ju tli gas gwe ta pal sut ɗu. <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />Ka̱ sa'isi ka̱n paktisi a tuli, sa'i gwisi ka̱n ta palli guumi a ang ɗa̱ Nya Buka ka. Ɗe ta̱ taas mas Yeta̱l jwe ɗe sik ɗe guu ju ka̱ wu, suk kiɗi bacina suk ma̱n iko. <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />Ngetli ka̱n ta̱ Almasihu da̱n ɗe guu, se Nya palli mas ma̱n nget gwas a atl ɗa̱ asa̱n gwas ka.<note caller="+" style="f"><char style="fr" closed="false">15:25 </char><char style="ft" closed="false">Yeni </char><char style="xt"><ref loc="PSA 110:1">Zab 110:1</ref></char>. </note> <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />Ma̱n nget gwas gwe ta tlot ka ka̱ kaali go tik ɗe ma̱shka̱n. <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />Na̱k gwe ga̱ɓa ga̱ Nya dla̱m wu ɗe, &lt;&lt;Nya zi mas wul a atl ɗatka.&gt;&gt; Sa̱ dla̱m nugo &lt;&lt;mas&gt;&gt; ba̱ ɗe we Nya na̱ gaa gwas ɗe ta̱ ba̱lti nda̱lti ten mas wul go ta̱ ni atl ɗatka̱ so.<note caller="+" style="f"><char style="fr" closed="false">15:27 </char><char style="ft" closed="false">Yen </char><char style="xt"><ref loc="PSA 8:6">Zab 8:6</ref></char>. </note> <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />Ka̱ sa'i gwe Nya palli mas wul ten ang ga̱ Yen gwas wu, Yeni wo ta da̱n ten ang Nya, ma̱lgwe palli mas wul ten ang gwas wu ta̱ Nyami da̱n ɗe mas wul.<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />Kume ma̱jwe ma̱sh wu a tli ɗa̱ka̱ ma̱shka̱n ka̱ sowu, ma̱jwe sa̱ pa̱lisi baptisma ka̱ lal ga̱ ma̱jwe ma̱sh wu hwa? A kume ma̱jwe ma̱sh wu sa po tli ɗa̱ka̱ ma̱shka̱n ka̱ sowu, yek laki yek sa̱ pa̱li baptisma mbala̱n ka̱ lal gwasa̱n ye? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />Ama mi wo yek laki yek ma̱ na̱ma telti gaa ga̱na̱n ka̱ bomti mas cin ye? <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />Ani ten bi ma̱shka̱n mas cin. Gem ka̱n yilkeni jini, na̱k gwe a na̱ma ɓot ngetl na̱kii ka̱ Almasihu Yesu Bagaa wu. <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />Kume a dlana̱nni suk wul me ka̱ ba̱n Apisa na̱ za̱t mbadl ga̱ mbala̱n go, yek ba mbi duk ye? Kume ma̱jwe ma̱sh wu a tli ɗa̱ka̱ ma̱shka̱n ka̱ sogo,</para>
  <para style="q1" vid="1CO 15:32">&lt;&lt;Ma̱ nguka̱n wul a ma̱ tlani</para>
  <para style="q2" vid="1CO 15:32">na̱k ɗe ayo go ma ma̱sha̱n wu.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:32 </char><char style="ft" closed="false">Yen </char><char style="xt"><ref loc="ISA 22:13">Ish 22:13</ref></char>. </note><verse eid="1CO 15:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="1CO 15:33" />Ba̱ ma̱lgon shelkii so, da̱nti suk byas mbala̱n a laki a mbala̱n lil ka. <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />Daama̱nkii hwaɓi ta̱k zaka̱n pa̱lti byas wul, na̱k ɗe jon jwaka̱n wo sa̱ yis Nya sowu, a dla̱m nu ta̱ nsha cikii.<verse eid="1CO 15:34" /></para>
  <para style="s">Dli gwe ma tli ɗa̱ka̱ ma̱shka̱n ka na̱ nali wu</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />Gon a mbala̱n kum ga̱zi ɗe, ni ka̱n ma̱jwe ma̱sh wu a tli ɗa̱ka̱ ma̱shka̱n gwi? Wunda̱l dli gwik sa tli na̱ nali gwi? <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />Ka̱dla̱n! Mas ilgwe mbala̱n ɓak go se ma̱shi a paa nda teti. <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />Kume ka̱ ɓak alkama sogo zobsi ilgon go, ilgwe ka̱ ɓak wu ka te so, kume ka̱ ɓak gwe alkama sogo zobsi ilgon wu, a te ɗe zobsi ilgon. <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />Ama a Nya ba̱l dli mas ilgwe ma̱ ɓaka̱n na̱k gwe ta̱ lami wu. Mas wunda̱l wo a Nya ba̱lti dli gwasi. <verse eid="1CO 15:38" /><verse number="39" style="v" sid="1CO 15:39" />Nu ka̱n dli wo gaa ɗe na̱m ka̱n ni mas so, dli ga̱ mbala̱n ni ɗa, a dabba ni ɗa, a ga̱ yadl ni ɗa̱, a ga̱ kwes ni ɗa. <verse eid="1CO 15:39" /><verse number="40" style="v" sid="1CO 15:40" />Ka̱ wul jwe Nya pa̱li go, ga̱ dlo nya ni ɗa, a ga̱ ten dii atli ni ɗa. Ama nalti ga̱ gwe ni dlo nya wu ni kak-kak, a nalti ga̱ gwe ni ten dii atl wu ni kak-kak. <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />Nalti ga̱ cin ni ɗa, a ga̱ lip ni ɗa, a ga̱ kyatla̱l ni ɗa. Kyatla̱l mago kak-kak ka̱n sa̱ni.<verse eid="1CO 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42" />Nu ka̱n tlit ɗa̱ka̱ ma̱shka̱n ga̱ ma̱jwe ma̱sh wu ani. Sa lep dli ga̱na̱n ma̱n mokit ga̱n ka, ama a lak tli, a ilgwe sa̱ tlili go a po ma̱sh so. <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />Asa̱ lep dlisi ka̱ la̱shi nalti ama asa̱ tlili na̱ nalti. Asa̱ ɓak dlisi ka̱ la̱shi nalti, asa̱ tlili ka̱ nalti. <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />Sa̱ lepti ɗe dli ga̱ mbala̱n, ama asa̱ tlili ɗe dli ga̱ Shishi.</para>
  <para style="p" vid="1CO 15:44">Dli ga̱ mbala̱n ni ɗa, a dli gwe a Shishi ga̱ Nya ba̱li wu ni ɗa. Na̱k ɗe dli ga̱ mbala̱n ni ɗa wu, nu ka̱n dli ga̱ Shishi mago ni ɗa <verse eid="1CO 15:44" /><verse number="45" style="v" sid="1CO 15:45" />Na̱k gwe ni ga̱ lishi ka̱ ga̱ɓa ga̱ Nya wu, &lt;&lt;Adamu mbala̱n ga̱ cina wo ma̱n rai ka̱n, ama Adamu ga̱ kaali go Shishi ma̱n ba̱lti rai ka̱n.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:45 </char><char style="ft" closed="false">Yen </char><char style="xt"><ref loc="GEN 2:7">L. Z. 2:7</ref></char>. </note> <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />Ga̱ Shishi ka̱ tul cina so, mbala̱n ka̱n. Kaal ɗa̱ mbala̱mi yek Shishi tuli. <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />Mbala̱n ga̱ cina wo na̱ atl ka̱n sa̱ palti, a ga̱ kushka ka̱n. Ama mbala̱n ga̱ na̱ lop wo sut Nya ka̱n ta̱ yili. <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />Na̱k gwe ma̱l ga̱ atli ni wu, nu ka̱n ma̱jwe ni ɗe ga̱ atl wu ni. Na̱k gwe ma̱l ga̱ nya wu ni wu, nu ka̱n ma̱jwe ni ɗe ga̱ nya wu ni. <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />Na̱k gwe ma̱ te ma̱lgwe sa̱ pa̱lti na̱ kushka wu, nu ka̱n<note caller="+" style="f"><char style="fr" closed="false">15:49 </char><char style="ft" closed="false">Ka̱ lishti jon tek go </char><char style="fqa" closed="false">ha̱n ta̱n </char></note> ma te ma̱lgwe yil sut Nya wu.<verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />Ha̱n ta ɓo hwikii yilkeni jini, a pi ta̱ dli ga̱na̱n ma̱n hwulan suk tlu ga̱n mbi Nya boo so, nu ka̱n dli ma̱n mokiti mago a mbi dli gwe ba̱ a moki sowu so <verse eid="1CO 15:50" /><verse number="51" style="v" sid="1CO 15:51" />Ɓo kata̱n ka̱ng ta ɓo hwikii ilgon gwe ni ga̱ hwuda̱li wu, mas jina̱n ka̱n ma ma̱sha̱n so, ama mas jina̱n sa balli dli ga̱na̱n. <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />Na̱k cit gwel ka̱n sa balli dli ga̱na̱n, na̱ kumti hotti no ga̱ kaali na̱k ɗe sa̱ hot nomi wu. Apaa sa̱ tlil ma̱jwe ma̱sh wu na̱ dli gwe ba̱ a moki sowu. Apaa sa̱ balli dli ga̱na̱n. <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />Ngetli ka̱n ta̱s balli dli ga̱na̱n gwe a moki wu ta̱ da̱n ɗe gwe a moki sowu. Apaa dli gwe a moki wu da̱n ɗe gwe a ma̱sh sowu. <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />Kume sa̱ palli dli gwe a moki wu ɗe gwe a po moki sowu, a ma̱n ma̱shka̱n pal ɗe gwe ba̱ a ma̱sh sowu, apaa ilgwe ni ga̱ lishi ka̱ ga̱ɓa ga̱ Nya wu njika̱n gwe wule, &lt;&lt;Sa̱ sa̱nga ma̱shka̱n ka̱wi, sa̱ ci ba̱n tenti wi.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:54 </char><char style="ft" closed="false">Yen </char><char style="xt"><ref loc="ISA 25:8">Ish 25:8</ref></char>. </note><verse eid="1CO 15:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="1CO 15:55" />&lt;&lt;Ki ma̱shka̱n ka̱ cin ba̱n ko,</para>
  <para style="q2" vid="1CO 15:55">ilgwe aka̱ tlo mbala̱n na̱ nali wuk gwi?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:55 </char><char style="ft" closed="false">Yen </char><char style="xt"><ref loc="HOS 13:14">Hos 13:14</ref></char>. </note><verse eid="1CO 15:55" /></para>
  <para style="m">
    <verse number="56" style="v" sid="1CO 15:56" />Byas wul wo yek ɗe byas ika̱n ma̱n tlot ga̱ ba̱la̱n. Mba̱t wo yek ɗe nda̱lti ga̱ byas wul. go yek ɗe pa̱lti byas wul. <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />Ama ma̱ pa̱l hwol tuk na̱ Nya na̱k ɗe ta̱ laki yek ma̱ cin ba̱n tumal Bagaa Yesu Almasihu wu. <verse eid="1CO 15:57" /><verse number="58" style="v" sid="1CO 15:58" />Yilkeni jini ga̱ lami, dla̱la̱n na̱ nda̱lti ba̱ ilgon hwotkii so. Ba̱la̱n gaa gwaka̱n ten pa̱lti wul ga̱ Nya i'e mas cin na̱k ɗe ka̱a̱ yisi ɗe ilgwe ka̱ na̱ma pa̱lti ka̱ Bagaa Yesu go ten koo lu ka̱n ni sowu.<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s">Za̱t ang yilkeni ma̱n kopti</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />Ningo ten ilgwe ka̱a̱ lishi ten bi za̱t ang gwe kaa zi-ang ma̱n kopti wu, pa̱la̱n ilgwe a hwi ma̱n kopti ga̱ Galatiya ɗe ta̱s pa̱li wu.<note caller="+" style="f"><char style="fr" closed="false">16:1 </char><char style="ft" closed="false">Yen </char><char style="xt"><ref loc="ROM 15:25">Rom 15:25</ref>,<ref loc="ROM 15:26">26</ref></char>. </note> <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />Cin ga̱ cina ka̱ multi ɗe nitgi mas ta̱ kokko zi ilgon ka ka̱ ilgwe ata̱ mbi wu, ba̱k ɓa̱ti ɗe se a tul paa a ka̱a̱ nda mooti so. <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />Kume a tul wu, ba shin ma̱jwe ka̱a̱ kansi ɗe ma̱n gem wu ɗe ta̱s sul ilgwe ka̱a̱ mwe wu na̱ taka̱rda ta̱s ta̱le Wurshelima. <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />Kume mbun ɗe ta li wu, apaa a li suksi.<verse eid="1CO 16:4" /></para>
  <para style="s">Ilgwe Bulus ngemi wu</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />A koɓi tu ka̱ atl ga̱ Makedoniya wu, ba tul malkii, na̱k ɗe ba koɓi tu ka̱ atl ga̱ Makedoniya wu. <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />Gon a da̱m malkii hal a la pakti ga̱ watla̱n, ten ɗe ta̱k zini nini ang mas lu gwe ba li wu. <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />A lami ɗe ta tuli a yenkii a zigaa so. A na̱ma za̱t mbadl ɗe ba la̱m multi sukkii ɗe Bagaa Yesu lami wu. <verse eid="1CO 16:7" /><verse number="8" style="v" sid="1CO 16:8" />Ama ningo ba da̱n a Apisa se gas Pentekos. <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />Na̱k ɗe Nya ɓuli bal tantu ga̱ pa̱lti hwa wul a ɗe ama ma̱n nget ilgwe ba pa̱li wu wonti.<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />Kume Timoti tul malkii wu, kama̱nti ang lop lop na̱k ɗe ti mago Bagaa Yesu ka̱n ta̱ nitma pa̱lti wul na̱k gwe a na̱ma pa̱lti wu.<note caller="+" style="f"><char style="fr" closed="false">16:10 </char><char style="ft" closed="false">Yen </char><char style="xt"><ref loc="1CO 4:17">1Kor 4:17</ref></char>. </note> <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />Ba̱ gon gwaka̱n mbulti so, laka̱nti tantu ta̱s pal tet mala̱nni na̱ ta̱mi mbadli, a na̱ma ɓa̱tti palti gwasi suk naa yilkeni jwaka̱n.<verse eid="1CO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12" />A ngem yilka ga̱na̱n Apolos i'e ta̱s li ba̱n Korinti malkii suk naa yilkeni jon, ama na̱k ningo ta̱ ɓo lam la̱t so, kume ta̱ mbi ang la̱t wugo ta li.<verse eid="1CO 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />Da̱ma̱n na̱ ka̱ng gaa, dla̱la̱n na̱ nda̱lti ten nga̱sti gwaka̱n ten Nya. Da̱ma̱n na̱ nda̱li mbadli, dla̱la̱n nda̱li. <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />Pa̱la̱n mas wul ka̱ lamti.<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />Yilkeni jini, ka̱a̱ yisi ɗe ma̱n boo ga̱ Sitipanus ka̱ɗe ma̱jwe da̱n ɗe ma̱n kopti ga̱ Yesu cina ka̱ ba̱n Akaya wu, yek sa̱ ba̱l gaa gwasa̱n ta̱s pa̱li wul ma̱n kopti. <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />A na̱ma ngemti gwaka̱n ta̱k koɓa̱n ga̱ɓa ga̱ ma̱ju mas na̱ ma̱jwe tla bomti ten pa̱lti wul suksi wu. <verse eid="1CO 16:16" /><verse number="17" style="v" sid="1CO 16:17" />A kum ta̱mti tulti ga̱ ka̱a̱ Sitipanus suk Potunatus suk Akaikus, yek a yeni wule kik tuli. <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />Na̱k ɗe sa̱ laka̱n ten hwol tuk wu mas sukkii, wunda̱l ga̱ ma̱jwe mbun ɗe ta̱ mbala̱n nalla̱si.<verse eid="1CO 16:18" /></para>
  <para style="s">Palla̱t bi ga̱ Bulus</para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />Ma̱n kopti jwe ni ka̱ atl ga̱ Asiya wu mas na̱ma ga̱ɓet gwaka̱n ɗa. Ka̱a̱ Akila suk Pirisila<note caller="+" style="f"><char style="fr" closed="false">16:19 </char><char style="ft" closed="false">Mbeti na̱ bi Giris wo yek ɗe</char><char style="fqa" closed="false">Pirisika</char><char style="ft" closed="false">sogo ɗe</char><char style="fq" closed="false">Pirisila </char></note> suk ma̱n kopti jwe asa̱ mogaa a ɗaasi ka̱wu na̱ma ga̱ɓet gwaka̱n ɗa i'e ka̱ Bagaa Yesu. <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />Mas yilkeni jina̱n na̱ma ga̱ɓet gwaka̱n. Ga̱ɓe yilkeni na̱ ga̱ɓet mbokti ang ten lamti ka̱ zok mbadli na̱k gwe mbun ɗe ta̱ ma̱n kopti pa̱li wu.<verse eid="1CO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />Ami Bulus amik lish ga̱ɓet ge na̱ ang gini.<verse eid="1CO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22" />Ma̱lgwe lam Bagaa sogo ta̱ Bagaa pa̱lit bi gaa. Tuli, Bagaa!<note caller="+" style="f"><char style="fr" closed="false">16:22 </char><char style="ft" closed="false">Ilgwe sa̱ dlam na̱ bi Arameya go yek ɗe </char><char style="fqa" closed="false">Maranata</char><char style="ft" closed="false">a gaa gwas ka̱ɗe </char><char style="fq" closed="false">Teɗi Bagaa.</char></note><verse eid="1CO 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23" />Ha̱n ta̱ alheri ga̱ Bagaa Yesu da̱n sukkii.<verse eid="1CO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24" />A lamkii mas jwaka̱n ka̱ Almasihu Yesu. Amin.<note caller="+" style="f"><char style="fr" closed="false">16:24 </char><char style="ft" closed="false">Ka̱ lishti jon wo</char><char style="fq" closed="false">Amin</char><char style="ft" closed="false">ni giɓi so.</char></note><verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>