<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Rohingya Bible</book>
  <para style="h">Yuhunna</para>
  <para style="toc1">Yuhunnar Leka Kušir Hóbor</para>
  <para style="toc2">Yuhunna</para>
  <para style="toc3">Yuh</para>
  <para style="mt1">Yuhunnar leka Kušir hóbor</para>
  <chapter number="1" style="c" sid="JHN 1"/>
  <para style="s">Kalam manušor ruf loiye</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1"/>Šurut Kalam aššil, Kalam Allar fũwati aššil edde Kalam nize Allah aššil. <verse eid="JHN 1:1"/><verse number="2" style="v" sid="JHN 1:2"/>Hiba šurut Allar fũwati aššil.<verse eid="JHN 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 1:3"/>Hár kissu hibar duwara oiye, ar zin oiye, hinor ekkano hibare sara no o. <verse eid="JHN 1:3"/><verse number="4" style="v" sid="JHN 1:4"/>Hibattu zibon aššil, edde he zibon aššilde manušor nur. <verse eid="JHN 1:4"/><verse number="5" style="v" sid="JHN 1:5"/>Ar he nur andarot zoler, edde andare nurore loi ziti no fare.<verse eid="JHN 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6"/>Heṛe ekzon manuš hazir oil, hibare Allar torfottu defeṛa oil, hibar nam oilde Yahya. <verse eid="JHN 1:6"/><verse number="7" style="v" sid="JHN 1:7"/>Hibaye goba dito aiššil, zene hibaye Nuror babute goba de, toi zene hibar duwara beggune biššaš gore. <verse eid="JHN 1:7"/><verse number="8" style="v" sid="JHN 1:8"/>Hiba nize he nur nu aššil, kintu hibaye šude he nuror babute goba dito aiššil.<verse eid="JHN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 1:9"/>Hiba oilde asol nur, ze fotti manušore nur dan gore, hiba duniyait aišše. <verse eid="JHN 1:9"/><verse number="10" style="v" sid="JHN 1:10"/>Ei duniyait hiba aššil, edde duniyai hibar duwara oiye, to duniyair mainše hibare no sine. <verse eid="JHN 1:10"/><verse number="11" style="v" sid="JHN 1:11"/>Hiba nizor dešor aiššil, kintu hibar nizor mainše hibare no gose. <verse eid="JHN 1:11"/><verse number="12" style="v" sid="JHN 1:12"/>Tarfore o zeto zone hibare goisse, zara hibar namore biššaš goijje, hitara fottikiyore hibaye Allar fuwain oibar odihar diye. <verse eid="JHN 1:12"/><verse number="13" style="v" sid="JHN 1:13"/>Hitara louwottu no, gustottu no, manušor issaye o no o, kintu Allattu oiye.<verse eid="JHN 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14"/>He Kalam manušor ruf loiye edde ãrar fũwati bošobaš goijje. Bafor hãsottu aiššede šude lehar ek Fut, hibar ze mohima, he mohima ãra dekki, hiba doya edde soyiye furaiya.<verse eid="JHN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15"/>(Yahyaye hibar babute goba diye, ar guzori hodde, "Iba hiba zar babute ãi hoilam, 'Hiba ze ãi bade aiyer hiba ãttuwaro mohan, kiyollahoile hiba ãr age loti ase.'") <verse eid="JHN 1:15"/><verse number="16" style="v" sid="JHN 1:16"/>Hibar he furaiyattu ãra beggune doyar uwore doya faiyi. <verse eid="JHN 1:16"/><verse number="17" style="v" sid="JHN 1:17"/>Kiyollahoile Musar duwara ain diya oil; Isa Mosir duwara doya edde soiyi aišše. <verse eid="JHN 1:17"/><verse number="18" style="v" sid="JHN 1:18"/>Allare honokiye hono din no deke, kintu lehar he Fut, ze nize Allah, edde ze bafor beša beši hãse ase, hibaye hibare forhaš goijje.<verse eid="JHN 1:18"/></para>
  <para style="s">Yahyaye Messiyah no de hiyan šikar gorer</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19"/>Ar iyan oilde Yahyar goba, zẽtte Ihudi neta okkole Zeruzalemottu hoekzon imam edde levire Yahyar hãse hiba honnuwa fusar goitto defeṛail. <verse eid="JHN 1:19"/><verse number="20" style="v" sid="JHN 1:20"/>Ar hibaye šikar goijje, ošikar no gore, bolke šikar goijje, "Ãi Messiyah no."<verse eid="JHN 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21"/>Hitara hibare fusar goijje, "Toile tũi honnuwa? Tũi ki Eliyas?"</para>
  <para style="p" vid="JHN 1:21">Hibaye hodde, "Ãi no."</para>
  <para style="p" vid="JHN 1:21">"Toile tũi ki he Nobi?"</para>
  <para style="p" vid="JHN 1:21">Hibaye zuwabe hodde, "No."<verse eid="JHN 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22"/>Hetunot hitara hibare hodde, "Toile tũi honnuwa? Ãrare ho, zara ãrare defeṛaiye, hitarare zene ãra zuwab di fari. Tũi tũwar nizor babute ki ho?"<verse eid="JHN 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23"/>Hibaye hodde, "Ãi, bošoti sara elehat ek abaze guzori zanai der, 'Mabudolla fõt ṭik goro.'" zendilla Esaiyah nobiye hoiye.<verse eid="JHN 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24"/>Toi defeṛa oiyede Foroši okkole, <verse eid="JHN 1:24"/><verse number="25" style="v" sid="JHN 1:25"/>hitara hibattu fusar goijje, "Tũi zodi Messiyah o no oile, Eliyas o no oile, otóba he Nobi o no oile, toile kiyolla tũi torikotor gusol dor?"<verse eid="JHN 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26"/>Yahyaye zuwabe hodde, "Ãi fani loi torikotor gusol dir, kintu tũwarar butore ekzon tiyai roiye, zare tũwara no sino. <verse eid="JHN 1:26"/><verse number="27" style="v" sid="JHN 1:27"/>Iba hiba ze ãi bade aiyer, hibar ṭengor zutar fita kuli dibar laikka o ãi no."<verse eid="JHN 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28"/>Zordanor oinno faror Betaniyat, zeṛe Yahya torikotor gusol dil, heṛe in okkol goiṭṭe.<verse eid="JHN 1:28"/></para>
  <para style="s">Yahyaye Isar babute goba der</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29"/>Tarfordin Yahyaye Isare hibar mikka aiyedde dekiyore hodde, "So, Allar berasoolor so, ze duniyair guna boi loizargoi! <verse eid="JHN 1:29"/><verse number="30" style="v" sid="JHN 1:30"/>Iba oilde hiba zar babute ãi hoilam, 'Ãi bade en ekzon manuš aiyer ze ãttuwaro mohan, kiyollahoile hiba ãr age loti ase.' <verse eid="JHN 1:30"/><verse number="31" style="v" sid="JHN 1:31"/>Ãi nize hibare no sinitam, kintu hiba zene Israili okkolor hãse forhaš o, hiyanolla ãi aiyore fanit torikotor gusol dir."<verse eid="JHN 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32"/>Ar Yahyaye endilla goba diye, hodde: "Ãi dekki Ruh hoitoror ḍoilla oi asmanottu lami aiyedde, ar hiba hibar uwore roiye. <verse eid="JHN 1:32"/><verse number="33" style="v" sid="JHN 1:33"/>Ãi nize hibare no sinitam, kintu ze ãre fanit torikotor gusol dito defeṛaiye hibaye ãre hoiye, 'Zar uwore Pak Ruh lami aiyer edde hibar uwore roiyede dekibi, iba oilde hiba ze Pak Ruh loi torikotor gusol dibo.' <verse eid="JHN 1:33"/><verse number="34" style="v" sid="JHN 1:34"/>Ãi hen dekki edde goba dir ze, hiba oilde Allar Fut."<verse eid="JHN 1:34"/></para>
  <para style="s">Isa Mosir foila sahabi okkol</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35"/>Tarfordin, abar Yahyaye hibar duizon šagiritore fũwati loi heṛe tiyai aššil. <verse eid="JHN 1:35"/><verse number="36" style="v" sid="JHN 1:36"/>Ar Isa aṛi zadde dekiyore hibaye hodde, "So, Allar berasoolor so!"<verse eid="JHN 1:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37"/>Ei hota hodde šagirit dunizone funiyore hitara Isar fise fise za šuru goijje. <verse eid="JHN 1:37"/><verse number="38" style="v" sid="JHN 1:38"/>Isaye fissa fijje edde dekedde hitara hibar fise fise aiyer. Toi fusar goredde, <char style="wj">"Tũwara kiyor talaš gorodde?" </char></para>
  <para style="p" vid="JHN 1:38">Hitara hodde: "Rabbi! (zar mani ustad) Õne hoṛe tako?"<verse eid="JHN 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39"/>Isa hitarare hodde, <char style="wj">"Aiyo edde sogai."</char></para>
  <para style="p" vid="JHN 1:39">Toi hitara giye edde hiba hoṛe take he zaga hiyan saiye. Ar he dingan hitara hibar fũwati haṛaiye. Hẽtte dinor sairguwa baijje.<verse eid="JHN 1:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40"/>Yahyar hota funi ze duizon Isar fise fise gil, hitara ekzonor nam aššil Andreas, hite Simon Fitoror bái. <verse eid="JHN 1:40"/><verse number="41" style="v" sid="JHN 1:41"/>Andreas foila hitar bái Simonore tuwai loiye edde hitare hodde, "Ãra Messiyar deha faiyi" (Messiyah zar mani he basona goijjawa). <verse eid="JHN 1:41"/><verse number="42" style="v" sid="JHN 1:42"/>Toi hite Simonore Isar hãse ainne.</para>
  <para style="p" vid="JHN 1:42">Isaye Simonor mikka saiyore hodde, <char style="wj">"Tui Yohannar fut Simon, kintu tore Koifa hoi ḍaka oibo"</char> (Koifa oilde Fitor zar mani fattor).<verse eid="JHN 1:42"/></para>
  <para style="s">Isaye Filipore edde Natanaelore ḍaikke</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43"/>Tarfordin Isaye Galilot zaibo issa goijje. Ar hibaye Filipore faiyore hitare hodde, <char style="wj">"Ãr fisa lo."</char><verse eid="JHN 1:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 1:44"/>Filip o Andreas edde Fitoror ḍoil Betsaida ṭonor aššil. <verse eid="JHN 1:44"/><verse number="45" style="v" sid="JHN 1:45"/>Filipe Natanaelore lot faiye edde hitare hodde, "Musa nobiye zar babute Torah kitabot leikke edde zar babute nobi okkole o leikke, ãra hibar deha faiyi: Hiba oilde Nasarator Isa, Yusufor fut."<verse eid="JHN 1:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46"/>Toi Natanaelye hitare hodde, "Nasaratottu ki bala hono kissu ai faribo?"</para>
  <para style="p" vid="JHN 1:46">Filipe hitare hodde, "Ai edde sagai."<verse eid="JHN 1:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47"/>Isaye dekedde Natanael hibar mikka aiyer, toi hibaye hitar babute hodde, <char style="wj">"Oto so, ekzon soiyi Israili, zar butore hono dúhabazi nai."</char><verse eid="JHN 1:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48"/>Natanaelye hibare hodde, "Õne ãre kengori sino?"</para>
  <para style="p" vid="JHN 1:48">Isaye zuwab diye edde hitare hodde, <char style="wj">"Filipe tore ḍakibar age zẽtte tui ḍũir gasor tolat aššili, hẽtte ãi tore dekkilam."</char><verse eid="JHN 1:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49"/>Natanaelye zuwab diye edde hibare hodde, "Rabbi, õne Allar Fut, Israilor badša."<verse eid="JHN 1:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50"/>Isaye hodde, <char style="wj">"Ãi tore ḍũir gasor tolat dekki boli hoiyi hetolla ki tui ãre biššaš goror? Tui hiyanottuwaro aro ḍõr kissu dekibi."</char> <verse eid="JHN 1:50"/><verse number="51" style="v" sid="JHN 1:51"/>Bade Isaye aro hodde, <char style="wj">"Soiyi, soiyi, ãi tũwarare hoir, tũwara dekiba, 'behosto kula, ar Allar firista okkol uṛa lama gorer' Adomor Futor uwore."</char><verse eid="JHN 1:51"/></para>
  <chapter eid="JHN 1"/>
  <chapter number="2" style="c" sid="JHN 2"/>
  <para style="s">Kana fara biyar barit Isar foila keramot</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1"/>Ar tin dinor din Galilor Kana farat ekkan biya oiye. Isar ma heṛe aššil. <verse eid="JHN 2:1"/><verse number="2" style="v" sid="JHN 2:2"/>Ar he biyat Isa edde hibar sahabi okkolore o dawat diya oil. <verse eid="JHN 2:2"/><verse number="3" style="v" sid="JHN 2:3"/>Bade šoraf zehon furai giyegoi Isar maye Isare hodde, "Hitaratu šoraf furai giyegoi."<verse eid="JHN 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4"/>Isaye hodde, <char style="wj">"He maya fuwa, ãre kiyolla ei babute šamil goror? Ãr ṭaim aizo nu aiye."</char><verse eid="JHN 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5"/>Hibar maye sakor okkolore hodde, "Hibaye tũwarare zen goitto ho, tũwara hendilla goro."<verse eid="JHN 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6"/>Heṛe Ihudi okkole pak saf oibolla bebar gorede sowa fattoror fanir siyũ buwagoraiya aššil, hin fotti ugguwat kuri tiriš gelom fani aṛito.<verse eid="JHN 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 2:7"/>Isaye he soijja okkolore hodde, <char style="wj">"Ei siugunot fani bori do."</char> Toi hitara hinor hãra hãra ofan gori fani bori diye.<verse eid="JHN 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 2:8"/>Hibaye hitarare hodde, <char style="wj">"Ebar hentu olfo olfo furai loi hána baṛidoya okkolor mazir hãse loizo."</char></para>
  <para style="p" vid="JHN 2:8">Toi hitara hen goijje, <verse eid="JHN 2:8"/><verse number="9" style="v" sid="JHN 2:9"/>tarfore hána baṛidoya maziye ze fani šoraf oiye hin fi hái saiye, ar hite hin honttu aišše no zanito, kintu ze soijja okkole fani tuillil, hitara zanito. Toi hite dulare ek ḍaikka ḍaki loizai hodde, <verse eid="JHN 2:9"/><verse number="10" style="v" sid="JHN 2:10"/>"Mainše foila barik šoraf haito de, tarfore zehon meheman okkole beši fifele hetunot hosta šoraf diya o; kintu tui barik šoraf ehon o foijjonto rakidiyos."<verse eid="JHN 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11"/>Iyan aššilde sinno okkolor šuru, ziyan Isaye Galilor Kana farat goijje, edde hibar mohimare forhaš goijje; ar hibar sahabi okkole hibar uwore biššaš ainne.<verse eid="JHN 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12"/>Tarfore hiba, hibar ma, báiyain edde sahabi okkol Kofornahumot lami giye, ar heṛe beši din no take.<verse eid="JHN 2:12"/></para>
  <para style="s">Isa Zeruzalemor dórmogórot</para>
  <para style="r">(<ref loc="MAT 21:12-13">Moti 21:12–13</ref>; <ref loc="MRK 11:15-17">Mark 11:15–17</ref>; <ref loc="LUK 19:45-46">Luk 19:45–46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13"/>Hẽtte Ihudi okkolor uddar id hãse aišše, ar Isa uwore Zeruzalemot giye. <verse eid="JHN 2:13"/><verse number="14" style="v" sid="JHN 2:14"/>Heṛe dórmogóror uṛanot hibaye goru, sool, ar hoitor, besa kina goredde lotfaiye, ar heṛe fũnḍiola okkol boišše. <verse eid="JHN 2:14"/><verse number="15" style="v" sid="JHN 2:15"/>Toi hibaye dori loi ekkan souk banaiye, ar hiyan loi goru sool edde manuš beggunore dórmogórottu lorai diye; ar hibaye fũnḍiola okkolor foiša okkol šiṛidiye edde hitarar ṭebilgunore uldaidiye. <verse eid="JHN 2:15"/><verse number="16" style="v" sid="JHN 2:16"/>Toi hibaye he hoitor besoya okkolore hodde, <char style="wj">"Ei zagattu in okkol šorai loi felo! Ãr Bafor górore bazaror zaga no banaiyo."</char> <verse eid="JHN 2:16"/><verse number="17" style="v" sid="JHN 2:17"/>Hibar sahabi okkolottu monot foijje ze iyan leka ase: "Tũwar górolla zolonto issaye ãr dil zali tulibo."<verse eid="JHN 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18"/>Toi Ihudi okkole zuwab diye edde fusar goijje, "Tui ki sinno ãrare dehai faribi ze tottu in goribolla odihar ase?"<verse eid="JHN 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19"/>Isaye zuwab diye edde hitarare hodde, <char style="wj">"Ei dórmogórgan bangifelo, ar ãi iyan abar tin dinor butore tuliyum."</char><verse eid="JHN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20"/>Hitara hodde, "Ei dórmogór iyan bandite sališ so bosor laggil, ãr iyan tui tin dinor butore tulibi?" <verse eid="JHN 2:20"/><verse number="21" style="v" sid="JHN 2:21"/>Asole hibaye ḍórmogór hoite hibar nizor gar babute hoiyede. <verse eid="JHN 2:21"/><verse number="22" style="v" sid="JHN 2:22"/>Hetolla hiba zẽtte morattu uṛigiyegoi, hibar sahabi okkolottu monot foijje ze hibaye hitarare iyan hoilde, ar hitara Pak kitabor kalam edde Isaye hoilde hota biššaš goijje.<verse eid="JHN 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23"/>Uddar idor ṭaimot hiba zẽtte Zeruzalemot aššil, hẽtte ze sinno okkol hibaye gorat aššil, hin dekiyore boute hibar namot biššaš goijje. <verse eid="JHN 2:23"/><verse number="24" style="v" sid="JHN 2:24"/>Kintu Isa nize hitarar biššašor babute biššaš no gore, kiyollahoile hibaye hitara beggunore zane. <verse eid="JHN 2:24"/><verse number="25" style="v" sid="JHN 2:25"/>Ar manuš zatir babute honokiye goba dok, hibattu hiyanor hono dorhar nu aššil, kiyollahoile manušor butore ki aššilde hiyan hibaye nize zanito.<verse eid="JHN 2:25"/></para>
  <chapter eid="JHN 2"/>
  <chapter number="3" style="c" sid="JHN 3"/>
  <para style="s">Isaye Nikoḍomasore šikar</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1"/>Heṛe Forošir ekzon manuš aššil, zar nam Nikoḍomas, Ihudi okkolor ek neta. <verse eid="JHN 3:1"/><verse number="2" style="v" sid="JHN 3:2"/>Ekdin raitta hibaye Isar hãse aiyore hodde, "Rabbi, ãra zani õne ekzon šikkadoya, ze Allar hãsottu aiššo. Kiyollahoile õne ze sinnor ham okkol zin goijjo, hin Allah fũwati no takile honokiye gori no fare."<verse eid="JHN 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3"/>Isaye zuwabe hodde, <char style="wj">"Ãi tũware soiyi hoir, noya gori zormo no oile, honokiye Allar raijjo deki no faribo."</char><verse eid="JHN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4"/>Nikoḍomase hibare hodde, "Manuš ekzon bura oile kengori zormo oi faribo? Hite ki dusora bar mar ferõt uwafes firizaiyore zormo oi faribo?"<verse eid="JHN 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5"/>Zuwabe Isaye hodde, <char style="wj">"Ãi tũware soiyi hoir, zodi hono kiye fani edde Pak Ruhuttu zormo no o, hite Allar raijjot goli no fare.</char> <verse eid="JHN 3:5"/><verse number="6" style="v" sid="JHN 3:6"/><char style="wj">Hiyan ziyan gustor zormo oiye, oilde gusto, ar hiyan ziyan Ruhor zormo oiye, oilde ruh.</char> <verse eid="JHN 3:6"/><verse number="7" style="v" sid="JHN 3:7"/><char style="wj">Ãi ze tũware hoilam, 'Tũwarattu hameka noya gori zormo owa foribo,' hiyanot ammuwak no oiyo.</char> <verse eid="JHN 3:7"/><verse number="8" style="v" sid="JHN 3:8"/><char style="wj">Boyar ze mikka baito sa he mikka ba. Tũwara hinor abas funo, kintu ei boyar hontu aiye edde hon mikka za hiyan tũwara hoi no faro. Pak Ruhor zormo owa o hendilla." </char><verse eid="JHN 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9"/>Nikoḍomase hodde, "En kengori oi faribo?"<verse eid="JHN 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10"/>Hetunot Isaye hodde, <char style="wj">"Tũi Israilor šikkadoya oi bade ei ziniš okkol kissu no buzo kiya?</char> <verse eid="JHN 3:10"/><verse number="11" style="v" sid="JHN 3:11"/><char style="wj">Ãi tũware soiyi hoir, ãra ziyan zani ãra hiyan hoi, ar zin deki hinor babute goba di, kintu tũwara ãrar goba no goso.</char> <verse eid="JHN 3:11"/><verse number="12" style="v" sid="JHN 3:12"/><char style="wj">Ãi duniyaibi zinišor babute hoidde hin zodi biššaš no goror, henot behostor zinišor babute hoile ken gori biššaš goriba?</char> <verse eid="JHN 3:12"/><verse number="13" style="v" sid="JHN 3:13"/><char style="wj">Ze behostottu lami aišše he Adomor Fut sara ar honokiye honodin behostot no uṛe.</char> <verse eid="JHN 3:13"/><verse number="14" style="v" sid="JHN 3:14"/><char style="wj">Ar Musa nobiye zendilla bošoti sara elehat hafore uwore tullil, hendilla Adomor Futore o tuli lowa oibo,</char> <verse eid="JHN 3:14"/><verse number="15" style="v" sid="JHN 3:15"/><char style="wj">zene fottikiye ze hibare biššaš gore hite akeri zibon fa."</char><verse eid="JHN 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16"/>Kiyollahoile Allaye duniyaire eto beši ador goijje ze, hibar he lehar ek Futore diye, zene, ze kiye hibar uwore biššaš ane hite dongšo no o, bolke akeri zibon fa. <verse eid="JHN 3:16"/><verse number="17" style="v" sid="JHN 3:17"/>Kiyollahoile Allaye hibar Futore defeṛaiyede duniyair bisar goribolla no, bolke duniyaiye zene hibar duwara uddar fa. <verse eid="JHN 3:17"/><verse number="18" style="v" sid="JHN 3:18"/>Hite ze hibare biššaš gorer, hitar bisar gora no oibo, kintu hite ze biššaš no gorer hitar bisar ehon loti oigiyegoi, kiyollahoile hite Allar šude lehar Futor namot biššaš no ane. <verse eid="JHN 3:18"/><verse number="19" style="v" sid="JHN 3:19"/>Ar iyan oilde bisar: Nur duniyait aišše, ar manuš okkole nurottuwaro andarore beši muhabbot goijje, kiyollahoile hitarar ham aššil horaf. <verse eid="JHN 3:19"/><verse number="20" style="v" sid="JHN 3:20"/>Kiyollahoile fottikiye ze horaf ham gorer, hitara nurore hingša gorer, ar nuror ḍake nu aiye, zene hitar horaf ham forhaš oi no zagoi <verse eid="JHN 3:20"/><verse number="21" style="v" sid="JHN 3:21"/>Kintu hite ze soyit soler, hite nuror hãse aiye, toi zene hitar hamgun Allar issa mozin gora oiyede hiyan foriškar deha za.<verse eid="JHN 3:21"/></para>
  <para style="s">Yahyaye Isar babute goba der</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22"/>In okkol bade, Isa edde hibar sahabi okkol Ehudiya elehat aišše, ar hiba heṛe kissu din hitarar fũwati taikke, edde torikotor gusol diye. <verse eid="JHN 3:22"/><verse number="23" style="v" sid="JHN 3:23"/>Ehon, Yahyaye o Salimor hãsa hãsi Aenonot, torikotor gusol diyat aššil, kiyollahoile heṛe beši fani aššil, ar manuš okkol heṛe aiyore torikotor gusol lowat aššil. <verse eid="JHN 3:23"/><verse number="24" style="v" sid="JHN 3:24"/>(In aššilde Yahyare ziyolot dibar age.) <verse eid="JHN 3:24"/><verse number="25" style="v" sid="JHN 3:25"/>Hẽtte Ihudi rosomi pak safor babute Yahyar šagirit okkol loi edde ekzon Ihudi loi barabari uiṭṭe. <verse eid="JHN 3:25"/><verse number="26" style="v" sid="JHN 3:26"/>Bade hitara Yahyar hãse aiyore hodde, "Rabbi, ze Zordanor ofarot õnor fũwati aššil, edde zar babute õne goba dila, so, hibaye torikotor gusol der, ar beggune hibar hãse zar."<verse eid="JHN 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27"/>Yahyaye hodde, "Behostottu diya oiyede no oile ekzon mainše hono kissu fai no fare. <verse eid="JHN 3:27"/><verse number="28" style="v" sid="JHN 3:28"/>Tũwara nize ãr goba ze ãi hoiyi, 'Ãi Messiyah no, kintu ãre hibar age defeṛa oiye.' <verse eid="JHN 3:28"/><verse number="29" style="v" sid="JHN 3:29"/>Zar hãse hoinna, hiba oilde dula. Dular bondu, ze tiyaiyore hibar hota funer, hibaye dular abazot beši kušiye anondo gorer; aijja ãttu o hendilla furafuri kuši furon oiye. <verse eid="JHN 3:29"/><verse number="30" style="v" sid="JHN 3:30"/>Iyan zorulot ehonottu loti hibattu bara foribo, ãttu šoṛo owa foribo."<verse eid="JHN 3:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31"/>Ze uwottu aiye, hiba beggunor uwore; ze duniyaittu hite duniyair, ar duniyair ekzonor ḍoilla hota ho. Hiba ze behostottu aiye, hiba beggunor uwore. <verse eid="JHN 3:31"/><verse number="32" style="v" sid="JHN 3:32"/>Hibaye zin deikke edde fuinne hinor goba der, tarfore o honokiye hibar gobare no goser. <verse eid="JHN 3:32"/><verse number="33" style="v" sid="JHN 3:33"/>Hite ze hibar gobare goser, hiyane sil maijje ze Allah oilde soiyi. <verse eid="JHN 3:33"/><verse number="34" style="v" sid="JHN 3:34"/>Kiyollahoile hiba zare Allaye defeṛaiye, hibaye Allar kalam hor; kiyollahoile Allaye Ruhure mafiyore no de. <verse eid="JHN 3:34"/><verse number="35" style="v" sid="JHN 3:35"/>Bafe Futore ador gore edde hár kissure hibar hãtot šebi diye. <verse eid="JHN 3:35"/><verse number="36" style="v" sid="JHN 3:36"/>Hite ze Futore biššaš gore, hite akeri zibon faiye, kintu hite ze Futore batil gore, hite zibon no dekibo, bolke Allar gozob hitar uwore ase edde takibo.<verse eid="JHN 3:36"/></para>
  <chapter eid="JHN 3"/>
  <chapter number="4" style="c" sid="JHN 4"/>
  <para style="s">Isa edde he Sameriyo mayafuwawa</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1"/>Ehon, Malike zehon zani faijje ze Foroši okkole fuinnil, hibaye Yahyattuwaro beši sahabi banar edde torikotor gusol der, <verse eid="JHN 4:1"/><verse number="2" style="v" sid="JHN 4:2"/>(zodi o Isaye nize torikotor gusol no dito, kintu hibar sahabi okkole dito.) <verse eid="JHN 4:2"/><verse number="3" style="v" sid="JHN 4:3"/>Toi hiba Ehudiyattu giyegoi edde abar Galilot giye.<verse eid="JHN 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 4:4"/>Zaite hibattu Sameriyar butottu di za foijje. <verse eid="JHN 4:4"/><verse number="5" style="v" sid="JHN 4:5"/>Toi hiba Sykar name Sameriyar ek šohorot, aiššiye; ziyan Yakube hibar fut Yusufore dilde zobinor hãse. <verse eid="JHN 4:5"/><verse number="6" style="v" sid="JHN 4:6"/>He zagat heṛe ugguwa Yakubor kuwa aššil. Fõtot zat maze Isa oran oiye, edde he kuwar ḍake boišše; ar hẽtte ṭaim onumanik dũijja.<verse eid="JHN 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7"/>Toi heṛe Sameriyattu ek mayafuwa fani tulito aišše, Isaye hibare hodde, <char style="wj">"Ãre fani fito de"</char> <verse eid="JHN 4:7"/><verse number="8" style="v" sid="JHN 4:8"/>(Hibar sahabi okkole šohorot hána kinto gil.)<verse eid="JHN 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9"/>He Sameriyo mayafuwawaye hibare hodde, "Õne, ekzon Ihudi oiyore, ãi ekzon Sameriyar mayafuwa oiyore, ãttu kengori fani sor?" (Kiyollahoile Ihudi okkole Sameriyo okkol loi suwa fiya no gorito.)<verse eid="JHN 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10"/>Isaye zuwabe hibare hodde, <char style="wj">"Tui zodi zaniti Allar hadiya ki, edde hiba honnuwaye hor 'Ãre fani fito de', toile tui hibattu saiti, ar hibaye tore zinda fani dito."</char><verse eid="JHN 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11"/>Mayafuwawaye hodde, "Malik, õnottude fani tulibolla kissu nai ar kuwawa o mur. Toile he zinda fani hontu for? <verse eid="JHN 4:11"/><verse number="12" style="v" sid="JHN 4:12"/>Ãrar baf Yakubottuwaro ki õne mohan, edde ze ei kuwa ãrare diye, ar hibattu hiba nize edde hibar fuwain okkole, hibar zanuwaror záke fani fiye?"<verse eid="JHN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13"/>Isaye zuwabe hibare hodde, <char style="wj">"Fottikiye ze ei fani fiyer hite abar tiraši oibo,</char> <verse eid="JHN 4:13"/><verse number="14" style="v" sid="JHN 4:14"/><char style="wj">kintu ze honokiye ãi diyumde he fanittu fibo, hite ar honodin tiraši no oibo; ãi diyumde fani hin hitar dilor butore ũtari uṛede zonnar fani ḍoilla oibo, edde akeri zibon dibo."</char><verse eid="JHN 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15"/>Mayafuwawaye hibare hodde, "Malik, toile ei fani ãre do, zene ãttu ar tiraš no lage, ar fani tulibolla eṛe aiya no fore."<verse eid="JHN 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16"/>Isaye hibare hodde, <char style="wj">"Za, tor zamaire ḍaki loiagoi"</char><verse eid="JHN 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17"/>Mayafuwaye hodde, "Ãttu zamai nai."</para>
  <para style="p" vid="JHN 4:17">Isaye hibare hodde, <char style="wj">"'Ãttu zamai nai' hoyosde hiyan tui ṭik hois.</char> <verse eid="JHN 4:17"/><verse number="18" style="v" sid="JHN 4:18"/><char style="wj">Kiyollahoile ei foijjonto tottu fãszon zamai aššil, ar ehon tottu ze ase, hite tor zamai no; tui hodde hiyan soiyi."</char><verse eid="JHN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19"/>Mayafuwaye hodde, "Malik, ãi buzi faijji ze õne ekzon nobi. <verse eid="JHN 4:19"/><verse number="20" style="v" sid="JHN 4:20"/>Ãrar fordada okkole ei faharor uwore ebadot gorito, kintu tũwara ho ze zagat ebadot gora foribo hiyan oilde Zeruzalemot."<verse eid="JHN 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21"/>Isaye hibare hodde: <char style="wj">"Oh mayafuwa, ãrar hota biššaš gor, en ṭaim aiyer zẽtte tũwara, no ei faharot, no Zeruzalemot, Bafor ebadot goriba.</char> <verse eid="JHN 4:21"/><verse number="22" style="v" sid="JHN 4:22"/><char style="wj">Tũwara ziyan no zano hiyanor ebadot goro; kintu ãra ziyan zani hiyanor ebadot gori, kiyollahoile uddar oilde Ihudi okkolor butottu.</char> <verse eid="JHN 4:22"/><verse number="23" style="v" sid="JHN 4:23"/><char style="wj">Kintu en ṭaim aiyer, enki ehon he šomoi aigiyegoi zẽtte asol ebadot goroya okkole soiyit edde Ruhut Bafor ebadot goribo. Bafe o endilla ebadot goroya okkolore tuwa.</char> <verse eid="JHN 4:23"/><verse number="24" style="v" sid="JHN 4:24"/><char style="wj">Allah oilde Ruh, ar hitara zara hibar ebadot gore, soiyit edde Ruhut ebadot gora foribo." </char><verse eid="JHN 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25"/>Mayafuwawaye hodde, "Ãi zani Messiyah aibo (zare Mosi ḍake). Hiba zẽtte aibo, hibaye ãrare hár kissu buzai dibo."<verse eid="JHN 4:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26"/>Toi Isaye hibare hodde, <char style="wj">"Ãi, ze tor loi hota hoir, ãi hiba."</char><verse eid="JHN 4:26"/></para>
  <para style="s">Isa edde Sameriyo okkol</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27"/>Hen šomot hibar sahabi okkol aišše, edde hibaye ekzon mayafuwa loi hota hodde dekiyore hitara ammuwak oiye. Tarfore o hitara honokiye no ho, "Õne ki sodde?" Ba "hibar loi kiyolla hota hor?"<verse eid="JHN 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28"/>Toi mayafuwawaye hibar gorawa felai raki šohoror butore giye, edde mainšore hodde, <verse eid="JHN 4:28"/><verse number="29" style="v" sid="JHN 4:29"/>"Aiyo, ekzon manušore sogai, ze ãi zaha kissu goijji, beggun ãre hoi diye; Iba ki hono Messiyah ne?" <verse eid="JHN 4:29"/><verse number="30" style="v" sid="JHN 4:30"/>Hitara šohorottu niyoli giye edde Isar hãse aišše.<verse eid="JHN 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31"/>Hen šomot hibar sahabi okkole hibare foriyad gori hodde, "Rabbi, kissu hó."<verse eid="JHN 4:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32"/>Isaye hitarare hodde: <char style="wj">"Ãttu háibolla en hána ase, zinor babute tũwara no zano." </char><verse eid="JHN 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33"/>Sahabi okkol ekzone oinno zonore howa hoi goijje, "Honokiye ki hibare háibolla kissu ani diye oitfare?"<verse eid="JHN 4:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34"/>Isaye hitarare hodde, <char style="wj">"Ze ãre defeṛaiye hibar issa falon gora edde hibar ham gori šeš gorifela oilde ãr hána.</char> <verse eid="JHN 4:34"/><verse number="35" style="v" sid="JHN 4:35"/><char style="wj">Tũwara ki no ho ne, 'ehon o sair maš ase, tarfore gula daibar ainda aiyer'? Ãi tũwarare hoir, suk tuli maṭ okkolor mikka so, hin daibolla fagi dóla oiye.</char> <verse eid="JHN 4:35"/><verse number="36" style="v" sid="JHN 4:36"/><char style="wj">Ze dar hite hitar beton far, ar akeri zibonolla gulagun dola gori raker, zene ze biz laga edde ze gula da, dunizone ekkui fũwati kuši gori fare.</char> <verse eid="JHN 4:36"/><verse number="37" style="v" sid="JHN 4:37"/><char style="wj">Etolla ei bosongan soiyi, 'Ekzone laga ar ekzone da.'</char> <verse eid="JHN 4:37"/><verse number="38" style="v" sid="JHN 4:38"/><char style="wj">Ãi tũwarare daito defeṛailam zinolla tũwara hono haṛoni no goro; haṛoni goijje oinno kiye, ar tũwara goillo hitarar haṛonir fošol daito."</char><verse eid="JHN 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39"/>'Ãi zaha kissu goijji, beggun ãre hoi diye' he mayafuwawar ei gobar hotar zoriya he šohoror bout Sameriyo okkole Isar uwore biššaš ainne. <verse eid="JHN 4:39"/><verse number="40" style="v" sid="JHN 4:40"/>Toi hitara hibar hãse aišše edde hibare hitarar fũwati takibolla foriyad goijje; ar hiba heṛe dui din taikke. <verse eid="JHN 4:40"/><verse number="41" style="v" sid="JHN 4:41"/>Hibar hotar zoriya aro bout beši mainše biššaši oiye.<verse eid="JHN 4:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 4:42"/>Hitara mayafuwaware hodde: "Ãra šude tor hotar zoriya biššaš ainnide no; kiyollahoile ãra nize hibar hota fuinni edde zani ze iba oilde soiyi duniyair he Uddargoroya."<verse eid="JHN 4:42"/></para>
  <para style="s">Kofornahumot he raz hormosari</para>
  <para style="r">(<ref loc="MAT 8:5-13">Moti 8:5-13</ref>; <ref loc="LUK 7:1-10">Luk 7:1-10</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43"/>Dui din farai zaigoi bade Isaye hentu baisa diye edde Galilot giyegoi. <verse eid="JHN 4:43"/><verse number="44" style="v" sid="JHN 4:44"/>(Kiyollahoile hibaye nize goba dil ze ekzon nobi hibar nizor dešot ijjot no fa.) <verse eid="JHN 4:44"/><verse number="45" style="v" sid="JHN 4:45"/>Hiba zehon Galilot aišše, Galiliyo okkole hibare goisse, Zeruzalemot uddar idot hibaye goijjede hár kissu hitara dekiyore, kiyollahoile hitara o uddar idot gil.<verse eid="JHN 4:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46"/>Isa abar Galilor Kana farat giye, zeṛe hibaye fanire šoraf goijjil. Ar heṛe ek raz hormosari aššil, zar fute ošuk loi duk fat aššil. <verse eid="JHN 4:46"/><verse number="47" style="v" sid="JHN 4:47"/>Ehudiyattu Isa Galilot aišše funiyore hite hibar hãse aišše, edde foriyad goijje zene hiba hitar fũwati lamat za edde hitar futore aram gore, kiyollahoile hitarar foran zar zar oiye.<verse eid="JHN 4:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 4:48"/>Toi Isaye hitare hodde: <char style="wj">"Sinno edde keramoti ham no dekile, tũwara biššaš no goriba."</char><verse eid="JHN 4:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49"/>He raz hormosariye hodde: "Malik, meherbani gori ãr fuwawa no morite aiyo."<verse eid="JHN 4:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50"/>Isaye hitare hodde, <char style="wj">"Za, tor fut basibo."</char></para>
  <para style="p" vid="JHN 4:50">Henot hite Isaye hoiyede hota biššaš goijje edde giyegoi. <verse eid="JHN 4:50"/><verse number="51" style="v" sid="JHN 4:51"/>Ar hite lamat zadde fõtot, hitar gulam okkole dola oiye edde hitar hãse hóbor diye ze hitar fuwawa baisse. <verse eid="JHN 4:51"/><verse number="52" style="v" sid="JHN 4:52"/>Hite hitarare hite hõtte bala oiye he babute zera goijje, ar hitara hitare hodde: "Gelde hailla ugguwa baze, hitattu zor sarigiyegoi."<verse eid="JHN 4:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 4:53"/>Henot fuwawar bafe buzi faijje ze, ṭik he šomot Isaye hitare hoil, <char style="wj">"Za, tũwar fut basibo."</char> Toi hite edde hitar fura gór ṭiyaye biššaši oiye.<verse eid="JHN 4:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54"/>Ehudiyattu Galilot ai bade Isaye ei dusora bar keramoti ham goijjil.<verse eid="JHN 4:54"/></para>
  <chapter eid="JHN 4"/>
  <chapter number="5" style="c" sid="JHN 5"/>
  <para style="s">Betesda foiror ḍake aram gora</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1"/>Iyar bade Ihudi okkolor ek id oiye, ar Isa uwore Zeruzalem giye. <verse eid="JHN 5:1"/><verse number="2" style="v" sid="JHN 5:2"/>Ar heṛe Zeruzalemot Sool Geiṭor hãse ugguwa foir ase, zibare Ibroni bašat Betesda ho, ar hibat fãssan saniola gãṭ aššil. <verse eid="JHN 5:2"/><verse number="3" style="v" sid="JHN 5:3"/>In okkolot ek dõr biyaraimma mainšor dol foritakito, zara anda, lula, ãtur manuš okkol. <verse eid="JHN 5:3"/><verse number="4" style="v" sid="JHN 5:4"/>(Kiyollahoile ek firistaye šome šome oi foirot lami zaiyore fani hafaito, ei fani hafa bade ze foila fanit lamito, hitattu ze hono ḍoilla biyaram takibo takok, aram oi zaitogoi.)<verse eid="JHN 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 5:5"/>Ar heṛe ekzon manuš aššil, ze tiriš ašṭo bosormula biyaraimma, <verse eid="JHN 5:5"/><verse number="6" style="v" sid="JHN 5:6"/>hite heṛe fori taikkede Isaye deikke, ar zani faijje ze hite bout din dori hite he abostat ase, toi hibaye hitare fusar goredde: <char style="wj">"Tui aram oito sos ne?"</char><verse eid="JHN 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7"/>He biyaraimma manušwaye hodde, "Malik, fani hafi uṛede šomot ãre foirot lamai loizaoya ãttu hono kiye nai; ar ãi nize zaite zaite ar ekzon ãr agottu lamegoi."<verse eid="JHN 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8"/>Toi Isaye hitare hodde, <char style="wj">"Uṭ, tor bisana tuli lo edde aṭ."</char> <verse eid="JHN 5:8"/><verse number="9" style="v" sid="JHN 5:9"/>Hehon he manušwa aram oiye; ar hite hitar bisanagan tuli loiye edde ãiṭṭe.</para>
  <para style="p" vid="JHN 5:9">Ar he din aššilde Šabbat, <verse eid="JHN 5:9"/><verse number="10" style="v" sid="JHN 5:10"/>Ihudi neta okkole aram gora oiyede he manušware hodde, "Aijja, Šabbat, ain mozin bisana boi loi za mana."<verse eid="JHN 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11"/>Hite hitarare zuwab diye, "Hiba ze ãre aram goijje, hibaye ãre hoiye,<char style="wj">'Tor bisana tuli lo edde aṭ.'</char> "<verse eid="JHN 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12"/>Toi hitara hitattu fusar goijje, "Manuš hiba honnuwa ze tore bisana tuli lo edde aṭ hoiye?"<verse eid="JHN 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13"/>Ze manušwa aram oiye hite no zanito hiba honnuwa aššil, kiyollahoile Isaye šori gilgoi, heṛe beša beši manuš okkol aššil.<verse eid="JHN 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14"/>Fore zaiyore Isaye he manušware abar dórmogóror uṛanot lot faiye edde hitare hodde: <char style="wj">"Sa, tui bala oiyos, guna ar no goris, toi zene tor uwore iyattuwaro aro horaf hono kissu no goṭe."</char> <verse eid="JHN 5:14"/><verse number="15" style="v" sid="JHN 5:15"/>Hite zaiyore Ihudi netare hoiyegoi ze, hitare bala goijje hiba aššilde Isa.<verse eid="JHN 5:15"/></para>
  <para style="s">Futor odihar</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 5:16"/>Ar iyanolla boli Ihudi okkole hibare zala šuru goijje, kiyollahoile hibaye in okkol Šabbatot goijje. <verse eid="JHN 5:16"/><verse number="17" style="v" sid="JHN 5:17"/>Ar Isaye hitarare hodde, <char style="wj">"Ãr Baf ehon foijjonto hamot, ar ãi o ham gorir."</char> <verse eid="JHN 5:17"/><verse number="18" style="v" sid="JHN 5:18"/>Iyanor zoriya Ihudi okkole hibare marifelaibolla aro beši kušiš goijje; kiyollahoile hibaye šude Šabbator niyom no bange, kintu Allare hibaye nizor Baf o hoiye, hiba nizore Allar fuwainna goriyore.<verse eid="JHN 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19"/>Iyanot Isaye hitarare zuwab diye edde hodde: <char style="wj">"Ãi tũwarare soiyi soiyi hoir, Fute nizottu hono kissu gori no fare; zodi hibar Bafe kissu gorede no deke; kiyollahoile zin hibaye gore Fute o gore.</char> <verse eid="JHN 5:19"/><verse number="20" style="v" sid="JHN 5:20"/><char style="wj">Kiyollahoile Bafe Futore ador gore, ar hár kissu zin hibaye nize gore, beggun hibare deha; ar inottuwaro aro mohan ham okkol hibaye hibare dehaibo, zene tũwara ammuwak o.</char> <verse eid="JHN 5:20"/><verse number="21" style="v" sid="JHN 5:21"/><char style="wj">Zendilla Bafe mora okkolore tule edde zibon de, hendilla Fute o hibattu zare issa hitare zibon de.</char> <verse eid="JHN 5:21"/><verse number="22" style="v" sid="JHN 5:22"/><char style="wj">Aro, Bafe honokiyor bisar no gore, kintu bisaror fura bar hibar Futor uwore diye,</char> <verse eid="JHN 5:22"/><verse number="23" style="v" sid="JHN 5:23"/><char style="wj">zene beggune Bafore šorman gorede mozin Futore šorman gore; hite ze Futore šorman no gore, hite Bafore šorman no gore, ze hibare defeṛaiye.</char><verse eid="JHN 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24"/>
    <char style="wj">"Soiyi, soiyi, ãi tũwarare hoir, hite ze ãr kalam funer, ar ze ãre faṭaiye hibare biššaš gorer, hitattu akeri zibon ase; ar hitare bisarot tula no oibo, kintu morattu zibonot faraiyegoi.</char> <verse eid="JHN 5:24"/><verse number="25" style="v" sid="JHN 5:25"/><char style="wj">Ãi tũwarare soiyi soiyi hoir, en ṭaim aiyer, bolke hiyan ehon aišše, zẽtte mora okkole Allar Futor abaz funibo, edde hitara zara funibo, hitara basibo.</char> <verse eid="JHN 5:25"/><verse number="26" style="v" sid="JHN 5:26"/><char style="wj">Kiyollahoile Baf nizottu zendilla zibon ase, hendilla hibaye Fut nizottu o zibon taibolla diye.</char> <verse eid="JHN 5:26"/><verse number="27" style="v" sid="JHN 5:27"/><char style="wj">Ar hibaye hibare bisar goribolla odihar diye, kiyollahoile hiba oilde Adomor Fut.</char><verse eid="JHN 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 5:28"/>
    <char style="wj">"Ei hota funi ammuwak no oiyo, kiyollahoile en ṭaim aiyer, zara hoborot ase hitara beggune hibar abaz funibo,</char> <verse eid="JHN 5:28"/><verse number="29" style="v" sid="JHN 5:29"/><char style="wj">edde hitara niyoli aibo, hitara zara bala ham goijje hitara zibon faibolla, ar hitara zara horaf ham goijje, hitara šasti faibolla.</char> <verse eid="JHN 5:29"/><verse number="30" style="v" sid="JHN 5:30"/><char style="wj">Ãi nizottu kissu gori no fari, zendilla funi hendilla bisar gori, ãr bisar niyaiwala, kiyollahoile ãi ãttu ziyan goitto mone hor, hen no sai, kintu hibaye zendilla sar, ze ãre defeṛaiye.</char><verse eid="JHN 5:30"/></para>
  <para style="s">Isar babute goba</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31"/>
    <char style="wj">"Ãi nize zodi ãr babute goba di, ãr goba soiyi no.</char> <verse eid="JHN 5:31"/><verse number="32" style="v" sid="JHN 5:32"/><char style="wj">Kintu ar ekzon ase ze ãr babute goba der, ar ãi zani ze hibaye ãr babute ze goba der hiyan soiyi.</char><verse eid="JHN 5:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 5:33"/>
    <char style="wj">"Tũwara Yahyar hãse manuš defeṛaila, ar hibaye soiyir foikka goba diye.</char> <verse eid="JHN 5:33"/><verse number="34" style="v" sid="JHN 5:34"/><char style="wj">Manuše ãr gobar dok ãi hiyan saide no; kintu ãi iyan hoir zene tũwara uddar fo.</char> <verse eid="JHN 5:34"/><verse number="35" style="v" sid="JHN 5:35"/><char style="wj">Yahya aššil he zoledde edde ujjol serag, ar tũwara hibar he fohorot hoto dinolla anondo goribolla issa goijjila.</char><verse eid="JHN 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 5:36"/>
    <char style="wj">"Kintu ãttu Yahyar gobattuwaro aro mohan goba ase, kiyollahoile Bafe ãre ze ham okkol gori šeš goribolla diye, ze ham okkol ãi gorir, in okkole ãr babute endilla goba der ze ãre Bafe defeṛaiye.</char> <verse eid="JHN 5:36"/><verse number="37" style="v" sid="JHN 5:37"/><char style="wj">Ar Baf, ze ãre defeṛaiye, hibaye nize ãr babute goba diye. Tũwara honodin hibar abaz no funo, hibar rohom o no deko.</char> <verse eid="JHN 5:37"/><verse number="38" style="v" sid="JHN 5:38"/><char style="wj">Ar tũwarar dilot hibar kalam o bošoti no gorer, kiyollahoile hibaye defeṛaiyede hibare tũwara biššaš no goro.</char> <verse eid="JHN 5:38"/><verse number="39" style="v" sid="JHN 5:39"/><char style="wj">Tũwara pak kitabor kalam tuwo, kiyollahoile akeri zibon heṛe butore faiba boli mone goro. Kintu ei pak kitabor kalam okkol oilde hin zine ãr babute goba de,</char> <verse eid="JHN 5:39"/><verse number="40" style="v" sid="JHN 5:40"/><char style="wj">tarfore o tũwara zibon faibolla ãr hase aito issa no goro.</char><verse eid="JHN 5:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41"/>
    <char style="wj">"Ãi manušor hãsottu tarif no gosi,</char> <verse eid="JHN 5:41"/><verse number="42" style="v" sid="JHN 5:42"/><char style="wj">kintu ãi tũwarare sini, tũwarar dilot Allar ador nai.</char> <verse eid="JHN 5:42"/><verse number="43" style="v" sid="JHN 5:43"/><char style="wj">Ãi ãr Bafor namot aišši, ar tũwara ãre no gosor; kintu oinno kiye zodi hitar nizor name aiye, hitare tũwara gosiba.</char> <verse eid="JHN 5:43"/><verse number="44" style="v" sid="JHN 5:44"/><char style="wj">Tũwara kengori biššaš gori faro? Tũwara ekzone ar ekzonottu tarif goso, kintu ze tarif šude Allar torfottu aiye hiyan no tuwo.</char><verse eid="JHN 5:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 5:45"/>
    <char style="wj">"Mone no goijjo ze, tũwarare ãi Bafor sarme duši banaiyum; kintu tũwarar duši goroya oilde Musa, zar uwore tũwarar aša raikko.</char> <verse eid="JHN 5:45"/><verse number="46" style="v" sid="JHN 5:46"/><char style="wj">Kiyollahoile tũwara zodi Musare biššaš gorita, toile tũwara ãre biššaš gorita, kiyollahoile hibaye ãre babute leikke.</char> <verse eid="JHN 5:46"/><verse number="47" style="v" sid="JHN 5:47"/><char style="wj">Kintu tũwara zodi hibar leka biššaš no goro, toile ãi hoidde hin kengori biššaš goriba?" </char><verse eid="JHN 5:47"/></para>
  <chapter eid="JHN 5"/>
  <chapter number="6" style="c" sid="JHN 6"/>
  <para style="s">Isaye fãs hazarore hána hábaiye</para>
  <para style="r">(<ref loc="MAT 14:13-21">Moti 14:13–21</ref>; <ref loc="MRK 6:30-44">Mark 6:30–44</ref>; <ref loc="LUK 9:10-17">Luk 9:10–17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1"/>Iyar bade Isaye Galil doriyar dusora farot giye, (ziyanore Ṭaiberiya doriya o ho.) <verse eid="JHN 6:1"/><verse number="2" style="v" sid="JHN 6:2"/>Ar ek beši ḍõr mainšor dole hibar fise fise giye, kiyollahoile hibaye biyaraimma okkolore aram goijjilde he keramot okkol hitara dekkil. <verse eid="JHN 6:2"/><verse number="3" style="v" sid="JHN 6:3"/>Tarfore Isaye ek faharor uwore giye edde heṛe hibaye hibar sahabi okkolore loi boišše. <verse eid="JHN 6:3"/><verse number="4" style="v" sid="JHN 6:4"/>Hẽtte Ihudi uddar id hãse aššil.<verse eid="JHN 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 6:5"/>Toi Isaye hibar suk tuille ek ḍõr mainšor dol hibar mikka aiyedde dekiyore, hibaye Filipore hodde, <char style="wj">"Itara háibolla ãra ruṭi hontu kiniyum?" </char> <verse eid="JHN 6:5"/><verse number="6" style="v" sid="JHN 6:6"/>Hibaye hitare ei hotagan šude forikka goribolla hoiye, kiyollahoile hibaye ki goribo hiyan hibaye agottu loti zanito.<verse eid="JHN 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7"/>Filipe hibare zuwabe hodde, "Hitarar fotti ekzone ek ṭukura gori faibolla dui šot dinaror ruṭiye o no kulaibo!"<verse eid="JHN 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8"/>Hibar sahabi okkol butore ekzon, Andreas, Simon Fitoror bái, hite hibare hodde, <verse eid="JHN 6:8"/><verse number="9" style="v" sid="JHN 6:9"/>"Eṛe ek gura fuwattu fãswa buṭkar aṭar ruṭi edde duwa mas ase, kintu edun mainšore hin diyore ki oibo?"<verse eid="JHN 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10"/>Isaye hodde, <char style="wj">"Mainšore buwagorai do." </char> He zagaganot beši ker aššil, manuš okkol heṛe uwore boišše. (Onumanik fãs hazar furuš manuš heṛe aššil.) <verse eid="JHN 6:10"/><verse number="11" style="v" sid="JHN 6:11"/>Tarfore Isaye he ruṭigun loi Allare šukuriya zanaiye edde zara boišše hitara ze zedun saiye hitare hedun hedun bag gori diye. Hibaye mas o hen gori bag gori diye.<verse eid="JHN 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 6:12"/>Toi hitara beggune feṭ bori hái bade hibaye sahabi okkolore hodde, <char style="wj">"Ze ṭuragun basi roiye hin beggun ekku fũwati dola goro, zene kissu nošto oi no zagoi."</char> <verse eid="JHN 6:12"/><verse number="13" style="v" sid="JHN 6:13"/>Toi hitara hen goijje, hána hái bade ze he fãswa ruṭittu ṭura basi aššil hinore hitara dola gori baro barang oiye.<verse eid="JHN 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14"/>Isar ei keramoti ham deki mainše howahoi šuru goijje, "Iba oilde he nobi ze duniyait aiyer." <verse eid="JHN 6:14"/><verse number="15" style="v" sid="JHN 6:15"/>Isaye buzi faijje ze hitara aibo edde hitara hibare raza banaibolla zur goribo; hetolla hiba hentu šoṛi zaigoiyore ekela abar faharot giyegoi.<verse eid="JHN 6:15"/></para>
  <para style="s">Isaye fanir uwottu ãiṭṭe</para>
  <para style="r">(<ref loc="MAT 14:22-27">Moti 14:22–27</ref>; <ref loc="MRK 6:45-52">Mark 6:45–52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16"/>Toi hazinna zehon oiye, sahabi okkol lamat doriyar hãsat giye, <verse eid="JHN 6:16"/><verse number="17" style="v" sid="JHN 6:17"/>edde ekkan not uiṭṭe edde Kofornahumor mikka baisa diye. Ar hẽtte andar aiššil edde ehon o Isaye hitara loi ottor no o. <verse eid="JHN 6:17"/><verse number="18" style="v" sid="JHN 6:18"/>Heṛe beši zure bataš bonor zoriya fani beši utaltal oiye. <verse eid="JHN 6:18"/><verse number="19" style="v" sid="JHN 6:19"/>Hitara zẽtte tin sair mail no solai giye, bade dekedde Isaye fanir uwottu ãṛiyore hitarar mikka agguwai aiyer. Ar hitara beši ḍoraiye. <verse eid="JHN 6:19"/><verse number="20" style="v" sid="JHN 6:20"/>Kintu Isaye hitarare hodde, <char style="wj">"Iba ãi, no ḍoraiyo." </char> <verse eid="JHN 6:20"/><verse number="21" style="v" sid="JHN 6:21"/>Hitara hibare not tuli loito saiye, edde hehon nogan hitara zeṛe zat aššil he zagar kulot fõissegoi.<verse eid="JHN 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22"/>Tarfordin, ze manuš okkol doriyar oinno farot tiyai aššil, hitara deikke ze, heṛe ekkan bade ar hono no nu aššil, ar ze hibar sahabi okkol ziyanot uiṭṭe, Isaye hibar sahabi okkolor fũwati no hiyanot no uṛe, kintu hitara ekela gilgoi. <verse eid="JHN 6:22"/><verse number="23" style="v" sid="JHN 6:23"/>Ar Ṭaiberiyattu ho ekkan no, zeṛe Malike šukuriya zanai bade mainše ruṭi háil, he zagar ḍake aišše. <verse eid="JHN 6:23"/><verse number="24" style="v" sid="JHN 6:24"/>Mainšor dol okkole zehon dekilo ze Isa otóba hibar sahabi okkol kiye heṛe nai, hetunot hitara nogunot uiṭṭe edde Isare tuwaibolla Kofornahumot giye.<verse eid="JHN 6:24"/></para>
  <para style="s">Isa he zibonor ruṭi</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25"/>Ar hitara hibare doriyar ofarot faiyore, hitara hibare hodde, "Rabbi, õne eṛe hõtte aiššo?"<verse eid="JHN 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26"/>Isaye hitarare zuwab diye edde hodde, <char style="wj">"Ãi tũwarare soiyi hoir, tũwara sinnor ham deikko boli tũwara ãre tuwodde no, bolke feṭ bori ruṭi hái faijjo boli.</char> <verse eid="JHN 6:26"/><verse number="27" style="v" sid="JHN 6:27"/><char style="wj">Nošto oi zaiboide hánalla ham no goijjo, bolke hána zin akeri zibon foijjonto takibo, zin Adomor Fute tũwarare dibo, hinolla goro. Kiyollahoile he Baf Allah nize hibar uwore sil maijje." </char><verse eid="JHN 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28"/>Henot hitara hibare fusar goredde, "Henoile ãra Allar ham okkol goribolla ãrattu ki gora foribo?"<verse eid="JHN 6:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29"/>Isaye hitarare zuwabe hodde, <char style="wj">"Allar ham oilde in: hibar uwore biššaš ano, zare Allaye defeṛaiye."</char><verse eid="JHN 6:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30"/>Toi hitara hibare hodde, "Õne ki en sinno goror, zin dekiyore ãra õnore biššaš gori faijjum? Õne en ki ham goriba de? <verse eid="JHN 6:30"/><verse number="31" style="v" sid="JHN 6:31"/>Ãrar bafdada okkole bošoti sara elehat manna háil, zendilla leka ase: 'Hibaye hitarare behostottu háibolla ruṭi diye.'"<verse eid="JHN 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32"/>Isaye hitarare hodde, <char style="wj">"Ãi tũwarare soiyi soiyi hoir, tũwarare ruṭi behostottu Musaye diyede no, kintu ãr Bafe tũwarare behostottu he soiyi ruṭi de.</char> <verse eid="JHN 6:32"/><verse number="33" style="v" sid="JHN 6:33"/><char style="wj">Kiyollahoile Allar ruṭi oilde hiba ze ruṭi behostottu nise lami aiye edde duniyaire zibon de."</char><verse eid="JHN 6:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34"/>Hitara hodde, "Malik, ei ruṭi ãrare hamiša do."<verse eid="JHN 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35"/>Isaye hitarare hodde, <char style="wj">"Ãi oilamde he zibon ruṭi; hite ze ãr hãse aiye, hitattu buka no lagibo, ar hite ze ãre uwore biššaš ane, hite tiraši no oibo, hono dinolla.</char> <verse eid="JHN 6:35"/><verse number="36" style="v" sid="JHN 6:36"/><char style="wj">Kintu ãi tũwarare hoiyi, tũwara ãre deikko, ar ehon o biššaš no goror.</char> <verse eid="JHN 6:36"/><verse number="37" style="v" sid="JHN 6:37"/><char style="wj">Bafe zarare ãre diye, hitara beggun ãr hãse aibo, ar hite ze ãr hãse aiye, hitare ãi honodin baire felai no diyum.</char> <verse eid="JHN 6:37"/><verse number="38" style="v" sid="JHN 6:38"/><char style="wj">Kiyollahoile ãi behostottu ãr issa mozin ham goribolla lami aiššide no, bolke hibar issa furon goribolla, ze ãre defeṛaiye. </char> <verse eid="JHN 6:38"/><verse number="39" style="v" sid="JHN 6:39"/><char style="wj">Ar ze ãre defeṛaiye, hibar issa oilde iyan ze, hibaye beggun zarare ãre diye, hentu ekzon o zene ãi no harai, bolke šešor dinot hitarare uwafes tuli. </char> <verse eid="JHN 6:39"/><verse number="40" style="v" sid="JHN 6:40"/><char style="wj">Ar ãr Bafor issa oilde iyan ze, fotti ekzon ze Futore sa edde hibar uwore biššaš ane, hite akeri zibon fa; ar ãi hitarare šešor dinot uwafes tuliyum."</char><verse eid="JHN 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41"/>Henot Ihudi okkole hibar berudde monmona šuru goijje, kiyollahoile hibaye hoil, <char style="wj">"Ãi he ruṭi ze behostottu nise lami aišši."</char> <verse eid="JHN 6:41"/><verse number="42" style="v" sid="JHN 6:42"/>Hitara hodde, "Iba ki Yusufor fut, Isa no ne? Zar baf mare ãra sini? Ite kengori endilla hoi fare, <char style="wj">'ãi behostottu nise lami aišši'</char>?"<verse eid="JHN 6:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43"/>Isaye zuwabe hodde, <char style="wj">"Tũwara ekzon loi ar ekzone monmonani bon goro;</char> <verse eid="JHN 6:43"/><verse number="44" style="v" sid="JHN 6:44"/><char style="wj">Ãr Baf, ze ãre defeṛaiye, hibaye ṭani nu anile honokiye ãr hãse ai no fare, ar ãi hitare šešor dinot uwafes tuliyum.</char> <verse eid="JHN 6:44"/><verse number="45" style="v" sid="JHN 6:45"/><char style="wj">Nobi okkolor kitabot leka ase: 'Hitara beggune Allar duwara šikka faibo.' Fottikiye ze Bafore funer edde hibattu šikka fa, hite ãr hãse aiyer.</char> <verse eid="JHN 6:45"/><verse number="46" style="v" sid="JHN 6:46"/><char style="wj">Endilla no ze Bafore honokiye deke, hiba ze Allar hãsottu aišše, šude hibaye deikke Bafore. </char> <verse eid="JHN 6:46"/><verse number="47" style="v" sid="JHN 6:47"/><char style="wj">Ãi tũwarare soiyi soiyi hoir, hite ze ãr uwore biššaš ane hitattu akeri zibon ase. </char> <verse eid="JHN 6:47"/><verse number="48" style="v" sid="JHN 6:48"/><char style="wj">Ãi oilamde he zibonor ruṭi.</char> <verse eid="JHN 6:48"/><verse number="49" style="v" sid="JHN 6:49"/><char style="wj">Tũwarar bafdada okkole bošoti sara elehat manna háil, ar hitara morigiyegoi.</char> <verse eid="JHN 6:49"/><verse number="50" style="v" sid="JHN 6:50"/><char style="wj">Iba oilde he ruṭi ziba behostottu nise lami aišše, zene ze honokiye hibattu há, edde no morer.</char> <verse eid="JHN 6:50"/><verse number="51" style="v" sid="JHN 6:51"/><char style="wj">Ãi oilamde he zinda ruṭi, ziba behostottu lami aišše. Hite ze ei ruṭi há, hite sirohalolla basibo. Ar ze ruṭi ãi diyum hiyan oilde ãr ga, ziyan ãi diyum duniyair zibonolla."</char><verse eid="JHN 6:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52"/>Ei hota funiyore Ihudi okkol ekzone ar ekzon loi doromoro barabari gori howa šuru goijje, "Ite kengori ãrare hitar ga haito di fare?"<verse eid="JHN 6:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53"/>Isaye hitarare hodde, <char style="wj">"Ãi tũwarare soiyi soiyi hoir, Adomor Futor gusto zodi no ho, ar zodi no fiyo hibar lou, toile tũwarar butore zibon nai.</char> <verse eid="JHN 6:53"/><verse number="54" style="v" sid="JHN 6:54"/><char style="wj">Hite ze ãr gusto edde lou há hitattu akeri zibon ase, ar ãi šeš dinot hitare uwafes tuliyum.</char> <verse eid="JHN 6:54"/><verse number="55" style="v" sid="JHN 6:55"/><char style="wj">Ãr gusto oilde asol hána, ãr lou oilde asol fibar ziniš.</char> <verse eid="JHN 6:55"/><verse number="56" style="v" sid="JHN 6:56"/><char style="wj">Hite ze ãr gusto edde lou há, hite ãr butore take ar ãi o hitar butore taki.</char> <verse eid="JHN 6:56"/><verse number="57" style="v" sid="JHN 6:57"/><char style="wj">Zendilla zinda Bafe ãre defeṛaiye ar hibar duwara zinda asi, ṭik hendilla ze ãre há hite o ãr duwara zinda takibo.</char> <verse eid="JHN 6:57"/><verse number="58" style="v" sid="JHN 6:58"/><char style="wj">Iba oilde he ruṭi ze behostottu nise lami aišše. Tũwarar bafdada okkole manna háil edde morigiyegoi, kintu ze honokiye ei ruṭi háibo hite sirohalolla basibo."</char> <verse eid="JHN 6:58"/><verse number="59" style="v" sid="JHN 6:59"/>In okkol hibaye Kofornahumor sinagogot šikka dedde šomot hoil.<verse eid="JHN 6:59"/></para>
  <para style="s">Bout kiye Isar šikkat monmonaiye</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60"/>Hibar sahabi okkolor butore boute ei hota funiyore hodde, "In beši koṭin šikka. Hone inore gosi faribo?"<verse eid="JHN 6:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61"/>Hibar sahabi okkole ei babute monmonar, hiyan Isaye buzi fariyore hitarare hodde, <char style="wj">"Iyanor zoriya ki tũwara forizorgoi? </char> <verse eid="JHN 6:61"/><verse number="62" style="v" sid="JHN 6:62"/><char style="wj">Hetunot tũwara ki bafiba Adomor Fut age zeṛe aššil heṛe uṛi zargoide dekile? </char> <verse eid="JHN 6:62"/><verse number="63" style="v" sid="JHN 6:63"/><char style="wj">Ruhuye zibon de; gustoye hono kissu faida no de, ze hota okkol ãi tũwarare hoilam, hin oilde Ruh edde zibon. </char> <verse eid="JHN 6:63"/><verse number="64" style="v" sid="JHN 6:64"/><char style="wj">Tarfore o tũwarar butore en hozon ase, zara biššaš no gore."</char> Kiyollahoile Isaye šuruttu loti zanito, hitara hontara zara hibare biššaš goribo, ar hite honnuwa ze hibar loi beimani goribo. <verse eid="JHN 6:64"/><verse number="65" style="v" sid="JHN 6:65"/>Ar hibaye hodde, <char style="wj">"Etolla ãi tũwarare hoilam, zodi ãr Bafor torfottu kemota diya no o, toile honokiye ãr hãse ai no fare." </char><verse eid="JHN 6:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66"/>Iyar bade hibar bout sahabi okkol uwafes firi giyegoi edde hibar loi ar sola fira no gore.<verse eid="JHN 6:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="JHN 6:67"/>Toi Isaye he barozonore fusar goijje, <char style="wj">"Tũwara o ki uwafes firi zaibolla issa goror?" </char><verse eid="JHN 6:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68"/>Simon Fitore zuwabe hodde, "Malik, ãra har hãse zaiyum? Akeri zibonor kalam to õnor hãse ase. <verse eid="JHN 6:68"/><verse number="69" style="v" sid="JHN 6:69"/>Ãra biššaš goijji, ãra zani ze, õne Allar he Pakzon."<verse eid="JHN 6:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70"/>Toi Isaye hitarare hodde, <char style="wj">"Ãi ki tũwara barozonore basi no loi ne? Zodi o tũwarar butore ekzon šoitan."</char> <verse eid="JHN 6:70"/><verse number="71" style="v" sid="JHN 6:71"/>(Ei hota hibaye Iskariyoti Simonor fut Ehudar babute hoiyede, kiyollahoile hite, he barozonor butore ekzon oi bade o, hiba loi beimani goribo.)<verse eid="JHN 6:71"/></para>
  <chapter eid="JHN 6"/>
  <chapter number="7" style="c" sid="JHN 7"/>
  <para style="s">Isa edde hibar báiyain okkol</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1"/>In okkol bade, Isa Galilot gurafira gorer. Hiba Ehudiyat zaito no sa, kiyollahoile Ihudi neta okkole hibare marifelaibar kušišot aššil.<verse eid="JHN 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 7:2"/>Ar hẽtte Ihudi bãša id (ziyanore Sukkut ho) hãsa hãsi aššil, <verse eid="JHN 7:2"/><verse number="3" style="v" sid="JHN 7:3"/>Isar báiyainde hibare hodde, "Enttu Ehudiyat zagoi, toi zene tui gorodde he ham okkol tor sahabi okkole deki fare. <verse eid="JHN 7:3"/><verse number="4" style="v" sid="JHN 7:4"/>Kiyollahoile ze nize mainšor muntu forhaš oito sa, hite gufone hono kissu no gore. Tui zehon in okkol goror, nizore duniyair sarme forhaš gor." <verse eid="JHN 7:4"/><verse number="5" style="v" sid="JHN 7:5"/>Kiyollahoile hibar nizor báiyainde o hibare biššaš no gorito.<verse eid="JHN 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6"/>Henot Isaye hitarare hodde, <char style="wj">"Ãr ṭaim ehono nu aiye, kintu tũwarar ṭaim hamiša hazir. </char> <verse eid="JHN 7:6"/><verse number="7" style="v" sid="JHN 7:7"/><char style="wj">Duniyaiye tũwarare hingša gori no fare, kintu hiyane ãre hingša gore, kiyollahoile ãi hiyanor babute goba di ze hiyanor ham horaf. </char> <verse eid="JHN 7:7"/><verse number="8" style="v" sid="JHN 7:8"/><char style="wj">Idot tũwara zo; ãi ehon no zaiyum, kiyollahoile ãr ṭaim ehono furon no o." </char> <verse eid="JHN 7:8"/><verse number="9" style="v" sid="JHN 7:9"/>Hibaye hitarare in okkol hoiyore hiba Galilot taigiyegoi.<verse eid="JHN 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10"/>Kintu hibar báiyain okkol uwore idot giyegoi, bade hiba nize o heṛe giye, tarfore o kulasa bafe no, gufone. <verse eid="JHN 7:10"/><verse number="11" style="v" sid="JHN 7:11"/>Idot Ihudi neta okkole Isare tuwail, ar hodde, "Hite hoṛe?"<verse eid="JHN 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12"/>Ar heṛe mainšor dolor butore hibar babute bout monmonani šuru oiye, kissuye hodde: "Hiba bala."</para>
  <para style="p" vid="JHN 7:12">Ar kiye hor, "No, hite mainšore bul fõtot loizargoi." <verse eid="JHN 7:12"/><verse number="13" style="v" sid="JHN 7:13"/>Kintu Ihudi neta okkolor ḍore honokiye hibar babute kulasa bafe kissu no ho.<verse eid="JHN 7:13"/></para>
  <para style="s">Idot Isar šikka</para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14"/>Id ada adi oiyede ṭaimot Isa uwore dormogórot giye, edde šikka diya šuru goijje. <verse eid="JHN 7:14"/><verse number="15" style="v" sid="JHN 7:15"/>Henot Ihudi neta okkol tajjuf oiyore hodde, "Hono šikka no gori kengori ite endilla giyan zane?"<verse eid="JHN 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16"/>Isaye hitarare zuwabe hodde, <char style="wj">"Ãr šikka ãr nizor no, kintu ze ãre defeṛaiye, hibar.</char> <verse eid="JHN 7:16"/><verse number="17" style="v" sid="JHN 7:17"/><char style="wj">Ze honokiye hibar issa falon goribolla issa gore, hite ei šikkar babute zanibo, iyan Allattu or ne naki ãi nizottu hoi.</char> <verse eid="JHN 7:17"/><verse number="18" style="v" sid="JHN 7:18"/><char style="wj">Hite ze nizottu ho hite hitar nizor tarif tuwa, kintu hite ze defeṛaiyede hibar tarif tuwa, toile hite soiyi, na soiyi hitar butore nai.</char> <verse eid="JHN 7:18"/><verse number="19" style="v" sid="JHN 7:19"/><char style="wj">Musaye ki tũwarare ain no de ne? To tũwarar honokiye he ain falon no gore; tũwara ãre kiyolla marifelaito sor?"</char><verse eid="JHN 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20"/>Manuš okkole zuwabe hodde, "Tore bute faiye, tore marifelaito hone sar?"<verse eid="JHN 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21"/>Isaye zuwabe hitarare hodde, <char style="wj">"Ãi ekkan ham goijji, ar tũwara beggune ammuwak oiyo.</char> <verse eid="JHN 7:21"/><verse number="22" style="v" sid="JHN 7:22"/><char style="wj">Ar Musaye tũwarare azomi goraibar niyom dil, (zodi o ei niyom asole Musar hãsottu nu aiye, bafdada okkolottu aišše), ar tũwara Šabbator din o azomi goro.</char> <verse eid="JHN 7:22"/><verse number="23" style="v" sid="JHN 7:23"/><char style="wj">Musar ain banga no ofan zodi Šabbator dinot ekzonore azomi gora za, toile Šabbatot ãi ekzon manušore furafuri aram goijjide hiyanolla kiyolla tũwara ãr uwore rag goror? </char> <verse eid="JHN 7:23"/><verse number="24" style="v" sid="JHN 7:24"/><char style="wj">Tũwara dekodde mozin bisar no goijjo, bolke niyai bisar goro." </char><verse eid="JHN 7:24"/></para>
  <para style="s">Zinda fani</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25"/>Hetunot hodun Zeruzalemor mainše hodde, "Manuš iba hiba no ne, zare hitara marifelaibolla tuwar?" <verse eid="JHN 7:25"/><verse number="26" style="v" sid="JHN 7:26"/>Kintu so, ite eṛe kulasa bafe hota hor, ar honokiye hitar berudde kissu no hor; toile šašon goroya okkole ki soiyi zani faijje ze iba Messiyah?" <verse eid="JHN 7:26"/><verse number="27" style="v" sid="JHN 7:27"/>Kintu ite hontu hiyan to ãra zani, ar Messiyah zẽtte aibo, hiba hontu honokiye no zanibo."<verse eid="JHN 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28"/>Tarfore Isaye dórmogóror uṛanot šikka dedde šomot guzori hodde,<char style="wj">"Oi, tũwara ãre zano, ar ãi hontu iyano zano; ãi ãr nizottu nu aiyi, kintu ãre defeṛaiyede hiba soiyi, zare tũwara no zano,</char> <verse eid="JHN 7:28"/><verse number="29" style="v" sid="JHN 7:29"/><char style="wj">ãi hibare zani, kiyollahoile ãi hibar hentu aišši, ar ãre hibaye defeṛaiye."</char><verse eid="JHN 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30"/>Henot hitara Isare doitto saiye, kintu honokiye hibar gat hat no de, kiyollahoile hibar ṭaim ehon o nu aiye. <verse eid="JHN 7:30"/><verse number="31" style="v" sid="JHN 7:31"/>Ehono, mainšor dolor butottu bout kiye hibar uwore biššaš ainne edde hodde, "Messiyah zẽtte aibo, hibaye ki ei manuššuwaye goijjede hinottuwaro beši sinno gori dehaibo?"<verse eid="JHN 7:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32"/>Foroši okkole hibar babute in okkol loi monmonadde fuinne; ar ḍõr imam okkole edde Foroši okkole hibare dori anibolla hoekzon dórmogóror faharadarore defeṛaiye.<verse eid="JHN 7:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 7:33"/>Toi Isaye hodde, <char style="wj">"Ehon o ãi olfo dinolla tũwarar fũwati asi, tarfore ze ãre defeṛaiye ãi hibar hãse zaiyumboi.</char> <verse eid="JHN 7:33"/><verse number="34" style="v" sid="JHN 7:34"/><char style="wj">Tũwara ãre tuwaiba, kintu ãre no faiba; ar ãi zeṛe, heṛe tũwara ai no fariba." </char><verse eid="JHN 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35"/>Henot Ihudi okkole ekzonore ekzone hodde, "Iba hoṛe zaibo ze, ãra hibare tuwai no faiyum? Hiba hono ãrar Ihudi okkol zara Girikiyo okkolor fũwati šiṛašitta oi asede heṛe zaibo, edde Girikiyo okkolore šikka dibogoi? <verse eid="JHN 7:35"/><verse number="36" style="v" sid="JHN 7:36"/>Hibaye, <char style="wj">'Tũwara ãre tuwaiba, kintu tũwara ãre tuwai no faiba, ar ãi zeṛe, heṛe tũwara ai no fariba.'</char> hoi ki hoito sadde?"<verse eid="JHN 7:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37"/>Idor šeše, ze din idor asol boro din, Isaye tiyaiyore guzori hodde, <char style="wj">"Ze honokiye tiraši, hite ãr hãse aiyok edde fiyok.</char> <verse eid="JHN 7:37"/><verse number="38" style="v" sid="JHN 7:38"/><char style="wj">Hite ze ãr uwore biššaš ane, kitabor leka mozin, hitar dilot zinda halor fani baibo."</char> <verse eid="JHN 7:38"/><verse number="39" style="v" sid="JHN 7:39"/>Ei hota hibaye Pak Ruhur babute hoiye, hitara zara hibare biššaš goijje, hitara faibo, ze Pak Ruhure ehono diya no o, kiyollahoile hẽtte o Isare mohimaola gora no o.<verse eid="JHN 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40"/>Hibar hota okkol funiyore dolor butottu kiye kiye hodde, "Soiyi iba he nobi."<verse eid="JHN 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41"/>Ar kiye hodde, "Iba Messiyah"</para>
  <para style="p" vid="JHN 7:41">Kintu kiye kiye hodde, "Galilottu kengori Messiyah aibo? <verse eid="JHN 7:41"/><verse number="42" style="v" sid="JHN 7:42"/>Kalame ki no ho ne ze Messiyah Daudor bongšottu edde ze šohorot Daud aššil, he Betlehemottu aibo?" <verse eid="JHN 7:42"/><verse number="43" style="v" sid="JHN 7:43"/>Endilla gori hibare loi manuš okkolor butore bag oigiyegoi. <verse eid="JHN 7:43"/><verse number="44" style="v" sid="JHN 7:44"/>Ar hitarar butottu hodune hibare dorito saiye, kintu honokiye hibar gat hat no de.<verse eid="JHN 7:44"/></para>
  <para style="s">Ihudi neta okkolor obiššaš</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45"/>Toi dormogór faharadar okkol uwafes ḍõr imam edde Foroši okkolor hãse aišše, toi hitara hitarare hodde, "Hitare tũwara nu ano kiyolla?"<verse eid="JHN 7:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46"/>Dormogór faharadar okkole zuwabe hodde, "Hibar ḍoilla endilla hota ar honokiye honodin no ho."<verse eid="JHN 7:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47"/>Henot Foroši okkole hodde, "Tũwarare o ki kufõtot loigiyegoi neki? <verse eid="JHN 7:47"/><verse number="48" style="v" sid="JHN 7:48"/>Šašon goroya okkol otóba Foroši okkolor butottu honokiye hitar uwore biššaš ainne ne, hono? <verse eid="JHN 7:48"/><verse number="49" style="v" sid="JHN 7:49"/>Kintu ei manušor dole Musar ain no zane, itarar uwore bodduwa ase."<verse eid="JHN 7:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50"/>Nikoḍomas, Foroši okkolor butore ekzon ze age Isar hãse aiššil, hibaye hitarare hodde, <verse eid="JHN 7:50"/><verse number="51" style="v" sid="JHN 7:51"/>"Age, hono ekzon manuš hitar nizor hota no funiyore edde hite ki gore hiyan no zaniyore ki ãrar aine bisar gore?"<verse eid="JHN 7:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52"/>Hitara zuwabe hodde, "Tũi o hono Galilor ne? Pak kitabot tuwai so, toi dekiba ze Galilottu hono nobi nu aibo."<verse eid="JHN 7:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 7:53"/>
    <char style="it">Toi hitara beggune ze zar zar górot giyegoi,</char><verse eid="JHN 7:53"/></para>
  <chapter eid="JHN 7"/>
  <chapter number="8" style="c" sid="JHN 8"/>
  <para style="nb">
    <verse number="1" style="v" sid="JHN 8:1"/>
    <char style="it">kintu Isa zaitun faharot giyegoi.</char><verse eid="JHN 8:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 8:2"/>
    <char style="it">Taforor din binna sore Isa abar dórmogóror uṛanot giye, zeṛe hár manuš okkol hibar sairo ḍakottu aišše. Ar hiba boiyore hitarare šikka diye.</char> <verse eid="JHN 8:2"/><verse number="3" style="v" sid="JHN 8:3"/><char style="it">Toi alem okkole edde Foroši okkole ekzon zenat dora háiyede mayafuware ainne edde hibare maze tiya goraiyore</char> <verse eid="JHN 8:3"/><verse number="4" style="v" sid="JHN 8:4"/><char style="it">edde hodde, "Ustad, ei mayafuware zenar hamot dora háiye.</char> <verse eid="JHN 8:4"/><verse number="5" style="v" sid="JHN 8:5"/><char style="it">Torar ainot Musaye endilla mayafuwaindore fattor maribolla ãrare hokum diye; kintu õne ki ho?" </char> <verse eid="JHN 8:5"/><verse number="6" style="v" sid="JHN 8:6"/><char style="it">Hitara hibare forikka goribolla iyan hoiye, zene hitara hibare hosuri dibolla ekkan muda tuwai fa.</char></para>
  <para style="p" vid="JHN 8:6">
    <char style="it">Kintu Isaye nise niyuriyore õl diyore meṛit leka šuru goijje.</char><verse eid="JHN 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 8:7"/>
    <char style="it">Hitara zehon fusar gorat roiye, hiba uzu oiyore hitarare hodde, <char style="wj">"Tũwarar butore guna sarawaye hibare foila fattorguwa marok."</char> </char> <verse eid="JHN 8:7"/><verse number="8" style="v" sid="JHN 8:8"/><char style="it">Toi hiba abar nise niyuriyore meṛit leka doijje.</char><verse eid="JHN 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 8:9"/>
    <char style="it">Toi hitara iyan funiyore ekzon ekzon, murubbi okkol loti šuru gori, giyegoi, šude Isa roigiyegoi, edde mayafuwawa hibar sarme tiyai aššil.</char> <verse eid="JHN 8:9"/><verse number="10" style="v" sid="JHN 8:10"/><char style="it">Isaye abar uzu oiyore he mayafuwaware hodde, <char style="wj">"Mayafuwa, hitara hoṛe? Honokiye ki tore šasti no de?"</char> </char><verse eid="JHN 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11"/>
    <char style="it">Hibaye hodde, "Malik, hono kiye nai." </char></para>
  <para style="p" vid="JHN 8:11">Toi Isaye hodde, <char style="it"><char style="wj">"Henoile ãi o tore šasti no diyum; za ehon loti ar guna no goris."</char></char><verse eid="JHN 8:11"/></para>
  <para style="s">Isa, duniyair nur</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12"/>Isaye abar mainšor loi hota hoiye, hibaye hodde, <char style="wj">"Ãi duniyair nur; hite ze ãr fisa lo, hite andarot no ãṛibo, kintu hite zibonor nur faibo." </char><verse eid="JHN 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13"/>Foroši okkole hibare hodde, "Tui tor goba dor, tor goba soyi no."<verse eid="JHN 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14"/>Isaye zuwabe hitarare hodde, <char style="wj">"Zodi o ãi ãr goba nize, ãr goba soiyi; kiyollahoile ãi honttu aišši, ar hoṛe zair, ãi zani, kintu tũwara no zano ãi hontu aišši, ar hoṛe zair.</char> <verse eid="JHN 8:14"/><verse number="15" style="v" sid="JHN 8:15"/><char style="wj">Tũwara manušor ḍoilla bisar goro, kintu ãi honokiyor bisar no gori.</char> <verse eid="JHN 8:15"/><verse number="16" style="v" sid="JHN 8:16"/><char style="wj">Ar zodi o ãi bisar gori, ãr bisar soiyi, kiyollahoile ãi ekela no, kintu ãi ãr Bafor fũwati asi, ze ãre defeṛaiye.</char> <verse eid="JHN 8:16"/><verse number="17" style="v" sid="JHN 8:17"/><char style="wj">Ar tũwarar nizor ainot o iyan leka ase ze, duizon mainšor goba soiyi.</char> <verse eid="JHN 8:17"/><verse number="18" style="v" sid="JHN 8:18"/><char style="wj">Ãi ãr goba dir; ar ze Bafe ãre defeṛaiye, hibaye o ãr goba der." </char><verse eid="JHN 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19"/>Hitara hibare hodde, "Tor Baf hoṛe?"</para>
  <para style="p" vid="JHN 8:19">Isaye zuwabe hodde, <char style="wj">"Tũwara na ãre zano otóba ãr Bafore zano, zodi tũwara ãre zanita, toile tũwara ãr Bafore o zanita." </char> <verse eid="JHN 8:19"/><verse number="20" style="v" sid="JHN 8:20"/>Ei hota okkol hibaye dórmogóror uṛanot šikka dibar šomot dan bakšur ḍake hoiye. Ar hibare honokiye no dore, kiyollahoile hehon o hibar ṭaim nu aiye.<verse eid="JHN 8:20"/></para>
  <para style="s">Tũi honnuwa?</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21"/>Isaye hitarare abar hodde, <char style="wj">"Ãi zaiyumboi, ar tũwara ãre talaš goriba, kintu tũwara tũwarar gunat moriba. Ãi zeṛe zair tũwara heṛe ai no fariba."</char><verse eid="JHN 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22"/>Ihudi okkole hodde, "Hite ki nizor zan nize loibo, ar hetolla hor, <char style="wj">'Ãi zeṛe zaiyum tũwara heṛe ai no fariba.'</char>?"<verse eid="JHN 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23"/>Kintu Isaye hitarare hodde, <char style="wj">"Tũwara oilade nisottu, ãi oilamde uworottu. Tũwara ei duniyair kintu ãi ei duniyair no.</char> <verse eid="JHN 8:23"/><verse number="24" style="v" sid="JHN 8:24"/><char style="wj">Ãi tũwarare hoilam ze tũwara tũwarar guna okkolot moriba; kiyollahoile tũwara zodi biššaš no goro ze ãi oi hiba, tũwara hameka tũwarar guna okkolot moriba."</char><verse eid="JHN 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25"/>Hitara hodde, "Tui honnuwa?"</para>
  <para style="p" vid="JHN 8:25">Hibaye hitarare hodde, <char style="wj">"Hiyan ãi tũwarare šuruttu loti howat asi.</char><verse eid="JHN 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 8:26"/>
    <char style="wj">"Tũwarar babute hoibar edde bisar goribar ãttu beši kissu ase; kintu ze ãre defeṛaiye, hiba soiyi, ar ãi hibar hãsottu ziyan fuinni hiyan ãi duniyaire hoir." </char><verse eid="JHN 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27"/>Hibaye ze hibar nizor Bafor babute hor hiyan hitara buzi no fare. <verse eid="JHN 8:27"/><verse number="28" style="v" sid="JHN 8:28"/>Toi Isaye hitarare hodde, <char style="wj">"Tũwara zẽtte Adomor Futore uwore tuliba, hẽtte buzi fariba ze ãi oi hiba, ar ãi nizor torfottu hono kissu no gori, bolke Bafe ãre zendilla šikka diye hin okkol hoi.</char> <verse eid="JHN 8:28"/><verse number="29" style="v" sid="JHN 8:29"/><char style="wj">Ãre defeṛoya ãr fũwati ase, ãre eka eri no zagoi, kiyollahoile ãi hamiša hibar razir ham gori."</char> <verse eid="JHN 8:29"/><verse number="30" style="v" sid="JHN 8:30"/>Hibaye ei hota zehon hoiye, bout kiye hibar uwore biššaš ainne.<verse eid="JHN 8:30"/></para>
  <para style="s">Ibrahimor bongšo</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31"/>Isaye, Ihudi okkol zara hibar uwore biššaš ainne, hitarare hodde, <char style="wj">"Tũwara zodi ãr hotar butore tako, toile soiyi tũwara ãr biššaši.</char> <verse eid="JHN 8:31"/><verse number="32" style="v" sid="JHN 8:32"/><char style="wj">Toi tũwara soiyire zani fariba, ar he soiyiye tũwarare azadi dibo."</char><verse eid="JHN 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33"/>Hitara hibare hodde, "Ãra Ibrahimor bongšor manuš, ãra honodin honokiyor gulam no oi. Toile tũi kengori hoi faror ze, ãrare azadi diya oibo?"<verse eid="JHN 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34"/>Isaye hodde, <char style="wj">"Ãi tũwarare soiyi soiyi hoir, hite ze guna gore hite gunar gulam.</char> <verse eid="JHN 8:34"/><verse number="35" style="v" sid="JHN 8:35"/><char style="wj">Ar ek gulam hamišalla górot no take, kintu Fut hamišalla hiyanot take.</char> <verse eid="JHN 8:35"/><verse number="36" style="v" sid="JHN 8:36"/><char style="wj">Hetolla Fute zodi tũwarare azadi de, toile tũwara soiyi azad oiba.</char> <verse eid="JHN 8:36"/><verse number="37" style="v" sid="JHN 8:37"/><char style="wj">Ãi zani, tũwara Ibrahimor bongšor manuš, kintu tũwara ãre marifelaibolla kušišot aso, kiyollahoile tũwarar dilot ãr hotalla hono zaga nai.</char> <verse eid="JHN 8:37"/><verse number="38" style="v" sid="JHN 8:38"/><char style="wj">Ãi ãr Bafor hãse zin dekki he babute hoi, ar tũwara hin goro zin tũwara tũwarar bafottu fuinno." </char><verse eid="JHN 8:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39"/>Henot hitara zuwab diye, "Ãrar baf Ibrahim."</para>
  <para style="p" vid="JHN 8:39">Isaye hodde, <char style="wj">"Tũwara zodi Ibrahimor fuwain oita, toile tũwara Ibrahimor ham gorita.</char> <verse eid="JHN 8:39"/><verse number="40" style="v" sid="JHN 8:40"/><char style="wj">Kintu Allar hãsottu ze soiyi ãi funiyore tũwarare hoi boli tũwara ãre marifelaibolla kušiš goror. Ibrahime to endilla ham no gore.</char> <verse eid="JHN 8:40"/><verse number="41" style="v" sid="JHN 8:41"/><char style="wj">Tũwara tũwarar bafor ham goror." </char></para>
  <para style="p" vid="JHN 8:41">Hitara hibare hodde, "Ãra zoura fuwain no; ãrar ek Baf ase: hiba oilde Allah."<verse eid="JHN 8:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42"/>Isaye hitarare hodde, <char style="wj">"Allah zodi soiyi tũwarar Baf oito, toile tũwara ãre ador gorita, kiyollahoile ãi Allattu tũwarar eṛe aišši. Ãi nizottu nu aiyi; kintu hibaye ãre defeṛaiye.</char> <verse eid="JHN 8:42"/><verse number="43" style="v" sid="JHN 8:43"/><char style="wj">Tũwara ãr hota kiyolla no buzo? Haron oilde iyan ze tũwara ãr hota bordaš gori no faro.</char> <verse eid="JHN 8:43"/><verse number="44" style="v" sid="JHN 8:44"/><char style="wj">Tũwara tũwarar ek baf šoitanor, ar tũwara tũwarar bafor issa furon gora oilde tũwarar issa. Hite šuruttu loti ekzon kuni, soiyit no take, kiyollahoile hitar butore soiyi nai; hite zẽtte misa hota ho, hite hin hitar nizottu ho, kiyollahoile hite ek misa hoiya edde misa hota hoiyar baf.</char> <verse eid="JHN 8:44"/><verse number="45" style="v" sid="JHN 8:45"/><char style="wj">Kintu ãi soiyi hoi, ar hetolla tũwara ãre biššaš no goror.</char> <verse eid="JHN 8:45"/><verse number="46" style="v" sid="JHN 8:46"/><char style="wj">Tũwarar butottu ãre hone gunar hosurbon sabut gori fariba? Ar ãi zodi soiyi hoir, toile tũwara ãre biššaš kiya no goror? </char> <verse eid="JHN 8:46"/><verse number="47" style="v" sid="JHN 8:47"/><char style="wj">Hite ze Allar, hite Allar kalam fune. Ar tũwara no funor, kiyollahoile tũwara Allar no."</char><verse eid="JHN 8:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48"/>He Ihudi okkole hibare zuwabe hodde, "Ãra ki ṭik no hoir ne ze tui ekzon Sameriyo, ar tore bute faiye?"<verse eid="JHN 8:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49"/>Isaye hodde, <char style="wj">"Ãre bute no fa, kintu ãi ãr Bafore šorman gori, ar tũwara ãre ošormani goror.</char> <verse eid="JHN 8:49"/><verse number="50" style="v" sid="JHN 8:50"/><char style="wj">Ãi ãr nizor tarif no tuwair, kintu ekzon ase ze tuwa, ar hiba oilde bisarhar.</char> <verse eid="JHN 8:50"/><verse number="51" style="v" sid="JHN 8:51"/><char style="wj">Ãi tũwarare soiyi soiyi hoir, hite ze ãr kalam falon gore, hite honodin moron no dekibo."</char><verse eid="JHN 8:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52"/>Ihudi okkole zuwab diye, "Ehon, ãra zani farilam ze tore bute faiye; Ibrahim edde nobi okkol morigiyegoi; ar tui hor, hite ze ãr kalam falon gore hite honodin moron no dekibo. <verse eid="JHN 8:52"/><verse number="53" style="v" sid="JHN 8:53"/>Tui ki ãrar baf Ibrahim, ze morigiyegoi, hibattuwaro mohan? Ar nobi okkol o morigiyegoi. Tui nizore ki mone goros?"<verse eid="JHN 8:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54"/>Isaye zuwabe hodde, <char style="wj">"Ãi zodi nizor tarif nize gori, toile ãr tarif kissu no; ãr Bafe ãr tarif gorer, hiba zar babute tũwara ho, hiba ãrar Allah.</char> <verse eid="JHN 8:54"/><verse number="55" style="v" sid="JHN 8:55"/><char style="wj">Zodi o tũwarattu hibar zana nai, ar ãi zodi hoi ze ãi hibare no zani, toile tũwarar ḍoilla ãi o misa hoya oiyum; kintu ãi hibare zani edde hibar kalam falon gori.</char> <verse eid="JHN 8:55"/><verse number="56" style="v" sid="JHN 8:56"/><char style="wj">Tũwarar baf Ibrahime ãr din saibolla aša loi kuši goijjil; ar hibaye hiyan deikke edde kuši goijje." </char><verse eid="JHN 8:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57"/>Hitara hodde, "Tor umor ehono fõnzaš bosor no o, ar tui Ibrahimore deikkos!"<verse eid="JHN 8:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58"/>Isaye hitarare zuwab diye, <char style="wj">"Ãi tũwarare soiyi soiyi hoir, Ibrahim zormo oibar agottu loti, ãi oi!"</char> <verse eid="JHN 8:58"/><verse number="59" style="v" sid="JHN 8:59"/>Henot hitara hibare mela maribolla fattor feṛai loiye, kintu Isa hitarattu lukaigiyegoi edde dórmogóror uṛanottu baire niyoli giyegoi.<verse eid="JHN 8:59"/></para>
  <chapter eid="JHN 8"/>
  <chapter number="9" style="c" sid="JHN 9"/>
  <para style="s">Isaye ek zormo anda manušore aram goijje</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1"/>Isa aṛi zat maze hibaye ek zormo anda manušore deikke. <verse eid="JHN 9:1"/><verse number="2" style="v" sid="JHN 9:2"/>Toi sahabi okkole hibare fusar goijje, hodde "Rabbi, guna hone goijjede, hite nize ne naki hitar ma bafe, ze hitattu anda zormo owa foijje?"<verse eid="JHN 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3"/>Isaye hodde, <char style="wj">"Guna no ite goijje, otóba hitar ma bafe; kintu iyan oiye zene hitar butore Allar ham forhaš oi fare.</char> <verse eid="JHN 9:3"/><verse number="4" style="v" sid="JHN 9:4"/><char style="wj">Din zetun ase hetun, ze ãre defeṛaiye, hibar ham ãra gora iyan zoruri. Rait aiyer, zẽtte honokiye ham gori no faribo.</char> <verse eid="JHN 9:4"/><verse number="5" style="v" sid="JHN 9:5"/><char style="wj">Ãi zetodin duniyait asi, ãi oilamde duniyair nur." </char><verse eid="JHN 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6"/>Ei hota hoiyore, hibaye meṛit sep felaiyore hodun fũṭ goijje edde hin manušwar sukot lagai diye. <verse eid="JHN 9:6"/><verse number="7" style="v" sid="JHN 9:7"/>Tarfore hodde, <char style="wj">"Za, Šiloam foirot zai dúifelagoi,"</char> (ziyanor mani gorile "defeṛa oiye" o). Toi hite zaiyore dúifelaiye, edde suke dekat maze firi aišše.<verse eid="JHN 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8"/>Ḍengór bam gójja okkol edde aro zara hite boiyore horat magitode dekkil, hitara hodde, "Ite no neki ze boiyore horat magitode?" <verse eid="JHN 9:8"/><verse number="9" style="v" sid="JHN 9:9"/>Kiye kiye, oi iba hite hoiye.</para>
  <para style="p" vid="JHN 9:9">Ar kiye hodde, "No, hitare saite hendilla lagedde"</para>
  <para style="p" vid="JHN 9:9">Kintu manušwaye nize hodde, "Oi, ãi hiba."<verse eid="JHN 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10"/>Hitara fusar goredde, "Kintu tor suk kengori kuli giyegoi?"<verse eid="JHN 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11"/>Hite zuwabe hodde, "Isa name manušwaye hodun fũṭ banaiye edde ãr sukor uwore lifidiye, ar ãre hodde, Šiloam foirot za, dúifelagoi; ãi zaiyore zehon dúifelaiyi, toi ãi deki faijji."<verse eid="JHN 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12"/>Hitara hodde, "hiba hoṛe?"</para>
  <para style="p" vid="JHN 9:12">Hite hodde, "Ãi no zani."<verse eid="JHN 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13"/>Toi hitara he anda aššilde manušware Foroši okkolor hãse loigiye. <verse eid="JHN 9:13"/><verse number="14" style="v" sid="JHN 9:14"/>Ze din Isaye fũṭ banaiyore manušwar suk kulidiye hedin aššilde Šabbat. <verse eid="JHN 9:14"/><verse number="15" style="v" sid="JHN 9:15"/>Hetolla Foroši okkole o hitattu fusar goijje, hite deki kengori faijje. Hite hitarare hodde: "Hibaye ãr sukgunor uwore fũṭ lifidiye, ar ãi duifelaiyi, toi ãi dekir."<verse eid="JHN 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16"/>Foroši hoekzone hodde, "Ei manušwa Allar hãsottu nu aiye, kiyollahoile hite Šabbat falon no gore."</para>
  <para style="p" vid="JHN 9:16">Ar kiye hodde, "Ekzon gunagar manuše kengori endilla sinnor ham gori fare?" Ei bafe hitarar butore baga bagi oiye.<verse eid="JHN 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17"/>Toi hitara he anda aššilde manušwattu abar fusar goijje, "Tui hitar babute ki hos, kiyollahoile hite to tor suk kuli diye"</para>
  <para style="p" vid="JHN 9:17">Manušwaye hodde, "Hiba ekzon nobi."<verse eid="JHN 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18"/>Ihudi okkole kintu manušwar baf mare ḍaki ani fusar no gore foijjonto hitara biššaš gori no faijjil ze hite age anda aššil, ar ehon deker. <verse eid="JHN 9:18"/><verse number="19" style="v" sid="JHN 9:19"/>Hitara manušwar baf mare fusar goijje, "Ite ki tũwarar he fut, ze anda zormo oiye boli tũwara ho? Ehon hite kengori deki farer?"<verse eid="JHN 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20"/>Hitar ma bafe zuwab diye, "Ãra zani iba ãrar fut, ar ite anda zormo oiye. <verse eid="JHN 9:20"/><verse number="21" style="v" sid="JHN 9:21"/>Kintu ehon hite kengori deki farer hiyan ãra no zani. Ar iyano no zani hiba honnuwa, ze hitar suk kuli diye. Hitattu boyoš oiye, hitattu fusar goro. Hite nizor babute nize hok." <verse eid="JHN 9:21"/><verse number="22" style="v" sid="JHN 9:22"/>Hitar baf maye Ihudi neta okkolor ḍore in okkol hoiye, kiyollahoile Ihudi neta okkol beggune razi aššil ze, ze kiye Isare Messiyah šikar gore, hitare sinagogottu niyolai diya oibo. <verse eid="JHN 9:22"/><verse number="23" style="v" sid="JHN 9:23"/>Iyanor zoriya hitar baf maye hoiye, "Hitar boyoš oiye, hitare fusar goro."<verse eid="JHN 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24"/>Anda aššilde manušware dusorabar ḍaikke edde hitare hodde, "Tui soiyi hoiyore Allare tarif de. Ãra to zani ze ei manušwa gunagar."<verse eid="JHN 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25"/>Hite hodde, "Hiba gunagar ne naki no ãi no zani, kintu ãi iyan zani ze, ãi age anda aššilam ar ehon ãi dekir!"<verse eid="JHN 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26"/>Toi hitara fusar goijje, "Hite tore ki goijje? Tor suk hite kengori kuli diye?"<verse eid="JHN 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27"/>Hite zuwab diye, "Ãi to tũwarare age hoiyi, kintu tũwara no funo. Toile tũwara abar kiyolla fuinto sor? Tũwara o ki hibar biššaši oito sor neki?"<verse eid="JHN 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28"/>Henot hitara hitare kub gozgozaiye edde hodde, "Tui hitar biššaši, kintu ãra Musar biššaši. <verse eid="JHN 9:28"/><verse number="29" style="v" sid="JHN 9:29"/>Ãra zani ze Allaye Musa loi hota hoiye, kintu ite hontu aišše hiyan ãra no zani."<verse eid="JHN 9:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30"/>Manušwaye hitarare zuwab diye, "Iyan ekkan ki tajjuiffa ze hiba hontu tũwara no zano, otoso hibaye ãr suk kuli diye. <verse eid="JHN 9:30"/><verse number="31" style="v" sid="JHN 9:31"/>Ãra zani ze Allaye gunagarore no fune, kintu hite zodi Allah bokto o, ar hibar issa falon gore, hibaye hitare fune. <verse eid="JHN 9:31"/><verse number="32" style="v" sid="JHN 9:32"/>Duniyai sirišti oiye loti iyan endilla honodin funa no za ze, honokiye zórmottu loti anda mainšor suk kuli diye. <verse eid="JHN 9:32"/><verse number="33" style="v" sid="JHN 9:33"/>Hiba zodi Allattu no aito, toile hibaye kissu gori no farito."<verse eid="JHN 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34"/>Hitara hodde, "Tor zormo ekkubare gunar butore oiyore, ar ãrare šikka dor!" Bade hitara hitare baire niyolai diye.<verse eid="JHN 9:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35"/>Isaye fuinne ze, hitara manušware bair gori diye, ar hibaye hitare tuwai faiyore hodde, <char style="wj">"Tui ki Adomor Futore biššaš goros ne?"</char><verse eid="JHN 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36"/>Hite zuwab diye, "Malik, hiba honnuwa? Toi zene ãi hibare biššaš gori fari."<verse eid="JHN 9:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37"/>Toi Isaye hitare hodde, <char style="wj">"Tui hibare dekor, ar hibaye tor loi hota hor."</char><verse eid="JHN 9:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38"/>Hetunot he manušwaye hodde, "Malik, ãi biššaš gori" ar hite hibare soida goijje.<verse eid="JHN 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39"/>Isaye hodde, <char style="wj">"Bisarolla ãi ei duniyait aišši, zene zara anda hitara deke, ar zara deke hitara anda o." </char><verse eid="JHN 9:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40"/>Foroši okkolor butottu zara hibar fũwati aiššil hitara in okkol fuinne, toi hitara hibare hodde, "Ãra o ki anda neki?"<verse eid="JHN 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41"/>Isaye hodde, <char style="wj">"Tũwara zodi anda oita, toile tũwarattu hono guna no takito; kintu ehon tũwara hor, 'Ãra dekir,' Hetolla tũwarar guna taki giyegoi."</char><verse eid="JHN 9:41"/></para>
  <chapter eid="JHN 9"/>
  <chapter number="10" style="c" sid="JHN 10"/>
  <para style="s">Bala sool soroya edde hibar soolor zãk</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1"/>
    <char style="wj">"Ãi tũwarare soiyi soiyi hoir, hite ze soolor zãkot doroza bai no gole, kintu oinno ḍak bai zai faraiyore gole, hite ekzon sur edde ekzon ḍahait.</char> <verse eid="JHN 10:1"/><verse number="2" style="v" sid="JHN 10:2"/><char style="wj">Kintu ze doroza bai gole, hite oilde soolgunor soroya.</char> <verse eid="JHN 10:2"/><verse number="3" style="v" sid="JHN 10:3"/><char style="wj">Doroza fahara doyaye hiballa doroza kuli de, ar soolgune hibar abaz fune, ar hibar nizor soolgunore hibaye nam dori ḍake edde fõt dehai barkule loiza.</char> <verse eid="JHN 10:3"/><verse number="4" style="v" sid="JHN 10:4"/><char style="wj">Ar zehon hibaye hibar nizor soolgunore barkule niyolaiye, hiba hitarar age age za, edde soolgune hibar fisa lo, kiyollahoile hitara hibar abaz sine.</char> <verse eid="JHN 10:4"/><verse number="5" style="v" sid="JHN 10:5"/><char style="wj">Kintu hitara osina ekzonor fise no loibo; bolke hitar hãsottu dái zaiboi, kiyollahoile osina mainšor abazore hitara no sine." </char> <verse eid="JHN 10:5"/><verse number="6" style="v" sid="JHN 10:6"/>Isaye ei mesal kahanigan hitarare hoiye, kintu hibaye hitarare ki ze hoiye, hiyan hitara no buze.<verse eid="JHN 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7"/>Hetolla Isaye abar hodde, <char style="wj">"Ãi tũwarare soiyi soiyi hoir, soolgunolla ãi oilamde he doroza.</char> <verse eid="JHN 10:7"/><verse number="8" style="v" sid="JHN 10:8"/><char style="wj">Beggun zara ãr age aišše, hitara sur okkol edde ḍahait okkol, kintu soolgune hitarare no fune.</char> <verse eid="JHN 10:8"/><verse number="9" style="v" sid="JHN 10:9"/><char style="wj">Ãi doroza; ze ãr butottu di gole, hite uddar oibo edde butore aibo edde bare zaibo, ar sori háibolla zaga faibo.</char> <verse eid="JHN 10:9"/><verse number="10" style="v" sid="JHN 10:10"/><char style="wj">Sur aiye šude zene hite suri, kun edde dongšo gori fare; ãi aiššyi, zene hitara zibon fa edde zaf di forefan gori fa.</char><verse eid="JHN 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11"/>
    <char style="wj">"Ãi he bala soolsoroya. Bala soolsoroyaye soololla hitar nizor zibon šebi de.</char> <verse eid="JHN 10:11"/><verse number="12" style="v" sid="JHN 10:12"/><char style="wj">Kintu betondari, ze sool soroya no, ar sool o zin hitar nizor no, ar so, hite zehon genḍa bag aiyedde deker, soolgun eri dái zargoi; toi bage hinore súlai loizagoi edde šiṛašiṭṭa goride,</char> <verse eid="JHN 10:12"/><verse number="13" style="v" sid="JHN 10:13"/><char style="wj">kiyollahoile hite ekzon betondari, hitattu soolgunolla hono dorod nai.</char><verse eid="JHN 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 10:14"/>
    <char style="wj">"Ãi oilamde he bala soolsoroya; ãi ãrgunore sini ar ãrgune o ãre sine,</char> <verse eid="JHN 10:14"/><verse number="15" style="v" sid="JHN 10:15"/><char style="wj">zendilla ãr Bafe ãre sine, ar ãi Bafore sini, soololla ãi ãr zibon šebi di.</char> <verse eid="JHN 10:15"/><verse number="16" style="v" sid="JHN 10:16"/><char style="wj">Ãttu aro sool okkol ase, zin ei zãkor no, hitarare o ãttu ana foribo edde hitara o ãr abaz funibo, ar henot ugguwa zãk edde ekzon soolsoroya oibo.</char> <verse eid="JHN 10:16"/><verse number="17" style="v" sid="JHN 10:17"/><char style="wj">Ãr Bafe ãre ador gore, kiyollahoile ãi ãr zibon šebi di, zene hiyan ãi abar uwafes firai loi fari.</char> <verse eid="JHN 10:17"/><verse number="18" style="v" sid="JHN 10:18"/><char style="wj">Ãr foran honokiye no lor, bolke ãi nize hiyan šebi dir, ar hiyan šebi dibar kemota ãttu ase; edde hiyan abar loibar kemota o ãttu ase; ei hokum ãr Bafottu ãi faiyi."</char><verse eid="JHN 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19"/>Ei hota okkolor zoriya Ihudi okkolor butore abar baga bagi oiye. <verse eid="JHN 10:19"/><verse number="20" style="v" sid="JHN 10:20"/>Hitarar bout kiye hodde, "Hitar butore ek but ase, hite fool. Tũwara hitar hota kiyolla funor?"<verse eid="JHN 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21"/>Ar kiye hodde, "Ekzon bute faiya manuše endilla hota okkol no ho. Bute ki anda mainšor suk kuli di fare?"<verse eid="JHN 10:21"/></para>
  <para style="s">Isa ze Allar fut hiyan Ihudi okkole ošikar goijje</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22"/>Tarfore hannuka id aišše, ar hẽtte šit hal. <verse eid="JHN 10:22"/><verse number="23" style="v" sid="JHN 10:23"/>Isaye dórmogóror butore badša Soloimanor haissarat ãṛa ãṛi gorer. <verse eid="JHN 10:23"/><verse number="24" style="v" sid="JHN 10:24"/>Hẽtte Ihudi okkole hibar sairo ḍakottu zoma oiye edde hibaye hodde, "Tui ãrare ar hoto din šondot rakibi? Tui zodi Messiyah, toile ãrare ho."<verse eid="JHN 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25"/>Isaye zuwabe hodde, <char style="wj">"Ãi to tũwarare hoiyi, kintu tũwara biššaš no goro. Ãr bafor name ze ham okkol ãi gori, hine ãr babute goba de,</char> <verse eid="JHN 10:25"/><verse number="26" style="v" sid="JHN 10:26"/><char style="wj">kintu tũwara biššaš no goro, kiyollahoile tũwara ãr sool no.</char> <verse eid="JHN 10:26"/><verse number="27" style="v" sid="JHN 10:27"/><char style="wj">Ãr sool okkole ãr abaz fune, ãi hitarare zani, edde hitara ãr fisa lo.</char> <verse eid="JHN 10:27"/><verse number="28" style="v" sid="JHN 10:28"/><char style="wj">Ãi hitarare akeri zibon di, edde hitara honodin dongšo no oibo, ar honokiye ãr hatottu hitarare hari loi no faribo. </char> <verse eid="JHN 10:28"/><verse number="29" style="v" sid="JHN 10:29"/><char style="wj">Ãr baf, ze hitarare ãre diye, hiba oilde hár kissuttuwaro mohan, ar honokiye ãr Bafor hatottu hari loi no faribo. </char> <verse eid="JHN 10:29"/><verse number="30" style="v" sid="JHN 10:30"/><char style="wj">Ãi edde Baf ek." </char><verse eid="JHN 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31"/>Hetunot Ihudi okkole hibare maribolla abar fattor feṛailoiye, <verse eid="JHN 10:31"/><verse number="32" style="v" sid="JHN 10:32"/>kintu Isaye hitarare hodde, <char style="wj">"Ãi ãr Bafor hentu tũwarare beši bala ham okkol gori dehaiyi. Hinor butore honnanolla tũwara ãre fattor mariba?"</char><verse eid="JHN 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33"/>Ihudi okkole zuwab diye, "Hono bala hamolla tore ãra fattor no marir, kintu kuferilla, haron tui ekzon manuš oiyore, nizore Allah dabi goror."<verse eid="JHN 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34"/>Isaye hodde, <char style="wj">"Tũwarar ainot ki endilla leka nai ne, 'Ãi hoilam, tũwara allah okkol'?</char> <verse eid="JHN 10:34"/><verse number="35" style="v" sid="JHN 10:35"/><char style="wj">Allar kalam zarar hãse aišše hitarare zodi hibaye 'Allah okkol' ho, ar Pak kitabor kalam bad oi no fare.</char> <verse eid="JHN 10:35"/><verse number="36" style="v" sid="JHN 10:36"/><char style="wj">Henoile, zare Bafe fobitro goijje edde duniyait defeṛaiye, tũwara ki hoiba, ze 'Tui kuferi goror' kiyollahoile ãi hoilam ze 'ãi Allar Fut'?</char> <verse eid="JHN 10:36"/><verse number="37" style="v" sid="JHN 10:37"/><char style="wj">Ãr Bafor ham zodi ãi no gori, toile tũwara ãre biššaš no goijjo.</char> <verse eid="JHN 10:37"/><verse number="38" style="v" sid="JHN 10:38"/><char style="wj">Kintu ãi zodi gori, tũwara ãre biššaš no gorile o, hamgunore oile biššaš goro, zene tũwara zani faro edde buzi faro ze, Baf ãr butore, ar ãi Bafor butore asi."</char> <verse eid="JHN 10:38"/><verse number="39" style="v" sid="JHN 10:39"/>Abar hitara Isare doitto kušiš goijje, kintu hiba hitarar hatottu harigiyegoi.<verse eid="JHN 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40"/>Tarfore Isa abar Zordanor ofarot giye, zeṛe Yahyaye torikotor gusol dito. Hiba heṛe taikke. <verse eid="JHN 10:40"/><verse number="41" style="v" sid="JHN 10:41"/>Bout manuš okkol hibar hãse aišše, edde hodde, "Yahyaye hono keramoti ham no gore, tarfore o kintu hibaye ei manušwar babute zin zin hoiye hin beggun soiyi." <verse eid="JHN 10:41"/><verse number="42" style="v" sid="JHN 10:42"/>Ar heṛe bout manuš okkol Isar biššaši oiye.<verse eid="JHN 10:42"/></para>
  <chapter eid="JHN 10"/>
  <chapter number="11" style="c" sid="JHN 11"/>
  <para style="s">Isaye Lazarusore morattu tuille</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1"/>Betaniyat ekzon ošuikka manuš aššil, nam Lazarus; ar hite Moriyam edde hibar boin Martár farar manuš. <verse eid="JHN 11:1"/><verse number="2" style="v" sid="JHN 11:2"/>(Iba he Moriyam, ze Malikore kušbo tel loi ḍoli dil, ar hibar nizor sul loi ṭeng fũsi dil, zar bái Lazarusottu ehon ošuk.) <verse eid="JHN 11:2"/><verse number="3" style="v" sid="JHN 11:3"/>Hetolla boinain okkole Isar hãse hóbor defeṛaiye, "Malik, zar loi õne kuši hitattu ehon ošuk."<verse eid="JHN 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4"/>Isaye ei hota funiyore hodde, <char style="wj">"Ei ošuk moribolla no o, kintu Allar tarifolla, zene iyanor duwara Allar Fut mohimawala oi fare."</char><verse eid="JHN 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5"/>Isaye Martá, hibar boin edde Lazarusore ador gorito. <verse eid="JHN 11:5"/><verse number="6" style="v" sid="JHN 11:6"/>Hibaye zehon hitattu ošuk oiyede fuinne, hiba zeṛe aššil heṛe aro dui din taigiyegoi. <verse eid="JHN 11:6"/><verse number="7" style="v" sid="JHN 11:7"/>Tarfore hibaye sahabi okkolore hodde, <char style="wj">"Aiyo, ãra abar Ehudiyat zai."</char><verse eid="JHN 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8"/>Sahabi okkole hibare hodde, "Rabbi, ei kissu din age no ne Ihudi okkole õnore fattor maitto saiye, ar õne abar heṛe zodde?"<verse eid="JHN 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9"/>Isaye zuwabe hodde, <char style="wj">"Dinot ki baro gonḍa nai ne? Ar hite ze dinot solafira gore, hite ujaṭ no há, kiyollahoile hite ei duniyair fohor deke.</char> <verse eid="JHN 11:9"/><verse number="10" style="v" sid="JHN 11:10"/><char style="wj">Ar hite ze raitta solafira gore, hite ujaṭ há, kiyollahoile hitar butore fohor nai."</char><verse eid="JHN 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 11:11"/>Hibaye in okkol hoiye, in bade hibaye hitarare hodde, <char style="wj">"Ãrar bondu Lazarus gumot foijje, kintu ãi hitare gumottu tulibolla heṛe zair."</char><verse eid="JHN 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12"/>Toi sahabi okkole hodde, "Malik, hite gum giyede oilede hite bala oi zaiboi." <verse eid="JHN 11:12"/><verse number="13" style="v" sid="JHN 11:13"/>Kintu Isaye hitar moronor babute hoilde, kintu hitara ṭaijje hibaye amfam gumor hota hor.<verse eid="JHN 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 11:14"/>Toi Isaye foriškar gori hoiye, <char style="wj">"Lazarus morigiyegoi,</char> <verse eid="JHN 11:14"/><verse number="15" style="v" sid="JHN 11:15"/><char style="wj">ar tũwaralla hoi ãi kuši ze ãi heṛe nu aššilam, zene tũwara biššaš gori faro; hetolla aiyo, ãra Lazarusor hãse zai."</char><verse eid="JHN 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16"/>Hetunot Tomas, (zare Didymus ho) hibaye oinno fũwajja sahabi okkolore hodde, "Aiyo, ãra o zai, zene ãra o hitar fũwati mori fari."<verse eid="JHN 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17"/>Isa aiyore zani faijje ze, Lazarus hẽtte hoborot asede sair din oiye. <verse eid="JHN 11:17"/><verse number="18" style="v" sid="JHN 11:18"/>Betaniya aššilde Zeruzalemor hãsa hãsi, onumanik tin kilomiṭaror fõt. <verse eid="JHN 11:18"/><verse number="19" style="v" sid="JHN 11:19"/>Ihudi okkolor butottu boute Martá edde Moriyamor hãse aišše, zene hitarar báiyor babute šantona di fare. <verse eid="JHN 11:19"/><verse number="20" style="v" sid="JHN 11:20"/>Martáye zehon fuinne ze Isa aiyer, hiba zaiyore hibar loi deha goijje, ar Moriyam gorot boiṛa taigiyegoi.<verse eid="JHN 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 11:21"/>Martáye Isare hodde, "Malik, õne zodi eṛe takita, toile ãr báiwa no morito. <verse eid="JHN 11:21"/><verse number="22" style="v" sid="JHN 11:22"/>Kintu ãi zani, õne Allar hãse ze kissu saiba, hin Allaye õnore dibo."<verse eid="JHN 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23"/>Isaye hibare hodde, <char style="wj">"Tor bái abar uṛibo."</char><verse eid="JHN 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24"/>Martáye hodde, "Ãi zani šeš hale uwafes zindar šomot hite o uṛibo."<verse eid="JHN 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25"/>Isaye hodde, <char style="wj">"Ãi oilamde he uwafes zinda edde he zibon. Hite ze ãr uwore biššaš ane hite morile o zinda takibo;</char> <verse eid="JHN 11:25"/><verse number="26" style="v" sid="JHN 11:26"/><char style="wj">ar hite ze zinda edde ãre biššaš gore hite hono din no moribo, iyan ki biššaš goros?"</char><verse eid="JHN 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27"/>Hibaye hodde, "Oi, Malik, ãi biššaš gori õne he Messiyah, Allar Fut, ze duniyait aibar hota."<verse eid="JHN 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28"/>Ei hota hoi Martá zaiyore hibar boin Moriyamore gufone ḍakiyore hodde, "Malik eṛe ase, ar tore ḍaker."<verse eid="JHN 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 11:29"/>Moriyame ei hota funiyore, toratori uiṭṭe edde hibar hãse giye. <verse eid="JHN 11:29"/><verse number="30" style="v" sid="JHN 11:30"/>Isa hetunot o farar butore no aiye, kintu ehono he zagat zeṛe Martáye hiba loi deha oil. <verse eid="JHN 11:30"/><verse number="31" style="v" sid="JHN 11:31"/>Ze Ihudi okkol Moriyamor górot aššil edde hibare šantona diyat aššil, hitara dekedde Moriyam toratori uṛi baire giye, ar hitara o hibar fise fise giye, ar mone goijje ze hibaye hoboror ḍake handito zar boli.<verse eid="JHN 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32"/>Toi Moriyam, Isa zeṛe aššil, hiba heṛe aišše edde hibare dekiyore hibar ṭengot foijje edde hodde, "Malik, õne zodi eṛe takita, toile ãr bái no morito."<verse eid="JHN 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33"/>Toi Isaye hibar handani edde hibar fũwati ze Ihudi okkol aššil, hitara handani dekiyore hibar dilor butore hoisali oiye, toi hibaye hodde, <verse eid="JHN 11:33"/><verse number="34" style="v" sid="JHN 11:34"/><char style="wj">"Tũwara hitare hoṛe raikko?"</char></para>
  <para style="p" vid="JHN 11:34">Hitara hodde, "Malik, aiyo sogai."<verse eid="JHN 11:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35"/>Isaye hainde.<verse eid="JHN 11:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 11:36"/>Toi Ihudi okkole hodde, "So, hiba hitare loi hondilla kuši."<verse eid="JHN 11:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37"/>Kintu hitarar hodune hodde, "Iba hiba no ne, ze he anda manušwar suk ze kuli diye, hibaye ki ite no morefan gori no farito ne?"<verse eid="JHN 11:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38"/>Henot Isar dilot abar o hoisali oiye edde hoboror hãse aišše, ar hiba aššilde ugguwa guha, ar hiyanor uwore ugguwa šil aššil. <verse eid="JHN 11:38"/><verse number="39" style="v" sid="JHN 11:39"/>Isaye hodde, <char style="wj">"Šilgan šoraifelo."</char></para>
  <para style="p" vid="JHN 11:39">morigiyegoide hitar boin Martáye hodde, "Malik, ehon hitattu baš uṛer, kiyollahoile hite heṛe sair dinna mora."<verse eid="JHN 11:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40"/>Isaye hibare hodde, <char style="wj">"Ãi ki tore no hoi ne, ze tui zodi biššaš goros, toile tui Allar mohima dekibi?"</char><verse eid="JHN 11:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 11:41"/>Tarfore hitara šilgan šoraifelaiye. Isaye hibar suk uwor mikka tuille edde hodde,<char style="wj">"Baf, ãi tũware šukuriya gori, ze tũi ãre fuinno.</char> <verse eid="JHN 11:41"/><verse number="42" style="v" sid="JHN 11:42"/><char style="wj">Ar ãi zani ze tũi ãre hamiša funo; kintu eṛe ze manuš okkol tiyaiye hitaralla ãi ei hota hoir, zene hitara ekin gore, ze tũi ãre defeṛaiyo." </char><verse eid="JHN 11:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 11:43"/>In okkol hoi bade, hibaye ek zur abaz loi hodde, <char style="wj">"Lazarus, niyoli ai." </char><verse eid="JHN 11:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 11:44"/>Henot morawa niyoli aišše; hitar hat ṭeng aššil kafonor hor loi banda, ar hitar mukot aššil ekkan gamsa loi banda.</para>
  <para style="p" vid="JHN 11:44">Isaye hitarare hodde, <char style="wj">"Hitare kuli do, hitare zaito do."</char><verse eid="JHN 11:44"/></para>
  <para style="s">Isare marifelaibar babute felain</para>
  <para style="r">(<ref loc="MAT 26:1-5">Moti 26:1–5</ref>; <ref loc="MRK 14:1-2">Mark 14:1–2</ref>; <ref loc="LUK 22:1-2">Luk 22:1–2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45"/>Bout Ihudi okkol zara Moriyamor hãse aiššil, edde Isaye ki goijje hin dekiyore, hitara hibar uwore biššaš ainne. <verse eid="JHN 11:45"/><verse number="46" style="v" sid="JHN 11:46"/>Kintu hitarar kiye kiye Foroši okkolor hãse giye, edde Isaye ki goijje hin hitarare hoiye. <verse eid="JHN 11:46"/><verse number="47" style="v" sid="JHN 11:47"/>Toi ḍõr imam edde Foroši okkole ḍõr šoba Sanhedrinore ekottro goriyore hodde, "Ãra ehon ki goriyum? Ei manušwaye bout sinnor ham okkol gorer. <verse eid="JHN 11:47"/><verse number="48" style="v" sid="JHN 11:48"/>Ãra zodi itare endilla solito di, toile beggune hitar uwore biššaš anibo; ar Romiyo okkol aiyore ãrar paki zaga edde ãrar zati dunigun hari loibo."<verse eid="JHN 11:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49"/>Ar hitarar butore ekzon, Kaifas name, he bosoror ḍõr imam, hibaye hitarare hodde, "Tũwara kissu no zano. <verse eid="JHN 11:49"/><verse number="50" style="v" sid="JHN 11:50"/>Ar bafi no sor ne ze, iyan ãralla bala oibo, mainšolla ekzon manuš more, edde guṛa zati dongšo no o."<verse eid="JHN 11:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 11:51"/>Ei hota hite nizottu hoiye hen no, kintu hite he bosoror ḍõr imam hisabe hite nobi hisabe hota hoiye, ze Isa zatilla moribo, <verse eid="JHN 11:51"/><verse number="52" style="v" sid="JHN 11:52"/>šude he zatilla no, bolke he Allar fuwain okkololla o, zara šiṛašitta oi roiye, zene hibaye hitarare dola gore edde ek gore. <verse eid="JHN 11:52"/><verse number="53" style="v" sid="JHN 11:53"/>He dinottu loti hitara felain goijje ze hitara hibare marifelaibo.<verse eid="JHN 11:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 11:54"/>Hetolla Isaye Ihudi okkol loi ar kulasa solafira no gore, kintu hentu zaigoiyore bošoti sara elehar ḍake Efraim name ekkan šohorot giye, zeṛe hiba hibar sahabi okkolore loi taikke.<verse eid="JHN 11:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55"/>Hẽtte Ihudi okkolor uddar id hãse aiššil, ar boute uddar idor age hitara nizore paksaf goribolla dešottu uwore Zeruzalem giye. <verse eid="JHN 11:55"/><verse number="56" style="v" sid="JHN 11:56"/>Hitara Isare tuwat aššil, edde dormogórot tiyaiyore ekzone oinnozonore hodde, "Tũwarattu ken lage? Hiba idot nu aibo ne ki?" <verse eid="JHN 11:56"/><verse number="57" style="v" sid="JHN 11:57"/>Ḍõr imam edde Foroši okkole hokum dilo ze, Isa hoṛe ase hiyan zodi honokiye zane hóborgan hitarare de, zene hitara Isare dori fare.<verse eid="JHN 11:57"/></para>
  <chapter eid="JHN 11"/>
  <chapter number="12" style="c" sid="JHN 12"/>
  <para style="s">Betaniyat Isare dami ator ḍoli diye</para>
  <para style="r">(<ref loc="MAT 26:6-13">Moti 26:6–13</ref>; <ref loc="MRK 14:3-9">Mark 14:3–9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1"/>Uddar idor só din age Isa Betaniyat aišše, heṛe he Lazarus aššil, zare hibaye morattu tuille. <verse eid="JHN 12:1"/><verse number="2" style="v" sid="JHN 12:2"/>Heṛe hiballa ek hánar entezam gora oiye, ar Martáye hána bari dil, ar Lazarus o hibar fũwati hánar ṭebilot boiššilde hitarar maze. <verse eid="JHN 12:2"/><verse number="3" style="v" sid="JHN 12:3"/>Hen šomot Moriyame ada liṭar beši dami, haṭi ator aniyore Isar ṭengot ḍoli diye edde hibar sul loi hibar ṭeng fũsi diye. Ar he atoror kušboye gór bori giyegoi.<verse eid="JHN 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 12:4"/>Iskariyoti Ehudah, hibar sahabi okkolor ekzon, ze hiba loi beimani goribo, hite endilla hodde, <verse eid="JHN 12:4"/><verse number="5" style="v" sid="JHN 12:5"/>"Ei ator in tin šot denar di besiyore kiyolla gorib okkolore diya no or?"<verse eid="JHN 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 12:6"/>Hitattu goribolla dorod asede hiyan bafiyore hite ei hota hoiyede no, kintu hite aššilde ek sur, ar ṭiyar beg hitar hatot takitode hisabe, zin heṛe raka oito hite hentu loifelaito.<verse eid="JHN 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7"/>Isaye hodde,<char style="wj">"Hiba loi hen no goijjo! Hibaye hin ãr hoboror dinolla raikkede.</char> <verse eid="JHN 12:7"/><verse number="8" style="v" sid="JHN 12:8"/><char style="wj">Gorib okkol to hamiša tũwarar fũwati ase, kintu ãre hamiša tũwara no faiba."</char><verse eid="JHN 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9"/>Isa Betaniyat ase zani fariyore Ihudi okkolor ek ḍõr dol heṛe aišše, hitara šude Isare saito nu aiye, bolke Lazarus, zare hibaye morattu tuille, hitare o saito aišše. <verse eid="JHN 12:9"/><verse number="10" style="v" sid="JHN 12:10"/>Ar ḍõr imam okkole felain goijje zene hitara Lazarusore o marifelai fare, <verse eid="JHN 12:10"/><verse number="11" style="v" sid="JHN 12:11"/>kiyollahoile hitalla buli Ihudi okkolor boute heṛe zat aššil edde Isare biššaš gorat aššil.<verse eid="JHN 12:11"/></para>
  <para style="s">Isaye Zeruzalem goler</para>
  <para style="r">(<ref loc="MAT 21:1-11">Moti 21:1–11</ref>; <ref loc="MRK 11:1-11">Mark 11:1–11</ref>; <ref loc="LUK 19:28-38">Luk 19:28–38</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12"/>Tarforor din idot falon goitto aiššede ek dõr mainšor dole Isa Zeruzalem aiyer funiyore, <verse eid="JHN 12:12"/><verse number="13" style="v" sid="JHN 12:13"/>hitara hazu fatar ḍeila okkol loiye edde dola oibolla niyoli giye, ar guzori hoiye,</para>
  <para style="q1" vid="JHN 12:13">"Hosanna!"</para>
  <para style="b" vid="JHN 12:13"/>
  <para style="q1" vid="JHN 12:13">"Rahamoti hiba ze mabudor name aiyer, Israilor badša!"<verse eid="JHN 12:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="JHN 12:14"/>Ar Isaye ugguwa gadar so faiye edde hibar uwore boišše, iyan zendilla leka ase:<verse eid="JHN 12:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15"/>"O Sion hoinna, no ḍorais,</para>
  <para style="q2" vid="JHN 12:15">sa, tor badša aiyer,</para>
  <para style="q2" vid="JHN 12:15">gadar sor fiṛot boiyore."<verse eid="JHN 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16"/>Hibar sahabi okkole in okkol foila buzi no fare, kintu Isa zehon mohimawala oiye, hẽtte hitarattu monot foijjil ze in okkol hibar babute leka aššil, edde manuš okkole hibare in okkol goijje.<verse eid="JHN 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17"/>Isa Lazarusore hoborottu aibolla ḍaikkede edde morattu tuillede šomot ze manuš okkol hibar fũwati aššil, hitara he babute goba diyat aššil. <verse eid="JHN 12:17"/><verse number="18" style="v" sid="JHN 12:18"/>Ar hetolla bout manuš okkole zaiyore hiba loi dola oiye, kiyollahoile hibaye ei sinnor ham goijjede hitara fuinnil. <verse eid="JHN 12:18"/><verse number="19" style="v" sid="JHN 12:19"/>Toi Foroši okkol ekzone ar ekzonore hodde, "Tũwara dekor, tũwarar hono kissu lab no or; so, duniyai udda hitar fisa loiye."<verse eid="JHN 12:19"/></para>
  <para style="s">Isaye nizor moronor babute hor</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20"/>Idot ebadot goitto aiššede hitarar maze ho ekzon Girikiyo aššil. <verse eid="JHN 12:20"/><verse number="21" style="v" sid="JHN 12:21"/>Hitara Galilor Betsaidar Filipor hãse aišše, edde hibare foriyad goijje, "Ustad, ãra Isare saito sai." <verse eid="JHN 12:21"/><verse number="22" style="v" sid="JHN 12:22"/>Filipe aiyore Anderiyazore hoiye, toi Anderiyaz edde Filipe Isare hoiye.<verse eid="JHN 12:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 12:23"/>Isaye zuwabe hodde, <char style="wj">"Adomor Futore mohimaola gora oibar ṭaim aišše.</char> <verse eid="JHN 12:23"/><verse number="24" style="v" sid="JHN 12:24"/><char style="wj">Ãi tũwarare soiyi soiyi hoir, gĩyur biz zodi meṛit foriyore zodi no more, toile hiba ugguwa dana take; kintu zodi more, toile hibaye beši gula dora.</char> <verse eid="JHN 12:24"/><verse number="25" style="v" sid="JHN 12:25"/><char style="wj">Hite ze nizor foranore beši ador gore, hite hiyan haraibo; ar hite ze nizor zibonore ei duniyait hingša gore, hite hiyan akeri zibonolla basaibo.</char> <verse eid="JHN 12:25"/><verse number="26" style="v" sid="JHN 12:26"/><char style="wj">Hite ze ãr šeba goribo, hite ãr fisa lok, ar ãi zeṛe, heṛe ãr šeba goroya o oibo; ar hite ze ãr šeba gore, ãr Bafe hitare šorman dibo.</char><verse eid="JHN 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27"/>
    <char style="wj">"Ehon ãr dil ferešani oiye; iyanot ki ãi ki en hoiyum ne? 'Baf, ei ṭaimottu ãre basao'? no, bolke ai aiššilamde to ei ṭaimolla.</char> <verse eid="JHN 12:27"/><verse number="28" style="v" sid="JHN 12:28"/><char style="wj">Baf, tũwar nam mohimawala goro!"</char></para>
  <para style="p" vid="JHN 12:28">Hetunot asmanottu ek abaz aišše, "Ãi hiyan mohimawala goijji, ar ãi abar hiyan mohimawala goriyum." <verse eid="JHN 12:28"/><verse number="29" style="v" sid="JHN 12:29"/>Heṛe tiyat aššilde manušor dole iyan fuinne edde hodde, "Ḍeba mater;" ar kiye hor, "Hono ek firistaye hibar loi hota hor."<verse eid="JHN 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30"/>Isaye zuwabe hodde,<char style="wj">"Ei abaz ãlla oiyede no, kintu tũwaralla.</char> <verse eid="JHN 12:30"/><verse number="31" style="v" sid="JHN 12:31"/><char style="wj">Ehon oilde ei duniyair bisar; ehon ei duniyair šašon goroyare baire felai diya oibo.</char> <verse eid="JHN 12:31"/><verse number="32" style="v" sid="JHN 12:32"/><char style="wj">Ar ãi, ãre zẽtte zobinottu tula oibo, hár manušore ãi ãr mikka ṭaniyum."</char> <verse eid="JHN 12:32"/><verse number="33" style="v" sid="JHN 12:33"/>Ar hibaye ei hotar duwara sin diye ze ki moron hibaye moribo.<verse eid="JHN 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34"/>Mainšor dole hodde, "Ãra Torar ainottu fuinni ze Messiyah sirohal takibo; toile tũi kene hoi faror, 'Adomor Futore uwore tula owa foribo'? Toile iba hon 'Adomor Fut'?"<verse eid="JHN 12:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35"/>Isaye hitarare hodde, <char style="wj">"Aro olfo ṭaimolla šude he nur tũwarar fũwati ase; he nur tũwarar fũwati takite ãṛo, zene andar aiyore tũwarar uwore no fore; ar hite ze andarot sole, hoṛe zar hiyan hite no zane.</char> <verse eid="JHN 12:35"/><verse number="36" style="v" sid="JHN 12:36"/><char style="wj">Nur tũwarar hãse takite nuror uwore biššaš ano, zene tũwara nuror fũwain oi faro."</char> Ei hota hoiya oi bade Isaye hitarar hãsottu giyegoi edde hitarattu gufon oigiyegoi.<verse eid="JHN 12:36"/></para>
  <para style="s">Biššaš gora edde obiššašilla šaza</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37"/>Zodi o Isaye hitarar sarme eduggun keramoti ham okkol goijje, tarfore o hitara hibar uwore biššaš no ane. <verse eid="JHN 12:37"/><verse number="38" style="v" sid="JHN 12:38"/>Iyan oiye zendilla Esaiya nobiye hoilde hota furon o:</para>
  <para style="q1" vid="JHN 12:38">"Malik, ãrar diya hóbor hone biššaš goijje,</para>
  <para style="q2" vid="JHN 12:38">Har hãse Malikor ḍũwa forhaš oiye?"<verse eid="JHN 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39"/>Etolla hitara biššaš no gore, kiyollahoile, zendilla Esaiyaye aro hor:<verse eid="JHN 12:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40"/>"Hibaye hitarar suk anda gori diye,</para>
  <para style="q2" vid="JHN 12:40">ar hitarar dilore doro gori diye,</para>
  <para style="q1" vid="JHN 12:40">zene hitara suk diyore no deke,</para>
  <para style="q2" vid="JHN 12:40">ar hitarar dile o no buze,</para>
  <para style="q2" vid="JHN 12:40">ar uwafes no fire, ar ãi hitarare aram goritam."<verse eid="JHN 12:40"/></para>
  <para style="m">
    <verse number="41" style="v" sid="JHN 12:41"/>Esaiyaye in okkol hoiye, kiyollahoile hibaye Isar mohima dekkil edde hibar babute hoil.<verse eid="JHN 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42"/>Tarfore o neta okkolor butore boute hibar uwore biššaš ainne, kintu Foroši okkolor ḍore šikar no gore, ze hitarare sinagogottu niyolai dibo; <verse eid="JHN 12:42"/><verse number="43" style="v" sid="JHN 12:43"/>kiyollahoile hitara Allattu tarifottuwaro mainšottu tarifore beši muhabbot gorito.<verse eid="JHN 12:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44"/>Bade Isaye guzori uiṭṭe, <char style="wj">"Hite ze ãr uwore biššaš ane, hite ãr uwore no, kintu ze ãre defeṛaiye, hibar uwore biššaš ane. </char> <verse eid="JHN 12:44"/><verse number="45" style="v" sid="JHN 12:45"/><char style="wj">Ze ãre deke, hite hibare deke, ze ãre defeṛaiye.</char> <verse eid="JHN 12:45"/><verse number="46" style="v" sid="JHN 12:46"/><char style="wj">Ãi ei duniyait nur hisabe aišši, zene ze kiye ãr uwore biššaš ane, hite andarot no take.</char><verse eid="JHN 12:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 12:47"/>
    <char style="wj">"Hite ze ãr kalam fune edde hin falon no gore, ãi nize hitar bisar no gori, kiyollahoile ãi duniyair bisar goribolla no, bolke duniyaire uddar goribolla, aišši.</char> <verse eid="JHN 12:47"/><verse number="48" style="v" sid="JHN 12:48"/><char style="wj">Ze ãre hela gore edde ãr hota no gose, hitalla ek bisarhar ase; ãi ze kalam hoiyi, šeš dinot hiyane hitar bisar goribo. </char> <verse eid="JHN 12:48"/><verse number="49" style="v" sid="JHN 12:49"/><char style="wj">Kiyollahoile ãi to nizottu hono kissu no hoi, kintu ki howa foribo edde kengori howa foribo, hin Baf ze ãre defeṛaiye, hibaye ãre hokum diye.</char> <verse eid="JHN 12:49"/><verse number="50" style="v" sid="JHN 12:50"/><char style="wj">Ar ãi zani ze, hibar hokum oilde akeri zibon; hetolla ãi zin hoi, Bafe ãre zendilla hoiye, hendilla hoi." </char><verse eid="JHN 12:50"/></para>
  <chapter eid="JHN 12"/>
  <chapter number="13" style="c" sid="JHN 13"/>
  <para style="s">Sahabi okkolor ṭeng duwai diye</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1"/>Uddar idor ekka gori age, Isa ei duniyaittu hibar Bafor hãse zaibar ṭaim aišše zaniyore, ei duniyait zara hibar nizor manuš aššil, zarare hibaye beši ador gorito, hitarare hibaye šeš foijjonto ador goijje.<verse eid="JHN 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2"/>Ar raitor hána haibar ṭaimot, hibare dorai dibolla šoitane Simonor fut Iskariyoti Ehudar dilot issa zuhai dil. <verse eid="JHN 13:2"/><verse number="3" style="v" sid="JHN 13:3"/>Isattu zana aššil ze, Bafe hár kissu hibar hatot diye, ar hiba Allar torfottu aišše, edde hiba Allar hãse firi zargoi; <verse eid="JHN 13:3"/><verse number="4" style="v" sid="JHN 13:4"/>toi hiba hánar ṭebilottu uiṭṭe, edde uworor hoorgan kulifelaiye, ar ekkan toila loiyore nizor kĩyailot beraiye. <verse eid="JHN 13:4"/><verse number="5" style="v" sid="JHN 13:5"/>Tarfore hibaye ek galat fani ḍaille edde hibar sahabi okkolor ṭeng duwai diya šuru goijje edde hibaye kĩyailot ze toila berail hiyan loi ṭeng fũsi diye.<verse eid="JHN 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 13:6"/>Toi hiba Simon Fitoror ḍake zehon aišše, toi hite hodde, "Malik, õne ãre ṭeng duwai diba?"<verse eid="JHN 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7"/>Zuwabe Isaye hitare hodde, <char style="wj">"Ãi zin gorir hin tui ehon buzi no faror, kintu fore iyan buzi faribi." </char><verse eid="JHN 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8"/>Fitore hodde, "No, õne honodin ãr ṭeng no duiyo."</para>
  <para style="p" vid="JHN 13:8">Zuwabe Isaye hodde, <char style="wj">"Zodi tore ãi no dui, toile ãr loi tor hono bag nai."</char><verse eid="JHN 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9"/>Simon Fitore hibare hodde, "Malik, toile šude ãr ṭeng no, kintu ãr hat edde mata o dui do."<verse eid="JHN 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10"/>Isaye hitare hodde,<char style="wj">"Ze gusol goijje, ṭeng duwa sara hitattu ar hono kissur dorhar nai, hitar agagura foriškar, hite Pak fobitro. Ar tũwara Pak fobitro, kintu beggune no."</char> <verse eid="JHN 13:10"/><verse number="11" style="v" sid="JHN 13:11"/>Kiyollahoile ze hibare dorai dibo hitare hibaye sinito, hetolla hibaye "tũwara beggune foriškar no" hen hoiyede.<verse eid="JHN 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12"/>Ar zehon hitarare ṭeng duwai diya šeš oiye, toi hibaye hor gat diye bade boišše. Toi hibaye hitarare hodde, <char style="wj">"Ãi tũwarare ki gorilam zano ne?</char> <verse eid="JHN 13:12"/><verse number="13" style="v" sid="JHN 13:13"/><char style="wj">Tũwara ãre ustad, Malik, hoi ḍaki tako, ar gorode hiyan o bala, kiyollahoile ãi hen oi.</char> <verse eid="JHN 13:13"/><verse number="14" style="v" sid="JHN 13:14"/><char style="wj">Bala, ãi malik edde ustad oi bade o tũwarar ṭeng duwai dilam, henot tũwara o ekzone ar ekzonore ṭeng duwai diya zoruri.</char> <verse eid="JHN 13:14"/><verse number="15" style="v" sid="JHN 13:15"/><char style="wj">Kiyollahoile ãi tũwarare mesal dehailam, zene ãi tũwaralla zen goijji, tũwara o hendilla goro.</char> <verse eid="JHN 13:15"/><verse number="16" style="v" sid="JHN 13:16"/><char style="wj">Ãi tũwarare soiyi soiyi hoir, gulam hitar nizor malikottuwaro boro no, ze defeṛaiye hibattuwaro zare defeṛa oiye hiba boro no.</char> <verse eid="JHN 13:16"/><verse number="17" style="v" sid="JHN 13:17"/><char style="wj">Ehon, tũwara in okkol zano, ar hin okkol zodi goro, toile tũwarar mubarok.</char><verse eid="JHN 13:17"/></para>
  <para style="s">Isaye dorai doyar babute hor</para>
  <para style="r">(<ref loc="MAT 26:20-25">Moti 26:20-25</ref>; <ref loc="MRK 14:17-21">Mark 14:17-21</ref>; <ref loc="LUK 22:21-23">Luk 22:21-23</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18"/>
    <char style="wj">"Ãi tũwara beggunor hota no hoir; ãi hontarare ãlla basona goijji ãi zani. Kintu kitabor ei kalam furon owa forer: 'Ze ãr ruṭi hár, hite ãr berudde formuri tuille.'</char><verse eid="JHN 13:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 13:19"/>
    <char style="wj">"In goṭibar agottu ãi tũwarare hoi rakir, zene zẽtte in goṭibo hẽtte tũwara biššaš goro ze, ãi hiba.</char> <verse eid="JHN 13:19"/><verse number="20" style="v" sid="JHN 13:20"/><char style="wj">Ãi tũwarare soiyi soiyi hoir, ãi zare defeṛai, hitare ze gose, hite ãre gose, ãre ze gose, hite hibare gose, ze ãre defeṛaiye."</char><verse eid="JHN 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21"/>Ei hota hoi bade Isar dilot hoisali oiye, ar goba diye, <char style="wj">"Ãi tũwarare soiyi soiyi hoir, tũwarar butottu ekzone ãre dorai dibo."</char><verse eid="JHN 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22"/>Sahabi okkole ekzone ar ekzonor uzu sa šuru goijje, ar ṭik buzi no faijjil hibaye har babute hoiyede. <verse eid="JHN 13:22"/><verse number="23" style="v" sid="JHN 13:23"/>Hetunot Isar sahabi okkolor butottu ekzon, zare Isaye muhabbot gorito, hite hibar kulot elan di boiššil. <verse eid="JHN 13:23"/><verse number="24" style="v" sid="JHN 13:24"/>Hetunot Simon Fitore išara goijjil edde hodde, "Hibaye zar babute hor, hiba honnuwa?"<verse eid="JHN 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25"/>Hetunot hite Isar mikka zúkdiyore hodde, "Malik, iba honnuwa?"<verse eid="JHN 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26"/>Isaye zuwab diye, <char style="wj">"Ei ruṭir ṭuragan buraiyore ãi zare diyum, iba oilde hite."</char> Toi hibaye ruṭir ṭuragan buraiyore Iskariyoti Simonor fut Ehudare diye. <verse eid="JHN 13:26"/><verse number="27" style="v" sid="JHN 13:27"/>Ehudaye ruṭir ṭuragan fai mottor Šoitan hitar butore góille.</para>
  <para style="p" vid="JHN 13:27">Isaye hitare hodde, <char style="wj">"Tui zin goribi hin toratori gor."</char> <verse eid="JHN 13:27"/><verse number="28" style="v" sid="JHN 13:28"/>Hána haito boiššede hitarar honokiye buzi no fare hon bafe hibaye hitare iyan hoiye. <verse eid="JHN 13:28"/><verse number="29" style="v" sid="JHN 13:29"/>Ehudar hãse ṭiyar tolir zimma aššilde hetolla, kiye kiye mone goijje, Isaye hitare idolla zin zin lage kini angoi otóba gorib okkolore kissu dan goribolla hor. <verse eid="JHN 13:29"/><verse number="30" style="v" sid="JHN 13:30"/>Ruṭir ṭuragan loi mottor hite hehon baire giye. Ar hẽtte aššilde rait.<verse eid="JHN 13:30"/></para>
  <para style="s">Isar noya hokum</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31"/>Hite zaigoi bade, Isaye hodde, <char style="wj">"Ehon Adomor Fut mohimawala oiye, ar Allah hibar butore mohimawala oiye.</char> <verse eid="JHN 13:31"/><verse number="32" style="v" sid="JHN 13:32"/><char style="wj">Allah zodi Adomor Futor butore mohimawala oiye, hetunot Allaye o hibare hibar nizor butore mohimawala goribo, ar hara hibare mohimawala goribo.</char><verse eid="JHN 13:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 13:33"/>
    <char style="wj">"Ãr fuwain okkol, ehon o olfo ṭaimolla, tũwarar fũwati ãi asi. Tũwara ãre tuwaiba, ar ãi Ihudi okkolore zen hoilam, hendilla tũwarare ãi ehon hoir: Ãi zeṛe zair, heṛe tũwara ai no fariba.</char><verse eid="JHN 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 13:34"/>
    <char style="wj">"Ek noya hokum ãi tũwarare dir: Tũwara ekzone ekzonore ador goro. Ãi zendilla tũwarare ador goijji, tũwara o hendilla ekzonore ekzone ador goro.</char> <verse eid="JHN 13:34"/><verse number="35" style="v" sid="JHN 13:35"/><char style="wj">Tũwara zodi ekzonore ekzone ador goro, toile beggune zanibo ze tũwara ãr sahabi okkol."</char><verse eid="JHN 13:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36"/>Simon Fitore hibare hodde, "Malik, õne hoṛe zaibagoide?"</para>
  <para style="p" vid="JHN 13:36">Zuwabe Isaye hodde, <char style="wj">"Ãi zeṛe zair, heṛe tui ehon ãr fisa loi ai no faribi, kintu fore tui o heṛe aibi."</char><verse eid="JHN 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37"/>Fitore hodde, "Malik, ãi ehon kiyolla õnor fisa loi no fariyumde? Ãi õnolla ãr foran diyum."<verse eid="JHN 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38"/>Zuwabe Isaye hodde, <char style="wj">"Tui ki soiyi ãlla tor foran dibi? Ãi tore soiyi soiyi hoir, rata kuraye bak no dite, tui ãre tin bar ošikar goribi!</char><verse eid="JHN 13:38"/></para>
  <chapter eid="JHN 13"/>
  <chapter number="14" style="c" sid="JHN 14"/>
  <para style="s">He soiyi, he fõt edde he zibon</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1"/>
    <char style="wj">"Tũwarar dil ferešan no ok, Allare biššaš goro, ar ãre o biššaš goro. </char> <verse eid="JHN 14:1"/><verse number="2" style="v" sid="JHN 14:2"/><char style="wj">Ãr bafor górot takibar zaga beši ase; ar zodi no takito, ãi tũwarare hoitam; ãi tũwaralla zaga tiyar goitto zair.</char> <verse eid="JHN 14:2"/><verse number="3" style="v" sid="JHN 14:3"/><char style="wj">Ar ãi zẽtte zaiyum edde tũwaralla zaga tiyar gori, ãi abar aiššum edde tũwarare ãr hãse loi zaiyum, zene ãi zeṛe, tũwara o heṛe oi faro.</char> <verse eid="JHN 14:3"/><verse number="4" style="v" sid="JHN 14:4"/><char style="wj">Ãi hoṛe zair heṛe zade fõt to tũwara sino."</char><verse eid="JHN 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5"/>Ṭomase hibare hodde, "Malik, õne hoṛe zorgoi hiyan ãra no zani, ar henot kengori fõt zaniyum?"<verse eid="JHN 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6"/>Isaye hodde,<char style="wj">"Ãi oi he fõt, he soiyi edde he zibon, ãr butottu di no gile, honokiye Bafor hãse ai no fare.</char> <verse eid="JHN 14:6"/><verse number="7" style="v" sid="JHN 14:7"/><char style="wj">Zodi tũwara ãre zanita, toile ãr Bafore o zanita, ar ehon oite tũwara hibare zainno edde hibare deikko."</char><verse eid="JHN 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8"/>Filipe hodde, "Malik, Bafore ãrare deho, henot hiyan ãralla beši oibo."<verse eid="JHN 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9"/>Isaye hitare hodde, <char style="wj">"Filip, ãi eto din tũwarar fũwati asi, ar tarfore o ki ãre no sinili? Hite ze ãre deikke hite Bafore o deikke. Tui tarfore o ken gori hoi faror, 'Bafore ãrare dehao'!</char> <verse eid="JHN 14:9"/><verse number="10" style="v" sid="JHN 14:10"/><char style="wj">Tui ki biššaš no goros ze ãi Bafor butore asi edde baf ãr butore asede? Ãi tũwarare ze hár hota okkol hoi, hin ãr nizottu no hoi, kintu Baf, ze ãr butore taker, hiba nize ham gore.</char> <verse eid="JHN 14:10"/><verse number="11" style="v" sid="JHN 14:11"/><char style="wj">Ãre biššaš gor, ze ãi Bafor butore, ar Baf ãr butore ase; ar no oile, ãr hamolla oile o biššaš gor.</char> <verse eid="JHN 14:11"/><verse number="12" style="v" sid="JHN 14:12"/><char style="wj">Ãi tũwarare soiyi soiyi hoir, hite ze ãr uwore biššaš ane, ãi ze hár ham okkol gori, hite o he ham okkol goribo, oi, in okkolottuwaro ḍõr ham okkol hite goribo, kiyollahoile ãi Bafor heṛe zairgoi.</char> <verse eid="JHN 14:12"/><verse number="13" style="v" sid="JHN 14:13"/><char style="wj">Ar tũwara ãr name za kissu saiba, ãi hin goriyum, zene Bafore Futor butore mohimawala gora o.</char> <verse eid="JHN 14:13"/><verse number="14" style="v" sid="JHN 14:14"/><char style="wj">Ãr name zodi tũwara hono kissu so, ãi hiyan goriyum.</char><verse eid="JHN 14:14"/></para>
  <para style="s">Pak Ruhur babute wada</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15"/>
    <char style="wj">"Tũwara zodi ãre ador goro, toile ãr hokum okkol falon goro.</char> <verse eid="JHN 14:15"/><verse number="16" style="v" sid="JHN 14:16"/><char style="wj">Ãi ãr Bafottu saiyum, ar hibaye ar ekzon modot goroya defeṛaibo, ze tũwarar fũwati hamiša takibo.</char> <verse eid="JHN 14:16"/><verse number="17" style="v" sid="JHN 14:17"/><char style="wj">Hiba soiyir Ruh, duniyaiye hibare gosi no fare. Kintu tũwara hibare sino, kiyollahoile hiba tũwarar fũwati take ar tũwarar dilot takibo.</char> <verse eid="JHN 14:17"/><verse number="18" style="v" sid="JHN 14:18"/><char style="wj">Ãi tũwarare etim raki no zaiyum, ãi tũwarar hãse aiššum.</char> <verse eid="JHN 14:18"/><verse number="19" style="v" sid="JHN 14:19"/><char style="wj">Hara, duniyaiye ãre ar no dekibo, kintu tũwara dekiba, kiyollahoile ãi zinda asi, tũwara o zinda takiba.</char> <verse eid="JHN 14:19"/><verse number="20" style="v" sid="JHN 14:20"/><char style="wj">He din tũwara buzi fariba ze, ãi Bafor butore, ar tũwara ãr butore aso, edde ãi tũwarar butore asi.</char> <verse eid="JHN 14:20"/><verse number="21" style="v" sid="JHN 14:21"/><char style="wj">Hite ze ãr hokum zane edde falon gore, hite ãre ador gore; ar ze ãre ador gore, ãr Bafe o hitare ador goribo. Oi, ãi o hitare ador goriyum, edde nizore hitar hãse forhaš goriyum."</char><verse eid="JHN 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22"/>Hetunot Ehudaye (Iskariyote no) hibare hodde, "Malik, õne šude ãrar hãse kiyolla forhaš goribade, duniyair hãse kiyolla no?"<verse eid="JHN 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23"/>Isaye zuwab diye, <char style="wj">"Hite ze ãre ador gore, hite ãr kalam falon goribo; ar ãr Bafe hitare ador goribo, edde ãra hitar hãse aiššum ar hitar hãse bošoti goijjum.</char> <verse eid="JHN 14:23"/><verse number="24" style="v" sid="JHN 14:24"/><char style="wj">Hite ze ãre ador no gore, hite ãr kalam falon no gore; ar ze kalam okkol tũwara funor, hin ãr no, kintu Bafor, ze ãre defeṛaiye.</char><verse eid="JHN 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25"/>
    <char style="wj">"In okkol ãi tũwarar fũwati takite hoilam.</char> <verse eid="JHN 14:25"/><verse number="26" style="v" sid="JHN 14:26"/><char style="wj">Kintu he Modotgoroya, Pak Ruh, zare Bafe ãr name defeṛaibo, hibaye tũwarare hár kissu šikka dibo edde ãi tũwarare zin zin hoiyi hin okkol beggun tũwarare monot gori dibo.</char> <verse eid="JHN 14:26"/><verse number="27" style="v" sid="JHN 14:27"/><char style="wj">Ãi tũwaralla šanti raki zair; ãr šanti ãi tũwarare dir; duniyaiye dede he mozin ãi no di. Tũwarar dilot ferešani no ok, edde ḍor no golok.</char><verse eid="JHN 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 14:28"/>
    <char style="wj">"Tũwara ãi hoiyide fuinno, 'Ãi zaiyumboi edde abar tũwarar hãse firi aiššum.' Tũwara zodi ãre ador gorita, toile tũwara kuši oita, ze ãi ãr Bafor hãse zair, kiyollahoile Baf ãttuwaro mohan.</char> <verse eid="JHN 14:28"/><verse number="29" style="v" sid="JHN 14:29"/><char style="wj">In okkol goṭibar age ãi tũwarare hoi rakilam, toi zene in zẽtte goṭibo tũwara biššaš gori faro.</char> <verse eid="JHN 14:29"/><verse number="30" style="v" sid="JHN 14:30"/><char style="wj">Ãi tũwara loi ar beši hotun hota no hoiyum; kiyollahoile duniyair šašon goroya aiyer, ãr uwore hitar hono odihar nai,</char> <verse eid="JHN 14:30"/><verse number="31" style="v" sid="JHN 14:31"/><char style="wj">kintu duniyaiye zene zani fare ze, ãi Bafore ador gori, edde Bafe ãre hokum diyede he mozin ãi gori.</char></para>
  <para style="p" vid="JHN 14:31">
    <char style="wj">"Aiyo, ãra enttu zaigoi."</char><verse eid="JHN 14:31"/></para>
  <chapter eid="JHN 14"/>
  <chapter number="15" style="c" sid="JHN 15"/>
  <para style="s">He asoli ãngur gas</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1"/>
    <char style="wj">"Ãi he asoli ãngur gas, edde ãr Baf bagan šaši.</char> <verse eid="JHN 15:1"/><verse number="2" style="v" sid="JHN 15:2"/><char style="wj">Ãr fotti ḍeila zinot gula no dorer, hinore hibaye haṛi fele, ar fotti ḍeila zinot gula dorer, hinore hibaye šaṛiyore foriškar gore, zene aro beši gula dore.</char> <verse eid="JHN 15:2"/><verse number="3" style="v" sid="JHN 15:3"/><char style="wj">Ãi tũwarare ze kalam hoilam hinor zoriya tũwara beggune age foriškar oiyo.</char> <verse eid="JHN 15:3"/><verse number="4" style="v" sid="JHN 15:4"/><char style="wj">Ãr butore tako, toi ãi o tũwarar butore taki; zendilla ḍeilaye nize gula dorai no fare, zodi ãngur gas loi laigga no take, hendilla tũwara o ãr butore no takile gula dorai no fariba.</char><verse eid="JHN 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5"/>
    <char style="wj">"Ãi ãngur gas; tũwara ḍeila okkol; hite ze ãr butore, ãi hitar butore taki, ar hite beši gula doraibo; kiyollahoile ãre sara tũwara kissu gori no faro.</char> <verse eid="JHN 15:5"/><verse number="6" style="v" sid="JHN 15:6"/><char style="wj">Hite ze ãr butore no take, hitare ḍeila felaidefan baire felaidiya oibo edde fuwai zaiboi, ar hinore dola gori oinot felaidiya o edde hinore furifela o. </char> <verse eid="JHN 15:6"/><verse number="7" style="v" sid="JHN 15:7"/><char style="wj">Zodi tũwara ãr butore tako, ar ãr kalam tũwarar butore take, tũwara za issa mago, hin tũwaralla gora oibo.</char> <verse eid="JHN 15:7"/><verse number="8" style="v" sid="JHN 15:8"/><char style="wj">Iyanot ãr Baf mohimawala o, ze tũwara beši fól dorao, edde tũwara ãr sahabi forman oiba.</char><verse eid="JHN 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 15:9"/>
    <char style="wj">"Bafe zendilla ãre ador goijje, ãi o tũwarare ador goijji; tũwara ãr adorot tako. </char> <verse eid="JHN 15:9"/><verse number="10" style="v" sid="JHN 15:10"/><char style="wj">Tũwara zodi ãr hokum okkol falon goro, toile tũwara o ãr adorot takiba, zendilla ãi o ãr Bafor hár hokum okkol falon goriyore hibar adoror butore taikki.</char> <verse eid="JHN 15:10"/><verse number="11" style="v" sid="JHN 15:11"/><char style="wj">In okkol ãi tũwarare hoilam, zene tũwarar dilot ãr anondo take edde tũwarar anondo furafuri furon o. </char> <verse eid="JHN 15:11"/><verse number="12" style="v" sid="JHN 15:12"/><char style="wj">Ãr hokum oilde ei: Tũwara ekzone oinnozonore ador goro, zendilla ãi tũwarare ador goijji.</char> <verse eid="JHN 15:12"/><verse number="13" style="v" sid="JHN 15:13"/><char style="wj">Hono ekzone hitar bondu okkololla nizor zibon de, hiyanottuwaro mohan ador kissu nai. </char> <verse eid="JHN 15:13"/><verse number="14" style="v" sid="JHN 15:14"/><char style="wj">Tũwarare ãi ze hokum okkol dir, hin zodi falon goro, toile tũwara ãr bondu okkol.</char> <verse eid="JHN 15:14"/><verse number="15" style="v" sid="JHN 15:15"/><char style="wj">Ãi tũwarare ar gulam no ḍakir, kiyollahoile malike ki gore, gulame hiyan no zane, ar ãi tũwarare bondu ḍaikki, kiyollahoile hár kissu zin ãr Bafor hãsottu fuinni, hin tũwarare zanaiyi.</char> <verse eid="JHN 15:15"/><verse number="16" style="v" sid="JHN 15:16"/><char style="wj">Tũwara ãre basi no lo, kintu ãi tũwarare basi loiyi, ar buwayi zene tũwara zo edde gula dorao, gula zene ṭiki take, toi zene tũwara ãr name Bafor hãse za kissu saiba, hin hibaye tũwarare de. </char> <verse eid="JHN 15:16"/><verse number="17" style="v" sid="JHN 15:17"/><char style="wj">Ei oilde ãr hokum tũwaralla: Ekzonore ekzone ador goro.</char><verse eid="JHN 15:17"/></para>
  <para style="s">Duniyaiye zẽtte tũwarare hingša gore</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18"/>
    <char style="wj">"Duniyaiye zodi tũwarare hingša gore, tũwara to zano, hiyane tũwarar age ãre hingša goijje.</char> <verse eid="JHN 15:18"/><verse number="19" style="v" sid="JHN 15:19"/><char style="wj">Tũwara zodi duniyair oita, toile duniyaiye tũwarare nizor hoi ador goitto; kintu tũwara zehon duniyair no, bolke ãi tũwarare duniyaittu basi loiyi, etolla duniyaiye tũwarare hingša gore.</char> <verse eid="JHN 15:19"/><verse number="20" style="v" sid="JHN 15:20"/><char style="wj">Ãr ei hota tũwara monot raikko: Ekzon gulam hitar malikottuwaro ḍõr no: hitara zodi ãre zulum goijje, toile tũwarare o hitara zulum goribo; ar hitara zodi ãr kalam falon gorito, hitara tũwarargun o funito.</char> <verse eid="JHN 15:20"/><verse number="21" style="v" sid="JHN 15:21"/><char style="wj">Kintu hitara ãr namolla boli tũwarare in okkol goribo, kiyollahoile ãre ze defeṛaiye, hibare hitara no zane.</char> <verse eid="JHN 15:21"/><verse number="22" style="v" sid="JHN 15:22"/><char style="wj">Ãi zodi nu aitam edde hitarar hãse no hoitam, toile hitara hosuri sara oito; kintu ehon hitarar gunar kofiyot dibolla hono rasta nai.</char> <verse eid="JHN 15:22"/><verse number="23" style="v" sid="JHN 15:23"/><char style="wj">Hite ze ãre hingša gore, hite ãr Bafore o hingša gore. </char> <verse eid="JHN 15:23"/><verse number="24" style="v" sid="JHN 15:24"/><char style="wj">Ãi zodi hendilla ham okkol gori no dehaitam, zin oinno honokiye no gore, toile hitarattu guna no oito; kintu ehon hitara ãr ham okkol deikke, ar ãre edde ãr Bafore hingša gorer. </char> <verse eid="JHN 15:24"/><verse number="25" style="v" sid="JHN 15:25"/><char style="wj">Kintu endilla oiye, zene hitarar ainot ziyan leka ase hiyan furon o: 'Hitara hono kissu sara ãre hingša goijje.' </char><verse eid="JHN 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26"/>
    <char style="wj">"Modot goroya zẽtte aibo, zare ãi Bafor hentu tũwarar hãse defeṛaiyum, soiyir he Ruh, ze Bafor hentu niyoli zar, hibaye ãr babute goba dibo. </char> <verse eid="JHN 15:26"/><verse number="27" style="v" sid="JHN 15:27"/><char style="wj">Ar tũwara o ãr goba, kiyollahoile tũwara šuruttu loti ãr fũwati aso. </char><verse eid="JHN 15:27"/></para>
  <chapter eid="JHN 15"/>
  <chapter number="16" style="c" sid="JHN 16"/>
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1"/>
    <char style="wj">"In okkol ãi tũwarare hoilam, zene tũwara fori no zogoi.</char> <verse eid="JHN 16:1"/><verse number="2" style="v" sid="JHN 16:2"/><char style="wj">Hitara tũwarare sinagogottu niyolai dibo; enki, en ṭaim aiyer, zẽtte tũwarare ze hono kiye marifelaibo, hite mone goribo, ze hiyan hitara Allare ek šeba der.</char> <verse eid="JHN 16:2"/><verse number="3" style="v" sid="JHN 16:3"/><char style="wj">Hitara endilla goribo, kiyollahoile hitara no Bafore zane, ar no ãre zane.</char> <verse eid="JHN 16:3"/><verse number="4" style="v" sid="JHN 16:4"/><char style="wj">Ãi tũwarare in okkol hoilam, zene hitarar ṭaim zẽtte aibo, tũwarar monot take ze ãi tũwarare hitarar babute hoiyi. Ãi tũwarare in age no hoi, kiyollahoile ãi tũwarar fũwati aššilam,</char> <verse eid="JHN 16:4"/><verse number="5" style="v" sid="JHN 16:5"/><char style="wj">kintu ehon ãi zairgoi, ze ãre defeṛaiye hibar heṛe. Ar tũwarar honokiye ãre fusar o no goror, 'Tũi hoṛe zodde?'</char> <verse eid="JHN 16:5"/><verse number="6" style="v" sid="JHN 16:6"/><char style="wj">Bolke ãi tũwarare in okkol hoi boli tũwarar dil dukke bori uiṭṭe.</char> <verse eid="JHN 16:6"/><verse number="7" style="v" sid="JHN 16:7"/><char style="wj">Kintu ãi tũwarare soiyi hoir, ãi zairgoide hiyan tũwaralla bala, kiyollahoile ãi no zailegoi, he modot goroya tũwarar hãse no aibo; kintu ãi zodi zaigoi, toi hibare tũwarar hãse faṭai diyum.</char> <verse eid="JHN 16:7"/><verse number="8" style="v" sid="JHN 16:8"/><char style="wj">Ar hiba aiyore gunar babute, soiyir babute edde forhesgarir babute, duniyaire golti dehai dibo:</char> <verse eid="JHN 16:8"/><verse number="9" style="v" sid="JHN 16:9"/><char style="wj">gunar zoriya, hitara ãr uwore biššaš no ane.</char> <verse eid="JHN 16:9"/><verse number="10" style="v" sid="JHN 16:10"/><char style="wj">edde forhesgarir babute, kiyollahoile ãi Bafor heṛe zair, ar tũwara ãre ar no dekiba;</char> <verse eid="JHN 16:10"/><verse number="11" style="v" sid="JHN 16:11"/><char style="wj">ar Bisar babute, kiyollahoile ei duniyair šašon goroyar bisar oigiyegoi.</char><verse eid="JHN 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12"/>
    <char style="wj">"Tũwarare ãttu bout kissu hoibar ase, kintu tũwara ehon hin bordaš gori no fariba.</char> <verse eid="JHN 16:12"/><verse number="13" style="v" sid="JHN 16:13"/><char style="wj">Ar zẽtte hiba, he soiyir Ruh, aibo, hẽtte hibaye fõt dehaiyore tũwarare hár soyit loizaibo; kiyollahoile hibaye hiba nizottu hota no hoibo, kintu zin funibo hin hoibo, edde sarme goṭibode hin okkol tũwarare hoibo.</char> <verse eid="JHN 16:13"/><verse number="14" style="v" sid="JHN 16:14"/><char style="wj">Hibaye ãre mohimawala goribo, kiyollahoile hibaye ãrgun loibo, edde tũwarare zanai dibo.</char> <verse eid="JHN 16:14"/><verse number="15" style="v" sid="JHN 16:15"/><char style="wj">Ar Bafottu zin zin ase, beggun ãr; etolla ãi hoiyi, ze hibaye ãrgun loibo edde tũwarare zanai dibo."</char><verse eid="JHN 16:15"/></para>
  <para style="s">Ferešani edde Anondo</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16"/>
    <char style="wj">"Olfo ṭaimor butore tũwara ãre ar no dekiba, toi tarfore abar olfo ṭaimor butore tũwara ãre dekiba."</char><verse eid="JHN 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17"/>Henot hibar sahabi okkol ho ekzone ekzonore ekzone hodde, "Ibaye ãrare in ki hor, <char style="wj">'Olfo ṭaimor butore tũwara ãre ar no dekiba, tarfore abar olfo ṭaimor butore tũwara ãre dekiba,' </char> ar, <char style="wj">'Ãi Bafor hãse zair'?</char> <verse eid="JHN 16:17"/><verse number="18" style="v" sid="JHN 16:18"/>Toi hitara hodde, "Hibaye <char style="wj">'olfo ṭaimor butore'</char> hoi ki hodde? Hibaye ki hor ãra buzi no farir."<verse eid="JHN 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19"/>Isaye deikke ze hitara ei babute fusar goitto sar, toi hibaye hitarare hodde, <char style="wj">"Tũwara ki ei babute howahoi goror ze ãi hoilam, 'Olfo ṭaimor butore tũwara ãre ar no dekiba, tarfore abar olfo ṭaimor butore tũwara ãre dekiba'?</char> <verse eid="JHN 16:19"/><verse number="20" style="v" sid="JHN 16:20"/><char style="wj">Ãi tũwarare soiyi hoir, tũwara handiba edde bilag goriba, kintu duniyaiye anondo goribo; tũwara ferešan oiba, kintu tũwarar ferešani anondo oi zaibogoi. </char> <verse eid="JHN 16:20"/><verse number="21" style="v" sid="JHN 16:21"/><char style="wj">Fuwa oibar šomot mayafuwaye duk fa, kiyollahoile hibar ṭaim aišše, kintu hibar fuwa zormo oi bade, ekzon noya manuš duniyait aišše, ei anondoye hibattu ar he bišor hota monot no take.</char> <verse eid="JHN 16:21"/><verse number="22" style="v" sid="JHN 16:22"/><char style="wj">Hendilla tũwara o ehon duk for, kintu ãi tũwara loi abar deha oiyum, ar tũwarar dile anondo goribo, edde tũwarar he anondo honokiye no loi zaibo.</char> <verse eid="JHN 16:22"/><verse number="23" style="v" sid="JHN 16:23"/><char style="wj">He din tũwara ãttu hono kissu suwal goribolla no takibo; soiyi soiyi, ãi tũwarare hoir, tũwara Bafor hãse zodi kissu so, hibaye ãr name tũwarare hin dibo.</char> <verse eid="JHN 16:23"/><verse number="24" style="v" sid="JHN 16:24"/><char style="wj">Ehon foijjonto tũwara ãr name kissu no so. So, tũwara faiba, toi tũwarar anondo furafuri furon oibo.</char><verse eid="JHN 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25"/>
    <char style="wj">"Zodi o ãi tũwarare in okkol mesalor duwara hoilam, kintu en ṭaim aiyer zẽtte ãi ar mesalor duwara hota no hoiyum, kintu kulasa gori Bafor babute hoiyum.</char> <verse eid="JHN 16:25"/><verse number="26" style="v" sid="JHN 16:26"/><char style="wj">He din tũwara ãr name saiba, ar ãi tũwarare no hoir, ze ãi tũwaralla Bafor hãse foriyad goriyum.</char> <verse eid="JHN 16:26"/><verse number="27" style="v" sid="JHN 16:27"/><char style="wj">Kiyollahoile Baf nize tũwarare ador gore, kiyollahoile tũwara ãre ador goror edde biššaš goijjo ze ãi Allar hentu aišši.</char> <verse eid="JHN 16:27"/><verse number="28" style="v" sid="JHN 16:28"/><char style="wj">Ãi Bafor hentu ei duniyait aišši, ei duniyai ãi abar eri zairgoi edde Bafor heṛe zair."</char><verse eid="JHN 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29"/>Hetunot Isar sahabi okkole hodde, "So, õne ehon to kulasa gori hota hor, mesalor duwara no hor. <verse eid="JHN 16:29"/><verse number="30" style="v" sid="JHN 16:30"/>Ehon ãra buzi faijji ze õne beggun zano edde õnore honokiye suwal fusar gorok o dorhar nai. iyanot ãra biššaš goijji ze õne Allar hentu aiššo."<verse eid="JHN 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31"/>Isaye zuwabe hodde, <char style="wj">"Henoile ki ehon biššaš goror?</char> <verse eid="JHN 16:31"/><verse number="32" style="v" sid="JHN 16:32"/><char style="wj">En ṭaim aiyer, enki aigiyegoi, zẽtte tũwara šiṛašitta oi zaibagoi, ãre halikaga raki ze zar zar zagat hite zaibagoi, tarfore o ãi halikaga no, kiyollahoile Baf ãr fũwati ase.</char><verse eid="JHN 16:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 16:33"/>
    <char style="wj">"Ãi tũwarare in okkol hoilam zene tũwara ãr butore šanti fo. Ei duniyait tũwarattu mosibot takibo, kintu šahoš no haraiyo! Ãi duniyai loi zitti."</char><verse eid="JHN 16:33"/></para>
  <chapter eid="JHN 16"/>
  <chapter number="17" style="c" sid="JHN 17"/>
  <para style="s">Isaye hibargunolla duwa gorer</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1"/>Isaye in okkol hoi bade, asmanor mikka hibar suk tuille, toi hodde:</para>
  <para style="pm" vid="JHN 17:1">
    <char style="wj">"Baf, šomoi aigiyegoi; tũwar Futore mohimawala goro, zene tũwar Fute tũware mohimawala gori fare. </char> <verse eid="JHN 17:1"/><verse number="2" style="v" sid="JHN 17:2"/><char style="wj">Kiyollahoile tũi hibare hár manuš okkolor uwore kemota diyo, zene tũi zarare hibare diyo, hitara beggunore hibaye akeri zibon di fare.</char> <verse eid="JHN 17:2"/><verse number="3" style="v" sid="JHN 17:3"/><char style="wj">Ar iyan oilde akeri zibon: zene hitara tũware, ek matro soiyi Allare, edde hiba zare tũi defeṛaiyo, he Isa Mosire, zane.</char> <verse eid="JHN 17:3"/><verse number="4" style="v" sid="JHN 17:4"/><char style="wj">Tũi ãre ze ham goitto diyo hin ãi šeš goriyore ei duniyait tũware mohimawala goijji.</char> <verse eid="JHN 17:4"/><verse number="5" style="v" sid="JHN 17:5"/><char style="wj">Ar ehon oh Baf, duniyair age tũwar loi ãr ze mohima aššil, tũi he mohima loi ãre tũwar sarme mohimawala goro.</char><verse eid="JHN 17:5"/></para>
  <para style="pm">
    <verse number="6" style="v" sid="JHN 17:6"/>
    <char style="wj">"Duniyaittu zarare tũi ãrare diyo, ãi hitarar hãse tũwar nam forhaš goijji. Hitara tũwar aššil; tũi hitarare ãre diyo, ar hitara tũwar kalam falon goijje.</char> <verse eid="JHN 17:6"/><verse number="7" style="v" sid="JHN 17:7"/><char style="wj">Hitara ehon zani faijje, ze tũi ãre zin diyo, hin tũwar hãsottu.</char> <verse eid="JHN 17:7"/><verse number="8" style="v" sid="JHN 17:8"/><char style="wj">Kiyollahoile tũi ãre ze kalam okkol diyo, hin ãi hitarare diyi, ar hitara hinore goisse, ar soiyi gori zani faijje, ze ãi tũwar hãsottu aišši, ar hitara biššaš goijje ze, tũi ãre defeṛaiyo.</char> <verse eid="JHN 17:8"/><verse number="9" style="v" sid="JHN 17:9"/><char style="wj">Ãi hitaralla foriyad gorir; Ãi duniyailla foriyad no gori, kintu hitaralla gori, zarare tũi ãre diyo; kiyollahoile hitara tũwar.</char> <verse eid="JHN 17:9"/><verse number="10" style="v" sid="JHN 17:10"/><char style="wj">Ãr beggun tũwar, ar tũwattu beggun ãr; ar ãi hitarar duwara mohimawala oiyi.</char> <verse eid="JHN 17:10"/><verse number="11" style="v" sid="JHN 17:11"/><char style="wj">Ãi ar ei duniyait no takiyum, kintu hitara ei duniyait ase, edde ãi tũwar hãse aiyir. Fobitro Baf, tũwar name hitarare hefazot goro, ze nam tũi ãre diyo, toi zene hitara ek oi fare, zendilla ãra ek.</char> <verse eid="JHN 17:11"/><verse number="12" style="v" sid="JHN 17:12"/><char style="wj">Ãi hitarar fũwati taite, ãi hitarare tũwar name hefazotot raikki, ze nam tũi ãre diyo; ãi hitarare fahara di sõli raikki, hitarar butottu honokiye dongšo no o, dongšor fut bade, zene kitabor kalam furon o.</char><verse eid="JHN 17:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="JHN 17:13"/>
    <char style="wj">"Ar ehon ãi tũwar hãse aiyir, kintu in okkol ãi duniyait taite hoir, zene hitara ãr anondo hitara nizor butore furafuri bafe furon o.</char> <verse eid="JHN 17:13"/><verse number="14" style="v" sid="JHN 17:14"/><char style="wj">Ãi hitarare tũwar kalam diyi, kintu duniyaiye hitarare hingša goijje, kiyollahoile hitara duniyair no, zendilla ãi duniyair no.</char> <verse eid="JHN 17:14"/><verse number="15" style="v" sid="JHN 17:15"/><char style="wj">Ãr foriyad iyan no ze tũi hitarare duniyaittu loi zogoi, kintu tũi hitarare he horafottu rokka goro.</char> <verse eid="JHN 17:15"/><verse number="16" style="v" sid="JHN 17:16"/><char style="wj">Hitara duniyair no, zendilla ãi duniyair no.</char> <verse eid="JHN 17:16"/><verse number="17" style="v" sid="JHN 17:17"/><char style="wj">Hitarare soiyi loi fobitro goro; tũwar kalam soiyi.</char> <verse eid="JHN 17:17"/><verse number="18" style="v" sid="JHN 17:18"/><char style="wj">Tũi zendilla ãre duniyait defeṛaiyo, hendilla ãi o hitarare duniyait defeṛaiyi.</char> <verse eid="JHN 17:18"/><verse number="19" style="v" sid="JHN 17:19"/><char style="wj">Hitaralla ãi nizore fobitro goijji, zene hitarare o hitara nizore soyit fobitro oi fare. </char><verse eid="JHN 17:19"/></para>
  <para style="pm">
    <verse number="20" style="v" sid="JHN 17:20"/>
    <char style="wj">"Ãi šude itaralla foriyad no gorir, kintu hitaralla o, zara itarar hotar duwara ãr uwore biššaš anibo,</char> <verse eid="JHN 17:20"/><verse number="21" style="v" sid="JHN 17:21"/><char style="wj">zene hitara beggune ek o; Baf, zendilla tũi ãr butore, ar ãi tũwar butore, hitara o zene hendilla ãrar butore ek take; zene duniyaiye biššaš gore ze, tũi ãre defeṛaiyo.</char> <verse eid="JHN 17:21"/><verse number="22" style="v" sid="JHN 17:22"/><char style="wj">Ar tũi ze mohima ãre diyo, hin ãi hitarare diyi, zene hitara o ãrar ḍoilla ek oi fare; </char> <verse eid="JHN 17:22"/><verse number="23" style="v" sid="JHN 17:23"/><char style="wj">ãi hitarar butore, ar tũi ãr butore, toi zene hitara furafuri bafe ek o; zene duniyaiye zani fare ze, tũi ãre defeṛaiyo, edde tũi ãre zendilla ador goijjo, hendilla hitarare o ador goro.</char><verse eid="JHN 17:23"/></para>
  <para style="pm">
    <verse number="24" style="v" sid="JHN 17:24"/>
    <char style="wj">"Baf, tũi ãre zarare diyo, ãi sai ze ãi zeṛe hitara o ãr fũwati taki fare, zene ze mohima tũi ãre diyo, hitara hiyan deki fare, kiyollahoile duniyai zuron dibar agottu tũi ãre ador goijjo.</char><verse eid="JHN 17:24"/></para>
  <para style="pm">
    <verse number="25" style="v" sid="JHN 17:25"/>
    <char style="wj">"Niyaiwala Baf, duniyaiye zodi o tũware no zane, kintu ãi tũware zani, ar itara zainne ze tũi ãre defeṛaiyo.</char> <verse eid="JHN 17:25"/><verse number="26" style="v" sid="JHN 17:26"/><char style="wj">Ar ãi itarare tũwar nam zanefan goijji edde zanefan goijjum, zene tũi ãre ze ador loi ador goijjo, he ador hitarar butore take, edde ãi hitarar butore taki."</char><verse eid="JHN 17:26"/></para>
  <chapter eid="JHN 17"/>
  <chapter number="18" style="c" sid="JHN 18"/>
  <para style="s">Isare bondi goijje</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1"/>In okkol hoi bade, Isaye hibar sahabi okkolore fũwati loi niyoliyore Kidron zúra farai giye; heṛe ugguwa bagan aššil, hibar butore hiba edde hibar sahabi okkol góille.<verse eid="JHN 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 18:2"/>Ar Ehudah, ze hibare dorai dil, hitattu o he zagagan zana aššil, kiyollahoile Isaye bout bar hibar sahabi okkolore loi heṛe ekottro oito. <verse eid="JHN 18:2"/><verse number="3" style="v" sid="JHN 18:3"/>Hetolla Ehudaye ḍõr imam edde Foroši okkolor hentu ek šoinno dol edde hoekzon hitarar hormosari okkolore ainne, ar hitara uzal edde fanoš edde ostro loi heṛe aišše.<verse eid="JHN 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 18:4"/>Isaye, hibar nizor uwore goṭedde hin okkol zaniyore, hibaye mummikka giye edde hitarare hodde, <char style="wj">"Tũwara hare tuwor?"</char><verse eid="JHN 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5"/>Hitara hibare zuwabe hodde, "Nasarator Isare."</para>
  <para style="p" vid="JHN 18:5">Isaye hodde, <char style="wj">"Ãi Oi."</char> Ar Ehudah, ze hibare dorai der, hite o hitarar fũwati tiyat aššil. <verse eid="JHN 18:5"/><verse number="6" style="v" sid="JHN 18:6"/>Isaye zehon hitarare hoiye, <char style="wj">"Ãi Oi"</char> hetunot hitara fissa giye edde meṛit forigiyegoi.<verse eid="JHN 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 18:7"/>Hibaye hitarare abar fusar goijje,<char style="wj">"Tũwara hare tuwor?" </char></para>
  <para style="p" vid="JHN 18:7">Hitara hodde,"Nasarator Isare."<verse eid="JHN 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8"/>Isaye hodde, <char style="wj">"Ãi to tũwarare hoilam ze, ãi oi. Tũwara zodi ãre tuwor, toile itarare zaito do."</char> <verse eid="JHN 18:8"/><verse number="9" style="v" sid="JHN 18:9"/>Zene hibaye ze hoil hiyan furon o,<char style="wj">"Tũi zarare ãre diyo, ãi hitarar ekzonore no harai." </char><verse eid="JHN 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10"/>Simon Fitor, zattu ekkan suri aššil, hibaye hiyan niyolaiye edde ek ḍõr imamor gulamore hamela gori hitar ḍen han haṛi felaiye. (Gulammuwar nam aššilde Malkos.)<verse eid="JHN 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 18:11"/>Toi Isaye Fitorore hodde, <char style="wj">"Tor suri ḍafor butore rak; ze fiyala Bafe ãre diye hiba ki ãi no fiyum ne?" </char><verse eid="JHN 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12"/>Hetunot he šoinno okkole edde hitarar komonḍar edde Ihudi neta okkolor hormosari okkole Isare gereftar goijje edde bainde, <verse eid="JHN 18:12"/><verse number="13" style="v" sid="JHN 18:13"/>edde foila Isare Annasor heṛe loigiye. Annas aššilde Kaifasor hour, ze he bosoror ḍõr imam aššil. <verse eid="JHN 18:13"/><verse number="14" style="v" sid="JHN 18:14"/>Ar ei Kaifas, ze Ihudi okkolore mošora dil, ekzon mora iyan mainšolla bala.<verse eid="JHN 18:14"/></para>
  <para style="s">Fitoror foila ošikar</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15"/>Simon Fitor edde ar ekzon sahabi Isar fise fise giye. He dusora sahabiwa ḍõr imamor sina aššil, edde Isar fũwati hite ḍõr imamor góror sarme uṛanot góille, <verse eid="JHN 18:15"/><verse number="16" style="v" sid="JHN 18:16"/>kintu Fitor bare dorozar hãse tiyai roiye. Toi ḍõr imamor sina dusora sahabiwaye bare giye edde doroza faharadar mayafuware hoiyore Fitorore butore loigiye. <verse eid="JHN 18:16"/><verse number="17" style="v" sid="JHN 18:17"/>He mayafuwawaye Fitorore hodde, "Tui o ki ei manušwar sahabi okkolor butottu ekzon?"</para>
  <para style="p" vid="JHN 18:17">Fitore hodde, "No, ãi no."<verse eid="JHN 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18"/>Hẽtte beši šit foijjil, hetolla gulam okkol edde faharadar okkole oinor ṭal zaillil edde tiyaiyore oin fuhail. Fitor o hitarar fũwati tiyaiyore oin fuhail.<verse eid="JHN 18:18"/></para>
  <para style="s">Ḍõr imam okkolor zera</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19"/>He šomot ḍõr imame Isattu hibar sahabi okkolor babute edde hibar šikkar babute fusar goijje.<verse eid="JHN 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 18:20"/>Kintu Isaye zuwabe hodde, <char style="wj">"Ãi duniyair sarme kulasa gori hota howat asi. Ãi hamiša sinagog okkolot edde dórmogórot, zeṛe Ihudi okkol beggune ekottro o, heṛe šikka diyat asi. Ãi gufone kissu no hoi.</char> <verse eid="JHN 18:20"/><verse number="21" style="v" sid="JHN 18:21"/><char style="wj">Ãre kiyolla fusar goror? Zara fuinne hitarare fusar goro, ãi hitarare ki hoiyi; so, ãi ki hoiyi hin hitara zane."</char><verse eid="JHN 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22"/>Isaye ei hota hodde ṭaimot, faharadar okkol butottu ekzon ze hibar ḍake tiyat aššil, hite hibare suwar mariyore hodde, "Endilla neki ḍõr imamore zuwab dodde?"<verse eid="JHN 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23"/>Isaye hitare hodde, <char style="wj">"Zodi horaf kissu hoi taki, he horafir goba de, kintu zodi bala hoi taki, toile tui ãre kiyolla maror?"</char> <verse eid="JHN 18:23"/><verse number="24" style="v" sid="JHN 18:24"/>Hetunot Annase banda abostat Isare ḍõr imam Kaifasor hãse defeṛaiye.<verse eid="JHN 18:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25"/>Simon Fitor tiyaiyore oin fuhadde šomot, hitara hibare hodde, "Tui o utar sahabi okkolor butottu ekzon no?"</para>
  <para style="p" vid="JHN 18:25">Hibaye ošikar goijje edde hodde, "No, ãi no."<verse eid="JHN 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26"/>Ḍõr imamor gulam okkolor ekzon, Fitore zar han haṛifelail, hitar ek egenaye hodde, "Ãi ki tore baganot hitar fũwati no deki ne?" <verse eid="JHN 18:26"/><verse number="27" style="v" sid="JHN 18:27"/>Fitore abar ošikar goijje, toi hetunot ugguwa rata kuraye bak diye.<verse eid="JHN 18:27"/></para>
  <para style="s">Filator sarme Isa</para>
  <para style="r">(<ref loc="MAT 27:1-2">Moti 27:1–2</ref>; <ref loc="MAT 11:-1-21">11–21</ref>; <ref loc="MRK 15:1-11">Mark 15:1–11</ref>; <ref loc="LUK 23:1-5">Luk 23:1–5</ref>; <ref loc="LUK 13:-1-20">13–20</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28"/>Bade binna sore hitara Isare Kaifasor hentu Romiyo govarnaror mehelot loigiye. Ar hitara nafak no ofan, edde uddar idor hana hái farefan, hitara nize mehelor butore no gole. <verse eid="JHN 18:28"/><verse number="29" style="v" sid="JHN 18:29"/>Hetolla Filat baire hitarar ḍake aiyore hodde,"Ei manušwar berudde tũwara kiyor hošuri dodde?"<verse eid="JHN 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30"/>Hitara hodde, "Ite horaf ham no gorito boli ãra hitare õnor hãse no anitam."<verse eid="JHN 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31"/>Filate hitarare hodde, "Itare tũwara loizogoi edde tũwara nizor ain mozin bisar gorogoi."</para>
  <para style="p" vid="JHN 18:31">Henot hitara hodde, "Kintu honokiyore moron šaza dibar kemota to ãrar hatot nai." <verse eid="JHN 18:31"/><verse number="32" style="v" sid="JHN 18:32"/>Zene Isar kalam furon o, ziyan hoiyore hibaye dehai dil, hondilla moron hibaye moribo.<verse eid="JHN 18:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33"/>Toi Filat abar mehelot góille edde Isare ḍaki hodde, "Tui ki Ihudi okkolor badša?"<verse eid="JHN 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34"/>Isaye hodde, <char style="wj">"Tũi ki nize ei hota hor, naki oinno kiye tũware ãr babute iyan hoiye?" </char><verse eid="JHN 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35"/>Filate zuwabe hodde, "Ãi ki Ihudi? Tor zati edde ḍõr imam okkole tore ãr hatot tuli diye. Tui ki goijjos?"<verse eid="JHN 18:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36"/>Isaye zuwabe hodde, <char style="wj">"Ãr raijjo ei duniyair no; zodi ãr raijjo ei duniyair oito, toile ãre Ihudi neta okkolor hatot tuli diya no ofan, ãr mainše zuddo gorito, kintu ãr raijjo eṛe no."</char><verse eid="JHN 18:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37"/>Filate Isare hodde, "Toile ki tui badša?"</para>
  <para style="p" vid="JHN 18:37">Isaye hodde, <char style="wj">"Tũi ṭik hoiyo ze, ãi badša. Soiyir foikka goba dibolla ãi zormo oiyi, ar hetolla ãi duniyait aišši. Fottikiye ze soiyir foikka hite ãr hota fune." </char><verse eid="JHN 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38"/>Filate hibare hodde, "Soiyi ki?" Ei hota hoi hite abar bare Ihudi neta okkolor hãse zaiyore hodde, "Ãi ei manušwar hono hosuri no fair. <verse eid="JHN 18:38"/><verse number="39" style="v" sid="JHN 18:39"/>Kintu tũwarar ekkan niyom ase ze, uddar idor ṭaimot ãi tũwarar ekzon hodire tũwaralla eridi. Tũwara ki so ze ãi Ihudi okkolor badšare eridi?"<verse eid="JHN 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40"/>Hitara beggune abar guzori hodde, "No, hitare no! Ãra Barabbasore sai." He Barabbas aššilde ekzon ḍahait.<verse eid="JHN 18:40"/></para>
  <chapter eid="JHN 18"/>
  <chapter number="19" style="c" sid="JHN 19"/>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1"/>Filate Isare loigiye edde beša beši souk maraiye. <verse eid="JHN 19:1"/><verse number="2" style="v" sid="JHN 19:2"/>Šoinno okkole keṛa lota diyore ekkan taz banaiye edde hibar matat buwai diye. Ar hitara hibare ugguwa baiyonna rongor zubba o findai diye. <verse eid="JHN 19:2"/><verse number="3" style="v" sid="JHN 19:3"/>Tarfore hitara hibar hãse zai zai hodde, "Oh Ihudi okkolor badšar hayat lamba ok!" Ar hitara hibare suwar maijje.<verse eid="JHN 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4"/>Filat abar mainšor dolor heṛe niyoli aišše edde Ihudi okkolore hodde, "So, ãi hitare tũwarar hãse niyolai anir zene tũwara buzi faro ze, ãi hitar hono hosuri no fair." <verse eid="JHN 19:4"/><verse number="5" style="v" sid="JHN 19:5"/>Isaye he keṛar taz edde baiyonna rongor hor finda abostat maze baire aišše. Hetunot Filate mainšore hodde, "Oto so ei manušwa!"<verse eid="JHN 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6"/>Kintu Isare dekiyore ḍõr imam edde faharadar okkole guzoriyore hodde, "Kurušot do, itare kurušot do!"</para>
  <para style="p" vid="JHN 19:6">Filate hodde, "Tũwara itare loizaiyore kurušot dogoi! Ãi hitar hono hosuri no fair."<verse eid="JHN 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7"/>Ihudi okkole hodde, "Ãrattu ek ain ase, he ain mozin hitattu mora foribo, kiyollahoile hite nizore Allar Fut hoiye."<verse eid="JHN 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8"/>Filate zehon ei hota fuinne hetunot hite aro ḍoraiye; <verse eid="JHN 19:8"/><verse number="9" style="v" sid="JHN 19:9"/>edde hite abar mehelor butore giye edde Isare hodde, "Tui honttu aiššos?" Kintu Isaye hitare hono zuwab no de. <verse eid="JHN 19:9"/><verse number="10" style="v" sid="JHN 19:10"/>Filate hodde, "Tui ki ãr loi hota no hoibi? Tui ki no zanos ze, tore eridibar edde kurušot dibar kemota ãttu asede?"<verse eid="JHN 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11"/>Isaye hodde, <char style="wj">"Uwottu tũware kemota diya no oito buli ãr uwore tũwar hono kemota no takito; etolla hite ze ãre tũwar hatot tuli diye, hitar guna beši ḍõr." </char><verse eid="JHN 19:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12"/>Ei hota funi Filate Isare eridibolla kušiš goijje, kintu Ihudi okkole guzori hoiye, "Õne zodi itare erido, toile õne Kaisaror bondu no; ze honokiye nizore badša dabi gore hite to Kaisaror bifokke hota ho."<verse eid="JHN 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13"/>Filate ei hota zehon fuinne, hite Isare baire ainne edde ek šil bisaiya zagat bisaror siyarot boišše, (ze zagaganore Ibroni zubanot Gabbata howa oito). <verse eid="JHN 19:13"/><verse number="14" style="v" sid="JHN 19:14"/>He dinnan aššil uddar id entezamor din; hẽtte ṭaim oilde dũijja.</para>
  <para style="p" vid="JHN 19:14">Filate Ihudi okkolore hodde, "Ei so, tũwarar badša"<verse eid="JHN 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15"/>Henot hitara guzori hodde, "Dur goro! Dur goro! hitare kurušot do."</para>
  <para style="p" vid="JHN 19:15">Filate hitarare hodde, "Tũwarar badšare ki ãi kurušot diyum?"</para>
  <para style="p" vid="JHN 19:15">Ḍõr imam okkole zuwab diye, "Kaisar bade ãrattu ar hono badša nai."<verse eid="JHN 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16"/>Toi hite Isare hitarar hatot tuli diye, zene hibare kurušot diya o.</para>
  <para style="s" vid="JHN 19:16">Isare kurušot diya edde moron</para>
  <para style="r" vid="JHN 19:16">(<ref loc="MAT 27:31-56">Moti 27:31–56</ref>; <ref loc="MRK 15:21-41">Mark 15:21–41</ref>; <ref loc="LUK 23:26-49">Luk 23:26–49</ref>)</para>
  <para style="p" vid="JHN 19:16">Toi hitara hibare hentu loi giyegoi; <verse eid="JHN 19:16"/><verse number="17" style="v" sid="JHN 19:17"/>ar hiba nizor kuruš boi loizaiyore Matakuli name ek zagat giye (ziyanore Ibroni zubanot Golgotá ho.) <verse eid="JHN 19:17"/><verse number="18" style="v" sid="JHN 19:18"/>Heṛe hitara Isare kurušot diye, edde hibar fũwati aro duizonore diye, ekzonore ek ḍakottu ek ḍakottu, ar maze Isare.<verse eid="JHN 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 19:19"/>Filate ekkan dušnama lekiyore Isar kurušor uwore lagai diye, ar leka aššil:</para>
  <para style="pc" vid="JHN 19:19">"NASARATOR ISA, IHUDI OKKOLOR BADŠA."<verse eid="JHN 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 19:20"/>Ihudi okkolor boute he dušnamagan foijje, kiyollahoile Isare kurušot diya oiyede zagagan aššilde šohoror ḍake, ar hiyan leka aššil Ibroni, Romiyo edde Girik bašat. <verse eid="JHN 19:20"/><verse number="21" style="v" sid="JHN 19:21"/>Ihudi okkolor ḍõr imam okkole Filatore hodde, "'Ihudi okkolor badša no leikko,' kintu leko ze, ite hoito, 'ãi Ihudi okkolor badša.'"<verse eid="JHN 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22"/>Filate hodde, "Ãi ziyan lekki, hiyan ãi lekki."<verse eid="JHN 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23"/>Šoinno okkole Isare kurušot di bade, hitara hibar horgunore sair bag goriyore ekzone ek bag gori loiye, ar zubba o loiye; kintu hiba silaiya nu aššil, uwottu nise foijjonto banaiya. <verse eid="JHN 19:23"/><verse number="24" style="v" sid="JHN 19:24"/>Toi hitara ekzonore ekzone hodde, "Iyan no faṛiyum, bolke iyanolla loṭari mari, sai iba har o."</para>
  <para style="p" vid="JHN 19:24">Zene ei kalam furon oi fare,</para>
  <para style="q1" vid="JHN 19:24">"Hitara ãr horgunore hitarar maze bag goijje,</para>
  <para style="q2" vid="JHN 19:24">ar ãr zubbawalla loṭari maijje"</para>
  <para style="m" vid="JHN 19:24">Ar hendilla in okkol ei šoinno okkole goijje.<verse eid="JHN 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25"/>Ar Isar kurušor ḍake hibar ma, hibar mar boin, Klofasor bou Moriyam, edde Mogdaleni Moriyam, itara tiyat aššil. <verse eid="JHN 19:25"/><verse number="26" style="v" sid="JHN 19:26"/>Isaye, mare edde sahabi zare hibaye ador gorito, hitara tiyai taikkede dekiyore, hibaye mare hodde, <char style="wj">"Mayafuwa, sa, iba tor fut."</char> <verse eid="JHN 19:26"/><verse number="27" style="v" sid="JHN 19:27"/>Tarfore he sahabire hodde, <char style="wj">"Sa, iba tor ma."</char> He oite, he sahabiye hibare hitar nizor górot loigiyegoi.<verse eid="JHN 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28"/>Tarfore, Isaye buzi farer ze beggun šeš oiye, kitabor kalam zene furon o, hibaye hodde,<char style="wj">"Ãi tiraši oiyi." </char> <verse eid="JHN 19:28"/><verse number="29" style="v" sid="JHN 19:29"/>Heṛe horor roš furaiya ugguwa dešši aššil, toi hitara ekkan hanire he horor rošot bizaiye edde esup gasor ḍeila loi hin Isar mukor hãse doijje. <verse eid="JHN 19:29"/><verse number="30" style="v" sid="JHN 19:30"/>Isaye he horor roš haiyore hodde,<char style="wj">"Šeš oiye."</char> Tarfore hibaye mata niso gori hibar šeš niyaš felaiye.<verse eid="JHN 19:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31"/>He dinnan aššilde entezamor din, ar Šabbator din zene lašgun kurušor uwore no take, kiyollahoile he Šabbat aššilde ek moha din, etolla Ihudi okkole Filatore foriyad goijje zene hitarar ṭenggun bangi diyore hitarare kurušottu lamaifela o. <verse eid="JHN 19:31"/><verse number="32" style="v" sid="JHN 19:32"/>Toi šoinno okkol aiyore foila ekzonore, edde hibar fũwati kurušot diya oiyede dusora ekzonore, ṭenggun bangi diye. <verse eid="JHN 19:32"/><verse number="33" style="v" sid="JHN 19:33"/>Kintu hitara zẽtte Isar hãse aiyore dekilo ze, hiba mori giyegoi, toi hibar ṭeng no bange. <verse eid="JHN 19:33"/><verse number="34" style="v" sid="JHN 19:34"/>Kintu soinno okkolor ekzone hibar ḍak sai sel loiyore hana goijje; henot toratori lou edde fani niyoli aišše. <verse eid="JHN 19:34"/><verse number="35" style="v" sid="JHN 19:35"/>Ze nizor suke deikke, hite goba diye, ar hitar goba soiyi. Ar hite zane ze hite soiyi hor, zene tũwara o biššaš goro.<verse eid="JHN 19:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 19:36"/>Haron in okkol goiṭṭe, zene kitabor ei kalam furon o, "Hibar ekkan ãḍḍi o banga no oibo." <verse eid="JHN 19:36"/><verse number="37" style="v" sid="JHN 19:37"/>Abar kitabor ar ek kalam endilla hor, "Hitara zare hana goijje hibare hitara saibo."<verse eid="JHN 19:37"/></para>
  <para style="s">Isare hobor diya or</para>
  <para style="r">(<ref loc="MAT 27:57-61">Moti 27:57–61</ref>; <ref loc="MRK 15:42-47">Mark 15:42–47</ref>; <ref loc="LUK 23:50-56">Luk 23:50–56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38"/>Ar in okkol bade, Arimatiyar Yusuf, ze aššil Isar sahabi, kintu Ihudi okkolor ḍore gufone aššil, hibaye Filatore foriyad goijje, zene hibaye Isar gagan loizai fare; Filate loizaibolla ezajot diye. Toi hibaye aiyore hibar gagan loigiyegoi. <verse eid="JHN 19:38"/><verse number="39" style="v" sid="JHN 19:39"/>Ar Nikoḍomas, hiba ze foilabar raitta Isar hãse aiššil, hibaye o heṛe aššil, myrrah edde aloi miyaiya onumanik ek šot fond mosolla loiyore. <verse eid="JHN 19:39"/><verse number="40" style="v" sid="JHN 19:40"/>Hitara Isar ga loizaiyore Ihudi okkolore dohon gorade niyom mozin he kušbo mosolla kafon horot diyore berai diye.<verse eid="JHN 19:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 19:41"/>Isare zeṛe kurušot diya oiye, heṛe ek bagan aššil, ar he baganot ugguwa noya hobor aššil, zibat honokiyore ehono raka no o. <verse eid="JHN 19:41"/><verse number="42" style="v" sid="JHN 19:42"/>He din aššilde Ihudi okkolor entezamor din, hitara Isare he hoborot raikke, kiyollahoile he hoborguwa ḍake aššil.<verse eid="JHN 19:42"/></para>
  <chapter eid="JHN 19"/>
  <chapter number="20" style="c" sid="JHN 20"/>
  <para style="s">Hali hobor</para>
  <para style="r">(<ref loc="MAT 28:1-10">Moti 28:1–10</ref>; <ref loc="MRK 16:1-8">Mark 16:1–8</ref>; <ref loc="LUK 24:1-12">Luk 24:1–12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1"/>Haftar foila din binna sore, andar taite Mogdaleni Moriyame hoboror hãse giye, ar hibaye dekedde hoboror mukottu fattorgan algaifela oiye. <verse eid="JHN 20:1"/><verse number="2" style="v" sid="JHN 20:2"/>Hibaye dũri Simon Fitoror hãse edde dusora sahabi zare Isaye ador gorito hibar hãse aišše, ar hitarare hodde, "Hitara Malikore hoborottu loigiyegoi; ar hitara hibare hoṛe raikke ãra no zani."<verse eid="JHN 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3"/>Toi Fitor edde he dusora sahabiwa hetunot niyoli giye edde hoboror mikka zat aššil. <verse eid="JHN 20:3"/><verse number="4" style="v" sid="JHN 20:4"/>Ar hitara dunizon ekku fũwati dũrat aššil, kintu he dusora sahabiwaye Fitorottuwaro aro beši dũriyore mummika giye edde hoborot agottu fõissegai; <verse eid="JHN 20:4"/><verse number="5" style="v" sid="JHN 20:5"/>edde niyuriyore hoboror butore saiye, heṛe kafonor hor fori taikkede deikke, kintu hibaye hoboror butore no za. <verse eid="JHN 20:5"/><verse number="6" style="v" sid="JHN 20:6"/>Simon Fitor o hibar fise fise aišše, edde hoboror butore giye edde dekedde kafonor horgun heṛe fori roiye, <verse eid="JHN 20:6"/><verse number="7" style="v" sid="JHN 20:7"/>Ar ze rumalgan hibar matat beraiya aššil hiyan kafonor horor fũwati nai, kintu ar ekkan zagat hok gori raka oiye. <verse eid="JHN 20:7"/><verse number="8" style="v" sid="JHN 20:8"/>Tarfore dusora sahabi ze age hoboror hãse fõissil, hibaye o butore giye. Hibaye deikke edde biššaš goijje. <verse eid="JHN 20:8"/><verse number="9" style="v" sid="JHN 20:9"/>(Hehon foijjonto hitara kitabor ei hota buzi no fare ze, mora okkolor butottu abar hiba uṛa iyan dorhari.) <verse eid="JHN 20:9"/><verse number="10" style="v" sid="JHN 20:10"/>Tarfore sahabi okkol górot firi giyegoi.<verse eid="JHN 20:10"/></para>
  <para style="s">Isaye Mogdaleni Moriyamore deha diya</para>
  <para style="r">(<ref loc="MRK 16:9-11">Mark 16:9–11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11"/>Toi Moriyam hoboror baire tiyai handat roiye, hibaye handat maze niyuriyore hoboror butore saiye, <verse eid="JHN 20:11"/><verse number="12" style="v" sid="JHN 20:12"/>ar dekedde, dola hor finda duizon firista Isar ga ze zagat neṛai diya oil, ekzon hibar matar hentu, ar ekzon ṭengor hentu, boi taikke. <verse eid="JHN 20:12"/><verse number="13" style="v" sid="JHN 20:13"/>Hitara hibare hodde, "He mayafuwa, handor kiyolla?"</para>
  <para style="p" vid="JHN 20:13">Hibaye hitarare hodde, "Hitara ãr Malikore loigiyegoi, edde hibare hoṛe raikke ãi no zani."<verse eid="JHN 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14"/>In okkol hoiyore hiba fissa firi sadde Isa tiyai roiye, kintu hiba Isade hiyan hibaye buzi no fare.<verse eid="JHN 20:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 20:15"/>Isaye hibare hodde, <char style="wj">"He mayafuwa, handor kiyolla? Hare tuwor?"</char></para>
  <para style="p" vid="JHN 20:15">Isare baganor mali boli ṭariyore, hibaye hodde, "So, õne zodi hibare loi giyogoide o, toile ãre ho hoṛe raikko, ãi hibare loi ainnumboi."<verse eid="JHN 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16"/>Isaye hibare hodde, <char style="wj">"Moriyam." </char></para>
  <para style="p" vid="JHN 20:16">Henot Moriyame hibar mikka firiyore Ibroni zubanot Isare hodde, "Rabbuni" zar mani "ustad."<verse eid="JHN 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17"/>Isaye Moriyamore hodde, <char style="wj">"Ãre no suis, kiyollahoile ãi ehono uwore Bafor hãse no zai. Tui bolke ãr báiyaindor hãse zaiyore hogoi, ze ãr edde tũwarar Baf, ze ãr edde tũwarar Allah, ãi uwore hibar hãse zair." </char><verse eid="JHN 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18"/>Toi Mogdaleni Moriyam hentu giyegoi edde sahabi okkolore hodde, "Ãi Malikore dekki!" Ar Isaye hibare ki hoil hin okkol o hibaye hitarare hoiye.<verse eid="JHN 20:18"/></para>
  <para style="s">Isaye sahabi okkolore dehaiye</para>
  <para style="r">(<ref loc="MAT 28:16-20">Moti 28:16–20</ref>; <ref loc="MRK 16:15-16">Mark 16:15–16</ref>; <ref loc="LUK 24:36-49">Luk 24:36–49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19"/>He ekkui dinor hazinna, haftar foila din, Ihudi okkolor ḍore, sahabi okkol ziyot dola oiya aššil he góror doroza okkol bon gori dil. Isa nize ai hitarar maze tiyaiyore hodde, <char style="wj">"Tũwarar šanti ok."</char> <verse eid="JHN 20:19"/><verse number="20" style="v" sid="JHN 20:20"/>Ei hota hoi bade hibaye hitarare hat edde ḍak dehaiye. Sahabi okkole Malikore dekiyore beši kuši oiye.<verse eid="JHN 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 20:21"/>Toi Isaye abar hodde, <char style="wj">"Tũwarar šanti ok; zendilla ãre he Bafe defeṛaiye, ãi o tũwarare defeṛair."</char> <verse eid="JHN 20:21"/><verse number="22" style="v" sid="JHN 20:22"/>Ei hota hoiyore hibaye hitarar uwore fu diye edde hodde, <char style="wj">"Pak Ruhure goso.</char> <verse eid="JHN 20:22"/><verse number="23" style="v" sid="JHN 20:23"/><char style="wj">Tũwara zodi honokiyor guna maf gori do, toile hitarar guna maf oibo, ar zodi honokiyor guna maf gori no do, toile hitarar guna maf gora no oibo."</char><verse eid="JHN 20:23"/></para>
  <para style="s">Isa edde Ṭomas</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24"/>Isa zẽtte aššil, hẽtte Ṭomas, he barozonor ekzon, (zare Didymus ḍaka oito,) hiba oinno sahabi okkolor fũwati nu aiššil. <verse eid="JHN 20:24"/><verse number="25" style="v" sid="JHN 20:25"/>Toi oinno sahabi okkole hibare hodde, "Ãra Malikore dekki."</para>
  <para style="p" vid="JHN 20:25">Kintu hibaye hitarare hodde, "Ãi zodi hibar dui hatot ferakor sinno no deki, edde he ferakor sinnot ãr õl diyore, edde hibar ḍakot ãr hat diyore ãi sai no fari, toile hono mote ãi biššaš no goriyum."<verse eid="JHN 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26"/>Ar ašṭo din bade, hibar sahabi okkole abar he górot dola oiye, edde Ṭomas o hitarar fũwati aššil, ar hẽtte dorozagun banda taki bade o Isa aišše, edde hiba hitarar maze tiyaiye, ar hodde, <char style="wj">"Tũwarar šanti ok."</char><verse eid="JHN 20:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 20:27"/>Tarfore hibaye Ṭomasore hodde, <char style="wj">"Tor õl eṛe an, ar ãr dui hat sa. Ar tor hat barai de, edde ãr ḍakot rak. Obiššaši no ois, kintu biššaši o." </char><verse eid="JHN 20:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28"/>Hetunot Ṭomase zuwab diye edde hibare hodde, "Ãr Malik, ãr Allah."<verse eid="JHN 20:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29"/>Isaye hibare hodde, <char style="wj">"Ṭomas, tui ki ãre deikkos boli biššaš ainnos? Mubarok hitara, zara no dekiyore biššaš gore." </char><verse eid="JHN 20:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30"/>Isaye sahabi okkolor sukor sarme aro bout keramoti ham goijje, zin ei kitabot leka no o. <verse eid="JHN 20:30"/><verse number="31" style="v" sid="JHN 20:31"/>Kintu in okkol leka oiye, zene tũwara biššaš gori faro ze, Isa oilde Messiyah, Allar Fut, ar zene biššašor duwara tũwara hibar namot zibon fo.<verse eid="JHN 20:31"/></para>
  <chapter eid="JHN 20"/>
  <chapter number="21" style="c" sid="JHN 21"/>
  <para style="s">Doriyar farot sahabi okkolore Isaye deha diye</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1"/>In okkol bade, Isaye Ṭaiberia doriyar farot abar nizore sahabi okkolore deha diye. Ar hibaye nizore endilla gori forhaš goijje. <verse eid="JHN 21:1"/><verse number="2" style="v" sid="JHN 21:2"/>Simon Fitor, Ṭomas (zare Didymus ḍaka oito,) Galilor Kana farar Natanael, Sebdeusor futain edde hibar oinno duizon sahabi, itara ekkui fũwati aššil. <verse eid="JHN 21:2"/><verse number="3" style="v" sid="JHN 21:3"/>Simon Fitore hitarare hodde, "Ãi mas doitto zair." Ar hitara hibare hodde, "Ãra o tũwar fũwati zai." Toi hitara bair oi niyoli zai not uiṭṭe, ar he raitta hitara kissu no fa.<verse eid="JHN 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 21:4"/>Binna oi aišše, hen šomot Isaye doriyar farot tiyaiye, tarfore o sahabi okkole hiba Isade hiyan buzi no fare.<verse eid="JHN 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 21:5"/>Toi Isaye hitarare hodde, <char style="wj">"Fuwain okkol, tũwarattu ki háibolla kissu ase?" </char></para>
  <para style="p" vid="JHN 21:5">Hitara hodde, "Kissu nai."<verse eid="JHN 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6"/>Hibaye hitarare hodde, <char style="wj">"Nor ḍen ḍakottu zal felo, faiba."</char>Toi hitara hendilla goijje, ar eto beši mas foijje, hitara hiyan ṭani tuli no faijjil.<verse eid="JHN 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7"/>Toi Isaye ze sahabire ador gorito, hibaye Fitorore hodde, "Iba Malik!" Ei hota funiyore Simon Fitore gat hoor beraiye, (kiyollahoile hiba ulongo aššil) edde doriyat zaf maijje. <verse eid="JHN 21:7"/><verse number="8" style="v" sid="JHN 21:8"/>Ar oinno sahabi okkole mas furaiya zalgan ṭani ṭani gura not gori farot aišše, kiyollahoile hitara farottu beši dure nu aššil, onumanik dui šot hat dure aššil, hitara.<verse eid="JHN 21:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 21:9"/>Farot lamiyore hitara dekedde, oinor hoilar ṭal ase, ar heṛe uwore hodun mas ase, edde ruṭi. <verse eid="JHN 21:9"/><verse number="10" style="v" sid="JHN 21:10"/>Hetunot Isaye hitarare hodde, <char style="wj">"Ze mas ehon doijjo, hentu hougguwa ano."</char><verse eid="JHN 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11"/>Simon Fitore not zaiyore zalgan farot ṭani ainne, ḍõr ḍõr mase furaiya, beggune ekšo fõnzaš tinnuwa mas oiye, eto beši mas oi bade o, zalgan no síre. <verse eid="JHN 21:11"/><verse number="12" style="v" sid="JHN 21:12"/>Isaye hitarare hodde, <char style="wj">"Aio, hógai."</char> Sahabi okkol honokiye "Õne honnuwa?" fusar goitte šahoš no gore, kiyollahoile hitara zanito ze hiba Malik. <verse eid="JHN 21:12"/><verse number="13" style="v" sid="JHN 21:13"/>Bade Isaye ruṭi loi aiyore hitarare diye, ar he bafe mas o diye. <verse eid="JHN 21:13"/><verse number="14" style="v" sid="JHN 21:14"/>Morattu uṛi bade Isaye ei tisera bar sahabi okkolore deha diye.<verse eid="JHN 21:14"/></para>
  <para style="s">Fitor edde Isa</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15"/>Hitara beggune hána haiya šeš oi bade Isaye Simon Fitore hodde,<char style="wj">"Yuhannar fut Simon, itarattuwaro ki tui ãre beši ador goros?" </char></para>
  <para style="p" vid="JHN 21:15">Simone hodde, "Oi, malik, õne hoi faro õne ãr hoto adoijja."</para>
  <para style="p" vid="JHN 21:15">Isaye hodde, <char style="wj">"Ãr soolor sogunore hábais."</char><verse eid="JHN 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 21:16"/>Isaye abar hodde, <char style="wj">"Yuhannar fut Simon, itarattuwaro ki tui ãre beši ador goros?"</char></para>
  <para style="p" vid="JHN 21:16">Simone hodde, "Oi, malik, õne hoi faro õne ãr hoto adoijja."</para>
  <para style="p" vid="JHN 21:16">Isaye hodde, <char style="wj">"Ãr soolgunore sora."</char><verse eid="JHN 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 21:17"/>Hibaye tisera bar Simonore hodde, <char style="wj">"Yuhannar fut Simon, tui ki ãre ador goros ne?"</char></para>
  <para style="p" vid="JHN 21:17">Fitor ebarot dukkito oiye, kiyollahoile Isaye <char style="wj">"Tui ki ãre ador goros ne?"</char> tisera bar fusar goijje, ar hibare hodde, "Malik, õne hár kissu zano, õne zano ze õne ãr adoijja."</para>
  <para style="p" vid="JHN 21:17">Isaye hodde, <char style="wj">"Toile ãr soolor sogunore hábais.</char> <verse eid="JHN 21:17"/><verse number="18" style="v" sid="JHN 21:18"/><char style="wj">Ãi tore soiyi soiyi hoir, tui zẽtte zuwan aššili hẽtte tui nize tor kiyail banditi ar zeṛe issa heṛe zaiti, kintu zẽtte tui bura oibi hẽtte tor hat ṭanibi edde oinno ekzone tore bandibo ar tui zeṛe no zaito sos heṛe loizaibo."</char> <verse eid="JHN 21:18"/><verse number="19" style="v" sid="JHN 21:19"/>Allar mohima forhaš goralla boli Fitor kibafe moribo hiyan dehaibolla Isaye ei hotagan hoiye. Tarfore Isaye hodde, <char style="wj">"Ãr fisa lo!"</char><verse eid="JHN 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20"/>Fitore muk firai sadde, Isar adoijja sahabiwa o fise fise aiyer. (Iba oilde he sahabi ze hána háibar šomot Isar mikka helandiyore hoil, "Malik, õnore ze dušmonor hatot dori dibo, hiba honnuwa?") <verse eid="JHN 21:20"/><verse number="21" style="v" sid="JHN 21:21"/>Fitore hibare dekiyore hodde, "Malik, ibar babute ken?"<verse eid="JHN 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22"/>Isaye Fitorore hodde, <char style="wj">"Ãi zodi sai ãi abar uwafes firi no aiyi foijjonto ite zinda take, henot tor ki? Tui ãr fisa lo."</char> <verse eid="JHN 21:22"/><verse number="23" style="v" sid="JHN 21:23"/>Hiyanor zoriya báiyain okkolor butore hóbor sorai giyegoi ze, hite no moribo; zodi o Isaye hitare no ho ze, hite no moribo; bolke hibaye hoil, <char style="wj">"Ãi zodi sai ãi abar uwafes firi no aiyi foijjonto ite zinda take, henot tor ki?"</char><verse eid="JHN 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24"/>Iba oilde he sahabi ze in beggunor babute goba der, edde in okkol hibaye leikke; ar ãra zani ze, hibar goba soiyi.<verse eid="JHN 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25"/>Isaye aro bout kissu goijjil; hin okkol zodi ek ekkan gori leka oito, toile edun kitab ze oito, ãi mone gorir he kitab okkol hin duniyait nu ãṛito.<verse eid="JHN 21:25"/></para>
  <chapter eid="JHN 21"/>
</usx>
