  <para style="h">3 John</para>
  <para style="toc1">3 yohanaH patraM</para>
  <para style="toc2">3 yohanaH</para>
  <para style="toc3">3 yohanaH</para>
  <para style="mt1">3 yohanaH patraM</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>prAchIno .ahaM satyamatAd yasmin prIye taM priyatamaM gAyaM prati patraM likhAmi|</para>
  <para style="p">
    <verse number="2" style="v"/>he priya, tavAtmA yAdR^ik shubhAnvitastAdR^ik sarvvaviShaye tava shubhaM svAsthya ncha bhUyAt|</para>
  <para style="p">
    <verse number="3" style="v"/>bhrAtR^ibhirAgatya tava satyamatasyArthatastvaM kIdR^ik satyamatamAcharasyetasya sAkShye datte mama mahAnando jAtaH|</para>
  <para style="p">
    <verse number="4" style="v"/>mama santAnAH satyamatamAcharantItivArttAto mama ya Anando jAyate tato mahattaro nAsti|</para>
  <para style="p">
    <verse number="5" style="v"/>he priya, bhrAtR^in prati visheShatastAn videshino bhR^iाtR^in prati tvayA yadyat kR^itaM tat sarvvaM vishvAsino yogyaM|</para>
  <para style="p">
    <verse number="6" style="v"/>te cha samiteH sAkShAt tava pramnaH pramANaM dattavantaH, aparam IshvarayogyarUpeNa tAn prasthApayatA tvayA satkarmma kAriShyate|</para>
  <para style="p">
    <verse number="7" style="v"/>yataste tasya nAmnA yAtrAM vidhAya bhinnajAtIyebhyaH kimapi na gR^ihItavantaH|</para>
  <para style="p">
    <verse number="8" style="v"/>tasmAd vayaM yat satyamatasya sahAyA bhavema tadarthametAdR^ishA lokA asmAbhiranugrahItavyAH|</para>
  <para style="p">
    <verse number="9" style="v"/>samitiM pratyahaM patraM likhitavAn kintu teShAM madhye yo diyatriphiH pradhAnAyate so .asmAn na gR^ihlAti|</para>
  <para style="p">
    <verse number="10" style="v"/>ato .ahaM yadopasthAsyAmi tadA tena yadyat kriyate tat sarvvaM taM smArayiShyAmi, yataH sa durvvAkyairasmAn apavadati, tenApi tR^iptiM na gatvA svayamapi bhrAtR^in nAnugR^ihlAti ye chAnugrahItumichChanti tAn samitito .api bahiShkaroti|</para>
  <para style="p">
    <verse number="11" style="v"/>he priya, tvayA duShkarmma nAnukriyatAM kintu satkarmmaiva| yaH satkarmmAchArI sa IshvarAt jAtaH, yo duShkarmmAchArI sa IshvaraM na dR^iShTavAn|</para>
  <para style="p">
    <verse number="12" style="v"/>dImItriyasya pakShe sarvvaiH sAkShyam adAyi visheShataH satyamatenApi, vayamapi tatpakShe sAkShyaM dadmaH, asmAka ncha sAkShyaM satyameveti yUyaM jAnItha|</para>
  <para style="p">
    <verse number="13" style="v"/>tvAM prati mayA bahUni lekhitavyAni kintu masIlekhanIbhyAM lekhituM nechChAmi|</para>
  <para style="p">
    <verse number="14" style="v"/>achireNa tvAM drakShyAmIti mama pratyAshAste tadAvAM sammukhIbhUya parasparaM sambhAShiShyAvahe|</para>
  <para style="p">
    <verse number="15" style="v"/>tava shAnti rbhUyAt| asmAkaM mitrANi tvAM namaskAraM j nApayanti tvamapyekaikasya nAma prochya mitrebhyo namaskuru| iti|</para>
</usx>
