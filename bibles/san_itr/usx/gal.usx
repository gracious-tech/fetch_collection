  <para style="h">Galatians</para>
  <para style="toc1">gAlAtinaH patraM</para>
  <para style="toc2">gAlAtinaH</para>
  <para style="toc3">gAlAtinaH</para>
  <para style="mt1">gAlAtinaH patraM</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>manuShyebhyo nahi manuShyairapi nahi kintu yIshukhrIShTena mR^itagaNamadhyAt tasyotthApayitrA pitreshvareNa cha prerito yo.ahaM paulaH so.ahaM</para>
  <para style="p">
    <verse number="2" style="v"/>matsahavarttino bhrAtarashcha vayaM gAlAtIyadeshasthAH samitIH prati patraM likhAmaH|</para>
  <para style="p">
    <verse number="3" style="v"/>pitreshvareNAsmAMka prabhunA yIshunA khrIShTena cha yuShmabhyam anugrahaH shAntishcha dIyatAM|</para>
  <para style="p">
    <verse number="4" style="v"/>asmAkaM tAteshvaresyechChAnusAreNa varttamAnAt kutsitasaMsArAd asmAn nistArayituM yo</para>
  <para style="p">
    <verse number="5" style="v"/>yIshurasmAkaM pApahetorAtmotsargaM kR^itavAn sa sarvvadA dhanyo bhUyAt| tathAstu|</para>
  <para style="p">
    <verse number="6" style="v"/>khrIShTasyAnugraheNa yo yuShmAn AhUtavAn tasmAnnivR^itya yUyam atitUrNam anyaM susaMvAdam anvavarttata tatrAhaM vismayaM manye|</para>
  <para style="p">
    <verse number="7" style="v"/>so.anyasusaMvAdaH susaMvAdo nahi kintu kechit mAnavA yuShmAn cha nchalIkurvvanti khrIShTIyasusaMvAdasya viparyyayaM karttuM cheShTante cha|</para>
  <para style="p">
    <verse number="8" style="v"/>yuShmAkaM sannidhau yaH susaMvAdo.asmAbhi rghoShitastasmAd anyaH susaMvAdo.asmAkaM svargIyadUtAnAM vA madhye kenachid yadi ghoShyate tarhi sa shapto bhavatu|</para>
  <para style="p">
    <verse number="9" style="v"/>pUrvvaM yadvad akathayAma, idAnImahaM punastadvat kathayAmi yUyaM yaM susaMvAdaM gR^ihItavantastasmAd anyo yena kenachid yuShmatsannidhau ghoShyate sa shapto bhavatu|</para>
  <para style="p">
    <verse number="10" style="v"/>sAmprataM kamaham anunayAmi? IshvaraM kiMvA mAnavAn? ahaM kiM mAnuShebhyo rochituM yate? yadyaham idAnImapi mAnuShebhyo ruruchiSheya tarhi khrIShTasya parichArako na bhavAmi|</para>
  <para style="p">
    <verse number="11" style="v"/>he bhrAtaraH, mayA yaH susaMvAdo ghoShitaH sa mAnuShAnna labdhastadahaM yuShmAn j nApayAmi|</para>
  <para style="p">
    <verse number="12" style="v"/>ahaM kasmAchchit manuShyAt taM na gR^ihItavAn na vA shikShitavAn kevalaM yIshoH khrIShTasya prakAshanAdeva|</para>
  <para style="p">
    <verse number="13" style="v"/>purA yihUdimatAchArI yadAham AsaM tadA yAdR^isham AcharaNam akaravam Ishvarasya samitiM pratyatIvopadravaM kurvvan yAdR^ik tAM vyanAshayaM tadavashyaM shrutaM yuShmAbhiH|</para>
  <para style="p">
    <verse number="14" style="v"/>apara ncha pUrvvapuruShaparamparAgateShu vAkyeShvanyApekShAtIvAsaktaH san ahaM yihUdidharmmate mama samavayaskAn bahUn svajAtIyAn atyashayi|</para>
  <para style="p">
    <verse number="15" style="v"/>ki ncha ya Ishvaro mAtR^igarbhasthaM mAM pR^ithak kR^itvA svIyAnugraheNAhUtavAn</para>
  <para style="p">
    <verse number="16" style="v"/>sa yadA mayi svaputraM prakAshituM bhinnadeshIyAnAM samIpe bhayA taM ghoShayitu nchAbhyalaShat tadAhaM kravyashoNitAbhyAM saha na mantrayitvA</para>
  <para style="p">
    <verse number="17" style="v"/>pUrvvaniyuktAnAM preritAnAM samIpaM yirUshAlamaM na gatvAravadeshaM gatavAn pashchAt tatsthAnAd dammeShakanagaraM parAvR^ityAgatavAn|</para>
  <para style="p">
    <verse number="18" style="v"/>tataH paraM varShatraye vyatIte.ahaM pitaraM sambhAShituM yirUshAlamaM gatvA pa nchadashadinAni tena sArddham atiShThaM|</para>
  <para style="p">
    <verse number="19" style="v"/>kintu taM prabho rbhrAtaraM yAkUba ncha vinA preritAnAM nAnyaM kamapyapashyaM|</para>
  <para style="p">
    <verse number="20" style="v"/>yAnyetAni vAkyAni mayA likhyante tAnyanR^itAni na santi tad Ishvaro jAnAti|</para>
  <para style="p">
    <verse number="21" style="v"/>tataH param ahaM suriyAM kilikiyA ncha deshau gatavAn|</para>
  <para style="p">
    <verse number="22" style="v"/>tadAnIM yihUdAdeshasthAnAM khrIShTasya samitInAM lokAH sAkShAt mama parichayamaprApya kevalaM janashrutimimAM labdhavantaH,</para>
  <para style="p">
    <verse number="23" style="v"/>yo janaH pUrvvam asmAn pratyupadravamakarot sa tadA yaM dharmmamanAshayat tamevedAnIM prachArayatIti|</para>
  <para style="p">
    <verse number="24" style="v"/>tasmAt te mAmadhIshvaraM dhanyamavadan|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM chaturdashasu vatsareShu gateShvahaM barNabbA saha yirUshAlamanagaraM punaragachChaM, tadAnoM tItamapi svasa Nginam akaravaM|</para>
  <para style="p">
    <verse number="2" style="v"/>tatkAle.aham IshvaradarshanAd yAtrAm akaravaM mayA yaH parishramo.akAri kAriShyate vA sa yanniShphalo na bhavet tadarthaM bhinnajAtIyAnAM madhye mayA ghoShyamANaH susaMvAdastatratyebhyo lokebhyo visheShato mAnyebhyo narebhyo mayA nyavedyata|</para>
  <para style="p">
    <verse number="3" style="v"/>tato mama sahacharastIto yadyapi yUnAnIya AsIt tathApi tasya tvakChedo.apyAvashyako na babhUva|</para>
  <para style="p">
    <verse number="4" style="v"/>yatashChalenAgatA asmAn dAsAn karttum ichChavaH katipayA bhAktabhrAtaraH khrIShTena yIshunAsmabhyaM dattaM svAtantryam anusandhAtuM chArA iva samAjaM prAvishan|</para>
  <para style="p">
    <verse number="5" style="v"/>ataH prakR^ite susaMvAde yuShmAkam adhikAro yat tiShThet tadarthaM vayaM daNDaikamapi yAvad Aj nAgrahaNena teShAM vashyA nAbhavAma|</para>
  <para style="p">
    <verse number="6" style="v"/>parantu ye lokA mAnyAste ye kechid bhaveyustAnahaM na gaNayAmi yata IshvaraH kasyApi mAnavasya pakShapAtaM na karoti, ye cha mAnyAste mAM kimapi navInaM nAj nApayan|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu ChinnatvachAM madhye susaMvAdaprachAraNasya bhAraH pitari yathA samarpitastathaivAchChinnatvachAM madhye susaMvAdaprachAraNasya bhAro mayi samarpita iti tai rbubudhe|</para>
  <para style="p">
    <verse number="8" style="v"/>yatashChinnatvachAM madhye preritatvakarmmaNe yasya yA shaktiH pitaramAshritavatI tasyaiva sA shakti rbhinnajAtIyAnAM madhye tasmai karmmaNe mAmapyAshritavatI|</para>
  <para style="p">
    <verse number="9" style="v"/>ato mahyaM dattam anugrahaM pratij nAya stambhA iva gaNitA ye yAkUb kaiphA yohan chaite sahAyatAsUchakaM dakShiNahastagrahaMNa vidhAya mAM barNabbA ncha jagaduH, yuvAM bhinnajAtIyAnAM sannidhiM gachChataM vayaM ChinnatvachA sannidhiM gachChAmaH,</para>
  <para style="p">
    <verse number="10" style="v"/>kevalaM daridrA yuvAbhyAM smaraNIyA iti| atastadeva karttum ahaM yate sma|</para>
  <para style="p">
    <verse number="11" style="v"/>aparam AntiyakhiyAnagaraM pitara Agate.ahaM tasya doShitvAt samakShaM tam abhartsayaM|</para>
  <para style="p">
    <verse number="12" style="v"/>yataH sa pUrvvam anyajAtIyaiH sArddham AhAramakarot tataH paraM yAkUbaH samIpAt katipayajaneShvAgateShu sa Chinnatva NmanuShyebhyo bhayena nivR^itya pR^ithag abhavat|</para>
  <para style="p">
    <verse number="13" style="v"/>tato.apare sarvve yihUdino.api tena sArddhaM kapaTAchAram akurvvan barNabbA api teShAM kApaTyena vipathagAmyabhavat|</para>
  <para style="p">
    <verse number="14" style="v"/>tataste prakR^itasusaMvAdarUpe saralapathe na charantIti dR^iShTvAhaM sarvveShAM sAkShAt pitaram uktavAn tvaM yihUdI san yadi yihUdimataM vihAya bhinnajAtIya ivAcharasi tarhi yihUdimatAcharaNAya bhinnajAtIyAn kutaH pravarttayasi?</para>
  <para style="p">
    <verse number="15" style="v"/>AvAM janmanA yihUdinau bhavAvo bhinnajAtIyau pApinau na bhavAvaH</para>
  <para style="p">
    <verse number="16" style="v"/>kintu vyavasthApAlanena manuShyaH sapuNyo na bhavati kevalaM yIshau khrIShTe yo vishvAsastenaiva sapuNyo bhavatIti buddhvAvAmapi vyavasthApAlanaM vinA kevalaM khrIShTe vishvAsena puNyaprAptaye khrIShTe yIshau vyashvasiva yato vyavasthApAlanena ko.api mAnavaH puNyaM prAptuM na shaknoti|</para>
  <para style="p">
    <verse number="17" style="v"/>parantu yIshunA puNyaprAptaye yatamAnAvapyAvAM yadi pApinau bhavAvastarhi kiM vaktavyaM? khrIShTaH pApasya parichAraka iti? tanna bhavatu|</para>
  <para style="p">
    <verse number="18" style="v"/>mayA yad bhagnaM tad yadi mayA punarnirmmIyate tarhi mayaivAtmadoShaH prakAshyate|</para>
  <para style="p">
    <verse number="19" style="v"/>ahaM yad IshvarAya jIvAmi tadarthaM vyavasthayA vyavasthAyai amriye|</para>
  <para style="p">
    <verse number="20" style="v"/>khrIShTena sArddhaM krushe hato.asmi tathApi jIvAmi kintvahaM jIvAmIti nahi khrIShTa eva madanta rjIvati| sAmprataM sasharIreNa mayA yajjIvitaM dhAryyate tat mama dayAkAriNi madarthaM svIyaprANatyAgini cheshvaraputre vishvasatA mayA dhAryyate|</para>
  <para style="p">
    <verse number="21" style="v"/>ahamIshvarasyAnugrahaM nAvajAnAmi yasmAd vyavasthayA yadi puNyaM bhavati tarhi khrIShTo nirarthakamamriyata|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he nirbbodhA gAlAtilokAH, yuShmAkaM madhye krushe hata iva yIshuH khrIShTo yuShmAkaM samakShaM prakAshita AsIt ato yUyaM yathA satyaM vAkyaM na gR^ihlItha tathA kenAmuhyata?</para>
  <para style="p">
    <verse number="2" style="v"/>ahaM yuShmattaH kathAmekAM jij nAse yUyam AtmAnaM kenAlabhadhvaM? vyavasthApAlanena kiM vA vishvAsavAkyasya shravaNena?</para>
  <para style="p">
    <verse number="3" style="v"/>yUyaM kim IdR^ig abodhA yad AtmanA karmmArabhya sharIreNa tat sAdhayituM yatadhve?</para>
  <para style="p">
    <verse number="4" style="v"/>tarhi yuShmAkaM gurutaro duHkhabhogaH kiM niShphalo bhaviShyati? kuphalayukto vA kiM bhaviShyati?</para>
  <para style="p">
    <verse number="5" style="v"/>yo yuShmabhyam AtmAnaM dattavAn yuShmanmadhya AshcharyyANi karmmANi cha sAdhitavAn sa kiM vyavasthApAlanena vishvAsavAkyasya shravaNena vA tat kR^itavAn?</para>
  <para style="p">
    <verse number="6" style="v"/>likhitamAste, ibrAhIma Ishvare vyashvasIt sa cha vishvAsastasmai puNyArthaM gaNito babhUva,</para>
  <para style="p">
    <verse number="7" style="v"/>ato ye vishvAsAshritAsta evebrAhImaH santAnA iti yuShmAbhi rj nAyatAM|</para>
  <para style="p">
    <verse number="8" style="v"/>Ishvaro bhinnajAtIyAn vishvAsena sapuNyIkariShyatIti pUrvvaM j nAtvA shAstradAtA pUrvvam ibrAhImaM susaMvAdaM shrAvayana jagAda, tvatto bhinnajAtIyAH sarvva AshiShaM prApsyantIti|</para>
  <para style="p">
    <verse number="9" style="v"/>ato ye vishvAsAshritAste vishvAsinebrAhImA sArddham AshiShaM labhante|</para>
  <para style="p">
    <verse number="10" style="v"/>yAvanto lokA vyavasthAyAH karmmaNyAshrayanti te sarvve shApAdhInA bhavanti yato likhitamAste, yathA, "yaH kashchid etasya vyavasthAgranthasya sarvvavAkyAni nishchidraM na pAlayati sa shapta iti|"</para>
  <para style="p">
    <verse number="11" style="v"/>Ishvarasya sAkShAt ko.api vyavasthayA sapuNyo na bhavati tada vyaktaM yataH "puNyavAn mAnavo vishvAsena jIviShyatIti" shAstrIyaM vachaH|</para>
  <para style="p">
    <verse number="12" style="v"/>vyavasthA tu vishvAsasambandhinI na bhavati kintvetAni yaH pAlayiShyati sa eva tai rjIviShyatItiniyamasambandhinI|</para>
  <para style="p">
    <verse number="13" style="v"/>khrIShTo.asmAn parikrIya vyavasthAyAH shApAt mochitavAn yato.asmAkaM vinimayena sa svayaM shApAspadamabhavat tadadhi likhitamAste, yathA, "yaH kashchit tarAvullambyate so.abhishapta iti|"</para>
  <para style="p">
    <verse number="14" style="v"/>tasmAd khrIShTena yIshunevrAhIma AshI rbhinnajAtIyalokeShu varttate tena vayaM pratij nAtam AtmAnaM vishvAsena labdhuM shaknumaH|</para>
  <para style="p">
    <verse number="15" style="v"/>he bhrAtR^igaNa mAnuShANAM rItyanusAreNAhaM kathayAmi kenachit mAnavena yo niyamo nirachAyi tasya vikR^iti rvR^iddhi rvA kenApi na kriyate|</para>
  <para style="p">
    <verse number="16" style="v"/>parantvibrAhIme tasya santAnAya cha pratij nAH prati shushruvire tatra santAnashabdaM bahuvachanAntam abhUtvA tava santAnAyetyekavachanAntaM babhUva sa cha santAnaH khrIShTa eva|</para>
  <para style="p">
    <verse number="17" style="v"/>ataevAhaM vadAmi, IshvareNa yo niyamaH purA khrIShTamadhi nirachAyi tataH paraM triMshadadhikachatuHshatavatsareShu gateShu sthApitA vyavasthA taM niyamaM nirarthakIkR^itya tadIyapratij nA loptuM na shaknoti|</para>
  <para style="p">
    <verse number="18" style="v"/>yasmAt sampadadhikAro yadi vyavasthayA bhavati tarhi pratij nayA na bhavati kintvIshvaraH pratij nayA tadadhikAritvam ibrAhIme .adadAt|</para>
  <para style="p">
    <verse number="19" style="v"/>tarhi vyavasthA kimbhUtA? pratij nA yasmai pratishrutA tasya santAnasyAgamanaM yAvad vyabhichAranivAraNArthaM vyavasthApi dattA, sA cha dUtairAj nApitA madhyasthasya kare samarpitA cha|</para>
  <para style="p">
    <verse number="20" style="v"/>naikasya madhyastho vidyate kintvIshvara eka eva|</para>
  <para style="p">
    <verse number="21" style="v"/>tarhi vyavasthA kim Ishvarasya pratij nAnAM viruddhA? tanna bhavatu| yasmAd yadi sA vyavasthA jIvanadAnesamarthAbhaviShyat tarhi vyavasthayaiva puNyalAbho.abhaviShyat|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu yIshukhrIShTe yo vishvAsastatsambandhiyAH pratij nAyAH phalaM yad vishvAsilokebhyo dIyate tadarthaM shAstradAtA sarvvAn pApAdhInAn gaNayati|</para>
  <para style="p">
    <verse number="23" style="v"/>ataeva vishvAsasyAnAgatasamaye vayaM vyavasthAdhInAH santo vishvAsasyodayaM yAvad ruddhA ivArakShyAmahe|</para>
  <para style="p">
    <verse number="24" style="v"/>itthaM vayaM yad vishvAsena sapuNyIbhavAmastadarthaM khrIShTasya samIpam asmAn netuM vyavasthAgratho.asmAkaM vinetA babhUva|</para>
  <para style="p">
    <verse number="25" style="v"/>kintvadhunAgate vishvAse vayaM tasya vineturanadhInA abhavAma|</para>
  <para style="p">
    <verse number="26" style="v"/>khrIShTe yIshau vishvasanAt sarvve yUyam Ishvarasya santAnA jAtAH|</para>
  <para style="p">
    <verse number="27" style="v"/>yUyaM yAvanto lokAH khrIShTe majjitA abhavata sarvve khrIShTaM parihitavantaH|</para>
  <para style="p">
    <verse number="28" style="v"/>ato yuShmanmadhye yihUdiyUnAnino rdAsasvatantrayo ryoShApuruShayoshcha ko.api visheSho nAsti; sarvve yUyaM khrIShTe yIshAveka eva|</para>
  <para style="p">
    <verse number="29" style="v"/>ki ncha yUyaM yadi khrIShTasya bhavatha tarhi sutarAm ibrAhImaH santAnAH pratij nayA sampadadhikAriNashchAdhve|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ahaM vadAmi sampadadhikArI yAvad bAlastiShThati tAvat sarvvasvasyAdhipatiH sannapi sa dAsAt kenApi viShayeNa na vishiShyate</para>
  <para style="p">
    <verse number="2" style="v"/>kintu pitrA nirUpitaM samayaM yAvat pAlakAnAM dhanAdhyakShANA ncha nighnastiShThati|</para>
  <para style="p">
    <verse number="3" style="v"/>tadvad vayamapi bAlyakAle dAsA iva saMsArasyAkSharamAlAyA adhInA Asmahe|</para>
  <para style="p">
    <verse number="4" style="v"/>anantaraM samaye sampUrNatAM gatavati vyavasthAdhInAnAM mochanArtham</para>
  <para style="p">
    <verse number="5" style="v"/>asmAkaM putratvaprAptyartha ncheshvaraH striyA jAtaM vyavasthAyA adhinIbhUta ncha svaputraM preShitavAn|</para>
  <para style="p">
    <verse number="6" style="v"/>yUyaM santAnA abhavata tatkAraNAd IshvaraH svaputrasyAtmAnAM yuShmAkam antaHkaraNAni prahitavAn sa chAtmA pitaH pitarityAhvAnaM kArayati|</para>
  <para style="p">
    <verse number="7" style="v"/>ata idAnIM yUyaM na dAsAH kintuH santAnA eva tasmAt santAnatvAchcha khrIShTeneshvarIyasampadadhikAriNo.apyAdhve|</para>
  <para style="p">
    <verse number="8" style="v"/>apara ncha pUrvvaM yUyam IshvaraM na j nAtvA ye svabhAvato.anIshvarAsteShAM dAsatve.atiShThata|</para>
  <para style="p">
    <verse number="9" style="v"/>idAnIm IshvaraM j nAtvA yadi veshvareNa j nAtA yUyaM kathaM punastAni viphalAni tuchChAni chAkSharANi prati parAvarttituM shaknutha? yUyaM kiM punasteShAM dAsA bhavitumichChatha?</para>
  <para style="p">
    <verse number="10" style="v"/>yUyaM divasAn mAsAn tithIn saMvatsarAMshcha sammanyadhve|</para>
  <para style="p">
    <verse number="11" style="v"/>yuShmadarthaM mayA yaH parishramo.akAri sa viphalo jAta iti yuShmAnadhyahaM bibhemi|</para>
  <para style="p">
    <verse number="12" style="v"/>he bhrAtaraH, ahaM yAdR^isho.asmi yUyamapi tAdR^ishA bhavateti prArthaye yato.ahamapi yuShmattulyo.abhavaM yuShmAbhi rmama kimapi nAparAddhaM|</para>
  <para style="p">
    <verse number="13" style="v"/>pUrvvamahaM kalevarasya daurbbalyena yuShmAn susaMvAdam aj nApayamiti yUyaM jAnItha|</para>
  <para style="p">
    <verse number="14" style="v"/>tadAnIM mama parIkShakaM shArIrakleshaM dR^iShTvA yUyaM mAm avaj nAya R^itIyitavantastannahi kintvIshvarasya dUtamiva sAkShAt khrIShTa yIshumiva vA mAM gR^ihItavantaH|</para>
  <para style="p">
    <verse number="15" style="v"/>atastadAnIM yuShmAkaM yA dhanyatAbhavat sA kka gatA? tadAnIM yUyaM yadi sveShAM nayanAnyutpATya mahyaM dAtum ashakShyata tarhi tadapyakariShyateti pramANam ahaM dadAmi|</para>
  <para style="p">
    <verse number="16" style="v"/>sAmpratamahaM satyavAditvAt kiM yuShmAkaM ripu rjAto.asmi?</para>
  <para style="p">
    <verse number="17" style="v"/>te yuShmatkR^ite sparddhante kintu sA sparddhA kutsitA yato yUyaM tAnadhi yat sparddhadhvaM tadarthaM te yuShmAn pR^ithak karttum ichChanti|</para>
  <para style="p">
    <verse number="18" style="v"/>kevalaM yuShmatsamIpe mamopasthitisamaye tannahi, kintu sarvvadaiva bhadramadhi sparddhanaM bhadraM|</para>
  <para style="p">
    <verse number="19" style="v"/>he mama bAlakAH, yuShmadanta ryAvat khrIShTo mUrtimAn na bhavati tAvad yuShmatkAraNAt punaH prasavavedaneva mama vedanA jAyate|</para>
  <para style="p">
    <verse number="20" style="v"/>ahamidAnIM yuShmAkaM sannidhiM gatvA svarAntareNa yuShmAn sambhAShituM kAmaye yato yuShmAnadhi vyAkulo.asmi|</para>
  <para style="p">
    <verse number="21" style="v"/>he vyavasthAdhInatAkA NkShiNaH yUyaM kiM vyavasthAyA vachanaM na gR^ihlItha?</para>
  <para style="p">
    <verse number="22" style="v"/>tanmAM vadata| likhitamAste, ibrAhImo dvau putrAvAsAte tayoreko dAsyAM dvitIyashcha patnyAM jAtaH|</para>
  <para style="p">
    <verse number="23" style="v"/>tayo ryo dAsyAM jAtaH sa shArIrikaniyamena jaj ne yashcha patnyAM jAtaH sa pratij nayA jaj ne|</para>
  <para style="p">
    <verse number="24" style="v"/>idamAkhyAnaM dR^iShTantasvarUpaM| te dve yoShitAvIshvarIyasandhI tayorekA sInayaparvvatAd utpannA dAsajanayitrI cha sA tu hAjirA|</para>
  <para style="p">
    <verse number="25" style="v"/>yasmAd hAjirAshabdenAravadeshasthasInayaparvvato bodhyate, sA cha varttamAnAyA yirUshAlampuryyAH sadR^ishI| yataH svabAlaiH sahitA sA dAsatva Aste|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu svargIyA yirUshAlampurI patnI sarvveShAm asmAkaM mAtA chAste|</para>
  <para style="p">
    <verse number="27" style="v"/>yAdR^ishaM likhitam Aste, "vandhye santAnahIne tvaM svaraM jayajayaM kuru| aprasUte tvayollAso jayAshabdashcha gIyatAM| yata eva sanAthAyA yoShitaH santate rgaNAt| anAthA yA bhavennArI tadapatyAni bhUrishaH||"</para>
  <para style="p">
    <verse number="28" style="v"/>he bhrAtR^igaNa, imhAk iva vayaM pratij nayA jAtAH santAnAH|</para>
  <para style="p">
    <verse number="29" style="v"/>kintu tadAnIM shArIrikaniyamena jAtaH putro yadvad Atmikaniyamena jAtaM putram upAdravat tathAdhunApi|</para>
  <para style="p">
    <verse number="30" style="v"/>kintu shAstre kiM likhitaM? "tvam imAM dAsIM tasyAH putra nchApasAraya yata eSha dAsIputraH patnIputreNa samaM nottarAdhikArI bhaviyyatIti|"</para>
  <para style="p">
    <verse number="31" style="v"/>ataeva he bhrAtaraH, vayaM dAsyAH santAnA na bhUtvA pAtnyAH santAnA bhavAmaH|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>khrIShTo.asmabhyaM yat svAtantryaM dattavAn yUyaM tatra sthirAstiShThata dAsatvayugena puna rna nibadhyadhvaM|</para>
  <para style="p">
    <verse number="2" style="v"/>pashyatAhaM paulo yuShmAn vadAmi yadi Chinnatvacho bhavatha tarhi khrIShTena kimapi nopakAriShyadhve|</para>
  <para style="p">
    <verse number="3" style="v"/>aparaM yaH kashchit Chinnatvag bhavati sa kR^itsnavyavasthAyAH pAlanam IshvarAya dhArayatIti pramANaM dadAmi|</para>
  <para style="p">
    <verse number="4" style="v"/>yuShmAkaM yAvanto lokA vyavasthayA sapuNyIbhavituM cheShTante te sarvve khrIShTAd bhraShTA anugrahAt patitAshcha|</para>
  <para style="p">
    <verse number="5" style="v"/>yato vayam AtmanA vishvAsAt puNyalAbhAshAsiddhaM pratIkShAmahe|</para>
  <para style="p">
    <verse number="6" style="v"/>khrIShTe yIshau tvakChedAtvakChedayoH kimapi guNaM nAsti kintu premnA saphalo vishvAsa eva guNayuktaH|</para>
  <para style="p">
    <verse number="7" style="v"/>pUrvvaM yUyaM sundaram adhAvata kintvidAnIM kena bAdhAM prApya satyatAM na gR^ihlItha?</para>
  <para style="p">
    <verse number="8" style="v"/>yuShmAkaM sA mati ryuShmadAhvAnakAriNa IshvarAnna jAtA|</para>
  <para style="p">
    <verse number="9" style="v"/>vikAraH kR^itsnashaktUnAM svalpakiNvena jasayate|</para>
  <para style="p">
    <verse number="10" style="v"/>yuShmAkaM mati rvikAraM na gamiShyatItyahaM yuShmAnadhi prabhunAshaMse; kintu yo yuShmAn vichAralayati sa yaH kashchid bhavet samuchitaM daNDaM prApsyati|</para>
  <para style="p">
    <verse number="11" style="v"/>parantu he bhrAtaraH, yadyaham idAnIm api tvakChedaM prachArayeyaM tarhi kuta upadravaM bhu njiya? tatkR^ite krushaM nirbbAdham abhaviShyat|</para>
  <para style="p">
    <verse number="12" style="v"/>ye janA yuShmAkaM chA nchalyaM janayanti teShAM Chedanameva mayAbhilaShyate|</para>
  <para style="p">
    <verse number="13" style="v"/>he bhrAtaraH, yUyaM svAtantryArtham AhUtA Adhve kintu tatsvAtantryadvAreNa shArIrikabhAvo yuShmAn na pravishatu| yUyaM premnA parasparaM paricharyyAM kurudhvaM|</para>
  <para style="p">
    <verse number="14" style="v"/>yasmAt tvaM samIpavAsini svavat prema kuryyA ityekAj nA kR^itsnAyA vyavasthAyAH sArasaMgrahaH|</para>
  <para style="p">
    <verse number="15" style="v"/>kintu yUyaM yadi parasparaM daMdashyadhve .ashAshyadhve cha tarhi yuShmAkam eko.anyena yanna grasyate tatra yuShmAbhiH sAvadhAnai rbhavitavyaM|</para>
  <para style="p">
    <verse number="16" style="v"/>ahaM bravImi yUyam AtmikAchAraM kuruta shArIrikAbhilAShaM mA pUrayata|</para>
  <para style="p">
    <verse number="17" style="v"/>yataH shArIrikAbhilASha Atmano viparItaH, AtmikAbhilAShashcha sharIrasya viparItaH, anayorubhayoH parasparaM virodho vidyate tena yuShmAbhi ryad abhilaShyate tanna karttavyaM|</para>
  <para style="p">
    <verse number="18" style="v"/>yUyaM yadyAtmanA vinIyadhve tarhi vyavasthAyA adhInA na bhavatha|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaM paradAragamanaM veshyAgamanam ashuchitA kAmukatA pratimApUjanam</para>
  <para style="p">
    <verse number="20" style="v"/>indrajAlaM shatrutvaM vivAdo.antarjvalanaM krodhaH kalaho.anaikyaM</para>
  <para style="p">
    <verse number="21" style="v"/>pArthakyam IrShyA vadho mattatvaM lampaTatvamityAdIni spaShTatvena shArIrikabhAvasya karmmANi santi| pUrvvaM yadvat mayA kathitaM tadvat punarapi kathyate ye janA etAdR^ishAni karmmANyAcharanti tairIshvarasya rAjye.adhikAraH kadAcha na lapsyate|</para>
  <para style="p">
    <verse number="22" style="v"/>ki ncha premAnandaH shAntishchirasahiShNutA hitaiShitA bhadratvaM vishvAsyatA titikShA</para>
  <para style="p">
    <verse number="23" style="v"/>parimitabhojitvamityAdInyAtmanaH phalAni santi teShAM viruddhA kApi vyavasthA nahi|</para>
  <para style="p">
    <verse number="24" style="v"/>ye tu khrIShTasya lokAste ripubhirabhilAShaishcha sahitaM shArIrikabhAvaM krushe nihatavantaH|</para>
  <para style="p">
    <verse number="25" style="v"/>yadi vayam AtmanA jIvAmastarhyAtmikAchAro.asmAbhiH karttavyaH,</para>
  <para style="p">
    <verse number="26" style="v"/>darpaH parasparaM nirbhartsanaM dveShashchAsmAbhi rna karttavyAni|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he bhrAtaraH, yuShmAkaM kashchid yadi kasmiMshchit pApe patati tarhyAtmikabhAvayuktai ryuShmAbhistitikShAbhAvaM vidhAya sa punarutthApyatAM yUyamapi yathA tAdR^ikparIkShAyAM na patatha tathA sAvadhAnA bhavata|</para>
  <para style="p">
    <verse number="2" style="v"/>yuShmAkam ekaiko janaH parasya bhAraM vahatvanena prakAreNa khrIShTasya vidhiM pAlayata|</para>
  <para style="p">
    <verse number="3" style="v"/>yadi kashchana kShudraH san svaM mahAntaM manyate tarhi tasyAtmava nchanA jAyate|</para>
  <para style="p">
    <verse number="4" style="v"/>ata ekaikena janena svakIyakarmmaNaH parIkShA kriyatAM tena paraM nAlokya kevalam AtmAlokanAt tasya shlaghA sambhaviShyati|</para>
  <para style="p">
    <verse number="5" style="v"/>yata ekaikoे janaH svakIyaM bhAraM vakShyati|</para>
  <para style="p">
    <verse number="6" style="v"/>yo jano dharmmopadeshaM labhate sa upadeShTAraM svIyasarvvasampatte rbhAginaM karotu|</para>
  <para style="p">
    <verse number="7" style="v"/>yuShmAkaM bhrAnti rna bhavatu, Ishvaro nopahasitavyaH, yena yad bIjam upyate tena tajjAtaM shasyaM karttiShyate|</para>
  <para style="p">
    <verse number="8" style="v"/>svasharIrArthaM yena bIjam upyate tena sharIrAd vinAsharUpaM shasyaM lapsyate kintvAtmanaH kR^ite yena bIjam upyate tenAtmato.anantajIvitarUpaM shasyaM lapsyate|</para>
  <para style="p">
    <verse number="9" style="v"/>satkarmmakaraNe.asmAbhirashrAntai rbhavitavyaM yato.aklAntaustiShThadbhirasmAbhirupayuktasamaye tat phalAni lapsyante|</para>
  <para style="p">
    <verse number="10" style="v"/>ato yAvat samayastiShThati tAvat sarvvAn prati visheShato vishvAsaveshmavAsinaH pratyasmAbhi rhitAchAraH karttavyaH|</para>
  <para style="p">
    <verse number="11" style="v"/>he bhrAtaraH, ahaM svahastena yuShmAn prati kiyadvR^ihat patraM likhitavAn tad yuShmAbhi rdR^ishyatAM|</para>
  <para style="p">
    <verse number="12" style="v"/>ye shArIrikaviShaye sudR^ishyA bhavitumichChanti te yat khrIShTasya krushasya kAraNAdupadravasya bhAgino na bhavanti kevalaM tadarthaM tvakChede yuShmAn pravarttayanti|</para>
  <para style="p">
    <verse number="13" style="v"/>te tvakChedagrAhiNo.api vyavasthAM na pAlayanti kintu yuShmachCharIrAt shlAghAlAbhArthaM yuShmAkaM tvakChedam ichChanti|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu yenAhaM saMsArAya hataH saMsAro.api mahyaM hatastadasmatprabho ryIshukhrIShTasya krushaM vinAnyatra kutrApi mama shlAghanaM kadApi na bhavatu|</para>
  <para style="p">
    <verse number="15" style="v"/>khrIShTe yIshau tvakChedAtvakChedayoH kimapi guNaM nAsti kintu navInA sR^iShTireva guNayuktA|</para>
  <para style="p">
    <verse number="16" style="v"/>aparaM yAvanto lokA etasmin mArge charanti teShAm IshvarIyasya kR^itsnasyesrAyelashcha shAnti rdayAlAbhashcha bhUyAt|</para>
  <para style="p">
    <verse number="17" style="v"/>itaH paraM ko.api mAM na klishnAtu yasmAd ahaM svagAtre prabho ryIshukhrIShTasya chihnAni dhAraye|</para>
  <para style="p">
    <verse number="18" style="v"/>he bhrAtaraH asmAkaM prabho ryIshukhrIShTasya prasAdo yuShmAkam Atmani stheyAt| tathAstu|</para>
</usx>
