  <para style="h">1 Peter</para>
  <para style="toc1">1 pitarasya patraM</para>
  <para style="toc2">1 pitaraH</para>
  <para style="toc3">1 pitaraH</para>
  <para style="mt1">1 pitarasya patraM</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>panta-gAlAtiyA-kappadakiyA-AshiyA-bithuniyAdesheShu pravAsino ye vikIrNalokAH</para>
  <para style="p">
    <verse number="2" style="v"/>piturIshvarasya pUrvvanirNayAd AtmanaH pAvanena yIshukhrIShTasyAj nAgrahaNAya shoNitaprokShaNAya chAbhiruchitAstAn prati yIshukhrIShTasya preritaH pitaraH patraM likhati| yuShmAn prati bAhulyena shAntiranugrahashcha bhUyAstAM|</para>
  <para style="p">
    <verse number="3" style="v"/>asmAkaM prabho ryIshukhrIShTasya tAta Ishvaro dhanyaH, yataH sa svakIyabahukR^ipAto mR^itagaNamadhyAd yIshukhrIShTasyotthAnena jIvanapratyAshArtham arthato</para>
  <para style="p">
    <verse number="4" style="v"/>.akShayaniShkala NkAmlAnasampattiprAptyartham asmAn puna rjanayAmAsa| sA sampattiH svarge .asmAkaM kR^ite sa nchitA tiShThati,</para>
  <para style="p">
    <verse number="5" style="v"/>yUya ncheshvarasya shaktitaH sheShakAle prakAshyaparitrANArthaM vishvAsena rakShyadhve|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmAd yUyaM yadyapyAnandena praphullA bhavatha tathApi sAmprataM prayojanahetoH kiyatkAlaparyyantaM nAnAvidhaparIkShAbhiH klishyadhve|</para>
  <para style="p">
    <verse number="7" style="v"/>yato vahninA yasya parIkShA bhavati tasmAt nashvarasuvarNAdapi bahumUlyaM yuShmAkaM vishvAsarUpaM yat parIkShitaM svarNaM tena yIshukhrIShTasyAgamanasamaye prashaMsAyAH samAdarasya gauravasya cha yogyatA prAptavyA|</para>
  <para style="p">
    <verse number="8" style="v"/>yUyaM taM khrIShTam adR^iShTvApi tasmin prIyadhve sAmprataM taM na pashyanto.api tasmin vishvasanto .anirvvachanIyena prabhAvayuktena chAnandena praphullA bhavatha,</para>
  <para style="p">
    <verse number="9" style="v"/>svavishvAsasya pariNAmarUpam AtmanAM paritrANaM labhadhve cha|</para>
  <para style="p">
    <verse number="10" style="v"/>yuShmAsu yo .anugraho varttate tadviShaye ya IshvarIyavAkyaM kathitavantaste bhaviShyadvAdinastasya paritrANasyAnveShaNam anusandhAna ncha kR^itavantaH|</para>
  <para style="p">
    <verse number="11" style="v"/>visheShatasteShAmantarvvAsI yaH khrIShTasyAtmA khrIShTe varttiShyamANAni duHkhAni tadanugAmiprabhAva ncha pUrvvaM prAkAshayat tena kaH kIdR^isho vA samayo niradishyataitasyAnusandhAnaM kR^itavantaH|</para>
  <para style="p">
    <verse number="12" style="v"/>tatastai rviShayaiste yanna svAn kintvasmAn upakurvvantyetat teShAM nikaTe prAkAshyata| yAMshcha tAn viShayAn divyadUtA apyavanatashiraso nirIkShitum abhilaShanti te viShayAH sAmprataM svargAt preShitasya pavitrasyAtmanaH sahAyyAd yuShmatsamIpe susaMvAdaprachArayitR^ibhiH prAkAshyanta|</para>
  <para style="p">
    <verse number="13" style="v"/>ataeva yUyaM manaHkaTibandhanaM kR^itvA prabuddhAH santo yIshukhrIShTasya prakAshasamaye yuShmAsu varttiShyamAnasyAnugrahasya sampUrNAM pratyAshAM kuruta|</para>
  <para style="p">
    <verse number="14" style="v"/>aparaM pUrvvIyAj nAnatAvasthAyAH kutsitAbhilAShANAM yogyam AchAraM na kurvvanto yuShmadAhvAnakArI yathA pavitro .asti</para>
  <para style="p">
    <verse number="15" style="v"/>yUyamapyAj nAgrAhisantAnA iva sarvvasmin AchAre tAdR^ik pavitrA bhavata|</para>
  <para style="p">
    <verse number="16" style="v"/>yato likhitam Aste, yUyaM pavitrAstiShThata yasmAdahaM pavitraH|</para>
  <para style="p">
    <verse number="17" style="v"/>apara ncha yo vinApakShapAtam ekaikamAnuShasya karmmAnusArAd vichAraM karoti sa yadi yuShmAbhistAta AkhyAyate tarhi svapravAsasya kAlo yuShmAbhi rbhItyA yApyatAM|</para>
  <para style="p">
    <verse number="18" style="v"/>yUyaM nirarthakAt paitR^ikAchArAt kShayaNIyai rUpyasuvarNAdibhi rmuktiM na prApya</para>
  <para style="p">
    <verse number="19" style="v"/>niShkala NkanirmmalameShashAvakasyeva khrIShTasya bahumUlyena rudhireNa muktiM prAptavanta iti jAnItha|</para>
  <para style="p">
    <verse number="20" style="v"/>sa jagato bhittimUlasthApanAt pUrvvaM niyuktaH kintu charamadineShu yuShmadarthaM prakAshito .abhavat|</para>
  <para style="p">
    <verse number="21" style="v"/>yatastenaiva mR^itagaNAt tasyotthApayitari tasmai gauravadAtari cheshvare vishvasitha tasmAd Ishvare yuShmAkaM vishvAsaH pratyAshA chAste|</para>
  <para style="p">
    <verse number="22" style="v"/>yUyam AtmanA satyamatasyAj nAgrahaNadvArA niShkapaTAya bhrAtR^ipremne pAvitamanaso bhUtvA nirmmalAntaHkaraNaiH parasparaM gADhaM prema kuruta|</para>
  <para style="p">
    <verse number="23" style="v"/>yasmAd yUyaM kShayaNIyavIryyAt nahi kintvakShayaNIyavIryyAd Ishvarasya jIvanadAyakena nityasthAyinA vAkyena punarjanma gR^ihItavantaH|</para>
  <para style="p">
    <verse number="24" style="v"/>sarvvaprANI tR^iNaistulyastattejastR^iNapuShpavat| tR^iNAni parishuShyati puShpANi nipatanti cha|</para>
  <para style="p">
    <verse number="25" style="v"/>kintu vAkyaM pareshasyAnantakAlaM vitiShThate| tadeva cha vAkyaM susaMvAdena yuShmAkam antike prakAshitaM|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>sarvvAn dveShAn sarvvAMshcha ChalAn kApaTyAnIrShyAH samastaglAnikathAshcha dUrIkR^itya</para>
  <para style="p">
    <verse number="2" style="v"/>yuShmAbhiH paritrANAya vR^iddhiprAptyarthaM navajAtashishubhiriva prakR^itaM vAgdugdhaM pipAsyatAM|</para>
  <para style="p">
    <verse number="3" style="v"/>yataH prabhu rmadhura etasyAsvAdaM yUyaM prAptavantaH|</para>
  <para style="p">
    <verse number="4" style="v"/>aparaM mAnuShairavaj nAtasya kintvIshvareNAbhiruchitasya bahumUlyasya jIvatprastarasyeva tasya prabhoH sannidhim AgatA</para>
  <para style="p">
    <verse number="5" style="v"/>yUyamapi jIvatprastarA iva nichIyamAnA AtmikamandiraM khrIShTena yIshunA cheshvaratoShakANAm AtmikabalInAM dAnArthaM pavitro yAjakavargo bhavatha|</para>
  <para style="p">
    <verse number="6" style="v"/>yataH shAstre likhitamAste, yathA, pashya pAShANa eko .asti sIyoni sthApito mayA| mukhyakoNasya yogyaH sa vR^itashchAtIva mUlyavAn| yo jano vishvaset tasmin sa lajjAM na gamiShyati|</para>
  <para style="p">
    <verse number="7" style="v"/>vishvAsinAM yuShmAkameva samIpe sa mUlyavAn bhavati kintvavishvAsinAM kR^ite nichetR^ibhiravaj nAtaH sa pAShANaH koNasya bhittimUlaM bhUtvA bAdhAjanakaH pAShANaH skhalanakArakashcha shailo jAtaH|</para>
  <para style="p">
    <verse number="8" style="v"/>te chAvishvAsAd vAkyena skhalanti skhalane cha niyuktAH santi|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu yUyaM yenAndhakAramadhyAt svakIyAshcharyyadIptimadhyam AhUtAstasya guNAn prakAshayitum abhiruchito vaMsho rAjakIyo yAjakavargaH pavitrA jAtiradhikarttavyAH prajAshcha jAtAH|</para>
  <para style="p">
    <verse number="10" style="v"/>pUrvvaM yUyaM tasya prajA nAbhavata kintvidAnIm Ishvarasya prajA Adhve| pUrvvam ananukampitA abhavata kintvidAnIm anukampitA Adhve|</para>
  <para style="p">
    <verse number="11" style="v"/>he priyatamAH, yUyaM pravAsino videshinashcha lokA iva manasaH prAtikUlyena yodhibhyaH shArIrikasukhAbhilAShebhyo nivarttadhvam ityahaM vinaye|</para>
  <para style="p">
    <verse number="12" style="v"/>devapUjakAnAM madhye yuShmAkam AchAra evam uttamo bhavatu yathA te yuShmAn duShkarmmakArilokAniva puna rna nindantaH kR^ipAdR^iShTidine svachakShurgocharIyasatkriyAbhya Ishvarasya prashaMsAM kuryyuH|</para>
  <para style="p">
    <verse number="13" style="v"/>tato heto ryUyaM prabhoranurodhAt mAnavasR^iShTAnAM kartR^itvapadAnAM vashIbhavata visheShato bhUpAlasya yataH sa shreShThaH,</para>
  <para style="p">
    <verse number="14" style="v"/>deshAdhyakShANA ncha yataste duShkarmmakAriNAM daNDadAnArthaM satkarmmakAriNAM prashaMsArtha ncha tena preritAH|</para>
  <para style="p">
    <verse number="15" style="v"/>itthaM nirbbodhamAnuShANAm aj nAnatvaM yat sadAchAribhi ryuShmAbhi rniruttarIkriyate tad IshvarasyAbhimataM|</para>
  <para style="p">
    <verse number="16" style="v"/>yUyaM svAdhInA ivAcharata tathApi duShTatAyA veShasvarUpAM svAdhInatAM dhArayanta iva nahi kintvIshvarasya dAsA iva|</para>
  <para style="p">
    <verse number="17" style="v"/>sarvvAn samAdriyadhvaM bhrAtR^ivarge prIyadhvam IshvarAd bibhIta bhUpAlaM sammanyadhvaM|</para>
  <para style="p">
    <verse number="18" style="v"/>he dAsAH yUyaM sampUrNAdareNa prabhUnAM vashyA bhavata kevalaM bhadrANAM dayAlUnA ncha nahi kintvanR^ijUnAmapi|</para>
  <para style="p">
    <verse number="19" style="v"/>yato .anyAyena duHkhabhogakAla IshvarachintayA yat kleshasahanaM tadeva priyaM|</para>
  <para style="p">
    <verse number="20" style="v"/>pApaM kR^itvA yuShmAkaM chapeTAghAtasahanena kA prashaMsA? kintu sadAchAraM kR^itvA yuShmAkaM yad duHkhasahanaM tadeveshvarasya priyaM|</para>
  <para style="p">
    <verse number="21" style="v"/>tadarthameva yUyam AhUtA yataH khrIShTo.api yuShmannimittaM duHkhaM bhuktvA yUyaM yat tasya padachihnai rvrajeta tadarthaM dR^iShTAntamekaM darshitavAn|</para>
  <para style="p">
    <verse number="22" style="v"/>sa kimapi pApaM na kR^itavAn tasya vadane kApi Chalasya kathA nAsIt|</para>
  <para style="p">
    <verse number="23" style="v"/>nindito .api san sa pratinindAM na kR^itavAn duHkhaM sahamAno .api na bhartsitavAn kintu yathArthavichArayituH samIpe svaM samarpitavAn|</para>
  <para style="p">
    <verse number="24" style="v"/>vayaM yat pApebhyo nivR^itya dharmmArthaM jIvAmastadarthaM sa svasharIreNAsmAkaM pApAni krusha UDhavAn tasya prahArai ryUyaM svasthA abhavata|</para>
  <para style="p">
    <verse number="25" style="v"/>yataH pUrvvaM yUyaM bhramaNakArimeShA ivAdhvaM kintvadhunA yuShmAkam AtmanAM pAlakasyAdhyakShasya cha samIpaM pratyAvarttitAH|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he yoShitaH, yUyamapi nijasvAminAM vashyA bhavata tathA sati yadi kechid vAkye vishvAsino na santi tarhi</para>
  <para style="p">
    <verse number="2" style="v"/>te vinAvAkyaM yoShitAm AchAreNArthatasteShAM pratyakSheNa yuShmAkaM sabhayasatItvAchAreNAkraShTuM shakShyante|</para>
  <para style="p">
    <verse number="3" style="v"/>aparaM kesharachanayA svarNAla NkAradhAraNona parichChadaparidhAnena vA yuShmAkaM vAhyabhUShA na bhavatu,</para>
  <para style="p">
    <verse number="4" style="v"/>kintvIshvarasya sAkShAd bahumUlyakShamAshAntibhAvAkShayaratnena yukto gupta AntarikamAnava eva|</para>
  <para style="p">
    <verse number="5" style="v"/>yataH pUrvvakAle yAH pavitrastriya Ishvare pratyAshAmakurvvan tA api tAdR^ishImeva bhUShAM dhArayantyo nijasvAminAM vashyA abhavan|</para>
  <para style="p">
    <verse number="6" style="v"/>tathaiva sArA ibrAhImo vashyA satI taM patimAkhyAtavatI yUya ncha yadi sadAchAriNyo bhavatha vyAkulatayA cha bhItA na bhavatha tarhi tasyAH kanyA Adhve|</para>
  <para style="p">
    <verse number="7" style="v"/>he puruShAH, yUyaM j nAnato durbbalatarabhAjanairiva yoShidbhiH sahavAsaM kuruta, ekasya jIvanavarasya sahabhAginIbhyatAbhyaH samAdaraM vitarata cha na ched yuShmAkaM prArthanAnAM bAdhA janiShyate|</para>
  <para style="p">
    <verse number="8" style="v"/>visheShato yUyaM sarvva ekamanasaH paraduHkhai rduHkhitA bhrAtR^ipramiNaH kR^ipAvantaH prItibhAvAshcha bhavata|</para>
  <para style="p">
    <verse number="9" style="v"/>aniShTasya parishodhenAniShTaM nindAyA vA parishodhena nindAM na kurvvanta AshiShaM datta yato yUyam AshiradhikAriNo bhavitumAhUtA iti jAnItha|</para>
  <para style="p">
    <verse number="10" style="v"/>apara ncha, jIvane prIyamANo yaH sudinAni didR^ikShate| pApAt jihvAM mR^iShAvAkyAt svAdharau sa nivarttayet|</para>
  <para style="p">
    <verse number="11" style="v"/>sa tyajed duShTatAmArgaM satkriyA ncha samAcharet| mR^igayANashcha shAntiM sa nityamevAnudhAvatu|</para>
  <para style="p">
    <verse number="12" style="v"/>lochane parameshasyonmIlite dhArmmikAn prati| prArthanAyAH kR^ite teShAH tachChrotre sugame sadA| krodhAsya ncha pareshasya kadAchAriShu varttate|</para>
  <para style="p">
    <verse number="13" style="v"/>aparaM yadi yUyam uttamasyAnugAmino bhavatha tarhi ko yuShmAn hiMsiShyate?</para>
  <para style="p">
    <verse number="14" style="v"/>yadi cha dharmmArthaM klishyadhvaM tarhi dhanyA bhaviShyatha| teShAm Asha NkayA yUyaM na bibhIta na vi Nkta vA|</para>
  <para style="p">
    <verse number="15" style="v"/>manobhiH kintu manyadhvaM pavitraM prabhumIshvaraM| apara ncha yuShmAkam AntarikapratyAshAyAstattvaM yaH kashchit pR^ichChati tasmai shAntibhItibhyAm uttaraM dAtuM sadA susajjA bhavata|</para>
  <para style="p">
    <verse number="16" style="v"/>ye cha khrIShTadharmme yuShmAkaM sadAchAraM dUShayanti te duShkarmmakAriNAmiva yuShmAkam apavAdena yat lajjitA bhaveyustadarthaM yuShmAkam uttamaH saMvedo bhavatu|</para>
  <para style="p">
    <verse number="17" style="v"/>IshvarasyAbhimatAd yadi yuShmAbhiH kleshaH soDhavyastarhi sadAchAribhiH kleshasahanaM varaM na cha kadAchAribhiH|</para>
  <para style="p">
    <verse number="18" style="v"/>yasmAd Ishvarasya sannidhim asmAn Anetum adhArmmikANAM vinimayena dhArmmikaH khrIShTo .apyekakR^itvaH pApAnAM daNDaM bhuktavAn, sa cha sharIrasambandhe mAritaH kintvAtmanaH sambandhe puna rjIvito .abhavat|</para>
  <para style="p">
    <verse number="19" style="v"/>tatsambandhe cha sa yAtrAM vidhAya kArAbaddhAnAm AtmanAM samIpe vAkyaM ghoShitavAn|</para>
  <para style="p">
    <verse number="20" style="v"/>purA nohasya samaye yAvat poto niramIyata tAvad Ishvarasya dIrghasahiShNutA yadA vyalambata tadA te.anAj nAgrAhiNo.abhavan| tena potonAlpe.arthAd aShTAveva prANinastoyam uttIrNAH|</para>
  <para style="p">
    <verse number="21" style="v"/>tannidarshana nchAvagAhanaM (arthataH shArIrikamalinatAyA yastyAgaH sa nahi kintvIshvarAyottamasaMvedasya yA prataj nA saiva) yIshukhrIShTasya punarutthAnenedAnIm asmAn uttArayati,</para>
  <para style="p">
    <verse number="22" style="v"/>yataH sa svargaM gatveshvarasya dakShiNe vidyate svargIyadUtAH shAsakA balAni cha tasya vashIbhUtA abhavan|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>asmAkaM vinimayena khrIShTaH sharIrasambandhe daNDaM bhuktavAn ato hetoH sharIrasambandhe yo daNDaM bhuktavAn sa pApAt mukta</para>
  <para style="p">
    <verse number="2" style="v"/>itibhAvena yUyamapi susajjIbhUya dehavAsasyAvashiShTaM samayaM punarmAnavAnAm ichChAsAdhanArthaM nahi kintvIshvarasyechChAsAdhanArthaM yApayata|</para>
  <para style="p">
    <verse number="3" style="v"/>AyuSho yaH samayo vyatItastasmin yuShmAbhi ryad devapUjakAnAm ichChAsAdhanaM kAmakutsitAbhilAShamadyapAnara NgarasamattatAghR^iNArhadevapUjAcharaNa nchAkAri tena bAhulyaM|</para>
  <para style="p">
    <verse number="4" style="v"/>yUyaM taiH saha tasmin sarvvanAshapa Nke majjituM na dhAvatha, ityanenAshcharyyaM vij nAya te yuShmAn nindanti|</para>
  <para style="p">
    <verse number="5" style="v"/>kintu yo jIvatAM mR^itAnA ncha vichAraM karttum udyato.asti tasmai tairuttaraM dAyiShyate|</para>
  <para style="p">
    <verse number="6" style="v"/>yato heto rye mR^itAsteShAM yat mAnavoddeshyaH shArIrikavichAraH kintvIshvaroddeshyam AtmikajIvanaM bhavat tadarthaM teShAmapi sannidhau susamAchAraH prakAshito.abhavat|</para>
  <para style="p">
    <verse number="7" style="v"/>sarvveShAm antimakAla upasthitastasmAd yUyaM subuddhayaH prArthanArthaM jAgratashcha bhavata|</para>
  <para style="p">
    <verse number="8" style="v"/>visheShataH parasparaM gADhaM prema kuruta, yataH, pApAnAmapi bAhulyaM premnaivAchChAdayiShyate|</para>
  <para style="p">
    <verse number="9" style="v"/>kAtaroktiM vinA parasparam AtithyaM kR^iruta|</para>
  <para style="p">
    <verse number="10" style="v"/>yena yo varo labdhastenaiva sa param upakarotR^i, itthaM yUyam Ishvarasya bahuvidhaprasAdasyottamA bhANDAgArAdhipA bhavata|</para>
  <para style="p">
    <verse number="11" style="v"/>yo vAkyaM kathayati sa Ishvarasya vAkyamiva kathayatu yashcha param upakaroti sa IshvaradattasAmarthyAdivopakarotu| sarvvaviShaye yIshukhrIShTeneshvarasya gauravaM prakAshyatAM tasyaiva gauravaM parAkramashcha sarvvadA bhUyAt| Amena|</para>
  <para style="p">
    <verse number="12" style="v"/>he priyatamAH, yuShmAkaM parIkShArthaM yastApo yuShmAsu varttate tam asambhavaghaTitaM matvA nAshcharyyaM jAnIta,</para>
  <para style="p">
    <verse number="13" style="v"/>kintu khrIShTena kleshAnAM sahabhAgitvAd Anandata tena tasya pratApaprakAshe.apyAnanandena praphullA bhaviShyatha|</para>
  <para style="p">
    <verse number="14" style="v"/>yadi khrIShTasya nAmahetunA yuShmAkaM nindA bhavati tarhi yUyaM dhanyA yato gauravadAyaka IshvarasyAtmA yuShmAsvadhitiShThati teShAM madhye sa nindyate kintu yuShmanmadhye prashaMsyate|</para>
  <para style="p">
    <verse number="15" style="v"/>kintu yuShmAkaM ko.api hantA vA chairo vA duShkarmmakR^id vA parAdhikAracharchchaka iva daNDaM na bhu NktAM|</para>
  <para style="p">
    <verse number="16" style="v"/>yadi cha khrIShTIyAna iva daNDaM bhu Nkte tarhi sa na lajjamAnastatkAraNAd IshvaraM prashaMsatu|</para>
  <para style="p">
    <verse number="17" style="v"/>yato vichArasyArambhasamaye Ishvarasya mandire yujyate yadi chAsmatsvArabhate tarhIshvarIyasusaMvAdAgrAhiNAM sheShadashA kA bhaviShyati?</para>
  <para style="p">
    <verse number="18" style="v"/>dhArmmikenApi chet trANam atikR^ichChreNa gamyate| tarhyadhArmmikapApibhyAm AshrayaH kutra lapsyate|</para>
  <para style="p">
    <verse number="19" style="v"/>ata IshvarechChAto ye duHkhaM bhu njate te sadAchAreNa svAtmAno vishvAsyasraShTurIshvasya karAbhyAM nidadhatAM|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>khrIShTasya kleshAnAM sAkShI prakAshiShyamANasya pratApasyAMshI prAchInashchAhaM yuShmAkaM prAchInAn vinIyedaM vadAmi|</para>
  <para style="p">
    <verse number="2" style="v"/>yuShmAkaM madhyavarttI ya Ishvarasya meShavR^indo yUyaM taM pAlayata tasya vIkShaNaM kuruta cha, Avashyakatvena nahi kintu svechChAto na va kulobhena kintvichChukamanasA|</para>
  <para style="p">
    <verse number="3" style="v"/>aparam aMshAnAm adhikAriNa iva na prabhavata kintu vR^indasya dR^iShTAntasvarUpA bhavata|</para>
  <para style="p">
    <verse number="4" style="v"/>tena pradhAnapAlaka upasthite yUyam amlAnaM gauravakirITaM lapsyadhve|</para>
  <para style="p">
    <verse number="5" style="v"/>he yuvAnaH, yUyamapi prAchInalokAnAM vashyA bhavata sarvve cha sarvveShAM vashIbhUya namratAbharaNena bhUShitA bhavata, yataH,AtmAbhimAnilokAnAM vipakSho bhavatIshvaraH| kintu tenaiva namrebhyaH prasAdAd dIyate varaH|</para>
  <para style="p">
    <verse number="6" style="v"/>ato yUyam Ishvarasya balavatkarasyAdho namrIbhUya tiShThata tena sa uchitasamaye yuShmAn uchchIkariShyati|</para>
  <para style="p">
    <verse number="7" style="v"/>yUyaM sarvvachintAM tasmin nikShipata yataH sa yuShmAn prati chintayati|</para>
  <para style="p">
    <verse number="8" style="v"/>yUyaM prabuddhA jAgratashcha tiShThata yato yuShmAkaM prativAdI yaH shayatAnaH sa garjjanakArI siMha iva paryyaTan kaM grasiShyAmIti mR^igayate,</para>
  <para style="p">
    <verse number="9" style="v"/>ato vishvAse susthirAstiShThantastena sArddhaM yudhyata, yuShmAkaM jagannivAsibhrAtR^iShvapi tAdR^ishAH kleshA varttanta iti jAnIta|</para>
  <para style="p">
    <verse number="10" style="v"/>kShaNikaduHkhabhogAt param asmabhyaM khrIShTena yIshunA svakIyAnantagauravadAnArthaM yo.asmAn AhUtavAn sa sarvvAnugrAhIshvaraH svayaM yuShmAn siddhAn sthirAn sabalAn nishchalAMshcha karotu|</para>
  <para style="p">
    <verse number="11" style="v"/>tasya gauravaM parAkramashchAnantakAlaM yAvad bhUyAt| Amen|</para>
  <para style="p">
    <verse number="12" style="v"/>yaH silvAno (manye) yuShmAkaM vishvAsyo bhrAtA bhavati tadvArAhaM saMkShepeNa likhitvA yuShmAn vinItavAn yUya ncha yasmin adhitiShThatha sa eveshvarasya satyo .anugraha iti pramANaM dattavAn|</para>
  <para style="p">
    <verse number="13" style="v"/>yuShmAbhiH sahAbhiruchitA yA samiti rbAbili vidyate sA mama putro mArkashcha yuShmAn namaskAraM vedayati|</para>
  <para style="p">
    <verse number="14" style="v"/>yUyaM premachumbanena parasparaM namaskuruta| yIshukhrIShTAshritAnAM yuShmAkaM sarvveShAM shAnti rbhUyAt| Amen|</para>
</usx>
