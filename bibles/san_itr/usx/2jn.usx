  <para style="h">2 John</para>
  <para style="toc1">2 yohanaH patraM</para>
  <para style="toc2">2 yohanaH</para>
  <para style="toc3">2 yohanaH</para>
  <para style="mt1">2 yohanaH patraM</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he abhiruchite kuriye, tvAM tava putrAMshcha prati prAchIno.ahaM patraM likhAmi|</para>
  <para style="p">
    <verse number="2" style="v"/>satyamatAd yuShmAsu mama premAsti kevalaM mama nahi kintu satyamataj nAnAM sarvveShAmeva| yataH satyamatam asmAsu tiShThatyanantakAlaM yAvachchAsmAsu sthAsyati|</para>
  <para style="p">
    <verse number="3" style="v"/>piturIshvarAt tatpituH putrAt prabho ryIshukhrIShTAchcha prApyo .anugrahaH kR^ipA shAntishcha satyatApremabhyAM sArddhaM yuShmAn adhitiShThatu|</para>
  <para style="p">
    <verse number="4" style="v"/>vayaM pitR^ito yAm Aj nAM prAptavantastadanusAreNa tava kechid AtmajAH satyamatam Acharantyetasya pramANaM prApyAhaM bhR^isham AnanditavAn|</para>
  <para style="p">
    <verse number="5" style="v"/>sAmprata ncha he kuriye, navInAM kA nchid Aj nAM na likhannaham Adito labdhAm Aj nAM likhan tvAm idaM vinaye yad asmAbhiH parasparaM prema karttavyaM|</para>
  <para style="p">
    <verse number="6" style="v"/>aparaM premaitena prakAshate yad vayaM tasyAj nA Acharema| Adito yuShmAbhi ryA shrutA seyam Aj nA sA cha yuShmAbhirAcharitavyA|</para>
  <para style="p">
    <verse number="7" style="v"/>yato bahavaH prava nchakA jagat pravishya yIshukhrIShTo narAvatAro bhUtvAgata etat nA NgIkurvvanti sa eva prava nchakaH khrIShTArishchAsti|</para>
  <para style="p">
    <verse number="8" style="v"/>asmAkaM shramo yat paNDashramo na bhavet kintu sampUrNaM vetanamasmAbhi rlabhyeta tadarthaM svAnadhi sAvadhAnA bhavataH|</para>
  <para style="p">
    <verse number="9" style="v"/>yaH kashchid vipathagAmI bhUtvA khrIShTasya shikShAyAM na tiShThati sa IshvaraM na dhArayati khrIShTasya shij nAyAM yastiShThati sa pitaraM putra ncha dhArayati|</para>
  <para style="p">
    <verse number="10" style="v"/>yaH kashchid yuShmatsannidhimAgachChan shikShAmenAM nAnayati sa yuShmAbhiH svaveshmani na gR^ihyatAM tava ma NgalaM bhUyAditi vAgapi tasmai na kathyatAM|</para>
  <para style="p">
    <verse number="11" style="v"/>yatastava ma NgalaM bhUyAditi vAchaM yaH kashchit tasmai kathayati sa tasya duShkarmmaNAm aMshI bhavati|</para>
  <para style="p">
    <verse number="12" style="v"/>yuShmAn prati mayA bahUni lekhitavyAni kintu patramasIbhyAM tat karttuM nechChAmi, yato .asmAkam Anando yathA sampUrNo bhaviShyati tathA yuShmatsamIpamupasthAyAhaM sammukhIbhUya yuShmAbhiH sambhAShiShya iti pratyAshA mamAste|</para>
  <para style="p">
    <verse number="13" style="v"/>tavAbhiruchitAyA bhaginyA bAlakAstvAM namaskAraM j nApayanti| Amen|</para>
</usx>
