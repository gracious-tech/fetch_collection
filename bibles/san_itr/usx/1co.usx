  <para style="h">1 Corinthians</para>
  <para style="toc1">1 karinthinaH patraM</para>
  <para style="toc2">1 karinthinaH</para>
  <para style="toc3">1 karinthinaH</para>
  <para style="mt1">1 karinthinaH patraM</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yAvantaH pavitrA lokAH sveShAm asmAka ncha vasatisthAneShvasmAkaM prabho ryIshoH khrIShTasya nAmnA prArthayante taiH sahAhUtAnAM khrIShTena yIshunA pavitrIkR^itAnAM lokAnAM ya IshvarIyadharmmasamAjaH karinthanagare vidyate</para>
  <para style="p">
    <verse number="2" style="v"/>taM pratIshvarasyechChayAhUto yIshukhrIShTasya preritaH paulaH sosthininAmA bhrAtA cha patraM likhati|</para>
  <para style="p">
    <verse number="3" style="v"/>asmAkaM pitreshvareNa prabhunA yIshukhrIShTena cha prasAdaH shAntishcha yuShmabhyaM dIyatAM|</para>
  <para style="p">
    <verse number="4" style="v"/>Ishvaro yIshukhrIShTena yuShmAn prati prasAdaM prakAshitavAn, tasmAdahaM yuShmannimittaM sarvvadA madIyeshvaraM dhanyaM vadAmi|</para>
  <para style="p">
    <verse number="5" style="v"/>khrIShTasambandhIyaM sAkShyaM yuShmAkaM madhye yena prakAreNa sapramANam abhavat</para>
  <para style="p">
    <verse number="6" style="v"/>tena yUyaM khrIShTAt sarvvavidhavaktR^itAj nAnAdIni sarvvadhanAni labdhavantaH|</para>
  <para style="p">
    <verse number="7" style="v"/>tato.asmatprabho ryIshukhrIShTasya punarAgamanaM pratIkShamANAnAM yuShmAkaM kasyApi varasyAbhAvo na bhavati|</para>
  <para style="p">
    <verse number="8" style="v"/>aparam asmAkaM prabho ryIshukhrIShTasya divase yUyaM yannirddoShA bhaveta tadarthaM saeva yAvadantaM yuShmAn susthirAn kariShyati|</para>
  <para style="p">
    <verse number="9" style="v"/>ya IshvaraH svaputrasyAsmatprabho ryIshukhrIShTasyAMshinaH karttuM yuShmAn AhUtavAn sa vishvasanIyaH|</para>
  <para style="p">
    <verse number="10" style="v"/>he bhrAtaraH, asmAkaM prabhuyIshukhrIShTasya nAmnA yuShmAn vinaye.ahaM sarvvai ryuShmAbhirekarUpANi vAkyAni kathyantAM yuShmanmadhye bhinnasa NghAtA na bhavantu manovichArayoraikyena yuShmAkaM siddhatvaM bhavatu|</para>
  <para style="p">
    <verse number="11" style="v"/>he mama bhrAtaro yuShmanmadhye vivAdA jAtA iti vArttAmahaM kloyyAH parijanai rj nApitaH|</para>
  <para style="p">
    <verse number="12" style="v"/>mamAbhipretamidaM yuShmAkaM kashchit kashchid vadati paulasya shiShyo.aham ApalloH shiShyo.ahaM kaiphAH shiShyo.ahaM khrIShTasya shiShyo.ahamiti cha|</para>
  <para style="p">
    <verse number="13" style="v"/>khrIShTasya kiM vibhedaH kR^itaH? paulaH kiM yuShmatkR^ite krushe hataH? paulasya nAmnA vA yUyaM kiM majjitAH?</para>
  <para style="p">
    <verse number="14" style="v"/>kriShpagAyau vinA yuShmAkaM madhye.anyaH ko.api mayA na majjita iti hetoraham IshvaraM dhanyaM vadAmi|</para>
  <para style="p">
    <verse number="15" style="v"/>etena mama nAmnA mAnavA mayA majjitA iti vaktuM kenApi na shakyate|</para>
  <para style="p">
    <verse number="16" style="v"/>aparaM stiphAnasya parijanA mayA majjitAstadanyaH kashchid yanmayA majjitastadahaM na vedmi|</para>
  <para style="p">
    <verse number="17" style="v"/>khrIShTenAhaM majjanArthaM na preritaH kintu susaMvAdasya prachArArthameva; so.api vAkpaTutayA mayA na prachAritavyaH, yatastathA prachArite khrIShTasya krushe mR^ityuH phalahIno bhaviShyati|</para>
  <para style="p">
    <verse number="18" style="v"/>yato heto rye vinashyanti te tAM krushasya vArttAM pralApamiva manyante ki ncha paritrANaM labhamAneShvasmAsu sA IshvarIyashaktisvarUpA|</para>
  <para style="p">
    <verse number="19" style="v"/>tasmAditthaM likhitamAste, j nAnavatAntu yat j nAnaM tanmayA nAshayiShyate| vilopayiShyate tadvad buddhi rbaddhimatAM mayA||</para>
  <para style="p">
    <verse number="20" style="v"/>j nAnI kutra? shAstrI vA kutra? ihalokasya vichAratatparo vA kutra? ihalokasya j nAnaM kimIshvareNa mohIkR^itaM nahi?</para>
  <para style="p">
    <verse number="21" style="v"/>Ishvarasya j nAnAd ihalokasya mAnavAH svaj nAneneshvarasya tattvabodhaM na prAptavantastasmAd IshvaraH prachArarUpiNA pralApena vishvAsinaH paritrAtuM rochitavAn|</para>
  <para style="p">
    <verse number="22" style="v"/>yihUdIyalokA lakShaNAni didR^ikShanti bhinnadeshIyalokAstu vidyAM mR^igayante,</para>
  <para style="p">
    <verse number="23" style="v"/>vaya ncha krushe hataM khrIShTaM prachArayAmaH| tasya prachAro yihUdIyai rvighna iva bhinnadeshIyaishcha pralApa iva manyate,</para>
  <para style="p">
    <verse number="24" style="v"/>kintu yihUdIyAnAM bhinnadeshIyAnA ncha madhye ye AhUtAsteShu sa khrIShTa IshvarIyashaktiriveshvarIyaj nAnamiva cha prakAshate|</para>
  <para style="p">
    <verse number="25" style="v"/>yata Ishvare yaH pralApa Aropyate sa mAnavAtiriktaM j nAnameva yachcha daurbbalyam Ishvara Aropyate tat mAnavAtiriktaM balameva|</para>
  <para style="p">
    <verse number="26" style="v"/>he bhrAtaraH, AhUtayuShmadgaNo yaShmAbhirAlokyatAM tanmadhye sAMsArikaj nAnena j nAnavantaH parAkramiNo vA kulInA vA bahavo na vidyante|</para>
  <para style="p">
    <verse number="27" style="v"/>yata Ishvaro j nAnavatastrapayituM mUrkhalokAn rochitavAn balAni cha trapayitum Ishvaro durbbalAn rochitavAn|</para>
  <para style="p">
    <verse number="28" style="v"/>tathA varttamAnalokAn saMsthitibhraShTAn karttum Ishvaro jagato.apakR^iShTAn heyAn avarttamAnAMshchAbhirochitavAn|</para>
  <para style="p">
    <verse number="29" style="v"/>tata Ishvarasya sAkShAt kenApyAtmashlAghA na karttavyA|</para>
  <para style="p">
    <verse number="30" style="v"/>yUya ncha tasmAt khrIShTe yIshau saMsthitiM prAptavantaH sa IshvarAd yuShmAkaM j nAnaM puNyaM pavitratvaM muktishcha jAtA|</para>
  <para style="p">
    <verse number="31" style="v"/>ataeva yadvad likhitamAste tadvat, yaH kashchit shlAghamAnaH syAt shlAghatAM prabhunA sa hi|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he bhrAtaro yuShmatsamIpe mamAgamanakAle.ahaM vaktR^itAyA vidyAyA vA naipuNyeneshvarasya sAkShyaM prachAritavAn tannahi;</para>
  <para style="p">
    <verse number="2" style="v"/>yato yIshukhrIShTaM tasya krushe hatatva ncha vinA nAnyat kimapi yuShmanmadhye j nApayituM vihitaM buddhavAn|</para>
  <para style="p">
    <verse number="3" style="v"/>apara nchAtIva daurbbalyabhItikampayukto yuShmAbhiH sArddhamAsaM|</para>
  <para style="p">
    <verse number="4" style="v"/>aparaM yuShmAkaM vishvAso yat mAnuShikaj nAnasya phalaM na bhavet kintvIshvarIyashakteH phalaM bhavet,</para>
  <para style="p">
    <verse number="5" style="v"/>tadarthaM mama vaktR^itA madIyaprachArashcha mAnuShikaj nAnasya madhuravAkyasambalitau nAstAM kintvAtmanaH shakteshcha pramANayuktAvAstAM|</para>
  <para style="p">
    <verse number="6" style="v"/>vayaM j nAnaM bhAShAmahe tachcha siddhalokai rj nAnamiva manyate, tadihalokasya j nAnaM nahi, ihalokasya nashvarANAm adhipatInAM vA j nAnaM nahi;</para>
  <para style="p">
    <verse number="7" style="v"/>kintu kAlAvasthAyAH pUrvvasmAd yat j nAnam asmAkaM vibhavArtham IshvareNa nishchitya prachChannaM tannigUDham IshvarIyaj nAnaM prabhAShAmahe|</para>
  <para style="p">
    <verse number="8" style="v"/>ihalokasyAdhipatInAM kenApi tat j nAnaM na labdhaM, labdhe sati te prabhAvavishiShTaM prabhuM krushe nAhaniShyan|</para>
  <para style="p">
    <verse number="9" style="v"/>tadvallikhitamAste, netreNa kkApi no dR^iShTaM karNenApi cha na shrutaM| manomadhye tu kasyApi na praviShTaM kadApi yat|Ishvare prIyamANAnAM kR^ite tat tena sa nchitaM|</para>
  <para style="p">
    <verse number="10" style="v"/>aparamIshvaraH svAtmanA tadasmAkaM sAkShAt prAkAshayat; yata AtmA sarvvamevAnusandhatte tena cheshvarasya marmmatattvamapi budhyate|</para>
  <para style="p">
    <verse number="11" style="v"/>manujasyAntaHsthamAtmAnaM vinA kena manujena tasya manujasya tattvaM budhyate? tadvadIshvarasyAtmAnaM vinA kenApIshvarasya tattvaM na budhyate|</para>
  <para style="p">
    <verse number="12" style="v"/>vaya nchehalokasyAtmAnaM labdhavantastannahi kintvIshvarasyaivAtmAnaM labdhavantaH, tato hetorIshvareNa svaprasAdAd asmabhyaM yad yad dattaM tatsarvvam asmAbhi rj nAtuM shakyate|</para>
  <para style="p">
    <verse number="13" style="v"/>tachchAsmAbhi rmAnuShikaj nAnasya vAkyAni shikShitvA kathyata iti nahi kintvAtmato vAkyAni shikShitvAtmikai rvAkyairAtmikaM bhAvaM prakAshayadbhiH kathyate|</para>
  <para style="p">
    <verse number="14" style="v"/>prANI manuShya IshvarIyAtmanaH shikShAM na gR^ihlAti yata AtmikavichAreNa sA vichAryyeti hetoH sa tAM pralApamiva manyate boddhu ncha na shaknoti|</para>
  <para style="p">
    <verse number="15" style="v"/>Atmiko mAnavaH sarvvANi vichArayati kintu svayaM kenApi na vichAryyate|</para>
  <para style="p">
    <verse number="16" style="v"/>yata Ishvarasya mano j nAtvA tamupadeShTuM kaH shaknoti? kintu khrIShTasya mano.asmAbhi rlabdhaM|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he bhrAtaraH, ahamAtmikairiva yuShmAbhiH samaM sambhAShituM nAshaknavaM kintu shArIrikAchAribhiH khrIShTadharmme shishutulyaishcha janairiva yuShmAbhiH saha samabhAShe|</para>
  <para style="p">
    <verse number="2" style="v"/>yuShmAn kaThinabhakShyaM na bhojayan dugdham apAyayaM yato yUyaM bhakShyaM grahItuM tadA nAshaknuta idAnImapi na shaknutha, yato hetoradhunApi shArIrikAchAriNa Adhve|</para>
  <para style="p">
    <verse number="3" style="v"/>yuShmanmadhye mAtsaryyavivAdabhedA bhavanti tataH kiM shArIrikAchAriNo nAdhve mAnuShikamArgeNa cha na charatha?</para>
  <para style="p">
    <verse number="4" style="v"/>paulasyAhamityApallorahamiti vA yadvAkyaM yuShmAkaM kaishchit kaishchit kathyate tasmAd yUyaM shArIrikAchAriNa na bhavatha?</para>
  <para style="p">
    <verse number="5" style="v"/>paulaH kaH? Apallo rvA kaH? tau parichArakamAtrau tayorekaikasmai cha prabhu ryAdR^ik phalamadadAt tadvat tayordvArA yUyaM vishvAsino jAtAH|</para>
  <para style="p">
    <verse number="6" style="v"/>ahaM ropitavAn Apalloshcha niShiktavAn IshvarashchAvarddhayat|</para>
  <para style="p">
    <verse number="7" style="v"/>ato ropayitR^isektArAvasArau varddhayiteshvara eva sAraH|</para>
  <para style="p">
    <verse number="8" style="v"/>ropayitR^isektArau cha samau tayorekaikashcha svashramayogyaM svavetanaM lapsyate|</para>
  <para style="p">
    <verse number="9" style="v"/>AvAmIshvareNa saha karmmakAriNau, Ishvarasya yat kShetram Ishvarasya yA nirmmitiH sA yUyameva|</para>
  <para style="p">
    <verse number="10" style="v"/>Ishvarasya prasAdAt mayA yat padaM labdhaM tasmAt j nAninA gR^ihakAriNeva mayA bhittimUlaM sthApitaM tadupari chAnyena nichIyate| kintu yena yannichIyate tat tena vivichyatAM|</para>
  <para style="p">
    <verse number="11" style="v"/>yato yIshukhrIShTarUpaM yad bhittimUlaM sthApitaM tadanyat kimapi bhittimUlaM sthApayituM kenApi na shakyate|</para>
  <para style="p">
    <verse number="12" style="v"/>etadbhittimUlasyopari yadi kechit svarNarUpyamaNikAShThatR^iNanalAn nichinvanti,</para>
  <para style="p">
    <verse number="13" style="v"/>tarhyekaikasya karmma prakAshiShyate yataH sa divasastat prakAshayiShyati| yato hatostana divasena vahnimayenodetavyaM tata ekaikasya karmma kIdR^ishametasya parIkShA bahninA bhaviShyati|</para>
  <para style="p">
    <verse number="14" style="v"/>yasya nichayanarUpaM karmma sthAsnu bhaviShyati sa vetanaM lapsyate|</para>
  <para style="p">
    <verse number="15" style="v"/>yasya cha karmma dhakShyate tasya kShati rbhaviShyati kintu vahne rnirgatajana iva sa svayaM paritrANaM prApsyati|</para>
  <para style="p">
    <verse number="16" style="v"/>yUyam Ishvarasya mandiraM yuShmanmadhye cheshvarasyAtmA nivasatIti kiM na jAnItha?</para>
  <para style="p">
    <verse number="17" style="v"/>Ishvarasya mandiraM yena vinAshyate so.apIshvareNa vinAshayiShyate yata Ishvarasya mandiraM pavitrameva yUyaM tu tanmandiram Adhve|</para>
  <para style="p">
    <verse number="18" style="v"/>kopi svaM na va nchayatAM| yuShmAkaM kashchana chedihalokasya j nAnena j nAnavAnahamiti budhyate tarhi sa yat j nAnI bhavet tadarthaM mUDho bhavatu|</para>
  <para style="p">
    <verse number="19" style="v"/>yasmAdihalokasya j nAnam Ishvarasya sAkShAt mUDhatvameva| etasmin likhitamapyAste, tIkShNA yA j nAninAM buddhistayA tAn dharatIshvaraH|</para>
  <para style="p">
    <verse number="20" style="v"/>punashcha| j nAninAM kalpanA vetti paramesho nirarthakAH|</para>
  <para style="p">
    <verse number="21" style="v"/>ataeva ko.api manujairAtmAnaM na shlAghatAM yataH sarvvANi yuShmAkameva,</para>
  <para style="p">
    <verse number="22" style="v"/>paula vA Apallo rvA kaiphA vA jagad vA jIvanaM vA maraNaM vA varttamAnaM vA bhaviShyadvA sarvvANyeva yuShmAkaM,</para>
  <para style="p">
    <verse number="23" style="v"/>yUya ncha khrIShTasya, khrIShTashcheshvarasya|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>lokA asmAn khrIShTasya parichArakAn Ishvarasya nigUThavAkyadhanasyAdhyakShAMshcha manyantAM|</para>
  <para style="p">
    <verse number="2" style="v"/>ki ncha dhanAdhyakSheNa vishvasanIyena bhavitavyametadeva lokai ryAchyate|</para>
  <para style="p">
    <verse number="3" style="v"/>ato vichArayadbhi ryuShmAbhiranyaiH kaishchin manujai rvA mama parIkShaNaM mayAtIva laghu manyate .ahamapyAtmAnaM na vichArayAmi|</para>
  <para style="p">
    <verse number="4" style="v"/>mayA kimapyaparAddhamityahaM na vedmi kintvetena mama niraparAdhatvaM na nishchIyate prabhureva mama vichArayitAsti|</para>
  <para style="p">
    <verse number="5" style="v"/>ata upayuktasamayAt pUrvvam arthataH prabhorAgamanAt pUrvvaM yuShmAbhi rvichAro na kriyatAM| prabhurAgatya timireNa prachChannAni sarvvANi dIpayiShyati manasAM mantraNAshcha prakAshayiShyati tasmin samaya IshvarAd ekaikasya prashaMsA bhaviShyati|</para>
  <para style="p">
    <verse number="6" style="v"/>he bhrAtaraH sarvvANyetAni mayAtmAnam Apallava nchoddishya kathitAni tasyaitat kAraNaM yuyaM yathA shAstrIyavidhimatikramya mAnavam atIva nAdariShyadhba Ittha nchaikena vaiparItyAd apareNa na shlAghiShyadhba etAdR^ishIM shikShAmAvayordR^iShTAntAt lapsyadhve|</para>
  <para style="p">
    <verse number="7" style="v"/>aparAt kastvAM visheShayati? tubhyaM yanna datta tAdR^ishaM kiM dhArayasi? adatteneva dattena vastunA kutaH shlAghase?</para>
  <para style="p">
    <verse number="8" style="v"/>idAnImeva yUyaM kiM tR^iptA labdhadhanA vA? asmAsvavidyamAneShu yUyaM kiM rAjatvapadaM prAptAH? yuShmAkaM rAjatvaM mayAbhilaShitaM yatastena yuShmAbhiH saha vayamapi rAjyAMshino bhaviShyAmaH|</para>
  <para style="p">
    <verse number="9" style="v"/>preritA vayaM sheShA hantavyAshcheveshvareNa nidarshitAH| yato vayaM sarvvalokAnAm arthataH svargIyadUtAnAM mAnavAnA ncha kautukAspadAni jAtAH|</para>
  <para style="p">
    <verse number="10" style="v"/>khrIShTasya kR^ite vayaM mUDhAH kintu yUyaM khrIShTena j nAninaH, vayaM durbbalA yUya ncha sabalAH, yUyaM sammAnitA vaya nchApamAnitAH|</para>
  <para style="p">
    <verse number="11" style="v"/>vayamadyApi kShudhArttAstR^iShNArttA vastrahInAstADitA AshramarahitAshcha santaH</para>
  <para style="p">
    <verse number="12" style="v"/>karmmaNi svakarAn vyApArayantashcha duHkhaiH kAlaM yApayAmaH| garhitairasmAbhirAshIH kathyate dUrIkR^itaiH sahyate ninditaiH prasAdyate|</para>
  <para style="p">
    <verse number="13" style="v"/>vayamadyApi jagataH sammArjanIyogyA avakarA iva sarvvai rmanyAmahe|</para>
  <para style="p">
    <verse number="14" style="v"/>yuShmAn trapayitumahametAni likhAmIti nahi kintu priyAtmajAniva yuShmAn prabodhayAmi|</para>
  <para style="p">
    <verse number="15" style="v"/>yataH khrIShTadharmme yadyapi yuShmAkaM dashasahasrANi vinetAro bhavanti tathApi bahavo janakA na bhavanti yato.ahameva susaMvAdena yIshukhrIShTe yuShmAn ajanayaM|</para>
  <para style="p">
    <verse number="16" style="v"/>ato yuShmAn vinaye.ahaM yUyaM madanugAmino bhavata|</para>
  <para style="p">
    <verse number="17" style="v"/>ityarthaM sarvveShu dharmmasamAjeShu sarvvatra khrIShTadharmmayogyA ye vidhayo mayopadishyante tAn yo yuShmAn smArayiShyatyevambhUtaM prabhoH kR^ite priyaM vishvAsina ncha madIyatanayaM tImathiyaM yuShmAkaM samIpaM preShitavAnahaM|</para>
  <para style="p">
    <verse number="18" style="v"/>aparamahaM yuShmAkaM samIpaM na gamiShyAmIti buddhvA yuShmAkaM kiyanto lokA garvvanti|</para>
  <para style="p">
    <verse number="19" style="v"/>kintu yadi prabherichChA bhavati tarhyahamavilambaM yuShmatsamIpamupasthAya teShAM darpadhmAtAnAM lokAnAM vAchaM j nAsyAmIti nahi sAmarthyameva j nAsyAmi|</para>
  <para style="p">
    <verse number="20" style="v"/>yasmAdIshvarasya rAjatvaM vAgyuktaM nahi kintu sAmarthyayuktaM|</para>
  <para style="p">
    <verse number="21" style="v"/>yuShmAkaM kA vA nChA? yuShmatsamIpe mayA kiM daNDapANinA gantavyamuta premanamratAtmayuktena vA?</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparaM yuShmAkaM madhye vyabhichAro vidyate sa cha vyabhichArastAdR^isho yad devapUjakAnAM madhye.api tattulyo na vidyate phalato yuShmAkameko jano vimAtR^igamanaM kR^iruta iti vArttA sarvvatra vyAptA|</para>
  <para style="p">
    <verse number="2" style="v"/>tathAcha yUyaM darpadhmAtA Adhbe, tat karmma yena kR^itaM sa yathA yuShmanmadhyAd dUrIkriyate tathA shoko yuShmAbhi rna kriyate kim etat?</para>
  <para style="p">
    <verse number="3" style="v"/>avidyamAne madIyasharIre mamAtmA yuShmanmadhye vidyate ato.ahaM vidyamAna iva tatkarmmakAriNo vichAraM nishchitavAn,</para>
  <para style="p">
    <verse number="4" style="v"/>asmatprabho ryIshukhrIShTasya nAmnA yuShmAkaM madIyAtmanashcha milane jAte .asmatprabho ryIshukhrIShTasya shakteH sAhAyyena</para>
  <para style="p">
    <verse number="5" style="v"/>sa naraH sharIranAshArthamasmAbhiH shayatAno haste samarpayitavyastato.asmAkaM prabho ryIsho rdivase tasyAtmA rakShAM gantuM shakShyati|</para>
  <para style="p">
    <verse number="6" style="v"/>yuShmAkaM darpo na bhadrAya yUyaM kimetanna jAnItha, yathA, vikAraH kR^itsnashaktUnAM svalpakiNvena jAyate|</para>
  <para style="p">
    <verse number="7" style="v"/>yUyaM yat navInashaktusvarUpA bhaveta tadarthaM purAtanaM kiNvam avamArjjata yato yuShmAbhiH kiNvashUnyai rbhavitavyaM| aparam asmAkaM nistArotsavIyameShashAvako yaH khrIShTaH so.asmadarthaM balIkR^ito .abhavat|</para>
  <para style="p">
    <verse number="8" style="v"/>ataH purAtanakiNvenArthato duShTatAjighAMsArUpeNa kiNvena tannahi kintu sAralyasatyatvarUpayA kiNvashUnyatayAsmAbhirutsavaH karttavyaH|</para>
  <para style="p">
    <verse number="9" style="v"/>vyAbhichAriNAM saMsargo yuShmAbhi rvihAtavya iti mayA patre likhitaM|</para>
  <para style="p">
    <verse number="10" style="v"/>kintvaihikalokAnAM madhye ye vyabhichAriNo lobhina upadrAviNo devapUjakA vA teShAM saMsargaH sarvvathA vihAtavya iti nahi, vihAtavye sati yuShmAbhi rjagato nirgantavyameva|</para>
  <para style="p">
    <verse number="11" style="v"/>kintu bhrAtR^itvena vikhyAtaH kashchijjano yadi vyabhichArI lobhI devapUjako nindako madyapa upadrAvI vA bhavet tarhi tAdR^ishena mAnavena saha bhojanapAne.api yuShmAbhi rna karttavye ityadhunA mayA likhitaM|</para>
  <para style="p">
    <verse number="12" style="v"/>samAjabahiHsthitAnAM lokAnAM vichArakaraNe mama ko.adhikAraH? kintu tadantargatAnAM vichAraNaM yuShmAbhiH kiM na karttavyaM bhavet?</para>
  <para style="p">
    <verse number="13" style="v"/>bahiHsthAnAM tu vichAra IshvareNa kAriShyate| ato yuShmAbhiH sa pAtakI svamadhyAd bahiShkriyatAM|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yuShmAkamekasya janasyApareNa saha vivAde jAte sa pavitralokai rvichAramakArayan kim adhArmmikalokai rvichArayituM protsahate?</para>
  <para style="p">
    <verse number="2" style="v"/>jagato.api vichAraNaM pavitralokaiH kAriShyata etad yUyaM kiM na jAnItha? ato jagad yadi yuShmAbhi rvichArayitavyaM tarhi kShudratamavichAreShu yUyaM kimasamarthAH?</para>
  <para style="p">
    <verse number="3" style="v"/>dUtA apyasmAbhi rvichArayiShyanta iti kiM na jAnItha? ata aihikaviShayAH kim asmAbhi rna vichArayitavyA bhaveyuH?</para>
  <para style="p">
    <verse number="4" style="v"/>aihikaviShayasya vichAre yuShmAbhiH karttavye ye lokAH samitau kShudratamAsta eva niyujyantAM|</para>
  <para style="p">
    <verse number="5" style="v"/>ahaM yuShmAn trapayitumichChan vadAmi yR^iShmanmadhye kimeko.api manuShyastAdR^ig buddhimAnnahi yo bhrAtR^ivivAdavichAraNe samarthaH syAt?</para>
  <para style="p">
    <verse number="6" style="v"/>ki nchaiko bhrAtA bhrAtrAnyena kimavishvAsinAM vichArakANAM sAkShAd vivadate? yaShmanmadhye vivAdA vidyanta etadapi yuShmAkaM doShaH|</para>
  <para style="p">
    <verse number="7" style="v"/>yUyaM kuto.anyAyasahanaM kShatisahanaM vA shreyo na manyadhve?</para>
  <para style="p">
    <verse number="8" style="v"/>kintu yUyamapi bhrAtR^ineva pratyanyAyaM kShati ncha kurutha kimetat?</para>
  <para style="p">
    <verse number="9" style="v"/>Ishvarasya rAjye.anyAyakAriNAM lokAnAmadhikAro nAstyetad yUyaM kiM na jAnItha? mA va nchyadhvaM, ye vyabhichAriNo devArchchinaH pAradArikAH strIvadAchAriNaH puMmaithunakAriNastaskarA</para>
  <para style="p">
    <verse number="10" style="v"/>lobhino madyapA nindakA upadrAviNo vA ta Ishvarasya rAjyabhAgino na bhaviShyanti|</para>
  <para style="p">
    <verse number="11" style="v"/>yUya nchaivaMvidhA lokA Asta kintu prabho ryIsho rnAmnAsmadIshvarasyAtmanA cha yUyaM prakShAlitAH pAvitAH sapuNyIkR^itAshcha|</para>
  <para style="p">
    <verse number="12" style="v"/>madarthaM sarvvaM dravyam apratiShiddhaM kintu na sarvvaM hitajanakaM|madarthaM sarvvamapratiShiddhaM tathApyahaM kasyApi dravyasya vashIkR^ito na bhaviShyAmi|</para>
  <para style="p">
    <verse number="13" style="v"/>udarAya bhakShyANi bhakShyebhyashchodaraM, kintu bhakShyodare IshvareNa nAshayiShyete; aparaM deho na vyabhichArAya kintu prabhave prabhushcha dehAya|</para>
  <para style="p">
    <verse number="14" style="v"/>yashcheshvaraH prabhumutthApitavAn sa svashaktyAsmAnapyutthApayiShyati|</para>
  <para style="p">
    <verse number="15" style="v"/>yuShmAkaM yAni sharIrANi tAni khrIShTasyA NgAnIti kiM yUyaM na jAnItha? ataH khrIShTasya yAnya NgAni tAni mayApahR^itya veshyAyA a NgAni kiM kAriShyante? tanna bhavatu|</para>
  <para style="p">
    <verse number="16" style="v"/>yaH kashchid veshyAyAm Asajyate sa tayA sahaikadeho bhavati kiM yUyametanna jAnItha? yato likhitamAste, yathA, tau dvau janAvekA Ngau bhaviShyataH|</para>
  <para style="p">
    <verse number="17" style="v"/>mAnavA yAnyanyAni kaluShANi kurvvate tAni vapu rna samAvishanti kintu vyabhichAriNA svavigrahasya viruddhaM kalmaShaM kriyate|</para>
  <para style="p">
    <verse number="18" style="v"/>mAnavA yAnyanyAni kaluShANi kurvvate tAni vapu rna samAvishanti kintu vyabhichAriNA svavigrahasya viruddhaM kalmaShaM kriyate|</para>
  <para style="p">
    <verse number="19" style="v"/>yuShmAkaM yAni vapUMsi tAni yuShmadantaHsthitasyeshvarAllabdhasya pavitrasyAtmano mandirANi yUya ncha sveShAM svAmino nAdhve kimetad yuShmAbhi rna j nAyate?</para>
  <para style="p">
    <verse number="20" style="v"/>yUyaM mUlyena krItA ato vapurmanobhyAm Ishvaro yuShmAbhiH pUjyatAM yata Ishvara eva tayoH svAmI|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>apara ncha yuShmAbhi rmAM prati yat patramalekhi tasyottarametat, yoShito.asparshanaM manujasya varaM;</para>
  <para style="p">
    <verse number="2" style="v"/>kintu vyabhichArabhayAd ekaikasya puMsaH svakIyabhAryyA bhavatu tadvad ekaikasyA yoShito .api svakIyabharttA bhavatu|</para>
  <para style="p">
    <verse number="3" style="v"/>bhAryyAyai bhartrA yadyad vitaraNIyaM tad vitIryyatAM tadvad bhartre.api bhAryyayA vitaraNIyaM vitIryyatAM|</para>
  <para style="p">
    <verse number="4" style="v"/>bhAryyAyAH svadehe svatvaM nAsti bharttureva, tadvad bhartturapi svadehe svatvaM nAsti bhAryyAyA eva|</para>
  <para style="p">
    <verse number="5" style="v"/>upoShaNaprArthanayoH sevanArtham ekamantraNAnAM yuShmAkaM kiyatkAlaM yAvad yA pR^ithaksthiti rbhavati tadanyo vichChedo yuShmanmadhye na bhavatu, tataH param indriyANAm adhairyyAt shayatAn yad yuShmAn parIkShAM na nayet tadarthaM punarekatra milata|</para>
  <para style="p">
    <verse number="6" style="v"/>etad Adeshato nahi kintvanuj nAta eva mayA kathyate,</para>
  <para style="p">
    <verse number="7" style="v"/>yato mamAvastheva sarvvamAnavAnAmavasthA bhavatviti mama vA nChA kintvIshvarAd ekenaiko varo.anyena chAnyo vara itthamekaikena svakIyavaro labdhaH|</para>
  <para style="p">
    <verse number="8" style="v"/>aparam akR^itavivAhAn vidhavAshcha prati mamaitannivedanaM mameva teShAmavasthiti rbhadrA;</para>
  <para style="p">
    <verse number="9" style="v"/>ki ncha yadi tairindriyANi niyantuM na shakyante tarhi vivAhaH kriyatAM yataH kAmadahanAd vyUDhatvaM bhadraM|</para>
  <para style="p">
    <verse number="10" style="v"/>ye cha kR^itavivAhAste mayA nahi prabhunaivaitad Aj nApyante|</para>
  <para style="p">
    <verse number="11" style="v"/>bhAryyA bharttR^itaH pR^ithak na bhavatu| yadi vA pR^ithagbhUtA syAt tarhi nirvivAhA tiShThatu svIyapatinA vA sandadhAtu bharttApi bhAryyAM na tyajatu|</para>
  <para style="p">
    <verse number="12" style="v"/>itarAn janAn prati prabhu rna bravIti kintvahaM bravImi; kasyachid bhrAturyoShid avishvAsinI satyapi yadi tena sahavAse tuShyati tarhi sA tena na tyajyatAM|</para>
  <para style="p">
    <verse number="13" style="v"/>tadvat kasyAshchid yoShitaH patiravishvAsI sannapi yadi tayA sahavAse tuShyati tarhi sa tayA na tyajyatAM|</para>
  <para style="p">
    <verse number="14" style="v"/>yato.avishvAsI bharttA bhAryyayA pavitrIbhUtaH, tadvadavishvAsinI bhAryyA bhartrA pavitrIbhUtA; noched yuShmAkamapatyAnyashuchInyabhaviShyan kintvadhunA tAni pavitrANi santi|</para>
  <para style="p">
    <verse number="15" style="v"/>avishvAsI jano yadi vA pR^ithag bhavati tarhi pR^ithag bhavatu; etena bhrAtA bhaginI vA na nibadhyate tathApi vayamIshvareNa shAntaye samAhUtAH|</para>
  <para style="p">
    <verse number="16" style="v"/>he nAri tava bharttuH paritrANaM tvatto bhaviShyati na veti tvayA kiM j nAyate? he nara tava jAyAyAH paritrANaM tvatteा bhaviShyati na veti tvayA kiM j nAyate?</para>
  <para style="p">
    <verse number="17" style="v"/>ekaiko janaH parameshvarAllabdhaM yad bhajate yasyA nchAvasthAyAm IshvareNAhvAyi tadanusAreNaivAcharatu tadahaM sarvvasamAjasthAn AdishAmi|</para>
  <para style="p">
    <verse number="18" style="v"/>Chinnatvag bhR^itvA ya AhUtaH sa prakR^iShTatvak na bhavatu, tadvad aChinnatvag bhUtvA ya AhUtaH sa Chinnatvak na bhavatu|</para>
  <para style="p">
    <verse number="19" style="v"/>tvakChedaH sAro nahi tadvadatvakChedo.api sAro nahi kintvIshvarasyAj nAnAM pAlanameva|</para>
  <para style="p">
    <verse number="20" style="v"/>yo jano yasyAmavasthAyAmAhvAyi sa tasyAmevAvatiShThatAM|</para>
  <para style="p">
    <verse number="21" style="v"/>dAsaH san tvaM kimAhUto.asi? tanmA chintaya, tathAcha yadi svatantro bhavituM shaknuyAstarhi tadeva vR^iNu|</para>
  <para style="p">
    <verse number="22" style="v"/>yataH prabhunAhUto yo dAsaH sa prabho rmochitajanaH| tadvad tenAhUtaH svatantro jano.api khrIShTasya dAsa eva|</para>
  <para style="p">
    <verse number="23" style="v"/>yUyaM mUlyena krItA ato heto rmAnavAnAM dAsA mA bhavata|</para>
  <para style="p">
    <verse number="24" style="v"/>he bhrAtaro yasyAmavasthAyAM yasyAhvAnamabhavat tayA sa Ishvarasya sAkShAt tiShThatu|</para>
  <para style="p">
    <verse number="25" style="v"/>aparam akR^itavivAhAn janAn prati prabhoH ko.apyAdesho mayA na labdhaH kintu prabhoranukampayA vishvAsyo bhUto.ahaM yad bhadraM manye tad vadAmi|</para>
  <para style="p">
    <verse number="26" style="v"/>varttamAnAt kleshasamayAt manuShyasyAnUDhatvaM bhadramiti mayA budhyate|</para>
  <para style="p">
    <verse number="27" style="v"/>tvaM kiM yoShiti nibaddho.asi tarhi mochanaM prAptuM mA yatasva| kiM vA yoShito mukto.asi? tarhi jAyAM mA gaveShaya|</para>
  <para style="p">
    <verse number="28" style="v"/>vivAhaM kurvvatA tvayA kimapi nApArAdhyate tadvad vyUhyamAnayA yuvatyApi kimapi nAparAdhyate tathAcha tAdR^ishau dvau janau shArIrikaM kleshaM lapsyete kintu yuShmAn prati mama karuNA vidyate|</para>
  <para style="p">
    <verse number="29" style="v"/>he bhrAtaro.ahamidaM bravImi, itaH paraM samayo.atIva saMkShiptaH,</para>
  <para style="p">
    <verse number="30" style="v"/>ataH kR^itadArairakR^itadArairiva rudadbhishchArudadbhiriva sAnandaishcha nirAnandairiva kretR^ibhishchAbhAgibhirivAcharitavyaM</para>
  <para style="p">
    <verse number="31" style="v"/>ye cha saMsAre charanti tai rnAticharitavyaM yata ihaleाkasya kautuko vichalati|</para>
  <para style="p">
    <verse number="32" style="v"/>kintu yUyaM yannishchintA bhaveteti mama vA nChA| akR^itavivAho jano yathA prabhuM paritoShayet tathA prabhuM chintayati,</para>
  <para style="p">
    <verse number="33" style="v"/>kintu kR^itavivAho jano yathA bhAryyAM paritoShayet tathA saMsAraM chintayati|</para>
  <para style="p">
    <verse number="34" style="v"/>tadvad UDhayoShito .anUDhA vishiShyate| yAnUDhA sA yathA kAyamanasoH pavitrA bhavet tathA prabhuM chintayati yA choDhA sA yathA bharttAraM paritoShayet tathA saMsAraM chintayati|</para>
  <para style="p">
    <verse number="35" style="v"/>ahaM yad yuShmAn mR^igabandhinyA parikShipeyaM tadarthaM nahi kintu yUyaM yadaninditA bhUtvA prabhoH sevane.abAdham AsaktA bhaveta tadarthametAni sarvvANi yuShmAkaM hitAya mayA kathyante|</para>
  <para style="p">
    <verse number="36" style="v"/>kasyachit kanyAyAM yauvanaprAptAyAM yadi sa tasyA anUDhatvaM nindanIyaM vivAhashcha sAdhayitavya iti manyate tarhi yathAbhilAShaM karotu, etena kimapi nAparAtsyati vivAhaH kriyatAM|</para>
  <para style="p">
    <verse number="37" style="v"/>kintu duHkhenAkliShTaH kashchit pitA yadi sthiramanogataH svamano.abhilAShasAdhane samarthashcha syAt mama kanyA mayA rakShitavyeti manasi nishchinoti cha tarhi sa bhadraM karmma karoti|</para>
  <para style="p">
    <verse number="38" style="v"/>ato yo vivAhaM karoti sa bhadraM karmma karoti yashcha vivAhaM na karoti sa bhadrataraM karmma karoti|</para>
  <para style="p">
    <verse number="39" style="v"/>yAvatkAlaM pati rjIvati tAvad bhAryyA vyavasthayA nibaddhA tiShThati kintu patyau mahAnidrAM gate sA muktIbhUya yamabhilaShati tena saha tasyA vivAho bhavituM shaknoti, kintvetat kevalaM prabhubhaktAnAM madhye|</para>
  <para style="p">
    <verse number="40" style="v"/>tathAcha sA yadi niShpatikA tiShThati tarhi tasyAH kShemaM bhaviShyatIti mama bhAvaH| aparam IshvarasyAtmA mamApyanta rvidyata iti mayA budhyate|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>devaprasAde sarvveShAm asmAkaM j nAnamAste tadvayaM vidmaH| tathApi j nAnaM garvvaM janayati kintu premato niShThA jAyate|</para>
  <para style="p">
    <verse number="2" style="v"/>ataH kashchana yadi manyate mama j nAnamAsta iti tarhi tena yAdR^ishaM j nAnaM cheShTitavyaM tAdR^ishaM kimapi j nAnamadyApi na labdhaM|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu ya Ishvare prIyate sa IshvareNApi j nAyate|</para>
  <para style="p">
    <verse number="4" style="v"/>devatAbaliprasAdabhakShaNe vayamidaM vidmo yat jaganmadhye ko.api devo na vidyate, ekashcheshvaro dvitIyo nAstIti|</para>
  <para style="p">
    <verse number="5" style="v"/>svarge pR^ithivyAM vA yadyapi keShuchid Ishvara iti nAmAropyate tAdR^ishAshcha bahava IshvarA bahavashcha prabhavo vidyante</para>
  <para style="p">
    <verse number="6" style="v"/>tathApyasmAkamadvitIya IshvaraH sa pitA yasmAt sarvveShAM yadartha nchAsmAkaM sR^iShTi rjAtA, asmAka nchAdvitIyaH prabhuH sa yIshuH khrIShTo yena sarvvavastUnAM yenAsmAkamapi sR^iShTiH kR^itA|</para>
  <para style="p">
    <verse number="7" style="v"/>adhikantu j nAnaM sarvveShAM nAsti yataH kechidadyApi devatAM sammanya devaprasAdamiva tad bhakShyaM bhu njate tena durbbalatayA teShAM svAntAni malImasAni bhavanti|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu bhakShyadravyAd vayam IshvareNa grAhyA bhavAmastannahi yato bhu NktvA vayamutkR^iShTA na bhavAmastadvadabhu NktvApyapakR^iShTA na bhavAmaH|</para>
  <para style="p">
    <verse number="9" style="v"/>ato yuShmAkaM yA kShamatA sA durbbalAnAm unmAthasvarUpA yanna bhavet tadarthaM sAvadhAnA bhavata|</para>
  <para style="p">
    <verse number="10" style="v"/>yato j nAnavishiShTastvaM yadi devAlaye upaviShTaH kenApi dR^ishyase tarhi tasya durbbalasya manasi kiM prasAdabhakShaNa utsAho na janiShyate?</para>
  <para style="p">
    <verse number="11" style="v"/>tathA sati yasya kR^ite khrIShTo mamAra tava sa durbbalo bhrAtA tava j nAnAt kiM na vinaMkShyati?</para>
  <para style="p">
    <verse number="12" style="v"/>ityanena prakAreNa bhrAtR^iNAM viruddham aparAdhyadbhisteShAM durbbalAni manAMsi vyAghAtayadbhishcha yuShmAbhiH khrIShTasya vaiparItyenAparAdhyate|</para>
  <para style="p">
    <verse number="13" style="v"/>ato hetoH pishitAshanaM yadi mama bhrAtu rvighnasvarUpaM bhavet tarhyahaM yat svabhrAtu rvighnajanako na bhaveyaM tadarthaM yAvajjIvanaM pishitaM na bhokShye|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ahaM kim ekaH prerito nAsmi? kimahaM svatantro nAsmi? asmAkaM prabhu ryIshuH khrIShTaH kiM mayA nAdarshi? yUyamapi kiM prabhunA madIyashramaphalasvarUpA na bhavatha?</para>
  <para style="p">
    <verse number="2" style="v"/>anyalokAnAM kR^ite yadyapyahaM prerito na bhaveyaM tathAcha yuShmatkR^ite prerito.asmi yataH prabhunA mama preritatvapadasya mudrAsvarUpA yUyamevAdhve|</para>
  <para style="p">
    <verse number="3" style="v"/>ye lokA mayi doShamAropayanti tAn prati mama pratyuttarametat|</para>
  <para style="p">
    <verse number="4" style="v"/>bhojanapAnayoH kimasmAkaM kShamatA nAsti?</para>
  <para style="p">
    <verse number="5" style="v"/>anye preritAH prabho rbhrAtarau kaiphAshcha yat kurvvanti tadvat kA nchit dharmmabhaginIM vyUhya tayA sArddhaM paryyaTituM vayaM kiM na shaknumaH?</para>
  <para style="p">
    <verse number="6" style="v"/>sAMsArikashramasya parityAgAt kiM kevalamahaM barNabbAshcha nivAritau?</para>
  <para style="p">
    <verse number="7" style="v"/>nijadhanavyayena kaH saMgrAmaM karoti? ko vA drAkShAkShetraM kR^itvA tatphalAni na bhu Nkte? ko vA pashuvrajaM pAlayan tatpayo na pivati?</para>
  <para style="p">
    <verse number="8" style="v"/>kimahaM kevalAM mAnuShikAM vAchaM vadAmi? vyavasthAyAM kimetAdR^ishaM vachanaM na vidyate?</para>
  <para style="p">
    <verse number="9" style="v"/>mUsAvyavasthAgranthe likhitamAste, tvaM shasyamarddakavR^iShasyAsyaM na bhaMtsyasIti| IshvareNa balIvarddAnAmeva chintA kiM kriyate?</para>
  <para style="p">
    <verse number="10" style="v"/>kiM vA sarvvathAsmAkaM kR^ite tadvachanaM tenoktaM? asmAkameva kR^ite tallikhitaM| yaH kShetraM karShati tena pratyAshAyuktena karShTavyaM, yashcha shasyAni marddayati tena lAbhapratyAshAyuktena mardditavyaM|</para>
  <para style="p">
    <verse number="11" style="v"/>yuShmatkR^ite.asmAbhiH pAratrikANi bIjAni ropitAni, ato yuShmAkamaihikaphalAnAM vayam aMshino bhaviShyAmaH kimetat mahat karmma?</para>
  <para style="p">
    <verse number="12" style="v"/>yuShmAsu yo.adhikArastasya bhAgino yadyanye bhaveyustarhyasmAbhistato.adhikaM kiM tasya bhAgibhi rna bhavitavyaM? adhikantu vayaM tenAdhikAreNa na vyavahR^itavantaH kintu khrIShTIyasusaMvAdasya ko.api vyAghAto.asmAbhiryanna jAyeta tadarthaM sarvvaM sahAmahe|</para>
  <para style="p">
    <verse number="13" style="v"/>aparaM ye pavitravastUnAM paricharyyAM kurvvanti te pavitravastuto bhakShyANi labhante, ye cha vedyAH paricharyyAM kurvvanti te vedisthavastUnAm aMshino bhavantyetad yUyaM kiM na vida?</para>
  <para style="p">
    <verse number="14" style="v"/>tadvad ye susaMvAdaM ghoShayanti taiH susaMvAdena jIvitavyamiti prabhunAdiShTaM|</para>
  <para style="p">
    <verse number="15" style="v"/>ahameteShAM sarvveShAM kimapi nAshritavAn mAM prati tadanusArAt AcharitavyamityAshayenApi patramidaM mayA na likhyate yataH kenApi janena mama yashaso mudhAkaraNAt mama maraNaM varaM|</para>
  <para style="p">
    <verse number="16" style="v"/>susaMvAdagheShaNAt mama yasho na jAyate yatastadghoShaNaM mamAvashyakaM yadyahaM susaMvAdaM na ghoShayeyaM tarhi mAM dhik|</para>
  <para style="p">
    <verse number="17" style="v"/>ichChukena tat kurvvatA mayA phalaM lapsyate kintvanichChuke.api mayi tatkarmmaNo bhAro.arpito.asti|</para>
  <para style="p">
    <verse number="18" style="v"/>etena mayA labhyaM phalaM kiM? susaMvAdena mama yo.adhikAra Aste taM yadabhadrabhAvena nAchareyaM tadarthaM susaMvAdaghoShaNasamaye tasya khrIShTIyasusaMvAdasya nirvyayIkaraNameva mama phalaM|</para>
  <para style="p">
    <verse number="19" style="v"/>sarvveShAm anAyatto.ahaM yad bhUrisho lokAn pratipadye tadarthaM sarvveShAM dAsatvama NgIkR^itavAn|</para>
  <para style="p">
    <verse number="20" style="v"/>yihUdIyAn yat pratipadye tadarthaM yihUdIyAnAM kR^ite yihUdIya_ivAbhavaM| ye cha vyavasthAyattAstAn yat pratipadye tadarthaM vyavasthAnAyatto yo.ahaM so.ahaM vyavasthAyattAnAM kR^ite vyavasthAyatta_ivAbhavaM|</para>
  <para style="p">
    <verse number="21" style="v"/>ye chAlabdhavyavasthAstAn yat pratipadye tadartham Ishvarasya sAkShAd alabdhavyavastho na bhUtvA khrIShTena labdhavyavastho yo.ahaM so.aham alabdhavyavasthAnAM kR^ite.alabdhavyavastha ivAbhavaM|</para>
  <para style="p">
    <verse number="22" style="v"/>durbbalAn yat pratipadye tadarthamahaM durbbalAnAM kR^ite durbbala_ivAbhavaM| itthaM kenApi prakAreNa katipayA lokA yanmayA paritrANaM prApnuyustadarthaM yo yAdR^isha AsIt tasya kR^ite .ahaM tAdR^isha_ivAbhavaM|</para>
  <para style="p">
    <verse number="23" style="v"/>idR^isha AchAraH susaMvAdArthaM mayA kriyate yato.ahaM tasya phalAnAM sahabhAgI bhavitumichChAmi|</para>
  <para style="p">
    <verse number="24" style="v"/>paNyalAbhArthaM ye dhAvanti dhAvatAM teShAM sarvveShAM kevala ekaH paNyaM labhate yuShmAbhiH kimetanna j nAyate? ato yUyaM yathA paNyaM lapsyadhve tathaiva dhAvata|</para>
  <para style="p">
    <verse number="25" style="v"/>mallA api sarvvabhoge parimitabhogino bhavanti te tu mlAnAM srajaM lipsante kintu vayam amlAnAM lipsAmahe|</para>
  <para style="p">
    <verse number="26" style="v"/>tasmAd ahamapi dhAvAmi kintu lakShyamanuddishya dhAvAmi tannahi| ahaM malla_iva yudhyAmi cha kintu ChAyAmAghAtayanniva yudhyAmi tannahi|</para>
  <para style="p">
    <verse number="27" style="v"/>itarAn prati susaMvAdaM ghoShayitvAhaM yat svayamagrAhyo na bhavAmi tadarthaM deham Ahanmi vashIkurvve cha|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he bhrAtaraH, asmatpitR^ipuruShAnadhi yUyaM yadaj nAtA na tiShThateti mama vA nChA, te sarvve meghAdhaHsthitA babhUvuH sarvve samudramadhyena vavrajuH,</para>
  <para style="p">
    <verse number="2" style="v"/>sarvve mUsAmuddishya meghasamudrayo rmajjitA babhUvuH</para>
  <para style="p">
    <verse number="3" style="v"/>sarvva ekam AtmikaM bhakShyaM bubhujira ekam AtmikaM peyaM papushcha</para>
  <para style="p">
    <verse number="4" style="v"/>yataste.anucharata AtmikAd achalAt labdhaM toyaM papuH so.achalaH khrIShTaeva|</para>
  <para style="p">
    <verse number="5" style="v"/>tathA satyapi teShAM madhye.adhikeShu lokeShvIshvaro na santutoSheti hetoste prantare nipAtitAH|</para>
  <para style="p">
    <verse number="6" style="v"/>etasmin te .asmAkaM nidarshanasvarUpA babhUvuH; ataste yathA kutsitAbhilAShiNo babhUvurasmAbhistathA kutsitAbhilAShibhi rna bhavitavyaM|</para>
  <para style="p">
    <verse number="7" style="v"/>likhitamAste, lokA bhoktuM pAtu nchopavivishustataH krIDitumutthitA itayanena prakAreNa teShAM kaishchid yadvad devapUjA kR^itA yuShmAbhistadvat na kriyatAM|</para>
  <para style="p">
    <verse number="8" style="v"/>aparaM teShAM kaishchid yadvad vyabhichAraH kR^itastena chaikasmin dine trayoviMshatisahasrANi lokA nipAtitAstadvad asmAbhi rvyabhichAro na karttavyaH|</para>
  <para style="p">
    <verse number="9" style="v"/>teShAM kechid yadvat khrIShTaM parIkShitavantastasmAd bhuja Ngai rnaShTAshcha tadvad asmAbhiH khrIShTo na parIkShitavyaH|</para>
  <para style="p">
    <verse number="10" style="v"/>teShAM kechid yathA vAkkalahaM kR^itavantastatkAraNAt hantrA vinAshitAshcha yuShmAbhistadvad vAkkalaho na kriyatAM|</para>
  <para style="p">
    <verse number="11" style="v"/>tAn prati yAnyetAni jaghaTire tAnyasmAkaM nidarshanAni jagataH sheShayuge varttamAnAnAm asmAkaM shikShArthaM likhitAni cha babhUvuH|</para>
  <para style="p">
    <verse number="12" style="v"/>ataeva yaH kashchid susthiraMmanyaH sa yanna patet tatra sAvadhAno bhavatu|</para>
  <para style="p">
    <verse number="13" style="v"/>mAnuShikaparIkShAtiriktA kApi parIkShA yuShmAn nAkrAmat, Ishvarashcha vishvAsyaH so.atishaktyAM parIkShAyAM patanAt yuShmAn rakShiShyati, parIkShA cha yad yuShmAbhiH soDhuM shakyate tadarthaM tayA saha nistArasya panthAnaM nirUpayiShyati|</para>
  <para style="p">
    <verse number="14" style="v"/>he priyabhrAtaraH, devapUjAto dUram apasarata|</para>
  <para style="p">
    <verse number="15" style="v"/>ahaM yuShmAn vij nAn matvA prabhAShe mayA yat kathyate tad yuShmAbhi rvivichyatAM|</para>
  <para style="p">
    <verse number="16" style="v"/>yad dhanyavAdapAtram asmAbhi rdhanyaM gadyate tat kiM khrIShTasya shoNitasya sahabhAgitvaM nahi? yashcha pUpo.asmAbhi rbhajyate sa kiM khrIShTasya vapuShaH sahabhAgitvaM nahi?</para>
  <para style="p">
    <verse number="17" style="v"/>vayaM bahavaH santo.apyekapUpasvarUpA ekavapuHsvarUpAshcha bhavAmaH, yato vayaM sarvva ekapUpasya sahabhAginaH|</para>
  <para style="p">
    <verse number="18" style="v"/>yUyaM shArIrikam isrAyelIyavaMshaM nirIkShadhvaM| ye balInAM mAMsAni bhu njate te kiM yaj navedyAH sahabhAgino na bhavanti?</para>
  <para style="p">
    <verse number="19" style="v"/>ityanena mayA kiM kathyate? devatA vAstavikI devatAyai balidAnaM vA vAstavikaM kiM bhavet?</para>
  <para style="p">
    <verse number="20" style="v"/>tannahi kintu bhinnajAtibhi rye balayo dIyante ta IshvarAya tannahi bhUtebhyaeva dIyante tasmAd yUyaM yad bhUtAnAM sahabhAgino bhavathetyahaM nAbhilaShAmi|</para>
  <para style="p">
    <verse number="21" style="v"/>prabhoH kaMsena bhUtAnAmapi kaMsena pAnaM yuShmAbhirasAdhyaM; yUyaM prabho rbhojyasya bhUtAnAmapi bhojyasya sahabhAgino bhavituM na shaknutha|</para>
  <para style="p">
    <verse number="22" style="v"/>vayaM kiM prabhuM sparddhiShyAmahe? vayaM kiM tasmAd balavantaH?</para>
  <para style="p">
    <verse number="23" style="v"/>mAM prati sarvvaM karmmApratiShiddhaM kintu na sarvvaM hitajanakaM sarvvam apratiShiddhaM kintu na sarvvaM niShThAjanakaM|</para>
  <para style="p">
    <verse number="24" style="v"/>AtmahitaH kenApi na cheShTitavyaH kintu sarvvaiH parahitashcheShTitavyaH|</para>
  <para style="p">
    <verse number="25" style="v"/>ApaNe yat krayyaM tad yuShmAbhiH saMvedasyArthaM kimapi na pR^iShTvA bhujyatAM</para>
  <para style="p">
    <verse number="26" style="v"/>yataH pR^ithivI tanmadhyastha ncha sarvvaM parameshvarasya|</para>
  <para style="p">
    <verse number="27" style="v"/>aparam avishvAsilokAnAM kenachit nimantritA yUyaM yadi tatra jigamiShatha tarhi tena yad yad upasthApyate tad yuShmAbhiH saMvedasyArthaM kimapi na pR^iShTvA bhujyatAM|</para>
  <para style="p">
    <verse number="28" style="v"/>kintu tatra yadi kashchid yuShmAn vadet bhakShyametad devatAyAH prasAda iti tarhi tasya j nApayituranurodhAt saMvedasyArtha ncha tad yuShmAbhi rna bhoktavyaM| pR^ithivI tanmadhyastha ncha sarvvaM parameshvarasya,</para>
  <para style="p">
    <verse number="29" style="v"/>satyametat, kintu mayA yaH saMvedo nirddishyate sa tava nahi parasyaiva|</para>
  <para style="p">
    <verse number="30" style="v"/>anugrahapAtreNa mayA dhanyavAdaM kR^itvA yad bhujyate tatkAraNAd ahaM kuto nindiShye?</para>
  <para style="p">
    <verse number="31" style="v"/>tasmAd bhojanaM pAnam anyadvA karmma kurvvadbhi ryuShmAbhiH sarvvameveshvarasya mahimnaH prakAshArthaM kriyatAM|</para>
  <para style="p">
    <verse number="32" style="v"/>yihUdIyAnAM bhinnajAtIyAnAm Ishvarasya samAjasya vA vighnajanakai ryuShmAbhi rna bhavitavyaM|</para>
  <para style="p">
    <verse number="33" style="v"/>ahamapyAtmahitam acheShTamAno bahUnAM paritrANArthaM teShAM hitaM cheShTamAnaH sarvvaviShaye sarvveShAM tuShTikaro bhavAmItyanenAhaM yadvat khrIShTasyAnugAmI tadvad yUyaM mamAnugAmino bhavata|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he bhrAtaraH, yUyaM sarvvasmin kAryye mAM smaratha mayA cha yAdR^igupadiShTAstAdR^igAcharathaitatkAraNAt mayA prashaMsanIyA Adhbe|</para>
  <para style="p">
    <verse number="2" style="v"/>tathApi mamaiShA vA nChA yad yUyamidam avagatA bhavatha,</para>
  <para style="p">
    <verse number="3" style="v"/>ekaikasya puruShasyottamA NgasvarUpaH khrIShTaH, yoShitashchottamA NgasvarUpaH pumAn, khrIShTasya chottamA NgasvarUpa IshvaraH|</para>
  <para style="p">
    <verse number="4" style="v"/>aparam AchChAditottamA Ngena yena puMsA prArthanA kriyata IshvarIyavANI kathyate vA tena svIyottamA Ngam avaj nAyate|</para>
  <para style="p">
    <verse number="5" style="v"/>anAchChAditottamA NgayA yayA yoShitA cha prArthanA kriyata IshvarIyavANI kathyate vA tayApi svIyottamA Ngam avaj nAyate yataH sA muNDitashiraHsadR^ishA|</para>
  <para style="p">
    <verse number="6" style="v"/>anAchChAditamastakA yA yoShit tasyAH shiraH muNDanIyameva kintu yoShitaH keshachChedanaM shiromuNDanaM vA yadi lajjAjanakaM bhavet tarhi tayA svashira AchChAdyatAM|</para>
  <para style="p">
    <verse number="7" style="v"/>pumAn Ishvarasya pratimUrttiH pratitejaHsvarUpashcha tasmAt tena shiro nAchChAdanIyaM kintu sImantinI puMsaH pratibimbasvarUpA|</para>
  <para style="p">
    <verse number="8" style="v"/>yato yoShAtaH pumAn nodapAdi kintu puMso yoShid udapAdi|</para>
  <para style="p">
    <verse number="9" style="v"/>adhikantu yoShitaH kR^ite puMsaH sR^iShTi rna babhUva kintu puMsaH kR^ite yoShitaH sR^iShTi rbabhUva|</para>
  <para style="p">
    <verse number="10" style="v"/>iti heto rdUtAnAm AdarAd yoShitA shirasyadhInatAsUchakam AvaraNaM dharttavyaM|</para>
  <para style="p">
    <verse number="11" style="v"/>tathApi prabho rvidhinA pumAMsaM vinA yoShinna jAyate yoShita ncha vinA pumAn na jAyate|</para>
  <para style="p">
    <verse number="12" style="v"/>yato yathA puMso yoShid udapAdi tathA yoShitaH pumAn jAyate, sarvvavastUni cheshvarAd utpadyante|</para>
  <para style="p">
    <verse number="13" style="v"/>yuShmAbhirevaitad vivichyatAM, anAvR^itayA yoShitA prArthanaM kiM sudR^ishyaM bhavet?</para>
  <para style="p">
    <verse number="14" style="v"/>puruShasya dIrghakeshatvaM tasya lajjAjanakaM, kintu yoShito dIrghakeshatvaM tasyA gauravajanakaM</para>
  <para style="p">
    <verse number="15" style="v"/>yata AchChAdanAya tasyai keshA dattA iti kiM yuShmAbhiH svabhAvato na shikShyate?</para>
  <para style="p">
    <verse number="16" style="v"/>atra yadi kashchid vivaditum ichChet tarhyasmAkam IshvarIyasamitInA ncha tAdR^ishI rIti rna vidyate|</para>
  <para style="p">
    <verse number="17" style="v"/>yuShmAbhi rna bhadrAya kintu kutsitAya samAgamyate tasmAd etAni bhAShamANena mayA yUyaM na prashaMsanIyAH|</para>
  <para style="p">
    <verse number="18" style="v"/>prathamataH samitau samAgatAnAM yuShmAkaM madhye bhedAH santIti vArttA mayA shrUyate tanmadhye ki nchit satyaM manyate cha|</para>
  <para style="p">
    <verse number="19" style="v"/>yato heto ryuShmanmadhye ye parIkShitAste yat prakAshyante tadarthaM bhedai rbhavitavyameva|</para>
  <para style="p">
    <verse number="20" style="v"/>ekatra samAgatai ryuShmAbhiH prabhAvaM bheाjyaM bhujyata iti nahi;</para>
  <para style="p">
    <verse number="21" style="v"/>yato bhojanakAle yuShmAkamekaikena svakIyaM bhakShyaM tUrNaM grasyate tasmAd eko jano bubhukShitastiShThati, anyashcha paritR^ipto bhavati|</para>
  <para style="p">
    <verse number="22" style="v"/>bhojanapAnArthaM yuShmAkaM kiM veshmAni na santi? yuShmAbhi rvA kim Ishvarasya samitiM tuchChIkR^itya dInA lokA avaj nAyante? ityanena mayA kiM vaktavyaM? yUyaM kiM mayA prashaMsanIyAH? etasmin yUyaM na prashaMsanIyAH|</para>
  <para style="p">
    <verse number="23" style="v"/>prabhuto ya upadesho mayA labdho yuShmAsu samarpitashcha sa eShaH|</para>
  <para style="p">
    <verse number="24" style="v"/>parakarasamarpaNakShapAyAM prabhu ryIshuH pUpamAdAyeshvaraM dhanyaM vyAhR^itya taM bha NktvA bhAShitavAn yuShmAbhiretad gR^ihyatAM bhujyatA ncha tad yuShmatkR^ite bhagnaM mama sharIraM; mama smaraNArthaM yuShmAbhiretat kriyatAM|</para>
  <para style="p">
    <verse number="25" style="v"/>punashcha bhejanAt paraM tathaiva kaMsam AdAya tenoktaM kaMso.ayaM mama shoNitena sthApito nUtananiyamaH; yativAraM yuShmAbhiretat pIyate tativAraM mama smaraNArthaM pIyatAM|</para>
  <para style="p">
    <verse number="26" style="v"/>yativAraM yuShmAbhireSha pUpo bhujyate bhAjanenAnena pIyate cha tativAraM prabhorAgamanaM yAvat tasya mR^ityuH prakAshyate|</para>
  <para style="p">
    <verse number="27" style="v"/>apara ncha yaH kashchid ayogyatvena prabhorimaM pUpam ashnAti tasyAnena bhAjanena pivati cha sa prabhoH kAyarudhirayo rdaNDadAyI bhaviShyati|</para>
  <para style="p">
    <verse number="28" style="v"/>tasmAt mAnavenAgra AtmAna parIkShya pashchAd eSha pUpo bhujyatAM kaMsenAnena cha pIyatAM|</para>
  <para style="p">
    <verse number="29" style="v"/>yena chAnarhatvena bhujyate pIyate cha prabhoH kAyam avimR^ishatA tena daNDaprAptaye bhujyate pIyate cha|</para>
  <para style="p">
    <verse number="30" style="v"/>etatkAraNAd yuShmAkaM bhUrisho lokA durbbalA rogiNashcha santi bahavashcha mahAnidrAM gatAH|</para>
  <para style="p">
    <verse number="31" style="v"/>asmAbhi ryadyAtmavichAro.akAriShyata tarhi daNDo nAlapsyata;</para>
  <para style="p">
    <verse number="32" style="v"/>kintu yadAsmAkaM vichAro bhavati tadA vayaM jagato janaiH samaM yad daNDaM na labhAmahe tadarthaM prabhunA shAstiM bhuMjmahe|</para>
  <para style="p">
    <verse number="33" style="v"/>he mama bhrAtaraH, bhojanArthaM militAnAM yuShmAkam ekenetaro.anugR^ihyatAM|</para>
  <para style="p">
    <verse number="34" style="v"/>yashcha bubhukShitaH sa svagR^ihe bhu NktAM| daNDaprAptaye yuShmAbhi rna samAgamyatAM| etadbhinnaM yad AdeShTavyaM tad yuShmatsamIpAgamanakAle mayAdekShyate|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he bhrAtaraH, yUyaM yad AtmikAn dAyAn anavagatAstiShThatha tadahaM nAbhilaShAmi|</para>
  <para style="p">
    <verse number="2" style="v"/>pUrvvaM bhinnajAtIyA yUyaM yadvad vinItAstadvad avAkpratimAnAm anugAmina Adhbam iti jAnItha|</para>
  <para style="p">
    <verse number="3" style="v"/>iti hetorahaM yuShmabhyaM nivedayAmi, IshvarasyAtmanA bhAShamANaH ko.api yIshuM shapta iti na vyAharati, punashcha pavitreNAtmanA vinItaM vinAnyaH ko.api yIshuM prabhuriti vyAharttuM na shaknoti|</para>
  <para style="p">
    <verse number="4" style="v"/>dAyA bahuvidhAH kintveka AtmA</para>
  <para style="p">
    <verse number="5" style="v"/>paricharyyAshcha bahuvidhAH kintvekaH prabhuH|</para>
  <para style="p">
    <verse number="6" style="v"/>sAdhanAni bahuvidhAni kintu sarvveShu sarvvasAdhaka Ishvara ekaH|</para>
  <para style="p">
    <verse number="7" style="v"/>ekaikasmai tasyAtmano darshanaM parahitArthaM dIyate|</para>
  <para style="p">
    <verse number="8" style="v"/>ekasmai tenAtmanA j nAnavAkyaM dIyate, anyasmai tenaivAtmanAdiShTaM vidyAvAkyam,</para>
  <para style="p">
    <verse number="9" style="v"/>anyasmai tenaivAtmanA vishvAsaH, anyasmai tenaivAtmanA svAsthyadAnashaktiH,</para>
  <para style="p">
    <verse number="10" style="v"/>anyasmai duHsAdhyasAdhanashaktiranyasmai cheshvarIyAdeshaH, anyasmai chAtimAnuShikasyAdeshasya vichArasAmarthyam, anyasmai parabhAShAbhAShaNashaktiranyasmai cha bhAShArthabhAShaNasAmaryaM dIyate|</para>
  <para style="p">
    <verse number="11" style="v"/>ekenAdvitIyenAtmanA yathAbhilASham ekaikasmai janAyaikaikaM dAnaM vitaratA tAni sarvvANi sAdhyante|</para>
  <para style="p">
    <verse number="12" style="v"/>deha ekaH sannapi yadvad bahva Ngayukto bhavati, tasyaikasya vapuSho .a NgAnAM bahutvena yadvad ekaM vapu rbhavati, tadvat khrIShTaH|</para>
  <para style="p">
    <verse number="13" style="v"/>yato heto ryihUdibhinnajAtIyadAsasvatantrA vayaM sarvve majjanenaikenAtmanaikadehIkR^itAH sarvve chaikAtmabhuktA abhavAma|</para>
  <para style="p">
    <verse number="14" style="v"/>ekenA Ngena vapu rna bhavati kintu bahubhiH|</para>
  <para style="p">
    <verse number="15" style="v"/>tatra charaNaM yadi vadet nAhaM hastastasmAt sharIrasya bhAgo nAsmIti tarhyanena sharIrAt tasya viyogo na bhavati|</para>
  <para style="p">
    <verse number="16" style="v"/>shrotraM vA yadi vadet nAhaM nayanaM tasmAt sharIrasyAMsho nAsmIti tarhyanena sharIrAt tasya viyogo na bhavati|</para>
  <para style="p">
    <verse number="17" style="v"/>kR^itsnaM sharIraM yadi darshanendriyaM bhavet tarhi shravaNendriyaM kutra sthAsyati? tat kR^itsnaM yadi vA shravaNendriyaM bhavet tarhi ghraNendriyaM kutra sthAsyati?</para>
  <para style="p">
    <verse number="18" style="v"/>kintvidAnIm IshvareNa yathAbhilaShitaM tathaivA Ngapratya NgAnAm ekaikaM sharIre sthApitaM|</para>
  <para style="p">
    <verse number="19" style="v"/>tat kR^itsnaM yadyekA NgarUpi bhavet tarhi sharIre kutra sthAsyati?</para>
  <para style="p">
    <verse number="20" style="v"/>tasmAd a NgAni bahUni santi sharIraM tvekameva|</para>
  <para style="p">
    <verse number="21" style="v"/>ataeva tvayA mama prayojanaM nAstIti vAchaM pANiM vadituM nayanaM na shaknoti, tathA yuvAbhyAM mama prayojanaM nAstIti mUrddhA charaNau vadituM na shaknotiH;</para>
  <para style="p">
    <verse number="22" style="v"/>vastutastu vigrahasya yAnya NgAnyasmAbhi rdurbbalAni budhyante tAnyeva saprayojanAni santi|</para>
  <para style="p">
    <verse number="23" style="v"/>yAni cha sharIramadhye.avamanyAni budhyate tAnyasmAbhiradhikaM shobhyante| yAni cha kudR^ishyAni tAni sudR^ishyatarANi kriyante</para>
  <para style="p">
    <verse number="24" style="v"/>kintu yAni svayaM sudR^ishyAni teShAM shobhanam niShprayojanaM|</para>
  <para style="p">
    <verse number="25" style="v"/>sharIramadhye yad bhedo na bhavet kintu sarvvANya NgAni yad aikyabhAvena sarvveShAM hitaM chintayanti tadartham IshvareNApradhAnam AdaraNIyaM kR^itvA sharIraM virachitaM|</para>
  <para style="p">
    <verse number="26" style="v"/>tasmAd ekasyA Ngasya pIDAyAM jAtAyAM sarvvANya NgAni tena saha pIDyante, ekasya samAdare jAte cha sarvvANi tena saha saMhR^iShyanti|</para>
  <para style="p">
    <verse number="27" style="v"/>yUya ncha khrIShTasya sharIraM, yuShmAkam ekaikashcha tasyaikaikam a NgaM|</para>
  <para style="p">
    <verse number="28" style="v"/>kechit kechit samitAvIshvareNa prathamataH preritA dvitIyata IshvarIyAdeshavaktArastR^itIyata upadeShTAro niyuktAH, tataH paraM kebhyo.api chitrakAryyasAdhanasAmarthyam anAmayakaraNashaktirupakR^itau lokashAsane vA naipuNyaM nAnAbhAShAbhAShaNasAmarthyaM vA tena vyatAri|</para>
  <para style="p">
    <verse number="29" style="v"/>sarvve kiM preritAH? sarvve kim IshvarIyAdeshavaktAraH? sarvve kim upadeShTAraH? sarvve kiM chitrakAryyasAdhakAH?</para>
  <para style="p">
    <verse number="30" style="v"/>sarvve kim anAmayakaraNashaktiyuktAH? sarvve kiM parabhAShAvAdinaH? sarvve vA kiM parabhAShArthaprakAshakAH?</para>
  <para style="p">
    <verse number="31" style="v"/>yUyaM shreShThadAyAn labdhuM yatadhvaM| anena yUyaM mayA sarvvottamamArgaM darshayitavyAH|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>martyasvargIyANAM bhAShA bhAShamANo.ahaM yadi premahIno bhaveyaM tarhi vAdakatAlasvarUpo ninAdakAribherIsvarUpashcha bhavAmi|</para>
  <para style="p">
    <verse number="2" style="v"/>apara ncha yadyaham IshvarIyAdeshADhyaH syAM sarvvANi guptavAkyAni sarvvavidyA ncha jAnIyAM pUrNavishvAsaH san shailAn sthAnAntarIkarttuM shaknuyA ncha kintu yadi premahIno bhaveyaM tarhyagaNanIya eva bhavAmi|</para>
  <para style="p">
    <verse number="3" style="v"/>aparaM yadyaham annadAnena sarvvasvaM tyajeyaM dAhanAya svasharIraM samarpayeya ncha kintu yadi premahIno bhaveyaM tarhi tatsarvvaM madarthaM niShphalaM bhavati|</para>
  <para style="p">
    <verse number="4" style="v"/>prema chirasahiShNu hitaiShi cha, prema nirdveSham ashaThaM nirgarvva ncha|</para>
  <para style="p">
    <verse number="5" style="v"/>aparaM tat kutsitaM nAcharati, AtmacheShTAM na kurute sahasA na krudhyati parAniShTaM na chintayati,</para>
  <para style="p">
    <verse number="6" style="v"/>adharmme na tuShyati satya eva santuShyati|</para>
  <para style="p">
    <verse number="7" style="v"/>tat sarvvaM titikShate sarvvatra vishvasiti sarvvatra bhadraM pratIkShate sarvvaM sahate cha|</para>
  <para style="p">
    <verse number="8" style="v"/>premno lopaH kadApi na bhaviShyati, IshvarIyAdeshakathanaM lopsyate parabhAShAbhAShaNaM nivarttiShyate j nAnamapi lopaM yAsyati|</para>
  <para style="p">
    <verse number="9" style="v"/>yato.asmAkaM j nAnaM khaNDamAtram IshvarIyAdeshakathanamapi khaNDamAtraM|</para>
  <para style="p">
    <verse number="10" style="v"/>kintvasmAsu siddhatAM gateShu tAni khaNDamAtrANi lopaM yAsyante|</para>
  <para style="p">
    <verse number="11" style="v"/>bAlyakAle.ahaM bAla ivAbhAShe bAla ivAchintaya ncha kintu yauvane jAte tatsarvvaM bAlyAcharaNaM parityaktavAn|</para>
  <para style="p">
    <verse number="12" style="v"/>idAnIm abhramadhyenAspaShTaM darshanam asmAbhi rlabhyate kintu tadA sAkShAt darshanaM lapsyate| adhunA mama j nAnam alpiShThaM kintu tadAhaM yathAvagamyastathaivAvagato bhaviShyAmi|</para>
  <para style="p">
    <verse number="13" style="v"/>idAnIM pratyayaH pratyAshA prema cha trINyetAni tiShThanti teShAM madhye cha prema shreShThaM|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yUyaM premAcharaNe prayatadhvam AtmikAn dAyAnapi visheShata IshvarIyAdeshakathanasAmarthyaM prAptuM cheShTadhvaM|</para>
  <para style="p">
    <verse number="2" style="v"/>yo janaH parabhAShAM bhAShate sa mAnuShAn na sambhAShate kintvIshvarameva yataH kenApi kimapi na budhyate sa chAtmanA nigUDhavAkyAni kathayati;</para>
  <para style="p">
    <verse number="3" style="v"/>kintu yo jana IshvarIyAdeshaM kathayati sa pareShAM niShThAyai hitopadeshAya sAntvanAyai cha bhAShate|</para>
  <para style="p">
    <verse number="4" style="v"/>parabhAShAvAdyAtmana eva niShThAM janayati kintvIshvarIyAdeshavAdI samite rniShThAM janayati|</para>
  <para style="p">
    <verse number="5" style="v"/>yuShmAkaM sarvveShAM parabhAShAbhAShaNam ichChAmyahaM kintvIshvarIyAdeshakathanam adhikamapIchChAmi| yataH samite rniShThAyai yena svavAkyAnAm artho na kriyate tasmAt parabhAShAvAdita IshvarIyAdeshavAdI shreyAn|</para>
  <para style="p">
    <verse number="6" style="v"/>he bhrAtaraH, idAnIM mayA yadi yuShmatsamIpaM gamyate tarhIshvarIyadarshanasya j nAnasya veshvarIyAdeshasya vA shikShAyA vA vAkyAni na bhAShitvA parabhAShAM bhAShamANena mayA yUyaM kimupakAriShyadhve?</para>
  <para style="p">
    <verse number="7" style="v"/>aparaM vaMshIvallakyAdiShu niShprANiShu vAdyayantreShu vAditeShu yadi kkaNA na vishiShyante tarhi kiM vAdyaM kiM vA gAnaM bhavati tat kena boddhuM shakyate?</para>
  <para style="p">
    <verse number="8" style="v"/>aparaM raNatUryyA nisvaNo yadyavyakto bhavet tarhi yuddhAya kaH sajjiShyate?</para>
  <para style="p">
    <verse number="9" style="v"/>tadvat jihvAbhi ryadi sugamyA vAk yuShmAbhi rna gadyeta tarhi yad gadyate tat kena bhotsyate? vastuto yUyaM digAlApina iva bhaviShyatha|</para>
  <para style="p">
    <verse number="10" style="v"/>jagati katiprakArA uktayo vidyante? tAsAmekApi nirarthikA nahi;</para>
  <para style="p">
    <verse number="11" style="v"/>kintUkterartho yadi mayA na budhyate tarhyahaM vaktrA mlechCha iva maMsye vaktApi mayA mlechCha iva maMsyate|</para>
  <para style="p">
    <verse number="12" style="v"/>tasmAd AtmikadAyalipsavo yUyaM samite rniShThArthaM prAptabahuvarA bhavituM yatadhvaM,</para>
  <para style="p">
    <verse number="13" style="v"/>ataeva parabhAShAvAdI yad arthakaro.api bhavet tat prArthayatAM|</para>
  <para style="p">
    <verse number="14" style="v"/>yadyahaM parabhAShayA prarthanAM kuryyAM tarhi madIya AtmA prArthayate, kintu mama buddhi rniShphalA tiShThati|</para>
  <para style="p">
    <verse number="15" style="v"/>ityanena kiM karaNIyaM? aham AtmanA prArthayiShye buddhyApi prArthayiShye; aparaM AtmanA gAsyAmi buddhyApi gAsyAmi|</para>
  <para style="p">
    <verse number="16" style="v"/>tvaM yadAtmanA dhanyavAdaM karoShi tadA yad vadasi tad yadi shiShyenevopasthitena janena na buddhyate tarhi tava dhanyavAdasyAnte tathAstviti tena vaktaM kathaM shakyate?</para>
  <para style="p">
    <verse number="17" style="v"/>tvaM samyag IshvaraM dhanyaM vadasIti satyaM tathApi tatra parasya niShThA na bhavati|</para>
  <para style="p">
    <verse number="18" style="v"/>yuShmAkaM sarvvebhyo.ahaM parabhAShAbhAShaNe samartho.asmIti kAraNAd IshvaraM dhanyaM vadAmi;</para>
  <para style="p">
    <verse number="19" style="v"/>tathApi samitau paropadeshArthaM mayA kathitAni pa ncha vAkyAni varaM na cha lakShaM parabhAShIyAni vAkyAni|</para>
  <para style="p">
    <verse number="20" style="v"/>he bhrAtaraH,yUyaM buddhyA bAlakAiva mA bhUta parantu duShTatayA shishava_iva bhUtvA buddhyA siddhA bhavata|</para>
  <para style="p">
    <verse number="21" style="v"/>shAstra idaM likhitamAste, yathA, ityavochat paresho.aham AbhAShiShya imAn janAn| bhAShAbhiH parakIyAbhi rvaktraishcha paradeshibhiH| tathA mayA kR^ite.apIme na grahIShyanti madvachaH||</para>
  <para style="p">
    <verse number="22" style="v"/>ataeva tat parabhAShAbhAShaNaM avishchAsinaH prati chihnarUpaM bhavati na cha vishvAsinaH prati; kintvIshvarIyAdeshakathanaM nAvishvAsinaH prati tad vishvAsinaH pratyeva|</para>
  <para style="p">
    <verse number="23" style="v"/>samitibhukteShu sarvveShu ekasmin sthAne militvA parabhAShAM bhAShamANeShu yadi j nAnAkA NkShiNo.avishvAsino vA tatrAgachCheyustarhi yuShmAn unmattAn kiM na vadiShyanti?</para>
  <para style="p">
    <verse number="24" style="v"/>kintu sarvveShvIshvarIyAdeshaM prakAshayatsu yadyavishvAsI j nAnAkA NkShI vA kashchit tatrAgachChati tarhi sarvvaireva tasya pApaj nAnaM parIkShA cha jAyate,</para>
  <para style="p">
    <verse number="25" style="v"/>tatastasyAntaHkaraNasya guptakalpanAsu vyaktIbhUtAsu so.adhomukhaH patan IshvaramArAdhya yuShmanmadhya Ishvaro vidyate iti satyaM kathAmetAM kathayiShyati|</para>
  <para style="p">
    <verse number="26" style="v"/>he bhrAtaraH, sammilitAnAM yuShmAkam ekena gItam anyenopadesho.anyena parabhAShAnyena aishvarikadarshanam anyenArthabodhakaM vAkyaM labhyate kimetat? sarvvameva paraniShThArthaM yuShmAbhiH kriyatAM|</para>
  <para style="p">
    <verse number="27" style="v"/>yadi kashchid bhAShAntaraM vivakShati tarhyekasmin dine dvijanena trijanena vA parabhAाShA kathyatAM tadadhikairna kathyatAM tairapi paryyAyAnusArAt kathyatAM, ekena cha tadartho bodhyatAM|</para>
  <para style="p">
    <verse number="28" style="v"/>kintvarthAbhidhAyakaH ko.api yadi na vidyate tarhi sa samitau vAchaMyamaH sthitveshvarAyAtmane cha kathAM kathayatu|</para>
  <para style="p">
    <verse number="29" style="v"/>aparaM dvau trayo veshvarIyAdeshavaktAraH svaM svamAdeshaM kathayantu tadanye cha taM vichArayantu|</para>
  <para style="p">
    <verse number="30" style="v"/>kintu tatrApareNa kenachit janeneshvarIyAdeshe labdhe prathamena kathanAt nivarttitavyaM|</para>
  <para style="p">
    <verse number="31" style="v"/>sarvve yat shikShAM sAntvanA ncha labhante tadarthaM yUyaM sarvve paryyAyeNeshvarIyAdeshaM kathayituM shaknutha|</para>
  <para style="p">
    <verse number="32" style="v"/>IshvarIyAdeshavaktR^iNAM manAMsi teShAm adhInAni bhavanti|</para>
  <para style="p">
    <verse number="33" style="v"/>yata IshvaraH kushAsanajanako nahi sushAsanajanaka eveti pavitralokAnAM sarvvasamitiShu prakAshate|</para>
  <para style="p">
    <verse number="34" style="v"/>apara ncha yuShmAkaM vanitAH samitiShu tUShNImbhUtAstiShThantu yataH shAstralikhitena vidhinA tAH kathAprachAraNAt nivAritAstAbhi rnighrAbhi rbhavitavyaM|</para>
  <para style="p">
    <verse number="35" style="v"/>atastA yadi kimapi jij nAsante tarhi geheShu patIn pR^ichChantu yataH samitimadhye yoShitAM kathAkathanaM nindanIyaM|</para>
  <para style="p">
    <verse number="36" style="v"/>aishvaraM vachaH kiM yuShmatto niragamata? kevalaM yuShmAn vA tat kim upAgataM?</para>
  <para style="p">
    <verse number="37" style="v"/>yaH kashchid AtmAnam IshvarIyAdeshavaktAram AtmanAviShTaM vA manyate sa yuShmAn prati mayA yad yat likhyate tatprabhunAj nApitam ItyurarI karotu|</para>
  <para style="p">
    <verse number="38" style="v"/>kintu yaH kashchit aj no bhavati so.aj na eva tiShThatu|</para>
  <para style="p">
    <verse number="39" style="v"/>ataeva he bhrAtaraH, yUyam IshvarIyAdeshakathanasAmarthyaM labdhuM yatadhvaM parabhAShAbhAShaNamapi yuShmAbhi rna nivAryyatAM|</para>
  <para style="p">
    <verse number="40" style="v"/>sarvvakarmmANi cha vidhyanusArataH suparipATyA kriyantAM|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he bhrAtaraH, yaH susaMvAdo mayA yuShmatsamIpe nivedito yUya ncha yaM gR^ihItavanta Ashritavantashcha taM puna ryuShmAn vij nApayAmi|</para>
  <para style="p">
    <verse number="2" style="v"/>yuShmAkaM vishvAso yadi vitatho na bhavet tarhi susaMvAdayuktAni mama vAkyAni smaratAM yuShmAkaM tena susaMvAdena paritrANaM jAyate|</para>
  <para style="p">
    <verse number="3" style="v"/>yato.ahaM yad yat j nApitastadanusArAt yuShmAsu mukhyAM yAM shikShAM samArpayaM seyaM, shAstrAnusArAt khrIShTo.asmAkaM pApamochanArthaM prANAn tyaktavAn,</para>
  <para style="p">
    <verse number="4" style="v"/>shmashAne sthApitashcha tR^itIyadine shAstrAnusArAt punarutthApitaH|</para>
  <para style="p">
    <verse number="5" style="v"/>sa chAgre kaiphai tataH paraM dvAdashashiShyebhyo darshanaM dattavAn|</para>
  <para style="p">
    <verse number="6" style="v"/>tataH paraM pa nchashatAdhikasaMkhyakebhyo bhrAtR^ibhyo yugapad darshanaM dattavAn teShAM kechit mahAnidrAM gatA bahutarAshchAdyApi varttante|</para>
  <para style="p">
    <verse number="7" style="v"/>tadanantaraM yAkUbAya tatpashchAt sarvvebhyaH preritebhyo darshanaM dattavAn|</para>
  <para style="p">
    <verse number="8" style="v"/>sarvvasheShe.akAlajAtatulyo yo.ahaM, so.ahamapi tasya darshanaM prAptavAn|</para>
  <para style="p">
    <verse number="9" style="v"/>Ishvarasya samitiM prati daurAtmyAcharaNAd ahaM preritanAma dharttum ayogyastasmAt preritAnAM madhye kShudratamashchAsmi|</para>
  <para style="p">
    <verse number="10" style="v"/>yAdR^isho.asmi tAdR^isha IshvarasyAnugraheNaivAsmi; aparaM mAM prati tasyAnugraho niShphalo nAbhavat, anyebhyaH sarvvebhyo mayAdhikaH shramaH kR^itaH, kintu sa mayA kR^itastannahi matsahakAriNeshvarasyAnugraheNaiva|</para>
  <para style="p">
    <verse number="11" style="v"/>ataeva mayA bhavet tai rvA bhavet asmAbhistAdR^ishI vArttA ghoShyate saiva cha yuShmAbhi rvishvAsena gR^ihItA|</para>
  <para style="p">
    <verse number="12" style="v"/>mR^ityudashAtaH khrIShTa utthApita iti vArttA yadi tamadhi ghoShyate tarhi mR^italokAnAm utthiti rnAstIti vAg yuShmAkaM madhye kaishchit kutaH kathyate?</para>
  <para style="p">
    <verse number="13" style="v"/>mR^itAnAm utthiti ryadi na bhavet tarhi khrIShTo.api notthApitaH</para>
  <para style="p">
    <verse number="14" style="v"/>khrIShTashcha yadyanutthApitaH syAt tarhyasmAkaM ghoShaNaM vitathaM yuShmAkaM vishvAso.api vitathaH|</para>
  <para style="p">
    <verse number="15" style="v"/>vaya ncheshvarasya mR^iShAsAkShiNo bhavAmaH, yataH khrIShTa stenotthApitaH iti sAkShyam asmAbhirIshvaramadhi dattaM kintu mR^itAnAmutthiti ryadi na bhavet tarhi sa tena notthApitaH|</para>
  <para style="p">
    <verse number="16" style="v"/>yato mR^itAnAmutthiti ryati na bhavet tarhi khrIShTo.apyutthApitatvaM na gataH|</para>
  <para style="p">
    <verse number="17" style="v"/>khrIShTasya yadyanutthApitaH syAt tarhi yuShmAkaM vishvAso vitathaH, yUyam adyApi svapApeShu magnAstiShThatha|</para>
  <para style="p">
    <verse number="18" style="v"/>aparaM khrIShTAshritA ye mAnavA mahAnidrAM gatAste.api nAshaM gatAH|</para>
  <para style="p">
    <verse number="19" style="v"/>khrIShTo yadi kevalamihaloke .asmAkaM pratyAshAbhUmiH syAt tarhi sarvvamartyebhyo vayameva durbhAgyAH|</para>
  <para style="p">
    <verse number="20" style="v"/>idAnIM khrIShTo mR^ityudashAta utthApito mahAnidrAgatAnAM madhye prathamaphalasvarUpo jAtashcha|</para>
  <para style="p">
    <verse number="21" style="v"/>yato yadvat mAnuShadvArA mR^ityuH prAdurbhUtastadvat mAnuShadvArA mR^itAnAM punarutthitirapi pradurbhUtA|</para>
  <para style="p">
    <verse number="22" style="v"/>AdamA yathA sarvve maraNAdhInA jAtAstathA khrIShTena sarvve jIvayiShyante|</para>
  <para style="p">
    <verse number="23" style="v"/>kintvekaikena janena nije nije paryyAya utthAtavyaM prathamataH prathamajAtaphalasvarUpena khrIShTena, dvitIyatastasyAgamanasamaye khrIShTasya lokaiH|</para>
  <para style="p">
    <verse number="24" style="v"/>tataH param anto bhaviShyati tadAnIM sa sarvvaM shAsanam adhipatitvaM parAkrama ncha luptvA svapitarIshvare rAjatvaM samarpayiShyati|</para>
  <para style="p">
    <verse number="25" style="v"/>yataH khrIShTasya ripavaH sarvve yAvat tena svapAdayoradho na nipAtayiShyante tAvat tenaiva rAjatvaM karttavyaM|</para>
  <para style="p">
    <verse number="26" style="v"/>tena vijetavyo yaH sheSharipuH sa mR^ityureva|</para>
  <para style="p">
    <verse number="27" style="v"/>likhitamAste sarvvANi tasya pAdayo rvashIkR^itAni| kintu sarvvANyeva tasya vashIkR^itAnItyukte sati sarvvANi yena tasya vashIkR^itAni sa svayaM tasya vashIbhUto na jAta iti vyaktaM|</para>
  <para style="p">
    <verse number="28" style="v"/>sarvveShu tasya vashIbhUteShu sarvvANi yena putrasya vashIkR^itAni svayaM putro.api tasya vashIbhUto bhaviShyati tata IshvaraH sarvveShu sarvva eva bhaviShyati|</para>
  <para style="p">
    <verse number="29" style="v"/>aparaM paretalokAnAM vinimayena ye majjyante taiH kiM lapsyate? yeShAM paretalokAnAm utthitiH kenApi prakAreNa na bhaviShyati teShAM vinimayena kuto majjanamapi taira NgIkriyate?</para>
  <para style="p">
    <verse number="30" style="v"/>vayamapi kutaH pratidaNDaM prANabhItim a NgIkurmmahe?</para>
  <para style="p">
    <verse number="31" style="v"/>asmatprabhunA yIshukhrIShTena yuShmatto mama yA shlAghAste tasyAH shapathaM kR^itvA kathayAmi dine dine.ahaM mR^ityuM gachChAmi|</para>
  <para style="p">
    <verse number="32" style="v"/>iphiShanagare vanyapashubhiH sArddhaM yadi laukikabhAvAt mayA yuddhaM kR^itaM tarhi tena mama ko lAbhaH? mR^itAnAm utthiti ryadi na bhavet tarhi, kurmmo bhojanapAne.adya shvastu mR^ityu rbhaviShyati|</para>
  <para style="p">
    <verse number="33" style="v"/>ityanena dharmmAt mA bhraMshadhvaM| kusaMsargeNa lokAnAM sadAchAro vinashyati|</para>
  <para style="p">
    <verse number="34" style="v"/>yUyaM yathochitaM sachaitanyAstiShThata, pApaM mA kurudhvaM, yato yuShmAkaM madhya IshvarIyaj nAnahInAH ke.api vidyante yuShmAkaM trapAyai mayedaM gadyate|</para>
  <para style="p">
    <verse number="35" style="v"/>aparaM mR^italokAH katham utthAsyanti? kIdR^ishaM vA sharIraM labdhvA punareShyantIti vAkyaM kashchit prakShyati|</para>
  <para style="p">
    <verse number="36" style="v"/>he aj na tvayA yad bIjam upyate tad yadi na mriyeta tarhi na jIvayiShyate|</para>
  <para style="p">
    <verse number="37" style="v"/>yayA mUrttyA nirgantavyaM sA tvayA nopyate kintu shuShkaM bIjameva; tachcha godhUmAdInAM kimapi bIjaM bhavituM shaknoti|</para>
  <para style="p">
    <verse number="38" style="v"/>IshvareNeva yathAbhilAShaM tasmai mUrtti rdIyate, ekaikasmai bIjAya svA svA mUrttireva dIyate|</para>
  <para style="p">
    <verse number="39" style="v"/>sarvvANi palalAni naikavidhAni santi, manuShyapashupakShimatsyAdInAM bhinnarUpANi palalAni santi|</para>
  <para style="p">
    <verse number="40" style="v"/>aparaM svargIyA mUrttayaH pArthivA mUrttayashcha vidyante kintu svargIyAnAm ekarUpaM tejaH pArthivAnA ncha tadanyarUpaM tejo.asti|</para>
  <para style="p">
    <verse number="41" style="v"/>sUryyasya teja ekavidhaM chandrasya tejastadanyavidhaM tArANA ncha tejo.anyavidhaM, tArANAM madhye.api tejasastAratamyaM vidyate|</para>
  <para style="p">
    <verse number="42" style="v"/>tatra likhitamAste yathA, ‘AdipuruSha Adam jIvatprANI babhUva,` kintvantima Adam (khrIShTo) jIvanadAyaka AtmA babhUva|</para>
  <para style="p">
    <verse number="43" style="v"/>yad upyate tat tuchChaM yachchotthAsyati tad gauravAnvitaM; yad upyate tannirbbalaM yachchotthAsyati tat shaktiyuktaM|</para>
  <para style="p">
    <verse number="44" style="v"/>yat sharIram upyate tat prANAnAM sadma, yachcha sharIram utthAsyati tad AtmanaH sadma| prANasadmasvarUpaM sharIraM vidyate, AtmasadmasvarUpamapi sharIraM vidyate|</para>
  <para style="p">
    <verse number="45" style="v"/>tatra likhitamAste yathA, AdipuruSha Adam jIvatprANI babhUva, kintvantima Adam (khrIShTo) jIvanadAyaka AtmA babhUva|</para>
  <para style="p">
    <verse number="46" style="v"/>Atmasadma na prathamaM kintu prANasadmaiva tatpashchAd Atmasadma|</para>
  <para style="p">
    <verse number="47" style="v"/>AdyaH puruShe mR^ida utpannatvAt mR^iNmayo dvitIyashcha puruShaH svargAd AgataH prabhuH|</para>
  <para style="p">
    <verse number="48" style="v"/>mR^iNmayo yAdR^isha AsIt mR^iNmayAH sarvve tAdR^ishA bhavanti svargIyashcha yAdR^isho.asti svargIyAH sarvve tAdR^ishA bhavanti|</para>
  <para style="p">
    <verse number="49" style="v"/>mR^iNmayasya rUpaM yadvad asmAbhi rdhAritaM tadvat svargIyasya rUpamapi dhArayiShyate|</para>
  <para style="p">
    <verse number="50" style="v"/>he bhrAtaraH, yuShmAn prati vyAharAmi, Ishvarasya rAjye raktamAMsayoradhikAro bhavituM na shaknoti, akShayatve cha kShayasyAdhikAro na bhaviShyati|</para>
  <para style="p">
    <verse number="51" style="v"/>pashyatAhaM yuShmabhyaM nigUDhAM kathAM nivedayAmi|</para>
  <para style="p">
    <verse number="52" style="v"/>sarvvairasmAbhi rmahAnidrA na gamiShyate kintvantimadine tUryyAM vAditAyAm ekasmin vipale nimiShaikamadhye sarvvai rUpAntaraM gamiShyate, yatastUrI vAdiShyate, mR^italokAshchAkShayIbhUtA utthAsyanti vaya ncha rUpAntaraM gamiShyAmaH|</para>
  <para style="p">
    <verse number="53" style="v"/>yataH kShayaNIyenaitena sharIreNAkShayatvaM parihitavyaM, maraNAdhInenaitena dehena chAmaratvaM parihitavyaM|</para>
  <para style="p">
    <verse number="54" style="v"/>etasmin kShayaNIye sharIre .akShayatvaM gate, etasman maraNAdhIne dehe chAmaratvaM gate shAstre likhitaM vachanamidaM setsyati, yathA, jayena grasyate mR^ityuH|</para>
  <para style="p">
    <verse number="55" style="v"/>mR^ityo te kaNTakaM kutra paraloka jayaH kka te||</para>
  <para style="p">
    <verse number="56" style="v"/>mR^ityoH kaNTakaM pApameva pApasya cha balaM vyavasthA|</para>
  <para style="p">
    <verse number="57" style="v"/>Ishvarashcha dhanyo bhavatu yataH so.asmAkaM prabhunA yIshukhrIShTenAsmAn jayayuktAn vidhApayati|</para>
  <para style="p">
    <verse number="58" style="v"/>ato he mama priyabhrAtaraH; yUyaM susthirA nishchalAshcha bhavata prabhoH sevAyAM yuShmAkaM parishramo niShphalo na bhaviShyatIti j nAtvA prabhoH kAryye sadA tatparA bhavata|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>pavitralokAnAM kR^ite yo.arthasaMgrahastamadhi gAlAtIyadeshasya samAjA mayA yad AdiShTAstad yuShmAbhirapi kriyatAM|</para>
  <para style="p">
    <verse number="2" style="v"/>mamAgamanakAle yad arthasaMgraho na bhavet tannimittaM yuShmAkamekaikena svasampadAnusArAt sa nchayaM kR^itvA saptAhasya prathamadivase svasamIpe ki nchit nikShipyatAM|</para>
  <para style="p">
    <verse number="3" style="v"/>tato mamAgamanasamaye yUyaM yAneva vishvAsyA iti vediShyatha tebhyo.ahaM patrANi dattvA yuShmAkaM taddAnasya yirUshAlamaM nayanArthaM tAn preShayiShyAmi|</para>
  <para style="p">
    <verse number="4" style="v"/>kintu yadi tatra mamApi gamanam uchitaM bhavet tarhi te mayA saha yAsyanti|</para>
  <para style="p">
    <verse number="5" style="v"/>sAmprataM mAkidaniyAdeshamahaM paryyaTAmi taM paryyaTya yuShmatsamIpam AgamiShyAmi|</para>
  <para style="p">
    <verse number="6" style="v"/>anantaraM kiM jAnAmi yuShmatsannidhim avasthAsye shItakAlamapi yApayiShyAmi cha pashchAt mama yat sthAnaM gantavyaM tatraiva yuShmAbhirahaM prerayitavyaH|</para>
  <para style="p">
    <verse number="7" style="v"/>yato.ahaM yAtrAkAle kShaNamAtraM yuShmAn draShTuM nechChAmi kintu prabhu ryadyanujAnIyAt tarhi ki nchid dIrghakAlaM yuShmatsamIpe pravastum ichChAmi|</para>
  <para style="p">
    <verse number="8" style="v"/>tathApi nistArotsavAt paraM pa nchAshattamadinaM yAvad iphiShapuryyAM sthAsyAmi|</para>
  <para style="p">
    <verse number="9" style="v"/>yasmAd atra kAryyasAdhanArthaM mamAntike bR^ihad dvAraM muktaM bahavo vipakShA api vidyante|</para>
  <para style="p">
    <verse number="10" style="v"/>timathi ryadi yuShmAkaM samIpam AgachChet tarhi yena nirbhayaM yuShmanmadhye vartteta tatra yuShmAbhi rmano nidhIyatAM yasmAd ahaM yAdR^ik so.api tAdR^ik prabhoH karmmaNe yatate|</para>
  <para style="p">
    <verse number="11" style="v"/>ko.api taM pratyanAdaraM na karotu kintu sa mamAntikaM yad AgantuM shaknuyAt tadarthaM yuShmAbhiH sakushalaM preShyatAM| bhrAtR^ibhiH sArddhamahaM taM pratIkShe|</para>
  <para style="p">
    <verse number="12" style="v"/>ApalluM bhrAtaramadhyahaM nivedayAmi bhrAtR^ibhiH sAkaM so.api yad yuShmAkaM samIpaM vrajet tadarthaM mayA sa punaH punaryAchitaH kintvidAnIM gamanaM sarvvathA tasmai nArochata, itaHparaM susamayaM prApya sa gamiShyati|</para>
  <para style="p">
    <verse number="13" style="v"/>yUyaM jAgR^ita vishvAse susthirA bhavata pauruShaM prakAshayata balavanto bhavata|</para>
  <para style="p">
    <verse number="14" style="v"/>yuShmAbhiH sarvvANi karmmANi premnA niShpAdyantAM|</para>
  <para style="p">
    <verse number="15" style="v"/>he bhrAtaraH, ahaM yuShmAn idam abhiyAche stiphAnasya parijanA AkhAyAdeshasya prathamajAtaphalasvarUpAH, pavitralokAnAM paricharyyAyai cha ta Atmano nyavedayan iti yuShmAbhi rj nAyate|</para>
  <para style="p">
    <verse number="16" style="v"/>ato yUyamapi tAdR^ishalokAnAm asmatsahAyAnAM shramakAriNA ncha sarvveShAM vashyA bhavata|</para>
  <para style="p">
    <verse number="17" style="v"/>stiphAnaH pharttUnAta AkhAyikashcha yad atrAgaman tenAham AnandAmi yato yuShmAbhiryat nyUnitaM tat taiH sampUritaM|</para>
  <para style="p">
    <verse number="18" style="v"/>tai ryuShmAkaM mama cha manAMsyApyAyitAni| tasmAt tAdR^ishA lokA yuShmAbhiH sammantavyAH|</para>
  <para style="p">
    <verse number="19" style="v"/>yuShmabhyam AshiyAdeshasthasamAjAnAM namaskR^itim AkkilapriskillayostanmaNDapasthasamiteshcha bahunamaskR^itiM prajAnIta|</para>
  <para style="p">
    <verse number="20" style="v"/>sarvve bhrAtaro yuShmAn namaskurvvante| yUyaM pavitrachumbanena mitho namata|</para>
  <para style="p">
    <verse number="21" style="v"/>paulo.ahaM svakaralikhitaM namaskR^itiM yuShmAn vedaye|</para>
  <para style="p">
    <verse number="22" style="v"/>yadi kashchid yIshukhrIShTe na prIyate tarhi sa shApagrasto bhavet prabhurAyAti|</para>
  <para style="p">
    <verse number="23" style="v"/>asmAkaM prabho ryIshukhrIShTasyAnugraho yuShmAn prati bhUyAt|</para>
  <para style="p">
    <verse number="24" style="v"/>khrIShTaM yIshum AshritAn yuShmAn prati mama prema tiShThatu| iti||</para>
</usx>
