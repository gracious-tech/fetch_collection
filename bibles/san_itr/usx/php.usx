  <para style="h">Philippians</para>
  <para style="toc1">philipinaH patraM</para>
  <para style="toc2">philipinaH</para>
  <para style="toc3">philipinaH</para>
  <para style="mt1">philipinaH patraM</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>paulatImathinAmAnau yIshukhrIShTasya dAsau philipinagarasthAn khrIShTayIshoH sarvvAn pavitralokAn samiteradhyakShAn parichArakAMshcha prati patraM likhataH|</para>
  <para style="p">
    <verse number="2" style="v"/>asmAkaM tAta IshvaraH prabhu ryIshukhrIShTashcha yuShmabhyaM prasAdasya shAnteshcha bhogaM deyAstAM|</para>
  <para style="p">
    <verse number="3" style="v"/>ahaM nirantaraM nijasarvvaprArthanAsu yuShmAkaM sarvveShAM kR^ite sAnandaM prArthanAM kurvvan</para>
  <para style="p">
    <verse number="4" style="v"/>yati vArAn yuShmAkaM smarAmi tati vArAn A prathamAd adya yAvad</para>
  <para style="p">
    <verse number="5" style="v"/>yuShmAkaM susaMvAdabhAgitvakAraNAd IshvaraM dhanyaM vadAmi|</para>
  <para style="p">
    <verse number="6" style="v"/>yuShmanmadhye yenottamaM karmma karttum Arambhi tenaiva yIshukhrIShTasya dinaM yAvat tat sAdhayiShyata ityasmin dR^iDhavishvAso mamAste|</para>
  <para style="p">
    <verse number="7" style="v"/>yuShmAn sarvvAn adhi mama tAdR^isho bhAvo yathArtho yato.ahaM kArAvasthAyAM pratyuttarakaraNe susaMvAdasya prAmANyakaraNe cha yuShmAn sarvvAn mayA sArddham ekAnugrahasya bhAgino matvA svahR^idaye dhArayAmi|</para>
  <para style="p">
    <verse number="8" style="v"/>aparam ahaM khrIShTayIshoH snehavat snehena yuShmAn kIdR^ishaM kA NkShAmi tadadhIshvaro mama sAkShI vidyate|</para>
  <para style="p">
    <verse number="9" style="v"/>mayA yat prArthyate tad idaM yuShmAkaM prema nityaM vR^iddhiM gatvA</para>
  <para style="p">
    <verse number="10" style="v"/>j nAnasya vishiShTAnAM parIkShikAyAshcha sarvvavidhabuddhe rbAhulyaM phalatu,</para>
  <para style="p">
    <verse number="11" style="v"/>khrIShTasya dinaM yAvad yuShmAkaM sAralyaM nirvighnatva ncha bhavatu, Ishvarasya gauravAya prashaMsAyai cha yIshunA khrIShTena puNyaphalAnAM pUrNatA yuShmabhyaM dIyatAm iti|</para>
  <para style="p">
    <verse number="12" style="v"/>he bhrAtaraH, mAM prati yad yad ghaTitaM tena susaMvAdaprachArasya bAdhA nahi kintu vR^iddhireva jAtA tad yuShmAn j nApayituM kAmaye.ahaM|</para>
  <para style="p">
    <verse number="13" style="v"/>aparam ahaM khrIShTasya kR^ite baddho.asmIti rAjapuryyAm anyasthAneShu cha sarvveShAM nikaTe suspaShTam abhavat,</para>
  <para style="p">
    <verse number="14" style="v"/>prabhusambandhIyA aneke bhrAtarashcha mama bandhanAd AshvAsaM prApya varddhamAnenotsAhena niHkShobhaM kathAM prachArayanti|</para>
  <para style="p">
    <verse number="15" style="v"/>kechid dveShAd virodhAchchApare kechichcha sadbhAvAt khrIShTaM ghoShayanti;</para>
  <para style="p">
    <verse number="16" style="v"/>ye virodhAt khrIShTaM ghoShayanti te pavitrabhAvAt tanna kurvvanto mama bandhanAni bahutarakloshadAyIni karttum ichChanti|</para>
  <para style="p">
    <verse number="17" style="v"/>ye cha premnA ghoShayanti te susaMvAdasya prAmANyakaraNe.ahaM niyukto.asmIti j nAtvA tat kurvvanti|</para>
  <para style="p">
    <verse number="18" style="v"/>kiM bahunA? kApaTyAt saralabhAvAd vA bhavet, yena kenachit prakAreNa khrIShTasya ghoShaNA bhavatItyasmin aham AnandAmyAnandiShyAmi cha|</para>
  <para style="p">
    <verse number="19" style="v"/>yuShmAkaM prArthanayA yIshukhrIShTasyAtmanashchopakAreNa tat mannistArajanakaM bhaviShyatIti jAnAmi|</para>
  <para style="p">
    <verse number="20" style="v"/>tatra cha mamAkA NkShA pratyAshA cha siddhiM gamiShyati phalato.ahaM kenApi prakAreNa na lajjiShye kintu gate sarvvasmin kAle yadvat tadvad idAnImapi sampUrNotsAhadvArA mama sharIreNa khrIShTasya mahimA jIvane maraNe vA prakAshiShyate|</para>
  <para style="p">
    <verse number="21" style="v"/>yato mama jIvanaM khrIShTAya maraNa ncha lAbhAya|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu yadi sharIre mayA jIvitavyaM tarhi tat karmmaphalaM phaliShyati tasmAt kiM varitavyaM tanmayA na j nAyate|</para>
  <para style="p">
    <verse number="23" style="v"/>dvAbhyAm ahaM sampIDye, dehavAsatyajanAya khrIShTena sahavAsAya cha mamAbhilASho bhavati yatastat sarvvottamaM|</para>
  <para style="p">
    <verse number="24" style="v"/>kintu dehe mamAvasthityA yuShmAkam adhikaprayojanaM|</para>
  <para style="p">
    <verse number="25" style="v"/>aham avasthAsye yuShmAbhiH sarvvaiH sArddham avasthitiM kariShye cha tayA cha vishvAse yuShmAkaM vR^iddhyAnandau janiShyete tadahaM nishchitaM jAnAmi|</para>
  <para style="p">
    <verse number="26" style="v"/>tena cha matto.arthato yuShmatsamIpe mama punarupasthitatvAt yUyaM khrIShTena yIshunA bahutaram AhlAdaM lapsyadhve|</para>
  <para style="p">
    <verse number="27" style="v"/>yUyaM sAvadhAnA bhUtvA khrIShTasya susaMvAdasyopayuktam AchAraM kurudhvaM yato.ahaM yuShmAn upAgatya sAkShAt kurvvan kiM vA dUre tiShThan yuShmAkaM yAM vArttAM shrotum ichChAmi seyaM yUyam ekAtmAnastiShThatha, ekamanasA susaMvAdasambandhIyavishvAsasya pakShe yatadhve, vipakShaishcha kenApi prakAreNa na vyAkulIkriyadhva iti|</para>
  <para style="p">
    <verse number="28" style="v"/>tat teShAM vinAshasya lakShaNaM yuShmAka ncheshvaradattaM paritrANasya lakShaNaM bhaviShyati|</para>
  <para style="p">
    <verse number="29" style="v"/>yato yena yuShmAbhiH khrIShTe kevalavishvAsaH kriyate tannahi kintu tasya kR^ite klesho.api sahyate tAdR^isho varaH khrIShTasyAnurodhAd yuShmAbhiH prApi,</para>
  <para style="p">
    <verse number="30" style="v"/>tasmAt mama yAdR^ishaM yuddhaM yuShmAbhiradarshi sAmprataM shrUyate cha tAdR^ishaM yuddhaM yuShmAkam api bhavati|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>khrIShTAd yadi kimapi sAntvanaM kashchit premajAto harShaH ki nchid AtmanaH samabhAgitvaM kAchid anukampA kR^ipA vA jAyate tarhi yUyaM mamAhlAdaM pUrayanta</para>
  <para style="p">
    <verse number="2" style="v"/>ekabhAvA ekapremANa ekamanasa ekacheShTAshcha bhavata|</para>
  <para style="p">
    <verse number="3" style="v"/>virodhAd darpAd vA kimapi mA kuruta kintu namratayA svebhyo.aparAn vishiShTAn manyadhvaM|</para>
  <para style="p">
    <verse number="4" style="v"/>kevalam AtmahitAya na cheShTamAnAH parahitAyApi cheShTadhvaM|</para>
  <para style="p">
    <verse number="5" style="v"/>khrIShTasya yIsho ryAdR^ishaH svabhAvo yuShmAkam api tAdR^isho bhavatu|</para>
  <para style="p">
    <verse number="6" style="v"/>sa IshvararUpI san svakIyAm IshvaratulyatAM shlAghAspadaM nAmanyata,</para>
  <para style="p">
    <verse number="7" style="v"/>kintu svaM shUnyaM kR^itvA dAsarUpI babhUva narAkR^itiM lebhe cha|</para>
  <para style="p">
    <verse number="8" style="v"/>itthaM naramUrttim Ashritya namratAM svIkR^itya mR^ityorarthataH krushIyamR^ityoreva bhogAyAj nAgrAhI babhUva|</para>
  <para style="p">
    <verse number="9" style="v"/>tatkAraNAd Ishvaro.api taM sarvvonnataM chakAra yachcha nAma sarvveShAM nAmnAM shreShThaM tadeva tasmai dadau,</para>
  <para style="p">
    <verse number="10" style="v"/>tatastasmai yIshunAmne svargamartyapAtAlasthitaiH sarvvai rjAnupAtaH karttavyaH,</para>
  <para style="p">
    <verse number="11" style="v"/>tAtastheshvarasya mahimne cha yIshukhrIShTaH prabhuriti jihvAbhiH svIkarttavyaM|</para>
  <para style="p">
    <verse number="12" style="v"/>ato he priyatamAH, yuShmAbhi ryadvat sarvvadA kriyate tadvat kevale mamopasthitikAle tannahi kintvidAnIm anupasthite.api mayi bahutarayatnenAj nAM gR^ihItvA bhayakampAbhyAM svasvaparitrANaM sAdhyatAM|</para>
  <para style="p">
    <verse number="13" style="v"/>yata Ishvara eva svakIyAnurodhAd yuShmanmadhye manaskAmanAM karmmasiddhi ncha vidadhAti|</para>
  <para style="p">
    <verse number="14" style="v"/>yUyaM kalahavivAdarvijatam AchAraM kurvvanto.anindanIyA akuTilA</para>
  <para style="p">
    <verse number="15" style="v"/>Ishvarasya niShkala NkAshcha santAnAiva vakrabhAvAnAM kuTilAchAriNA ncha lokAnAM madhye tiShThata,</para>
  <para style="p">
    <verse number="16" style="v"/>yatasteShAM madhye yUyaM jIvanavAkyaM dhArayanto jagato dIpakA iva dIpyadhve| yuShmAbhistathA kR^ite mama yatnaH parishramo vA na niShphalo jAta ityahaM khrIShTasya dine shlAghAM karttuM shakShyAmi|</para>
  <para style="p">
    <verse number="17" style="v"/>yuShmAkaM vishvAsArthakAya balidAnAya sevanAya cha yadyapyahaM niveditavyo bhaveyaM tathApi tenAnandAmi sarvveShAM yuShmAkam AnandasyAMshI bhavAmi cha|</para>
  <para style="p">
    <verse number="18" style="v"/>tadvad yUyamapyAnandata madIyAnandasyAMshino bhavata cha|</para>
  <para style="p">
    <verse number="19" style="v"/>yuShmAkam avasthAm avagatyAhamapi yat sAntvanAM prApnuyAM tadarthaM tImathiyaM tvarayA yuShmatsamIpaM preShayiShyAmIti prabhau pratyAshAM kurvve|</para>
  <para style="p">
    <verse number="20" style="v"/>yaH satyarUpeNa yuShmAkaM hitaM chintayati tAdR^isha ekabhAvastasmAdanyaH ko.api mama sannidhau nAsti|</para>
  <para style="p">
    <verse number="21" style="v"/>yato.apare sarvve yIshoH khrIShTasya viShayAn na chintayanta AtmaviShayAn chintayanti|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu tasya parIkShitatvaM yuShmAbhi rj nAyate yataH putro yAdR^ik pituH sahakArI bhavati tathaiva susaMvAdasya paricharyyAyAM sa mama sahakArI jAtaH|</para>
  <para style="p">
    <verse number="23" style="v"/>ataeva mama bhAvidashAM j nAtvA tatkShaNAt tameva preShayituM pratyAshAM kurvve</para>
  <para style="p">
    <verse number="24" style="v"/>svayam ahamapi tUrNaM yuShmatsamIpaM gamiShyAmItyAshAM prabhunA kurvve|</para>
  <para style="p">
    <verse number="25" style="v"/>aparaM ya ipAphradIto mama bhrAtA karmmayuddhAbhyAM mama sahAyashcha yuShmAkaM dUto madIyopakArAya pratinidhishchAsti yuShmatsamIpe tasya preShaNam Avashyakam amanye|</para>
  <para style="p">
    <verse number="26" style="v"/>yataH sa yuShmAn sarvvAn akA NkShata yuShmAbhistasya rogasya vArttAshrAvIti buddhvA paryyashochachcha|</para>
  <para style="p">
    <verse number="27" style="v"/>sa pIDayA mR^itakalpo.abhavaditi satyaM kintvIshvarastaM dayitavAn mama cha duHkhAt paraM punarduHkhaM yanna bhavet tadarthaM kevalaM taM na dayitvA mAmapi dayitavAn|</para>
  <para style="p">
    <verse number="28" style="v"/>ataeva yUyaM taM vilokya yat punarAnandeta mamApi duHkhasya hrAso yad bhavet tadartham ahaM tvarayA tam apreShayaM|</para>
  <para style="p">
    <verse number="29" style="v"/>ato yUyaM prabhoH kR^ite sampUrNenAnandena taM gR^ihlIta tAdR^ishAn lokAMshchAdaraNIyAn manyadhvaM|</para>
  <para style="p">
    <verse number="30" style="v"/>yato mama sevane yuShmAkaM truTiM pUrayituM sa prANAn paNIkR^itya khrIShTasya kAryyArthaM mR^itaprAye.abhavat|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he bhrAtaraH, sheShe vadAmi yUyaM prabhAvAnandata| punaH punarekasya vacho lekhanaM mama kleshadaM nahi yuShmadartha ncha bhramanAshakaM bhavati|</para>
  <para style="p">
    <verse number="2" style="v"/>yUyaM kukkurebhyaH sAvadhAnA bhavata duShkarmmakAribhyaH sAvadhAnA bhavata ChinnamUlebhyo lokebhyashcha sAvadhAnA bhavata|</para>
  <para style="p">
    <verse number="3" style="v"/>vayameva Chinnatvacho lokA yato vayam AtmaneshvaraM sevAmahe khrIShTena yIshunA shlAghAmahe sharIreNa cha pragalbhatAM na kurvvAmahe|</para>
  <para style="p">
    <verse number="4" style="v"/>kintu sharIre mama pragalbhatAyAH kAraNaM vidyate, kashchid yadi sharIreNa pragalbhatAM chikIrShati tarhi tasmAd api mama pragalbhatAyA gurutaraM kAraNaM vidyate|</para>
  <para style="p">
    <verse number="5" style="v"/>yato.aham aShTamadivase tvakChedaprApta isrAyelvaMshIyo binyAmInagoShThIya ibrikulajAta ibriyo vyavasthAcharaNe phirUshI</para>
  <para style="p">
    <verse number="6" style="v"/>dharmmotsAhakAraNAt samiterupadravakArI vyavasthAto labhye puNye chAnindanIyaH|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu mama yadyat labhyam AsIt tat sarvvam ahaM khrIShTasyAnurodhAt kShatim amanye|</para>
  <para style="p">
    <verse number="8" style="v"/>ki nchAdhunApyahaM matprabhoH khrIShTasya yIsho rj nAnasyotkR^iShTatAM buddhvA tat sarvvaM kShatiM manye|</para>
  <para style="p">
    <verse number="9" style="v"/>yato hetorahaM yat khrIShTaM labheya vyavasthAto jAtaM svakIyapuNya ncha na dhArayan kintu khrIShTe vishvasanAt labhyaM yat puNyam IshvareNa vishvAsaM dR^iShTvA dIyate tadeva dhArayan yat khrIShTe vidyeya tadarthaM tasyAnurodhAt sarvveShAM kShatiM svIkR^itya tAni sarvvANyavakarAniva manye|</para>
  <para style="p">
    <verse number="10" style="v"/>yato hetorahaM khrIShTaM tasya punarutthite rguNaM tasya duHkhAnAM bhAgitva ncha j nAtvA tasya mR^ityorAkR^iti ncha gR^ihItvA</para>
  <para style="p">
    <verse number="11" style="v"/>yena kenachit prakAreNa mR^itAnAM punarutthitiM prAptuM yate|</para>
  <para style="p">
    <verse number="12" style="v"/>mayA tat sarvvam adhunA prApi siddhatA vAlambhi tannahi kintu yadartham ahaM khrIShTena dhAritastad dhArayituM dhAvAmi|</para>
  <para style="p">
    <verse number="13" style="v"/>he bhrAtaraH, mayA tad dhAritam iti na manyate kintvetadaikamAtraM vadAmi yAni pashchAt sthitAni tAni vismR^ityAham agrasthitAnyuddishya</para>
  <para style="p">
    <verse number="14" style="v"/>pUrNayatnena lakShyaM prati dhAvan khrIShTayIshunorddhvAt mAm Ahvayata IshvarAt jetR^ipaNaM prAptuM cheShTe|</para>
  <para style="p">
    <verse number="15" style="v"/>asmAkaM madhye ye siddhAstaiH sarvvaistadeva bhAvyatAM, yadi cha ka nchana viShayam adhi yuShmAkam aparo bhAvo bhavati tarhIshvarastamapi yuShmAkaM prati prakAshayiShyati|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu vayaM yadyad avagatA AsmastatrAsmAbhireko vidhirAcharitavya ekabhAvai rbhavitavya ncha|</para>
  <para style="p">
    <verse number="17" style="v"/>he bhrAtaraH, yUyaM mamAnugAmino bhavata vaya ncha yAdR^igAcharaNasya nidarshanasvarUpA bhavAmastAdR^igAchAriNo lokAn AlokayadhvaM|</para>
  <para style="p">
    <verse number="18" style="v"/>yato.aneke vipathe charanti te cha khrIShTasya krushasya shatrava iti purA mayA punaH punaH kathitam adhunApi rudatA mayA kathyate|</para>
  <para style="p">
    <verse number="19" style="v"/>teShAM sheShadashA sarvvanAsha udarashcheshvaro lajjA cha shlAghA pR^ithivyA ncha lagnaM manaH|</para>
  <para style="p">
    <verse number="20" style="v"/>kintvasmAkaM janapadaH svarge vidyate tasmAchchAgamiShyantaM trAtAraM prabhuM yIshukhrIShTaM vayaM pratIkShAmahe|</para>
  <para style="p">
    <verse number="21" style="v"/>sa cha yayA shaktyA sarvvANyeva svasya vashIkarttuM pArayati tayAsmAkam adhamaM sharIraM rUpAntarIkR^itya svakIyatejomayasharIrasya samAkAraM kariShyati|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he madIyAnandamukuTasvarUpAH priyatamA abhIShTatamA bhrAtaraH, he mama snehapAtrAH, yUyam itthaM pabhau sthirAstiShThata|</para>
  <para style="p">
    <verse number="2" style="v"/>he ivadiye he suntukhi yuvAM prabhau ekabhAve bhavatam etad ahaM prArthaye|</para>
  <para style="p">
    <verse number="3" style="v"/>he mama satya sahakArin tvAmapi vinIya vadAmi etayorupakArastvayA kriyatAM yataste klIminAdibhiH sahakAribhiH sArddhaM susaMvAdaprachAraNAya mama sAhAyyArthaM parishramam akurvvatAM teShAM sarvveShAM nAmAni cha jIvanapustake likhitAni vidyante|</para>
  <para style="p">
    <verse number="4" style="v"/>yUyaM prabhau sarvvadAnandata| puna rvadAmi yUyam Anandata|</para>
  <para style="p">
    <verse number="5" style="v"/>yuShmAkaM vinItatvaM sarvvamAnavai rj nAyatAM, prabhuH sannidhau vidyate|</para>
  <para style="p">
    <verse number="6" style="v"/>yUyaM kimapi na chintayata kintu dhanyavAdayuktAbhyAM prArthanAyA nchAbhyAM sarvvaviShaye svaprArthanIyam IshvarAya nivedayata|</para>
  <para style="p">
    <verse number="7" style="v"/>tathA kR^ita IshvarIyA yA shAntiH sarvvAM buddhim atishete sA yuShmAkaM chittAni manAMsi cha khrIShTe yIshau rakShiShyati|</para>
  <para style="p">
    <verse number="8" style="v"/>he bhrAtaraH, sheShe vadAmi yadyat satyam AdaraNIyaM nyAyyaM sAdhu priyaM sukhyAtam anyeNa yena kenachit prakAreNa vA guNayuktaM prashaMsanIyaM vA bhavati tatraiva manAMsi nidhadhvaM|</para>
  <para style="p">
    <verse number="9" style="v"/>yUyaM mAM dR^iShTvA shrutvA cha yadyat shikShitavanto gR^ihItavantashcha tadevAcharata tasmAt shAntidAyaka Ishvaro yuShmAbhiH sArddhaM sthAsyati|</para>
  <para style="p">
    <verse number="10" style="v"/>mamopakArAya yuShmAkaM yA chintA pUrvvam AsIt kintu karmmadvAraM na prApnot idAnIM sA punaraphalat ityasmin prabhau mama paramAhlAdo.ajAyata|</para>
  <para style="p">
    <verse number="11" style="v"/>ahaM yad dainyakAraNAd idaM vadAmi tannahi yato mama yA kAchid avasthA bhavet tasyAM santoShTum ashikShayaM|</para>
  <para style="p">
    <verse number="12" style="v"/>daridratAM bhoktuM shaknomi dhanADhyatAm api bhoktuM shaknomi sarvvathA sarvvaviShayeShu vinIto.ahaM prachuratAM kShudhA ncha dhanaM dainya nchAvagato.asmi|</para>
  <para style="p">
    <verse number="13" style="v"/>mama shaktidAyakena khrIShTena sarvvameva mayA shakyaM bhavati|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu yuShmAbhi rdainyanivAraNAya mAm upakR^itya satkarmmAkAri|</para>
  <para style="p">
    <verse number="15" style="v"/>he philipIyalokAH, susaMvAdasyodayakAle yadAhaM mAkidaniyAdeshAt pratiShThe tadA kevalAn yuShmAn vinAparayA kayApi samityA saha dAnAdAnayo rmama ko.api sambandho nAsId iti yUyamapi jAnItha|</para>
  <para style="p">
    <verse number="16" style="v"/>yato yuShmAbhi rmama prayojanAya thiShalanIkInagaramapi mAM prati punaH punardAnaM preShitaM|</para>
  <para style="p">
    <verse number="17" style="v"/>ahaM yad dAnaM mR^igaye tannahi kintu yuShmAkaM lAbhavarddhakaM phalaM mR^igaye|</para>
  <para style="p">
    <verse number="18" style="v"/>kintu mama kasyApyabhAvo nAsti sarvvaM prachuram Aste yata Ishvarasya grAhyaM tuShTijanakaM sugandhinaivedyasvarUpaM yuShmAkaM dAnaM ipAphraditAd gR^ihItvAhaM paritR^ipto.asmi|</para>
  <para style="p">
    <verse number="19" style="v"/>mameshvaro.api khrIShTena yIshunA svakIyavibhavanidhitaH prayojanIyaM sarvvaviShayaM pUrNarUpaM yuShmabhyaM deyAt|</para>
  <para style="p">
    <verse number="20" style="v"/>asmAkaM piturIshvarasya dhanyavAdo.anantakAlaM yAvad bhavatu| Amen|</para>
  <para style="p">
    <verse number="21" style="v"/>yUyaM yIshukhrIShTasyaikaikaM pavitrajanaM namaskuruta| mama sa NgibhrAtaro yUShmAn namaskurvvate|</para>
  <para style="p">
    <verse number="22" style="v"/>sarvve pavitralokA visheShataH kaisarasya parijanA yuShmAn namaskurvvate|</para>
  <para style="p">
    <verse number="23" style="v"/>asmAkaM prabho ryIshukhrIShTasya prasAdaH sarvvAn yuShmAn prati bhUyAt| Amen|</para>
</usx>
