  <para style="h">Mark</para>
  <para style="toc1">mArkalikhitaH susaMvAdaH</para>
  <para style="toc2">mArkaH</para>
  <para style="toc3">mArkaH</para>
  <para style="mt1">mArkalikhitaH susaMvAdaH</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>Ishvaraputrasya yIshukhrIShTasya susaMvAdArambhaH|</para>
  <para style="p">
    <verse number="2" style="v"/>bhaviShyadvAdinAM grantheShu lipiritthamAste, pashya svakIyadUtantu tavAgre preShayAmyaham| gatvA tvadIyapanthAnaM sa hi pariShkariShyati|</para>
  <para style="p">
    <verse number="3" style="v"/>"parameshasya panthAnaM pariShkuruta sarvvataH| tasya rAjapatha nchaiva samAnaM kurutAdhunA|" ityetat prAntare vAkyaM vadataH kasyachidravaH||</para>
  <para style="p">
    <verse number="4" style="v"/>saeva yohan prAntare majjitavAn tathA pApamArjananimittaM manovyAvarttakamajjanasya kathA ncha prachAritavAn|</para>
  <para style="p">
    <verse number="5" style="v"/>tato yihUdAdeshayirUshAlamnagaranivAsinaH sarvve lokA bahi rbhUtvA tasya samIpamAgatya svAni svAni pApAnya NgIkR^itya yarddananadyAM tena majjitA babhUvuH|</para>
  <para style="p">
    <verse number="6" style="v"/>asya yohanaH paridheyAni kramelakalomajAni, tasya kaTibandhanaM charmmajAtam, tasya bhakShyANi cha shUkakITA vanyamadhUni chAsan|</para>
  <para style="p">
    <verse number="7" style="v"/>sa prachArayan kathayA nchakre, ahaM namrIbhUya yasya pAdukAbandhanaM mochayitumapi na yogyosmi, tAdR^isho matto gurutara ekaH puruSho matpashchAdAgachChati|</para>
  <para style="p">
    <verse number="8" style="v"/>ahaM yuShmAn jale majjitavAn kintu sa pavitra AtmAni saMmajjayiShyati|</para>
  <para style="p">
    <verse number="9" style="v"/>apara ncha tasminneva kAle gAlIlpradeshasya nAsaradgrAmAd yIshurAgatya yohanA yarddananadyAM majjito.abhUt|</para>
  <para style="p">
    <verse number="10" style="v"/>sa jalAdutthitamAtro meghadvAraM muktaM kapotavat svasyopari avarohantamAtmAna ncha dR^iShTavAn|</para>
  <para style="p">
    <verse number="11" style="v"/>tvaM mama priyaH putrastvayyeva mamamahAsantoSha iyamAkAshIyA vANI babhUva|</para>
  <para style="p">
    <verse number="12" style="v"/>tasmin kAle AtmA taM prAntaramadhyaM ninAya|</para>
  <para style="p">
    <verse number="13" style="v"/>atha sa chatvAriMshaddinAni tasmin sthAne vanyapashubhiH saha tiShThan shaitAnA parIkShitaH; pashchAt svargIyadUtAstaM siShevire|</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraM yohani bandhanAlaye baddhe sati yIshu rgAlIlpradeshamAgatya IshvararAjyasya susaMvAdaM prachArayan kathayAmAsa,</para>
  <para style="p">
    <verse number="15" style="v"/>kAlaH sampUrNa IshvararAjya ncha samIpamAgataM; atoheto ryUyaM manAMsi vyAvarttayadhvaM susaMvAde cha vishvAsita|</para>
  <para style="p">
    <verse number="16" style="v"/>tadanantaraM sa gAlIlIyasamudrasya tIre gachChan shimon tasya bhrAtA andriyanAmA cha imau dvau janau matsyadhAriNau sAgaramadhye jAlaM prakShipantau dR^iShTvA tAvavadat,</para>
  <para style="p">
    <verse number="17" style="v"/>yuvAM mama pashchAdAgachChataM, yuvAmahaM manuShyadhAriNau kariShyAmi|</para>
  <para style="p">
    <verse number="18" style="v"/>tatastau tatkShaNameva jAlAni parityajya tasya pashchAt jagmatuH|</para>
  <para style="p">
    <verse number="19" style="v"/>tataH paraM tatsthAnAt ki nchid dUraM gatvA sa sivadIputrayAkUb tadbhrAtR^iyohan cha imau naukAyAM jAlAnAM jIrNamuddhArayantau dR^iShTvA tAvAhUyat|</para>
  <para style="p">
    <verse number="20" style="v"/>tatastau naukAyAM vetanabhugbhiH sahitaM svapitaraM vihAya tatpashchAdIyatuH|</para>
  <para style="p">
    <verse number="21" style="v"/>tataH paraM kapharnAhUmnAmakaM nagaramupasthAya sa vishrAmadivase bhajanagrahaM pravishya samupadidesha|</para>
  <para style="p">
    <verse number="22" style="v"/>tasyopadeshAllokA AshcharyyaM menire yataH sodhyApakAiva nopadishan prabhAvavAniva propadidesha|</para>
  <para style="p">
    <verse number="23" style="v"/>apara ncha tasmin bhajanagR^ihe apavitrabhUtena grasta eko mAnuSha AsIt| sa chItshabdaM kR^itvA kathayA nchake</para>
  <para style="p">
    <verse number="24" style="v"/>bho nAsaratIya yIsho tvamasmAn tyaja, tvayA sahAsmAkaM kaH sambandhaH? tvaM kimasmAn nAshayituM samAgataH? tvamIshvarasya pavitraloka ityahaM jAnAmi|</para>
  <para style="p">
    <verse number="25" style="v"/>tadA yIshustaM tarjayitvA jagAda tUShNIM bhava ito bahirbhava cha|</para>
  <para style="p">
    <verse number="26" style="v"/>tataH so.apavitrabhUtastaM sampIDya atyuchaishchItkR^itya nirjagAma|</para>
  <para style="p">
    <verse number="27" style="v"/>tenaiva sarvve chamatkR^itya parasparaM kathayA nchakrire, aho kimidaM? kIdR^isho.ayaM navya upadeshaH? anena prabhAvenApavitrabhUteShvAj nApiteShu te tadAj nAnuvarttino bhavanti|</para>
  <para style="p">
    <verse number="28" style="v"/>tadA tasya yasho gAlIlashchaturdiksthasarvvadeshAn vyApnot|</para>
  <para style="p">
    <verse number="29" style="v"/>apara ncha te bhajanagR^ihAd bahi rbhUtvA yAkUbyohanbhyAM saha shimona Andriyasya cha niveshanaM pravivishuH|</para>
  <para style="p">
    <verse number="30" style="v"/>tadA pitarasya shvashrUrjvarapIDitA shayyAyAmAsta iti te taM jhaTiti vij nApayA nchakruH|</para>
  <para style="p">
    <verse number="31" style="v"/>tataH sa Agatya tasyA hastaM dhR^itvA tAmudasthApayat; tadaiva tAM jvaro.atyAkShIt tataH paraM sA tAn siSheve|</para>
  <para style="p">
    <verse number="32" style="v"/>athAstaM gate ravau sandhyAkAle sati lokAstatsamIpaM sarvvAn rogiNo bhUtadhR^itAMshcha samAninyuH|</para>
  <para style="p">
    <verse number="33" style="v"/>sarvve nAgarikA lokA dvAri saMmilitAshcha|</para>
  <para style="p">
    <verse number="34" style="v"/>tataH sa nAnAvidharogiNo bahUn manujAnarogiNashchakAra tathA bahUn bhUtAn tyAjayA nchakAra tAn bhUtAn kimapi vAkyaM vaktuM niShiShedha cha yatohetoste tamajAnan|</para>
  <para style="p">
    <verse number="35" style="v"/>apara ncha so.atipratyUShe vastutastu rAtrisheShe samutthAya bahirbhUya nirjanaM sthAnaM gatvA tatra prArthayA nchakre|</para>
  <para style="p">
    <verse number="36" style="v"/>anantaraM shimon tatsa Nginashcha tasya pashchAd gatavantaH|</para>
  <para style="p">
    <verse number="37" style="v"/>taduddeshaM prApya tamavadan sarvve lokAstvAM mR^igayante|</para>
  <para style="p">
    <verse number="38" style="v"/>tadA so.akathayat AgachChata vayaM samIpasthAni nagarANi yAmaH, yato.ahaM tatra kathAM prachArayituM bahirAgamam|</para>
  <para style="p">
    <verse number="39" style="v"/>atha sa teShAM gAlIlpradeshasya sarvveShu bhajanagR^iheShu kathAH prachArayA nchakre bhUtAnatyAjaya ncha|</para>
  <para style="p">
    <verse number="40" style="v"/>anantaramekaH kuShThI samAgatya tatsammukhe jAnupAtaM vinaya ncha kR^itvA kathitavAn yadi bhavAn ichChati tarhi mAM pariShkarttuM shaknoti|</para>
  <para style="p">
    <verse number="41" style="v"/>tataH kR^ipAlu ryIshuH karau prasAryya taM spaShTvA kathayAmAsa</para>
  <para style="p">
    <verse number="42" style="v"/>mamechChA vidyate tvaM pariShkR^ito bhava| etatkathAyAH kathanamAtrAt sa kuShThI rogAnmuktaH pariShkR^ito.abhavat|</para>
  <para style="p">
    <verse number="43" style="v"/>tadA sa taM visR^ijan gADhamAdishya jagAda</para>
  <para style="p">
    <verse number="44" style="v"/>sAvadhAno bhava kathAmimAM kamapi mA vada; svAtmAnaM yAjakaM darshaya, lokebhyaH svapariShkR^iteH pramANadAnAya mUsAnirNItaM yaddAnaM tadutsR^ijasva cha|</para>
  <para style="p">
    <verse number="45" style="v"/>kintu sa gatvA tat karmma itthaM vistAryya prachArayituM prArebhe tenaiva yIshuH punaH saprakAshaM nagaraM praveShTuM nAshaknot tatohetorbahiH kAnanasthAne tasyau; tathApi chaturddigbhyo lokAstasya samIpamAyayuH|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadanantaraM yIshai katipayadinAni vilambya punaH kapharnAhUmnagaraM praviShTe sa gR^iha Asta iti kiMvadantyA tatkShaNaM tatsamIpaM bahavo lokA Agatya samupatasthuH,</para>
  <para style="p">
    <verse number="2" style="v"/>tasmAd gR^ihamadhye sarvveShAM kR^ite sthAnaM nAbhavad dvArasya chaturdikShvapi nAbhavat, tatkAle sa tAn prati kathAM prachArayA nchakre|</para>
  <para style="p">
    <verse number="3" style="v"/>tataH paraM lokAshchaturbhi rmAnavairekaM pakShAghAtinaM vAhayitvA tatsamIpam AninyuH|</para>
  <para style="p">
    <verse number="4" style="v"/>kintu janAnAM bahutvAt taM yIshoH sammukhamAnetuM na shaknuvanto yasmin sthAne sa Aste taduparigR^ihapR^iShThaM khanitvA ChidraM kR^itvA tena mArgeNa sashayyaM pakShAghAtinam avarohayAmAsuH|</para>
  <para style="p">
    <verse number="5" style="v"/>tato yIshusteShAM vishvAsaM dR^iShTvA taM pakShAghAtinaM babhAShe he vatsa tava pApAnAM mArjanaM bhavatu|</para>
  <para style="p">
    <verse number="6" style="v"/>tadA kiyanto.adhyApakAstatropavishanto manobhi rvitarkayA nchakruH, eSha manuShya etAdR^ishImIshvaranindAM kathAM kutaH kathayati?</para>
  <para style="p">
    <verse number="7" style="v"/>IshvaraM vinA pApAni mArShTuM kasya sAmarthyam Aste?</para>
  <para style="p">
    <verse number="8" style="v"/>itthaM te vitarkayanti yIshustatkShaNaM manasA tad budvvA tAnavadad yUyamantaHkaraNaiH kuta etAni vitarkayatha?</para>
  <para style="p">
    <verse number="9" style="v"/>tadanantaraM yIshustatsthAnAt punaH samudrataTaM yayau; lokanivahe tatsamIpamAgate sa tAn samupadidesha|</para>
  <para style="p">
    <verse number="10" style="v"/>kintu pR^ithivyAM pApAni mArShTuM manuShyaputrasya sAmarthyamasti, etad yuShmAn j nApayituM (sa tasmai pakShAghAtine kathayAmAsa)</para>
  <para style="p">
    <verse number="11" style="v"/>uttiShTha tava shayyAM gR^ihItvA svagR^ihaM yAhi, ahaM tvAmidam Aj nApayAmi|</para>
  <para style="p">
    <verse number="12" style="v"/>tataH sa tatkShaNam utthAya shayyAM gR^ihItvA sarvveShAM sAkShAt jagAma; sarvve vismitA etAdR^ishaM karmma vayam kadApi nApashyAma, imAM kathAM kathayitveshvaraM dhanyamabruvan|</para>
  <para style="p">
    <verse number="13" style="v"/>tadanantaraM yIshustatsthAnAt punaH samudrataTaM yayau; lokanivahe tatsamIpamAgate sa tAn samupadidesha|</para>
  <para style="p">
    <verse number="14" style="v"/>atha gachChan karasa nchayagR^iha upaviShTam AlphIyaputraM leviM dR^iShTvA tamAhUya kathitavAn matpashchAt tvAmAmachCha tataH sa utthAya tatpashchAd yayau|</para>
  <para style="p">
    <verse number="15" style="v"/>anantaraM yIshau tasya gR^ihe bhoktum upaviShTe bahavaH karama nchAyinaH pApinashcha tena tachChiShyaishcha sahopavivishuH, yato bahavastatpashchAdAjagmuH|</para>
  <para style="p">
    <verse number="16" style="v"/>tadA sa karama nchAyibhiH pApibhishcha saha khAdati, tad dR^iShTvAdhyApakAH phirUshinashcha tasya shiShyAnUchuH karama nchAyibhiH pApibhishcha sahAyaM kuto bhuMkte pivati cha?</para>
  <para style="p">
    <verse number="17" style="v"/>tadvAkyaM shrutvA yIshuH pratyuvAcha,arogilokAnAM chikitsakena prayojanaM nAsti, kintu rogiNAmeva; ahaM dhArmmikAnAhvAtuM nAgataH kintu mano vyAvarttayituM pApina eva|</para>
  <para style="p">
    <verse number="18" style="v"/>tataH paraM yohanaH phirUshinA nchopavAsAchArishiShyA yIshoH samIpam Agatya kathayAmAsuH, yohanaH phirUshinA ncha shiShyA upavasanti kintu bhavataH shiShyA nopavasanti kiM kAraNamasya?</para>
  <para style="p">
    <verse number="19" style="v"/>tadA yIshustAn babhAShe yAvat kAlaM sakhibhiH saha kanyAyA varastiShThati tAvatkAlaM te kimupavastuM shaknuvanti? yAvatkAlaM varastaiH saha tiShThati tAvatkAlaM ta upavastuM na shaknuvanti|</para>
  <para style="p">
    <verse number="20" style="v"/>yasmin kAle tebhyaH sakAshAd varo neShyate sa kAla AgachChati, tasmin kAle te janA upavatsyanti|</para>
  <para style="p">
    <verse number="21" style="v"/>kopi janaH purAtanavastre nUtanavastraM na sIvyati, yato nUtanavastreNa saha sevane kR^ite jIrNaM vastraM Chidyate tasmAt puna rmahat ChidraM jAyate|</para>
  <para style="p">
    <verse number="22" style="v"/>kopi janaH purAtanakutUShu nUtanaM drAkShArasaM na sthApayati, yato nUtanadrAkShArasasya tejasA tAH kutvo vidIryyante tato drAkShArasashcha patati kutvashcha nashyanti, ataeva nUtanadrAkShAraso nUtanakutUShu sthApanIyaH|</para>
  <para style="p">
    <verse number="23" style="v"/>tadanantaraM yIshu ryadA vishrAmavAre shasyakShetreNa gachChati tadA tasya shiShyA gachChantaH shasyama njarIshChettuM pravR^ittAH|</para>
  <para style="p">
    <verse number="24" style="v"/>ataH phirUshino yIshave kathayAmAsuH pashyatu vishrAmavAsare yat karmma na karttavyaM tad ime kutaH kurvvanti?</para>
  <para style="p">
    <verse number="25" style="v"/>tadA sa tebhyo.akathayat dAyUd tatsaM Nginashcha bhakShyAbhAvAt kShudhitAH santo yat karmma kR^itavantastat kiM yuShmAbhi rna paThitam?</para>
  <para style="p">
    <verse number="26" style="v"/>abiyAtharnAmake mahAyAjakatAM kurvvati sa kathamIshvarasyAvAsaM pravishya ye darshanIyapUpA yAjakAn vinAnyasya kasyApi na bhakShyAstAneva bubhuje sa Ngilokebhyo.api dadau|</para>
  <para style="p">
    <verse number="27" style="v"/>so.aparamapi jagAda, vishrAmavAro manuShyArthameva nirUpito.asti kintu manuShyo vishrAmavArArthaM naiva|</para>
  <para style="p">
    <verse number="28" style="v"/>manuShyaputro vishrAmavArasyApi prabhurAste|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM yIshuH puna rbhajanagR^ihaM praviShTastasmin sthAne shuShkahasta eko mAnava AsIt|</para>
  <para style="p">
    <verse number="2" style="v"/>sa vishrAmavAre tamarogiNaM kariShyati navetyatra bahavastam apavadituM ChidramapekShitavantaH|</para>
  <para style="p">
    <verse number="3" style="v"/>tadA sa taM shuShkahastaM manuShyaM jagAda madhyasthAne tvamuttiShTha|</para>
  <para style="p">
    <verse number="4" style="v"/>tataH paraM sa tAn paprachCha vishrAmavAre hitamahitaM tathA hi prANarakShA vA prANanAsha eShAM madhye kiM karaNIyaM ? kintu te niHshabdAstasthuH|</para>
  <para style="p">
    <verse number="5" style="v"/>tadA sa teShAmantaHkaraNAnAM kAThinyAddheto rduHkhitaH krodhAt chartuिdasho dR^iShTavAn taM mAnuShaM gaditavAn taM hastaM vistAraya, tatastena haste vistR^ite taddhasto.anyahastavad arogo jAtaH|</para>
  <para style="p">
    <verse number="6" style="v"/>atha phirUshinaH prasthAya taM nAshayituM herodIyaiH saha mantrayitumArebhire|</para>
  <para style="p">
    <verse number="7" style="v"/>ataeva yIshustatsthAnaM parityajya shiShyaiH saha punaH sAgarasamIpaM gataH;</para>
  <para style="p">
    <verse number="8" style="v"/>tato gAlIlyihUdA-yirUshAlam-idom-yardannadIpArasthAnebhyo lokasamUhastasya pashchAd gataH; tadanyaH sorasIdanoH samIpavAsilokasamUhashcha tasya mahAkarmmaNAM vArttaM shrutvA tasya sannidhimAgataH|</para>
  <para style="p">
    <verse number="9" style="v"/>tadA lokasamUhashchet tasyopari patati ityAsha Nkya sa nAvamekAM nikaTe sthApayituM shiShyAnAdiShTavAn|</para>
  <para style="p">
    <verse number="10" style="v"/>yato.anekamanuShyANAmArogyakaraNAd vyAdhigrastAH sarvve taM spraShTuM parasparaM balena yatnavantaH|</para>
  <para style="p">
    <verse number="11" style="v"/>apara ncha apavitrabhUtAstaM dR^iShTvA tachcharaNayoH patitvA prochaiH prochuH, tvamIshvarasya putraH|</para>
  <para style="p">
    <verse number="12" style="v"/>kintu sa tAn dR^iDham Aj nApya svaM parichAyituM niShiddhavAn|</para>
  <para style="p">
    <verse number="13" style="v"/>anantaraM sa parvvatamAruhya yaM yaM pratichChA taM tamAhUtavAn tataste tatsamIpamAgatAH|</para>
  <para style="p">
    <verse number="14" style="v"/>tadA sa dvAdashajanAn svena saha sthAtuM susaMvAdaprachArAya preritA bhavituM</para>
  <para style="p">
    <verse number="15" style="v"/>sarvvaprakAravyAdhInAM shamanakaraNAya prabhAvaM prAptuM bhUtAn tyAjayitu ncha niyuktavAn|</para>
  <para style="p">
    <verse number="16" style="v"/>teShAM nAmAnImAni, shimon sivadiputro</para>
  <para style="p">
    <verse number="17" style="v"/>yAkUb tasya bhrAtA yohan cha AndriyaH philipo barthalamayaH,</para>
  <para style="p">
    <verse number="18" style="v"/>mathI thomA cha AlphIyaputro yAkUb thaddIyaH kinAnIyaH shimon yastaM parahasteShvarpayiShyati sa IShkariyotIyayihUdAshcha|</para>
  <para style="p">
    <verse number="19" style="v"/>sa shimone pitara ityupanAma dadau yAkUbyohanbhyAM cha binerigish arthato meghanAdaputrAvityupanAma dadau|</para>
  <para style="p">
    <verse number="20" style="v"/>anantaraM te niveshanaM gatAH, kintu tatrApi punarmahAn janasamAgamo .abhavat tasmAtte bhoktumapyavakAshaM na prAptAH|</para>
  <para style="p">
    <verse number="21" style="v"/>tatastasya suhR^illokA imAM vArttAM prApya sa hataj nAnobhUd iti kathAM kathayitvA taM dhR^itvAnetuM gatAH|</para>
  <para style="p">
    <verse number="22" style="v"/>apara ncha yirUshAlama AgatA ye ye.adhyApakAste jagadurayaM puruSho bhUtapatyAbiShTastena bhUtapatinA bhUtAn tyAjayati|</para>
  <para style="p">
    <verse number="23" style="v"/>tatastAnAhUya yIshu rdR^iShTAntaiH kathAM kathitavAn shaitAn kathaM shaitAnaM tyAjayituM shaknoti?</para>
  <para style="p">
    <verse number="24" style="v"/>ki nchana rAjyaM yadi svavirodhena pR^ithag bhavati tarhi tad rAjyaM sthiraM sthAtuM na shaknoti|</para>
  <para style="p">
    <verse number="25" style="v"/>tathA kasyApi parivAro yadi parasparaM virodhI bhavati tarhi sopi parivAraH sthiraM sthAtuM na shaknoti|</para>
  <para style="p">
    <verse number="26" style="v"/>tadvat shaitAn yadi svavipakShatayA uttiShThan bhinno bhavati tarhi sopi sthiraM sthAtuM na shaknoti kintUchChinno bhavati|</para>
  <para style="p">
    <verse number="27" style="v"/>apara ncha prabalaM janaM prathamaM na baddhA kopi tasya gR^ihaM pravishya dravyANi luNThayituM na shaknoti, taM badvvaiva tasya gR^ihasya dravyANi luNThayituM shaknoti|</para>
  <para style="p">
    <verse number="28" style="v"/>atoheto ryuShmabhyamahaM satyaM kathayAmi manuShyANAM santAnA yAni yAni pApAnIshvaranindA ncha kurvvanti teShAM tatsarvveShAmaparAdhAnAM kShamA bhavituM shaknoti,</para>
  <para style="p">
    <verse number="29" style="v"/>kintu yaH kashchit pavitramAtmAnaM nindati tasyAparAdhasya kShamA kadApi na bhaviShyati sonantadaNDasyArho bhaviShyati|</para>
  <para style="p">
    <verse number="30" style="v"/>tasyApavitrabhUto.asti teShAmetatkathAhetoH sa itthaM kathitavAn|</para>
  <para style="p">
    <verse number="31" style="v"/>atha tasya mAtA bhrAtR^igaNashchAgatya bahistiShThanato lokAn preShya tamAhUtavantaH|</para>
  <para style="p">
    <verse number="32" style="v"/>tatastatsannidhau samupaviShTA lokAstaM babhAShire pashya bahistava mAtA bhrAtarashcha tvAm anvichChanti|</para>
  <para style="p">
    <verse number="33" style="v"/>tadA sa tAn pratyuvAcha mama mAtA kA bhrAtaro vA ke? tataH paraM sa svamIpopaviShTAn shiShyAn prati avalokanaM kR^itvA kathayAmAsa</para>
  <para style="p">
    <verse number="34" style="v"/>pashyataite mama mAtA bhrAtarashcha|</para>
  <para style="p">
    <verse number="35" style="v"/>yaH kashchid IshvarasyeShTAM kriyAM karoti sa eva mama bhrAtA bhaginI mAtA cha|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM sa samudrataTe punarupadeShTuM prArebhe, tatastatra bahujanAnAM samAgamAt sa sAgaropari naukAmAruhya samupaviShTaH; sarvve lokAH samudrakUle tasthuH|</para>
  <para style="p">
    <verse number="2" style="v"/>tadA sa dR^iShTAntakathAbhi rbahUpadiShTavAn upadishaMshcha kathitavAn,</para>
  <para style="p">
    <verse number="3" style="v"/>avadhAnaM kuruta, eko bIjavaptA bIjAni vaptuM gataH;</para>
  <para style="p">
    <verse number="4" style="v"/>vapanakAle kiyanti bIjAni mArgapAshve patitAni, tata AkAshIyapakShiNa etya tAni chakhAduH|</para>
  <para style="p">
    <verse number="5" style="v"/>kiyanti bIjAni svalpamR^ittikAvatpAShANabhUmau patitAni tAni mR^idolpatvAt shIghrama NkuritAni;</para>
  <para style="p">
    <verse number="6" style="v"/>kintUdite sUryye dagdhAni tathA mUlAno nAdhogatatvAt shuShkANi cha|</para>
  <para style="p">
    <verse number="7" style="v"/>kiyanti bIjAni kaNTakivanamadhye patitAni tataH kaNTakAni saMvR^idvya tAni jagrasustAni na cha phalitAni|</para>
  <para style="p">
    <verse number="8" style="v"/>tathA kiyanti bIjAnyuttamabhUmau patitAni tAni saMvR^idvya phalAnyutpAditAni kiyanti bIjAni triMshadguNAni kiyanti ShaShTiguNAni kiyanti shataguNAni phalAni phalitavanti|</para>
  <para style="p">
    <verse number="9" style="v"/>atha sa tAnavadat yasya shrotuM karNau staH sa shR^iNotu|</para>
  <para style="p">
    <verse number="10" style="v"/>tadanantaraM nirjanasamaye tatsa Ngino dvAdashashiShyAshcha taM taddR^iShTAntavAkyasyArthaM paprachChuH|</para>
  <para style="p">
    <verse number="11" style="v"/>tadA sa tAnuditavAn IshvararAjyasya nigUDhavAkyaM boddhuM yuShmAkamadhikAro.asti;</para>
  <para style="p">
    <verse number="12" style="v"/>kintu ye vahirbhUtAH "te pashyantaH pashyanti kintu na jAnanti, shR^iNvantaH shR^iNvanti kintu na budhyante, chettai rmanaHsu kadApi parivarttiteShu teShAM pApAnyamochayiShyanta," atohetostAn prati dR^iShTAntaireva tAni mayA kathitAni|</para>
  <para style="p">
    <verse number="13" style="v"/>atha sa kathitavAn yUyaM kimetad dR^iShTAntavAkyaM na budhyadhve? tarhi kathaM sarvvAn dR^iShTAntAna bhotsyadhve?</para>
  <para style="p">
    <verse number="14" style="v"/>bIjavaptA vAkyarUpANi bIjAni vapati;</para>
  <para style="p">
    <verse number="15" style="v"/>tatra ye ye lokA vAkyaM shR^iNvanti, kintu shrutamAtrAt shaitAn shIghramAgatya teShAM manaHsUptAni tAni vAkyarUpANi bIjAnyapanayati taeva uptabIjamArgapArshvesvarUpAH|</para>
  <para style="p">
    <verse number="16" style="v"/>ye janA vAkyaM shrutvA sahasA paramAnandena gR^ihlanti, kintu hR^idi sthairyyAbhAvAt ki nchit kAlamAtraM tiShThanti tatpashchAt tadvAkyahetoH</para>
  <para style="p">
    <verse number="17" style="v"/>kutrachit kleshe upadrave vA samupasthite tadaiva vighnaM prApnuvanti taeva uptabIjapAShANabhUmisvarUpAH|</para>
  <para style="p">
    <verse number="18" style="v"/>ye janAH kathAM shR^iNvanti kintu sAMsArikI chintA dhanabhrAnti rviShayalobhashcha ete sarvve upasthAya tAM kathAM grasanti tataH mA viphalA bhavati</para>
  <para style="p">
    <verse number="19" style="v"/>taeva uptabIjasakaNTakabhUmisvarUpAH|</para>
  <para style="p">
    <verse number="20" style="v"/>ye janA vAkyaM shrutvA gR^ihlanti teShAM kasya vA triMshadguNAni kasya vA ShaShTiguNAni kasya vA shataguNAni phalAni bhavanti taeva uptabIjorvvarabhUmisvarUpAH|</para>
  <para style="p">
    <verse number="21" style="v"/>tadA so.aparamapi kathitavAn kopi jano dIpAdhAraM parityajya droNasyAdhaH khaTvAyA adhe vA sthApayituM dIpamAnayati kiM?</para>
  <para style="p">
    <verse number="22" style="v"/>atoheto ryanna prakAshayiShyate tAdR^ig lukkAyitaM kimapi vastu nAsti; yad vyaktaM na bhaviShyati tAdR^ishaM guptaM kimapi vastu nAsti|</para>
  <para style="p">
    <verse number="23" style="v"/>yasya shrotuM karNau staH sa shR^iNotu|</para>
  <para style="p">
    <verse number="24" style="v"/>aparamapi kathitavAn yUyaM yad yad vAkyaM shR^iNutha tatra sAvadhAnA bhavata, yato yUyaM yena parimANena parimAtha tenaiva parimANena yuShmadarthamapi parimAsyate; shrotAro yUyaM yuShmabhyamadhikaM dAsyate|</para>
  <para style="p">
    <verse number="25" style="v"/>yasyAshraye varddhate tasmai aparamapi dAsyate, kintu yasyAshraye na varddhate tasya yat ki nchidasti tadapi tasmAn neShyate|</para>
  <para style="p">
    <verse number="26" style="v"/>anantaraM sa kathitavAn eko lokaH kShetre bIjAnyuptvA</para>
  <para style="p">
    <verse number="27" style="v"/>jAgaraNanidrAbhyAM divAnishaM gamayati, parantu tadvIjaM tasyAj nAtarUpeNA Nkurayati varddhate cha;</para>
  <para style="p">
    <verse number="28" style="v"/>yatohetoH prathamataH patrANi tataH paraM kaNishAni tatpashchAt kaNishapUrNAni shasyAni bhUmiH svayamutpAdayati;</para>
  <para style="p">
    <verse number="29" style="v"/>kintu phaleShu pakkeShu shasyachChedanakAlaM j nAtvA sa tatkShaNaM shasyAni Chinatti, anena tulyamIshvararAjyaM|</para>
  <para style="p">
    <verse number="30" style="v"/>punaH so.akathayad IshvararAjyaM kena samaM? kena vastunA saha vA tadupamAsyAmi?</para>
  <para style="p">
    <verse number="31" style="v"/>tat sarShapaikena tulyaM yato mR^idi vapanakAle sarShapabIjaM sarvvapR^ithivIsthabIjAt kShudraM</para>
  <para style="p">
    <verse number="32" style="v"/>kintu vapanAt param a NkurayitvA sarvvashAkAd bR^ihad bhavati, tasya bR^ihatyaH shAkhAshcha jAyante tatastachChAyAM pakShiNa Ashrayante|</para>
  <para style="p">
    <verse number="33" style="v"/>itthaM teShAM bodhAnurUpaM so.anekadR^iShTAntaistAnupadiShTavAn,</para>
  <para style="p">
    <verse number="34" style="v"/>dR^iShTAntaM vinA kAmapi kathAM tebhyo na kathitavAn pashchAn nirjane sa shiShyAn sarvvadR^iShTAntArthaM bodhitavAn|</para>
  <para style="p">
    <verse number="35" style="v"/>taddinasya sandhyAyAM sa tebhyo.akathayad AgachChata vayaM pAraM yAma|</para>
  <para style="p">
    <verse number="36" style="v"/>tadA te lokAn visR^ijya tamavilambaM gR^ihItvA naukayA pratasthire; aparA api nAvastayA saha sthitAH|</para>
  <para style="p">
    <verse number="37" style="v"/>tataH paraM mahAjha nbhshagamAt nau rdolAyamAnA tara NgeNa jalaiH pUrNAbhavachcha|</para>
  <para style="p">
    <verse number="38" style="v"/>tadA sa naukAchashchAdbhAge upadhAne shiro nidhAya nidrita AsIt tataste taM jAgarayitvA jagaduH, he prabho, asmAkaM prANA yAnti kimatra bhavatashchintA nAsti?</para>
  <para style="p">
    <verse number="39" style="v"/>tadA sa utthAya vAyuM tarjitavAn samudra nchoktavAn shAntaH susthirashcha bhava; tato vAyau nivR^itte.abdhirnistara NgobhUt|</para>
  <para style="p">
    <verse number="40" style="v"/>tadA sa tAnuvAcha yUyaM kuta etAdR^iksha NkAkulA bhavata? kiM vo vishvAso nAsti?</para>
  <para style="p">
    <verse number="41" style="v"/>tasmAtte.atIvabhItAH parasparaM vaktumArebhire, aho vAyuH sindhushchAsya nideshagrAhiNau kIdR^igayaM manujaH|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha tU sindhupAraM gatvA giderIyapradesha upatasthuH|</para>
  <para style="p">
    <verse number="2" style="v"/>naukAto nirgatamAtrAd apavitrabhUtagrasta ekaH shmashAnAdetya taM sAkShAch chakAra|</para>
  <para style="p">
    <verse number="3" style="v"/>sa shmashAne.avAtsIt kopi taM shR^i Nkhalena badvvA sthApayituM nAshaknot|</para>
  <para style="p">
    <verse number="4" style="v"/>janairvAraM nigaDaiH shR^i Nkhalaishcha sa baddhopi shR^i NkhalAnyAkR^iShya mochitavAn nigaDAni cha bhaMktvA khaNDaM khaNDaM kR^itavAn kopi taM vashIkarttuM na shashaka|</para>
  <para style="p">
    <verse number="5" style="v"/>divAnishaM sadA parvvataM shmashAna ncha bhramitvA chItshabdaM kR^itavAn grAvabhishcha svayaM svaM kR^itavAn|</para>
  <para style="p">
    <verse number="6" style="v"/>sa yIshuM dUrAt pashyanneva dhAvan taM praNanAma uchairuvaMshchovAcha,</para>
  <para style="p">
    <verse number="7" style="v"/>he sarvvoparistheshvaraputra yIsho bhavatA saha me kaH sambandhaH? ahaM tvAmIshvareNa shApaye mAM mA yAtaya|</para>
  <para style="p">
    <verse number="8" style="v"/>yato yIshustaM kathitavAn re apavitrabhUta, asmAnnarAd bahirnirgachCha|</para>
  <para style="p">
    <verse number="9" style="v"/>atha sa taM pR^iShTavAn kinte nAma? tena pratyuktaM vayamaneke .asmastato.asmannAma bAhinI|</para>
  <para style="p">
    <verse number="10" style="v"/>tatosmAn deshAnna preShayeti te taM prArthayanta|</para>
  <para style="p">
    <verse number="11" style="v"/>tadAnIM parvvataM nikaShA bR^ihan varAhavrajashcharannAsIt|</para>
  <para style="p">
    <verse number="12" style="v"/>tasmAd bhUtA vinayena jagaduH, amuM varAhavrajam Ashrayitum asmAn prahiNu|</para>
  <para style="p">
    <verse number="13" style="v"/>yIshunAnuj nAtAste.apavitrabhUtA bahirniryAya varAhavrajaM prAvishan tataH sarvve varAhA vastutastu prAyodvisahasrasaM NkhyakAH kaTakena mahAjavAd dhAvantaH sindhau prANAn jahuH|</para>
  <para style="p">
    <verse number="14" style="v"/>tasmAd varAhapAlakAH palAyamAnAH pure grAme cha tadvArttaM kathayA nchakruH| tadA lokA ghaTitaM tatkAryyaM draShTuM bahirjagmuH</para>
  <para style="p">
    <verse number="15" style="v"/>yIshoH sannidhiM gatvA taM bhUtagrastam arthAd bAhinIbhUtagrastaM naraM savastraM sachetanaM samupaviShTa ncha dR^iृShTvA bibhyuH|</para>
  <para style="p">
    <verse number="16" style="v"/>tato dR^iShTatatkAryyalokAstasya bhUtagrastanarasya varAhavrajasyApi tAM dhaTanAM varNayAmAsuH|</para>
  <para style="p">
    <verse number="17" style="v"/>tataste svasImAto bahirgantuM yIshuM vinetumArebhire|</para>
  <para style="p">
    <verse number="18" style="v"/>atha tasya naukArohaNakAle sa bhUtamukto nA yIshunA saha sthAtuM prArthayate;</para>
  <para style="p">
    <verse number="19" style="v"/>kintu sa tamananumatya kathitavAn tvaM nijAtmIyAnAM samIpaM gR^iha ncha gachCha prabhustvayi kR^ipAM kR^itvA yAni karmmANi kR^itavAn tAni tAn j nApaya|</para>
  <para style="p">
    <verse number="20" style="v"/>ataH sa prasthAya yIshunA kR^itaM tatsarvvAshcharyyaM karmma dikApalideshe prachArayituM prArabdhavAn tataH sarvve lokA AshcharyyaM menire|</para>
  <para style="p">
    <verse number="21" style="v"/>anantaraM yIshau nAvA punaranyapAra uttIrNe sindhutaTe cha tiShThati sati tatsamIpe bahulokAnAM samAgamo.abhUt|</para>
  <para style="p">
    <verse number="22" style="v"/>aparaM yAyIr nAmnA kashchid bhajanagR^ihasyAdhipa Agatya taM dR^iShTvaiva charaNayoH patitvA bahu nivedya kathitavAn;</para>
  <para style="p">
    <verse number="23" style="v"/>mama kanyA mR^itaprAyAbhUd ato bhavAnetya tadArogyAya tasyA gAtre hastam arpayatu tenaiva sA jIviShyati|</para>
  <para style="p">
    <verse number="24" style="v"/>tadA yIshustena saha chalitaH kintu tatpashchAd bahulokAshchalitvA tAdgAtre patitAH|</para>
  <para style="p">
    <verse number="25" style="v"/>atha dvAdashavarShANi pradararogeNa</para>
  <para style="p">
    <verse number="26" style="v"/>shIrNA chikitsakAnAM nAnAchikitsAbhishcha duHkhaM bhuktavatI cha sarvvasvaM vyayitvApi nArogyaM prAptA cha punarapi pIDitAsIchcha</para>
  <para style="p">
    <verse number="27" style="v"/>yA strI sA yIsho rvArttAM prApya manasAkathayat yadyahaM tasya vastramAtra spraShTuM labheyaM tadA rogahInA bhaviShyAmi|</para>
  <para style="p">
    <verse number="28" style="v"/>atohetoH sA lokAraNyamadhye tatpashchAdAgatya tasya vastraM pasparsha|</para>
  <para style="p">
    <verse number="29" style="v"/>tenaiva tatkShaNaM tasyA raktasrotaH shuShkaM svayaM tasmAd rogAnmuktA ityapi dehe.anubhUtA|</para>
  <para style="p">
    <verse number="30" style="v"/>atha svasmAt shakti rnirgatA yIshuretanmanasA j nAtvA lokanivahaM prati mukhaM vyAvR^itya pR^iShTavAn kena madvastraM spR^iShTaM?</para>
  <para style="p">
    <verse number="31" style="v"/>tatastasya shiShyA UchuH bhavato vapuShi lokAH saMgharShanti tad dR^iShTvA kena madvastraM spR^iShTamiti kutaH kathayati?</para>
  <para style="p">
    <verse number="32" style="v"/>kintu kena tat karmma kR^itaM tad draShTuM yIshushchaturdisho dR^iShTavAn|</para>
  <para style="p">
    <verse number="33" style="v"/>tataH sA strI bhItA kampitA cha satI svasyA rukpratikriyA jAteti j nAtvAgatya tatsammukhe patitvA sarvvavR^ittAntaM satyaM tasmai kathayAmAsa|</para>
  <para style="p">
    <verse number="34" style="v"/>tadAnIM yIshustAM gaditavAn, he kanye tava pratItistvAm arogAmakarot tvaM kShemeNa vraja svarogAnmuktA cha tiShTha|</para>
  <para style="p">
    <verse number="35" style="v"/>itivAkyavadanakAle bhajanagR^ihAdhipasya niveshanAl lokA etyAdhipaM babhAShire tava kanyA mR^itA tasmAd guruM punaH kutaH klishnAsi?</para>
  <para style="p">
    <verse number="36" style="v"/>kintu yIshustad vAkyaM shrutvaiva bhajanagR^ihAdhipaM gaditavAn mA bhaiShIH kevalaM vishvAsihi|</para>
  <para style="p">
    <verse number="37" style="v"/>atha pitaro yAkUb tadbhrAtA yohan cha etAn vinA kamapi svapashchAd yAtuM nAnvamanyata|</para>
  <para style="p">
    <verse number="38" style="v"/>tasya bhajanagR^ihAdhipasya niveshanasamIpam Agatya kalahaM bahurodanaM vilApa ncha kurvvato lokAn dadarsha|</para>
  <para style="p">
    <verse number="39" style="v"/>tasmAn niveshanaM pravishya proktavAn yUyaM kuta itthaM kalahaM rodana ncha kurutha? kanyA na mR^itA nidrAti|</para>
  <para style="p">
    <verse number="40" style="v"/>tasmAtte tamupajahasuH kintu yIshuH sarvvAna bahiShkR^itya kanyAyAH pitarau svasa Nginashcha gR^ihItvA yatra kanyAsIt tat sthAnaM praviShTavAn|</para>
  <para style="p">
    <verse number="41" style="v"/>atha sa tasyAH kanyAyA hastau dhR^itvA tAM babhAShe TAlIthA kUmI, arthato he kanye tvamuttiShTha ityAj nApayAmi|</para>
  <para style="p">
    <verse number="42" style="v"/>tunaiva tatkShaNaM sA dvAdashavarShavayaskA kanyA potthAya chalitumArebhe, itaH sarvve mahAvismayaM gatAH|</para>
  <para style="p">
    <verse number="43" style="v"/>tata etasyai ki nchit khAdyaM datteti kathayitvA etatkarmma kamapi na j nApayateti dR^iDhamAdiShTavAn|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM sa tatsthAnAt prasthAya svapradeshamAgataH shiShyAshcha tatpashchAd gatAH|</para>
  <para style="p">
    <verse number="2" style="v"/>atha vishrAmavAre sati sa bhajanagR^ihe upadeShTumArabdhavAn tato.aneke lokAstatkathAM shrutvA vismitya jagaduH, asya manujasya IdR^ishI AshcharyyakriyA kasmAj jAtA? tathA svakarAbhyAm itthamadbhutaM karmma karttAुm etasmai kathaM j nAnaM dattam?</para>
  <para style="p">
    <verse number="3" style="v"/>kimayaM mariyamaH putrastaj nA no? kimayaM yAkUb-yosi-yihudA-shimonAM bhrAtA no? asya bhaginyaH kimihAsmAbhiH saha no? itthaM te tadarthe pratyUhaM gatAH|</para>
  <para style="p">
    <verse number="4" style="v"/>tadA yIshustebhyo.akathayat svadeshaM svakuTumbAn svaparijanAMshcha vinA kutrApi bhaviShyadvAdI asatkR^ito na bhavati|</para>
  <para style="p">
    <verse number="5" style="v"/>apara ncha teShAmapratyayAt sa vismitaH kiyatAM rogiNAM vapuHShu hastam arpayitvA kevalaM teShAmArogyakaraNAd anyat kimapi chitrakAryyaM karttAM na shaktaH|</para>
  <para style="p">
    <verse number="6" style="v"/>atha sa chaturdikstha grAmAn bhramitvA upadiShTavAn</para>
  <para style="p">
    <verse number="7" style="v"/>dvAdashashiShyAn AhUya amedhyabhUtAn vashIkarttAM shaktiM dattvA teShAM dvau dvau jano preShitavAn|</para>
  <para style="p">
    <verse number="8" style="v"/>punarityAdishad yUyam ekaikAM yaShTiM vinA vastrasaMpuTaH pUpaH kaTibandhe tAmrakhaNDa ncha eShAM kimapi mA grahlIta,</para>
  <para style="p">
    <verse number="9" style="v"/>mArgayAtrAyai pAdeShUpAnahau dattvA dve uttarIye mA paridhadvvaM|</para>
  <para style="p">
    <verse number="10" style="v"/>aparamapyuktaM tena yUyaM yasyAM puryyAM yasya niveshanaM pravekShyatha tAM purIM yAvanna tyakShyatha tAvat tanniveshane sthAsyatha|</para>
  <para style="p">
    <verse number="11" style="v"/>tatra yadi kepi yuShmAkamAtithyaM na vidadhati yuShmAkaM kathAshcha na shR^iNvanti tarhi tatsthAnAt prasthAnasamaye teShAM viruddhaM sAkShyaM dAtuM svapAdAnAsphAlya rajaH sampAtayata; ahaM yuShmAn yathArthaM vachmi vichAradine tannagarasyAvasthAtaH sidomAmorayo rnagarayoravasthA sahyatarA bhaviShyati|</para>
  <para style="p">
    <verse number="12" style="v"/>atha te gatvA lokAnAM manaHparAvarttanIH kathA prachAritavantaH|</para>
  <para style="p">
    <verse number="13" style="v"/>evamanekAn bhUtAMshcha tyAjitavantastathA tailena marddayitvA bahUn janAnarogAnakArShuH|</para>
  <para style="p">
    <verse number="14" style="v"/>itthaM tasya sukhyAtishchaturdisho vyAptA tadA herod rAjA tannishamya kathitavAn, yohan majjakaH shmashAnAd utthita atohetostena sarvvA etA adbhutakriyAH prakAshante|</para>
  <para style="p">
    <verse number="15" style="v"/>anye.akathayan ayam eliyaH, kepi kathitavanta eSha bhaviShyadvAdI yadvA bhaviShyadvAdinAM sadR^isha ekoyam|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu herod ityAkarNya bhAShitavAn yasyAhaM shirashChinnavAn sa eva yohanayaM sa shmashAnAdudatiShThat|</para>
  <para style="p">
    <verse number="17" style="v"/>pUrvvaM svabhrAtuH philipasya patnyA udvAhaM kR^itavantaM herodaM yohanavAdIt svabhAtR^ivadhU rna vivAhyA|</para>
  <para style="p">
    <verse number="18" style="v"/>ataH kAraNAt herod lokaM prahitya yohanaM dhR^itvA bandhanAlaye baddhavAn|</para>
  <para style="p">
    <verse number="19" style="v"/>herodiyA tasmai yohane prakupya taM hantum aichChat kintu na shaktA,</para>
  <para style="p">
    <verse number="20" style="v"/>yasmAd herod taM dhArmmikaM satpuruSha ncha j nAtvA sammanya rakShitavAn; tatkathAM shrutvA tadanusAreNa bahUni karmmANi kR^itavAn hR^iShTamanAstadupadeshaM shrutavAMshcha|</para>
  <para style="p">
    <verse number="21" style="v"/>kintu herod yadA svajanmadine pradhAnalokebhyaH senAnIbhyashcha gAlIlpradeshIyashreShThalokebhyashcha rAtrau bhojyamekaM kR^itavAn</para>
  <para style="p">
    <verse number="22" style="v"/>tasmin shubhadine herodiyAyAH kanyA sametya teShAM samakShaM saMnR^itya herodastena sahopaviShTAnA ncha toShamajIjanat tatA nR^ipaH kanyAmAha sma matto yad yAchase tadeva tubhyaM dAsye|</para>
  <para style="p">
    <verse number="23" style="v"/>shapathaM kR^itvAkathayat ched rAjyArddhamapi yAchase tadapi tubhyaM dAsye|</para>
  <para style="p">
    <verse number="24" style="v"/>tataH sA bahi rgatvA svamAtaraM paprachCha kimahaM yAchiShye? tadA sAkathayat yohano majjakasya shiraH|</para>
  <para style="p">
    <verse number="25" style="v"/>atha tUrNaM bhUpasamIpam etya yAchamAnAvadat kShaNesmin yohano majjakasya shiraH pAtre nidhAya dehi, etad yAche.ahaM|</para>
  <para style="p">
    <verse number="26" style="v"/>tasmAt bhUpo.atiduHkhitaH, tathApi svashapathasya sahabhojinA nchAnurodhAt tadana NgIkarttuM na shaktaH|</para>
  <para style="p">
    <verse number="27" style="v"/>tatkShaNaM rAjA ghAtakaM preShya tasya shira AnetumAdiShTavAn|</para>
  <para style="p">
    <verse number="28" style="v"/>tataH sa kArAgAraM gatvA tachChirashChitvA pAtre nidhAyAnIya tasyai kanyAyai dattavAn kanyA cha svamAtre dadau|</para>
  <para style="p">
    <verse number="29" style="v"/>ananataraM yohanaH shiShyAstadvArttAM prApyAgatya tasya kuNapaM shmashAne.asthApayan|</para>
  <para style="p">
    <verse number="30" style="v"/>atha preShitA yIshoH sannidhau militA yad yach chakruH shikShayAmAsushcha tatsarvvavArttAstasmai kathitavantaH|</para>
  <para style="p">
    <verse number="31" style="v"/>sa tAnuvAcha yUyaM vijanasthAnaM gatvA vishrAmyata yatastatsannidhau bahulokAnAM samAgamAt te bhoktuM nAvakAshaM prAptAH|</para>
  <para style="p">
    <verse number="32" style="v"/>tataste nAvA vijanasthAnaM guptaM gagmuH|</para>
  <para style="p">
    <verse number="33" style="v"/>tato lokanivahasteShAM sthAnAntarayAnaM dadarsha, aneke taM parichitya nAnApurebhyaH padairvrajitvA javena taiShAmagre yIshoH samIpa upatasthuH|</para>
  <para style="p">
    <verse number="34" style="v"/>tadA yIshu rnAvo bahirgatya lokAraNyAnIM dR^iShTvA teShu karuNAM kR^itavAn yataste.arakShakameShA ivAsan tadA sa tAna nAnAprasa NgAn upadiShTavAn|</para>
  <para style="p">
    <verse number="35" style="v"/>atha divAnte sati shiShyA etya yIshumUchire, idaM vijanasthAnaM dina nchAvasannaM|</para>
  <para style="p">
    <verse number="36" style="v"/>lokAnAM kimapi khAdyaM nAsti, atashchaturdikShu grAmAn gantuM bhojyadravyANi kretu ncha bhavAn tAn visR^ijatu|</para>
  <para style="p">
    <verse number="37" style="v"/>tadA sa tAnuvAcha yUyameva tAn bhojayata; tataste jagadu rvayaM gatvA dvishatasaMkhyakai rmudrApAdaiH pUpAn krItvA kiM tAn bhojayiShyAmaH?</para>
  <para style="p">
    <verse number="38" style="v"/>tadA sa tAn pR^iShThavAn yuShmAkaM sannidhau kati pUpA Asate? gatvA pashyata; tataste dR^iShTvA tamavadan pa ncha pUpA dvau matsyau cha santi|</para>
  <para style="p">
    <verse number="39" style="v"/>tadA sa lokAn shaspopari paMktibhirupaveshayitum AdiShTavAn,</para>
  <para style="p">
    <verse number="40" style="v"/>tataste shataM shataM janAH pa nchAshat pa nchAshajjanAshcha paMktibhi rbhuvi samupavivishuH|</para>
  <para style="p">
    <verse number="41" style="v"/>atha sa tAn pa nchapUpAn matsyadvaya ncha dhR^itvA svargaM pashyan IshvaraguNAn anvakIrttayat tAn pUpAn bhaMktvA lokebhyaH pariveShayituM shiShyebhyo dattavAn dvA matsyau cha vibhajya sarvvebhyo dattavAn|</para>
  <para style="p">
    <verse number="42" style="v"/>tataH sarvve bhuktvAtR^ipyan|</para>
  <para style="p">
    <verse number="43" style="v"/>anantaraM shiShyA avashiShTaiH pUpai rmatsyaishcha pUrNAn dvadasha DallakAn jagR^ihuH|</para>
  <para style="p">
    <verse number="44" style="v"/>te bhoktAraH prAyaH pa ncha sahasrANi puruShA Asan|</para>
  <para style="p">
    <verse number="45" style="v"/>atha sa lokAn visR^ijanneva nAvamAroDhuM svasmAdagre pAre baitsaidApuraM yAtu ncha shShyiाn vADhamAdiShTavAn|</para>
  <para style="p">
    <verse number="46" style="v"/>tadA sa sarvvAn visR^ijya prArthayituM parvvataM gataH|</para>
  <para style="p">
    <verse number="47" style="v"/>tataH sandhyAyAM satyAM nauH sindhumadhya upasthitA kintu sa ekAkI sthale sthitaH|</para>
  <para style="p">
    <verse number="48" style="v"/>atha sammukhavAtavahanAt shiShyA nAvaM vAhayitvA parishrAntA iti j nAtvA sa nishAchaturthayAme sindhUpari padbhyAM vrajan teShAM samIpametya teShAmagre yAtum udyataH|</para>
  <para style="p">
    <verse number="49" style="v"/>kintu shiShyAH sindhUpari taM vrajantaM dR^iShTvA bhUtamanumAya ruruvuH,</para>
  <para style="p">
    <verse number="50" style="v"/>yataH sarvve taM dR^iShTvA vyAkulitAH| ataeva yIshustatkShaNaM taiH sahAlapya kathitavAn, susthirA bhUta, ayamahaM mA bhaiShTa|</para>
  <para style="p">
    <verse number="51" style="v"/>atha naukAmAruhya tasmin teShAM sannidhiM gate vAto nivR^ittaH; tasmAtte manaHsu vismitA AshcharyyaM menire|</para>
  <para style="p">
    <verse number="52" style="v"/>yataste manasAM kAThinyAt tat pUpIyam AshcharyyaM karmma na viviktavantaH|</para>
  <para style="p">
    <verse number="53" style="v"/>atha te pAraM gatvA gineSharatpradeshametya taTa upasthitAH|</para>
  <para style="p">
    <verse number="54" style="v"/>teShu naukAto bahirgateShu tatpradeshIyA lokAstaM parichitya</para>
  <para style="p">
    <verse number="55" style="v"/>chaturdikShu dhAvanto yatra yatra rogiNo narA Asan tAn sarvvAna khaTvopari nidhAya yatra kutrachit tadvArttAM prApuH tat sthAnam Anetum Arebhire|</para>
  <para style="p">
    <verse number="56" style="v"/>tathA yatra yatra grAme yatra yatra pure yatra yatra pallyA ncha tena praveshaH kR^itastadvartmamadhye lokAH pIDitAn sthApayitvA tasya chelagranthimAtraM spraShTum teShAmarthe tadanuj nAM prArthayantaH yAvanto lokAH paspR^ishustAvanta eva gadAnmuktAH|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM yirUshAlama AgatAH phirUshino.adhyApakAshcha yIshoH samIpam AgatAH|</para>
  <para style="p">
    <verse number="2" style="v"/>te tasya kiyataH shiShyAn ashuchikarairarthAda aprakShAlitahastai rbhu njato dR^iShTvA tAnadUShayan|</para>
  <para style="p">
    <verse number="3" style="v"/>yataH phirUshinaH sarvvayihUdIyAshcha prAchAM paramparAgatavAkyaM sammanya pratalena hastAn aprakShAlya na bhu njate|</para>
  <para style="p">
    <verse number="4" style="v"/>ApanAdAgatya majjanaM vinA na khAdanti; tathA pAnapAtrANAM jalapAtrANAM pittalapAtrANAm AsanAnA ncha jale majjanam ityAdayonyepi bahavasteShAmAchArAH santi|</para>
  <para style="p">
    <verse number="5" style="v"/>te phirUshino.adhyApakAshcha yIshuM paprachChuH, tava shiShyAH prAchAM paramparAgatavAkyAnusAreNa nAcharanto.aprakShAlitakaraiH kuto bhujaMte?</para>
  <para style="p">
    <verse number="6" style="v"/>tataH sa pratyuvAcha kapaTino yuShmAn uddishya yishayiyabhaviShyadvAdI yuktamavAdIt| yathA svakIyairadharairete sammanyanate sadaiva mAM| kintu matto viprakarShe santi teShAM manAMsi cha|</para>
  <para style="p">
    <verse number="7" style="v"/>shikShayanto bidhIn nnAj nA bhajante mAM mudhaiva te|</para>
  <para style="p">
    <verse number="8" style="v"/>yUyaM jalapAtrapAnapAtrAdIni majjayanto manujaparamparAgatavAkyaM rakShatha kintu IshvarAj nAM laMghadhve; aparA IdR^ishyonekAH kriyA api kurudhve|</para>
  <para style="p">
    <verse number="9" style="v"/>anya nchAkathayat yUyaM svaparamparAgatavAkyasya rakShArthaM spaShTarUpeNa IshvarAj nAM lopayatha|</para>
  <para style="p">
    <verse number="10" style="v"/>yato mUsAdvArA proktamasti svapitarau sammanyadhvaM yastu mAtaraM pitaraM vA durvvAkyaM vakti sa nitAntaM hanyatAM|</para>
  <para style="p">
    <verse number="11" style="v"/>kintu madIyena yena dravyeNa tavopakArobhavat tat karbbANamarthAd IshvarAya niveditam idaM vAkyaM yadi kopi pitaraM mAtaraM vA vakti</para>
  <para style="p">
    <verse number="12" style="v"/>tarhi yUyaM mAtuH pitu rvopakAraM karttAM taM vArayatha|</para>
  <para style="p">
    <verse number="13" style="v"/>itthaM svaprachAritaparamparAgatavAkyena yUyam IshvarAj nAM mudhA vidhadvve, IdR^ishAnyanyAnyanekAni karmmANi kurudhve|</para>
  <para style="p">
    <verse number="14" style="v"/>atha sa lokAnAhUya babhAShe yUyaM sarvve madvAkyaM shR^iNuta budhyadhva ncha|</para>
  <para style="p">
    <verse number="15" style="v"/>bAhyAdantaraM pravishya naramamedhyaM karttAM shaknoti IdR^ishaM kimapi vastu nAsti, varam antarAd bahirgataM yadvastu tanmanujam amedhyaM karoti|</para>
  <para style="p">
    <verse number="16" style="v"/>yasya shrotuM shrotre staH sa shR^iNotu|</para>
  <para style="p">
    <verse number="17" style="v"/>tataH sa lokAn hitvA gR^ihamadhyaM praviShTastadA shiShyAstadR^iShTAntavAkyArthaM paprachChuH|</para>
  <para style="p">
    <verse number="18" style="v"/>tasmAt sa tAn jagAda yUyamapi kimetAdR^igabodhAH? kimapi dravyaM bAhyAdantaraM pravishya naramamedhyaM karttAM na shaknoti kathAmimAM kiM na budhyadhve?</para>
  <para style="p">
    <verse number="19" style="v"/>tat tadantarna pravishati kintu kukShimadhyaM pravishati sheShe sarvvabhuktavastugrAhiNi bahirdeshe niryAti|</para>
  <para style="p">
    <verse number="20" style="v"/>aparamapyavAdId yannarAnnireti tadeva naramamedhyaM karoti|</para>
  <para style="p">
    <verse number="21" style="v"/>yato.antarAd arthAn mAnavAnAM manobhyaH kuchintA parastrIveshyAgamanaM</para>
  <para style="p">
    <verse number="22" style="v"/>naravadhashchauryyaM lobho duShTatA prava nchanA kAmukatA kudR^iShTirIshvaranindA garvvastama ityAdIni nirgachChanti|</para>
  <para style="p">
    <verse number="23" style="v"/>etAni sarvvANi duritAnyantarAdetya naramamedhyaM kurvvanti|</para>
  <para style="p">
    <verse number="24" style="v"/>atha sa utthAya tatsthAnAt sorasIdonpurapradeshaM jagAma tatra kimapi niveshanaM pravishya sarvvairaj nAtaH sthAtuM mati nchakre kintu guptaH sthAtuM na shashAka|</para>
  <para style="p">
    <verse number="25" style="v"/>yataH suraphainikIdeshIyayUnAnIvaMshodbhavastriyAH kanyA bhUtagrastAsIt| sA strI tadvArttAM prApya tatsamIpamAgatya tachcharaNayoH patitvA</para>
  <para style="p">
    <verse number="26" style="v"/>svakanyAto bhUtaM nirAkarttAM tasmin vinayaM kR^itavatI|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu yIshustAmavadat prathamaM bAlakAstR^ipyantu yato bAlakAnAM khAdyaM gR^ihItvA kukkurebhyo nikShepo.anuchitaH|</para>
  <para style="p">
    <verse number="28" style="v"/>tadA sA strI tamavAdIt bhoH prabho tat satyaM tathApi ma nchAdhaHsthAH kukkurA bAlAnAM karapatitAni khAdyakhaNDAni khAdanti|</para>
  <para style="p">
    <verse number="29" style="v"/>tataH so.akathayad etatkathAhetoH sakushalA yAhi tava kanyAM tyaktvA bhUto gataH|</para>
  <para style="p">
    <verse number="30" style="v"/>atha sA strI gR^ihaM gatvA kanyAM bhUtatyaktAM shayyAsthitAM dadarsha|</para>
  <para style="p">
    <verse number="31" style="v"/>punashcha sa sorasIdonpurapradeshAt prasthAya dikApalideshasya prAntarabhAgena gAlIljaladheH samIpaM gatavAn|</para>
  <para style="p">
    <verse number="32" style="v"/>tadA lokairekaM badhiraM kadvada ncha naraM tannikaTamAnIya tasya gAtre hastamarpayituM vinayaH kR^itaH|</para>
  <para style="p">
    <verse number="33" style="v"/>tato yIshu rlokAraNyAt taM nirjanamAnIya tasya karNayo NgulI rdadau niShThIvaM dattvA cha tajjihvAM pasparsha|</para>
  <para style="p">
    <verse number="34" style="v"/>anantaraM svargaM nirIkShya dIrghaM nishvasya tamavadat itaphataH arthAn mukto bhUyAt|</para>
  <para style="p">
    <verse number="35" style="v"/>tatastatkShaNaM tasya karNau muktau jihvAyAshcha jADyApagamAt sa suspaShTavAkyamakathayat|</para>
  <para style="p">
    <verse number="36" style="v"/>atha sa tAn vADhamityAdidesha yUyamimAM kathAM kasmaichidapi mA kathayata, kintu sa yati nyaShedhat te tati bAhulyena prAchArayan;</para>
  <para style="p">
    <verse number="37" style="v"/>te.atichamatkR^itya parasparaM kathayAmAsuH sa badhirAya shravaNashaktiM mUkAya cha kathanashaktiM dattvA sarvvaM karmmottamarUpeNa chakAra|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadA tatsamIpaM bahavo lokA AyAtA atasteShAM bhojyadravyAbhAvAd yIshuH shiShyAnAhUya jagAda,|</para>
  <para style="p">
    <verse number="2" style="v"/>lokanivahe mama kR^ipA jAyate te dinatrayaM mayA sArddhaM santi teShAM bhojyaM kimapi nAsti|</para>
  <para style="p">
    <verse number="3" style="v"/>teShAM madhye.aneke dUrAd AgatAH, abhukteShu teShu mayA svagR^ihamabhiprahiteShu te pathi klamiShyanti|</para>
  <para style="p">
    <verse number="4" style="v"/>shiShyA avAdiShuH, etAvato lokAn tarpayitum atra prantare pUpAn prAptuM kena shakyate?</para>
  <para style="p">
    <verse number="5" style="v"/>tataH sa tAn paprachCha yuShmAkaM kati pUpAH santi? te.akathayan sapta|</para>
  <para style="p">
    <verse number="6" style="v"/>tataH sa tAllokAn bhuvi samupaveShTum Adishya tAn sapta pUpAn dhR^itvA IshvaraguNAn anukIrttayAmAsa, bhaMktvA pariveShayituM shiShyAn prati dadau, tataste lokebhyaH pariveShayAmAsuH|</para>
  <para style="p">
    <verse number="7" style="v"/>tathA teShAM samIpe ye kShudramatsyA Asan tAnapyAdAya IshvaraguNAn saMkIrtya pariveShayitum AdiShTavAn|</para>
  <para style="p">
    <verse number="8" style="v"/>tato lokA bhuktvA tR^iptiM gatA avashiShTakhAdyaiH pUrNAH saptaDallakA gR^ihItAshcha|</para>
  <para style="p">
    <verse number="9" style="v"/>ete bhoktAraH prAyashchatuH sahasrapuruShA Asan tataH sa tAn visasarja|</para>
  <para style="p">
    <verse number="10" style="v"/>atha sa shiShyaH saha nAvamAruhya dalmAnUthAsImAmAgataH|</para>
  <para style="p">
    <verse number="11" style="v"/>tataH paraM phirUshina Agatya tena saha vivadamAnAstasya parIkShArtham AkAshIyachihnaM draShTuM yAchitavantaH|</para>
  <para style="p">
    <verse number="12" style="v"/>tadA so.antardIrghaM nishvasyAkathayat, ete vidyamAnanarAH kutashchinhaM mR^igayante? yuShmAnahaM yathArthaM bravImi lokAnetAn kimapi chihnaM na darshayiShyate|</para>
  <para style="p">
    <verse number="13" style="v"/>atha tAn hitvA puna rnAvam Aruhya pAramagAt|</para>
  <para style="p">
    <verse number="14" style="v"/>etarhi shiShyaiH pUpeShu vismR^iteShu nAvi teShAM sannidhau pUpa ekaeva sthitaH|</para>
  <para style="p">
    <verse number="15" style="v"/>tadAnIM yIshustAn AdiShTavAn phirUshinAM herodashcha kiNvaM prati satarkAH sAvadhAnAshcha bhavata|</para>
  <para style="p">
    <verse number="16" style="v"/>tataste.anyonyaM vivechanaM kartum Arebhire, asmAkaM sannidhau pUpo nAstIti hetoridaM kathayati|</para>
  <para style="p">
    <verse number="17" style="v"/>tad budvvA yIshustebhyo.akathayat yuShmAkaM sthAne pUpAbhAvAt kuta itthaM vitarkayatha? yUyaM kimadyApi kimapi na jAnItha? boddhu ncha na shaknutha? yAvadadya kiM yuShmAkaM manAMsi kaThinAni santi?</para>
  <para style="p">
    <verse number="18" style="v"/>satsu netreShu kiM na pashyatha? satsu karNeShu kiM na shR^iNutha? na smaratha cha?</para>
  <para style="p">
    <verse number="19" style="v"/>yadAhaM pa nchapUpAn pa nchasahasrANAM puruShANAM madhye bhaMktvA dattavAn tadAnIM yUyam avashiShTapUpaiH pUrNAn kati DallakAn gR^ihItavantaH? te.akathayan dvAdashaDallakAn|</para>
  <para style="p">
    <verse number="20" style="v"/>apara ncha yadA chatuHsahasrANAM puruShANAM madhye pUpAn bhaMktvAdadAM tadA yUyam atiriktapUpAnAM kati DallakAn gR^ihItavantaH? te kathayAmAsuH saptaDallakAn|</para>
  <para style="p">
    <verse number="21" style="v"/>tadA sa kathitavAn tarhi yUyam adhunApi kuto bodvvuM na shaknutha?</para>
  <para style="p">
    <verse number="22" style="v"/>anantaraM tasmin baitsaidAnagare prApte lokA andhamekaM naraM tatsamIpamAnIya taM spraShTuM taM prArthayA nchakrire|</para>
  <para style="p">
    <verse number="23" style="v"/>tadA tasyAndhasya karau gR^ihItvA nagarAd bahirdeshaM taM nItavAn; tannetre niShThIvaM dattvA tadgAtre hastAvarpayitvA taM paprachCha, kimapi pashyasi?</para>
  <para style="p">
    <verse number="24" style="v"/>sa netre unmIlya jagAda, vR^ikShavat manujAn gachChato nirIkShe|</para>
  <para style="p">
    <verse number="25" style="v"/>tato yIshuH punastasya nayanayo rhastAvarpayitvA tasya netre unmIlayAmAsa; tasmAt sa svastho bhUtvA spaShTarUpaM sarvvalokAn dadarsha|</para>
  <para style="p">
    <verse number="26" style="v"/>tataH paraM tvaM grAmaM mA gachCha grAmasthaM kamapi cha kimapyanuktvA nijagR^ihaM yAhItyAdishya yIshustaM nijagR^ihaM prahitavAn|</para>
  <para style="p">
    <verse number="27" style="v"/>anantaraM shiShyaiH sahito yIshuH kaisarIyAphilipipuraM jagAma, pathi gachChan tAnapR^ichChat ko.aham atra lokAH kiM vadanti?</para>
  <para style="p">
    <verse number="28" style="v"/>te pratyUchuH tvAM yohanaM majjakaM vadanti kintu kepi kepi eliyaM vadanti; apare kepi kepi bhaviShyadvAdinAm eko jana iti vadanti|</para>
  <para style="p">
    <verse number="29" style="v"/>atha sa tAnapR^ichChat kintu koham? ityatra yUyaM kiM vadatha? tadA pitaraH pratyavadat bhavAn abhiShiktastrAtA|</para>
  <para style="p">
    <verse number="30" style="v"/>tataH sa tAn gADhamAdishad yUyaM mama kathA kasmaichidapi mA kathayata|</para>
  <para style="p">
    <verse number="31" style="v"/>manuShyaputreNAvashyaM bahavo yAtanA bhoktavyAH prAchInalokaiH pradhAnayAjakairadhyApakaishcha sa ninditaH san ghAtayiShyate tR^itIyadine utthAsyati cha, yIshuH shiShyAnupadeShTumArabhya kathAmimAM spaShTamAchaShTa|</para>
  <para style="p">
    <verse number="32" style="v"/>tasmAt pitarastasya hastau dhR^itvA taM tarjjitavAn|</para>
  <para style="p">
    <verse number="33" style="v"/>kintu sa mukhaM parAvartya shiShyagaNaM nirIkShya pitaraM tarjayitvAvAdId dUrIbhava vighnakArin IshvarIyakAryyAdapi manuShyakAryyaM tubhyaM rochatatarAM|</para>
  <para style="p">
    <verse number="34" style="v"/>atha sa lokAn shiShyAMshchAhUya jagAda yaH kashchin mAmanugantum ichChati sa AtmAnaM dAmyatu, svakrushaM gR^ihItvA matpashchAd AyAtu|</para>
  <para style="p">
    <verse number="35" style="v"/>yato yaH kashchit svaprANaM rakShitumichChati sa taM hArayiShyati, kintu yaH kashchin madarthaM susaMvAdArtha ncha prANaM hArayati sa taM rakShiShyati|</para>
  <para style="p">
    <verse number="36" style="v"/>apara ncha manujaH sarvvaM jagat prApya yadi svaprANaM hArayati tarhi tasya ko lAbhaH?</para>
  <para style="p">
    <verse number="37" style="v"/>naraH svaprANavinimayena kiM dAtuM shaknoti?</para>
  <para style="p">
    <verse number="38" style="v"/>eteShAM vyabhichAriNAM pApinA ncha lokAnAM sAkShAd yadi kopi mAM matkathA ncha lajjAspadaM jAnAti tarhi manujaputro yadA dharmmadUtaiH saha pituH prabhAveNAgamiShyati tadA sopi taM lajjAspadaM j nAsyati|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha sa tAnavAdIt yuShmabhyamahaM yathArthaM kathayAmi, IshvararAjyaM parAkrameNopasthitaM na dR^iShTvA mR^ityuM nAsvAdiShyante, atra daNDAyamAnAnAM madhyepi tAdR^ishA lokAH santi|</para>
  <para style="p">
    <verse number="2" style="v"/>atha ShaDdinebhyaH paraM yIshuH pitaraM yAkUbaM yohana ncha gR^ihItvA gireruchchasya nirjanasthAnaM gatvA teShAM pratyakShe mUrtyantaraM dadhAra|</para>
  <para style="p">
    <verse number="3" style="v"/>tatastasya paridheyam IdR^isham ujjvalahimapANaDaraM jAtaM yad jagati kopi rajako na tAdR^ik pANaDaraM karttAM shaknoti|</para>
  <para style="p">
    <verse number="4" style="v"/>apara ncha eliyo mUsAshcha tebhyo darshanaM dattvA yIshunA saha kathanaM karttumArebhAte|</para>
  <para style="p">
    <verse number="5" style="v"/>tadA pitaro yIshumavAdIt he guro.asmAkamatra sthitiruttamA, tataeva vayaM tvatkR^ite ekAM mUsAkR^ite ekAm eliyakR^ite chaikAM, etAstisraH kuTI rnirmmAma|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu sa yaduktavAn tat svayaM na bubudhe tataH sarvve bibhayA nchakruH|</para>
  <para style="p">
    <verse number="7" style="v"/>etarhi payodastAn ChAdayAmAsa, mamayAM priyaH putraH kathAsu tasya manAMsi niveshayateti nabhovANI tanmedyAnniryayau|</para>
  <para style="p">
    <verse number="8" style="v"/>atha haThAtte chaturdisho dR^iShTvA yIshuM vinA svaiH sahitaM kamapi na dadR^ishuH|</para>
  <para style="p">
    <verse number="9" style="v"/>tataH paraM gireravarohaNakAle sa tAn gADham dUtyAdidesha yAvannarasUnoH shmashAnAdutthAnaM na bhavati, tAvat darshanasyAsya vArttA yuShmAbhiH kasmaichidapi na vaktavyA|</para>
  <para style="p">
    <verse number="10" style="v"/>tadA shmashAnAdutthAnasya kobhiprAya iti vichAryya te tadvAkyaM sveShu gopAyA nchakrire|</para>
  <para style="p">
    <verse number="11" style="v"/>atha te yIshuM paprachChuH prathamata eliyenAgantavyam iti vAkyaM kuta upAdhyAyA AhuH?</para>
  <para style="p">
    <verse number="12" style="v"/>tadA sa pratyuvAcha , eliyaH prathamametya sarvvakAryyANi sAdhayiShyati; naraputre cha lipi ryathAste tathaiva sopi bahuduHkhaM prApyAvaj nAsyate|</para>
  <para style="p">
    <verse number="13" style="v"/>kintvahaM yuShmAn vadAmi , eliyArthe lipi ryathAste tathaiva sa etya yayau, lokA: svechChAnurUpaM tamabhivyavaharanti sma|</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraM sa shiShyasamIpametya teShAM chatuHpArshve taiH saha bahujanAn vivadamAnAn adhyApakAMshcha dR^iShTavAn;</para>
  <para style="p">
    <verse number="15" style="v"/>kintu sarvvalokAstaM dR^iShTvaiva chamatkR^itya tadAsannaM dhAvantastaM praNemuH|</para>
  <para style="p">
    <verse number="16" style="v"/>tadA yIshuradhyApakAnaprAkShId etaiH saha yUyaM kiM vivadadhve?</para>
  <para style="p">
    <verse number="17" style="v"/>tato lokAnAM kashchidekaH pratyavAdIt he guro mama sUnuM mUkaM bhUtadhR^ita ncha bhavadAsannam AnayaM|</para>
  <para style="p">
    <verse number="18" style="v"/>yadAsau bhUtastamAkramate tadaiva pAtasati tathA sa pheNAyate, dantairdantAn gharShati kShINo bhavati cha; tato hetostaM bhUtaM tyAjayituM bhavachChiShyAn niveditavAn kintu te na shekuH|</para>
  <para style="p">
    <verse number="19" style="v"/>tadA sa tamavAdIt, re avishvAsinaH santAnA yuShmAbhiH saha kati kAlAnahaM sthAsyAmi? aparAn kati kAlAn vA va AchArAn sahiShye? taM madAsannamAnayata|</para>
  <para style="p">
    <verse number="20" style="v"/>tatastatsannidhiM sa AnIyata kintu taM dR^iShTvaiva bhUto bAlakaM dhR^itavAn; sa cha bhUmau patitvA pheNAyamAno luloTha|</para>
  <para style="p">
    <verse number="21" style="v"/>tadA sa tatpitaraM paprachCha, asyedR^ishI dashA kati dinAni bhUtA? tataH sovAdIt bAlyakAlAt|</para>
  <para style="p">
    <verse number="22" style="v"/>bhUtoyaM taM nAshayituM bahuvArAn vahnau jale cha nyakShipat kintu yadi bhavAna kimapi karttAM shaknoti tarhi dayAM kR^itvAsmAn upakarotu|</para>
  <para style="p">
    <verse number="23" style="v"/>tadA yIshustamavadat yadi pratyetuM shaknoShi tarhi pratyayine janAya sarvvaM sAdhyam|</para>
  <para style="p">
    <verse number="24" style="v"/>tatastatkShaNaM tadbAlakasya pitA prochchai rUvan sAshrunetraH provAcha, prabho pratyemi mamApratyayaM pratikuru|</para>
  <para style="p">
    <verse number="25" style="v"/>atha yIshu rlokasa NghaM dhAvitvAyAntaM dR^iShTvA tamapUtabhUtaM tarjayitvA jagAda, re badhira mUka bhUta tvametasmAd bahirbhava punaH kadApi mAshrayainaM tvAmaham ityAdishAmi|</para>
  <para style="p">
    <verse number="26" style="v"/>tadA sa bhUtashchItshabdaM kR^itvA tamApIDya bahirjajAma, tato bAlako mR^itakalpo babhUva tasmAdayaM mR^ita_ityaneke kathayAmAsuH|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu karaM dhR^itvA yIshunotthApitaH sa uttasthau|</para>
  <para style="p">
    <verse number="28" style="v"/>atha yIshau gR^ihaM praviShTe shiShyA guptaM taM paprachChuH, vayamenaM bhUtaM tyAjayituM kuto na shaktAH?</para>
  <para style="p">
    <verse number="29" style="v"/>sa uvAcha, prArthanopavAsau vinA kenApyanyena karmmaNA bhUtamIdR^ishaM tyAjayituM na shakyaM|</para>
  <para style="p">
    <verse number="30" style="v"/>anantaraM sa tatsthAnAditvA gAlIlmadhyena yayau, kintu tat kopi jAnIyAditi sa naichChat|</para>
  <para style="p">
    <verse number="31" style="v"/>apara ncha sa shiShyAnupadishan babhAShe, naraputro narahasteShu samarpayiShyate te cha taM haniShyanti taistasmin hate tR^itIyadine sa utthAsyatIti|</para>
  <para style="p">
    <verse number="32" style="v"/>kintu tatkathAM te nAbudhyanta praShTu ncha bibhyaH|</para>
  <para style="p">
    <verse number="33" style="v"/>atha yIshuH kapharnAhUmpuramAgatya madhyegR^iha nchetya tAnapR^ichChad vartmamadhye yUyamanyonyaM kiM vivadadhve sma?</para>
  <para style="p">
    <verse number="34" style="v"/>kintu te niruttarAstasthu ryasmAtteShAM ko mukhya iti vartmAni te.anyonyaM vyavadanta|</para>
  <para style="p">
    <verse number="35" style="v"/>tataH sa upavishya dvAdashashiShyAn AhUya babhAShe yaH kashchit mukhyo bhavitumichChati sa sarvvebhyo gauNaH sarvveShAM sevakashcha bhavatu|</para>
  <para style="p">
    <verse number="36" style="v"/>tadA sa bAlakamekaM gR^ihItvA madhye samupAveshayat tatastaM kroDe kR^itvA tAnavAdAt</para>
  <para style="p">
    <verse number="37" style="v"/>yaH kashchidIdR^ishasya kasyApi bAlasyAtithyaM karoti sa mamAtithyaM karoti; yaH kashchinmamAtithyaM karoti sa kevalam mamAtithyaM karoti tanna matprerakasyApyAtithyaM karoti|</para>
  <para style="p">
    <verse number="38" style="v"/>atha yohan tamabravIt he guro, asmAkamananugAminam ekaM tvAnnAmnA bhUtAn tyAjayantaM vayaM dR^iShTavantaH, asmAkamapashchAdgAmitvAchcha taM nyaShedhAma|</para>
  <para style="p">
    <verse number="39" style="v"/>kintu yIshuravadat taM mA niShedhat, yato yaH kashchin mannAmnA chitraM karmma karoti sa sahasA mAM nindituM na shaknoti|</para>
  <para style="p">
    <verse number="40" style="v"/>tathA yaH kashchid yuShmAkaM vipakShatAM na karoti sa yuShmAkameva sapakShaH|</para>
  <para style="p">
    <verse number="41" style="v"/>yaH kashchid yuShmAn khrIShTashiShyAn j nAtvA mannAmnA kaMsaikena pAnIyaM pAtuM dadAti, yuShmAnahaM yathArthaM vachmi, sa phalena va nchito na bhaviShyati|</para>
  <para style="p">
    <verse number="42" style="v"/>kintu yadi kashchin mayi vishvAsinAmeShAM kShudraprANinAm ekasyApi vighnaM janayati, tarhi tasyaitatkarmma karaNAt kaNThabaddhapeShaNIkasya tasya sAgarAgAdhajala majjanaM bhadraM|</para>
  <para style="p">
    <verse number="43" style="v"/>ataH svakaro yadi tvAM bAdhate tarhi taM Chindhi;</para>
  <para style="p">
    <verse number="44" style="v"/>yasmAt yatra kITA na mriyante vahnishcha na nirvvAti, tasmin anirvvANAnalanarake karadvayavastava gamanAt karahInasya svargapraveshastava kShemaM|</para>
  <para style="p">
    <verse number="45" style="v"/>yadi tava pAdo vighnaM janayati tarhi taM Chindhi,</para>
  <para style="p">
    <verse number="46" style="v"/>yato yatra kITA na mriyante vahnishcha na nirvvAti, tasmin .anirvvANavahnau narake dvipAdavatastava nikShepAt pAdahInasya svargapraveshastava kShemaM|</para>
  <para style="p">
    <verse number="47" style="v"/>svanetraM yadi tvAM bAdhate tarhi tadapyutpATaya, yato yatra kITA na mriyante vahnishcha na nirvvAti,</para>
  <para style="p">
    <verse number="48" style="v"/>tasmina .anirvvANavahnau narake dvinetrasya tava nikShepAd ekanetravata IshvararAjye praveshastava kShemaM|</para>
  <para style="p">
    <verse number="49" style="v"/>yathA sarvvo bali rlavaNAktaH kriyate tathA sarvvo jano vahnirUpeNa lavaNAktaH kAriShyate|</para>
  <para style="p">
    <verse number="50" style="v"/>lavaNaM bhadraM kintu yadi lavaNe svAdutA na tiShThati, tarhi katham AsvAdyuktaM kariShyatha? yUyaM lavaNayuktA bhavata parasparaM prema kuruta|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM sa tatsthAnAt prasthAya yarddananadyAH pAre yihUdApradesha upasthitavAn, tatra tadantike lokAnAM samAgame jAte sa nijarItyanusAreNa punastAn upadidesha|</para>
  <para style="p">
    <verse number="2" style="v"/>tadA phirUshinastatsamIpam etya taM parIkShituM paprachChaH svajAyA manujAnAM tyajyA na veti?</para>
  <para style="p">
    <verse number="3" style="v"/>tataH sa pratyavAdIt, atra kAryye mUsA yuShmAn prati kimAj nApayat?</para>
  <para style="p">
    <verse number="4" style="v"/>ta UchuH tyAgapatraM lekhituM svapatnIM tyaktu ncha mUsA.anumanyate|</para>
  <para style="p">
    <verse number="5" style="v"/>tadA yIshuH pratyuvAcha, yuShmAkaM manasAM kAThinyAddheto rmUsA nideshamimam alikhat|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu sR^iShTerAdau Ishvaro narAn puMrUpeNa strIrUpeNa cha sasarja|</para>
  <para style="p">
    <verse number="7" style="v"/>"tataH kAraNAt pumAn pitaraM mAtara ncha tyaktvA svajAyAyAm Asakto bhaviShyati,</para>
  <para style="p">
    <verse number="8" style="v"/>tau dvAv ekA Ngau bhaviShyataH|" tasmAt tatkAlamArabhya tau na dvAv ekA Ngau|</para>
  <para style="p">
    <verse number="9" style="v"/>ataH kAraNAd Ishvaro yadayojayat kopi narastanna viyejayet|</para>
  <para style="p">
    <verse number="10" style="v"/>atha yIshu rgR^ihaM praviShTastadA shiShyAH punastatkathAM taM paprachChuH|</para>
  <para style="p">
    <verse number="11" style="v"/>tataH sovadat kashchid yadi svabhAryyAM tyaktavAnyAm udvahati tarhi sa svabhAryyAyAH prAtikUlyena vyabhichArI bhavati|</para>
  <para style="p">
    <verse number="12" style="v"/>kAchinnArI yadi svapatiM hitvAnyapuMsA vivAhitA bhavati tarhi sApi vyabhichAriNI bhavati|</para>
  <para style="p">
    <verse number="13" style="v"/>atha sa yathA shishUn spR^ishet, tadarthaM lokaistadantikaM shishava AnIyanta, kintu shiShyAstAnAnItavatastarjayAmAsuH|</para>
  <para style="p">
    <verse number="14" style="v"/>yIshustad dR^iShTvA krudhyan jagAda, mannikaTam AgantuM shishUn mA vArayata, yata etAdR^ishA IshvararAjyAdhikAriNaH|</para>
  <para style="p">
    <verse number="15" style="v"/>yuShmAnahaM yathArthaM vachmi, yaH kashchit shishuvad bhUtvA rAjyamIshvarasya na gR^ihlIyAt sa kadApi tadrAjyaM praveShTuM na shaknoti|</para>
  <para style="p">
    <verse number="16" style="v"/>ananataraM sa shishUna Nke nidhAya teShAM gAtreShu hastau dattvAshiShaM babhAShe|</para>
  <para style="p">
    <verse number="17" style="v"/>atha sa vartmanA yAti, etarhi jana eko dhAvan Agatya tatsammukhe jAnunI pAtayitvA pR^iShTavAn, bhoH paramaguro, anantAyuH prAptaye mayA kiM karttavyaM?</para>
  <para style="p">
    <verse number="18" style="v"/>tadA yIshuruvAcha, mAM paramaM kuto vadasi? vineshvaraM kopi paramo na bhavati|</para>
  <para style="p">
    <verse number="19" style="v"/>parastrIM nAbhigachCha; naraM mA ghAtaya; steyaM mA kuru; mR^iShAsAkShyaM mA dehi; hiMsA ncha mA kuru; pitarau sammanyasva; nideshA ete tvayA j nAtAH|</para>
  <para style="p">
    <verse number="20" style="v"/>tatastana pratyuktaM, he guro bAlyakAlAdahaM sarvvAnetAn AcharAmi|</para>
  <para style="p">
    <verse number="21" style="v"/>tadA yIshustaM vilokya snehena babhAShe, tavaikasyAbhAva Aste; tvaM gatvA sarvvasvaM vikrIya daridrebhyo vishrANaya, tataH svarge dhanaM prApsyasi; tataH param etya krushaM vahan madanuvarttI bhava|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu tasya bahusampadvidyamAnatvAt sa imAM kathAmAkarNya viShaNo duHkhitashcha san jagAma|</para>
  <para style="p">
    <verse number="23" style="v"/>atha yIshushchaturdisho nirIkShya shiShyAn avAdIt, dhanilokAnAm IshvararAjyapraveshaH kIdR^ig duShkaraH|</para>
  <para style="p">
    <verse number="24" style="v"/>tasya kathAtaH shiShyAshchamachchakruH, kintu sa punaravadat, he bAlakA ye dhane vishvasanti teShAm IshvararAjyapraveshaH kIdR^ig duShkaraH|</para>
  <para style="p">
    <verse number="25" style="v"/>IshvararAjye dhaninAM praveshAt sUchirandhreNa mahA Ngasya gamanAgamanaM sukaraM|</para>
  <para style="p">
    <verse number="26" style="v"/>tadA shiShyA atIva vismitAH parasparaM prochuH, tarhi kaH paritrANaM prAptuM shaknoti?</para>
  <para style="p">
    <verse number="27" style="v"/>tato yIshustAn vilokya babhAShe, tan narasyAsAdhyaM kintu neshvarasya, yato hetorIshvarasya sarvvaM sAdhyam|</para>
  <para style="p">
    <verse number="28" style="v"/>tadA pitara uvAcha, pashya vayaM sarvvaM parityajya bhavatonugAmino jAtAH|</para>
  <para style="p">
    <verse number="29" style="v"/>tato yIshuH pratyavadat, yuShmAnahaM yathArthaM vadAmi, madarthaM susaMvAdArthaM vA yo janaH sadanaM bhrAtaraM bhaginIM pitaraM mAtaraM jAyAM santAnAn bhUmi vA tyaktvA</para>
  <para style="p">
    <verse number="30" style="v"/>gR^ihabhrAtR^ibhaginIpitR^imAtR^ipatnIsantAnabhUmInAmiha shataguNAn pretyAnantAyushcha na prApnoti tAdR^ishaH kopi nAsti|</para>
  <para style="p">
    <verse number="31" style="v"/>kintvagrIyA aneke lokAH sheShAH, sheShIyA aneke lokAshchAgrA bhaviShyanti|</para>
  <para style="p">
    <verse number="32" style="v"/>atha yirUshAlamyAnakAle yIshusteShAm agragAmI babhUva, tasmAtte chitraM j nAtvA pashchAdgAmino bhUtvA bibhyuH| tadA sa puna rdvAdashashiShyAn gR^ihItvA svIyaM yadyad ghaTiShyate tattat tebhyaH kathayituM prArebhe;</para>
  <para style="p">
    <verse number="33" style="v"/>pashyata vayaM yirUshAlampuraM yAmaH, tatra manuShyaputraH pradhAnayAjakAnAm upAdhyAyAnA ncha kareShu samarpayiShyate; te cha vadhadaNDAj nAM dApayitvA paradeshIyAnAM kareShu taM samarpayiShyanti|</para>
  <para style="p">
    <verse number="34" style="v"/>te tamupahasya kashayA prahR^itya tadvapuShi niShThIvaM nikShipya taM haniShyanti, tataH sa tR^itIyadine protthAsyati|</para>
  <para style="p">
    <verse number="35" style="v"/>tataH sivadeH putrau yAkUbyohanau tadantikam etya prochatuH, he guro yad AvAbhyAM yAchiShyate tadasmadarthaM bhavAn karotu nivedanamidamAvayoH|</para>
  <para style="p">
    <verse number="36" style="v"/>tataH sa kathitavAn, yuvAM kimichChathaH? kiM mayA yuShmadarthaM karaNIyaM?</para>
  <para style="p">
    <verse number="37" style="v"/>tadA tau prochatuH, AvayorekaM dakShiNapArshve vAmapArshve chaikaM tavaishvaryyapade samupaveShTum Aj nApaya|</para>
  <para style="p">
    <verse number="38" style="v"/>kintu yIshuH pratyuvAcha yuvAmaj nAtvedaM prArthayethe, yena kaMsenAhaM pAsyAmi tena yuvAbhyAM kiM pAtuM shakShyate? yasmin majjanenAhaM majjiShye tanmajjane majjayituM kiM yuvAbhyAM shakShyate? tau pratyUchatuH shakShyate|</para>
  <para style="p">
    <verse number="39" style="v"/>tadA yIshuravadat yena kaMsenAhaM pAsyAmi tenAvashyaM yuvAmapi pAsyathaH, yena majjanena chAhaM majjiyye tatra yuvAmapi majjiShyethe|</para>
  <para style="p">
    <verse number="40" style="v"/>kintu yeShAmartham idaM nirUpitaM, tAn vihAyAnyaM kamapi mama dakShiNapArshve vAmapArshve vA samupaveshayituM mamAdhikAro nAsti|</para>
  <para style="p">
    <verse number="41" style="v"/>athAnyadashashiShyA imAM kathAM shrutvA yAkUbyohanbhyAM chukupuH|</para>
  <para style="p">
    <verse number="42" style="v"/>kintu yIshustAn samAhUya babhAShe, anyadeshIyAnAM rAjatvaM ye kurvvanti te teShAmeva prabhutvaM kurvvanti, tathA ye mahAlokAste teShAm adhipatitvaM kurvvantIti yUyaM jAnItha|</para>
  <para style="p">
    <verse number="43" style="v"/>kintu yuShmAkaM madhye na tathA bhaviShyati, yuShmAkaM madhye yaH prAdhAnyaM vA nChati sa yuShmAkaM sevako bhaviShyati,</para>
  <para style="p">
    <verse number="44" style="v"/>yuShmAkaM yo mahAn bhavitumichChati sa sarvveShAM ki Nkaro bhaviShyati|</para>
  <para style="p">
    <verse number="45" style="v"/>yato manuShyaputraH sevyo bhavituM nAgataH sevAM karttAM tathAnekeShAM paritrANasya mUlyarUpasvaprANaM dAtu nchAgataH|</para>
  <para style="p">
    <verse number="46" style="v"/>atha te yirIhonagaraM prAptAstasmAt shiShyai rlokaishcha saha yIsho rgamanakAle TImayasya putro barTImayanAmA andhastanmArgapArshve bhikShArtham upaviShTaH|</para>
  <para style="p">
    <verse number="47" style="v"/>sa nAsaratIyasya yIshorAgamanavArttAM prApya prochai rvaktumArebhe, he yIsho dAyUdaH santAna mAM dayasva|</para>
  <para style="p">
    <verse number="48" style="v"/>tatoneke lokA maunIbhaveti taM tarjayAmAsuH, kintu sa punaradhikamuchchai rjagAda, he yIsho dAyUdaH santAna mAM dayasva|</para>
  <para style="p">
    <verse number="49" style="v"/>tadA yIshuH sthitvA tamAhvAtuM samAdidesha, tato lokAstamandhamAhUya babhAShire, he nara, sthiro bhava, uttiShTha, sa tvAmAhvayati|</para>
  <para style="p">
    <verse number="50" style="v"/>tadA sa uttarIyavastraM nikShipya protthAya yIshoH samIpaM gataH|</para>
  <para style="p">
    <verse number="51" style="v"/>tato yIshustamavadat tvayA kiM prArthyate? tubhyamahaM kiM kariShyAmI? tadA sondhastamuvAcha, he guro madIyA dR^iShTirbhavet|</para>
  <para style="p">
    <verse number="52" style="v"/>tato yIshustamuvAcha yAhi tava vishvAsastvAM svasthamakArShIt, tasmAt tatkShaNaM sa dR^iShTiM prApya pathA yIshoH pashchAd yayau|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM teShu yirUshAlamaH samIpasthayo rbaitphagIbaithanIyapurayorantikasthaM jaitunanAmAdrimAgateShu yIshuH preShaNakAle dvau shiShyAvidaM vAkyaM jagAda,</para>
  <para style="p">
    <verse number="2" style="v"/>yuvAmamuM sammukhasthaM grAmaM yAtaM, tatra pravishya yo naraM nAvahat taM garddabhashAvakaM drakShyathastaM mochayitvAnayataM|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu yuvAM karmmedaM kutaH kuruthaH? kathAmimAM yadi kopi pR^ichChati tarhi prabhoratra prayojanamastIti kathite sa shIghraM tamatra preShayiShyati|</para>
  <para style="p">
    <verse number="4" style="v"/>tatastau gatvA dvimArgamelane kasyachid dvArasya pArshve taM garddabhashAvakaM prApya mochayataH,</para>
  <para style="p">
    <verse number="5" style="v"/>etarhi tatropasthitalokAnAM kashchid apR^ichChat, garddabhashishuM kuto mochayathaH?</para>
  <para style="p">
    <verse number="6" style="v"/>tadA yIshorAj nAnusAreNa tebhyaH pratyudite tatkShaNaM tamAdAtuM te.anujaj nuH|</para>
  <para style="p">
    <verse number="7" style="v"/>atha tau yIshoH sannidhiM garddabhashishum AnIya tadupari svavastrANi pAtayAmAsatuH; tataH sa tadupari samupaviShTaH|</para>
  <para style="p">
    <verse number="8" style="v"/>tadAneke pathi svavAsAMsi pAtayAmAsuH, paraishcha tarushAkhAshChitavA mArge vikIrNAH|</para>
  <para style="p">
    <verse number="9" style="v"/>apara ncha pashchAdgAmino.agragAminashcha sarvve janA uchaiHsvareNa vaktumArebhire, jaya jaya yaH parameshvarasya nAmnAgachChati sa dhanya iti|</para>
  <para style="p">
    <verse number="10" style="v"/>tathAsmAkamaM pUrvvapuruShasya dAyUdo yadrAjyaM parameshvaranAmnAyAti tadapi dhanyaM, sarvvasmAduchChrAye svarge Ishvarasya jayo bhavet|</para>
  <para style="p">
    <verse number="11" style="v"/>itthaM yIshu ryirUshAlami mandiraM pravishya chaturdiksthAni sarvvANi vastUni dR^iShTavAn; atha sAyaMkAla upasthite dvAdashashiShyasahito baithaniyaM jagAma|</para>
  <para style="p">
    <verse number="12" style="v"/>aparehani baithaniyAd Agamanasamaye kShudhArtto babhUva|</para>
  <para style="p">
    <verse number="13" style="v"/>tato dUre sapatramuDumbarapAdapaM vilokya tatra ki nchit phalaM prAptuM tasya sannikR^iShTaM yayau, tadAnIM phalapAtanasya samayo nAgachChati| tatastatropasthitaH patrANi vinA kimapyaparaM na prApya sa kathitavAn,</para>
  <para style="p">
    <verse number="14" style="v"/>adyArabhya kopi mAnavastvattaH phalaM na bhu njIta; imAM kathAM tasya shiShyAH shushruvuH|</para>
  <para style="p">
    <verse number="15" style="v"/>tadanantaraM teShu yirUshAlamamAyAteShu yIshu rmandiraM gatvA tatrasthAnAM baNijAM mudrAsanAni pArAvatavikretR^iNAm AsanAni cha nyubjayA nchakAra sarvvAn kretR^in vikretR^iMshcha bahishchakAra|</para>
  <para style="p">
    <verse number="16" style="v"/>aparaM mandiramadhyena kimapi pAtraM voDhuM sarvvajanaM nivArayAmAsa|</para>
  <para style="p">
    <verse number="17" style="v"/>lokAnupadishan jagAda, mama gR^ihaM sarvvajAtIyAnAM prArthanAgR^iham iti nAmnA prathitaM bhaviShyati etat kiM shAstre likhitaM nAsti? kintu yUyaM tadeva chorANAM gahvaraM kurutha|</para>
  <para style="p">
    <verse number="18" style="v"/>imAM vANIM shrutvAdhyApakAH pradhAnayAjakAshcha taM yathA nAshayituM shaknuvanti tathoेpAyaM mR^igayAmAsuH, kintu tasyopadeshAt sarvve lokA vismayaM gatA ataste tasmAd bibhyuH|</para>
  <para style="p">
    <verse number="19" style="v"/>atha sAyaMsamaya upasthite yIshurnagarAd bahirvavrAja|</para>
  <para style="p">
    <verse number="20" style="v"/>anantaraM prAtaHkAle te tena mArgeNa gachChantastamuDumbaramahIruhaM samUlaM shuShkaM dadR^ishuH|</para>
  <para style="p">
    <verse number="21" style="v"/>tataH pitaraH pUrvvavAkyaM smaran yIshuM babhAShaM, he guro pashyatu ya uDumbaraviTapI bhavatA shaptaH sa shuShko babhUva|</para>
  <para style="p">
    <verse number="22" style="v"/>tato yIshuH pratyavAdIt, yUyamIshvare vishvasita|</para>
  <para style="p">
    <verse number="23" style="v"/>yuShmAnahaM yathArthaM vadAmi kopi yadyetadgiriM vadati, tvamutthAya gatvA jaladhau pata, proktamidaM vAkyamavashyaM ghaTiShyate, manasA kimapi na sandihya chedidaM vishvaset tarhi tasya vAkyAnusAreNa tad ghaTiShyate|</para>
  <para style="p">
    <verse number="24" style="v"/>ato hetorahaM yuShmAn vachmi, prArthanAkAle yadyadAkAMkShiShyadhve tattadavashyaM prApsyatha, itthaM vishvasita, tataH prApsyatha|</para>
  <para style="p">
    <verse number="25" style="v"/>apara ncha yuShmAsu prArthayituM samutthiteShu yadi kopi yuShmAkam aparAdhI tiShThati, tarhi taM kShamadhvaM, tathA kR^ite yuShmAkaM svargasthaH pitApi yuShmAkamAgAMmi kShamiShyate|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu yadi na kShamadhve tarhi vaH svargasthaH pitApi yuShmAkamAgAMsi na kShamiShyate|</para>
  <para style="p">
    <verse number="27" style="v"/>anantaraM te puna ryirUshAlamaM pravivishuH, yIshu ryadA madhyemandiram itastato gachChati, tadAnIM pradhAnayAjakA upAdhyAyAH prA nchashcha tadantikametya kathAmimAM paprachChuH,</para>
  <para style="p">
    <verse number="28" style="v"/>tvaM kenAdeshena karmmANyetAni karoShi? tathaitAni karmmANi karttAM kenAdiShTosi?</para>
  <para style="p">
    <verse number="29" style="v"/>tato yIshuH pratigaditavAn ahamapi yuShmAn ekakathAM pR^ichChAmi, yadi yUyaM tasyA uttaraM kurutha, tarhi kayAj nayAhaM karmmANyetAni karomi tad yuShmabhyaM kathayiShyAmi|</para>
  <para style="p">
    <verse number="30" style="v"/>yohano majjanam IshvarAt jAtaM kiM mAnavAt? tanmahyaM kathayata|</para>
  <para style="p">
    <verse number="31" style="v"/>te parasparaM vivektuM prArebhire, tad IshvarAd babhUveti ched vadAmastarhi kutastaM na pratyaita? kathametAM kathayiShyati|</para>
  <para style="p">
    <verse number="32" style="v"/>mAnavAd abhavaditi ched vadAmastarhi lokebhyo bhayamasti yato hetoH sarvve yohanaM satyaM bhaviShyadvAdinaM manyante|</para>
  <para style="p">
    <verse number="33" style="v"/>ataeva te yIshuM pratyavAdiShu rvayaM tad vaktuM na shaknumaH| yIshuruvAcha, tarhi yenAdeshena karmmANyetAni karomi, ahamapi yuShmabhyaM tanna kathayiShyAmi|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM yIshu rdR^iShTAntena tebhyaH kathayitumArebhe, kashchideko drAkShAkShetraM vidhAya tachchaturdikShu vAraNIM kR^itvA tanmadhye drAkShApeShaNakuNDam akhanat, tathA tasya gaDamapi nirmmitavAn tatastatkShetraM kR^iShIvaleShu samarpya dUradeshaM jagAma|</para>
  <para style="p">
    <verse number="2" style="v"/>tadanantaraM phalakAle kR^iShIvalebhyo drAkShAkShetraphalAni prAptuM teShAM savidhe bhR^ityam ekaM prAhiNot|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu kR^iShIvalAstaM dhR^itvA prahR^itya riktahastaM visasR^ijuH|</para>
  <para style="p">
    <verse number="4" style="v"/>tataH sa punaranyamekaM bhR^ityaM praShayAmAsa, kintu te kR^iShIvalAH pAShANAghAtaistasya shiro bha NktvA sApamAnaM taM vyasarjan|</para>
  <para style="p">
    <verse number="5" style="v"/>tataH paraM soparaM dAsaM prAhiNot tadA te taM jaghnuH, evam anekeShAM kasyachit prahAraH kasyachid vadhashcha taiH kR^itaH|</para>
  <para style="p">
    <verse number="6" style="v"/>tataH paraM mayA svaputre prahite te tamavashyaM sammaMsyante, ityuktvAvasheShe teShAM sannidhau nijapriyam advitIyaM putraM preShayAmAsa|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu kR^iShIvalAH parasparaM jagaduH, eSha uttarAdhikArI, AgachChata vayamenaM hanmastathA kR^ite .adhikAroyam asmAkaM bhaviShyati|</para>
  <para style="p">
    <verse number="8" style="v"/>tatastaM dhR^itvA hatvA drAkShAkShetrAd bahiH prAkShipan|</para>
  <para style="p">
    <verse number="9" style="v"/>anenAsau drAkShAkShetrapatiH kiM kariShyati? sa etya tAn kR^iShIvalAn saMhatya tatkShetram anyeShu kR^iShIvaleShu samarpayiShyati|</para>
  <para style="p">
    <verse number="10" style="v"/>apara ncha, "sthapatayaH kariShyanti grAvANaM yantu tuchChakaM| prAdhAnaprastaraH koNe sa eva saMbhaviShyati|</para>
  <para style="p">
    <verse number="11" style="v"/>etat karmma pareshasyAMdbhutaM no dR^iShTito bhavet||" imAM shAstrIyAM lipiM yUyaM kiM nApAThiShTa?</para>
  <para style="p">
    <verse number="12" style="v"/>tadAnIM sa tAnuddishya tAM dR^iShTAntakathAM kathitavAn, ta itthaM budvvA taM dharttAmudyatAH, kintu lokebhyo bibhyuH, tadanantaraM te taM vihAya vavrajuH|</para>
  <para style="p">
    <verse number="13" style="v"/>apara ncha te tasya vAkyadoShaM dharttAM katipayAn phirUshino herodIyAMshcha lokAn tadantikaM preShayAmAsuH|</para>
  <para style="p">
    <verse number="14" style="v"/>ta Agatya tamavadan, he guro bhavAn tathyabhAShI kasyApyanurodhaM na manyate, pakShapAta ncha na karoti, yathArthata IshvarIyaM mArgaM darshayati vayametat prajAnImaH, kaisarAya karo deyo na vAM? vayaM dAsyAmo na vA?</para>
  <para style="p">
    <verse number="15" style="v"/>kintu sa teShAM kapaTaM j nAtvA jagAda, kuto mAM parIkShadhve? ekaM mudrApAdaM samAnIya mAM darshayata|</para>
  <para style="p">
    <verse number="16" style="v"/>tadA tairekasmin mudrApAde samAnIte sa tAn paprachCha, atra likhitaM nAma mUrtti rvA kasya? te pratyUchuH, kaisarasya|</para>
  <para style="p">
    <verse number="17" style="v"/>tadA yIshuravadat tarhi kaisarasya dravyANi kaisarAya datta, Ishvarasya dravyANi tu IshvarAya datta; tataste vismayaM menire|</para>
  <para style="p">
    <verse number="18" style="v"/>atha mR^itAnAmutthAnaM ye na manyante te sidUkino yIshoH samIpamAgatya taM paprachChuH;</para>
  <para style="p">
    <verse number="19" style="v"/>he guro kashchijjano yadi niHsantatiH san bhAryyAyAM satyAM mriyate tarhi tasya bhrAtA tasya bhAryyAM gR^ihItvA bhrAtu rvaMshotpattiM kariShyati, vyavasthAmimAM mUsA asmAn prati vyalikhat|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu kechit sapta bhrAtara Asan, tatasteShAM jyeShThabhrAtA vivahya niHsantatiH san amriyata|</para>
  <para style="p">
    <verse number="21" style="v"/>tato dvitIyo bhrAtA tAM striyamagR^ihaNat kintu sopi niHsantatiH san amriyata; atha tR^itIyopi bhrAtA tAdR^ishobhavat|</para>
  <para style="p">
    <verse number="22" style="v"/>itthaM saptaiva bhrAtarastAM striyaM gR^ihItvA niHsantAnAH santo.amriyanta, sarvvasheShe sApi strI mriyate sma|</para>
  <para style="p">
    <verse number="23" style="v"/>atha mR^itAnAmutthAnakAle yadA ta utthAsyanti tadA teShAM kasya bhAryyA sA bhaviShyati? yataste saptaiva tAM vyavahan|</para>
  <para style="p">
    <verse number="24" style="v"/>tato yIshuH pratyuvAcha shAstram Ishvarashakti ncha yUyamaj nAtvA kimabhrAmyata na?</para>
  <para style="p">
    <verse number="25" style="v"/>mR^italokAnAmutthAnaM sati te na vivahanti vAgdattA api na bhavanti, kintu svargIyadUtAnAM sadR^ishA bhavanti|</para>
  <para style="p">
    <verse number="26" style="v"/>punashcha "aham ibrAhIma Ishvara ishAka Ishvaro yAkUbashcheshvaraH" yAmimAM kathAM stambamadhye tiShThan Ishvaro mUsAmavAdIt mR^itAnAmutthAnArthe sA kathA mUsAlikhite pustake kiM yuShmAbhi rnApAThi?</para>
  <para style="p">
    <verse number="27" style="v"/>Ishvaro jIvatAM prabhuH kintu mR^itAnAM prabhu rna bhavati, tasmAddheto ryUyaM mahAbhrameNa tiShThatha|</para>
  <para style="p">
    <verse number="28" style="v"/>etarhi ekodhyApaka etya teShAmitthaM vichAraM shushrAva; yIshusteShAM vAkyasya saduttaraM dattavAn iti budvvA taM pR^iShTavAn sarvvAsAm Aj nAnAM kA shreShThA? tato yIshuH pratyuvAcha,</para>
  <para style="p">
    <verse number="29" style="v"/>"he isrAyellokA avadhatta, asmAkaM prabhuH parameshvara eka eva,</para>
  <para style="p">
    <verse number="30" style="v"/>yUyaM sarvvantaHkaraNaiH sarvvaprANaiH sarvvachittaiH sarvvashaktibhishcha tasmin prabhau parameshvare prIyadhvaM," ityAj nA shreShThA|</para>
  <para style="p">
    <verse number="31" style="v"/>tathA "svaprativAsini svavat prema kurudhvaM," eShA yA dvitIyAj nA sA tAdR^ishI; etAbhyAM dvAbhyAm Aj nAbhyAm anyA kApyAj nA shreShThA nAsti|</para>
  <para style="p">
    <verse number="32" style="v"/>tadA sodhyApakastamavadat, he guro satyaM bhavAn yathArthaM proktavAn yata ekasmAd IshvarAd anyo dvitIya Ishvaro nAsti;</para>
  <para style="p">
    <verse number="33" style="v"/>aparaM sarvvAntaHkaraNaiH sarvvaprANaiH sarvvachittaiH sarvvashaktibhishcha Ishvare premakaraNaM tathA svamIpavAsini svavat premakaraNa ncha sarvvebhyo homabalidAnAdibhyaH shraShThaM bhavati|</para>
  <para style="p">
    <verse number="34" style="v"/>tato yIshuH subuddheriva tasyedam uttaraM shrutvA taM bhAShitavAn tvamIshvarasya rAjyAnna dUrosi|itaH paraM tena saha kasyApi vAkyasya vichAraM karttAM kasyApi pragalbhatA na jAtA|</para>
  <para style="p">
    <verse number="35" style="v"/>anantaraM madhyemandiram upadishan yIshurimaM prashnaM chakAra, adhyApakA abhiShiktaM (tArakaM) kuto dAyUdaH santAnaM vadanti?</para>
  <para style="p">
    <verse number="36" style="v"/>svayaM dAyUd pavitrasyAtmana AveshenedaM kathayAmAsa| yathA| "mama prabhumidaM vAkyavadat parameshvaraH| tava shatrUnahaM yAvat pAdapIThaM karomi na| tAvat kAlaM madIye tvaM dakShapArshv upAvisha|"</para>
  <para style="p">
    <verse number="37" style="v"/>yadi dAyUd taM prabhUM vadati tarhi kathaM sa tasya santAno bhavitumarhati? itare lokAstatkathAM shrutvAnananduH|</para>
  <para style="p">
    <verse number="38" style="v"/>tadAnIM sa tAnupadishya kathitavAn ye narA dIrghaparidheyAni haTTe vipanau cha</para>
  <para style="p">
    <verse number="39" style="v"/>lokakR^itanamaskArAn bhajanagR^ihe pradhAnAsanAni bhojanakAle pradhAnasthAnAni cha kA NkShante;</para>
  <para style="p">
    <verse number="40" style="v"/>vidhavAnAM sarvvasvaM grasitvA ChalAd dIrghakAlaM prArthayante tebhya upAdhyAyebhyaH sAvadhAnA bhavata; te.adhikatarAn daNDAn prApsyanti|</para>
  <para style="p">
    <verse number="41" style="v"/>tadanantaraM lokA bhANDAgAre mudrA yathA nikShipanti bhANDAgArasya sammukhe samupavishya yIshustadavaluloka; tadAnIM bahavo dhaninastasya madhye bahUni dhanAni nirakShipan|</para>
  <para style="p">
    <verse number="42" style="v"/>pashchAd ekA daridrA vidhavA samAgatya dvipaNamUlyAM mudraikAM tatra nirakShipat|</para>
  <para style="p">
    <verse number="43" style="v"/>tadA yIshuH shiShyAn AhUya kathitavAn yuShmAnahaM yathArthaM vadAmi ye ye bhANDAgAre.asmina dhanAni niHkShipanti sma tebhyaH sarvvebhya iyaM vidhavA daridrAdhikam niHkShipati sma|</para>
  <para style="p">
    <verse number="44" style="v"/>yataste prabhUtadhanasya ki nchit nirakShipan kintu dIneyaM svadinayApanayogyaM ki nchidapi na sthApayitvA sarvvasvaM nirakShipat|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM mandirAd bahirgamanakAle tasya shiShyANAmekastaM vyAhR^itavAn he guro pashyatu kIdR^ishAH pAShANAH kIdR^ik cha nichayanaM|</para>
  <para style="p">
    <verse number="2" style="v"/>tadA yIshustam avadat tvaM kimetad bR^ihannichayanaM pashyasi? asyaikapAShANopi dvitIyapAShANopari na sthAsyati sarvve .adhaHkShepsyante|</para>
  <para style="p">
    <verse number="3" style="v"/>atha yasmin kAle jaitungirau mandirasya sammukhe sa samupaviShTastasmin kAle pitaro yAkUb yohan Andriyashchaite taM rahasi paprachChuH,</para>
  <para style="p">
    <verse number="4" style="v"/>etA ghaTanAH kadA bhaviShyanti? tathaitatsarvvAsAM siddhyupakramasya vA kiM chihnaM? tadasmabhyaM kathayatu bhavAn|</para>
  <para style="p">
    <verse number="5" style="v"/>tato yAshustAn vaktumArebhe, kopi yathA yuShmAn na bhrAmayati tathAtra yUyaM sAvadhAnA bhavata|</para>
  <para style="p">
    <verse number="6" style="v"/>yataH khrIShTohamiti kathayitvA mama nAmnAneke samAgatya lokAnAM bhramaM janayiShyanti;</para>
  <para style="p">
    <verse number="7" style="v"/>kintu yUyaM raNasya vArttAM raNADambara ncha shrutvA mA vyAkulA bhavata, ghaTanA etA avashyammAvinyaH; kintvApAtato na yugAnto bhaviShyati|</para>
  <para style="p">
    <verse number="8" style="v"/>deshasya vipakShatayA desho rAjyasya vipakShatayA cha rAjyamutthAsyati, tathA sthAne sthAne bhUmikampo durbhikShaM mahAkleshAshcha samupasthAsyanti, sarvva ete duHkhasyArambhAH|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu yUyam AtmArthe sAvadhAnAstiShThata, yato lokA rAjasabhAyAM yuShmAn samarpayiShyanti, tathA bhajanagR^ihe prahariShyanti; yUyaM madarthe deshAdhipAn bhUpAMshcha prati sAkShyadAnAya teShAM sammukhe upasthApayiShyadhve|</para>
  <para style="p">
    <verse number="10" style="v"/>sheShIbhavanAt pUrvvaM sarvvAn deshIyAn prati susaMvAdaH prachArayiShyate|</para>
  <para style="p">
    <verse number="11" style="v"/>kintu yadA te yuShmAn dhR^itvA samarpayiShyanti tadA yUyaM yadyad uttaraM dAsyatha, tadagra tasya vivechanaM mA kuruta tadarthaM ki nchidapi mA chintayata cha, tadAnIM yuShmAkaM manaHsu yadyad vAkyam upasthApayiShyate tadeva vadiShyatha, yato yUyaM na tadvaktAraH kintu pavitra AtmA tasya vaktA|</para>
  <para style="p">
    <verse number="12" style="v"/>tadA bhrAtA bhrAtaraM pitA putraM ghAtanArthaM parahasteShu samarpayiShyate, tathA patyAni mAtApitro rvipakShatayA tau ghAtayiShyanti|</para>
  <para style="p">
    <verse number="13" style="v"/>mama nAmahetoH sarvveShAM savidhe yUyaM jugupsitA bhaviShyatha, kintu yaH kashchit sheShaparyyantaM dhairyyam AlambiShyate saeva paritrAsyate|</para>
  <para style="p">
    <verse number="14" style="v"/>dAniyelbhaviShyadvAdinA proktaM sarvvanAshi jugupsita ncha vastu yadA tvayogyasthAne vidyamAnaM drakShatha (yo janaH paThati sa budhyatAM) tadA ye yihUdIyadeshe tiShThanti te mahIdhraM prati palAyantAM;</para>
  <para style="p">
    <verse number="15" style="v"/>tathA yo naro gR^ihopari tiShThati sa gR^ihamadhyaM nAvarohatu, tathA kimapi vastu grahItuM madhyegR^ihaM na pravishatu;</para>
  <para style="p">
    <verse number="16" style="v"/>tathA cha yo naraH kShetre tiShThati sopi svavastraM grahItuM parAvR^itya na vrajatu|</para>
  <para style="p">
    <verse number="17" style="v"/>tadAnIM garbbhavatInAM stanyadAtrINA ncha yoShitAM durgati rbhaviShyati|</para>
  <para style="p">
    <verse number="18" style="v"/>yuShmAkaM palAyanaM shItakAle yathA na bhavati tadarthaM prArthayadhvaM|</para>
  <para style="p">
    <verse number="19" style="v"/>yatastadA yAdR^ishI durghaTanA ghaTiShyate tAdR^ishI durghaTanA IshvarasR^iShTeH prathamamArabhyAdya yAvat kadApi na jAtA na janiShyate cha|</para>
  <para style="p">
    <verse number="20" style="v"/>apara ncha parameshvaro yadi tasya samayasya saMkShepaM na karoti tarhi kasyApi prANabhR^ito rakShA bhavituM na shakShyati, kintu yAn janAn manonItAn akarot teShAM svamanonItAnAM hetoH sa tadanehasaM saMkShepsyati|</para>
  <para style="p">
    <verse number="21" style="v"/>anyachcha pashyata khrIShTotra sthAne vA tatra sthAne vidyate, tasminkAle yadi kashchid yuShmAn etAdR^ishaM vAkyaM vyAharati, tarhi tasmin vAkye bhaiva vishvasita|</para>
  <para style="p">
    <verse number="22" style="v"/>yatoneke mithyAkhrIShTA mithyAbhaviShyadvAdinashcha samupasthAya bahUni chihnAnyadbhutAni karmmANi cha darshayiShyanti; tathA yadi sambhavati tarhi manonItalokAnAmapi mithyAmatiM janayiShyanti|</para>
  <para style="p">
    <verse number="23" style="v"/>pashyata ghaTanAtaH pUrvvaM sarvvakAryyasya vArttAM yuShmabhyamadAm, yUyaM sAvadhAnAstiShThata|</para>
  <para style="p">
    <verse number="24" style="v"/>apara ncha tasya kleshakAlasyAvyavahite parakAle bhAskaraH sAndhakAro bhaviShyati tathaiva chandrashchandrikAM na dAsyati|</para>
  <para style="p">
    <verse number="25" style="v"/>nabhaHsthAni nakShatrANi patiShyanti, vyomamaNDalasthA grahAshcha vichaliShyanti|</para>
  <para style="p">
    <verse number="26" style="v"/>tadAnIM mahAparAkrameNa mahaishvaryyeNa cha meghamAruhya samAyAntaM mAnavasutaM mAnavAH samIkShiShyante|</para>
  <para style="p">
    <verse number="27" style="v"/>anyachcha sa nijadUtAn prahitya nabhobhUmyoH sImAM yAvad jagatashchaturdigbhyaH svamanonItalokAn saMgrahIShyati|</para>
  <para style="p">
    <verse number="28" style="v"/>uDumbarataro rdR^iShTAntaM shikShadhvaM yadoDumbarasya taro rnavInAH shAkhA jAyante pallavAdIni cha rnigachChanti, tadA nidAghakAlaH savidho bhavatIti yUyaM j nAtuM shaknutha|</para>
  <para style="p">
    <verse number="29" style="v"/>tadvad etA ghaTanA dR^iShTvA sa kAlo dvAryyupasthita iti jAnIta|</para>
  <para style="p">
    <verse number="30" style="v"/>yuShmAnahaM yathArthaM vadAmi, AdhunikalokAnAM gamanAt pUrvvaM tAni sarvvANi ghaTiShyante|</para>
  <para style="p">
    <verse number="31" style="v"/>dyAvApR^ithivyo rvichalitayoH satyo rmadIyA vANI na vichaliShyati|</para>
  <para style="p">
    <verse number="32" style="v"/>apara ncha svargasthadUtagaNo vA putro vA tAtAdanyaH kopi taM divasaM taM daNDaM vA na j nApayati|</para>
  <para style="p">
    <verse number="33" style="v"/>ataH sa samayaH kadA bhaviShyati, etajj nAnAbhAvAd yUyaM sAvadhAnAstiShThata, satarkAshcha bhUtvA prArthayadhvaM;</para>
  <para style="p">
    <verse number="34" style="v"/>yadvat kashchit pumAn svaniveshanAd dUradeshaM prati yAtrAkaraNakAle dAseShu svakAryyasya bhAramarpayitvA sarvvAn sve sve karmmaNi niyojayati; aparaM dauvArikaM jAgarituM samAdishya yAti, tadvan naraputraH|</para>
  <para style="p">
    <verse number="35" style="v"/>gR^ihapatiH sAyaMkAle nishIthe vA tR^itIyayAme vA prAtaHkAle vA kadAgamiShyati tad yUyaM na jAnItha;</para>
  <para style="p">
    <verse number="36" style="v"/>sa haThAdAgatya yathA yuShmAn nidritAn na pashyati, tadarthaM jAgaritAstiShThata|</para>
  <para style="p">
    <verse number="37" style="v"/>yuShmAnahaM yad vadAmi tadeva sarvvAn vadAmi, jAgaritAstiShThateti|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadA nistArotsavakiNvahInapUpotsavayorArambhasya dinadvaye .avashiShTe pradhAnayAjakA adhyApakAshcha kenApi Chalena yIshuM dharttAM hantu ncha mR^igayA nchakrire;</para>
  <para style="p">
    <verse number="2" style="v"/>kintu lokAnAM kalahabhayAdUchire, nachotsavakAla uchitametaditi|</para>
  <para style="p">
    <verse number="3" style="v"/>anantaraM baithaniyApuुre shimonakuShThino gR^ihe yoshau bhotkumupaviShTe sati kAchid yoShit pANDarapAShANasya sampuTakena mahArghyottamatailam AnIya sampuTakaM bhaMktvA tasyottamA Nge tailadhArAM pAtayA nchakre|</para>
  <para style="p">
    <verse number="4" style="v"/>tasmAt kechit svAnte kupyantaH kathitavaMntaH kutoyaM tailApavyayaH?</para>
  <para style="p">
    <verse number="5" style="v"/>yadyetat taila vyakreShyata tarhi mudrApAdashatatrayAdapyadhikaM tasya prAptamUlyaM daridralokebhyo dAtumashakShyata, kathAmetAM kathayitvA tayA yoShitA sAkaM vAchAyuhyan|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu yIshuruvAcha, kuta etasyai kR^ichChraM dadAsi? mahyamiyaM karmmottamaM kR^itavatI|</para>
  <para style="p">
    <verse number="7" style="v"/>daridrAH sarvvadA yuShmAbhiH saha tiShThanti, tasmAd yUyaM yadechChatha tadaiva tAnupakarttAM shaknutha, kintvahaM yubhAbhiH saha nirantaraM na tiShThAmi|</para>
  <para style="p">
    <verse number="8" style="v"/>asyA yathAsAdhyaM tathaivAkarodiyaM, shmashAnayApanAt pUrvvaM sametya madvapuShi tailam amarddayat|</para>
  <para style="p">
    <verse number="9" style="v"/>ahaM yuShmabhyaM yathArthaM kathayAmi, jagatAM madhye yatra yatra susaMvAdoyaM prachArayiShyate tatra tatra yoShita etasyAH smaraNArthaM tatkR^itakarmmaitat prachArayiShyate|</para>
  <para style="p">
    <verse number="10" style="v"/>tataH paraM dvAdashAnAM shiShyANAmeka IShkariyotIyayihUdAkhyo yIshuM parakareShu samarpayituM pradhAnayAjakAnAM samIpamiyAya|</para>
  <para style="p">
    <verse number="11" style="v"/>te tasya vAkyaM samAkarNya santuShTAH santastasmai mudrA dAtuM pratyajAnata; tasmAt sa taM teShAM kareShu samarpaNAyopAyaM mR^igayAmAsa|</para>
  <para style="p">
    <verse number="12" style="v"/>anantaraM kiNvashUnyapUpotsavasya prathame.ahani nistArotmavArthaM meShamAraNAsamaye shiShyAstaM paprachChaH kutra gatvA vayaM nistArotsavasya bhojyamAsAdayiShyAmaH? kimichChati bhavAn?</para>
  <para style="p">
    <verse number="13" style="v"/>tadAnIM sa teShAM dvayaM prerayan babhAShe yuvayoH puramadhyaM gatayoH sato ryo janaH sajalakumbhaM vahan yuvAM sAkShAt kariShyati tasyaiva pashchAd yAtaM;</para>
  <para style="p">
    <verse number="14" style="v"/>sa yat sadanaM pravekShyati tadbhavanapatiM vadataM, gururAha yatra sashiShyohaM nistArotsavIyaM bhojanaM kariShyAmi, sA bhojanashAlA kutrAsti?</para>
  <para style="p">
    <verse number="15" style="v"/>tataH sa pariShkR^itAM susajjitAM bR^ihatIcha ncha yAM shAlAM darshayiShyati tasyAmasmadarthaM bhojyadravyANyAsAdayataM|</para>
  <para style="p">
    <verse number="16" style="v"/>tataH shiShyau prasthAya puraM pravishya sa yathoktavAn tathaiva prApya nistArotsavasya bhojyadravyANi samAsAdayetAm|</para>
  <para style="p">
    <verse number="17" style="v"/>anantaraM yIshuH sAyaMkAle dvAdashabhiH shiShyaiH sArddhaM jagAma;</para>
  <para style="p">
    <verse number="18" style="v"/>sarvveShu bhojanAya propaviShTeShu sa tAnuditavAn yuShmAnahaM yathArthaM vyAharAmi, atra yuShmAkameko jano yo mayA saha bhuMkte mAM parakereShu samarpayiShyate|</para>
  <para style="p">
    <verse number="19" style="v"/>tadAnIM te duHkhitAH santa ekaikashastaM praShTumArabdhavantaH sa kimahaM? pashchAd anya ekobhidadhe sa kimahaM?</para>
  <para style="p">
    <verse number="20" style="v"/>tataH sa pratyavadad eteShAM dvAdashAnAM yo jano mayA samaM bhojanApAtre pANiM majjayiShyati sa eva|</para>
  <para style="p">
    <verse number="21" style="v"/>manujatanayamadhi yAdR^ishaM likhitamAste tadanurUpA gatistasya bhaviShyati, kintu yo jano mAnavasutaM samarpayiShyate hanta tasya janmAbhAve sati bhadramabhaviShyat|</para>
  <para style="p">
    <verse number="22" style="v"/>apara ncha teShAM bhojanasamaye yIshuH pUpaM gR^ihItveshvaraguNAn anukIrtya bha NktvA tebhyo dattvA babhAShe, etad gR^ihItvA bhu njIdhvam etanmama vigraharUpaM|</para>
  <para style="p">
    <verse number="23" style="v"/>anantaraM sa kaMsaM gR^ihItveshvarasya guNAn kIrttayitvA tebhyo dadau, tataste sarvve papuH|</para>
  <para style="p">
    <verse number="24" style="v"/>aparaM sa tAnavAdId bahUnAM nimittaM pAtitaM mama navInaniyamarUpaM shoNitametat|</para>
  <para style="p">
    <verse number="25" style="v"/>yuShmAnahaM yathArthaM vadAmi, Ishvarasya rAjye yAvat sadyojAtaM drAkShArasaM na pAsyAmi,tAvadahaM drAkShAphalarasaM puna rna pAsyAmi|</para>
  <para style="p">
    <verse number="26" style="v"/>tadanantaraM te gItamekaM saMgIya bahi rjaitunaM shikhariNaM yayuH</para>
  <para style="p">
    <verse number="27" style="v"/>atha yIshustAnuvAcha nishAyAmasyAM mayi yuShmAkaM sarvveShAM pratyUho bhaviShyati yato likhitamAste yathA, meShANAM rakShaka nchAhaM prahariShyAmi vai tataH| meShANAM nivaho nUnaM pravikIrNo bhaviShyati|</para>
  <para style="p">
    <verse number="28" style="v"/>kantu madutthAne jAte yuShmAkamagre.ahaM gAlIlaM vrajiShyAmi|</para>
  <para style="p">
    <verse number="29" style="v"/>tadA pitaraH pratibabhAShe, yadyapi sarvveShAM pratyUho bhavati tathApi mama naiva bhaviShyati|</para>
  <para style="p">
    <verse number="30" style="v"/>tato yIshuruktAvAn ahaM tubhyaM tathyaM kathayAmi, kShaNAdAyAmadya kukkuTasya dvitIyavAraravaNAt pUrvvaM tvaM vAratrayaM mAmapahnoShyase|</para>
  <para style="p">
    <verse number="31" style="v"/>kintu sa gADhaM vyAharad yadyapi tvayA sArddhaM mama prANo yAti tathApi kathamapi tvAM nApahnoShye; sarvve.apItare tathaiva babhAShire|</para>
  <para style="p">
    <verse number="32" style="v"/>apara ncha teShu getshimAnInAmakaM sthAna gateShu sa shiShyAn jagAda, yAvadahaM prArthaye tAvadatra sthAne yUyaM samupavishata|</para>
  <para style="p">
    <verse number="33" style="v"/>atha sa pitaraM yAkUbaM yohana ncha gR^ihItvA vavrAja; atyantaM trAsito vyAkulitashcha tebhyaH kathayAmAsa,</para>
  <para style="p">
    <verse number="34" style="v"/>nidhanakAlavat prANo me.atIva daHkhameti, yUyaM jAgratotra sthAne tiShThata|</para>
  <para style="p">
    <verse number="35" style="v"/>tataH sa ki nchiddUraM gatvA bhUmAvadhomukhaH patitvA prArthitavAnetat, yadi bhavituM shakyaM tarhi duHkhasamayoyaM matto dUrIbhavatu|</para>
  <para style="p">
    <verse number="36" style="v"/>aparamuditavAn he pita rhe pitaH sarvveM tvayA sAdhyaM, tato hetorimaM kaMsaM matto dUrIkuru, kintu tan mamechChAto na tavechChAto bhavatu|</para>
  <para style="p">
    <verse number="37" style="v"/>tataH paraM sa etya tAn nidritAn nirIkShya pitaraM provAcha, shimon tvaM kiM nidrAsi? ghaTikAmekAm api jAgarituM na shaknoShi?</para>
  <para style="p">
    <verse number="38" style="v"/>parIkShAyAM yathA na patatha tadarthaM sachetanAH santaH prArthayadhvaM; mana udyuktamiti satyaM kintu vapurashaktikaM|</para>
  <para style="p">
    <verse number="39" style="v"/>atha sa punarvrajitvA pUrvvavat prArthayA nchakre|</para>
  <para style="p">
    <verse number="40" style="v"/>parAvR^ityAgatya punarapi tAn nidritAn dadarsha tadA teShAM lochanAni nidrayA pUrNAni, tasmAttasmai kA kathA kathayitavyA ta etad boddhuM na shekuH|</para>
  <para style="p">
    <verse number="41" style="v"/>tataHparaM tR^itIyavAraM Agatya tebhyo .akathayad idAnImapi shayitvA vishrAmyatha? yatheShTaM jAtaM, samayashchopasthitaH pashyata mAnavatanayaH pApilokAnAM pANiShu samarpyate|</para>
  <para style="p">
    <verse number="42" style="v"/>uttiShThata, vayaM vrajAmo yo jano mAM parapANiShu samarpayiShyate pashyata sa samIpamAyAtaH|</para>
  <para style="p">
    <verse number="43" style="v"/>imAM kathAM kathayati sa, etarhidvAdashAnAmeko yihUdA nAmA shiShyaH pradhAnayAjakAnAm upAdhyAyAnAM prAchInalokAnA ncha sannidheH kha NgalaguDadhAriNo bahulokAn gR^ihItvA tasya samIpa upasthitavAn|</para>
  <para style="p">
    <verse number="44" style="v"/>apara nchAsau parapANiShu samarpayitA pUrvvamiti sa NketaM kR^itavAn yamahaM chumbiShyAmi sa evAsau tameva dhR^itvA sAvadhAnaM nayata|</para>
  <para style="p">
    <verse number="45" style="v"/>ato hetoH sa Agatyaiva yoshoH savidhaM gatvA he guro he guro, ityuktvA taM chuchumba|</para>
  <para style="p">
    <verse number="46" style="v"/>tadA te tadupari pANInarpayitvA taM dadhnuH|</para>
  <para style="p">
    <verse number="47" style="v"/>tatastasya pArshvasthAnAM lokAnAmekaH kha NgaM niShkoShayan mahAyAjakasya dAsamekaM prahR^itya tasya karNaM chichCheda|</para>
  <para style="p">
    <verse number="48" style="v"/>pashchAd yIshustAn vyAjahAra kha NgAn laguDAMshcha gR^ihItvA mAM kiM chauraM dharttAM samAyAtAH?</para>
  <para style="p">
    <verse number="49" style="v"/>madhyemandiraM samupadishan pratyahaM yuShmAbhiH saha sthitavAnatahaM, tasmin kAle yUyaM mAM nAdIdharata, kintvanena shAstrIyaM vachanaM sedhanIyaM|</para>
  <para style="p">
    <verse number="50" style="v"/>tadA sarvve shiShyAstaM parityajya palAyA nchakrire|</para>
  <para style="p">
    <verse number="51" style="v"/>athaiko yuvA mAnavo nagnakAye vastramekaM nidhAya tasya pashchAd vrajan yuvalokai rdhR^ito</para>
  <para style="p">
    <verse number="52" style="v"/>vastraM vihAya nagnaH palAyA nchakre|</para>
  <para style="p">
    <verse number="53" style="v"/>apara ncha yasmin sthAne pradhAnayAjakA upAdhyAyAH prAchInalokAshcha mahAyAjakena saha sadasi sthitAstasmin sthAne mahAyAjakasya samIpaM yIshuM ninyuH|</para>
  <para style="p">
    <verse number="54" style="v"/>pitaro dUre tatpashchAd itvA mahAyAjakasyATTAlikAM pravishya ki NkaraiH sahopavishya vahnitApaM jagrAha|</para>
  <para style="p">
    <verse number="55" style="v"/>tadAnIM pradhAnayAjakA mantriNashcha yIshuM ghAtayituM tatprAtikUlyena sAkShiNo mR^igayA nchakrire, kintu na prAptAH|</para>
  <para style="p">
    <verse number="56" style="v"/>anekaistadviruddhaM mR^iShAsAkShye dattepi teShAM vAkyAni na samagachChanta|</para>
  <para style="p">
    <verse number="57" style="v"/>sarvvasheShe kiyanta utthAya tasya prAtikUlyena mR^iShAsAkShyaM dattvA kathayAmAsuH,</para>
  <para style="p">
    <verse number="58" style="v"/>idaM karakR^itamandiraM vinAshya dinatrayamadhye punaraparam akarakR^itaM mandiraM nirmmAsyAmi, iti vAkyam asya mukhAt shrutamasmAbhiriti|</para>
  <para style="p">
    <verse number="59" style="v"/>kintu tatrApi teShAM sAkShyakathA na sa NgAtAH|</para>
  <para style="p">
    <verse number="60" style="v"/>atha mahAyAjako madhyesabham utthAya yIshuM vyAjahAra, ete janAstvayi yat sAkShyamaduH tvametasya kimapyuttaraM kiM na dAsyasi?</para>
  <para style="p">
    <verse number="61" style="v"/>kintu sa kimapyuttaraM na datvA maunIbhUya tasyau; tato mahAyAjakaH punarapi taM pR^iShTAvAn tvaM sachchidAnandasya tanayo .abhiShiktastratA?</para>
  <para style="p">
    <verse number="62" style="v"/>tadA yIshustaM provAcha bhavAmyaham yUya ncha sarvvashaktimato dakShINapArshve samupavishantaM megha mAruhya samAyAnta ncha manuShyaputraM sandrakShyatha|</para>
  <para style="p">
    <verse number="63" style="v"/>tadA mahAyAjakaH svaM vamanaM ChitvA vyAvaharat</para>
  <para style="p">
    <verse number="64" style="v"/>kimasmAkaM sAkShibhiH prayojanam? IshvaranindAvAkyaM yuShmAbhirashrAvi kiM vichArayatha? tadAnIM sarvve jagadurayaM nidhanadaNDamarhati|</para>
  <para style="p">
    <verse number="65" style="v"/>tataH kashchit kashchit tadvapuShi niShThIvaM nichikShepa tathA tanmukhamAchChAdya chapeTena hatvA gaditavAn gaNayitvA vada, anucharAshcha chapeTaistamAjaghnuH</para>
  <para style="p">
    <verse number="66" style="v"/>tataH paraM pitare.aTTAlikAdhaHkoShThe tiShThati mahAyAjakasyaikA dAsI sametya</para>
  <para style="p">
    <verse number="67" style="v"/>taM vihnitApaM gR^ihlantaM vilokya taM sunirIkShya babhAShe tvamapi nAsaratIyayIshoH sa NginAm eko jana AsIH|</para>
  <para style="p">
    <verse number="68" style="v"/>kintu sopahnutya jagAda tamahaM na vadmi tvaM yat kathayami tadapyahaM na buddhye| tadAnIM pitare chatvaraM gatavati kuेkkuTo rurAva|</para>
  <para style="p">
    <verse number="69" style="v"/>athAnyA dAsI pitaraM dR^iShTvA samIpasthAn janAn jagAda ayaM teShAmeko janaH|</para>
  <para style="p">
    <verse number="70" style="v"/>tataH sa dvitIyavAram apahnutavAn pashchAt tatrasthA lokAH pitaraM prochustvamavashyaM teShAmeko janaH yatastvaM gAlIlIyo nara iti tavochchAraNaM prakAshayati|</para>
  <para style="p">
    <verse number="71" style="v"/>tadA sa shapathAbhishApau kR^itvA provAcha yUyaM kathAM kathayatha taM naraM na jAne.ahaM|</para>
  <para style="p">
    <verse number="72" style="v"/>tadAnIM dvitIyavAraM kukkuTo .arAvIt| kukkuTasya dvitIyaravAt pUrvvaM tvaM mAM vAratrayam apahnoShyasi, iti yadvAkyaM yIshunA samuditaM tat tadA saMsmR^itya pitaro roditum Arabhata|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha prabhAte sati pradhAnayAjakAH prA ncha upAdhyAyAH sarvve mantriNashcha sabhAM kR^itvA yIshuृM bandhayitva pIlAtAkhyasya deshAdhipateH savidhaM nItvA samarpayAmAsuH|</para>
  <para style="p">
    <verse number="2" style="v"/>tadA pIlAtastaM pR^iShTavAn tvaM kiM yihUdIyalokAnAM rAjA? tataH sa pratyuktavAn satyaM vadasi|</para>
  <para style="p">
    <verse number="3" style="v"/>aparaM pradhAnayAjakAstasya bahuShu vAkyeShu doShamAropayA nchakruH kintu sa kimapi na pratyuvAcha|</para>
  <para style="p">
    <verse number="4" style="v"/>tadAnIM pIlAtastaM punaH paprachCha tvaM kiM nottarayasi? pashyaite tvadviruddhaM katiShu sAdhyeShu sAkShaM dadati|</para>
  <para style="p">
    <verse number="5" style="v"/>kantu yIshustadApi nottaraM dadau tataH pIlAta AshcharyyaM jagAma|</para>
  <para style="p">
    <verse number="6" style="v"/>apara ncha kArAbaddhe kastiMshchit jane tanmahotsavakAle lokai ryAchite deshAdhipatistaM mochayati|</para>
  <para style="p">
    <verse number="7" style="v"/>ye cha pUrvvamupaplavamakArShurupaplave vadhamapi kR^itavantasteShAM madhye tadAnoM barabbAnAmaka eko baddha AsIt|</para>
  <para style="p">
    <verse number="8" style="v"/>ato hetoH pUrvvAparIyAM rItikathAM kathayitvA lokA uchchairuvantaH pIlAtasya samakShaM nivedayAmAsuH|</para>
  <para style="p">
    <verse number="9" style="v"/>tadA pIlAtastAnAchakhyau tarhi kiM yihUdIyAnAM rAjAnaM mochayiShyAmi? yuShmAbhiH kimiShyate?</para>
  <para style="p">
    <verse number="10" style="v"/>yataH pradhAnayAjakA IrShyAta eva yIshuM samArpayanniti sa viveda|</para>
  <para style="p">
    <verse number="11" style="v"/>kintu yathA barabbAM mochayati tathA prArthayituM pradhAnayAjakA lokAn pravarttayAmAsuH|</para>
  <para style="p">
    <verse number="12" style="v"/>atha pIlAtaH punaH pR^iShTavAn tarhi yaM yihUdIyAnAM rAjeti vadatha tasya kiM kariShyAmi yuShmAbhiH kimiShyate?</para>
  <para style="p">
    <verse number="13" style="v"/>tadA te punarapi prochchaiH prochustaM krushe vedhaya|</para>
  <para style="p">
    <verse number="14" style="v"/>tasmAt pIlAtaH kathitavAn kutaH? sa kiM kukarmma kR^itavAn? kintu te punashcha ruvanto vyAjahrustaM krushe vedhaya|</para>
  <para style="p">
    <verse number="15" style="v"/>tadA pIlAtaH sarvvAllokAn toShayitumichChan barabbAM mochayitvA yIshuM kashAbhiH prahR^itya krushe veddhuM taM samarpayAmbabhUva|</para>
  <para style="p">
    <verse number="16" style="v"/>anantaraM sainyagaNo.aTTAlikAm arthAd adhipate rgR^ihaM yIshuM nItvA senAnivahaM samAhuyat|</para>
  <para style="p">
    <verse number="17" style="v"/>pashchAt te taM dhUmalavarNavastraM paridhApya kaNTakamukuTaM rachayitvA shirasi samAropya</para>
  <para style="p">
    <verse number="18" style="v"/>he yihUdIyAnAM rAjan namaskAra ityuktvA taM namaskarttAmArebhire|</para>
  <para style="p">
    <verse number="19" style="v"/>tasyottamA Nge vetrAghAtaM chakrustadgAtre niShThIva ncha nichikShipuH, tathA tasya sammukhe jAnupAtaM praNomuH</para>
  <para style="p">
    <verse number="20" style="v"/>itthamupahasya dhUmravarNavastram uttAryya tasya vastraM taM paryyadhApayan krushe veddhuM bahirninyushcha|</para>
  <para style="p">
    <verse number="21" style="v"/>tataH paraM sekandarasya ruphasya cha pitA shimonnAmA kurINIyaloka ekaH kutashchid grAmAdetya pathi yAti taM te yIshoH krushaM voDhuM balAd dadhnuH|</para>
  <para style="p">
    <verse number="22" style="v"/>atha gulgaltA arthAt shiraHkapAlanAmakaM sthAnaM yIshumAnIya</para>
  <para style="p">
    <verse number="23" style="v"/>te gandharasamishritaM drAkShArasaM pAtuM tasmai daduH kintu sa na jagrAha|</para>
  <para style="p">
    <verse number="24" style="v"/>tasmin krushe viddhe sati teShAmekaikashaH kiM prApsyatIti nirNayAya</para>
  <para style="p">
    <verse number="25" style="v"/>tasya paridheyAnAM vibhAgArthaM guTikApAtaM chakruH|</para>
  <para style="p">
    <verse number="26" style="v"/>aparam eSha yihUdIyAnAM rAjeti likhitaM doShapatraM tasya shiraUrdvvam AropayA nchakruH|</para>
  <para style="p">
    <verse number="27" style="v"/>tasya vAmadakShiNayo rdvau chaurau krushayo rvividhAte|</para>
  <para style="p">
    <verse number="28" style="v"/>tenaiva "aparAdhijanaiH sArddhaM sa gaNito bhaviShyati," iti shAstroktaM vachanaM siddhamabhUta|</para>
  <para style="p">
    <verse number="29" style="v"/>anantaraM mArge ye ye lokA gamanAgamane chakruste sarvva eva shirAMsyAndolya nindanto jagaduH, re mandiranAshaka re dinatrayamadhye tannirmmAyaka,</para>
  <para style="p">
    <verse number="30" style="v"/>adhunAtmAnam avitvA krushAdavaroha|</para>
  <para style="p">
    <verse number="31" style="v"/>ki ncha pradhAnayAjakA adhyApakAshcha tadvat tiraskR^itya parasparaM chachakShire eSha parAnAvat kintu svamavituM na shaknoti|</para>
  <para style="p">
    <verse number="32" style="v"/>yadIsrAyelo rAjAbhiShiktastrAtA bhavati tarhyadhunaina krushAdavarohatu vayaM tad dR^iShTvA vishvasiShyAmaH; ki ncha yau lokau tena sArddhaM krushe .avidhyetAM tAvapi taM nirbhartsayAmAsatuH|</para>
  <para style="p">
    <verse number="33" style="v"/>atha dvitIyayAmAt tR^itIyayAmaM yAvat sarvvo deshaH sAndhakArobhUt|</para>
  <para style="p">
    <verse number="34" style="v"/>tatastR^itIyaprahare yIshuruchchairavadat elI elI lAmA shivaktanI arthAd "he madIsha madIsha tvaM paryyatyAkShIH kuto hi mAM?"</para>
  <para style="p">
    <verse number="35" style="v"/>tadA samIpasthalokAnAM kechit tadvAkyaM nishamyAchakhyuH pashyaiSha eliyam AhUyati|</para>
  <para style="p">
    <verse number="36" style="v"/>tata eko jano dhAvitvAgatya spa nje .amlarasaM pUrayitvA taM naDAgre nidhAya pAtuM tasmai dattvAvadat tiShTha eliya enamavarohayitum eti na veti pashyAmi|</para>
  <para style="p">
    <verse number="37" style="v"/>atha yIshuruchchaiH samAhUya prANAn jahau|</para>
  <para style="p">
    <verse number="38" style="v"/>tadA mandirasya javanikordvvAdadhaHryyantA vidIrNA dvikhaNDAbhUt|</para>
  <para style="p">
    <verse number="39" style="v"/>ki ncha itthamuchchairAhUya prANAn tyajantaM taM dR^iShdvA tadrakShaNAya niyukto yaH senApatirAsIt sovadat naroyam Ishvaraputra iti satyam|</para>
  <para style="p">
    <verse number="40" style="v"/>tadAnIM magdalInI marisam kaniShThayAkUbo yoseshcha mAtAnyamariyam shAlomI cha yAH striyo</para>
  <para style="p">
    <verse number="41" style="v"/>gAlIlpradeshe yIshuM sevitvA tadanugAminyo jAtA imAstadanyAshcha yA anekA nAryo yIshunA sArddhaM yirUshAlamamAyAtAstAshcha dUrAt tAni dadR^ishuH|</para>
  <para style="p">
    <verse number="42" style="v"/>athAsAdanadinasyArthAd vishrAmavArAt pUrvvadinasya sAyaMkAla Agata</para>
  <para style="p">
    <verse number="43" style="v"/>IshvararAjyApekShyarimathIyayUShaphanAmA mAnyamantrI sametya pIlAtasavidhaM nirbhayo gatvA yIshordehaM yayAche|</para>
  <para style="p">
    <verse number="44" style="v"/>kintu sa idAnIM mR^itaH pIlAta ityasambhavaM matvA shatasenApatimAhUya sa kadA mR^ita iti paprachCha|</para>
  <para style="p">
    <verse number="45" style="v"/>shatasemanApatimukhAt tajj nAtvA yUShaphe yIshordehaM dadau|</para>
  <para style="p">
    <verse number="46" style="v"/>pashchAt sa sUkShmaM vAsaH krItvA yIshoH kAyamavarohya tena vAsasA veShTAyitvA girau khAtashmashAne sthApitavAn pAShANaM loThayitvA dvAri nidadhe|</para>
  <para style="p">
    <verse number="47" style="v"/>kintu yatra sosthApyata tata magdalInI mariyam yosimAtR^imariyam cha dadR^ishatR^iH|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha vishrAmavAre gate magdalInI mariyam yAkUbamAtA mariyam shAlomI chemAstaM marddayituM sugandhidravyANi krItvA</para>
  <para style="p">
    <verse number="2" style="v"/>saptAhaprathamadine.atipratyUShe sUryyodayakAle shmashAnamupagatAH|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu shmashAnadvArapAShANo.atibR^ihan taM ko.apasArayiShyatIti tAH parasparaM gadanti!</para>
  <para style="p">
    <verse number="4" style="v"/>etarhi nirIkShya pAShANo dvAro .apasArita iti dadR^ishuH|</para>
  <para style="p">
    <verse number="5" style="v"/>pashchAttAH shmashAnaM pravishya shuklavarNadIrghaparichChadAvR^itamekaM yuvAnaM shmashAnadakShiNapArshva upaviShTaM dR^iShTvA chamachchakruH|</para>
  <para style="p">
    <verse number="6" style="v"/>so.avadat, mAbhaiShTa yUyaM krushe hataM nAsaratIyayIshuM gaveShayatha sotra nAsti shmashAnAdudasthAt; tai ryatra sa sthApitaH sthAnaM tadidaM pashyata|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu tena yathoktaM tathA yuShmAkamagre gAlIlaM yAsyate tatra sa yuShmAn sAkShAt kariShyate yUyaM gatvA tasya shiShyebhyaH pitarAya cha vArttAmimAM kathayata|</para>
  <para style="p">
    <verse number="8" style="v"/>tAH kampitA vistitAshcha tUrNaM shmashAnAd bahirgatvA palAyanta bhayAt kamapi kimapi nAvadaMshcha|</para>
  <para style="p">
    <verse number="9" style="v"/>aparaM yIshuH saptAhaprathamadine pratyUShe shmashAnAdutthAya yasyAH saptabhUtAstyAjitAstasyai magdalInImariyame prathamaM darshanaM dadau|</para>
  <para style="p">
    <verse number="10" style="v"/>tataH sA gatvA shokarodanakR^idbhyo.anugatalokebhyastAM vArttAM kathayAmAsa|</para>
  <para style="p">
    <verse number="11" style="v"/>kintu yIshuH punarjIvan tasyai darshanaM dattavAniti shrutvA te na pratyayan|</para>
  <para style="p">
    <verse number="12" style="v"/>pashchAt teShAM dvAyo rgrAmayAnakAle yIshuranyaveshaM dhR^itvA tAbhyAM darshana dadau!</para>
  <para style="p">
    <verse number="13" style="v"/>tAvapi gatvAnyashiShyebhyastAM kathAM kathayA nchakratuH kintu tayoH kathAmapi te na pratyayan|</para>
  <para style="p">
    <verse number="14" style="v"/>sheShata ekAdashashiShyeShu bhojanopaviShTeShu yIshustebhyo darshanaM dadau tathotthAnAt paraM taddarshanaprAptalokAnAM kathAyAmavishvAsakaraNAt teShAmavishvAsamanaHkAThinyAbhyAM hetubhyAM sa tAMstarjitavAn|</para>
  <para style="p">
    <verse number="15" style="v"/>atha tAnAchakhyau yUyaM sarvvajagad gatvA sarvvajanAn prati susaMvAdaM prachArayata|</para>
  <para style="p">
    <verse number="16" style="v"/>tatra yaH kashchid vishvasya majjito bhavet sa paritrAsyate kintu yo na vishvasiShyati sa daNDayiShyate|</para>
  <para style="p">
    <verse number="17" style="v"/>ki ncha ye pratyeShyanti tairIdR^ig AshcharyyaM karmma prakAshayiShyate te mannAmnA bhUtAn tyAjayiShyanti bhAShA anyAshcha vadiShyanti|</para>
  <para style="p">
    <verse number="18" style="v"/>aparaM taiH sarpeShu dhR^iteShu prANanAshakavastuni pIte cha teShAM kApi kShati rna bhaviShyati; rogiNAM gAtreShu karArpite te.arogA bhaviShyanti cha|</para>
  <para style="p">
    <verse number="19" style="v"/>atha prabhustAnityAdishya svargaM nItaH san parameshvarasya dakShiNa upavivesha|</para>
  <para style="p">
    <verse number="20" style="v"/>tataste prasthAya sarvvatra susaMvAdIyakathAM prachArayitumArebhire prabhustu teShAM sahAyaH san prakAshitAshcharyyakriyAbhistAM kathAM pramANavatIM chakAra| iti|</para>
</usx>
