  <para style="h">Ephesians</para>
  <para style="toc1">iphiShiNaH patraM</para>
  <para style="toc2">iphiShiNaH</para>
  <para style="toc3">iphiShiNaH</para>
  <para style="mt1">iphiShiNaH patraM</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>IshvarasyechChayA yIshukhrIShTasya preritaH paula iphiShanagarasthAn pavitrAn khrIShTayIshau vishvAsino lokAn prati patraM likhati|</para>
  <para style="p">
    <verse number="2" style="v"/>asmAkaM tAtasyeshvarasya prabho ryIshukhrIShTasya chAnugrahaH shAntishcha yuShmAsu varttatAM|</para>
  <para style="p">
    <verse number="3" style="v"/>asmAkaM prabho ryIshoH khrIShTasya tAta Ishvaro dhanyo bhavatu; yataH sa khrIShTenAsmabhyaM sarvvam AdhyAtmikaM svargIyavaraM dattavAn|</para>
  <para style="p">
    <verse number="4" style="v"/>vayaM yat tasya samakShaM premnA pavitrA niShkala NkAshcha bhavAmastadarthaM sa jagataH sR^iShTe pUrvvaM tenAsmAn abhirochitavAn, nijAbhilaShitAnurodhAchcha</para>
  <para style="p">
    <verse number="5" style="v"/>yIshunA khrIShTena svasya nimittaM putratvapade.asmAn svakIyAnugrahasya mahattvasya prashaMsArthaM pUrvvaM niyuktavAn|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmAd anugrahAt sa yena priyatamena putreNAsmAn anugR^ihItavAn,</para>
  <para style="p">
    <verse number="7" style="v"/>vayaM tasya shoNitena muktim arthataH pApakShamAM labdhavantaH|</para>
  <para style="p">
    <verse number="8" style="v"/>tasya ya IdR^isho.anugrahanidhistasmAt so.asmabhyaM sarvvavidhaM j nAnaM buddhi ncha bAhulyarUpeNa vitaritavAn|</para>
  <para style="p">
    <verse number="9" style="v"/>svargapR^ithivyo ryadyad vidyate tatsarvvaM sa khrIShTe saMgrahIShyatIti hitaiShiNA</para>
  <para style="p">
    <verse number="10" style="v"/>tena kR^ito yo manorathaH sampUrNatAM gatavatsu samayeShu sAdhayitavyastamadhi sa svakIyAbhilAShasya nigUDhaM bhAvam asmAn j nApitavAn|</para>
  <para style="p">
    <verse number="11" style="v"/>pUrvvaM khrIShTe vishvAsino ye vayam asmatto yat tasya mahimnaH prashaMsA jAyate,</para>
  <para style="p">
    <verse number="12" style="v"/>tadarthaM yaH svakIyechChAyAH mantraNAtaH sarvvANi sAdhayati tasya manorathAd vayaM khrIShTena pUrvvaM nirUpitAH santo.adhikAriNo jAtAH|</para>
  <para style="p">
    <verse number="13" style="v"/>yUyamapi satyaM vAkyam arthato yuShmatparitrANasya susaMvAdaM nishamya tasminneva khrIShTe vishvasitavantaH pratij nAtena pavitreNAtmanA mudrayevA NkitAshcha|</para>
  <para style="p">
    <verse number="14" style="v"/>yatastasya mahimnaH prakAshAya tena krItAnAM lokAnAM mukti ryAvanna bhaviShyati tAvat sa AtmAsmAkam adhikAritvasya satya NkArasya paNasvarUpo bhavati|</para>
  <para style="p">
    <verse number="15" style="v"/>prabhau yIshau yuShmAkaM vishvAsaH sarvveShu pavitralokeShu prema chAsta iti vArttAM shrutvAhamapi</para>
  <para style="p">
    <verse number="16" style="v"/>yuShmAnadhi nirantaram IshvaraM dhanyaM vadan prArthanAsamaye cha yuShmAn smaran varamimaM yAchAmi|</para>
  <para style="p">
    <verse number="17" style="v"/>asmAkaM prabho ryIshukhrIShTasya tAto yaH prabhAvAkara IshvaraH sa svakIyatattvaj nAnAya yuShmabhyaM j nAnajanakam prakAshitavAkyabodhaka nchAtmAnaM deyAt|</para>
  <para style="p">
    <verse number="18" style="v"/>yuShmAkaM j nAnachakShUMShi cha dIptiyuktAni kR^itvA tasyAhvAnaM kIdR^ishyA pratyAshayA sambalitaM pavitralokAnAM madhye tena datto.adhikAraH kIdR^ishaH prabhAvanidhi rvishvAsiShu chAsmAsu prakAshamAnasya</para>
  <para style="p">
    <verse number="19" style="v"/>tadIyamahAparAkramasya mahatvaM kIdR^ig anupamaM tat sarvvaM yuShmAn j nApayatu|</para>
  <para style="p">
    <verse number="20" style="v"/>yataH sa yasyAH shakteH prabalatAM khrIShTe prakAshayan mR^itagaNamadhyAt tam utthApitavAn,</para>
  <para style="p">
    <verse number="21" style="v"/>adhipatitvapadaM shAsanapadaM parAkramo rAjatva nchetinAmAni yAvanti padAnIha loke paraloke cha vidyante teShAM sarvveShAm Urddhve svarge nijadakShiNapArshve tam upaveshitavAn,</para>
  <para style="p">
    <verse number="22" style="v"/>sarvvANi tasya charaNayoradho nihitavAn yA samitistasya sharIraM sarvvatra sarvveShAM pUrayituH pUraka ncha bhavati taM tasyA mUrddhAnaM kR^itvA</para>
  <para style="p">
    <verse number="23" style="v"/>sarvveShAm uparyyupari niyuktavAMshcha saiva shaktirasmAsvapi tena prakAshyate|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>purA yUyam aparAdhaiH pApaishcha mR^itAH santastAnyAcharanta ihalokasya saMsArAnusAreNAkAsharAjyasyAdhipatim</para>
  <para style="p">
    <verse number="2" style="v"/>arthataH sAmpratam Aj nAla NghivaMsheShu karmmakAriNam AtmAnam anvavrajata|</para>
  <para style="p">
    <verse number="3" style="v"/>teShAM madhye sarvve vayamapi pUrvvaM sharIrasya manaskAmanAyA nchehAM sAdhayantaH svasharIrasyAbhilAShAn AcharAma sarvve.anya iva cha svabhAvataH krodhabhajanAnyabhavAma|</para>
  <para style="p">
    <verse number="4" style="v"/>kintu karuNAnidhirIshvaro yena mahApremnAsmAn dayitavAn</para>
  <para style="p">
    <verse number="5" style="v"/>tasya svapremno bAhulyAd aparAdhai rmR^itAnapyasmAn khrIShTena saha jIvitavAn yato.anugrahAd yUyaM paritrANaM prAptAH|</para>
  <para style="p">
    <verse number="6" style="v"/>sa cha khrIShTena yIshunAsmAn tena sArddham utthApitavAn svarga upaveshitavAMshcha|</para>
  <para style="p">
    <verse number="7" style="v"/>itthaM sa khrIShTena yIshunAsmAn prati svahitaiShitayA bhAviyugeShu svakIyAnugrahasyAnupamaM nidhiM prakAshayitum ichChati|</para>
  <para style="p">
    <verse number="8" style="v"/>yUyam anugrahAd vishvAsena paritrANaM prAptAH, tachcha yuShmanmUlakaM nahi kintvIshvarasyaiva dAnaM,</para>
  <para style="p">
    <verse number="9" style="v"/>tat karmmaNAM phalam api nahi, ataH kenApi na shlAghitavyaM|</para>
  <para style="p">
    <verse number="10" style="v"/>yato vayaM tasya kAryyaM prAg IshvareNa nirUpitAbhiH satkriyAbhiH kAlayApanAya khrIShTe yIshau tena mR^iShTAshcha|</para>
  <para style="p">
    <verse number="11" style="v"/>purA janmanA bhinnajAtIyA hastakR^itaM tvakChedaM prAptai rlokaishchAchChinnatvacha itinAmnA khyAtA ye yUyaM tai ryuShmAbhiridaM smarttavyaM</para>
  <para style="p">
    <verse number="12" style="v"/>yat tasmin samaye yUyaM khrIShTAd bhinnA isrAyelalokAnAM sahavAsAd dUrasthAH pratij nAsambalitaniyamAnAM bahiH sthitAH santo nirAshA nirIshvarAshcha jagatyAdhvam iti|</para>
  <para style="p">
    <verse number="13" style="v"/>kintvadhunA khrIShTe yIshAvAshrayaM prApya purA dUravarttino yUyaM khrIShTasya shoNitena nikaTavarttino.abhavata|</para>
  <para style="p">
    <verse number="14" style="v"/>yataH sa evAsmAkaM sandhiH sa dvayam ekIkR^itavAn shatrutArUpiNIM madhyavarttinIM prabhedakabhittiM bhagnavAn daNDAj nAyuktaM vidhishAstraM svasharIreNa luptavAMshcha|</para>
  <para style="p">
    <verse number="15" style="v"/>yataH sa sandhiM vidhAya tau dvau svasmin ekaM nutanaM mAnavaM karttuM</para>
  <para style="p">
    <verse number="16" style="v"/>svakIyakrushe shatrutAM nihatya tenaivaikasmin sharIre tayo rdvayorIshvareNa sandhiM kArayituM nishchatavAn|</para>
  <para style="p">
    <verse number="17" style="v"/>sa chAgatya dUravarttino yuShmAn nikaTavarttino .asmAMshcha sandhe rma NgalavArttAM j nApitavAn|</para>
  <para style="p">
    <verse number="18" style="v"/>yatastasmAd ubhayapakShIyA vayam ekenAtmanA pituH samIpaM gamanAya sAmarthyaM prAptavantaH|</para>
  <para style="p">
    <verse number="19" style="v"/>ata idAnIM yUyam asamparkIyA videshinashcha na tiShThanataH pavitralokaiH sahavAsina Ishvarasya veshmavAsinashchAdhve|</para>
  <para style="p">
    <verse number="20" style="v"/>aparaM preritA bhaviShyadvAdinashcha yatra bhittimUlasvarUpAstatra yUyaM tasmin mUle nichIyadhve tatra cha svayaM yIshuH khrIShTaH pradhAnaH koNasthaprastaraH|</para>
  <para style="p">
    <verse number="21" style="v"/>tena kR^itsnA nirmmitiH saMgrathyamAnA prabhoH pavitraM mandiraM bhavituM varddhate|</para>
  <para style="p">
    <verse number="22" style="v"/>yUyamapi tatra saMgrathyamAnA Atmaneshvarasya vAsasthAnaM bhavatha|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ato heto rbhinnajAtIyAnAM yuShmAkaM nimittaM yIshukhrIShTasya bandI yaH so.ahaM paulo bravImi|</para>
  <para style="p">
    <verse number="2" style="v"/>yuShmadartham IshvareNa mahyaM dattasya varasya niyamaH kIdR^ishastad yuShmAbhirashrAvIti manye|</para>
  <para style="p">
    <verse number="3" style="v"/>arthataH pUrvvaM mayA saMkShepeNa yathA likhitaM tathAhaM prakAshitavAkyeneshvarasya nigUDhaM bhAvaM j nApito.abhavaM|</para>
  <para style="p">
    <verse number="4" style="v"/>ato yuShmAbhistat paThitvA khrIShTamadhi tasminnigUDhe bhAve mama j nAnaM kIdR^ishaM tad bhotsyate|</para>
  <para style="p">
    <verse number="5" style="v"/>pUrvvayugeShu mAnavasantAnAstaM j nApitA nAsan kintvadhunA sa bhAvastasya pavitrAn preritAn bhaviShyadvAdinashcha pratyAtmanA prakAshito.abhavat;</para>
  <para style="p">
    <verse number="6" style="v"/>arthata Ishvarasya shakteH prakAshAt tasyAnugraheNa yo varo mahyam adAyi tenAhaM yasya susaMvAdasya parichArako.abhavaM,</para>
  <para style="p">
    <verse number="7" style="v"/>tadvArA khrIShTena bhinnajAtIyA anyaiH sArddham ekAdhikArA ekasharIrA ekasyAH pratij nAyA aMshinashcha bhaviShyantIti|</para>
  <para style="p">
    <verse number="8" style="v"/>sarvveShAM pavitralokAnAM kShudratamAya mahyaM varo.ayam adAyi yad bhinnajAtIyAnAM madhye bodhAgayasya guNanidheH khrIShTasya ma NgalavArttAM prachArayAmi,</para>
  <para style="p">
    <verse number="9" style="v"/>kAlAvasthAtaH pUrvvasmAchcha yo nigUDhabhAva Ishvare gupta AsIt tadIyaniyamaM sarvvAn j nApayAmi|</para>
  <para style="p">
    <verse number="10" style="v"/>yata Ishvarasya nAnArUpaM j nAnaM yat sAmprataM samityA svarge prAdhAnyaparAkramayuktAnAM dUtAnAM nikaTe prakAshyate tadarthaM sa yIshunA khrIShTena sarvvANi sR^iShTavAn|</para>
  <para style="p">
    <verse number="11" style="v"/>yato vayaM yasmin vishvasya dR^iDhabhaktyA nirbhayatAm Ishvarasya samAgame sAmarthya ncha</para>
  <para style="p">
    <verse number="12" style="v"/>prAptavantastamasmAkaM prabhuM yIshuM khrIShTamadhi sa kAlAvasthAyAH pUrvvaM taM manorathaM kR^itavAn|</para>
  <para style="p">
    <verse number="13" style="v"/>ato.ahaM yuShmannimittaM duHkhabhogena klAntiM yanna gachChAmIti prArthaye yatastadeva yuShmAkaM gauravaM|</para>
  <para style="p">
    <verse number="14" style="v"/>ato hetoH svargapR^ithivyoH sthitaH kR^itsno vaMsho yasya nAmnA vikhyAtastam</para>
  <para style="p">
    <verse number="15" style="v"/>asmatprabho ryIshukhrIShTasya pitaramuddishyAhaM jAnunI pAtayitvA tasya prabhAvanidhito varamimaM prArthaye|</para>
  <para style="p">
    <verse number="16" style="v"/>tasyAtmanA yuShmAkam AntarikapuruShasya shakte rvR^iddhiH kriyatAM|</para>
  <para style="p">
    <verse number="17" style="v"/>khrIShTastu vishvAsena yuShmAkaM hR^idayeShu nivasatu| premaNi yuShmAkaM baddhamUlatvaM susthiratva ncha bhavatu|</para>
  <para style="p">
    <verse number="18" style="v"/>itthaM prasthatAyA dIrghatAyA gabhIratAyA uchchatAyAshcha bodhAya sarvvaiH pavitralokaiH prApyaM sAmarthyaM yuShmAbhi rlabhyatAM,</para>
  <para style="p">
    <verse number="19" style="v"/>j nAnAtiriktaM khrIShTasya prema j nAyatAm Ishvarasya sampUrNavR^iddhiparyyantaM yuShmAkaM vR^iddhi rbhavatu cha|</para>
  <para style="p">
    <verse number="20" style="v"/>asmAkam antare yA shaktiH prakAshate tayA sarvvAtiriktaM karmma kurvvan asmAkaM prArthanAM kalpanA nchAtikramituM yaH shaknoti</para>
  <para style="p">
    <verse number="21" style="v"/>khrIShTayIshunA samite rmadhye sarvveShu yugeShu tasya dhanyavAdo bhavatu| iti|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ato bandirahaM prabho rnAmnA yuShmAn vinaye yUyaM yenAhvAnenAhUtAstadupayuktarUpeNa</para>
  <para style="p">
    <verse number="2" style="v"/>sarvvathA namratAM mR^idutAM titikShAM parasparaM pramnA sahiShNutA nchAcharata|</para>
  <para style="p">
    <verse number="3" style="v"/>praNayabandhanena chAtmana eैkyaM rakShituM yatadhvaM|</para>
  <para style="p">
    <verse number="4" style="v"/>yUyam ekasharIrA ekAtmAnashcha tadvad AhvAnena yUyam ekapratyAshAprAptaye samAhUtAH|</para>
  <para style="p">
    <verse number="5" style="v"/>yuShmAkam ekaH prabhureko vishvAsa ekaM majjanaM, sarvveShAM tAtaH</para>
  <para style="p">
    <verse number="6" style="v"/>sarvvoparisthaH sarvvavyApI sarvveShAM yuShmAkaM madhyavarttI chaika Ishvara Aste|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu khrIShTasya dAnaparimANAnusArAd asmAkam ekaikasmai visheSho varo.adAyi|</para>
  <para style="p">
    <verse number="8" style="v"/>yathA likhitam Aste, "Urddhvam Aruhya jetR^in sa vijitya bandino.akarot| tataH sa manujebhyo.api svIyAn vyashrANayad varAn||"</para>
  <para style="p">
    <verse number="9" style="v"/>Urddhvam AruhyetivAkyasyAyamarthaH sa pUrvvaM pR^ithivIrUpaM sarvvAdhaHsthitaM sthAnam avatIrNavAn;</para>
  <para style="p">
    <verse number="10" style="v"/>yashchAvatIrNavAn sa eva svargANAm uparyyuparyyArUDhavAn yataH sarvvANi tena pUrayitavyAni|</para>
  <para style="p">
    <verse number="11" style="v"/>sa eva cha kAMshchana preritAn aparAn bhaviShyadvAdino.aparAn susaMvAdaprachArakAn aparAn pAlakAn upadeshakAMshcha niyuktavAn|</para>
  <para style="p">
    <verse number="12" style="v"/>yAvad vayaM sarvve vishvAsasyeshvaraputraviShayakasya tattvaj nAnasya chaikyaM sampUrNaM puruShartha nchArthataH khrIShTasya sampUrNaparimANasya samaM parimANaM na prApnumastAvat</para>
  <para style="p">
    <verse number="13" style="v"/>sa paricharyyAkarmmasAdhanAya khrIShTasya sharIrasya niShThAyai cha pavitralokAnAM siddhatAyAstAdR^isham upAyaM nishchitavAn|</para>
  <para style="p">
    <verse number="14" style="v"/>ataeva mAnuShANAM chAturIto bhramakadhUrttatAyAshChalAchcha jAtena sarvveNa shikShAvAyunA vayaM yad bAlakA iva dolAyamAnA na bhrAmyAma ityasmAbhi ryatitavyaM,</para>
  <para style="p">
    <verse number="15" style="v"/>premnA satyatAm AcharadbhiH sarvvaviShaye khrIShTam uddishya varddhitavya ncha, yataH sa mUrddhA,</para>
  <para style="p">
    <verse number="16" style="v"/>tasmAchchaikaikasyA Ngasya svasvaparimANAnusAreNa sAhAyyakaraNAd upakArakaiH sarvvaiH sandhibhiH kR^itsnasya sharIrasya saMyoge sammilane cha jAte premnA niShThAM labhamAnaM kR^itsnaM sharIraM vR^iddhiM prApnoti|</para>
  <para style="p">
    <verse number="17" style="v"/>yuShmAn ahaM prabhunedaM bravImyAdishAmi cha, anye bhinnajAtIyA iva yUyaM pUna rmAcharata|</para>
  <para style="p">
    <verse number="18" style="v"/>yataste svamanomAyAm AcharantyAntarikAj nAnAt mAnasikakAThinyAchcha timirAvR^itabuddhaya IshvarIyajIvanasya bagIrbhUtAshcha bhavanti,</para>
  <para style="p">
    <verse number="19" style="v"/>svAn chaitanyashUnyAn kR^itvA cha lobhena sarvvavidhAshauchAcharaNAya lampaTatAyAM svAn samarpitavantaH|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu yUyaM khrIShTaM na tAdR^ishaM parichitavantaH,</para>
  <para style="p">
    <verse number="21" style="v"/>yato yUyaM taM shrutavanto yA satyA shikShA yIshuto labhyA tadanusArAt tadIyopadeshaM prAptavantashcheti manye|</para>
  <para style="p">
    <verse number="22" style="v"/>tasmAt pUrvvakAlikAchArakArI yaH purAtanapuruSho mAyAbhilAShai rnashyati taM tyaktvA yuShmAbhi rmAnasikabhAvo nUtanIkarttavyaH,</para>
  <para style="p">
    <verse number="23" style="v"/>yo navapuruSha IshvarAnurUpeNa puNyena satyatAsahitena</para>
  <para style="p">
    <verse number="24" style="v"/>dhArmmikatvena cha sR^iShTaH sa eva paridhAtavyashcha|</para>
  <para style="p">
    <verse number="25" style="v"/>ato yUyaM sarvve mithyAkathanaM parityajya samIpavAsibhiH saha satyAlApaM kuruta yato vayaM parasparam a Ngapratya NgA bhavAmaH|</para>
  <para style="p">
    <verse number="26" style="v"/>aparaM krodhe jAte pApaM mA kurudhvam, ashAnte yuShmAkaM roShesUryyo.astaM na gachChatu|</para>
  <para style="p">
    <verse number="27" style="v"/>aparaM shayatAne sthAnaM mA datta|</para>
  <para style="p">
    <verse number="28" style="v"/>choraH punashchairyyaM na karotu kintu dInAya dAne sAmarthyaM yajjAyate tadarthaM svakarAbhyAM sadvR^ittyA parishramaM karotu|</para>
  <para style="p">
    <verse number="29" style="v"/>aparaM yuShmAkaM vadanebhyaH ko.api kadAlApo na nirgachChatu, kintu yena shroturupakAro jAyate tAdR^ishaH prayojanIyaniShThAyai phaladAyaka AlApo yuShmAkaM bhavatu|</para>
  <para style="p">
    <verse number="30" style="v"/>apara ncha yUyaM muktidinaparyyantam Ishvarasya yena pavitreNAtmanA mudrayA NkitA abhavata taM shokAnvitaM mA kuruta|</para>
  <para style="p">
    <verse number="31" style="v"/>aparaM kaTuvAkyaM roShaH koShaH kalaho nindA sarvvavidhadveShashchaitAni yuShmAkaM madhyAd dUrIbhavantu|</para>
  <para style="p">
    <verse number="32" style="v"/>yUyaM parasparaM hitaiShiNaH komalAntaHkaraNAshcha bhavata| aparam IshvaraH khrIShTena yadvad yuShmAkaM doShAn kShamitavAn tadvad yUyamapi parasparaM kShamadhvaM|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ato yUyaM priyabAlakA iveshvarasyAnukAriNo bhavata,</para>
  <para style="p">
    <verse number="2" style="v"/>khrIShTa iva premAchAraM kuruta cha, yataH so.asmAsu prema kR^itavAn asmAkaM vinimayena chAtmanivedanaM kR^itvA grAhyasugandhArthakam upahAraM bali ncheshvarAcha dattavAn|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu veshyAgamanaM sarvvavidhAshauchakriyA lobhashchaiteShAm uchchAraNamapi yuShmAkaM madhye na bhavatu, etadeva pavitralokAnAm uchitaM|</para>
  <para style="p">
    <verse number="4" style="v"/>aparaM kutsitAlApaH pralApaH shleShoktishcha na bhavatu yata etAnyanuchitAni kintvIshvarasya dhanyavAdo bhavatu|</para>
  <para style="p">
    <verse number="5" style="v"/>veshyAgAmyashauchAchArI devapUjaka iva gaNyo lobhI chaiteShAM koShi khrIShTasya rAjye.arthata Ishvarasya rAjye kamapyadhikAraM na prApsyatIti yuShmAbhiH samyak j nAyatAM|</para>
  <para style="p">
    <verse number="6" style="v"/>anarthakavAkyena ko.api yuShmAn na va nchayatu yatastAdR^igAchArahetoranAj nAgrAhiShu lokeShvIshvarasya kopo varttate|</para>
  <para style="p">
    <verse number="7" style="v"/>tasmAd yUyaM taiH sahabhAgino na bhavata|</para>
  <para style="p">
    <verse number="8" style="v"/>pUrvvaM yUyam andhakArasvarUpA AdhvaM kintvidAnIM prabhunA dIptisvarUpA bhavatha tasmAd dIpteH santAnA iva samAcharata|</para>
  <para style="p">
    <verse number="9" style="v"/>dIpte ryat phalaM tat sarvvavidhahitaiShitAyAM dharmme satyAlApe cha prakAshate|</para>
  <para style="p">
    <verse number="10" style="v"/>prabhave yad rochate tat parIkShadhvaM|</para>
  <para style="p">
    <verse number="11" style="v"/>yUyaM timirasya viphalakarmmaNAm aMshino na bhUtvA teShAM doShitvaM prakAshayata|</para>
  <para style="p">
    <verse number="12" style="v"/>yataste lokA rahami yad yad Acharanti taduchchAraNam api lajjAjanakaM|</para>
  <para style="p">
    <verse number="13" style="v"/>yato dIptyA yad yat prakAshyate tat tayA chakAsyate yachcha chakAsti tad dIptisvarUpaM bhavati|</para>
  <para style="p">
    <verse number="14" style="v"/>etatkAraNAd uktam Aste, "he nidrita prabudhyasva mR^itebhyashchotthitiM kuru| tatkR^ite sUryyavat khrIShTaH svayaM tvAM dyotayiShyati|"</para>
  <para style="p">
    <verse number="15" style="v"/>ataH sAvadhAnA bhavata, aj nAnA iva mAcharata kintu j nAnina iva satarkam Acharata|</para>
  <para style="p">
    <verse number="16" style="v"/>samayaM bahumUlyaM gaNayadhvaM yataH kAlA abhadrAH|</para>
  <para style="p">
    <verse number="17" style="v"/>tasmAd yUyam aj nAnA na bhavata kintu prabhorabhimataM kiM tadavagatA bhavata|</para>
  <para style="p">
    <verse number="18" style="v"/>sarvvanAshajanakena surApAnena mattA mA bhavata kintvAtmanA pUryyadhvaM|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaM gItai rgAnaiH pAramArthikakIrttanaishcha parasparam Alapanto manasA sArddhaM prabhum uddishya gAyata vAdayata cha|</para>
  <para style="p">
    <verse number="20" style="v"/>sarvvadA sarvvaviShaye.asmatprabho yIshoH khrIShTasya nAmnA tAtam IshvaraM dhanyaM vadata|</para>
  <para style="p">
    <verse number="21" style="v"/>yUyam IshvarAd bhItAH santa anye.apareShAM vashIbhUtA bhavata|</para>
  <para style="p">
    <verse number="22" style="v"/>he yoShitaH, yUyaM yathA prabhostathA svasvasvAmino vasha NgatA bhavata|</para>
  <para style="p">
    <verse number="23" style="v"/>yataH khrIShTo yadvat samite rmUrddhA sharIrasya trAtA cha bhavati tadvat svAmI yoShito mUrddhA|</para>
  <para style="p">
    <verse number="24" style="v"/>ataH samiti ryadvat khrIShTasya vashIbhUtA tadvad yoShidbhirapi svasvasvAmino vashatA svIkarttavyA|</para>
  <para style="p">
    <verse number="25" style="v"/>apara ncha he puruShAH, yUyaM khrIShTa iva svasvayoShitsu prIyadhvaM|</para>
  <para style="p">
    <verse number="26" style="v"/>sa khrIShTo.api samitau prItavAn tasyAH kR^ite cha svaprANAn tyaktavAn yataH sa vAkye jalamajjanena tAM pariShkR^itya pAvayitum</para>
  <para style="p">
    <verse number="27" style="v"/>aparaM tilakavalyAdivihInAM pavitrAM niShkala NkA ncha tAM samitiM tejasvinIM kR^itvA svahaste samarpayitu nchAbhilaShitavAn|</para>
  <para style="p">
    <verse number="28" style="v"/>tasmAt svatanuvat svayoShiti premakaraNaM puruShasyochitaM, yena svayoShiti prema kriyate tenAtmaprema kriyate|</para>
  <para style="p">
    <verse number="29" style="v"/>ko.api kadApi na svakIyAM tanum R^itIyitavAn kintu sarvve tAM vibhrati puShNanti cha| khrIShTo.api samitiM prati tadeva karoti,</para>
  <para style="p">
    <verse number="30" style="v"/>yato vayaM tasya sharIrasyA NgAni mAMsAsthIni cha bhavAmaH|</para>
  <para style="p">
    <verse number="31" style="v"/>etadarthaM mAnavaH svamAtApitaroै parityajya svabhAryyAyAm AsaMkShyati tau dvau janAvekA Ngau bhaviShyataH|</para>
  <para style="p">
    <verse number="32" style="v"/>etannigUDhavAkyaM gurutaraM mayA cha khrIShTasamitI adhi tad uchyate|</para>
  <para style="p">
    <verse number="33" style="v"/>ataeva yuShmAkam ekaiko jana Atmavat svayoShiti prIyatAM bhAryyApi svAminaM samAdarttuM yatatAM|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>he bAlakAH, yUyaM prabhum uddishya pitrorAj nAgrAhiNo bhavata yatastat nyAyyaM|</para>
  <para style="p">
    <verse number="2" style="v"/>tvaM nijapitaraM mAtara ncha sammanyasveti yo vidhiH sa pratij nAyuktaH prathamo vidhiH</para>
  <para style="p">
    <verse number="3" style="v"/>phalatastasmAt tava kalyANaM deshe cha dIrghakAlam Ayu rbhaviShyatIti|</para>
  <para style="p">
    <verse number="4" style="v"/>aparaM he pitaraH, yUyaM svabAlakAn mA roShayata kintu prabho rvinItyAdeshAbhyAM tAn vinayata|</para>
  <para style="p">
    <verse number="5" style="v"/>he dAsAH, yUyaM khrIShTam uddishya sabhayAH kampAnvitAshcha bhUtvA saralAntaHkaraNairaihikaprabhUnAm Aj nAgrAhiNo bhavata|</para>
  <para style="p">
    <verse number="6" style="v"/>dR^iShTigocharIyaparicharyyayA mAnuShebhyo rochituM mA yatadhvaM kintu khrIShTasya dAsA iva niviShTamanobhirIshcharasyechChAM sAdhayata|</para>
  <para style="p">
    <verse number="7" style="v"/>mAnavAn anuddishya prabhumevoddishya sadbhAvena dAsyakarmma kurudhvaM|</para>
  <para style="p">
    <verse number="8" style="v"/>dAsamuktayo ryena yat satkarmma kriyate tena tasya phalaM prabhuto lapsyata iti jAnIta cha|</para>
  <para style="p">
    <verse number="9" style="v"/>aparaM he prabhavaH, yuShmAbhi rbhartsanaM vihAya tAn prati nyAyyAcharaNaM kriyatAM yashcha kasyApi pakShapAtaM na karoti yuShmAkamapi tAdR^isha ekaH prabhuH svarge vidyata iti j nAyatAM|</para>
  <para style="p">
    <verse number="10" style="v"/>adhikantu he bhrAtaraH, yUyaM prabhunA tasya vikramayuktashaktyA cha balavanto bhavata|</para>
  <para style="p">
    <verse number="11" style="v"/>yUyaM yat shayatAnashChalAni nivArayituM shaknutha tadartham IshvarIyasusajjAM paridhaddhvaM|</para>
  <para style="p">
    <verse number="12" style="v"/>yataH kevalaM raktamAMsAbhyAm iti nahi kintu kartR^itvaparAkramayuktaistimirarAjyasyehalokasyAdhipatibhiH svargodbhavai rduShTAtmabhireva sArddham asmAbhi ryuddhaM kriyate|</para>
  <para style="p">
    <verse number="13" style="v"/>ato heto ryUyaM yayA saMkuेle dine.avasthAtuM sarvvANi parAjitya dR^iDhAH sthAtu ncha shakShyatha tAm IshvarIyasusajjAM gR^ihlIta|</para>
  <para style="p">
    <verse number="14" style="v"/>vastutastu satyatvena shR^i Nkhalena kaTiM baddhvA puNyena varmmaNA vakSha AchChAdya</para>
  <para style="p">
    <verse number="15" style="v"/>shAnteH suvArttayA jAtam utsAhaM pAdukAyugalaM pade samarpya tiShThata|</para>
  <para style="p">
    <verse number="16" style="v"/>yena cha duShTAtmano.agnibANAn sarvvAn nirvvApayituM shakShyatha tAdR^ishaM sarvvAchChAdakaM phalakaM vishvAsaM dhArayata|</para>
  <para style="p">
    <verse number="17" style="v"/>shirastraM paritrANam AtmanaH kha Nga ncheshvarasya vAkyaM dhArayata|</para>
  <para style="p">
    <verse number="18" style="v"/>sarvvasamaye sarvvayAchanena sarvvaprArthanena chAtmanA prArthanAM kurudhvaM tadarthaM dR^iDhAkA NkShayA jAgrataH sarvveShAM pavitralokAnAM kR^ite sadA prArthanAM kurudhvaM|</para>
  <para style="p">
    <verse number="19" style="v"/>aha ncha yasya susaMvAdasya shR^i NkhalabaddhaH prachArakadUto.asmi tam upayuktenotsAhena prachArayituM yathA shaknuyAM</para>
  <para style="p">
    <verse number="20" style="v"/>tathA nirbhayena svareNotsAhena cha susaMvAdasya nigUDhavAkyaprachArAya vaktR^iाtA yat mahyaM dIyate tadarthaM mamApi kR^ite prArthanAM kurudhvaM|</para>
  <para style="p">
    <verse number="21" style="v"/>aparaM mama yAvasthAsti yachcha mayA kriyate tat sarvvaM yad yuShmAbhi rj nAyate tadarthaM prabhunA priyabhrAtA vishvAsyaH parichArakashcha tukhiko yuShmAn tat j nApayiShyati|</para>
  <para style="p">
    <verse number="22" style="v"/>yUyaM yad asmAkam avasthAM jAnItha yuShmAkaM manAMsi cha yat sAntvanAM labhante tadarthamevAhaM yuShmAkaM sannidhiM taM preShitavAna|</para>
  <para style="p">
    <verse number="23" style="v"/>aparam IshvaraH prabhu ryIshukhrIShTashcha sarvvebhyo bhrAtR^ibhyaH shAntiM vishvAsasahitaM prema cha deyAt|</para>
  <para style="p">
    <verse number="24" style="v"/>ye kechit prabhau yIshukhrIShTe.akShayaM prema kurvvanti tAn prati prasAdo bhUyAt| tathAstu|</para>
</usx>
