  <para style="h">Luke</para>
  <para style="toc1">lUkalikhitaH susaMvAdaH</para>
  <para style="toc2">lUkaH</para>
  <para style="toc3">lUkaH</para>
  <para style="mt1">lUkalikhitaH susaMvAdaH</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>prathamato ye sAkShiNo vAkyaprachArakAshchAsan te.asmAkaM madhye yadyat sapramANaM vAkyamarpayanti sma</para>
  <para style="p">
    <verse number="2" style="v"/>tadanusArato.anyepi bahavastadvR^ittAntaM rachayituM pravR^ittAH|</para>
  <para style="p">
    <verse number="3" style="v"/>ataeva he mahAmahimathiyaphil tvaM yA yAH kathA ashikShyathAstAsAM dR^iDhapramANAni yathA prApnoShi</para>
  <para style="p">
    <verse number="4" style="v"/>tadarthaM prathamamArabhya tAni sarvvANi j nAtvAhamapi anukramAt sarvvavR^ittAntAn tubhyaM lekhituM matimakArSham|</para>
  <para style="p">
    <verse number="5" style="v"/>yihUdAdeshIyaherodnAmake rAjatvaM kurvvati abIyayAjakasya paryyAyAdhikArI sikhariyanAmaka eko yAjako hAroNavaMshodbhavA ilIshevAkhyA</para>
  <para style="p">
    <verse number="6" style="v"/>tasya jAyA dvAvimau nirdoShau prabhoH sarvvAj nA vyavasthAshcha saMmanya IshvaradR^iShTau dhArmmikAvAstAm|</para>
  <para style="p">
    <verse number="7" style="v"/>tayoH santAna ekopi nAsIt, yata ilIshevA bandhyA tau dvAveva vR^iddhAvabhavatAm|</para>
  <para style="p">
    <verse number="8" style="v"/>yadA svaparyyAnukrameNa sikhariya IshvAsya samakShaM yAjakIyaM karmma karoti</para>
  <para style="p">
    <verse number="9" style="v"/>tadA yaj nasya dinaparipAyyA parameshvarasya mandire praveshakAle dhUpajvAlanaM karmma tasya karaNIyamAsIt|</para>
  <para style="p">
    <verse number="10" style="v"/>taddhUpajvAlanakAle lokanivahe prArthanAM kartuM bahistiShThati</para>
  <para style="p">
    <verse number="11" style="v"/>sati sikhariyo yasyAM vedyAM dhUpaM jvAlayati taddakShiNapArshve parameshvarasya dUta eka upasthito darshanaM dadau|</para>
  <para style="p">
    <verse number="12" style="v"/>taM dR^iShTvA sikhariya udvivije shasha Nke cha|</para>
  <para style="p">
    <verse number="13" style="v"/>tadA sa dUtastaM babhAShe he sikhariya mA bhaistava prArthanA grAhyA jAtA tava bhAryyA ilIshevA putraM prasoShyate tasya nAma yoेhan iti kariShyasi|</para>
  <para style="p">
    <verse number="14" style="v"/>ki ncha tvaM sAnandaH saharShashcha bhaviShyasi tasya janmani bahava AnandiShyanti cha|</para>
  <para style="p">
    <verse number="15" style="v"/>yato hetoH sa parameshvarasya gochare mahAn bhaviShyati tathA drAkShArasaM surAM vA kimapi na pAsyati, aparaM janmArabhya pavitreNAtmanA paripUrNaH</para>
  <para style="p">
    <verse number="16" style="v"/>san isrAyelvaMshIyAn anekAn prabhoH parameshvarasya mArgamAneShyati|</para>
  <para style="p">
    <verse number="17" style="v"/>santAnAn prati pitR^iNAM manAMsi dharmmaj nAnaM pratyanAj nAgrAhiNashcha parAvarttayituM, prabhoH parameshvarasya sevArtham ekAM sajjitajAtiM vidhAtu ncha sa eliyarUpAtmashaktiprAptastasyAgre gamiShyati|</para>
  <para style="p">
    <verse number="18" style="v"/>tadA sikhariyo dUtamavAdIt kathametad vetsyAmi? yatohaM vR^iddho mama bhAryyA cha vR^iddhA|</para>
  <para style="p">
    <verse number="19" style="v"/>tato dUtaH pratyuvAcha pashyeshvarasya sAkShAdvarttI jibrAyelnAmA dUtohaM tvayA saha kathAM gadituM tubhyamimAM shubhavArttAM dAtu ncha preShitaH|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu madIyaM vAkyaM kAle phaliShyati tat tvayA na pratItam ataH kAraNAd yAvadeva tAni na setsyanti tAvat tvaM vaktuMmashakto mUko bhava|</para>
  <para style="p">
    <verse number="21" style="v"/>tadAnIM ye ye lokAH sikhariyamapaikShanta te madhyemandiraM tasya bahuvilambAd AshcharyyaM menire|</para>
  <para style="p">
    <verse number="22" style="v"/>sa bahirAgato yadA kimapi vAkyaM vaktumashaktaH sa NketaM kR^itvA niHshabdastasyau tadA madhyemandiraM kasyachid darshanaM tena prAptam iti sarvve bubudhire|</para>
  <para style="p">
    <verse number="23" style="v"/>anantaraM tasya sevanaparyyAye sampUrNe sati sa nijagehaM jagAma|</para>
  <para style="p">
    <verse number="24" style="v"/>katipayadineShu gateShu tasya bhAryyA ilIshevA garbbhavatI babhUva</para>
  <para style="p">
    <verse number="25" style="v"/>pashchAt sA pa nchamAsAn saMgopyAkathayat lokAnAM samakShaM mamApamAnaM khaNDayituM parameshvaro mayi dR^iShTiM pAtayitvA karmmedR^ishaM kR^itavAn|</para>
  <para style="p">
    <verse number="26" style="v"/>apara ncha tasyA garbbhasya ShaShThe mAse jAte gAlIlpradeshIyanAsaratpure</para>
  <para style="p">
    <verse number="27" style="v"/>dAyUdo vaMshIyAya yUShaphnAmne puruShAya yA mariyamnAmakumArI vAgdattAsIt tasyAH samIpaM jibrAyel dUta IshvareNa prahitaH|</para>
  <para style="p">
    <verse number="28" style="v"/>sa gatvA jagAda he IshvarAnugR^ihItakanye tava shubhaM bhUyAt prabhuH parameshvarastava sahAyosti nArINAM madhye tvameva dhanyA|</para>
  <para style="p">
    <verse number="29" style="v"/>tadAnIM sA taM dR^iShTvA tasya vAkyata udvijya kIdR^ishaM bhAShaNamidam iti manasA chintayAmAsa|</para>
  <para style="p">
    <verse number="30" style="v"/>tato dUto.avadat he mariyam bhayaM mAkArShIH, tvayi parameshvarasyAnugrahosti|</para>
  <para style="p">
    <verse number="31" style="v"/>pashya tvaM garbbhaM dhR^itvA putraM prasoShyase tasya nAma yIshuriti kariShyasi|</para>
  <para style="p">
    <verse number="32" style="v"/>sa mahAn bhaviShyati tathA sarvvebhyaH shreShThasya putra iti khyAsyati; aparaM prabhuH parameshvarastasya piturdAyUdaH siMhAsanaM tasmai dAsyati;</para>
  <para style="p">
    <verse number="33" style="v"/>tathA sa yAkUbo vaMshopari sarvvadA rAjatvaM kariShyati, tasya rAjatvasyAnto na bhaviShyati|</para>
  <para style="p">
    <verse number="34" style="v"/>tadA mariyam taM dUtaM babhAShe nAhaM puruShasa NgaM karomi tarhi kathametat sambhaviShyati?</para>
  <para style="p">
    <verse number="35" style="v"/>tato dUto.akathayat pavitra AtmA tvAmAshrAyiShyati tathA sarvvashreShThasya shaktistavopari ChAyAM kariShyati tato hetostava garbbhAd yaH pavitrabAlako janiShyate sa Ishvaraputra iti khyAtiM prApsyati|</para>
  <para style="p">
    <verse number="36" style="v"/>apara ncha pashya tava j nAtirilIshevA yAM sarvve bandhyAmavadan idAnIM sA vArddhakye santAnamekaM garbbhe.adhArayat tasya ShaShThamAsobhUt|</para>
  <para style="p">
    <verse number="37" style="v"/>kimapi karmma nAsAdhyam Ishvarasya|</para>
  <para style="p">
    <verse number="38" style="v"/>tadA mariyam jagAda, pashya prabherahaM dAsI mahyaM tava vAkyAnusAreNa sarvvametad ghaTatAm; ananataraM dUtastasyAH samIpAt pratasthe|</para>
  <para style="p">
    <verse number="39" style="v"/>atha katipayadinAt paraM mariyam tasmAt parvvatamayapradeshIyayihUdAyA nagaramekaM shIghraM gatvA</para>
  <para style="p">
    <verse number="40" style="v"/>sikhariyayAjakasya gR^ihaM pravishya tasya jAyAm ilIshevAM sambodhyAvadat|</para>
  <para style="p">
    <verse number="41" style="v"/>tato mariyamaH sambodhanavAkye ilIshevAyAH karNayoH praviShTamAtre sati tasyA garbbhasthabAlako nanartta| tata ilIshevA pavitreNAtmanA paripUrNA satI</para>
  <para style="p">
    <verse number="42" style="v"/>prochchairgaditumArebhe, yoShitAM madhye tvameva dhanyA, tava garbbhasthaH shishushcha dhanyaH|</para>
  <para style="p">
    <verse number="43" style="v"/>tvaM prabhormAtA, mama niveshane tvayA charaNAvarpitau, mamAdya saubhAgyametat|</para>
  <para style="p">
    <verse number="44" style="v"/>pashya tava vAkye mama karNayoH praviShTamAtre sati mamodarasthaH shishurAnandAn nanartta|</para>
  <para style="p">
    <verse number="45" style="v"/>yA strI vyashvasIt sA dhanyA, yato hetostAM prati parameshvaroktaM vAkyaM sarvvaM siddhaM bhaviShyati|</para>
  <para style="p">
    <verse number="46" style="v"/>tadAnIM mariyam jagAda| dhanyavAdaM pareshasya karoti mAmakaM manaH|</para>
  <para style="p">
    <verse number="47" style="v"/>mamAtmA tArakeshe cha samullAsaM pragachChati|</para>
  <para style="p">
    <verse number="48" style="v"/>akarot sa prabhu rduShTiM svadAsyA durgatiM prati| pashyAdyArabhya mAM dhanyAM vakShyanti puruShAH sadA|</para>
  <para style="p">
    <verse number="49" style="v"/>yaH sarvvashaktimAn yasya nAmApi cha pavitrakaM| sa eva sumahatkarmma kR^itavAn mannimittakaM|</para>
  <para style="p">
    <verse number="50" style="v"/>ye bibhyati janAstasmAt teShAM santAnapaMktiShu| anukampA tadIyA cha sarvvadaiva sutiShThati|</para>
  <para style="p">
    <verse number="51" style="v"/>svabAhubalatastena prAkAshyata parAkramaH| manaHkumantraNAsArddhaM vikIryyante.abhimAninaH|</para>
  <para style="p">
    <verse number="52" style="v"/>siMhAsanagatAllokAn balinashchAvarohya saH| padeShUchcheShu lokAMstu kShudrAn saMsthApayatyapi|</para>
  <para style="p">
    <verse number="53" style="v"/>kShudhitAn mAnavAn dravyairuttamaiH paritarpya saH| sakalAn dhanino lokAn visR^ijed riktahastakAn|</para>
  <para style="p">
    <verse number="54" style="v"/>ibrAhImi cha tadvaMshe yA dayAsti sadaiva tAM| smR^itvA purA pitR^iNAM no yathA sAkShAt pratishrutaM|</para>
  <para style="p">
    <verse number="55" style="v"/>isrAyelsevakastena tathopakriyate svayaM||</para>
  <para style="p">
    <verse number="56" style="v"/>anantaraM mariyam prAyeNa mAsatrayam ilIshevayA sahoShitvA vyAghuyya nijaniveshanaM yayau|</para>
  <para style="p">
    <verse number="57" style="v"/>tadanantaram ilIshevAyAH prasavakAla upasthite sati sA putraM prAsoShTa|</para>
  <para style="p">
    <verse number="58" style="v"/>tataH parameshvarastasyAM mahAnugrahaM kR^itavAn etat shrutvA samIpavAsinaH kuTumbAshchAgatya tayA saha mumudire|</para>
  <para style="p">
    <verse number="59" style="v"/>tathAShTame dine te bAlakasya tvachaM Chettum etya tasya pitR^inAmAnurUpaM tannAma sikhariya iti karttumIShuH|</para>
  <para style="p">
    <verse number="60" style="v"/>kintu tasya mAtAkathayat tanna, nAmAsya yohan iti karttavyam|</para>
  <para style="p">
    <verse number="61" style="v"/>tadA te vyAharan tava vaMshamadhye nAmedR^ishaM kasyApi nAsti|</para>
  <para style="p">
    <verse number="62" style="v"/>tataH paraM tasya pitaraM sikhariyaM prati sa Nketya paprachChuH shishoH kiM nAma kAriShyate?</para>
  <para style="p">
    <verse number="63" style="v"/>tataH sa phalakamekaM yAchitvA lilekha tasya nAma yohan bhaviShyati| tasmAt sarvve AshcharyyaM menire|</para>
  <para style="p">
    <verse number="64" style="v"/>tatkShaNaM sikhariyasya jihvAjADye.apagate sa mukhaM vyAdAya spaShTavarNamuchchAryya Ishvarasya guNAnuvAdaM chakAra|</para>
  <para style="p">
    <verse number="65" style="v"/>tasmAchchaturdiksthAH samIpavAsilokA bhItA evametAH sarvvAH kathA yihUdAyAH parvvatamayapradeshasya sarvvatra prachAritAH|</para>
  <para style="p">
    <verse number="66" style="v"/>tasmAt shrotAro manaHsu sthApayitvA kathayAmbabhUvuH kIdR^ishoyaM bAlo bhaviShyati? atha parameshvarastasya sahAyobhUt|</para>
  <para style="p">
    <verse number="67" style="v"/>tadA yohanaH pitA sikhariyaH pavitreNAtmanA paripUrNaH san etAdR^ishaM bhaviShyadvAkyaM kathayAmAsa|</para>
  <para style="p">
    <verse number="68" style="v"/>isrAyelaH prabhu ryastu sa dhanyaH parameshvaraH| anugR^ihya nijAllokAn sa eva parimochayet|</para>
  <para style="p">
    <verse number="69" style="v"/>vipakShajanahastebhyo yathA mochyAmahe vayaM| yAvajjIva ncha dharmmeNa sAralyena cha nirbhayAH|</para>
  <para style="p">
    <verse number="70" style="v"/>sevAmahai tamevaikam etatkAraNameva cha| svakIyaM supavitra ncha saMsmR^itya niyamaM sadA|</para>
  <para style="p">
    <verse number="71" style="v"/>kR^ipayA puruShAn pUrvvAn nikaShArthAttu naH pituH| ibrAhImaH samIpe yaM shapathaM kR^itavAn purA|</para>
  <para style="p">
    <verse number="72" style="v"/>tameva saphalaM karttaM tathA shatrugaNasya cha| R^iृtIyAkAriNashchaiva karebhyo rakShaNAya naH|</para>
  <para style="p">
    <verse number="73" style="v"/>sR^iShTeH prathamataH svIyaiH pavitrai rbhAvivAdibhiH|</para>
  <para style="p">
    <verse number="74" style="v"/>yathoktavAn tathA svasya dAyUdaH sevakasya tu|</para>
  <para style="p">
    <verse number="75" style="v"/>vaMshe trAtAramekaM sa samutpAditavAn svayam|</para>
  <para style="p">
    <verse number="76" style="v"/>ato he bAlaka tvantu sarvvebhyaH shreShTha eva yaH| tasyaiva bhAvivAdIti pravikhyAto bhaviShyasi| asmAkaM charaNAn kSheme mArge chAlayituM sadA| evaM dhvAnte.arthato mR^ityoshChAyAyAM ye tu mAnavAH|</para>
  <para style="p">
    <verse number="77" style="v"/>upaviShTAstu tAneva prakAshayitumeva hi| kR^itvA mahAnukampAM hi yAmeva parameshvaraH|</para>
  <para style="p">
    <verse number="78" style="v"/>UrdvvAt sUryyamudAyyaivAsmabhyaM prAdAttu darshanaM| tayAnukampayA svasya lokAnAM pApamochane|</para>
  <para style="p">
    <verse number="79" style="v"/>paritrANasya tebhyo hi j nAnavishrANanAya cha| prabho rmArgaM pariShkarttuM tasyAgrAyI bhaviShyasi||</para>
  <para style="p">
    <verse number="80" style="v"/>atha bAlakaH sharIreNa buddhyA cha varddhitumArebhe; apara ncha sa isrAyelo vaMshIyalokAnAM samIpe yAvanna prakaTIbhUtastAstAvat prAntare nyavasat|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>apara ncha tasmin kAle rAjyasya sarvveShAM lokAnAM nAmAni lekhayitum agastakaisara Aj nApayAmAsa|</para>
  <para style="p">
    <verse number="2" style="v"/>tadanusAreNa kurINiyanAmani suriyAdeshasya shAsake sati nAmalekhanaM prArebhe|</para>
  <para style="p">
    <verse number="3" style="v"/>ato heto rnAma lekhituM sarvve janAH svIyaM svIyaM nagaraM jagmuH|</para>
  <para style="p">
    <verse number="4" style="v"/>tadAnIM yUShaph nAma lekhituM vAgdattayA svabhAryyayA garbbhavatyA mariyamA saha svayaM dAyUdaH sajAtivaMsha iti kAraNAd gAlIlpradeshasya nAsaratnagarAd</para>
  <para style="p">
    <verse number="5" style="v"/>yihUdApradeshasya baitlehamAkhyaM dAyUdnagaraM jagAma|</para>
  <para style="p">
    <verse number="6" style="v"/>anyachcha tatra sthAne tayostiShThatoH sato rmariyamaH prasUtikAla upasthite</para>
  <para style="p">
    <verse number="7" style="v"/>sA taM prathamasutaM prAsoShTa kintu tasmin vAsagR^ihe sthAnAbhAvAd bAlakaM vastreNa veShTayitvA goshAlAyAM sthApayAmAsa|</para>
  <para style="p">
    <verse number="8" style="v"/>anantaraM ye kiyanto meShapAlakAH svameShavrajarakShAyai tatpradeshe sthitvA rajanyAM prAntare prahariNaH karmma kurvvanti,</para>
  <para style="p">
    <verse number="9" style="v"/>teShAM samIpaM parameshvarasya dUta Agatyopatasthau; tadA chatuShpArshve parameshvarasya tejasaH prakAshitatvAt te.atishasha Nkire|</para>
  <para style="p">
    <verse number="10" style="v"/>tadA sa dUta uvAcha mA bhaiShTa pashyatAdya dAyUdaH pure yuShmannimittaM trAtA prabhuH khrIShTo.ajaniShTa,</para>
  <para style="p">
    <verse number="11" style="v"/>sarvveShAM lokAnAM mahAnandajanakam imaM ma NgalavR^ittAntaM yuShmAn j nApayAmi|</para>
  <para style="p">
    <verse number="12" style="v"/>yUyaM (tatsthAnaM gatvA) vastraveShTitaM taM bAlakaM goshAlAyAM shayanaM drakShyatha yuShmAn pratIdaM chihnaM bhaviShyati|</para>
  <para style="p">
    <verse number="13" style="v"/>dUta imAM kathAM kathitavati tatrAkasmAt svargIyAH pR^itanA Agatya kathAm imAM kathayitveshvarasya guNAnanvavAdiShuH, yathA,</para>
  <para style="p">
    <verse number="14" style="v"/>sarvvordvvasthairIshvarasya mahimA samprakAshyatAM| shAntirbhUyAt pR^ithivyAstu santoShashcha narAn prati||</para>
  <para style="p">
    <verse number="15" style="v"/>tataH paraM teShAM sannidhe rdUtagaNe svargaM gate meShapAlakAH parasparam avechan AgachChata prabhuH parameshvaro yAM ghaTanAM j nApitavAn tasyA yAtharyaM j nAtuM vayamadhunA baitlehampuraM yAmaH|</para>
  <para style="p">
    <verse number="16" style="v"/>pashchAt te tUrNaM vrajitvA mariyamaM yUShaphaM goshAlAyAM shayanaM bAlaka ncha dadR^ishuH|</para>
  <para style="p">
    <verse number="17" style="v"/>itthaM dR^iShTvA bAlakasyArthe proktAM sarvvakathAM te prAchArayA nchakruH|</para>
  <para style="p">
    <verse number="18" style="v"/>tato ye lokA meSharakShakANAM vadanebhyastAM vArttAM shushruvuste mahAshcharyyaM menire|</para>
  <para style="p">
    <verse number="19" style="v"/>kintu mariyam etatsarvvaghaTanAnAM tAtparyyaM vivichya manasi sthApayAmAsa|</para>
  <para style="p">
    <verse number="20" style="v"/>tatpashchAd dUtavij naptAnurUpaM shrutvA dR^iShTvA cha meShapAlakA Ishvarasya guNAnuvAdaM dhanyavAda ncha kurvvANAH parAvR^itya yayuH|</para>
  <para style="p">
    <verse number="21" style="v"/>atha bAlakasya tvakChedanakAle.aShTamadivase samupasthite tasya garbbhasthiteH purvvaM svargIyadUto yathAj nApayat tadanurUpaM te tannAmadheyaM yIshuriti chakrire|</para>
  <para style="p">
    <verse number="22" style="v"/>tataH paraM mUsAlikhitavyavasthAyA anusAreNa mariyamaH shuchitvakAla upasthite,</para>
  <para style="p">
    <verse number="23" style="v"/>"prathamajaH sarvvaH puruShasantAnaH parameshvare samarpyatAM," iti parameshvarasya vyavasthayA</para>
  <para style="p">
    <verse number="24" style="v"/>yIshuM parameshvare samarpayitum shAstrIyavidhyuktaM kapotadvayaM pArAvatashAvakadvayaM vA baliM dAtuM te taM gR^ihItvA yirUshAlamam AyayuH|</para>
  <para style="p">
    <verse number="25" style="v"/>yirUshAlampuranivAsI shimiyonnAmA dhArmmika eka AsIt sa isrAyelaH sAntvanAmapekShya tasthau ki ncha pavitra AtmA tasminnAvirbhUtaH|</para>
  <para style="p">
    <verse number="26" style="v"/>aparaM prabhuNA parameshvareNAbhiShikte trAtari tvayA na dR^iShTe tvaM na mariShyasIti vAkyaM pavitreNa AtmanA tasma prAkathyata|</para>
  <para style="p">
    <verse number="27" style="v"/>apara ncha yadA yIshoH pitA mAtA cha tadarthaM vyavasthAnurUpaM karmma karttuM taM mandiram AninyatustadA</para>
  <para style="p">
    <verse number="28" style="v"/>shimiyon Atmana AkarShaNena mandiramAgatya taM kroDe nidhAya Ishvarasya dhanyavAdaM kR^itvA kathayAmAsa, yathA,</para>
  <para style="p">
    <verse number="29" style="v"/>he prabho tava dAsoyaM nijavAkyAnusArataH| idAnIntu sakalyANo bhavatA saMvisR^ijyatAm|</para>
  <para style="p">
    <verse number="30" style="v"/>yataH sakaladeshasya dIptaye dIptirUpakaM|</para>
  <para style="p">
    <verse number="31" style="v"/>isrAyelIyalokasya mahAgauravarUpakaM|</para>
  <para style="p">
    <verse number="32" style="v"/>yaM trAyakaM janAnAntu sammukhe tvamajIjanaH| saeva vidyate.asmAkaM dhravaM nayananagochare||</para>
  <para style="p">
    <verse number="33" style="v"/>tadAnIM tenoktA etAH sakalAH kathAH shrutvA tasya mAtA yUShaph cha vismayaM menAte|</para>
  <para style="p">
    <verse number="34" style="v"/>tataH paraM shimiyon tebhya AshiShaM dattvA tanmAtaraM mariyamam uvAcha, pashya isrAyelo vaMshamadhye bahUnAM pAtanAyotthApanAya cha tathA virodhapAtraM bhavituM, bahUnAM guptamanogatAnAM prakaTIkaraNAya bAlakoyaM niyuktosti|</para>
  <para style="p">
    <verse number="35" style="v"/>tasmAt tavApi prANAH shUlena vyatsyante|</para>
  <para style="p">
    <verse number="36" style="v"/>apara ncha Asherasya vaMshIyaphinUyelo duhitA hannAkhyA atijaratI bhaviShyadvAdinyekA yA vivAhAt paraM sapta vatsarAn patyA saha nyavasat tato vidhavA bhUtvA chaturashItivarShavayaHparyyanataM</para>
  <para style="p">
    <verse number="37" style="v"/>mandire sthitvA prArthanopavAsairdivAnisham Ishvaram asevata sApi strI tasmin samaye mandiramAgatya</para>
  <para style="p">
    <verse number="38" style="v"/>parameshvarasya dhanyavAdaM chakAra, yirUshAlampuravAsino yAvanto lokA muktimapekShya sthitAstAn yIshorvR^ittAntaM j nApayAmAsa|</para>
  <para style="p">
    <verse number="39" style="v"/>itthaM parameshvarasya vyavasthAnusAreNa sarvveShu karmmasu kR^iteShu tau punashcha gAlIlo nAsaratnAmakaM nijanagaraM pratasthAte|</para>
  <para style="p">
    <verse number="40" style="v"/>tatpashchAd bAlakaH sharIreNa vR^iddhimetya j nAnena paripUrNa AtmanA shaktimAMshcha bhavitumArebhe tathA tasmin IshvarAnugraho babhUva|</para>
  <para style="p">
    <verse number="41" style="v"/>tasya pitA mAtA cha prativarShaM nistArotsavasamaye yirUshAlamam agachChatAm|</para>
  <para style="p">
    <verse number="42" style="v"/>apara ncha yIshau dvAdashavarShavayaske sati tau parvvasamayasya rItyanusAreNa yirUshAlamaM gatvA</para>
  <para style="p">
    <verse number="43" style="v"/>pArvvaNaM sampAdya punarapi vyAghuyya yAtaH kintu yIshurbAlako yirUshAlami tiShThati| yUShaph tanmAtA cha tad aviditvA</para>
  <para style="p">
    <verse number="44" style="v"/>sa sa NgibhiH saha vidyata etachcha budvvA dinaikagamyamArgaM jagmatuH| kintu sheShe j nAtibandhUnAM samIpe mR^igayitvA taduddeेshamaprApya</para>
  <para style="p">
    <verse number="45" style="v"/>tau punarapi yirUshAlamam parAvR^ityAgatya taM mR^igayA nchakratuH|</para>
  <para style="p">
    <verse number="46" style="v"/>atha dinatrayAt paraM paNDitAnAM madhye teShAM kathAH shR^iNvan tattvaM pR^ichChaMshcha mandire samupaviShTaH sa tAbhyAM dR^iShTaH|</para>
  <para style="p">
    <verse number="47" style="v"/>tadA tasya buddhyA pratyuttaraishcha sarvve shrotAro vismayamApadyante|</para>
  <para style="p">
    <verse number="48" style="v"/>tAdR^ishaM dR^iShTvA tasya janako jananI cha chamachchakratuH ki ncha tasya mAtA tamavadat, he putra, kathamAvAM pratItthaM samAcharastvam? pashya tava pitAha ncha shokAkulau santau tvAmanvichChAvaH sma|</para>
  <para style="p">
    <verse number="49" style="v"/>tataH sovadat kuto mAm anvaichChataM? piturgR^ihe mayA sthAtavyam etat kiM yuvAbhyAM na j nAyate?</para>
  <para style="p">
    <verse number="50" style="v"/>kintu tau tasyaitadvAkyasya tAtparyyaM boddhuM nAshaknutAM|</para>
  <para style="p">
    <verse number="51" style="v"/>tataH paraM sa tAbhyAM saha nAsarataM gatvA tayorvashIbhUtastasthau kintu sarvvA etAH kathAstasya mAtA manasi sthApayAmAsa|</para>
  <para style="p">
    <verse number="52" style="v"/>atha yIsho rbuddhiH sharIra ncha tathA tasmin Ishvarasya mAnavAnA nchAnugraho varddhitum Arebhe|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM tibiriyakaisarasya rAjatvasya pa nchadashe vatsare sati yadA pantIyapIlAto yihUdAdeshAdhipati rherod tu gAlIlpradeshasya rAjA philipanAmA tasya bhrAtA tu yitUriyAyAstrAkhonItiyApradeshasya cha rAjAsIt luShAnIyanAmA avilInIdeshasya rAjAsIt</para>
  <para style="p">
    <verse number="2" style="v"/>hAnan kiyaphAshchemau pradhAnayAjAkAvAstAM tadAnIM sikhariyasya putrAya yohane madhyeprAntaram Ishvarasya vAkye prakAshite sati</para>
  <para style="p">
    <verse number="3" style="v"/>sa yarddana ubhayataTapradeshAn sametya pApamochanArthaM manaHparAvarttanasya chihnarUpaM yanmajjanaM tadIyAH kathAH sarvvatra prachArayitumArebhe|</para>
  <para style="p">
    <verse number="4" style="v"/>yishayiyabhaviShyadvaktR^igranthe yAdR^ishI lipirAste yathA, parameshasya panthAnaM pariShkuruta sarvvataH| tasya rAjapatha nchaiva samAnaM kurutAdhunA|</para>
  <para style="p">
    <verse number="5" style="v"/>kAriShyante samuchChrAyAH sakalA nimnabhUmayaH| kAriShyante natAH sarvve parvvatAshchopaparvvatAH| kAriShyante cha yA vakrAstAH sarvvAH saralA bhuvaH| kAriShyante samAnAstA yA uchchanIchabhUmayaH|</para>
  <para style="p">
    <verse number="6" style="v"/>IshvareNa kR^itaM trANaM drakShyanti sarvvamAnavAH| ityetat prAntare vAkyaM vadataH kasyachid ravaH||</para>
  <para style="p">
    <verse number="7" style="v"/>ye ye lokA majjanArthaM bahirAyayustAn sovadat re re sarpavaMshA AgAminaH kopAt palAyituM yuShmAn kashchetayAmAsa?</para>
  <para style="p">
    <verse number="8" style="v"/>tasmAd ibrAhIm asmAkaM pitA kathAmIdR^ishIM manobhi rna kathayitvA yUyaM manaHparivarttanayogyaM phalaM phalata; yuShmAnahaM yathArthaM vadAmi pAShANebhya etebhya Ishvara ibrAhImaH santAnotpAdane samarthaH|</para>
  <para style="p">
    <verse number="9" style="v"/>apara ncha tarumUle.adhunApi parashuH saMlagnosti yastaruruttamaM phalaM na phalati sa Chidyate.agnau nikShipyate cha|</para>
  <para style="p">
    <verse number="10" style="v"/>tadAnIM lokAstaM paprachChustarhi kiM karttavyamasmAbhiH?</para>
  <para style="p">
    <verse number="11" style="v"/>tataH sovAdIt yasya dve vasane vidyete sa vastrahInAyaikaM vitaratu kiM ncha yasya khAdyadravyaM vidyate sopi tathaiva karotu|</para>
  <para style="p">
    <verse number="12" style="v"/>tataH paraM karasa nchAyino majjanArtham Agatya paprachChuH he guro kiM karttavyamasmAbhiH?</para>
  <para style="p">
    <verse number="13" style="v"/>tataH sokathayat nirUpitAdadhikaM na gR^ihlita|</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraM senAgaNa etya paprachCha kimasmAbhi rvA karttavyam? tataH sobhidadhe kasya kAmapi hAniM mA kArShTa tathA mR^iShApavAdaM mA kuruta nijavetanena cha santuShya tiShThata|</para>
  <para style="p">
    <verse number="15" style="v"/>apara ncha lokA apekShayA sthitvA sarvvepIti manobhi rvitarkayA nchakruH, yohanayam abhiShiktastrAtA na veti?</para>
  <para style="p">
    <verse number="16" style="v"/>tadA yohan sarvvAn vyAjahAra, jale.ahaM yuShmAn majjayAmi satyaM kintu yasya pAdukAbandhanaM mochayitumapi na yogyosmi tAdR^isha eko matto gurutaraH pumAn eti, sa yuShmAn vahnirUpe pavitra Atmani majjayiShyati|</para>
  <para style="p">
    <verse number="17" style="v"/>apara ncha tasya haste shUrpa Aste sa svashasyAni shuddharUpaM prasphoTya godhUmAn sarvvAn bhANDAgAre saMgrahIShyati kintu bUShANi sarvvANyanirvvANavahninA dAhayiShyati|</para>
  <para style="p">
    <verse number="18" style="v"/>yohan upadeshenetthaM nAnAkathA lokAnAM samakShaM prachArayAmAsa|</para>
  <para style="p">
    <verse number="19" style="v"/>apara ncha herod rAjA philipnAmnaH sahodarasya bhAryyAM herodiyAmadhi tathAnyAni yAni yAni kukarmmANi kR^itavAn tadadhi cha</para>
  <para style="p">
    <verse number="20" style="v"/>yohanA tiraskR^ito bhUtvA kArAgAre tasya bandhanAd aparamapi kukarmma chakAra|</para>
  <para style="p">
    <verse number="21" style="v"/>itaH pUrvvaM yasmin samaye sarvve yohanA majjitAstadAnIM yIshurapyAgatya majjitaH|</para>
  <para style="p">
    <verse number="22" style="v"/>tadanantaraM tena prArthite meghadvAraM muktaM tasmAchcha pavitra AtmA mUrttimAn bhUtvA kapotavat taduparyyavaruroha; tadA tvaM mama priyaH putrastvayi mama paramaH santoSha ityAkAshavANI babhUva|</para>
  <para style="p">
    <verse number="23" style="v"/>tadAnIM yIshuH prAyeNa triMshadvarShavayaska AsIt| laukikaj nAne tu sa yUShaphaH putraH,</para>
  <para style="p">
    <verse number="24" style="v"/>yUShaph eleH putraH, elirmattataH putraH, mattat leveH putraH, levi rmalkeH putraH, malkiryAnnasya putraH; yAnno yUShaphaH putraH|</para>
  <para style="p">
    <verse number="25" style="v"/>yUShaph mattathiyasya putraH, mattathiya AmosaH putraH, Amos nahUmaH putraH, nahUm iShleH putraH iShlirnageH putraH|</para>
  <para style="p">
    <verse number="26" style="v"/>nagirmATaH putraH, mAT mattathiyasya putraH, mattathiyaH shimiyeH putraH, shimiyiryUShaphaH putraH, yUShaph yihUdAH putraH|</para>
  <para style="p">
    <verse number="27" style="v"/>yihUdA yohAnAH putraH, yohAnA rIShAH putraH, rIShAH sirubbAbilaH putraH, sirubbAbil shaltIyelaH putraH, shaltIyel nereH putraH|</para>
  <para style="p">
    <verse number="28" style="v"/>nerirmalkeH putraH, malkiH adyaH putraH, addI koShamaH putraH, koSham ilmodadaH putraH, ilmodad eraH putraH|</para>
  <para style="p">
    <verse number="29" style="v"/>er yosheH putraH, yoshiH ilIyeSharaH putraH, ilIyeShar yorImaH putraH, yorIm mattataH putraH, mattata leveH putraH|</para>
  <para style="p">
    <verse number="30" style="v"/>leviH shimiyonaH putraH, shimiyon yihUdAH putraH, yihUdA yUShuphaH putraH, yUShuph yonanaH putraH, yAnan ilIyAkImaH putraH|</para>
  <para style="p">
    <verse number="31" style="v"/>iliyAkImH mileyAH putraH, mileyA mainanaH putraH, mainan mattattasya putraH, mattatto nAthanaH putraH, nAthan dAyUdaH putraH|</para>
  <para style="p">
    <verse number="32" style="v"/>dAyUd yishayaH putraH, yishaya obedaH putra, obed boyasaH putraH, boyas salmonaH putraH, salmon nahashonaH putraH|</para>
  <para style="p">
    <verse number="33" style="v"/>nahashon ammInAdabaH putraH, ammInAdab arAmaH putraH, arAm hiShroNaH putraH, hiShroN perasaH putraH, peras yihUdAH putraH|</para>
  <para style="p">
    <verse number="34" style="v"/>yihUdA yAkUbaH putraH, yAkUb ishAkaH putraH, ishAk ibrAhImaH putraH, ibrAhIm terahaH putraH, terah nAhoraH putraH|</para>
  <para style="p">
    <verse number="35" style="v"/>nAhor sirugaH putraH, sirug riyvaH putraH, riyUH pelagaH putraH, pelag evaraH putraH, evar shelahaH putraH|</para>
  <para style="p">
    <verse number="36" style="v"/>shelah kainanaH putraH, kainan arphakShadaH putraH, arphakShad shAmaH putraH, shAm nohaH putraH, noho lemakaH putraH|</para>
  <para style="p">
    <verse number="37" style="v"/>lemak mithUshelahaH putraH, mithUshelah hanokaH putraH, hanok yeradaH putraH, yerad mahalalelaH putraH, mahalalel kainanaH putraH|</para>
  <para style="p">
    <verse number="38" style="v"/>kainan inoshaH putraH, inosh shetaH putraH, shet AdamaH putra, Adam Ishvarasya putraH|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataH paraM yIshuH pavitreNAtmanA pUrNaH san yarddananadyAH parAvR^ityAtmanA prAntaraM nItaH san chatvAriMshaddinAni yAvat shaitAnA parIkShito.abhUt,</para>
  <para style="p">
    <verse number="2" style="v"/>ki ncha tAni sarvvadinAni bhojanaM vinA sthitatvAt kAle pUrNe sa kShudhitavAn|</para>
  <para style="p">
    <verse number="3" style="v"/>tataH shaitAnAgatya tamavadat tvaM chedIshvarasya putrastarhi prastarAnetAn Aj nayA pUpAn kuru|</para>
  <para style="p">
    <verse number="4" style="v"/>tadA yIshuruvAcha, lipirIdR^ishI vidyate manujaH kevalena pUpena na jIvati kintvIshvarasya sarvvAbhirAj nAbhi rjIvati|</para>
  <para style="p">
    <verse number="5" style="v"/>tadA shaitAn tamuchchaM parvvataM nItvA nimiShaikamadhye jagataH sarvvarAjyAni darshitavAn|</para>
  <para style="p">
    <verse number="6" style="v"/>pashchAt tamavAdIt sarvvam etad vibhavaM pratApa ncha tubhyaM dAsyAmi tan mayi samarpitamAste yaM prati mamechChA jAyate tasmai dAtuM shaknomi,</para>
  <para style="p">
    <verse number="7" style="v"/>tvaM chenmAM bhajase tarhi sarvvametat tavaiva bhaviShyati|</para>
  <para style="p">
    <verse number="8" style="v"/>tadA yIshustaM pratyuktavAn dUrI bhava shaitAn lipirAste, nijaM prabhuM parameshvaraM bhajasva kevalaM tameva sevasva cha|</para>
  <para style="p">
    <verse number="9" style="v"/>atha shaitAn taM yirUshAlamaM nItvA mandirasya chUDAyA upari samupaveshya jagAda tvaM chedIshvarasya putrastarhi sthAnAdito lamphitvAdhaH</para>
  <para style="p">
    <verse number="10" style="v"/>pata yato lipirAste, Aj nApayiShyati svIyAn dUtAn sa parameshvaraH|</para>
  <para style="p">
    <verse number="11" style="v"/>rakShituM sarvvamArge tvAM tena tvachcharaNe yathA| na laget prastarAghAtastvAM dhariShyanti te tathA|</para>
  <para style="p">
    <verse number="12" style="v"/>tadA yIshunA pratyuktam idamapyuktamasti tvaM svaprabhuM pareshaM mA parIkShasva|</para>
  <para style="p">
    <verse number="13" style="v"/>pashchAt shaitAn sarvvaparIkShAM samApya kShaNAttaM tyaktvA yayau|</para>
  <para style="p">
    <verse number="14" style="v"/>tadA yIshurAtmaprabhAvAt punargAlIlpradeshaM gatastadA tatsukhyAtishchaturdishaM vyAnashe|</para>
  <para style="p">
    <verse number="15" style="v"/>sa teShAM bhajanagR^iheShu upadishya sarvvaiH prashaMsito babhUva|</para>
  <para style="p">
    <verse number="16" style="v"/>atha sa svapAlanasthAnaM nAsaratpurametya vishrAmavAre svAchArAd bhajanagehaM pravishya paThitumuttasthau|</para>
  <para style="p">
    <verse number="17" style="v"/>tato yishayiyabhaviShyadvAdinaH pustake tasya karadatte sati sa tat pustakaM vistAryya yatra vakShyamANAni vachanAni santi tat sthAnaM prApya papATha|</para>
  <para style="p">
    <verse number="18" style="v"/>AtmA tu parameshasya madIyopari vidyate| daridreShu susaMvAdaM vaktuM mAM sobhiShiktavAn| bhagnAntaH karaNAllokAn susvasthAn karttumeva cha| bandIkR^iteShu lokeShu mukte rghoShayituM vachaH| netrANi dAtumandhebhyastrAtuM baddhajanAnapi|</para>
  <para style="p">
    <verse number="19" style="v"/>pareshAnugrahe kAlaM prachArayitumeva cha| sarvvaitatkaraNArthAya mAmeva prahiNoti saH||</para>
  <para style="p">
    <verse number="20" style="v"/>tataH pustakaM badvvA parichArakasya haste samarpya chAsane samupaviShTaH, tato bhajanagR^ihe yAvanto lokA Asan te sarvve.ananyadR^iShTyA taM vilulokire|</para>
  <para style="p">
    <verse number="21" style="v"/>anantaram adyaitAni sarvvANi likhitavachanAni yuShmAkaM madhye siddhAni sa imAM kathAM tebhyaH kathayitumArebhe|</para>
  <para style="p">
    <verse number="22" style="v"/>tataH sarvve tasmin anvarajyanta, ki ncha tasya mukhAnnirgatAbhiranugrahasya kathAbhishchamatkR^itya kathayAmAsuH kimayaM yUShaphaH putro na?</para>
  <para style="p">
    <verse number="23" style="v"/>tadA so.avAdId he chikitsaka svameva svasthaM kuru kapharnAhUmi yadyat kR^itavAn tadashrauShma tAH sarvAH kriyA atra svadeshe kuru kathAmetAM yUyamevAvashyaM mAM vadiShyatha|</para>
  <para style="p">
    <verse number="24" style="v"/>punaH sovAdId yuShmAnahaM yathArthaM vadAmi, kopi bhaviShyadvAdI svadeshe satkAraM na prApnoti|</para>
  <para style="p">
    <verse number="25" style="v"/>apara ncha yathArthaM vachmi, eliyasya jIvanakAle yadA sArddhatritayavarShANi yAvat jaladapratibandhAt sarvvasmin deshe mahAdurbhikSham ajaniShTa tadAnIm isrAyelo deshasya madhye bahvyo vidhavA Asan,</para>
  <para style="p">
    <verse number="26" style="v"/>kintu sIdonpradeshIyasAriphatpuranivAsinIm ekAM vidhavAM vinA kasyAshchidapi samIpe eliyaH prerito nAbhUt|</para>
  <para style="p">
    <verse number="27" style="v"/>apara ncha ilIshAyabhaviShyadvAdividyamAnatAkAle isrAyeldeshe bahavaH kuShThina Asan kintu surIyadeshIyaM nAmAnkuShThinaM vinA kopyanyaH pariShkR^ito nAbhUt|</para>
  <para style="p">
    <verse number="28" style="v"/>imAM kathAM shrutvA bhajanagehasthitA lokAH sakrodham utthAya</para>
  <para style="p">
    <verse number="29" style="v"/>nagarAttaM bahiShkR^itya yasya shikhariNa upari teShAM nagaraM sthApitamAste tasmAnnikSheptuM tasya shikharaM taM ninyuH</para>
  <para style="p">
    <verse number="30" style="v"/>kintu sa teShAM madhyAdapasR^itya sthAnAntaraM jagAma|</para>
  <para style="p">
    <verse number="31" style="v"/>tataH paraM yIshurgAlIlpradeshIyakapharnAhUmnagara upasthAya vishrAmavAre lokAnupadeShTum ArabdhavAn|</para>
  <para style="p">
    <verse number="32" style="v"/>tadupadeshAt sarvve chamachchakru ryatastasya kathA gurutarA Asan|</para>
  <para style="p">
    <verse number="33" style="v"/>tadAnIM tadbhajanagehasthito.amedhyabhUtagrasta eko jana uchchaiH kathayAmAsa,</para>
  <para style="p">
    <verse number="34" style="v"/>he nAsaratIyayIsho.asmAn tyaja, tvayA sahAsmAkaM kaH sambandhaH? kimasmAn vinAshayitumAyAsi? tvamIshvarasya pavitro jana etadahaM jAnAmi|</para>
  <para style="p">
    <verse number="35" style="v"/>tadA yIshustaM tarjayitvAvadat maunI bhava ito bahirbhava; tataH somedhyabhUtastaM madhyasthAne pAtayitvA ki nchidapyahiMsitvA tasmAd bahirgatavAn|</para>
  <para style="p">
    <verse number="36" style="v"/>tataH sarvve lokAshchamatkR^itya parasparaM vaktumArebhire koyaM chamatkAraH| eSha prabhAveNa parAkrameNa chAmedhyabhUtAn Aj nApayati tenaiva te bahirgachChanti|</para>
  <para style="p">
    <verse number="37" style="v"/>anantaraM chaturdiksthadeshAn tasya sukhyAtirvyApnot|</para>
  <para style="p">
    <verse number="38" style="v"/>tadanantaraM sa bhajanagehAd bahirAgatya shimono niveshanaM pravivesha tadA tasya shvashrUrjvareNAtyantaM pIDitAsIt shiShyAstadarthaM tasmin vinayaM chakruH|</para>
  <para style="p">
    <verse number="39" style="v"/>tataH sa tasyAH samIpe sthitvA jvaraM tarjayAmAsa tenaiva tAM jvaro.atyAkShIt tataH sA tatkShaNam utthAya tAn siSheve|</para>
  <para style="p">
    <verse number="40" style="v"/>atha sUryyAstakAle sveShAM ye ye janA nAnArogaiH pIDitA Asan lokAstAn yIshoH samIpam AninyuH, tadA sa ekaikasya gAtre karamarpayitvA tAnarogAn chakAra|</para>
  <para style="p">
    <verse number="41" style="v"/>tato bhUtA bahubhyo nirgatya chItshabdaM kR^itvA cha babhAShire tvamIshvarasya putro.abhiShiktatrAtA; kintu sobhiShiktatrAteti te vividuretasmAt kAraNAt tAn tarjayitvA tadvaktuM niShiShedha|</para>
  <para style="p">
    <verse number="42" style="v"/>apara ncha prabhAte sati sa vijanasthAnaM pratasthe pashchAt janAstamanvichChantastannikaTaM gatvA sthAnAntaragamanArthaM tamanvarundhan|</para>
  <para style="p">
    <verse number="43" style="v"/>kintu sa tAn jagAda, IshvarIyarAjyasya susaMvAdaM prachArayitum anyAni purANyapi mayA yAtavyAni yatastadarthameva preritohaM|</para>
  <para style="p">
    <verse number="44" style="v"/>atha gAlIlo bhajanageheShu sa upadidesha|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM yIshurekadA gineSharathdasya tIra uttiShThati, tadA lokA IshvarIyakathAM shrotuM tadupari prapatitAH|</para>
  <para style="p">
    <verse number="2" style="v"/>tadAnIM sa hdasya tIrasamIpe naudvayaM dadarsha ki ncha matsyopajIvino nAvaM vihAya jAlaM prakShAlayanti|</para>
  <para style="p">
    <verse number="3" style="v"/>tatastayordvayo rmadhye shimono nAvamAruhya tIrAt ki nchiddUraM yAtuM tasmin vinayaM kR^itvA naukAyAmupavishya lokAn propadiShTavAn|</para>
  <para style="p">
    <verse number="4" style="v"/>pashchAt taM prastAvaM samApya sa shimonaM vyAjahAra, gabhIraM jalaM gatvA matsyAn dharttuM jAlaM nikShipa|</para>
  <para style="p">
    <verse number="5" style="v"/>tataH shimona babhAShe, he guro yadyapi vayaM kR^itsnAM yAminIM parishramya matsyaikamapi na prAptAstathApi bhavato nideshato jAlaM kShipAmaH|</para>
  <para style="p">
    <verse number="6" style="v"/>atha jAle kShipte bahumatsyapatanAd AnAyaH prachChinnaH|</para>
  <para style="p">
    <verse number="7" style="v"/>tasmAd upakarttum anyanausthAn sa Ngina AyAtum i Ngitena samAhvayan tatasta Agatya matsyai rnaudvayaM prapUrayAmAsu ryai rnaudvayaM pramagnam|</para>
  <para style="p">
    <verse number="8" style="v"/>tadA shimonpitarastad vilokya yIshoshcharaNayoH patitvA, he prabhohaM pApI naro mama nikaTAd bhavAn yAtu, iti kathitavAn|</para>
  <para style="p">
    <verse number="9" style="v"/>yato jAle patitAnAM matsyAnAM yUthAt shimon tatsa Nginashcha chamatkR^itavantaH; shimonaH sahakAriNau sivadeH putrau yAkUb yohan chemau tAdR^ishau babhUvatuH|</para>
  <para style="p">
    <verse number="10" style="v"/>tadA yIshuH shimonaM jagAda mA bhaiShIradyArabhya tvaM manuShyadharo bhaviShyasi|</para>
  <para style="p">
    <verse number="11" style="v"/>anantaraM sarvvAsu nausu tIram AnItAsu te sarvvAn parityajya tasya pashchAdgAmino babhUvuH|</para>
  <para style="p">
    <verse number="12" style="v"/>tataH paraM yIshau kasmiMshchit pure tiShThati jana ekaH sarvvA NgakuShThastaM vilokya tasya samIpe nyubjaH patitvA savinayaM vaktumArebhe, he prabho yadi bhavAnichChati tarhi mAM pariShkarttuM shaknoti|</para>
  <para style="p">
    <verse number="13" style="v"/>tadAnIM sa pANiM prasAryya tada NgaM spR^ishan babhAShe tvaM pariShkriyasveti mamechChAsti tatastatkShaNaM sa kuShThAt muktaH|</para>
  <para style="p">
    <verse number="14" style="v"/>pashchAt sa tamAj nApayAmAsa kathAmimAM kasmaichid akathayitvA yAjakasya samIpa ncha gatvA svaM darshaya, lokebhyo nijapariShkR^itatvasya pramANadAnAya mUsAj nAnusAreNa dravyamutmR^ijasva cha|</para>
  <para style="p">
    <verse number="15" style="v"/>tathApi yIshoH sukhyAti rbahu vyAptumArebhe ki ncha tasya kathAM shrotuM svIyarogebhyo moktu ncha lokA AjagmuH|</para>
  <para style="p">
    <verse number="16" style="v"/>atha sa prAntaraM gatvA prArthayA nchakre|</para>
  <para style="p">
    <verse number="17" style="v"/>apara ncha ekadA yIshurupadishati, etarhi gAlIlyihUdApradeshayoH sarvvanagarebhyo yirUshAlamashcha kiyantaH phirUshilokA vyavasthApakAshcha samAgatya tadantike samupavivishuH, tasmin kAle lokAnAmArogyakAraNAt prabhoH prabhAvaH prachakAshe|</para>
  <para style="p">
    <verse number="18" style="v"/>pashchAt kiyanto lokA ekaM pakShAghAtinaM khaTvAyAM nidhAya yIshoH samIpamAnetuM sammukhe sthApayitu ncha vyApriyanta|</para>
  <para style="p">
    <verse number="19" style="v"/>kintu bahujananivahasamvAdhAt na shaknuvanto gR^ihopari gatvA gR^ihapR^iShThaM khanitvA taM pakShAghAtinaM sakhaTvaM gR^ihamadhye yIshoH sammukhe .avarohayAmAsuH|</para>
  <para style="p">
    <verse number="20" style="v"/>tadA yIshusteShAm IdR^ishaM vishvAsaM vilokya taM pakShAghAtinaM vyAjahAra, he mAnava tava pApamakShamyata|</para>
  <para style="p">
    <verse number="21" style="v"/>tasmAd adhyApakAH phirUshinashcha chittairitthaM prachintitavantaH, eSha jana IshvaraM nindati koyaM? kevalamIshvaraM vinA pApaM kShantuM kaH shaknoti?</para>
  <para style="p">
    <verse number="22" style="v"/>tadA yIshusteShAm itthaM chintanaM viditvA tebhyokathayad yUyaM manobhiH kuto vitarkayatha?</para>
  <para style="p">
    <verse number="23" style="v"/>tava pApakShamA jAtA yadvA tvamutthAya vraja etayo rmadhye kA kathA sukathyA?</para>
  <para style="p">
    <verse number="24" style="v"/>kintu pR^ithivyAM pApaM kShantuM mAnavasutasya sAmarthyamastIti yathA yUyaM j nAtuM shaknutha tadarthaM (sa taM pakShAghAtinaM jagAda) uttiShTha svashayyAM gR^ihItvA gR^ihaM yAhIti tvAmAdishAmi|</para>
  <para style="p">
    <verse number="25" style="v"/>tasmAt sa tatkShaNam utthAya sarvveShAM sAkShAt nijashayanIyaM gR^ihItvA IshvaraM dhanyaM vadan nijaniveshanaM yayau|</para>
  <para style="p">
    <verse number="26" style="v"/>tasmAt sarvve vismaya prAptA manaHsu bhItAshcha vayamadyAsambhavakAryyANyadarshAma ityuktvA parameshvaraM dhanyaM proditAH|</para>
  <para style="p">
    <verse number="27" style="v"/>tataH paraM bahirgachChan karasa nchayasthAne levinAmAnaM karasa nchAyakaM dR^iShTvA yIshustamabhidadhe mama pashchAdehi|</para>
  <para style="p">
    <verse number="28" style="v"/>tasmAt sa tatkShaNAt sarvvaM parityajya tasya pashchAdiyAya|</para>
  <para style="p">
    <verse number="29" style="v"/>anantaraM levi rnijagR^ihe tadarthaM mahAbhojyaM chakAra, tadA taiH sahAneke karasa nchAyinastadanyalokAshcha bhoktumupavivishuH|</para>
  <para style="p">
    <verse number="30" style="v"/>tasmAt kAraNAt chaNDAlAnAM pApilokAnA ncha sa Nge yUyaM kuto bhaMgdhve pivatha cheti kathAM kathayitvA phirUshino.adhyApakAshcha tasya shiShyaiH saha vAgyuddhaM karttumArebhire|</para>
  <para style="p">
    <verse number="31" style="v"/>tasmAd yIshustAn pratyavochad arogalokAnAM chikitsakena prayojanaM nAsti kintu sarogANAmeva|</para>
  <para style="p">
    <verse number="32" style="v"/>ahaM dhArmmikAn AhvAtuM nAgatosmi kintu manaH parAvarttayituM pApina eva|</para>
  <para style="p">
    <verse number="33" style="v"/>tataste prochuH, yohanaH phirUshinA ncha shiShyA vAraMvAram upavasanti prArthayante cha kintu tava shiShyAH kuto bhu njate pivanti cha?</para>
  <para style="p">
    <verse number="34" style="v"/>tadA sa tAnAchakhyau vare sa Nge tiShThati varasya sakhigaNaM kimupavAsayituM shaknutha?</para>
  <para style="p">
    <verse number="35" style="v"/>kintu yadA teShAM nikaTAd varo neShyate tadA te samupavatsyanti|</para>
  <para style="p">
    <verse number="36" style="v"/>soparamapi dR^iShTAntaM kathayAmbabhUva purAtanavastre kopi nutanavastraM na sIvyati yatastena sevanena jIrNavastraM Chidyate, nUtanapurAtanavastrayo rmela ncha na bhavati|</para>
  <para style="p">
    <verse number="37" style="v"/>purAtanyAM kutvAM kopi nutanaM drAkShArasaM na nidadhAti, yato navInadrAkShArasasya tejasA purAtanI kutU rvidIryyate tato drAkShArasaH patati kutUshcha nashyati|</para>
  <para style="p">
    <verse number="38" style="v"/>tato heto rnUtanyAM kutvAM navInadrAkShArasaH nidhAtavyastenobhayasya rakShA bhavati|</para>
  <para style="p">
    <verse number="39" style="v"/>apara ncha purAtanaM drAkShArasaM pItvA kopi nUtanaM na vA nChati, yataH sa vakti nUtanAt purAtanam prashastam|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>achara ncha parvvaNo dvitIyadinAt paraM prathamavishrAmavAre shasyakShetreNa yIshorgamanakAle tasya shiShyAH kaNishaM ChittvA kareShu marddayitvA khAditumArebhire|</para>
  <para style="p">
    <verse number="2" style="v"/>tasmAt kiyantaH phirUshinastAnavadan vishrAmavAre yat karmma na karttavyaM tat kutaH kurutha?</para>
  <para style="p">
    <verse number="3" style="v"/>yIshuH pratyuvAcha dAyUd tasya sa Nginashcha kShudhArttAH kiM chakruH sa katham Ishvarasya mandiraM pravishya</para>
  <para style="p">
    <verse number="4" style="v"/>ye darshanIyAH pUpA yAjakAn vinAnyasya kasyApyabhojanIyAstAnAnIya svayaM bubhaje sa Ngibhyopi dadau tat kiM yuShmAbhiH kadApi nApAThi?</para>
  <para style="p">
    <verse number="5" style="v"/>pashchAt sa tAnavadat manujasuto vishrAmavArasyApi prabhu rbhavati|</para>
  <para style="p">
    <verse number="6" style="v"/>anantaram anyavishrAmavAre sa bhajanagehaM pravishya samupadishati| tadA tatsthAne shuShkadakShiNakara ekaH pumAn upatasthivAn|</para>
  <para style="p">
    <verse number="7" style="v"/>tasmAd adhyApakAH phirUshinashcha tasmin doShamAropayituM sa vishrAmavAre tasya svAsthyaM karoti naveti pratIkShitumArebhire|</para>
  <para style="p">
    <verse number="8" style="v"/>tadA yIshusteShAM chintAM viditvA taM shuShkakaraM pumAMsaM provAcha, tvamutthAya madhyasthAne tiShTha|</para>
  <para style="p">
    <verse number="9" style="v"/>tasmAt tasmin utthitavati yIshustAn vyAjahAra, yuShmAn imAM kathAM pR^ichChAmi, vishrAmavAre hitam ahitaM vA, prANarakShaNaM prANanAshanaM vA, eteShAM kiM karmmakaraNIyam?</para>
  <para style="p">
    <verse number="10" style="v"/>pashchAt chaturdikShu sarvvAn vilokya taM mAnavaM babhAShe, nijakaraM prasAraya; tatastena tathA kR^ita itarakaravat tasya hastaH svasthobhavat|</para>
  <para style="p">
    <verse number="11" style="v"/>tasmAt te prachaNDakopAnvitA yIshuM kiM kariShyantIti parasparaM pramantritAH|</para>
  <para style="p">
    <verse number="12" style="v"/>tataH paraM sa parvvatamAruhyeshvaramuddishya prArthayamAnaH kR^itsnAM rAtriM yApitavAn|</para>
  <para style="p">
    <verse number="13" style="v"/>atha dine sati sa sarvvAn shiShyAn AhUtavAn teShAM madhye</para>
  <para style="p">
    <verse number="14" style="v"/>pitaranAmnA khyAtaH shimon tasya bhrAtA Andriyashcha yAkUb yohan cha philip barthalamayashcha</para>
  <para style="p">
    <verse number="15" style="v"/>mathiH thomA AlphIyasya putro yAkUb jvalantanAmnA khyAtaH shimon</para>
  <para style="p">
    <verse number="16" style="v"/>cha yAkUbo bhrAtA yihUdAshcha taM yaH parakareShu samarpayiShyati sa IShkarIyotIyayihUdAshchaitAn dvAdasha janAn manonItAn kR^itvA sa jagrAha tathA prerita iti teShAM nAma chakAra|</para>
  <para style="p">
    <verse number="17" style="v"/>tataH paraM sa taiH saha parvvatAdavaruhya upatyakAyAM tasthau tatastasya shiShyasa Ngho yihUdAdeshAd yirUshAlamashcha soraH sIdonashcha jaladhe rodhaso jananihAshcha etya tasya kathAshravaNArthaM rogamuktyartha ncha tasya samIpe tasthuH|</para>
  <para style="p">
    <verse number="18" style="v"/>amedhyabhUtagrastAshcha tannikaTamAgatya svAsthyaM prApuH|</para>
  <para style="p">
    <verse number="19" style="v"/>sarvveShAM svAsthyakaraNaprabhAvasya prakAshitatvAt sarvve lokA etya taM spraShTuM yetire|</para>
  <para style="p">
    <verse number="20" style="v"/>pashchAt sa shiShyAn prati dR^iShTiM kutvA jagAda, he daridrA yUyaM dhanyA yata IshvarIye rAjye vo.adhikArosti|</para>
  <para style="p">
    <verse number="21" style="v"/>he adhunA kShudhitalokA yUyaM dhanyA yato yUyaM tarpsyatha; he iha rodino janA yUyaM dhanyA yato yUyaM hasiShyatha|</para>
  <para style="p">
    <verse number="22" style="v"/>yadA lokA manuShyasUno rnAmaheto ryuShmAn R^iृtIyiShyante pR^ithak kR^itvA nindiShyanti, adhamAniva yuShmAn svasamIpAd dUrIkariShyanti cha tadA yUyaM dhanyAH|</para>
  <para style="p">
    <verse number="23" style="v"/>svarge yuShmAkaM yatheShTaM phalaM bhaviShyati, etadarthaM tasmin dine prollasata Anandena nR^ityata cha, teShAM pUrvvapuruShAshcha bhaviShyadvAdinaH prati tathaiva vyavAharan|</para>
  <para style="p">
    <verse number="24" style="v"/>kintu hA hA dhanavanto yUyaM sukhaM prApnuta| hanta paritR^iptA yUyaM kShudhitA bhaviShyatha;</para>
  <para style="p">
    <verse number="25" style="v"/>iha hasanto yUyaM vata yuShmAbhiH shochitavyaM roditavya ncha|</para>
  <para style="p">
    <verse number="26" style="v"/>sarvvailAkai ryuShmAkaM sukhyAtau kR^itAyAM yuShmAkaM durgati rbhaviShyati yuShmAkaM pUrvvapuruShA mR^iShAbhaviShyadvAdinaH prati tadvat kR^itavantaH|</para>
  <para style="p">
    <verse number="27" style="v"/>he shrotAro yuShmabhyamahaM kathayAmi, yUyaM shatruShu prIyadhvaM ye cha yuShmAn dviShanti teShAmapi hitaM kuruta|</para>
  <para style="p">
    <verse number="28" style="v"/>ye cha yuShmAn shapanti tebhya AshiShaM datta ye cha yuShmAn avamanyante teShAM ma NgalaM prArthayadhvaM|</para>
  <para style="p">
    <verse number="29" style="v"/>yadi kashchit tava kapole chapeTAghAtaM karoti tarhi taM prati kapolam anyaM parAvarttya sammukhIkuru punashcha yadi kashchit tava gAtrIyavastraM harati tarhi taM paridheyavastram api grahItuM mA vAraya|</para>
  <para style="p">
    <verse number="30" style="v"/>yastvAM yAchate tasmai dehi, yashcha tava sampattiM harati taM mA yAchasva|</para>
  <para style="p">
    <verse number="31" style="v"/>parebhyaH svAn prati yathAcharaNam apekShadhve parAn prati yUyamapi tathAcharata|</para>
  <para style="p">
    <verse number="32" style="v"/>ye janA yuShmAsu prIyante kevalaM teShu prIyamANeShu yuShmAkaM kiM phalaM? pApilokA api sveShu prIyamANeShu prIyante|</para>
  <para style="p">
    <verse number="33" style="v"/>yadi hitakAriNa eva hitaM kurutha tarhi yuShmAkaM kiM phalaM? pApilokA api tathA kurvvanti|</para>
  <para style="p">
    <verse number="34" style="v"/>yebhya R^iNaparishodhasya prAptipratyAshAste kevalaM teShu R^iNe samarpite yuShmAkaM kiM phalaM? punaH prAptyAshayA pApIlokA api pApijaneShu R^iNam arpayanti|</para>
  <para style="p">
    <verse number="35" style="v"/>ato yUyaM ripuShvapi prIyadhvaM, parahitaM kuruta cha; punaH prAptyAshAM tyaktvA R^iNamarpayata, tathA kR^ite yuShmAkaM mahAphalaM bhaviShyati, yUya ncha sarvvapradhAnasya santAnA iti khyAtiM prApsyatha, yato yuShmAkaM pitA kR^itaghnAnAM durvTattAnA ncha hitamAcharati|</para>
  <para style="p">
    <verse number="36" style="v"/>ata eva sa yathA dayAlu ryUyamapi tAdR^ishA dayAlavo bhavata|</para>
  <para style="p">
    <verse number="37" style="v"/>apara ncha parAn doShiNo mA kuruta tasmAd yUyaM doShIkR^itA na bhaviShyatha; adaNDyAn mA daNDayata tasmAd yUyamapi daNDaM na prApsyatha; pareShAM doShAn kShamadhvaM tasmAd yuShmAkamapi doShAH kShamiShyante|</para>
  <para style="p">
    <verse number="38" style="v"/>dAnAnidatta tasmAd yUyaM dAnAni prApsyatha, vara ncha lokAH parimANapAtraM pradalayya sa nchAlya pro nchAlya paripUryya yuShmAkaM kroDeShu samarpayiShyanti; yUyaM yena parimANena parimAtha tenaiva parimANena yuShmatkR^ite parimAsyate|</para>
  <para style="p">
    <verse number="39" style="v"/>atha sa tebhyo dR^iShTAntakathAmakathayat, andho janaH kimandhaM panthAnaM darshayituM shaknoti? tasmAd ubhAvapi kiM gartte na patiShyataH?</para>
  <para style="p">
    <verse number="40" style="v"/>guroH shiShyo na shreShThaH kintu shiShye siddhe sati sa gurutulyo bhavituM shaknoti|</para>
  <para style="p">
    <verse number="41" style="v"/>apara ncha tvaM svachakShuुShi nAsAm adR^iShTvA tava bhrAtushchakShuShi yattR^iNamasti tadeva kutaH pashyami?</para>
  <para style="p">
    <verse number="42" style="v"/>svachakShuShi yA nAsA vidyate tAm aj nAtvA, bhrAtastava netrAt tR^iNaM bahiH karomIti vAkyaM bhrAtaraM kathaM vaktuM shaknoShi? he kapaTin pUrvvaM svanayanAt nAsAM bahiH kuru tato bhrAtushchakShuShastR^iNaM bahiH karttuM sudR^iShTiM prApsyasi|</para>
  <para style="p">
    <verse number="43" style="v"/>anya ncha uttamastaruH kadApi phalamanuttamaM na phalati, anuttamatarushcha phalamuttamaM na phalati kAraNAdataH phalaistaravo j nAyante|</para>
  <para style="p">
    <verse number="44" style="v"/>kaNTakipAdapAt kopi uDumbaraphalAni na pAtayati tathA shR^igAlakolivR^ikShAdapi kopi drAkShAphalaM na pAtayati|</para>
  <para style="p">
    <verse number="45" style="v"/>tadvat sAdhuloko.antaHkaraNarUpAt subhANDAgArAd uttamAni dravyANi bahiH karoti, duShTo lokashchAntaHkaraNarUpAt kubhANDAgArAt kutsitAni dravyANi nirgamayati yato.antaHkaraNAnAM pUrNabhAvAnurUpANi vachAMsi mukhAnnirgachChanti|</para>
  <para style="p">
    <verse number="46" style="v"/>apara ncha mamAj nAnurUpaM nAcharitvA kuto mAM prabho prabho iti vadatha?</para>
  <para style="p">
    <verse number="47" style="v"/>yaH kashchin mama nikaTam Agatya mama kathA nishamya tadanurUpaM karmma karoti sa kasya sadR^isho bhavati tadahaM yuShmAn j nAाpayAmi|</para>
  <para style="p">
    <verse number="48" style="v"/>yo jano gabhIraM khanitvA pAShANasthale bhittiM nirmmAya svagR^ihaM rachayati tena saha tasyopamA bhavati; yata AplAvijalametya tasya mUle vegena vahadapi tadgehaM lADayituM na shaknoti yatastasya bhittiH pAShANopari tiShThati|</para>
  <para style="p">
    <verse number="49" style="v"/>kintu yaH kashchin mama kathAH shrutvA tadanurUpaM nAcharati sa bhittiM vinA mR^iृdupari gR^ihanirmmAtrA samAno bhavati; yata AplAvijalamAgatya vegena yadA vahati tadA tadgR^ihaM patati tasya mahat patanaM jAyate|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataH paraM sa lokAnAM karNagochare tAn sarvvAn upadeshAn samApya yadA kapharnAhUmpuraM pravishati</para>
  <para style="p">
    <verse number="2" style="v"/>tadA shatasenApateH priyadAsa eko mR^itakalpaH pIDita AsIt|</para>
  <para style="p">
    <verse number="3" style="v"/>ataH senApati ryIsho rvArttAM nishamya dAsasyArogyakaraNAya tasyAgamanArthaM vinayakaraNAya yihUdIyAn kiyataH prAchaH preShayAmAsa|</para>
  <para style="p">
    <verse number="4" style="v"/>te yIshorantikaM gatvA vinayAtishayaM vaktumArebhire, sa senApati rbhavatonugrahaM prAptum arhati|</para>
  <para style="p">
    <verse number="5" style="v"/>yataH sosmajjAtIyeShu lokeShu prIyate tathAsmatkR^ite bhajanagehaM nirmmitavAn|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmAd yIshustaiH saha gatvA niveshanasya samIpaM prApa, tadA sa shatasenApati rvakShyamANavAkyaM taM vaktuM bandhUn prAhiNot| he prabho svayaM shramo na karttavyo yad bhavatA madgehamadhye pAdArpaNaM kriyeta tadapyahaM nArhAmi,</para>
  <para style="p">
    <verse number="7" style="v"/>ki nchAhaM bhavatsamIpaM yAtumapi nAtmAnaM yogyaM buddhavAn, tato bhavAn vAkyamAtraM vadatu tenaiva mama dAsaH svastho bhaviShyati|</para>
  <para style="p">
    <verse number="8" style="v"/>yasmAd ahaM parAdhInopi mamAdhInA yAH senAH santi tAsAm ekajanaM prati yAhIti mayA prokte sa yAti; tadanyaM prati AyAhIti prokte sa AyAti; tathA nijadAsaM prati etat kurvviti prokte sa tadeva karoti|</para>
  <para style="p">
    <verse number="9" style="v"/>yIshuridaM vAkyaM shrutvA vismayaM yayau, mukhaM parAvartya pashchAdvarttino lokAn babhAShe cha, yuShmAnahaM vadAmi isrAyelo vaMshamadhyepi vishvAsamIdR^ishaM na prApnavaM|</para>
  <para style="p">
    <verse number="10" style="v"/>tataste preShitA gR^ihaM gatvA taM pIDitaM dAsaM svasthaM dadR^ishuH|</para>
  <para style="p">
    <verse number="11" style="v"/>pare.ahani sa nAyInAkhyaM nagaraM jagAma tasyAneke shiShyA anye cha lokAstena sArddhaM yayuH|</para>
  <para style="p">
    <verse number="12" style="v"/>teShu tannagarasya dvArasannidhiM prApteShu kiyanto lokA ekaM mR^itamanujaM vahanto nagarasya bahiryAnti, sa tanmAturekaputrastanmAtA cha vidhavA; tayA sArddhaM tannagarIyA bahavo lokA Asan|</para>
  <para style="p">
    <verse number="13" style="v"/>prabhustAM vilokya sAnukampaH kathayAmAsa, mA rodIH| sa samIpamitvA khaTvAM pasparsha tasmAd vAhakAH sthagitAstamyuH;</para>
  <para style="p">
    <verse number="14" style="v"/>tadA sa uvAcha he yuvamanuShya tvamuttiShTha, tvAmaham Aj nApayAmi|</para>
  <para style="p">
    <verse number="15" style="v"/>tasmAt sa mR^ito janastatkShaNamutthAya kathAM prakathitaH; tato yIshustasya mAtari taM samarpayAmAsa|</para>
  <para style="p">
    <verse number="16" style="v"/>tasmAt sarvve lokAH shasha Nkire; eko mahAbhaviShyadvAdI madhye.asmAkam samudait, Ishvarashcha svalokAnanvagR^ihlAt kathAmimAM kathayitvA IshvaraM dhanyaM jagaduH|</para>
  <para style="p">
    <verse number="17" style="v"/>tataH paraM samastaM yihUdAdeshaM tasya chaturdiksthadesha ncha tasyaitatkIrtti rvyAnashe|</para>
  <para style="p">
    <verse number="18" style="v"/>tataH paraM yohanaH shiShyeShu taM tadvR^ittAntaM j nApitavatsu</para>
  <para style="p">
    <verse number="19" style="v"/>sa svashiShyANAM dvau janAvAhUya yIshuM prati vakShyamANaM vAkyaM vaktuM preShayAmAsa, yasyAgamanam apekShya tiShThAmo vayaM kiM sa eva janastvaM? kiM vayamanyamapekShya sthAsyAmaH?</para>
  <para style="p">
    <verse number="20" style="v"/>pashchAttau mAnavau gatvA kathayAmAsatuH, yasyAgamanam apekShya tiShThAmo vayaM, kiM saeva janastvaM? kiM vayamanyamapekShya sthAsyAmaH? kathAmimAM tubhyaM kathayituM yohan majjaka AvAM preShitavAn|</para>
  <para style="p">
    <verse number="21" style="v"/>tasmin daNDe yIshUrogiNo mahAvyAdhimato duShTabhUtagrastAMshcha bahUn svasthAn kR^itvA, anekAndhebhyashchakShuMShi dattvA pratyuvAcha,</para>
  <para style="p">
    <verse number="22" style="v"/>yuvAM vrajatam andhA netrANi kha njAshcharaNAni cha prApnuvanti, kuShThinaH pariShkriyante, badhirAH shravaNAni mR^itAshcha jIvanAni prApnuvanti, daridrANAM samIpeShu susaMvAdaH prachAryyate, yaM prati vighnasvarUpohaM na bhavAmi sa dhanyaH,</para>
  <para style="p">
    <verse number="23" style="v"/>etAni yAni pashyathaH shR^iNuthashcha tAni yohanaM j nApayatam|</para>
  <para style="p">
    <verse number="24" style="v"/>tayo rdUtayo rgatayoH sato ryohani sa lokAn vaktumupachakrame, yUyaM madhyeprAntaraM kiM draShTuM niragamata? kiM vAyunA kampitaM naDaM?</para>
  <para style="p">
    <verse number="25" style="v"/>yUyaM kiM draShTuM niragamata? kiM sUkShmavastraparidhAyinaM kamapi naraM? kintu ye sUkShmamR^iduvastrANi paridadhati sUttamAni dravyANi bhu njate cha te rAjadhAnIShu tiShThanti|</para>
  <para style="p">
    <verse number="26" style="v"/>tarhi yUyaM kiM draShTuM niragamata? kimekaM bhaviShyadvAdinaM? tadeva satyaM kintu sa pumAn bhaviShyadvAdinopi shreShTha ityahaM yuShmAn vadAmi;</para>
  <para style="p">
    <verse number="27" style="v"/>pashya svakIyadUtantu tavAgra preShayAmyahaM| gatvA tvadIyamArgantu sa hi pariShkariShyati| yadarthe lipiriyam Aste sa eva yohan|</para>
  <para style="p">
    <verse number="28" style="v"/>ato yuShmAnahaM vadAmi striyA garbbhajAtAnAM bhaviShyadvAdinAM madhye yohano majjakAt shreShThaH kopi nAsti, tatrApi Ishvarasya rAjye yaH sarvvasmAt kShudraH sa yohanopi shreShThaH|</para>
  <para style="p">
    <verse number="29" style="v"/>apara ncha sarvve lokAH karama nchAyinashcha tasya vAkyAni shrutvA yohanA majjanena majjitAH parameshvaraM nirdoShaM menire|</para>
  <para style="p">
    <verse number="30" style="v"/>kintu phirUshino vyavasthApakAshcha tena na majjitAH svAn pratIshvarasyopadeshaM niShphalam akurvvan|</para>
  <para style="p">
    <verse number="31" style="v"/>atha prabhuH kathayAmAsa, idAnIntanajanAn kenopamAmi? te kasya sadR^ishAH?</para>
  <para style="p">
    <verse number="32" style="v"/>ye bAlakA vipaNyAm upavishya parasparam AhUya vAkyamidaM vadanti, vayaM yuShmAkaM nikaTe vaMshIravAdiShma, kintu yUyaM nAnarttiShTa, vayaM yuShmAkaM nikaTa arodiShma, kintu yuyaM na vyalapiShTa, bAlakairetAdR^ishaisteShAm upamA bhavati|</para>
  <para style="p">
    <verse number="33" style="v"/>yato yohan majjaka Agatya pUpaM nAkhAdat drAkShArasa ncha nApivat tasmAd yUyaM vadatha, bhUtagrastoyam|</para>
  <para style="p">
    <verse number="34" style="v"/>tataH paraM mAnavasuta AgatyAkhAdadapiva ncha tasmAd yUyaM vadatha, khAdakaH surApashchANDAlapApinAM bandhureko jano dR^ishyatAm|</para>
  <para style="p">
    <verse number="35" style="v"/>kintu j nAnino j nAnaM nirdoShaM viduH|</para>
  <para style="p">
    <verse number="36" style="v"/>pashchAdekaH phirUshI yIshuM bhojanAya nyamantrayat tataH sa tasya gR^ihaM gatvA bhoktumupaviShTaH|</para>
  <para style="p">
    <verse number="37" style="v"/>etarhi tatphirUshino gR^ihe yIshu rbhektum upAvekShIt tachChrutvA tannagaravAsinI kApi duShTA nArI pANDaraprastarasya sampuTake sugandhitailam AnIya</para>
  <para style="p">
    <verse number="38" style="v"/>tasya pashchAt pAdayoH sannidhau tasyau rudatI cha netrAmbubhistasya charaNau prakShAlya nijakachairamArkShIt, tatastasya charaNau chumbitvA tena sugandhitailena mamarda|</para>
  <para style="p">
    <verse number="39" style="v"/>tasmAt sa nimantrayitA phirUshI manasA chintayAmAsa, yadyayaM bhaviShyadvAdI bhavet tarhi enaM spR^ishati yA strI sA kA kIdR^ishI cheti j nAtuM shaknuyAt yataH sA duShTA|</para>
  <para style="p">
    <verse number="40" style="v"/>tadA yAshustaM jagAda, he shimon tvAM prati mama ki nchid vaktavyamasti; tasmAt sa babhAShe, he guro tad vadatu|</para>
  <para style="p">
    <verse number="41" style="v"/>ekottamarNasya dvAvadhamarNAvAstAM, tayorekaH pa nchashatAni mudrApAdAn aparashcha pa nchAshat mudrApAdAn dhArayAmAsa|</para>
  <para style="p">
    <verse number="42" style="v"/>tadanantaraM tayoH shodhyAbhAvAt sa uttamarNastayo rR^iNe chakShame; tasmAt tayordvayoH kastasmin preShyate bahu? tad brUhi|</para>
  <para style="p">
    <verse number="43" style="v"/>shimon pratyuvAcha, mayA budhyate yasyAdhikam R^iNaM chakShame sa iti; tato yIshustaM vyAjahAra, tvaM yathArthaM vyachArayaH|</para>
  <para style="p">
    <verse number="44" style="v"/>atha tAM nArIM prati vyAghuThya shimonamavochat, strImimAM pashyasi? tava gR^ihe mayyAgate tvaM pAdaprakShAlanArthaM jalaM nAdAH kintu yoShideShA nayanajalai rmama pAdau prakShAlya keshairamArkShIt|</para>
  <para style="p">
    <verse number="45" style="v"/>tvaM mAM nAchumbIH kintu yoShideShA svIyAgamanAdArabhya madIyapAdau chumbituM na vyaraMsta|</para>
  <para style="p">
    <verse number="46" style="v"/>tva ncha madIyottamA Nge ki nchidapi tailaM nAmardIH kintu yoShideShA mama charaNau sugandhitailenAmarddIt|</para>
  <para style="p">
    <verse number="47" style="v"/>atastvAM vyAharAmi, etasyA bahu pApamakShamyata tato bahu prIyate kintu yasyAlpapApaM kShamyate solpaM prIyate|</para>
  <para style="p">
    <verse number="48" style="v"/>tataH paraM sa tAM babhAShe, tvadIyaM pApamakShamyata|</para>
  <para style="p">
    <verse number="49" style="v"/>tadA tena sArddhaM ye bhoktum upavivishuste parasparaM vaktumArebhire, ayaM pApaM kShamate ka eShaH?</para>
  <para style="p">
    <verse number="50" style="v"/>kintu sa tAM nArIM jagAda, tava vishvAsastvAM paryyatrAsta tvaM kShemeNa vraja|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>apara ncha yIshu rdvAdashabhiH shiShyaiH sArddhaM nAnAnagareShu nAnAgrAmeShu cha gachChan ishvarIyarAjatvasya susaMvAdaM prachArayituM prArebhe|</para>
  <para style="p">
    <verse number="2" style="v"/>tadA yasyAH sapta bhUtA niragachChan sA magdalInIti vikhyAtA mariyam herodrAjasya gR^ihAdhipateH hoShe rbhAryyA yohanA shUshAnA</para>
  <para style="p">
    <verse number="3" style="v"/>prabhR^itayo yA bahvyaH striyaH duShTabhUtebhyo rogebhyashcha muktAH satyo nijavibhUtI rvyayitvA tamasevanta, tAH sarvvAstena sArddham Asan|</para>
  <para style="p">
    <verse number="4" style="v"/>anantaraM nAnAnagarebhyo bahavo lokA Agatya tasya samIpe.amilan, tadA sa tebhya ekAM dR^iShTAntakathAM kathayAmAsa| ekaH kR^iShIbalo bIjAni vaptuM bahirjagAma,</para>
  <para style="p">
    <verse number="5" style="v"/>tato vapanakAle katipayAni bIjAni mArgapArshve petuH, tatastAni padatalai rdalitAni pakShibhi rbhakShitAni cha|</para>
  <para style="p">
    <verse number="6" style="v"/>katipayAni bIjAni pAShANasthale patitAni yadyapi tAnya NkuritAni tathApi rasAbhAvAt shushuShuH|</para>
  <para style="p">
    <verse number="7" style="v"/>katipayAni bIjAni kaNTakivanamadhye patitAni tataH kaNTakivanAni saMvR^iddhya tAni jagrasuH|</para>
  <para style="p">
    <verse number="8" style="v"/>tadanyAni katipayabIjAni cha bhUmyAmuttamAyAM petustatastAnya NkurayitvA shataguNAni phalAni pheluH| sa imA kathAM kathayitvA prochchaiH provAcha, yasya shrotuM shrotre staH sa shR^iNotu|</para>
  <para style="p">
    <verse number="9" style="v"/>tataH paraM shiShyAstaM paprachChurasya dR^iShTAntasya kiM tAtparyyaM?</para>
  <para style="p">
    <verse number="10" style="v"/>tataH sa vyAjahAra, IshvarIyarAjyasya guhyAni j nAtuM yuShmabhyamadhikAro dIyate kintvanye yathA dR^iShTvApi na pashyanti shrutvApi ma budhyante cha tadarthaM teShAM purastAt tAH sarvvAH kathA dR^iShTAntena kathyante|</para>
  <para style="p">
    <verse number="11" style="v"/>dR^iShTAntasyAsyAbhiprAyaH, IshvarIyakathA bIjasvarUpA|</para>
  <para style="p">
    <verse number="12" style="v"/>ye kathAmAtraM shR^iNvanti kintu pashchAd vishvasya yathA paritrANaM na prApnuvanti tadAshayena shaitAnetya hR^idayAtR^i tAM kathAm apaharati ta eva mArgapArshvasthabhUmisvarUpAH|</para>
  <para style="p">
    <verse number="13" style="v"/>ye kathaM shrutvA sAnandaM gR^ihlanti kintvabaddhamUlatvAt svalpakAlamAtraM pratItya parIkShAkAle bhrashyanti taeva pAShANabhUmisvarUpAH|</para>
  <para style="p">
    <verse number="14" style="v"/>ye kathAM shrutvA yAnti viShayachintAyAM dhanalobhena eेhikasukhe cha majjanta upayuktaphalAni na phalanti ta evoptabIjakaNTakibhUsvarUpAH|</para>
  <para style="p">
    <verse number="15" style="v"/>kintu ye shrutvA saralaiH shuddhaishchAntaHkaraNaiH kathAM gR^ihlanti dhairyyam avalambya phalAnyutpAdayanti cha ta evottamamR^itsvarUpAH|</para>
  <para style="p">
    <verse number="16" style="v"/>apara ncha pradIpaM prajvAlya kopi pAtreNa nAchChAdayati tathA khaTvAdhopi na sthApayati, kintu dIpAdhAroparyyeva sthApayati, tasmAt praveshakA dIptiM pashyanti|</para>
  <para style="p">
    <verse number="17" style="v"/>yanna prakAshayiShyate tAdR^ig aprakAshitaM vastu kimapi nAsti yachcha na suvyaktaM prachArayiShyate tAdR^ig gR^iptaM vastu kimapi nAsti|</para>
  <para style="p">
    <verse number="18" style="v"/>ato yUyaM kena prakAreNa shR^iNutha tatra sAvadhAnA bhavata, yasya samIpe barddhate tasmai punardAsyate kintu yasyAshraye na barddhate tasya yadyadasti tadapi tasmAt neShyate|</para>
  <para style="p">
    <verse number="19" style="v"/>apara ncha yIsho rmAtA bhrAtarashcha tasya samIpaM jigamiShavaH</para>
  <para style="p">
    <verse number="20" style="v"/>kintu janatAsambAdhAt tatsannidhiM prAptuM na shekuH| tatpashchAt tava mAtA bhrAtarashcha tvAM sAkShAt chikIrShanto bahistiShThanatIti vArttAyAM tasmai kathitAyAM</para>
  <para style="p">
    <verse number="21" style="v"/>sa pratyuvAcha; ye janA Ishvarasya kathAM shrutvA tadanurUpamAcharanti taeva mama mAtA bhrAtarashcha|</para>
  <para style="p">
    <verse number="22" style="v"/>anantaraM ekadA yIshuH shiShyaiH sArddhaM nAvamAruhya jagAda, AyAta vayaM hradasya pAraM yAmaH, tataste jagmuH|</para>
  <para style="p">
    <verse number="23" style="v"/>teShu naukAM vAhayatsu sa nidadrau;</para>
  <para style="p">
    <verse number="24" style="v"/>athAkasmAt prabalajha nbhshagamAd hrade naukAyAM tara NgairAchChannAyAM vipat tAn jagrAsa|tasmAd yIshorantikaM gatvA he guro he guro prANA no yAntIti gaditvA taM jAgarayAmbabhUvuH|tadA sa utthAya vAyuM tara NgAMshcha tarjayAmAsa tasmAdubhau nivR^itya sthirau babhUvatuH|</para>
  <para style="p">
    <verse number="25" style="v"/>sa tAn babhAShe yuShmAkaM vishvAsaH ka? tasmAtte bhItA vismitAshcha parasparaM jagaduH, aho kIdR^igayaM manujaH pavanaM pAnIya nchAdishati tadubhayaM tadAdeshaM vahati|</para>
  <para style="p">
    <verse number="26" style="v"/>tataH paraM gAlIlpradeshasya sammukhasthagiderIyapradeshe naukAyAM lagantyAM taTe.avarohamAvAd</para>
  <para style="p">
    <verse number="27" style="v"/>bahutithakAlaM bhUtagrasta eko mAnuShaH purAdAgatya taM sAkShAchchakAra| sa manuSho vAso na paridadhat gR^ihe cha na vasan kevalaM shmashAnam adhyuvAsa|</para>
  <para style="p">
    <verse number="28" style="v"/>sa yIshuM dR^iShTvaiva chIchChabdaM chakAra tasya sammukhe patitvA prochchairjagAda cha, he sarvvapradhAneshvarasya putra, mayA saha tava kaH sambandhaH? tvayi vinayaM karomi mAM mA yAtaya|</para>
  <para style="p">
    <verse number="29" style="v"/>yataH sa taM mAnuShaM tyaktvA yAtum amedhyabhUtam Adidesha; sa bhUtastaM mAnuSham asakR^id dadhAra tasmAllokAH shR^i Nkhalena nigaDena cha babandhuH; sa tad bhaMktvA bhUtavashatvAt madhyeprAntaraM yayau|</para>
  <para style="p">
    <verse number="30" style="v"/>anantaraM yIshustaM paprachCha tava kinnAma? sa uvAcha, mama nAma bAhino yato bahavo bhUtAstamAshishriyuH|</para>
  <para style="p">
    <verse number="31" style="v"/>atha bhUtA vinayena jagaduH, gabhIraM garttaM gantuM mAj nApayAsmAn|</para>
  <para style="p">
    <verse number="32" style="v"/>tadA parvvatopari varAhavrajashcharati tasmAd bhUtA vinayena prochuH, amuM varAhavrajam Ashrayitum asmAn anujAnIhi; tataH sonujaj nau|</para>
  <para style="p">
    <verse number="33" style="v"/>tataH paraM bhUtAstaM mAnuShaM vihAya varAhavrajam AshishriyuH varAhavrajAshcha tatkShaNAt kaTakena dhAvanto hrade prANAn vijR^ihuH|</para>
  <para style="p">
    <verse number="34" style="v"/>tad dR^iShTvA shUkararakShakAH palAyamAnA nagaraM grAma ncha gatvA tatsarvvavR^ittAntaM kathayAmAsuH|</para>
  <para style="p">
    <verse number="35" style="v"/>tataH kiM vR^ittam etaddarshanArthaM lokA nirgatya yIshoH samIpaM yayuH, taM mAnuShaM tyaktabhUtaM parihitavastraM svasthamAnuShavad yIshoshcharaNasannidhau sUpavishantaM vilokya bibhyuH|</para>
  <para style="p">
    <verse number="36" style="v"/>ye lokAstasya bhUtagrastasya svAsthyakaraNaM dadR^ishuste tebhyaH sarvvavR^ittAntaM kathayAmAsuH|</para>
  <para style="p">
    <verse number="37" style="v"/>tadanantaraM tasya giderIyapradeshasya chaturdiksthA bahavo janA atitrastA vinayena taM jagaduH, bhavAn asmAkaM nikaTAd vrajatu tasmAt sa nAvamAruhya tato vyAghuTya jagAma|</para>
  <para style="p">
    <verse number="38" style="v"/>tadAnIM tyaktabhUtamanujastena saha sthAtuM prArthayA nchakre</para>
  <para style="p">
    <verse number="39" style="v"/>kintu tadartham IshvaraH kIdR^i NmahAkarmma kR^itavAn iti niveshanaM gatvA vij nApaya, yIshuH kathAmetAM kathayitvA taM visasarja| tataH sa vrajitvA yIshustadarthaM yanmahAkarmma chakAra tat purasya sarvvatra prakAshayituM prArebhe|</para>
  <para style="p">
    <verse number="40" style="v"/>atha yIshau parAvR^ityAgate lokAstaM AdareNa jagR^ihu ryasmAtte sarvve tamapekShA nchakrire|</para>
  <para style="p">
    <verse number="41" style="v"/>tadanantaraM yAyIrnAmno bhajanagehasyaikodhipa Agatya yIshoshcharaNayoH patitvA svaniveshanAgamanArthaM tasmin vinayaM chakAra,</para>
  <para style="p">
    <verse number="42" style="v"/>yatastasya dvAdashavarShavayaskA kanyaikAsIt sA mR^itakalpAbhavat| tatastasya gamanakAle mArge lokAnAM mahAn samAgamo babhUva|</para>
  <para style="p">
    <verse number="43" style="v"/>dvAdashavarShANi pradararogagrastA nAnA vaidyaishchikitsitA sarvvasvaM vyayitvApi svAsthyaM na prAptA yA yoShit sA yIshoH pashchAdAgatya tasya vastragranthiM pasparsha|</para>
  <para style="p">
    <verse number="44" style="v"/>tasmAt tatkShaNAt tasyA raktasrAvo ruddhaH|</para>
  <para style="p">
    <verse number="45" style="v"/>tadAnIM yIshuravadat kenAhaM spR^iShTaH? tato.anekairana NgIkR^ite pitarastasya sa NginashchAvadan, he guro lokA nikaTasthAH santastava dehe gharShayanti, tathApi kenAhaM spR^iShTa_iti bhavAn kutaH pR^ichChati?</para>
  <para style="p">
    <verse number="46" style="v"/>yIshuH kathayAmAsa, kenApyahaM spR^iShTo, yato mattaH shakti rnirgateti mayA nishchitamaj nAyi|</para>
  <para style="p">
    <verse number="47" style="v"/>tadA sA nArI svayaM na gupteti viditvA kampamAnA satI tasya sammukhe papAta; yena nimittena taM pasparsha sparshamAtrAchcha yena prakAreNa svasthAbhavat tat sarvvaM tasya sAkShAdAchakhyau|</para>
  <para style="p">
    <verse number="48" style="v"/>tataH sa tAM jagAda he kanye susthirA bhava, tava vishvAsastvAM svasthAm akArShIt tvaM kShemeNa yAhi|</para>
  <para style="p">
    <verse number="49" style="v"/>yIshoretadvAkyavadanakAle tasyAdhipate rniveshanAt kashchilloka Agatya taM babhAShe, tava kanyA mR^itA guruM mA klishAna|</para>
  <para style="p">
    <verse number="50" style="v"/>kintu yIshustadAkarNyAdhipatiM vyAjahAra, mA bhaiShIH kevalaM vishvasihi tasmAt sA jIviShyati|</para>
  <para style="p">
    <verse number="51" style="v"/>atha tasya niveshane prApte sa pitaraM yohanaM yAkUba ncha kanyAyA mAtaraM pitara ncha vinA, anyaM ka nchana praveShTuM vArayAmAsa|</para>
  <para style="p">
    <verse number="52" style="v"/>apara ncha ye rudanti vilapanti cha tAn sarvvAn janAn uvAcha, yUyaM mA rodiShTa kanyA na mR^itA nidrAti|</para>
  <para style="p">
    <verse number="53" style="v"/>kintu sA nishchitaM mR^iteti j nAtvA te tamupajahasuH|</para>
  <para style="p">
    <verse number="54" style="v"/>pashchAt sa sarvvAn bahiH kR^itvA kanyAyAH karau dhR^itvAjuhuve, he kanye tvamuttiShTha,</para>
  <para style="p">
    <verse number="55" style="v"/>tasmAt tasyAH prANeShu punarAgateShu sA tatkShaNAd uttasyau| tadAnIM tasyai ki nchid bhakShyaM dAtum Adidesha|</para>
  <para style="p">
    <verse number="56" style="v"/>tatastasyAH pitarau vismayaM gatau kintu sa tAvAdidesha ghaTanAyA etasyAH kathAM kasmaichidapi mA kathayataM|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataH paraM sa dvAdashashiShyAnAhUya bhUtAn tyAjayituM rogAn pratikarttu ncha tebhyaH shaktimAdhipatya ncha dadau|</para>
  <para style="p">
    <verse number="2" style="v"/>apara ncha IshvarIyarAjyasya susaMvAdaM prakAshayitum rogiNAmArogyaM karttu ncha preraNakAle tAn jagAda|</para>
  <para style="p">
    <verse number="3" style="v"/>yAtrArthaM yaShTi rvastrapuTakaM bhakShyaM mudrA dvitIyavastram, eShAM kimapi mA gR^ihlIta|</para>
  <para style="p">
    <verse number="4" style="v"/>yUya ncha yanniveshanaM pravishatha nagaratyAgaparyyanataM tanniveshane tiShThata|</para>
  <para style="p">
    <verse number="5" style="v"/>tatra yadi kasyachit purasya lokA yuShmAkamAtithyaM na kurvvanti tarhi tasmAnnagarAd gamanakAle teShAM viruddhaM sAkShyArthaM yuShmAkaM padadhUlIH sampAtayata|</para>
  <para style="p">
    <verse number="6" style="v"/>atha te prasthAya sarvvatra susaMvAdaM prachArayituM pIDitAn svasthAn karttu ncha grAmeShu bhramituM prArebhire|</para>
  <para style="p">
    <verse number="7" style="v"/>etarhi herod rAjA yIshoH sarvvakarmmaNAM vArttAM shrutvA bhR^ishamudvivije</para>
  <para style="p">
    <verse number="8" style="v"/>yataH kechidUchuryohan shmashAnAdudatiShThat| kechidUchuH, eliyo darshanaM dattavAn; evamanyalokA UchuH pUrvvIyaH kashchid bhaviShyadvAdI samutthitaH|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu heroduvAcha yohanaH shiro.ahamaChinadam idAnIM yasyedR^ikkarmmaNAM vArttAM prApnomi sa kaH? atha sa taM draShTum aichChat|</para>
  <para style="p">
    <verse number="10" style="v"/>anantaraM preritAH pratyAgatya yAni yAni karmmANi chakrustAni yIshave kathayAmAsuH tataH sa tAn baitsaidAnAmakanagarasya vijanaM sthAnaM nItvA guptaM jagAma|</para>
  <para style="p">
    <verse number="11" style="v"/>pashchAl lokAstad viditvA tasya pashchAd yayuH; tataH sa tAn nayan IshvarIyarAjyasya prasa NgamuktavAn, yeShAM chikitsayA prayojanam AsIt tAn svasthAn chakAra cha|</para>
  <para style="p">
    <verse number="12" style="v"/>apara ncha divAvasanne sati dvAdashashiShyA yIshorantikam etya kathayAmAsuH, vayamatra prAntarasthAne tiShThAmaH, tato nagarANi grAmANi gatvA vAsasthAnAni prApya bhakShyadravyANi kretuM jananivahaM bhavAn visR^ijatu|</para>
  <para style="p">
    <verse number="13" style="v"/>tadA sa uvAcha, yUyameva tAn bhejayadhvaM; tataste prochurasmAkaM nikaTe kevalaM pa ncha pUpA dvau matsyau cha vidyante, ataeva sthAnAntaram itvA nimittameteShAM bhakShyadravyeShu na krIteShu na bhavati|</para>
  <para style="p">
    <verse number="14" style="v"/>tatra prAyeNa pa nchasahasrANi puruShA Asan|</para>
  <para style="p">
    <verse number="15" style="v"/>tadA sa shiShyAn jagAda pa nchAshat pa nchAshajjanaiH paMktIkR^itya tAnupaveshayata, tasmAt te tadanusAreNa sarvvalokAnupaveshayApAsuH|</para>
  <para style="p">
    <verse number="16" style="v"/>tataH sa tAn pa ncha pUpAn mInadvaya ncha gR^ihItvA svargaM vilokyeshvaraguNAn kIrttayA nchakre bha NktA cha lokebhyaH pariveShaNArthaM shiShyeShu samarpayAmbabhUva|</para>
  <para style="p">
    <verse number="17" style="v"/>tataH sarvve bhuktvA tR^iptiM gatA avashiShTAnA ncha dvAdasha DallakAn saMjagR^ihuH|</para>
  <para style="p">
    <verse number="18" style="v"/>athaikadA nirjane shiShyaiH saha prArthanAkAle tAn paprachCha, lokA mAM kaM vadanti?</para>
  <para style="p">
    <verse number="19" style="v"/>tataste prAchuH, tvAM yohanmajjakaM vadanti; kechit tvAm eliyaM vadanti, pUrvvakAlikaH kashchid bhaviShyadvAdI shmashAnAd udatiShThad ityapi kechid vadanti|</para>
  <para style="p">
    <verse number="20" style="v"/>tadA sa uvAcha, yUyaM mAM kaM vadatha? tataH pitara uktavAn tvam IshvarAbhiShiktaH puruShaH|</para>
  <para style="p">
    <verse number="21" style="v"/>tadA sa tAn dR^iDhamAdidesha, kathAmetAM kasmaichidapi mA kathayata|</para>
  <para style="p">
    <verse number="22" style="v"/>sa punaruvAcha, manuShyaputreNa vahuyAtanA bhoktavyAH prAchInalokaiH pradhAnayAjakairadhyApakaishcha sovaj nAya hantavyaH kintu tR^itIyadivase shmashAnAt tenotthAtavyam|</para>
  <para style="p">
    <verse number="23" style="v"/>aparaM sa sarvvAnuvAcha, kashchid yadi mama pashchAd gantuM vA nChati tarhi sa svaM dAmyatu, dine dine krushaM gR^ihItvA cha mama pashchAdAgachChatu|</para>
  <para style="p">
    <verse number="24" style="v"/>yato yaH kashchit svaprANAn rirakShiShati sa tAn hArayiShyati, yaH kashchin madarthaM prANAn hArayiShyati sa tAn rakShiShyati|</para>
  <para style="p">
    <verse number="25" style="v"/>kashchid yadi sarvvaM jagat prApnoti kintu svaprANAn hArayati svayaM vinashyati cha tarhi tasya ko lAbhaH?</para>
  <para style="p">
    <verse number="26" style="v"/>puna ryaH kashchin mAM mama vAkyaM vA lajjAspadaM jAnAti manuShyaputro yadA svasya pitushcha pavitrANAM dUtAnA ncha tejobhiH pariveShTita AgamiShyati tadA sopi taM lajjAspadaM j nAsyati|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu yuShmAnahaM yathArthaM vadAmi, IshvarIyarAjatvaM na dR^iShTavA mR^ityuM nAsvAdiShyante, etAdR^ishAH kiyanto lokA atra sthane.api daNDAyamAnAH santi|</para>
  <para style="p">
    <verse number="28" style="v"/>etadAkhyAnakathanAt paraM prAyeNAShTasu dineShu gateShu sa pitaraM yohanaM yAkUba ncha gR^ihItvA prArthayituM parvvatamekaM samAruroha|</para>
  <para style="p">
    <verse number="29" style="v"/>atha tasya prArthanakAle tasya mukhAkR^itiranyarUpA jAtA, tadIyaM vastramujjvalashuklaM jAtaM|</para>
  <para style="p">
    <verse number="30" style="v"/>apara ncha mUsA eliyashchobhau tejasvinau dR^iShTau</para>
  <para style="p">
    <verse number="31" style="v"/>tau tena yirUshAlampure yo mR^ityuH sAdhiShyate tadIyAM kathAM tena sArddhaM kathayitum ArebhAte|</para>
  <para style="p">
    <verse number="32" style="v"/>tadA pitarAdayaH svasya sa Ngino nidrayAkR^iShTA Asan kintu jAgaritvA tasya tejastena sArddham uttiShThantau janau cha dadR^ishuH|</para>
  <para style="p">
    <verse number="33" style="v"/>atha tayorubhayo rgamanakAle pitaro yIshuM babhAShe, he guro.asmAkaM sthAne.asmin sthitiH shubhA, tata ekA tvadarthA, ekA mUsArthA, ekA eliyArthA, iti tisraH kuTyosmAbhi rnirmmIyantAM, imAM kathAM sa na vivichya kathayAmAsa|</para>
  <para style="p">
    <verse number="34" style="v"/>apara ncha tadvAkyavadanakAle payoda eka Agatya teShAmupari ChAyAM chakAra, tatastanmadhye tayoH praveshAt te shasha Nkire|</para>
  <para style="p">
    <verse number="35" style="v"/>tadA tasmAt payodAd iyamAkAshIyA vANI nirjagAma, mamAyaM priyaH putra etasya kathAyAM mano nidhatta|</para>
  <para style="p">
    <verse number="36" style="v"/>iti shabde jAte te yIshumekAkinaM dadR^ishuH kintu te tadAnIM tasya darshanasya vAchamekAmapi noktvA manaHsu sthApayAmAsuH|</para>
  <para style="p">
    <verse number="37" style="v"/>pare.ahani teShu tasmAchChailAd avarUDheShu taM sAkShAt karttuM bahavo lokA AjagmuH|</para>
  <para style="p">
    <verse number="38" style="v"/>teShAM madhyAd eko jana uchchairuvAcha, he guro ahaM vinayaM karomi mama putraM prati kR^ipAdR^iShTiM karotu, mama sa evaikaH putraH|</para>
  <para style="p">
    <verse number="39" style="v"/>bhUtena dhR^itaH san saM prasabhaM chIchChabdaM karoti tanmukhAt pheNA nirgachChanti cha, bhUta itthaM vidAryya kliShTvA prAyashastaM na tyajati|</para>
  <para style="p">
    <verse number="40" style="v"/>tasmAt taM bhUtaM tyAjayituM tava shiShyasamIpe nyavedayaM kintu te na shekuH|</para>
  <para style="p">
    <verse number="41" style="v"/>tadA yIshuravAdIt, re AvishvAsin vipathagAmin vaMsha katikAlAn yuShmAbhiH saha sthAsyAmyahaM yuShmAkam AcharaNAni cha sahiShye? tava putramihAnaya|</para>
  <para style="p">
    <verse number="42" style="v"/>tatastasminnAgatamAtre bhUtastaM bhUmau pAtayitvA vidadAra; tadA yIshustamamedhyaM bhUtaM tarjayitvA bAlakaM svasthaM kR^itvA tasya pitari samarpayAmAsa|</para>
  <para style="p">
    <verse number="43" style="v"/>Ishvarasya mahAshaktim imAM vilokya sarvve chamachchakruH; itthaM yIshoH sarvvAbhiH kriyAbhiH sarvvairlokairAshcharyye manyamAne sati sa shiShyAn babhAShe,</para>
  <para style="p">
    <verse number="44" style="v"/>katheyaM yuShmAkaM karNeShu pravishatu, manuShyaputro manuShyANAM kareShu samarpayiShyate|</para>
  <para style="p">
    <verse number="45" style="v"/>kintu te tAM kathAM na bubudhire, spaShTatvAbhAvAt tasyA abhiprAyasteShAM bodhagamyo na babhUva; tasyA AshayaH ka ityapi te bhayAt praShTuM na shekuH|</para>
  <para style="p">
    <verse number="46" style="v"/>tadanantaraM teShAM madhye kaH shreShThaH kathAmetAM gR^ihItvA te mitho vivAdaM chakruH|</para>
  <para style="p">
    <verse number="47" style="v"/>tato yIshusteShAM manobhiprAyaM viditvA bAlakamekaM gR^ihItvA svasya nikaTe sthApayitvA tAn jagAda,</para>
  <para style="p">
    <verse number="48" style="v"/>yo jano mama nAmnAsya bAlAsyAtithyaM vidadhAti sa mamAtithyaM vidadhAti, yashcha mamAtithyaM vidadhAti sa mama prerakasyAtithyaM vidadhAti, yuShmAkaM madhyeyaH svaM sarvvasmAt kShudraM jAnIte sa eva shreShTho bhaviShyati|</para>
  <para style="p">
    <verse number="49" style="v"/>apara ncha yohan vyAjahAra he prabheा tava nAmnA bhUtAn tyAjayantaM mAnuSham ekaM dR^iShTavanto vayaM, kintvasmAkam apashchAd gAmitvAt taM nyaShedhAm| tadAnIM yIshuruvAcha,</para>
  <para style="p">
    <verse number="50" style="v"/>taM mA niShedhata, yato yo janosmAkaM na vipakShaH sa evAsmAkaM sapakSho bhavati|</para>
  <para style="p">
    <verse number="51" style="v"/>anantaraM tasyArohaNasamaya upasthite sa sthirachetA yirUshAlamaM prati yAtrAM karttuM nishchityAgre dUtAn preShayAmAsa|</para>
  <para style="p">
    <verse number="52" style="v"/>tasmAt te gatvA tasya prayojanIyadravyANi saMgrahItuM shomiroNIyAnAM grAmaM pravivishuH|</para>
  <para style="p">
    <verse number="53" style="v"/>kintu sa yirUshAlamaM nagaraM yAti tato heto rlokAstasyAtithyaM na chakruH|</para>
  <para style="p">
    <verse number="54" style="v"/>ataeva yAkUbyohanau tasya shiShyau tad dR^iShTvA jagadatuH, he prabho eliyo yathA chakAra tathA vayamapi kiM gagaNAd Agantum etAn bhasmIkarttu ncha vahnimAj nApayAmaH? bhavAn kimichChati?</para>
  <para style="p">
    <verse number="55" style="v"/>kintu sa mukhaM parAvartya tAn tarjayitvA gaditavAn yuShmAkaM manobhAvaH kaH, iti yUyaM na jAnItha|</para>
  <para style="p">
    <verse number="56" style="v"/>manujasuto manujAnAM prANAn nAshayituM nAgachChat, kintu rakShitum AgachChat| pashchAd itaragrAmaM te yayuH|</para>
  <para style="p">
    <verse number="57" style="v"/>tadanantaraM pathi gamanakAle jana ekastaM babhAShe, he prabho bhavAn yatra yAti bhavatA sahAhamapi tatra yAsyAmi|</para>
  <para style="p">
    <verse number="58" style="v"/>tadAnIM yIshustamuvAcha, gomAyUnAM garttA Asate, vihAyasIyavihagAाnAM nIDAni cha santi, kintu mAnavatanayasya shiraH sthApayituM sthAnaM nAsti|</para>
  <para style="p">
    <verse number="59" style="v"/>tataH paraM sa itarajanaM jagAda, tvaM mama pashchAd ehi; tataH sa uvAcha, he prabho pUrvvaM pitaraM shmashAne sthApayituM mAmAdishatu|</para>
  <para style="p">
    <verse number="60" style="v"/>tadA yIshuruvAcha, mR^itA mR^itAn shmashAne sthApayantu kintu tvaM gatveshvarIyarAjyasya kathAM prachAraya|</para>
  <para style="p">
    <verse number="61" style="v"/>tatonyaH kathayAmAsa, he prabho mayApi bhavataH pashchAd gaMsyate, kintu pUrvvaM mama niveshanasya parijanAnAm anumatiM grahItum ahamAdishyai bhavatA|</para>
  <para style="p">
    <verse number="62" style="v"/>tadAnIM yIshustaM proktavAn, yo jano lA Ngale karamarpayitvA pashchAt pashyati sa IshvarIyarAjyaM nArhati|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataH paraM prabhuraparAn saptatishiShyAn niyujya svayaM yAni nagarANi yAni sthAnAni cha gamiShyati tAni nagarANi tAni sthAnAni cha prati dvau dvau janau prahitavAn|</para>
  <para style="p">
    <verse number="2" style="v"/>tebhyaH kathayAmAsa cha shasyAni bahUnIti satyaM kintu ChedakA alpe; tasmAddhetoH shasyakShetre ChedakAn aparAnapi preShayituM kShetrasvAminaM prArthayadhvaM|</para>
  <para style="p">
    <verse number="3" style="v"/>yUyaM yAta, pashyata, vR^ikANAM madhye meShashAvakAniva yuShmAn prahiNomi|</para>
  <para style="p">
    <verse number="4" style="v"/>yUyaM kShudraM mahad vA vasanasampuTakaM pAdukAshcha mA gR^ihlIta, mArgamadhye kamapi mA namata cha|</para>
  <para style="p">
    <verse number="5" style="v"/>apara ncha yUyaM yad yat niveshanaM pravishatha tatra niveshanasyAsya ma NgalaM bhUyAditi vAkyaM prathamaM vadata|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmAt tasmin niveshane yadi ma NgalapAtraM sthAsyati tarhi tanma NgalaM tasya bhaviShyati, nochet yuShmAn prati parAvarttiShyate|</para>
  <para style="p">
    <verse number="7" style="v"/>apara ncha te yatki nchid dAsyanti tadeva bhuktvA pItvA tasminniveshane sthAsyatha; yataH karmmakArI jano bhR^itim arhati; gR^ihAd gR^ihaM mA yAsyatha|</para>
  <para style="p">
    <verse number="8" style="v"/>anyachcha yuShmAsu kimapi nagaraM praviShTeShu lokA yadi yuShmAkam AtithyaM kariShyanti, tarhi yat khAdyam upasthAsyanti tadeva khAdiShyatha|</para>
  <para style="p">
    <verse number="9" style="v"/>tannagarasthAn rogiNaH svasthAn kariShyatha, IshvarIyaM rAjyaM yuShmAkam antikam Agamat kathAmetA ncha prachArayiShyatha|</para>
  <para style="p">
    <verse number="10" style="v"/>kintu kimapi puraM yuShmAsu praviShTeShu lokA yadi yuShmAkam AtithyaM na kariShyanti, tarhi tasya nagarasya panthAnaM gatvA kathAmetAM vadiShyatha,</para>
  <para style="p">
    <verse number="11" style="v"/>yuShmAkaM nagarIyA yA dhUlyo.asmAsu samalagan tA api yuShmAkaM prAtikUlyena sAkShyArthaM sampAtayAmaH; tathApIshvararAjyaM yuShmAkaM samIpam Agatam iti nishchitaM jAnIta|</para>
  <para style="p">
    <verse number="12" style="v"/>ahaM yuShmabhyaM yathArthaM kathayAmi, vichAradine tasya nagarasya dashAtaH sidomo dashA sahyA bhaviShyati|</para>
  <para style="p">
    <verse number="13" style="v"/>hA hA korAsIn nagara, hA hA baitsaidAnagara yuvayormadhye yAdR^ishAni AshcharyyANi karmmANyakriyanta, tAni karmmANi yadi sorasIdono rnagarayorakAriShyanta, tadA ito bahudinapUrvvaM tannivAsinaH shaNavastrANi paridhAya gAtreShu bhasma vilipya samupavishya samakhetsyanta|</para>
  <para style="p">
    <verse number="14" style="v"/>ato vichAradivase yuShmAkaM dashAtaH sorasIdonnivAsinAM dashA sahyA bhaviShyati|</para>
  <para style="p">
    <verse number="15" style="v"/>he kapharnAhUm, tvaM svargaM yAvad unnatA kintu narakaM yAvat nyagbhaviShyasi|</para>
  <para style="p">
    <verse number="16" style="v"/>yo jano yuShmAkaM vAkyaM gR^ihlAti sa mamaiva vAkyaM gR^ihlAti; ki ncha yo jano yuShmAkam avaj nAM karoti sa mamaivAvaj nAM karoti; yo jano mamAvaj nAM karoti cha sa matprerakasyaivAvaj nAM karoti|</para>
  <para style="p">
    <verse number="17" style="v"/>atha te saptatishiShyA Anandena pratyAgatya kathayAmAsuH, he prabho bhavato nAmnA bhUtA apyasmAkaM vashIbhavanti|</para>
  <para style="p">
    <verse number="18" style="v"/>tadAnIM sa tAn jagAda, vidyutamiva svargAt patantaM shaitAnam adarsham|</para>
  <para style="p">
    <verse number="19" style="v"/>pashyata sarpAn vR^ishchikAn ripoH sarvvaparAkramAMshcha padatalai rdalayituM yuShmabhyaM shaktiM dadAmi tasmAd yuShmAkaM kApi hAni rna bhaviShyati|</para>
  <para style="p">
    <verse number="20" style="v"/>bhUtA yuShmAkaM vashIbhavanti, etannimittat mA samullasata, svarge yuShmAkaM nAmAni likhitAni santIti nimittaM samullasata|</para>
  <para style="p">
    <verse number="21" style="v"/>tadghaTikAyAM yIshu rmanasi jAtAhlAdaH kathayAmAsa he svargapR^ithivyorekAdhipate pitastvaM j nAnavatAM viduShA ncha lokAnAM purastAt sarvvametad aprakAshya bAlakAnAM purastAt prAkAshaya etasmAddhetostvAM dhanyaM vadAmi, he pitaritthaM bhavatu yad etadeva tava gochara uttamam|</para>
  <para style="p">
    <verse number="22" style="v"/>pitrA sarvvANi mayi samarpitAni pitaraM vinA kopi putraM na jAnAti ki ncha putraM vinA yasmai janAya putrastaM prakAshitavAn ta ncha vinA kopi pitaraM na jAnAti|</para>
  <para style="p">
    <verse number="23" style="v"/>tapaH paraM sa shiShyAn prati parAvR^itya guptaM jagAda, yUyametAni sarvvANi pashyatha tato yuShmAkaM chakShUMShi dhanyAni|</para>
  <para style="p">
    <verse number="24" style="v"/>yuShmAnahaM vadAmi, yUyaM yAni sarvvANi pashyatha tAni bahavo bhaviShyadvAdino bhUpatayashcha draShTumichChantopi draShTuM na prApnuvan, yuShmAbhi ryA yAH kathAshcha shrUyante tAH shrotumichChantopi shrotuM nAlabhanta|</para>
  <para style="p">
    <verse number="25" style="v"/>anantaram eko vyavasthApaka utthAya taM parIkShituM paprachCha, he upadeshaka anantAyuShaH prAptaye mayA kiM karaNIyaM?</para>
  <para style="p">
    <verse number="26" style="v"/>yIshuH pratyuvAcha, atrArthe vyavasthAyAM kiM likhitamasti? tvaM kIdR^ik paThasi?</para>
  <para style="p">
    <verse number="27" style="v"/>tataH sovadat, tvaM sarvvAntaHkaraNaiH sarvvaprANaiH sarvvashaktibhiH sarvvachittaishcha prabhau parameshvare prema kuru, samIpavAsini svavat prema kuru cha|</para>
  <para style="p">
    <verse number="28" style="v"/>tadA sa kathayAmAsa, tvaM yathArthaM pratyavochaH, ittham Achara tenaiva jIviShyasi|</para>
  <para style="p">
    <verse number="29" style="v"/>kintu sa janaH svaM nirddoShaM j nApayituM yIshuM paprachCha, mama samIpavAsI kaH? tato yIshuH pratyuvAcha,</para>
  <para style="p">
    <verse number="30" style="v"/>eko jano yirUshAlampurAd yirIhopuraM yAti, etarhi dasyUnAM kareShu patite te tasya vastrAdikaM hR^itavantaH tamAhatya mR^itaprAyaM kR^itvA tyaktvA yayuH|</para>
  <para style="p">
    <verse number="31" style="v"/>akasmAd eko yAjakastena mArgeNa gachChan taM dR^iShTvA mArgAnyapArshvena jagAma|</para>
  <para style="p">
    <verse number="32" style="v"/>ittham eko levIyastatsthAnaM prApya tasyAntikaM gatvA taM vilokyAnyena pArshvena jagAma|</para>
  <para style="p">
    <verse number="33" style="v"/>kintvekaH shomiroNIyo gachChan tatsthAnaM prApya taM dR^iShTvAdayata|</para>
  <para style="p">
    <verse number="34" style="v"/>tasyAntikaM gatvA tasya kShateShu tailaM drAkShArasa ncha prakShipya kShatAni baddhvA nijavAhanopari tamupaveshya pravAsIyagR^iham AnIya taM siSheve|</para>
  <para style="p">
    <verse number="35" style="v"/>parasmin divase nijagamanakAle dvau mudrApAdau tadgR^ihasvAmine dattvAvadat janamenaM sevasva tatra yo.adhiko vyayo bhaviShyati tamahaM punarAgamanakAle parishotsyAmi|</para>
  <para style="p">
    <verse number="36" style="v"/>eShAM trayANAM madhye tasya dasyuhastapatitasya janasya samIpavAsI kaH? tvayA kiM budhyate?</para>
  <para style="p">
    <verse number="37" style="v"/>tataH sa vyavasthApakaH kathayAmAsa yastasmin dayAM chakAra| tadA yIshuH kathayAmAsa tvamapi gatvA tathAchara|</para>
  <para style="p">
    <verse number="38" style="v"/>tataH paraM te gachChanta ekaM grAmaM pravivishuH; tadA marthAnAmA strI svagR^ihe tasyAtithyaM chakAra|</para>
  <para style="p">
    <verse number="39" style="v"/>tasmAt mariyam nAmadheyA tasyA bhaginI yIshoH padasamIpa uvavishya tasyopadeshakathAM shrotumArebhe|</para>
  <para style="p">
    <verse number="40" style="v"/>kintu marthA nAnAparicharyyAyAM vyagrA babhUva tasmAddhetostasya samIpamAgatya babhAShe; he prabho mama bhaginI kevalaM mamopari sarvvakarmmaNAM bhAram arpitavatI tatra bhavatA ki nchidapi na mano nidhIyate kim? mama sAhAyyaM karttuM bhavAn tAmAdishatu|</para>
  <para style="p">
    <verse number="41" style="v"/>tato yIshuH pratyuvAcha he marthe he marthe, tvaM nAnAkAryyeShu chintitavatI vyagrA chAsi,</para>
  <para style="p">
    <verse number="42" style="v"/>kintu prayojanIyam ekamAtram Aste| apara ncha yamuttamaM bhAgaM kopi harttuM na shaknoti saeva mariyamA vR^itaH|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM sa kasmiMshchit sthAne prArthayata tatsamAptau satyAM tasyaikaH shiShyastaM jagAda he prabho yohan yathA svashiShyAn prArthayitum upadiShTavAn tathA bhavAnapyasmAn upadishatu|</para>
  <para style="p">
    <verse number="2" style="v"/>tasmAt sa kathayAmAsa, prArthanakAle yUyam itthaM kathayadhvaM, he asmAkaM svargasthapitastava nAma pUjyaM bhavatu; tava rAjatvaM bhavatu; svarge yathA tathA pR^ithivyAmapi tavechChayA sarvvaM bhavatu|</para>
  <para style="p">
    <verse number="3" style="v"/>pratyaham asmAkaM prayojanIyaM bhojyaM dehi|</para>
  <para style="p">
    <verse number="4" style="v"/>yathA vayaM sarvvAn aparAdhinaH kShamAmahe tathA tvamapi pApAnyasmAkaM kShamasva| asmAn parIkShAM mAnaya kintu pApAtmano rakSha|</para>
  <para style="p">
    <verse number="5" style="v"/>pashchAt soparamapi kathitavAn yadi yuShmAkaM kasyachid bandhustiShThati nishIthe cha tasya samIpaM sa gatvA vadati,</para>
  <para style="p">
    <verse number="6" style="v"/>he bandho pathika eko bandhu rmama niveshanam AyAtaH kintu tasyAtithyaM karttuM mamAntike kimapi nAsti, ataeva pUpatrayaM mahyam R^iNaM dehi;</para>
  <para style="p">
    <verse number="7" style="v"/>tadA sa yadi gR^ihamadhyAt prativadati mAM mA klishAna, idAnIM dvAraM ruddhaM shayane mayA saha bAlakAshcha tiShThanti tubhyaM dAtum utthAtuM na shaknomi,</para>
  <para style="p">
    <verse number="8" style="v"/>tarhi yuShmAnahaM vadAmi, sa yadi mitratayA tasmai kimapi dAtuM nottiShThati tathApi vAraM vAraM prArthanAta utthApitaH san yasmin tasya prayojanaM tadeva dAsyati|</para>
  <para style="p">
    <verse number="9" style="v"/>ataH kAraNAt kathayAmi, yAchadhvaM tato yuShmabhyaM dAsyate, mR^igayadhvaM tata uddeshaM prApsyatha, dvAram Ahata tato yuShmabhyaM dvAraM mokShyate|</para>
  <para style="p">
    <verse number="10" style="v"/>yo yAchate sa prApnoti, yo mR^igayate sa evoddeshaM prApnoti, yo dvAram Ahanti tadarthaM dvAraM mochyate|</para>
  <para style="p">
    <verse number="11" style="v"/>putreNa pUpe yAchite tasmai pAShANaM dadAti vA matsye yAchite tasmai sarpaM dadAti</para>
  <para style="p">
    <verse number="12" style="v"/>vA aNDe yAchite tasmai vR^ishchikaM dadAti yuShmAkaM madhye ka etAdR^ishaH pitAste?</para>
  <para style="p">
    <verse number="13" style="v"/>tasmAdeva yUyamabhadrA api yadi svasvabAlakebhya uttamAni dravyANi dAtuM jAnItha tarhyasmAkaM svargasthaH pitA nijayAchakebhyaH kiM pavitram AtmAnaM na dAsyati?</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraM yIshunA kasmAchchid ekasmin mUkabhUte tyAjite sati sa bhUtatyakto mAnuSho vAkyaM vaktum Arebhe; tato lokAH sakalA AshcharyyaM menire|</para>
  <para style="p">
    <verse number="15" style="v"/>kintu teShAM kechidUchu rjanoyaM bAlasibUbA arthAd bhUtarAjena bhUtAn tyAjayati|</para>
  <para style="p">
    <verse number="16" style="v"/>taM parIkShituM kechid AkAshIyam ekaM chihnaM darshayituM taM prArthayA nchakrire|</para>
  <para style="p">
    <verse number="17" style="v"/>tadA sa teShAM manaHkalpanAM j nAtvA kathayAmAsa, kasyachid rAjyasya lokA yadi parasparaM virundhanti tarhi tad rAjyam nashyati; kechid gR^ihasthA yadi parasparaM virundhanti tarhi tepi nashyanti|</para>
  <para style="p">
    <verse number="18" style="v"/>tathaiva shaitAnapi svalokAn yadi viruNaddhi tadA tasya rAjyaM kathaM sthAsyati? bAlasibUbAhaM bhUtAn tyAjayAmi yUyamiti vadatha|</para>
  <para style="p">
    <verse number="19" style="v"/>yadyahaM bAlasibUbA bhUtAn tyAjayAmi tarhi yuShmAkaM santAnAH kena tyAjayanti? tasmAt taeva kathAyA etasyA vichArayitAro bhaviShyanti|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu yadyaham Ishvarasya parAkrameNa bhUtAn tyAjayAmi tarhi yuShmAkaM nikaTam Ishvarasya rAjyamavashyam upatiShThati|</para>
  <para style="p">
    <verse number="21" style="v"/>balavAn pumAn susajjamAno yatikAlaM nijATTAlikAM rakShati tatikAlaM tasya dravyaM nirupadravaM tiShThati|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu tasmAd adhikabalaH kashchidAgatya yadi taM jayati tarhi yeShu shastrAstreShu tasya vishvAsa AsIt tAni sarvvANi hR^itvA tasya dravyANi gR^ihlAti|</para>
  <para style="p">
    <verse number="23" style="v"/>ataH kAraNAd yo mama sapakSho na sa vipakShaH, yo mayA saha na saMgR^ihlAti sa vikirati|</para>
  <para style="p">
    <verse number="24" style="v"/>apara ncha amedhyabhUto mAnuShasyAntarnirgatya shuShkasthAne bhrAntvA vishrAmaM mR^igayate kintu na prApya vadati mama yasmAd gR^ihAd AgatohaM punastad gR^ihaM parAvR^itya yAmi|</para>
  <para style="p">
    <verse number="25" style="v"/>tato gatvA tad gR^ihaM mArjitaM shobhita ncha dR^iShTvA</para>
  <para style="p">
    <verse number="26" style="v"/>tatkShaNam apagatya svasmAdapi durmmatIn aparAn saptabhUtAn sahAnayati te cha tadgR^ihaM pavishya nivasanti| tasmAt tasya manuShyasya prathamadashAtaH sheShadashA duHkhatarA bhavati|</para>
  <para style="p">
    <verse number="27" style="v"/>asyAH kathAyAH kathanakAle janatAmadhyasthA kAchinnArI tamuchchaiHsvaraM provAcha, yA yoShit tvAM garbbhe.adhArayat stanyamapAyayachcha saiva dhanyA|</para>
  <para style="p">
    <verse number="28" style="v"/>kintu sokathayat ye parameshvarasya kathAM shrutvA tadanurUpam Acharanti taeva dhanyAH|</para>
  <para style="p">
    <verse number="29" style="v"/>tataH paraM tasyAntike bahulokAnAM samAgame jAte sa vaktumArebhe, AdhunikA duShTalokAshchihnaM draShTumichChanti kintu yUnasbhaviShyadvAdinashchihnaM vinAnyat ki nchichchihnaM tAn na darshayiShyate|</para>
  <para style="p">
    <verse number="30" style="v"/>yUnas tu yathA nInivIyalokAnAM samIpe chihnarUpobhavat tathA vidyamAnalokAnAm eShAM samIpe manuShyaputropi chihnarUpo bhaviShyati|</para>
  <para style="p">
    <verse number="31" style="v"/>vichArasamaye idAnIntanalokAnAM prAtikUlyena dakShiNadeshIyA rAj nI protthAya tAn doShiNaH kariShyati, yataH sA rAj nI sulemAna upadeshakathAM shrotuM pR^ithivyAH sImAta AgachChat kintu pashyata sulemAnopi gurutara eko jano.asmin sthAne vidyate|</para>
  <para style="p">
    <verse number="32" style="v"/>apara ncha vichArasamaye nInivIyalokA api varttamAnakAlikAnAM lokAnAM vaiparItyena protthAya tAn doShiNaH kariShyanti, yato hetoste yUnaso vAkyAt chittAni parivarttayAmAsuH kintu pashyata yUnasotigurutara eko jano.asmin sthAne vidyate|</para>
  <para style="p">
    <verse number="33" style="v"/>pradIpaM prajvAlya droNasyAdhaH kutrApi guptasthAne vA kopi na sthApayati kintu gR^ihapraveshibhyo dIptiM dAtaM dIpAdhAroparyyeva sthApayati|</para>
  <para style="p">
    <verse number="34" style="v"/>dehasya pradIpashchakShustasmAdeva chakShu ryadi prasannaM bhavati tarhi tava sarvvasharIraM dIptimad bhaviShyati kintu chakShu ryadi malImasaM tiShThati tarhi sarvvasharIraM sAndhakAraM sthAsyati|</para>
  <para style="p">
    <verse number="35" style="v"/>asmAt kAraNAt tavAntaHsthaM jyoti ryathAndhakAramayaM na bhavati tadarthe sAvadhAno bhava|</para>
  <para style="p">
    <verse number="36" style="v"/>yataH sharIrasya kutrApyaMshe sAndhakAre na jAte sarvvaM yadi dIptimat tiShThati tarhi tubhyaM dIptidAyiprojjvalan pradIpa iva tava savarvasharIraM dIptimad bhaviShyati|</para>
  <para style="p">
    <verse number="37" style="v"/>etatkathAyAH kathanakAle phirushyeko bhejanAya taM nimantrayAmAsa, tataH sa gatvA bhoktum upavivesha|</para>
  <para style="p">
    <verse number="38" style="v"/>kintu bhojanAt pUrvvaM nAmA NkShIt etad dR^iShTvA sa phirushyAshcharyyaM mene|</para>
  <para style="p">
    <verse number="39" style="v"/>tadA prabhustaM provAcha yUyaM phirUshilokAH pAnapAtrANAM bhojanapAtrANA ncha bahiH pariShkurutha kintu yuShmAkamanta rdaurAtmyai rduShkriyAbhishcha paripUrNaM tiShThati|</para>
  <para style="p">
    <verse number="40" style="v"/>he sarvve nirbodhA yo bahiH sasarja sa eva kimanta rna sasarja?</para>
  <para style="p">
    <verse number="41" style="v"/>tata eva yuShmAbhirantaHkaraNaM (IshvarAya) nivedyatAM tasmin kR^ite yuShmAkaM sarvvANi shuchitAM yAsyanti|</para>
  <para style="p">
    <verse number="42" style="v"/>kintu hanta phirUshigaNA yUyaM nyAyam Ishvare prema cha parityajya podinAyA arudAdInAM sarvveShAM shAkAnA ncha dashamAMshAn dattha kintu prathamaM pAlayitvA sheShasyAla NghanaM yuShmAkam uchitamAsIt|</para>
  <para style="p">
    <verse number="43" style="v"/>hA hA phirUshino yUyaM bhajanagehe prochchAsane ApaNeShu cha namaskAreShu prIyadhve|</para>
  <para style="p">
    <verse number="44" style="v"/>vata kapaTino.adhyApakAH phirUshinashcha lokAyat shmashAnam anupalabhya tadupari gachChanti yUyam tAdR^igaprakAshitashmashAnavAd bhavatha|</para>
  <para style="p">
    <verse number="45" style="v"/>tadAnIM vyavasthApakAnAm ekA yIshumavadat, he upadeshaka vAkyenedR^ishenAsmAsvapi doSham Aropayasi|</para>
  <para style="p">
    <verse number="46" style="v"/>tataH sa uvAcha, hA hA vyavasthApakA yUyam mAnuShANAm upari duHsahyAn bhArAn nyasyatha kintu svayam ekA NguुlyApi tAn bhArAn na spR^ishatha|</para>
  <para style="p">
    <verse number="47" style="v"/>hanta yuShmAkaM pUrvvapuruShA yAn bhaviShyadvAdino.avadhiShusteShAM shmashAnAni yUyaM nirmmAtha|</para>
  <para style="p">
    <verse number="48" style="v"/>tenaiva yUyaM svapUrvvapuruShANAM karmmANi saMmanyadhve tadeva sapramANaM kurutha cha, yataste tAnavadhiShuH yUyaM teShAM shmashAnAni nirmmAtha|</para>
  <para style="p">
    <verse number="49" style="v"/>ataeva Ishvarasya shAstre proktamasti teShAmantike bhaviShyadvAdinaH preritAMshcha preShayiShyAmi tataste teShAM kAMshchana haniShyanti kAMshchana tADashShyinti|</para>
  <para style="p">
    <verse number="50" style="v"/>etasmAt kAraNAt hAbilaH shoNitapAtamArabhya mandirayaj navedyo rmadhye hatasya sikhariyasya raktapAtaparyyantaM</para>
  <para style="p">
    <verse number="51" style="v"/>jagataH sR^iShTimArabhya pR^ithivyAM bhaviShyadvAdinAM yatiraktapAtA jAtAstatInAm aparAdhadaNDA eShAM varttamAnalokAnAM bhaviShyanti, yuShmAnahaM nishchitaM vadAmi sarvve daNDA vaMshasyAsya bhaviShyanti|</para>
  <para style="p">
    <verse number="52" style="v"/>hA hA vyavasthapakA yUyaM j nAnasya ku nchikAM hR^itvA svayaM na praviShTA ye praveShTu ncha prayAsinastAnapi praveShTuM vAritavantaH|</para>
  <para style="p">
    <verse number="53" style="v"/>itthaM kathAkathanAd adhyApakAH phirUshinashcha satarkAH</para>
  <para style="p">
    <verse number="54" style="v"/>santastamapavadituM tasya kathAyA doShaM dharttamichChanto nAnAkhyAnakathanAya taM pravarttayituM kopayitu ncha prArebhire|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadAnIM lokAH sahasraM sahasram Agatya samupasthitAstata ekaiko .anyeShAmupari patitum upachakrame; tadA yIshuH shiShyAn babhAShe, yUyaM phirUshinAM kiNvarUpakApaTye visheSheNa sAvadhAnAstiShThata|</para>
  <para style="p">
    <verse number="2" style="v"/>yato yanna prakAshayiShyate tadAchChannaM vastu kimapi nAsti; tathA yanna j nAsyate tad guptaM vastu kimapi nAsti|</para>
  <para style="p">
    <verse number="3" style="v"/>andhakAre tiShThanato yAH kathA akathayata tAH sarvvAH kathA dIptau shroShyante nirjane karNe cha yadakathayata gR^ihapR^iShThAt tat prachArayiShyate|</para>
  <para style="p">
    <verse number="4" style="v"/>he bandhavo yuShmAnahaM vadAmi, ye sharIrasya nAshaM vinA kimapyaparaM karttuM na shakruvanti tebhyo mA bhaiShTa|</para>
  <para style="p">
    <verse number="5" style="v"/>tarhi kasmAd bhetavyam ityahaM vadAmi, yaH sharIraM nAshayitvA narakaM nikSheptuM shaknoti tasmAdeva bhayaM kuruta, punarapi vadAmi tasmAdeva bhayaM kuruta|</para>
  <para style="p">
    <verse number="6" style="v"/>pa ncha chaTakapakShiNaH kiM dvAbhyAM tAmrakhaNDAbhyAM na vikrIyante? tathApIshvarasteShAm ekamapi na vismarati|</para>
  <para style="p">
    <verse number="7" style="v"/>yuShmAkaM shiraHkeshA api gaNitAH santi tasmAt mA vibhIta bahuchaTakapakShibhyopi yUyaM bahumUlyAH|</para>
  <para style="p">
    <verse number="8" style="v"/>aparaM yuShmabhyaM kathayAmi yaH kashchin mAnuShANAM sAkShAn mAM svIkaroti manuShyaputra IshvaradUtAnAM sAkShAt taM svIkariShyati|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu yaH kashchinmAnuShANAM sAkShAnmAm asvIkaroti tam Ishvarasya dUtAnAM sAkShAd aham asvIkariShyAmi|</para>
  <para style="p">
    <verse number="10" style="v"/>anyachcha yaH kashchin manujasutasya nindAbhAvena kA nchit kathAM kathayati tasya tatpApasya mochanaM bhaviShyati kintu yadi kashchit pavitram AtmAnaM nindati tarhi tasya tatpApasya mochanaM na bhaviShyati|</para>
  <para style="p">
    <verse number="11" style="v"/>yadA lokA yuShmAn bhajanagehaM vichArakartR^irAjyakartR^iNAM sammukha ncha neShyanti tadA kena prakAreNa kimuttaraM vadiShyatha kiM kathayiShyatha chetyatra mA chintayata;</para>
  <para style="p">
    <verse number="12" style="v"/>yato yuShmAbhiryad yad vaktavyaM tat tasmin samayaeva pavitra AtmA yuShmAn shikShayiShyati|</para>
  <para style="p">
    <verse number="13" style="v"/>tataH paraM janatAmadhyasthaH kashchijjanastaM jagAda he guro mayA saha paitR^ikaM dhanaM vibhaktuM mama bhrAtaramAj nApayatu bhavAn|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu sa tamavadat he manuShya yuvayo rvichAraM vibhAga ncha karttuM mAM ko niyuktavAn?</para>
  <para style="p">
    <verse number="15" style="v"/>anantaraM sa lokAnavadat lobhe sAvadhAnAH satarkAshcha tiShThata, yato bahusampattiprAptyA manuShyasyAyu rna bhavati|</para>
  <para style="p">
    <verse number="16" style="v"/>pashchAd dR^iShTAntakathAmutthApya kathayAmAsa, ekasya dhanino bhUmau bahUni shasyAni jAtAni|</para>
  <para style="p">
    <verse number="17" style="v"/>tataH sa manasA chintayitvA kathayAmbabhUva mamaitAni samutpannAni dravyANi sthApayituM sthAnaM nAsti kiM kariShyAmi?</para>
  <para style="p">
    <verse number="18" style="v"/>tatovadad itthaM kariShyAmi, mama sarvvabhANDAgArANi bha NktvA bR^ihadbhANDAgArANi nirmmAya tanmadhye sarvvaphalAni dravyANi cha sthApayiShyAmi|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaM nijamano vadiShyAmi, he mano bahuvatsarArthaM nAnAdravyANi sa nchitAni santi vishrAmaM kuru bhuktvA pItvA kautuka ncha kuru| kintvIshvarastam avadat,</para>
  <para style="p">
    <verse number="20" style="v"/>re nirbodha adya rAtrau tava prANAstvatto neShyante tata etAni yAni dravyANi tvayAsAditAni tAni kasya bhaviShyanti?</para>
  <para style="p">
    <verse number="21" style="v"/>ataeva yaH kashchid Ishvarasya samIpe dhanasa nchayamakR^itvA kevalaM svanikaTe sa nchayaM karoti sopi tAdR^ishaH|</para>
  <para style="p">
    <verse number="22" style="v"/>atha sa shiShyebhyaH kathayAmAsa, yuShmAnahaM vadAmi, kiM khAdiShyAmaH? kiM paridhAsyAmaH? ityuktvA jIvanasya sharIrasya chArthaM chintAM mA kArShTa|</para>
  <para style="p">
    <verse number="23" style="v"/>bhakShyAjjIvanaM bhUShaNAchCharIra ncha shreShThaM bhavati|</para>
  <para style="p">
    <verse number="24" style="v"/>kAkapakShiNAM kAryyaM vichArayata, te na vapanti shasyAni cha na Chindanti, teShAM bhANDAgArANi na santi koShAshcha na santi, tathApIshvarastebhyo bhakShyANi dadAti, yUyaM pakShibhyaH shreShThatarA na kiM?</para>
  <para style="p">
    <verse number="25" style="v"/>apara ncha bhAvayitvA nijAyuShaH kShaNamAtraM varddhayituM shaknoti, etAdR^isho lAko yuShmAkaM madhye kosti?</para>
  <para style="p">
    <verse number="26" style="v"/>ataeva kShudraM kAryyaM sAdhayitum asamarthA yUyam anyasmin kAryye kuto bhAvayatha?</para>
  <para style="p">
    <verse number="27" style="v"/>anyachcha kAmpilapuShpaM kathaM varddhate tadApi vichArayata, tat ka nchana shramaM na karoti tantUMshcha na janayati kintu yuShmabhyaM yathArthaM kathayAmi sulemAn bahvaishvaryyAnvitopi puShpasyAsya sadR^isho vibhUShito nAsIt|</para>
  <para style="p">
    <verse number="28" style="v"/>adya kShetre varttamAnaM shvashchUllyAM kShepsyamAnaM yat tR^iNaM, tasmai yadIshvara itthaM bhUShayati tarhi he alpapratyayino yuShmAna kiM na paridhApayiShyati?</para>
  <para style="p">
    <verse number="29" style="v"/>ataeva kiM khAdiShyAmaH? kiM paridhAsyAmaH? etadarthaM mA cheShTadhvaM mA saMdigdhva ncha|</para>
  <para style="p">
    <verse number="30" style="v"/>jagato devArchchakA etAni sarvvANi cheShTanate; eShu vastuShu yuShmAkaM prayojanamAste iti yuShmAkaM pitA jAnAti|</para>
  <para style="p">
    <verse number="31" style="v"/>ataeveshvarasya rAjyArthaM sacheShTA bhavata tathA kR^ite sarvvANyetAni dravyANi yuShmabhyaM pradAyiShyante|</para>
  <para style="p">
    <verse number="32" style="v"/>he kShudrameShavraja yUyaM mA bhaiShTa yuShmabhyaM rAjyaM dAtuM yuShmAkaM pituH sammatirasti|</para>
  <para style="p">
    <verse number="33" style="v"/>ataeva yuShmAkaM yA yA sampattirasti tAM tAM vikrIya vitarata, yat sthAnaM chaurA nAgachChanti, kITAshcha na kShAyayanti tAdR^ishe svarge nijArtham ajare sampuTake .akShayaM dhanaM sa nchinuta cha;</para>
  <para style="p">
    <verse number="34" style="v"/>yato yatra yuShmAkaM dhanaM varttate tatreva yuShmAkaM manaH|</para>
  <para style="p">
    <verse number="35" style="v"/>apara ncha yUyaM pradIpaM jvAlayitvA baddhakaTayastiShThata;</para>
  <para style="p">
    <verse number="36" style="v"/>prabhu rvivAhAdAgatya yadaiva dvAramAhanti tadaiva dvAraM mochayituM yathA bhR^ityA apekShya tiShThanti tathA yUyamapi tiShThata|</para>
  <para style="p">
    <verse number="37" style="v"/>yataH prabhurAgatya yAn dAsAn sachetanAn tiShThato drakShyati taeva dhanyAH; ahaM yuShmAn yathArthaM vadAmi prabhustAn bhojanArtham upaveshya svayaM baddhakaTiH samIpametya pariveShayiShyati|</para>
  <para style="p">
    <verse number="38" style="v"/>yadi dvitIye tR^itIye vA prahare samAgatya tathaiva pashyati, tarhi taeva dAsA dhanyAH|</para>
  <para style="p">
    <verse number="39" style="v"/>apara ncha kasmin kShaNe chaurA AgamiShyanti iti yadi gR^ihapati rj nAtuM shaknoti tadAvashyaM jAgran nijagR^ihe sandhiM karttayituM vArayati yUyametad vitta|</para>
  <para style="p">
    <verse number="40" style="v"/>ataeva yUyamapi sajjamAnAstiShThata yato yasmin kShaNe taM nAprekShadhve tasminneva kShaNe manuShyaputra AgamiShyati|</para>
  <para style="p">
    <verse number="41" style="v"/>tadA pitaraH paprachCha, he prabho bhavAn kimasmAn uddishya kiM sarvvAn uddishya dR^iShTAntakathAmimAM vadati?</para>
  <para style="p">
    <verse number="42" style="v"/>tataH prabhuH provAcha, prabhuH samuchitakAle nijaparivArArthaM bhojyapariveShaNAya yaM tatpade niyokShyati tAdR^isho vishvAsyo boddhA karmmAdhIshaH kosti?</para>
  <para style="p">
    <verse number="43" style="v"/>prabhurAgatya yam etAdR^ishe karmmaNi pravR^ittaM drakShyati saeva dAso dhanyaH|</para>
  <para style="p">
    <verse number="44" style="v"/>ahaM yuShmAn yathArthaM vadAmi sa taM nijasarvvasvasyAdhipatiM kariShyati|</para>
  <para style="p">
    <verse number="45" style="v"/>kintu prabhurvilambenAgamiShyati, iti vichintya sa dAso yadi tadanyadAsIdAsAn praharttum bhoktuM pAtuM maditu ncha prArabhate,</para>
  <para style="p">
    <verse number="46" style="v"/>tarhi yadA prabhuM nApekShiShyate yasmin kShaNe so.achetanashcha sthAsyati tasminneva kShaNe tasya prabhurAgatya taM padabhraShTaM kR^itvA vishvAsahInaiH saha tasya aMshaM nirUpayiShyati|</para>
  <para style="p">
    <verse number="47" style="v"/>yo dAsaH prabheाrAj nAM j nAtvApi sajjito na tiShThati tadAj nAnusAreNa cha kAryyaM na karoti sonekAn prahArAn prApsyati;</para>
  <para style="p">
    <verse number="48" style="v"/>kintu yo jano.aj nAtvA prahArArhaM karmma karoti solpaprahArAn prApsyati| yato yasmai bAhulyena dattaM tasmAdeva bAhulyena grahIShyate, mAnuShA yasya nikaTe bahu samarpayanti tasmAd bahu yAchante|</para>
  <para style="p">
    <verse number="49" style="v"/>ahaM pR^ithivyAm anaikyarUpaM vahni nikSheptum Agatosmi, sa ched idAnImeva prajvalati tatra mama kA chintA?</para>
  <para style="p">
    <verse number="50" style="v"/>kintu yena majjanenAhaM magno bhaviShyAmi yAvatkAlaM tasya siddhi rna bhaviShyati tAvadahaM katikaShTaM prApsyAmi|</para>
  <para style="p">
    <verse number="51" style="v"/>melanaM karttuM jagad Agatosmi yUyaM kimitthaM bodhadhve? yuShmAn vadAmi na tathA, kintvahaM melanAbhAvaM karttuMm Agatosmi|</para>
  <para style="p">
    <verse number="52" style="v"/>yasmAdetatkAlamArabhya ekatrasthaparijanAnAM madhye pa nchajanAH pR^ithag bhUtvA trayo janA dvayorjanayoH pratikUlA dvau janau cha trayANAM janAnAM pratikUlau bhaviShyanti|</para>
  <para style="p">
    <verse number="53" style="v"/>pitA putrasya vipakShaH putrashcha pitu rvipakSho bhaviShyati mAtA kanyAyA vipakShA kanyA cha mAtu rvipakShA bhaviShyati, tathA shvashrUrbadhvA vipakShA badhUshcha shvashrvA vipakShA bhaviShyati|</para>
  <para style="p">
    <verse number="54" style="v"/>sa lokebhyoparamapi kathayAmAsa, pashchimadishi meghodgamaM dR^iShTvA yUyaM haThAd vadatha vR^iShTi rbhaviShyati tatastathaiva jAyate|</para>
  <para style="p">
    <verse number="55" style="v"/>aparaM dakShiNato vAyau vAti sati vadatha nidAgho bhaviShyati tataH sopi jAyate|</para>
  <para style="p">
    <verse number="56" style="v"/>re re kapaTina AkAshasya bhUmyAshcha lakShaNaM boddhuM shaknutha,</para>
  <para style="p">
    <verse number="57" style="v"/>kintu kAlasyAsya lakShaNaM kuto boddhuM na shaknutha? yUya ncha svayaM kuto na nyAShyaM vichArayatha?</para>
  <para style="p">
    <verse number="58" style="v"/>apara ncha vivAdinA sArddhaM vichArayituH samIpaM gachChan pathi tasmAduddhAraM prAptuM yatasva nochet sa tvAM dhR^itvA vichArayituH samIpaM nayati| vichArayitA yadi tvAM praharttuH samIpaM samarpayati praharttA tvAM kArAyAM badhnAti</para>
  <para style="p">
    <verse number="59" style="v"/>tarhi tvAmahaM vadAmi tvayA niHsheShaM kapardakeShu na parishodhiteShu tvaM tato muktiM prAptuM na shakShyasi|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>apara ncha pIlAto yeShAM gAlIlIyAnAM raktAni balInAM raktaiH sahAmishrayat teShAM gAlIlIyAnAM vR^ittAntaM katipayajanA upasthApya yIshave kathayAmAsuH|</para>
  <para style="p">
    <verse number="2" style="v"/>tataH sa pratyuvAcha teShAM lokAnAm etAdR^ishI durgati rghaTitA tatkAraNAd yUyaM kimanyebhyo gAlIlIyebhyopyadhikapApinastAn bodhadhve?</para>
  <para style="p">
    <verse number="3" style="v"/>yuShmAnahaM vadAmi tathA na kintu manaHsu na parAvarttiteShu yUyamapi tathA naMkShyatha|</para>
  <para style="p">
    <verse number="4" style="v"/>apara ncha shIlohanAmna uchchagR^ihasya patanAd ye.aShTAdashajanA mR^itAste yirUshAlami nivAsisarvvalokebhyo.adhikAparAdhinaH kiM yUyamityaM bodhadhve?</para>
  <para style="p">
    <verse number="5" style="v"/>yuShmAnahaM vadAmi tathA na kintu manaHsu na parivarttiteShu yUyamapi tathA naMkShyatha|</para>
  <para style="p">
    <verse number="6" style="v"/>anantaraM sa imAM dR^iShTAntakathAmakathayad eko jano drAkShAkShetramadhya ekamuDumbaravR^ikShaM ropitavAn| pashchAt sa Agatya tasmin phalAni gaveShayAmAsa,</para>
  <para style="p">
    <verse number="7" style="v"/>kintu phalAprApteH kAraNAd udyAnakAraM bhR^ityaM jagAda, pashya vatsaratrayaM yAvadAgatya etasminnuDumbaratarau kShalAnyanvichChAmi, kintu naikamapi prapnomi tarurayaM kuto vR^ithA sthAnaM vyApya tiShThati? enaM Chindhi|</para>
  <para style="p">
    <verse number="8" style="v"/>tato bhR^ityaH pratyuvAcha, he prabho punarvarShamekaM sthAtum Adisha; etasya mUlasya chaturdikShu khanitvAham AlavAlaM sthApayAmi|</para>
  <para style="p">
    <verse number="9" style="v"/>tataH phalituM shaknoti yadi na phalati tarhi pashchAt Chetsyasi|</para>
  <para style="p">
    <verse number="10" style="v"/>atha vishrAmavAre bhajanagehe yIshurupadishati</para>
  <para style="p">
    <verse number="11" style="v"/>tasmit samaye bhUtagrastatvAt kubjIbhUyAShTAdashavarShANi yAvat kenApyupAyena R^iju rbhavituM na shaknoti yA durbbalA strI,</para>
  <para style="p">
    <verse number="12" style="v"/>tAM tatropasthitAM vilokya yIshustAmAhUya kathitavAn he nAri tava daurbbalyAt tvaM muktA bhava|</para>
  <para style="p">
    <verse number="13" style="v"/>tataH paraM tasyA gAtre hastArpaNamAtrAt sA R^ijurbhUtveshvarasya dhanyavAdaM karttumArebhe|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu vishrAmavAre yIshunA tasyAH svAsthyakaraNAd bhajanagehasyAdhipatiH prakupya lokAn uvAcha, ShaTsu dineShu lokaiH karmma karttavyaM tasmAddhetoH svAsthyArthaM teShu dineShu AgachChata, vishrAmavAre mAgachChata|</para>
  <para style="p">
    <verse number="15" style="v"/>tadA pabhuH pratyuvAcha re kapaTino yuShmAkam ekaiko jano vishrAmavAre svIyaM svIyaM vR^iShabhaM gardabhaM vA bandhanAnmochayitvA jalaM pAyayituM kiM na nayati?</para>
  <para style="p">
    <verse number="16" style="v"/>tarhyAShTAdashavatsarAn yAvat shaitAnA baddhA ibrAhImaH santatiriyaM nArI kiM vishrAmavAre na mochayitavyA?</para>
  <para style="p">
    <verse number="17" style="v"/>eShu vAkyeShu kathiteShu tasya vipakShAH salajjA jAtAH kintu tena kR^itasarvvamahAkarmmakAraNAt lokanivahaH sAnando.abhavat|</para>
  <para style="p">
    <verse number="18" style="v"/>anantaraM sovadad Ishvarasya rAjyaM kasya sadR^ishaM? kena tadupamAsyAmi?</para>
  <para style="p">
    <verse number="19" style="v"/>yat sarShapabIjaM gR^ihItvA kashchijjana udyAna uptavAn tad bIjama NkuritaM sat mahAvR^ikSho.ajAyata, tatastasya shAkhAsu vihAyasIyavihagA Agatya nyUShuH, tadrAjyaM tAdR^ishena sarShapabIjena tulyaM|</para>
  <para style="p">
    <verse number="20" style="v"/>punaH kathayAmAsa, Ishvarasya rAjyaM kasya sadR^ishaM vadiShyAmi? yat kiNvaM kAchit strI gR^ihItvA droNatrayaparimitagodhUmachUrNeShu sthApayAmAsa,</para>
  <para style="p">
    <verse number="21" style="v"/>tataH krameNa tat sarvvagodhUmachUrNaM vyApnoti, tasya kiNvasya tulyam Ishvarasya rAjyaM|</para>
  <para style="p">
    <verse number="22" style="v"/>tataH sa yirUshAlamnagaraM prati yAtrAM kR^itvA nagare nagare grAme grAme samupadishan jagAma|</para>
  <para style="p">
    <verse number="23" style="v"/>tadA kashchijjanastaM paprachCha, he prabho kiM kevalam alpe lokAH paritrAsyante?</para>
  <para style="p">
    <verse number="24" style="v"/>tataH sa lokAn uvAcha, saMkIrNadvAreNa praveShTuM yataghvaM, yatohaM yuShmAn vadAmi, bahavaH praveShTuM cheShTiShyante kintu na shakShyanti|</para>
  <para style="p">
    <verse number="25" style="v"/>gR^ihapatinotthAya dvAre ruddhe sati yadi yUyaM bahiH sthitvA dvAramAhatya vadatha, he prabho he prabho asmatkAraNAd dvAraM mochayatu, tataH sa iti prativakShyati, yUyaM kutratyA lokA ityahaM na jAnAmi|</para>
  <para style="p">
    <verse number="26" style="v"/>tadA yUyaM vadiShyatha, tava sAkShAd vayaM bheाjanaM pAna ncha kR^itavantaH, tva nchAsmAkaM nagarasya pathi samupadiShTavAn|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu sa vakShyati, yuShmAnahaM vadAmi, yUyaM kutratyA lokA ityahaM na jAnAmi; he durAchAriNo yUyaM matto dUrIbhavata|</para>
  <para style="p">
    <verse number="28" style="v"/>tadA ibrAhImaM ishAkaM yAkUba ncha sarvvabhaviShyadvAdinashcha Ishvarasya rAjyaM prAptAn svAMshcha bahiShkR^itAn dR^iShTvA yUyaM rodanaM dantairdantagharShaNa ncha kariShyatha|</para>
  <para style="p">
    <verse number="29" style="v"/>apara ncha pUrvvapashchimadakShiNottaradigbhyo lokA Agatya Ishvarasya rAjye nivatsyanti|</para>
  <para style="p">
    <verse number="30" style="v"/>pashyatetthaM sheShIyA lokA agrA bhaviShyanti, agrIyA lokAshcha sheShA bhaviShyanti|</para>
  <para style="p">
    <verse number="31" style="v"/>apara ncha tasmin dine kiyantaH phirUshina Agatya yIshuM prochuH, bahirgachCha, sthAnAdasmAt prasthAnaM kuru, herod tvAM jighAMsati|</para>
  <para style="p">
    <verse number="32" style="v"/>tataH sa pratyavochat pashyatAdya shvashcha bhUtAn vihApya rogiNo.arogiNaH kR^itvA tR^itIyehni setsyAmi, kathAmetAM yUyamitvA taM bhUrimAyaM vadata|</para>
  <para style="p">
    <verse number="33" style="v"/>tatrApyadya shvaH parashvashcha mayA gamanAgamane karttavye, yato heto ryirUshAlamo bahiH kutrApi kopi bhaviShyadvAdI na ghAniShyate|</para>
  <para style="p">
    <verse number="34" style="v"/>he yirUshAlam he yirUshAlam tvaM bhaviShyadvAdino haMsi tavAntike preritAn prastarairmArayasi cha, yathA kukkuTI nijapakShAdhaH svashAvakAn saMgR^ihlAti, tathAhamapi tava shishUn saMgrahItuM kativArAn aichChaM kintu tvaM naichChaH|</para>
  <para style="p">
    <verse number="35" style="v"/>pashyata yuShmAkaM vAsasthAnAni prochChidyamAnAni parityaktAni cha bhaviShyanti; yuShmAnahaM yathArthaM vadAmi, yaH prabho rnAmnAgachChati sa dhanya iti vAchaM yAvatkAlaM na vadiShyatha, tAvatkAlaM yUyaM mAM na drakShyatha|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM vishrAmavAre yIshau pradhAnasya phirUshino gR^ihe bhoktuM gatavati te taM vIkShitum Arebhire|</para>
  <para style="p">
    <verse number="2" style="v"/>tadA jalodarI tasya sammukhe sthitaH|</para>
  <para style="p">
    <verse number="3" style="v"/>tataH sa vyavasthApakAn phirUshinashcha paprachCha, vishrAmavAre svAsthyaM karttavyaM na vA? tataste kimapi na pratyUchuH|</para>
  <para style="p">
    <verse number="4" style="v"/>tadA sa taM rogiNaM svasthaM kR^itvA visasarja;</para>
  <para style="p">
    <verse number="5" style="v"/>tAnuvAcha cha yuShmAkaM kasyachid garddabho vR^iShabho vA ched gartte patati tarhi vishrAmavAre tatkShaNaM sa kiM taM notthApayiShyati?</para>
  <para style="p">
    <verse number="6" style="v"/>tataste kathAyA etasyAH kimapi prativaktuM na shekuH|</para>
  <para style="p">
    <verse number="7" style="v"/>apara ncha pradhAnasthAnamanonItatvakaraNaM vilokya sa nimantritAn etadupadeshakathAM jagAda,</para>
  <para style="p">
    <verse number="8" style="v"/>tvaM vivAhAdibhojyeShu nimantritaH san pradhAnasthAne mopAvekShIH| tvatto gauravAnvitanimantritajana AyAte</para>
  <para style="p">
    <verse number="9" style="v"/>nimantrayitAgatya manuShyAyaitasmai sthAnaM dehIti vAkyaM ched vakShyati tarhi tvaM sa Nkuchito bhUtvA sthAna itarasmin upaveShTum udyaMsyasi|</para>
  <para style="p">
    <verse number="10" style="v"/>asmAt kAraNAdeva tvaM nimantrito gatvA.apradhAnasthAna upavisha, tato nimantrayitAgatya vadiShyati, he bandho prochchasthAnaM gatvopavisha, tathA sati bhojanopaviShTAnAM sakalAnAM sAkShAt tvaM mAnyo bhaviShyasi|</para>
  <para style="p">
    <verse number="11" style="v"/>yaH kashchit svamunnamayati sa namayiShyate, kintu yaH kashchit svaM namayati sa unnamayiShyate|</para>
  <para style="p">
    <verse number="12" style="v"/>tadA sa nimantrayitAraM janamapi jagAda, madhyAhne rAtrau vA bhojye kR^ite nijabandhugaNo vA bhrAtR^iृgaNo vA j nAtigaNo vA dhanigaNo vA samIpavAsigaNo vA etAn na nimantraya, tathA kR^ite chet te tvAM nimantrayiShyanti, tarhi parishodho bhaviShyati|</para>
  <para style="p">
    <verse number="13" style="v"/>kintu yadA bhejyaM karoShi tadA daridrashuShkakarakha njAndhAn nimantraya,</para>
  <para style="p">
    <verse number="14" style="v"/>tata AshiShaM lapsyase, teShu parishodhaM karttumashaknuvatsu shmashAnAddhArmmikAnAmutthAnakAle tvaM phalAM lapsyase|</para>
  <para style="p">
    <verse number="15" style="v"/>anantaraM tAM kathAM nishamya bhojanopaviShTaH kashchit kathayAmAsa, yo jana Ishvarasya rAjye bhoktuM lapsyate saeva dhanyaH|</para>
  <para style="p">
    <verse number="16" style="v"/>tataH sa uvAcha, kashchit jano rAtrau bheाjyaM kR^itvA bahUn nimantrayAmAsa|</para>
  <para style="p">
    <verse number="17" style="v"/>tato bhojanasamaye nimantritalokAn AhvAtuM dAsadvArA kathayAmAsa, khadyadravyANi sarvvANi samAsAditAni santi, yUyamAgachChata|</para>
  <para style="p">
    <verse number="18" style="v"/>kintu te sarvva ekaikaM ChalaM kR^itvA kShamAM prArthayA nchakrire| prathamo janaH kathayAmAsa, kShetramekaM krItavAnahaM tadeva draShTuM mayA gantavyam, ataeva mAM kShantuM taM nivedaya|</para>
  <para style="p">
    <verse number="19" style="v"/>anyo janaH kathayAmAsa, dashavR^iShAnahaM krItavAn tAn parIkShituM yAmi tasmAdeva mAM kShantuM taM nivedaya|</para>
  <para style="p">
    <verse number="20" style="v"/>aparaH kathayAmAsa, vyUDhavAnahaM tasmAt kAraNAd yAtuM na shaknomi|</para>
  <para style="p">
    <verse number="21" style="v"/>pashchAt sa dAso gatvA nijaprabhoH sAkShAt sarvvavR^ittAntaM nivedayAmAsa, tatosau gR^ihapatiH kupitvA svadAsaM vyAjahAra, tvaM satvaraM nagarasya sanniveshAn mArgAMshcha gatvA daridrashuShkakarakha njAndhAn atrAnaya|</para>
  <para style="p">
    <verse number="22" style="v"/>tato dAso.avadat, he prabho bhavata Aj nAnusAreNAkriyata tathApi sthAnamasti|</para>
  <para style="p">
    <verse number="23" style="v"/>tadA prabhuH puna rdAsAyAkathayat, rAjapathAn vR^ikShamUlAni cha yAtvA madIyagR^ihapUraNArthaM lokAnAgantuM pravarttaya|</para>
  <para style="p">
    <verse number="24" style="v"/>ahaM yuShmabhyaM kathayAmi, pUrvvanimantritAnamekopi mamAsya rAtribhojyasyAsvAdaM na prApsyati|</para>
  <para style="p">
    <verse number="25" style="v"/>anantaraM bahuShu lokeShu yIshoH pashchAd vrajiteShu satsu sa vyAghuTya tebhyaH kathayAmAsa,</para>
  <para style="p">
    <verse number="26" style="v"/>yaH kashchin mama samIpam Agatya svasya mAtA pitA patnI santAnA bhrAtaro bhagimyo nijaprANAshcha, etebhyaH sarvvebhyo mayyadhikaM prema na karoti, sa mama shiShyo bhavituM na shakShyati|</para>
  <para style="p">
    <verse number="27" style="v"/>yaH kashchit svIyaM krushaM vahan mama pashchAnna gachChati, sopi mama shiShyo bhavituM na shakShyati|</para>
  <para style="p">
    <verse number="28" style="v"/>durganirmmANe kativyayo bhaviShyati, tathA tasya samAptikaraNArthaM sampattirasti na vA, prathamamupavishya etanna gaNayati, yuShmAkaM madhya etAdR^ishaH kosti?</para>
  <para style="p">
    <verse number="29" style="v"/>noched bhittiM kR^itvA sheShe yadi samApayituM na shakShyati,</para>
  <para style="p">
    <verse number="30" style="v"/>tarhi mAnuShoyaM nichetum Arabhata samApayituM nAshaknot, iti vyAhR^itya sarvve tamupahasiShyanti|</para>
  <para style="p">
    <verse number="31" style="v"/>apara ncha bhinnabhUpatinA saha yuddhaM karttum udyamya dashasahasrANi sainyAni gR^ihItvA viMshatisahasreH sainyaiH sahitasya samIpavAsinaH sammukhaM yAtuM shakShyAmi na veti prathamaM upavishya na vichArayati etAdR^isho bhUmipatiH kaH?</para>
  <para style="p">
    <verse number="32" style="v"/>yadi na shaknoti tarhi ripAvatidUre tiShThati sati nijadUtaM preShya sandhiM karttuM prArthayeta|</para>
  <para style="p">
    <verse number="33" style="v"/>tadvad yuShmAkaM madhye yaH kashchin madarthaM sarvvasvaM hAtuM na shaknoti sa mama shiShyo bhavituM na shakShyati|</para>
  <para style="p">
    <verse number="34" style="v"/>lavaNam uttamam iti satyaM, kintu yadi lavaNasya lavaNatvam apagachChati tarhi tat kathaM svAduyuktaM bhaviShyati?</para>
  <para style="p">
    <verse number="35" style="v"/>tada bhUmyartham AlavAlarAshyarthamapi bhadraM na bhavati; lokAstad bahiH kShipanti|yasya shrotuM shrotre staH sa shR^iNotu|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadA karasa nchAyinaH pApinashcha lokA upadeshkathAM shrotuM yIshoH samIpam AgachChan|</para>
  <para style="p">
    <verse number="2" style="v"/>tataH phirUshina upAdhyAyAshcha vivadamAnAH kathayAmAsuH eSha mAnuShaH pApibhiH saha praNayaM kR^itvA taiH sArddhaM bhuMkte|</para>
  <para style="p">
    <verse number="3" style="v"/>tadA sa tebhya imAM dR^iShTAntakathAM kathitavAn,</para>
  <para style="p">
    <verse number="4" style="v"/>kasyachit shatameSheShu tiShThatmu teShAmekaM sa yadi hArayati tarhi madhyeprAntaram ekonashatameShAn vihAya hAritameShasya uddeshaprAptiparyyanataM na gaveShayati, etAdR^isho loko yuShmAkaM madhye ka Aste?</para>
  <para style="p">
    <verse number="5" style="v"/>tasyoddeshaM prApya hR^iShTamanAstaM skandhe nidhAya svasthAnam AnIya bandhubAndhavasamIpavAsina AhUya vakti,</para>
  <para style="p">
    <verse number="6" style="v"/>hAritaM meShaM prAptoham ato heto rmayA sArddham Anandata|</para>
  <para style="p">
    <verse number="7" style="v"/>tadvadahaM yuShmAn vadAmi, yeShAM manaHparAvarttanasya prayojanaM nAsti, tAdR^ishaikonashatadhArmmikakAraNAd ya AnandastasmAd ekasya manaHparivarttinaH pApinaH kAraNAt svarge .adhikAnando jAyate|</para>
  <para style="p">
    <verse number="8" style="v"/>apara ncha dashAnAM rUpyakhaNDAnAm ekakhaNDe hArite pradIpaM prajvAlya gR^ihaM sammArjya tasya prAptiM yAvad yatnena na gaveShayati, etAdR^ishI yoShit kAste?</para>
  <para style="p">
    <verse number="9" style="v"/>prApte sati bandhubAndhavasamIpavAsinIrAhUya kathayati, hAritaM rUpyakhaNDaM prAptAhaM tasmAdeva mayA sArddham Anandata|</para>
  <para style="p">
    <verse number="10" style="v"/>tadvadahaM yuShmAn vyAharAmi, ekena pApinA manasi parivarttite, Ishvarasya dUtAnAM madhyepyAnando jAyate|</para>
  <para style="p">
    <verse number="11" style="v"/>apara ncha sa kathayAmAsa, kasyachid dvau putrAvAstAM,</para>
  <para style="p">
    <verse number="12" style="v"/>tayoH kaniShThaH putraH pitre kathayAmAsa, he pitastava sampattyA yamaMshaM prApsyAmyahaM vibhajya taM dehi, tataH pitA nijAM sampattiM vibhajya tAbhyAM dadau|</para>
  <para style="p">
    <verse number="13" style="v"/>katipayAt kAlAt paraM sa kaniShThaputraH samastaM dhanaM saMgR^ihya dUradeshaM gatvA duShTAcharaNena sarvvAM sampattiM nAshayAmAsa|</para>
  <para style="p">
    <verse number="14" style="v"/>tasya sarvvadhane vyayaM gate taddeshe mahAdurbhikShaM babhUva, tatastasya dainyadashA bhavitum Arebhe|</para>
  <para style="p">
    <verse number="15" style="v"/>tataH paraM sa gatvA taddeshIyaM gR^ihasthamekam Ashrayata; tataH sataM shUkaravrajaM chArayituM prAntaraM preShayAmAsa|</para>
  <para style="p">
    <verse number="16" style="v"/>kenApi tasmai bhakShyAdAnAt sa shUkaraphalavalkalena pichiNDapUraNAM vavA nCha|</para>
  <para style="p">
    <verse number="17" style="v"/>sheShe sa manasi chetanAM prApya kathayAmAsa, hA mama pituH samIpe kati kati vetanabhujo dAsA yatheShTaM tatodhika ncha bhakShyaM prApnuvanti kintvahaM kShudhA mumUrShuH|</para>
  <para style="p">
    <verse number="18" style="v"/>ahamutthAya pituH samIpaM gatvA kathAmetAM vadiShyAmi, he pitar Ishvarasya tava cha viruddhaM pApamakaravam</para>
  <para style="p">
    <verse number="19" style="v"/>tava putra_iti vikhyAto bhavituM na yogyosmi cha, mAM tava vaitanikaM dAsaM kR^itvA sthApaya|</para>
  <para style="p">
    <verse number="20" style="v"/>pashchAt sa utthAya pituH samIpaM jagAma; tatastasya pitAtidUre taM nirIkShya dayA nchakre, dhAvitvA tasya kaNThaM gR^ihItvA taM chuchumba cha|</para>
  <para style="p">
    <verse number="21" style="v"/>tadA putra uvAcha, he pitar Ishvarasya tava cha viruddhaM pApamakaravaM, tava putra_iti vikhyAto bhavituM na yogyosmi cha|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu tasya pitA nijadAsAn Adidesha, sarvvottamavastrANyAnIya paridhApayatainaM haste chA NgurIyakam arpayata pAdayoshchopAnahau samarpayata;</para>
  <para style="p">
    <verse number="23" style="v"/>puShTaM govatsam AnIya mArayata cha taM bhuktvA vayam AnandAma|</para>
  <para style="p">
    <verse number="24" style="v"/>yato mama putroyam amriyata punarajIvId hAritashcha labdhobhUt tatasta Ananditum Arebhire|</para>
  <para style="p">
    <verse number="25" style="v"/>tatkAle tasya jyeShThaH putraH kShetra AsIt| atha sa niveshanasya nikaTaM AgachChan nR^ityAnAM vAdyAnA ncha shabdaM shrutvA</para>
  <para style="p">
    <verse number="26" style="v"/>dAsAnAm ekam AhUya paprachCha, kiM kAraNamasya?</para>
  <para style="p">
    <verse number="27" style="v"/>tataH sovAdIt, tava bhrAtAgamat, tava tAtashcha taM susharIraM prApya puShTaM govatsaM mAritavAn|</para>
  <para style="p">
    <verse number="28" style="v"/>tataH sa prakupya niveshanAntaH praveShTuM na sammene; tatastasya pitA bahirAgatya taM sAdhayAmAsa|</para>
  <para style="p">
    <verse number="29" style="v"/>tataH sa pitaraM pratyuvAcha, pashya tava kA nchidapyAj nAM na vilaMghya bahUn vatsarAn ahaM tvAM seve tathApi mitraiH sArddham utsavaM karttuM kadApi ChAgamekamapi mahyaM nAdadAH;</para>
  <para style="p">
    <verse number="30" style="v"/>kintu tava yaH putro veshyAgamanAdibhistava sampattim apavyayitavAn tasminnAgatamAtre tasyaiva nimittaM puShTaM govatsaM mAritavAn|</para>
  <para style="p">
    <verse number="31" style="v"/>tadA tasya pitAvochat, he putra tvaM sarvvadA mayA sahAsi tasmAn mama yadyadAste tatsarvvaM tava|</para>
  <para style="p">
    <verse number="32" style="v"/>kintu tavAyaM bhrAtA mR^itaH punarajIvId hAritashcha bhUtvA prAptobhUt, etasmAt kAraNAd utsavAnandau karttum uchitamasmAkam|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>apara ncha yIshuH shiShyebhyonyAmekAM kathAM kathayAmAsa kasyachid dhanavato manuShyasya gR^ihakAryyAdhIshe sampatterapavyaye.apavAdite sati</para>
  <para style="p">
    <verse number="2" style="v"/>tasya prabhustam AhUya jagAda, tvayi yAmimAM kathAM shR^iNomi sA kIdR^ishI? tvaM gR^ihakAryyAdhIshakarmmaNo gaNanAM darshaya gR^ihakAryyAdhIshapade tvaM na sthAsyasi|</para>
  <para style="p">
    <verse number="3" style="v"/>tadA sa gR^ihakAryyAdhIsho manasA chintayAmAsa, prabhu ryadi mAM gR^ihakAryyAdhIshapadAd bhraMshayati tarhi kiM kariShye.ahaM? mR^idaM khanituM mama shakti rnAsti bhikShitu ncha lajjiShye.ahaM|</para>
  <para style="p">
    <verse number="4" style="v"/>ataeva mayi gR^ihakAryyAdhIshapadAt chyute sati yathA lokA mahyam AshrayaM dAsyanti tadarthaM yatkarmma mayA karaNIyaM tan nirNIyate|</para>
  <para style="p">
    <verse number="5" style="v"/>pashchAt sa svaprabhorekaikam adhamarNam AhUya prathamaM paprachCha, tvatto me prabhuNA kati prApyam?</para>
  <para style="p">
    <verse number="6" style="v"/>tataH sa uvAcha, ekashatADhakatailAni; tadA gR^ihakAryyAdhIshaH provAcha, tava patramAnIya shIghramupavishya tatra pa nchAshataM likha|</para>
  <para style="p">
    <verse number="7" style="v"/>pashchAdanyamekaM paprachCha, tvatto me prabhuNA kati prApyam? tataH sovAdId ekashatADhakagodhUmAH; tadA sa kathayAmAsa, tava patramAnIya ashItiM likha|</para>
  <para style="p">
    <verse number="8" style="v"/>tenaiva prabhustamayathArthakR^itam adhIshaM tadbuddhinaipuNyAt prashashaMsa; itthaM dIptirUpasantAnebhya etatsaMsArasya santAnA varttamAnakAle.adhikabuddhimanto bhavanti|</para>
  <para style="p">
    <verse number="9" style="v"/>ato vadAmi yUyamapyayathArthena dhanena mitrANi labhadhvaM tato yuShmAsu padabhraShTeShvapi tAni chirakAlam AshrayaM dAsyanti|</para>
  <para style="p">
    <verse number="10" style="v"/>yaH kashchit kShudre kAryye vishvAsyo bhavati sa mahati kAryyepi vishvAsyo bhavati, kintu yaH kashchit kShudre kAryye.avishvAsyo bhavati sa mahati kAryyepyavishvAsyo bhavati|</para>
  <para style="p">
    <verse number="11" style="v"/>ataeva ayathArthena dhanena yadi yUyamavishvAsyA jAtAstarhi satyaM dhanaM yuShmAkaM kareShu kaH samarpayiShyati?</para>
  <para style="p">
    <verse number="12" style="v"/>yadi cha paradhanena yUyam avishvAsyA bhavatha tarhi yuShmAkaM svakIyadhanaM yuShmabhyaM ko dAsyati?</para>
  <para style="p">
    <verse number="13" style="v"/>kopi dAsa ubhau prabhU sevituM na shaknoti, yata ekasmin prIyamANo.anyasminnaprIyate yadvA ekaM janaM samAdR^itya tadanyaM tuchChIkaroti tadvad yUyamapi dhaneshvarau sevituM na shaknutha|</para>
  <para style="p">
    <verse number="14" style="v"/>tadaitAH sarvvAH kathAH shrutvA lobhiphirUshinastamupajahasuH|</para>
  <para style="p">
    <verse number="15" style="v"/>tataH sa uvAcha, yUyaM manuShyANAM nikaTe svAn nirdoShAn darshayatha kintu yuShmAkam antaHkaraNAnIshvaro jAnAti, yat manuShyANAm ati prashaMsyaM tad Ishvarasya ghR^iNyaM|</para>
  <para style="p">
    <verse number="16" style="v"/>yohana AgamanaparyyanataM yuShmAkaM samIpe vyavasthAbhaviShyadvAdinAM lekhanAni chAsan tataH prabhR^iti IshvararAjyasya susaMvAdaH pracharati, ekaiko lokastanmadhyaM yatnena pravishati cha|</para>
  <para style="p">
    <verse number="17" style="v"/>varaM nabhasaH pR^ithivyAshcha lopo bhaviShyati tathApi vyavasthAyA ekabindorapi lopo na bhaviShyati|</para>
  <para style="p">
    <verse number="18" style="v"/>yaH kashchit svIyAM bhAryyAM vihAya striyamanyAM vivahati sa paradArAn gachChati, yashcha tA tyaktAM nArIM vivahati sopi paradArAna gachChati|</para>
  <para style="p">
    <verse number="19" style="v"/>eko dhanI manuShyaH shuklAni sUkShmANi vastrANi paryyadadhAt pratidinaM paritoSharUpeNAbhuMktApivachcha|</para>
  <para style="p">
    <verse number="20" style="v"/>sarvvA Nge kShatayukta iliyAsaranAmA kashchid daridrastasya dhanavato bhojanapAtrAt patitam uchChiShTaM bhoktuM vA nChan tasya dvAre patitvAtiShThat;</para>
  <para style="p">
    <verse number="21" style="v"/>atha shvAna Agatya tasya kShatAnyalihan|</para>
  <para style="p">
    <verse number="22" style="v"/>kiyatkAlAtparaM sa daridraH prANAn jahau; tataH svargIyadUtAstaM nItvA ibrAhImaH kroDa upaveshayAmAsuH|</para>
  <para style="p">
    <verse number="23" style="v"/>pashchAt sa dhanavAnapi mamAra, taM shmashAne sthApayAmAsushcha; kintu paraloke sa vedanAkulaH san UrddhvAM nirIkShya bahudUrAd ibrAhImaM tatkroDa iliyAsara ncha vilokya ruvannuvAcha;</para>
  <para style="p">
    <verse number="24" style="v"/>he pitar ibrAhIm anugR^ihya a NgulyagrabhAgaM jale majjayitvA mama jihvAM shItalAM karttum iliyAsaraM preraya, yato vahnishikhAtohaM vyathitosmi|</para>
  <para style="p">
    <verse number="25" style="v"/>tadA ibrAhIm babhAShe, he putra tvaM jIvan sampadaM prAptavAn iliyAsarastu vipadaM prAptavAn etat smara, kintu samprati tasya sukhaM tava cha duHkhaM bhavati|</para>
  <para style="p">
    <verse number="26" style="v"/>aparamapi yuShmAkam asmAka ncha sthAnayo rmadhye mahadvichChedo.asti tata etatsthAnasya lokAstat sthAnaM yAtuM yadvA tatsthAnasya lokA etat sthAnamAyAtuM na shaknuvanti|</para>
  <para style="p">
    <verse number="27" style="v"/>tadA sa uktavAn, he pitastarhi tvAM nivedayAmi mama pitu rgehe ye mama pa ncha bhrAtaraH santi</para>
  <para style="p">
    <verse number="28" style="v"/>te yathaitad yAtanAsthAnaM nAyAsyanti tathA mantraNAM dAtuM teShAM samIpam iliyAsaraM preraya|</para>
  <para style="p">
    <verse number="29" style="v"/>tata ibrAhIm uvAcha, mUsAbhaviShyadvAdinA ncha pustakAni teShAM nikaTe santi te tadvachanAni manyantAM|</para>
  <para style="p">
    <verse number="30" style="v"/>tadA sa nivedayAmAsa, he pitar ibrAhIm na tathA, kintu yadi mR^italokAnAM kashchit teShAM samIpaM yAti tarhi te manAMsi vyAghoTayiShyanti|</para>
  <para style="p">
    <verse number="31" style="v"/>tata ibrAhIm jagAda, te yadi mUsAbhaviShyadvAdinA ncha vachanAni na manyante tarhi mR^italokAnAM kasmiMshchid utthitepi te tasya mantraNAM na maMsyante|</para>
  <chapter number="17" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>itaH paraM yIshuH shiShyAn uvAcha, vighnairavashyam AgantavyaM kintu vighnA yena ghaTiShyante tasya durgati rbhaviShyati|</para>
  <para style="p">
    <verse number="2" style="v"/>eteShAM kShudraprANinAm ekasyApi vighnajananAt kaNThabaddhapeShaNIkasya tasya sAgarAgAdhajale majjanaM bhadraM|</para>
  <para style="p">
    <verse number="3" style="v"/>yUyaM sveShu sAvadhAnAstiShThata; tava bhrAtA yadi tava ki nchid aparAdhyati tarhi taM tarjaya, tena yadi manaH parivarttayati tarhi taM kShamasva|</para>
  <para style="p">
    <verse number="4" style="v"/>punarekadinamadhye yadi sa tava saptakR^itvo.aparAdhyati kintu saptakR^itva Agatya manaH parivartya mayAparAddham iti vadati tarhi taM kShamasva|</para>
  <para style="p">
    <verse number="5" style="v"/>tadA preritAH prabhum avadan asmAkaM vishvAsaM varddhaya|</para>
  <para style="p">
    <verse number="6" style="v"/>prabhuruvAcha, yadi yuShmAkaM sarShapaikapramANo vishvAsosti tarhi tvaM samUlamutpATito bhUtvA samudre ropito bhava kathAyAm etasyAm etaduDumbarAya kathitAyAM sa yuShmAkamAj nAvaho bhaviShyati|</para>
  <para style="p">
    <verse number="7" style="v"/>aparaM svadAse halaM vAhayitvA vA pashUn chArayitvA kShetrAd Agate sati taM vadati, ehi bhoktumupavisha, yuShmAkam etAdR^ishaH kosti?</para>
  <para style="p">
    <verse number="8" style="v"/>vara ncha pUrvvaM mama khAdyamAsAdya yAvad bhu nje pivAmi cha tAvad baddhakaTiH parichara pashchAt tvamapi bhokShyase pAsyasi cha kathAmIdR^ishIM kiM na vakShyati?</para>
  <para style="p">
    <verse number="9" style="v"/>tena dAsena prabhorAj nAnurUpe karmmaNi kR^ite prabhuH kiM tasmin bAdhito jAtaH? netthaM budhyate mayA|</para>
  <para style="p">
    <verse number="10" style="v"/>itthaM nirUpiteShu sarvvakarmmasu kR^iteShu satmu yUyamapIdaM vAkyaM vadatha, vayam anupakAriNo dAsA asmAbhiryadyatkarttavyaM tanmAtrameva kR^itaM|</para>
  <para style="p">
    <verse number="11" style="v"/>sa yirUshAlami yAtrAM kurvvan shomiroNgAlIlpradeshamadhyena gachChati,</para>
  <para style="p">
    <verse number="12" style="v"/>etarhi kutrachid grAme praveshamAtre dashakuShThinastaM sAkShAt kR^itvA</para>
  <para style="p">
    <verse number="13" style="v"/>dUre tiShThanata uchchai rvaktumArebhire, he prabho yIsho dayasvAsmAn|</para>
  <para style="p">
    <verse number="14" style="v"/>tataH sa tAn dR^iShTvA jagAda, yUyaM yAjakAnAM samIpe svAn darshayata, tataste gachChanto rogAt pariShkR^itAH|</para>
  <para style="p">
    <verse number="15" style="v"/>tadA teShAmekaH svaM svasthaM dR^iShTvA prochchairIshvaraM dhanyaM vadan vyAghuTyAyAto yIsho rguNAnanuvadan tachcharaNAdhobhUmau papAta;</para>
  <para style="p">
    <verse number="16" style="v"/>sa chAsIt shomiroNI|</para>
  <para style="p">
    <verse number="17" style="v"/>tadA yIshuravadat, dashajanAH kiM na pariShkR^itAH? tahyanye navajanAH kutra?</para>
  <para style="p">
    <verse number="18" style="v"/>IshvaraM dhanyaM vadantam enaM videshinaM vinA kopyanyo na prApyata|</para>
  <para style="p">
    <verse number="19" style="v"/>tadA sa tamuvAcha, tvamutthAya yAhi vishvAsaste tvAM svasthaM kR^itavAn|</para>
  <para style="p">
    <verse number="20" style="v"/>atha kadeshvarasya rAjatvaM bhaviShyatIti phirUshibhiH pR^iShTe sa pratyuvAcha, Ishvarasya rAjatvam aishvaryyadarshanena na bhaviShyati|</para>
  <para style="p">
    <verse number="21" style="v"/>ata etasmin pashya tasmin vA pashya, iti vAkyaM lokA vaktuM na shakShyanti, Ishvarasya rAjatvaM yuShmAkam antarevAste|</para>
  <para style="p">
    <verse number="22" style="v"/>tataH sa shiShyAn jagAda, yadA yuShmAbhi rmanujasutasya dinamekaM draShTum vA nChiShyate kintu na darshiShyate, IdR^ikkAla AyAti|</para>
  <para style="p">
    <verse number="23" style="v"/>tadAtra pashya vA tatra pashyeti vAkyaM lokA vakShyanti, kintu teShAM pashchAt mA yAta, mAnugachChata cha|</para>
  <para style="p">
    <verse number="24" style="v"/>yatastaDid yathAkAshaikadishyudiya tadanyAmapi dishaM vyApya prakAshate tadvat nijadine manujasUnuH prakAshiShyate|</para>
  <para style="p">
    <verse number="25" style="v"/>kintu tatpUrvvaM tenAnekAni duHkhAni bhoktavyAnyetadvarttamAnalokaishcha so.avaj nAtavyaH|</para>
  <para style="p">
    <verse number="26" style="v"/>nohasya vidyamAnakAle yathAbhavat manuShyasUnoH kAlepi tathA bhaviShyati|</para>
  <para style="p">
    <verse number="27" style="v"/>yAvatkAlaM noho mahApotaM nArohad AplAvivAryyetya sarvvaM nAnAshayachcha tAvatkAlaM yathA lokA abhu njatApivan vyavahan vyavAhayaMshcha;</para>
  <para style="p">
    <verse number="28" style="v"/>itthaM loTo varttamAnakAlepi yathA lokA bhojanapAnakrayavikrayaropaNagR^ihanirmmANakarmmasu prAvarttanta,</para>
  <para style="p">
    <verse number="29" style="v"/>kintu yadA loT sidomo nirjagAma tadA nabhasaH sagandhakAgnivR^iShTi rbhUtvA sarvvaM vyanAshayat</para>
  <para style="p">
    <verse number="30" style="v"/>tadvan mAnavaputraprakAshadinepi bhaviShyati|</para>
  <para style="p">
    <verse number="31" style="v"/>tadA yadi kashchid gR^ihopari tiShThati tarhi sa gR^ihamadhyAt kimapi dravyamAnetum avaruhya naitu; yashcha kShetre tiShThati sopi vyAghuTya nAyAtu|</para>
  <para style="p">
    <verse number="32" style="v"/>loTaH patnIM smarata|</para>
  <para style="p">
    <verse number="33" style="v"/>yaH prANAn rakShituM cheShTiShyate sa prANAn hArayiShyati yastu prANAn hArayiShyati saeva prANAn rakShiShyati|</para>
  <para style="p">
    <verse number="34" style="v"/>yuShmAnahaM vachmi tasyAM rAtrau shayyaikagatayo rlokayoreko dhAriShyate parastyakShyate|</para>
  <para style="p">
    <verse number="35" style="v"/>striyau yugapat peShaNIM vyAvarttayiShyatastayorekA dhAriShyate parAtyakShyate|</para>
  <para style="p">
    <verse number="36" style="v"/>puruShau kShetre sthAsyatastayoreko dhAriShyate parastyakShyate|</para>
  <para style="p">
    <verse number="37" style="v"/>tadA te paprachChuH, he prabho kutretthaM bhaviShyati? tataH sa uvAcha, yatra shavastiShThati tatra gR^idhrA milanti|</para>
  <chapter number="18" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>apara ncha lokairaklAntai rnirantaraM prArthayitavyam ityAshayena yIshunA dR^iShTAnta ekaH kathitaH|</para>
  <para style="p">
    <verse number="2" style="v"/>kutrachinnagare kashchit prADvivAka AsIt sa IshvarAnnAbibhet mAnuShAMshcha nAmanyata|</para>
  <para style="p">
    <verse number="3" style="v"/>atha tatpuravAsinI kAchidvidhavA tatsamIpametya vivAdinA saha mama vivAdaM pariShkurvviti nivedayAmAsa|</para>
  <para style="p">
    <verse number="4" style="v"/>tataH sa prADvivAkaH kiyaddinAni na tada NgIkR^itavAn pashchAchchitte chintayAmAsa, yadyapIshvarAnna bibhemi manuShyAnapi na manye</para>
  <para style="p">
    <verse number="5" style="v"/>tathApyeShA vidhavA mAM klishnAti tasmAdasyA vivAdaM pariShkariShyAmi nochet sA sadAgatya mAM vyagraM kariShyati|</para>
  <para style="p">
    <verse number="6" style="v"/>pashchAt prabhuravadad asAvanyAyaprADvivAko yadAha tatra mano nidhadhvaM|</para>
  <para style="p">
    <verse number="7" style="v"/>Ishvarasya ye .abhiruchitalokA divAnishaM prArthayante sa bahudinAni vilambyApi teShAM vivAdAn kiM na pariShkariShyati?</para>
  <para style="p">
    <verse number="8" style="v"/>yuShmAnahaM vadAmi tvarayA pariShkariShyati, kintu yadA manuShyaputra AgamiShyati tadA pR^ithivyAM kimIdR^ishaM vishvAsaM prApsyati?</para>
  <para style="p">
    <verse number="9" style="v"/>ye svAn dhArmmikAn j nAtvA parAn tuchChIkurvvanti etAdR^igbhyaH, kiyadbhya imaM dR^iShTAntaM kathayAmAsa|</para>
  <para style="p">
    <verse number="10" style="v"/>ekaH phirUshyaparaH karasa nchAyI dvAvimau prArthayituM mandiraM gatau|</para>
  <para style="p">
    <verse number="11" style="v"/>tato.asau phirUshyekapArshve tiShThan he Ishvara ahamanyalokavat loThayitAnyAyI pAradArikashcha na bhavAmi asya karasa nchAyinastulyashcha na, tasmAttvAM dhanyaM vadAmi|</para>
  <para style="p">
    <verse number="12" style="v"/>saptasu dineShu dinadvayamupavasAmi sarvvasampatte rdashamAMshaM dadAmi cha, etatkathAM kathayan prArthayAmAsa|</para>
  <para style="p">
    <verse number="13" style="v"/>kintu sa karasa nchAyi dUre tiShThan svargaM draShTuM nechChan vakShasi karAghAtaM kurvvan he Ishvara pApiShThaM mAM dayasva, itthaM prArthayAmAsa|</para>
  <para style="p">
    <verse number="14" style="v"/>yuShmAnahaM vadAmi, tayordvayo rmadhye kevalaH karasa nchAyI puNyavattvena gaNito nijagR^ihaM jagAma, yato yaH kashchit svamunnamayati sa nAmayiShyate kintu yaH kashchit svaM namayati sa unnamayiShyate|</para>
  <para style="p">
    <verse number="15" style="v"/>atha shishUnAM gAtrasparshArthaM lokAstAn tasya samIpamAninyuH shiShyAstad dR^iShTvAnetR^in tarjayAmAsuH,</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yIshustAnAhUya jagAda, mannikaTam AgantuM shishUn anujAnIdhvaM tAMshcha mA vArayata; yata IshvararAjyAdhikAriNa eShAM sadR^ishAH|</para>
  <para style="p">
    <verse number="17" style="v"/>ahaM yuShmAn yathArthaM vadAmi, yo janaH shishoH sadR^isho bhUtvA IshvararAjyaM na gR^ihlAti sa kenApi prakAreNa tat praveShTuM na shaknoti|</para>
  <para style="p">
    <verse number="18" style="v"/>aparam ekodhipatistaM paprachCha, he paramaguro, anantAyuShaH prAptaye mayA kiM karttavyaM?</para>
  <para style="p">
    <verse number="19" style="v"/>yIshuruvAcha, mAM kutaH paramaM vadasi? IshvaraM vinA kopi paramo na bhavati|</para>
  <para style="p">
    <verse number="20" style="v"/>paradArAn mA gachCha, naraM mA jahi, mA choraya, mithyAsAkShyaM mA dehi, mAtaraM pitara ncha saMmanyasva, etA yA Aj nAH santi tAstvaM jAnAsi|</para>
  <para style="p">
    <verse number="21" style="v"/>tadA sa uvAcha, bAlyakAlAt sarvvA etA AcharAmi|</para>
  <para style="p">
    <verse number="22" style="v"/>iti kathAM shrutvA yIshustamavadat, tathApi tavaikaM karmma nyUnamAste, nijaM sarvvasvaM vikrIya daridrebhyo vitara, tasmAt svarge dhanaM prApsyasi; tata Agatya mamAnugAmI bhava|</para>
  <para style="p">
    <verse number="23" style="v"/>kintvetAM kathAM shrutvA sodhipatiH shushocha, yatastasya bahudhanamAsIt|</para>
  <para style="p">
    <verse number="24" style="v"/>tadA yIshustamatishokAnvitaM dR^iShTvA jagAda, dhanavatAm IshvararAjyapraveshaH kIdR^ig duShkaraH|</para>
  <para style="p">
    <verse number="25" style="v"/>IshvararAjye dhaninaH praveshAt sUcheshChidreNa mahA Ngasya gamanAgamane sukare|</para>
  <para style="p">
    <verse number="26" style="v"/>shrotAraH paprachChustarhi kena paritrANaM prApsyate?</para>
  <para style="p">
    <verse number="27" style="v"/>sa uktavAn, yan mAnuSheNAshakyaM tad IshvareNa shakyaM|</para>
  <para style="p">
    <verse number="28" style="v"/>tadA pitara uvAcha, pashya vayaM sarvvasvaM parityajya tava pashchAdgAmino.abhavAma|</para>
  <para style="p">
    <verse number="29" style="v"/>tataH sa uvAcha, yuShmAnahaM yathArthaM vadAmi, IshvararAjyArthaM gR^ihaM pitarau bhrAtR^igaNaM jAyAM santAnAMshcha tyaktavA</para>
  <para style="p">
    <verse number="30" style="v"/>iha kAle tato.adhikaM parakAle .anantAyushcha na prApsyati loka IdR^ishaH kopi nAsti|</para>
  <para style="p">
    <verse number="31" style="v"/>anantaraM sa dvAdashashiShyAnAhUya babhAShe, pashyata vayaM yirUshAlamnagaraM yAmaH, tasmAt manuShyaputre bhaviShyadvAdibhiruktaM yadasti tadanurUpaM taM prati ghaTiShyate;</para>
  <para style="p">
    <verse number="32" style="v"/>vastutastu so.anyadeshIyAnAM hasteShu samarpayiShyate, te tamupahasiShyanti, anyAyamAchariShyanti tadvapuShi niShThIvaM nikShepsyanti, kashAbhiH prahR^itya taM haniShyanti cha,</para>
  <para style="p">
    <verse number="33" style="v"/>kintu tR^itIyadine sa shmashAnAd utthAsyati|</para>
  <para style="p">
    <verse number="34" style="v"/>etasyAH kathAyA abhiprAyaM ki nchidapi te boddhuM na shekuH teShAM nikaTe.aspaShTatavAt tasyaitAsAM kathAnAm AshayaM te j nAtuM na shekushcha|</para>
  <para style="p">
    <verse number="35" style="v"/>atha tasmin yirIhoH purasyAntikaM prApte kashchidandhaH pathaH pArshva upavishya bhikShAm akarot</para>
  <para style="p">
    <verse number="36" style="v"/>sa lokasamUhasya gamanashabdaM shrutvA tatkAraNaM pR^iShTavAn|</para>
  <para style="p">
    <verse number="37" style="v"/>nAsaratIyayIshuryAtIti lokairukte sa uchchairvaktumArebhe,</para>
  <para style="p">
    <verse number="38" style="v"/>he dAyUdaH santAna yIsho mAM dayasva|</para>
  <para style="p">
    <verse number="39" style="v"/>tatogragAminastaM maunI tiShTheti tarjayAmAsuH kintu sa punAruvan uvAcha, he dAyUdaH santAna mAM dayasva|</para>
  <para style="p">
    <verse number="40" style="v"/>tadA yIshuH sthagito bhUtvA svAntike tamAnetum Adidesha|</para>
  <para style="p">
    <verse number="41" style="v"/>tataH sa tasyAntikam Agamat, tadA sa taM paprachCha, tvaM kimichChasi? tvadarthamahaM kiM kariShyAmi? sa uktavAn, he prabho.ahaM draShTuM labhai|</para>
  <para style="p">
    <verse number="42" style="v"/>tadA yIshuruvAcha, dR^iShTishaktiM gR^ihANa tava pratyayastvAM svasthaM kR^itavAn|</para>
  <para style="p">
    <verse number="43" style="v"/>tatastatkShaNAt tasya chakShuShI prasanne; tasmAt sa IshvaraM dhanyaM vadan tatpashchAd yayau, tadAlokya sarvve lokA IshvaraM prashaMsitum Arebhire|</para>
  <chapter number="19" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yadA yIshu ryirIhopuraM pravishya tanmadhyena gachChaMstadA</para>
  <para style="p">
    <verse number="2" style="v"/>sakkeyanAmA karasa nchAyinAM pradhAno dhanavAneko</para>
  <para style="p">
    <verse number="3" style="v"/>yIshuH kIdR^igiti draShTuM cheShTitavAn kintu kharvvatvAllokasaMghamadhye taddarshanamaprApya</para>
  <para style="p">
    <verse number="4" style="v"/>yena pathA sa yAsyati tatpathe.agre dhAvitvA taM draShTum uDumbaratarumAruroha|</para>
  <para style="p">
    <verse number="5" style="v"/>pashchAd yIshustatsthAnam itvA UrddhvaM vilokya taM dR^iShTvAvAdIt, he sakkeya tvaM shIghramavaroha mayAdya tvadgehe vastavyaM|</para>
  <para style="p">
    <verse number="6" style="v"/>tataH sa shIghramavaruhya sAhlAdaM taM jagrAha|</para>
  <para style="p">
    <verse number="7" style="v"/>tad dR^iShTvA sarvve vivadamAnA vaktumArebhire, sotithitvena duShTalokagR^ihaM gachChati|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu sakkeyo daNDAyamAno vaktumArebhe, he prabho pashya mama yA sampattirasti tadarddhaM daridrebhyo dade, aparam anyAyaM kR^itvA kasmAdapi yadi kadApi ki nchit mayA gR^ihItaM tarhi tachchaturguNaM dadAmi|</para>
  <para style="p">
    <verse number="9" style="v"/>tadA yIshustamuktavAn ayamapi ibrAhImaH santAno.ataH kAraNAd adyAsya gR^ihe trANamupasthitaM|</para>
  <para style="p">
    <verse number="10" style="v"/>yad hAritaM tat mR^igayituM rakShitu ncha manuShyaputra AgatavAn|</para>
  <para style="p">
    <verse number="11" style="v"/>atha sa yirUshAlamaH samIpa upAtiShThad IshvararAjatvasyAnuShThAnaM tadaiva bhaviShyatIti lokairanvabhUyata, tasmAt sa shrotR^ibhyaH punardR^iShTAntakathAm utthApya kathayAmAsa|</para>
  <para style="p">
    <verse number="12" style="v"/>kopi mahAlloko nijArthaM rAjatvapadaM gR^ihItvA punarAgantuM dUradeshaM jagAma|</para>
  <para style="p">
    <verse number="13" style="v"/>yAtrAkAle nijAn dashadAsAn AhUya dashasvarNamudrA dattvA mamAgamanaparyyantaM vANijyaM kurutetyAdidesha|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu tasya prajAstamavaj nAya manuShyamenam asmAkamupari rAjatvaM na kArayivyAma imAM vArttAM tannikaTe prerayAmAsuH|</para>
  <para style="p">
    <verse number="15" style="v"/>atha sa rAjatvapadaM prApyAgatavAn ekaiko jano bANijyena kiM labdhavAn iti j nAtuM yeShu dAseShu mudrA arpayat tAn AhUyAnetum Adidesha|</para>
  <para style="p">
    <verse number="16" style="v"/>tadA prathama Agatya kathitavAn, he prabho tava tayaikayA mudrayA dashamudrA labdhAH|</para>
  <para style="p">
    <verse number="17" style="v"/>tataH sa uvAcha tvamuttamo dAsaH svalpena vishvAsyo jAta itaH kAraNAt tvaM dashanagarANAm adhipo bhava|</para>
  <para style="p">
    <verse number="18" style="v"/>dvitIya Agatya kathitavAn, he prabho tavaikayA mudrayA pa nchamudrA labdhAH|</para>
  <para style="p">
    <verse number="19" style="v"/>tataH sa uvAcha, tvaM pa nchAnAM nagarANAmadhipati rbhava|</para>
  <para style="p">
    <verse number="20" style="v"/>tatonya Agatya kathayAmAsa, he prabho pashya tava yA mudrA ahaM vastre baddhvAsthApayaM seyaM|</para>
  <para style="p">
    <verse number="21" style="v"/>tvaM kR^ipaNo yannAsthApayastadapi gR^ihlAsi, yannAvapastadeva cha Chinatsi tatohaM tvatto bhItaH|</para>
  <para style="p">
    <verse number="22" style="v"/>tadA sa jagAda, re duShTadAsa tava vAkyena tvAM doShiNaM kariShyAmi, yadahaM nAsthApayaM tadeva gR^ihlAmi, yadahaM nAvapa ncha tadeva Chinadmi, etAdR^ishaH kR^ipaNohamiti yadi tvaM jAnAsi,</para>
  <para style="p">
    <verse number="23" style="v"/>tarhi mama mudrA baNijAM nikaTe kuto nAsthApayaH? tayA kR^ite.aham Agatya kusIdena sArddhaM nijamudrA aprApsyam|</para>
  <para style="p">
    <verse number="24" style="v"/>pashchAt sa samIpasthAn janAn Aj nApayat asmAt mudrA AnIya yasya dashamudrAH santi tasmai datta|</para>
  <para style="p">
    <verse number="25" style="v"/>te prochuH prabho.asya dashamudrAH santi|</para>
  <para style="p">
    <verse number="26" style="v"/>yuShmAnahaM vadAmi yasyAshraye vaddhate .adhikaM tasmai dAyiShyate, kintu yasyAshraye na varddhate tasya yadyadasti tadapi tasmAn nAyiShyate|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu mamAdhipatitvasya vashatve sthAtum asammanyamAnA ye mama ripavastAnAnIya mama samakShaM saMharata|</para>
  <para style="p">
    <verse number="28" style="v"/>ityupadeshakathAM kathayitvA sogragaH san yirUshAlamapuraM yayau|</para>
  <para style="p">
    <verse number="29" style="v"/>tato baitphagIbaithanIyAgrAmayoH samIpe jaitunAdrerantikam itvA shiShyadvayam ityuktvA preShayAmAsa,</para>
  <para style="p">
    <verse number="30" style="v"/>yuvAmamuM sammukhasthagrAmaM pravishyaiva yaM kopi mAnuShaH kadApi nArohat taM garddabhashAvakaM baddhaM drakShyathastaM mochayitvAnayataM|</para>
  <para style="p">
    <verse number="31" style="v"/>tatra kuto mochayathaH? iti chet kopi vakShyati tarhi vakShyathaH prabheाratra prayojanam Aste|</para>
  <para style="p">
    <verse number="32" style="v"/>tadA tau praritau gatvA tatkathAाnusAreNa sarvvaM prAptau|</para>
  <para style="p">
    <verse number="33" style="v"/>gardabhashAvakamochanakAle tatvAmina UchuH, gardabhashAvakaM kuto mochayathaH?</para>
  <para style="p">
    <verse number="34" style="v"/>tAvUchatuH prabhoratra prayojanam Aste|</para>
  <para style="p">
    <verse number="35" style="v"/>pashchAt tau taM gardabhashAvakaM yIshorantikamAnIya tatpR^iShThe nijavasanAni pAtayitvA tadupari yIshumArohayAmAsatuH|</para>
  <para style="p">
    <verse number="36" style="v"/>atha yAtrAkAle lokAH pathi svavastrANi pAtayitum Arebhire|</para>
  <para style="p">
    <verse number="37" style="v"/>aparaM jaitunAdrerupatyakAm itvA shiShyasaMghaH pUrvvadR^iShTAni mahAkarmmANi smR^itvA,</para>
  <para style="p">
    <verse number="38" style="v"/>yo rAjA prabho rnAmnAyAti sa dhanyaH svarge kushalaM sarvvochche jayadhvani rbhavatu, kathAmetAM kathayitvA sAnandam uchairIshvaraM dhanyaM vaktumArebhe|</para>
  <para style="p">
    <verse number="39" style="v"/>tadA lokAraNyamadhyasthAH kiyantaH phirUshinastat shrutvA yIshuM prochuH, he upadeshaka svashiShyAn tarjaya|</para>
  <para style="p">
    <verse number="40" style="v"/>sa uvAcha, yuShmAnahaM vadAmi yadyamI nIravAstiShThanti tarhi pAShANA uchaiH kathAH kathayiShyanti|</para>
  <para style="p">
    <verse number="41" style="v"/>pashchAt tatpurAntikametya tadavalokya sAshrupAtaM jagAda,</para>
  <para style="p">
    <verse number="42" style="v"/>hA hA chet tvamagre.aj nAsyathAH, tavAsminneva dine vA yadi svama Ngalam upAlapsyathAH, tarhyuttamam abhaviShyat, kintu kShaNesmin tattava dR^iShTeragocharam bhavati|</para>
  <para style="p">
    <verse number="43" style="v"/>tvaM svatrANakAle na mano nyadhatthA iti heto ryatkAle tava ripavastvAM chaturdikShu prAchIreNa veShTayitvA rotsyanti</para>
  <para style="p">
    <verse number="44" style="v"/>bAlakaiH sArddhaM bhUmisAt kariShyanti cha tvanmadhye pAShANaikopi pAShANopari na sthAsyati cha, kAla IdR^isha upasthAsyati|</para>
  <para style="p">
    <verse number="45" style="v"/>atha madhyemandiraM pravishya tatratyAn krayivikrayiNo bahiShkurvvan</para>
  <para style="p">
    <verse number="46" style="v"/>avadat madgR^ihaM prArthanAgR^ihamiti lipirAste kintu yUyaM tadeva chairANAM gahvaraM kurutha|</para>
  <para style="p">
    <verse number="47" style="v"/>pashchAt sa pratyahaM madhyemandiram upadidesha; tataH pradhAnayAjakA adhyApakAH prAchInAshcha taM nAshayituM chicheShTire;</para>
  <para style="p">
    <verse number="48" style="v"/>kintu tadupadeshe sarvve lokA niviShTachittAH sthitAstasmAt te tatkarttuM nAvakAshaM prApuH|</para>
  <chapter number="20" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>athaikadA yIshu rmanidare susaMvAdaM prachArayan lokAnupadishati, etarhi pradhAnayAjakA adhyApakAH prA nchashcha tannikaTamAgatya paprachChuH</para>
  <para style="p">
    <verse number="2" style="v"/>kayAj nayA tvaM karmmANyetAni karoShi? ko vA tvAmAj nApayat? tadasmAn vada|</para>
  <para style="p">
    <verse number="3" style="v"/>sa pratyuvAcha, tarhi yuShmAnapi kathAmekAM pR^ichChAmi tasyottaraM vadata|</para>
  <para style="p">
    <verse number="4" style="v"/>yohano majjanam Ishvarasya mAnuShANAM vAj nAto jAtaM?</para>
  <para style="p">
    <verse number="5" style="v"/>tataste mitho vivichya jagaduH, yadIshvarasya vadAmastarhi taM kuto na pratyaita sa iti vakShyati|</para>
  <para style="p">
    <verse number="6" style="v"/>yadi manuShyasyeti vadAmastarhi sarvve lokA asmAn pAShANai rhaniShyanti yato yohan bhaviShyadvAdIti sarvve dR^iDhaM jAnanti|</para>
  <para style="p">
    <verse number="7" style="v"/>ataeva te pratyUchuH kasyAj nayA jAtam iti vaktuM na shaknumaH|</para>
  <para style="p">
    <verse number="8" style="v"/>tadA yIshuravadat tarhi kayAj nayA karmmANyetAti karomIti cha yuShmAn na vakShyAmi|</para>
  <para style="p">
    <verse number="9" style="v"/>atha lokAnAM sAkShAt sa imAM dR^iShTAntakathAM vaktumArebhe, kashchid drAkShAkShetraM kR^itvA tat kShetraM kR^iShIvalAnAM hasteShu samarpya bahukAlArthaM dUradeshaM jagAma|</para>
  <para style="p">
    <verse number="10" style="v"/>atha phalakAle phalAni grahItu kR^iShIvalAnAM samIpe dAsaM prAhiNot kintu kR^iShIvalAstaM prahR^itya riktahastaM visasarjuH|</para>
  <para style="p">
    <verse number="11" style="v"/>tataH sodhipatiH punaranyaM dAsaM preShayAmAsa, te tamapi prahR^itya kuvyavahR^itya riktahastaM visasR^ijuH|</para>
  <para style="p">
    <verse number="12" style="v"/>tataH sa tR^itIyavAram anyaM prAhiNot te tamapi kShatA NgaM kR^itvA bahi rnichikShipuH|</para>
  <para style="p">
    <verse number="13" style="v"/>tadA kShetrapati rvichArayAmAsa, mamedAnIM kiM karttavyaM? mama priye putre prahite te tamavashyaM dR^iShTvA samAdariShyante|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu kR^iShIvalAstaM nirIkShya parasparaM vivichya prochuH, ayamuttarAdhikArI AgachChatainaM hanmastatodhikArosmAkaM bhaviShyati|</para>
  <para style="p">
    <verse number="15" style="v"/>tataste taM kShetrAd bahi rnipAtya jaghnustasmAt sa kShetrapatistAn prati kiM kariShyati?</para>
  <para style="p">
    <verse number="16" style="v"/>sa Agatya tAn kR^iShIvalAn hatvA pareShAM hasteShu tatkShetraM samarpayiShyati; iti kathAM shrutvA te .avadan etAdR^ishI ghaTanA na bhavatu|</para>
  <para style="p">
    <verse number="17" style="v"/>kintu yIshustAnavalokya jagAda, tarhi, sthapatayaH kariShyanti grAvANaM yantu tuchChakaM| pradhAnaprastaraH koNe sa eva hi bhaviShyati| etasya shAstrIyavachanasya kiM tAtparyyaM?</para>
  <para style="p">
    <verse number="18" style="v"/>aparaM tatpAShANopari yaH patiShyati sa bhaMkShyate kintu yasyopari sa pAShANaH patiShyati sa tena dhUlivach chUrNIbhaviShyati|</para>
  <para style="p">
    <verse number="19" style="v"/>sosmAkaM viruddhaM dR^iShTAntamimaM kathitavAn iti j nAtvA pradhAnayAjakA adhyApakAshcha tadaiva taM dhartuM vavA nChuH kintu lokebhyo bibhyuH|</para>
  <para style="p">
    <verse number="20" style="v"/>ataeva taM prati satarkAH santaH kathaM tadvAkyadoShaM dhR^itvA taM deshAdhipasya sAdhuveshadhAriNashcharAn tasya samIpe preShayAmAsuH|</para>
  <para style="p">
    <verse number="21" style="v"/>tadA te taM paprachChuH, he upadeshaka bhavAn yathArthaM kathayan upadishati, kamapyanapekShya satyatvenaishvaraM mArgamupadishati, vayametajjAnImaH|</para>
  <para style="p">
    <verse number="22" style="v"/>kaisararAjAya karosmAbhi rdeyo na vA?</para>
  <para style="p">
    <verse number="23" style="v"/>sa teShAM va nchanaM j nAtvAvadat kuto mAM parIkShadhve? mAM mudrAmekaM darshayata|</para>
  <para style="p">
    <verse number="24" style="v"/>iha likhitA mUrtiriyaM nAma cha kasya? te.avadan kaisarasya|</para>
  <para style="p">
    <verse number="25" style="v"/>tadA sa uvAcha, tarhi kaisarasya dravyaM kaisarAya datta; Ishvarasya tu dravyamIshvarAya datta|</para>
  <para style="p">
    <verse number="26" style="v"/>tasmAllokAnAM sAkShAt tatkathAyAH kamapi doShaM dhartumaprApya te tasyottarAd AshcharyyaM manyamAnA mauninastasthuH|</para>
  <para style="p">
    <verse number="27" style="v"/>apara ncha shmashAnAdutthAnAna NgIkAriNAM sidUkinAM kiyanto janA Agatya taM paprachChuH,</para>
  <para style="p">
    <verse number="28" style="v"/>he upadeshaka shAstre mUsA asmAn pratIti lilekha yasya bhrAtA bhAryyAyAM satyAM niHsantAno mriyate sa tajjAyAM vivahya tadvaMsham utpAdayiShyati|</para>
  <para style="p">
    <verse number="29" style="v"/>tathAcha kechit sapta bhrAtara Asan teShAM jyeShTho bhrAtA vivahya nirapatyaH prANAn jahau|</para>
  <para style="p">
    <verse number="30" style="v"/>atha dvitIyastasya jAyAM vivahya nirapatyaH san mamAra| tR^itIyashcha tAmeva vyuvAha;</para>
  <para style="p">
    <verse number="31" style="v"/>itthaM sapta bhrAtarastAmeva vivahya nirapatyAH santo mamruH|</para>
  <para style="p">
    <verse number="32" style="v"/>sheShe sA strI cha mamAra|</para>
  <para style="p">
    <verse number="33" style="v"/>ataeva shmashAnAdutthAnakAle teShAM saptajanAnAM kasya sA bhAryyA bhaviShyati? yataH sA teShAM saptAnAmeva bhAryyAsIt|</para>
  <para style="p">
    <verse number="34" style="v"/>tadA yIshuH pratyuvAcha, etasya jagato lokA vivahanti vAgdattAshcha bhavanti</para>
  <para style="p">
    <verse number="35" style="v"/>kintu ye tajjagatprAptiyogyatvena gaNitAM bhaviShyanti shmashAnAchchotthAsyanti te na vivahanti vAgdattAshcha na bhavanti,</para>
  <para style="p">
    <verse number="36" style="v"/>te puna rna mriyante kintu shmashAnAdutthApitAH santa Ishvarasya santAnAH svargIyadUtAnAM sadR^ishAshcha bhavanti|</para>
  <para style="p">
    <verse number="37" style="v"/>adhikantu mUsAH stambopAkhyAne parameshvara IbrAhIma Ishvara ishAka Ishvaro yAkUbashcheshvara ityuktvA mR^itAnAM shmashAnAd utthAnasya pramANaM lilekha|</para>
  <para style="p">
    <verse number="38" style="v"/>ataeva ya IshvaraH sa mR^itAnAM prabhu rna kintu jIvatAmeva prabhuH, tannikaTe sarvve jIvantaH santi|</para>
  <para style="p">
    <verse number="39" style="v"/>iti shrutvA kiyantodhyApakA UchuH, he upadeshaka bhavAn bhadraM pratyuktavAn|</para>
  <para style="p">
    <verse number="40" style="v"/>itaH paraM taM kimapi praShTaM teShAM pragalbhatA nAbhUt|</para>
  <para style="p">
    <verse number="41" style="v"/>pashchAt sa tAn uvAcha, yaH khrIShTaH sa dAyUdaH santAna etAM kathAM lokAH kathaM kathayanti?</para>
  <para style="p">
    <verse number="42" style="v"/>yataH mama prabhumidaM vAkyamavadat parameshvaraH| tava shatrUnahaM yAvat pAdapIThaM karomi na| tAvat kAlaM madIye tvaM dakShapArshva upAvisha|</para>
  <para style="p">
    <verse number="43" style="v"/>iti kathAM dAyUd svayaM gItagranthe.avadat|</para>
  <para style="p">
    <verse number="44" style="v"/>ataeva yadi dAyUd taM prabhuM vadati, tarhi sa kathaM tasya santAno bhavati?</para>
  <para style="p">
    <verse number="45" style="v"/>pashchAd yIshuH sarvvajanAnAM karNagochare shiShyAnuvAcha,</para>
  <para style="p">
    <verse number="46" style="v"/>ye.adhyApakA dIrghaparichChadaM paridhAya bhramanti, haTTApaNayo rnamaskAre bhajanagehasya prochchAsane bhojanagR^ihasya pradhAnasthAne cha prIyante</para>
  <para style="p">
    <verse number="47" style="v"/>vidhavAnAM sarvvasvaM grasitvA Chalena dIrghakAlaM prArthayante cha teShu sAvadhAnA bhavata, teShAmugradaNDo bhaviShyati|</para>
  <chapter number="21" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha dhanilokA bhANDAgAre dhanaM nikShipanti sa tadeva pashyati,</para>
  <para style="p">
    <verse number="2" style="v"/>etarhi kAchiddInA vidhavA paNadvayaM nikShipati tad dadarsha|</para>
  <para style="p">
    <verse number="3" style="v"/>tato yIshuruvAcha yuShmAnahaM yathArthaM vadAmi, daridreyaM vidhavA sarvvebhyodhikaM nyakShepsIt,</para>
  <para style="p">
    <verse number="4" style="v"/>yatonye svaprAjyadhanebhya IshvarAya ki nchit nyakShepsuH, kintu daridreyaM vidhavA dinayApanArthaM svasya yat ki nchit sthitaM tat sarvvaM nyakShepsIt|</para>
  <para style="p">
    <verse number="5" style="v"/>apara ncha uttamaprastarairutsR^iShTavyaishcha mandiraM sushobhatetarAM kaishchidityukte sa pratyuvAcha</para>
  <para style="p">
    <verse number="6" style="v"/>yUyaM yadidaM nichayanaM pashyatha, asya pAShANaikopyanyapAShANopari na sthAsyati, sarvve bhUsAdbhaviShyanti kAloyamAyAti|</para>
  <para style="p">
    <verse number="7" style="v"/>tadA te paprachChuH, he guro ghaTanedR^ishI kadA bhaviShyati? ghaTanAyA etasyasashchihnaM vA kiM bhaviShyati?</para>
  <para style="p">
    <verse number="8" style="v"/>tadA sa jagAda, sAvadhAnA bhavata yathA yuShmAkaM bhramaM kopi na janayati, khIShTohamityuktvA mama nAmrA bahava upasthAsyanti sa kAlaH prAyeNopasthitaH, teShAM pashchAnmA gachChata|</para>
  <para style="p">
    <verse number="9" style="v"/>yuddhasyopaplavasya cha vArttAM shrutvA mA sha NkadhvaM, yataH prathamam etA ghaTanA avashyaM bhaviShyanti kintu nApAte yugAnto bhaviShyati|</para>
  <para style="p">
    <verse number="10" style="v"/>apara ncha kathayAmAsa, tadA deshasya vipakShatvena desho rAjyasya vipakShatvena rAjyam utthAsyati,</para>
  <para style="p">
    <verse number="11" style="v"/>nAnAsthAneShu mahAbhUkampo durbhikShaM mArI cha bhaviShyanti, tathA vyomamaNDalasya bhaya NkaradarshanAnyashcharyyalakShaNAni cha prakAshayiShyante|</para>
  <para style="p">
    <verse number="12" style="v"/>kintu sarvvAsAmetAsAM ghaTanAnAM pUrvvaM lokA yuShmAn dhR^itvA tADayiShyanti, bhajanAlaye kArAyA ncha samarpayiShyanti mama nAmakAraNAd yuShmAn bhUpAnAM shAsakAnA ncha sammukhaM neShyanti cha|</para>
  <para style="p">
    <verse number="13" style="v"/>sAkShyArtham etAni yuShmAn prati ghaTiShyante|</para>
  <para style="p">
    <verse number="14" style="v"/>tadA kimuttaraM vaktavyam etat na chintayiShyAma iti manaHsu nishchitanuta|</para>
  <para style="p">
    <verse number="15" style="v"/>vipakShA yasmAt kimapyuttaram Apatti ncha karttuM na shakShyanti tAdR^ishaM vAkpaTutvaM j nAna ncha yuShmabhyaM dAsyAmi|</para>
  <para style="p">
    <verse number="16" style="v"/>ki ncha yUyaM pitrA mAtrA bhrAtrA bandhunA j nAtyA kuTumbena cha parakareShu samarpayiShyadhve; tataste yuShmAkaM ka nchana ka nchana ghAtayiShyanti|</para>
  <para style="p">
    <verse number="17" style="v"/>mama nAmnaH kAraNAt sarvvai rmanuShyai ryUyam R^itIyiShyadhve|</para>
  <para style="p">
    <verse number="18" style="v"/>kintu yuShmAkaM shiraHkeshaikopi na vinaMkShyati,</para>
  <para style="p">
    <verse number="19" style="v"/>tasmAdeva dhairyyamavalambya svasvaprANAn rakShata|</para>
  <para style="p">
    <verse number="20" style="v"/>apara ncha yirUshAlampuraM sainyaveShTitaM vilokya tasyochChinnatAyAH samayaH samIpa ityavagamiShyatha|</para>
  <para style="p">
    <verse number="21" style="v"/>tadA yihUdAdeshasthA lokAH parvvataM palAyantAM, ye cha nagare tiShThanti te deshAntaraM palAyantA, ye cha grAme tiShThanti te nagaraM na pravishantu,</para>
  <para style="p">
    <verse number="22" style="v"/>yatastadA samuchitadaNDanAya dharmmapustake yAni sarvvANi likhitAni tAni saphalAni bhaviShyanti|</para>
  <para style="p">
    <verse number="23" style="v"/>kintu yA yAstadA garbhavatyaH stanyadAvyashcha tAmAM durgati rbhaviShyati, yata etAllokAn prati kopo deshe cha viShamadurgati rghaTiShyate|</para>
  <para style="p">
    <verse number="24" style="v"/>vastutastu te kha NgadhAraparivva NgaM lapsyante baddhAH santaH sarvvadesheShu nAyiShyante cha ki nchAnyadeshIyAnAM samayopasthitiparyyantaM yirUshAlampuraM taiH padatalai rdalayiShyate|</para>
  <para style="p">
    <verse number="25" style="v"/>sUryyachandranakShatreShu lakShaNAdi bhaviShyanti, bhuvi sarvvadeshIyAnAM duHkhaM chintA cha sindhau vIchInAM tarjanaM garjana ncha bhaviShyanti|</para>
  <para style="p">
    <verse number="26" style="v"/>bhUbhau bhAvighaTanAM chintayitvA manujA bhiyAmR^itakalpA bhaviShyanti, yato vyomamaNDale tejasvino dolAyamAnA bhaviShyanti|</para>
  <para style="p">
    <verse number="27" style="v"/>tadA parAkrameNA mahAtejasA cha meghArUDhaM manuShyaputram AyAntaM drakShyanti|</para>
  <para style="p">
    <verse number="28" style="v"/>kintvetAsAM ghaTanAnAmArambhe sati yUyaM mastakAnyuttolya UrdadhvaM drakShyatha, yato yuShmAkaM mukteH kAlaH savidho bhaviShyati|</para>
  <para style="p">
    <verse number="29" style="v"/>tatastenaitadR^iShTAntakathA kathitA, pashyata uDumbarAdivR^ikShANAM</para>
  <para style="p">
    <verse number="30" style="v"/>navInapatrANi jAtAnIti dR^iShTvA nidAvakAla upasthita iti yathA yUyaM j nAtuM shaknutha,</para>
  <para style="p">
    <verse number="31" style="v"/>tathA sarvvAsAmAsAM ghaTanAnAm Arambhe dR^iShTe satIshvarasya rAjatvaM nikaTam ityapi j nAsyatha|</para>
  <para style="p">
    <verse number="32" style="v"/>yuShmAnahaM yathArthaM vadAmi, vidyamAnalokAnAmeShAM gamanAt pUrvvam etAni ghaTiShyante|</para>
  <para style="p">
    <verse number="33" style="v"/>nabhobhuvorlopo bhaviShyati mama vAk tu kadApi luptA na bhaviShyati|</para>
  <para style="p">
    <verse number="34" style="v"/>ataeva viShamAshanena pAnena cha sAMmArikachintAbhishcha yuShmAkaM chitteShu matteShu taddinam akasmAd yuShmAn prati yathA nopatiShThati tadarthaM sveShu sAvadhAnAstiShThata|</para>
  <para style="p">
    <verse number="35" style="v"/>pR^ithivIsthasarvvalokAn prati taddinam unmAtha iva upasthAsyati|</para>
  <para style="p">
    <verse number="36" style="v"/>yathA yUyam etadbhAvighaTanA uttarttuM manujasutasya sammukhe saMsthAtu ncha yogyA bhavatha kAraNAdasmAt sAvadhAnAH santo nirantaraM prArthayadhvaM|</para>
  <para style="p">
    <verse number="37" style="v"/>apara ncha sa divA mandira upadishya rAchai jaitunAdriM gatvAtiShThat|</para>
  <para style="p">
    <verse number="38" style="v"/>tataH pratyUShe lAkAstatkathAM shrotuM mandire tadantikam AgachChan|</para>
  <chapter number="22" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>apara ncha kiNvashUnyapUpotsavasya kAla upasthite</para>
  <para style="p">
    <verse number="2" style="v"/>pradhAnayAjakA adhyAyakAshcha yathA taM hantuM shaknuvanti tathopAyAm acheShTanta kintu lokebhyo bibhyuH|</para>
  <para style="p">
    <verse number="3" style="v"/>etastin samaye dvAdashashiShyeShu gaNita IShkariyotIyarUDhimAn yo yihUdAstasyAntaHkaraNaM shaitAnAshritatvAt</para>
  <para style="p">
    <verse number="4" style="v"/>sa gatvA yathA yIshuM teShAM kareShu samarpayituM shaknoti tathA mantraNAM pradhAnayAjakaiH senApatibhishcha saha chakAra|</para>
  <para style="p">
    <verse number="5" style="v"/>tena te tuShTAstasmai mudrAM dAtuM paNaM chakruH|</para>
  <para style="p">
    <verse number="6" style="v"/>tataH so NgIkR^itya yathA lokAnAmagochare taM parakareShu samarpayituM shaknoti tathAvakAshaM cheShTitumArebhe|</para>
  <para style="p">
    <verse number="7" style="v"/>atha kiNvashUnyapUpotmavadine, arthAt yasmin dine nistArotsavasya meSho hantavyastasmin dine</para>
  <para style="p">
    <verse number="8" style="v"/>yIshuH pitaraM yohana nchAhUya jagAda, yuvAM gatvAsmAkaM bhojanArthaM nistArotsavasya dravyANyAsAdayataM|</para>
  <para style="p">
    <verse number="9" style="v"/>tadA tau paprachChatuH kuchAsAdayAvo bhavataH kechChA?</para>
  <para style="p">
    <verse number="10" style="v"/>tadA sovAdIt, nagare praviShTe kashchijjalakumbhamAdAya yuvAM sAkShAt kariShyati sa yanniveshanaM pravishati yuvAmapi tanniveshanaM tatpashchAditvA niveshanapatim iti vAkyaM vadataM,</para>
  <para style="p">
    <verse number="11" style="v"/>yatrAhaM nistArotsavasya bhojyaM shiShyaiH sArddhaM bhoktuM shaknomi sAtithishAlAा kutra? kathAmimAM prabhustvAM pR^ichChati|</para>
  <para style="p">
    <verse number="12" style="v"/>tataH sa jano dvitIyaprakoShThIyam ekaM shastaM koShThaM darshayiShyati tatra bhojyamAsAdayataM|</para>
  <para style="p">
    <verse number="13" style="v"/>tatastau gatvA tadvAkyAnusAreNa sarvvaM dR^iShdvA tatra nistArotsavIyaM bhojyamAsAdayAmAsatuH|</para>
  <para style="p">
    <verse number="14" style="v"/>atha kAla upasthite yIshu rdvAdashabhiH preritaiH saha bhoktumupavishya kathitavAn</para>
  <para style="p">
    <verse number="15" style="v"/>mama duHkhabhogAt pUrvvaM yubhAbhiH saha nistArotsavasyaitasya bhojyaM bhoktuM mayAtivA nChA kR^itA|</para>
  <para style="p">
    <verse number="16" style="v"/>yuShmAn vadAmi, yAvatkAlam IshvararAjye bhojanaM na kariShye tAvatkAlam idaM na bhokShye|</para>
  <para style="p">
    <verse number="17" style="v"/>tadA sa pAnapAtramAdAya Ishvarasya guNAn kIrttayitvA tebhyo datvAvadat, idaM gR^ihlIta yUyaM vibhajya pivata|</para>
  <para style="p">
    <verse number="18" style="v"/>yuShmAn vadAmi yAvatkAlam IshvararAjatvasya saMsthApanaM na bhavati tAvad drAkShAphalarasaM na pAsyAmi|</para>
  <para style="p">
    <verse number="19" style="v"/>tataH pUpaM gR^ihItvA IshvaraguNAn kIrttayitvA bha NktA tebhyo datvAvadat, yuShmadarthaM samarpitaM yanmama vapustadidaM, etat karmma mama smaraNArthaM kurudhvaM|</para>
  <para style="p">
    <verse number="20" style="v"/>atha bhojanAnte tAdR^ishaM pAtraM gR^ihItvAvadat, yuShmatkR^ite pAtitaM yanmama raktaM tena nirNItanavaniyamarUpaM pAnapAtramidaM|</para>
  <para style="p">
    <verse number="21" style="v"/>pashyata yo mAM parakareShu samarpayiShyati sa mayA saha bhojanAsana upavishati|</para>
  <para style="p">
    <verse number="22" style="v"/>yathA nirUpitamAste tadanusAreNA manuShyapuुtrasya gati rbhaviShyati kintu yastaM parakareShu samarpayiShyati tasya santApo bhaviShyati|</para>
  <para style="p">
    <verse number="23" style="v"/>tadA teShAM ko jana etat karmma kariShyati tat te parasparaM praShTumArebhire|</para>
  <para style="p">
    <verse number="24" style="v"/>aparaM teShAM ko janaH shreShThatvena gaNayiShyate, atrArthe teShAM vivAdobhavat|</para>
  <para style="p">
    <verse number="25" style="v"/>asmAt kAraNAt sovadat, anyadeshIyAnAM rAjAnaH prajAnAmupari prabhutvaM kurvvanti dAruNashAsanaM kR^itvApi te bhUpatitvena vikhyAtA bhavanti cha|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu yuShmAkaM tathA na bhaviShyati, yo yuShmAkaM shreShTho bhaviShyati sa kaniShThavad bhavatu, yashcha mukhyo bhaviShyati sa sevakavadbhavatu|</para>
  <para style="p">
    <verse number="27" style="v"/>bhojanopaviShTaparichArakayoH kaH shreShThaH? yo bhojanAyopavishati sa kiM shreShTho na bhavati? kintu yuShmAkaM madhye.ahaM parichAraka_ivAsmi|</para>
  <para style="p">
    <verse number="28" style="v"/>apara ncha yuyaM mama parIkShAkAle prathamamArabhya mayA saha sthitA</para>
  <para style="p">
    <verse number="29" style="v"/>etatkAraNAt pitrA yathA madarthaM rAjyamekaM nirUpitaM tathAhamapi yuShmadarthaM rAjyaM nirUpayAmi|</para>
  <para style="p">
    <verse number="30" style="v"/>tasmAn mama rAjye bhojanAsane cha bhojanapAne kariShyadhve siMhAsaneShUpavishya chesrAyelIyAnAM dvAdashavaMshAnAM vichAraM kariShyadhve|</para>
  <para style="p">
    <verse number="31" style="v"/>aparaM prabhuruvAcha, he shimon pashya tita_unA dhAnyAnIva yuShmAn shaitAn chAlayitum aichChat,</para>
  <para style="p">
    <verse number="32" style="v"/>kintu tava vishvAsasya lopo yathA na bhavati etat tvadarthaM prArthitaM mayA, tvanmanasi parivarttite cha bhrAtR^iNAM manAMsi sthirIkuru|</para>
  <para style="p">
    <verse number="33" style="v"/>tadA sovadat, he prabhohaM tvayA sArddhaM kArAM mR^iti ncha yAtuM majjitosmi|</para>
  <para style="p">
    <verse number="34" style="v"/>tataH sa uvAcha, he pitara tvAM vadAmi, adya kukkuTaravAt pUrvvaM tvaM matparichayaM vAratrayam apahvoShyase|</para>
  <para style="p">
    <verse number="35" style="v"/>aparaM sa paprachCha, yadA mudrAsampuTaM khAdyapAtraM pAdukA ncha vinA yuShmAn prAhiNavaM tadA yuShmAkaM kasyApi nyUnatAsIt? te prochuH kasyApi na|</para>
  <para style="p">
    <verse number="36" style="v"/>tadA sovadat kintvidAnIM mudrAsampuTaM khAdyapAtraM vA yasyAsti tena tadgrahItavyaM, yasya cha kR^ipANoे nAsti tena svavastraM vikrIya sa kretavyaH|</para>
  <para style="p">
    <verse number="37" style="v"/>yato yuShmAnahaM vadAmi, aparAdhijanaiH sArddhaM gaNitaH sa bhaviShyati| idaM yachChAstrIyaM vachanaM likhitamasti tanmayi phaliShyati yato mama sambandhIyaM sarvvaM setsyati|</para>
  <para style="p">
    <verse number="38" style="v"/>tadA te prochuH prabho pashya imau kR^ipANau| tataH sovadad etau yatheShTau|</para>
  <para style="p">
    <verse number="39" style="v"/>atha sa tasmAdvahi rgatvA svAchArAnusAreNa jaitunanAmAdriM jagAma shiShyAshcha tatpashchAd yayuH|</para>
  <para style="p">
    <verse number="40" style="v"/>tatropasthAya sa tAnuvAcha, yathA parIkShAyAM na patatha tadarthaM prArthayadhvaM|</para>
  <para style="p">
    <verse number="41" style="v"/>pashchAt sa tasmAd ekasharakShepAd bahi rgatvA jAnunI pAtayitvA etat prArthayA nchakre,</para>
  <para style="p">
    <verse number="42" style="v"/>he pita ryadi bhavAn sammanyate tarhi kaMsamenaM mamAntikAd dUraya kintu madichChAnurUpaM na tvadichChAnurUpaM bhavatu|</para>
  <para style="p">
    <verse number="43" style="v"/>tadA tasmai shaktiM dAtuM svargIyadUto darshanaM dadau|</para>
  <para style="p">
    <verse number="44" style="v"/>pashchAt sotyantaM yAtanayA vyAkulo bhUtvA punardR^iDhaM prArthayA nchakre, tasmAd bR^ihachChoNitabindava iva tasya svedabindavaH pR^ithivyAM patitumArebhire|</para>
  <para style="p">
    <verse number="45" style="v"/>atha prArthanAta utthAya shiShyANAM samIpametya tAn manoduHkhino nidritAn dR^iShTvAvadat</para>
  <para style="p">
    <verse number="46" style="v"/>kuto nidrAtha? parIkShAyAm apatanArthaM prarthayadhvaM|</para>
  <para style="p">
    <verse number="47" style="v"/>etatkathAyAH kathanakAle dvAdashashiShyANAM madhye gaNito yihUdAnAmA janatAsahitasteShAm agre chalitvA yIshoshchumbanArthaM tadantikam Ayayau|</para>
  <para style="p">
    <verse number="48" style="v"/>tadA yIshuruvAcha, he yihUdA kiM chumbanena manuShyaputraM parakareShu samarpayasi?</para>
  <para style="p">
    <verse number="49" style="v"/>tadA yadyad ghaTiShyate tadanumAya sa NgibhiruktaM, he prabho vayaM ki kha Ngena ghAtayiShyAmaH?</para>
  <para style="p">
    <verse number="50" style="v"/>tata ekaH karavAlenAhatya pradhAnayAjakasya dAsasya dakShiNaM karNaM chichCheda|</para>
  <para style="p">
    <verse number="51" style="v"/>adhUnA nivarttasva ityuktvA yIshustasya shrutiM spR^iShTvA svasyaM chakAra|</para>
  <para style="p">
    <verse number="52" style="v"/>pashchAd yIshuH samIpasthAn pradhAnayAjakAn mandirasya senApatIn prAchInAMshcha jagAda, yUyaM kR^ipANAn yaShTIMshcha gR^ihItvA mAM kiM choraM dharttumAyAtAH?</para>
  <para style="p">
    <verse number="53" style="v"/>yadAhaM yuShmAbhiH saha pratidinaM mandire.atiShThaM tadA mAM dharttaM na pravR^ittAH, kintvidAnIM yuShmAkaM samayondhakArasya chAdhipatyamasti|</para>
  <para style="p">
    <verse number="54" style="v"/>atha te taM dhR^itvA mahAyAjakasya niveshanaM ninyuH| tataH pitaro dUre dUre pashchAditvA</para>
  <para style="p">
    <verse number="55" style="v"/>bR^ihatkoShThasya madhye yatrAgniM jvAlayitvA lokAH sametyopaviShTAstatra taiH sArddham upavivesha|</para>
  <para style="p">
    <verse number="56" style="v"/>atha vahnisannidhau samupaveshakAle kAchiddAsI mano nivishya taM nirIkShyAvadat pumAnayaM tasya sa Nge.asthAt|</para>
  <para style="p">
    <verse number="57" style="v"/>kintu sa tad apahnutyAvAdIt he nAri tamahaM na parichinomi|</para>
  <para style="p">
    <verse number="58" style="v"/>kShaNAntare.anyajanastaM dR^iShTvAbravIt tvamapi teShAM nikarasyaikajanosi| pitaraH pratyuvAcha he nara nAhamasmi|</para>
  <para style="p">
    <verse number="59" style="v"/>tataH sArddhadaNDadvayAt paraM punaranyo jano nishchitya babhAShe, eSha tasya sa NgIti satyaM yatoyaM gAlIlIyo lokaH|</para>
  <para style="p">
    <verse number="60" style="v"/>tadA pitara uvAcha he nara tvaM yad vadami tadahaM boddhuM na shaknomi, iti vAkye kathitamAtre kukkuTo rurAva|</para>
  <para style="p">
    <verse number="61" style="v"/>tadA prabhuNA vyAdhuTya pitare nirIkShite kR^ikavAkuravAt pUrvvaM mAM trirapahnoShyase iti pUrvvoktaM tasya vAkyaM pitaraH smR^itvA</para>
  <para style="p">
    <verse number="62" style="v"/>bahirgatvA mahAkhedena chakranda|</para>
  <para style="p">
    <verse number="63" style="v"/>tadA yai ryIshurdhR^itaste tamupahasya praharttumArebhire|</para>
  <para style="p">
    <verse number="64" style="v"/>vastreNa tasya dR^ishau baddhvA kapole chapeTAghAtaM kR^itvA paprachChuH, kaste kapole chapeTAghAtaM kR^itavAna? gaNayitvA tad vada|</para>
  <para style="p">
    <verse number="65" style="v"/>tadanyat tadviruddhaM bahunindAvAkyaM vaktumArebhire|</para>
  <para style="p">
    <verse number="66" style="v"/>atha prabhAte sati lokaprA nchaH pradhAnayAjakA adhyApakAshcha sabhAM kR^itvA madhyesabhaM yIshumAnIya paprachChuH, tvam abhiShikatosi na vAsmAn vada|</para>
  <para style="p">
    <verse number="67" style="v"/>sa pratyuvAcha, mayA tasminnukte.api yUyaM na vishvasiShyatha|</para>
  <para style="p">
    <verse number="68" style="v"/>kasmiMshchidvAkye yuShmAn pR^iShTe.api mAM na taduttaraM vakShyatha na mAM tyakShyatha cha|</para>
  <para style="p">
    <verse number="69" style="v"/>kintvitaH paraM manujasutaH sarvvashaktimata Ishvarasya dakShiNe pArshve samupavekShyati|</para>
  <para style="p">
    <verse number="70" style="v"/>tataste paprachChuH, rtiha tvamIshvarasya putraH? sa kathayAmAsa, yUyaM yathArthaM vadatha sa evAhaM|</para>
  <para style="p">
    <verse number="71" style="v"/>tadA te sarvve kathayAmAsuH, rtiha sAkShye.ansasmin asmAkaM kiM prayojanaM? asya svamukhAdeva sAkShyaM prAptam|</para>
  <chapter number="23" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataH sabhAsthAH sarvvalokA utthAya taM pIlAtasammukhaM nItvAprodya vaktumArebhire,</para>
  <para style="p">
    <verse number="2" style="v"/>svamabhiShiktaM rAjAnaM vadantaM kaimararAjAya karadAnaM niShedhantaM rAjyaviparyyayaM kurttuM pravarttamAnam ena prAptA vayaM|</para>
  <para style="p">
    <verse number="3" style="v"/>tadA pIlAtastaM pR^iShTavAn tvaM kiM yihUdIyAnAM rAjA? sa pratyuvAcha tvaM satyamuktavAn|</para>
  <para style="p">
    <verse number="4" style="v"/>tadA pIlAtaH pradhAnayAjakAdilokAn jagAd, ahametasya kamapyaparAdhaM nAptavAn|</para>
  <para style="p">
    <verse number="5" style="v"/>tataste punaH sAhamino bhUtvAvadan, eSha gAlIla etatsthAnaparyyante sarvvasmin yihUdAdeshe sarvvAllokAnupadishya kupravR^ittiM grAhItavAn|</para>
  <para style="p">
    <verse number="6" style="v"/>tadA pIlAto gAlIlapradeshasya nAma shrutvA paprachCha, kimayaM gAlIlIyo lokaH?</para>
  <para style="p">
    <verse number="7" style="v"/>tataH sa gAlIlpradeshIyaherodrAjasya tadA sthitestasya samIpe yIshuM preShayAmAsa|</para>
  <para style="p">
    <verse number="8" style="v"/>tadA herod yIshuM vilokya santutoSha, yataH sa tasya bahuvR^ittAntashravaNAt tasya ki ni्chadAshcharyyakarmma pashyati ityAshAM kR^itvA bahukAlamArabhya taM draShTuM prayAsaM kR^itavAn|</para>
  <para style="p">
    <verse number="9" style="v"/>tasmAt taM bahukathAH paprachCha kintu sa tasya kasyApi vAkyasya pratyuttaraM novAcha|</para>
  <para style="p">
    <verse number="10" style="v"/>atha pradhAnayAjakA adhyApakAshcha prottiShThantaH sAhasena tamapavadituM prArebhire|</para>
  <para style="p">
    <verse number="11" style="v"/>herod tasya senAgaNashcha tamavaj nAya upahAsatvena rAjavastraM paridhApya punaH pIlAtaM prati taM prAhiNot|</para>
  <para style="p">
    <verse number="12" style="v"/>pUrvvaM herodpIlAtayoH parasparaM vairabhAva AsIt kintu taddine dvayo rmelanaM jAtam|</para>
  <para style="p">
    <verse number="13" style="v"/>pashchAt pIlAtaH pradhAnayAjakAn shAsakAn lokAMshcha yugapadAhUya babhAShe,</para>
  <para style="p">
    <verse number="14" style="v"/>rAjyaviparyyayakArakoyam ityuktvA manuShyamenaM mama nikaTamAnaiShTa kintu pashyata yuShmAkaM samakSham asya vichAraM kR^itvApi proktApavAdAnurUpeNAsya kopyaparAdhaH sapramANo na jAtaH,</para>
  <para style="p">
    <verse number="15" style="v"/>yUya ncha herodaH sannidhau preShitA mayA tatrAsya kopyaparAdhastenApi na prAptaH|pashyatAnena vadhaheेtukaM kimapi nAparAddhaM|</para>
  <para style="p">
    <verse number="16" style="v"/>tasmAdenaM tADayitvA vihAsyAmi|</para>
  <para style="p">
    <verse number="17" style="v"/>tatrotsave teShAmeko mochayitavyaH|</para>
  <para style="p">
    <verse number="18" style="v"/>iti hetoste prochchairekadA prochuH, enaM dUrIkR^itya barabbAnAmAnaM mochaya|</para>
  <para style="p">
    <verse number="19" style="v"/>sa barabbA nagara upaplavavadhAparAdhAbhyAM kArAyAM baddha AsIt|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu pIlAto yIshuM mochayituM vA nChan punastAnuvAcha|</para>
  <para style="p">
    <verse number="21" style="v"/>tathApyenaM krushe vyadha krushe vyadheti vadantaste ruruvuH|</para>
  <para style="p">
    <verse number="22" style="v"/>tataH sa tR^itIyavAraM jagAda kutaH? sa kiM karmma kR^itavAn? nAhamasya kamapi vadhAparAdhaM prAptaH kevalaM tADayitvAmuM tyajAmi|</para>
  <para style="p">
    <verse number="23" style="v"/>tathApi te punarenaM krushe vyadha ityuktvA prochchairdR^iDhaM prArthayA nchakrire;</para>
  <para style="p">
    <verse number="24" style="v"/>tataH pradhAnayAjakAdInAM kalarave prabale sati teShAM prArthanArUpaM karttuM pIlAta Adidesha|</para>
  <para style="p">
    <verse number="25" style="v"/>rAjadrohavadhayoraparAdhena kArAsthaM yaM janaM te yayAchire taM mochayitvA yIshuM teShAmichChAyAM samArpayat|</para>
  <para style="p">
    <verse number="26" style="v"/>atha te yIshuM gR^ihItvA yAnti, etarhi grAmAdAgataM shimonanAmAnaM kurINIyaM janaM dhR^itvA yIshoH pashchAnnetuM tasya skandhe krushamarpayAmAsuH|</para>
  <para style="p">
    <verse number="27" style="v"/>tato loाkAraNyamadhye bahustriyo rudatyo vilapantyashcha yIshoH pashchAd yayuH|</para>
  <para style="p">
    <verse number="28" style="v"/>kintu sa vyAghuTya tA uvAcha, he yirUshAlamo nAryyo yuyaM madarthaM na ruditvA svArthaM svApatyArtha ncha ruditi;</para>
  <para style="p">
    <verse number="29" style="v"/>pashyata yaH kadApi garbhavatyo nAbhavan stanya ncha nApAyayan tAdR^ishI rvandhyA yadA dhanyA vakShyanti sa kAla AyAti|</para>
  <para style="p">
    <verse number="30" style="v"/>tadA he shailA asmAkamupari patata, he upashailA asmAnAchChAdayata kathAmIdR^ishIM lokA vakShyanti|</para>
  <para style="p">
    <verse number="31" style="v"/>yataH satejasi shAkhini chedetad ghaTate tarhi shuShkashAkhini kiM na ghaTiShyate?</para>
  <para style="p">
    <verse number="32" style="v"/>tadA te hantuM dvAvaparAdhinau tena sArddhaM ninyuH|</para>
  <para style="p">
    <verse number="33" style="v"/>aparaM shiraHkapAlanAmakasthAnaM prApya taM krushe vividhuH; taddvayoraparAdhinorekaM tasya dakShiNo tadanyaM vAme krushe vividhuH|</para>
  <para style="p">
    <verse number="34" style="v"/>tadA yIshurakathayat, he pitaretAn kShamasva yata ete yat karmma kurvvanti tan na viduH; pashchAtte guTikApAtaM kR^itvA tasya vastrANi vibhajya jagR^ihuH|</para>
  <para style="p">
    <verse number="35" style="v"/>tatra lokasaMghastiShThan dadarsha; te teShAM shAsakAshcha tamupahasya jagaduH, eSha itarAn rakShitavAn yadIshvareNAbhiruchito .abhiShiktastrAtA bhavati tarhi svamadhunA rakShatu|</para>
  <para style="p">
    <verse number="36" style="v"/>tadanyaH senAgaNA etya tasmai amlarasaM datvA parihasya provAcha,</para>
  <para style="p">
    <verse number="37" style="v"/>chettvaM yihUdIyAnAM rAjAsi tarhi svaM rakSha|</para>
  <para style="p">
    <verse number="38" style="v"/>yihUdIyAnAM rAjeti vAkyaM yUnAnIyaromIyebrIyAkSharai rlikhitaM tachChirasa Urddhve.asthApyata|</para>
  <para style="p">
    <verse number="39" style="v"/>tadobhayapArshvayo rviddhau yAvaparAdhinau tayorekastaM vinindya babhAShe, chettvam abhiShiktosi tarhi svamAvA ncha rakSha|</para>
  <para style="p">
    <verse number="40" style="v"/>kintvanyastaM tarjayitvAvadat, IshvarAttava ki nchidapi bhayaM nAsti kiM? tvamapi samAnadaNDosi,</para>
  <para style="p">
    <verse number="41" style="v"/>yogyapAtre AvAM svasvakarmmaNAM samuchitaphalaM prApnuvaH kintvanena kimapi nAparAddhaM|</para>
  <para style="p">
    <verse number="42" style="v"/>atha sa yIshuM jagAda he prabhe bhavAn svarAjyapraveshakAle mAM smaratu|</para>
  <para style="p">
    <verse number="43" style="v"/>tadA yIshuH kathitavAn tvAM yathArthaM vadAmi tvamadyaiva mayA sArddhaM paralokasya sukhasthAnaM prApsyasi|</para>
  <para style="p">
    <verse number="44" style="v"/>apara ncha dvitIyayAmAt tR^itIyayAmaparyyantaM ravestejasontarhitatvAt sarvvadesho.andhakAreNAvR^ito</para>
  <para style="p">
    <verse number="45" style="v"/>mandirasya yavanikA cha ChidyamAnA dvidhA babhUva|</para>
  <para style="p">
    <verse number="46" style="v"/>tato yIshuruchchairuvAcha, he pita rmamAtmAnaM tava kare samarpaye, ityuktvA sa prANAn jahau|</para>
  <para style="p">
    <verse number="47" style="v"/>tadaitA ghaTanA dR^iShTvA shatasenApatirIshvaraM dhanyamuktvA kathitavAn ayaM nitAntaM sAdhumanuShya AsIt|</para>
  <para style="p">
    <verse number="48" style="v"/>atha yAvanto lokA draShTum AgatAste tA ghaTanA dR^iShTvA vakShaHsu karAghAtaM kR^itvA vyAchuTya gatAH|</para>
  <para style="p">
    <verse number="49" style="v"/>yIsho rj nAtayo yA yA yoShitashcha gAlIlastena sArddhamAyAtAstA api dUre sthitvA tat sarvvaM dadR^ishuH|</para>
  <para style="p">
    <verse number="50" style="v"/>tadA yihUdIyAnAM mantraNAM kriyA nchAsammanyamAna Ishvarasya rAjatvam apekShamANo</para>
  <para style="p">
    <verse number="51" style="v"/>yihUdideshIyo .arimathIyanagarIyo yUShaphnAmA mantrI bhadro dhArmmikashcha pumAn</para>
  <para style="p">
    <verse number="52" style="v"/>pIlAtAntikaM gatvA yIsho rdehaM yayAche|</para>
  <para style="p">
    <verse number="53" style="v"/>pashchAd vapuravarohya vAsasA saMveShTya yatra kopi mAnuSho nAsthApyata tasmin shaile svAte shmashAne tadasthApayat|</para>
  <para style="p">
    <verse number="54" style="v"/>taddinamAyojanIyaM dinaM vishrAmavArashcha samIpaH|</para>
  <para style="p">
    <verse number="55" style="v"/>aparaM yIshunA sArddhaM gAlIla AgatA yoShitaH pashchAditvA shmashAne tatra yathA vapuH sthApitaM tachcha dR^iShTvA</para>
  <para style="p">
    <verse number="56" style="v"/>vyAghuTya sugandhidravyatailAni kR^itvA vidhivad vishrAmavAre vishrAmaM chakruH|</para>
  <chapter number="24" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha saptAhaprathamadine.atipratyUShe tA yoShitaH sampAditaM sugandhidravyaM gR^ihItvA tadanyAbhiH kiyatIbhiH strIbhiH saha shmashAnaM yayuH|</para>
  <para style="p">
    <verse number="2" style="v"/>kintu shmashAnadvArAt pAShANamapasAritaM dR^iShTvA</para>
  <para style="p">
    <verse number="3" style="v"/>tAH pravishya prabho rdehamaprApya</para>
  <para style="p">
    <verse number="4" style="v"/>vyAkulA bhavanti etarhi tejomayavastrAnvitau dvau puruShau tAsAM samIpe samupasthitau</para>
  <para style="p">
    <verse number="5" style="v"/>tasmAttAH sha NkAyuktA bhUmAvadhomukhyasyasthuH| tadA tau tA Uchatu rmR^itAnAM madhye jIvantaM kuto mR^igayatha?</para>
  <para style="p">
    <verse number="6" style="v"/>sotra nAsti sa udasthAt|</para>
  <para style="p">
    <verse number="7" style="v"/>pApinAM kareShu samarpitena krushe hatena cha manuShyaputreNa tR^itIyadivase shmashAnAdutthAtavyam iti kathAM sa galIli tiShThan yuShmabhyaM kathitavAn tAM smarata|</para>
  <para style="p">
    <verse number="8" style="v"/>tadA tasya sA kathA tAsAM manaHsu jAtA|</para>
  <para style="p">
    <verse number="9" style="v"/>anantaraM shmashAnAd gatvA tA ekAdashashiShyAdibhyaH sarvvebhyastAM vArttAM kathayAmAsuH|</para>
  <para style="p">
    <verse number="10" style="v"/>magdalInImariyam, yohanA, yAkUbo mAtA mariyam tadanyAH sa Nginyo yoShitashcha preritebhya etAH sarvvA vArttAH kathayAmAsuH</para>
  <para style="p">
    <verse number="11" style="v"/>kintu tAsAM kathAm anarthakAkhyAnamAtraM buddhvA kopi na pratyait|</para>
  <para style="p">
    <verse number="12" style="v"/>tadA pitara utthAya shmashAnAntikaM dadhAva, tatra cha prahvo bhUtvA pArshvaikasthApitaM kevalaM vastraM dadarsha; tasmAdAshcharyyaM manyamAno yadaghaTata tanmanasi vichArayan pratasthe|</para>
  <para style="p">
    <verse number="13" style="v"/>tasminneva dine dvau shiyyau yirUshAlamashchatuShkroshAntaritam immAyugrAmaM gachChantau</para>
  <para style="p">
    <verse number="14" style="v"/>tAsAM ghaTanAnAM kathAmakathayatAM</para>
  <para style="p">
    <verse number="15" style="v"/>tayorAlApavichArayoH kAle yIshurAgatya tAbhyAM saha jagAma</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yathA tau taM na parichinutastadarthaM tayo rdR^iShTiH saMruddhA|</para>
  <para style="p">
    <verse number="17" style="v"/>sa tau pR^iShTavAn yuvAM viShaNNau kiM vichArayantau gachChathaH?</para>
  <para style="p">
    <verse number="18" style="v"/>tatastayoH kliyapAnAmA pratyuvAcha yirUshAlamapure.adhunA yAnyaghaTanta tvaM kevalavideshI kiM tadvR^ittAntaM na jAnAsi?</para>
  <para style="p">
    <verse number="19" style="v"/>sa paprachCha kA ghaTanAH? tadA tau vaktumArebhAte yIshunAmA yo nAsaratIyo bhaviShyadvAdI Ishvarasya mAnuShANA ncha sAkShAt vAkye karmmaNi cha shaktimAnAsIt</para>
  <para style="p">
    <verse number="20" style="v"/>tam asmAkaM pradhAnayAjakA vichArakAshcha kenApi prakAreNa krushe viddhvA tasya prANAnanAshayan tadIyA ghaTanAH;</para>
  <para style="p">
    <verse number="21" style="v"/>kintu ya isrAyelIyalokAn uddhArayiShyati sa evAyam ityAshAsmAbhiH kR^itA|tadyathA tathAstu tasyA ghaTanAyA adya dinatrayaM gataM|</para>
  <para style="p">
    <verse number="22" style="v"/>adhikantvasmAkaM sa NginInAM kiyatstrINAM mukhebhyo.asambhavavAkyamidaM shrutaM;</para>
  <para style="p">
    <verse number="23" style="v"/>tAH pratyUShe shmashAnaM gatvA tatra tasya deham aprApya vyAghuTyetvA proktavatyaH svargIsadUtau dR^iShTAvasmAbhistau chAvAdiShTAM sa jIvitavAn|</para>
  <para style="p">
    <verse number="24" style="v"/>tatosmAkaM kaishchit shmashAnamagamyata te.api strINAM vAkyAnurUpaM dR^iShTavantaH kintu taM nApashyan|</para>
  <para style="p">
    <verse number="25" style="v"/>tadA sa tAvuvAcha, he abodhau he bhaviShyadvAdibhiruktavAkyaM pratyetuM vilambamAnau;</para>
  <para style="p">
    <verse number="26" style="v"/>etatsarvvaduHkhaM bhuktvA svabhUtiprAptiH kiM khrIShTasya na nyAyyA?</para>
  <para style="p">
    <verse number="27" style="v"/>tataH sa mUsAgranthamArabhya sarvvabhaviShyadvAdinAM sarvvashAstre svasmin likhitAkhyAnAbhiprAyaM bodhayAmAsa|</para>
  <para style="p">
    <verse number="28" style="v"/>atha gamyagrAmAbhyarNaM prApya tenAgre gamanalakShaNe darshite</para>
  <para style="p">
    <verse number="29" style="v"/>tau sAdhayitvAvadatAM sahAvAbhyAM tiShTha dine gate sati rAtrirabhUt; tataH sa tAbhyAM sArddhaM sthAtuM gR^ihaM yayau|</para>
  <para style="p">
    <verse number="30" style="v"/>pashchAdbhojanopaveshakAle sa pUpaM gR^ihItvA IshvaraguNAn jagAda ta ncha bhaMktvA tAbhyAM dadau|</para>
  <para style="p">
    <verse number="31" style="v"/>tadA tayo rdR^iShTau prasannAyAM taM pratyabhij natuH kintu sa tayoH sAkShAdantardadhe|</para>
  <para style="p">
    <verse number="32" style="v"/>tatastau mithobhidhAtum Arabdhavantau gamanakAle yadA kathAmakathayat shAstrArtha nchabodhayat tadAvayo rbuddhiH kiM na prAjvalat?</para>
  <para style="p">
    <verse number="33" style="v"/>tau tatkShaNAdutthAya yirUshAlamapuraM pratyAyayatuH, tatsthAne shiShyANAm ekAdashAnAM sa NginA ncha darshanaM jAtaM|</para>
  <para style="p">
    <verse number="34" style="v"/>te prochuH prabhurudatiShThad iti satyaM shimone darshanamadAchcha|</para>
  <para style="p">
    <verse number="35" style="v"/>tataH pathaH sarvvaghaTanAyAH pUpabha njanena tatparichayasya cha sarvvavR^ittAntaM tau vaktumArebhAte|</para>
  <para style="p">
    <verse number="36" style="v"/>itthaM te parasparaM vadanti tatkAle yIshuH svayaM teShAM madhya protthaya yuShmAkaM kalyANaM bhUyAd ityuvAcha,</para>
  <para style="p">
    <verse number="37" style="v"/>kintu bhUtaM pashyAma ityanumAya te samudvivijire treShushcha|</para>
  <para style="p">
    <verse number="38" style="v"/>sa uvAcha, kuto duHkhitA bhavatha? yuShmAkaM manaHsu sandeha udeti cha kutaH?</para>
  <para style="p">
    <verse number="39" style="v"/>eShohaM, mama karau pashyata varaM spR^iShTvA pashyata, mama yAdR^ishAni pashyatha tAdR^ishAni bhUtasya mAMsAsthIni na santi|</para>
  <para style="p">
    <verse number="40" style="v"/>ityuktvA sa hastapAdAn darshayAmAsa|</para>
  <para style="p">
    <verse number="41" style="v"/>te.asambhavaM j nAtvA sAnandA na pratyayan| tataH sa tAn paprachCha, atra yuShmAkaM samIpe khAdyaM ki nchidasti?</para>
  <para style="p">
    <verse number="42" style="v"/>tataste kiyaddagdhamatsyaM madhu cha daduH</para>
  <para style="p">
    <verse number="43" style="v"/>sa tadAdAya teShAM sAkShAd bubhuje</para>
  <para style="p">
    <verse number="44" style="v"/>kathayAmAsa cha mUsAvyavasthAyAM bhaviShyadvAdinAM grantheShu gItapustake cha mayi yAni sarvvANi vachanAni likhitAni tadanurUpANi ghaTiShyante yuShmAbhiH sArddhaM sthitvAhaM yadetadvAkyam avadaM tadidAnIM pratyakShamabhUt|</para>
  <para style="p">
    <verse number="45" style="v"/>atha tebhyaH shAstrabodhAdhikAraM datvAvadat,</para>
  <para style="p">
    <verse number="46" style="v"/>khrIShTenetthaM mR^itiyAtanA bhoktavyA tR^itIyadine cha shmashAnAdutthAtavya ncheti lipirasti;</para>
  <para style="p">
    <verse number="47" style="v"/>tannAmnA yirUshAlamamArabhya sarvvadeshe manaHparAvarttanasya pApamochanasya cha susaMvAdaH prachArayitavyaH,</para>
  <para style="p">
    <verse number="48" style="v"/>eShu sarvveShu yUyaM sAkShiNaH|</para>
  <para style="p">
    <verse number="49" style="v"/>apara ncha pashyata pitrA yat pratij nAtaM tat preShayiShyAmi, ataeva yAvatkAlaM yUyaM svargIyAM shaktiM na prApsyatha tAvatkAlaM yirUshAlamnagare tiShThata|</para>
  <para style="p">
    <verse number="50" style="v"/>atha sa tAn baithanIyAparyyantaM nItvA hastAvuttolya AshiSha vaktumArebhe</para>
  <para style="p">
    <verse number="51" style="v"/>AshiShaM vadanneva cha tebhyaH pR^ithag bhUtvA svargAya nIto.abhavat|</para>
  <para style="p">
    <verse number="52" style="v"/>tadA te taM bhajamAnA mahAnandena yirUshAlamaM pratyAjagmuH|</para>
  <para style="p">
    <verse number="53" style="v"/>tato nirantaraM mandire tiShThanta Ishvarasya prashaMsAM dhanyavAda ncha karttam Arebhire| iti||</para>
</usx>
