  <para style="h">Philemon</para>
  <para style="toc1">philomonaM patraM</para>
  <para style="toc2">philomonaH</para>
  <para style="toc3">philomonaH</para>
  <para style="mt1">philomonaM patraM</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>khrIShTasya yIsho rbandidAsaH paulastIthiyanAmA bhrAtA cha priyaM sahakAriNaM philImonaM</para>
  <para style="p">
    <verse number="2" style="v"/>priyAm AppiyAM sahasenAm ArkhippaM philImonasya gR^ihe sthitAM samiti ncha prati patraM likhataH|</para>
  <para style="p">
    <verse number="3" style="v"/>asmAkaM tAta IshvaraH prabhu ryIshukhrIShTashcha yuShmAn prati shAntim anugraha ncha kriyAstAM|</para>
  <para style="p">
    <verse number="4" style="v"/>prabhuM yIshuM prati sarvvAn pavitralokAn prati cha tava premavishvAsayo rvR^ittAntaM nishamyAhaM</para>
  <para style="p">
    <verse number="5" style="v"/>prArthanAsamaye tava nAmochchArayan nirantaraM mameshvaraM dhanyaM vadAmi|</para>
  <para style="p">
    <verse number="6" style="v"/>asmAsu yadyat saujanyaM vidyate tat sarvvaM khrIShTaM yIshuM yat prati bhavatIti j nAnAya tava vishvAsamUlikA dAnashIlatA yat saphalA bhavet tadaham ichChAmi|</para>
  <para style="p">
    <verse number="7" style="v"/>he bhrAtaH, tvayA pavitralokAnAM prANa ApyAyitA abhavan etasmAt tava premnAsmAkaM mahAn AnandaH sAntvanA cha jAtaH|</para>
  <para style="p">
    <verse number="8" style="v"/>tvayA yat karttavyaM tat tvAm Aj nApayituM yadyapyahaM khrIShTenAtIvotsuko bhaveyaM tathApi vR^iddha</para>
  <para style="p">
    <verse number="9" style="v"/>idAnIM yIshukhrIShTasya bandidAsashchaivambhUto yaH paulaH so.ahaM tvAM vinetuM varaM manye|</para>
  <para style="p">
    <verse number="10" style="v"/>ataH shR^i Nkhalabaddho.ahaM yamajanayaM taM madIyatanayam onIShimam adhi tvAM vinaye|</para>
  <para style="p">
    <verse number="11" style="v"/>sa pUrvvaM tavAnupakAraka AsIt kintvidAnIM tava mama chopakArI bhavati|</para>
  <para style="p">
    <verse number="12" style="v"/>tamevAhaM tava samIpaM preShayAmi, ato madIyaprANasvarUpaH sa tvayAnugR^ihyatAM|</para>
  <para style="p">
    <verse number="13" style="v"/>susaMvAdasya kR^ite shR^i Nkhalabaddho.ahaM parichArakamiva taM svasannidhau varttayitum aichChaM|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu tava saujanyaM yad balena na bhUtvA svechChAyAH phalaM bhavet tadarthaM tava sammatiM vinA kimapi karttavyaM nAmanye|</para>
  <para style="p">
    <verse number="15" style="v"/>ko jAnAti kShaNakAlArthaM tvattastasya vichChedo.abhavad etasyAyam abhiprAyo yat tvam anantakAlArthaM taM lapsyase</para>
  <para style="p">
    <verse number="16" style="v"/>puna rdAsamiva lapsyase tannahi kintu dAsAt shreShThaM mama priyaM tava cha shArIrikasambandhAt prabhusambandhAchcha tato.adhikaM priyaM bhrAtaramiva|</para>
  <para style="p">
    <verse number="17" style="v"/>ato heto ryadi mAM sahabhAginaM jAnAsi tarhi mAmiva tamanugR^ihANa|</para>
  <para style="p">
    <verse number="18" style="v"/>tena yadi tava kimapyaparAddhaM tubhyaM kimapi dhAryyate vA tarhi tat mameti viditvA gaNaya|</para>
  <para style="p">
    <verse number="19" style="v"/>ahaM tat parishotsyAmi, etat paulo.ahaM svahastena likhAmi, yatastvaM svaprANAn api mahyaM dhArayasi tad vaktuM nechChAmi|</para>
  <para style="p">
    <verse number="20" style="v"/>bho bhrAtaH, prabhoH kR^ite mama vA nChAM pUraya khrIShTasya kR^ite mama prANAn ApyAyaya|</para>
  <para style="p">
    <verse number="21" style="v"/>tavAj nAgrAhitve vishvasya mayA etat likhyate mayA yaduchyate tato.adhikaM tvayA kAriShyata iti jAnAmi|</para>
  <para style="p">
    <verse number="22" style="v"/>tatkaraNasamaye madarthamapi vAsagR^ihaM tvayA sajjIkriyatAM yato yuShmAkaM prArthanAnAM phalarUpo vara ivAhaM yuShmabhyaM dAyiShye mameti pratyAshA jAyate|</para>
  <para style="p">
    <verse number="23" style="v"/>khrIShTasya yIshAH kR^ite mayA saha bandiripAphrA</para>
  <para style="p">
    <verse number="24" style="v"/>mama sahakAriNo mArka AriShTArkho dImA lUkashcha tvAM namaskAraM vedayanti|</para>
  <para style="p">
    <verse number="25" style="v"/>asmAkaM prabho ryIshukhrIShTasyAnugraho yuShmAkam AtmanA saha bhUyAt| Amen|</para>
</usx>
