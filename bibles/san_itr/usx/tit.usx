  <para style="h">Titus</para>
  <para style="toc1">tItaM patraM</para>
  <para style="toc2">tItaH</para>
  <para style="toc3">tItaH</para>
  <para style="mt1">tItaM patraM</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantajIvanasyAshAto jAtAyA Ishvarabhakte ryogyasya satyamatasya yat tatvaj nAnaM yashcha vishvAsa IshvarasyAbhiruchitalokai rlabhyate tadarthaM</para>
  <para style="p">
    <verse number="2" style="v"/>yIshukhrIShTasya prerita Ishvarasya dAsaH paulo.ahaM sAdhAraNavishvAsAt mama prakR^itaM dharmmaputraM tItaM prati likhami|</para>
  <para style="p">
    <verse number="3" style="v"/>niShkapaTa Ishvara AdikAlAt pUrvvaM tat jIvanaM pratij nAtavAn svanirUpitasamaye cha ghoShaNayA tat prakAshitavAn|</para>
  <para style="p">
    <verse number="4" style="v"/>mama trAturIshvarasyAj nayA cha tasya ghoShaNaM mayi samarpitam abhUt| asmAkaM tAta IshvaraH paritrAtA prabhu ryIshukhrIShTashcha tubhyam anugrahaM dayAM shAnti ncha vitaratu|</para>
  <para style="p">
    <verse number="5" style="v"/>tvaM yad asampUrNakAryyANi sampUraye rmadIyAdeshAchcha pratinagaraM prAchInagaNAn niyojayestadarthamahaM tvAM krItyupadvIpe sthApayitvA gatavAn|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmAd yo naro .anindita ekasyA yoShitaH svAmI vishvAsinAm apachayasyAvAdhyatvasya vA doSheNAliptAnA ncha santAnAnAM janako bhavati sa eva yogyaH|</para>
  <para style="p">
    <verse number="7" style="v"/>yato hetoradyakSheNeshvarasya gR^ihAdyakSheNevAnindanIyena bhavitavyaM| tena svechChAchAriNA krodhinA pAnAsaktena prahArakeNa lobhinA vA na bhavitavyaM</para>
  <para style="p">
    <verse number="8" style="v"/>kintvatithisevakena sallokAnurAgiNA vinItena nyAyyena dhArmmikeNa jitendriyeNa cha bhavitavyaM,</para>
  <para style="p">
    <verse number="9" style="v"/>upadeshe cha vishvastaM vAkyaM tena dhAritavyaM yataH sa yad yathArthenopadeshena lokAn vinetuM vighnakAriNashcha niruttarAn karttuM shaknuyAt tad AvashyakaM|</para>
  <para style="p">
    <verse number="10" style="v"/>yataste bahavo .avAdhyA anarthakavAkyavAdinaH prava nchakAshcha santi visheShatashChinnatvachAM madhye kechit tAdR^ishA lokAH santi|</para>
  <para style="p">
    <verse number="11" style="v"/>teShA ncha vAgrodha Avashyako yataste kutsitalAbhasyAshayAnuchitAni vAkyAni shikShayanto nikhilaparivArANAM sumatiM nAshayanti|</para>
  <para style="p">
    <verse number="12" style="v"/>teShAM svadeshIya eko bhaviShyadvAdI vachanamidamuktavAn, yathA, krItIyamAnavAH sarvve sadA kApaTyavAdinaH| hiMsrajantusamAnAste .alasAshchodarabhArataH||</para>
  <para style="p">
    <verse number="13" style="v"/>sAkShyametat tathyaM, atoे hetostvaM tAn gADhaM bhartsaya te cha yathA vishvAse svasthA bhaveyu</para>
  <para style="p">
    <verse number="14" style="v"/>ryihUdIyopAkhyAneShu satyamatabhraShTAnAM mAnavAnAm Aj nAsu cha manAMsi na niveshayeyustathAdisha|</para>
  <para style="p">
    <verse number="15" style="v"/>shuchInAM kR^ite sarvvANyeva shuchIni bhavanti kintu kala NkitAnAm avishvAsinA ncha kR^ite shuchi kimapi na bhavati yatasteShAM buddhayaH saMvedAshcha kala NkitAH santi|</para>
  <para style="p">
    <verse number="16" style="v"/>Ishvarasya j nAnaM te pratijAnanti kintu karmmabhistad ana NgIkurvvate yataste garhitA anAj nAgrAhiNaH sarvvasatkarmmaNashchAyogyAH santi|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yathArthasyopadeshasya vAkyAni tvayA kathyantAM</para>
  <para style="p">
    <verse number="2" style="v"/>visheShataH prAchInalokA yathA prabuddhA dhIrA vinItA vishvAse premni sahiShNutAyA ncha svasthA bhaveyustadvat</para>
  <para style="p">
    <verse number="3" style="v"/>prAchInayoShito.api yathA dharmmayogyam AchAraM kuryyuH paranindakA bahumadyapAnasya nighnAshcha na bhaveyuH</para>
  <para style="p">
    <verse number="4" style="v"/>kintu sushikShAkAriNyaH satya Ishvarasya vAkyaM yat na nindyeta tadarthaM yuvatIH sushIlatAm arthataH patisneham apatyasnehaM</para>
  <para style="p">
    <verse number="5" style="v"/>vinItiM shuchitvaM gR^ihiNItvaM saujanyaM svAminighna nchAdisheyustathA tvayA kathyatAM|</para>
  <para style="p">
    <verse number="6" style="v"/>tadvad yUno.api vinItaye prabodhaya|</para>
  <para style="p">
    <verse number="7" style="v"/>tva ncha sarvvaviShaye svaM satkarmmaNAM dR^iShTAntaM darshaya shikShAyA nchAvikR^itatvaM dhIratAM yathArthaM</para>
  <para style="p">
    <verse number="8" style="v"/>nirddoSha ncha vAkyaM prakAshaya tena vipakSho yuShmAkam apavAdasya kimapi ChidraM na prApya trapiShyate|</para>
  <para style="p">
    <verse number="9" style="v"/>dAsAshcha yat svaprabhUnAM nighnAH sarvvaviShaye tuShTijanakAshcha bhaveyuH pratyuttaraM na kuryyuH</para>
  <para style="p">
    <verse number="10" style="v"/>kimapi nApahareyuH kintu pUrNAM suvishvastatAM prakAshayeyuriti tAn Adisha| yata evamprakAreNAsmakaM trAturIshvarasya shikShA sarvvaviShaye tai rbhUShitavyA|</para>
  <para style="p">
    <verse number="11" style="v"/>yato hetostrANAjanaka IshvarasyAnugrahaH sarvvAn mAnavAn pratyuditavAn</para>
  <para style="p">
    <verse number="12" style="v"/>sa chAsmAn idaM shikShyati yad vayam adharmmaM sAMsArikAbhilAShAMshchAna NgIkR^itya vinItatvena nyAyeneshvarabhaktyA chehaloke Ayu ryApayAmaH,</para>
  <para style="p">
    <verse number="13" style="v"/>paramasukhasyAshAm arthato .asmAkaM mahata Ishvarasya trANakarttu ryIshukhrIShTasya prabhAvasyodayaM pratIkShAmahe|</para>
  <para style="p">
    <verse number="14" style="v"/>yataH sa yathAsmAn sarvvasmAd adharmmAt mochayitvA nijAdhikArasvarUpaM satkarmmasUtsukam ekaM prajAvargaM pAvayet tadartham asmAkaM kR^ite AtmadAnaM kR^itavAn|</para>
  <para style="p">
    <verse number="15" style="v"/>etAni bhAShasva pUrNasAmarthyena chAdisha prabodhaya cha, ko.api tvAM nAvamanyatAM|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>te yathA deshAdhipAnAM shAsakAnA ncha nighnA Aj nAgrAhiNshcha sarvvasmai satkarmmaNe susajjAshcha bhaveyuH</para>
  <para style="p">
    <verse number="2" style="v"/>kamapi na nindeyu rnivvirodhinaH kShAntAshcha bhaveyuH sarvvAn prati cha pUrNaM mR^idutvaM prakAshayeyushcheti tAn Adisha|</para>
  <para style="p">
    <verse number="3" style="v"/>yataH pUrvvaM vayamapi nirbbodhA anAj nAgrAhiNo bhrAntA nAnAbhilAShANAM sukhAnA ncha dAseyA duShTatverShyAchAriNo ghR^iNitAH parasparaM dveShiNashchAbhavAmaH|</para>
  <para style="p">
    <verse number="4" style="v"/>kintvasmAkaM trAturIshvarasya yA dayA marttyAnAM prati cha yA prItistasyAH prAdurbhAve jAte</para>
  <para style="p">
    <verse number="5" style="v"/>vayam AtmakR^itebhyo dharmmakarmmabhyastannahi kintu tasya kR^ipAtaH punarjanmarUpeNa prakShAlanena pravitrasyAtmano nUtanIkaraNena cha tasmAt paritrANAM prAptAH</para>
  <para style="p">
    <verse number="6" style="v"/>sa chAsmAkaM trAtrA yIshukhrIShTenAsmadupari tam AtmAnaM prachuratvena vR^iShTavAn|</para>
  <para style="p">
    <verse number="7" style="v"/>itthaM vayaM tasyAnugraheNa sapuNyIbhUya pratyAshayAnantajIvanasyAdhikAriNo jAtAH|</para>
  <para style="p">
    <verse number="8" style="v"/>vAkyametad vishvasanIyam ato hetorIshvare ye vishvasitavantaste yathA satkarmmANyanutiShTheyustathA tAn dR^iDham Aj nApayeti mamAbhimataM|tAnyevottamAni mAnavebhyaH phaladAni cha bhavanti|</para>
  <para style="p">
    <verse number="9" style="v"/>mUDhebhyaH prashnavaMshAvalivivAdebhyo vyavasthAyA vitaNDAbhyashcha nivarttasva yatastA niShphalA anarthakAshcha bhavanti|</para>
  <para style="p">
    <verse number="10" style="v"/>yo jano bibhitsustam ekavAraM dvirvvA prabodhya dUrIkuru,</para>
  <para style="p">
    <verse number="11" style="v"/>yatastAdR^isho jano vipathagAmI pApiShTha AtmadoShakashcha bhavatIti tvayA j nAyatAM|</para>
  <para style="p">
    <verse number="12" style="v"/>yadAham ArttimAM tukhikaM vA tava samIpaM preShayiShyAmi tadA tvaM nIkapalau mama samIpam AgantuM yatasva yatastatraivAhaM shItakAlaM yApayituM matim akArShaM|</para>
  <para style="p">
    <verse number="13" style="v"/>vyavasthApakaH sInA ApallushchaitayoH kasyApyabhAvo yanna bhavet tadarthaM tau yatnena tvayA visR^ijyetAM|</para>
  <para style="p">
    <verse number="14" style="v"/>aparam asmadIyalokA yanniShphalA na bhaveyustadarthaM prayojanIyopakArAyA satkarmmANyanuShThAtuM shikShantAM|</para>
  <para style="p">
    <verse number="15" style="v"/>mama sa NginaH savve tvAM namaskurvvate| ye vishvAsAd asmAsu prIyante tAn namaskuru; sarvveShu yuShmAsvanugraho bhUyAt| Amen|</para>
</usx>
