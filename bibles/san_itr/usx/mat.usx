  <para style="h">Matthew</para>
  <para style="toc1">mathilikhitaH susaMvAdaH</para>
  <para style="toc2">mathiH</para>
  <para style="toc3">mathiH</para>
  <para style="mt1">mathilikhitaH susaMvAdaH</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ibrAhImaH santAno dAyUd tasya santAno yIshukhrIShTastasya pUrvvapuruShavaMshashreNI|</para>
  <para style="p">
    <verse number="2" style="v"/>ibrAhImaH putra ishAk tasya putro yAkUb tasya putro yihUdAstasya bhrAtarashcha|</para>
  <para style="p">
    <verse number="3" style="v"/>tasmAd yihUdAtastAmaro garbhe perasserahau jaj nAte, tasya perasaH putro hiShroN tasya putro .arAm|</para>
  <para style="p">
    <verse number="4" style="v"/>tasya putro .ammInAdab tasya putro nahashon tasya putraH salmon|</para>
  <para style="p">
    <verse number="5" style="v"/>tasmAd rAhabo garbhe boyam jaj ne, tasmAd rUto garbhe obed jaj ne, tasya putro yishayaH|</para>
  <para style="p">
    <verse number="6" style="v"/>tasya putro dAyUd rAjaH tasmAd mR^itoriyasya jAyAyAM sulemAn jaj ne|</para>
  <para style="p">
    <verse number="7" style="v"/>tasya putro rihabiyAm, tasya putro.abiyaH, tasya putra AsA:|</para>
  <para style="p">
    <verse number="8" style="v"/>tasya suto yihoshAphaT tasya suto yihorAma tasya suta uShiyaH|</para>
  <para style="p">
    <verse number="9" style="v"/>tasya suto yotham tasya suta Aham tasya suto hiShkiyaH|</para>
  <para style="p">
    <verse number="10" style="v"/>tasya suto minashiH, tasya suta Amon tasya suto yoshiyaH|</para>
  <para style="p">
    <verse number="11" style="v"/>bAbilnagare pravasanAt pUrvvaM sa yoshiyo yikhaniyaM tasya bhrAtR^iMshcha janayAmAsa|</para>
  <para style="p">
    <verse number="12" style="v"/>tato bAbili pravasanakAle yikhaniyaH shaltIyelaM janayAmAsa, tasya sutaH sirubbAvil|</para>
  <para style="p">
    <verse number="13" style="v"/>tasya suto .abohud tasya suta ilIyAkIm tasya suto.asor|</para>
  <para style="p">
    <verse number="14" style="v"/>asoraH sutaH sAdok tasya suta AkhIm tasya suta ilIhUd|</para>
  <para style="p">
    <verse number="15" style="v"/>tasya suta iliyAsar tasya suto mattan|</para>
  <para style="p">
    <verse number="16" style="v"/>tasya suto yAkUb tasya suto yUShaph tasya jAyA mariyam; tasya garbhe yIshurajani, tameva khrIShTam (arthAd abhiShiktaM) vadanti|</para>
  <para style="p">
    <verse number="17" style="v"/>ittham ibrAhImo dAyUdaM yAvat sAkalyena chaturdashapuruShAH; A dAyUdaH kAlAd bAbili pravasanakAlaM yAvat chaturdashapuruShA bhavanti| bAbili pravAsanakAlAt khrIShTasya kAlaM yAvat chaturdashapuruShA bhavanti|</para>
  <para style="p">
    <verse number="18" style="v"/>yIshukhrIShTasya janma kaththate| mariyam nAmikA kanyA yUShaphe vAgdattAsIt, tadA tayoH sa NgamAt prAk sA kanyA  pavitreNAtmanA garbhavatI babhUva|</para>
  <para style="p">
    <verse number="19" style="v"/>tatra tasyAH pati ryUShaph saujanyAt tasyAH kala NgaM prakAshayitum anichChan gopanene tAM pArityaktuM manashchakre|</para>
  <para style="p">
    <verse number="20" style="v"/>sa tathaiva bhAvayati, tadAnIM parameshvarasya dUtaH svapne taM darshanaM dattvA vyAjahAra, he dAyUdaH santAna yUShaph tvaM nijAM jAyAM mariyamam AdAtuM mA bhaiShIH|</para>
  <para style="p">
    <verse number="21" style="v"/>yatastasyA garbhaH pavitrAdAtmano.abhavat, sA cha putraM prasaviShyate, tadA tvaM tasya nAma yIshum (arthAt trAtAraM) karIShyase, yasmAt sa nijamanujAn teShAM kaluShebhya uddhariShyati|</para>
  <para style="p">
    <verse number="22" style="v"/>itthaM sati, pashya garbhavatI kanyA tanayaM prasaviShyate| immAnUyel tadIya ncha nAmadheyaM bhaviShyati|| immAnUyel asmAkaM sa NgIshvara_ityarthaH|</para>
  <para style="p">
    <verse number="23" style="v"/>iti yad vachanaM purvvaM bhaviShyadvaktrA IshvaraH kathAyAmAsa, tat tadAnIM siddhamabhavat|</para>
  <para style="p">
    <verse number="24" style="v"/>anantaraM yUShaph nidrAto jAgarita utthAya parameshvarIyadUtasya nideshAnusAreNa nijAM jAyAM jagrAha,</para>
  <para style="p">
    <verse number="25" style="v"/>kintu yAvat sA nijaM prathamasutaM a suShuve, tAvat tAM nopAgachChat, tataH sutasya nAma yIshuM chakre|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM herod saMj nake rAj ni rAjyaM shAsati yihUdIyadeshasya baitlehami nagare yIshau jAtavati cha, katipayA jyotirvvudaH pUrvvasyA disho yirUshAlamnagaraM sametya kathayamAsuH,</para>
  <para style="p">
    <verse number="2" style="v"/>yo yihUdIyAnAM rAjA jAtavAn, sa kutrAste? vayaM pUrvvasyAM dishi tiShThantastadIyAM tArakAm apashyAma tasmAt taM praNantum aाgamAma|</para>
  <para style="p">
    <verse number="3" style="v"/>tadA herod rAjA kathAmetAM nishamya yirUshAlamnagarasthitaiH sarvvamAnavaiH sArddham udvijya</para>
  <para style="p">
    <verse number="4" style="v"/>sarvvAn pradhAnayAjakAn adhyApakAMshcha samAhUyAnIya paprachCha, khrIShTaH kutra janiShyate?</para>
  <para style="p">
    <verse number="5" style="v"/>tadA te kathayAmAsuH, yihUdIyadeshasya baitlehami nagare, yato bhaviShyadvAdinA itthaM likhitamAste,</para>
  <para style="p">
    <verse number="6" style="v"/>sarvvAbhyo rAjadhAnIbhyo yihUdIyasya nIvR^itaH| he yIhUdIyadeshasye baitleham tvaM na chAvarA|isrAyelIyalokAn me yato yaH pAlayiShyati| tAdR^igeko mahArAjastvanmadhya udbhaviShyatI||</para>
  <para style="p">
    <verse number="7" style="v"/>tadAnIM herod rAjA tAn jyotirvvido gopanam AhUya sA tArakA kadA dR^iShTAbhavat , tad vinishchayAmAsa|</para>
  <para style="p">
    <verse number="8" style="v"/>aparaM tAn baitlehamaM prahItya gaditavAn, yUyaM yAta, yatnAt taM shishum anviShya taduddeshe prApte mahyaM vArttAM dAsyatha, tato mayApi gatvA sa praNaMsyate|</para>
  <para style="p">
    <verse number="9" style="v"/>tadAnIM rAj na etAdR^ishIm Aj nAM prApya te pratasthire, tataH pUrvvarsyAM dishi sthitaistai ryA tArakA dR^iShTA sA tArakA teShAmagre gatvA yatra sthAne shishUrAste, tasya sthAnasyopari sthagitA tasyau|</para>
  <para style="p">
    <verse number="10" style="v"/>tad dR^iShTvA te mahAnanditA babhUvuH,</para>
  <para style="p">
    <verse number="11" style="v"/>tato gehamadhya pravishya tasya mAtrA mariyamA sAddhaM taM shishuM nirIkShaya daNDavad bhUtvA praNemuH, aparaM sveShAM ghanasampattiM mochayitvA suvarNaM kunduruM gandharama ncha tasmai darshanIyaM dattavantaH|</para>
  <para style="p">
    <verse number="12" style="v"/>pashchAd herod rAjasya samIpaM punarapi gantuM svapna IshvareNa niShiddhAH santo .anyena pathA te nijadeshaM prati pratasthire|</para>
  <para style="p">
    <verse number="13" style="v"/>anantaraM teShu gatavatmu parameshvarasya dUto yUShaphe svapne darshanaM datvA jagAda, tvam utthAya shishuM tanmAtara ncha gR^ihItvA misardeshaM palAyasva, aparaM yAvadahaM tubhyaM vArttAM na kathayiShyAmi, tAvat tatraiva nivasa, yato rAjA herod shishuM nAshayituM mR^igayiShyate|</para>
  <para style="p">
    <verse number="14" style="v"/>tadAnIM yUShaph utthAya rajanyAM shishuM tanmAtara ncha gR^ihItvA misardeshaM prati pratasthe,</para>
  <para style="p">
    <verse number="15" style="v"/>gatvA cha herodo nR^ipate rmaraNaparyyantaM tatra deshe nyuvAsa, tena misardeshAdahaM putraM svakIyaM samupAhUyam| yadetadvachanam IshvareNa bhaviShyadvAdinA kathitaM tat saphalamabhUt|</para>
  <para style="p">
    <verse number="16" style="v"/>anantaraM herod jyotirvidbhirAtmAnaM prava nchitaM vij nAya bhR^ishaM chukopa; aparaM jyotirvvidbhyastena vinishchitaM yad dinaM taddinAd gaNayitvA dvitIyavatsaraM praviShTA yAvanto bAlakA asmin baitlehamnagare tatsImamadhye chAsan, lokAn prahitya tAn sarvvAn ghAtayAmAsa|</para>
  <para style="p">
    <verse number="17" style="v"/>ataH anekasya vilApasya ninAda: krandanasya cha| shokena kR^itashabdashcha rAmAyAM saMnishamyate| svabAlagaNahetorvai rAhel nArI tu rodinI| na manyate prabodhantu yataste naiva manti hi||</para>
  <para style="p">
    <verse number="18" style="v"/>yadetad vachanaM yirImiyanAmakabhaviShyadvAdinA kathitaM tat tadAnIM saphalam abhUt|</para>
  <para style="p">
    <verse number="19" style="v"/>tadanantaraM heredi rAjani mR^ite parameshvarasya dUto misardeshe svapne darshanaM dattvA yUShaphe kathitavAn</para>
  <para style="p">
    <verse number="20" style="v"/>tvam utthAya shishuM tanmAtara ncha gR^ihItvA punarapIsrAyelo deshaM yAhI, ye janAH shishuM nAshayitum amR^igayanta, te mR^itavantaH|</para>
  <para style="p">
    <verse number="21" style="v"/>tadAnIM sa utthAya shishuM tanmAtara ncha gR^ihlan isrAyeldesham AjagAma|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu yihUdIyadeshe arkhilAyanAma rAjakumAro nijapitu rherodaH padaM prApya rAjatvaM karotIti nishamya tat sthAnaM yAtuM sha NkitavAn, pashchAt svapna IshvarAt prabodhaM prApya gAlIldeshasya pradeshaikaM prasthAya nAsarannAma nagaraM gatvA tatra nyuShitavAn,</para>
  <para style="p">
    <verse number="23" style="v"/>tena taM nAsaratIyaM kathayiShyanti, yadetadvAkyaM bhaviShyadvAdibhirukttaM tat saphalamabhavat|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadAnoM yohnnAmA majjayitA yihUdIyadeshasya prAntaram upasthAya prachArayan kathayAmAsa,</para>
  <para style="p">
    <verse number="2" style="v"/>manAMsi parAvarttayata, svargIyarAjatvaM samIpamAgatam|</para>
  <para style="p">
    <verse number="3" style="v"/>parameshasya panthAnaM pariShkuruta sarvvataH| tasya rAjapathAMshchaiva samIkuruta sarvvathA| ityetat prAntare vAkyaM vadataH kasyachid ravaH||</para>
  <para style="p">
    <verse number="4" style="v"/>etadvachanaM yishayiyabhaviShyadvAdinA yohanamuddishya bhAShitam| yohano vasanaM mahA NgaromajaM tasya kaTau charmmakaTibandhanaM; sa cha shUkakITAn madhu cha bhuktavAn|</para>
  <para style="p">
    <verse number="5" style="v"/>tadAnIM yirUshAlamnagaranivAsinaH sarvve yihUdideshIyA yarddantaTinyA ubhayataTasthAshcha mAnavA bahirAgatya tasya samIpe</para>
  <para style="p">
    <verse number="6" style="v"/>svIyaM svIyaM duritam a NgIkR^itya tasyAM yarddani tena majjitA babhUvuH|</para>
  <para style="p">
    <verse number="7" style="v"/>aparaM bahUn phirUshinaH sidUkinashcha manujAn maMktuM svasamIpam AgachChto vilokya sa tAn abhidadhau, re re bhujagavaMshA AgAmInaH kopAt palAyituM yuShmAn kashchetitavAn?</para>
  <para style="p">
    <verse number="8" style="v"/>manaHparAvarttanasya samuchitaM phalaM phalata|</para>
  <para style="p">
    <verse number="9" style="v"/>kintvasmAkaM tAta ibrAhIm astIti sveShu manaHsu chIntayanto mA vyAharata| yato yuShmAn ahaM vadAmi, Ishvara etebhyaH pAShANebhya ibrAhImaH santAnAn utpAdayituM shaknoti|</para>
  <para style="p">
    <verse number="10" style="v"/>aparaM pAdapAnAM mUle kuThAra idAnImapi lagan Aste, tasmAd yasmin pAdape uttamaM phalaM na bhavati, sa kR^itto madhye.agniM nikShepsyate|</para>
  <para style="p">
    <verse number="11" style="v"/>aparam ahaM manaHparAvarttanasUchakena majjanena yuShmAn majjayAmIti satyaM, kintu mama pashchAd ya AgachChati, sa mattopi mahAn, ahaM tadIyopAnahau voDhumapi nahi yogyosmi, sa yuShmAn vahnirUpe pavitra Atmani saMmajjayiShyati|</para>
  <para style="p">
    <verse number="12" style="v"/>tasya kAre sUrpa Aste, sa svIyashasyAni samyak prasphoTya nijAn sakalagodhUmAn saMgR^ihya bhANDAgAre sthApayiShyati, kiMntu sarvvANi vuShANyanirvvANavahninA dAhayiShyati|</para>
  <para style="p">
    <verse number="13" style="v"/>anantaraM yIshu ryohanA majjito bhavituM gAlIlpradeshAd yarddani tasya samIpam AjagAma|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu yohan taM niShidhya babhAShe, tvaM kiM mama samIpam AgachChasi? varaM tvayA majjanaM mama prayojanam Aste|</para>
  <para style="p">
    <verse number="15" style="v"/>tadAnIM yIshuH pratyavochat; IdAnIm anumanyasva, yata itthaM sarvvadharmmasAdhanam asmAkaM karttavyaM, tataH so.anvamanyata|</para>
  <para style="p">
    <verse number="16" style="v"/>anantaraM yIshurammasi majjituH san tatkShaNAt toyamadhyAd utthAya jagAma, tadA jImUtadvAre mukte jAte, sa IshvarasyAtmAnaM kapotavad avaruhya svoparyyAgachChantaM vIkShA nchakre|</para>
  <para style="p">
    <verse number="17" style="v"/>aparam eSha mama priyaH putra etasminneva mama mahAsantoSha etAdR^ishI vyomajA vAg babhUva|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataH paraM yIshuH pratArakeNa parIkShito bhavitum AtmanA prAntaram AkR^iShTaH</para>
  <para style="p">
    <verse number="2" style="v"/>san chatvAriMshadahorAtrAn anAhArastiShThan kShudhito babhUva|</para>
  <para style="p">
    <verse number="3" style="v"/>tadAnIM parIkShitA tatsamIpam Agatya vyAhR^itavAn, yadi tvamIshvarAtmajo bhavestarhyAj nayA pAShANAnetAn pUpAn vidhehi|</para>
  <para style="p">
    <verse number="4" style="v"/>tataH sa pratyabravIt, itthaM likhitamAste, "manujaH kevalapUpena na jIviShyati, kintvIshvarasya vadanAd yAni yAni vachAMsi niHsaranti taireva jIviShyati|"</para>
  <para style="p">
    <verse number="5" style="v"/>tadA pratArakastaM puNyanagaraM nItvA mandirasya chUDopari nidhAya gaditavAn,</para>
  <para style="p">
    <verse number="6" style="v"/>tvaM yadishvarasya tanayo bhavestarhIto.adhaH pata, yata itthaM likhitamAste, AdekShyati nijAn dUtAn rakShituM tvAM parameshvaraH| yathA sarvveShu mArgeShu tvadIyacharaNadvaye| na laget prastarAghAtastvAM ghariShyanti te karaiH||</para>
  <para style="p">
    <verse number="7" style="v"/>tadAnIM yIshustasmai kathitavAn etadapi likhitamAste, "tvaM nijaprabhuM parameshvaraM mA parIkShasva|"</para>
  <para style="p">
    <verse number="8" style="v"/>anantaraM pratArakaH punarapi tam atyu nchadharAdharopari nItvA jagataH sakalarAjyAni tadaishvaryyANi cha darshayAshchakAra kathayA nchakAra cha,</para>
  <para style="p">
    <verse number="9" style="v"/>yadi tvaM daNDavad bhavan mAM praNamestarhyaham etAni tubhyaM pradAsyAmi|</para>
  <para style="p">
    <verse number="10" style="v"/>tadAnIM yIshustamavochat, dUrIbhava pratAraka, likhitamidam Aste, "tvayA nijaH prabhuH parameshvaraH praNamyaH kevalaH sa sevyashcha|"</para>
  <para style="p">
    <verse number="11" style="v"/>tataH pratArakeNa sa paryyatyAji, tadA svargIyadUtairAgatya sa siSheve|</para>
  <para style="p">
    <verse number="12" style="v"/>tadanantaraM yohan kArAyAM babandhe, tadvArttAM nishamya yIshunA gAlIl prAsthIyata|</para>
  <para style="p">
    <verse number="13" style="v"/>tataH paraM sa nAsarannagaraM vihAya jalaghestaTe sibUlUnnaptAlI etayoruvabhayoH pradeshayoH sImnormadhyavarttI ya: kapharnAhUm tannagaram itvA nyavasat|</para>
  <para style="p">
    <verse number="14" style="v"/>tasmAt, anyAdeshIyagAlIli yarddanpAre.abdhirodhasi| naptAlisibUlUndeshau yatra sthAne sthitau purA|</para>
  <para style="p">
    <verse number="15" style="v"/>tatratyA manujA ye ye paryyabhrAmyan tamisrake| tairjanairbR^ihadAlokaH paridarshiShyate tadA| avasan ye janA deshe mR^ityuchChAyAsvarUpake| teShAmupari lokAnAmAlokaH saMprakAshitaH||</para>
  <para style="p">
    <verse number="16" style="v"/>yadetadvachanaM yishayiyabhaviShyadvAdinA proktaM, tat tadA saphalam abhUt|</para>
  <para style="p">
    <verse number="17" style="v"/>anantaraM yIshuH susaMvAdaM prachArayan etAM kathAM kathayitum Arebhe, manAMsi parAvarttayata, svargIyarAjatvaM savidhamabhavat|</para>
  <para style="p">
    <verse number="18" style="v"/>tataH paraM yIshu rgAlIlo jaladhestaTena gachChan gachChan Andriyastasya bhrAtA shimon arthato yaM pitaraM vadanti etAvubhau jalaghau jAlaM kShipantau dadarsha, yatastau mInadhAriNAvAstAm|</para>
  <para style="p">
    <verse number="19" style="v"/>tadA sa tAvAhUya vyAjahAra, yuvAM mama pashchAd AgachChataM, yuvAmahaM manujadhAriNau kariShyAmi|</para>
  <para style="p">
    <verse number="20" style="v"/>tenaiva tau jAlaM vihAya tasya pashchAt AgachChatAm|</para>
  <para style="p">
    <verse number="21" style="v"/>anantaraM tasmAt sthAnAt vrajan vrajan sivadiyasya sutau yAkUb yohannAmAnau dvau sahajau tAtena sArddhaM naukopari jAlasya jIrNoddhAraM kurvvantau vIkShya tAvAhUtavAn|</para>
  <para style="p">
    <verse number="22" style="v"/>tatkShaNAt tau nAvaM svatAta ncha vihAya tasya pashchAdgAminau babhUvatuH|</para>
  <para style="p">
    <verse number="23" style="v"/>anantaraM bhajanabhavane samupadishan rAjyasya susaMvAdaM prachArayan manujAnAM sarvvaprakArAn rogAn sarvvaprakArapIDAshcha shamayan yIshuH kR^itsnaM gAlIldeshaM bhramitum Arabhata|</para>
  <para style="p">
    <verse number="24" style="v"/>tena kR^itsnasuriyAdeshasya madhyaM tasya yasho vyApnot, aparaM bhUtagrastA apasmArargINaH pakShAdhAtiprabhR^itayashcha yAvanto manujA nAnAvidhavyAdhibhiH kliShTA Asan, teShu sarvveShu tasya samIpam AnIteShu sa tAn svasthAn chakAra|</para>
  <para style="p">
    <verse number="25" style="v"/>etena gAlIl-dikApani-yirUshAlam-yihUdIyadeshebhyo yarddanaH pArA ncha bahavo manujAstasya pashchAd AgachChan|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM sa jananivahaM nirIkShya bhUdharopari vrajitvA samupavivesha|</para>
  <para style="p">
    <verse number="2" style="v"/>tadAnIM shiShyeShu tasya samIpamAgateShu tena tebhya eShA kathA kathyA nchakre|</para>
  <para style="p">
    <verse number="3" style="v"/>abhimAnahInA janA dhanyAH, yataste svargIyarAjyam adhikariShyanti|</para>
  <para style="p">
    <verse number="4" style="v"/>khidyamAnA manujA dhanyAH, yasmAt te sAntvanAM prApsanti|</para>
  <para style="p">
    <verse number="5" style="v"/>namrA mAnavAshcha dhanyAH, yasmAt te medinIm adhikariShyanti|</para>
  <para style="p">
    <verse number="6" style="v"/>dharmmAya bubhukShitAH tR^iShArttAshcha manujA dhanyAH, yasmAt te paritarpsyanti|</para>
  <para style="p">
    <verse number="7" style="v"/>kR^ipAlavo mAnavA dhanyAH, yasmAt te kR^ipAM prApsyanti|</para>
  <para style="p">
    <verse number="8" style="v"/>nirmmalahR^idayA manujAshcha dhanyAH, yasmAt ta IshcharaM drakShyanti|</para>
  <para style="p">
    <verse number="9" style="v"/>melayitAro mAnavA dhanyAH, yasmAt ta Ishcharasya santAnatvena vikhyAsyanti|</para>
  <para style="p">
    <verse number="10" style="v"/>dharmmakAraNAt tADitA manujA dhanyA, yasmAt svargIyarAjye teShAmadhikaro vidyate|</para>
  <para style="p">
    <verse number="11" style="v"/>yadA manujA mama nAmakR^ite yuShmAn nindanti tADayanti mR^iShA nAnAdurvvAkyAni vadanti cha, tadA yuyaM dhanyAH|</para>
  <para style="p">
    <verse number="12" style="v"/>tadA Anandata, tathA bhR^ishaM hlAdadhva ncha, yataH svarge bhUyAMsi phalAni lapsyadhve; te yuShmAkaM purAtanAn bhaviShyadvAdino.api tAdR^ig atADayan|</para>
  <para style="p">
    <verse number="13" style="v"/>yuyaM medinyAM lavaNarUpAH, kintu yadi lavaNasya lavaNatvam apayAti, tarhi tat kena prakAreNa svAduyuktaM bhaviShyati? tat kasyApi kAryyasyAyogyatvAt kevalaM bahiH prakSheptuM narANAM padatalena dalayitu ncha yogyaM bhavati|</para>
  <para style="p">
    <verse number="14" style="v"/>yUyaM jagati dIptirUpAH, bhUdharopari sthitaM nagaraM guptaM bhavituM nahi shakShyati|</para>
  <para style="p">
    <verse number="15" style="v"/>aparaM manujAH pradIpAn prajvAlya droNAdho na sthApayanti, kintu dIpAdhAroparyyeva sthApayanti, tena te dIpA gehasthitAn sakalAn prakAshayanti|</para>
  <para style="p">
    <verse number="16" style="v"/>yena mAnavA yuShmAkaM satkarmmANi vilokya yuShmAkaM svargasthaM pitaraM dhanyaM vadanti, teShAM samakShaM yuShmAkaM dIptistAdR^ik prakAshatAm|</para>
  <para style="p">
    <verse number="17" style="v"/>ahaM vyavasthAM bhaviShyadvAkya ncha loptum AgatavAn, itthaM mAnubhavata, te dve loptuM nAgatavAn, kintu saphale karttum Agatosmi|</para>
  <para style="p">
    <verse number="18" style="v"/>aparaM yuShmAn ahaM tathyaM vadAmi yAvat vyomamedinyo rdhvaMso na bhaviShyati, tAvat sarvvasmin saphale na jAte vyavasthAyA ekA mAtrA bindurekopi vA na lopsyate|</para>
  <para style="p">
    <verse number="19" style="v"/>tasmAt yo jana etAsAm Aj nAnAm atikShudrAm ekAj nAmapI laMghate manujAM ncha tathaiva shikShayati, sa svargIyarAjye sarvvebhyaH kShudratvena vikhyAsyate, kintu yo janastAM pAlayati, tathaiva shikShayati cha, sa svargIyarAjye pradhAnatvena vikhyAsyate|</para>
  <para style="p">
    <verse number="20" style="v"/>aparaM yuShmAn ahaM vadAmi, adhyApakaphirUshimAnavAnAM dharmmAnuShThAnAt yuShmAkaM dharmmAnuShThAne nottame jAte yUyam IshvarIyarAjyaM praveShTuM na shakShyatha|</para>
  <para style="p">
    <verse number="21" style="v"/>apara ncha tvaM naraM mA vadhIH, yasmAt yo naraM hanti, sa vichArasabhAyAM daNDArho bhaviShyati, pUrvvakAlInajanebhya iti kathitamAsIt, yuShmAbhirashrAvi|</para>
  <para style="p">
    <verse number="22" style="v"/>kintvahaM yuShmAn vadAmi, yaH kashchit kAraNaM vinA nijabhrAtre kupyati, sa vichArasabhAyAM daNDArho bhaviShyati; yaH kashchichcha svIyasahajaM nirbbodhaM vadati, sa mahAsabhAyAM daNDArho bhaviShyati; punashcha tvaM mUDha iti vAkyaM yadi kashchit svIyabhrAtaraM vakti, tarhi narakAgnau sa daNDArho bhaviShyati|</para>
  <para style="p">
    <verse number="23" style="v"/>ato vedyAH samIpaM nijanaivedye samAnIte.api nijabhrAtaraM prati kasmAchchit kAraNAt tvaM yadi doShI vidyase, tadAnIM tava tasya smR^iti rjAyate cha,</para>
  <para style="p">
    <verse number="24" style="v"/>tarhi tasyA vedyAH samIpe nijanaivaidyaM nidhAya tadaiva gatvA pUrvvaM tena sArddhaM mila, pashchAt Agatya nijanaivedyaM nivedaya|</para>
  <para style="p">
    <verse number="25" style="v"/>anya ncha yAvat vivAdinA sArddhaM vartmani tiShThasi, tAvat tena sArddhaM melanaM kuru; no chet vivAdI vichArayituH samIpe tvAM samarpayati vichArayitA cha rakShiNaH sannidhau samarpayati tadA tvaM kArAyAM badhyethAH|</para>
  <para style="p">
    <verse number="26" style="v"/>tarhi tvAmahaM taththaM bravImi, sheShakapardake.api na parishodhite tasmAt sthAnAt kadApi bahirAgantuM na shakShyasi|</para>
  <para style="p">
    <verse number="27" style="v"/>aparaM tvaM mA vyabhichara, yadetad vachanaM pUrvvakAlInalokebhyaH kathitamAsIt, tad yUyaM shrutavantaH;</para>
  <para style="p">
    <verse number="28" style="v"/>kintvahaM yuShmAn vadAmi, yadi kashchit kAmataH kA nchana yoShitaM pashyati, tarhi sa manasA tadaiva vyabhicharitavAn|</para>
  <para style="p">
    <verse number="29" style="v"/>tasmAt tava dakShiNaM netraM yadi tvAM bAdhate, tarhi tannetram utpATya dUre nikShipa, yasmAt tava sarvvavapuSho narake nikShepAt tavaikA Ngasya nAsho varaM|</para>
  <para style="p">
    <verse number="30" style="v"/>yadvA tava dakShiNaH karo yadi tvAM bAdhate, tarhi taM karaM ChittvA dUre nikShipa, yataH sarvvavapuSho narake nikShepAt ekA Ngasya nAsho varaM|</para>
  <para style="p">
    <verse number="31" style="v"/>uktamAste, yadi kashchin nijajAyAM parityakttum ichChati, tarhi sa tasyai tyAgapatraM dadAtu|</para>
  <para style="p">
    <verse number="32" style="v"/>kintvahaM yuShmAn vyAharAmi, vyabhichAradoShe na jAte yadi kashchin nijajAyAM parityajati, tarhi sa tAM vyabhichArayati; yashcha tAM tyaktAM striyaM vivahati, sopi vyabhicharati|</para>
  <para style="p">
    <verse number="33" style="v"/>punashcha tvaM mR^iShA shapatham na kurvvan IshcharAya nijashapathaM pAlaya, pUrvvakAlInalokebhyo yaiShA kathA kathitA, tAmapi yUyaM shrutavantaH|</para>
  <para style="p">
    <verse number="34" style="v"/>kintvahaM yuShmAn vadAmi, kamapi shapathaM mA kArShTa, arthataH svarganAmnA na, yataH sa Ishvarasya siMhAsanaM;</para>
  <para style="p">
    <verse number="35" style="v"/>pR^ithivyA nAmnApi na, yataH sA tasya pAdapIThaM; yirUshAlamo nAmnApi na, yataH sA mahArAjasya purI;</para>
  <para style="p">
    <verse number="36" style="v"/>nijashironAmnApi na, yasmAt tasyaikaM kachamapi sitam asitaM vA karttuM tvayA na shakyate|</para>
  <para style="p">
    <verse number="37" style="v"/>aparaM yUyaM saMlApasamaye kevalaM bhavatIti na bhavatIti cha vadata yata ito.adhikaM yat tat pApAtmano jAyate|</para>
  <para style="p">
    <verse number="38" style="v"/>aparaM lochanasya vinimayena lochanaM dantasya vinimayena dantaH pUrvvaktamidaM vachana ncha yuShmAbhirashrUyata|</para>
  <para style="p">
    <verse number="39" style="v"/>kintvahaM yuShmAn vadAmi yUyaM hiMsakaM naraM mA vyAghAtayata| kintu kenachit tava dakShiNakapole chapeTAghAte kR^ite taM prati vAmaM kapola ncha vyAghoTaya|</para>
  <para style="p">
    <verse number="40" style="v"/>aparaM kenachit tvayA sArdhdaM vivAdaM kR^itvA tava paridheyavasane jighR^itite tasmAyuttarIyavasanamapi dehi|</para>
  <para style="p">
    <verse number="41" style="v"/>yadi kashchit tvAM kroshamekaM nayanArthaM anyAyato dharati, tadA tena sArdhdaM kroshadvayaM yAhi|</para>
  <para style="p">
    <verse number="42" style="v"/>yashcha mAnavastvAM yAchate, tasmai dehi, yadi kashchit tubhyaM dhArayitum ichChati, tarhi taM prati parAMmukho mA bhUH|</para>
  <para style="p">
    <verse number="43" style="v"/>nijasamIpavasini prema kuru, kintu shatruM prati dveShaM kuru, yadetat puroktaM vachanaM etadapi yUyaM shrutavantaH|</para>
  <para style="p">
    <verse number="44" style="v"/>kintvahaM yuShmAn vadAmi, yUyaM ripuvvapi prema kuruta, ye cha yuShmAn shapante, tAna, AshiShaM vadata, ye cha yuShmAn R^iृtIyante, teShAM ma NgalaM kuruta, ye cha yuShmAn nindanti, tADayanti cha, teShAM kR^ite prArthayadhvaM|</para>
  <para style="p">
    <verse number="45" style="v"/>tatra yaH satAmasatA nchopari prabhAkaram udAyayati, tathA dhArmmikAnAmadhArmmikAnA nchopari nIraM varShayati tAdR^isho yo yuShmAkaM svargasthaH pitA, yUyaM tasyaiva santAnA bhaviShyatha|</para>
  <para style="p">
    <verse number="46" style="v"/>ye yuShmAsu prema kurvvanti, yUyaM yadi kevalaM tevveva prema kurutha, tarhi yuShmAkaM kiM phalaM bhaviShyati? chaNDAlA api tAdR^ishaM kiM na kurvvanti?</para>
  <para style="p">
    <verse number="47" style="v"/>aparaM yUyaM yadi kevalaM svIyabhrAtR^itvena namata, tarhi kiM mahat karmma kurutha? chaNDAlA api tAdR^ishaM kiM na kurvvanti?</para>
  <para style="p">
    <verse number="48" style="v"/>tasmAt yuShmAkaM svargasthaH pitA yathA pUrNo bhavati, yUyamapi tAdR^ishA bhavata|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>sAvadhAnA bhavata, manujAn darshayituM teShAM gochare dharmmakarmma mA kuruta, tathA kR^ite yuShmAkaM svargasthapituH sakAshAt ki nchana phalaM na prApsyatha|</para>
  <para style="p">
    <verse number="2" style="v"/>tvaM yadA dadAsi tadA kapaTino janA yathA manujebhyaH prashaMsAM prAptuM bhajanabhavane rAjamArge cha tUrIM vAdayanti, tathA mA kuriु, ahaM tubhyaM yathArthaM kathayAmi, te svakAyaM phalam alabhanta|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu tvaM yadA dadAsi, tadA nijadakShiNakaro yat karoti, tad vAmakaraM mA j nApaya|</para>
  <para style="p">
    <verse number="4" style="v"/>tena tava dAnaM guptaM bhaviShyati yastu tava pitA guptadarshI, sa prakAshya tubhyaM phalaM dAsyati|</para>
  <para style="p">
    <verse number="5" style="v"/>aparaM yadA prArthayase, tadA kapaTina_iva mA kuru, yasmAt te bhajanabhavane rAjamArgasya koNe tiShThanto lokAn darshayantaH prArthayituM prIyante; ahaM yuShmAn tathyaM vadAmi, te svakIyaphalaM prApnuvan|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmAt prArthanAkAle antarAgAraM pravishya dvAraM rudvvA guptaM pashyatastava pituH samIpe prArthayasva; tena tava yaH pitA guptadarshI, sa prakAshya tubhyaM phalaM dAsyatil</para>
  <para style="p">
    <verse number="7" style="v"/>aparaM prArthanAkAle devapUjakAiva mudhA punaruktiM mA kuru, yasmAt te bodhante, bahuvAraM kathAyAM kathitAyAM teShAM prArthanA grAhiShyate|</para>
  <para style="p">
    <verse number="8" style="v"/>yUyaM teShAmiva mA kuruta, yasmAt yuShmAkaM yad yat prayojanaM yAchanAtaH prAgeva yuShmAkaM pitA tat jAnAti|</para>
  <para style="p">
    <verse number="9" style="v"/>ataeva yUyama IdR^ik prArthayadhvaM, he asmAkaM svargasthapitaH, tava nAma pUjyaM bhavatu|</para>
  <para style="p">
    <verse number="10" style="v"/>tava rAjatvaM bhavatu; tavechChA svarge yathA tathaiva medinyAmapi saphalA bhavatu|</para>
  <para style="p">
    <verse number="11" style="v"/>asmAkaM prayojanIyam AhAram adya dehi|</para>
  <para style="p">
    <verse number="12" style="v"/>vayaM yathA nijAparAdhinaH kShamAmahe, tathaivAsmAkam aparAdhAn kShamasva|</para>
  <para style="p">
    <verse number="13" style="v"/>asmAn parIkShAM mAnaya, kintu pApAtmano rakSha; rAjatvaM gauravaM parAkramaH ete sarvve sarvvadA tava; tathAstu|</para>
  <para style="p">
    <verse number="14" style="v"/>yadi yUyam anyeShAm aparAdhAn kShamadhve tarhi yuShmAkaM svargasthapitApi yuShmAn kShamiShyate;</para>
  <para style="p">
    <verse number="15" style="v"/>kintu yadi yUyam anyeShAm aparAdhAn na kShamadhve, tarhi yuShmAkaM janakopi yuShmAkam aparAdhAn na kShamiShyate|</para>
  <para style="p">
    <verse number="16" style="v"/>aparam upavAsakAle kapaTino janA mAnuShAn upavAsaM j nApayituM sveShAM vadanAni mlAnAni kurvvanti, yUyaM ta_iva viShaNavadanA mA bhavata; ahaM yuShmAn tathyaM vadAmi te svakIyaphalam alabhanta|</para>
  <para style="p">
    <verse number="17" style="v"/>yadA tvam upavasasi, tadA yathA lokaistvaM upavAsIva na dR^ishyase, kintu tava yo.agocharaH pitA tenaiva dR^ishyase, tatkR^ite nijashirasi tailaM marddaya vadana ncha prakShAlaya;</para>
  <para style="p">
    <verse number="18" style="v"/>tena tava yaH pitA guptadarshI sa prakAshya tubhyaM phalaM dAsyati|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaM yatra sthAne kITAH kala NkAshcha kShayaM nayanti, chaurAshcha sandhiM karttayitvA chorayituM shaknuvanti, tAdR^ishyAM medinyAM svArthaM dhanaM mA saMchinuta|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu yatra sthAne kITAH kala NkAshcha kShayaM na nayanti, chaurAshcha sandhiM karttayitvA chorayituM na shaknuvanti, tAdR^ishe svarge dhanaM sa nchinuta|</para>
  <para style="p">
    <verse number="21" style="v"/>yasmAt yatra sthAne yuShmAMka dhanaM tatraiva khAne yuShmAkaM manAMsi|</para>
  <para style="p">
    <verse number="22" style="v"/>lochanaM dehasya pradIpakaM, tasmAt yadi tava lochanaM prasannaM bhavati, tarhi tava kR^itsnaM vapu rdIptiyuktaM bhaviShyati|</para>
  <para style="p">
    <verse number="23" style="v"/>kintu lochane.aprasanne tava kR^itsnaM vapuH tamisrayuktaM bhaviShyati| ataeva yA dIptistvayi vidyate, sA yadi tamisrayuktA bhavati, tarhi tat tamisraM kiyan mahat|</para>
  <para style="p">
    <verse number="24" style="v"/>kopi manujo dvau prabhU sevituM na shaknoti, yasmAd ekaM saMmanya tadanyaM na sammanyate, yadvA ekatra mano nidhAya tadanyam avamanyate; tathA yUyamapIshvaraM lakShmI nchetyubhe sevituM na shaknutha|</para>
  <para style="p">
    <verse number="25" style="v"/>aparam ahaM yuShmabhyaM tathyaM kathayAmi, kiM bhakShiShyAmaH? kiM pAsyAmaH? iti prANadhAraNAya mA chintayata; kiM paridhAsyAmaH? iti kAyarakShaNAya na chintayata; bhakShyAt prANA vasanA ncha vapUMShi kiM shreShThANi na hi?</para>
  <para style="p">
    <verse number="26" style="v"/>vihAyaso viha NgamAn vilokayata; tai rnopyate na kR^ityate bhANDAgAre na sa nchIyate.api; tathApi yuShmAkaM svargasthaH pitA tebhya AhAraM vitarati|</para>
  <para style="p">
    <verse number="27" style="v"/>yUyaM tebhyaH kiM shreShThA na bhavatha? yuShmAkaM kashchit manujaH chintayan nijAyuShaH kShaNamapi varddhayituM shaknoti?</para>
  <para style="p">
    <verse number="28" style="v"/>aparaM vasanAya kutashchintayata? kShetrotpannAni puShpANi kathaM varddhante tadAlochayata| tAni tantUn notpAdayanti kimapi kAryyaM na kurvvanti;</para>
  <para style="p">
    <verse number="29" style="v"/>tathApyahaM yuShmAn vadAmi, sulemAn tAdR^ig aishvaryyavAnapi tatpuShpamiva vibhUShito nAsIt|</para>
  <para style="p">
    <verse number="30" style="v"/>tasmAt kShadya vidyamAnaM shchaH chullyAM nikShepsyate tAdR^ishaM yat kShetrasthitaM kusumaM tat yadIshchara itthaM bibhUShayati, tarhi he stokapratyayino yuShmAn kiM na paridhApayiShyati?</para>
  <para style="p">
    <verse number="31" style="v"/>tasmAt asmAbhiH kimatsyate? ki ncha pAyiShyate? kiM vA paridhAyiShyate, iti na chintayata|</para>
  <para style="p">
    <verse number="32" style="v"/>yasmAt devArchchakA apIti cheShTante; eteShu dravyeShu prayojanamastIti yuShmAkaM svargasthaH pitA jAnAti|</para>
  <para style="p">
    <verse number="33" style="v"/>ataeva prathamata IshvarIyarAjyaM dharmma ncha cheShTadhvaM, tata etAni vastUni yuShmabhyaM pradAyiShyante|</para>
  <para style="p">
    <verse number="34" style="v"/>shvaH kR^ite mA chintayata, shvaeva svayaM svamuddishya chintayiShyati; adyatanI yA chintA sAdyakR^ite prachuratarA|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yathA yUyaM doShIkR^itA na bhavatha, tatkR^ite.anyaM doShiNaM mA kuruta|</para>
  <para style="p">
    <verse number="2" style="v"/>yato yAdR^ishena doSheNa yUyaM parAn doShiNaH kurutha, tAdR^ishena doSheNa yUyamapi doShIkR^itA bhaviShyatha, anya ncha yena parimANena yuShmAbhiH parimIyate, tenaiva parimANena yuShmatkR^ite parimAyiShyate|</para>
  <para style="p">
    <verse number="3" style="v"/>apara ncha nijanayane yA nAsA vidyate, tAm anAlochya tava sahajasya lochane yat tR^iNam Aste, tadeva kuto vIkShase?</para>
  <para style="p">
    <verse number="4" style="v"/>tava nijalochane nAsAyAM vidyamAnAyAM, he bhrAtaH, tava nayanAt tR^iNaM bahiShyartuM anujAnIhi, kathAmetAM nijasahajAya kathaM kathayituM shaknoShi?</para>
  <para style="p">
    <verse number="5" style="v"/>he kapaTin, Adau nijanayanAt nAsAM bahiShkuru tato nijadR^iShTau suprasannAyAM tava bhrAtR^i rlochanAt tR^iNaM bahiShkartuM shakShyasi|</para>
  <para style="p">
    <verse number="6" style="v"/>anya ncha sArameyebhyaH pavitravastUni mA vitarata, varAhANAM samakSha ncha muktA mA nikShipata; nikShepaNAt te tAH sarvvAH padai rdalayiShyanti, parAvR^itya yuShmAnapi vidArayiShyanti|</para>
  <para style="p">
    <verse number="7" style="v"/>yAchadhvaM tato yuShmabhyaM dAyiShyate; mR^igayadhvaM tata uddeshaM lapsyadhve; dvAram Ahata, tato yuShmatkR^ite muktaM bhaviShyati|</para>
  <para style="p">
    <verse number="8" style="v"/>yasmAd yena yAchyate, tena labhyate; yena mR^igyate tenoddeshaH prApyate; yena cha dvAram Ahanyate, tatkR^ite dvAraM mochyate|</para>
  <para style="p">
    <verse number="9" style="v"/>Atmajena pUpe prArthite tasmai pAShANaM vishrANayati,</para>
  <para style="p">
    <verse number="10" style="v"/>mIne yAchite cha tasmai bhujagaM vitarati, etAdR^ishaH pitA yuShmAkaM madhye ka Aste?</para>
  <para style="p">
    <verse number="11" style="v"/>tasmAd yUyam abhadrAH santo.api yadi nijabAlakebhya uttamaM dravyaM dAtuM jAnItha, tarhi yuShmAkaM svargasthaH pitA svIyayAchakebhyaH kimuttamAni vastUni na dAsyati?</para>
  <para style="p">
    <verse number="12" style="v"/>yUShmAn pratItareShAM yAdR^isho vyavahAro yuShmAkaM priyaH, yUyaM tAn prati tAdR^ishAneva vyavahArAn vidhatta; yasmAd vyavasthAbhaviShyadvAdinAM vachanAnAm iti sAram|</para>
  <para style="p">
    <verse number="13" style="v"/>sa NkIrNadvAreNa pravishata; yato narakagamanAya yad dvAraM tad vistIrNaM yachcha vartma tad bR^ihat tena bahavaH pravishanti|</para>
  <para style="p">
    <verse number="14" style="v"/>aparaM svargagamanAya yad dvAraM tat kIdR^ik saMkIrNaM| yachcha vartma tat kIdR^ig durgamam| taduddeShTAraH kiyanto.alpAH|</para>
  <para style="p">
    <verse number="15" style="v"/>apara ncha ye janA meShaveshena yuShmAkaM samIpam AgachChanti, kintvantardurantA vR^ikA etAdR^ishebhyo bhaviShyadvAdibhyaH sAvadhAnA bhavata, yUyaM phalena tAn parichetuM shaknutha|</para>
  <para style="p">
    <verse number="16" style="v"/>manujAH kiM kaNTakino vR^ikShAd drAkShAphalAni shR^igAlakolitashcha uDumbaraphalAni shAtayanti?</para>
  <para style="p">
    <verse number="17" style="v"/>tadvad uttama eva pAdapa uttamaphalAni janayati, adhamapAdapaevAdhamaphalAni janayati|</para>
  <para style="p">
    <verse number="18" style="v"/>kintUttamapAdapaH kadApyadhamaphalAni janayituM na shaknoti, tathAdhamopi pAdapa uttamaphalAni janayituM na shaknoti|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaM ye ye pAdapA adhamaphalAni janayanti, te kR^ittA vahnau kShipyante|</para>
  <para style="p">
    <verse number="20" style="v"/>ataeva yUyaM phalena tAn paricheShyatha|</para>
  <para style="p">
    <verse number="21" style="v"/>ye janA mAM prabhuM vadanti, te sarvve svargarAjyaM pravekShyanti tanna, kintu yo mAnavo mama svargasthasya pituriShTaM karmma karoti sa eva pravekShyati|</para>
  <para style="p">
    <verse number="22" style="v"/>tad dine bahavo mAM vadiShyanti, he prabho he prabho, tava nAmnA kimasmAmi rbhaviShyadvAkyaM na vyAhR^itaM? tava nAmnA bhUtAH kiM na tyAjitAH? tava nAmnA kiM nAnAdbhutAni karmmANi na kR^itAni?</para>
  <para style="p">
    <verse number="23" style="v"/>tadAhaM vadiShyAmi, he kukarmmakAriNo yuShmAn ahaM na vedmi, yUyaM matsamIpAd dUrIbhavata|</para>
  <para style="p">
    <verse number="24" style="v"/>yaH kashchit mamaitAH kathAH shrutvA pAlayati, sa pAShANopari gR^ihanirmmAtrA j nAninA saha mayopamIyate|</para>
  <para style="p">
    <verse number="25" style="v"/>yato vR^iShTau satyAm AplAva Agate vAyau vAte cha teShu tadgehaM lagneShu pAShANopari tasya bhittestanna patatil</para>
  <para style="p">
    <verse number="26" style="v"/>kintu yaH kashchit mamaitAH kathAH shrutvA na pAlayati sa saikate gehanirmmAtrA .aj nAninA upamIyate|</para>
  <para style="p">
    <verse number="27" style="v"/>yato jalavR^iShTau satyAm AplAva Agate pavane vAte cha tai rgR^ihe samAghAte tat patati tatpatanaM mahad bhavati|</para>
  <para style="p">
    <verse number="28" style="v"/>yIshunaiteShu vAkyeShu samApiteShu mAnavAstadIyopadesham AshcharyyaM menire|</para>
  <para style="p">
    <verse number="29" style="v"/>yasmAt sa upAdhyAyA iva tAn nopadidesha kintu samarthapuruSha_iva samupadidesha|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yadA sa parvvatAd avArohat tadA bahavo mAnavAstatpashchAd vavrajuH|</para>
  <para style="p">
    <verse number="2" style="v"/>ekaH kuShThavAn Agatya taM praNamya babhAShe, he prabho, yadi bhavAn saMmanyate, tarhi mAM nirAmayaM karttuM shaknoti|</para>
  <para style="p">
    <verse number="3" style="v"/>tato yIshuH karaM prasAryya tasyA NgaM spR^ishan vyAjahAra, sammanye.ahaM tvaM nirAmayo bhava; tena sa tatkShaNAt kuShThenAmochi|</para>
  <para style="p">
    <verse number="4" style="v"/>tato yIshustaM jagAda, avadhehi kathAmetAM kashchidapi mA brUhi, kintu yAjakasya sannidhiM gatvA svAtmAnaM darshaya manujebhyo nijanirAmayatvaM pramANayituM mUsAnirUpitaM dravyam utsR^ija cha|</para>
  <para style="p">
    <verse number="5" style="v"/>tadanantaraM yIshunA kapharnAhUmnAmani nagare praviShTe kashchit shatasenApatistatsamIpam Agatya vinIya babhAShe,</para>
  <para style="p">
    <verse number="6" style="v"/>he prabho, madIya eko dAsaH pakShAghAtavyAdhinA bhR^ishaM vyathitaH, satu shayanIya Aste|</para>
  <para style="p">
    <verse number="7" style="v"/>tadAnIM yIshustasmai kathitavAn, ahaM gatvA taM nirAmayaM kariShyAmi|</para>
  <para style="p">
    <verse number="8" style="v"/>tataH sa shatasenApatiH pratyavadat, he prabho, bhavAn yat mama gehamadhyaM yAti tadyogyabhAjanaM nAhamasmi; vA NmAtram Adishatu, tenaiva mama dAso nirAmayo bhaviShyati|</para>
  <para style="p">
    <verse number="9" style="v"/>yato mayi paranidhne.api mama nideshavashyAH kati kati senAH santi, tata ekasmin yAhItyukte sa yAti, tadanyasmin ehItyukte sa AyAti, tathA mama nijadAse karmmaitat kurvvityukte sa tat karoti|</para>
  <para style="p">
    <verse number="10" style="v"/>tadAnIM yIshustasyaitat vacho nishamya vismayApanno.abhUt; nijapashchAdgAmino mAnavAn avochcha, yuShmAn tathyaM vachmi, isrAyelIyalokAnAM madhye.api naitAdR^isho vishvAso mayA prAptaH|</para>
  <para style="p">
    <verse number="11" style="v"/>anyachchAhaM yuShmAn vadAmi, bahavaH pUrvvasyAH pashchimAyAshcha disha Agatya ibrAhImA ishAkA yAkUbA cha sAkam militvA samupavekShyanti;</para>
  <para style="p">
    <verse number="12" style="v"/>kintu yatra sthAne rodanadantagharShaNe bhavatastasmin bahirbhUtatamisre rAjyasya santAnA nikShesyante|</para>
  <para style="p">
    <verse number="13" style="v"/>tataH paraM yIshustaM shatasenApatiM jagAda, yAhi, tava pratItyanusArato ma NgalaM bhUyAt; tadA tasminneva daNDe tadIyadAso nirAmayo babhUva|</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraM yIshuH pitarasya gehamupasthAya jvareNa pIDitAM shayanIyasthitAM tasya shvashrUM vIkShA nchakre|</para>
  <para style="p">
    <verse number="15" style="v"/>tatastena tasyAH karasya spR^iShTatavAt jvarastAM tatyAja, tadA sA samutthAya tAn siSheve|</para>
  <para style="p">
    <verse number="16" style="v"/>anantaraM sandhyAyAM satyAM bahusho bhUtagrastamanujAn tasya samIpam AninyuH sa cha vAkyena bhUtAn tyAjayAmAsa, sarvvaprakArapIDitajanAMshcha nirAmayAn chakAra;</para>
  <para style="p">
    <verse number="17" style="v"/>tasmAt, sarvvA durbbalatAsmAkaM tenaiva paridhAritA| asmAkaM sakalaM vyAdhiM saeva saMgR^ihItavAn| yadetadvachanaM yishayiyabhaviShyadvAdinoktamAsIt, tattadA saphalamabhavat|</para>
  <para style="p">
    <verse number="18" style="v"/>anantaraM yIshushchaturdikShu jananivahaM vilokya taTinyAH pAraM yAtuM shiShyAn Adidesha|</para>
  <para style="p">
    <verse number="19" style="v"/>tadAnIm eka upAdhyAya Agatya kathitavAn, he guro, bhavAn yatra yAsyati tatrAhamapi bhavataH pashchAd yAsyAmi|</para>
  <para style="p">
    <verse number="20" style="v"/>tato yIshu rjagAda, kroShTuH sthAtuM sthAnaM vidyate, vihAyaso viha NgamAnAM nIDAni cha santi; kintu manuShyaputrasya shiraH sthApayituM sthAnaM na vidyate|</para>
  <para style="p">
    <verse number="21" style="v"/>anantaram apara ekaH shiShyastaM babhAShe, he prabho, prathamato mama pitaraM shmashAne nidhAtuM gamanArthaM mAm anumanyasva|</para>
  <para style="p">
    <verse number="22" style="v"/>tato yIshuruktavAn mR^itA mR^itAn shmashAne nidadhatu, tvaM mama pashchAd AgachCha|</para>
  <para style="p">
    <verse number="23" style="v"/>anantaraM tasmin nAvamArUDhe tasya shiShyAstatpashchAt jagmuH|</para>
  <para style="p">
    <verse number="24" style="v"/>pashchAt sAgarasya madhyaM teShu gateShu tAdR^ishaH prabalo jha nbhshanila udatiShThat, yena mahAtara Nga utthAya taraNiM ChAditavAn, kintu sa nidrita AsIt|</para>
  <para style="p">
    <verse number="25" style="v"/>tadA shiShyA Agatya tasya nidrAbha NgaM kR^itvA kathayAmAsuH, he prabho, vayaM mriyAmahe, bhavAn asmAkaM prANAn rakShatu|</para>
  <para style="p">
    <verse number="26" style="v"/>tadA sa tAn uktavAn, he alpavishvAsino yUyaM kuto vibhItha? tataH sa utthAya vAtaM sAgara ncha tarjayAmAsa, tato nirvvAtamabhavat|</para>
  <para style="p">
    <verse number="27" style="v"/>aparaM manujA vismayaM vilokya kathayAmAsuH, aho vAtasaritpatI asya kimAj nAgrAhiNau? kIdR^isho.ayaM mAnavaH|</para>
  <para style="p">
    <verse number="28" style="v"/>anantaraM sa pAraM gatvA giderIyadesham upasthitavAn; tadA dvau bhUtagrastamanujau shmashAnasthAnAd bahi rbhUtvA taM sAkShAt kR^itavantau, tAvetAdR^ishau prachaNDAvAstAM yat tena sthAnena kopi yAtuM nAshaknot|</para>
  <para style="p">
    <verse number="29" style="v"/>tAvuchaiH kathayAmAsatuH, he Ishvarasya sUno yIsho, tvayA sAkam AvayoH kaH sambandhaH? nirUpitakAlAt prAgeva kimAvAbhyAM yAtanAM dAtum atrAgatosi?</para>
  <para style="p">
    <verse number="30" style="v"/>tadAnIM tAbhyAM ki nchid dUre varAhANAm eko mahAvrajo.acharat|</para>
  <para style="p">
    <verse number="31" style="v"/>tato bhUtau tau tasyAntike vinIya kathayAmAsatuH, yadyAvAM tyAjayasi, tarhi varAhANAM madhyevrajam AvAM preraya|</para>
  <para style="p">
    <verse number="32" style="v"/>tadA yIshuravadat yAtaM, anantaraM tau yadA manujau vihAya varAhAn Ashritavantau, tadA te sarvve varAhA uchchasthAnAt mahAjavena dhAvantaH sAgarIyatoye majjanto mamruH|</para>
  <para style="p">
    <verse number="33" style="v"/>tato varAharakShakAH palAyamAnA madhyenagaraM tau bhUtagrastau prati yadyad aghaTata, tAH sarvvavArttA avadan|</para>
  <para style="p">
    <verse number="34" style="v"/>tato nAgarikAH sarvve manujA yIshuM sAkShAt karttuM bahirAyAtAH ta ncha vilokya prArthayA nchakrire bhavAn asmAkaM sImAto yAtu|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM yIshu rnaukAmAruhya punaH pAramAgatya nijagrAmam Ayayau|</para>
  <para style="p">
    <verse number="2" style="v"/>tataH katipayA janA ekaM pakShAghAtinaM svaTTopari shAyayitvA tatsamIpam Anayan; tato yIshusteShAM pratItiM vij nAya taM pakShAghAtinaM jagAda, he putra, susthiro bhava, tava kaluShasya marShaNaM jAtam|</para>
  <para style="p">
    <verse number="3" style="v"/>tAM kathAM nishamya kiyanta upAdhyAyA manaHsu chintitavanta eSha manuja IshvaraM nindati|</para>
  <para style="p">
    <verse number="4" style="v"/>tataH sa teShAm etAdR^ishIM chintAM vij nAya kathitavAn, yUyaM manaHsu kR^ita etAdR^ishIM kuchintAM kurutha?</para>
  <para style="p">
    <verse number="5" style="v"/>tava pApamarShaNaM jAtaM, yadvA tvamutthAya gachCha, dvayoranayo rvAkyayoH kiM vAkyaM vaktuM sugamaM?</para>
  <para style="p">
    <verse number="6" style="v"/>kintu medinyAM kaluShaM kShamituM manujasutasya sAmarthyamastIti yUyaM yathA jAnItha, tadarthaM sa taM pakShAghAtinaM gaditavAn, uttiShTha, nijashayanIyaM AdAya gehaM gachCha|</para>
  <para style="p">
    <verse number="7" style="v"/>tataH sa tatkShaNAd utthAya nijagehaM prasthitavAn|</para>
  <para style="p">
    <verse number="8" style="v"/>mAnavA itthaM vilokya vismayaM menire, IshvareNa mAnavAya sAmarthyam IdR^ishaM dattaM iti kAraNAt taM dhanyaM babhAShire cha|</para>
  <para style="p">
    <verse number="9" style="v"/>anantaraM yIshustatsthAnAd gachChan gachChan karasaMgrahasthAne samupaviShTaM mathinAmAnam ekaM manujaM vilokya taM babhAShe, mama pashchAd AgachCha, tataH sa utthAya tasya pashchAd vavrAja|</para>
  <para style="p">
    <verse number="10" style="v"/>tataH paraM yIshau gR^ihe bhoktum upaviShTe bahavaH karasaMgrAhiNaH kaluShiNashcha mAnavA Agatya tena sAkaM tasya shiShyaishcha sAkam upavivishuH|</para>
  <para style="p">
    <verse number="11" style="v"/>phirUshinastad dR^iShTvA tasya shiShyAn babhAShire, yuShmAkaM guruH kiM nimittaM karasaMgrAhibhiH kaluShibhishcha sAkaM bhuMkte?</para>
  <para style="p">
    <verse number="12" style="v"/>yIshustat shrutvA tAn pratyavadat, nirAmayalokAnAM chikitsakena prayojanaM nAsti, kintu sAmayalokAnAM prayojanamAste|</para>
  <para style="p">
    <verse number="13" style="v"/>ato yUyaM yAtvA vachanasyAsyArthaM shikShadhvam, dayAyAM me yathA prIti rna tathA yaj nakarmmaNi|yato.ahaM dhArmmikAn AhvAtuM nAgato.asmi kintu manaH parivarttayituM pApina AhvAtum Agato.asmi|</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraM yohanaH shiShyAstasya samIpam Agatya kathayAmAsuH, phirUshino vaya ncha punaH punarupavasAmaH, kintu tava shiShyA nopavasanti, kutaH?</para>
  <para style="p">
    <verse number="15" style="v"/>tadA yIshustAn avochat yAvat sakhInAM saM Nge kanyAyA varastiShThati, tAvat kiM te vilApaM karttuM shakluvanti? kintu yadA teShAM saM NgAd varaM nayanti, tAdR^ishaH samaya AgamiShyati, tadA te upavatsyanti|</para>
  <para style="p">
    <verse number="16" style="v"/>purAtanavasane kopi navInavastraM na yojayati, yasmAt tena yojitena purAtanavasanaM Chinatti tachChidra ncha bahukutsitaM dR^ishyate|</para>
  <para style="p">
    <verse number="17" style="v"/>anya ncha purAtanakutvAM kopi navAnagostanIrasaM na nidadhAti, yasmAt tathA kR^ite kutU rvidIryyate tena gostanIrasaH patati kutUshcha nashyati; tasmAt navInAyAM kutvAM navIno gostanIrasaH sthApyate, tena dvayoravanaM bhavati|</para>
  <para style="p">
    <verse number="18" style="v"/>aparaM tenaitatkathAkathanakAle eko.adhipatistaM praNamya babhAShe, mama duhitA prAyeNaitAvatkAle mR^itA, tasmAd bhavAnAgatya tasyA gAtre hastamarpayatu, tena sA jIviShyati|</para>
  <para style="p">
    <verse number="19" style="v"/>tadAnIM yIshuH shiShyaiH sAkam utthAya tasya pashchAd vavrAja|</para>
  <para style="p">
    <verse number="20" style="v"/>ityanantare dvAdashavatsarAn yAvat pradarAmayena shIrNaikA nArI tasya pashchAd Agatya tasya vasanasya granthiM pasparsha;</para>
  <para style="p">
    <verse number="21" style="v"/>yasmAt mayA kevalaM tasya vasanaM spR^iShTvA svAsthyaM prApsyate, sA nArIti manasi nishchitavatI|</para>
  <para style="p">
    <verse number="22" style="v"/>tato yIshurvadanaM parAvarttya tAM jagAda, he kanye, tvaM susthirA bhava, tava vishvAsastvAM svasthAmakArShIt| etadvAkye gaditaeva sA yoShit svasthAbhUt|</para>
  <para style="p">
    <verse number="23" style="v"/>aparaM yIshustasyAdhyakShasya gehaM gatvA vAdakaprabhR^itIn bahUn lokAn shabdAyamAnAn vilokya tAn avadat,</para>
  <para style="p">
    <verse number="24" style="v"/>panthAnaM tyaja, kanyeyaM nAmriyata nidritAste; kathAmetAM shrutvA te tamupajahasuH|</para>
  <para style="p">
    <verse number="25" style="v"/>kintu sarvveShu bahiShkR^iteShu so.abhyantaraM gatvA kanyAyAH karaM dhR^itavAn, tena sodatiShThat;</para>
  <para style="p">
    <verse number="26" style="v"/>tatastatkarmmaNo yashaH kR^itsnaM taM deshaM vyAptavat|</para>
  <para style="p">
    <verse number="27" style="v"/>tataH paraM yIshustasmAt sthAnAd yAtrAM chakAra; tadA he dAyUdaH santAna, asmAn dayasva, iti vadantau dvau janAvandhau prochairAhUyantau tatpashchAd vavrajatuH|</para>
  <para style="p">
    <verse number="28" style="v"/>tato yIshau gehamadhyaM praviShTaM tAvapi tasya samIpam upasthitavantau, tadAnIM sa tau pR^iShTavAn karmmaitat karttuM mama sAmarthyam Aste, yuvAM kimiti pratIthaH? tadA tau pratyUchatuH, satyaM prabho|</para>
  <para style="p">
    <verse number="29" style="v"/>tadAnIM sa tayo rlochanAni spR^ishan babhAShe, yuvayoH pratItyanusArAd yuvayo rma NgalaM bhUyAt| tena tatkShaNAt tayo rnetrANi prasannAnyabhavan,</para>
  <para style="p">
    <verse number="30" style="v"/>pashchAd yIshustau dR^iDhamAj nApya jagAda, avadhattam etAM kathAM kopi manujo ma jAnIyAt|</para>
  <para style="p">
    <verse number="31" style="v"/>kintu tau prasthAya tasmin kR^itsne deshe tasya kIrttiM prakAshayAmAsatuH|</para>
  <para style="p">
    <verse number="32" style="v"/>aparaM tau bahiryAta etasminnantare manujA ekaM bhUtagrastamUkaM tasya samIpam AnItavantaH|</para>
  <para style="p">
    <verse number="33" style="v"/>tena bhUte tyAjite sa mUkaH kathAM kathayituM prArabhata, tena janA vismayaM vij nAya kathayAmAsuH, isrAyelo vaMshe kadApi nedR^igadR^ishyata;</para>
  <para style="p">
    <verse number="34" style="v"/>kintu phirUshinaH kathayA nchakruH bhUtAdhipatinA sa bhUtAn tyAjayati|</para>
  <para style="p">
    <verse number="35" style="v"/>tataH paraM yIshusteShAM bhajanabhavana upadishan rAjyasya susaMvAdaM prachArayan lokAnAM yasya ya Amayo yA cha pIDAsIt, tAn shamayan shamayaMshcha sarvvANi nagarANi grAmAMshcha babhrAma|</para>
  <para style="p">
    <verse number="36" style="v"/>anya ncha manujAn vyAkulAn arakShakameShAniva cha tyaktAn nirIkShya teShu kAruNikaH san shiShyAn avadat,</para>
  <para style="p">
    <verse number="37" style="v"/>shasyAni prachurANi santi, kintu ChettAraH stokAH|</para>
  <para style="p">
    <verse number="38" style="v"/>kShetraM pratyaparAn ChedakAn prahetuM shasyasvAminaM prArthayadhvam|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM yIshu rdvAdashashiShyAn AhUyAmedhyabhUtAn tyAjayituM sarvvaprakArarogAn pIDAshcha shamayituM tebhyaH sAmarthyamadAt|</para>
  <para style="p">
    <verse number="2" style="v"/>teShAM dvAdashapreShyANAM nAmAnyetAni| prathamaM shimon yaM pitaraM vadanti, tataH paraM tasya sahaja AndriyaH, sivadiyasya putro yAkUb</para>
  <para style="p">
    <verse number="3" style="v"/>tasya sahajo yohan; philip barthalamay thomAH karasaMgrAhI mathiH, Alpheyaputro yAkUb,</para>
  <para style="p">
    <verse number="4" style="v"/>kinAnIyaH shimon, ya IShkariyotIyayihUdAH khrIShTaM parakare.arpayat|</para>
  <para style="p">
    <verse number="5" style="v"/>etAn dvAdashashiShyAn yIshuH preShayan ityAj nApayat, yUyam anyadeshIyAnAM padavIM shemiroNIyAnAM kimapi nagara ncha na pravishye</para>
  <para style="p">
    <verse number="6" style="v"/>isrAyelgotrasya hAritA ye ye meShAsteShAmeva samIpaM yAta|</para>
  <para style="p">
    <verse number="7" style="v"/>gatvA gatvA svargasya rAjatvaM savidhamabhavat, etAM kathAM prachArayata|</para>
  <para style="p">
    <verse number="8" style="v"/>AmayagrastAn svasthAn kuruta, kuShThinaH pariShkuruta, mR^italokAn jIvayata, bhUtAn tyAjayata, vinA mUlyaM yUyam alabhadhvaM vinaiva mUlyaM vishrANayata|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu sveShAM kaTibandheShu svarNarUpyatAmrANAM kimapi na gR^ihlIta|</para>
  <para style="p">
    <verse number="10" style="v"/>anyachcha yAtrAyai chelasampuTaM vA dvitIyavasanaM vA pAduke vA yaShTiH, etAn mA gR^ihlIta, yataH kAryyakR^it bharttuM yogyo bhavati|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaM yUyaM yat puraM ya ncha grAmaM pravishatha, tatra yo jano yogyapAtraM tamavagatya yAnakAlaM yAvat tatra tiShThata|</para>
  <para style="p">
    <verse number="12" style="v"/>yadA yUyaM tadgehaM pravishatha, tadA tamAshiShaM vadata|</para>
  <para style="p">
    <verse number="13" style="v"/>yadi sa yogyapAtraM bhavati, tarhi tatkalyANaM tasmai bhaviShyati, nochet sAshIryuShmabhyameva bhaviShyati|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu ye janA yuShmAkamAtithyaM na vidadhati yuShmAkaM kathA ncha na shR^iNvanti teShAM gehAt purAdvA prasthAnakAle svapadUlIH pAtayata|</para>
  <para style="p">
    <verse number="15" style="v"/>yuShmAnahaM tathyaM vachmi vichAradine tatpurasya dashAtaH sidomamorApurayordashA sahyatarA bhaviShyati|</para>
  <para style="p">
    <verse number="16" style="v"/>pashyata, vR^ikayUthamadhye meShaH yathAvistathA yuShmAna prahiNomi, tasmAd yUyam ahiriva satarkAH kapotAivAhiMsakA bhavata|</para>
  <para style="p">
    <verse number="17" style="v"/>nR^ibhyaH sAvadhAnA bhavata; yatastai ryUyaM rAjasaMsadi samarpiShyadhve teShAM bhajanagehe prahAriShyadhve|</para>
  <para style="p">
    <verse number="18" style="v"/>yUyaM mannAmahetoH shAstR^iNAM rAj nA ncha samakShaM tAnanyadeshinashchAdhi sAkShitvArthamAneShyadhve|</para>
  <para style="p">
    <verse number="19" style="v"/>kintvitthaM samarpitA yUyaM kathaM kimuttaraM vakShyatha tatra mA chintayata, yatastadA yuShmAbhi ryad vaktavyaM tat taddaNDe yuShmanmanaH su samupasthAsyati|</para>
  <para style="p">
    <verse number="20" style="v"/>yasmAt tadA yo vakShyati sa na yUyaM kintu yuShmAkamantarasthaH pitrAtmA|</para>
  <para style="p">
    <verse number="21" style="v"/>sahajaH sahajaM tAtaH suta ncha mR^itau samarpayiShyati, apatyAgi svasvapitroे rvipakShIbhUya tau ghAtayiShyanti|</para>
  <para style="p">
    <verse number="22" style="v"/>mannamahetoH sarvve janA yuShmAn R^iृtIyiShyante, kintu yaH sheShaM yAvad dhairyyaM ghR^itvA sthAsyati, sa trAyiShyate|</para>
  <para style="p">
    <verse number="23" style="v"/>tai ryadA yUyamekapure tADiShyadhve, tadA yUyamanyapuraM palAyadhvaM yuShmAnahaM tathyaM vachmi yAvanmanujasuto naiti tAvad isrAyeldeshIyasarvvanagarabhramaNaM samApayituM na shakShyatha|</para>
  <para style="p">
    <verse number="24" style="v"/>guroH shiShyo na mahAn, prabhordAso na mahAn|</para>
  <para style="p">
    <verse number="25" style="v"/>yadi shiShyo nijaguro rdAsashcha svaprabhoH samAno bhavati tarhi tad yatheShTaM| chettairgR^ihapatirbhUtarAja uchyate, tarhi parivArAH kiM tathA na vakShyante?</para>
  <para style="p">
    <verse number="26" style="v"/>kintu tebhyo yUyaM mA bibhIta, yato yanna prakAshiShyate, tAdR^ik ChAditaM kimapi nAsti, yachcha na vya nchiShyate, tAdR^ig guptaM kimapi nAsti|</para>
  <para style="p">
    <verse number="27" style="v"/>yadahaM yuShmAn tamasi vachmi tad yuShmAbhirdIptau kathyatAM; karNAbhyAM yat shrUyate tad gehopari prachAryyatAM|</para>
  <para style="p">
    <verse number="28" style="v"/>ye kAyaM hantuM shaknuvanti nAtmAnaM, tebhyo mA bhaiShTa; yaH kAyAtmAnau niraye nAshayituM, shaknoti, tato bibhIta|</para>
  <para style="p">
    <verse number="29" style="v"/>dvau chaTakau kimekatAmramudrayA na vikrIyete? tathApi yuShmattAtAnumatiM vinA teShAmekopi bhuvi na patati|</para>
  <para style="p">
    <verse number="30" style="v"/>yuShmachChirasAM sarvvakachA gaNitAMH santi|</para>
  <para style="p">
    <verse number="31" style="v"/>ato mA bibhIta, yUyaM bahuchaTakebhyo bahumUlyAH|</para>
  <para style="p">
    <verse number="32" style="v"/>yo manujasAkShAnmAma NgIkurute tamahaM svargasthatAtasAkShAda NgIkariShye|</para>
  <para style="p">
    <verse number="33" style="v"/>pR^ithvyAmahaM shAntiM dAtumAgata_iti mAnubhavata, shAntiM dAtuM na kintvasiM|</para>
  <para style="p">
    <verse number="34" style="v"/>pitR^imAtR^ishchashrUbhiH sAkaM sutasutAbadhU rvirodhayitu nchAgateाsmi|</para>
  <para style="p">
    <verse number="35" style="v"/>tataH svasvaparivAraeva nR^ishatru rbhavitA|</para>
  <para style="p">
    <verse number="36" style="v"/>yaH pitari mAtari vA mattodhikaM prIyate, sa na madarhaH;</para>
  <para style="p">
    <verse number="37" style="v"/>yashcha sute sutAyAM vA mattodhikaM prIyate, seाpi na madarhaH|</para>
  <para style="p">
    <verse number="38" style="v"/>yaH svakrushaM gR^ihlan matpashchAnnaiti, seाpi na madarhaH|</para>
  <para style="p">
    <verse number="39" style="v"/>yaH svaprANAnavati, sa tAn hArayiShyate, yastu matkR^ite svaprANAn hArayati, sa tAnavati|</para>
  <para style="p">
    <verse number="40" style="v"/>yo yuShmAkamAtithyaM vidadhAti, sa mamAtithyaM vidadhAti, yashcha mamAtithyaM vidadhAti, sa matprerakasyAtithyaM vidadhAti|</para>
  <para style="p">
    <verse number="41" style="v"/>yo bhaviShyadvAdIti j nAtvA tasyAtithyaM vidhatte, sa bhaviShyadvAdinaH phalaM lapsyate, yashcha dhArmmika iti viditvA tasyAtithyaM vidhatte sa dhArmmikamAnavasya phalaM prApsyati|</para>
  <para style="p">
    <verse number="42" style="v"/>yashcha kashchit eteShAM kShudranarANAm yaM ka nchanaikaM shiShya iti viditvA kaMsaikaM shItalasalilaM tasmai datte, yuShmAnahaM tathyaM vadAmi, sa kenApi prakAreNa phalena na va nchiShyate|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>itthaM yIshuH svadvAdashashiShyANAmAj nApanaM samApya pure pura upadeShTuM susaMvAdaM prachArayituM tatsthAnAt pratasthe|</para>
  <para style="p">
    <verse number="2" style="v"/>anantaraM yohan kArAyAM tiShThan khriShTasya karmmaNAM vArttaM prApya yasyAgamanavArttAsIt saeva kiM tvaM? vA vayamanyam apekShiShyAmahe?</para>
  <para style="p">
    <verse number="3" style="v"/>etat praShTuM nijau dvau shiShyau prAhiNot|</para>
  <para style="p">
    <verse number="4" style="v"/>yIshuH pratyavochat, andhA netrANi labhante, kha nchA gachChanti, kuShThinaH svasthA bhavanti, badhirAH shR^iNvanti, mR^itA jIvanta uttiShThanti, daridrANAM samIpe susaMvAdaH prachAryyata,</para>
  <para style="p">
    <verse number="5" style="v"/>etAni yadyad yuvAM shR^iNuthaH pashyathashcha gatvA tadvArttAM yohanaM gadataM|</para>
  <para style="p">
    <verse number="6" style="v"/>yasyAhaM na vighnIbhavAmi, saeva dhanyaH|</para>
  <para style="p">
    <verse number="7" style="v"/>anantaraM tayoH prasthitayo ryIshu ryohanam uddishya janAn jagAda, yUyaM kiM draShTuM vahirmadhyeprAntaram agachChata? kiM vAtena kampitaM nalaM?</para>
  <para style="p">
    <verse number="8" style="v"/>vA kiM vIkShituM vahirgatavantaH? kiM parihitasUkShmavasanaM manujamekaM? pashyata, ye sUkShmavasanAni paridadhati, te rAjadhAnyAM tiShThanti|</para>
  <para style="p">
    <verse number="9" style="v"/>tarhi yUyaM kiM draShTuM bahiragamata, kimekaM bhaviShyadvAdinaM? tadeva satyaM| yuShmAnahaM vadAmi, sa bhaviShyadvAdinopi mahAn;</para>
  <para style="p">
    <verse number="10" style="v"/>yataH, pashya svakIyadUtoyaM tvadagre preShyate mayA| sa gatvA tava panthAnaM smayak pariShkariShyati|| etadvachanaM yamadhi likhitamAste so.ayaM yohan|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaM yuShmAnahaM tathyaM bravImi, majjayitu ryohanaH shreShThaH kopi nArIto nAjAyata; tathApi svargarAjyamadhye sarvvebhyo yaH kShudraH sa yohanaH shreShThaH|</para>
  <para style="p">
    <verse number="12" style="v"/>apara ncha A yohano.adya yAvat svargarAjyaM balAdAkrAntaM bhavati Akraminashcha janA balena tadadhikurvvanti|</para>
  <para style="p">
    <verse number="13" style="v"/>yato yohanaM yAvat sarvvabhaviShyadvAdibhi rvyavasthayA cha upadeshaH prAkAshyata|</para>
  <para style="p">
    <verse number="14" style="v"/>yadi yUyamidaM vAkyaM grahItuM shaknutha, tarhi shreyaH, yasyAgamanasya vachanamAste so.ayam eliyaH|</para>
  <para style="p">
    <verse number="15" style="v"/>yasya shrotuM karNau staH sa shR^iNotu|</para>
  <para style="p">
    <verse number="16" style="v"/>ete vidyamAnajanAH kai rmayopamIyante? ye bAlakA haTTa upavishya svaM svaM bandhumAhUya vadanti,</para>
  <para style="p">
    <verse number="17" style="v"/>vayaM yuShmAkaM samIpe vaMshIravAdayAma, kintu yUyaM nAnR^ityata; yuShmAkaM samIpe cha vayamarodima, kintu yUyaM na vyalapata, tAdR^ishai rbAlakaista upamAyiShyante|</para>
  <para style="p">
    <verse number="18" style="v"/>yato yohan Agatya na bhuktavAn na pItavAMshcha, tena lokA vadanti, sa bhUtagrasta iti|</para>
  <para style="p">
    <verse number="19" style="v"/>manujasuta Agatya bhuktavAn pItavAMshcha, tena lokA vadanti, pashyata eSha bhoktA madyapAtA chaNDAlapApinAM bandhashcha, kintu j nAnino j nAnavyavahAraM nirdoShaM jAnanti|</para>
  <para style="p">
    <verse number="20" style="v"/>sa yatra yatra pure bahvAshcharyyaM karmma kR^itavAn, tannivAsinAM manaHparAvR^ittyabhAvAt tAni nagarANi prati hantetyuktA kathitavAn,</para>
  <para style="p">
    <verse number="21" style="v"/>hA korAsIn, hA baitsaide, yuShmanmadhye yadyadAshcharyyaM karmma kR^itaM yadi tat sorasIdonnagara akAriShyata, tarhi pUrvvameva tannivAsinaH shANavasane bhasmani chopavishanto manAMsi parAvarttiShyanta|</para>
  <para style="p">
    <verse number="22" style="v"/>tasmAdahaM yuShmAn vadAmi, vichAradine yuShmAkaM dashAtaH sorasIdono rdashA sahyatarA bhaviShyati|</para>
  <para style="p">
    <verse number="23" style="v"/>apara ncha bata kapharnAhUm, tvaM svargaM yAvadunnatosi, kintu narake nikShepsyase, yasmAt tvayi yAnyAshcharyyANi karmmaNyakAriShata, yadi tAni sidomnagara akAriShyanta, tarhi tadadya yAvadasthAsyat|</para>
  <para style="p">
    <verse number="24" style="v"/>kintvahaM yuShmAn vadAmi, vichAradine tava daNDataH sidomo daNDo sahyataro bhaviShyati|</para>
  <para style="p">
    <verse number="25" style="v"/>etasminneva samaye yIshuH punaruvAcha, he svargapR^ithivyorekAdhipate pitastvaM j nAnavato viduShashcha lokAn pratyetAni na prakAshya bAlakAn prati prakAshitavAn, iti hetostvAM dhanyaM vadAmi|</para>
  <para style="p">
    <verse number="26" style="v"/>he pitaH, itthaM bhavet yata idaM tvadR^iShTAvuttamaM|</para>
  <para style="p">
    <verse number="27" style="v"/>pitrA mayi sarvvANi samarpitAni, pitaraM vinA kopi putraM na jAnAti, yAn prati putreNa pitA prakAshyate tAn vinA putrAd anyaH kopi pitaraM na jAnAti|</para>
  <para style="p">
    <verse number="28" style="v"/>he parishrAntA bhArAkrAntAshcha lokA yUyaM matsannidhim AgachChata, ahaM yuShmAn vishramayiShyAmi|</para>
  <para style="p">
    <verse number="29" style="v"/>ahaM kShamaNashIlo namramanAshcha, tasmAt mama yugaM sveShAmupari dhArayata mattaH shikShadhva ncha, tena yUyaM sve sve manasi vishrAmaM lapsyadhbe|</para>
  <para style="p">
    <verse number="30" style="v"/>yato mama yugam anAyAsaM mama bhArashcha laghuH|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM yIshu rvishrAmavAre shsyamadhyena gachChati, tadA tachChiShyA bubhukShitAH santaH shsyama njarIshChatvA ChitvA khAditumArabhanta|</para>
  <para style="p">
    <verse number="2" style="v"/>tad vilokya phirUshino yIshuM jagaduH, pashya vishrAmavAre yat karmmAkarttavyaM tadeva tava shiShyAH kurvvanti|</para>
  <para style="p">
    <verse number="3" style="v"/>sa tAn pratyAvadata, dAyUd tatsa Nginashcha bubhukShitAH santo yat karmmAkurvvan tat kiM yuShmAbhi rnApAThi?</para>
  <para style="p">
    <verse number="4" style="v"/>ye darshanIyAH pUpAH yAjakAn vinA tasya tatsa NgimanujAnA nchAbhojanIyAsta IshvarAvAsaM praviShTena tena bhuktAH|</para>
  <para style="p">
    <verse number="5" style="v"/>anyachcha vishrAmavAre madhyemandiraM vishrAmavArIyaM niyamaM la Nvantopi yAjakA nirdoShA bhavanti, shAstramadhye kimidamapi yuShmAbhi rna paThitaM?</para>
  <para style="p">
    <verse number="6" style="v"/>yuShmAnahaM vadAmi, atra sthAne mandirAdapi garIyAn eka Aste|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu dayAyAM me yathA prIti rna tathA yaj nakarmmaNi| etadvachanasyArthaM yadi yuyam aj nAsiShTa tarhi nirdoShAn doShiNo nAkArShTa|</para>
  <para style="p">
    <verse number="8" style="v"/>anyachcha manujasuto vishrAmavArasyApi patirAste|</para>
  <para style="p">
    <verse number="9" style="v"/>anantaraM sa tatsthAnAt prasthAya teShAM bhajanabhavanaM praviShTavAn, tadAnIm ekaH shuShkakarAmayavAn upasthitavAn|</para>
  <para style="p">
    <verse number="10" style="v"/>tato yIshum apavadituM mAnuShAH paprachChuH, vishrAmavAre nirAmayatvaM karaNIyaM na vA?</para>
  <para style="p">
    <verse number="11" style="v"/>tena sa pratyuvAcha, vishrAmavAre yadi kasyachid avi rgartte patati, tarhi yastaM ghR^itvA na tolayati, etAdR^isho manujo yuShmAkaM madhye ka Aste?</para>
  <para style="p">
    <verse number="12" style="v"/>ave rmAnavaH kiM nahi shreyAn? ato vishrAmavAre hitakarmma karttavyaM|</para>
  <para style="p">
    <verse number="13" style="v"/>anantaraM sa taM mAnavaM gaditavAn, karaM prasAraya; tena kare prasArite sonyakaravat svastho.abhavat|</para>
  <para style="p">
    <verse number="14" style="v"/>tadA phirUshino bahirbhUya kathaM taM haniShyAma iti kumantraNAM tatprAtikUlyena chakruH|</para>
  <para style="p">
    <verse number="15" style="v"/>tato yIshustad viditvA sthanAntaraM gatavAn; anyeShu bahunareShu tatpashchAd gateShu tAn sa nirAmayAn kR^itvA ityAj nApayat,</para>
  <para style="p">
    <verse number="16" style="v"/>yUyaM mAM na parichAyayata|</para>
  <para style="p">
    <verse number="17" style="v"/>tasmAt mama prIyo manonIto manasastuShTikArakaH| madIyaH sevako yastu vidyate taM samIkShatAM| tasyopari svakIyAtmA mayA saMsthApayiShyate| tenAnyadeshajAteShu vyavasthA saMprakAshyate|</para>
  <para style="p">
    <verse number="18" style="v"/>kenApi na virodhaM sa vivAda ncha kariShyati| na cha rAjapathe tena vachanaM shrAvayiShyate|</para>
  <para style="p">
    <verse number="19" style="v"/>vyavasthA chalitA yAvat nahi tena kariShyate| tAvat nalo vidIrNo.api bhaMkShyate nahi tena cha| tathA sadhUmavartti ncha na sa nirvvApayiShyate|</para>
  <para style="p">
    <verse number="20" style="v"/>pratyAshA ncha kariShyanti tannAmni bhinnadeshajAH|</para>
  <para style="p">
    <verse number="21" style="v"/>yAnyetAni vachanAni yishayiyabhaviShyadvAdinA proktAnyAsan, tAni saphalAnyabhavan|</para>
  <para style="p">
    <verse number="22" style="v"/>anantaraM lokai statsamIpam AnIto bhUtagrastAndhamUkaikamanujastena svasthIkR^itaH, tataH so.andho mUko draShTuM vaktu nchArabdhavAn|</para>
  <para style="p">
    <verse number="23" style="v"/>anena sarvve vismitAH kathayA nchakruH, eShaH kiM dAyUdaH santAno nahi?</para>
  <para style="p">
    <verse number="24" style="v"/>kintu phirUshinastat shrutvA gaditavantaH, bAlsibUbnAmno bhUtarAjasya sAhAyyaM vinA nAyaM bhUtAn tyAjayati|</para>
  <para style="p">
    <verse number="25" style="v"/>tadAnIM yIshusteShAm iti mAnasaM vij nAya tAn avadat ki nchana rAjyaM yadi svavipakShAd bhidyate, tarhi tat uchChidyate; yachcha ki nchana nagaraM vA gR^ihaM svavipakShAd vibhidyate, tat sthAtuM na shaknoti|</para>
  <para style="p">
    <verse number="26" style="v"/>tadvat shayatAno yadi shayatAnaM bahiH kR^itvA svavipakShAt pR^ithak pR^ithak bhavati, tarhi tasya rAjyaM kena prakAreNa sthAsyati?</para>
  <para style="p">
    <verse number="27" style="v"/>aha ncha yadi bAlsibUbA bhUtAn tyAjayAmi, tarhi yuShmAkaM santAnAH kena bhUtAn tyAjayanti? tasmAd yuShmAkam etadvichArayitArasta eva bhaviShyanti|</para>
  <para style="p">
    <verse number="28" style="v"/>kintavahaM yadIshvarAtmanA bhUtAn tyAjayAmi, tarhIshvarasya rAjyaM yuShmAkaM sannidhimAgatavat|</para>
  <para style="p">
    <verse number="29" style="v"/>anya ncha kopi balavanta janaM prathamato na badvvA kena prakAreNa tasya gR^ihaM pravishya taddravyAdi loThayituM shaknoti? kintu tat kR^itvA tadIyagR^isya dravyAdi loThayituM shaknoti|</para>
  <para style="p">
    <verse number="30" style="v"/>yaH kashchit mama svapakShIyo nahi sa vipakShIya Aste, yashcha mayA sAkaM na saMgR^ihlAti, sa vikirati|</para>
  <para style="p">
    <verse number="31" style="v"/>ataeva yuShmAnahaM vadAmi, manujAnAM sarvvaprakArapApAnAM nindAyAshcha marShaNaM bhavituM shaknoti, kintu pavitrasyAtmano viruddhanindAyA marShaNaM bhavituM na shaknoti|</para>
  <para style="p">
    <verse number="32" style="v"/>yo manujasutasya viruddhAM kathAM kathayati, tasyAparAdhasya kShamA bhavituM shaknoti, kintu yaH kashchit pavitrasyAtmano viruddhAM kathAM kathayati nehaloke na pretya tasyAparAdhasya kShamA bhavituM shaknoti|</para>
  <para style="p">
    <verse number="33" style="v"/>pAdapaM yadi bhadraM vadatha, tarhi tasya phalamapi sAdhu vaktavyaM, yadi cha pAdapaM asAdhuM vadatha, tarhi tasya phalamapyasAdhu vaktavyaM; yataH svIyasvIyaphalena pAdapaH parichIyate|</para>
  <para style="p">
    <verse number="34" style="v"/>re bhujagavaMshA yUyamasAdhavaH santaH kathaM sAdhu vAkyaM vaktuM shakShyatha? yasmAd antaHkaraNasya pUrNabhAvAnusArAd vadanAd vacho nirgachChati|</para>
  <para style="p">
    <verse number="35" style="v"/>tena sAdhurmAnavo.antaHkaraNarUpAt sAdhubhANDAgArAt sAdhu dravyaM nirgamayati, asAdhurmAnuShastvasAdhubhANDAgArAd asAdhuvastUni nirgamayati|</para>
  <para style="p">
    <verse number="36" style="v"/>kintvahaM yuShmAn vadAmi, manujA yAvantyAlasyavachAMsi vadanti, vichAradine taduttaramavashyaM dAtavyaM,</para>
  <para style="p">
    <verse number="37" style="v"/>yatastvaM svIyavachobhi rniraparAdhaH svIyavachobhishcha sAparAdho gaNiShyase|</para>
  <para style="p">
    <verse number="38" style="v"/>tadAnIM katipayA upAdhyAyAH phirUshinashcha jagaduH, he guro vayaM bhavattaH ki nchana lakShma didR^ikShAmaH|</para>
  <para style="p">
    <verse number="39" style="v"/>tadA sa pratyuktavAn, duShTo vyabhichArI cha vaMsho lakShma mR^igayate, kintu bhaviShyadvAdino yUnaso lakShma vihAyAnyat kimapi lakShma te na pradarshayiShyante|</para>
  <para style="p">
    <verse number="40" style="v"/>yato yUnam yathA tryahorAtraM bR^ihanmInasya kukShAvAsIt, tathA manujaputropi tryahorAtraM medinyA madhye sthAsyati|</para>
  <para style="p">
    <verse number="41" style="v"/>aparaM nInivIyA mAnavA vichAradina etadvaMshIyAnAM pratikUlam utthAya tAn doShiNaH kariShyanti, yasmAtte yUnasa upadeshAt manAMsi parAvarttayA nchakrire, kintvatra yUnasopi gurutara eka Aste|</para>
  <para style="p">
    <verse number="42" style="v"/>punashcha dakShiNadeshIyA rAj nI vichAradina etadvaMshIyAnAM pratikUlamutthAya tAn doShiNaH kariShyati yataH sA rAj nI sulemano vidyAyAH kathAM shrotuM medinyAH sImna AgachChat, kintu sulemanopi gurutara eko jano.atra Aste|</para>
  <para style="p">
    <verse number="43" style="v"/>aparaM manujAd bahirgato .apavitrabhUtaH shuShkasthAnena gatvA vishrAmaM gaveShayati, kintu tadalabhamAnaH sa vakti, yasmA; niketanAd AgamaM, tadeva veshma pakAvR^itya yAmi|</para>
  <para style="p">
    <verse number="44" style="v"/>pashchAt sa tat sthAnam upasthAya tat shUnyaM mArjjitaM shobhita ncha vilokya vrajan svatopi duShTatarAn anyasaptabhUtAn sa NginaH karoti|</para>
  <para style="p">
    <verse number="45" style="v"/>tataste tat sthAnaM pravishya nivasanti, tena tasya manujasya sheShadashA pUrvvadashAtotIvAshubhA bhavati, eteShAM duShTavaMshyAnAmapi tathaiva ghaTiShyate|</para>
  <para style="p">
    <verse number="46" style="v"/>mAnavebhya etAsAM kathanAM kathanakAle tasya mAtA sahajAshcha tena sAkaM kA nchit kathAM kathayituM vA nChanto bahireva sthitavantaH|</para>
  <para style="p">
    <verse number="47" style="v"/>tataH kashchit tasmai kathitavAn, pashya tava jananI sahajAshcha tvayA sAkaM kA nchana kathAM kathayituM kAmayamAnA bahistiShThanti|</para>
  <para style="p">
    <verse number="48" style="v"/>kintu sa taM pratyavadat, mama kA jananI? ke vA mama sahajAH?</para>
  <para style="p">
    <verse number="49" style="v"/>pashchAt shiShyAn prati karaM prasAryya kathitavAn, pashya mama jananI mama sahajAshchaite;</para>
  <para style="p">
    <verse number="50" style="v"/>yaH kashchit mama svargasthasya pituriShTaM karmma kurute, saeva mama bhrAtA bhaginI jananI cha|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>apara ncha tasmin dine yIshuH sadmano gatvA saritpate rodhasi samupavivesha|</para>
  <para style="p">
    <verse number="2" style="v"/>tatra tatsannidhau bahujanAnAM nivahopasthiteH sa taraNimAruhya samupAvishat, tena mAnavA rodhasi sthitavantaH|</para>
  <para style="p">
    <verse number="3" style="v"/>tadAnIM sa dR^iShTAntaistAn itthaM bahusha upadiShTavAn| pashyata, kashchit kR^iShIvalo bIjAni vaptuM bahirjagAma,</para>
  <para style="p">
    <verse number="4" style="v"/>tasya vapanakAle katipayabIjeShu mArgapArshve patiteShu vihagAstAni bhakShitavantaH|</para>
  <para style="p">
    <verse number="5" style="v"/>aparaM katipayabIjeShu stokamR^idyuktapAShANe patiteShu mR^idalpatvAt tatkShaNAt tAnya NkuritAni,</para>
  <para style="p">
    <verse number="6" style="v"/>kintu ravAvudite dagdhAni teShAM mUlApraviShTatvAt shuShkatAM gatAni cha|</para>
  <para style="p">
    <verse number="7" style="v"/>aparaM katipayabIjeShu kaNTakAnAM madhye patiteShu kaNTakAnyedhitvA tAni jagrasuH|</para>
  <para style="p">
    <verse number="8" style="v"/>apara ncha katipayabIjAni urvvarAyAM patitAni; teShAM madhye kAnichit shataguNAni kAnichit ShaShTiguNAni kAnichit triMshaguMNAni phalAni phalitavanti|</para>
  <para style="p">
    <verse number="9" style="v"/>shrotuM yasya shrutI AsAte sa shR^iNuyAt|</para>
  <para style="p">
    <verse number="10" style="v"/>anantaraM shiShyairAgatya so.apR^ichChyata, bhavatA tebhyaH kuto dR^iShTAntakathA kathyate?</para>
  <para style="p">
    <verse number="11" style="v"/>tataH sa pratyavadat, svargarAjyasya nigUDhAM kathAM vedituM yuShmabhyaM sAmarthyamadAyi, kintu tebhyo nAdAyi|</para>
  <para style="p">
    <verse number="12" style="v"/>yasmAd yasyAntike varddhate, tasmAyeva dAyiShyate, tasmAt tasya bAhulyaM bhaviShyati, kintu yasyAntike na varddhate, tasya yat ki nchanAste, tadapi tasmAd AdAyiShyate|</para>
  <para style="p">
    <verse number="13" style="v"/>te pashyantopi na pashyanti, shR^iNvantopi na shR^iNvanti, budhyamAnA api na budhyante cha, tasmAt tebhyo dR^iShTAntakathA kathyate|</para>
  <para style="p">
    <verse number="14" style="v"/>yathA karNaiH shroShyatha yUyaM vai kintu yUyaM na bhotsyatha| netrairdrakShyatha yUya ncha parij nAtuM na shakShyatha| te mAnuShA yathA naiva paripashyanti lochanaiH| karNai ryathA na shR^iNvanti na budhyante cha mAnasaiH| vyAvarttiteShu chitteShu kAle kutrApi tairjanaiH| mattaste manujAH svasthA yathA naiva bhavanti cha| tathA teShAM manuShyANAM kriyante sthUlabuddhayaH| badhirIbhUtakarNAshcha jAtAshcha mudritA dR^ishaH|</para>
  <para style="p">
    <verse number="15" style="v"/>yadetAni vachanAni yishayiyabhaviShyadvAdinA proktAni teShu tAni phalanti|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yuShmAkaM nayanAni dhanyAni, yasmAt tAni vIkShante; dhanyAshcha yuShmAkaM shabdagrahAH, yasmAt tairAkarNyate|</para>
  <para style="p">
    <verse number="17" style="v"/>mayA yUyaM tathyaM vachAmi yuShmAbhi ryadyad vIkShyate, tad bahavo bhaviShyadvAdino dhArmmikAshcha mAnavA didR^ikShantopi draShTuM nAlabhanta, punashcha yUyaM yadyat shR^iNutha, tat te shushrUShamANA api shrotuM nAlabhanta|</para>
  <para style="p">
    <verse number="18" style="v"/>kR^iShIvalIyadR^iShTAntasyArthaM shR^iNuta|</para>
  <para style="p">
    <verse number="19" style="v"/>mArgapArshve bIjAnyuptAni tasyArtha eShaH, yadA kashchit rAjyasya kathAM nishamya na budhyate, tadA pApAtmAgatya tadIyamanasa uptAM kathAM haran nayati|</para>
  <para style="p">
    <verse number="20" style="v"/>aparaM pAShANasthale bIjAnyuptAni tasyArtha eShaH; kashchit kathAM shrutvaiva harShachittena gR^ihlAti,</para>
  <para style="p">
    <verse number="21" style="v"/>kintu tasya manasi mUlApraviShTatvAt sa ki nchitkAlamAtraM sthirastiShThati; pashchAta tatkathAkAraNAt kopi klestADanA vA chet jAyate, tarhi sa tatkShaNAd vighnameti|</para>
  <para style="p">
    <verse number="22" style="v"/>aparaM kaNTakAnAM madhye bIjAnyuptAni tadartha eShaH; kenachit kathAyAM shrutAyAM sAMsArikachintAbhi rbhrAntibhishcha sA grasyate, tena sA mA viphalA bhavati|</para>
  <para style="p">
    <verse number="23" style="v"/>aparam urvvarAyAM bIjAnyuptAni tadartha eShaH; ye tAM kathAM shrutvA vudhyante, te phalitAH santaH kechit shataguNAni kechita ShaShTiguNAni kechichcha triMshadguNAni phalAni janayanti|</para>
  <para style="p">
    <verse number="24" style="v"/>anantaraM soparAmekAM dR^iShTAntakathAmupasthApya tebhyaH kathayAmAsa; svargIyarAjyaM tAdR^ishena kenachid gR^ihasthenopamIyate, yena svIyakShetre prashastabIjAnyaupyanta|</para>
  <para style="p">
    <verse number="25" style="v"/>kintu kShaNadAyAM sakalalokeShu supteShu tasya ripurAgatya teShAM godhUmabIjAnAM madhye vanyayavamabIjAnyuptvA vavrAja|</para>
  <para style="p">
    <verse number="26" style="v"/>tato yadA bIjebhyo.a NkarA jAyamAnAH kaNishAni ghR^itavantaH; tadA vanyayavasAnyapi dR^ishyamAnAnyabhavan|</para>
  <para style="p">
    <verse number="27" style="v"/>tato gR^ihasthasya dAseyA Agamya tasmai kathayA nchakruH, he mahechCha, bhavatA kiM kShetre bhadrabIjAni naupyanta? tathAtve vanyayavasAni kR^ita Ayan?</para>
  <para style="p">
    <verse number="28" style="v"/>tadAnIM tena te pratigaditAH, kenachit ripuNA karmmadamakAri| dAseyAH kathayAmAsuH, vayaM gatvA tAnyutpAyya kShipAmo bhavataH kIdR^ishIchChA jAyate?</para>
  <para style="p">
    <verse number="29" style="v"/>tenAvAdi, nahi, sha Nke.ahaM vanyayavasotpATanakAle yuShmAbhistaiH sAkaM godhUmA apyutpATiShyante|</para>
  <para style="p">
    <verse number="30" style="v"/>ataH shsyakarttanakAlaM yAvad ubhayAnyapi saha varddhantAM, pashchAt karttanakAle karttakAn vakShyAmi, yUyamAdau vanyayavasAni saMgR^ihya dAhayituM vITikA badvvA sthApayata; kintu sarvve godhUmA yuShmAbhi rbhANDAgAraM nItvA sthApyantAm|</para>
  <para style="p">
    <verse number="31" style="v"/>anantaraM soparAmekAM dR^iShTAntakathAmutthApya tebhyaH kathitavAn kashchinmanujaH sarShapabIjamekaM nItvA svakShetra uvApa|</para>
  <para style="p">
    <verse number="32" style="v"/>sarShapabIjaM sarvvasmAd bIjAt kShudramapi sada NkuritaM sarvvasmAt shAkAt bR^ihad bhavati; sa tAdR^ishastaru rbhavati, yasya shAkhAsu nabhasaH khagA Agatya nivasanti; svargIyarAjyaM tAdR^ishasya sarShapaikasya samam|</para>
  <para style="p">
    <verse number="33" style="v"/>punarapi sa upamAkathAmekAM tebhyaH kathayA nchakAra; kAchana yoShit yat kiNvamAdAya droNatrayamitagodhUmachUrNAnAM madhye sarvveShAM mishrIbhavanaparyyantaM samAchChAdya nidhattavatI, tatkiNvamiva svargarAjyaM|</para>
  <para style="p">
    <verse number="34" style="v"/>itthaM yIshu rmanujanivahAnAM sannidhAvupamAkathAbhiretAnyAkhyAnAni kathitavAn upamAM vinA tebhyaH kimapi kathAM nAkathayat|</para>
  <para style="p">
    <verse number="35" style="v"/>etena dR^iShTAntIyena vAkyena vyAdAya vadanaM nijaM| ahaM prakAshayiShyAmi guptavAkyaM purAbhavaM| yadetadvachanaM bhaviShyadvAdinA proktamAsIt, tat siddhamabhavat|</para>
  <para style="p">
    <verse number="36" style="v"/>sarvvAn manujAn visR^ijya yIshau gR^ihaM praviShTe tachChiShyA Agatya yIshave kathitavantaH, kShetrasya vanyayavasIyadR^iShTAntakathAm bhavAna asmAn spaShTIkR^itya vadatu|</para>
  <para style="p">
    <verse number="37" style="v"/>tataH sa pratyuvAcha, yena bhadrabIjAnyupyante sa manujaputraH,</para>
  <para style="p">
    <verse number="38" style="v"/>kShetraM jagat, bhadrabIjAnI rAjyasya santAnAH,</para>
  <para style="p">
    <verse number="39" style="v"/>vanyayavasAni pApAtmanaH santAnAH| yena ripuNA tAnyuptAni sa shayatAnaH, karttanasamayashcha jagataH sheShaH, karttakAH svargIyadUtAH|</para>
  <para style="p">
    <verse number="40" style="v"/>yathA vanyayavasAni saMgR^ihya dAhyante, tathA jagataH sheShe bhaviShyati;</para>
  <para style="p">
    <verse number="41" style="v"/>arthAt manujasutaH svAMyadUtAn preShayiShyati, tena te cha tasya rAjyAt sarvvAn vighnakAriNo.adhArmmikalokAMshcha saMgR^ihya</para>
  <para style="p">
    <verse number="42" style="v"/>yatra rodanaM dantagharShaNa ncha bhavati, tatrAgnikuNDe nikShepsyanti|</para>
  <para style="p">
    <verse number="43" style="v"/>tadAnIM dhArmmikalokAH sveShAM pitU rAjye bhAskara_iva tejasvino bhaviShyanti| shrotuM yasya shrutI AsAte, ma shR^iNuyAt|</para>
  <para style="p">
    <verse number="44" style="v"/>apara ncha kShetramadhye nidhiM pashyan yo gopayati, tataH paraM sAnando gatvA svIyasarvvasvaM vikrIya ttakShetraM krINAti, sa iva svargarAjyaM|</para>
  <para style="p">
    <verse number="45" style="v"/>anya ncha yo vaNik uttamAM muktAM gaveShayan</para>
  <para style="p">
    <verse number="46" style="v"/>mahArghAM muktAM vilokya nijasarvvasvaM vikrIya tAM krINAti, sa iva svargarAjyaM|</para>
  <para style="p">
    <verse number="47" style="v"/>punashcha samudro nikShiptaH sarvvaprakAramInasaMgrAhyAnAya_iva svargarAjyaM|</para>
  <para style="p">
    <verse number="48" style="v"/>tasmin AnAye pUrNe janA yathA rodhasyuttolya samupavishya prashastamInAn saMgrahya bhAjaneShu nidadhate, kutsitAn nikShipanti;</para>
  <para style="p">
    <verse number="49" style="v"/>tathaiva jagataH sheShe bhaviShyati, phalataH svargIyadUtA Agatya puNyavajjanAnAM madhyAt pApinaH pR^ithak kR^itvA vahnikuNDe nikShepsyanti,</para>
  <para style="p">
    <verse number="50" style="v"/>tatra rodanaM dantai rdantagharShaNa ncha bhaviShyataH|</para>
  <para style="p">
    <verse number="51" style="v"/>yIshunA te pR^iShTA yuShmAbhiH kimetAnyAkhyAnAnyabudhyanta? tadA te pratyavadan, satyaM prabho|</para>
  <para style="p">
    <verse number="52" style="v"/>tadAnIM sa kathitavAn, nijabhANDAgArAt navInapurAtanAni vastUni nirgamayati yo gR^ihasthaH sa iva svargarAjyamadhi shikShitAH svarva upadeShTAraH|</para>
  <para style="p">
    <verse number="53" style="v"/>anantaraM yIshuretAH sarvvA dR^iShTAntakathAH samApya tasmAt sthAnAt pratasthe| aparaM svadeshamAgatya janAn bhajanabhavana upadiShTavAn;</para>
  <para style="p">
    <verse number="54" style="v"/>te vismayaM gatvA kathitavanta etasyaitAdR^ishaM j nAnam AshcharyyaM karmma cha kasmAd ajAyata?</para>
  <para style="p">
    <verse number="55" style="v"/>kimayaM sUtradhArasya putro nahi? etasya mAtu rnAma cha kiM mariyam nahi? yAkub-yUShaph-shimon-yihUdAshcha kimetasya bhrAtaro nahi?</para>
  <para style="p">
    <verse number="56" style="v"/>etasya bhaginyashcha kimasmAkaM madhye na santi? tarhi kasmAdayametAni labdhavAn? itthaM sa teShAM vighnarUpo babhUva;</para>
  <para style="p">
    <verse number="57" style="v"/>tato yIshunA nigaditaM svadeshIyajanAnAM madhyaM vinA bhaviShyadvAdI kutrApyanyatra nAsammAnyo bhavatI|</para>
  <para style="p">
    <verse number="58" style="v"/>teShAmavishvAsahetoH sa tatra sthAne bahvAshcharyyakarmmANi na kR^itavAn|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadAnIM rAjA herod yIsho ryashaH shrutvA nijadAseyAn jagAd,</para>
  <para style="p">
    <verse number="2" style="v"/>eSha majjayitA yohan, pramitebhayastasyotthAnAt tenetthamadbhutaM karmma prakAshyate|</para>
  <para style="p">
    <verse number="3" style="v"/>purA herod nijabhrAtu: philipo jAyAyA herodIyAyA anurodhAd yohanaM dhArayitvA baddhA kArAyAM sthApitavAn|</para>
  <para style="p">
    <verse number="4" style="v"/>yato yohan uktavAn, etsayAH saMgraho bhavato nochitaH|</para>
  <para style="p">
    <verse number="5" style="v"/>tasmAt nR^ipatistaM hantumichChannapi lokebhyo vibhayA nchakAra; yataH sarvve yohanaM bhaviShyadvAdinaM menire|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu herodo janmAhIyamaha upasthite herodIyAyA duhitA teShAM samakShaM nR^ititvA herodamaprINyat|</para>
  <para style="p">
    <verse number="7" style="v"/>tasmAt bhUpatiH shapathaM kurvvan iti pratyaj nAsIt, tvayA yad yAchyate, tadevAhaM dAsyAmi|</para>
  <para style="p">
    <verse number="8" style="v"/>sA kumArI svIyamAtuH shikShAM labdhA babhAShe, majjayituryohana uttamA NgaM bhAjane samAnIya mahyaM vishrANaya|</para>
  <para style="p">
    <verse number="9" style="v"/>tato rAjA shushocha, kintu bhojanAyopavishatAM sa NginAM svakR^itashapathasya chAnurodhAt tat pradAtuma Adidesha|</para>
  <para style="p">
    <verse number="10" style="v"/>pashchAt kArAM prati naraM prahitya yohana uttamA NgaM ChittvA</para>
  <para style="p">
    <verse number="11" style="v"/>tat bhAjana AnAyya tasyai kumAryyai vyashrANayat, tataH sA svajananyAH samIpaM tanninAya|</para>
  <para style="p">
    <verse number="12" style="v"/>pashchAt yohanaH shiShyA Agatya kAyaM nItvA shmashAne sthApayAmAsustato yIshoH sannidhiM vrajitvA tadvArttAM babhAShire|</para>
  <para style="p">
    <verse number="13" style="v"/>anantaraM yIshuriti nishabhya nAvA nirjanasthAnam ekAkI gatavAn, pashchAt mAnavAstat shrutvA nAnAnagarebhya Agatya padaistatpashchAd IyuH|</para>
  <para style="p">
    <verse number="14" style="v"/>tadAnIM yIshu rbahirAgatya mahAntaM jananivahaM nirIkShya teShu kAruNikaH man teShAM pIDitajanAn nirAmayAn chakAra|</para>
  <para style="p">
    <verse number="15" style="v"/>tataH paraM sandhyAyAM shiShyAstadantikamAgatya kathayA nchakruH, idaM nirjanasthAnaM velApyavasannA; tasmAt manujAn svasvagrAmaM gantuM svArthaM bhakShyANi kretu ncha bhavAn tAn visR^ijatu|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yIshustAnavAdIt, teShAM gamane prayojanaM nAsti, yUyameva tAn bhojayata|</para>
  <para style="p">
    <verse number="17" style="v"/>tadA te pratyavadan, asmAkamatra pUpapa nchakaM mInadvaya nchAste|</para>
  <para style="p">
    <verse number="18" style="v"/>tadAnIM tenoktaM tAni madantikamAnayata|</para>
  <para style="p">
    <verse number="19" style="v"/>anantaraM sa manujAn yavasoparyyupaveShTum Aj nApayAmAsa; apara tat pUpapa nchakaM mInadvaya ncha gR^ihlan svargaM prati nirIkShyeshvarIyaguNAn anUdya bhaMktvA shiShyebhyo dattavAn, shiShyAshcha lokebhyo daduH|</para>
  <para style="p">
    <verse number="20" style="v"/>tataH sarvve bhuktvA paritR^iptavantaH, tatastadavashiShTabhakShyaiH pUrNAn dvAdashaDalakAn gR^ihItavantaH|</para>
  <para style="p">
    <verse number="21" style="v"/>te bhoktAraH strIrbAlakAMshcha vihAya prAyeNa pa ncha sahasrANi pumAMsa Asan|</para>
  <para style="p">
    <verse number="22" style="v"/>tadanantaraM yIshu rlokAnAM visarjanakAle shiShyAn taraNimAroDhuM svAgre pAraM yAtu ncha gADhamAdiShTavAn|</para>
  <para style="p">
    <verse number="23" style="v"/>tato lokeShu visR^iShTeShu sa vivikte prArthayituM girimekaM gatvA sandhyAM yAvat tatraikAkI sthitavAn|</para>
  <para style="p">
    <verse number="24" style="v"/>kintu tadAnIM sammukhavAtatvAt saritpate rmadhye tara NgaistaraNirdolAyamAnAbhavat|</para>
  <para style="p">
    <verse number="25" style="v"/>tadA sa yAminyAshchaturthaprahare padbhyAM vrajan teShAmantikaM gatavAn|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu shiShyAstaM sAgaropari vrajantaM vilokya samudvignA jagaduH, eSha bhUta iti sha NkamAnA uchchaiH shabdAyA nchakrire cha|</para>
  <para style="p">
    <verse number="27" style="v"/>tadaiva yIshustAnavadat, susthirA bhavata, mA bhaiShTa, eSho.aham|</para>
  <para style="p">
    <verse number="28" style="v"/>tataH pitara ityuktavAn, he prabho, yadi bhavAneva, tarhi mAM bhavatsamIpaM yAtumAj nApayatu|</para>
  <para style="p">
    <verse number="29" style="v"/>tataH tenAdiShTaH pitarastaraNito.avaruhya yIsheाrantikaM prAptuM toyopari vavrAja|</para>
  <para style="p">
    <verse number="30" style="v"/>kintu prachaNDaM pavanaM vilokya bhayAt toye maMktum Arebhe, tasmAd uchchaiH shabdAyamAnaH kathitavAn, he prabho, mAmavatu|</para>
  <para style="p">
    <verse number="31" style="v"/>yIshustatkShaNAt karaM prasAryya taM dharan uktavAn, ha stokapratyayin tvaM kutaH samashethAH?</para>
  <para style="p">
    <verse number="32" style="v"/>anantaraM tayostaraNimArUDhayoH pavano nivavR^ite|</para>
  <para style="p">
    <verse number="33" style="v"/>tadAnIM ye taraNyAmAsan, ta Agatya taM praNabhya kathitavantaH, yathArthastvameveshvarasutaH|</para>
  <para style="p">
    <verse number="34" style="v"/>anantaraM pAraM prApya te gineSharannAmakaM nagaramupatasthuH,</para>
  <para style="p">
    <verse number="35" style="v"/>tadA tatratyA janA yIshuM parichIya taddeshsya chaturdisho vArttAM prahitya yatra yAvantaH pIDitA Asan, tAvataeva tadantikamAnayAmAsuH|</para>
  <para style="p">
    <verse number="36" style="v"/>aparaM tadIyavasanasya granthimAtraM spraShTuM vinIya yAvanto janAstat sparshaM chakrire, te sarvvaeva nirAmayA babhUvuH|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparaM yirUshAlamnagarIyAH katipayA adhyApakAH phirUshinashcha yIshoH samIpamAgatya kathayAmAsuH,</para>
  <para style="p">
    <verse number="2" style="v"/>tava shiShyAH kimartham aprakShAlitakarai rbhakShitvA paramparAgataM prAchInAnAM vyavahAraM la Nvante?</para>
  <para style="p">
    <verse number="3" style="v"/>tato yIshuH pratyuvAcha, yUyaM paramparAgatAchAreNa kuta IshvarAj nAM la Nvadhve|</para>
  <para style="p">
    <verse number="4" style="v"/>Ishvara ityAj nApayat, tvaM nijapitarau saMmanyethAH, yena cha nijapitarau nindyete, sa nishchitaM mriyeta;</para>
  <para style="p">
    <verse number="5" style="v"/>kintu yUyaM vadatha, yaH svajanakaM svajananIM vA vAkyamidaM vadati, yuvAM matto yallabhethe, tat nyavidyata,</para>
  <para style="p">
    <verse number="6" style="v"/>sa nijapitarau puna rna saMmaMsyate| itthaM yUyaM paramparAgatena sveShAmAchAreNeshvarIyAj nAM lumpatha|</para>
  <para style="p">
    <verse number="7" style="v"/>re kapaTinaH sarvve yishayiyo yuShmAnadhi bhaviShyadvachanAnyetAni samyag uktavAn|</para>
  <para style="p">
    <verse number="8" style="v"/>vadanai rmanujA ete samAyAnti madantikaM| tathAdharai rmadIya ncha mAnaM kurvvanti te narAH|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu teShAM mano matto vidUraeva tiShThati| shikShayanto vidhIn nrAj nA bhajante mAM mudhaiva te|</para>
  <para style="p">
    <verse number="10" style="v"/>tato yIshu rlokAn AhUya proktavAn, yUyaM shrutvA budhyadhbaM|</para>
  <para style="p">
    <verse number="11" style="v"/>yanmukhaM pravishati, tat manujam amedhyaM na karoti, kintu yadAsyAt nirgachChati, tadeva mAnuShamamedhyI karotI|</para>
  <para style="p">
    <verse number="12" style="v"/>tadAnIM shiShyA Agatya tasmai kathayA nchakruH, etAM kathAM shrutvA phirUshino vyarajyanta, tat kiM bhavatA j nAyate?</para>
  <para style="p">
    <verse number="13" style="v"/>sa pratyavadat, mama svargasthaH pitA yaM ka nchida NkuraM nAropayat, sa utpAvdyate|</para>
  <para style="p">
    <verse number="14" style="v"/>te tiShThantu, te andhamanujAnAm andhamArgadarshakA eva; yadyandho.andhaM panthAnaM darshayati, tarhyubhau gartte patataH|</para>
  <para style="p">
    <verse number="15" style="v"/>tadA pitarastaM pratyavadat, dR^iShTAntamimamasmAn bodhayatu|</para>
  <para style="p">
    <verse number="16" style="v"/>yIshunA proktaM, yUyamadya yAvat kimabodhAH stha?</para>
  <para style="p">
    <verse number="17" style="v"/>kathAmimAM kiM na budhyadhbe ? yadAsyaM previshati, tad udare patan bahirniryAti,</para>
  <para style="p">
    <verse number="18" style="v"/>kintvAsyAd yanniryAti, tad antaHkaraNAt niryAtatvAt manujamamedhyaM karoti|</para>
  <para style="p">
    <verse number="19" style="v"/>yato.antaHkaraNAt kuchintA badhaH pAradArikatA veshyAgamanaM chairyyaM mithyAsAkShyam IshvaranindA chaitAni sarvvANi niryyAnti|</para>
  <para style="p">
    <verse number="20" style="v"/>etAni manuShyamapavitrI kurvvanti kintvaprakShAlitakareNa bhojanaM manujamamedhyaM na karoti|</para>
  <para style="p">
    <verse number="21" style="v"/>anantaraM yIshustasmAt sthAnAt prasthAya sorasIdonnagarayoH sImAmupatasyau|</para>
  <para style="p">
    <verse number="22" style="v"/>tadA tatsImAtaH kAchit kinAnIyA yoShid Agatya tamuchchairuvAcha, he prabho dAyUdaH santAna, mamaikA duhitAste sA bhUtagrastA satI mahAkleshaM prApnoti mama dayasva|</para>
  <para style="p">
    <verse number="23" style="v"/>kintu yIshustAM kimapi noktavAn, tataH shiShyA Agatya taM nivedayAmAsuH, eShA yoShid asmAkaM pashchAd uchchairAhUyAgachChati, enAM visR^ijatu|</para>
  <para style="p">
    <verse number="24" style="v"/>tadA sa pratyavadat, isrAyelgotrasya hAritameShAn vinA kasyApyanyasya samIpaM nAhaM preShitosmi|</para>
  <para style="p">
    <verse number="25" style="v"/>tataH sA nArIsamAgatya taM praNamya jagAda, he prabho mAmupakuru|</para>
  <para style="p">
    <verse number="26" style="v"/>sa uktavAn, bAlakAnAM bhakShyamAdAya sArameyebhyo dAnaM nochitaM|</para>
  <para style="p">
    <verse number="27" style="v"/>tadA sA babhAShe, he prabho, tat satyaM, tathApi prabho rbha nchAd yaduchChiShTaM patati, tat sArameyAH khAdanti|</para>
  <para style="p">
    <verse number="28" style="v"/>tato yIshuH pratyavadat, he yoShit, tava vishvAso mahAn tasmAt tava manobhilaShitaM sidyyatu, tena tasyAH kanyA tasminneva daNDe nirAmayAbhavat|</para>
  <para style="p">
    <verse number="29" style="v"/>anantaraM yIshastasmAt sthAnAt prasthAya gAlIlsAgarasya sannidhimAgatya dharAdharamAruhya tatropavivesha|</para>
  <para style="p">
    <verse number="30" style="v"/>pashchAt jananivaho bahUn kha nchAndhamUkashuShkakaramAnuShAn AdAya yIshoH samIpamAgatya tachcharaNAntike sthApayAmAsuH, tataH sA tAn nirAmayAn akarot|</para>
  <para style="p">
    <verse number="31" style="v"/>itthaM mUkA vAkyaM vadanti, shuShkakarAH svAsthyamAyAnti, pa Ngavo gachChanti, andhA vIkShante, iti vilokya lokA vismayaM manyamAnA isrAyela IshvaraM dhanyaM babhAShire|</para>
  <para style="p">
    <verse number="32" style="v"/>tadAnIM yIshuH svashiShyAn AhUya gaditavAn, etajjananivaheShu mama dayA jAyate, ete dinatrayaM mayA sAkaM santi, eShAM bhakShyavastu cha ka nchidapi nAsti, tasmAdahametAnakR^itAhArAn na visrakShyAmi, tathAtve vartmamadhye klAmyeShuH|</para>
  <para style="p">
    <verse number="33" style="v"/>tadA shiShyA UchuH, etasmin prAntaramadhya etAvato martyAn tarpayituM vayaM kutra pUpAn prApsyAmaH?</para>
  <para style="p">
    <verse number="34" style="v"/>yIshurapR^ichChat, yuShmAkaM nikaTe kati pUpA Asate? ta UchuH, saptapUpA alpAH kShudramInAshcha santi|</para>
  <para style="p">
    <verse number="35" style="v"/>tadAnIM sa lokanivahaM bhUmAvupaveShTum Adishya</para>
  <para style="p">
    <verse number="36" style="v"/>tAn saptapUpAn mInAMshcha gR^ihlan IshvarIyaguNAn anUdya bhaMktvA shiShyebhyo dadau, shiShyA lokebhyo daduH|</para>
  <para style="p">
    <verse number="37" style="v"/>tataH sarvve bhuktvA tR^iptavantaH; tadavashiShTabhakShyeNa saptaDalakAn paripUryya saMjagR^ihuH|</para>
  <para style="p">
    <verse number="38" style="v"/>te bhoktAro yoShito bAlakAMshcha vihAya prAyeNa chatuHsahasrANi puruShA Asan|</para>
  <para style="p">
    <verse number="39" style="v"/>tataH paraM sa jananivahaM visR^ijya tarimAruhya magdalApradeshaM gatavAn|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadAnIM phirUshinaH sidUkinashchAgatya taM parIkShituM nabhamIyaM ki nchana lakShma darshayituM tasmai nivedayAmAsuH|</para>
  <para style="p">
    <verse number="2" style="v"/>tataH sa uktavAn, sandhyAyAM nabhaso raktatvAd yUyaM vadatha, shvo nirmmalaM dinaM bhaviShyati;</para>
  <para style="p">
    <verse number="3" style="v"/>prAtaHkAle cha nabhaso raktatvAt malinatvA ncha vadatha, jha nbhshadya bhaviShyati| he kapaTino yadi yUyam antarIkShasya lakShma boddhuM shaknutha, tarhi kAlasyaitasya lakShma kathaM boddhuM na shaknutha?</para>
  <para style="p">
    <verse number="4" style="v"/>etatkAlasya duShTo vyabhichArI cha vaMsho lakShma gaveShayati, kintu yUnaso bhaviShyadvAdino lakShma vinAnyat kimapi lakShma tAn na darshayiyyate| tadAnIM sa tAn vihAya pratasthe|</para>
  <para style="p">
    <verse number="5" style="v"/>anantaramanyapAragamanakAle tasya shiShyAH pUpamAnetuM vismR^itavantaH|</para>
  <para style="p">
    <verse number="6" style="v"/>yIshustAnavAdIt, yUyaM phirUshinAM sidUkinA ncha kiNvaM prati sAvadhAnAH satarkAshcha bhavata|</para>
  <para style="p">
    <verse number="7" style="v"/>tena te parasparaM vivichya kathayitumArebhire, vayaM pUpAnAnetuM vismR^itavanta etatkAraNAd iti kathayati|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu yIshustadvij nAya tAnavochat, he stokavishvAsino yUyaM pUpAnAnayanamadhi kutaH parasparametad viviMkya?</para>
  <para style="p">
    <verse number="9" style="v"/>yuShmAbhiH kimadyApi na j nAyate? pa nchabhiH pUpaiH pa nchasahasrapuruSheShu bhojiteShu bhakShyochChiShTapUrNAn kati DalakAn samagR^ihlItaM;</para>
  <para style="p">
    <verse number="10" style="v"/>tathA saptabhiH pUpaishchatuHsahasrapuruSheShu bhejiteShu kati DalakAn samagR^ihlIta, tat kiM yuShmAbhirna smaryyate?</para>
  <para style="p">
    <verse number="11" style="v"/>tasmAt phirUshinAM sidUkinA ncha kiNvaM prati sAvadhAnAstiShThata, kathAmimAm ahaM pUpAnadhi nAkathayaM, etad yUyaM kuto na budhyadhve?</para>
  <para style="p">
    <verse number="12" style="v"/>tadAnIM pUpakiNvaM prati sAvadhAnAstiShThateti noktvA phirUshinAM sidUkinA ncha upadeshaM prati sAvadhAnAstiShThateti kathitavAn, iti tairabodhi|</para>
  <para style="p">
    <verse number="13" style="v"/>apara ncha yIshuH kaisariyA-philipipradeshamAgatya shiShyAn apR^ichChat, yo.ahaM manujasutaH so.ahaM kaH? lokairahaM kimuchye?</para>
  <para style="p">
    <verse number="14" style="v"/>tadAnIM te kathitavantaH, kechid vadanti tvaM majjayitA yohan, kechidvadanti, tvam eliyaH, kechichcha vadanti, tvaM yirimiyo vA kashchid bhaviShyadvAdIti|</para>
  <para style="p">
    <verse number="15" style="v"/>pashchAt sa tAn paprachCha, yUyaM mAM kaM vadatha? tataH shimon pitara uvAcha,</para>
  <para style="p">
    <verse number="16" style="v"/>tvamamareshvarasyAbhiShiktaputraH|</para>
  <para style="p">
    <verse number="17" style="v"/>tato yIshuH kathitavAn, he yUnasaH putra shimon tvaM dhanyaH; yataH kopi anujastvayyetajj nAnaM nodapAdayat, kintu mama svargasyaH pitodapAdayat|</para>
  <para style="p">
    <verse number="18" style="v"/>ato.ahaM tvAM vadAmi, tvaM pitaraH (prastaraH) aha ncha tasya prastarasyopari svamaNDalIM nirmmAsyAmi, tena nirayo balAt tAM parAjetuM na shakShyati|</para>
  <para style="p">
    <verse number="19" style="v"/>ahaM tubhyaM svargIyarAjyasya ku njikAM dAsyAmi, tena yat ki nchana tvaM pR^ithivyAM bhaMtsyasi tatsvarge bhaMtsyate, yachcha ki nchana mahyAM mokShyasi tat svarge mokShyate|</para>
  <para style="p">
    <verse number="20" style="v"/>pashchAt sa shiShyAnAdishat, ahamabhiShikto yIshuriti kathAM kasmaichidapi yUyaM mA kathayata|</para>
  <para style="p">
    <verse number="21" style="v"/>anya ncha yirUshAlamnagaraM gatvA prAchInalokebhyaH pradhAnayAjakebhya upAdhyAyebhyashcha bahuduHkhabhogastai rhatatvaM tR^itIyadine punarutthAna ncha mamAvashyakam etAH kathA yIshustatkAlamArabhya shiShyAn j nApayitum ArabdhavAn|</para>
  <para style="p">
    <verse number="22" style="v"/>tadAnIM pitarastasya karaM ghR^itvA tarjayitvA kathayitumArabdhavAn, he prabho, tat tvatto dUraM yAtu, tvAM prati kadApi na ghaTiShyate|</para>
  <para style="p">
    <verse number="23" style="v"/>kintu sa vadanaM parAvartya pitaraM jagAda, he vighnakArin, matsammukhAd dUrIbhava, tvaM mAM bAdhase, IshvarIyakAryyAt mAnuShIyakAryyaM tubhyaM rochate|</para>
  <para style="p">
    <verse number="24" style="v"/>anantaraM yIshuH svIyashiShyAn uktavAn yaH kashchit mama pashchAdgAmI bhavitum ichChati, sa svaM dAmyatu, tathA svakrushaM gR^ihlan matpashchAdAyAtu|</para>
  <para style="p">
    <verse number="25" style="v"/>yato yaH prANAn rakShitumichChati, sa tAn hArayiShyati, kintu yo madarthaM nijaprANAn hArayati, sa tAn prApsyati|</para>
  <para style="p">
    <verse number="26" style="v"/>mAnuSho yadi sarvvaM jagat labhate nijapraNAn hArayati, tarhi tasya ko lAbhaH? manujo nijaprANAnAM vinimayena vA kiM dAtuM shaknoti?</para>
  <para style="p">
    <verse number="27" style="v"/>manujasutaH svadUtaiH sAkaM pituH prabhAveNAgamiShyati; tadA pratimanujaM svasvakarmmAnusArAt phalaM dAsyati|</para>
  <para style="p">
    <verse number="28" style="v"/>ahaM yuShmAn tathyaM vachmi, sarAjyaM manujasutam AgataM na pashyanto mR^ityuM na svAdiShyanti, etAdR^ishAH katipayajanA atrApi daNDAyamAnAH santi|</para>
  <chapter number="17" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM ShaDdinebhyaH paraM yIshuH pitaraM yAkUbaM tatsahajaM yohana ncha gR^ihlan uchchAdre rviviktasthAnam Agatya teShAM samakShaM rUpamanyat dadhAra|</para>
  <para style="p">
    <verse number="2" style="v"/>tena tadAsyaM tejasvi, tadAbharaNam Alokavat pANDaramabhavat|</para>
  <para style="p">
    <verse number="3" style="v"/>anyachcha tena sAkaM saMlapantau mUsA eliyashcha tebhyo darshanaM dadatuH|</para>
  <para style="p">
    <verse number="4" style="v"/>tadAnIM pitaro yIshuM jagAda, he prabho sthitiratrAsmAkaM shubhA, yadi bhavatAnumanyate, tarhi bhavadarthamekaM mUsArthamekam eliyArtha nchaikam iti trINi dUShyANi nirmmama|</para>
  <para style="p">
    <verse number="5" style="v"/>etatkathanakAla eka ujjavalaH payodasteShAmupari ChAyAM kR^itavAn, vAridAd eShA nabhasIyA vAg babhUva, mamAyaM priyaH putraH, asmin mama mahAsantoSha etasya vAkyaM yUyaM nishAmayata|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu vAchametAM shR^iNvantaeva shiShyA mR^ishaM sha NkamAnA nyubjA nyapatan|</para>
  <para style="p">
    <verse number="7" style="v"/>tadA yIshurAgatya teShAM gAtrANi spR^ishan uvAcha, uttiShThata, mA bhaiShTa|</para>
  <para style="p">
    <verse number="8" style="v"/>tadAnIM netrANyunmIlya yIshuM vinA kamapi na dadR^ishuH|</para>
  <para style="p">
    <verse number="9" style="v"/>tataH param adreravarohaNakAle yIshustAn ityAdidesha, manujasutasya mR^itAnAM madhyAdutthAnaM yAvanna jAyate, tAvat yuShmAbhiretaddarshanaM kasmaichidapi na kathayitavyaM|</para>
  <para style="p">
    <verse number="10" style="v"/>tadA shiShyAstaM paprachChuH, prathamam eliya AyAsyatIti kuta upAdhyAyairuchyate?</para>
  <para style="p">
    <verse number="11" style="v"/>tato yIshuH pratyavAdIt, eliyaH prAgetya sarvvANi sAdhayiShyatIti satyaM,</para>
  <para style="p">
    <verse number="12" style="v"/>kintvahaM yuShmAn vachmi, eliya etya gataH, te tamaparichitya tasmin yathechChaM vyavajahuH; manujasutenApi teShAmantike tAdR^ig duHkhaM bhoktavyaM|</para>
  <para style="p">
    <verse number="13" style="v"/>tadAnIM sa majjayitAraM yohanamadhi kathAmetAM vyAhR^itavAn, itthaM tachChiShyA bubudhire|</para>
  <para style="p">
    <verse number="14" style="v"/>pashchAt teShu jananivahasyAntikamAgateShu kashchit manujastadantikametya jAnUnI pAtayitvA kathitavAn,</para>
  <para style="p">
    <verse number="15" style="v"/>he prabho, matputraM prati kR^ipAM vidadhAtu, sopasmArAmayena bhR^ishaM vyathitaH san punaH puna rvahnau muhu rjalamadhye patati|</para>
  <para style="p">
    <verse number="16" style="v"/>tasmAd bhavataH shiShyANAM samIpe tamAnayaM kintu te taM svAsthaM karttuM na shaktAH|</para>
  <para style="p">
    <verse number="17" style="v"/>tadA yIshuH kathitavAn re avishvAsinaH, re vipathagAminaH, punaH katikAlAn ahaM yuShmAkaM sannidhau sthAsyAmi? katikAlAn vA yuShmAn sahiShye? tamatra mamAntikamAnayata|</para>
  <para style="p">
    <verse number="18" style="v"/>pashchAd yIshunA tarjataeva sa bhUtastaM vihAya gatavAn, taddaNDaeva sa bAlako nirAmayo.abhUt|</para>
  <para style="p">
    <verse number="19" style="v"/>tataH shiShyA guptaM yIshumupAgatya babhAShire, kuto vayaM taM bhUtaM tyAjayituM na shaktAH?</para>
  <para style="p">
    <verse number="20" style="v"/>yIshunA te proktAH, yuShmAkamapratyayAt;</para>
  <para style="p">
    <verse number="21" style="v"/>yuShmAnahaM tathyaM vachmi yadi yuShmAkaM sarShapaikamAtropi vishvAso jAyate, tarhi yuShmAbhirasmin shaile tvamitaH sthAnAt tat sthAnaM yAhIti brUte sa tadaiva chaliShyati, yuShmAkaM kimapyasAdhya ncha karmma na sthAsyAti| kintu prArthanopavAsau vinaitAdR^isho bhUto na tyAjyeta|</para>
  <para style="p">
    <verse number="22" style="v"/>aparaM teShAM gAlIlpradeshe bhramaNakAle yIshunA te gaditAH, manujasuto janAnAM kareShu samarpayiShyate tai rhaniShyate cha,</para>
  <para style="p">
    <verse number="23" style="v"/>kintu tR^itIye.ahi्na ma utthApiShyate, tena te bhR^ishaM duHkhitA babhUvaH|</para>
  <para style="p">
    <verse number="24" style="v"/>tadanantaraM teShu kapharnAhUmnagaramAgateShu karasaMgrAhiNaH pitarAntikamAgatya paprachChuH, yuShmAkaM guruH kiM mandirArthaM karaM na dadAti? tataH pitaraH kathitavAn dadAti|</para>
  <para style="p">
    <verse number="25" style="v"/>tatastasmin gR^ihamadhyamAgate tasya kathAkathanAt pUrvvameva yIshuruvAcha, he shimon, medinyA rAjAnaH svasvApatyebhyaH kiM videshibhyaH kebhyaH karaM gR^ihlanti? atra tvaM kiM budhyase? tataH pitara uktavAn, videshibhyaH|</para>
  <para style="p">
    <verse number="26" style="v"/>tadA yIshuruktavAn, tarhi santAnA muktAH santi|</para>
  <para style="p">
    <verse number="27" style="v"/>tathApi yathAsmAbhisteShAmantarAyo na janyate, tatkR^ite jaladhestIraM gatvA vaDishaM kShipa, tenAdau yo mIna utthAsyati, taM ghR^itvA tanmukhe mochite tolakaikaM rUpyaM prApsyasi, tad gR^ihItvA tava mama cha kR^ite tebhyo dehi|</para>
  <chapter number="18" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadAnIM shiShyA yIshoH samIpamAgatya pR^iShTavantaH svargarAjye kaH shreShThaH?</para>
  <para style="p">
    <verse number="2" style="v"/>tato yIshuH kShudramekaM bAlakaM svasamIpamAnIya teShAM madhye nidhAya jagAda,</para>
  <para style="p">
    <verse number="3" style="v"/>yuShmAnahaM satyaM bravImi, yUyaM manovinimayena kShudrabAlavat na santaH svargarAjyaM praveShTuM na shaknutha|</para>
  <para style="p">
    <verse number="4" style="v"/>yaH kashchid etasya kShudrabAlakasya samamAtmAnaM namrIkaroti, saeva svargarAjaye shreShThaH|</para>
  <para style="p">
    <verse number="5" style="v"/>yaH kashchid etAdR^ishaM kShudrabAlakamekaM mama nAmni gR^ihlAti, sa mAmeva gR^ihlAti|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu yo jano mayi kR^itavishvAsAnAmeteShAM kShudraprANinAm ekasyApi vidhniM janayati, kaNThabaddhapeShaNIkasya tasya sAgarAgAdhajale majjanaM shreyaH|</para>
  <para style="p">
    <verse number="7" style="v"/>vighnAt jagataH santApo bhaviShyati, vighno.avashyaM janayiShyate, kintu yena manujena vighno janiShyate tasyaiva santApo bhaviShyati|</para>
  <para style="p">
    <verse number="8" style="v"/>tasmAt tava karashcharaNo vA yadi tvAM bAdhate, tarhi taM ChittvA nikShipa, dvikarasya dvipadasya vA tavAnaptavahnau nikShepAt, kha njasya vA Chinnahastasya tava jIvane pravesho varaM|</para>
  <para style="p">
    <verse number="9" style="v"/>aparaM tava netraM yadi tvAM bAdhate, tarhi tadapyutpAvya nikShipa, dvinetrasya narakAgnau nikShepAt kANasya tava jIvane pravesho varaM|</para>
  <para style="p">
    <verse number="10" style="v"/>tasmAdavadhaddhaM, eteShAM kShudraprANinAm ekamapi mA tuchChIkuruta,</para>
  <para style="p">
    <verse number="11" style="v"/>yato yuShmAnahaM tathyaM bravImi, svarge teShAM dUtA mama svargasthasya piturAsyaM nityaM pashyanti| evaM ye ye hAritAstAn rakShituM manujaputra AgachChat|</para>
  <para style="p">
    <verse number="12" style="v"/>yUyamatra kiM viviMgghve? kasyachid yadi shataM meShAH santi, teShAmeko hAryyate cha, tarhi sa ekonashataM meShAn vihAya parvvataM gatvA taM hAritamekaM kiM na mR^igayate?</para>
  <para style="p">
    <verse number="13" style="v"/>yadi cha kadAchit tanmeShoddeshaM lamate, tarhi yuShmAnahaM satyaM kathayAmi, so.avipathagAmibhya ekonashatameShebhyopi tadekahetoradhikam AhlAdate|</para>
  <para style="p">
    <verse number="14" style="v"/>tadvad eteShAM kShudraprAeिnAm ekopi nashyatIti yuShmAkaM svargasthapitu rnAbhimatam|</para>
  <para style="p">
    <verse number="15" style="v"/>yadyapi tava bhrAtA tvayi kimapyaparAdhyati, tarhi gatvA yuvayordvayoH sthitayostasyAparAdhaM taM j nApaya| tatra sa yadi tava vAkyaM shR^iNoti, tarhi tvaM svabhrAtaraM prAptavAn,</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yadi na shR^iNoti, tarhi dvAbhyAM tribhi rvA sAkShIbhiH sarvvaM vAkyaM yathA nishchitaM jAyate, tadartham ekaM dvau vA sAkShiNau gR^ihItvA yAhi|</para>
  <para style="p">
    <verse number="17" style="v"/>tena sa yadi tayo rvAkyaM na mAnyate, tarhi samAjaM tajj nApaya, kintu yadi samAjasyApi vAkyaM na mAnyate,tarhi sa tava samIpe devapUjaka_iva chaNDAla_iva cha bhaviShyati|</para>
  <para style="p">
    <verse number="18" style="v"/>ahaM yuShmAn satyaM vadAmi, yuShmAbhiH pR^ithivyAM yad badhyate tat svarge bhaMtsyate; medinyAM yat bhochyate, svarge.api tat mokShyate|</para>
  <para style="p">
    <verse number="19" style="v"/>punarahaM yuShmAn vadAmi, medinyAM yuShmAkaM yadi dvAvekavAkyIbhUya ki nchit prArthayete, tarhi mama svargasthapitrA tat tayoH kR^ite sampannaM bhaviShyati|</para>
  <para style="p">
    <verse number="20" style="v"/>yato yatra dvau trayo vA mama nAnni milanti, tatraivAhaM teShAM madhye.asmi|</para>
  <para style="p">
    <verse number="21" style="v"/>tadAnIM pitarastatsamIpamAgatya kathitavAn he prabho, mama bhrAtA mama yadyaparAdhyati, tarhi taM katikR^itvaH kShamiShye?</para>
  <para style="p">
    <verse number="22" style="v"/>kiM saptakR^itvaH? yIshustaM jagAda, tvAM kevalaM saptakR^itvo yAvat na vadAmi, kintu saptatyA guNitaM saptakR^itvo yAvat|</para>
  <para style="p">
    <verse number="23" style="v"/>aparaM nijadAsaiH saha jigaNayiShuH kashchid rAjeva svargarAjayaM|</para>
  <para style="p">
    <verse number="24" style="v"/>Arabdhe tasmin gaNane sArddhasahasramudrApUritAnAM dashasahasrapuTakAnAm eko.aghamarNastatsamakShamAnAyi|</para>
  <para style="p">
    <verse number="25" style="v"/>tasya parishodhanAya dravyAbhAvAt parishodhanArthaM sa tadIyabhAryyAputrAdisarvvasva ncha vikrIyatAmiti tatprabhurAdidesha|</para>
  <para style="p">
    <verse number="26" style="v"/>tena sa dAsastasya pAdayoH patan praNamya kathitavAn , he prabho bhavatA ghairyye kR^ite mayA sarvvaM parishodhiShyate|</para>
  <para style="p">
    <verse number="27" style="v"/>tadAnIM dAsasya prabhuH sakaruNaH san sakalarNaM kShamitvA taM tatyAja|</para>
  <para style="p">
    <verse number="28" style="v"/>kintu tasmin dAse bahi ryAte, tasya shataM mudrAchaturthAMshAn yo dhArayati, taM sahadAsaM dR^iShdvA tasya kaNThaM niShpIDya gaditavAn, mama yat prApyaM tat parishodhaya|</para>
  <para style="p">
    <verse number="29" style="v"/>tadA tasya sahadAsastatpAdayoH patitvA vinIya babhAShe, tvayA dhairyye kR^ite mayA sarvvaM parishodhiShyate|</para>
  <para style="p">
    <verse number="30" style="v"/>tathApi sa tat nA NagIkR^itya yAvat sarvvamR^iNaM na parishodhitavAn tAvat taM kArAyAM sthApayAmAsa|</para>
  <para style="p">
    <verse number="31" style="v"/>tadA tasya sahadAsAstasyaitAdR^ig AcharaNaM vilokya prabhoH samIpaM gatvA sarvvaM vR^ittAntaM nivedayAmAsuH|</para>
  <para style="p">
    <verse number="32" style="v"/>tadA tasya prabhustamAhUya jagAda, re duShTa dAsa, tvayA matsannidhau prArthite mayA tava sarvvamR^iNaM tyaktaM;</para>
  <para style="p">
    <verse number="33" style="v"/>yathA chAhaM tvayi karuNAM kR^itavAn, tathaiva tvatsahadAse karuNAkaraNaM kiM tava nochitaM?</para>
  <para style="p">
    <verse number="34" style="v"/>iti kathayitvA tasya prabhuH kruddhyan nijaprApyaM yAvat sa na parishodhitavAn, tAvat prahArakAnAM kareShu taM samarpitavAn|</para>
  <para style="p">
    <verse number="35" style="v"/>yadi yUyaM svAntaHkaraNaiH svasvasahajAnAm aparAdhAn na kShamadhve, tarhi mama svargasyaH pitApi yuShmAn pratItthaM kariShyati|</para>
  <chapter number="19" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaram etAsu kathAsu samAptAsu yIshu rgAlIlapradeshAt prasthAya yardantIrasthaM yihUdApradeshaM prAptaH|</para>
  <para style="p">
    <verse number="2" style="v"/>tadA tatpashchAt jananivahe gate sa tatra tAn nirAmayAn akarot|</para>
  <para style="p">
    <verse number="3" style="v"/>tadanantaraM phirUshinastatsamIpamAgatya pArIkShituM taM paprachChuH, kasmAdapi kAraNAt nareNa svajAyA parityAjyA na vA?</para>
  <para style="p">
    <verse number="4" style="v"/>sa pratyuvAcha, prathamam Ishvaro naratvena nArItvena cha manujAn sasarja, tasmAt kathitavAn,</para>
  <para style="p">
    <verse number="5" style="v"/>mAnuShaH svapitarau parityajya svapatnyAm AsakShyate, tau dvau janAvekA Ngau bhaviShyataH, kimetad yuShmAbhi rna paThitam?</para>
  <para style="p">
    <verse number="6" style="v"/>atastau puna rna dvau tayorekA NgatvaM jAtaM, IshvareNa yachcha samayujyata, manujo na tad bhindyAt|</para>
  <para style="p">
    <verse number="7" style="v"/>tadAnIM te taM pratyavadan, tathAtve tyAjyapatraM dattvA svAM svAM jAyAM tyaktuM vyavasthAM mUsAH kathaM lilekha?</para>
  <para style="p">
    <verse number="8" style="v"/>tataH sa kathitavAn, yuShmAkaM manasAM kAThinyAd yuShmAn svAM svAM jAyAM tyaktum anvamanyata kintu prathamAd eSho vidhirnAsIt|</para>
  <para style="p">
    <verse number="9" style="v"/>ato yuShmAnahaM vadAmi, vyabhichAraM vinA yo nijajAyAM tyajet anyA ncha vivahet, sa paradArAn gachChati; yashcha tyaktAM nArIM vivahati sopi paradAreShu ramate|</para>
  <para style="p">
    <verse number="10" style="v"/>tadA tasya shiShyAstaM babhAShire, yadi svajAyayA sAkaM puMsa etAdR^ik sambandho jAyate, tarhi vivahanameva na bhadraM|</para>
  <para style="p">
    <verse number="11" style="v"/>tataH sa uktavAn, yebhyastatsAmarthyaM AdAyi, tAn vinAnyaH kopi manuja etanmataM grahItuM na shaknoti|</para>
  <para style="p">
    <verse number="12" style="v"/>katipayA jananaklIbaH katipayA narakR^itaklIbaH svargarAjyAya katipayAH svakR^itaklIbAshcha santi, ye grahItuM shaknuvanti te gR^ihlantu|</para>
  <para style="p">
    <verse number="13" style="v"/>aparam yathA sa shishUnAM gAtreShu hastaM datvA prArthayate, tadarthaM tatsamIMpaM shishava AnIyanta, tata AnayitR^in shiShyAstiraskR^itavantaH|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu yIshuruvAcha, shishavo madantikam AgachChantu, tAn mA vArayata, etAdR^ishAM shishUnAmeva svargarAjyaM|</para>
  <para style="p">
    <verse number="15" style="v"/>tataH sa teShAM gAtreShu hastaM datvA tasmAt sthAnAt pratasthe|</para>
  <para style="p">
    <verse number="16" style="v"/>aparam eka Agatya taM paprachCha, he paramaguro, anantAyuH prAptuM mayA kiM kiM satkarmma karttavyaM?</para>
  <para style="p">
    <verse number="17" style="v"/>tataH sa uvAcha, mAM paramaM kuto vadasi? vineshcharaM na kopi paramaH, kintu yadyanantAyuH prAptuM vA nChasi, tarhyAj nAH pAlaya|</para>
  <para style="p">
    <verse number="18" style="v"/>tadA sa pR^iShTavAn, kAH kA Aj nAH? tato yIshuH kathitavAn, naraM mA hanyAH, paradArAn mA gachCheH, mA chorayeH, mR^iShAsAkShyaM mA dadyAH,</para>
  <para style="p">
    <verse number="19" style="v"/>nijapitarau saMmanyasva, svasamIpavAsini svavat prema kuru|</para>
  <para style="p">
    <verse number="20" style="v"/>sa yuvA kathitavAn, A bAlyAd etAH pAlayAmi, idAnIM kiM nyUnamAste?</para>
  <para style="p">
    <verse number="21" style="v"/>tato yIshuravadat, yadi siddho bhavituM vA nChasi, tarhi gatvA nijasarvvasvaM vikrIya daridrebhyo vitara, tataH svarge vittaM lapsyase; AgachCha, matpashchAdvarttI cha bhava|</para>
  <para style="p">
    <verse number="22" style="v"/>etAM vAchaM shrutvA sa yuvA svIyabahusampatte rviShaNaH san chalitavAn|</para>
  <para style="p">
    <verse number="23" style="v"/>tadA yIshuH svashiShyAn avadat, dhaninAM svargarAjyapravesho mahAduShkara iti yuShmAnahaM tathyaM vadAmi|</para>
  <para style="p">
    <verse number="24" style="v"/>punarapi yuShmAnahaM vadAmi, dhaninAM svargarAjyapraveshAt sUchIChidreNa mahA NgagamanaM sukaraM|</para>
  <para style="p">
    <verse number="25" style="v"/>iti vAkyaM nishamya shiShyA atichamatkR^itya kathayAmAsuH; tarhi kasya paritrANaM bhavituM shaknoti?</para>
  <para style="p">
    <verse number="26" style="v"/>tadA sa tAn dR^iShdvA kathayAmAsa, tat mAnuShANAmashakyaM bhavati, kintvIshvarasya sarvvaM shakyam|</para>
  <para style="p">
    <verse number="27" style="v"/>tadA pitarastaM gaditavAn, pashya, vayaM sarvvaM parityajya bhavataH pashchAdvarttino .abhavAma; vayaM kiM prApsyAmaH?</para>
  <para style="p">
    <verse number="28" style="v"/>tato yIshuH kathitavAn, yuShmAnahaM tathyaM vadAmi, yUyaM mama pashchAdvarttino jAtA iti kAraNAt navInasR^iShTikAle yadA manujasutaH svIyaishcharyyasiMhAsana upavekShyati, tadA yUyamapi dvAdashasiMhAsaneShUpavishya isrAyelIyadvAdashavaMshAnAM vichAraM kariShyatha|</para>
  <para style="p">
    <verse number="29" style="v"/>anyachcha yaH kashchit mama nAmakAraNAt gR^ihaM vA bhrAtaraM vA bhaginIM vA pitaraM vA mAtaraM vA jAyAM vA bAlakaM vA bhUmiM parityajati, sa teShAM shataguNaM lapsyate, anantAyumo.adhikAritva ncha prApsyati|</para>
  <para style="p">
    <verse number="30" style="v"/>kintu agrIyA aneke janAH pashchAt, pashchAtIyAshchAneke lokA agre bhaviShyanti|</para>
  <chapter number="20" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>svargarAjyam etAdR^ishA kenachid gR^ihasyena samaM, yo.atiprabhAte nijadrAkShAkShetre kR^iShakAn niyoktuM gatavAn|</para>
  <para style="p">
    <verse number="2" style="v"/>pashchAt taiH sAkaM dinaikabhR^itiM mudrAchaturthAMshaM nirUpya tAn drAkShAkShetraM prerayAmAsa|</para>
  <para style="p">
    <verse number="3" style="v"/>anantaraM praharaikavelAyAM gatvA haTTe katipayAn niShkarmmakAn vilokya tAnavadat,</para>
  <para style="p">
    <verse number="4" style="v"/>yUyamapi mama drAkShAkShetraM yAta, yuShmabhyamahaM yogyabhR^itiM dAsyAmi, tataste vavrajuH|</para>
  <para style="p">
    <verse number="5" style="v"/>punashcha sa dvitIyatR^itIyayoH praharayo rbahi rgatvA tathaiva kR^itavAn|</para>
  <para style="p">
    <verse number="6" style="v"/>tato daNDadvayAvashiShTAyAM velAyAM bahi rgatvAparAn katipayajanAn niShkarmmakAn vilokya pR^iShTavAn, yUyaM kimartham atra sarvvaM dinaM niShkarmmANastiShThatha?</para>
  <para style="p">
    <verse number="7" style="v"/>te pratyavadan, asmAn na kopi karmamaNi niyuMkte| tadAnIM sa kathitavAn, yUyamapi mama drAkShAkShetraM yAta, tena yogyAM bhR^itiM lapsyatha|</para>
  <para style="p">
    <verse number="8" style="v"/>tadanantaraM sandhyAyAM satyAM saeva drAkShAkShetrapatiradhyakShaM gadivAn, kR^iShakAn AhUya sheShajanamArabhya prathamaM yAvat tebhyo bhR^itiM dehi|</para>
  <para style="p">
    <verse number="9" style="v"/>tena ye daNDadvayAvasthite samAyAtAsteShAm ekaiko jano mudrAchaturthAMshaM prApnot|</para>
  <para style="p">
    <verse number="10" style="v"/>tadAnIM prathamaniyuktA janA AgatyAnumitavanto vayamadhikaM prapsyAmaH, kintu tairapi mudrAchaturthAMsho.alAbhi|</para>
  <para style="p">
    <verse number="11" style="v"/>tataste taM gR^ihItvA tena kShetrapatinA sAkaM vAgyuddhaM kurvvantaH kathayAmAsuH,</para>
  <para style="p">
    <verse number="12" style="v"/>vayaM kR^itsnaM dinaM tApakleshau soDhavantaH, kintu pashchAtAyA se janA daNDadvayamAtraM parishrAntavantaste.asmAbhiH samAnAMshAH kR^itAH|</para>
  <para style="p">
    <verse number="13" style="v"/>tataH sa teShAmekaM pratyuvAcha, he vatsa, mayA tvAM prati kopyanyAyo na kR^itaH kiM tvayA matsamakShaM mudrAchaturthAMsho nA NgIkR^itaH?</para>
  <para style="p">
    <verse number="14" style="v"/>tasmAt tava yat prApyaM tadAdAya yAhi, tubhyaM yati, pashchAtIyaniyuktalokAyApi tati dAtumichChAmi|</para>
  <para style="p">
    <verse number="15" style="v"/>svechChayA nijadravyavyavaharaNaM kiM mayA na karttavyaM? mama dAtR^itvAt tvayA kim IrShyAdR^iShTiH kriyate?</para>
  <para style="p">
    <verse number="16" style="v"/>ittham agrIyalokAH pashchatIyA bhaviShyanti, pashchAtIyajanAshchagrIyA bhaviShyanti, ahUtA bahavaH kintvalpe manobhilaShitAH|</para>
  <para style="p">
    <verse number="17" style="v"/>tadanantaraM yIshu ryirUshAlamnagaraM gachChan mArgamadhye shiShyAn ekAnte vabhAShe,</para>
  <para style="p">
    <verse number="18" style="v"/>pashya vayaM yirUshAlamnagaraM yAmaH, tatra pradhAnayAjakAdhyApakAnAM kareShu manuShyaputraH samarpiShyate;</para>
  <para style="p">
    <verse number="19" style="v"/>te cha taM hantumAj nApya tiraskR^itya vetreNa praharttuM krushe dhAtayitu nchAnyadeshIyAnAM kareShu samarpayiShyanti, kintu sa tR^itIyadivase shmashAnAd utthApiShyate|</para>
  <para style="p">
    <verse number="20" style="v"/>tadAnIM sivadIyasya nArI svaputrAvAdAya yIshoH samIpam etya praNamya ka nchanAnugrahaM taM yayAche|</para>
  <para style="p">
    <verse number="21" style="v"/>tadA yIshustAM proktavAn, tvaM kiM yAchase? tataH sA babhAShe, bhavato rAjatve mamAnayoH sutayorekaM bhavaddakShiNapArshve dvitIyaM vAmapArshva upaveShTum Aj nApayatu|</para>
  <para style="p">
    <verse number="22" style="v"/>yIshuH pratyuvAcha, yuvAbhyAM yad yAchyate, tanna budhyate, ahaM yena kaMsena pAsyAmi yuvAbhyAM kiM tena pAtuM shakyate? aha ncha yena majjenena majjiShye, yuvAbhyAM kiM tena majjayituM shakyate? te jagaduH shakyate|</para>
  <para style="p">
    <verse number="23" style="v"/>tadA sa uktavAn, yuvAM mama kaMsenAvashyaM pAsyathaH, mama majjanena cha yuvAmapi majjiShyethe, kintu yeShAM kR^ite mattAtena nirUpitam idaM tAn vihAyAnyaM kamapi maddakShiNapArshve vAmapArshve cha samupaveshayituM mamAdhikAro nAsti|</para>
  <para style="p">
    <verse number="24" style="v"/>etAM kathAM shrutvAnye dashashiShyAstau bhrAtarau prati chukupuH|</para>
  <para style="p">
    <verse number="25" style="v"/>kintu yIshuH svasamIpaM tAnAhUya jagAda, anyadeshIyalokAnAM narapatayastAn adhikurvvanti, ye tu mahAntaste tAn shAsati, iti yUyaM jAnItha|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu yuShmAkaM madhye na tathA bhavet, yuShmAkaM yaH kashchit mahAn bubhUShati, sa yuShmAn seveta;</para>
  <para style="p">
    <verse number="27" style="v"/>yashcha yuShmAkaM madhye mukhyo bubhUShati, sa yuShmAkaM dAso bhavet|</para>
  <para style="p">
    <verse number="28" style="v"/>itthaM manujaputraH sevyo bhavituM nahi, kintu sevituM bahUnAM paritrANamUlyArthaM svaprANAn dAtu nchAgataH|</para>
  <para style="p">
    <verse number="29" style="v"/>anantaraM yirIhonagarAt teShAM bahirgamanasamaye tasya pashchAd bahavo lokA vavrajuH|</para>
  <para style="p">
    <verse number="30" style="v"/>aparaM vartmapArshva upavishantau dvAvandhau tena mArgeNa yIsho rgamanaM nishamya prochchaiH kathayAmAsatuH, he prabho dAyUdaH santAna, Avayo rdayAM vidhehi|</para>
  <para style="p">
    <verse number="31" style="v"/>tato lokAH sarvve tuShNImbhavatamityuktvA tau tarjayAmAsuH; tathApi tau punaruchchaiH kathayAmAsatuH he prabho dAyUdaH santAna, AvAM dayasva|</para>
  <para style="p">
    <verse number="32" style="v"/>tadAnIM yIshuH sthagitaH san tAvAhUya bhAShitavAn, yuvayoH kR^ite mayA kiM karttarvyaM? yuvAM kiM kAmayethe?</para>
  <para style="p">
    <verse number="33" style="v"/>tadA tAvuktavantau, prabho netrANi nau prasannAni bhaveyuH|</para>
  <para style="p">
    <verse number="34" style="v"/>tadAnIM yIshustau prati pramannaH san tayo rnetrANi pasparsha, tenaiva tau suvIkShA nchakrAte tatpashchAt jagmutushcha|</para>
  <chapter number="21" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM teShu yirUshAlamnagarasya samIpaverttino jaitunanAmakadharAdharasya samIpasthtiM baitphagigrAmam AgateShu, yIshuH shiShyadvayaM preShayan jagAda,</para>
  <para style="p">
    <verse number="2" style="v"/>yuvAM sammukhasthagrAmaM gatvA baddhAM yAM savatsAM garddabhIM haThAt prApsyathaH, tAM mochayitvA madantikam AnayataM|</para>
  <para style="p">
    <verse number="3" style="v"/>tatra yadi kashchit ki nchid vakShyati, tarhi vadiShyathaH, etasyAM prabhoH prayojanamAste, tena sa tatkShaNAt praheShyati|</para>
  <para style="p">
    <verse number="4" style="v"/>sIyonaH kanyakAM yUyaM bhAShadhvamiti bhAratIM| pashya te namrashIlaH san nR^ipa Aruhya gardabhIM| arthAdAruhya tadvatsamAyAsyati tvadantikaM|</para>
  <para style="p">
    <verse number="5" style="v"/>bhaviShyadvAdinoktaM vachanamidaM tadA saphalamabhUt|</para>
  <para style="p">
    <verse number="6" style="v"/>anantaraM tau shShyiौ yIsho ryathAnideshaM taM grAmaM gatvA</para>
  <para style="p">
    <verse number="7" style="v"/>gardabhIM tadvatsa ncha samAnItavantau, pashchAt tadupari svIyavasanAnI pAtayitvA tamArohayAmAsatuH|</para>
  <para style="p">
    <verse number="8" style="v"/>tato bahavo lokA nijavasanAni pathi prasArayitumArebhire, katipayA janAshcha pAdapaparNAdikaM ChitvA pathi vistArayAmAsuH|</para>
  <para style="p">
    <verse number="9" style="v"/>agragAminaH pashchAdgAminashcha manujA uchchairjaya jaya dAyUdaH santAneti jagaduH parameshvarasya nAmnA ya AyAti sa dhanyaH, sarvvoparisthasvargepi jayati|</para>
  <para style="p">
    <verse number="10" style="v"/>itthaM tasmin yirUshAlamaM praviShTe ko.ayamiti kathanAt kR^itsnaM nagaraM cha nchalamabhavat|</para>
  <para style="p">
    <verse number="11" style="v"/>tatra lokoH kathayAmAsuH, eSha gAlIlpradeshIya-nAsaratIya-bhaviShyadvAdI yIshuH|</para>
  <para style="p">
    <verse number="12" style="v"/>anantaraM yIshurIshvarasya mandiraM pravishya tanmadhyAt krayavikrayiNo vahishchakAra; vaNijAM mudrAsanAnI kapotavikrayiNA nchasanAnI cha nyuvjayAmAsa|</para>
  <para style="p">
    <verse number="13" style="v"/>aparaM tAnuvAcha, eShA lipirAste, "mama gR^ihaM prArthanAgR^ihamiti vikhyAsyati", kintu yUyaM tad dasyUnAM gahvaraM kR^itavantaH|</para>
  <para style="p">
    <verse number="14" style="v"/>tadanantaram andhakha nchalokAstasya samIpamAgatAH, sa tAn nirAmayAn kR^itavAn|</para>
  <para style="p">
    <verse number="15" style="v"/>yadA pradhAnayAjakA adhyApakAshcha tena kR^itAnyetAni chitrakarmmANi dadR^ishuH, jaya jaya dAyUdaH santAna, mandire bAlakAnAm etAdR^isham uchchadhvaniM shushruvushcha, tadA mahAkruddhA babhUvaH,</para>
  <para style="p">
    <verse number="16" style="v"/>taM paprachChushcha, ime yad vadanti, tat kiM tvaM shR^iNoShi? tato yIshustAn avochat, satyam; stanyapAyishishUnA ncha bAlakAnA ncha vaktrataH| svakIyaM mahimAnaM tvaM saMprakAshayasi svayaM| etadvAkyaM yUyaM kiM nApaThata?</para>
  <para style="p">
    <verse number="17" style="v"/>tatastAn vihAya sa nagarAd baithaniyAgrAmaM gatvA tatra rajanIM yApayAmAsa|</para>
  <para style="p">
    <verse number="18" style="v"/>anantaraM prabhAte sati yIshuH punarapi nagaramAgachChan kShudhArtto babhUva|</para>
  <para style="p">
    <verse number="19" style="v"/>tato mArgapArshva uDumbaravR^ikShamekaM vilokya tatsamIpaM gatvA patrANi vinA kimapi na prApya taM pAdapaM provAcha, adyArabhya kadApi tvayi phalaM na bhavatu; tena tatkShaNAt sa uDumbaramAhIruhaH shuShkatAM gataH|</para>
  <para style="p">
    <verse number="20" style="v"/>tad dR^iShTvA shiShyA AshcharyyaM vij nAya kathayAmAsuH, AH, uDumvarapAdapo.atitUrNaM shuShko.abhavat|</para>
  <para style="p">
    <verse number="21" style="v"/>tato yIshustAnuvAcha, yuShmAnahaM satyaM vadAmi, yadi yUyamasandigdhAH pratItha, tarhi yUyamapi kevaloDumvarapAdapaM pratItthaM karttuM shakShyatha, tanna, tvaM chalitvA sAgare pateti vAkyaM yuShmAbhirasmina shaile proktepi tadaiva tad ghaTiShyate|</para>
  <para style="p">
    <verse number="22" style="v"/>tathA vishvasya prArthya yuShmAbhi ryad yAchiShyate, tadeva prApsyate|</para>
  <para style="p">
    <verse number="23" style="v"/>anantaraM mandiraM pravishyopadeshanasamaye tatsamIpaM pradhAnayAjakAH prAchInalokAshchAgatya paprachChuH, tvayA kena sAmarthyanaitAni karmmANi kriyante? kena vA tubhyametAni sAmarthyAni dattAni?</para>
  <para style="p">
    <verse number="24" style="v"/>tato yIshuH pratyavadat, ahamapi yuShmAn vAchamekAM pR^ichChAmi, yadi yUyaM taduttaraM dAtuM shakShyatha, tadA kena sAmarthyena karmmANyetAni karomi, tadahaM yuShmAn vakShyAmi|</para>
  <para style="p">
    <verse number="25" style="v"/>yohano majjanaM kasyAj nayAbhavat? kimIshvarasya manuShyasya vA? tataste parasparaM vivichya kathayAmAsuH, yadIshvarasyeti vadAmastarhi yUyaM taM kuto na pratyaita? vAchametAM vakShyati|</para>
  <para style="p">
    <verse number="26" style="v"/>manuShyasyeti vaktumapi lokebhyo bibhImaH, yataH sarvvairapi yohan bhaviShyadvAdIti j nAyate|</para>
  <para style="p">
    <verse number="27" style="v"/>tasmAt te yIshuM pratyavadan, tad vayaM na vidmaH| tadA sa tAnuktavAn, tarhi kena sAmarathyena karmmANyetAnyahaM karomi, tadapyahaM yuShmAn na vakShyAmi|</para>
  <para style="p">
    <verse number="28" style="v"/>kasyachijjanasya dvau sutAvAstAM sa ekasya sutasya samIpaM gatvA jagAda, he suta, tvamadya mama drAkShAkShetre karmma kartuM vraja|</para>
  <para style="p">
    <verse number="29" style="v"/>tataH sa uktavAn, na yAsyAmi, kintu sheShe.anutapya jagAma|</para>
  <para style="p">
    <verse number="30" style="v"/>anantaraM sonyasutasya samIpaM gatvA tathaiva kathtivAn; tataH sa pratyuvAcha, mahechCha yAmi, kintu na gataH|</para>
  <para style="p">
    <verse number="31" style="v"/>etayoH putrayo rmadhye piturabhimataM kena pAlitaM? yuShmAbhiH kiM budhyate? tataste pratyUchuH, prathamena puुtreNa| tadAnIM yIshustAnuvAcha, ahaM yuShmAn tathyaM vadAmi, chaNDAlA gaNikAshcha yuShmAkamagrata Ishvarasya rAjyaM pravishanti|</para>
  <para style="p">
    <verse number="32" style="v"/>yato yuShmAkaM samIpaM yohani dharmmapathenAgate yUyaM taM na pratItha, kintu chaNDAlA gaNikAshcha taM pratyAyan, tad vilokyApi yUyaM pratyetuM nAkhidyadhvaM|</para>
  <para style="p">
    <verse number="33" style="v"/>aparamekaM dR^iShTAntaM shR^iNuta, kashchid gR^ihasthaH kShetre drAkShAlatA ropayitvA tachchaturdikShu vAraNIM vidhAya tanmadhye drAkShAyantraM sthApitavAn, mA ncha ncha nirmmitavAn, tataH kR^iShakeShu tat kShetraM samarpya svayaM dUradeshaM jagAma|</para>
  <para style="p">
    <verse number="34" style="v"/>tadanantaraM phalasamaya upasthite sa phalAni prAptuM kR^iShIvalAnAM samIpaM nijadAsAn preShayAmAsa|</para>
  <para style="p">
    <verse number="35" style="v"/>kintu kR^iShIvalAstasya tAn dAseyAn dhR^itvA ka nchana prahR^itavantaH, ka nchana pAShANairAhatavantaH, ka nchana cha hatavantaH|</para>
  <para style="p">
    <verse number="36" style="v"/>punarapi sa prabhuH prathamato.adhikadAseyAn preShayAmAsa, kintu te tAn pratyapi tathaiva chakruH|</para>
  <para style="p">
    <verse number="37" style="v"/>anantaraM mama sute gate taM samAdariShyante, ityuktvA sheShe sa nijasutaM teShAM sannidhiM preShayAmAsa|</para>
  <para style="p">
    <verse number="38" style="v"/>kintu te kR^iShIvalAH sutaM vIkShya parasparam iti mantrayitum Arebhire, ayamuttarAdhikArI vayamenaM nihatyAsyAdhikAraM svavashIkariShyAmaH|</para>
  <para style="p">
    <verse number="39" style="v"/>pashchAt te taM dhR^itvA drAkShAkShetrAd bahiH pAtayitvAbadhiShuH|</para>
  <para style="p">
    <verse number="40" style="v"/>yadA sa drAkShAkShetrapatirAgamiShyati, tadA tAn kR^iShIvalAn kiM kariShyati?</para>
  <para style="p">
    <verse number="41" style="v"/>tataste pratyavadan, tAn kaluShiNo dAruNayAtanAbhirAhaniShyati, ye cha samayAnukramAt phalAni dAsyanti, tAdR^isheShu kR^iShIvaleShu kShetraM samarpayiShyati|</para>
  <para style="p">
    <verse number="42" style="v"/>tadA yIshunA te gaditAH, grahaNaM na kR^itaM yasya pAShANasya nichAyakaiH| pradhAnaprastaraH koNe saeva saMbhaviShyati| etat pareshituH karmmAsmadR^iShTAvadbhutaM bhavet| dharmmagranthe likhitametadvachanaM yuShmAbhiH kiM nApAThi?</para>
  <para style="p">
    <verse number="43" style="v"/>tasmAdahaM yuShmAn vadAmi, yuShmatta IshvarIyarAjyamapanIya phalotpAdayitranyajAtaye dAyiShyate|</para>
  <para style="p">
    <verse number="44" style="v"/>yo jana etatpAShANopari patiShyati, taM sa bhaMkShyate, kintvayaM pAShANo yasyopari patiShyati, taM sa dhUlivat chUrNIkariShyati|</para>
  <para style="p">
    <verse number="45" style="v"/>tadAnIM prAdhanayAjakAH phirUshinashcha tasyemAM dR^iShTAntakathAM shrutvA so.asmAnuddishya kathitavAn, iti vij nAya taM dharttuM cheShTitavantaH;</para>
  <para style="p">
    <verse number="46" style="v"/>kintu lokebhyo bibhyuH, yato lokaiH sa bhaviShyadvAdItyaj nAyi|</para>
  <chapter number="22" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM yIshuH punarapi dR^iShTAntena tAn avAdIt,</para>
  <para style="p">
    <verse number="2" style="v"/>svargIyarAjyam etAdR^ishasya nR^ipateH samaM, yo nija putraM vivAhayan sarvvAn nimantritAn AnetuM dAseyAn prahitavAn,</para>
  <para style="p">
    <verse number="3" style="v"/>kintu te samAgantuM neShTavantaH|</para>
  <para style="p">
    <verse number="4" style="v"/>tato rAjA punarapi dAsAnanyAn ityuktvA preShayAmAsa, nimantritAn vadata, pashyata, mama bhejyamAsAditamAste, nijavTaShAdipuShTajantUn mArayitvA sarvvaM khAdyadravyamAsAditavAn, yUyaM vivAhamAgachChata|</para>
  <para style="p">
    <verse number="5" style="v"/>tathapi te tuchChIkR^itya kechit nijakShetraM kechid vANijyaM prati svasvamArgeNa chalitavantaH|</para>
  <para style="p">
    <verse number="6" style="v"/>anye lokAstasya dAseyAn dhR^itvA daurAtmyaM vyavahR^itya tAnavadhiShuH|</para>
  <para style="p">
    <verse number="7" style="v"/>anantaraM sa nR^ipatistAM vArttAM shrutvA krudhyan sainyAni prahitya tAn ghAtakAn hatvA teShAM nagaraM dAhayAmAsa|</para>
  <para style="p">
    <verse number="8" style="v"/>tataH sa nijadAseyAn babhAShe, vivAhIyaM bhojyamAsAditamAste, kintu nimantritA janA ayogyAH|</para>
  <para style="p">
    <verse number="9" style="v"/>tasmAd yUyaM rAjamArgaM gatvA yAvato manujAn pashyata, tAvataeva vivAhIyabhojyAya nimantrayata|</para>
  <para style="p">
    <verse number="10" style="v"/>tadA te dAseyA rAjamArgaM gatvA bhadrAn abhadrAn vA yAvato janAn dadR^ishuH, tAvataeva saMgR^ihyAnayan; tato.abhyAgatamanujai rvivAhagR^iham apUryyata|</para>
  <para style="p">
    <verse number="11" style="v"/>tadAnIM sa rAjA sarvvAnabhyAgatAn draShTum abhyantaramAgatavAn; tadA tatra vivAhIyavasanahInamekaM janaM vIkShya taM jagAd,</para>
  <para style="p">
    <verse number="12" style="v"/>he mitra,tvaM vivAhIyavasanaM vinA kathamatra praviShTavAn? tena sa niruttaro babhUva|</para>
  <para style="p">
    <verse number="13" style="v"/>tadA rAjA nijAnucharAn avadat, etasya karacharaNAn baddhA yatra rodanaM dantairdantagharShaNa ncha bhavati, tatra vahirbhUtatamisre taM nikShipata|</para>
  <para style="p">
    <verse number="14" style="v"/>itthaM bahava AhUtA alpe manobhimatAH|</para>
  <para style="p">
    <verse number="15" style="v"/>anantaraM phirUshinaH pragatya yathA saMlApena tam unmAthe pAtayeyustathA mantrayitvA</para>
  <para style="p">
    <verse number="16" style="v"/>herodIyamanujaiH sAkaM nijashiShyagaNena taM prati kathayAmAsuH, he guro, bhavAn satyaH satyamIshvarIyamArgamupadishati, kamapi mAnuShaM nAnurudhyate, kamapi nApekShate cha, tad vayaM jAnImaH|</para>
  <para style="p">
    <verse number="17" style="v"/>ataH kaisarabhUpAya karo.asmAkaM dAtavyo na vA? atra bhavatA kiM budhyate? tad asmAn vadatu|</para>
  <para style="p">
    <verse number="18" style="v"/>tato yIshusteShAM khalatAM vij nAya kathitavAn, re kapaTinaH yuyaM kuto mAM parikShadhve?</para>
  <para style="p">
    <verse number="19" style="v"/>tatkaradAnasya mudrAM mAM darshayata| tadAnIM taistasya samIpaM mudrAchaturthabhAga AnIte</para>
  <para style="p">
    <verse number="20" style="v"/>sa tAn paprachCha, atra kasyeyaM mUrtti rnAma chAste? te jagaduH, kaisarabhUpasya|</para>
  <para style="p">
    <verse number="21" style="v"/>tataH sa uktavAna, kaisarasya yat tat kaisarAya datta, Ishvarasya yat tad IshvarAya datta|</para>
  <para style="p">
    <verse number="22" style="v"/>iti vAkyaM nishamya te vismayaM vij nAya taM vihAya chalitavantaH|</para>
  <para style="p">
    <verse number="23" style="v"/>tasminnahani sidUkino.arthAt shmashAnAt notthAsyantIti vAkyaM ye vadanti, te yIsheाrantikam Agatya paprachChuH,</para>
  <para style="p">
    <verse number="24" style="v"/>he guro, kashchinmanujashchet niHsantAnaH san prANAn tyajati, tarhi tasya bhrAtA tasya jAyAM vyuhya bhrAtuH santAnam utpAdayiShyatIti mUsA AdiShTavAn|</para>
  <para style="p">
    <verse number="25" style="v"/>kintvasmAkamatra ke.api janAH saptasahodarA Asan, teShAM jyeShTha ekAM kanyAM vyavahAt, aparaM prANatyAgakAle svayaM niHsantAnaH san tAM striyaM svabhrAtari samarpitavAn,</para>
  <para style="p">
    <verse number="26" style="v"/>tato dvitIyAdisaptamAntAshcha tathaiva chakruH|</para>
  <para style="p">
    <verse number="27" style="v"/>sheShe sApI nArI mamAra|</para>
  <para style="p">
    <verse number="28" style="v"/>mR^itAnAm utthAnasamaye teShAM saptAnAM madhye sA nArI kasya bhAryyA bhaviShyati? yasmAt sarvvaeva tAM vyavahan|</para>
  <para style="p">
    <verse number="29" style="v"/>tato yIshuH pratyavAdIt, yUyaM dharmmapustakam IshvarIyAM shakti ncha na vij nAya bhrAntimantaH|</para>
  <para style="p">
    <verse number="30" style="v"/>utthAnaprAptA lokA na vivahanti, na cha vAchA dIyante, kintvIshvarasya svargasthadUtAnAM sadR^ishA bhavanti|</para>
  <para style="p">
    <verse number="31" style="v"/>aparaM mR^itAnAmutthAnamadhi yuShmAn pratIyamIshvaroktiH,</para>
  <para style="p">
    <verse number="32" style="v"/>"ahamibrAhIma Ishvara ishAka Ishvaro yAkUba Ishvara" iti kiM yuShmAbhi rnApAThi? kintvIshvaro jIvatAm Ishvara:, sa mR^itAnAmIshvaro nahi|</para>
  <para style="p">
    <verse number="33" style="v"/>iti shrutvA sarvve lokAstasyopadeshAd vismayaM gatAH|</para>
  <para style="p">
    <verse number="34" style="v"/>anantaraM sidUkinAm niruttaratvavArtAM nishamya phirUshina ekatra militavantaH,</para>
  <para style="p">
    <verse number="35" style="v"/>teShAmeko vyavasthApako yIshuM parIkShituM papachCha,</para>
  <para style="p">
    <verse number="36" style="v"/>he guro vyavasthAshAstramadhye kAj nA shreShThA?</para>
  <para style="p">
    <verse number="37" style="v"/>tato yIshuruvAcha, tvaM sarvvAntaHkaraNaiH sarvvaprANaiH sarvvachittaishcha sAkaM prabhau parameshvare prIyasva,</para>
  <para style="p">
    <verse number="38" style="v"/>eShA prathamamahAj nA| tasyAH sadR^ishI dvitIyAj naiShA,</para>
  <para style="p">
    <verse number="39" style="v"/>tava samIpavAsini svAtmanIva prema kuru|</para>
  <para style="p">
    <verse number="40" style="v"/>anayo rdvayorAj nayoH kR^itsnavyavasthAyA bhaviShyadvaktR^igranthasya cha bhArastiShThati|</para>
  <para style="p">
    <verse number="41" style="v"/>anantaraM phirUshinAm ekatra sthitikAle yIshustAn paprachCha,</para>
  <para style="p">
    <verse number="42" style="v"/>khrIShTamadhi yuShmAkaM kIdR^igbodho jAyate? sa kasya santAnaH? tataste pratyavadan, dAyUdaH santAnaH|</para>
  <para style="p">
    <verse number="43" style="v"/>tadA sa uktavAn, tarhi dAyUd katham AtmAdhiShThAnena taM prabhuM vadati ?</para>
  <para style="p">
    <verse number="44" style="v"/>yathA mama prabhumidaM vAkyamavadat parameshvaraH| tavArIn pAdapIThaM te yAvannahi karomyahaM| tAvat kAlaM madIye tvaM dakShapArshva upAvisha| ato yadi dAyUd taM prabhuM vadati, rtiha sa kathaM tasya santAno bhavati?</para>
  <para style="p">
    <verse number="45" style="v"/>tadAnIM teShAM kopi tadvAkyasya kimapyuttaraM dAtuM nAshaknot;</para>
  <para style="p">
    <verse number="46" style="v"/>taddinamArabhya taM kimapi vAkyaM praShTuM kasyApi sAhaso nAbhavat|</para>
  <chapter number="23" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM yIshu rjananivahaM shiShyAMshchAvadat,</para>
  <para style="p">
    <verse number="2" style="v"/>adhyApakAH phirUshinashcha mUsAsane upavishanti,</para>
  <para style="p">
    <verse number="3" style="v"/>ataste yuShmAn yadyat mantum Aj nApayanti, tat manyadhvaM pAlayadhva ncha, kintu teShAM karmmAnurUpaM karmma na kurudhvaM; yatasteShAM vAkyamAtraM sAraM kAryye kimapi nAsti|</para>
  <para style="p">
    <verse number="4" style="v"/>te durvvahAn gurutarAn bhArAn badvvA manuShyANAM skandhepari samarpayanti, kintu svayama NgulyaikayApi na chAlayanti|</para>
  <para style="p">
    <verse number="5" style="v"/>kevalaM lokadarshanAya sarvvakarmmANi kurvvanti; phalataH paTTabandhAn prasAryya dhArayanti, svavastreShu cha dIrghagranthIn dhArayanti;</para>
  <para style="p">
    <verse number="6" style="v"/>bhojanabhavana uchchasthAnaM, bhajanabhavane pradhAnamAsanaM,</para>
  <para style="p">
    <verse number="7" style="v"/>haTThe namaskAraM gururiti sambodhana nchaitAni sarvvANi vA nChanti|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu yUyaM gurava iti sambodhanIyA mA bhavata, yato yuShmAkam ekaH khrIShTaeva guru</para>
  <para style="p">
    <verse number="9" style="v"/>ryUyaM sarvve mitho bhrAtarashcha| punaH pR^ithivyAM kamapi piteti mA sambudhyadhvaM, yato yuShmAkamekaH svargasthaeva pitA|</para>
  <para style="p">
    <verse number="10" style="v"/>yUyaM nAyaketi sambhAShitA mA bhavata, yato yuShmAkamekaH khrIShTaeva nAyakaH|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaM yuShmAkaM madhye yaH pumAn shreShThaH sa yuShmAn seviShyate|</para>
  <para style="p">
    <verse number="12" style="v"/>yato yaH svamunnamati, sa nataH kariShyate; kintu yaH kashchit svamavanataM karoti, sa unnataH kariShyate|</para>
  <para style="p">
    <verse number="13" style="v"/>hanta kapaTina upAdhyAyAH phirUshinashcha, yUyaM manujAnAM samakShaM svargadvAraM rundha, yUyaM svayaM tena na pravishatha, pravivikShUnapi vArayatha| vata kapaTina upAdhyAyAH phirUshinashcha yUyaM ChalAd dIrghaM prArthya vidhavAnAM sarvvasvaM grasatha, yuShmAkaM ghorataradaNDo bhaviShyati|</para>
  <para style="p">
    <verse number="14" style="v"/>hanta kapaTina upAdhyAyAH phirUshinashcha, yUyamekaM svadharmmAvalambinaM karttuM sAgaraM bhUmaNDala ncha pradakShiNIkurutha,</para>
  <para style="p">
    <verse number="15" style="v"/>ka nchana prApya svato dviguNanarakabhAjanaM taM kurutha|</para>
  <para style="p">
    <verse number="16" style="v"/>vata andhapathadarshakAH sarvve, yUyaM vadatha, mandirasya shapathakaraNAt kimapi na deyaM; kintu mandirasthasuvarNasya shapathakaraNAd deyaM|</para>
  <para style="p">
    <verse number="17" style="v"/>he mUDhA he andhAH suvarNaM tatsuvarNapAvakamandiram etayorubhayo rmadhye kiM shreyaH?</para>
  <para style="p">
    <verse number="18" style="v"/>anyachcha vadatha, yaj navedyAH shapathakaraNAt kimapi na deyaM, kintu taduparisthitasya naivedyasya shapathakaraNAd deyaM|</para>
  <para style="p">
    <verse number="19" style="v"/>he mUDhA he andhAH, naivedyaM tannaivedyapAvakavediretayorubhayo rmadhye kiM shreyaH?</para>
  <para style="p">
    <verse number="20" style="v"/>ataH kenachid yaj navedyAH shapathe kR^ite taduparisthasya sarvvasya shapathaH kriyate|</para>
  <para style="p">
    <verse number="21" style="v"/>kenachit mandirasya shapathe kR^ite mandiratannivAsinoH shapathaH kriyate|</para>
  <para style="p">
    <verse number="22" style="v"/>kenachit svargasya shapathe kR^ite IshvarIyasiMhAsanataduparyyupaviShTayoH shapathaH kriyate|</para>
  <para style="p">
    <verse number="23" style="v"/>hanta kapaTina upAdhyAyAH phirUshinashcha, yUyaM podinAyAH sitachChatrAyA jIrakasya cha dashamAMshAn dattha, kintu vyavasthAyA gurutarAn nyAyadayAvishvAsAn parityajatha; ime yuShmAbhirAcharaNIyA amI cha na laMghanIyAH|</para>
  <para style="p">
    <verse number="24" style="v"/>he andhapathadarshakA yUyaM mashakAn apasArayatha, kintu mahA NgAn grasatha|</para>
  <para style="p">
    <verse number="25" style="v"/>hanta kapaTina upAdhyAyAH phirUshinashcha, yUyaM pAnapAtrANAM bhojanapAtrANA ncha bahiH pariShkurutha; kintu tadabhyantaraM durAtmatayA kaluSheNa cha paripUrNamAste|</para>
  <para style="p">
    <verse number="26" style="v"/>he andhAH phirUshilokA Adau pAnapAtrANAM bhojanapAtrANA nchAbhyantaraM pariShkuruta, tena teShAM bahirapi pariShkAriShyate|</para>
  <para style="p">
    <verse number="27" style="v"/>hanta kapaTina upAdhyAyAH phirUshinashcha, yUyaM shuklIkR^itashmashAnasvarUpA bhavatha, yathA shmashAnabhavanasya bahishchAru, kintvabhyantaraM mR^italokAnAM kIkashaiH sarvvaprakAramalena cha paripUrNam;</para>
  <para style="p">
    <verse number="28" style="v"/>tathaiva yUyamapi lokAnAM samakShaM bahirdhArmmikAH kintvantaHkaraNeShu kevalakApaTyAdharmmAbhyAM paripUrNAH|</para>
  <para style="p">
    <verse number="29" style="v"/>hA hA kapaTina upAdhyAyAH phirUshinashcha, yUyaM bhaviShyadvAdinAM shmashAnagehaM nirmmAtha, sAdhUnAM shmashAnaniketanaM shobhayatha</para>
  <para style="p">
    <verse number="30" style="v"/>vadatha cha yadi vayaM sveShAM pUrvvapuruShANAM kAla asthAsyAma, tarhi bhaviShyadvAdinAM shoNitapAtane teShAM sahabhAgino nAbhaviShyAma|</para>
  <para style="p">
    <verse number="31" style="v"/>ato yUyaM bhaviShyadvAdighAtakAnAM santAnA iti svayameva sveShAM sAkShyaM dattha|</para>
  <para style="p">
    <verse number="32" style="v"/>ato yUyaM nijapUrvvapuruShANAM parimANapAtraM paripUrayata|</para>
  <para style="p">
    <verse number="33" style="v"/>re bhujagAH kR^iShNabhujagavaMshAH, yUyaM kathaM narakadaNDAd rakShiShyadhve|</para>
  <para style="p">
    <verse number="34" style="v"/>pashyata, yuShmAkamantikam ahaM bhaviShyadvAdino buddhimata upAdhyAyAMshcha preShayiShyAmi, kintu teShAM katipayA yuShmAbhi rghAniShyante, krushe cha ghAniShyante, kechid bhajanabhavane kaShAbhirAghAniShyante, nagare nagare tADiShyante cha;</para>
  <para style="p">
    <verse number="35" style="v"/>tena satpuruShasya hAbilo raktapAtamArabhya berikhiyaH putraM yaM sikhariyaM yUyaM mandirayaj navedyo rmadhye hatavantaH, tadIyashoNitapAtaM yAvad asmin deshe yAvatAM sAdhupuruShANAM shoNitapAto .abhavat tat sarvveShAmAgasAM daNDA yuShmAsu varttiShyante|</para>
  <para style="p">
    <verse number="36" style="v"/>ahaM yuShmAnta tathyaM vadAmi, vidyamAne.asmin puruShe sarvve varttiShyante|</para>
  <para style="p">
    <verse number="37" style="v"/>he yirUshAlam he yirUshAlam nagari tvaM bhaviShyadvAdino hatavatI, tava samIpaM preritAMshcha pAShANairAhatavatI, yathA kukkuTI shAvakAn pakShAdhaH saMgR^ihlAti, tathA tava santAnAn saMgrahItuM ahaM bahuvAram aichChaM; kintu tvaM na samamanyathAH|</para>
  <para style="p">
    <verse number="38" style="v"/>pashyata yaShmAkaM vAsasthAnam uchChinnaM tyakShyate|</para>
  <para style="p">
    <verse number="39" style="v"/>ahaM yuShmAn tathyaM vadAmi, yaH parameshvarasya nAmnAgachChati, sa dhanya iti vANIM yAvanna vadiShyatha, tAvat mAM puna rna drakShyatha|</para>
  <chapter number="24" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM yIshu ryadA mandirAd bahi rgachChati, tadAnIM shiShyAstaM mandiranirmmANaM darshayitumAgatAH|</para>
  <para style="p">
    <verse number="2" style="v"/>tato yIshustAnuvAcha, yUyaM kimetAni na pashyatha? yuShmAnahaM satyaM vadAmi, etannichayanasya pAShANaikamapyanyapAShANeाpari na sthAsyati sarvvANi bhUmisAt kAriShyante|</para>
  <para style="p">
    <verse number="3" style="v"/>anantaraM tasmin jaitunaparvvatopari samupaviShTe shiShyAstasya samIpamAgatya guptaM paprachChuH, etA ghaTanAH kadA bhaviShyanti? bhavata Agamanasya yugAntasya cha kiM lakShma? tadasmAn vadatu|</para>
  <para style="p">
    <verse number="4" style="v"/>tadAnIM yIshustAnavochat, avadhadvvaM, kopi yuShmAn na bhramayet|</para>
  <para style="p">
    <verse number="5" style="v"/>bahavo mama nAma gR^ihlanta AgamiShyanti, khrIShTo.ahameveti vAchaM vadanto bahUn bhramayiShyanti|</para>
  <para style="p">
    <verse number="6" style="v"/>yUya ncha saMgrAmasya raNasya chADambaraM shroShyatha, avadhadvvaM tena cha nchalA mA bhavata, etAnyavashyaM ghaTiShyante, kintu tadA yugAnto nahi|</para>
  <para style="p">
    <verse number="7" style="v"/>aparaM deshasya vipakSho desho rAjyasya vipakSho rAjyaM bhaviShyati, sthAne sthAne cha durbhikShaM mahAmArI bhUkampashcha bhaviShyanti,</para>
  <para style="p">
    <verse number="8" style="v"/>etAni duHkhopakramAH|</para>
  <para style="p">
    <verse number="9" style="v"/>tadAnIM lokA duHkhaM bhojayituM yuShmAn parakareShu samarpayiShyanti haniShyanti cha, tathA mama nAmakAraNAd yUyaM sarvvadeshIyamanujAnAM samIpe ghR^iNArhA bhaviShyatha|</para>
  <para style="p">
    <verse number="10" style="v"/>bahuShu vighnaM prAptavatsu parasparam R^iृtIyAM kR^itavatsu cha eko.aparaM parakareShu samarpayiShyati|</para>
  <para style="p">
    <verse number="11" style="v"/>tathA bahavo mR^iShAbhaviShyadvAdina upasthAya bahUn bhramayiShyanti|</para>
  <para style="p">
    <verse number="12" style="v"/>duShkarmmaNAM bAhulyA ncha bahUnAM prema shItalaM bhaviShyati|</para>
  <para style="p">
    <verse number="13" style="v"/>kintu yaH kashchit sheShaM yAvad dhairyyamAshrayate, saeva paritrAyiShyate|</para>
  <para style="p">
    <verse number="14" style="v"/>aparaM sarvvadeshIyalokAn pratimAkShI bhavituM rAjasya shubhasamAchAraH sarvvajagati prachAriShyate, etAdR^ishi sati yugAnta upasthAsyati|</para>
  <para style="p">
    <verse number="15" style="v"/>ato yat sarvvanAshakR^idghR^iNArhaM vastu dAniyelbhaviShyadvadinA proktaM tad yadA puNyasthAne sthApitaM drakShyatha, (yaH paThati, sa budhyatAM)</para>
  <para style="p">
    <verse number="16" style="v"/>tadAnIM ye yihUdIyadeshe tiShThanti, te parvvateShu palAyantAM|</para>
  <para style="p">
    <verse number="17" style="v"/>yaH kashchid gR^ihapR^iShThe tiShThati, sa gR^ihAt kimapi vastvAnetum adheा nAvarohet|</para>
  <para style="p">
    <verse number="18" style="v"/>yashcha kShetre tiShThati, sopi vastramAnetuM parAvR^itya na yAyAt|</para>
  <para style="p">
    <verse number="19" style="v"/>tadAnIM garbhiNIstanyapAyayitrINAM durgati rbhaviShyati|</para>
  <para style="p">
    <verse number="20" style="v"/>ato yaShmAkaM palAyanaM shItakAle vishrAmavAre vA yanna bhavet, tadarthaM prArthayadhvam|</para>
  <para style="p">
    <verse number="21" style="v"/>A jagadArambhAd etatkAlaparyyanantaM yAdR^ishaH kadApi nAbhavat na cha bhaviShyati tAdR^isho mahAkleshastadAnIm upasthAsyati|</para>
  <para style="p">
    <verse number="22" style="v"/>tasya kleshasya samayo yadi hsvo na kriyeta, tarhi kasyApi prANino rakShaNaM bhavituM na shaknuyAt, kintu manonItamanujAnAM kR^ite sa kAlo hsvIkariShyate|</para>
  <para style="p">
    <verse number="23" style="v"/>apara ncha pashyata, khrIShTo.atra vidyate, vA tatra vidyate, tadAnIM yadI kashchid yuShmAna iti vAkyaM vadati, tathApi tat na pratIt|</para>
  <para style="p">
    <verse number="24" style="v"/>yato bhAktakhrIShTA bhAktabhaviShyadvAdinashcha upasthAya yAni mahanti lakShmANi chitrakarmmANi cha prakAshayiShyanti, tai ryadi sambhavet tarhi manonItamAnavA api bhrAmiShyante|</para>
  <para style="p">
    <verse number="25" style="v"/>pashyata, ghaTanAtaH pUrvvaM yuShmAn vArttAm avAdiSham|</para>
  <para style="p">
    <verse number="26" style="v"/>ataH pashyata, sa prAntare vidyata iti vAkye kenachit kathitepi bahi rmA gachChata, vA pashyata, sontaHpure vidyate, etadvAkya uktepi mA pratIta|</para>
  <para style="p">
    <verse number="27" style="v"/>yato yathA vidyut pUrvvadisho nirgatya pashchimadishaM yAvat prakAshate, tathA mAnuShaputrasyApyAgamanaM bhaviShyati|</para>
  <para style="p">
    <verse number="28" style="v"/>yatra shavastiShThati, tatreva gR^idhrA milanti|</para>
  <para style="p">
    <verse number="29" style="v"/>aparaM tasya kleshasamayasyAvyavahitaparatra sUryyasya tejo lopsyate, chandramA jyosnAM na kariShyati, nabhaso nakShatrANi patiShyanti, gagaNIyA grahAshcha vichaliShyanti|</para>
  <para style="p">
    <verse number="30" style="v"/>tadAnIm AkAshamadhye manujasutasya lakShma darshiShyate, tato nijaparAkrameNa mahAtejasA cha meghArUDhaM manujasutaM nabhasAgachChantaM vilokya pR^ithivyAH sarvvavaMshIyA vilapiShyanti|</para>
  <para style="p">
    <verse number="31" style="v"/>tadAnIM sa mahAshabdAyamAnatUryyA vAdakAn nijadUtAn praheShyati, te vyomna ekasImAto.aparasImAM yAvat chaturdishastasya manonItajanAn AnIya melayiShyanti|</para>
  <para style="p">
    <verse number="32" style="v"/>uDumbarapAdapasya dR^iShTAntaM shikShadhvaM; yadA tasya navInAH shAkhA jAyante, pallavAdishcha nirgachChati, tadA nidAghakAlaH savidho bhavatIti yUyaM jAnItha;</para>
  <para style="p">
    <verse number="33" style="v"/>tadvad etA ghaTanA dR^iShTvA sa samayo dvAra upAsthAd iti jAnIta|</para>
  <para style="p">
    <verse number="34" style="v"/>yuShmAnahaM tathyaM vadAmi, idAnIntanajanAnAM gamanAt pUrvvameva tAni sarvvANi ghaTiShyante|</para>
  <para style="p">
    <verse number="35" style="v"/>nabhomedinyo rluptayorapi mama vAk kadApi na lopsyate|</para>
  <para style="p">
    <verse number="36" style="v"/>aparaM mama tAtaM vinA mAnuShaH svargastho dUto vA kopi taddinaM taddaNDa ncha na j nApayati|</para>
  <para style="p">
    <verse number="37" style="v"/>aparaM nohe vidyamAne yAdR^ishamabhavat tAdR^ishaM manujasutasyAgamanakAlepi bhaviShyati|</para>
  <para style="p">
    <verse number="38" style="v"/>phalato jalAplAvanAt pUrvvaM yaddinaM yAvat nohaH potaM nArohat, tAvatkAlaM yathA manuShyA bhojane pAne vivahane vivAhane cha pravR^ittA Asan;</para>
  <para style="p">
    <verse number="39" style="v"/>aparam AplAvitoyamAgatya yAvat sakalamanujAn plAvayitvA nAnayat, tAvat te yathA na vidAmAsuH, tathA manujasutAgamanepi bhaviShyati|</para>
  <para style="p">
    <verse number="40" style="v"/>tadA kShetrasthitayordvayoreko dhAriShyate, aparastyAjiShyate|</para>
  <para style="p">
    <verse number="41" style="v"/>tathA peShaNyA piMShatyorubhayo ryoShitorekA dhAriShyate.aparA tyAjiShyate|</para>
  <para style="p">
    <verse number="42" style="v"/>yuShmAkaM prabhuH kasmin daNDa AgamiShyati, tad yuShmAbhi rnAvagamyate, tasmAt jAgrataH santastiShThata|</para>
  <para style="p">
    <verse number="43" style="v"/>kutra yAme stena AgamiShyatIti ched gR^ihastho j nAtum ashakShyat, tarhi jAgaritvA taM sandhiM karttitum avArayiShyat tad jAnIta|</para>
  <para style="p">
    <verse number="44" style="v"/>yuShmAbhiravadhIyatAM, yato yuShmAbhi ryatra na budhyate, tatraiva daNDe manujasuta AyAsyati|</para>
  <para style="p">
    <verse number="45" style="v"/>prabhu rnijaparivArAn yathAkAlaM bhojayituM yaM dAsam adhyakShIkR^itya sthApayati, tAdR^isho vishvAsyo dhImAn dAsaH kaH?</para>
  <para style="p">
    <verse number="46" style="v"/>prabhurAgatya yaM dAsaM tathAcharantaM vIkShate, saeva dhanyaH|</para>
  <para style="p">
    <verse number="47" style="v"/>yuShmAnahaM satyaM vadAmi, sa taM nijasarvvasvasyAdhipaM kariShyati|</para>
  <para style="p">
    <verse number="48" style="v"/>kintu prabhurAgantuM vilambata iti manasi chintayitvA yo duShTo dAso</para>
  <para style="p">
    <verse number="49" style="v"/>.aparadAsAn praharttuM mattAnAM sa Nge bhoktuM pAtu ncha pravarttate,</para>
  <para style="p">
    <verse number="50" style="v"/>sa dAso yadA nApekShate, ya ncha daNDaM na jAnAti, tatkAlaeva tatprabhurupasthAsyati|</para>
  <para style="p">
    <verse number="51" style="v"/>tadA taM daNDayitvA yatra sthAne rodanaM dantagharShaNa nchAsAte, tatra kapaTibhiH sAkaM taddashAM nirUpayiShyati|</para>
  <chapter number="25" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yA dasha kanyAH pradIpAn gR^ihlatyo varaM sAkShAt karttuM bahiritAH, tAbhistadA svargIyarAjyasya sAdR^ishyaM bhaviShyati|</para>
  <para style="p">
    <verse number="2" style="v"/>tAsAM kanyAnAM madhye pa ncha sudhiyaH pa ncha durdhiya Asan|</para>
  <para style="p">
    <verse number="3" style="v"/>yA durdhiyastAH pradIpAn sa Nge gR^ihItvA tailaM na jagR^ihuH,</para>
  <para style="p">
    <verse number="4" style="v"/>kintu sudhiyaH pradIpAn pAtreNa taila ncha jagR^ihuH|</para>
  <para style="p">
    <verse number="5" style="v"/>anantaraM vare vilambite tAH sarvvA nidrAviShTA nidrAM jagmuH|</para>
  <para style="p">
    <verse number="6" style="v"/>anantaram arddharAtre pashyata vara AgachChati, taM sAkShAt karttuM bahiryAteti janaravAt</para>
  <para style="p">
    <verse number="7" style="v"/>tAH sarvvAH kanyA utthAya pradIpAn AsAdayituM Arabhanta|</para>
  <para style="p">
    <verse number="8" style="v"/>tato durdhiyaH sudhiya UchuH, ki nchit tailaM datta, pradIpA asmAkaM nirvvANAH|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu sudhiyaH pratyavadan, datte yuShmAnasmAMshcha prati tailaM nyUnIbhavet, tasmAd vikretR^iNAM samIpaM gatvA svArthaM tailaM krINIta|</para>
  <para style="p">
    <verse number="10" style="v"/>tadA tAsu kretuM gatAsu vara AjagAma, tato yAH sajjitA Asan, tAstena sAkaM vivAhIyaM veshma pravivishuH|</para>
  <para style="p">
    <verse number="11" style="v"/>anantaraM dvAre ruddhe aparAH kanyA Agatya jagaduH, he prabho, he prabho, asmAn prati dvAraM mochaya|</para>
  <para style="p">
    <verse number="12" style="v"/>kintu sa uktavAn, tathyaM vadAmi, yuShmAnahaM na vedmi|</para>
  <para style="p">
    <verse number="13" style="v"/>ato jAgrataH santastiShThata, manujasutaH kasmin dine kasmin daNDe vAgamiShyati, tad yuShmAbhi rna j nAyate|</para>
  <para style="p">
    <verse number="14" style="v"/>aparaM sa etAdR^ishaH kasyachit puMsastulyaH, yo dUradeshaM prati yAtrAkAle nijadAsAn AhUya teShAM svasvasAmarthyAnurUpam</para>
  <para style="p">
    <verse number="15" style="v"/>ekasmin mudrANAM pa ncha poTalikAH anyasmiMshcha dve poTalike aparasmiMshcha poTalikaikAm itthaM pratijanaM samarpya svayaM pravAsaM gatavAn|</para>
  <para style="p">
    <verse number="16" style="v"/>anantaraM yo dAsaH pa ncha poTalikAH labdhavAn, sa gatvA vANijyaM vidhAya tA dviguNIchakAra|</para>
  <para style="p">
    <verse number="17" style="v"/>yashcha dAso dve poTalike alabhata, sopi tA mudrA dviguNIchakAra|</para>
  <para style="p">
    <verse number="18" style="v"/>kintu yo dAsa ekAM poTalikAM labdhavAn, sa gatvA bhUmiM khanitvA tanmadhye nijaprabhostA mudrA gopayA nchakAra|</para>
  <para style="p">
    <verse number="19" style="v"/>tadanantaraM bahutithe kAle gate teShAM dAsAnAM prabhurAgatya tairdAsaiH samaM gaNayA nchakAra|</para>
  <para style="p">
    <verse number="20" style="v"/>tadAnIM yaH pa ncha poTalikAH prAptavAn sa tA dviguNIkR^itamudrA AnIya jagAda; he prabho, bhavatA mayi pa ncha poTalikAH samarpitAH, pashyatu, tA mayA dviguNIkR^itAH|</para>
  <para style="p">
    <verse number="21" style="v"/>tadAnIM tasya prabhustamuvAcha, he uttama vishvAsya dAsa, tvaM dhanyosi, stokena vishvAsyo jAtaH, tasmAt tvAM bahuvittAdhipaM karomi, tvaM svaprabhoH sukhasya bhAgI bhava|</para>
  <para style="p">
    <verse number="22" style="v"/>tato yena dve poTalike labdhe sopyAgatya jagAda, he prabho, bhavatA mayi dve poTalike samarpite, pashyatu te mayA dviguNIkR^ite|</para>
  <para style="p">
    <verse number="23" style="v"/>tena tasya prabhustamavochat, he uttama vishvAsya dAsa, tvaM dhanyosi, stokena vishvAsyo jAtaH, tasmAt tvAM bahudraviNAdhipaM karomi, tvaM nijaprabhoH sukhasya bhAgI bhava|</para>
  <para style="p">
    <verse number="24" style="v"/>anantaraM ya ekAM poTalikAM labdhavAn, sa etya kathitavAn, he prabho, tvAM kaThinanaraM j nAtavAn, tvayA yatra noptaM, tatraiva kR^ityate, yatra cha na kIrNaM, tatraiva saMgR^ihyate|</para>
  <para style="p">
    <verse number="25" style="v"/>atohaM sasha NkaH san gatvA tava mudrA bhUmadhye saMgopya sthApitavAn, pashya, tava yat tadeva gR^ihANa|</para>
  <para style="p">
    <verse number="26" style="v"/>tadA tasya prabhuH pratyavadat re duShTAlasa dAsa, yatrAhaM na vapAmi, tatra Chinadmi, yatra cha na kirAmi, tatreva saMgR^ihlAmIti chedajAnAstarhi</para>
  <para style="p">
    <verse number="27" style="v"/>vaNikShu mama vittArpaNaM tavochitamAsIt, yenAhamAgatya vR^idvyA sAkaM mUlamudrAH prApsyam|</para>
  <para style="p">
    <verse number="28" style="v"/>atosmAt tAM poTalikAm AdAya yasya dasha poTalikAH santi tasminnarpayata|</para>
  <para style="p">
    <verse number="29" style="v"/>yena vardvyate tasminnaivArpiShyate, tasyaiva cha bAhulyaM bhaviShyati, kintu yena na vardvyate, tasyAntike yat ki nchana tiShThati, tadapi punarneShyate|</para>
  <para style="p">
    <verse number="30" style="v"/>aparaM yUyaM tamakarmmaNyaM dAsaM nItvA yatra sthAne krandanaM dantagharShaNa ncha vidyete, tasmin bahirbhUtatamasi nikShipata|</para>
  <para style="p">
    <verse number="31" style="v"/>yadA manujasutaH pavitradUtAn sa NginaH kR^itvA nijaprabhAvenAgatya nijatejomaye siMhAsane nivekShyati,</para>
  <para style="p">
    <verse number="32" style="v"/>tadA tatsammukhe sarvvajAtIyA janA saMmeliShyanti| tato meShapAlako yathA ChAgebhyo.avIn pR^ithak karoti tathA sopyekasmAdanyam itthaM tAn pR^ithaka kR^itvAvIn</para>
  <para style="p">
    <verse number="33" style="v"/>dakShiNe ChAgAMshcha vAme sthApayiShyati|</para>
  <para style="p">
    <verse number="34" style="v"/>tataH paraM rAjA dakShiNasthitAn mAnavAn vadiShyati, AgachChata mattAtasyAnugrahabhAjanAni, yuShmatkR^ita A jagadArambhat yad rAjyam AsAditaM tadadhikuruta|</para>
  <para style="p">
    <verse number="35" style="v"/>yato bubhukShitAya mahyaM bhojyam adatta, pipAsitAya peyamadatta, videshinaM mAM svasthAnamanayata,</para>
  <para style="p">
    <verse number="36" style="v"/>vastrahInaM mAM vasanaM paryyadhApayata, pIDItaM mAM draShTumAgachChata, kArAstha ncha mAM vIkShituma AgachChata|</para>
  <para style="p">
    <verse number="37" style="v"/>tadA dhArmmikAH prativadiShyanti, he prabho, kadA tvAM kShudhitaM vIkShya vayamabhojayAma? vA pipAsitaM vIkShya apAyayAma?</para>
  <para style="p">
    <verse number="38" style="v"/>kadA vA tvAM videshinaM vilokya svasthAnamanayAma? kadA vA tvAM nagnaM vIkShya vasanaM paryyadhApayAma?</para>
  <para style="p">
    <verse number="39" style="v"/>kadA vA tvAM pIDitaM kArAstha ncha vIkShya tvadantikamagachChAma?</para>
  <para style="p">
    <verse number="40" style="v"/>tadAnIM rAjA tAn prativadiShyati, yuShmAnahaM satyaM vadAmi, mamaiteShAM bhrAtR^iNAM madhye ka nchanaikaM kShudratamaM prati yad akuruta, tanmAM pratyakuruta|</para>
  <para style="p">
    <verse number="41" style="v"/>pashchAt sa vAmasthitAn janAn vadiShyati, re shApagrastAH sarvve, shaitAne tasya dUtebhyashcha yo.anantavahnirAsAdita Aste, yUyaM madantikAt tamagniM gachChata|</para>
  <para style="p">
    <verse number="42" style="v"/>yato kShudhitAya mahyamAhAraM nAdatta, pipAsitAya mahyaM peyaM nAdatta,</para>
  <para style="p">
    <verse number="43" style="v"/>videshinaM mAM svasthAnaM nAnayata, vasanahInaM mAM vasanaM na paryyadhApayata, pIDitaM kArAstha ncha mAM vIkShituM nAgachChata|</para>
  <para style="p">
    <verse number="44" style="v"/>tadA te prativadiShyanti, he prabho, kadA tvAM kShudhitaM vA pipAsitaM vA videshinaM vA nagnaM vA pIDitaM vA kArAsthaM vIkShya tvAM nAsevAmahi?</para>
  <para style="p">
    <verse number="45" style="v"/>tadA sa tAn vadiShyati, tathyamahaM yuShmAn bravImi, yuShmAbhireShAM ka nchana kShodiShThaM prati yannAkAri, tanmAM pratyeva nAkAri|</para>
  <para style="p">
    <verse number="46" style="v"/>pashchAdamyanantashAstiM kintu dhArmmikA anantAyuShaM bhoktuM yAsyanti|</para>
  <chapter number="26" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yIshuretAn prastAvAn samApya shiShyAnUche,</para>
  <para style="p">
    <verse number="2" style="v"/>yuShmAbhi rj nAtaM dinadvayAt paraM nistAramaha upasthAsyati, tatra manujasutaH krushena hantuM parakareShu samarpiShyate|</para>
  <para style="p">
    <verse number="3" style="v"/>tataH paraM pradhAnayAjakAdhyApakaprA nchaH kiyaphAnAmno mahAyAjakasyATTAlikAyAM militvA</para>
  <para style="p">
    <verse number="4" style="v"/>kenopAyena yIshuM dhR^itvA hantuM shaknuyuriti mantrayA nchakruH|</para>
  <para style="p">
    <verse number="5" style="v"/>kintu tairuktaM mahakAle na dharttavyaH, dhR^ite prajAnAM kalahena bhavituM shakyate|</para>
  <para style="p">
    <verse number="6" style="v"/>tato baithaniyApure shimonAkhyasya kuShThino veshmani yIshau tiShThati</para>
  <para style="p">
    <verse number="7" style="v"/>kAchana yoShA shvetopalabhAjanena mahArghyaM sugandhi tailamAnIya bhojanAyopavishatastasya shirobhyaShechat|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu tadAlokya tachChiShyaiH kupitairuktaM, kuta itthamapavyayate?</para>
  <para style="p">
    <verse number="9" style="v"/>chedidaM vyakreShyata, tarhi bhUrimUlyaM prApya daridrebhyo vyatAriShyata|</para>
  <para style="p">
    <verse number="10" style="v"/>yIshunA tadavagatya te samuditAH, yoShAmenAM kuto duHkhinIM kurutha, sA mAM prati sAdhu karmmAkArShIt|</para>
  <para style="p">
    <verse number="11" style="v"/>yuShmAkamaM samIpe daridrAH satatamevAsate, kintu yuShmAkamantikehaM nAse satataM|</para>
  <para style="p">
    <verse number="12" style="v"/>sA mama kAyopari sugandhitailaM siktvA mama shmashAnadAnakarmmAkArShIt|</para>
  <para style="p">
    <verse number="13" style="v"/>atohaM yuShmAn tathyaM vadAmi sarvvasmin jagati yatra yatraiSha susamAchAraH prachAriShyate, tatra tatraitasyA nAryyAH smaraNArtham karmmedaM prachAriShyate|</para>
  <para style="p">
    <verse number="14" style="v"/>tato dvAdashashiShyANAm IShkariyotIyayihUdAnAmaka ekaH shiShyaH pradhAnayAjakAnAmantikaM gatvA kathitavAn,</para>
  <para style="p">
    <verse number="15" style="v"/>yadi yuShmAkaM kareShu yIshuM samarpayAmi, tarhi kiM dAsyatha? tadAnIM te tasmai triMshanmudrA dAtuM sthirIkR^itavantaH|</para>
  <para style="p">
    <verse number="16" style="v"/>sa tadArabhya taM parakareShu samarpayituM suyogaM cheShTitavAn|</para>
  <para style="p">
    <verse number="17" style="v"/>anantaraM kiNvashUnyapUpaparvvaNaH prathamehni shiShyA yIshum upagatya paprachChuH bhavatkR^ite kutra vayaM nistAramahabhojyam AyojayiShyAmaH? bhavataH kechChA?</para>
  <para style="p">
    <verse number="18" style="v"/>tadA sa gaditavAn, madhyenagaramamukapuMsaH samIpaM vrajitvA vadata, guru rgaditavAn, matkAlaH savidhaH, saha shiShyaistvadAlaye nistAramahabhojyaM bhokShye|</para>
  <para style="p">
    <verse number="19" style="v"/>tadA shiShyA yIshostAdR^ishanideshAnurUpakarmma vidhAya tatra nistAramahabhojyamAsAdayAmAsuH|</para>
  <para style="p">
    <verse number="20" style="v"/>tataH sandhyAyAM satyAM dvAdashabhiH shiShyaiH sAkaM sa nyavishat|</para>
  <para style="p">
    <verse number="21" style="v"/>aparaM bhu njAna uktavAn yuShmAn tathyaM vadAmi, yuShmAkameko mAM parakareShu samarpayiShyati|</para>
  <para style="p">
    <verse number="22" style="v"/>tadA te.atIva duHkhitA ekaikasho vaktumArebhire, he prabho, sa kimahaM?</para>
  <para style="p">
    <verse number="23" style="v"/>tataH sa jagAda, mayA sAkaM yo jano bhojanapAtre karaM saMkShipati, sa eva mAM parakareShu samarpayiShyati|</para>
  <para style="p">
    <verse number="24" style="v"/>manujasutamadhi yAdR^ishaM likhitamAste, tadanurUpA tadgati rbhaviShyati; kintu yena puMsA sa parakareShu samarpayiShyate, hA hA chet sa nAjaniShyata, tadA tasya kShemamabhaviShyat|</para>
  <para style="p">
    <verse number="25" style="v"/>tadA yihUdAnAmA yo janastaM parakareShu samarpayiShyati, sa uktavAn, he guro, sa kimahaM? tataH sa pratyuktavAn, tvayA satyaM gaditam|</para>
  <para style="p">
    <verse number="26" style="v"/>anantaraM teShAmashanakAle yIshuH pUpamAdAyeshvarIyaguNAnanUdya bhaMktvA shiShyebhyaH pradAya jagAda, madvapuHsvarUpamimaM gR^ihItvA khAdata|</para>
  <para style="p">
    <verse number="27" style="v"/>pashchAt sa kaMsaM gR^ihlan IshvarIyaguNAnanUdya tebhyaH pradAya kathitavAn, sarvvai ryuShmAbhiranena pAtavyaM,</para>
  <para style="p">
    <verse number="28" style="v"/>yasmAdanekeShAM pApamarShaNAya pAtitaM yanmannUtnaniyamarUpashoNitaM tadetat|</para>
  <para style="p">
    <verse number="29" style="v"/>aparamahaM nUtnagostanIrasaM na pAsyAmi, tAvat gostanIphalarasaM punaH kadApi na pAsyAmi|</para>
  <para style="p">
    <verse number="30" style="v"/>pashchAt te gItamekaM saMgIya jaitunAkhyagiriM gatavantaH|</para>
  <para style="p">
    <verse number="31" style="v"/>tadAnIM yIshustAnavochat, asyAM rajanyAmahaM yuShmAkaM sarvveShAM vighnarUpo bhaviShyAmi, yato likhitamAste, "meShANAM rakShako yastaM prahariShyAmyahaM tataH| meShANAM nivaho nUnaM pravikIrNo bhaviShyati"||</para>
  <para style="p">
    <verse number="32" style="v"/>kintu shmashAnAt samutthAya yuShmAkamagre.ahaM gAlIlaM gamiShyAmi|</para>
  <para style="p">
    <verse number="33" style="v"/>pitarastaM provAcha, bhavAMshchet sarvveShAM vighnarUpo bhavati, tathApi mama na bhaviShyati|</para>
  <para style="p">
    <verse number="34" style="v"/>tato yIshunA sa uktaH, tubhyamahaM tathyaM kathayAmi, yAminyAmasyAM charaNAyudhasya ravAt pUrvvaM tvaM mAM tri rnA NgIkariShyasi|</para>
  <para style="p">
    <verse number="35" style="v"/>tataH pitara uditavAn, yadyapi tvayA samaM marttavyaM, tathApi kadApi tvAM na nA NgIkariShyAmi; tathaiva sarvve shiShyAshchochuH|</para>
  <para style="p">
    <verse number="36" style="v"/>anantaraM yIshuH shiShyaiH sAkaM getshimAnInAmakaM sthAnaM prasthAya tebhyaH kathitavAn, adaH sthAnaM gatvA yAvadahaM prArthayiShye tAvad yUyamatropavishata|</para>
  <para style="p">
    <verse number="37" style="v"/>pashchAt sa pitaraM sivadiyasutau cha sa NginaH kR^itvA gatavAn, shokAkulo.atIva vyathitashcha babhUva|</para>
  <para style="p">
    <verse number="38" style="v"/>tAnavAdIchcha mR^itiyAtaneva matprANAnAM yAtanA jAyate, yUyamatra mayA sArddhaM jAgR^ita|</para>
  <para style="p">
    <verse number="39" style="v"/>tataH sa ki nchiddUraM gatvAdhomukhaH patan prArthayA nchakre, he matpitaryadi bhavituM shaknoti, tarhi kaMso.ayaM matto dUraM yAtu; kintu madichChAvat na bhavatu, tvadichChAvad bhavatu|</para>
  <para style="p">
    <verse number="40" style="v"/>tataH sa shiShyAnupetya tAn nidrato nirIkShya pitarAya kathayAmAsa, yUyaM mayA sAkaM daNDamekamapi jAgarituM nAshankuta?</para>
  <para style="p">
    <verse number="41" style="v"/>parIkShAyAM na patituM jAgR^ita prArthayadhva ncha; AtmA samudyatosti, kintu vapu rdurbbalaM|</para>
  <para style="p">
    <verse number="42" style="v"/>sa dvitIyavAraM prArthayA nchakre, he mattAta, na pIte yadi kaMsamidaM matto dUraM yAtuM na shaknoti, tarhi tvadichChAvad bhavatu|</para>
  <para style="p">
    <verse number="43" style="v"/>sa punaretya tAn nidrato dadarsha, yatasteShAM netrANi nidrayA pUrNAnyAsan|</para>
  <para style="p">
    <verse number="44" style="v"/>pashchAt sa tAn vihAya vrajitvA tR^itIyavAraM pUrvvavat kathayan prArthitavAn|</para>
  <para style="p">
    <verse number="45" style="v"/>tataH shiShyAnupAgatya gaditavAn, sAmprataM shayAnAH kiM vishrAmyatha? pashyata, samaya upAsthAt, manujasutaH pApinAM kareShu samarpyate|</para>
  <para style="p">
    <verse number="46" style="v"/>uttiShThata, vayaM yAmaH, yo mAM parakareShu masarpayiShyati, pashyata, sa samIpamAyAti|</para>
  <para style="p">
    <verse number="47" style="v"/>etatkathAkathanakAle dvAdashashiShyANAmeko yihUdAnAmako mukhyayAjakalokaprAchInaiH prahitAn asidhAriyaShTidhAriNo manujAn gR^ihItvA tatsamIpamupatasthau|</para>
  <para style="p">
    <verse number="48" style="v"/>asau parakareShvarpayitA pUrvvaM tAn itthaM sa NketayAmAsa, yamahaM chumbiShye, so.asau manujaH,saeva yuShmAbhi rdhAryyatAM|</para>
  <para style="p">
    <verse number="49" style="v"/>tadA sa sapadi yIshumupAgatya he guro, praNamAmItyuktvA taM chuchumbe|</para>
  <para style="p">
    <verse number="50" style="v"/>tadA yIshustamuvAcha, he mitraM kimarthamAgatosi? tadA tairAgatya yIshurAkramya daghre|</para>
  <para style="p">
    <verse number="51" style="v"/>tato yIshoH sa NginAmekaH karaM prasAryya koShAdasiM bahiShkR^itya mahAyAjakasya dAsamekamAhatya tasya karNaM chichCheda|</para>
  <para style="p">
    <verse number="52" style="v"/>tato yIshustaM jagAda, khaDgaM svasthAneे nidhehi yato ye ye janA asiM dhArayanti, taevAsinA vinashyanti|</para>
  <para style="p">
    <verse number="53" style="v"/>aparaM pitA yathA madantikaM svargIyadUtAnAM dvAdashavAhinIto.adhikaM prahiNuyAt mayA tamuddishyedAnImeva tathA prArthayituM na shakyate, tvayA kimitthaM j nAyate?</para>
  <para style="p">
    <verse number="54" style="v"/>tathA satItthaM ghaTiShyate dharmmapustakasya yadidaM vAkyaM tat kathaM sidhyet?</para>
  <para style="p">
    <verse number="55" style="v"/>tadAnIM yIshu rjananivahaM jagAda, yUyaM khaDgayaShTIn AdAya mAM kiM chauraM dharttumAyAtAH? ahaM pratyahaM yuShmAbhiH sAkamupavishya samupAdishaM, tadA mAM nAdharata;</para>
  <para style="p">
    <verse number="56" style="v"/>kintu bhaviShyadvAdinAM vAkyAnAM saMsiddhaye sarvvametadabhUt|tadA sarvve shiShyAstaM vihAya palAyanta|</para>
  <para style="p">
    <verse number="57" style="v"/>anantaraM te manujA yIshuM dhR^itvA yatrAdhyApakaprA nchaH pariShadaM kurvvanta upAvishan tatra kiyaphAnAाmakamahAyAjakasyAntikaM ninyuH|</para>
  <para style="p">
    <verse number="58" style="v"/>kintu sheShe kiM bhaviShyatIti vettuM pitaro dUre tatpashchAd vrajitvA mahAyAjakasyATTAlikAM pravishya dAsaiH sahita upAvishat|</para>
  <para style="p">
    <verse number="59" style="v"/>tadAnIM pradhAnayAjakaprAchInamantriNaH sarvve yIshuM hantuM mR^iShAsAkShyam alipsanta,</para>
  <para style="p">
    <verse number="60" style="v"/>kintu na lebhire| anekeShu mR^iShAsAkShiShvAgateShvapi tanna prApuH|</para>
  <para style="p">
    <verse number="61" style="v"/>sheShe dvau mR^iShAsAkShiNAvAgatya jagadatuH, pumAnayamakathayat, ahamIshvaramandiraM bhaMktvA dinatrayamadhye tannirmmAtuM shaknomi|</para>
  <para style="p">
    <verse number="62" style="v"/>tadA mahAyAjaka utthAya yIshum avAdIt| tvaM kimapi na prativadasi? tvAmadhi kimete sAkShyaM vadanti?</para>
  <para style="p">
    <verse number="63" style="v"/>kintu yIshu rmaunIbhUya tasyau| tato mahAyAjaka uktavAn, tvAm amareshvaranAmnA shapayAmi, tvamIshvarasya putro.abhiShikto bhavasi naveti vada|</para>
  <para style="p">
    <verse number="64" style="v"/>yIshuH pratyavadat, tvaM satyamuktavAn; ahaM yuShmAn tathyaM vadAmi, itaHparaM manujasutaM sarvvashaktimato dakShiNapArshve sthAtuM gagaNasthaM jaladharAnAruhyAyAntaM vIkShadhve|</para>
  <para style="p">
    <verse number="65" style="v"/>tadA mahAyAjako nijavasanaM ChittvA jagAda, eSha IshvaraM ninditavAn, asmAkamaparasAkShyeNa kiM prayojanaM? pashyata, yUyamevAsyAsyAd IshvaranindAM shrutavantaH,</para>
  <para style="p">
    <verse number="66" style="v"/>yuShmAbhiH kiM vivichyate? te pratyUchuH, vadhArho.ayaM|</para>
  <para style="p">
    <verse number="67" style="v"/>tato lokaistadAsye niShThIvitaM kechit pratalamAhatya kechichcha chapeTamAhatya babhAShire,</para>
  <para style="p">
    <verse number="68" style="v"/>he khrIShTa tvAM kashchapeTamAhatavAn? iti gaNayitvA vadAsmAn|</para>
  <para style="p">
    <verse number="69" style="v"/>pitaro bahira Ngana upavishati, tadAnImekA dAsI tamupAgatya babhAShe, tvaM gAlIlIyayIshoH sahacharaekaH|</para>
  <para style="p">
    <verse number="70" style="v"/>kintu sa sarvveShAM samakSham ana NgIkR^ityAvAdIt, tvayA yaduchyate, tadarthamahaM na vedmi|</para>
  <para style="p">
    <verse number="71" style="v"/>tadA tasmin bahirdvAraM gate .anyA dAsI taM nirIkShya tatratyajanAnavadat, ayamapi nAsaratIyayIshunA sArddham AsIt|</para>
  <para style="p">
    <verse number="72" style="v"/>tataH sa shapathena punarana NgIkR^itya kathitavAn, taM naraM na parichinomi|</para>
  <para style="p">
    <verse number="73" style="v"/>kShaNAt paraM tiShThanto janA etya pitaram avadan, tvamavashyaM teShAmeka iti tvaduchchAraNameva dyotayati|</para>
  <para style="p">
    <verse number="74" style="v"/>kintu so.abhishapya kathitavAn, taM janaM nAhaM parichinomi, tadA sapadi kukkuTo rurAva|</para>
  <para style="p">
    <verse number="75" style="v"/>kukkuTaravAt prAk tvaM mAM trirapAhnoShyase, yaiShA vAg yIshunAvAdi tAM pitaraH saMsmR^itya bahiritvA khedAd bhR^ishaM chakranda|</para>
  <chapter number="27" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>prabhAte jAte pradhAnayAjakalokaprAchInA yIshuM hantuM tatpratikUlaM mantrayitvA</para>
  <para style="p">
    <verse number="2" style="v"/>taM badvvA nItvA pantIyapIlAtAkhyAdhipe samarpayAmAsuH|</para>
  <para style="p">
    <verse number="3" style="v"/>tato yIshoH parakarevvarpayitA yihUdAstatprANAdaNDAj nAM viditvA santaptamanAH pradhAnayAjakalokaprAchInAnAM samakShaM tAstrIMshanmudrAH pratidAyAvAdIt,</para>
  <para style="p">
    <verse number="4" style="v"/>etannirAgonaraprANaparakarArpaNAt kaluShaM kR^itavAnahaM| tadA ta uditavantaH, tenAsmAkaM kiM? tvayA tad budhyatAm|</para>
  <para style="p">
    <verse number="5" style="v"/>tato yihUdA mandiramadhye tA mudrA nikShipya prasthitavAn itvA cha svayamAtmAnamudbabandha|</para>
  <para style="p">
    <verse number="6" style="v"/>pashchAt pradhAnayAjakAstA mudrA AdAya kathitavantaH, etA mudrAH shoNitamUlyaM tasmAd bhANDAgAre na nidhAtavyAH|</para>
  <para style="p">
    <verse number="7" style="v"/>anantaraM te mantrayitvA videshinAM shmashAnasthAnAya tAbhiH kulAlasya kShetramakrINan|</para>
  <para style="p">
    <verse number="8" style="v"/>ato.adyApi tatsthAnaM raktakShetraM vadanti|</para>
  <para style="p">
    <verse number="9" style="v"/>itthaM sati isrAyelIyasantAnai ryasya mUlyaM nirupitaM, tasya triMshanmudrAmAnaM mUlyaM</para>
  <para style="p">
    <verse number="10" style="v"/>mAM prati parameshvarasyAdeshAt tebhya AdIyata, tena cha kulAlasya kShetraM krItamiti yadvachanaM yirimiyabhaviShyadvAdinA proktaM tat tadAsidhyat|</para>
  <para style="p">
    <verse number="11" style="v"/>anantaraM yIshau tadadhipateH sammukha upatiShThati sa taM paprachCha, tvaM kiM yihUdIyAnAM rAjA? tadA yIshustamavadat, tvaM satyamuktavAn|</para>
  <para style="p">
    <verse number="12" style="v"/>kintu pradhAnayAjakaprAchInairabhiyuktena tena kimapi na pratyavAdi|</para>
  <para style="p">
    <verse number="13" style="v"/>tataH pIlAtena sa uditaH, ime tvatpratikUlataH kati kati sAkShyaM dadati, tat tvaM na shR^iNoShi?</para>
  <para style="p">
    <verse number="14" style="v"/>tathApi sa teShAmekasyApi vachasa uttaraM noditavAn; tena so.adhipati rmahAchitraM vidAmAsa|</para>
  <para style="p">
    <verse number="15" style="v"/>anyachcha tanmahakAle.adhipateretAdR^ishI rAtirAsIt, prajA yaM ka nchana bandhinaM yAchante, tameva sa mochayatIti|</para>
  <para style="p">
    <verse number="16" style="v"/>tadAnIM barabbAnAmA kashchit khyAtabandhyAsIt|</para>
  <para style="p">
    <verse number="17" style="v"/>tataH pIlAtastatra militAn lokAn apR^ichChat, eSha barabbA bandhI khrIShTavikhyAto yIshushchaitayoH kaM mochayiShyAmi? yuShmAkaM kimIpsitaM?</para>
  <para style="p">
    <verse number="18" style="v"/>tairIrShyayA sa samarpita iti sa j nAtavAn|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaM vichArAsanopaveshanakAle pIlAtasya patnI bhR^ityaM prahitya tasmai kathayAmAsa, taM dhArmmikamanujaM prati tvayA kimapi na karttavyaM; yasmAt tatkR^ite.adyAhaM svapne prabhUtakaShTamalabhe|</para>
  <para style="p">
    <verse number="20" style="v"/>anantaraM pradhAnayAjakaprAchInA barabbAM yAchitvAdAtuM yIshu ncha hantuM sakalalokAn prAvarttayan|</para>
  <para style="p">
    <verse number="21" style="v"/>tato.adhipatistAn pR^iShTavAn, etayoH kamahaM mochayiShyAmi? yuShmAkaM kechChA? te prochu rbarabbAM|</para>
  <para style="p">
    <verse number="22" style="v"/>tadA pIlAtaH paprachCha, tarhi yaM khrIShTaM vadanti, taM yIshuM kiM kariShyAmi? sarvve kathayAmAsuH, sa krushena vidhyatAM|</para>
  <para style="p">
    <verse number="23" style="v"/>tato.adhipatiravAdIt, kutaH? kiM tenAparAddhaM? kintu te punaruchai rjagaduH, sa krushena vidhyatAM|</para>
  <para style="p">
    <verse number="24" style="v"/>tadA nijavAkyamagrAhyamabhUt, kalahashchApyabhUt, pIlAta iti vilokya lokAnAM samakShaM toyamAdAya karau prakShAlyAvochat, etasya dhArmmikamanuShyasya shoNitapAte nirdoSho.ahaM, yuShmAbhireva tad budhyatAM|</para>
  <para style="p">
    <verse number="25" style="v"/>tadA sarvvAH prajAH pratyavochan, tasya shoNitapAtAparAdho.asmAkam asmatsantAnAnA nchopari bhavatu|</para>
  <para style="p">
    <verse number="26" style="v"/>tataH sa teShAM samIpe barabbAM mochayAmAsa yIshuntu kaShAbhirAhatya krushena vedhituM samarpayAmAsa|</para>
  <para style="p">
    <verse number="27" style="v"/>anantaram adhipateH senA adhipate rgR^ihaM yIshumAnIya tasya samIpe senAsamUhaM saMjagR^ihuH|</para>
  <para style="p">
    <verse number="28" style="v"/>tataste tasya vasanaM mochayitvA kR^iShNalohitavarNavasanaM paridhApayAmAsuH</para>
  <para style="p">
    <verse number="29" style="v"/>kaNTakAnAM mukuTaM nirmmAya tachChirasi daduH, tasya dakShiNakare vetramekaM dattvA tasya sammukhe jAnUni pAtayitvA, he yihUdIyAnAM rAjan, tubhyaM nama ityuktvA taM tirashchakruH,</para>
  <para style="p">
    <verse number="30" style="v"/>tatastasya gAtre niShThIvaM datvA tena vetreNa shira AjaghnuH|</para>
  <para style="p">
    <verse number="31" style="v"/>itthaM taM tiraskR^itya tad vasanaM mochayitvA punarnijavasanaM paridhApayA nchakruH, taM krushena vedhituM nItavantaH|</para>
  <para style="p">
    <verse number="32" style="v"/>pashchAtte bahirbhUya kurINIyaM shimonnAmakamekaM vilokya krushaM voDhuM tamAdadire|</para>
  <para style="p">
    <verse number="33" style="v"/>anantaraM gulgaltAm arthAt shiraskapAlanAmakasthAnamu pasthAya te yIshave pittamishritAmlarasaM pAtuM daduH,</para>
  <para style="p">
    <verse number="34" style="v"/>kintu sa tamAsvAdya na papau|</para>
  <para style="p">
    <verse number="35" style="v"/>tadAnIM te taM krushena saMvidhya tasya vasanAni guTikApAtena vibhajya jagR^ihuH, tasmAt, vibhajante.adharIyaM me te manuShyAH parasparaM| maduttarIyavastrArthaM guTikAM pAtayanti cha||yadetadvachanaM bhaviShyadvAdibhiruktamAsIt, tadA tad asidhyat,</para>
  <para style="p">
    <verse number="36" style="v"/>pashchAt te tatropavishya tadrakShaNakarvvaNi niyuktAstasthuH|</para>
  <para style="p">
    <verse number="37" style="v"/>aparam eSha yihUdIyAnAM rAjA yIshurityapavAdalipipatraM tachChirasa Urdvve yojayAmAsuH|</para>
  <para style="p">
    <verse number="38" style="v"/>tatastasya vAme dakShiNe cha dvau chairau tena sAkaM krushena vividhuH|</para>
  <para style="p">
    <verse number="39" style="v"/>tadA pAnthA nijashiro lADayitvA taM nindanto jagaduH,</para>
  <para style="p">
    <verse number="40" style="v"/>he Ishvaramandirabha njaka dinatraye tannirmmAtaH svaM rakSha, chettvamIshvarasutastarhi krushAdavaroha|</para>
  <para style="p">
    <verse number="41" style="v"/>pradhAnayAjakAdhyApakaprAchInAshcha tathA tiraskR^itya jagaduH,</para>
  <para style="p">
    <verse number="42" style="v"/>so.anyajanAnAvat, kintu svamavituM na shaknoti| yadIsrAyelo rAjA bhavet, tarhIdAnImeva krushAdavarohatu, tena taM vayaM pratyeShyAmaH|</para>
  <para style="p">
    <verse number="43" style="v"/>sa Ishvare pratyAshAmakarot, yadIshvarastasmin santuShTastarhIdAnImeva tamavet, yataH sa uktavAn ahamIshvarasutaH|</para>
  <para style="p">
    <verse number="44" style="v"/>yau stenau sAkaM tena krushena viddhau tau tadvadeva taM ninindatuH|</para>
  <para style="p">
    <verse number="45" style="v"/>tadA dvitIyayAmAt tR^itIyayAmaM yAvat sarvvadeshe tamiraM babhUva,</para>
  <para style="p">
    <verse number="46" style="v"/>tR^itIyayAme "elI elI lAmA shivaktanI", arthAt madIshvara madIshvara kuto mAmatyAkShIH? yIshuruchchairiti jagAda|</para>
  <para style="p">
    <verse number="47" style="v"/>tadA tatra sthitAH kechit tat shrutvA babhAShire, ayam eliyamAhUyati|</para>
  <para style="p">
    <verse number="48" style="v"/>teShAM madhyAd ekaH shIghraM gatvA spa njaM gR^ihItvA tatrAmlarasaM dattvA nalena pAtuM tasmai dadau|</para>
  <para style="p">
    <verse number="49" style="v"/>itare.akathayan tiShThata, taM rakShitum eliya AyAti naveti pashyAmaH|</para>
  <para style="p">
    <verse number="50" style="v"/>yIshuH punaruchairAhUya prANAn jahau|</para>
  <para style="p">
    <verse number="51" style="v"/>tato mandirasya vichChedavasanam UrdvvAdadho yAvat ChidyamAnaM dvidhAbhavat,</para>
  <para style="p">
    <verse number="52" style="v"/>bhUmishchakampe bhUdharovyadIryyata cha| shmashAne mukte bhUripuNyavatAM suptadehA udatiShThan,</para>
  <para style="p">
    <verse number="53" style="v"/>shmashAnAd vahirbhUya tadutthAnAt paraM puNyapuraM gatvA bahujanAn darshayAmAsuH|</para>
  <para style="p">
    <verse number="54" style="v"/>yIshurakShaNAya niyuktaH shatasenApatistatsa Nginashcha tAdR^ishIM bhUkampAdighaTanAM dR^iShTvA bhItA avadan, eSha Ishvaraputro bhavati|</para>
  <para style="p">
    <verse number="55" style="v"/>yA bahuyoShito yIshuM sevamAnA gAlIlastatpashchAdAgatAstAsAM madhye</para>
  <para style="p">
    <verse number="56" style="v"/>magdalInI mariyam yAkUbyoshyo rmAtA yA mariyam sibadiyaputrayo rmAtA cha yoShita etA dUre tiShThantyo dadR^ishuH|</para>
  <para style="p">
    <verse number="57" style="v"/>sandhyAyAM satyam arimathiyAnagarasya yUShaphnAmA dhanI manujo yIshoH shiShyatvAt</para>
  <para style="p">
    <verse number="58" style="v"/>pIlAtasya samIpaM gatvA yIshoH kAyaM yayAche, tena pIlAtaH kAyaM dAtum Adidesha|</para>
  <para style="p">
    <verse number="59" style="v"/>yUShaph tatkAyaM nItvA shuchivastreNAchChAdya</para>
  <para style="p">
    <verse number="60" style="v"/>svArthaM shaile yat shmashAnaM chakhAna, tanmadhye tatkAyaM nidhAya tasya dvAri vR^ihatpAShANaM dadau|</para>
  <para style="p">
    <verse number="61" style="v"/>kintu magdalInI mariyam anyamariyam ete striyau tatra shmashAnasammukha upavivishatuH|</para>
  <para style="p">
    <verse number="62" style="v"/>tadanantaraM nistArotsavasyAyojanadinAt pare.ahani pradhAnayAjakAH phirUshinashcha militvA pIlAtamupAgatyAkathayan,</para>
  <para style="p">
    <verse number="63" style="v"/>he mahechCha sa pratArako jIvana akathayat, dinatrayAt paraM shmashAnAdutthAsyAmi tadvAkyaM smarAmo vayaM;</para>
  <para style="p">
    <verse number="64" style="v"/>tasmAt tR^itIyadinaM yAvat tat shmashAnaM rakShitumAdishatu, nochet tachChiShyA yAminyAmAgatya taM hR^itvA lokAn vadiShyanti, sa shmashAnAdudatiShThat, tathA sati prathamabhrAnteH sheShIyabhrAnti rmahatI bhaviShyati|</para>
  <para style="p">
    <verse number="65" style="v"/>tadA pIlAta avAdIt, yuShmAkaM samIpe rakShigaNa Aste, yUyaM gatvA yathA sAdhyaM rakShayata|</para>
  <para style="p">
    <verse number="66" style="v"/>tataste gatvA taddUाrapAShANaM mudrA NkitaM kR^itvA rakShigaNaM niyojya shmashAnaM rakShayAmAsuH|</para>
  <chapter number="28" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataH paraM vishrAmavArasya sheShe saptAhaprathamadinasya prabhote jAte magdalInI mariyam anyamariyam cha shmashAnaM draShTumAgatA|</para>
  <para style="p">
    <verse number="2" style="v"/>tadA mahAn bhUkampo.abhavat; parameshvarIyadUtaH svargAdavaruhya shmashAnadvArAt pAShANamapasAryya taduparyyupavivesha|</para>
  <para style="p">
    <verse number="3" style="v"/>tadvadanaM vidyudvat tejomayaM vasanaM himashubhra ncha|</para>
  <para style="p">
    <verse number="4" style="v"/>tadAnIM rakShiNastadbhayAt kampitA mR^itavad babhUvaH|</para>
  <para style="p">
    <verse number="5" style="v"/>sa dUto yoShito jagAda, yUyaM mA bhaiShTa, krushahatayIshuM mR^igayadhve tadahaM vedmi|</para>
  <para style="p">
    <verse number="6" style="v"/>so.atra nAsti, yathAvadat tathotthitavAn; etat prabhoH shayanasthAnaM pashyata|</para>
  <para style="p">
    <verse number="7" style="v"/>tUrNaM gatvA tachChiShyAn iti vadata, sa shmashAnAd udatiShThat, yuShmAkamagre gAlIlaM yAsyati yUyaM tatra taM vIkShiShyadhve, pashyatAhaM vArttAmimAM yuShmAnavAdiShaM|</para>
  <para style="p">
    <verse number="8" style="v"/>tatastA bhayAt mahAnandA ncha shmashAnAt tUrNaM bahirbhUya tachChiShyAn vArttAM vaktuM dhAvitavatyaH| kintu shiShyAn vArttAM vaktuM yAnti, tadA yIshu rdarshanaM dattvA tA jagAda,</para>
  <para style="p">
    <verse number="9" style="v"/>yuShmAkaM kalyANaM bhUyAt, tatastA Agatya tatpAdayoH patitvA praNemuH|</para>
  <para style="p">
    <verse number="10" style="v"/>yIshustA avAdIt, mA bibhIta, yUyaM gatvA mama bhrAtR^in gAlIlaM yAtuM vadata, tatra te mAM drakShyanti|</para>
  <para style="p">
    <verse number="11" style="v"/>striyo gachChanti, tadA rakShiNAM kechit puraM gatvA yadyad ghaTitaM tatsarvvaM pradhAnayAjakAn j nApitavantaH|</para>
  <para style="p">
    <verse number="12" style="v"/>te prAchInaiH samaM saMsadaM kR^itvA mantrayanto bahumudrAH senAbhyo dattvAvadan,</para>
  <para style="p">
    <verse number="13" style="v"/>asmAsu nidriteShu tachChiShyA yAminyAmAgatya taM hR^itvAnayan, iti yUyaM prachArayata|</para>
  <para style="p">
    <verse number="14" style="v"/>yadyetadadhipateH shrotragocharIbhavet, tarhi taM bodhayitvA yuShmAnaviShyAmaH|</para>
  <para style="p">
    <verse number="15" style="v"/>tataste mudrA gR^ihItvA shikShAnurUpaM karmma chakruH, yihUdIyAnAM madhye tasyAdyApi kiMvadantI vidyate|</para>
  <para style="p">
    <verse number="16" style="v"/>ekAdasha shiShyA yIshunirUpitAgAlIlasyAdriM gatvA</para>
  <para style="p">
    <verse number="17" style="v"/>tatra taM saMvIkShya praNemuH, kintu kechit sandigdhavantaH|</para>
  <para style="p">
    <verse number="18" style="v"/>yIshusteShAM samIpamAgatya vyAhR^itavAn, svargamedinyoH sarvvAdhipatitvabhAro mayyarpita Aste|</para>
  <para style="p">
    <verse number="19" style="v"/>ato yUyaM prayAya sarvvadeshIyAn shiShyAn kR^itvA pituH putrasya pavitrasyAtmanashcha nAmnA tAnavagAhayata; ahaM yuShmAn yadyadAdishaM tadapi pAlayituM tAnupAdishata|</para>
  <para style="p">
    <verse number="20" style="v"/>pashyata, jagadantaM yAvat sadAhaM yuShmAbhiH sAkaM tiShThAmi| iti|</para>
</usx>
