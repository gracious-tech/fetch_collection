  <book code="JAS" style="id">EN_PCLT pac_Pacoh_ltr Thu Apr 09 2026 09:33:13 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">James</para>
  <para style="toc1">Chớiq A-lang Ya-cơ</para>
  <para style="toc2">Ya-cơ</para>
  <para style="toc3">Jas</para>
  <para style="mt">Ya-cơ</para>
  <chapter number="1" style="c" sid="JAS 1" />
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1" />Ya-cơ, ndon táq ar-náq na Yang Arbang Pilŏ́ng a-lứng na Yang Choi ta-mống Yê-su, cơiq chớiq ndô dyôn mu chít la bar top tŏ́ng toiq ndon át par-sáng par-saiq: Dŏq car-bánh i-nha.<verse eid="JAS 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2" />Ơi máh em ai na cư, ndóng i-nha tu-múh cứp nốh diêiq a-rức, cóq me ngki la callong bui clưi clưai, <verse eid="JAS 1:2" /><verse number="3" style="v" sid="JAS 1:3" />co chom dyơ tớq dŏq chim callong tin i-nha callong diêiq a-rức ndô rap chiuq ta-nhir ma lớiq. <verse eid="JAS 1:3" /><verse number="4" style="v" sid="JAS 1:4" />Ma, tớq i-nha chiuq diêiq a-rức cóq i-nha táq a-páh nhéq mui callong ŏ, dŏq i-nha bôn cơt khớm lư a-lứng dyơ nhéq, lớiq bôn ớq mui nốh a-mớh.<verse eid="JAS 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 1:5" />Ma khán nnáu te i-nha ớq bôn callong tu-báiq, ti-cuôi ngki cóq cớu seq te Yang Arbang Pilŏ́ng, Án lư dyôn nốh án seq dyôn cứp náq ti-cuôi ma lớiq bôn pi-ốh, iki callong tu-báiq ngki lư án dyôn ada ti-cuôi ngki. <verse eid="JAS 1:5" /><verse number="6" style="v" sid="JAS 1:6" />Ma ti-cuôi ngki cóq cớu seq tớq callong tin, lớiq par-ngíh a-mớh, co ti-cuôi ndon par-ngíh la a-rớq dơq ving ca-vang, táq tu-dô tu-ki a-lứng cal-chớq cu-yiêl phớt. <verse eid="JAS 1:6" /><verse number="7" style="v" sid="JAS 1:7" />Ti-cuôi a-rớq ngki lớiq têq ng-cong a-mớh án bôn ráp a-mớh te Yang, <verse eid="JAS 1:7" /><verse number="8" style="v" sid="JAS 1:8" />ndon la ti-cuôi lớiq bôn vứng, lớiq nhéq mít tớq máh ar-náq án táq.<verse eid="JAS 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9" />Ti-cuôi em ai yôl bôn ki-dit cóq bui ơn, co nha-án cơt pưt tưi chứng mát Yang na án, <verse eid="JAS 1:9" /><verse number="10" style="v" sid="JAS 1:10" />ma ti-cuôi súc cóq cu-hống te nốh lớiq têq táq na án, co ti-cuôi ngki chái tháng a-ngom a-rớq piêr sác tớq tiah. <verse eid="JAS 1:10" /><verse number="11" style="v" sid="JAS 1:11" />Mát pan-dang ngốh a-lứng claq tháng a-tóq nha cơt preng nhéq piêr sác, piêr ngki a-tôh nhéq, tôm piêr ŏ na án cơt cloiq a-líq. Mu chứng ngki, ti-cuôi súc la cơt preng ndon te máh nốh dŏq tar veng na nha-án.<verse eid="JAS 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12" />Bún dyôn ti-cuôi chiuq diêiq a-rức. Co, vít án chiuq ta-nhir, án bôn cống callong tu-mống la callong ndon Yang Arbang Pilŏ́ng khoiq ưq dyôn ti-cuôi mmo a-moih Án. <verse eid="JAS 1:12" /><verse number="13" style="v" sid="JAS 1:13" />Tư táq ar-náq luaih, án lớiq têq tông idô: “Cư co Yang Arbang Pilŏ́ng tar-dông táq luaih,” co Yang Arbang Pilŏ́ng la lớiq nai táq luaih, ma lư Án lớiq nai tar-dông táq luaih ti-cuôi mmo. <verse eid="JAS 1:13" /><verse number="14" style="v" sid="JAS 1:14" />Ma cứp náq ti-cuôi táq luaih, tar-dông a-lứng táq ar-náq luaih co mít can-nính báq ham te cháq bôm. <verse eid="JAS 1:14" /><verse number="15" style="v" sid="JAS 1:15" />Dyơ ngki, khán callong saq át tớq mít can-nính ti-cuôi, mít can-nính báq ham táq ar-náq luaih, ma khán callong saq pưt a-sớr ar-náq luaih táq cơt cu-chet.<verse eid="JAS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16" />Ơi em ai a-moih na cư, êq dyôn i-nha dŏq clúq cháq i-nha bôm. <verse eid="JAS 1:16" /><verse number="17" style="v" sid="JAS 1:17" />Cứp nốh bôn ŏ nha cứp nốh án dyôn lớiq têq tíq bôn te pilŏ́ng, la tớq te A-ám bôn callong ang, ma co te Án lớiq bôn táh a-tức lớiq la cơt tar-piên. <verse eid="JAS 1:17" /><verse number="18" style="v" sid="JAS 1:18" />A-rớq án khoiq rêh, Án khoiq ca-nian top he ngốh te par-nai piaiq, dŏq top he la mui top cu-lái mbơiq cơt cứp nốh án khoiq teng te Án.<verse eid="JAS 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19" />Ơi em ai ndon cư a-moih na cư, co i-nha chom: Cứp náq i-nha cóq chái cam-máng, i-láq taq-ntêr, êq chái nháih. <verse eid="JAS 1:19" /><verse number="20" style="v" sid="JAS 1:20" />Co callong nháih na i-nha lớiq têq cơt ti-nớng ŏ na Yang Arbang Pilŏ́ng. <verse eid="JAS 1:20" /><verse number="21" style="v" sid="JAS 1:21" />Co iki, tư dyơ luaiq táh cứp nốh lớiq práh a-lứng a-ưi callong saq, cóq i-nha ráp ial tớq mít can-nính par-nai án khoiq chóh, la par-nai bôn choi ta-mống ar-vai i-nha.<verse eid="JAS 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22" />Cóq cơt máh ti-cuôi veng crái piaiq êq nưm bôn sáng sớng ma clúq cháq bôm. <verse eid="JAS 1:22" /><verse number="23" style="v" sid="JAS 1:23" />Co khán ti-cuôi mmo la ti-cuôi cam-máng par-nai ma lớiq táq veng, ti-cuôi ngki a-rớq mu náq clớng tallớng mát ma án clớiq táp tớq tallớng. <verse eid="JAS 1:23" /><verse number="24" style="v" sid="JAS 1:24" />Ti-cuôi ngki khoiq clớng cháq án dyơ táh, iki chái lư clớiq rớp án táp. <verse eid="JAS 1:24" /><verse number="25" style="v" sid="JAS 1:25" />Ma ti-cuôi mmo ráp ial tớq phep rit pa-táp co par-nai ngki têq ta-láh, a-lứng táq iki níc, lớiq bôn cơt ti-cuôi cam-máng ma clớiq táp, la ti-cuôi ndon táq veng liêh ar-náq án táq, ti-cuôi ngki bôn callong bún tớq ar-náq án táq.<verse eid="JAS 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26" />Khán nnáu par-ngíh án la veng ngê piaiq ma lớiq chom bán ŏ ntaq bôm, ma át pi-lốh mít bôm, ki veng ngê piaiq na ti-cuôi ngki ớq bôn tar-náp a-mớh. <verse eid="JAS 1:26" /><verse number="27" style="v" sid="JAS 1:27" />Veng ngê Yang práh ŏ a-lứng lớiq têq tíq chứng mát Yang Arbang Pilŏ́ng, A-ám top he, ngki la tar-choi a-cái cu-muiq cán cám mai te callong diêiq a-rức na nha-án bán ŏ cháq bôm viar te callong saq tớq pang ndô.<verse eid="JAS 1:27" /></para>
  <chapter eid="JAS 1" />
  <chapter number="2" style="c" sid="JAS 2" />
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1" />Ơi em ai na cư, cóq i-nha ial callong tin te Yang top he, Yang Choi Ta-mống Yê-su khoiq a-páh, a-lứng i-nha êq táq ndái. <verse eid="JAS 2:1" /><verse number="2" style="v" sid="JAS 2:2" />Co a-cám tông mu náq ti-cuôi ta-miat tam-miat dyeng a-lứng tớc tám pớc a-maiq ŏ mot tớq dúng rum na i-nha, ma mu náq ti-cuôi ki-dit a-lứng tớc tám pớc a-nhoh la mot tưi, <verse eid="JAS 2:2" /><verse number="3" style="v" sid="JAS 2:3" />ma i-nha dyám náp tớq ti-cuôi tớc tám pớc a-maiq ŏ a-lứng tông: “Seq mái ti-cu tớq ntúq ŏ ndô,” a-lứng ti-cuôi ndon ki-dit, i-nha tông: “Mái ta-yứng tớq ngki,” lớiq la “Mái ti-cu tớq a-dyưng cư,” <verse eid="JAS 2:3" /><verse number="4" style="v" sid="JAS 2:4" />iki khán i-nha táq ndái te top i-nha ada ti-cuôi ndô a-lứng cơt ti-cuôi báq tíq a-lứng par-ngíh lớiq ŏ? <verse eid="JAS 2:4" /><verse number="5" style="v" sid="JAS 2:5" />Ơi em ai ndon cư a-moih na cư, cóq i-nha cam-máng: Com lư Yang Arbang Pilŏ́ng dŏq rêh ti-cuôi ki-dit tớq pang ndô ti-cuôi súc bôn tớq callong tin a-lứng ti-cuôi ưlla tưi cruông ang ưr ndon Án khoiq par-ưq ada ti-cuôi mmo a-moih Án? <verse eid="JAS 2:5" /><verse number="6" style="v" sid="JAS 2:6" />Iki ma i-nha táq a-chiêt ti-cuôi ki-dit! Lư ti-cuôi ndon súc báq táq diêiq a-rức i-nha a-lứng nha-án dông i-nha nga ngai tar-sưq? <verse eid="JAS 2:6" /><verse number="7" style="v" sid="JAS 2:7" />Lư nha-án báq a-craiq nốh ndon i-nha dyám náp khoiq át tớq cháq i-nha?<verse eid="JAS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8" />Iki, khán i-nha peh phep rit na Puô a-rớq Tám U-ráq Yang: “Cóq a-moih ti-cuôi pa-niar i-nha a-rớq i-nha a-moih cháq bôm”, iki i-nha lư táq piaiq. <verse eid="JAS 2:8" /><verse number="9" style="v" sid="JAS 2:9" />Ma khán i-nha táq ndái, i-nha lư táq luaih, co i-nha lớiq peh phep rit pa-táp a-rớq i-nha táh callong án pa-táp. <verse eid="JAS 2:9" /><verse number="10" style="v" sid="JAS 2:10" />Co ti-cuôi mmo ráp peh máh phep rit, ma táq luaih tớq callong mmo, ti-cuôi ngki cơt táh nhéq máh callong pa-táp. <verse eid="JAS 2:10" /><verse number="11" style="v" sid="JAS 2:11" />Co Yang Arbang Pilŏ́ng khoiq pa-táp: “Êq láh par-lưi,” nha án pa-táp sa: “Êq ca-chet ti-cuôi.” Ma khán i-nha lớiq láh par-lưi, ma ca-chet ti-cuôi, iki i-nha cơt luaih táh callong án pa-táp. <verse eid="JAS 2:11" /><verse number="12" style="v" sid="JAS 2:12" />Iki cóq tông a-lứng táq tam máh ti-cuôi peh lớiq la lớiq peh co án khoiq pa-táp callong ngki dŏq ta-láh ti-cuôi. <verse eid="JAS 2:12" /><verse number="13" style="v" sid="JAS 2:13" />Co callong tar-sưq lớiq srui-táq ti-cuôi ndon lớiq a-páh mít srui-táq. Mít srui-táq pưt clưi te callong ndon tar-sưq!<verse eid="JAS 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14" />Ơi em ai na cư, bôn tar-náp a-mớh khán ti-cuôi mmo tông án bôn callong tin ma ớq bôn ar-náq táq? Callong tin ngki lớiq têq choi ta-mống ti-cuôi ngki, <verse eid="JAS 2:14" /><verse number="15" style="v" sid="JAS 2:15" />cư a-cám idô mu náq te i-nha lớiq la em ai ndon ớq tam-pớc tớc a-lứng ớq tan-na cha cứp i-ngái, <verse eid="JAS 2:15" /><verse number="16" style="v" sid="JAS 2:16" />ma bôn mu náq te i-nha tông ada nha-án: “Mái chô dyôn iên ŏ nư, cóq mái át dyôn ŏ a-lứng cha dyôn sái,” ma i-nha lớiq choi nha-án máh nốh bôn tớc khám cha, iki callong tin lớiq bôn tar-náp a-mớh? <verse eid="JAS 2:16" /><verse number="17" style="v" sid="JAS 2:17" />Callong tin mu chứng ngki tưi, khán lớiq bôn ar-náq táq án tin lô mat sớng.<verse eid="JAS 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18" />Dyơ ngki, bôn ti-cuôi te i-nha tông idô: “Mái bôn callong tin, ma cư bôn ar-náq táq.” Mái a-páh dyôn cư hôm callong tin ma ớq ar-náq táq na mái, dyơ cư dyôn mái hôm callong tin te ar-náq táq na cư. <verse eid="JAS 2:18" /><verse number="19" style="v" sid="JAS 2:19" />Mái tin dyơ Yang Arbang Pilŏ́ng la lư Yang sút. Mái tin crái piaiq. Yang saq la mu chứng tin tưi a-lứng nha-án yôl a-dáh. <verse eid="JAS 2:19" /><verse number="20" style="v" sid="JAS 2:20" />Ndô ti-cuôi a-chơ, mái ính chom lớiq bôn callong tin ma lớiq bôn ar-náq táq la lớiq tar-náp a-mớh? <verse eid="JAS 2:20" /><verse number="21" style="v" sid="JAS 2:21" />Lư A-pra-ham, a-chúc a-chiac top he, án la ti-cuôi ti-nớng ŏ te ar-náq án táq án mŏp I-sac, a-cái conh án, tớq pa-rông sang? <verse eid="JAS 2:21" /><verse number="22" style="v" sid="JAS 2:22" />Mái hôm dyơ callong tin pôq mu nơi a-lớng ar-náq táq na án, a-lứng nhơ ar-náq táq, callong tin cơt ar-lớih ar-lêng. <verse eid="JAS 2:22" /><verse number="23" style="v" sid="JAS 2:23" />Par-nai Tám U-ráq Yang ndô khoiq tông te i-nớh, idô: “A-pra-ham tin Yang Arbang Pilŏ́ng, callong ngki la ti-nớng ŏ dyôn án,” a-lứng ngai dŏq án la yớu na Yang Arbang Pilŏ́ng. <verse eid="JAS 2:23" /><verse number="24" style="v" sid="JAS 2:24" />I-nha khoiq hôm callong ngki, mu náq ti-cuôi ti-nớng ŏ te ar-náq án táq a-lứng lớiq nưm te callong tin sớng. <verse eid="JAS 2:24" /><verse number="25" style="v" sid="JAS 2:25" />Mu chứng ngki tưi, bôn mu náq cán nốh Ra-hap án ti-cuôi ti-nớng ŏ te ar-náq án táq te nsuôi án táiq cháq a-lứng dông nha-án pôq na car-na can-nŏ́h loi? <verse eid="JAS 2:25" /><verse number="26" style="v" sid="JAS 2:26" />Co ti-cuôi bôn cháq ma ớq ar-vai iki lớiq têq tu-mống, callong tin ma ớq ar-náq táq iki mu chứng cu-chet ngki tưi.<verse eid="JAS 2:26" /></para>
  <chapter eid="JAS 2" />
  <chapter number="3" style="c" sid="JAS 3" />
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1" />Ơi em ai na cư, lớiq bôn a-ưi ti-cuôi táq thới, khán he lớiq táq veng dyơ top he lư ráp tôt ntáng hơn. <verse eid="JAS 3:1" /><verse number="2" style="v" sid="JAS 3:2" />Co top he táq luaih a-ưi. Khán ti-cuôi mmo lớiq táq luaih tớq par-nai taq-ntêr, ngki la ti-cuôi ti-nớng ŏ, co ti-cuôi ngki rap bán ŏ nhéq cháq bôm. <verse eid="JAS 3:2" /><verse number="3" style="v" sid="JAS 3:3" />Khán top he ính ca-cháq nhem tớq ng-cang a-séh dŏq dyôn a-séh ính veng top he, iki top he têq dông a-séh nhéq máh na he. <verse eid="JAS 3:3" /><verse number="4" style="v" sid="JAS 3:4" />Mu chứng cóq me máh tuôc pưt lư a-lứng bôn cu-yiêl clúh hớp, ma cứp allám tuôc ính pôq tu-mo co bôn pil par-vih lư két dŏq tớq ntúq ndon ma co ti-cuôi a-vih tuôc ính. <verse eid="JAS 3:4" /><verse number="5" style="v" sid="JAS 3:5" />Mu chứng a-rớq ngki, ntaq la tháng két ma têq án a-sớr cháq máh ar-náq pưt. I-nha me bôn mui lám cúc car-hông két ma têq táq ng-cat tiah pưt. <verse eid="JAS 3:5" /><verse number="6" style="v" sid="JAS 3:6" />Ntaq la mu chứng a-rớq pallô uih, tớq pang ndô a-ưi táq luaih. Ntaq dŏq át tớq cháq top he, táq saq nhéq tớq cháq a-lứng táq rúng díh pang ndô, ma to án têq táq ng-cat cơt uih chéh. <verse eid="JAS 3:6" /><verse number="7" style="v" sid="JAS 3:7" />Cứp nốh pan-nán a-lứng a-chếq, cu-sánh a-lứng cứp nốh át tớq dơq ving ca-vang co ti-cuôi khoiq bán a-lứng khoiq cứp náq ti-cuôi khoiq bán. <verse eid="JAS 3:7" /><verse number="8" style="v" sid="JAS 3:8" />Ma lớiq nnáu rap bán ntaq bôm, ntaq báq taq-ntêr níc par-nai saq, iki ntaq he la a-rớq pih cu-sánh têq ca-chet máh ti-cuôi. <verse eid="JAS 3:8" /><verse number="9" style="v" sid="JAS 3:9" />A-lứng co ntaq, top he báq cứh ayô Yang a-lứng A-ám, mu chứng co bôn ntaq, top he báq a-craiq ti-cuôi hơ, co án khoiq teng ti-cuôi a-rớq mu chứng na Yang Arbang Pilŏ́ng. <verse eid="JAS 3:9" /><verse number="10" style="v" sid="JAS 3:10" />Callong ayô nha callong a-craiq ngốh te mui hóng ng-cang. Ơi em ai na cư, máh ar-náq ngki lớiq crái táq iki. <verse eid="JAS 3:10" /><verse number="11" style="v" sid="JAS 3:11" />Bôn mui par-lôiq a-bóc dơq tớq te búl ma bôn dơq ngốh iam a-lứng bôn dơq ndon lớiq iam. <verse eid="JAS 3:11" /><verse number="12" style="v" sid="JAS 3:12" />Ơi em ai na cư, a-long ta-rúng lớiq têq cơt cu-lái ô-li-vê, lớiq la a-long nho ngốh cu-lái ta-rúng? Dơq lớiq iam lớiq têq ngốh dơq iam.<verse eid="JAS 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13" />Ti-cuôi mmo tu-báiq a-lứng chom te top i-nha? Ti-cuôi ngki cóq a-páh ar-náq án táq na án co ti-cuôi ngki át khun táq ar-náq ŏ ma án lớiq ính ngai ayô án ti-cuôi can-nŏ́h chom án lư tu-báiq. <verse eid="JAS 3:13" /><verse number="14" style="v" sid="JAS 3:14" />Ma khán i-nha mu náq i-ôiq na mu náq lớiq la mu náq ính pưt hơn te mu náq a-lứng ính bôn tớq mít can-nính bôm, êq par-ngíh i-nha la tu-báiq a-lứng i-nha tông pi-con ada callong lư. <verse eid="JAS 3:14" /><verse number="15" style="v" sid="JAS 3:15" />Ndô lớiq bôn la callong tu-báiq siar te pilŏ́ng, ma tớq te pang ndô, a-lứng te, yang saq. <verse eid="JAS 3:15" /><verse number="16" style="v" sid="JAS 3:16" />Co callong i-ôiq ca-míq a-lứng ính bôn niêng ta-niêng tớq mmo, ngki callong tar-luaih a-lứng cứp ar-náq saq át tớq ngki. <verse eid="JAS 3:16" /><verse number="17" style="v" sid="JAS 3:17" />Vít ngki, callong tu-báiq tớq te pilŏ́ng nsuôi lư la cóq práh ŏ, dyơ ngki lớiq táq luaih yớu, bôn mít khun, ial mít can-nính yớu, bôn mít a-moih ti-cuôi can-nŏ́h a-lứng táq ar-náq ŏ níc, lớiq bôn bar mít, lớiq taq-ntêr a-uai. <verse eid="JAS 3:17" /><verse number="18" style="v" sid="JAS 3:18" />Te callong ti-nớng ŏ ngki nhéq náq bôn át iên ŏ co máh ti-cuôi mu náq át ŏ ada mu náq.<verse eid="JAS 3:18" /></para>
  <chapter eid="JAS 3" />
  <chapter number="4" style="c" sid="JAS 4" />
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1" />Máh callong tar-luaih tớq te mmo a-lứng mu náq táq mu náq tớq te i-nha? Bôn ti-cuôi táq iki co i-nha báq bôn mít can-nính ham te i-nha, la ar-náq yôl tar-luaih te máh na i-nha? <verse eid="JAS 4:1" /><verse number="2" style="v" sid="JAS 4:2" />I-nha sáng ính bôn ma lớiq têq bôn, i-nha ca-chet ti-cuôi. I-nha i-ôiq ca-míq, ma lớiq hôi bôn, i-nha tar-luaih a-lứng car-chet. I-nha ớq bôn co i-nha lớiq seq. <verse eid="JAS 4:2" /><verse number="3" style="v" sid="JAS 4:3" />I-nha seq ma lớiq têq bôn co i-nha seq lớiq piaiq, ngki i-nha lớiq bôn tưi cóq seq máh callong ham tớq mít na i-nha. <verse eid="JAS 4:3" /><verse number="4" style="v" sid="JAS 4:4" />Máh ti-cuôi ndon láh par-lưi ngki! I-nha lớiq chom dyơ ti-cuôi mmo ính veng ngê tớq pang ndô la án lớiq ính veng nnáng ngê Yang Arbang Pilŏ́ng? Dyơ ngki, khán nnáu ính cơt yớu tớq pang ndô, ti-cuôi ngki lớiq ính veng ngê Yang Arbang Pilŏ́ng. <verse eid="JAS 4:4" /><verse number="5" style="v" sid="JAS 4:5" />A-láng i-nha par-ngíh ngki Tám U-ráq Yang tông lớiq cơt tar-náp: “Ar-vai ndon Án dyôn tu-mống tớq top he, Yang Ar-vai a-moih he ti-ngôi án a-ính liêh”? <verse eid="JAS 4:5" /><verse number="6" style="v" sid="JAS 4:6" />Ma, Án dyôn callong choi mat a-ưi lư, dyơ Tám U-ráq Yang tông idô: “Yang Arbang Pilŏ́ng ính chíl ti-cuôi ndon pu-pưt, ma Án dyôn callong choi mat ada ti-cuôi ndon a-siar cháq.” <verse eid="JAS 4:6" /><verse number="7" style="v" sid="JAS 4:7" />Co iki, cóq cam-máng Yang Arbang Pilŏ́ng. Ma cóq chíl yang sáq, dyơ yang sáq viar yông te i-nha. <verse eid="JAS 4:7" /><verse number="8" style="v" sid="JAS 4:8" />Cóq át tar-mán Yang Arbang Pilŏ́ng, a-lứng Án lư át tar-mán i-nha. Máh ti-cuôi ndon táq luaih, cóq ngin kho te ar-náq án táq, ti-cuôi mmo bôn bar mít, cóq án táh mui mít. <verse eid="JAS 4:8" /><verse number="9" style="v" sid="JAS 4:9" />Cóq ngin luaih, nhiêm cu-cloiq nha cu-cling! Cóq piên siêng car-cháng na i-nha cơt siêng nhiêm, a-lứng piên bui ŏ dyơ cơt a-nguaq la-bang. <verse eid="JAS 4:9" /><verse number="10" style="v" sid="JAS 4:10" />Cóq i-nha a-siar cháq chứng mát Yang, dyơ Án a-sớr i-nha dyôn ngai dyám náp.<verse eid="JAS 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11" />Em ai ơi, êq tông lớiq ŏ tar-tuôq. Ti-cuôi tông lớiq ŏ i-nha a-láng tíq em ai i-nha la tông lớiq ŏ phep rit a-lứng tíq phep rit. Ma khán mái tíq phep rit ngki mái tới la ti-cuôi táq veng phep rit, ma la ti-cuôi sưq phep rit. <verse eid="JAS 4:11" /><verse number="12" style="v" sid="JAS 4:12" />Yang Arbang Pilŏ́ng táp teng phep rit a-lứng têq tíq la nưm án táp, la Yang Arbang Pilŏ́ng têq choi ti-cuôi a-lứng têq ca-chet. Ma mái la nnáu, ndon ớq chức têq tíq ti-cuôi pa-niar mái?<verse eid="JAS 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13" />Hoi ngki, i-nha cam-máng ndô, máh ti-cuôi taq-ntêr idô: “I-ngái ndô tơ la i-ngái par-nô top he pôq nga vel tu-tíh, dyơ he táq ar-náq tớq ngki mui cu-mo, táiq plới a-lứng bôn práq a-ưi.” <verse eid="JAS 4:13" /><verse number="14" style="v" sid="JAS 4:14" />Máh ti-cuôi lớiq chom a-mớh tớq i-ngái par-nô, tar-ngứh tu-mống na i-nha la ớq a-mớh? Co i-nha la a-rớq dơq dŏq tớq mu hoi sớng dyơ taiq nhéq. <verse eid="JAS 4:14" /><verse number="15" style="v" sid="JAS 4:15" />Vít ngki, i-nha cóq tông idô: “Khán Yang dyôn, iki top he bôn tu-mống a-lứng dŏq táq ar-náq ndô lớiq la ar-náq ngki.” <verse eid="JAS 4:15" /><verse number="16" style="v" sid="JAS 4:16" />Ma, i-nha hoi ndô lư taq-ntêr a-sớr cháq na i-nha. Cứp ar-náq i-nha taq-ntêr a-rớq ngki la lớiq piaiq. <verse eid="JAS 4:16" /><verse number="17" style="v" sid="JAS 4:17" />Khán, ti-cuôi mmo chom ar-náq ŏ dyôn án táq ma án lớiq táq, ti-cuôi ngki lư bôn luaih.<verse eid="JAS 4:17" /></para>
  <chapter eid="JAS 4" />
  <chapter number="5" style="c" sid="JAS 5" />
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1" />Ma hoi ndô, cóq i-nha mmứng, máh ti-cuôi ndon súc ngki, cóq nhiêm cu-cloiq co bôn callong diêiq a-rức na i-nha ính tớq. <verse eid="JAS 5:1" /><verse number="2" style="v" sid="JAS 5:2" />Máh ntưn i-nha cơt pa-hoq cha nhéq, ma tam-pớc i-nha cơt ca-muar crớm. <verse eid="JAS 5:2" /><verse number="3" style="v" sid="JAS 5:3" />Dyeng a-lứng práq na top i-nha cơt ta-réh cha a-lứng callong ta-réh ndô na i-nha la tíc a-kéh na i-nha, a-lứng án têq ca-chet i-nha án la a-rớq pla uih. I-nha khoiq pa-chúng máh ntưn na i-nha tớq máh i-ngái tal loiq. <verse eid="JAS 5:3" /><verse number="4" style="v" sid="JAS 5:4" />I-nha me ngki, práq cống na máh ti-cuôi tu-the, ngki la máh ti-cuôi ndon ráiq sro tớq pi-dái na i-nha, práq ngki i-nha ial tớq i-nha, dyơ nha-án cu-cloiq cu-cling, a-lứng máh siêng nhiêm án ndon ráiq sro ngki khoiq tớq nga cu-tor Yang ndon tar-sưq pưt lư. <verse eid="JAS 5:4" /><verse number="5" style="v" sid="JAS 5:5" />Top i-nha khoiq tớc cha sáh saiq a-lứng sáh sai tiên práq tớq pang ndô. I-nha plứm a-rớq pan-nán mít can-nính bôm lớiq chom i-ngái mmo cu-chet. <verse eid="JAS 5:5" /><verse number="6" style="v" sid="JAS 5:6" />Top i-nha khoiq sưq a-lứng ca-chet ti-cuôi ti-nớng ŏ, ti-cuôi ngki lớiq bôn chíl liêh i-nha.<verse eid="JAS 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7" />Co iki, em ai ơi, cóq át pớn dyôn díh ndóng Yang tớq. Me ntíh, ti-cuôi ndon tu-táq át pớn cu-lái tar-náp te cu-teq, át pớn níc cu-lái ngki dyôn díh ndóng cu-teq bôn ráp bo priêh a-lứng bo priêu. <verse eid="JAS 5:7" /><verse number="8" style="v" sid="JAS 5:8" />I-nha mu chứng ngki cóq chiuq ta-nhir. Cóq tin khớm mít can-nính bôm co tu-mán ính tớq na Yang tớq liêh. <verse eid="JAS 5:8" /><verse number="9" style="v" sid="JAS 5:9" />Em ai ơi, êq nhan-nha nhan-nhóm chíl liêh ada tar-tuôq, dŏq i-nha vít te callong tar-sưq. Me ntíh, Án Ndon Tar-sưq chón ta-yứng tớq ngáh callống. <verse eid="JAS 5:9" /><verse number="10" style="v" sid="JAS 5:10" />Em ai ơi, cóq i-nha soi a-rớq nha-án chiuq diêiq a-rức a-lứng bôn mít can-nính a-rớq cu-teq máh ti-cuôi tang ng-cang Yang, máh ti-cuôi co nhơ te nốh Yang dŏq ca to. <verse eid="JAS 5:10" /><verse number="11" style="v" sid="JAS 5:11" />I-nha me ndô, top he arô máh ti-cuôi lư bôn callong bún a-ưi. I-nha khoiq sáng te callong chiuq diêiq a-rức te Yop, a-lứng i-nha khoiq chom ar-náq te Yang, co Yang sáng srui-táq a-lứng ính choi ti-cuôi.<verse eid="JAS 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12" />Ma, nsuôi lư, ơi em ai na cư, i-nha êq tông, mu chứng êq cuc pilŏ́ng lớiq la cu-teq tơ la máh nốh a-mớh i-nha tông can-nŏ́h. Ma, “callong piaiq” iki cóq lư “piaiq”, a-lứng “callong lớiq piaiq”, “cóq lớiq piaiq”, dŏq i-nha lớiq bôn tu-múh Yang táq tôt.<verse eid="JAS 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13" />Ti-cuôi mmo tớq i-nha chiuq diêiq a-rức? Ti-cuôi ngki cóq cớu seq níc. Khán ti-cuôi mmo sáng bui? Ti-cuôi ngki cóq cứh ayô Yang. <verse eid="JAS 5:13" /><verse number="14" style="v" sid="JAS 5:14" />Khán bôn ti-cuôi mmo tớq i-nha ma a-ái tar-ma? Ti-cuôi ngki cóq pôq cớiq ti-cuôi sút top tin tớq a-lứng co nhơ nốh te Yang, nha-án cóq cớu seq níc dyôn ti-cuôi a-ái, tir dơq nseng ada ti-cuôi a-ái. <verse eid="JAS 5:14" /><verse number="15" style="v" sid="JAS 5:15" />Par-nai cớu seq na callong tin dŏq choi ti-cuôi a-ái a-lứng Yang dŏq choi ti-cuôi ngki cơt bánh. Khán ti-cuôi ndô dŏq táh luaih, ti-cuôi ngki lư Yang táh luaih. <verse eid="JAS 5:15" /><verse number="16" style="v" sid="JAS 5:16" />Iki, cóq i-nha ngin luaih mu nơi a-lứng mu náq cớu choi dyôn mu náq dŏq i-nha cớu choi ti-cuôi a-ái cơt bánh. Par-nai cớu seq te ti-cuôi ti-nớng ŏ cớu nhéq tar-ngứh iki callong án cớu lư cơt tar-náp. <verse eid="JAS 5:16" /><verse number="17" style="v" sid="JAS 5:17" />Ê-li la mu náq ti-cuôi chiuq a-rức mu chứng a-rớq top he, a-lứng án cớu seq nhéq tar-ngứh seq dyôn pilŏ́ng êq bo nnáng, iki pilŏ́ng lớiq bôn bo nnáng tớq cruông nhéq pe cu-mo tu-pát ki-sái. <verse eid="JAS 5:17" /><verse number="18" style="v" sid="JAS 5:18" />Dyơ án loi cớu seq, iki pilŏ́ng cơt bo a-lứng cu-teq dŏq a-ma liêh máh crơng tar-nóh.<verse eid="JAS 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19" />Ơi em ai na cư, khán ti-cuôi mmo tớq i-nha ma clu te ar-náq piaiq, a-lứng bôn ti-cuôi mmo choi ti-cuôi ngki píh veng liêh ngê piaiq, <verse eid="JAS 5:19" /><verse number="20" style="v" sid="JAS 5:20" />ngki cóq chom ar-lớih nnáu choi ti-cuôi bôn luaih ngốh te car-na lớiq crái na án, ti-cuôi ngki lư choi ta-mống ar-vai án ki vít callong cu-chet, a-lứng lư bur cu-lứp máh nốh thét luaih.<verse eid="JAS 5:20" /></para>
  <chapter eid="JAS 5" />
</usx>