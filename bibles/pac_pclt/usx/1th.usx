  <book code="1TH" style="id">EN_PCLT pac_Pacoh_ltr Thu Apr 09 2026 09:32:06 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">1 Thessalonians</para>
  <para style="toc1">Chớiq A-lang Tê-salô-ni-ca Mui</para>
  <para style="toc2">Tê-salô-ni-ca Mui</para>
  <para style="toc3">1Th</para>
  <para style="mt">Tê-salô-ni-ca Mui</para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />Phau-lô nha Si-la a-lứng Ti-mu-thê, cơiq a-lang Top Tin Tê-salô-ni-ca tớq Yang Arbang Pilŏ́ng, A-ám a-lứng Yang, Yang Choi Ta-mống Yê-su. Seq callong choi mat nha callong iên ŏ át tớq i-nha.<verse eid="1TH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />Top he cóq si-ơn níc Yang Arbang Pilŏ́ng co nhơ cứp náq i-nha, ndóng lớiq bôn clớiq ca-tớih te i-nha tớq máh par-nai cớu seq na i-nha, <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />co ayư tớq ar-náq bôn callong tin, a-lứng ca-tóng táq co bôn callong ar-moih, mu chứng rap chiuq ta-nhir co bôn callong ng-cong na i-nha te Yang top he, Yang Choi Ta-mống Yê-su, chứng mát Yang Arbang Pilŏ́ng, A-ám top he; <verse eid="1TH 1:3" /><verse number="4" style="v" sid="1TH 1:4" />co chom i-nha, máh ti-cuôi khoiq Yang Arbang Pilŏ́ng a-moih, i-nha khoiq Yang Arbang Pilŏ́ng dŏq rêh, <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />co nhơ Par-nai ŏ Yang na top he khoiq dŏq ca to dyôn i-nha tới nưm sit par-nai sớng, ma callong lư la chức ndon te Yang Ar-vai, a-lứng callong ng-cong bôn ráp — a-rớq i-nha chom top he khoiq tu-mống i-mo te i-nha co tar-náp dyôn i-nha. <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" />I-nha ndon khoiq cơt máh ti-cuôi soi mu chứng na top he tưi a-lứng na Yang, tư tu-múh callong tin tớq a-ưi diêiq a-rức a-lứng bôn callong bui na Yang Ar-vai. <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />Tar-lúh, i-nha cơt a-rớq ngôl dyôn cứp náq ti-cuôi bôn callong tin tớq cruông Ma-sa-dôn nha tớq cruông A-chai. <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />Co te i-nha, par-nai ŏ Yang par-hanh mưt-mư, tới nưm tớq cruông Ma-sa-dôn nha tớq cruông A-chai, ma callong tin na i-nha te Yang Arbang Pilŏ́ng khoiq rŏ́h pláh nga cứp ntúq. Iki, top he lớiq túh cóq taq-ntêr a-mớh nnáng. <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />Co dŏq ca-tớih top he, ma nha-án ca to liêh callong ráp na nha-án khoiq bôn ntúq i-nha nốh a-mớh, a-lứng i-mo i-nha khoiq táh nhéq máh crơng sang rup, dyơ píh nga Yang Arbang Pilŏ́ng dŏq ính táq ar-náq Yang Arbang Pilŏ́ng ndon tu-mống a-lứng án ndon piaiq, <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />a-lứng i-nha ng-cong A-cái Án siar te pilŏ́ng, Án ndon Yang Arbang Pilŏ́ng khoiq dyôn tu-mống liêh te cu-chet — Yang Yê-su, Án khoiq choi top he dyôn vít te tôt chô mát.<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />Em ai ơi, lư i-nha chom ar-lớih ar-náq top he tớq nga i-nha ar-náq ngki lớiq táq ớq tar-náp. <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" />Ma vít dyơ chiuq diêiq a-rức a-lứng ngai pa mat tớq vel Phi-lip a-rớq i-nha khoiq chom, top he cơt clŏ́q lư tớq Yang Arbang Pilŏ́ng na top he ính ca to dyôn i-nha par-nai ŏ te Yang Arbang Pilŏ́ng tam a-ưi ti-cuôi ính chíl. <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />Co máh par-nai dŏq ca-tớih na top he lớiq bôn ngốh te callong luaih, a-lứng lớiq tớq te mít can-nính he bôm, lớiq la co ính thu phíq, <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />ma top he khoiq bôn Yang Arbang Pilŏ́ng khoiq rêh he dŏq mŏp dyôn ca to par-nai ŏ Yang la i-mo, iki top he lư ca to liêh iki tưi, lớiq bôn ính táq bui mít can-nính ti-cuôi can-nŏ́h, ma ính táq dyôn bui ada Yang Arbang Pilŏ́ng, co Án táp chim mít can-nính top he. <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />A-rớq i-nha khoiq chom dyơ, ndóng ngki top he lớiq bôn tớq te máh par-nai na êm, lớiq la dŏq ial can-nính i-nha dyôn choi liêh he — Yang Arbang Pilŏ́ng táp chom — <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />a-lứng lớiq suô callong ŏ ngki te thư ti-cuôi, lớiq bôn te i-nha lớiq la te ti-cuôi can-nŏ́h, <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />tam têq bôn ar-toi co cơt dyưng ati na Yang Choi Ta-mống, ma át tớq i-nha, top he cơt a-rớq ngki ca-nian máh a-cái mbơiq a-ma, mu chứng a-rớq a-i cóq chứm chiam a-cái án. <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />Co bôn callong a-moih i-nha mu chứng ngki, top he sang bui can-nính ca to ada i-nha tới nưm par-nai ŏ te Yang Arbang Pilŏ́ng, ma he rap mŏp díh pang tu-mống he hơ. Ngki la co i-nha khoiq cơt em ai ndon he sang a-moih lư te top he. <verse eid="1TH 2:8" /><verse number="9" style="v" sid="1TH 2:9" />Em ai ơi, i-nha ayư lớiq ndóng he chiuq a-lứng diêiq a-rức na top he, top he khoiq ca to par-nai ŏ te Yang Arbang Pilŏ́ng dyôn i-nha ndóng táq níc ar-náq i-dáu i-ngái dŏq lớiq táq ntáng dyôn top can-nŏ́h te i-nha. <verse eid="1TH 2:9" /><verse number="10" style="v" sid="1TH 2:10" />I-nha la tíc, mu chứng a-rớq Yang Arbang Pilŏ́ng tưi, co i-nha la máh ti-cuôi bôn callong tin, i-nha khoiq bôn mít can-nính práh ŏ, ti-nớng tu-pứng, a-lứng lớiq bôn ngai têq tíq callong ngki, <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />mu chứng a-rớq i-nha khoiq chom, i-mo top he táq dyôn ada cứp náq tớq i-nha, a-rớq a-ám táq dyôn a-cái án, <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />khoiq ca-tớih i-nha, khêr a-lứng ca-túh níc i-nha dŏq át táq ar-náq ŏ a-lứng Yang Arbang Pilŏ́ng, Án arô i-nha dyôn mot tớq ntúq án sút a-lứng chức ang ưr na Án.<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />Co callong ngki, top he lư lớiq ta-ngít si-ơn Yang Arbang Pilŏ́ng, co ndóng ráp par-nai Yang Arbang Pilŏ́ng te dŏq sang par-nai ngki te top he, i-nha khoiq ráp lớiq bôn a-rớq par-nai na ti-cuôi, ma tới chóng ính tông sớng, ngki la par-nai te Yang Arbang Pilŏ́ng, a-lứng par-nai ngki chón táq ar-náq tớq i-nha, la máh ti-cuôi bôn callong tin. <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" />Em ai ơi, i-nha khoiq cơt máh ti-cuôi soi a-rớq top tin na Yang Arbang Pilŏ́ng, la máh dúng rum tớq Yang Choi Ta-mống Yê-su át tớq cruông Yu-dê, co i-nha khoiq chiuq a-lứng máh nốh diêiq a-rức co lư cruông i-nha, mu chứng top tin ngki khoiq chiuq diêiq a-rức te ti-cuôi Isa-ra-el, <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" />la máh ti-cuôi khoiq ndon ca-chet Yang, Yang Yê-su, díh máh ti-cuôi tang ng-cang Yang, ndon táq diêiq a-rức díh top he, a-lứng lớiq táq bui can-nính Yang Arbang Pilŏ́ng, ma yôl cơt pi-con ada cứp náq ti-cuôi, <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />dyơ ca-táng top he ca to par-nai ŏ dyôn ti-cuôi can-nŏ́h dŏq clứng ti-cuôi têq bôn choi ta-mống, táq dyôn callong luaih te nha-án cơt clưi cliai. Ma tớq i-ngái talloiq, tớq ngư ính táq liêh nha-án.<verse eid="1TH 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />Em ai ơi, tam cơt par-táh te i-nha tớq dưnh i-ngái, lớiq tu-múh mát ma mít he át lớiq yông te i-nha, top he ca-tóng lớiq dưnh a-mớh tớq liêh tel-sél ính tu-múh mát i-nha. <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />Co iki, top he ính tớq liêh nga i-nha — nsuôi la cư, Phau-lô, khoiq bôn bar pe chư ính pôq — ma yang sáq ca-táng níc top he. <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />Co callong ng-cong, tơ la callong bui, lớiq la máh ngê can-nŏ́h na top he la i-mo? Ngki la i-nha át chứng mát Yang top he, Yang Yê-su, tớq liêh nga cúc cu-teq ndô na Án la callong ngki? <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />Ar-lớih, i-nha lư ayô a-lứng callong bui hơr na top he.<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />Co iki, tư lớiq rap chiuq nnáng, top he par-ngíh ŏ lư la át mu náq cư tớq vel A-thên, <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />a-lứng top he khoiq yua Ti-mu-thê, ti-cuôi em ai te top he a-lứng án ndon táq ar-náq na Yang Arbang Pilŏ́ng tớq par-nai ŏ Yang te Yang Choi Ta-mống, dŏq ca-dyiq khớm a-lứng ca-tớih i-nha te callong tin na án, <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />dŏq lớiq ngai táh ngê te máh callong diêiq a-rức ndô. Co lư i-nha khoiq chom dyơ top he khoiq dŏq a-nát cóq chiuq ar-náq ngki. <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />Tar-lúh ndóng top he yôl át a-lứng i-nha, top he khoiq tông nsuôi dyôn i-nha idô top he lư tu-múh a-ưi diêiq a-rức, a-lứng ar-náq khoiq cơt a-rớq i-nha khoiq chom. <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />Co te ngki, tư sáng lớiq rap chiuq ta-nhir nnáng, cư yua ti-cuôi pôq nga i-nha dŏq ính chom callong tin i-nha i-mo, dáh lơ yang sáq par-yông car-na mmo loi khoiq ca to dyôn i-nha a-lứng máh ar-náq na top he ca to cơt lúp mat. <verse eid="1TH 3:5" /><verse number="6" style="v" sid="1TH 3:6" />Ma chón hoi ndô, Ti-mu-thê, khoiq ngốh te i-nha chô liêh nga top he, khoiq a-tớq dyôn top he callong bui te callong tin nha callong ar-moih te i-nha, i-mo i-nha át a-lang níc máh par-ngíh callong ŏ te top he, ính tu-múh top he mu chứng a-rớq top he ính tu-múh i-nha. <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />Co te ar-náq ngki, em ai ơi, top he cơt bui liêh co i-nha khoiq tu-múh cứp nốh callong tôiq bap a-lứng diêiq a-rức na i-nha, co callong tin na i-nha. <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />Náp te hoi ndô, khán lư i-nha ta-yứng khớm tớq Yang, ngki top he tu-mống. <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />Top he lư mŏp dyôn Yang Arbang Pilŏ́ng par-nai si-ơn a-mớh te i-nha khoiq tin cứp nốh callong bui hơr ma co tar-náp i-nha, top he sáng bui chứng mát Yang Arbang Pilŏ́ng top he, <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />i-dáu i-ngái cớu seq nhéq tar-ngứh dŏq ính tu-múh liêh i-nha a-lứng ính lư choi máh nốh yôl i-yốh chom tớq callong tin i-nha?<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />Seq lư Yang Arbang Pilŏ́ng, A-ám top he, a-lứng Yang Yê-su, Yang top he, choi dyôn top he tớq nga i-nha. <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />Seq Yang choi i-nha dyôn a-ưi a-lứng clưi clưai tớq callong ar-moih te i-nha a-lứng i-nha a-moih ti-cuôi can-nŏ́h hơ, mu chứng a-rớq top he a-moih ada i-nha, <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />dŏq táq dyôn mít can-nính i-nha tin khớm, lớiq bôn ngai têq tíq nốh a-mớh te callong práh ŏ chứng mát Yang Arbang Pilŏ́ng, A-ám top he, tớq liêh nga cúc cu-teq ndô na Yang top he, Yang Yê-su, a-lứng máh ti-cuôi ndon tin Án. A-men!<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />Khán iki, vít ngki, em ai ơi, top he lư seq a-lứng ính tông ca to i-nha tin Yang, Yang Yê-su, a-rớq i-nha khoiq ráp dyơ te top he i-mo la callong ŏ dyôn i-nha têq tu-mống a-lứng táq dyôn bui ada Yang Arbang Pilŏ́ng, mu chứng a-rớq i-nha tu-mống táq dyôn i-nha têq chom ar-lớih lư loi. <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />Co i-nha chom dyơ máh par-nai i-mo top he khoiq pa-táp dyôn i-nha co nhơ Yang Yê-su. <verse eid="1TH 4:2" /><verse number="3" style="v" sid="1TH 4:3" />Co ndô la can-nính na Yang Arbang Pilŏ́ng, cơt bôn callong ŏ na i-nha: cóq bán ŏ cháq bôm viar yông te ti-cuôi tới cam-pái ca-yiêq ma bíq mu nơi; <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />cứp náq te i-nha cóq chom bán ŏ cháq bôm te callong práh ŏ a-lứng callong dyám náp, <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />êq ham veng ngê bôm (a-rớq tới ti-cuôi Isa-ra-el la ti-cuôi lớiq chom Yang Arbang Pilŏ́ng); <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />êq dyôn nnáu bôn luaih a-lứng par-yông i-nha bôm táq ar-náq ndô, co nhơ Yang la Án têq car-liêh te cứp nốh callong ngki, a-rớq top he mu chứng khoiq tông nsuôi dyơ a-lứng top he khoiq dyŏq dyôn i-nha. <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />Co Yang Arbang Pilŏ́ng lớiq bôn arô top he dyôn táq ar-náq luaih, ma mot tớq ntúq práh ŏ. <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />Co iki, ti-cuôi mmo lớiq ính cam-máng par-nai ndô tới táh par-nai ti-cuôi, ma la táh díh Yang Arbang Pilŏ́ng, Án dyôn Yang Ar-vai Án dyôn i-nha.<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />Ma te mu náq a-moih mu náq, i-nha lớiq ính top he ta-ran dyôn i-nha, co lư i-nha khoiq Yang Arbang Pilŏ́ng ca to cóq mu náq a-moih mu náq. <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />Lư ar-lớih, i-nha bôn táq a-rớq ngki ada cứp náq i-nha át cứp ntúq cruông Ma-sa-dôn. Ma em ai ơi, top he seq i-nha pưt a-sớr pi-lư loi, <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />a-lứng cóq ca-tóng át iên ŏ, mmín táq máh ar-náq bôm, cóq ati bôm mmín táq, a-rớq top he khoiq pa-táp i-nha, <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />dŏq i-nha têq cha ngoiq dyôn car-siat ŏ chứng mát ti-cuôi i-yốh tin a-lứng lớiq bôn ớq mui nốh a-mớh.<verse eid="1TH 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />Em ai ơi, top he lớiq ính i-nha ớq chom te máh ti-cuôi ndon bíq, dŏq i-nha lớiq sáng a-nguaq a-rớq máh ti-cuôi can-nŏ́h la ti-cuôi ndon lớiq bôn callong ng-cong. <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />Ma khán top he chom ar-lớih Yang Yê-su khoiq cu-chet a-lứng khoiq tu-mống liêh, iki Yang Arbang Pilŏ́ng mu chứng têq dông máh ti-cuôi ndon cu-chet tớq nga Án co nhơ náp Yang Yê-su. <verse eid="1TH 4:14" /><verse number="15" style="v" sid="1TH 4:15" />Náp te par-nai na Yang, top he tông par-nai ndô dyôn i-nha, ngki top he, máh ti-cuôi ndon yôl tu-mống, máh ti-cuôi yôl át liêh dyôn díh i-ngái Yang tớq liêh, lư ar-lớih lớiq pôq nsuôi máh ti-cuôi khoiq cu-chet. <verse eid="1TH 4:15" /><verse number="16" style="v" sid="1TH 4:16" />Co lư Yang cơt te pilŏ́ng siar a-lứng khoiq yua, a-lứng siêng na tar-neng ndon sút, mu nơi a-lứng siêng ngai plŏ́ng tang-coi na Yang Arbang Pilŏ́ng, dyơ máh ti-cuôi khoiq cu-chet tớq Yang Choi Ta-mống lư tu-mống liêh nsuôi. <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />Vít ngki, top he, la máh ti-cuôi ndon yôl tu-mống, máh ti-cuôi yôl át liêh, lư pa-chúng mu nơi a-lứng nha-án tớq tu-lúc dŏq tu-múh Yang tớq pilŏ́ng, a-lứng a-rớq ngki, top he têq át a-lứng Yang nic-níc. <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />Co iki, cóq mu náq khêr mu náq tớq máh par-nai ndô.<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />Em ai ơi, te i-ngái ndô lớiq la cu-mo tớq, i-nha lớiq ính top he ta-ran dyôn i-nha. <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" />Co lư i-nha táp chom ar-lớih i-ngái na Yang tớq liêh la i-mo — a-rớq ti-cuôi si-veng ti-tôiq tớq i-dáu. <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />Dyơ ngai tông idô: “Bôn iên ŏ dyơ a-lứng lớiq diêiq a-rức nnáng,” iki callong bap lư tớq nga nha-án, mu chứng a-rớq, tớq a-ái cuôp cu-mo na ti-cuôi cán chón át cháq ntáng, a-lứng nha-án ar-lớih lớiq têq viar te callong ngki. <verse eid="1TH 5:3" /><verse number="4" style="v" sid="1TH 5:4" />Ma, em ai ơi, i-nha lớiq át tớq ntúq ngiau tư dyơ i-ngái ngki piaiq tớq ngư dyôn i-nha ti-cớr a-rớq ti-cuôi si-veng mot ti-tôiq. <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />Co i-nha lư la a-cái na callong ang a-lứng a-cái na callong i-ngái. Top he lớiq ưlla te i-dáu lớiq la ntúq ngiau, <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />khán iki, top he êq bíq a-rớq máh ti-cuôi can-nŏ́h, ma, top he cóq ca-yôn níc a-lứng mmứng a-ŏ. <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />Co ti-cuôi bíq la bíq tớq i-dáu, a-lứng ti-cuôi bol ngki bol tớq i-dáu. <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" />Ma co ưlla te i-ngái, iki top he cóq mmứng a-ŏ, sứp au taq na callong tin nha callong ar-moih, a-lứng muôc taq — la callong ng-cong choi ta-mống. <verse eid="1TH 5:8" /><verse number="9" style="v" sid="1TH 5:9" />Co Yang Arbang Pilŏ́ng dŏq lớiq a-nát dyôn top he chiuq callong ính táq, ma ính dyôn ráp callong choi ta-mống nhơ Yang top he, Yang Choi Ta-mống Yê-su, <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />Yê-su khoiq cu-chet co top he, dyôn top he tam tu-mống lớiq la cu-chet, top he bôn át níc a-lứng Án. <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />Co iki, cóq mu náq khêr mu náq, ti-cuôi ndô tar-choi dyôn ti-cuôi ntíh, a-rớq i-nha khoiq táq.<verse eid="1TH 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />Em ai ơi, top he seq i-nha cóq dyám náp máh ti-cuôi chiuq táq sol te top i-nha, par-yông i-nha táq ar-náq Yang, tông ca to i-nha, <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />a-lứng cóq par-ngíh nga nha-án na ngê bôn callong dyám náp tớq callong ar-moih co ar-náq na nha-án. Cóq tu-mống mu náq át ar-toi a-lứng mu náq. <verse eid="1TH 5:13" /><verse number="14" style="v" sid="1TH 5:14" />Ma, em ai ơi, top he cóq ca-tớih i-nha: cóq dyŏq ti-cuôi ndon a-láh, cóq khêr ti-cuôi ndon bôn mít callaq, cóq choi ti-cuôi ndon tin iêuq thor, cóq chiuq ta-nhir ada cứp náq ti-cuôi. <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />Cóq mmứng, êq nnáu ial callong saq cu-liêh liêh callong saq dyôn nnáu, ma, cóq ca-tóng si-suô callong ŏ dyôn ada mu náq a-lứng dyôn cứp náq ti-cuôi. <verse eid="1TH 5:15" /><verse number="16" style="v" sid="1TH 5:16" />Cóq nic-níc bui hơr. <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />Cóq cớu seq êq ta-ngít. <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />Tớq cứp callong a-mớh, cóq si-ơn, co callong ngki la can-nính na Yang Arbang Pilŏ́ng dyôn ada i-nha tin Yang Choi Ta-mống Yê-su. <verse eid="1TH 5:18" /><verse number="19" style="v" sid="1TH 5:19" />Êq táq dyôn a-nguaq Ar-vai Yang. <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />Êq pa-mat máh ti-cuôi tang ng-cang Yang. <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />Cóq ti-tuaiq cứp nốh. Cóq ráp ial callong mmo la lư ŏ. <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />Cóq viar yông te cứp nốh callong lớiq ŏ.<verse eid="1TH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />Cớu seq te Yang Arbang Pilŏ́ng ndon iên ŏ táq dyôn práh i-nha máh ar-náq án ính, a-lứng seq án táq dyôn mít i-nha cơt práh ŏ, ar-vai, cháq, na i-nha dŏq lớiq bôn ngai têq tíq tớq Yang top he, Yang choi Ta-mống Yê-su, tớq liêh. <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />Tin ti-nớng tu-pứng la Án khoiq arô i-nha, mu chứng la Án lư táq máh ar-náq ngki.<verse eid="1TH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />Em ai ơi, mu chứng cóq i-nha cớu choi dyôn top he hơ.<verse eid="1TH 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26" />Seq ca-hanh cứp náq i-nha na mu náq car-bánh ŏ ada mu náq. <verse eid="1TH 5:26" /><verse number="27" style="v" sid="1TH 5:27" />Cư nhơ nốh Yang ca to dyôn i-nha cóq cơiq chớiq a-lang ndô bôn dŏc dyôn cứp náq i-nha sáng tưi.<verse eid="1TH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />Seq callong choi mat na Yang top he, Yang Choi Ta-mống Yê-su, át a-lứng i-nha.<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>