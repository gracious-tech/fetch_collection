<usx version="3.0">
  <book code="EPH" style="id">EN_PCLT pac_Pacoh_ltr Thu Apr 09 2026 09:32:55 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Ephesians</para>
  <para style="toc1">Chớiq A-lang Ê-phê-sô</para>
  <para style="toc2">Ê-phê-sô</para>
  <para style="toc3">Eph</para>
  <para style="mt">Ê-phê-sô</para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />Phau-lô, la dyưng ati na Yang Choi Ta-mống Yê-su co te can-nính na Yang Arbang Pilŏ́ng, cơiq dyôn máh top tin, la máh ti-cuôi tin át tớq Ê-phê-sô nha máh ti-cuôi ti-nớng tu-pứng tớq Yang Choi Ta-mống Yê-su. <verse eid="EPH 1:1" /><verse number="2" style="v" sid="EPH 1:2" />Callong choi mat a-lứng callong iên ŏ co te Yang Arbang Pilŏ́ng, A-ám top he, a-lứng Yang, la Yang Choi Ta-mống Yê-su, tớq nga i-nha.<verse eid="EPH 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />Piaiq cứh ayô Yang Arbang Pilŏ́ng, A-ám na Yang Choi Ta-mống Yê-su, Yang top he, Án khoiq dyôn ada top he bôn cứp callong bún na Ar-vai át máh ntúq mpiên pilŏ́ng tớq Yang Choi Ta-mống, <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />mu chứng Án khoiq rêh top he nhơ te Yang Choi Ta-mống te nsuôi lư teng cúc cu-teq ndô, dŏq top he bôn cơt ti-cuôi táq ar-náq án a-lứng lớiq bôn luaih a-mớh chứng mát Án. Co án a-moih he <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />Án khoiq a-nát nsuôi top he dyôn cơt a-cái na Án co nhơ te Yang Choi Ta-mống Yê-su, veng a-rớq mít can-nính Án, <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />dŏq tar-náp na callong cứh ayô ang ưr na callong choi mat Án ma Án khoiq dyôn ada top he te A-cái Par-láng, <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" />te A-cái ngki, top he bôn thái liêh nhơ a-ham Án, callong táh luaih veng callong súc bôn na callong choi mat Án, <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />la callong choi mat ndon Án khoiq dyôn ada top he cơt clưi clưai tớq cứp callong tu-báiq a-lứng chom ar-lớih, <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />táq dyôn top he chom te callong ca-tốq na par-ngíh Án veng callong bui can-nính Án, la callong ndon Án khoiq a-nát te nsuôi tớq Yang Choi Ta-mống, <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />dŏq ndóng tớq i-ngái táq cua dyơ ar-náq khoiq a-nát, ngki pa-chúng túc nốh liêh tớq Yang Choi Ta-mống, nhéq máh nốh tớq pilŏ́ng nha máh nốh tớq cu-teq, nhơ te Án, <verse eid="EPH 1:10" /><verse number="11" style="v" sid="EPH 1:11" />tớq Án ma top he lư bôn tưi phê máh nốh, co khoiq bôn a-nát nsuôi veng can-nính na Án táq cơt cứp ar-náq a-rớq ar-náq na par-ngíh Án, <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />dŏq top he, máh ti-cuôi nsuôi lư dŏq ng-cong tớq Yang Choi Ta-mống, bôn tar-náp na callong cứh ayô te ang ưr na Án. <verse eid="EPH 1:12" /><verse number="13" style="v" sid="EPH 1:13" />Ngki tớq Án, ndóng sáng par-nai na callong piaiq, Par-nai ŏ Yang te callong choi ta-mống i-nha, a-lứng ndóng khoiq tin te Án, i-nha khoiq dŏq dyôn na Yang Ar-vai veng par-nai par-ưq, <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />ma Án la callong tíc te cứp nốh na top he ti-ngôi ndóng tang thái nhéq máh ti-cuôi, dŏq cơt cu-lái na callong cứh ayô te ang ưr na Án.<verse eid="EPH 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />Co iki, tư ndóng cư sáng te callong tin na i-nha tớq Yang, la Yang Yê-su, a-lứng callong ar-moih dyôn ada nhéq máh ti-cuôi tin, <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />cư lớiq clớiq si-ơn co i-nha, ca-tớih tông i-nha tớq par-nai cớu seq te i-nha, <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />dyôn têq Yang Arbang Pilŏ́ng na Yang Choi Ta-mống Yê-su, Yang top he, A-ám ang ưr, lư dyôn ada i-nha Ar-vai na callong tu-báiq a-lứng callong a-páh tớq ar-náq chom Án, <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />táq callong mát na mít i-nha dyôn cơt ang, dŏq i-nha chom ng-cong te callong rêh arô na Án la a-mớh, callong súc bôn na cứp nốh ang ưr Án tớq máh top tin cơt i-mo, <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />a-lứng callong pưt lư ớq a-mớh têq ta-li te chức pưt Án co i-mo táq dyôn top he, máh ti-cuôi ndon tin, cóq táq veng a-rớq án ca to iki bôn rêng chức sút te Án, <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />ma Án khoiq a-páh tớq Yang Choi Ta-mống ndóng dyôn Yang Choi Ta-mống te cu-chet tu-mống liêh a-lứng dŏq ti-cu pa a-tớm Án át máh ntúq tớq pilŏ́ng, <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />ta-niêng te nhéq nốh sút, nốh chức, nốh pưt, a-lứng nốh bánh rêng, a-lứng nhéq nốh ngai dyám náp, lớiq nưm tớq pang ndô ma díh tớq pang ta-tun hơ. <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />Án khoiq dyôn cứp nốh át ta-dưp dyưng Yang Choi Ta-mống a-lứng dŏq Yang Choi Ta-mống cơt plô át tớq cứp callong ada top tin, <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />ma top tin la cháq Án, callong cứp nhéq na Án cơt cứp nhéq cứp callong tớq cứp nốh.<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />Te i-nha, la ti-cuôi cu-chet co táq luaih a-lứng luaih lới i-nha, <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />tớq máh ar-náq ma ndóng nsuôi, i-nha khoiq táq veng ar-náq na pang ndô, veng án sút a-lớng chức lớiq piaiq, lư yang sáq chón át par-yông tớq máh a-cái a-con lớiq cam-máng, <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />ma te nsuôi, tớq top nha-án, nhéq náq top he ngki khoiq tu-mống tớq máh callong ính na sac sáiq nha-án, táq máh callong ính na sac sáiq nha par-ngíh. Co khoiq bôn iki, top he la a-cái a-con na callong ính táq mu chứng a-rớq ti-cuôi can-nŏ́h. <verse eid="EPH 2:3" /><verse number="4" style="v" sid="EPH 2:4" />Ma Yang Arbang Pilŏ́ng, la Án bôn mít sruiq-táq, co callong ar-moih pưt lư te Án ma Án khoiq a-moih top he, <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />iki ndóng top he la máh ti-cuôi cu-chet tớq máh callong luaih i-nha, Án khoiq dyôn top he cơt tu-mống tớq Yang Choi Ta-mống — nhơ callong choi mat i-nha khoiq bôn tu-mống — <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />Án dyôn top he tu-mống liêh, a-lứng dŏq ti-cu mu nơi a-lứng Án át máh ntúq tớq pilŏ́ng tớq Yang Choi Ta-mống Yê-su, <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />dŏq tớq máh pang ính tớq, Án bôn a-páh callong súc bôn nhéq mma callong choi mat Án na callong a-moih ada top he tớq Yang Choi Ta-mống Yê-su. <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />Co te callong choi mat, i-nha bôn tu-mống nhơ callong tin, ar-náq ndô tới tớq te i-nha, callong choi mat sớng te Yang Arbang Pilŏ́ng, <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />tới tớq te máh ar-náq táq, dŏq lớiq bôn nnáu têq cu-hống. <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />Co top he la ar-náq na Án, bôn teng cơt tớq Yang Choi Ta-mống Yê-su dyôn máh ar-náq ŏ ma Yang Arbang Pilŏ́ng khoiq thuan nsuôi dŏq top he têq tu-mống tớq máh ar-náq ngki.<verse eid="EPH 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />Iki, cóq ayư liêh tro ndô, i-nha la ti-cuôi tới Isa-ra-el tớq sac sáiq, ti-cuôi ndon ngai dŏq la “i-yốh táq rit kít” co ti-cuôi ndon ngai dŏq la “khoiq táq rit kít” tớq sac sáiq, co ati ti-cuôi táq, <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />co ndóng ngki, i-nha át yông te Yang Choi Ta-mống, ndóng ngai dŏq cu-lai tiêh top ti-cuôi Isa-ra-el, a-lứng tu-moi laq te máh car-hŏt na par-nai par-ưq, iki ớq bôn callong ng-cong, nha ớq bôn Yang Arbang Pilŏ́ng tớq cúc cu-teq ndô. <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />Ma, tớq Yang Choi Ta-mống Yê-su, i-nha, máh ti-cuôi ndóng nsuôi át yông lư, hoi ndô khoiq bôn tớq tar-mán nhơ a-ham te Yang Choi Ta-mống. <verse eid="EPH 2:13" /><verse number="14" style="v" sid="EPH 2:14" />Co lư Án la callong iên ŏ na top he, la Án khoiq táq dyôn díh bar cơt mui a-lứng ta-lóh táh car-rong na callong par-chuôt, callong par-ual, tớq cháq Án, <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />ndóng khoiq táh phep rit te callong pa-táp tớq máh rit rŏng, têq Án táq dyôn díh bar cơt mu náq ti-cuôi tam-me tớq Án, táq dyôn tár ŏ, <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />nha Án dyôn ar-toi díh bar a-lớng Yang Arbang Pilŏ́ng cơt mui cháq na a-long calláng, vít ndóng ca-chet ar-náq pi-con tớq ngki. <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />Ndóng Án khoiq tớq, Án ca to callong iên ŏ ada i-nha, la máh ti-cuôi te yông, a-lứng callong iên ŏ dyôn máh ti-cuôi tớq tar-mán, <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />co nhơ Án, díh bar bôn chức têq tớq tar-mán tớq mui Ar-vai dŏq tớq nga A-ám. <verse eid="EPH 2:18" /><verse number="19" style="v" sid="EPH 2:19" />Dyơ ngki, i-nha lớiq bôn la tu-moi laq lớiq la ti-cuôi cruông can-nŏ́h nnáng. Ma lư, i-nha la ti-cuôi mui cruông a-lớng máh top tin nha la ti-cuôi tớq mu dúng na Yang Arbang Pilŏ́ng, <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />co khoiq bôn dŏq pi-tứng táq tớq mpiên na top dyưng ati a-lứng máh ti-cuôi tang ng-cang, ndóng lư Yang Choi Ta-mống Yê-su la búl ta-nang dúng, <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />ma tớq Án, díh ar-náq pi-tứng táq ngki, ndóng bôn par-teng cơt mu nơi, ngki pưt a-sớr cơt mui dúng sang mmar tớq Yang, <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />a-lứng nhơ tớq Án, i-nha bôn a-yứng mu nơi cơt dúng mmar na Yang Arbang Pilŏ́ng tớq Ar-vai.<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />Co iki, cư, Phau-lô, át tôt táq ar-náq na Yang Choi Ta-mống Yê-su co i-nha ti-cuôi tới Isa-ra-el — <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />co lư ar-lớih i-nha khoiq sáng te ar-náq kiaq ma callong choi mat na Yang Arbang Pilŏ́ng, la ar-náq khoiq dŏq dyôn ada cư co i-nha, <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />veng callong mpáh khoiq dŏq a-páh ada cư, callong ca-tốq a-rớq cư khoiq ta-ran biq par-nai tớq ngki. <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />Ndóng dŏc tớq par-nai ngki, i-nha lư têq chom ar-lớih na cư te callong ca-tốq na Yang Choi Ta-mống, <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />la ar-náq khoiq lớiq bôn a-páh dyôn a-cái a-con thư ti-cuôi tớq máh pang nsuôi, ma hoi ndô, co Ar-vai, callong ngki khoiq bôn a-páh dyôn top dyưng ati práh ŏ na Án a-lứng top tang ng-cang — <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />ngki la: máh ti-cuôi tới Isa-ra-el bôn chúng tưi mun, nha-án têq cơt mui top, a-lứng máh ti-cuôi ngki mpô par-nai ưq te Yang Choi Ta-mống Yê-su na Par-nai ŏ Yang, <verse eid="EPH 3:6" /><verse number="7" style="v" sid="EPH 3:7" />co Par-nai ŏ Yang ngki ma cư khoiq cơt ti-cuôi táq ar-náq na callong choi mat te Yang Arbang Pilŏ́ng, la ar-náq khoiq dŏq dyôn ada cư chón táq co chức sút Án. <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />Callong choi mat ngki khoiq dyôn ada cư — ti-cuôi ndon két lư tớq máh top tin — dŏq ca to dyôn ti-cuôi tới Isa-ra-el callong súc bôn chom máh mmo na Yang Choi Ta-mống, <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />a-lứng dŏq a-páh dyôn cứp ti-cuôi mmo la ar-náq kiaq me callong ca-tốq, la ar-náq khoiq dŏq ca-tốq clôp te pang i-nớh tớq Yang Arbang Pilŏ́ng, Án khoiq teng cứp nốh, <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />dyôn cơt hoi ndô, na top tin, callong tu-báiq a-ưi lư na Yang Arbang Pilŏ́ng têq bôn a-páh dyôn máh nốh sút a-lứng máh nốh chức át máh ntúq tớq pilŏ́ng, <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />veng ar-náq nic-níc ma Án khoiq táq co Yang Choi Ta-mống Yê-su, Yang top he, <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />co Án, top he bôn mít clŏ́q lư nha car-na pôq tar-mán Yang Arbang Pilŏ́ng a-lứng te mít clŏ́q nhơ callong tin te Án. <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />Iki, cư seq i-nha êq pê mít can-nính co máh diêiq a-rức na cư co te i-nha, ma máh diêiq a-rức ngki la callong ang ưr na i-nha.<verse eid="EPH 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />Co te ar-náq ngki, cư chóh tar-col chứng mát A-ám, <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />la Án ndon te Án, cứp dúng su tớq pilŏ́ng a-lứng tớq cu-teq bôn dŏq nốh, <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />dŏq seq Án, mmar callong súc bôn na ang ưr Án, dyôn i-nha cơt bánh rêng a-lớng chức sút na Ar-vai te Án ntúq ti-cuôi tớq callúng, <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />dŏq Yang Choi Ta-mống át tớq mít i-nha na callong tin, ndóng khoiq bôn riaih a-lứng cơt khớm tớq callong a-moih, <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />dyôn têq i-nha a-lứng nhéq máh ti-cuôi tin, bôn bánh rêng dŏq chom ar-lớih a-rớq i-mo la pơh, toiq, a-yống, sru, <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />a-lứng dŏq a-cớl ar-náq clưi te callong chom, callong a-moih te Yang Choi Ta-mống, dyôn têq i-nha bôn tốq pớnh na cứp nốh te Yang Arbang Pilŏ́ng.<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />Seq te Án têq táq clưi te cứp nốh ndon top he seq lớiq la par-ngíh, veng chức sút chón át táq tớq top he, <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />seq Án bôn ang ưr tớq top tin a-lứng tớq Yang Choi Ta-mống Yê-su na cứp pang díh sút pang lang dơi. A-men.<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />Iki, cư, ti-cuôi tôt tớq Yang, át khêr i-nha cóq tu-mống dyôn crái piaiq a-lứng callong rêh arô ndon i-nha khoiq bôn arô tớq, <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />na nhéq callong a-siar cháq nha lam-bŏt, a-lứng mít chiuq ta-nhir, chiuq ta-nhir ada tar-tuôq tớq callong a-moih, <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />ca-tóng nhéq tar-ngứh dŏq callong mui mít te Ar-vai tớq tu-mống iên ŏ. <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />Mui cháq a-lứng mui Ar-vai, mu chứng a-rớq i-nha khoiq dŏq arô tớq mui callong ng-cong te callong rêh arô i-nha, <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />mui Yang, mui callong tin, mui rit tíc na dơq, <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />mui Yang Arbang Pilŏ́ng, A-ám na cứp náq ti-cuôi, Án át tớq cứp náq ti-cuôi, na cứp ti-cuôi a-lứng tớq cứp náq ti-cuôi. <verse eid="EPH 4:6" /><verse number="7" style="v" sid="EPH 4:7" />Ma, callong choi mat khoiq dŏq dyôn ada cứp náq ti-cuôi top he bôn mmar ar-náq táq tớq callong dyôn te Yang Choi Ta-mống. <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />Co iki, bôn par-nai ta-ran:</para>
  <para style="q1" vid="EPH 4:8">“Ndóng Án sớr liêh nga ta-niêng,</para>
  <para style="q1" vid="EPH 4:8">Án pôq nsuôi dông máh ti-cuôi tôt,</para>
  <para style="q1" vid="EPH 4:8">a-lứng dyôn a-ưi crơng mpon dyôn tưh ti-cuôi.”<verse eid="EPH 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9" />Ma, “Án sớr liêh” tar-náp la a-mớh khán tới la Án lư khoiq siar tớq máh ntúq a-êp na cu-teq? <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />Lư Án khoiq siar mu chứng la Án khoiq sớr liêh nga ta-niêng nhéq máh tớq pilŏ́ng, dŏq Án têq táq cứp callong. <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />Lư Án khoiq dyôn án ndon cơt dyưng ati, án ndon cơt tang ng-cang, án ndon cơt ti-cuôi pau ca to Par-nai ŏ Yang, án ndon cơt sol Yang a-lứng thới pa-rian, <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />dŏq ti-ráp máh ti-cuôi tin bôn mmar ar-náq táq, dyôn cơt pưt a-sớr a-rớq cháq na Yang Choi Ta-mống, <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />dyôn tớq i-ngái nhéq top he lư bôn cơt mui mít tớq callong tin a-lứng callong chom A-cái Yang Arbang Pilŏ́ng, cơt ti-cuôi sa-sai, dyôn ti-ngôi cơt práh ŏ a-rớq na Yang Choi Ta-mống, <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />dŏq top he lớiq nnáng la ngai a-cái, cơt táh ki-túh dyơ par-yông veng a-rớq cu-yiêl phớt te par-nai na ti-cuôi can-nŏ́h co ar-lớu ar-chuôt a-lứng callong pi-lốh, bánh a-uai. <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />Ma lư, ndóng tông par-nai piaiq tớq callong a-moih, top he têq pưt a-sớr te cứp nốh tớq Án, Án la plô, Yang Choi Ta-mống, <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />co te Án ma díh cháq bôn mui mít a-lứng tar-kít liêh mu nơi nhơ cứp nốh ndô ma táq piaiq, veng a-rớq nhéq cháq cơt bánh rêng tớq máh cứp nốh, táq dyôn cháq pưt a-sớr dŏq táq liêh ar-náq tớq callong a-moih.<verse eid="EPH 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />Co iki, cư tông callong ndô a-lứng dyŏq i-nha tớq Yang dŏq lớiq bôn cha át mu chứng a-rớq ti-cuôi i-yốh tin nnáng, nha-án tu-mống tớq callong luaih lới na par-ngíh nha-án. <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />Co par-ngíh nha-án khoiq in ngai táq dyôn ngiau, cơt át yông te callong tu-mống na Yang Arbang Pilŏ́ng co callong a-chơ a-ơu át tớq nha-án, co mít nha-án cớng ngan. <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />Tư lớiq chom a-chiêt nnáng, nha-án khoiq mŏp nha-án nga callong sáq dŏq táq cứp nốh ar-náq saq te mít sáng ính. <verse eid="EPH 4:19" /><verse number="20" style="v" sid="EPH 4:20" />Ma i-nha khoiq lớiq táq veng Yang Choi Ta-mống iki, <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />co lư i-nha khoiq sáng te Án a-lứng khoiq bôn ca to tớq Án, veng a-rớq callong piaiq át tớq Yang Yê-su, <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />cóq luaiq táh te i-nha nốh a-mớh ưlla te pang tu-mống te nsuôi, cháq ti-cuôi tiêq cơt rúng pít co ar-náq par-lốh, <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />ma bôn cơt tám me nhơ ar-vai tớq par-ngíh i-nha, <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />a-lứng cơt cháq ti-cuôi tám me, la ti-cuôi bôn teng cơt veng Yang Arbang Pilŏ́ng — tớq callong ti-nớng tu-pứng nha callong práh ŏ na callong piaiq.<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />Iki, ndóng khoiq táh callong báq a-uai, cứp náq ti-cuôi cóq taq-ntêr callong piaiq a-lớng ti-cuôi pa-niar i-nha, co top he la mu cháq na tar-tuôq. <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />I-nha têq sáng nháih ma êq táq luaih. Cóq dyôn mát pan-dang i-yốh plŏt tớq callong táq nháih i-nha, <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />a-lứng êq pốh car-na dyôn yang sáq. <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />Ti-cuôi ndon ti-tôiq êq tôiq nnáng. Ma, ŏ lư, ti-cuôi ngki cóq ca-tóng táq ar-náq ŏ lư na ati án, dyôn têq ti-cuôi ngki bôn dŏq mpô ada máh ti-cuôi chón át tớq callong ớq a-mớh. <verse eid="EPH 4:28" /><verse number="29" style="v" sid="EPH 4:29" />Êq dyôn par-nai ntêr saq mmo ngốh te ng-cang i-nha, ma cóq taq-ntêr máh par-nai mmo ŏ dŏq tớq callong tar-choi ti-cuôi mmo te diêiq a-rức, dŏq par-nai ngki têq dyôn tar-náp ada ti-cuôi cam-máng, <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />a-lứng êq táq a-nguaq Yang Ar-vai na Yang Arbang Pilŏ́ng, co Án ma i-nha bôn cơt tíc dyôn i-ngái choi ta-mống. <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />Cóq luaiq táh te i-nha nhéq a-ái a-oiq, nsốq mít, sáng nháih, tar-miên, can-nốh, mu chứng máh ar-náq lớiq ŏ. <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />Ma lư, cóq a-páh ada tar-tuôq mít lam-bŏt, sruiq-táq, táh luaih yớu mu chứng a-rớq Yang Arbang Pilŏ́ng khoiq táh luaih i-nha tớq Yang Choi Ta-mống.<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />Iki, cóq cơt máh ti-cuôi táq veng Yang Arbang Pilŏ́ng, a-rớq a-cái a-con lư a-moih lư, <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />a-lứng cóq tu-mống tớq callong ar-moih, mu chứng a-rớq Yang Choi Ta-mống khoiq a-moih top he dyơ mŏp cháq Án co top he a-rớq crơng nha mŏp sang a-lứng sáng thum lư mŏp dyôn Yang Arbang Pilŏ́ng.<verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />Ma callong bíq mu nơi, mu chứng cứp nốh tang-hang lớiq la ham crơng ngki êq taq-ntêr nnáng te top i-nha, a-rớq callong ngki la piaiq ada máh ti-cuôi tin, <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />par-nai ntêr mmuaq, par-nai yúh, lớiq la par-nai lớiq tar-dyám — la máh nốh lớiq crái — ma lư tớq ngki par-nai si-ơn. <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />Lư iki, cóq chom callong ndô ada ar-lớih idô cứp náq ti-cuôi bíq mu nơi, táq tang-hang, lớiq la ham crơng — ngki la ti-cuôi sang yang can-nŏ́h — lư ớq bôn chúng mun tớq cruông na Yang Choi Ta-mống nha Yang Arbang Pilŏ́ng. <verse eid="EPH 5:5" /><verse number="6" style="v" sid="EPH 5:6" />Êq dyôn nnáu pi-lốh i-nha na máh par-nai lớiq cơt callong, co te máh nốh ngki, callong ính táq na Yang Arbang Pilŏ́ng siar nga a-cái a-con lớiq cam-máng. <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />Dyơ iki, i-nha êq cơt máh ti-cuôi chúng tưi a-lớng nha-án, <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />co te nsuôi i-nha yôl tớq ngiau, ma ndô la callong ang tớq Yang. Cóq táq pôq a-rớq a-cái a-con na callong ang <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />(co piêr cu-lái na callong ang át tớq cứp nốh ŏ, ti-nớng tu-pứng, nha callong piaiq), <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />cóq si-suô mmo la nốh bui can-nính Yang. <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />Êq táq nga máh ar-náq lớiq tar-náp na callong ngiau, ma cóq a-páh ar-náq ang ngki ŏ hơn, <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />co lư la a-chiêt ndóng nưm taq-ntêr máh ar-náq nha-án táq clôp ngki. <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />Ma cứp nốh bôn hôm ar-lớih ndóng bôn mpáh tớq callong ang, co cứp nốh bôn hôm ar-lớih la co callong ang. <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />Co iki, bôn par-nai tông:</para>
  <para style="q1" vid="EPH 5:14">“Cóq yôr ayư, ơi ti-cuôi chóng bíq,</para>
  <para style="q1" vid="EPH 5:14">cóq yôr ta-yứng te callúng ti-cuôi cu-chet,</para>
  <para style="q1" vid="EPH 5:14">Yang Choi Ta-mống lư claq ang i-nha.”<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />Iki, cóq mmứng ada car-siat te i-nha chón át tu-mống — êq a-rớq ti-cuôi a-chơ ma a-rớq ti-cuôi tu-báiq, <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />ndóng táq ar-náq ŏ, co máh pang ndô la saq lư. <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />Co iki, êq a-rớq ti-cuôi a-chơ, ma cóq chom mmo la can-nính na Yang. <verse eid="EPH 5:17" /><verse number="18" style="v" sid="EPH 5:18" />Êq bol siêu, co siêu ngki lư táq dyôn rúng. Ma, cóq dyôn táq sút na Ar-vai, <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />tar-ôi ada tar-tuôq na cứh ayô, alhoiq cứh nha cứh ayô ar-vai nhéq te mít i-nha cứh a-lứng ayô Yang, <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />mŏp par-nai si-ơn Yang Arbang Pilŏ́ng, la A-ám, tớq cứp nốh te cứp callong nhơ nốh Yang Choi Ta-mống Yê-su, Yang top he, <verse eid="EPH 5:20" /><verse number="21" style="v" sid="EPH 5:21" />cóq cam-máng tar-tuôq tớq callong dyám náp Yang Choi Ta-mống —<verse eid="EPH 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />Án cơt cam-pái, ca-yiêq án a-rớq Yang. <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />Co ca-yiêq la plô cam-pái, mu chứng a-rớq Yang Choi Ta-mống la plô top tin — lư Án la Yang Choi Ta-mống na cháq. <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />Ma, top tin cam-máng Yang Choi Ta-mống i-mo ngki cam-pái nha ca-yiêq án tớq cứp ar-náq lư iki. <verse eid="EPH 5:24" /><verse number="25" style="v" sid="EPH 5:25" />Án cơt ca-yiêq, cóq a-moih cam-pái án, mu chứng a-rớq Yang Choi Ta-mống khoiq a-moih top tin nha mŏp cháq án co top tin, <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />dŏq Án têq dŏq mmar top ngki, vít ndóng táq dyôn práh te callong a-rau na dơq a-lứng te par-nai ŏ Yang, <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />têq Án dông a-páh dyôn án táp mui top tin ang ưr, lớiq bôn a-áu lớiq la car-dyáp car-dyop, lớiq la bôn mui nốh mmo lớiq ŏ, ma dŏq top tin bôn práh ŏ a-lứng ớq ntúq tíq. <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />Mu chứng a-rớq ngki ca-yiêq la cóq a-moih cam-pái án a-rớq a-moih cháq bôm. Án ca-yiêq a-moih cam-pái na án la a-moih cháq bôm. <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />Co ớq nnáu a-ính cháq án bôm, ma chứm chiam a-lứng asa cháq bôm, mu chứng a-rớq Yang Choi Ta-mống táq dyôn top tin, <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />co top he la máh phê te cháq Án. <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />“Co te ngki, án ndon conh lư yáh a-ám a-i dyơ át mu nơi a-lớng cam-pái án, nha-án bar lư cơt mui sáiq.” <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />Callong ca-tốq ndô lư sru lư — ma cư chón tông te Yang Choi Ta-mống a-lứng te top tin. <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />Lư iki, i-nha ngki êq veng car-na ngki — chư mu náq — án ndon ca-yiêq cóq a-moih cam-pái án a-rớq cháq bôm, ma án cam-pái la cóq dyám náp ca-yiêq án.<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />Án ndon a-cái, cóq cam-máng par-nai a-ám a-i na máh a-cái tớq Yang, co ngki la callong lư piaiq. <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />“Cóq dyám náp a-ám a-i na a-cái” (ngki la callong pa-táp tôm lư a-lớng par-nai par-ưq), <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />“dŏq callong bún tớq nga a-cái nha a-cái têq bôn tu-mống dưnh tớq cu-teq.” <verse eid="EPH 6:3" /><verse number="4" style="v" sid="EPH 6:4" />Án ndon a-ám, êq tar-ac a-cái a-con án. Ma lư, cóq par-léh nha-án tớq callong pa-táp nha ca to na Yang.<verse eid="EPH 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />Án ndon ti-cuôi sol, cóq cam-máng ti-cuôi sút veng sac sáiq nha callong dyám náp a-lứng a-dáh te mít ti-nớng tu-pứng na án, mu chứng a-rớq ada Yang Choi Ta-mống, <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />êq nưm táq ŏ ndóng sút kiaq me a-rớq máh ti-cuôi ính bôn ayô, ma a-rớq sol na Yang Choi Ta-mống, táq veng can-nính na Yang Arbang Pilŏ́ng te tar-ngứh tar-hơ, <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />táq te mít bui ŏ, a-rớq dyôn Yang ma tới dyôn ti-cuôi, <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />co chom ar-lớih cứp ti-cuôi, ntro ti-cuôi sol lớiq la tới sol, khán táq ar-náq ŏ mmo, ti-cuôi ngki lư ráp cống tớq te Yang.<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />Nha, án ndon sút, cóq táq a-rớq ngki ada ti-cuôi sol, ndóng lớiq táq ar-náq pa-rưt, co chom dyơ Án Sút la na nha-án la na i-nha chón át tớq pilŏ́ng, a-lứng ớq bôn callong lớiq li te Án.<verse eid="EPH 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />Talloiq lư, cóq táq dyôn cơt rêng tớq Yang, a-lứng tớq rêng chức sút te Án. <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />Cóq thuan dŏq máh crơng pla te Yang Arbang Pilŏ́ng, dŏq táq dyôn i-nha bôn ta-yứng khớm, chíl liêh ngê lớiq ŏ na yang sáq. <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />Co ar-náq tar-chíl na top he tới la par-ual a-lớng a-ham nha sac sáiq, ma la chíl liêh máh nốh sút, chíl liêh máh nốh chức, chíl liêh máh nốh lớiq ŏ tớq pang ngiau ndô, chíl liêh máh yang sáq át cứp ntúq tớq pilŏ́ng. <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />Co ar-náq ngki, cóq sứp cứp nốh crơng pla te Yang Arbang Pilŏ́ng, dŏq i-nha rap chíl liêh tớq i-ngái tar-chíl, a-lứng ta-yứng khớm ndóng vít khoiq dyơ te cứp nốh. <verse eid="EPH 6:13" /><verse number="14" style="v" sid="EPH 6:14" />Iki, cóq ta-yứng khớm, ndóng ki-tớn pa-eu ada i-nha na callong piaiq, ial sứp au taq na callong ti-nớng ŏ, <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />ta-sứp ada dyưng callong khoiq sŏ́ng te Par-nai iên ŏ na Yang, <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />cóq i-nha ial na callong tin tớq cứp callong, co ngki ma i-nha lư têq cu-pát cứp ta-ráh uih na ti-cuôi lớiq ŏ. <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />Cóq pưng muôc taq choi ta-mống nha pla dau Ar-vai, ma la par-nai na Yang Arbang Pilŏ́ng, <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />ndóng cớu seq cứp chư tớq Yang Ar-vai na cứp par-nai cớu a-lứng seq, nha bôn cu-lái tớq ndóng ayư liêh te nhéq tưh callong chiuq ta-nhir a-lớng callong cớu tang dyôn ada nhéq máh top tin, <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />a-lứng dyôn ada cư, dŏq par-nai tu-mống têq bôn dyôn ada cư, tớq ar-náq pốh ta-cang na cư te callong clŏ́q dŏq pau tông callong ca-tốq te Par-nai ŏ Yang <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />(co Par-nai ŏ Yang ngki ma cư cơt tam-peng ndon ngai ta-cáp tớq sic), dyôn têq chón ndóng ngki, cư têq clŏ́q pau ntêr veng a-rớq crái piaiq cư cóq taq-ntêr.<verse eid="EPH 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />Ma dŏq i-nha la têq chom máh ar-náq piaiq tớq nga cư, cư chón táq a-mớh, Ti-cha-cơ, án la em ai a-moih lư a-lứng táq ar-náq ti-nớng tu-pứng tớq Yang, lư dyôn i-nha chom cứp ar-náq, <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />án la ti-cuôi ndon cư khoiq yua tớq nga i-nha co ar-náq ndô, dŏq i-nha têq chom ar-náq te top he a-lứng mít i-nha bôn a-liam.<verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />Seq callong iên ŏ tớq nga i-nha, a-lứng te callong ar-moih nha callong tin te Yang Arbang Pilŏ́ng, A-ám a-lứng Yang, Yang Choi Ta-mống Yê-su. <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />Callong choi mat át a-lớng nhéq máh ti-cuôi a-moih Yang Choi Ta-mống Yê-su, Yang top he, cơt lớiq têq pít.<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>