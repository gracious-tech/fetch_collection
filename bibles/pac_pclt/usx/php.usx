  <book code="PHP" style="id">EN_PCLT pac_Pacoh_ltr Thu Apr 09 2026 09:33:50 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Philippians</para>
  <para style="toc1">Chớiq A-lang Phi-lip</para>
  <para style="toc2">Phi-lip</para>
  <para style="toc3">Php</para>
  <para style="mt">Phi-lip</para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />Phau-lô a-lứng Ti-mu-thê, ti-cuôi táq ar-náq na Yang Choi Ta-mống Yê-su, cơiq dyôn nhéq tưh ti-cuôi táq ar-náq na Yang Choi Ta-mống Yê-su, la máh ti-cuôi tin át tớq vel Phi-lip, mu nơi a-lứng máh ti-cuôi sút nha ti-cuôi tar-choi ar-náq. <verse eid="PHP 1:1" /><verse number="2" style="v" sid="PHP 1:2" />Seq callong choi mat a-lứng callong iên ŏ te Yang Arbang Pilŏ́ng, la A-ám nha Yang top he, la Yang Choi Ta-mống Yê-su, át tớq he.<verse eid="PHP 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />Cư si-ơn Yang Arbang Pilŏ́ng na cư tớq cứp chư par-ngíh níc te i-nha, <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />tớq cứp chư cớu seq na cư dyôn nhéq náq i-nha, ngki át cớu seq te mít sáng bui hơr <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />co te ar-náq khoiq sŏ́ng na i-nha tớq Par-nai ŏ Yang te tôm díh i-ngái ndô; <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />cư chom ar-lớih te máh ar-náq ndô, ngki Án ta-bớq táq ar-náq ŏ tớq i-nha dŏq táq cua dyôn i-ngái na Yang Choi Ta-mống Yê-su; <verse eid="PHP 1:6" /><verse number="7" style="v" sid="PHP 1:7" />ma ada cư, ar-lớih la callong crái lư dŏq par-ngíh iki te nhéq náq i-nha, co cư dŏq i-nha tớq mít can-nính cư, nhéq náq i-nha lư la máh ti-cuôi táq ar-náq a-lứng cư te callong choi mat, díh tớq ngai crál cư, nha te callong tar-tông choi a-lứng ca lư dyôn Par-nai ŏ Yang. <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />Co Yang Arbang Pilŏ́ng la Án ndon khoiq ca-lư te cư, i-mo cư át ng-cong nhéq náq i-nha na mít can-nính a-moih te Yang Choi Ta-mống Yê-su. <verse eid="PHP 1:8" /><verse number="9" style="v" sid="PHP 1:9" />A-lứng par-nai cư cớu seq ngki, la callong ar-moih te i-nha pớnh clưi clưai, dyôn pưt a-sớr pi-lư tớq callong tu-báiq a-lứng cứp callong chom, <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />dŏq i-nha têq chom rêh ngê mmo la ŏ lư, táq dyôn i-nha bôn práh ŏ a-lứng ớq callong tíq a-mớh ti-ngôi i-ngái tớq liêh na Yang Choi Ta-mống, <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />bôn pớnh máng callong na callong ti-nớng ŏ nhơ Yang Choi Ta-mống Yê-su, táq dyôn callong ang ưr nha callong cứh ayô Yang Arbang Pilŏ́ng.<verse eid="PHP 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />Em ai ơi, cư ính i-nha chom ar-lớih nốh a-mớh tớq nga cư lư khoiq cớt dyơ ndon co te callong chom a-ưi tớq Par-nai ŏ Yang. <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" />Tar-lúh, ngai crál tớq cŏq na cư táng Yang Choi Ta-mống khoiq cơt ar-lớih lư ndon nhéq náq top líng kiaq me dúng puô a-lứng cứp ti-cuôi can-nŏ́h, <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />a-lứng clứng i-nha, co át tôt na cư, i-nha bôn callong tin tớq Yang, cơt clŏ́q lư pau ntêr par-nai ŏ Yang ma lớiq sáng a-dáh. <verse eid="PHP 1:14" /><verse number="15" style="v" sid="PHP 1:15" />Ntro lư bôn ti-cuôi ca to ngê Yang Choi Ta-mống co i-ôiq a-lứng ính tar-miên, ma bôn ti-cuôi ca to lư ính ŏ, <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />la máh ti-cuôi co callong ar-moih, chom ar-lớih cư bôn mpual dŏq ôi chíl dyôn Par-nai ŏ Yang, <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />ma máh ti-cuôi co ính tar-miên, nha-án ca to par-nai Yang Choi Ta-mống cơt lớiq ti-nớng tu-pứng, par-ngíh táq dyôn a-rức ndóng át tôt na cư. <verse eid="PHP 1:17" /><verse number="18" style="v" sid="PHP 1:18" />Vít ngki i-mo? Ntro la car-na mmo — lớiq la lớiq ti-nớng ŏ a-láng ti-nớng ŏ — Yang Choi Ta-mống bôn ca to, a-lứng cư sáng bui te ar-náq ngki. Iki, cư lư táq dyôn bui êm, <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />co cư chom ar-lớih ar-náq ndô lư dông callong tar-choi tớq dyôn cư, nhơ callong cớu seq te i-nha a-lứng callong choi mat te Yang Ar-vai na Yang Choi Ta-mống Yê-su, <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />piaiq a-rớq callong tel-sél át pớn nha callong ng-cong na cư, ngki la cư lư lớiq táq dyôn a-chiêt te máh ar-náq a-mớh, ma clŏ́q tớq cứp ar-náq, dŏq hoi ndô lớiq la tớq i-ngái mmo, Yang Choi Ta-mống bôn ngai dyám náp tớq te cư, ntro tu-mống a-láng cu-chet. <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />Co ada cư, tu-mống la Yang Choi Ta-mống, a-lứng cu-chet la callong tar-náp lư. <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />Ma khán yôl tu-mống tớq sac sáiq, ma ada cư ngki la ar-náq bôn tar-náp dyôn táq, iki cư lớiq chom cư lư cóq rêh pa mmo. <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />Cư cơt táh pa-tot te bar pa, ndóng yôl par-ngíh ính cu-chet a-lứng át a-lứng Yang Choi Ta-mống, co ngki la callong ŏ lư tháng, <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />ma cư át liêh tớq sac sáiq la callong pưt dyôn i-nha. <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />Tư khoiq tin khớm callong ngki, cư chom ar-lớih cư lư át liêh a-lứng yôl át níc a-lứng nhéq náq i-nha, co callong pưt a-sớr nha callong bui hơr tớq callong tin na i-nha, <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />dŏq callong bui hơr na i-nha tớq Yang Choi Ta-mống Yê-su nhơ cư cơt pưt clưi te ar-náq cư tớq tar-múh i-nha mu chư loi. <verse eid="PHP 1:26" /><verse number="27" style="v" sid="PHP 1:27" />Nưm mui nốh i-nha cóq tu-mống dyôn lư piaiq tớq Par-nai ŏ Yang na Yang Choi Ta-mống, lư ntro ndóng cư tớq dŏq cláh clơ i-nha a-láng ndóng ớq bôn tớq, ngki cư têq chom te i-nha ngki i-nha khớm nha mui mít, a-lứng mui par-ngíh sŏ́ng ca-tóng táq co callong tin te Par-nai ŏ Yang, <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />a-lứng lớiq bôn máh ti-cuôi ính chíl táq dyôn a-dáh te máh nốh a-mớh. Ndô la tíc te callong cu-chet pít dyôn ada nha-án, ma te callong choi ta-mống na i-nha — a-lứng ar-náq ndô te Yang Arbang Pilŏ́ng. <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />Co lư Yang Choi Ta-mống, callong bún khoiq tốq ada i-nha tới nưm dŏq tin te Án, ma la dŏq chiuq a-rức co Án, <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" />Tư chiuq mu nơi callong diêiq a-rức ndon i-nha khoiq hôm te cư, a-lứng chón bôn sáng te cư.<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />Co iki, khán te Yang Choi Ta-mống bôn callong khêr mmo, khán bôn callong a-liam mmo co callong ar-moih, khán bôn mui mít mu nơi tớq Yang Ar-vai, khán bôn callong ar-moih a-lứng callong sruiq mmo, <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />cóq táq dyôn bui níc te cư, ngki la i-nha bôn mui mít, ndóng bôn callong ar-moih, sŏ́ng mu nơi tớq mít can-nính, par-ngíh te mui ar-náq. <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />Êq táq ar-náq a-mớh co ính niêng ta-niêng lớiq la co ính ngai ayô, ma lư, cóq a-siar cháq, dyôn ti-cuôi can-nŏ́h pưt hơn te i-nha, <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />i-nha êq par-ngíh ính suô tar-náp nưm i-nha sớng, ma cóq táq dyôn tar-náp ada máh ti-cuôi can-nŏ́h hơ. <verse eid="PHP 2:4" /><verse number="5" style="v" sid="PHP 2:5" />Cóq bôn mít par-ngíh a-rớq ngki tớq i-nha, mu chứng bôn mít par-ngíh tớq Yang Choi Ta-mống Yê-su,<verse eid="PHP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6" />la Án yôl níc mu chứng tháng Yang Arbang Pilŏ́ng,</para>
  <para style="q1" vid="PHP 2:6">khoiq lớiq bôn a-mớh par-tê lớng te chức</para>
  <para style="q1" vid="PHP 2:6">ndon li-arli a-lứng Yang Arbang Pilŏ́ng.<verse eid="PHP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7" />Ma lư, Án chóng táq dyôn án pít chức</para>
  <para style="q1" vid="PHP 2:7">ndóng cơt in a-rớq ti-cuôi sol,</para>
  <para style="q1" vid="PHP 2:7">bôn car-nian te ar-maiq mu chứng a-rớq thư ti-cuôi,</para>
  <para style="q1" vid="PHP 2:7">dyơ bôn hôm te ar-maiq dêu ar-mo a-rớq a-cái ti-cuôi,<verse eid="PHP 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PHP 2:8" />Án khoiq a-siar cháq bôm ndóng chiuq ta-nhir ti-ngôi cu-chet,</para>
  <para style="q1" vid="PHP 2:8">díh cu-chet tớq a-long calláng.<verse eid="PHP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9" />Co iki, Yang Arbang Pilŏ́ng lư dyôn Án cơt sút pưt lư</para>
  <para style="q1" vid="PHP 2:9">a-lứng dyôn Án nốh pưt clưi nhéq te can-nŏ́h,<verse eid="PHP 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10" />táq dyôn sáng tớq nốh Yang Yê-su,</para>
  <para style="q1" vid="PHP 2:10">cứp nốh tớq pilŏ́ng, mpiên cu-teq, tớq pưn cu-teq, cóq chóh tar-col,<verse eid="PHP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PHP 2:11" />a-lứng cứp náq ti-cuôi cóq ngin ar-lớih Yang Choi Ta-mống Yê-su la Yang,</para>
  <para style="q1" vid="PHP 2:11">a-lứng cứh ayô Yang Arbang Pilŏ́ng, la A-ám.<verse eid="PHP 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />Co iki, máh ti-cuôi a-moih lư na cư ơi, veng ngê a-rớq i-nha khoiq át cam-máng par-nai, tới nưm allám ndóng mpáh te cư, ma hoi ngki cang a-ưi hơn tớq lớiq mpáh cư, i-nha cóq táq níc ơn choi ta-mống te i-nha na callong dyám náp a-lứng a-dáh. <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />Co Yang Arbang Pilŏ́ng la Án táp choi dyôn i-nha dŏq par-ngíh ính par-ngíh táq veng ar-náq ŏ na Án. <verse eid="PHP 2:13" /><verse number="14" style="v" sid="PHP 2:14" />Cóq táq cứp ar-náq ma êq nhan-nha lớiq la tar-miên, <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />dŏq i-nha têq cơt máh ti-cuôi ớq callong tíq a-lứng práh ŏ te Yang Arbang Pilŏ́ng, ớq callong luaih co tớq pang ndô máng lới a-lứng ính lư veng ngê saq, ma tớq ngki i-nha ta-bal ang a-rớq máh uih chéh tớq cúc cu-teq ndô, <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />tư ca-dyiq khớm par-nai callong tu-mống, co callong bui hơr na cư tớq i-ngái na Yang Choi Ta-mống ngki cư lớiq ta-lúh te ar-náq ớq tar-náp, a-lứng lớiq tuh tál cơt lô lư. <verse eid="PHP 2:16" /><verse number="17" style="v" sid="PHP 2:17" />Ma díh ntro cư cóq tốq a-ham dŏq srôq tớq pan-nán a-lứng crơng mŏp sang na callong tin i-nha, cư sáng bui ơn, nha sŏ́ng bui a-lứng nhéq náq i-nha. <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />I-nha la mu chứng iki, cóq bui ơn nha sŏ́ng bui a-lứng cư.<verse eid="PHP 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />Tớq Yang, Yang Yê-su, cư ng-cong chái lư yua Ti-mu-thê tớq a-lang i-nha, dŏq cư têq bôn ơn ayô tư chom ar-náq te i-nha. <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />Co cư ớq bôn nnáu nnáng sŏ́ng mui mít a-rớq án, la ti-cuôi lư ti-nớng át par-ngíh máh ar-náq tar-náp dyôn ada i-nha, <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />co máh ti-cuôi can-nŏ́h át si-suô ar-náq tar-náp ndái, tới máh ar-náq tớq te Yang Choi Ta-mống Yê-su. <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />Ma i-nha chom ngê ti-nớng ŏ te án, co mu chứng a-rớq a-cái nha a-ám, án khoiq táq ar-náq dyôn Par-nai ŏ Yang mu nơi a-lứng cư. <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />Iki cư ng-cong yua án táp ndóng cư chom máh ar-náq na cư lư cơt i-mo. <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />Ma cư tin ar-lớih te Yang idô lư cư táp chái tớq a-lang i-nha. <verse eid="PHP 2:24" /><verse number="25" style="v" sid="PHP 2:25" />Ma, cư par-ngíh piaiq yua Ep-pa-prô-dit chô liêh nga i-nha, án la em ai i-nha a-lứng yớu táq ar-náq ngki sŏ́ng mu nơi na cư, la tam-peng te i-nha a-lứng la ti-cuôi tar-choi ndon ớq na cư, <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />co chom ar-lớih án tel-sél ng-cong bôn át a-lứng nhéq náq i-nha, nha sáng rớu ri co i-nha khoiq chom dyơ án a-ái. <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />Co lư án a-ái tar-mán cu-chet, ma Yang Arbang Pilŏ́ng khoiq sruiq án, ngki tới nưm án sớng, ma díh cư hơ, dŏq cư vít chiuq callong a-nguaq a-cán a-nguaq pi-lư. <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />Iki, cư hớp lư yua án pôq, dŏq ndóng tar-múh liêh án, i-nha têq sáng bui, dyơ cư mu biq ta-bơt a-nguaq. <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />Co iki, i-nha ráp chom án te Yang na nhéq callong bui hơr, ma i-nha cóq bôn mít dyám náp máh ti-cuôi a-rớq ngki, <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />la co ar-náq na Yang Choi Ta-mống án nnáng biq cu-chet, ndóng lớiq a-yáu tar-ngứh án dŏq têq tar-choi tang te ar-náq na i-nha dyôn ada cư.<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />Talloiq lư, ơi em ai na cư, cóq sáng bui níc tớq Yang. Ma ada cư, lớiq sáng a-leq a-mớh ndóng ta-ran liêh máh callong ndô dyôn i-nha, co callong tar-náp dyôn ada i-nha. <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />Cóq mmứng can-tóh a-cho, cóq mmứng máh ti-cuôi táq ar-náq saq, cóq mmứng rit kít táq náh nnan. <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />Co top he ráp rit kít lư — la máh ti-cuôi sang tám na Yang Ar-vai te Yang Arbang Pilŏ́ng, a-sớr cháq tớq Yang Choi Ta-mống Yê-su, nha lớiq ki-nứm te sac sáiq, <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />ntro cư lư bôn par-ngíh ki-nứm te sac sáiq. Khán ti-cuôi can-nŏ́h par-ngíh bôn ki-nứm te sac sáiq, cư yôl a-ưi lư loi: <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" />rit kít tớq i-ngái ti-col, ưlla ti-cuôi Isa-ra-el, te top Bên-ya-min, ti-cuôi Hê-brơ, a-cái na ti-cuôi Hê-brơ; te phep rit, ti-cuôi Pha-ra-si; <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" />te mít cư ính lư táq diêiq a-rức máh top tin; te callong ti-nớng tu-pứng veng phep rit ngki cơt ớq ntúq dŏq ính tíq. <verse eid="PHP 3:6" /><verse number="7" style="v" sid="PHP 3:7" />Ma, máh callong a-mớh ngki la tar-náp ada cư, co te Yang Choi Ta-mống, cư khoiq me ar-náq ngki la lúp mat. <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />Ma yôl ta-niêng ngki loi, cư lư hôm nhéq tưh la lúp mat co tar-náp hơn te can-nŏ́h na callong chom te Yang Choi Ta-mống Yê-su, Yang na cư, co Án ma cư khoiq chiuq pít nhéq tưh — lư, cư hôm máh nốh ngki a-rớq crơng a-nhoh — dyôn têq cư bôn Yang Choi Ta-mống <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />a-lứng khoiq bôn át tớq Án, tới co bôn callong ti-nớng tu-pứng tớq cháq bôm tớq phep rit ma la callong ti-nớng tu-pứng nhơ callong tin te Yang Choi Ta-mống — callong ti-nớng tu-pứng tớq te Yang Arbang Pilŏ́ng la co callong tin — <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />dŏq chom ar-lớih Án nha chức sút callong tu-mống liêh na Án a-lứng callong chúng tưi te máh nốh diêiq a-rức na Án, ndóng bôn tớq nga ntúq mu nơi a-lứng callong cu-chet na Án, <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />tam na car-na mmo, cư têq ng-cong tớq callong tu-mống liêh te cu-chet. <verse eid="PHP 3:11" /><verse number="12" style="v" sid="PHP 3:12" />Ngki tới la cư khoiq bôn nốh ngki, lớiq la khoiq ŏ cứp nốh dyơ, ma cư chón táq ca-tóng níc dyôn cư têq bôn nốh ndon co te ngki, cư lư khoiq Yang Choi Ta-mống Yê-su ial dyơ. <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />Em ai ơi, cư lớiq bôn tông te cư khoiq bôn mít iki. Ma cư át táq mui nốh: ndóng clớiq viang máh nốh khoiq vít ma ca-tóng a-bôn máh nốh chứng mát, <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />par-ngíh nga mui nốh, cư ca-tóng táq níc dyôn bôn cống te callong arô tớq pilŏ́ng na Yang Arbang Pilŏ́ng tớq Yang Choi Ta-mống Yê-su. <verse eid="PHP 3:14" /><verse number="15" style="v" sid="PHP 3:15" />Iki, nhéq máh ti-cuôi mmo khoiq dưnh cóq par-ngíh te ngê ngki, ma khán bôn ntúq mmo i-nha par-ngíh cơt ndái, Yang Arbang Pilŏ́ng lư a-páh callong ngki dyôn i-nha. <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />Ma, top he chom táq díh máh mmo ngki he táq díh máh ngki.<verse eid="PHP 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />Em ai ơi, cóq cơt máh ti-cuôi a-rớq cư, a-lứng cóq me máh ti-cuôi chón tu-mống táq ngôl ngki, veng a-rớq ngôl ndon i-nha hôm tớq top he. <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />Co bôn clứng ti-cuôi — la máh ti-cuôi ndon cư khoiq cơi ntêr ada i-nha, ma hoi ngki cư díh cóq nhiêm taq-ntêr — nha-án chón tu-mống a-rớq ti-cuôi par-ual a-long calláng na Yang Choi Ta-mống, <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />u-rớh máh ti-cuôi ngki lư cơt pít, yang na nha-án la pallúng, a-lứng ang ưr na nha-án át tớq ar-náq táq lư a-chiêt na nha-án, ngki la máh ti-cuôi par-ngíh nưm máh ar-náq tớq pang ndô. <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />Ma ti-cuôi prái na top he khoiq bôn tớq pilŏ́ng, ma tớq ntúq ngki top he tel-sél át ng-cong Án Choi Ta-mống, la Yang, ngki Yang Choi Ta-mống Yê-su, <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />la Án lư piên cơt cháq chớn dơ sớng na top he dyôn cơt mu chứng a-rớq cháq chớn ang ưr na Án, mu chứng a-rớq chón táq ar-náq te chức sút Án dŏq táq dyôn cứp nốh át ta-dưp án.<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />Khán iki, ơi em ai a-moih lư nha ayư níc na cư, callong bui hơr a-lứng a-rớq cống na cư, i-nha a-moih lư ơi, cóq át ta-yứng khớm a-rớq iki tớq Yang.<verse eid="PHP 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />Cư át khêr Ê-vô-di nha khêr Sin-ti-cơ têq sŏ́ng mui mít tớq Yang. <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />Lư ar-lớih idô, cư lư seq mái, ti-cuôi táq ar-náq ti-nớng ơi, mái cóq tar-choi top cán ngki, nha-án khoiq a-lứng cư car-tóng dyôn Par-nai ŏ Yang, mu nơi a-lứng Cơ-lê-man nha máh yớu táq ar-náq can-nŏ́h na cư, ndon nốh na nha-án át tớq pứng U-ráq Callong Tu-mống.<verse eid="PHP 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4" />Cóq át bui níc tớq Yang. Cư lư taq-ntêr níc, cóq bui can-chơl! <verse eid="PHP 4:4" /><verse number="5" style="v" sid="PHP 4:5" />Cóq dyôn cứp náq ti-cuôi chom mít can-nính khun na i-nha. Yang tar-mán dyơ. <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />Êq rớu ri nốh a-mớh, ma lư, tớq cứp ar-náq, na callong cớu seq a-lứng tar-seq tar-suông a-lứng callong si-ơn, cóq dŏq máh par-nai cớu seq na i-nha bôn a-tớq dyôn Yang Arbang Pilŏ́ng, <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />dyơ callong iên ŏ na Yang Arbang Pilŏ́ng, la callong ta-niêng te callong chom a-púh, lư át tớq mít can-nính i-nha a-lứng par-ngíh na i-nha tớq Yang Choi Ta-mống Yê-su.<verse eid="PHP 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8" />Talloiq lư, em ai ơi, khán callong mmo la lư piaiq, khán callong mmo piaiq dyám náp, khán callong mmo ti-nớng ŏ, khán callong mmo práh ŏ, khán callong mmo piaiq a-moih, khán callong mmo bôn láih par-nai ŏ, khán callong mmo ớq nnáu tíq a-lứng khán callong mmo piaiq ayô, i-nha cóq par-ngíh nga callong ngki. <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />Máh nốh i-nha khoiq dŏq rian, khoiq chom, khoiq sáng a-lứng khoiq hôm te cư, cóq táq máh ar-náq ngki, dyơ Yang Arbang Pilŏ́ng callong iên ŏ lư át a-lứng i-nha.<verse eid="PHP 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />Cư sáng bui hơr tớq Yang co hoi ngki talloiq lư i-nha yôl par-ngíh nga cư, ma lư, te ar-náq ndô, i-nha khoiq át par-ngíh, ma lớiq i-yốh têq choi. <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />Ngki tới la cư taq-ntêr te callong ính, co cư khoiq rian cóq pa-tot dyôn sáng bui ntro cư át tớq pang tu-mống i-mo. <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />Cư mbơiq chom ki-dit pi-nhaih, mbơiq chom bôn clưi clưai. Tớq cứp ar-náq nha tớq cứp pang tu-mống, cư khoiq chiuq rian díh ndóng bôn sái a-lứng ndóng chiuq pi-nhaih, díh ndóng bôn clưi clưai nha ndóng ớq bôn a-mớh. <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />Cư bôn rêng dŏq táq cứp ar-náq nhơ Án táq dyôn cư práih bánh. <verse eid="PHP 4:13" /><verse number="14" style="v" sid="PHP 4:14" />Ma, i-nha khoiq táq ŏ ndóng mu nơi tar-choi diêiq a-rức na cư. <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />Ơi em ai vel Phi-lip, i-nha khoiq chom dyơ te tôm lư na Par-nai ŏ Yang, ndóng cư ngốh te Ma-sa-dôn, ớq bôn top tin mmo tar-choi a-lứng cư tớq ar-náq choi práq, nưm mu náq i-nha, <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" />co i-ngái tớq Tê-salô-ni-ca, i-nha khoiq mui bar can-tứq cơiq crơng crớu tar-náp dyôn cư. <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />Ngki tới la cư ng-cong suô crơng-crớu, ma cư ng-cong suô cu-lái dyôn pớnh clưi clưai dŏq bôn tar-náp ada i-nha. <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />Cư chón bôn cứp nốh a-lứng clưi clưai. Cư khoiq bôn cứp nhéq, ndóng ráp te Ep-pa-prô-dit máh crơng tớq te i-nha, crơng thum, crơng mŏp sang khoiq ráp, ar-náq bui can-nính Yang Arbang Pilŏ́ng. <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />Yang Arbang Pilŏ́ng na cư la súc bôn lư cứp nốh cóq bôn na i-nha veng callong súc bôn na Án te callong ang ưr tớq Yang Choi Ta-mống Yê-su. <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />Callong ang ưr ưlla na Yang Arbang Pilŏ́ng, A-ám top he, ti-ngôi díh sút pang lang dơi. A-men.<verse eid="PHP 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />Seq cơiq par-nai car-bánh cứp náq top tin tớq Yang Choi Ta-mống Yê-su. Máh em ai át a-lứng cư cơiq par-nai car-bánh i-nha. <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />Nhéq náq ti-cuôi tin cơiq par-nai car-bánh i-nha, ma pưt lư la máh ti-cuôi ưlla dúng Sê-sa.<verse eid="PHP 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23" />Seq callong choi mat te Yang, Yang Choi Ta-mống Yê-su át tớq mít can-nính i-nha. A-men.<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>