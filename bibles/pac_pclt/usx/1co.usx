  <book code="1CO" style="id">EN_PCLT pac_Pacoh_ltr Thu Apr 09 2026 09:31:43 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">1 Corinthians</para>
  <para style="toc1">Chớiq A-lang Cô-rin-tô Mui</para>
  <para style="toc2">Cô-rin-tô Mui</para>
  <para style="toc3">1Co</para>
  <para style="mt">Cô-rin-tô Mui</para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />Phau-lô, bôn rêh arô cơt dyưng ati na Yang Choi Ta-mống Yê-su co can-nính na Yang Arbang Pilŏ́ng, a-lứng ndon em ai Sôt-then, <verse eid="1CO 1:1" /><verse number="2" style="v" sid="1CO 1:2" />cơiq dyôn ti-cuôi tin na Yang Arbang Pilŏ́ng át tớq Cô-rin-tô, la máh ti-cuôi khoiq cơt práh ŏ tớq Yang Choi Ta-mống Yê-su, máh ti-cuôi tin bôn rêh arô, mu nơi a-lứng cứp ti-cuôi át chuôp ntúq arô nốh Yang top he, Yang Choi Ta-mống Yê-su, na nha-án nha na top he. <verse eid="1CO 1:2" /><verse number="3" style="v" sid="1CO 1:3" />Callong choi mat nha callong iên ŏ te Yang Arbang Pilŏ́ng, A-ám top he, a-lứng te Yang, Yang Choi Ta-mống Yê-su, át a-lứng i-nha.<verse eid="1CO 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />Cư lư si-ơn Yang Arbang Pilŏ́ng na cư te i-nha co te callong choi mat na Án, la nốh khoiq bôn dyôn ada i-nha tớq Yang Choi Ta-mống Yê-su. <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />Co te cứp callong i-nha khoiq têq táq dyôn súc bôn tớq Án, te máh par-nai taq-ntêr a-lứng cứp callong chom ngki, <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />a-rớq par-nai ntêr te Yang Choi Ta-mống khoiq bôn ráp cơt khớm lư tớq top i-nha, <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />tar-lúh i-nha lớiq ớq te mui nốh ŏ mmo, khán nhéq mít can-nính pớn níc callong a-páh na Yang top he, Yang Choi Ta-mống Yê-su, <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />la Án lư táq ada i-nha dyôn khớm ti-ngôi díh talloiq tháng, dyôn ớq bôn callong tíq tớq i-ngái na Yang top he, Yang Choi Ta-mống Yê-su. <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />Yang Arbang Pilŏ́ng la lư ti-nớng, co Án ma i-nha khoiq bôn rêh arô dyôn cơt mui mít a-lớng A-cái na Án, Yang Choi Ta-mống Yê-su, Yang top he. <verse eid="1CO 1:9" /><verse number="10" style="v" sid="1CO 1:10" />Ma, em ai ơi, cư ính pa-táp i-nha co nốh na Yang top he, Yang Choi Ta-mống Yê-su, dyơ nhéq máh i-nha cóq cơt mui cang, a-lứng êq táq dyôn cơt par-yáh te i-nha ma i-nha cóq bôn mui mít cơt mui par-ngíh a-lứng cơt mui ngê sớng. <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />Co, ơi em ai na cư, co ti-cuôi mu dúng na Clô-ê, ar-náq te i-nha khoiq bôn ntêr ar-lớih ada cư, dyơ bôn ính par-yáh cơt mmar top tar-tuôq i-nha. <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" />Cư par-ngíh la idô, ngki la mu náq ti-cuôi te i-nha tông idô: “Cư ính veng Phau-lô,” lớiq la “Cư ính veng A-blô,” lớiq la “Cư ính veng Sê-pha,” lớiq la “Cư ính veng Yang Choi Ta-mống.” <verse eid="1CO 1:12" /><verse number="13" style="v" sid="1CO 1:13" />Yang Choi Ta-mống khoiq cơt a-rớq par-yáh? Dêu ar-mo Phau-lô khoiq ngai téh tớq a-long calláng cu-chet tang i-nha? A-láng i-nha táq tíc na dơq nhơ nốh Phau-lô? <verse eid="1CO 1:13" /><verse number="14" style="v" sid="1CO 1:14" />Cư si-ơn Yang Arbang Pilŏ́ng co cư khoiq lớiq táq tíc na dơq ada nnáu top i-nha, nưm Crit-bu nha Cai-ut, <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />dŏq ớq ti-cuôi mmo têq tông idô i-nha khoiq nhơ nốh cư ráp tíc na dơq. <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" />(Cư lư khoiq táq tíc na dơq dyôn dúng Sê-pha-na. Cu-luai ngki, cư lớiq chom cư vi tưi khoiq táq tíc na dơq dyôn ti-cuôi can-nŏ́h.) <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />Co Yang Choi Ta-mống khoiq lớiq yua cư pôq táq tíc na dơq, ma la ca to Par-nai ŏ Yang — ma tớiq na par-nai ntêr tu-báiq, táq dyôn a-long calláng na Yang Choi Ta-mống lớiq par-ngíh táq lô mát sớng.<verse eid="1CO 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />Co ar-náq te a-long calláng ngki la callong a-chơ lư dyôn ada máh ti-cuôi lớiq tin, ma dyôn ada top he, máh ti-cuôi bôn choi ta-mống, ngki la chức si-leh na Yang Arbang Pilŏ́ng. <verse eid="1CO 1:18" /><verse number="19" style="v" sid="1CO 1:19" />Co bôn par-nai ta-ran:</para>
  <para style="q1" vid="1CO 1:19">“Cư lư pu-pít callong tu-báiq na máh ti-cuôi tu-báiq;</para>
  <para style="q1" vid="1CO 1:19">nha cư lư táq lớiq tar-náp callong chom na top ti-cuôi rian a-ưi.”<verse eid="1CO 1:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="1CO 1:20" />Ti-cuôi tu-báiq tu-mo? Ndon rian a-ưi tu-mo? Ti-cuôi hôi taq-ntêr par-nai te pang ndô tu-mo? Lư lớiq Yang Arbang Pilŏ́ng khoiq pu-pít callong tu-báiq te pang ndô cơt callong a-chơ dyơ a-láng lớiq? <verse eid="1CO 1:20" /><verse number="21" style="v" sid="1CO 1:21" />Co khoiq chom dyơ te callong tu-báiq na Yang Arbang Pilŏ́ng, ti-cuôi pang ndô khoiq lớiq chom a-cớl Yang Arbang Pilŏ́ng na callong tu-báiq ngki, Yang Arbang Pilŏ́ng khoiq sáng bui, co callong ca to a-chơ a-ơu, dŏq choi ta-mống máh ti-cuôi tin. <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />Co te ti-cuôi Isa-ra-el ngki seq tíc si-leh, ma ti-cuôi Créc ngki báq si-suô callong tu-báiq. <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />Ma top he nưm ca to ngê Yang Choi Ta-mống ndon ngai téh tớq a-long calláng, lư a-rớq cúc búl ki-dúh dyưng dyôn ada ti-cuôi Isa-ra-el, ma la callong a-chơ lư dyôn ada tới ti-cuôi Isa-ra-el <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />Ma, dyôn ada nha-án, la máh ti-cuôi khoiq rêh arô, díh ti-cuôi Isa-ra-el nha ti-cuôi Créc, Yang Choi Ta-mống lư bôn chức na Yang Arbang Pilŏ́ng nha callong tu-báiq na Yang Arbang Pilŏ́ng. <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />Co callong a-chơ na Yang Arbang Pilŏ́ng lư tu-báiq clưi te thư ti-cuôi, a-lứng callong iêuq na Yang Arbang Pilŏ́ng bánh clưi te thư ti-cuôi.<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />Em ai ơi, callong lư la i-nha ti-tuaiq callong rêh arô na i-nha, hôm ar-lớih lớiq a-ưi ti-cuôi tu-báiq veng ngê bôm, lớiq a-ưi ti-cuôi sút, lư lớiq a-ưi ti-cuôi súc te tŏ́ng toiq. <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />Ma Yang Arbang Pilŏ́ng khoiq rêh máh ti-cuôi a-chơ te pang ndô dŏq Án têq táq dyôn top ti-cuôi tu-báiq sáng a-chiêt, Yang Arbang Pilŏ́ng khoiq rêh máh ti-cuôi ớq rêng tớq pang ndô dŏq Án têq táq dyôn top ti-cuôi bánh rêng sáng a-chiêt, <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />a-lứng Yang Arbang Pilŏ́ng khoiq rêh máh ti-cuôi ngáq sớng, a-lứng máh nốh ndon ngai ayê tớq pang ndô, máh ar-náq lớiq bôn, dŏq Án táq dyôn máh ar-náq bôn cơt ớq lớng, <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />co iki cứp náq ti-cuôi lớiq têq cu-hống a-mớh chứng mát Yang Arbang Pilŏ́ng. <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />Ma co Án, i-nha át tớq Yang Choi Ta-mống Yê-su, la Án bôn cơt callong tu-báiq tớq te Yang Arbang Pilŏ́ng, a-lứng la callong ti-nớng tu-pứng, díh callong práh ŏ a-lứng callong choi ta-mống dyôn ada top he, <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />co iki, a-rớq bôn par-nai ta-ran: “Nnáu cu-hống án, cóq cu-hống án tớq Yang.”<verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />Em ai ơi, ndóng tớq nga i-nha, cư lư khoiq lớiq tớq te callong a-cám na par-nai sru a-láng na callong tu-báiq, ndóng ca to ada i-nha par-nai ca-tốq te Yang Arbang Pilŏ́ng. <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />Co át mu nơi a-lứng i-nha cư khoiq a-nát lớiq chom a-mớh nưm Yang Choi Ta-mống Yê-su a-lứng Án khoiq ngai téh tớq a-long calláng. <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" />Cư lư khoiq át a-lớng i-nha te callong iêuq thor, te callong a-dáh a-lứng ca-dyír lư. <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />Par-nai tông na cư nha callong ca to na cư tới na máh par-nai pốh tông êm ŏ na hôi tu-báiq, ma lư la callong a-páh na Yang Ar-vai a-lứng chức sút, <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />dŏq callong tin i-nha lớiq át te callong tu-báiq na ti-cuôi, ma la te chức sút na Yang Arbang Pilŏ́ng.<verse eid="1CO 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />Ma te máh ti-cuôi sa-sai, top he ca to callong tu-báiq, ma tới callong tu-báiq na pang ndô, lư tới la na máh ti-cuôi sút pang ndô, la máh ti-cuôi cơt pít nhéq. <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />Ma lư ngki, top he ca to callong tu-báiq na Yang Arbang Pilŏ́ng te callong si-leh, la par-nai cơi bôn ca-tốq ma Yang Arbang Pilŏ́ng khoiq dŏq a-nát te nsuôi i-yốh teng cruông cu-teq dyôn callong ang ưr na top he, <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />la par-nai ma lớiq bôn nnáu te máh ti-cuôi sút na pang ndô têq chom, ma khán nha-án chom ngki lư ar-lớih nha-án khoiq lớiq téh Yang ang ưr tớq a-long calláng. <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />Ma, a-rớq bôn par-nai ta-ran:</para>
  <para style="q1" vid="1CO 2:9">“Callong ndon mát i-yốh hôm,</para>
  <para style="q1" vid="1CO 2:9">cu-tor i-yốh sáng,</para>
  <para style="q1" vid="1CO 2:9">a-lứng i-yốh bôn tớq mít ti-cuôi,</para>
  <para style="q1" vid="1CO 2:9">la máh callong ndon Yang Arbang Pilŏ́ng khoiq thuan dŏq dyơ dyôn máh ti-cuôi a-moih Án.”<verse eid="1CO 2:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10" />Co Yang Arbang Pilŏ́ng khoiq a-páh dyôn top he te Ar-vai. Co Ar-vai khoiq chom cứp ar-náq, díh máh par-nai sru te Yang Arbang Pilŏ́ng. <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />Co nnáu te top thư ti-cuôi chom dyơ máh nốh te mu náq ti-cuôi, khán tới la can-nính na ti-cuôi ngki tớq mít án? Mu chứng a-rớq iki, ớq nnáu têq chom máh nốh na Yang Arbang Pilŏ́ng, nưm Ar-vai na Yang Arbang Pilŏ́ng. <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />Ma top he khoiq lớiq ráp ar-vai na pang ndô, ma la Ar-vai tớq te Yang Arbang Pilŏ́ng, dŏq top he têq chom máh nốh khoiq choi mat sớng co Yang Arbang Pilŏ́ng dyôn top he, <verse eid="1CO 2:12" /><verse number="13" style="v" sid="1CO 2:13" />mu chứng la máh par-nai ma top he ca to, lớiq bôn na callong ca to na máh par-nai tu-báiq te ti-cuôi, ma la na callong ca to na Ar-vai, ndóng taq-ntêr máh nốh na Ar-vai co máh par-nai te ar-vai. <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />Máh ti-cuôi lớiq tin Yang ngki ớq bôn ráp máh nốh te Ar-vai na Yang Arbang Pilŏ́ng, co nha-án la a-chơ lư dyôn ada ti-cuôi ngki, a-lứng ti-cuôi ngki lớiq têq chom a-mớh co nha-án cóq bôn ngai ti-tuaiq a-rớq ti-cuôi bôn ar-vai yang át. <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />Ma ti-cuôi bôn ar-vai Yang át chom ti-tuaiq cứp ar-náq, ma lư án lớiq bôn nnáu têq ti-tuaiq.<verse eid="1CO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CO 2:16" />“Co nnáu têq chom par-ngíh na Yang — nnáu lư ca to Án?”</para>
  <para style="m" vid="1CO 2:16">Ma top he ngki bôn par-ngíh na Yang Choi Ta-mống.<verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />Em ai ơi, cư lư lớiq têq taq-ntêr ada i-nha a-rớq máh ti-cuôi bôn ar-vai Yang át, ma la a-rớq ti-cuôi yôl veng can-nính bôm, a-rớq ngai a-cái mbơiq car-nian tớq Yang Choi Ta-mống. <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" />Cư khoiq dyôn i-nha ngoiq dơq tóh ma tới crơng cha callám, co i-nha i-yốh têq. Lư ar-lớih, díh hoi ndô, i-nha lư i-yốh têq. <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />Co i-nha yôl ial ngê sac sáiq. Co te top i-nha, la ntúq bôn callong i-ôiq cu-míq, a-lứng tar-píh, ngki tới cóq i-nha yôl veng ngê sac sáiq, nha tớc cha a-rớq ti-cuôi pang ndô? <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" />Co ndóng ti-cuôi ndô tông: “Cư ính veng Phau-lô,” ma ti-cuôi can-nŏ́h: “Cư ính veng A-blô,” ngki tới i-nha la ti-cuôi pang ndô? <verse eid="1CO 3:4" /><verse number="5" style="v" sid="1CO 3:5" />Iki, A-blô la nnáu? Ma Phau-lô la nnáu? La máh ti-cuôi táq ar-náq, ma i-nha bôn callong tin na nha-án, veng a-rớq Yang khoiq dŏq dyôn cứp náq ti-cuôi. <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" />Cư khoiq chóh, A-blô khoiq srôq, ma Yang Arbang Pilŏ́ng táq dyôn dáh callong ngki. <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />Iki, tới ti-cuôi chóh, lư tới ti-cuôi srôq la a-mớh lớng, ma Án táq dyôn pưt a-sớr la Yang Arbang Pilŏ́ng. <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />Ma ti-cuôi chóh a-lứng ti-cuôi srôq la mui, ma bar náq ngki lư bôn ráp práq cống án veng liêh máh ar-náq na nha-án. <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />Co top he la máh ti-cuôi táq ar-náq dyôn Yang Arbang Pilŏ́ng. I-nha la nương na Yang Arbang Pilŏ́ng, láng dúng na Yang Arbang Pilŏ́ng.<verse eid="1CO 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 3:10" />Mmar callong choi mat te Yang Arbang Pilŏ́ng khoiq dyôn ada cư, cư khoiq táq cơt a-rớq mu náq ti-cuôi thơq chom táq dúng, dyơ ti-cuôi can-nŏ́h táq ada dyơ dúng ngki, ma cứp náq ti-cuôi cóq mmứng te ar-náq án táq dúng ngki. <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />Co lớiq bôn nnáu têq táq mui ta-nang can-nŏ́h te ta-nang khoiq táq, ma ngki la Yang Choi Ta-mống Yê-su. <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />Iki, khán ti-cuôi mmo táq tớq ta-nang ngki na dyeng, práq, búl dát, a-long, sác ráng, ndyŏq sro, <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />ar-náq na cứp náq ti-cuôi táq lư cơt ar-lớih ar-lêng, co i-ngái ngki lư mpáh, co ar-náq ngki cơt mpáh tớq uih; a-lứng lư uih lư thứq liêh ar-náq na cứp náq ti-cuôi bôn tớq crơng a-mớh. <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />Khán ar-náq na nnáu ma yôl níc, ngki la ar-náq ma ti-cuôi ngki khoiq man, ti-cuôi ngki lư bôn ráp cống tar-náp. <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />Ma khán ar-náq na nnáu cơt ng-cat, ti-cuôi ngki lư ráp ar-lóh, ma cháq án yôl bôn choi ta-mống, ma mu chứng a-rớq na uih.<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />I-nha lớiq chom dyơ i-nha la dúng sang na Yang Arbang Pilŏ́ng a-lứng Ar-vai Yang Arbang Pilŏ́ng tu-mống tớq i-nha? <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />Khán ti-cuôi mmo ta-lóh dúng sang na Yang Arbang Pilŏ́ng, Yang Arbang Pilŏ́ng lư pu-pít ti-cuôi ngki. Co dúng sang na Yang Arbang Pilŏ́ng la práh ŏ, ma dúng sang ngki la i-nha.<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />Êq nnáu chóng pi-lốh án. Khán ti-cuôi mmo te i-nha bôn par-ngíh la tu-báiq tớq pang ndô, ti-cuôi ngki cơt a-rớq ti-cuôi a-chơ dŏq dyôn têq bôn cơt ngê tu-báiq. <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />Co callong tu-báiq na ti-cuôi pang ndô la callong a-chơ lư chứng mát Yang Arbang Pilŏ́ng. Co bôn par-nai ta-ran:</para>
  <para style="q1" vid="1CO 3:19">“Án cŏp máh ti-cuôi tu-báiq te ngê tar-lop na nha-án.”<verse eid="1CO 3:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="1CO 3:20" />A-lứng lư:</para>
  <para style="q1" vid="1CO 3:20">“Yang chom máh par-ngíh na máh ti-cuôi tu-báiq; dyơ nha-án lư lớiq tar-náp.”<verse eid="1CO 3:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="1CO 3:21" />Co iki, êq nnáu cu-hống te thư ti-cuôi! Co cứp nốh lư na i-nha, <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />ntro la Phau-lô, a-láng A-blô, a-láng Sê-pha, ntro la cúc cu-teq, lớiq la callong tu-mống, a-láng callong cu-chet, lớiq la ar-náq khoiq bôn, a-láng ar-náq ính tớq. Nhéq tưh lư ưlla na i-nha, <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />ma i-nha ưlla na Yang Choi Ta-mống nhéq, a-lứng Yang Choi Ta-mống ưlla na Yang Arbang Pilŏ́ng.<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />Co te ngki, cứp náq ti-cuôi cóq me top he a-rớq máh ti-cuôi táq ar-náq na Yang Choi Ta-mống nha máh ti-cuôi kiaq me máh callong ca-tốq na Yang Arbang Pilŏ́ng. <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />Ma ar-náq tớq ndô, ngki la nốh cóq bôn te máh ti-cuôi kiaq me táq i-mo dyôn cứp náq ti-cuôi têq hôm la ti-nớng. <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />Ma ar-náq ndô la ar-náq két lư ada cư, ntro lư cư tar-múh callong sưq te i-nha lớiq la tar-sưq te ti-cuôi. Ma ndái, cư lư lớiq bôn chóng sưq te cư bôm. <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />Co cư hôm ar-lớih ớq bôn ar-náq a-mớh têq táq liêh cư, ma cư lớiq têq tông ti-nớng tu-pứng co ar-náq ngki; ma Yang la Án ndon sưq cư. <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />Iki, êq tar-sưq callong a-mớh nsuôi i-ngái a-nát, la díh ndóng Yang tớq, la Án ndon lư a-páh máh ar-náq clôp te callong ngiau nga callong ang, a-lứng lư mpáh máh ngê te mít. Dyơ tớq ndóng ngki, callong cứh ayô te Yang Arbang Pilŏ́ng lư tớq ada cứp ti-cuôi.<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />Em ai ơi, cư khoiq táq veng máh par-nai ndô dyôn ada cư nha A-blô co tar-náp na i-nha, dŏq na top he, i-nha têq rian par-nai ndô:</para>
  <para style="q1" vid="1CO 4:6">“Êq ti-lớt par-nai dŏq ta-ran,”</para>
  <para style="m" vid="1CO 4:6">dyôn têq lớiq mu náq mmo a-sớr cháq cu-hống te nốh ti-cuôi ndô chíl liêh ti-cuôi ntíh. <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />Co nnáu chuôq rúc i-nha par-táh tar-tuôq? Ma, nốh a-mớh i-nha chón bôn ndon i-nha khoiq ớq bôn ráp? Ma khán i-nha khoiq ráp, ngki i-mo i-nha cu-hống a-rớq ớq bôn ráp? <verse eid="1CO 4:7" /><verse number="8" style="v" sid="1CO 4:8" />I-nha ngki khoiq bui can-nính dyơ! I-nha khoiq bôn cứp nốh dyơ! I-nha khoiq cơt sút ma lớiq ính top he, a-lứng cư ính i-nha lư cơt sút, dŏq top he ngki têq cơt sút mu nơi a-lớng i-nha. <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />Co cư par-ngíh Yang Arbang Pilŏ́ng khoiq dông top he dyôn cơt dyưng ati talloiq tháng, a-rớq máh ti-cuôi ndon bôn luaih. Co top he khoiq cơt ngai ayê tar-ac dyôn cúc cu-teq ndô — díh dyôn tar-neng yang nha dyôn thư ti-cuôi. <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />Top he la a-rớq a-chơ co tin Yang Choi Ta-mống, ma i-nha ngki tu-báiq te Yang Choi Ta-mống. Top he iêuq thor, ma i-nha cơt rêng. I-nha bôn dyám náp, ma top he ngki ngai ayê. <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />Ti-ngôi díh hoi ndô, top he yôl chiuq pi-nhaih, chiuq hál, yôl tớc tam-pớc a-róh, a-lứng ngai púh tính ráh a-riaq lư, a-lứng ớq bôn dúng át iên ŏ, <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" />a-lứng túh tál diêiq a-rức, táq ar-náq na lư ati top he, tớq dyơ ngai pi-ốh, top he cớu callong bún; dyơ ndóng ngai táq, top he chiuq ta-nhir; <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />ndóng ngai ton a-pít, top he ôi par-nai alham. Top he cơt a-rớq máh nốh prớq na pang ndô, khoiq táh na cứp crơng, ti-ngôi díh hoi ndô.<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />Cư lớiq ta-ran máh par-nai ndô dŏq táq a-chiêt i-nha, ma cư ca to i-nha a-rớq a-cái par-láng na cư. <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />Co ntro i-nha bôn nsếq ngin ti-cuôi ca to te ngê Yang Choi Ta-mống, ngki yôl ớq bôn a-ưi a-ám; Co cư khoiq ca-nian i-nha tớq Yang Choi Ta-mống Yê-su nhơ Par-nai ŏ Yang. <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" />Iki, cư seq pa-táp i-nha cóq cơt máh ti-cuôi soi a-rớq cư. <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />Co te ar-náq ndô cư yua Ti-mu-thê pôq, ngki la a-cái ndon par-láng a-lứng ti-nớng tu-pứng na cư te Yang, tớq nga i-nha. Án lư ca-tớih i-nha te máh ngê na cư te Yang Choi Ta-mống Yê-su, a-rớq cư ca to tớq cứp top tin chuôp ntúq. <verse eid="1CO 4:17" /><verse number="18" style="v" sid="1CO 4:18" />Ma lư, a-rớq ngki co cư ớq pôq nga i-nha, bôn máh ti-cuôi khoiq án a-sớr cháq. <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />Ma cư lư cláih tớq nga i-nha, khán Yang ính, a-lứng cư lư chom tới a-rớq par-nai taq-ntêr na máh ti-cuôi a-sớr cháq ntíh, ma la chức na nha-án. <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />Co cruông na Yang Arbang Pilŏ́ng tới te par-nai taq-ntêr, ma la te chức sút. <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />I-nha ính a-mớh? Cư cóq tớq nga i-nha dông tar-cál, a-láng dông callong ar-moih a-lứng mít lam-bŏt?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />Ar-náq ndon pưt bôn sáng te top i-nha la mui ar-náq láh par-lưi, a-lứng ar-náq láh par-lưi ngki la callong lư ớq bôn te top máh ti-cuôi tới Isa-ra-el — tar-lúh díh mu náq ti-cuôi ngki ial cam-pái na a-ám án. <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />Ma i-nha ngki yôl a-sớr cháq, i-mo ma lớiq sáng a-nguaq a-mớh, dyôn ada ti-cuôi khoiq táq ar-náq ngki piaiq lư cóq chuih a-ngốh viang te top i-nha. <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />Co cư, ntro lư át yông te sac sáiq ma lớiq bôn yông tớq mít can-nính, khoiq tar-sưq ti-cuôi táq luaih ngki dyơ, a-rớq chón bôn át tớq ngki. <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />Tớq nốh Yang top he, Yang Choi Ta-mống Yê-su, ndóng i-nha khoiq bôn rum liêh mu nơi, mu chứng mít can-nính na cư, a-lứng chức sút na Yang top he, Yang Yê-su, <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />dŏq mŏp ti-cuôi ngki ada Yang sáq táq ta-lóh cháq, i-mo dyôn ar-vai ti-cuôi ngki têq bôn tu-mống tớq i-ngái na Yang. <verse eid="1CO 5:5" /><verse number="6" style="v" sid="1CO 5:6" />Callong cu-hống na i-nha lớiq ŏ a-mớh. I-nha lớiq chom i-mo mu biq bôt pôih táq nhéq bôt cơt pôih? <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />Cóq táq práh bôt pôih tiêq, dŏq i-nha têq cơt bôt tam-me, a-rớq i-nha la beng lớiq bôn bôt pôih. Co Yang Choi Ta-mống, cưu a-cái Cha Ayư I-ngái Ngốh na top he, a-lứng khoiq bôn ngai kiac sang. <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />Iki, top he cóq cha ayư, ma tới te bôt pôih tiêq, lư tới la te bôt pôih ndon lới a-lứng ngê lớiq ŏ, ma la te beng lớiq bôn bôt pôih na callong lư ti-nớng nha ngê piaiq.<verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />Te chớiq a-lang, cư khoiq ta-ran dyôn i-nha ngki êq ar-toi a-lớng top láh par-lưi — <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />ma tới máh ti-cuôi láh par-lưi na pang ndô, a-láng máh ti-cuôi ham crơng a-lứng par-lốh, lớiq la máh ti-cuôi sang rup, co a-rớq iki, i-nha cóq ngốh vít te pang ndô. <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />Ma hoi ngki cư khoiq ta-ran dyôn i-nha êq ar-toi nnáng ntro a-lứng ti-cuôi mmo bôn ngai dŏq la em ai ma la ti-cuôi láh par-lưi, ham crơng, sang rup, cơi u-saq, bol plêc, lớiq la par-lốh, êq díh ti-cu cha mu nơi a-lứng ti-cuôi a-rớq ngki. <verse eid="1CO 5:11" /><verse number="12" style="v" sid="1CO 5:12" />Co tar-sưq máh ti-cuôi i-yốh tin tới la ar-náq na cư? I-nha lớiq tar-sưq máh ti-cuôi tớq top tin? <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />Ma Yang Arbang Pilŏ́ng lư sưq máh ti-cuôi i-yốh tin ngki.</para>
  <para style="q1" vid="1CO 5:13">“Cóq táh ar-náq lớiq ŏ dyôn vít te top i-nha.”<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />Khán bôn ar-náq tar-miên a-lứng ti-cuôi can-nŏ́h, nnáu tớq i-nha dáh dŏq tar-sưq chứng mát máh ti-cuôi lớiq ti-nớng tu-pứng, ma tới chứng mát máh top tin? <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />A-láng i-nha lớiq chom ngki máh top tin lư sưq ti-cuôi pang ndô? A-lứng khán ti-cuôi pang ndô lư khoiq ngai sưq co i-nha, i-nha lớiq rap par-chen te máh ar-náq tar-cauq ndon két lư ndô? <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />I-nha lớiq chom dyơ top he lư sưq máh tar-neng Yang? I-mo loi máh ar-náq tớq pang ndô? <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />Iki, ntro i-nha bôn máh ar-náq tar-cauq na tớq pang ndô, co i-mo i-nha dyôn máh ti-cuôi ngki ti-cu tar-sưq, la máh ti-cuôi ngai me ớq bôn tar-náp a-mớh tớq top tin? <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />Cư chón tông te ar-náq ndon a-chiêt na i-nha. Iki, dêu ar-mo lớiq bôn ti-cuôi tu-báiq mmo te i-nha, la ti-cuôi ndon têq par-chen tớq top i-nha bôm? <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />Ma, i-nha ndô cơt ính tar-sưq táq liêh em ai ntíh, a-lứng ar-náq ngki chứng mát máh ti-cuôi i-yốh tin? <verse eid="1CO 6:6" /><verse number="7" style="v" sid="1CO 6:7" />Co iki, te ar-náq ndô ar-lớih lư la khoiq ar-lóh nhéq lớng dyôn ada i-nha dyơ, co i-nha bôn máh ar-náq tar-cauq te top i-nha bôm. Co i-mo lớiq rap chiuq lúp? Co i-mo lớiq rap chiuq pi-lốh? <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />Ma, i-nha táq lớiq crái a-lứng tar-lop, dyơ táq iki ada em ai bôm! <verse eid="1CO 6:8" /><verse number="9" style="v" sid="1CO 6:9" />A-láng i-nha lớiq chom dyơ ti-cuôi lớiq ti-nớng tu-pứng lư ớq bôn ráp cruông na Yang Arbang Pilŏ́ng? Êq dyôn ngai pi-lốh; te ti-cuôi láh par-lưi, ti-cuôi sang rup, ti-cuôi táiq cháq, ti-cuôi báq cha-chôr, ti-cuôi ính tar-tuôq, <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />ti-cuôi ti-tôiq, ti-cuôi ham crơng, ti-cuôi bol plêc, ti-cuôi ton a-pít, a-láng ti-cuôi par-lốh, lư bôn ráp tớq cruông na Yang Arbang Pilŏ́ng. <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />A-lứng bôn mu náq te i-nha khoiq cơi táq a-rớq ngki. Ma, i-nha khoiq bôn a-rau práh, khoiq piên cơt tam-me, khoiq cơt ti-nớng tu-pứng te nốh Yang, Yang Choi Ta-mống Yê-su, a-lứng co Ar-vai na Yang Arbang Pilŏ́ng top he.<verse eid="1CO 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />“Cứp ar-náq dyôn ada cư la têq táq,” ma tới cứp ar-náq cơt tar-náp. “Cứp ar-náq dyôn ada cư la têq táq,” ma cư lư lớiq bôn cơt sol te mui ar-náq a-mớh. <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />“Tan-na dyôn ada pallúng, nha pallúng dyôn ada tan-na,” ma Yang Arbang Pilŏ́ng lư pu-pít díh nốh ndô a-lứng nốh ntíh. Ma cháq ti-cuôi tới dyôn ar-náq láh par-lưi, ma dyôn ada Yang, a-lứng Yang dyôn mmar ada cháq. <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />Yang Arbang Pilŏ́ng khoiq dyôn Yang tu-mống liêh, a-lứng lư dyôn top he tu-mống liêh co chức sút na Án. <verse eid="1CO 6:14" /><verse number="15" style="v" sid="1CO 6:15" />I-nha lớiq chom dyơ cháq i-nha la cháq na Yang Choi Ta-mống? Khán iki, ndóng ial cháq na Yang Choi Ta-mống, cư cóq táq dyôn cơt cháq na cán ndon táiq cháq? Lư lớiq bôn ar-náq ngki! <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />A-láng i-nha lớiq chom ngki ti-cuôi báq mŏp cháq án nga cán táiq cháq la mui cháq? Co bôn ta-ran: “Bar náq lư cơt mui sáiq.” <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />Ma nnáu mŏp cháq án nga Yang ngki la mui mít a-lứng Án. <verse eid="1CO 6:17" /><verse number="18" style="v" sid="1CO 6:18" />Cóq viar yông callong láh par-lưi! Cứp luaih ma ngai táq lư bôn tớq cu-lái tiêh cháq, máh ti-cuôi ndon láh par-lưi ngki táq luaih ada to cháq án. <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" />A-láng i-nha lớiq chom ar-lớih cháq i-nha la dúng sang na Yang Ar-vai, át tớq i-nha, la Án ndon i-nha ráp te Yang Arbang Pilŏ́ng? A-lứng i-nha lớiq ưlla te cháq i-nha, <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />co i-nha khoiq dŏq plới na tar-náp pưt lư. Co iki, cóq táq ang ưr Yang Arbang Pilŏ́ng na cháq i-nha.<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />Ma te máh par-nai ndon i-nha khoiq ta-ran: “Lư ŏ dyôn ti-cuôi conh i-yốh tar-kít a-lớng ngai ng-cán.” <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />Ma co par-ngíh láh par-lưi, cứp náq ti-cuôi conh cóq ial cam-pái ada án, a-lứng cứp náq ti-cuôi cán cóq ial ca-yiêq ada án. <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />Ca-yiêq cóq táq a-pu a-ma dyôn ada cam-pái, ma cam-pái dyôn ada ca-yiêq mu chứng a-rớq ngki tưi. <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />Cam-pái lớiq bôn sút nnáng te cháq na án ma la ca-yiêq. Ma mu chứng a-rớq ngki, ca-yiêq lư lớiq bôn sút nnáng te cháq na án, ma la cam-pái. <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />Êq ca-lôih tar-tuôq, ma la co callong khoiq sŏ́ng nưm mu hoi sớng dŏq i-nha têq par-ngíh cớu seq, dyơ ngki át a-lớng mu nơi, dŏq yang sáq lớiq têq par-yông i-nha te callong lớiq ráp ót na i-nha.<verse eid="1CO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 7:6" />Ma cư tông par-nai ndô a-rớq mui callong ŏ dyôn cam-máng ma tới a-rớq par-nai pa-táp. <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />Ma cư ng-cong cứp náq lư bôn a-rớq cư. Ntro iki, cứp náq bôn callong tu-báiq ndái te Yang Arbang Pilŏ́ng, tam bôn ti-cuôi a-rớq idô, ma bôn ti-cuôi a-rớq iki. <verse eid="1CO 7:7" /><verse number="8" style="v" sid="1CO 7:8" />Ma dyôn ada máh ti-cuôi i-yốh ial cam-pái a-lứng máh cán cám mai, cư tông ar-lớih khán nha-án ma iki níc a-rớq cư la ŏ. <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />Ma khán nha-án lớiq rap chiuq át mu náq, nha-án cóq ial cam-pái. Co ial cam-pái ngki ŏ hơn ính bôn ngai. <verse eid="1CO 7:9" /><verse number="10" style="v" sid="1CO 7:10" />Ma dyôn ada máh ti-cuôi khoiq bôn cam-pái cư yua — tới cư, ma la Yang — Cam-pái lớiq têq par-táh te ca-yiêq <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />(ma nám khán cán ngki khoiq par-táh, án cóq át iki êq ial nnáng ca-yiêq, lớiq la cóq tár ŏ liêh a-lớng ca-yiêq), nha ca-yiêq ngki lớiq têq táh cam-pái. <verse eid="1CO 7:11" /><verse number="12" style="v" sid="1CO 7:12" />Ma dyôn ada máh ti-cuôi yôl liêh cư tông — cư, ngki tới Yang — khán em ai mmo bôn cam-pái i-yốh tin, nha cán ngki sŏ́ng ính át a-lứng i-nha, i-nha lớiq têq táh cán ngki. <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />Khán mu náq cán mmo bôn ca-yiêq i-yốh tin nha ti-cuôi ngki bui can-nính át a-lứng án, ngki cam-pái lớiq têq táh ca-yiêq. <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />Co ca-yiêq i-yốh tin têq práh ŏ nhơ cam-pái án, nha cam-pái i-yốh tin têq práh ŏ nhơ ndon em ai ngki. Co khán lớiq ngki a-cái a-con i-nha la lớiq práh ŏ, ma hoi ndô nha-án bôn práh. <verse eid="1CO 7:14" /><verse number="15" style="v" sid="1CO 7:15" />Ma khán ti-cuôi i-yốh tin ngki chóng ính car-yáh, cóq dyôn ti-cuôi ngki car-yáh. Ndon em ai a-láng ơi a-em ngki lớiq túh pa-tot te ar-náq ngki, ma la Yang Arbang Pilŏ́ng khoiq rêh arô top he át tớq callong iên ŏ. <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />Co, em ai ơi, i-mo i-nha chom, bôn lớiq idô i-nha têq choi ta-mống ca-yiêq i-nha? A-láng, em ai ơi, i-mo i-nha chom bôn lớiq idô i-nha têq choi ta-mống cam-pái i-nha? <verse eid="1CO 7:16" /><verse number="17" style="v" sid="1CO 7:17" />Khán ớq bôn, Yang khoiq choi dyôn ada cứp náq ti-cuôi cơt i-mo, Yang Arbang Pilŏ́ng khoiq rêh arô cứp náq ti-cuôi i-mo, cóq ti-caq pôq iki. A-lứng cư a-nát a-rớq iki tớq nhéq máh top tin. <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />Nnáu khoiq dŏq arô vít dyơ táq rit kít? Ti-cuôi ngki êq a-rớq i-yốh táq rit kít. Nnáu khoiq dŏq arô te par-ngíh i-yốh ính táq rit kít? Ti-cuôi ngki êq táq rit kít. <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />Táq rit kít ớq bôn a-mớh, lớiq táq rit kít lư ớq bôn a-mớh; ma la cóq peh máh par-nai pa-táp na Yang Arbang Pilŏ́ng. <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />Cứp náq ti-cuôi, te siêng arô ma án khoiq bôn rêh arô, cóq táq níc te ar-náq ngki. <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />I-nha bôn rêh arô te mu náq ti-cuôi sol? Êq dyôn ar-náq ngki táq dyôn i-nha tam-bang par-ngíh. Ma, khán i-nha lư têq bôn tar-cláh, ngki cóq ca-pol khớm. <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />Co mu náq ti-cuôi, la cơt sol, bôn rêh arô te Yang ngki cơt ti-cuôi lớiq sol na Yang. Mu chứng, ti-cuôi lớiq sol bôn rêh arô ngki cơt sol na Yang Choi Ta-mống. <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />I-nha khoiq bôn plới tớq tar-náp pưt lư; êq cơt sol dyôn thư ti-cuôi. <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />Em ai ơi, cứp ti-cuôi át tớq ar-náq mmo ndóng bôn rêh arô, ngki cóq táq níc ada Yang Arbang Pilŏ́ng te ar-náq ngki.<verse eid="1CO 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />Ma piaiq nga máh ti-cuôi yôl cu-mor, cư lớiq bôn par-nai yua te Yang. Ma, cư a-ngốh ngê co khoiq ráp dyơ ơn callong sruiq te Yang, dŏq la mu náq ti-cuôi piaiq tin peh. <verse eid="1CO 7:25" /><verse number="26" style="v" sid="1CO 7:26" />Iki, cư par-ngíh ar-náq ngki la ŏ, co te callong diêiq a-rức cơt biq khoiq tớq tar-mán, ngki lư ŏ dyôn mu náq ti-cuôi át níc tớq ar-náq a-rớq ngki. <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />I-nha khoiq ial cam-pái? Êq suô ngê dŏq ính par-táh. I-nha khoiq par-táh te cam-pái? Êq ial nnáng cam-pái. <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />Ma khán i-nha ial cam-pái, i-nha lớiq táq luaih; a-lứng khán mu náq cán cu-mor ial ca-yiêq, cán ngki lớiq táq luaih. Ma, máh ti-cuôi ngki lư bôn callong diêiq a-rức tớq sac sáiq, ma cư ính i-nha viar ar-náq ngki. <verse eid="1CO 7:28" /><verse number="29" style="v" sid="1CO 7:29" />Ma, em ai ơi, cư tông par-nai ndô: I-ngái talloiq ngki khoiq tớq dyơ, dŏq têq te ndô chô mát, díh máh ti-cuôi bôn cam-pái, ngki táq a-rớq ớq bôn; <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />ma nnáu nhiêm, a-rớq lớiq nhiêm; nnáu bui hơr, a-rớq lớiq bui; ma nnáu plới crơng, a-rớq lớiq bôn ưlla a-mớh; <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />a-lứng máh ti-cuôi tớc crơng-crớu pang ndô, a-rớq lớiq bôn tớc. Co máh crơng na pang ndô cơt pít nhéq. <verse eid="1CO 7:31" /><verse number="32" style="v" sid="1CO 7:32" />Ma cư ính bôn i-nha têq vít te rớu ri. Ti-cuôi ndon tu-cóng cóq táq máh ar-náq te Yang, táq i-mo ma nha-án têq táq bui can-nính Yang. <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />Ma ti-cuôi conh khoiq ial cam-pái ca-tóng táq máh ar-náq tớq pang ndô, táq i-mo ndon ca-yiêq cóq táq bui can-nính cam-pái nha-án, a-lứng ti-cuôi ngki cơt tam-bang par-ngíh. Cán ndon tu-cóng a-láng cu-mor plŏt <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />cóq ca-tóng táq máh ar-náq te Yang, táq i-mo i-nha têq cơt práh ŏ díh te cháq a-lứng tớq ar-vai. Ma cán ndon khoiq ial ca-yiêq ca-tóng táq máh ar-náq tớq pang ndô, táq i-mo cam-pái cóq táq bui can-nính ca-yiêq nha-án. <verse eid="1CO 7:34" /><verse number="35" style="v" sid="1CO 7:35" />Ma, cư chón tông par-nai ndô co tar-náp dyôn ada i-nha, tới dŏq cư ính ca-táng i-nha, ma dŏq dyôn par-ngíh táq ar-náq crái piaiq a-lứng táq níc ar-náq ada Yang nhéq tar-ngứh tar-hơ. <verse eid="1CO 7:35" /><verse number="36" style="v" sid="1CO 7:36" />Ma khán ti-cuôi mmo par-ngíh táq iki la lớiq crái dyôn ada a-cái cán ndon cu-mor na án ma khán cán ngki khoiq lớiq bán ŏ cháq bôm a-lứng co iki ar-náq ính ial ca-yiêq lư têq cơt ti-cuôi ngki cóq táq ar-náq án ính. Ti-cuôi ngki lớiq táq luaih; cóq dyôn nha-án tár ial. <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />Ma nnáu chiuq ta-nhir tớq mít án, ớq bôn callong pa-tot, ma bôn sút tớq can-nính na án bôm a-lứng ti-cuôi ngki khoiq a-nát a-rớq ngki tớq mít án — dŏq kiaq me a-cái cán cu-mor na án — ti-cuôi ngki lư táq crái piaiq lư. <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />A-rớq ngki, án dyôn a-cái cu-mor plŏt án tar-cớiq la piaiq lư, a-lứng án lớiq dyôn tar-cớiq ngki lư ŏ hơn. <verse eid="1CO 7:38" /><verse number="39" style="v" sid="1CO 7:39" />Ndon cam-pái lớiq têq par-táh díh ali mmo toi ca-yiêq án yôl tu-mống. Ma khán ca-yiêq cu-chet, cán ngki bôn tar-cláh têq át a-lớng ti-cuôi mmo án ính, ma cóq ti-cuôi tin Yang. <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />Ma, veng par-ngíh na cư, cán ngki bún lư khán ma têq át a-rớq ngki. Ma cư par-ngíh cư lư bôn Ar-vai na Yang Arbang Pilŏ́ng.<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />Te máh crơng ngai tu-tức dyôn yang sáq: Top he chom dyơ nhéq tưh top he bôn callong tu-báiq. Callong tu-báiq ngki táq a-sớr cháq, ma callong ar-moih ngki táq ngôl. <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />Khán nnáu par-ngíh án chom ar-náq a-mớh ngki, ti-cuôi ngki yôl i-yốh chom a-rớq án cóq chom. <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />Ma khán nnáu a-moih Yang Arbang Pilŏ́ng, ti-cuôi ngki lư Án chom. <verse eid="1CO 8:3" /><verse number="4" style="v" sid="1CO 8:4" />Iki, te ar-náq cha máh nốh ngai tu-tức dyôn yang sáq: Top he chom dyơ rup ngki tớq cúc cu-teq ndô ớq tar-náp, a-lứng lư lớiq bôn yang ŏ mmo nưm Yang Arbang Pilŏ́ng táp. <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />Co ntro a-cám tông bôn máh nốh ngai dŏq la Yang, lớiq la át tớq pilŏ́ng a-láng tớq cu-teq, a-rớq bôn a-ưi “yang” a-lứng a-ưi “ưlla”, <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />ma dyôn ada top he nưm bôn mui Yang Arbang Pilŏ́ng, la A-ám, Án ndon túc nốh tôm cơt, a-lứng la Án ndon top he chúng mu nơi mui Yang Yang Choi Ta-mống Yê-su co Án ma túc nốh bôn teng cơt nha co Án ma top he bôn át ar-toi liêh.<verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />Ma, callong tu-báiq ndô lớiq át tớq cứp náq ti-cuôi. Ma clứng ti-cuôi khoiq cơi te nsuôi díh hoi ndô tức yang sáq, nha-án cha máh nốh ngki a-rớq crơng khoiq ngai tức dyôn yang sáq, dyơ mít can-nính khoiq tin lớiq khớm na nha-án cơt bôn luaih. <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />Ma, tan-na cha lư lớiq dông top he tớq tar-mán Yang Arbang Pilŏ́ng; khán lớiq cha, top he la mu chứng a-rớq ngki, khán cha top he la lớiq bôn clưi ta-niêng. <verse eid="1CO 8:8" /><verse number="9" style="v" sid="1CO 8:9" />Ma cóq mmứng dáh lơ na ar-náq mmo te ar-náq lớiq bôn luaih ndô na i-nha têq cơt táq luaih dyôn ti-cuôi tin i-yốh khớm. <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />Co khán nnáu bôn hôm ti-cuôi bôn callong chom ti-cu cha tớq ntúq ngai tức dyôn yang sáq, ngki mít can-nính yôl i-yốh khớm na nha-án lư ngai yua cóq cha máh crơng tan-na khoiq ngai tức dyôn yang sáq? <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />Iki, mu náq ti-cuôi i-yốh khớm, mu náq em ai ma Yang Choi Ta-mống khoiq cu-chet tang, dŏq pu-pít te callong chom na i-nha. <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />Iki, veng a-rớq ngki, ndóng táq luaih ada top em ai i-nha nha táq a-nguaq mít can-nính i-yốh khớm na nha-án, i-nha lư táq luaih ada Yang Choi Ta-mống. <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />Co iki khán tan-na cha táq dyôn mu náq em ai na cư táq luaih, cư lư ar-lớih lư lớiq cha nnáng sáiq, dyôn têq cư lớiq táq luaih ada mu náq em ai na cư.<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />Cư lớiq têq tar-cláh? Cư tới la mu náq dyưng ati? Cư i-yốh cơi tar-múh Yang Yê-su, Yang top he? Ma tới i-nha la ar-náq na cư tớq Yang? <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />Ntro cư tới la dyưng ati dyôn ada máh ti-cuôi can-nŏ́h, ma piaiq lư cư la dyôn ada i-nha. Co i-nha la tíc te cơt dyưng ati na cư tớq Yang. <verse eid="1CO 9:2" /><verse number="3" style="v" sid="1CO 9:3" />Par-nai ôi na cư dyôn ada máh ti-cuôi ndon tông ada cư la idô: <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />Dêu ar-mo top he lớiq bôn chức cha a-lứng ngoiq? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />Dêu ar-mo top he lớiq bôn chức dông mu náq cam-pái tin Yang, mu chứng a-rớq top dyưng ati can-nŏ́h a-lứng máh em ai conh na Yang nha Sê-pha? <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />A-láng nưm náq Ba-na-ba nha cư lớiq bôn chức ớq táq ar-náq? <verse eid="1CO 9:6" /><verse number="7" style="v" sid="1CO 9:7" />Nnáu pôq líng ial práq công te dúng án ndóng mmo? Nnáu kiaq nương nho ma lớiq cha cu-lái nho? A-láng nnáu bán pan-nán ma lớiq ngoiq dơq tŏ́h na pan-nán? <verse eid="1CO 9:7" /><verse number="8" style="v" sid="1CO 9:8" />Tới cư chón tông máh par-nai ndô veng ngê ti-cuôi pang ndô, a-láng phep rit la ớq tông máh par-nai ngki? <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" />Co bôn par-nai ta-ran tớq phep rit Môi-se: Êq ca-som tớq ng-cang car-rŏ́q ndóng dếq sro. Dêu ar-mo Yang Arbang Pilŏ́ng tông te car-rŏ́q? <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />A-láng Án tông iki co tar-náp na top he? Lư, par-nai khoiq ta-ran co tar-náp na top he, i-mo ti-cuôi táq pi-dái cóq táq tớq callong ng-cong, a-lứng ti-cuôi chớt sro tớq callong ng-cong te phê mpô ada án. <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" />Khán top he khoiq chóh máh callong mma ndon te ar-vai tớq mít i-nha, ngki piaiq ma lớiq khán top he lư seq máh crơng tan-na ndon te sac sáiq na i-nha? <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />Khán máh ti-cuôi can-nŏ́h bôn phê te chức ngki tớq i-nha, lư ar-lớih top he a-ưi clưi ngki? Ma top he lớiq par-ngíh a-mớh te chức ndô. Ma lư, top he chiuq ta-nhir cứp nốh dŏq top he lớiq dông a-tớq nốh diêiq a-rức mmo dyôn Par-nai ŏ Yang na Yang Choi Ta-mống. <verse eid="1CO 9:12" /><verse number="13" style="v" sid="1CO 9:13" />I-nha lớiq chom dyơ ti-cuôi mmo táq ar-náq tớq dúng sang ngki cha máh crơng na dúng sang, máh ti-cuôi táq ar-náq tớq pa-rông mŏp sang, ngki bôn phê ntúq pa-rông mŏp sang? <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" />Mu chứng a-rớq ngki tưi, Yang khoiq yua ca to máh ti-cuôi ndon ca to Par-nai ŏ Yang ngki tu-mống co Par-nai ŏ Yang. <verse eid="1CO 9:14" /><verse number="15" style="v" sid="1CO 9:15" />Ma cư i-yốh seq mui nốh mmo te máh chức ngki. Hoi ngki, cư lớiq ta-ran máh par-nai ndô dŏq chức ngki têq táq ada cư a-rớq ngki, co ada cư, the cu-chet a-láng la ti-cuôi mmo lư táq dyôn bui mít can-nính na cư cơt ớq lớng. <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />Co khán cư ca to Par-nai ŏ Yang, ngki ớq bôn a-mớh dyôn cư dŏq cu-hống, co ngki la mpual khoiq bôn tớq cư. Co lư bap dyôn cư khán cư lớiq ca to Par-nai ŏ Yang! <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />Khán cư sŏ́ng ính táq ar-náq ngki, cư bôn cống. Ma khán lớiq ính táq, cư khoiq a-ngô te ar-náq kiaq me dyơ. <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />Iki, cống na cư la a-mớh? Ngki la ndóng ca to Par-nai ŏ Yang lớiq túh ial cống, cư têq taq-ntêr Par-nai ŏ Yang ma lớiq túh cóq ial chức na cư tớq Par-nai ŏ Yang. <verse eid="1CO 9:18" /><verse number="19" style="v" sid="1CO 9:19" />Tam lư khoiq tar-cláh te cứp nốh, cư chóng ính táq sol dyôn cứp náq ti-cuôi, dŏq cư têq táq dyôn a-ưi ti-cuôi loi. <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />Dyôn ada ti-cuôi Isa-ra-el, cư cơt a-rớq ti-cuôi Isa-ra-el, dŏq cư têq tông dyôn ti-cuôi Isa-ra-el. Dyôn ada máh ti-cuôi ndon veng phep rit, a-rớq ndon veng phep rit, ntro cháq cư lớiq át ta-dưp phep rit, dŏq cư têq rap tông dyôn máh ti-cuôi ndon veng phep rit. <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />Dyôn máh ti-cuôi lớiq bôn phep rit, a-rớq lớiq bôn phep rit (ntro tới la ớq bôn phep rit na Yang Arbang Pilŏ́ng, ma la ndon veng phep rit na Yang Choi Ta-mống), dŏq cư têq rap tông dyôn máh ti-cuôi lớiq bôn phep rit. <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />Dyôn ada máh ti-cuôi i-yốh khớm, cư cơt a-rớq i-yốh khớm, dŏq cư têq rap tông máh ti-cuôi i-yốh khớm. Cư khoiq cơt cứp ngê dyôn ada cứp ti-cuôi, dyôn cư têq táq cứp ngê choi ta-mống mu náq ti-cuôi. <verse eid="1CO 9:22" /><verse number="23" style="v" sid="1CO 9:23" />Ma, cư táq cứp ar-náq la co Par-nai ŏ Yang, dŏq cư têq cơt ti-cuôi bôn tưi phê tớq ngki. <verse eid="1CO 9:23" /><verse number="24" style="v" sid="1CO 9:24" />I-nha lớiq chom idô cứp náq máh ti-cuôi ta-lúh ính tam-pring lư ta-lúh, ma nưm mu náq bôn ráp cống? Cóq ta-lúh veng a-rớq ngki dŏq i-nha têq bôn ráp cống ngki. <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />Ma cứp náq ti-cuôi tam-pring ta-lúh tớq ntúq ngai séng cóq ca-tóng rian bôm te cứp ar-náq. Lư nha-án chiuq iki dŏq nha-án bôn cống te ta-lúh ngki chái lư pít, ma top he te ta-lúh ndon lớiq têq pít. <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />Co iki, cư ta-lúh a-rớq ngki, lớiq a-vi a-rớq ớq ntúq a-nát; cư púh chốc a-rớq ngki, lớiq a-vi a-rớq púh náh nnan sớng. <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />Ma cư pa-tot cháq bôm a-lứng táq cháq a-rớq sol, dáh lơ te ar-náq mmo, vít dyơ ca to a-ưi ti-cuôi can-nŏ́h, lư ar-lớih cư lớiq têq bôn cống.<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />Co em ai ơi, cư lớiq ính i-nha lớiq chom idô a-chúc a-chiac top he cứp náq khoiq át pưn tu-lúc, cứp náq pôq cláh pan-di dơq ving ca-vang. <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />Cứp náq tar-veng Môi-se khoiq bôn táq tíc na dơq tớq tu-lúc a-lứng tớq dơq ving ca-vang, <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />nhéq náq khoiq cha nưm mui tan-na te yang, <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />a-lứng nhéq náq khoiq ngoiq ngki mui nốh dơq te Yang, co nha-án ngoiq te mui cúc búl na Yang veng nha-án, ma búl ngki la Yang Choi Ta-mống. <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />Ma, Yang Arbang Pilŏ́ng khoiq lớiq bui can-nính a-lứng a-ưi lư máh ti-cuôi ngki, iki nha-án khoiq cu-chet tiq-príq ngki tớq ntúq aih. <verse eid="1CO 10:5" /><verse number="6" style="v" sid="1CO 10:6" />Ma máh ar-náq ndô khoiq cơt máh tíc dyôn top he, dŏq lớiq táq top he la máh ti-cuôi ính táq máh ar-náq saq ngki mu chứng a-rớq nha-án khoiq ính táq. <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />A-lứng êq cơt a-rớq máh ti-cuôi sang rup a-rớq máh ti-cuôi ntíh te top nha-án; bôn a-rớq par-nai ta-ran: “Nha-án ti-cu ính cha a-lứng ngoiq dyơ ta-yứng a-yưn.” <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />Top he ngki êq táq luaih láh par-lưi a-rớq a-ưi náq te top nha-án khoiq láh par-lưi, ma bar chít la pe ngin ti-cuôi khoiq cu-chet tớq mui i-ngái. <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />A-lứng êq thứq Yang a-rớq a-ưi ti-cuôi te top nha-án khoiq thứq Án dyơ cơt cu-chet co cu-sánh. <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />A-lứng êq nhan-nha nhan-nhóm a-rớq a-ưi ti-cuôi te top nha-án khoiq nhan-nha nhan-nhóm a-lứng cơt án pu-pít ca-chet. <verse eid="1CO 10:10" /><verse number="11" style="v" sid="1CO 10:11" />Ma máh ar-náq ngki khoiq cơt dyôn nha-án a-rớq máh tíc ma nha-án khoiq ta-ran liêh dŏq dyôn ar-náq ca-tớih top he, la ta-niêng máh ti-cuôi ma máh callong talloiq na máh pang i-nớh khoiq tớq dyơ. <verse eid="1CO 10:11" /><verse number="12" style="v" sid="1CO 10:12" />Co iki, nnáu par-ngíh án ta-yứng khớm, cóq mmứng ada car-siat dáh lơ dứm. <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />Lớiq bôn callong luaih mmo khoiq tớq nga i-nha nưm nốh ndon tớq nga thư ti-cuôi; ma Yang Arbang Pilŏ́ng ti-nớng lư, la Án lư lớiq dyôn i-nha callong par-yông clưi te rêng i-nha rap chiuq, ma te callong par-yông ngki, Án ngki lư pốh car-na dŏq i-nha têq rap chiuq ta-nhir.<verse eid="1CO 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />Co iki, em ai a-moih lư na cư ơi, cóq viar a-yông te ar-náq sang rup. <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />A-rớq cư chón tông ada máh ti-cuôi tu-báiq. I-nha cóq át par-ngíh par-nai cư tông. <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" />Ti-ngan bôn bún ndon top he si-ơn, tới ngki la ndon phê te a-ham na Yang Choi Ta-mống? Beng ndon top he péq ngki, tới ngki la ndon phê te cháq na Yang Choi Ta-mống? <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />Co bôn mui allám beng, top he, a-ưi, nưm la mui cháq, co cứp náq top he bôn phê te mui allám beng. <verse eid="1CO 10:17" /><verse number="18" style="v" sid="1CO 10:18" />Cóq me ti-cuôi Isa-ra-el veng sac sáiq. Tới máh ti-cuôi cha crơng sang la máh ti-cuôi bôn phê ntúq pa-rông? <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />Iki, cư chón tông callong a-mớh? Crơng ngai tức sang rup la nốh a-mớh, a-láng sang rup la bớr a-mớh? <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />Lư iki, máh crơng ma máh ti-cuôi tới Isa-ra-el tức sang la tức dyôn yang sáq, tới dyôn Yang Arbang Pilŏ́ng. Ma cư lớiq ính i-nha cơt máh ti-cuôi bôn phê a-lớng yang sáq! <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />I-nha lớiq têq ngoiq ti-ngan na Yang nha ti-ngan na yang sáq a-mớh. I-nha lớiq têq chúng phê ntúq pa-rông na Yang a-lứng tớq pa-rông na yang sáq a-mớh. <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />A-láng top he táq iki dyôn Yang sáng nháih? Dêu ar-mo top he ngki bánh rêng hơn Án?<verse eid="1CO 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />“Cứp ar-náq ngki têq táq,” ma tới cứp ar-náq dông a-tớq tar-náp. “Cứp ar-náq ngki têq táq,” ma tới cứp ar-náq dŏq táq dyôn ŏ. <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />Êq nnáu si-suô tar-náp nưm ada án, ma la tar-náp ada ti-cuôi can-nŏ́h. <verse eid="1CO 10:24" /><verse number="25" style="v" sid="1CO 10:25" />Cóq cha cứp nốh ndon ngai táiq tớq ntúq par-lới, lớiq túh par-ngíh a-mớh tớq mít can-nính. <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />Co “cu-teq a-lứng cứp nốh tớq ngki ưlla na Yang.” <verse eid="1CO 10:26" /><verse number="27" style="v" sid="1CO 10:27" />Khán mu náq ti-cuôi i-yốh tin mmo yua i-nha dyơ i-nha ính pôq, ngki cóq cha cứp tan-na dŏq a-ngốh chứng mát i-nha, êq plốh callong a-mớh co te mít can-nính. <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />Ma khán bôn ti-cuôi tông ada i-nha: “Ndô la crơng ngai tức,” ngki êq cha, co te ti-cuôi ngki, la ti-cuôi khoiq dyôn i-nha chom, a-lứng mít can-nính — <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />Ma cư tông te mít can-nính, tới la te cháq i-nha, ma la mít can-nính na ti-cuôi ngki. Ngki la co i-mo callong lớiq luaih na cư khoiq mít can-nính na ti-cuôi can-nŏ́h tíq? <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />Khán cư sŏ́ng cha te mít si-ơn, ngki i-mo cư cơt ngai tíq co tan-na ndon cư si-ơn? <verse eid="1CO 10:30" /><verse number="31" style="v" sid="1CO 10:31" />Iki, ntro lư i-nha cha a-láng ngoiq, lớiq la táq mui ar-náq a-mớh, cóq táq cứp nốh dyôn callong ayô na Yang Arbang Pilŏ́ng. <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />Êq táq tar-luaih dyôn díh ti-cuôi Isa-ra-el, nha ti-cuôi Créc, a-lứng top tin na Yang Arbang Pilŏ́ng, <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />mu chứng a-rớq cư lư sŏ́ng can-nính táq ar-náq dyôn cứp náq ti-cuôi te cứp ar-náq, lớiq suô tar-náp ada cư bôm, ma la tar-náp ada a-ưi náq ti-cuôi, dŏq nha-án têq bôn choi ta-mống.<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1" />Cóq cơt a-rớq máh ti-cuôi soi cư, a-rớq cư la ti-cuôi soi Yang Choi Ta-mống.<verse eid="1CO 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />Cư ayô i-nha co i-nha khoiq ayư níc nga cư te cứp nốh, a-lứng i-nha ca-pol khớm máh par-nai a-rớq cư khoiq ca to dyôn i-nha. <verse eid="1CO 11:2" /><verse number="3" style="v" sid="1CO 11:3" />Ma cư ính i-nha chom idô Yang Choi Ta-mống la plô dyôn cứp náq ti-cuôi conh, ma ngai ng-conh la plô dyôn ti-cuôi cán, ma Yang Arbang Pilŏ́ng la plô dyôn Yang Choi Ta-mống. <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />Cứp náq ti-cuôi ng-conh cớu seq lớiq la ntêr tang ng-cang, khán bôn crơng a-mớh pul tớq plô, ngki táq a-chiêt plô án. <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />Ma cứp náq ti-cuôi cán cớu seq lớiq la ntêr tang ng-cang ngki plô ma lớiq bôn pul, ngki táq a-chiêt plô bôm. Co ar-náq ndô la mui a-lứng ar-náq plô khoiq cơt ca-loh. <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />Co khán mu náq ngai ng-cán lớiq pul plô, cán ngki lư cóq kít viang sóc. Ma khán kít sóc lớiq la kít ca-loh plô la a-chiêt lư dyôn ada ti-cuôi cán, cán ngki cóq pul liêh plô. <verse eid="1CO 11:6" /><verse number="7" style="v" sid="1CO 11:7" />Ma mu náq, ngai ng-conh lớiq túh pul plô nha-án co cơt ngôl a-lứng ang ưr na Yang Arbang Pilŏ́ng. Ma, ngai ng-cán la ang ưr na ngai ng-conh. <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />Co ngai ng-conh ngki lớiq tớq te ngai ng-cán, ma la ngai ng-cán tớq te ngai ng-conh. <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />A-lứng co ngai ng-conh lớiq bôn teng cơt co ngai ng-cán, ma la ngai ng-cán co ngai ng-conh. <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />Co te ar-náq ngki ngai ng-cán cóq pưng tíc chức tớq plô án co te máh tar-neng Yang. <verse eid="1CO 11:10" /><verse number="11" style="v" sid="1CO 11:11" />Lư iki, chứng mát Yang ngai ng-cán lớiq bôn sút a-lớng ngai ng-conh, ngai ng-conh ngki lớiq bôn sút a-lớng ngai ng-cán. <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />Co ngai ng-cán tớq te ngai ng-conh i-mo, ngki ngai ng-conh lư co ngai ng-cán ma bôn iki tưi, túc nốh tớq te Yang Arbang Pilŏ́ng. <verse eid="1CO 11:12" /><verse number="13" style="v" sid="1CO 11:13" />Cóq par-ngíh tớq cháq i-nha: Ngai ng-cán lớiq pul plô cớu seq te Yang Arbang Pilŏ́ng ngki piaiq lớiq? <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />Tới co máh nốh khoiq bôn dŏq ca to i-nha chứng idô, ma khán ngai ng-conh dŏq sóc toiq, ngki la callong a-chiêt ada án? <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />Ma, khán ti-cuôi cán dŏq sóc toiq, ngki la ŏ lư dyôn ada cán ngki? Co sóc toiq khoiq dyôn ada án a-cám a-rớq prới pul plô. <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />Ma khán nnáu ma ính tar-miên te ar-náq ndô, top he ớq bôn cơi a-rớq ngki, máh top tin na Yang Arbang Pilŏ́ng la ớq.<verse eid="1CO 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />Ma ndóng pa-táp par-nai ta-tun ndô, cư lớiq ayô i-nha, co i-nha rum sang mu nơi lớiq ính táq callong ndon ŏ ma la pa-tot táq tớq callong lớiq ŏ. <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />Ma nsuôi lư, ndóng i-nha rum liêh tớq dúng sang, cư sáng callong car-yáh te top i-nha, a-lứng cư náp ar-náq ngki mu biq crái. <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />Co ính bôn car-yáh a-ưi top te top i-nha, dyôn têq máh ti-cuôi khoiq sŏ́ng lư têq dŏq a-páh ar-lớih ar-lêng te top i-nha. <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />Co iki, ndóng i-nha rum liêh tớq mui ntúq, ar-náq ngki tới la dŏq ính Cha Sáiq Ngoiq A-ham na Yang. <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />Co chón ndóng chi-cha, cứp náq mmar cha tan-na na án nsuôi, iki ma bôn ti-cuôi ngki pi-nhaih lư, ma bôn ti-cuôi ngki bol plêc. <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />Dêu ar-mo i-nha lớiq bôn dúng dŏq chi-cha a-lứng ngoiq tớq ngki? A-láng i-nha ayê top tin na Yang Arbang Pilŏ́ng a-lứng táq a-chiêt máh ti-cuôi ớq bôn a-mớh? Cư cóq tông a-mớh ada i-nha? Iki piaiq ayô i-nha te ar-náq ndô? Cư lớiq ayô i-nha a-mớh! <verse eid="1CO 11:22" /><verse number="23" style="v" sid="1CO 11:23" />Co cư khoiq ráp te Yang nốh cư khoiq dŏq ca to dyôn ada i-nha, ngki la Yang Yê-su, tớq i-dáu ma Án ngai cu-liêu, khoiq ial beng, <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />dyơ vít si-ơn, Án péq beng a-lứng tông: Ndô la cháq na cư tang dyôn i-nha. Cóq táq ar-náq ndô tớq callong ayư te cư. <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />Mu chứng a-rớq ngki te ti-ngan vít dyơ cha, idô: “Ti-ngan ndô la par-ưq tam-me tớq a-ham cư. Khán ndóng mmo i-nha ngoiq ti-ngan, cóq táq ar-náq ndô tớq callong ayư níc te cư.” <verse eid="1CO 11:25" /><verse number="26" style="v" sid="1CO 11:26" />Ma khán ali mmo i-nha cha beng ndô a-lứng ngoiq ti-ngan ndô, i-nha pau ntêr callong cu-chet te Yang dyôn díh ndóng Án tớq. <verse eid="1CO 11:26" /><verse number="27" style="v" sid="1CO 11:27" />Co iki, khán nnáu cha beng lớiq la ngoiq ti-ngan na Yang ma lớiq crái piaiq ngki lư bôn luaih ada cháq nha a-ham na Yang. <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />Ma, cứp náq ti-cuôi cóq ti-tuaiq liêh án, dyơ veng a-rớq ngki náq cha beng nha ngoiq ti-ngan. <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />Co nnáu cha a-lứng ngoiq ma lớiq chom ar-lớih cháq Yang ma cha a-lứng ngoiq callong táq tôt ada án. <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />Co te ar-náq ngki, clứng ti-cuôi te i-nha a-ái, tar-ma a-lứng a-ưi ti-cuôi cu-chet. <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />Ma khán top he ngki par-ngíh bôm, lư ar-lớih top he lớiq bôn tar-sưq. <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />Ma dyơ ndóng Yang tar-sưq, ính pa-cliêq top he, dŏq vít te táq tôt mu nơi a-lứng ti-cuôi lớiq tin. <verse eid="1CO 11:32" /><verse number="33" style="v" sid="1CO 11:33" />Co iki, em ai na cư ơi, ndóng rum ngki dŏq cha, cóq tár pớn tar-tuôq. <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />Khán ti-cuôi mmo pi-nhaih, cóq cha tớq dúng, dŏq i-nha lớiq rum mu nơi tớq callong tar-sưq. Ma te máh ar-náq can-nŏ́h, cư lư a-ngốh par-nai ca to dyơ ali mmo cư tớq.<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />Ma te máh ơn na ar-vai, em ai ơi, cư lớiq ính i-nha ớq chom a-mớh. <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />I-nha chom idô ndóng i-nha yôl la ti-cuôi Isa-ra-el, i-nha khoiq ngai par-yông veng a-rớq ngê ngki, dyơ ndóng ta-luiq a-nga máh rup yang sáq lúng. <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />Co iki, cư a-páh dyôn i-nha chom idô ớq nnáu pốh tông co Ar-vai na Yang Arbang Pilŏ́ng tông: “Yê-su la án piaiq pu-pap!”, a-lứng khán lớiq co Yang Ar-vai, ớq nnáu têq ngin Yang Yê-su la Yang.<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />Ma, bôn a-ưi callong ndái te callong choi mat, ma nưm mui Ar-vai Yang. <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />Bôn a-ưi ar-náq ndái te máh ar-náq tar-choi, ma nưm mui Yang. <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />Bôn a-ưi callong ndái nhéq te máh ar-náq, ma nưm mui Yang Arbang Pilŏ́ng, la Án táq cứp ar-náq tớq cứp ti-cuôi. <verse eid="1CO 12:6" /><verse number="7" style="v" sid="1CO 12:7" />Ma callong a-páh te Ar-vai Yang khoiq dyôn ada cứp ti-cuôi dŏq a-tớq tar-náp ada nha-án. <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />Co nhơ Ar-vai Yang, par-nai tu-báiq khoiq dyôn ada ti-cuôi ndô, ma par-nai sru khoiq dyôn ti-cuôi can-nŏ́h nưm te mui Ar-vai Yang ngki; <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />co nưm mui Ar-vai Yang callong tin khoiq dyôn ada ti-cuôi ndô, ma hôi pa-lai a-ái khoiq dyôn ada ti-cuôi can-nŏ́h co mui Ar-vai Yang ngki, <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />dyơ dyôn ti-cuôi ndô, máh ar-náq táq si-leh; dyôn ti-cuôi ntíh, par-nai ntêr tang ng-cang; dyôn ti-cuôi ntŏ́h, têq chom ti-tuaiq máh yang; dyôn ti-cuôi can-nŏ́h, chom a-ưi thư cang laq ndái; ma dyôn ti-cuôi can-nŏ́h hơ, têq par-long máh thư cang. <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />Ma nưm mui táp a-lứng nưm mui Ar-vai Yang têq táq cứp ar-náq ngki, dyơ mŏp dyôn mu náq ndái dyôn cứp náq ti-cuôi veng a-rớq par-ngíh Án ính.<verse eid="1CO 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />Co mu chứng a-rớq cháq la mui ma bôn a-ưi nốh tớq cháq, ma nhéq máh cứp nốh na cháq, ntro bôn a-ưi, ngki nưm la mui cháq; Yang Choi Ta-mống mu chứng a-rớq ngki. <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />Co lư te mui Ar-vai Yang, cứp náq top he bôn táq tíc na dơq nưm te mui cháq, ntro la ti-cuôi Isa-ra-el a-láng ti-cuôi Créc, ntro la sol a-láng lớiq sol, ngki nhéq náq la cóq ngoiq nưm te mui Ar-vai Yang. <verse eid="1CO 12:13" /><verse number="14" style="v" sid="1CO 12:14" />Co cháq tới la mui nốh cháq, ma la a-ưi cháq. <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />Ma khán dyưng tông: “Co cư tớiq la ati, cư tới nốh te cháq,” ngki lớiq têq co ar-náq ngki án tới nốh te cháq. <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />A-lứng khán a-rớq cu-tor tông: “Co cư tới la mát, cư tới nốh te cháq,” ngki lớiq têq co ar-náq ngki án tới nốh te cháq. <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />Khán chuôp nhéq cháq la callong mát, ngki ar-náq cam-máng tớq mmo? Khán chuôp nhéq cháq la hóng cu-tor, ngki ính a-hức tớq mmo? <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />Co iki, ma Yang Arbang Pilŏ́ng khoiq teng cứp nốh tớq cháq, mu chư mui te máh nốh ngki, veng a-rớq can-nính Án ính. <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />Ma khán cứp nốh nưm la mui nốh sớng, ngki cháq tớq mmo? <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />Ma Co iki, bôn a-ưi nốh, ma nưm mui cháq. <verse eid="1CO 12:20" /><verse number="21" style="v" sid="1CO 12:21" />Ma mát lớiq têq tông ada ati: “Cư lớiq bôn par-ngíh te mái,” lớiq la plô mu chứng ngki ada dyưng: “Cư lớiq bôn par-ngíh te mái.” <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />Piaiq lư, máh nốh tớq cháq me a-rớq la lớiq rap ta-niêng ngki la tar-náp lư ta-niêng; <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />máh nốh mmo tớq cháq ma top he par-ngíh la biq tar-náp top he dyôn ada nha-án callong dyám náp pưt lư; a-lứng máh nốh lớiq ŏ na top he ngki bôn tar-náp a-ưi loi, <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />ma máh nốh khoiq ŏ na top he ngki lớiq bôn par-ngíh ngki. Ma, Yang Arbang Pilŏ́ng khoiq teng cứp nốh át mu nơi, dyôn pi-lư callong dyám náp ada nốh mmo biq bôn dyám náp, <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />dŏq lớiq bôn callong par-yáh te cháq, ma máh nốh cháq cóq tar-choi ada tar-tuôq. <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />Khán mui nốh cơt a-ái, nhéq máh cứp nốh lư a-ái nhéq; khán mui nốh bôn dyám náp, cứp nốh tớq cháq lư bui nhéq. <verse eid="1CO 12:26" /><verse number="27" style="v" sid="1CO 12:27" />Hoi ndô, i-nha la cháq na Yang Choi Ta-mống, a-lứng la máh nốh na cứp phê bôn ndái. <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" />Yang Arbang Pilŏ́ng khoiq a-nát máh ti-cuôi tớq top tin, nsuôi lư la dyưng ati, bar la tang ng-cang, pe loi la top thới, dyơ tớq máh ar-náq si-leh, vít ngki la máh callong choi pa-lai a-ái, tar-choi, kiaq me, a-lứng máh thư cang laq ndái. <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />A-láng nhéq náq la dyưng ati? A-láng nhéq náq la tang ng-cang? A-láng nhéq náq la thới? A-láng nhéq náq táq ar-náq si-leh? <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />A-láng nhéq náq bôn choi pa-lai a-ái? A-láng nhéq náq taq-ntêr cang laq? A-láng nhéq náq par-long têq? <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />Ma cóq tel-sél ính bôn máh nốh ŏ pưt lư. Ma hoi ndô táp, cư nưm dyôn i-nha hôm mui car-na ŏ clưi ngki.<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />Ntro cư hôi taq-ntêr máh nốh cang na thư ti-cuôi a-lứng tar-neng Yang, ma cư ớq bôn callong ar-moih, ngki cư khoiq cơt a-rớq talle car-sang a-láng car-sang sar táq a-váih. <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" />Ntro cư bôn táq ntêr tang ng-cang a-lứng têq chom nhéq máh nốh ca-tốq a-lứng cứp callong tu-báiq, a-lứng ntro cư bôn díh callong tin ti-ngôi díh tar-vih cóh, ma cư ớq bôn callong a-moih, cư ớq la a-mớh nnáng. <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />Nha ntro cư dyôn cứp crơng-crớu bôm, a-lứng ntro cư mŏp cháq cư dŏq cư têq cu-hống sớng, ma cư ớq bôn callong a-moih, cư ớq bôn a-mớh. <verse eid="1CO 13:3" /><verse number="4" style="v" sid="1CO 13:4" />Callong a-moih bôn mít chiuq ta-nhir nha a-páh mít lam-bŏt. Callong a-moih lớiq i-ôiq cu-míq; callong a-moih lớiq cu-hống, lớiq pu-pưt, <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />êq taq-ntêr lớiq ŏ, êq si-suô lơi nốh a-mớh ada án bôm, êq lam-bơ chái nháih, êq dŏq callong lớiq ŏ, <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />lớiq bui te ar-náq lớiq ŏ, ma bui hơr te callong piaiq. <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />Callong a-moih táh luaih cứp nốh, náp cứp nốh, ng-cong cứp nốh, chiuq ta-nhir cứp nốh. <verse eid="1CO 13:7" /><verse number="8" style="v" sid="1CO 13:8" />Callong ar-moih lư lớiq bôn pít. Ma, ntro lư têq ntêr tang ng-cang, ma callong ngki lớiq yôl níc; ntro lư têq ntêr a-ưi thư cang, ma callong ngki lớiq bôn níc; ntro la ngê hôi tu-báiq, ma callong ngki lư ngai táh. <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />Co top he rian chom nưm biq, a-lứng top he ntêr tang ng-cang nưm biq. <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />Ma ndóng callong piaiq ŏ tớq, ndon lớiq ŏ na phê ngki lư cơt pít nhéq. <verse eid="1CO 13:10" /><verse number="11" style="v" sid="1CO 13:11" />Ndóng cư yôl la ngai a-cái, cư taq-ntêr a-rớq ngai a-cái, cư par-ngíh a-rớq ngai a-cái, cư táq ar-náq a-rớq ngai a-cái. Ndóng cư khoiq cơt sa-sai, cư táh nhéq máh ar-náq na ngai a-cái. <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />Co ndóng ndô, top he bôn hôm na tallớng te mol lớiq ar-lớih, ma tớq ndóng ngki mát tar-to mát. Hoi ndô, cư têq chom mu biq, ma tớq ndóng ngki, lư a-rớq cư khoiq dŏq chom nhéq mu chứng a-rớq cư khoiq dŏq chom cứp nhéq. <verse eid="1CO 13:12" /><verse number="13" style="v" sid="1CO 13:13" />Ma hoi ndô yôl bôn pe callong ndô: callong tin, callong ng-cong, nha callong a-moih. Ma callong pưt lư tháng te pe callong ngki la callong a-moih.<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />Cóq táq veng callong a-moih, ma cóq nhéq mít can-nính te máh nốh ar-vai yang dyôn, ma pưt lư la dŏq i-nha têq ntêr tang ng-cang. <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />Co ti-cuôi taq-ntêr cang laq ngki lớiq ntêr a-lứng ngai, ma la a-lớng Yang Arbang Pilŏ́ng; co ớq nnáu chom, ntro iki, ti-cuôi taq-ntêr máh par-nai ca-tốq tớq mít can-nính. <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />Máh ti-cuôi ntêr tang ng-cang ngki cóq ca to callong tin khớm, nha ca-tớih a-lứng callong a-liam dyôn ada ngai. <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />Ti-cuôi taq-ntêr cang laq ngki dyôn khớm ada án, ma ti-cuôi ntêr tang ng-cang ngki a-yứng Top Tin. <verse eid="1CO 14:4" /><verse number="5" style="v" sid="1CO 14:5" />Ma cư ng-cong nhéq náq i-nha taq-ntêr cang laq, ma clưi te ngki loi, ngki la i-nha têq ntêr tang ng-cang. Máh ti-cuôi ntêr tang ng-cang tar-náp hơn ti-cuôi taq-ntêr cang laq, ma khán ti-cuôi ngki têq par-long, dyôn têq top tin bôn ráp callong tin khớm. <verse eid="1CO 14:5" /><verse number="6" style="v" sid="1CO 14:6" />Ma em ai ơi, khán a-rớq hoi ngki cư tớq taq-ntêr tớq a-ưi cang laq a-lứng i-nha, cư lư choi tar-náp a-mớh dyôn i-nha, khán cư lớiq ca to ada i-nha te callong a-páh, a-láng te ngê tu-báiq lớiq la na par-nai tang ng-cang a-láng par-nai rian? <verse eid="1CO 14:6" /><verse number="7" style="v" sid="1CO 14:7" />Díh máh nốh lớiq tu-mống cơt car-sang — ntro la ti-rel a-láng tallư — khán cứp nốh lớiq táq cơt máh car-sang ndái, siêng plóng te ti-rel lớiq la siêng ta-piaih te tallư lư têq bôn a-cớl na mmo? <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />Ma khán ti-rel cơt car-sang lớiq ar-lớih nnáu lư ti-ráp dyôn ngốh tar-chíl? <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />I-nha mu chứng a-rớq ngki tưi, khán tớq te ng-cang i-nha, i-nha lớiq taq-ntêr par-nai ar-lớih têq chom, ngki táq i-mo callong khoiq pốh ta-cang lư têq chom? Co i-nha nưm la chón taq-ntêr ớq cơt callong. <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />Bôn máh thư cang ndái tớq cúc cu-teq ndô, lư bôn a-ưi lư a-lứng lớiq bôn mui nốh mmo la lớiq cơt callong. <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />Iki, khán cư lớiq chom callong te cang ngki, cư la lư ti-cuôi cruông can-nŏ́h dyôn ada ti-cuôi chón taq-ntêr, nha ti-cuôi chón taq-ntêr ngki lư la ti-cuôi cruông can-nŏ́h dyôn ada cư. <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />Co lư te mui Ar-vai Yang, cứp náq top he bôn táq tíc na dơq nưm te mui cháq, ntro la ti-cuôi Isa-ra-el a-láng ti-cuôi Créc, ntro la sol a-láng lớiq sol, ngki nhéq náq la cóq ngoiq nưm te mui Ar-vai Yang. <verse eid="1CO 14:12" /><verse number="13" style="v" sid="1CO 14:13" />Co iki, ti-cuôi taq-ntêr cang laq cóq cớu seq dŏq ti-cuôi mmo têq par-long. <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />Khán cư cớu seq tớq cang laq, mít can-nính na cư cớu seq, ma par-ngíh cư ngki lớiq chom a-mớh. <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />Ngki, cóq táq i-mo? Cư lư cớu seq na mít can-nính ma lư ính cớu seq na par-ngíh. Cư lư cứh na mít can-nính, nha a-lứng lư cứh na par-ngíh. <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />Ma khán, i-nha cứh ayô na mít can-nính, ngki táq i-mo ti-cuôi ta-yứng tớq ntúq na ti-cuôi lớiq chom a-mớh lư tông “A-men” te par-nai si-ơn na i-nha, co ti-cuôi ngki lớiq chom i-nha chón taq-ntêr a-mớh? <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />Ma ntro i-nha mŏp par-nai si-ơn ŏ lư, ma ti-cuôi can-nŏ́h lớiq têq táq pưt a-sớr. <verse eid="1CO 14:17" /><verse number="18" style="v" sid="1CO 14:18" />Cư si-ơn Yang Arbang Pilŏ́ng idô cư taq-ntêr a-ưi cang laq hơn nhéq náq i-nha, <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />ma tớq top tin, the cư tông sông callong na par-ngíh cư dŏq cư lư têq ca to dyôn máh ti-cuôi can-nŏ́h, a-láng tớq ngin te na cang laq.<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />Em ai ơi, êq cơt a-rớq ngai a-cái tớq par-ngíh na i-nha. Piaiq lư, cóq a-rớq ngai a-cái te ar-náq lớiq ŏ, ma cóq cơt a-rớq ti-cuôi sa-sai tớq par-ngíh. <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />Tớq phep rit bôn par-nai ta-ran idô:</para>
  <para style="m" vid="1CO 14:21">“Yang tông:</para>
  <para style="q1" vid="1CO 14:21">‘Cư lư tông ada ti-cuôi prái ndô</para>
  <para style="q1" vid="1CO 14:21">co máh ti-cuôi taq-ntêr cứp thư cang can-nŏ́h a-lứng na ng-cang te máh ti-cuôi lớiq a-cớl;</para>
  <para style="q1" vid="1CO 14:21">ma ntro lư iki, nha-án ngki lư lớiq cam-máng Cư.’”<verse eid="1CO 14:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="1CO 14:22" />Co iki, máh cang laq dŏq táq mui tíc, tới dyôn ti-cuôi tin, ma la dyôn ti-cuôi i-yốh tin; Ma ntêr tang ng-cang ngki tới dyôn ti-cuôi i-yốh tin, ma la dyôn ti-cuôi tin. <verse eid="1CO 14:22" /><verse number="23" style="v" sid="1CO 14:23" />Iki, ma khán nhéq top tin rum liêh tớq mui ntúq a-lứng cứp náq taq-ntêr cang laq, ma ti-cuôi lớiq chom a-mớh a-láng ti-cuôi i-yốh tin tớq rum, ngki ar-lớih nha-án lư tông idô i-nha a-chơ? <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />Ma khán cứp náq ntêr tang ng-cang, ma bôn ti-cuôi i-yốh tin lớiq la ti-cuôi lớiq chom a-mớh tớq rum, ti-cuôi ngki lư cứp náq ti-cuôi pi-ốh a-lứng cứp náq ti-cuôi plốh ti-tuaiq, <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />máh callong ca-tốq tớq mít ti-cuôi ngki cơt ar-lớih ar-lêng, nha co iki, ndóng khoiq táng ngop pi-tốq, ti-cuôi ngki lư sang tám Yang Arbang Pilŏ́ng, dyơ tông idô “Yang Arbang Pilŏ́ng lư ar-lớih át pan-di i-nha.”<verse eid="1CO 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />Iki, em ai ơi, cóq táq i-mo? Ndóng i-nha rum mu nơi, mu náq ti-cuôi ndon cứh ayô, bôn par-nai ca to, bôn callong a-páh, bôn cang laq, lớiq la bôn par-long. Cóq dŏq cứp nốh khoiq cơt tớq nga ar-náq pưt a-sớr. <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />Khán iki nnáu ngki taq-ntêr tớq cang laq, iki mu chư bar lớiq la a-ưi lư pe náq, veng vêr, a-lứng mu náq ti-cuôi cóq par-long liêh. <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />Ma khán lớiq bôn ti-cuôi par-long, ti-cuôi ngki cóq át ar-ngiac tớq top tin. Ma lư, cóq taq-ntêr te i-nha bôm a-lứng ada Yang Arbang Pilŏ́ng. <verse eid="1CO 14:28" /><verse number="29" style="v" sid="1CO 14:29" />Ma máh ti-cuôi têq ntêr tang ng-cang, cóq dyôn bar lớiq la pe náq taq-ntêr, a-lứng máh ti-cuôi can-nŏ́h cóq ti-tuaiq liêh. <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />Ma khán bôn nốh a-mớh khoiq mpáh dyôn mu náq ti-cuôi mmo chón ti-cu rum, ti-cuôi ndon suôi cóq êq ta-cang. <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />Co nhéq náq têq ntêr tang ng-cang mu chư mu náq, dŏq cứp náq ti-cuôi têq rian a-lứng cứp náq bôn a-liam. <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />Mít can-nính na máh ti-cuôi tang ng-cang chiuq cam-máng máh tang ng-cang. <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />Co Yang Arbang Pilŏ́ng tới la na callong ráu i-ráu, ma la te callong iên ŏ.</para>
  <para style="p" vid="1CO 14:33">A-rớq tớq cứp ntúq top tin te máh ti-cuôi tin, <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />ti-cuôi cán cóq át ar-ngiac tớq dúng rum. Co nha-án lớiq têq ta-cang, ma cóq cam-máng, mu chứng a-rớq phep rit pa-táp. <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />Ma khán nha-án ính rian chom callong a-mớh, nha-án cóq plốh ca-yiêq na nha-án tớq dúng, co lư la piaiq a-chiêt ada máh ti-cuôi cán ta-cang chón rum sang. <verse eid="1CO 14:35" /><verse number="36" style="v" sid="1CO 14:36" />A-láng par-nai na Yang Arbang Pilŏ́ng tớq te i-nha? Lớiq la par-nai Án nưm tớq ada i-nha sớng?<verse eid="1CO 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1CO 14:37" />Khán ti-cuôi mmo par-ngíh án la tang ng-cang a-láng ti-cuôi bôn ar-vai yang, ti-cuôi ngki cóq chom idô máh par-nai cư ta-ran dyôn ada i-nha la callong pa-táp te Yang. <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />Ma khán ti-cuôi mmo lớiq ính chom cóq dyôn ti-cuôi ngki lớiq têq chom.<verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />Co lư iki, em ai ơi, cóq tel-sél ính ntêr tang ng-cang nha êq ca-táng ntêr cang laq. <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />Ma cóq táq cứp ar-náq dyôn crái piaiq a-lứng ada car-siat.<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />Em ai ơi, cư a-páh dyôn i-nha chom te Par-nai ŏ Yang ma cư khoiq pau tông ada i-nha, la par-nai ndon i-nha lư khoiq ráp, a-lứng ta-yứng khớm tớq ngki, <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />lư co Par-nai ŏ ngki ma i-nha bôn tu-mống, khán i-nha ca-pol khớm par-nai ndon cư khoiq ca to dyôn i-nha, khán tới iki, ki i-nha khoiq tin cơt lớiq tar-náp. <verse eid="1CO 15:2" /><verse number="3" style="v" sid="1CO 15:3" />Co te nốh máh par-nai nsuôi lư cư khoiq ca to dyôn i-nha, la par-nai ndon cư lư khoiq ráp — ngki la Yang Choi Ta-mống khoiq cu-chet co callong luaih na top he veng par-nai Tám U-ráq Yang, <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" />Án khoiq ngai tứp, a-lứng khoiq bôn tu-mống liêh tớq i-ngái chư pe veng par-nai Tám U-ráq Yang, <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" />a-lứng Án khoiq a-páh dyôn Sê-pha, dyơ dyôn mu chít la bar náq dyưng ati. <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />Dyơ ngki, Án khoiq a-páh án dyôn hơn sông cu-lám náq ti-cuôi bôn hôm mui par-rứh, ma lư clứng ti-cuôi te top nha-án ngki yôl tu-mống, ma bôn án khoiq cu-chet. <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />Vít ngki, Án khoiq a-páh dyôn Ya-cơ, dyơ dyôn nhéq máh dyưng ati. <verse eid="1CO 15:7" /><verse number="8" style="v" sid="1CO 15:8" />Iki, dyơ talloiq lư na cứp náq ti-cuôi, Án lư khoiq a-páh án ada cư bôn hôm, a-rớq dyôn ngai a-cái car-nian lớiq thớng. <verse eid="1CO 15:8" /><verse number="9" style="v" sid="1CO 15:9" />Co cư la ti-cuôi két lư tớq top dyưng ati, la ti-cuôi lớiq bôn díh crái a-mớh ngki ngai dŏq la dyưng ati, co cư khoiq táq diêiq a-rức top tin na Yang Arbang Pilŏ́ng. <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />Ma co callong choi mat te Yang Arbang Pilŏ́ng cư la lư án hoi ndô, a-lứng callong choi mat te Án tớq cư lớiq bôn la ớq tar-náp. Ma lư, cư khoiq chiuq diêiq a-rức lư nhéq te máh nha-án ngki, ma tới cư ma la callong choi mat na Yang Arbang Pilŏ́ng át a-lứng cư. <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />Iki, ntro la cư a-láng la nha-án ngki, top he pau ca to a-rớq ngki a-lứng i-nha khoiq tin a-rớq ngki.<verse eid="1CO 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />Ma, khán Yang Choi Ta-mống bôn pau ca to idô Án khoiq bôn tu-mống liêh te cu-chet, ngki i-mo bôn ti-cuôi te i-nha taq-ntêr idô lớiq bôn callong tu-mống liêh na ti-cuôi cu-chet? <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />Ma khán lớiq bôn callong tu-mống liêh te ti-cuôi cu-chet, ngki díh Yang Choi Ta-mống lư khoiq lớiq têq tu-mống liêh; <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />ma khán Yang Choi Ta-mống lớiq bôn tu-mống liêh, ngki callong ca to te top he lư ớq tar-náp, a-lứng callong tin te i-nha la ớq tar-náp. <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />Ma top he lư ngai me a-rớq máh ti-cuôi taq-ntêr a-uai te Yang Arbang Pilŏ́ng, co top he khoiq taq-ntêr te Yang Arbang Pilŏ́ng idô Án khoiq dyôn Yang Choi Ta-mống tu-mống liêh, co iki ma khán ti-cuôi cu-chet lớiq têq táq dyôn tu-mống liêh, Án khoiq lớiq dyôn Yang choi ta-mống tu-mống liêh. <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />Ma khán ti-cuôi cu-chet lớiq têq tu-mống liêh, ngki díh Yang Choi Ta-mống lư khoiq lớiq têq bôn tu-mống liêh, <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />ma khán Yang Choi Ta-mống khoiq lớiq têq tu-mống liêh, callong tin na i-nha la ớq tar-náp; i-nha ma yôl át tớq callong luaih i-nha. <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />Co iki máh ti-cuôi khoiq cu-chet tớq Yang Choi Ta-mống lớiq têq tu-mống liêh. <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />Khán top he bôn ng-cong tớq Yang Choi Ta-mống nưm ng-cong te pang tu-mống ndô, top he la máh ti-cuôi ndon bap clưi te nhéq máh cứp náq ti-cuôi.<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />Ma hoi ngki, Yang Choi Ta-mống khoiq tu-mống liêh te cu-chet, án nsuôi lư na máh ti-cuôi khoiq cu-chet. <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />La co na mu náq ti-cuôi callong cu-chet, ngki lư na mu náq ti-cuôi bôn tu-mống liêh te ti-cuôi cu-chet. <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />Co i-mo te A-dam, cứp náq ti-cuôi lư cu-chet, ngki mu chứng iki tưi, tớq Yang Choi Ta-mống, cứp náq ti-cuôi lư bôn táq dyôn tu-mống. <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />Ma cứp náq ti-cuôi cơt chư mmar na án: Yang Choi Ta-mống la tu-mống nsuôi; dyơ ngki la máh ti-cuôi ưlla na Yang Choi Ta-mống tớq i-ngái tớq liêh na Án. <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />Vít ngki lư tớq i-ngái talloiq, ndóng Án mŏp cruông ang ưr ngki dyôn Yang Arbang Pilŏ́ng A-ám, ndóng Án khoiq pu-pít nhéq máh nốh sút, a-lứng cứp nốh chức nha nốh chức sút. <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />Co Án cóq táq sút dyôn díh ndóng Án khoiq dŏq nhéq cứp máh ti-cuôi pi-con ta-dưp dyưng án. <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />Ti-cuôi pi-con talloiq lư khoiq pu-pít la callong cu-chet. <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />Co “Án khoiq dŏq cứp nốh ta-dưp dyưng án.” Ma ndóng tông idô “Án khoiq dŏq cứp nốh,” ngki ar-lớih lư la tới ma díh Án táq cứp nốh cóq cam-máng Án. <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />Hoi ndô ndóng cứp nốh khoiq át ta-dưp Án, dyơ chón ngki, lư A-cái táp lư cam-máng Án khoiq táq cứp nốh cam-máng án, dŏq Yang Arbang Pilŏ́ng têq teng cơt nhéq máh te cứp nốh.<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />Khán tới iki, máh ti-cuôi táq tíc na dơq tang dyôn ti-cuôi cu-chet lư táq i-mo? Khán ti-cuôi cu-chet lớiq lư bôn tu-mống liêh, co i-mo máh ngki ti-cuôi táq tíc na dơq tang dyôn máh ti-cuôi ntíh? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />Dyơ co i-mo top he cóq chiuq diêiq a-rức cu i-ngái? <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />Em ai ơi, cư cu-chet cu i-ngái, co callong ayô te i-nha, la nốh cư bôn tớq Yang Choi Ta-mống Yê-su, Yang top he. <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />Ma khán veng a-rớq na thư ti-cuôi, cư khoiq tar-chíl a-lứng máh pan-nán pla tớq Ê-phê-sô? Callong tar-náp a-mớh dyôn ada cư? Khán ti-cuôi cu-chet lớiq têq tu-mống liêh, “Cóq cha a-lứng ngoiq co i-ngái par-nô top he cu-chet.” <verse eid="1CO 15:32" /><verse number="33" style="v" sid="1CO 15:33" />Êq dyôn ngai bôn pi-lốh: “Máh ti-cuôi táq ar-náq saq táq dyôn saq mít can-nính ŏ.” <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />Cóq par-ngíh liêh a-rớq cóq bôn! A-lứng êq táq nnáng ar-náq luaih. Co bôn máh ti-cuôi lớiq bôn chom a-mớh te Yang Arbang Pilŏ́ng — Cư tông par-nai ndô ca to te callong sáng a-chiêt na i-nha.<verse eid="1CO 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />Ma, mu náq ti-cuôi ngki lư tông: “Ti-cuôi cu-chet têq tu-mống liêh na car-na mmo, ma nha-án tớq te rớp cháq i-mo?” <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />Ti-cuôi a-chơ ntíh ơi! Nốh ma mái dông chóh lớiq têq táq dyôn tu-mống khán án lớiq cu-chet a-vai. <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />Ma nốh mái dông chóh ngki tới rớp cháq án lư cơt, cu-lái mái dông chóh nưm la callong mma — dáh lơ án cơt la callong sro a-láng callong can-nŏ́h. <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />Ma Yang Arbang Pilŏ́ng teng ada án ngki bôn rớp ndái veng can-nính Án ính, a-lứng dyôn cứp callong mma mui ar-maiq ndái. <verse eid="1CO 15:38" /><verse number="39" style="v" sid="1CO 15:39" />Tới cứp sac sáiq la mu chứng mui sac sáiq. Ma la sac sáiq ndái te thư ti-cuôi, sac sáiq ndái te thư pan-nán, sac sáiq ndái te thư a-chếq a-lứng sac sáiq ndái te máh thư buaiq. <verse eid="1CO 15:39" /><verse number="40" style="v" sid="1CO 15:40" />Lư bôn máh rớp tớq pilŏ́ng a-lứng máh rớp tớq cu-teq. Ma, ang ưr ưlla na pilŏ́ng la idô, ma ang ưr ưlla na cu-teq la iki. <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />Ang ưr na mát pan-dang la idô, ang ưr na mát ki-sái la ntíh, a-lứng ang ưr na máh pan-tôr ngki ndái loi. Co pan-tôr ndô ndái a-lứng pan-tôr ntíh te ang ưr. <verse eid="1CO 15:41" /><verse number="42" style="v" sid="1CO 15:42" />Callong tu-mống liêh te ti-cuôi chet mu chứng a-rớq ngki. Cháq khoiq ngai tứp tớq cơt a-líq; cháq bôn tu-mống liêh tớq lớiq bôn pít yôl níc; <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />Bôn cu-chet la a-ái a-oiq, ma tu-mống liêh la ŏ lư; bôn cu-chet la iêuq, ma bôn tu-mống liêh la cơt rêng; <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />khoiq cu-chet la cháq yôl tớq pang ndô, dyơ tu-mống liêh la cháq tớq pilŏ́ng. Khán bôn cháq tớq pang ndô, lư bôn cháq tớq pilŏ́ng. <verse eid="1CO 15:44" /><verse number="45" style="v" sid="1CO 15:45" />Co iki lư bôn par-nai ta-ran: “Ti-cuôi tôm lư la A-dam khoiq bôn ar-vai tu-mống.” A-dam talloiq lư la cơt bôn chức têq dyôn callong tu-mống. <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />Ma tới cháq tớq pilŏ́ng bôn nsuôi, ma la cháq tớq pang ndô, vít ngki náq cháq át tớq pilŏ́ng. <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />Ti-cuôi tôm lư tớq te cu-teq, la ti-cuôi ưlla na cu-teq. Ti-cuôi ta-tun tớq te pilŏ́ng. <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />Ti-cuôi ưlla te cu-teq ngki i-mo, ngki máh ti-cuôi ưlla na cu-teq mu chứng iki; a-lứng Án ưlla na pilŏ́ng i-mo, ngki máh ti-cuôi ưlla te pilŏ́ng mu chứng iki. <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />A-rớq top he khoiq bôn ar-maiq na ti-cuôi ưlla te cu-teq, top he mu chứng cóq rớp a-rớq na Án ưlla te pilŏ́ng.<verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />Hoi ndô, em ai ơi, cư seq tông par-nai ndô idô sac sáiq a-lứng a-ham lớiq bôn át tớq cruông na Yang Arbang Pilŏ́ng. Nốh rúng a-buôiq lư lớiq bôn át a-lứng nốh lớiq rúng a-buôiq. <verse eid="1CO 15:50" /><verse number="51" style="v" sid="1CO 15:51" />Me ndô, cư dyôn i-nha chom mui callong ca-tốq: Lớiq a-mớh cứp náq top he lư cu-chet, ma cứp náq top he lư cơt ta-pliêt, <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />ndóng ngki táp, tớq car-báih mát, dyơ siêng plŏ́ng tang-coi. Co siêng plŏ́ng tang-coi, a-lứng máh ti-cuôi cu-chet lư yôr tu-mống liêh tớq cháq lớiq bôn rúng a-buôiq, dyơ top he lư cơt rớp ndái loi. <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />Co khoiq a-nát cháq rúng a-buôiq ndô cóq ial sứp callong lớiq cu-chet, a-lứng cháq cóq cu-chet ndô cóq ial sứp callong lớiq cu-chet. <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />Dyơ ndóng cháq rúng a-buôiq ndô khoiq ial sứp te lớiq têq pít, a-lứng cháq cóq cu-chet ndô khoiq ial sứp te lớiq têq pít, ki ndóng ngki par-nai khoiq ta-ran, lư cơt iki:</para>
  <para style="q1" vid="1CO 15:54">“Callong cu-chet khoiq pít dyơ tớq callong tu-mống.”<verse eid="1CO 15:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="1CO 15:55" />“Ơi Callong cu-chet, callong chíl rap te mái tu-mo?</para>
  <para style="q1" vid="1CO 15:55">Ơi callong cu-chet, pih na mái tu-mo?”<verse eid="1CO 15:55" /></para>
  <para style="m">
    <verse number="56" style="v" sid="1CO 15:56" />Ma pih na callong cu-chet la cơt luaih, ma chức na callong luaih la phep rit. <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />Ma mŏp sang Yang Arbang Pilŏ́ng par-nai si-ơn, Án dyôn ada top he bôn rap te Yang top he, Yang Choi Ta-mống Yê-su! <verse eid="1CO 15:57" /><verse number="58" style="v" sid="1CO 15:58" />Co iki, em ai a-moih lư na cư ơi, cóq cơt ada khớm, êq táh a-tức, dyơ iki níc clưi cliai tớq ar-náq Yang, co chom idô callong diêiq a-rức na i-nha lớiq bôn la lớiq tar-náp tớq Yang.<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />Te ar-náq tar-choi práq dyôn máh ti-cuôi tin, a-rớq cư khoiq ca to dyôn máh top tin cruông Ca-la-ti, i-nha cóq táq mu chứng a-rớq ngki. <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />Cứp i-ngái mui tún, chư mu náq te i-nha cóq dŏq práq mmar, mui phê máh práq khoiq bôn khán ti-cuôi ngki táiq plới bôn lơi, dŏq ndóng cư tớq, lư lớiq túh cóq pa-chúng a-mớh nnáng chón ngki. <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />Ma, ndóng cư tớq, khán i-nha sŏ́ng can-nính ti-cuôi mmo, cư lư yua nha-án dông crơng tar-choi na i-nha a-lứng chớiq tớq nga Yaru-salem. <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />Ma khán ar-náq ngki lư la ar-náq crái dŏq cư cóq pôq, nha-án lư pôq a-lứng cư. <verse eid="1CO 16:4" /><verse number="5" style="v" sid="1CO 16:5" />Ma cư lư tớq nga i-nha dyơ vít cư khoiq pôq na Ma-sa-dôn, co cư chón pôq pha na Ma-sa-dôn. <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />Dyơ têq cư lư át liêh a-lớng i-nha, a-láng díh ki-sái ng-ngiat, dŏq i-nha têq a-suôi cư pôq cứp ntúq, khán cư ính pôq nga tu-mo. <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />Co cư i-yốh ính tar-múh i-nha hoi ngki chón pôq na car-na, co cư ng-cong át níc a-lứng i-nha dyôn dưnh, khán Yang dyôn. <verse eid="1CO 16:7" /><verse number="8" style="v" sid="1CO 16:8" />Ma cư lư át liêh tớq Ê-phê-sô ti-ngôi tớq I-ngái Cha Bui I-ngái Si-sot. <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />Co mui ngáh callống pớh a-lứng tar-náp khoiq dŏq pốh ada cư, ma a-ưi nốh can-nŏ́h ngki chón ca-táng cư.<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />Ma, khán Ti-mu-thê tớq, cóq pa-sôl ŏ dŏq án át a-lứng i-nha ma ớq sáng a-chiêt a-mớh, co án la chón táq ar-náq Yang, mu chứng a-rớq cư. <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />Co iki ớq bôn nnáu têq ayê án. Ma cóq choi án pôq iên ŏ, dŏq án têq pôq nga cư, co cư át ng-cong án mu nơi a-lứng máh em ai can-nŏ́h. <verse eid="1CO 16:11" /><verse number="12" style="v" sid="1CO 16:12" />Ma te ndon em ai A-blô, cư khoiq táh rêng a-liam án dŏq dyôn án tớq nga i-nha a-lứng máh em ai can-nŏ́h, ma ngki tới la can-nính na án a-mớh têq án pôq ndóng ndô táp. Ma án lư pôq dyơ piaiq i-ngái.<verse eid="1CO 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />Cóq mmứng a car-siat; cóq ta-yứng khớm tớq callong tin; cóq bôn mít can-nính clŏ́q; a-lứng cóq rêng. <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />Cóq dŏq cứp ar-náq na i-nha têq cơt tớq callong a-moih.<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />Hoi ndô, em ai ơi, cư ính pa-táp i-nha (i-nha chom ti-cuôi mu dúng na Sê-pha-na, dyơ nha-án la tôm lư tin Yang tớq A-chai, a-lứng nha-án khoiq nhéq tar-ngứh te ar-náq tar-choi máh ti-cuôi tin), <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />dŏq dyôn i-nha cóq cam-máng máh ti-cuôi a-rớq ngki díh nhéq náq máh ti-cuôi mu nơi táq ar-náq a-lứng chiuq diêiq a-rức. <verse eid="1CO 16:16" /><verse number="17" style="v" sid="1CO 16:17" />Cư sáng bui te ar-náq Sê-pha-na, Phôt-tu-na a-lứng A-chai-cơ tớq, co nha-án khoiq choi máh crơng a-mớh yôl lớiq khám ndon te i-nha. <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />Co nha-án khoiq táq bui liêh mít can-nính na cư a-lứng na i-nha. Iki, cóq náp máh ti-cuôi a-rớq ngki.<verse eid="1CO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />Máh top tin tớq cruông A-siê cơiq par-nai car-bánh nga i-nha. A-cui-la a-lứng Ba-rit-sin, mu nơi a-lứng top tin rum tớq dúng na nha-án, cơiq par-nai car-bánh i-nha tin Yang. <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />Nhéq máh em ai car-bánh car-suanh i-nha. Cóq car-bánh tar-tuôq na car-cháng bui ŏ.<verse eid="1CO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />Par-nai car-bánh ndô la co lư ati cư — Phau-lô. <verse eid="1CO 16:21" /><verse number="22" style="v" sid="1CO 16:22" />Khán ti-cuôi mmo lớiq a-moih Yang, ti-cuôi ngki cóq chiuq callong pu-pap! Ơi Yang na he a-cái, seq I-nha tớq! <verse eid="1CO 16:22" /><verse number="23" style="v" sid="1CO 16:23" />Callong choi mat te Yang Yê-su át a-lứng i-nha. <verse eid="1CO 16:23" /><verse number="24" style="v" sid="1CO 16:24" />Callong a-moih te cư át a-lứng nhéq náq i-nha tớq Yang Choi Ta-mống Yê-su. A-men.<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>