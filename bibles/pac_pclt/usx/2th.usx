  <para style="ide">UTF-8</para>
  <para style="h">2 Thessalonians</para>
  <para style="toc1">Chớiq A-lang Tê-salô-ni-ca Bar</para>
  <para style="toc2">Tê-salô-ni-ca Bar</para>
  <para style="toc3">2Th</para>
  <para style="mt">Tê-salô-ni-ca Bar</para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />Phau-lô a-lứng Si-la nha Ti-mu-thê, cớiq dyôn Top tin Tê-salô-ni-ca tớq Yang Arbang Pilŏ́ng, A-ám a-lứng Yang top he, Yang Choi Ta-mống Yê-su. <verse eid="2TH 1:1" /><verse number="2" style="v" sid="2TH 1:2" />Seq callong choi mat a-lứng callong iên ŏ tớq te Yang Arbang Pilŏ́ng, A-ám, a-lứng Yang Choi Ta-mống Yê-su, át tớq i-nha.<verse eid="2TH 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />Em ai ơi, top he cóq lư si-ơn Yang Arbang Pilŏ́ng te i-nha, co ngki la ar-náq piaiq lư, co callong tin i-nha cứp i-ngái rêng a-sớr, a-lứng callong ar-moih na cứp náq ti-cuôi tớq nhéq máh i-nha ada têq mu náq a-moih mu náq a-ưi lư loi; <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />tar-lúh top he a-sớr cháq báq ayô i-nha tớq mát máh top tin na Yang Arbang Pilŏ́ng te callong chiuq ta-nhir na i-nha a-lứng callong tin co bôn mít can-nính te ngai táq na i-nha, a-lứng cứp nốh diêiq a-rức ma i-nha cóq chiuq, <verse eid="2TH 1:4" /><verse number="5" style="v" sid="2TH 1:5" />tíc te callong tar-sưq ti-nớng tu-pứng na Yang Arbang Pilŏ́ng táq dyôn i-nha dŏq têq bôn tar-náp a-lứng cruông na Yang Arbang Pilŏ́ng, te cruông ngki ma i-nha lư chiuq diêiq a-rức; <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />co ar-lớih lư ti-nớng tu-pứng ndóng Yang Arbang Pilŏ́ng car-liêh dơq callong a-rức tớq máh ti-cuôi táq diêiq a-rức ada i-nha, <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />a-lứng dyôn ada i-nha, la máh ti-cuôi chiuq diêiq a-rức, callong át a-ngô a-lứng top he ndóng tớq i-ngái na Yang Yê-su a-páh te pilŏ́ng a-lớng máh tar-neng ndon bôn chức te Án, <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />te pla uih chŏ́ng, dông callong tar-sưq tớq dyôn máh ti-cuôi lớiq chom Yang Arbang Pilŏ́ng a-lứng dyôn máh ti-cuôi lớiq peh par-nai ŏ na Yang top he, Yang Yê-su, <verse eid="2TH 1:8" /><verse number="9" style="v" sid="2TH 1:9" />ngki la máh ti-cuôi ính ráp tôt — la callong pu-pít sút pang, át yông te Yang a-lứng lớiq ayô te chức sút pưt Án, <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />dyơ Án tớq dŏq têq cứh ayô te máh top tin na Án a-lứng bôn sáng te cứp náq ti-cuôi khoiq náp callong tin, co par-nai ca to na top he dyôn ada i-nha tớq i-ngái ngki khoiq bôn ráp tin. <verse eid="2TH 1:10" /><verse number="11" style="v" sid="2TH 1:11" />Co iki, top he lư át cớu seq dyôn i-nha dŏq Yang Arbang Pilŏ́ng top he choi i-nha lư tar-piaiq dŏq rêh arô, a-lứng Án táq piaiq cứp ar-náq par-ngíh ính táq te ar-náq ŏ mu chứng ar-náq na callong tin co chức sút, <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />dyôn nốh na Yang top he, Yang Yê-su, bôn cứh ayô te i-nha a-lứng i-nha bôn iên ŏ te Án, veng callong choi mat na Yang Arbang Pilŏ́ng a-lứng Yang top he, Yang choi Ta-mống Yê-su.<verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />Em ai ơi, ma tư tớq liêh na Yang top he, Yang Choi Ta-mống Yê-su, a-lứng cơt bôn rum mu nơi na top he a-lứng Án, top he seq i-nha <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />ar-lớih i-nha êq chái sáng a-dáh lớiq la sáng dut te mít can-nính bôm, êq náp co ngai ton, lớiq la co mui callong ta-ran, lớiq co chớiq a-lang mu chứng a-rớq tớq te top he, dyơ tông idô i-ngái na Yang khoiq tớq dyơ. <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />Lớiq bôn nnáu veng cứp nốh ngê mmo ma ính pi-lốh i-nha, khán bôn clứng ti-cuôi chíl Yang tớq nsuôi, a-lứng a-cái ti-cuôi na callong ớq phep rit bôn a-páh, ngki la a-cái na callong cu-chet pít, <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />la ti-cuôi tar-píh sút a-lứng báq a-sớr cháq bôm tông án pưt hơn te yang ngai báq sang tông án la yang pưt hơn te yang can-nŏ́h ngai sang, tar-lúh án mot ti-cu tớq dúng sang na Yang Arbang Pilŏ́ng, dyơ án ngin idô lư Yang Arbang Pilŏ́ng. <verse eid="2TH 2:4" /><verse number="5" style="v" sid="2TH 2:5" />I-nha lớiq ayư ar-lớih, ndóng yôl át a-lứng i-nha, cư khoiq dyôn i-nha chom máh ar-náq ndô? <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />A-lứng hoi ndô i-nha khoiq chom nnáu chón ca-táng, dŏq án tớq nưm bôn mpáh te piaiq ngư na án. <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />Co callong ca-tốq na ar-náq lới khoiq bôn dyơ, Án táp nưm chón ca-táng ar-náq ngki hoi ndô ma yôl tớq díh Án ngốh vít lớiq ca-táng nnáng ar-náq lới ngki lư tớq, <verse eid="2TH 2:7" /><verse number="8" style="v" sid="2TH 2:8" />a-lứng dyơ ti-cuôi ndon lới cơt bôn mpáh, la ti-cuôi ma Yang Yê-su lư pu-pít na ca-hơ ndon ngốh te ng-cang Án, a-lứng lư táq án dyôn cơt ớq tar-náp co ang ưr tớq liêh nga cúc cu-teq ndô na Án, <verse eid="2TH 2:8" /><verse number="9" style="v" sid="2TH 2:9" />ma cơt mpáh na án ndon lới ngki nhơ te ar-náq na yang sáq te cứp nốh bôn chức têq táq ar-náq si-leh, a-rớq máh ar-náq laq lớiq tưr a-mớh, <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />nha a-lứng a-ưi cứp nốh ar-náq saq ndon ớq tar-náp táq dyôn máh ti-cuôi cơt rúng, ma nha-án cơt rúng la co nha-án khoiq lớiq ráp callong ar-moih callong piaiq dyôn cháq bôm dŏq têq choi ta-mống. <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />A-lứng co iki táp, Yang Arbang Pilŏ́ng dyôn nha-án bôn ngê lớiq crái dŏq nha-án tin callong a-uai, <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />táq dyôn cứp náq nha-án cơt ngai lư sưq, ngki la máh ti-cuôi lớiq tin callong piaiq, ma sáng bui táq ar-náq lớiq ti-nớng.<verse eid="2TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />Ma, em ai ơi, i-nha khoiq Yang a-moih, top he cóq lư si-ơn Yang Arbang Pilŏ́ng te i-nha. Co Yang Arbang Pilŏ́ng khoiq rêh i-nha a-rớq máh cu-lái mbơiq cơt dŏq ráp callong choi ta-mống nhơ án dyôn mít can-nính cơt práh ŏ na Ar-vai a-lứng ng-cong te callong piaiq. <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" />Co dŏq ráp callong ngki, Án khoiq rêh arô i-nha co nhơ par-nai ŏ Yang na top he, khoiq dyôn i-nha chúng tưi chức ang ưr na Yang top he, Yang Choi Ta-mống Yê-su. <verse eid="2TH 2:14" /><verse number="15" style="v" sid="2TH 2:15" />Co iki, em ai ơi, cóq át a-vứng a-lứng ca-pol a-khớm máh rit ndon i-nha khoiq cơi ca to, tông na ng-cang lớiq la na chớiq a-lang te top he.<verse eid="2TH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16" />Lư Yang top he, Yang Choi Ta-mống Yê-su, a-lứng Yang Arbang Pilŏ́ng, A-ám top he, Án a-moih top he a-lứng choi mat top he án khêr díh sút pang a-lứng callong ng-cong bui ŏ te callong choi mat, <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />seq Án khêr níc a-lứng táq dyôn cơt rêng mít can-nính i-nha dŏq táq cứp ar-náq mu chứng táq ntêr cứp callong ŏ.<verse eid="2TH 2:17" /></para>
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />Talloiq lư, em ai ơi, seq cớu dyôn top he, dyôn par-nai te Yang chái tớq cứp cruông a-lứng têq cứh ayô, mu chứng a-rớq te i-nha, <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />a-lứng dŏq top he bôn tar-cláh vít te máh ti-cuôi táq pla-mpla a-lứng ti-cuôi lới, co lớiq bôn nhéq ti-cuôi bôn callong tin. <verse eid="2TH 3:2" /><verse number="3" style="v" sid="2TH 3:3" />Ma Yang, Án lư táq dyôn khớm a-lứng kiaq me i-nha vít te ti-cuôi saq, Án la ti-nớng tu-pứng. <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />Top he tin ar-lớih nga Yang te i-nha idô i-nha chón táq a-lứng ính táq máh callong top he tông ca to. <verse eid="2TH 3:4" /><verse number="5" style="v" sid="2TH 3:5" />Seq Yang a-yông mít can-nính i-nha ayư te callong ar-moih na Yang Arbang Pilŏ́ng a-lứng tớq callong ta-nhir na Yang Choi Ta-mống.<verse eid="2TH 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />Ma iki, em ai ơi, nhơ te nốh Yang top he Yang Choi Ta-mống Yê-su, top he pa-táp i-nha, dŏq i-nha viar yông te máh ti-cuôi tin tu-mống a-láh táq ar-náq a-lứng lớiq soi máh ngê ma i-nha khoiq rian te top he. <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />Co lư i-nha chom piaiq lư la cóq soi top he te callong ndô, te top he khoiq lớiq bôn tu-mống dyôn ớq tar-náp ada i-nha, <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />top he lư lớiq cha sớng crơng tan-na te mu náq ti-cuôi mmo, ma i-dáu i-ngái táq ar-náq lư ntáng a-lứng a-leq lư dŏq lớiq táq ntáng dyôn cứp náq ti-cuôi mmo te i-nha, <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />tới co top he lớiq bôn chức, ma dŏq top he têq bôn a-nốh bôm a-rớq táq ngôl dyôn i-nha dŏq soi top he. <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />Co tar-lúh ndóng top he yôl át a-lứng i-nha, top he tam khoiq pa-táp i-nha callong ndô, idô: “Khán ti-cuôi mmo lớiq ính táq ar-náq, ti-cuôi ngki êq dyôn chi-cha.” <verse eid="2TH 3:10" /><verse number="11" style="v" sid="2TH 3:11" />Co top he khoiq sáng dyơ ngai tông ada top i-nha bôn ti-cuôi tu-mống a-láh, lớiq ính táq ar-náq ma ính sái ti-cuôi can-nŏ́h sớng. <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />Ma tớq Yang, Yang Choi Ta-mống Yê-su, top he pa-táp a-lứng dyŏq máh ti-cuôi a-rớq ngki, táq dyôn nha-án bôn crơng tan-na na nha-án tư táq ar-náq a-lứng callong iên ŏ. <verse eid="2TH 3:12" /><verse number="13" style="v" sid="2TH 3:13" />Ma i-nha, i-nha êq a-leq a-láh ndóng táq ar-náq piaiq. <verse eid="2TH 3:13" /><verse number="14" style="v" sid="2TH 3:14" />Ma, khán ti-cuôi mmo lớiq cam-máng par-nai top he na chớiq ndô, ki cóq mmứng ti-cuôi ngki — dŏq lớiq par-chúng a-lớng án, dyôn têq ti-cuôi ngki chom bôm a-chiêt. <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />Êq me ti-cuôi ngki a-rớq ti-cuôi pi-con, ma cóq dyŏq a-rớq mu náq em ai.<verse eid="2TH 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />Cớu seq lư Yang ndon iên ŏ dyôn ada i-nha callong iên ŏ te máh ar-náq tớq cứp i-nha táq. Yang át níc a-lứng cứp náq i-nha. <verse eid="2TH 3:16" /><verse number="17" style="v" sid="2TH 3:17" />Par-nai car-bánh ndô lư te ati cư — Phau-lô — ngki la chưq tíc tớq cứp chớiq a-lang. Cư báq ta-ran a-rớq ngki. <verse eid="2TH 3:17" /><verse number="18" style="v" sid="2TH 3:18" />Seq callong choi mat na Yang top he, Yang Choi Ta-mống Yê-su, át a-lứng cứp náq i-nha.<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>