  <book code="MAT" style="id">EN_PCLT pac_Pacoh_ltr Thu Apr 09 2026 09:33:32 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Matthew</para>
  <para style="toc1">Par-nai ŏ Ma-thiê</para>
  <para style="toc2">Matthew</para>
  <para style="toc3">Mat</para>
  <para style="mt">Ma-thiê</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Te tŏ́ng toiq na Yang Choi Ta-mống Yê-su, a-cái a-cháu Da-vit, a-cái a-cháu A-pra-ham: <verse eid="MAT 1:1" /><verse number="2" style="v" sid="MAT 1:2" />A-pra-ham ca-nian I-sac, I-sac ca-nian Ya-côp, Ya-côp ca-nian Yu-da a-lứng em ai na án, <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />Yu-da co Ta-ma ca-nian Phê-rêt nha Sê-rách, Phê-rêt ca-nian Hêt-rôn, Hêt-rôn ca-nian A-ram, <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />A-ram ca-nian A-mi-na-dap, A-mi-na-dap ca-nian Na-ach-son, Na-ach-son ca-nian Sanh-môn, <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />Sanh-môn co Ra-hap ca-nian Bô-ô, Bô-ô co Ru-tơ ca-nian Ô-bêt, Ô-bêt ca-nian Yê-sê, <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />Yê-sê ca-nian puô Da-vit, Da-vit co cam-pái na U-ri ca-nian Sa-la-môn.<verse eid="MAT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 1:7" />Sa-la-môn ca-nian Rô-bô-am, Rô-bô-am ca-nian A-bi-ya, A-bi-ya ca-nian A-sa, <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />A-sa ca-nian Yô-sa-phat, Yô-sa-phat ca-nian Yô-ram, Yô-ram ca-nian Ô-siê. <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Ô-siê ca-nian Yô-tam, Yô-tam ca-nian A-cha, A-cha ca-nian Ê-sê-chiê, <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Ê-sê-chiê ca-nian Ma-na-se, Ma-na-se ca-nian A-môn, A-môn ca-nian Yô-si-a, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Yô-si-a ca-nian Yê-cô-nia nha em ai na án ma ndóng ngki ngai yua át nga Ba-bi-lôn.<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />Ngki vít te pôq át nga Ba-bi-lôn, Yê-cô-nia ca-nian Sa-la-thi-el, Sa-la-thi-el ca-nian Sa-ru-ba-bel, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />Sa-ru-ba-bel ca-nian A-bi-ut, A-bi-ut ca-nian Ê-liê-kim, Ê-liê-kim ca-nian A-sô, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />A-sô ca-nian Sa-dôc, Sa-dôc ca-nian A-chim, A-chim ca-nian Ê-li-ut, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Ê-li-ut ca-nian Ê-liê-sa, Ê-liê-sa ca-nian Ma-than, Ma-than ca-nian Ya-côp, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />Ya-côp ca-nian Yô-sep, ca-yiêq na Ma-ri, co te án, Yang Yê-su, Án ngai dŏq la Yang Choi Ta-mống, khoiq car-nian. <verse eid="MAT 1:16" /><verse number="17" style="v" sid="MAT 1:17" />Iki, nhéq tưh cứp pang te A-pra-ham tớq Da-vit khoiq mu chít la puan pang, tư Da-vit tớq ngai yua át nga Ba-bi-lôn khoiq mu chít la puan pang, a-lứng te ngai yua át nga Ba-bi-lôn tớq Yang Choi Ta-mống khoiq mu chít la puan pang.<verse eid="MAT 1:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Te car-nian na Yang Choi Ta-mống Yê-su la idô: Ndóng Ma-ri, a-i Án, khoiq ưq táq cam-pái ada Yô-sep, ma nsuôi ndóng nha-án táq cha mu nơi, ma-ri khoiq át cháq iki co te Yang Ar-vai. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Ma Yô-sep, ca-yiêq án, la ti-cuôi ti-nớng ŏ, a-lứng co lớiq ính par-hanh cháq iki te ma-ri, án át par-ngíh ính táh ma-ri. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />Ma ndóng Yô-sep chón át par-ngíh te máh ar-náq ngki, dyơ tớq táp, tar-neng na Yang ta-hôm ada án tớq par-náu, tông: “Yô-sep a-cái a-cháu Da-vit, mái êq a-chiêt ial Ma-ri táq cam-pái, co a-cái két cơt tớq pallúng na ma-ri ngki la co te Yang Ar-vai. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Án ca-nian mui a-cái conh, cóq mái a-nốh nốh án la Yê-su, co a-cái ngki choi ta-mống nhéq máh ti-cuôi án vít te callong luaih nha-án.” <verse eid="MAT 1:21" /><verse number="22" style="v" sid="MAT 1:22" />Máh ar-náq ndô cơt dŏq têq tar-vớiq par-nai khoiq Yang tông na ti-cuôi tang ng-cang, idô:<verse eid="MAT 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="MAT 1:23" />“Áu me ntíh, cán cu-mor plŏt cơt át cháq iki a-lứng ca-nian mui a-cái conh, nha ngai dŏq a-nốh Án la Em-ma-nu-êl” — bôn ti-toiq liêh la “Yang Arbang Pilŏ́ng át a-lứng top he.”<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Dyơ ndóng ayư te bíq, Yô-sep khoiq táq a-rớq tar-neng na Yang khoiq tông pa-táp yua ial ma-ri ngki táq cam-pái án. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Ma mái lớiq táq át cha mu nơi a-lứng cán ngki dyôn díh ndóng án ca-nian mui a-cái conh. Dyơ mái dŏq a-nốh a-cái ngki la Yê-su.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Dyơ Yang Yê-su khoiq bôn car-nian tớq Bet-la-hem cruông Yu-dê tớq pang puô Hê-rôt, áu me ngki, máh ti-cuôi ndon rian te pan-tôr tớq nga Yaru-salem, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />plốh idô: “Án ndon khoiq car-nian la Puô ti-cuôi Isa-ra-el tớq mmo? Co top he khoiq hôm pan-tôr na Án te mát pan-dang ngốh ngki tớq ính sang tám Án.” <verse eid="MAT 2:2" /><verse number="3" style="v" sid="MAT 2:3" />Ma dyơ bôn sáng par-nai ngki, puô Hê-rôt sáng cróq lư, a-lứng díh vel Yaru-salem mu chứng a-rớq án. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Dyơ án doi pa-chúng nhéq máh thới teng rit sang a-lứng máh thới sái rit tớq top nha-án, án plốh nha-án: “Yang Choi Ta-mống bôn car-nian tớq mmo?” <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Nha-án ôi ada puô: “Tớq Bet-la-hem vúng Yu-dê, co khoiq dŏq ta-ran iki te ti-cuôi tang ng-cang,<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />‘Ma Bet-la-hem, cruông Yu-da,</para>
  <para style="q1" vid="MAT 2:6">mái lớiq bôn ngki két tháng te máh vel pưt na cruông Yu-da,</para>
  <para style="q1" vid="MAT 2:6">co te mái cơt ngốh mu náq Án ndon sút</para>
  <para style="q1" vid="MAT 2:6">la Án kiaq me Isa-ra-el, prái Cư.’”<verse eid="MAT 2:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 2:7" />Ndóng ngki, vít dyơ clôp arô máh ti-cuôi tu-báiq tớq, Hê-rôt plốh nha-án ali mmo mpáh na pan-tôr. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Dyơ yua nha-án pôq nga Bet-la-hem, án pa-táp: “Ndóng pôq, top i-nha plốh car-siat lư te a-cái két, dyơ ndóng top i-nha bôn tu-múh, cóq ntêr ada cư dŏq cư ính tớq sang tám Án.” <verse eid="MAT 2:8" /><verse number="9" style="v" sid="MAT 2:9" />Cua bôn sáng par-nai puô, nha-án pôq táp, a-lứng me ntíh, pan-tôr ndon nha-án khoiq bôn hôm át te mát pan-dang ngốh pôq nsuôi nha-án ti-ngôi dyơ ndóng tớq pan-tôr ngki ta-yứng tớq ntúq a-cái két át. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Ndóng bôn hôm pan-tôr, nha-án hêl ayô sáng bui ơn lư. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Tư dyơ mot tớq dúng, nha-án hôm a-cái két a-lứng Ma-ri, a-i Án. Dyơ ndóng chóh tar-col ngki nha-án sang tám Án, a-lứng ndóng nha-án pốh crơng ngáih na nha-án ngki, nha-án mŏp sang dyôn Án máh crơng ngáih: dyeng, ca-lớu rŏq nha sêt thum. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />A-lứng co khoiq dŏq ca-tớih êq píh chô nnáng a-lứng Hê-rôt ndóng tớq par-náu, nha-án chô nga cruông nha-án na car-na can-nŏ́h.<verse eid="MAT 2:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Ndóng nha-án khoiq pôq dyơ, ngki me ntíh, mu náq tar-neng na Yang tớq nga Yô-sep na par-náu mpáu, tông idô: “Ayư te bíq, mái dông a-cái két nha a-i Án dyơ pôq nga Ê-yip-tô, dyơ át liêh tớq ngki dyôn díh ndóng mmo cư yua mái, co Hê-rôt át suô a-cái Két ính ca-chet Án táp.” <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Dyơ ndóng ayư te bíq, án lư dông a-cái két a-lứng a-i Án viar pôq nga Ê-yip-tô táng tar-di i-dáu, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />a-lứng Yô-sep át tớq ngki ti-ngôi díh Hê-rôt cu-chet, ngki lư cơt tar-vớiq nốh ndon khoiq tông co Yang dyôn na ti-cuôi tang ng-cang, idô: “Cư khoiq arô A-cái Cư ngốh te Ê-yip-tô.”<verse eid="MAT 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Ndóng ngki, dyơ chom ar-lớih án khoiq máh ti-cuôi tu-báiq ayê pan-dyớp, Hê-rôt sáng nháih lư, ngki yua táp líng án ca-chet nhéq máh ngai a-cái conh tư bar cu-mo a-siar tớq Bet-la-hem a-lứng nhéq máh pa-niar tớq cruông ngki, veng a-rớq i-ngái ndon án khoiq plốh te máh ti-cuôi tu-báiq. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Iki lư cơt tar-vớiq par-nai khoiq dŏq tông na tang ng-cang Yê-rê-mi, idô:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />“Siêng ngai hiar cơt bôn sáng te vel Ra-ma,</para>
  <para style="q1" vid="MAT 2:18">siêng nhiêm hiar a-lứng cu-cloiq cu-cling,</para>
  <para style="q1" vid="MAT 2:18">Ra-chel nhiêm a-lang máh a-cái án,</para>
  <para style="q1" vid="MAT 2:18">a-lứng án lớiq cam-máng ngai khêr, co a-cái án ớq yôl nnáng.”<verse eid="MAT 2:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Dyơ ngki, ndóng Hê-rôt khoiq nhéq pang, ngki me ntíh, mu náq tar-neng te Yang tớq a-páh ada Yô-sep na par-náu mpáu tớq Ê-yip-tô, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />tông idô: “Ndóng ayư te bíq, mái dông a-cái két a-lứng a-i a-cái két ngki dyơ pôq nga cruông Isa-ra-el, co máh ti-cuôi ính ca-chet cháq na a-cái két khoiq cu-chet.” <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />Dyơ ndóng ayư te bíq, án dông a-cái két a-lứng a-i Án, a-lứng mot nga cruông Isa-ra-el. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Ma, ndóng bôn sáng i-mo A-chê-la-u cơt puô tớq cruông Yu-dê cláp Hê-rôt, a-ám án, án lớiq dáh pôq nga tu-ki. Ma co khoiq cua dŏq tông na par-náu, án píh chô nga cruông Ca-li-lê, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />a-lứng ndóng tớq nga tu-ki, án át tớq mui vel ngai dŏq la Na-sa-ret, dŏq cơt tar-vớiq par-nai khoiq dŏq tông na máh ti-cuôi tang ng-cang, i-mo Án lư ngai dŏq la ti-cuôi Na-sa-ret.<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Tớq máh i-ngái ngki, Yon táq tíc na dơq tớq ca to tớq ntúq aih cruông Yu-dê, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />idô: “Cóq piên mít tam-me, co cruông tớq pilŏ́ng khoiq tar-mán.” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Co ndô la ti-cuôi ndon khoiq taq-ntêr te tang ng-cang Ê-sai, idô:</para>
  <para style="q1" vid="MAT 3:3">“Bôn siêng ti-cuôi tu-bau yứng tớq ntúq aih:</para>
  <para style="q1" vid="MAT 3:3">‘Cóq sa dŏq car-na na Yang,</para>
  <para style="q1" vid="MAT 3:3">cóq táq dyôn ti-nớng máh par-yéh Án.’”<verse eid="MAT 3:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Yon ndô tớc tam-pớc te sóc lac-da, ca-tớn pa-eu ng-cár tớq tar-ving, ma tan-na na án ngki a-liêm nha dơq can-yiêl a-rưih. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Dyơ prái vel Yaru-salem, díh cruông Yu-dê a-lứng chuôp máh ti-cuôi át pa-niar dơq Yôr-dan tớq nga án, <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />dyơ ndóng ngin luaih bôm, nha-án ngki án táq tíc na dơq tớq dơq Yôr-dan. <verse eid="MAT 3:6" /><verse number="7" style="v" sid="MAT 3:7" />Tư dyơ bôn hôm clứng ti-cuôi Pha-ra-si a-lứng ti-cuôi Sa-du-sê tớq co ính táq tíc na dơq te án, án tông ada nha-án: “I-nha la tŏ́ng toiq na cu-sánh pih ntíh! Nnáu khoiq taq-ntêr top i-nha lúh te callong ính táq tar-mán tớq? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Iki, cóq táq ar-náq crái piaiq a-lứng piên mít tam-me. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />A-lứng i-nha ngki êq par-ngíh dyơ taq-ntêr tar-tuôq: ‘Top he bôn a-chúc a-chiac A-pra-ham.’ Co cư tông ada i-nha i-mo Yang Arbang Pilŏ́ng têq táq dyôn rứh a-cái a-cháu dyôn A-pra-ham te máh cúc búl ndô. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Ma pla a-chát khoiq dŏq tu-páh tớq riaih a-long dyơ. Iki, nhéq máh a-long khán lớiq cơt cu-lái ŏ ngki ngai cớl pa-dứm dyơ a-dúh tớq uih. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />Cư táq tíc na dyơ te callong ngin luaih dyôn i-nha na dơq. Ma Án tớq ta-tun cư bôn chức ta-niêng cư, te Án ngki cư la ti-cuôi lớiq crái díh tu-yóng cơp na Án. Án táq tíc dyôn i-nha na Yang Ar-vai a-lứng na uih; <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />car-raih na Án át tớq ati Án, dyơ Án cưa práh lư ntúq púh sro án dyơ pa-chúng sro chong na Án tớq ta-nic. Ma Án chóng viang ndyŏq sro a-cam tớq uih lớiq têq pu-pát nnáng.”<verse eid="MAT 3:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Ndóng ngki, Yang Yê-su te cruông Ca-li-lê pôq nga dơq Yôr-dan, ntúq na Yon, dŏq án táq tíc na dơq. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Ma Yon át ca-táng Án, idô: “Cư táp lư ính bôn Ca-na táq tíc na dơq dyôn, iki ma Ca-na tớq nga cư?” <verse eid="MAT 3:14" /><verse number="15" style="v" sid="MAT 3:15" />Ma ndóng ính ôi liêh, Yang Yê-su tông ada án: “Hoi ngki, cóq táq táp, co iki la crái piaiq ada top he dŏq táq nhéq cứp nốh ti-nớng ŏ.” Dyơ Án dyôn án táq. <verse eid="MAT 3:15" /><verse number="16" style="v" sid="MAT 3:16" />Dyơ ngki, vít ndóng yon táq tíc na dơq, Yang Yê-su ngki táp sớr te dơq, a-lứng me ntíh, máh lưp pilŏ́ng cơt ta-pốh dyôn Án, dyơ bôn hôm Yang Ar-vai na Yang Arbang Pilŏ́ng siar a-rớq a-chếq ca-cu, trúp tớq Án, <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />dyơ me ngki, bôn siêng tu-bau te máh lưp pilŏ́ng idô: “Ndô la A-cái par-láng na Cư. Cư sáng bui te A-cái ngki.”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Dyơ Yang Yê-su bôn pôq nga ntúq aih co Yang Ar-vai dŏq ta-nhir yang sáq ta-luiq. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Vít ngki, án ót tan-na puan chít i-ngái a-lứng puan chít i-dáu, Án pi-nhaih. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Dyơ tớq tar-mán, yang sáq ta-luiq tông ada Án: “Khán mái lư A-cái Yang Arbang Pilŏ́ng, áu mái yua dŏq máh cúc búl ndô têq cơt beng táp.” <verse eid="MAT 4:3" /><verse number="4" style="v" sid="MAT 4:4" />Ma ôi liêh, Án tông: “Bôn par-nai khoiq ta-ran: ‘A-cái ti-cuôi tu-mống tới nưm nhơ beng ngki sớng, ma lư nhơ cứp par-nai ngốh te ng-cang Yang Arbang Pilŏ́ng.’” <verse eid="MAT 4:4" /><verse number="5" style="v" sid="MAT 4:5" />Dyơ yang sáq dông Án mot tớq vel pưt, dyôn Án ta-yứng tớq mpiên ndon a-yống lư na dúng sang, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />dyơ tông ada Án: “Khán mái lư A-cái Yang Arbang Pilŏ́ng, áu a-pŏ́ng mái siar pi-tốq, co bôn par-nai khoiq ta-ran, dyơ: ‘Án lư yua te a-cái dyôn máh tar-neng Án,’ a-lứng: ‘Nha-án ta-pông a-cái tớq ati nha-án, a-dáh dyưng a-cái piaiq crái nga búl.’”<verse eid="MAT 4:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Yang Yê-su ôi liêh án: “Ntúq can-nŏ́h, bôn par-nai khoiq ta-ran: ‘A-cái lư êq chim Yang, Yang Arbang Pilŏ́ng na a-cái.’” <verse eid="MAT 4:7" /><verse number="8" style="v" sid="MAT 4:8" />Mu chư loi, yang sáq dông Án sớq tớq plô cóh lư a-yống dyơ dyôn Án me nhéq cứp cruông tớq cúc cu-teq a-lứng callong ang ưr na nha-án. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />A-lứng yang sáq tông ada Án: “Cư lư dyôn mái nhéq máh nốh ndô, khán mái sang tám cư, na chóh tar-col.” <verse eid="MAT 4:9" /><verse number="10" style="v" sid="MAT 4:10" />Ndóng ngki, Yang Yê-su tông ada án: “Yang sáq mái tôi a-yông! Co bôn par-nai khoiq ta-ran: ‘A-cái lư sang tám Yang, Yang Arbang Pilŏ́ng na a-cái, a-lứng a-cái lư táq nưm ar-náq Án.’” <verse eid="MAT 4:10" /><verse number="11" style="v" sid="MAT 4:11" />Dyơ yang sáq tôi te Án, ndóng ngki táp, máh tar-neng tớq a-lứng ta-bớq táq ar-náq Án.<verse eid="MAT 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Ndóng ngki, dyơ bôn sáng hanh Yon khoiq ngai cŏp, Án chô nga vúng Ca-li-lê. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Ndóng khoiq ngốh te Na-sa-ret, Án pôq tu-mống tớq vel Ca-bê-na-um tar-mán dơq ving ca-vang, tớq cruông Sa-bu-lôn nha Nep-ta-li, <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />dyôn cơt tar-vớiq par-nai khoiq dŏq tông na tang ng-cang Ê-sai, idô:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“Cruông Sa-bu-lôn a-lứng cruông Nep-ta-li,</para>
  <para style="q1" vid="MAT 4:15">car-na pôq nga dơq ving ca-vang, pa dyang a-tŏ́h dơq Yôr-dan,</para>
  <para style="q1" vid="MAT 4:15">vúng Ca-li-lê na ti-cuôi tớiq ti-cuôi Isa-ra-el —<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />máh ti-cuôi ndon át tớq ntúq ngiau khoiq bôn hôm callong ang lư,</para>
  <para style="q1" vid="MAT 4:16">a-lứng ada máh ti-cuôi át tớq cruông cu-teq nha callong cu-chet,</para>
  <para style="q1" vid="MAT 4:16">callong ang khoiq claq nga nha-án.”<verse eid="MAT 4:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Tư i-ngái ngki, Yang Yê-su ta-bớq ca to a-lớng tông: “Cóq piên mít tam-me, co cruông tớq pilŏ́ng khoiq tớq tar-mán.” <verse eid="MAT 4:17" /><verse number="18" style="v" sid="MAT 4:18" />Dyơ ngki, ndóng Yê-su pôq na tor dơq Ca-li-lê, Án hôm bar náq em ai, Si-môn, ngai dŏq la Phi-er, a-lứng An-rê, a-em conh ngki, chón lai mben tớq dơq co nha-án la ar-náq suô buaiq. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Dyơ Án yua nha-án: “Áu pôq veng cư, ngki cư táq dyôn i-nha cơt máh ati lai mben ti-cuôi.” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Ndóng ngki táp, tư khoiq táh mben nha-án, nha-án veng ta-pun Án. <verse eid="MAT 4:20" /><verse number="21" style="v" sid="MAT 4:21" />Vít dyơ te ngki pôq loi, Án hôm bar náq em ai can-nŏ́h, Ya-cơ a-cái Sê-ba-dê, a-lứng Yon, a-em án, tớq tuôc mu nơi a-lứng Sê-ba-dê, a-ám nha-án, chón clam mben nha-án dyơ Án arô nha-án, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />dyơ ndóng ngki táp, táh tuôc ada a-ám nha-án, nha-án veng ta-pun Án.<verse eid="MAT 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />A-lứng Án pôq tu-dô tu-ki chuôp vúng Ca-li-lê, pau ca to tớq máh dúng rum na ti-cuôi prái, pau ntêr Par-nai ŏ Yang te cruông ang ưr, díh pa-lai bánh cứp nốh a-ái a-lớng cứp nốh tar-ma tớq máh ti-cuôi prái. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Par-hanh te Án cơt díh chuôp cruông Si-ri, nha ngai dông a-tớq nga Án máh ti-cuôi bôn a-ái, cơt bôn a-ưi callong a-ái a-lứng a-ái ca-dyúc can-nŏ́h, yang sáq pi-yúh, yúh ki-song, cớng cháq, dyơ Án pa-lai bánh dyôn nha-án. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Máh ti-cuôi clứng veng ta-pun Án te Ca-li-lê, Dê-ca-bô-lơ, Yaru-salem, Yu-dê a-lứng pa dyang a-tŏ́h dơq Yôr-dan.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Dyơ, tư hôm máh ti-cuôi clứng, Án sớr tớq mpiên cóh, a-lứng ndóng Án ti-cu, top ndon rian Án tớq nga Án. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Án pốh ta-cang ca to nha-án, idô:<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />“Bún lư máh ti-cuôi ndon ki-dit a-rức tớq ar-vai,</para>
  <para style="q2" vid="MAT 5:3">co cruông tớq pilŏ́ng la na nha-án.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Bún lư máh ti-cuôi ndon nhiêm,</para>
  <para style="q2" vid="MAT 5:4">co nha-án lư bôn callong khêr.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Bún lư máh ti-cuôi ndon mít lam-bŏt,</para>
  <para style="q2" vid="MAT 5:5">co nha-án cơt ưlla cruông cu-teq.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Bún lư máh ti-cuôi pi-nhaih a-lứng tel-sél ính táq ti-nớng ŏ,</para>
  <para style="q2" vid="MAT 5:6">co nha-án lư bôn sái.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Bún lư máh ti-cuôi cơi srui-táq,</para>
  <para style="q2" vid="MAT 5:7">co nha-án lư bôn srui-táq.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Bún lư máh ti-cuôi práh ŏ tớq mít can-nính,</para>
  <para style="q2" vid="MAT 5:8">co nha-án lư bôn hôm Yang Arbang Pilŏ́ng.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Bún lư máh ti-cuôi tar-dông ŏ,</para>
  <para style="q2" vid="MAT 5:9">co nha-án bôn ngai dŏq la top a-cái na Yang Arbang Pilŏ́ng.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Bún lư máh ti-cuôi tu-múh diêiq a-rức co te callong ti-nớng ŏ,</para>
  <para style="q2" vid="MAT 5:10">co cruông tớq pilŏ́ng la na nha-án.<verse eid="MAT 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 5:11" />I-nha bôn bún ndóng ngai táq i-nha, a-lứng pi-ốh dyơ tông cứp callong lớiq ŏ ton a-pít ada i-nha co te cư.<verse eid="MAT 5:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="MAT 5:12" />Cóq sáng bui nha ơn tam-prơl, co cống na i-nha lư pưt tớq cruông ang ưr, co ngai khoiq pi-ốh máh ti-cuôi tang ng-cang nsuôi i-nha a-rớq ngki.<verse eid="MAT 5:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />I-nha la boi tớq cu-teq. Ma khán boi ma lớiq báq, boi ngki lư táq dyôn báq na bớr a-mớh? Nưm ngai a-dúh cu-lai tiêh dyôn dếq ada ti-cuôi can-nŏ́h, boi ngki ớq tar-náp dyôn callong a-mớh nnáng. <verse eid="MAT 5:13" /><verse number="14" style="v" sid="MAT 5:14" />I-nha la callong ang tớq cúc cu-teq. Mui vel pưt át mpiên cóh ngki lớiq têq ca-tốq a-mớh. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />A-lứng ớq bôn nnáu bet den tớu dyơ dŏq den ngki tớq hip, ma lư ngai dŏq tớq a-ruông den, dyơ den ngki ta-bal ang dyôn cứp náq ti-cuôi tớq dúng. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Mu chứng, callong ang te i-nha cóq a-páh chứng mát ngai can-nŏ́h, táq i-mo nha-án bôn hôm máh ar-náq ŏ na i-nha dyơ cứh ayô A-ám na i-nha tớq pilŏ́ng.<verse eid="MAT 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />Êq par-ngíh i-mo cư khoiq tớq ính pu-pít phep rit lớiq la máh par-nai tang ng-cang. Cư tớq tới ính pu-pít, ma tớq táq dyôn tar-vớiq. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Co lư ar-lớih, cư tông ada i-nha, ti-ngôi ndóng pilŏ́ng a-lứng cu-teq cơt pít, mui tớuq lớiq la mui car-na tớq phep rit ar-lớih lư lớiq bôn pít dyôn díh ndóng mmo cứp callong dyôn cơt dyơ. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Co iki, khán nnáu táh mui te máh callong két lư na máh callong pa-táp ndô dyơ ca to ti-cuôi can-nŏ́h iki ngki lư cơt két lư tớq cruông tớq pilŏ́ng. Ma ti-cuôi mmo táq a-lứng ca to nha-án, ti-cuôi ngki lư cơt pưt tớq cruông tớq pilŏ́ng. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Co cư tông ada i-nha i-mo khán callong ti-nớng ŏ te i-nha lớiq ta-niêng te callong ti-nớng ŏ na máh thới sái rit nha ti-cuôi Pha-ra-si, i-nha lư ar-lớih ớq bôn mot tớq cruông tớq pilŏ́ng.<verse eid="MAT 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />I-nha khoiq sáng iki, callong khoiq pa-táp dyôn ti-cuôi i-nớh: ‘Êq ca-chet ti-cuôi,’ ma ‘Ti-cuôi mmo ca-chet ti-cuôi ngki lư cóq ráp callong tar-sưq.’ <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Ma cư tông ada i-nha idô án ndon pi-ốh em ai án cóq ráp callong tar-sưq. Ma ti-cuôi mmo arô em ai án: ‘Mái a-chơ!’ ngki cóq ráp máh ti-cuôi clứng tar-sưq. Nám ti-cuôi mmo chau: ‘Mái yúh!’ ngki cóq ráp callong bap tớq uih chéh níc. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />Co iki, khán i-nha chón mŏp crơng sang i-nha ntúq prông sang dyơ tớq ngki, i-nha ayư liêh idô mu náq em ai na i-nha bôn callong a-mớh ngki lớiq ŏ ada i-nha, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />ngki cóq táh liêh crơng sang i-nha tớq prông sang dyơ ti-yốq tôi; nsuôi lư cóq tár ŏ a-lứng em ai na i-nha a-vai, dyơ ngki, ndóng pôq, cóq mŏp crơng sang na i-nha. <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />Cóq par-chen a-lớng ti-cuôi cauq i-nha dyôn a-chái khán ndóng mmo i-nha yôl át mui car-na mu nơi a-lứng ti-cuôi ngki, dáh lơ ti-cuôi ngki mŏp i-nha nga ti-cuôi tar-sưq, dyơ ti-cuôi tar-sưq ngki dyôn nga tam-peng án, dyơ i-nha cơt ngai ca-cháq tớq cŏq tôt. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Lư ar-lớih, cư tông ada i-nha, i-nha ar-lớih lư ớq bôn ngốh te ngki ti-ngôi ndóng mmo i-nha bôn cu-liêh máh práq talloiq tháng.<verse eid="MAT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />I-nha khoiq sáng iki, par-nai dŏq pa-táp: ‘Êq táq luaih láh par-lưi.’ <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Ma cư tông ada i-nha idô ngki ti-cuôi mmo me nga mu náq ngai ng-cán ma par-ngíh ính táq lớiq ŏ ada cán ngki, ti-cuôi ngki khoiq luaih láh par-lưi a-lớng cán ngki tớq mít án dyơ. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Ma, khán callong mát pa a-tớm na i-nha par-yông i-nha táq luaih, cóq cu-láiq mát ngki dyơ a-dúh yông te i-nha. Co iki la ŏ lư dyôn i-nha ndóng mui phê te cháq na i-nha cơt lớiq ŏ, ngki nhéq chuôp cháq i-nha lớiq ngai a-pŏ́ng tớq uih chéh níc. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />A-lứng khán ati a-tớm na i-nha par-yông i-nha táq luaih, cóq cŏ́h ati ngki dyơ a-dúh yông te i-nha. Co iki la ŏ lư dyôn i-nha ndóng mui phê te cháq na i-nha ma cơt lớiq ŏ, ngki nhéq cháq i-nha lớiq pôq nga ntúq uih chéh níc. <verse eid="MAT 5:30" /><verse number="31" style="v" sid="MAT 5:31" />Bôn par-nai khoiq pa-táp: ‘Ti-cuôi mmo táh cam-pái án, ti-cuôi ngki cóq a-vôi ada cam-pái án mui ar-láq chớiq par-táh.’ <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Ma cư tông ada i-nha idô ngki ti-cuôi mmo táh cam-pái án, ma ớq bôn táq luaih te callong láh par-lưi, ngki táq dyôn cam-pái án bôn luaih láh par-lưi. A-lứng khán ti-cuôi mmo ial cán ndon khoiq par-táh ngki táq luaih láh par-lưi.<verse eid="MAT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />I-nha yôl cam-máng iki, par-nai khoiq pa-táp dyôn ti-cuôi i-nớh: ‘Êq can-tŏ́h can-lih, ma cóq táq par-nai car-hŏt te i-nha a-lớng Yang.’ <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Ma cư tông i-nha êq can-tŏ́h a-mớh díh, a-lứng êq ca to pilŏ́ng dyơ can-tŏ́h, co ngki la tar-cu na Yang Arbang Pilŏ́ng; <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />a-lứng êq bôiq cu-teq, co ngki la tar-dơl na a-dyưng Án; a-lứng êq bôiq vel Yaru-salem, co ngki la vel na Puô pưt. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />I-nha lư êq bôiq plô bôm dyơ can-tŏ́h, co i-nha ớq hôi táq mui ntráih sóc dyôn cơt clŏq lớiq la com. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Ma par-nai te i-nha cóq la ‘Bôn, la Bôn,’ ‘Ớq, la ớq.’ Ma callong a-mớh clưi te ar-náq ndô la te yang sáq.<verse eid="MAT 5:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />I-nha khoiq sáng iki, par-nai dŏq pa-táp: ‘Mát cu-liêh mát, nha ki-neng cu-liêh ki-neng.’ <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Ma, cư tông i-nha êq car-liêh dơq ada ti-cuôi lớiq ŏ. Ma lư, khán ti-cuôi mmo páh i-nha te ta-bang pa a-tớm, ngki cóq pa-dáng ta-bang te mu pa loi dyôn ti-cuôi ngki. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Khán ti-cuôi mmo ính cauq i-nha nga ntúq tar-sưq a-lứng ial viang au te callúng na i-nha, cóq dyôn ti-cuôi ngki ial díh au te tiêh hơ. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />A-lứng ti-cuôi mmo pa-tot i-nha pôq mui ki-lô-met, cóq pôq a-lớng ti-cuôi ngki bar ki-lô-met. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Cóq dyôn ti-cuôi plốh seq te i-nha, a-lứng êq ngiau mát te ti-cuôi ính manh na top i-nha.<verse eid="MAT 5:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />I-nha khoiq sáng iki, par-nai pa-táp: ‘A-moih ti-cuôi át pa-niar i-nha a-lứng a-ính ti-cuôi pi-con i-nha.’ <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Ma cư tông i-nha cóq a-moih ti-cuôi pi-con i-nha a-lứng cớu seq dyôn ti-cuôi táq diêiq i-nha, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />i-mo i-nha têq cơt a-cái na A-ám i-nha tớq cruông ang ưr. Ngki la co Án táq mát pan-dang na Án claq nga ti-cuôi crêng díh ti-cuôi khun, a-lứng Án dyôn bo ada ti-cuôi ti-nớng ŏ díh ti-cuôi lớiq ti-nớng ŏ. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Co khán i-nha a-moih máh ti-cuôi a-moih i-nha, i-nha bôn cống a-mớh? Ma máh ti-cuôi ial práq thêq ngki táq mu chứng a-rớq iki? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />A-lứng khán i-nha nưm ráp chom máh ti-cuôi em ai bôm, i-nha táq ta-niêng callong a-mớh? Ma tới ti-cuôi tới ti-cuôi Isa-ra-el ngki táq mu chứng iki? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Iki, i-nha cóq cơt ŏ, a-rớq A-ám tớq pilŏ́ng na i-nha lư cơt ŏ.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />Cóq mmứng te ar-náq ti-nớng ŏ na i-nha táq i-mo êq dyôn chứng mát ti-cuôi can-nŏ́h dŏq têq nha-án bôn hôm, ma khán tới iki, ngki dáh lơ i-nha ớq bôn cống a-mớh te A-ám i-nha tớq pilŏ́ng. <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />Iki, ndóng i-nha táq ar-náq tar-choi sớng, êq plóng ti-rel chứng mát i-nha a-rớq máh ti-cuôi náh nnan táq tớq máh dúng rum a-lứng na car-na pưt, táq i-mo nha-án bôn cứh ayô te ngai. Ar-lớih lư, cư tông ada i-nha, nha-án bôn cứp cống na nha-án. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Ma ndóng i-nha táq ar-náq tar-choi sớng, êq dyôn ati a-viar na i-nha chom ar-náq ati a-tớm i-nha chón táq, <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />dyôn cơt ar-náq tar-choi sớng na i-nha têq át tớq ntúq clôp, a-lứng A-ám na i-nha, Án bôn hôm tớq ntúq clôp ngki, dyơ dyôn cống ada i-nha.<verse eid="MAT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />Nha ndóng i-nha cớu seq, ngki êq a-rớq ti-cuôi táq náh nnan, co nha-án ính cớu seq ndóng ta-yứng tớq máh dúng rum a-lứng tớq máh par-yéh car-na, táq dyôn nha-án têq ngai bôn hôm. Ar-lớih lư, cư tông ada i-nha, nha-án bôn cứp dyơ cống na nha-án. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Ma i-nha, tớq i-nha cớu seq, cóq mot tớq callúng a-túq na i-nha, dyơ cliang callống a-túq i-nha a-vai, cóq cớu seq nga A-ám i-nha tớq ntúq clôp ngki, a-lứng A-ám na i-nha, Án bôn hôm tớq ntúq clôp, ngki cu-liêh cống ada i-nha. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />A-lứng chón ndóng cớu seq, i-nha êq a-lứp a-dưq lớiq cơt callong a-rớq máh ti-cuôi tới Isa-ra-el, co nha-án par-ngíh te callong a-ưi par-nai na nha-án, ngki náq yang nha-án ráp. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Co iki, i-nha êq táq a-rớq nha-án, co A-ám na i-nha chom i-nha ính bôn nốh a-mớh nsuôi i-nha seq te Án. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />Iki, i-nha cóq cớu seq idô:</para>
  <para style="q1" vid="MAT 6:9">‘Cu-cúh A-ám he a-cái tớq pilŏ́ng,</para>
  <para style="q2" vid="MAT 6:9">seq Nốh I-nha bôn dyám náp.<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Seq cruông I-nha chái tớq,</para>
  <para style="q2" vid="MAT 6:10">seq par-ngíh I-nha têq cơt tớq cu-teq mu chứng a-rớq tớq pilŏ́ng.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Seq dyôn he a-cái i-ngái ndô tan-na cha cứp i-ngái na he a-cái;<verse eid="MAT 6:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="MAT 6:12" />a-lứng seq ta-láh luaih he a-cái te máh luaih na he a-cái,</para>
  <para style="q2" vid="MAT 6:12">mu chứng he a-cái khoiq táh luaih dyôn ti-cuôi táq luaih ada he a-cái;<verse eid="MAT 6:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="MAT 6:13" />a-lứng seq êq dông he a-cái mot par-nai ngai clúq,</para>
  <para style="q2" vid="MAT 6:13">ma choi he a-cái te ti-cuôi lớiq ŏ.’<verse eid="MAT 6:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />Co khán i-nha táh luaih dyôn ti-cuôi can-nŏ́h máh callong luaih na nha-án, A-ám tớq pilŏ́ng na i-nha ngki lư táh luaih dyôn i-nha. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Ma khán i-nha lớiq táh luaih dyôn ti-cuôi can-nŏ́h, A-ám na i-nha ngki lư lớiq ta-láh máh callong luaih te i-nha.<verse eid="MAT 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />Ma, ndóng i-nha ót tan-na, êq táq a-rớq máh ti-cuôi sáng a-nguaq táq náh nnan, co nha-án pa-ngốh mát móh na nha-án dŏq nha-án têq a-páh dyôn ngai hôm chón ót tan-na. Ar-lớih lư, cư tông ada i-nha, nha-án bôn cứp dyơ cống na nha-án. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Ma i-nha, ndóng ót tan-na, cóq tir nseng tớq plô i-nha a-lứng a-rau mát i-nha, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />dŏq têq i-nha êq mpáh dyôn ngai hôm chón ót tan-na, ma la dyôn A-ám i-nha tớq ntúq clôp; a-lứng A-ám na i-nha, Án bôn hôm tớq ntúq clôp, ngki lư dyôn cống ada i-nha.<verse eid="MAT 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />Êq pa-chúng ta-roi dyôn sac sáiq crơng ngáih tớq cu-teq ndô, la ntúq ndon ca-muar crớm a-lứng ta-réh cha, ngki la ntúq ndon si-veng mot dyơ bôn tôiq. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Ma pa-chúng dŏq dyôn i-nha crơng ngáih tớq pilŏ́ng, la ntúq ớq bôn ca-muar crớm lớiq la ta-réh cha, a-lứng la ntúq ndon si-veng ớq hôi mot dŏq ính ti-tôiq. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Co crơng ngáih na i-nha tớq mmo, par-ngíh na i-nha lư nga tu-ki. <verse eid="MAT 6:21" /><verse number="22" style="v" sid="MAT 6:22" />Callong mát la ta-bong ada cháq. Co iki, khán mát i-nha la ŏ, díh cháq i-nha lư bôn pớnh máng callong ang. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Ma khán mát i-nha cơt saq, díh cháq i-nha cơt pớnh callong ngiau. Iki, nám callong ang tớq i-nha ma cơt ngiau, callong ngiau ngki cơt ngiau pi-lư! <verse eid="MAT 6:23" /><verse number="24" style="v" sid="MAT 6:24" />Ớq nnáu têq táq sol bar náq ưlla, co ti-cuôi ngki cơt a-ính ưlla ndô ma a-moih ưlla ntíh, lớiq la dyám náp ưlla ndô ma ayê ưlla ntíh. I-nha lớiq têq táq sol Yang Arbang Pilŏ́ng díh crơng-crớu hơ. <verse eid="MAT 6:24" /><verse number="25" style="v" sid="MAT 6:25" />Co te ar-náq ndô, cư tông ada i-nha, êq rớu ri te callong tu-mống na i-nha, nốh a-mớh i-nha cha lớiq la nốh a-mớh i-nha ngoiq, lớiq la dyôn cháq na i-nha, nốh a-mớh i-nha tớc. Ma callong tu-mống ngki tar-náp hơn tan-na cha a-lứng cháq chớn tam-pớc tớc? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Áu me nga máh thư a-chếq pilŏ́ng, i-mo nha-án lớiq chớt choi, a-lứng lớiq sot lớiq la dŏq tớq ti-nong, ma A-ám tớq pilŏ́ng na i-nha par nha-án. I-nha ớq bôn tar-náp ta-niêng hơn nha-án? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Ma, ti-cuôi mmo te top i-nha át par-ngíh ngki têq táq toiq mui can-tứq ada pang tu-mống na án? <verse eid="MAT 6:27" /><verse number="28" style="v" sid="MAT 6:28" />Ngki i-mo i-nha rớu ri te tam-pớc? Cóq me ar-lớih nga piêr sác tớq tiah, na mmo ma piêr ngki hŏn. Piêr ngki lớiq tuh tál, a-lứng lớiq tam-pớc tớc. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Ma cư tông ada i-nha idô díh puô Sa-la-môn, te nhéq máh tam-pớc dêu ŏ na án, ngki lớiq bôn sứp tam-pớc ŏ ada án mu chứng a-rớq mui te máh piêr ngki. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Ma khán Yang Arbang Pilŏ́ng ta-sứp iki ada sác tớq tiah, la nốh ndô yôl, ma par-nô cơt ngai a-dúh tớq uih, ngki máh ti-cuôi ndon biq callong náp ntíh, a-láng Án lớiq têq táq a-ưi clưi te ngki bớh? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Co iki, i-nha êq rớu ri dyơ tông: ‘Top he cha a-mớh?’ lớiq la ‘Top he ngoiq a-mớh?’ lớiq la ‘Top he tớc a-mớh?’ <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Co máh ti-cuôi te can-nŏ́h si-suô nhéq máh nốh ndô; a-lứng co A-ám tớq pilŏ́ng na i-nha chom ar-lớih i-nha ính nhéq máh callong ngki. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Ma nsuôi lư cóq si-suô cruông ang ưr nha callong ti-nớng ŏ te Án ngki nhéq máh nốh ngki lư dyôn pi-lư ada i-nha. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Iki, i-nha êq rớu ri te i-ngái par-nô, co i-ngái par-nô ngki par-ngíh ar-náq par-nô. Cứp nhéq dyôn mui i-ngái callong diêiq a-rức na i-ngái ngki.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />Êq tíq nnáu, dŏq i-nha ớq bôn nnáu tíq. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Co te callong tar-tíq ndon i-nha tíq, i-nha lư ráp callong tíq, a-lứng co máh mmo i-nha ngiaih luaih, máh ngki tưi ngai ngiaih luaih te i-nha. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />Ma i-mo i-nha bôn hôm sál tớq mát em ai i-nha, ma i-nha lớiq chom bôn mêng pan tớq mát i-nha? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />A-láng na car-na mmo i-nha dáh lư tông ada em ai i-nha: ‘Áu dyôn cư tu-váih sál a-ngốh te mát mái,’ ma me ngki, mêng pan chón át tớq mát na i-nha? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Ti-cuôi táq náh nnan ntíh! Nsuôi lư, cóq ial mêng pan a-ngốh te mát i-nha, dyơ vít ngki, i-nha hôm ar-lớih dŏq tu-váih sál a-ngốh te mát em ai i-nha. <verse eid="MAT 7:5" /><verse number="6" style="v" sid="MAT 7:6" />I-nha êq dyôn can-tóh a-cho crơng ŏ, a-lứng êq dyôn crơng ngáih na i-nha ada can-tóh a-lic. Dáh lơ nha-án dếq ki-siêr máh crơng ngki tớq dyưng nha-án, dyơ nha-án pa-lóng nha-án cáp haq i-nha cơt a-ưi mêng.<verse eid="MAT 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />Cóq seq, a-lứng nốh ngki lư dyôn ada i-nha. Cóq suô, ngki i-nha lư tu-múh. Cóq a-cóh, ngki ngáh callống lư pốh dyôn ada i-nha. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Co khán nnáu seq ngki bôn; nnáu suô ngki tu-múh; a-lứng, ngáh callống lư pốh dyôn nnáu a-cóh. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />A-láng bôn nnáu tớq top i-nha, la ti-cuôi ndon a-cái án seq beng — ma ti-cuôi ngki lư dyôn ada a-cái cúc búl? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Lớiq la a-cái án seq buaiq — ma ti-cuôi ngki lư dyôn án cu-sánh? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Iki, khán i-nha, la ti-cuôi lới, ma chom a-vôi a-cái a-con i-nha máh crơng ŏ, A-ám na i-nha tớq pilŏ́ng lư dyôn ada ti-cuôi mmo seq te Án a-ưi callong ŏ ta-niêng chom máh mmo? <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />Co iki, tớq cứp ar-náq, khán i-nha ính máh ar-náq a-mớh dŏq ngai can-nŏ́h táq ada i-nha, i-nha lư cóq táq mu chứng iki ada nha-án, co ngki la phep rit nha máh par-nai tang ng-cang.<verse eid="MAT 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Cóq ti-caq mot na ngáh callống hep. Co ngáh callống pơh a-lứng car-na pưt pôq nga callong cu-chet, a-lứng bôn clứng ti-cuôi ti-caq mot na car-na ngki. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Ngki la nhơ ngáh callống hep a-lứng car-na bôn táq dyôn hep dông nga callong tu-mống, ma nưm biq náq ti-cuôi bôn tu-múh car-na ngki.<verse eid="MAT 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />Cóq mmứng te máh tang ng-cang náh nnan, la máh ti-cuôi ar-maiq a-rớq cưu tớq nga i-nha, ma tớq mít, nha-án la i-mo a-yóng ính pa-lóng cáp. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />I-nha lư a-cớl nha-án te ntúq cu-lái na nha-án. Ngai lớiq bôn cáiq nho te tôm tang-háng, lớiq la cu-lái ta-rúng te sác tang-háng? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Mu chứng, cứp a-long ŏ ngki cơt cu-lái ŏ, ma a-long saq ngki cơt cu-lái saq. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />A-long ŏ lớiq têq cơt cu-lái saq, a-long saq ngki lớiq têq cơt cu-lái ŏ. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Cứp a-long lớiq cơt cu-lái ŏ ngki ngai cớl dyơ a-dúh tớq uih. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Iki, ma i-nha lư a-cớl nha-án te ntúq cu-lái na nha-án. <verse eid="MAT 7:20" /><verse number="21" style="v" sid="MAT 7:21" />Tới cứp náq ti-cuôi dŏq cư: ‘Yang ơi, Yang ơi,’ bôn mot tớq cruông tớq pilŏ́ng, ma la ti-cuôi táq veng a-rớq can-nính na A-ám thới tớq pilŏ́ng. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Tớq i-ngái ngki, a-ưi ti-cuôi lư ntêr ada cư: ‘Yang ơi, Yang ơi, ngki he a-cái khoiq nhơ nốh Thới ntêr tang ng-cang, khoiq nhơ nốh Thới chuih yang sáq a-lứng khoiq nhơ nốh Thới táq a-ưi ar-náq si-leh?’ <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Dyơ ndóng ngki, cư tông ar-lớih ada nha-án idô: ‘Cư lớiq chom top i-nha lớng! Top táq lớiq ŏ ntíh, cóq tôi yông te Cư!’<verse eid="MAT 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />Iki, cứp ti-cuôi la máh mmo cam-máng máh par-nai ndô na cư a-lứng táq veng ngki cơt a-rớq mu náq ti-cuôi hôi tu-báiq, ngki án pi-tứng dúng án tớq mpiên búl. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Bo chớn, dơq car-lúh bŏ́h tớq, cu-yiêl phớt dyơ clúh hớp nga dúng ngki, ma dúng ngki lớiq ar-lóh co dúng ngki khoiq dŏq pi-tứng tớq mpiên búl. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Ngki nám ti-cuôi mmo cam-máng máh par-nai ndô na cư ma lớiq táq veng ngki cơt a-rớq mu náq ti-cuôi a-chơ, la án pi-tứng dúng án tớq chuah. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Bo chớn, dơq car-lúh bŏ́h tớq, cu-yiêl phớt dyơ clúh nga dúng ngki, dyơ dúng ngki ar-lóh a-lứng callong rúng te dúng ngki la pưt lư.”<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Ar-náq cơt ngki la ndóng Yang Yê-su ca to dyơ máh par-nai ndô, máh ti-cuôi clứng cơt sáng dut te callong ca to te Án, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />co Án ca to nha-án a-rớq bôn chức sút, ma tới a-rớq máh thới sái rit te nha-án.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Ndóng ngki, chón Án te mpiên cóh siar, máh ti-cuôi clứng veng ta-pun Án. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Me ngki, mu náq ti-cuôi a-ái bŏ́q tớq pa-lóng, chóh tar-col chứng mát Án, seq: “Thới ơi, khán Thới ính, Thới bôn chức táq dyôn cư cơt bánh.” <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />Dyơ tư pa-yơ ati ngki, Án ca-pơiq tớq conh ngki, tông: “Cư ính. Mái cơt bánh.” Ndóng ngki táp, conh ngki cơt bánh a-ái bŏ́q te án. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Yang Yê-su tông ada conh ngki: “Cóq mái ayư, mái êq taq-ntêr ada nnáu, ma cóq pôq a-páh cháq mái ada thới teng rit sang nha mŏp crơng sang ndon Môi-se khoiq pa-táp, a-rớq mui tíc dyôn nha-án.”<verse eid="MAT 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Dyơ ngki, tư Án pôq mot tớq vel Ca-bê-na-um, ti-cuôi sút mui cu-lám líng tớq nga Án, tar-seq te Án <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />idô: “Thới ơi, prái na cư a-ái cớng át tớq dúng, cơt ráh a-riaq diêiq a-rức lư.” <verse eid="MAT 8:6" /><verse number="7" style="v" sid="MAT 8:7" />Án tông ada án: “Tư dyơ tớq, cư lư pa-lai bánh dyôn ti-cuôi prái ngki.” <verse eid="MAT 8:7" /><verse number="8" style="v" sid="MAT 8:8" />Ndóng ôi liêh, ti-cuôi sút líng tông: “Thới ơi, cư ngki lớiq piaiq dŏq mơi Thới têq pôq mot tớq dúng cư, ma seq Thới nưm tông mui par-nai, ngki ti-cuôi sol na cư lư bôn pa-lai bánh. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Co cư ngki la mu náq ti-cuôi át ta-dưp chức sút ti-cuôi can-nŏ́h bôn tưi top líng át ta-dưp cư. Cư tông ada ti-cuôi ndô: ‘Pôq pôq,’ ngki án pôq, tông ada ti-cuôi can-nŏ́h: ‘Áu tớq,’ ngki án tớq, a-lứng tông ada prái tar-ráih cư: ‘Cóq táq ar-náq ndô,’ ngki án táq.” <verse eid="MAT 8:9" /><verse number="10" style="v" sid="MAT 8:10" />Ma ndóng bôn sáng iki, Yang Yê-su hôm laq a-lứng tông ada máh ti-cuôi chón veng ta-pun Án: “Ar-lớih lư, cư tông ada i-nha, cư ớq hôm callong náp pưt lư iki te mu náq ti-cuôi mmo tớq Isa-ra-el. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Ma lư, cư tông i-nha i-mo clứng ti-cuôi lư tớq te a-nga mát pan-dang ngốh nha mát pan-dang pát, dyơ nha-án ti-cu chi-cha mu nơi a-lứng A-pra-ham, I-sac a-lứng Ya-côp tớq cruông tớq pilŏ́ng. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Ma máh a-cái na cruông cơt án a-dúh nga ntúq ngiau te tiêh, la ntúq lư bôn nhiêm cu-cloiq nha cal-tưat ki-neng.” <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />Dyơ Yang Yê-su tông ada án sút mui cu-lám líng: “Chô a-dứh! A-rớq mái khoiq náp, ar-náq ngki cóq táq dyơ ada mái.” A-lứng ti-cuôi prái tar-ráih ngki khoiq pa-lai bánh chón ndóng ngki.<verse eid="MAT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Tư Yang Yê-su mot tớq dúng Phi-er, Án hôm a-i cam-pái na án bíq tớq ki-chơng ngki chón a-ái ta-cóh. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Án ca-pơiq tớq ati cán ngki, nha callong a-ái pít te cán ngki, dyơ cán ngki yôr a-lứng ta-bớq a-ngốh tan-na dyôn Án. <verse eid="MAT 8:15" /><verse number="16" style="v" sid="MAT 8:16" />Hoi ngki, pilŏ́ng khoiq tớq ính i-dáu, ngai dông a-tớq nga Án clứng ti-cuôi bôn yang sáq táq, Án chuih a-ngốh yang sáq ngki na par-nai tông dyơ pa-lai bánh dyôn nhéq máh ti-cuôi bôn a-ái, <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />dyôn têq ar-náq ngki cơt tar-vớiq par-nai khoiq taq-ntêr te tang ng-cang Ê-sai, idô: “Lư Án khoiq ial dual máh callong a-ái tar-ma te top he a-lứng ráp chiuq máh diêiq a-rức na top he.”<verse eid="MAT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Dyơ ngki, ndóng bôn hôm máh ti-cuôi clứng pa-niar án, Yang Yê-su yua pôq pa dyang a-tŏ́h dơq clóng. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Dyơ bôn ti-cuôi sái rit, tớq tar-mán, tông ada Án: “Thới ơi, cư ính tar-veng thới ntro thới pôq tu-mo.” <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" />Yang Yê-su tông ada án: “A-yŏ́ng bôn cưp, nha a-chếq pilŏ́ng bôn sáp, ma A-cái Yang Cơt Ti-cuôi ớq bôn ntúq dyôn Án têq ta-cual plô.” <verse eid="MAT 8:20" /><verse number="21" style="v" sid="MAT 8:21" />Vít ngki, mu náq ti-cuôi can-nŏ́h tớq top ndon rian seq te Án: “Thới ơi, seq dyôn cư nsuôi lư la chô dyơ tứp a-ám cư.” <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />Ma Yang Yê-su tông ada conh ngki: “Cóq veng cư, a-lứng dŏq ti-cuôi cu-chet tứp ti-cuôi cu-chet na nha-án.”<verse eid="MAT 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Ndóng Án khoiq sớr nga tuôc, top ndon rian te Án veng ta-pun Án. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Me ngki, cu-yiêl ar-puq hớp lư cơt tớq dơq ving ca-vang, tar-lúh tuôc cơt dơq cal-chớq a-mot. Ma Án chón bíq. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Dyơ tớq tar-mán, nha-án pa-sớt Án, seq: “Thới ơi, seq Thới choi; top he tar-mán cu-chet dyơ!” <verse eid="MAT 8:25" /><verse number="26" style="v" sid="MAT 8:26" />Dyơ Án tông ada nha-án: “Top i-nha biq lư callong náp, i-mo i-nha sáng a-dáh?” Vít ngki, dyơ yôr ta-yứng, Án dyŏq cu-yiêl nha dơq ving ca-vang, ngki dơq a-lứng cu-yiêl cơt ta-ngít táp. <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />Ma máh ti-cuôi ngki sáng dut, tông: “Ti-cuôi ndô la nnáu, co díh cu-yiêl nha dơq cam-máng par-nai Án?” <verse eid="MAT 8:27" /><verse number="28" style="v" sid="MAT 8:28" />Dyơ ndóng Án pôq pa dyang a-tóh dơq, díh cruông Ca-da-ra, bôn bar náq ti-cuôi cơt yang sáq pi-yúh tớq tar-múh Án, nha-án ngốh te car-lom cu-muiq, nha-án cơt crêng lư tar-lúh ớq nnáu dáh pôq pha na car-na ngki. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Me ntíh, nha-án hiar yứng, idô: “Ơi A-cái Yang Arbang Pilŏ́ng, top he a-lớng I-nha bôn ar-náq a-mớh? I-nha tớq tu-dô ính táq diêiq a-rức top he nsuôi tớq i-ngái lớiq?” <verse eid="MAT 8:29" /><verse number="30" style="v" sid="MAT 8:30" />Ndóng ngki, bôn mui can-tóh a-lic lư clứng chón chi-cha te nha-án lớiq bôn yông. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Dyơ ngki, máh yang sáq seq te Án, idô: “Nám I-nha chuih top he, seq dyôn top he mot tớq can-tóh a-lic ngki.” <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />Án yua yang sáq ngki: “Ngốh táp!” Iki vít ndóng ngốh, nha-án mot tớq can-tóh a-lic; a-lứng cóq me ntíh, nhéq can-tóh póng a-siar nga a-cáng tớq dơq ving ca-vang, dyơ a-lic ngki cu-chet trim. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Tớq ngki, máh ti-cuôi bán a-lic lúh, dyơ ndóng chô tớq vel, nha-án taq-ntêr liêh máh ar-náq, ntêr díh máh ar-náq te ti-cuôi ndon yang sáq pi-yúh. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Dyơ me ngki, díh vel pôq dŏq tar-múh Yang Yê-su. Dyơ hôm Án, nha-án seq dyôn têq Án pôq ntúq can-nŏ́h te cruông cu-teq te nha-án.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Ndóng khoiq sớr tớq tuôc, Án píh liêh pa dyang a-tŏ́h dyơ chô nga vel na án. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Me ngki, bôn ngai dông a-tớq nga Án mu náq ti-cuôi a-ái cớng chón bíq mpiên nchiauq. Tư Yang Yê-su hôm callong náp na nha-án, Án tông ti-cuôi a-ái cớng: “Ơi a-cái, cóq a-khớm mít. Máh callong luaih a-cái khoiq ta-láh.” <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />A-lứng me ngki, bôn ti-cuôi te top thới sái rit taq-ntêr ada tar-tuôq: “Ti-cuôi ndô a-craiq Yang.” <verse eid="MAT 9:3" /><verse number="4" style="v" sid="MAT 9:4" />Co khoiq chom máh par-ngíh na nha-án, Yang Yê-su tông: “Top i-nha át par-ngíh lớiq ŏ tớq mít i-nha dŏq táq a-mớh? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Co callong mmo la iên hơn dŏq tông: ‘Máh luaih lới a-cái khoiq táh luaih,’ lớiq la tông: ‘Áu ta-yứng dyơ ti-yốq pôq’? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Ma dŏq top i-nha chom ar-lớih A-cái Yang Cơt Ti-cuôi bôn chức sút tớq cúc cu-teq dŏq táh luaih …” ki tớq i-ngái ngki, Án tông ti-cuôi ndon a-ái cớng: “Áu ta-yứng, pial nchiauq ngki, dyơ chô nga dúng mái.” <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Dyơ ta-yứng, ti-cuôi ngki ti-yốq chô nga dúng án. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Dyơ, tư hôm iki, máh ti-cuôi clứng sáng laq lư dyơ cứh ayô Yang Arbang Pilŏ́ng co khoiq dyôn ada ti-cuôi chức sút a-rớq ngki. <verse eid="MAT 9:8" /><verse number="9" style="v" sid="MAT 9:9" />Ndóng khoiq te ntúq ngki ngốh, Yang Yê-su bôn hôm mu náq ti-cuôi nốh Ma-thiê chón ti-cu tớq dúng ial práq thêq, dyơ Án yua Ma-thiê: “Veng ta-pun cư.” A-lứng dyơ ta-yứng, án veng ta-pun Án.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Ar-náq cơt ndóng Án ti-cu chi-cha tớq dúng, iki me ntíh, clứng máh ti-cuôi tu-the a-lứng ti-cuôi bôn luaih tớq, dyơ ti-cu ntúq chi-cha a-lớng Yang Yê-su nha máh ndon rian Án. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Ndóng bôn hôm iki, máh ti-cuôi Pha-ra-si tông ada máh ndon rian Án: “Co i-mo ma thới top i-nha cha mu nơi a-lứng top tu-the nha ti-cuôi bôn luaih?” <verse eid="MAT 9:11" /><verse number="12" style="v" sid="MAT 9:12" />Ma dyơ bôn sáng iki, Án tông: “Ti-cuôi práih bánh ớq bôn par-ngíh te ti-cuôi pa-lai, ma nưm ti-cuôi bôn a-ái. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Ma ndóng pôq, cóq rian a-púh callong ndô la i-mo: ‘Cư ính callong ar-moih, tới crơng mŏp sang.’ Co tới cư tớq dŏq arô ti-cuôi ti-nớng ŏ, ma lư ti-cuôi bôn luaih.”<verse eid="MAT 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Ndóng ngki, top ndon rian na Yon tớq plốh Án, tông: “Co i-mo top he nha máh ti-cuôi Pha-ra-si báq ót tan-na, ma top ndon rian na thới ngki lớiq ót tan-na?” <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />Yang Yê-su tông ada nha-án: “Dêu ar-mo máh yớu án pôq cha ar-suôi cơt sáng a-nguaq tớq i-ngái ngki máh mmo dưnh ndon conh ial cam-pái át mu nơi a-lớng nha-án? Ma tớq i-ngái ndóng conh ngki cơt dáh ta-dông te nha-án, dyơ ndóng ngki nha-án ót tan-na. <verse eid="MAT 9:15" /><verse number="16" style="v" sid="MAT 9:16" />Lư, ớq nnáu cu-pêl mui mêng prới tam-me i-yốh cu-crónh tớq pláh au tiêq, co mêng cu-pêl ớq tar-haq te pláh au ngki, a-lứng ntúq tar-haq cơt saq lư mpáh. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Lư ớq nnáu cleng siêu tam-me tớq a-luôi ng-cár tiêq. Ma khán táq iki, lư táq dyôn a-luôi ng-cár cơt pôih pi-dŏ́h, siêu hóc nhéq a-lứng a-luôi cơt rúng. Ma crái lư, ngai cleng siêu tam-me tớq a-luôi ng-cár tam-me, a-lứng nhéq bar cơt lới pít.”<verse eid="MAT 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Ndóng Án chón tông máh par-nai ngki ada nha-án, ngki i-nha me, bôn ti-cuôi sút dúng rum tớq tar-mán, chóh tar-col chứng mát Án, tông idô: “A-cái cán cư mbơiq cu-chet, ma seq thới tớq, dŏq thới ta-kít ati thới tớq a-cái cư ngki a-cái cư bôn tu-mống.” <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Dyơ yôr ta-yứng, Yang Yê-su a-lứng top ndon rian Án pôq ta-pun conh ngki. <verse eid="MAT 9:19" /><verse number="20" style="v" sid="MAT 9:20" />A-lứng i-nha me ngki, mu náq cán chiuq a-ái ngốh a-ham nhéq mu chít la bar cu-mo, dyơ veng ta-pun te cróng Án táp, ngki ca-pơiq tớq mbaiq au na Án, <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />co cán ngki par-ngíh tớq mít: “Khán cư bôn ca-pơiq tớq au Án sớng, ngki cư cơt bánh a-ái.” <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />Ma ndóng pi-líh dyơ hôm cán ngki, Yang Yê-su tông: “A-cái cán ơi, êq a-dáh; callong náp a-cái khoiq pa-lai bánh a-cái.” Dyơ ti-cuôi cán ngki cơt bánh a-ái ndóng ngki táp. <verse eid="MAT 9:22" /><verse number="23" style="v" sid="MAT 9:23" />Dyơ Yang Yê-su, mot tớq dúng ti-cuôi sút dúng rum ngki bôn hôm máh ti-cuôi plŏ́ng ti-rel a-lứng máh ti-cuôi ru-rưp, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />ngki tông: “Áu ngốh táp, co a-un ndô ngki lớiq cu-chet, ma a-un ndô bíq sớng.” Dyơ nha-án ca-cháng ayê Án. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Iki, tư máh ti-cuôi clứng khoiq chuih nga tiêh, dyơ mot, Án kéu ati a-un ngki, dyơ a-un ngki yôr bôm. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Ar-náq ndô par-hanh tớq chuôp cruông ngki.<verse eid="MAT 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Chón ndóng Yang Yê-su te vel ngki ngốh, bar náq ti-cuôi sot veng ta-pun Án, can-tơ yứng lư nha tông: “Ơi A-cái puô Da-vit, seq sruiq top he!” <verse eid="MAT 9:27" /><verse number="28" style="v" sid="MAT 9:28" />Chón ngki, ndóng mot tớq dúng dyơ, bar náq ndon sot tớq nga Án dyơ Yang Yê-su tông ada nha-án: “Lư top i-nha náp ar-lớih cư têq táq ar-náq ngki?” Nha-án ôi liêh Án: “Lư, thới ơi.” <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />Dyơ ngki, Án ca-pơiq tớq mát nha-án, tông: “Ar-náq ngki cóq cơt dyôn top i-nha veng a-rớq callong náp na top i-nha.” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Mát nha-án têq bôn hôm, dyơ Yang Yê-su pa-táp nha-án, idô: “Cóq mmứng, i-nha êq dyôn nnáu chom.” <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Ma dyơ mbơiq ngốh nga tiêh, nha-án taq-ntêr ar-náq ngki tớq chuôp cruông ngki.<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Dyơ, chón ndóng nha-án ngốh, ngki me ntíh, ngai dông a-tớq nga Án mu náq ti-cuôi lúng bôn yang sáq táq. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Tư yang sáq khoiq ngốh, ti-cuôi lúng têq ta-cang, ma máh ti-cuôi clứng sáng dut, tông: “Mui ar-náq iki lư i-yốh mpáh tớq Isa-ra-el!” <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" />Ma máh ti-cuôi Pha-ra-si tông: “Án chuih yang sáq co nhơ yang sáq sút pưt.”<verse eid="MAT 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Yang Yê-su pôq lu-liêh nhéq máh vel pưt a-lứng vel két, ca to tớq máh dúng rum na nha-án, taq-ntêr Par-nai ŏ te cruông tớq pilŏ́ng, nha pa-lai bánh cứp nốh tar-ma a-lứng máh a-ái ta-cóh. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Dyơ, ndóng bôn hôm máh ti-cuôi clứng, Án sáng sruiq dyôn ada nha-án, co nha-án ngai táq diêiq a-rức ngki cơt pláh chap, a-rớq cưu ớq bôn ti-cuôi bán. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Vít ngki, Án tông ada top ndon rian án: “Ma ki-sái si-sŏt khoiq tớq, ma ti-cuôi sŏt ngki biq. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Iki, cóq seq Ưlla na pi-dái sro, dyôn Án yua máh ti-cuôi sŏt tớq ki-sái si-sŏt na án.”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Dyơ arô mu chít la bar náq ndon rian te án tớq, Án dyôn ada nha-án chức sút ta-niêng máh yang sáq, têq chuih a-ngốh yang sáq ngki a-lứng pa-lai bánh cứp nốh a-ái tar-ma a-lứng máh a-ái ta-cóh. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Nốh na mu chít la bar náq dyưng ati ngki la idô: Nsuôi lư, Si-môn (ngai dŏq la Phi-er) nha An-rê, a-em conh án; Ya-cơ a-cái na Sê-ba-dê nha Yon, a-em conh án; <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Phi-lip a-lứng Ba-thê-la-mi; Thô-ma a-lứng Ma-thiê, ndon ial práq thêq; Ya-cơ a-cái na Al-phê, a-lứng Tha-dê; <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Si-môn Sê-lôt, nha Yu-da Ica-ri-ôt, ngki ti-cuôi ndon khoiq cu-liêu Án.<verse eid="MAT 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Yang Yê-su yua mu chít la bar náq ti-cuôi ngki pôq, dyơ pa-táp nha-án, idô: “Êq pôq na car-na na ti-cuôi tới ti-cuôi Isa-ra-el, a-lứng êq mot tớq vel na ti-cuôi Sa-ma-ri. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Ma cóq pôq nga máh a-cái cưu clu car-na na ti-cuôi Isa-ra-el ngki lư. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Hoi ngki, ndóng pôq na car-na, i-nha pôq pau, tông idô: ‘Cruông tớq pilŏ́ng tar-mán ính tớq.’ <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />I-nha pa-lai bánh ti-cuôi a-ái ta-cóh, táq dyôn ti-cuôi cu-chet tu-mống liêh, táq bánh ti-cuôi bŏ́q nha chuih a-ngốh máh yang sáq. I-nha khoiq ráp sớng, ngki i-nha dyôn sớng. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Êq dŏq dyeng, lớiq la a-pán, lớiq la práq cúc tớq tui tái na i-nha, <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />êq dông tui dyơ ính pôq, lớiq la bar pláh au, lớiq la cơp, lớiq la tar-lông, co ti-cuôi táq ar-náq lư bôn phê cha na án. <verse eid="MAT 10:10" /><verse number="11" style="v" sid="MAT 10:11" />Ma tớq vel pưt lớiq la vel két mmo ma i-nha mot, cóq suô ti-cuôi ndon tớq vel ngki la ti-cuôi pa-sôl ŏ, cóq át tớq ngki dyôn díh ali mmo i-nha ngốh. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Dyơ, ndóng mot tớq dúng ngki, cóq cớu dyôn iên ŏ ada ntúq ngki. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Ma, khán dúng ngki ma pa-sôl ŏ, callong iên ŏ na i-nha tớq nga dúng ngki, lớiq la, khán tớq dúng ngki lớiq ráp pa-sôl ŏ, callong iên ŏ na i-nha cơt láh cu-liêh ada i-nha. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />A-lứng ti-cuôi mmo lớiq ráp ŏ i-nha, a-lứng lớiq cam-máng máh par-nai na i-nha, ndóng ngốh te dúng lớiq la vel ngki, cóq tang-khír mbúi te dyưng i-nha. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Ar-lớih lư, cư tông ada i-nha, cơt lư ng-hiêl hơn dyôn cruông Sô-dôm nha Cô-mô-rơ tớq i-ngái tar-sưq a-láng ada vel ngki.<verse eid="MAT 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />Me ndô, cư yua i-nha pôq a-rớq cưu át pan-di can-tóh a-yóng, iki cóq cơt hôi tu-báiq a-rớq cu-sánh a-lứng khun a-rớq a-chếq ca-cu. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Ma cóq mmứng te ti-cuôi can-nŏ́h, co nha-án lư cŏp i-nha dông nga ti-cuôi sút tar-sưq, dyơ ngai tính i-nha tớq par-núh tớq dúng rum na nha-án; <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />dyơ i-nha ngki ngai dông nga máh ti-cuôi sút nha máh puô co te cư, dŏq táq tíc dyôn nha-án a-lứng dyôn ti-cuôi tới ti-cuôi Isa-ra-el. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Ma ndóng nha-án cŏp i-nha, êq rớu ri te bớr a-mớh lớiq la callong a-mớh i-nha ính taq-ntêr, co callong ndon i-nha ính taq-ntêr lư cơt ta-pốh ada i-nha chón ndóng ngki. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Co tới i-nha la ti-cuôi taq-ntêr, ma la Yang Ar-vai na A-ám i-nha tông te i-nha. <verse eid="MAT 10:20" /><verse number="21" style="v" sid="MAT 10:21" />Dyơ ngki, ai lư mŏp a-em nga ntúq cu-chet, a-lứng a-ám mŏp a-cái, nha a-cái a-con lư táng chíl a-lớng a-ám a-i nha táq dyôn nha-án cóq cu-chet. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />A-lứng i-nha lư cứp náq ti-cuôi a-ính co nốh cư, ma nnáu rap chiuq ta-nhir dyôn díh talloiq tháng, ti-cuôi ngki lư bôn tu-mống. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Ma ndóng ngai táq diêiq a-rức i-nha tớq vel ndô, ngki cóq lúh nga vel can-nŏ́h, co ar-lớih lư, cư tông ada i-nha, lư ar-lớih i-nha lớiq têq pôq nhéq máh vel na Isa-ra-el dyôn díh ndóng A-cái Yang Cơt Ti-cuôi tớq.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />Ti-cuôi rian ngki lớiq ta-niêng thới, ti-cuôi sol la lớiq ta-niêng ưlla án. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Ma ti-cuôi ndon rian, dyôn ti-cuôi ngki têq cơt a-rớq thới án, nha ti-cuôi sol ngki a-rớq ưlla án, la piaiq dyơ. Khán ngai dŏq ưlla dúng la Bên-ya-bul, ti-cuôi dúng na ưlla cơt saq ta-niêng ngki loi! <verse eid="MAT 10:25" /><verse number="26" style="v" sid="MAT 10:26" />Iki, êq a-dáh nha-án, co ớq bôn callong a-mớh dŏq pul clôp ma lư lớiq bôn mpáh, dŏq ca-tốq ma lư bôn lớiq ngai chom. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Callong cư ca to i-nha tớq ntúq ngiau, cóq taq-ntêr tớq ntúq ang, a-lứng callong i-nha sáng tớq cu-tor, cóq taq-ntêr tớq mpuông dúng. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Êq a-dáh te máh ti-cuôi ndon ca-chet cháq ma lớiq têq ca-chet ar-vai. Ma cóq chom a-dáh Án têq pu-pít díh ar-vai nha cháq tớq uih chéh ngki lư. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Ma nga bar lám a-chếq chap táiq bôn tar-náp mui nhac práq? A-lứng ớq mui a-chếq mmo te a-chếq ngki a-tôh tớq cu-teq nám lớiq can-nính na A-ám i-nha. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Ma díh sóc tớq plô i-nha, nhéq tưh la khoiq cua dŏq ngiaih dyơ. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Co iki, êq a-dáh; i-nha tar-náp ta-niêng hơn a-chếq chap. <verse eid="MAT 10:31" /><verse number="32" style="v" sid="MAT 10:32" />Iki, cứp náq ti-cuôi, ma ti-cuôi mmo lư ngin te cư chứng mát ngai can-nŏ́h, cư lư ngin te ti-cuôi ngki chứng mát A-ám cư tớq pilŏ́ng. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Ma ti-cuôi mmo ca-lôih cư chứng mát ngai can-nŏ́h, cư lư ca-lôih ti-cuôi ngki chứng mát A-ám cư tớq pilŏ́ng.<verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />Êq par-ngíh i-mo cư tớq dŏq dông iên ŏ tớq cu-teq. Cư lớiq tớq dŏq dông iên ŏ, ma dông pla dau. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Co cư tớq ính táq a-cái conh chíl liêh a-ám án, a-cái cán chíl liêh a-i án, a-cái tar-môt chíl liêh a-i ca-yiêq án; <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />a-lứng ti-cuôi par-ual na mu náq ti-cuôi la máh ti-cuôi tớq dúng su na ti-cuôi ngki. <verse eid="MAT 10:36" /><verse number="37" style="v" sid="MAT 10:37" />Nnáu a-moih a-ám lớiq la a-i ta-niêng cư ngki lớiq crái cơt ti-cuôi cư; nnáu a-moih a-cái conh lớiq la a-cái cán ta-niêng cư ngki lư lớiq crái cơt ti-cuôi cư. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Khán ti-cuôi mmo lớiq dual a-long calláng án dyơ veng ta-pun cư ngki lớiq piaiq cơt ada cư. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Nnáu a-yáu tar-ngứh bôm ngki lư pít, ma nnáu chiuq pít tar-ngứh án co veng cư ki lư lớiq pít tar-ngứh án.<verse eid="MAT 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />Nnáu pa-sôl ŏ i-nha la pa-sôl ŏ cư, a-lứng nnáu pa-sôl ŏ cư ngki pa-sôl ŏ Án ndon yua cư. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Nnáu pa-sôl ŏ mu náq tang ng-cang co ti-cuôi ngki la tang ng-cang ngki bôn ráp cống te án tang ng-cang, a-lứng nnáu pa-sôl ŏ ti-cuôi ti-nớng tu-pứng co án la ti-cuôi ti-nớng tu-pứng bôn ráp cống te ti-cuôi ti-nớng tu-pứng. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />A-lứng khán nnáu dyôn mu náq te máh án ndon két ndô ngoiq mui choc dơq ta-ngan co án la ti-cuôi rian te cư, ngki ar-lớih lư, cư tông ada i-nha, ti-cuôi ngki lư ar-lớih lớiq pít cống na án.”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Ar-náq cơt ndóng Yang Yê-su khoiq ca to mu chít la bar náq ndon rian na án dyơ, Án ngốh te ngki dŏq ca to a-lứng taq-ntêr tớq máh vel na máh ti-cuôi clứng. <verse eid="MAT 11:1" /><verse number="2" style="v" sid="MAT 11:2" />Chón ngki, Yon, ndóng tớq cŏq tôt sáng taq-ntêr te máh ar-náq táq na Yang Choi Ta-mống, án yua top ndon rian án cóq tớq, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />plốh Án idô: “Thới la Án ndon yua tớq, a-láng top he yôl ng-cong pớn mu náq Án can-nŏ́h?” <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />Dŏq ôi liêh, Yang Yê-su tông ada nha-án: “Cóq chô, ntêr liêh dyôn Yon máh a-mớh i-nha hôm a-lớng sáng. <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Ti-cuôi sot têq hôm, ti-cuôi dyuat têq pu-pôq, ti-cuôi bŏ́q cơt práh, ti-cuôi túng sáng a-púh, ti-cuôi cu-chet cơt têq tu-mống liêh a-lứng ti-cuôi ki-dit a-rức bôn sáng tưi Par-nai ŏ Yang. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />A-lứng khán nnáu lớiq táq luaih co te cư la án bôn bún.”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Dyơ, ndóng máh ti-cuôi ngki pôq dyơ, Yang Yê-su ta-bớq taq-ntêr ada máh ti-cuôi clứng te Yon: “I-nha pôq nga ntúq aih dŏq me a-mớh — a-reng váh a-vít co cu-yiêl phớt? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Nám tớiq iki i-nha pôq ính me a-mớh — mu náq ti-cuôi ndon sứp na au dêu ŏ? Me ntíh, ti-cuôi sứp au dêu ŏ át tớq dúng puô. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Ma lư, i-nha pôq co ính me a-mớh — mu náq tang ng-cang? Cư tông ada i-nha, lư a-lứng bôn ti-cuôi ta-niêng díh mu náq tang ng-cang. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Ngki la te ti-cuôi ndon par-nai ndô khoiq ta-ran:</para>
  <para style="q1" vid="MAT 11:10">‘Me ngki, Cư khoiq yua tam-peng na Cư pôq nsuôi mát a-cái, án dŏq a-sa car-na dyôn a-cái nsuôi mát a-cái.’<verse eid="MAT 11:10" /></para>
  <para style="b" />
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />Ar-lớih lư, cư tông ada i-nha, ớq bôn nnáu têq a-rớq te máh ti-cuôi ndon mu náq cán car-nian ngki pưt hơn Yon táq tíc na dơq, ma ti-cuôi két lư tớq cruông tớq pilŏ́ng ngki pưt hơn te án. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Ma, tớq i-ngái te Yon táq tíc na dơq díh hoi ndô, cruông tớq pilŏ́ng chiuq diêiq a-rức nha tuh kát, a-lứng máh ti-cuôi lớiq ŏ ial bánh rêng pún cruông ngki. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Co nhéq máh ti-cuôi tang ng-cang a-lứng phep rit khoiq taq-ntêr dyôn ada Yon; <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />a-lứng khán i-nha lư ính chom, conh ngki la Ê-li, án yua tớq. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Nnáu bôn cu-tor ính cam-máng, ngki cam-máng. <verse eid="MAT 11:15" /><verse number="16" style="v" sid="MAT 11:16" />Ma cư ính a-cám pang ndô a-lứng callong a-mớh? Pang ndô ngki mu chứng a-rớq ngai a-cái ti-cu tớq ng-cưm vang, dyơ nha-án par-lơ mu nơi, <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />idô: ‘Top he plóng ti-rel dyôn ada i-nha, ma i-nha lớiq a-yưn pon-liauq. Top he par-lơ tallêng ma i-nha lớiq nhiêm.’ <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />Co Yon tớq, ớq cha a-lớng ớq ngoiq, ngki nha-án tông: ‘Án khoiq yang sáq pi-yúh.’ <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />A-cái Yang Cơt Ti-cuôi tớq, cha a-lứng ngoiq, ngki nha-án tông: ‘Me ti-cuôi ndô, la ti-cuôi ham cha, ham ngoiq, yớu na top tu-the a-lứng máh ti-cuôi luaih lới!’ Ma dyơ callong tu-báiq dŏq a-páh nhơ te máh ar-náq táq na callong tu-báiq ngki.”<verse eid="MAT 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Vít ngki, Án ta-bớq tíq máh ti-cuôi tớq vel ma máh ar-náq si-leh te Án khoiq a-páh tớq ntúq ngki, co nha-án lớiq piên mít tam-me. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“Bap dyôn ti-cuôi, Cô-ra-sin! Bap dyôn ti-cuôi, Bet-sai-da! Co khán máh ar-náq si-leh cơt pa-niar top nha-án dŏq a-páh tớq Ti-rơ nha Si-dôn, ngki lư nha-án khoiq piên mít tam-me te sứp au tallêng a-lứng boi a-bŏ́h tớq plô te tiêq dyơ. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Iki, Cư tông ada i-nha, lư bôn callong ng-hiêl hơn dyôn Ti-rơ nha Si-dôn tớq i-ngái tar-sưq ntáng ta-niêng ada top i-nha. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Ma ti-cuôi, Ca-bê-na-um, dêu ar-mo i-nha par-ngíh têq sớr nga pilŏ́ng? I-nha pôq nga ntúq na ti-cuôi cóq tớq. Co khán máh ar-náq si-leh cơt nga i-nha khoiq táq tớq Sô-dôm, ngki lư vel ngki yôl liêh díh i-ngái ndô. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Iki, Cư tông ada i-nha, tớq i-ngái tar-sưq, án sưq ng-hiêl dyôn cruông Sô-dôm ta-niêng dyôn top i-nha.”<verse eid="MAT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Piaiq chón ngki, Yang Yê-su pốh par-nai tông: “A-ám ơi, la A-ám na pilŏ́ng nha cu-teq, a-cái cứh ayô A-ám, co A-ám khoiq ca-tốq máh callong ndô te ti-cuôi tu-báiq a-lớng ti-cuôi chom a-cớl, dyơ a-páh te nha-án ada ngai a-cái két. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Lư, A-ám ơi, co lư iki la callong crái piaiq chứng mát A-ám. <verse eid="MAT 11:26" /><verse number="27" style="v" sid="MAT 11:27" />Cứp ar-náq khoiq A-ám cư mŏp dyôn cư; ớq bôn nnáu chom A-cái nưm A-ám, a-lứng ớq bôn nnáu chom A-ám nưm A-cái nha máh ti-cuôi khán A-cái ính a-páh dyôn. <verse eid="MAT 11:27" /><verse number="28" style="v" sid="MAT 11:28" />Cóq i-nha tớq nga cư, ơ nhéq máh ti-cuôi ndon a-leq a-láh nha dual crơng ntáng, dyơ cư dyôn i-nha bôn callong a-ngô. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Cóq ial dual liêq na cư tớq i-nha a-lứng rian te cư, co cư bôn mít khun nha lớiq ính ngai ayô, dyơ i-nha bôn tu-múh callong iên ŏ dyôn ar-vai i-nha. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Co liêq na cư lư iên a-lứng par-dual na cư la ng-hiêl.”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Chón ndóng i-ngái ngki, Yang Yê-su pôq na máh pi-dái tro ba-li tớq i-ngái A-ngô, ngki máh ndon rian na Án pi-nhaih iki nha-án ta-bớq ca-rứt máh tar-cong sro dyơ sréh cha. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Ma tư hôm ar-náq ngki, máh ti-cuôi Pha-ra-si tông ada Án: “Me ntíh, máh ndon rian na thới táq ar-náq lớiq têq táq tớq i-ngái A-ngô.” <verse eid="MAT 12:2" /><verse number="3" style="v" sid="MAT 12:3" />Ma, Án ôi liêh nha-án: “Top i-nha lớiq cơi dŏc ar-náq Da-vit khoiq táq chón ndóng puô a-lứng máh ti-cuôi pôq a-lớng án cơt pi-nhaih? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />I-mo puô khoiq mot tớq dúng na Yang Arbang Pilŏ́ng dyơ cha beng dŏq sang, ma beng ngki ndon lớiq têq puô a-lứng máh ti-cuôi pôq a-lớng puô dŏq cha, ma nưm dŏq dyôn ti-cuôi teng rit sang? <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />A-láng top i-nha lớiq cơi dŏc tớq phep rit i-mo tớq i-ngái A-ngô, máh ti-cuôi teng rit sang tớq dúng sang táq luaih i-ngái A-ngô ma nha-án ngki ớq luaih? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Ma cư tông ada i-nha idô bôn Án ndon pưt clưi dúng sang chón át tớq ndô. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Ma khán top i-nha chom ar-lớih te par-nai ndô la a-mớh: ‘Cư ính callong ar-moih ngki tới la crơng mŏp sang,’ dyơ lư i-nha lớiq dáh tông máh ti-cuôi ớq luaih. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Co A-cái Yang Cơt Ti-cuôi la Yang tớq i-ngái A-ngô.”<verse eid="MAT 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Dyơ tư khoiq ngốh te ngki, Án mot tớq dúng rum na nha-án. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Me ntíh, mu náq ti-cuôi bôn ati cơt coi, dyơ nha-án plốh Yang Yê-su, idô: “I-mo têq pa-lai a-ái tớq i-ngái A-ngô?” táq dyôn nha-án bôn cauq luaih Án. <verse eid="MAT 12:10" /><verse number="11" style="v" sid="MAT 12:11" />Ma Án ôi liêh nha-án: “Bôn ti-cuôi mmo tớq top i-nha, ti-cuôi ngki bôn mui allám cưu, a-lứng khán án a-tôh nga prúng tớq i-ngái A-ngô, ti-cuôi ngki lớiq kéu khớm án nha a-rŏ́q a-sớr? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />A-lứng dyơ a-cái ti-cuôi ngki tar-náp hơn te cưu chom ali mmo! Iki, têq táq ar-náq ŏ tớq i-ngái A-ngô.” <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Vít ngki, Án tông ada ti-cuôi ngki: “Mái pa-yơ ati na mái ngki.” Ti-cuôi ngki pa-yơ ati án dyơ ati án cơt ŏ liêh, mu chứng a-rớq ưllang ati ngki. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Ma tư dyơ ti-caq ngốh, máh ti-cuôi Pha-ra-si suô ngê chíl Án i-mo têq nha-án bôn ca-chet Án. <verse eid="MAT 12:14" /><verse number="15" style="v" sid="MAT 12:15" />Ma co khoiq chom iki, Yang Yê-su ngốh te ntúq ngki. Clứng ti-cuôi veng ta-pun Án, dyơ Án pa-lai bánh dyôn nhéq náq nha-án, <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />a-lứng Án pa-táp nha-án dŏq nha-án êq taq-ntêr te Án dyôn ngai chom, <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />táq dyôn par-nai khoiq dŏq tông na tang ng-cang Ê-sai ngki tar-vớiq, idô:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“Me ndô, ti-cuôi táq ar-náq Cư, Ti-cuôi ndon Cư khoiq rêh;</para>
  <para style="q1" vid="MAT 12:18">Ti-cuôi par-láng lư na Cư, tớq te Án, ar-vai Cư sáng bui can-nính.</para>
  <para style="q1" vid="MAT 12:18">Cư dyôn Ar-vai Cư tớq Án,</para>
  <para style="q1" vid="MAT 12:18">a-lứng Án pau ntêr callong ti-nớng tu-pứng dyôn ti-cuôi tới ti-cuôi Isa-ra-el.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Án lớiq tar-miên lớiq la hiar yứng;</para>
  <para style="q1" vid="MAT 12:19">nha ớq nnáu bôn sáng cang Án na car-na pưt.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Án lư lớiq péq a-róng khoiq liat;</para>
  <para style="q1" vid="MAT 12:20">Án lư lớiq pu-pát den tớu lu-liauq ính pát,</para>
  <para style="q1" vid="MAT 12:20">ti-ngôi ndóng Án dông callong ti-nớng tu-pứng tớq pa-rap nhéq,<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />a-lứng máh ti-cuôi tới ti-cuôi Isa-ra-el lư bôn ng-cong te nốh Án.”<verse eid="MAT 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Vít ngki, bôn ti-cuôi sot nha lúng co yang sáq pi-yúh ngai dông a-tớq dyôn Án, dyơ Án pa-lai bánh dyôn ti-cuôi ngki, ti-ngôi ti-cuôi lúng ndô ta-cang têq nha bôn hôm. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Nhéq máh ti-cuôi clứng sáng dut dyơ tông: “Dêu ar-mo ti-cuôi ndô la A-cái na Da-vit?” <verse eid="MAT 12:23" /><verse number="24" style="v" sid="MAT 12:24" />Ma máh ti-cuôi Pha-ra-si, dyơ bôn sáng ar-náq ngki, khoiq ntêr: “Ti-cuôi ndô lớiq rap chuih a-mớh yang sáq khán lớiq bôn co Bên-ya-bul, la sút nhéq yang sáq.” <verse eid="MAT 12:24" /><verse number="25" style="v" sid="MAT 12:25" />Ma khoiq dŏq chom par-ngíh na nha-án, Án tông ada nha-án: “Cứp cruông tár chuôq rúc chíl liêh tar-tuôq bôm táq dyôn pláh chap, a-lứng cứp vel lớiq la mu dúng ma chuôq rúc chíl liêh ada tar-tuôq bôm ngki cơt lớiq tár ŏ nnáng. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Khán Yang Sáq chuih bôm Yang Sáq, nha-án chuôq rúc chíl tar-tuôq bôm. Khán iki, táq i-mo cruông nha-án têq át a-khớm? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />A-lứng khán cư nhơ Bên-ya-bul chuih máh yang sáq, a-cái i-nha ngki nnáu chuih nha-án? Co te ar-náq ndô, nha-án la máh ti-cuôi tar-sưq i-nha. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Ma khán cư chuih máh yang sáq nhơ Yang Ar-vai na Yang Arbang Pilŏ́ng, khán iki cruông na Yang Arbang Pilŏ́ng khoiq tớq nga i-nha. <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />Lớiq la táq i-mo ti-cuôi ngki bôn mot tớq dúng ti-cuôi bánh rêng dyơ tôiq crơng-crớu na án ma nsuôi lư ti-cuôi ngki lớiq chóq ti-cuôi bánh rêng ngki a-vai? Dyơ vít ngki, ti-cuôi ndô bôn ial crơng te dúng conh ngki. <verse eid="MAT 12:29" /><verse number="30" style="v" sid="MAT 12:30" />Nnáu lớiq át mu nơi a-lớng cư la ính chíl liêh cư, a-lứng nnáu lớiq mui mít a-lớng cư iki án ính chíl liêh. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Co te ar-náq ndô, cư tông ada i-nha, cứp callong luaih a-lứng par-nai a-craiq têq ta-láh dyôn ti-cuôi ngki, ma par-nai a-craiq díh Yang Ar-vai ngki lớiq têq ta-láh luaih. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Khán nnáu tông par-nai a-craiq A-cái Yang Cơt Ti-cuôi, ti-cuôi ngki lư bôn táh luaih. Ma ti-cuôi mmo tông a-craiq Yang Ar-vai, ti-cuôi ngki lư lớiq têq táh luaih, díh tớq pang ndô lớiq la tớq pang chô mát. <verse eid="MAT 12:32" /><verse number="33" style="v" sid="MAT 12:33" />Lớiq la, a-sa a-long ŏ ngki cu-lái án ŏ, ma a-sa a-long lớiq ŏ ngki cu-lái án lớiq ŏ, co a-long khoiq dŏq a-cớl nhơ te cu-lái na án. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Tŏ́ng toiq cu-sánh pih ntíh, co la lớiq, top i-nha i-mo têq ntêr par-nai ŏ? Co ng-cang taq-ntêr a-ngốh te ngê khoiq cơt tớq mít can-nính. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Ti-cuôi ŏ, tớq te mít can-nính ŏ na án, cơt ngốh callong ŏ, ma ti-cuôi lới, tớq te mít can-nính lớiq ŏ na án, cơt ngốh callong lớiq ŏ. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Ma cư tông ada i-nha i-mo máh par-nai ớq cơt callong ndon ti-cuôi ngki ta-cang, nha-án cóq ntêr liêh te par-nai nha-án tớq i-ngái tar-sưq. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Co tớq te máh par-nai pốh ta-cang te án, ngki i-nha cơt ti-nớng ŏ, a-lứng tớq te máh par-nai taq-ntêr na án, i-nha cơt bôn luaih.”<verse eid="MAT 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Vít ngki, bôn máh ti-cuôi sái rit nha ti-cuôi Pha-ra-si plốh Án, idô: “Thới ơi, top he ính hôm te thới mui tíc si-leh.” <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />Ma dyơ ính ôi liêh, Án tông ada nha-án: “Pang ndô lới lư a-lứng táq ar-náq saq si-suô tíc si-leh, ma ớq bôn tíc si-leh mmo lư bôn dyôn ada nha-án, nưm tíc si-leh na tang ng-cang Yô-na. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Co Yô-na khoiq át tớq pallúng buaiq pưt pe i-ngái a-lứng pe i-dáu cơt i-mo, A-cái Yang Cơt Ti-cuôi át pe i-ngái a-lứng pe i-dáu tớq pưn cu-teq ali ngki tưi. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Tớq i-ngái tar-sưq, ti-cuôi Ni-ni-ve cóq ta-yứng mu nơi a-lứng ti-cuôi pang ndô dyơ bôn callong tíq nha-án. Co nha-án khoiq ngin luaih nsuôi par-nai ca to na Yô-na, ngki me ndô, Án ndon tu-báiq ta-niêng Yô-na tớq ndô. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Tớq i-ngái tar-sưq, puô cán cruông Sê-ba yôr ta-yứng pôq a-lứng pang ndô dyơ tíq nha-án, co te máh pứp talloiq na cruông cu-teq, án tớq ính cam-máng callong tu-báiq te Sa-la-môn, ma me ndô, Án sút pưt ta-niêng Sa-la-môn tớq ndô. <verse eid="MAT 12:42" /><verse number="43" style="v" sid="MAT 12:43" />Dyơ, tư yang sáq ngốh te mu náq ti-cuôi, án pôq na máh ntúq preng cu-próng, suô ntúq a-ngô ma lớiq tu-múh. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Ndóng ngki, án par-ngíh: ‘Cư chô liêh nga dúng cư ndon cư khoiq ngốh te ntúq ngki.’ Dyơ án chô tớq, án hôm ớq chín a-mớh, khoiq ngai prêh sa práh a-lứng cơt ŏ car-siat lư. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Vít ngki, án pôq dyơ dông a-chô mu nơi a-lứng án tu-pul yang sáq can-nŏ́h ma saq ta-niêng án, dyơ nha-án mot tớq callúng, nha-án tu-mống tớq ngki. Dyơ thôq ti-cuôi ngki cơt saq ta-niêng te nsuôi. Ar-náq lư cơt iki tớq pang saq ndô.”<verse eid="MAT 12:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Ndóng Án yôl chón taq-ntêr ada ti-cuôi clứng, me ntíh, a-i a-lứng máh a-em na Án át pớn tớq tiêh, si-suô ính taq-ntêr a-lứng Án. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Dyơ ngki, mu náq ti-cuôi taq-ntêr ada Án: “Ntíh, a-i thới a-lứng máh a-em na thới ta-yứng tớq tiêh, si-suô ính taq-ntêr a-lứng thới.” <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />Ma ndóng ôi liêh, Án tông ada ti-cuôi ndon ntêr ar-náq a-lứng án: “Nnáu la a-i cư a-lứng nnáu la máh a-em cư?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Dyơ tư pa-yơ ati án nga top ndon rian te án, Án tông: “Me ntíh, a-i cư a-lứng máh a-em na cư! <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Co khán ti-cuôi mmo táq veng a-rớq can-nính na A-ám cư tớq pilŏ́ng, ti-cuôi ngki lư a-em conh, a-em cán a-lớng a-i na cư.”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Tớq i-ngái ngki, vít dyơ ngốh te dúng, Yang Yê-su ti-cu tớq tor dơq ving ca-vang. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Máh ti-cuôi lư clứng át par-chúng pa-niar Án. Tar-lúh, án sớr tớq mui allám tuôc, Án ti-cu, ma máh ti-cuôi clứng ta-yứng tớq tor dơq. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Dyơ Án tông ada nha-án a-ưi par-nai na a-cám, idô: “Me ndô, mu náq ti-cuôi trứh mma ti-caq pôq dŏq trứh. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Ndóng trứh mma, bôn callong a-tôh na car-na, ngki a-chếq tớq dyơ tŏ́h cha nhéq mma ngki. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Bôn callong can-nŏ́h a-tôh tớq cu-teq búl, la ntúq ớq bôn a-ưi cu-teq. Chái lư, callong mma ngki dáh, co cu-teq lớiq bôn sru. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Ma tư mát pan-dang claq, án cơt ng-ngot a-lứng ráng co ớq bôn riaih. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Bôn callong mma can-nŏ́h a-tôh tớq máh a-long tang-háng, ngki máh a-long tang-háng críh dyơ cluôm viang án. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Ma callong can-nŏ́h loi a-tôh tớq cu-teq ŏ dyơ dáh cơt cu-lái, mui tôm ngki mui cu-lám ndon a-ưi lư, mui tôm ngki tu-pát chít, mui tôm ngki pe chít. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Nnáu bôn cu-tor, cóq cam-máng.”<verse eid="MAT 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Dyơ top ndon rian, tớq tar-mán, plốh Án: “Co i-mo ma thới tông na par-nai a-cám ada ti-cuôi clứng?” <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />Iki, ndóng ôi liêh, Án khoiq tông ada nha-án idô: “Ma ada i-nha ngki khoiq dyôn dŏq chom máh par-nai ca-tốq te cruông tớq pilŏ́ng, ma ada máh ti-cuôi ngki ớq bôn dyôn. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Co ti-cuôi mmo bôn, te phê ti-cuôi ngki bôn a-ưi lư loi, a-lứng ti-cuôi ngki pớnh clưi clưai. Ma ti-cuôi mmo ớq bôn, ngki cơt ta-ial viang te án díh callong ti-cuôi ngki bôn. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Co te ar-náq ndô, cư tông ada i-nha tớq par-nai a-cám; lư ntro bôn me, nha-án ớq bôn hôm; lư ntro pi-chel cu-tor, nha-án ớq bôn sáng, a-lứng ớq a-púh. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />A-lứng par-nai tang ng-cang na Ê-sai cơt tar-vớiq tớq nha-án, idô:</para>
  <para style="q1" vid="MAT 13:14">‘Te ar-náq cam-máng, top i-nha pi-chel cu-tor, ma lư ar-lớih top i-nha ớq a-púh;</para>
  <para style="q1" vid="MAT 13:14">ma ndóng me, top i-nha tang-ngơq me, ma lư ar-lớih top i-nha ớq bôn hôm.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Co mít ti-cuôi ndô khoiq cơt cớng lư;</para>
  <para style="q1" vid="MAT 13:15">cu-tor nha-án cam-máng cơt diêiq a-rức,</para>
  <para style="q1" vid="MAT 13:15">a-lứng nha-án ca-sot mát nha-án,</para>
  <para style="q1" vid="MAT 13:15">dáh lơ nha-án têq bôn hôm na mát,</para>
  <para style="q1" vid="MAT 13:15">bôn sáng na cu-tor,</para>
  <para style="q1" vid="MAT 13:15">a-púh tớq mít,</para>
  <para style="q1" vid="MAT 13:15">dyơ píh liêh,</para>
  <para style="q1" vid="MAT 13:15">a-lứng Cư lư pa-lai bánh nha-án.’<verse eid="MAT 13:15" /></para>
  <para style="b" />
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />Ma bún lư mát na i-nha, co bôn hôm, a-lứng cu-tor na i-nha, co bôn sáng. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Ar-lớih lư, cư tông ada i-nha i-mo a-ưi tang ng-cang a-lứng ti-cuôi ti-nớng ŏ tel-sél ính hôm máh ar-náq i-nha hôm, ma nha-án ớq bôn hôm, a-lứng ính cam-máng máh ar-náq i-nha sáng, ma nha-án ớq bôn sáng. <verse eid="MAT 13:17" /><verse number="18" style="v" sid="MAT 13:18" />Iki, i-nha cóq cam-máng par-nai a-cám te ti-cuôi trứh mma. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Cứp náq ti-cuôi cam-máng par-nai ŏ te cruông tớq pilŏ́ng ma lớiq a-púh, yang sáq tớq dyơ ial viang callong ndon khoiq dŏq trứh tớq mít ti-cuôi ngki. Ndô la callong mma dŏq trứh tớq car-na. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Ma callong mma ndon trứh tớq cu-teq búl, ngki la ti-cuôi cam-máng par-nai ŏ dyơ chái lư ráp peh par-nai ŏ ngki co te mít sáng bui; <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />ma ti-cuôi ngki ớq bôn riaih sru tớq án, ma nưm án náp peh mu hoi sớng; iki dyơ diêiq a-rức lớiq la ngai pi-ốh tớq co te par-nai ŏ yang, ti-cuôi ngki chái lư án ca-lôih. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Ma callong mma ndon trứh tớq pan-di máh sác tang-háng, ndô la ti-cuôi cam-máng par-nai ŏ yang, ma lo khít níc tớq pang ndô a-lứng par-ngíh te callong súc bôn táq dyôn par-nai ŏ yang ngki lớiq têq críh a-lứng án cơt lớiq cu-lái. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Ma callong mma ndon trứh tớq cu-teq ŏ, ngki la ti-cuôi cam-máng par-nai ŏ yang nha a-púh, ti-cuôi ngki cơt cu-lái dyơ cu-lái mui tôm mui cu-lám, mui tôm tu-pát chít, mui tôm pe chít.”<verse eid="MAT 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Án tông ada nha-án mui par-nai a-cám can-nŏ́h, idô: “Cruông tớq pilŏ́ng mu chứng a-rớq mu náq ti-cuôi khoiq trứh mma ŏ tớq pi-dái án. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Ma ndóng cứp náq ti-cuôi bíq, án ndon uan na ưlla ngki tớq dyơ trứh sác yáq nưan car-chúc mu nơi a-lớng tro dyơ ngốh te pi-dái. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Tư tro dáh cơt pa-nung, ngki sác yáq nưan ngki la hŏn tưi. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Hoi ngki, máh prái tar-ráih na ưlla pi-dái ngki, tư dyơ tớq, khoiq tông ada án: ‘Ưlla ơi, tới ưlla khoiq trứh callong mma ŏ tớq pi-dái ưlla? Khán iki, sác yáq nưan te mmo cơt tớq?’ <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Iki ưlla ôi nha-án: ‘Mu náq ti-cuôi uan cư khoiq táq ar-náq ndô.’ Dyơ máh prái tar-ráih plốh sa án: ‘Khán iki, ưlla ính ndóng pôq nga pi-dái, top he rưc nhéq sác yáq nưan lớiq?’ <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Ma ưlla ôi: ‘Êq, dáh lơ chón ndóng rưc sác yáq nưan, top i-nha ráh ta-rưc tro mu nơi a-lớng sác yáq nưan. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Cóq dŏq bar nốh ngki pưt a-sớr dyôn tớq tư si-sot, dyơ tớq tar-mán ính sŏt, cư yua máh ti-cuôi ráiq: Nsuôi lư, cóq pa-chúng sác yáq nưan a-vai a-lứng chóq sác cơt tar-nian dyơ chóng sác ngki táp, ma cóq pa-chúng stro tớq ti-nong na cư.’”<verse eid="MAT 13:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Án tông sa ada nha-án mui par-nai a-cám can-nŏ́h, idô: “Cruông tớq pilŏ́ng ngki mu chứng a-rớq mui callong a-pi ma cua dyơ ial, mu náq ti-cuôi trứh tớq pi-dái án; <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />ma callong mma ngki tam la két lư te nhéq tưh máh thư callong, ma dyơ án pa-huô, án pưt ta-niêng máh a-long tớq ro a-lứng cơt mui tôm a-long, tar-lúh a-chếq pilŏ́ng tớq dyơ táq sáp tớq máh a-beng a-long ngki.” <verse eid="MAT 13:32" /><verse number="33" style="v" sid="MAT 13:33" />Án ca to ada nha-án tớq par-nai a-cám can-nŏ́h: “Cruông tớq pilŏ́ng ngki mu chứng a-rớq bôt pôih ndon cua khoiq ial, mu náq cán dŏq car-chúc a-lứng pe car-póc bôt tar-lúh díh bôt pôih nhéq.”<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Yang Yê-su khoiq ca to cứp nốh ngki ada ti-cuôi clứng na par-nai a-cám, dyơ Án lớiq ca to callong a-mớh ada nha-án ma tới na par-nai a-cám, <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />dyôn têq par-nai khoiq dŏq tông na tang ng-cang cơt tar-vớiq, idô:</para>
  <para style="q1" vid="MAT 13:35">“Cư lư pốh ng-cang Cư na máh par-nai a-cám.</para>
  <para style="q1" vid="MAT 13:35">Cư lư taq-ntêr máh callong ndon dŏq ca-tốq te ndóng teng cơt pilŏ́ng cu-teq.”<verse eid="MAT 13:35" /></para>
  <para style="b" />
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Vít ngki, cua dyơ ngốh te máh ti-cuôi clứng, Án mot tớq dúng. Máh ndon rian Án tớq tar-mán Án, plốh: “Seq taq-ntêr dyôn top he par-nai a-cám te sác yáq nưan tớq pi-dái.” <verse eid="MAT 13:36" /><verse number="37" style="v" sid="MAT 13:37" />Dyơ ngki, ndóng ính ôi, Án tông: “Ti-cuôi trứh mma ŏ la A-cái Yang Cơt Ti-cuôi, <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />ma pi-dái la cúc cu-teq, ma callong mma ŏ — ndô la a-cái a-con te cruông ang ưr. Ma lư, sác yáq nưan la a-cái a-con na ti-cuôi lớiq ŏ, <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />ma ti-cuôi ndon uan, la ti-cuôi khoiq trứh sác yáq nưan, la yang sáq. Ma ki-sái si-sŏt la i-ngái tar-sưq, ma máh ti-cuôi sŏt la máh tar-neng. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Iki, mu chứng a-rớq sác yáq nưan khoiq dŏq pa-chúng dyơ a-pŏ́ng tớq uih, ngki ar-náq lư cơt mu chứng iki tưi tớq i-ngái tar-sưq. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />A-cái Yang Cơt Ti-cuôi lư yua máh tar-neng na án, a-lứng nha-án pa-chúng a-ngốh te cruông Án nhéq máh nốh táq luaih a-lứng máh ti-cuôi táq ar-náq lớiq ŏ. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Dyơ nha-án a-pŏ́ng ti-cuôi ngki tớq uih chéh, la ntúq lư bôn callong nhiêm cu-cloiq a-lứng cal-tưat ki-neng. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Ndóng ngki, máh ti-cuôi ti-nớng tu-pứng ta-bal a-rớq mát pan-dang tớq cruông na A-ám nha-án. Nnáu bôn cu-tor, cóq cam-máng.”<verse eid="MAT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“Cruông tớq pilŏ́ng ngki a-rớq crơng ngáih dŏq tứp tớq mui allám pi-dái, la crơng ndon mu náq ti-cuôi khoiq tứp ndóng bôn tu-múh. Tớq táp callong bui hơr te án, án chô, táiq nhéq cứp nốh án bôn dyơ plới pi-dái ngki. <verse eid="MAT 13:44" /><verse number="45" style="v" sid="MAT 13:45" />Dyơ ngki loi, cruông tớq pilŏ́ng ngki a-rớq mu náq ti-cuôi, ndon táiq plới si-suô hôt tiêq tar-náp lư. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Dyơ, ndóng tu-múh mui callong hôt tiêq tar-náp lư, dyơ ndóng chô, án khoiq táiq nhéq máh mun án ưlla dyơ plới pi-dái ngki.<verse eid="MAT 13:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />Dyơ ngki loi, cruông tớq pilŏ́ng ngki a-rớq mui pláh mben ngai lai tớq dơq dyơ cŏp cứp nốh buaiq, <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />ma tư mben pớnh buaiq, ngai lúq a-sớr tớq tor, dyơ ti-cu, nha-án rêh máh buaiq ŏ ca-cháq tớq a-dư, ma máh buaiq lớiq ŏ, nha-án a-dúh nga tiêh. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Cứp ar-náq la iki tớq i-ngái tar-sưq: Máh tar-neng pôq, dyơ lư car-yáh top ti-cuôi lới te máh ti-cuôi ti-nớng ŏ, <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />dyơ nha-án a-pŏ́ng ti-cuôi ngki tớq uih chéh, la ntúq lư bôn callong nhiêm cu-cloiq a-lứng cal-tưat ki-neng. <verse eid="MAT 13:50" /><verse number="51" style="v" sid="MAT 13:51" />I-nha khoiq a-púh nhéq máh callong ndô?” Nha-án ôi Án: “Ơq.”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Dyơ ngki, Án tông ada nha-án: “Co te ar-náq ndô, máh thới sái rit khoiq bôn rian te cruông tớq pilŏ́ng mu chứng a-rớq mu náq ti-cuôi ưlla dúng, ngki án a-ngốh mun tiêq nha mun tam-me te hóng hip na án.” <verse eid="MAT 13:52" /><verse number="53" style="v" sid="MAT 13:53" />Ar-náq cơt ngki la ndóng Yang Yê-su tông nhéq dyơ máh par-nai a-cám ndô, Án pôq viang te ntúq ngki.<verse eid="MAT 13:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 13:54" />Dyơ ndóng tớq nga vel án, Án ca to ti-cuôi clứng tớq dúng rum na nha-án, tar-lúh táq dyôn nha-án sáng dut lư dyơ taq-ntêr: “Callong tu-báiq ngki a-lứng ar-náq si-leh te ti-cuôi ndô tớq te mmo? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Com ti-cuôi ndô la a-cái conh ti-cuôi táq pan? Tới a-i án ngai dŏq ngki Ma-ri a-lứng máh a-em conh na án Ya-cơ, Yô-sep, Si-môn nha Yu-da? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Tới nhéq máh a-em cán na án chón át a-lứng top he? Iki, cứp ar-náq ndô la co án tớq te mmo?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Nha-án sáng pi-ŏ́q te Án. Ma Yang Yê-su tông ada nha-án: “Tang ng-cang ớq bôn ngai ayê, ma nưm tớq vel án a-lứng tớq dúng án.” <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Án lớiq táq a-ưi ar-náq si-leh tớq ngki co mít lớiq náp te nha-án.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Piaiq i-ngái ngki, puô Hê-rôt hanh ar-náq te Yang Yê-su. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Puô plốh máh tam-peng án: “Ngki la Yon táq tíc na dơq. Án khoiq tu-mống liêh te cu-chet, co te ngki, máh ar-náq si-leh mbơiq cơt te ti-cuôi ndô.” <verse eid="MAT 14:2" /><verse number="3" style="v" sid="MAT 14:3" />Co Hê-rôt, khoiq cŏp Yon, dyơ yua líng chóq án a-lứng crál tớq cŏq tôt, co la Hê-rô-diê, cam-pái na Phi-lip, a-em conh puô. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Co Yon khoiq tông ada Puô: “Mái, lớiq têq ial cán ngki.” <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Ntro ính ca-chet án táp, ma Puô a-dáh ti-cuôi clứng, co nha-án me Yon a-rớq mu náq tang ng-cang. <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />Ma ndóng tớq pêl cha bui car-nian na Hê-rôt, a-cái cán na Hê-rô-diê a-yưn tớq pan-di pêl cha bui dyơ táq bui mít Hê-rôt, <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />co iki, puô khoiq ưq mu nơi a-lứng par-nai car-hŏt ính dyôn cán ngki khán callong a-mớh ndon án seq. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Iki, dyơ khoiq cua dŏq yua nsuôi co a-i án, án ôi: “Seq dyôn ada a-cái hoi ngki táp, plô na Yon táq tíc na dơq tớq mpiên a-diên.” <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />A-lứng tam sáng a-nguaq, ma co par-nai car-hŏt te án a-lứng máh tu-moi mu nơi ti-cu cha, puô yua táp a-rớq cán ngki ính. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Dyơ yua táp líng pôq, puô dyôn ti-cŏ́h plô Yon tớq cŏq tôt. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Plô na Yon khoiq ngai a-ngốh tớq a-diên dyơ dyôn ada cán ngki, dyơ án a-chô ada a-i án. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Ndóng bôn tớq tar-mán dyơ, máh top rian na Yon ial cu-muiq dyơ dông tứp án. Dyơ vít ngki, nha-án ntêr liêh dyôn Yang Yê-su.<verse eid="MAT 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Dyơ, bôn sáng iki, Yang Yê-su ngốh te ngki sớr tớq mui allám tuôc pôq nga ntúq ớq bôn nnáu át nưm mu náq án. Co khoiq chom iki, máh ti-cuôi clứng te máh vel veng ta-pun Án. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Tư mbơiq siar te tuôc, Án hôm mui top ti-cuôi clứng lư, ngki sáng srui-táq ada máh ti-cuôi clứng a-lứng Án pa-lai bánh máh ti-cuôi a-ái te nha-án. <verse eid="MAT 14:14" /><verse number="15" style="v" sid="MAT 14:15" />Hoi ngki, khoiq tu-mán ính i-dáu, top ndon rian tớq nga Án, plốh: “Ntúq ndô ngki ớq ti-cuôi át, a-lứng hoi ngki khoiq tu-liê dyơ. Seq thới yua máh ti-cuôi ndô dŏq pôq mot na máh vel dyơ, nha-án têq plới tan-na dyôn nha-án.” <verse eid="MAT 14:15" /><verse number="16" style="v" sid="MAT 14:16" />Ma Yang Yê-su tông ada nha-án: “Nha-án lớiq sáng par-ngíh ính pôq. I-nha táp dyôn nha-án cha.” <verse eid="MAT 14:16" /><verse number="17" style="v" sid="MAT 14:17" />Ndóng ngki, nha-án ôi ada Án: “Tớq ndô top he ớq bôn a-mớh nưm sông lám beng nha bar lám buaiq.” <verse eid="MAT 14:17" /><verse number="18" style="v" sid="MAT 14:18" />Dyơ Án tông: “Áu dông crơng ngki nga tu-dô ada cư.” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Dyơ yua máh ti-cuôi clứng ti-cu tớq sác ngki, ndóng án kéu sông lám beng nha bar lám buaiq, ti-ngưi mát nga pilŏ́ng, Án si-ơn, dyơ péq, Án a-vôi tan-na dyôn top ndon rian, ma top ndon rian dyôn nga ti-cuôi clứng. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Nhéq máh ti-cuôi clứng khoiq cha cơt sái nhéq. Dyơ nha-án pa-chúng ndon yôl liêh te máh ntiê — bôn mu chít la bar ca-riê pớnh. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Tớq ngki, máh ti-cuôi ndon cha bôn ali sông ngin náq ti-cuôi conh, i-yốh náp ti-cuôi cán a-lứng ngai a-cái.<verse eid="MAT 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Cua ngki, Án yua top ndon rian sớr tớq tuôc dyơ pôq nsuôi Án pa dyang a-tŏ́h, chón ndóng Án yua ti-cuôi clứng chô. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Vít dyơ máh ti-cuôi clứng chô, Án sớr tớq cóh dŏq pôq cớu seq mmar. Díh i-dáu, Án át tớq ngki mu náq án. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Ma tuôc tớq pan-di dơq clóng dyơ ngki bôn dơq lam-póh ki-chíh co cu-yiêl táq. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />Ndóng ngki, pilŏ́ng khoiq sưm tu-rưm ang te i-dáu ngki, Án tớq nga nha-án, ti-caq na lar dơq. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Ma tư dyơ bôn hôm Án ti-caq na lar dơq, top ndon rian sáng a-dáh, tông idô: “Ngki la cu-muiq,” dyơ nha-án hiar yứng lư co sáng a-dáh. <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />Dyơ, Yang Yê-su pốh tông ada nha-án idô: “Át a-ŏ! Ngki cư. Êq a-dáh!” <verse eid="MAT 14:27" /><verse number="28" style="v" sid="MAT 14:28" />Ma, ndóng ôi liêh Án, Phi-er tông: “Thới ơi, khán lư thới, seq ca to dyôn cư pôq na lar dơq tớq nga thới.” <verse eid="MAT 14:28" /><verse number="29" style="v" sid="MAT 14:29" />Iki Án yua: “Áu tớq tu-dô.” Dyơ tư siar te tuôc, Phi-er ti-caq na lar dơq ính pôq nga Yang Yê-su. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Ma ndóng hôm cu-yiêl hớp, án sáng a-dáh, a-lứng ndóng ta-bớq ính trim, án hiar táp, idô: “Thới ơi, seq choi cư!” <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />Ngki táp, vít ndóng pa-yơ ati, Yang Yê-su ntớp Phi-er a-lứng tông ada án: “Ơi ti-cuôi biq callong tin, co i-mo mái yôl ma-mu?” <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />Ndóng nha-án sớr tớq tuôc dyơ, cu-yiêl lớiq phớt nnáng. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Ma máh ti-cuôi tớq tuôc cu-cúh sang Án, idô: “Lư ar-lớih, thới la A-cái Yang Arbang Pilŏ́ng.”<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Tư díh pa dyang a-tŏ́h dơq, nha-án pa-chít nga tor tớq Ca-nê-sa-ret. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Dyơ ndóng a-cớl Án, máh ti-cuôi tớq ntúq ngki yua mu náq chô ntêr díh chuôp vel pa-niar ngki, dyơ ngai dông a-tớq ada Án máh ti-cuôi a-ái tar-ma. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Nha-án seq Án nưm dŏq nha-án bôn ca-pơiq tớq mbaiq au na Án, a-lứng ti-cuôi mmo thới ca-pơiq cơt bánh nhéq.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Dyơ ngki, máh ti-cuôi Pha-ra-si a-lứng ti-cuôi sái rit te Yaru-salem tớq nga Yang Yê-su, plốh idô: <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“Co i-mo top ndon rian na thới lớiq veng máh phep rit na a-chúc a-chiac he? Co top nha-án lớiq a-rau ati ndóng cha beng.” <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />Ma ndóng ôi liêh, Án tông ada nha-án: “Co i-mo top i-nha ngki táh callong pa-táp te Yang Arbang Pilŏ́ng ma veng máh phep rit na i-nha? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Co Yang Arbang Pilŏ́ng khoiq pa-táp, idô: ‘Cóq dyám náp a-ám a-i na i-nha,’ a-lứng ‘Ti-cuôi mmo a-craiq a-ám lớiq la a-i, cóq ca-chet ti-cuôi ngki.’ <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Ma top i-nha tông: ‘Ti-cuôi mmo tông ada a-ám lớiq la a-i án: “Khán nốh a-mớh tớq te a-cái têq choi dyôn a-ám a-i la khoiq mŏp dyôn Yang Arbang Pilŏ́ng,”’ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />ti-cuôi ngki lư ar-lớih tới dyám náp a-ám án. Iki, top i-nha khoiq táh par-nai Yang Arbang Pilŏ́ng la co phep rit na i-nha. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Top táq náh nnan ntíh! Ê-sai khoiq tông a-cớiq lư piaiq te top i-nha, idô:<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />‘Ti-cuôi ndô cứh ayô Cư nưm na ng-cang sớng,</para>
  <para style="q1" vid="MAT 15:8">ma mít nha-án ngki yông lư te Cư.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Ngki nha-án sang tám Cư lớiq cơt callong,</para>
  <para style="q1" vid="MAT 15:9">ndóng ca to máh phep rit la máh phep rit tớq te ti-cuôi.’”<verse eid="MAT 15:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="MAT 15:10" />Dyơ ndóng arô máh ti-cuôi clứng tớq, Án tông ada nha-án: “Cóq cam-máng a-lứng a-púh: <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Ớq nốh a-mớh mot na hóng ng-cang táq dyôn lớiq práh veng rit mu náq ti-cuôi, ma la nốh te ng-cang pốh tông, nốh ndô táq dyôn lớiq práh veng rit ti-cuôi ngki.” <verse eid="MAT 15:11" /><verse number="12" style="v" sid="MAT 15:12" />Cua ngki, ndóng khoiq tớq tar-mán, top ndon rian plốh táp Án: “Thới chom lớiq máh ti-cuôi Pha-ra-si khoiq sáng uan vít dyơ cam-máng par-nai ngki?” <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />Ma ndóng ính ôi, Án tông: “Cứp a-long ndon A-ám tớq pilŏ́ng na cư lớiq chóh ngki cóq rưc nhéq. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Dŏq nha-án cơt iki! Nha-án la máh ti-cuôi par-yông ti-cuôi sot. Ma khán ti-cuôi sot par-yông ti-cuôi sot, nha-án bar náq lư a-tôh tớq prúng.” <verse eid="MAT 15:14" /><verse number="15" style="v" sid="MAT 15:15" />Dyơ ngki ndóng ính ôi liêh, Phi-er plốh táp Yang: “Seq taq-ntêr ar-lớih dyôn top he par-nai a-cám ngki.” <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />Ma Án tông: “Díh hoi ndô, i-nha yôl lớiq a-púh sa? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />I-nha i-yốh a-púh i-mo cứp nốh mot na hóng ng-cang siar nga pallúng dyơ ngốh na pan-nôq? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Ma máh nốh ndon ngốh te ng-cang la tớq te mít can-nính, a-lứng nốh ngki táq lớiq práh ada ti-cuôi. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Co te mít can-nính pốh tông máh par-ngíh lớiq ŏ, ca-chet ti-cuôi, láh par-lưi, tới cam-pái ca-yiêq bíq mu nơi, ti-tôiq, taq-ntêr a-uai a-lứng máh par-nai can-nốh. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Ngki la máh nốh táq dyôn lớiq práh veng rit ti-cuôi, ma cha tớq ati i-yốh a-rau ngki lớiq táq dyôn lớiq práh veng rit ti-cuôi.”<verse eid="MAT 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Dyơ ndóng ngốh te ngki, Yang Yê-su mot tớq máh ntúq tu-mán vel Ti-rơ nha Si-dôn. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />A-lứng me ngki, bôn mu náq cán ti-cuôi Ca-na-an, ndon te ntúq ngki tớq, arô yứng, idô: “Ơi thới, A-cái puô Da-vit, seq srui-táq cư! A-cái cán cư bôn yang sáq pi-yúh diêiq a-rức lư.” <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />Ma Án lớiq ôi liêh cán ngki díh mui callong. Dyơ ndóng tớq tar-mán Án, top ndon rian át seq te Án, idô: “Seq thới yua ơi ndô chô, co án át arô yứng te cróng top he.” <verse eid="MAT 15:23" /><verse number="24" style="v" sid="MAT 15:24" />Ma ndóng ôi liêh, Án tông: “Cư khoiq lớiq bôn tớq, khán tới dyôn máh cưu clu car-na na ti-cuôi Isa-ra-el.” <verse eid="MAT 15:24" /><verse number="25" style="v" sid="MAT 15:25" />Ma ndóng tớq, cán ngki mpop chứng mát Án, tông: “Thới ơi, seq choi cư.” <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />Dyơ ngki, ndóng ôi liêh, Án tông: “Ial beng na a-cái a-con dyơ dyôn ada a-cho a-cái la lớiq crái.” <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />Ma cán ngki ôi: “Thới ơi, lư iki, ngki díh a-cho a-cái la bôn cha te máh ntiê sráh te ntúq ưlla na nha-án.” <verse eid="MAT 15:27" /><verse number="28" style="v" sid="MAT 15:28" />Dyơ ngki, dŏq ôi liêh, Yang Yê-su tông ada án: “Ơ ti-cuôi cán ngki, callong náp na ơi pưt lư. Ar-náq cóq cơt ada ơi veng a-rớq ơi ính.” Dyơ a-cái cán na mái têq pa-lai bánh te ngki táp.<verse eid="MAT 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Ndóng ngốh te ntúq ngki, Yang Yê-su pôq tu-mán dơq Ca-li-lê, a-lứng sớr tớq mui mpiên cóh dyơ, Án ti-cu tớq ngki. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Dyơ máh ti-cuôi clứng tớq nga Án, bôn máh ti-cuôi dyuat, ti-cuôi sot, ti-cuôi tar-liaih, ti-cuôi lúng, ngki clứng ti-cuôi can-nŏ́h mu nơi a-lớng nha-án. Ngai dŏq máh ti-cuôi ngki tar-mán dyưng Án dyơ Án pa-lai bánh dyôn nha-án, <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />tar-lúh, máh ti-cuôi sáng dut tư hôm ti-cuôi lúng têq ta-cang, ti-cuôi tar-liaih cơt ŏ liêh, ti-cuôi dyuat hôi pu-pôq a-lứng ti-cuôi sot bôn hôm liêh, dyơ nha-án cứh ayô Yang Arbang Pilŏ́ng na Isa-ra-el.<verse eid="MAT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Hoi ngki, tư dyơ arô top ndon rian án sa, Yang Yê-su tông: “Cư sáng srui-táq ada máh ti-cuôi clứng, co nha-án khoiq át níc a-lớng cư pe i-ngái dyơ ma ớq bôn a-mớh ính cha. Cư lớiq ính dyôn nha-án chô pallúng pi-nhaih, dáh lơ nha-án ngớt tớq car-na.” <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />Top ndon rian ôi liêh Án: “Tớq ntúq ớq nnáu át ngki te mmo bôn a-ưi beng a-rớq ngki dŏq top he dyôn máh ti-cuôi clứng ndô cha sái?” <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />Yang Yê-su plốh nha-án: “I-nha bôn nsếq lám beng?” Dyơ nha-án ôi: “Tu-pul lám, a-lứng nsếq lám buaiq két.” <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />Dyơ yua táp máh ti-cuôi clứng ti-cu tớq cu-teq, <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Án kéu tu-pul lám beng a-lứng nsếq lám buaiq, nha vít dyơ si-ơn, Án péq a-vôi dyôn top ndon rian, dyơ top ndon rian dyôn ada ti-cuôi clứng. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Máh ti-cuôi clứng ngki cha cơt sái tháng. Nha-án pa-chúng tu-pul ca-riê pớnh ndon yôl liêh máh ntiê. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Ngki, máh ti-cuôi cha la puan ngin náq ngai ng-conh, i-yốh ngiaih ngai ng-cán nha ngai a-cái. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Dyơ ngki dyôn máh ti-cuôi clứng chô, Án sớr tớq tuôc dyơ pôq nga vel Ma-ca-dan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Tư dyơ tớq tu-mán, máh ti-cuôi Pha-ra-si a-lớng Sa-du-sê — ính chim Án — seq te Án a-páh dyôn nha-án mui tíc si-leh te pilŏ́ng. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Ma dŏq ôi liêh, Án tông ada nha-án: [“Dyơ tớq i-bư, top i-nha tông: ‘Arbang ŏ, co pilŏ́ng cu-sáu.’ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Ang i-láih ndô: ‘Arbang cơt ính bo, co pilŏ́ng cu-sáu, sưm tu-rưm.’ Tam i-nha chom a-cớl Arbang Pilŏ́ng, ma lớiq chom te máh tíc tớq pang ndô.”] <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />“Mui tŏ́ng toiq lớiq ŏ a-lứng táq ar-náq saq si-suô tíc si-leh, ma tíc ngki lớiq têq dyôn ada nha-án, nưm tíc si-leh na Yô-na.” Dyơ táh nha-án tớq ngki, Án pôq vít.<verse eid="MAT 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Ma top ndon rian khoiq clớiq dông beng, dyơ tư tớq pa dyang a-tŏ́h. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Dyơ ngki, Yang Yê-su tông ada nha-án: “Cóq me a-ŏ a-lớng mmứng te bôt pôih na máh ti-cuôi Pha-ra-si a-lứng Sa-du-sê.” <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />Ma, nha-án át tar-miên a-lớng tar-tuôq idô: “Ngki co te top he khoiq lớiq dông beng.” <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />Ma dyơ chom ar-náq ngki, Yang Yê-su tông: “Máh ti-cuôi biq callong tin ntíh, i-mo i-nha tar-miên a-lớng tar-tuôq ngki co te i-nha ớq bôn beng? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />I-nha yôl i-yốh a-púh a-lứng lớiq ayư sông lám beng dyôn sông ngin ti-cuôi dyơ i-nha khoiq pa-chúng bôn liêh nsếq ca-riê? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Lớiq la tu-pul lám beng dyôn puan ngin ti-cuôi, dyơ i-nha khoiq pa-chúng bôn liêh nsếq ca-riê? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Co i-mo ma i-nha lớiq a-púh sa cư khoiq lớiq tông a-mớh ada i-nha te beng? Ma cóq mmứng te bôt pôih na máh ti-cuôi Pha-ra-si a-lứng Sa-du-sê.” <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Chón ngki nha-án a-púh ar-lớih Án lớiq yua nha-án cóq mmứng te bôt pôih táq beng, ma lư la par-nai ca to na máh ti-cuôi Pha-ra-si a-lứng Sa-du-sê.<verse eid="MAT 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Dyơ ngki, ndóng tớq tu-mán vel Sê-sa-rê Phi-lip, Yang Yê-su plốh top ndon rian án, idô: “Ngai tông A-cái Yang Cơt Ti-cuôi la nnáu?” <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />Dyơ nha-án ôi: “Bôn ti-cuôi tông Yon táq tíc na dơq; bôn án tông Ê-li; ma bôn ti-cuôi can-nŏ́h tông Yê-rê-mi lớiq la mu náq te máh top tang ng-cang.” <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />Án plốh nha-án: “Ma i-nha tông cư la nnáu?” <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />Iki, ndóng ính ôi liêh, Si-môn Phi-er tông: “Thới la Yang Choi Ta-mống, A-cái Yang Arbang Pilŏ́ng tu-mống níc.” <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />Dyơ ngki, ndóng ôi liêh, Yang Yê-su tông ada án: “Si-môn, a-cái Yô-na, mái bôn bún lư, co tới sáiq a-lứng a-ham khoiq a-páh ada mái, ma la A-ám na cư tớq pilŏ́ng. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Ma cư khoiq tông ada mái dyơ mái la Phi-er, a-lứng mpiên cúc búl ndô, cư a-yứng top tin na cư, a-lớng máh ngáh ntúq na ti-cuôi cóq tớq lư lớiq têq rap top ngki. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Cư mŏp ada mái máh tar-néc na cruông tớq pilŏ́ng, khán nốh a-mớh mái chóq tớq cu-teq ngki lư bôn chóq tớq pilŏ́ng, a-lứng khán nốh a-mớh mái lếh tớq cu-teq ngki lư bôn lếh tớq pilŏ́ng.” <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Dyơ, Án dyŏq top ndon rian dŏq nha-án êq taq-ntêr ada ngai chom Án la Yang Choi Ta-mống.<verse eid="MAT 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Tư i-ngái ngki, Yang Choi Ta-mống Yê-su ta-bớq dyôn top ndon rian na án chom ar-lớih Án cóq pôq nga Yaru-salem, dŏq chiuq a-ưi nốh diêiq a-rức tớq te top ti-cuôi sút tớq sớu, máh ti-cuôi teng rit sang a-lớng máh ti-cuôi sái rit, dyơ ngai ca-chet ma bôn tu-mống liêh tớq i-ngái pe. <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />A-lứng tư lúq Án nga mu pa, Phi-er ta-bớq tông Án, idô: “Thới ơi, Yang Arbang Pilŏ́ng bôn callong a-moih ada thới. Ar-náq ngki lư lớiq bôn cơt dyôn thới.” <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />Dyơ pi-líh me, Án tông ada Phi-er: “Yang sáq ntíh, cóq pôq át pa cróng Cư! Mái la cúc búl táq ki-dúh dyưng dyôn cư, co mái lớiq par-ngíh nga máh ar-náq na Yang Arbang Pilŏ́ng, ma par-ngíh máh ar-náq na ti-cuôi can-nŏ́h.” <verse eid="MAT 16:23" /><verse number="24" style="v" sid="MAT 16:24" />Vít ngki, Yang Yê-su tông ada top ndon rian na Án: “Khán nnáu ính veng ta-pun cư, ti-cuôi ngki cóq táh ngê án bôm, a-lứng dual a-long calláng na án dyơ veng cư. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Co khán nnáu ính choi pang tu-mống án ngki lư pít pang tu-mống án, ma ti-cuôi mmo pít pang tu-mống án co te cư ngki lư yôl pang tu-mống án. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Co mu náq ti-cuôi ngki bôn tar-náp a-mớh khán bôn díh cruông cu-teq, ma cơt pít tar-ngứh án? Lớiq la mu náq ti-cuôi lư dyôn nốh a-mớh te ar-náq piên liêh tar-ngứh án? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Co A-cái Yang Cơt Ti-cuôi ính tớq te ang ưr na A-ám Án mu nơi a-lứng top tar-neng Án. Dyơ piaiq chón ngki, Án lư cu-liêh dyôn cứp náq veng liêh máh ar-náq na nha-án. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Ar-lớih lư, cư tông ada i-nha i-mo bôn máh ti-cuôi át ta-yứng ndô, la máh ti-cuôi lư ar-lớih ngki i-yốh bôn hôm callong cu-chet ti-ngôi ali mmo nha-án hôm A-cái Yang Cơt Ti-cuôi tớq te cruông ang ưr Án.”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Tu-pát i-ngái ta-tun, Yang Yê-su dông Phi-er, a-lứng Ya-cơ nha Yon, a-em án, dyơ Án dông nưm nha-án mu nơi sớr nga plô cóh a-yống. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Te tiêh na Án cơt rớp ndái chứng mát nha-án, a-lứng mát Án claq a-rớq mát pan-dang, au Án cơt clŏq a-rớq ang. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />A-lứng me ntíh, Môi-se nha Ê-li mpáh chứng mát nha-án, taq-ntêr a-lớng Án. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Dyơ ngki, ndóng pốh tông, Phi-er tông ada Yang Yê-su: “Thới ơi, ar-lớih lư ŏ dyôn top he dŏq át tớq ndô. Khán thới ính, cư lư táq ntúq ndô pe lám pa-nu — mui dyôn thới, mui dyôn Môi-se a-lớng mui dyôn Ê-li.” <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" />Chón ndóng án yôl taq-ntêr, ngki me ntíh tớq tu-lúc clŏq ca-dứp nha-án, a-lứng me ndô, bôn siêng tu-bau tông tớq te tu-lúc, idô: “Ndô la A-cái a-moih lư na Cư, ndon Cư sáng bui can-nính te Án. Cóq i-nha cam-máng A-cái ngki.” <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />Ndóng bôn sáng iki, máh ndon rian dứm pi-rop mát co sáng a-dáh lư. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Dyơ Yang Yê-su, pôq tu-mán a-lứng ca-pơiq nga nha-án, dŏq tông: “Áu ta-yứng nha êq a-dáh.” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Ma ndóng ti-ngưi mát án a-sớr, nha-án ớq hôm nnáu nưm mui náq Yang Yê-su.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Chón ndóng nha-án te mpiên cóh mbơiq siar, Yang Yê-su tông pa-táp ada nha-án, idô: “Êq taq-ntêr te ar-náq khoiq hôm a-lứng nnáu ti-ngôi ndóng A-cái Yang Cơt Ti-cuôi khoiq te cu-chet tu-mống liêh.” <verse eid="MAT 17:9" /><verse number="10" style="v" sid="MAT 17:10" />Top ndon rian ngki plốh Án, idô: “Ma i-mo máh ti-cuôi sái rit tông la Ê-li cóq tớq nsuôi?” <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />Dyơ, ndóng ôi liêh, Án tông: “Ntro Ê-li cóq tớq a-lớng lư páng cra cứp ar-náq. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Ma cư tông ada i-nha i-mo Ê-li khoiq tớq dyơ, a-lứng nha-án lớiq a-cớl án. Ma lư, nha-án táq cứp nốh nha-án ính ada án. Ngki mu chứng iki, A-cái Yang Cơt Ti-cuôi tar-mán cóq chiuq a-rức co nha-án.” <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Ndóng ngki, top ndon rian a-púh i-mo Án tông ada nha-án te Yon táq tíc na dơq.<verse eid="MAT 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Ndóng tớq nga máh clứng ti-cuôi, mu náq ngai ng-conh tớq tu-mán Án, chóh tar-col chứng mát Án <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />dyơ tông: “Thới ơi, seq srui-táq a-cái conh cư, co án a-ái yúh ki-song a-lứng ráh a-riaq lư, ngki án báq dứm tớq uih, nha báq a-tôh tớq dơq. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Cư khoiq dông án tớq top ndon rian na Thới, ma nha-án lớiq rap pa-lai bánh dyôn án.” <verse eid="MAT 17:16" /><verse number="17" style="v" sid="MAT 17:17" />Dyơ ngki, ndóng ôi liêh, Yang Yê-su tông: “Ơ máh pang lớiq náp a-lứng lới lư ntíh, cư cóq át a-lớng top i-nha dyôn díh ali mmo? Chiuq ta-nhir i-nha dyôn díh máh mmo? Áu dông a-cái ngki tớq tu-dô nga cư.” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Yang Yê-su pi-ốh yang sáq, dyơ án ngốh táp te ngai a-cái, dyơ a-cái ngki têq cơt bánh chón ndóng ngki.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Vít ngki, ndóng tớq tar-múh nưm a-lớng Yang Yê-su, top ndon rian plốh: “Co i-mo top he lớiq rap chuih yang sáq ngki ngốh?” <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />Dyơ Án tông ada nha-án: “Co callong tin biq lư na i-nha. Ngki lư ar-lớih, cư tông ada i-nha, khán i-nha bôn callong tin ali mui callong a-pi, i-nha lư yua ada cóh ndô: ‘Cóq tôi te ntúq ndô nga ntúq can-nŏ́h,’ dyơ cóh ngki lư tôi, a-lứng lư ớq bôn a-mớh la lớiq têq ada top i-nha.” <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />[Ma ndon yang sáq ndô lớiq têq chuih a-ngốh khán ớq na callong cớu seq a-lứng ót tan-na.]<verse eid="MAT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Dyơ ngki, chón ndóng nha-án rum mu nơi tớq Ca-li-lê, Yang Yê-su tông ada nha-án: “A-cái Yang Cơt Ti-cuôi tar-mán ính mŏp ada ati ti-cuôi sút, <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />dyơ nha-án ca-chet Án táp, dyơ tớq i-ngái pe, Án lư bôn tu-mống liêh.” Top ndon rian cơt sáng a-nguaq lư.<verse eid="MAT 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Ndóng ngki, tư nha-án pôq nga vel Ca-bê-na-um, máh ti-cuôi ial práq thêq dyôn dúng sang tớq nga Phi-er dyơ plốh: “Thới na mái lớiq dyôn práq thêq dúng sang?” <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />Án ôi: “Bôn.” Dyơ ndóng mot tớq dúng dyơ, Yang Yê-su tông ada án nsuôi, idô: “Si-môn, mái par-ngíh i-mo? Máh puô tớq pang ndô ial práq lớiq la thêq te nnáu? Te a-cái a-con nha-án lớiq la te ti-cuôi can-nŏ́h?” <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />Dyơ ndóng ôi: “Te ti-cuôi can-nŏ́h”, Yang Yê-su tông ada án: “Iki a-cái a-con ngki êq ial. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Ma khán top he lớiq ính táq lớiq êm ada nha-án, ngki mái pôq nga dơq clóng, mái a-báih buaiq dyơ chuôt buaiq ndon nsuôi lư. Mái caq ng-cang án ngki, mái hôm mui callong práq. Ial práq ngki dyơ, mái dyôn ada nha-án cứp phê na cư nha mái.”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Chón ndóng ngki, top ndon rian tớq nga Yang Yê-su, plốh: “Ma lư ngki nnáu la pưt ta-niêng tháng tớq cruông tớq pilŏ́ng?” <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />Dyơ arô táp mu náq ngai a-cái tớq nga án, Án dŏq a-cái ngki át pan-di nha-án <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />a-lứng tông: “Ar-lớih lư, cư tông ada i-nha, khán i-nha lớiq piên lêq dyơ cơt a-rớq máh ngai a-cái, lư ar-lớih i-nha lư ớq bôn mot tớq cruông tớq pilŏ́ng. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Iki, khán ti-cuôi mmo a-siar cháq át ta-dưp a-rớq ngai a-cái ndô, ti-cuôi ngki la pưt ta-niêng tớq cruông tớq pilŏ́ng. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Khán nnáu arô nốh cư ráp chom mu náq ngai a-cái a-rớq ndô, ti-cuôi ngki ráp chom cư. <verse eid="MAT 18:5" /><verse number="6" style="v" sid="MAT 18:6" />Ma ti-cuôi mmo táq luaih ada mu náq te máh ngai a-cái két ndô, ngki máh ti-cuôi tin te cư, the ŏ lư ta-coi dyôn ti-cuôi ngki la mui allám tu-pál a-rớq a-séh ta-coi pa-niar ti-cong án, dyơ án cơt trim tớq pưn dơq sru.<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />Bap lư dyôn ti-cuôi pang ndô co te máh nốh ndon tar-dông táq luaih! Co te máh nốh ndon tar-dông táq luaih cóq tớq la callong lớiq têq viar, ma, bap lư dyôn ti-cuôi ndon tar-dông táq luaih tớq nga ti-cuôi can-nŏ́h! <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Ma, khán ati lớiq la a-dyưng i-nha tar-dông i-nha táq luaih, cóq cŏ́h viang ati a-dyưng ngki a-lớng a-dúh yông te i-nha. Ngki la ar-náq ŏ dyôn i-nha the a-cút ati lớiq la dyuat a-dyưng dyơ bôn mot tớq callong tu-mống a-láng ndóng yôl bar ati lớiq la bar a-dyưng ma ngai a-pŏ́ng nga uih chéh díh sút pang. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Khán mát i-nha tar-dông i-nha táq luaih, cóq cu-láiq mát ngki a-lớng a-dúh yông te i-nha. Ngki la ar-náq ŏ dyôn i-nha the yôl mui mát ma bôn mot tớq callong tu-mống, a-láng ndóng yôl bar mát ngki ma ngai a-pŏ́ng nga ntúq cu-chet. <verse eid="MAT 18:9" /><verse number="10" style="v" sid="MAT 18:10" />Cóq mmứng, i-nha êq ayê mu náq te máh ngai a-cái két ndô. Co cư tông ada i-nha i-mo top tar-neng na nha-án tớq pilŏ́ng ngki át bôn hôm mát A-ám cư tớq pilŏ́ng. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />[Co A-cái Yang Cơt Ti-cuôi tớq ính choi ta-mống ti-cuôi ndon clu car-na.] <verse eid="MAT 18:11" /><verse number="12" style="v" sid="MAT 18:12" />I-nha par-ngíh i-mo? Khán mu náq ti-cuôi ngki bôn mui cu-lám cưu, ma mui allám te cưu án cơt clu car-na, lư án táh ngki ti-kiaih chít ti-kiaih tớq cóh dyơ pôq, ti-cuôi ngki si-suô cưu ndon clu car-na? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Khán ti-cuôi ngki ma bôn tu-múh cưu án, lư ar-lớih, cư tông ada i-nha i-mo ti-cuôi ngki sáng bui hơr te cưu ngki ta-niêng te ti-kiaih chít ti-kiaih cưu ndon lớiq clu car-na. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Mu chứng iki, par-ngíh chứng mát A-ám tớq pilŏ́ng na i-nha lớiq ính nnáu te mu náq máh ngai a-cái két ndô cơt cu-chet pít.<verse eid="MAT 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />Ma, khán mu náq em ai na i-nha táq luaih ada i-nha, cóq pôq, cóq tar-múh án nưm i-nha a-lớng ti-cuôi ngki sớng. Khán ti-cuôi ngki cam-máng i-nha, i-nha bôn liêh em ai i-nha. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Ma khán ti-cuôi ngki lớiq cam-máng, cóq dông a-lớng i-nha mu náq lớiq la bar náq hơ, dŏq dyôn te ng-cang na bar náq lớiq la pe náq ti-cuôi ca-lư cứp par-nai têq bôn par-chen. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Ma khán ti-cuôi ngki lớiq cam-máng nha-án, cóq taq-ntêr dyôn top tin. Ma khán ti-cuôi ngki lư lớiq cam-máng top tin, ngki ada em ai i-nha, ti-cuôi ngki cóq me a-rớq la ti-cuôi can-nŏ́h a-lứng ti-cuôi ial práq thêq. <verse eid="MAT 18:17" /><verse number="18" style="v" sid="MAT 18:18" />Lư ar-lớih, cư tông ada i-nha, khán i-nha chóq nốh a-mớh tớq cu-teq, nốh ngki lư chóq tưi tớq pilŏ́ng; a-lứng khán i-nha lếh nốh a-mớh át tớq cu-teq, nốh ngki lư lếh tưi tớq pilŏ́ng. <verse eid="MAT 18:18" /><verse number="19" style="v" sid="MAT 18:19" />Mu chư sa, ar-lớih lư, cư tông ada i-nha i-mo khán bar náq te i-nha sŏ́ng mui mít tớq cu-teq te cứp nốh a-mớh ndon khán nha-án cớu seq, nốh ngki lư cơt ada nha-án co A-ám cư tớq pilŏ́ng. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Co ntúq mmo bôn bar lớiq la pe náq ti-cuôi át sŏ́ng mui mít te nốh cư, cư át ntúq ngki táp pan-di nha-án.”<verse eid="MAT 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Vít ngki, dyơ ndóng tớq tar-mán, Phi-er plốh táp Án: “Thới ơi, mu náq em ai cư lư táq luaih a-lứng cư nha cư lư táh luaih án nsếq chư? Díh tu-pul chư?” <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />Yang Yê-su tông ada án: “Cư lớiq tông ada mái nưm tu-pul chư, ma la díh tu-pul chít chư tu-pul. <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />Co te ar-náq ndô, cruông tớq pilŏ́ng têq mu chứng a-rớq mu náq ti-cuôi táq puô, ma ti-cuôi ngki ính plốh liêh práq te máh prái tar-ráih án. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Dyơ ngki, ndóng puô ta-bớq plốh práq, mu náq prái tar-ráih tu mu chít ngin nen dông a-tớq dyôn puô. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Ma ti-cuôi ngki lớiq bôn a-mớh ính cu-liêh, iki puô yua táp conh ngki cóq pôq táiq án, a-lứng cam-pái, a-cái a-lớng nhéq tưh cứp nốh án bôn, dyơ cu-liêh tu. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Iki dyơ chóh tar-col, conh ngki chóh chứng mát puô, tông: ‘Puô ơi, seq êq car-tál te cư, dyơ cư lư cu-liêh puô nhéq tưh.’ <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Dyơ ngki, co sáng srui-táq, ưlla na ti-cuôi sol ngki khoiq ta-láh a-lớng táh práq tu ada án. <verse eid="MAT 18:27" /><verse number="28" style="v" sid="MAT 18:28" />Ma tư ngốh tớq tiêh dyơ, prái ngki tu-múh mu náq te máh top prái mu chứng án, la ti-cuôi tu án mui cu-lám práq dơ-ni-ê, dyơ tư ntớp ti-cuôi ngki, án ngóq ti-cong, tông idô: ‘Mái tu a-mớh cu-liêh a-dứh.’ <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Dyơ, ndóng chóh tar-col, án ndon prái mu chứng án kho níc án, idô: ‘Seq êq car-tál i-yốh cư, dyơ cư lư cu-liêh tu mái.’ <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Ma án lớiq têq. Dyơ ngki, án dông ti-cuôi ngki, án dyôn ngai crál ti-cuôi ngki tớq cŏq tôt dyôn díh ali mmo án cu-liêh máh práq tu. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Iki, vít ndóng bôn hôm ar-náq khoiq cơt, máh ti-cuôi sol na án lư sáng a-ái mít. Ndóng dyơ tớq, nha-án taq-ntêr ada puô nha-án cứp ar-náq khoiq cơt. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Dyơ, vít ndóng yua sol ngki tớq, ưlla án tông ada án: ‘Mái la ti-cuôi lớiq ŏ lư, cư khoiq táh nhéq tu ngki dyôn mái co mái khoiq át kho cư. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Ar-náq ndon piaiq lư dyôn ada mái tới la cóq srui-táq ti-cuôi prái a-rớq mái, mu chứng a-rớq cư khoiq srui-táq mái?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Co táq dyôn sáng nháih, ưlla na án mŏp án dyôn ngai a-riaq dyôn díh ali mmo án cu-liêh nhéq cứp nốh yôl tu. <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" />A-ám tớq pilŏ́ng na cư la lư táq ada i-nha mu chứng iki tưi, khán cứp náq te i-nha lớiq táh luaih dyôn em ai na i-nha co ngốh te mít can-nính i-nha.”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Ar-náq ndon cơt la ndóng Yang Yê-su khoiq taq-ntêr nhéq máh par-nai ngki, Án ngốh te Ca-li-lê dyơ pôq nga cruông Yu-dê pa dyang a-tŏ́h dơq Yôr-dan. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Máh ti-cuôi clứng veng Án dyơ Án pa-lai bánh a-ái dyôn nha-án tớq ngki.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Máh ti-cuôi Pha-ra-si tớq nga Án, thứq Án dyơ plốh: “Bôn a-láng lớiq rit dyôn mu náq ti-cuôi conh táh cam-pái án co ớq bôn luaih a-mớh?” <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />Dyơ ính ôi, Án tông: “Top i-nha i-yốh dŏc i-mo Yang Arbang Pilŏ́ng teng cơt te tôm lư khoiq teng cơt nha-án, mu náq conh a-lứng mu náq cán, <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />dyơ tông: ‘Co te ngki, án ndon conh cóq yáh a-ám a-lứng a-i ma át mu nơi a-lớng cam-pái án, dyơ bar náq lư cơt mui sáiq’? <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Ti-ngôi, nha-án lớiq cơt nnáng bar, ma nưm mui sáiq. Co iki, callong ndon Yang Arbang Pilŏ́ng khoiq dŏq a-múh mu nơi, cứp náq ti-cuôi lớiq têq par-táh.” <verse eid="MAT 19:6" /><verse number="7" style="v" sid="MAT 19:7" />Nha-án tông ada Án: “Iki, co i-mo Môi-se khoiq pa-táp cóq a-vôi chớiq par-táh dyơ têq táh cam-pái pôq?” <verse eid="MAT 19:7" /><verse number="8" style="v" sid="MAT 19:8" />Án ôi nha-án idô: “Co callong cớng mít na top i-nha Môi-se khoiq tông dyôn top i-nha táh cam-pái bôm, ma te tôm lư, callong ngki tới lư a-rớq iki. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Ma cư tông ada i-nha idô nám co luaih láh par-lưi, ti-cuôi mmo táh cam-pái án dyơ ial cán can-nŏ́h ngki luaih láh par-lưi; án tar-píh cán ndon khoiq par-táh ngki luaih láh par-lưi.” <verse eid="MAT 19:9" /><verse number="10" style="v" sid="MAT 19:10" />Top ndon rian plốh táp Án: “Khán te ar-náq na án ndon conh mu nơi a-lớng cam-pái án la a-rớq iki, ngki the êq cơt dúng su.” <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />Ma Án tông ada nha-án: “Tới nhéq náq têq bôn ráp par-nai ndô, nưm la dyôn máh ti-cuôi ndon ar-náq ngki khoiq dŏq dyôn. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Co bôn máh ti-cuôi cơt iki, la máh ti-cuôi khoiq car-nian te hóng pallúng a-i khoiq iki; bôn máh ti-cuôi cơt iki co khoiq ngai dŏq lát; a-lứng bôn ti-cuôi cơt iki la máh ti-cuôi dŏq lát án bôm la co cruông tớq pilŏ́ng. Nnáu ráp ial par-nai ndô, ti-cuôi ngki cóq ráp ial.”<verse eid="MAT 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Ndóng ngki, máh ngai a-cái két bôn ngai dông nga Án ính Án ca-pơiq ati tớq cháq nha-án dŏq cớu seq, ma top ndon rian pi-ốh nha-án. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Dyơ ngki, Yang Yê-su tông: “Cóq dyôn máh ngai a-cái tớq nga cư, a-lứng êq ca-táng nha-án, co cruông tớq pilŏ́ng la na máh ti-cuôi a-rớq ngki.” <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Vít dyơ ca-pơiq ati tớq cháq ngai a-cái, Án ngốh pôq te ngki.<verse eid="MAT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />A-lứng me ngki, bôn mu náq conh tớq nga Án, plốh idô: “Thới ơi, cư cóq táq ar-náq ŏ a-mớh dŏq cư bôn callong tu-mống díh sút pang?” <verse eid="MAT 19:16" /><verse number="17" style="v" sid="MAT 19:17" />Dyơ Án tông ada conh ngki: “I-mo mái plốh cư te ar-náq ŏ? Nưm mui Yang Arbang Pilŏ́ng la ti-nớng ŏ, ma khán mái ính bôn te callong tu-mống, ngki cóq peh máh par-nai pa-táp.” <verse eid="MAT 19:17" /><verse number="18" style="v" sid="MAT 19:18" />Conh ngki plốh sa Án: “Máh par-nai pa-táp a-mớh?” Dyơ Yang Yê-su tông: “Êq ca-chet ti-cuôi, êq láh par-lưi, êq ti-tôiq, êq taq-ntêr a-uai, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />cóq dyám náp a-ám a-lứng a-i, a-lứng a-moih ti-cuôi át tar-mán na mái a-rớq cháq mái bôm.” <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />Conh la-lớu ngki ôi ada Án: “Cư khoiq peh nhéq dyơ máh par-nai ngki. Cư yôl clớiq callong a-mớh loi?” <verse eid="MAT 19:20" /><verse number="21" style="v" sid="MAT 19:21" />Yang Yê-su tông ada án: “Khán mái ính bôn cứp nốh, cóq pôq, cóq táiq máh mun mái bôn dyơ choi dyôn ti-cuôi ki-dit, iki mái lư bôn mun ngáih tớq pilŏ́ng; a-lứng veng ta-pun cư táp!” <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />Ma tư bôn sáng par-nai ngki dyơ, án ngốh te ngki sáng a-nguaq, co án bôn a-ưi crơng-crớu.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Hoi ngki, Yang Yê-su tông ada top ndon rian án: “Ar-lớih lư, cư tông ada i-nha idô: ti-cuôi súc ính mot tớq cruông tớq pilŏ́ng ngki diêiq lư. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Ma cư tông sa ada i-nha, dyôn pan-nán lac-da mot na hóng ta-rúm ngki iên hơn la te ti-cuôi súc mot tớq cruông na Yang Arbang Pilŏ́ng.” <verse eid="MAT 19:24" /><verse number="25" style="v" sid="MAT 19:25" />Dyơ, tư bôn sáng iki, top ndon rian sáng dut lư, plốh: “Khán iki nnáu têq bôn choi ta-mống?” <verse eid="MAT 19:25" /><verse number="26" style="v" sid="MAT 19:26" />Tiêu liêu me nha-án, Yang Yê-su tông ada nha-án: “Ada ti-cuôi, ar-náq ndô la lớiq têq, ma ada Yang Arbang Pilŏ́ng cứp ar-náq ngki têq nhéq.” <verse eid="MAT 19:26" /><verse number="27" style="v" sid="MAT 19:27" />Ndóng ngki, dŏq ôi liêh, Phi-er tông ada Án: “Thới me, top he khoiq táh nhéq cứp nốh dyơ veng thới. Khán iki lư bôn nốh a-mớh dyôn ada top he?” <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" />Dyơ Yang Yê-su tông ada nha-án: “Ar-lớih lư, cư tông ada i-nha, i-mo i-nha, la máh ti-cuôi veng ta-pun cư, tớq cúc cu-teq tam-me, ndóng A-cái Yang Cơt Ti-cuôi sút bôn ti-cu ntúq ang ưr án, i-nha lư bôn ti-cu tớq tar-cu mu chít la bar náq ti-cu, dŏq sưq liêh mu chít la bar náq top Isa-ra-el. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Cứp náq ti-cuôi, khán ti-cuôi mmo ma táh dúng su, em ai, em ơi, a-ám, a-i, cam-pái, a-cái, lớiq la cu-teq co veng ngê cư, lư ráp clưi mui cu-lám chư a-lứng bôn callong tu-mống díh sút pang. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Ma clứng ti-cuôi ndon lư pưt cơt két, a-lứng án ndon két cơt pưt.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />Co cruông tớq pilŏ́ng ngki a-rớq mu náq ti-cuôi ưlla cu-teq, dyơ án pôq te i-láih lư cláih suô ti-cuôi thu-the dyôn nương nho án. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Dyơ ngki, cua khoiq par-chen a-lứng máh ti-cuôi thu-the nưm mui práq dơ-ni-ê dyôn mui i-ngái, án yua nha-án mot tớq nương nho na án. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />Dyơ pôq chón ngki mát pan-dang tu-rống crêng, án tu-múh máh ti-cuôi át ta-yứng ớq a-mớh táq tớq ntúq ngai par-lới. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Án tông ada nha-án: ‘Top i-nha ngki mot tớq nương nho, a-lứng ar-náq mmo ndon crái piaiq, cư lư cu-liêh dyôn top i-nha.’ <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Iki, nha-án pôq. Tư dyơ pôq sa chón mát pan-dang tứng a-lứng pan-dang viêt, án la táq mu chứng iki. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Dyơ ngki, ndóng pôq chón mát pan-dang tang-cưl cóh, án tar-múh ti-cuôi can-nŏ́h át ta-yứng, dyơ án plốh nha-án: ‘I-mo top i-nha át ta-yứng sớng lớiq táq a-mớh i-ngái ndô?’ <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />Nha-án ôi ada án: ‘Co ớq nnáu pa-the top he.’ Án tông ada nha-án: ‘Top i-nha la cóq pôq mot tớq nương nho.’ <verse eid="MAT 20:7" /><verse number="8" style="v" sid="MAT 20:8" />Dyơ tớq i-bư, án ưlla nương nho yua tam-peng na án: ‘Áu arô máh ti-cuôi thu-the tớq a-lứng dyôn práq công ada nha-án, nsuôi lư te máh ti-cuôi ta-tun dyôn díh máh ti-cuôi nsuôi.’ <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Vít ndóng khoiq tớq, máh ti-cuôi bôn the ndóng mát pan-dang tang-cưl cóh, cứp náq ráp mui callong práq dơ-ni-ê. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Ma máh ti-cuôi thu-the te nsuôi, ndóng tớq, khoiq par-ngíh dyơ nha-án lư bôn a-ưi hơn, ma nha-án bôn nưm mui práq dơ-ni-ê cứp náq nha-án. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Ma cua dyơ khoiq ráp, nha-án tar-miên a-lứng án ưlla cu-teq, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />idô: ‘Máh ti-cuôi tớq táq ta-tun ngki nha-án táq mui yơ, ma ưlla dyôn nha-án li mu chứng a-rớq top he, la máh ti-cuôi khoiq chiuq diêiq a-rức nhéq i-ngái a-lứng chiuq tiêng puôq táq.’ <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />Ma ôi liêh, ưlla ngki tông ada mu náq te top nha-án: ‘Yớu ơi, cư lớiq bôn lop a-lớng top i-nha. Cŏm top i-nha khoiq sŏ́ng a-lứng cư mui práq dơ-ni-ê? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Áu ráp cống na i-nha dyơ chô. Ma cư ngki ính dyôn máh ti-cuôi ta-tun ndô la mu chứng a-rớq i-nha. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />A-láng lớiq bôn têq dyôn cư dŏq táq ar-náq cư ính te máh nốh na cư? A-láng mát mái sáng i-ôiq co cư bôn ar-náq ŏ?’ <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" />Mu chứng, ti-cuôi ta-tun lư cơt nsuôi a-lứng ti-cuôi nsuôi cơt ta-tun.”<verse eid="MAT 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Ndóng pôq nga vel Yaru-salem, Yang Yê-su dông nưm mu chít la bar náq ndon rian can-nŏ́h a-lứng án, chón ndóng na car-na, Án tông ada nha-án: <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“Me ndô, top he chón pôq nga Yaru-salem, ngki A-cái Yang Cơt Ti-cuôi lư ngai mŏp ada máh thới teng rit sang díh a-lớng máh thới sái rit, dyơ nha-án lư a-nát cóq ca-chet Án <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />a-lứng lư mŏp Án nga ti-cuôi tới ti-cuôi Isa-ra-el dŏq ayê tar-ac, ngai tính, dyơ téh Án tớq a-long calláng. Ma tớq i-ngái pe, Án yôr tu-mống liêh.”<verse eid="MAT 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Ndóng ngki, a-i na bar náq a-cái conh Sê-ba-dê mu nơi a-lứng máh a-cái án tớq tu-mán Án, chóh tar-col tár seq mui nốh te Án. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />Dyơ Án plốh cán ngki: “Mái ính nốh a-mớh?” Cán ngki ôi Án: “Seq dyôn bar náq a-cái conh ndô na cư, mu náq têq ti-cu pa a-tớm, a-lứng mu náq pa a-viar thới tớq cruông sút na thới.” <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />Ma dyơ ôi liêh, Yang Yê-su tông: “Pe náq i-nha lớiq chom i-nha chón seq callong a-mớh lớng. Bar náq i-nha rap lớiq ngoiq choc ndon cư chón ngoiq lớiq?” Nha-án ôi Án: “Top he rap.” <verse eid="MAT 20:22" /><verse number="23" style="v" sid="MAT 20:23" />Án tông ada nha-án: “U-rớh i-nha lư ngoiq choc na cư, ma ính ti-cu pa a-tớm a-lứng pa a-viar na cư tới la ar-náq cư a-nát, ma co dyôn máh ti-cuôi ndon khoiq dŏq ti-ráp co A-ám.” <verse eid="MAT 20:23" /><verse number="24" style="v" sid="MAT 20:24" />Tư dyơ sáng iki, mu chít náq ndon rian uan lư ada bar náq em ai ngki. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Ma ndóng arô nha-án tớq nga i-nha, Yang Yê-su tông: “I-nha chom dyơ máh ti-cuôi sút pưt na ti-cuôi tới ti-cuôi Isa-ra-el ngki tông táq i-nha, a-lứng máh ti-cuôi bôn chức sút pưt ial chức ngki pa-dớm máh ti-cuôi prái. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Tớq i-nha ngki êq táq iki. Ma lư tớq ngki, khán nnáu ính cơt pưt tớq top i-nha, ti-cuôi ngki lư cơt ti-cuôi prái tar-ráih na i-nha, <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />a-lứng ti-cuôi mmo ính cơt sút tớq i-nha ngki cóq cơt sol na i-nha, <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />mu chứng a-rớq A-cái Yang Cơt Ti-cuôi khoiq lớiq tớq dŏq dyôn ngai hớu, ma tớq la dŏq hớu ngai, a-lứng dŏq ial tar-ngứh án chiuq cu-chet tang dyôn nhéq tưh ti-cuôi.”<verse eid="MAT 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Dyơ ndóng nha-án te vel Yê-ri-cô ngốh ngki, bôn top ti-cuôi clứng veng ta-pun Án. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />A-lứng me ntíh, bar náq ti-cuôi sot át ti-cu tớq tor car-na. Tư bôn sáng ngki Yang Yê-su chón pôq pha, nha-án tu-bau yứng, idô: “Thới ơi, A-cái puô Da-vit, seq srui-táq top he.” <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />Ma ti-cuôi clứng pi-ốh nha-án bar náq, dyŏq nha-án êq ta-cang, ma nha-án a-cán tu-bau yứng lư loi, idô: “Thới ơi, A-cái puô Da-vit, seq srui-táq top he.” <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />Ndóng dyơ trín liêh, Yang Yê-su arô nha-án tớq a-lứng plốh: “Top i-nha ính cư táq a-mớh dyôn top i-nha?” <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />Nha-án ôi Án: “Thới ơi, ngki lư seq dyôn mát top he cơt plang.” <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />Dyơ ngki, co sáng srui-táq, Yang Yê-su ca-pơiq tớq mát nha-án. Ndóng ngki táp, nha-án ŏ liêh mát dyơ veng ta-pun Án.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Ndóng nha-án tu-mán tớq vel Yaru-salem, dyơ pôq nga Bê-pha-yê, a-nga Cóh Ô-li-vê, chón ngki Yang Yê-su yua bar náq ndon rian, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />yua nha-án: “Pôq mot tớq vel chứng mát i-nha, dyơ i-nha lư hôm táp mui allám a-séh cán khoiq dŏq chóq, a-lứng a-séh a-cái mu nơi a-lớng i-cán. Dyơ cua lếh ntár, ngki dông a-chô ada cư. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />A-lứng khán bôn nnáu plốh a-mớh i-nha, i-nha taq-ntêr idô: ‘Thới ính manh a-séh,’ dyơ ti-cuôi ngki lư chái lư dyôn a-séh ngki táp.” <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />Ma, ar-náq ndô cơt dŏq par-nai khoiq dŏq tông na mu náq tang ng-cang dyôn têq tar-vớiq, idô:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />“Cóq yua ada a-cái cán na Si-môn:</para>
  <para style="q1" vid="MAT 21:5">‘Me ntíh, Puô i-nha tớq nga i-nha,</para>
  <para style="q1" vid="MAT 21:5">a-siar cháq a-lứng diq a-séh a-êp</para>
  <para style="q1" vid="MAT 21:5">— ar-lớih lư tớq mpiên a-séh a-êp a-cái, a-cái na a-séh a-êp i-cán.’”<verse eid="MAT 21:5" /></para>
  <para style="b" />
  <para style="m">
    <verse number="6" style="v" sid="MAT 21:6" />Dyơ ngki, top ndon rian, tư dyơ pôq a-lứng táq a-rớq Yang Yê-su khoiq dŏq ca to nha-án, <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />khoiq dông a-séh i-cán a-lớng a-séh a-cái ngki, a-lứng lêp au clŏq na nha-án tớq a-séh, dyơ Án ti-cu tớq ngki. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Dyơ ngki, cứp náq ti-cuôi lêp au clŏq na nha-án tớq car-na, ma bôn ti-cuôi ngki pớiq máh a-beng a-long nha lêp tớq car-na. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Vít ngki, máh ti-cuôi clứng pôq nsuôi Án dyơ veng ta-tun sŏ́ng crau, idô:</para>
  <para style="q1" vid="MAT 21:9">“Hô-sa-na A-cái puô Da-vit!</para>
  <para style="q1" vid="MAT 21:9">Lư ayô Án tớq te nốh Yang!</para>
  <para style="q1" vid="MAT 21:9">Hô-sa-na tớq ntúq sút pưt!”<verse eid="MAT 21:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="MAT 21:10" />Ndóng Án mot tớq vel Yaru-salem, cứp vel par-chớu, tar-plốh: “Ngki la nnáu?” <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />Dyơ máh ti-cuôi clứng ôi: “Ngki la tang ng-cang Yê-su, te Na-sa-ret, vúng Ca-li-lê.”<verse eid="MAT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Yang Yê-su mot tớq dúng sang, dyơ Án chuih nhéq máh ti-cuôi plới táiq tớq dúng sang, nha cu-rứp ki-chơng na top piên práq a-lớng tar-cu na top táiq ca-cu. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Án tông ada nha-án: “Par-nai khoiq dŏq ta-ran: ‘Dúng Cư ngai dŏq la dúng cớu seq,’ ma top i-nha khoiq táq dúng ndô cơt hóng dyôn si-veng mot ti-tôiq.” <verse eid="MAT 21:13" /><verse number="14" style="v" sid="MAT 21:14" />Dyơ máh ti-cuôi sot a-lứng ti-cuôi dyuat tớq tu-mán Án tớq dúng sang, nha Án pa-lai bánh dyôn nha-án. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Ma máh ti-cuôi teng rit sang a-lớng top ti-cuôi sái rit, dyơ hôm máh ar-náq si-leh ndon Án khoiq táq, a-lứng top ngai a-cái crau-criau tớq dúng sang, idô: “Hô-sa-na A-cái puô Da-vit,” nha-án sáng nháih lư. <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Nha-án plốh a-lứng Án: “Thới bôn sáng ngai a-cái crau-criau a-mớh lớiq?” Ma Yang Yê-su ôi nha-án: “Sáng! Top i-nha i-yốh cơi dŏc idô: ‘Yang khoiq thuan dŏq callong cứh ayô te ng-cang na máh ngai a-cái a-lớng ngai a-cái chón uq?’” <verse eid="MAT 21:16" /><verse number="17" style="v" sid="MAT 21:17" />Dyơ táh nha-án, Án ngốh te vel pôq nga Bê-tha-ni a-lứng a-ngô mui i-dáu tớq ngki.<verse eid="MAT 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Tớq ang i-láih, chón ndóng mot liêh nga vel, Án pi-nhaih. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Tư dyơ bôn hôm mui tôm a-long ta-rúng tớq tor car-na, Án pôq nga a-long ngki dyơ hôm ớq bôn a-mớh tớq a-long nưm ula sớng. Án tông ada a-long ngki: “Cu-lái ớq bôn te mái nnáng ti-ngôi sút pang,” chón ngki táp, a-long ta-rúng ngki cơt ráng. <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />Hôm a-rớq iki dyơ, top ndon rian sáng dut lư, tông: “Ngki i-mo a-long ta-rúng cơt chái lư ráng?” <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />Dyơ tư ính ôi liêh, Yang Yê-su tông ada nha-án: “Ar-lớih lư, cư tông ada i-nha, nám i-nha bôn callong tin a-lứng lớiq ma-mu, i-nha lư têq táq tới nưm ar-náq ndô dyôn a-long ta-rúng, ma díh nám i-nha tông ada cóh ndô: ‘Áu rưc bôm dyơ a-pŏ́ng nga dơq ving ca-vang,’ ar-náq ngki lư cơt. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Cứp nốh, ntro máh nốh a-mớh i-nha seq te par-nai cớu, i-nha bôn ráp khán náp peh.”<verse eid="MAT 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />A-lứng ndóng Án mot tớq dúng sang dyơ, máh ti-cuôi teng rit sang a-lớng máh ti-cuôi sút te top nha-án khoiq tớq tar-múh Án chón ndóng Án ca to, ngki plốh: “Co chức sút te mmo thới táq máh ar-náq ndô, nha nnáu dyôn ada thới chức sút ngki?” <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />Ma dŏq ính ôi liêh, Yang Yê-su tông ada nha-án: “Cư lư seq plốh top i-nha mui callong, ma khán top i-nha têq ôi liêh cư, cư lư taq-ntêr dyôn top i-nha chom cư chón táq máh ar-náq ndô co chức sút mmo. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Rit tíc na dơq na Yon — rit ngki la tôm lư? Te pilŏ́ng a-láng te tưh ti-cuôi?” Dyơ ngki, nha-án tar-miên tar-tuôq nha-án, idô: “Khán top he tông: ‘Te pilŏ́ng,’ án tông lư ada top he: ‘Iki ma co i-mo top i-nha lớiq tin án?’ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Ma khán top he tông: ‘Te tưh ti-cuôi,’ top he a-dáh ti-cuôi prái, co nhéq náq nha-án tông Yon la mu náq tang ng-cang.” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Iki dyơ ôi liêh Yang Yê-su, nha-án tông: “Top he lớiq chom.” Án ôi liêh nha-án: “Cư la lớiq dyôn top i-nha chom cư táq máh ar-náq ndô co chức sút mmo. <verse eid="MAT 21:27" /><verse number="28" style="v" sid="MAT 21:28" />Ma, top i-nha par-ngíh i-mo? Mu náq ti-cuôi bôn bar lám a-cái conh, dyơ a-ám án tớq nga án ndon ai, án tông: ‘A-cái ơi, i-ngái ndô a-cái cóq pôq táq ar-náq tớq ro nho.’ <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Ma ndóng ôi liêh, án tông: ‘Cư lớiq ính,’ ma vít ngki, án par-ngíh liêh, án pôq. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Dyơ pôq tar-múh ndon a-em loi, a-ám án tông mu chứng iki. Dyơ, ndóng ôi liêh, án tông: ‘Ơq, a-ám ơi,’ ma án lớiq pôq. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />Nnáu te bar náq a-cái conh ngki táq veng can-nính na a-ám nha-án?” Nha-án ôi: “Án ndon ai.” Yang Yê-su tông ada nha-án: “Ar-lớih lư, cư tông top i-nha i-mo máh ti-cuôi tu-the a-lớng cán táiq cháq bôn mot tớq cruông na Yang Arbang Pilŏ́ng nsuôi top i-nha. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Co Yon khoiq tớq nga top i-nha na car-na ti-nớng ŏ, ma top i-nha lớiq náp án. Ma máh ti-cuôi tu-the a-lớng máh cán táiq cháq ngki náp án. Ma top i-nha, ntro bôn hôm dyơ, khoiq lớiq ngin luaih vít ngki náq náp án.<verse eid="MAT 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Cóq cam-máng mui par-nai a-cám can-nŏ́h. Bôn mu náq ti-cuôi ưlla cu-teq, la ti-cuôi dŏq chóh mui nương nho, crong car-rong pa-niar nương ngki, píq prúng cal-tiat nho tớq ngki, ta-bôt búl cu-viêl prúng a-lứng dyôn top chóh nho táq dơq nương ngki, dyơ án pôq nga cruông can-nŏ́h. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Dyơ ngki, tớq ndóng ki-sái nho dom tar-mán tớq, án yua máh ti-cuôi sol án pôq a-lớng top chóh nho dŏq ial phê cu-lái na án. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Ma top chóh nho cŏp máh ti-cuôi sol na ưlla ngki, top chóh nho tính án ndô, ca-chet án ntíh, tíq búl án ntŏ́h. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Án ưlla nho yua liêh máh ti-cuôi sol can-nŏ́h loi tớq, clứng ta-niêng top nsuôi, ma top chóh nho ngki táq nha-án mu chứng iki. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Dyơ talloiq lư, án yua lư a-cái conh án tớq nga nha-án, idô: ‘Nha-án lư dyám náp a-cái conh án.’ <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Ma top chóh nho, tư bôn hôm a-cái conh ngki, dyơ tang-húng tar-tuôq nha-án: ‘Ndô la án cơt ưlla ta-tun. Áu, top he cóq ca-chet án dyơ bôn máh mun na án.’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Ndóng cŏp a-cái ngki, nha-án a-dúh án nga tiêh nương nho dyơ ca-chet. <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />Iki, ndóng án ưlla nương nho tớq, án lư táq i-mo ada top chóh nho ngki?” <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />Nha-án ôi ada Án: “Ưlla lư ca-chet viang top ti-cuôi lớiq ŏ ntíh ma lớiq sáng a-moih, dyơ lư dyôn máh ti-cuôi chóh nho can-nŏ́h táq manh ro, la máh ti-cuôi ngki lư mpô liêh ada án phê cu-lái tớq tư nho dom na nha-án.” <verse eid="MAT 21:41" /><verse number="42" style="v" sid="MAT 21:42" />Yang Yê-su tông ada nha-án: “Top i-nha i-yốh dŏc tớq Tám U-ráq Yang Arbang Pilŏ́ng:</para>
  <para style="q1" vid="MAT 21:42">‘Cúc búl ndon máh ti-cuôi táq dúng khoiq a-dúh,</para>
  <para style="q1" vid="MAT 21:42">búl ngki khoiq cơt búl lác tớq tol dúng.</para>
  <para style="q1" vid="MAT 21:42">Ar-náq ndô cơt tớq te Yang,</para>
  <para style="q1" vid="MAT 21:42">a-lứng ngki la ar-náq ŏ lư tớq mát top he?’<verse eid="MAT 21:42" /></para>
  <para style="b" />
  <para style="m">
    <verse number="43" style="v" sid="MAT 21:43" />Co te ar-náq ndô, cư tông ada i-nha i-mo cruông na Yang Arbang Pilŏ́ng lư ial viang te top i-nha dyơ mŏp ada ti-cuôi can-nŏ́h loi táq dyôn cu-lái na cruông ngki. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Nnáu a-tôh crái tớq búl ndô lư prớm lớng, ma cúc búl a-tôh tớq ti-cuôi mmo, búl ngki ca-tát a-bếq ti-cuôi ngki.” <verse eid="MAT 21:44" /><verse number="45" style="v" sid="MAT 21:45" />Vít dyơ bôn sáng máh par-nai a-cám te Án, máh ti-cuôi teng rit sang a-lớng máh ti-cuôi Pha-ra-si chom ar-lớih Án tông te nha-án. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Dyơ suô ngê cŏp Án, nha-án a-dáh ti-cuôi clứng, co ti-cuôi clứng me Án la mu náq tang ng-cang.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />A-lứng ôi liêh, Yang Yê-su mu chư sa tông ada nha-án na par-nai a-cám, idô: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“Cruông tớq pilŏ́ng la a-rớq mu náq ti-cuôi ndon puô, ma puô ngki ti-ráp pêl ial cam-pái dyôn a-cái conh án. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Puô yua máh prái tar-ráih na án pôq cớiq máh ti-cuôi ndon khoiq mơi tớq cha ar-suôi, ma nha-án lớiq ính tớq. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Puô yua sa máh prái tar-ráih can-nŏ́h, idô: ‘Áu taq-ntêr ada máh ti-cuôi khoiq dŏq mơi: “Me ntíh, cư khoiq a-ngốh pêl ar-suôi na cư. Máh car-rŏ́q a-lứng pan-nán plứm na cư khoiq cua kiac, a-lớng cứp nốh khoiq ti-ráp dyơ. Áu tớq nga pêl cha ar-suôi.”’ <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Ma nha-án pôq viang co ớq sáng mmứng, ti-cuôi ndô pôq táq pi-dái án, ti-cuôi ntíh pôq táq ar-náq táiq plới na án. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Ma ti-cuôi ndon yôl liêh, vít dyơ cŏp máh ti-cuôi sol na puô, nha-án a-craiq nha ca-chet. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Iki, puô sáng uan lư, vít dyơ yua líng án pôq, án dyôn ca-chet viang top ti-cuôi ngki a-lứng chŏ́ng vel na nha-án. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Vít ngki, puô yua máh prái na án: ‘Lư pêl cha ar-suôi khoiq ti-ráp dŏq, ma máh ti-cuôi cơi át mơi ngki lư lớiq piaiq tớq cha. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Iki, i-nha pôq nga cứp máh par-yéh, dyơ khán top i-nha tu-múh ti-cuôi mmo thôi, ngki cóq mơi tớq cha pêl cha ar-suôi.’ <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />A-lứng máh prái tar-ráih ngki, tư pôq tớq máh car-na, par-chúng nhéq máh ti-cuôi ndon nha-án tu-múh, díh ti-cuôi lớiq ŏ nha ti-cuôi ŏ, dyơ tớq callúng pêl cha ar-suôi khoiq ki-tát máh tu-moi. <verse eid="MAT 22:10" /><verse number="11" style="v" sid="MAT 22:11" />Ma ndóng mot ính me máh tu-moi ti-cu cha, puô hôm mu náq ti-cuôi ngki lớiq sứp tam-pớc báq tớc cha ar-suôi. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Puô tông ti-cuôi ngki: ‘Yớu ơi, i-mo mái mot tu-dô ma lớiq sứp tam-pớc cha ar-suôi?’ Ma ti-cuôi ngki ớq chom ôi. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Dyơ ngki, puô yua máh prái tar-ráih: ‘I-nha chóq ati a-dyưng na ti-cuôi ndô liêh dyơ tu-yóng a-dúh án nga ntúq ngiau tu-ki, ntúq lư bôn callong nhiêm cu-cloiq a-lứng cal-tưat ki-neng.’ <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />Co clứng ti-cuôi dŏq arô, ma biq náq ti-cuôi dŏq rêh.”<verse eid="MAT 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Dyơ, ndóng pôq, máh ti-cuôi Pha-ra-si tang-húng si-suô ngê ính táq dŏq nha-án têq tu-múh luaih Án te par-nai taq-ntêr. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Nha-án yua máh dyưng ati nha-án, a-lứng máh ti-cuôi te top Hê-rôt, tớq nga Án, plốh: “Thới ơi, top he chom dyơ thới la ti-cuôi ti-nớng a-lứng ca to crái te Yang Arbang Pilŏ́ng na callong piaiq, nha ớq bôn callong lớiq li-arli tớq te thới ada cứp náq ti-cuôi, co thới lớiq me te cu-lai tiêh na ti-cuôi ngki. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Co iki, seq dyôn top he chom thới par-ngíh i-mo? Cóq dyôn práq ada Sê-sa a-láng lớiq?” <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />Ma co khoiq chom par-ngíh lớiq ŏ te nha-án, Yang Yê-su tông: “Máh ti-cuôi táq náh nnan ntíh, i-mo top i-nha thứq cư? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Áu dyôn cư me callong práq thêq ngki.” Nha-án dông ada Án mui callong práq dơ-ni-ê. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Án tông ada nha-án: “Ar-maiq a-lứng tar-ran ndô la na nnáu?” <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />Nha-án ôi: “Na Sê-sa.” Ndóng ngki, Án tông ada nha-án: “Khán iki, cóq cu-liêh dyôn Sê-sa nốh a-mớh na Sê-sa, nha dyôn Yang Arbang Pilŏ́ng nốh a-mớh na Yang Arbang Pilŏ́ng.” <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />Tư dyơ bôn sáng par-nai ngki, nha-án sáng dut lư, dyơ nha-án pôq, táh Án tớq ngki.<verse eid="MAT 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Tớq i-ngái ngki, máh ti-cuôi Sa-du-sê tớq tu-mán Án, co báq tông ớq bôn callong tu-mống liêh, iki nha-án plốh Án, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />idô: “Thới ơi, Môi-se tông: ‘Khán ti-cuôi mmo cu-chet ndóng ớq bôn a-cái, a-em conh ti-cuôi ngki a-tŏ́ng cam-pái na ai dyơ ca-nian a-cái dyôn ai na án.’ <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Ma tớq top he bôn tu-pul náq em ai conh, án ai pông, khoiq ial cam-pái, ngki khoiq cu-chet. Dyơ ai ngki táh cam-pái na ai dyôn a-em án, ndóng i-yốh bôn a-cái. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />A-em ndon bar dyơ án ndon pe, ti-ngôi díh án ndon tu-pul, mu chứng iki nhéq. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Dyơ talloiq lư tháng, cán ngki la cu-chet tưi. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Iki, tớq callong tu-mống liêh, ơi la cam-pái na nnáu te tu-pul náq em ai? Co nhéq náq nha-án khoiq ial ơi.” <verse eid="MAT 22:28" /><verse number="29" style="v" sid="MAT 22:29" />Ma ndóng ính ôi liêh, Yang Yê-su tông ada nha-án: “Top i-nha taq-ntêr lớiq crái dyơ, co lớiq chom Par-nai Yang nha chức sút na Yang Arbang Pilŏ́ng. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Co te callong tu-mống liêh, ngai lớiq ar-suôi a-lứng lớiq bôn tar-ial nnáng, ma nha-án cơt mu chứng a-rớq máh tar-neng tớq pilŏ́ng. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Ma te callong tu-mống liêh na ti-cuôi cu-chet, top i-nha i-yốh dŏc par-nai khoiq bôn Yang Arbang Pilŏ́ng tông ada i-nha, idô: <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘Cư la Yang Arbang Pilŏ́ng na A-pra-ham, Yang Arbang Pilŏ́ng na I-sac a-lứng Yang Arbang Pilŏ́ng na Ya-côp’? Yang Arbang Pilŏ́ng tới la na ti-cuôi cu-chet, ma lư na ti-cuôi tu-mống.” <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />Tư bôn sáng iki, máh ti-cuôi clứng cơt sáng dut te par-nai ca to na Án.<verse eid="MAT 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Ma máh ti-cuôi Pha-ra-si, bôn sáng i-mo Yang Yê-su táq dyôn máh ti-cuôi Sa-du-sê cớng a-rốq, ngki khoiq par-chúng liêh mu nơi. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Bôn ti-cuôi te top nha-án, la ti-cuôi pa-sái rit, tớq plốh ính thứq Án — <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“Thới ơi, par-nai pa-táp mmo lư pưt tớq phep rit?” <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />Dyơ Án tông ada conh ngki: “‘Cóq a-moih Yang, la Yang Arbang Pilŏ́ng na mái, na nhéq te mít can-nính mái, a-lứng nhéq te tar-ngứh mái nha nhéq te par-ngíh mái.’ <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Ngki la par-nai pa-táp pưt a-lứng tar-náp lư. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Ma par-nai pa-táp bar mu chứng par-nai pa-táp ngki — ‘Cóq a-moih ti-cuôi tar-mán na mái mu chứng a-rớq cháq mái.’ <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Nhéq máh phep rit a-lớng ti-cuôi tang ng-cang bôn ial te bar par-nai pa-táp ndô.”<verse eid="MAT 22:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Dyơ, ndóng ngki máh ti-cuôi Pha-ra-si át tang-húng liêh, Yang Yê-su plốh nha-án, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />idô: “Top i-nha par-ngíh i-mo te Yang Choi Ta-mống? Án la a-cái na nnáu?” Nha-án ôi Án: “Na puô Da-vit.” <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />Án tông ada nha-án: “Khán iki ma i-mo Da-vit, bôn Yang Ar-vai, dŏq Án la Yang, ndóng taq-ntêr:<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />‘Yang tông ada Yang cư:</para>
  <para style="q1" vid="MAT 22:44">“Cóq ti-cu tớq pa a-tớm Cư,</para>
  <para style="q1" vid="MAT 22:44">ti-ngôi i-ngái mmo Cư dŏq máh ti-cuôi par-ual na mái ta-dưp dyưng mái”’?<verse eid="MAT 22:44" /></para>
  <para style="b" />
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Iki khán Da-vit dŏq Án la ‘Yang,’ ngki i-mo têq Án la a-cái puô ngki?” <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Ớq nnáu hôi ôi liêh Án mui par-nai, a-lứng ớq ti-cuôi mmo dáh plốh Án nnáng náp te i-ngái ngki.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Dyơ ngki, Yang Yê-su tông ada ti-cuôi clứng nha top ndon rian án, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />idô: “Máh thới sái rit a-lứng máh ti-cuôi Pha-ra-si ti-cu tớq tar-cu na Môi-se. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Co iki, khán nha-án ca to i-nha par-nai a-mớh, cóq táq veng a-lứng náp peh nhéq. Ma êq táq veng máh ar-náq na nha-án, co nha-án tông ma lớiq táq. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Nha-án a-ngốh máh rit rŏng diêiq a-rức a-lứng ntáng lư, dyơ nha-án ng-cróh tớq tar-lang ti-cuôi can-nŏ́h, ma lư nha-án lớiq ính díh ta-kít ati bôm dŏq tar-choi. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />Nha-án táq cứp ar-náq na nha-án dŏq têq ngai bôn hôm. Co nha-án táq máh hop dŏq par-nai yang na nha-án dyôn pưt a-lứng táq máh par-yoiq au nha-án dyôn toiq. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Nha-án ính lư át te ta-niêng tớq cha pêl bui, a-lứng máh ki-chơng ŏ tháng tớq dúng rum, <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />a-lứng máh par-nai pa-sôl na car-na pưt, nha bôn ti-cuôi clứng dŏq la ‘Thới.’ <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Ma i-nha êq dyôn ngai dŏq la ‘Thới’, co thới na i-nha nưm bôn mu náq, ma nhéq náq i-nha la em ai. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />A-lứng i-nha êq dŏq ti-cuôi mmo tớq cúc cu-teq ndô la ‘a-ám’ co i-nha nưm bôn mui lám A-ám át tớq pilŏ́ng. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />A-lứng êq dyôn ngai dŏq i-nha la ‘ti-cuôi sút,’ co ti-cuôi sút na i-nha nưm bôn mu náq — ngki la Yang Choi Ta-mống. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Ma ti-cuôi pưt tháng tớq top i-nha lư cơt sol top i-nha <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Khán nnáu ma a-sớr cháq án ngki lư cơt két; a-lứng nnáu ma a-siar cháq án ngki lư cơt pưt.<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />Ma bap dyôn top i-nha, máh thới sái rit a-lớng ti-cuôi Pha-ra-si, top táq náh nnan! Co top i-nha ca-táng cruông tớq pilŏ́ng ngki chứng mát ti-cuôi can-nŏ́h. Co top i-nha ngki lớiq mot nga callúng, a-lứng lớiq dyôn nnáu têq tớq dŏq bôn mot nga callúng. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />[Bap dyôn top i-nha, máh thới sái rit a-lứng ti-cuôi Pha-ra-si, top táq náh nnan ntíh! Co top i-nha lop pa-dớm dúng máh cán cám mai, dyơ cớu seq dyôn toiq ính ngai hôm.] Co te ngki, top i-nha ráp tôt ntáng lư. <verse eid="MAT 23:14" /><verse number="15" style="v" sid="MAT 23:15" />Bap dyôn top i-nha, máh thới sái rit a-lứng ti-cuôi Pha-ra-si, top táq náh nnan! Co top i-nha pôq chuôp dơq ving ca-vang a-lớng na cu-teq dŏq táq dyôn mu náq ti-cuôi veng ngê i-nha, dyơ ndóng ti-cuôi ngki khoiq cơt iki, top i-nha táq dyôn ti-cuôi ngki cơt a-cái na cu-chet pít ta-niêng te top i-nha.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />Bap dyôn top i-nha, máh ti-cuôi a-yông ti-cuôi sot, top i-nha tông: ‘Ti-cuôi mmo can-tŏ́h co dúng sang ngki ớq bôn a-mớh. Ma ti-cuôi mmo can-tŏ́h co dyeng tớq dúng sang ngki án cóq táq.’ <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Máh ti-cuôi a-chơ a-lứng ti-cuôi sot ntíh! Co nốh mmo la pưt hơn, dyeng a-láng dúng sang táq dyôn dyeng cơt práh ŏ? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Ma khán: ‘Ti-cuôi mmo can-tŏ́h bôiq nốh pa-rông sang ngki ớq a-mớh. Ma ti-cuôi mmo can-tŏ́h bôiq nốh crơng sang tớq pa-rông sang ti-cuôi ngki cóq táq.’ <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Máh ti-cuôi a-chơ a-lứng ti-cuôi sot ntíh! Co nốh mmo pưt hơn, crơng sang a-láng pa-rông sang táq dyôn crơng sang cơt práh? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Co iki, nnáu khoiq can-tŏ́h bôiq nốh pa-rông sang ngki can-tŏ́h bôiq nốh pa-rông sang a-lứng co cứp nốh tớq mpiên ngki. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Nnáu ma can-tŏ́h bôiq nốh dúng sang ngki can-tŏ́h co dúng sang a-lứng co Án át tớq ngki. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />A-lứng nnáu khoiq can-tŏ́h co bôiq pilŏ́ng ngki can-tŏ́h co par-nai na Yang Arbang Pilŏ́ng a-lứng co Án át tớq ngki.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />Bap dyôn top i-nha, máh thới sái rit a-lứng ti-cuôi Pha-ra-si, top táq náh nnan ntíh! Co top i-nha mŏp mui phê mu chít bát bai ngki a-lớng bát ar-lóng, ma lớiq peh máh callong pưt hơn tớq phep rit — callong ti-nớng tu-pứng, bôn mít srui-táq nha mít ti-nớng tu-pứng. Ma, ngki la callong tar-náp lư dŏq táq máh ar-náq ndô, a-lứng êq táh máh ar-náq ntíh. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Ti-cuôi ndon par-yông ti-cuôi sot mát ntíh, la máh ti-cuôi dyớq a-ngốh mui allám a-nhóc két, ma lôn a-túq mui allám lac-da!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />Bap dyôn top i-nha, máh thới sái rit a-lứng ti-cuôi Pha-ra-si, top táq náh nnan ntíh! Co top i-nha a-rau práh te tiêh na ti-ngan a-lứng ta-van, ma te callúng nha-án ngki pớnh callong tar-pún a-lứng ngoiq cha thương. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Máh ti-cuôi Pha-ra-si ndon sot ntíh! Nsuôi lư cóq i-nha a-rau práh te callúng ti-ngan a-lứng ta-van, dŏq te tiêh na nha-án mu chứng cơt práh.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />Bap dyôn top i-nha, máh thới sái rit a-lứng ti-cuôi Pha-ra-si, top táq náh nnan ntíh! Co top i-nha a-rớq máh ping cu-muiq dŏq a-sa práh, máh nốh ngki a-páh a-maiq ŏ te tiêh, ma te callúng pớnh máng ng-hang ti-cuôi cu-chet nha cứp ar-náq lớiq ŏ. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Ngki mu chứng iki tưi, ma tớq tiêh top i-nha a-páh lư ŏ dyôn ada ti-cuôi can-nŏ́h, ma tớq callúng top i-nha pớnh máng callong lớiq ŏ nha táq náh nnan.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />Bap dyôn top i-nha, máh thới sái rit a-lớng ti-cuôi Pha-ra-si, top táq náh nnan ntíh! Co top i-nha táq dŏq ping dyôn ti-cuôi tang ng-cang a-lớng táq ŏ ping na máh ti-cuôi ti-nớng ŏ. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Top i-nha tông: ‘Khán top he át tớq pang na a-chúc a-chiac i-nha, ngki án la top he lớiq táq máh ti-cuôi ndon sŏ́ng mu nơi a-lớng nha-án ntúq hóc a-ham máh ti-cuôi tang ng-cang.’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Dyơ ngki, top i-nha cóq taq-ntêr bôm te i-nha i-mo i-nha la a-cái a-cháu na máh ti-cuôi khoiq ca-chet máh ti-cuôi tang ng-cang, <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />a-lứng top i-nha cóq táq dyôn cua máh ar-náq lớiq ŏ na a-chúc a-chiac i-nha! <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Top cu-sánh bôn pih, tŏ́ng toiq te cu-sánh tar-lúng, top i-nha ính viar vít callong tar-sưq te cu-chet pít na car-na mmo? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Co te ar-náq ndô, me ngki cư yua máh ti-cuôi tang ng-cang, ti-cuôi tu-báiq nha thới sái rit tớq nga top i-nha. Ngki te top nha-án, top i-nha lư ca-chet a-lứng téh díng, mu chứng tớq top nha-án, top i-nha lư púh tính tớq dúng rum i-nha a-lứng chuih te vel ndô pôq vel can-nŏ́h, <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />iki dyôn cơt tớq nga top i-nha nhéq máh a-ham ti-cuôi ti-nớng ŏ khoiq hóc tớq cúc cu-teq, te a-ham na A-ben, ti-cuôi ti-nớng ŏ, ti-ngôi a-ham na Sa-cha-ri, a-cái conh Ba-ra-chi, ti-cuôi ndon top i-nha khoiq ca-chet tớq dúng sang a-lớng tớq pa-rông sang. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Ar-lớih lư, cư tông ada top i-nha, cứp ar-náq ngki lư cơt tớq pang ndô.<verse eid="MAT 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />Yaru-salem, Yaru-salem, i-nha khoiq ca-chet máh ti-cuôi tang ng-cang a-lứng tíq búl máh ti-cuôi ndon ngai yua tớq nga i-nha! Chom nsếq chư cư ính pa-chúng a-cái a-con na i-nha mu nơi, mu chứng a-rớq ntruôi i-cán ca-trốc a-cái án át pưn nnár, ma i-nha lớiq ính! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Me ndô, dúng na top i-nha lư cơt ar-ngol dyôn top i-nha. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Co cư tông ada top i-nha, top i-nha lư ar-lớih lư ớq bôn hôm cư tư ndô ti-ngôi díh ali mmo top i-nha tông: ‘Bún dyôn Án ndon tớq te nốh Yang!’”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Tư dyơ ngốh te dúng sang, Yang Yê-su chón pôq na car-na. Dyơ top ndon rian Án tớq tar-mán ính ca to dyôn Án me máh ar-náq tớq dúng sang. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Ma dyơ ôi liêh, Án tông ada nha-án: “I-nha ớq bôn hôm cứp nốh ngki? Ar-lớih lư, cư tông ada i-nha ntúq ndô lư ar-lớih cơt ớq bôn nnáng cúc búl ndô ta-piên cúc búl ntíh ma lớiq ar-líh.”<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Hoi ngki, ndóng Án chón ti-cu tớq cóh Ô-li-vê, top ndon rian tớq ndái tar-mán Án, plốh: “Seq dyôn top he chom ali mmo máh ar-náq ngki lư cơt, a-lứng bôn tíc a-mớh ar-náq ngki tớq te thới nha te i-ngái talloiq la a-mớh?” <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />Ndóng ôi liêh, Yang Yê-su tông ada nha-án: “Cóq mmứng dŏq ớq nnáu têq táq dyôn i-nha clu car-na. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Co clứng ti-cuôi lư tớq te nốh thới, ngin: ‘Cư la Yang Choi Ta-mống,’ a-lứng lư táq dyôn clứng ti-cuôi nha-án pi-lốh. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Ma i-nha lư bôn sáng te ngai tar-chíl a-lứng par-hanh te tar-chíl. I-nha cóq mmứng, êq rớu ri, co ar-náq ngki cóq tớq a-vai, ma yôl i-yốh la i-ngái talloiq. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Co top ndô lư ca-tóng ính chíl top can-nŏ́h, cruông ndô chíl liêh cruông ntíh, dyơ lư bôn pi-nhaih tar-riat a-lứng ca-cưt cu-teq tớq a-ưi ntúq. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Ma nhéq máh ar-náq ndô la mbơiq tớq tôm lư a-rớq cán sáng a-ái tớq cuôp cu-mo. <verse eid="MAT 24:8" /><verse number="9" style="v" sid="MAT 24:9" />Ndóng ngki, ngai lư ki-túh i-nha nga ntúq diêiq a-rức dyơ ca-chet i-nha táp, a-lứng i-nha lư bôn cứp náq ti-cuôi a-ính co te nốh cư. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Dyơ clứng ti-cuôi lư bôn táq luaih, mu náq cauq mu náq nha mu náq a-ính mu náq. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />A-ưi tang ng-cang náh nnan lư cơt rứh a-lứng táq dyôn a-ưi ti-cuôi clu car-na. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Co ngê lớiq ŏ cơt tớq níc, callong ar-moih te cứp náq ti-cuôi ngki ớq nnáng. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Ma nnáu rap chiuq ta-nhir dyôn díh talloiq tháng, ti-cuôi ngki lư bôn tu-mống. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Par-nai ŏ ndô te cruông tớq pilŏ́ng bôn ti-cuôi ca to tớq chuôp cruông cu-teq dŏq taq-ntêr dyôn máh ti-cuôi, a-lứng dyơ ar-náq talloiq ngki lư tớq. <verse eid="MAT 24:14" /><verse number="15" style="v" sid="MAT 24:15" />Iki, ndóng i-nha bôn hôm crơng prớq ngki táq a-íh, la callong khoiq bôn tang ng-cang Da-ni-ên tông a-cớiq, dŏq tớq ntúq dúng sang” (ti-cuôi dŏc cóq a-púh), <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />“chón ngki, nnáu te vúng Yu-dê cóq lúh ca-tốq nga vúng cóh, <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />nnáu át tớq mpiên dúng, êq siar ial nnáng crơng-crớu te dúng án, <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />a-lứng nnáu át tớq pi-dái êq píh chô ial nnáng au án. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Ma bap lư dyôn cán át cháq iki a-lớng máh ti-cuôi yôl dyôn a-cái uq tớq máh i-ngái ngki! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Ma cóq cớu seq dŏq ar-náq ính lúh na i-nha lớiq cơt tớq ki-sái ng-ngiat, a-láng tớq i-ngái A-ngô. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Co i-ngái ngki lư bôn callong diêiq a-rức pưt, i-yốh cơi tớq a-rớq iki te ndóng tôm lư cruông cu-teq ti-ngôi tớq i-ngái ndô, nha ar-lớih lư cơt lớiq bôn. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Khán máh i-ngái ngki lớiq bôn a-roiq kéh, ngki lư cứp náq ti-cuôi khoiq ớq bôn tu-mống. Ma co te máh ti-cuôi dŏq rêh, máh i-ngái ngki lư bôn ca-roiq mu biq. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />Dyơ ngki, khán bôn ti-cuôi mmo taq-ntêr ada i-nha: ‘Me ngki, Yang Choi Ta-mống át tớq ndô!’ lớiq la ‘Tớq ngki!’ i-nha êq peh. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Co lư bôn tới yang choi ta-mống nha tới lư tang ng-cang ính tớq a-lứng a-páh máh tíc si-leh a-lớng máh ar-náq laq pưt lư tar-lúh táq dyôn clu car-na, khán têq iki, pi-lốh díh máh ti-cuôi ndon án khoiq rêh. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Me ndô, cư tông nsuôi dyôn i-nha dyơ ngki. <verse eid="MAT 24:25" /><verse number="26" style="v" sid="MAT 24:26" />Iki, khán ngai taq-ntêr ada i-nha: ‘Me ntíh, Án át tớq ntúq aih,’ i-nha êq pôq nga tu-ki. ‘Me ndô, tớq máh a-túq clôp,’ i-nha êq cam-máng. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Co li-laiq cáng te mát pan-dang ngốh dyơ díh pứp mát pan-dang pát i-mo, ngki ar-náq tớq na A-cái Yang Cơt Ti-cuôi la lư mu chứng iki. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Bôn bớr cu-chet tớq ntúq mmo, ca-lang lư srúp tớq ntúq ngki.<verse eid="MAT 24:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />Ma i-ngái ta-tun callong diêiq a-rức na máh i-ngái ngki, mát pan-dang cơt ngiau, ki-sái lư lớiq claq ang nnáng te án, máh pan-tôr ngki te pilŏ́ng a-tôh, a-lứng máh nốh bôn chức tớq pilŏ́ng ca-cưt nhéq. <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />Ndóng ngki, tíc si-leh te A-cái Yang Cơt Ti-cuôi dŏq a-páh tớq pilŏ́ng, a-lứng dyơ nhéq máh ti-cuôi tớq cúc cu-teq ndô nhiêm. Nha-án bôn hôm A-cái Yang Cơt Ti-cuôi tớq mpiên máh tu-lúc pilŏ́ng a-lớng chức sút a-lứng ang ưr pưt lư. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Án yua top tar-neng na Án a-lứng plóng tang-coi yứng, nha nha-án par-chúng liêh máh ti-cuôi khoiq dŏq rêh na Án te cứp a-nga, te cloiq pilŏ́ng crôp ndô díh tớq cloiq pilŏ́ng crôp ntíh.<verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />Ma, cóq cam-máng par-nai a-cám ndô te a-long ta-rúng. Ndóng a-beng án yôl nhom a-lứng ngốh ula dyơ, i-nha chom ar-lớih ki-sái tang-hiêng tu-mán tớq. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Mu chứng a-rớq ngki, ndóng i-nha hôm cứp ar-náq ndô, i-nha chom ar-lớih Án chón át tu-mán, tar-dáng ngáh callống. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Ar-lớih, cư tông ada i-nha, i-mo pang ndô ar-lớih lư lớiq bôn pít ti-ngôi tớq ali mmo nhéq máh ar-náq ngki cóq tớq a-vai. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Pilŏ́ng nha cu-teq lư cơt pít, ma máh par-nai na cư lư ar-lớih lớiq bôn têq pít. <verse eid="MAT 24:35" /><verse number="36" style="v" sid="MAT 24:36" />Ma te i-ngái a-lớng ndóng ngki ớq nnáu chom, díh máh tar-neng tớq pilŏ́ng a-láng A-cái, nưm A-ám táp chom. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Tớq pang Nô-ê co i-mo, ar-náq tớq liêh na A-cái Yang Cơt Ti-cuôi la mu chứng iki tưi. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Co a-rớq tớq máh i-ngái nsuôi ar-lám dơq, ngai át cha ngoiq, tar-ial ar-suôi ti-ngôi díh i-ngái Nô-ê mot tớq tuôc, <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />a-lứng nha-án lớiq chom a-mớh ti-ngôi díh dơq ar-lám tớq a-lứng pa-long nha-án viang — te callong tớq na A-cái Yang Cơt Ti-cuôi lư mu chứng iki tưi. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Ndóng ngki, bar náq conh chón át tớq pi-dái — mu náq ngki án ial dông, mu náq ngki án dŏq át liêh. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Bar náq cán chón cu-clóh — mu náq ngki dông pôq, mu náq ngki dŏq liêh. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />Co iki, cóq tam-prán co i-nha lớiq chom tớq i-ngái mmo Yang i-nha lư tớq. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Ma i-nha ayư ar-náq ndô, ar-lớih khán án ưlla dúng khoiq chom ti-cuôi si-veng tớq mot tu-pứng mmo tớq i-dáu, ngki lư án ưlla dúng lớiq bíq a-lứng lư lớiq dyôn dúng án si-veng bôn mot. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Co ar-náq ndô, i-nha lư cóq tam-prán, co A-cái Yang Cơt Ti-cuôi lư tớq chón ndóng i-nha lớiq par-ngíh nnáng.<verse eid="MAT 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />Ma khán, nnáu la prái tar-ráih ti-nớng tu-pứng a-lớng hôi tu-báiq ma ưlla dúng dyôn kiaq me máh ti-cuôi tớq dúng na ưlla dŏq ar-pô tan-na ada nha-án lư cơt crái piaiq? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Bún lư dyôn ti-cuôi prái tar-ráih ngki, la ti-cuôi ndon ưlla dúng na án, dyơ ndóng tớq, bôn hôm án lư táq a-rớq iki. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Ar-lớih lư cư tông ada i-nha i-mo ưlla dúng lư dyôn conh ngki kiaq me cứp nốh ưlla dúng bôn. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Ma khán bôn prái tar-ráih lớiq ŏ ngki par-ngíh tớq mít án: ‘Ưlla cư tớq i-láq,’ <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />dyơ ta-bớq tính púh máh ti-cuôi mu chứng prái a-rớq án, ma cha ngoiq a-lớng top bol plêc, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />ti-cuôi ưlla na prái tar-ráih ngki lư tớq nga i-ngái ndon án lớiq mmứng mmáng a-lứng chón ndóng ndon án lớiq chom. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Conh ngki lư pi-tôt án ntáng lư a-lứng a-mot nga ntúq án át mu nơi a-lớng top táq náh nnan; tớq ntúq ngki lư bôn callong nhiêm cu-cloiq nha cal-tiat ki-neng.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />Iki, cruông tớq pilŏ́ng ngki a-rớq mu chít náq cu-mor plŏt, la máh ti-cuôi kéu den tớu nha-án pôq tớq ntúq cớiq án ndon ial cam-pái. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Ma sông náq te mu chít náq nha-án ngki a-chơ, ma sông náq ngki tu-báiq. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Co sông náq cán a-chơ, tư dyơ kéu den tớu na nha-án ngki, ma lớiq dông tớu ca-lưi ada nha-án. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Ma máh cán tu-báiq ngki khoiq dông tớu ca-lưi tớq be mu nơi a-lứng den tớu nha-án. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Dyơ ngki, co án ndon ial cam-pái dyut tớq, nhéq náq nha-án sáng ính bíq dyơ bíq tưt loi. <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />Ma tớq tar-di i-dáu, bôn siêng arô: ‘Án ndon ial cam-pái ntíh! Cóq pôq tớq ntúq tar-cớiq.’ <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />Ndóng ngki, nhéq máh cán cu-mor plŏt ngki têq ayư a-lứng ti-ráp den tớu nha-án. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Hoi ngki, máh cán a-chơ tông ada máh cán tu-báiq: ‘Seq dyôn top he mu biq tớu na top i-nha, co den tớu na top he khoiq ính pát.’ <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />Ma ndóng ôi liêh, máh cán tu-báiq tông: ‘Dáh lư cơt lớiq bôn cứp dyôn top he a-lứng top i-nha. Piaiq lư, i-nha pôq díh máh ti-cuôi tán táiq ndon plới dyôn i-nha.’ <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Ma, chón ndóng nha-án pôq plới, án ial cam-pái khoiq tớq, a-lứng máh cán yôl tớu mu nơi a-lớng án ial cam-pái mot tớq ntúq cha ar-suôi, dyơ ngáh callống ngai dŏq ca-táng. <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" />Dyơ vít ngki, máh cu-mor plŏt ngki la tớq, seq: ‘Ưlla ơi, ưlla ơi, seq pốh callống dyôn top he.’ <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />Ma dyơ ôi liêh, ưlla ngki tông: ‘Ar-lớih lư, cư tông ada top i-nha, cư lớiq chom top i-nha.’ <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />Iki, cóq tam-prán, co i-nha lớiq chom i-ngái a-láng hoi ngki.<verse eid="MAT 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />Co mu chứng a-rớq mu náq ti-cuôi tu-mán ính pôq cruông yông, án dŏq arô máh prái tar-ráih na án tớq a-lứng mŏp dyôn nha-án mun na án. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Án dyôn ti-cuôi ndô sông nen, ti-cuôi ntíh bar nen, ti-cuôi can-nŏ́h loi mui nen — cứp náq nha-án veng par-ngíh têq táq bôm. Dyơ án pôq táp nga cruông yông. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Tư án pôq dyơ, án ndon ráp sông nen dông táiq plới te sông nen ngki nha bôn lơi sông nen can-nŏ́h. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Mu chứng ngki, ti-cuôi ndon ráp bar nen ngki lơi liêh bar nen can-nŏ́h. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Ma ti-cuôi ndon ráp mui nen, vít dyơ pôq, píq prúng a-lứng tứp práq te ưlla án. <verse eid="MAT 25:18" /><verse number="19" style="v" sid="MAT 25:19" />Dyơ ngki, tư dưnh cu-mo ki-sái, ưlla na máh ti-cuôi prái ngki chô a-lứng plốh liêh nhéq práq te nha-án. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Tư dyơ tớq tu-mán, án ráp sông nen dông sông nen can-nŏ́h, taq-ntêr: ‘Ưlla ơi, ưlla mŏp dyôn cư sông nen. Ma seq me ndô, cư khoiq táq lơi liêh sông nen.’ <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />Ưlla na án tông ada án: ‘Ŏ lư, mái prái tar-ráih hôi a-lứng ti-nớng tu-pứng! Mái khoiq ti-nớng tu-pứng te ar-náq két. Cư lư dyôn mái kiaq me a-ưi ar-náq. Cóq mot tớq callong bui a-lớng ưlla mái.’ <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />Án bôn bar nen, tư dyơ tớq tu-mán, ngki taq-ntêr: ‘Ưlla ơi, ưlla khoiq mŏp dyôn cư bar nen, ma seq me ndô, cư khoiq táq lơi liêh bar nen.’ <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />Ưlla na án tông ada án: ‘Ŏ lư, mái prái tar-ráih hôi a-lứng ti-nớng tu-pứng! Mái khoiq ti-nớng tu-pứng te ar-náq két. Cư dyôn mái kiaq me a-ưi ar-náq. Cóq mot tớq callong bui a-lớng ưlla mái.’ <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />Ma ti-cuôi ráp mui nen, la tớq tưi, khoiq taq-ntêr: ‘Ưlla ơi, cư chom ưlla, i-mo ưlla la mu náq ti-cuôi kát lư, sŏt tớq ntúq ưlla lớiq trứh a-lứng ial tớq ntúq ưlla lớiq chóh. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Co sáng a-dáh, iki tư dyơ ti-caq ngốh, cư dŏq tứp nen na ưlla tớq cu-teq. Seq me ndô, ưlla ial liêh práq na ưlla.’ <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />Ma chón ôi liêh, ti-cuôi ưlla na ti-cuôi ngki tông ada án: ‘Mái prái tar-ráih lới a-lớng a-láh lư ngki! Mái khoiq chom ar-lớih cư sŏt tớq ntúq cư lớiq trứh nha ial tớq ntúq cư lớiq chóh. <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Khán iki, ŏ lư mái cóq dông pa liêh práq na cư dyôn ngai váq, dyơ tớq cư chô, ngki cư khoiq ráp liêh práq na cư a-lớng práq lơi. <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Iki, cóq ial nen te án ndô dyơ dyôn práq ngki ada án ndon bôn mu chít nen. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Co ada ti-cuôi ndon bôn, cứp nốh ngki dyôn a-ưi loi — ti-ngôi pớnh clưi cliai. Ma te ti-cuôi ndon ớq bôn, díh nốh án bôn ngki ta-ial viang te án. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />A-lứng cóq a-dúh prái tar-ráih ớq lơi ngki nga ntúq ngiau tớq tiêh, la ntúq bôn callong nhiêm cu-cloiq nha cal-tưat ki-neng.’<verse eid="MAT 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />Ma ndóng A-cái Yang Cơt Ti-cuôi tớq chức ang ưr Án a-lứng nhéq máh tar-neng mu nơi a-lớng Án, chón ndóng ngki, Án ti-cu tớq tar-cu ang ưr án. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Nhéq náq top ti-cuôi dŏq par-chúng chứng mát Án, nha Án car-yáh nha-án cơt top, a-rớq ti-cuôi kiaq car-yáh cưu ngốh te mbeq. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Án lư dŏq cưu át pa a-tớm án, ma mbeq át pa a-viar. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Vít ngki, Puô lư tông máh ti-cuôi át pa a-tớm án: ‘Máh ti-cuôi khoiq bôn A-ám Cư dyôn bún, tớq nga tu-dô, cóq chúng tưi cruông khoiq suan dŏq ada i-nha te ndóng teng cúc cu-teq. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Co Cư pi-nhaih, iki i-nha dyôn Cư cha; Cư hál, iki i-nha dyôn Cư ngoiq; Cư la tu-moi laq, iki i-nha cóq ráp chom Cư; <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Cư ớq tam-pớc, ngki i-nha ta-sứp dyôn Cư; Cư a-ái, ngki i-nha par-tê Cư; Cư át tớq cŏq tôt, ngki i-nha pôq clơ Cư.’ <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />Ndóng ngki, máh ti-cuôi ti-nớng ŏ lư ôi liêh Án, idô: ‘Ưlla ơi, top he hôm Ưlla pi-nhaih ma dyôn cha, lớiq la hál ma dyôn ngoiq tớq ndóng mmo? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Dyơ top he khoiq hôm Án a-rớq tu-moi laq ma ráp chom, a-láng ớq tam-pớc ma ta-sứp dyôn tớq ndóng mmo? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />A-lứng top he khoiq hôm Án a-ái a-láng át tớq cŏq tôt ndóng mmo ma pôq clơ Án?’ <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Ndóng ính ôi, Puô tông ada nha-án: ‘Ar-lớih lư, Cư tông ada top i-nha, me liêh te ar-náq top i-nha khoiq táq dyôn mu náq te máh ngai a-cái két te máh em ai ndô na Cư, i-nha khoiq táq dyôn Cư.’ <verse eid="MAT 25:40" /><verse number="41" style="v" sid="MAT 25:41" />Dyơ ngki, Puô lư tông loi ada máh ti-cuôi át pa a-viar: ‘Cóq tôi yông te Cư, máh ti-cuôi khoiq dŏq pu-pap ntíh, mot nga ntúq uih chéc díh sút pang khoiq dŏq suan dyôn yang sáq a-lứng máh tar-neng na án. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Co Cư pi-nhaih ma top i-nha lớiq dyôn Cư cha; Cư hál ma top i-nha lớiq dyôn Cư ngoiq; <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Cư la tu-moi laq, ma top i-nha lớiq ráp chom Cư; ớq tam-pớc ngki top i-nha lớiq ta-sứp dyôn Cư; a-ái a-lớng át tớq cŏq, ngki top i-nha lớiq par-tê Cư.’ <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />Ndóng ngki, nha-án lư ôi, idô: ‘Ưlla ơi, top he khoiq hôm Ưlla pi-nhaih, a-láng hál, lớiq la a-rớq tu-moi laq, a-láng ớq tam-pớc, lớiq la a-ái, a-láng át tớq cŏq tôt ndóng mmo ma lớiq choi Ưlla?’ <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Dyơ ngki, Puô ôi liêh nha-án, idô: ‘Ar-lớih lư, Cư tông ada top i-nha, me liêh te ar-náq top i-nha khoiq lớiq táq dyôn mui te máh ngai a-cái két te máh ti-cuôi ndô, top i-nha khoiq lớiq táq dyôn Cư.’ <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />Máh ti-cuôi ngki lư cóq át tớq callong diêiq a-rức lư, ma máh ti-cuôi ti-nớng ŏ ngki át tớq callong tu-mống díh sút pang.”<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Ar-náq cơt ndóng Yang Yê-su khoiq tông cua nhéq máh par-nai ngki, Án tông ada ndon rian án: <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“I-nha chom ar-lớih bar i-ngái loi náq tớq cha Ayư I-ngái Ngốh, a-lứng A-cái Yang Cơt Ti-cuôi cơt ngai mŏp dŏq chiuq ngai téh díng tớq a-long calláng.” <verse eid="MAT 26:2" /><verse number="3" style="v" sid="MAT 26:3" />Ndóng ngki, máh thới teng rit sang a-lớng top ti-cuôi sút te top nha-án dŏq par-chúng mu nơi tớq dúng na thới teng rit sang, nốh la Cai-pha. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Nha-án sŏ́ng tang-húng dŏq nha-án têq si-suô ngê cŏp Yang Yê-su dyơ ca-chet Án. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Ma nha-án tông: “Tới tớq i-ngái cha bui, dŏq ar-náq par-ốh êq cơt tớq top he.”<verse eid="MAT 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Chón ngki, ndóng Yang Yê-su yôl át tớq Bê-tha-ni, tớq dúng Si-môn, ti-cuôi ndon a-ái bŏ́q, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />mu náq cán dông mui allám yáng a-la-bat khoiq ca-cháq dơq thum lư dát práq tớq tar-mán Án, dyơ cán ngki tốq tớq plô Án, chón ndóng ti-cu chi-cha. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />Ma tư hôm iki, top ndon rian sáng nháih, tông: “Pi-rê idô dŏq táq a-mớh? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Co dơq thum ndô khán táiq bôn a-ưi práq a-lứng dŏq tar-choi dyôn ti-cuôi ki-dit.” <verse eid="MAT 26:9" /><verse number="10" style="v" sid="MAT 26:10" />Ma chom ar-náq ndô, Yang Yê-su tông nha-án: “I-mo i-nha táq diêiq cán ndô? Co án khoiq táq mui ar-náq ŏ dyôn cư. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Co i-nha bôn níc ti-cuôi ki-dit át a-lớng i-nha, ma tới i-nha át níc a-lớng cư. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Co ndóng án tốq dơq thum ndô tớq cháq cư, án táq iki dyôn ar-náq ính tứp cư. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Ar-lớih lư, cư tông ada i-nha, khán ntúq mmo Par-nai ŏ ndô bôn ca to tớq chuôp cúc cu-teq, ar-náq cán ndô khoiq táq ngki lư ntêr liêh dŏq ayư te án.”<verse eid="MAT 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Vít ngki, mu náq te mu chít la bar náq dyưng ati, nốh Yu-da Ica-ri-ôt, pôq tar-múh top thới teng rit sang, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />khoiq plốh: “Top i-nha ính dyôn cư máh mmo, dyơ cư lư mŏp ti-cuôi ngki ada top i-nha?” Iki, nha-án ính dyôn án pe chít callong práq. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />A-lứng cua te ngki, án ta-bớq suô ngê dŏq ính cu-liêu Án.<verse eid="MAT 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Dyơ ngki, tớq i-ngái mui na pêl cha bui Beng Ớq Pôih, top ndon rian tớq nga Yang Yê-su, plốh: “Thới ính top he suan dyôn thới cha pêl bui Cha Ayư I-ngái Ngốh tớq mmo?” <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />Dyơ Án yua: “Cóq mot tớq vel, pôq tar-múh mu náq ti-cuôi a-lứng ntêr ada án: ‘Thới tông: “I-ngái na thới ngki chón ính tớq dyơ; thới ính cha pêl Cha Ayư I-ngái Ngốh tớq dúng mái a-lớng top ndon rian thới.”’” <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Top ndon rian táq a-rớq Yang Yê-su dŏq ca to nha-án, dyơ nha-án ti-ráp pêl Cha Ayư I-ngái Ngốh.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Dyơ ngki, ndóng pêl i-dáu tớq, Án ti-cu chi-cha mu nơi a-lớng mu chít la bar náq dyưng ati. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Ndóng nha-án chón chi-cha, Án tông: “Ar-lớih lư, cư tông ada i-nha idô mu náq ti-cuôi te i-nha lư cu-liêu cư.” <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />Dyơ sáng a-nguaq lư tháng, cứp náq nha-án ta-bớq plốh Án: “Thới ơi, tới la cư?” <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />Ma dŏq ính ôi liêh, Án tông: “Ti-cuôi ndon ta-lứm ati án tớq hóng ti-ngan mu nơi a-lớng cư, ti-cuôi ngki lư cu-liêu cư. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Ma A-cái Yang Cơt Ti-cuôi cóq cu-chet veng a-rớq par-nai dŏq ta-ran te Án, ma bap lư dyôn ti-cuôi ngki, co án ma A-cái Yang Cơt Ti-cuôi ndon khoiq cu-liêu! Khán ti-cuôi ngki ớq bôn car-nian ngki ŏ lư dyôn án.” <verse eid="MAT 26:24" /><verse number="25" style="v" sid="MAT 26:25" />Ma ndóng ính ôi liêh, Yu-da, ndon cu-liêu Án, tông: “Thới, a-láng la cư?” Yang Yê-su tông ada án: “Mái táp lư tông.”<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Hoi ngki, ndóng nha-án chón chi-cha, ngki ial beng a-lứng si-ơn, Yang Yê-su khoiq péq beng. A-lứng tư dyơ a-vôi dyôn top ndon rian, Án tông: “Áu ráp ial, cha. Ndô la cháq na cư.” <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />A-lứng ndóng ial choc dyơ si-ơn, Án dŏq a-vôi ada nha-án, dyơ tông: “Nhéq náq cóq ngoiq te choc ndô. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Co ndô la a-ham par-ưq na cư khoiq dŏq ngốh dyôn ada clứng ti-cuôi nhơ te callong ta-láh luaih lới. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Ma cư tông ada i-nha náp te i-ngái ndô, cư lư ar-lớih lớiq ngoiq te dơq nho ndô ti-ngôi i-ngái ngki, la ndóng ma cư ngoiq dơq nho tam-me a-lớng i-nha tớq cruông na A-ám cư.”<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Cua dyơ cứh mui alhoiq ayô, nha-án pôq nga cóh Ô-li-vê. <verse eid="MAT 26:30" /><verse number="31" style="v" sid="MAT 26:31" />Dyơ ngki, Yang Yê-su tông ada nha-án: “Lư tớq i-dáu ndô, nhéq náq i-nha lư lúh táh cư, co par-nai khoiq dŏq ta-ran:</para>
  <para style="q1" vid="MAT 26:31">‘Cư tính ti-cuôi ndon kiaq</para>
  <para style="q1" vid="MAT 26:31">dyơ cưu na án cơt pláh chap.’<verse eid="MAT 26:31" /></para>
  <para style="b" />
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />Dyơ ndóng cư yôr tu-mống liêh, cư lư pôq nsuôi i-nha nga Ca-li-lê.” <verse eid="MAT 26:32" /><verse number="33" style="v" sid="MAT 26:33" />Ma ôi liêh, Phi-er ôi ada Án: “Ntro nhéq náq lư lúh táh thới, cư lư lớiq táh a-mớh.” <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" />Yang Yê-su tông ada án: “Ar-lớih lư, cư tông ada mái, i-mo tớq táp i-dáu ndô, te i-yốh ntruôi ti-cár, mái lư ca-lôih cư pe chư.” <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />Phi-er ôi liêh Án: “Nám khán yua cư cóq cu-chet a-lớng thới, cư lư ar-lớih lớiq ca-lôih thới.” A-lứng nhéq top ndon rian ngki tông mu chứng iki.<verse eid="MAT 26:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Vít ngki, Yang Yê-su pôq mu nơi a-lớng nha-án nga mui ntúq ngai dŏq la Kêt-sê-ma-nê, dyơ Án tông top ndon rian: “Cóq ti-cu tớq ndô díh ndóng cư pôq tu-tíh cớu seq.” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Dyơ Án dông Phi-er a-lứng bar náq a-cái conh na Sê-ba-dê, Án sáng a-nguaq nha rớu ri. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Dyơ ngki, Án tông ada nha-án: “Ar-vai cư sáng a-nguaq lư ti-ngôi díh cu-chet. Cóq pớn tớq ndô dyơ máih níc mu nơi a-lớng cư.” <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />Ndóng khoiq pôq yông loi mu biq, Án táng ngop mát án pi-tốq, cớu seq a-lứng tông idô: “A-ám cư a-cái ơi, khán ar-náq ndô têq, seq dyôn choc ndô vít te a-cái. Lư iki, tới a-rớq a-cái ính, ma lư a-rớq A-ám.” <verse eid="MAT 26:39" /><verse number="40" style="v" sid="MAT 26:40" />Dyơ Án tớq nga top ndon rian a-lứng hôm nha-án chón bíq, ngki Án tông ada Phi-er: “I-mo, i-nha lớiq rap máih a-lớng cư díh mu húiq sớng? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />I-nha ayư a-lứng cớu seq dŏq i-nha viar yông te callong luaih. Lư mít i-nha ngki ính lư, ma sac sáiq ngki ớq rap.” <verse eid="MAT 26:41" /><verse number="42" style="v" sid="MAT 26:42" />Mu chư sa, ndóng pôq tớq chư bar, Án cớu seq, idô: “A-ám na a-cái ơi, khán ar-náq ndô lớiq têq vít, cóq a-cái ngoiq choc ngki, seq can-nính A-ám dyôn cơt.” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Dyơ tớq mu chư loi, Án hôm nha-án chón bíq, co mát nha-án khoiq lớiq rap ca-plang. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />A-lứng mui can-tứq sa, ndóng táh nha-án tớq ngki dyơ pôq, Án cớu seq tớq chư pe, cớu mu chứng máh callong a-rớq ngki sa. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Vít ngki, Án tớq nga top ndon rian a-lứng tông ada nha-án: “I-nha yôl bíq êm nha a-ngô sa? Me tíh, ngư tớq tar-mán dyơ, a-lứng A-cái Yang Cơt Ti-cuôi ngai mŏp nga ati máh ti-cuôi luaih. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Áu yôr ta-yứng, top he pôq. Me ndô, ti-cuôi cu-liêu cư khoiq tớq dyơ.”<verse eid="MAT 26:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Ndóng Án chón yôl át taq-ntêr, me ntíh, Yu-da, mu náq te mu chít la bar náq dyưng ati, tớq, nha mu nơi a-lớng án la mui top ti-cuôi lư clứng a-lứng dau nha tar-cál, tớq te máh thới teng rit sang a-lớng ti-cuôi sút tớq sớu te top nha-án. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Dyơ ngki, ti-cuôi cu-liêu Án khoiq dyôn nha-án mui tíc, idô: “Ti-cuôi mmo cư honh la ti-cuôi ngki. I-nha cŏp ti-cuôi ngki.” <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Ndóng ngki táp, tư tớq tar-mán Yang Yê-su, án tông: “Bánh tưi Thới” dyơ án honh Án. <verse eid="MAT 26:49" /><verse number="50" style="v" sid="MAT 26:50" />Ma Yang Yê-su tông ada án: “Yớu ơi, co ar-náq ndô ma mái tớq tu-dô.” Dyơ ndóng tớq tar-mán, nha-án pa-lóng nga Yang Yê-su dyơ cŏp Án. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />A-lứng me ntíh, bôn te máh ti-cuôi pôq a-lớng Yang Yê-su, ndóng pa-yơ ati ngki, khoiq ruôh dau án dyơ tráh ti-cuôi sol na thới teng rit sang, ti-ŏ́h cu-tor na conh ngki. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Ndóng ngki, Yang Yê-su yua ti-cuôi ngki: “Ca-cháq liêh dau na mái nga ntúq na án, co nhéq máh ti-cuôi kéu dau lư cu-chet na dau. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />A-láng mái par-ngíh i-mo cư ớq bôn chức arô A-ám cư, dyơ Án yua tớq táp dyôn cư hơn mu chít la bar pớl tar-neng? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Khán iki, táq i-mo máh par-nai Yang Arbang Pilŏ́ng cơt tar-vớiq, i-mo ar-náq ndô cóq cơt a-rớq iki?” <verse eid="MAT 26:54" /><verse number="55" style="v" sid="MAT 26:55" />Chón tu-pứng ngki, Yang Yê-su tông ada ti-cuôi clứng: “Top i-nha pôq mu nơi a-lớng dau nha tar-cál ính cŏp cư a-rớq chíl liêh mu náq ti-cuôi si-veng? Cứp i-ngái, cư ti-cu ca to tớq dúng sang ma top i-nha ngki lớiq cŏp cư. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Ma cứp ar-náq ndô cơt khoiq dŏq ta-ran na máh tang ng-cang têq cơt tar-vớiq.” Chón ngki, ndóng top ndon rian táh Án dyơ, nhéq náq nha-án mmar lúh.<verse eid="MAT 26:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Dyơ, máh ti-cuôi cŏp Yang Yê-su dông Án tớq nga thới teng rit sang Cai-pha, la ntúq ndon máh thới sái rit a-lớng ti-cuôi sút tớq sớu dŏq par-chúng mu nơi. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Ma Phi-er tar-veng Án te yông ti-ngôi díh ng-cưm na a-riaih teng rit sang. Ndóng mot nga callúng dyơ, án ti-cu mu nơi a-lớng top líng dŏq ính chom i-mo lư. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />Dyơ ngki, máh thới teng rit sang a-lứng nhéq tưh Ti-cuôi Clứng chón si-suô ti-cuôi têq ton a-pít chíl liêh Yang Yê-su, táq i-mo nha-án têq bôn ca-chet Án. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />A-lứng nha-án ớq bôn tu-múh a-mớh, ntro clứng ti-cuôi ton a-pít ta-yứng tớq ngki. Ma dyơ ngki, bar náq ti-cuôi can-nŏ́h tớq, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />khoiq ntêr: “Ti-cuôi ndô khoiq tông: ‘Cư têq lóh dúng sang na Yang Arbang Pilŏ́ng dyơ táq liêh nưm pe i-ngái.’” <verse eid="MAT 26:61" /><verse number="62" style="v" sid="MAT 26:62" />Tư dyơ yôr ta-yứng, thới teng rit sang plốh: Án “Mái lớiq ôi díh mui callong? Máh ti-cuôi ndô ton a-pít chíl liêh mái ar-náq a-mớh?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Ma Yang Yê-su lớiq ôi. Thới teng rit sang tông ada Án: “Co Yang Arbang Pilŏ́ng tu-mống níc, cư yua mái ính mái taq-ntêr dyôn top he chom ngki mái lư la Yang Choi Ta-mống, A-cái Yang Arbang Pilŏ́ng, a-láng tới?” <verse eid="MAT 26:63" /><verse number="64" style="v" sid="MAT 26:64" />Yang Yê-su ôi liêh án: “Lư mái táp tông iki. Lư iki, cư tông dyôn top i-nha chom, náp te hoi ndô, top i-nha hôm A-cái Yang Cơt Ti-cuôi ti-cu pa a-tớm na Án Sút Pưt, a-lứng tớq te máh tu-lúc pilŏ́ng.” <verse eid="MAT 26:64" /><verse number="65" style="v" sid="MAT 26:65" />Chón ngki táp, thới teng rit sang dŏq haq au toiq án, tông: “Án a-craiq! I-mo top he yôl át suô ti-cuôi can-nŏ́h nnáng? Ngki, i-dứh, top i-nha khoiq sáng par-nai a-craiq ngki dyơ. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Top i-nha par-ngíh i-mo?” Dyơ tư ính ôi, nha-án tông: “Án lư piaiq cóq cu-chet.” <verse eid="MAT 26:66" /><verse number="67" style="v" sid="MAT 26:67" />Vít ngki, nha-án cu-chóh tớq mát Án, tính púh Án, dyơ páh Án, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />nha tông: “Ndô Yang Choi Ta-mống, ntêr tang ng-cang dyôn top he táp. Nnáu la ti-cuôi khoiq tính mái?”<verse eid="MAT 26:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Ndóng ngki, Phi-er chón ti-cu tớq ng-cưm pa tiêh, a-lớng mu náq cán ndon sol tớq tar-mán án, tông: “Mái la át mu nơi a-lứng Yê-su, ti-cuôi Ca-li-lê.” <verse eid="MAT 26:69" /><verse number="70" style="v" sid="MAT 26:70" />Ma án ca-lôih chứng mát cứp náq ti-cuôi, idô: “Cư ớq chom mái tông a-mớh.” <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />Tư dyơ ti-caq ngốh tớq ngáh car-rống, mu náq cán sol can-nŏ́h bôn hôm án a-lứng tông ada máh ti-cuôi tớq ngki: “Ti-cuôi ndô át mu nơi a-lớng Yê-su, ti-cuôi Na-sa-ret.” <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />Dyơ án ca-lôih sa a-lớng mui par-nai can-tŏ́h, idô: “Cư lớiq chom ti-cuôi ngki!” <verse eid="MAT 26:72" /><verse number="73" style="v" sid="MAT 26:73" />Ma át mu hoi, máh ti-cuôi cơi ta-yứng tớq ngki, tớq tar-mán, dŏq tông ada Phi-er: “Lư ar-lớih mái ngki át mu nơi a-lớng top nha-án, co díh tam-miêng ntêr te mái táq dyôn mái mpáh tháng.” <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />Ndóng ngki, án ta-bớq pu-pap, a-lứng can-tŏ́h idô: “Cư lớiq chom ti-cuôi ngki,” dyơ ndóng ngki táp, ntruôi ti-cár. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Dyơ Phi-er ayư liêh máh par-nai te Yang Yê-su khoiq tông, idô: “nsuôi lư ntruôi ti-cár, mái ca-lôih cư pe can-tứq.” Dyơ án ngốh nga tiêh, án nhiêm sáng a-ái a-oiq lư.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Dyơ ngki, tớq ang i-láih, nhéq máh thới teng rit sang a-lớng ti-cuôi sút tớq sớu te top nha-án tang-húng si-suô ngê ính chíl liêh Yang Yê-su dŏq ca-chet Án táp. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Cua dyơ chóq Án liêh, nha-án dông Án a-lứng mŏp ada ti-cuôi sút Phi-lat.<verse eid="MAT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Ndóng ngki, vít dyơ Yu-da, ndon cu-liêu Án, chom ar-lớih Án cóq cu-chet, ngki sáng a-nguaq, án cu-liêh liêh pe chít callong práq dyôn máh thới a-riaih teng rit sang nha ti-cuôi sút tớq sớu, <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />tông idô: “Cư khoiq táq luaih co cu-liêu mŏp a-ham ớq luaih.” Ma nha-án ôi: “Callong ngki ớq bôn te top he? Mái bôm chiuq.” <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />A-lứng vít dyơ a-dúh máh práq ngki tớq hóng dúng sang, án ngốh, a-lứng pôq lư yông, án trot ti-cong dyáq. <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />Dyơ ngki, vít dyơ peh te práq ngki, máh thới teng rit tông: “Dŏq práq ndô tớq a-túq dúng sang la lớiq têq co práq ngki tar-náp te a-ham.” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Ma ndóng ta-bớq tang-húng dyơ, nha-án plới tám cu-teq na ti-cuôi thơq man a-déh tớq práq ngki nưm dyôn ar-náq ính tứp máh tu-moi laq. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Co iki, tám cu-teq ngki ngai dŏq la “Cu-teq A-ham” ti-ngôi díh i-ngái ndô. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Iki, ar-náq dŏq tông te tang ng-cang Yê-rê-mi khoiq cơt tar-vớiq, idô: “Nha-án ial pe chít callong práq, tar-náp te ti-cuôi cua a-nát, la ti-cuôi ndon khoiq bôn tar-náp te ntúq a-cái a-con Isa-ra-el, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />a-lứng nha-án khoiq a-vôi práq ngki dŏq plới tám cu-teq na thơq man cu-teq, a-rớq Yang khoiq ca to ada cư.”<verse eid="MAT 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Dyơ ngki, Yang Yê-su ta-yứng chứng mát ti-cuôi sút, dyơ ti-cuôi sút ngki plốh Án, idô: “cŏm lư mái la Puô ti-cuôi Isa-ra-el?” Dyơ Yang Yê-su ôi liêh án: “Mái táp lư tông iki.” <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />A-lứng chón ndóng Án bôn cauq luaih te máh thới teng rit sang nha ti-cuôi sút tớq sớu, Án lớiq ôi liêh callong a-mớh. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Dyơ, Phi-lat plốh Án: “Mái lớiq sáng a-ưi lư nốh nha-án cauq chíl liêh mái?” <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Ma Yang Yê-su lớiq ôi án, díh te mui par-nai la lớiq, tar-lúh ti-cuôi sút ngki sáng dut lư. <verse eid="MAT 27:14" /><verse number="15" style="v" sid="MAT 27:15" />Dyơ ngki, tớq i-ngái cha pêl bui, ti-cuôi sút bôn rit ta-láh dyôn ti-cuôi prái mu náq ti-cuôi tôt ndon nha-án rêh. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Ma, tớq cu-mo ngki, ngai chón crál mu náq ti-cuôi tôt par-hanh lư ngai dŏq la Ba-ra-ba. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Iki, tư dyơ nha-án bôn par-chúng liêh, Phi-lat tông ada nha-án: “Top i-nha ính cư ta-láh nnáu dyôn top i-nha? Ba-ra-ba, a-láng Yê-su, án ndon ngai dŏq la Yang Choi Ta-mống?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Co án dŏq chom ar-lớih nha-án khoiq mŏp Yê-su dyôn án co mít can-nính a-ính. <verse eid="MAT 27:18" /><verse number="19" style="v" sid="MAT 27:19" />Dyơ ngki, tư ndóng án chón ti-cu tớq ntúq tar-sưq, cam-pái na án dŏq yua cơiq par-nai nga án, idô: “Ớq ar-náq a-mớh dyôn mái a-lứng dyôn ti-cuôi ti-nớng ŏ ngki. Co i-ngái ndô, cư sáng crŏ́q lư tớq par-náu mpáu te ti-cuôi ndô.” <verse eid="MAT 27:19" /><verse number="20" style="v" sid="MAT 27:20" />Ma máh thới a-riaih teng rit sang nha máh ti-cuôi sút tớq sớu cha-chuôq ti-cuôi clứng dŏq nha-án yua ta-láh Ba-ra-ba ma ca-chet Yang Yê-su. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Ma dŏq ính ôi liêh, ti-cuôi sút ngki tông ada nha-án: “Top i-nha ính cư ta-láh nnáu te bar náq ti-cuôi ndô dyôn top i-nha?” Dyơ nha-án ôi: “Ba-ra-ba.” <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />Phi-lat tông ada nha-án: “Iki, cư cóq táq i-mo ada Yê-su, án ndon ngai dŏq la Yang Choi Ta-mống?” Nhéq top nha-án ôi: “Án cóq téh díng tớq a-long calláng.” <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />Ma án plốh: “Co ar-náq lớiq ŏ mmo ndon mái táq luaih?” Dyơ, nha-án át tông yứng lư, idô: “Án cóq téh díng tớq a-long calláng.” <verse eid="MAT 27:23" /><verse number="24" style="v" sid="MAT 27:24" />Dyơ ngki, Phi-lat, tư dyơ chom ar-lớih án lớiq têq tar-choi nnáng, ma lư tớq ngki, callong par-chớu chón ính cơt, ndóng yua ial dơq dyơ, án a-rau ati án chứng mát ti-cuôi clứng, tông: “Cư ớq bôn luaih te a-ham na ti-cuôi ndô. Top i-nha ta-léh bôm.” <verse eid="MAT 27:24" /><verse number="25" style="v" sid="MAT 27:25" />A-lứng ndóng ôi liêh, nhéq máh ti-cuôi clứng ôi: “A-ham na án tớq nga top he a-lớng nga a-cái a-cháu top he.” <verse eid="MAT 27:25" /><verse number="26" style="v" sid="MAT 27:26" />Vít ngki, Phi-lat ta-láh Ba-ra-ba ada nha-án, dyơ ndóng khoiq cua ngai prớih Yang Yê-su, Phi-lat yua dông Án dŏq téh díng tớq a-long calláng.<verse eid="MAT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Chón ngki, tư dyơ dông Yang Yê-su mot tớq pốt ti-cuôi sút, máh top líng na ti-cuôi sút dŏq par-chúng liêh chứng mát Án nhéq tưh top líng. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Vít dyơ luaiq au Án, nha-án ta-sứp mui pláh au thor ntứm cu-sáu eng ada Án. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Dyơ táq mui allám car-vang tớq tang-háng dyơ, nha-án ta-pưng tớq plô Án, a-lớng tar-lông tớq ati a-tớm Án, dyơ chóh tar-col chứng mát Án, nha-án ayê tar-ac Án, idô: “Seq cu-cúh Puô ti-cuôi Isa-ra-el!” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Dyơ vít cu-chóh nga Án, nha-án ial tar-lông a-lứng púh tớq plô Án. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Ndóng nha-án ayê tar-ac Án dyơ, nha-án luaiq au thor ngki a-lứng ta-sứp dyôn Án au Án, dyơ a-ngốh Án pôq dŏq téh díng tớq a-long calláng.<verse eid="MAT 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Dyơ ngki, chón ndóng pôq, nha-án hôm mu náq ti-cuôi te Si-ren, nốh Si-môn, ndon nha-án pa-tot dŏq án dual a-long calláng na Yê-su. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Tư dyơ pôq tớq mui ntúq ngai dŏq la Cô-cô-tha, ma ntúq ngki ti-toiq liêh la “Ntúq ng-hang plô,” <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />nha-án dyôn Án ngoiq siêu khoiq car-chúc a-lớng mít a-táng. Tư khoiq iêl cam-máng, Án lớiq ính ngoiq. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Dyơ ngki, tư téh Án tớq a-long calláng, nha-án mpô mu pláh au na Án na ngê tar-séng, <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />a-lứng nha-án kiaq me Án, át ti-cu tớq ngki. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Tớq mpiên plô Án, nha-án téh mui mêng pan na Án, dŏq ta-ran: “Ndô la Yê-su, Puô ti-cuôi Isa-ra-el.” <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Tớq ngki, bar náq ti-cuôi si-veng ngai dŏq téh a-lớng Án, mu náq te pa a-tớm nha mu náq te pa a-viar. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Máh ti-cuôi pôq pha ca-cháng ayê Án, car-ngel plô bôm <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />a-lứng tông: “Mái ndon ta-lóh dúng sang ngki a-lứng táq liêh nưm pe i-ngái, áu choi ta-mống mái bôm loi! Khán mái la A-cái Yang Arbang Pilŏ́ng, ngki siar táp te a-long calláng!” <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />Lư mu chứng iki tưi, máh thới teng rit sang, mu nơi a-lớng top thới sái rit nha máh ti-cuôi sút tớq sớu, ndóng ayê tar-ac Án, khoiq tông: <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“Án dŏq choi ta-mống máh ti-cuôi can-nŏ́h; ma án lớiq têq hôi choi ta-mống án. Án la Puô na Isa-ra-el. Hoi ngki, án cóq siar te a-long calláng, ngki top he lư náp te án. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Án ng-cong ki-nứm te Yang Arbang Pilŏ́ng; hoi ngki me án choi ta-mống án khán Án ính án. Co án khoiq tông idô: ‘Cư la A-cái Yang Arbang Pilŏ́ng.’” <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Ma, lư top si-veng, la máh ti-cuôi ndon ngai téh a-lớng Án, top nha-án át ayê tar-ac Án.<verse eid="MAT 27:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Chón ngki, tớq mát pan-dang tứng, cơt ngiau tớq chuôp díh cruông ti-ngôi díh mát pan-dang viêt. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Dyơ ali mát pan-dang viêt, Yang Yê-su arô mui par-láih yứng, idô: “Ê-li, Ê-li, la-ma sa-bach-tha-ni?” ti-toiq liêh la “Yang Arbang Pilŏ́ng cư ơi, Yang Arbang Pilŏ́ng cư ơi, i-mo Mái táh cư?” <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />Ma dyơ bôn sáng iki, top ti-cuôi ndon ta-yứng ngki taq-ntêr idô: “Án arô Ê-li.” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Chái lư, mu náq ti-cuôi te top nha-án, ta-lúh chô dyơ ial mui cúc nsol, mbơiq ta-lứm pớnh siêu a-dyŏ́q dyơ tian tớq callêh, ngki dyôn Án ngoiq. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Ma máh ti-cuôi can-nŏ́h tông: “Êq par-tê án. Top he me ngki Ê-li lư tớq choi án lớiq.” <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />Iki, vít ngki arô sa mui par-láih yứng, Yang Yê-su ti-ŏ́h tar-ngứh. <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />Nha me ntíh, prới tớq dúng sang cơt tar-haq bar tar-rec te ta-niêng díh ta-dưp, ma cu-teq cơt ca-cưt, a-lứng búl pưt cơt pi-cháh. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Máh ping cu-muiq cơt ta-pốh nhéq a-lứng clứng ti-cuôi na máh ti-cuôi práh ŏ khoiq cu-chet bôn tu-mống liêh. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Ngốh te ping vít callong tu-mống liêh na Án, nha-án khoiq mot tớq vel pưt a-lứng a-páh dyôn clứng ti-cuôi. <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />Chón ngki, tư dyơ hôm ca-cưt cu-teq a-lứng máh ar-náq ndon cơt, ti-cuôi sút mui cu-lám líng a-lớng máh ti-cuôi át kiaq Yang Yê-su mu nơi a-lứng án khoiq sáng a-dáh, tông idô: “Ar-lớih lư, ti-cuôi ndô la A-cái Yang Arbang Pilŏ́ng.” <verse eid="MAT 27:54" /><verse number="55" style="v" sid="MAT 27:55" />Ma bôn a-ưi ti-cuôi cán tớq ngki, me tiêu-liêu te yông, la máh ti-cuôi ndon veng ta-pun Yang Yê-su, chứm chiam Án tớq cruông Ca-li-lê. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Te top nha-án bôn Ma-ri Ma-dơ-len, Ma-ri a-i Ya-cơ a-lớng Yô-sê, a-lứng a-i na máh a-cái conh Sê-ba-dê.<verse eid="MAT 27:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Dyơ ngki, tư khoiq tớq pêl i-bư, mu náq ti-cuôi súc tớq te A-ri-ma-thê, nốh la Yô-sep, ma lư án la ráp cơt ndon rian veng Yang Yê-su. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Dyơ tớq tar-múh Phi-lat, án seq cu-muiq Yang Yê-su. Ndóng ngki, Phi-lat yua mŏp ada án. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Ndóng dŏq ial cu-muiq, Yô-sep som cu-muiq ngki táp tớq prới ki-nhôm práh, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />dyơ dŏq cu-muiq tớq ping tam-me na án táp ma án khoiq var tớq hóng búl. Cua vih mui cúc búl pưt ca-táng ngáh callống ping ngki, án chô. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Dyơ ngki, Ma-ri Ma-dơ-len a-lớng mu náq Ma-ri can-nŏ́h át tớq ngki, ti-cu tar-dáng a-lứng ping.<verse eid="MAT 27:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Dyơ i-ngái ta-tun, la dyơ vít i-ngái A-ngô, máh thới teng rit sang a-lớng máh ti-cuôi Pha-ra-si dŏq par-chúng liêh chứng mát Phi-lat, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />tông idô: “A-vốq ơi, top he ayư liêh ndóng yôl tu-mống, án ndon a-uai ngki khoiq tông: ‘Vít pe i-ngái, cư bôn tu-mống liêh.’ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Co iki, seq yua kiaq dŏq ping dyôn a car-siat díh i-ngái pe. Khán lớiq táq iki, top ndon rian na án tớq dyơ, têq tôiq cu-muiq ngki, dyơ taq-ntêr ada ti-cuôi clứng: ‘Án khoiq bôn tu-mống liêh te cu-chet,’ ngki callong a-uai dyơ ta-tun lư cơt saq ta-niêng te nsuôi.” <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />Iki dyơ Phi-lat tông ada nha-án: “Top i-nha bôn líng kiaq. Áu pôq, cóq kiaq a car-siat a-rớq top i-nha chom.” <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Dyơ tư nha-án pôq, ki-tíh ta tớq búl mu nơi a-lớng líng, nha-án kiaq ping ngki car-siat lư.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Dyơ ngki, vít i-ngái A-ngô, mbơiq sưm tu-rưm i-ngái mui tớq tún chón tớq, Ma-ri Ma-dơ-len a-lứng mu náq Ma-ri can-nŏ́h pôq clơ ping. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Me ngki, mu par-láih ca-cưt cu-teq hớp lư khoiq cơt, co bôn tar-neng na Yang, tư tớq te pilŏ́ng siar dyơ tớq tar-mán, dŏq vih cúc búl dyơ ti-cu mpiên ngki. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Ndóng ngki, ar-maiq na tar-neng ngki cơt mu chứng a-rớq li-laiq, ma au na án clŏq a-rớq pa-rial. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Iki, tớq te callong a-dáh co tar-neng ngki, top líng kiaq yáh ca-dyír dyơ cơt a-rớq ti-cuôi cu-chet. <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />Ma ndóng ính ôi, tar-neng ngki tông ada máh ti-cuôi cán: “Top i-nha êq a-dáh, co cư chom dyơ i-nha suô Yê-su, Án ndon ngai téh díng. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Án lớiq át tớq ndô, co Án khoiq tu-mống liêh dyơ, piaiq a-rớq Án khoiq tông. Tớq tu-dô, áu me ntúq ndon Án khoiq bíq. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Dyơ ngki chái lư pôq, cóq taq-ntêr dyôn top ndon rian Án idô: ‘Án khoiq bôn tu-mống liêh te cu-chet. Dyơ me ntíh, Án chón pôq nsuôi i-nha nga Ca-li-lê. Tớq ngki, i-nha bôn tu-múh Án.’ Me ndô, cư khoiq tông dyôn top i-nha chom dyơ.” <verse eid="MAT 28:7" /><verse number="8" style="v" sid="MAT 28:8" />Dyơ ngki hớp lư ngốh te ping ntơnh a-dáh a-lứng ntơnh sáng bui ơn lư, nha-án ta-lúh chô taq-ntêr ada top ndon rian na Án. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Me ndô, Yang Yê-su tu-múh nha-án, tông: “Bánh tưi i-nha!” Dyơ tớq tar-mán, nha-án kiau dyưng Án a-lớng sang tám Án. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Dyơ ngki, Yang Yê-su tông ada nha-án: “Êq a-dáh. Cóq pôq, taq-ntêr ada em ai na cư dŏq nha-án têq pôq nga Ca-li-lê, a-lứng tớq ngki, nha-án bôn tu-múh cư.”<verse eid="MAT 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Hoi ngki, chón ndóng nha-án pôq na car-na, me ndô, bôn máh ti-cuôi te top líng kiaq, tư dyơ mot tớq vel, dŏq taq-ntêr ada máh thới teng rit sang cứp ar-náq khoiq cơt. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />A-lứng chón dŏq bôn par-chúng mu nơi a-lớng top ti-cuôi sút tớq sớu, tớq ính tang-húng dyơ, nha-án dŏq dyôn top líng máh práq lư a-ưi, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />pa-táp idô: “Cóq ntêr: ‘Dyơ tớq nga i-dáu, top ndon rian na án khoiq tôiq cu-muiq ngki ndóng top he chón bíq.’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />A-lứng khán ar-náq ndô bôn ntêr ada ti-cuôi sút, top he lư tar-tông ada án a-lứng táq dyôn top i-nha vít te diêiq pi-ŏ́q.” <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Iki, cua dyơ ráp práq, top ngki táq a-rớq khoiq dŏq pa-táp. Ar-náq ndô cơt pa-hanh chuôp cruông na ti-cuôi Isa-ra-el, ti-ngôi díh tớq i-ngái ndô.<verse eid="MAT 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Dyơ ngki, mu chít la mui náq ndon rian khoiq pôq tớq Ca-li-lê, nga plô cóh ndon Yang Yê-su khoiq ca to dyôn nha-án. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Dyơ ndóng tu-múh Án, nha-án sang tám Án, ma bôn án ndon yôl ma-mu. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Tư dyơ tớq tar-mán, Yang Yê-su taq-ntêr ada nha-án, idô: “Nhéq nốh chức tớq pilŏ́ng a-lứng tớq cu-teq khoiq dŏq mŏp dyôn cư. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Co iki, i-nha cóq pôq ca to nhéq máh ti-cuôi, táq tíc na dơq dyôn nha-án nhơ nốh A-ám, A-cái a-lớng Yang Ar-vai; <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />ca to nha-án dŏq ca-pol khớm cứp callong ndon cư khoiq pa-táp dyôn i-nha. A-lớng me ndô, cư át mu nơi a-lứng i-nha cứp i-ngái ti-ngôi díh i-ngái talloiq.”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>