  <book code="COL" style="id">EN_PCLT pac_Pacoh_ltr Thu Apr 09 2026 09:32:45 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Colossians</para>
  <para style="toc1">Chớiq A-lang Cô-lô-sê</para>
  <para style="toc2">Cô-lô-sê</para>
  <para style="toc3">Col</para>
  <para style="mt">Cô-lô-sê</para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />Phau-lô, dyưng ati na Yang Choi Ta-mống Yê-su veng can-nính Yang Arbang Pilŏ́ng, a-lứng Ti-mu-thê, ti-cuôi em ai na top he, <verse eid="COL 1:1" /><verse number="2" style="v" sid="COL 1:2" />cơiq dyôn máh top tin a-lứng i-nha ndon ti-nớng tu-pứng tớq Yang Choi Ta-mống tớq Cô-lô-sê. Seq callong choi mat a-lứng callong iên ŏ te Yang Arbang Pilŏ́ng, A-ám a-lứng Yang top he, Yang Choi Ta-mống Yê-su, tớq nga i-nha.<verse eid="COL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />Top he si-ơn Yang Arbang Pilŏ́ng, A-ám na Yang top he, Yang Choi Ta-mống Yê-su, tớq cứp chư cớu seq dyôn i-nha, <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />co khoiq sáng te callong tin na i-nha tớq Yang Choi Ta-mống Yê-su a-lứng te callong ar-moih ndon i-nha bôn ada nhéq náq máh top tin, <verse eid="COL 1:4" /><verse number="5" style="v" sid="COL 1:5" />co te callong ng-cong khoiq ti-ráp dŏq dyôn i-nha tớq máh lưp pilŏ́ng, la par-nai ndon i-nha khoiq sáng ndóng nsuôi te par-nai ntêr na callong piaiq, lư ar-lớih la Par-nai ŏ Yang, <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />la callong chón ính tớq nga top i-nha, ma Par-nai ŏ Yang ngki chón cơt cu-lái a-lứng pưt a-sớr chuôp cruông cu-teq cơt i-mo, ngki mu chứng iki tớq top i-nha, náp te i-ngái i-nha khoiq sáng a-lứng chom a-púh callong choi mat na Yang Arbang Pilŏ́ng tớq callong piaiq, <verse eid="COL 1:6" /><verse number="7" style="v" sid="COL 1:7" />mu chứng a-rớq i-nha khoiq rian te Ê-phap-ra, la yớu ndon ar-toi lư na top he, án la ti-cuôi táq ar-náq ti-nớng lư na Yang Choi Ta-mống tang top he, <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />a-lứng án khoiq a-páh dyôn top he chom callong ar-moih te i-nha tớq Yang Ar-vai.<verse eid="COL 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9" />Co iki, te i-ngái top he sáng iki, top he lớiq a-ngô cớu seq dyôn i-nha a-lứng tar-seq táq dyôn têq i-nha bôn pớnh máng callong chom a-púh can-nính Án tớq cứp callong tu-báiq a-lứng chom ar-lớih te ar-vai, <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />dŏq ti-caq pôq dyôn crái piaiq chứng mát Yang te cứp callong bui can-nính Án, cu-lái tớq máh ar-náq ŏ, cơt pưt a-sớr te callong chom a-cớl Yang Arbang Pilŏ́ng, <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />cơt práih bánh a-lứng bôn rêng tớq te chức ang ưr na Án, dŏq tớq cứp nốh rap chiuq a-lứng ta-nhir ada mít can-nính sáng bui, <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />lư si-ơn A-ám, Án khoiq dyôn i-nha têq chúng tưi te máh mun a-lứng máh top tin te callong ang. <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />Lư Án táp khoiq choi ta-mống top he vít te chức sút na callong ngiau, a-lứng dông top he tớq cruông na A-cái a-moih lư na Án, <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" />te A-cái ngki, top he bôn callong choi ta-mống, callong ta-láh luaih. <verse eid="COL 1:14" /><verse number="15" style="v" sid="COL 1:15" />A-cái ngki la rup na Yang Arbang Pilŏ́ng lớiq têq hôm, Án car-nian nsuôi lư te cứp nốh. <verse eid="COL 1:15" /><verse number="16" style="v" sid="COL 1:16" />Co tớq A-cái, cứp nốh mpiên pilŏ́ng nha tớq pưn cu-teq, nốh têq hôm díh nốh lớiq têq hôm, nhéq khoiq dŏq teng cơt. Ntro lư bôn puô sút, lớiq la chức sút, lớiq nốh chức, lớiq la sút pưt, cứp nốh ngki khoiq teng cơt te A-cái a-lứng co A-cái. <verse eid="COL 1:16" /><verse number="17" style="v" sid="COL 1:17" />A-cái ngki bôn nsuôi cứp nốh, a-lứng cứp nốh yôl níc mu nơi co nhơ A-cái. <verse eid="COL 1:17" /><verse number="18" style="v" sid="COL 1:18" />A-cái ngki la plô ada cháq, na top tin. Lư A-cái ngki la te tôm, Án car-nian nsuôi lư te top máh ti-cuôi cu-chet, dyôn têq A-cái ngki cơt Án ndon sút pưt nhéq cứp nốh. <verse eid="COL 1:18" /><verse number="19" style="v" sid="COL 1:19" />Co Yang Arbang Pilŏ́ng sáng bui dŏq dyôn cứp nốh piaiq ŏ át tớq A-cái, <verse eid="COL 1:19" /><verse number="20" style="v" sid="COL 1:20" />a-lứng co na A-cái dŏq iên ŏ túc nốh mu nơi a-lớng Án, ntro la máh nốh tớq cu-teq, a-láng máh nốh tớq pilŏ́ng, co khoiq dông a-tớq callong iên ŏ te A-cái ngki, nhơ a-ham te a-long calláng na A-cái. <verse eid="COL 1:20" /><verse number="21" style="v" sid="COL 1:21" />Te nsuôi, ndóng i-nha yôl la ti-cuôi i-yốh chom a-lứng la ti-cuôi pi-con tớq par-ngíh, tớq máh ar-náq lớiq ŏ, <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />ma hoi ngki, i-nha khoiq át iên ŏ nhơ callong cu-chet te sac sáiq na A-cái, dŏq dông a-páh i-nha chứng mát Án, práh ŏ, ớq callong tíq, a-lứng ớq callong luaih, <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />nám khán i-nha át níc tớq callong tin, a-rớq riaih cu-chot sru, khớm lư, a-lứng lớiq táh a-tức te callong ng-cong na Par-nai ŏ Yang ndon i-nha khoiq sáng, la Par-nai ŏ Yang ndon khoiq pau tông dyôn cứp nốh pưn pilŏ́ng, co te ngki, cư, Phau-lô, khoiq cơt ti-cuôi tar-choi ar-náq.<verse eid="COL 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />Hoi ngki cư sáng bui hơr tớq máh diêiq a-rức na cư co i-nha, a-lứng na sac sáiq án, cư peh dual ndon tu-púiq te máh callong diêiq a-rức na Yang Choi Ta-mống, co tớq cháq Án, ngki la top tin, <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />co te ngki, cư khoiq cơt ti-cuôi tar-choi ar-náq, mu chứng callong a-nát te Yang Arbang Pilŏ́ng, ma ar-náq ngki khoiq mŏp ada cư co i-nha, dŏq pau ntêr dyôn dyơ par-nai ŏ na Yang Arbang Pilŏ́ng, <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />callong par-nai ŏ ndô khoiq dŏq ca-tốq clôp te máh pang i-nớh a-lứng díh a-ưi tŏ́ng toiq, ma hoi ndô, par-nai ŏ clôp ngki cơt mpáh dyôn máh top tin te Án, <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />ada máh ti-cuôi ndon Yang Arbang Pilŏ́ng ính a-páh i-mo callong súc bôn ang ưr te par-nai ŏ ndô tớq top ti-cuôi tới ti-cuôi Isa-ra-el, ngki la Yang Choi Ta-mống tớq i-nha, callong ng-cong ang ưr. <verse eid="COL 1:27" /><verse number="28" style="v" sid="COL 1:28" />Ngki la Án ndon top he taq-ntêr, ndóng ca-tớih tông cứp náq ti-cuôi, a-lứng ca to cứp náq ti-cuôi te nhéq máh par-nai tu-báiq, dŏq top he têq taq-ntêr cứp náq ti-cuôi cơt pưt a-sớr tớq Yang Choi Ta-mống. <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />La co ar-náq ngki cư diêiq a-rức, ca-tóng níc nhơ rêng te Án dyôn rap táq a-lứng bôn chức át tớq cư.<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />Co cư ính i-nha chom cư bôn ca-tóng táq nhéq tar-ngứh tar-hơ dyôn i-nha, a-lứng dyôn máh top tin tớq Lau-di-sê, nha clứng ti-cuôi can-nŏ́h hơ i-yốh bôn hôm ar-maiq cư tớq sac sáiq, <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />dŏq mít nha-án bôn a-liam, ndóng át mu nơi tớq callong ar-moih, a-lứng têq ti-tuaiq cứp ngê a-yáu te ar-náq ính chom khám ar-lớih táq dyôn cơt a-púh ngê ca-tốq te Yang Arbang Pilŏ́ng, Yang Choi Ta-mống, <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />tớq Án la callong ca-tốq nhéq máh nốh a-yáu callong tu-báiq a-lứng chom a-púh. <verse eid="COL 2:3" /><verse number="4" style="v" sid="COL 2:4" />Cư tông par-nai ndô dŏq ớq nnáu têq pi-lốh i-nha na par-nai iam lam-bŏt. <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />Lư ntro la cư lớiq mpáh tớq sac sáiq, ma cư át a-lứng i-nha tớq mít can-nính, bui hơr a-lứng bôn hôm át vứng ŏ te i-nha, a-lứng rêng te callong tin na i-nha tớq Yang Choi Ta-mống.<verse eid="COL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />Iki, díh ndóng i-nha khoiq ráp sang tám Yang Choi Ta-mống Yê-su, la Yang, ngki cóq ti-caq pôq tớq car-na Án, <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />cóq dáh sru a-lứng a-yứng pang tu-mống tớq Án, a-lứng táq dyôn khớm tớq callong tin mu chứng a-rớq i-nha khoiq dŏq ca to, clưi cliai tớq callong si-ơn.<verse eid="COL 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8" />Cóq mmứng, dáh lơ bôn ti-cuôi ndon cơt ti-cuôi ính cŏp i-nha na máh par-nai a-lứng pi-lốh ớq cơt callong, veng phep rit na ti-cuôi, veng máh ngê tớq pang ndô, ma lớiq veng Yang Choi Ta-mống. <verse eid="COL 2:8" /><verse number="9" style="v" sid="COL 2:9" />Co tớq Án, nhéq cứp nốh te Yang Arbang Pilŏ́ng át tớq sac sáiq cơt ti-cuôi, <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />a-lứng i-nha khoiq táq dyôn cứp tớq Án, Án la plô nhéq cứp nốh a-lứng nốh chức, <verse eid="COL 2:10" /><verse number="11" style="v" sid="COL 2:11" />tớq Án ngki, i-nha khoiq bôn kít te rit kít tới la ati ti-cuôi táq, na ar-náq táh nhéq ngê tiêq, na rit kít na Yang Choi Ta-mống, <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" />co khoiq bôn tứp a-lứng Án tớq rit tíc na dơq, a-lứng tớq Án i-nha khoiq bôn tu-mống liêh nhơ callong tin te chức sút na Yang Arbang Pilŏ́ng, Án táq dyôn Yang Yê-su tu-mống liêh te cu-chet. <verse eid="COL 2:12" /><verse number="13" style="v" sid="COL 2:13" />Co i-nha, chón ndóng cu-chet pít tớq máh ar-náq luaih a-lứng co sac sáiq i-yốh táq rit kít na i-nha, Án khoiq táq dyôn i-nha mu nơi tu-mống a-lứng Án, co khoiq ta-láh cứp callong luaih dyôn top he, <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" />khoiq pu-pít u-ráq dŏq ta-ran te ar-náq chíl liêh top he, ngki la ar-náq par-ual a-lứng top he, a-lứng Án khoiq a-tức u-ráq ngki vít te top he, dyơ téh u-ráq ngki tớq a-long calláng, <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />pu-pít nhéq máh nốh chức a-lứng nốh sút, Án khoiq táq dyôn nha-án ca-cháng ayê ada cứp náq ti-cuôi, ndóng chíl rap nha-án tớq a-long calláng.<verse eid="COL 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16" />Iki, êq dyôn nnáu tíq i-nha te tan-na cha a-lứng te crơng ngoiq, lớiq la tớq chón ndóng na i-ngái cha bui, i-ngái ki-sái ngốh tam-me, a-láng i-ngái A-ngô, <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />ma nốh ngki la a-rớq mol na máh ar-náq ính tớq, ma callong lư la te Yang Choi Ta-mống. <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />Êq dyôn ti-cuôi mmo pi-lốh i-nha pít viang cống tar-náp, ndóng a-páh ính a-siar cháq a-lứng callong sang tám tar-neng yang, ki-nứm te máh nốh nha-án khoiq bôn hôm, dyơ a-sớr cháq bôm lớiq cơt callong co par-ngíh veng sac sáiq na nha-án, <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" />a-lứng lớiq par-teng a-lứng plô, ma co te Án, nhéq cháq cóq bôn máh pal-tot tam-bóng nha can-nhíng bôn cơt ngki par-teng mu nơi; cháq ngki pưt a-sớr a-lứng bánh rêng tớq te Yang Arbang Pilŏ́ng.<verse eid="COL 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />Khán i-nha khoiq cu-chet mu nơi a-lứng Yang Choi Ta-mống, ngốh te máh phep rit na pang ndô, co i-mo ndóng yôl tu-mống tớq cúc cu-teq ndô, i-nha táq veng máh phep rit ngki: <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />“Êq ial, êq cha cam-máng, êq ca-pơiq!” <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />co máh phep rit ngki ma nhéq tưh cơt bôn pít nhéq ndóng ial tớc, tar-veng máh phep rit a-lứng chóng pa-ngốh te thư ti-cuôi? <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />Máh ar-náq ngki, ntro lư dêu ar-mo iên te rit sang chóng teng a-ngốh, a-lứng táq náh nnan a-siar cháq a-lứng táq diêiq a-rức cháq i-nha bôm, ngki ớq bôn par-nai tar-náp mmo dŏq chíl liêh callong ính na sac sáiq.<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />Iki cơt, khán i-nha khoiq bôn tu-mống liêh a-lứng Yang Choi Ta-mống, cóq i-nha suô máh nốh tớq pilŏ́ng, ntúq Yang Choi Ta-mống át ti-cu pa a-tớm Yang Arbang Pilŏ́ng. <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />Cóq ti-tuaiq nga máh nốh át tớq pilŏ́ng, tới máh nốh át tớq cu-teq. <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />Co i-nha khoiq cu-chet, nha callong tu-mống i-nha khoiq dŏq ca-tốq tớq Yang Choi Ta-mống te Yang Arbang Pilŏ́ng. <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />Ndóng Yang Choi Ta-mống, callong tu-mống na i-nha, mpáh, ngki i-nha la mpáh tưi a-lứng Án te ang ưr.<verse eid="COL 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />Co iki, cóq táq a cu-chet máh nốh tớq cu-teq — a-rớq láh par-lưi, ar-náq tang-hang, ar-vaiq ar-coiq, ính táq ar-náq saq, a-lứng ham crơng ntưn, ngki ham crơng ntưn la sang mol rup, <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />co máh nốh ndô ngki callong ính táq na Yang Arbang Pilŏ́ng chón tớq, <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />ndóng nsuôi, i-nha cơi táq iki te máh nốh ngki, ndóng i-nha yôl tu-mống tớq nốh ngki. <verse eid="COL 3:7" /><verse number="8" style="v" sid="COL 3:8" />Ma hoi ngki i-nha cóq táh viang máh nốh ndô — callong a-ính, chái nháih, ính táq, a-craiq a-sáh, nha par-nai mmuaq ngốh te ng-cang i-nha. <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" />Êq taq-ntêr a-uai tar-tuôq bôm, co khoiq táh dyơ ti-cuôi tiêq a-lứng te máh ar-náq ngki nnáng, <verse eid="COL 3:9" /><verse number="10" style="v" sid="COL 3:10" />dyơ i-nha khoiq cơt ti-cuôi tam-me, la ti-cuôi chón piên cơt tam-me te callong chom veng a-rớq ar-maiq Án ndon teng cơt ti-cuôi ngki, <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />tớq ndô ớq bôn ti-cuôi Créc nha ti-cuôi Isa-ra-el, ti-cuôi táq rit kít nha ti-cuôi lớiq táq rit kít, ti-cuôi tu-mống lớiq ŏ, ti-cuôi Si-the, ti-cuôi sol, ti-cuôi lớiq sol, ma Yang Choi Ta-mống sút cứp nốh, a-lứng sút nhéq tưh.<verse eid="COL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12" />Iki, mu chứng ti-cuôi ndon khoiq rêh na Yang Arbang Pilŏ́ng, ti-cuôi práh ŏ a-lứng têq a-moih, cóq ial mít srui-táq, par-tát ŏ, lớiq pu-pưt, lam-bŏt, chiuq ta-nhir, <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" />chiuq ta-nhir ada mu náq nha táh luaih ada mu náq, nám khán ti-cuôi mmo bôn táq luaih a-lứng ti-cuôi can-nŏ́h, a-rớq Yang khoiq ta-láh luaih i-nha i-mo, i-nha la cóq táq iki tưi. <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />Ma clưi máh nốh ngki, cóq bôn mít a-moih, co la callong a-moih a-rớq ntár dŏq chóq mu nơi. <verse eid="COL 3:14" /><verse number="15" style="v" sid="COL 3:15" />Cóq dyôn callong iên ŏ na Yang Choi Ta-mống táq sút tớq mít i-nha, i-nha ngki khoiq bôn arô tớq nga callong iên ŏ ngki cơt mui cháq a-lứng cóq a-páh mít chom si-ơn. <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" />Cóq dyôn par-nai Yang Choi Ta-mống át tớq i-nha dyôn a-khớm, ndóng ca to te nhéq callong tu-báiq, a-liam mu náq na máh cứh ayô, máh alhoiq cứh nha máh alhoiq cứh, cứh ayô te callong si-ơn tớq mít i-nha dyôn Yang Arbang Pilŏ́ng. <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />Cứp ar-náq ndon i-nha táq, ntro na par-nai ntêr a-láng na i-nha tông, cóq táq cứp ar-náq nhơ nốh Yang, Yang Yê-su, co te Án si-ơn Yang Arbang Pilŏ́ng, la A-ám.<verse eid="COL 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />I-nha ndon cam-pái, cóq cam-máng ca-yiêq i-nha, co iki la callong crái piaiq tớq Yang. <verse eid="COL 3:18" /><verse number="19" style="v" sid="COL 3:19" />I-nha ndon ca-yiêq, cóq a-moih cam-pái i-nha, a-lứng êq táq diêiq a-rức ada cam-pái. <verse eid="COL 3:19" /><verse number="20" style="v" sid="COL 3:20" />I-nha ndon a-cái, cóq cam-máng par-nai a-ám a-i i-nha te cứp ar-náq, co ndô la ar-náq bui can-nính Yang. <verse eid="COL 3:20" /><verse number="21" style="v" sid="COL 3:21" />I-nha ndon a-ám, êq tar-ac a-cái a-con i-nha, dŏq nha-án lớiq pê mít can-nính. <verse eid="COL 3:21" /><verse number="22" style="v" sid="COL 3:22" />I-nha ndon ti-cuôi sol, cóq peh par-nai ưlla i-nha te sac sáiq tớq cứp ar-náq, tới nưm cam-máng peh ndóng ưlla tớq a-rớq ti-cuôi ndon báq ial mít ngai can-nŏ́h, ma te mít can-nính ti-nớng tu-pứng dyám náp Yang. <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />Khán i-nha táq mui ar-náq a-mớh, cóq táq nhéq te tar-ngứh tar-hơ mu chứng dyôn Yang ma tới dyôn ti-cuôi can-nŏ́h, <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />co chom ar-lớih i-nha lư bôn ráp cống la mun i-nha tớq te Yang. I-nha chón táq sol dyôn Yang, lư la Yang Choi Ta-mống. <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" />Co ti-cuôi mmo táq ar-náq lớiq ŏ lư ráp liêh cống ndon ti-cuôi ngki khoiq táq ngê lớiq ŏ, a-lứng ớq bôn callong beng liaih.<verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />I-nha ndon cơt ưlla, cóq dông dyôn máh ti-cuôi sol na i-nha ar-náq ti-nớng tu-pứng a-lứng li-arli, co chom ar-lớih i-nha lư bôn mui Ưlla tớq pilŏ́ng.<verse eid="COL 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />Cóq mmín tớq callong cớu seq, cóq ayư ndóng cớu seq te ar-náq ndô na callong si-ơn, <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />a-lứng sŏ́ng mui mít cớu choi ada top he, dŏq Yang Arbang Pilŏ́ng pốh dyôn top he ngáh callống na ar-náq ca to par-nai ŏ yang, têq taq-ntêr ngê ca-tốq te Yang Choi Ta-mống, la co ngê ca-tốq ngki ma cư cơt ngai crál, <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />dyôn cư têq ca to ngê ca-tốq ngki dyôn ar-lớih ar-lêng, a-rớq cư cóq taq-ntêr. <verse eid="COL 4:4" /><verse number="5" style="v" sid="COL 4:5" />Cóq táq pôq tớq callong tu-báiq ada ti-cuôi i-yốh tin, ndóng têq ca to cóq ca to táp. <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />Par-nai taq-ntêr i-nha cóq lư sáng êm, a-lứng báq a-rớq boi mot, dŏq chom callong ngki tar-náp dyôn i-nha i-mo ính ôi crái piaiq ada cứp náq ti-cuôi.<verse eid="COL 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />Cứp ar-náq ndon tớq nga cư, bôn mu náq em ai a-moih lư, mu náq sol ti-nớng tu-pứng, a-lứng mu náq ti-cuôi tar-choi ar-náq dyôn Yang, Ti-chi-cơ a-páh dyôn i-nha chom, <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />án la ti-cuôi ndon cư yua tớq tar-múh i-nha co ar-náq ndô, ngki la dŏq i-nha chom ar-náq te top he, a-lứng dŏq án têq bôn a-liam mít can-nính i-nha, <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" />pôq mu nơi la Ô-nê-sim, em ai ndon ti-nớng tu-pứng a-lứng a-moih lư, án lư tớq te i-nha, nha-án dyôn i-nha chom cứp ar-náq tớq ndô.<verse eid="COL 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="COL 4:10" />A-ri-tac, yớu ndon tôt a-lớng cư, cơiq par-nai a-lang i-nha, a-lứng Mac, a-em na Ba-na-ba (em ai i-nha khoiq ráp par-nai ca to te án dyơ; khán án tớq nga i-nha, ngki pa-sôl ŏ án), <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />mu chứng a-rớq Yê-su, án ngai dŏq la Yuc-tu hơ. Te máh ti-cuôi lư tớq la ti-cuôi khoiq táq rit kít, nha-án la máh yớu tar-choi ngki táp a-lứng cư co cruông na Yang Arbang Pilŏ́ng, nha-án la callong khêr dyôn cư. <verse eid="COL 4:11" /><verse number="12" style="v" sid="COL 4:12" />Ê-phap-ra cơiq par-nai a-lang i-nha, án ngốh te i-nha, án la ti-cuôi sol na Yang Choi Ta-mống Yê-su, ngki nhéq tar-ngứh tar-hơ co i-nha te callong cớu seq, dŏq i-nha têq cơt khớm, pưt a-sớr, a-lứng náp peh te cứp máh ngê na Yang Arbang Pilŏ́ng. <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />Co cư hôm ar-lớih te án, i-mo án khoiq chiuq diêiq a-rức a-ưi lư co i-nha, mu chứng máh top tin tớq Lau-di-sê a-lứng tớq Hi-ê-ra-bô-li. <verse eid="COL 4:13" /><verse number="14" style="v" sid="COL 4:14" />Lu-ca, án ndon thới par-lai a-moih lư, a-lứng Dê-ma, cơiq par-nai a-lang i-nha. <verse eid="COL 4:14" /><verse number="15" style="v" sid="COL 4:15" />Seq cơiq par-nai a-lang top i-nha tớq Lau-di-sê, nha Nim-pha, a-lứng top tin rum tớq dúng na án. <verse eid="COL 4:15" /><verse number="16" style="v" sid="COL 4:16" />Ndóng chớiq a-lang ndô khoiq dŏc dyơ tớq top i-nha, cóq lư ar-lớih ngki chớiq a-lang ndô lư bôn dŏc tớq Top Tin Lau-di-sê, a-lứng ar-lớih lư i-nha lư ính dŏc chớiq a-lang te Lau-di-sê hơ. <verse eid="COL 4:16" /><verse number="17" style="v" sid="COL 4:17" />Seq taq-ntêr ada A-chip: “Cóq me dyôn ar-lớih ar-náq ndon án khoiq ráp te Yang, dŏq án têq táq cua ar-náq ngki.”<verse eid="COL 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18" />Par-nai a-lang ndô co lư ati cư — Phau-lô. Cóq ayư ndóng tớq cóq tôt na cư. Seq callong choi mat át a-lứng i-nha.<verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>