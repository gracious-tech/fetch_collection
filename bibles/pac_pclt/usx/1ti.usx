  <book code="1TI" style="id">EN_PCLT pac_Pacoh_ltr Fri May 22 2026 10:55:29 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">1 Timothy</para>
  <para style="toc1">Chớiq A-lang Ti-mu-thê Mui</para>
  <para style="toc2">Ti-mu-thê Mui</para>
  <para style="toc3">1Ti</para>
  <para style="mt">Ti-mu-thê Mui</para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />Phau-lô, dyưng ati na Yang Choi Ta-mống Yê-su veng táq ar-náq na Yang Arbang Pilŏ́ng, Choi Ta-mống top he, a-lứng na Yang, Yang Choi Ta-mống Yê-su, callong ng-cong na top he, <verse eid="1TI 1:1" /><verse number="2" style="v" sid="1TI 1:2" />cơiq dyôn Ti-mu-thê, a-cái lư tớq callong tin: bôn choi mat, callong sruiq, iên ŏ te Yang Arbang Pilŏ́ng, A-ám a-lứng Yang Choi Ta-mống Yê-su, Yang top he.<verse eid="1TI 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />A-rớq ndóng pôq nga Ma-sa-dôn, cư khoiq yua a-cái át liêh tớq Ê-phê-sô dŏq a-cái têq dyŏq máh ti-cuôi ngki êq ca to ngê can-nŏ́h, <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />a-lứng êq tam-bơq nga máh par-nai nsuar lớiq lư a-lứng te chớiq ta-ran nốh lớiq têq cloiq, máh nốh ngki táq dyôn callong tar-miên, ta-niêng te ar-náq na Yang Arbang Pilŏ́ng, la ar-náq co callong tin. <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />Ma callong lư te ar-náq ndô la callong ar-moih tớq te mít práh ŏ a-lứng par-ngíh ŏ mu nơi a-lớng callong tin lớiq tíq bôm, <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />ma bôn ti-cuôi, co clu car-na, khoiq táh viang dŏq si-suô nga ar-náq ớq cơt tar-náp, <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />ính cơt thới pa-soi rit, ma lớiq chom tới nưm máh par-nai án taq-ntêr ma díh te máh callong án ca to la piaiq.<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />Ma, top he chom dyơ phep rit la ŏ khán ngai táq veng phep rit ngki dyôn crái piaiq, <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />co chom ar-náq ndô, ngki la phep rit lớiq bôn a-ngốh dyôn ti-cuôi ti-nớng tu-pứng, ma dyôn ti-cuôi lớiq peh phep rit a-lứng lớiq cam-máng, ti-cuôi lớiq dyám náp a-lứng luaih lới, ti-cuôi bôn ngê saq a-lớng tông lớiq ŏ, ti-cuôi ca-chet a-ám a-lứng ca-chet a-i, ca-chet ti-cuôi, <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />ti-cuôi tới cam-pái ca-yiêq bíq mu nơi, ti-cuôi ính bôn tar-tuôq, ti-cuôi cŏp táiq ti-cuôi, ti-cuôi báq par-lốh, ti-cuôi taq-ntêr a-uai, a-lứng máh ti-cuôi ndon táq ndái te callong ca to crái piaiq <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />piaiq a-rớq Par-nai ŏ Yang ang ưr na Yang Arbang Pilŏ́ng bôn bún, la ar-náq ndon cư khoiq dŏq mŏp dyôn.<verse eid="1TI 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />Cư lư si-ơn Án dyôn rêng ada cư, Yang Choi Ta-mống Yê-su, Yang top he, co Án khoiq náp cư lư ti-nớng tu-pứng, dyôn cư cơt ti-cuôi tar-choi ar-náq, <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" />ntro ndóng nsuôi cư la ti-cuôi báq a-craiq, táq diêiq a-rức a-lứng háng lư, ma cư khoiq bôn callong sruiq co chón ndóng lớiq chom ar-lớih, cư khoiq táq te ndóng i-yốh náp. <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />Ma, callong choi mat te Yang top he la lư clưi cliai a-lứng callong tin nha callong ar-moih tớq Yang Choi Ta-mống Yê-su.<verse eid="1TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 1:15" />Par-nai ndô la lư piaiq náp a-lứng piaiq ráp ial nhéq, ngki la: “Yang Choi Ta-mống Yê-su khoiq tớq nga cúc cu-teq dŏq choi ti-cuôi bôn luaih” — ma tớq ngki cư la ti-cuôi luaih ntáng lư. <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />Ma, cư bôn callong sruiq co ar-náq ndô, ngki la dŏq Yang Choi Ta-mống Yê-su têq a-páh nhéq te mít chiuq ta-nhir tớq cư, ti-cuôi luaih lới ntáng lư, a-rớq mui ngôl dyôn máh ti-cuôi lư tin te Án dŏq bôn callong tu-mống díh sút pang. <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />Callong dyám náp a-lứng ang ưr tớq te Puô na cứp pang, Yang Arbang Pilŏ́ng nưm mui, lớiq têq cu-chet, yôl níc, ti-ngôi díh sút pang nic-níc. A-men.<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />Ti-mu-thê, a-cái cư, cư mŏp ar-náq ndô dyôn mái, veng máh par-nai tang ng-cang ndóng nsuôi te mái, dŏq ial máh par-nai ngki, dyơ mái têq chíl rap máh ngê saq, <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />ca-dyiq khớm callong tin nha mít práh ŏ, ma bôn ti-cuôi, ca-lôih te ar-náq ngki, khoiq táq dyôn pít callong tin án, <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />te máh ti-cuôi ngki la Hi-mê-nê a-lớng A-lec-san-dơ, la máh ti-cuôi ndon cư khoiq mŏp ada Sa-tan dŏq nha-án têq bôn rian dyơ lớiq pa-mat nnáng.<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />Iki, nsuôi lư, cư pa-táp máh par-nai tar-seq tar-suông, cớu seq, cớu tar-choi, si-ơn cóq a-tớq dyôn cứp náq ti-cuôi, <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />dyôn máh puô a-lứng nhéq máh ti-cuôi ndon bôn chức sút, dŏq top he tu-mống pang tu-mống car-siat nha iên ŏ te cứp callong dyám náp a-lứng át par-tát. <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />Ngki la ar-náq ŏ a-lứng crái piaiq chứng mát Yang Arbang Pilŏ́ng, Choi Ta-mống top he, <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />ngki Án ính cứp náq ti-cuôi bôn choi ta-mống a-lứng pôq nga ntúq chom ar-lớih callong piaiq. <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />Co nưm Yang Arbang Pilŏ́ng nha nưm Án át pan-di Yang Arbang Pilŏ́ng a-lứng thư ti-cuôi — Yang Choi Ta-mống Yê-su, cơt ti-cuôi, <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />Án khoiq mŏp cháq án dŏq cu-chet tang dyôn cứp náq ti-cuôi, ngki la tíc khoiq tớq piaiq i-ngái, <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" />co tíc ngki ma cư khoiq cơt ti-cuôi ntêr par-nai ŏ nha cơt dyưng ati — cư taq-ntêr callong lư te Yang Choi Ta-mống, cư lớiq taq-ntêr a-uai — ca to dyôn ti-cuôi tới Isa-ra-el te callong tin a-lớng callong piaiq.<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />Co iki, cư ính top i-nha át chuôp ntúq cóq cớu seq, pa-yơ ati práh ŏ dyơ lớiq bôn callong sáng uan a-lứng tar-miên, <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" />mu chứng, top i-nha ngai ng-cán cóq táq a-dêu cháq bôm táng tam-pớc car-siat ŏ ndon te mít lớiq cu-hống a-lứng bán ŏ cháq bôm, tới nưm na ar-náq clanh sóc a-lứng dyeng a-láng crơng ngáih, lớiq la tam-pớc ntáng lư práq, <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />ma na ar-náq ŏ lư dyôn i-nha ngai ng-cán la ngin mít can-nính dyám náp Yang Arbang Pilŏ́ng nhơ máh ar-náq ŏ.<verse eid="1TI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 2:11" />Ngai ng-cán ndóng rum rian cóq át ar-ngiac, tớq callong dyám náp nhéq mít can-nính. <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />Ma, cư lớiq dyôn ngai ng-cán ca to lớiq la cơt sút ta-niêng ngai ng-conh, ma cóq át ar-ngiac. <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />Co A-dam khoiq bôn teng cơt nsuôi, dyơ ngki náq Ê-va, <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />a-lứng A-dam lớiq bôn pi-lốh, ma ti-cuôi cán, dyơ khoiq pi-lốh, khoiq pôq nga ntúq táq luaih. <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />Ma, ti-cuôi cán ngki bôn choi ta-mống na ar-náq car-nian a-cái, nám khán nha-án át tớq callong tin, callong ar-moih a-lứng callong práh ŏ, nha mít can-nính crái piaiq.<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />Par-nai ndô la par-nai lư: “Khán nnáu ính cơt ti-cuôi sút tớq top tin, ti-cuôi ngki par-ngíh ính mui ar-náq ŏ.” <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" />Iki, ti-cuôi sút top tin cóq la ti-cuôi ớq bôn callong tíq a-mớh, ca-yiêq na mui cam-pái, chom ti-tuaiq, car-siat ŏ, crái piaiq, chom tu-moi, hôi ca to, <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />êq bol siêu, êq táq tar-luaih, ma cóq khun phep, bui ŏ, êq ham práq, <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />kiaq me ŏ dúng bôm, bôn a-cái a-con náp peh a-lứng nhéq te mít can-nính dyám náp <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />(co khán mu náq ti-cuôi lớiq chom car-na kiaq ŏ dúng bôm, ti-cuôi ngki ính bán kiaq Top Tin na Yang Arbang Pilŏ́ng ngki i-mo têq?), <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />lớiq têq ti-cuôi mbơiq tin táq sút, dáh lơ án a-sớr cháq dyơ án bôn callong tôt a-rớq yang sáq. <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />Ma, ti-cuôi sút tớq top tin ngki cóq bôn par-nai ntêr ŏ te ti-cuôi i-yốh Tin, dŏq ti-cuôi ngki lớiq ar-búc nga callong ayê tar-ac a-lứng lớiq chuôt tam-púc na yang sáq.<verse eid="1TI 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />Mu chứng, máh ti-cuôi cơt plô cóq par-tát ŏ, êq taq-ntêr bar par-nai, êq bol plêc siêu, êq ca-miêr, <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />ca-pol khớm par-nai ca-tốq te callong tin na mít can-nính práh ŏ. <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />Ma, nha-án cóq bôn callong chim a-vai, dyơ vít ngki náq têq nha-án táq ar-náq khán ớq bôn callong tíq.<verse eid="1TI 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 3:11" />Máh cam-pái mu chứng iki, cóq car-siat ŏ, êq taq-ntêr lớiq ŏ, crái piaiq, ti-nớng tu-pứng te cứp ar-náq.<verse eid="1TI 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 3:12" />Máh ti-cuôi tar-choi ar-náq cóq la ca-yiêq nưm mui cam-pái, kiaq me ŏ a-cái a-con a-lứng díh dúng án. <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />Co máh ti-cuôi tar-choi ar-náq hôi bôn liêh dyôn án ntúq iên ŏ a-lứng bôn mít clŏ́q tớq callong tin te Yang Choi Ta-mống Yê-su.<verse eid="1TI 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />Cư ta-ran máh par-nai ndô ada mái, ính tớq a-lang mái lư cláih, <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />ma khán cư dyut tớq, ngki mái chom ính táq i-mo tớq dúng na Yang Arbang Pilŏ́ng, ma ngki la Top Tin na Yang Arbang Pilŏ́ng tu-mống níc, ti-nol a-lớng a-núh cláq na callong piaiq. <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />Par-nai ca-tốq te callong tin par-nai yang ngki lư pưt lư lớiq têq tar-miên, la:</para>
  <para style="q1" vid="1TI 3:16">“Án dŏq a-páh tớq sac sáiq,</para>
  <para style="q1" vid="1TI 3:16">têq ngin ti-nớng ŏ tớq Ar-vai Yang,</para>
  <para style="q1" vid="1TI 3:16">têq bôn hôm co tar-neng,</para>
  <para style="q1" vid="1TI 3:16">têq taq-ntêr dyôn máh ti-cuôi,</para>
  <para style="q1" vid="1TI 3:16">têq náp ial chuôp cruông cu-teq,</para>
  <para style="q1" vid="1TI 3:16">bôn sớr nga pilŏ́ng tớq callong ang ưr.”<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />Ar-vai Yang tông ar-lớih lư idô tớq pang ta-tun, clứng ti-cuôi lư ca-lôih táh callong tin, ma veng máh yang sáq pi-lốh nha par-nai ca to na yang sáq, <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />co callong táq náh nnan na top báq par-lốh, mít can-nính na top ngki a-rớq ta-pat tớq taq rông, <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />dyŏq êq ial cam-pái, yua tán máh tan-na cha ndon Yang Arbang Pilŏ́ng khoiq teng dŏq bôn tớc tớq mít chom ơn dyôn ti-cuôi dyám náp a-lứng chom a-púh callong piaiq. <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />Co cứp nốh na Yang Arbang Pilŏ́ng la ŏ nhéq, a-lứng ớq bôn nốh a-mớh cóq táh ndóng ráp nốh ŏ te mít si-ơn, <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />co tan-na khoiq práh ŏ nhơ par-nai Yang Arbang Pilŏ́ng nha par-nai cớu seq.<verse eid="1TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />Ndóng dŏq máh nốh ngki chứng mát em ai, mái la ti-cuôi táq ar-náq ŏ na Yang Choi Ta-mống Yê-su, dŏq chứm chiam co par-nai na callong tin nha ngê ŏ ma mái khoiq táq veng. <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />Ma êq cam-máng máh par-nai nsuar na top a-yáq iêuq. Ma ŏ lư, cóq rian ada mái chom callong dyám náp, <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />co “callong rian pa-tot cháq bôm ngki tar-náp nưm kéh lư, ma khán rian mít dyám náp ngki tar-náp dyôn cứp ar-náq, co bôn par-nai par-ưq dyôn pang ndô díh pang ta-tun.” <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />Par-nai ngki piaiq dyám náp a-lứng piaiq ráp ial lư ar-lớih, <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />co top he ca-tóng a-lớng tam-pring dyôn ar-náq ndô, co top he dŏq callong ng-cong te Yang Arbang Pilŏ́ng tu-mống níc, Án la Yang Choi Ta-mống na cứp náq ti-cuôi, pưt lư la ndon khoiq tin.<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />Cóq pa-táp a-lớng ca to máh callong ngki. <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />Êq dyôn ngai ayê cháq bánh na mái, ma cóq cơt ngôl dyôn máh top tin, te par-nai ntêr, te callong táq pôq, te callong ar-moih, te callong tin, te callong práh ŏ. <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />Cóq mmín te ar-náq dŏc tám u-ráq, ca-tớih, ca to dyôn díh ndóng cư tớq. <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />Êq clớiq ơn át tớq mái, la ơn khoiq dyôn ada mái na par-nai tang ng-cang, a-lứng te callong dŏq ati na máh ti-cuôi a-riaih.<verse eid="1TI 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 4:15" />Cóq pa-tot rian máh ar-náq ngki, cóq ca-tóng nhéq tar-ngứh tar-hơ, dŏq têq pưt a-sớr na mái cơt ar-lớih ar-lêng dyôn cứp náq ti-cuôi hôm. <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />Cóq me ŏ mít mái bôm a-lứng ngê ca to. Cóq táq níc máh ar-náq ngki, co táq iki mái lư choi ta-mống díh cháq mái bôm a-lớng máh ti-cuôi cam-máng mái.<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />Êq tông láh ada ti-cuôi conh iêuq, ma cóq ca-tớih ca to ti-cuôi ngki a-rớq a-ám, ti-cuôi bánh ngki a-rớq em ai, <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />máh ti-cuôi cán iêuq ngki a-rớq a-i, máh ti-cuôi cán bánh ngki a-rớq ơi a-em, te mít práh ŏ nhéq.<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />Cóq dyám náp máh cán cám mai — máh cán cám mai lư. <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />Ma khán cán cám mai mmo bôn a-cái lớiq la a-cháu, nsuôi lư a-cái a-cháu nha-án cóq rian dŏq dyám náp ti-cuôi mu dúng na án bôm, dyơ a-páh mít chom ơn dyôn máh a-ám a-i ngki, co ndô la ar-náq crái piaiq chứng mát Yang Arbang Pilŏ́ng. <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />Ma, cán cám mai lư nưm tu-mống mu náq án, ngki ng-cong te Yang Arbang Pilŏ́ng dyơ chiuq ta-nhir tớq callong tar-seq a-lứng cớu seq i-dáu i-ngái. <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />Ma ti-cuôi ndon si-suô callong bui ngki khoiq cu-chet, ntro lư yôl tu-mống. <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />A-lứng cóq ca-tớih máh ar-náq ndô, dŏq nha-án têq ớq bôn callong ính tíq. <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />Ma khán ti-cuôi mmo lớiq chứm chiam dyôn em ai, ma lư la ti-cuôi tớq dúng án, ti-cuôi ngki ca-lôih callong tin dyơ cơt ti-cuôi lớiq ŏ hơn ti-cuôi i-yốh tin.<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />Mu náq cán cám mai cóq ta-ran dŏq nốh ngki lớiq ta-dưp tu-pát chít cu-mo, ndon cam-pái na mu náq ca-yiêq, <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />cóq bôn ca lư na máh ar-náq ŏ: án bôn kiaq me a-cái a-con lớiq, án bôn ráp pa-sôl máh tu-moi lớiq, án bôn a-rau dyưng máh top tin lớiq, án bôn tar-choi máh ti-cuôi diêiq a-rức lớiq, án bôn nhéq mít can-nính te cứp ar-náq ŏ lớiq.<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />Ma êq ta-ran nốh tớq chớiq máh cán cám mai yôl bánh, co ndóng ham ính tớq sac sáiq dyơ táh ar-náq te Yang Choi Ta-mống, nha-án ính suô ca-yiêq, <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />ngki ráp callong tôt co nha-án khoiq táh par-nai par-ưq nsuôi lư na án. <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />Ma, nha-án ngki khoiq cơi cơt a-láh, át pôq dúng ndô dúng ntíh, ma tới nưm allám a-láh, ma ính lư ntêr ớq cơt callong a-lứng ính tam-bơq ar-náq te ti-cuôi can-nŏ́h, taq-ntêr máh par-nai nha-án lớiq nai taq-ntêr. <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />Co iki, cư ính top cán cám mai yôl bánh cóq suô ca-yiêq, ca-nian a-cái, kiaq me dúng án, dŏq êq pốh car-na dyôn ti-cuôi ính ta-lóh bôn par-nai tông lớiq ŏ. <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />Co bôn máh ti-cuôi khoiq táh ngê Yang pôq veng Yang sáq dyơ.<verse eid="1TI 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TI 5:16" />Khán cán tớq top tin mmo bôn cán cám mai, cóq tar-choi nha-án, a-lứng êq dyôn Top Tin diêiq a-rức, ma dyôn Top Tin têq tar-choi máh cán cám mai lư.<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />Máh ti-cuôi sút tớq sớu hôi ca to cóq lư bôn dyám náp nhéq mít can-nính, pưt lư la máh ti-cuôi tál tuh te Par-nai Yang nha callong ca to. <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />Co Tám U-ráq Yang tông: “I-nha êq ca-som ng-cang car-rŏ́q chón ndóng án dếq sro,” a-lứng “I-nha táq ar-náq lư ính cống tu-the na i-nha.” <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />Êq náp par-nai ngai tíq chíl liêh mu náq ti-cuôi sút tớq sớu, nám khán nưm biq bar lớiq la pe náq ti-cuôi ca lư. <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />Cóq dyŏq ti-cuôi táq luaih chứng mát cứp náq ti-cuôi dŏq máh ti-cuôi yôl liêh têq a-lứng chom a-dáh. <verse eid="1TI 5:20" /><verse number="21" style="v" sid="1TI 5:21" />Cư pa-táp mái chứng mát Yang Arbang Pilŏ́ng nha Yang Choi Ta-mống Yê-su, a-lứng máh tar-neng khoiq rêh, i-mo mái cóq ca-pol khớm máh par-nai ndô ma lớiq bôn par-ngíh, êq táq nốh a-mớh veng mít can-nính beng liaih.<verse eid="1TI 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1TI 5:22" />Êq hớp dŏq ati tớq nnáu, a-lứng êq mmứng te callong luaih na ti-cuôi can-nŏ́h. Cóq bán ŏ cháq bôm dyôn práh.<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />Mái êq nưm ngoiq dơq sớng, ma cóq ngoiq mu biq siêu nho co roiq na mái a-lớng máh callong a-ái cơi chiuq.<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />Luaih na cứp náq ti-cuôi ngki lư ar-lớih, dông nga ntúq tar-sưq, ma lư bôn máh luaih nưm mpáh vít ndóng ngai sưq. <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />Mu chứng, ngki bôn máh ar-náq ŏ ngki têq a-páh, ma máh ar-náq ndon têq ca-tốq clôp ngki lớiq têq ca-tốq nnáng.<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />Máh ti-cuôi ndon yôl cơt ti-cuôi sol, cóq me ưlla án lư piaiq nhéq mít can-nính dyám náp, dŏq nốh Yang Arbang Pilŏ́ng a-lứng callong ca to lớiq bôn ngai a-craiq. <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />Ma, top ti-cuôi sol bôn máh ti-cuôi ưlla la top tin lớiq têq co te nha-án la em ai ma lớiq dyám náp, ma cóq táq ŏ hơn te ngki loi, co nha-án la ti-cuôi tin a-lứng mái a-moih lư, mái crái tưi tớq ar-náq tar-choi. Mái cóq ca to a-lớng pa-táp máh callong ngki.<verse eid="1TI 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3" />Khán ti-cuôi mmo ca to ndái a-lứng lớiq crái máh par-nai piaiq, la máh par-nai na Yang top he, Yang Choi Ta-mống Yê-su, nha a-lứng ngê te par-nai ŏ yang, <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />ti-cuôi ngki ính lư a-sớr cháq, ớq chom a-púh a-mớh, ma ính lư tar-luaih tớq ar-náq tar-miên nha ton a-pít te par-nai ntêr, te ngki cơt bôn callong ar-ính, lớiq tar-crái, a-craiq, par-ngíh lớiq ŏ, <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />tar-miên, te máh ti-cuôi ndon khoiq rúng tớq mít par-ngíh a-lớng ớq bôn callong crái piaiq, ial te callong dyám náp la car-na ính táq súc bôn. <verse eid="1TI 6:5" /><verse number="6" style="v" sid="1TI 6:6" />Ma callong dyám yang a-lớng te callong sáng bui can-nính la callong súc bôn pưt lư. <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />Co top he ớq bôn dông a-mớh nga cúc cu-teq, iki top he lớiq têq dông bớr a-mớh nnáng. <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />Ma, tư bôn dôi cha, au sứp, top he sáng lư êm te máh crơng ngki. <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />Ma máh ti-cuôi ham súc bôn ngki cơt ar-búc tớq callong saq, a-lứng a-ưi callong lớiq ŏ, ớq tar-náp, la máh callong ngki tar-dông ti-cuôi can-nŏ́h na callong ta-lóh cháq bôm nha cu-chet pít. <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />Co tôm na cứp nốh ar-náq lớiq ŏ la callong ham práq, ma bôn ti-cuôi, co ham nốh ngki, khoiq clu car-na yông te callong tin dyơ táq diêiq a-rức bôm a-lớng a-ưi máng a-nguaq la-bang.<verse eid="1TI 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />Ma mái, ti-cuôi na Yang Arbang Pilŏ́ng ơi, cóq viar yông máh callong ngki, ma tar-veng callong ti-nớng ŏ, náp par-nai yang, tin khớm, callong ar-moih, mít chiuq ta-nhir, khun phep. <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />Cóq car-tóng te ar-náq táq ŏ na callong tin, cóq ca-pol khớm callong tu-mống díh sút pang, la callong ndon mái khoiq dŏq arô tớq a-lứng khoiq taq-ntêr par-nai ŏ chứng mát clứng ti-cuôi hôm. <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" />Cư yua mái chứng mát Yang Arbang Pilŏ́ng, Án dyôn cứp nốh têq tu-mống, a-lứng Yang Choi Ta-mống Yê-su, Án a-ngốh par-nai piaiq ŏ te Bôn-sơ Phi-lat, <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />ma mái cóq peh ial par-nai ca to ndô êq táq a-íh, ớq callong tíq, ti-ngôi i-ngái mpáh na Yang top he, Yang Choi Ta-mống Yê-su, <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />la Án ndon Yang Arbang Pilŏ́ng Sút Pưt piaiq cứh ayô a-lớng nưm mui Puô nhéq tưh puô a-lớng Yang nhéq tưh yang, lư mpáh tớq piaiq i-ngái, <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />nưm mu náq Án táp lớiq hôi cu-chet, át tớq callong ang lớiq têq tớq tar-mán, ngki Án ớq nnáu cơi bôn hôm, a-lứng ớq nnáu têq bôn hôm, seq callong dyám náp a-lứng chức sút díh sút pang cơt nga Án. A-men.<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />Cóq ca-tớih tông ti-cuôi súc tớq pang ndô êq a-sớr cháq, a-lứng êq ng-cong ki-nứm te crơng ntưn lớiq têq toi, ma ng-cong ki-nứm te Yang Arbang Pilŏ́ng, Án dyôn top he cứp nốh cơt clưi cliai dŏq bôn tớc, <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />táq callong ŏ, clưi cliai tớq ar-náq ŏ, bôn mít can-nính pơh, ính lư tar-choi, <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />táq iki pa-chúng dyôn án bôm mui crơng ngáih lư ŏ dyôn callong ính tớq, dŏq nha-án têq kéu khớm callong tu-mống lư.<verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />Ti-mu-thê ơi, mái cóq kiaq a-ŏ nốh khoiq mŏp ada mái, viar te máh par-nai ayê tar-ac lớiq ŏ, a-lứng ar-náq tar-miên nha-án par-ngíh la tu-báiq, <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />ma bôn ti-cuôi, co taq-ntêr iki, khoiq pôq lớiq crái car-na callong tin.</para>
  <para style="p" vid="1TI 6:21">Seq callong choi mat át a-lớng máh top i-nha.<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>