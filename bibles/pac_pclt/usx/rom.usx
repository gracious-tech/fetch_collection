  <book code="ROM" style="id">EN_PCLT pac_Pacoh_ltr Mon Apr 20 2026 15:36:49 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Romans</para>
  <para style="toc1">Chớiq A-lang Rô-ma</para>
  <para style="toc2">Rô-ma</para>
  <para style="toc3">Rom</para>
  <para style="mt">Rô-ma</para>
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />Phau-lô, ti-cuôi táq ar-náq na Yang Choi Ta-mống Yê-su, cơt dyưng ati án khoiq rêh, dŏq mmar co Par-nai ŏ na Yang Arbang Pilŏ́ng, <verse eid="ROM 1:1" /><verse number="2" style="v" sid="ROM 1:2" />la par-nai ndon Án khoiq ưq te nsuôi na máh tang ng-cang na Án tớq Tám U-ráq, <verse eid="ROM 1:2" /><verse number="3" style="v" sid="ROM 1:3" />te A-cái Án — Yê-su ndon car-nian te tŏ́ng toiq na Da-vit cơt mu chứng a-cái ti-cuôi, <verse eid="ROM 1:3" /><verse number="4" style="v" sid="ROM 1:4" />Án lư ar-lớih la A-cái Yang Arbang Pilŏ́ng bôn chức pưt vít callong tu-mống liêh te cu-chet veng Ar-vai Yang práh ŏ, Yang Choi Ta-mống Yê-su, Yang top he, <verse eid="ROM 1:4" /><verse number="5" style="v" sid="ROM 1:5" />ma co Án, top he khoiq ráp callong choi mat a-lứng bôn táq dyưng ati dyôn têq cơt tar-náp te callong tin na nhéq tưh máh ti-cuôi cứp cruông co te nốh Án, <verse eid="ROM 1:5" /><verse number="6" style="v" sid="ROM 1:6" />te máh ti-cuôi ngki i-nha lư la máh ti-cuôi ndon dŏq arô ưlla na Yang Choi Ta-mống Yê-su. <verse eid="ROM 1:6" /><verse number="7" style="v" sid="ROM 1:7" />Cơiq díh nhéq máh ti-cuôi chón át tớq Rô-ma, máh ti-cuôi a-moih lư na Yang Arbang Pilŏ́ng, top ti-cuôi práh ŏ dŏq rêh arô: Callong choi mat tớq nga i-nha a-lứng callong iên ŏ te Yang Arbang Pilŏ́ng, A-ám top he, la te Yang, Choi Ta-mống Yang Yê-su.<verse eid="ROM 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />Nsuôi lư, nhơ Yang Choi Ta-mống Yê-su, cư si-ơn Yang Arbang Pilŏ́ng na cư te nhéq náq i-nha, co callong tin na i-nha khoiq par-hanh chuôp díh cruông cu-teq. <verse eid="ROM 1:8" /><verse number="9" style="v" sid="ROM 1:9" />Co Yang Arbang Pilŏ́ng la ngôl na cư, Án ndon cư táq ar-náq na nhéq mít can-nính cư tớq Par-nai ŏ na A-cái Án, cư lớiq a-ngô te ar-náq ca to dyôn em ai i-mo, <verse eid="ROM 1:9" /><verse number="10" style="v" sid="ROM 1:10" />ndóng nic-níc tar-seq tớq par-nai cớu na cư khán têq hôi, dŏq mot hoi ndô lớiq la ali mmo, cư lư pôq co can-nính na Yang Arbang Pilŏ́ng dŏq pôq nga i-nha. <verse eid="ROM 1:10" /><verse number="11" style="v" sid="ROM 1:11" />Co cư ng-cong níc ính tu-múh i-nha, dŏq cư bôn ca to ada i-nha callong bún na ar-vai ngki, dŏq i-nha têq cơt khớm, <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />ma ar-náq ngki la dŏq cư têq a-liam dyôn i-nha, nhơ callong át tớq cứp náq ti-cuôi, callong tin na díh i-nha a-lứng cư. <verse eid="ROM 1:12" /><verse number="13" style="v" sid="ROM 1:13" />Em ai ơi, cư lớiq ính i-nha i-yốh chom i-mo a-ưi chư cư par-ngíh ính tớq a-nga i-nha (ma cư ớq bôn tớq díh hoi ndô), dŏq cư ngki têq táq cơt cu-lái khoiq táq ada i-nha, mu chứng a-rớq tới máh ti-cuôi cứp cruông can-nŏ́h hơ. <verse eid="ROM 1:13" /><verse number="14" style="v" sid="ROM 1:14" />Cư la ti-cuôi tu díh ti-cuôi Créc a-lứng ti-cuôi ớq callong tu-báiq, díh ti-cuôi tu-báiq nha ti-cuôi a-chơ. <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />Co iki, te par-ngíh cư, lư tel-sél dŏq ính ca to Par-nai ŏ dyôn i-nha, la máh ti-cuôi tớq Rô-ma.<verse eid="ROM 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />Ma cư lớiq a-chiêt te Par-nai ŏ Yang, co ngki la chức sút na Yang Arbang Pilŏ́ng dŏq callong choi ta-mống dyôn ada nhéq máh ti-cuôi tin, dyôn nsuôi lư ada ti-cuôi Isa-ra-el, nha ti-cuôi Créc. <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" />Co callong ti-nớng ŏ na Yang Arbang Pilŏ́ng khoiq tar-piaiq tớq Par-nai ŏ Yang ngki, te callong tin tớq callong tin, a-rớq khoiq dŏq ta-ran idô: “Máh ti-cuôi ti-nớng ŏ lư tu-mống nhơ callong tin.”<verse eid="ROM 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />Co uan lư ada Yang Arbang Pilŏ́ng át tớq pilŏ́ng khoiq a-páh ính táq ada máh ti-cuôi bôn luaih a-lứng lớiq ti-nớng na nha-án, la máh ti-cuôi ca-táng callong piaiq ma táq ar-náq luaih, <verse eid="ROM 1:18" /><verse number="19" style="v" sid="ROM 1:19" />co callong têq chom te Yang Arbang Pilŏ́ng ngki lư ar-lớih tớq top nha-án, co Yang Arbang Pilŏ́ng khoiq a-páh callong ngki dyôn nha-án. <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />Co te ndóng teng cơt pilŏ́ng cu-teq, máh nốh lớiq têq hôm na Án, díh chức sút nha ang ưr díh sút pang na Án, têq bôn hôm ar-lớih, ndóng khoiq chom na máh teng cơt te Án, dŏq dyôn nha-án lớiq têq bôn callong dŏq ính suôn. <verse eid="ROM 1:20" /><verse number="21" style="v" sid="ROM 1:21" />Ngki la co tíc dŏq chom Yang Arbang Pilŏ́ng, nha-án khoiq lớiq sang tám Án la Yang Arbang Pilŏ́ng, a-lứng lớiq si-ơn Án. Ma lư, nha-án khoiq ớq tar-náp tớq máh par-ngíh nha-án, a-lứng mít a-chơ na nha-án khoiq cơt callong ngiau pul viang. <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />Dŏq ngin bôm la tu-báiq, nha-án khoiq ngin bôm táp a-chơ, <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />a-lứng nha-án khoiq piên ang ưr na Yang Arbang Pilŏ́ng yôl níc ndon a-rớq te mol rup na thư ti-cuôi rúng pít, nha a-rớq na a-chếq nnár, pan-nán puan a-dyưng, a-lứng pan-nán pôq na cu-teq.<verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />Iki, Yang Arbang Pilŏ́ng khoiq ca-lôih táh nha-án dyôn máh ar-náq saq na mít nha-án tớq callong saq lư, dŏq cháq nha-án cơt táq lớiq ŏ tớq top nha-án, <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />la máh ti-cuôi khoiq piên callong piaiq te Yang Arbang Pilŏ́ng na callong lớiq ŏ, a-lứng khoiq cứh ayô nha sang tám máh crơng khoiq cơt Án Dŏq Teng, la Án piaiq cứh ayô díh sút pang. A-men.<verse eid="ROM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26" />Co iki, Yang Arbang Pilŏ́ng khoiq ca-lôih nha-án dyôn táq máh ar-náq ính táq, co máh ti-cuôi cán te nha-án khoiq piên ar-náq táq piaiq cơt táq lớiq piaiq, <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />mu chứng, top ngai ng-conh la mu chứng iki, vít dyơ lớiq ính bíq mu nơi a-lứng ngai ng-cán, ma cơt ính bíq mu nơi na nha-án a-lớng tar-tuôq, ndóng conh tar-tuôq conh táq ar-náq saq, dyơ ráp liêh ada nha-án táp tôt, la callong a-nát te ar-náq luaih na nha-án.<verse eid="ROM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28" />La veng a-rớq nha-án khoiq lớiq par-ngíh cóq bôn Yang Arbang Pilŏ́ng táq sút tớq par-ngíh nha-án la ŏ, Yang Arbang Pilŏ́ng khoiq ca-lôih táh nha-án dyôn ngê lớiq sŏ́ng, dŏq táq máh ar-náq ớq crái piaiq, <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />co khoiq pớnh cứp callong lớiq ti-nớng tu-pứng, táq lớiq ŏ, ham crơng, par-ngíh lớiq ŏ, pớnh máh ar-náq na callong i-ôiq, ca-chet ti-cuôi, tar-luaih, par-lốh, u saq, máh par-nai ntêr lớiq ŏ, <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />ton a-pít, a-ính Yang Arbang Pilŏ́ng, ayê, a-sớr cháq, cu-hống, ính lư táq lớiq ŏ, lớiq cam-máng a-ám a-i, <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />cơt a-chơ, lớiq ti-nớng, ưq sớng, ớq bôn mít ar-moih. <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />Ngki la máh ti-cuôi ntro khoiq chom rit práh ŏ na Yang Arbang Pilŏ́ng, khán nnáu luaih máh ar-náq ngki la cóq cu-chet, nha-án lớiq nưm luaih máh ar-náq ngki, ma nha-án yôl pa-chơc dyôn máh ti-cuôi can-nŏ́h luaih tưi.<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />Co iki, ngki ai ơi — khán ti-cuôi mmo báq tíq — mái ớq bôn car-na têq ôi nnáng, co tớq callong a-mớh ndon mái tíq ti-cuôi can-nŏ́h, mái chóng táq luaih bôm; co mái, la ti-cuôi tíq, a-lứng luaih máh ar-náq ngki. <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />Ma top he khoiq chom ar-lớih callong sưq na Yang Arbang Pilŏ́ng lư crái a-lứng piaiq chíl liêh máh ti-cuôi luaih máh ar-náq a-rớq ngki. <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />Ma, ndô mái la ti-cuôi báq tíq máh ti-cuôi luaih máh ar-náq ngki ma mái táp ngki táq máh ar-náq iki, mái par-ngíh te callong ndô, i-mo mái lư vít te callong sưq na Yang Arbang Pilŏ́ng? <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" />A-láng mái ayê callong súc bôn na mít sruiq nha mít chiuq ngai ayê a-lứng ta-nhir níc na Án, co lớiq chom i-mo mít sruiq na Yang Arbang Pilŏ́ng tec a-yông mái tớq callong ngin luaih? <verse eid="ROM 2:4" /><verse number="5" style="v" sid="ROM 2:5" />Ma táq veng níc callong cớng ngan na mái a-lứng mít can-nính lớiq ính ngin luaih, mái chón táq dyôn callong ính táq ada mái tớq i-ngái ính táq a-lứng a-páh te callong tar-sưq na Yang Arbang Pilŏ́ng, <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />lư Án cu-liêh dyôn cứp ti-cuôi veng liêh máh ar-náq táq na ti-cuôi ngki: <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />Mu pa la callong tu-mống díh sút pang dyôn ada máh ti-cuôi si-suô ang ưr a-lứng dyám náp nha tar-náp lớiq têq cu-chet veng callong chiuq ta-nhir na ar-náq ŏ; <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />ma te ngki callong ính táq a-lứng callong nháih lư dyôn ada máh ti-cuôi ính peh nưm callong lớiq piaiq a-lứng ính pu-pít callong ŏ ma ính lư táq callong saq. <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />Callong bap a-lứng a-nguaq át tớq ar-vai na ti-cuôi táq ar-náq saq, na ti-cuôi Isa-ra-el nsuôi lư, náq nga ti-cuôi Créc. <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />Ma ang ưr a-lứng dyám náp nha callong iên ŏ dyôn ada máh ti-cuôi táq ar-náq ŏ, ada ti-cuôi Isa-ra-el nsuôi lư, díh ada ti-cuôi Créc. <verse eid="ROM 2:10" /><verse number="11" style="v" sid="ROM 2:11" />Co lớiq bôn callong beng liaih ma cu-liêh li-arli na Yang Arbang Pilŏ́ng. <verse eid="ROM 2:11" /><verse number="12" style="v" sid="ROM 2:12" />Khán ti-cuôi mmo ma táq luaih veng ngê lớiq bôn phep rit, ngki lư cu-chet pít veng ngê ớq bôn phep rit, nha khán ti-cuôi mmo khoiq táq luaih át tớq phep rit, ngki lư ngai sưq na phep rit. <verse eid="ROM 2:12" /><verse number="13" style="v" sid="ROM 2:13" />Co tới máh ti-cuôi cam-máng phep rit la ti-nớng ŏ chứng mát Yang Arbang Pilŏ́ng, ma máh ti-cuôi táq veng phep rit ngki lư cơt ti-nớng ŏ. <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />Co ndóng máh ti-cuôi tới ti-cuôi Isa-ra-el, la máh ti-cuôi lớiq bôn phep rit, chóng ính táq máh callong na phep rit, ntro lớiq bôn phep rit, nha-án la phep rit ada nha-án bôm, <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />ngki la máh ti-cuôi dŏq hôm máh ar-náq na phep rit khoiq ta-ran tớq mít nha-án, ndóng can-nính nha-án taq-ntêr, a-lứng máh par-ngíh tông luaih lớiq la díh beng liaih tớq top nha-án táp <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />tớq i-ngái ma Yang Arbang Pilŏ́ng lư tar-sưq máh ar-náq clôp ca-tốq te ti-cuôi can-nŏ́h na Yang Choi Ta-mống Yê-su, veng a-rớq Par-nai ŏ Yang na cư.<verse eid="ROM 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17" />Ma khán mái cliau nốh la ti-cuôi Isa-ra-el, ki-nứm te phep rit, pu-pưt tớq Yang Arbang Pilŏ́ng, <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />chom par-ngíh can-nính Án, sŏ́ng mu nơi máh nốh crái lớiq khoiq bôn rian te phep rit, <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />dyơ, mái chóng a-sớr cháq bôm la ti-cuôi a-yông máh ti-cuôi sot, ang dyôn máh ti-cuôi át tớq ntúq ngiau, <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />mái pa-soi top ndon a-chơ, thới pa-soi ti-cuôi ndon i-yốh chom, co khoiq cơt iki na callong chom a-lứng na callong piaiq tớq phep rit, <verse eid="ROM 2:20" /><verse number="21" style="v" sid="ROM 2:21" />co iki, ndô la ti-cuôi pa-soi ti-cuôi can-nŏ́h ntíh, mái lớiq pa-soi cháq mái? Ndô ti-cuôi pa-táp êq ti-tôiq ngki, mái ti-tôiq? <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />Ndô la ti-cuôi ca to lớiq têq láh par-lưi ngki, mái láh par-lưi? Ndô la ti-cuôi a-ính máh rup yang saq ngki, mái tôiq crơng máh pa-rông yang saq? <verse eid="ROM 2:22" /><verse number="23" style="v" sid="ROM 2:23" />Mái pu-pưt cháq la ti-cuôi át tớq phep rit, mái lớiq dyám Yang Arbang Pilŏ́ng na ar-náq táq luaih phep rit? <verse eid="ROM 2:23" /><verse number="24" style="v" sid="ROM 2:24" />Co “nốh Yang Arbang Pilŏ́ng cơt pa-mat tớq máh ti-cuôi tới ti-cuôi Isa-ra-el co te i-nha,” a-rớq par-nai khoiq dŏq ta-ran. <verse eid="ROM 2:24" /><verse number="25" style="v" sid="ROM 2:25" />Lư, ntro rit kít dông a-tớq tar-náp khán mái têq táq veng phep rit, ma khán mái la ti-cuôi táq luaih phep rit, ngki ar-náq rit kít na mái khoiq a-rớq lớiq rit kít. <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />Co iki, khán mu náq ti-cuôi i-yốh táq rit kít náp máh par-táp na phep rit, tới ar-náq i-yốh rit kít na ti-cuôi ngki lư têq náp a-rớq ar-náq khoiq rit kít? <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />A-lứng ndóng táq dyơ phep rit, ti-cuôi i-yốh táq rit kít te cháq án lư sưq mái, la ti-cuôi bôn chưq a-lứng rit kít ndon ti-cuôi táq luaih phep rit. <verse eid="ROM 2:27" /><verse number="28" style="v" sid="ROM 2:28" />Co tới mu náq ti-cuôi nưm te cu-lái tiêh la ti-cuôi Isa-ra-el, a-lứng tới nốh te cu-lái tiêh tớq sac sáiq la táq rit kít, <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" />ma, ti-cuôi Isa-ra-el lư át tớq ntúq clôp, a-lứng táq rit kít na mít can-nính co Ar-vai Yang, tới na chưq maq; ma callong piaiq ayô na ti-cuôi ngki tới te thư ti-cuôi ma la te Yang Arbang Pilŏ́ng.<verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />Iki, tar-náp na ti-cuôi Isa-ra-el la a-mớh? Lớiq la tar-náp na ar-náq rit kít la i-mo? <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />Lư a-ưi te cứp nốh! Ma nsuôi lư, ngki la nha-án khoiq mŏp máh par-nai na Yang Arbang Pilŏ́ng. <verse eid="ROM 3:2" /><verse number="3" style="v" sid="ROM 3:3" />Dŏq táq i-mo khán bôn ti-cuôi ớq bôn callong tin? Tơ la mít lớiq tin na nha-án lư táq dyôn callong ti-nớng tu-pứng na Yang Arbang Pilŏ́ng cơt lớiq tar-náp? <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />Ar-náq ngki lớiq cơt a-mớh. Ma, cóq ayô Yang Arbang Pilŏ́ng la lư piaiq, ma cứp ti-cuôi la ndon par-lốh. A-rớq khoiq dŏq ta-ran idô:</para>
  <para style="q1" vid="ROM 3:4">“Ma ntro i-mo ngki Án lư khoiq a-páh na callong ti-nớng ŏ tớq par-nai tông na Án,</para>
  <para style="q1" vid="ROM 3:4">a-lứng Án lư rap nhéq ndóng Án chiuq ngai sưq.”<verse eid="ROM 3:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="ROM 3:5" />Ma khán callong luaih na top he mpáh callong ti-nớng ŏ na Yang Arbang Pilŏ́ng, top he lư tông i-mo? A-láng Yang Arbang Pilŏ́ng lớiq ti-nớng ndóng tớq callong ính táq na Án? (Cư chón tông a-rớq thư ti-cuôi.) <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />Ar-náq ngki lớiq cơt a-mớh! Co khán iki ngki i-mo Yang Arbang Pilŏ́ng lư sưq cúc cu-teq ndô? <verse eid="ROM 3:6" /><verse number="7" style="v" sid="ROM 3:7" />Ma khán callong ti-nớng tu-pứng na Yang Arbang Pilŏ́ng khoiq táq dyôn ang ưr Án par-hanh lư te ar-náq lớiq ti-nớng na cư, i-mo cư yôl át tar-sưq a-rớq mu náq ti-cuôi luaih? <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />A-lứng lớiq bôn (mu chứng top he cơt ton a-pít a-lứng a-rớq ndon ti-cuôi dáh tông top he ca to iki) “Top he ính táq callong saq, dŏq callong ŏ têq cơt”? — Callong tar-sưq na nha-án la lư piaiq.<verse eid="ROM 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />Ma i-mo? Top he ŏ ta-niêng? Lư lớiq iki. Co top he khoiq tông díh ti-cuôi Isa-ra-el nha ti-cuôi Créc dyơ, nhéq tưh cóq át ta-dưp callong luaih. <verse eid="ROM 3:9" /><verse number="10" style="v" sid="ROM 3:10" />A-rớq khoiq dŏq ta-ran idô:</para>
  <para style="q1" vid="ROM 3:10">“Ớq bôn nnáu ti-nớng ŏ, díh mu náq ti-cuôi la ớq.<verse eid="ROM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ROM 3:11" />Ớq bôn nnáu têq chom.</para>
  <para style="q1" vid="ROM 3:11">Ớq bôn nnáu si-suô Yang Arbang Pilŏ́ng.<verse eid="ROM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12" />Nhéq náq khoiq pôq lớiq crái car-na. Nha-án mu nơi cơt ớq tar-náp.</para>
  <para style="q1" vid="ROM 3:12">Ớq bôn nnáu táq ar-náq ŏ, ti-ngôi ớq bôn mu náq ti-cuôi.”<verse eid="ROM 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13" />“Siêng a-rốq nha-án a-rớq ping cu-muiq khoiq dŏq pốh.</para>
  <para style="q1" vid="ROM 3:13">A-lứng ntaq án, nha-án át ntêr par-nai par-lốh.</para>
  <para style="q1" vid="ROM 3:13">Pih cu-sánh pla tớq pưn ng-cang nha-án,”<verse eid="ROM 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ROM 3:14" />“ng-cang nha-án pớnh máng par-nai chu-chau a-lứng a-táng lư.”<verse eid="ROM 3:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15" />“Ưllang dyưng nha-án ính lư táq hóc a-ham.<verse eid="ROM 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ROM 3:16" />Callong ar-lóh a-lứng diêiq a-rức tớq máh car-na pôq na nha-án.<verse eid="ROM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17" />A-lứng nha-án lớiq chom pôq car-na bui ŏ.”<verse eid="ROM 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ROM 3:18" />“Ớq bôn callong têq a-dáh Yang Arbang Pilŏ́ng chứng mát nha-án.”<verse eid="ROM 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />Ma, top he chom dyơ máh callong a-mớh ndon phep rit pa-rian la tông ada máh ti-cuôi táq veng phep rit, ính dyôn cứp ng-cang êq ta-cang, a-lứng díh cruông cu-teq chiuq callong tar-sưq te Yang Arbang Pilŏ́ng, <verse eid="ROM 3:19" /><verse number="20" style="v" sid="ROM 3:20" />co, chứng mát Án, ớq bôn ti-cuôi mmo têq ayô ti-nớng ŏ te máh ar-náq táq veng phep rit; co chom callong luaih la na phep rit.<verse eid="ROM 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />Ma hoi ndô, callong ti-nớng ŏ na Yang Arbang Pilŏ́ng khoiq dŏq a-páh tới na phep rit, tư bôn taq-ntêr co phep rit a-lứng máh ti-cuôi tang ng-cang, <verse eid="ROM 3:21" /><verse number="22" style="v" sid="ROM 3:22" />ma callong ti-nớng ŏ na Yang Arbang Pilŏ́ng ngki nhơ callong tin te Yang Choi Ta-mống Yê-su dyôn ada máh ti-cuôi tin, co lớiq bôn callong têq tíq mmo. <verse eid="ROM 3:22" /><verse number="23" style="v" sid="ROM 3:23" />Co cứp náq ti-cuôi khoiq bôn luaih a-lứng pít viang ang ưr na Yang Arbang Pilŏ́ng, <verse eid="ROM 3:23" /><verse number="24" style="v" sid="ROM 3:24" />ma lớiq túh cu-liêh công a-mớh tư dŏq tông ti-nớng ŏ co callong choi mat te Án na thái luaih tớq Yang Choi Ta-mống Yê-su, <verse eid="ROM 3:24" /><verse number="25" style="v" sid="ROM 3:25" />Án ndon Yang Arbang Pilŏ́ng khoiq a-nát nsuôi a-rớq crơng mŏp sang thái luaih nhơ callong tin te a-ham Án ngki, dŏq la tíc te callong ti-nớng ŏ na Án, co khoiq táh nhéq máh luaih lới bôn te nsuôi, <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />co mít chiuq ta-nhir na Yang Arbang Pilŏ́ng, dŏq a-páh dyôn callong ti-nớng ŏ na Án tớq pang hoi ndô, dŏq dyôn Án la ti-nớng ŏ a-lứng ngin ti-nớng ŏ dyôn nnáu bôn callong tin te Yang Yê-su.<verse eid="ROM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27" />Khán iki, callong a-sớr cháq át tớq mmo? Án khoiq ng-crớq táh. Co rit mmo? Rit na ar-náq táq lớiq têq? Tới iki! Ma la co rit na callong tin. <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />Co top he par-ngíh mu náq ti-cuôi lư ngin ti-nớng ŏ co callong tin, tới nưm máh ar-náq táq veng phep rit. <verse eid="ROM 3:28" /><verse number="29" style="v" sid="ROM 3:29" />A-láng Yang Arbang Pilŏ́ng nưm la na ti-cuôi Isa-ra-el sớng? Tới ngki la na ti-cuôi tới ti-cuôi Isa-ra-el? Lư, nhéq la na ti-cuôi tới ti-cuôi Isa-ra-el, <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" />lư ar-lớih nưm bôn mui Yang Arbang Pilŏ́ng, la Án lư ti-nớng ŏ ti-cuôi táq rit kít co callong tin, díh ti-cuôi lớiq táq rit kít nhơ callong tin ngki. <verse eid="ROM 3:30" /><verse number="31" style="v" sid="ROM 3:31" />Iki, top he têq táq dyôn phep rit ớq tar-náp na callong tin ngki? Ar-náq ngki lớiq cơt a-mớh. Ma, top he kéu khớm phep rit.<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />Iki, top he tông A-pra-ham, a-chúc a-chiac na top he veng te sac sáiq, khoiq bôn tar-náp a-mớh? <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />Ma khán A-pra-ham khoiq ngin ti-nớng ŏ co ar-náq táq, án têq a-sớr cháq, ma tới la chứng mát Yang Arbang Pilŏ́ng. <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" />Co Tám U-ráq tông a-mớh? “A-pra-ham tin Yang Arbang Pilŏ́ng, a-lứng ar-náq ngki khoiq tông lư ti-nớng ŏ dyôn án.” <verse eid="ROM 4:3" /><verse number="4" style="v" sid="ROM 4:4" />Ma, ti-cuôi mmo táq ar-náq, práq công lớiq têq tông dyôn sớng, ma práq ngki la án táq. <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />Khán ti-cuôi mmo lớiq táq ar-náq, ma tin te Án táq dyôn ti-cuôi ớq ngê cơt ti-nớng ŏ, callong tin na ti-cuôi ngki têq ayô la ti-nớng ŏ. <verse eid="ROM 4:5" /><verse number="6" style="v" sid="ROM 4:6" />Mu chứng a-rớq Da-vit khoiq tông te callong bún na ti-cuôi ndon Yang Arbang Pilŏ́ng náp la ti-nớng ŏ tới co ar-náq táq:<verse eid="ROM 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7" />“Bún dyôn ti-cuôi mmo ndon máh ar-náq luaih nha-án khoiq bôn táh,</para>
  <para style="q1" vid="ROM 4:7">a-lứng máh luaih nha-án khoiq têq pul clôq.<verse eid="ROM 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8" />Bún dyôn ti-cuôi ndon Yang lư ar-lớih khoiq lớiq náp te luaih na nha-án.”<verse eid="ROM 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="ROM 4:9" />Iki, callong bún ndô dyôn ada ti-cuôi táq rit kít, lớiq la ính dyôn ada ti-cuôi lớiq táq rit kít? Co top he tông: “Callong tin ngki khoiq náp la ti-nớng ŏ dyôn A-pra-ham.” <verse eid="ROM 4:9" /><verse number="10" style="v" sid="ROM 4:10" />Iki, callong tin ngki bôn náp cơt i-mo? Ngki ndóng khoiq táq rit kít a-láng ndóng i-yốh táq rit kít? Tới ndóng khoiq táq rit kít, ma lư tớq ndóng i-yốh táq rit kít. <verse eid="ROM 4:10" /><verse number="11" style="v" sid="ROM 4:11" />Án khoiq ráp tíc rit kít táq a-páh na callong ti-nớng ŏ te callong tin, la callong tin tớq ndóng i-yốh táq rit kít, dŏq dyôn án la a-chúc a-chiac na nhéq máh ti-cuôi bôn callong tin ntro i-yốh táq rit kít, tớq nga callong ti-nớng ŏ têq a-páh dyôn máh ti-cuôi ngki; <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />ngki la a-chúc a-chiac na ti-cuôi táq rit kít ada máh ti-cuôi tới nưm tớq te táq rit kít, ma yôl la máh ti-cuôi veng ta-pun lám a-dyưng callong tin na A-pra-ham, a-chúc a-chiac top he, chón ndóng i-yốh táq rit kít.<verse eid="ROM 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13" />Co par-nai ưq dyôn ada A-pra-ham lớiq la ada tŏ́ng toiq na án, ngki la dŏq dyôn ti-cuôi ndon ti-cuôi ưlla cúc cu-teq ndô, tới nhơ phep rit ma la co callong ti-nớng ŏ na callong tin. <verse eid="ROM 4:13" /><verse number="14" style="v" sid="ROM 4:14" />Co khán máh ti-cuôi ưlla tớq te phep rit, callong tin cơt lớiq tar-náp, a-lứng par-nai ưq cơt lớiq pleng. <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />Co phep rit dông a-tớq callong ính táq, ma ntúq mmo ớq bôn phep rit ngki mu chứng ớq bôn callong táq luaih. <verse eid="ROM 4:15" /><verse number="16" style="v" sid="ROM 4:16" />Co ar-náq ngki, la tớq te callong tin, dyôn têq a-rớq na callong choi mat, dŏq par-nai ưq lư ar-lớih dyôn cứp tŏ́ng toiq — tới dyôn ti-cuôi nưm tớq te phep rit sớng, ma la dyôn ti-cuôi ngki tớq te callong tin na A-pra-ham, ma án la a-chúc a-chiac na nhéq náq top he, <verse eid="ROM 4:16" /><verse number="17" style="v" sid="ROM 4:17" />a-rớq khoiq dŏq ta-ran idô: “Cư khoiq dyôn a-cái táq a-ám na cứp ti-cuôi,” át chứng mát Án ndon án tin khớm, Yang Arbang Pilŏ́ng, Án táq ti-cuôi cu-chet bôn tu-mống a-lứng táq máh ar-náq lớiq bôn a-rớq chón bôn; <verse eid="ROM 4:17" /><verse number="18" style="v" sid="ROM 4:18" />ma án la ti-cuôi khoiq náp te callong ng-cong clưi te díh nốh ng-cong, dŏq dyôn án bôn cơt a-ám na cứp ti-cuôi, veng a-rớq par-nai khoiq dŏq tông: “Tŏ́ng toiq na a-cái lư cơt iki.” <verse eid="ROM 4:18" /><verse number="19" style="v" sid="ROM 4:19" />A-lứng ntro lớiq bôn táh a-tức tớq callong tin, án khoiq hôm ar-lớih lư cháq án bôm a-rớq cu-chet dyơ (co bôn ali mui cu-lám cu-mo), a-lứng lớiq rap ca-nian a-cái na Sa-ra. <verse eid="ROM 4:19" /><verse number="20" style="v" sid="ROM 4:20" />Ma te par-nai ưq na Yang Arbang Pilŏ́ng, án khoiq lớiq tám bang par-ngíh te callong i-yốh tin, ma, án khoiq cơt khớm tớq callong tin, ndóng mŏp ang ưr nga Yang Arbang Pilŏ́ng, <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />a-lứng khoiq náp lư ar-lớih ngki nốh a-mớh Án khoiq ưq, Án lư bôn chức sút dŏq táq. <verse eid="ROM 4:21" /><verse number="22" style="v" sid="ROM 4:22" />Co iki “callong tin ngki têq ayô la ti-nớng ŏ ada án”. <verse eid="ROM 4:22" /><verse number="23" style="v" sid="ROM 4:23" />Ma, par-nai khoiq ta-ran idô “callong tin ngki têq ayô la ti-nớng ŏ ada án”, tới nưm co án, <verse eid="ROM 4:23" /><verse number="24" style="v" sid="ROM 4:24" />ma yôl co top he, la dyôn máh ti-cuôi ndon callong tin ngki lư bôn náp la ti-nớng ŏ, la ada máh ti-cuôi tin te Yang khoiq dyôn Yang Yê-su, Yang top he, tu-mống liêh te cu-chet, <verse eid="ROM 4:24" /><verse number="25" style="v" sid="ROM 4:25" />ma Án khoiq mŏp co callong luaih na top he a-lứng khoiq táq dyôn tu-mống liêh co callong ayô ti-nớng ŏ na top he.<verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />Khán iki, co khoiq ngin ti-nớng ŏ te callong tin, top he têq bôn cơt ar-toi a-lớng Yang Arbang Pilŏ́ng nhơ Yang top he, Choi Ta-mống Yê-su, <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />ma te Án ngki, top he co callong tin ngki bôn mot tớq callong choi mat ndô, la ntúq ndon top he ta-yứng khớm át ta-niêng, a-lứng top he sáng bui tớq callong ng-cong te ang ưr na Yang Arbang Pilŏ́ng. <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />Ma lớiq nưm iki sớng, ma top he yôl sáng bui tớq tu-múh diêiq a-rức, co chom ar-lớih diêiq a-rức táq dyôn têq rap chiuq ta-nhir; <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />ma khán rap chiuq ta-nhir ndô ngki bôn ngê tám me, ma ngê tám me ndô ngki bôn callong ng-cong. <verse eid="ROM 5:4" /><verse number="5" style="v" sid="ROM 5:5" />Ma callong ng-cong ngki lớiq táq ớq tar-náp, co callong ar-moih na Yang Arbang Pilŏ́ng khoiq át tớq mít top he nhơ Yang Ar-vai, Án khoiq dyôn ada top he. <verse eid="ROM 5:5" /><verse number="6" style="v" sid="ROM 5:6" />Ma i-yốh nhéq, ndóng top he yôl la máh ti-cuôi thor, dyơ piaiq i-ngái, Yang Choi Ta-mống khoiq cu-chet tang dyôn máh ti-cuôi luaih. <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />Lư diêiq bôn ti-cuôi cơt chiuq cu-chet tang dyôn ti-cuôi ti-nớng ŏ. Ntro lư bôn ti-cuôi ngki dáh cu-chet tang dyôn ti-cuôi ti-nớng ŏ. <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />Ma Yang Arbang Pilŏ́ng a-páh callong a-moih te Án dyôn ada top he, ngki la ndóng top he yôl la ti-cuôi luaih, Yang Choi Ta-mống khoiq cu-chet tang dyôn top he. <verse eid="ROM 5:8" /><verse number="9" style="v" sid="ROM 5:9" />Iki, hoi ndô, ndóng khoiq bôn át ti-nớng ŏ co a-ham Án, top he lư bôn choi ta-mống te callong ính táq a-ưi ta-niêng nhơ Án. <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />Co khán top he, ntro la pi-con, khoiq bôn ar-toi liêh a-lớng Yang Arbang Pilŏ́ng nhơ callong cu-chet na A-cái Án, ngki ndóng khoiq bôn ar-toi liêh dyơ, top he lư a-cán bôn tu-mống co callong tu-mống na Án a-ưi lư loi. <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />Ma tới nưm iki, ma top he cóq bui hơr tớq Yang Arbang Pilŏ́ng co nhơ Yang top he, Yang Choi Ta-mống Yê-su, co nhơ Án, hoi ngki top he khoiq ráp dyơ callong ar-toi.<verse eid="ROM 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />Co ar-náq ngki, a-rớq na mu náq ti-cuôi ndon luaih khoiq tớq nga cúc cu-teq ndô, a-lứng te luaih callong cu-chet, co iki callong cu-chet ngki tôi nga cứp náq ti-cuôi, co te ar-náq ngki ma cứp náq ti-cuôi cơt bôn luaih. <verse eid="ROM 5:12" /><verse number="13" style="v" sid="ROM 5:13" />Co tư tớq pang na phep rit, callong luaih cơt mpáh tớq cúc cu-teq ndô dyơ, ma luaih lớiq têq tông ndóng i-yốh bôn phep rit. <verse eid="ROM 5:13" /><verse number="14" style="v" sid="ROM 5:14" />Ma, callong luaih khoiq át táq te pang A-dam díh pang Môi-se, díh tớq máh ti-cuôi lớiq bôn luaih át cơt mu nơi a-lứng callong luaih na A-dam, ma án la ngôl na Án yua tớq.<verse eid="ROM 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 5:15" />Ma, callong luaih lớiq mu chứng callong choi mat veng a-rớq ngki. Co khán callong luaih na mu náq ti-cuôi a-ưi ti-cuôi khoiq cu-chet, callong choi mat na Yang Arbang Pilŏ́ng, a-lứng tar-náp te callong choi mat na mu náq ti-cuôi, Yang Choi Ta-mống Yê-su, dyôn ada clứng ti-cuôi cơt clưi clưai a-ưi lư loi! <verse eid="ROM 5:15" /><verse number="16" style="v" sid="ROM 5:16" />Callong choi ngki tới a-rớq na mu náq ti-cuôi bôn luaih. Co tam callong tar-sưq te mu náq ti-cuôi ndon mpáh, táq dyôn cơt tôt, ma ngốh te a-ưi callong luaih, callong choi mat táq dyôn callong ayô ti-nớng ŏ. <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />Co khán bôn callong luaih na mu náq ti-cuôi, callong cu-chet khoiq táq sút na mu náq ti-cuôi ngki, máh ti-cuôi bôn ráp clưi clưai na callong choi mat a-lứng na crơng choi dyôn te callong ti-nớng ŏ lư a-cán táq sút a-ưi lư tháng tớq callong tu-mống nhơ mu náq ti-cuôi, Yang Choi Ta-mống Yê-su. <verse eid="ROM 5:17" /><verse number="18" style="v" sid="ROM 5:18" />Khán iki, i-mo te mu náq luaih ma cứp náq ti-cuôi mot tớq callong cu-chet, ngki co mui ar-náq táq ti-nớng ŏ cơt ráp cứp náq ti-cuôi dyôn ayô callong ti-nớng ŏ na callong tu-mống a-rớq ngki. <verse eid="ROM 5:18" /><verse number="19" style="v" sid="ROM 5:19" />Co ntro i-mo te callong luaih na mu náq ti-cuôi, clứng ti-cuôi cơt bôn callong luaih, ngki co te ar-náq cam-máng na mu náq ti-cuôi a-ưi ti-cuôi lư bôn callong ti-nớng ŏ mu chứng ngki. <verse eid="ROM 5:19" /><verse number="20" style="v" sid="ROM 5:20" />Ma, phep rit khoiq táq sút dŏq callong luaih cơt rứh. Ma ntúq mmo callong luaih a-ưi, callong choi mat cơt clưi clưai pi-lư, <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />dyôn cơt callong luaih táq sút tớq callong cu-chet a-rớq i-mo, callong choi mat ngki têq táq sút co callong ti-nớng ŏ a-rớq ndô dŏq bôn callong tu-mống díh sút pang, nhơ Yang Choi Ta-mống Yê-su, Yang top he.<verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />Khán iki, top he ính tông i-mo? Top he ŏ táq níc tớq callong luaih dŏq callong choi mat dyôn clưi clưai? <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />Ar-náq ngki lớiq cơt a-mớh. Top he la ti-cuôi khoiq cu-chet te callong luaih ngki i-mo top he bôn tu-mống tớq ngki? <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />A-láng i-nha lớiq chom ar-lớih khán nnáu khoiq táq tíc na dơq te Yang Choi Ta-mống Yê-su la khoiq ráp tíc na dơq mot tớq callong cu-chet na Án? <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" />Co iki, top he sŏ́ng cu-chet a-lứng Án nhơ táq tíc na dơq mot tớq callong cu-chet, dŏq têq a-rớq Yang Choi Ta-mống nhơ ang ưr na A-ám khoiq bôn tu-mống liêh te cu-chet i-mo, ngki top he lư têq bôn mot tớq callong tu-mống tam-me iki tưi. <verse eid="ROM 6:4" /><verse number="5" style="v" sid="ROM 6:5" />Co khán top he khoiq cơt sŏ́ng a-lứng mu chứng callong cu-chet na Án, lư ar-lớih, top he ngki lư la mu chứng ngki te callong tu-mống liêh na Án; <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />co chom ar-náq ndô, ar-lớih ngê ti-cuôi tiêq na top he khoiq ngai téh díng a-lứng Án, dŏq cháq na callong luaih têq cơt pít, lớiq bôn yua top he táq sol dyôn ngê luaih nnáng. <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />Co nnáu khoiq cu-chet ngki bôn tar-cláh te callong luaih. <verse eid="ROM 6:7" /><verse number="8" style="v" sid="ROM 6:8" />Ma khán top he khoiq cu-chet a-lứng Yang Choi Ta-mống, top he chom ar-lớih he lư tu-mống mu nơi a-lứng Án, <verse eid="ROM 6:8" /><verse number="9" style="v" sid="ROM 6:9" />co chom ar-lớih vít dyơ bôn cơt tu-mống liêh te cu-chet, Yang choi Ta mống lớiq bôn cu-chet nnáng; callong cu-chet lớiq bôn táq sút tớq Án. <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />Co callong cu-chet ndon Án khoiq chiuq, Án khoiq cu-chet tang ada callong luaih mui chư sớng. Ma callong tu-mống ndon Án tu-mống, Án tu-mống dyôn Yang Arbang Pilŏ́ng. <verse eid="ROM 6:10" /><verse number="11" style="v" sid="ROM 6:11" />La mu chứng a-rớq ngki, tam i-nha cóq me i-nha bôm la a-rớq ti-cuôi cu-chet tang ada callong luaih, ma la tu-mống dyôn Yang Arbang Pilŏ́ng tớq Yang Choi Ta-mống Yê-su.<verse eid="ROM 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12" />Iki, êq dŏq callong luaih táq sút tớq cháq têq callong cu-chet na i-nha, dŏq dyơ táq veng máh callong ính na sac sáiq. <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />A-lứng êq mŏp cứp nốh cháq na i-nha dyôn callong luaih a-rớq crơng pla na callong saq. Ma cóq mŏp cháq i-nha dyôn Yang Arbang Pilŏ́ng, a-rớq chón tu-mống te ti-cuôi cu-chet, a-lứng cháq chớn na i-nha dyôn táq ar-náq ti-nớng ŏ dyôn Yang Arbang Pilŏ́ng. <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />Te callong luaih lư lớiq têq táq sút tớq i-nha, co i-nha lớiq át tớq phep rit, ma lư tớq callong choi mat.<verse eid="ROM 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />Ngki i-mo? Top he cóq táq ar-náq saq co top he lớiq át tớq phep rit, ma át tớq callong choi mat? Ar-náq ngki lớiq têq cơt a-mớh. <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />I-nha lớiq chom ar-lớih i-nha mŏp cháq bôm dyôn ar-náq a-mớh a-rớq sol tớq callong peh cam-máng, i-nha cơt sol dyôn ngê ndon i-nha cam-máng — lớiq la na luaih chô tớq callong cu-chet, lớiq la te callong cam-máng cơt táq callong ti-nớng ŏ? <verse eid="ROM 6:16" /><verse number="17" style="v" sid="ROM 6:17" />Ma si-ơn Yang Arbang Pilŏ́ng co i-nha tam la cơt sol na callong luaih, ma i-nha khoiq nhéq te mít can-nính cam-máng a-lứng táq veng na callong piaiq ndon i-nha dŏq ca to. <verse eid="ROM 6:17" /><verse number="18" style="v" sid="ROM 6:18" />Dyơ ndóng bôn tar-cláh te callong luaih, i-nha khoiq bôn cơt sol dyôn callong ti-nớng ŏ. <verse eid="ROM 6:18" /><verse number="19" style="v" sid="ROM 6:19" />Cư tông veng a-rớq ti-cuôi co te ngê thor na sac sáiq i-nha. Co i-mo i-nha khoiq mŏp máh nốh cháq na i-nha a-rớq sol dyôn ar-náq saq a-lứng dyôn callong luaih ndô díh callong luaih can-nŏ́h, ngki hoi ndô, mu chứng iki, i-nha cóq mŏp máh cháq na i-nha a-rớq cơt sol dyôn callong ti-nớng ŏ, têq cơt callong práh ŏ. <verse eid="ROM 6:19" /><verse number="20" style="v" sid="ROM 6:20" />Co ndóng i-nha yôl cơt sol na ngê luaih, i-nha cơi tar-cláh te ngê ti-nớng ŏ. <verse eid="ROM 6:20" /><verse number="21" style="v" sid="ROM 6:21" />Khán iki i-nha khoiq bôn tar-náp a-mớh ndóng ngki te máh nốh ma hoi ndô i-nha bôn sáng a-chiêt? Co cu-lái te máh ar-náq ngki la callong cu-chet. <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />Ma hoi ndô, cua dyơ bôn tar-cláh te callong luaih a-lứng bôn táq sol dyôn Yang Arbang Pilŏ́ng, i-nha bôn cu-lái na i-nha tớq nga callong práh ŏ, ma cu-lái la tu-mống díh sút pang. <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />Co práq cống te callong luaih la cu-chet, ma callong choi mat na Yang Arbang Pilŏ́ng la callong tu-mống díh sút pang tớq Yang Choi Ta-mống Yê-su, Yang top he.<verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />Em ai ơi (co cư chón tông ada máh ti-cuôi chom phep rit), a-láng i-nha lớiq chom ar-lớih phep rit bôn chức sút ta-niêng mu náq ti-cuôi tớq máh mmo dưnh ti-cuôi ngki yôl tu-mống? <verse eid="ROM 7:1" /><verse number="2" style="v" sid="ROM 7:2" />Co ti-cuôi cán bôn ca-yiêq khoiq phep rit dŏq a-nát a-lứng ca-yiêq yôl tu-mống na án, ma khán ca-yiêq cu-chet, ngki án khoiq tar-cláh te phep rit te ndon ca-yiêq ngki. <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />Co iki, chón ndóng ca-yiêq yôl tu-mống, khán án át a-lứng mu náq conh can-nŏ́h, án lư ngai dŏq a-nốh la ti-cuôi láh par-lưi. Ma khán ca-yiêq cu-chet, ngki án bôn tar-cláh te phep rit, án tới la ti-cuôi láh par-lưi ntro át a-lớng ca-yiêq can-nŏ́h. <verse eid="ROM 7:3" /><verse number="4" style="v" sid="ROM 7:4" />Mu chứng iki, ơi em ai na cư, lư i-nha ngki khoiq bôn táq dyôn cu-chet te phep rit nhơ te cháq na Yang Choi Ta-mống, dŏq dyôn i-nha bôn át a-lứng ti-cuôi can-nŏ́h, ngki la a-lứng Án khoiq tu-mống liêh te cu-chet, dyôn têq top he cơt tar-náp ada Yang Arbang Pilŏ́ng. <verse eid="ROM 7:4" /><verse number="5" style="v" sid="ROM 7:5" />Co ndóng top he yôl át tớq sac sáiq, máh ar-náq ính luaih na phep rit át par-ngíh táq tớq sac sáiq na top he dŏq tar-náp dyôn callong cu-chet. <verse eid="ROM 7:5" /><verse number="6" style="v" sid="ROM 7:6" />Ma ndô top he khoiq bôn tar-cláh vít phep rit, co khoiq cu-chet te callong ndon top he tam khoiq ta-chóq, iki top he têq táq ar-náq dyôn cơt tam-me na Ar-vai Yang ma lớiq táq nnáng ar-náq tiêq na phep rit.<verse eid="ROM 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />Iki, top he lư tông i-mo? Phep rit bôn callong luaih? Ar-náq ngki lớiq cơt a-mớh. Ma, cư khoiq lớiq chom luaih khán lớiq me te phep rit. Co cư khoiq lớiq chom luaih ham crơng khán phep rit lớiq ca to: “I-nha êq ham crơng.” <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />Ma callong luaih, khoiq ial viang na callong pa-táp, khoiq a-páh liêh máh callong saq tớq cư. Co ớq bôn phep rit callong luaih cu-chet. <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />Ma, te nsuôi, cư cơi tu-mống i-yốh bôn phep rit, ma ndóng bôn callong pa-táp tớq, callong luaih khoiq cu-chet, <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />ma cư ngki cu-chet. A-lứng callong pa-táp la callong tớq nga callong tu-mống, án khoiq bôn hôm a-rớq la callong cu-chet tớq nga cư. <verse eid="ROM 7:10" /><verse number="11" style="v" sid="ROM 7:11" />Co khoiq ial viang te callong pa-táp, callong luaih khoiq pi-lốh cư, a-lứng te ngki, khoiq ca-chet cư. <verse eid="ROM 7:11" /><verse number="12" style="v" sid="ROM 7:12" />Iki, phep rit la práh ŏ, callong pa-táp lư la práh ŏ, ti-nớng tu-pứng, a-lứng piaiq ŏ.<verse eid="ROM 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 7:13" />Iki, callong ŏ khoiq cơt callong cu-chet dyôn cư? Ar-náq ngki lớiq têq cơt a-mớh. Ma, dŏq na callong ŏ, callong luaih têq dŏq a-páh la callong luaih, ngki la callong tớq liêh callong cu-chet tớq cư, dyôn têq na callong pa-táp, callong luaih a-cán cơt lớiq ŏ lư loi. <verse eid="ROM 7:13" /><verse number="14" style="v" sid="ROM 7:14" />Co top he chom ar-lớih phep rit la ar-vai, ma lư cháq cư la sac sáiq, a-rớq khoiq táiq táq sol dyôn callong luaih. <verse eid="ROM 7:14" /><verse number="15" style="v" sid="ROM 7:15" />Co cư lớiq chom ar-náq cư táq ngki. Co tới cư táq callong ndon cư ính. Ma cư táq callong ndon cư a-ính. <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />Ma khán cư táq callong ndon i-nha lớiq ính, ma cư ính ada phep rit idô la ti-nớng ŏ. <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />Ma hoi ndô lư cư lớiq ính táq ar-náq ngki nnáng, ndon la callong luaih chón tớq cháq cư. <verse eid="ROM 7:17" /><verse number="18" style="v" sid="ROM 7:18" />Co cư chom ar-lớih callong ŏ lớiq át tớq cư, ngki lư tớq sac sáiq cư. Co par-ngíh ính callong ŏ cóq át a-páh tớq cháq cư, ma táq callong ŏ ngki ớq. <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />Co callong práh ŏ ndon cư ính cư lớiq táq, ma callong saq ndon cư lớiq ính, cư táq ngki. <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />Ma khán cư táq callong ndon i-nha lớiq ính, tới lư cư táq callong ngki nnáng, ma la callong luaih át níc tớq cư. <verse eid="ROM 7:20" /><verse number="21" style="v" sid="ROM 7:21" />Dyơ, cư hôm ar-lớih rit ndô tớq cư, mu chứng tớq ti-cuôi sáng ính táq ar-náq ŏ ndô, ngki la callong saq yôl át a-páh tớq cư. <verse eid="ROM 7:21" /><verse number="22" style="v" sid="ROM 7:22" />Co cư sáng bui te phep rit na Yang Arbang Pilŏ́ng veng ti-cuôi pa callúng. <verse eid="ROM 7:22" /><verse number="23" style="v" sid="ROM 7:23" />Ma cư bôn hôm mui rit can-nŏ́h tớq máh cháq i-nha chíl liêh rit te par-ngíh cư a-lứng pa-tot cư na rit na callong luaih, la rit chón yôl át tớq máh nốh cháq na cư. <verse eid="ROM 7:23" /><verse number="24" style="v" sid="ROM 7:24" />Cư la mu náq ti-cuôi bap lư! Nnáu lư choi cư vít cháq na callong cu-chet ndô? <verse eid="ROM 7:24" /><verse number="25" style="v" sid="ROM 7:25" />Ơn lư Yang Arbang Pilŏ́ng nhơ Yang Choi Ta-mống Yê-su, Yang top he! Co iki dyơ, tam ada par-ngíh, lư cư táq veng phep rit na Yang Arbang Pilŏ́ng, ma ada sac sáiq ngki dyôn ada rit na callong luaih.<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />Co iki, hoi ndô lớiq bôn callong tar-sưq mmo nnáng dyôn máh ti-cuôi át tớq Yang Choi Ta-mống Yê-su. <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />Co rit Ar-vai Yang na callong tu-mống tớq Yang Choi Ta-mống Yê-su khoiq ta-láh cư vít rit na callong luaih a-lứng callong cu-chet. <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />Co te ar-náq lớiq têq táq na phep rit, tớq ar-náq án khoiq iêuq thor sac sáiq, Yang Arbang Pilŏ́ng, ndóng yua lư A-cái Án tớq te mu chứng a-rớq sac sáiq luaih a-lứng co bôn callong luaih, Án khoiq sưq callong luaih tớq sac sáiq, <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />dŏq máh ar-náq ti-nớng ŏ na phep rit khoiq tar-vớiq tớq top he, la máh ti-cuôi lớiq pôq veng sac sáiq ma veng Ar-vai Yang. <verse eid="ROM 8:4" /><verse number="5" style="v" sid="ROM 8:5" />Co máh ti-cuôi tu-mống veng sac sáiq ngki par-ngíh nga máh ar-náq tớq sac sáiq, ma máh ti-cuôi veng Ar-vai Yang nga máh ar-náq na Ar-vai Yang. <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />Co par-ngíh na sac sáiq la callong cu-chet, ma par-ngíh te Ar-vai Yang la callong tu-mống a-lứng iên ŏ; <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />ngki la co par-ngíh te sac sáiq ính chíl ada Yang Arbang Pilŏ́ng, co sac sáiq lớiq ính táq veng phep rit na Yang Arbang Pilŏ́ng, co sac sáiq lớiq rap táq. <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />Ma máh ti-cuôi tu-mống veng sac sáiq ngki lớiq têq táq bui can-nính Yang Arbang Pilŏ́ng. <verse eid="ROM 8:8" /><verse number="9" style="v" sid="ROM 8:9" />Ma, i-nha lớiq át tớq sac sáiq, ma át tớq Ar-vai Yang, khán Ar-vai Yang na Yang Arbang Pilŏ́ng lư át tớq i-nha. Ma khán nnáu ớq bôn Ar-vai Yang na Yang Choi Ta-mống, ti-cuôi ngki tới na Án. <verse eid="ROM 8:9" /><verse number="10" style="v" sid="ROM 8:10" />Ma, khán Yang Choi Ta-mống át tớq i-nha, ntro cháq lư cu-chet co bôn callong luaih, ma Ar-vai Yang lư tu-mống co bôn ti-nớng ŏ. <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" />Ma khán Ar-vai na Án khoiq dyôn Yang Yê-su tu-mống liêh te cu-chet át tớq i-nha, Án khoiq dyôn Yang Choi Ta-mống Yê-su tu-mống liêh te cu-chet a-lứng lư dyôn callong tu-mống ada cháq cu-chet na i-nha, na Ar-vai Án át tớq i-nha.<verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />Khán iki, em ai ơi, top he tới la ti-cuôi tu ada sac sáiq dŏq tu-mống veng sac sáiq. <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />Co khán i-nha tu-mống veng sac sáiq, i-nha lư cóq cu-chet, ma khán nhơ Ar-vai Yang, i-nha táq cu-chet máh ar-náq na sac sáiq, ngki i-nha lư tu-mống. <verse eid="ROM 8:13" /><verse number="14" style="v" sid="ROM 8:14" />Co khán nnáu bôn a-yông co Ar-vai na Yang Arbang Pilŏ́ng, máh ti-cuôi ngki la a-cái na Yang Arbang Pilŏ́ng. <verse eid="ROM 8:14" /><verse number="15" style="v" sid="ROM 8:15" />Co i-nha khoiq lớiq ráp ar-vai te ar-náq sol dŏq liêh dyôn nga callong callaq, ma i-nha khoiq ráp ial Ar-vai Yang na chức sút na a-cái, te ngki top he arô: “A-ba, A-ám!” <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />Lư Ar-vai Yang táq ngôl ada par-ngíh top he ar-lớih top he la a-cái a-con Yang Arbang Pilŏ́ng. <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />Ma Khán la a-cái a-con, ngki la ti-cuôi chúng tưi mun: mu pa la máh ti-cuôi chúng mun na Yang Arbang Pilŏ́ng, mu pa loi la máh ti-cuôi chúng tưi mun a-lứng Yang Choi Ta-mống — khán top he lư chiuq diêiq a-rức a-lứng Án dŏq top he bôn ang ưr a-lứng Án.<verse eid="ROM 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />Co cư par-ngíh idô máh callong diêiq a-rức át tớq pang hoi ndô lớiq bôn tar-náp a-lứng callong ang ưr tar-mán ính a-páh dyôn top he. <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />Bôn callong ng-cong án dŏq teng cứp nốh chón át ng-cong têq mpáh na a-cái a-con Yang Arbang Pilŏ́ng. <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" />Co máh nốh khoiq bôn chiuq ta-nhir te ar-náq i-yốh ŏ, lớiq bôn chong cơt sớng, ma la co Án khoiq teng nha-án têq rứh, nhơ te callong ng-cong <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />ar-lớih lư cứp nốh lư bôn tar-cláh te ar-náq sol na callong rúng cáiq dŏq mot callong iên ŏ tớq ang ưr na a-cái a-con Yang Arbang Pilŏ́ng. <verse eid="ROM 8:21" /><verse number="22" style="v" sid="ROM 8:22" />Co top he chom dyơ nhéq cứp nốh diêiq a-rức mu chứng a-rớq cán ndon chón ính car-nian díh i-ngái ndô. <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" />Ma, tới nưm iki sớng, ma top he mu chứng ngki, ntro bôn cu-lái tôm lư na Ar-vai Yang — lư top he ngki chiuq a-rức tớq mít, ndóng át ng-cong chức sút a-cái, callong choi ta-mống cháq na top he. <verse eid="ROM 8:23" /><verse number="24" style="v" sid="ROM 8:24" />Co top he khoiq bôn tu-mống tớq callong ng-cong lư ar-lớih. Ma ng-cong khán têq bôn hôm ngki tới la ng-cong. Co bôn nnáu ng-cong te callong ndon án bôn hôm? <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />Ma khán top he ng-cong te callong he i-yốh hôm, top he át ca-yôn níc te callong chiuq ta-nhir.<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />Ma veng mu chứng a-rớq ngki, Ar-vai Yang lư choi te callong iêuq thor na top he. Co top he lớiq chom callong ndon top he ính cớu seq a-rớq he cóq táq, ma lư Ar-vai Yang cớu tang ada máh siêng át cu-cloiq lớiq têq táq ntêr na par-nai. <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />Ma Án chom mít ti-cuôi chom par-ngíh na Ar-vai Yang la i-mo, co Án cớu tang piaiq can-nính Yang Arbang Pilŏ́ng dyôn máh top tin. <verse eid="ROM 8:27" /><verse number="28" style="v" sid="ROM 8:28" />Ma, top he chom dyơ Yang Arbang Pilŏ́ng pa-chúng liêh máh ar-náq mu nơi dŏq tớq nga callong ŏ dyôn máh ti-cuôi a-moih Yang Arbang Pilŏ́ng, la dyôn máh ti-cuôi têq bôn callong arô veng par-ngíh na Án. <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />Co máh ti-cuôi ndon Án khoiq chom nsuôi, Án lư khoiq dŏq a-nát mu chứng a-rớq mol rup na A-cái Án, dyôn têq A-cái ngki cơt a-cái pông díh top i-nha. <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />Ma, máh ti-cuôi ndon Án khoiq a-nát, ngki máh ti-cuôi ngki Án lư khoiq arô. A-lứng máh ti-cuôi ndon Án khoiq arô, ngki máh ti-cuôi ngki Án lư khoiq ngin ti-nớng ŏ. Ma máh ti-cuôi ndon Án khoiq ngin ti-nớng ŏ, ngki máh ti-cuôi ngki Án lư khoiq táq dyôn ang ưr.<verse eid="ROM 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />Iki, top he ính tông i-mo te máh ar-náq ndô? Khán Yang Arbang Pilŏ́ng tang mát dyôn top he, nnáu ính táq top he? <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" />Án lư la Yang ndon lớiq bôn lô A-cái án, ma khoiq dyôn A-cái ngki cu-chet tang nhéq náq top he, ngki co a-mớh ma Án lớiq dyôn cứp nốh a-lứng A-cái ngki dyôn top he? <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />Nnáu ính cauq luaih chíl liêh máh ti-cuôi dŏq rêh na Yang Arbang Pilŏ́ng? Yang Arbang Pilŏ́ng la Án ayô ti-nớng ŏ. <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />Nnáu la ti-cuôi táq tôt? Yang Choi Ta-mống Yê-su la Yang khoiq cu-chet — ma hơn te ngki loi, ndóng táq dyôn tu-mống liêh, Án ngki díh át pa ati a-tớm na Yang Arbang Pilŏ́ng — a-lứng Án chón cớu tang dyôn top he. <verse eid="ROM 8:34" /><verse number="35" style="v" sid="ROM 8:35" />Nnáu têq pa-yáh top he te callong a-moih na Yang Choi Ta-mống? Túh cát, diêiq a-rức, chiuq ngai táq, pi-nhaih tar-riat, át mu ra-rat, tu-múh cróq, lớiq la ngai tráh tớq dau? <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />A-rớq par-nai dŏq ta-ran, idô:</para>
  <para style="q1" vid="ROM 8:36">“Co Án, top he chiuq ngai ca-chet cứp i-ngái.</para>
  <para style="q1" vid="ROM 8:36">Top he ngai me a-rớq cưu dyôn ada ngai ca-chet cha sáiq.”<verse eid="ROM 8:36" /></para>
  <para style="b" />
  <para style="m">
    <verse number="37" style="v" sid="ROM 8:37" />Ma, te máh ar-náq ngki, top he bôn chíl rap co nhơ Yang a-moih he. <verse eid="ROM 8:37" /><verse number="38" style="v" sid="ROM 8:38" />Co cư têq rap dŏq idô lớiq bôn callong cu-chet, lớiq la callong tu-mống, lớiq bôn máh tar-neng, lớiq la ti-cuôi sút, a-láng máh ar-náq hoi ndô, lớiq la máh callong ính tớq, lớiq bôn chức sút, <verse eid="ROM 8:38" /><verse number="39" style="v" sid="ROM 8:39" />lớiq la chứng a-yống, a-láng chứng sru, lư lớiq bôn máh nốh teng cơt can-nŏ́h hơ, lư têq pa-yáh top he vít te callong a-moih na Yang Arbang Pilŏ́ng, la callong át tớq Yang Choi Ta-mống Yê-su, Yang top he.<verse eid="ROM 8:39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />Cư tông callong lư tớq Yang Choi Ta-mống. Cư lớiq ntêr a-uai — mít can-nính cư a-páh dyôn cư tớq Yang Ar-vai — <verse eid="ROM 9:1" /><verse number="2" style="v" sid="ROM 9:2" />i-mo ada cư, bôn callong a-nguaq pưt lư a-lứng ráh a-riaq lớiq ngiah tớq mít cư. <verse eid="ROM 9:2" /><verse number="3" style="v" sid="ROM 9:3" />Co cư par-ngíh lư cư cơt chau a-nôi, par-táh te Yang Choi Ta-mống co te em ai cư, la máh ti-cuôi te tŏ́ng toiq na cư veng sac sáiq; <verse eid="ROM 9:3" /><verse number="4" style="v" sid="ROM 9:4" />lư nha-án la ti-cuôi Isa-ra-el, ma máh nốh ưlla te nha-án la cơt a-cái, ang ưr, máh car-hŏt, ar-náq dyôn ada phep rit, callong sang tám, a-lứng máh par-nai ưq; <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />nha-án ngốh te top a-chúc a-chiac, a-lứng Yang Choi Ta-mống ngốh te nha-án — (ngki la veng sac sáiq) — Án la Yang práh ŏ clưi nhéq te can-nŏ́h, Yang Arbang Pilŏ́ng piaiq lư ayô ti-ngôi díh sút pang. A-men.<verse eid="ROM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />Ma lớiq bôn tông te par-nai na Yang Arbang Pilŏ́ng khoiq pít tar-náp. Co lớiq bôn cứp náq máh ti-cuôi ngốh te Isa-ra-el, ngki la ti-cuôi Isa-ra-el. <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />A-lứng lớiq bôn nhéq a-cái a-mon la tŏ́ng toiq na A-pra-ham. Ma la, “Co I-sac, tŏ́ng toiq na a-cái lư bôn arô nốh.” <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />Ngki la a-cái a-con veng sac sáiq, máh ti-cuôi ngki tới la máh a-cái na Yang Arbang Pilŏ́ng. Ma, a-cái a-con na par-nai ưq ngki bôn nsuar a-rớq tŏ́ng toiq. <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />Co ndô la par-nai par-ưq: “Tớq i-ngái ndô, Cư lư tớq, a-lứng lư bôn mu náq a-cái conh dyôn ada Sa-ra.” <verse eid="ROM 9:9" /><verse number="10" style="v" sid="ROM 9:10" />Ma tới nưm iki sớng, ma Rê-bê-ca mu chứng iki ndóng bôn cháq iki co mu náq ti-cuôi, la I-sac, a-chúc a-chiac na top he — <verse eid="ROM 9:10" /><verse number="11" style="v" sid="ROM 9:11" />co te ndóng a-cái i-yốh bôn car-nian, a-lứng i-yốh táq callong ŏ lớiq la callong saq mmo, táq dyôn mít can-nính na Yang Arbang Pilŏ́ng veng callong dŏq rêh na Án têq kéu khớm, <verse eid="ROM 9:11" /><verse number="12" style="v" sid="ROM 9:12" />tới te ar-náq táq, ma la co Án rêh arô — callong khoiq dyôn ada án cóq chom, ngki la: “Án ndon pưt lư táq sol dyôn án ndon két.” <verse eid="ROM 9:12" /><verse number="13" style="v" sid="ROM 9:13" />Mu chứng a-rớq callong khoiq ta-ran: “Cư a-moih Ya-côp, ma Cư a-ính Ê-sáu.”<verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />Iki, top he ính tông i-mo? Dêu lớiq bôn callong ớq tar-náp te Yang Arbang Pilŏ́ng? Ar-náq ngki lớiq bôn cơt iki. <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />Co Án tông ada Môi-se, idô: “Cư lư sruiq-táq ada cứp náq ti-cuôi ndon Cư lư sruiq-táq, a-lứng Cư lư a-moih cứp náq ti-cuôi ndon Cư ính a-moih.” <verse eid="ROM 9:15" /><verse number="16" style="v" sid="ROM 9:16" />Iki khán lớiq bôn co ti-cuôi mmo par-ngíh ính ma lớiq bôn co ti-cuôi mmo suô tu-dô suô tu-ki, ma lư nhơ Yang Arbang Pilŏ́ng, Án a-páh callong a-moih. <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />Co Tám U-ráq tông te Pha-ra-ôn idô: “Co lư ar-náq ndô Cư khoiq a-sớr mái táp, dŏq na mái Cư bôn a-páh chức sút na Cư, a-lứng táq i-mo dyôn nốh Cư têq bôn ca to chuôp cruông cu-teq.” <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />Iki dyơ, Án a-páh mít sruiq-táq ada ti-cuôi mmo Án ính, ma Án táq cớng mít ti-cuôi mmo Án ính.<verse eid="ROM 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19" />Dáh lơ i-nha ính plốh Cư: “Ngki, i-mo Án yôl tíq luaih? Co nnáu ính ca-táng par-ngíh na Án ính?” <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" />Ơ ti-cuôi ngki, lư ar-lớih ngki mái la nnáu ma dáh tông iki ada Yang Arbang Pilŏ́ng? A-láng nốh dŏq man cơt lư tông ada ti-cuôi khoiq man cơt rớp cư: “I-mo mái dŏq man rớp cư cơt a-rớq idô”? <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />A-láng ti-cuôi mám man lớiq bôn sút tớq cu-teq triêq, dŏq man a-déh te nga mui cúc cu-teq, tam crơng ndô dyôn ada ar-náq tar-náp lư, ma nốh ngki dyôn ada ar-náq lớiq tar-náp? <verse eid="ROM 9:21" /><verse number="22" style="v" sid="ROM 9:22" />Ma khán Yang Arbang Pilŏ́ng, co ính a-páh callong ính táq na Án a-lứng a-páh chức sút na Án, khoiq chiuq ót te callong ta-nhir pưt lư dyôn ada máh beng a-déh dyôn ada callong ính táq, khoiq dŏq suan dyôn callong pu-pít; <verse eid="ROM 9:22" /><verse number="23" style="v" sid="ROM 9:23" />a-lứng dŏq Án têq bôn a-páh callong súc bôn na ang ưr Án te máh beng a-déh dyôn ada callong sruiq-táq ma Án khoiq suan dŏq dyôn callong ang ưr — <verse eid="ROM 9:23" /><verse number="24" style="v" sid="ROM 9:24" />ngki díh top he la máh ti-cuôi ndon Án khoiq rêh arô, tới nưm te ti-cuôi Isa-ra-el, ma díh te top ti-cuôi tới ti-cuôi Isa-ra-el, <verse eid="ROM 9:24" /><verse number="25" style="v" sid="ROM 9:25" />A-rớq Án khoiq tông tớq u-ráq Hô-siê:</para>
  <para style="q1" vid="ROM 9:25">“Cư lư arô ti-cuôi tới prái bau Cư, ‘ti-cuôi Cư’,</para>
  <para style="q1" vid="ROM 9:25">a-lứng ti-cuôi lớiq bôn a-moih ‘ti-cuôi par-láng lư.’<verse eid="ROM 9:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ROM 9:26" />A-lứng ar-náq lư bôn tớq ntúq ndon par-nai khoiq dŏq pa-táp ada nha-án: ‘Top i-nha tới prái Cư’;</para>
  <para style="q1" vid="ROM 9:26">lư ntúq ngki, nha-án lư bôn a-nốh la ‘máh a-cái conh na Yang Arbang Pilŏ́ng tu-mống níc.’”<verse eid="ROM 9:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ROM 9:27" />Ma Ê-sai tông te ti-cuôi Isa-ra-el:</para>
  <para style="q1" vid="ROM 9:27">“Ntro máh a-cái a-con na ti-cuôi Isa-ra-el têq la a-rớq chuah dơq ving ca-vang,</para>
  <para style="q1" vid="ROM 9:27">ma nưm biq náq yôl liêh lư bôn choi ta-mống,<verse eid="ROM 9:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ROM 9:28" />co Yang lư táq tar-vớiq par-nai Án tớq cu-teq,</para>
  <para style="q1" vid="ROM 9:28">dyôn nhéq a-lứng chái a-dứh.”<verse eid="ROM 9:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="ROM 9:29" />A-lứng a-rớq Ê-sai khoiq tông nsuôi:</para>
  <para style="q1" vid="ROM 9:29">“Khán Yang na top sút khoiq lớiq ca-dyiq liêh dyôn top he mui tŏ́ng toiq,</para>
  <para style="q1" vid="ROM 9:29">ngki lư top he khoiq cơt a-rớq vel Sô-dôm,</para>
  <para style="q1" vid="ROM 9:29">a-lứng ar-lớih lư khoiq bôn táq dyôn a-rớq vel Cô-mô-rơ.”<verse eid="ROM 9:29" /></para>
  <para style="b" />
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30" />Iki, top he lư tông i-mo? Ngki la máh ti-cuôi tới ti-cuôi Isa-ra-el, máh ti-cuôi lớiq veng ta-pun callong ti-nớng ŏ, ngki khoiq bôn callong ti-nớng ŏ, ma callong ti-nớng ŏ ngki co callong tin. <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />Ma ti-cuôi Isa-ra-el, ndóng veng ta-pun phep rit na callong ti-nớng ŏ, ngki khoiq lớiq crái tớq phep rit ngki. <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />Co i-mo? Ngki la co ớq bôn callong tin, ma a-rớq te ar-náq táq. Nha-án khoiq ki-dúh tớq cúc búl na callong ca-táng, <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" />a-rớq khoiq dŏq ta-ran:</para>
  <para style="q1" vid="ROM 9:33">“Áu me ndô, Cư dŏq ntúq Si-ôn mui cúc búl na callong ca-táng a-lứng cúc búl te ar-náq táq luaih,</para>
  <para style="q1" vid="ROM 9:33">ti-cuôi mmo tin tớq búl ngki lư lớiq pít callong ng-cong.”<verse eid="ROM 9:33" /></para>
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />Em ai ơi, callong sáng bui tớq mít cư a-lứng par-nai cớu seq na cư ada Yang Arbang Pilŏ́ng tang dyôn nha-án dŏq callong choi ta-mống. <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />Co cư táq ngôl dyôn nha-án idô nha-án bôn mít tel-sél ada Yang Arbang Pilŏ́ng, ma lớiq veng callong chom ar-lớih. <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />Co lớiq chom callong ti-nớng ŏ na Yang Arbang Pilŏ́ng, a-lứng ca-tóng rêng dŏq táq callong ti-nớng ŏ na ngê bôm, nha-án lớiq veng ngê ti-nớng ŏ na Yang Arbang Pilŏ́ng. <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />Co Yang Choi Ta-mống la callong táq dyôn cứp na phep rit dŏq tớq callong ti-nớng ŏ dyôn cứp náq ti-cuôi bôn mít tin. <verse eid="ROM 10:4" /><verse number="5" style="v" sid="ROM 10:5" />Co Môi-se ta-ran te callong ti-nớng ŏ tớq te phep rit, idô: “Ti-cuôi mmo táq veng máh par-nai ndô, ti-cuôi ngki nhơ ngki bôn tu-mống.” <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />Ma callong ti-nớng ŏ te callong tin tông idô: “Êq par-ngíh tớq mít bôm: ‘Nnáu têq sớr nga pilŏ́ng?’ (par-ngíh la, têq pôq cớiq Yang Choi Ta-mống siar); <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />lớiq la: ‘Nnáu têq siar nga ta-dưp ntúq cu-chet?’” (par-ngíh la, têq dông Yang Choi Ta-mống yôr te ntúq cu-chet.) <verse eid="ROM 10:7" /><verse number="8" style="v" sid="ROM 10:8" />Ma, callong ngki tông i-mo? “Par-nai át tu-mán a-cái, tớq ng-cang a-cái a-lứng tớq mít a-cái.”</para>
  <para style="p" vid="ROM 10:8">Ngki la par-nai callong tin ndon top he ca to. <verse eid="ROM 10:8" /><verse number="9" style="v" sid="ROM 10:9" />Co khán i-nha ngin Yê-su la Yang na ng-cang i-nha, a-lứng i-nha náp tớq mít i-nha idô Yang Arbang Pilŏ́ng khoiq dyôn Án tu-mống liêh te ntúq cu-chet, i-nha lư bôn ta-mống. <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />Ma nnáu co bôn mít tin ngki bôn callong ti-nớng ŏ, ma nnáu co ng-cang ngin ngki bôn callong choi ta-mống. <verse eid="ROM 10:10" /><verse number="11" style="v" sid="ROM 10:11" />Co Tám U-ráq Yang tông: “Máh ti-cuôi tin te Án lư lớiq pít callong ng-cong.” <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />Ma lớiq bôn ndái a-mớh te ti-cuôi Isa-ra-el nha ti-cuôi Créc; co nưm mui Án la Yang na cứp náq ti-cuôi, a-ưi bún ada nhéq máh ti-cuôi arô seq te Án. <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />Co “cứp náq ti-cuôi, ngki la máh ti-cuôi khoiq arô seq nốh Yang, lư bôn tu-mống.” <verse eid="ROM 10:13" /><verse number="14" style="v" sid="ROM 10:14" />Khán iki, na car-na mmo nha-án têq cớu seq nga Yang ndon nha-án i-yốh tin? Dyơ táq i-mo nha-án têq tin Yang ndon nha-án i-yốh sáng? Ma táq i-mo nha-án têq sáng ndóng ớq bôn ti-cuôi ca to? <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" />Ma máh ti-cuôi ngki ca to i-mo khán nha-án lớiq bôn ngai yua? A-rớq par-nai khoiq dŏq ta-ran, idô: “Ưllang dyưng na máh ti-cuôi pau ntêr par-nai yang lư ŏ chom i-mo ính tông nnáng!”<verse eid="ROM 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 10:16" />Ma, tới cứp náq khoiq sáng veng Par-nai ŏ Yang. Co Ê-sai tông: “Yang ơi, nnáu khoiq peh par-nai ca to na top he?” <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />Dyơ ngki, callong tin tớq te ar-náq ndon sáng, ma ar-náq sáng ngki tớq te par-nai na Yang Choi Ta-mống. <verse eid="ROM 10:17" /><verse number="18" style="v" sid="ROM 10:18" />Ma, cư seq plốh: “A-láng la nha-án khoiq ớq bôn sáng?” Ma lư ar-lớih,</para>
  <para style="q" vid="ROM 10:18">“Cang na máh ti-cuôi ngki khoiq dông a-tớq pláh cruông cu-teq,</para>
  <para style="q" vid="ROM 10:18">a-lứng par-nai na nha-án tớq máh ntúq talloiq na pilŏ́ng cu-teq.”<verse eid="ROM 10:18" /></para>
  <para style="b" />
  <para style="m">
    <verse number="19" style="v" sid="ROM 10:19" />Ma, cư seq plốh: “A-láng la ti-cuôi Isa-ra-el khoiq lớiq chom?” Nsuôi lư, Môi-se tông:</para>
  <para style="q1" vid="ROM 10:19">“Lư Cư táq dyôn máh ti-cuôi a-ính co ti-cuôi tới la mui top ti-cuôi,</para>
  <para style="q1" vid="ROM 10:19">Cư lư táq dyôn top ti-cuôi sáng uan na mu náq ti-cuôi ớq callong chom a-mớh.”<verse eid="ROM 10:19" /></para>
  <para style="b" />
  <para style="m">
    <verse number="20" style="v" sid="ROM 10:20" />Dyơ Ê-sai lư clŏ́q lư a-lứng án tông:</para>
  <para style="q1" vid="ROM 10:20">“Cư khoiq bôn tu-múh co máh ti-cuôi lớiq suô Cư,</para>
  <para style="q1" vid="ROM 10:20">Cư khoiq a-páh dyôn máh ti-cuôi lớiq suô cớu seq te Cư.”<verse eid="ROM 10:20" /></para>
  <para style="b" />
  <para style="m">
    <verse number="21" style="v" sid="ROM 10:21" />Ma a-lứng prái Isa-ra-el Án tông:</para>
  <para style="q1" vid="ROM 10:21">“Nhéq múh i-ngái Cư pa-yơ ati cư níc a-nga mui top ti-cuôi lớiq peh a-lứng táng chíl.”<verse eid="ROM 10:21" /></para>
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />Iki cư seq plốh: A-láng Yang Arbang Pilŏ́ng khoiq táh prái Án? Ar-náq ngki lớiq cơt a-mớh. Co cháq cư mu chứng la ti-cuôi Isa-ra-el, te tŏ́ng toiq A-pra-ham, ưlla na ti-cuôi Bên-ya-min. <verse eid="ROM 11:1" /><verse number="2" style="v" sid="ROM 11:2" />Yang Arbang Pilŏ́ng khoiq lớiq táh prái Án, la prái Án khoiq chom nsuôi. A-láng i-nha lớiq chom Par-nai Yang tông a-mớh te Ê-li, ndóng án cauq luaih ada Yang Arbang Pilŏ́ng chíl liêh ti-cuôi Isa-ra-el? <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" />“Yang Ơi, nha-án khoiq ca-chet máh tang ng-cang I-nha, nha-án khoiq ta-lóh pa-rông sang I-nha, lư nưm mu náq cư a-cái yôl bôn tu-mống, a-lứng nha-án chón át suô ính ca-chet a-cái.” <verse eid="ROM 11:3" /><verse number="4" style="v" sid="ROM 11:4" />Ma par-nai tar-plốh tông ada Ê-li la i-mo? “Cư khoiq dŏq a-mar ada Cư tu-pul ngin náq ti-cuôi conh, la máh ti-cuôi khoiq lớiq chóh tar-col sang yang Ba-al.” <verse eid="ROM 11:4" /><verse number="5" style="v" sid="ROM 11:5" />Iki mu chứng a-rớq ngki tớq pang hoi ndô, ma yôl mu biq yôl liêh a-rớq án khoiq rêh dŏq choi mát. <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />Ma khán te callong choi mát, ngki lớiq bôn co ar-náq táq nnáng. Khán ớq, callong choi mát lớiq têq tông la án choi mát. <verse eid="ROM 11:6" /><verse number="7" style="v" sid="ROM 11:7" />Ngki i-mo? Callong ndon prái Isa-ra-el si suô, prái ngki khoiq lớiq têq bôn ngki, ma ti-cuôi mmo bôn rêh ngki têq bôn, ma ti-cuôi lớiq tin mít nha-án cơt cớng lư, <verse eid="ROM 11:7" /><verse number="8" style="v" sid="ROM 11:8" />a-rớq par-nai khoiq dŏq ta-ran: “Yang Arbang Pilŏ́ng khoiq dyôn ada nha-án mít can-nính lớiq a-púh, mát ớq hôm, cu-tor lớiq sáng, ti-ngôi díh i-ngái ndô.” <verse eid="ROM 11:8" /><verse number="9" style="v" sid="ROM 11:9" />A-lứng Da-vit tông idô:</para>
  <para style="q1" vid="ROM 11:9">“Cóq dŏq ntúq tar-cu na nha-án cơt mben, tam-púc, cúc búl ki-dúh a-dyưng,</para>
  <para style="q1" vid="ROM 11:9">a-lứng callong cu-liêh dơq dyôn ada nha-án.<verse eid="ROM 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10" />Cóq dŏq mát nha-án cơt sot dŏq ớq hôm,</para>
  <para style="q1" vid="ROM 11:10">a-lứng cóq táq cróng nha-án cơt tar-cốn lớng.”<verse eid="ROM 11:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />Iki, cư seq plốh: “A-láng nha-án khoiq ki-dúh dyơ prứp?” Ar-náq ngki lớiq têq cơt a-mớh. Ma, co callong luaih na nha-án, callong choi ta-mống cơt nga ti-cuôi can-nŏ́h, dŏq táq dyôn nha-án sáng uan. <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />Ma, khán callong luaih na nha-án ma têq súc bôn tớq pang ndô, a-lứng callong ớq bôn na nha-án lư súc bôn na ti-cuôi tới ti-cuôi Isa-ra-el, callong cứp nhéq na nha-án lư a-cán súc bôn clưi clưai chom máh mmo? <verse eid="ROM 11:12" /><verse number="13" style="v" sid="ROM 11:13" />Chón ndô, cư seq tông ada i-nha la top ti-cuôi tới ti-cuôi Isa-ra-el. Iki, a-cán lư co cháq cư la dyưng ati dyôn top ti-cuôi tới ti-cuôi Isa-ra-el, cư ial táq tar-náp te ar-náq na cư, <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />ntro car-na mmo, cư têq táq dyôn ti-cuôi prái veng sac sáiq na cư i-ôiq a-lứng têq choi ta-mống top ti-cuôi te top nha-án. <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />Co khán callong ca-lôih na nha-án callong par-chen tớq pang ndô, ar-náq nha-án ráp lư i-mo khán tới la callong tu-mống ngốh te callong cu-chet? <verse eid="ROM 11:15" /><verse number="16" style="v" sid="ROM 11:16" />Ma, khán beng mi tôm lư dŏq mmar, ki nhéq beng mi ngki la mu chứng tưi. A-lứng khán riaih la dŏq mmar, ki máh a-beng mu chứng iki tưi. <verse eid="ROM 11:16" /><verse number="17" style="v" sid="ROM 11:17" />Ma khán máh a-beng khoiq dŏq péq táh, ma i-nha, ndóng la a-beng ô-li-vê a-rưih, khoiq bôn cláp tớq ntúq a-beng ngki, a-lứng khoiq cơt máh ti-cuôi chúng tưi sêt tu-mống clưi clưai te riaih na a-long ô-li-vê ngki, <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />ngki êq pa-ngíh i-nha ta-niêng máh a-beng can-nŏ́h. Ma ntro i-nha par-ngíh iki, ngki cóq ayư tới cháq i-nha par riaih a-long, ma la riaih a-long lư par i-nha. <verse eid="ROM 11:18" /><verse number="19" style="v" sid="ROM 11:19" />Dáh lơ, i-nha ính tông idô: “Máh a-beng ngki khoiq dŏq péq táh, dŏq lư cư têq bôn cláp mu nơi.” <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />Lư iki! Nha-án khoiq péq táh co callong lớiq tin, ma lư i-nha ta-yứng khớm nhơ callong tin. Êq te par-ngíh a-sớr cháq, ma cóq chom a-dáh! <verse eid="ROM 11:20" /><verse number="21" style="v" sid="ROM 11:21" />Ma khán Yang Arbang Pilŏ́ng khoiq lớiq a-yáu máh a-beng a-rớq te a-rưih ngki, Án mu chứng lư lớiq a-yáu i-nha. <verse eid="ROM 11:21" /><verse number="22" style="v" sid="ROM 11:22" />Iki, cóq chom mít sruiq-táq a-lứng callong car-siat ŏ na Yang Arbang Pilŏ́ng: tam callong car-siat te máh ti-cuôi khoiq dứm, ma mít sruiq-táq na Yang Arbang Pilŏ́ng dyôn ada i-nha, khán i-nha át níc tớq callong sruiq-táq Án. Ma lớiq, lư i-nha cơt ngai cớl táh. <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />Ma máh ti-cuôi ngki la mu chứng, khán nha-án lớiq ráp liêh te callong lớiq tin, nha-án lư bôn cláp a-mot. Co Yang Arbang Pilŏ́ng bôn chức sút dŏq cláp nha-án a-mot liêh. <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />Co Khán i-nha khoiq dŏq cớl táh mui tôm a-long te a-rưih la a-long ô-li-vê dáh tớq a-rưih, a-lứng khoiq bôn cláp cu-lái a-lớng a-long a-rưih tớq a-long ô-li-vê ŏ, máh ti-cuôi ngki, la máh ti-cuôi ính veng par-ngíh bôm, lư a-cán bôn cláp a-lớng a-long ô-li-vê na nha-án bôm a-ưi hơn chom máh mmo?<verse eid="ROM 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />Co i-nha, cư lớiq ính i-nha lớiq chom te callong ca-tốq ndô, dŏq i-nha lớiq bôn callong tu-báiq veng par-ngíh bôm, co callong cớng mít ngốh te mui top prái Isa-ra-el khoiq cơt dyơ, ti-ngôi tớq ndóng cứp máh ti-cuôi tới ti-cuôi Isa-ra-el mot tưi; <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" />a-lứng mu chứng ngki, díh Isa-ra-el lư bôn choi, a-rớq khoiq dŏq ta-ran, idô:</para>
  <para style="q1" vid="ROM 11:26">“Án choi ta-mống lư tớq te Si-ôn;</para>
  <para style="q1" vid="ROM 11:26">Án lư cớl táh máh callong ớq tar-náp ngốh te Ya-côp.<verse eid="ROM 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27" />A-lứng ngki la callong par-ưq tớq te Cư dyôn ada nha-án,</para>
  <para style="q1" vid="ROM 11:27">ndóng Cư táh callong luaih na nha-án.”<verse eid="ROM 11:27" /></para>
  <para style="b" />
  <para style="m">
    <verse number="28" style="v" sid="ROM 11:28" />Tam a-rớq Par-nai ŏ Yang, ti-cuôi cơt pi-con co bôn tar-náp na i-nha, ma veng ngê bôm, ti-cuôi têq a-moih lư co te top a-chúc a-chiac na nha-án. <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />Co máh callong choi mat a-lứng callong arô na Yang Arbang Pilŏ́ng la máh callong lớiq têq tar-piên. <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />Co a-rớq lư i-nha te nsuôi khoiq lớiq cam-máng Yang Arbang Pilŏ́ng, ma ndô khoiq bôn ar-moih te callong lớiq cam-máng na máh ti-cuôi ndô, <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />lư mu chứng a-rớq ngki, máh ti-cuôi ndô hoi ndô khoiq lớiq cam-máng te callong ar-moih i-nha, dŏq hoi ngki nha-án la têq bôn callong ar-moih. <verse eid="ROM 11:31" /><verse number="32" style="v" sid="ROM 11:32" />Co Yang Arbang Pilŏ́ng táq tôt máh ti-cuôi te callong lớiq ính cam-máng, dŏq Án têq a-páh callong sruiq-táq cứp náq ti-cuôi.<verse eid="ROM 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33" />Ơ, lư ŏ chứng sru te callong súc bôn a-lứng callong tu-báiq nha callong têq chom na Yang Arbang Pilŏ́ng! I-mo máh ar-náq na Án lớiq têq si-suô, a-lứng par-ngíh Án lớiq têq chom a-mớh!<verse eid="ROM 11:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="ROM 11:34" />Co, “Nnáu khoiq chom par-ngíh na Yang?</para>
  <para style="q1" vid="ROM 11:34">A-lớng nnáu khoiq cơt ti-cuôi ca-tớih na Án?<verse eid="ROM 11:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35" />Lớiq la nnáu khoiq dyôn Án nsuôi,</para>
  <para style="q1" vid="ROM 11:35">dyơ lư bôn Án ôi?”<verse eid="ROM 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ROM 11:36" />Co cứp nốh tớq te Án, nhơ te Án, a-lứng te Án. Ang ưr ưlla te Án ti-ngôi díh sút pang. A-men.<verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />Iki, em ai ơi, co callong sruiq-táq na Yang Arbang Pilŏ́ng, cư seq i-nha mŏp sang dyôn Yang Arbang pilŏ́ng cháq i-nha a-rớq mui crơng mŏp sang tu-mống, práh ŏ, bui mít Án, ngki la callong sang tám crái piaiq na i-nha. <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />A-lứng êq par-ngíh táq veng ngê pang ndô, ma cóq têq piên cơt mít tam-me loi na par-ngíh, dŏq i-nha têq chom callong mmo la can-nính práh ŏ, crái piaiq, a-lứng ti-nớng tu-pứng na Yang Arbang Pilŏ́ng.<verse eid="ROM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />Co nhơ callong choi mat khoiq dyôn ada cư, cư seq tông ada cứp náq ti-cuôi át te top i-nha êq par-ngíh te i-nha pưt ta-niêng callong cóq par-ngíh, ma cóq i-nha par-ngíh dŏq ar-lớih, veng a-rớq Yang Arbang Pilŏ́ng khoiq dyôn i-nha táq tớq callong tin dyôn cứp náq ti-cuôi. <verse eid="ROM 12:3" /><verse number="4" style="v" sid="ROM 12:4" />Co a-rớq top he bôn a-ưi nốh tớq mui cháq, ma nhéq tưh máh nốh lớiq bôn mu chứng ar-náq táq, <verse eid="ROM 12:4" /><verse number="5" style="v" sid="ROM 12:5" />iki mu chứng ngki, clứng ti-cuôi top he la mui cháq tớq Yang Choi Ta-mống, ma cứp náq ti-cuôi la cháq na tar-tuôq. <verse eid="ROM 12:5" /><verse number="6" style="v" sid="ROM 12:6" />Ma top he bôn máh callong dyôn mmar veng callong choi mat khoiq dŏq dyôn ada he: cóq ti-cuôi ngki ca to par-nai tang ng-cang, ngki veng na callong tin; <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />ti-cuôi mmo ơn tar-choi, tớq ar-náq tar-choi; ti-cuôi mmo ơn ca to, tớq ar-náq ca to; <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />ti-cuôi mmo ơn a-liam, tớq ar-náq a-liam; ơn dyôn sớng, na callong ính lư tar-choi; ơn cơt sút, na callong mmín; ơn a-páh callong sruiq-táq, na callong bui hơr.<verse eid="ROM 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />Callong ar-moih cóq lư ti-nớng, cóq viar te callong saq, ma táq nưm callong ŏ; <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />cóq ial mít a-moih dyôn ada tar-tuôq tớq callong ar-moih i-nha; táq ngôl ada tar-tuôq tớq callong dyám náp; <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />la êq ính táq hơ lớiq hơ te callong tel-sél ính táq, car-sŏ́h tớq mít can-nính; táq ar-náq Yang; <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />bui hơr tớq callong ng-cong; chiuq ta-nhir tớq callong diêiq a-rức; lot tớq callong cớu seq; <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />tar-choi máh ti-cuôi ki-dit tớq top tin; táq ang mát móh ada ti-cuôi tu-moi. <verse eid="ROM 12:13" /><verse number="14" style="v" sid="ROM 12:14" />Cóq tông ŏ dyôn máh ti-cuôi táq diêiq a-rức i-nha; cóq cớu bún a-lứng êq cớu pu-pap; <verse eid="ROM 12:14" /><verse number="15" style="v" sid="ROM 12:15" />dŏq bui mu nơi a-lứng máh ti-cuôi ŏ; dŏq nhiêm mu nơi a-lứng máh ti-cuôi a-rức; <verse eid="ROM 12:15" /><verse number="16" style="v" sid="ROM 12:16" />ndóng bôn sŏ́ng mui par-ngíh dyôn ada tar-tuôq, lớiq bôn par-ngíh a-sớr cháq, ma la ráp ar-toi máh ti-cuôi ki-dit. Êq par-ngíh hôi tu-báiq tớq te i-nha bôm; <verse eid="ROM 12:16" /><verse number="17" style="v" sid="ROM 12:17" />ma êq car-liêh callong lớiq ŏ na callong lớiq ŏ dyôn ada nnáu, ca-tóng máh callong ŏ chứng mát cứp náq ti-cuôi; <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />khán têq, callong a-mớh ưlla te i-nha, ngki cóq tu-mống ar-toi a-lứng cứp náq ti-cuôi; <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" />em ai a-moih lư ơi, êq i-nha car-liêh dơq, ma cóq mŏp dyôn callong ính táq na Yang Arbang pilŏ́ng, co callong khoiq ta-ran: “‘Ar-náq car-liêh dơq dyôn ada Cư; Cư lư car-liêh,’ Yang tông iki.”<verse eid="ROM 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ROM 12:20" />“Ma khán ti-cuôi pi-con i-nha sáng pi-nhaih, cóq dyôn án cha.</para>
  <para style="q1" vid="ROM 12:20">Khán ti-cuôi ngki sáng hál, cóq dyôn án ngoiq.</para>
  <para style="q1" vid="ROM 12:20">Co ndóng táq iki, i-nha lư dŏq car-hông uih chéh tớq plô án.”<verse eid="ROM 12:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 12:21" />Êq dyôn i-nha cơt par-yông te callong saq, ma cóq táng chíl callong saq na callong ŏ.<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />Cứp náq ti-cuôi cóq cam-máng máh ti-cuôi bôn chức sút át tớq i-nha, co ớq chức sút mmo yôl khán lớiq co Yang Arbang Pilŏ́ng, ma máh chức sút cơt bôn ngki dŏq a-nát co Yang Arbang Pilŏ́ng. <verse eid="ROM 13:1" /><verse number="2" style="v" sid="ROM 13:2" />Co iki, nnáu ma ính chíl chức sút ngki la chíl liêh par-nai ŏ na Yang Arbang Pilŏ́ng, ndon máh ti-cuôi chíl liêh ngki lư cơt ráp liêh callong diêiq a-rức ada nha-án. <verse eid="ROM 13:2" /><verse number="3" style="v" sid="ROM 13:3" />Co máh ti-cuôi sút pưt lớiq bôn táq dyôn a-dáh te ar-náq ŏ, ma la dyôn ar-náq lớiq ŏ. Ma i-nha ính lớiq a-dáh te ti-cuôi sút pưt ngki bớh? Cóq táq callong ŏ, ngki i-nha lư ráp callong ayô te ti-cuôi sút pưt, <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />ma co ti-cuôi ngki la táq ar-náq na Yang Arbang Pilŏ́ng têq bôn callong tar-náp dyôn i-nha. Ma khán i-nha táq ar-náq saq, ngki cóq sáng a-dáh, co án lớiq kéu dau lớiq bôn tar-náp, co án la ti-cuôi táq ar-náq na Yang Arbang Pilŏ́ng, la án pa-cliêq dŏq callong ính táq dyôn ada ti-cuôi táq ar-náq saq. <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />Co iki, callong tar-náp la cóq peh, tới nưm co callong sang uan, ma lư co te par-ngíh ŏ. <verse eid="ROM 13:5" /><verse number="6" style="v" sid="ROM 13:6" />Co a-lứng te callong ngki ma i-nha dyôn práq thêq; co nha-án la ti-cuôi táq ar-náq na Yang Arbang Pilŏ́ng, ca-tóng níc te máh ar-náq ndô. <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />Cóq cu-liêh dyôn cứp náq ti-cuôi crơng i-nha váq nha-án: thêq dyôn ti-cuôi ial práq thêq, práq a-nát dyôn ti-cuôi ial práq a-nát, a-dáh ti-cuôi piaiq cóq a-dáh, dyám ti-cuôi piaiq cóq dyám.<verse eid="ROM 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />Êq váq nnáu mui nốh a-mớh, ma cóq ar-moih ada tar-tuôq, co nnáu a-moih ti-cuôi át tar-mán ngki táq veng phep rit. <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />Co callong ndô: “A-cái êq táq luaih láh par-lưi, a-cái êq ca-chet ti-cuôi, a-cái êq ti-tôiq, a-cái êq ham crơng,” a-lứng khán yôl máh par-nai pa-táp can-nŏ́h hơ, cứp callong ngki bôn ti-toiq tớq par-nai ndô: “A-cái cóq a-moih ti-cuôi át tar-mán na a-cái a-rớq cháq bôm.” <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />Callong ar-moih lớiq táq saq ti-cuôi át tar-mán. Iki, a-moih la callong táq veng phep rit.<verse eid="ROM 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />A-lứng dyơ ngki, co chom i-ngái ngki khoiq tớq, ndóng dyôn i-nha cóq ayư te ntúq bíq. Co hoi ndô callong choi ta-mống na top he khoiq tar-mán lư te i-ngái ndóng top he mbơiq tin. <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />I-dáu khoiq tu-liê, ma i-ngái ính tớq. Iki, top he cóq táh nhéq máh ar-náq na callong ngiau, dyơ ial sứp au taq na callong ang. <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />Top he cóq ti-caq pôq dyôn crái piaiq a-rớq chứng i-ngái, êq ngoiq cha a-lứng bol plêc, êq láh par-lưi a-lứng tu-mống i-mo thôi, êq tar-miên a-lứng i-ôiq ca-míq. <verse eid="ROM 13:13" /><verse number="14" style="v" sid="ROM 13:14" />Ma, cóq cơt a-rớq Yang, Choi Ta-mống Yê-su, a-lứng êq táq veng par-ngíh a-rớq na sac sáiq te máh nốh ính.<verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />Ma, cóq pa-sôl ŏ ti-cuôi biq tớq callong tin, êq tớq nga ar-náq tar-miên i-yốh chom ar-lớih. <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />Tam mu náq ti-cuôi ngki bôn callong tin dŏq cha cứp nốh, ma ti-cuôi i-yốh chom ar-lớih nưm cha ar-nam. <verse eid="ROM 14:2" /><verse number="3" style="v" sid="ROM 14:3" />Ti-cuôi cha êq pa-mat ti-cuôi lớiq cha, ma ti-cuôi lớiq cha lớiq têq tông ti-cuôi cha. Co Yang Arbang Pilŏ́ng khoiq ráp án. <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />I-nha tông án táq ar-náq tớq dúng na ti-cuôi can-nŏ́h, mái la nnáu? Ti-cuôi ngki ta-yứng a-láng dứm tớq ưlla na mái bôm. Ma ti-cuôi ngki lư ta-yứng khớm, co Yang bôn chức dyôn conh ngki ta-yứng khớm. <verse eid="ROM 14:4" /><verse number="5" style="v" sid="ROM 14:5" />Tam ti-cuôi ndô par-ngíh i-ngái ntíh a-lớng i-ngái ntŏ́h, ma ti-cuôi can-nŏ́h ngki par-ngíh cứp i-ngái la ŏ nhéq. Cứp náq ti-cuôi cóq ti-tuaiq dyôn ar-lớih tớq par-ngíh án. <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />Ti-cuôi ndon náp i-ngái la náp co Yang, án cha la cha co Yang, co ti-cuôi ngki si ơn Yang Arbang Pilŏ́ng, án lớiq cha la lớiq cha co Yang, ti-cuôi ngki lư si-ơn Yang Arbang Pilŏ́ng. <verse eid="ROM 14:6" /><verse number="7" style="v" sid="ROM 14:7" />Co ớq nnáu te top he tu-mống co cháq bôm, a-lứng ớq nnáu cu-chet co cháq bôm. <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />Co díh ndóng top he tu-mống, la tu-mống co Yang, nha top he cu-chet, la cu-chet co Yang. Iki, díh ndóng top he tu-mống nha top he cu-chet, top he ưlla na Yang. <verse eid="ROM 14:8" /><verse number="9" style="v" sid="ROM 14:9" />Co te ar-náq ndô Yang Choi Ta-mống, khoiq cu-chet a-lứng khoiq tu-mống liêh, dŏq Án cơt Yang na máh ti-cuôi cu-chet, na máh ti-cuôi tu-mống. <verse eid="ROM 14:9" /><verse number="10" style="v" sid="ROM 14:10" />Ma conh ndô, i-mo mái tíq em ai bôm? Lớiq la conh ntíh, i-mo mái pa-mat em ai bôm? Co nhéq náq top he ta-yứng chứng mát tar-sưq na Yang Arbang Pilŏ́ng. <verse eid="ROM 14:10" /><verse number="11" style="v" sid="ROM 14:11" />Co par-nai khoiq dŏq ta-ran:</para>
  <para style="q" vid="ROM 14:11">“Yang tông idô: ‘A-rớq Cư tu-mống níc, cứp tar-col lư chóh chứng mát Cư,</para>
  <para style="q1" vid="ROM 14:11">a-lứng cứp ntaq lư ngin chứng mát Yang Arbang Pilŏ́ng.’”<verse eid="ROM 14:11" /></para>
  <para style="b" />
  <para style="m">
    <verse number="12" style="v" sid="ROM 14:12" />Co iki, cứp náq tớq top he lư a-ngốh par-nai ntêr te án bôm ada Yang Arbang Pilŏ́ng.<verse eid="ROM 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />Co iki, top he êq tar-tíq tar-tuôq nnáng, ma, cóq par-ngíh mui mít sớng: Êq dŏq cúc búl ca-táng lớiq la táq dyôn ki-dúh ada em ai bôm. <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />Cư chom a-lứng bôn át mui mít tớq Yang Yê-su, ngki ớq crơng a-mớh te cháq án la callong saq, ma nưm ti-cuôi mmo par-ngíh nốh a-mớh lư callong saq, án cơt saq lư loi te ti-cuôi ngki. <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />Ma khán ndon em ai bôm cơt táq dyôn bol co te tan-na cha, i-nha lớiq bôn ti-caq pôq veng callong ar-moih nnáng. Êq co te tan-na cha na i-nha ca-chet ti-cuôi em ai ngki, la ti-cuôi ma Yang Choi Ta-mống khoiq cu-chet tang. <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />Iki, êq dŏq callong práh ŏ na i-nha cơt ớq tar-náp. <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />Co cruông na Yang Arbang Pilŏ́ng lư tớiq la crơng cha a-lứng crơng ngoiq, ma lư callong ti-nớng tu-pứng a-lứng iên ŏ nha callong bui hơr tớq Yang Ar-vai. <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />Co nnáu táq ar-náq Yang Choi Ta-mống na ngê ndô ngki bui can-nính Yang Arbang Pilŏ́ng a-lứng bôn dyám náp te thư ti-cuôi. <verse eid="ROM 14:18" /><verse number="19" style="v" sid="ROM 14:19" />Iki dyơ, top he cóq ca-tóng táq máh callong át ar-toi a-lứng cứp ar-náq têq mu náq choi dyôn mu náq. <verse eid="ROM 14:19" /><verse number="20" style="v" sid="ROM 14:20" />Êq ta-lóh ar-náq na Yang Arbang Pilŏ́ng co te tan-na cháq. Tam cứp nốh práh ŏ, ma ngki la callong luaih ada ti-cuôi cha ngki táq dyôn cơt luaih. <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />Callong ŏ lư lớiq cha sáiq a-lứng lớiq ngoiq siêu lớiq la cứp nốh a-mớh ndon te ngki táq dyôn ndon em ai na i-nha cơt dứm, tơ la táq luaih, lớiq la cơt táh callong tin. <verse eid="ROM 14:21" /><verse number="22" style="v" sid="ROM 14:22" />Cháq i-nha bôn callong tin i-mo, cóq ca-pol khớm veng a-rớq par-ngíh ính chứng mát Yang Arbang Pilŏ́ng. Bún lư dyôn ti-cuôi lớiq chóng tíq bôm tớq callong án sáng la piaiq. <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />Ma mu náq ti-cuôi khoiq bôn callong luaih khán ti-cuôi ngki khoiq cha chón ndóng par-ngíh, co lớiq tớq te callong tin. Ma, cứp ar-náq ndon lớiq tớq te callong tin ngki la bôn luaih.<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />Ma top he, la ti-cuôi tin khớm, cóq tar-choi máh iêuq thor na ti-cuôi lớiq tin khớm, a-lứng he êq táq crái nưm mít bôm. <verse eid="ROM 15:1" /><verse number="2" style="v" sid="ROM 15:2" />Cứp náq te top he cóq táq bui mít ti-cuôi át pa-niar i-nha co ính bôn callong ŏ, ada ar-náq tar-choi ti-cuôi ngki. <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" />Co díh Yang Choi Ta-mống khoiq lớiq táq bui can-nính án bôm. Ma, a-rớq par-nai khoiq bôn ta-ran: “Máh par-nai a-craiq na máh ti-cuôi ayê Án khoiq tốq liêh tớq cư.” <verse eid="ROM 15:3" /><verse number="4" style="v" sid="ROM 15:4" />Co nhéq máh callong khoiq dŏq ta-ran ndô ngki khoiq bôn ta-ran liêh co callong ca to ada top he, dyôn cơt nhơ callong chiuq ta-nhir a-lứng nhơ callong a-liam na Par-nai Yang, top he têq bôn callong ng-cong. <verse eid="ROM 15:4" /><verse number="5" style="v" sid="ROM 15:5" />Cớu seq Yang Arbang Pilŏ́ng na callong chiuq ta-nhir a-lứng a-liam khoiq choi dyôn i-nha dŏq têq mui par-ngíh a-lớng tar-tuôq veng a-rớq Yang Choi Ta-mống Yê-su, <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />dyôn i-nha têq cơt mui mít, co mui par-nai têq ayô Yang Arbang Pilŏ́ng, la A-ám na Yang top he, Yang Choi Ta-mống Yê-su.<verse eid="ROM 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7" />Iki, cóq ráp tar-tuôq, mu chứng a-rớq Yang Choi Ta-mống khoiq ráp i-nha, dŏq bôn callong ayô te Yang Arbang Pilŏ́ng. <verse eid="ROM 15:7" /><verse number="8" style="v" sid="ROM 15:8" />Co cư seq tông idô Yang Choi Ta-mống khoiq táq dyôn cơt ti-cuôi tar-choi ar-náq na ti-cuôi prái táq rit-kít co te par-nai piaiq na Yang Arbang Pilŏ́ng, dŏq táq máh par-nai án khoiq ưq te a-chúc a-chiac, <verse eid="ROM 15:8" /><verse number="9" style="v" sid="ROM 15:9" />ma dŏq máh ti-cuôi tới ti-cuôi Isa-ra-el ayô Yang Arbang Pilŏ́ng co te mít sruiq-táq na Án, a-rớq par-nai khoiq dŏq ta-ran:</para>
  <para style="q1" vid="ROM 15:9">“Te ngki, a-cái lư ayô Án chứng mát máh ti-cuôi tới ti-cuôi Isa-ra-el</para>
  <para style="q1" vid="ROM 15:9">a-lứng cứh ayô nốh Án.”<verse eid="ROM 15:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="ROM 15:10" />A-lứng bôn par-nai tông idô:</para>
  <para style="q1" vid="ROM 15:10">“Máh ti-cuôi tới ti-cuôi Isa-ra-el,</para>
  <para style="q1" vid="ROM 15:10">cóq bui ŏ mu nơi a-lứng prái Án.”<verse eid="ROM 15:10" /></para>
  <para style="b" />
  <para style="m">
    <verse number="11" style="v" sid="ROM 15:11" />A-lứng idô hơ:</para>
  <para style="q1" vid="ROM 15:11">“Nhéq máh ti-cuôi tới ti-cuôi Isa-ra-el,</para>
  <para style="q1" vid="ROM 15:11">cóq cứh ayô Yang; nhéq máh prái, cóq cứh ayô Án.”<verse eid="ROM 15:11" /></para>
  <para style="b" />
  <para style="m">
    <verse number="12" style="v" sid="ROM 15:12" />A-lứng Ê-sai tông loi:</para>
  <para style="q1" vid="ROM 15:12">“Tŏ́ng toiq na Yê-sê lư tớq, la Án yôr dŏq cơt sút máh ti-cuôi tới ti-cuôi Isa-ra-el;</para>
  <para style="q1" vid="ROM 15:12">máh ti-cuôi tới ti-cuôi Isa-ra-el lư bôn callong ng-cong te Án.”<verse eid="ROM 15:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13" />Seq Yang Arbang Pilŏ́ng te tôm callong ng-cong dyôn i-nha pớnh máng cứp callong bui hơr a-lứng iên ŏ tớq callong tin, dŏq táq dyôn i-nha clưi clưai tớq callong ng-cong nhơ chức sút na Yang Ar-vai.<verse eid="ROM 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />Ma, ơi em ai na cư, lư nưm cư táp têq chom te i-nha ar-lớih lư i-nha ngki bôn máng callong ŏ, khoiq bôn pớnh máh callong chom a-lứng têq dŏq ca-tớih tar-tuôq. <verse eid="ROM 15:14" /><verse number="15" style="v" sid="ROM 15:15" />Ma cư khoiq ta-ran clóq lư dyôn em ai a-ưi hơn tớq ntúq ndô ntúq ntíh dŏq ính ca-tớih i-nha, co callong choi mat khoiq bôn Yang Arbang Pilŏ́ng dyôn ada cư, <verse eid="ROM 15:15" /><verse number="16" style="v" sid="ROM 15:16" />dŏq dyôn cư la ti-cuôi táq ar-náq na Yang Choi Ta-mống Yê-su dyôn máh ti-cuôi tới Isa-ra-el, ndóng ca to rit mŏp sang dyôn Par-nai ŏ na Yang Arbang Pilŏ́ng, dyôn cơt crơng sang na ti-cuôi tới Isa-ra-el têq sáng bui, te ndóng bôn a-rau práh co Yang Ar-vai. <verse eid="ROM 15:16" /><verse number="17" style="v" sid="ROM 15:17" />Co iki, tớq Yang Choi Ta-mống Yê-su, cư bôn callong ính a-páh ada máh ar-náq ưlla te Yang Arbang Pilŏ́ng. <verse eid="ROM 15:17" /><verse number="18" style="v" sid="ROM 15:18" />Co cư lư lớiq dáh tông mui nốh a-mớh khán ar-náq ngki tới Yang Choi Ta-mống khoiq táq na cư, dŏq têq callong náp peh na ti-cuôi tới Isa-ra-el — te par-nai ca to nha ar-náq táq, <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />na bánh rêng na máh tíc a-lứng ar-náq si-leh, na chức Ar-vai na Yang Arbang Pilŏ́ng — tar-lúh cư khoiq ca to Par-nai ŏ na Yang Choi Ta-mống cứp ntúq te Yaru-salem a-lứng chuôp pa-niar ti-ngôi díh I-li-ri-cum; <verse eid="ROM 15:19" /><verse number="20" style="v" sid="ROM 15:20" />ma veng ngê ngki, dŏq ca-tóng ada rêng ca to Par-nai ŏ tới tớq ntúq Yang Choi Ta-mống khoiq dŏq rêh arô, dyôn têq cư lớiq pi-tứng cơt ta-nang nga ti-cuôi can-nŏ́h. <verse eid="ROM 15:20" /><verse number="21" style="v" sid="ROM 15:21" />Ma, a-rớq callong khoiq dŏq ta-ran:</para>
  <para style="q1" vid="ROM 15:21">“Máh ti-cuôi i-yốh bôn ca to te Án ngki lư hôm,</para>
  <para style="q1" vid="ROM 15:21">a-lứng máh ti-cuôi i-yốh bôn sáng ngki lư chom.”<verse eid="ROM 15:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22" />Iki, a-ưi chư cư lư khoiq táh ca-táng dŏq tớq nga i-nha. <verse eid="ROM 15:22" /><verse number="23" style="v" sid="ROM 15:23" />Ma hoi ndô, co ớq bôn nnáng ntúq tớq máh cruông ndô, ma co cư tel-sél par-ngíh ính tớq a-lang i-nha te a-ưi cu-mo, <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />iki khán ali mmo cư bôn pôq nga Sa-pên, cư lư ng-cong, ndóng pôq pha, tar-múh i-nha, a-lứng têq i-nha tar-choi tớq ngki, khán nsuôi lư cư bôn sáng bui a-lớng i-nha ma lớiq dưnh. <verse eid="ROM 15:24" /><verse number="25" style="v" sid="ROM 15:25" />Ma hoi ndô cư chón thuan pôq nga Yaru-salem tar-choi máh top tin. <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />Co ti-cuôi Ma-sa-dôn a-lứng A-chai khoiq sáng bui dŏq pa-chúng práq ính tar-choi nha-án dyôn máh ti-cuôi ki-dit te máh top tin tớq vel Yaru-salem. <verse eid="ROM 15:26" /><verse number="27" style="v" sid="ROM 15:27" />Co nha-án khoiq sáng bui a-lứng nha-án la máh ti-cuôi yôl váh top ti-cuôi ngki. Co khán máh ti-cuôi tới Isa-ra-el têq ráp mu nơi máh callong bún te ar-vai na máh ti-cuôi ngki, nha-án lư bôn mpual ial crơng tar-choi máh ti-cuôi ngki te tam-pớc tớc tan-na cha. <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />Iki, tư khoiq dyơ ar-náq ndô a-lứng cua nhéq pa-chúng mŏp crơng ndô dyôn ada nha-án, cư lư ính pôq mot a-lang i-nha dŏq tớq Sa-pên. <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />Ma cư chom ar-lớih ndóng pôq nga i-nha, cư lư tớq a-lứng dông callong bún na Yang Choi Ta-mống.<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />Ma, em ai ơi, co Yang top he, la Yang Choi Ta-mống Yê-su, a-lứng co callong ar-moih te Ar-vai Yang, cư seq i-nha sŏ́ng tar-chíl a-lứng cư na máh par-nai cớu seq tang dyôn cư nga Yang Arbang Pilŏ́ng, <verse eid="ROM 15:30" /><verse number="31" style="v" sid="ROM 15:31" />dŏq cư têq bôn tar-choi vít máh ti-cuôi lớiq náp peh tớq Yu-dê, a-lứng dŏq máh ar-náq na cư dyôn ada Yaru-salem têq bôn sáng bui ráp te máh top tin; <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />dyôn cơt co can-nính na Yang Arbang Pilŏ́ng, cư ính tớq a-lứng i-nha tớq callong bui hơr, co bôn át ar-toi a-lứng i-nha. <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />Yang Arbang Pilŏ́ng iên ŏ át a-lứng cứp náq i-nha. A-men.<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />Cua ngki, cư mŏp dyôn i-nha ơi Phê-bê, án la em ơi na top he, a-lứng la ti-cuôi táq ar-náq na Dúng Sang tớq Sen-cơ-rê, <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />dŏq i-nha têq ráp pa-sôl ơi tớq Yang, veng ngê piaiq a-lứng máh top tin, nha tớq tar-choi án te ar-náq mmo ma án ính i-nha. Co án ngki khoiq cơt ti-cuôi tar-choi dyôn clứng ti-cuôi, náp díh cháq cư.<verse eid="ROM 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3" />Seq car-bánh Ba-rit-sin nha A-cui-la, máh yớu táq ar-náq mu nơi na cư tớq Yang Choi Ta-mống Yê-su, <verse eid="ROM 16:3" /><verse number="4" style="v" sid="ROM 16:4" />ngki la máh ti-cuôi khoiq lớiq a-dáh cu-chet co te pang tu-mống na cư, lớiq nưm mu náq cư si-ơn nha-án, ma nhéq máh dúng sang na máh ti-cuôi tới Isa-ra-el hơ, <verse eid="ROM 16:4" /><verse number="5" style="v" sid="ROM 16:5" />a-lứng top tin tớq dúng nha-án. Seq car-bánh Ê-pa-nêt, em ai a-moih lư na cư, ma án la tôm táq ar-náq na cruông A-si dyôn Yang Choi Ta-mống. <verse eid="ROM 16:5" /><verse number="6" style="v" sid="ROM 16:6" />Seq car-bánh Ma-ri, án khoiq táq ar-náq lư diêiq a-rức co i-nha. <verse eid="ROM 16:6" /><verse number="7" style="v" sid="ROM 16:7" />Seq car-bánh An-trô-nic nha Yu-niê, yớu mu vel na cư a-lứng yớu át tôt na cư, bar náq ti-cuôi ngki la máh ti-cuôi par-hanh te top dyưng ati, ma nha-án sŏ́ng khoiq át tớq Yang Choi Ta-mống nsuôi cư. <verse eid="ROM 16:7" /><verse number="8" style="v" sid="ROM 16:8" />Seq car-bánh Am-li-a, yớu cư a-moih lư na cư tớq Yang. <verse eid="ROM 16:8" /><verse number="9" style="v" sid="ROM 16:9" />Seq car-bánh U-rơ-ban, yớu mu nơi na top he tớq Yang Choi Ta-mống, a-lứng Sa-ta-chi, yớu cư a-moih lư na cư. <verse eid="ROM 16:9" /><verse number="10" style="v" sid="ROM 16:10" />Seq car-bánh A-pel-lơ, án bôn ráp tớq Yang Choi Ta-mống. Seq car-bánh máh ti-cuôi ưlla mu dúng na A-ri-ta-bul. <verse eid="ROM 16:10" /><verse number="11" style="v" sid="ROM 16:11" />Seq car-bánh Hê-rô-diê, ti-cuôi mu vel na cư. Seq car-bánh máh ti-cuôi ưlla mu dúng na Nar-sit, la máh ti-cuôi át tớq Yang. <verse eid="ROM 16:11" /><verse number="12" style="v" sid="ROM 16:12" />Seq car-bánh Tri-phan nha Tri-phôt, máh ti-cuôi chiuq diêiq a-rức tớq Yang. Seq car-bánh Par-sit ndon a-moih lư, án khoiq táq ar-náq lư diêiq a-rức tớq Yang. <verse eid="ROM 16:12" /><verse number="13" style="v" sid="ROM 16:13" />Seq car-bánh Ru-phu, án khoiq bôn rêh tớq Yang, a-lứng a-i na án nha na cư. <verse eid="ROM 16:13" /><verse number="14" style="v" sid="ROM 16:14" />Seq car-bánh A-sun-crit, Plê-côn, Her-mêt, Pa-tru-ba, Her-mat, a-lứng máh em ai át a-lứng nha-án. <verse eid="ROM 16:14" /><verse number="15" style="v" sid="ROM 16:15" />Seq car-bánh, Pha-lô-la-cô nha Yu-li, Na-rê a-lứng ơi án, nha Ô-lum-pa a-lứng cứp náq máh ti-cuôi tin át a-lứng nha-án. <verse eid="ROM 16:15" /><verse number="16" style="v" sid="ROM 16:16" />Cóq car-bánh tar-tuôq na honh ŏ. Nhéq máh top tin na Yang Choi Ta-mống car-bánh i-nha.<verse eid="ROM 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />Ma, em ai ơi, cư seq pa-táp i-nha cóq mmứng máh ti-cuôi ính car-chúc par-nai lớiq ŏ a-lứng táq diêiq a-rức, ndái te ngai ca to ma i-nha khoiq rian, a-lứng cóq viar yông te nha-án. <verse eid="ROM 16:17" /><verse number="18" style="v" sid="ROM 16:18" />Co máh ti-cuôi a-rớq ngki lớiq táq veng ngê Yang top he, la Yang Choi Ta-mống, ma nưm veng ngê na cháq bôm, a-lứng co par-nai alham lam-bŏt nha ayô, nha-án pi-lốh máh ti-cuôi lớiq khớm. <verse eid="ROM 16:18" /><verse number="19" style="v" sid="ROM 16:19" />Co mít táq veng na i-nha khoiq par-hanh díh cứp ti-cuôi. Co iki, cư sáng bui te i-nha, ma cư ính i-nha cơt tu-báiq te ar-náq ŏ, ma êq tu-báiq te ar-náq saq. <verse eid="ROM 16:19" /><verse number="20" style="v" sid="ROM 16:20" />Yang Arbang Pilŏ́ng na callong iên ŏ lư táng chíl Yang sáq pưn dyưng i-nha cơt chái lư. Callong choi mat na Yang top he, Yang Choi Ta-mống Yê-su, át a-lứng i-nha.<verse eid="ROM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />Ti-mu-thê, yớu táq ar-náq a-lứng cư, díh Lu-si-ut, Ya-sôn, nha Su-si-pa-thơ, máh yớu na cư, cơiq par-nai car-bánh i-nha. <verse eid="ROM 16:21" /><verse number="22" style="v" sid="ROM 16:22" />Cư, Têr-tiu, ti-cuôi ta-ran par-nai a-lang ndô, cơiq car-bánh i-nha tớq Yang. <verse eid="ROM 16:22" /><verse number="23" style="v" sid="ROM 16:23" />Cai-ut, án ndon chứm chiam cư a-lứng díh top tin, cơiq par-nai car-bánh i-nha. Ê-rat, án ca-dyiq práq na vel pưt, a-lứng máh em ai Cuar-tu, cơiq par-nai car-bánh i-nha. <verse eid="ROM 16:23" /><verse number="24" style="v" sid="ROM 16:24" />[Callong choi mat te Yang top he, Yang Choi Ta-mống Yê-su, át a-lứng cứp náq i-nha. A-men.]<verse eid="ROM 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25" />cóq ayô Án têq táq dyôn i-nha cơt khớm veng Par-nai ŏ Yang te cư a-lứng par-nai ca to Yang Choi Ta-mống Yê-su, veng callong a-páh te callong ca-tốq cơi dŏq ca-tốq tớq cứp pang nsuôi, <verse eid="ROM 16:25" /><verse number="26" style="v" sid="ROM 16:26" />ma ndô khoiq bôn a-páh, ma co máh par-nai tang ng-cang, veng ta-pun ngê na Yang Arbang Pilŏ́ng díh sút pang, khoiq dŏq taq-ntêr dyôn cứp náq ti-cuôi dŏq táq veng na callong tin, <verse eid="ROM 16:26" /><verse number="27" style="v" sid="ROM 16:27" />ang ưr te Án, Yang Arbang Pilŏ́ng chom nưm, nhơ Yang Choi Ta-mống Yê-su, ti-ngôi díh sút pang. A-men.<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>