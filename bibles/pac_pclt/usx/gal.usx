  <book code="GAL" style="id">EN_PCLT pac_Pacoh_ltr Thu Apr 09 2026 09:33:04 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Galatians</para>
  <para style="toc1">Chớiq A-lang Ca-la-ti</para>
  <para style="toc2">Ca-la-ti</para>
  <para style="toc3">Gal</para>
  <para style="mt">Ca-la-ti</para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />Phau-lô la dyưng ati — tới tớq te thư ti-cuôi, a-lứng tới co mu náq ti-cuôi mmo, ma co Yang Choi Ta-mống Yê-su a-lứng Yang Arbang Pilŏ́ng, la A-ám, Án khoiq táq Yang Yê-su tu-mống liêh te cu-chet — <verse eid="GAL 1:1" /><verse number="2" style="v" sid="GAL 1:2" />a-lứng cứp náq top i-nha át a-lớng cư, cơiq máh ti-cuôi tin tớq Ca-la-ti: <verse eid="GAL 1:2" /><verse number="3" style="v" sid="GAL 1:3" />Seq callong choi mat tớq nga i-nha mu chứng callong iên ŏ te Yang Arbang Pilŏ́ng, la A-ám, a-lứng Yang top he, Yang Choi Ta-mống Yê-su, <verse eid="GAL 1:3" /><verse number="4" style="v" sid="GAL 1:4" />Yang Yê-su khoiq mŏp án co callong luaih top he, dŏq Án têq choi ta-mống top he viar vít te pang saq hoi ndô, veng can-nính na Yang Arbang Pilŏ́ng, A-ám top he. <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />Seq callong ang ưr te Án dyôn díh sút pang lang dơi. A-men.<verse eid="GAL 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />Cư sang dut ndóng i-nha chái lư ca-lôih te Án khoiq rêh arô i-nha co callong choi mat na Yang Choi Ta-mống ma veng ngê Yang can-nŏ́h, <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />ma Par-nai ŏ Yang ngki lớiq têq ndái a-mớh, nưm la co te ti-cuôi ntíh la máh ti-cuôi ính pa-clu i-nha a-lứng ính car-yáh Par-nai ŏ na Yang Choi Ta-mống. <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />Ma khán bôn cứp náq top he, lớiq la mu náq tar-neng te pilŏ́ng, pau ntêr ada i-nha Par-nai ŏ Yang ndái te Par-nai ŏ Yang ndon top he khoiq pau ntêr ada i-nha, ti-cuôi ngki cóq ngai pu-pap. <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />A-rớq top he khoiq cơi tông te nsuôi, ma hoi ndô cư tông mu chư loi: “Khán nnáu loi pau tông ada i-nha mui par-nai ŏ ndái te Par-nai ŏ Yang ndon i-nha khoiq ráp ial, ki ti-cuôi ngki cóq ráp callong pu-pap.” <verse eid="GAL 1:9" /><verse number="10" style="v" sid="GAL 1:10" />Co hoi ndô, cư chón táq bui pallúng thư ti-cuôi a-láng Yang Arbang Pilŏ́ng? Lớiq la cóq cư suô ngê táq bui pallúng ti-cuôi can-nŏ́h? Khán cư chón át táq bui pallúng ti-cuôi can-nŏ́h, ngki lư ar-lớih tới cư la ti-cuôi na Yang Choi Ta-mống.<verse eid="GAL 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />Em ai ơi, cư seq a-páh dyôn i-nha chom te Par-nai ŏ Yang khoiq cua cư pau tông, i-mo Par-nai ŏ Yang ngki tới la tớq te mu náq ti-cuôi mmo. <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />Co cư khoiq lớiq ráp ial Par-nai ŏ Yang te mu náq ti-cuôi mmo, cư lư lớiq bôn ca to dyôn, ma ngki la co callong a-páh na Yang Choi Ta-mống Yê-su. <verse eid="GAL 1:12" /><verse number="13" style="v" sid="GAL 1:13" />Co i-nha khoiq hanh te ngê tu-mống ndóng nsuôi na cư tớq top Isa-ra-el, ngki la cư yôl táq diêiq a-rức lư máh top tin na Yang Arbang Pilŏ́ng, a-lứng át suô níc ngê ính pu-pít top ngki. <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />A-lứng cư náp phep rit top Isa-ra-el a-ưi hơn te máh ti-cuôi mu prôq tớq top prái cư, dyơ tel-sél tháng ính lư veng te máh rit na a-chúc a-chiac cư. <verse eid="GAL 1:14" /><verse number="15" style="v" sid="GAL 1:15" />Ma ndóng Yang Arbang Pilŏ́ng, Án khoiq rêh cư te tớq pallúng a-i cư, a-lứng khoiq rêh arô cư co callong choi mat Án, bui can-nính <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />a-páh A-cái Án tớq cư, dŏq cư têq pau ntêr te A-cái ngki dyôn máh prái tới ti-cuôi Isa-ra-el, iki chai lư cư lớiq tang-húng te sáiq nha a-ham, <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />cư lư lớiq pôq nga vel Yaru-salem dŏq tar-múh máh ti-cuôi cơt dyưng ati nsuôi cư. Ma lư ngki, cư khoiq pôq nga A-rap, dyơ píh chô nga vel Da-mac.<verse eid="GAL 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 1:18" />Náp liêh, vít pe cu-mo, cư pôq nga vel Yaru-salem dŏq táq ca-lơ a-lứng Sê-pha dyơ cư át liêh a-lớng án mu chít la sông i-ngái. <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />Ma cư khoiq lớiq tu-múh díh mu náq ti-cuôi mmo te máh top dyưng ati, nưm Ya-cơ, a-em conh na Yang. <verse eid="GAL 1:19" /><verse number="20" style="v" sid="GAL 1:20" />Te máh par-nai cư ta-ran dyôn i-nha, cóq me ndô táp, chứng mát Yang Arbang Pilŏ́ng, cư lớiq tông a-uai. <verse eid="GAL 1:20" /><verse number="21" style="v" sid="GAL 1:21" />Vít ngki, cư pôq nga máh cruông na Si-ri nha Si-la-si. <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />Hoi ndô, cư yôl i-yốh bôn máh top tin na Yang Choi Ta-mống tớq Yu-dê a-cớl ar-maiq. <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />Ma top tin nưm bôn sáng idô: “Ti-cuôi te nsuôi táq lớiq ŏ top he hoi ndô chón pau ntêr callong tin ndon ti-cuôi ngki báq suô ngê ính ca-chet,” <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />iki nha-án ayô Yang Arbang Pilŏ́ng co nhơ cư.<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />Vít ngki mu chít la puan cu-mo, cư pôq liêh nga vel Yaru-salem a-lớng Ba-na-ba, nha a-lứng dông A-thit pôq tưi. <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />Hoi ngki, veng callong a-páh, cư khoiq pôq dyơ nha taq-ntêr nsuôi nha-án Par-nai ŏ Yang ndon cư pau tông dyôn máh prái tới ti-cuôi Isa-ra-el, ma veng ngê bôm a-lứng máh ti-cuôi bôn cơt plô, dáh lơ ngê mmo ndon cư chón táq lớiq la khoiq táq ma ớq bôn tar-náp. <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />Ntro lư iki, díh A-thit, án pôq mu nơi a-lứng cư, la ti-cuôi Créc, ngki lớiq pa-tot cóq táq rit kít. <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />Ma ar-náq ngki la co máh i-nha táq náh nnan mot dyơ ngốh, la máh ti-cuôi khoiq tôiq mot dŏq ính ti-tuaiq ngê ŏ na top he, la ngê ŏ ndon top he bôn te Yang Choi Ta-mống Yê-su, táq dyôn nha-án bôn cŏp top he cơt táq sol, <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />top he lư khoiq lớiq ính peh díh mu biq ngê te nha-án tớq mui nốh a-mớh, dŏq callong piaiq te Par-nai ŏ Yang têq yôl níc ada i-nha. <verse eid="GAL 2:5" /><verse number="6" style="v" sid="GAL 2:6" />Ma te top i-nha ntro lư la tar-náp ali mmo, (ntro te nsuôi nha-án bôn tar-náp máh mmo, ngki lớiq bôn tar-náp a-mớh ada cư; Yang Arbang Pilŏ́ng lớiq me te cu-lái tiêh na ti-cuôi) — lư, máh ti-cuôi ndon tar-náp ngki lớiq dyôn ca-lưi mui nốh a-mớh ada cư lớng. <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />Ma pliêt liêh, ndóng chom ar-lớih idô cư khoiq mŏp ar-náq pau tông Par-nai ŏ Yang dyôn ada ti-cuôi i-yốh táq rit kít, a-rớq Phi-er la dyôn ada ti-cuôi khoiq táq rit kít <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />(co Án khoiq a-nát dyôn Phi-er bôn chức cơt dyưng ati pôq ca to dyôn ti-cuôi táq rit kít, mu chứng khoiq a-nát dyôn cư pôq ca to dyôn ti-cuôi tới Isa-ra-el), <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />a-lứng vít dyơ chom ar-lớih callong choi mat khoiq dyôn ada cư, Ya-cơ, Sê-pha, nha Yon, máh ti-cuôi a-rớq la top táq plô, khoiq ntớp ati cơt ar-toi a-lứng Ba-na-ba nha cư, dŏq top he têq bôn ca to máh prái tới ti-cuôi Isa-ra-el, ma nha-án ngki ca to máh ti-cuôi táq rit kít, <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />nưm dŏq pa táp top he cóq ayư nga ti-cuôi ki-dit, lư la ar-náq ndon cư ngki khoiq ính lư dŏq táq.<verse eid="GAL 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />Ma tư Si-pha pôq nga An-ti-ôt cư khoiq dyŏq táp chứng mát án co án chón la piaiq ngai pi-ốh. <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />Co nsuôi ndóng máh ti-cuôi te Ya-cơ tớq, án chón cha mu nơi a-lứng máh ti-cuôi tớiq Isa-ra-el. Ma ndóng nha-án tớq, án khoiq car-lun vít dyơ car-yáh án mmar, co a-dáh nsếq náq ti-cuôi ndon cơt plô táq rit kít. <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />A-lứng máh ti-cuôi Isa-ra-el yôl liêh ngki par-chúng top náh nnan a-rớq án, tar-lúh díh Ba-na-ba ngki bôn par-yông táq ar-náq lớiq tar-náp na nha-án. <verse eid="GAL 2:13" /><verse number="14" style="v" sid="GAL 2:14" />Ma tư cư hôm ar-lớih nha-án chón tu-mống lớiq ti-nớng dŏq veng ngê piaiq na Par-nai ŏ Yang, cư khoiq tông ada Sê-pha chứng mát cứp náq ti-cuôi: “Khán mái, la ti-cuôi Isa-ra-el, tu-mống a-rớq ti-cuôi tới Isa-ra-el ma tới a-rớq ti-cuôi Isa-ra-el, ngki táq i-mo mái têq pa-tot ti-cuôi tới Isa-ra-el cóq tu-mống a-rớq ti-cuôi Isa-ra-el?” <verse eid="GAL 2:14" /><verse number="15" style="v" sid="GAL 2:15" />Top he la ti-cuôi Isa-ra-el te mbơiq car-nian, ma tới ti-cuôi luaih ngốh te ti-cuôi tới Isa-ra-el; <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />ma co chom ar-lớih ớq bôn nnáu têq ngin ti-nớng ŏ co ar-náq táq veng phep rit, ma nưm nhơ callong tin na Yang Choi Ta-mống Yê-su, iki top he khoiq dŏq callong tin te Yang Choi Ta-mống Yê-su, dŏq top he bôn ngin ti-nớng ŏ nhơ callong tin te Yang Choi Ta-mống ma tới co ar-náq táq veng phep rit. Co cứp sac sáiq lư lớiq têq ngin ti-nớng ŏ te ar-náq táq veng phep rit. <verse eid="GAL 2:16" /><verse number="17" style="v" sid="GAL 2:17" />Ma khán, chón ndóng suô ngê têq ngin ti-nớng ŏ tớq Yang Choi Ta-mống, lư top he ngki cơt ngai dŏq la ti-cuôi bôn luaih, a-láng Yang Choi Ta-mống la ti-cuôi tar-neng dyôn táq luaih? Callong ngki lư lớiq têq iki! <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />Ma khán cư táq liêh máh ar-náq ndon cư khoiq ta-lóh, cư táq bôm cư la ti-cuôi bôn luaih. <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />Co na phep rit, cư khoiq cu-chet te phep rit, dŏq cư têq bôn tu-mống dyôn Yang Arbang Pilŏ́ng. Cư khoiq ngai téh díng tớq a-long calláng a-lớng Yang Choi Ta-mống, <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />ntro cư lớiq bôn tu-mống nnáng, ma Yang Choi Ta-mống tu-mống tớq cư. Ma pang ndon cư hoi ndô chón tu-mống tớq sac sáiq, cư tu-mống tớq callong tin te A-cái Yang Arbang Pilŏ́ng, Án khoiq a-moih cư a-lứng mŏp cháq Án táp tang dyôn cư. <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />Cư lớiq cu-luai táh callong choi mat na Yang Arbang Pilŏ́ng a-mớh, co khán callong ti-nớng ŏ la te phep rit, khán iki Yang Choi Ta-mống khoiq cu-chet cơt lô sớng!<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />Ơi, máh ti-cuôi Ca-la-ti ndon a-chơ! Nnáu dŏq tar-háu par-kêh i-nha, ndóng chứng mát i-nha, Yang Choi Ta-mống Yê-su chiuq téh díng tớq a-long calláng khoiq dŏq a-páh dyôn chom ar-lớih? <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />Cư nưm ính plốh ti-tuaiq callong ndô te i-nha: I-nha khoiq bôn ráp Ar-vai Yang co ar-náq táq veng phep rit a-láng co cam-máng veng tớq callong tin? <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />I-mo i-nha a-chơ lư iki? Ndóng mbơiq ta-bớq na Ar-vai Yang, hoi ndô i-nha át táq nhéq na sac sáiq? <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />A-láng i-nha khoiq chiuq a-ưi nốh diêiq a-rức ma ớq tar-náp a-mớh? — Khán lư iki ngki lư lô mat sớng! <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />Iki, Án dyôn Ar-vai ada i-nha a-lứng táq máh ar-náq si-leh tớq top i-nha, ngki la co ar-náq táq veng phep rit, a-láng co cam-máng veng tớq callong tin? <verse eid="GAL 3:5" /><verse number="6" style="v" sid="GAL 3:6" />A-rớq A-pra-ham “náp par-nai Yang Arbang Pilŏ́ng ma ngki la callong ndon án khoiq náp la ti-nớng ŏ,” <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" />khán iki cóq chom ar-lớih máh ti-cuôi bôn callong tin, ngki la a-cái na A-pra-ham. <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />Ma ndóng hôm nsuôi dyơ Yang Arbang Pilŏ́ng náp ti-cuôi tới Isa-ra-el át ti-nớng ŏ co callong tin, Tám U-ráq Yang khoiq pau ntêr Par-nai ŏ Yang nsuôi dyôn A-pra-ham idô: “Cứp cruông lư bôn bún te mái.” <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />Co iki, nnáu bôn callong tin ngki bôn bún mu chứng a-rớq A-pra-ham, ti-cuôi bôn callong tin. <verse eid="GAL 3:9" /><verse number="10" style="v" sid="GAL 3:10" />Cứp náq ti-cuôi ki-nứm te ar-náq táq veng phep rit ngki át ta-dưp par-nai pu-pap; co bôn ta-ran idô: “Piaiq pu-pap cứp ti-cuôi lớiq náp peh cứp nốh callong khoiq ta-ran tớq u-ráq phep rit dŏq táq veng.” <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />Ma lư ar-lớih ngki ớq nnáu nhơ phep rit têq ngin ti-nớng ŏ chứng mát Yang Arbang Pilŏ́ng, co “ti-cuôi ti-nớng ŏ lư tu-mống co callong tin.” <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />Ma phep rit ngki lớiq tớq te callong tin, ma “Ti-cuôi táq máh ar-náq tớq phep rit lư tu-mống nhơ ngki.” <verse eid="GAL 3:12" /><verse number="13" style="v" sid="GAL 3:13" />Yang Choi Ta-mống khoiq thái top he te callong pu-pap na phep rit ndóng chiuq pu-pap tang dyôn top he — co bôn par-nai ta-ran: “Piaiq pu-pap ti-cuôi mmo ngai ta-yŏ́ng tớq a-long” — <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />dŏq callong bún na A-pra-ham tớq nga ti-cuôi tới Isa-ra-el tớq Yang Choi Ta-mống Yê-su, têq dyôn top he bôn ráp par-nai ưq te Ar-vai Yang nhơ callong tin.<verse eid="GAL 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />Em ai ơi, cư tông veng ngê thư ti-cuôi. Ntro lư i-mo, ớq nnáu têq táh lớiq la tưm tớq car-hŏt khoiq bôn ngai dŏq a-nát. <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />Ma, máh par-nai par-ưq ngki khoiq dŏq tông ada A-pra-ham nha ada tŏ́ng toiq na án. Par-nai ngki lớiq tông “a-lứng dyôn máh tŏ́ng toiq” a-rớq nưm te clứng ti-cuôi, ma la “ính dyôn tŏ́ng toiq na a-cái” a-rớq nưm te mu náq ti-cuôi, ma ngki la Yang Choi Ta-mống. <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />Ma te callong cư ính tông ngki la: Ndóng mpáh vít puan cu-lám pe chít cu-mo, phep rit lớiq têq táh par-ưq khoiq bôn Yang Arbang Pilŏ́ng dyôn nsuôi ngki ma táq lớiq tar-náp par-nai par-ưq. <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" />Ma khán bôn mun tớq te phep rit, lớiq nnáng la co par-nai par-ưq. Ma Yang Arbang Pilŏ́ng khoiq dyôn mun ada A-pra-ham ma na par-nai par-ưq. <verse eid="GAL 3:18" /><verse number="19" style="v" sid="GAL 3:19" />Khán iki, phep rit dŏq táq a-mớh? Phep rit khoiq tưm a-mot co te máh callong táq luaih, vít ndóng khoiq dyôn co top tar-neng na ati ti-cuôi át pan-di, dyôn díh ali mmo tŏ́ng toiq bôn liêh, ma par-nai par-ưq khoiq khớm lư te tŏ́ng toiq A-pra-ham. <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />Ma ti-cuôi cơt plô lư lớiq a-moih nưm mu náq sớng, ma Yang Arbang Pilŏ́ng ngki nưm mui. <verse eid="GAL 3:20" /><verse number="21" style="v" sid="GAL 3:21" />Iki, phep rit pôq ta-pliêt liêh par-nai par-ưq? Callong ngki la lớiq têq a-mớh! Co Khán phep rit bôn dyôn ma têq dông liêh callong tu-mống, ngki lư ar-lớih callong ti-nớng ŏ lư tớq te phep rit. <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />Ma Tám U-ráq Yang khoiq tông nhéq tưh pưn callong luaih dŏq co callong tin te Yang Choi Ta-mống Yê-su, par-nai par-ưq têq dŏq dyôn ada máh ti-cuôi bôn callong tin.<verse eid="GAL 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23" />Ma khán, nsuôi ndóng callong tin ngki tớq, top he cơt a-rớq át tôt pưn phep rit, ndóng ngai crál ti-ngôi díh i-ngái callong tin bôn mpáh. <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />Tar-lúh, phep rit khoiq cơt ti-cuôi kiaq me top he tớq nga Yang Choi Ta-mống, dŏq top he têq át ti-nớng ŏ co callong tin. <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />Ma tư dyơ callong tin tớq, top he lớiq bôn át pưn ti-cuôi kiaq me nnáng. <verse eid="GAL 3:25" /><verse number="26" style="v" sid="GAL 3:26" />Co cứp náp i-nha la a-cái na Yang Arbang Pilŏ́ng nhơ callong tin te Yang Choi Ta-mống Yê-su. <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />Ma khán ti-cuôi mmo khoiq ráp tíc na dơq te Yang choi ta-mống ngki callong sứp ial Yang Choi Ta-mống. <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />Êq táq ndái ti-cuôi Isa-ra-el a-láng Ti-cuôi Créc, êq táq ndái ti-cuôi sol a-láng lớiq sol, êq táq ndái conh a-láng cán, co nhéq náq i-nha la mui tớq Yang Choi Ta-mống Yê-su. <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />Ma khán i-nha ưlla Yang Choi Ta-mống, ngki i-nha la tŏ́ng toiq na A-pra-ham, la máh ti-cuôi cơt ưlla mun veng par-nai par-ưq.<verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />Ma cư ính tông idô dyôn tớq ali mmo ti-cuôi cơt ưlla yôl la ngai a-cái, ti-cuôi ngki lớiq ndái a-mớh ti-cuôi sol, ntro la ti-cuôi ưlla na nhéq máh mun chín. <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />Ma, ti-cuôi ngki át ta-dưp máh ti-cuôi ti-tuaiq a-lứng top kiaq me ti-ngôi tớq i-ngái dŏq a-nát nsuôi na ndon a-ám. <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />La mu chứng iki, ndóng top he yôl la ngai a-cái, top he cơt táq sol dyôn máh ngê na pang ndô. <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />Ma ndóng piaiq crái te i-ngái khoiq tớq, Yang Arbang Pilŏ́ng khoiq yua A-cái Án, ndóng car-nian te mu náq cán, car-nian ta-dưp phep rit, <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />dŏq Án choi ta-mống máh ti-cuôi át ta-dưp phep rit, dyôn top he têq bôn ráp chức cơt a-cái án. <verse eid="GAL 4:5" /><verse number="6" style="v" sid="GAL 4:6" />Ma, co i-nha la a-cái, Yang Arbang Pilŏ́ng, khoiq yua Ar-vai na A-cái Án át tớq top he, arô yứng idô: “A-ba, A-ám.” <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />Co iki, i-nha lớiq bôn la ti-cuôi sol nnáng, ma la a-cái, ma khán la a-cái, ngki la ti-cuôi ưlla mun nhơ Yang Arbang Pilŏ́ng.<verse eid="GAL 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />Ma ndóng nsuôi, ndóng i-yốh chom Yang Arbang Pilŏ́ng, i-nha khoiq táq sol dyôn máh nốh ma lư ngki tới la yang a-mớh lớng. <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />Ma hoi ndô ndóng khoiq chom dyơ Yang Arbang Pilŏ́ng, ma crái lư la khoiq bôn Yang Arbang Pilŏ́ng chom dyơ, ngki táq i-mo i-nha cơt píh liêh a-nga máh ngê tớq pang iêuq thor nha ớq tar-náp, i-nha ính lư táq sol dyôn nha-án yôl nnáng mu chư loi? <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />I-nha yôl me i-ngái, ki-sái, tam-pán nha cu-mo! <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />Cư sáng rớu ada i-nha, dáh lơ i-mo cư khoiq chiuq a-rức lô mat sớng tớq top i-nha.<verse eid="GAL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12" />Em ai ơi! Cư seq i-nha cóq cơt a-rớq cư, co cư ngki a-rớq i-nha. I-nha lớiq bôn táq diêiq cư nốh a-mớh. <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />I-nha chom ar-lớih co te callong a-ái tar-ma tớq cháq ndô, cư khoiq pau tông Par-nai ŏ Yang dyôn i-nha te tôm lư. <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />Te callong chim na i-nha la co tớq te cư, ma i-nha khoiq lớiq ayê, a-lứng lớiq ca-lôih, ma, i-nha khoiq ráp pa-sôl cư a-rớq tar-neng na Yang Arbang Pilŏ́ng, a-rớq Yang Choi Ta-mống Yê-su. <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />Khán iki callong bui ŏ ngki na i-nha tu-mo dyơ? Co cư khoiq a-páh te i-nha idô, ma khán têq, i-nha lư khoiq cu-lóc mát i-nha bôm, dyôn ada cư. <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />Iki la, cư khoiq cơt ti-cuôi pi-con na i-nha co ntêr callong lư dyôn i-nha? <verse eid="GAL 4:16" /><verse number="17" style="v" sid="GAL 4:17" />Máh ti-cuôi ngki ti-nớng tu-pứng a-lớng i-nha, tới la par-ngíh ŏ, ma nha-án ính car-yáh i-nha lư, dŏq i-nha ti-nớng tu-pứng a-lớng nha-án. <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />Ma chiuq ti-nớng tu-pứng cứp nốh dyôn callong ŏ ngki ŏ, a-lứng tới nưm ndóng cư át a-lớng i-nha. <verse eid="GAL 4:18" /><verse number="19" style="v" sid="GAL 4:19" />Top a-cái na cư ơi, co top i-nha ma cư chiuq callong a-ái mu chư sa ti-ngôi díh ndóng Yang Choi Ta-mống bôn cơt sút tớq top i-nha — <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />ma, cư ng-cong át tar-mán a-lớng top i-nha hoi ndô táp a-lứng iên rêh par-nai ntêr na cư, co cư sáng rớu ri te top i-nha.<verse eid="GAL 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />Ndô máh ti-cuôi ính át ta-dưp phep rit, cóq dyôn cư chom, i-nha lớiq cam-máng phep rit? <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />Co bôn par-nai ta-ran tông A-pra-ham bôn bar a-cái conh, mui la te ti-cuôi cán táq sol, a-lứng mui la te ti-cuôi cán tới sol. <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />Ma, ndon a-cái te ti-cuôi cán táq sol bôn car-nian veng sac sáiq, ma ndon a-cái te ti-cuôi cán tới sol bôn car-nian co par-nai ưq. <verse eid="GAL 4:23" /><verse number="24" style="v" sid="GAL 4:24" />Máh ar-náq ndô ngki la tông dŏq a-rớq mui par-nai a-cám, co bar náq cán ngki la bar nốh car-hŏt. Mui car-hŏt tớq cóh Si-nai, car-nian a-cái táq sol. Ngki la Ha-car. <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />Ha-car la cóh Si-nai tớq A-rap, la mu chứng a-rớq vel Yaru-salem hoi ndô, co vel ngki a-lớng a-cái a-con án chón táq sol. <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />Ma Yaru-salem tớq pilŏ́ng ngki lớiq sol, ma ngki la a-i na top he. <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />Co bôn par-nai ta-ran:</para>
  <para style="q" vid="GAL 4:27">“Cóq bui ŏ, ơi ti-cuôi bánh, la ti-cuôi cán lớiq car-nian;</para>
  <para style="q" vid="GAL 4:27">cóq ta-cang dyôn yứng, ơi ti-cuôi lớiq a-ái co car-nian a-cái;</para>
  <para style="q" vid="GAL 4:27">Co a-cái a-con na ti-cuôi cán ngai táh clứng hơn a-cái a-con na ti-cuôi cán bôn ca-yiêq.”<verse eid="GAL 4:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="GAL 4:28" />Em ai ơi, mu chứng a-rớq I-sac, i-nha la a-cái na par-nai ưq. <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />Ma, mu chứng a-rớq i-nớh, a-cái ndon car-nian veng sac sáiq táq diêiq a-rức ada a-cái veng Ar-vai Yang la i-mo, ngki hoi ndô lư mu chứng iki. <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />Ma Tám U-ráq Yang tông a-mớh? “Cóq chuih ti-cuôi cán ndon sol a-lứng a-cái na án. Co a-cái na ti-cuôi cán ndon sol lư ar-lớih lư lớiq ưlla a-lứng a-cái na ti-cuôi cán ndon tới sol.” <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />Co iki, em ai ơi, top he tới la a-cái na ti-cuôi cán ndon sol, ma la a-cái na ti-cuôi cán ndon tới sol.<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />Yang Choi Ta-mống khoiq ta-láh top he dŏq bôn lớiq sol. Co iki, cóq ta-yứng khớm nha êq chiuq diêiq a-rức ngê sol nnáng.<verse eid="GAL 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2" />Seq me a-ŏ, cư, Phau-lô, tông ada i-nha chom, khán i-nha ính táq rit kít, ngki Yang Choi Ta-mống lư lớiq cơt tar-náp a-mớh dyôn i-nha lớng. <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />Cư ính tông mu chư sa dyôn cứp náq táq rit kít la ti-cuôi ngki bôn ar-náq táq cóq peh nhéq máh phep rit. <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />Em ai mmo ính át ti-nớng ŏ co phep rit Isa-ra-el khoiq cu-luai táh Yang Choi Ta-mống, khoiq táq pít callong choi mat. <verse eid="GAL 5:4" /><verse number="5" style="v" sid="GAL 5:5" />Ma te top he, nhơ Ar-vai Yang, co callong tin, top he nhéq tar-ngứh tar-hơ át pớn dŏq ng-cong te callong ti-nớng ŏ. <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />Co te Yang Choi Ta-mống Yê-su, callong tar-náp tới la rit kít, a-láng lớiq rit kít, ma la callong tin chón táq ar-náq na callong ar-moih. <verse eid="GAL 5:6" /><verse number="7" style="v" sid="GAL 5:7" />I-nha chón car-lúh lư hôi. Nnáu khoiq ca-táng i-nha dŏq lớiq bôn ngê piaiq táq veng? <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />Callong par-chuôt ngki lớiq tớq te Án rêh arô i-nha! <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" />Mu biq bôt pôih táq dyôn pôih díh cúc bôt pôih. <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />Tớq Yang, cư bôn callong tin ar-lớih te i-nha, ngki i-nha lư lớiq par-ngíh can-nŏ́h hơ. Ma, ti-cuôi mmo táq rúng mít i-nha lư cóq ráp tôt, ntro cứp náq ti-cuôi ngki la nnáu. <verse eid="GAL 5:10" /><verse number="11" style="v" sid="GAL 5:11" />Ma, em ai ơi, khán cư yôl ca to táq rit kít ma i-mo cư yôl ngai cauq? Khán iki callong táq luaih co te a-long calláng khoiq táh viang dyơ. <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />Cư ng-cong ính máh ti-cuôi táq diêiq a-rức i-nha lư lát bôm nha-án.<verse eid="GAL 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13" />Em ai ơi, co i-nha khoiq bôn rêh arô tớq callong iên ŏ, nưm la callong iên ŏ tới dŏq a-tớq liêh máh ngê dyôn veng sac sáiq, piaiq lư, cóq tar-choi ada tar-tuôq co callong ar-moih. <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />Co nhéq máh phep rit la pa-chúng cơt mui callong pa-táp: “A-cái cóq a-moih ti-cuôi át pa-niar a-cái a-rớq cháq bôm.” <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />Ma khán i-nha táq dyôn a-ái a-lứng tar-cáp tar-tuôq, cóq mmứng a-ŏ, dáh lơ i-nha car-chet a-lớng tar-tuôq.<verse eid="GAL 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />Iki, cư yua idô, cóq veng nưm ngê Ar-vai Yang, ngki i-nha lư ar-lớih lớiq táq veng nnáng máh can-nính ính na sac sáiq. <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" />Co sac sáiq ính ndái te Ar-vai Yang, ma Ar-vai Yang ính ndái te sac sáiq. Co bar ngê lớiq tar-cluôq a-lớng mu nơi, co iki ớq bôn ar-náq khán i-nha ính máh nốh ndô, ngki át táq. <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />Ma khán i-nha bôn Ar-vai Yang par-yông, i-nha lớiq túh veng phep rit. <verse eid="GAL 5:18" /><verse number="19" style="v" sid="GAL 5:19" />Máh ar-náq táq tớq sac sáiq la ar-lớih tháng, nha-án la: láh par-lưi, lớiq práh ŏ, pang tu-mống lới, <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />sang rup can-nŏ́h, cơt mo, cơt pi-con, ính tar-luaih, i-ôiq, chái nháih, tar-píh sút, lớiq tár ŏ, car-yáh, <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />i-ôiq cu-míq, bol plêc, ham ngoiq cha a-lứng máh nốh mu chứng máh nốh ndô, ma te ar-náq ngki cư ca-tớih i-nha, a-rớq cư khoiq ca-tớih tro ndô, ngki ti-cuôi mmo táq máh ar-náq a-rớq ngki lư ớq bôn ráp cruông na Yang Arbang Pilŏ́ng. <verse eid="GAL 5:21" /><verse number="22" style="v" sid="GAL 5:22" />Ma cu-lái te Ar-vai Yang la callong ar-moih, bui hơr, iên ŏ, chiuq ta-nhir, khun phep, mít sruiq, ti-nớng tu-pứng, <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />a-siar cháq, bán ŏ cháq bôm; lớiq bôn phep rit mmo ca-táng ada máh ar-náq a-rớq ngki. <verse eid="GAL 5:23" /><verse number="24" style="v" sid="GAL 5:24" />Ma, máh ti-cuôi ưlla na Yang Choi Ta-mống Yê-su khoiq téh díng ngê tớq sac sáiq a-lứng máh callong ính nha táq ar-náq saq tớq a-long calláng.<verse eid="GAL 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GAL 5:25" />Khán top he tu-mống nhơ Ar-vai Yang, top he cóq veng ta-pun Ar-vai Yang. <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />Êq dyôn cơt a-sớr cháq ndóng tar-chơiq tar-tuôq, i-ôiq cu-míq tar-tuôq.<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />Em ai ơi, khán bôn ti-cuôi ngki bôn tu-múh tớq callong luaih mmo, i-nha la ti-cuôi na ar-vai cóq ca to ti-cuôi ngki ial mít khun, ma cóq me a-ŏ cháq bôm, dáh lơ i-nha loi yáh par-yông. <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />Cóq dual crơng ntáng ada tar-tuôq, nha co iki i-nha lư táq nhéq phep rit na Yang Choi Ta-mống. <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />Co Khán nnáu par-ngíh án la ti-cuôi sút, ma lư tới la sút a-mớh, ti-cuôi ngki chóng pi-lốh án. <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />Ma cứp ti-cuôi cóq me liêh ar-náq án, dyơ ndóng ngki ti-cuôi ngki lư têq dŏq pu-pưt ngki te cháq án, ma lớiq túh ta-ring a-lớng ti-cuôi can-nŏ́h. <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />Co cứp ti-cuôi lư dual crơng ntáng na án táp.<verse eid="GAL 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6" />Ma, ti-cuôi ndon rian par-nai Yang cóq mpô te cứp nốh ŏ ada ti-cuôi ca to án. <verse eid="GAL 6:6" /><verse number="7" style="v" sid="GAL 6:7" />Êq dyôn ngai pi-lốh. Yang Arbang Pilŏ́ng lớiq têq ayê tar-ac lớng, co khán ti-cuôi trứh a-mớh ngki lư sot ngki. <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />Ti-cuôi chóh ada sac sáiq án lư te sac sáiq bôn sot callong cu-chet. Ma ti-cuôi chóh ada Ar-vai Yang lư te Ar-vai Yang bôn sot callong tu-mống díh sút pang. <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />Top he êq a-leq a-láh ndóng táq ar-náq ŏ, co tớq piaiq i-ngái, top he lư bôn cu-lái tar-náp khán he lớiq pê can-nính. <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />Khán iki, tớq ndóng top he têq táq, top he cóq táq ar-náq ŏ dyôn cứp ti-cuôi, ma pưt lư la dyôn máh ti-cuôi tớq dúng su na callong tin.<verse eid="GAL 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />Cóq me máh chưq pưt i-mo cư khoiq ta-ran dyôn i-nha na lư ati cư. <verse eid="GAL 6:11" /><verse number="12" style="v" sid="GAL 6:12" />Clứng ti-cuôi ính náh nnan táq ŏ tớq sac sáiq, nha-án pa-tot i-nha táq rit kít, nưm dŏq nha-án viar te ngai táq diêiq a-rức te a-long calláng na Yang Choi Ta-mống Yê-su. <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />Co díh máh ti-cuôi táq rit kít ngki lư lớiq táq veng phep rit, ma nha-án ính i-nha táq tíc rit kít dŏq nha-án têq cu-hống tớq sac sáiq na i-nha. <verse eid="GAL 6:13" /><verse number="14" style="v" sid="GAL 6:14" />Ma ada cư, seq lớiq callong a-mớh cơt dŏq cu-hống nưm te a-long calláng na Yang Choi Ta-mống Yê-su, Yang top he, co a-long calláng ngki, pang ndô ma ada cư khoiq ngai téh díng, a-lứng cư ada pang ndô la mu chứng. <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />Co tới ar-náq táq rit kít lư cơt tar-náp a-mớh, mu chứng tới ar-náq lớiq rit kít, ma lư la cóq cơt ti-cuôi tam-me. <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />A-lứng khán cứp náq ti-cuôi lư veng ngê dŏq a-nát ndô, callong iên ŏ nha callong ar-moih át tớq nha-án, a-lứng tớq ti-cuôi Isa-ra-el na Yang Arbang Pilŏ́ng.<verse eid="GAL 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17" />Tư ndô chô mát, seq êq nnáu táq pi-diêiq ada cư, co cư chón cliau tớq cháq cư máh tíc callêr na Yang Yê-su.<verse eid="GAL 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18" />Em ai ơi, seq callong choi mat na Yang he, Yang Choi Ta-mống Yê-su át tớq mít can-nính i-nha. A-men.<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>