  <book code="1PE" style="id">EN_PCLT pac_Pacoh_ltr Thu Apr 09 2026 09:32:00 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">1 Peter</para>
  <para style="toc1">Chớiq A-lang Phi-er Mui</para>
  <para style="toc2">Phi-er Mui</para>
  <para style="toc3">1Pe</para>
  <para style="mt">Phi-er Mui</para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />Phi-er, dyưng ati na Yang Choi Ta-mống Yê-su, cơiq dyôn máh ti-cuôi khoiq bôn rêh te máh ti-cuôi prái át pláh chap cứp ntúq tớq cruông Pôn-tu, Ca-la-ti, Cap-ba-dôc, A-si nha Bi-thi-ni, <verse eid="1PE 1:1" /><verse number="2" style="v" sid="1PE 1:2" />veng callong chom nsuôi na Yang Arbang Pilŏ́ng, la A-ám, co callong ndái na Yang Ar-vai dyôn callong náp peh a-lứng khoiq hóc a-ham na Yang Choi Ta-mống Yê-su. Seq callong choi mat a-lứng callong iên ŏ dyôn clưi clưai nga i-nha.<verse eid="1PE 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />Lư si-ơn te Yang Arbang Pilŏ́ng a-lứng A-ám na Yang top he, Yang Choi Ta-mống Yê-su, Án bôn mít sruiq-táq pưt lư te Án, khoiq car-nian liêh top he tớq callong ng-cong tu-mống nhơ callong tu-mống na Yang Choi Ta-mống Yê-su te cu-chet, <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />par-ngíh nga mun chín lớiq rúng pít, lớiq prớq a-lứng lớiq cloiq, khoiq dŏq car-siat tớq pilŏ́ng ada i-nha, <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />la dyôn ada máh ti-cuôi nhơ callong tin, bôn bán kiaq te chức Yang Arbang Pilŏ́ng dyôn callong ta-mống, la nốh ính dŏq a-páh tớq i-ngái talloiq tháng. <verse eid="1PE 1:5" /><verse number="6" style="v" sid="1PE 1:6" />Co iki, i-nha bui hơr lư, ntro lư hoi ndô cóq bôn chiuq a-nguaq mu hoi sớng te a-ưi nốh callong chim <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />dyôn têq callong ính chom te callong tin na i-nha — nốh tar-náp clưi dyeng, la crơng ndon têq rúng ma yôl bôn ngai bóh thứq tớq uih — têq bôn hôm dŏq tớq nga callong cứh ayô, ang ưr a-lứng dyám náp tớq callong a-páh na Yang Choi Ta-mống Yê-su, <verse eid="1PE 1:7" /><verse number="8" style="v" sid="1PE 1:8" />Án ndon i-nha a-moih ntro i-yốh hôm, hoi ndô ntro ớq hôm Án ma co tin te Án, iki i-nha bui hơr te callong bui chom i-mo nnáng a-lứng bôn máng ang ưr, <verse eid="1PE 1:8" /><verse number="9" style="v" sid="1PE 1:9" />bôn ráp cu-lái te callong tin na i-nha, callong choi ta-mống ar-vai. <verse eid="1PE 1:9" /><verse number="10" style="v" sid="1PE 1:10" />Máh ti-cuôi tang ng-cang khoiq ti-tuaiq a-lứng plốh car-siat lư te callong choi ta-mống ndô, ngki la máh ti-cuôi khoiq tông a-cớiq te callong choi mat dyôn ada i-nha, <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />ndóng ti-tuaiq te ti-cuôi mmo a-láng ali mmo ma Ar-vai na Yang Choi Ta-mống tớq nha-án khoiq a-páh, dyôn chom nsuôi te callong chiuq diêiq a-rức na Yang Choi Ta-mống a-lứng callong ang ưr vít máh ar-náq ngki. <verse eid="1PE 1:11" /><verse number="12" style="v" sid="1PE 1:12" />Ar-náq khoiq bôn a-páh ada nha-án, ngki la nha-án lớiq táq ar-náq ada nha-án bôm, ma ada i-nha, te máh ar-náq ma hoi ndô khoiq bôn taq-ntêr ada i-nha na máh ti-cuôi ndon pau ntêr Par-nai ŏ Yang dyôn i-nha te Yang Ar-vai khoiq yua te pilŏ́ng — te ar-náq ngki, máh tar-neng ng-cong bôn hôm.<verse eid="1PE 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />Co iki, cóq át me níc te par-ngíh i-nha a-rớq ki-tớn pa-eu, cóq mmứng níc, cóq dŏq callong ng-cong nga callong choi mat bôn dông a-tớq dyôn i-nha tớq callong a-páh na Yang Choi Ta-mống Yê-su. <verse eid="1PE 1:13" /><verse number="14" style="v" sid="1PE 1:14" />A-rớq a-cái a-con chom cam-máng par-nai, êq táq veng máh can-nính ính bôn ndóng nsuôi te callong báq ayê na i-nha, <verse eid="1PE 1:14" /><verse number="15" style="v" sid="1PE 1:15" />ma piaiq lư, a-rớq Án khoiq rêh arô i-nha la práh ŏ, lư i-nha táp cóq cơt práh ŏ cứp nốh tớq pang tu-mống na i-nha. <verse eid="1PE 1:15" /><verse number="16" style="v" sid="1PE 1:16" />Co bôn par-nai ta-ran: “Top i-nha lư cơt práh ŏ co Cư la práh ŏ.” <verse eid="1PE 1:16" /><verse number="17" style="v" sid="1PE 1:17" />A-lứng khán i-nha dŏq Án sưq cơt lớiq li veng ar-náq táq na cứp náq ti-cuôi la “A-ám”, cóq tu-mống te mít dyám náp chón yôl át dơq na i-nha, <verse eid="1PE 1:17" /><verse number="18" style="v" sid="1PE 1:18" />co chom ar-lớih tới te máh crơng têq rúng pít a-rớq práq lớiq la dyeng i-nha khoiq bôn thái vít te ngê tu-mống ớq tar-náp na i-nha co a-chúc a-chiac dyôn liêh, <verse eid="1PE 1:18" /><verse number="19" style="v" sid="1PE 1:19" />ma la nhơ a-ham tar-náp na Yang Choi Ta-mống, a-rớq cưu a-cái lớiq bôn bác a-lứng lớiq bôn prớq, <verse eid="1PE 1:19" /><verse number="20" style="v" sid="1PE 1:20" />khoiq dŏq a-nát nsuôi teng pilŏ́ng cu-teq, ma dŏq a-páh tớq pang talloiq ndô co te i-nha, <verse eid="1PE 1:20" /><verse number="21" style="v" sid="1PE 1:21" />la máh ti-cuôi nhơ Án tin te Yang Arbang Pilŏ́ng, Án khoiq dyôn Yê-su tu-mống liêh te cu-chet a-lứng dyôn ang ưr ada Án, dŏq callong tin nha callong ng-cong na i-nha át tớq Yang Arbang Pilŏ́ng. <verse eid="1PE 1:21" /><verse number="22" style="v" sid="1PE 1:22" />Ndóng khoiq a-rau práh ar-vai i-nha co callong náp peh callong piaiq bôn callong ar-moih em ai ti-nớng lư, i-nha cóq a-moih tar-tuôq nhéq tar-ngứh te mít práh ŏ, <verse eid="1PE 1:22" /><verse number="23" style="v" sid="1PE 1:23" />co khoiq bôn car-nian, tới te mma têq rúng pít, ma te mma lớiq têq rúng pít, co par-nai tu-mống a-lứng yôl níc na Yang Arbang Pilŏ́ng. <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" />Co te:</para>
  <para style="q1" vid="1PE 1:24">“Cứp náq ti-cuôi a-rớq sác,</para>
  <para style="q1" vid="1PE 1:24">a-lứng cứp ang ưr na án a-rớq piêr sác.</para>
  <para style="q1" vid="1PE 1:24">Sác ráng, a-lứng piêr sráh,<verse eid="1PE 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="1PE 1:25" />ma par-nai Yang yôl díh sút pang.”</para>
  <para style="q1" vid="1PE 1:25">Ngki la Par-nai ŏ Yang khoiq dŏq ca to dyôn i-nha.<verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />Co iki, ndóng khoiq táh viang cứp callong saq, cứp callong a-uai a-lứng ngê náh nnan, báq i-ôiq cu-míq nha máh par-nai u-saq, <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />a-rớq ngai a-cái mbơiq car-nian, cóq ham uq dơq tóh te pilŏ́ng práh lư, co te ngki i-nha têq táq dyôn pưt a-sớr díh callong choi ta-mống, <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" />khán i-nha khoiq thứq chom dyơ Yang ti-nớng ŏ, <verse eid="1PE 2:3" /><verse number="4" style="v" sid="1PE 2:4" />ndóng tớq tu-mán nga Án, la cúc búl tu-mống, khoiq ngai táh, ma khoiq dŏq rêh tar-náp lư chứng mát Yang Arbang Pilŏ́ng, <verse eid="1PE 2:4" /><verse number="5" style="v" sid="1PE 2:5" />a-lứng lư i-nha, a-rớq máh cúc búl tu-mống, khoiq bôn ngai man táq car-rong dúng sang yang dyôn ada thới teng rit sang práh ŏ dŏq mŏp sang crơng tớq dúng sang yang ndon bui can-nính Yang Arbang Pilŏ́ng na Yang Choi Ta-mống Yê-su. <verse eid="1PE 2:5" /><verse number="6" style="v" sid="1PE 2:6" />Co iki, par-nai ndô bôn ta-ran tớq Tám U-ráq Yang:</para>
  <para style="q1" vid="1PE 2:6">“Me ndô, Cư dŏq tớq Si-ôn mui cúc búl ta-nang,</para>
  <para style="q1" vid="1PE 2:6">khoiq dŏq rêh, lư tar-náp lư.</para>
  <para style="q1" vid="1PE 2:6">A-lứng nnáu tin te Án lư ar-lớih lớiq bôn pít callong ng-cong.”<verse eid="1PE 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 2:7" />Co iki, callong tar-náp ngki dyôn ada i-nha la máh ti-cuôi tin. Ma dyôn ada máh ti-cuôi lớiq tin:</para>
  <para style="q1" vid="1PE 2:7">“Cúc búl ndon máh thơq man khoiq táh,</para>
  <para style="q1" vid="1PE 2:7">búl ngki khoiq cơt búl lác dúng,”<verse eid="1PE 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 2:8" />a-lứng</para>
  <para style="q1" vid="1PE 2:8">“Cúc búl táq ki-dúh dyưng, cúc búl táq dyôn dứm.”</para>
  <para style="p" vid="1PE 2:8">Nha-án cơt dứm co lớiq cam-máng par-nai Yang, ma te ar-náq ndô nha-án lư khoiq dŏq a-nát dyơ. <verse eid="1PE 2:8" /><verse number="9" style="v" sid="1PE 2:9" />Ma i-nha a-rớq mma khoiq dŏq rêh, a-riaih teng rit sang dúng puô, prái bau práh ŏ, mu náq prái ưlla sút, dŏq i-nha pau ntêr máh ar-náq si-leh te Án khoiq arô i-nha ngốh te ntúq ngiau mot tớq callong ang ŏ lư na Án, <verse eid="1PE 2:9" /><verse number="10" style="v" sid="1PE 2:10" />ma i-nha te nsuôi “tới mu náq prái”, ma ndô “prái na Yang Arbang Pilŏ́ng”; máh ti-cuôi cơi “ớq bôn callong sruiq”, ma ndô khoiq “bôn callong sruiq”.<verse eid="1PE 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />I-nha a-moih lư ơi, cư seq pa-táp i-nha, a-rớq máh ti-cuôi át dơq a-lứng ti-cuôi tu-moi, cóq viar yông máh nốh ham tớq sac sáiq, la nốh ndon chíl liêh ada ar-vai i-nha, <verse eid="1PE 2:11" /><verse number="12" style="v" sid="1PE 2:12" />cóq mmứng te pang tu-mống na i-nha ada ŏ tớq top máh ti-cuôi tới Isa-ra-el, dŏq dyơ, tớq callong a-mớh nha-án ntêr saq te i-nha a-rớq máh ti-cuôi táq lớiq ŏ, co khoiq hôm máh ar-náq ŏ na i-nha, nha-án têq cứh ayô Yang Arbang pilŏ́ng tớq i-ngái tớq liêh.<verse eid="1PE 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13" />Co te Yang, cóq cam-máng cứp chức sút na ti-cuôi, dáh lơ ngki la puô a-rớq ti-cuôi ndon sút pưt, <verse eid="1PE 2:13" /><verse number="14" style="v" sid="1PE 2:14" />lớiq la máh ti-cuôi sút, a-rớq máh ti-cuôi bôn puô yua dông a-tớq callong pa-cliêq ti-cuôi táq lớiq ŏ nha callong ayô ti-cuôi táq ŏ. <verse eid="1PE 2:14" /><verse number="15" style="v" sid="1PE 2:15" />Co ndô la can-nính na Yang Arbang Pilŏ́ng: táq ar-náq ŏ dŏq táq dyôn máh ti-cuôi ndon a-chơ lớiq a-púh cóq ca-bip ng-cang, <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />cóq tu-mống a-rớq máh ti-cuôi lớiq bôn sol, nha lớiq cưm te tới sol na i-nha a-rớq pul ca-tốq dyôn ar-náq lớiq ŏ, ma a-rớq máh ti-cuôi sol na Yang Arbang Pilŏ́ng. <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />Cóq dyám náp cứp náq ti-cuôi. Cóq a-moih em ai i-nha. Cóq a-dáh Yang Arbang Pilŏ́ng. Cóq dyám náp puô.<verse eid="1PE 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />Ơi i-nha ndon táq ar-náq, cóq cam-máng ưlla i-nha ngki nhéq te mít dyám náp, tới nưm ti-cuôi ưlla ŏ a-lứng khun, ma díh ti-cuôi ưlla crêng hơ. <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />Co khán nnáu chiuq ta-nhir callong a-nguaq tớq ndóng tu-múh diêiq a-rức callong lớiq li co te can-nính ính veng ngê Yang Arbang Pilŏ́ng, ngki la mui callong bún. <verse eid="1PE 2:19" /><verse number="20" style="v" sid="1PE 2:20" />Bôn tar-náp a-mớh khán táq luaih dyơ i-nha cóq chiuq ngai púh? Ma khán táq ŏ dyơ i-nha cóq chiuq ta-nhir callong diêiq a-rức, ngki la mui callong bún chứng mát Yang Arbang Pilŏ́ng. <verse eid="1PE 2:20" /><verse number="21" style="v" sid="1PE 2:21" />Co i-nha khoiq bôn dŏq rêh arô tớq callong ngki, co Yang Choi Ta-mống lư khoiq diêiq a-rức tang i-nha, dŏq liêh ngôl ada i-nha dyôn i-nha têq pôq veng lám dyưng Án,<verse eid="1PE 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1PE 2:22" />“Án lớiq táq luaih,</para>
  <para style="q1" vid="1PE 2:22">lư lớiq bôn par-nai a-uai mmo bôn sáng te ng-cang Án”;<verse eid="1PE 2:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="1PE 2:23" />la Án ndóng ngai ayê tar-ac, Án lớiq bôn ôi liêh; ndóng chiuq diêiq a-rức, Án lớiq can-nốh, ma Án mŏp án dyôn Yang Arbang Pilŏ́ng tar-sưq ti-nớng tu-pứng; <verse eid="1PE 2:23" /><verse number="24" style="v" sid="1PE 2:24" />lư Án táp khoiq dông callong luaih top he tớq cháq Án tớq a-long calláng, dŏq dyơ vít cu-chet dyôn ada callong luaih, top he bôn tu-mống ada callong ti-nớng ŏ, nhơ máh bác chol na Án ma i-nha khoiq bôn pa-lai bánh. <verse eid="1PE 2:24" /><verse number="25" style="v" sid="1PE 2:25" />Co i-nha la a-rớq cưu ndon clu car-na, ma ndô i-nha khoiq bôn píh chô nga Án bán cưu a-lứng Án Kiaq Me na ar-vai i-nha.<verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />Ơi i-nha la máh cam-pái, la mu chứng iki, cóq cam-máng ca-yiêq i-nha, ma khán bôn mu náq ca-yiêq lớiq cam-máng par-nai yang, co te pang tu-mống na cam-pái lớiq taq-ntêr tớq par-nai, ma ndon ca-yiêq lư têq cam-máng, <verse eid="1PE 3:1" /><verse number="2" style="v" sid="1PE 3:2" />vít dyơ bôn hôm pang tu-mống práh ŏ a-lứng callong dyám náp na top i-nha, <verse eid="1PE 3:2" /><verse number="3" style="v" sid="1PE 3:3" />ma tam-pớc na i-nha ndon cán tới nưm tớq cu-lái tiêh clanh sóc a-lứng ta-miat crơng dyeng, lớiq la tớc tam-pớc a-maiq, <verse eid="1PE 3:3" /><verse number="4" style="v" sid="1PE 3:4" />ma la mít can-nính na ti-cuôi te callúng, a-lứng callong ŏ yôl níc na can-nính lam-bŏt nha lớiq cang, callong ngki la tar-náp chứng mát Yang Arbang Pilŏ́ng. <verse eid="1PE 3:4" /><verse number="5" style="v" sid="1PE 3:5" />Co máh ti-cuôi cán te i-nớh, la máh ti-cuôi dŏq ng-cong nga Yang Arbang Pilŏ́ng, lư khoiq cơt dêu te cháq a-rớq ngki ndóng cam-máng ca-yiêq nha-án, <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" />a-rớq Sa-ra khoiq cam-máng par-nai A-pra-ham ndóng dŏq án la yang, ma i-nha bôn cơt a-cái a-mon na án ndóng táq ar-náq ŏ a-lứng lớiq a-dáh te mui callong can-nốh mmo.<verse eid="1PE 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7" />Ơi i-nha la máh ndon ca-yiêq, mu chứng ngki, na callong chom, cóq tu-mống mu nơi a-lứng cam-pái co án la ti-cuôi iêuq, ma cóq mpô callong dyám náp a-rớq ti-cuôi bôn chúng phê callong choi mat na callong tu-mống, dyôn têq callong cớu seq na i-nha lớiq bôn táh ca-táng.<verse eid="1PE 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />Talloiq lư, nhéq náq cóq sŏ́ng mui par-ngíh, bôn callong sruiq, callong ar-moih em ai, mít lam-bŏt, callong a-siar cháq, <verse eid="1PE 3:8" /><verse number="9" style="v" sid="1PE 3:9" />êq ial lớiq ŏ cu-liêh lớiq ŏ, lớiq la par-nai a-craiq ôi liêh par-nai a-craiq, ma piaiq lư, cóq cớu seq callong ŏ, co i-nha khoiq dŏq arô tớq callong ngki, dŏq i-nha bôn ráp bún ŏ.<verse eid="1PE 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1PE 3:10" />Co,</para>
  <para style="q1" vid="1PE 3:10">“Nnáu ính a-moih callong tu-mống a-lứng hôm i-ngái iên ŏ</para>
  <para style="q2" vid="1PE 3:10">cóq chom bán ng-cang án te callong lớiq ŏ, a-lứng ng-cang án lớiq taq-ntêr par-nai a-uai.<verse eid="1PE 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11" />Ti-cuôi ngki cóq viar te ar-náq saq a-lứng cóq táq ar-náq ŏ.</para>
  <para style="q1" vid="1PE 3:11">Ti-cuôi ngki cóq si-suô dyôn iên ŏ a-lứng cóq tár veng ar-náq ngki, <verse eid="1PE 3:11" /><verse number="12" style="v" sid="1PE 3:12" />co</para>
  <para style="q1" vid="1PE 3:12">mát Yang át tớq ti-cuôi ti-nớng ŏ nha cu-tor Án át tar-mán par-nai cớu seq na nha-án,</para>
  <para style="q2" vid="1PE 3:12">ma mát Yang ính táq liêh ti-cuôi táq lớiq ŏ.”<verse eid="1PE 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13" />Nnáu la ti-cuôi lư ính táq i-nha khán i-nha cơt máh ti-cuôi nhéq mít can-nính te ar-náq ŏ? <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" />Ma, ntro i-nha díh cóq chiuq a-rức co callong ti-nớng ŏ, i-nha lư bôn bún. Ma, êq cơt a-dáh a-rớq callong a-dáh na nha-án, a-lứng êq díh rớu ri, <verse eid="1PE 3:14" /><verse number="15" style="v" sid="1PE 3:15" />ma cóq dyám náp Yang Choi Ta-mống, la Yang tớq mít i-nha, nic-níc sŏ́ng ada ar-náq dŏq ôi khán nnáu plốh i-nha co ính dyôn callong ng-cong tớq i-nha, <verse eid="1PE 3:15" /><verse number="16" style="v" sid="1PE 3:16" />ma cóq ada khun phep a-lứng dyám náp, co bôn ngê ngúc ŏ dŏq tớq ar-náq a-mớh ma ngai ton a-pít i-nha, máh ti-cuôi pa-mat te ar-náq ŏ na i-nha tớq Yang Choi Ta-mống cóq sáng a-chiêt. <verse eid="1PE 3:16" /><verse number="17" style="v" sid="1PE 3:17" />Co khán la can-nính Yang Arbang Pilŏ́ng ính, the chiuq diêiq táq ar-náq ŏ, a-láng la táq ar-náq saq. <verse eid="1PE 3:17" /><verse number="18" style="v" sid="1PE 3:18" />Co Yang Choi Ta-mống lư khoiq cơi chiuq a-rức co callong luaih — Án ti-nớng ŏ cu-chet tang ti-cuôi lớiq ti-nớng ŏ — dŏq Án têq dông top he tớq nga Yang Arbang Pilŏ́ng, dyơ ndóng cu-chet te sac sáiq ndon bôn têq táq dyôn tu-mống tớq ar-vai, <verse eid="1PE 3:18" /><verse number="19" style="v" sid="1PE 3:19" />tớq ar-vai ngki, Án lư khoiq ca to ndóng bôn tớq nga ar-vai át tớq cŏq tôt, <verse eid="1PE 3:19" /><verse number="20" style="v" sid="1PE 3:20" />la máh ti-cuôi te nsuôi lớiq cam-máng ndóng callong chiuq ta-nhir na Yang Arbang Pilŏ́ng át pớn tớq pang Nô-ê, chón ndóng tuôc khoiq táq, ma tớq tuôc ngki, bôn ti-cuôi — ngki la ti-col ar-vai — khoiq bôn choi ta-mống na dơq, <verse eid="1PE 3:20" /><verse number="21" style="v" sid="1PE 3:21" />ma ngki la lư tíc hoi ndô choi ta-mống i-nha, rit tíc na dơq — tới ar-náq têq a-tức táq dyôn práh tớq cháq, ma la callong par-ưq na mít can-nính ŏ dyôn ada Yang Arbang Pilŏ́ng — nhơ callong tu-mống liêh na Yang Choi Ta-mống Yê-su, <verse eid="1PE 3:21" /><verse number="22" style="v" sid="1PE 3:22" />la Án, vít dyơ sớr nga pilŏ́ng, dyơ ti-cu pa a-tớm Yang Arbang Pilŏ́ng, máh tar-neng a-lứng máh án bôn chức nha máh chức sút lư cam-máng Án.<verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />Khán iki, co Yang Choi Ta-mống khoiq chiuq a-rức tớq sac sáiq, i-nha lư cóq chiuq a-rức mu chứng a-rớq ngki, co ti-cuôi mmo khoiq chiuq a-rức tớq sac sáiq lớiq ính nnáng táq luaih, <verse eid="1PE 4:1" /><verse number="2" style="v" sid="1PE 4:2" />dŏq nhéq i-ngái yôl liêh tớq sac sáiq, lớiq bôn tu-mống dyôn nốh báq ham na ti-cuôi nnáng, ma dyôn can-nính na Yang Arbang Pilŏ́ng. <verse eid="1PE 4:2" /><verse number="3" style="v" sid="1PE 4:3" />Co i-ngái ki-sái khoiq táq cứp dŏq táq veng can-nính na ti-cuôi tới Isa-ra-el, ndóng tu-mống tớq pang tu-mống lới, ham crơng, bol plêc, ngoiq cha, táq ar-náq mmuaq a-lứng sang rup yang sáq lớiq cơt rit, <verse eid="1PE 4:3" /><verse number="4" style="v" sid="1PE 4:4" />ma tớq ar-náq ndô, nha-án sáng dut ndóng i-nha lớiq táq veng nha-án a-rớq mu chứng dơq tar-rúh na ar-náq lới nha yúh yúh, iki tông par-nai a-craiq; <verse eid="1PE 4:4" /><verse number="5" style="v" sid="1PE 4:5" />top nha-án lư a-ngốh par-nai ntêr chứng mát Án dŏq ính tar-sưq ti-cuôi tu-mống díh ti-cuôi cu-chet. <verse eid="1PE 4:5" /><verse number="6" style="v" sid="1PE 4:6" />Co te ar-náq ngki, Par-nai ŏ Yang ngki khoiq bôn ca to dyôn máh ti-cuôi khoiq cu-chet dyơ, ma ntro lư nha-án khoiq ráp tar-sưq veng thư ti-cuôi tớq sac sáiq, ma ndô nha-án têq tu-mống veng Yang Arbang Pilŏ́ng tớq ar-vai.<verse eid="1PE 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />Ma, i-ngái talloiq na túc cu-lám khám nốh khoiq ính tớq. Co iki, cóq hôi tu-báiq a-lứng cóq mmứng mŏp máh par-nai cớu seq; <verse eid="1PE 4:7" /><verse number="8" style="v" sid="1PE 4:8" />ma nsuôi lư cóq bôn callong ar-moih nhéq mít can-nính dyôn ada tar-tuôq, co callong ar-moih lư ca-tốq cứp nốh callong luaih; <verse eid="1PE 4:8" /><verse number="9" style="v" sid="1PE 4:9" />mít chom tu-moi a-lớng tar-tuôq ma bôn lớiq nhan-nha; <verse eid="1PE 4:9" /><verse number="10" style="v" sid="1PE 4:10" />veng a-rớq cứp náq ti-cuôi khoiq ráp mmar ar-náq, ial te ar-náq ngki dŏq ính choi ada tar-tuôq, a-rớq máh ti-cuôi kiaq hôi te callong choi mat bôn ndái nhéq na Yang Arbang Pilŏ́ng. <verse eid="1PE 4:10" /><verse number="11" style="v" sid="1PE 4:11" />Khán nnáu pau ca to — ngki a-rớq ntêr par-nai na Yang Arbang Pilŏ́ng; khán nnáu tar-choi ar-náq — ngki táq a-rớq na rêng ma Yang Arbang Pilŏ́ng khoiq dyôn, dŏq tớq cứp callong Yang Arbang Pilŏ́ng bôn ayô te Yang Choi Ta-mống Yê-su, la Án lư piaiq ang ưr a-lứng chức sút díh sút pang lang dơi. A-men.<verse eid="1PE 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />Em ai ndon a-moih lư ơi, êq sáng dut te pallô uih át tớq i-nha, ndóng mpáh te i-nha dŏq ính thứq, a-rớq ar-náq lớiq cơi cơt tớq ada i-nha, <verse eid="1PE 4:12" /><verse number="13" style="v" sid="1PE 4:13" />ma lư, veng liêh i-nha khoiq chiuq máh mmo a-ưi te callong diêiq a-rức na Yang Choi Ta-mống, cóq bui hơr, dyôn têq tớq callong a-páh ang ưr na Án, i-nha bôn sáng êm, bui nhéq cớq. <verse eid="1PE 4:13" /><verse number="14" style="v" sid="1PE 4:14" />Khán i-nha bôn ngai pa-mat co nốh Yang Choi Ta-mống, bôn bún, co Ar-vai na callong ang ưr a-lứng na Yang Arbang Pilŏ́ng, át tớq i-nha. <verse eid="1PE 4:14" /><verse number="15" style="v" sid="1PE 4:15" />Êq nnáu tớq i-nha chiuq a-rức a-rớq án ndon ca-chet ti-cuôi, ti-cuôi ti-tôiq, ti-cuôi táq lớiq ŏ, lớiq la a-rớq ti-cuôi tam-bơq ti-cuôi can-nŏ́h, <verse eid="1PE 4:15" /><verse number="16" style="v" sid="1PE 4:16" />ma khán chiuq a-rức la co Táq ar-náq Yang, ti-cuôi ngki êq a-chiêt, ma tớq nốh ngki cóq cứh ayô Yang Arbang Pilŏ́ng. <verse eid="1PE 4:16" /><verse number="17" style="v" sid="1PE 4:17" />Co khoiq tớq dyơ ta-bớq callong tar-sưq te dúng na Yang Arbang Pilŏ́ng; ma khán nsuôi lư te top he, ngki callong talloiq lư na máh ti-cuôi lớiq cam-máng Par-nai ŏ na Yang Arbang Pilŏ́ng lư cơt i-mo?<verse eid="1PE 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1PE 4:18" />A-lứng “Khán ti-cuôi ti-nớng ŏ diêiq bôn choi ta-mống,</para>
  <para style="q1" vid="1PE 4:18">ti-cuôi lớiq náp peh a-lứng ti-cuôi bôn luaih lư át tớq mmo?”<verse eid="1PE 4:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="1PE 4:19" />Co iki, máh ti-cuôi chiuq a-rức veng can-nính na Yang Arbang Pilŏ́ng cóq mŏp sang ar-vai án dyôn Án Teng Cơt callong ti-nớng tớq ar-náq táq ŏ.<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />Co iki, cư — ngki la ti-cuôi sút a-lứng la tíc te máh diêiq a-rức na Yang Choi Ta-mống, a-lứng la ti-cuôi chúng tưi ang ưr ính dŏq a-páh — seq pa-táp máh ti-cuôi sút tớq top i-nha: <verse eid="1PE 5:1" /><verse number="2" style="v" sid="1PE 5:2" />Cóq kiaq me cưu két na Yang Arbang Pilŏ́ng át tớq i-nha, táq ar-náq bán kiaq ŏ — êq táq a-rớq dŏq pa-tot, ma bui can-nính ính táq veng Yang Arbang Pilŏ́ng — a-lứng êq táq te cháq par-ngíh ham ính bôn lơi ma táq dyôn nhéq tar-ngứh tar-hơ; <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />a-lứng êq táq a-rớq la ti-cuôi sút máh ti-cuôi ndon Yang Arbang Pilŏ́ng khoiq yua táq, ma piaiq lư la cơt ngôl dyôn cưu két. <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />Dyơ vít ndóng Án Kiaq Cưu Sút Pưt khoiq mpáh, i-nha bôn ráp ŏ vom puô ang ưr lớiq têq cloiq. <verse eid="1PE 5:4" /><verse number="5" style="v" sid="1PE 5:5" />Mu chứng, máh ti-cuôi bánh ơi, cóq cam-máng máh ti-cuôi sút. Nhéq tưh cóq bôn callong êq pu-pưt ada tar-tuôq, co Yang Arbang Pilŏ́ng ính ca-táng ti-cuôi ndon pu-pưt, ma dyôn callong choi mat ada ti-cuôi lớiq pu-pưt. <verse eid="1PE 5:5" /><verse number="6" style="v" sid="1PE 5:6" />Co iki, cóq a-siar cháq i-nha ta-dưp ati bôn chức na Yang Arbang Pilŏ́ng dŏq Án a-sớr i-nha dyơ tớq piaiq i-ngái, <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />ndóng khoiq mŏp cứp callong rớu ri na i-nha ada Án, co Án bán kiaq i-nha. <verse eid="1PE 5:7" /><verse number="8" style="v" sid="1PE 5:8" />Cóq mmứng cóq tam-prán. Ti-cuôi pi-con na i-nha, la yang sáq, a-rớq cu-la át ring, chón ca-rong, suô ti-cuôi mmo dŏq ính cáp. <verse eid="1PE 5:8" /><verse number="9" style="v" sid="1PE 5:9" />Cóq táng chíl liêh án, ta-yứng khớm tớq callong tin, chom ar-lớih máh ti-cuôi tin na he tớq cúc cu-teq ndô cóq chiuq mu chứng máh diêiq a-rức a-rớq iki. <verse eid="1PE 5:9" /><verse number="10" style="v" sid="1PE 5:10" />Ma ndóng khoiq chiuq a-rức mu hoi sớng, Yang Arbang Pilŏ́ng na cứp callong choi mat, Án khoiq arô i-nha tớq nga ang ưr díh sút pang na Án tớq Yang Choi Ta-mống, lư Án táp dyôn ŏ liêh, tíc táq dyôn cơt rêng a-lứng rap chiuq ta-nhir. <verse eid="1PE 5:10" /><verse number="11" style="v" sid="1PE 5:11" />Seq dyôn cơt sút ưlla te Án dyôn díh sút pang. A-men.<verse eid="1PE 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />Nhơ Si-la, mu náq em ai ti-nớng lư veng a-rớq cư bôn hôm, cư khoiq ta-ran callong pưt sớng ada i-nha, a-liam a-lứng tíc ndô la callong choi mat lư na Yang Arbang Pilŏ́ng. Cóq ta-yứng khớm tớq callong choi mat ngki. <verse eid="1PE 5:12" /><verse number="13" style="v" sid="1PE 5:13" />Top tin tớq Ba-bi-lôn, top tin khoiq rêh arô a-rớq i-nha, cơiq par-nai a-lang i-nha. Mac, a-cái conh cư, la iki. <verse eid="1PE 5:13" /><verse number="14" style="v" sid="1PE 5:14" />Cóq car-bánh tar-tuôq na car-cháng callong ar-moih.</para>
  <para style="p" vid="1PE 5:14">Seq callong iên ŏ át a-lứng nhéq náq i-nha la máh ti-cuôi tớq Yang Choi Ta-mống.<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>