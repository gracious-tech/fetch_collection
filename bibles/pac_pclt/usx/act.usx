  <book code="ACT" style="id">EN_PCLT pac_Pacoh_ltr Tue May 12 2026 15:46:56 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Acts</para>
  <para style="toc1">Ar-náq Táq Máh Top Dyưng Ati</para>
  <para style="toc2">Ar-náq Táq</para>
  <para style="toc3">Act</para>
  <para style="mt">Ar-náq Táq Máh Top Dyưng Ati</para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />Ơi a-vốq Thê-ô-phi-lơ, cư khoiq táq dyơ phê ta-ran tôm lư te cứp callong ma Yang Yê-su khoiq táq a-lứng ca to, <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />díh tớq i-ngái Án bôn sớr nga pilŏ́ng, ndóng dyôn par-nai pa-táp co Yang Ar-vai dyôn top dyưng ati ma Án khoiq rêh, <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />mu chứng la máh ti-cuôi ndon Án khoiq a-páh lư án yôl tu-mống dyôn nha-án, vít dyơ Án khoiq chiuq diêiq a-rức, nha a-ưi na tíc, co khoiq a-páh ada nha-án nhéq puan chít i-ngái a-lứng ntêr máh ar-náq te cruông na Yang Arbang Pilŏ́ng. <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" />Ndóng nha-án tang-húng mu nơi, Án khoiq dyŏq top nha-án êq ngốh te vel Yaru-salem, ma cóq pớn par-nai par-ưq na A-ám, “la callong ndon i-nha khoiq sáng te cư, <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />dyơ Yon khoiq táq tíc na dơq, ma i-nha lư bôn táq tíc na Yang Ar-vai lớiq bôn dyut nnáng vít máh i-ngái ndô.”<verse eid="ACT 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />Co iki, ndóng sŏ́ng pôq mu nơi, nha-án plốh Án idô: “Yang ơi, lư ma lớiq Án táq liêh cruông dyôn Isa-ra-el tớq ndóng ndô?” <verse eid="ACT 1:6" /><verse number="7" style="v" sid="ACT 1:7" />Dyơ ngki, Án tông ada nha-án: “Callong dyôn ada i-nha dŏq chom tới la par-rứh a-láng i-ngái ma A-ám khoiq a-nát veng chức sút na Án. <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />Ma, i-nha lư bôn ráp chức sút ndóng Yang Ar-vai át tớq i-nha, a-lứng i-nha la máh tíc na cư tớq Yaru-salem, díh nga cruông Yu-dê, cruông Sa-ma-ri, a-lứng díh tớq talloiq cúc cu-teq ndô.” <verse eid="ACT 1:8" /><verse number="9" style="v" sid="ACT 1:9" />Cua dyơ tông máh par-nai ngki, ndóng nha-án yôl chón me, Án yưr sớr nga pilŏ́ng, a-lứng bôn tu-lúc ca-díl Án te mát nha-án. <verse eid="ACT 1:9" /><verse number="10" style="v" sid="ACT 1:10" />Chón ndóng nha-án yôl ti-ngưi me nga pilŏ́ng ndóng Án sớr, ngki me ntíh, bar náq conh sứp au clŏq tớq ta-yứng pa nha-án. <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />Nha-án tông: “Máh ti-cuôi Ca-li-lê ntíh, i-mo top i-nha ta-yứng me nga pilŏ́ng? Yang Yê-su ndô, Án khoiq sớr nga pilŏ́ng vít te i-nha, mu chứng lư tớq liêh a-rớq ma top i-nha khoiq hôm Án sớr nga pilŏ́ng.”<verse eid="ACT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />Dyơ ngki, te plô cóh ngai dŏq la Ô-li-vê, nha-án píh chô nga Yaru-salem, ma cóh ngki át tar-mán Yaru-salem, bôn car-na pôq nhéq mui i-ngái A-ngô. <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />Ndóng nha-án khoiq chô díh, nha-án sớr nga a-túq a-yống ntúq nha-án báq bíq a-ngô, bôn Phi-er, nha Yon, a-lứng Ya-cơ nha An-rê, Phi-lip, nha Thô-mat, Ba-thê-la-mi, a-lứng Ma-thiê, Ya-cơ a-cái conh Al-phê, a-lứng Si-môn Sê-lôt, nha Yu-da, a-cái na Ya-cơ. <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />Nhéq náq nha-án bôn mui mít mui can-nính te callong cớu seq, a-lứng máh ti-cuôi cán a-lứng Ma-ri, a-i na Yang Yê-su, nha a-lứng máh a-em conh na Án.<verse eid="ACT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />Tớq máh i-ngái ngki, dyơ ndóng yôr ta-yứng tớq pan-di top em ai án (bôn clứng máh ti-cuôi tớq ntúq ndô la ali mui cu-lám bar chít), Phi-er tông:<verse eid="ACT 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 1:16" />“Ơi i-nha, máh ndon em ai, ndô la par-nai a-nát cóq cơt tar-vớiq tớq tám U-ráq Yang, la par-nai ma Yang Ar-vai khoiq tông nsuôi co ng-cang puô Da-vit te Yu-da, ti-cuôi cơt nốh par-yông car-na dyôn top cŏp Yang Yê-su. <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />Co án khoiq bôn taq-ntêr mu nơi a-lứng top he nha bôn ráp mpual án te ar-náq ndô.” <verse eid="ACT 1:17" /><verse number="18" style="v" sid="ACT 1:18" />(Dyơ ngki án khoiq plới mui tám cu-teq te práq tar-náp na ar-náq lớiq ŏ, a-lứng vít ngki án dứm táh pi-tốq plô, án pi-dŏ́h pallúng, ma máh roiq án ngáh a-ngốh cu-lái tiêh. <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />Ar-náq ndô cơt callong cơi chom ada nhéq máh ti-cuôi át tu-mống tớq Yaru-salem. Co iki, cu-teq ngki ndon ngai dŏq te cang na nha-án la “Ha-kel-da-ma”, par-long liêh la “Ntúq Cu-teq A-ham”.) <verse eid="ACT 1:19" /><verse number="20" style="v" sid="ACT 1:20" />“Co ar-náq ngki khoiq dŏq ta-ran tớq u-ráq Cứh Ayô:</para>
  <para style="q1" vid="ACT 1:20">‘Cóq dŏq tám cu-teq na án dyôn cơt a-rưih,</para>
  <para style="q1" vid="ACT 1:20">mu chứng êq bôn nnáu tu-mống ntúq ngki,’ a-lứng</para>
  <para style="q1" vid="ACT 1:20">‘Cóq dŏq ti-cuôi can-nŏ́h ráp ial ar-náq na án.’<verse eid="ACT 1:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ACT 1:21" />Co iki, cóq bôn máh ti-cuôi ndon táq mu nơi a-lứng top he díh tớq i-ngái ma Yang Yê-su pôq liêh tớq top he, <verse eid="ACT 1:21" /><verse number="22" style="v" sid="ACT 1:22" />nsuôi lư te rit táq tíc na dơq na Yon dyôn tớq i-ngái ma Án bôn a-sớr nga pilŏ́ng te top he — mu náq te máh ti-cuôi ngki cóq ca to te callong tu-mống na Án mu chứng ada top he.” <verse eid="ACT 1:22" /><verse number="23" style="v" sid="ACT 1:23" />Nha-án yua bar náq, Yô-sep ngai dŏq la Ba-sa-ba, ma án ngai dŏq a-nốh la Yu-tu, a-lứng Ma-thiê. <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />Ndóng cớu seq, nha-án seq: “Yang ơi, lư I-nha, Án ndon chom mít can-nính na cứp ti-cuôi, seq ca to mui te bar ti-cuôi ndô ma I-nha khoiq rêh la nnáu <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />dyôn têq bôn cláp na ar-náq ndô a-lứng dyôn cơt dyưng ati ma Yu-da khoiq táh dŏq pôq nga ntúq na án.” <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />Nha-án tar-séng te bar náq ngki, a-lứng piaiq crái tớq Ma-thiê, dyơ ngki án khoiq bôn rêh mu nơi a-lứng mu chít la mui dyưng ati.<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />Ndóng i-ngái cha pêl bui A-pot khoiq tớq dyơ, nhéq náq nha-án át a-lớng mu nơi tớq mui ntúq. <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />Ti-cớr, bôn siêng te pilŏ́ng car-sang, a-rớq hô cu-yiêl phớt hớp lư, a-lứng án mot pớnh chuôp cu láng dúng ntúq nha-án chón ti-cu. <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />Dyơ máh ntaq cơt a-rớq pla uih mpáh ada nha-án, ndóng khoiq par-yáh, ngki án bôt tớq cứp náq ti-cuôi tớq nha-án. <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />Nhéq náq nha-án bôn callong bán kiaq te Yang Ar-vai a-lứng ta-bớq taq-ntêr na máh cang can-nŏ́h, veng a-rớq Ar-vai dyôn ada nha-án taq-ntêr.<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />Ndóng ngki bôn máh ti-cuôi Isa-ra-el yôl át tớq Yaru-salem, la máh ti-cuôi dyám náp te cứp cruông na máh ti-cuôi pưn pilŏ́ng. <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />Ndóng siêng ngki car-sang, ti-cuôi clứng par-chúng mu nơi a-lứng sáng dut co cứp ti-cuôi bôn sáng nha-án ntêr na cang na nha-án. <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />Nhéq máh ti-cuôi sáng dut lư a-lứng hôm si-leh, tông idô: “Me ntíh, tới nhéq náq máh ti-cuôi chón taq-ntêr ngki la ti-cuôi Ca-li-lê. <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />Cóq táq i-mo top he sáng chư mu náq nha-án taq-ntêr na cang ndái na án tớq cruông ndon he khoiq car-nian? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />Mmo ti-cuôi Ba-thê, ti-cuôi Mê-diê, ti-cuôi Ê-la-mit, máh ti-cuôi át tớq vel Mê-sô-bô-ta-mi, Yu-dê, bôn díh Cap-ba-dôc, Pôn-tu, A-siê, <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />mu chứng a-rớq Phu-ra-yiê, Bam-phu-li, Ê-yip-tô, máh cruông ưlla Li-biê tu-mán Si-ren, a-lứng máh ti-cuôi tu-moi Rô-ma tớq cláh clơ, <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />díh ti-cuôi Isa-ra-el nha ti-cuôi sŏ́ng soi phep rit Isa-ra-el, ti-cuôi Crêt a-lứng ti-cuôi A-rap, top he khoiq sáng nha-án taq-ntêr na cang na top he te máh ar-náq pưt na Yang Arbang Pilŏ́ng.” <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />Nhéq náq nha-án lư sáng dut a-lứng hôm diêiq a-púh, ti-cuôi ndô ntêr ada ti-cuôi ngki: “Ar-náq ndô lư la i-mo?” <verse eid="ACT 2:12" /><verse number="13" style="v" sid="ACT 2:13" />Ma bôn ti-cuôi can-nŏ́h ayê tar-ac khoiq tông idô: “Máh ti-cuôi ngki la chón bol siêu ng-ngam!”<verse eid="ACT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />Ma ndóng yôr ta-yứng, Phi-er a-lứng mui chít dyưng ati khoiq pốh ta-cang a-lứng tông ada nha-án:</para>
  <para style="p" vid="ACT 2:14">“Ơi i-nha, ti-cuôi Isa-ra-el a-lứng nhéq máh ti-cuôi ndon át tớq vel Yaru-salem, ar-náq ndô cóq cơt callong cơi chom dyôn ada i-nha, a-lứng seq pi-chel cam-máng par-nai cư. <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />Co máh ti-cuôi ndô lớiq bôn bol a-rớq i-nha par-ngíh, co chón la mbơiq mát pan-dang tu-rống crêng tớq i-ngái ngki. <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />Ma, ndô la par-nai khoiq dŏq par-ưq te tang ng-cang Yô-el:<verse eid="ACT 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17" />‘Yang Arbang Pilŏ́ng tông: “Ar-náq lư cơt tớq máh i-ngái talloiq,”</para>
  <para style="q1" vid="ACT 2:17">“Cư lư tốq Ar-vai Cư dyôn cứp sac sáiq,</para>
  <para style="q1" vid="ACT 2:17">A-cái conh a-lứng a-cái cán top i-nha lư ntêr tang ng-cang,</para>
  <para style="q1" vid="ACT 2:17">máh ti-cuôi bánh na top i-nha lư hôm callong a-páh,</para>
  <para style="q1" vid="ACT 2:17">a-lứng máh ti-cuôi iêuq na top i-nha lư par-náu bôn hôm.<verse eid="ACT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18" />Díh nhéq tớq máh ti-cuôi conh, máh ti-cuôi cán na Cư tớq máh i-ngái ngki,</para>
  <para style="q1" vid="ACT 2:18">Cư lư tốq Ar-vai Cư, a-lứng nha-án ntêr tang ng-cang.<verse eid="ACT 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19" />Cư lư dyôn máh tíc si-leh tớq pilŏ́ng a-yống</para>
  <para style="q1" vid="ACT 2:19">a-lứng máh tíc laq tớq pưn cu-teq a-êp,</para>
  <para style="q1" vid="ACT 2:19">a-ham a-lứng uih mu chứng car-na cu-nhiêq.<verse eid="ACT 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ACT 2:20" />Mát pan-dang lư ta-piên cơt ngiau,</para>
  <para style="q1" vid="ACT 2:20">ma mát ki-sái ngki cơt a-ham,</para>
  <para style="q1" vid="ACT 2:20">nsuôi ndóng tớq i-ngái pưt a-lứng ang ưr na Yang.<verse eid="ACT 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21" />A-lứng cứp náq ti-cuôi mmo arô seq nốh Yang ngki bôn choi ta-mống.”’<verse eid="ACT 2:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="ACT 2:22" />Ơi i-nha, máh ti-cuôi Isa-ra-el, seq cam-máng máh par-nai ndô: Yang Yê-su ti-cuôi Na-sa-ret la ti-cuôi khoiq Yang Arbang Pilŏ́ng táq tíc ada i-nha na máh ar-náq sút pưt, si-leh a-lứng máh tíc ma te Án, Yang Arbang Pilŏ́ng khoiq a-páh dyôn top i-nha, ar-lớih lư i-nha khoiq chom. <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />Án khoiq ngai mŏp, veng ar-náq khoiq dŏq a-nát nha chom nsuôi na Yang Arbang Pilŏ́ng, i-nha khoiq ca-chet ndóng téh tớq a-long calláng na ati máh ti-cuôi lớiq ŏ clưi phep rit, <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />Án la Yang ndon Yang Arbang Pilŏ́ng khoiq dyôn tu-mống liêh, vít ndóng tar-cláh te nốh diêiq a-rức na callong cu-chet, co callong ngki lớiq têq rap ca-táng Án át ta-dưp án. <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />Co puô Da-vit ntêr te Án idô:</para>
  <para style="q1" vid="ACT 2:25">‘Cư níc níc hôm Yang át chứng mát cư co Án át pa a-tớm cư,</para>
  <para style="q1" vid="ACT 2:25">dŏq cư lớiq bôn a-dáh a-mớh.<verse eid="ACT 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26" />Co te ar-náq ngki, mít cư êm lư a-lứng ntaq cư bui hơr.</para>
  <para style="q1" vid="ACT 2:26">Ma clưi te ngki, sac sáiq cư lư bôn ki-nứm tớq callong ng-cong.<verse eid="ACT 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27" />Co Án lư lớiq bôn táh ar-vai cư tớq ntúq na ti-cuôi cóq tớq,</para>
  <para style="q1" vid="ACT 2:27">nha lư lớiq dŏq dyôn Yang Práh ŏ Án bôn hôm callong cơt a-líq nsốq.<verse eid="ACT 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28" />Án khoiq a-páh ada cư car-na tu-mống;</para>
  <para style="q1" vid="ACT 2:28">Án lư táq ada cư bôn máng callong bui hơr mu chứng ar-maiq na Án.’<verse eid="ACT 2:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="ACT 2:29" />Ơi máh i-nha, em ai ơi, na callong náp peh, par-nai têq tông ada i-nha te a-chúc a-chiac Da-vit, ngki la án khoiq cu-chet nha khoiq ngai tứp, tớq ping na án yôl níc tớq top he díh tớq i-ngái ndô. <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />Dyơ ngki, co la tang ng-cang a-lứng co chom dyơ Yang Arbang Pilŏ́ng khoiq par-ưq ada án dŏq rêh mu náq ti-cuôi tớq te tŏ́ng toiq án cơt puô cláp án, <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />iki tư khoiq hôm nsuôi ar-náq ndô, puô khoiq tông te callong tu-mống liêh na Yang Choi Ta-mống, ngki Án lớiq táh tớq ntúq na ti-cuôi cóq tớq, sac sáiq Án lư ớq hôm callong a-líq nsốq.<verse eid="ACT 2:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="ACT 2:32" />Yang Arbang Pilŏ́ng khoiq dyôn Yang Yê-su ndô tu-mống liêh, nhéq náq top he la tíc dyôn callong ngki. <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />Co iki, ndóng khoiq ti-cu pa a-tớm Yang Arbang Pilŏ́ng a-lứng ráp par-nai par-ưq te Yang Ar-vai te A-ám, Án khoiq tốq a-siar ar-náq ndô, la par-nai ndon i-nha bôn hôm a-lứng sáng.<verse eid="ACT 2:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 2:34" />Co Da-vit i-yốh bôn sớr nga pilŏ́ng, ma lư án tông:</para>
  <para style="q1" vid="ACT 2:34">‘Yang tông ada Yang cư: “Cóq ti-cu pa a-tớm Cư,<verse eid="ACT 2:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ACT 2:35" />ti-ngôi tớq ndóng Cư dyôn máh ti-cuôi pi-con na Mái cơt tar-dơl dŏq dyưng na Mái.”’<verse eid="ACT 2:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="ACT 2:36" />Dyơ ngki, díh dúng Isa-ra-el cóq chom dyôn ar-lớih idô Yang Arbang Pilŏ́ng khoiq dyôn Án táq Yang la Yang Choi Ta-mống, ngki la Yang Yê-su ndô, ti-cuôi ndon i-nha khoiq téh díng.”<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />Ndóng khoiq sáng iki, nha-án sáng a-ái tớq mít, dyơ seq te Phi-er a-lứng top dyưng ati yôl liêh: “Ơi máh em ai, top he cóq táq a-mớh?” <verse eid="ACT 2:37" /><verse number="38" style="v" sid="ACT 2:38" />Dyơ Phi-er tông ada nha-án: “Cóq piên lêq a-lứng cứp náq te i-nha cóq ráp táq tíc na dơq nhơ nốh Yang Choi Ta-mống Yê-su dŏq têq tar-cláh callong luaih na i-nha, dyơ i-nha lư ráp callong choi mat te Yang Ar-vai. <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />Co par-nai par-ưq ngki la dyôn ada i-nha, dyôn a-cái a-mon na i-nha a-lứng dyôn díh nhéq máh ti-cuôi át yông, la ti-cuôi ndon Yang la Yang Arbang Pilŏ́ng top he lư ar-lớih khoiq dŏq rêh arô.” <verse eid="ACT 2:39" /><verse number="40" style="v" sid="ACT 2:40" />Na a-ưi par-nai can-nŏ́h hơ, án khoiq taq-ntêr a-lứng a-liam nha-án, idô: “Cóq dŏq i-nha bôn tar-cláh te pang lớiq ŏ ndô.” <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />Iki, vít ndóng ráp par-nai na án, nha-án táq tíc na dơq, ali pe ngin ar-vai khoiq bôn mot tớq Top Tin táng i-ngái ngki. <verse eid="ACT 2:41" /><verse number="42" style="v" sid="ACT 2:42" />Dyơ ngki, nha-án át cam-máng níc par-nai ca to na top dyưng ati a-lứng tớq i-ngái a-ngô, tớq callong péq beng nha tớq par-nai cớu seq.<verse eid="ACT 2:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43" />Callong a-dáh át tớq cứp ti-cuôi, a-lứng a-ưi ar-náq si-leh mu chứng tíc ndái a-páh dyôn top dyưng ati. <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />Nhéq tưh máh ti-cuôi tin ngki cơt mui mít mui ntúq a-lứng tớc chúng cứp nốh, <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />nha-án táiq nhéq ntưn a-lứng crơng-crớu nha-án, dyơ ar-pô práq ngki dyôn máh ti-cuôi, veng a-rớq án ndon ính bôn a-mớh, <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />cứp i-ngái a-lứng rum níc mu nơi tớq dúng sang, a-lứng péq beng tớq cứp dúng, nha-án khoiq mpô tan-na cha tớq callong bui hơr a-lứng mui mít mui lom, <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />cứh ayô Yang Arbang Pilŏ́ng a-lứng bôn callong crái piaiq ada nhéq máh ti-cuôi clứng, ma Yang rêh arô pi-lư máh ti-cuôi bôn choi ta-mống mot top tin ngki cứp i-ngái.<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />Dyơ ngki, Phi-er a-lứng Yon pôq nga dúng sang dŏq ính cớu seq, chón pan-dang viêt. <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />Bôn ti-cuôi ngki, ndon dyuat te pallúng a-i án, khoiq dŏq crang tớq, la ti-cuôi ndon cứp i-ngái ngai dŏq tớq ngáh callống na dúng sang, ntúq ngai dŏq la Callống A-maiq, dŏq seq práq ngai te máh ti-cuôi mot ngốh tớq dúng sang, <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />ma tư hôm Phi-er a-lứng Yon tu-mán ính mot tớq dúng sang, án seq dyôn práq ada án. <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />Ma vít ndóng a-lứng Yon me tiêu-liêu nga án, Phi-er tông: “Áu me nga top he.” <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />Dyơ ngki án me tiêu-liêu nga bar náq nha-án, ng-cong bôn ráp mui nốh a-mớh te nha-án. <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />Ma, Phi-er tông: “Dyeng nha práq, ớq nốh mmo bôn tớq cháq cư, ma callong ndon cư bôn, cư dyôn mái ndô. Nhơ nốh Yang Choi Ta-mống Yê-su ti-cuôi Na-sa-ret, pôq iên ŏ.” <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />Ndóng khoiq kéu án pa ati a-tớm, Phi-er a-yôr án ta-yứng, ndóng ngki táp, a-dyưng a-lứng chốq chuôt túq na án cơt práih bánh. <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />Ma ndóng a-yưn, án ta-yứng tứng a-lứng ta-bớq ti-caq pôq, dyơ án mot tớq dúng sang a-lứng nha-án, ntơnh pôq ntơnh a-yưn ntơnh cứh ayô Yang Arbang Pilŏ́ng. <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />Nhéq máh ti-cuôi clứng bôn hôm án ti-caq pôq a-lứng cứh ayô Yang Arbang Pilŏ́ng. <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />Dyơ nha-án a-cớl án dyuat, i-mo án la ti-cuôi cơi ti-cu seq práq ngai tớq ngáh Callống A-maiq na dúng sang, iki nha-án sáng dut lư a-lứng sáng laq co ar-náq khoiq cơt ada án.<verse eid="ACT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />Dyơ, ndóng án dyuat chón tar-veng Phi-er a-lứng Yon, nhéq máh ti-cuôi clứng sáng dut lư, clứng ti-cuôi par-lóng nga nha-án tớq callống ntrôn, ntúq ngai dŏq la Callống Ntrôn Sa-la-môn. <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />Ma tư hôm iki, Phi-er ôi liêh ada ti-cuôi clứng:</para>
  <para style="p" vid="ACT 3:12">“Seq i-nha, ti-cuôi Isa-ra-el ơi, i-mo i-nha sáng dut lư te ar-náq ndô? A-láng i-mo i-nha me top he tiêu-liêu iki top he khoiq táq dyôn án dyuat têq ti-caq pôq co chức sút lớiq la callong tin mmar na án? <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />Yang Arbang Pilŏ́ng na A-pra-ham, Yang Arbang Pilŏ́ng na I-sac, a-lứng Yang Arbang Pilŏ́ng na Ya-côp, Yang Arbang Pilŏ́ng na a-chúc a-chiac top he, khoiq cứh ayô ti-cuôi táq ar-náq na Án, Yang Yê-su, Án ndon i-nha khoiq mŏp a-lứng ca-lôih chứng mát Phi-lat ndóng Phi-lat khoiq ưq ta-láh Án pôq. <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />Ma i-nha khoiq ca-lôih te Án Práh Ŏ a-lứng Ti-nớng Tu-pứng, ính ngai cóq ta-láh ada nha-án mu náq ndon ca-chet ti-cuôi, <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />ma i-nha khoiq ca-chet Án Ndon Tôm Callong Choi Ta-mống, la Án ndon Yang Arbang Pilŏ́ng khoiq dyôn tu-mống liêh te cu-chet, ma top he la têq ca to dyôn ar-náq ndô. <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />A-lứng co callong tin nhơ nốh Án, án ndon dyuat, ti-cuôi ma i-nha lư hôm a-lứng chom, nhơ nốh Án khoiq táq dyôn práih bánh. Callong tin ngki nhơ te Án khoiq dyôn án ngki bôn práih bánh liêh a-rớq i-ngái chứng mát nhéq náq i-nha. <verse eid="ACT 3:16" /><verse number="17" style="v" sid="ACT 3:17" />Hoi ndô, em ai ơi, cư chom dyơ i-nha khoiq táq tớq callong ma-mu, a-lứng ti-cuôi ndon par-yông te i-nha mu chứng iki. <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />Ma máh par-nai Yang Arbang Pilŏ́ng khoiq tông nsuôi co ng-cang na nhéq máh ti-cuôi tang ng-cang, i-mo Yang Choi Ta-mống te Án cóq chiuq diêiq a-rức, Án khoiq táq tar-piaiq a-rớq iki. <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />Co iki, cóq piên lêq, a-lứng píh chô liêh, dŏq callong luaih na i-nha bôn a-rau práh, <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />dyôn u-rớh cơt tam-me tớq te callong mpáh na Yang, a-lứng Yang yua Án khoiq dŏq mŏp dyôn i-nha, la Yang Choi Ta-mống Yê-su, <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />la Yang cóq át liêh tớq pilŏ́ng ti-ngôi pang ndô a-tức túc nốh, la callong ma Yang Arbang Pilŏ́ng khoiq tông te i-nớh co ng-cang máh tang ng-cang práh ŏ na Án. <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />Lư iki, Môi-se khoiq tông dyơ: ‘Yang, Yang Arbang Pilŏ́ng na top he lư dyôn ada i-nha mu náq tang ng-cang a-rớq cư tớq te top em ai na i-nha. I-nha lư cam-máng ti-cuôi ndon par-yông nhéq máh ar-náq mmo ma án tông ada i-nha. <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />Ma callong lư cơt tớq dyôn ti-cuôi mmo ma khán lớiq cam-máng ti-cuôi tang ng-cang ngki, ti-cuôi ngki lư ngai ca-chet te ti-cuôi clứng.’ <verse eid="ACT 3:23" /><verse number="24" style="v" sid="ACT 3:24" />Dyơ ngki, nhéq máh ti-cuôi tang ng-cang te Sa-mu-el a-lứng máh ti-cuôi tớq ta-tun án, khán nha-án pốh ta-cang, ngki nha-án lư taq-ntêr te máh i-ngái ndô. <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />I-nha la a-cái a-cháu na ti-cuôi tang ng-cang a-lứng na par-ưq ma Yang Arbang Pilŏ́ng khoiq dyôn te a-chúc a-chiac he, ndóng tông ada A-pra-ham, ‘A-lứng co nhơ tớq te mái, nhéq máh tŏ́ng toiq mpiên cu-teq lư bôn bún.’ <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />Nsuôi lư ada i-nha, vít ndóng dyôn Ti-cuôi Táq Ar-náq án, Yang Arbang Pilŏ́ng khoiq yua Án ngki tớq dyôn bún ada i-nha na ta-viar cứp ti-cuôi vít te callong saq na i-nha.”<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />Hoi ngki, ndóng nha-án chón taq-ntêr a-lứng ti-cuôi clứng, top thới teng rit sang, a-lứng ti-cuôi kiaq me dúng sang nha máh ti-cuôi Sa-du-sê tớq nga nha-án, <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />lư sáng nháih co bar náq nha-án chón ca to ti-cuôi clứng a-lứng pau ntêr callong tu-mống liêh te cu-chet te Yang Yê-su. <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />Dyơ top nha-án cŏp táp bar náq a-lứng crál tớq cŏq pớn tớq i-ngái par-nô, co ndóng ngki khoiq i-dáu dyơ. <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />Ma clứng te máh ti-cuôi cua dyơ cam-máng par-nai ngki khoiq tin, a-lứng máh ti-cuôi conh khoiq mot tin ali sông ngin.<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />Ar-náq khoiq tớq nga i-ngái ta-tun, máh ti-cuôi sút na nha-án a-lứng top sút tớq sớu nha top thới sái rit khoiq par-chúng liêh tớq Yaru-salem, <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />a-lứng An-na, thới teng rit sang, díh Cai-pha, Yon, A-lec-san-dơ a-lứng nhéq máh ti-cuôi ưlla te tŏ́ng toiq thới teng rit sang. <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />Vít dyơ dông nha-án bar náq dŏq tớq pan-di, nha-án plốh: “Co chức sút mmo, a-láng nhơ nốh nnáu ma top i-nha khoiq táq ar-náq ngki?” <verse eid="ACT 4:7" /><verse number="8" style="v" sid="ACT 4:8" />Tớq ndóng ndô, co bôn callong bán kiaq te Yang Ar-vai, Phi-er khoiq tông ada nha-án: “Ơi top i-nha ndon sút na ti-cuôi clứng a-lứng top sút tớq sớu, <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />khán i-ngái ndô top he plốh te ar-náq ŏ dyôn ada mu náq ti-cuôi a-ái, co i-mo án khoiq bôn pa-lai bánh, <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />ndô la lư par-nai khoiq nhéq top i-nha a-lứng máh ti-cuôi Isa-ra-el chom tưi, ngki nhơ nốh Yang Choi Ta-mống Yê-su ti-cuôi Na-sa-ret, Án ndon top i-nha khoiq téh tớq a-long calláng, Án ndon Yang Arbang Pilŏ́ng khoiq dyôn tu-mống liêh te cu-chet, ngki la nhơ Án ma ti-cuôi ndô ta-yứng práih bánh chứng mát top i-nha. <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />Án la cúc búl khoiq ngai ayê tar-ac te top i-nha, ngki la máh ti-cuôi táq dúng, ndon khoiq cơt búl khớm tớq tol dúng. <verse eid="ACT 4:11" /><verse number="12" style="v" sid="ACT 4:12" />Ớq bôn callong choi ta-mống tớq te nnáu nnáng, co tớq pưn pilŏ́ng lớiq bôn nốh mmo nnáng têq dŏq dyôn tớq pan-di thư ti-cuôi dŏq top he cóq ki-nứm ngki têq choi ta-mống.”<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />Ndóng hôm callong clŏ́q na Phi-er nha Yon, a-lứng chom ar-lớih nha-án la máh ti-cuôi lớiq rian a-lứng chom iki sớng, nha-án sáng laq, nha-án lư a-cớl bar náq, i-mo bar náq i-nha khoiq cơi át a-lớng Yang Yê-su. <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />Ma, co hôm conh ndon dyuat khoiq pa-lai bánh ta-yứng a-lứng bar náq nha-án, nha-án ớq bôn callong a-mớh ính tar-plốh nnáng. <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />Dyơ ngki, vít yua ada máh ti-cuôi ngki ngốh te ntúq dúng rum, nha-án tang-húng a-lứng tar-tuôq, <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />idô: “Top he cóq táq a-mớh ada máh ti-cuôi ndô? Ngki la co mui ar-náq si-leh cơi hôm khoiq cơt te máh ti-cuôi ndô, lư ar-lớih ar-lêng dyôn ada nhéq máh nnáu yôl tu-mống tớq Yaru-salem, a-lứng top he lớiq têq ca-lôih. <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />Ma, dŏq ar-náq ndô lớiq par-dŏ́h par-hanh ngốh nnáng tớq top ti-cuôi clứng, top he cóq dyŏq nha-án êq ca to te nốh ngki dŏq taq-ntêr a-lứng máh ti-cuôi mmo.” <verse eid="ACT 4:17" /><verse number="18" style="v" sid="ACT 4:18" />Iki, tư ndóng arô bar náq ngki mot, nha-án dyŏq êq taq-ntêr lớiq la ca to par-nai a-mớh nhơ nốh Yang Yê-su. <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />Ma ndóng Phi-er nha Yon ôi, nha-án bar náq khoiq tông ada nha-án: “A-láng lư piaiq át chứng mát Yang Arbang Pilŏ́ng ndóng cam-máng top i-nha clưi Yang Arbang Pilŏ́ng? Top i-nha plốh a-dứh. <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />Co top he lớiq têq lớiq taq-ntêr te máh callong he khoiq hôm a-lứng sáng.” <verse eid="ACT 4:20" /><verse number="21" style="v" sid="ACT 4:21" />Dyơ ngki, vít ndóng pa-rưt a-ưi nốh, nha-án ta-láh bar náq ngki pôq, co ớq tu-múh callong a-mớh dŏq ma nha-án ính pi-tôt bar náq ngki, ngki la co ti-cuôi clứng, te cứp ti-cuôi lư cứh ayô Yang Arbang Pilŏ́ng te ar-náq khoiq cơt. <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />Co ti-cuôi dyuat ntíh, án ndon ar-náq si-leh pa-lai bánh ndô cơt, ngki khoiq clưi puan chít cu-mo.<verse eid="ACT 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />Dyơ ngki, tư ndóng bôn ta-láh, nha-án bar náq tớq nga em ai ndon tin na nha-án a-lứng taq-ntêr liêh cứp ar-náq ma top thới teng rit sang nha top sút tớq sớu khoiq tông ada nha-án. <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />Ndóng khoiq sáng dyơ, nha-án sŏ́ng mui mít cớu seq táp nga Yang Arbang Pilŏ́ng a-lứng seq: “Yang Ơi, I-nha la Án khoiq teng cơt pilŏ́ng, cu-teq nha dơq ving ca-vang, a-lứng cứp nốh át tớq ngki, <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />la Án, tông na a-chúc a-chiac top he co Yang Ar-vai, te ng-cang na Da-vit táq ar-náq Án, khoiq tông idô:</para>
  <para style="q1" vid="ACT 4:25">‘I-mo cứp cruông sáng uan,</para>
  <para style="q1" vid="ACT 4:25">a-lứng máh ti-cuôi tang-húng ngê lớiq tar-náp?<verse eid="ACT 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26" />Máh puô tớq cu-teq car-tóng,</para>
  <para style="q1" vid="ACT 4:26">a-lứng máh ti-cuôi sút tang-húng a-lứng tar-tuôq</para>
  <para style="q1" vid="ACT 4:26">ính chíl Yang a-lứng ính chíl Yê-su ndon chiuq diêiq a-rức na Án.’<verse eid="ACT 4:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ACT 4:27" />Co lư ar-lớih, díh Hê-rôt nha Pon-ti Phi-lat, a-lứng top ti-cuôi can-nŏ́h nha ti-cuôi Isa-ra-el, khoiq sŏ́ng mu nơi át tớq vel ndô ính chíl Ti-cuôi Táq Ar-náq práh ŏ te Án la Yang Yê-su, Yang ndon Án chiuq diêiq a-rức, <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />dŏq táq cứp ar-náq ma ati Án a-lứng ar-náq na Án khoiq a-nát nsuôi dyôn lư cơt. <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />Hoi ndô, Yang ơi, seq me liêh máh par-nai pa-rưt te nha-án, a-lứng seq dyôn nga ti-cuôi táq ar-náq te Án dŏq ca to par-nai Án a-lứng nhéq te callong clŏ́q <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />ndóng Án pa-yơ ati na Án ngki dŏq dyôn callong pa-lai bánh, máh tíc laq a-lứng máh ar-náq si-leh khoiq cơt tớq nhơ nốh na Ti-cuôi Táq Ar-náq práh ŏ Án, la Yang Yê-su.” <verse eid="ACT 4:30" /><verse number="31" style="v" sid="ACT 4:31" />Ndóng nha-án khoiq cớu seq dyơ, ntúq ma nha-án báq rum cơt ca-cưt, dyơ nhéq nha-án lư bôn callong bán kiaq te Yang Ar-vai a-lứng ca to par-nai na Yang Arbang Pilŏ́ng ngki bôn mít clŏ́q.<verse eid="ACT 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />Dyơ ngki, clứng lư máh ti-cuôi khoiq tin lư bôn cơt mui mít mui lom a-lứng mui par-ngíh. Ớq nnáu par-ngíh mui callong mmo te bớr a-mớh tớq te án la crơng ndái, ma ada nha-án, cứp nốh la crơng chúng. <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />Te chức sút rêng lư, top dyưng ati dŏq a-ngốh par-nai te callong tu-mống na Yang Yê-su, a-lứng callong choi mat pưt lư át tớq nhéq náq nha-án. <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />Co lớiq bôn ti-cuôi mmo ki-dit pi-nhaih te top nha-án, co máh ti-cuôi mmo ndon ưlla cu-teq cu-e a-láng dúng su, ngki cua dyơ táiq, nha-án dông máh práq khoiq bôn táiq, <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />dyơ dŏq tớq a-dyưng top dyưng ati, ma práq ngki choi dyôn cứp ti-cuôi veng a-rớq ti-cuôi ngki ính bôn callong mmo.<verse eid="ACT 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36" />Dyơ ngki, Yô-sep, án bôn top dyưng ati dŏq la Ba-na-ba (nốh bôn ti-toiq liêh la A-cái na Callong A-liam), la mu náq ti-cuôi Lê-vi, prái con Sip-rơ, <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />vít dyơ táiq mui tám pi-dái ưlla na án, án khoiq dông práq ngki a-lứng dŏq tớq a-dyưng top dyưng ati.<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />Chón ngki, bôn mu náq ti-cuôi nốh A-na-niê, a-lứng Sa-phi-ra, cam-pái án, khoiq táiq mui tám cu-teq, <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />dyơ án dŏq ndái ada án mui biq te práq ngki (cam-pái án la chom), a-lứng ndóng dông mui biq te práq ngki tớq, án dŏq tớq a-dyưng top dyưng ati. <verse eid="ACT 5:2" /><verse number="3" style="v" sid="ACT 5:3" />Ma Phi-er tông: “A-na-niê, co i-mo Yang sáq par-yông mít mái táq dyôn mái ntêr a-uai Yang Ar-vai ma dŏq ndái ada án mu biq te máh práq na tám cu-teq ngki? <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />Ndóng i-yốh táiq, lư tám cu-teq yôl na mái, a-lứng dyơ khoiq táiq, máh práq ngki ưlla nga chức na mái? Co i-mo ma mái par-ngíh ar-náq ndô tớq mít mái? Tới mái taq-ntêr a-uai thư ti-cuôi a-mớh, ma la ada Yang Arbang Pilŏ́ng.” <verse eid="ACT 5:4" /><verse number="5" style="v" sid="ACT 5:5" />Dyơ ngki, tư A-na-niê sáng máh par-nai ngki, án ti-ŏ́h tar-ngứh dyơ dứm, nha callong a-dáh pưt lư át tớq nhéq máh ti-cuôi sáng. <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />Dyơ ngki, ndóng khoiq yôr ta-yứng, máh ti-cuôi bánh som án nha chón crang nga tiêh dyơ nha-án dông pôq tứp.<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />Ma ar-náq cơt tớq ali pe a-déh dôi chen vít ngki, cam-pái án pôq mot, ma lớiq chom ar-náq khoiq cơt. <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />Phi-er tông ada cán ngki: “Cóq taq-ntêr dyôn cư chom lư ai ơi khoiq táiq tám cu-teq máh mmo práq a-láng lớiq?” Dyơ cán ngki ôi: “Lư, ali máh ngki.” <verse eid="ACT 5:8" /><verse number="9" style="v" sid="ACT 5:9" />Ma Phi-er tông ada cán ngki: “I-mo ma ar-náq ngki cơt i-nha bar sŏ́ng dŏq thứq Ar-vai na Yang? Áu me ntíh, ưllang dyưng na máh ti-cuôi khoiq tứp ca-yiêq ơi át tớq ngáh callống, a-lứng nha-án ngki lư dông ơi pôq tứp.” <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />Ngki táp, cán ngki dứm tớq dyưng án a-lứng ti-ŏ́h tar-ngứh. Dyơ ngki, ndóng pôq mot, máh ti-cuôi bánh hôm cháq cán ngki, dyơ ndóng crang nga tiêh, nha-án tứp cán ngki mu pa ca-yiêq án. <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />Callong a-dáh pưt lư át pa-niar máh top tin a-lứng tớq nhéq máh ti-cuôi sáng te ar-náq ndô.<verse eid="ACT 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />Dyơ ngki, te ưllang ati na top dyưng ati, a-ưi tíc laq a-lứng ar-náq si-leh cơt tớq máh ti-cuôi clứng, a-lứng nha-án lư sŏ́ng mu nơi át tớq Ngáh Ntrôn Sa-la-môn. <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />Ma lớiq bôn nnáu dáh par-chúng a-lớng nha-án, ntro ti-cuôi clứng báq át ayô nha-án. <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />Dyơ ndô, bôn a-ưi ti-cuôi bôn mot ndóng dŏq mít tin tớq Yang clưi ngki, cơt clứng lư díh conh nha cán, <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />tar-lúh ngai díh dông ti-cuôi a-ái ngốh nga car-na, dŏq ta-bíq tớq car-rang nha nchiauq, dŏq ndóng Phi-er pôq pha, ngki biaq lư mol na án têq ca-dứp tớq ti-cuôi mmo ngki te nha-án. <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />Bôn mui top ti-cuôi clứng ngki par-chúng tớq te máh vel pa-niar Yaru-salem, dông díh ti-cuôi a-ái nha máh ti-cuôi ndon yang sáq pi-yúh, ma nhéq náq nha-án lư bôn pa-lai bánh.<verse eid="ACT 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />Ma ndóng yôr ta-yứng, thới teng rit sang a-lứng nhéq díh máh ti-cuôi veng án (la máh ti-cuôi te top Sa-du-sê) sáng uan ada top tin, <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />dyơ máh ti-cuôi ngki cŏp táp top dyưng ati a-lứng crál nha-án nga dúng cŏq ti-cuôi tôt. <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />Ma tớq i-dáu, bôn tar-neng na Yang khoiq pốh callống dúng cŏq, dông nha-án nga tiêh, a-lứng pa-táp: <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />“Pôq pôq, a-lứng ndóng ta-yứng tớq dúng sang, cóq taq-ntêr ada ti-cuôi clứng cứp par-nai te callong tu-mống ndô.” <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />Dyơ, ndóng khoiq sáng iki, nha-án pôq mot nga dúng sang chón ang i-láih a-lứng ca to. Ndóng ngki, vít thới teng rit sang a-lứng máh ti-cuôi veng án khoiq tớq, nha-án par-chúng máh Ti-cuôi Sút a-lứng nhéq máh top ti-cuôi sút te ti-cuôi Isa-ra-el, dyơ yua mu náq nga cŏq tôt pôq ial top dyưng ati tớq. <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />Ma ndóng tớq nnơi, máh ti-cuôi kiaq ớq hôm top dyưng ati tớq cŏq tôt, dyơ ngki ndóng píh chô liêh, nha-án taq-ntêr, <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />ôi idô: “Top he hôm cŏq tôt khoiq ngai cliang na cứp nốh lư khớm, a-lứng ti-cuôi kiaq ngki ta-yứng tớq callống, ma tư ndóng pốh ngki, top he ớq hôm nnáu át tớq callúng díh.” <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />Dyơ ngki, chón ndóng top nha-án khoiq sáng máh par-nai ngki, díh ti-cuôi sút par-yông kiaq dúng sang nha máh thới teng rit sang sáng dut lư te par-nai ntêr, i-mo ar-náq ngki ma têq cơt. <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />Dyơ, bôn mu náq ngki, tư ndóng tớq ntúq, khoiq tông ada nha-án idô: “Áu me ndô, máh ti-cuôi ma top i-nha crál tớq cŏq tôt chón ngki át tớq dúng sang, khoiq ta-yứng ca to ti-cuôi clứng!” <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />Ndóng ngki, ti-cuôi sút, pôq a-lứng ti-cuôi kiaq, khoiq dông nha-án chô, lớiq bôn tính púh, co nha-án a-dáh ti-cuôi clứng, dáh lơ nha-án ngai tíq búl. <verse eid="ACT 5:26" /><verse number="27" style="v" sid="ACT 5:27" />Ndóng khoiq dông top dyưng ati chô, máh ti-cuôi ngki dŏq nha-án pan-di Ti-cuôi Sút, dyơ thới teng rit sang plốh nha-án, <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />i-mo: “Top he khoiq pa-táp top i-nha dyŏq êq ca to te nốh ndô, ma me ntíh, top i-nha khoiq táq Yaru-salem par-hanh máng callong ca to nha-án, a-lứng top i-nha ính dông a-ham na ti-cuôi ngki tốq tớq top he.” <verse eid="ACT 5:28" /><verse number="29" style="v" sid="ACT 5:29" />Ma ndóng ôi liêh, Phi-er a-lứng top dyưng ati tông: “Cóq dyám náp Yang Arbang Pilŏ́ng a-láng la ti-cuôi. <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />Yang Arbang Pilŏ́ng te a-chúc a-chiac top he khoiq dyôn Yang Yê-su tu-mống liêh, Án la Yang ma top i-nha khoiq ca-chet, ndóng téh tớq a-long calláng. <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />Yang Arbang Pilŏ́ng khoiq dông Án sớr táq Puô a-lớng Yang Choi Ta-mống át pa a-tớm án, dŏq dyôn callong piên lêq ada Isa-ra-el mu chứng ta-láh callong luaih. <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />Top he la tíc te máh ar-náq ngki, mu chứng a-lứng Yang Ar-vai, Án ma Yang Arbang Pilŏ́ng khoiq dyôn ada máh ti-cuôi dyám náp Án.”<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />Ma vít ndóng sáng iki, top nha-án lư sáng uan nha ính ca-chet top dyưng ati. <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />Dyơ ngki, ndóng mu náq ti-cuôi ngki yôr ta-yứng pan-di Ti-cuôi Sút, la mu náq ti-cuôi Pha-ra-si, nốh la Ca-ma-li-ên, thới sái rit, bôn máh ti-cuôi dyám náp, án yua dông top dyưng ati nga tiêh mu hoi. <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />Dyơ án tông ada nha-án:</para>
  <para style="p" vid="ACT 5:35">“Em ai ơi, máh ti-cuôi Isa-ra-el, cóq mmứng tớq mít bôm te ar-náq ndon top i-nha ính táq dyôn cứp ti-cuôi ndô. <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />Co nsuôi i-ngái ndô, Thêu-da khoiq ính chíl, chóng ngin án la mu náq ti-cuôi pưt, callứng máh ti-cuôi conh khoiq par-chúng a-lứng án ali puan cu-lám, ma án khoiq ca-chet ngki nhéq tưh máh ti-cuôi ndon bôn cam-máng veng án lư cơt pláh chap, dyơ top nha-án pôq nga ntúq ớq bôn nnáu. <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />Ta-tun nốh ndô, Yu-da ti-cuôi Ca-li-lê khoiq cơt sút tớq i-ngái ngai ngiaih máh ti-cuôi prái a-lứng par-yông ti-cuôi clứng veng án. Nốh ngki la cu-chet tưi, dyơ nhéq tưh máh ti-cuôi ndon bôn cam-máng veng án lư cơt pláh chap. <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />Chón ndô cư tông ada i-nha callong ndô: Cóq viar yông te máh ti-cuôi ngki a-lứng êq mmứng nha-án, co khán par-ngíh ndô a-láng ar-náq ndô la te thư ti-cuôi, án lư cơt ar-lóh, <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />ma khán ar-náq ngki la te Yang Arbang Pilŏ́ng, ngki i-nha lư lớiq têq pu-pít nha-án, ma lư i-nha táp cơt a-rớq ti-cuôi ính chíl liêh ada Yang Arbang Pilŏ́ng.” Dyơ iki, nha-án lư cam-máng par-nai án. <verse eid="ACT 5:39" /><verse number="40" style="v" sid="ACT 5:40" />Vít ndóng arô top dyưng ati, cua dyơ púh tính, nha-án dyŏq êq ca to te nốh Yang Yê-su, dyơ nha-án ta-láh pôq.<verse eid="ACT 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="ACT 5:41" />Iki, top dyưng ati ngốh te callong tar-to mát a-lứng Ti-cuôi Sút, bui hơr co nha-án khoiq bôn taq-ntêr crái piaiq chiuq diêiq a-rức co Nốh Án. <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />Cứp i-ngái, díh tớq dúng sang nha tớq cứp dúng, nha-án lớiq a-ngô ca to nha pau ntêr Par-nai ŏ Yang — Yang Yê-su la Yang Choi Ta-mống.<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />Dyơ ngki, tớq máh i-ngái ngki, ndóng máh ti-cuôi a-cán clứng pi-lư, callong lớiq sŏ́ng khoiq ngốh te ti-cuôi Isa-ra-el nưm taq-ntêr cang Créc ada ti-cuôi Hê-brơ, co top cán cám mai na nha-án ti-ráp crơng tan-na tớq táq ar-náq cứp i-ngái. <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />Dyơ ngki, ndóng mu chít la bar náq dyưng ati par-chúng mui top lư clứng máh ti-cuôi, nha-án tông: “Ndô la ar-náq lư lớiq têq a-mớh ada top he ndóng táh par-nai na Yang Arbang Pilŏ́ng nga lam-loi ma ti-ráp ntúq chi-cha. <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />Ma, em ai ơi, cóq rêh te top i-nha tu-pul náq ngai ng-conh bôn siêng ŏ, callong bán kiaq te Yang Ar-vai nha callong tu-báiq, la máh ti-cuôi ma top he têq ca to dyôn te ar-náq ndô. <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />Ma top he lư cứp i-ngái tớq callong cớu seq, nha ar-náq tar-choi par-nai Yang.” <verse eid="ACT 6:4" /><verse number="5" style="v" sid="ACT 6:5" />Par-nai ngki táq bui mít chứng mát nhéq tưh ti-cuôi sút. Iki, nha-án rêh Ê-tiên, mu náq bôn callong tin a-lứng Yang Ar-vai, Phi-lip, Bô-cô-rơ, Ni-ca-nô, Ti-môn, Bar-mê-na nha Ni-cô-la, la ti-cuôi An-ti-ôt veng ti-cuôi Isa-ra-el, <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />la máh ti-cuôi ma nha-án dông a-tớq dŏq ta-yứng chứng mát top dyưng ati, a-lứng dyơ vít cớu seq, top dyưng ati ca-pơiq tớq máh ti-cuôi ngki.<verse eid="ACT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />Dyơ ngki, par-nai na Yang Arbang Pilŏ́ng cơt rứh a-ưi ntúq, a-lứng clứng ti-cuôi tin tớq Yaru-salem cơt clứng lư loi, nha díh mui top lư clứng top thới teng rit sang khoiq peh te callong tin.<verse eid="ACT 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />Dyơ ngki, Ê-tiên bôn ơn nha chức sút, táq ar-náq si-leh a-lứng ar-náq laq pưt tớq ti-cuôi clứng. <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />Ma bôn top ti-cuôi khoiq ính chíl, la máh ti-cuôi te dúng rum can-nŏ́h, ntúq ngai dŏq la “Máh Ti-cuôi Tới Sol”, mu chứng máh ti-cuôi Si-ren, ti-cuôi A-lec-san-tri, a-lứng máh ti-cuôi te Si-la-si nha cruông A-si, tar-miên a-lớng Ê-tiên. <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />Ma, nha-án lớiq rap dŏq chíl liêh callong tu-báiq a-lứng Yang Ar-vai ma án khoiq ca to nhơ Án ngki. <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />Vít ngki, nha-án chang práq máh ti-cuôi dŏq tông idô: “Top he khoiq sáng án tông máh par-nai a-craiq díh nga Môi-se a-lứng Yang Arbang Pilŏ́ng.” <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />Nha-án chuôq rúc díh ti-cuôi clứng nha top ti-cuôi sút tớq sớu a-lứng top thới sái rit, a-lứng ndóng tớq tar-mán, nha-án cŏp án a-lứng dông nga Ti-cuôi Sút. <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />Dyơ ngki, nha-án dông sa máh ti-cuôi ton a-pít, ntêr: “Ti-cuôi ndô lớiq a-ngô taq-ntêr máh par-nai pa-mat tớq ntúq práh ŏ nha phep rit. <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />Co top he khoiq sáng án tông idô Yê-su ti-cuôi Na-sa-ret ntíh lư pu-pít ntúq ndô a-lứng piên cơt máh rit rŏng ma Môi-se khoiq dŏq liêh ada top he.” <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />Ndóng me tiêu-liêu nga án, nhéq náq máh ti-cuôi ndon ti-cu a-lớng Ti-cuôi Sút hôm ar-maiq án a-rớq ar-maiq na tar-neng.<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />Ndóng ngki, thới teng rit sang tông: “Máh ar-náq ngki lư crái a-rớq ngki a-láng lớiq?” <verse eid="ACT 7:1" /><verse number="2" style="v" sid="ACT 7:2" />Iki, án ôi:</para>
  <para style="p" vid="ACT 7:2">“Em ai ơi, top i-nha a-lứng máh ti-cuôi a-riaih, seq cam-máng: Yang Arbang Pilŏ́ng sút pưt khoiq a-páh ada a-chúc a-chiac A-pra-ham na top he ndóng án át tớq Mê-sô-bô-ta-mi, nsuôi díh ndóng ti-cuôi tu-mống tớq Ha-ran; <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />a-lứng Án tông ada án: ‘Cóq ngốh te cruông na mái, mu chứng te tŏ́ng toiq na mái, dyơ mái cóq pôq nga cruông ma Cư ngki lư ca to ada mái.’ <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />Dyơ ngki, ndóng ngốh te cruông na ti-cuôi Cal-dê, án tu-mống tớq Ha-ran. Dyơ tư ngki, ndóng a-ám án cu-chet, Yang Arbang Pilŏ́ng khoiq dông án mot cruông ndô, tớq ntúq ma i-nha chón át tu-mống. <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />Án khoiq lớiq dyôn ada án mui nốh a-mớh tớq cruông, díh mui ntúq na ưllang dyưng la ớq. Iki Án khoiq ưq dyôn cruông ada án dŏq cơt ưlla, a-lứng dyôn tŏ́ng toiq na án cláp liêh án, lư án i-yốh bôn a-cái. <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />Ma, Yang Arbang Pilŏ́ng khoiq tông idô, ngki tŏ́ng toiq mái lư cơt máh ti-cuôi tu-moi tớq mui cruông lớiq ưlla, dyơ ngai can-nŏ́h lư pa-tot nha-án táq sol a-lứng táq diêiq a-rức tớq puan cu-lám cu-mo. <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />Yang Arbang Pilŏ́ng tông: ‘Ma Cư ính car-liêh dơq cruông cu-teq ma nha-án khoiq táq sol, dyơ vít ngki, nha-án lư ngốh nha sang tám Cư tớq ntúq ndô.’ <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />Án lư khoiq dyôn ada án car-hŏt te táq rit kít, a-lứng co iki, án ca-nian I-sac nha táq rit kít dyôn a-cái án tớq i-ngái ti-col; I-sac táq a-rớq iki dyôn Ya-côp, a-lứng Ya-côp táq mu chứng iki dyôn mu chít la bar a-chúc a-chiac. <verse eid="ACT 7:8" /><verse number="9" style="v" sid="ACT 7:9" />Co top a-chúc a-chiac a-ính Yô-sep, nha-án khoiq táiq án nga Ê-yip-tô; Ma Yang Arbang Pilŏ́ng át a-lứng án, <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />a-lứng ta-léh choi án vít cứp callong diêiq a-rức na án, Án lư dyôn callong bún a-lứng callong tu-báiq ada án chứng mát Pha-ra-ôn, puô Ê-yip-tô, nha puô ngki khoiq dyôn án cơt sút tớq Ê-yip-tô a-lứng díh dúng án. <verse eid="ACT 7:10" /><verse number="11" style="v" sid="ACT 7:11" />Chón ngki, callong pi-nhaih tar-riat tớq chuôp díh cruông Ê-yip-tô nha Ca-na-an, la callong diêiq a-rức lư pưt, a-lứng top a-chúc a-chiac na top he ớq bôn tu-múh crơng tan-na. <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />Ma, ndóng sáng tớq Ê-yip-tô bôn crơng tan-na, Ya-côp yua top a-chúc a-chiac top he pôq tu-ki chư tôm lư. <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />A-lứng tớq chư bar loi, Yô-sep khoiq táq a-páh dyôn top ai án, dyơ dúng su na Yô-sep khoiq Pha-ra-ôn a-cớl. <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />Dyơ ngki, vít ndóng yua top ai chô, Yô-sep dyôn cớiq Ya-côp, a-ám án, a-lứng nhéq máh em ai, ma callứng ti-cuôi tu-pul chít la sông. <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />Iki, Ya-côp pôq nga Ê-yip-tô, dyơ án cu-chet, nha máh a-chúc a-chiac na top he mu chứng iki tưi. <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />Nha-án bôn dông tớq Se-chem dyơ tứp tớq ping ma A-pra-ham khoiq plới te máh práq cúc te top a-cái conh na Ha-mor tớq Se-chem. <verse eid="ACT 7:16" /><verse number="17" style="v" sid="ACT 7:17" />Ndóng ngki, veng a-rớq i-ngái na par-nai par-ưq ma Yang Arbang Pilŏ́ng khoiq car-hŏt ada A-pra-ham khoiq tớq tar-mán, máh ti-cuôi clứng lư nha cơt a-ưi loi tớq Ê-yip-tô, <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />dyôn tớq ndóng mu náq puô can-nŏ́h cơt táq sút cruông Ê-yip-tô, ma puô ngki lư lớiq chom Yô-sep. <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />Co ính táq ti-cuôi prái top he, puô ngki khoiq táq lớiq ŏ a-chúc a-chiac top he, táq dyôn ngai a-cái mbơiq car-nian na nha-án cóq pôq phôt, lớiq têq dŏq dyôn tu-mống. <verse eid="ACT 7:19" /><verse number="20" style="v" sid="ACT 7:20" />Ndóng i-ngái ma Môi-se bôn car-nian, án ŏ lư chứng Yang Arbang Pilŏ́ng. Án tu-mống pe ki-sái tớq dúng a-ám án. <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />Dyơ ngki, ndóng án ngai bôn tu-múh, a-cái cán na Pha-ra-ôn khoiq dông án pôq a-lứng chứm chiam án a-rớq a-cái conh án. <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />Môi-se bôn ngai pa-rian te cứp callong tu-báiq na ti-cuôi Ê-yip-tô, án lư cơt hôi tớq par-nai ntêr nha ar-náq táq na án. <verse eid="ACT 7:22" /><verse number="23" style="v" sid="ACT 7:23" />Ma ndóng tớq díh puan chít cu-mo khoiq tớq nga án, ngáh par-ngíh tớq mít án ính cláh clơ em ai án, la a-cái a-mon Isa-ra-el. <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />Ndóng hôm mu náq ti-cuôi can-nŏ́h ngai púh tính, án khoiq tớq choi a-lứng khoiq táq callong car-liêh dơq dyôn ti-cuôi ndon táq lớiq ŏ ndóng púh ca-chet ti-cuôi Ê-yip-tô ntíh, <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />án yôl par-ngíh i-nha chom dyơ Yang Arbang Pilŏ́ng co ati án chón dông a-tớq callong choi ta-mống dyôn nha-án, ma nha-án lớiq a-púh. <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />I-ngái ta-tun, án a-páh pan-di nha-án chón ndóng tar-miên, a-lứng án dyŏq nha-án dyôn cơt ar-toi liêh, idô: ‘Ndô mu ai, top i-nha lư em ai. Co i-mo top i-nha tar-táq ada tar-tuôq?’ <verse eid="ACT 7:26" /><verse number="27" style="v" sid="ACT 7:27" />Ma ti-cuôi chón lop pa-dớm ti-cuôi pa-niar án khoiq ki-túh án ngốh, tông: ‘Nnáu khoiq yua mái cơt ti-cuôi sút a-lứng ti-cuôi par-chen tớq top he? <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />A-láng la mái chón ính ca-chet cư a-rớq ma mái khoiq ca-chet ti-cuôi Ê-yip-tô i-ngái i-nô?’ <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />Iki, Môi-se lúh nsuôi te par-nai ntêr ngki, a-lứng án cơt tu-moi át tớq cruông Ma-da-an, ntúq ma án car-nian bar lám a-cái conh. <verse eid="ACT 7:29" /><verse number="30" style="v" sid="ACT 7:30" />Ndóng puan chít cu-mo khoiq vít, bôn tar-neng mpáh a-lứng án tớq ntúq aih tar-mán cóh Si-nai, a-rớq pallô uih ntúq ar-bu tang-háng. <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />Chón ngki, ndóng bôn hôm iki, Môi-se sáng dut lư te ar-náq ngki, dyơ ndóng án tớq tar-mán dŏq me dyôn ar-lớih, ngki bôn siêng te Yang: <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />‘Cư la Yang Arbang Pilŏ́ng te a-chúc a-chiac i-nha, Yang Arbang Pilŏ́ng na A-pra-ham, na I-sac nha Ya-côp.’ Chón ngki, co sáng a-dáh lư tớq, Môi-se lớiq dáh me. <verse eid="ACT 7:32" /><verse number="33" style="v" sid="ACT 7:33" />Dyơ Yang tông ada án: ‘Cóq luaiq cơp ngki te dyưng mái, co ntúq ma mái chón ta-yứng la cu-teq práh ŏ. <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />Cua dyơ me, Cư khoiq bôn hôm callong diêiq a-rức na ti-cuôi prái Cư tớq Ê-yip-tô, Cư khoiq sáng siêng cu-cloiq te nha-án, a-lứng Cư khoiq siar dŏq tar-choi nha-án. Hoi ndô, cóq tớq tu-dô a-chái, Cư yua mái pôq nga Ê-yip-tô.’ <verse eid="ACT 7:34" /><verse number="35" style="v" sid="ACT 7:35" />Môi-se ndô, án ndon nha-án khoiq ca-lôih ndóng tông: ‘Nnáu khoiq chóh mái táq ti-cuôi sút a-láng dŏq par-chen?’ — Yang Arbang Pilŏ́ng yua mái cơt táq ti-cuôi sút cơt táq ti-cuôi tar-choi, co ati te tar-neng khoiq a-páh ada mái ntúq ar-bu tang-háng. <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />Án khoiq dông nha-án ngốh, dyơ vít táq máh ar-náq laq nha si-leh tớq cruông Ê-yip-tô a-lứng tớq Dơq Ving Ca-vang Cu-sáu, a-lứng tớq ntúq aih nhéq puan chít cu-mo. <verse eid="ACT 7:36" /><verse number="37" style="v" sid="ACT 7:37" />Ngki la Môi-se, án khoiq tông ada a-cái a-con Isa-ra-el: ‘Yang Arbang Pilŏ́ng lư rêh mu náq tang ng-cang dyôn ada i-nha a-rớq cư, te máh top em ai na i-nha.’ <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />Ndô la ti-cuôi át mui top tớq ntúq aih mu nơi a-lứng máh tar-neng, Yang khoiq tông ada án tớq cóh Si-nai, a-lứng ada a-chúc a-chiac na top he, án la ti-cuôi khoiq bôn ráp par-nai tu-mống níc dyôn ada top he, <verse eid="ACT 7:38" /><verse number="39" style="v" sid="ACT 7:39" />ma ada án, a-chúc a-chiac top he lớiq ính cam-máng; ma lư, nha-án ca-lôih a-lứng píh mít án a-nga Ê-yip-tô, <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />ndóng yua A-rôn: ‘Cóq táq dyôn top he rup yang dŏq a-yông top he. Ma te Môi-se ndô, án khoiq dông top he ngốh te cruông Ê-yip-tô, top he lớiq chom ar-náq a-mớh khoiq cơt ada án.’ <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />Iki, nha-án táq rup car-rŏ́q a-cái tớq máh i-ngái ngki a-lứng mŏp sang dyôn rup ngki, dyơ sáng bui co te ar-náq na ati nha-án. <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />Dyơ ngki, Yang Arbang Pilŏ́ng nguai viang a-lứng táh nha-án sang tám mát pan-dang, ki-sái tớq pilŏ́ng, a-rớq dŏq ta-ran tớq u-ráq na tang ng-cang:</para>
  <para style="q1" vid="ACT 7:42">‘Ơi ti-cuôi Isa-ra-el, a-láng top i-nha khoiq mŏp dyôn Cư máh pan-nán a-lứng máh crơng</para>
  <para style="q1" vid="ACT 7:42">díh puan chít cu-mo tớq ntúq aih?<verse eid="ACT 7:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43" />Top i-nha khoiq crang dúng prới na yang Mô-lec</para>
  <para style="q1" vid="ACT 7:43">a-lứng pan-tôr yang Rôm-phan na top i-nha,</para>
  <para style="q1" vid="ACT 7:43">— máh mol rup ma top i-nha khoiq táq cơt dŏq sang tám nha-án —</para>
  <para style="q1" vid="ACT 7:43">a-lứng Cư lư a-tức top i-nha pa dyang a-tóh Ba-bi-lôn.’<verse eid="ACT 7:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="ACT 7:44" />Dúng sang prới át a-lứng a-chúc a-chiac top he tớq ntúq aih, a-rớq Án tông ada Môi-se khoiq dŏq ca to, cóq táq dúng prới ngki veng a-rớq ndon án khoiq hôm, <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />ma co te dúng prới ngki, cua dyơ bôn ưlla tưi, a-chúc a-chiac top he la khoiq dông liêh tớq pang Yô-sua te ar-náq ial cruông na máh ti-cuôi ma Yang Arbang Pilŏ́ng khoiq dŏq chuih chứng mát a-chúc a-chiac top he ti-ngôi pang Da-vit, <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />la án bôn bún chứng mát Yang Arbang Pilŏ́ng, nha án khoiq seq dŏq suô mui ntúq át dyôn dúng na Ya-côp. <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />Iki, Sa-la-môn khoiq táq dŏq dúng dyôn Án. <verse eid="ACT 7:47" /><verse number="48" style="v" sid="ACT 7:48" />Ma, Án Sút Pưt lớiq át tớq dúng te ati ti-cuôi táq cơt, a-rớq ti-cuôi tang ng-cang bôn tông: <verse eid="ACT 7:48" /><verse number="49" style="v" sid="ACT 7:49" />‘Yang tông: Pilŏ́ng la ki-chơng Cư, nha cu-teq la tar-dơl ta-cưn dyưng Cư. Top i-nha lư táq dúng i-mo dyôn ada Cư? Lớiq la ntúq mmo dŏq dyôn callong a-ngô na Cư? <verse eid="ACT 7:49" /><verse number="50" style="v" sid="ACT 7:50" />Tới ati Cư khoiq teng cơt nhéq tưh máh nốh ndô?’<verse eid="ACT 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />Ơi máh ti-cuôi cớng ngan, mít nha cu-tor lớiq ính rit kít ntíh! I-nha báq chíl Yang Ar-vai. A-chúc a-chiac na i-nha cơt i-mo, i-nha la mu chứng iki. <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />Bôn ti-cuôi mmo te máh ti-cuôi tang ng-cang a-chúc a-chiac na i-nha khoiq lớiq táq diêiq a-rức? Nha-án ca-chet máh ti-cuôi taq-ntêr nsuôi te callong tớq na Án Ti-nớng Tu-pứng, ma i-nha chón khoiq cơt ti-cuôi cu-liêu a-lứng ti-cuôi ca-chet Án, <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />ngki la máh ti-cuôi khoiq ráp phep rit co callong ca to na máh tar-neng, ma lớiq táq veng.”<verse eid="ACT 7:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />Dyơ ngki, tư bôn sáng máh par-nai ngki, nha-án sáng uan lư tớq mít nha-án, a-lứng nha-án cal-tưat ki-neng ada án. <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />Ma chón ndóng bôn callong bán kiaq te Yang Ar-vai, cua dyơ ti-ngưi me nga pilŏ́ng, án hôm callong ang ưr te Yang Arbang Pilŏ́ng a-lứng Yang Yê-su ta-yứng át pa a-tớm Yang Arbang Pilŏ́ng. <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />Án tông: “Me tíh, cư hôm máh lưp pilŏ́ng khoiq ngai pốh, a-lứng A-cái Yang Cơt Ti-cuôi ta-yứng át pa a-tớm Yang Arbang Pilŏ́ng.” <verse eid="ACT 7:56" /><verse number="57" style="v" sid="ACT 7:57" />Dyơ ngki, vít ndóng hiar yứng cang, nha-án ca-pát cu-tor án liêh dyơ mu nơi pa-lóng nga án. <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />Ndóng khoiq a-ngốh nga tiêh vel, nha-án tíq búl ada án. Top ti-cuôi ca-chet dŏq au te tiêh na nha-án tớq dyưng mu náq conh bánh ngai dŏq la Sau-lơ. <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />Nha-án tíq búl ada Ê-tiên chón ndóng án cớu seq, idô: “Ơi Yang Yê-su, seq ráp ial ar-vai cư.” <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />Dyơ, vít ndóng chóh tar-col, án hiar yứng lư: “Yang ơi, I-nha êq náp luaih ndô tớq nha-án.” Ndóng tông par-nai ngki dyơ án cu-chet.<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />Dyơ ngki, Sau-lơ khoiq sŏ́ng te ar-náq ca-chet Ê-tiên.</para>
  <para style="p" vid="ACT 8:1">Dyơ, tớq i-ngái ngki, bôn ngai táq diêiq a-rức lư khoiq tớq ada Top Tin tớq Yaru-salem, ma nhéq tưh ti-cuôi veng ta-pun pláh chap cứp cruông Yu-dê nha Sa-ma-ri, nưm top dyưng ati. <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />Máh ti-cuôi dyám náp khoiq dông tứp Ê-tiên a-lứng bôn callong nhiêm a-tíh lư pưt dyôn ada án. <verse eid="ACT 8:2" /><verse number="3" style="v" sid="ACT 8:3" />Ma, Sau-lơ táq diêiq a-rức lư dyôn Top Tin. Ndóng át pôq mot cứp dúng, a-ngốh díh ti-cuôi conh nha ti-cuôi cán ngốh, án crál nha-án tớq cŏq.<verse eid="ACT 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />Co iki, máh ti-cuôi ndon pláh chap khoiq pôq chuôp ntúq pau ntêr Par-nai ŏ te par-nai Yang. <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />Dyơ ngki, Phi-lip pôq nga vel Sa-ma-ri, án taq-ntêr Yang Choi Ta-mống dyôn nha-án. <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />Ndóng ngki, ti-cuôi clứng sŏ́ng át cam-máng te máh par-nai bôn Phi-lip ca to, chón ndóng cam-máng máh par-nai ngki a-lứng hôm máh ar-náq si-leh ma án táq. <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />Co clứng ti-cuôi te top nha-án bôn máh yang sáq pi-yúh, yang sáq khoiq ngốh ndóng hiar yứng cang lư. Ma clứng ti-cuôi a-ái cớng nha dyuat ngki bôn pa-lai bánh. <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />Chón ngki, bôn callong bui ơn lư pưt tớq vel ngki.<verse eid="ACT 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />Ma mu náq ti-cuôi conh ngki, nốh la Si-môn, tro ndô khoiq cơi táq mo tớq vel a-lứng táq dut lư ada ti-cuôi Sa-ma-ri, chóng ngin án la ti-cuôi khéh lư, <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />ti-cuôi ndon nhéq náq nha-án, te két díh pưt, nha-án át mmứng co tông idô: “Ti-cuôi ndô bôn chức te Yang Arbang Pilŏ́ng, la callong ngai dŏq la khéh lư.” <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />Dyơ ngki, ngai cam-máng veng án, co khoiq te dưnh lư dyơ, án khoiq táq nha-án sáng dut na máh máh ar-náq táq. <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />Ma ndóng nha-án náp Phi-lip, co bôn pau ntêr callong bui te cruông Yang Arbang Pilŏ́ng a-lứng nốh te Yang Choi Ta-mống Yê-su, nha-án táq tíc na dơq, díh ti-cuôi conh nha ti-cuôi cán. <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />Dyơ lư Si-môn la náp, ndóng khoiq ráp tíc na dơq, án yôl át níc a-lớng Phi-lip. Ma, tư bôn hôm máh ar-náq si-leh a-lứng máh ar-náq chức pưt lư khoiq cơt, án sáng dut lư.<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />Dyơ ngki, ndóng bôn sáng ar-lớih ti-cuôi vúng Sa-ma-ri khoiq tin tưi te Yang Arbang Pilŏ́ng, top dyưng ati tớq Yaru-salem yua Phi-er nha Yon pôq a-lứng nha-án, <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />la bar náq dyưng ati ndóng tớq nnơi, cớu seq dyôn nha-án, dŏq nha-án têq bôn ráp tưi Yang Ar-vai. <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />Co Án yôl i-yốh át tớq ti-cuôi mmo te nha-án, ma nha-án nưm la khoiq bôn táq tíc na dơq co nốh Yang Yê-su táp. <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />Iki bar náq dyưng ati ca-pơiq ati tớq nha-án, dyơ nha-án bôn ráp Yang Ar-vai. <verse eid="ACT 8:17" /><verse number="18" style="v" sid="ACT 8:18" />Dyơ ngki, tư hôm ar-lớih Yang Ar-vai khoiq dyôn te ar-náq ca-pơiq ati na top dyưng ati, Si-môn dyôn práq ada nha-án, <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />tông: “Seq dyôn ada cư chức ndô dŏq ti-cuôi mmo ma cư ca-pơiq ati dyơ, ti-cuôi ngki têq bôn ráp Yang Ar-vai.” <verse eid="ACT 8:19" /><verse number="20" style="v" sid="ACT 8:20" />Ma Phi-er tông ada án: “Dyôn têq práq na mái át tớq callong pu-pít a-lứng mái, co mái par-ngíh têq plới te callong choi mat te Yang Arbang Pilŏ́ng na práq! <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />Lớiq bôn phê lớiq la ar-pô a-mớh tớq ar-náq ndô dyôn ada mái, co mít mái lớiq lư ti-nớng tu-pứng chứng mát Yang Arbang Pilŏ́ng. <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />Iki, cóq piên lêq te callong saq ndô na mái a-lứng cớu seq te Yang, dáh lơ nhơ ngki ma par-ngíh te mít án lư bôn táh luaih. <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />Co cư hôm án chón át a-rớq mít a-táng a-lứng ta-chóq na callong lớiq ti-nớng.” <verse eid="ACT 8:23" /><verse number="24" style="v" sid="ACT 8:24" />Ma ôi liêh, Si-môn tông: “Seq top i-nha cớu seq te Yang tang dyôn cư, dŏq lớiq bôn par-nai mmo te máh ar-náq ma top i-nha khoiq taq-ntêr têq cơt ada cư.”<verse eid="ACT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25" />Iki, tư bôn tíc a-lứng ca to par-nai Yang, nha-án píh liêh nga vel Yaru-salem, nha pau ntêr Par-nai ŏ Yang dyôn a-ưi vel na ti-cuôi Sa-ma-ri.<verse eid="ACT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />Ndóng ngki, bôn tar-neng te Yang tông ada Phi-lip idô: “Cóq yôr ta-yứng a-lứng pôq nga ta-dưp tớq car-na te Yaru-salem tớq díh nga Ya-sa.” (Ngki la ntúq tiah.) <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />Ndóng khoiq yôr ta-yứng, án pôq, a-lứng me ntíh, mu náq ngai ng-conh, ti-cuôi Ê-thi-ô-bi, la dyưng ati puô na Can-dac, puô cán Ê-thi-ô-bi, la ti-cuôi chón át kiaq me nhéq máh crơng ntưn na cán ngki, án khoiq tớq dŏq sang tám tớq Yaru-salem, <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />dyơ ngki, án chón píh chô, ti-cu tớq kiên a-séh na án a-lứng dŏc tám u-ráq Ê-sai. <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />Dyơ ngki, Yang Ar-vai tông ada Phi-lip: “Cóq tớq tar-mán a-lứng tar-veng kiên a-séh ngki.” <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />Dyơ ngki, ndóng khoiq tớq, Phi-lip sáng ti-cuôi sút ndô chón dŏc tám u-ráq Ê-sai, ngki án plốh: “Mái lư chom a-púh máh callong mái chón dŏc a-láng lớiq?” <verse eid="ACT 8:30" /><verse number="31" style="v" sid="ACT 8:31" />Ma ti-cuôi ngki tông: “Cóq táq i-mo dyôn cư têq chom, nưm mu náq ti-cuôi ngki lư ca to ada cư?” Mu par-rứh ngki, án mơi Phi-lip sớr dŏq ti-cu mu nơi a-lứng án. <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />Dyơ ngki, ntúq Tám U-ráq Yang ma án chón dŏc la idô:</para>
  <para style="q1" vid="ACT 8:32">“Mái cơt ngai dông pôq a-rớq cưu tớq ính ca-chet,</para>
  <para style="q1" vid="ACT 8:32">a-lứng a-rớq cưu a-cái lúng chứng mát ti-cuôi kít sóc án,</para>
  <para style="q1" vid="ACT 8:32">iki, Mái lớiq pốh ng-cang bôm.<verse eid="ACT 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33" />Te callong pa-mat, crái piaiq na Mái khoiq ngai tar-píh.</para>
  <para style="q1" vid="ACT 8:33">Nnáu loi taq-ntêr tŏ́ng toiq Mái?</para>
  <para style="q1" vid="ACT 8:33">Co tar-ngứh Mái khoiq ính a-tức te cu-teq.”<verse eid="ACT 8:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 8:34" />Ndóng ôi, án ndon sút tông ada Phi-lip: “Cư seq mái dyôn cư chom, án tang ng-cang khoiq tông par-nai ndô te nnáu — te mái táp a-láng te mu náq ti-cuôi can-nŏ́h?” <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />Iki, pốh ta-cang ta-bớq te Tám U-ráq Yang ndô, Phi-lip pau ntêr Par-nai ŏ te Yang Yê-su dyôn ti-cuôi sút ngki. <verse eid="ACT 8:35" /><verse number="36" style="v" sid="ACT 8:36" />Dyơ ngki, ndóng nha-án chón pôq na car-na, nha-án pôq tớq ntúq bôn dơq ntíh, ngki ti-cuôi sút ngki tông: “Me ntíh, dơq! Callong a-mớh chón ca-táng cư ráp tíc na dơq?” <verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />[Dyơ ngki, Phi-lip tông ada án: “Khán mái tin nhéq te mít can-nính mái, ki mái lư bôn tu-mống.” Iki dyơ ndóng ôi liêh, án sút ngki tông: “Cư tin nga Yang Choi Ta-mống, la A-cái Yang Arbang Pilŏ́ng.”] <verse eid="ACT 8:37" /><verse number="38" style="v" sid="ACT 8:38" />Án ndon sút yua trín kiên a-séh ngki dyơ bar náq nha-án siar nga dơq, díh Phi-lip nha án ndon sút ngki, dyơ án táq tíc na dơq ada án sút ngki. <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />Dyơ ngki, ndóng nha-án khoiq sớr te dơq, Ar-vai te Yang dông Phi-lip pôq, nha án ndon sút ớq yôl bôn hôm án nnáng, án sút ngki sáng bui át pôq nưm car-na án. <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />Ma Phi-lip ngki khoiq bôn hôm tớq A-sô-tut, a-lứng ndóng pôq pha cruông ngki, án pau ntêr Par-nai ŏ Yang dyôn nhéq díh máh vel, ti-ngôi díh ndóng án pôq nga Sê-sa-rê.<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />Ma Sau-lơ, chón ndóng át tông par-nai can-nốh a-lứng ính ca-chet chíl liêh ada máh top rian na Yang, vít ndóng tớq nga thới teng rit sang, <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />ngki seq te án máh ar-láq chớiq dŏq dyôn nga dúng rum tớq Da-mac, nám khán án bôn tu-múh ti-cuôi mmo veng Ta-pun Yê-su, díh ti-cuôi conh nha ti-cuôi cán, ngki án cŏp nha-án chón ndóng chóq a-chô nga Yaru-salem. <verse eid="ACT 9:2" /><verse number="3" style="v" sid="ACT 9:3" />Dyơ ngki, chón ndóng pôq na car-na, ar-náq cơt ndóng án tar-mán tớq vel Da-mac, ti-cớr ang cláq te pilŏ́ng ta-bal nga án, <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />dyơ, ndóng dứm tớq cu-teq, án sáng siêng taq-ntêr tông ada án: “Sau-lơ, Sau-lơ, i-mo mái ính táq cư?” <verse eid="ACT 9:4" /><verse number="5" style="v" sid="ACT 9:5" />Dyơ ngki, án ôi: “Yang Ơi, I-nha la nnáu?” Yang tông: “Cư la Yê-su ma mái chón ính táq; <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />Ma, cóq yôr ta-yứng nha pôq mot nga vel, dyơ máh ar-náq lư bôn ntêr ada mái te callong a-mớh tar-náp dyôn mái dŏq táq.” <verse eid="ACT 9:6" /><verse number="7" style="v" sid="ACT 9:7" />Ma máh ti-cuôi pôq na car-na a-lứng án ta-yứng ngki lớiq ta-cang a-mớh nnáng, tư sáng siêng ma ớq hôm nnáu. <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />Dyơ ngki, Sau-lơ yôr ta-yứng te cu-teq, ma tư mát na án cơt ta-pốh, án ớq hôm a-mớh nnáng. Ma, vít dyơ kéu ati dông án pôq, nha-án dông án nga vel Da-mac. <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />Nhéq pe i-ngái, án lớiq bôn hôm a-mớh, a-lứng án ớq cha nha ớq ngoiq.<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />Ndóng ngki, tớq vel Da-mac bôn mu náq te top rian ntíh nốh A-na-niê. Yang tông ada án te mui nốh a-páh: “A-na-niê ơi!”. Dyơ án ôi: “Yang Ơi, áu seq me, a-cái ndô!” <verse eid="ACT 9:10" /><verse number="11" style="v" sid="ACT 9:11" />Dyơ ngki, Yang tông ada án: “ndóng yôr ta-yứng, cóq pôq nga car-na ngai dŏq La Ti-nớng, a-lứng cóq suô tớq dúng na Yu-da nốh Sau-lơ, ti-cuôi Tar-sơ, cóq mmứng, co ti-cuôi ndô chón cớu seq, <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />a-lứng tớq callong a-páh, án khoiq hôm mu náq nốh A-na-niê pôq mot dyơ ca-pơiq ati tớq án dŏq án têq plang mát liêh.” <verse eid="ACT 9:12" /><verse number="13" style="v" sid="ACT 9:13" />Ma A-na-niê ôi: “Yang Ơi, a-cái khoiq sáng te clứng ti-cuôi te ti-cuôi ndô, te a-ưi ar-náq lớiq ŏ án khoiq táq dyôn top veng ta-pun na Án tớq Yaru-salem. <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />A-lứng tớq ndô, án bôn chức sút te top thới teng rit sang dŏq cŏp chóq cứp ti-cuôi cớu arô nốh Án.” <verse eid="ACT 9:14" /><verse number="15" style="v" sid="ACT 9:15" />Dyơ ngki, Yang tông ada án: “Áu pôq, co ti-cuôi ndô la crơng na callong dŏq rêh dyôn ada Cư, dŏq dông nốh Cư tớq chứng mát máh ti-cuôi tới Isa-ra-el, nha díh máh puô, a-lứng a-cái a-cháu Isa-ra-el; <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />Co Cư ính a-páh dyôn ti-cuôi ngki chom án cóq chiuq diêiq a-rức a-ưi máh mmo co nốh Cư.” <verse eid="ACT 9:16" /><verse number="17" style="v" sid="ACT 9:17" />Dyơ ngki, A-na-niê ti-ráp a-lứng pôq mot tớq dúng ngki. Vít ndóng ca-pơiq ati tớq conh ngki, án tông idô: “Ơi ai Sau-lơ, Yang khoiq yua cư — la Yang Yê-su, Án khoiq a-páh ada mái tớq car-na ma mái pôq tớq ndô — dŏq mái têq bôn hôm liêh a-lứng bôn chom callong bán kiaq te Yang Ar-vai.” <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />Ngki táp, bôn mui nốh a-mớh a-rớq trơng, án a-tôh te mát na án, ma, án bôn hôm liêh, dyơ ndóng yôr ta-yứng, án ráp tíc na dơq; <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />Ndóng khoiq cua chi-cha, án bôn chô liêh rêng.</para>
  <para style="p" vid="ACT 9:19">Dyơ ngki, án át a-lứng máh top rian tớq Da-mac nsếq i-ngái. <verse eid="ACT 9:19" /><verse number="20" style="v" sid="ACT 9:20" />Ngki táp, án ca to par-nai ŏ Yang Yê-su tớq máh dúng rum, ngki Án la A-cái Yang Arbang Pilŏ́ng. <verse eid="ACT 9:20" /><verse number="21" style="v" sid="ACT 9:21" />Cứp ti-cuôi cam-máng sáng dut lư, tông: “Com ndô la ti-cuôi khoiq ta-lóh máh ti-cuôi cớu arô nốh ndô tớq Yaru-salem? A-lứng án khoiq tớq tu-dô co ar-náq ngki, dŏq vít ndóng cŏp chóq ngki dông nha-án chô dyôn ada top thới teng rit sang?” <verse eid="ACT 9:21" /><verse number="22" style="v" sid="ACT 9:22" />Ma Sau-lơ a-cán khớm pi-lư, a-lứng táq pi-ŏ́q dyôn máh ti-cuôi Isa-ra-el tu-mống tớq Da-mac na dyôn ngai chom ar-lớih Yê-su la Yang Choi Ta-mống.<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />Ma, tư a-ưi i-ngái khoiq vít, ti-cuôi Isa-ra-el tang-húng ính ca-chet án. <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />Ma, par-ngíh na nha-án khoiq bôn taq-ntêr dyôn Sau-lơ chom. Dyơ ngki, ngai lư kiaq máh par-ngốh vel díh i-ngái nha i-dáu dŏq ca-chet án. <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />Dyơ ngki, vít ndóng dông pôq tớq i-dáu, máh top rian na án dŏq án siar cu-lai tiêh car-rống vel, na a-tiar án siar tớq mui allám a-téh.<verse eid="ACT 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />Ma tư khoiq tớq nga Yaru-salem, án ca-tóng suô car-na dŏq têq bôn par-chúng a-lứng máh top rian, ma nhéq náq nha-án sáng a-dáh án, lớiq tin ngki án la top rian. <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />Dyơ ngki, ndóng dông án pôq, Ba-na-ba dông án pôq tar-múh máh top rian, dyơ ntêr dyôn nha-án i-mo ma mái khoiq chom Yang na car-na, mu chứng a-rớq Án khoiq tông ada mái, nha co i-mo tớq Da-mac, mái khoiq clŏ́q lư pau ntêr nhơ nốh Yang Yê-su. <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />Tư ngki, án át mu nơi a-lứng nha-án ndóng lu liêh tớq Yaru-salem, clŏ́q lư pau ntêr nhơ nốh Yang. <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />Án ntơnh taq-ntêr, ntơnh tar-miên a-lứng máh ti-cuôi Isa-ra-el ntêr cang Créc, ma nha-án suô ngê ca-chet án. <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />Ma tư khoiq chom iki, top nha-án dông án siar nga Sê-sa-rê, a-lứng dông án nga Tar-sơ.<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />Iki, ti-cuôi tin chuôp díh vúng Yu-dê, Ca-li-lê, nha Sa-ma-ri bôn callong iên ŏ; co bôn sŏ́ng mui mít ngki pôq mu nơi tớq callong dyám náp Yang a-lứng tớq callong khêr na Yang Ar-vai, ti-cuôi tin cơt clứng pi-lư. <verse eid="ACT 9:31" /><verse number="32" style="v" sid="ACT 9:32" />Dyơ ngki, ar-náq khoiq cơt ngki ndóng Phi-er chón pôq chuôp díh cruông, ngki dŏq pôq siar nga ntúq máh top tin tu-mống tớq Li-da. <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />Dyơ tớq ngki, án tar-múh mu náq ti-cuôi ngki, nốh Ê-nê, chón bíq a-ái cớng tớq ki-chơng khoiq ti-col cu-mo, án la ti-cuôi ndon a-ái cớng. <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />Phi-er tông ada án: “Ê-nê ơi, Yang Choi Ta-mống Yê-su pa-lai bánh dyôn mái. Cóq ta-yứng nha a-tức ki-chơng mái táp,” a-lứng ngki táp, án yôr ta-yứng. <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />Nhéq náq máh ti-cuôi át tu-mống tớq Li-da nha Sa-rôn khoiq hôm mái, nha-án lư píh liêh nga Yang.<verse eid="ACT 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />Chón ngki, tớq Yôp-pa bôn mu náq ndon rian ngki nốh Ta-bi-tha, nốh ngki, ndóng par-long liêh, ngai dŏq la Dôr-ca. Cán ndô táq máng máh ar-náq ŏ a-lứng a-ưi ar-náq tar-choi sớng ma án khoiq táq. <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />Ar-náq khoiq cơt tớq máh i-ngái ngki, ngki tư bôn callong a-ái, án cu-chet. Vít ngki, ndóng khoiq ta-hom ada án dyơ, ngai dŏq án tớq ntúq trơn bar. <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />Co Li-da át tu-mán Yôp-pa, iki máh top rian ndóng sáng dyơ Phi-er chón át tớq ngki, nha-án yua bar náq pôq cớiq án, tông idô: “Seq êq dyut dŏq tớq nga top he.” <verse eid="ACT 9:38" /><verse number="39" style="v" sid="ACT 9:39" />Dyơ ngki, ndóng yôr ta-yứng, Phi-er pôq mu nơi a-lứng nha-án, la máh ti-cuôi ndon, tư khoiq tớq nnơi, nha-án dông án sớr callúng trơn bar, dyơ nhéq máh cán cám mai tớq mu pa án nhiêm, a-lứng nưm dyôn án me máh au toiq mu chứng a-ưi tam-pớc máh mmo ndon Dôr-ca khoiq dyih ndóng yôl át a-lứng nha-án. <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />Ma tư khoiq yua nhéq náq ngốh nga tiêh a-lứng chóh tar-col a-siar, Phi-er cớu seq, dyơ ndóng pi-líh me nga cu-muiq, án tông: “Ta-bi-tha, áu yôr ta-yứng.” Dyơ ngki, cán ngki ca-plang mát án táp, a-lứng ndóng bôn hôm Phi-er, án yôr ti-cu. <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />Dyơ ndóng kéu ati ada cán ngki, án dơ cán ngki yôr ta-yứng, dyơ khoiq arô máh top veng a-lứng cán cám mai mot, án a-páh cán ngki yôl tu-mống. <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />Ndóng ngki, ar-náq ndô cơt par-dŏ́h par-hanh chuôp díh Yôp-pa a-lứng clứng ti-cuôi veng ta-pun Yang. <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />Ar-náq cơt ta-tun ngki la án khoiq át liêh a-ưi i-ngái tớq Yôp-pa a-lứng mu náq ti-cuôi ngki nốh Si-môn, la thơq táq ng-cár.<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />Ndóng ngki tớq vel Sê-sa-rê, mu náq ti-cuôi ngki nốh Cor-nai, la ti-cuôi sút tớq top líng ngai dŏq la I-ta-li, <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />la ti-cuôi ti-nớng ŏ a-lứng dyám náp Yang Arbang Pilŏ́ng a-lứng díh dúng án, táq a-ưi ar-náq tar-choi sớng dyôn ti-cuôi prái nha cớu seq nga Yang Arbang Pilŏ́ng cứp i-ngái. <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />Bôn ali mát pan-dang viêt i-ngái ngki, tớq callong a-páh baih, án bôn hôm ar-lớih lư mu náq tar-neng na Yang Arbang Pilŏ́ng tớq nga án a-lứng tông ada án: “Cor-nai ơi!” <verse eid="ACT 10:3" /><verse number="4" style="v" sid="ACT 10:4" />Ma ndóng me tiêu-liêu nga tar-neng ngki co sáng a-dáh, án plốh: “Yang ơi, bôn ar-náq a-mớh?” Dyơ tar-neng ngki tông ada án: “Máh par-nai cớu seq na mái a-lứng máh ar-náq tar-choi sớng te mái khoiq díh chứng mát Yang Arbang Pilŏ́ng a-rớq mui crơng mŏp sang ayư níc. <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />Dyơ ngki, cóq yua ti-cuôi tớq Yôp-pa a-lứng yua mơi Si-môn ngki, án ngai dŏq la Phi-er. <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />Án chón chi-cha tớq dúng co mu náq Si-môn ntíh, thơq táq ng-cár, la ti-cuôi bôn dúng tar-dáng tor dơq ving ca-vang,” <verse eid="ACT 10:6" /><verse number="7" style="v" sid="ACT 10:7" />Iki dyơ, ndóng tar-neng ngki, la ndon tông ada án, khoiq ngốh dyơ, ngki vít ndóng arô bar náq táq sol tớq dúng, a-lứng mu náq líng nhéq mít can-nính te máh ti-cuôi ính choi án, <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />nha ndóng khoiq ntêr ada nha-án cứp par-nai, án yua nha-án pôq nga Yôp-pa.<verse eid="ACT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />I-ngái ta-tun, chón ndóng máh ti-cuôi ngki pôq na car-na a-lứng ính tớq vel, Phi-er sớr tớq mpuông dúng dŏq cớu seq bôn ali mát pan-dang tứng. <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />Ndóng ngki, án ta-bớq sáng pi-nhaih nha ính chi-cha, ma tớq ndóng ngai chón ti-ráp dôi tan-na, callong a-páh baih tớq nga án, <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />án hôm pilŏ́ng khoiq dŏq pốh a-lứng bôn nốh a-mớh a-tôh, a-rớq mêng prới chír lư, bôn a-tôh tớq cu-teq a-rớq dŏq chóq puan tol, <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />ma tớq ngki la nhéq máh thư pan-nán puan dyưng, máh thư pan-nán na cu-teq a-lứng máh thư a-chếq pilŏ́ng. <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />Dyơ bôn siêng tu-bau tớq nga án: “Phi-er, ndóng ta-yứng, cóq ca-chet pan-nán ngki dyơ cha viang.” <verse eid="ACT 10:13" /><verse number="14" style="v" sid="ACT 10:14" />Ma Phi-er ôi: “Yang Ơi, lớiq têq a-mớh, co cư lớiq cơi cha nhéq máh nốh a-mớh a-íh a-lứng lớiq práh ŏ.” <verse eid="ACT 10:14" /><verse number="15" style="v" sid="ACT 10:15" />A-lứng mu chư loi, siêng tông ngki tớq ada án tớq chư bar: “Nốh a-mớh Yang Arbang Pilŏ́ng khoiq táq práh, mái êq me la a-íh.” <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />Dyơ ngki, ar-náq ndô khoiq cơt tớq pe can-tứq, a-lứng prới ngki ndóng ngki táp sớr liêh nga pilŏ́ng.<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />Dyơ ngki, chón ndóng Phi-er sáng dut lư tớq mít callong a-páh ndon án mbơiq hôm la a-mớh, ngki me ntíh, máh ti-cuôi ndon Cor-nai yua pôq khoiq ta-yứng ngáh callống, ndóng suô plốh dúng Si-môn. <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />Tu-bau arô, nha-án plốh Si-môn, ngai dŏq la Phi-er, lư a-láng lớiq la chón bôn át tớq ndô. <verse eid="ACT 10:18" /><verse number="19" style="v" sid="ACT 10:19" />Ma Phi-er, chón ndóng yôl át par-ngíh te callong a-páh ntíh, Ar-vai Yang tông ada án: “Me ntíh, pe náq ngai conh chón suô mái. <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />Ma ndóng yôr ta-yứng, mái cóq siar nha pôq a-lớng nha-án, êq a-dáh a-mớh, co Cư khoiq yua nha-án.” <verse eid="ACT 10:20" /><verse number="21" style="v" sid="ACT 10:21" />Iki, ndóng khoiq pôq tu-múh máh ti-cuôi ngki, Phi-er tông: “Me ndô, cư la ti-cuôi top i-nha át suô. Co callong a-mớh ma i-nha tớq tu-dô?” <verse eid="ACT 10:21" /><verse number="22" style="v" sid="ACT 10:22" />Dyơ ngki, nha-án ôi: “Án ndon sút Cor-nai, la ti-cuôi ti-nớng a-lứng dyám náp Yang Arbang Pilŏ́ng, ma bôn crái piaiq ada máh ti-cuôi Isa-ra-el, khoiq bôn tar-neng Yang práh ŏ pa-táp cóq mơi mái tớq nga dúng án dŏq cam-máng máh par-nai ca to tớq te mái.” <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />Iki, ndóng khoiq mơi nha-án mot nga dúng, án a-ngốh tan-na ada nha-án.</para>
  <para style="p" vid="ACT 10:23">Dyơ i-ngái ngki loi, vít ndóng yôr te bíq, án pôq a-lớng nha-án, nha bôn em ai te Yôp-pa pôq tưi a-lớng án. <verse eid="ACT 10:23" /><verse number="24" style="v" sid="ACT 10:24" />A-lứng dyơ, i-ngái ta-tun loi, nha-án pôq nga Sê-sa-rê. Chón ngki, Cor-nai át pớn nha-án, chón ndóng khoiq arô clứng em ai án a-lứng máh yớu bới ar-toi lư par-chúng mu nơi. <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />Ndóng ngki, ar-náq khoiq cơt tư Phi-er mot, ndóng tar-múh án, Cor-nai chóh tar-col, cu-cúh tớq dyưng án. <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />Ma Phi-er tec án yôr, tông: “Seq yôr ta-yứng! Cháq chớn cư ngki la ti-cuôi tưi.” <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />Chón ndóng taq-ntêr a-lớng Cor-nai, án mot dyơ hôm clứng ti-cuôi khoiq par-chúng mu nơi. <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />Dyơ ngki, án tông ada nha-án: “Lư i-nha chom ndô la callong lớiq piaiq phep rit i-mo ada ti-cuôi Isa-ra-el ính ar-toi a-láng cláh clơ mu náq ti-cuôi tới Isa-ra-el, ma ada cư, Yang Arbang Pilŏ́ng khoiq ca to êq tông mu náq ti-cuôi la a-íh a-láng lớiq práh. <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />Co iki, cua dyơ mơi, cư khoiq pôq cơt lớiq sáng a-dáh. Iki, cư át ar-ngíh, co callong a-mớh ma i-nha pôq mơi cư?” <verse eid="ACT 10:29" /><verse number="30" style="v" sid="ACT 10:30" />Cor-nai ôi: “Puan i-ngái nsuôi, díh i-ngái ndô, cư át cớu seq tớq dúng cư chón mát pan-dang viêt, ngki me ntíh, bôn mu náq ta-yứng chứng mát cư te tam-pớc ang ưr, <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />dyơ ti-cuôi ngki tông: ‘Cor-nai, par-nai cớu seq na mái khoiq bôn sáng nha máh ar-náq tar-choi sớng na mái khoiq bôn ayư níc chứng mát Yang Arbang Pilŏ́ng. <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />Iki, cóq yua ti-cuôi pôq nga Yôp-pa a-lứng mơi Si-môn, la ti-cuôi ngai dŏq la Phi-er. Án chón chi-cha tớq dúng na Si-môn, la thơq táq ng-cár, tar-mán tor dơq ving ca-vang.’ <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />Co iki, cư yua táp ti-cuôi pôq mơi mái, dyơ mái lư khoiq táq crái piaiq ndóng tớq tu-dô. Iki, hoi ndô, nhéq náq top he chón át ndô chứng mát Yang Arbang Pilŏ́ng ính cam-máng cứp callong khoiq bôn Yang ca to ada mái.” <verse eid="ACT 10:33" /><verse number="34" style="v" sid="ACT 10:34" />Dyơ ngki, ndóng pốh par-nai ính ôi, Phi-er tông: “Me te callong piaiq, cư chom ar-lớih ngki Yang Arbang Pilŏ́ng tới la Án lớiq li-arli. <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />Ma lư ngki, tớq cứp cruông, nnáu dyám náp Án a-lứng táq ar-náq ti-nớng tu-pứng ngki bôn sáng bui ada Án. <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />Par-nai ma Án khoiq dyôn tớq nga ti-cuôi Isa-ra-el, ndóng pau ntêr Par-nai ŏ Yang te callong iên ŏ Yang Choi Ta-mống Yê-su — Án la Yang na nhéq tưh ti-cuôi — <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />I-nha khoiq chom ndóng máh ar-náq cơt par-dŏ́h díh cruông Yu-dê, nsuôi lư tớq Ca-li-lê, vít táq tíc na dơq ndon Yon khoiq ca to, <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />te Yê-su, Án tớq te Na-sa-ret, ma i-mo Yang Arbang Pilŏ́ng khoiq rêh dyôn Án na Yang Ar-vai a-lứng chức sút, la Án pôq tu-dô tu-ki táq ar-náq ŏ a-lứng pa-lai bánh cứp ti-cuôi ndon yang saq pi-yúh, co Yang Arbang Pilŏ́ng át a-lớng Án. <verse eid="ACT 10:38" /><verse number="39" style="v" sid="ACT 10:39" />Top he la máh ti-cuôi bôn hôm te nhéq máh ar-náq ndon Án khoiq táq, tớq cruông na ti-cuôi Isa-ra-el nha tớq Yaru-salem, a-lứng la Án ma nha-án khoiq ca-chet viang na chóq ta-yŏ́ng Án tớq a-long calláng. <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />Yang Arbang Pilŏ́ng khoiq táq dyôn Án tu-mống liêh nga i-ngái pe a-lứng dyôn Án cơt bôn a-páh, <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />tới dyôn nhéq tưh cứp ti-cuôi, ma dyôn máh ti-cuôi bôn hôm khoiq bôn Yang Arbang Pilŏ́ng rêh te nsuôi — dyôn top he, máh ti-cuôi khoiq cha a-lứng ngoiq mu nơi a-lứng Án vít ndóng Án tu-mống liêh te cu-chet. <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />Án khoiq yua top he pau ntêr dyôn ti-cuôi clứng a-lứng taq-ntêr crái piaiq idô Án la Yê-su khoiq bôn Yang Arbang Pilŏ́ng dŏq rêh dyôn Án tar-sưq ti-cuôi tu-mống nha ti-cuôi cu-chet. <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />Ngki la te Án, nhéq máh ti-cuôi tang ng-cang ta-ran idô khán nnáu dŏq mít tin te Án ngki bôn ráp callong ta-láh luaih lới nhơ nốh Án.”<verse eid="ACT 10:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />Chón ndóng Phi-er yôl át taq-ntêr máh par-nai ngki, Yang Ar-vai mot át tớq cứp ti-cuôi chón cam-máng par-nai te án. <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />Máh ti-cuôi ndon te top táq rit kít — la máh ti-cuôi khoiq pôq mu nơi a-lứng Phi-er — lư sáng dut, co callong choi mat te Yang Ar-vai ngki khoiq bôn tốq tớq ti-cuôi tới Isa-ra-el. <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />Co nha-án sáng máh ti-cuôi ndô taq-ntêr na máh cang can-nŏ́h a-lứng cứh ayô Yang Arbang Pilŏ́ng. Tớq ndóng ngki, Phi-er pốh ta-cang: <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />“A-láng bôn ti-cuôi mmo têq ca-táng dơq dŏq máh ti-cuôi ndô lớiq têq táq tíc na dơq, ngki la máh ti-cuôi khoiq bôn ráp Yang Ar-vai mu chứng a-rớq top he?” <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />Dyơ ngki, án yua nha-án táq tíc na dơq nhơ nốh Yang Choi Ta-mống Yê-su. Vít ngki, nha-án seq án át liêh nsếq i-ngái.<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />Dyơ ngki, top dyưng ati a-lứng em ai át chuôp Yu-dê sáng idô ti-cuôi tới Isa-ra-el lư khoiq tin tưi par-nai na Yang Arbang Pilŏ́ng. <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />Iki dyơ, ndóng Phi-er pôq nga Yaru-salem, máh ti-cuôi te top táq rit kít tar-miên a-lứng án, <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />tông idô mái khoiq pôq át tớq ntúq máh ti-cuôi i-yốh táq rit kít nha cha mu nơi a-lứng nha-án. <verse eid="ACT 11:3" /><verse number="4" style="v" sid="ACT 11:4" />Ma ndóng ính ôi, Phi-er roih liêh dyôn nha-án máh ar-náq khoiq cơt idô: <verse eid="ACT 11:4" /><verse number="5" style="v" sid="ACT 11:5" />“Cư chón cớu seq tớq vel Yôp-pa, a-lứng tớq callong pít mít dyôn cư hôm mpáh te mui nốh a-mớh ngki chón a-tôh, a-rớq mêng prới chír ndóng puan tol bôn a-tôh te pilŏ́ng a-lứng prới ngki tớq tar-dáng ntúq cư, <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />ma ndóng me nga prới ngki, cư mmứng a-lứng hôm máh thư pan-nán puan dyưng tớq cu-teq, máh thư pan-nán cruông, máh thư pan-nán pôq nhal-nhíc, mu chứng máh thư a-chếq pilŏ́ng. <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />Dyơ cư bôn sáng siêng tông ada cư: ‘Phi-er, ndóng yôr ta-yứng, cóq ca-chet pan-nán ngki a-lứng cha viang!’ <verse eid="ACT 11:7" /><verse number="8" style="v" sid="ACT 11:8" />Ma cư ôi: ‘Yang Ơi, lớiq têq a-mớh, co nốh a-íh lớiq la lớiq práh ŏ lớiq cơi pôq mot tớq ng-cang cư.’ <verse eid="ACT 11:8" /><verse number="9" style="v" sid="ACT 11:9" />Ma, siêng te pilŏ́ng tông liêh tớq chư bar loi: ‘Máh nốh Yang Arbang Pilŏ́ng khoiq táq práh, mái lớiq têq tông la a-íh.’ <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />Dyơ ngki, ar-náq ndô khoiq cơt tớq pe chư, dyơ cứp nốh ngki bôn sớr liêh nga pilŏ́ng. <verse eid="ACT 11:10" /><verse number="11" style="v" sid="ACT 11:11" />A-lứng me ntíh, pe náq ngai ng-conh ngki táp ta-yứng chứng ngáh dúng ma top he chón tớq callúng, co khoiq bôn yua pôq te Sê-sa-rê tớq nga cư. <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />Ndóng ngki, Yang Ar-vai yua cư pôq a-lứng nha-án, lớiq sáng a-dáh a-mớh. Iki, tu-pát náq em ai ndô la pôq a-lớng cư, nha top he pôq mot tớq dúng na ti-cuôi ngki. <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />Dyơ ngki, án taq-ntêr liêh dyôn top he i-mo án khoiq hôm tar-neng Yang ta-yứng tớq dúng án, tông idô: ‘Cóq yua ti-cuôi pôq nga Yôp-pa a-lứng dyôn mơi Si-môn, án ngai dŏq la Phi-er, <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />la án lư ntêr ada mái máh par-nai ca to ma te ngki, mái lư bôn tu-mống — mái a-lứng díh dúng na mái.’ <verse eid="ACT 11:14" /><verse number="15" style="v" sid="ACT 11:15" />Ma ndóng cư ính taq-ntêr, Yang Ar-vai khoiq mot át tớq nha-án mu chứng a-rớq tớq top he ndóng te nsuôi lư. <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />Dyơ cư ayư liêh par-nai tông te Yang, i-mo Án báq tông: ‘Yon khoiq táq tíc na dơq; ma i-nha lư bôn táq tíc na Yang Ar-vai.’ <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />Iki, khán Yang Arbang Pilŏ́ng khoiq dyôn ada nha-án callong choi mat mu chứng a-rớq dyôn top he ndóng dŏq mít tin nga Yang, Yang Choi Ta-mống Yê-su, cư la nnáu ma dáh ca-táng Yang Arbang Pilŏ́ng?” <verse eid="ACT 11:17" /><verse number="18" style="v" sid="ACT 11:18" />Dyơ ngki, tư khoiq sáng máh par-nai ngki, nha-án lớiq tar-miên ma cứh ayô Yang Arbang Pilŏ́ng, tông idô: “Khán ngki Yang Arbang Pilŏ́ng khoiq dyôn ada ti-cuôi tới Isa-ra-el mít piên lêq tớq nga callong tu-mống.”<verse eid="ACT 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />Vít ngki, máh ti-cuôi ndon pláh chap te callong ndon diêiq a-rức ma Ê-tiên khoiq tar-múh díh nga Phê-na-si, Sip-rơ nha An-ti-ôt, lớiq taq-ntêr ada nnáu te par-nai ŏ Yang, ma nưm ti-cuôi Isa-ra-el. <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />Ma bôn ti-cuôi te top ngki la máh ti-cuôi lư Sip-rơ nha Si-ren, ma máh ti-cuôi ndô ndóng khoiq tớq nga An-ti-ôt, nha-án lư ntêr ada máh ti-cuôi Créc, pau ntêr Par-nai ŏ te Yang Yê-su. <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />Ati na Yang át a-lớng nha-án; nha bôn ti-cuôi lư clứng, co tin, khoiq píh chô nga Yang. <verse eid="ACT 11:21" /><verse number="22" style="v" sid="ACT 11:22" />Dyơ ngki, ar-náq te máh ti-cuôi ndô ntêr díh cu-tor top tin át tớq Yaru-salem, iki nha-án yua Ba-na-ba pôq díh tớq An-ti-ôt, <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />ma ndóng tớq nnơi a-lứng bôn hôm callong choi mat te Yang Arbang Pilŏ́ng, án sáng bui tưi nha láh a-liam nhéq náq át níc tớq Yang te callong chiuq ta-nhir tớq mít can-nính. <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />Co án la mu náq ti-cuôi par-tát, callong bán kiaq te Yang Ar-vai a-lứng callong tin, nha clứng ti-cuôi bôn mot tin nga Yang. <verse eid="ACT 11:24" /><verse number="25" style="v" sid="ACT 11:25" />Vít ngki, án pôq nga Tar-sơ ính suô Sau-lơ. <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />Ndóng khoiq bôn tu-múh, án dông Sau-lơ nga An-ti-ôt. Dyơ ngki, ar-náq khoiq cơt ada nha-án díh tớq mui cu-mo ngki bôn rum liêh a-lứng top tin nha ca to clứng ti-cuôi. Ma, chư tôm lư tớq An-ti-ôt, máh top rian ngai dŏq la Top Yang Yê-su.<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />Dyơ ngki, tớq máh i-ngái ngki, máh ti-cuôi tang ng-cang te Yaru-salem pôq a-nga An-ti-ôt. <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />Dyơ ngki, ndóng mu náq te top nha-án, nốh A-ca-but, dŏq ta-yứng, co Yang Ar-vai, án tông a-cớiq idô tớq callong pi-nhaih lư tu-mán ính cơt tớq chuôp cruông cu-teq. Ar-náq ndô khoiq tớq te pang Ca-lôt. <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />Iki la máh top rian, cứp náq te top nha-án, khán nnáu têq bôn ali máh mmo, nha-án khoiq sŏ́ng dyôn práq tar-choi dŏq cơiq dyôn em ai tu-mống tớq Yu-dê, <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />ma nha-án lư khoiq táq a-rớq iki, ndóng dông a-suôi nga ti-cuôi sút nhơ ati na Ba-na-ba nha Sau-lơ.<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />Dyơ, piaiq i-ngái ngki, puô Hê-rôt khoiq táq diêiq a-rức máh ti-cuôi tớq top tin. <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />Ndóng ngki, án ca-chet Ya-cơ, ai na Yon, tớq dau. <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />Iki dyơ, tư hôm ar-lớih ar-náq ndô cơt crái piaiq ada ti-cuôi Isa-ra-el, án lư yua liêh ngai cŏp Phi-er (ma máh ar-náq ngki cơt tớq máh i-ngái na pêl Cha Beng Mi Ớq Bôt Pôih), <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />a-lứng cua dyơ cŏp án, puô khoiq yua crál tớq cŏq, dyôn puan náq líng kiaq án, par-ngíh ính a-ngốh án tớq chứng mát ti-cuôi clứng vít Cha Ayư I-ngái Ngốh. <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />Iki, ntro Phi-er chón ngai crál tớq cŏq, ma callong cớu seq ngki ma át cớu mui mít nhéq tar-ngứh tar-hơ nga Yang Arbang Pilŏ́ng dyôn ada án co top tin. <verse eid="ACT 12:5" /><verse number="6" style="v" sid="ACT 12:6" />Chón ngki, ndóng Hê-rôt ính dông án dŏq tar-sưq, lư i-dáu ngki, Phi-er chón bíq pan-di bar náq líng, ngai chóq tớq bar ntráih sic, ma máh líng kiaq chứng ngáh callống chón kiaq cŏq. <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />Me ntíh, bôn tar-neng na Yang tớq ta-yứng pa án, ang claq ta-bal tớq cŏq tôt. Ndóng ngki, vít dyơ tam-péh tớq a-vếh Phi-er, tar-neng ngki pa-sớt án, tông: “Áu yôr a-chái,” ma ntár sic ta-cáp án tar-lếh te ati. <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />Dyơ, tar-neng ngki tông ada án: “Cóq ca-tớn tar-ving a-lứng dông cơp na mái hơ.” Dyơ ngki, án táq a-rớq ngki. Tar-neng ngki khoiq tông ada án: “Cóq sứp au te tiêh na mái hơ a-lứng veng cư.” <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />Vít ndóng ngốh nga tiêh, án veng tar-neng ngki ma án khoiq lớiq chom a-mớh ar-náq chón ính tớq te tar-neng ngki la lư ma án par-ngíh la chón hôm mui callong a-páh. <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />Tư khoiq pôq vít te líng kiaq mui ntúq nha bar ntúq, nha-án pôq tớq ngai kiaq ngáh callống náq taq tớq nga vel, ma callống ngki chóng tar-pốh dyôn ada nha-án. Vít ndóng ngốh nga tiêh, nha-án pôq na mui car-na a-lứng tar-neng ngki cơt pít te án. <verse eid="ACT 12:10" /><verse number="11" style="v" sid="ACT 12:11" />Ndóng cháq khoiq ayư liêh, Phi-er tông: “Ar-lớih lư, hoi ngki cư mbơiq chom dyơ Yang khoiq yua tar-neng Án a-lứng choi ta-mống cư te ati Hê-rôt, a-lứng cứp nốh ng-cong na ti-cuôi Isa-ra-el.” <verse eid="ACT 12:11" /><verse number="12" style="v" sid="ACT 12:12" />Ma, tư khoiq chom dyơ iki, án pôq nga dúng Ma-ri, a-i na Yon, ngai dŏq la Mac, ma ntúq ndô bôn clứng ti-cuôi tin át rum mu nơi a-lứng át cớu seq. <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />Dyơ ngki, ndóng án a-cóh ngáh callống, mu náq ti-cuôi cán, nốh Rô-da, tớq tar-mán dŏq ôi. <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />Tư ndóng a-cớl cang na Phi-er, co sáng bui, án khoiq lớiq pốh callống, ma ta-lúh nga callúng, án taq-ntêr: “Phi-er chón ta-yứng tớq callống.” <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />Ma, nha-án tông ada cán ngki: “Mái ngki yúh.” Ma án át tông lư ar-lớih ar-náq cơt a-rớq ngki. Iki, nha-án tông: “Ngki la tar-neng na án.” <verse eid="ACT 12:15" /><verse number="16" style="v" sid="ACT 12:16" />Ma, Phi-er át a-cóh, dyơ ndóng pốh ngki, nha-án hôm án a-lứng sáng dut lư. <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />Chón ngki, ndóng khoiq a-vít na ati dyŏq nha-án êq ta-cang, án taq-ntêr na car-na mmo ma Yang khoiq dyôn án ngốh te cŏq. Ma, án pa-táp: “Cóq ntêr liêh máh ar-náq ndô dyôn Ya-cơ nha dyôn máh em ai.” Dyơ ngốh nga tiêh, án pôq nga mui ntúq can-nŏ́h. <verse eid="ACT 12:17" /><verse number="18" style="v" sid="ACT 12:18" />Dyơ ngki, tư khoiq ang, bôn callong par-chớu lớiq két te máh top líng kiaq co ar-náq khoiq cơt ada Phi-er. <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />Ma Hê-rôt, ndóng khoiq pôq ar-vớt suô án ma lớiq tu-múh, tư plốh nhéq máh líng kiaq, án yua ngai ca-chet nha-án. Dyơ vít ndóng ngốh te Yu-dê pôq nga Sê-sa-rê, án át tớq ngki.<verse eid="ACT 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />Ndóng ngki, án yôl uan lư ti-cuôi Ti-rơ nha ti-cuôi Si-dôn. Dyơ ngki, nha-án sŏ́ng pôq ính tu-múh án, a-lứng ndóng khoiq ial mít can-nính Ba-la-tut, la dyưng ati na puô, nha-án ính át ar-toi co cruông nha-án bôn crơng tan-na te cruông na puô. <verse eid="ACT 12:20" /><verse number="21" style="v" sid="ACT 12:21" />Ndóng ngki, tớq i-ngái khoiq a-nát, vít dyơ tớc tam-pớc a-maiq ŏ a-lứng ti-cu tớq ki-chơng, Hê-rôt tông chứng mát nha-án. <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />Dyơ ngki, ti-cuôi clứng tông yứng: “Siêng na ar-vai yang, tới na thư ti-cuôi!” <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />Dyơ ngki táp, bôn tar-neng na Yang táq án ma co án lớiq mŏp callong ang ưr dyôn Yang Arbang Pilŏ́ng, dyơ ndóng bôn bớr cha pallúng, án cu-chet.<verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />Ma par-nai ŏ na Yang Arbang Pilŏ́ng cơt rứh pi-lư nha clứng ti-cuôi tin.<verse eid="ACT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25" />Vít ngki, Ba-na-ba nha Sau-lơ chô liêh nga Yaru-salem, tư khoiq dyơ ar-náq tar-choi na án, dông ca Yon pôq mu nơi, án ngai dŏq la Mac.<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />Chón ngki, tớq máh Top Tin tớq An-ti-ôt, bôn máh ti-cuôi tang ng-cang nha máh thới: Ba-na-ba, Si-mê-ôn, ngai dŏq la Ni-yê, Lu-si-ut ti-cuôi Si-ren; Ma-na-hem, a-em par na puô Hê-rôt, nha Sau-lơ. <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />Ndóng ngki, chón ndóng nha-án sang tám Yang a-lứng ót tan-na, ngki Yang Ar-vai tông: “Cóq dŏq mmar Ba-na-ba nha Sau-lơ ngki ada Cư, co ar-náq ma Cư khoiq arô nha-án.” <verse eid="ACT 13:2" /><verse number="3" style="v" sid="ACT 13:3" />Co iki, vít ndóng ót tan-na, cớu seq a-lứng ca-pơiq ati tớq bar náq ngki, dyơ dyôn nha-án pôq.<verse eid="ACT 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />Iki, cua bôn yua pôq co Yang Ar-vai, bar náq pôq nga Sê-lu-si; a-lứng tớq ngki nha-án pôq na tuôc nga Sip-rơ. <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />Tư khoiq tớq nga Sa-la-mit, nha-án taq-ntêr par-nai ŏ na Yang Arbang Pilŏ́ng tớq máh dúng rum na ti-cuôi Isa-ra-el. Dyơ ngki, nha-án lư bôn Yon a-rớq ti-cuôi choi ar-náq. <verse eid="ACT 13:5" /><verse number="6" style="v" sid="ACT 13:6" />Vít ngki, ndóng pôq ta-nớng díh con ti-ngôi tớq Ba-phô, nha-án tu-múh mu náq ti-cuôi ngki, mu náq ti-cuôi mo, tang ng-cang náh nnan ti-cuôi Isa-ra-el, nốh án la Ba-yê-su, <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />ma ti-cuôi ndô át a-lứng án ndon sút Sê-yut Phau-lut — mu náq ti-cuôi tu-báiq. Tư khoiq yua mơi Ba-na-ba nha Sau-lơ, án sút ngki ti-tuaiq ính cam-máng par-nai ŏ na Yang Arbang Pilŏ́ng. <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />Ma “mo ngki” Ê-li-ma (co nốh án bôn par-long liêh a-rớq iki), chíl liêh nha-án, suô ngê ca-táng ndon sút ngki êq náp peh. <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />Ma Sau-lơ, a-lứng Phau-lô, bôn callong bán kiaq te Yang Ar-vai, ndóng me tiêu-liêu nga án, <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />a-lứng tông: “Ndô la ti-cuôi cứp callong par-lốh a-lứng cứp nốh lớiq ŏ, a-cái na yang sáq, ti-cuôi pi-con na cứp callong ti-nớng ŏ, mái lư lớiq a-ngô táq dyôn rúng car-na ti-nớng lư na Yang? <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />Dyơ ngki, áu me láq, ati na Yang táq ada án dyơ án lư cơt sot, ớq bôn hôm mát pan-dang chom máh mmo dưnh.” Iki, ngki táp, callong ca-dứp cơt ngiau át tớq án, dyơ án pu-pơr pôq suô ti-cuôi tec ati dông án. <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />Ndóng ngki, tư khoiq hôm ar-lớih ar-náq mbơiq tớq, án ndon sút lư tin, co sáng dut lư te par-nai ŏ na Yang. <verse eid="ACT 13:12" /><verse number="13" style="v" sid="ACT 13:13" />Dyơ ngki, ndóng sớr tớq tuôc ngốh te Ba-phô, máh ti-cuôi sŏ́ng a-lứng Phau-lô pôq nga Pêr-ca na Bam-phu-li. Ma co car-lun te nha-án, Yon chô liêh nga Yaru-salem. <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />Ma nha-án, vít dyơ ngốh te vel Pêr-ca, ngki pôq nga An-ti-ôt cruông Bi-si-di, nha ndóng khoiq mot tớq dúng rum tớq i-ngái A-ngô, nha-án ti-cu rum. <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />Cua dyơ ar-náq dŏc u-ráq phep rit a-lứng máh tang ng-cang, máh ti-cuôi sút dúng rum yua mu náq tớq nga nha-án, tông idô: “Em ai ơi, máh i-nha em ai, khán par-nai a-liam mmo dŏq dyôn ti-cuôi clứng át a-lứng i-nha, seq cóq taq-ntêr.” <verse eid="ACT 13:15" /><verse number="16" style="v" sid="ACT 13:16" />Iki dyơ, ndóng yôr ta-yứng nha a-vít ati dyôn chom, Phau-lô tông:</para>
  <para style="p" vid="ACT 13:16">“Em ai ơi, máh ti-cuôi Isa-ra-el a-lứng máh ti-cuôi dyám náp Yang Arbang Pilŏ́ng, seq cam-máng. <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />Yang Arbang Pilŏ́ng na ti-cuôi prái Isa-ra-el ndô khoiq rêh a-chúc a-chiac top he, táq dyôn nha-án cơt rứh tớq ndóng yôl át tớq cu-teq Ê-yip-tô, a-lứng na ati pa-yơ a-yống, Án dông nha-án ngốh te ngki. <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />Bôn ali díh puan chít cu-mo Án át chiuq ta-nhir nha-án tớq ntúq aih. <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />A-lứng vít dyơ pu-pít tu-pul thư ti-cuôi tớq cruông Ca-na-an, Án dyôn cruông na nha-án ada top he ưlla cu-teq ngki, <verse eid="ACT 13:19" /><verse number="20" style="v" sid="ACT 13:20" />bôn ali puan cu-lám sông chít cu-mo. Vít máh ar-náq ngki, Án khoiq dyôn ada nha-án máh ti-cuôi tar-sưq ti-ngôi tớq pang tang ng-cang Sa-mu-el. <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />Tư ndóng ngki chô mát, ti-cuôi clứng seq mu náq puô, dyơ Yang Arbang Pilŏ́ng khoiq dyôn ada nha-án Sau-lơ, a-cái conh na Kích, ma náq te top Bên-ya-min, díh puan chít cu-mo. <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />Dyơ ndóng khoiq táh puô ngki, Án chóh Da-vit loi cơt puô dyôn nha-án, ma ndóng taq-ntêr te ti-cuôi ngki, Án dŏq tông: ‘Cư khoiq tu-múh Da-vit, a-cái conh Yê-sê, mu náq ti-cuôi veng mít Cư, la án lư táq cứp can-nính ính na Cư.’ <verse eid="ACT 13:22" /><verse number="23" style="v" sid="ACT 13:23" />Te tŏ́ng toiq na puô ndô, veng a-rớq par-nai par-ưq, Yang Arbang Pilŏ́ng khoiq dông a-tớq ada Isa-ra-el mu náq Án Choi Ta-mống, la Yang Yê-su, <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />ndóng Yon khoiq ca to nsuôi ngki mui tíc na dơq te callong piên lêq dyôn máh ti-cuôi Isa-ra-el, nsuôi ar-náq ính tớq te Án. <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />Dyơ ngki, ndóng Yon chón ca-tóng táq nhéq ar-náq án, án tông: ‘I-nha par-ngíh cư la nnáu? Tới la cư a-mớh. Ma, cóq me, Án chón tớq ta-tun cư, la Án ndon cư lớiq crái díh lếh cơp te dyưng Án.’<verse eid="ACT 13:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="ACT 13:26" />Em ai ơi, ngki i-nha, la a-cái a-cháu te tŏ́ng toiq A-pra-ham a-lứng máh ti-cuôi dyám náp Yang Arbang Pilŏ́ng tớq top i-nha, par-nai na callong choi ta-mống ndô khoiq dŏq cơiq dyôn ada top he. <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />Co máh ti-cuôi tu-mống tớq Yaru-salem a-lứng máh ti-cuôi sút na nha-án lớiq chom a-cớl Án ngki, iki nha-án khoiq táq tar-vớiq máh par-nai na máh ti-cuôi tang ng-cang át bôn dŏc cứp i-ngái A-ngô, ndóng tông luaih Án. <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />Ntro ớq bôn tu-múh mui callong luaih mmo têq ca-chet, ma nha-án khoiq yua Phi-lat táq dyôn Án cóq cu-chet. <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />Dyơ ngki, ndóng nha-án khoiq táq cua cứp ar-náq bôn ta-ran te Án, vít dyơ ta-líh a-siar te a-long calláng, nha-án dŏq Án tớq mui láng ping. <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />Ma Yang Arbang Pilŏ́ng khoiq dyôn Án tu-mống liêh te cu-chet, <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />ma Án khoiq bôn hôm tớq a-ưi i-ngái co máh ti-cuôi pôq mu nơi a-lứng Án te Ca-li-lê díh Yaru-salem, máh ti-cuôi ngki hoi ndô la taq-ntêr te Án ada ti-cuôi clứng. <verse eid="ACT 13:31" /><verse number="32" style="v" sid="ACT 13:32" />Top he chón pau tông Par-nai ŏ Yang dyôn i-nha, la par-nai par-ưq khoiq tớq ada a-chúc a-chiac na top he, <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />i-mo Yang Arbang Pilŏ́ng khoiq táq cua nhéq ar-náq ngki dyôn máh a-cái a-cháu na top he, ndóng dyôn Yang Yê-su tu-mống liêh. Mu chứng a-rớq par-nai khoiq dŏq ta-ran tớq Cứh Ayô phê bar:</para>
  <para style="q1" vid="ACT 13:33">‘Mái la A-cái Cư, i-ngái ndô Cư khoiq ca-nian Mái.’<verse eid="ACT 13:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 13:34" />A-lứng, co te Án khoiq dyôn Yang Yê-su tu-mống liêh te cu-chet, lư lớiq bôn píh liêh nga callong cu-chet nnáng, iki Án tông idô:</para>
  <para style="q1" vid="ACT 13:34">‘Cư lư dyôn ada A-cái ngki callong bún na Da-vit, máh callong bún lư ar-lớih.’<verse eid="ACT 13:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="ACT 13:35" />Lư co iki, Án tông tớq u-ráq Cứh Ayô can-nŏ́h:</para>
  <para style="q1" vid="ACT 13:35">‘Án lư lớiq dyôn ada A-cái Práh ŏ Án bôn hôm callong cơt a-buôiq.’<verse eid="ACT 13:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="ACT 13:36" />Bôn par-nai, ada Da-vit tớq pang na án táp, vít ndóng táq ar-náq veng par-ngíh na Yang Arbang Pilŏ́ng, án khoiq cu-chet, bôn tứp mu nơi a-lứng a-chúc a-chiac án, nha khoiq hôm callong cơt a-buôiq. <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />Ma Án ndon Yang Arbang Pilŏ́ng khoiq dyôn tu-mống liêh ngki ớq hôm callong cơt a-buôiq.<verse eid="ACT 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 13:38" />Iki, ơi i-nha, máh em ai, callong ndô cóq la chom ar-lớih ada i-nha, co nhơ Yê-su ngki, callong ta-láh luaih lới bôn taq-ntêr dyôn i-nha a-lứng vít cứp ar-náq ndon co nha-án, i-nha khoiq lớiq rap bôn ngê ti-nớng ŏ veng phep rit Môi-se. <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />Te Án ngki, cứp ti-cuôi tin ngki lư cơt ti-nớng ŏ. <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />Iki, cóq me a-ŏ, dáh lơ callong khoiq dŏq tông tớq u-ráq tang ng-cang têq tớq nga i-nha:<verse eid="ACT 13:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41" />‘Máh ti-cuôi báq ayê tar-ac ntíh, áu cóq me, dyơ sáng crŏ́q a-lứng cơt cu-chet viang!</para>
  <para style="q1" vid="ACT 13:41">Co Cư chón táq mui ar-náq tớq pang top i-nha,</para>
  <para style="q1" vid="ACT 13:41">mui ar-náq ndon top i-nha ar-lớih lư lớiq tin, ntro ti-cuôi mmo taq-ntêr ada top i-nha.’”<verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />Dyơ ngki, chón ndóng bar náq ngốh pôq, ti-cuôi clứng át seq dŏq bôn ca to dyôn nha-án máh par-nai ngki tớq i-ngái A-ngô ta-tun loi. <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />Ndóng ngki, tư ar-náq rum vít dyơ, clứng ti-cuôi Isa-ra-el a-lứng máh ti-cuôi sang tám veng ti-cuôi Isa-ra-el khoiq tar-veng Phau-lô nha Ba-na-ba, ndóng bar náq taq-ntêr a-lứng nha-án, ngki pa-táp nha-án náp níc tớq callong choi mat na Yang Arbang Pilŏ́ng.<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />Dyơ, tớq i-ngái A-ngô ngki loi, tar-mán nhéq díh vel par-chúng liêh ính cam-máng par-nai ŏ na Yang. <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />Ma tư bôn hôm clứng ti-cuôi, máh ti-cuôi Isa-ra-el bôn máng callong a-ính, nha chíl liêh máh par-nai bôn ntêr te Phau-lô, na car-na pa-mat án. <verse eid="ACT 13:45" /><verse number="46" style="v" sid="ACT 13:46" />Ôi liêh cơt clŏ́q lư, díh Phau-lô nha Ba-na-ba khoiq tông: “Callong tar-náp la par-nai na Yang Arbang Pilŏ́ng cóq bôn ca to dyôn top i-nha nsuôi lư. Co chom ar-lớih top i-nha ca-lôih te par-nai ndô a-lứng chóng par-ngíh bôm lớiq crái piaiq te callong tu-mống díh sút pang, i-nha me liêh, he pôq ca to nga ti-cuôi tới ti-cuôi Isa-ra-el. <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />Co Yang khoiq yua ada top he idô:</para>
  <para style="q1" vid="ACT 13:47">‘Cư khoiq chóh a-cái a-rớq callong ang dyôn top ti-cuôi tới Isa-ra-el,</para>
  <para style="q1" vid="ACT 13:47">a-cái tu-mống dyôn callong choi ta-mống díh tớq ntúq cloiq cúc cu-teq.’”<verse eid="ACT 13:47" /></para>
  <para style="m">
    <verse number="48" style="v" sid="ACT 13:48" />Dyơ, tư sáng iki, máh ti-cuôi tới Isa-ra-el bui hơr nha cứh ayô par-nai ŏ na Yang, a-lứng nhéq máh ti-cuôi khoiq bôn rêh dyôn callong tu-mống díh sút pang ngki lư tin. <verse eid="ACT 13:48" /><verse number="49" style="v" sid="ACT 13:49" />Iki dyơ, par-nai ŏ na Yang cơt par-hanh chuôp díh cruông. <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />Ma ti-cuôi Isa-ra-el chuôq rúc ngai ng-cán náp par-nai ŏ Yang bôn em ai a-lứng máh ti-cuôi sút tớq vel, dyơ bôn callong ính táq tớq chíl liêh Phau-lô nha Ba-na-ba, nha-án chuih nha-án bar náq ngki ngốh te cruông cu-teq na nha-án. <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />Dyơ ngki, vít ndóng tang-khír mbúi te dyưng dŏq ca-lôih nha-án, nha-án bar pôq nga Icô-ni. <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />Ma máh ti-cuôi tin bôn máng callong bui hơr te Yang Ar-vai.<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />Chón ngki, ar-náq khoiq cơt tớq Icô-ni ngki la a-lứng tar-tuôq nha-án pôq tớq dúng rum na ti-cuôi Isa-ra-el nha ca to mu chứng a-rớq ngki tar-lúh lư clứng ti-cuôi, díh ti-cuôi Isa-ra-el nha ti-cuôi Créc, khoiq tin. <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />Ma máh ti-cuôi Isa-ra-el lớiq tin khoiq chuôq rúc a-lứng táq dyôn par-ngíh máh ti-cuôi tới Isa-ra-el sáng uan chíl liêh top i-nha. <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />Co iki, nha-án át liêh tớq ngki tháng lư dưnh, ca to clŏ́q lư te Yang, la Án a-páh dyôn par-nai ŏ te callong choi mat Án na táq dyôn máh tíc laq a-lứng ar-náq si-leh tớq na ati nha-án. <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />Ma ti-cuôi tớq vel cơt car-yáh, a-lứng bôn án ngki veng ti-cuôi Isa-ra-el, bôn án ngki veng top dyưng ati. <verse eid="ACT 14:4" /><verse number="5" style="v" sid="ACT 14:5" />Ma, tư ndóng tang-húng ính táq te díh máh ti-cuôi tới Isa-ra-el nha ti-cuôi Isa-ra-el, a-lứng máh ti-cuôi sút na nha-án, sŏ́ng mu nơi táq lớiq ŏ a-lứng tíq búl nha-án, <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />tư ndóng chom par-nai ngki, nha-án lúh viang a-nga máh vel Li-cau-ni, Lu-tra, Der-bơ, nha cruông pa-niar ngki, <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />dyơ át ngki, nha-án pau ntêr níc Par-nai ŏ Yang.<verse eid="ACT 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />Tớq Lu-tra, mu náq ti-cuôi dyuat ngki át ti-cu, ma bar pa dyưng cơt dyuat te ndóng yôl tớq pallúng a-i án, ma án lớiq têq pu-pôq. <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />Án ngki sáng Phau-lô ca to, ma Phau-lô ndóng me tiêu-liêu nga án ngki hôm ar-lớih án bôn callong tin dŏq bôn pa-lai bánh. <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />Án tông yứng lư cang: “Áu ta-yứng ti-nớng tứng tớq dyưng na mái,” dyơ mái a-yưn can-chơl nha ti-caq pôq. <verse eid="ACT 14:10" /><verse number="11" style="v" sid="ACT 14:11" />Ma, tư ti-cuôi clứng bôn hôm ar-náq ma Phau-lô khoiq táq, nha-án ta-bớq tông táp, tông tớq cang Li-cau-ni na nha-án: “Máh yang, ial manh ar-maiq ti-cuôi, khoiq siar nga top he.” <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />Nha-án cơi dŏq Ba-na-ba la “yang Yu-bi-tơ,” ma Phau-lô la “yang Hơ-met,” co án la ti-cuôi ng-hiêl ng-cang. <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />Ndóng ngki, thới teng rit sang na yang Yu-bi-tơ, la pôq át tớq par-ngốh vel, vít ndóng dông car-rŏ́q nha piêr a-long tớq ngáh callống, án ính mŏp sang a-lứng máh ti-cuôi clứng. <verse eid="ACT 14:13" /><verse number="14" style="v" sid="ACT 14:14" />Ma tư sáng iki, top dyưng ati, Ba-na-ba nha Phau-lô, vít dyơ khoiq haq au bôm, nha-án pa-lóng táp nga ti-cuôi clứng, hiar yứng <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />a-lứng tông: “Em ai ơi, i-mo i-nha táq máh ar-náq ndô? Top he a-rớq la máh ti-cuôi mu chứng a-rớq i-nha tưi, chón pau ntêr Par-nai ŏ Yang dyôn i-nha, dŏq ta-viar i-nha te máh ar-náq lớiq tar-náp ndô ma píh nga Yang Arbang Pilŏ́ng tu-mống níc, Án teng pilŏ́ng, cu-teq a-lứng dơq ving ca-vang, nha cứp nốh tớq ngki, <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />la Án ma tớq máh pang nsuôi, khoiq dŏq dyôn nhéq máh ti-cuôi pôq mmar car-na te nha-án, <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />ma ntro iki, Án khoiq lớiq dŏq dyôn ớq a-mớh te Án táp, ndóng tốq callong bún dyôn i-nha, na dyôn bo te pilŏ́ng a-lứng tar-nóh tar-pet cơt ŏ, dyôn mít i-nha sái ŏ te crơng tan-na a-lứng bui hơr.” <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />Nha ndóng khoiq tông máh ar-náq ndô, nha-án nưm rap dyŏq ti-cuôi clứng êq tức nnáng ada nha-án.<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />Ma, máh ti-cuôi Isa-ra-el khoiq tớq te An-ti-ôt nha Icô-ni, vít ndóng par-yông ti-cuôi prái dyơ tíq búl ada Phau-lô, nha-án a-ngốh án nga tiêh vel, co par-ngíh án khoiq cu-chet. <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />Ma, tư máh ti-cuôi ndon rian át pa-niar án, ngki vít dyơ yôr ta-yứng, án mot tớq vel, dyơ i-ngái ta-tun, án pôq a-lứng Ba-na-ba nga Der-bơ. <verse eid="ACT 14:20" /><verse number="21" style="v" sid="ACT 14:21" />Ma, ndóng khoiq pau tông Par-nai ŏ Yang tớq vel ngki a-lứng bôn clứng ti-cuôi tin, nha-án píh chô nga Li-tra, dyơ díh Icô-ni, nha An-ti-ôt, <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />át táq dyôn khớm mít máh ti-cuôi tin, a-liam nha-án a-khớm tớq callong tin, idô: “Cóq tu-múh a-ưi nốh diêiq a-rức la callong tar-náp dyôn top he bôn mot tớq cruông na Yang Arbang Pilŏ́ng.” <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />Dyơ ngki, cua dyơ rêh máh ti-cuôi sút dyôn nha-án tớq cứp Top Tin, ndóng khoiq cớu seq a-lứng te ar-náq ót tan-na, nha-án bar mŏp máh ti-cuôi ngki dyôn Yang, la Án ndon nha-án khoiq át ng-cong tớq. <verse eid="ACT 14:23" /><verse number="24" style="v" sid="ACT 14:24" />A-lứng ndóng ti-lớt na Bi-si-di, nha-án pôq nga Bam-phu-li. <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />Ndóng ca to par-nai ŏ tớq Pêr-ca dyơ, nha-án pôq nga At-ta-li. <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />Te ntúq ngki, nha-án pôq na tuôq nga An-ti-ôt, la ntúq nha-án khoiq mŏp dyôn te callong choi mat na Yang Arbang Pilŏ́ng ada ar-náq ma nha-án khoiq táq dyơ. <verse eid="ACT 14:26" /><verse number="27" style="v" sid="ACT 14:27" />Dyơ ngki, ndóng khoiq tớq nnơi a-lứng par-chúng Top Tin liêh, nha-án taq-ntêr te callong Yang Arbang Pilŏ́ng khoiq táq dyôn ada nha-án a-lứng i-mo Án khoiq pốh car-na callong tin dyôn ti-cuôi tới Isa-ra-el. <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />Vít ngki, nha-án át liêh a-lứng máh top rian dưnh i-ngái lớiq mu hoi.<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />Dyơ, bôn máh ti-cuôi ntíh tớq te Yu-dê, ca to top i-nha idô: “Khán i-nha lớiq táq rit kít veng phep rit na Môi-se, i-nha ớq bôn choi ta-mống.” <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />Iki, tư ar-náq khoiq cơt lớiq tár sŏ́ng a-lứng tar-miên lớiq két te Phau-lô nha Ba-na-ba a-lứng máh em ai ntíh, top nha-án yua Phau-lô nha Ba-na-ba a-lứng máh ti-cuôi can-nŏ́h te top nha-án pôq tar-múh top dyưng ati a-lứng ti-cuôi sút tớq Yaru-salem te ar-náq ndô. <verse eid="ACT 15:2" /><verse number="3" style="v" sid="ACT 15:3" />Iki, máh ti-cuôi bôn top tin yua pôq ti-lớt díh Phê-na-si nha Sa-ma-ri, taq-ntêr te callong píh liêh na máh ti-cuôi tới Isa-ra-el, dyơ nha-án khoiq bôn bui hơr lư ada nhéq náq top i-nha. <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />Dyơ ngki, ndóng khoiq tớq nga Yaru-salem, nha-án bôn car-bánh car-suanh te top tin, top dyưng ati nha máh ti-cuôi sút, ngki nha-án taq-ntêr te máh ar-náq ma Yang Arbang Pilŏ́ng khoiq dŏq táq ada nha-án. <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />Ma máh ti-cuôi khoiq tin ngki te top Pha-ra-si ta-yứng, tông idô: “Cóq táq rit kít dyôn máh ti-cuôi ngki a-lứng ca to nha-án cóq táq veng phep rit Môi-se.” <verse eid="ACT 15:5" /><verse number="6" style="v" sid="ACT 15:6" />Iki, top dyưng ati a-lứng máh ti-cuôi sút par-chúng liêh dŏq me liêh te ar-náq ndô. <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />Dyơ ngki, ndóng a-ưi callong par-chớu cơt tớq, Phi-er, ta-yứng, tông ada nha-án:</para>
  <para style="p" vid="ACT 15:7">“Ơi máh top, ơi em ai, i-nha khoiq chom dyơ te máh i-ngái nsuôi tớq top i-nha, Yang Arbang Pilŏ́ng khoiq rêh máh ti-cuôi tới Isa-ra-el tớq na ng-cang cư dŏq cam-máng par-nai Ŏ Yang a-lứng tin. <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />Yang Arbang Pilŏ́ng, Án chom mít can-nính, khoiq a-páh ada nha-án, ndóng dyôn Yang Ar-vai ada nha-án, lư a-rớq dyôn top he; <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />nha Án lớiq beng liaih te top he a-lứng nha-án, ndóng dyôn mít can-nính nha-án cơt práh ŏ co callong tin. <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />Khán iki i-mo hoi ngki i-nha thứq Yang Arbang Pilŏ́ng, ndóng pa-tot tớq ti-cong máh top rian phep rit ma top a-chúc a-chiac top he lớiq têq, a-lứng top he lư lớiq rap dŏq táq veng? <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />Ma, top he náp dŏq bôn choi ta-mống te callong choi mat na Yang Yê-su, ma nha-án lư veng mu chứng a-rớq ngki.”<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />Dyơ ngki, díh nhéq tưh át ar-ngiac a-lứng cam-máng Ba-na-ba nha Phau-lô roih liêh a-ưi lư tíc a-lứng ar-náq si-leh Yang Arbang Pilŏ́ng khoiq táq tớq top ti-cuôi tới Isa-ra-el te nha-án. <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />Iki, ndóng nha-án tông dyơ, Ya-cơ loi tông, idô:</para>
  <para style="p" vid="ACT 15:13">“Ơi nhéq náq, ơi máh i-nha, seq cam-máng cư. <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />Si-môn khoiq taq-ntêr ar-náq te Yang Arbang Pilŏ́ng nsuôi lư khoiq rêh dŏq ial te máh ti-cuôi tới Isa-ra-el cơt ti-cuôi ưlla na Án. <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />Ar-náq ndô cơt tar-vớiq a-lớng máh par-nai te ti-cuôi tang ng-cang a-rớq khoiq dŏq ta-ran:<verse eid="ACT 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16" />‘Vít máh ar-náq ngki, Cư lư tớq liêh,</para>
  <para style="q1" vid="ACT 15:16">dyơ Cư lư páng cra liêh dúng na Da-vit, la dúng khoiq dŏq ar-lóh,</para>
  <para style="q1" vid="ACT 15:16">Cư páng cra liêh máh nốh ndon ar-lóh na án a-lứng táq liêh dúng ngki,<verse eid="ACT 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17" />dyôn cơt phê yôl liêh te thư ti-cuôi lư têq si-suô Yang,</para>
  <para style="q1" vid="ACT 15:17">ngki díh nhéq máh ti-cuôi tới Isa-ra-el, ma tớq máh ti-cuôi ngki, nốh Cư bôn arô cớu tớq te nha-án.</para>
  <para style="q1" vid="ACT 15:17">Yang tông iki, ndóng táq máh ar-náq ndô, <verse eid="ACT 15:17" /><verse number="18" style="v" sid="ACT 15:18" />la ar-náq khoiq chom tớq te pang i-nớh.’<verse eid="ACT 15:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="ACT 15:19" />Co iki, cư tông êq táq diêiq a-rức dyôn máh ti-cuôi te top ti-cuôi tới Isa-ra-el píh liêh nga Yang Arbang Pilŏ́ng. <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />Ma, cóq ta-ran chớiq ca-tớih tông nha-án viar yông callong a-íh crơng na ngai tức, callong láh par-lưi, sáiq a-chếq crơng cu-chet ngai éc a-lứng a-ham. <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />Co te máh pang i-nớh, tớq cứp vel, phep rit Môi-se ma yôl bôn a-ưi ti-cuôi ca to rit ngki, nhơ bôn dŏc tớq dúng rum cứp i-ngái A-ngô.”<verse eid="ACT 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />Vít ngki, top dyưng ati nha ti-cuôi sút, a-lứng díh top tin, sŏ́ng ính yua máh ti-cuôi khoiq rêh te top nha-án pôq nga An-ti-ôt mu nơi a-lớng Phau-lô nha Ba-na-ba — Yu-da ngai dŏq la Ba-sa-ba, a-lứng Si-la, máh ti-cuôi sút tớq top i-nha — <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />ndóng ta-ran chớiq pôq cơiq na ati nha-án: “Top dyưng ati a-lứng máh ti-cuôi sút, top i-nha, cơiq dyôn máh ti-cuôi tin chuôp cruông An-ti-ôt, Si-ri nha Si-la-si, dyôn ada i-nha, máh ti-cuôi tớq te ti-cuôi tới Isa-ra-el. Seq car-bánh car-suanh! <verse eid="ACT 15:23" /><verse number="24" style="v" sid="ACT 15:24" />Co ndóng ndô, top he khoiq sáng idô bôn ti-cuôi ngki ndóng ngốh te top he khoiq pi-diêiq i-nha na máh par-nai táq tam-bang mít i-nha, ma máh ti-cuôi ngki top he lớiq yua táq iki, <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />ar-náq ndon ŏ lư dyôn top he la vít dyơ sŏ́ng mui mít, rêh nsếq náq, ngki yua nha-án pôq nga i-nha a-lứng Ba-na-ba nha Phau-lô, bar náq nha-án par-láng lư ada top he, <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />nha-án bar náq khoiq chiuq pít tar-ngứh bôm co nốh Yang top he, Yang Choi Ta-mống Yê-su. <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />Co iki, top he khoiq yua Yu-da nha Si-la, nha-án lư lái liêh ar-náq ndô na par-nai ntêr. <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />Co chom ar-lớih Yang Ar-vai a-lứng top he khoiq hôm lớiq bôn a-ưi callong a-mớh dŏq táq diêiq a-rức tớq i-nha ma nưm máh callong tar-náp ta-tun ndô: <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />cóq viar yông máh nốh ngai tức dyôn mol rup, a-ham, pan-nán cu-chet ngai éc, nha láh par-lưi, i-nha lư táq ŏ, ndóng kiaq cháq i-nha vít máh callong ngki. Seq dyôn i-nha bôn iên ŏ.”<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />Iki, ndóng khoiq yua pôq, nha-án siar nga An-ti-ôt, nha ndóng par-chúng top tin liêh dyơ, nha-án a-vôi ar-láq chớiq ngki. <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />Chón ngki, tư dŏc chớiq dyơ, máh top tin sáng bui hơr co callong a-liam ngki. <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />Díh Yu-da nha Si-la, lư nha-án ngki la máh tang ng-cang, khoiq a-liam top i-nha na par-nai ŏ toiq a-lứng dyôn nha-án khớm khit. <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />Chón ngki, ndóng át tớq ngki dưnh i-ngái, nha-án bôn máh em ai pôq a-suôi a-lứng máh ti-cuôi ndon yua nha-án bôn iên ŏ. <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />[Ma Si-la yôl par-ngíh cóq át liêh a-lớng nha-án, iki Yu-da khoiq pôq nưm mu náq án.] <verse eid="ACT 15:34" /><verse number="35" style="v" sid="ACT 15:35" />Ma Phau-lô nha Ba-na-ba át liêh tớq An-ti-ôt, ca to a-lứng taq-ntêr par-nai Yang, ada clứng ti-cuôi can-nŏ́h.<verse eid="ACT 15:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />Vít ngki, bôn nsếq i-ngái lớiq dưnh, Phau-lô tông ada Ba-na-ba: “Lư, top he cóq pôq a-lang máh máh em ai, ndóng píh liêh tớq cứp vel ma tớq ngki, top he khoiq ca to par-nai Yang, nha-án cơt i-mo.” <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />Ma Ba-na-ba ngki ính dông Yon, ngai dŏq la Mac, pôq tưi. <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />Ma Phau-lô par-ngíh lớiq ính dông Mac pôq tưi, co án khoiq par-táh te nha-án náp te Bam-phu-li a-lứng lớiq sŏ́ng nnáng a-lớng nha-án dŏq táq ar-náq. <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />Dyơ ngki, bôn callong tar-miên pưt cơt tớq, tar-lúh nha-án cơt par-táh a-lứng tar-tuôq, ma Ba-na-ba dông Mac veng án pôq na tuôc nga Sip-rơ. <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />Ma Phau-lô, ndóng khoiq rêh Si-la, ngki pôq, vít dyơ bôn máh em ai mŏp dyôn callong choi mat te Yang. <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />Iki dyơ, án pôq chuôp Si-ri nha Si-la-si, táq dyôn khớm máh top tin.<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />Ndóng ki, án lư pôq nga Der-bơ dyơ tớq Lu-tra, a-lứng me ntíh, tớq ngki bôn mu náq ndon rian la nốh Ti-mu-thê, a-cái conh na mu náq cán ti-cuôi Isa-ra-el dyám náp, ma a-ám la ti-cuôi Créc, <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />ma án bôn ayô ŏ te máh em ai tớq Lu-tra nha Icô-ni. <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />Phau-lô ính Ti-mu-thê pôq a-lứng án, iki ndóng ráp án, Phau-lô táq rit kít ada án, co tar-náp na ti-cuôi Isa-ra-el chón át tớq máh ntúq ngki, co nha-án lư chom ar-lớih a-ám na án la ti-cuôi Créc. <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />Dyơ ngki, tư nha-án pôq na máh vel, nha-án taq-ntêr liêh dyôn top tin cóq chom máh callong khoiq a-nát te top dyưng ati a-lứng máh ti-cuôi sút tớq Yaru-salem. <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />Iki, máh top tin bôn khớm lư tớq callong tin a-lứng cứp i-ngái cơt a-ưi pi-lư ti-cuôi tin.<verse eid="ACT 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />Ndóng ngki, nha-án pôq cláh na cruông na Phu-ra-yiê nha Ca-la-ti, co khoiq Yang Ar-vai lớiq dyôn ca to par-nai ŏ Yang tớq cruông A-siê. <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />Vít ngki, ndóng khoiq tớq tu-mán Mi-si-a, nha-án pa-tot pôq nga Bi-thi-ni, ma Yang Ar-vai te Yang Yê-su ngki lớiq dyôn nha-án. <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />Iki, pôq ti-lớt Mi-si-a, nha-án pôq a-nga Trô-at. <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />Mui callong a-páh tớq ada Phau-lô tớq i-dáu: bôn ti-cuôi Ma-sa-dôn ngki chón ta-yứng dyơ arô án, idô: “Vít ndóng pôq cláh na Ma-sa-dôn, seq tar-choi top he.” <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />Iki, ndóng án khoiq hôm callong a-páh ngki, top he ngki táp suô car-na pôq nga Ma-sa-dôn, co chom ar-lớih dyơ Yang Arbang Pilŏ́ng khoiq arô top he pau ntêr Par-nai ŏ Yang dyôn nha-án.<verse eid="ACT 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />Co iki, ndóng pôq na tuôc te Trô-at, top he pôq ti-nớng nga Sa-mô-tra-sơ, dyơ i-ngái ta-tun tớq Nê-a-bô-li, <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />te ngki, pôq nga Phi-lip, ma ndô la vel pưt tar-náp lư tớq cruông Ma-sa-dôn, mui vel na ti-cuôi Rô-ma, dyơ top he ngki át tớq vel pưt ndô nsếq i-ngái. <verse eid="ACT 16:12" /><verse number="13" style="v" sid="ACT 16:13" />Ma, tớq i-ngái A-ngô, top he ngốh pa tiêh par-ngốh vel, tar-mán dơq soq, ntúq ma top he a-ngô la ntúq cớu seq. Dyơ tư ti-cu, top he taq-ntêr a-lứng máh ti-cuôi cán át rum mu nơi tớq ngki. <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />Mu náq cán ngki nốh Li-diê, án táiq prới ntứm te vel Thi-a-ti-rơ, co bôn mít dyám náp Yang Arbang Pilŏ́ng, chón át cam-máng, la án ndon Yang khoiq pốh mít dŏq mmứng máh nốh chón bôn tông co Phau-lô. <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />Dyơ, ndóng án ráp tíc na dơq a-lứng díh dúng án, án tar-seq te top he, idô: “Khán top i-nha hôm cư la ti-nớng ada Yang, ngki seq cóq át liêh, mot tớq dúng cư.” Án pa-tot top he. <verse eid="ACT 16:15" /><verse number="16" style="v" sid="ACT 16:16" />Vít ngki, ar-náq khoiq cơt ndóng top he chón pôq nga ntúq cớu seq, mu náq cán ndon sol ngki bôn yang sáq Phô-tôn pi-yúh, tar-múh top he, ma án yôl táq tar-náp lư a-ưi ada ưlla án na mám mưl. <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />Ndóng veng ta-pun Phau-lô a-lứng top he, án hiar yứng idô: “Máh ti-cuôi ndô la ti-cuôi sol na Yang Arbang Pilŏ́ng Sút Pưt, ma nha-án chón pau ntêr dyôn top i-nha car-na choi ta-mống.” <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />Ndóng ngki, án táq iki khoiq a-ưi i-ngái. Ma co sáng pi-ŏ́q lư, iki ndóng píh liêh nga yang saq ngki, Phau-lô tông: “Nhơ nốh Yang Choi Ta-mống Yê-su, cư yua mái ngốh táp te cán ndô.” Dyơ yang sáq ngốh chón ndóng ngki.<verse eid="ACT 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19" />Ma tư máh ti-cuôi ưlla na án hôm ar-lớih ar-náq mán mưl na án khoiq pít, ngki dyơ ndóng cŏp Phau-lô nha Si-la, nha-án dông bar náq nga vel pưt tớq ntúq máh ti-cuôi chức sút. <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />Ndóng dông bar náq ngki tớq nga ti-cuôi sút dyơ, nha-án tông: “Máh ti-cuôi ndô par-yông ti-cuôi vel pưt top he, co la ti-cuôi Isa-ra-el, <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />iki nha-án chón ca to máh phep rit ndon lớiq bôn phep rit dyôn top he ráp ial a-láng táq veng, co la ti-cuôi Rô-ma.” <verse eid="ACT 16:21" /><verse number="22" style="v" sid="ACT 16:22" />Dyơ ti-cuôi clứng ngki car-tóng chíl liêh nha-án bar, iki ndóng yua haq au nha-án ngki, top ti-cuôi sút yua líng tính nha-án tớq par-núh. <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />Ma, ndóng khoiq púh tính nha-án bar a-ưi dyơ, top líng crál nha-án tớq cŏq, pa-táp ada án sút cŏq tôt kiaq me nha-án ada car-siat, <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />ma ti-cuôi sút ngki, ndóng án ráp par-nai ngki, khoiq crál nha-án tớq cŏq callúng, a-lứng ta-cáp dyưng nha-án tớq a-núh. <verse eid="ACT 16:24" /><verse number="25" style="v" sid="ACT 16:25" />Ma, tớq tar-di i-dáu, chón ndóng cớu seq, Phau-lô nha Si-la cứh u-ráq cứh ayô Yang Arbang Pilŏ́ng, ma máh ti-cuôi tôt can-nŏ́h ngki cam-máng nha-án. <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />Dyơ ngki, cơt ca-cưt cu-teq hớp lư ti-cớr tớq, tar-lúh máh ng-cưm dúng cŏq ngki ca-cưt, dyơ nhéq ngáh callống ngki táp bôn tar-pốh, a-lứng ntár sic ta-cáp cứp náq cơt tar-caq. <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />Ma ndóng ti-cuôi sút cŏq tôt khoiq ayư te bíq, bôn hôm máh ngáh cŏq tôt khoiq nhéq tar-pốh, dyơ ruôh dau án ngki, án ính dyáq co par-ngíh máh ti-cuôi tôt khoiq tar-cláh. <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />Ma Phau-lô tông yứng cang, idô: “Êq táq a-ái bôm, co nhéq náq top he yôl át tớq ndô.” <verse eid="ACT 16:28" /><verse number="29" style="v" sid="ACT 16:29" />Iki, ndóng yua ial a-rớm, án ta-lúh chái nga callúng, a-lứng co sáng crŏ́q lư, án mpŏp chứng mát Phau-lô nha Si-la, <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />dyơ ndóng a-ngốh nha-án nga tiêh, án plốh: “Ơi top i-nha, callong a-mớh te cư pa-tot cóq táq, dyôn cư têq bôn tu-mống?” <verse eid="ACT 16:30" /><verse number="31" style="v" sid="ACT 16:31" />Iki, nha-án ôi: “Cóq tin nga Yang Yê-su, ngki mái lư bôn tu-mống — mái a-lứng ti-cuôi mu dúng na mái.” <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />Dyơ nha-án ca to par-nai Yang ada án a-lứng nhéq náq máh ti-cuôi tớq dúng án. <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />A-lứng tớq tu-pứng ngki chón tar-di i-dáu, ndóng dông nha-án pôq a-lứng án, án a-rau práh dyôn nha-án te máh ntúq bác, dyơ án chái ráp tíc na dơq — án a-lứng nhéq náq dúng án. <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />Ma, ndóng khoiq dông nha-án mot tớq dúng án, án a-ngốh tan-na ngki nsuôi nha-án a-lứng sáng bui hơr lư a-lứng máh ti-cuôi tớq dúng, co khoiq bôn tin ráp Yang Arbang Pilŏ́ng.<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />Chón ngki, díh ang i-láih, máh ti-cuôi sút yua máh tam-peng pôq, tông idô: “Cóq ta-láh máh ti-cuôi ngki táp.” <verse eid="ACT 16:35" /><verse number="36" style="v" sid="ACT 16:36" />Iki, án sút cŏq tôt ntêr liêh máh par-nai ngki ada Phau-lô, idô: “Top ti-cuôi sút khoiq yua cư tông idô top i-nha bôn ta-láh dyơ. Iki hoi ndô, ndóng ngốh ngki, dyôn bar náq i-nha pôq iên ŏ.” <verse eid="ACT 16:36" /><verse number="37" style="v" sid="ACT 16:37" />Ma Phau-lô tông ada nha-án: “Cua dyơ ntêr púh tính top he, la máh ti-cuôi tớq te ti-cuôi Rô-ma, ma lớiq tar-sưq, nha-án khoiq crál top he tớq cŏq, dyơ hoi ndô nha-án ca-tốq ính ta-láh top he ngốh? Lư lớiq têq! Ma cóq, nha-án táp, ndóng tớq tu-dô, cóq dông top he ngốh.” <verse eid="ACT 16:37" /><verse number="38" style="v" sid="ACT 16:38" />Iki, tam-peng ngki ntêr liêh máh par-nai ngki ada ti-cuôi sút, dyơ top nha-án sáng a-dáh tư sáng iki nha-án bar la ti-cuôi Rô-ma. <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />Ndóng tớq dyơ, máh ti-cuôi sút seq luaih nha-án a-lứng vít ndóng a-ngốh nga tiêh, máh ti-cuôi sút seq nha-án pôq yông te vel nha-án. <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />Iki, tư khoiq ngốh te cŏq, nha-án bar mot tớq dúng na Li-diê. Nha ndóng tar-múh máh em ai, nha-án bar a-liam nha-án, dyơ ti-yốq pôq.<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />Dyơ ngki, ndóng pôq ti-lớt vel Am-phi-bô-lit nha A-bô-lô-ni, nha-án pôq díh Tê-salô-ni-ca, ntúq bôn mui dúng rum na ti-cuôi Isa-ra-el. <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />Dyơ báq cơi na Phau-lô, án mot rum a-lớng nha-án, dyơ tớq pe i-ngái A-ngô, án ca to ada nha-án te Tám U-ráq Yang, <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />ndóng par-long cứp nha dyôn chom ar-lớih Yang Choi Ta-mống cóq chiuq diêiq a-rức a-lứng tu-mống liêh te cu-chet idô: “Yang Yê-su ndô, Án ndon cư ntêr ada i-nha, lư la Yang Choi Ta-mống.” <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />Bôn ti-cuôi te top nha-án têq náp a-lứng tar-veng Phau-lô nha Si-la, bôn clứng máh ti-cuôi Créc dyám náp Yang Arbang Pilŏ́ng, a-lứng lớiq biq máh ti-cuôi cán tớq vel hơ. <verse eid="ACT 17:4" /><verse number="5" style="v" sid="ACT 17:5" />Ma, co máh ti-cuôi Isa-ra-el lớiq ính tin sáng uan, iki ndóng khoiq a-rŏ́ng máh ti-cuôi pla ngki tớq car-na, par-chúng lư clứng ti-cuôi ngki, nha-án chuôq rúc vel ndô. Dyơ ndóng mot tớq dúng Ya-sôn, nha-án si-suô nha-án bar dŏq dông tớq chứng mát ti-cuôi clứng. <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />Ma tư lớiq tu-múh nha-án bar, nha-án a-ngốh Ya-sôn a-lứng máh em ai ndon tin chứng mát máh ti-cuôi sút tớq vel, yứng cang idô: “Nha-án chuôq rúc cruông cu-teq ndô, nha-án lư khoiq át tớq ndô, <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />la máh ti-cuôi ndon Ya-sôn a-lứng nhéq náq top ndô khoiq ráp. Nha-án chón át táq chíl liêh máh phep rit na Sê-sa, ndóng tông bôn mui puô can-nŏ́h, la Yê-su.” <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />Iki, top nha-án táq dyôn máh ti-cuôi clứng nha top ti-cuôi sút tớq vel sáng nháih tư bôn sáng máh par-nai ngki. <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />Dyơ vít ndóng ráp práq par-ưq te Ya-sôn a-lứng máh ti-cuôi yôl liêh, top ti-cuôi sút ta-láh dyôn nha-án pôq.<verse eid="ACT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />Ma dyơ, ngki táp tớq nga i-dáu, top i-nha dông díh Phau-lô nha Si-la pôq nga Bê-rê, ma nha-án bar ndô, tư tớq nnơi, ngki mot tớq dúng rum na ti-cuôi Isa-ra-el. <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />Chón ngki, máh ti-cuôi tớq ndô ngki bôn mít lám bŏt hơn máh ti-cuôi tớq Tê-salô-ni-ca, nha-án khoiq cam-máng par-nai ŏ a-lứng nhéq te mít can-nính, ndóng cứp i-ngái rian níc Tám U-ráq Yang, me máh callong ngki lư crái iki a-láng lớiq. <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />Iki, clứng ti-cuôi te top nha-án khoiq tin, náp díh máh ti-cuôi cán Créc hơ tin a-lứng lớiq biq ti-cuôi conh. <verse eid="ACT 17:12" /><verse number="13" style="v" sid="ACT 17:13" />Ma tư ti-cuôi Isa-ra-el tớq Tê-salô-ni-ca sáng dyơ par-nai na Yang Arbang Pilŏ́ng lư chón bôn ca to co Phau-lô tớq Bê-rê, nha-án lư tớq ntúq ndô, par-yông a-lứng chuôq rúc ti-cuôi clứng. <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />Iki, tớq ndóng ngki, top i-nha chái tháng dông Phau-lô pôq díh nga dơq ving ca-vang, chón ndóng bar náq la Si-la nha Ti-mu-thê ki lư yôl át tớq ngki. <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />Ma máh ti-cuôi a-yông Phau-lô khoiq dông án díh tớq A-thên dyơ ndóng ráp par-nai cơiq ada Si-la nha Ti-mu-thê idô nha-án bar cóq tớq a-lứng mái a-cán cláih a-cán ŏ, nha-án píh chô.<verse eid="ACT 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />Ndóng ki tớq A-thên, chón ndóng Phau-lô át pớn nha-án, par-ngíh án cơt sáng nháih tớq mít bôm, tư hôm vel ndô bôn máng mol rup. <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />Iki la, án tar-miên tớq dúng rum a-lớng ti-cuôi Isa-ra-el nha máh ti-cuôi dyám náp Yang Arbang Pilŏ́ng, mu chứng a-lứng máh ti-cuôi bôn tar-múh tớq cứp i-ngái ntúq táiq plới. <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />Ma bôn máh ti-cuôi te top Phi-lô-sô-phơ top Ep-cu-riên nha top Sa-tuôc ngki tar-miên a-lứng án. Bôn án tông: “Ti-cuôi a-ưi par-nai ndô ính taq-ntêr a-mớh ngki?” Ma án can-nŏ́h ngki tông: “Dêu ar-mo án la ti-cuôi ca to te máh yang can-nŏ́h,” co án chón pau ntêr Par-nai ŏ te Yang Yê-su nha callong tu-mống liêh. <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />Ma, ndóng cŏp án dyơ, nha-án dông nga Ti-cuôi sút A-rê-ô-ba, tông idô: “Top he ính chom ar-náq tam-me ndô, par-nai chón ndon mái ca to, la a-mớh? <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />Co mái dông a-tớq máh par-nai laq cu-tor top he. Iki top he ính chom máh ar-náq ngki bôn tar-náp la a-mớh.” <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />(Dyơ ngki, nhéq máh ti-cuôi A-thê-niên a-lứng top ti-cuôi tu-mống tớq ngki lư lớiq ính cam-máng te ar-náq can-nŏ́h ta-niêng la ntêr ar-náq a-mớh lớiq la cam-máng ar-náq tam-me loi.)<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />Dyơ ngki, ndóng bôn ta-yứng tớq ntúq Ti-cuôi clứng A-rê-ô-ba, Phau-lô tông idô:</para>
  <para style="p" vid="ACT 17:22">“Ơi i-nha la ti-cuôi A-thê-niên, cư hôm i-nha ính sang tám yang na cứp nốh i-mo. <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />Co ndóng pôq par-lơ nha bôn hôm máh nốh cứh ayô na i-nha, cư lư bôn hôm mui prông sang ma tớq ngki dŏq ta-ran chưq: ‘Sang Yang Lớiq Chom.’ Iki, yang ndon i-nha sang ndóng i-yốh chom, ngki la Án cư chón taq-ntêr ada i-nha. <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" />Yang Arbang Pilŏ́ng, la Yang khoiq teng cơt cruông cu-teq a-lứng cứp nốh tớq ngki, la Yang na pilŏ́ng nha cu-teq, Án lớiq tu-mống tớq prông sang co na ti-cuôi táq. <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />Án lư lớiq túh cóq táq na ưllang ati ti-cuôi a-rớq Án ính mui ar-náq a-mớh, co lư Án dyôn nhéq tưh callong tu-mống, bôn tar-ngứh a-lứng cứp nốh can-nŏ́h. <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />Ma, te mu náq ti-cuôi, Án khoiq teng cơt cứp thư ti-cuôi tu-mống tớq chuôp mpiên cu-teq, ndóng dŏq a-nát i-ngái ki-sái lư ar-lớih nha ntúq át tu-mống na nha-án, <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />dyôn têq si-suô Yang Arbang Pilŏ́ng, dáh lơ bôn mu biq nha-án têq ti-tuaiq suô Án dyơ bôn tu-múh Án, ntro Án lư lớiq át yông te cứp náq ti-cuôi tớq top he. <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />Co tớq Án, top he tu-mống, têq pu-pôq a-lứng chom tu-táq, mu chứng a-rớq ti-cuôi tớq top i-nha khoiq tông: ‘Co top he lư la a-cái a-con na Án.’ <verse eid="ACT 17:28" /><verse number="29" style="v" sid="ACT 17:29" />Iki, co la a-cái a-con na Yang Arbang Pilŏ́ng, top he lớiq têq par-ngíh idô Yang Arbang Pilŏ́ng ngki a-rớq máh rup na dyeng, lớiq la práq, a-láng búl co hôi tu-báiq nha callong par-ngíh na ti-cuôi. <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />Iki, ndóng Yang Arbang Pilŏ́ng khoiq táh luaih máh pang ndon a-chơ ngki, hoi ndô Án tông ada thư ti-cuôi, cứp ti-cuôi chuôp cứp ntúq, cóq piên lêq, <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />co Án khoiq a-nát mui i-ngái, ma ma tớq i-ngái ngki Án lư tar-sưq pang ndô tớq callong ti-nớng tu-pứng co Ti-cuôi Án khoiq dŏq rêh, ndóng a-páh tíc ar-lớih lư dyôn cứp ti-cuôi na car-na dyôn Ti-cuôi ngki tu-mống liêh te cu-chet.”<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />Dyơ ngki, tư sáng te callong tu-mống liêh te ti-cuôi cu-chet, bôn ti-cuôi ayê án; ma án can-nŏ́h tông: “Top he ngki lư cam-máng mái te ar-náq ndô mu chư loi.” <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />Co iki, Phau-lô ngốh te top nha-án. <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />Ma máh ti-cuôi ngki ndon khoiq tar-veng án ngki tin, tớq top ngki bôn díh Di-ô-ni-si-ut, la ti-cuôi sút A-rê-ô-ba, mu náq cán nốh Da-ma-ri, a-lứng máh ti-cuôi can-nŏ́h mu nơi a-lứng nha-án.<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />Vít máh ar-náq ngki, ndóng ngốh te A-thên, án pôq nga Cô-rin-tô. <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />Dyơ tư tu-múh mu náq ti-cuôi Isa-ra-el ngki, nốh A-cui-la, car-nian tớq cruông Pôn-tu, mbơiq tớq te I-ta-li nha Ba-rit-sin, cam-pái án, co Cơ-lôt khoiq yua nhéq máh ti-cuôi Isa-ra-el cóq tôi te Rô-ma, án pôq a-lang nha-án, <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />ma co bôn mui ar-náq, án khoiq át nha táq ar-náq mu nơi a-lứng nha-án, co nha-án cơt la máh ti-cuôi dyih pa-nu veng ar-náq. <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />Dyơ ngki, cứp chư i-ngái A-ngô, án ca to tớq dúng rum, án khêr díh ti-cuôi Isa-ra-el a-lứng ti-cuôi Créc. <verse eid="ACT 18:4" /><verse number="5" style="v" sid="ACT 18:5" />Ma ndóng díh Si-la nha Ti-mu-thê khoiq tớq te Ma-sa-dôn, Phau-lô nhéq te mít ada par-nai ŏ, ca-tóng ca to dyôn ti-cuôi Isa-ra-el te Yang Yê-su la Yang Choi Ta-mống. <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />Ma, ndóng nha-án chíl liêh nha a-craiq án, ngki vít ndóng tam-prúh au, án tông ada nha-án: “a-ham top i-nha hóc tớq plô top i-nha! Ma cư ớq luaih! Náp te hoi ndô, cư lư tớq nga máh ti-cuôi tới Isa-ra-el.” <verse eid="ACT 18:6" /><verse number="7" style="v" sid="ACT 18:7" />Tư khoiq ngốh te ngki, án pôq nga dúng mu náq ndon sang tám Yang Arbang Pilŏ́ng ngki, nốh Ti-ti-u Yut-tơ, ma dúng ti-cuôi ndô át ting dúng rum. <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />Ma, Cơ-rit-bu, sút kiaq me dúng rum, khoiq tin Yang, a-lứng cứp náq tớq dúng án, nha clứng ti-cuôi Cô-rin-tô, vít dyơ cam-máng ngki tin a-lứng ráp tíc na dơq. <verse eid="ACT 18:8" /><verse number="9" style="v" sid="ACT 18:9" />Dyơ ngki, Yang tông ada Phau-lô na mui callong a-páh tớq i-dáu: “Êq a-dáh, ma, cóq ca to níc, a-lứng êq át ar-ngiac a-mớh. <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />Co Cư át a-lớng mái nha ớq nnáu dáh táq nga mái dŏq ính ca-chet mái, co bôn clứng ti-cuôi dyôn ada Cư tớq vel ndô.” <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />Iki, án át liêh mui cu-mo tu-pát ki-sái, ca to par-nai na Yang Arbang Pilŏ́ng tớq top nha-án.<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />Ma ndóng Ca-li-ôn táq sút cruông A-chai, ti-cuôi Isa-ra-el sŏ́ng ính táq liêh Phau-lô dyơ dông án nga ntúq tar-sưq, <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />tông idô: “Ti-cuôi ndô par-yông máh ti-cuôi sang tám Yang Arbang Pilŏ́ng lớiq crái phep rit.” <verse eid="ACT 18:13" /><verse number="14" style="v" sid="ACT 18:14" />Ma tư Phau-lô ính pốh ta-cang, Ca-li-ôn khoiq ntêr ada ti-cuôi Isa-ra-el: “Ơi, máh i-nha ti-cuôi Isa-ra-el ntíh, khán ndô lư la ar-náq táq luaih lớiq la luaih táq ar-náq saq, ma co te ar-náq ngki, lư cư khoiq chiuq ta-nhir ada top i-nha, <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />ma khán ndô la máh ar-náq tar-miên te par-nai, nốh a-lứng rit rŏng ndái na top i-nha, top i-nha bôm ta-léh. Cư lớiq ính táq tar-sưq te máh ar-náq a-rớq ndô.” <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />Dyơ án chuih nha-án ngốh te ntúq tar-sưq. <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />Ma, ndóng cŏp Sôt-then, ti-cuôi kiaq me dúng rum, nhéq náq top nha-án púh tính án ntúq tar-sưq, ma ớq ar-náq mmo te ar-náq ngki dŏq ính mmứng ada Ca-li-ôn.<verse eid="ACT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />Ma Phau-lô, tar-lúh ndóng ndô ma yôl át liêh a-ưi i-ngái, dyơ car-bánh car-suanh top i-nha, án pôq na tuôc nga Si-ri, mu nơi a-lứng án Ba-rit-sin nha A-cui-la, vít dyơ khoiq dŏq ca-luah plô bôm tớq Sen-cơ-rê, co án khoiq bôn par-nai par-ưq. <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />Dyơ ngki, nha-án pôq nga Ê-phê-sô, dyơ án táh nha-án át tớq ngki, nưm náq án, ndóng khoiq mot tớq dúng rum, án tar-miên a-lớng ti-cuôi Isa-ra-el. <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />Ma ndóng nha-án yua án át liêh dyôn ada dưnh loi, án lớiq ưq. <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />Ma, ndóng par-táh a-lớng nha-án dyơ tông: “Cư lư tớq liêh nga i-nha mu chư loi khán Yang Arbang Pilŏ́ng ính,” ngki án sớr tớq tuôc ngốh te Ê-phê-sô.<verse eid="ACT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 18:22" />A-lứng ndóng khoiq tớq vel Sê-sa-rê, dyơ sớr a-lứng car-bánh car-suanh máh em ai, án pôq nga An-ti-ôt. <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />Tư át tớq ngki bôn dưnh i-ngái, án ti-ráp, dyơ pôq pha máh cruông Ca-la-ti nha Phu-ra-yiê, táq dyôn nhéq náq máh top rian cơt khớm.<verse eid="ACT 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />Dyơ bôn, mu náq ti-cuôi Isa-ra-el ngki, nốh A-bô-lô, át tớq vel A-lec-san-dơ-riên, án la ti-cuôi hôi taq-ntêr, khoiq pôq nga vel Ê-phê-sô, ndóng la mu náq chom a-ưi te Tám U-ráq Yang. <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />Án khoiq bôn rian te par-nai ŏ Yang, a-lứng co mít can-nính ính tar-choi, án ca to a-lứng pa-rian ar-lớih máh callong tớq te Yang Yê-su, ndóng nưm chom táq tíc na dơq na Yon. <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />Iki, án ta-bớq ca to clŏ́q lư tớq dúng rum, ma ndóng cam-máng án, Ba-rit-sin nha A-cui-la khoiq dông án chô dyơ taq-ntêr dyôn án chom ar-lớih tháng te par-nai na Yang Arbang Pilŏ́ng. <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />Chón ngki, co án par-ngíh ính pôq nga A-chai, ndóng a-liam án, top i-nha ta-ran chớiq cơiq dyôn máh top tin dŏq pa-sôl án, ma tư tớq nnơi, án khoiq tar-choi lư a-ưi dyôn máh ti-cuôi khoiq tin nhơ callong choi mat. <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />Co án khoiq tar-miên a-lứng ti-cuôi Isa-ra-el cơt clŏ́q lư, ndóng ial te Tám U-ráq Yang a-páh Yang Yê-su la Yang Choi Ta-mống.<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />Dyơ ngki, ar-náq khoiq cơt chón ndóng A-bô-lô át tớq Cô-rin-tô, Phau-lô, vít ndóng pôq ti-lớt máh cruông te pa ta-niêng, án pôq nga vel Ê-phê-sô ngki tar-múh máh top rian ntíh. <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />Dyơ, án tông ada nha-án: “Tư khoiq tin, i-nha bôn ráp Yang Ar-vai a-láng lớiq?” Ma nha-án ôi liêh án: “Ớq, ma khán bôn Yang Ar-vai, ngki top he lư i-yốh cơi sáng lớng.” <verse eid="ACT 19:2" /><verse number="3" style="v" sid="ACT 19:3" />Án lư tông: “Iki i-nha khoiq ráp tíc na dơq mmo?” Dyơ nha-án ôi: “Táq tíc tớq dơq na Yon.” <verse eid="ACT 19:3" /><verse number="4" style="v" sid="ACT 19:4" />Ma, Phau-lô tông: “Yon táq tíc na dơq te callong piên lêq, ndóng ca to dyôn máh ti-cuôi te Án chón tớq ta-tun yon, têq dyôn nha-án têq tin, ngki la tin te Yang Yê-su.” <verse eid="ACT 19:4" /><verse number="5" style="v" sid="ACT 19:5" />Dyơ ngki, tư sáng iki, nha-án ráp tíc na dơq te nốh Yang Yê-su. <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />Tư Phau-lô dŏq ati tớq nha-án, Yang Ar-vai át tớq nha-án, dyơ nha-án ntêr tớq cang can-nŏ́h nha ntêr tang ng-cang. <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />Ndóng ngki, nha-án bôn nhéq náq ali mu chít la bar náq ngai ng-conh.<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />Chón ngki, ndóng mot tớq dúng rum, án clŏ́q lư ca to nhéq pe ki-sái, taq-ntêr a-lứng khêr te cruông na Yang Arbang Pilŏ́ng. <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />Ma ndóng bôn máh ti-cuôi ngki cớng mít a-lứng lớiq cam-máng, tông lớiq Par-nai Yang tớq mát ti-cuôi clứng, ngki án khoiq ngốh te máh ti-cuôi tin, viar yông te nha-án, cứp i-ngái tang-húng a-lớng tar-tuôq tớq dúng rian Ti-ra-nu. <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />Ma, ar-náq ndô khoiq cơt tớq bar cu-mo, ti-ngôi nhéq náq máh ti-cuôi át tớq A-siê bôn sáng nhéq par-nai Yang, díh ti-cuôi Isa-ra-el nha ti-cuôi Créc. <verse eid="ACT 19:10" /><verse number="11" style="v" sid="ACT 19:11" />Yang Arbang Pilŏ́ng lư táq máh ar-náq si-leh can-nŏ́h cơi co ati na Phau-lô, <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />tar-lúh ial khán a-láng prới ta-kít tớq ng-cár án bôn dông a-tớq dyôn máh ti-cuôi ndon a-ái ngki callong a-ái pít te nha-án, yang saq lư ngốh táp. <verse eid="ACT 19:12" /><verse number="13" style="v" sid="ACT 19:13" />Ndóng ngki, máh thới chuih yang sáq ti-cuôi Isa-ra-el pôq tu-dô tu-ki ính ngin arô nốh Yang Yê-su tớq máh ti-cuôi bôn yang saq pi-yúh, idô: “Cư yua ada mái co nốh Yê-su ma Phau-lô ca to.” <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />(Ndóng ngki, bôn tu-pul náq a-cái conh na án Sê-va ntíh, mu náq thới teng rit sang ti-cuôi Isa-ra-el, chón táq ar-náq ndô.) <verse eid="ACT 19:14" /><verse number="15" style="v" sid="ACT 19:15" />Ma ôi liêh, yang sáq tông ada nha-án, “Cư chom Yê-su, cư lư chom Phau-lô, ma top i-nha la nnáu?” <verse eid="ACT 19:15" /><verse number="16" style="v" sid="ACT 19:16" />Dyơ ti-cuôi ndon yang sáq chón táq ngki, ndóng pa-lóng nga nha-án ngki bánh hơn díh nha-án, án táq chol chíl liêh nha-án, tar-lúh mu ra-rat a-lứng bôn chol, cóq lúh te dúng ngki. <verse eid="ACT 19:16" /><verse number="17" style="v" sid="ACT 19:17" />Dyơ ngki, ar-náq ndô cơt par-dŏ́h par-hanh dyôn nhéq náq máh ti-cuôi át tớq Ê-phê-sô, díh ti-cuôi Isa-ra-el nha ti-cuôi Créc. Callong a-dáh át tớq nhéq náq nha-án, a-lứng nốh Yang Yê-su bôn dyám náp. <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />Clứng ti-cuôi te máh ti-cuôi khoiq tin lư pôq, ngin kho a-lứng taq-ntêr máh ar-náq táq na án. <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />Ma, clứng ti-cuôi táq a-rớq ti-cuôi mo, ndóng pa-chúng máh u-ráq na án liêh, khoiq chóng chứng mát cứp ti-cuôi. Ngai ngiaih tar-náp te chớiq ngki, a-lứng nha-án bôn hôm la sông chít ngin callong práq. <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />Iki, co chức sút, par-nai Yang par-hanh pi-lư a-lứng pưt a-sớr.<verse eid="ACT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />Dyơ ngki, ndóng máh ar-náq ndô khoiq dŏq táq, Phau-lô par-ngíh tớq Ar-vai Yang, pôq pha na Ma-sa-dôn nha A-chai, dŏq pôq nga Yaru-salem, ndóng tông idô: “Vít dyơ cư khoiq tớq ntúq ngki, cư lư cóq pôq clơ Rô-ma hơ.” <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />Iki, tư ndóng yua pôq bar náq te máh ti-cuôi táq ar-náq án, Ti-mu-thê nha Ê-rat, nga Ma-sa-dôn, lư án khoiq át tớq A-siê yôl dưnh i-ngái.<verse eid="ACT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />Ma tớq máh i-ngái ngki, bôn callong par-chớu lớiq két khoiq cơt co te Par-nai ŏ Yang. <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />Co mu náq thơq táq práq ngki, nốh Dê-ma-tri, hôi táq rup cán At-te-mit na práq, khoiq bôn lớiq biq lơi te táiq rup ngki, <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />ma án, vít dyơ par-chúng máh ti-cuôi thơq tớq ar-náq ndô ngki, khoiq tông: “Ơi cứp náq, i-nha chom ar-lớih callong bôn lơi na top he la ngốh te ar-náq tán táiq ndô. <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />I-nha khoiq hôm a-lứng sáng dyơ tới nưm tớq Ê-phê-sô, ma lư tớq chuôp A-siê, nốh Phau-lô ndô, cua dyơ a-liam, khoiq táq dyôn clứng lư máh ti-cuôi mot tin, co tông idô cứp nốh táq cơt co ati tới la yang ŏ a-mớh díh. <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />Ma, ar-náq ndô tới nưm la ính can-nốh sớng táq dyôn callong par-chớu te ar-náq top he táq, ma díh ada dúng sang yang cán At-te-mit pưt tar-náp ndon lớiq bôn díh dyám náp lớng. Ma, callong ang ưr na yang cán ngki chuôp A-siê, a-lứng díh cúc cu-teq sang tám, lư ar-lớih tu-mán ính ar-lóh.” <verse eid="ACT 19:27" /><verse number="28" style="v" sid="ACT 19:28" />Ndóng ngki, tư bôn sáng iki ngki cơt chái lư nháih, nha-án hiar yứng idô: “Sút pưt lư cán At-te-mit ưlla ti-cuôi Ê-phê-sô!” <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />Dyơ díh vel cơt pớnh máng callong par-chớu ngki, a-lứng ti-cuôi clứng par-chôq tớq nga ntúq báq par-chúng, táq a-rớq Cai-ut nha A-ri-tac, ti-cuôi Ma-sa-dôn, la máh yớu mu nơi na Phau-lô. <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />Ma tư Phau-lô ính tar-múh tớq ti-cuôi clứng, máh top rian lớiq dyôn án táq iki. <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />Ma bôn máh ti-cuôi sút A-siê, la top yớu na án, nưm na cơiq par-nai ada án, lư khoiq dyŏq án êq chóng mŏp bôm a-nga ti-cuôi clứng ngki. <verse eid="ACT 19:31" /><verse number="32" style="v" sid="ACT 19:32" />Dyơ, máh ti-cuôi clứng ngki át hiar yứng hiar idô hiar iki, co nhéq tưh ngki chón par-chớu, nha clứng náq lớiq chom nha-án tớq par-chúng co ar-náq a-mớh. <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />Dyơ ngki, bôn ti-cuôi tớq te ti-cuôi clứng taq-ntêr ar-náq ada A-lec-san-dơ, vít ndóng ti-cuôi Isa-ra-el ki-túh án ta-yứng chứng mát, dyơ A-lec-san-dơ, a-vít ati dyŏq ta-cang, ính tông êq uan ada ti-cuôi clứng. <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />Ma tư chom ar-lớih ngki án ndô la ti-cuôi Isa-ra-el, bôn car-sang yứng lư te nhéq náq top nha-án ar-náq khoiq cơt bôn ali chen bar a-déh dôi: “Pưt lư cán At-te-mit na ti-cuôi Ê-phê-sô.” <verse eid="ACT 19:34" /><verse number="35" style="v" sid="ACT 19:35" />Ma, ndóng ti-cuôi sút tớq vel khoiq táq ti-cuôi clứng át ar-ngiac, án tông:</para>
  <para style="p" vid="ACT 19:35">“Em ai ơi, máh ti-cuôi prái Ê-phê-sô, lư bôn ti-cuôi mmo ma lớiq chom ar-lớih vel Ê-phê-sô la ti-cuôi kiaq dúng sang na cán At-te-mit pưt lư a-lứng rup yang te pilŏ́ng a-tôh? <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />Khán iki, co máh ar-náq ndô la lớiq têq suôn, callong tar-náp dyôn top i-nha la cóq a i-láq, a-lứng êq táq callong a-mớh ta-laih. <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />Co i-nha khoiq dông máh ti-cuôi ndô tu-dô, ma nha-án tới la án ndon tôiq crơng na dúng sang, a-lứng tới la án ndon a-craiq yang cán na top he. <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />Iki, khán Dê-ma-tri a-lứng thơq hôi táq cứp nốh mu nơi a-lớng án bôn par-nai tar-cauq nnáu, máh ntúq par-chen yôl chón pốh callống, nha a-lứng bôn máh ti-cuôi sút, cóq dyôn nha-án tar-cauq tar-tuôq. <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />Ma khán i-nha ính bôn callong a-mớh te máh ar-náq can-nŏ́h, ar-náq ngki lư bôn par-tê tớq ti-cuôi sút veng phep rit. <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />Co lư, top he ngai cauq te luaih par-chớu co te máh ar-náq i-ngái ndô, ndóng ớq bôn callong a-mớh, ma co ar-náq ngki, top he lư lớiq têq a-ngốh par-nai taq-ntêr dyôn callong rum mu nơi lớiq iên ŏ ndô.” <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />Cua dyơ tông iki, án yua mmar chô máh ti-cuôi rum mu nơi ngki.<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />Chón ngki, ndóng ar-náq par-chớu khoiq nhéq, Phau-lô yua máh top veng ta-pun tớq, dyơ cua ndóng a-liam nha-án, tông par-nai talloiq, ngki án pôq, nga cruông Ma-sa-dôn. <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />Dyơ ngki, tư khoiq pôq pha máh cruông ngki a-lứng a-liam nha-án te mui par-nai ca to toiq, án pôq nga Créc. <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />Ma, ndóng át ngki pe ki-sái dyơ, co bôn ngê ính táq án co ti-cuôi Isa-ra-el ndóng ính pôq na tuôc nga Si-ri, án khoiq par-ngíh píh chô nga Ma-sa-dôn. <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />Ndóng ngki, pôq mu nơi a-lứng án Sô-ba-tê, a-cái Phi-rut, ti-cuôi Bê-rê; ma bôn A-ri-tac a-lứng Sê-cun-dơ, ti-cuôi Tê-salô-ni-ca; Cai-ut, ti-cuôi Der-bơ; Ti-mu-thê; nha Ti-cha-cơ a-lứng Trô-phim, ti-cuôi A-siê. <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />Ma co khoiq pôq nsuôi, nha-án chón pớn top he tớq Trô-at. <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />Ma top he, cua máh i-ngái Cha Beng Mi Ớq Bôt Pôih, khoiq ngốh te vel Phi-lip, a-lứng vít sông i-ngái, top he khoiq pôq a-lứng nha-án tớq Trô-at, ntúq ma top he át liêh ngki nhéq tu-pul i-ngái.<verse eid="ACT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />Hoi ngki, tớq i-ngái chư mui tớq tún, ndóng top he rum liêh mu nơi dŏq cha beng, Phau-lô ca to ada máh top tin. Co par-ngíh ính pôq i-ngái ta-tun, iki án át ca to ti-ngôi tar-di i-dáu. <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />Ndóng ngki, bôn a-ưi den tớu tớq callúng trơn ta-niêng, ntúq ma top he báq rum. <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />Ma, mu náq la-lớu ngki, nốh Ơ-tic, ndóng ti-cu tớq ngáh callống, dyơ ngki bíq tưt ngiar, chón ndóng Phau-lô ca to dưnh lư loi, co cơt ngiar tháng te bíq tưt, án khoiq a-tôh te trơn pe pi-tốq dyơ cu-chet ndóng bôn a-yôr. <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />Ma, ndóng khoiq siar, Phau-lô táng ngop tớq Ơ-tic, dyơ créu Ơ-tic, án tông: “Êq crŏ́q, co callong tu-mống na mái lư yôl át tớq mái.” <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />Vít ngki, án sớr trơn ta-niêng, péq beng dyơ cha pêl, a-lứng taq-ntêr te i-bư díh ti-ngôi ang i-láih, dyơ a-rớq ngki, án pôq. <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />Ma ngai dông conh ndon yôl tu-mống chô dyơ bôn sáng bui lớiq biq.<verse eid="ACT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />Vít ngki, ndóng khoiq pôq nsuôi tớq ntúq tuôc, top he bôn pôq nga A-sôt, la ntúq par-ngíh lư cớiq Phau-lô sớr tuôc, co án khoiq ính táq iki, ndóng lư án veng par-ngíh pôq na car-na ti-caq. <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />Dyơ ndóng án khoiq tu-múh top he tớq A-sôt, ngki cua dyơ cớiq án sớr nga tuôc, top he pôq nga Mi-tu-len. <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />A-lứng ndóng ngốh te ntúq ngki, i-ngái ta-tun top he pôq ali Chi-ô, ma vít i-ngái ngki, top he pôq nga Sa-môt, dyơ i-ngái ngki loi, top he khoiq pôq nga Mi-lê-tu. <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />Co Phau-lô par-ngíh pôq na tuôc ti-lớt Ê-phê-sô, dŏq án lớiq ính át dưnh tớq A-siê, co án chón hớp dŏq chái tớq nga Yaru-salem tớq i-ngái Cha Bui Nhéq I-ngái A-pot, khán ar-náq ngki la têq ada án.<verse eid="ACT 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />Iki, te Mi-lê-tu, tư yua mu náq pôq nga Ê-phê-sô, án yua mơi máh ti-cuôi sút tớq dúng rum tớq. <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />Dyơ ngki, ndóng nha-án khoiq tớq nga án, án tông ada nha-án idô: “Lư i-nha chom ar-lớih, te i-ngái tôm lư, la te ndóng cư mbơiq át tớq A-siê, cư khoiq át a-lứng i-nha a-rớq i-mo nhéq máh i-ngái ngki, <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />ndóng táq ar-náq Yang na nhéq te mít a-siar cháq a-lứng dơq mát ngki chiuq máh diêiq a-rức tớq ada cư co ngê lớiq ŏ na ti-cuôi Isa-ra-el, <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />i-mo cư khoiq lớiq dŏq liêh callong a-mớh, la máh callong tar-náp, ma lớiq ca to dyôn i-nha, cư lư khoiq ca to i-nha tớq ntúq clứng ti-cuôi, a-lứng tớq máh cứp dúng, <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />ndóng ca to dyôn díh ti-cuôi Isa-ra-el nha ti-cuôi Créc te callong piên lêq dŏq tớq nga Yang Arbang Pilŏ́ng a-lứng te callong tin tớq Yang top he, Yang Yê-su. <verse eid="ACT 20:21" /><verse number="22" style="v" sid="ACT 20:22" />Ngki, seq me ndô, cư chón na car-na pôq nga Yaru-salem, co khoiq ráp Ar-vai Yang dyôn pôq, lư lớiq chom nốh a-mớh ính tớq ada án tớq ngki, <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />nưm ar-náq Yang ar-vai ntêr nsuôi ada cư tớq cứp vel, tông idô cŏq tôt a-lứng diêiq a-rức yôl át pớn mái. <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />Ma, cư lớiq ntêr par-nai mmo dyôn tar-ngứh cư la pưt lư co te cư, dŏq táq cua nhéq ar-náq tam-pring na cư a-lứng ar-náq ndon cư khoiq ráp te Yang Yê-su, dŏq ca to Par-nai ŏ co callong choi mat na Yang Arbang Pilŏ́ng. <verse eid="ACT 20:24" /><verse number="25" style="v" sid="ACT 20:25" />Chón ngki, seq me ndô, cư chom dyơ nhéq náq i-nha, la te máh ti-cuôi ndon cư khoiq sáng ndóng ca to te cruông tớq Pilŏ́ng, lư lớiq bôn hôm ar-maiq cư nnáng. <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />Co iki, tớq i-ngái ndô, cư tông nsuôi i-nha idô cư ớq luaih te a-ham na nhéq na i-nha. <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />Co cư lớiq dŏq liêh mui callong a-mớh táq dyôn nhéq tưh can-nính ính na Yang Arbang Pilŏ́ng lớiq bôn ca to te i-nha. <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />Cóq me a-ŏ cháq bôm a-lứng máh ti-cuôi két ma Yang Ar-vai khoiq dyôn i-nha cơt ti-cuôi kiaq me dŏq par-yông top tin na Yang Arbang Pilŏ́ng, la top tin ma Án khoiq plới tớq a-ham na án táp. <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />Cư chom ar-lớih vít ndóng pôq te cư, máh a-yŏ́ng pla lư ngki pa-lóng cáp tớq top i-nha, lớiq sáng a-yáu máh ti-cuôi két. <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />Díh tớq te top i-nha lư bôn ti-cuôi ndon tông a-ngốh máh callong lớiq crái ính par-yông clứng top rian veng nha-án. <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />Iki, cóq mmứng, ayư idô i-ngái a-lứng i-dáu, khoiq nhéq pe cu-mo, cư lớiq a-ngô ca to cứp náq ti-cuôi a-lứng te dŏq mát. <verse eid="ACT 20:31" /><verse number="32" style="v" sid="ACT 20:32" />Chón ndô, cư mŏp i-nha dyôn Yang Arbang Pilŏ́ng a-lứng dyôn par-nai na callong choi mat Án, par-nai bôn chức dŏq pưt a-sớr i-nha a-lứng dyôn ada i-nha máh mun te top nhéq náq máh ti-cuôi chón bôn táq práh. <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />Cư lớiq ính práq lớiq la dyeng a-láng tam-pớc na nnáu. <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />Lư i-nha chom dyơ ưllang ati ndô khoiq táq ar-náq ada par-ngíh ính na cư a-lứng na máh ti-cuôi át mu nơi a-lứng cư. <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />Cư khoiq a-páh dyôn i-nha te nhéq cứp ar-náq ndô cóq chiuq a-rức táq mmín a-rớq ngki dŏq tar-choi máh ti-cuôi ớq rêng, ma dŏq ayư máh par-nai na Yang Yê-su, co lư Án khoiq ca to: ‘Lư bôn bún ndóng dyôn hơn la ndóng ráp.’”<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />Cua dyơ tông máh par-nai ngki, ngki ndóng chóh tar-col a-siar, án cớu seq ada nhéq náq nha-án. <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />Ma, callong nhiêm yứng lư cơt tớq top nha-án, a-lứng ndóng créu ial ti-cong Phau-lô dyơ, nha-án honh án, <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />co sáng a-nguaq lư la par-nai án khoiq tông, dyơ nha-án tar-mán ớq bôn hôm ar-maiq án nnáng. Vít ngki, nha-án a-suôi án nga tuôc.<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />Chón ngki, ar-náq cơt ndóng top he khoiq pôq na tuôc, la ndóng par-táh te nha-án, ngki pôq ti-nớng, top he pôq tớq Côt, dyơ vít i-ngái ta-tun tớq Rô-dơ, a-lứng te ngki tớq Ba-ta-ra. <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />Tư khoiq bôn tu-múh mui allám tuôc pôq pha tớq Phê-na-si, ngki sớr tuôc ngki, top he bôn pôq na tuôc. <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />Ndóng ngki, vít dyơ bôn hôm con Sip-rơ, ngki viar pa a-viar con, top he pôq na tuôc nga Si-ri a-lứng pôq tớq nga Ti-rơ, co tuôc cóq a-tức crơng-crớu tớq ngki. <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />Ndóng ngki, vít dyơ bôn tu-múh máh ti-cuôi tin, top he át liêh ngki tu-pul i-ngái, ma nha-án, nhơ Ar-vai Yang dyôn chom, dŏq tông Phau-lô êq ti-yốq pôq nga Yaru-salem. <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />Chón ngki, ar-náq cơt tớq ndóng top he khoiq nhéq dyơ nsếq i-ngái ndô, ngki la vít ndóng ti-ráp pôq, top he sớr tớq tuôc sa, ndóng cứp náq nha-án lư pôq a-suôi top he mu nơi a-lớng cam-pái nha top a-cái, ti-ngôi díh par-ngốh vel, dyơ ndóng chóh tar-col a-siar tớq tor dơq ving ca-vang cớu seq, <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />top he car-bánh ada tar-tuôq dyơ sớr tớq tuôc, ma máh ti-cuôi ngki píh chô nga dúng nha-án, <verse eid="ACT 21:6" /><verse number="7" style="v" sid="ACT 21:7" />ma top he, tư khoiq vít dyơ ngốh te vel Ti-rơ, dyơ pôq nga vel Pa-tô-la-mai, a-lứng ndóng car-bánh i-nha, top he át liêh a-lớng nha-án mui i-ngái. <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />Dyơ i-ngái ta-tun, vít ndóng khoiq pôq, top he pôq nga Sê-sa-rê a-lứng, tư khoiq mot tớq dúng na Phi-lip, án ndon pau ca to Par-nai ŏ Yang, la mui te tu-pul náq ndon táq ar-náq, top he át liêh a-lớng án. <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />Dyơ ngki, án bôn puan náq a-cái cán cu-mor plŏt ntêr tang ng-cang. <verse eid="ACT 21:9" /><verse number="10" style="v" sid="ACT 21:10" />Dyơ bôn a-ưi i-ngái ndóng top he át tớq ngki, mu náq tang ng-cang ngki, nốh A-ca-but, khoiq tớq te Yu-dê. <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />Vít ndóng tớq tar-múh top he a-lứng ial ntár pa-eu te Phau-lô, dyơ chóq dyưng ati na án bôm ngki, án tông: “Yang Ar-vai tông máh callong idô: ‘Veng a-rớq ndô, ti-cuôi Isa-ra-el tớq Yaru-salem lư chóq ti-cuôi conh, ndon ti-cuôi ngki ưlla ntár pa-eu ndô, dyơ nha-án lư mŏp ti-cuôi ngki nga ati ti-cuôi tới Isa-ra-el.’” <verse eid="ACT 21:11" /><verse number="12" style="v" sid="ACT 21:12" />Iki, tư top he sáng máh par-nai ngki, díh top he nha máh ti-cuôi tớq vel lư ca-tớih án êq pôq nga Yaru-salem. <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />Vít ngki, Phau-lô ôi liêh: “I-nha chón táq a-mớh iki, nhiêm a-lứng táq dyôn mít cư sáng a-nguaq? Co cư bôn ti-ráp dŏq, lớiq nưm dyôn ngai chóq, ma yôl chiuq cu-chet co nốh Yang Yê-su tớq Yaru-salem hơ.” <verse eid="ACT 21:13" /><verse number="14" style="v" sid="ACT 21:14" />Ndóng ngki, án lớiq ính cam-máng, top he lớiq pa-tot, tông: “Seq can-nính Yang têq cơt.”<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />Dyơ, vít máh i-ngái ngki, ndóng khoiq pa-chúng crơng-crớu, top he pôq nga vel Yaru-salem. <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />Dyơ bôn máh top tin te Sê-sa-rê ngki pôq a-lứng top he, a-yông top he tớq ntúq Ma-na-sôn, mu náq ndon át tớq Sip-rơ, la top tin te nsuôi lư, ma tớq ntúq ti-cuôi ndô top he bôn a-ngô tớq ngki.<verse eid="ACT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />Dyơ ngki, tư top he khoiq tớq nga pưt Yaru-salem, máh em ai sáng bui pa-sôl top he. <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />Dyơ i-ngái ta-tun, Phau-lô pôq a-lứng top he pôq tar-múh Ya-cơ, ma nhéq máh ti-cuôi sút top tin ngki lư tớq. <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />Car-bánh nha-án dyơ, án ntêr liêh te máh ar-náq cứp callong ma Yang Arbang Pilŏ́ng khoiq choi te ti-cuôi ti-cuôi tới Isa-ra-el na ar-náq te án. <verse eid="ACT 21:19" /><verse number="20" style="v" sid="ACT 21:20" />Chón ngki, tư ndóng sáng iki, nha-án cứh ayô Yang Arbang Pilŏ́ng, ma nha-án tông ada án: “Ngki ai ơi, mái hôm lớiq, bôn a-ưi van ti-cuôi khoiq tin te top ti-cuôi Isa-ra-el a-lứng nha-án lư bôn nhéq mít can-nính te phep rit. <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />Ma, nha-án khoiq taq-ntêr te mái, i-mo mái ca to te ar-náq táh viang rit Môi-se dyôn cứp ti-cuôi Isa-ra-el te máh ti-cuôi tới Isa-ra-el, ndóng dyŏq máh ti-cuôi ngki êq táq rit kít dyôn a-cái a-con mái, a-lứng êq tu-mống veng máh rit rŏng. <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />Khán iki, cóq táq i-mo? Lư ar-lớih nha-án lư chom la mái khoiq tớq. <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />Iki cóq táq idô, la callong ndon top he tông ada mái. Puan náq ngki át a-lứng top he, chón bôn te án mui par-nai par-ưq. <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />Cua dyơ dông máh ti-cuôi ndô veng ngki cóq ráp a-rau práh a-lớng nha-án, a-lứng cóq choi práq ada nha-án, dŏq nha-án têq ca-luah plô bôm, dyơ cứp ti-cuôi lư chom ar-lớih máh callong nha-án khoiq bôn taq-ntêr te mái la lư lớiq bôn, ma lư ki mái át tu-mống par-tát ŏ, ndóng táq veng phep rit. <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" />Ma te máh ti-cuôi tới Isa-ra-el khoiq tin, top he khoiq cơiq chớiq, dŏq a-nát cóq viar bôm te crơng ngai tức sang mol rup, a-ham, pan-nán ngai éc, a-lứng callong láh par-lưi.” <verse eid="ACT 21:25" /><verse number="26" style="v" sid="ACT 21:26" />Dyơ ngki, i-ngái tớq ta-tun, vít ndóng dông máh ti-cuôi ngki pôq, ndóng khoiq bôn a-rau práh mu nơi a-lứng nha-án, Phau-lô pôq mot tớq dúng sang, taq-ntêr callong ính nhéq te nsếq i-ngái crơng mŏp táq práh, náp díh ndóng crơng bôn mŏp dyôn cưp náq ti-cuôi tớq nha-án.<verse eid="ACT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />Ma ndóng tu-pul i-ngái tar-mán ính nhéq, bôn ti-cuôi Isa-ra-el tớq te A-siê, vít ndóng hôm Phau-lô tớq dúng sang, khoiq cha-chuôq máh ti-cuôi clứng dyơ ính táq táp án, <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />hiar yứng: “Ơi i-nha, ti-cuôi Isa-ra-el ơi, seq choi hơ! Ndô la ti-cuôi ca to cứp ti-cuôi chuôp ntúq chíl liêh máh ti-cuôi, phep rit Môi-se a-lứng ntúq ndô. Ma, án díh dông ti-cuôi Créc mot tớq dúng sang a-lứng táq a-íh ntúq práh ŏ ndô.” <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />Co te nsuôi, nha-án khoiq hôm Trô-phim, ti-cuôi Ê-phê-sô, mu nơi a-lứng án tớq vel, ma nha-án par-ngíh i-mo Phau-lô khoiq dông án mot tớq dúng sang. <verse eid="ACT 21:29" /><verse number="30" style="v" sid="ACT 21:30" />Díh vel mbơiq bôn par-chớu, mbơiq tớq mui top clứng máh ti-cuôi par-lóng, dyơ vít ndóng cŏp Phau-lô, nha-án a-ngốh án nga cu-lái tiêh dúng sang, a-lứng callống ngki táp cơt ca-táng liêh. <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />A-lứng chón ndóng ính ca-chet án, ngki ar-náq par-hanh nga ti-cuôi sút top líng i-mo díh vel Yaru-salem chón át par-chớu, <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />ngki táp, vít dyơ dông top líng a-lứng máh ti-cuôi sút, án siar nga ntúq ti-cuôi clứng. Dyơ tư ngai bôn hôm án ndon sút a-lứng sút líng, nha-án lớiq tính púh Phau-lô. <verse eid="ACT 21:32" /><verse number="33" style="v" sid="ACT 21:33" />Tớq ndóng ndô, tư khoiq tớq tu-mán, ti-cuôi sút líng yua cŏp án, yua dŏq án ngai chóq tớq bar ntráih sic, dyơ plốh me án la nnáu a-lứng án khoiq táq a-mớh. <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />Ma, bôn máh ti-cuôi te ti-cuôi clứng chón át hiar mui ar-náq can-nŏ́h, ma án ndon sút, ndóng ớq bôn tu-múh nốh a-mớh lư ar-lớih co siêng a-váih par-chớu, ngki khoiq yua dông án a-chô nga pốt. <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />Ma tư án pôq tớq calláng cam-pong, ar-náq cơt tớq ada án la cóq bôn top líng crang pôq co callong crêng lư na ti-cuôi clứng. <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />Co mui top ti-cuôi lư clứng tar-veng níc, át hiar: “Ca-chet án viang!”<verse eid="ACT 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />Ma, tư tu-mán ính tớq nga pốt, Phau-lô tông ada ti-cuôi sút líng: “Têq lớiq dyôn cư ntêr mui callong a-lớng mái lớiq?” Dyơ ti-cuôi sút líng tông: “Mái chom cang Créc? <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />Iki mái tới la ti-cuôi Ê-yip-tô, án ndon nsuôi máh i-ngái ndô khoiq ính tar-píh a-lứng dông puan ngin ti-cuôi chíl liêh tớq ntúq aih?” <verse eid="ACT 21:38" /><verse number="39" style="v" sid="ACT 21:39" />Dyơ Phau-lô ôi: “Cư la ti-cuôi Isa-ra-el, át tớq vel Tar-sơ, cruông Si-la-si, mu náq ti-cuôi ngaq tớq vel tới la sút pưt. Iki cư seq mái dyôn cư taq-ntêr a-lứng ti-cuôi clứng.” <verse eid="ACT 21:39" /><verse number="40" style="v" sid="ACT 21:40" />Dyơ ngki tư ti-cuôi sút dyôn, ndóng ta-yứng tớq cam-pong, Phau-lô a-vít na ati ada ti-cuôi clứng. Hoi ngki, ndóng khoiq át ar-ngiac dyơ, án tông tớq cang Isa-ra-el, idô:<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />“Em ai ơi, top i-nha ngki ndon a-ám, seq cam-máng par-nai tar-choi na cư ada top i-nha hoi ndô.”<verse eid="ACT 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 22:2" />Ndóng ngki, tư sáng dyơ án chón tông tớq cang Isa-ra-el ada án, nha-án a-cán át ar-ngiac pi-lư. Dyơ án tông:<verse eid="ACT 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3" />“Cư la ti-cuôi Isa-ra-el, car-nian tớq vel Tar-sơ cruông Si-la-si, ma bôn rian tớq vel ndô te dyưng thới Ca-ma-li-ên, bôn ca to veng car-na crái piaiq na phep rit a-chúc a-chiac top he, bôn nhéq mít can-nính co Yang Arbang Pilŏ́ng mu chứng nhéq náq i-nha chón bôn i-ngái ndô, <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />la án khoiq táq diêiq a-rức Ti-cuôi Tin ndô ti-ngôi cu-chet, ndóng cŏp chóq a-lứng crál tớq cŏq díh ngai ng-conh nha ngai ng-cán, <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />mu chứng a-rớq thới teng rit sang taq-ntêr ada cư a-lứng nhéq máh ti-cuôi sút, la máh ti-cuôi ndon vít dyơ ráp chớiq ngki te nha-án cơiq dyôn top i-nha, cư pôq nga Da-mac, pôq dông a-chô máh ti-cuôi ngai cŏp át tớq ngki a-chô nga Yaru-salem, dyôn nha-án ráp tôt. <verse eid="ACT 22:5" /><verse number="6" style="v" sid="ACT 22:6" />Chón ngki, ar-náq cơt ada cư ngki la ndóng chón pôq na car-na a-lứng tar-mán tớq Da-mac, ali pan-dang tứng, ti-cớr, bôn ang lư ang te pilŏ́ng ta-bal pa-niar cư. <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />Ma, cư dứm tớq cu-teq a-lứng sáng mui siêng tông ada cư: ‘Sau-lơ, Sau-lơ, i-mo mái táq Cư?’ <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />Dyơ ngki, cư ôi liêh: ‘Yang Ơi, I-nha la nnáu?’ Án ôi liêh cư: ‘Cư la Yê-su ti-cuôi Na-sa-ret, Án ndon mái chón táq.’ <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />Ndóng ngki, máh ti-cuôi chón át a-lứng cư bôn hôm ang ngki, ma nha-án lớiq chom a-púh siêng na Án chón tông ada cư. <verse eid="ACT 22:9" /><verse number="10" style="v" sid="ACT 22:10" />Ma cư ngki ôi: ‘Yang Ơi, cư cóq táq i-mo?’ Vít ngki, Yang tông ada cư: ‘Dyơ ndóng yôr ta-yứng, cóq pôq tớq vel Da-mac, a-lứng tớq ngki mái lư bôn taq-ntêr dyôn chom te nhéq máh nốh a-mớh khoiq dŏq a-nát dyôn cư cóq táq.’ <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />Iki, tớq ndóng cư ớq bôn hôm ar-lớih co te ang claq ta-bal ngki, iki nhơ bôn kéu ati a-yông pôq te máh ti-cuôi át a-lứng cư, cư khoiq mot tớq vel Da-mac. <verse eid="ACT 22:11" /><verse number="12" style="v" sid="ACT 22:12" />Dyơ ngki, ai A-na-niê ngki, la mu náq nhéq mít can-nính veng phep rit, bôn dyám náp te cứp ti-cuôi Isa-ra-el tu-mống tớq ngki, <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />ndóng khoiq tớq nga cư a-lứng ta-yứng chứng mu pa, án tông ada cư: ‘Ai Sau-lơ ơi, cóq plang mát liêh.’ Lư tu-pứng ngki, cư me bôn hôm án. <verse eid="ACT 22:13" /><verse number="14" style="v" sid="ACT 22:14" />Vít ngki, conh tông: ‘Yang Arbang Pilŏ́ng na a-chúc a-chiac top he khoiq rêh mái dŏq chom par-ngíh Án, a-lứng dŏq bôn hôm Án Ti-nớng Lư, nha a-rớq dyôn sáng siêng tông te ng-cang Án, <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />co mái lư la mui tíc dyôn Án tớq cứp ti-cuôi te máh nốh mái khoiq hôm a-lứng sáng. <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />Hoi ngki, mái yôl át pớn a-mớh? Ndóng yôr ta-yứng, cóq ráp tíc na dơq a-lứng cóq táq práh luaih mái nhơ cớu seq nốh Án.’ <verse eid="ACT 22:16" /><verse number="17" style="v" sid="ACT 22:17" />Vít ngki, ar-náq cơt tớq ada cư ndóng píh chô nga Yaru-salem, nha ndóng cư chón cớu seq tớq dúng sang, ngki cư lư cơt a-rớq par-náu mpáu. <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />Cư hôm Án tông ada cư: ‘A-chái a-dưh, a-lứng cóq ngốh te Yaru-salem a-chái a-dứh, co nha-án lư lớiq ính cam-máng par-nai ca to na mái te Cư.’ <verse eid="ACT 22:18" /><verse number="19" style="v" sid="ACT 22:19" />Ma cư ôi: ‘Yang Ơi, lư nha-án chom dyơ cư ngai crál tớq cŏq a-lứng tính púh tớq máh dúng rum khán nnáu tin te Án. <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />Tư a-ham Ê-tiên, taq-ntêr te Án, khoiq ngốh a-ham, lư cư táp ta-yứng tar-mán ngki, sŏ́ng tưi, a-lứng kiaq me tam-pớc na máh ti-cuôi ca-chet án.’ <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />Dyơ Án tông ada cư: ‘Cóq pôq, co cư lư yua mái pôq a-yông tớq nga máh ti-cuôi tới Isa-ra-el.’”<verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />Dyơ ngki, ti-cuôi clứng chón cam-máng án ti-ngôi díh par-nai ndô, ngki nha-án yứng cang tông: “Cóq ca-chet viang rớp ti-cuôi a-rớq ndô te pang ndô, co lớiq piaiq dŏq án tu-mống.” <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />Ma, ndóng nha-án chón át yứng cang, a-dúh tam-pớc a-lứng trứh mbúi cu-teq nga pilŏ́ng, <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />ti-cuôi sút líng khoiq yua dông án mot tớq nga pốt, tông ada án cóq chiuq ráp ngai tính púh, dŏq ính chom co luaih a-mớh ma ti-cuôi clứng chón át yứng cang chíl liêh án iki. <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />Ma ndóng nha-án khoiq chóq án ngki tớq ntár dŏq ính prớih, Phau-lô tông ada ti-cuôi sút líng chón ta-yứng ngki: “Têq lớiq phep rit têq dyôn i-nha tính púh ti-cuôi prái Rô-ma ma i-yốh chom callong luaih?” <verse eid="ACT 22:25" /><verse number="26" style="v" sid="ACT 22:26" />Ndóng ngki, co sáng iki, ti-cuôi sút, ndóng tớq nga án sút pốt líng, khoiq tông liêh idô: “Mái chón ính táq a-mớh? Co ti-cuôi ndô la ti-cuôi prái Rô-ma.” <verse eid="ACT 22:26" /><verse number="27" style="v" sid="ACT 22:27" />Dyơ ngki, ndóng khoiq tớq, ti-cuôi sút tông ada án: “Áu dyôn cư chom, mái lư la ti-cuôi prái Rô-ma a-láng tới?” Dyơ án ôi: “Lư.” <verse eid="ACT 22:27" /><verse number="28" style="v" sid="ACT 22:28" />Dyơ ngki, ti-cuôi sút pốt tông liêh: “Cư khoiq plới chức ti-cuôi prái ngki na máh práq pưt.” Ma Phau-lô tông: “Ma cư lư bôn car-nian a-rớq iki.” <verse eid="ACT 22:28" /><verse number="29" style="v" sid="ACT 22:29" />Co iki, máh ti-cuôi ính táq án ngki táp car-lun ngốh te án, ma ti-cuôi sút pốt ngki sáng a-dáh tư chom dyơ án la ti-cuôi Rô-ma, a-lứng co án khoiq yua cŏp chóq Phau-lô.<verse eid="ACT 22:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />Iki dyơ, tớq i-ngái ta-tun, co ính chom ar-lớih i-mo ma án cơt ti-cuôi Isa-ra-el ính táq, ti-cuôi sút pốt khoiq lếh dŏq chóq án, a-lứng yua máh thới teng rit sang a-lứng nhéq tưh Ti-cuôi Sút par-chúng liêh. Dyơ ndóng dông Phau-lô ngốh, ti-cuôi sút pốt yua dŏq án ta-yứng pan-di nha-án.<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />Chón ngki, tư ndóng me tiêu-liêu nga ti-cuôi sút, Phau-lô tông: “Ơi em ai, ơi top i-nha, cư khoiq tu-mống chứng mát Yang Arbang Pilŏ́ng nhéq te tar-ngứh tar-hơ práh ŏ ti-ngôi i-ngái ndô.” <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />Ma thới teng rit sang A-na-niê yua ada máh ti-cuôi ta-yứng tar-mán án tap ng-cang án. <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />Chón ndóng ngki, Phau-lô tông ada án: “Car-táng khoiq pớih clŏq ntíh, Yang Arbang Pilŏ́ng ính táq mái! Mái ti-cu tar-sưq cư veng phep rit, ma yua dŏq cư ngai tính lớiq crái rit?” <verse eid="ACT 23:3" /><verse number="4" style="v" sid="ACT 23:4" />Ma, máh ti-cuôi ta-yứng ngki tông: “Mái pu-pap thới teng rit sang Yang Arbang Pilŏ́ng?” <verse eid="ACT 23:4" /><verse number="5" style="v" sid="ACT 23:5" />Phau-lô tông: “Em ai ơi, cư khoiq lớiq chom dyơ án la thới teng rit sang. Co khoiq bôn ta-ran idô: ‘Mái êq tông par-nai lớiq ŏ ada ti-cuôi sút ti-cuôi i-nha.’”<verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />Iki, tư ndóng chom ar-lớih mui top la ti-cuôi Sa-du-sê, ma top ntíh la ti-cuôi Pha-ra-si, Phau-lô khoiq tông yứng cang tớq Ti-cuôi Sút: “Ơi em ai, ơi top i-nha, cư la ti-cuôi Pha-ra-si, a-cái na ti-cuôi Pha-ra-si; Cư chón ngai tar-sưq co ar-náq te callong ng-cong nha callong tu-mống liêh na ti-cuôi cu-chet.” <verse eid="ACT 23:6" /><verse number="7" style="v" sid="ACT 23:7" />Dyơ ngki, ndóng án tông callong ndô, bôn callong tar-miên cơt tớq te ti-cuôi Pha-ra-si a-lứng ti-cuôi Sa-du-sê, dyơ nha-án cơt par-táh. <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />Co ti-cuôi Sa-du-sê tông ớq bôn callong tu-mống liêh, a-lứng ớq bôn tar-neng a-láng máh ar-vai, ma ti-cuôi Pha-ra-si ngki ca-lư díh bar callong ngki. <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />Iki, siêng tar-miên yứng lư cơt tớq, nha ndóng yôr ta-yứng, bôn thới sái rit te top Pha-ra-si tar-miên, idô: “Top he ớq hôm bôn callong luaih a-mớh te ti-cuôi ndô. Ma dáh lơ, mui ar-vai lớiq la mui tar-neng khoiq tông ada án …” <verse eid="ACT 23:9" /><verse number="10" style="v" sid="ACT 23:10" />Dyơ ngki, ndóng callong tar-miên cơt pưt lư, ti-cuôi sút, co rớu ri a-dáh Phau-lô têq nha-án ca-chet, khoiq yua ada máh líng pôq tar-píh án te top nha-án, dyơ a-chô án nga pốt.<verse eid="ACT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11" />Ma, tớq i-dáu ta-tun, ndóng tớq tar-mán án, Yang tông: “Cóq a-khớm mít co mái khoiq ca to te Cư i-mo tớq Yaru-salem, callong tar-náp ada mái lư cóq ca to iki tớq Rô-ma.”<verse eid="ACT 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />Iki dyơ díh ang, ndóng tang-húng ngê a-lớng tar-tuôq, máh ti-cuôi Isa-ra-el chóng can-tŏ́h, ngki lớiq cha a-lứng lớiq ngoiq ti-ngôi díh top nha-án bôn ca-chet Phau-lô. <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />Ndóng ngki, bôn hơn puan chít náq tang-húng ar-náq ndô, <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />ma ndóng tớq a-lớng top thới teng rit sang, nha máh ti-cuôi sút, nha-án tông: “Top he khoiq can-tŏ́h mui par-nai pu-pap nha-án táp dŏq lớiq cha a-mớh ti-ngôi díh top he bôn ca-chet Phau-lô. <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />Co iki, hoi ndô, seq top i-nha a-lứng Ti-cuôi Sút taq-ntêr ada ti-cuôi sút líng, a-rớq chón ính tar-sưq ada ar-lớih máh ar-náq tớq co te án, dŏq ti-cuôi sút ngki têq dông án tớq nga top i-nha. Ma top he ngki khoiq côn ính ca-chet án nsuôi ndóng án tớq nnơi.” <verse eid="ACT 23:15" /><verse number="16" style="v" sid="ACT 23:16" />Ma a-cái conh na ơi Phau-lô, co khoiq sáng te ngê tang-húng, iki ndóng tớq dyơ mot tớq pốt, taq-ntêr ar-náq ndô ada Phau-lô. <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />Iki, ndóng khoiq arô mu náq te máh ti-cuôi sút líng ngki, Phau-lô tông: “Seq dông a-mon conh ndô tớq nga ti-cuôi sút líng, co a-mon ndô bôn callong ính taq-ntêr ada án.” <verse eid="ACT 23:17" /><verse number="18" style="v" sid="ACT 23:18" />Iki, vít dyơ dông a-mon ngki, ti-cuôi sút líng khoiq dông án tớq tar-múh án ndon sút pốt dyơ plốh: “Nốh tôt Phau-lô, ndóng arô cư, khoiq yua cư dông a-mon conh ndô tớq nga i-nha, co bôn par-nai ính ntêr ada i-nha.” <verse eid="ACT 23:18" /><verse number="19" style="v" sid="ACT 23:19" />Dyơ, ndóng khoiq kéu ati a-mon ngki dyơ dông nga ntúq ớq nnáu, ti-cuôi sút ngki plốh: “Callong ndon mái ính taq-ntêr ada cư la a-mớh?” <verse eid="ACT 23:19" /><verse number="20" style="v" sid="ACT 23:20" />Dyơ án ntêr idô: “Máh ti-cuôi Isa-ra-el khoiq sŏ́ng yua i-nha táq i-mo i-ngái par-nô i-nha têq dông Phau-lô pôq nga Ti-cuôi Sút, a-rớq chón ính ti-tuaiq plốh dyôn ada ar-lớih te án. <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />Co iki, seq i-nha êq dyôn top nha-án pa-rap, co hơn puan chít náq te top nha-án chón ca-tốq côn án, la máh ti-cuôi khoiq dŏq can-tŏ́h lớiq cha a-lứng lớiq ngoiq ti-ngôi díh bôn ca-chet án. Ndóng ngki nha-án chón ti-ráp dyơ, át pớn callong ôi te i-nha.” <verse eid="ACT 23:21" /><verse number="22" style="v" sid="ACT 23:22" />Iki, ti-cuôi sút pốt yua án chô, pa-táp án: “Êq dyôn nnáu chom la mái khoiq taq-ntêr ada cư máh ar-náq ndô.” <verse eid="ACT 23:22" /><verse number="23" style="v" sid="ACT 23:23" />Vít dyơ arô bar náq ndon sút ntíh, án tông: “Cóq ti-ráp bar cu-lám líng pôq a-lứng tu-pul chít diq a-séh nha bar cu-lám líng kéu coih táq i-mo máh top líng têq pôq nga Sê-sa-rê dyơ tớq ti-kiaih yơ i-dáu ndô, <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />a-lứng ti-ráp a-séh diq dŏq dyôn Phau-lô ti-cu, nha-án têq a-suôi án iên ŏ nga ti-cuôi sút Phê-lit,” <verse eid="ACT 23:24" /><verse number="25" style="v" sid="ACT 23:25" />chón ndóng ta-ran chớiq a-lang bôn par-nai idô:<verse eid="ACT 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 23:26" />“Ca-lôt Li-siê cơiq ti-cuôi sút Phê-lit par-nai a-lang: Seq car-bánh car-suanh. <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />Ti-cuôi ndô, ndóng ngai cŏp co ti-cuôi Isa-ra-el a-lứng ính tar-mán nha-án ca-chet, cư khoiq choi ndóng chái tớq a-lứng máh top líng, co chom ar-lớih án la ti-cuôi prái Rô-ma. <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />Ma, co ính chom te par-nai luaih ma te ngki nha-án cauq án, cư khoiq dông án nga Ti-cuôi Sút na nha-án, <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />ma cư hôm án ngai tông luaih callong tar-miên te phep rit na nha-án, ma lớiq bôn luaih mmo piaiq cu-chet lớiq la crál tớq cŏq. <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />Iki dyơ, ndóng tang-húng ngê lư cơt dŏq chíl liêh ti-cuôi ndô bôn pa-sáng ada cư, cư khoiq chái lư dông án nga i-nha, tư ndóng yua ada máh ti-cuôi ính cauq cóq ntêr callong cauq án chứng mát i-nha.”<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />Iki, top líng ngki, cam-máng par-nai khoiq yua nha-án, ndóng dông Phau-lô ngki, khoiq dông án pôq tớq i-dáu nga An-ti-ba-tri. <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />Dyơ i-ngái ta-tun, nha-án chô nga pốt, ma bôn top líng na a-séh pôq a-lứng án, <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />nhéq top líng ndô, tư khoiq mot tớq vel Sê-sa-rê dyơ a-vôi chớiq ada ti-cuôi sút, a-lứng dông mŏp Phau-lô ada án. <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />Dyơ ngki, cua dŏc chớiq a-lứng plốh án tớq te cruông mmo, dyơ ndóng khoiq chom la te cruông Si-la-si, <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />ti-cuôi sút ngki tông: “Cư lư tar-sưq mái veng phep rit ndóng máh ti-cuôi cauq mái ngki tớq ndô,” dyơ yua án dŏq kiaq me tớq dúng pưt na Hê-rôt.<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />Dyơ ngki, vít sông i-ngái, thới teng rit sang A-na-niê, a-lứng máh ti-cuôi a-riaih ngki, nha ti-cuôi par-chen par-nai Tet-tu-lu ntíh khoiq tớq, la máh ti-cuôi ndon tớq ính cauq chứng mát ti-cuôi sút chíl liêh Phau-lô. <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />Dyơ ndóng án khoiq bôn arô tớq, Tet-tu-lu ta-bớq cauq án, ndóng tông: “Co bôn callong iên ŏ pưt nhơ Án, a-lứng co a-ưi nốh ndon tớq dyôn cruông ndô co callong chom nsuôi na án, <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />ơi a-vốq Phê-lit lư dyám náp, díh tớq cứp ar-náq nha chuôp cứp ntúq, top he ayư máh túh tál ngki a-lứng nhéq te mít chom si-ơn. <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />Ma dŏq cư lớiq táq pi-ŏ́q i-nha cơt a-ưi nnáng, cư seq i-nha, te callong chiuq ta-nhir na cư, cam-máng top he taq-ntêr mu biq. <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />Lư, co bôn hôm ti-cuôi ndô táq pláh chap, nha la ti-cuôi chuôq rúc callong chíl liêh te cứp ti-cuôi Isa-ra-el chuôp cruông cu-teq, a-lứng la ti-cuôi plô top Na-sa-ret, <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />la ti-cuôi ndon khoiq táq dyôn a-íh dúng sang, mu chứng la ti-cuôi ndon top he khoiq cŏp, — [a-lứng top he ính tar-sưq veng phep rit na top he. <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />Ma ti-cuôi sút pốt Li-siê, tư tớq nnơi, khoiq tar-píh án te ati top he na bánh rêng, <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />yua máh ti-cuôi cauq án cóq tớq nga i-nha] — ma te án, i-nha ngki lư têq plốh te nhéq máh ar-náq ndô dŏq ính chom máh luaih ndon top he cauq te án.” <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />Dyơ ngki, ti-cuôi Isa-ra-el mu chứng sŏ́ng tưi, ca lư máh ar-náq ngki la lư iki.<verse eid="ACT 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />Phau-lô lư khoiq ôi liêh, ndóng ti-cuôi sút dyôn án taq-ntêr: “Co chom i-nha khoiq táq sút tar-sưq án dyôn ti-cuôi ndô tớq a-ưi cu-mo, cư bui hơr bôn taq-ntêr te máh ar-náq ndon tớq nga án, <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />co Án têq chom ar-lớih te ndóng cư pôq dŏq sang tám tớq Yaru-salem ngki lớiq tớq mu chít la bar i-ngái, <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />a-lứng nha-án lớiq tu-múh cư tar-miên a-lứng nnáu tớq dúng sang, mu chứng lớiq táq dyôn calong par-chớu ntúq clứng ti-cuôi, lớiq la tớq máh dúng rum, a-láng chuôp díh vel pưt, <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />nha-án lư lớiq chom a-ngốh a-mớh nnáng ính cauq dyôn i-nha te máh luaih ndon nha-án chón át cauq cư. <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />Ma cư ngin a-lứng i-nha callong ndô, idô veng a-rớq Par-nai Yang ndon nha-án dŏq la piaiq, ma a-rớq ngki cư táq ar-náq Yang Arbang Pilŏ́ng na a-chúc a-chiac, ng-cong ki-nứm nga nhéq máh nốh veng a-rớq phep rit nha máh par-nai khoiq ta-ran tớq tám u-ráq tang ng-cang, <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />bôn callong ng-cong te Yang Arbang Pilŏ́ng ma lư nha-án chón át ng-cong, ngki lư bôn callong tu-mống liêh te nhéq tưh ti-cuôi ti-nớng ŏ díh ti-cuôi lớiq ŏ. <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />Co te ngki, lư cư át ca-tóng dŏq bôn mít can-nính ớq bôn luaih chứng mát Yang Arbang Pilŏ́ng a-lứng thư ti-cuôi tớq cứp callong. <verse eid="ACT 24:16" /><verse number="17" style="v" sid="ACT 24:17" />Dyơ ngki, khoiq dưnh cu-mo, cư píh chô, dông práq tar-choi dyôn ti-cuôi tớq cruông cư, a-lứng máh crơng mŏp sang, <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />ma chón ndóng ngki, nha-án tu-múh cư táq rit a-rau práh tớq dúng sang, lớiq par-chúng clứng ti-cuôi, a-lứng lớiq bôn nnáng táq pláh chap. <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />Ma máh ti-cuôi Isa-ra-el ntíh te A-si, la máh ti-cuôi piaiq lư cóq tớq taq-ntêr chứng mát i-nha dyơ ính tar-cauq, khán nha-án bôn ar-náq a-mớh chíl ada cư. <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />Lớiq la lư máh ti-cuôi tớq ndô cóq taq-ntêr callong lớiq crái mmo ndon nha-án khoiq bôn tu-múh ndóng cư ta-yứng chứng mát Ti-cuôi Sút te ti-cuôi Isa-ra-el, <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />bôn lớiq te mui par-nai tông a-rớq ndô ma cư khoiq hiar yứng ndóng ta-yứng pan-di nha-án, idô: ‘Cư chón chiuq tar-sưq chứng mát top i-nha hoi ndô te ar-náq callong tu-mống liêh na ti-cuôi cu-chet.’”<verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />Dyơ ngki Phê-lit, co chom lư ar-lớih máh ar-náq co tớq te Par-nai Yang, khoiq lớiq par-chen nnáng dyôn bar pa, dyơ tông: “Ali mmo ti-cuôi sút Li-siê têq tớq tu-dô, cư lư par-chen máh ar-náq ndon tớq nga top i-nha,” <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />yua ti-cuôi sút líng kiaq me Phau-lô, ma cóq dyôn án bôn callong iên ŏ, nha êq ca-táng máh em ai na án tớq a-lang án.<verse eid="ACT 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />Dyơ nsếq i-ngái ta-tun, Phê-lit, ndóng píh liêh a-lứng Dơ-ru-si, cam-pái án, la mu náq cán Isa-ra-el, ngki khoiq arô Phau-lô tớq dyơ cam-máng án taq-ntêr te callong tin tớq Yang Choi Ta-mống Yê-su. <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />Ma ndóng án chón taq-ntêr te callong ti-nớng tu-pứng nha callong ti-nớng ŏ, a-lứng callong tar-sưq lư tớq, Phê-lit, co sáng a-dáh, khoiq ôi liêh: “Hoi ngki cóq chô a-vai, ma ali mmo ớq mmaq, cư lư arô liêh mái tớq.” <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />Ma ndóng ngki, la co ng-cong níc idô lư bôn mu biq práq te Phau-lô chang dyôn án, co te ngki, ti-cuôi sút át taq-ntêr a-lứng án tư arô án tớq níc. <verse eid="ACT 24:26" /><verse number="27" style="v" sid="ACT 24:27" />Ma ndóng vít nhéq bar cu-mo, Phê-lit bôn ti-cuôi cláp Bôt-tiu Phê-tu, ma co ính ial mít ti-cuôi Isa-ra-el, Phê-lit dŏq crál Phau-lô tớq cŏq.<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />Iki, ndóng khoiq tớq ráp sút tớq vúng ngki, pe i-ngái ta-tun, Phê-tu ngốh te Sê-sa-rê pôq nga Yaru-salem. <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />Ma, máh thới teng rit sang a-lứng máh ti-cuôi sút cơt plô te ti-cuôi Isa-ra-el pôq tu-múh nsuôi án dyơ cauq Phau-lô a-lứng nha-án tar-seq te án, <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />ndóng seq mui callong tar-choi chíl ada Phau-lô, ngki la, ti-cuôi sút têq arô liêh Phau-lô sớr nga Yaru-salem, chón ndóng suan ntúq dŏq ính ca-chet án tớq car-na. <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />Vít ngki, Phê-tu ôi liêh idô Phau-lô chón ngai crál tớq Sê-sa-rê, ma lư cư táp ngki cóq a-chái pôq. <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />Án tông: “Co iki, ma ti-cuôi sút tớq top i-nha, ndóng mu nơi siar ngki, khán bôn callong a-mớh lớiq crái te ti-cuôi ndô, ngki i-nha cauq luaih án.”<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />Dyơ ngki, ndóng khoiq át a-lứng nha-án lớiq a-ưi hơn ti-col lớiq la mu chít i-ngái, án pôq nga Sê-sa-rê. I-ngái ta-tun, ndóng ti-cu tớq ki-chơng tar-sưq, án yua dông Phau-lô tớq táp. <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />Dyơ, tư án khoiq tớq, máh ti-cuôi Isa-ra-el bôn te Yaru-salem tớq dyơ crong pa-niar án, tông a-ưi par-nai luaih pưt lư ma nha-án ớq bôn tíc a-mớh, <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />ma ndóng Phau-lô tông idô: “Cư lớiq táq luaih díh luaih mmo chíl liêh phep rit na ti-cuôi Isa-ra-el, ớq chíl liêh dúng sang, a-lứng ớq chíl liêh Sê-sa.” <verse eid="ACT 25:8" /><verse number="9" style="v" sid="ACT 25:9" />Ma co án ính ial mít can-nính ti-cuôi Isa-ra-el, Phê-tu ôi liêh Phau-lô idô: “Mái ính lớiq, khán pôq nga Yaru-salem, dŏq chiuq tar-sưq tớq ngki chứng mát cư te máh ar-náq ndô?” <verse eid="ACT 25:9" /><verse number="10" style="v" sid="ACT 25:10" />Ma, Phau-lô ôi: “Cư chón ta-yứng tớq ntúq tar-sưq na Sê-sa, la ntúq ính dyôn cư cóq chiuq tar-sưq. Cư ớq táq ar-náq a-mớh lớiq ŏ dyôn ti-cuôi Isa-ra-el, a-rớq i-nha khoiq chom lư ar-lớih. <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />Iki, khán cư táq lớiq ŏ a-lứng khoiq táq ar-náq a-mớh piaiq cu-chet, cư lớiq seq dyôn vít cu-chet. Ma khán ớq luaih mmo te máh nốh a-mớh nha-án cau luaih cư, ớq nnáu têq mŏp cư ada nha-án. Cư ính tar-sưq tớq Sê-sa.” <verse eid="ACT 25:11" /><verse number="12" style="v" sid="ACT 25:12" />Vít ngki, ndóng khoiq tang-húng a-lứng máh yớu, Phê-tu ôi: “Mái ính tar-sưq nga Sê-sa. Mái lư pôq nga Sê-sa!”<verse eid="ACT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />Dyơ ngki, khoiq vít dyơ nsếq i-ngái, puô A-rip-pa a-lứng a-yáq Bê-rê-nit khoiq pôq nga Sê-sa-rê, a-lang Phê-tu. <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />Dyơ chón ndóng nha-án át tớq ngki a-ưi i-ngái, Phê-tu taq-ntêr ada puô máh ar-náq te Phau-lô, idô: “Ti-cuôi conh ntíh la ti-cuôi luaih ndon Phê-lit i-yốh ta-láh, <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />ma te ti-cuôi ndô, máh thới teng rit sang a-lứng máh a-riaih ti-cuôi Isa-ra-el khoiq cauq, ndóng cư át tớq Yaru-salem, yua ca-chet viang án. <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />Cư khoiq ôi ada nha-án idô phep rit ti-cuôi Rô-ma la lớiq mŏp ti-cuôi mmo nsuôi ti-cuôi ndon luaih cóq bar pa tar-múh a-lứng máh ti-cuôi cauq, dyơ ngki têq dŏq ôi bôm te callong cauq ngki. <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />Co iki, ndóng nha-án tớq tu-dô, lớiq táq dyôn dyut nnáng, i-ngái ta-tun, ndóng ti-cu tớq ki-chơng tar-sưq dyơ, cư yua ti-cuôi ngki mot, <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />ma co te án, vít dyơ máh ti-cuôi cauq yua ta-yứng, nha-án ớq hôi a-ngốh callong luaih mmo a-rớq máh luaih ndon cư par-ngíh. <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />Ma lư ngki, nha-án bôn callong tar-miên a-lứng Phau-lô te rit sang na án a-lứng te Yê-su ntíh khoiq cu-chet ma Phau-lô tông la yôl tu-mống. <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />Iki, co lớiq chom ar-lớih callong tar-miên te máh ar-náq ndô, cư khoiq plốh án a-láng ính pôq nga Yaru-salem dŏq bôn par-chen tớq ngki te máh ar-náq ngki. <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />Ma ndóng Phau-lô seq dŏq án át tớq cŏq pớn callong tar-sưq na puô, cư khoiq yua dŏq án tớq cŏq ti-ngôi ndóng cư têq dông án nga Sê-sa.” <verse eid="ACT 25:21" /><verse number="22" style="v" sid="ACT 25:22" />Dyơ A-rip-pa tông ada Phê-tu: “Lư cư la ính cam-máng ti-cuôi ndô.” Án ôi liêh: “I-ngái par-nô puô lư bôn sáng án ngki.”<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />Iki, tớq i-ngái ta-tun, tư A-rip-pa nha Bê-ra-nit khoiq tớq a-lứng tớc tam-pớc lư a-maiq dyơ mot tớq ntúq tar-sưq a-lứng díh ti-cuôi sút líng, díh máh ti-cuôi veng chức sút tớq vel, dyơ tư Phê-tu yua, ngki Phau-lô têq bôn mot. <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />Phê-tu tông: “Puô A-cri-pa a-lứng nhéq máh i-nha dŏq tớq mu nơi a-lứng top he, i-nha chón bôn hôm ti-cuôi ndô, la ti-cuôi ndon mui top clứng ti-cuôi Isa-ra-el khoiq sŏ́ng mu nơi tar-seq te cư, díh tớq Yaru-salem nha tớq ndô, tông yứng ngki êq dyôn án tu-mống nnáng. <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />Ma cư chom dyơ án khoiq lớiq táq callong a-mớh piaiq ca-chet. Ma, co te ti-cuôi ndô khoiq seq nga puô, iki cư sŏ́ng dông án pôq, <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />ma te án, cư ớq bôn a-mớh lư ar-lớih dŏq tông nga puô. Co iki, cư dông án tớq chứng mát i-nha, a-lứng ŏ lư tớq mát puô, ơi puô A-cri-pa, dŏq ndóng plốh chom ar-náq ndô cơt ar-lớih, cư bôn callong a-mớh ndon cư têq taq-ntêr. <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />Co cư par-ngíh, khán dông mu náq ti-cuôi tôt ma lớiq ca to máh callong luaih chíl liêh án ngki lư la lớiq crái.”<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />Dyơ ngki, puô A-cri-pa tông ada Phau-lô: “Mái têq dŏq taq-ntêr te mái.” Chón ndóng ndô, dyơ ndóng pa-yơ ati ngki, Phau-lô tông:<verse eid="ACT 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 26:2" />“Ơi puô A-cri-pa, co te cứp callong ndon cư ngai tar-cauq te ti-cuôi Isa-ra-el, cư sáng cư lư bui ndóng khoiq bôn ôi bôm chứng mát puô i-ngái ndô, <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />pưt lư la co puô la ti-cuôi khoiq chom nhéq díh máh phep rit a-lứng díh máh ar-náq tar-miên tớq top ti-cuôi Isa-ra-el. Iki cư seq puô chiuq cam-máng cư. <verse eid="ACT 26:3" /><verse number="4" style="v" sid="ACT 26:4" />Lư iki, cứp ti-cuôi Isa-ra-el khoiq chom pang tu-mống na cư te ndóng yôl bánh, cơt te ndóng tôm lư tớq cruông cư a-lứng tớq Yaru-salem, <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />co khoiq chom nsuôi te cư dưnh dyơ, iki khán nha-án bôn mít dŏq taq-ntêr, ngki la cư khoiq tu-mống veng nốh diêiq a-rức lư tớq mot tin na top he, la top Pha-ra-si. <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />Dyơ ngki, cư ta-yứng ndô chiuq tar-sưq la co callong ng-cong te par-nai ưq Yang Arbang Pilŏ́ng khoiq par-ưq ada a-chúc a-chiac na top he, <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />la par-nai ưq ndon mui chít la bar top na top he tớq callong nhéq mít can-nính, át ng-cong dŏq bôn ráp, ndóng sang tám Yang Arbang Pilŏ́ng i-ngái nha i-dáu. Ơi puô, lư co callong ng-cong ngki, cư chón ngai cauq luaih co ti-cuôi Isa-ra-el. <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />Khán Yang Arbang Pilŏ́ng dyôn ti-cuôi cu-chet tu-mống liêh, i-mo callong ngki ngai me la ar-náq lớiq têq náp a-mớh tớq top i-nha? <verse eid="ACT 26:8" /><verse number="9" style="v" sid="ACT 26:9" />Lư iki, cư khoiq át par-ngíh cóq táq a-ưi car-na chíl liêh ada nốh Yê-su Na-sa-ret, <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />la máh ar-náq ndon cư khoiq táq díh tớq Yaru-salem, cư têq dŏq crál a-ưi top tin tớq cŏq ndóng bôn ráp chức sút te máh thới teng rit sang, a-lứng díh ndóng nha-án ngai ca-chet, cư khoiq ca-cháq chớiq sŏ́ng tưi. <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />Ndóng cơi táq nha-án tớq cứp dúng rum, cư khoiq pa-tot nha-án cóq a-craiq, ma co sáng uan nha-án lư tháng, cư ngki khoiq pôq táq nha-án ti-ngôi díh máh vel ti-cuôi tới Isa-ra-el, <verse eid="ACT 26:11" /><verse number="12" style="v" sid="ACT 26:12" />ma tớq máh ar-náq táq ngki, chón ndóng pôq na car-na nga Da-mac co bôn chức sút nha ar-náq te máh thới teng rit sang, <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />puô ơi, ndóng pan-dang tứng, na car-na pôq, cư bôn hôm ang claq te pilŏ́ng, tar-laq clưi te mát pan-dang, ta-bal pa-niar cư nha máh ti-cuôi chón pôq mu nơi a-lớng cư. <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />Ma, tư nhéq náq top he dứm nga cu-teq, cư sáng bôn siêng tu-bau ada cư tớq cang Isa-ra-el: ‘Sau-lơ, Sau-lơ, i-mo mái táq Cư? Lư diêiq a-rức ada mái ndóng búl mot tớq tar-raiq.’ <verse eid="ACT 26:14" /><verse number="15" style="v" sid="ACT 26:15" />Vít ngki, cư ôi: ‘Yang Ơi, I-nha la nnáu?’ Dyơ Yang tông: ‘Cư la Yê-su, Án ndon mái chón át táq. <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />Ma, cóq ta-yứng ada lư tứng tớq cháq mái, co te ar-náq ndô Cư khoiq a-páh ada mái, dŏq a-nát mái táq ar-náq cư nha tíc díh te máh nốh mái khoiq hôm te Cư, nha máh nốh Cư lư a-páh ada mái, <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />ndóng choi mái vít ti-cuôi i-nha a-lứng vít máh ti-cuôi tới Isa-ra-el ma Cư yua mái tớq, <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />dŏq pốh mát nha-án, dyôn têq te callong ngiau tớq nga callong ang, nha vít cơt sol na Yang saq tớq nga Yang Arbang Pilŏ́ng, dŏq nha-án ráp ŏ callong ta-láh luaih lới, a-lứng máh mun te top máh ti-cuôi khoiq cơt práh ŏ co callong tin te Cư.’ <verse eid="ACT 26:18" /><verse number="19" style="v" sid="ACT 26:19" />Co iki, ơi puô A-cri-pa, cư khoiq lớiq peh tớq callong a-páh te pilŏ́ng ngki, <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />ma, nsuôi lư cư khoiq ca to dyôn máh ti-cuôi tớq Da-mac, dyơ díh tớq Yaru-salem, nha chuôp díh vúng Yu-dê, a-lứng ada máh ti-cuôi tới Isa-ra-el, cóq piên lêq nha píh chô nga Yang Arbang Pilŏ́ng, táq máh ar-náq ŏ crái piaiq te mít piên lêq ngki. <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />Co te máh ar-náq ngki, ti-cuôi Isa-ra-el, vít ndóng cŏp cư tớq dúng sang, át si-suô ngê ca-chet cư. <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />Iki, co bôn callong choi mat te Yang Arbang Pilŏ́ng ti-ngôi i-ngái ndô, cư khoiq ta-yứng, ca to par-nai ŏ dyôn ti-cuôi két, nha ti-cuôi pưt, lớiq taq-ntêr a-mớh ndái ta-niêng máh nốh ndon díh top tang ng-cang nha Môi-se khoiq tông la ính cơt tớq, <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />i-mo Yang Choi Ta-mống bôn a-nát chiuq diêiq a-rức, a-lứng co la án tôm lư tớq te callong tu-mống liêh na máh ti-cuôi cu-chet, Án lư ntêr callong ang dyôn ada ti-cuôi top he nha máh ti-cuôi tới Isa-ra-el.”<verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />Dyơ ngki, ndóng án chón át tông na máh par-nai ndô, Phê-tu tông yứng cang: “Mái yúh dyơ, Phau-lô ơi! Ar-náq rian plốh a-ưi tháng táq dyôn mái cơt ti-cuôi yúh.” <verse eid="ACT 26:24" /><verse number="25" style="v" sid="ACT 26:25" />Ma Phau-lô tông: “Cư lớiq yúh a-mớh, ơi a-vốq Phê-tu piaiq dyám náp, ma cư chón ntêr máh par-nai lư ti-nớng a-lứng lư ar-lớih. <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />Co puô chom te máh ar-náq ndô — cư sáng clŏ́q lư ôi ada i-nha — co cư tin ar-lớih ớq bôn callong mmo tớq máh ar-náq ndô têq ca-tốq puô, co te ar-náq ngki lư khoiq lớiq têq táq tớq mui ntúq ngiau ngki. <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />Ơi puô A-cri-pa, puô náp máh ti-cuôi tang ng-cang? Cư chom dyơ puô náp.” <verse eid="ACT 26:27" /><verse number="28" style="v" sid="ACT 26:28" />Ma A-cri-pa ôi Phau-lô: “Mái át ial mít can-nính cư dŏq cơt Ti-cuôi Tin tớq i-ngái kéh lư?” <verse eid="ACT 26:28" /><verse number="29" style="v" sid="ACT 26:29" />Ma Phau-lô ôi: “Ntro la cư seq te Yang Arbang Pilŏ́ng, ntro tớq i-ngái két lớiq la toiq, tới nưm puô, ma yôl díh nhéq máh ti-cuôi sáng cư hoi ndô têq cơt lư mu chứng a-rớq cư chón bôn, nưm máh ntár sic ndô.”<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />Dyơ puô ta-yứng, a-lứng máh ti-cuôi sút, díh Bê-ra-nit nha máh ti-cuôi chón ti-cu a-lớng nha-án, <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />a-lứng vít dyơ pôq, nha-án tang-húng a-lớng tar-tuôq, tông idô: “Ti-cuôi ndô ớq táq a-mớh piaiq ca-chet a-láng crál tớq cŏq.” <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" />Dyơ puô A-cri-pa tông ada Phê-tu: “Ti-cuôi ndô ngki têq dŏq ta-láh, khán án khoiq lớiq seq te Sê-sa.”<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />Chón ngki, ndóng khoiq dŏq a-nát dŏq dyôn top he pôq na dơq ving ca-vang nga I-ta-li, nha-án mŏp díh Phau-lô nha máh ti-cuôi tôt can-nŏ́h dyôn nga mu náq ti-cuôi sút, nốh Yu-lơ, te top líng A-cu-tơ. <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />Ndóng ngki, tư khoiq sớr tớq mui allám tuôc te A-tra-mit, chón ính pôq ti-lớt dơq ving ca-vang tớq máh ntúq tor dơq A-siê, top he khoiq bôn pôq, A-ri-tac, ti-cuôi vel Tê-salô-ni-ca, cruông Ma-sa-dôn át a-lứng top he. <verse eid="ACT 27:2" /><verse number="3" style="v" sid="ACT 27:3" />Dyơ i-ngái ta-tun, top he tớq vel Si-dôn, ma Yu-lơ, co táq ŏ ada Phau-lô lư par-tát tháng, khoiq dyôn án tớq a-lớng máh yớu dŏq têq bôn callong tar-choi na nha-án. <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />Tớq ntúq ngki, ndóng pôq na tuôc, top he dyôn tuôc pôq ntiat con Sip-rơ la co cu-yiêl chón phớt pi-tốq. <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />Ma, vít ndóng pôq pha dơq ving ca-vang tớq tor Si-la-si a-lứng Bam-phu-li, top he khoiq tớq nga Mi-ra, cruông Li-sie. <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />Tớq ngki, co án ndon sút líng tu-múh mui allám tuôc te A-lec-san-tri ính pôq nga I-ta-li, án dông top he sớr tuôc ngki. <verse eid="ACT 27:6" /><verse number="7" style="v" sid="ACT 27:7" />Iki dyơ, chom nsếq i-ngái bôn pôq i-láq nha ndóng khoiq tớq tar-mán Cơ-nit ngki cơt diêiq a-rức lư, co cu-yiêl lớiq dyôn top he tớq tar-mán nnáng, top he khoiq dyôn tuôc ntiat tor con Crêt, pôq ali Sa-môn. <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />Dyơ át pôq pa-niar tor con ngki lư cơt diêiq a-rức, top he pôq tớq mui ntúq ntíh ngai dŏq la Vai-ving, ntúq ndô át tar-mán vel La-sê.<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />Ma co khoiq pít lư a-ưi i-ngái, a-lứng ính pôq sa ngki khoiq cơt a-dáh chol co khoiq vít te ki-sái ót tan-na nhéq dyơ, Phau-lô tông, <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />ndóng tông ada nha-án: “Em ai ơi, cư hôm ar-lớih ar-náq pôq ndô par-ngíh lư tu-múh te pít mat nha a-ưi pít sớng, lớiq nưm te crơng-crớu a-lứng tuôc, ma yôl tar-ngứh na top he hơ.” <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />Ma ti-cuôi ndon sút líng náp par-nai co án dông tuôc nha án ưlla tuôc hơn la máh par-nai te Phau-lô taq-ntêr. <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />Ma, co dơq vai-ving ngki diêiq lư pa-chít tớq ki-sái ng-ngiat, cứp náq khoiq dyơ tang-húng ngốh viang te ntúq ndô, khán lớiq chom táq i-mo, nha-án têq ính pôq nga vel Phê-nit, mui vai-ving tớq Crêt, ngốh a-nga pa ta-niêng a-lứng a-nga mát pan-dang pát, dŏq a-ngô tớq ki-sái ng-ngiat. <verse eid="ACT 27:12" /><verse number="13" style="v" sid="ACT 27:13" />Chón ngki, ndóng cu-yiêl phớt i-láq, co par-ngíh khoiq têq bôn pôq, iki ndóng a-sớr calléh, nha-án dyôn tuôc pôq piar tor, ntiat con Crêt. <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />Ma lớiq bôn dưnh ngki, bôn cu-yiêl ar-puq ngai dŏq la Era-kilon te con phớt pi-tốq. <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />Dyơ ngki, ndóng tuôc cơt cu-yiêl dông a-lứng lớiq têq chíl liêh a-lớng cu-yiêl ngki nnáng, iki ndóng dyơ táh, top he cơt dông viang. <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />Ma ndóng lu-long pôq nga cu-yiêl phớt na mui con ntíh ngai dŏq la Co-da, ngki diêiq a-rức lư top he náq têq bôn lúq a-sớr mui allám tuôc két, <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />la nốh ma ndóng khoiq lúq a-sớr, nha-án ial máh pa-nuar, chóq cháq tuôc ada khớm. Ma, co a-dáh, piaiq lơ têq trang tớq Sip-tơ, ki ndóng khoiq a-pŏ́ng calléh ngki, nha-án dyôn cu-yiêl dông sớng. <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />Ma ndóng top he cu-yiêl phớt táq par-sáng par-saiq, ngki tớq i-ngái ta-tun, nha-án ta-bớq a-pŏ́ng crơng nga dơq ving ca-vang dyôn ng-hiêl tuôc. <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />Ang i-ngái chư pe, nha-án tớq ati a-pŏ́ng nga dơq ving ca-vang máh crơng ca-nor tớq tuôc. <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />Dyơ ngki, chón ndóng ớq bôn mát pan-dang nha ớq bôn máh pan-tôr khoiq a-ưi i-ngái, ma cu-yiêl ar-puq lớiq két yôl táq diêiq a-rức top he, nhéq díh callong ng-cong yôl liêh dyôn têq top he bôn tu-mống khoiq cơt pít nhéq. <verse eid="ACT 27:20" /><verse number="21" style="v" sid="ACT 27:21" />Dyơ khoiq tu-múh nsếq i-ngái dưnh ớq chi-cha, ngki Phau-lô, ndóng ta-yứng tớq pan-di nha-án, khoiq tông:</para>
  <para style="p" vid="ACT 27:21">“Ơi em ai, piaiq lư khán khoiq cam-máng cư êq ngốh te Crêt, ngki khoiq têq viar pít mat a-lớng pít sớng ndô. <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />Hoi ndô, cư tông i-nha cóq êq a-dáh, co lư ớq bôn nnáu cu-chet a-mớh te top i-nha, ma pít nưm náq tuôc ndô sớng. <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />Co i-dáu ndô, bôn tar-neng te Yang Arbang Pilŏ́ng, Án ndon cư ưlla a-lứng la Án cư sang tám, khoiq ta-yứng mu pa cư, <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />tông: ‘Phau-lô, êq a-dáh. Mái cóq pôq tu-múh nsuôi Sê-sa, iki áu me ntíh, co mít sruiq Yang Arbang Pilŏ́ng khoiq dyôn ada mái cứp ti-cuôi chón pôq tớq tuôc ndô mu nơi a-lớng mái.’ <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />Co iki, em ai ơi, cóq khớm mít! Co cư tin te Yang Arbang Pilŏ́ng, i-mo máh ar-náq lư cơt ngki, veng a-rớq khoiq dŏq ntêr ada cư. <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />Ma top he cóq trang liêh tớq mui allám con mmo.”<verse eid="ACT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />Hoi ngki, ndóng tớq i-dáu chư mui chít la puan, chón ndóng top he yôl át pi-tứng pi-tốq tớq dơq ving ca-vang A-triê-tic, ali tar-di i-dáu, ti-cuôi dông tuôc par-ngíh nha-án chón tar-mán tớq mui ntúq cu-teq mmo. <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />Tư ndóng táh ntár chuô, nha-án chom sru bar chít a-chớng, dyơ pôq loi mui biq yông hơn, a-lứng liêh táh ntár chuô, nha-án chom yôl mui chít la sông a-chớng. <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />Ma, co a-dáh, lớiq chom top he têq cláh clúh nga búl ntúq mmo, iki ndóng khoiq a-pŏ́ng puan calléh te ntúq soi tuôc a-siar, nha-án cớu níc díh pilŏ́ng ang. <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />Ma tư máh ti-cuôi dông tuôc suô car-na ính lúh te tuôc a-lứng dyôn a-pŏ́ng tuôc két tớq dơq ving ca-vang, táq náh nnan a-rớq ính pôq a-pŏ́ng calléh te tuôc, <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />Phau-lô tông ada ti-cuôi sút líng a-lứng máh top líng: “Khán máh ti-cuôi ndô lớiq át liêh tớq tuôc, top i-nha lư lớiq bôn tu-mống.” <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />Iki lư top líng kít pa-nuar tuôc két dyơ dyôn án lu-long viang. <verse eid="ACT 27:32" /><verse number="33" style="v" sid="ACT 27:33" />Chón ngki, ti-ngôi díh pilŏ́ng tu-mán ính ang lư, Phau-lô yua cứp náq cóq cha biq tan-na, idô: “Ndóng chón át pớn díh i-ngái ndô, i-ngái chư mu chít la puan, i-nha yôl át ót tan-na, lớiq ính cha a-mớh. <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />Iki, cư seq i-nha cóq cha biq tan-na, co callong ngki la dŏq dyôn têq tu-mống i-nha. Co ớq nnáu te i-nha lư pít mui ntráih sóc tớq plô.” <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />Dyơ, ndóng khoiq tông iki a-lứng ial beng ngki, án si-ơn Yang Arbang Pilŏ́ng chứng mát cứp náq, dyơ vít péq beng ngki, án ta-bớq cha. <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />Dyơ ndóng cứp náq bôn callong a-liam, ngki lư nha-án khoiq cha tan-na. <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />Chón ngki, top he bôn nhéq tưh bar cu-lám tu-pul chít tu-pát náq tớq tuôc. <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />A-lứng dyơ, ndóng khoiq sái te tan-na ngki, nha-án táq ng-hiêl tuôc, na a-pŏ́ng sro nga dơq ving ca-vang. <verse eid="ACT 27:38" /><verse number="39" style="v" sid="ACT 27:39" />Chón ngki ndóng pilŏ́ng khoiq ang, nha-án lớiq a-cớl ntúq cu-teq ngki, ma nha-án hôm mui ntúq vai-ving ntíh bôn tor dơq ving ca-vang, la ntúq ma nha-án tang-húng me têq a-vih tuôc mot lớiq. <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />Kít táh pa-nuar calléh dyơ, nha-án dŏq liêh pưn dơq ving ca-vang. Ma, vít ndóng lếh pa-nuar pil par-vih a-lứng yáng prới tớq plô tuôc, ngki veng car-na cu-yiêl, nha-án táq dyôn tuôc pôq ti-nớng nga tor dơq ving ca-vang. <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />Ma ndóng pôq lớiq crái ntúq bar a-nga dơq tar-múh mu nơi tuôc cál tớq chuah, a-lứng co plô tuôc cál tớq ngki, tuôc lớiq táq ar-to a-mớh nnáng, ma soi tuôc ngki cơt pi-cháh co dơq hớp. <verse eid="ACT 27:41" /><verse number="42" style="v" sid="ACT 27:42" />Ndóng ngki, par-ngíh na top líng la táq i-mo dŏq nha-án ca-chet máh ti-cuôi tôt, dáh lơ án ndon bôn tar-cláh co nhơ póng lúh. <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />Ma co án ính choi Phau-lô, ti-cuôi sút líng khoiq ca-táng ar-náq na nha-án, ma án yua ada máh ti-cuôi chom póng nsuôi lư tam-póng te tuôc dŏq póng nga tor, <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />nha máh ti-cuôi yôl liêh, nsếq náq ndô kéu tớq máh mêng pan, ma máh ti-cuôi ntíh ial máh nốh can-nŏ́h te tuôc, dyơ veng a-rớq ngki, ar-náq cơt tớq dyôn nhéq náq top he la têq dông nga tor lớiq bôn chol.<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />Ndóng bôn iên ŏ dyơ, ki ndóng ngki top he bôn hôm ar-lớih con ndô ngai dŏq la Mal-ta. <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />Ma, ti-cuôi át tớq ngki sáng srui-táq top he callong pa-tát ndái lớng, co nha-án khoiq ráp chom nhéq náq top he na a-chúq uih co bôn bo chón tớq nha co ng-ngiat. <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />Ma ndóng Phau-lô khoiq pa-chúng bôn mui mpual uih dyơ a-chúq tớq uih, ngki mui allám cu-sánh tar-lúng, ndóng ngốh te ntúq a-tóq, khoiq pial riq ati án. <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />Dyơ ngki, ndóng ti-cuôi tớq con ngki bôn hôm cu-sánh pial tớq ati án, nha-án ntêr a-lớng tar-tuôq: “Ti-cuôi ndô lư ar-lớih la nốh ca-chet ti-cuôi, la án ndon ntro khoiq choi te dơq ving ca-vang, callong ti-nớng lớiq dyôn tu-mống.” <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />Vít ngki, tư khoiq ng-cráih cu-sánh nga uih, án khoiq lớiq bôn táq chol a-mớh. <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />Ma, nha-án yôl par-ngíh án khoiq cơt áih lớiq la ti-cớr dứm cu-chet. Ma tư nha-án át me dưnh lư a-lứng hôm lớiq bôn a-mớh ndái tớq nga án, dyơ ngki piên par-ngíh, nha-án tông án la yang.<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />Ndóng ngki, át pa-niar ntúq ngki la tám cu-teq na ti-cuôi sút con ngki, nốh Pup-liu, án pa-sôl top he, khoiq a-ngốh crơng cha car-siat lư nhéq pe i-ngái. <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />Dyơ ngki, ar-náq cơt ngki la a-ám na Pup-liu chón bíq a-ái cớng tớq ki-chơng co a-ái a-tóq a-lứng a-ái a-dyáiq, Phau-lô, ndóng pôq mot me án a-lứng cớu seq, dŏq ati tớq án, khoiq pa-lai bánh ada án. <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />Dyơ, ndóng nhéq ar-náq ngki cơt tớq, máh ti-cuôi can-nŏ́h tớq con ngki bôn a-ái la tớq a-lứng bôn pa-lai bánh, <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />ma nha-án lư khoiq dyám náp top he te callong dyám náp lư pưt, díh chón ndóng ngốh te con, nha-án thuan a-ưi crơng dyôn ada par-ngíh ính na top he.<verse eid="ACT 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />Dyơ ngki, vít pe ki-sái, top he ta-bớq pôq na mui allám tuôc dŏq ta-ran ar-maiq Pir-par, te A-lec-san-tri, khoiq adu ng-ngiat tuôc tớq con ngki. <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />Tư tớq nga vel Su-ra-cu-sơ, top he át tớq ngki pe i-ngái. <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />Te ngki ngốh na tuôc, top he pôq nga Rêc-yum, dyơ mui i-ngái ta-tun, co cu-yiêl te lam-loi phớt, top he khoiq tớq nga Pu-ti-u-li i-ngái ta-tun ngki, <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />ngki la ntúq ma ndóng tar-múh máh em ai, top he khoiq yua át liêh a-lớng nha-án tớq tu-pul i-ngái, nha co iki, top he pôq nga Rô-ma. <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />Te ngki, ndóng sáng hanh te top he, máh em ai khoiq pôq cớiq ính tar-múh a-lớng top he díh ntúq Par-lới vel Ap-piu nha Ntúq A-ngô, tư bôn hôm nha-án, Phau-lô khoiq bôn mít clŏ́q, si-ơn Yang Arbang Pilŏ́ng.<verse eid="ACT 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16" />Dyơ ngki, ndóng top he khoiq mot tớq vel Rô-ma, Phau-lô têq át mmar nưm án a-lứng mu náq líng kiaq me án.<verse eid="ACT 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />Dyơ, ar-náq khoiq cơt vít pe i-ngái ngki la án arô top i-nha la máh ti-cuôi sút top ti-cuôi Isa-ra-el lư tớq. Dyơ ndóng nha-án khoiq par-chúng, án tông ada nha-án: “Em ai ơi, top i-nha, ntro lớiq táq a-mớh chíl liêh máh ti-cuôi prái lớiq la phep rit na tŏ́ng toiq top he, ma te Yaru-salem cư khoiq ngai cŏp a-rớq ti-cuôi tôt tớq ati ti-cuôi Rô-ma, <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />ma lư nha-án, vít ndóng plốh cư, ính ta-láh cư co ớq bôn mui luaih piaiq ca-chet mmo tớq te cư. <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />Ma co ti-cuôi Isa-ra-el lớiq ính ta-láh, iki cư cóq seq nga Sê-sa — chón ndóng ớq bôn par-ngíh tar-cauq cruông bôm. <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />Iki, co te ar-náq ngki, cư khoiq arô top i-nha tớq, dŏq tar-múh a-lứng taq-ntêr. Co te callong ng-cong na ti-cuôi Isa-ra-el, ma cư át chiuq chóq tớq sic ndô.” <verse eid="ACT 28:20" /><verse number="21" style="v" sid="ACT 28:21" />Ma, nha-án tông ada án: “Top he i-yốh bôn ráp chớiq a-mớh te mái tớq Yu-dê, nha i-yốh bôn em ai mmo tớq ntêr lớiq la tông nhéq máh callong saq a-mớh te mái. <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />Ma top he lư tar-náp dŏq cam-máng te mái nốh a-mớh mái par-ngíh, co te ti-cuôi tin ndô, callong têq chom tớq ntúq top he ngki la án cơt ngai chíl liêh chuôp ntúq.”<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />Dyơ ngki, ndóng a-nát i-ngái ada án, ki clứng ti-cuôi khoiq rôp nga án tớq ntúq át na án, ma te i-láih ti-ngôi díh i-bư, án taq-ntêr a-lớng nha-án, ndon dŏq taq-ntêr te cruông Yang Arbang Pilŏ́ng, lư díh tông dyôn nha-án chom te Yang Yê-su díh phep rit Môi-se nha top tang ng-cang. <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />Ma bôn ti-cuôi ndon ráp tin máh par-nai bôn taq-ntêr, ma bôn ti-cuôi ndon ngki lớiq tin. <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />Dyơ ngki, ndóng bôn callong lớiq sŏ́ng a-lứng tar-tuôq, nha-án ngốh viang ndóng Phau-lô tông mui callong, idô: “Na tang ng-cang Ê-sai, Yang Ar-vai khoiq tông piaiq lư ada a-chúc a-chiac na top i-nha, <verse eid="ACT 28:25" /><verse number="26" style="v" sid="ACT 28:26" />idô: ‘Cóq pôq nga ti-cuôi ndô a-lứng tông:</para>
  <para style="q1" vid="ACT 28:26">“Ndóng cam-máng, i-nha lư bôn sáng, ma i-nha lư ar-lớih lớiq a-púh,</para>
  <para style="q1" vid="ACT 28:26">a-lứng ndóng me, i-nha lư hôm, ma i-nha lư ar-lớih lớiq chom a-mớh.”<verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />Co mít ti-cuôi ndô khoiq cơt cớng,</para>
  <para style="q1" vid="ACT 28:27">cu-tor nha-án a-rớq lớiq sáng,</para>
  <para style="q1" vid="ACT 28:27">a-lứng mát nha-án ngki ca-sot viang,</para>
  <para style="q1" vid="ACT 28:27">dáh lơ mui i-ngái mmo, nha-án têq hôm na mát,</para>
  <para style="q1" vid="ACT 28:27">têq sáng na cu-tor, a-lứng têq a-púh na mít can-nính,</para>
  <para style="q1" vid="ACT 28:27">dyơ nha-án píh liêh,</para>
  <para style="q1" vid="ACT 28:27">a-lứng Cư lư pa-lai bánh ada nha-án.’<verse eid="ACT 28:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="ACT 28:28" />Co iki, callong chom cóq bôn te i-nha, ngki la callong choi ta-mống ndô na Yang Arbang Pilŏ́ng khoiq bôn ca to ada máh ti-cuôi tới Isa-ra-el, dyơ nha-án lư cam-máng.” <verse eid="ACT 28:28" /><verse number="29" style="v" sid="ACT 28:29" />[Ndóng án tông dyơ máh par-nai ngki, máh ti-cuôi Isa-ra-el ngốh chô, bôn callong tar-miên pưt lư tớq top nha-án.]<verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />Dyơ ngki, án át piaiq bar cu-mo tớq láng dúng chang na án, a-lứng pa-sôl ŏ nhéq tưh máh ti-cuôi pôq mu nơi a-lứng án, <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />ndóng pau ntêr te cruông Yang Arbang Pilŏ́ng a-lứng ca to máh par-nai ŏ te Yang, la Yang Choi Ta-mống Yê-su, a-lứng nhéq te mít can-nính, lớiq tu-múh diêiq a-rức.<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>