  <book code="2TI" style="id">EN_PCLT pac_Pacoh_ltr Fri May 22 2026 10:55:44 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">2 Timothy</para>
  <para style="toc1">Chớiq A-lang Ti-mu-thê Bar</para>
  <para style="toc2">Ti-mu-thê Bar</para>
  <para style="toc3">2Ti</para>
  <para style="mt">Ti-mu-thê Bar</para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />Phau-lô, dyưng ati na Yang Choi Ta-mống Yê-su co can-nính na Yang Arbang Pilŏ́ng, veng par-nai par-ưq te callong tu-mống tớq Yang Choi Ta-mống Yê-su, <verse eid="2TI 1:1" /><verse number="2" style="v" sid="2TI 1:2" />cơiq dyôn Ti-mu-thê, a-cái par-láng lư: callong choi mat, callong sruiq táq callong iên ŏ te Yang Arbang Pilŏ́ng, A-ám a-lớng Yang Choi Ta-mống Yê-su, Yang top he.<verse eid="2TI 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />Cư mŏp par-nai si-ơn Yang Arbang Pilŏ́ng, Án ndon cư táq ar-náq mu chứng a-rớq máh a-chúc a-chiac, te mít can-nính práh ŏ, díh i-dáu i-ngái cư lớiq clớiq ayư níc mái te máh par-nai cớu seq na cư, <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />ính lư tar-múh mái, ayư níc dơq mát mái, dŏq cư bôn máng callong bui, <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" />co bôn callong ca-tớih te callong tin lư ti-nớng tớq mái, callong tin nsuôi lư át tớq Lô-it, a-yáq mái, dyơ Ơ-nit, a-i mái, cư chom ar-lớih callong tin ngki lư yôl át tớq mái.<verse eid="2TI 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 1:6" />Ma co te ar-náq ngki, cư ca-tớih mái cóq ca-pol khớm máh nốh te Yang Arbang Pilŏ́ng ndon nốh át tớq mái co callong ca-pơiq ati na cư. <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />Co Yang Arbang Pilŏ́ng lớiq bôn dyôn top he mít na callong callaq, ma la na mít clŏ́q, na callong ar-moih a-lứng bán ŏ cháq bôm. <verse eid="2TI 1:7" /><verse number="8" style="v" sid="2TI 1:8" />Iki, mái êq a-chiêt te ar-náq taq-ntêr dyôn Yang top he, a-lứng êq a-chiêt te cư, ti-cuôi tôt na Án, ma lư, cóq chiuq diêiq a-rức co Par-nai ŏ Yang, nhơ chức sút te Yang Arbang Pilŏ́ng, <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />Án khoiq choi ta-mống top he a-lứng arô top he na callong arô práh ŏ, tới a-rớq ar-náq táq na top he, ma a-rớq ar-náq mmar na Án a-lứng callong choi mat, la nốh khoiq dyôn ada top he te Yang Choi Ta-mống Yê-su te ndóng i-yốh teng pilŏ́ng cu-teq, <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />ma hoi ndô khoiq dŏq a-páh te callong mpáh na Yang Choi Ta-mống top he, Yang Choi Ta-mống Yê-su, ndóng táq dyôn callong cu-chet cơt lớiq cu-chet ma a-páh callong tu-mống a-lứng lớiq têq pít na Par-nai ŏ Yang, <verse eid="2TI 1:10" /><verse number="11" style="v" sid="2TI 1:11" />co Par-nai ŏ ngki ma cư khoiq dŏq a-nát la ti-cuôi pau ntêr, dyưng ati, a-lớng cơt thới, <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />a-lứng co te ar-náq ngki ndon cư chiuq diêiq a-rức máh ar-náq ndô. Ma cư lớiq sáng a-chiêt co cư chom Án ndon cư tin a-lớng cư chom ar-lớih Án bôn chức bán kiaq callong tin na cư díh tớq i-ngái ngki.<verse eid="2TI 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 1:13" />Mái cóq kéu khớm cơt ngôl te máh par-nai ca to crái piaiq ndon mái khoiq sáng te cư, a-lứng callong tin nha callong ar-moih tớq Yang Choi Ta-mống Yê-su. <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />Cóq ca-pol khớm máh par-nai ŏ nhơ Yang Ar-vai, ngki Án tu-mống tớq top he.<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />Mái chom ar-náq ndô, ngki la nhéq tưh máh ti-cuôi tớq A-si khoiq ca-lôih te cư, ma tớq ngki bôn Phi-gen nha Het-mô-gen.<verse eid="2TI 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 1:16" />Seq Yang dyôn callong sruiq táq ada dúng Ô-nê-si-phô-rơ, co án át a-chưng cư a-lứng lớiq a-chiêt te át tôt na cư, <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />ma, ndóng át tớq Rô-ma, mái khoiq nhéq mít can-nính át plốh te cư a-lứng khoiq bôn tu-múh. <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />Seq Yang choi dyôn ada mái dŏq bôn tu-múh callong sruiq táq tớq te Án tớq i-ngái ngki. Ma mái chom ar-lớih án khoiq táq ar-náq a-ưi i-mo tớq Ê-phê-sô.<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />Iki, a-cái cư ơi, mái cóq táq dyôn mái práih bánh tớq callong choi mat te Yang Choi Ta-mống Yê-su. <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />Ma callong mái khoiq sáng te cư chứng mát ti-cuôi clứng, cóq mŏp callong ngki dyôn máh ti-cuôi lư ti-nớng ma nha-án ngki lư hôi dŏq ca to ti-cuôi can-nŏ́h. <verse eid="2TI 2:2" /><verse number="3" style="v" sid="2TI 2:3" />Cóq chiuq diêiq a-rức, a-rớq mu náq líng hôi na Yang Choi Ta-mống Yê-su. <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />Ndóng cơt líng, ớq nnáu táq dyôn án par-ngíh nnáng máh ar-náq na pang tu-mống ti-cuôi prái, dŏq líng ngki têq táq bui mít ti-cuôi ndon khoiq rêh dyôn cơt líng án. <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />Mu chứng ngki, ndóng ti-cuôi ndon ính ta-lúh tam-pring, ti-cuôi ngki lư lớiq têq bôn ráp cống khán lớiq táq veng rit dŏq a-nát. <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />Ti-cuôi ndon mmín táq ar-náq piaiq lư ráp cống tar-náp nsuôi lư. <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />Cóq par-ngíh callong cư chón tông, co Yang lư tốq dyôn mái chom ar-lớih tớq cứp ar-náq.<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />Cóq ayư Yang Choi Ta-mống Yê-su, khoiq bôn tu-mống liêh te cu-chet, tớq tŏ́ng toiq Da-vit, mu chứng a-rớq Par-nai ŏ Yang na cư, <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />co Par-nai ŏ Yang ngki, cư chiuq diêiq tar-lúh ngai chóq a-rớq mu náq ti-cuôi luaih. Ma, par-nai Yang Arbang Pilŏ́ng ngki lớiq têq chóq a-mớh. <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />Co iki, cư chiuq cứp nốh co máh ti-cuôi ndon khoiq rêh, dŏq nha-án lư têq bôn callong choi tu-mống tớq Yang Choi Ta-mống Yê-su, a-lứng ang ưr díh sút pang.<verse eid="2TI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 2:11" />Par-nai ndô lư piaiq náp ial:</para>
  <para style="q1" vid="2TI 2:11">“Co khán top he khoiq cu-chet a-lớng Án, top he ngki lư tu-mống a-lớng Án.<verse eid="2TI 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12" />Khán top he rap chiuq ta-nhir, top he ngki lư cơt sút a-lớng Án.</para>
  <para style="q1" vid="2TI 2:12">Khán top he ca-lôih Án, Án ngki lư ca-lôih top he.<verse eid="2TI 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13" />Khán top he lớiq ti-nớng, Án lư ti-nớng,</para>
  <para style="q1" vid="2TI 2:13">co Án lớiq têq ngki ca-lôih bôm.”<verse eid="2TI 2:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="2TI 2:14" />Cóq ca-tớih tông máh top tin te callong ngki, ndóng tông ca to nha-án chứng mát Yang Arbang Pilŏ́ng dŏq êq tar-miên te par-nai taq-ntêr, co lớiq tar-náp a-mớh, nưm táq dyôn cơt rúng ada ti-cuôi cam-máng. <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />Cóq táq nhéq tar-ngứh tar-hơ dŏq a-páh lư nưm mái a-rớq ti-cuôi crái piaiq chứng mát Yang Arbang pilŏ́ng, mu náq ti-cuôi táq ar-náq lớiq sáng a-chiêt, ca to ti-nớng lư par-nai piaiq. <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />Ma, cóq viar máh par-nai taq-ntêr ớq cơt callong, co par-nai ngki dông a-tớq nga ntúq lớiq dyám a-cán ta-niêng, <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />a-lứng par-nai ntêr na máh ti-cuôi ngki lư cơt rứh a-rớq bác rơiq pơh lư, ma te top ngki la Hi-mê-nê nha Phi-lêt, <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />máh ti-cuôi ndon pôq lớiq crái te callong piaiq, ndóng ntêr callong tu-mống liêh khoiq cơt dyơ, a-lứng nha-án chón ta-lóh callong tin na cứp náq ti-cuôi. <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />Ma, a-rớq ta-nang dúng na Yang Arbang Pilŏ́ng khoiq khớm lư, ndóng bôn par-nai ta-ran ndô: “Yang chom máh ti-cuôi ưlla na Án” a-lứng “Ti-cuôi mmo cớu seq nốh Yang cóq viar yông te ar-náq saq.”<verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />Ma, tớq mui lám dúng pưt, lớiq nưm bôn yáng tớq dyeng lớiq la práq, ma bôn tớq a-long lớiq la cu-teq triêq, bôn nốh dŏq dyôn ar-náq tar-náp, bôn nốh can-nŏ́h ngki dyôn ar-náq lớiq tar-náp. <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />Iki, khán nnáu táq dyôn práh án te máh ar-náq ngki, ti-cuôi ngki la a-rớq yáng dŏq dyôn ar-náq tar-náp, khoiq dŏq mmar dyơ, tar-náp ada Ưlla, khoiq ti-ráp dŏq dyôn cứp ar-náq ŏ.<verse eid="2TI 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22" />Cóq viar dyôn vít máh ar-náq saq báq táq na ti-cuôi bánh, ma tar-veng callong ti-nớng tu-pứng, callong tin, callong ar-moih, callong ar-toi a-lớng máh ti-cuôi cớu seq Yang na mít can-nính práh ŏ. <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />Ma cóq ca-lôih máh par-nai lớiq tar-náp a-lứng a-chơ, co chom ar-lớih ar-náq ngki táq dyôn tar-luaih. <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />Ti-cuôi sol na Yang cóq êq tar-luaih, ma cóq lam-bŏt ada cứp náq ti-cuôi, cóq hôi ca to, chiuq ta-nhir, <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />ndóng ca to máh ti-cuôi ính chíl liêh án cóq bôn mít lam-mŏr, dáh lơ Yang Arbang Pilŏ́ng choi dyôn nha-án piên lêq mít tam-me dŏq têq chom a-púh callong piaiq, <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />a-lứng nha-án têq viar vít te pang-cát na yang sáq, cua dyơ án cŏp dŏq táq veng can-nính án.<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />Ma mái cóq chom callong ndô, ngki la tớq máh i-ngái talloiq, lư cơt tớq máh i-ngái diêiq a-rức. <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />Co ngai lư ial can-nính bôm, ham tiên práq, cu-hống, a-sớr cháq, a-craiq, lớiq peh par-nai a-ám a-i, lớiq chom ơn, lớiq dyám náp, <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />ớq callong ar-moih, lớiq cơt ar-toi, báq ntêr saq, ton a-pít, bôn mít háng, lớiq ính callong ŏ, <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />báq cu-liêu, táq yuh-yúh, pu-pưt, ính ar-náq par-lơ hơn a-moih Yang Arbang Pilŏ́ng, <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />lư dêu ar-mo dyám náp yang, ki ma lớiq bôn ráp te chức sút callong dyám náp ngki. Cóq viar yông máh ti-cuôi ngki.<verse eid="2TI 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 3:6" />Co tớq top nha-án la máh ti-cuôi mot nga dúng, cŏp máh ngai ng-cán a-chơ, pớnh máng callong luaih, dŏq par-yông co cứp nốh ính bôn, <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />rian níc ma lư lớiq têq tớq nga ntúq têq chom callong piaiq. <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />Yan-net nha Yam-be khoiq chíl liêh Môi-se cơt i-mo, ngki máh ti-cuôi ndô lư chíl liêh callong piaiq iki tưi, top ti-cuôi ngki la máh ti-cuôi bôn mít can-nính khoiq lới, la máh ti-cuôi táq náh nnan te callong tin. <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />Ma nha-án lư lớiq têq ta-lóh a-ưi nnáng, co callong a-chơ na nha-án lư mpáh ar-lớih chứng mát ti-cuôi, mu chứng a-rớq callong a-chơ na bar náq ntíh khoiq mpáh.<verse eid="2TI 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />Ma mái khoiq náp ial par-nai ca to, callong tu-mống, par-ngíh, callong tin, mít chiuq diêiq a-rức, callong ar-moih, callong chiuq ta-nhir na cư, <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" />te ar-náq ngai táq, máh diêiq a-rức a-rớq khoiq tớq ada cư tớq An-ti-ôt, tớq I-cô-ni, tớq Lit-trơ a-ưi callong ngai táq cư khoiq ta-nhir. A-lứng Yang khoiq choi ta-léh cư vít nhéq diêiq a-rức ngki. <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />Ma lư, nhéq máh ti-cuôi ính tu-mống veng ngê yang tớq Yang Choi Ta-mống Yê-su ngki cóq chiuq ngai táq. <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />Ma top ti-cuôi lới a-lớng ti-cuôi táq náh nnan lư cứp i-ngái cơt saq pi-lư, pi-lốh ngai dyơ ngai pi-lốh liêh. <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />Ma, mái cóq át tớq máh nốh ndon mái khoiq rian a-lứng tin, co chom mái khoiq rian máh nốh ngki te nnáu, <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />a-lứng chón ndóng yôl két, mái khoiq rian chom Tám U-ráq Yang, táq dyôn mái tu-báiq dŏq bôn callong choi ta-mống co callong tin tớq Yang Choi Ta-mống Yê-su.<verse eid="2TI 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 3:16" />Tớq Tám U-ráq la tớq te Yang Arbang Pilŏ́ng, ngki la tar-náp dyôn ar-náq ca to, ính tíq, ính ca-tớih tông, pa-soi tớq callong ti-nớng tu-pứng, <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />dŏq ti-cuôi na Yang Arbang Pilŏ́ng têq cơt hôi, khoiq suan cứp dyôn máh ar-náq ŏ.<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />Cư pa-táp ca to mái chứng mát Yang Arbang Pilŏ́ng nha Yang Choi Ta-mống Yê-su, Án lư tar-sưq ti-cuôi tu-mống díh ti-cuôi cu-chet, co callong ính tớq na Án a-lứng cruông Án: <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />Cóq pau ntêr Par-nai Yang; cóq tam-prán, ntro piaiq i-ngái a-láng lớiq piaiq i-ngái; cóq dyŏq, tông ca-tớih, khêr, a-lứng cóq bôn mít lot ndóng ca to. <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />Co lư tớq tư ndóng ngai lư lớiq ính cam-máng par-nai ŏ. Ma lư, nha-án suô pa-chúng ada nha-án máh thới veng can-nính ính na nha-án, táq dyôn lê hóng cu-tor, <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />dyơ lư lớiq nưm ca-pát cu-tor te callong piaiq, ma pi-líh cam-máng máh par-nai nsuar. <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />Ma mái cóq ada práih tớq cứp ar-náq. Cóq chiuq ta-nhir diêiq a-rức. Cóq táq máh ar-náq na ti-cuôi pau ntêr Par-nai ŏ Yang. Cóq táq dyôn cua ar-náq na mái.<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />Ma cư ngki a-rớq crơng ngai mŏp sang dyơ, nha i-ngái nhéq pang tu-mống na cư khoiq tar-mán. <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />Cư khoiq tar-chíl tớq callong tar-chíl ŏ; cư khoiq táq cua ar-náq tam-pring ta-lúh; cư khoiq ca-pol khớm callong tin. <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />Hoi ndô, cống ti-nớng tu-pứng khoiq suan dŏq ada cư, la cống ma Yang, Ndon Tar-sưq ti-nớng, lư dyôn cống ada cư tớq i-ngái ngki, ma tới nưm náq ada cư, ma dyôn nhéq tưh máh ti-cuôi a-moih callong tớq liêh na Án.<verse eid="2TI 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />Cóq pa-nhaq dŏq cláih tớq tar-múh cư, <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" />co Dê-ma khoiq táh cư, ính veng ngê pang ndô, dyơ án pôq nga Tê-salô-ni-ca. Cơ-rêt-sên pôq nga Ca-la-ti, Ti-tô pôq nga Da-ma-ti. <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" />Nưm yôl Lu-ca át a-lớng cư. Ndóng cớiq Mac, cóq dông án mu nơi a-lứng mái co án têq choi dyôn cư tớq ar-náq táq. <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" />Cư yua Ti-chi-cơ pôq nga Ê-phê-sô. <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" />Ndóng pôq, mái cóq dông pláh au thor ndon cư dŏq tớq ntúq Ca-but tớq vel Trô-at, mu nơi a-lứng máh u-ráq, lư la máh u-ráq ng-cár.<verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />Thơq ti-téh A-lec-san-dơ khoiq táq diêiq a-rức cư a-ưi lư. Yang lư cu-liêh cống án veng máh ar-náq táq na án, <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />la án ndon mái ngki cóq me a-ŏ, co án ính lư ca-táng par-nai ca to na top he. <verse eid="2TI 4:15" /><verse number="16" style="v" sid="2TI 4:16" />Ndóng chư ngai sưq nsuôi lư na cư, ớq nnáu tớq tar-choi cư, ma nhéq náq lư táh cư. Seq luaih ngki êq náp tớq nha-án. <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />Ma Yang khoiq ta-yứng pa cư a-lứng táq dyôn cư bánh rêng, dŏq na cư, ar-náq pau ntêr Par-nai ŏ Yang bôn táq cua, a-lứng nhéq ti-cuôi tới Isa-ra-el têq bôn sáng. Cư lư khoiq tar-cláh te ng-cang cu-la. <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />Yang lư choi ta-mống cư te cứp ar-náq saq a-lứng lư dyôn cư át tớq cruông sút na Án. Seq callong ang ưr ưlla te Án ti-ngôi díh sút pang, lang dơi. A-men.<verse eid="2TI 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />Cóq car-bánh car-suanh Ba-rit-sin nha A-cui-la, a-lứng díh dúng Ô-nê-si-phô-rơ. <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" />Ê-rat át liêh tớq Cô-rin-tô, ma Trô-phim co a-ái án át liêh tớq Mi-lê. <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />Cóq ca-tóng tớq nsuôi ki-sái ngiat. Ơ-bu-lu, a-lứng Bu-đen, Li-nut, Cơ-lau-diê, nha máh em ai cơiq par-nai car-bánh mái.<verse eid="2TI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />Yang át tớq mít can-nính mái. Seq callong choi mat át a-lớng top i-nha.<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>