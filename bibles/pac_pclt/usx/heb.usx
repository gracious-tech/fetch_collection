  <book code="HEB" style="id">EN_PCLT pac_Pacoh_ltr Mon Apr 20 2026 15:35:30 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Hebrews</para>
  <para style="toc1">Chớiq A-lang Hê-brơ</para>
  <para style="toc2">Hê-brơ</para>
  <para style="toc3">Heb</para>
  <para style="mt">Hê-brơ</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />Tớq a-ưi chư a-lứng a-ưi nốh te i-nớh, vít dyơ Yang Arbang Pilŏ́ng tông ada top a-chúc a-chiac nhơ máh ti-cuôi tang ng-cang, <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />tớq máh i-ngái talloiq lư ndô, Án khoiq tông ada top he nhơ A-cái, la A-cái ndon Án khoiq dyôn cơt Ti-cuôi Ưlla cứp nốh, a-lứng co nhơ A-cái ngki, Án khoiq teng cứp pang; <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />ma A-cái ngki la callong tar-laq ang ưr a-lứng ar-lớih lư mu chứng a-rớq te Án, dyơ ngki teng cứp nốh nhơ par-nai bôn chức na án, dyơ cua khoiq táq dyôn práh máh luaih, A-cái ngki ti-cu pa a-tớm Án Sút Pưt tớq ntúq a-yống; <verse eid="HEB 1:3" /><verse number="4" style="v" sid="HEB 1:4" />co bôn cơt sút pưt ta-niêng te máh tar-neng, A-cái khoiq bôn ráp nhơ nốh ŏ a-ưi hơn máh tar-neng ngki. <verse eid="HEB 1:4" /><verse number="5" style="v" sid="HEB 1:5" />Co Án báq lư tông ada ti-cuôi mmo te máh tar-neng idô:</para>
  <para style="q1" vid="HEB 1:5">“Mái la A-cái Cư.</para>
  <para style="q1" vid="HEB 1:5">I-ngái ndô Cư khoiq ca-nian Mái”?</para>
  <para style="m" vid="HEB 1:5">Lớiq la tông:</para>
  <para style="q1" vid="HEB 1:5">“Cư la lư A-ám ada Án,</para>
  <para style="q1" vid="HEB 1:5">a-lứng Án la lư A-cái dyôn Cư”?<verse eid="HEB 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 1:6" />Ma yôl clưi ngki, dyơ Án dyôn A-cái Pông nga cúc cu-teq ndô, Án tông: “Nhéq máh tar-neng na Yang Arbang Pilŏ́ng cóq sang tám A-cái ngki.” <verse eid="HEB 1:6" /><verse number="7" style="v" sid="HEB 1:7" />Ma te máh tar-neng, Án tông:</para>
  <para style="q1" vid="HEB 1:7">“Yang Arbang Pilŏ́ng dyôn máh tar-neng án cơt cu-yiêl,</para>
  <para style="q1" vid="HEB 1:7">a-lứng máh ti-cuôi choi ar-náq án cơt máh palla uih.”<verse eid="HEB 1:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />Ma te A-cái ngki:</para>
  <para style="q1" vid="HEB 1:8">“Ơi Yang Arbang Pilŏ́ng tar-cu Mái yôl níc sút pang lang dơi,</para>
  <para style="q1" vid="HEB 1:8">a-lứng cơt sút ti-nớng ŏ la sút na cruông ang ưr Mái.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />Mái a-moih callong ti-nớng tu-pứng a-lứng a-ính callong lớiq ŏ.</para>
  <para style="q1" vid="HEB 1:9">Co te ngki, Yang Arbang Pilŏ́ng, Yang Arbang Pilŏ́ng na Mái, khoiq pớih ada Mái</para>
  <para style="q1" vid="HEB 1:9">nseng bui hơr a-ưi hơn te máh yớu Mái.”<verse eid="HEB 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 1:10" />A-lứng, “Yang Ơi, ndóng tôm lư, Mái khoiq teng cúc cu-teq,</para>
  <para style="q1" vid="HEB 1:10">a-lứng máh lưp pilŏ́ng la máh ar-náq na ati Mái.<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />Pilŏ́ng cu-teq cơt pít nhéq, ma Mái yôl níc,</para>
  <para style="q1" vid="HEB 1:11">nhéq pilŏ́ng cu-teq cơt tiêq a-rớq au a-nhoh,<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />a-lứng a-rớq au thor, Mái lư pial pilŏ́ng cu-teq liêh,</para>
  <para style="q1" vid="HEB 1:12">a-rớq au te tiêh, pilŏ́ng cu-teq cơt tar-piên nhéq,</para>
  <para style="q1" vid="HEB 1:12">ma Mái ngki yôl iki níc,</para>
  <para style="q" vid="HEB 1:12">a-lứng máh cu-mo na Mái lư lớiq têq nhéq.”<verse eid="HEB 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />Ma, Mái khoiq bôn tông ada ti-cuôi mmo te máh tar-neng:</para>
  <para style="q1" vid="HEB 1:13">“Cóq ti-cu pa a-tớm Cư</para>
  <para style="q1" vid="HEB 1:13">ti-ngôi i-ngái mmo Cư dyôn máh ti-cuôi pi-con na Mái cơt tar-dơl ada dyưng Mái”?<verse eid="HEB 1:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14" />Tới nhéq top ti-cuôi ngki la máh tar-neng táq ar-náq, yua tớq tar-choi ar-náq co tar-náp na máh ti-cuôi tar-mán ráp callong choi ta-mống?<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />Nhơ te ngki, callong ndô top he cóq ca-pol khớm níc ndon nốh a-mớh khoiq bôn sáng, dŏq lớiq pít callong tin te nốh ngki. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />Co khán par-nai ŏ yang khoiq dŏq tông na máh tar-neng khoiq cơt callong ar-lớih, a-lứng nnáu táq luaih la lớiq peh khoiq ráp tôt piaiq lư, <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />táq i-mo top he lư têq vít tư khoiq ca-lôih callong choi ta-mống pưt ngki? Ma callong choi ta-mống ngki, khoiq rêh dŏq co Yang khoiq tông nsuôi dyơ, ngki ca-lư dyôn top he te máh ti-cuôi khoiq sáng; <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />co Yang Arbang Pilŏ́ng lư sŏ́ng mu nơi a-páh dyôn ada nha-án na máh tíc, laq, a-lứng a-ưi ar-náq si-leh can-nŏ́h hơ, nha callong dyôn te Yang Ar-vai veng par-ngíh Án.<verse eid="HEB 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Co tới dyôn ada top tar-neng ndon Yang Arbang Pilŏ́ng cơt sút cruông cu-teq ính teng, la cruông cu-teq ndon top he chón taq-ntêr ngki. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />Ma, bôn ti-cuôi khoiq taq-ntêr tớq ntúq mmo, idô:</para>
  <para style="q1" vid="HEB 2:6">“A-cái ti-cuôi la a-mớh, ma Án par-ngíh ti-ráp te nha-án,</para>
  <para style="q1" vid="HEB 2:6">a-láng a-cái thư ti-cuôi la i-mo ma Án par nha-án?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />Án dyôn ti-cuôi két biq te top tar-neng lớiq bôn dưnh;</para>
  <para style="q1" vid="HEB 2:7">Án ta-pưng vom dyôn ti-cuôi callong ang ưr a-lớng dyám náp.<verse eid="HEB 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 2:8" />Án dyôn cứp nốh ta-dưp dyưng ti-cuôi.”</para>
  <para style="p" vid="HEB 2:8">Co tớq ndóng cơt sút cứp nốh, Án táq ớq mui nốh a-mớh lớiq cam-máng ti-cuôi. Ma hoi ndô top he i-yốh bôn hôm cứp nốh cam-máng ti-cuôi, <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />ma top he hôm Yang Yê-su, la Án dyôn át ta-dưp hơn máh tar-neng nưm mu hoi sớng, khoiq bôn pưng vom tớq callong ang ưr a-lứng dyám náp co te callong chiuq diêiq a-rức tớq callong cu-chet na Án, dŏq callong choi mat Yang Arbang Pilŏ́ng, Án têq dual callong cu-chet tang dyôn cứp náq ti-cuôi. <verse eid="HEB 2:9" /><verse number="10" style="v" sid="HEB 2:10" />Co Yang Arbang Pilŏ́ng, co Án túc nốh a-lớng nhơ Án túc nốh dŏq dông a-ưi a-cái tớq callong ang ưr, ngki khoiq táq crái piaiq ndóng dyôn Án Táq Plô callong choi ta-mống na nha-án piaiq ŏ te callong chiuq diêiq a-rức. <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />Co díh Án práh ŏ a-lứng nhéq máh ti-cuôi khoiq práh ŏ nưm mui. Co te ar-náq ndô, Án lớiq sáng a-chiêt dŏq arô nha-án la em ai, <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />dyơ tông:</para>
  <para style="q1" vid="HEB 2:12">“Cư lư pau ntêr nốh Mái dyôn top em ai Cư;</para>
  <para style="q1" vid="HEB 2:12">Cư lư cứh ayô Mái tớq ntúq nha-án rum.”<verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />Nha mu chư loi:</para>
  <para style="q1" vid="HEB 2:13">“Cư lư ki-nứm nưm Yang Arbang Pilŏ́ng.”</para>
  <para style="m" vid="HEB 2:13">Dyơ tông sa:</para>
  <para style="q1" vid="HEB 2:13">“Me ndô, cư a-lứng máh a-cái a-con ndon Yang Arbang Pilŏ́ng khoiq dyôn ada cư.”<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />Iki khán, co máh a-cái a-con bôn phê te a-ham a-lớng sáiq, Án la bôn phê te máh nốh ngki mu chứng iki dŏq na callong cu-chet án, Án têq ta-lóh ti-cuôi bôn chức callong cu-chet, ngki la yang sáq, <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />a-lứng têq ta-láh máh ti-cuôi ngki, la máh ti-cuôi tu-mống lư co a-dáh callong cu-chet, át táq sol díh sút pang. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />Co lư ar-lớih, tới Án ính choi máh tar-neng, ma lư Án ính choi tŏ́ng toiq na A-pra-ham, <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />co iki Án cóq bôn táq a-rớq em ai án te cứp ar-náq, dŏq Án têq cơt thới teng rit sang báq srui-táq a-lứng ti-nớng máh ar-náq tớq nga Yang Arbang Pilŏ́ng a-lứng ính a-páh callong choi mat dyôn callong luaih na ti-cuôi Án. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />Vít dyơ chiuq diêiq a-rức, Án têq tar-choi máh ti-cuôi ndon chiuq diêiq a-rức, co lư Án khoiq tu-múh nsuôi callong ngki.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Co iki, ơ em ai práh ŏ, máh ti-cuôi bôn tưi tớq callong arô na Yang Arbang Pilŏ́ng, cóq par-ngíh te dyưng ati a-lứng Thới Teng Rit Sang na par-nai ca-lư top he, Yang Yê-su, <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />ndóng ti-nớng a-lớng Yang Arbang Pilŏ́ng khoiq a-nát Án la mu chứng a-rớq Môi-se tớq dúng Yang Arbang Pilŏ́ng. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />Co Án la lư piaiq ngai ayô a-ưi hơn Môi-se mu chứng a-rớq ti-cuôi man dúng ngai dyám náp a-ưi hơn chom máh mmo te dúng ngki. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />Co cứp allám dúng ngki bôn pi-tứng nhơ te ti-cuôi, ma Yang Arbang Pilŏ́ng la Yang teng cơt túh nốh. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />Môi-se ti-nớng tu-pứng a-rớq ti-cuôi sol tớq díh dúng na Yang Arbang Pilŏ́ng, dŏq a-rớq mui par-nai tíc te máh ar-náq lư bôn taq-ntêr tớq pang chô mát; <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />ma Yang Choi Ta-mống, a-rớq mu náq Ti-cuôi A-cái kiaq me dúng na Yang Arbang Pilŏ́ng (top he la dúng na Án khán top he ca-pol khớm mít tin a-lứng sáng bui te callong ng-cong na top he). <verse eid="HEB 3:6" /><verse number="7" style="v" sid="HEB 3:7" />Co iki, piaiq a-rớq Yang Ar-vai tông:</para>
  <para style="q1" vid="HEB 3:7">“I-ngái ndô, khán top a-cái cam-máng cang Án,<verse eid="HEB 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 3:8" />êq táq cớng mít top i-nha</para>
  <para style="q1" vid="HEB 3:8">a-rớq tớq tar-chíl,</para>
  <para style="q1" vid="HEB 3:8">te i-nớh ndóng i-ngái thứq tớq ntúq aih<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />la ntúq a-chúc a-chiac top i-nha khoiq thứq Cư na ar-náq ti-tuaiq,</para>
  <para style="q1" vid="HEB 3:9">dyơ nha-án khoiq hôm ar-lớih máh ar-náq na Cư<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />nhéq puan chít cu-mo. Co iki, Cư sáng uan lư ada pang ngki,</para>
  <para style="q1" vid="HEB 3:10">a-lứng Cư tông: ‘Nha-án át par-yông lớiq crái tớq mít nha-án,</para>
  <para style="q1" vid="HEB 3:10">ma nha-án khoiq lớiq chom máh car-na na Cư.’<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />A-rớq Cư khoiq can-tŏ́h tớq callong ính táq na cư:</para>
  <para style="q1" vid="HEB 3:11">‘… Nha-án lư ớq mot tớq callong iên ŏ na Cư!’”<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />Em ai ơi, cóq mmứng, dáh lơ mít can-nính lớiq tin táq saq lư mpáh tớq mu náq ti-cuôi ngki tớq top i-nha, la ti-cuôi nguai te Yang Arbang Pilŏ́ng tu-mống níc. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />Ma, cóq a-liam tar-tuôq ngki cứp i-ngái, ti-ngôi ali mmo yôl bôn dŏq la “i-ngái ndô,” dŏq ớq nnáu te top i-nha ndon táq dyôn cớng ngan te callong par-lốh na callong luaih. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />Co top he khoiq cơt máh ti-cuôi bôn sŏ́ng mui mít na Yang Choi Ta-mống, khán lư top he ca-pol khớm te tôm callong tin na he ti-ngôi díh sút pang, <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />a-rớq par-nai khoiq pa-táp:</para>
  <para style="q1" vid="HEB 3:15">“I-ngái ndô, khán top i-nha cam-máng par-nai Án,</para>
  <para style="q1" vid="HEB 3:15">êq táq cớng mít top i-nha</para>
  <para style="q1" vid="HEB 3:15">a-rớq ndóng ính chíl liêh.”<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />Co máh ti-cuôi ndon chíl liêh Án vít khoiq cam-máng? Ớq nnáu ma nưm nhéq máh ti-cuôi khoiq ngốh te Ê-yip-tô nhơ Môi-se sớng? <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />Ma Án sáng nháih lư ada máh ti-cuôi mmo nhéq puan chít cu-mo? Lư tới la ada máh ti-cuôi táq luaih, ma cháq na nha-án khoiq cu-chet tớq ntúq aih? <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />Dyơ Án khoiq can-tŏ́h a-lứng máh ti-cuôi ndon lư ớq bôn mot tớq callong iên ŏ na Án, khán tới a-lứng máh ti-cuôi lớiq peh? <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />Top he hôm ar-lớih nha-án lớiq têq bôn mot co te mít lớiq tin.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Co iki, top he cóq chom a-dáh, dáh lơ chón ndóng par-nai par-ưq dŏq mot tớq callong iên ŏ na Án ma yôl ngki, bôn ti-cuôi tớq i-nha dêu ar-mo khoiq ớq bôn mot. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />Co mu chứng a-rớq nha-án, top he la khoiq pau ntêr Par-nai ŏ Yang. Ma, ar-náq cam-máng par-nai ngki ma ớq bôn tar-náp a-mớh dyôn nha-án, ndóng lớiq sŏ́ng mui mít te callong tin tớq máh ti-cuôi sáng. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />Ma ada top he, ndon máh ti-cuôi khoiq tin, ngki bôn mot tớq callong iên ŏ, a-rớq Án khoiq tông:</para>
  <para style="q1" vid="HEB 4:3">“A-rớq Cư khoiq can-tŏ́h tớq callong ính táq na Cư,</para>
  <para style="q1" vid="HEB 4:3">‘… nha-án lư ớq bôn mot a-mớh tớq callong iên ŏ na Cư!’”</para>
  <para style="m" vid="HEB 4:3">ntro máh ar-náq Án khoiq nhéq dyơ te ndóng teng cơt cruông cu-teq. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />Co bôn ntúq Án khoiq tông a-rớq ndô te i-ngái tu-pul:</para>
  <para style="q1" vid="HEB 4:4">“A-lứng Yang Arbang Pilŏ́ng a-ngô máh ar-náq Án tớq i-ngái tu-pul.” <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />A-lứng mu chư sa tớq mui ntúq can-nŏ́h:</para>
  <para style="q1" vid="HEB 4:5">“… Nha-án lư ớq bôn mot tớq callong iên ŏ na Cư.”<verse eid="HEB 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6" />Iki, ndóng par-nai par-ưq yôl dyôn ada máh ti-cuôi dŏq mot tớq callong iên ŏ ngki, ma máh ti-cuôi te nsuôi khoiq bôn pau ntêr Par-nai ŏ Yang khoiq ớq bôn mot co lớiq táq veng, <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />Yang Arbang Pilŏ́ng ngki a-nát mui i-ngái lư ar-lớih, dŏq la: “I-ngái ndô,” ndóng tông co Da-vit vít te máh i-ngái lư toi, a-rớq par-nai khoiq ntêr liêh te nsuôi:</para>
  <para style="q1" vid="HEB 4:7">“I-ngái ndô, khán top i-nha sáng par-nai Án,</para>
  <para style="q1" vid="HEB 4:7">ngki êq táq cớng mít top i-nha.”<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />Co khán Yô-sua khoiq dông callong iên ŏ dyôn nha-án, ngki lư ar-lớih Án khoiq lớiq tông te mui i-ngái can-nŏ́h vít máh ar-náq ndô. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />Iki, yôl bôn mui i-ngái A-ngô dyôn ada máh ti-cuôi na Yang Arbang Pilŏ́ng. <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />Co ti-cuôi mmo khoiq mot tớq callong iên ŏ na Án, lư ti-cuôi ngki la a-ngô máh ar-náq án, mu chứng a-rớq Yang Arbang Pilŏ́ng a-ngô máh ar-náq na Án. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />Co iki, top he cóq ca-tóng mot tớq callong iên ŏ ngki, dŏq ớq nnáu ar-búc tớq ntúq mu chứng a-rớq máh ti-cuôi lớiq peh ntíh. <verse eid="HEB 4:11" /><verse number="12" style="v" sid="HEB 4:12" />Co par-nai Yang Arbang Pilŏ́ng la tu-mống, cơt sit a-lứng héng lư hơn cứp nốh dau bar pla, a-chít tar-clúh díh tớq ntúq a-nial a-lứng ar-vai, díh pal-tot a-lứng tar-long, a-lứng têq rian níc máh par-ngíh a-lứng ng-cong te mít can-nính. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />Lớiq bôn cứp nốh mmo la clôp ca-tốq chứng mát Án. Ma lư, cứp nốh mpáh a-lứng khoiq cơt mpáh chứng mát na Án, la Án ma par-nai ca to na top he ính táq.<verse eid="HEB 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />A-rớq ngki, chón ndóng bôn mu náq thới teng rit sang ndon sút khoiq sớr ti-lớt máh lưp pilŏ́ng, Yang Yê-su la A-cái Yang Arbang Pilŏ́ng, top he cóq ca-pol khớm par-nai ngin luaih na he. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />Co tới top he bôn mu náq thới a-riaih teng rit sang lớiq têq chom te máh callong iêuq thor na top he, ma lư la Án khoiq chiuq callong tar-dông tớq cứp nốh in mu chứng a-rớq top he, ndon ớq bôn luaih a-mớh. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />Iki, a-lứng te mít ŏ, top he têq tớq tar-mán callong choi mat, dŏq ráp callong srui-táq a-lứng bôn bún tớq callong tar-choi piaiq i-ngái.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />Co cứp náq thới teng rit sang, khoiq bôn rêh te máh ti-cuôi clứng, khoiq dŏq a-nát tang mát dyôn ti-cuôi prái tớq máh ar-náq ndon crái nga Yang Arbang Pilŏ́ng, dŏq têq mŏp máh crơng a-lứng mŏp sang pan-nán tang callong luaih; <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />ndóng têq chom sruiq-táq ada máh ti-cuôi a-ơu a-lứng ti-cuôi clu car-na, ma lư án ngki cơt callong luaih par-yông. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />Nhơ te ngki, ti-cuôi ngki cóq mŏp sang pan-nán tang luaih, mu chứng dyôn ti-cuôi i-mo, ngki mu chứng dyôn án bôm iki tưi. <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />Lớiq bôn nnáu ráp ial ar-náq ndô dyôn án, ma nưm têq Yang Arbang Pilŏ́ng rêh arô, lư mu chứng a-rớq A-rôn. <verse eid="HEB 5:4" /><verse number="5" style="v" sid="HEB 5:5" />Mu chứng iki, Yang Choi Ta-mống lư khoiq lớiq bôn a-sớr cháq án bôm cơt thới teng rit sang. Ma lư la Yang Arbang Pilŏ́ng khoiq tông ada Án:</para>
  <para style="q1" vid="HEB 5:5">“Mái la A-cái Cư;</para>
  <para style="q1" vid="HEB 5:5">i-ngái ndô Cư khoiq car-nian Mái.”<verse eid="HEB 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />A-rớq Yang Arbang Pilŏ́ng ngki lư khoiq tông tớq mui ntúq can-nŏ́h:</para>
  <para style="q1" vid="HEB 5:6">“A-cái la thới teng rit sang ti-ngôi díh sút pang,</para>
  <para style="q1" vid="HEB 5:6">mu chứng a-rớq Mel-chi-sa-déc.”<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />Nhéq máh i-ngái át tớq cháq án, Án khoiq mŏp díh par-nai cớu seq nha tár seq, a-lứng arô nhiêm yứng lư nha dơq mát dyôn Án bôn chức sút choi án te cu-chet, a-lứng Án khoiq bôn sáng co pang tu-mống dyám náp na án. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />Ntro la A-cái, Án khoiq rian chom callong náp peh te máh nốh ndon Án chiuq diêiq a-rức. <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />A-lứng ndóng khoiq táq nhéq dyơ, Án cơt tôm callong choi ta-mống díh sút pang dyôn nhéq máh ti-cuôi cam-máng Án, <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />tư dyơ bôn Yang Arbang Pilŏ́ng a-nát táq thới teng rit sang veng a-rớq Mel-chi-sa-déc, <verse eid="HEB 5:10" /><verse number="11" style="v" sid="HEB 5:11" />ma te ar-náq ndô ngki tông dyôn top he a-ưi lư, a-lứng diêiq taq-ntêr, co top i-nha khoiq lớiq ính te ar-náq cam-máng. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />Co tar-lúh díh hoi ndô, piaiq lư khoiq cơt la máh ti-cuôi thới, i-nha yôl bôn par-ngíh suô ti-cuôi ngki pa-soi i-nha máh nốh tôm lư na máh top tang ng-cang na Yang Arbang Pilŏ́ng, a-lứng i-nha khoiq cơt máh ti-cuôi yôl ính cha te dôi tar-nat, ma i-yốh têq cha dôi callám! <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />Co ti-cuôi mmo nưm uq dơq tóh ngki i-yốh chom te par-nai ŏ ti-nớng tu-pứng, co ti-cuôi ngki yôl la ngai a-cái mbơiq car-nian. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />Ma dôi callám la dyôn ada máh ti-cuôi khoiq sa-sai, la máh ti-cuôi co khoiq cơi rian têq chom co a-cớl díh callong ŏ nha callong lớiq ŏ.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Iki, ndóng khoiq táh pa cróng par-nai tôm lư te Yang Choi Ta-mống, top he têq cơt a-rớq sa-sai, êq tông nnáng a-rớq te tôm te callong ngin luaih te máh ar-náq cu-chet, te callong tin tớq Yang Arbang Pilŏ́ng, <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />ca to te rit tíc na dơq, díh callong dŏq ati nha callong tu-mống liêh na ti-cuôi cu-chet, a-lứng callong tar-sưq díh sút pang. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />Top he lư táq ar-náq ngki khán Yang Arbang Pilŏ́ng dyôn. <verse eid="HEB 6:3" /><verse number="4" style="v" sid="HEB 6:4" />Co ngki la ar-náq lớiq têq táq — ada máh ti-cuôi khoiq cơi bôn át tớq ang, a-lứng chim dyơ máh nốh ŏ tớq pilŏ́ng, khoiq cơt ti-cuôi chúng tưi te Yang Ar-vai <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />a-lứng khoiq ráp par-nai ŏ na Yang Arbang Pilŏ́ng nha máh chức sút na pang u-rớh ính tớq <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />ma khán táh — ính liêh máh ti-cuôi ngki tớq nga callong ngin luaih, ndóng téh díng A-cái Yang Arbang Pilŏ́ng dyôn nha-án mu chư sa, a-lứng taq-ntêr callong pa-mat Án. <verse eid="HEB 6:6" /><verse number="7" style="v" sid="HEB 6:7" />Co mui tám cu-teq, ndóng khoiq dyứp níc dơq bo át trôq tớq án dyơ a-ma bát bai tar-náp dyôn ngai can-nŏ́h, dyôn máh ti-cuôi ính táq án, ngki bôn phê tớq callong ơn te Yang Arbang Pilŏ́ng, <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />ma khán cu-teq a-ma a-long tang-háng a-lớng sác tang-háng, la nốh ngai táh nha tar-mán a-rớq mui callong pu-pap, ma talloiq lư na án la dyôn ada uih chŏ́ng ng-cat.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />Ma te i-nha, máh ti-cuôi ndon a-moih lư, díh ndóng ntêr a-rớq ngki, top he khoiq têq cam-máng te máh callong ŏ ta-niêng a-lứng tớq callúng ơn choi ta-mống. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />Co Yang Arbang Pilŏ́ng tới lớiq ti-nớng dyơ clớiq máh ar-náq na i-nha, a-lứng callong ar-moih ma i-nha khoiq a-páh dyôn ada Án, ndóng tar-choi máh top tin nha hoi ngki yôl tar-choi nha-án. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />Ma top he ính lư cứp náq tớq i-nha a-páh mít ca-tóng táq níc iki, dyơ táq dyôn khám nhéq te callong ng-cong na i-nha dyôn díh i-ngái talloiq, <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />táq dyôn i-nha êq cơt máh ti-cuôi a-láh, ma la máh ti-cuôi soi máh ti-cuôi khoiq ráp ŏ nhơ callong tin a-lớng mít chiuq ta-nhir bôn ráp máh nốh Yang khoiq par-ưq.<verse eid="HEB 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />Co Yang Arbang Pilŏ́ng, khoiq par-ưq a-lứng A-pra-ham, co Án ớq bôn nnáu pưt ta-niêng dŏq ial nốh dyơ can-tŏ́h, ngki khoiq can-tŏ́h ial nốh án bôm, <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />idô: “Co lư ar-lớih la khán dyôn ơn, Cư lư tốq bún dyôn ada mái, a-lứng khán rứh riêng chứng cơt, Cư lư táq dyôn mái a-ưi pi-lư.” <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />Co iki, khoiq chiuq ta-nhir ng-cong, án bôn ráp par-nai par-ưq ngki. <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />Co ngai can-nŏ́h bôiq nốh na mu náq ti-cuôi ngki pưt ta-niêng án, ma ada nha-án, nhéq callong tar-miên tớq nga ntúq khoiq sŏ́ng lư la par-nai can-tŏ́h, <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />co te ngki, ndóng ính a-páh dyôn ar-lớih lư ada máh ti-cuôi bôn ráp par-nai par-ưq te máh nốh lớiq têq tar-piên na par-ngíh Án, Yang Arbang Pilŏ́ng khoiq a-nát na mui par-nai can-tŏ́h <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />táq dyôn cơt bar nốh lớiq têq tar-piên ngki, te bar nốh ngki ớq car-na mmo dŏq Yang Arbang Pilŏ́ng tông a-uai, top he, la máh ti-cuôi lúh át nga mui ntúq, náq têq bôn callong a-liam dŏq ca-pol khớm callong ng-cong khoiq dŏq chứng mát nha-án; <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />la callong ng-cong ndon top he bôn a-rớq mui allám taq calléh dyôn ar-vai, lư iên ŏ lư khớm khit, a-lứng pôq mot nga hóng prới dŏq yéng, <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />ntúq ndon Yang Yê-su khoiq pôq mot a-rớq mu náq Án pôq nsuôi tang dyôn top he, cua dyơ cơt thới teng rit sang ti-ngôi díh sút pang veng a-rớq Mel-chi-sa-déc.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Co Mel-chi-sa-déc ndô, puô na Sa-lem thới teng rit sang na Yang Arbang Pilŏ́ng Sút Pưt Lư, án khoiq tar-múh A-pra-ham mbơiq chón te tar-chíl rap máh puô, a-lứng khoiq tông callong bún ada án, <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />ndon A-pra-ham lư khoiq dŏq mmar mui phê mu chít te cứp nốh dyôn ada puô ngki; nsuôi lư, Mel-chi-sa-déc bôn par-long liêh la “puô ti-nớng tu-pứng,” ma tông ndái loi la lư puô na Sa-lem, ngki la “puô iên ŏ,” <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />ớq a-ám, ớq a-i, ớq tŏ́ng toiq, lư ớq bôn máh i-ngái mbơiq car-nian lớiq la tớq i-ngái cu-chet, ma bôn cơt a-rớq A-cái Yang Arbang Pilŏ́ng, puô ngki yôl la thới teng rit sang ti-ngôi díh sút pang.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />Ma cóq ti-tuaiq me puô ngki sút pưt i-mo, ndon a-chúc a-chiac A-pra-ham khoiq mŏp dyôn phê mu chít te máh crơng tar-píh te ntúq tar-chíl. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />Ma máh ti-cuôi te tŏ́ng toiq Lê-vi, ndóng ráp chức thới teng rit sang, ngki bôn pa-táp dŏq ial te phê mu chít te máh ti-cuôi veng rit rŏng, ngki la tớq em ai i-nha, ntro lư callong khoiq ngốh te tŏ́ng toiq A-pra-ham. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />Ma, ndóng ớq bôn ntêr tớq tŏ́ng toiq ngốh te nha-án, puô ndô khoiq ial phê mu chít te A-pra-ham, a-lứng khoiq tông bún ada ti-cuôi bôn máh par-nai par-ưq. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />Ma, lớiq bôn lớng callong tar-miên mmo ndóng ti-cuôi bôn chức két hơn bôn ráp bún te ti-cuôi bôn chức pưt hơn. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />A-lứng tớq ar-náq ndô, máh ti-cuôi chón ính cu-chet ráp ial phê mu chít, ma tớq ar-náq ngki, puô ngki bôn taq-ntêr la yôl tu-mống. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />Têq taq-ntêr mui callong iki, Lê-vi, ti-cuôi ial máh phê mu chít, la khoiq bôn ial phê mu chít na A-pra-ham, <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />co án yôl át tớq cháq na a-chúc a-chiac án ndóng Mel-chi-sa-déc tar-múh A-pra-ham.<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />Iki, khán cứp nhéq la co rit sang na ti-cuôi Lê-vi (co te ar-náq ngki, máh ti-cuôi prái khoiq bôn phep rit), ma i-mo cóq mu náq loi thới teng rit sang can-nŏ́h veng chức Mel-chi-sa-déc ma lớiq bôn ntêr veng chức A-rôn? <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />Co ndóng chức teng rit sang khoiq ngai piên, ngki co táh pa-tot, callong tar-piên te phep rit ngki cóq cơt. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Co Yê-su, Án ndon máh callong ndô ngki ntêr liêh, ưlla mui tŏ́ng toiq can-nŏ́h, ma tớq te tŏ́ng toiq ngki i-yốh bôn nnáu cơi teng rit tớq pa-rông sang. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />Co ar-lớih lư idô Yang top he tớq te Yu-da, ma ada tŏ́ng toiq ngki, Môi-se khoiq lớiq ntêr callong a-mớh te chức máh thới teng rit sang. <verse eid="HEB 7:14" /><verse number="15" style="v" sid="HEB 7:15" />Callong ndô tar-lúh a-cán lư ar-lớih tháng khán mu náq thới teng rit sang can-nŏ́h tớq mu chứng a-rớq ar-maiq na Mel-chi-sa-déc, <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />la Án cơt thới teng rit sang lớiq veng phep rit khoiq a-nát te sac sáiq, ma veng chức sút na callong tu-mống nic-níc. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />Co Án khoiq taq-ntêr idô:</para>
  <para style="q1" vid="HEB 7:17">“A-cái la thới teng rit sang sút pang veng chức Mel-chi-sa-déc.”<verse eid="HEB 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18" />Co iki, ar-náq khoiq táh callong pa-táp ndóng nsuôi khoiq cơt co rit ngki lớiq sit a-lứng lớiq tar-náp nnáng <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />(ngki co phep rit lớiq táq dyôn crái piaiq nốh a-mớh), a-lứng la ar-náq dông a-tớq callong ng-cong ŏ hơn, ma te ngki top he át tar-mán Yang Arbang Pilŏ́ng. <verse eid="HEB 7:19" /><verse number="20" style="v" sid="HEB 7:20" />A-lứng lớiq bôn nhéq máh nốh ngki ma ớq bôn par-nai can-tŏ́h, — ntro lư máh ti-cuôi ntíh ớq bôn par-nai can-tŏ́h ngki khoiq cơt máh thới teng rit sang, <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />ma Yê-su khoiq cơt na par-nai can-tŏ́h, co Yang tông ada Án:</para>
  <para style="q1" vid="HEB 7:21">“Yang khoiq can-tŏ́h a-lứng lư lớiq tar-piên:</para>
  <para style="q1" vid="HEB 7:21">‘A-cái la thới teng rit sang ti-ngôi díh sút pang.’” —<verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />iki veng ngê lư piaiq ngki, Yang Yê-su khoiq cơt Án lư ar-lớih na mui callong car-hŏt ŏ lư. <verse eid="HEB 7:22" /><verse number="23" style="v" sid="HEB 7:23" />A-lứng ntro máh ti-cuôi báq cơt thới teng rit sang la clứng lư, tớq te callong cu-chet lớiq têq dŏq táq dưnh, <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />ma, Án cơt ti-cuôi teng rit sang lớiq têq tar-piên, co Án tu-mống níc ti-ngôi díh sút pang, <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />ma co te ngki, Án lư bôn chức sút dŏq choi ta-mống cứp pang máh ti-cuôi tớq tar-mán Yang Arbang Pilŏ́ng na Yê-su, la Án tu-mống níc dŏq cớu seq tang dyôn nha-án. <verse eid="HEB 7:25" /><verse number="26" style="v" sid="HEB 7:26" />Co mu náq thới teng rit sang a-rớq ngki lư piaiq la dyôn ada top he: Yang práh ŏ, lớiq táq pla, lớiq táq luaih, dŏq mmar te máh ti-cuôi bôn luaih, a-lứng khoiq cơt a-yống hơn máh lưp pilŏ́ng; <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />la Án ớq bôn par-ngíh cứp i-ngái a-rớq máh thới teng rit sang can-nŏ́h, cóq mŏp crơng kiac sang, nsuôi lư la tang dyôn luaih na án dyơ ngki la luaih na máh ti-cuôi clứng, co Án khoiq táq cua ar-náq ngki vít dyơ mŏp cháq án mu chư cứp nhéq. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />Co phep rit dyôn máh ti-cuôi bôn callong luaih cơt thới teng rit sang, ma par-nai can-tŏ́h, la ar-náq tớq ta-tun phep rit, ngki dyôn A-cái, la Án khoiq táq cua nhéq cứp ar-náq ti-ngôi díh sút pang.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Khán iki, ntúq tar-náp lư te ar-náq chón taq-ntêr la idô: Top he bôn mu náq thới teng rit sang a-rớq iki, Yê-su khoiq ti-cu át pa a-tớm tar-cu na Án Sút Pưt tớq máh lưp pilŏ́ng, <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />án táq ar-náq teng rit sang tớq dúng sang lư ma Yang khoiq teng cơt, ngki tới ti-cuôi táq. <verse eid="HEB 8:2" /><verse number="3" style="v" sid="HEB 8:3" />Co cứp náq thới teng rit sang ngki bôn yua dŏq mŏp nhéq máh crơng a-lớng pan-nán kiac sang, ma nhơ ar-náq ngki, Yê-su lư cóq bôn nốh a-mớh ndon Án têq mŏp sang. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />Iki, khán Án yôl tớq cu-teq ndô, ngki lư Án lư khoiq lớiq cơt thới teng rit sang, co khoiq bôn máh ti-cuôi mŏp crơng sang veng phep rit; <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />la máh ti-cuôi choi ar-náq nưm dŏq tông a-páh a-lứng a-cám te máh nốh tớq pilŏ́ng, a-rớq Môi-se khoiq dŏq pa-táp ndóng tar-mán ính táq dyơ dúng sang prới, co Yang Arbang Pilŏ́ng tông: “Cóq mmứng a-ŏ, mái cóq lư táq cứp nốh veng a-rớq khoiq dŏq a-páh ada mái tớq cóh.” <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />Ma hoi ngki, Yê-su khoiq bôn mui ar-náq ŏ hơn ta-niêng, Án lư la Yang Arbang Pilŏ́ng na par-nai car-hŏt ŏ hơn máh mmo, la car-hŏt khoiq dŏq a-ngốh te máh par-nai car-hŏt ŏ hơn. <verse eid="HEB 8:6" /><verse number="7" style="v" sid="HEB 8:7" />Co khán par-nai car-hŏt chư mui ngki khoiq la ớq bôn luaih, ngki lư ntúq dyôn par-nai car-hŏt chư bar khoiq ớq bôn tu-múh. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />Co ndóng khoiq tíq ti-cuôi prái, Yang Arbang Pilŏ́ng tông:</para>
  <para style="q1" vid="HEB 8:8">“Cóq mmứng, máh i-ngái ngki chón tớq, Yang tông,</para>
  <para style="q2" vid="HEB 8:8">dyơ cư ính táq mui car-hŏt tam-me</para>
  <para style="q2" vid="HEB 8:8">ada dúng Isa-ra-el a-lứng ada dúng Yu-da;<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />lớiq táq veng car-hŏt ndon Cư khoiq car-hŏt ada top a-chúc a-chiac na nha-án</para>
  <para style="q2" vid="HEB 8:9">tớq i-ngái Cư kéu ati nha-án dông nha-án ngốh te cu-teq Ê-yip-tô,</para>
  <para style="q1" vid="HEB 8:9">co nha-án khoiq lớiq táq veng tớq car-hŏt na Cư,</para>
  <para style="q2" vid="HEB 8:9">Cư lư khoiq táh nha-án, Yang tông.<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />Co ndô la car-hŏt ndon Cư ính car-hŏt ada dúng Isa-ra-el</para>
  <para style="q2" vid="HEB 8:10">vít máh i-ngái ngki, Yang tông,</para>
  <para style="q1" vid="HEB 8:10">tư dŏq máh phep rit na Cư tớq can-nính nha-án,</para>
  <para style="q2" vid="HEB 8:10">Cư lư ính ta-ran án tớq mít nha-án,</para>
  <para style="q1" vid="HEB 8:10">a-lứng Cư cơt Yang Arbang Pilŏ́ng dyôn ada nha-án,</para>
  <para style="q2" vid="HEB 8:10">a-lứng nha-án cơt ti-cuôi prái dyôn Cư.<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />Ar-lớih nha-án lư ớq ca to máh ti-cuôi vel vang bôm</para>
  <para style="q2" vid="HEB 8:11">a-lứng cứp náq em ai bôm, idô: ‘Cóq ráp chom Yang,’</para>
  <para style="q1" vid="HEB 8:11">co nhéq tưh nha-án lư chom Cư,</para>
  <para style="q2" vid="HEB 8:11">te ti-cuôi két tháng tớq nha-án ti-ngôi tớq ti-cuôi pưt tháng.<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />Co Cư lư táh luaih te máh ar-náq lớiq ŏ na nha-án,</para>
  <para style="q2" vid="HEB 8:12">a-lứng Cư ar-lớih lư lớiq bôn ayư tớq callong luaih na nha-án nnáng.”<verse eid="HEB 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />Co par-nai car-hŏt “tam-me”, Án khoiq táq dyôn par-nai car-hŏt chư mui cơt lớiq sit nnáng, ma callong ndon táq dyôn lớiq sit ngki khoiq tiêq dyơ chón ính pít nhéq.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Hoi ngki, car-hŏt chư mui ngki yôl bôn máh phep rit te callong sang tám, a-lứng bôn dúng sang tớq cu-teq, <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />co mui dúng sang khoiq dŏq pi-tứng, callúng chư mui, tớq ngki bôn díh a-ruông den nha ki-chơng, a-lứng máh cúc beng mŏp sang, la ntúq ngai dŏq la “Ntúq Yang Arbang Pilŏ́ng”, <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />ma pa cróng prới callúng bar la callúng ntúq ngai dŏq la “Ntúq Lư Sáq Yang Arbang Pilŏ́ng”, <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />bôn mui callúng pa-rông dŏq chŏ́ng crơng thum na dyeng, a-lứng hip par-nai car-hŏt ngai pŏq nhéq na dyeng, tớq callúng ngki la mui allám o na dyeng pớnh ma-na, tar-lông ngốh piêr na A-rôn, nha máh mêng car-hŏt, <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />ma tớq mpiên hip, máh chê-ru-bim ang ưr crôp car-rứp hip, ma te máh nốh ngki lư lớiq lớp dŏq ntêr dyôn ada ar-lớih. <verse eid="HEB 9:5" /><verse number="6" style="v" sid="HEB 9:6" />Dyơ tư máh nốh ngki khoiq dŏq ti-ráp a-rớq ngki, top thới teng rit sang át lu-liêh pôq mot tớq callúng prới chư mui, táq máh ar-náq na nha-án; <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />ma nưm thới teng rit sang mot tớq callúng chư bar mu chư tớq cu-mo, a-lứng lớiq têq ớq bôn a-ham, la pan-nán ndon án mŏp sang tang dyôn cháq án la a-rớq máh luaih lới na máh ti-cuôi prái. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />Yang Ar-vai te ar-náq ngki dyôn hôm ar-lớih car-na mot máh ntúq práh yôl i-yốh têq a-páh, ndóng dúng sang chư mui yôl bôn ntúq ta-yứng, <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />ma ngki la mui tíc dyôn ada ti-cuôi pang hoi ndô, ndon veng a-rớq ngki, nhéq crơng sang díh pan-nán kiac sang khoiq bôn mŏp lớiq bôn rap dŏq táq dyôn práh ti-cuôi sang tám veng a-rớq can-nính nha-án, <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />nưm rit ngki tông te tan-na cha a-lứng crơng ngoiq, nha máh rit a-rau dyôn práh can-nŏ́h, phep rit te cháq ti-cuôi, cóq náp peh dyôn díh tớq i-ngái ngê tam-me.<verse eid="HEB 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />Ma Yang Choi Ta-mống, ndóng tớq án cơt thới teng rit sang na máh nốh ŏ ndon khoiq bôn, co te dúng sang prới pưt hơn a-lứng ŏ hơn tới co ati ti-cuôi pi-cơt, lư la tới ưlla na cúc cu-teq ndô, <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />a-lứng tới co a-ham na mbeq tang-cáh nha car-rŏ́q a-cái, ma co a-ham na án bôm, Án khoiq mot tớq máh dúng sang prới mui can-tứq cứp táp, án bôm táq dyôn bôn tar-cláh luaih díh sút pang. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />Co khán a-ham mbeq tang-cáh nha car-rŏ́q tang-cáh a-lứng ar-náq boi a-bŏ́h car-rŏ́q ng-ông tớq máh ti-cuôi lớiq práh veng rit táq dyôn práh, tớq ar-náq a-rau práh cháq nha-án, <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />a-ham na Yang Choi Ta-mống, la Án co Ar-vai Yang díh sút pang khoiq mŏp cháq án cơt pan-nán kiac sang ớq bôn luaih a-mớh dyôn Yang Arbang Pilŏ́ng, ngki lư práh ŏ mít can-nính na i-nha díh máh mmo vít ar-náq cu-chet dŏq táq ar-náq Yang Arbang Pilŏ́ng tu-mống níc! <verse eid="HEB 9:14" /><verse number="15" style="v" sid="HEB 9:15" />Nhơ te ngki, Án la Yang Arbang Pilŏ́ng na par-nai car-hŏt tam-me, dyôn têq vít dyơ callong cu-chet ada ar-náq thái máh luaih ndóng yôl veng car-hŏt chư mui cơt tớq, máh ti-cuôi khoiq dŏq arô bôn ráp par-nai car-hŏt te máh mun díh sút pang. <verse eid="HEB 9:15" /><verse number="16" style="v" sid="HEB 9:16" />Co tớq mmo bôn mun, tớq ngki cóq callong cu-chet na ti-cuôi ta-ran chớiq mun cóq bôn tíc. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />Co chớiq nưm bôn tar-náp nhơ te callong cu-chet, iki chớiq mun ớq bôn tar-náp ndóng ti-cuôi táq chớiq mun yôl tu-mống. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />Co iki, díh car-hŏt tôm lư khoiq lớiq têq bôn tar-náp khán ớq bôn a-ham. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />Co ndóng cứp callong pa-táp veng phep rit khoiq bôn Môi-se taq-ntêr dyôn nhéq tưh ti-cuôi, dyơ ial a-ham car-rŏ́q a-cái nha mbeq tang-cáh, mu nơi a-lứng dơq, ntár ntứm cu-sáu, a-lứng sác nốh hi-sớp, án khoiq ng-cráih nhéq tớq pứng u-ráq díh máh ti-cuôi prái, <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />tông idô: “Ndô la a-ham car-hŏt ndon Yang Arbang Pilŏ́ng khoiq pa-táp ca to dyôn i-nha.” <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />Dyơ veng ngê mu chứng a-rớq ngki, án khoiq ng-cráih a-ham tớq dúng sang a-lứng cứp nốh tar-nứng tớq dúng sang. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />Iki veng a-rớq phep rit, nhéq cứp nốh bôn a-rau práh na a-ham, nám ớq callong hóc a-ham ngki ớq bôn callong ta-láh luaih.<verse eid="HEB 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />Co iki, ma khán, callong tar-náp ngki la crơng ngai táq dŏq a-páh máh nốh tớq pilŏ́ng khoiq a-rau práh co te pan-nán ndô, ma, lư máh nốh tớq pilŏ́ng cóq a-rau práh na pan-nán ŏ ta-niêng máh pan-nán ngki, <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />co lư, Yang Choi Ta-mống khoiq lớiq mot tớq ntúq lư sáq sang co ati ti-cuôi táq — máh nốh dŏq a-páh na crơng lư — ma mot tớq pilŏ́ng, dŏq hoi ngki a-páh chứng mát na Yang Arbang Pilŏ́ng tang dyôn top he, <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />lư tới dŏq mŏp cháq án a-ưi chư, a-rớq thới teng rit sang cứp cu-mo pôq mot tớq máh ntúq práh mu nơi a-lứng a-ham ưlla na ti-cuôi can-nŏ́h; <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />co khán tới iki, ngki callong lư ada Án la cóq chiuq cu-chet a-ưi chư te ndóng teng cơt pilŏ́ng cu-teq. Ma hoi ndô, nưm mui chư nga talloiq tớq cứp pang, co ar-náq pu-pít máh luaih, Án khoiq dŏq a-páh na callong mŏp cháq na Án. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />A-lứng veng a-rớq nốh dŏq a-nát khám dyôn cứp náq ti-cuôi cóq cu-chet mu chư, dyơ vít ngki la callong tar-sưq, <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />mu chứng iki, vít ndóng mŏp nưm mu chư dŏq ial dual máh luaih clứng ti-cuôi, Yang Choi Ta-mống lư bôn hôm tớq chư bar, tới dŏq dual luaih, ma dŏq callong choi ta-mống tớq nga máh ti-cuôi ndon ính ng-cong Án.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />Co phep rit — ndóng nưm bôn a-rớq mol na máh nốh ŏ ính tớq, tới la ar-maiq na máh nốh ngki — lư lớiq têq táq dyôn máh ti-cuôi tớq tar-mán Yang mu chứng a-rớq pan-nán ndon nha-án a-ưi chư dông mŏp sang cứp cu-mo. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />Co khán têq, ngki lớiq túh máh pan-nán lư khoiq lớiq bôn mŏp sang co máh ti-cuôi sang tám ớq sáng ayư callong luaih nnáng, ndóng khoiq práh ŏ mui can-tứq la cứp? <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />Ma, te nốh pan-nán ngki, bôn mui callong a-nhác te luaih lới cứp cu-mo. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />Co a-ham na car-rŏ́q tang-cáh nha mbeq tang-cáh lớiq têq pu-pít luaih ngki a-mớh. <verse eid="HEB 10:4" /><verse number="5" style="v" sid="HEB 10:5" />Co iki, ndóng siar tớq cúc cu-teq ndô, Án tông:</para>
  <para style="q1" vid="HEB 10:5">“Yang lớiq ính</para>
  <para style="q2" vid="HEB 10:5">pan-nán kiac sang nha crơng sang,</para>
  <para style="q2" vid="HEB 10:5">ma Án khoiq thuan dyôn cơt cháq ti-cuôi ada Cư;<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />Án lớiq sáng bui</para>
  <para style="q2" vid="HEB 10:6">máh crơng pan-nán nhéq ngai bóh dŏq pu-pít luaih.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />Vít ngki, cư tông: ‘Seq me ndô, Cư tớq —</para>
  <para style="q2" vid="HEB 10:7">veng a-rớq par-nai tớq tám u-ráq khoiq ta-ran te cư —</para>
  <para style="q1" vid="HEB 10:7">dŏq táq veng can-nính na Án, Yang Arbang Pilŏ́ng ơi.’”<verse eid="HEB 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 10:8" />Ndóng Án tông a-rớq nsuôi idô: “Yang lớiq ính pan-nán kiac sang nha crơng sang, a-lứng mŏp sang crơng ngai bóh a-lứng pu-pít luaih. Án lư lớiq sáng ính máh nốh ngki” (ndon nha-án bôn mŏp veng phep rit), <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />dyơ ngki, Án tông: “Seq me ndô, Cư tớq dŏq táq veng can-nính na Án.” Án táh phep rit chư mui dyơ dyôn phep rit chư bar. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />Co can-nính iki, top he ndô khoiq cơt práh ŏ nhơ callong mŏp cháq na Yang Choi Ta-mống Yê-su cu-chet tang mu chư ngki táp. <verse eid="HEB 10:10" /><verse number="11" style="v" sid="HEB 10:11" />Lư, cứp náq thới teng rit sang cu i-ngái ta-yứng táq ar-náq a-lứng a-ưi chư mŏp sang máh crơng, ma crơng ngki lư lớiq têq pu-pít luaih dyôn tar-cláh. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />Ma Án, ndóng co te luaih mŏp pan-nán kiac sang nưm mui ti-ngôi nic-níc, khoiq ti-cu tớq pa a-tớm Yang Arbang Pilŏ́ng, <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />pớn níc te i-ngái ngki ti-ngôi díh top ti-cuôi pi-con Án cơt dŏq táq tar-dơl ada dyưng Án. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />Co nưm mui pan-nán kiac sang, Án táq dyôn máh ti-cuôi cơt práh ŏ crái piaiq ti-ngôi nic-níc. <verse eid="HEB 10:14" /><verse number="15" style="v" sid="HEB 10:15" />Ma Yang Ar-vai lư dŏq a-páh dyôn top he, co cua khoiq tông:<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />“Ndô la car-hŏt ndon Cư dyôn ada nha-án</para>
  <para style="q2" vid="HEB 10:16">vít máh i-ngái ngki, Yang tông,</para>
  <para style="q1" vid="HEB 10:16">ndóng dŏq phep rit Cư tớq mít can-nính nha-án,</para>
  <para style="q2" vid="HEB 10:16">Cư lư ta-ran án tớq mít par-ngíh nha-án.”<verse eid="HEB 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />A-lứng:</para>
  <para style="q1" vid="HEB 10:17">“Cư ar-lớih lư lớiq bôn ayư díh máh luaih nha-án</para>
  <para style="q2" vid="HEB 10:17">nha te ar-náq saq na nha-án hơ.”<verse eid="HEB 10:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="HEB 10:18" />Ma ntúq mmo bôn callong ta-láh te luaih ngki, ntúq ngki ớq bôn pan-nán kiac sang thái luaih.<verse eid="HEB 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />Iki, em ai ơi, co bôn mít clŏ́q te ar-náq tớq ntúq lư sáq yang co a-ham na Yang Yê-su, <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />Án khoiq pốh dyôn top he mui car-na tam-me a-lứng pang tu-mống co a-rớq prới ngai ca-táng, ngki lư la cháq Án, <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />a-lứng mu náq thới teng rit sang sút pưt nhéq tớq dúng na Yang Arbang Pilŏ́ng, <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />iki top he cóq tớq tar-mán Yang Arbang Pilŏ́ng te mít can-nính ti-nớng lư ndon khoiq ngin na callong tin, mít khoiq nhơ te a-ham dŏq pu-pít par-ngíh lớiq ŏ a-lứng cháq chớn bôn a-rau na dơq práh tháng. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />Top he cóq ca-pol khớm par-nai tar-náp te callong ng-cong na top he êq tam-bang par-ngíh, co Án khoiq par-ưq lư ti-nớng. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />A-lứng top he cóq mu náq choi mu náq dyôn bôn mít can-nính a-moih a-lứng táq ar-náq ŏ, <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />ngki êq par-táh rum sang mu nơi tớq top he mu chứng a-rớq máh ti-cuôi báq táq, ma lư ca-tớih tar-tuôq, a-lứng khán i-nha hôm i-ngái ngki ính tớq dyơ ngki cóq táq iki a-ưi hơn te ngki loi.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />Co khán top he át par-ngíh táq luaih ndóng khoiq chom nhéq dyơ te callong piaiq, ớq nnáng pan-nán kiac sang thái luaih ngki, <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />ma callong ng-cong rớu ri níc lư ar-lớih te callong tar-sưq a-lứng te uih chéh dŏq chóng máh ti-cuôi ndon pi-con ada án. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />Ti-cuôi mmo, ma lớiq peh phep rit Môi-se khán bôn bar lớiq la pe náq tông táq luaih, ngki ngai ca-chet lớiq srui-táq. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />I-nha par-ngíh ti-cuôi ndon dếq nhot A-cái Yang Arbang Pilŏ́ng, nha ar-ngíh a-ham car-hŏt la lớiq práh — ma co a-ham ngki, i-nha bôn práh ŏ — a-lứng pa-mat Ar-vai Yang ndon choi mat, án cơt piaiq táq tôt ntáng lư loi? <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />Co top he chom Án khoiq tông: “Callong cu-liêh cống la na Cư; Cư lư cu-liêh cống.” A-lứng tông loi idô: “Yang lư sưq ti-cuôi prái Án.” <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />Piaiq nga ati Yang Arbang Pilŏ́ng tu-mống níc la mui nốh crŏ́q lư!<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />Ma cóq ayư liêh máh i-ngái nsuôi, ndon khoiq bôn ang claq tớq máh i-ngái ngki, i-nha khoiq tar-múh ngai táq a-ưi lư na callong diêiq a-rức, <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />ndóng ndô chiuq nhéq callong pa-mat a-lứng táq chứng mát ti-cuôi clứng, ma dyơ ngki têq cơt ti-cuôi chúng tưi a-lớng máh ti-cuôi ndon tar-múh diêiq a-rức veng ngê ngki. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />Co i-nha lư khoiq srui-táq máh ti-cuôi ndon át tôt, a-lứng khoiq chiuq ta-nhir te ngai pún crơng-crớu i-nha a-lứng sáng bui hơr, co chom i-nha táp bôn crơng-crớu ŏ lư a-lứng yôl níc. <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />Iki, i-nha êq táh mít can-nính clŏ́q na i-nha, co callong ngki bôn tar-náp pưt lư. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />Co i-nha cóq chiuq ta-nhir níc, dŏq táq cua máh ar-náq na Yang Arbang Pilŏ́ng, i-nha têq bôn callong par-ưq.<verse eid="HEB 10:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="HEB 10:37" />“Co lư lớiq bôn toi nnáng,</para>
  <para style="q1" vid="HEB 10:37">Án ndon tớq lư tớq, a-lứng lư lớiq dyut.<verse eid="HEB 10:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38" />Ma ti-cuôi ti-nớng tu-pứng na Cư lư tu-mống co callong tin;</para>
  <para style="q1" vid="HEB 10:38">ma khán ti-cuôi mmo car-lun, ar-vai Cư lớiq sáng bui te án.”<verse eid="HEB 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />Ma lư top he lớiq sáng car-lun pa cróng dyơ cơt pít, ma lư tớq callong tin têq bôn tu-mống níc na ar-vai.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />Callong tin la cơt khớm te máh nốh têq át ng-cong, hôm te máh nốh ớq bôn hôm. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />Co nhơ callong tin, máh ti-cuôi i-nớh khoiq bôn ayô. <verse eid="HEB 11:2" /><verse number="3" style="v" sid="HEB 11:3" />Nhơ callong tin top he chom pang ndô khoiq teng cơt co par-nai tông na Yang Arbang Pilŏ́ng — dŏq nốh bôn hôm khoiq lớiq tớq te nốh têq bôn hôm. <verse eid="HEB 11:3" /><verse number="4" style="v" sid="HEB 11:4" />Nhơ callong tin A-ben khoiq mŏp dyôn Yang Arbang Pilŏ́ng crơng ŏ hơn te Ca-in, co te ngki án la ti-cuôi lư ti-nớng ŏ, ndóng Yang Arbang Pilŏ́ng khoiq ráp te máh crơng mŏp sang na án, a-lứng nhơ callong tin, A-ben yôl tông ntro khoiq cu-chet. <verse eid="HEB 11:4" /><verse number="5" style="v" sid="HEB 11:5" />Nhơ callong tin Hê-nóc bôn dông palláiq, ớq bôn tu-múh callong cu-chet, a-lứng “án ớq bôn tu-múh, co Yang Arbang Pilŏ́ng khoiq dông án pôq.” Co nsuôi ar-náq dông palláiq na án, án khoiq lư tu-mống táq bui can-nính Yang Arbang Pilŏ́ng. <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />Ma khán, ớq bôn callong tin ngki lớiq têq táq bui can-nính Án, co callong lư ada ti-cuôi ndon tớq nga Yang Arbang Pilŏ́ng la cóq náp ar-lớih lư bôn Án a-lứng Án la Yang choi dyôn máh ti-cuôi mmo si-suô Án. <verse eid="HEB 11:6" /><verse number="7" style="v" sid="HEB 11:7" />Nhơ callong tin, cua dyơ dŏq pa-táp te máh nốh i-yốh bôn hôm, ngki co mít dyám náp yang, Nô-ê khoiq táq mui allám tuôc dyôn callong tu-mống na dúng su án, co te ngki, án pi-tôt cúc cu-teq ndô a-lứng cơt ti-cuôi bôn ti-nớng ŏ tớq te callong tin. <verse eid="HEB 11:7" /><verse number="8" style="v" sid="HEB 11:8" />Nhơ callong tin, co bôn arô, A-pra-ham khoiq peh par-nai dŏq pôq tớq ntúq ndon án cơt ưlla máh nốh, a-lứng án khoiq pôq ma lớiq chom án chón pôq tu-mo. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />Nhơ callong tin, án át tớq cruông cu-teq a-rớq ti-cuôi tu-moi, ndóng khoiq tu-mống tớq dúng prới a-lớng I-sac nha Ya-côp, máh ti-cuôi chúng tưi mun na par-nai par-ưq, <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />co án ng-cong mui vel bôn pi-tứng ta-nang, ndon Án Teng Cơt nha Ti-cuôi A-yứng na vel ngki la Yang Arbang Pilŏ́ng. <verse eid="HEB 11:10" /><verse number="11" style="v" sid="HEB 11:11" />Nhơ callong tin, ma lư Sa-ra khoiq bôn ráp te callong át cháq iki ntro lư khoiq vít dyơ ngư bôn a-cái, co án náp lư Yang khoiq par-ưq la ti-nớng tu-pứng. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />Co iki, lư te ntúq mu náq ti-cuôi — a-lứng tam lư a-rớq cu-chet dyơ — máh pang a-cái a-cháu bôn car-nian, rứh clứng lư a-rớq pan-tôr tớq pilŏ́ng, a-lứng a-rớq chuah lớiq rap ngiaih tớq tor dơq ving ca-vang. <verse eid="HEB 11:12" /><verse number="13" style="v" sid="HEB 11:13" />Tớq callong tin, nhéq máh ti-cuôi ndô khoiq cu-chet ndóng i-yốh bôn ráp par-nai par-ưq, ma bôn hôm a-lớng sáng bui máh nốh ngki te yông, dyơ ngin idô nha-án la ti-cuôi laq nha ti-cuôi tu-moi te yông tớq cúc cu-teq ndô. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />Co máh ti-cuôi ndon ngin máh nốh ngki dyôn hôm ar-lớih lư nha-án át si-suô mui cruông tam-me. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />Khán nha-án ayư cruông ndon nha-án khoiq te ngki tôi, lư ar-lớih nha-án têq dŏq píh chô liêh. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />Ma hoi ngki nha-án ính bôn mui cruông ŏ lư tháng, ngki la cruông tớq pilŏ́ng. Co iki Yang Arbang Pilŏ́ng lớiq sáng a-chiêt te nha-án, dŏq têq ngin la Yang Arbang Pilŏ́ng na nha-án, co Án khoiq suan mui vel pưt dyôn nha-án. <verse eid="HEB 11:16" /><verse number="17" style="v" sid="HEB 11:17" />Nhơ callong tin, A-pra-ham mŏp I-sac ndóng bôn callong chim, díh ndóng ráp máh par-nai par-ưq, án khoiq dông mŏp a-cái conh nưm mui na án, <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />ma te a-cái ngki, bôn par-nai tông idô: “Co I-sac, tŏ́ng toiq na a-cái lư bôn dŏq a-nốh,” <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />co khoiq par-ngíh idô Yang Arbang Pilŏ́ng bôn chức táq dyôn tu-mống liêh, nhéq te cu-chet, a-lứng têq taq-ntêr, án khoiq bôn liêh a-cái án te ntúq ngki. <verse eid="HEB 11:19" /><verse number="20" style="v" sid="HEB 11:20" />Ngki nhơ callong tin, I-sac tông dyôn bún ada Ya-côp nha Ê-sáu te máh ar-náq lư ính tớq. <verse eid="HEB 11:20" /><verse number="21" style="v" sid="HEB 11:21" />Nhơ callong tin, ndóng tu-mán ính cu-chet, Ya-côp tông callong bún dyôn cứp náq a-cái conh na Yô-sep, dyơ ca-niq tớq plô tar-lông na án, án chóh tar-col sang tám. <verse eid="HEB 11:21" /><verse number="22" style="v" sid="HEB 11:22" />Nhơ callong tin, ndóng cloiq pang tu-mống, Yô-sep ca-tớih te tôm ar-náq na a-cái a-cháu Isa-ra-el a-lứng pa-táp nha-án te ng-hang na án. <verse eid="HEB 11:22" /><verse number="23" style="v" sid="HEB 11:23" />Nhơ callong tin, cua bôn car-nian, Môi-se khoiq bôn a-ám a-i án dông ca-tốq tớq pe ki-sái co nha-án hôm án a-maiq ŏ, a-lứng nha-án lớiq a-dáh par-nai na puô. <verse eid="HEB 11:23" /><verse number="24" style="v" sid="HEB 11:24" />Nhơ callong tin, ndóng khoiq críh, Môi-se lớiq dyôn ngai dŏq la a-cái conh na a-cái cán Pha-ra-ôn. <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />Ma lư, the án chiuq a-rức mu nơi a-lứng ti-cuôi veng Yang a-láng bôn bui hơr mu hoi sớng na callong luaih. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />Án par-ngíh chiuq callong diêiq a-rức co Yang Choi Ta-mống ngki tar-náp hơn máh mun ntưn na Ê-yip-tô, co án át ng-cong u-rớh bôn cống na án. <verse eid="HEB 11:26" /><verse number="27" style="v" sid="HEB 11:27" />Nhơ callong tin, án ngốh te Ê-yip-tô, lớiq a-dáh callong pi-ốh na puô, co án chiuq ta-nhir iki níc át bôn hôm Án ndon lớiq tê hôm. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />Nhơ callong tin, án táq rit Ayư I-ngái Ngốh a-lứng callong ng-cráih a-ham, dŏq tar-neng Yang ca-chet máh a-cái pông ma lớiq ca-chet a-cái pông ti-cuôi prái. <verse eid="HEB 11:28" /><verse number="29" style="v" sid="HEB 11:29" />Nhơ callong tin, ti-cuôi Isa-ra-el pôq cláh na Dơq Ving Ca-vang Cu-sáu a-rớq pôq na cu-teq preng, la ntúq ndon ti-cuôi Ê-yip-tô khoiq dơq ngki cu-lứp chón ndóng veng ta-pun. <verse eid="HEB 11:29" /><verse number="30" style="v" sid="HEB 11:30" />Nhơ callong tin, car-rống vel Yê-rê-cô ar-líh, vít ndóng pôq viêl díh tu-pul i-ngái. <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />Nhơ callong tin, cán táiq cháq nốh Ra-hap lớiq cu-chet mu nơi a-lứng máh ti-cuôi lớiq náp peh, cua dyơ ráp chom máh ti-cuôi ndon ti-tuaiq dyơ cơt tár ŏ. <verse eid="HEB 11:31" /><verse number="32" style="v" sid="HEB 11:32" />A-lứng cư têq tông pi-lư callong a-mớh nnáng? Co i-ngái lư ớq bôn dyôn cư ính roih liêh te Kê-dê-ôn, Ba-rac, Sam-sôn, Yep-thê, Da-vit, a-lứng díh Sa-mu-ên nha máh ti-cuôi tang ng-cang, <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />la máh ti-cuôi, nhơ callong tin, khoiq chíl rap máh cruông, táq ar-náq crái piaiq, bôn ráp par-nai par-ưq, ca-pát ng-cang cu-la, <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />pu-pát pallô na uih chéh, viar vít te pla dau, bôn bánh rêng te callong iêuq thor, cơt clŏ́q ndóng tar-chíl, táq dyôn máh top líng tới ti-cuôi Isa-ra-el cơt pláh chap. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />Clứng ti-cuôi cán bôn liêh ti-cuôi mu dúng khoiq cu-chet na nha-án te ar-náq tu-mống liêh, ma máh ti-cuôi can-nŏ́h ndon ngai tính púh, lớiq ính ngin dŏq têq tar-cláh, co nha-án rêh callong tu-mống liêh ngki ŏ hơn; <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />ma ti-cuôi can-nŏ́h hơ khoiq chiuq callong chim te máh par-nai ca-priaq a-lứng ngai prớih, ma hơn te ngki loi la ngai chóq nha crál tớq cŏq tôt. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />Nha-án ngai tíq tớq búl, ngai kít bar béq, nha-án chiuq callong chim, cu-chet co pla dau ca-chet, nha-án pôq tu-dô tu-ki sứp au tớq ng-cár cưu, ng-cár mbeq, chiuq diêiq a-rức, ngai tính púh, ngai táq tôiq bap lư; <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />(ma cúc cu-teq ndô ngki lớiq piaiq dyôn nha-án át), cơt tôi tu-dô tu-ki tớq ntúq aih, tớq cóh, tớq cưp, a-lứng tớq hóng pưn cu-teq. <verse eid="HEB 11:38" /><verse number="39" style="v" sid="HEB 11:39" />A-lứng cua dyơ bôn ayô co nhơ callong tin, nhéq máh ti-cuôi ndô i-yốh ráp liêh par-nai par-ưq dyôn nha-án, <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />co Yang Arbang Pilŏ́ng khoiq thuan dŏq nốh ŏ hơn dyôn top he, khán ớq hôm top he, nha-án lớiq têq táq dyơ máh ar-náq.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Co iki ma khán, chón ndóng bôn tớq tu-lúc lư pưt na clứng ti-cuôi bôn hôm pa-niar nha-án, ngki top he, vít dyơ luaiq táh máh crơng ntáng nha callong luaih lam-bơ táq dyôn ar-búc, lư cóq ta-lúh tam-pring khoiq dŏq a-nát chứng mát nha-án te callong chiuq ta-nhir, <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />cóq me níc nga Yang Yê-su, Án Plô Soi a-lớng Án Táq Nhéq na callong tin, la Án co sáng bui dŏq chứng mát án khoiq chiuq cu-chet tớq callong calláng, lớiq sáng a-chiêt a-mớh, a-lứng Án khoiq ti-cu tớq pa a-tớm tar-cu Yang Arbang Pilŏ́ng. <verse eid="HEB 12:2" /><verse number="3" style="v" sid="HEB 12:3" />Cóq par-ngíh níc nga Án khoiq chiuq ta-nhir te ar-náq ngki co máh ti-cuôi bôn luaih chíl liêh nha-án, dŏq i-nha lớiq a-leq a-láh tớq mít can-nính i-nha, dáh lơ pê pa-hơm.<verse eid="HEB 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 12:4" />I-nha khoiq i-yốh chíl pa-liêh tar-lúh díh hóc a-ham ndóng chíl liêh callong luaih, <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />ma i-nha khoiq clớiq dyơ callong khêr, la par-nai ca-tớih tông i-nha a-rớq a-cái:</para>
  <para style="q1" vid="HEB 12:5">“A-cái na cư ơi, êq ayê callong dyŏq na Yang,</para>
  <para style="q1" vid="HEB 12:5">a-lứng êq pê can-nính ndóng Án pa-cliêq;<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />Co ti-cuôi Yang a-moih, Án pa-cliêq,</para>
  <para style="q1" vid="HEB 12:6">a-lứng Án pa-cliêq cứp náq ti-cuôi a-cái ndon Án ngin.”<verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />I-nha chiuq ta-nhir tớq callong pa-cliêq; Yang Arbang Pilŏ́ng me i-nha a-rớq a-cái. Co ti-cuôi a-cái mmo ma a-ám lớiq pa-cliêq? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />Ma khán i-nha lớiq chiuq callong pa-cliêq, la callong ndon nhéq tưh a-cái a-con khoiq cơt máh ti-cuôi chiuq tưi, khán iki i-nha la a-rớq a-cái tar-ríh, ma tới la máh ti-cuôi a-cái lư. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />Clưi ngki, top he bôn máh ti-cuôi a-ám tớq sac sáiq na i-nha, a-rớq máh ti-cuôi pa-cliêq, a-lứng top he yôl dyám náp; ma ada a-ám na ar-vai, ngki lớiq top he cam-máng ada a-ưi hơn, a-lứng top he lư tu-mống? <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />Co ntro a-ám tớq sac sáiq pa-cliêq top he nưm biaq i-ngái veng can-nính ính a-rớq ngki la ŏ lư ada nha-án, ma A-ám tớq ar-vai pa-cliêq co tar-náp dyôn top he, dŏq bôn chúng tưi callong práh ŏ na Án. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />Ma cứp callong pa-cliêq chón ndóng ngki lớiq sáng a-mớh la bui hơr, ma lư diêiq a-rức, tớq i-ngái ta-tun, nốh ngki cơt cu-lái iên ŏ na callong ti-nớng ŏ dyôn máh ti-cuôi khoiq bôn rian na nốh ngki. <verse eid="HEB 12:11" /><verse number="12" style="v" sid="HEB 12:12" />Co iki, cóq a-rơq liêh máh ưllang ati a-leq a-láh a-lứng máh tar-col khoiq cớng, <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />nha cóq táq ti-nớng máh car-na pôq dyôn dyưng i-nha, dŏq ti-cuôi dyuat têq lớiq clu car-na, ma lư tớq ngki la têq pa-lai bánh.<verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />Cóq si-suô dyôn iên ŏ a-lớng cứp náq ti-cuôi, nha can-nính práh ŏ, khán lớiq bôn nốh ndô ớq nnáu têq bôn hôm Yang, <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />Cóq mmứng ada ŏ, dáh lơ ti-cuôi mmo ớq bôn ráp te callong choi mat na Yang Arbang Pilŏ́ng, cơt a-rớq riaih a-táng tớq i-nha dáh pưt a-sớr táq diêiq a-rức, a-lứng clứng ti-cuôi têq cơt rúng pít co ar-náq ngki, <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />êq ti-cuôi mmo bíq mu nơi tới cam-pái ca-yiêq lớiq la táq luaih a-rớq Ê-sáu, la ti-cuôi co ính bôn mui pêl cha khoiq táiq chức sút ngki na án. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />Co i-nha chom ar-lớih tar-lúh ta-tun, ndóng ính bôn callong bún, án khoiq ca-lôih, co án ớq bôn tu-múh ntúq dŏq ngin luaih, ntro lư si-suô án sŏ́ng a-lứng dơq mát.<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />Co i-nha khoiq lớiq tớq tar-mán a-lứng nốh têq bôn ca-pơiq, ngki uih chéh pallô, ngki i-dáu, ngki ngiau tứng pứng, nha a-lứng cu-yiêl ar-puq <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />a-lứng bôn siêng car-sang na tang-coi, nha a-lứng siêng na máh par-nai ndon máh ti-cuôi cam-máng khoiq tar-seq dŏq nha-án lớiq ráp liêh mui par-nai mmo nnáng. <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />Co nha-án lớiq rap chiuq díh siêng ngki pa-táp, idô: “Khán pan-nán mmo ma a-dưr cóh ndô, án cóq cu-chet tíq na búl.” <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />A-lứng nốh ngki dŏq a-páh ngki sáng a-dáh tar-lúh Môi-se tông idô: “Cư sáng a-dáh a-lứng ca-dyír.” <verse eid="HEB 12:21" /><verse number="22" style="v" sid="HEB 12:22" />Ma, i-nha khoiq tớq nga Cóh Si-ôn nha vel na Yang Arbang Pilŏ́ng tu-mống níc, a-lứng Yaru-salem tớq pilŏ́ng, bôn clứng tar-neng yang, par-chúng mu nơi, <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />tớq dúng rum na máh a-cái pông khoiq bôn ta-ran nốh tớq máh lưp pilŏ́ng, a-lớng Yang Arbang Pilŏ́ng la Án Sưq na cứp náq ti-cuôi, a-lứng tớq ar-vai na máh ti-cuôi ti-nớng ŏ khoiq dŏq táq dyôn cua nhéq, <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />A-lứng Yang Yê-su, Án Ndon Tư-li na car-hŏt tam-me, a-lứng a-ham ndon khoiq ngốh lư pưt tar-náp clưi te a-ham A-ben. <verse eid="HEB 12:24" /><verse number="25" style="v" sid="HEB 12:25" />Cóq mmứng a-ŏ, dáh lơ i-nha lớiq ính cam-máng Án chón tông ca to. Co khán máh ti-cuôi ngki khoiq lớiq têq vít ndóng lớiq ính cam-máng ti-cuôi pa-táp nha-án tớq cúc cu-teq, top he a-cán lớiq têq viar, ndóng máh ti-cuôi ndon nguai a-lớng Án tớq te pilŏ́ng, <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />ma siêng na Án ngki khoiq táq dyôn cu-teq ca-cưt tớq i-ngái ngki, ma hoi ngki Án khoiq ưq idô: “Mu chư loi Lư Cư táq dyôn ca-cưt, lớiq nưm cu-teq ma díh pilŏ́ng.” <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />Ma par-nai “Mu chư loi” dyôn chom ar-lớih ar-náq pít nhéq máh nốh ndon ca-cưt, a-rớq nốh khoiq dŏq teng cơt, dyôn têq máh nốh lớiq bôn ca-cưt ma yôl liêh. <verse eid="HEB 12:27" /><verse number="28" style="v" sid="HEB 12:28" />Co iki, top he cóq bôn mít si-ơn ndóng ráp mui cruông lớiq ca-cưt, ma te ngki top he têq sang tám dyôn bui can-nính Yang Arbang Pilŏ́ng, ada mít dyám náp a-lớng a-dáh, <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />co Yang Arbang Pilŏ́ng na top he a-rớq pallô uih chóng ng-cat.<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Callong ar-moih i-nha cóq yôl át níc. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />Êq táq clớiq ráp chom tu-moi, co te callong ndô, bôn ti-cuôi khoiq lớiq chom ma ti-ráp máh tar-neng yang. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />Cóq ayư nga máh ti-cuôi ndon át tớq cŏq tôt, mu chứng khoiq át tôt mu nơi a-lứng nha-án, nha máh ti-cuôi ndon tu-múh diêiq a-rức, mu chứng i-nha khoiq tu-múh diêiq a-rức mu nơi tưi. <verse eid="HEB 13:3" /><verse number="4" style="v" sid="HEB 13:4" />Cơt cam-pái ca-yiêq la lư ŏ te cứp náq i-nha, a-lứng bíq mu nơi la ớq luaih a-mớh, co Yang Arbang Pilŏ́ng lư sưq máh ti-cuôi bíq mu nơi tới cam-pái ca-yiêq nha ti-cuôi láh par-lưi. <verse eid="HEB 13:4" /><verse number="5" style="v" sid="HEB 13:5" />Pang tu-mống i-nha cóq êq ham práq, sáng bui te máh nốh chón bôn, co lư Án khoiq tông: “Cư lư lớiq yông te a-cái, Cư lư lớiq táh a-cái,” <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />iki, co bôn mít clŏ́q, top he ca to:</para>
  <para style="q1" vid="HEB 13:6">“Yang la Án Tár Choi cư nha cư lư lớiq sáng a-dáh.</para>
  <para style="q1" vid="HEB 13:6">Ti-cuôi lư táq i-mo cư?”<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />Cóq ayư nga máh ti-cuôi a-yông i-nha, la máh ti-cuôi ca to Par-nai na Yang Arbang Pilŏ́ng ada i-nha, par-ngíh liêh te pang tu-mống na nha-án, cóq soi callong tin na nha-án. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />Yang Choi Ta-mống Yê-su i-nô, i-ngái ndô a-lứng ti-ngôi díh sút pang ma lớiq táh a-tức. <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />Êq dyôn ngai par-yông na veng a-ưi ngê ndái. Co callong ŏ dyôn mít can-nính cơt khớm na callong choi mat tới na crơng tan-na cha, ma ada máh nốh ngki, máh ti-cuôi tu-mống co nha-án ớq bôn tar-náp a-mớh. <verse eid="HEB 13:9" /><verse number="10" style="v" sid="HEB 13:10" />Top he bôn tưi pa-rông sang, ma te ndô, máh ti-cuôi tar-choi ar-náq tớq dúng prới ớq bôn chức cha. <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />Co a-ham pu-pít luaih, la car-yáh te máh pan-nán, bôn dông nga ntúq lư práh na a-riaih top teng rit sang, ma cháq na pan-nán ngki ngai bóh cu-lai tiêh ti-cuôi át. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />Iki tưi, Yang Yê-su la khoiq chiuq cu-chet cu-lai tiêh ngáh callống car-rống vel, dŏq Án têq táq dyôn práh ŏ máh ti-cuôi nhơ a-ham na án táp. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />Co iki, top he cóq tớq nga Án cu-lai tiêh ti-cuôi át, dŏq chiuq callong diêiq a-rức na Án. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />Co top he ớq bôn mui vel mmo yôl níc ntúq ndô, ma, top he chón si-suô mui vel ính tớq. <verse eid="HEB 13:14" /><verse number="15" style="v" sid="HEB 13:15" />Co Án, top he têq mŏp sang par-nai ayô dyôn Yang Arbang Pilŏ́ng te cứp nốh, ngki la cu-lái na ng-cang ngin nốh Án. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />Ma ar-náq táq callong ŏ a-lứng ính tar-choi ngki êq táq clớiq co Yang Arbang Pilŏ́ng sáng bui can-nính te máh crơng mŏp sang a-rớq ngki. <verse eid="HEB 13:16" /><verse number="17" style="v" sid="HEB 13:17" />Cóq náp peh a-lứng cam-máng máh ti-cuôi sút i-nha, co nha-án kiaq me te ar-vai i-nha a-rớq ngki cóq ntêr liêh ar-náq khoiq táq, táq dyôn nha-án têq táq ar-náq ngki te mít sáng bui ma lớiq sáng a-nguaq, co ar-náq ndô ớq tar-náp ada i-nha.<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />Cóq cớu seq dyôn top he, co top he tin ar-lớih idô top he bôn mít can-nính ŏ, nưm ính tu-mống dyôn crái piaiq tớq cứp ar-náq. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />Ma cư át seq i-nha táq iki a-ưi lư loi, dŏq cư chái bôn chô liêh a-lớng i-nha.<verse eid="HEB 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />Yang Arbang Pilŏ́ng iên ŏ, Án khoiq dông Án Kiaq Cưu Pưt, Yang Yê-su top he, te cu-chet na a-ham car-hŏt díh sút pang, <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />seq Án choi dyôn i-nha te cứp nốh ŏ dŏq táq veng can-nính na Án, ndóng táq nốh crái piaiq chứng mát Án tớq top he, nhơ Yang Choi Ta-mống Yê-su, la Án ndon ang ưr te Án ti-ngôi díh sút pang lang dơi. A-men.<verse eid="HEB 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />Em ai ơi, cư seq i-nha chiuq ta-nhir par-nai a-liam ndô, co cư ta-ran dyôn i-nha nưm na máh par-nai sớng. <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />I-nha chom dyơ em ai nốh Ti-mu-thê na top he khoiq ngai ta-láh dyơ, la co án cư lư tar-múh i-nha khán án tớq chái.<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />Seq car-hanh nhéq máh ti-cuôi sút i-nha a-lứng nhéq máh top tin. Máh ti-cuôi tin tớq I-ta-li seq car-hanh i-nha.<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />Seq callong choi mat át a-lứng nhéq náq i-nha.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>