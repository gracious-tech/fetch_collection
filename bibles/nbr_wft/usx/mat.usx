<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id" />
  <para style="h">Mat</para>
  <para style="toc1">Mat</para>
  <para style="toc2">Mat</para>
  <para style="toc3">Mat.</para>
  <para style="mt">The Gospel of Mathew</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Nga ŋli kɛ Yesɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Waŋa ayi cɛr iyi nga ŋli kɛ Yesɔ Kristi, izu Doda, izu Ibrai. <verse eid="MAT 1:1" /><verse number="2" style="v" sid="MAT 1:2" />Ibrai neyi Tetɛɛ amaa Ishaku, Ishakumɔ neyi Tetɛɛ maa Yakubu, Yakubu ayi Tetɛɛ amen ane Juda bǝn amunzumen, <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />fena Perez bǝn Zǝra neyi ŋli kɛ Juda, Tamar wa neyi yaa mǝne, Perez neyi Tetɛɛ amaa Hezron, Hezron neyi Tetɛɛ maa Ram, <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />Ram neyi Tetɛɛ ma Aminadab, Aminadab neyi Tetɛɛ maa Nashon, fena, Nashon neyi Tetɛɛ amaa Salmɔn <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />Salmɔn neyi Tetɛɛ amaa Buaza ŋli kɛ Rahab, Buaza neyi Tetɛɛ amaa Abadiya, waŋ ndi azhɔ yaa maa te Rut, Abadiya neyi Tetɛɛ amaa Jese, <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />fe Jese ne ŋli Doda ndi neyi itum. Doda ne ŋli Solɔmɔn waŋ ndi yaa maa aneyi iwa Yuriya.<verse eid="MAT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 1:7" />Solɔmɔn ne ŋli Rehobam, Rehobam ne ŋli Abija, teduŋ Abija ne ŋli Asa,<verse eid="MAT 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 1:8" />Asa ne ŋli Jehoshafat, Jehoshafat ne ŋli Joram, ankyak Joram ne ŋli Azariya <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Azariya ne ŋli Jotam, Jotam ne ŋli Ahas, Ahaz ne ŋli Hezekiya, <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Hezekiya ne ŋli Manase, Manase ne ŋli Amɔn, Amɔn ne ŋli Josiya, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Josiya ne ŋli Jekɔniya ben amunzumen ne mkpaŋa ne vu ba agɛn te kɔmɔ ne ntun ŋgɔŋ iyi Babila.<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />Fena mkpaŋ keŋ ndi ne ka gli ba anyɛ ntun Babila, Jekɔniya ne ŋli Sheltiye, Shɛtiyel ne ŋli Zerubabɛl, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />Zerubabɛl ne ŋli Abihud, Abihud ne ŋli Eliyakim, Eliyakim ne ŋli Azor, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />Azor ne ŋli Zadɔk, Zadɔk ne ŋli Akim, Akim ne ŋli Aliud, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Aliud ne ŋli Eliyaza, Eliyaza ne ŋli Matan, Matan ne ŋli Yakubu, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />Yakubu ne ŋli Yusuu waŋ ndi neyi lu maa Meryamu waŋ ndi ne ŋli Yesɔ ndi azhɔu te Kristi. <verse eid="MAT 1:16" /><verse number="17" style="v" sid="MAT 1:17" />Fena, ŋli bɔbɔk kɛ Ibrai kɔmɔ te tar bǝn Doda neyi nga wur ane nas, ina kam baŋ rɛ ben Doda gar kɔmɔ ne mkpaŋ kɛ vuu ba agɛn te yar Babila ayi nga wur anenas, ina vuŋ mkpaŋ kɛ rɛ ŋli Mezaya anayi nga wur ane nas.<verse eid="MAT 1:17" /></para>
  <para style="s">Iŋli kɛ Yesɔ</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Waŋa ayi iyiŋ ndi ŋli kɛ Yesɔ Kristi ne yime, ne mkpaŋa Yusuu ane tɔk Meryamu ine ta, fena bane azǝne zhi akpamen ba, alɔ yik Meryamu agli nnɛ ikɛ Izhu Tsetser <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Yusuu vǝnenzak amaa atsǝn tsǝn didik ne ankɔŋ ane yaŋ la lɛ, ne yiŋɛ bane gbu ilɛmɛ aŋaa ba, Yusuu ne Gli ilɛmɛ ne susun maa kɛ kyagu raraŋ.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />Fe neka wɔb kam susun ne atu amaa, ankyak ine shar ayou Arik Ŋgɔŋ amunoruu ne rimla tedi, Yusuu izu Doda, duŋ diu klu sisik baŋ Meryamu te bɛ yi iwa mi ba, te vǝvǝn ndi ayime ne nemɛ arɛ ben Izu Tsetser. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Meryamu atei ŋli ven lum utei zhɔ sak maa te Yesɔ, iwa atei ta aneshir amaa ne zumimin azhɔk. <verse eid="MAT 1:21" /><verse number="22" style="v" sid="MAT 1:22" />Iki yiŋɛ ne shaga te abɛ gli kɛ kuŋkum ne anu ine bla shar yi Arik, <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />&lt;&lt;Vǝnwa atei gli ne te ŋli vǝvenlum, atei zhɔ sak maa te Imanue&gt;&gt; Izhɔ saga idi,&lt;&lt; Arik ayi bene bɛta&gt;&gt;. <verse eid="MAT 1:23" /><verse number="24" style="v" sid="MAT 1:24" />Fe ndi Yusuu ne kama si akɔ na ki yiŋ ndi ine shar ayou Arik Ŋgɔŋ ne diu abɛ na akɔ ta Meryamu te abɛ yi iwa maa.<verse eid="MAT 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 1:25" />Bane zhi Meryamu ba se ndi ne ŋli baliŋ. Yusuu ne zhɔ sak maa te Yesɔ.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Acɛn abɛ rɛ ti kɛ anzaŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Mkpaŋ keŋ ndi ne ŋli Yesɔ ne Batalami ne Yahudiya, ne mkpaŋ kɛ itum Hiridus, Fe anuŋ abɛ zhi cinces nɛrɛ ti kɛ anzaŋ te nyɛ Urshelima <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />te rib, &lt;&lt;Waŋ ndi ne ŋliu itum ane Yahudawa ma, ayi neme? Taniyik ncinces maa tedi duŋ ta nyɛ tɔ te zekuru.&gt;&gt;<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Ndi itum Hiridus ne wɔ ilɛmɛ susun maa cɔkla, te ben aner abɛ Urshelima <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Ankyak, akɔ zhɔ ngɔŋ ne abɛ na ndum kǝ Arik ben abɛ tsar lɛ kɛ Arik te rib ba amkpawaŋ ndi ne ŋli Mezaya ma. <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Ablau, &lt;&lt;Nǝ Batalami ntun ye Yahudiya,&gt;&gt; &lt;&lt;te waŋai ki yiŋ ndi abɛ bla shar yi Arik ne cɛr:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />&lt;&lt;&lt;Fe iwa, Batalami, ne gar kɛ Yahudiya,</para>
  <para style="q2" vid="MAT 2:6">Bai waa yi ambusher ne miŋ abɛ gli ntun yi Yahudiya ba;</para>
  <para style="q1" vid="MAT 2:6">Nǝ miŋ min itum atei nyɛ</para>
  <para style="q2" vid="MAT 2:6">Ai waŋ ndi atei kyu aner amuŋ Isrela.&gt;&gt;&gt;<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Ankyak Hiridus akɔ zhɔ aner abɛ zhi ncinces raŋ te wa bɛ wɔ ben aba anenen mkpaŋ keŋ ndi ncinces ne mun ruu. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Akɔ shar ba ne Batalami tedi, &lt;&lt;Tsǝn zhin bwe te wɔb amkpawaŋ ndi vǝvǝne ayime. Izhin te yigu, kam nyɛ blam azhin, tem ka ngar zekuru muŋ yi.&gt;&gt;<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Mkpaŋ keŋ ndi ne wɔ lɛ kɛ itum, akɔ vuŋ tsǝn men fe ncinces yiŋ ndi ne yigǝ ikuti akɔ zǝǝ ikɔ te gburkli ne amkpa waŋ ndi vǝvǝne ayime. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Ndi neyik ncincese, akɔ nyer ŋgɔŋ. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Ndi ne yir kɔbɔ, akɔte yik vǝvǝne bǝn Meryamu yaa maa, akɔ zekuru te gbaru asak. Akɔ bu abu te vu kiki yiŋ ndi ne gliu ma te nugu zineriya, turare bǝn mur. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Fe ine shar ayou Arik ne gbaŋ ba atɔŋ ne rimla tǝ bɛ duŋ aŋur akam ate yik Hiridus ba, akɔ ŋur akam azǝ ankɔŋ anuŋ te kɔmɔ ne ntun men.<verse eid="MAT 2:12" /></para>
  <para style="s">Iklu kɔmɔ ne Masar</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Mkpaŋ keŋ ndi abɛ zhi ncinces ne kɔmɔ, ine shar ayou Arik amuno ruu Yusuu ne rimla. &lt;&lt;Lu,&gt;&gt; adiu, baŋ asen Vǝvǝne ben yaa maa te klu kɔmɔ ne Masar. Sɔŋ amɔ se mkpaŋ ndi mne blau, Hiridus atei shik vǝvǝne ne wɔb ŋun.&gt;&gt; <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Fe akɔ lu, te baŋ vǝvǝne ben yaa maa ne bu te kɔmɔ ne Masar, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />ne sɔŋ amɔ te wɔ iku kɛ Hiridus. Fena nken ilɛmɛ ne shaga ilɛ keŋ ndi Arik ne bla nenu abɛ bla shar maa: &lt;&lt;Nǝ Masar mne zhɔ Izu muŋ.&gt;&gt;<verse eid="MAT 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Mkpaŋ keŋ ndi Hiridus ne zhi te abɛ zhi ncinces alɔmu ate kpuguruk, akɔ te mfu tetɛk te nek nkenlɛ tedi abe ŋlɔk asen amunlum ne Batalami bǝn ntun yi nyaŋǝ ase ayaa kam nyak goŋ ibaŋ rɛ ne mkpaŋ keŋ ndi neyik abɛ zǝ ncincese. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Fena ikiyiŋ ndi ine bla shar yi Arik ndi azhou te Irmiya ne blai ne shaga:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />&lt;&lt;Ne wɔ ikɔr ne Rama,</para>
  <para style="q2" vid="MAT 2:18">Ŋarzhin yaŋ klɛ te nek lɛ,</para>
  <para style="q1" vid="MAT 2:18">Rahila azhin amumun amaa te kyak ta tek aneshir,</para>
  <para style="q2" vid="MAT 2:18">Tǝ amumune ba na yime ba.&gt;&gt;<verse eid="MAT 2:18" /></para>
  <para style="s">Ŋurkam kɔmɔ ne Nazara</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Ndi Hiridus ne ku, ine shar ayou Arik amuno aruu Yusuu ne rimla ne Masar <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />te di, &lt;&lt;Lu klɛ, baŋ vǝvǝne bǝn yaa maa te kɔmɔ ne gar Isrela, te abaŋ ndi ne wɔb ivli kǝ asen vǝvǝne neka ku.&gt;&gt;<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />Ankyak Yusuu akɔ lu, te abaŋ vǝvǝne bǝn yaa maa te kɔmɔ ne gar kǝ Isrela. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Ndi ne wɔ te Akiliyus wa sɔŋɔ gli itum kɛ Yahudiya ne gɔŋ ku Tetɛɛ amaa Hiridus, sisik vuŋu ne ŋur kama, ndi ne gbaŋu atɔŋ ne rimla, akɔ kama kɔmɔ ne gar kɛ Galili, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />ne kama ate sɔŋ ne ntun yi zhɔ te Nazara. Nǝ shaga ndi ine bla shar yi Arik ne bla: &lt;&lt;atei zhɔu te Awɔnǝ Nazarin.&gt;&gt;<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Yɔɔna ne su aneshir ne na ankɔŋ</para>
  <para style="p">(Markus 1:1-8; Luka 3:1-18; Ya 1:19-28)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Nǝ mkpaŋ yuŋɔ Yɔɔna ne su aneshir ne nyɛ, te du lɛ kɛ Arik ne shu hwaŋ kɛ Yahudiya <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />Tǝ di, &lt;&lt;duŋ nazhin zumimin, te ikɔb kǝ gbarshu ne te gbahir.&gt;&gt; <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Waŋa ayi wa ndi ne lǝlɛ maa ne anu akɛ ine bla shar yi Arik ndi azhɔu te Ishaya:</para>
  <para style="q1" vid="MAT 3:3">&lt;&lt;Ikɔr zǝn zhɔ ne zizik,</para>
  <para style="q1" vid="MAT 3:3">&lt;Na zhin Arik Ŋgɔŋ ankɔŋ&gt;,</para>
  <para style="q2" vid="MAT 3:3">Nab zhin ne wu ankɔŋɔ.&gt;&gt;&gt;<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Nkluŋklu yi su Yɔɔna ne nai ne mfumfuk kpa iyi lakurmi, te na yi ne ririk keŋ ndi avuŋ tiŋ ne maa. Kili maa iyi Adagbyaŋ bǝn ntun. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Aneshir azǝn zeu gar igar ke Urshelima bǝn ŋa kɛ Yahudiya te yar ntun yi gar ke inek ne juda. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Te bla zumimin yiŋ ndi aba na te, akɔ suu ba ne inek ne Juda.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Fe ndi ne yik aneshir tetɛk bǝn Ferisawa azǝn nyɛ, bǝn Sadukiyawa ne amkpawaŋ ndi azǝn su aneshir, Yɔɔna akɔ di ba: &lt;&lt;Izhin ane wa amimin! ŋɔwa ne gbaŋ zhin atɔŋ te zhin bǝ klu mfu kɛ Arik? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Na zhin ki didik ndi itei tsar sen asusun min. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Fe kǝr ubǝ yik te utei lieru ba te di, &lt;Ibrai ayi ntsǝntsǝm ami,&gt; Mbla zhin kɔ ne miŋ kɛ mkpaŋ yiŋɛ Arik Ŋgɔŋ atei ya sɛne te bǝ kam yi Ibrai vǝvǝn. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Angen ayime ane tsɛ atiŋ ririŋ nkunkun, fe nkunkun keŋ ndi bate dɔ gbar didik ba, atei tsɔm kɛ atyak azhɔk ne lu.<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />&lt;&lt;Msu zhin ne amashir te zhin bǝ sen asusun amin. Fe iwaŋ ndi anyɛ ne gɔŋ muŋ aklik anaŋ me, akpaza ayi su amaa bam M tei nzugǝ yir ba. atei suu zhin ne Izhu tsetser bǝn lu. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Atsǝn ne mumu maa keŋ ndi atei zǝ antutur kpu aglɛ tibɛ te vuu mbyaŋ didige ashur ne wun te goŋ afumfu mɔ ne lu.&gt;&gt;</para>
  <para style="s" vid="MAT 3:12">Ne suu Yesɔ ne Amashir</para>
  <para style="p" vid="MAT 3:12">(Markus 1:9-11; Luka 3:12-22)<verse eid="MAT 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Ankyak Yesɔ ne rɛ Galili te gara yar nek ne Juda te Yɔɔna abɛ suu. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Fena Yɔɔna ne di wa kyak su ma te di, &lt;&lt;Ayi waa utei sum, fe ukam nyɛ bene bɛm?&gt;&gt;<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Yesɔ asaga, &lt;&lt;Duŋǝ bǝ yemɛ azizaŋa; iye anenen te tabǝ na iki didik yiŋ ndi Arik ne tanyɛmɛ neyi.&gt;&gt; Amɛ Yɔɔna akɔ tanyɛmɛ te suu.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Ndi ne su Yesɔ ne miŋ amashir te lɛgu arumɔ, ate naga ruu ne amashir gbarshu ku bu, akɔ yik Izhu yi Arik Ŋgɔŋ ikuti zǝǝ ndi angu te bwak sɔŋu ne mpa. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Ikɔr rɛ gbarshu tedi, &lt;&lt;Waŋa ayi Izu muŋ, waŋ ndim me nyeru.&gt;&gt;<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Ikituk ne ten Yesɔ ne zizik</para>
  <para style="p">(Markus 1:12-13; Luka 4:1-13)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Fena Izhu iyi Arik ne baŋ Yesɔ te gliu kɔmɔ ne zizik ŋgɔŋ te shetan bɛ tenu te wɔb zhaku maa. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Yesɔ ne kpa anu ne yaŋ li bǝn so bɛr sɔknas bǝn bu sɔknas, ikasa vuŋu. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Ankyak shetan anye bǝn abou te diu, &lt;Ate yi ndi uyi Izu Arik; kam mkpaŋ yiŋɛ tǝ bɛ kam tǝ kili.&gt;&gt;<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Yesɔ adiu, Ne cɛr: &lt;Bane kili yi ankyak Ineshir atei yi tsitsir ba, se ne nkanlɛ yi Arik ndi rurɛ anu amaa.&gt;&gt;<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Ankyak shetan atara baŋu te kɔmɔ ne Urshelima ntun ŋgɔŋ tsetser ne itushu kɛ akabakɔŋ. <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />&lt;&lt;Ate yi ndi uyi Izu Arik,&gt;&gt; adiu, &lt;&lt;tuk kyaŋ ku. Ne cɛr:</para>
  <para style="q1" vid="MAT 4:6">&lt;&lt;&lt;Arik atei duŋ ine shar ayou Arik ne atu ami,</para>
  <para style="q2" vid="MAT 4:6">Atei baŋu agli ne aŋɔk amen,</para>
  <para style="q1" vid="MAT 4:6">Ndi bau tei tar za ne mkpaŋ ba.&gt;&gt;<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Yesɔ adiu, &lt;&lt;Ne na cɛr: &lt;Duŋ diu ten Arik Ŋgɔŋ ami ba.&gt;&gt;&gt; <verse eid="MAT 4:7" /><verse number="8" style="v" sid="MAT 4:8" />Fena, shetan gliu te yuŋ tu gbu lǝlɛ te tsa ru akɔb angɔngɔŋ ayi gbarshu ne gɔnmimi bǝn irɛ maa. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />&lt;&lt;Tedi M tei nǝgu yi bɔbɔk,&gt;&gt; Adi, &lt;&lt;Utǝ zekuru te nek me ŋgɔŋ.&gt;&gt;<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Yesɔ adiu, &lt;&lt;kam tibɛ bene bɛm, shetan! Ne cɛr: &lt;Zekur Arik Ŋgɔŋ ami, iwa ankyak utei zeu.&gt;&gt;&gt;<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Ankyak shetan kɔ kama tibɛ, fe ine shar ayou Arik agar te kyuu gli.</para>
  <para style="s" vid="MAT 4:11">Yesɔ ne vuŋ du lɛ maa ne Galili</para>
  <para style="p" vid="MAT 4:11">(Markus 1:14-15; Luka 4:14-15)<verse eid="MAT 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Ndi Yesɔ ne wɔ tǝ nɛ zhɔk Yɔɔna ne Jaru, akɔ kɔmɔ ne Galili. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Ana duŋ Nazara, te kama te sɔŋ ne Kafanahum, ntun iyi gbahir ne gar kɛ Zabuluna ben Naptali <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />te bɛ shaga iki ndi Ishaya ine bla shar yi Arik ne bla:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />&lt;&lt;Ntun yi gar kǝ Zabuluna bǝn ntun yi Naptali,</para>
  <para style="q2" vid="MAT 4:15">Ankɔŋ ane nek ŋgɔŋ, te kɔmɔ ne nek ne Juda,</para>
  <para style="q2" vid="MAT 4:15">Nǝ Galili ne kɛ abɛ yaŋ zǝ Arik<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Aneshir abɛ sɔŋ ne bu</para>
  <para style="q2" vid="MAT 4:16">Ne yik laŋ abɛm ngɔŋ;</para>
  <para style="q1" vid="MAT 4:16">Aner abɛ sɔŋ ne izhu yi ku,</para>
  <para style="q2" vid="MAT 4:16">Ilaŋ abɛm ne hrie ba.&gt;&gt;<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Ibaŋ rɛ mkpaŋa Yesɔ akɔ du lɛ kɛ Arik, &lt;&lt;Duŋ zumimin, te ikɔb kǝ gbarshu ne te gbahir.&gt;&gt;</para>
  <para style="s" vid="MAT 4:17">Yesɔ ne zhɔ abɛ na ndum ma abɛ kuti</para>
  <para style="p" vid="MAT 4:17">(Markus 1:16-20; Luka 5:1-11)<verse eid="MAT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Ndi Yesɔ atsǝnetsǝn ne kɔn nǝk ne Galili, fe akɔ yik amunzu, Siman ndi azhɔu tǝ Biturus bǝn izumen, Anduru. Azǝne shur kɛli ne nek ayi aneshir abɛ vu ambɛ. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />&lt;&lt;Nyɛ, zǝme zhin,&gt;&gt; Yesɔ adi, &lt;&lt;M tei shar zhin te bǝ zhɔ aneshir glim ma.&gt;&gt; <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Andanda akɔ duŋ shur burgi me te zeu.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Ndi atsene kɔmɔ, akɔ yik amunzu amɛ ayaa, Yakubu izu Zebɛdi bǝn zumen Yɔɔna. Ayi ne miŋ igu bǝn Tetɛɛ men Zabɛdi, azǝn na burgi men. Yesɔ azho ba, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />andanda akɔ duŋ igu mɔ bǝn Tetɛɛ men te zeu.</para>
  <para style="s" vid="MAT 4:22">Yesɔ ne na abɛ lɔ</para>
  <para style="p" vid="MAT 4:22">(Luka 6:17-19)<verse eid="MAT 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Yesɔ ne zǝ ntun iyi Galili aklɛ, ne tsar ne akabakɔŋ, te du ilɛ didik kɛ ikɔb kǝ gbarshu, tena naa aneshir abe lɔ bɔbɔk te duŋ ba rɛ. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Ilɛ ma ne shak Asuriya bɔbɔk, ankyak aneshire gliu abɛ yi ne lɔ tetɛk, abɛ yik yaa, abɛ yi ne anerim, abɛ ku amkpen, abɛ ku kpaa gar zhin, ne naa aneshir abe lɔ teduŋ ba rɛ. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Aneshir tetɛk abɛ rɛ Galili, bǝn gar kɛ iyi ne ntun Urshelima, ben gar kɛ Yahudiya, te tar kɔmɔ ne ŋaa kɛ nek ne juda.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Yesɔ ne bla lɛ ne agaŋkubgbu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Ankyak ndi Yesɔ ne yik aneshir tetɛk, akɔ yuŋ agaŋkubgbu te zǝ sɔŋ. Abɛ tsene maa anyɛ bene bɔu, <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Akɔ tsar ba te adi.<verse eid="MAT 5:2" /></para>
  <para style="s">Anu adidik</para>
  <para style="r">(Luka 6.20-23)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />&lt;&lt;Abe ta anu didik iyi abaŋ ndi ayi abe iya ne izhu,</para>
  <para style="q2" vid="MAT 5:3">Ikɔb kǝ gbarshu yi men.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Abe ta anu didik ayi abaŋ ndi azhin,</para>
  <para style="q2" vid="MAT 5:4">Arik atei yis ba amayi,<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Abe ta anu didik ayi baŋ ndi ne nek tu,</para>
  <para style="q2" vid="MAT 5:5">Gɔnmimi itei yi men.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Abe ta anu didik abaŋ ndi kasa ne vuŋ ba bǝn hrie kɛ na iki didik yiŋ ndi Arik ne tanyɛmɛ neyi,</para>
  <para style="q2" vid="MAT 5:6">Atei duŋ ba hri.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Abe ta anu didik, abaŋ ndi alɔ susun,</para>
  <para style="q2" vid="MAT 5:7">Atei lɔ susun mǝne.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Abe ta anu didik abaŋ ndi susun mǝne yi tsetser,</para>
  <para style="q2" vid="MAT 5:8">Atai yik Arik.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Abe ta anu didik abaŋ ndi awɔb sɔŋ didik,</para>
  <para style="q2" vid="MAT 5:9">Atei zhɔ ba te amuen Arik.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Abe ta anu didik abaŋ ndi asak ba iya ne tu ayi na iki didik yiŋ ndi Arik ne tanyɛmɛ neyi,</para>
  <para style="q2" vid="MAT 5:10">Ikɔb kǝ gbarshu iyi men.<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />&lt;&lt;Abe ta anu didik ayi zhineba ndi aneshir apwar zhin aŋyak, te sak zhin iyah tena timu asak zhin te bla zhin lǝlɛ mimin ne atu amuŋ. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Nyer zhin tena duŋ asusun amin amen, te idǝk min ngɔŋ iyi ne gbarshu, amɛ ane nek abɛ bla shar yi Arik ndi ane kuuzhin ti ne ndum kɛ Arik iya.</para>
  <para style="s" vid="MAT 5:12">Mmaŋ ben laŋ</para>
  <para style="p" vid="MAT 5:12">(Markus 9:50; Luka 14:34-35)<verse eid="MAT 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />&lt;&lt;Izhineba yi mmaŋ yi gɔnmimi. Ama imen kɛ maŋa te naŋ dɔ, itei na men kikini? Ba na yine ki yi nama neyi ba, se abɛ tyage hrie ne mimi te caŋǝ ne za.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />&lt;&lt;Izhin yi laŋ yi gɔnmimi. Ntun yi sɔŋ ne tu gbu, ba suyir ba. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Neme aneshir ba tei sak lu ne pitila te suu aŋyak ne sesa ba. Ama abaŋu akɔr asak ne tu amkpadeb te bɛ laŋ ashak miŋ kɔbɔ. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Amɛ duŋ aneshire abɛ yik laŋ min, ate yik ki didik yi na min atei gbar asak Arik Tetɛɛ Ngɔŋ ne gbarshu.<verse eid="MAT 5:16" /></para>
  <para style="s">Itsar nǝ lɛ kɛ cɛr Musa</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />Fe Yesɔ adi, &lt;&lt;Duŋ yik zhin tem ne kam nyɛ zǝr icɛr yi Musa bǝn abɛ bla shar yi Arik; Bam ne nye tem zerǝ ba ama mduŋ kɛ shaga. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Mbla zhin lɛ didik, se gbarshu bǝn gɔnmimi ne naŋ dɔ, nkanlɛ zhin iyi icɛr yi Musa batai zhaku ne mimi ba, se ne ruu. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />atei ndi neshir nuŋ ate lalɛ ivǝtsob ne nkan lɛ kǝ Arik mɛ te tsar anuŋ tǝ bɛ zǝ ankɔŋ azhin atei zhɔ ba te ambusher ne ikɔb kǝ gbarshu, ama waŋ ndi ate naa tena tsar nken lɛmɛ atei zhɔu ŋgɔŋ ne kɔb gbarshu. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Mbla zhin se na iki didik min ne kam yi Ferisawa bǝn abɛ tsar nkan lɛ, ba zhin tei yir ikɔb kǝ gbarshu ba.<verse eid="MAT 5:20" /></para>
  <para style="s">Ŋun Neshir</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />&lt;&lt;Izhin ne wɔ ne bla aner abɛ kukub te di, &lt;Duŋ ŋun neshir ba&gt; waŋ ndi ate ŋun nuŋ atei teu ŋas.&gt; <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Ama mna bla zhin, waŋ ndi ate te mfu ben zumen atei teu ŋas. Waŋ ndi ate zhɔ izumen, te &lt;Bau ne zhi Arik ba,&gt; atei gliu te gar amkpa ne tɛ ambuk. Fe waŋ ndi ate di, &lt;Uyi bliblik!&gt; Ne te ne zhɔk ne kɔb lu.<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />&lt;&lt;Fena, ate yi ŋdi utei tuk Arik ŋgɔŋ amkpur ne amkpa ne tsik baŋ, teu shuzhi te izumin a gliu nǝ nɛ, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />Duŋ tuk amkpur ami ne amkpa ne tsik baŋ te ŋurkam te na sɔŋ min baliŋ te kashe ŋurkam te tuk amkpuro.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />&lt;&lt;Na lɛ min zhɔk andanda bǝn waŋ ndi une lau lɛ kǝr ilɛmɛ bǝ yir amkpa ane te ambuk ba. Nazhin nakǝ ne ankɔŋ, mba me ba atei baŋu asak anŋɔk ngɔŋ ne te ambuk ne akaba, iwa maayi atei baŋu asak abɛ kpaakpa te bɛ vuŋu azhɔk ne jaru. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Mbla zhin izub, bau tei ru ba se une ya mbyaŋ azɔb aye klɛ ŋɔk ayiŋ ndi ne ŋas ne di.<verse eid="MAT 5:26" /></para>
  <para style="s">Kur ben wa kɔ lulum ayou nuŋ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />&lt;&lt;Izhin ne wɔ te ne di, &lt;Duŋ ze amba ba.&gt; <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Ama mbla zhin te waŋ ndi ate lɛk ayi atɔ iwa te tǝ bubu te wɔb kur bǝn abou neka la lɛ kǝ ze amba ne susun maa. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Teyi ndi iyi kɛ ŋɔk li mi te duŋu la lɛ, kyaŋ kɛ tyak zhɔk. Itei rɛ te ŋa kpa mi bǝ yaŋa te mkpuŋ kpa mi bǝ yir Lu ŋgɔŋ. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Ankyak te yi ndi ŋɔk li mi tǝ duŋu La lɛ kyaŋ kǝ tyak zhɔk. Itei rɛ te ŋaa kpa mi bǝ yaŋa tǝ mkpuŋ kpa mi bǝ yir Lu ngɔŋ.</para>
  <para style="s" vid="MAT 5:30">Kluk ŋa</para>
  <para style="p" vid="MAT 5:30">(Mata 19:9; Markus 10:11-12; Luka 16:18)<verse eid="MAT 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />&lt;&lt;Ne bla tedi, &lt;Iwaŋ ndi ate kyak wa maa abɛ nǝgu mplɛ cɛr kɛ kluk ŋa.&gt; <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Ngam shi di zhin iner waŋ ndi ate kyak wa maa mba ate ze lulum nuŋ akur ba, azhɔk iwa ma ne ,nkɔŋ ane ze alulum, fena waŋ di ate ta iwa ne yar ne lalɛ kǝ ze amba.<verse eid="MAT 5:32" /></para>
  <para style="s">Shɛrim</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />&lt;&lt;Fe, izhin ne wɔ ne di aner abɛ kukub, &lt;Duŋ sherim ayi mu ba, amaa isherim mi bǝ ye anenen ne tanyɛmɛ bǝn Ŋgɔŋ.&gt; <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Fena mbla zhin, Duŋ di zhin sherim ba: kɔ ne gbarshu, iyi amkpa angɔŋ ane sɔŋ aye Arik; <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />kɔ ne gɔnmimi, iyi amkpa ne sak aza maa, ka yi Urshelima ayi ntun ŋgɔŋ yi Itum Ngɔŋ. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Fena duŋ sherim ne tu mi ba, te bau tei kam fumfuk tu mi te wa kɔ bǝ kam te shishir ba. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Duŋ e mi bɛ yi &lt;e&gt; te &lt;ɔɔ&gt; mi bɛ yi &lt;ɔɔ&gt;, ikinuŋ te kam amɛ, ire ben shetan.</para>
  <para style="s" vid="MAT 5:37">Iyi ben Iyi</para>
  <para style="p" vid="MAT 5:37">(Luka 6:29,30)<verse eid="MAT 5:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />Izhin ne wɔ ne di, &lt;&lt;Iyi bǝn iyi, fe ŋin bǝn ŋin.&gt; <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Ama ngam bla zhin, duŋ kyak zhin waŋ ndi ne laa zhin lɛ ba, nuŋ ate ŋuru ne nkɔnŋa kɛ li na kamu ikɛ ŋɔk mla. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Inuŋ ate gliu yir ki kɛ tǝ aneshir ambuk te abɛ ta anklu ami, duŋu abaŋ akɛ tu mi anyaŋa. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Inuŋ ate sagu tsǝn kɛ wamkpuk, zeu tsǝn lǝlɛ. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Nek waŋ ndi ate benu kinuŋ, kǝr duŋ kam goŋ nek waŋ ndi anyɛ wɔb hria bene bɔu ba.</para>
  <para style="s" vid="MAT 5:42">Ta yimɛ bene ni kyagu</para>
  <para style="p" vid="MAT 5:42">(Luka 6:27-28, 32-36)<verse eid="MAT 5:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />Izhin ne wɔ ne bla. Nyer kpami neyi gbahir te kyak ine te zɔr bǝn abou.&gt; <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Fe mbla zhin: Nyer ne ne zɔr bǝn abɔu tena ben abɛ nǝgu iya Arik, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />te izhin tei yi amuno abɛ Tetɛɛ min ne gbarshu, waŋ ndi aduŋ Arik alaŋ abɛ na iki didik bǝn abɛ na zumimin, tena duŋ alu akuu abɛ na ki didik bǝn abɛ na zumimin. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Izhin tedi zhin nyer abɛ nyer zhin ankyak, aye nii izhin tei ta? kɔ abɛ ta gendu anamɛ menyi. <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />atei ndi izhin tek amunzumin ankyak, fe izhin nena nii naŋ anuŋ? kɔ abe yaŋ zhi Arik ba ana mee kai?. <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Izhin bǝ klɛ gbamgbaŋ, fena, ndi Tetɛɛ min ne gbarshu ayi gbamgbaŋ. Arik ne shaga.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Nǝk abɛ yaa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />&lt;&lt;Te zhin bwe te kǝr &lt;iki yi na didik min&gt; ne ti aneshir, te bǝ yige. Izhin te na mee, ba zhin tei yik kinuŋ bǝn Tetɛɛ min nǝ gbarshu.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />&lt;&lt;Neme, utǝ nek nuŋ ki, duŋ vli nju ba ndi amɛ abɛ na yik ayi ana ne ki kɛ bla lɛ kɛ Arik ne akabakɔŋ bǝn kuŋkɔŋ te aneshir abɛ gbar ba asak, mbla zhin izub, ne ka ta dǝk men. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />atei ndi utei nek ne iya kinuŋ, kǝr ubɛ duŋ ŋɔk mlaa mi bǝ zhi iki yi ndi ŋɔk li mi na ba, <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />te iki nǝk mi bi yi kuŋkum. Fena Tetɛɛ mi, waŋ ndi ayik ki na mɔr bɔbɔk, Ai ka nǝgu idǝk mi.</para>
  <para style="s" vid="MAT 6:4">Ben Arik</para>
  <para style="p" vid="MAT 6:4">(Luka 11:2-4)<verse eid="MAT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />&lt;&lt;Ate yi ndi izhin tei ben Arik, duŋ nazhin ndi abɛ kamgli ana, abɛ nyer klɛ adidik te ben Arik ne Akabakɔŋ te aneshir abɛ yik ba, Mbla zhin izub neka ta dǝk men. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Teyi ndi utei ben Arik, yir ki, te ku ankɔŋ te ben Tetɛɛ mi, waŋ ndi ba yigu ba. Fe Tetɛɛ mi, waŋ ndi ayik kiki yiŋ ndi anayi kuŋkum, ayi wa atei nǝgu dǝk mi. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />Ate yi ndi izhin ku ayi, te ben Arik, duŋ bla tena bla lɛ zhin ba ndi abɛ yaŋ zhi Arik, iyik men atei wɔ ba ne bla te na bla ki zhin te duŋ Arik awɔ ba. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Duŋ nazhin ndi naa mǝne ba, te Tetɛɛ min ne shum ne zhi iki ndi izhin wɔb te rib bu.<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />&lt;&lt;Waŋai, yir kǝŋ ndi izhin tei benu:</para>
  <para style="q1" vid="MAT 6:9">&lt;&lt;&lt;Tetɛɛ mɔr ne gbarshu,</para>
  <para style="q1" vid="MAT 6:9">Isak mi bǝyi tsetser,<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Ngɔŋ mi bǝ nyɛ,</para>
  <para style="q1" vid="MAT 6:10">Iki yiŋ ndi une tanyɛmɛ neyi abɛ nai</para>
  <para style="q2" vid="MAT 6:10">Nǝ gɔnmimi ndi iyi ne gbarshu.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Nǝk ta kili ye aliŋ.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />Zuk ta zhɔk ne na zumimin mɔr,</para>
  <para style="q2" vid="MAT 6:12">Ndi ta zuk abɛ la ta lɛ zhɔk.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Duŋ gli ta te gar iten ngɔŋ ka,</para>
  <para style="q1" vid="MAT 6:13">Ubǝ ta ta zhɔk ne ŋɔk kɛ shetan.&gt;<verse eid="MAT 6:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14" />Atei ndi izhin zuk abɛ la zhin lɛ zhɔk, Tetɛɛ min ne gbarshu atei na zuk zhin zhɔk. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Ate yi ndi izhin te kyak zuk abɛ la zhin lɛ zhɔk, Tetɛɛ min ne shu batei na zuk zhin zhɔk ne lalɛ min ba.<verse eid="MAT 6:15" /></para>
  <para style="s">Ikpa anu</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />&lt;&lt;Izhin te kpa anu duŋ kpaa zhin ti, ndi abɛ kamgli ana, aba kpaati atsar aneshir tǝ bɛ zhi te ba kpa anu. Mbla zhin izub neka ta dǝk men. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Fena ate yi ndi kpa anu, ubǝ suu ti te kin anyɛ ne tu mi, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />ndi aneshir ba tei zhi te ne kpa anu ba, Tetɛɛ min ne shu wa ankyak waŋ ndi ba yigu ba, Ayi Tetɛɛ, waŋ ndi ayik iki yi na kuŋkum; ndi bane zhi ba, ai nǝgu dǝk mi.</para>
  <para style="s" vid="MAT 6:18">Adudunki ayi shu</para>
  <para style="p" vid="MAT 6:18">(Luka 12:33-34)<verse eid="MAT 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />&lt;&lt;Duŋ nyak adudunki ne gɔnmimi ba ndi aden ben bla itei cɔkla, ndi abɛ zhib atei rus te zhib kime. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Izhin bǝ nyak adudunki ne gbarshu, ndi aden ben bla ba tei cɔkla, abɛ zhib ba rus tei yir te zhib ba. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Amkpawaŋ ndi adudunki ayime, amɔ susun mi yime.<verse eid="MAT 6:21" /></para>
  <para style="s">Ilaŋ yi kpa</para>
  <para style="r">(Luka 11.34-36)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />&lt;&lt;Iyi kɛ yi pitila iyi kpa, ayi ami ate rɛ, ikpami tei nek laŋ <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />atei ndi ayi ami bate rɛ ba mkpuŋ kpa mi itei tǝ bu. Ate yi ndi ilaŋ amkpa ami ikam yi bu, ibu mi itei yi kikini!<verse eid="MAT 6:23" /></para>
  <para style="s">Zǝ Arik ben ki yi goŋ mimi</para>
  <para style="r">(Luka 16:13)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />&lt;&lt;Nuŋ ba tei na atukɔ ayaa igen ba. kɔ abɛ kyak zhin te nyer zhin, kɔ bǝ na zhin gen te duŋ zhin. Bau di uzǝ Arik tena kam ndi uzǝ iki yi gɔŋmimi ba.<verse eid="MAT 6:24" /></para>
  <para style="s">Duŋ lɛ ne</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />Fena mbla azhin, duŋ di zhin lɛ ne ne sɔŋ min, ka anii izhin tei li tena sɔ; kiyiŋ ndi izhin tei su. Ivli min ba naŋ kili, kpa ba naŋ iki yi su kai? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Tɔ zhin aŋliŋlɔ abǝ shu; ba tib ba, ba sɛr ba, ba ashur ne wun ba, nemɛ Tetɛɛ ne gbarshu ayok ba. Ba zhin naŋ ba kai? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Ŋɔwa ne miŋ mine ne lɛ susun atei sɛr mkpaŋ kɛ vlimaa akɔmɔ ne tii?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />&lt;&lt;Te izhin lɛ ne kɛ ni ne lɛ kɛ ki yiŋ ndi izhin tei su? Tɔ zhin awu ndi flu. Ba na ndum kɔ hwen ba. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Neme mbla zhin, itum Solɔmɔn ne adudunki amaa waŋ ndi ayi ne min kɛ wɔ men iduŋ maa bane duŋ ndi dɔ nkunkun ba. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Ate yi ndi Arik aduŋ agǝga aye zizik, ndi ayime aliŋ iber ŋan atuk ashur ne lu, bate nek zhin ki yi suu naŋǝ kai, Tǝ zhineba abɛ tanyɛmɛ watsɔb? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Ndi amɛ duŋ lɛ zhiin ne te di, &lt;Aye ni ta tei li?&gt; Aye ni ta tei sɔ?&gt; Ka &lt;Aye ni ta tei sui ne kpa?&gt; <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Abɛ yaŋ zǝ Arik Ŋgɔŋ agɔŋɔri te wɔb iki yiŋɛ, Tetɛɛ min ne gbarshu ne zhi te zhin wɔ bǝ. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Nǝ rɛ izhin bǝ wɔb kɔb Arik neliŋ, te na ki didik yiŋ ndi Arik ne tanyɛmɛ neyi fe ai nek zhin iki yi wɔb min bɔbɔk. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Ne mee kǝr zhin bǝ lɛ susun kɛ amblɛ ba, amblɛ ai ka gli ru maa. kɔ te bɛr tayi iyi ne iya maa.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Ite anuŋ ŋas</para>
  <para style="p">(Luka 6:37, 38, 41-42)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />&lt;&lt;Duŋ te anuŋ ambuk ba, atei na teu ma miyi. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Ndi une te anuŋ ambuk, amɛ atei na teu ma, agbǝgba waŋ ndi une tsar anuŋɔ, awa atei na tsa ru ma.<verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />&lt;&lt;Aye nii teu tɔ kǝnkam ne yi kɛ zumin te duŋ kɛ yi mi? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Anii duŋ udi zumin,&lt;Duŋ me ntunu kǝnkam ne yi mi,&gt; Tǝduŋ mkpɔk ki kɛ yi mi? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Jineba abɛ kamgli, tun kenkam kɛ yi mi te utei shi yik klɛ te kashe tun nkǝŋkam kɛ zumin.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />&lt;&lt;Duŋ nek ane viu ki yi tsetser ba; kǝr ubǝ baŋ ki didik tuk zhɔk ane gluk abe kɔb ba. Utǝ na amɛ atei yuŋ te caŋǝ ne za te kama ŋuu.&gt;&gt;</para>
  <para style="s" vid="MAT 7:6">Ben, Wɔb, kpyaŋ</para>
  <para style="p" vid="MAT 7:6">(Luka 11:9-13)<verse eid="MAT 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />&lt;&lt;Ben zhin, atei nek zhin; Wɔb zhin izhin tei yik; Kpyaŋ zhin ankɔŋ atei bu zhin ne wu. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Waŋ ndi ate ben anegu; iwaŋ ndi awɔb ayik; ben waŋ ndi ate kplaŋ, ankɔŋ atei buu.<verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />&lt;&lt;Ŋɔ ne miŋ mine, zu maa ate benu kili te atei baŋ mkpaŋ anegui? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Ka atei benu ambɛ, te atei baŋ iwa anegui? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Izhineba, aner amimin, izhin zhi nek amumune min, ki didik, fe anii shi yar Tetɛɛ mɔr ne gbarshu nǝk ta ki didik ndi ta wɔb bene bɔu! <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />Iki yiŋ ndi izhin wɔb aneshir abɛ na zhin neyi, izhin bǝ na ba neyi men yi, waŋa ayi icɛr yi Musa bǝn abɛ bla shar yi Arik ne di.</para>
  <para style="s" vid="MAT 7:12">Ankɔŋ avetsɔb ben angɔŋ</para>
  <para style="p" vid="MAT 7:12">(Luka 13:24)<verse eid="MAT 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />&lt;&lt;Zǝ zhin ankɔŋ avetsɔb. Tǝ ankɔŋ ane bu te ana yi angɔŋ agar shur aneshir dɔmɔ, anere abɛ zeu ma ayi tetɛk. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Ankɔŋɔ ayi avetsɔb te amɔ wa agli aneshir ivli, aneshir watsɔb aba zeu.</para>
  <para style="s" vid="MAT 7:14">Kuŋkun bǝn dɔ ma</para>
  <para style="p" vid="MAT 7:14">(Luka 6:43-44)<verse eid="MAT 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />&lt;&lt;Hria zhin ayi te abɛ timu te aba yi abɛ bla shar yi Arik. atei nyɛ zhin ne kpa kɛ awanta, ama imiŋe iyi kɛ awuwɔma mimin. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />atei zhi ba ne kiki yi na men. Neshir ne taba kyaŋ dɔ ŋan ne ncɔŋ kɔ dɔ lambwe ne tiŋ kpanduŋ nni? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Amɛ itiŋ nkunkun kɛ rɛ igli dɔ didik rumɔ, kuŋkun mimin na gli dɔ mimin gli rumɔ. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Itiŋ nkunkun didik ba tei gli dɔ mimin rumɔ ba, kuŋkun mimin ba tei na gli dɔ didik rumɔ ba. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Itiŋ nkunkun ndi ba te yi nǝ dɔ didik ba, atei tsem kɛ atyak azhɔk te goŋ kɛ ne lu. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Amɛ, atei zhi abɛ bla shar Arik abɛ timu ne kiki yi na men. Abɛ zǝ Arik zǝzǝ didik bǝn abɛ timu<verse eid="MAT 7:20" /></para>
  <para style="s">Bam ne zhi zhin ba</para>
  <para style="r">(Luka 13:25-27)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />&lt;&lt;Ba kɔte ŋɔwa ndi azhɔm, &lt;Ŋgɔŋ Ŋgɔŋ,&gt; atei yir ikɔb kǝ gbarshu ba, se waŋ ndi ana kiki yi Tetɛɛ muŋ nǝ gbarshu. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Aner tetɛk atei dim ne bere, &lt;Ŋgɔŋ, Ŋgɔŋ, ba ta ne bla aneshir lɛ kɛ kiki yi nyɛ ne sak mi kai, ba tane na gli anerim rumɔ ne sak mi, te na kiki ngɔngɔŋ iyi vuŋ anu ne sak mi ka yi?&gt; <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Ankyak M tei ru klɛ te ndi ba, &lt;Nga bam ne men zhi zhin ba, Kam tibɛ zhin ayaŋa, abɛ na zumimin!&gt;</para>
  <para style="s" vid="MAT 7:23">Nǝ Mgbemgbeb ben kpukpur abɛ me</para>
  <para style="p" vid="MAT 7:23">(Luka 6:47-49)<verse eid="MAT 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />Yesɔ adi, &lt;&lt;Waŋ ndi ate wɔ lɛ muŋ te na ndumo ne kɛ waa ayi ndi ner ne yi Mgbemgbeb ndi ne mee kɔb ma ne tu yaŋ. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Alu ne kuh, anga atuk ne shak aru anca, nguŋgu ne fuk kɔbɔ; bane zhaku ba, tǝ nɛ sak tanda maa ne tu yaŋ. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Ankyak iwaŋ ndi ate wɔ lɛ muŋ kǝŋe te kyak zǝ kɛ ayi ndi ner kpukpur ndi ne me kɔbɔ ne tu ablubluk. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Ndi alu ne zǝr kuh, anga atuk ne shak te ru anca, nguŋgu ne te te tur kɔbɔ, ne zhaku te tsik ŋar.&gt;&gt;<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Ndi Yesɔ ne bla ilɛmɛ aklɛ, ntsan aneshir akɔ vuŋ anu ne lɛ kɛ tsar maa, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Tǝ ne tsar ndi waŋ di ayi ne mgbyamgbyaŋ, ba yi ndi abɛ tsar cɛr yi Musa ba.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Yesɔ ne na iner ne amkpuk</para>
  <para style="p">(Markus 1:40-45; Luka 5:12-16)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Ndi Yesɔ Ne zi arɛ tiŋ gbu, ntsan aneshir ne zeu. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Ner ne lɔ amkpuk, ne anyɛ te tar agbarum ne ti maa tedi, &lt;&lt;Ŋgɔŋ, utǝ ta nyɛmɛ, utei duŋ me rɛ.&gt;&gt;<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Yesɔ akɔ nab ŋɔk asagu tedi, &lt;&lt;Mǝnǝ ta nyɛmɛ&gt;&gt; &lt;&lt;rɛ fe!&gt;&gt; Ankyak ne lɔ amkpuk akɔ rɛ. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Fe Yesɔ adiu, &lt;&lt;duŋ bla nuŋ ba. Tsǝn te tsar tu mi bǝn abɛ ine na ndum kǝ Arik tei na nek asaraka, ndi cɛr yi Musa ne bla, naa mee te duŋ aneshir azhi teu neka rɛ.</para>
  <para style="s" vid="MAT 8:4">Yesɔ ne na gen Zarmi</para>
  <para style="p" vid="MAT 8:4">(Luka 7:1-10)<verse eid="MAT 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Ndi Yesɔ ne yir min ntun yi kafanahum, ankyak zarmi ne nyɛ benu te benu abɛ alɔk iwa ma. <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />Adi, &lt;Ŋgɔŋ,&gt; &lt;&lt;igen amuŋ akɔkur ne kɔbɔ, kpa maa ne ku te azǝne yik yaa.&gt;&gt;<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Yesɔ adiu, &lt;&lt;mgar nau te duŋu rɛ.&gt;&gt;<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Fena zarmi me adi, &lt;&lt;Ŋgɔŋ, bam ne mla ndi utei zǝm gar kɔb muŋ ba, utǝ nak bla nkan lɛ ankyak igen amuŋ atei rɛ. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Nga ma mi yi ne angus akɛ nuŋ ne mgbyamgbyaŋ, bǝn abɛ kpaakpa ne angus amuŋ. Mtǝ ndi nuŋ, &lt;kɔmɔ,&gt; akɔmɔ; mteina ndi nuŋ, &lt;nyɛ&gt;, ana nyɛ, mteina ndi igen amuŋ, &lt;Na iyiŋ,&gt; ana nai.&gt;&gt;<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Ndi Yesɔ ne wɔ amɛ, Ne vuŋ anu te bla abɛ zeu tsǝn te di, &lt;&lt;Mbla zhin izub, Bam ne zen yik nuŋ ne Isrela ine tanyɛmɛ ir kǝŋe ba. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Mdi zhin te aner tetɛk atei rɛ ti kɛ anzaŋ bǝn amgbalu, atei nyɛ te sɔŋ te li igyaŋ bǝn atsintsim amɔr Ibrai, bǝn Ishaku bǝn Yakubu ne ikɔb kǝ gbarshu. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Ankyak aner abaŋ ndi ba tei yir ikɔb kǝ gbarshu ba atei tyak ba ahrie ne abɛm, ne amatib bu, amɔ atei zhin te ŋuu aŋin.&gt;&gt;<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Fe Yesɔ adi zarmi me, &lt;&lt;tsǝn kɔmɔ! Itei yi yir kɛŋ ndi une tanyɛmɛ ne susun.&gt;&gt; Fe igen ama akɔ rɛ ne mkpaŋa.</para>
  <para style="s" vid="MAT 8:13">Yesɔ ne na idu aneshir</para>
  <para style="p" vid="MAT 8:13">(Markus 1:29-31; Luka 4:38-39)<verse eid="MAT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Ndi Yesɔ ne yir kɔb Biturus, ayik azhi men ane Biturus akɔkur ikpa ne ŋuru zhɔk. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Yesɔ avuŋ ŋɔk maa ilɔmɔ ku duŋu, fe alu asɔŋ te lɔgu ma.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Ndi amgbalu ne te, ne gli aneshir tetɛk abaŋ ndi ayi ne anerim agliu ma, ne nken lɛ maa ne yar anerime agli rumɔ te naa kab abɛ lɔ te ne rɛ. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Iyiŋɛ ne yemɛ te duŋ nkenlɛ ndi ne rǝ anu akɛ anebi Ishaya ine bla shar yi Arik ne shaga te di:</para>
  <para style="q1" vid="MAT 8:17">&lt;&lt;Nǝ baŋ lɔ mɔr ne tu maa</para>
  <para style="q2" vid="MAT 8:17">Tǝ baŋ lɔ kpa mɔr ahru.&gt;&gt;</para>
  <para style="s" vid="MAT 8:17">Iya yi abɛ zǝ Yesɔ</para>
  <para style="p" vid="MAT 8:17">(Luka 9:57-62)<verse eid="MAT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Ndi Yesɔ ne yik ntsan aneshir ne zhɔ gu ne atsutsu, akɔ di ba bɛ glɔ kama kɔmɔ ne goŋ nǝk yuŋ. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Ankyak ne tsar lɛ ne atɔra anyɛ diu, &lt;&lt;Inetsar, Amkpa waŋ ndi utǝ gar M tei zeu.&gt;&gt;<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Fe Yesɔ asagu ma te di, &lt;&lt;wuwuoma ayi ne dudu, Aŋliŋlɔ abɛ gbarshu ayi ne anjer, ama Izu Neshir ba yi ne amkpa ne ŋyaŋ tu ba.<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Inuŋ ne min abɛ tsene maa adiu, &lt;&lt;Ŋgɔŋ, duŋ mte ruu Tetɛɛ muŋ baliŋ.&gt;&gt;<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Fena Yesɔ adiu, &lt;&lt;Zǝǝm te duŋ akum abɛ ru akum amen.&gt;&gt;</para>
  <para style="s" vid="MAT 8:22">Yesɔ ne tsaŋ ŋguŋgu ŋgɔŋ</para>
  <para style="p" vid="MAT 8:22">(Markus 4:35-41; Luka 8:22-25)<verse eid="MAT 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Ndi Yesɔ ne yir asɔŋ ne miŋ gu abɛ tsene maa ne zeu ayir miŋ gumɔ. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Nǝ yaŋ zhi, alu ne shir nguŋgu ŋgɔŋ ifuk ne atu Nekǝ, amashir alu ankun ndi gu tei kam ku. Yesɔ ne yir te akɔkurna ne miŋ gumɔ. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Abɛ tsene maa ne te sǝu, tedi, &lt;&lt;Ŋgɔŋ, ta ta zhɔk! Tǝ ta tei mli amashir te ku!&gt;&gt;<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Yesɔ adi ba, &lt;&lt;Izhin te sǝsǝk anii, izhin abɛ tanyɛmɛ watsɔb?&gt;&gt; Ankyak alu te tsaŋ nguŋgumɔ, bene ankun amashire fe akɔ te zee.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Anere avuŋ anu tedi, &lt;&lt;Waŋa ayi yir neshir takɛ? Tǝ nguŋgu ben ankun amashir awɔu!&gt;&gt;</para>
  <para style="s" vid="MAT 8:27">Yesɔ ne naa aner ayaa abaŋ ndi anerim ne yir ba</para>
  <para style="p" vid="MAT 8:27">(Markus 5:1-20; Luka 8:26-39)<verse eid="MAT 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Ndi Yesɔ neka glɔ goŋ yuŋ ne ŋaa kɛ Garisinawa, fe aneshire aya abaŋ ndi ayi ne anerim ayi ne mgbyamgbyaŋ kɔ ru arɛ abɛ te tara mla ben Yesɔ. Ndar mǝne duŋ aneshire aklu zǝ gar yuŋɔ. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Ate ruru te di. &lt;&lt;Uwɔb anii bene beta, Izu Arik?&gt;&gt; Une nyɛ sak ta iyah ndi mkpaŋ bane zen te bai?&gt;&gt;<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Ggbahir ben ntsan ane gluk abɛ kɔb azǝne li. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Fena anerime akɔ ben Yesɔ te di, &lt;&lt;Utǝ gli ta rumɔ, duŋ ta bǝ yir miŋ akpaa ane gluk abɛ kɔb abaŋa.&gt;&gt;<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Fena adi ba, &lt;&lt;tɔ tsǝn zhin!&gt;&gt; Ankyak anerime akɔ ru ne kpa kɛ neshire ate yir miŋ ane gluk abɛ kɔbɔ, ntsan anegluk go akɔ ŋar zhin te klu te yir miŋ nek te ku ne amashirǝ. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Abɛ kyu bama aklu ayir miŋ ntuno, te kɔte bla ki ndi ne na, bǝn ki ndi nena vuŋ aner ndi ayi ne anerim. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Ankyak kab aner abɛ ntuno aru te gar ayik Yesɔ, te benu tǝ bɛ duŋ gar mǝne.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">Yesɔ nena ne lɔ ku ŋa zhin</para>
  <para style="p">(Markus 2:1-12; Luka 5:17-26)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Ndi Yesɔ ne yir min gumɔ, te aglɔ kɔmɔ ne kafanahum ntun maa. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Fe aner anuŋ ne gliu ne lɔ ku ŋa kpa izhin, akɔkur ne adonke ki kur maa. Ndi Yesɔ ne yik tanyɛmɛ men ne atu amaa adi ne lɔmɔ, &lt;&lt;Klik susun ka, zumuŋ; zumimin yi na mi, Mne zuk zhin zhɔk. &gt;&gt;<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Nǝ yiŋɛ anuŋ abɛ tsar nkan lɛ adi akpa mɛn, &lt;&lt;Nɛr waŋa ayen Arik!&gt;&gt;<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Nɛ zhi lɛ susun mǝne, Ankyak Yesɔ arib ba, &lt;&lt;Anii duŋ zhin nyak ililɛ mimin ne asusun amine? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Itayi naŋ: te bɛ di, &lt;Ne zuk zhin zhɔk ne zumimin min,&gt; kɔ abɛ di &lt;lu klɛ te tsǝn&gt;? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Tǝ duŋ izhin bǝ zhi te Izu Neshir ayi ne mgbyamgbyaŋ ne gɔnmimi kɛ zuk zumimin zhɔk.&gt;&gt; Fe akɔ di ne lɔmɔ, &lt;&lt;Lu klɛ, te baŋ adonke mi te kɔmɔ ne kɔb.&gt;&gt; <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Ankyak neshire akɔ lu akɔmɔ ne kɔmaa. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Ndi ntsan aneshire ne yik amɛ, akɔ te sisik, akɔ gbar Arik sak, waŋ di ne nek aneshir mgbyamgbyaŋ kǝŋe.</para>
  <para style="s" vid="MAT 9:8">Yesɔ ne zhɔ Matiu</para>
  <para style="p" vid="MAT 9:8">(Markus 2:13-17; Luka 5:27-32)<verse eid="MAT 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Ndi Yesɔ ne ku ti, alɔyik neshir nuŋ waŋa azhɔu te Matiu, akɔsɔŋ azǝn ta gendu ne bur kɛ na ndum mǝne. Yesɔ adiu, &lt;&lt;lu zǝm,&gt;&gt; fe Matiu akɔ lu te azeu.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Mkpaŋ keŋ ndi Yesɔ azǝn li kili ne kɔb Matiu amgbalu, abɛ ta gendu bǝn abɛ na zumimin azǝn li kili ndɔ bǝn abɛ tsene maa. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Fe ndi Ferisawa ate naga yik amɛ, akɔ rib abɛ tsene maa, &lt;&lt;Anii duŋ Ngɔŋ amine ali kili ben abɛ ta gendu ben &lt;abɛ na zumimin?&gt;&gt;<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Ndi Yesɔ ne wɔ lɛ kǝŋe, Yesɔ adi, &lt;&lt;Nǝ ikpa keke ba wɔb ne nek kǝka ba, ine lɔ wa awɔb. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Fe tsǝn te tsar tɔ zhin ka iyeme: &lt;Mwɔb lɔ susun, ba tsik me ibaŋ ba.&gt; Tǝ bam ne nyɛ Tǝm zhɔ abɛ yi tsetser ba, se na zumimin.&gt;&gt;</para>
  <para style="s" vid="MAT 9:13">Irib ne atɔ ayi kpaanu</para>
  <para style="p" vid="MAT 9:13">(Markus 2:18-22; Luka 5:33-39)<verse eid="MAT 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Abɛ wɔ bla tsar Yɔɔna ne suu aner anyɛ rib bu tedi, &lt;&lt;Anii duŋ taba ben Ferisawa kpa anu, ama abɛ tsene maa ba kpaanu kai?&gt;&gt;<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Yesɔ asaga, &lt;&lt;Nǝ tei ta wa akpa maa atei zhin ku ne mkpaŋ keŋ ndi anaga ri yi bene aba yi? Mkpaŋ nyɛ ndi atei baŋ ne kpa ŋama teduŋ ba; ai mkpaŋa kɛ atei kpa anu.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />&lt;&lt;Nuŋ ba tei baŋ anklu ayayas ahwɛn anyaŋ ben acicɛ anklu ba, ayayasa atei gbu acicɛ me aŋaa, te duŋ gbu ŋama iyi mimin. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Amɛ aneshir batei shur ancen ayayas ne cice kǝkɛŋ ba. Ate shuru ma, cice gwara tei lak ŋar, ayi me atei var ahrie fe cice kǝkɛnɛ te lak ŋar. Ba yeme ba, ayi ayayas se ne kǝkɛŋ yayas. Iyah mǝne batei cɔk ala ba.&gt;&gt;</para>
  <para style="s" vid="MAT 9:17">Iku va ner ŋgɔŋ ben Iwa ne lɔ</para>
  <para style="p" vid="MAT 9:17">(Markus 5:21-43; Luka 8:40-56)<verse eid="MAT 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Ndi ne zin di amɛ, ner ngɔŋ nuŋ waŋa anyɛ tar agbarum ne ti maa te di, &lt;&lt;Azezaŋa va muŋ akuu. Utǝ tanyɛmɛ nyɛ te sagu ŋɔk mi, atei tyak asi. <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Yesɔ akɔ lu zeu, bǝn abɛ tsene maa.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Iwanuŋ ndi ne te ase awur ane yaa te zen ra azhizhi ne lɔmɔ arɔn te sak ŋɔk ne tɔŋ anklu maa. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Iwama adi tu maa, &lt;&lt;mte nak sak ŋɔk ne tɔŋ anklu amaa, M tei rɛ.&gt;&gt;<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Yesɔ akam atɔ iwa ma te diu. &lt;&lt;Va muŋ ubǝ klik susun, &lt;&lt;Tanyɛmɛ mi ne duŋu arɛ.&gt;&gt; Ankyak iwama kɔ rɛ.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Ndi Yesɔ ne yir kɔb ner ngɔŋ te yik aner abɛ vli mpluŋ bǝn aneshir anazin ya atɔŋ ne min kɔbɔ, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />fe Yesɔ adi, &lt;&lt;Sɛr tibɛ. Vǝvǝnwama bane ku ba akɔkurna.&gt;&gt; Akɔ mlagu mlak yi bǝs. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Ndi ntsan aneshir ne di ba abɛ ru abɛm, Akɔ yir te vuŋ vǝvǝnwama ne ŋɔk, akɔ lu asɔŋ. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Ilɛ kǝŋe ne wɔ kɛ kɔte gar takǝ.<verse eid="MAT 9:26" /></para>
  <para style="s">Yesɔ ne buu ayi aner abɛ amfik te na naa ne la ndar</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Ndi Yesɔ ne naga duŋ amɔ, fe anere abɛ amfik ayi azeu, te bene ŋar kɔr, tedi, &lt;&lt;Wɔ lɔ susun mɔr, Uwa Izu Doda!&gt;&gt;<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Ndi ne yir kɔb neshir nuŋ abɛ mfǝge anyɛ bene bɔu, Yesɔ arib ba, &lt;&lt;Izhin ne tanyɛmɛ ne susun tem yi nǝ mgbyamgbyaŋ keŋɛi? Fe akɔ diu, Ŋgɔŋ, tane tanyɛme!&gt;&gt;<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Ankyak akɔ sak ŋɔk ne yi amene, tedi, &lt;&lt;Bǝ yi amɛ ndi izhin ne tanyɛmɛ&gt;&gt;; <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />fe ayi amene akɔ bu. Yesɔ akɔ gbaŋ ba atɔŋ tedi, &lt;&lt;Kǝr zhin bǝ duŋ nuŋ abɛ wɔ lɛ kǝŋe ba.&gt;&gt; <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Fe na akɔmɔ te bla ilɛmɛ kɔte gar ta kǝ ne ntuntuno.<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Ndi atsǝn aru, fe agliu abɛba waŋ ndi ayi ne anerim. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Indi neka yar anerim aglɛ rumɔ ne kpa maa, abɛba me akɔ lɛ. Aner abɛ yi amɔ akɔ vuŋ nunu tedi, &lt;&lt;Ikinuŋ bane zen na amɛ ne miŋ Isrela ba.&gt;&gt;<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Fena Ferisawa aba di, &lt;&lt;Bai sha ba Ana kime ne mgbyamgbyaŋ kɛ ngɔŋ anerim.&gt;&gt;<verse eid="MAT 9:34" /></para>
  <para style="s">Abɛ na ndumo ayi watsɔb</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Amɛ Yesɔ ne goŋ ari azǝ ntuntun mɔtsɔtsɔb bǝn ngɔŋgɔŋ tetɛk, te zen tsar ne akabakɔŋ, te du ilɛ didik kɛ ikɔb kǝ gbarshu te na abɛ lɔ kpa bǝn lɔ kaŋkaŋte duŋ ba rɛ. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Ndi ne yik ntsan aneshire, akɔ lɔ susun mǝne, te ayik iyah, atsǝn ndi awanta baŋ ndi ba yi ne kyu ba. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Fe adi abɛ tsene maa, &lt;&lt;Ahwaŋ ne te ane na ndum te abɛ na ndumo ayi watsɔb. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Amɛ, izhin bǝ ben Ŋgɔŋ ne ahwaŋa, te bɛ tur abɛ nau ndumo.&gt;&gt;<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Yesɔ ne shar aner awuro ane yaa abɛ zeu na ndum</para>
  <para style="p">(Markus 3:13-19; Luka 6:12-16)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Yesɔ ne zhɔ abɛ tsene maa anere awur ane yaa abɛ tsene maa te nek ba mgbyamgbyaŋ kɛ yar izhu yi shetan te na duŋɔ abɛ Lɔ rɛ.<verse eid="MAT 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2" />Waŋa aye asak abɛ tsene maa awur ane yaa abɛ na ndum amaa: ine ku ti ayi, Siman waŋ ndi azhɔu te Biturus bǝn zumen Anduru; bǝn Yakubu izu Zebɛdi, bǝn zumen Yɔɔna; <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />bǝn Filibus, bǝn Batɔlɔmi; bǝn Tɔma, bǝn Matiu ine ta gendu; Yakubu izu Alfa bǝn Tadiyo; <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Siman ndi arɛ Kanana bǝn Yahuda Iskariyɔti waŋ ndi ne baŋ Yesɔ alɛb.<verse eid="MAT 10:4" /></para>
  <para style="s">Yesɔ ne shar awur ane yaa</para>
  <para style="r">(Mar 6:7-13; Luka 9:1-6)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Yesɔ anǝk abɛ tsene maa awur ane yaa ma lɛ tedi: &lt;&lt;Duŋ kɔmɔ zhin bǝn abaŋ ndi ba yi ŋli kɛ Yahudawa ba kɔ yir ntun yi Samariya ba. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Izhin bǝ te wɔb awanta abaŋ ndi ne dɔ ne miŋ Isrela. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Izhin te gar, bǝn du ilɛ kǝ ishar yiŋɛ: &lt;ikɔb kǝ gbarshu ne te gbahir.&gt; <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Na zhin abɛ lɔ te duŋ ba rɛ, te duŋ abɛ ku abɛ kama lu, na zhin abɛ lɔ amkpuk, te yar zhin anerim igli rumɔ. Izhin ne ta mgbyamgbyaŋ kǝŋe sha, izhin bǝ na nek kɛ sha. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Kǝr zhin bǝ gli azɔb ayi zineriya kɔ azɔb ayi Azurfa ba, kɔ ayi tagula ne mgbɔ min; <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />duŋ na baŋ zhin abu ane tsǝn ba, bǝn anklu anuŋ gli ba, bǝn akpaza, kɔ mkpɔki kǝ kyak ŋɔk; ne rɛ ndi abɛ nek ine na ndum idǝk maa.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />&lt;&lt;Ntun ŋgɔŋ kɔ ivǝtsɔb ndi zhin te yirǝ, wɔb zhin ner waŋ di atɔu ashak ayi te sɔŋ zhin ne kɔmaa mla ne bɛr yi luu min. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Indi zhin te yir kɔbɔ, di ta tek zhin. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Ate yi ndi kɔbɔ te tanyɛmɛ, sik susun itei yir miŋ kɔbɔ; ate yi ndi kɔbɔ te kyak, duŋ sik susun ŋurkam nyak atu amin. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Iwaŋ ndi ate kyak ta zhin kɔ lɛ mine, kluzhin mgbumgbuk yi aza amin shur ba ndi izhin te duŋ kɔbɔ kɔ ntuno. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Mbla zhin izub, ne bɛr yi te ambuk, atei wɔ lɔ susun yi aner abɛ Sodɔm ben Gomɔra anaŋ gar ntun yuŋɔ.<verse eid="MAT 10:15" /></para>
  <para style="s">Iyah yi nyɛ</para>
  <para style="r">(Mar 13:9-13; Luka 12:11-12; Luka)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />Mshar zhin ndi awanta ne miŋ ane awuwɔma. Ne mee, izhin bǝ mgbemgbeb ndi ane wa te na yaŋ la lɛ ndi ane angu.<verse eid="MAT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 10:17" />Sɔŋ zhin atsitsir bǝn aneshir; te atei baŋ zhin asak ne aŋɔk ayi abɛ te ŋas te na tsik zhin ne miŋ akabakɔŋ amen. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Atei sak zhin ya ne aŋɔk aye atɔ itum bǝn gomneti abɛ Roma ne atu amuŋ, te zhin bǝ bla kinuŋ ne ti mǝne bǝn ti kɛ abaŋ ndi ba yi ŋli kɛ Yahudawa ba. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Fe na ate vuŋ zhin, kǝr zhin bǝ duŋ susun amin acɔk ala ba ne wɔb ki yiŋ ndi izhin tei bla kɔ izhin tei blai kikin. Nǝ mkpaŋa atei nek zhin ki yi bla. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Tǝ batei yi izhineba yi abɛ bla ilɛmɛ ba, ayi Izhu iyi Arik Tetɛɛ min wa atei lɛ nenu amine.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />Amunwa atei kyak akpa te aŋlɔk akpa, Tetɛɛ atei kyak vǝvǝn amaa; amumun atei yir atetɛ men nvli, te tsik atetɛ men aŋlɔk. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />kɔ te ŋɔwa atei kyak zhin ne sak muŋ, ama iwaŋ ndi ate vuŋ susun te klɛ mgbamgbaŋ gar klɛtu atei yik ita zhɔk. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Ate nek zhin iya ne amkpa anuŋ, klu kɔmɔ zhin ne ntun yi ti. Mbla zhin izub, ba zhin tei goŋri ne ntuntun yi Isrela klɛ ba Izu neshir atei nyɛ.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />&lt;&lt;Waŋ ndi ari zen tsaru ba tei naŋ ne tsa ru ma ba, igen ba naŋ atukɔ amaa ba. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Nǝ rɛ te vǝvǝn waŋ ndi ari zen tsaru abɛ ru ne tsa ru ma, igen abɛ na ru atukɔ amaa. Ate azho ŋgɔŋ ne kɔbɔ te ngɔŋ anerim, te ai zhɔ anere abɛ kɔbɔ kikin!<verse eid="MAT 10:25" /></para>
  <para style="s">Iwaŋ ndi izhin tei ti sisik maa</para>
  <para style="r">(Luka 12:2-7)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />&lt;&lt;Ne mee duŋ klu zhin sisik mǝne ba. Tǝ duŋ ki ndi ne asui ayir atei burǝ arumɔ, bǝn ki yiŋ ndi ne sue ayir itei ru. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Ilɛ keŋ ndi mbla zhin kuŋkum, bla zhin ne kǝ ru abɛm. Iki yiŋ ndi izhin ne wɔi ne atɔŋ amin, du zhin ne kǝ nǝ kɔr ngɔŋ ne tu ki. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Duŋ di izhin tei klu zhin sisik abɛ ŋun kpa neshir, ndi ba tei ŋun iri maa ayir ba. Tǝ nyɛmɛ, klu zhin Arik waŋ ndi ayi ne mgbyamgbyaŋ kɛ ŋun kpa bǝn susun kǝ neshir ne kɔb lu. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Mta ndi ka alɛb Amuɔcice aya anini azhin ɔ? Ba nuŋ ne miŋ mǝne ndi atei zhaku ne mimi ne yaŋ zhi Tetɛɛ min. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Amɛ ne bla mfumfuk tu min bɔbɔk. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Duŋ klu zhin sisik ba; te izhin shak ayi naŋ amuɔcice ne du!<verse eid="MAT 10:31" /></para>
  <para style="s">Ibla klu aŋin bǝn ikyak Kristi nǝ ti ke aneshir</para>
  <para style="r">(Luka 12:8-9)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />&lt;&lt;Iwaŋ ndi ate tɔm ashak ayi ne ti kɛ aneshir, Nga ma M tei tɔu shak ayi ne ti kɛ Tetɛɛ amuŋ ne gbarshu. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Fe waŋ ndi te kyak zhim ne ti kɛ aneshir, Nga muŋ yi M tei kyak zhiu ne ti kɛ Tetɛɛ muŋ ne gbarshu.<verse eid="MAT 10:33" /></para>
  <para style="s">Ba sik susun, ityak kum ankyak</para>
  <para style="r">(Luka 12:51-53; <ref loc="MAT 14:26-27">14:26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />&lt;&lt;Kǝr zhin bǝ yik ndi Mni ngli sɔŋ kɛ sik susun te nyɛ gɔnmimi. Ba ye amɛ ba, ayi mgbu kɛ mne ngli kǝ nyɛmɛ. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Tǝ mne nyɛ tem kam</para>
  <para style="q1" vid="MAT 10:35">&lt;&lt;&lt;Izu tǝ bɛ kyak akpa ben Tetɛɛ maa,</para>
  <para style="q2" vid="MAT 10:35">Iva abɛ kyak akpa ben yaa maa,</para>
  <para style="q1" vid="MAT 10:35">Iwazu abɛ kyak akpa ben azhi men<verse eid="MAT 10:35" /></para>
  <para style="q2">
    <verse number="36" style="v" sid="MAT 10:36" />Anere bɛ miŋ abɛ te zɔr kɔb zhin atei kyak akpa ayi.&gt;<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />&lt;&lt;Iwaŋ ndi ate nyer Tetɛɛ maa bǝn yaa maa anaŋ mǝ, bane mla ne zǝm ba; Iwaŋ ndi ate anyɛr izu maa bǝn va maa anaŋ mǝ, bane mla ne zǝm ba; <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />waŋ ndi bate baŋ mkpɔk nkunkun kǝ gen ma te zǝm ba bane mla ne yi amuŋ ba. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Neshir te kɔr ivli maa atei baŋ kǝ ayaŋa, iwaŋ ndi ate baŋ tu maa ayaŋa ne atu amuŋ atei yik kǝ.<verse eid="MAT 10:39" /></para>
  <para style="s">Ndum kǝ nǝk idǝk</para>
  <para style="r">(Mar 9:41)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />&lt;&lt;Iwaŋ ndi ate ta zhin ne ta Ngama muŋ yi, fe waŋ di ate tam, ne ta waŋ di ne shar me. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Iwaŋ ndi te ta ne bla shar yi Arik te ayi ine bla shar yi Arik ne sak muŋ atei ta dǝk ne na ndum ine shar bla lɛ kǝ Arik, waŋ ndi te na ta ner didik ndi ana iki didik atei yik dǝk kɛ ner didik. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Inuŋ ndi te nek izhin ne min kɛ abɛ tsene amuŋ abaŋa ne sak muŋ, kɔ ayi kpar antse amashir zhin, ndi ayi ne min ke abɛ zǝm tsǝn, mbla zhin izub, batei yaŋ yik idǝk maa ba.&gt;&gt;<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Yesɔ ben Yɔɔna ne suu aneshir</para>
  <para style="p">(Luka 7:18-35)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Ndi Yesɔ ne lɛ klɛ bǝn abɛ tsene maa awur ane yaa, ne kɔmɔ ne ntuntun yi Galili te zen tsar bǝn du ba lɛ.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Fe Yɔɔna ndi ne kukur ne jaru ne awɔ kiki yiŋ ndi Kristi azǝn nai, ashar abɛ tsene maa <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />abɛ rib bu te di, &lt;&lt;Ayi waa uyi ne tei nyɛ waŋa, kɔ ta bǝ shur ayi ben nuŋ ini?&gt;&gt;<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Yesɔ ata anyɛ me, &lt;&lt;Kam kɔmɔ te bla zhin Yɔɔna iki yiŋ ndi izhin ne wɔi te na yik: <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Abɛ amfik ayi ne ta iyik, abɛ aglugluk alu atsǝn, abɛ amkpuk nɛ rɛ, abɛ amfik atɔŋ awɔ lɛ, ne lǝk abɛ ku kama lu, azǝn du lɛ didik kǝ Arik shur aner abɛ iya. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Anu didik ayi ne atu abaŋ ndi bane tun zhim ba!&gt;&gt;<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Ndi abɛ zǝ Yɔɔna tsǝn akama atibe, Yesɔ akɔ lɛ ben ntsan aneshire ne atu ayi Yɔɔna: &lt;&lt;Izhin ne kɔmɔ gar na nii ne zizige? Ikyuru keŋ ndi ŋguŋgu fuk kei? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Mba ite ye mee ba, izhin ne ru gar tɔ anii? Ner ndi ne asu iki didige? Ba yi mee ba, abɛ su ki didik ayi ne akɔb ayi atɔ itum. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Fe izhin ne ru gar tɔ anii? Ine bla shar yi Arik ge? Iyeme, Mbla zhin, te Yɔɔna anaŋ ne bla shar you Arik. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Waŋa ayi iner ndi ne cɛr ne atu amaa te di:</para>
  <para style="q1" vid="MAT 11:10">&lt;&lt;&lt;M tei shar ne shar amuŋ abɛ lii zhin ti,</para>
  <para style="q2" vid="MAT 11:10">Iwa atei kun wa ankɔŋ.&gt;<verse eid="MAT 11:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />Mbla zhin izub: Ne min kɛ abaŋ ndi amba ne ŋli ba, ba waŋ ndi ne naŋ Yɔɔna ne su aneshir ne ngɔŋ; Ne mee, waŋ ndi ayi vǝtsɔb ne ikɔb kǝ gbarshu ne naŋu. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Nak rǝ mkpaŋ kɛ Yɔɔna ne su aneshir te nyak azizaŋ, ikɔb kǝ gbarshu zen yik iya tetɛk, te aner abɛ mgbyamgbyaŋ awɔb takǝ. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Ne me abɛ bla shar yi Arik bǝn icɛr yi Musa ne bla lɛ kɛ ikɔb Arik nyɛ yir mkpaŋ kɛ Yɔɔna. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Ate yi ndi zhin tei ta kɛ, iwa ayi Iliya ndi ane tei nyɛ. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Waŋ ndi ayi ne atɔŋ ayi wɔ, abɛ wɔ.<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />&lt;&lt;M tei mbiŋ kab kǝŋe nenii? Ayi ndi amumun abaŋ ndi akɔ sɔŋ ne dub te azǝn zhɔ akpa men:<verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />&lt;&lt;&lt;Ta ne vli zhin mgbemgba,</para>
  <para style="q2" vid="MAT 11:17">Ba zhin ne glu ba;</para>
  <para style="q1" vid="MAT 11:17">Ta ne zhin asem ku.</para>
  <para style="q2" vid="MAT 11:17">Ba zhin ne zhin ba.&gt;<verse eid="MAT 11:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18" />Yɔɔna ne nyɛ, te kyak li kili ben so, adi, &lt;Ayi ne anerim.&gt; <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Izu Neshir ne nyɛ te li te so, aba tara di, &lt;Tɔ zhin ne mli ki rǝrǝ waŋa, ikpa abɛ ta gendu ben abɛ &lt;&lt;Na zumimin.&gt;&gt;&gt; Ne mee Mgbemgbeb kɛ Arik ne tsar iki yi zub.&gt;&gt;</para>
  <para style="s" vid="MAT 11:19">Izhin bǝ zhin zhɔk atɔ min ntun ye yaŋ wɔ lɛ</para>
  <para style="p" vid="MAT 11:19">(Luka 10:13-15)<verse eid="MAT 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Ankyak Yesɔ akɔ yir tsǝn aneshir abɛ ntuntun yiŋ ndi wa ane na kiki yi vuŋ anu, te nɛ kyak duŋ na zumimin men. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />&lt;&lt;Zhin zhɔk atu amin aneshir abɛ kɔrasinu! Zhin zhɔk atu min, aneshir abɛ Batseda! Abɛ di kiki yi vuŋ anu ndi ne nai ne atsutsu amin iyi ane anai ne Taya bǝn Sidon, abɛ men duŋ na zumimin men ire asese te su amkpɔk anklunklu te zǝ sɔŋ ne miŋ ntun. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Mbla zhin zub, iyik iyah min ne bɛr yi te ambuk itei naŋ yi aner abɛ Taya ben Sidon. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Izhin aba, aner abɛ Kafanahum, atei lik zhin akɔmɔ ne gbarshu? Ba yeme ba, atei zhɔk zhin shisha te gar min lu. Abɛ di kiki yi vuŋ anu yiŋ ndi ne nai ne miŋ min ai yi ne nai ne Sodɔm, aner abɛ Sodɔm abɛ duŋ ki mimin men. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Fe na mbla zhin ne bɛr yi te ambuk iyik iya min itei naŋ yi aner abɛ yi ne gar kǝ Sodɔm.&gt;&gt;</para>
  <para style="s" vid="MAT 11:24">Nyɛ sɔŋ sik zhin</para>
  <para style="p" vid="MAT 11:24">(Luka 10:21-22)<verse eid="MAT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Nǝ mkpaŋ yuŋɔ Yesɔ ne di, &lt;&lt;Mni nye ru, Tetɛɛ Ŋgɔŋ ne gbarshu bǝn gɔnmimi, ndi une su kiki yiŋɛ yir abɛ mgbemgbebɛ bǝn abɛ zhi ki. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Iyime, Tetɛɛ, ne reu te ubǝ na amɛ.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />&lt;&lt;Tetɛɛ amuŋ ne nek me kiki yiŋɛ bɔbɔk ne aŋɔk amuŋ, ba nuŋ ndi ne zhi Izu Arik se Tetɛɛ. Amɛ inuŋ ba ne zhi Tetɛɛ ma ba sǝ Ivǝn maa ben abaŋ ndi Vǝvǝne ne hria ba te abɛ tsar tu maa.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />&lt;&lt;Nyɛ zhin ben abɛm, izhin abɛ yik iyah, izhin abɛ hru ki yi luk, M tei nek zhin vli kɛ sik. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Baŋ zhin ihru muŋ ihru zhin te vuŋ tsar muŋ, te Nga me yi ne shur kpa ne susun bǝn yaŋ lǝktu, te izhin tei yik sɔŋ sik. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Tǝ ihru muŋ ba luk ba ikiki muŋ iyi fogɔtɔk.&gt;&gt;<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Arik ane bɛr yi sɔŋ sik (Markus 2:23-28; Luka 6:1-5)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Ne mkpaŋ yuŋɔ Yesɔ ne gayir ne min ahwaŋ ane alikama ne bɛr yi sɔŋ sik. Abɛ tsene maa izhɔŋ ne vuŋ ba ankyak a ŋɔr alikama ata <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Ndi Ferisawa ayik amɛ akɔ diu abɛ tɔ abɛ tsene maa ana ki yiŋ ndi ba ne rɛ ka ne bɛr yi sɔŋ sik.<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Asak bama, &lt;&lt;Ba zhin ne zin tɔ bla cɛr yiŋ ndi Doda ne cɛrǝ iwa ben abɛ tsin amaa ndi izhɔŋ ne vuŋ ba kai? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Ne yir akabakɔŋ ayou Arik, te li ki yiŋ ndi ba ne rɛ ka, kɔ aner abɛ tsǝn amaa abɛ li ba, iyi kɛ abɛ na ndum kǝ Arik ankyak. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Ka ba zhin ne zin bla ki ndi Atɔra ne di bɛr yi sɔŋ sik abɛ na ndum kǝ Arik ne min akabakɔŋ ne caŋ bǝn te bane la lɛ kai? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Mbla zhin te waŋ ndi ne naŋ Akabakɔŋ aye yaŋa. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Abɛ di zhin ne zhi ndi ilɛ kǝŋe di, &lt;M wɔb lɔ susun min, bam wɔb tsik me ibaŋ ba,&gt; ba zhin bǝ yik la lɛ abɛ yaŋ lalɛ ba. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Tǝ izu neshir wa ayi ŋgɔŋ ne bɛr yi sɔŋ sik.&gt;&gt;<verse eid="MAT 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Akɔ duŋ amɔ, te yir min akabakɔŋ mǝne, <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Fe neshir nuŋ ne shen ŋɔk aye amuɔ. Awɔb ankɔŋ ne yen Yesɔ ne na ki yiŋ ndi ba ne rɛ ka, a rib bu, &lt;&lt;Nǝ rɛ te abe na neshir te duŋu arɛ ne bɛr yi sɔŋ sik yi?&gt;&gt;<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Adi ba, &lt;&lt;Ndi neshir nuŋ ne miŋ mine ate yi ne wanta, te ne zhaku ne dudu ne bɛr yi sɔŋ sik, ba tei baŋu a gli rumɔ kai? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Itayi tei naŋ te neshir abɛ naŋ wanta! Ndi amɛ, ba ne rɛ ka te abɛ na ki yiŋ ndi ba rɛ ba te be lɔk ner nuŋ ne bɛr yi sɔŋ sik.&gt;&gt;<verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />Fe adi neshire, &lt;&lt;Nab ŋɔk mi.&gt;&gt; Fe anab kɛ, fe iku kam nyak anenen ndi kɛ yaa ma. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Ankyak Ferisawa aru abɛm te kɔte kpa anu ne atɔ maa te wɔb ankɔŋ awaŋ ndi aba tei ŋun Yesɔ.<verse eid="MAT 12:14" /></para>
  <para style="s">Igen ne hria Arik</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Ndi Yesɔ awɔ amɛ, akɔ duŋ amkpama. Aneshir tetɛk ne zeu, ne na ba rɛ ne lɔ mǝne, <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />a nek ba lɛ kǝr abɛ duŋ bla nuŋ te wa ayi ŋɔwa. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Waŋa ayi ki ndi ne shaga ne lɛ kɛ shaya ine bla shar yi Arik ndi azhɔu te Ishaya:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />&lt;&lt;Tɔ zhin igen amuŋ waŋ ndi mene hriau,</para>
  <para style="q2" vid="MAT 12:18">Ayi waŋ ndi me nyeru, Izu muŋ waŋ ndi M ne tanyɛmɛ newu;</para>
  <para style="q1" vid="MAT 12:18">M tei zhɔk Izhu yi Arik ne miŋ susun maa,</para>
  <para style="q2" vid="MAT 12:18">Fe atei na bla aneshir abaŋ ndi ba yi ŋli kɛ Yahudawa ba ne samariya lɛ didik ne ntuntun.<verse eid="MAT 12:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="MAT 12:19" />Ba tei te antam kɔ ŋar tɔ ba;</para>
  <para style="q2" vid="MAT 12:19">Bai waŋ ndi atei wɔ kɔr maa ne kuŋkɔŋ ba.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Ikyuru keŋ ndi ne ce ba tei ka kɛ amlik ba,</para>
  <para style="q2" vid="MAT 12:20">Bai na rim ilu kɛ laŋ watsɔb ba,</para>
  <para style="q1" vid="MAT 12:20">A tei duŋ lɛ didik bǝ li ru.<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />Nǝ sak maa ntuntun ye Samariya atei shur ayi.&gt;&gt;<verse eid="MAT 12:21" /></para>
  <para style="s">Yesɔ ben ŋgɔŋ ne ki tuk</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Ankyak ne gliu ner ne yi ne anerim waŋ ndi ayi amfik ba na lɛ ba, fe Yesɔ duŋu rɛ, te abɛ lɛ te na yik. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Aneshire bɔbɔk ne vuŋ anu ne ki yiŋ ndi Yesɔ ne na, arib te di &lt;&lt;Ka waŋa alɔ yi lǝla Doda ini?&gt;&gt;<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Fe ndi Ferisawa ne wɔ amɛ, akɔ di, &lt;&lt;Waŋa yi ndum ngɔŋ kɛ shetan ankyak, ngɔŋ anerim ayi wa gli anerim arumɔ.&gt;&gt;<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Yesɔ ne zhi ilɛ susun mǝne, tedi, &lt;&lt;kɔte ntun ngɔŋ tayi ndi te ŋar tu maa ba tei klɛ mgbamgbaŋ ba, fe ikɔb maa kɛ gbarshu keŋ ndi te ŋar tu maa ba tei klɛ ba. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Ate yi ndi shetan igli shetan rumɔ, ne gab kpa maa ne tu maa. Ikɔb maa tei na kikin te klɛ? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Ate yi ndi Mǝ gli anerim gli rumɔ ne sak kɛ ngɔŋ anerim, te aner amin agli ba rumɔ ne sak kɛ ŋɔwai? Ne me aba atei te zhin ambuk. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Ba yi amɛ ba, Belzebu bai Izhu iyi Arik ba, waŋ ndi ne nǝm mgbyamgbyaŋ kɛ gli anerim igli rumɔ, fe ikɔb kǝ gbarshu kɛ Arik ne kam nyɛ zhin.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />&lt;&lt;Inuŋ ba atei ŋur ankɔŋ iner ne klik agbɔŋa aŋa te avu kiki maa ba, se ne kuti avuŋ nɛr ne klik waŋa akpa neliŋ; te ashe vu kiki iyi kɔb maa.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />&lt;&lt;Waŋ ndi ba ayi bene bɛm ba ate zor ben abɛm; neme waŋ ndi ba ate zok me biŋ ba avar. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Ne yiŋɛ Mbla zhin, kɔte zumimin tayi bǝn te antam atei zuk zhin zhɔk, ama waŋ ndi ne tun zhi Izhu iyi Arik ba tei zu gu azhɔk ba. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Waŋ ndi ate bla nkanlɛ ne tu Izu Neshir atai zugu zhɔk, waŋ ndi ne tun zhi Izhu iyi Tsetser ba tei zugu zhɔk ba, ne kab kǝŋe kɔ ne kab kɛ nyɛ.<verse eid="MAT 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />&lt;&lt;Duŋ tiŋ nkunkun didik bǝ gli dɔ didik, kɔ kuŋkun mimin bɛ gli dɔ mimin, azhi tiŋ kuŋkun ne dɔ maa. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Izhin ane wa abɛ tus, izhin tei na kikin tǝ bla kiki didik te izhin yi amimin? Anu abla ki yiŋ ndi iyi ne min susun. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Ineshir didik agli kiki didik agli arumɔ ne min kǝ yak ki didik, iner mimin agli ki mimin aglɛ rumɔ ne min kɛ iki kǝ yak ki mimin. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Fe mbla zhin nkan lɛ te aneshir atɛi bla kiyi na mɛn ne bɛr te ambuk ne mɔ lǝlɛ yi sha ndi neshir ablai atɛi vui te tɔi. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Ilɛ mi kɛ tei teu ambuk kɔ ibǝ zugu zhɔk, kɔ ibǝ kpau.&gt;&gt;<verse eid="MAT 12:37" /></para>
  <para style="s">Ŋgir kɛ Yonana</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Ankyak Ferisawa anuŋ bǝn abɛ tsar nken lɛ yi icɛr Musa adi Yesɔ, &lt;&lt;Ine Tsar, ta wɔb te ta bǝ yik ikinuŋ yi vuŋ anu.&gt;&gt;<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Asaga, &lt;&lt;Abɛ na ki mimin bǝn anere abɛ mkpaŋ kǝŋe aba wɔb te aba abɛ yik iki ngɔŋ yi sak aŋɔk ne nu! Ba waŋ ndi atei nugu ikinuŋ yi vuŋ anu ine bla shar yi Arik ndi azhɔu te Yunana. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Ndi Yunana nɛ te bɛr tar bǝn ibu tar ne min ine kɛ ambɛ angɔŋ, iyeme Izu neshir atei na te bɛr atar bǝn bu tar ne min gɔnmimi. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Aneshir abɛ Neneba a tei lu klɛ ne bɛr yi te ambuk bǝn aneshir abɛ mkpaŋ kǝŋe atei yaŋ zhin lɛ, ndi ne duŋ na zumimin men ne wɔ ilɛ kɛ Arik ndi Yunana ne du kɛ; mbla zhin ikinuŋ ngɔŋ iyime naŋ Yɔnana! <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Iwa itum ine shin atei lu te ambuk bǝn kab kǝ ŋa tena ŋun kɛ; te ne nyɛ ne klɛ tu yi gɔnmimi tǝ bɛ wɔ mgbemgbebɛ kɛ Solɔmɔn, fe azizaŋ nuŋ ndi anaŋ Solɔmɔn aye yaŋa.<verse eid="MAT 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />&lt;&lt;Ndi izhu yi shetan ne ru ne kpa kɛ neshire, te kɔmɔ ne zizik gbagbaŋ te duŋ neshire ne wɔb sik bane na yik kɛ ba. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Fe adi itu maa, &lt;M tei ŋur kam kɔmɔ ne kɔb kɛŋ ndi mǝne rurɛ me.&gt; Ndi ne yir kɛ, ne yik nuŋ ba yi ne kɔbɔ ba, ne kun te yis kɔbɔ zhɔk tsetser. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Fe ikɔte vu anerim ataŋgba ndi anaŋu ne zumimin, a shur ne mine fe ayir te sɔŋ amɔ. Ankyak iklɛ tu yi inere ne iyi mimin naŋ yi kuti me. Waŋa ki yiŋ ndi itei yi me ne kab mimin kǝŋe.&gt;&gt;<verse eid="MAT 12:45" /></para>
  <para style="s">Yaa maa Yesɔ ben amun zumen</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Ndi Yesɔ ayi ne min kɛ zen lɛ ben ntsan aneshir, Iya maa ben amunzumen akɛ kli ne abɛm, te aba bɛ lɛ ben abɔu. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Inuŋ ablau te di, &lt;&lt;Iya mi ben amunzumin akɛkli ne bɛm, te ba abɛ lɛ bene bɔu.&gt;&gt;<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />Yesɔ adiu, &lt;&lt;Ŋɔwa ayi yaa muŋ, ane ŋɔ aba ayi amunzumɔr?&gt;&gt; <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />A nab ŋɔk ben abɛ tsene maa, tedi, &lt;&lt;Tɔ! waŋa aye ane yaa muŋ ben amunzumɔr. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Iwaŋ ndi a te na kiyiŋ ndi Tetɛɛ muŋ ne gbarshu ne tanyɛme, ai zumɔr bǝn vamɔr bǝn yaa muŋ.&gt;&gt;<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Nkan lɛ ner ne lɔn</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Ne bǝn Yesɔ ne ru ne kɔbɔ te kɔ te sɔŋ ne anu nek. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Ntsan aneshir ne kamu zǝk te duŋu akɔ yir gumɔ te azǝ asɔŋ ne miŋǝ, aneshir bɔbɔk aklikla ne akɔtɔŋ nǝge. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Fe abla ba nkan lelɛ tetɛk, te di: &lt;&lt;Ine lɔn ne gar tib bǝbǝ ki. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Ndi ne zen yi bǝbǝ me, inuŋ ne hrie ne ankɔŋ, aŋliŋlɔ ne taŋǝ avu amli. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Inuŋ ne hrie ne yiyi, ba yine mimi tetɛk ba. Nǝ flu andanda, ndi mimi me ne kusɔŋ ne atu. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Ndi arik ne ce, ankyak arik ne wu ikime, ne yo te ba yine ririŋ ba. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Bǝbǝ nuŋ ne hrie ne ncɔŋ, ndi dedɔk ne flu te mɔi ŋlɔk. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Bǝbǝ nuŋ ne hrie ne mimi didik, te ru atɔ adidik te dɔ mgbyaŋ tetɛk inuŋ a za sɔk wur, sɔktani kɔ sɔktar ki yiŋ ndi ane tibɛ ma. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Ndi ne lɛ klɛ adi waŋ ndi ayi ne atɔŋ ayi wɔ abɛ wɔ.<verse eid="MAT 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Abɛ tsene maa anyɛ te aribu, &lt;&lt;Anii duŋu lɛ bǝn aneshir ne nkanlɛ?&gt;&gt;<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Yesɔ adi ba, &lt;&lt;Izhi kiki yi suyir yi ikɔb kǝ gbarshu ne nek zhin neyi, ba yi men ba. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Iwaŋ ndi ayi ne ki ana nugu nnuŋ, atei yime yi wanyaŋ. Iwaŋ ndi ayi ne iki vǝtsɔb, atei ta ivǝ yiŋ ndi ayime neyi ayaru ma. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Waŋa ayi ki yiŋ ndi duŋ me lɛ ba ne nkanlɛ:</para>
  <para style="q1" vid="MAT 13:13">&lt;&lt;Atɔ, ba yik ba;</para>
  <para style="q2" vid="MAT 13:13">Awɔ, ba wɔ te zhi ba.<verse eid="MAT 13:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14" />Ilɛ keŋ ndi Ishaya ne di ne atu amen ne shaga:</para>
  <para style="q1" vid="MAT 13:14">&lt;&lt;&lt;Izhin tei wɔ, ba zhin tei zhi ba;</para>
  <para style="q2" vid="MAT 13:14">Izhin tei tɔ, ba zhin tei yik ba.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Ndi asusun aneshir abaŋa ne kpaŋ anyaŋ;</para>
  <para style="q2" vid="MAT 13:15">Ba na awɔlɛ ne atɔŋ amene ba.</para>
  <para style="q2" vid="MAT 13:15">Nǝ ka aku ayi amene.</para>
  <para style="q1" vid="MAT 13:15">M ba amɛ ba abɛ atɔ ayik neyi amene,</para>
  <para style="q2" vid="MAT 13:15">Wɔ ne atɔŋ amene,</para>
  <para style="q2" vid="MAT 13:15">Zhi ne asusun amen</para>
  <para style="q1" vid="MAT 13:15">Ate akam aŋyak, M tei na ba.&gt;<verse eid="MAT 13:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />Nǝk anu didik iyi ne ayi amin ndi ayik, ben atɔŋ amin ndi awɔ. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Mbla zhin izub, atetɛk abɛ bla shar yi Arik bǝn aner abɛ yi tsetser ne wɔb yik kiki yiŋ ndi zhin yigǝ te bane yigǝ ba, te awɔ ki yiŋ ndi izhin wɔi te bane awɔi ba.<verse eid="MAT 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />&lt;&lt;Shir zhin atɔŋ te wɔ ki yiŋ ndi nkanlɛ yi ner ne lɔno idi: <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Inuŋ ndi ate wɔ lɛ kǝ kɔb Arik ndi ba te zhi kɛ ba, shetan anyɛ kum ki yiŋ ndi ne tibɛ ne asusun ata. Waŋa ayi mgbyaŋ ki yiŋ ndi ne yǝi ne ankɔŋ. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Iwaŋ ndi ne ta mgbyaŋ ki yiŋ ndi ne hrie ne yiyi ayi waŋ ndi ne wɔ lɛ te ata kɛ andanda ne nyer. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Ndi ba ayi ne ririŋ ba, ba baŋ mkpaŋ ba. Ndi iyah ben sak iyah te nyɛ ne vuŋ lɛ Arik gli, akɔ kyak zǝ Arik ge. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Waŋ ndi ne ta mgbyaŋ ki yiŋ ndi ne var hrie ne ncɔŋ ayi abaŋ ndi awɔ lɛ kɛ Arik, ama kiki yi tik iyi yi gɔnmimi bǝn ki yi abubu ne nyɛ duŋu ŋursuk ne lɛ kɛ Arik, te yaŋ zǝ kɛ. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Iwaŋ ndi ne ta bǝbǝ yiŋ ndi ne hrie ne mimi didik wa ayi neshir waŋ ndi ne wɔ lɛ kɛ Arik te azhi kɛ. Ana ki yiŋ ndi Arik adi yi amkpaŋ sɔk wur, sɔk tani kɔ sɔk tar ne ki yiŋ ndi ne yime.&gt;&gt;<verse eid="MAT 13:23" /></para>
  <para style="s">Nkan lɛ yi agǝga amimin</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Yesɔ ne na bla ba nkanlɛ nuŋ: &lt;&lt;kɔb Arik kɛ gbarshu iyi ndi ner waŋ ndi ne tib bǝbǝ ki didik ne ahwaŋ. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Ndi aneshir akɔ kur na, ine te zɔr amaa ne gli ibǝbǝ agǝga amimin akɔte ayi ne miŋ kɛ ikpu, te kɔmɔ ki ma. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Ndi kpu mɔ ne tɔ ru atɔ, fe agǝga amimin ne aru ma yi.<verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />&lt;&lt;Ankyak agen abɛ kɔbɔ anyɛ bǝn abɔu te di, &lt;Ŋgɔŋ, ta di kau une tib bǝbǝ ki didik ne ahwaŋ ami o? Agǝga amimin ne aru arɛ amɛ?&gt;<verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />Fe adi ba, &lt;&lt;&lt;Ner nuŋ ine te zɔr wa ne na ki yiŋɛ,&gt;</para>
  <para style="p" vid="MAT 13:28">&lt;&lt;Agen maa adiu te di, &lt;Uwɔb te tabǝ kpob agǝga amimin ne tyak hrie yi?&gt;<verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />Ne di, &lt;&lt;Ba ye amɛ ba,&gt; &lt;Tǝ mkpaŋ ndi izhin te tei kpob agǝga amimin ne, izhin tei kpob ikpu biŋe. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Duŋ zhin aba abɛ flu ndɔndɔ gar mkpaŋ kɛ sɛr. Mkpaŋ kɛ sɛr: Nǝ mkpaŋ yuŋɔ M tei bla abɛ sǝrǝ; abɛ kuti ayak agǝga amimin ne te kpai aŋɔŋɔk te agɔŋǝ ne lu; Fe biŋ zhin ikpu gar shur me zhin ne wun.&gt;&gt;&gt;<verse eid="MAT 13:30" /></para>
  <para style="s">Nkan lɛ yi nklik bǝn yist</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Ne na bla ba nkanlɛ nuŋ: &lt;&lt;Ikɔb kǝ gbarshu iyi ndi bǝbǝ nklik, ndi neshir ne baŋǝ atib ne ahwaŋ amaa. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Amɛ ayi bǝbǝ ki vǝtsɔb ne kab bǝbǝ ki yi min, ite flu, ite tiŋ kuŋkun ngɔŋ ne ahwaŋa te tiŋ nkunkun, te duŋ aŋliŋlɔ ne gbarshu anyɛ shɔr anjer ne ngǝŋga maa.&gt;&gt;<verse eid="MAT 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Ne na bla ba nkanlɛ nuŋ: &lt;&lt;ikɔb kǝ gbarshu iyi ndi yist ndi wa nuŋ ane baŋ kɛ kam ashur ne mumuŋ tetɛk te duŋǝ saŋ.&gt;&gt;<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Yesɔ ne lɛ kab nkanlɛ yiŋɛ ben ntsan aneshir; Bane ablaa ba kinuŋ yaŋ nkan lɛ ba. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Nǝ amɛ nkanlɛ kɛ ine bla shar yi Arik ne shaga:</para>
  <para style="q1" vid="MAT 13:35">&lt;&lt;M tei mbu anu amuŋ te mla nkan lɛ,</para>
  <para style="q2" vid="MAT 13:35">M tei mbla kiki yiŋ ndi ne asui ayir rɛ mkpaŋ kɛ na gɔnmimi.&gt;&gt;<verse eid="MAT 13:35" /></para>
  <para style="s">Itsǝk nkan lɛ agǝga amimin ŋar</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Fe ne duŋ ntsan aneshir te ayir miŋ kɔbɔ. Abɛ tsene maa ne anyɛ bǝn abɔu tedi, &lt;&lt;Tsik nkanlɛ yi agǝga amimin ne ahwaŋ ŋar ta.&gt;&gt;<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />A di ba, &lt;&lt;waŋ ndi ne tib bǝbǝ didik ayi Izu neshir. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Ahwaŋa ayi gɔnmimi, bǝbǝ ki didige ayi amumun abɛ kɔb Arik. Agǝga amimine ayi amumun abɛ shetan, <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />Ine te zɔr waŋ ndi ne atibi ma wa ayi shetan. Iser iyi klɛtu yi gɔnmimi, abɛ sɛre ayi abɛ shar ayou Arik.<verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />&lt;&lt;Yir keŋ ndi ne kpob agǝga ashur ne lu, amɛ klɛtu yi gɔnmimi tei yime. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Izu neshir atei shar abɛ shar ayou Arik, atei kpob bɔbɔk iki yi duŋ aneshir ana zumimin ne ikɔb kǝ gbarshu agli arumɔ. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />atei tyak ba ashur ne miŋ lu kǝ lalaaŋ, abɛ zhin bǝn ŋu aŋin. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Fe abɛ yi tsetser atei laŋ ndi arik ne ikɔb Tetɛɛ amen. Iwaŋ ndi ayi ne atɔŋ ayi wɔ abɛ wɔ.<verse eid="MAT 13:43" /></para>
  <para style="s">Nkanlɛ yi suyir adudunki bǝn mkpaŋ yi tǝ anyaŋ</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />&lt;&lt;Ikɔb kǝ gbarshu iyi ndi adudunki ayiŋ ndi ne asu e ayir ne ahwaŋ. Ndi ner nuŋ ne yenɛ abaŋ, te akama asue ayir, fe tɛ azǝn tuk nyer tɛ gar avu kiki maa alɛb bɔbɔk tɛ alɛb ahwaŋa.<verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />&lt;&lt;Har azizaŋ, ikɔb kǝ gbarshu iyi ndi iner waŋ ndi ayi ne adudunki te awɔb mkpaŋ yi te anyaŋ. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Ndi ne yik mkpaŋ nuŋ yi klɛ azɔb, aru akɔmɔ te a gar avu kiki maa bɔbɔk alɛb te anyɛ lɛbǝ.<verse eid="MAT 13:46" /></para>
  <para style="s">Nkan lɛ yi burgi ne vu ambɛ</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />Ne na di, ikɔb kǝ gbarshu iyi ndi burgi ne vu ambɛ waŋ ndi ne arigu azhɔk ne miŋ amashir te avu ambɛ tetɛk. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Ndi ne shaga ne vu ambɛ me ne gburu agli ru ganki. Fe akɔ zǝ asɔŋ te akpob ambɛ adidik ashur ne sǝsa, te tyak amimin ne ahrie. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Itei yi amɛ ne klɛtu yi gɔnmimi. Arik atei shar abɛ shar ayou Arik atei nyɛ te hria abɛ zumimin bene abɛ yi tsetser. <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />atei tyak ba shur ne miŋ lu kǝ lalaaŋ, amɔ atei zhin te aŋu aŋin.<verse eid="MAT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Yesɔ adi ba &lt;&lt;Izhin ne zhi kiki yiŋɛ bɔbɔk yi?&gt;&gt;</para>
  <para style="p" vid="MAT 13:51">&lt;&lt;Ata nyɛmɛ,&gt;&gt; Adi.<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Adi ba te di, &lt;&lt;kɔte ne tsar tawa ne cɛr yi Musa waŋ ndi ne du lɛ kɛ ikɔb kǝ gbarshu ayi ndi ataki ne kɔb ndi ne vu adudunki ayayas bǝn acicɛ agli rumɔ ne iki kǝ yak ki.&gt;&gt;<verse eid="MAT 13:52" /></para>
  <para style="s">Yaŋ nek ŋgɔŋ kɛ ner ne bla shar Arik</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Ndi Yesɔ ne bla nkanlɛ yiŋɛ klɛ bɔbɔk, ne kam atibe ne amkpa ma. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Ndi ne nyɛ itun maa, ne kɔ tsar ba ne akabankɔŋ, fe ne vuŋ anu. Arib tedi, &lt;&lt;Ner waŋa ne ayik mgbemgbeb kǝŋe arɛ bene mgbyamgbyaŋ kɛ na kiki yi vuŋ anu yiŋe arɛ amɛ ma?&gt;&gt; <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Ba waŋa ayi zu ner ne kpaŋ nkunkun waŋa ka yi? Ba yi wa azhɔ yaa maa tǝ Meryamu ka yi? Amun zumen ayi ane Yakubu, Yusuu bǝn Siman bǝn Yahuda kai? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Amunvamen ba aba ayi bǝn abɛta ka yi? Fe wa ne ata ki yiŋɛ arɛ amɛ ma?&gt;&gt; <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Fe akɔ baŋ afuk ne tu amaa.</para>
  <para style="p" vid="MAT 13:57">Ankyak Yesɔ adi ba, &lt;&lt;Ine bla shar yi Arik ba yik ishak ayi ne ntun maa bǝn kɔb maa ba.&gt;&gt;<verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />Amɛ ba ne na kiki yi vuŋ anu amuɔ ba ne lɛ kɛ yaŋ tanyɛmɛ men.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Ne kyaŋ tu kɛ Yɔɔna ne suu aneshir</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Nǝ kpaŋ yuŋɔ Itum Hiridus ne wɔ ru sak kɛ Yesɔ, <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />fe abla agen amaa, &lt;&lt;Waŋa ayi Yɔɔna ne su aneshir; ne ku te kama lu! Waŋa yi kiyiŋ ndi mgbyamgbyaŋ kǝ na kiki yi vuŋ anu iyi ne atɔ maa.&gt;&gt;<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Ndi Hiridus ne mǝne vuŋ Yɔɔna te kpau te ku ne jaru ne tu ayi Hirudiya, iwa zumen Filibus, <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />te Yɔɔna ne zen blau te di: &lt;&lt;Icɛre bane tanyɛmɛ ba te ubǝ gliu ba.&gt;&gt; <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Hiridus ne wɔb te wa abɛ ŋun Yɔɔna, ne klu sisik aneshir, te ayigu ayi ine bla shar yi Arik.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Nǝ iber yi ŋli Hiridus ne kama nyɛ fe va ayou Hirudiya ne glu te duŋ susun kɛ Hiridus ne nyɛr. <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />Tǝ ne sherim tedi wa atei nugu kiyiŋ ndi atei bene. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Iya maa ne shɔgu, tedi, &lt;&lt;Gar di abɛ nugu itu kɛ Yɔɔna ne su aneshir ne agbǝgba.&gt;&gt; <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Fe susun kɛ Itum ne cɔkla, neka sherim ne ti kɛ abɛ nyɛ gyaŋ maa, ne tanyɛme te abɛ nugu kiyiŋ ndi ne bene <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />te duŋ ate kyaŋ tu kɛ Yɔɔna ne jaru. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Ne gliu tu mɔ ne agbǝgba te nyɛ nek vǝvǝn iwa ma, iwa nena ta Gli yaa maa. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Abɛ tsene maa na ndum ne nyɛ te baŋ mkpuŋ kpa maa akɔ te ru te kɔmɔ te bla Yesɔ.<verse eid="MAT 14:12" /></para>
  <para style="s">Yesɔ ne nek aneshir azhin atuŋ kili</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Ndi Yesɔ ne wɔ me, ne lɔ duŋ amkpama te yir igu te gar amkpa nuŋ. Nak wɔ yiŋɛ ntsan aneshir azeu ne za rɛ ntuntun. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Ndi Yesɔ ne yir te yik ntsan aneshir ŋgɔŋ, ne wɔ lɔ susun mǝne te na ba te duŋ ba rɛ.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Ndi amgbalu nɛ te, abɛ tsene maa gar bǝn abɔu te di, &lt;&lt;Amkpa waŋa ayi ne kɔnsa, bau duŋ aneshir aŋar akɔmɔ nǝ ntuntun, te amkpa neka te riri. Tǝ abe te lɛb kili ali.&gt;&gt;<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Yesɔ asaga, &lt;&lt;Bane te tǝ bɛ kɔmɔ ba. Nǝk zhine ba kinuŋ atali.&gt;&gt;<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />&lt;&lt;Adiu tayi ne mwɔ mgbyaŋ borodi me tuŋ bǝn ambɛ me yaa,&gt;&gt; aba sagu ma. <verse eid="MAT 14:17" /><verse number="18" style="v" sid="MAT 14:18" />Yesɔ adi, &lt;&lt;Glim azhin ne yime.&gt;&gt; <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Akɔ di aneshire abɛ zǝ sɔŋ ne agǝga shushu. Abaŋ borodi me tuŋ ma tena baŋ ambɛ ayaa ma te lɛk ayi atɔ gbarshu, te nyer Arik te mlik borodi me. Te nek abɛ tsene maa, aba na ta gab aneshire. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Aneshire ne li bɔbɔk mǝne te hri te vu mbumbur ndi ne dǝk ge ashak sisa me wur ane yaa. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Abaŋ ndi ne li kili me ne yi alulum azhin amɛ tuŋ, bane bla amba ben amumun ba.<verse eid="MAT 14:21" /></para>
  <para style="s">Yesɔ ne tsǝn ne atɔ amashir</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Andanda Yesɔ akɔ di abɛ tsene maa abɛ yir miŋ igu te kuti aglɔ agar gɔŋ yuŋ, fe ne duŋ ntsan aneshire aŋar baliŋ. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Ndi ne duŋ aneshir akɔmɔ, ne yuŋ gar kɛ atugbu Iwa kiki maa te gar ben Arik. Ndi amgbalu ne te, aye amɔ kiki maa, <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Ndi gumɔ ne yi shaan ne agankubgbu, ankyak ankun amashir akar igu te nguŋgu ŋgɔŋ fuk atu nege.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />Ndi Kǝrfe tar kɛ bu ne te gbahir Yesɔ a nyɛ bǝn abɛ tsene maa, te atsǝnetsǝn netu amashire. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Ndi abɛ tsene maa ne yigu atsǝnetsǝn ne tɔ amashire, fe sisik ku vuŋ ba. &lt;&lt;Ayi anerim,&gt;&gt; adi, te ŋar zhin ne sǝsǝk.<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Ankyak Yesɔ akɔ diba andanda: &lt;&lt;klik zhin susun! Ayi Nga. Duŋ te zhinbe klu sisik ba.&gt;&gt;<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />&lt;&lt;Ŋgɔŋ, atei wa,&gt;&gt; Biturus asaga, &lt;&lt;ta nyɛmɛ tem nyɛ bene bɔu ne atu amashire.&gt;&gt;<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />&lt;&lt;Nyɛ,&gt;&gt; adi. Fe Biturus aru ne miŋ igu, te tsǝn ne tɔ amashire te gar ben Yesɔ. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Ndi ne yik fuk ngungumɔ ite ngɔŋ, ne klu sisik te akɔ zen rim dɔ ne min amashir, te ŋar zhin, &lt;&lt;Ŋgɔŋ, tam zhɔk!&gt;&gt;<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Andanda Yesɔ anab ŋɔk maa te vuŋu. Adi, &lt;&lt;Uwa ne tanyɛmɛ watsɔb,&gt;&gt; &lt;&lt;Anii duŋu lɛ ne?&gt;&gt;<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Fe ndi ne yir igu, ŋguŋgumɔ ku te zee. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Ankyak abɛ yi ne miŋ igu akɔ zekuru, tedi, &lt;&lt;Ayi zub Uyi Izu Arik.&gt;&gt;<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Ndi ne ka glɔ agankubgbu, ne zǝ ne ntun iyi Jenisara. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Ndi alulum abɛ amkpa yuŋɔ atɔ Yesɔ azhi, akɔ shar azǝ ntuntun. Aneshir bɔbɔk ne gli abɛ lɔ gliu ma <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />te benu te di abɛ duŋ abɛ lɔmɔ bɛ sak ŋɔk ne tɔŋ anklu maa, fe bɔbɔk abaŋ ndi ne sagu ŋɔk ne rɛ.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">Tsetser ben Rik</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Ferisawa anuŋ ben abɛ tsar atɔra ne nyɛ ben Yesɔ arɛ urshelima te arib, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />&lt;&lt;Ayi anii duŋ abɛ tsene maa akyak zǝ taada ayɔu anunkub? Ba aŋla aŋɔk te shi ali ki li ba!&gt;&gt;<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Fe Yesɔ asaga, &lt;&lt;Aye anii te zhineba min yime zǝ taada amin te tsi ilɛ kǝ Arik kluk?&gt;&gt; <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Arik ne di, &lt;Nek Tetɛɛ ben iyah mi ŋgɔŋ men&gt; te &lt;waŋ ndi a te yen Tetɛɛ ma kɔ ya ma atei ŋunu. <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Izhineba di &lt;&lt;waŋ ndi ate di &lt;Ki yiŋ ndi me ni ndi mǝ ntei ndigǝ nugu ma, M tei kame nek Arik&gt; <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Ba tei nek Tetɛɛ maa ne yi ba. Amɛ une kyak zǝ lɛ kɛ Arik ne atu ayi taada amin. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Izhin abɛ kamgli! Ishaya ne men abla anenen ndi ane bla lɛkǝ nyɛ ne atu amin:<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />&lt;Anere abaŋa azǝm ne bɛrenu ankyak,</para>
  <para style="q2" vid="MAT 15:8">Asusun amene ayi gbagbaŋ ben abɛm.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Azekur me sha;</para>
  <para style="q2" vid="MAT 15:9">Itsar mǝne ayi lǝlɛ yi rɛ ben aneshir.&gt;&gt;&gt;<verse eid="MAT 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Yesɔ ne zhɔ ntsan aneshire tedi, &lt;&lt;Wɔ zhin te na zhi zhin. <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Bai ki yiŋ ndi iyir anu neshir iyi duŋ neshir &lt;cɔk la ba,&gt; ama ayi kɛ yiŋ ndi ru rɛ anu amaa, iyi duŋu &lt;Ayi ne rik.&gt;&gt;&gt;<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Fe abɛ tsene maa anyɛ bǝn bau te blau te di une zhi Ferisawa a te mfu ndi ne wɔ lɛ mi?<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />A tanyɛmɛ te di, &lt;&lt;Iwu keŋ ndi Tetɛɛ bai ŋgɔŋ ne gbarshu wa ne shi kɛ ba atei tun kɛ ne ririŋ maa. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Duŋ ba; ba duŋ aneshir tɔ kɔ ne ti ba. Te yi ndi ner ne amfik wa gli ner ne amfik tsǝne, yaa mǝne atei zhaku ne dudu.&gt;&gt;<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Biturus a di,&lt;&lt; Hria ta nkanlɛ yiŋɛ.&gt;&gt;<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />&lt;&lt;Ba zhin ne zen zhi ki bla muŋɔ kai?&gt;&gt; Yesɔ ne rib ba. <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />&lt;&lt;Ba zhin ne zhi te ki yiŋ ndi yir anu, igar miŋ te ru ne kpa maa kai? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Fe iki yiŋ ndi ne ruu rɛ anu ire susun, iyi duŋ neshir&lt;cɔk la.&gt; <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Iki mimin iru rɛ susun, ŋun neshir, wɔb amba bǝn wɔb alulum, izhib, bla ki yiŋ ndi bau ne yige ba, bǝn ti mu. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Waŋa ki yiŋ ndi duŋ neshir&lt; cɔk la&gt;; Ili ki li yaŋ ŋla aŋɔk ba yi duŋɔ &lt;ayi ne rik ba.&gt;&gt;&gt;<verse eid="MAT 15:20" /></para>
  <para style="s">Itanyɛme yi wa ne Kanana</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Ndi ne duŋ amkpama, Yesɔ ne lu te kɔmɔ ne tun yi Taya ben Sidon. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />I wanuŋ ne Kananiya vǝŋɔ ne ntuno anyɛ bǝn bau, te lɛk kɔr te di, &lt;&lt;Ŋgɔŋ, lǝla Doda, lɔ susun muŋ! anerim ne yir kpa kɛ va muŋ te nǝgu ya tetɛk.&gt;&gt;<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Yesɔ bane di kinuŋ ba. Fe abɛ tsene maa anyɛ abenu te di, &lt;&lt;Duŋu akam atibe, te azǝn ya ta atɔŋ.&gt;&gt;<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />A tanyɛmɛ te di, &lt;&lt;Ne shar me bǝn abɛ yi ndi awanta abɛ dɔ ne Isrela ankyak.&gt;&gt;<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Iwama anyɛ zekuru ne ti maa te di, &lt;&lt;Ŋgɔŋ, lɔk me ma!&gt;&gt; Iwa ma adi.<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Fe Yesɔ a tanyɛmɛ te di lɛ didik, &lt;&lt;ba rɛ te abɛ nek ane viu kili amumun ba.&gt;&gt;<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />&lt;&lt;Iyeme, Ŋgɔŋ,&gt;&gt; Fe iwa ma adi, ane viu ma ataŋ mbumbur yiŋ ndi ne kye hrie rɛ ne mimi ali.&gt;&gt;<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Yesɔ a ta anyɛ me te di, &lt;&lt;Iwa, tanyɛmɛ mi iyi ngɔŋ! Ne nugu iki yi wɔb mi.&gt;&gt; Ne amkpamkpama ma iva maa ne rɛ.<verse eid="MAT 15:28" /></para>
  <para style="s">Yesɔ ne yɔk aner azhin anas</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Yesɔ ne duŋ amɔ te atsine goŋ ari anyaŋ nek ne Galili. Ne yuŋ itu gbu te azǝ asɔŋ. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Ntsan aneshir anyɛ akamu azǝk, te gli abɛ aglugluk, abɛ amfik, abɛ amkpuk, abɛba, bǝn anuŋ tetɛk, te anyɛ shur ba ne ti ma; fe ne duŋ ba rɛ. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Aneshire ne yik ki yi shak susun ndi ayik abɛba akli zen lɛ, aglugluk alu atsǝn abɛ amfik ayik. Akɔ gbar Arik ane Isrela asak.<verse eid="MAT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Yesɔ ne zhɔ abɛ tsene maa agli anyɛ me te di, &lt;&lt;Me lɔ susun kɛ aneshir abaŋa; Ayi bene bɛm bɛr tar azizaŋ bane yik kinuŋ ali ba, Bam tei nduŋ ba akam akɔmɔ ne kasa ba, atei mlik kɔŋ ne ankɔŋ.&gt;&gt;<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Abɛ tsene maa adi, &lt;&lt;Ta tei yik ki li tetɛk neme ndi ntsan aneshir abaŋa atei lii ahri?&gt;&gt;<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Yesɔ a rib ba, &lt;&lt;Izhin Gli mbwab borodi ben?&gt;&gt; Adiu,</para>
  <para style="p" vid="MAT 15:34">&lt;&lt;Itaŋgba,&gt;&gt; &lt;&lt;Bǝn ambɛ watsɔb.&gt;&gt;<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Adi ntsan aneshire abɛ azǝ asɔŋ ne mimi. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Fe avu mbwab borodi taŋgba yiŋɛ ben ambɛ me, ndi ne nyɛr Arik, fe amlik kɛ anǝk abɛ tsene maa, aba ata kɛ agab aneshir. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Bɔbɔk mǝne ne li te hri. Abɛ zeu tsǝn ne taŋ nki kili me avu ashak sisa me taŋgba. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Abaŋ ndi ne li kili me ane yi alulum azhiin anas ban di amba bǝn amumun. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Ndi ne duŋ ba akɔmɔ, ne ayir igu te kɔmɔ ne ŋaa kɛ Magadan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">Iwɔb Mgbeb</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Ferisawa bǝn Sadukiyawa ne nyɛ bǝn Yesɔ te wɔbu ne akla te adiu abɛ tsar ba ikinuŋ yi vuŋ anu yi rurɛ gbarshu.<verse eid="MAT 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2" />Adi ba, &lt;&lt;Amgbalu te tei, izhin di, &lt;abɛm atei fuk, gbarshu tei yi sɛsen,&gt; <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Amblimblɛ, &lt;Aliŋe akpa atei klɛku ntuno bɔbɔk, izhin di aliŋe alu a tei shir titib.&gt; Izhin zhi bla tsǝn kɛ akpa ayi gbarshu, te yaŋ shuzhi ikinuŋ yi vuŋ anu ndi ndi Arik azǝn nai. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Izhineba ikab mimin abɛ na ki mimin ndi zhin wɔb te abɛ na zhin ikinuŋ yi vuŋ anu, ba tei nek zhin ngir inuŋ ndi naŋ yi Yunana ba.&gt;&gt; Yesɔ akɔ akam atibe te duŋ ba.<verse eid="MAT 16:4" /></para>
  <para style="s">Bumbur atuntu kɛ Ferisawa ben Sadukiyawa</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Ndi ne glɔ nkam amashir ngɔŋɔ abɛ tsene maa ane aŋur asuk ne baŋ borodi. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Yesɔ adi ba&lt;&lt;Ti zhin zǝǝ; sɔŋ zhin atsitsir ne tu ayi kɛ ane Ferisawa ben Sadukiyawa.&gt;&gt; <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />Fe aku alɛ ne akpa mɛn te di, &lt;&lt;Ayi ki yiŋ ndi bata ne Gli borodi nuŋ ba.&gt;&gt;<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Ndi Yesɔ ne amen azhi ki yi lɛ mǝne, arib ba, &lt;&lt;Izhin abɛ tanyɛmɛ watsɔb, te izhin lɛ anii ne akpamin te di ba zhin ne gli borodi ka? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Ba zhin ne zen zhi ka? Ba zhin ne shu zhi mbwab borodi tuŋ iyi aneshir azhin atuŋ ben sisa ben yiŋ ndi izhin ne taŋǝ? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />kɔ mbwab taŋgba iyi aneshir azhiin anas ben sisa yiŋ ndi zhin ne taŋǝ biŋ? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Aye anii te ba zhin ne zhi tedi mli ben abɛ zhin ne atu ayi borodi kai? Sɔŋ zhin zee netu ayi lǝlɛ ye Ferisawa bǝn Sadukiyawa.&gt;&gt; <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Ankyak aku azhi te di, ba lɛ ben aba ne atu ayi sɔŋ atsitsir yi yist kɛ borodi ba, ama ne atu ayi bla yi Ferisawa ben Sadukiyawa.<verse eid="MAT 16:12" /></para>
  <para style="s">Biturus ne bla ka ayi ŋɔwa ayi Yesɔ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Yesɔ ne yir ŋa kɛ Kaseriya Filibi, ne rib abɛ tsene maa, &lt;&lt;Aneshir adi Izu neshir ayi ŋɔwa?&gt;&gt;<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />Fe adiu te di, &lt;&lt;Anuŋ adi Yɔɔna ne su aneshir; Anuŋ ana adi Iliya; anuŋ ana di, Irmiya kɔ zhin ne min kɛ abɛ bla shar yi Arik.&gt;&gt;<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />&lt;&lt;Tǝ izhineba fa?&gt;&gt; Arib ba, &lt;&lt;izhin di me yi ŋɔwa?&gt;&gt;<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />Siman Biturus atanyɛmɛ, &lt;&lt;Iwa uyi Almasihu, Izu Arik tsitsir.&gt;&gt;<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Yesɔ atanyɛu ma te di, &lt;&lt;Ne nǝgu anu didik, Siman izu Yunana, ba yi neshir yi ne ikpa kǝ yi ne azhizhi wa ne blau ki yiŋɛ ba, ai Tetɛɛ muŋ ne gbarshu. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Mblau iwa uyi Biturus, ne tu mkpaŋ yiŋɛ M tei me akabankɔŋ, te nkunkɔŋ yi gɔnmimi kǝ ku ba tei zir kɛ ba. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />M tei nǝgu yaya kɛ bu ikɔb kǝ gbarshu; iki yiŋ ndi utǝ tanyɛmɛ neyi ne mimi Arik atei na tanyɛmɛ neyi ne gbarshu, Iki yiŋ ndi utǝ kyagǝ ne gɔnmimi Arik atei na kyagǝ ne Shu.&gt;&gt; <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Fe akɔ gbaŋ abɛ tsene maa atɔŋ te di kǝr abɛ abla nuŋ te di iwa ayi Kristi me ba.<verse eid="MAT 16:20" /></para>
  <para style="s">Yesɔ ne bla iku ma kɛ nyɛ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Baŋ rɛ mkpaŋ yuŋɔ Yesɔ akɔ avuŋ bla abɛ tsene maa te di wa atei naga kɔmɔ ne Urshelima te yik iya ntentek ne aŋɔk ayi anunkub, ngɔŋ ne abɛ na ndum kǝ Arik, bǝn abɛ tsar Atɔra, mgbamgbaŋ atei ŋun wa ne bɛr yi ntar wa atei lu anyak tsitsir.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Fe Biturus avuŋu agli aru gar zhin te veu. &lt;&lt;Sam, Ŋgɔŋ!&gt;&gt; Adi. &lt;&lt;Iki yiŋɛ ba tei vuŋu ba!&gt;&gt;<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Yesɔ akam atɔ Biturus te diu, &lt;&lt;Sɛr kɔmɔ shaan bǝn abɛm, iwa shetan! Uyi iki yi duŋ aneshir ana zumimin; iki yi lɛ ne susun mi ba rure bǝn Arik ba, te nak hru yi aneshir.&gt;&gt;<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Fe Yesɔ adi abɛ tsene maa te di, &lt;&lt;Waŋ ndi atei zǝm, abɛ kyak itu maa, te abaŋ mkpɔk nkunkun kǝ gen maa te zǝm. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Waŋ ndi ate gli ivli maa, atei yaŋ kɛ, waŋ ndi ate yaŋ ivli maa ne tu amuŋ atei yik kɛ <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Itei na neshir ki didik anii ndi abɛ nugu gɔnmimi bɔbɔk te bɛ yir lu? Tǝ iner atei baŋ anii anǝk tɛ kama ivli maa? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Izu neshir atei nyɛ ne miŋ kɛ ngɔŋ kɛ Tetɛɛ maa bǝn abɛ shar ayou Arik, fe atei nek kɔ te ŋɔwa iki yiŋ ndi nena. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Mbla zhin izub, anuŋ ndi aklɛkli ayaŋa ba tei ku ba se ne she yik Izu neshir asɔŋ anyɛ re ikɔb kǝ gbarshu ne miŋ kɛ ngɔŋ maa.&gt;&gt;<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Kam sen yi Yesɔ</para>
  <para style="r">(Markus 9:2-13; Luka 9:28–36)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Ndi bɛr tani ne gayir Yesɔ ne gli Biturus bǝn Yakubu ben izumen Yɔɔna, te gli ba te yuŋ tu gbu aba kiki men. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Amuɔ kpa maa ku sɛn ne ti mǝne. Iti maa ne laŋ ndi a arik ane laŋ, fe kiki yiŋ ndi ne sui kam klak ndi laŋ lu. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Ne baŋ ba Musa bǝn Iliya amuno ruu bama, te lɛ bǝn Yesɔ.<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />Biturus adi Yesɔ, &lt;&lt;Ŋgɔŋ, ire tǝ ta yi ayaŋa, M tei na bur me tar: Izhiin kɛ Musa fe izhiin kɛ Iliya.&gt;&gt;<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Ndi ayi ne min kɛ lɛ akpa ye laŋ anyɛ lab aku ba, fe awɔ kɔr rurɛ amkpama te di, &lt;&lt;Waŋa ai Izu muŋ, Me nyeru tetɛk, wɔ zhin ne wu.&gt;&gt;<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Ndi abɛ tsene maa awɔme, azhaku akur ne mimi, fe akɔ te sisik. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Ankyak Yesɔ ne nyɛ te sak ba ŋɔk. &lt;&lt;Lu zhin,&gt;&gt; adi. &lt;&lt;Duŋ klu zhin sisik ba.&gt;&gt; <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Ndi ne lɛk ayi atɔ shumɔ, ba nena yik nuŋ ba anaga yi Yesɔ wa.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Ndi ne zen zi rɛ gbu, Yesɔ ne nek ba lɛ, &lt;&lt;Duŋ bla nuŋ iki yiŋ ndi izhin ne yik, se ndi Izu neshir ne kama lu ne ku.&gt;&gt;<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Abɛ tsene maa aribu, &lt;&lt;Tǝ aye nii abɛ tsar nkanlɛ adi te Iliya wa atei kuti anyɛi?&gt;&gt;<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Yesɔ asaga, &lt;&lt;Amɛ, Iliya atei nyɛ atei kam ki bɔbɔk aŋyaga. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Tǝ mblazhin, Iliya ne ka nyɛ, fe bane tɔu ashak ayi ba, te nau kiyiŋ ndi asusun amen ne tanyɛme. Ne mee Izu Neshir atei yik iyah ne ŋɔk amen.&gt;&gt; <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Ankyak abɛ tsene maa azhi te di alɛ netu ayi Yɔɔna ne su aneshir.</para>
  <para style="s" vid="MAT 17:13">Ne na Vǝvǝn ndi anerim ne yir kpa maa</para>
  <para style="p" vid="MAT 17:13">(Markus 9:14-29; Luka 9:37-43a)<verse eid="MAT 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Ndi ne yir ntsan aneshir, Iner ate gbahir ben Yesɔ te tar agbarum ne ti maa. <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />&lt;&lt;Ŋgɔŋ, wɔ lɔ susun kɛ zumuŋ,&gt;&gt; adi. &lt;&lt;Aku amkpen, te yik iyah tetɛk. Mkpaŋ nuŋ azhaku ne lu kɔ ne miŋ amashir. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Mne gliu te ngar bǝn abɛ tsene maa, ama bane duŋu a rɛ ba.&gt;&gt;<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />&lt;&lt;Izhin abɛ yaŋ tanyɛmɛ bǝn kab kɛ klik tu kǝŋe,&gt;&gt; Yesɔ asaga, &lt;&lt;Amkpaŋa ben mtai yi bene bɛ zhin? Amkpaŋa ben mtai sɔŋ bene bɛ zhin? Glim azhin vǝvǝne.&gt;&gt; <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Yesɔ ne tsaŋ anerim, fe ne ru ne kpa vǝvǝne, ankyak akɔ rɛ ne mkpaŋa.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Ankyak abɛ tsene maa a nyɛ bǝn Yesɔ ne kɔnsa te rib, &lt;&lt;Aye nii duŋ ta yarǝ rumɔ lak kana?&gt;&gt;<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Asaga, &lt;&lt;Itanyɛmɛ mine iyi watsɔb. Mbla zhin izub, izhin te tanyɛmɛ watsɔb ndi bǝbǝ nklik, izhin tedi gbu yiŋɛ, &lt;Sɛr kɔmɔ ne gar yuŋ&gt; Itei sɛr. Kinuŋ bai naŋ zhin na ba.&gt;&gt;<verse eid="MAT 17:20" /></para>
  <para style="s">Yesɔ ne na bla iri ku ne na nyɛ maa</para>
  <para style="r">(Mar 9.30-32; Luka 9.43-45)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Ndi ne nyak anyɛ biŋ ne Galili, Yesɔ adi ba, &lt;&lt;Izu Neshir atei baŋu sak ne aŋɔk aneshir. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />atei ŋunu, fe ne bɛr iyi ntar atei kama lu.&gt;&gt; Fe asusun abɛ tsene maa aluk.<verse eid="MAT 17:23" /></para>
  <para style="s">Akabaŋkɔŋ anii ta Gendu</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Ndi Yesɔ bǝn abɛ zeu tsǝne amaa ne ka yir Kafanahum, abɛ ta gendumɔ anyɛ ben Biturus te rib, &lt;&lt;Ine tsar ami ba yaa gendu iyi kɔb Arik kai?&gt;&gt;<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />&lt;&lt;Iye me, a yaa,&gt;&gt; asaga.</para>
  <para style="p" vid="MAT 17:25">Ndi Biturus ne yir kɔbɔ, Yesɔ ne kuti alɛ. &lt;&lt;U yik kikin, Siman?&gt;&gt; Arib. &lt;&lt;Ire bǝn ŋɔwa atum abɛ gɔnmimi ata ndum bǝn gendu iyi amumun amen ka bǝn anuŋ ini?&gt;&gt;<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />&lt;&lt;Bǝn anuŋ,&gt;&gt; Biturus asaga.</para>
  <para style="p" vid="MAT 17:26">&lt;&lt;Fe iye me ne kpob amumun amene,&gt;&gt; Yesɔ adiu. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />&lt;&lt;Ndi kǝr ta bǝ duŋ ba abɛ te mfu ba, kɔmɔ ne tuk te zhɔk ki vu ambɛ ne ndɔ. Baŋ ambɛ ane kuti; te bu anu amaa fe utei yik azɔb amɛ anas. Baŋ kɛ gli bama imuŋ bǝn imi.&gt;&gt;<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Ŋgɔŋ ne kɔb kɛ Shu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Nǝ mkpaŋ yuŋɔ abɛ tsene maa anyɛ bǝn Yesɔ te rib bu, &lt;&lt;Ayi ŋɔwa ayi ŋgɔŋ ne ikɔb kǝ gbarshu?&gt;&gt;<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />A zhɔ vǝvǝn vǝtsɔb aŋyak ne atsutsu amene. <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />Te di, &lt;&lt;Mbla zhin izub, mba zhin te kam te ndi amumun amɔ tsɔtsɔb ba, ba zhin tei yir ikɔb kǝ gbarshu ba. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Amɛ, iwaŋ ndi te kam tu maa ate ndi vǝvǝn vetsɔb iwa atei yi ŋgɔŋ ne ikɔb kǝ gbarshu.<verse eid="MAT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 18:5" />&lt;&lt;Waŋ ndi ate ta vǝvǝn vǝtsɔb ne sak muŋ ne ta ayi nga. <verse eid="MAT 18:5" /><verse number="6" style="v" sid="MAT 18:6" />Fe waŋ ndi ate duŋ zhiin ne miŋ kɛ abɛ tanyɛmɛ bene bɛm abaŋa ate duŋ nuŋ azhaku nǝ lalɛ, itei rɛ ndi abɛ kpa nɛrɛ mkpaŋ nena ne tɔ te atugu azhɔk ne rɔŋ amashir ŋgɔŋ.<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />&lt;&lt;Zhin zhɔk atu amin gɔnmimi ne iki yi duŋ aneshir ana zumimin! Ikiki yiŋɛ nak nyɛ, waŋ ndi ate duŋǝ nyɛ bɛ zhin azhɔk tu ma! <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Ate yi ndi ŋɔk mi kɔ za mi tei duŋu zhaku, sɛr kɛ kyaŋ tyak zhɔk. Ire te ubǝ yik ivli kǝ yaŋ klɛtu ne mkpɔk ŋɔk kɔ mkpɔk za, inaŋ yi ne aŋɔk ayaa bǝn aza ayaa te yir ilu kǝ yaŋ klɛtu. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Teyi ndi iyi mi tei duŋu zhaku, tun kɛ tyak zhɔk. Itei rɛ ubǝ yik ivli kǝ yaŋ klɛtu ne yi zhin te bǝ yi ne ayi ayaa te abɛ tyak gu azhɔk ne lu.<verse eid="MAT 18:9" /></para>
  <para style="s">Nkanlɛ ne tu kɛ Wanta ne dɔ</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />&lt;&lt;Kǝr zhin bǝ yaŋ tɔ izhiin ne miŋ kɛ amɔtsɔtsɔb abaŋa shak yi ba. Mbla zhin te di abɛ shar ayou Arik ne gbarshu ne tu amen anak ayik ti kɛ Tetɛɛ amuŋ ne gbarshu. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />Izu neshir ne nyɛ tashur te wɔb abaŋ ndi ne dɔ.<verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />&lt;&lt;Izhin ne yik kikin? Neshir ate yine awanta sɔk wur fe izhin ne miŋ mǝne ate dɔ ahwaŋ, batai duŋ sɔk teres ane teres ne atugbu te akɔmɔ gar wɔb izhin waŋ ndi ne dɔ kai? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Ate awɔbu avuŋ, mbla zhin izub atei nyɛr ndi wa ne yik wanta zhin waŋa anaŋ sɔk teres ane teres abaŋ ndi bane dɔ ba. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Anenen amɛ Tetɛɛ amɔr ne gbarshu ba ne ta anyɛ me inuŋ ne miŋ kɛ amɔtsɔtsɔb abaŋa abɛ yir lu ba.<verse eid="MAT 18:14" /></para>
  <para style="s">Izu min waŋ ndi ne nau lɛ mimin</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />&lt;&lt;Te yi ndi zumin kɔ va min ne lau lɛ, kɔ te yigu te blau lalɛ ma, zhineba ne akpa min. Ate wɔu, une kam zumin nyak ankɔŋɔ. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Te yi ndi te kyak wɔu, gli ner zhin kɔ aner ayaa te gar bene bɔu te duŋ, &lt;kɔte lɛ takɛ ndi ru rɛ anu aner ayaa kɔ atar iyi kɛ gli mgbamgbaŋ.&gt; <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Ate kyak wɔ ba ma, bla abǝ zǝ Arik; ate kyak wɔ abɛ zǝ Arik ge, baŋ zhine wu ndi ner ne yaŋ zhi Arik ba kɔ ner ne ta gendu.<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />&lt;&lt;Mbla zhin izub, iki yiŋ ndi izhin ne tanyɛmɛ ne yi ne gɔnmimi Arik ne tanyɛmɛ ne yi ni gbarshu, Iki yiŋ ndi izhin ne kyagǝ ne gɔŋmimi Arik atei kyagǝ ni shu.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />&lt;&lt;M tei na mbla zhin izub, te yi ndi aner ayaa ne miŋ mine ne akpa kinuŋ aŋyak ne gɔnmimi ndi ne bene, Tetɛɛ amuŋ ne gbarshu atei naa ba neyi. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />kɔte mkpaŋ takɛ te yi ndi aneshir ayaa kɔ atar ne bin atu ne sak muŋ, me yi bene abɛba.&gt;&gt;<verse eid="MAT 18:20" /></para>
  <para style="s">Nkan lɛ yi gen ne yaŋ lɔ susun</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Ankyak Biturus ne nyɛ bǝn Yesɔ te rib bu tedi, &lt;&lt;Ŋgɔŋ, amkpaŋ aben izumɔr atei lam lɛ te M tei zugu zhɔk? Ayi Amkpaŋ taŋgba yi?&gt;&gt;<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Yesɔ ata anyɛ me te di, &lt;&lt;Mblau, ba amkpaŋ ataŋgba ba, ayi amkpaŋ sɔk taŋgba amkpaŋa taŋgba.<verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />&lt;&lt;Amɛ, ikɔb kǝ gbarshu iyi ndi itum waŋ ndi atei bla adudunki amaa ben agen amaa. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Ndi ne ayir blama, ne gliu neshir waŋ ndi agliu hria kɛ azɔb azhin awur <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Ndi ki ya hria ma ne yaŋu ma, atukɔ amaa adi wa ben wa maa ben amumun amaa ben kiki maa bɔbɔk abɛ vu ba alɛb te ya hria ma.<verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />&lt;&lt;Ankyak igen a tar agbarum ne aza maa te di. &lt;Lɔ susun muŋ,&gt; Mbenu, &lt;M tei yau bɔbɔk.&gt; <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Atukɔ ayou igene akɔ lɔ susun ma, te duŋu hria maa te zugu zhɔk te duŋu kɔmɔ.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />&lt;&lt;Ankyak ndi igene ne aru abɛm, ayik igen nuŋ ndi ayi ikpa ma ndi agliu hria azɔb sɔk wur. Aklau avuŋ te afǝru ne mli. Te diu yam hria muŋ.<verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />&lt;&lt;Kpa maa igene atar agbarum ne ti maa te benu te di, lɔ susun muŋ, M tei yaau hria mi.&gt;<verse eid="MAT 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30" />&lt;&lt;Ne kyak. Te kɔmɔ te aduŋ avuŋ kpa ma ate ku ne jaru, se ndi ne yau hria ma. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Ndi anki agene ne yik ki yiŋ ndi gen waŋa ne nai ne te mfu te kɔmɔ te bla atukɔ amene iki yiŋ ndi ne na.<verse eid="MAT 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32" />&lt;&lt;Ankyak atukɔ ama azhɔ igene agli ayire, &lt;Igen ne susun mimin,&gt; Adiu, &lt;Mne nduŋu hria mi bɔbɔk te zugu zhɔk ndi une ben me. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Bane rɛ ndi ubǝ lɔ susun kɛ kpa ami igen waŋa ndi nga ma mne lɔ susun mi ka? <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Atukɔ mɔ ne te mfu te adi aneshir abɛ tsǝgu ngɔŋ, se ne yam hria muŋ bɔbɔk. <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" />Akyak Yesɔ adiba&lt;&lt;Waŋa ayi iyiŋ ndi Tetɛɛ amuŋ ne gbarshu atei na kɔte ŋɔwa se une zuk zumin zhɔk ne susun mi.&gt;&gt;<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Kyak wa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Ndi Yesɔ ne bla kiki yiŋɛ klɛ. Ne duŋ Galili te yir ŋa kɛ Yahudiya, igar goŋ nek kɛ Urdu. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Ntsan aneshir ne zeu. Ne duŋ aner abɛ lɔ rɛ amuɔ.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Ferisawa anuŋ anyɛ bene bou te bɛ tenu. Ne rib bu, &lt;&lt;Irɛ te lulum abɛ kyak iwa ma ne lalɛ nuŋǝ?<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />&lt;&lt;Ba zhin ne bla tsara kai,&gt;&gt; asaga, &lt;&lt;te ne kuti Arik ne na lulum ben wa, <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />te di, &lt;Nǝ yemɛ lulum atei duŋ Tetɛɛ maa bǝn yaa maa te alas asɔŋ iwa ma, fe aba yaa ma ayi ikpa zhiin.&gt; <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Fe ba na yi ayaa ba, ayi ikpa zhiin. Fena kiyiŋ ndi Arik ne biŋi kǝr ner nuŋ abɛ klugǝ ba.<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />&lt;&lt;Tǝ aye ni,&gt;&gt; a rib bu, &lt;&lt;Ka Musa ne nek lɛ tedi lulum abɛ nek wa maa mplɛ cɛr kɛ kyagu te duŋu aru i?&gt;&gt;<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Yesɔ asaga, &lt;&lt;Musa ne tanyɛme zhin te izhin bǝ kyak amba min te asusun amin aklik. Ama bane yeme ne kuti ba. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Mbla zhin te iwaŋ ndi ate kyak wa maa, se ate yi ndi ne lalɛ kǝ wɔb alulum ba, tǝ ta wanuŋ, ne lalɛ mimin kɛ ze amba.&gt;&gt;<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Abɛ tsene maa adiu, &lt;&lt;Te yi ndi kime ye me ne tu kɛ lulum ben wa, ire ndi neshir abɛ sɔŋ yaŋ ta wa.<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Yesɔ asaga, &lt;&lt;Ba kɔte ŋɔwa atei tanyɛme ne nkanlɛ yiŋɛ ba, se abaŋ ndi ne nek ba neyi. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Fe anuŋ ayi abɛ klu te ne ŋli ba amɛ; anuŋ ne naa ba amɛ; anuŋ ne kyak ŋa ne lɛ kǝ ikɔb kǝ gbarshu. Iwaŋ ndi te ta yiŋɛ ne tei.&gt;&gt;<verse eid="MAT 19:12" /></para>
  <para style="s">Yesɔ ben amumun amɔ tsɔtsɔb</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Fe ne gli Yesɔ amumun amɔ tsɔtsɔb te abɛ sak ba ŋɔk te ben ba Arik. Ankyak abɛ tsene maa atsaŋ abaŋ ndi ne gli ba anyɛ me.<verse eid="MAT 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14" />Fe Yesɔ adi, &lt;&lt;Duŋ zhin amumun amɔ tsɔtsɔb abɛ nyɛ bene bem, kǝr zhin bɛ yar ba ba, te ikɔb kǝ gbarshu iyi mǝne.&gt;&gt; <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Ndi ne sak ba aŋɔk, ne kama tibɛ ne amkpama.<verse eid="MAT 19:15" /></para>
  <para style="s">Vǝnenzak ne yi nɛ dudunki</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Fe venenzak ne nyɛ bǝn Yesɔ te rib, &lt;&lt;Ine Tsar, ayi ki didik tayi mtai na tem ta ivli kǝ yaŋ klɛtu?&gt;&gt;<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />&lt;&lt;Anii duŋ zhin rib me ne atu ayi iki didik?&gt;&gt; Yesɔ asaga. Ner zhin wa ankyak ayi didik. Utǝ wɔb yik ivli kǝ yaŋ klɛtu, na zhin kiyiŋ ndi ilɛ kǝ Arik ne di abe nai.&gt;&gt;<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />&lt;&lt;Ayi tayi?&gt;&gt; Neshire arib.</para>
  <para style="p" vid="MAT 19:18">Yesɔ adiu, &lt;&lt;&lt;Bau tei ŋun neshir ba, bau ze amba kɔ alulum ba, bau zhib ba, bau timu ba, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />nek tetɛɛ mi bǝn yaa mi,&gt; te &lt;nyer kpami ndi tu mi.&gt;&gt;&gt;<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />&lt;&lt;Iki yiŋɛ bɔbɔk mne nai,&gt;&gt; Vǝvǝn anzak nga adi. &lt;&lt;Anii ndi bam ne nai kai?&gt;&gt;<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Yesɔ a diu, &lt;&lt;Te yi ndi une shaga, kɔmɔ, te vu adudunki ami lɛb te gab abɛ yik iyah, fe utei yik ki tetɛk ne gbarshu. Tǝ ka kam nyɛ, te zǝm.&gt;&gt; <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />Ndi venenzaga ne wɔ mee, a kama tibɛ te mfu, te wa ayi ne adudun ki.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Ankyak Yesɔ adi abɛ tsene maa, &lt;&lt;Mbla zhin izub, ilɔ te neshir ine yi ne adudun ki abɛ yir ikɔb kǝ gbarshu. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Mna bla zhin, itei yi ne sik te lakurmi abɛ yir mblu zɔb kɛ su aruru naŋ neshir ne yi ne adudun ki abɛ yir kɔb Arik.&gt;&gt;<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Ndi abɛ tsene maa ne wɔ me, ne vuŋ anu ngɔŋ te rib, &lt;&lt;Tǝ ayi ŋɔwa atai yik ita zhɔk?&gt;&gt;<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Yesɔ atɔ ba te di, &lt;&lt;Bǝn neshir bai te ba, ama ben Arik iki bɔbɔk tei yi anenen.&gt;&gt;<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Biturus asagu ma, &lt;&lt;ta ne duŋ kɔte nii te zeu! Te nii itei yi mɔr?&gt;&gt;<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Yesɔ a di ba, &lt;&lt;Mbla zhin izub, ne gli gɔnmimi yayas rumɔ, ndi Izu Neshir ate sɔŋ ne mben maa, izhineba ndi ne zǝm izhin tei na sɔŋ ne mben wur ane yaa, te gli aŋa wur ane yaa ne Isrela. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Fe kɔte ŋɔwa ndi ne duŋ kɔb maa kai amunzu, kai amunva kai Tetɛɛ maa, kai yaa maa bǝn wa maa kai amumun amaa kai ahwaŋ amaa ne sak muŋ atai ta kiki amkpaŋ sɔkwur tena yik ivli kǝ yaŋ klɛtu. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Ankyak abaŋ ndi aye abɛ kuti atei zǝ goŋ, fe abaŋ ndi aye abɛ goŋ atei yi abɛ kuti.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Nkan lɛ yi abɛ na ndum ne ahwaŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />&lt;&lt;Ikɔb kǝ gbarshu iyi ndi ner waŋ ndi ayi ne ahwaŋ ndi ne ru amblimblɛ bib te avu aneshir abɛ na ndum ne ahwaŋ amaa. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Ne ta nyɛmɛ te wa atei ya ba azɔb ayi na ndum kɛ bɛr zhin te shur ba ne ahwaŋa amaa.<verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />Ne Kǝrfe tres kɛ amblimblɛ ne ru te na yik anuŋ aklikla ne dub isha. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Adi ba, izhineba minyi kɔte nam azhin ndum ne ahwaŋa amuŋ, M tei ya zhin kiyiŋ ndi yi anenen. <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Akɔ gar.</para>
  <para style="p" vid="MAT 20:5">&lt;&lt;Ana ru ne atsutsu arik baŋ Kǝrfe tar kɛ aririk te na vu anuŋ. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Ndi Kǝrfe tuŋ kɛ amgbalu ne te ne na ru te yik anuŋ aklɛkli isha. Arib ba, &lt;&lt;Izhin klikli sha rɛ amblimblɛ te aye anii?&gt;&gt;<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />Adiu, &lt;&lt;&lt;Ba nuŋ ne zhɔ ta ndum ba.&gt;</para>
  <para style="p" vid="MAT 20:7">&lt;&lt;Adi ba, &lt;izhineba minyi kɔte nam azhin ndum ne ahwaŋa muŋ.&gt;<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />&lt;&lt;Ndi amgbalu ne te akiki ne ahwaŋa, adi atukɔ ane abɛ na ndumo, &lt;Zhɔ abɛ na ndumo te ya ba azɔb aye na ndum men, vuŋ rɛ abɛ klɛ atu kɔmɔ bǝn abɛ ku ti.&gt;&gt;<verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />&lt;&lt;Abɛ na ndum abaŋ ndi ne vuŋ ndum arɛ Kǝrfe tuŋ kɛ amgbalu anyɛ te ta azɔb amen ayi na ndum kɛ bɛr zhin. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Ankyak abaŋ ndi ne vuŋ ndum arɛ amblimblɛ bib, ayik tedi atei ya ba anaŋ abɛbaŋ ndi ne anyɛ gɔgɔŋ. Fe bɔbɔk mǝne ne ta azɔb ayi na ndum bɛr zhin. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Ndi ne taima, akɔ lɛ muemue ne tu ayi ner ne ahwaŋ <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />Adi, &lt;&lt;Aner abaŋa ndi ne baŋ ba gɔgɔŋ ne na ndum mkpaŋ zhin,&gt; une ya ba anenen ben abɛta ndi ta ne na ndum rɛ amblimblɛ te arik ne wu ta.&gt;<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />&lt;&lt;Ankyak adi zhin ne miŋ mǝne, ikpamuŋ, bam ne na zhin ki mimin ba. Ndika izhin ne tanyɛme te di zhin tei na ndumo azɔb ayi ndum kɛ bɛr zhin o? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Ta zhin iki yiŋ ndi yi min te kɔmɔ zhin. Nga M tei ya ner ndi ne nyɛ gɔgɔŋ anenen ndi Mne nek zhin. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Bam yine mgbyamgbyaŋ kɛ na ki yiŋ ndi susun muŋ ne tanyɛmɛ ne azɔb amuŋ kai? kɔ kau te ankiŋki ndi mbu ŋɔk iyi?&gt;<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />&lt;&lt;Abɛ gɔgɔŋ atei ku ti, abɛ ku ti atei ku goŋ.&gt;&gt;<verse eid="MAT 20:16" /></para>
  <para style="s">Yesɔ nena bla ku maa</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Ndi Yesɔ ne sɔŋ akɔmɔ ne Urshelima, ne zhɔ abɛ tsene maa awur ane aya aru kɔnsa te di ba, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />Ta kɔmɔ ne Urshelima, atei vuŋ Izu Neshir anǝk ngɔŋ ne abɛ na ndum kǝ Arik bǝn abɛ tsar atɔra. atei ŋunu. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />fena atei na baŋu anǝk abaŋ ndi ba yi ŋli kɛ Yahudawa ba te abɛ azhabu te tsǝgu tena kpaŋu ne tu kuŋkun kǝ gen. Nǝ bar yi ntar atei lu tsitsir!&gt;&gt;<verse eid="MAT 20:19" /></para>
  <para style="s">Iben yi Iyah</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Fe iyah men ane amun Zebɛdi a nyɛ ben Yesɔ iwa ben amumun amaa, te tar agbarum, te benu ki didik.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Yesɔ aribu tedi, &lt;&lt;uwɔb anii?&gt;&gt;</para>
  <para style="p" vid="MAT 20:21">Iya maa adi, &lt;&lt;Tanyɛmma te duŋ amun amuŋ ayaa baŋa abɛ sɔŋ ne ŋɔk li mi te ne yaa maa abɛ yi ne ŋɔk mla mi ne ikɔb kǝ gbarshu.<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />&lt;&lt;Ba zhin ne zhi ki yiŋ ndi izhin ribǝ ba,&gt;&gt; Yesɔ adi ba, &lt;&lt;Izhin tei di so ne antse akǝŋ ndi M tei so mɔ yi? Ata anyɛ me, &lt;&lt;Ta tei yaa ma.&gt;&gt;<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Yesɔ adi ba &lt;&lt;Izhin tei ya so ne antse amuŋ, isɔŋ ne ŋɔk li kɔ ŋɔk mla ba yi nga wa M tei nek zhin ba. Mkpǝmkpa yiŋɛ iyi abaŋ ndi Tetɛɛ amuŋ ne nai aŋyak ba.<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Indi abɛ zeu tsǝn amɛ awur ne wɔ amɛ, ne te mfu ben amunwa amɛ aya baŋa. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Yesɔ ne zhɔ ba bɔbɔk mǝne amkpa azhin te di, Izhin ne zhi tedi abɛ gli gɔnmimi abaŋ ndi ba yi ŋli kɛ Yahudawa ba a tsar ba mgbyamgbyaŋ, angɔŋgɔŋ amene ana tsar ba mgbyamgbyaŋ. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Ba yi amɛ bǝn abɛ zhin ba. Ne mee, waŋ ndi awɔb ngɔŋ ne miŋ min abɛ kam ate igɛn amin, <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />waŋ ndi awɔb kuti abɛ akama te igene min <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />Ba Izu Neshir ne nyɛ te abɛ zekuru ba, ne nyɛ te bɛ zekur aneshir te na nek ivli Maa te abɛ ta aneshir tetɛk ashur.<verse eid="MAT 20:28" /></para>
  <para style="s">Nǝ bu abɛ amfik aya ayi</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Ndi Yesɔ ben abɛ zeu tsǝn aduŋ Jerikɔ, ntsan aneshir a zǝu. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Aneshir abɛ amfik ayi amɛ aya akɔsɔŋ ne kɔn ankɔŋ, ndi ne wɔ Yesɔ gar agayir,akɔ ŋar akɔr te di &lt;&lt;Ŋgɔŋ, Izu Doda, lɔ susun mɔr.<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Ntsan aneshir atsaŋ ba te di abɛ aku anu, akyak te aŋar akɔr mgbɔmgbɔŋ, Ŋgɔŋ, Izu Doda, lɔ susun mɔr!&gt;&gt;<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Yesɔ akɔ gbur aklɛ te zhɔ ba. Tǝ arib ba. &lt;&lt;Izhin wɔb te mbǝ na zhin anii?&gt;&gt;<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />Adi, &lt;&lt;Ŋgɔŋ, ta wɔb ubǝ buu ta ayi.&gt;&gt; <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />Yesɔ ne lɔ susun amene te asak ŋɔk ne ayi amene. Nǝ amkpamkpama ayi amene akɔ buu te akɔ azeu.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Yesɔ ne gar Urshelima</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Ndi ne te gbahir ne Urshelima te nyɛ Betafaji ne gbu yi Zetun, Yesɔ ne shar aner ayaa ni min abɛ tsene maa, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />te di ba, &lt;&lt;kɔmɔ zhin ne ntun yiŋ ndi iyi ne ti min, izhin tei yik ne kpa tatur amɔ, bǝn vǝn maa. Zuk ba gli nyɛmɛ. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Iner nuŋ te di zhin kinuŋ, zhin bɛ diu Ŋgɔŋ awɔb ba, atei gli ba aŋyaga azizaŋa.&gt;&gt;<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Kiyiŋɛ nena amɛ te lɛ kɛ ine bla shar yi Arik bɛ shaga:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />&lt;&lt;Bla itun yi Sihiyona,</para>
  <para style="q2" vid="MAT 21:5">&lt;Tɔ, itum amin anyɛ bǝn abɔu,</para>
  <para style="q1" vid="MAT 21:5">Ne zi itu azhɔk te asa tatur,</para>
  <para style="q2" vid="MAT 21:5">Akɔ sɔŋ ne tu tatur.&gt;&gt;&gt;<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Abɛ tsene maa ne gar ate na ndi Yesɔ ne diba <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Ne gli tatur ben vǝvǝn taturo, te lab nklunklu men ne agɔŋ taturo, Yesɔ ayuŋɔ sɔŋ ne goŋɔ. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Ntsan aneshir ngɔŋ ne lab nklunklu men ashur ne ankɔŋ, anuŋ ne mlik anga ilik ashur ne ankɔŋ. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Ntsan aneshir aku ti maa bǝn abaŋ ndi a zen gbaru asak tedi,</para>
  <para style="q1" vid="MAT 21:9">&lt;&lt;Hosana bǝn Zu Doda!&gt;&gt;</para>
  <para style="q1" vid="MAT 21:9">&lt;&lt;Anu adidik ai kɛ waŋ ndi ne nyɛ ne sak kɛ Ŋgɔŋ!&gt;&gt;</para>
  <para style="q1" vid="MAT 21:9">&lt;&lt;Hosana ben Arik!&gt;&gt;<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Ndi Yesɔ ne yir Urshelima, ntuno bɔbɔk ne zhaŋ te rib, &lt;&lt;Ayi ŋɔwa?&gt;&gt;<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Ntsan aneshir adi, &lt;&lt;Waŋa ayi Yesɔ, ine bla shar yi Arik arɛ Nazara ne Galili.&gt;&gt;<verse eid="MAT 21:11" /></para>
  <para style="s">Yesɔ ne akabaŋkɔŋ</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Yesɔ ne yir Akabakɔŋ te yar abɛ lɛb kiki agli rumɔ. Ne kam tebur kɛ abɛ sen azɔb aku ne mimi ben mben yi abɛ lɛb angu abɛ kɔb tyak zhɔk. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />&lt;&lt;Ne cɛr yi Musa,&gt;&gt; a diba, &lt;&lt;&lt;Akabakɔŋ muŋ atei zhɔ kɛ te kɔb kɛ ben Arik,&gt; Fe izhin baŋ kɛ &lt;te bǝ ye ikɔb kɛ abɛ zhib.&gt;&gt;&gt;<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Abɛ amfik bǝn abɛ ku aza anyɛ bǝn abɔu ne akabakɔŋ, ne duŋ ba arɛ. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Fe ndi ngɔŋ ne abɛ na ndum kǝ Arik bǝn abɛ tsar nkanlɛ ne yik kiyiŋ ndi Yesɔ ne nai ndi amumun ne gbaru asak ne gar kɛ akabakɔŋ. &lt;&lt;Hosana ayou Izu Doda,&gt;&gt; Ankyak ate mfu.<verse eid="MAT 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16" />Aribu. &lt;&lt;Uwɔ kiyiŋ ndi amumun abaŋ adi?&gt;&gt;</para>
  <para style="p" vid="MAT 21:16">&lt;&lt;Mm,&gt;&gt; Yesɔ mtanyeme, &lt;&lt;ba zhin ne zen bla,</para>
  <para style="q1" vid="MAT 21:16">&lt;&lt;&lt;Ibaŋ rɛ anu amumun ben asen amumun</para>
  <para style="q2" vid="MAT 21:16">Ne duŋ ba agbar asak ka?&gt;&gt;<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Ankyak a ru ne miŋ ntuno te kɔmɔ ne Batanya, amɔ ne kur o.<verse eid="MAT 21:17" /></para>
  <para style="s">Itiŋ Ayeb ne ku</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Amblimblɛ bib ndi Yesɔ ne vuŋ ankɔŋ te sɔŋ akama kɔmɔ ne miŋ ntun, ikasa ne vuŋu. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Ne yik itiŋ bwab ne tu ankɔŋ, te gar tiŋe fe bane yik kɛ ne dɔ ba anak ayi amgbavu ankyak. Fe ne nek kɛ anu amimin te di, &lt;&lt;Kǝr bǝ na dɔ mgbyaŋ ba gar klɛtu!&gt;&gt; Ne amkpama tiŋ bwaba iku te klu.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Ndi abɛ tsene maa ne yik amɛ, ne vuŋ anu amen. &lt;&lt;Itiŋ bwab nena kikin te ku andanda me?&gt;&gt; Arib.<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Yesɔ adi, &lt;&lt;Mbla zhin izub, izhin te tanyɛmɛ ne susun amin te ba zhin ne lene ba, zhin tei na kiyiŋ ndi ne naŋ itiŋ bwab, fena izhin te di Igbu yiŋɛ, &lt;Tsǝn, tun tu mi zhɔk ne nek ngɔŋ,&gt; fe itei na yeme. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Izhin te tanyɛmɛ, izhin tei ta kɔte nii ndi izhin te rib ne ben.&gt;&gt;<verse eid="MAT 21:22" /></para>
  <para style="s">Nǝ rib mgbyamgbyaŋ kɛ Yesɔ</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Ndi Yesɔ ne yir ŋa kɛ Akabakɔŋ, fe, ndi azǝn tsar, ngɔŋ ne abɛ na ndum kǝ Arik bǝn angɔŋgɔŋ aneshir ne nyɛ bene bɔu. &lt;&lt;Ayi mgbyamgbyaŋ takǝ u na kiki yiŋɛ?&gt;&gt; Arib. &lt;&lt;Fena ayi ŋɔwa ne nǝgu mgbyamgbyaŋ kǝŋe?&gt;&gt;<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Yesɔ adi, &lt;&lt;Mtei na rib zhin lɛ zhin. Izhin te blam, mte blaa zhin ka yi mgbyamgbyaŋ kɛ ŋɔwa me na kiki yiŋɛ. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Isu aneshir Yɔɔna ire me? Ire gbarshu ka rɛ bǝn neshir ni?&gt;&gt;</para>
  <para style="p" vid="MAT 21:25">Alɛ ne akpa mɛn tedi, &lt;&lt;Ta te di, &lt;Ire gbarshu,&gt; ate rib, &lt;Tǝ anii iyar zhin tanyɛmɛ bǝn abɔu?&gt; <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Fe ta te di, &lt;Ire bǝn aneshir&gt; Ta te sisik aneshir, ne tanyɛmɛ bɔbɔk tedi Yɔɔna ayi ine bla shar yi Arik.&gt;&gt;<verse eid="MAT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27" />Ankyak akɔ di Yesɔ, &lt;&lt;Bata ne zhi ba.&gt;&gt;</para>
  <para style="p" vid="MAT 21:27">Fe a di, &lt;&lt;Nga muŋ yi bam tei blaa zhin ka mgbyamgbyaŋ kɛ ŋɔwa me na kiki yiŋɛ.<verse eid="MAT 21:27" /></para>
  <para style="s">Nkan lɛ yi amumun ayaa</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />Izhin ne yik kikin? Ner nuŋ ayi ne amumun ayaa. Ne gar bǝn ne kuti me te di, &lt;Izu muŋ, kɔmɔ te na ndum aliŋe ne ahwaŋ.&gt;<verse eid="MAT 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29" />&lt;&lt;&lt;Bam gar ba,&gt; asagu ma, fe ne sen susun maa te gar.<verse eid="MAT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30" />&lt;&lt;Ankyak Tetɛɛ me ne gar bǝn zu maa ne yaa ma te diu ki zhiin yiŋɛ. M tanyɛmɛ, &lt;&lt;M tei gar, ŋgɔŋ,&gt;&gt; ba ne alɔ gar ba.<verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />&lt;&lt;Ne min kɛ amumun ayaa abaŋ itawa ne na kiyiŋ ndi tetɛɛ mǝnɛ ne tanyɛmɛ?&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">Adi. &lt;&lt;Nǝ kuti,&gt;&gt; Yesɔ a diba, &lt;&lt;Mbla zhin izub, abɛ ta gendu bǝn abɛ zǝ alulum nten atei kuti a yir kɔb Arik te duŋ zhin. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Yɔɔna ne nyɛ te bɛ tsar zhin ankɔŋ ne na iki didik izhin bane tanyɛmɛ bǝn abɔu ba, amɛ abɛ ta gendu bǝn abɛ zǝ alulum anamɛ. Ne me ndi izhin ne yik amɛ, izhin ne kyak duŋ ki mimin min te tanyɛmɛ bǝn abɔu.<verse eid="MAT 21:32" /></para>
  <para style="s">Nkan lɛ kɛ abɛ tɔ ahwaŋ ner nuŋ</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />&lt;&lt;Na wɔ zhin nkanlɛ nuŋ: Ner nuŋ ayi ne ahwaŋ ndi ne shi atiŋ kuŋkun. Ne kam ahwaŋa azik, te ka dudu kɛ bɛr shur ama dɔ nkunkun. Te na me iki kɛ blɛ. Ne baŋ ahwaŋa anǝk anuŋ abɛ na ndum te kɔmɔ ne tsǝn. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Ndi mkpaŋ kɛ dɔ nkunkun ne te, ne shar agen amaa ben abɛ na ndum ne ahwaŋa abɛ te kye dɔ nkunkun a Gli iwa ma.<verse eid="MAT 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35" />&lt;&lt;Abɛ na ndum nǝ ahwaŋ nǝ vuŋ agene; agli te tsugu, te ŋunu, te tyak ne ntara nǝ mkpaŋ. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Ne na shar agene anuŋ bene ba, ndi anaŋ abɛ kuti me, fe ne nab ba kiyiŋ ndi ne na abɛ kuti. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Nǝ klɛtu bɔbɔk, ne shar izu maa bene ba. &lt;Atai nek izu muŋ ŋgɔŋ,&gt; adi.<verse eid="MAT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38" />Fe ndi abɛ na ndum ne ahwaŋ ne yik izu maa, adi akpa mɛn, &lt;Waŋa ayi zu maa. Nyɛ, te tabǝ ŋunu tǝ ta gadu maa.&gt; <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Fe a baŋu atyak azhɔk ne goŋ abɛmkǝ ahwaŋa te tsǝgu ŋun.<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />&lt;&lt;Ankyak, akiki ne ahwaŋa atei nyɛ, atei na agɛnɛ kikin?&gt;&gt;<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />&lt;&lt;Atei tsǝk aner mimin abaŋa aŋlɔk,&gt;&gt; ne di, &lt;&lt;atei baŋ a ahwaŋ akɔb anuŋ abɛ na ndumo, abaŋ ndi atei nǝgu iki yiŋ ndi iyi maa ne dɔ agbarki nǝ kpaŋ kɛ sɛr ki.&gt;&gt;<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Yesɔ a di ba, &lt;&lt;ba zhin ne zin tɔ ilɛ kǝ Arik ka:</para>
  <para style="p" vid="MAT 21:42">&lt;&lt;&lt;Mkpaŋ yiŋ ndi abɛ me ne kyagǝ ai yi tei klɛ ne nju ki; Ŋgɔŋ wa ne na mee, fe a ki yi lɛ ne susun ne ayi amɔr&gt;?<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />&lt;&lt;Amɛ mblazhin te ndi ate baŋ kɔb Arik ayar zhin te nek aneshir abaŋ ndi ana ki didik. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Waŋ ndi ate zhaku ne mkpaŋ yiŋɛ atei tsik aŋar anzenzaŋ, waŋ ndi mkpaŋa ite zhaku ne tu maa itei mlau te mbumbur.&gt;&gt;<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Ndi ngɔŋ ne abɛ na ndum kǝ Arik bene bɛ Ferisawa ne wɔ aneshir nkan lelɛ iyi Yesɔ&gt; te zhi te alɛ ne atu amen. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Ne wɔb ankɔŋ ane vuŋu, ne te sisik ntsan aneshir adi ayi ine bla shar yi Arik.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Nkan lɛ yi gyaŋ yi kpa ŋaa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Yesɔ ne na lɛ ben abɛ zeu ne nkan lelɛ te di: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />&lt;&lt;Ikɔb kǝ gbarshu yi ndi Itum waŋ ndi ne naa zu maa igyaŋ yi kpa ŋa. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Ne shar agene maa abɛ te abla abaŋ ndi wa ne zhɔ ba gyaŋa te abɛ nyɛ, fe ne kyak nyɛmɛ.<verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />&lt;&lt;Ne na shar agene anuŋ te di, bla zhin abaŋ ndi ne bla ba gyaŋa te di mne nka sur kili me ŋklɛ: mne nka yak narum ngɔŋgɔŋ, ben alandɔŋ, neka na kiki bɔbɔk aŋyak, nyɛ zhin igyaŋa fe.&gt;<verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />&lt;&lt;Fena abaŋ ndi ne bla ba igyaŋa ne kyak nyɛmɛ, nuŋ ne kɔmɔ ne ahwaŋ amaa, nuŋɔ ne gar wɔb azɔb amaa. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Nki aneshir ne vuŋ agene, te tsik ba te aŋlɔk ba. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Itumɔ ne baŋ afuk. Nǝ shar abɛ kpaakpa maa abɛ gar ate tsik abɛ ŋlɔk aneshir abaŋa ŋun te goŋ ntun mǝne.<verse eid="MAT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8" />&lt;&lt;Itu mɔ adi agene amaa, &lt;Ne ka na kiki yi gyaŋa bɔbɔk, abaŋ ndi ne bla ba gyaŋa ne kyak nyɛmɛ. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Tsǝn gar zhin nkuŋkɔŋ ne miŋ ntun te zhɔ zhin kɔ te ner tawa ndi zhin te yigu.&gt; <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Ankyak agene ne kɔmɔ ne miŋ ntun ate bla aneshir abaŋ ndi aba ne yik ba adidik bǝn amimin, fe aneshir ne shak kɔb kɛ gyaŋa.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />&lt;&lt;Ndi Itumɔ ne nyɛ amkpa ne gyaŋa te wa abɛ nyɛ yik acɛ nɛ, ne yik neshir nuŋ ndi bane su anklu ba. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />&lt;Ikpa muŋ,&gt; arib, &lt;une na kikin te yir amkpa ne gyaŋ yaŋ su anklu yi gyaŋai?&gt; Inere alɛ lak kana.<verse eid="MAT 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13" />Fe Itumɔ abla agene, &lt;kpa zhin newu ne ŋɔk bǝn aza te baŋ zhine wu tyak zhɔk ne abɛm, ne amkpa ne amatib bu, ndi azhin te ŋu aŋin.&gt;<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />&lt;&lt;Ne zhɔ aneshir tetɛk, te hria watsɔb.&gt;&gt;<verse eid="MAT 22:14" /></para>
  <para style="s">Iyah Kaisar gendu</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Ankyak Ferisawa a kɔmɔ ne abɛm te kpa anu ndi aba tei vuŋu ne lǝlɛ maa. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Ne shar abɛ ze ba tsen bǝn abɔu bǝn aner abɛ Hirudiya abɛ gar bǝn Yesɔ te di, &lt;&lt;Ine Tsar&gt;&gt; adi,&lt;&lt; ta ne zhi uyi ner didik una bla zub, una tsar ankɔŋ ayou Arik ndi bau kam lɛ mi sen ba. Bau zǝ ki yiŋ ndi aneshir ablai ne tu mi ba, bau na zǝ lǝlɛ yi aneshir angɔngɔŋ ba. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Bla ta, uwa une yik kikin? Ne rɛ tabǝ ya kaisar gendu ma kɔ bɛ duŋ ini?&gt;&gt;<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Ankyak Yesɔ, ne zhi nnɛ mǝne adi, &lt;&lt;Izhin abɛ kamgli, anii duŋ zhin wɔb me ne zhɔk adɔmɔ? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Tsar me zhin azɔb ayi nek gendu.&gt;&gt; Akɔ gli azɔb dinaros agliu ma, <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Fe arib ba, &lt;&lt;Waŋa ayi izhu yi ŋɔwa? Bǝn cɛr yi ŋɔwa?&gt;&gt;<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />&lt;&lt;Iyi kɛ kaisar&gt;&gt;, asagu ma, &lt;&lt;Nek zhin kaisar iki yiŋ ndi yi Kaisar, te nek zhin Arik ki yiŋ ndi yi Arik.&gt;&gt;<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Ndi ne wɔ me, ne sak ŋɔk ne ne, te akam atibe.<verse eid="MAT 22:22" /></para>
  <para style="s">Iŋa ne Shu</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Nǝ bǝn ane Sadukiyawa, abaŋ ndi adi ner te ku ikamlu ba yime ba, ne nyɛ te rib bu. <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />&lt;&lt;Ine tsar,&gt;&gt; adi, &lt;&lt;Musa ne bla ta te di ineshir ate ku iyaŋ vǝvǝn, zumen abɛ baŋ iwa ma wakɔ te ŋlii zumen ne kumɔ vǝvǝn. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Amunwa ataŋgba ne ne miŋ mɔr. Nǝ kuti amene ne ta iwa ma te akam aku, yaŋ yik vǝvǝn, izumen ne baŋ iwa ma. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Ine ya ben ine ntar ma, gar kɔmɔ ben ne taŋgba amene. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Ankyak,iwama maayi, ne ku. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Azizaŋ fa, ne ikamlu yi goŋ ku, iwa waŋa ayou ŋɔwa ne miŋ kɛ aneshir ataŋgba baŋa, ndi bɔbɔk mǝne ne tau?<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Yesɔ adi ba, &lt;&lt;Yaŋ zhi ilɛ kǝ Arik min ben mgbyamgbyaŋ ma duŋ zhin lɛ cɔk.&gt;&gt; <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Fe ndi abe ku te kamlu ne vli, atei yi ndi abɛ shar ayou Arik ne gbarshu ba tei ta amba kɔ gar ŋa ba; <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Nǝ atu ayi ku te kamlu ba zhin ne tɔ ki yiŋ ndi Arik ne di zhin ka, <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />&lt;&lt;Nga myi Arik ayou Ibrai, Arik ayou Ishaku, bǝn Arik ayou Yakubu&gt;? Ba yi, Arik ane akum ba ayi Arik ane aner abɛ ku ba ama ayou atsitsir.&gt;&gt;<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Ndi ntsan aneshir ne wɔ iyiŋɛ, ne sak aŋɔk ne ne ne tsar ma.<verse eid="MAT 22:33" /></para>
  <para style="s">Nkanlɛ Ŋgɔŋ</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Ndi Ferisawa ne wɔ Yesɔ ne tsaŋ Sadukiyawa, akɔ biŋ akpa mɛn. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Izhin ne miŋ mǝne ndi aine tsar cɛr Musa, awɔb te wa abɛ vuŋ Yesɔ ne lalɛ aribu te di:<verse eid="MAT 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 22:36" />Arib te di&lt;&lt;Ne Tsar, ilɛ takɛ yi ngɔŋ ne icɛr yi Musa?&gt;&gt; <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />Yesɔ adiu; &lt;&lt;&lt;Duŋ susun mi bɔbɔk, bǝn iri mi, bǝn alambur ami abɛ nak nyer Arik ami.&gt; <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Waŋa ayi ilɛ ngɔŋ kǝ kpa nyak. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Fe ikǝ kpa nyak kǝ yaa ma nayi amɛ: &lt;&lt;Nyer kpami ndi tu mi.&gt; <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Icɛr yi Musa bǝn abɛ bla shar yi Arik ne zhaŋ asɔŋ ne ilǝlɛ ngɔngɔŋ yaa iyiŋɛ.<verse eid="MAT 22:40" /></para>
  <para style="s">Kristi ayi Izu ŋɔwa</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Ndi Ferisawa ma ne kyu abiŋ, Yesɔ ne rib ba, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />&lt;&lt;Izhin di te Almasihu ayi ŋɔɔ wa? Ayi zu ŋɔɔ wa?&gt;&gt;</para>
  <para style="p" vid="MAT 22:42">&lt;&lt;Ayi Izu Doda.&gt;&gt; Adi.<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Ablaa ba tedi, &lt;&lt;Tǝ Doda ne na kikin te lɛ ne Izhu iyi Arik, te zhɔu te &lt;Ŋgɔŋ?&gt; Ne di,<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />&lt;Ŋgɔŋ ne di Ŋgɔŋ amuŋ:</para>
  <para style="q2" vid="MAT 22:44">Zǝ sɔŋ ne ŋɔk li muŋ</para>
  <para style="q2" vid="MAT 22:44">Gar te mla ne mkpaŋ ndi M tei shur abɛ te zɔr ami</para>
  <para style="q2" vid="MAT 22:44">Nǝ mimi yi aza ami.&gt;<verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Ate yi ndi Doda ne azhɔu te &lt;Ŋgɔŋ,&gt; ayi kikin te ana zhɔu te zu Doda?&gt;&gt;<verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />Nuŋ ba ne na diu kinuŋ ba, nak vuŋ rɛ bɛr yuŋɔ, ner nuŋ ba ne na rib bu kinuŋ ba.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Gbaŋ atɔŋ me taŋgba</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Fe Yesɔ adi ntsan aneshir bǝn abɛ tsene maa: <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />&lt;&lt;Abɛ tsar atɔra bǝn Ferisawa aba be sɔŋ ne mben te nek cɛr yi Musa ma. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Neme izhin bɛ tsǝ klɛ te zǝ ba te na kiki yiŋ ndi ablaa zhin. Kǝr zhin bǝ na ki yiŋ ndi anayi ba, te ba ne tɔ mǝne ba na kiyiŋ ndi a bla ba. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Akpaa ki yi luk, ben yi lɔ baŋ te baŋǝ sak aneshire ne ampa men, ndi aba menyi bane tanyɛme te aba tei baŋǝ ne vǝn ŋɔk men ba.<verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />&lt;&lt;Kiki yiŋ ndi anai te aneshir abɛ yik ba: Ne na guru ngɔngɔŋ, te duŋ aŋɔk anklu amen abɛ lak atar ne gbarum; <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />A nyer kpǝmkpa yi nek ŋgɔŋ ne gyaŋ ben mben didik ne akaba; <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />A nyer te bɛ yik aneshir abɛ tek ba te nǝk ba ngɔŋ men te na zhɔ ba te &lt;Abɛ tsar.&gt;<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />Bane te bɛ zhɔzhin te &lt;Abɛ tsar,&gt; ba izhin yi ne Ŋgɔŋ zhin ankyak fe izhin yi amunya bɔbɔk. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Kǝr zhin bǝ zhɔ nuŋ ne gɔnmimi te: &lt;Tetɛɛ ba,&gt; te zhin yi ne Tetɛɛ zhiin, ndi ayi ne gbarshu. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />kɔka abɛ na zhɔzhin te angɔŋgɔŋ, izhin nak yi ne Almasihu ne Tsar zhin ankyak waŋ ndi ayi Kristi. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Ŋgɔŋ ne miŋ mine wa atei yi igɛn amin. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Iwaŋ ndi ate lɛk tu maa ne shu atei gliu azime, fe iwaŋ ndi ate gli tu maa azime atei lɛgu agli kɔmɔ ne shu.<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />Zhin zhɔk atu amin, abɛ tsar lɛ kɛ atɔra bǝn Ferisawa, izhin aba abɛ kamgli! Zhin ku anɔkɔŋ akɛ ikɔb kǝ gbarshu ne ti kɛ neshir. Izhineba menyi ba zhin ne yir baa, ba zhin ne duŋ anuŋ ayir ba. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />Me ja zhin atɔŋ, abɛ tsar lɛ kɛ atɔra bǝn Ferisawa, ner amimin izhin li kiki ye abaŋ ndi alulum amen ne ku, izhin baŋ mkpaŋ te ben Arik te ijin bɛ cɔk aneshir te bɛ nek zhin iyah ŋgɔŋ.<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />&lt;&lt;Zhin zhɔk atu amin, abɛ tsar lɛ kɛ atɔra ben Ferisawa, abɛ kamgli! Izhin gar amkpa lǝlɛ te glɔ nek te wɔb zhin neshir zhiin ndi izhin te yigu, fe izhin duŋu ayi zhin, amkpaŋ ayaa ndi vǝvǝn ne yir lu ndi izhineba.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />Zhin zhɔk atu amin, abɛ gli aneshir abɛ amfik ndi aye abɛ amfik! Izhin di, &lt;Inuŋ waŋ ndi ate sherim ne akabakɔŋ, bai kinuŋ ba; ama waŋ ndi ate sherim ne zineriya ikɛ iki akabakɔŋ ne yi kisha.&gt; <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Izhin abɛ amfik te yi ki sha! Itayi naŋ: zinariya, ka iyi akabakɔŋ ne yi tsetser waŋ ndi ne naŋ zineriya mai? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Izhin na di, &lt;Waŋ ndi ate sherim ne amkpa ne tsik baŋ, iyi ki sha; iwaŋ ndi te sherim ne kiyiŋ ndi yi nek ne amkpa ne tsik baŋ arim ama tei vuŋu. <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Izhin aner abɛ mfǝk! Itayi iyi ŋgɔŋ: iki yi nek, kɔ kai amkpa ne tsik baŋ awa yi tsetser ni? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Ndi amɛ, waŋ ndi ate sherim ne amkpa ne tsik baŋ ne sherim ne kɛ bǝn kiyiŋ ndi iyi ne amkpama. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Waŋ ndi te sherim ne akabakɔŋ ne sherime ne kɛ ben waŋ ndi a sɔŋ ne amkpama. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Waŋ ndi te sherim ne gbarshu ne sherim ne mben yi sɔŋ Arik bǝn waŋ ndi akɔ sɔŋɔ neyi me.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />&lt;&lt;Zhin zhɔk atu amin, abɛ tsar lɛ kɛ atɔra bǝn Ferisawa, izhin abɛ kamgli! Izhin nek ne miŋ kɛ wur yi kiki yi lɔn bǝn kuŋkun, kumin, ama izhin kyak kiyiŋ ndi iyi rɛ ngɔŋ ne lɛ kɛ atɔra rik lɛ didik, lɔ susun bǝn na didik, bǝn tanyɛmɛ. Ki yi goŋ, iyaŋ kyak iyi kukub. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Izhineba abɛ amfik! Izhin kyak mgbugbuk te mli lakurmi.<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />&lt;&lt;Zhin zhɔk atu amin, abɛ tsar lɛ kɛ atɔra bǝn Ferisawa, izhin aner abɛ kamgli! Izhin ŋla goŋ abɛm kɛ akparantse bǝn ki zhɔk te duŋ kǝ yi tsetser, te duŋ imiŋe ne rik. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Ferisawa abɛ amfik! Izhin bǝ kuti ŋla imiŋ antse bǝn agbǝgba, te shi ŋla gɔŋ abɛm tǝ bɛ yi tsetser.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />&lt;&lt;Zhin zhɔk atu amin, abɛ tsar lɛ kɛ atɔra bǝn Ferisawa, aner abɛ kamgli te na zumimin! Izhin yi ndi abɛ ndi ba yi ne kinuŋ ne miŋe ba. Ayik re maa ne bɛm ama imiŋ maa akuku akum aner abɛ ku ne shaga bǝn kiki iyi rik. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Ne mee, ne abɛm zhin yi tsetser ne mimin kiki mimin ne shaga te kamgli bǝn abɛ na zumimin.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />&lt;&lt;Zhin zhɔk atu amin, abɛ tsar lɛ kɛ atɔra bǝn Ferisawa, izhin abɛ kamgli! Izhin abɛ bla lɛ kɛ Arik te duŋ amɛ abɛ bla shar yi Arik ayi tsetser te nai iki didik. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Fe izhin di, &lt;Abɛ ndi ta ne yime ne mkpaŋ kɛ atsintsim amɔr, ba tei bǝ yi ne min kɛ tsik abɛ bla shar yi Arik ashur azhizhi te ŋlɔk.&gt; <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Fena izhin ne tanyɛmɛ te di izhin yi alɛla aye abaŋ ndi ne ŋlɔk abɛ bla shar yi Arik. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Zǝ zhine ba, fe, itsar zumimin ye atsintsime amin ne na!<verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />&lt;&lt;Izhin ane wa! Abɛ yi ne tus! Izhin tei na kikin te ayaŋ te zhin ambuk te yaŋ yir kɔb lu? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Ndi amɛ me shar zhin abɛ bla shar yi Arik bǝn mgbemgbebɛ aner ben abɛ tsar. Anuŋ izhin tei ŋun ba te na kpaŋ ba ne tu kuŋkun kǝ gen; anuŋ atei tsik ba ne asesa ne akaba te yar ba rumɔ ne ntuntun. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Ankyak izhin tei nyɛ bɔbɔk abɛ yi azhizhi tsetser abaŋ ndi ne ŋlɔk ba ne gɔnmimi, vuŋ rɛ azhizhi tsetser aye Abila nyak a you Zakariya izu Berikiya, waŋ ndi ane ŋunu ne akabakɔŋ ne tu amkpa ne tsik baŋ. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Mbla zhin izub, iki yiŋɛ bɔbɔk itei nyɛ ne tu kab kɛ azizaŋa.<verse eid="MAT 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />&lt;&lt;Urshelima, Urshelima, izhineba ndi izhin ne ŋlɔk abɛ bla shar yi Arik te na tyak abaŋ ndi ne shar ba bene bɛ zhin ne mkpaŋ, mkpaŋ nuŋ mne ntǝ tǝm biŋ zhin amumun amkpa azhiin ndi mun kukɔ, izhin ne kyak. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Te, akɔb amin ne duŋǝ ayi akɔ. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Tǝm bla zhin, ba zhin tei na yik me ba se izhin ne di, &lt;Anu adidik aye bǝn waŋ ndi ne nyɛ ne sak kɛ Ŋgɔŋ.&gt;&gt;&gt;<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">Kiki yi tsar klɛtu goŋ mimi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Yesɔ ne duŋ akabakɔŋ te sɔŋ akɔmɔ ndi abɛ tsene maa anyɛ bene bɔu te tsa ru imɛ akɔb. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />&lt;&lt;Izhin yik kiki yiŋɛ bɔbɔk?&gt;&gt; Arib. &lt;&lt;Mbla zhin izub, mkpaŋ nuŋ ayaŋa batei sɔŋ ne tu ye nuŋ ba; atei zire atyak ahrie.&gt;&gt;<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Ndi Yesɔ ne kɔ sɔŋ ne Gbu yi Zetun, abɛ tsene maa ne nyɛ bene bɔu ne kɔnsa. Te di, &lt;&lt;Bla ta,&gt;&gt; &lt;&lt;kiki yiŋɛ tei na atenta, fe anii tei yi ngir kɛ nyɛ mi ben mkpaŋ kɛ klɛtu yi gɔnmimi?&gt;&gt;<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Yesɔ adi ba: Shur zhin ayi kǝr zhin bɛ duŋ nuŋ a cɔk zhin ba. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />A ner tetɛk atei nyɛ ne sak muŋ, te di, &lt;me ye Kristi,&gt; atei cɔk aneshir tetɛk. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Izhin te wɔ lǝlɛ yi te kum ben mbumbur lǝlɛ yi te kum, amɛ kǝr zhin bɛ te sisik ba. Ikiki yiŋɛ itei na, fe iklɛ tu goŋ mimi bane zen nyɛ ba. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Ntun ngɔŋ tei wɔb tun ŋgɔŋ ne mgbu, aŋaa atei wɔb aŋaa nuŋ ne mgbu. Izhɔŋ tei te, mimi tei na zhaŋ ne mkpǝmkpa tetɛk. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Ikiki yiŋɛ bɔbɔk iyi ndi kuti yik iyah iyi ŋli. <verse eid="MAT 24:8" /><verse number="9" style="v" sid="MAT 24:9" />&lt;&lt;Amɛ aneshir atei nek zhin iya tena ŋlɔk zhin, atei na kyak zhin ne goŋ mimi bɔbɔk ne lɛ kɛ sak muŋ. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Ne mkpaŋ yuŋɔ aneshir tetɛk atei kam goŋ anǝk ita nyɛmɛ men te baŋ anuŋ alɛb te kyak akpa yi, <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Abɛ shar abɛ Arik abɛ timu atei mwaŋ aru te cɔk aneshir tetɛk. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Ndi zumimin tei ŋar shak abɛm, te duŋ nyer akpa itei sik, <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Uwaŋ ndi te tsi klɛ mgbamgbaŋ gar klɛ tu iwa atei yik ta zhɔk. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Atei nak du iLɛ didik kɛ kɔb Arik kǝŋe azǝ gɔnmimi bɔbɔk teduŋ aneshir abɛ wɔ kɛ aŋar, fe klɛ tu yi gɔnmimi ishi nyɛ.<verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />&lt;&lt;Fena izhin te yik ner mimin ndi aklɛ ne Akabakɔŋ &lt;Ane tsetser iki mimin yi la lɛ,&gt; Ndi Daniel ine bla shar yi Arik ne lɛ duŋ nnɛ tɔ abɛ vuŋ agli <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />Amɛ abaŋ ndi ayi ne Yahudiya abɛ klu akɔmɔ te yuŋ gbu. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Waŋ ndi ne tu ki kǝr abɛ di iwa atei kama te baŋ kinuŋ ne kɔb maa ba. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Kǝr nuŋ ndi te dɔ na ndum ne ahwaŋ abɛ di wa kam agar baŋ anklu ne kɔb ba. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Atei yi mkpaŋ mimin bǝn amba abɛ ŋli bǝn abɛ nek amumun yak. <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Ben zhin Arik te klu mine kǝr bǝ yi ne kus bǝn bɛr yi sɔŋ sik ba. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Amɛ atei yik iyah ne gɔnmimi tetɛk, yiŋ ndi bane zǝn yigǝ ba ivuŋ rɛ kuti gar nyak mkpaŋ kǝŋe. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Ama Arik ne ka gyak berɛ ate watsɔb ba, abe di bane na ame ba, inuŋ bai bɛ yik ta zhɔk ba. fe aye tu ayi aneshir abe yi nǝ kpa abaŋ ndi ne hria ba, neme, Arik abe gyak ibɛre te watsɔb. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />Ne mkpaŋ yuŋɔ nuŋ ate di zhin &lt;Tɔ, Kristi yuŋ!&gt; kɔ, &lt;Tɔ yuŋ amɔ!&gt; Duŋ tanyɛmɛ zhin ba. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Abɛ timu te di aba yi Kristi abɛ timu atei mun aru; atei na ikiki ngɔngɔn yi vun anu te aba abe lɔm aneshir abaŋ ndi Arik ne hria ba, ndi atei ya nama. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Tɔ, mne nak mblazhin rɛ kukub.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />&lt;&lt;Fe nuŋ ate di zhin, &lt;Tɔ yuŋ, ne zizik,&gt; kǝr zhin bǝ ru ba; kɔ, &lt;Tɔ waŋ, ne miŋ ki,&gt; kǝr zhin bǝ tanyɛmɛ ba. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Ndi laŋ lu ra nas ndi ayikɛ rɛ ti kɛ anzaŋ te yir ti amgbalu, amɛ nyɛ yi Izu Neshir tei yime. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Amkpa waŋ ndi akum ate yime, amɔ wa amkpuk go angulu abiŋe.<verse eid="MAT 24:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />&lt;&lt;Andanda ndi iya ngɔŋ yuŋɔ te gar gayir</para>
  <para style="q1" vid="MAT 24:29">&lt;&lt;&lt;Arik ba tena laŋ ba,</para>
  <para style="q2" vid="MAT 24:29">Ihwa ba tei na laŋ ba;</para>
  <para style="q1" vid="MAT 24:29">Ncinces tei hrie rɛ gbarshu,</para>
  <para style="q2" vid="MAT 24:29">Ikiki yi kɔr ne shu tei jaŋ.&gt;<verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />&lt;&lt;Fe ne mkpaŋa atei yik ngir kɛ nyɛ Izu Neshir te klɛ ne gbarshu, Aneshir atei munoru ne gbarshu, aneshir abɛ gɔnmimi bɔbɔk atei zhin ndi ate yik Izu neshir asɔŋ anyɛ ne akpa yi shu, ne mgbyamgbyaŋ mben maa. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Ankyak atei shar abɛ shar ayou Arik atei vli mpluŋ ne kɔr ŋgɔŋ, atei, duŋ abaŋ ndi ne hria ba abiŋ arɛ agara anas vuŋre kɔtɔŋ kɛ gbarshu te kɔmɔ ne kɔtɔŋ nuŋ.<verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />&lt;&lt;Amɛ duŋ zhin tiŋ nglǝnglǝ tsar zhin nkanlɛ. Izhin te yik amgbavu amaa are te zu, zhin bɛ zhi te kus ne te gbahir. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Ne me, ndi zhin te yik kiki yiŋɛ bɔbɔk, zhin te ayi gbahir, ayi ne ankɔŋ. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Mbla zhin izub, ikab kǝŋe batei gayir ba kiki yiŋɛ tei na. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Gbarshu bǝn gɔnmimi tei gar gayir, lɛ muŋ ba te gayir ba.<verse eid="MAT 24:35" /></para>
  <para style="s">Bane zhi bɛr ben mkpaŋ ba</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />&lt;&lt;Ba waŋ ndi ne zhi bɛr yuŋɔ kɔ mkpaŋa, kɔ abɛ shar ayou Arik ne gbarshu ma, kɔ Izu maa ma, ama Tetɛɛ wa kiki ma ne zhi. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Inyɛ Izu neshir, tei yi ndi bɛr yi Nuhu. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Nǝ mkpaŋ yuŋɔ ndi alu ba ne zǝne ku ba, aneshir ne zen li te so, ta amba te na zǝk amba, gar yir mkpaŋ ndi Nuhu ne yir gu; <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />Be ne zhi kinuŋ ndi tei nyɛ ba kɔte yir mkpaŋ ndi anca ne nyɛ vu ba agli adɔmɔ bɔbɔk. Waŋ ayi ir keŋ ndi nyɛ yi Izu Neshir tei yime. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Aner aya ate kɔ dɔ ne ahwaŋ; atei baŋ zhin te duŋ zhin. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Amba aya atei dɔ zen kɔk ne nena atei baŋ zhin te duŋ zhin.<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />&lt;&lt;Amɛ zhin bǝ sɔŋ te shur zhin ayi, te ba zhin ne zhi te ayi bɛr tayi Ŋgɔŋ amine atei nyɛ ba. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Izhin bǝ zhi te di: Abɛ di ataki ne kɔb ne zhi mkpaŋ kɛ bu tayi ner ne zhib atei nyɛ, abɛ asɔŋ ablɛ kɔbɔ ndi ba nuŋ atei zhi bu iyi zhib ba. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />zhineba min yi nak sɔŋ zhin atsitsir, te Izu neshir atei nyɛ ne mkpaŋ keŋ ndi ba zhin ne zhi ba.<verse eid="MAT 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />&lt;&lt;Ayi ŋɔwa ayi ne na izub te ana yi mgbemgbebɛ igen, waŋ ndi atukɔ ama ane anyagu tɔ nki agɛnɛ te abɛ bǝn anǝk ba kili ne mkpaŋ kɛ li kili anenen? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Anu didik ayi bǝn igen waŋ ndi atukɔ maa ate nyak te anyɛ yigu azǝn na ki yiŋ ndi ne diu abɛ na. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Mbla zhin izub lɛ, atei baŋ adudunki amaa asagu ne aŋɔk bɔbɔk. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Tǝ abɛ di igene ayi ne susun mimin te asɔŋ adi tu maa, &lt;Atukɔ amuŋ ayi gbagbaŋ ba tei nyak andanda ba,&gt; <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />Te akɔ tsik anki agene te akɔ yir li te so ben abɛ so ki rǝrǝ. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Atukɔ ayou igene atei nyak ne bɛr yiŋ ndi bane di atei nyak ba, ne mkpaŋ keŋ ndi bane zhi atei nyak ba. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Atei mligu tsik te turu azhɔk bǝn abɛ kamgli, amɔ atei zhin te ŋuu aŋin.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">Nkan lɛ yi Aŋɔ Awur</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />Nǝ mkpaŋ yuŋɔ ikɔb kǝ gbarshu itei yi ndi asun aŋɔ awur ndi ne baŋ iki yi laŋlu men te gar mla bǝn vǝnenzak ne tei ta wa yayas. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Atuŋ ne miŋ mǝne neyi bliblik atuŋ neyi mgbemgbebɛ. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Abliblik ne vu iki yi laŋlu men yaŋ anyɛ ne miŋǝ. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Atuŋ abɛ mgbemgbebɛ, aba ne vu iki yi laŋlu men bǝn anyɛ ne miŋ mpempem abiŋ bǝn kiki yi laŋlu mǝne. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Ivenenzak ne tei ta wa ma bane anyɛ andanda ba, teduŋ ba ne kurna.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />&lt;&lt;Ne atsutsu bu ne wɔ te ahwa: &lt;Tɔ zhin Ivenenzak ayou wa yayas waŋ anyɛ! Ru zhin te mla ben abɔu! <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />&lt;&lt;Amɛ asun aŋɔ mɔ ne akam asi te akɔ sak lu ne iki yi laŋlu mǝne. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Abliblik aŋɔ adi abɛ mgbemgbebɛ, &lt;&lt;Dik zhin ta anyɛ min; te iki yi laŋlu mɔrɔ rim&gt;&gt;<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />Adi, &lt;&lt;Ta kyak,&gt; anyɛ me batei mla ta ben zhin ba. Gar zhin ben abɛ lɛb anyɛ te lɛb zhin amin.&gt;<verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />&lt;&lt;Ndi ayi ne ankɔŋ ane gar lɛb anyɛ me, Ivenenzak nga akɔ ayir. Asun amunamba mgbemgbeb abaŋa ne yir kɔb gyaŋa ndɔ ben Ivenenzak nga. Ankyak ne tur ankɔŋɔ aku.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />Nki amunamba ma ne anyɛ. &lt;Ŋgɔŋ amɔr! Ŋgɔŋ amɔr!&gt; Te di, &lt;Bu ta ankɔŋ!&gt;<verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />&lt;&lt;Ankyak adi ba, &lt;Mbla zhin izub, bam nǝ nzhi zhin ba.&gt;<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />Amɛ shur zhin ayi, te ba zhin ne zhi bǝne kɔ mkpaŋa ba.<verse eid="MAT 25:13" /></para>
  <para style="s">Nkan lɛ yi zhi ndum</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />Itei, nak nayi ndi ner ndi atei gar tsǝn, ne azho agene maa te agab ba adudunki ama. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Ne nek kote ŋowa azɔb irkǝ mgbyamgbyaŋ maa: ne kuti ne nuŋu azhin atuŋ, te na nek nuŋ azhin ayaa, te na nek nuŋ azhin azhiin. Fe ta gar tsǝn ma. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Waŋ ndi ne ta azhin atuŋ aru andanda te kɔte kam aŋɔk ne azɔbɔ har azɔb azhin atuŋ ne na yuŋ tu mɔ. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Waŋ ndi ne anak ana ta azhin aya ne nak ana yuŋ tu mɔ. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Fe waŋ ndi ne ta azhin ne kɔmɔ shaan, te gar ai ka dudu ne mimi te asu azɔb ayi atukɔ ama ayir.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />Ndi ne baŋ mkpaŋ atukɔ ayou agene ne kam aŋyak te zhɔ ba te abɛ nyɛ bla wa ki yiŋ ndi ne na ne azɔbɔ. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Ner waŋ ndi ne ta azɔb azhin atuŋ ma ne agli azhin atuŋ agli anyɛ me ne tu mɔ. Adi, &lt;Atukɔ,&gt; &lt;Une nǝm azɔb azhin atuŋ. Tɔ, mne yik azhin tuŋ ne tu mɔ.<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />&lt;&lt;Atukɔ ama ablau, &lt;Une na ki didik, igen didik, ne na izub! Une na zub ne ki watsɔb; M tei nek kiki tetɛk ne aŋɔk ami. Nyɛ nyer bǝn atukɔ ami!&gt;<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />&lt;&lt;Ner waŋ ndi ne ta azɔb azhin aya ne nyɛ maayi te di, &lt;Atukɔ,&gt; une nǝm azɔb amɛ ya tɔ mne yik aya ne tu mɔ.&gt;<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />&lt;&lt;Atukɔ ama asagu ma, &lt;Une na ki didik, igen didik ne na zub! Une nak na izub ne kiki watsɔb; M tei nek kiki tetɛk ne aŋɔk ami. Nyɛ nyer bǝn Atukɔ ami!&gt;<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />Fe ner waŋ ndi ne ta azɔb zhin ne anyɛ te di, &lt;Atukɔ, mne nak nzhi te uyi neshir ne klɛktu&gt; user ne amkpa waŋ ndi bau ne tib kinuŋɔ ba te na biŋ ne amkpa ndi bau ne yi bǝbǝ ki me ba. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Tǝduŋ mne ntǝ sisik te ngar ru azɔb mi ne mimi. Tɔ, iki mi yiŋ.&gt;<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />Atukɔ ama adi, &lt;&lt;Uwa uyi igen mimin, ne ankɔtiŋ! Amɛ une zhi te di nga msɛr ne amkpa ndi bam ne ntibɛ ba te na vu ne amkpa ndi bam ne yi bǝbǝ mei? <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Amɛ, ai ubɛ shur azɔb amuŋ nyak ne abɛ ne nyak azɔb, te duŋ mkpaŋ keŋ ndi mbǝ nyak mbǝ nyɛ nta kǝ ndɔ bǝn azɔb ayi sɔŋ ne tu mɔ.<verse eid="MAT 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28" />&lt;&lt;Ta zhin azɔb azhin ma ne aŋɔk ama te kam kɛ nǝk waŋ ndi ayi nɛ azɔb azhin awur ma. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Waŋ ndi te yi ne ki atei na nǝgu nuŋ, atei yime neyi tetɛk. Waŋ ndi bate yime neyi ba, ivǝtsob yiŋ ndi ayime neyi atei tei bene bɔu. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Tuk zhin igen mimin waŋa zhɔk ne abɛm, ne amkpa ane amatib bu, ndi atei zhin te ŋuu aŋin.&gt;<verse eid="MAT 25:30" /></para>
  <para style="s">Awanta ben Awuwu</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />&lt;&lt;Ndi Izu Neshir ate nyɛ ne laŋ zar ayi ma, bǝn bɔbɔk abɛ shar ayou Arik, atei zǝ asɔŋ ne mben yi ŋgɔŋ maa yi shu. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Aneshir bɔbɔk ne gɔnmimi atei biŋ ne ti ma, atei hria aneshir azhizhin ir keŋ ndi ne kyu a hria awanta are miŋ awuwu mɔ. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />atei nyak awanta ma ne ŋɔk li ma te aŋyak awuwu mɔ ne ŋɔk mla ma.<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />&lt;&lt;Fe Itumɔ atei di abɛ gar kɛ ŋɔk li maa, &lt;Nye zhin, zhin aba ndi tetɛɛ amuŋ ne nek zhin anu adidik; ta zhin ki yiŋ ndi yi min, kɔb Arik keŋ ndi ne na kɛ aŋyak zhin vuŋ rɛ mkpaŋ kɛ na gɔnmimi. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Tǝ kasa ne vuŋ me zhin ne nǝm kili nta li, ihre amashir ne vuŋ me zhin ne nǝm Amashir nta so, Mne yi cen izhin ne tam ne akɔbɔ amin, <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Mne yaŋ ki yi su zhin ne nǝm ki yi su, Ikpa ne lɔm zhin ne nyɛ tek mǝ, mne yine jaru zhin ne nyɛ tɔm.&gt;<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />&lt;&lt;Abɛ yi tsetser atei sagu ma, &lt;Ŋgɔŋ, atenta tane yik kasa ne vuŋu te nǝgu ki li, kɔ yik hrie ne vuŋu te nǝgu amashir ta so? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Atenta ta ne yigu yi cen te tau zhɔk ne ki, kɔ uyaŋ kiki yi su te suu kɛ? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Atenta ta ne yigu kur lɔ kɔ ne jaru te gar tegu?&gt;<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />&lt;&lt;Itumɔ atei di ba, &lt;mbla zhin izub, kɔte ki yiŋ ndi zhin ne na zhin ne miŋ kɛ amunzumɔr amɔtsɔtsɔb abaŋa, zhin ne naa nga.&gt;<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />Fe atei di abɛ yine ŋɔk mla ma, kam deme zhin bene bɛm, zhine baŋ ndi ne gbar zhin Arik, yir zhin miŋ ilu kǝ yaŋ klɛtu keŋ ndi ne na kɛ anyak shetan bǝn abɛ shar ayou Arik. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Tǝ kasa ne vuŋ me zhin ne ya kili zhim ma. Ihre amashir ne vuŋ me zhin ya amashir zhim ma. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Mne yi cen zhin kyak zhɔm gli yire, mne yaŋ kiki yi su zhin ne kyak nǝm ki me, Mne nkur lɔ te na nkur ne jaru zhin ne kyak nyɛ tek me ma.&gt;<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />&lt;&lt;Aba menyi atei rib bu, &lt;Ŋgɔŋ, atenta te tane yik ikasa ne vuŋu ka ihrie ne vuŋu kɔ uyi cen kɔ uyaŋ ki yi su kɔ ukur lɔ kɔ ukur ne jaru, te kyak lɔgu ma?&gt;<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />&lt;&lt;Atei di ba, &lt;Mbla zhin izub, ki yiŋ ndi zhin ne kyak na zhin ne miŋ kɛ amɔtsɔtsɔb abaŋa, zhin ne kyak nam ma.&gt;<verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />Fe atei kɔmɔ ne amkpa ane yik iya yaŋ klɛ tu fe abɛ yi tsetser atei yik ivli kǝ yaŋ klɛtu ndɔ ben Arik.<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Nǝ kpa ki mimin ne tɔ Yesɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Ndi Yesɔ ne bla lǝlɛ yiŋɛ bɔbɔk, ne bla abɛ tsene maa te di, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />&lt;&lt;Zhin ne men zhi, igyaŋ yi tuk glak ne dǝk bɛr ya, atei vuŋ Izu Neshir anǝk teduŋ abɛ kpaŋu ne nkunkun.&gt;&gt;<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Amɛ ngɔŋ ne abɛ na ndum kǝ Arik bǝn anunkub abɛ aneshir ne tuŋ abiŋ ne amkpa ne sɔŋ ngɔŋ ne abɛ na ndum kǝ Arik, ndi azhɔu te Kayafa, <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Ne kpa lɛ ndi aba atei vuŋ Yesɔ ne yaŋ zhi aneshir te aba abɛ tsǝgu aŋun. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />&lt;&lt;Bata tei vuŋu ne mkpaŋ kɛ igyaŋ ba,&gt;&gt; adi, &lt;&lt;te kǝr mgbu bǝ lu zhaku ba.&gt;&gt;<verse eid="MAT 26:5" /></para>
  <para style="s">Nǝ Nuk Yesɔ Anyɛ ne Batanya</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Ndi Yesɔ ne yine Batanya ne kɔb kɛ Siman ndi azhɔu te ne lɔ amgbyak, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />uwa nuŋ ne nyɛ bǝn abɔu te gli anye albasta ane yegbo didik ane te anyaŋ, te tsǝu ashuru ne tu ne mkpaŋ keŋ ndi ne sɔŋ ali kili.<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />Ndi abɛ tsene maa ne yik amɛ, ne baŋ afuk. Te rib te di, &lt;&lt;Ayi anii te iwa ma acɔk wurdi waŋa ala ir kǝŋe?&gt;&gt; <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Anyɛ waŋ ndi abɛ baŋu alɛb ne zɔb tetɛk te nek abɛ iyah neyi.&gt;&gt; <verse eid="MAT 26:9" /><verse number="10" style="v" sid="MAT 26:10" />Ndi Yesɔ ne zhi ki ndi azǝnǝ dime, adi ba, Anii dam zhin ben wa waŋa? Ne nam ki didik. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Zhin nak yi ndɔ bǝn abɛ ya atei nga bam yi bǝn zhin atutuk ba. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Ndi a nuk me anye waŋa ne kpa, ayi ndi ne zhi te iku muŋ ne te gbahir. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Mbla zhin izub, amkpa waŋ ndi ate du ilɛ didik kǝŋe kab ne gɔnmimi, atei lǝlɛ kɛ iki yiŋ ndi wa waŋa ne nai, te abɛ bene ashuu azhi.&gt;&gt;<verse eid="MAT 26:13" /></para>
  <para style="s">Yahuda ne tanyɛme ne baŋ Yesɔ lɛb</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Ankyak zhin ne miŋ kɛ awur ane ya abɛ zeu tsǝne waŋ ndi azhɔu te Yahuda Iskariyɔti ne gar bǝn ngɔŋ ne abɛ na ndum kǝ Arik <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />te rib, &lt;&lt;izhin tei nǝm anii tem vuŋu nek zhin?&gt;&gt; Fe akɔ abla azɔb sɔk tar anugu. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Nak baŋ rɛ mkpaŋ yuŋɔ Yahuda ne vuŋ wɔb ankɔŋ ane vuŋ Yesɔ nek ba.<verse eid="MAT 26:16" /></para>
  <para style="s">Kili Amgbalu yi Yesɔ</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Nǝ bɛr yi zhin yi igyaŋ yi li kili yi yaŋ sa, abɛ tsene maa anyɛ ben Yesɔ te rib bu, &lt;&lt;Usɔ ta bǝ na kili yi igyaŋ yi tuk glak nyak neme?&gt;&gt;<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Asak bama, &lt;&lt;kɔmɔ zhin ne miŋ ntun bǝn ner nuŋ waŋa te bla zhin newu, &lt;Ine tsar adi: Mkpaŋ keŋ ndi ne nyak me kɛ ne te gbahir M tei na igyaŋ yi tuk glak bǝn abɛ tsene maa ne kɔmi.&gt;&gt;&gt; <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Fe abɛ tsene maa ne na kiyiŋ ndi Yesɔ ne di aba neka na kili yi igyaŋ yi tuk glak nga.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Ndi amgbalu ne te, Yesɔ ne zǝ sɔŋ ndɔ ben awur ane ya ma. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Ndi kab mǝne azǝn li kili, a diba, Mbla zhin izub, izhiin ne miŋ mine atei baŋ me alɛb.<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Asusun amene ne cɔk ala tetɛk akɔ adiu azhizhin Ŋgɔŋ, ayi ngai?<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Yesɔ adi, &lt;&lt;waŋ ndi ta sɔŋ li agbǝgba zhin wa atei baŋ me lɛb. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Izu neshir atei kɔmɔ ir keŋ ndi ne cɛr ne atu ma. Abɛ kpa kpa ayaa klikli aŋub waŋ ndi ai vuŋ Izu Neshir alɛb! Iya ngɔŋ itei vuŋ neshir waŋa. Nǝ rɛ ndi bai bɛ ŋliu ba.<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Fe Yahuda, waŋ ndi atei baŋu alɛbɛ, adi, &lt;&lt;Ne tsar, kɔ ayi nga ini?&gt;&gt;</para>
  <para style="p" vid="MAT 26:25">Yesɔ adiu, &lt;&lt;Anak ayi wa&gt;&gt;<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Ndi asɔŋ azǝn li kili, Yesɔ abaŋ mbwab borodi, te nyer Arik te amlik kɛ, te agab abɛ tsene maa, te di, &lt;&lt;Ta zhin te ta; waŋa ayi kpa muŋ.&gt;&gt;<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Fe abaŋ antse me, te nyɛr Arik te gab ba, te di &lt;&lt;So zhin akɛ, bɔbɔk mine. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Waŋa ayi azhizhi amuŋ ane kpa lɛ nyak, ndi ne avara hrie te abɛ zuk aneshir tetɛk azhɔk ne zumimin men. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Mbla zhin, bam tei na so ama dɔ nkunkun yiŋɛ ba vuŋ rɛ azizaŋ se bɛr yiŋ ndi M tei so kɛ yayas ben zhin ne ikɔb Tetɛɛ amuŋ.&gt;&gt;<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Ndi ne duk asem, ne ru akɔmɔ ne gbu yi zetun.<verse eid="MAT 26:30" /></para>
  <para style="s">Yesɔ ne di Biturus atei tun zhi wa</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Ankyak Yesɔ ne bla ba, &lt;&lt;Ne buu yiŋɛ izhin tei klu te duŋ me bɔbɔk mine, te neka cɛr aŋyak:</para>
  <para style="q1" vid="MAT 26:31">&lt;&lt;&lt;M tei ŋur ne kyu,</para>
  <para style="q2" vid="MAT 26:31">Awanta ma atei ŋar.&gt;<verse eid="MAT 26:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />Amɛ ndi Mte nkamlu, M tei ku zhin ti te ngar Galili.&gt;&gt;<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Biturus adi, &lt;&lt;kɔ te yi ndi bɔbɔk atei klu te duŋu, nga bam tei nklu te nduŋu ba.&gt;&gt;<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />&lt;&lt;Mbla zhin izub,&gt;&gt; Yesɔ adiu, &lt;&lt;Nǝ buu yiŋɛ, utei tun zhim amkpaŋ atar teduŋ agbak abɛ shi tuk.&gt;&gt;<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Biturus akyak te di, &lt;&lt;kɔ te yi ndi M tei nku, bam tei ntun zhiu ba.&gt;&gt; Bɔbɔk men abɛ tsene maa anak ana bla ki zhin yiŋɛ.<verse eid="MAT 26:35" /></para>
  <para style="s">Getsemani</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Fe Yesɔ ne ru ndɔ ben abɛ tsene maa gar amkpa waŋ ndi azhɔu te Getsemani, adi ba, &lt;&lt;Zisɔŋ zhin ayaŋ teduŋ mgar amɔ te kɔte mben Arik.&gt;&gt; <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Ne Gli Biturus ben amun Zebɛdi me ya bene bɔu, susun ma ku zen cɔk la te zen lɛnu tetɛk. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Fe adi ba, &lt;&lt;Susun muŋ len mǝ ndi mtei nku. Kli zhin ayaŋ te bǝn shur zhin ayi ndɔ bǝn abɛm.&gt;&gt;<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Ndi ne yine tib akɔmɔ watsɔb, ne zhaku akuti ne mimi te ben Arik, te di, &lt;&lt;Tetɛɛ amuŋ, te yi ndi itei te, baŋ vǝn kuca yiŋɛ tibɛ bene bɛm ma. Ne mee ba yik muŋ ba, bɛ yi yik mi.<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Fe ne kam agar bǝn abɛ tsene maa te yik ba akɔ kur na. &lt;&lt;Ba zhin tak na shur ayi ndɔ bǝn abɛm kai mkpaŋ zhin ka?&gt;&gt; Arib Biturus. <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Sɔŋ zhin atsitsir te ben zhin Arik te kǝr zhin bǝ zhaku ne iki yi tik yi ba. Izhu ne tanyɛmɛ, ikpa maa kɛ kyak.&gt;&gt;<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Ne kam agar amkpa ma mkpaŋ kɛ ya te kɔte ben Arik, Tetɛɛ amuŋ, te yi ndi bai te ubǝ baŋ vǝn kuca yiŋɛ gli tib ma te se mne nsɔi, duŋǝ bɛ yi ndi wa une yik.&gt;&gt;<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />Ndi ne kama nyak, ne na nyɛ yik ba kukurna, ayi me ne aluk. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Fe ne na duŋ ba te na kam agar amkpa ne ben Arik mkpaŋ kɛ ntar, te na bla ki zhin yiŋɛ.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />Fe a kam aŋyak ben abɛ tsene maa te di ba, Zhin nak ri kukur na izhin kur sige? Tɔ zhin, mkpaŋa neka te gbahir, atei vuŋ Izu Neshir alɛb ne aŋɔk abe na zumimin. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Lu zhin, ta bɛ kɔmɔ! Tɔ ner ne baŋ me lɛbɛ waŋ!&gt;&gt;<verse eid="MAT 26:46" /></para>
  <para style="s">Nǝ vuŋ Yesɔ</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Ndi ne yine miŋ kǝ lɛ, Yahuda ndi ayi ne miŋ kɛ abɛ tsene maa awur ane yaa ma, azǝ ayir. Ntsan aneshir azeu te gli nzinzi gba bǝn amkpɔk angub, abaŋ ndi ngɔŋ ne abɛ na ndum kǝ Arik bǝn anunkub aneshir ne shar ba. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Ne baŋ Yesɔ lɛb ne men atsar ba ngir kǝ vuŋu ma: &lt;&lt;Waŋ ndi tate rim akpa nuŋ ayi neshire wa.&gt;&gt; <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Yahuda anyɛ bǝn Yesɔ, &lt;&lt;Mtegu Ne tsar!&gt;&gt; Tǝ akɔ rim Yesɔ avuŋ.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Yesɔ adiu, &lt;&lt;kpamuŋ, Na kiyiŋ ndi ne Gli zhin nyɛmɛ.&gt;&gt; Ankyak aneshire anyɛ te vuŋ Yesɔ. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Ne me, zhin ne abɛ zǝ Yesɔ akɔ tun anzigba ma, te tsem igen ayou ngɔŋ ne abɛ na ndum kǝ Arik ne tɔŋ akyaŋ.<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />&lt;&lt;Su anzigba ami ne yɛnɛ,&gt;&gt; Yesɔ adiu, &lt;&lt;te bɔbɔk abaŋ ndi atun anzi atei ku ne anzi. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Zhin yik, te di bam tei ya ben Tetɛɛ amuŋ, te azizaŋ atei shar abɛ shar maa naŋ tek wur na yaa? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Amɛ atei na kikin te duŋ ilɛ kǝ ne bla shar ayou Arik kǝŋe ibǝ shaga?&gt;&gt;<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Nǝ mkpaŋa Yesɔ adi aner tetɛk ge, me yi ngɔŋ abɛ zhib, te zhin ru te nyɛ ne nzizi bǝn angub te nyɛ vuŋ me? kɔte bar tayi me sɔŋ ne akabakɔŋ te tsar lɛ kɛ Arik, bɛ zhin ne vuŋ me ba. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Amɛ kiyiŋɛ nena ta ilɛ kǝ ine bla shar yi Arik bɛ shaga. Fe abɛ tsene maa bɔbɔk men akyagu te klɔ ŋar.<verse eid="MAT 26:56" /></para>
  <para style="s">Yesɔ ne angus kɛ aner abɛ te ŋas</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Abaŋ di ne yen Yesɔ mɔ ashɛu abaŋ te gar bǝn kayafa ngɔŋ ne abɛ na ndum kǝ Arik nɛ amkpa awaŋ ndi abɛ tsar lɛ kɛ Arik bǝn anunkub abiŋɛ. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Ankyak Biturus a zeu gbagbaŋ ne miŋ amkpa ne sɔŋ ngɔŋ ne abɛ na ndum kǝ Arik. Ne yir te zǝ sɔŋ bǝn abɛ bla te tɔ kiyiŋ ndi ate na.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />Ngɔŋ ne abɛ na ndum kǝ Arik bǝn abɛ te ambuk awɔb kiki yi mu netu kɛ Yesɔ te aba bɛ tsǝgu aŋun. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Ankyak bane yik kinuŋ ne atu maa ba neme lǝlɛ yi mu ne lɛ ne atu maa. Ne klɛtu abɛ bla amɛ yaa ne ru akɔmɔ. <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />Te di &lt;&lt;Ner waŋ adi, M tei ya zǝr Akabakɔŋ ye Arik te meu ne bɛr tar.&gt;&gt;<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Fe ngɔŋ ne abɛ na ndum kǝ Arik lu te di Yesɔ, &lt;&lt;Bau tei bla ka? Le kǝŋ di aner abaŋa bla kɛ ne tɔ mi yi kikin?&gt;&gt; <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Ankyak Yesɔ bane bu anu te di kinuŋ ba.</para>
  <para style="p" vid="MAT 26:63">Ngɔŋ ne abɛ na ndum kǝ Arik adiu, &lt;&lt;Mne biŋu bǝn Arik tsitsir: blam wau yi Almasihu, izu Arik.&gt;&gt;<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />&lt;&lt;Amɛ, une ka bla me,&gt;&gt; Yesɔ di. &lt;&lt;Amɛ me bla zhin bɔbɔk min: Vuŋ rɛ zizaŋ te kɔ ti zhin tei yik Izu neshir akɔ sɔŋ ne ŋɔk li kɛ Ŋgɔŋ ne mgbyamgbyaŋ te anye ne amkpa ne gbarshu.&gt;&gt;<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Ngɔŋ ne abɛ na ndum kǝ Arik a gbu anklu amaa aŋa te di, &lt;&lt;Ayen Arik! &lt;&lt;Tei na wɔb iki nuŋ nɛ atu maa! <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Zhin ne yik kikin?&gt;&gt;</para>
  <para style="p" vid="MAT 26:66">&lt;&lt;Ne mla ne ku,&gt;&gt; Adiu.<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Fe aser ante shuru ne ti, te na yiu ne za. Anuŋ ŋuru ne la ŋɔk <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />Te di, bla ta ki te na ni ti, Almasihu, ayi ŋɔwa ne ŋɔru?&gt;&gt;<verse eid="MAT 26:68" /></para>
  <para style="s">Biturus ne tsar yaŋ zhi Yesɔ</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Ndi Biturus ne kɔ sɔŋ ne amkpa ne sɔŋ ngɔŋ ne abɛ na ndum kǝ Arik igen venwa anyɛ bene bɔu te di, &lt;&lt;Wa mi yi uyi bǝn Yesɔ ndi awɔ ne Galili,&gt;&gt; A di.<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Ankyak Biturus adi ba bam ne zhi lɛ keŋ ndi izhin lɛ kɛ ba,&gt;&gt; A di.<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Fe aru te gar anɔkɔŋ, ne mwɔ gen vǝn wa nuŋ ne yigu te bla aneshir abaŋ ndi aklɛ kli ne kpama, &lt;&lt;Ner waŋa ne yi bǝn Yesɔ awɔ nǝ Nazara.&gt;&gt;<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Ne na kyak lɛ me, te sherim: &lt;&lt;Bam ne zhi ner waŋ ba!&gt;&gt;<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Ne kpaŋ vǝtsɔb abaŋ ndi ake kli amɔ aye bǝn Biturus te diu, &lt;&lt;Lɛ didik uyi ne min mǝne, Ilɛ mi ne gliu Gli rumɔ.&gt;&gt;<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Fe akɔ zhɔ tu maa iki mimin, te she arim ne ti men, &lt;&lt;Bam ne zhi ner waŋ ba!&gt;&gt;</para>
  <para style="p" vid="MAT 26:74">Ne amkpamkpama agbak akɔ atuk. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Fe Biturus a shu azhi lɛ kǝŋ di Yesɔ ne bla te di: &lt;&lt;Agbak bate tuk ba, utei tsar yaŋ zhim amkpaŋ atar tɛ agbak abe shɛ tuk.&gt;&gt; Ankyak aru abɛm te zhin mgbɔmgbɔŋ.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">Yahuda ne kɔr tu ma</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Amblimblɛ bib, ngɔŋ ne abɛ na ndum kǝ Arik ben anunkub aneshir ne kpa aŋyak ne kǝŋ ndi aba tei vuŋ Yesɔ. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Fe akpau te gliu akɔte nek Bilatus, ŋgɔŋ ne ntuno.<verse eid="MAT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Ankyak Yahuda, waŋ ndi ne baŋ Yesɔ alɛb, ne yik te Yesɔ neka nyagu ne ŋun, anyɛ vuŋ Yesɔ fe asen susun maa te gli ngɔŋ ne abɛ na ndum kǝ Arik bǝn anunkub neshir azɔb sɔk tar ayiŋ di ne baŋ Yesɔ lɛb. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Adi, mne zhi mne lalɛ, mne baŋ waŋ di bene zhi kinuŋ ba lɛb zhin tebɛ ŋunu. Adiu te di, waŋ ayi ni bǝn bɛta? Yiŋ ne dǝgu mi.<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Fe Yahuda avu azɔbɔ atuk shur ba ne akabakɔŋ te kam tibɛ. Ankyak ne ru te kɔte kɔr tu maa.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />Ngɔŋ ne abɛ na ndum kǝ Arik avuŋ azɔb te di, ba rɛ ba te abǝ shur azɔb azhizhi ne amkpa ane nyak azɔb aye zhizhi. <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Fe alɛ nyak te abɛ ban azɔb alɛb amkpa ndi atei ber aru acɛnɛ. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Waŋa ayi ki yiŋ ndi azhɔ amkpama te amkpa ane azhizhi har aliŋ <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Waŋa ayi ki yiŋ ndi Irmiya ine bla shar yi Arik ne shaga. Nɛ vu azɔb sɔk tar ayiŋ ndi ne lɛ nyak ne atu maa, ben aneshir abɛ Isrela, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />Amɛ ne vu azɔb alɛb amkpa ndi atei ber aru acɛnɛ, ndi Ŋgɔŋ ne bla ba.<verse eid="MAT 27:10" /></para>
  <para style="s">Yesɔ ne angus kɛ Bilatus</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Yesɔ ne klɛ ne ti kɛ ngoŋ ne tun fe ngoŋ aribu te di uyi itum ne yahudawa? Yesɔ adiu ne ka bla.<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Amɛ ngɔŋ ne abɛ na ndum kǝ Arik bǝn anunkub aneshir ne gliu ne lalɛ,ba ne di ba kinuŋ ba. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Bilatus aribu, bɔu wɔ like yiŋ di alɛi ne tu mi ka? <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Fe Yesɔ bane di kinuŋ ba, kɔte lɛ zhin ndi ne bla ke ne tu mɔ, ngɔŋ ne tun ne vuŋ anu.<verse eid="MAT 27:14" /></para>
  <para style="s">Nɛ nek Yesɔ tǝ be ŋunu</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Ayi kiyiŋ di ŋɔk ne tun ne nai aŋyak ne bɛr iyi na gyaŋ abɛ zhɔk ner nuŋ ne min kɛ abaŋ ndi ne ku ba ne jaru ndi aneshir ne yik ne re ba. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Nǝ mkpaŋa ayi ne nuŋ nǝ jaru ndi, azhɔu tǝ Barabas. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Fe ndi aneshire ne biŋ aklɛ, Bilatus rib ba, ayi ŋɔwai izhin ne ta nyɛmɛ mbǝ zhɔk zhin Yesɔ kɔ Barabas, kɔ Yesɔ waŋ di azhɔu te Almasihu? <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Amɛ ne zhi tanyɛme ne susun tedi ivuŋ Yesɔ nek wa ai te zor.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Ndi Bilatus akɔ sɔŋ ne mben yi te ambuk, iwa maa ne shar ne lɛ kɛ ner waŋ ndi bane zhi kinuŋ ba, te mǝne yik iya ne tu maa ne rimla aliŋe.<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Ankyak ngɔŋ ne abɛ na ndum kǝ Arik bǝn anunkub abɛ ntun akyak te shɔk aneshir abɛ tun Barabas, te bɛ ŋun Yesɔ.<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />Ngɔŋ ne tunɔ arib ba. Ne min kɛ aneshir ya baŋ zhin yik bɛ zhɔk zhin ŋɔwa? Asaga te di&lt;&lt;Barabas&gt;&gt;.<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />Bilatus adi, me te na kikin bǝn Yesɔ di adi wa yi almasihu?Adi bɔbɔk mǝne, Be kpaŋu ne kpɔk tu kunkun.<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Bilatus arib ba ayi ki mimin tayi ne nayi? Akyak a bu akɔr te di, Be kpaŋu ne kpɔk tu kunkun.<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Ndi Bilatus ayik ba wa ne vuŋ asusun amen ba, aneshir kyak te yatɔŋ ŋɔk abaŋ amashir a ŋla a ŋɔk ma ne ti kɛ aneshir tetɛk, te di bam ne yik ner waŋa ne kinuŋ mimin yi ŋunu ba, waŋa ayi lɛ min. <verse eid="MAT 27:24" /><verse number="25" style="v" sid="MAT 27:25" />Aneshir bɔbɔk adi ki mimin yi ŋunu ibɛ yi ne atu amor bɛ vuŋ ta ben amun amɔr.<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Fe aduŋ ba Barabas te duŋ ba tsik Yesɔ te vuŋu anǝk ba bɛ kpaŋu ne kpɔk tu kunkun.<verse eid="MAT 27:26" /></para>
  <para style="s">Abɛ kpaakpa ne zhab Yesɔ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Fe abɛ kpaakpa abɛ ngɔŋ ne vuŋ Yesɔ te gliu agar akaba ayi ngɔŋ ne tun te bin abɛ kpaakpa tetɛk ne atu ake Yesɔ. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />A kpobu iki maa, te suu itu anku sesen. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Te na baŋ itu anku kɛ ncɔŋ a suu ne tu abaŋ mkpɔki nuŋ ne ŋɔk li. Fe te tara gbarum ne ti maa te mlagu te di, &lt;&lt;Ŋgɔŋ itum ne Yahudawa. <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Aser ante shuru te mkpɔki maa te bene tsegu ne tu. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Ndi ne mlagu tsik atun kiki yiŋ ndi ne sui, te su ki maa te gliu te gar amkpa waŋ ndi atei kpaŋu ne kpɔk tu kunkun.<verse eid="MAT 27:31" /></para>
  <para style="s">Nǝ kpaŋ Yesɔ</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Ndi a sɔŋ ru, ne yik ner nuŋ di a zhɔ sak maa te saminu awɔ ne kurane, ne duŋ a baŋ mkpɔk nkunkun kǝ gen ne mgbyamgbyaŋ. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Ne ye amkpa awaŋ di azhɔu te Golgota watɔ akpukpo tu. <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Amɔ abaŋ ama dɔ kunkun inebi ndi ne cogu aglik ne ki iyi lɛk, te nǝgu abɛ so, ndi ne vuŋu atɔ ne kyak sou ma. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Ndi ne kpaŋu ne kpɔk tu kunkun gab kiki yiŋ ndi ne sui ne shur ankǝŋkam. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Azesoŋ te blɛu amɔ. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Ne tu maa ne kpaŋ cɛr nuŋ tedi, waŋa ayi Yesɔ, Itum ane Yahudawa. <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Ne kpaŋ abɛ zhib amɛ ayaa izhiin ne ŋɔk li, zhin ne ŋɔk mla. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Abaŋ ndi agayir ne amkpama ayen Yesɔ te mes atu amen. <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />Te di, iwa waŋ ndi te iwa atei zǝr akabakɔŋ te meu bɛr tar, ta tu mi zhɔk, zǝ ne mkpɔk nkunkun kǝ gen te yi ndi uyi izu Arik.<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Ne ankɔŋ azhin awaŋa ngɔŋ ne abɛ na ndum kǝ Arik bene anunkub aneshir bene abɛ tsar lɛ kɛ Arik ne mlagu. <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />Adi ne ta neshir Anuŋ azhɔk, te abe ta tu maa zhɔk ba, Ayi itum ne Isrela, duŋɔ zǝ ne mkpɔk nkunkun kǝ gen azizaŋ ta te tanyɛmɛ bene bɔu. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Ne nǝk tu bene Arik duŋ Arik abe tau zhɔk azizaŋa te ate tanyɛmɛ, ane di iwa ayi Izu Arik,&lt;&lt; <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Ne ankɔŋ zhiin awaŋa abɛ zhib ndi ne kpaŋ ba ben Yesɔ ne yenu.<verse eid="MAT 27:44" /></para>
  <para style="s">Ku kɛ Yesɔ</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Vuŋ rɛ arik ne tsutsu te gar kab arik amgbalu ibu ne ku gɔŋmimi bɔbɔk. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Ne kab arik amgbalu Yesɔ ne bu kɔr ŋɔk te di, &lt;&lt;Lɔi, Lɔi, lama sabaktani?&gt;&gt; Waŋ ayi kiyiŋ di adi &lt;&lt;Arik amuŋ, Arik muŋ ukyak me te nii?&gt;&gt;<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Ndi Anuŋ abaŋ ndi a klikli ne kpama awɔme, adi.&gt;&gt; Azho Iliya.<verse eid="MAT 27:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48" />Inuŋ ne min mǝne aklu te baŋ sɔsɔ te dibu ne amashir muamuaŋ te kpa ne mkpɔki, te nab anǝk Yesɔ te abɛ so. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Nkime adi duŋu kiki maa te tabǝ tɔ kɔ Iliya atei nyɛ te tau zhɔk?<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Ndi Yesɔ ne na zhin ne kɔr ngɔŋ, te baŋ ivli maa ayaŋa.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Ne kpaŋa lablɛ kɛ akabakɔŋ igbuŋa aŋa ayaa rɛ shu te gar mimi gɔŋmimi ne jaŋ, mkpaŋ ne tsik ŋar. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Abɛ ne bu, akpa aner abɛ yi tsetser ndi ne kaku ne lu teyi atsitsir. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Ne ru ne min bɛmɛ, ndi Yesɔ ne lu ne atu kumɔ ne gar ntun yi iyi tsetser te tsar tu maa ben aneshir tetɛk.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Ndi zarmi bǝn abɛ blɛ ibǝ kɛ Yesɔ bǝn nki aneshir ne yik zhaŋ mimi bǝn kiyiŋ ndi nena ,ne te sisik ngɔŋ, te di, lɛ didik waŋa ayi Izu Arik.<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Amba tetɛk ne yi ne amkpama, te klikli gbagbaŋ te zen tɔ. Ne zǝ Yesɔ are Galili tǝ bɛ bǝn anau kiyiŋ ndi reu. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Ne miŋ mǝne Meryamu Madalin bǝn Meryamu Iya men ane Yakubu bǝn Yusuu bǝn yaa men ane amuŋ Zebɛdi.<verse eid="MAT 27:56" /></para>
  <para style="s">Nǝ ruu Yesɔ</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Ndi amgbalu ne te ner nuŋ ndi ayi ne kiyi gɔnmimi ndi azhɔu te Yusuu awɔ ne Arimatiya, ayi ne miŋ kɛ abɛ zǝ Yesɔ. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Ne gar bǝn Bilatus te benu abɛ nek wa ikum kɛ Yesɔ te neka ku. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Yusuu ne baŋ ikum kǝ Yesɔ te nyɛn kɛ aku ne ŋa klu klikla. <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />Te zhɔk kɛ ne bɛmɛ ndi yi yayas keŋ ndi ne sub kɛ ne mkpaŋ taku tena sub anu mkpaŋ iyi ku anumɔ ne taku te ku anu bɛme te tibɛ. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Meryamu Madalin bǝn Meryamu nuŋ azǝ sɔŋ gbahir nenu bɛmɛ.<verse eid="MAT 27:61" /></para>
  <para style="s">Abɛ blɛ bɛ</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Ndi bɛr ne ŋan, ne bɛr yiŋ ndi ne na kiki, ngɔŋ ne abɛ na ndum kǝ Arik bǝn Ferisawa ne gar ben Bilatus. <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />Te di, &lt;&lt;Ŋgɔŋ,&gt;&gt; &lt;&lt;Tane shuzhi ndi Yesɔ ane yi tsitsir, Ine timu waŋa ne di, &lt;&lt;Ibar tar mtei na lu.&gt; <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Duŋ ablɛ bɛmɛ bɛr tar mba me ba, abɛ tsene maa atei nyɛ zhib kumɔ abaŋ te bla aneshir tedi ne lu ne ku. Ilɔm aneshire itei yi mimin naŋ yi kuti me.<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />Bilatus adi ba, &lt;&lt;Baŋ ne blɛ,&gt;&gt; &lt;&lt;Tsǝn, te duŋ abɛ blɛ ablɛu mgbamgbaŋ ndi zhin ne tanyɛme.&gt;&gt; <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Amɛ ne gar te duŋ abɛ blɛmɛ te na cɛr ngir kɛ itum asak ne bɛmɛ.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Lu Yesɔ ne bǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Ndi bɛr tani ne ndum ne gayir, amblimblɛ bib ne bɛr yi sɔŋ sik Meryamu Madalin bǝn Meryamu nuŋɔ ne gar tɔ ibɛ keŋ ndi ne ru Yesɔ mɔ.<verse eid="MAT 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2" />Ankyak mimi ne zhaŋ, ndi ine shar ayou Arik ne nyɛ rɛ gbarshu, te gar bɛmɛ, te tur mkpaŋ yiŋ ndi ne ku bɛmɛ kǝ Ŋgɔŋ Yesɔ ayuŋ asɔŋɔ neyi. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Kpa ma ne laŋ te zar ayi ndi lu, iki yi su maa ne klak ndi aruru. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Sisik ne vuŋ abɛ blɛ ibǝ me tetɛk te kam ate ndi neka ku.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Ine shar ayou Arik adi amba ma, &lt;&lt;Duŋ te zhin sisik ba, me ne zhi te izhin wɔb Yesɔ, waŋ ndi ne kpaŋu ne nkunkun. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Ba yi ayaŋa ba; neka lu, ndi ne bla. Nyɛ tɔ zhin amkpa awaŋ ndi ne zhɔ gu ma. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />kɔmɔ zhin andanda te gar te bla zhin abɛ tsene maa: &lt;Neka lu ne bɛ tɔ zhin neka kuti min te akɔmɔ ne Galili. Amɔ zhin tei yigu.&gt; Mneka mbla zhin.&gt;&gt; <verse eid="MAT 28:7" /><verse number="8" style="v" sid="MAT 28:8" />Fe amba ma akɔ duŋ bɛmɛ andanda, ne sisik te bene nyer, te klu agar bla abɛ tsene maa. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Ankyak Yesɔ amla kpa bene abɛba. &lt;&lt;Mtǝk zhin,&gt;&gt; Adi ba. Akɔ nyɛ bǝn abɔu, te zekuru rim aza maa avuŋ te nǝgu ngɔŋ maa. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Fe Yesɔ adi ba, &lt;&lt;kǝr zhi bǝ te sisik ba. kɔte bla zhin amunzumɔr tedi abɛ gar Galili atei yik me amɔ.<verse eid="MAT 28:10" /></para>
  <para style="s">Abɛ blɛ ne bla lu Yesɔ</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Ndi amba ma ayine ankɔŋ, anuŋ abɛ blɛ bɛme ne yir miŋ ntun te bla ngɔŋ ne abɛ na ndum kǝ Arik bɔbɔk ki yiŋ ndi nena. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Ndi aŋgɔŋɔŋ abɛ na ndum kɛ Arik ne sɔŋ ben anunkub te sen lɛ me, ne nek abɛ kpaakpa ma azɔb ayi mwak, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />Te di ba, &lt;&lt;Zhin bǝ di, &lt;&lt;Ta ne ku kurna ne bu te abɛ tsene maa ne nyɛ te zhib kumɔ abaŋ&gt;. <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Te igɔmna te wɔ lɛ kǝŋe, ta tei diu te di ba zhin ne zhi kinuŋ ba, ba zhin tei yi ne ikinuŋ yi dam zhin ba. <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Amɛ abɛ kpaa kpama ne ata azɔbɔ te na ir keŋ ndi ne bla ba ma. Le kǝŋe ne shak min Yahudawa har aliŋ.<verse eid="MAT 28:15" /></para>
  <para style="s">Ishar ŋgɔŋ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Ankyak abɛ tsene maa amɛ wur ne zhin agar Galili, ne gbu yiŋ ndi Yesɔ ne bla ba abɛ gara. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Fe ndi ne yigu, ne zekuru te nǝgu ŋgɔŋ maa. Ama anuŋ ne ma asusun ne tu maa. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Fe Yesɔ anyɛ ben aba te di, &lt;&lt;Mgbyamgbyaŋ kɛ gbarshu ben kɛ gɔnmimi ne neme kɛ bɔbɔk. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Amɛ kɔmɔ zhin te du ilɛ didik bǝn aneshir ne gɔnmimi bɔbɔk, Tǝ su ba ne amashir ne sak kɛ Arik Tetɛɛ bǝn kɛ Izu Arik bɛr kɛ Izhu tsetser, <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />te tsar zhin aba abɛ zǝ bɔbɔk ki yiŋ ndi Mne bla zhin. Mbla zhin me yi ndɔ ben zhin atutuk, te gar klɛtu yi gɔnmimi.&gt;&gt;<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>