<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1TI" style="id">– Dhankavi</book>
  <para style="h">1 तीमुथियुस</para>
  <para style="toc3">1 तीमुथियुस</para>
  <para style="toc2">1 तीमुथियुस</para>
  <para style="toc1">तीमुथियुस क पौलुसन पेहली पत्री</para>
  <para style="mt2">तीमुथियुस को पौलुस कि पेहली पत्री</para>
  <para style="mt1">तीमुथियुस क पौलुसन पेहली पत्री</para>
  <para style="imt">परिचय</para>
  <para style="ip">प्रेरित पौलुस क तरफ सी ओका दास तीमुथियुस क लिखी गय एक पत्री छे। तीमुथियुस शायद मसीह क जन्मन बाद 62-64 सालन लग–भग लिखली गय हती। यो पौलुस क जीवन न शेवली टेमे हसे। पौलुस क तीमुथियुस क साथे एकदम नाटवालो रिश्तो हतो। आरू एक पोर्‍याक रूप मा ओका बैस वार मकल्या हता। <char style="xt"><ref loc="PHM 1:22">फिलेमोन 1:22</ref></char><char style="xt"><ref loc="1TI 1:2-18">1 तीमुथियुस 1:2–1:18</ref></char></para>
  <para style="ip">यो पौलुस क चार पत्री माहन एक छे, ची एक मानस क नी पुन पुरी मंडळी क कय रयु छे। दिसरी तीन पत्री 2 तीमुथियुस, तीतुस आरू फिलोमन छे। पेहलो तीमुथियुस मंडळी क प्रार्थना पर बैस सोवटा शिक्षा देदु। <char style="xt"><ref loc="1TI 2:1-15">2:1-15</ref></char> मंडळी क अगुवा क करता योग्यता <char style="xt"><ref loc="1TI 3:1-13">3:1-13</ref></char> आरू झुठा मास्तर चेतावनी <char style="xt"><ref loc="1TI 1:3-11">1:3-11</ref>; <ref loc="1TI 4:1-5">4:1-5</ref>; <ref loc="1TI 6:2-5">6:2-5</ref></char> देय आरू बैस काहय शामिल छे। पौलुस यो देखाड़तु छे कि तीमुथियुस मंडळी क वीचमा एक अगव वानियो बन्नेन करता आयु हतु। 1 तीमुथियुस क काहय सिध्दांत छे, कि हामरा दाहाड़ा मा मंडळी क अगळवानिया मदत क करता चा लोगहन मंडळी क सेवा काम क संबंध मा शामिल छे।</para>
  <para style="iot">रूप रेखा</para>
  <para style="io">1. पौलुस क तरफ सी तीमुथियुस क नमस्कार <char style="ior"><ref loc="1TI 1:1-2">1:1-2</ref></char></para>
  <para style="io">2. झुठा मास्तर क विरोध चेतावनी <char style="ior"><ref loc="1TI 1:3-11">1:3-11</ref></char></para>
  <para style="io">3. पौलुस क करता ईशु मसीह क धन्यवाद। <char style="ior"><ref loc="1TI 1:12-19">1:12-19</ref></char></para>
  <para style="io">4. पछु चाँ प्रार्थना आरू मंडळी क अगुवा क विषय मा तीमुथियुस क शिक्षा। <char style="ior"><ref loc="1TI 2-3">2–3</ref></char></para>
  <para style="io">5. पौलुस क तीमुथियुस काहय शिक्षा आपीन आपसी पत्री क बंद कर्‍यु। <char style="ior"><ref loc="1TI 4-6">4–6</ref></char></para>
  <chapter number="1" style="c" sid="1TI 1"/>
  <para style="s">नमस्कार</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1"/>पौलुस की आरू छे जो आमरो उध्दारकरता यहोवा–भगवान आरू हामरी आश क आधार मसीह ईशु की हुकुम छे मसीह ईशु कि प्रेरित छे।<verse eid="1TI 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1TI 1:2"/>तीमुथियुस क नाव जो भुरसा मा मारो सचो पोर्‍य छे:</para>
  <para style="p" vid="1TI 1:2">बास यहोवा–भगवान, आरू आमरो पोरबु मसीह ईशु की आरू छे तुखे फोकटन दया, आरू दया आरू किरपा आरू शांती मिवती रये।<verse eid="1TI 1:2"/></para>
  <para style="s">झूठे शिक्षको क विरोध चेतावनी</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3"/>जोसो हाव ने मकिदुनिया क जाते टेहाव तुखे समझाया हुता, कि इफिसुस मा रोवीन काही मानसे क हुकुम देय कि झूठी शिक्षा नी देय। <verse eid="1TI 1:3"/><verse number="4" style="v" sid="1TI 1:4"/>आरू उन काहनियो आरू अमरकाय वंशावड़ी पर मन नी लागाड़या, जिनछे विवाद हुयसे छे, आरू यहोवा–भगवान क चो तयारी क लारे नी, जो भुरसा पर आधारित छे। वोसो ही पछु भी कयता छे। <verse eid="1TI 1:4"/><verse number="5" style="v" sid="1TI 1:5"/>हुकुम क सबंश यो छे कि चुखो मन आरू वारला विवेक, आरू ढोंगी विश्वास छे मोंग पैदा होय। <verse eid="1TI 1:5"/><verse number="6" style="v" sid="1TI 1:6"/>इनको छुड़ीन कोतरा मानसे उधुड़ वाते भुनी बकवाद रयन भटक गया छे। <verse eid="1TI 1:6"/><verse number="7" style="v" sid="1TI 1:7"/>आरू व्यवस्थापक तो होयनो जूवे छे, पर जो वात कयता आरू जिनको ढृढ़ता छे बुलता छे, उनको समझता भी नी।<verse eid="1TI 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8"/>पर हामु जानता छे कि यदि काही व्यवस्था क सही रीति छे काम मा लाया तो वो भली छे। <verse eid="1TI 1:8"/><verse number="9" style="v" sid="1TI 1:9"/>हामु यो जानता छे कि व्यवस्था न्यायी मानसोन करता नी पर अन्यायी, निरंकुशो, भक्तवनो, पापियो, अन्यायी आरू विटळ मानुस, आश बास क घात करनेवावा, हत्यारो। <verse eid="1TI 1:9"/><verse number="10" style="v" sid="1TI 1:10"/>व्यभिचारियो, मानुस गामियो, गुलाम क वेचनेवावा, झूठ बुलनेवावा, आरू झूठी कसम खाने वावा, आरू इनुक छुड़ीन खरी शिक्षा क सब विरोधी सब क करता टाकायली गयली छे। <verse eid="1TI 1:10"/><verse number="11" style="v" sid="1TI 1:11"/>योही सयाळा धन्य यहोवा–भगवान की महिमा क उना खुश खबर क अनसारे छे जो मखे सौप्या गया छे।<verse eid="1TI 1:11"/></para>
  <para style="s">पौलुस क द्वारा यहोवा–भगवान क दया क करता धन्यवाद</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12"/>हाव आपने पोरबु मसीह ईशु क जो मखे शक्ति देदी छे, धन्यवाद करता छे कि त्यो मखे विश्वास योग्य समझीन आपसी सेवा क करता नियुक्त कर्‍या। <verse eid="1TI 1:12"/><verse number="13" style="v" sid="1TI 1:13"/><note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="ACT 8:3">प्रेरितन 8:3</ref>; <ref loc="ACT 9:4">9:4</ref>,<ref loc="ACT 9:5">5</ref></char></note>हाव तो पेहल निन्दा करनेवावा, आरू सतावनेवावा, आरू आँधारलो करनेवावा हुता; तौभी मखे पर दया होयी, काहकि हाव ने विनभुरसा की दशा मा बिन सझीन बूझे यो काम कर्‍या हुता। <verse eid="1TI 1:13"/><verse number="14" style="v" sid="1TI 1:14"/>आरू हामरा पोरबु क फोकटन दया उना विश्वास आरू मोंग क साथे जो मसीह ईशु मा छे, बहुतायत छे होया। <verse eid="1TI 1:14"/><verse number="15" style="v" sid="1TI 1:15"/>यो वात सच्ची आरू हर प्रकार छे मानने क योग्य छे कि मसीह ईशु पापी क उध्दार करने क करता धरती मा आश, जिनमा सब छे मोटा हाव छे। <verse eid="1TI 1:15"/><verse number="16" style="v" sid="1TI 1:16"/>पर मखे पर एरकरीन दया होयी कि मखे सब छे मोटा पापी मा ईशु मसीह आपसी पूरी सहनशीलता देखाय, कि जो मानसे ओको पर अमरकाय जीवन क करता विश्वास करसे तीदरे करता हाव एक नावसादियो बनीस। <verse eid="1TI 1:16"/><verse number="17" style="v" sid="1TI 1:17"/>हिमी सनातन राजा मतलब अमरकाया, विनदेखियो, एकुत् यहोवा–भगवान क विजुत आरू महिमा सदा होयती रये। आमेन।<verse eid="1TI 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18"/>हे पोर्‍या तीमुथियुस, जो वचन की भविष्याव्दाणी जो पेहल तारे विषय मा करी गयी होती, हाव यो हुकुम सौपता छे कि तु वचन क हत्यार क लारे काम मा लावीन वारली बढ़ाई क लड़ता रया। <verse eid="1TI 1:18"/><verse number="19" style="v" sid="1TI 1:19"/>आरू विश्वास आरू ओको वारली विवेक थाहाव रया, जिनाक दूर करने क कारण कोतरा क विश्वास सारको ढोंड्या डूब गया। <verse eid="1TI 1:19"/><verse number="20" style="v" sid="1TI 1:20"/>तीनु मा छे हुमिनयुस आरू अलेक्जेन्द्रिया छे, जीनुक हाव ने शैतान क सौप दिदा छे कि वे यहोवा–भगवान की निन्दा करने नी सीखे।<verse eid="1TI 1:20"/></para>
  <chapter eid="1TI 1"/>
  <chapter number="2" style="c" sid="1TI 2"/>
  <para style="s">प्रार्थना क विषय मा सलाह</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1"/>हिमी हाव सब छे पेहल यो अगवाय करता छे करी रावन्या, आरू प्रार्थना, आरू निवेदन, आरू धन्यवाद सब मानुसो क करता कर्‍या जाय। <verse eid="1TI 2:1"/><verse number="2" style="v" sid="1TI 2:2"/>राजा आरू सब उचा पदवावा क निर्मित एरकरीन कि हामु विश्राम आरू चैन क साथ यहोवा–भगवान क विजुत करता चुखलो जीवन जीवे। <verse eid="1TI 2:2"/><verse number="3" style="v" sid="1TI 2:3"/>यो हामरे उध्दारकरता यहोवा–भगवान क वारू लागतो आरू भाता भी छे। <verse eid="1TI 2:3"/><verse number="4" style="v" sid="1TI 2:4"/>जो यो जूवता छे कि सब मानसे क उध्दार होय, आरू वो सच्चाई क वारू छे जान लेय। <verse eid="1TI 2:4"/><verse number="5" style="v" sid="1TI 2:5"/>काहकि यहोवा–भगवान एक ही छे, आरू यहोवा–भगवान आरू मानुसोन विच मा भी एक ही बिचवई छे, मतलब मसीह ईशु जो मानुस छे। <verse eid="1TI 2:5"/><verse number="6" style="v" sid="1TI 2:6"/>त्यो आपने आप क सब क छुटकारा क दाम मा देय दिदा, आरू ओकी गवा ठीक टेहाव पर देदी गयी। <verse eid="1TI 2:6"/><verse number="7" style="v" sid="1TI 2:7"/><note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="2TI 1:11">2 तीमुथियुस 1:11</ref></char></note>हाव सचो कयता छे, झूठ नी बुलता, कि हाव इनी उद्देश्य छे खबरक आरू प्रेरित आरू गैरयहुदी क करता विश्वास आरू सच्चाई क शिक्षा देने वाळा नियुक्त कर्‍या गया।<verse eid="1TI 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8"/>एरकरीन हाव जूवता छे कि हर धरती मानुस, विना रीस आरू विवाद क चुखलो हात क हुचलीन प्रार्थना कर्‍या करे। <verse eid="1TI 2:8"/><verse number="9" style="v" sid="1TI 2:9"/><note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="1PE 3:3">1 पतरस 3:3</ref></char></note>वोसो बायर भी संका आरू संयम क साथ सुहावने छिन्दरा छे आपने आप क संवारे; नी कि झटा गूंथने आरू सोनो मोती आरू मोंगला छिन्दरा छे। <verse eid="1TI 2:9"/><verse number="10" style="v" sid="1TI 2:10"/>पर वारला काम छे, काहकि यहोवा–भगवान की भक्ति करनेवाळी बायर क योही सही छे। <verse eid="1TI 2:10"/><verse number="11" style="v" sid="1TI 2:11"/>बायर क शांती आरू पूरी हको तळे छे सीखनो जूवे। <verse eid="1TI 2:11"/><verse number="12" style="v" sid="1TI 2:12"/>हाव कयता छे कि बायर नी शिक्षा करे आरू नी मानुस पर हुकुम चालाड़े, पुन चुपचाप रये। <verse eid="1TI 2:12"/><verse number="13" style="v" sid="1TI 2:13"/>काहकि आदम पेहल बनायो गयो, आरू ओका बाद हव्वा बनाय गयी। <verse eid="1TI 2:13"/><verse number="14" style="v" sid="1TI 2:14"/>आरू आदम भड़काव्या नी गया पर बायर भड़कावने मा आवीन यहोवा–भगवान क नियम तुड़ी। <verse eid="1TI 2:14"/><verse number="15" style="v" sid="1TI 2:15"/>तौभी बायर पोर्‍या पैदा क द्वारा उध्दार देखछे, यदि वो सभ्यता सहित विश्वास, मोंग, आरू चुखला मा स्थिर रवे।<verse eid="1TI 2:15"/></para>
  <chapter eid="1TI 2"/>
  <chapter number="3" style="c" sid="1TI 3"/>
  <para style="s">मंडळीन अध्यक्ष</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1"/>यो वात सच्चाई छे कि जो अध्यक्ष हुयने जूवता छे, वो वारलो काम की मरजी करता छे। <verse eid="1TI 3:1"/><verse number="2" style="v" sid="1TI 3:2"/><note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="TIT 1:6-9">तितुस 1:6-9</ref></char></note>यो छाची छे कि मंडळी क मुखी निर्दोष, आरू एक ही बायर क घर वावो, संयमी, सुशील, सभ्य, पाहंनतराय सत्कार करनेवावा, आरू सिखाड़ने मा निपुन होय। <verse eid="1TI 3:2"/><verse number="3" style="v" sid="1TI 3:3"/>पियक्‍कड़ या मारपीट करनेवावा नी होय; वरना कोमल होय, आरू नम्र, आरू दीन होय, आरू नी धन क लालुच होय। <verse eid="1TI 3:3"/><verse number="4" style="v" sid="1TI 3:4"/>आपने घर क वारलो तयारी करता होय, आपसा पोर्‍या पारी क सारी वातड़ी छे हको तळे राखता होय। <verse eid="1TI 3:4"/><verse number="5" style="v" sid="1TI 3:5"/>जव काही आपने घर ही क तयारी करने नी जानता होय, तो यहोवा–भगवान कि मंडळी की राखवावी कोसी करसे। <verse eid="1TI 3:5"/><verse number="6" style="v" sid="1TI 3:6"/>ओवी यो कि नवलो चेलो नी होय, ओसो नी होय कि डाहवाय करीन शैतान क सारको दण्ड देख्या। <verse eid="1TI 3:6"/><verse number="7" style="v" sid="1TI 3:7"/>बाहरतावावा मा भी तेरो सुनाम होय, ओसो नी होय, कि निन्दित हईन शैतान क फांदा मा फंस जाय।<verse eid="1TI 3:7"/></para>
  <para style="s">मंडळी मा साहयक</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8"/>वोसो ही सेवक क भी वारला सभाव क होयनो जूवे, दुय तरफियो जीवन जीवनियो, पियक्‍कड़ आरू नेची कमाय क लोभ नी होय। <verse eid="1TI 3:8"/><verse number="9" style="v" sid="1TI 3:9"/>पर भुरसा क सच्चाई क चुखलो मन छे सुरक्षित राखे। <verse eid="1TI 3:9"/><verse number="10" style="v" sid="1TI 3:10"/>आरू यो भी पेहल पारखे जाय, तव यदि निर्दोष निकवे तो सेवक क काम करे। <verse eid="1TI 3:10"/><verse number="11" style="v" sid="1TI 3:11"/>इनी प्रकार छे बायर क भी वातड़ो हुयने जूवे; दोष लागाड़ने वावी नी होय, पर सचेत आरू सब वात मा भुरसावावो होय। <verse eid="1TI 3:11"/><verse number="12" style="v" sid="1TI 3:12"/>सेवक एक ही बायर क घर वावो होय आरू पोर्‍या पारी आपने घर क वारलो तयारी करने जानता होय। <verse eid="1TI 3:12"/><verse number="13" style="v" sid="1TI 3:13"/>काहकि जो सेवक क काम वारली तरह छे कर सकता छे, वो आपने करता वारलो पद आरू ओको भुरसा मा जो मसीह ईशु पर छे, मोट साहस हासिल करता छे।<verse eid="1TI 3:13"/></para>
  <para style="s">महान रहस्य</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14"/>हाव तारे साथे छाटु आवने की आश राखने पर भी यो वात तुखे हतरान करीन लिखता छे। <verse eid="1TI 3:14"/><verse number="15" style="v" sid="1TI 3:15"/>कि यदि मारे आवने मा देर होय, तो तु जान लेय कि यहोवा–भगवान क घराने मा जो जीवता यहोवा–भगवान की मंडळी छे, आरू जो सच्चाई क खंभा आरू नींव छे, कोसो बर्ताव करनो जूवे। <verse eid="1TI 3:15"/><verse number="16" style="v" sid="1TI 3:16"/>इनामा शक नी कि भक्ति क भेद वातड़ो छे, मतलब</para>
  <para style="q1" vid="1TI 3:16">वो जो डील मा प्रगट होया,</para>
  <para style="q2" vid="1TI 3:16">आत्मा मा न्यायी ठरायु,</para>
  <para style="q1" vid="1TI 3:16">सोरगदूत क देखाय देदो,</para>
  <para style="q2" vid="1TI 3:16">गैरयहुदी मा ओका सच होया,</para>
  <para style="q1" vid="1TI 3:16">धरती मा ओका पर विश्वास कर्‍या गया,</para>
  <para style="q2" vid="1TI 3:16">आरू महिमा ऊपर हाकलिया गया।<verse eid="1TI 3:16"/></para>
  <chapter eid="1TI 3"/>
  <chapter number="4" style="c" sid="1TI 4"/>
  <para style="s">झूठे शिक्षक</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1"/>पुन आत्मा स्पष्टता छे कयती छे कि आवनेवाळा टेहाव मा कोतरा मानसे सची वात छे छेटी ली जानेवावी आत्मा, आरू साहळा की शिक्षा पर मन लागाड़ीन भुरसा छे भड़की जाछे। <verse eid="1TI 4:1"/><verse number="2" style="v" sid="1TI 4:2"/>यो उन झूठा मानुस क कपट क कारण होयछे, जिनका विवेक मर गया छे। <verse eid="1TI 4:2"/><verse number="3" style="v" sid="1TI 4:3"/>जो वियाव करने छे रूकछे, आरू खाने की काही चीज छे छेटा रोवने की हुकुम देसे, जीनुक यहोवा–भगवान ने हेरेन करता बनायो कि विश्वास आरू सच्चाई क उवखनेवावा उको धन्यवाद क साथे खाय। <verse eid="1TI 4:3"/><verse number="4" style="v" sid="1TI 4:4"/>काहकि यहोवा–भगवान की बनावली आखी चीज वारली छे, आरू काही चीज नी मानने क योग्य नी; पर यो कि धन्यवाद क साथे खायो जाय। <verse eid="1TI 4:4"/><verse number="5" style="v" sid="1TI 4:5"/>काहकि यहोवा–भगवान क वचन आरू प्रार्थना क द्वारा चुखली होय जाती छे।<verse eid="1TI 4:5"/></para>
  <para style="s">मसीह ईशु क वारलो सेवक</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6"/>यदि तु भाईस क इन वात की याद देवाड़ता रोवछे, तो मसीह ईशु क वारलो सेवक ठरछे; आरू विश्वास आरू ओको वारलो शिक्षा की वात छे, जो तु मानतो आयो छे, तारो पालन पोषण होयतो रोवछे। <verse eid="1TI 4:6"/><verse number="7" style="v" sid="1TI 4:7"/>पुन भुंडी आरू डुकर्‍या की काहनी छे अलग रया; आरू भक्तिन शिकाड़ने कर। <verse eid="1TI 4:7"/><verse number="8" style="v" sid="1TI 4:8"/>काहकि डीलन करीन काम करने छे कम लाभ हुयसे छे, पर भक्ति सब वात क करता फायदु छे, काहकि इनाक टेहाव क आरू आवनेवाळो जीवन की भी प्रतिज्ञा अतरान करीन छे। <verse eid="1TI 4:8"/><verse number="9" style="v" sid="1TI 4:9"/>यो वात सच्ची आरू हर प्रकार छे मानने योग्य छे। <verse eid="1TI 4:9"/><verse number="10" style="v" sid="1TI 4:10"/>काहकि हामु हावहनत आरू यन्त इनान करीन करता छे कि हामरी आश तीना जीवता यहोवा–भगवान पर छे, जो सब मानुस क आरू खास करीन विश्वास क उध्दारकरता छे।<verse eid="1TI 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11"/>इन वात की हुकुम दे आरू सिकाड़ता रया। <verse eid="1TI 4:11"/><verse number="12" style="v" sid="1TI 4:12"/>कुधु तारी जुवानी क नेची नी समझे; पर वचन, आरू चाल चालन आरू मोंग, आरू विश्वास, आरू चुखलो जीवन मा भुरसा क करता विजुत राखनीया बन जा। <verse eid="1TI 4:12"/><verse number="13" style="v" sid="1TI 4:13"/>जव तक हाव नी आव, तव तक भन्ने आरू शिक्षा देने आरू सिकाड़ने मा लागलो रया। <verse eid="1TI 4:13"/><verse number="14" style="v" sid="1TI 4:14"/>तिना वरदान क प्रति जो तारे मा छे, आरू भविष्यव्दाणी क द्वारा डाहडान हात राखता टेमे तुखे जोड़ल छे, तिना पर ध्यान दे। <verse eid="1TI 4:14"/><verse number="15" style="v" sid="1TI 4:15"/>इन वात क सुचता रया आरू इन्ही मा आपनो ध्यान लागाड़तो रया, ताकि तारी बड़ती आखा पर प्रगट होय। <verse eid="1TI 4:15"/><verse number="16" style="v" sid="1TI 4:16"/>तारी आरू तारो शिक्षा की चोकसी राख इन वात पर बनलो रया, काहकि तव ओसो करतो रोवीस ती तु तारे आरू तारी सोमवनेवावा क करता भी उध्दार क कारण होयछे।<verse eid="1TI 4:16"/></para>
  <chapter eid="1TI 4"/>
  <chapter number="5" style="c" sid="1TI 5"/>
  <para style="s">विश्वासिया क हर जिम्हाववारियां</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1"/>काही डाहला क मानसक लड़े, पर ओको बास जानीन समझाड़ देय, आरू जुवान्या क भाईस जानीन। <verse eid="1TI 5:1"/><verse number="2" style="v" sid="1TI 5:2"/>डाहली बायर क आश जानीन; आरू जुवान बायर क पूरा चुखलो मा बहिनीस जानीन समझाड़ दे।<verse eid="1TI 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3"/>तिनी रंडायली क, जो छाचीत रंडायली छे, विजुत कर। <verse eid="1TI 5:3"/><verse number="4" style="v" sid="1TI 5:4"/>तव कुधु रंडायली क पोर्‍या या नाती पोते होय, तो वो पेहल आपने ही घराने क साथे भक्ति क बर्ताव करने, आरू आपसा आश बास शुरू ओको हक देने सीख्या, काहकि यो यहोवा–भगवान क भाता छे। <verse eid="1TI 5:4"/><verse number="5" style="v" sid="1TI 5:5"/>जो सचमुच रंडायली छे, आरू ओको काही नी, वो यहोवा–भगवान पर आश राखती छे, आरू रात दाहडु रावन्या आरू प्रार्थना मा लौलीन रयती छे। <verse eid="1TI 5:5"/><verse number="6" style="v" sid="1TI 5:6"/>पर जो भोगविलास मा पड़ गयी, वो जीवता जीवीन मर गयी छे। <verse eid="1TI 5:6"/><verse number="7" style="v" sid="1TI 5:7"/>इन वात की भी हुकुम दिया कर काहकि त्यो निर्दोष रोवे। <verse eid="1TI 5:7"/><verse number="8" style="v" sid="1TI 5:8"/>पर यदि काही आपसा की आरू निज करीन आपने घराने की चिंता नी करे, तो वो विश्वास छे मुकर गया छे आरू विनभुरसीया छे भी बुरा बन गया छे।<verse eid="1TI 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9"/>इनी रंडायली क नाव लिख्यो जाय जो साठ साल छे कम की नी होय, आरू एक ही घर वावा की बायर रोवी होय। <verse eid="1TI 5:9"/><verse number="10" style="v" sid="1TI 5:10"/>आरू भले काम मा सुनाम रोवी होय, जिना ने पोर्‍या क पालन पोषण कर्‍या होय पाहंनतराय की सेवा करी होय, चुखलो मानसे क पाय धुवीन होय, दुखियो की मदत करी होय आरू हर एक वारलो काम मा मन लागाड़ ्यो होय।<verse eid="1TI 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11"/>पुन सजुवान रंडायली क नाव नी लिखनो, काहकि जव वो मसीह क विरोध करीन सुख विलास मा पड़ जाती छे तो वियाव करने जूवता छे। <verse eid="1TI 5:11"/><verse number="12" style="v" sid="1TI 5:12"/>आरू दोषी ठेरायती छे, काहकि चे आपने पेहल भुरसा क छुड़ दिदा छे। <verse eid="1TI 5:12"/><verse number="13" style="v" sid="1TI 5:13"/>इनान साथे ही साथे वो घर घर पुगीन आलसी हुयने सीखती छे, आरू केवल आलसी नी पर बकबक करती रयती आरू दिसरा क काम मा हात भी नाखती छे आरू गलत वात बुलती छे। <verse eid="1TI 5:13"/><verse number="14" style="v" sid="1TI 5:14"/>अतरान करीन हाव यो जूवता छे कि जुवान रंडायली वियाव करे, आरू पोर्‍या पैदा आरू घर बार समावे, आरू काही विरोधी क बदनाम करने क मेखे नी देय। <verse eid="1TI 5:14"/><verse number="15" style="v" sid="1TI 5:15"/>काहकि एक तो भड़कीन शैतान क पछव होय त्योकी छे। <verse eid="1TI 5:15"/><verse number="16" style="v" sid="1TI 5:16"/>जेतार काही विश्वास क याहा रंडायली होय, तो चो उनकी मदत करे कि मंडळी पर भार नी होय, ताकि वो उनकी मदत कर सके जो छाचलीत रंडायली छे, मंडळी पर बोध नी नाखे।<verse eid="1TI 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17"/>जो डाहडा वारला तयारी करता छे, खास करीन वो वचन सोमवने आरू सिखने मा हावहनत करता छे, दुय गुना विजुत क योग्य समझे जाय। <verse eid="1TI 5:17"/><verse number="18" style="v" sid="1TI 5:18"/><note caller="+" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="MAT 10:10">मत्ती 10:10</ref>; <ref loc="LUK 10:7">लूका 10:7</ref></char></note>काहकि चुखलो शास्त्र कयता छे, “दांवनेवावा बैल क मुय नी बांधने मजदूर आपसी मजदूरी क हकदार छे।” <verse eid="1TI 5:18"/><verse number="19" style="v" sid="1TI 5:19"/>काही दोष काही डाहडा पर लागाड़ जाय तो बिना दुय या तीन गवा क तीनाक नी सोमव्य। <verse eid="1TI 5:19"/><verse number="20" style="v" sid="1TI 5:20"/>पाप करनेवावा क सब क सामने समझाड़ देय, ताकि आरू मानसे भी बीहये।<verse eid="1TI 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1TI 5:21"/>यहोवा–भगवान, आरू मसीह ईशु आरू त्योने होया सोरगदूत क हजुर जानीन हाव तुखे चेतावनी देता छे कि तु मन उघाड़ीन इन वात क मानीन, आरू काही काम भेदभाव छे नी कर। <verse eid="1TI 5:21"/><verse number="22" style="v" sid="1TI 5:22"/>काही पर शीघ्र हात नी राखने, आरू दिसरा क पाप मा भागी नी हुयने; आपने आप क चुखलो बनाय राख।<verse eid="1TI 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23"/>भविष्य मा केवल पानी ही क पीनेवावा नी रया, पर आपने पेट क आरू आपने बार बार बीमार हुयने क कारण थुड़ा थुड़ा अंगुर क रस भी काम मा लाया करू।<verse eid="1TI 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24"/>काही मानसे क पाप प्रगट होय जाता छे आरू न्याय क करता पेहल छे पुचाड़ जाता छे, पर काही क पछव छे आवता छे। <verse eid="1TI 5:24"/><verse number="25" style="v" sid="1TI 5:25"/>वोसो ही काही भले काम भी प्रगट हुयसे छे; आरू जो ओसो नी हुयसे वो भी डुकाय नी सकता।<verse eid="1TI 5:25"/></para>
  <chapter eid="1TI 5"/>
  <chapter number="6" style="c" sid="1TI 6"/>
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1"/>जोतरा मानसोन क जुवड़ो क नेचो छे, वो आपने आपने भगवान क मोटो विजुत क योग्य जाने, ताकि यहोवा–भगवान क नाव आरू शिक्षा की निन्दा नी होय। <verse eid="1TI 6:1"/><verse number="2" style="v" sid="1TI 6:2"/>जिदरा भगवान विश्वास छे तीनुक वो भाईस हुयने क कारण तुच्छ नी जाने, बाकुन तीनदरी आरू भी सेवा करे, काहकि इनासे लाभ उठाड़नेवावा विश्वास आरू मोंगावु छे। इन वात क शिक्षा कर्‍या कर आरू समझातो रया।<verse eid="1TI 6:2"/></para>
  <para style="s">झूठी शिक्षा आरू धन क लोभ</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3"/>जेतार काही आरू ही प्रकार क शिक्षा देता छे आरू सची वात क, मतलब आमरो पोरबु ईशु मसीह की वात क आरू ओको शिक्षा क नी मानतो, जो भक्ति क लारे छे। <verse eid="1TI 6:3"/><verse number="4" style="v" sid="1TI 6:4"/>तो वो डाहवाळों होय गया, आरू काही नी जानतो वरना ओको विवाद आरू ओवाज तर्क करने क बीमार छे, जिनान डाहवाय आरू झगड़ो आरू निन्दा बुरे बुरे संका। <verse eid="1TI 6:4"/><verse number="5" style="v" sid="1TI 6:5"/>आरू उन मानुस मा व्यर्थ रगड़े झगड़े पैदा हुयसे छे जिनकी बुध्दि बिगड़ गयी छे, आरू वो सच्चाई छे भटक गया छे, जो समझता छे कि भक्ति कमाय क व्दरा छे।<verse eid="1TI 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6"/>पर सन्तोष सहित भक्ति मोटी कमाय छे। <verse eid="1TI 6:6"/><verse number="7" style="v" sid="1TI 6:7"/>काहकि नी हामु धरती मा काही लाया छे आरू नी काही ली जाय सकता छे। <verse eid="1TI 6:7"/><verse number="8" style="v" sid="1TI 6:8"/>यदि हामरे साथे खाने आरू पेहरने क होय, तो इन्ही पर सन्तोष करनो जूवे। <verse eid="1TI 6:8"/><verse number="9" style="v" sid="1TI 6:9"/>पर जो धनी हुयने जूवता छे, वो ओसी परीक्षा आरू फांदा आरू घोणा सी व्यर्थ आरू हानिकारक लालस मा फंसता छे, जो मानुस क बिगाड़ देता छे आरू विनाश क दरिया मा डुबा देती छे। <verse eid="1TI 6:9"/><verse number="10" style="v" sid="1TI 6:10"/>काहकि पयसियान लालच आखी बुराई न मुव छे, जिनाक हासिल करने क कोशिष करता होया घोणा ने भूरसो छे भटकीन आपने आप क हरेक प्रकार क दुःख मा फसाय लेदा छे।<verse eid="1TI 6:10"/></para>
  <para style="s">तीमुथियुस क व्यक्तिगत निर्देश</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11"/>पर हे यहोवा–भगवान क जन, तु इन वात छे भाग आरू न्यायपन, भक्ति, भूरसो, मोंग, धीरज आरू नम्रता क पीछा कर। <verse eid="1TI 6:11"/><verse number="12" style="v" sid="1TI 6:12"/>विश्वास की वारली कुश्ती लड़ाय आरू ओको अमरकाय जीवन क धर लेय, जिदरे करता तु बुलाया गया आरू घोणा छे गवा क सामने वारली पछतायो कर्‍या हुता। <verse eid="1TI 6:12"/><verse number="13" style="v" sid="1TI 6:13"/><note caller="+" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JHN 18:37">यहुन्ना 18:37</ref></char></note>हाव तुखे यहोवा–भगवान क, जो सब क जीवता राखतो छे, आरू मसीह ईशु क गवाय करीन जा पुन्तियुस पिलातुस क अगो वारलो पछतायो कर्‍या, यो हुकुम देता छे। <verse eid="1TI 6:13"/><verse number="14" style="v" sid="1TI 6:14"/>कि तु हामरे पोरबु ईशु मसीह क प्रगट हुयने तक इनी हुकुम क निष्कलंक आरू निर्दोष राख। <verse eid="1TI 6:14"/><verse number="15" style="v" sid="1TI 6:15"/>जिनान वो ठीक टेहाव पर देखाड्यो, जो सयाळा धन्य आरू एकुत् अधिपति आरू राजा क राजा आरू पोरबु क पोरबु छे। <verse eid="1TI 6:15"/><verse number="16" style="v" sid="1TI 6:16"/>आरू अमरकाय डील केवल ओकी छे, आरू वो विनदेखियो दिवा मा रयता छे, आरू नी ओको काही मानुस ने देखा आरू नी कदी देख सकता छे, ओकी मान मर्‍यादा आरू राज अमरकाय युगानयुग रवछे। आमेन<verse eid="1TI 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17"/>इनी संसार क धनवान क हुकुम देदी कि वो डाहवाळा नी होय आरू खाटळो धन पर आश नी राखे, काहकि यहोवा–भगवान पर जो हामरा सुख क करता सब काही बहुतायत छे देता छे। <verse eid="1TI 6:17"/><verse number="18" style="v" sid="1TI 6:18"/>वो भलो करे, आरू वारला काम मा धनी बने, आरू उदार आरू मदत देने मा तत्पर होय। <verse eid="1TI 6:18"/><verse number="19" style="v" sid="1TI 6:19"/>आरू ओगव क करता एक वारली नींव नाख राखे कि सचो जीवन क वश मा कर लेय।<verse eid="1TI 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20"/>हे तीमुथियुस, इनीये धरोहर की राखवावी कर; आरू जिनूक ज्ञान कयनो ही भूल छे, ओको विटळ बकवाद आरू विरोध की वात छे बाहर रये। <verse eid="1TI 6:20"/><verse number="21" style="v" sid="1TI 6:21"/>कोतरा इनीये ज्ञान क पछतायो करीन भुरसा सी भटक गया छे। तुमू पर फोकटन दया होतो रये।<verse eid="1TI 6:21"/></para>
  <chapter eid="1TI 6"/>
</usx>
