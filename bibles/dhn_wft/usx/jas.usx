<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JAS" style="id">– Dhankavi</book>
  <para style="h">याकूब</para>
  <para style="toc3">याकूब</para>
  <para style="toc2">याकूब</para>
  <para style="toc1">याकूब नी लिखली पत्री</para>
  <para style="mt2">याकूब कि लिखी हुई पत्री</para>
  <para style="mt1">याकूब नी लिखली पत्री</para>
  <para style="imt">परिचय</para>
  <para style="ip">याकूब कि पत्री पोरबु ईशु मसीह क दास याकूबन द्वारा लिखली छे। आरू यो कि याकूब ईशु मसीह क भाईस भी कयता छे; जो कि यरूशलेम की मंडळी क अगूवो होतो। <char style="xt"><ref loc="ACT 15:13">प्रेरितन 15:13</ref></char> आरू प्रेरित पौलुस ने ओको फिलिप्पियो की मंडळी क स्तम्भ कयता छे। <char style="xt"><ref loc="GAL 2:9">गलातिया 2:9</ref></char> विद्वान क यो माननो छे कि याकूब की किताब ईशु मसीहन जनमक लग–भग 50 साल बाद लिखली छे। काहकि याकूब यरूशलेम क मंडळी अगळवानिया होतो आरू यो पत्री ओको यरूशलेम मा रयने क टेहाव मा लिखली छे।</para>
  <para style="ip">याकूब की पत्री तीनुन बारा अवळियाद क मतलब यहोवा–भगवान क मानसे क लिखली गयी छे। <char style="xt"><ref loc="JAS 1:1">1:1</ref></char> आरू याकूब की पत्री क पाठक्रम आखा मसीह भाईस आरू बहनीस पर लागु करने क बारा मा कयी विषय सम्बोधित कर्‍या छे। विशेष करीन याकूब तीनु यहूदि विश्वास भाईस आरू बहनीस क विश्वास रूपी जीवन आरू वारली चाल चालने आरू ओवाज क सही ढंग छे प्रयोग करने क बारा मा चेतावनी देतो छे। <char style="xt"><ref loc="JAS 2:17">2:17</ref></char> काहकि इन पत्री मा कयी विषयन बारा मा लिखली छे, आरू इन पाठकन आखा गर्दी <char style="xt"><ref loc="JAS 2:1-4">2:1-4</ref></char>तक पुचाड़ गया जो भन्नेवावा पाठ क हुता। <char style="xt"><ref loc="JAS 3:1-12">3:1-12</ref></char></para>
  <para style="is">रूप रेखा</para>
  <para style="io1">1. याकूब मा आपसा पाठ क बधाई देनो छे। <char style="ior"><ref loc="JAS 1:1">1:1</ref></char></para>
  <para style="io1">2. मसीह भाईस आरू बहनीस क जुर देवाड़ करो, जो बीमार होय <char style="ior"><ref loc="JAS 1:2-27">1:2-27</ref></char></para>
  <para style="io1">3. तव त्यो कयो, यो भी जरूरी छे, कि काम क द्वारा भुरसा क देखाड़ जाय। <char style="ior"><ref loc="JAS 2:1-26">2:1-26</ref></char></para>
  <para style="io1">4. कोसो शक्तिशाली वचन होय सकतो छे? <char style="ior"><ref loc="JAS 3:1-12">3:1-12</ref></char></para>
  <para style="io1">5. याकूब कयता छे, कोसो यहोवा–भगवान क ज्ञान दुनिया क ज्ञान छे अलग छे <char style="ior"><ref loc="JAS 3:13-4:10">3:13–4:10</ref></char></para>
  <para style="io1">6. याकूबन डाहवाळा क खिलाफ आपने पाठ क चेतावनी देने। <char style="ior"><ref loc="JAS 4:11-5:6">4:11–5:6</ref></char></para>
  <para style="io1">7. याकूब क सामान्य निर्देश द्वारा पत्री की समाप्ती <char style="ior"><ref loc="JAS 5:7-20">5:7-20</ref></char></para>
  <chapter number="1" style="c" sid="JAS 1" />
  <para style="s">नमस्कार</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:55">मत्ती 13:55</ref>; <ref loc="MRK 6:3">मरकुस 6:3</ref>; <ref loc="ACT 15:13">प्रेरितन 15:13</ref>; <ref loc="GAL 1:19">गलातिया 1:19</ref></char>
    </note>यहोवा–भगवान क आरू पोरबु ईशु मसीह क दास याकूबन चा रयन जिनु बारा अवळियाद क जो तितर बितर हईन रयता छे नमस्कार।<verse eid="JAS 1:1" /></para>
  <para style="s">विश्वास आरू बुध्दि</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2" />हे मारा भाईस, आरू बहनीस जव तुमू हरेक प्रकार की परीक्षा मा पड़ो, तो इनुक पूरो खुशी की वात समझु। <verse eid="JAS 1:2" /><verse number="3" style="v" sid="JAS 1:3" />काहकि तुमू जानता छे कि जव तुमरू विश्वास पारखायने सी गम पैदा हुये, ते परिणाम यो सहन करनेन ताकत छे; <verse eid="JAS 1:3" /><verse number="4" style="v" sid="JAS 1:4" />पर धीरज क आपसा पूरो काम करने देवु कि तुमू पूरे आरू सिध्द होय जाय, आरू तुमू मा काही वात की घटी नी रये।<verse eid="JAS 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 1:5" />पुन जेतार तुमू मा छे काही क बुध्दि की घटी होय तो यहोवा–भगवान छे मांग, जो बिना दोष दिदा सब क किरपा छे देता छे, आरू ओको देदी जाछे। <verse eid="JAS 1:5" /><verse number="6" style="v" sid="JAS 1:6" />पर विश्वास छे मांगे आरू काही संका नी करे, काहकि संका करनेवावा दरिया की लहरे क समान छे जो वाहवा सी उहवती आरू उछलती रये। <verse eid="JAS 1:6" /><verse number="7" style="v" sid="JAS 1:7" />ओसो मानुस यो नी समझे कि मखे पोरबु छे काही मिवछे, <verse eid="JAS 1:7" /><verse number="8" style="v" sid="JAS 1:8" />वो व्यक्ति दुचिता छे आरू आपसी सारी वात मा खाटळो छे।<verse eid="JAS 1:8" /></para>
  <para style="s">गरीब आरू मालदार</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9" />विश्वासी गरीब भाईस आपसा उंचा पद पर खुश रोवे। <verse eid="JAS 1:9" /><verse number="10" style="v" sid="JAS 1:10" />आरू धनवान आपसी नेची दशा पर खुशी करनो जूवे; काहकि वो खोड़ो क फूल की तरह जाता रोवछे। <verse eid="JAS 1:10" /><verse number="11" style="v" sid="JAS 1:11" />काहकि दाहडु उग हुयसे ही वातड़ी धूप पड़ती छे आरू खोड़ो क सुखाड़ देती छे, आरू तेरो फूल झड़ जाता छे आरू ओकी शोभा जाती रयती छे। इनीये प्रकार धनवान भी आपनो व्यवसाय करता धरतीम मिव जाछे।<verse eid="JAS 1:11" /></para>
  <para style="s">पारख आरू प्रलोभन</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12" />धन्य वो मानुस जो परीक्षा मा स्थिर रयता छे, काहकि वो सचा निकवीन जीवन क वो मुकट देखे जेरो प्रतिज्ञा पोरबु ने आपने मोंग करनेवावा छे की छे। <verse eid="JAS 1:12" /><verse number="13" style="v" sid="JAS 1:13" />जव काही की परीक्षा होय, तो वो यो नी कये कि मारी परीक्षा यहोवा–भगवान की आरू छे होयती छे काहकि नी तो बुरी वात छे यहोवा–भगवान की परीक्षा होय सकती छे। <verse eid="JAS 1:13" /><verse number="14" style="v" sid="JAS 1:14" />पुन हर एक व्यक्ति आपसी ही लालोच छे हापकीन आरू फंसकर परीक्षा मा पड़ता छे। <verse eid="JAS 1:14" /><verse number="15" style="v" sid="JAS 1:15" />पछु लालोच भारीस हईन पाप क जानती छे आरू पाप जव बढ़ जाता छे तो मरला क पैदा करता छे।<verse eid="JAS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16" />हे मारा मोंगावु भाईस, धोखा नी खावु। <verse eid="JAS 1:16" /><verse number="17" style="v" sid="JAS 1:17" />काहकि हर एक खरी दान ऊपर ही छे, आरू दिवा क बास की आरू छे मिवता छे, जिनाम नी तो काही बदलाव होय सकता छे। <verse eid="JAS 1:17" /><verse number="18" style="v" sid="JAS 1:18" />यहोवा–भगवान ने आपसी ही मरजी छे हामु सच्चाई क वचन क द्वारा पैदा कर्‍या, ताकि हामु ओकी सृष्टी करी होयी समान मा छे एक प्रकार क पेहलो फोव होय।<verse eid="JAS 1:18" /></para>
  <para style="s">सोमवने आरू करने</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19" />हे मारा मोंगावु भाईस, आरू बहनीस यो वात तुमू जान लेवु: हर एक मानुस सोमवने क करता तत्पर आरू बुलने मा धीरो आरू रीस मा धीमा होय। <verse eid="JAS 1:19" /><verse number="20" style="v" sid="JAS 1:20" />काहकि मानुस रीस यहोवा–भगवान क न्यायपन उध्देश हासिल नी कर सकता। <verse eid="JAS 1:20" /><verse number="21" style="v" sid="JAS 1:21" />एरकरीन सारी मलिनता आरू बैर भाव की बढ़ती क दूर करीन, उना वचन क नम्रता छे मान्य कर लेवु जो दिल मा वेर्‍या गया आरू जो तुमरे जीव क उध्दार कर सकता छे।<verse eid="JAS 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22" />पुन वचन पर चालनेवावा बनु, आरू केवल सोमवनेवावा ही नी जो आपने आप क धोखा देता छे। <verse eid="JAS 1:22" /><verse number="23" style="v" sid="JAS 1:23" />काहकि जो काही वचन क सोमवनेवावा होय आरू ओको पर चालनेवावा नी होय, तो ओको मानुस क सामने छे जो आपसा स्वभाविक मुय आरसा देखता छे। <verse eid="JAS 1:23" /><verse number="24" style="v" sid="JAS 1:24" />एरकरीन कि वो आपने आप क देखीन चाल जाता आरू तत्काल भुल जाता छे कि हाव कोसो होतो। <verse eid="JAS 1:24" /><verse number="25" style="v" sid="JAS 1:25" />पुन जो व्यक्ति स्वतंत्रता की सिध्द व्यवस्था पर ध्यान करता रयता छे, वो आपने काम मा एरकरीन बरकत देखछे कि सोमवीन भुलता नी पर वोसो ही काम करता छे।<verse eid="JAS 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26" />यदि काही आपने आप क भक्त समझे आरू आपसी जीभ पर लगाम नी देय पर आपसा दिल क धोखा देय, तो ओकी भक्ति व्यर्थ छे। <verse eid="JAS 1:26" /><verse number="27" style="v" sid="JAS 1:27" />हामरा यहोवा–भगवान आरू बास क निकट चुखो आरू निर्मल भक्ति यो छे कि विखाळा आरू रंडायली क तकलीद मा ओकी सुधि लेय, आरू आपने आप क संसार छे निष्कलंक राखे।<verse eid="JAS 1:27" /></para>
  <chapter eid="JAS 1" />
  <chapter number="2" style="c" sid="JAS 2" />
  <para style="s">भेदभाव क विरोध चेतावनी</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1" />हे मारा भाईस, हामरा महिमायुक्त पोरबु ईशु मसीह पर तुमरो विश्वास भेदभाव क साथे नी होय। <verse eid="JAS 2:1" /><verse number="2" style="v" sid="JAS 2:2" />काहकि जेतार एक मानुस सोनो छल्लो आरू घाटळो लुगड़ा पेहर्‍या होया तुमरी सभा आश, आरू एक गरीब भी किटायला, कुचवायला लुगड़ा पेहर्‍या होया आश। <verse eid="JAS 2:2" /><verse number="3" style="v" sid="JAS 2:3" />आरू तुमू ओको घाटळो लुगड़ा क मुय देखीन कोवु, “वाँ वारली धरतीम बठ्या” आरू उना गरीब छे कोवु, “तु याहा उबा रोव” या मारा पाय क साथे बठ्या। <verse eid="JAS 2:3" /><verse number="4" style="v" sid="JAS 2:4" />तो काय तुमू ने आपस मा संका नी कर्‍या आरू बुरे विचार छे न्याय करनेवावा नी ठराय?<verse eid="JAS 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5" />हे मारा मोंगावु भाईस, सोमवु। काय यहोवा–भगवान ने इनीये धरती क गरीब क नी निवाड़या कि विश्वास मा धनी आरू ओको राज्य क हक होय, जेरी प्रतिज्ञा ओको ने उनछे करी छे जो ओका सी मोंग राखता छे? <verse eid="JAS 2:5" /><verse number="6" style="v" sid="JAS 2:6" />पुन तुमू ने ओको गरीब क विजुत कर्‍या। काय धनी मानसे तुमू पर वेला नी पाड़े आरू काय वो ही तुमूक कचहरियो मा घसड़ी–घसड़ीन नी ली जाय? <verse eid="JAS 2:6" /><verse number="7" style="v" sid="JAS 2:7" />काय वो ओको वारलो नाव की निन्दा नी करता जिनाक तुमू कोवायता छे?<verse eid="JAS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8" />तौभी तुमू पवित्रशास्त्र इनीये वचन क लारे कि “तु आपसा धड़ेवावा छे आपने समान मोंग राख” सचमुच ओको राज व्यवस्था पूरी करता होय, तो वारला ही करता होय। <verse eid="JAS 2:8" /><verse number="9" style="v" sid="JAS 2:9" />पर यदि तुमू भेदभाव करता होय तो पाप क दोषी होय; आरू व्यवस्था तुमूक गुणेगार ठेरायती छे। <verse eid="JAS 2:9" /><verse number="10" style="v" sid="JAS 2:10" />काहकि जो काही सारी व्यवस्था क पालन करता छे पुन एक ही वात मा चूक जाय तो वो सब वात मा दोषी ठराय त्योकी छे। <verse eid="JAS 2:10" /><verse number="11" style="v" sid="JAS 2:11" />अतरान करीन कि जो यो कयो, “तु व्यभिचार नी करने” तीनी ने यो भी कयो, “हत्या नी करने” एरकरीन यदि तु व्यभिचार तो नी कर्‍या पर हत्या की तौभी तु व्यवस्था क तुड़नो करनेवावा ठेराया। <verse eid="JAS 2:11" /><verse number="12" style="v" sid="JAS 2:12" />तुमू उन मानसे क समान वचन बुले आरू काम भी करू जिनका न्याय स्वतंत्रता की व्यवस्था क लारे होयछे। <verse eid="JAS 2:12" /><verse number="13" style="v" sid="JAS 2:13" />काहकि जो दया नी करी, ओको न्याय विना दया क होयछे: निर्दयी, न्याय पर जयवन्त होयती छे।<verse eid="JAS 2:13" /></para>
  <para style="s">विश्वास आरू काम</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14" />हे मा भाईस यदि काही कये कि मखे विश्वास छे पर वो काम करता होय, तो इनासे काय लाभ? काय ओसो विश्वास कदी ओको उध्दार कर सकता छे? <verse eid="JAS 2:14" /><verse number="15" style="v" sid="JAS 2:15" />यदि काही भाईस आरू बहिनीस नांगरला उघाड़ला होय आरू हर दाहडु भोजन की घटी होय। <verse eid="JAS 2:15" /><verse number="16" style="v" sid="JAS 2:16" />आरू तुमू मा छे काही उनछे कये, “कुशल छे जावु, तुमू गरम रवु आरू तृप्त रवु” पर जो समान डील क करता छाची छे वो इनुक नी देय तो काय लाभ? <verse eid="JAS 2:16" /><verse number="17" style="v" sid="JAS 2:17" />वोसो ही विश्वास भी, यदि काम सहित नी होय तो आपसा स्वभाव मा मरला हुयो छे।<verse eid="JAS 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18" />वरना काही कय सकता छे, “तुखे विश्वास छे आरू हाव काम करता छे।” आपसा विश्वास मखे काम बिना तो देखाय; आरू हाव आपसा विश्वास आपने कामो क द्वारा तुखे आपाड़ीस। <verse eid="JAS 2:18" /><verse number="19" style="v" sid="JAS 2:19" />काय तुखे विश्वास छे कि एक ही यहोवा–भगवान छे; तु वारलो करता छे। साहळा भी विश्वास राखता, आरू थरथराता छे। <verse eid="JAS 2:19" /><verse number="20" style="v" sid="JAS 2:20" />पर हे निकम्मी मानुस काय तु यो भी नी जानता कि काम बिना विश्वास व्यर्थ छे। <verse eid="JAS 2:20" /><verse number="21" style="v" sid="JAS 2:21" />जव हामरा बास अब्राहम ने आपनो पोर्‍य इसहाक क वेदी पर चढ़ाया, तो काय वो कामो छे न्यायी नी ठेराया हुता? <verse eid="JAS 2:21" /><verse number="22" style="v" sid="JAS 2:22" />शेवली कावा तु ने देख लेदा कि विश्वास ने ओका काम छे विश्वास सिध्द होया। <verse eid="JAS 2:22" /><verse number="23" style="v" sid="JAS 2:23" />आरू चुखलो शास्त्र क यो वचन पूरो होया: “अब्राहम ने यहोवा–भगवान क विश्वास कर्‍या, आरू यो ओका करता न्यायी गिना गया” आरू वो यहोवा–भगवान क दोस्त कोवायता। <verse eid="JAS 2:23" /><verse number="24" style="v" sid="JAS 2:24" />इनीये प्रकार ने देख लेदा कि मानुस केवल विश्वास छे ही नी, वरना कामो छे भी न्यायी ठेरायता छे।<verse eid="JAS 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25" />वोसो ही राहाब वेश्या भी, जव त्यो क आपने घर मा उतरीया आरू दीसर मार्ग छे विदा कर्‍या, तो काय कामो छे न्यायी नी ठराय।<verse eid="JAS 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26" />शेवली कावा जोसो देह आत्मा विना मरी होयी छे, वोसी ही विश्वास भी काम विना मर्‍या होया छे।<verse eid="JAS 2:26" /></para>
  <chapter eid="JAS 2" />
  <chapter number="3" style="c" sid="JAS 3" />
  <para style="s">जीभ क वश मा करने</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1" />हे मारा भाईस, आरू बहनीस तुमू मा छे घोणा शिक्षक नी बने, काहकि जानता होय कि हामु शिक्षक आरू भी दोषी ठेरायछे। <verse eid="JAS 3:1" /><verse number="2" style="v" sid="JAS 3:2" />अतरान करीन कि हामु सब घोणा कावा चूक जानता छे; जो काही वचन मा नी चूकता चो तो सिध्द मानुस छे आरू सारी देह पर भी लगाम लागाड़ सकता छे। <verse eid="JAS 3:2" /><verse number="3" style="v" sid="JAS 3:3" />जव हामु आपसा वश मा करने क करता घुल्लान मुय मा लगाम लागाड़जे ती हामु ओका सब डील क फेरवी सकजे। <verse eid="JAS 3:3" /><verse number="4" style="v" sid="JAS 3:4" />देखु ढोंड्या भी, यदि ओसो मोटो होयतो छे आरू बैस हवा छे चालाड़ जातो छे, तवभी एक नानी सी पतवार क द्वारा मांझी की मरजी क लारे घुमायो जाए। <figure style="fig" alt="Rider on a horse" file="lb00035c।tif" size="col" copy="Horace Knowles ©" ref="3:3">घुल्ला पर बठनारो</figure><verse eid="JAS 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 3:5" />वोसो ही जीभ एक नानो सा डील छे आरू वो मोटी मोटी डीगे मारती छे। देखु, थुड़ी सी आगठी छे कोतरा मोटा जोन्गोल मा आगठो लाग जातो छे। <verse eid="JAS 3:5" /><verse number="6" style="v" sid="JAS 3:6" />जीभ भी एक आगठो छे; जीभ हामरे डील मा अन्याय क एक मानसे छे, आरू सारी देह पर गुणो लागाड़ ती छे, आरू जीवन गती मा आगठो लागाड़ देती छे, आरू नरक कुण्डा की आगठा छे धपती रयती छे। <verse eid="JAS 3:6" /><verse number="7" style="v" sid="JAS 3:7" />काहकि हर प्रकार क वन मा वाळा जनवार चिल्ला, आरू रेंगनेवावा जन्तु, आरू जलचर तो मानुस जाति क वश मा होय सकता छे आरू होय भी गया छे। <verse eid="JAS 3:7" /><verse number="8" style="v" sid="JAS 3:8" />पुन जीभ क मानुस मा छे काही वश मा नी कर सकता; वो एक ओसी बला छे जो कदी रूकती ही नी, वो जीव नाशक विष छे भरी होयी छे। <verse eid="JAS 3:8" /><verse number="9" style="v" sid="JAS 3:9" />इनी मा रयन छे हामु पोरबु आरू बास की बढ़ाई करता छे, आरू इनी छे मानुस क जो यहोवा–भगवान क स्वरूप मा पैदा होया छे शाप देता छे। <verse eid="JAS 3:9" /><verse number="10" style="v" sid="JAS 3:10" />एक ही मुय छे धन्यवाद आरू शाप दुयू निकवता छे। हे मारा भाईस ओसो नी होयनो जूवे। <verse eid="JAS 3:10" /><verse number="11" style="v" sid="JAS 3:11" />काय सुवता क एक ही मुय छे गुव्वो आरू खारलो पानी दुयू निकवता छे। <verse eid="JAS 3:11" /><verse number="12" style="v" sid="JAS 3:12" />हे मारा भाईस, काय अंजीर क झाड़का मा जैतुन या अंगुर क रस की सोता मा अंजीर लाग सकता छे? वोसो ही खारे सुवता छे गुव्वो पानी नी निकव सकतो।<verse eid="JAS 3:12" /></para>
  <para style="s">सोरगन बुध्दि</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13" />तुमू मा बुध्दिवान आरू समझदार कुन छे? जो ओसो होय वो आपसा काम क वारली चाल–चलन छे ओको नम्रता सहित प्रगट करे जो ज्ञान छे पैदा होयती छे। <verse eid="JAS 3:13" /><verse number="14" style="v" sid="JAS 3:14" />पुन जेतार तुमू आपसा–आपसा मन मा कड़वी किचवाय आरू विरोध राखता होय, तो सच्चाई क विरोध मा डाहळाय नी करने आरू, नी तो झूठ बुलने। <verse eid="JAS 3:14" /><verse number="15" style="v" sid="JAS 3:15" />यो ज्ञान वो नी जो ऊपर छे उतरता छे, वरना सांसारिक, आरू डीलन अनसारे, आरू शैतान सी आवे। <verse eid="JAS 3:15" /><verse number="16" style="v" sid="JAS 3:16" />काहकि वा किचवाय आरू विरोध हुयसे छे, वाँ बखेड़ा आरू हर प्रकार क दुष्कर्म भी हुयसे छे। <verse eid="JAS 3:16" /><verse number="17" style="v" sid="JAS 3:17" />पुन जो ज्ञान ऊपर छे आवतो छे वो पेहल तो चुखलो होयतो छे पछु मिलनसार, कोमल आरू मृदुभाव आरू दया वारलो फोव छे लदा होया आरू भेदभाव आरू कपट रहित हुयसे छे। <verse eid="JAS 3:17" /><verse number="18" style="v" sid="JAS 3:18" />मिलाप करावनेवाळा न्यायपन क फोव मेलमिलाप क साथे वेरता छे।<verse eid="JAS 3:18" /></para>
  <chapter eid="JAS 3" />
  <chapter number="4" style="c" sid="JAS 4" />
  <para style="s">संसार छे दोस्तता</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1" />तुमू मा लड़ाई आरू झगड़ा कयो छे आय गया? काय उन सुख विलास छे लालोच छे नी आवतो जो तुमरा डील मा लड़ता भिड़ता छे? <verse eid="JAS 4:1" /><verse number="2" style="v" sid="JAS 4:2" />तुमू लालसा राखता होय, आरू तुमूक मिवता नी; अतरान करीन तुमू हत्या करता होय, आरू तुमू डाह करता होय, आरू काही हासिल नी कर सकता; तो तुमू झगड़ता आरू लड़ायता होय। तुमू एरकरीन नी मिवता काहकि वो यहोवा–भगवान छे कि मांगता नी। <verse eid="JAS 4:2" /><verse number="3" style="v" sid="JAS 4:3" />मांगता होय आरू देखता नी, अतरान करीन कि बुरी मरजी छे मांगता होय ताकि आपनो सुख विलास मा उड़ाय देवु। <verse eid="JAS 4:3" /><verse number="4" style="v" sid="JAS 4:4" />हे व्यभिचारिणियो, काय तुमू नी जानती कि संसार सी साथ सोंगात करनो यहोवा–भगवान छे बैर करनो छे? शेवली कावा जो काही संसार क दोस्त होयनो जूवत छे, वो आपने आप क यहोवा–भगवान क दुस्मन बनावतो छे। <verse eid="JAS 4:4" /><verse number="5" style="v" sid="JAS 4:5" />काय तुमू यो समझता होय कि चुखलो शास्त्र व्यर्थ कयता छे, जिना आत्मा क त्यो हामरा माहीय बसाड्या छे, काय वो ओसी लालस करता छे जेरो हर फोव डाह होय? <verse eid="JAS 4:5" /><verse number="6" style="v" sid="JAS 4:6" />वो तो आरू भी फोकटन दया देता छे; इनीये कारण यो लिख्यो छे, “यहोवा–भगवान डाहवाळिया क विरोध करता छे, पर दाहड़ा पर फोकटन दया करता छे।”<verse eid="JAS 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7" />एरकरीन यहोवा–भगवान क हको तळे होय जावु; आरू शैतान क सामना करू, तो वो तुमरे साथे छे ढास गयो। <verse eid="JAS 4:7" /><verse number="8" style="v" sid="JAS 4:8" />यहोवा–भगवान क निकट आवु तो वो भी तुमरे निकट आवसे। हे पापी, आपसा हात चुखो करू; आरू हे दुचित्ते मानछे, आपसा दिल क चुखलो करू। <verse eid="JAS 4:8" /><verse number="9" style="v" sid="JAS 4:9" />दुःखी होय, आरू शोक करू, आरू रडु। तुमरी हासी शोक मा आरू तुमरा खुशी उदासी मा बदल जाय। <verse eid="JAS 4:9" /><verse number="10" style="v" sid="JAS 4:10" />पोरबु क सामने दाहड़ा बन तो वो तुमूक उचा उठावसे।<verse eid="JAS 4:10" /></para>
  <para style="s">भाईस पर दोष लागाड़ ने</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11" />हे भाईस, एक दिसरा की बदनामी नी करू। जो आपसा भाईस की बदनामी करता छे या भाईस पर दोष लागड़ता छे, वो व्यवस्था की बदनामी करता छे आरू व्यवस्था पर दोष लागाड़ता छे; आरू यदि तु व्यवस्था पर चालनेवावा नी पर ओको पर सरदार ठराय। <verse eid="JAS 4:11" /><verse number="12" style="v" sid="JAS 4:12" />व्यवस्था देनेवावा आरू सरदार तो एक ही छे, जो वाचाड़ने आरू नाश करने मा समर्थ छे। पर तु कुन छे, जो आपसा धड़ेवावा पर न्याय करता छे?<verse eid="JAS 4:12" /></para>
  <para style="s">डाहळाय क विरोध चेतावनी</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13" />तुमू जो यो कयता होय, आज या काल हामु काही आरू नगर मा जाईन वाँ एक साल देखाड़े, आरू व्यापारी करीन लाभ कमायसे। <verse eid="JAS 4:13" /><verse number="14" style="v" sid="JAS 4:14" />आरू यो नी जानता कि काल काय? तुमू तो बाप क समान होय, जो थुड़ी देर देखाय देती छे पछु लोप होय जाती छे। <verse eid="JAS 4:14" /><verse number="15" style="v" sid="JAS 4:15" />ओका उलटो तुमू यो कयनो जूवे, “यदि पोरबु जूवे तो हामु जीवता रोवसु, आरू यो वो काम भी करसु।” <verse eid="JAS 4:15" /><verse number="16" style="v" sid="JAS 4:16" />पर हिमी तुमू आपसा डींग मारता होय आरू डाहळाय करता होय; ओसो सब डाहळाय बुरा हुयसे छे। <figure style="fig" alt="Customer, merchant with his wares" file="hk00172c।tif" size="col" copy="Horace Knowles ©" ref="4:13">लेनेवावु गिराक आरू बेपारी आपना बजार क लिन </figure><verse eid="JAS 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17" />एरकरीन जो काही भलाई करने जानता छे आरू नी करता, ओका करता यो पाप छे।<verse eid="JAS 4:17" /></para>
  <chapter eid="JAS 4" />
  <chapter number="5" style="c" sid="JAS 5" />
  <para style="s">धनवानो क चेतावनी</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1" />हे धनवानो, सोमवी लेवु तुमू आपसा–आपसा आवनेवाळा दुःख पर आयड़ी आयड़ीन रोडु। <verse eid="JAS 5:1" /><verse number="2" style="v" sid="JAS 5:2" /><note caller="+" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="MAT 6:19">मत्ती 6:19</ref></char></note>तुमरो धन बिगड़ गयो छे आरू तुमरा लुगड़ा क कीड़ा खाय गया छे। <verse eid="JAS 5:2" /><verse number="3" style="v" sid="JAS 5:3" />तुमरो सोनो चाँदी मा काही लाग गयो छे; आरू वो काही तुमू पर गवा देसे, आरू आगठो क समान तुमरा मास खाय जाछे। <verse eid="JAS 5:3" /><verse number="4" style="v" sid="JAS 5:4" />देखु, जिन दाहडक्या ने तुमरा खेत काटे, उनकी वो दाहडक्या जो तुमू ने धुको दीन राख लेदा छे आयड़ी रोवी छे, आरू लावनेवावा की दोहाई छेना क पोरबु क कान्टा तक पुचाड़ गयी छे। <verse eid="JAS 5:4" /><verse number="5" style="v" sid="JAS 5:5" />तुमू धरती पर भोग; तुमू ने इनीये वध क दाहड़ो क करता आपसा दिल मा पालन पुषण करीन ओको मोटा ताजा कर्‍या। <verse eid="JAS 5:5" /><verse number="6" style="v" sid="JAS 5:6" />तुमू ने न्यायी क दोषी ठेरावीन मार नाख्या, वो तुमरो सामना नी करे।<verse eid="JAS 5:6" /></para>
  <para style="s">दुःख मा धीरज धरने</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7" />अतरान करीन हे भाईस, पोरबु क आवनो तक धीरज धरू। देखु, किरसान धरती की मोंगलो कमाय की आश राखता होया पेहलो आरू आखरी साल हुयने तक धीरज धरती छे। <verse eid="JAS 5:7" /><verse number="8" style="v" sid="JAS 5:8" />तुमू भी धीरज धरू आपसा दिल क दृढ़ करू, काहकि पोरबु क आवनो निकट छे।<verse eid="JAS 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9" />हे भाईस, आरू बहनीस एक दिसरा पर दोष नी लागाड़ ु, ताकि तुमू दोषी नी ठराय; देखु, सरदार झोपला पर उबो छे। <verse eid="JAS 5:9" /><verse number="10" style="v" sid="JAS 5:10" />हे भाईस, जिन कागळिया ने पोरबु क नाव छे वात करी उनको दुःख उठाड़ने आरू धीरज धरने क एक विजुत करो। <verse eid="JAS 5:10" /><verse number="11" style="v" sid="JAS 5:11" />देखु हामु धीरज धरनेवावा क धन्य कयता छे। तुम ने अय्यूब न धीरज क विषय मा ते सोमव्या छे, आरू पोरबु की आरू छे जो ओको हर फोव हुयो ओको भी जान लेदा छे, जिनासे पोरबु की घण करूणा आरू दया प्रगट होयती छे।<verse eid="JAS 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:12 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:34-37">मत्ती 5:34-37</ref>
      </char>
    </note>पर हे मारा भाईस, आरू बहनीस सब स्रेष्ठ वा त यो छे कि शपथ नी खाय नी सोरग की, नी धरती की, नी काही आरू समान की, पर तुमरी वातचीत हव ते हव, आरू नी की नी होय, कि तुमू दण्ड क योग्य नी ठराय।<verse eid="JAS 5:12" /></para>
  <para style="s">प्रार्थना की शक्ति</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13" />यदि तुमू मा काही दुःख छे, तो वो प्रार्थना करू। यदि खुशी छे, ते चाँ बढ़ाई क भोजन गावे। <verse eid="JAS 5:13" /><verse number="14" style="v" sid="JAS 5:14" /><note caller="+" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="MRK 6:13">मरकुस 6:13</ref></char></note>यदि तुमू मा काही बीमार छे, तो मंडळी क डाहडा क बुलाय, आरू वो पोरबु क नाव छे ओको पर तेल मल कर ओका करता प्रार्थना करू। <verse eid="JAS 5:14" /><verse number="15" style="v" sid="JAS 5:15" />आरू विश्वास की प्रार्थना क द्वारा बीमार वाच जाछे आरू पोरबु ओको उठाड़ीन उबा करसे; आरू यदि त्यो पाप भी कर्‍या होय तो उन की भी माफ होय जाछे। <verse eid="JAS 5:15" /><verse number="16" style="v" sid="JAS 5:16" />एरकरीन तुमू आपस मा एक दिसरा क सामने आपसा–आपसा पाप क मान लेवु, आरू एक दिसरा क करता प्रार्थना करू, जिना छे वारू होय जावु: न्यायीजन की प्रार्थना क शक्ति छे घोणा काही होय सकता छे। <verse eid="JAS 5:16" /><verse number="17" style="v" sid="JAS 5:17" />एलियाह भी तो हामरा समान दुःख सुख भोगी मानुस हुता; आरू त्यो गिड़ गिड़ाकर प्रार्थना करी की हावह नी बरछे; आरू साड़े तीन साल तक धरती पर हावह नी बरसा। <verse eid="JAS 5:17" /><verse number="18" style="v" sid="JAS 5:18" />फछो त्यो प्रार्थना करी, तो आकाश छे साल होयी, आरू धरती फलवंत होयी।<verse eid="JAS 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19" />हे मारा भाईस, यदि तुमू मा काही सच्चाई क मार्ग छे भटक जाय आरू काही ओको क पोछा लाया लावे। <verse eid="JAS 5:19" /><verse number="20" style="v" sid="JAS 5:20" /><note caller="+" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="1PE 4:8">1 पतरस 4:8</ref></char></note>तो वो यो जान लेवु कि जो काय काही भटके हुयो पापी क फेर लागाड़ छे वो एक जीव क मरन छे वाचाड़छे आरू काहय करीन पाप पर परदा नाखछे।<verse eid="JAS 5:20" /></para>
  <chapter eid="JAS 5" />
</usx>