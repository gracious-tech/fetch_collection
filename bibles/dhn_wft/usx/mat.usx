<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MAT" style="id">– Dhankavi</book>
  <para style="h">मत्ती</para>
  <para style="toc3">मत्ती</para>
  <para style="toc2">मत्ती</para>
  <para style="toc1">मत्ती नी किताब</para>
  <para style="mt2">मत्ती कि किताब</para>
  <para style="mt1">मत्ती नी किताब</para>
  <para style="imt">परिचय</para>
  <para style="ip">मत्ती न लिखली खुशीन खबर नया नियमन चार किताबो माईन एक छे, जो ईशु मसीहन क जीवनन बारा मा देखाड़े, इनी चार किताब माईन यी एक खुशीन खबर न पत्री कहवाये। एक मतलब इनी चारो माईन एक खुश खबर कहवाये, ईशु क सोरग मा जाने क बाद मा यी किताब मत्ती, मरकुस, लूका आरू यहुन्ना या लिखिया, मत्तीन किताब कब लिखाय ओको पतो विद्वान लोगहन क भी नी मालोम हय। तव भी हामु यो कय सकजे, कि यी किताब ईशु क पैदा हुयनेन 60 साल क बाद मा लिखयाली छे।</para>
  <para style="ip">इनिये रीति सी यी क लिखाय, यो मालोम नी हय पछु भी कोय जना क यो माननो छे कि यी किताब पलिस्तिम मा नी ते यरूशलेम मा लिखाय हुयसे। इनी पत्री क लिखने वाळो मत्ती छे, जो ईशु क पेहलो चेलो हुतो आरू त्यो फाळो लेने वाळो हुतो। आरू उको लेवी क नाव सी जानता हुता, मत्ती ईशुन बारा चेला माईन एक हुतो आरू त्यो यी पत्री यहूदि लोगहन क करता लिखियो हुतो। इना कारण सी हामु देखजे कि इनी किताब मा 60 से भी जादा वातन क बाराम पुराना नियम सी छे, जिनान बाराम भविष्यवाणी हुयली हुती, त्यो यो देखड़नो चाह्यो रियो कि छुड़वाने वाळो छे, मत्ती यहोवा भगवान क राजन बारा मा घण सवटी वात लिखलो छे, यहूदि यान यी आश हुती कि मसीह राजा बनसे मत्ती इना वाचिर क विश्वास देवाडीन यहोवा भगवान क आखरी राजन बारा मा कहवे।</para>
  <para style="ip">मत्तीन खुश खबर यी एक वारली किताब छे, यी नवला नियमन शुरू वाळी किताब छे आरू यी हामरो धियान बार–बार पुराना नियम तरफ ली जाय, यी किताब पुराना आरू नवला नियम दूयन क जोड़ देय, विद्वान लोगहन क यो कयनो छे, कि मूसान लिखला पाच गरन्थ छे, जो पुराना नियम नी पाच किताब छे, आरू ओकी सोहलाणी क बारा मा देखाड़े जो ईशु बयड़ा पर खबर दियो, पाठ <char style="xt"><ref loc="MAT 5-7">5–7</ref></char> तक एकी बराबरी कर सके, <char style="xt"><ref loc="DEU 19:3-23:23">व्यवस्थाविवरण 19:3–23:23</ref></char></para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. ईशु क जनम आरू ओकी सेवान शुरू सी मत्ती ओको खुश खबर शुरू करे। <char style="ior"><ref loc="MAT 1-4">1–4</ref></char></para>
  <para style="io1">2. ओका बाद ईशुन सेवा क बारा मा जीनी वातन शिकापण दियो, ओका बारा मा देखाड़े। <char style="ior"><ref loc="MAT 5-25">5–25</ref></char></para>
  <para style="io1">3. मत्तीन खुश खबर यी आखरी भाग मा ईशुन सेवा काम क देखाड़े जिनाम जोरदीन बयड़ा क मतलब ओकी मोत आरू पछु सी जीव उठनेन बाराम देखाड़े। <char style="ior"><ref loc="MAT 26-28">26–28</ref></char></para>
  <chapter number="1" style="c" sid="MAT 1"/>
  <para style="s">ईशुन पिढ़ी</para>
  <para style="r">(<ref loc="LUK 3:23-38">लूका 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1"/>अब्राहम न ओवलियाद, दाऊद न ओवलियाद, ईशु मसीह न घरानो <verse eid="MAT 1:1"/><verse number="2" style="v" sid="MAT 1:2"/>अब्राहम सी इसहाक पैदा हुयो, इसहाक सी याकूब पैदा हुयो, याकूब सी यहूदा पैदा हुयो आरू उको भाई पैदा हुया। <verse eid="MAT 1:2"/><verse number="3" style="v" sid="MAT 1:3"/>यहूदा आरू तामार सी पेरेस आरू जेरह पैदा हुया, आरू पेरेस सी हेसरोन पैदा हुयो, आरू हेस्रोन सी एराम पैदा हुयो। <verse eid="MAT 1:3"/><verse number="4" style="v" sid="MAT 1:4"/>एराम सी अम्मीनादाब, अम्मीनादाब सी नहशोन, नास्सोन सी सलमोन <verse eid="MAT 1:4"/><verse number="5" style="v" sid="MAT 1:5"/>सलमोन सी राहाब, राहाब सी बोआज, बोआज आरू रूत सी ओबेद, ओबेद सी यिशै पैदा हुयो, <verse eid="MAT 1:5"/><verse number="6" style="v" sid="MAT 1:6"/>आरू यिशै सी दाऊद राजा पैदा हुयो।</para>
  <para style="p" vid="MAT 1:6">आरू दाऊद सी सुलैमान जो उनी बायर सी पैदा हुयो जो पेहल उरिय्याह न बायर हुती, <verse eid="MAT 1:6"/><verse number="7" style="v" sid="MAT 1:7"/>सुलैमान सी रहबाम पैदा हुयो, रहबाम सी अबियाह पैदा हुयो, आरू अबियाह सी आसा पैदा हुयो, <verse eid="MAT 1:7"/><verse number="8" style="v" sid="MAT 1:8"/>आसा सी यहोशाफात पैदा हुयो, यहोशाफात सी योराम पैदा हुयो, आरू योराम सी उज्जियाह पैदा हुयो, <verse eid="MAT 1:8"/><verse number="9" style="v" sid="MAT 1:9"/>उज्जियाह सी योथाम पैदा हुयो, योथाम सी आहाज उज्जियाह हुयो, आरू आहाज सी हिजकिय्याह पैदा हुयो, <verse eid="MAT 1:9"/><verse number="10" style="v" sid="MAT 1:10"/>हिजकिय्याह सी मनश्शे पैदा हुयो, मनश्शेह सी आमोन पैदा हुयो, आरू आमोन सी योशियाह पैदा हुयो: <verse eid="MAT 1:10"/><verse number="11" style="v" sid="MAT 1:11"/>आरू बन्दी बनीन बेबीलोन जाने क टेमे योशियाह सी यकुन्याह आरू ओको भाई पैदा हुया।<verse eid="MAT 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12"/>बन्दी बनीन बेबीलोन मा जाने क बाद यकुन्याह सी शालतियेल पैदा हुयो, आरू शालतियेल सी जरूब्बाबेल पैदा हुयो, <verse eid="MAT 1:12"/><verse number="13" style="v" sid="MAT 1:13"/>जरूब्बाबेल सी अबीहूद पैदा हुयो, अबीहूद सी एलयाकीम पैदा हुयो, आरू एलयाकीम सी अजोर पैदा हुयो, <verse eid="MAT 1:13"/><verse number="14" style="v" sid="MAT 1:14"/>अजोर सी सदोक पैदा हुयो, सदोक सी अखीम पैदा हुयो, आरू अखीम सी एलीहूद पैदा हुयो, <verse eid="MAT 1:14"/><verse number="15" style="v" sid="MAT 1:15"/>एलीहूद सी एलीयाजार पैदा हुयो, एलीयाजार सी मत्तान पैदा हुयो, आरू मत्तान सी याकूब पैदा हुयो, <verse eid="MAT 1:15"/><verse number="16" style="v" sid="MAT 1:16"/>याकूब सी यूसुफ पैदा हुयो, जो मरियम न धेनी हुतो, आरू मरियम सी ईशु जो मसीह कहवाये, पैदा हुयो।<verse eid="MAT 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17"/>इनिये रीति अब्राहम सी दाऊद तक चौवदा पीढ़ी हुयी, आरू दाऊद सी लगाड़ीन बेबीलोन क बन्दी बनीन जाने तक चौवदा पीढ़ी, आरू बन्दी बनीन बेबीलोन क जाने तक लगाड़ीन मसीह तक चौवदा पीढ़ी हुयी।<verse eid="MAT 1:17"/></para>
  <para style="s">ईशु क जनम</para>
  <para style="r">(<ref loc="LUK 2:1-7">लूका 2:1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18"/>ईशु मसीह न जनम इनीये प्रकार सी हुयो, कि जव ओकी माय मरियम की मांगनी यूसुफ क साथ हय गयी, तो ओको एखठा हयने सी पेहल ही त्या चुखली आत्मा क लारे भारीस हुयी। <verse eid="MAT 1:18"/><verse number="19" style="v" sid="MAT 1:19"/>अळतेन ओको घर वाळो यूसुफ जो न्यायी हुतो आरू उको बदनाम नी करने हीनतो हुतो? उको मनेन छुड़ देने न विचार कर्‍यो। <verse eid="MAT 1:19"/><verse number="20" style="v" sid="MAT 1:20"/>जव युसूफ इनी वात क विचार मा हुतो ती पोरबु सोरगदूत सपना मा देखाय दीदो आरू कयने लाग्यो, “हे यूसुफ! दाऊद न अवळियाद, तु थारी लाड़ी मरियम क थारे या ली आवने सी मा घाबराये, काहकि जो ओका पेट मा छे, त्यो चुखली आत्मा क लारे छे। <verse eid="MAT 1:20"/><verse number="21" style="v" sid="MAT 1:21"/><note caller="+" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="LUK 1:31">लूका 1:31</ref></char></note>मरियम पोर्‍या क जनम देसे आरू तु ओको नाव ईशु राखजी, काहकि त्यो ओका लोगहन क पाप सी छुड़वासे।”<verse eid="MAT 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22"/>यो सब अतरान करीन हुयो कि जो वचन पोरबु कागळिया क लारे हुतो, त्यो पूरो हुयो:<note caller="+" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="ISA 7:14">यशायाह 7:14</ref></char></note> <verse eid="MAT 1:22"/><verse number="23" style="v" sid="MAT 1:23"/>“देखु एक छल्ली भारीस हुयसे आरू एक पोर्‍या क जनम देसे, आरू ओको नाव इम्मानुएल राखसे” जेरो मतलब छे यहोवा–भगवान हामरे साथ छे <verse eid="MAT 1:23"/><verse number="24" style="v" sid="MAT 1:24"/>तव यूसुफ नींद सी जागीन पोरबु न सोरगदूत क लारे आपसी लाड़ी क आपसे या ली आयो; <verse eid="MAT 1:24"/><verse number="25" style="v" sid="MAT 1:25"/>आरू जव तक मरियम पोर्‍या क नी जनी तव तक युसूफ मरियम क पास मा नी गियो: आरू त्यो ओको नाव ईशु राखिया।<verse eid="MAT 1:25"/></para>
  <chapter eid="MAT 1"/>
  <chapter number="2" style="c" sid="MAT 2"/>
  <para style="s">ज्ञानी क आवनो</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1"/>ईशु क जनम हेरोदेस राजा क दाहड़ा मा जव यहूदि या क बैतलहम नगर मा हुयो, ती पारखे सी जानकार लोगहन यरूशलेम मा आवीन पूछने लाग्या, <verse eid="MAT 2:1"/><verse number="2" style="v" sid="MAT 2:2"/>“त्यो बाळो जेरो जनम हुयो काँ छे? जो यहूदि या न राजा हुयसे, काहकि हामु पूर्व मा ओको तारा देख्या छे आरू ओको नमस्कार करने आयो छे।”<verse eid="MAT 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3"/>यो सोमवीन हेरोदेस राजा आरू ओको साथ मा सब यरूशलेम घबराय गियो। <verse eid="MAT 2:3"/><verse number="4" style="v" sid="MAT 2:4"/>तव त्यो लोगहन क सब डाहला पुजारा आरू शास्त्री क एखठा बुलावी उन लोगहन सी पुछा, “मसीह क जनम हईन जुवे?”<verse eid="MAT 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5"/>त्या ओका सी कयो, “यहूदिया क बैतलहम मा, काहकि भविष्यवक्ता क द्वारा यो लिख्यो गयो छे:<verse eid="MAT 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6"/>“हे बैतलहम, तु जो यहूदा क प्रदेश मा छे,</para>
  <para style="q2" vid="MAT 2:6">तु काही भी रीति छे यहूदा क हकी मा आखा सी नानो नी;</para>
  <para style="q1" vid="MAT 2:6">काहकि थारे मा सी एक अधिपति निकळसे,</para>
  <para style="q2" vid="MAT 2:6">जो मारी प्रजा इस्राएल की राखवावी करसे।”<verse eid="MAT 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7"/>तव हेरोदेस ने ज्ञानी क मनेन छे बुलावी उनछे पूछा कि तारा ठीक काही टेहाव देखाय दिदो होतो, <verse eid="MAT 2:7"/><verse number="8" style="v" sid="MAT 2:8"/>आरू त्यो यो कोवीन तीनुक बैतलहम मुकल्यो, “जावु, उना पोर्‍या क बारा मा ठीक–ठीक मालम करो, आरू जव त्यो मिव जाय तो मखे खबर देवु ताकि हाव भी आवीन ओको नमस्कार करीस।”<verse eid="MAT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9"/>त्यो राजा की वात सोमवीन चाली गयो, आरू जो तारा त्या पूर्व मा देख्या हुता त्यो ओको ओगव–ओगव चाल्या; आरू वा पोर्‍या होतो। उना जागाम क ऊपर पुचीन ठेहर गया। <verse eid="MAT 2:9"/><verse number="10" style="v" sid="MAT 2:10"/>उना थारा क देखीन त्यो घण खुश होया। <verse eid="MAT 2:10"/><verse number="11" style="v" sid="MAT 2:11"/>त्या उना घर मा पुच्चा उना पोर्‍या क ओकी माय मरियम क साथे देख्या, आरू मुय क बल झुकीन पोर्‍या क नमस्कार कर्‍या, आरू आपसा–आपसा थैला उघाड़ी ओको सोनो, चाँदी, आरू लोबान, आरू गन्धरस की भेंट चढ़ाया। <figure style="fig" alt="Frankincense branch, censer and incense altar" file="bk00116c.tif" size="col" copy="Horace Knowles ©" ref="2:11">लोबान डाव, धुप दानी क आरू धुप वेदी</figure><verse eid="MAT 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12"/>तव सपना मा यो चेतावनी देखीन कि हेरोदेस क साथे पछु नी जाने, त्यो दीसरे मार्ग सी आपसा देश क चाली गया।<verse eid="MAT 2:12"/></para>
  <para style="s">मिस्र देश क जाने</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13"/>ओको चाली जाने क बाद पोरबु क एक सोरगदूत ने सपनो मा यूसुफ क देखाय दिदो काँ, “उठ उना पोर्‍या क आरू ओकी माय क ली मिस्र देश क ढास जाय; आरू जव तक हाव तुखे छे नी कहवो, तव तक वा रहवजी; काहकि हेरोदेस इना पोर्‍या क हेरने वाळो छे कि ओको मारीन नाखने।”<verse eid="MAT 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14"/>तव त्यो रात ही क उठीन पोर्‍या आरू ओकी माय क ली मिस्र देश क चाल दिदा, <verse eid="MAT 2:14"/><verse number="15" style="v" sid="MAT 2:15"/>आरू हेरोदेस क मरना तक त्योही रया। एरकरीन कि त्यो वचन प्रभु न भविष्यवक्ता न लारे होतो पूरो होय: “हावने आपने पोर्‍या क मिस्र देश बुलाया।”<note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="HOS 11:1">होशे 11:1</ref></char></note><verse eid="MAT 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16"/>जव हेरोदेस ने यो देख्य कि ज्ञानी ने ओको साथे धोखा कर्‍या छे, तव त्यो रीस छे भर गया, आरू लोगहन क मुकली ज्ञानी द्वारा ठीक–ठिक देखाड्या गया, आरू टेहाव क लारे बैतलहम आरू ओको धोड़े साथे क स्थानो क सब पोर्‍या क जो दुय साल क या ओका सी नानो होतो, मार नाखु।<verse eid="MAT 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 2:17"/>तव जो वचन यिर्मयाह भविष्यवक्ता क द्वारा कयो गया होतो, त्यो पूरो हुयनो:<verse eid="MAT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18"/>“रामाह मा एक दुःख भरियो शब्द सोमवाय दिदो,</para>
  <para style="q2" vid="MAT 2:18">रोड़ने आरू मोटो विलाप;</para>
  <para style="q1" vid="MAT 2:18">राहेल आपने पोर्‍या क करता रोड़ी रयी होती,</para>
  <para style="q2" vid="MAT 2:18">आरू शांत हुयने नी जुवती होती,</para>
  <para style="q2" vid="MAT 2:18">काहकि त्यो हिमी नी रया।”<note caller="+" style="x"><char style="xo" closed="false">2:18 </char><char style="xt" closed="false"><ref loc="JER 31:15">यिर्मयाह 31:15</ref></char></note><verse eid="MAT 2:18"/></para>
  <para style="s">मिस्र देश छे पोछा पुगनेन</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19"/>हेरोदेस क मरना क बाद, पोरबु सोरगदूत मिस्र मा यूसुफ क सपनो मा देखाय दिदो कयो, <verse eid="MAT 2:19"/><verse number="20" style="v" sid="MAT 2:20"/>“उठ पोर्‍या आरू ओकी माता क ली इस्राएल क देश मा चाली जा, काहकि जो पोर्‍या क जीव लेने जुवता हुता, त्यो मर गया छे।” <verse eid="MAT 2:20"/><verse number="21" style="v" sid="MAT 2:21"/>त्यो उठ्यो आरू पोर्‍या आरू ओकी माय क साथे लीन इस्राएल क देश मा आयो।<verse eid="MAT 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22"/>पुन यो सोमवीन कि अरखिलाउस आपसा बास हेरोदेस की जागाम यहूदि या पर राज्य कर रया छे, वाँ जाने छे घाबराय। पछु सपना मा यहोवा–भगवान छे चेतावनी देखीन गलील प्रदेश मा चाली गया, <verse eid="MAT 2:22"/><verse number="23" style="v" sid="MAT 2:23"/><note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MRK 1:24">मरकुस 1:24</ref>; <ref loc="LUK 2:39">लूका 2:39</ref>; <ref loc="JHN 1:45">यहुन्ना 1:45</ref></char></note>आरू नासरत नावको नगर मा जाय बठ्या, ताकि त्यो वचन पूरो होय, जो भविष्यवक्ता क द्वारा कयो गया होतो: “त्यो नासरी कहवासे।”<note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="LUK 18:7">लूका 18:7</ref></char></note><verse eid="MAT 2:23"/></para>
  <chapter eid="MAT 2"/>
  <chapter number="3" style="c" sid="MAT 3"/>
  <para style="s">यहुन्ना बपतिस्मा देनेवात्यो</para>
  <para style="r">(<ref loc="MRK 1:1-8">मरकुस 1:1-8</ref>; <ref loc="LUK 3:1-18">लूका 3:1-18</ref>; <ref loc="JHN 1:19-28">यहुन्ना 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1"/>उन दाहड़ा मा यहुन्ना बपतिस्मा देनेवालो आवीन यहूदि या क जंगल मा यो खबर करने लाग्या: <verse eid="MAT 3:1"/><verse number="2" style="v" sid="MAT 3:2"/><note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="MAT 4:17">मत्ती 4:17</ref>; <ref loc="MRK 1:15">मरकुस 1:15</ref></char></note>“पापो सी मन फिरावो काहकि सोरग क राज्य नाट आव गयो छे।”<verse eid="MAT 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 3:3"/>यो त्यो आय, तेखा बाराम यशायाह कागळियान क लारे करियो:</para>
  <para style="q2" vid="MAT 3:3">“जंगल मा एक आयड़नेवावा क ओवाज होय रयो,</para>
  <para style="q2" vid="MAT 3:3">कि पोरबु क मार्ग तीयार करू, ओकी सड़के सुधी करू।”<note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">यशायाह 40:3</ref></char></note><verse eid="MAT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4"/>बपतिस्मा देनेवावु यहुन्ना उटड़ान झटा बनलो छिंदरा पेहरलो हुतो, आरू ओकी कमर मा चामड़ा क पट्टो बांधलो हुतो। त्यो खानो टिड्डिया आरू बयड़ाक माहव हुतो। <note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 राजा 1:8</ref></char></note> <verse eid="MAT 3:4"/><verse number="5" style="v" sid="MAT 3:5"/>तव यरूशलेम आरू आखा यहूदिया, आरू यरदन क आड़ी छेड़ी क मानसे ओको साथे निकवीन माय। <verse eid="MAT 3:5"/><verse number="6" style="v" sid="MAT 3:6"/>त्या आपसा–आपसा पाप क मानीन यरदन नदी मा यहुन्ना सी बपतिस्मा लेदा।<verse eid="MAT 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:7 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:34">मत्ती 12:34</ref>; <ref loc="MAT 23:33">23:33</ref></char>
    </note>जव त्यो घोणा छे फरीसिया आरू सदूकियो बपतिस्मा लेने करता आपने साथे आवता देख्या, तो उनछे कयो, “हे घड़साक पोर्‍या, तुमू कुन चेतावनी देदा कि यहोवा भगवान क आवनेवाळा रीस छे ढासु? <verse eid="MAT 3:7"/><verse number="8" style="v" sid="MAT 3:8"/>एरकरीन मन फिराव क योग्य फोव लावु; <verse eid="MAT 3:8"/><verse number="9" style="v" sid="MAT 3:9"/><note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="JHN 8:33">यहुन्ना 8:33</ref></char></note>आरू आपसा–आपसा मन मा यो नी सुचिया कि आमरो बास अब्राहम छे; काहकि हाव तुमू छे कयता छे कि यहोवा–भगवान इनु दगड़ा सी अब्राहम क करता संतान पैदा कर सकता छे। <verse eid="MAT 3:9"/><verse number="10" style="v" sid="MAT 3:10"/><note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="MAT 7:19">मत्ती 7:19</ref></char></note>हिमी कुराड़ झाड़का की मुव पर धरा छे, एरकरीन जो–जो झाड़को फोव नी लावता, त्यो काट्यो दियो जासे आरू आगठो मा न्हाख दियो जासे। <verse eid="MAT 3:10"/><verse number="11" style="v" sid="MAT 3:11"/>हाव ते पानी छे तुमूक मन फिराव क यहुन्ना बपतिस्मा देतो छे, पुन जो मारे बाद आवने वालो छे, त्यो मखे छे शक्तिशाली छे; हाव ओका खासड़ा उठावने क योग्य भी नी हय। त्यो तुमूक चुखली आत्मा छे बपतिस्मा आपसे। <verse eid="MAT 3:11"/><verse number="12" style="v" sid="MAT 3:12"/>ओका सूप उना क हात मा छे, आरू त्यो आपसा खलिहान वारली रीति छे साफ करसे, आरू आपसा गहू क तो कुठार मा एखठा करसे, पुन भुसा क ओको आगठो मा धपाड़छे जो उलायने की नी।”<verse eid="MAT 3:12"/></para>
  <para style="s">यहुन्ना द्वारा ईशु क बपतिस्मा</para>
  <para style="r">(<ref loc="MRK 1:9-11">मरकुस 1:9-11</ref>; <ref loc="LUK 3:21-22">लूका 3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13"/>उना टेमे ईशु गलील से यरदन नदी क धोड़े बपतिस्मा देनेवावो यहुन्ना क जु बपतिस्मा लेने करीन आयो। <verse eid="MAT 3:13"/><verse number="14" style="v" sid="MAT 3:14"/>पुन यहुन्ना यो कय कर ओको रूकने लाग्या, “मखे तो थारा हात छे बपतिस्मा लेने की जरूरत छे, आरू तु मार पास आय रियो?”<verse eid="MAT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15"/>ईशु ने ओको यो जवाब दिया, “हिमी तो ओसो ही हुयने दे, काहकि हामु इनी रीति छे सब न्यायपन क पूरो करने वारू छे।”<verse eid="MAT 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16"/>आरू ईशु बपतिस्मा लीन तत्काल पानी मा छे ऊपर आयो, आरू देख्या, ओका करता सोरग उघड़ी गयो, आरू त्यो यहोवा–भगवान क आत्मा क पेरवाक समान उतरता आरू आपसा ऊपर आवता देख्या। <verse eid="MAT 3:16"/><verse number="17" style="v" sid="MAT 3:17"/><note caller="+" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="MAT 12:18">मत्ती 12:18</ref>; <ref loc="MAT 17:5">17:5</ref>; <ref loc="MRK 1:11">मरकुस 1:11</ref>; <ref loc="LUK 9:35">लूका 9:35</ref></char></note>आरू सोरगवाणी हुयो, “यो म्हारो मोंगावु पोर्‍या छे, जिना क हाव खुश छे।”<verse eid="MAT 3:17"/></para>
  <chapter eid="MAT 3"/>
  <chapter number="4" style="c" sid="MAT 4"/>
  <para style="s">ईशु न परीक्षा</para>
  <para style="r">(<ref loc="MRK 1:12-13">मरकुस 1:12-13</ref>; <ref loc="LUK 4:1-13">लूका 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:1 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 2:18">इब्रानियों 2:18</ref>; <ref loc="HEB 4:15">4:15</ref></char>
    </note>तव आत्मा ईशु क जंगल मा ली गया ताकि शैतान छे ओकी परीक्षा होय। <verse eid="MAT 4:1"/><verse number="2" style="v" sid="MAT 4:2"/>त्यो चावीस दाहड़ा, आरू चावीस रात, भुखलो रयो, तव ओको भुख लागी। <verse eid="MAT 4:2"/><verse number="3" style="v" sid="MAT 4:3"/>तव पारखनेवावा ने साथे आवीन ओको छे कयो, “यदि तु यहोवा–भगवान क पोर्‍या छे, तो कय दे, कि यो दगड़ा रोटा बन जाय।”<verse eid="MAT 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4"/>ईशु जवाब दिदो: “लिखलो छे, ‘मानुस केवल रोटा छे नी, पुन हर एक वचन छे जो यहोवा–भगवान क मुख छे निकवता छे, जीवतो रवछे।’”<verse eid="MAT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5"/>तव आत्मा शैतान ओको चुखलो नगर मा ली गया आरू मंदिर क कातर पर उबो कर्‍या, <verse eid="MAT 4:5"/><verse number="6" style="v" sid="MAT 4:6"/>आरू ओका सी कयो, “यदि तु यहोवा–भगवान क पोर्‍या छे, तो तु या सी कुद जा” काहकि लिखलो छे:</para>
  <para style="q2" vid="MAT 4:6">“यहोवा–भगवान थारा बारा मा आपने सोरगदूत क हुकुम देसे, आरू त्यो तुखे हातो–हात उठायली जासे;</para>
  <para style="q2" vid="MAT 4:6">काही ओसी नी होय कि थारा पाय मा दगड़ा सी ठेस नी लागे।”<note caller="+" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">भजन संहिता 91:11-12</ref></char></note><verse eid="MAT 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7"/>ईशु ने ओका सी कयो, “यो भी लिखलो छे: तु पोरबु आपने यहोवा–भगवान की परीक्षा नी करे।”<verse eid="MAT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8"/>पछु शैतान ओको एक घोणा उचा बयड़ा पर ली गयो आरू सब जग क राज्य आरू ओका राज देखाड़ी <verse eid="MAT 4:8"/><verse number="9" style="v" sid="MAT 4:9"/>ओका सी शैतान कयो, “यदि तु पाये टेकीन नमस्कार करे, तो हाव यो सब काही तुखे आपी देस।”<verse eid="MAT 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10"/>तव ईशु ने ओका सी कयो, “हे शैतान दूर होय जा, काहकि लिखलो छे: तु पोरबु आपने यहोवा–भगवान क नमस्कार कर, आरू केवल ओकी उपासना कर।”<note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="DEU 6:13">व्यवस्थाविवरण 6:13</ref></char></note><verse eid="MAT 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11"/>तव शैतान ओका साथे छे जात रयी, आरू देखु, सोरगदूत आवीन ओकी सेवा करने लाग्या।<verse eid="MAT 4:11"/></para>
  <para style="s">ईशु क सेवा काम क शुरू</para>
  <para style="r">(<ref loc="MRK 1:14-15">मरकुस 1:14-15</ref>; <ref loc="LUK 4:14-15">लूका 4:14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:12 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 14:3">मत्ती 14:3</ref>; <ref loc="MRK 6:17">मरकुस 6:17</ref>; <ref loc="LUK 3:19">लूका 3:19</ref>,<ref loc="LUK 3:20">20</ref></char>
    </note>जव त्यो यो सोमव्य कि बपतिस्मा देनेवावो यहुन्ना क बंदी बनाय लेदा गया छे, तो त्यो गलील क जात रयो। <verse eid="MAT 4:12"/><verse number="13" style="v" sid="MAT 4:13"/><note caller="+" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="JHN 2:12">यहुन्ना 2:12</ref></char></note>आरू त्यो नासरत क छुड़ीन कफरनहूम नगर मा गया, जो नदी धोड़े जबूलून आरू नप्ताली क देश मा छे, जाय रयने लाग्यो; <verse eid="MAT 4:13"/><verse number="14" style="v" sid="MAT 4:14"/>ताकि जो यशायाह कागळिया क द्वारा कयो गया होतो, त्यो पूरो होय:<verse eid="MAT 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15"/>जबूलून आरू नप्ताली क देश,</para>
  <para style="q2" vid="MAT 4:15">दरिया क मार्ग छे यरदन नदी पार,</para>
  <para style="q2" vid="MAT 4:15">गैरयहुदी क गलील<verse eid="MAT 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16"/>“जे मानसे आंधारला मा बठ्या हुता,</para>
  <para style="q2" vid="MAT 4:16">त्या मोटी दिया देखी;</para>
  <para style="q1" vid="MAT 4:16">आरू जो मरन क देश आरू साहवाम मा बठ्या हुता,</para>
  <para style="q2" vid="MAT 4:16">उन पर दिया चमकी।”<verse eid="MAT 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:17 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:2">मत्ती 3:2</ref>
      </char>
    </note>उना टेम सी ईशु खबर करने आरू यो कयनो शुरू कर्यो, “मन फिरावो, काहकि सोरग क राज्य नाट आवी गयलो छे।”<verse eid="MAT 4:17"/></para>
  <para style="s">पेहलो चेला क बुलाया जाने</para>
  <para style="r">(<ref loc="MRK 1:16-20">मरकुस 1:16-20</ref>; <ref loc="LUK 5:1-11">लूका 5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18"/>गलील की दरियो क धोड़े पुगता होया उना ने दुय भाईस मतलब शमौन क जो पतरस कवाये छे, आरू ओका भाईस अन्द्रियास क दरियो जाव नाखता देख्या; काहकि त्यो माछा मारन्या हुता। <verse eid="MAT 4:18"/><verse number="19" style="v" sid="MAT 4:19"/>ईशु ओका कयो, “मारे पछव आवु, ते हाव तुमूक मानुस क यहोवा भगवान राज्यमा लावनेवावा बनावसु।” <verse eid="MAT 4:19"/><verse number="20" style="v" sid="MAT 4:20"/>त्यो तत्काल जाव क छुड़ीन ईशु पछव होय लेदा।<verse eid="MAT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21"/>वा से ओगव जाने पर, ईशु आर दुय भाईस मतलब जबदी क पोर्‍या याकूब आरू यहुन्ना आरू ओका भाईस यहुन्ना क देख्य। त्यो आपसा बास जबदी क साथे ढोंड्या पर आपसी जाव क सुधारी रया हुता। त्यो तीनुक भी बुलाया। <verse eid="MAT 4:21"/><verse number="22" style="v" sid="MAT 4:22"/>त्यो तत्काल ढोंड्या आरू बास क छुड़ीन ओको पछव चाल देदा।<verse eid="MAT 4:22"/></para>
  <para style="s">ईशु क बिमार क वारू करने</para>
  <para style="r">(<ref loc="LUK 6:17-19">लूका 6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:23 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:35">मत्ती 9:35</ref>; <ref loc="MRK 1:39">मरकुस 1:39</ref></char>
    </note>ईशु सब गलील नगर मा पुगता होया उन क सभागृह मा शिक्षा करता, आरू राज्य क खुश खबर करता, आरू मानसे की हर रीति की बिमार आरू दुर्बलता क दूर करता रया। <verse eid="MAT 4:23"/><verse number="24" style="v" sid="MAT 4:24"/>आरू सब सीरिया देश मा ओका यश फैल गया; आरू दुःख मा जकड़े होया हुता, आरू जिन मा साहळा होती, आरू मिर्गी वालो आरू लखवा क बिमार क ओको साथे लाया आरू उना ने तीनुक वारू कर्‍या। <verse eid="MAT 4:24"/><verse number="25" style="v" sid="MAT 4:25"/>गलील आरू दिकापुलिस, यरूशलेम, यहूदि या आरू यरदन नदी क पार छे गर्दी ओको पछव चाल देदी।<verse eid="MAT 4:25"/></para>
  <chapter eid="MAT 4"/>
  <chapter number="5" style="c" sid="MAT 5"/>
  <para style="s">ईशु बयड़ा मा शिक्षा</para>
  <para style="r">(<ref loc="MAT 5:1-7:29">5:1–7:29</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1"/>त्यो इनीये गर्दी क देखीन बयड़ा पर चढ़ी गया, आरू जव बठ्या गया तो ओका चेला ओका पास मा आया। <verse eid="MAT 5:1"/><verse number="2" style="v" sid="MAT 5:2"/>आरू त्यो आपनो मुय उघाड़ी तीनुक यो शिक्षा देने लाग्या:<verse eid="MAT 5:2"/></para>
  <para style="s">बरकत वाळो बोल</para>
  <para style="r">(<ref loc="LUK 6:20-23">लूका 6:20-23</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3"/>“धन्य होय छे त्यो, जो मन क दाहड़ो छे, काहकि सोरग क राज्य ओकान छे।”<verse eid="MAT 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4"/>“बरकत वाळो छे त्यो, जो शोक करता छे,</para>
  <para style="q2" vid="MAT 5:4">काहकि त्यो शांती देखे।”<verse eid="MAT 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5"/>“बरकत वाळो छे त्यो, जो नम्र छे,</para>
  <para style="q2" vid="MAT 5:5">काहकि त्यो पृथ्वी क हकदार हुयसे।”<verse eid="MAT 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6"/>“धन्य होय छे त्यो, जो न्यायपन क भूखला आरू पीसला छे,</para>
  <para style="q2" vid="MAT 5:6">काहकि त्यो तृप्त कर्‍या जाछे।”<verse eid="MAT 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7"/>“बरकत वाळो छे त्यो, जो दयावन्त छे,</para>
  <para style="q2" vid="MAT 5:7">काहकि उन पर दया कर जाछे।”<verse eid="MAT 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8"/>“बरकत वाळो छे त्यो, जिन क मन चुखो छे,</para>
  <para style="q2" vid="MAT 5:8">काहकि त्यो यहोवा–भगवान क देखछे।”<verse eid="MAT 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9"/>“बरकत वाळो छे त्यो, जो मेल करनेवावा छे,</para>
  <para style="q2" vid="MAT 5:9">काहकि त्यो यहोवा–भगवान क पोर्‍या कवायसे।”<verse eid="MAT 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 5:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:10 </char>
      <char style="xt" closed="false">
        <ref loc="1PE 3:14">1 पतरस 3:14</ref>
      </char>
    </note>“बरकत वाळो छे त्यो, जो न्यायपन क कारण सताय जातो छे, काहकि सोरग क राज्य तीनुक क छे।”<verse eid="MAT 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:11 </char>
      <char style="xt" closed="false">
        <ref loc="1PE 4:14">1 पतरस 4:14</ref>
      </char>
    </note>“धन्य होय तुमू, जव मानुस मारे कारण तुमरी निंदा करे, आरू सताय आरू झूठ बुली तुमरे विरोध मा सब रीति की बुरी वात कये।” <verse eid="MAT 5:11"/><verse number="12" style="v" sid="MAT 5:12"/><note caller="+" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="ACT 7:52">प्रेरितन 7:52</ref></char></note>तव खुश आरू मगन हुयने, काहकि तुमरे करता सोरग मा मोटो फोव छे। अतरानकरीन करीन क त्या कागळियान क जो तुमरे सी पेहल हुता इनी रीति सताया।<verse eid="MAT 5:12"/></para>
  <para style="s">नोन आरू दिया</para>
  <para style="r">(<ref loc="MRK 9:50">मरकुस 9:50</ref>; <ref loc="LUK 14:34-35">लूका 14:34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:13 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:50">मरकुस 9:50</ref>; <ref loc="LUK 14:34">लूका 14:34</ref>,<ref loc="LUK 14:35">35</ref></char>
    </note>“तुमू पृथ्वी क नोन होय; पुन यदि नोन क हवाद बिगड़ी जाय, तो त्यो पछु काही समान छे नोन कर्‍या जाछे? पछु त्यो काही काम क नी, केवल यो कि बाहरता नाख दियो जाय आरू मानुस क पायो तवे रौदा जाय।”<verse eid="MAT 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:14 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 8:12">यहुन्ना 8:12</ref>; <ref loc="JHN 9:5">9:5</ref></char>
    </note>तुमू जगमा की दिया होय जो नगर बयड़ा पर बठ्या होया छे त्यो डुकाय नी सकता। <verse eid="MAT 5:14"/><verse number="15" style="v" sid="MAT 5:15"/><note caller="+" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="MRK 4:21">मरकुस 4:21</ref>; <ref loc="LUK 8:16">लूका 8:16</ref>; <ref loc="LUK 11:33">11:33</ref></char></note>आरू मानसे दिया धपाड़्या कागुन क नेचो नी पुन दीवट पर राख छे, तव ओको छे घर क सब मानसे क विजात्यो पुगजा छे। <verse eid="MAT 5:15"/><verse number="16" style="v" sid="MAT 5:16"/><note caller="+" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="1PE 2:12">1 पतरस 2:12</ref></char></note>तीनी रीति तुमरो विजात्यो मानुस क सामने चमके कि त्यो तुमरा बास की, जो सोरग मा छे, बढ़ाई कर्‍या।<verse eid="MAT 5:16"/></para>
  <para style="s">व्यवस्था की शिक्षा</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17"/>“यो नी समझ, कि हाव व्यवस्था या भविष्यवक्ता की किताब क लोप करने आश छे, लोप करने नी, पुन पूरो करने आश छे।” <verse eid="MAT 5:17"/><verse number="18" style="v" sid="MAT 5:18"/><note caller="+" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="LUK 16:17">लूका 16:17</ref></char></note>काहकि हाव तुमू छे छाचो कयता छे, कि जव तक सोरग आरू पृथ्वी टव नी जाय, तव तक व्यवस्था छे एक मात्रा या एक बिंदु भी बिना पूरो हुयनो नी टळसे। <verse eid="MAT 5:18"/><verse number="19" style="v" sid="MAT 5:19"/>एरकरीन जो काही इना नाना सी नाना हुकुम मा सी एक क तुड़े, आरू तसोत् लोगहन क सिखाडे, त्यो सोरग क राज्य मा सब सी नानो कवायसे; पुन जो कोय उना हुकुम क पालन करसे आरू तीनुक सिखाड़से, त्योत् सोरग क राज्य मा महान कवायसे। <verse eid="MAT 5:19"/><verse number="20" style="v" sid="MAT 5:20"/>काहकि हाव तुमू छे कयता छे, कि यदि तुमरी न्यायपन शास्त्र आरू फरीसियों की न्यायपन छे बढ़ीन नी होयस, तो तुमू सोरग क राज्य मा कदी भरायने करने नी देखछे।<verse eid="MAT 5:20"/></para>
  <para style="s">रीस आरू हत्या</para>
  <para style="r">(<ref loc="LUK 12:57-59">लूका 12:57-59</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21"/>“तुमू सोमवी चुक्या होय, कि पेहला मानसे छे कयो गया हुता कि ‘हत्या नी करने आरू जो काही हत्या करसे त्यो कचहरी मा दण्ड क योग्य होयछे।’ <verse eid="MAT 5:21"/><verse number="22" style="v" sid="MAT 5:22"/>पुन हाव तुमू छे यो कयता छे, कि जो काही आपने भाईस पर रीस करसे, त्यो कचहरी मा दण्ड क योग्य होयछे, आरू जो काही आपसा भाईस क निकम्मा कवसे त्यो महासभा मा दण्ड क योग्य होयछे; आरू जो काही कये ‘अरे मुर्ख’ त्यो नरक क आगठो क दण्ड क योग्य होयछे।” <verse eid="MAT 5:22"/><verse number="23" style="v" sid="MAT 5:23"/>एरकरीन यदि तु आपसी भेंट वेदी पर लाया, आरू वाँ तु स्मरण करे, कि तारा भाईस क मन मा थारा करता काही विरोध छे, <verse eid="MAT 5:23"/><verse number="24" style="v" sid="MAT 5:24"/>तो आपसी भेंट त्योही वेदी क सामने छुड़ देय, आरू जाईन पेहल आपसा भाईस छे मेळभेट कर आरू तव आवीन आपसी भेंट चढ़ायो।<verse eid="MAT 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25"/>जव तक तु आपने मुद्दई साथे मार्ग ही मा छे, उना छे छाटलो हावव मिलाप कर लेय काही ओसो नी होय कि मुद्दई तुखे सरदार क सौप्य, आरू सरदार तुखे सिपाई क सौप देय, आरू तु जेल मा नाख दिदो जाय। <verse eid="MAT 5:25"/><verse number="26" style="v" sid="MAT 5:26"/>हाव तुखे छे छाचो कयता छे कि तव तक तु कौड़ी–कौड़ी भर नी देय तक वाँ छे छूटने नी देखसे।<verse eid="MAT 5:26"/></para>
  <para style="s">व्यभिचार क बारा मा शिक्षा</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27"/>“तुमू सोमवी चुक्या होय कि कयो गया हुता, ‘व्यभिचार नी करने।’ <verse eid="MAT 5:27"/><verse number="28" style="v" sid="MAT 5:28"/>पुन हाव तुमू छे यो कयता छे, कि जो काय काही बायर पर गलत नाखे त्यो आपने मन मा उना छे व्यभिचार कर त्योक्य।” <verse eid="MAT 5:28"/><verse number="29" style="v" sid="MAT 5:29"/><note caller="+" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="MAT 18:9">मत्ती 18:9</ref>; <ref loc="MRK 9:47">मरकुस 9:47</ref></char></note>यदि तारी डाखरिया डुळा तुखे ठुकर खावड़ायो, तो ओको निकावीन नाख दिदा; काहकि थारा करता योही भला छे कि थारा डील मा छे एक नष्ट होय जाय आरू तारो सब डील नरक मा नी नाखी जाय। <verse eid="MAT 5:29"/><verse number="30" style="v" sid="MAT 5:30"/><note caller="+" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="MAT 18:8">मत्ती 18:8</ref>; <ref loc="MRK 9:43">मरकुस 9:43</ref></char></note>यदि तारो डाखरिया हात तुखे ठुकर खावड़ायो, तो उना क काटीन नाख देय; काहकि थारा करता योही भला छे कि थारा डील मा छे एक नष्ट होय जाय आरू तारो डील नरक मा नी नाखी जाय।<verse eid="MAT 5:30"/></para>
  <para style="s">तलाक</para>
  <para style="r">(<ref loc="MAT 19:9">मत्ती 19:9</ref>; <ref loc="MRK 10:11-12">मरकुस 10:11-12</ref>; <ref loc="LUK 16:18">लूका 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:31 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 19:7">मत्ती 19:7</ref>; <ref loc="MRK 10:4">मरकुस 10:4</ref></char>
    </note>“यो भी कयो गया हुता, ‘जो काही आपसी बायर क तलाक देनो जुवे, तो उको छुड़ने न पत्री देय।’<note caller="+" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="DEU 24:1-14">व्यवस्थाविवरण 24:1-14</ref></char></note> <verse eid="MAT 5:31"/><verse number="32" style="v" sid="MAT 5:32"/><note caller="+" style="x"><char style="xo" closed="false">5:32 </char><char style="xt" closed="false"><ref loc="MAT 19:9">मत्ती 19:9</ref>; <ref loc="MRK 10:11">मरकुस 10:11</ref>,<ref loc="MRK 10:12">12</ref>; <ref loc="LUK 16:18">लूका 16:18</ref>; <ref loc="1CO 7:10">1 कुरन्थियो 7:10</ref>,<ref loc="1CO 7:11">11</ref></char></note>पुन हाव तुमू छे यो कयता छे कि जो काही आपसी बायर क व्यभिचार क सिवा काही आरू कारण छे तलाक देय, तो त्यो ओका सी व्यभिचार करे छे; आरू जो काही उनी त्यागी होयी छे वियाव करे, त्यो व्यभिचार करता छे।”<verse eid="MAT 5:32"/></para>
  <para style="s">शपथ</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33"/>“पछु तुमू सोमवी त्योक्या होय कि पूर्वकाव क मानसे छे कयो गया, ‘झूठी शपथ नी खाने, पुन पोरबु क करता आपसी शपथ क पूरी करने।’” <verse eid="MAT 5:33"/><verse number="34" style="v" sid="MAT 5:34"/><note caller="+" style="x"><char style="xo" closed="false">5:34 </char><char style="xt" closed="false"><ref loc="JAS 5:12">याकूब 5:12</ref>; </char><char style="xt" closed="false"><ref loc="MAT 23:22">मत्ती 23:22</ref></char></note>पुन हाव तुमू छे यो कयता छे कि कदी शपथ नी खाने; नी तो सोरग की, काहकि त्यो यहोवा–भगवान क सिंहासन छे; <verse eid="MAT 5:34"/><verse number="35" style="v" sid="MAT 5:35"/>नी धरती की, काहकि त्यो ओको पाय की चौकी छे; नी यरूशलेम की, काहकि त्यो राजा क नगर छे। <verse eid="MAT 5:35"/><verse number="36" style="v" sid="MAT 5:36"/>“आपनो मुनका की भी शपथ नी खाने काहकि तु एक झोटा क भी नी उजला, नी कावा कर सकता छे। <verse eid="MAT 5:36"/><verse number="37" style="v" sid="MAT 5:37"/>पुन तुमरी वात ‘हव’ ते ‘हव’ या ‘नी’ ते ‘नी’ की होय; काहकि जो काही इनीये छे सवटो होतो छे त्यो बुराई छे होतो छे।”<verse eid="MAT 5:37"/></para>
  <para style="s">बदलो लेने क बारा मा शिक्षा</para>
  <para style="r">(<ref loc="LUK 6:29-30">लूका 6:29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38"/>“तुमू सोमवी त्योक्या होय कि कयो गया हुता; डुवा क बदले डुवा, आरू दात।” <verse eid="MAT 5:38"/><verse number="39" style="v" sid="MAT 5:39"/>पुन हाव तुमू यो कयता छे कि बुरे क सामना नी करने; पुन जो काही थारा डाखरिया गाल पर थापुड मारे, ओकी आरू दिसरा भी फेर देय। <verse eid="MAT 5:39"/><verse number="40" style="v" sid="MAT 5:40"/>यदि काही तुखे पर नालिश करीन तारो सुटर लेनो जुवे, तो ओको दोहर भी लेय लेने देय। <verse eid="MAT 5:40"/><verse number="41" style="v" sid="MAT 5:41"/>जो काही तुखे कोस भर अमथो मा लेय जाय, तो ओका साथ दुय कोस चाली जाय। <verse eid="MAT 5:41"/><verse number="42" style="v" sid="MAT 5:42"/>जो काही तुखे छे उधार लेने जुवे, उका सी मुय मा फिरावो।<verse eid="MAT 5:42"/></para>
  <para style="s">दुस्मन सी मोंग</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43"/>“तुमू सोमवी चुक्या होय कि काँ गया हुता, आपने धडेवावा छे मोंग राखने, आरू आपने दुस्मनी छे दुस्मनी।” <verse eid="MAT 5:43"/><verse number="44" style="v" sid="MAT 5:44"/>“पुन हाव तुमरे सी यो कहम कि आपसा दुस्मन सी मोंग राख आरू तुमरा सतावनेवाला क करता प्रार्थना करू।” <verse eid="MAT 5:44"/><verse number="45" style="v" sid="MAT 5:45"/>जिना सी तुमू तुमरा सोरग मा वाला बास क पोर्‍या बनसो काहकि त्यो वारला आरू बुरा दूय पर हेको दाड़ो उगाड़ आरू न्यायी आरू अन्यायी दूयो पर मेह बरसावे। <verse eid="MAT 5:45"/><verse number="46" style="v" sid="MAT 5:46"/>काहकि कदाम तुमू तुमरे सी मोंग करने वाला सीत मोंग राखे, तो तुमरे करता काय नफु हुयसे? काय फाळो लेनेवाळा भी असा नी करे? <verse eid="MAT 5:46"/><verse number="47" style="v" sid="MAT 5:47"/>आरू कदाम तुमू तुमरा भाईस क अतरात नमस्कार करो, तो काहलो मोटलो काम करो? काय गैरयहुदी भी असा नी करे? <verse eid="MAT 5:47"/><verse number="48" style="v" sid="MAT 5:48"/>अतरानकरीन करीन तुमूक यो करनो जुवे कि तुमू जोसा बनो, जसो तुमरो सोरग मा वालो बास पाको छे।<verse eid="MAT 5:48"/></para>
  <chapter eid="MAT 5"/>
  <chapter number="6" style="c" sid="MAT 6"/>
  <para style="s">दान</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 23:5">मत्ती 23:5</ref>
      </char>
    </note>“सावधान रवु! तुमू मानुस क देखाड़ने क करता आपसा न्याय क काम नी करू, नी तो आपसा सोरग मा वावु बास छे काही भी फोव नी देखछे।”<verse eid="MAT 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2"/>“एरकरीन जव तु दान करे, तो आपने ओगव भीराक मा वाजाड़ मांगे, जोसो कपटी, सभा आरू गलियो मा करता छे, ताकि मानसे उन बढ़ाई करू। हाव तुमू छे छाचो कयता छे कि त्यो आपसा हर फोव देख चूके। <verse eid="MAT 6:2"/><verse number="3" style="v" sid="MAT 6:3"/>पुन जव तु दान कर, तो जो तारो डावु हात करतो छे, ओको तारो जेवड़ा हात नी जानन छे।” <verse eid="MAT 6:3"/><verse number="4" style="v" sid="MAT 6:4"/>ताकि तारो दान सातायलो रोवे, आरू तव तारो बास जो सातायलो मा देखता छे, तुखे हर फोव आपसे।<verse eid="MAT 6:4"/></para>
  <para style="s">प्रार्थना</para>
  <para style="r">(<ref loc="LUK 11:2-4">लूका 11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:5 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 18:10-14">लूका 18:10-14</ref>
      </char>
    </note>“जव तु प्रार्थना कर, तो कपटियो क समान नी होय, काहकि मानसे क देखाड़ने क करता आराधना घर मा आरू सयड़क क मोड़ो पर उबा हईन प्रार्थना करने उनको वारलो लागतो छे। हाव तुमू छे छाचो कयता छे कि त्यो आपनो हर फोव देख चूके।” <verse eid="MAT 6:5"/><verse number="6" style="v" sid="MAT 6:6"/>पुन जव तु प्रार्थना कर तो आपसी घर मा जा; आरू झोपलो बंद कर क थार बास सी जो सातायलो मा छे प्रार्थना कर। तव तारो बास जो सातायलो मा देखता छे, तुखे हर फोव आपसे।<verse eid="MAT 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7"/>प्रार्थना करता टेहाव गैरयहुदी क समान बक–बक मा करू, काहकि त्यो समझता छे कि ओको घोणा बुलने छे ओकी सोमवाय जाछे। <verse eid="MAT 6:7"/><verse number="8" style="v" sid="MAT 6:8"/>एरकरीन तुमू मांगने छे पेहल ही जानता छे कि तुमरी काय जरूरत छे।<verse eid="MAT 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 6:9"/>शेवली कावा तुमू इनीये रीति छे प्रार्थना कर्‍या करू</para>
  <para style="q2" vid="MAT 6:9">हे हामरा बास, तु जो सोरग मा छे; तारो नाव चुखलो मान्यो जाय:<verse eid="MAT 6:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="MAT 6:10"/>तारो राज आवे। तारी मरजी जोसी सोरग मा पूरी होयती छे,</para>
  <para style="q2" vid="MAT 6:10">त्योसी कोवी पर भी होय।<verse eid="MAT 6:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="MAT 6:11"/>हामरा दाहड़ा भर क रोटा आज हामुक आपसुत।<verse eid="MAT 6:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="MAT 6:12"/>आरू जी रीति हामु ने आपने गुणेहगार क माफ कर्‍या करसे छे, ताकि बुराई सी आमुक वाचाड़। काहकि राज्य, शक्ति आरू महिमा हमेशा तारा छे। आमीन।</para>
  <para style="q2" vid="MAT 6:12">त्योसो ही तु भी हामरे दोष क माफ करू।<verse eid="MAT 6:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="MAT 6:13"/>आरू हामु परीक्षा मा नी ला,</para>
  <para style="q2" vid="MAT 6:13">पुन बुराई छे वाचाड़; काहकि राज आरू पराक्रम आरू महिमा सदा तारो ही छे। आमेन।<verse eid="MAT 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14"/>एरकरीन यदि तुमू मानुस क गुणू माफ करसे, ते तुमरा सोरगीय बास भी तुमूक माफ करसे। <verse eid="MAT 6:14"/><verse number="15" style="v" sid="MAT 6:15"/>आरू यदि तुमू मानुस क गुना क माफ नी करे, तो तुमरा बास भी तुमरे गुना क माफ नी करसे।<verse eid="MAT 6:15"/></para>
  <para style="s">उपवास</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16"/>जव तुमू उपवास करू, तो कपटियो क समान तुमरो मुय चिमायलो नी रये, काहकि त्या आपसो मुय चिमाड़ीन रये रयता छे, ताकि मानसे उन लोगहन उपासी जाने। हाव तुमू छे छाचो कयता छे कि त्यो आपसो हर फोव ली चूक्या। <verse eid="MAT 6:16"/><verse number="17" style="v" sid="MAT 6:17"/>पुन जव तु उपवास करू तो आपने मुनका पर तेल मल आरू मुय धरती। <verse eid="MAT 6:17"/><verse number="18" style="v" sid="MAT 6:18"/>ताकि लोगहन नी बाकुन तारो सोरग मा वाळो बास जो सातायलो मा छे, तुखे उपवास जाने। जो सातायलो मा देखता छे, तुखे हर फोव आपसे।<verse eid="MAT 6:18"/></para>
  <para style="s">सरगीय धन</para>
  <para style="r">(<ref loc="LUK 12:33-34">लूका 12:33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:19 </char>
      <char style="xt" closed="false">
        <ref loc="JAS 5:2">याकूब 5:2</ref>,<ref loc="JAS 5:3">3</ref></char>
    </note>“आपने करता धरती पर धन एखठा मा करो, जा सब किड़ा आरू उदाय उको बिगाड़े आरू चुट्टा चुरी करलेय। <verse eid="MAT 6:19"/><verse number="20" style="v" sid="MAT 6:20"/>पुन आपने करीन सोरग मा आपने करीन धन एखठो करू, चा नी ती किड़ा, आरू नी उदाय बिगाड़े, आरू जा चुट्टा नी सेंध लागाड़े आरू नी चुरी करे। <verse eid="MAT 6:20"/><verse number="21" style="v" sid="MAT 6:21"/>काहकि वा तारो धन छे चा तारो मन लागलो रोवसे।”<verse eid="MAT 6:21"/></para>
  <para style="s">डीलन दिया</para>
  <para style="r">(<ref loc="LUK 11:34-36">लूका 11:34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22"/>डिलन दिवु डुवो छे। यदि तारा डुवा वारला छे, ती तारा आखो डील भी विजावो होयसे। <verse eid="MAT 6:22"/><verse number="23" style="v" sid="MAT 6:23"/>पुन यदि तारा डुवा बुरा होय, ती तारो आखो डील भी आँधारलो रोवसे; अतरान करीन कारण त्यो विजावो जो तुखे मे छे यदि आँधारलो होय ती आँधारलो कोसो मोटो होयसे।<verse eid="MAT 6:23"/></para>
  <para style="s">काही वातन चिंता नी करनेन</para>
  <para style="r">(<ref loc="LUK 16:13">लूका 16:13</ref>; <ref loc="LUK 12:22-31">12:22-31</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24"/>काही मानसे दुय यहोवा–भगवान सेवा नी कर सकता, काहकि चु एक सी बैर आरू दिसरा सी मोंग राखसे, या एक से निष्ठावान रोवसे आरू दिसरा क तिरस्कार करसे। तुमू यहोवा भगवान आरू धन दुयून सेवा नी कर सकता।<verse eid="MAT 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25"/>अतरान करीन–करीन मे तुमू से कयतो छे, कि आपसा जीवन करीन यी चिंता नी करने कि हामु काय खासे, आरू काय पीसे, आरू नी आपसा डीलन करीन कि काय पेरसे, काय खानो से, आरू डील पर छिंदरा रयन मोटो नी। <verse eid="MAT 6:25"/><verse number="26" style="v" sid="MAT 6:26"/>वादवो क चिल्लान क देखु! त्या नी वेरे, नी काटे, आरू नी कुठार मा एखठा करे; <verse eid="MAT 6:26"/><verse number="27" style="v" sid="MAT 6:27"/>तुमरे मा कुन छे, जो चिंता करिन आपसी जीवाय क एक टेम बढ़ाई सके?<verse eid="MAT 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28"/>आरू छिंदरा क लिन क फिकुर काह करो? जंगली फुल क देखु, कि त्या कसो त्योदे, त्या नी काठो काम करे, आरू नी छिंदरा बनावे। <verse eid="MAT 6:28"/><verse number="29" style="v" sid="MAT 6:29"/>ते भी हान तेखो कय द्यो, कि सुलैमान भी, तेखा आपना सब वैभव मा ओका मा सी काहना एक क समान छिंदरा नी हतो। <verse eid="MAT 6:29"/><verse number="30" style="v" sid="MAT 6:30"/>अतरान करीन यहोवा भगवान खोळदीन खोड़ो क, जो आज छे, आरू उको वाहना मा आगठी मा न्हाख देसे, त्यो असो छिंदरा पेहनावे, ती काय ए विनभुरसीया तेखो नी पेहरावे काय?<verse eid="MAT 6:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31"/>एरकरीन तुमू फिकुर करीन यो झुण कयता, कि हामु काय खासू, आरू काय पीसू, आरू काय पेहरसु? <verse eid="MAT 6:31"/><verse number="32" style="v" sid="MAT 6:32"/>काहकि गैरयहुदी इनी आखी वात क हेरता रये, आरू तुमरो सोरग मा वाळो बास जाने, कि उको यी आखी चीज जुवे। <verse eid="MAT 6:32"/><verse number="33" style="v" sid="MAT 6:33"/>एरकरीन तुमू पेहले यहोवा भगवान राज आरू तेखो न्यायपन क हेरो ती यी सब चीज उको मुवसे जो उको जुवे। <verse eid="MAT 6:33"/><verse number="34" style="v" sid="MAT 6:34"/>अतरानकरीन करीन आवने वाहनेन दाहड़ा क चिंता मा करो, काहकि वाहने क दाड़ो आपसो चिंता करसे; आजुन क दुःख आज ढेरको छे।<verse eid="MAT 6:34"/></para>
  <chapter eid="MAT 6"/>
  <chapter number="7" style="c" sid="MAT 7"/>
  <para style="s">दिसरा पर दोष नी लागाड़नो</para>
  <para style="r">(<ref loc="LUK 6:37">लूका 6:37</ref>,<ref loc="LUK 6:38">38</ref>,<ref loc="LUK 6:41">41</ref>,<ref loc="LUK 6:42">42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1"/>दोष मा लागाड़, कि तुमू पर भी दोष नी लागाड़ जाय। <verse eid="MAT 7:1"/><verse number="2" style="v" sid="MAT 7:2"/><note caller="+" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="MRK 4:24">मरकुस 4:24</ref></char></note>काहकि जिन रीति सी तुमू दोष लागाड़ता होय, तिन रीति तुमू पर भी दोष लागाड़लो जासे; आरू जिन नाप रयन तुमू नापता होय, तिना रयन तुमरो भी नाप लेसे। <verse eid="MAT 7:2"/><verse number="3" style="v" sid="MAT 7:3"/>तु काय आपसा भाईसन डुवान तिनको देखता छे, आरू आपसा डुवान खुटी तुखे नी देखता? <verse eid="MAT 7:3"/><verse number="4" style="v" sid="MAT 7:4"/>जव तारा डुवा मा खुटि छे, ती तु आपसा भाईस से कोसो कय सकतो छे, “लाव मे तारा डुवा से तिनको निकाव दिस?” ओ ढोंगी! <verse eid="MAT 7:4"/><verse number="5" style="v" sid="MAT 7:5"/>हे कपटी, पेहल आपसा डुवा मा रयन खुटी निकाव ले, तव तु आपसा भाईसन डुवान तिनको भली भाति देखीन निकाव सकसे।<verse eid="MAT 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6"/>चुखलो चीज कुत्राक नी आपने, आरू आपनो मोती सुहर्‍यान ओगव मा नाखु; ओसो नी होय तिनुक पाय पलटावीन तुमूक फाड़ नाखे।<verse eid="MAT 7:6"/></para>
  <para style="s">मांगसु ती देखसु</para>
  <para style="r">(<ref loc="LUK 11:9-13">लूका 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7"/>मांगसु, ती तुमूक आप देसे; हेरसे ती तुमूक जुड़से; खटखटाय, ती तुमरे करीन उगड़ी जासे। <verse eid="MAT 7:7"/><verse number="8" style="v" sid="MAT 7:8"/>काहकि जो काही मांगता छे, तीनाक मिवतो छे; आरू जो हेरता छे, चो देखता छे; आरू जो खटखटाता छे, तिनान करीन उगड़ी जासे। <verse eid="MAT 7:8"/><verse number="9" style="v" sid="MAT 7:9"/>तुमू मा रयन ओसो कुन मानुस छे, कि ओवी तेरो पोर्‍या तिना रयन रोटा मांगसे, ती चो तीनाक दगड़ो आपसे, मासो मांगसे, ते ओका गोड़सु आपसे? <verse eid="MAT 7:9"/><verse number="10" style="v" sid="MAT 7:10"/>वा माछली मांगे, ती तेखे घड़सो आपसे? <verse eid="MAT 7:10"/><verse number="11" style="v" sid="MAT 7:11"/>अळते: जव तुमू बुरा हईन, आपसा पोर्‍यान वारलो चीज आपने जूवता होय, ती तुमरा सोरगन बास ओका मांगनेवावान वारलो चीज काय नी आपसे?<verse eid="MAT 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">7:12 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 6:31">लूका 6:31</ref>
      </char>
    </note>इना कारण जो काही तुमू जूवता होय, कि मानुस तुमरे साथे करे, तुमू भी तींदरा साथे तसोत् व्यवहार करू; काहकि व्यवस्था आरू भविष्यव्दक्तान शिक्षा यज लिखलो छे।<verse eid="MAT 7:12"/></para>
  <para style="s">साकड़ो आरू चौवड़ो मार्ग</para>
  <para style="r">(<ref loc="LUK 13:24">लूका 13:24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13"/>“साकड़े फाटक मा रयन भरायो, काहकि चौवड़ो छे चो फाटक आरू सरल छे चो मार्ग जो विनाशन चा रयन ली जाता छे; आरू खुब सब मानसे छे जो तिनासे भरायने करता छे।” <verse eid="MAT 7:13"/><verse number="14" style="v" sid="MAT 7:14"/>काहकि साकड़ो छे चाँ फाटक आरू वातड़ो छे मार्ग जो जीवनन पुचाड़तो छे, आरू थुड़त छे जो तीनाक देखता छे।<verse eid="MAT 7:14"/></para>
  <para style="s">फोव रयन झाड़कान उवख</para>
  <para style="r">(<ref loc="LUK 6:43-44">लूका 6:43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15"/>“झुठा भविष्यव्दक्ता से सावधान रवु, जो गाड़ गाडरा तुमरे साथे आवता छे, पुन जागा मा फाड़नेवावा लेन्डीया तोसा छे।” <verse eid="MAT 7:15"/><verse number="16" style="v" sid="MAT 7:16"/>तींदरा फोव से तुमू तिनुक उवख मानसे। काय झाड़का से अंगुर, या काटेवसीया क झाड़को से अंजीर तुड़ता छे? <verse eid="MAT 7:16"/><verse number="17" style="v" sid="MAT 7:17"/>इनीये रीति हर एक वारलो झाड़को वारलो फोव लावतो छे आरू निकम्मा झाड़को बुरो फोव लावतो छे। <verse eid="MAT 7:17"/><verse number="18" style="v" sid="MAT 7:18"/>वारलो झाड़को बुरो फोव नी लाय सकता, आरू नी बुरो झाड़को वारलो फोव लाय सकता छे। <verse eid="MAT 7:18"/><verse number="19" style="v" sid="MAT 7:19"/><note caller="+" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="MAT 3:10">मत्ती 3:10</ref>; <ref loc="LUK 3:9">लूका 3:9</ref></char></note>जो–जो झाड़को फोव नी लावतो, चो काटीयो आरू आगठा मा नाख देता‌ छे। <verse eid="MAT 7:19"/><verse number="20" style="v" sid="MAT 7:20"/><note caller="+" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="MAT 12:33">मत्ती 12:33</ref></char></note>अळते: तींदरा फोव से तुमू तिनुक उवख लेसे।<verse eid="MAT 7:20"/></para>
  <para style="s">हाव तुमूक नी जानो</para>
  <para style="r">(<ref loc="LUK 13:25-27">लूका 13:25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21"/>जे म्हार सी, “हे पोरबु! हे पोरबु!” कये, उका माईन सब लोगहन सोरग न राज मा भरायने नी करसे, पुन त्योत् जो सोरग माईन बास न मरजी पर चालतो रयसे। <verse eid="MAT 7:21"/><verse number="22" style="v" sid="MAT 7:22"/>तिन दाहड़े खुब मानसे मेखे कोवसे; “हे पोरबु, काय हामु तारे नाव से भविष्यद्वाणी नी करी, आरू तारे नाव से साहळा नी निकाव्या, आरू तारे नाव से खुब चमत्कार क काम नी कर्‍या?” <verse eid="MAT 7:22"/><verse number="23" style="v" sid="MAT 7:23"/>तव हाव तीनुक कय दिस, हाव तुमूक कदी नी जान्य, हे कुकर्म करनेवावा, मारे साथे से चाली जावु।<verse eid="MAT 7:23"/></para>
  <para style="s">अकलमान आरू मुर्ख मानुस</para>
  <para style="r">(<ref loc="LUK 6:47-49">लूका 6:47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24"/>अतरान करीन–करीन जी काही यी वात सोमवीन तिनुक मानता छे चो तीनाक अकलमान मानुस क समान ठरसे जे आपसा घर चट्टान पर बनाड़े। <verse eid="MAT 7:24"/><verse number="25" style="v" sid="MAT 7:25"/>आरू वरहात आरू बाढ़े आवी, आरू वादुन आयु, आरू तिना घर पर टक्‍कर लागी, पुन चो नी पड़्यो, काहकि तेरी नींव चट्टान पर नाखी गयी होती।<verse eid="MAT 7:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26"/>पुन जो काही मारी यी वात सोमवाता छे आरू तिनु पर नी चालता चो तिन मुर्ख मानसोन समान ठरसे जे आपसो घर वासणी पर बनाड़े। <verse eid="MAT 7:26"/><verse number="27" style="v" sid="MAT 7:27"/>आरू वरहात, आरू आवी, आरू आंझी चाली, आरू तिन घर पर टक्‍कर लागी आरू चो पड़ीन सच्चाई नाश होय गयो।<verse eid="MAT 7:27"/></para>
  <para style="s">ईशु क हक</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">7:28 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 1:22">मरकुस 1:22</ref>; <ref loc="LUK 4:32">लूका 4:32</ref></char>
    </note>जव ईशु यी वात कय चुक्या, ती ओसो हुयो कि गर्दी तेरी शिक्षा रयन चकित होयी। <verse eid="MAT 7:28"/><verse number="29" style="v" sid="MAT 7:29"/>काहकि चो तींदरा शास्त्रीन सारको नी पुन हक सारको तिनुक शिक्षा देता हुता।<verse eid="MAT 7:29"/></para>
  <chapter eid="MAT 7"/>
  <chapter number="8" style="c" sid="MAT 8"/>
  <para style="s">कुड़न बेमारी वारू करनो</para>
  <para style="r">(<ref loc="MRK 1:40-45">मरकुस 1:40-45</ref>; <ref loc="LUK 5:12-16">लूका 5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1"/>जब ईशु बयड़ा पर रयन उतरियो, ते एक मोटी गर्दी उका पछोळ चालने लागी <verse eid="MAT 8:1"/><verse number="2" style="v" sid="MAT 8:2"/>आरू एक कुड़ावो ईशु क पास मा आवीन उको वंद्या आरू कयो, “हे पोरबु कदाम तु चाहे तो मेखे वारू कर सके।”<verse eid="MAT 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3"/>ईशु आपसो हाथ बढ़ावीन हेको छिमीयो, आरू कयो, “म्हार मरजी छे, कि तु वारू हुय जा” आरू चु तत्काल कुड़ वारू हुय गियो। <verse eid="MAT 8:3"/><verse number="4" style="v" sid="MAT 8:4"/>ईशु हेको कयो, “देख, कुदाक कोय नी कयनो, बाकुन जाईन आपसा क पुजारान क देखाड़ आरू जो चढ़ायो मूसा टाकलो छे उको चढ़ाव काहकि त्या लोगहन क करता गवाय हुये।”<verse eid="MAT 8:4"/></para>
  <para style="s">रोम आधिकारी दास क आरगो करनो</para>
  <para style="r">(<ref loc="LUK 7:1-10">लूका 7:1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5"/>जव ईशु कफरनहूम नगर मा सी आयो ते एक रोमन सरदार उका पास आवीन उका विनती कर्‍यु, <verse eid="MAT 8:5"/><verse number="6" style="v" sid="MAT 8:6"/>“ए पोरबु, म्हार घर पर म्हार दास लखवा सी बीमार पड़ रीयो।”<verse eid="MAT 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7"/>ईशु उका सी कयो “हाव आवीन उको आरगो करीस।”<verse eid="MAT 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8"/>रोमन सरदार जवाब दीदो, “ए पोरबु, हाव इना लायक नी हय कि तु मार घर छत तवे आवे बाकुन यो मुय सी कय दे तो म्हार दास क आरगो हुय जासे। <verse eid="MAT 8:8"/><verse number="9" style="v" sid="MAT 8:9"/>काहकि हाव भी खुद कुदान हकन नेचो छे आरू म्हारा हक तळे एक दल सिपायड़ा रवे, आरू जव एक सी कहवो जा, तो त्यो जाय; आरू दिसरा सी कहवो आव, तो त्यो आवे; आरू म्हार दास सी कय यो कर तो त्यो करे।”<verse eid="MAT 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10"/>यो सोमळीन ईशु घबराय गियो, आरू जो उका पछोळ आवता हुता उन लोगहन सी कयो, हाव तुमरे सी छाचो कय, कि इसरायल मा भी ओसो विश्वास हाव नी देख्या। <verse eid="MAT 8:10"/><verse number="11" style="v" sid="MAT 8:11"/><note caller="+" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="LUK 13:29">लूका 13:29</ref></char></note>आरू हाव तुमरे सी कहवो, कि घण सवटा पुरब आरू पश्चिम सी आवीन अब्राहम आरू इसहाक आरू याकूब क साथ सोरग राज मा बठसे। <verse eid="MAT 8:11"/><verse number="12" style="v" sid="MAT 8:12"/>बाकुन राज्यन अवलियाद बाहर आँधारामा न्हाख देदा जासे; वा रोड़नो आरू दात पीसनो हुयसे।<verse eid="MAT 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13"/>आरू ईशु सरदार क कयो, “जा थारो विश्वास छे, वसोत थारे करता हुये।” आरू ओको सिपायड़ो उना समय मा आरगो हुय गियो।<verse eid="MAT 8:13"/></para>
  <para style="s">ईशु क लोगहन क आरगा करनो</para>
  <para style="r">(<ref loc="MRK 1:29-34">मरकुस 1:29-34</ref>; <ref loc="LUK 4:38-41">लूका 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14"/>आरू ईशु पतरस क घर आवीन ओकी सासु क तेज बुखार सी पड़ रहवली देखियो। <verse eid="MAT 8:14"/><verse number="15" style="v" sid="MAT 8:15"/>ईशु ओको हाथ छिमियो आरू उको ज्वर उतरी गियो; आरू त्या उठीन ईशुन सेवा करने लाग गयो।<verse eid="MAT 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16"/>जव साते हुयो त्योत्यार उका जु बैस लोगहन क लायो जिनामा साहळा हती आरू चाँ तिन आत्मा क काजे आपसा वचन क म रईन निकाव दिदा, आरू सब बीमार काजे आरगाय कर्‍या। <verse eid="MAT 8:16"/><verse number="17" style="v" sid="MAT 8:17"/>काहकि जो वचन यशायाह कागळिया लारे कयलो हुतो त्यो पूरो हुये; त्यो हामरी कमजुरी क आपसे पर ली लेदो आरू हामरी बीमारी क उठाय लेदो।<verse eid="MAT 8:17"/></para>
  <para style="s">ईशुन चेला बननेन किमत</para>
  <para style="r">(<ref loc="LUK 9:57-62">लूका 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18"/>ईशु आपसे चारो तरफ एक मोटी गर्दी क देखीन नदी ओका पार जानेन हुकुम दिदो। <verse eid="MAT 8:18"/><verse number="19" style="v" sid="MAT 8:19"/>आरू एक शास्त्री ओका पास आवीन उका सी कयो, “ए गुरू, जा काँ भी तु जाईस, हाव थारे पछोळ–पछोळ आवीस।”<verse eid="MAT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20"/>ईशु उका कयो, “कुल्यान करता ते धर छे आरू वादवान चिल्लान करता पांजरो छे, बाकुन मानुस क पोर्‍यान क करता माथो रखनेन भी जागो नी हय।”<verse eid="MAT 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21"/>एक आरू चेलो ईशु सी कयो, “ए पोरबु, मेखे पेहले जाने दे, कि म्हार बास क गाड़ देदा।”<verse eid="MAT 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22"/>ईशु ओका सी कयो, “तु म्हार पछोळ चाल; आरू मरलान क मरलाक गाड़ने दे।”<verse eid="MAT 8:22"/></para>
  <para style="s">आँधी तुफान क शांत करनो</para>
  <para style="r">(<ref loc="MRK 4:35-41">मरकुस 4:35-41</ref>; <ref loc="LUK 8:22-25">लूका 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23"/>जव त्यो ढोंड्या पर चढ़ियो, तो ओका चेला ओका पछोळ चालने लागिया। <verse eid="MAT 8:23"/><verse number="24" style="v" sid="MAT 8:24"/>आरू नदी मा एक मोटो वादुन उठियो कि ढोंड्या लेहरो सी ढाकायने लाग गय; आरू ईशु सूय रीयो हुतो। <verse eid="MAT 8:24"/><verse number="25" style="v" sid="MAT 8:25"/>तव त्या पास आवीन ईशु क जगाड़या, आरू कयो, “ए पोरबु, हामुक वाचाड़ हामू नाश हुय रीया।”<verse eid="MAT 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26"/>ईशु त्या लोगहन सी कयो, “ए विनभुरसीया, कायको बीहयो?” तव त्यो उठीन वादुन आरू पानी क लड़िया, आरू सब धीरो हुयो गियो। <verse eid="MAT 8:26"/><verse number="27" style="v" sid="MAT 8:27"/>अतरा पर चेला घबराय गिया, आरू कयनो लागिया, “यो कसलो मानुस छे? हवा आरू दरियो भी ओको हुकुम क माने।”<verse eid="MAT 8:27"/></para>
  <para style="s1">साहळा क सुहर्‍या क टुळा मा मोकलनो</para>
  <para style="r">(<ref loc="MRK 5:1-20">मरकुस 5:1-20</ref>; <ref loc="LUK 8:26-39">लूका 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28"/>जव दरियो पार करीन त्या गिरासेनियो क देश मा पुच्या। वा बीड़ा मा सी दुय मानुस निकळीन आया जिनु मा विटळ साहळा हुती ईशु क भेटिया, जो अतरा नाव सादिया हुता, कि कोय उना वाट सी जाय नी सकतो हुतो। <verse eid="MAT 8:28"/><verse number="29" style="v" sid="MAT 8:29"/>ईशु क देखी त्या दुयू आयड़ीन कयनो ला गिया, “ए यहोवा भगवान क पोर्‍या थारो हामरे साथ मा काय लेनो–देनो? काय तु टेम आवने सी पेहलुत् हामुक दुःख देने आय गियो?”<verse eid="MAT 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30"/>वा सारी थुड़ांक दूर गुवाळिया सुहर्‍या न एक टुळा क चरावता हुता। <verse eid="MAT 8:30"/><verse number="31" style="v" sid="MAT 8:31"/>साहळा ईशु सी विनती करने लागी, “कदाम तु हामुक बाहर निकाळ रियो ती हामुक इनु सुहर्‍या क टुळा मा मकली दे।”<verse eid="MAT 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32"/>ईशु साहळा क हुकुम दीदो, “जाओ!” त्या निकळी न सुहर्‍या मा भराय गय आरू देखो सब टुळो जुरे सी दवड़ीन टेकड़ी पर सी पानी कुद पड़ीयो आरू दरिया मा गलील डूबीन मर गिया।<verse eid="MAT 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33"/>सूहर्‍यान गुवाळिया ढास गिया आरू साहळा वाळो मनुसो क साथ मा काय हुयो शहरो मा जाईन त्या सारी वात कय दीदा। <verse eid="MAT 8:33"/><verse number="34" style="v" sid="MAT 8:34"/>अतरा पर नगर मा रयने वाळा सब ईशु सी भेटने करीन आया, आरू ओका सी विनती करीया हामरा शहरन काकड़ सी बाहर जात रया। <note caller="+" style="x"><char style="xo" closed="false">8:34 </char><char style="xt" closed="false"><ref loc="LUK 8:34">लूका 8:34</ref></char></note><verse eid="MAT 8:34"/></para>
  <chapter eid="MAT 8"/>
  <chapter number="9" style="c" sid="MAT 9"/>
  <para style="s">ईशु क लखवा सी बीमार मानुस क आरगो करनो</para>
  <para style="r">(<ref loc="MRK 2:1-12">मरकुस 2:1-12</ref>; <ref loc="LUK 5:17-26">लूका 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1"/>पछु त्यौ नाव पर चढ़ीन दिसरा पार गियो, आरू आपसा नगर मा आयो। <verse eid="MAT 9:1"/><verse number="2" style="v" sid="MAT 9:2"/>आरू काय लोगहन एक लखवा सी बीमार क खाटला पर उका पास मा लाय। ईशु उना क विश्वास देखीन, उना लखवा सी बीमार क कयो, “ए बेटा, हिम्मत राख; थारा पाप माफ हुया।”<verse eid="MAT 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3"/>आरू थुड़ांक शास्त्रीया विचार करिया, “यो ते यहोवा–भगवान न निन्दा करे।”<verse eid="MAT 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4"/>ईशु उना क मनन वात क जानीन कयो, “तुम लोगहन आपसा–आपसा मन मा बुरो विचार कहा करी रया? <verse eid="MAT 9:4"/><verse number="5" style="v" sid="MAT 9:5"/>वारू काय छे? ‘यो कयनो की थारा पाप माफ हुया,’ या यो कयनो, ‘उठ आरू चाल पछी।’ <verse eid="MAT 9:5"/><verse number="6" style="v" sid="MAT 9:6"/>बाकुन अतरानकरीन करीन की तुम जान ले कि मानुस क पोर्‍या क धरती पर पाप माफ करने क हक छे।” ईशु लखवा क बीमार सी कयो, “उठ, थार खाटलो उठाव आरू थार घर जा।”<verse eid="MAT 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7"/>त्यो उठीन आपसे घर चली गियो। <verse eid="MAT 9:7"/><verse number="8" style="v" sid="MAT 9:8"/>लोगहन यो देखीन बीह गिया आरू यहोवा भगवान महिमा करने लाग गिया जो मनुसक असो हक दियो।<verse eid="MAT 9:8"/></para>
  <para style="s">ईशु क मत्तीक बुलावनो</para>
  <para style="r">(<ref loc="MRK 2:13-17">मरकुस 2:13-17</ref>; <ref loc="LUK 5:27-32">लूका 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9"/>वा सी अगो जाईन ईशु मत्ती नावन एक मानुस क फाळान चौकी पर बठलो देखियो,</para>
  <para style="p" vid="MAT 9:9">आरू कयो, “म्हार पछोळ हुय ले।” त्यो उठीन उका पछोळ हुय लिदो।<verse eid="MAT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:10 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 15:1">लूका 15:1</ref>,<ref loc="LUK 15:2">2</ref></char>
    </note>आरू जव ईशु घर मा खाने करीन बठलो हुतो तो बैस सब फाळो लेनेवाळा आरू पापी लोगहन आवीन ईशु आरू उका चेलान क सात मा खाने क बठिया। <verse eid="MAT 9:10"/><verse number="11" style="v" sid="MAT 9:11"/>यो देखीन फरीसिया ईशु क चेलान सी कयो, “तुमरो गुरू फाळो लेनेवाळा आरू पापियोंन क सात मा खाय?”<verse eid="MAT 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12"/>यो सोमवीन ईशु फरीसियान क कयो, “वैद्य वारला आरगा क नी बाकुन बीमार लोगहन क करता जरूरी छे। <verse eid="MAT 9:12"/><verse number="13" style="v" sid="MAT 9:13"/>अतरानकरीन करीन तुम जाईन एको मतलब सिख लेय, कि हाव बलिदान नी बाकुन दया चाहो; काहकि हाव न्यायी क नी पुन पापियोन क बुलावने आयो।”<verse eid="MAT 9:13"/></para>
  <para style="s">उपवासन बारा मा सवाल करनो</para>
  <para style="r">(<ref loc="MRK 2:18-22">मरकुस 2:18-22</ref>; <ref loc="LUK 5:33-39">लूका 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14"/>तव बपतिस्मा देनेवावो यहुन्ना क चेला उका पास मा आवीन कयो, “काय कारण छे कि हामू आरू फरीसि अतरा उपवास करजे, पर थारा चेला उपवास नी करे?”<verse eid="MAT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15"/>ईशु इयाव मांडवाम लोगहन सी कयो, “काय वरात, जव तक लाड़ो उना क सात मा छे तो विखो करसे? पर त्यो दाहड़ा आवसे कि लाड़ो उन लोगहन सी अलग कर दियो जासे, उना समय मा त्या उपवास करसे।<verse eid="MAT 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16"/>“नया छिंदरा क पैबन्द जुनला छिंदरा पर कोय नी लगाड़, काहकि पैबन्द छिंदरा सी आरू काहय खीच लेय, आरू त्यो फाट जाय। <verse eid="MAT 9:16"/><verse number="17" style="v" sid="MAT 9:17"/>आरू नयो दाखरस पुराना मसको मा नी भरे; काहकि असो करने सी मशके फाट जाय, आरू अंगुरन रस वहय जाय आरू मशके नाश हुय जाय, बाकुन नयो अंगुरन रस नवली मशको मा भरे आरू त्यो दुयू वाच रये।”<verse eid="MAT 9:17"/></para>
  <para style="s">आधिकारी की मरली पोराय आरू ईशु न छिंदरा छिमने वाली बायोर</para>
  <para style="r">(<ref loc="MRK 5:21-43">मरकुस 5:21-43</ref>; <ref loc="LUK 8:40-56">लूका 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18"/>ईशु उन लोगहन सी वात करतो हुतो, कि एक सरदार आवीन उको नमस्कार करियो आरू कयो, “म्हार पोराय हाय मरी; बाकुन तु आवीन थार हाथ उना पर मेल दे, त्यो जीवतो हुय जासे।”<verse eid="MAT 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19"/>ईशु उठीन आपसा चेलान क सात मा ओको पछोळ हय लिदो।<verse eid="MAT 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20"/>आरू देखो, एक बायर जिनिक बारह साल सी लुहूय उहवने न की बीमारी हुती, ओको पछोळ सी आवीन ईशुन छिंदरा क कुनाक छिम लेदा। <verse eid="MAT 9:20"/><verse number="21" style="v" sid="MAT 9:21"/>काहकि त्यो आपसा मन मा कहवती हुती, कि कदाम हाव ओका छिंदरा छिम लीस तो आरगी हुय जाईस।<verse eid="MAT 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22"/>ईशु मुड़ीन ओको देखियो आरू कयो, “पोराय हिम्मत राख; थारो विश्वास तुखे आरगो करलो छे।” आरू त्या बायर उना समय मा आरगी हुय गय।<verse eid="MAT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23"/>जव ईशु उना सरदार क घर मा पुग गयो आरू पाव्वी वाजाड़ने वाला आरू गर्दी क हुल्लड़ मचाड़ता देखियो, <verse eid="MAT 9:23"/><verse number="24" style="v" sid="MAT 9:24"/>तव कयो, “छेटा हुय जात्यो, पोराय मरी नी, बाकुन सुय रई।” इना पर त्या लोगहन ईशुन हासी उड़ावने लाग गिया। <verse eid="MAT 9:24"/><verse number="25" style="v" sid="MAT 9:25"/>बाकुन जव गर्दी क बाहर निकाल दियो गयो, तो ईशु माहय जाईन पोराय क हाथ धरियो, आरू त्यो पोराय जीव उठी। <verse eid="MAT 9:25"/><verse number="26" style="v" sid="MAT 9:26"/>आरू इनी वातन चर्चा उना सब देश मा फैल गय।<verse eid="MAT 9:26"/></para>
  <para style="s">ईशु क दूय आंधवान वारू करनो</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27"/>जव ईशु वा सी अगोव गयो, ते दूय आंधवा क ओका पोछल यो आयड़ीन कयो, “ए दाऊदन अवलियाद, हामरे पर दया कर।”<verse eid="MAT 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28"/>जव ईशु घर मा पुगी गियो, तो उन आंधवा ओको पास आया, आरू ईशु उन लोगहन सी कयो, “काय तुमूक विश्वास छे, कि हाव यो कर सकीस?” त्या ओका सी कयो, “हाव पोरबु।”<verse eid="MAT 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29"/>तव ईशु उन लोगहन क डुवा क छिमियो आरू कयो, “तुमरा विश्वासन लारे तुमरे करता हुये।” <verse eid="MAT 9:29"/><verse number="30" style="v" sid="MAT 9:30"/>आरू उन लोगहन क डुवा खुली गिया आरू ईशु उन क वातड़ी चेतावनी दिन कयो, “चौकचोळिया रहवजो, कोय इनी वात क नी जाने।”<verse eid="MAT 9:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 9:31"/>बाकुन त्या लोगहन निकलीन सब क्षेत्र मा ओकी वात पैलाय दिया।<verse eid="MAT 9:31"/></para>
  <para style="s">गुंगड़ा मानुस क वारू करनो</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32"/>जव त्या बाहर जाय रया हुता, तव लोगहन एक मुका क मानस मा साहळा हुती ईशु क पास लाया। <verse eid="MAT 9:32"/><verse number="33" style="v" sid="MAT 9:33"/>आरू जव साहळा निकाल दी गय, तो मुका बुलने लागियो। आरू गर्दी घबराईन कयो, “इस्राएल मा भी असो कदी नी देखियो गयो।”<verse eid="MAT 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:34 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:25">मत्ती 10:25</ref>; <ref loc="MAT 12:24">12:24</ref>; <ref loc="MRK 3:22">मरकुस 3:22</ref>; <ref loc="LUK 11:15">लूका 11:15</ref></char>
    </note>बाकुन फरीसिया कयो, “यो तो साहळा क सरदारन बालजबूल क मदत सी साहळा क निकाले।”<verse eid="MAT 9:34"/></para>
  <para style="s">ईशुन दया</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:35 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:23">मत्ती 4:23</ref>; <ref loc="MRK 1:39">मरकुस 1:39</ref>; <ref loc="LUK 4:44">लूका 4:44</ref></char>
    </note>आरू ईशु सब गलील नगर आरू गावो मा पछु तो रयो आरू उन लोगहन की सभागृह मा शिक्षा देतो, आरू राज्य क परचार करतो, आरू आखी भातिन बीमारी आरू कमजोरी क दूर करतो रयो। <verse eid="MAT 9:35"/><verse number="36" style="v" sid="MAT 9:36"/>जव ईशु गर्दी क देखियो तो उको लोगहन पर तरस आयो, काहकि त्या उन गाडरा सारका हुता जिनुक कोय चरावने वालो नी हय, त्या घबरायला आरू भटकला सारका हुता। <verse eid="MAT 9:36"/><verse number="37" style="v" sid="MAT 9:37"/><note caller="+" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="LUK 10:2">लूका 10:2</ref></char></note>तव ईशु आपसा चेला क कयो, “कमाय ते बैस छे बाकुन दाहाड़क्या कम छे। <verse eid="MAT 9:37"/><verse number="38" style="v" sid="MAT 9:38"/>अतरानकरीन करीन कमाय क मालीक सी विनता करो कि त्यो खेत मा काम करने करीन दाहड़कियान क भेज देय।”<verse eid="MAT 9:38"/></para>
  <chapter eid="MAT 9"/>
  <chapter number="10" style="c" sid="MAT 10"/>
  <para style="s">बारह चेला</para>
  <para style="r">(<ref loc="MRK 3:13-19">मरकुस 3:13-19</ref>; <ref loc="LUK 6:12-16">लूका 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1"/>पछु ईशु आपसा बारा चेलान क पास बुलावीन, उन चेलान क विटळ आत्मा पर हक आपियो, कि उना क निकाले आरू सब भातिन बीमारी आरू सब भातिन कमजोरी क दूर करे। <verse eid="MAT 10:1"/><verse number="2" style="v" sid="MAT 10:2"/>उन बारा चेलान क नाव या छे पहलो शमौन, जो पतरस कहवाये, आरू ओको भाई अन्द्रियास; जबदी पोर्‍यो याकूब, आरू ओको भाई यहुन्ना <verse eid="MAT 10:2"/><verse number="3" style="v" sid="MAT 10:3"/>फिलिप्पुस आरू बरतुल्मै, थोमा आरू फाळो लेनेवाळो मत्ती, हलफई सन पोर्‍यो याकूब आरू तद्दै। <verse eid="MAT 10:3"/><verse number="4" style="v" sid="MAT 10:4"/>शमौन कनानी, आरू यहूदा इस्करियोती, जो ईशु क धरायो।<verse eid="MAT 10:4"/></para>
  <para style="s">बारा चेलान की सेवा</para>
  <para style="r">(<ref loc="MRK 6:7-13">मरकुस 6:7-13</ref>; <ref loc="LUK 9:1-6">लूका 9:1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5"/>उन बारा चेलान क ईशु यी सलाह आपीन मोकल्यो, “गैरयहुदी तरफ नी जानो, आरू सामरिया न काहना भी नगर मा नी भरायनो <verse eid="MAT 10:5"/><verse number="6" style="v" sid="MAT 10:6"/>बाकुन इस्राएल क घरानान खुवायला गाडरान क पास जाजो। <verse eid="MAT 10:6"/><verse number="7" style="v" sid="MAT 10:7"/>आरू चालता–चालता परचार करिन कयजो कि सोरगदूत राज साते आवी गयलो छे। <verse eid="MAT 10:7"/><verse number="8" style="v" sid="MAT 10:8"/>बीमार लोगहन क आरगा करो: मरला क जीवाड़ो, कुड़ावा क चुखा करो, साहळा क निकल्यो। तुमू फोकट मा लिदला छे, तो फोकट मा आपो।” <verse eid="MAT 10:8"/><verse number="9" style="v" sid="MAT 10:9"/>तुमरा बटवा मा नी तो सोनो, आरू नी रूपो, आरू न तांबा रखना। <verse eid="MAT 10:9"/><verse number="10" style="v" sid="MAT 10:10"/><note caller="+" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="1CO 9:14">1 कुरन्थियो 9:14</ref>; <ref loc="1TI 5:18">1 तीमुथियुस 5:18</ref></char></note>वाट्ये जुगु न झोलो राखु, नी दूय सुटर, नी खासड़ा आरू नी लाकड़ी राखु, काहकि दाहड़क्यान क उको खानो जुड़नो जुवे।<verse eid="MAT 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11"/>“जिना काहना भी नगर मा या गाँव मा जावो तो पतो लागावे कि वा कुन योग्य छे? आरू जव तक वा सी नी निकलो, उना क या रहवजो।” <verse eid="MAT 10:11"/><verse number="12" style="v" sid="MAT 10:12"/>आरू घर मा भरायता टेमे ओको बरकत देजो। <verse eid="MAT 10:12"/><verse number="13" style="v" sid="MAT 10:13"/>कदाम उना घर क लोगहन योग्य हुयसे तो तुमरो बरकत उना घर पर पुगसे बाकुन त्या योग्य नी हय तो तुमरो बरकत तुमरे पास पछो आय जासे। <verse eid="MAT 10:13"/><verse number="14" style="v" sid="MAT 10:14"/><note caller="+" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="ACT 13:51">प्रेरितन 13:51</ref></char></note>आरू जो कोय तुमरो आव भाव नी करे, आरू तुमरी वात क नी सुने, उना घर या नगर सी निकलता जाईन तुमरा पायन धुल झाटकी देजो। <verse eid="MAT 10:14"/><verse number="15" style="v" sid="MAT 10:15"/><note caller="+" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 11:24">मत्ती 11:24</ref></char></note><note caller="+" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="LUK 10:4-12">लूका 10:4-12</ref></char></note>हाव तुमरे सी सच कहवो, कि नियाव क दिन उना नगर की हालत सी सदोम आरू गमोरान क नगरो की हालत जादा झेलने जुगु हयसे।<verse eid="MAT 10:15"/></para>
  <para style="s">आवने वालो सताव</para>
  <para style="r">(<ref loc="MRK 13:9-13">मरकुस 13:9-13</ref>; <ref loc="LUK 21:12-17">लूका 21:12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:16 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:3">लूका 10:3</ref>
      </char>
    </note>“देखो, हाव तुमूक गाडरान जसो लेन्डीया बीच मा भेजो अतरानकरीन करीन घड़सान जसा अकल वाला आरू पेरवान जसा भला बनो।” <verse eid="MAT 10:16"/><verse number="17" style="v" sid="MAT 10:17"/><note caller="+" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="MRK 13:9-11">मरकुस 13:9-11</ref>; <ref loc="LUK 12:11">लूका 12:11</ref>,<ref loc="LUK 12:12">12</ref>; <ref loc="LUK 21:12-15">21:12-15</ref></char></note>बाकुन लोगहन सी चौकचोळिया रहवो, काहकि त्या तुमक क मिटिंग मा सौप देसे, आरू उको आराधना घरो मा मार न्हाख से। <verse eid="MAT 10:17"/><verse number="18" style="v" sid="MAT 10:18"/>तुमू म्हार करता आधिकारिया आरू राजान क सामने उना पर आरू गैरयहुदी पर गवाय हुयने क करता हजुर करिया जासो। <verse eid="MAT 10:18"/><verse number="19" style="v" sid="MAT 10:19"/>जव त्या लोगहन तुमूक धरावसे तो यी चिंता नी करनो कि कसा बोलनो आरू काय कयसु; काहकि जो काय तुम क कयनो छे त्यो उना टेमे तुमूक कय दियो जासे। <verse eid="MAT 10:19"/><verse number="20" style="v" sid="MAT 10:20"/>काहकि बोलनेवाला तुमू नी बाकुन तुमरा बासन चुखलो आत्मा लारे बुलसे।<verse eid="MAT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:21 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 13:12">मरकुस 13:12</ref>; <ref loc="LUK 21:16">लूका 21:16</ref></char>
    </note>भाई आपसा भाई क आरू बास आपसा पोर्‍या क, मारने करीन सौप देसे, आरू पोर्‍या पारी माता–पिता क विरोध मा उठीन माराय देसे। <verse eid="MAT 10:21"/><verse number="22" style="v" sid="MAT 10:22"/><note caller="+" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="MAT 24:9">मत्ती 24:9</ref>; <ref loc="MRK 13:13">मरकुस 13:13</ref>; <ref loc="LUK 21:17">लूका 21:17</ref>; </char><char style="xt" closed="false"><ref loc="MAT 24:13">मत्ती 24:13</ref>; <ref loc="MRK 13:13">मरकुस 13:13</ref></char></note>म्हार नाव क कारण सब लोगहन तुमरे सी बैर राखसे, पर जो आखरी तक गम राखसे उना क छुटकारो हुयसे। <verse eid="MAT 10:22"/><verse number="23" style="v" sid="MAT 10:23"/>जव त्या लोगहन तुमूक एक नगर मा सतावसे, तो दिसरा नगर क भाग जाजो। हाव तुमरे सी सच कहवो, तुमु ओका पोर्‍या क आवने सी पेहले इस्त्राएली न सब नगर मा सी गया भी नी हुयसे।<verse eid="MAT 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:24 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 6:40">लूका 6:40</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="JHN 13:16">यहुन्ना 13:16</ref>; <ref loc="JHN 15:20">15:20</ref></char>
    </note>चेला आपसा गुरू सी मटो नी; आरू नी दास आपसा मालिक सी। <verse eid="MAT 10:24"/><verse number="25" style="v" sid="MAT 10:25"/><note caller="+" style="x"><char style="xo" closed="false">10:25 </char><char style="xt" closed="false"><ref loc="MAT 9:34">मत्ती 9:34</ref>; <ref loc="MAT 12:24">12:24</ref>; <ref loc="MRK 3:22">मरकुस 3:22</ref>; <ref loc="LUK 11:15">लूका 11:15</ref></char></note>चेला क गुरू क, आरू दास क मालिक न बराबर हुयनो बैस छे; जव त्या लोगहन घर मालिक क बालजबुल कयो तो उका घर वाला क काँ नी कहवसे?<verse eid="MAT 10:25"/></para>
  <para style="s">कुनी सी डरनो</para>
  <para style="r">(<ref loc="LUK 12:2-7">लूका 12:2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:26 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 4:22">मरकुस 4:22</ref>; <ref loc="LUK 8:17">लूका 8:17</ref></char>
    </note>अतरानकरीन उना सी मा बीहयो, ओसो काहय भी गुप्त नी छे, जो खुलियो नी जाय; जो उजावा मा नी लायो जासे आरू ओसो काहिज लिकाड़लो नी जासे, जो सामने नी लाव जासे। <verse eid="MAT 10:26"/><verse number="27" style="v" sid="MAT 10:27"/>जो हाव तुमरे सी कहवो, उको विजाळा मा कहवो; आरू जो कानो सी सुनो, उना क छतो पर सी परचार करो। <verse eid="MAT 10:27"/><verse number="28" style="v" sid="MAT 10:28"/>जो डील क मार सके, बाकुन आत्मा क नी मार सके, उना सी मा बीहयो; पर उना सी बीहयो जो आत्मा आरू डील दूयन क नरक मा नाश कर सके। <verse eid="MAT 10:28"/><verse number="29" style="v" sid="MAT 10:29"/>काय एक पयसिया मा सी दूय चिल्‍ला नी वेचाये? पछु भी तुमरो बास इच्छान बिना उना मा सी एक भी धरती पर नी पड़ सके। <verse eid="MAT 10:29"/><verse number="30" style="v" sid="MAT 10:30"/>तुमरा माथा क झोठा भी सब गिनला छे। <verse eid="MAT 10:30"/><verse number="31" style="v" sid="MAT 10:31"/>अतरानकरीन करीन, बीहयो मा; तुमू बैस चिल्लान सी भी जादा मुवन छे। <figure style="fig" alt="Flat-roofed, olden house in Israel" file="lb00234c.tif" size="col" copy="Horace Knowles ©" ref="10:27">इस्राएल मा जुन्ला जमानान सपाट छतवावो घर </figure><verse eid="MAT 10:31"/></para>
  <para style="s">ईशु क माननो आरू नी माननो</para>
  <para style="r">(<ref loc="LUK 12:8-9">लूका 12:8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32"/>“जो कुई मखे लोगहन क सामने मेखे मान देसे, उका हाव भी म्हार सोरगीय बासन क सामने मान लिस। <verse eid="MAT 10:32"/><verse number="33" style="v" sid="MAT 10:33"/><note caller="+" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="2TI 2:12">2 तीमुथियुस 2:12</ref></char></note>पर जो कोय मनुस क सामने मखे मना करसे उना क हाव भी म्हार सोरगीय बासन क सामने मना करीस।”<verse eid="MAT 10:33"/></para>
  <para style="s">शांती नी पण तलवार</para>
  <para style="r">(<ref loc="LUK 12:51-53">लूका 12:51-53</ref>; <ref loc="LUK 14:26-27">14:26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34"/>“यो मा समझु, कि हाव धरती पर शांती करवाने आवलो छे; हाव शांती करावने नी, पर तलवार चलाड़ने क आवलो छे। <verse eid="MAT 10:34"/><verse number="35" style="v" sid="MAT 10:35"/>हाव तो आयो, कि मानुस क उका बास सी, आरू पोराय क ओकी माय या बास सी, आरू ववड़ी क ओकी सास सी अलग कर दियोव। <verse eid="MAT 10:35"/><verse number="36" style="v" sid="MAT 10:36"/>मानुस क दुस्मन उका घर कोत लोगहन हुयसे।”<verse eid="MAT 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37"/>“जो आश या बास क म्हार सी जादा मोंगाळो जाने, त्यो म्हार योग्य नी आरू जो पोर्‍या या पोराय क म्हार सी जादा मोंगाळो जाने, त्यौ म्हार योग्य नी हय” <verse eid="MAT 10:37"/><verse number="38" style="v" sid="MAT 10:38"/><note caller="+" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="MAT 16:24">मत्ती 16:24</ref>; <ref loc="MRK 8:34">मरकुस 8:34</ref>; <ref loc="LUK 9:23">लूका 9:23</ref></char></note>आरू जो आपसो कुरूस लीन म्हार पछोळ नी चाले त्यौ म्हार योग्य नी हय। <verse eid="MAT 10:38"/><verse number="39" style="v" sid="MAT 10:39"/><note caller="+" style="x"><char style="xo" closed="false">10:39 </char><char style="xt" closed="false"><ref loc="MAT 16:25">मत्ती 16:25</ref>; <ref loc="MRK 8:35">मरकुस 8:35</ref>; <ref loc="LUK 9:24">लूका 9:24</ref>; <ref loc="LUK 17:33">17:33</ref>; <ref loc="JHN 12:25">यहुन्ना 12:25</ref></char></note>जो आपसा जीव क वाचाड़े, त्यौ उना क खुय देसे; आरू जो म्हार कारण सी आपसा जीव क खुय देय, त्यौ उना क पाय लेसे।<verse eid="MAT 10:39"/></para>
  <para style="s">हर फोव</para>
  <para style="r">(<ref loc="MRK 9:41">मरकुस 9:41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:40 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:16">लूका 10:16</ref>; <ref loc="JHN 13:20">यहुन्ना 13:20</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:37">मरकुस 9:37</ref>; <ref loc="LUK 9:48">लूका 9:48</ref></char>
    </note>जु तुमरो स्वागत करे, त्यौ मखे माने; आरू जो मखे माने, त्यौ मखे भेजने वाला क माने। <verse eid="MAT 10:40"/><verse number="41" style="v" sid="MAT 10:41"/>ओ कागळीयान क कागळिया जानीन माने, उको कागळीयान क बदलो मुवसे; आरू जो न्यायी जानीन न्यायी क माने, त्यो क न्यायी क बदलो मुवसे। <verse eid="MAT 10:41"/><verse number="42" style="v" sid="MAT 10:42"/>जु कुई उन नाना मा सी एक क चेलो जानीन केवल एक कटोरो ठण्डो पानी पिलावे, हाव तिमरे सी सच कहवो, त्यो उको इनाम कदी नी खुवे।<verse eid="MAT 10:42"/></para>
  <chapter eid="MAT 10"/>
  <chapter number="11" style="c" sid="MAT 11"/>
  <para style="s">यहुन्ना बपतिस्मा देने वाला क सवाल</para>
  <para style="r">(<ref loc="LUK 7:18-35">लूका 7:18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1"/>जव ईशु आपसा बारा चेलान क हुकम दि त्योकियो, तो त्यो उन लोगहन क नगरो मा शिक्षा आरू परचार करने क वाँ सी चली गियो।<verse eid="MAT 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2"/>यहुन्ना जेल खाना मा सी ईशुन क काम क बारा मा यो खुश खबर सोमवीन आपसा चेलान क यो पुचने क मुकल्यो, <verse eid="MAT 11:2"/><verse number="3" style="v" sid="MAT 11:3"/>“काय आवनेवालो तुत छे या दूसरान वाट देखजे?”<verse eid="MAT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4"/>ईशु जवाब देदो, “जो काय तुमू सोमव्या, आरू देखु, त्यो सब जानीन यहुन्ना क कय देदो। <verse eid="MAT 11:4"/><verse number="5" style="v" sid="MAT 11:5"/>कि आंधवा देखता हुय रिया आरू लेंगड़ा चालता हुय रिया, कुड़ावान क वारला कर देदा जाय आरू बेहरा सोमवी रयो, मरलान क जीवाड़े, आरू गरीब लोगहन क खुश खबर सुनावे। <verse eid="MAT 11:5"/><verse number="6" style="v" sid="MAT 11:6"/>आरू सयाला छे त्या, जो म्हार कारण सी ठुकर नी खाय।”<verse eid="MAT 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7"/>जव त्या वा सी जात रया, यो ईशु यहुन्ना क बारा मा लोगहन सी कयनो लाग गियो, “तुम जंगल मा काय देखने क गिया हुता? काय हवा सी हालता हुवा डाखलिया क देखने? <verse eid="MAT 11:7"/><verse number="8" style="v" sid="MAT 11:8"/>पछु काय देखने क गयो हुतो? जो सुवाला छिंदरा पेहरे, त्या राजान भवन मा रये।” <verse eid="MAT 11:8"/><verse number="9" style="v" sid="MAT 11:9"/>ते आरू काय देखने क गयो हुतो? काय कागळीयान क देखने क? होव हाव तुम सी कहवो, बाकुन कागळीयान सी भी मटला क। <verse eid="MAT 11:9"/><verse number="10" style="v" sid="MAT 11:10"/>यो त्यो, जेका बारा मा लिखियो छे, कि देख, हाव म्हार सोरगदूत क थारे अगोळ भेजो जो थारे अगोळ थारी वाट तियार करसे। <note caller="+" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="MAL 3:1">मलाकी 3:1</ref></char></note> <verse eid="MAT 11:10"/><verse number="11" style="v" sid="MAT 11:11"/>हाव तुमूक सच कहवो, कि जो बाई जात सी जनम लिदो, उना मा सी यहुन्ना बपतिस्मा देनेवाला सी कोय बड़ो नी हय; पर जो सोरगन राज मा नाना सी नानो छे त्यो उना सी बड़ो छे। <verse eid="MAT 11:11"/><verse number="12" style="v" sid="MAT 11:12"/>यहुन्ना बपतिस्मा देनेवालान क दाहड़ा सी हाय तक सोरगदूतन राज मा ताकत क सात मा भराये, आरू ताकद वावो उको हापकी लेदो। <verse eid="MAT 11:12"/><verse number="13" style="v" sid="MAT 11:13"/>यहुन्ना तक सब कागळिया आरू नियम कागळिया करता रया।<verse eid="MAT 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 11:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 17:10-13">मत्ती 17:10-13</ref>; <ref loc="MRK 9:11-13">मरकुस 9:11-13</ref></char>
    </note>आरू चाहे तो मानो, एलियाह जो आवने वालो हुतो, त्यो यो छे। <verse eid="MAT 11:14"/><verse number="15" style="v" sid="MAT 11:15"/>जेका कान हय त्यो सोनवु ले।<verse eid="MAT 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16"/>“हाव इना समय क लोगहन क किन क समान कहवो? त्या जो बजारो मा बठीन एक दिसरा क आयड़ीन कयता रये, <verse eid="MAT 11:16"/><verse number="17" style="v" sid="MAT 11:17"/>कि हामु तुमरे वाटे पाव्वी वाजाड़ी, आरू तुम नी नाचिया; हामू विलाप करिया, आरू तुम छाती नी थपड़ाया। <verse eid="MAT 11:17"/><verse number="18" style="v" sid="MAT 11:18"/>काहकि यहुन्ना नी खातो आयो आरू नी पीतो, आरू त्या कहवे कि उना मा साहळा छे। <verse eid="MAT 11:18"/><verse number="19" style="v" sid="MAT 11:19"/>मानुस क पोर्‍यो खातो–पीतो आयो, आरू त्या कहवे कि देखो, खादड़ियो आरू पीनियो मनुस, फाळो लेनेवाळा आरू पापी लोगहन क दोस्त! पर गियान आपसो कामो मा सच बनी गियो।”<verse eid="MAT 11:19"/></para>
  <para style="s">विनभुरसीया नगरे</para>
  <para style="r">(<ref loc="LUK 10:13-15">लूका 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20"/>तव उन नगरो क धिक्‍कार कयनो लागियो, जिनमा घण सवटा शक्ति क काम करिया हुता; पुन त्या लोगहन आपसो मन नी फिराया हुता। <verse eid="MAT 11:20"/><verse number="21" style="v" sid="MAT 11:21"/>“हाय, खुराजीन! विखु बैतसैदा! जो शक्तिन क काम करियो आरू कदाम त्यो सोर आरू सीदोन मा करे, तो गंटो पांगरीन, आरू रूखड़ा मा बठीन, त्या कब क मन फिराय लेता। <verse eid="MAT 11:21"/><verse number="22" style="v" sid="MAT 11:22"/>बाकुन हाव तुम सी सच कहवो; कि नियाव क दिन तुमरी हालत सी सोर आरू सीदोन की हालत जादा वेठने योग्य हुयसे। <verse eid="MAT 11:22"/><verse number="23" style="v" sid="MAT 11:23"/>आरू ए कफरनहूम, काय तु सोरग तक ऊँचो करीयो जाएगा? तु तो नरक तक नेचो जाइस; जो शक्तिन क काम थारा पर करला छे, कदाम सदोम मा करला हुता, तो त्यो आज तक बनलो रहवतो। <verse eid="MAT 11:23"/><verse number="24" style="v" sid="MAT 11:24"/>पर हाव तुको कहवो, कि नियाव क दिन थारी दशा सी सदोम की दशा जादा सहने योग्य हुयसे।”<verse eid="MAT 11:24"/></para>
  <para style="s">मार पास आवो आरू आराम लेय</para>
  <para style="r">(<ref loc="LUK 10:21-22">लूका 10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25"/>उना समय मा ईशु कयो, “ए बास, सोरग आरू धरती क पोरबु, हाव थारो धन्यवाद करो, काहकि तु इन वातन क अकलवाला आरू समझदारों सी सातीन रखियो, आरू पोर्‍या पर उजन्तो नी करीया। <verse eid="MAT 11:25"/><verse number="26" style="v" sid="MAT 11:26"/>होव, ए बास, काहकि तुखे यो वारू लाग्यो।<verse eid="MAT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:27 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 3:35">यहुन्ना 3:35</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:18">यहुन्ना 1:18</ref>; <ref loc="JHN 10:15">10:15</ref></char>
    </note>“म्हार बास मेखे सब आप देदलो छे, आरू कोय पोर्‍या क नी जाने, बास अतरो जाने आरू कोय बास क नी जाने, पोर्‍यो अतरो जाने आरू त्यो जिना पर पोर्‍या क देखड़नो चाहे।<verse eid="MAT 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28"/>“ए सब मेहनत करने वाला आरू भार तले डाबायला लोगहन, मार पास आवो; हाव तुमको आराम दियोगा। <verse eid="MAT 11:28"/><verse number="29" style="v" sid="MAT 11:29"/>म्हार जुवड़ो तुमरे पर ऊठाय लेदो; आरू म्हार सी सीखो; काहकि हाव नरम आरू दीन छे; आरू तुमू मन मा शांती ली लेदो। <verse eid="MAT 11:29"/><verse number="30" style="v" sid="MAT 11:30"/>काहकि म्हरो जुवड़ो वारू आरू म्हारो भार हल्को छे।”<verse eid="MAT 11:30"/></para>
  <chapter eid="MAT 11"/>
  <chapter number="12" style="c" sid="MAT 12"/>
  <para style="s">आराम न दाहड़ा क बारा मा सवाल</para>
  <para style="r">(<ref loc="MRK 2:23-28">मरकुस 2:23-28</ref>; <ref loc="LUK 6:1-5">लूका 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1"/>उका समय ईशु आरामन दिन खेतो मा सी हुयन जातो हुतो, आरू ओका चेला क भुख लागी, आरू त्या उम्बीया तोड़ीन खाने लाग गिया। <verse eid="MAT 12:1"/><verse number="2" style="v" sid="MAT 12:2"/>तव फरीसिया यो देखीन ईशु सी कयो, “देख थारा चेला त्यो काम कर रिया, जो सब्त क दाहड़े करनो वारू नी हय।” <verse eid="MAT 12:2"/><verse number="3" style="v" sid="MAT 12:3"/>ईशु कयो, “काय तुमू नी भोन्या, के दाऊद भी, जव त्यो आरू उका साथी भुकला हुता ती काय करिया?” <verse eid="MAT 12:3"/><verse number="4" style="v" sid="MAT 12:4"/>त्यो कसो यहोवा भगवानन भवन मा गिया, आरू भेंटोन रोटा खादा, जेको खानो नी तो ओको आरू नी उका साथी क, खानो वारू नी हुतो बाकुन पुजारा अतरा खाय सकता हुता?<verse eid="MAT 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 12:5"/>या काय तुमू नियम क नी भणिया, कि पुजारा सब्त क दाहाड़े मंदिर मा सब्त क नियम क तोड़ने पर भी निर्दोष ठरता छे? <verse eid="MAT 12:5"/><verse number="6" style="v" sid="MAT 12:6"/>“बाकुन हाव तुम सी यो कहवो, कि या त्यो छे, जो मंदिर सी भी बड़ो छे। <verse eid="MAT 12:6"/><verse number="7" style="v" sid="MAT 12:7"/><note caller="+" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="MAT 9:13">मत्ती 9:13</ref></char></note>यदि तुमू ओको मतलब जानो कि हाव दया सी खुशी हुयो, बलिदान सी नी, तो तुमू निर्दोष क निर्दोष नी ठहरावे। <verse eid="MAT 12:7"/><verse number="8" style="v" sid="MAT 12:8"/>लोगहन क पोर्‍यो तो सब्त क दिन क भी पोरबुन।”<verse eid="MAT 12:8"/></para>
  <para style="s">सुखा हाथ वालो मानुस न आरगाय</para>
  <para style="r">(<ref loc="MRK 3:1-6">मरकुस 3:1-6</ref>; <ref loc="LUK 6:6-11">लूका 6:6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9"/>वा सी चालीन ईशु यहूदि लोगहन क आराधना घर मा आयो। <verse eid="MAT 12:9"/><verse number="10" style="v" sid="MAT 12:10"/>वा एक मानुस हुतो, जिनान हाथ सुखलो हुतो; आरू त्या उना पर दोष लगाड़ने करीन उका सी पुछिया, “काय आराम क दाहड़े आरगा करनो वारू छे?”<verse eid="MAT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:11 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 14:5">लूका 14:5</ref>
      </char>
    </note>ईशु उन लोगहन सी कयो, “तुमरे माईन असो कुन छे, जिनाक एक गाडरो हय, आरू त्यो उना क धरीन निकाल? <verse eid="MAT 12:11"/><verse number="12" style="v" sid="MAT 12:12"/>वारला, मनुस क दाम गाडरा सी बढ़ीन छे! अतरानकरीन करिन भलाय करनो वारू छे।”<verse eid="MAT 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13"/>तव ईशु उना मानस क कयो, “थारो हाथ बढ़ाव।” त्यो मानुस हाथ बढायो, आरू त्यो पछु दूसरो हाथ क मसान वारू हुय गियो। <verse eid="MAT 12:13"/><verse number="14" style="v" sid="MAT 12:14"/>तव फरीसिया बाहर जाईन उका विरोध मा एकु करिया, कि उनाक किने रीति सी मार न्हाख जे?<verse eid="MAT 12:14"/></para>
  <para style="s">यहोवा–भगवानन निवाड़लो सेवक</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15"/>यो जानीन ईशु वाँ सी निकली गयु। आरू बैस लोगहन ओको पछोळ चाल देदु, आरू ईशु सब क आरगा करियो। <verse eid="MAT 12:15"/><verse number="16" style="v" sid="MAT 12:16"/>आरू उन लोगहन क चेतावनी आपीन कयो, कि म्हार बाराम किन क नी कयनो। <verse eid="MAT 12:16"/><verse number="17" style="v" sid="MAT 12:17"/>कि जो वचन यशायाह कागळीयान क लारे कही गियो हुतो, वा पूरो हुये:<verse eid="MAT 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18"/>“देखो, यो म्हारो सेवक छे,</para>
  <para style="q2" vid="MAT 12:18">जिनाक हाव चुनी लेदला छे; म्हारो मोंगावु,</para>
  <para style="q1" vid="MAT 12:18">जिनाक म्हार मन खुश छे; हाव म्हार आत्मा उना पर डालीस;</para>
  <para style="q2" vid="MAT 12:18">आरू त्यो गैरयहुदी क नियाव क खबर देयगो। <note caller="+" style="x"><char style="xo" closed="false">12:18 </char><char style="xt" closed="false"><ref loc="ISA 42:1-4">यशायाह 42:1-4</ref></char></note><verse eid="MAT 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19"/>त्यो नी झगड़ो करे,</para>
  <para style="q2" vid="MAT 12:19">आरू नी आयड़े आरू नी बजारो मा कोय ओको सब्द सुने।<verse eid="MAT 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20"/>त्यो कुचलायली डाखली क नी तोड़े;</para>
  <para style="q2" vid="MAT 12:20">आरू धुँवाड़ो छुड़ती हुयी बत्ती क नी बुझावे,</para>
  <para style="q1" vid="MAT 12:20">जव तक नियाव क वातड़ो नी करावे।<verse eid="MAT 12:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21"/>आरू गैरयहुदी ओको नाव पर आश राखसे।”<verse eid="MAT 12:21"/></para>
  <para style="s">ईशु आरू बालजबुल</para>
  <para style="r">(<ref loc="MRK 3:20-30">मरकुस 3:20-30</ref>; <ref loc="LUK 11:14-28">लूका 11:14-28</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22"/>तव लोगहन एक मुका क जिनाम साहळा हुती, ओको पास लाया; आरू ईशु उना क वारू करियो; आरू त्यो मुका बोलने लाग गियो। <verse eid="MAT 12:22"/><verse number="23" style="v" sid="MAT 12:23"/>इना पर सब लोगहन घबरायन कयनो लाग गिया, “यो काय दाऊदन अवलियाद छे?”<verse eid="MAT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:24 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:34">मत्ती 9:34</ref>; <ref loc="MAT 10:25">10:25</ref></char>
    </note>बाकुन फरीसिया यो सोमवीन कयो, “यो तो विटळ आत्मा क सरदार शैतान सी मदत लीन साहळा क निकाले।”<verse eid="MAT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25"/>ईशु उन लोगहन की मन की वात क जानीन उना सी कयो, “जिना राज्य मा फूट पड़ी, त्यो उजाड़ हुय जाय, आरू कोय नगर या घरानो जिनमा फुट हुये बनी नी रये। <verse eid="MAT 12:25"/><verse number="26" style="v" sid="MAT 12:26"/>आरू यदि शैतान ही शैतन क निकाले, ते त्यो आपसा विरोध मा हुय गियो; पछु ओको राज कसो बनलो रहवसे? <verse eid="MAT 12:26"/><verse number="27" style="v" sid="MAT 12:27"/>भलो कदाम हाव बालजबुल की मदत सी साहळा क निकालो, तो तुमरी अवलियादन सहायता सी निकाले? अतरानकरीन करीन त्या तुमरो नियाव करसे। <verse eid="MAT 12:27"/><verse number="28" style="v" sid="MAT 12:28"/>पर कदाम हाव यहोवा–भगवान नी आत्मान मदत सी साहळा क निकालो, तो यहोवा–भगवान क राज तुमरे पास आवी गियो।”<verse eid="MAT 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29"/>या कसो कोय मानुस कोय ताकत वाला क घर मा भराइन उका माल धन क लुट सके जव तक कि पेहले उना ताकत वाला क बांधी नी लेय? आरू तव त्यो उना घर क लुट लेसे।<verse eid="MAT 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:30 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:40">मरकुस 9:40</ref>
      </char>
    </note>जो म्हार साथ नी हय, त्यो म्हारा विरोध मा छे; आरू जो मार साथे नी एखटा करे, त्यो बिसचे। <verse eid="MAT 12:30"/><verse number="31" style="v" sid="MAT 12:31"/>अतरानकरीन करीन हाव तुमरे सी कहवो, कि मानुस क सब भातिन पाप आरू वायकेड़ा माफ कर दियो जासे, पर चुखलो आत्मा न निंदा करसे उको माफ नी करियो जासे। <verse eid="MAT 12:31"/><verse number="32" style="v" sid="MAT 12:32"/><note caller="+" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="LUK 12:10">लूका 12:10</ref></char></note>जो कोय मानुस क पोर्‍या क विरोध मा काहय वात कयसे उको त्यो पाप माफ कर दियो जासे, बाकुन जो कोय चुखली आत्मान विरोध मा कहवसे, उको पाप नी तो इनी धरती पर मा नी तो आवनेवाळा सोरग लोक मा माफ करियो जाय।<verse eid="MAT 12:32"/></para>
  <para style="s">झाड़को आरू फव</para>
  <para style="r">(<ref loc="LUK 6:43-45">लूका 6:43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:33 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:20">मत्ती 7:20</ref>; <ref loc="LUK 6:44">लूका 6:44</ref></char>
    </note>“कदाम झाड़का क वारू कहे, तो उको फव क भी वारू कहवो, या झाड़को क बुरो हसे, तो उका फव क भी बुरो हुयसे; काहकि झाड़को सी ओकी उळखान हुये। <verse eid="MAT 12:33"/><verse number="34" style="v" sid="MAT 12:34"/><note caller="+" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="MAT 3:7">मत्ती 3:7</ref>; <ref loc="MAT 23:33">23:33</ref>; <ref loc="LUK 3:7">लूका 3:7</ref>; </char><char style="xt" closed="false"><ref loc="MAT 15:18">मत्ती 15:18</ref>; <ref loc="LUK 6:45">लूका 6:45</ref></char></note>ए घड़सान पोर्‍या, तुमू बुरा हयन भी असी कसी वारली वात करी रीया? काहकि जो मन मा भरायलो छे, त्योत् मुय पर आवे। <verse eid="MAT 12:34"/><verse number="35" style="v" sid="MAT 12:35"/>आरू मानुस क मन मा वारला भण्डार सी वारली वात निकले; आरू बुरा मानुस क मन सी बुरी वात निकले।”<verse eid="MAT 12:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 12:36"/>आरू हाव तुमरे सी सच कहवो, जो–जो निकम्मी वात मानुस कहवसे, नियाव क दिन हर एक वात क लेखो देसे। <verse eid="MAT 12:36"/><verse number="37" style="v" sid="MAT 12:37"/>काहकि तु आपसी वात क कारण निर्दोष आरू आपसी वातन क कारण दोषी ठहराया जासे।<verse eid="MAT 12:37"/></para>
  <para style="s">ईशु सी सोरग न सहलानी मांगनो</para>
  <para style="r">(<ref loc="MRK 8:11-12">मरकुस 8:11-12</ref>; <ref loc="LUK 11:29-32">लूका 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:38 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:1">मत्ती 16:1</ref>; <ref loc="MRK 8:11">मरकुस 8:11</ref>; <ref loc="LUK 11:16">लूका 11:16</ref></char>
    </note>इना पर काहय शास्त्रीया आरू फरीसियो ओका सी कयो, “ए गुरू! हामू थारा सी एक सोहलाणी देखने चाह रिया।”<verse eid="MAT 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:39 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:4">मत्ती 16:4</ref>; <ref loc="MRK 8:12">मरकुस 8:12</ref></char>
    </note>ईशु ओका जवाब देदो, “इना जमाना क बुरा आरू व्यभिचारी लोगहन सोहलानी क हेरे; बाकुन योना कागळीयान क सोहलानी क छुड़ीन कोय आरू सोहलानी न दियो जासे <verse eid="MAT 12:39"/><verse number="40" style="v" sid="MAT 12:40"/>योना तीन रात–दिन मटलो माछली क पेटा मा रयो, वसोत मानुस क पोर्‍यो तीन रात–दिन धरती क माहय रहसे। <verse eid="MAT 12:40"/><verse number="41" style="v" sid="MAT 12:41"/>नीनवे क लोगहन नियाव क दिन इना जमाना क लोगहन क साथ मा दोषी बनावसे, काहकि त्या लोगहन योना क परचार सोमवीन, मन पछु फिराया या आरू या त्यो छे जो यहुन्ना सी भी बड़ो छे। <verse eid="MAT 12:41"/><verse number="42" style="v" sid="MAT 12:42"/>दक्षिण रानी नियाव क दाहाड़ा इना जमाना क लोगहन क साथ मा उठीन उना क दोषी बनावसे, काहकि त्यो सुलैमान क गियान सुनने क करता धरती न पार सी आवी, आरू या त्यो छे जो सुलैमान सी भी बड़ो छे<verse eid="MAT 12:42"/></para>
  <para style="s">दृष्टात्मान पछो आवनो</para>
  <para style="r">(<ref loc="LUK 11:24-26">लूका 11:24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43"/>“जव साहळा मानुस मा सी निकलीन जात रये, तो सुकला धरती मा आराम क हेरती पछु, आरू ओको मुवे नी। <verse eid="MAT 12:43"/><verse number="44" style="v" sid="MAT 12:44"/>तव कहवे, कि हाव म्हारा उना घर मा जा सी निकलीन आवी पछी उना मा जाती रईस, आरू आवीन उना क सुनलो आरू बाहरी सी साप करलो आरू सजायो हुय पावे। <verse eid="MAT 12:44"/><verse number="45" style="v" sid="MAT 12:45"/>तव हाव जाईन उका सी बुरी सात विटळ आत्मा क आपसा साथ मा ली आवे, आरू वो आत्मा उना मा बठीन वास करे, आरू उना मनुसन पछली हालत सी भी जादा सचाब हुय जाय। इना जमाना क लोगहन की हालत भी असीत् हुय जासे।”<verse eid="MAT 12:45"/></para>
  <para style="s">ईशु न माय आरू भाय</para>
  <para style="r">(<ref loc="MRK 3:31-35">मरकुस 3:31-35</ref>; <ref loc="LUK 8:19-21">लूका 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46"/>जव ईशु सी वात करतो हुतो, तो ओको माय बास आरू भाई बाहर उबा हुय रया हुता, आरू ओको सी वात करनो चाह्यो रया हुता। <verse eid="MAT 12:46"/><verse number="47" style="v" sid="MAT 12:47"/>कुदु ईशु सी कयो, “देख थारी माय आरू थारा भाईस बाहर उबा छे, आरू थार सी वात करनो चाहे।”<verse eid="MAT 12:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48"/>यो सोमवीन ईशु कयनो वाला क जवाब दियो, “कुन छे म्हार माय? आरू कुन छे म्हार भाईस?” <verse eid="MAT 12:48"/><verse number="49" style="v" sid="MAT 12:49"/>आरू आपसा चेलान क तरफ हाथ बढ़ावीन कयो, “म्हार माय आरू म्हार भाईस या छे। <verse eid="MAT 12:49"/><verse number="50" style="v" sid="MAT 12:50"/>काहकि जो कोय म्हारा सोरगदूतीय बासन मरजी पर चाले, त्योत् म्हार भाईस, आरू बहिनीस, आरू माय छे।”<verse eid="MAT 12:50"/></para>
  <chapter eid="MAT 12"/>
  <chapter number="13" style="c" sid="MAT 13"/>
  <para style="s">बीज वेरनेवावा क दाखलू</para>
  <para style="r">(<ref loc="MRK 4:1-9">मरकुस 4:1-9</ref>; <ref loc="LUK 8:4-8">लूका 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1"/>उना दिन ईशु घर सी निकलीन नदी क किनारा पर जाईन बठियो। <verse eid="MAT 13:1"/><verse number="2" style="v" sid="MAT 13:2"/>आरू ओको पास असी मटलो गर्दी एखटी हुय गय कि त्यो नाव पर चढ़ी गियो, आरू सारी गर्दी धोड़े पर उबी रयी।<verse eid="MAT 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 13:3"/>आरू ईशु उन लोगहन क उदाहरण मा बैस सारी वात कयो “एक वेरने वालो बीज वेरने निकलियो। <verse eid="MAT 13:3"/><verse number="4" style="v" sid="MAT 13:4"/>वेरता टेमे काहय दाना वाट्ये क धोड़े पर गिर गिया आरू चिल्ला आवीन उना क त्योटीन खाय गिया। <verse eid="MAT 13:4"/><verse number="5" style="v" sid="MAT 13:5"/>काहय बीज दगड़ा वाला धरती पर पड़ गिया, जा उनाक बैस माटी नी जोड़ने क कारण त्या जल्दी उग आया। <verse eid="MAT 13:5"/><verse number="6" style="v" sid="MAT 13:6"/>बाकुन दाहड़ो निकलने पर त्या बीज जल गिया, आरू मुव नी धरने क कारण सी सुख गिया। <verse eid="MAT 13:6"/><verse number="7" style="v" sid="MAT 13:7"/>आरू काय बीज झाड़का मा गिर गिया, आरू झाड़का मा उन बिज क बढ़ीन दड़पी दिया। <verse eid="MAT 13:7"/><verse number="8" style="v" sid="MAT 13:8"/>बाकुन काय वारली धरती पर पड़ गिया, आरू फव लाया, कोय सौ गुना, कोय साठ गुना, कोय तीस गुना। <figure style="fig" alt="Jesus teaching the crowd by the sea" file="lb00299c.tif" size="span" copy="Horace Knowles ©" ref="13:2">ईशु दरियामा ढोंड्या पर उभरईन लोगहन क शिक्षा देदो</figure><verse eid="MAT 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 13:9"/>“जिनको कान हय त्यो सुणी लेय।”<verse eid="MAT 13:9"/></para>
  <para style="s">दाखला क उद्देश्य</para>
  <para style="r">(<ref loc="MRK 4:10-12">मरकुस 4:10-12</ref>; <ref loc="LUK 8:9-19">लूका 8:9-19</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10"/>आरू चेला पास मा आवीन ईशु सी कयो, “तु त्या उदाहरण मा काय वात करतो हुतो?”<verse eid="MAT 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11"/>ईशु जवाब देदो, “तुमूक सोरग राज क भेद समझने की अकल आपी गयो छे, बाकुन त्या लोगहन क नी। <verse eid="MAT 13:11"/><verse number="12" style="v" sid="MAT 13:12"/>काहकि जेका पास छे, उना क दियो जासे; आरू उना क पास बैस हुय जासे; पर जिना क पास काय भी नी हय, उना सी जो काय ओको पास छे, त्यो भी ली लेदो जासे। <verse eid="MAT 13:12"/><verse number="13" style="v" sid="MAT 13:13"/>हाव उन लोगहन सी उदाहरण मा अतरानकरीन करीन करो, कि त्या देखता जाईन भी नी देखे; आरू सुनता जाईन भी नी सुने; आरू नी समझे। <verse eid="MAT 13:13"/><verse number="14" style="v" sid="MAT 13:14"/>आरू उना क बारा मा यशायाह की वात पूरी हुये;</para>
  <para style="q1" vid="MAT 13:14">“तुम क कानो सी तो सुनाई देस, पर समझ नी आवे;</para>
  <para style="q2" vid="MAT 13:14">आरू डुवा सी तो देखाय देसे पर पल्ले नी पड़े।<verse eid="MAT 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15"/>काहकि इन लोगहन क मन सुस्तो हुय गयो,</para>
  <para style="q2" vid="MAT 13:15">आरू त्या कान्टा क बंद कर लेदो,</para>
  <para style="q2" vid="MAT 13:15">आरू त्या डुवान क बंद कर लिदा;</para>
  <para style="q1" vid="MAT 13:15">काहय असो नी हय कि त्या आपसा डुवा सी देखे,</para>
  <para style="q2" vid="MAT 13:15">आरू कानो सी सुने</para>
  <para style="q2" vid="MAT 13:15">आरू मन सी समझे,</para>
  <para style="q1" vid="MAT 13:15">आरू त्या म्हार भेणी पछु जाय</para>
  <para style="q2" vid="MAT 13:15">आरू हांव उना क आरगा करो।<verse eid="MAT 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">13:16 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:23">लूका 10:23</ref>,<ref loc="LUK 10:24">24</ref></char>
    </note>“बाकुन सयाला छे तुमरा डुवा, कि त्या देखे; आरू तुमरा कान, कि त्या सुने। <verse eid="MAT 13:16"/><verse number="17" style="v" sid="MAT 13:17"/>काहकि हाव तुम सी सच कहवो, कि बैस सा कागळिया आरू न्यायी लोगहन यो चाहता हुता कि जो वात तुमू देखो, देखो पर नी देखाय; आरू जो वात तुम सुनो, सुनो, पर नी सुनियो।<verse eid="MAT 13:17"/></para>
  <para style="s">बीज वेरनेवावा दाखलान पुरावो</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18"/>“अब तुमू बोलनेवाला क उदाहरण सोमवु <verse eid="MAT 13:18"/><verse number="19" style="v" sid="MAT 13:19"/>जो कोय राज क वचन सोमवीन समझे, उका मन मा जो काय बोयो गियो हुतो, उना क त्या शैतान आवीन वचन छिन ली जाय; यो त्योत छे, जो वाटे धड़े बोयो गियो हुतो। <verse eid="MAT 13:19"/><verse number="20" style="v" sid="MAT 13:20"/>आरू जो दगड़ा वाली धरती पर वेरलो गयो, यो त्योत् छे, जो वचन सोमवीन तत्काल खुशी क साथ मान लेदो छे। <verse eid="MAT 13:20"/><verse number="21" style="v" sid="MAT 13:21"/>बाकुन आपसा मन मा मुव नी धरने क कारण त्यो थुड़ाक दाहड़ा रया सके, आरू जव वचन क कारण दुःख मा या पीड़ा हुये, तो तत्काल ठुकर खाय। <verse eid="MAT 13:21"/><verse number="22" style="v" sid="MAT 13:22"/>जो झाड़का मा बोया गयो, यो त्यो वचन क सुने, पर इनी दूनियान क चिंता आरू धन क धोखो वचन क दड़पे, आरू त्यो फव नी लावे। <verse eid="MAT 13:22"/><verse number="23" style="v" sid="MAT 13:23"/>जो वारली धरती मा वेराय गयो, यो त्यो छे, जो वचन क सोमवीन समझे, आरू फव लावे कोय सौ गुना, कोय साठ गुना, कोय तीस गुना।”<verse eid="MAT 13:23"/></para>
  <para style="s">जंगली बीज क उदाहरण</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24"/>ईशू उना क एक उदाहरण दियो, “सोरगदूत क राज उना मानुस क समान छे जो आपसा खेत मा वारू बीज बोयो।” <verse eid="MAT 13:24"/><verse number="25" style="v" sid="MAT 13:25"/>पर जव लोगहन सुय रिया हुता तो दुस्मन आवीन गहुक बीज मा जंगली बीज बोवीन चाली गियो। <verse eid="MAT 13:25"/><verse number="26" style="v" sid="MAT 13:26"/>जव अंकुर निकलियो आरू बलिया लागी, तो जंगली दान क झाड़किया भी देखाय दिया। <verse eid="MAT 13:26"/><verse number="27" style="v" sid="MAT 13:27"/>इना पर घर मालिक क दास लोगहन उका सी आवीन कयो, “ए मालिक, काय तु आपसा खेत मा वारलो बीज नी बोयो हुतो काय?” <verse eid="MAT 13:27"/><verse number="28" style="v" sid="MAT 13:28"/>मालिक दास सी कयो, “यो कोय दुस्मन क काम छे।” दास उका सी कयो, काय थारी मरजी छे, कि हामु जाईन उना झाड़का काजे उखाव देजे? <verse eid="MAT 13:28"/><verse number="29" style="v" sid="MAT 13:29"/>मालिक कयो, “नी असो नी हय की तुम एखटा करता जाईन जंगली दाना क झाड़को क साथ मा गहुक नी उखाड़ दयो। <verse eid="MAT 13:29"/><verse number="30" style="v" sid="MAT 13:30"/>काटनी तक दूय न क एक साथ मा बढ़ने देयो, आरू काटनी क समय मा काटने वाला सी कय द्योंगा; पेहले जंगली दाना क झाड़को क एखटा करीन धपाड़ने क करता गाठना बांध लेदो, आरू गहुक म्हार कुठार मा एखटा करो।”<verse eid="MAT 13:30"/></para>
  <para style="s">राई क बीज क उदाहरण</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31"/>ईशु उन लोगहन क एक उदाहरण दियो, “सोरग क राज्य राई क दाना क समान छे, जिनाक कोय मानुस लीन आपसा खेत मा बोय दियो। <verse eid="MAT 13:31"/><verse number="32" style="v" sid="MAT 13:32"/>त्यो सब बीज सी नानो तो छे पर जव बढ़ जाय तव सब साग–पात सी बड़ो हुये; असो झाड़को हुय जाय, कि वादवान चिल्ला भी आवीन ओकी डाली पर पांजरू बनावे।”<verse eid="MAT 13:32"/></para>
  <para style="s">खमीर क उदाहरण</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33"/>ईशु एक आरू उदाहरण मा लोगहन सी कहवीन सुनायो, “सोरग क राज खमीर क समान छे जिनाक कोय बायोर लीन बारा किलो पिठु मा मिलाय देदी आरू हुयता–हुयता त्यो खमीर हुय गियो।”<verse eid="MAT 13:33"/></para>
  <para style="s">दाखलो क प्रयोग</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34"/>यी सब वात ईशु लोगहन सी उदाहरण मा कयो, आरू बिना दाखलो त्यो उन लोगहन सी काय भी नी कहवतो हुतो। <verse eid="MAT 13:34"/><verse number="35" style="v" sid="MAT 13:35"/>कि जो वचन कागळीयान लारे कहवी गीयो हुतो,</para>
  <para style="q1" vid="MAT 13:35">त्यो पूरो हय; “हाव उदाहरण कयने क म्हार मुय खुलीस</para>
  <para style="q2" vid="MAT 13:35">हाव उनी वात क जो धरती क उबजने सी ढाकायली रयी देखाड़ीस।”<verse eid="MAT 13:35"/></para>
  <para style="s">ईशु क जंगली बीज न उदाहरण देखड़नो</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36"/>तव त्यो गर्दी क छुड़ीन घर मा आयो, आरू उका चेला ओको पास आवीन कयो, “खेत क जंगली दाना बाराम हामूक समझाड़ दे।”<verse eid="MAT 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37"/>ईशु उन क जवाब दियो, “वारला बीज क बोवने वालो मानुस क पोर्‍यो छे। <verse eid="MAT 13:37"/><verse number="38" style="v" sid="MAT 13:38"/>खेत दूनिया छे, वारलो बीज राजन अवलियाद, आरू जंगली बीज शैतानन अवलियाद छे। <verse eid="MAT 13:38"/><verse number="39" style="v" sid="MAT 13:39"/>जो दुस्मन उन क बोयो त्यो शैतान छे; आरू काटनी दुनिया क खत्म हुयनो छे; आरू काटनेवाळो सोरगदूत छे: <verse eid="MAT 13:39"/><verse number="40" style="v" sid="MAT 13:40"/>आरू जसो जंगली दाना क एखटा करीन उको धपाड़ दियो जाय वसोत दूनिया क खत्म हुयनो हयसे। <verse eid="MAT 13:40"/><verse number="41" style="v" sid="MAT 13:41"/>मानुस क पोर्‍यो आपसा सोरगदूतोन क मोकलसे, आरू त्या उका राज्य मा सी सब ठुकर क कारण बनने वाला क आरू कुकर्म करने वाला क एखटा करसे। <verse eid="MAT 13:41"/><verse number="42" style="v" sid="MAT 13:42"/>आरू उन लोगहन क आगठान कुण्डा मा न्हाक देसे, जा पर रोड़नो आरू दात पीसनो हुयसे। <verse eid="MAT 13:42"/><verse number="43" style="v" sid="MAT 13:43"/>उना समय मा न्यायी आपसा बास क राज्य मा दाहड़ा क समान चमकसे। जिनका कान हय त्यो सुन लेय।<verse eid="MAT 13:43"/></para>
  <para style="s">सातायला धन क उदाहरण</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44"/>“सोरग क राज्य खेत मा ढकायला धन क सारको छे, जिना मा कोय मानुस हेरी सातीन दियो, आरू खुशी सी जाईन आपसो सब काय बेचीन उना खेत क मोल ली लेदो।<verse eid="MAT 13:44"/></para>
  <para style="s">अनमोल मोती क उदाहरण</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45"/>“पछु सोरग क राज्य एक वेपारीक सारको चे जो वारला मोती क हेरतो हुतो। <verse eid="MAT 13:45"/><verse number="46" style="v" sid="MAT 13:46"/>जव उना क एक मोंगलो मोती मिलियो तो त्यो जाईन आपसो सब काय बेच दियो आरू उना क मोल ली लेदो।<verse eid="MAT 13:46"/></para>
  <para style="s">जाल क उदाहरण</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47"/>“पछु सोरगन राज्य उनी मटलो जाल क सारको छे, जो दरिया मा डाल दियो गयो, आरू हर भातिन जीव क सेमटी लायो। <verse eid="MAT 13:47"/><verse number="48" style="v" sid="MAT 13:48"/>आरू जव जाल भराय गय, तो जीव मारनेवाला धोड़े पर खीच लाया, आरू वारू–वारू जीव क ठाहरा मा एखटा करिया आरू बेकार–बेकार क न्हाख दिया। <verse eid="MAT 13:48"/><verse number="49" style="v" sid="MAT 13:49"/>दूनिया क खत्म हयने समय मा भी असौ हुयसे; सोरगदूत आवीन दुष्ट क न्यायीसी अलग करसे, <verse eid="MAT 13:49"/><verse number="50" style="v" sid="MAT 13:50"/>आरू उन लोगहन क आगठान कुण्डा मा न्हाख देसे। जा रोड़नो आरू दात पीसनो हुयसे<verse eid="MAT 13:50"/></para>
  <para style="s">नवली आरू पुरानी शिक्षा क महत्व</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51"/>“काय तुमू यी वात समझी गिया?” चेला जवाब दिया, “होव”<verse eid="MAT 13:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52"/>पछु ईशु उना सी कयो, “अतरानकरीन करीन हर एक शास्त्री जो सोरगदूत क राज्यन क चेला बन्या, उना घर धरती क सारको चे जो आपसा गुदाम सी नवली आरू पुरानी चीज निकाले।”<verse eid="MAT 13:52"/></para>
  <para style="s">नाजरथ मा ईशु क मानने सी मना</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53"/>जव ईशु यी सब उदाहरण कय दियो, तो वा सी जात रयो। <verse eid="MAT 13:53"/><verse number="54" style="v" sid="MAT 13:54"/>आरू आपसा नगर नासरत मा आवीन उन लोगहन क आराधना घर मा उना क असो शिक्षा देने लागी गियो; कि त्या घबराईन कयनो लागी गिया, “एको यो गियान आरू शक्ति क काम काँ सी मिलियो? <verse eid="MAT 13:54"/><verse number="55" style="v" sid="MAT 13:55"/>काय यो सुतार क पोर्‍यो नी हय? आरू काय एकी माय क नाव मरियम आरू ओको भाई क नाव याकूब, यूसुफ, शमौन आरू यहूदा नी हय? <verse eid="MAT 13:55"/><verse number="56" style="v" sid="MAT 13:56"/>आरू काय एकी सब बहिनीस हामरे बीच मा नी रहवे? पछु एको यो सब काँ सी मिलियो?”<verse eid="MAT 13:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 13:57"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">13:57 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 4:44">यहुन्ना 4:44</ref>
      </char>
    </note>इना रीति सी उन लोगहन ओको कारण सी ठुकर खाया, पर ईशु उन लोगहन सी कयो, कागळीयान क आपसा नगर आरू आपसा घर क छुड़ी काही भी विजुत नी उड़ाया? <verse eid="MAT 13:57"/><verse number="58" style="v" sid="MAT 13:58"/>आरू ईशु वा उना क विनभुरसा क कारण बैस शक्ति क काम नी करीयो।<verse eid="MAT 13:58"/></para>
  <chapter eid="MAT 13"/>
  <chapter number="14" style="c" sid="MAT 14"/>
  <para style="s">यहुन्ना बपतिस्मा देनेवावा की हत्या</para>
  <para style="r">(<ref loc="MRK 6:14-29">मरकुस 6:14-29</ref>; <ref loc="LUK 9:7-9">लूका 9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1"/>उना टेमे मा चौथाई देश क राजा हेरोदेस ईशु क बारा मा सुनियो। <verse eid="MAT 14:1"/><verse number="2" style="v" sid="MAT 14:2"/>आरू आपसा सेवक सी कयो, “यो यहुन्ना बपतिस्मा देनेवालो छे; त्यो मरला मा सी जीव उठियो, अतरानकरीन करीन ओका सी शक्ति क काम हुये।”<verse eid="MAT 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">14:3 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 3:19">लूका 3:19</ref>,<ref loc="LUK 3:20">20</ref></char>
    </note>काहकि हेरोदेस आपसा भाईस फिलिप्पुस न घर वाली हेरोदेस क कारण, यहुन्ना क धरावीन बांधियो, आरू जेलखाना मा डाल दियो हुतो। <verse eid="MAT 14:3"/><verse number="4" style="v" sid="MAT 14:4"/>काहकि यहुन्ना हेरोदेस सी कयो हुतो, कि एको राखनो थारो वारू नी हय। <verse eid="MAT 14:4"/><verse number="5" style="v" sid="MAT 14:5"/>आरू हेरोदेस उको मार न्हाखनो चाहतो हतो, बाकुन लोगहन सी बीहतो हुतो, काहकि त्या उना क कागळीयो मानता हुता।<verse eid="MAT 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6"/>पर जव हेरोदेस क जनमदिन आयो, तो हेरोदेस न पोराय तीहवार मा नाच देखाड़ीन हेरोदेस क खुश करी। <verse eid="MAT 14:6"/><verse number="7" style="v" sid="MAT 14:7"/>अतरानकरीन करीन त्यो शपथ खाईन वचन दियो, “जो काय तु मांगीस, हाव तुखे देय दिस।”<verse eid="MAT 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 14:8"/>त्यो आपसी माता क भड़कावने सी बोली, “यहुन्ना बपतिस्मा देने वालो क माथो थाली मा मांग दे।”<verse eid="MAT 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9"/>राजा दुःखी हुयो, बाकुन आपसी शपथ क, आरू साथ मा बठने वाला क कारण, हुकुम दियो, कि ओको हुकुम आप देदो। <verse eid="MAT 14:9"/><verse number="10" style="v" sid="MAT 14:10"/>आरू त्यो जेलखाना मा लोगहन क मोकलीन यहुन्ना क माथो कटाड़ीयो। <verse eid="MAT 14:10"/><verse number="11" style="v" sid="MAT 14:11"/>आरू ओको माथो थाली मा लायो गियो, आरू पोराय क देदो; आरू त्यो ओको आपसी माय क पास ली गयी। <verse eid="MAT 14:11"/><verse number="12" style="v" sid="MAT 14:12"/>आरू हेका चेला आवीन ओको धड़ क ली जाईन गाड़ देदा आरू जाईन ईशु क खबर दियो।<verse eid="MAT 14:12"/></para>
  <para style="s">पाच हजार मानसे क खावड़ावने</para>
  <para style="r">(<ref loc="MRK 6:30-44">मरकुस 6:30-44</ref>; <ref loc="LUK 9:10-17">लूका 9:10-17</ref>; <ref loc="JHN 6:6-14">यहुन्ना 6:6-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13"/>जव ईशु यी खबर सोमव्यो, ते ढोंड्या पर चढ़ीन वा सी उजाड़ धरती मा चली गियो; आरू लोगहन यो सोमवीन नगर–नगर सी पायदल ओका पछोळ हुय लिदा। <verse eid="MAT 14:13"/><verse number="14" style="v" sid="MAT 14:14"/>ईशु निकलीन एक मटलो गर्दी देखियो, आरू उना पर तरस खायो, आरू त्यो बीमार क आरगा करियो।<verse eid="MAT 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15"/>जव साँझ हुय तो ईशु क चेला ओको पास मा आवीन कयो, “यो तो सुनसान जागो छे आरू देर हय रयी, लोगहन क भेज दे कि या बस्ती मा जाईन आपसा जुगु खानो मुव ली लेय।”<verse eid="MAT 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16"/>ईशु चेलान सी कयो, उना क जानो जरूरी नी हय! तुमू इनको खानो देयो।<verse eid="MAT 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17"/>त्या ईशु सी कयो, “या हामरे पास पाच रोटा आरू दूय मासा क छुड़ीन काय नी हय।”<verse eid="MAT 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18"/>ईशु कयो, “उन लोगहन क मार पास ली आयो।” <verse eid="MAT 14:18"/><verse number="19" style="v" sid="MAT 14:19"/>तव ईशु लोगहन क खोड़ो पर बठने क कयो, आरू उन पाच रोटा आरू दूय माछली क लेदो; आरू सोरग की तरफ देखीन धन्यवाद करीयो आरू रोटा तोड़ी–तोड़ीन चेलान क दियो, आरू चेला लोगहन क दिया। <verse eid="MAT 14:19"/><verse number="20" style="v" sid="MAT 14:20"/>आरू सब खाईन आफरी गिया, आरू चेला वाचला रोटान टुकड़ा सी भरायला बारा खिल्ला हाकलिया। <verse eid="MAT 14:20"/><verse number="21" style="v" sid="MAT 14:21"/>आरू खाने वाला बायरा आरू पोर्‍या क छुड़ीन पाच हजार ओदेमड़ा क धोड़ वड़ हुता।<verse eid="MAT 14:21"/></para>
  <para style="s">ईशु क पानी पर चालने</para>
  <para style="r">(<ref loc="MRK 6:45-52">मरकुस 6:45-52</ref>; <ref loc="JHN 6:15-21">यहुन्ना 6:15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22"/>आरू ईशु तत्काल आपसा चेलान क ढोंड्या पर चढ़ायो, कि त्या ओको सी पेहल कफरनहूम जात रया, जव तक कि लोगहन क भेज देय। <verse eid="MAT 14:22"/><verse number="23" style="v" sid="MAT 14:23"/>त्या लोगहन क भेजीन, प्रार्थना करने करीन अलग बयड़ा पर चढ़ी गियो; आरू साँझ क त्यो वा एखलो हुतो। <verse eid="MAT 14:23"/><verse number="24" style="v" sid="MAT 14:24"/>उना समय मा ढोंड्यो दरिया क बीच मा लहराय रया हुती, काहकि हवा सामने हुती।<verse eid="MAT 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25"/>आरू त्यो रात क चौथे टेमे मा दरिया पर चालीन चेलान क पास आयो। <verse eid="MAT 14:25"/><verse number="26" style="v" sid="MAT 14:26"/>चेला उको दरिया पर चालतो देखीन घबराय गया, आरू कहने लागिया, “त्यो भूत छे” आरू बीह गिया आरू आयड़ने लागिया।<verse eid="MAT 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27"/>ईशु तत्काल चेला सी वात करीयो, आरू कयो, “हिमत राखो, हाव छे; बीहयो मा।”<verse eid="MAT 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28"/>पतरस जवाब दियो, “ए पोरबु, कदाम तु छे, तो मेखे थारा पास पानी पर चालीन आवने क हुकुम दे।”<verse eid="MAT 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29"/>ईशु कयो, “आव!” तव पतरस नाव पर सी उतरीन ईशु क पास मा जाने करीन पानी पर चालने लाग्या। <verse eid="MAT 14:29"/><verse number="30" style="v" sid="MAT 14:30"/>पर हवा क देखीन बीह गियो, आरू जव नाव डुबने लागी तो आयड़ीन कयनो लागियो, “ए पोरबु मेखे बचाव।”<verse eid="MAT 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31"/>ईशु तत्काल हाथ बढ़ावीन पतरस क धर लेदो, आरू ओका सी कयो, “ए विन विनभुरसीया, तु काय क संका करियो?”<verse eid="MAT 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32"/>जव त्या ढोंड्यो पर चढ़ी गया, तो हवा रूक गय। <verse eid="MAT 14:32"/><verse number="33" style="v" sid="MAT 14:33"/>इना पर जो ढोंड्यो पर हुता, त्या लोगहन ओकी आराधना करीन कयो, “सचमुच, तु यहोवा–भगवान क पोर्‍यो छे।”<verse eid="MAT 14:33"/></para>
  <para style="s">रीति पावने क सवाल</para>
  <para style="r">(<ref loc="MRK 6:55-56">मरकुस 6:55-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34"/>त्या पार उतरीन गन्नेसरत प्रदेशन धरती पर पुग गिया। <verse eid="MAT 14:34"/><verse number="35" style="v" sid="MAT 14:35"/>आरू वा क लोगहन ओको पेहचानीन आस–पास क सब क्षेत्र मा कय मकलिया, आरू, सब बीमार क ईशु क पास लाया। <verse eid="MAT 14:35"/><verse number="36" style="v" sid="MAT 14:36"/>आरू उका सी विनता करने लाग गिया कि त्यो उन लोगहन क हेका छिंदरा क छिमने देय; आरू जतरा ओको छिमिया, त्या आरगा हुय वाच गिया।<verse eid="MAT 14:36"/></para>
  <chapter eid="MAT 14"/>
  <chapter number="15" style="c" sid="MAT 15"/>
  <para style="s">पुर्वजन शिक्षा</para>
  <para style="r">(<ref loc="MRK 7:1-13">मरकुस 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1"/>तव यरूशलेम सी काहय फरीसि आरू शास्त्री ईशु क पास आवीन कयनो लाग गिया, <verse eid="MAT 15:1"/><verse number="2" style="v" sid="MAT 15:2"/>“थारा चेला वेगला डाहडान नियम क काय क टाले, कि हाथ नी धुवे आरू रोटा खाय?” <figure style="fig" alt="Ceremonial washing" file="lb00280c.tif" size="col" copy="Horace Knowles ©" ref="15:2">यहूदिया क लोगहन हाथ धुवनेन रीत</figure><verse eid="MAT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3"/>ईशु त्या लोगहन क जवाब दियो, तुमू भी तुमरी रीति रीवाज क कारण काय क यहोवा भगवान क हुकुम क टाले? <verse eid="MAT 15:3"/><verse number="4" style="v" sid="MAT 15:4"/>काहकि यहोवा भगवान कयो, “तुमरा माय बास क विजुत करजो, आरू जो कोय बास या माय क बुरो कहे, उको मार दियो जाय।” <verse eid="MAT 15:4"/><verse number="5" style="v" sid="MAT 15:5"/>पर तुमू कहवो, कि यदि कोय आपसा माय बास क कहे, जो काय तुको म्हार सी फायदो हय सकतो हुतो, त्यो यहोवा भगवान क भेंट चढ़ाय त्योकियो। <verse eid="MAT 15:5"/><verse number="6" style="v" sid="MAT 15:6"/>तो त्यो आपसा बास क विजुत नी करे, इना रीति सी तुमू तुमरी रीति रीवाज क कारण यहोवा भगवान क वचन टाल दीदा। <verse eid="MAT 15:6"/><verse number="7" style="v" sid="MAT 15:7"/>ए ढोंग करने वाला, यशायाह तुमरा बारा मा यो भविष्व्दाणी ठीक करियो:<verse eid="MAT 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8"/>या लोगहन हुटो सी तो म्हारो विजुत करे,</para>
  <para style="q2" vid="MAT 15:8">बाकुन ओको मन म्हार सी दूर रये।<verse eid="MAT 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9"/>आरू या रिकामो म्हारी भक्ति करे,</para>
  <para style="q2" vid="MAT 15:9">“काहकि मानुस क नियम क धरम क शिक्षा करीन सीखाड़े।”<verse eid="MAT 15:9"/></para>
  <para style="s">विटळ करने वावी वात</para>
  <para style="r">(<ref loc="MRK 7:14-23">मरकुस 7:14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10"/>आरू ईशु लोगहन क पास बुलावीन उना क कयो, “सुनो, आरू समझी ले। <verse eid="MAT 15:10"/><verse number="11" style="v" sid="MAT 15:11"/>जो मुय मा जाय, त्यो मानुस क विटळ नी करे, पर जो मुय सी निकले त्योत् मानुस क विटळ करे।”<verse eid="MAT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12"/>तव चेला आवीन कयो, “काय तु जाने कि फरीसिया यो वचन सोमवीन ठुकर खाया?”<verse eid="MAT 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13"/>ईशु जवाब दीदो, “हर झाड़को क सोरगदूतीय बास नी लगाड़यो, त्यो झाड़को उखाड़ी दियो जासे। <verse eid="MAT 15:13"/><verse number="14" style="v" sid="MAT 15:14"/><note caller="+" style="x"><char style="xo" closed="false">15:14 </char><char style="xt" closed="false"><ref loc="LUK 6:39">लूका 6:39</ref></char></note>उन क जाने देयो; त्या आंधवी वाट देखाड़ने वाला छे आरू आंधवा कदाम आंधवा क वाट देखाड़े, तो दुयू भी खाड्ड़ा मा गीर जासे।”<verse eid="MAT 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15"/>यो सोमवीन पतरस ओको कयो, “यो दृष्टान्त हामुक समझाड़ दे।”<verse eid="MAT 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16"/>ईशु कयो, “काय तुमू भी अब तक नी समझिया? <verse eid="MAT 15:16"/><verse number="17" style="v" sid="MAT 15:17"/>काय तुमू नी समझो, कि जो मुय मा जाय, त्यो पेट मा पड़े, आरू शौच सी निकल जाय? <verse eid="MAT 15:17"/><verse number="18" style="v" sid="MAT 15:18"/>पर जो काय मुय मा सी निकले, त्यो मन सी निकले, आरू त्योत् मानुस क विटळ करे। <verse eid="MAT 15:18"/><verse number="19" style="v" sid="MAT 15:19"/>काहकि बुरा विचार, हत्या, विनलाज्या, व्यभिचार, चुरी, झुटी गवाय आरू वायकेड़ा मन सी निकले। <verse eid="MAT 15:19"/><verse number="20" style="v" sid="MAT 15:20"/>त्योत् छे जो मानुस क विटळ करे, बाकुन हाथ नी धुवीन खानो मानुस क विटळ नी करे।”<verse eid="MAT 15:20"/></para>
  <para style="s">कनानी जातिन बायर क विश्वास</para>
  <para style="r">(<ref loc="MRK 7:24-30">मरकुस 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21"/>ईशु वा सी निकलीन, सोर आरू सीदोन क देश की आरू चाली गिया। <verse eid="MAT 15:21"/><verse number="22" style="v" sid="MAT 15:22"/>आरू देखो, उना परदेश सी एक कनानी बायर निकली, आरू आयड़ीन कयनो लागी, “ए पोरबु! दाऊदन अवलियाद, म्हार पर दया कर, म्हारी पोराय क साहळा बैस सताय रया।”<verse eid="MAT 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23"/>पर ईशु ओको सी काय जावब नी दियो, आरू उका चेला आवीन उका सी विनती करीन कयो, “इनी क भेज दे; काहकि त्या हामरे पछोळ आयड़ती जाईन आवे।”<verse eid="MAT 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24"/>ईशु जावब दियो, “हाव इस्राएल क खुवायला गाडरान क छुड़ीन हाव कोयक पास नी भेजी गयो।”<verse eid="MAT 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25"/>पर ची बायर आवी, आरू ईशु क नमस्कार करीन कयने लागी, “ए पोरबु, म्हारी मदत कर।”<verse eid="MAT 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26"/>ईशु जवाब दियो, “पोर्‍या रोटा लीन कुत्रान क अगल न्हाखनो वारू नी हय।”<verse eid="MAT 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27"/>त्या कहवी, “सच छे पोरबु, पर कुत्रा भी त्या चुरा खाय, जो ओका मालिक क टेबल पर सी पड़े।”<verse eid="MAT 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28"/>इना पर ईशु उको जवाब दीन कयो, “ओ बाई, थारो विश्वास बड़ो छे; जसो तु चाहे, थारे करता वसोत हुये” आरू ओकी पोर्‍या उना समय आरगी हुय गय।<verse eid="MAT 15:28"/></para>
  <para style="s">हरेक बीमारी क वारू करने</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29"/>ईशु वा सी चालीन, गलीलन नदी क पास आयो, आरू बयड़ा पर चढ़ीन वा बठ गियो। <verse eid="MAT 15:29"/><verse number="30" style="v" sid="MAT 15:30"/>आरू गर्दी पर गर्दी ओका पास आया, त्या आपसा साथ लेंगड़ा, आंधवा, गुंगा, टुँड़ा, आरू बैस सब क लीन ओका पास आया; आरू उना क ईशु क पाय पर डाल दिदा, आरू त्यो उना क आरगा करियो। <verse eid="MAT 15:30"/><verse number="31" style="v" sid="MAT 15:31"/>बाकुन जव लोगहन देखिया, कि गुंगा बुले आरू टुँडा आरगा हुये आरू लेंगड़ा चाले आरू आंधवा देखे, तो घबराईन इस्राएल क यहोवा भगवानन महिमा करिया।<verse eid="MAT 15:31"/></para>
  <para style="s">च्यार हजार मानसे क खावड़ावने</para>
  <para style="r">(<ref loc="MRK 8:1-10">मरकुस 8:1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32"/>ईशु आपसा चेला क बुलावीन कयो, “म्हार सी इनी गर्दी पर तरस आवे; काहकि त्या तीन दिन सी म्हार साथ मा छे आरू उन लोगहन क पास खाने करीन काय नी हय; आरू हाव उना क भुकलात् भेजनो नी चाहो; काहकि असो नी हये कि वाटे हरबड़ीन गीर नी जाय।”<verse eid="MAT 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33"/>चेला ईशु सी कयो, “हामुक इना उजाड़िया धरती मा काँ सी अतरा रोटा मुवसे कि हामु अतरी मटलो गर्दी क खावाड़े?”<verse eid="MAT 15:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34"/>ईशु चेला सी पुछियो, “तुमरे पास कतरा रोटा छे?”</para>
  <para style="p" vid="MAT 15:34">चेला कयो, “सात रोटा आरू धुड़ीक माछली।”<verse eid="MAT 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35"/>तव ईशु लोगहन क धरती पर बठनेन हुकुम दियो। <verse eid="MAT 15:35"/><verse number="36" style="v" sid="MAT 15:36"/>आरू उन सात रोटा आरू माछली क लीन धन्यवाद करीन तोड़ीयो आरू आपसा चेलान क देतो गयो, आरू चेला लोगहन क। <verse eid="MAT 15:36"/><verse number="37" style="v" sid="MAT 15:37"/>इना रीति सब खाईन आफरी गिया आरू वाचला टुकड़ा सी भरायला सात खिल्ला हाकलिया। <verse eid="MAT 15:37"/><verse number="38" style="v" sid="MAT 15:38"/>आरू खाने वाला बायरा आरू पोर्‍या क छुड़ीन चार हजार ओदेमड़ा हुता।<verse eid="MAT 15:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39"/>तव ईशु गर्दी क भेजीन नाव पर चढ़ गियो, आरू मगदन नगर मा आया।<verse eid="MAT 15:39"/></para>
  <chapter eid="MAT 15"/>
  <chapter number="16" style="c" sid="MAT 16"/>
  <para style="s">सरगीय सहलानी की मांग</para>
  <para style="r">(<ref loc="MRK 8:11-13">मरकुस 8:11-13</ref>; <ref loc="LUK 12:54-56">लूका 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:38">मत्ती 12:38</ref>; <ref loc="LUK 11:16">लूका 11:16</ref></char>
    </note>आरू फरीसियो आरू सदूकियो ईशु क पास आविन ओकी पारख करने करीन उका सी कयो, “हामुक सोरगदूत क काहय सोहलानी देखाड़।” <verse eid="MAT 16:1"/><verse number="2" style="v" sid="MAT 16:2"/>ईशु उन लोगहन क जवाब दियो, “सांझ क कहवे, कि मोसम वारलो रहवसे, काहकि आकाश रातलो छे।” <verse eid="MAT 16:2"/><verse number="3" style="v" sid="MAT 16:3"/>आरू भोलभाको कहे, कि आज आँधी आवसे काहकि आकाश रातलो आरू धुलान जसो छे; तुमू सोरग न क देखीन फरक देखाड़ सके, पर समय क फरक काय क नी देखाड़ सको?<verse eid="MAT 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 16:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:4 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:39">मत्ती 12:39</ref>; <ref loc="LUK 11:29">लूका 11:29</ref></char>
    </note>इना जमाना क बुरा आरू व्यभिचारी लोगहन सोहलानी हेरे बाकुन योना न सोहलानी क छुड़ीन कोय आरू सोहलानी उन लोगहन क दियो जासे। आरू सोहलानी उना क छुड़ीन चाली गिया।<verse eid="MAT 16:4"/></para>
  <para style="s">फरीसियो आरू सदूकियोंयो की शिक्षा क खमीर</para>
  <para style="r">(<ref loc="MRK 8:14-21">मरकुस 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5"/>आरू चेला नदी क उना पार जाता समय रोटा ली जानो भुल गिया हता। <verse eid="MAT 16:5"/><verse number="6" style="v" sid="MAT 16:6"/><note caller="+" style="x"><char style="xo" closed="false">16:6 </char><char style="xt" closed="false"><ref loc="LUK 12:1">लूका 12:1</ref></char></note>ईशु चेलान क कयो “सदेखो फरीसियों सदूकियो खमीर सी चोकचौळीया रहवजो।”<verse eid="MAT 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7"/>इना पर त्या एक दिसरा सी वात करने लागिया, “हामु तो रोटा नी लाया। अतरानकरीन करीन त्यो असो कहवे।”<verse eid="MAT 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8"/>यो जानीन, ईशु चेलान क कयो, “ए विनभुरसीया, तुमू आपसा काय वात कर रया की हामरे जु रोटा नी हय? <verse eid="MAT 16:8"/><verse number="9" style="v" sid="MAT 16:9"/><note caller="+" style="x"><char style="xo" closed="false">16:9 </char><char style="xt" closed="false"><ref loc="MAT 14:17-21">मत्ती 14:17-21</ref></char></note>काय तुमू अब तक नी समझिया? आरू उना पाच रोटा क फोम नी करता, आरू नी यो कि कतरी रोटला भरली खिल्ला हाकलिया हुता? <verse eid="MAT 16:9"/><verse number="10" style="v" sid="MAT 16:10"/><note caller="+" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="MAT 15:34-38">मत्ती 15:34-38</ref></char></note>आरू नी उन चार हजार क सात रोटा, आरू नी यो कि कतरा खिल्ला हाकलिया हुता? <verse eid="MAT 16:10"/><verse number="11" style="v" sid="MAT 16:11"/>तुम काय क नी समझो कि हाव तुमरे सी रोटान बाराम नी कयो? बाकुन फरीसिया आरू सदूकियो क खमीर से चौकचोळिया रहवजो।”<verse eid="MAT 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12"/>तव चेलान क समझ मा आयो, कि ईशु रोटा क खमीर सी नी, फरीसिया आरू सदूकियोन शिक्षा सी चौकचोळिया रहवने कयो हुतो।<verse eid="MAT 16:12"/></para>
  <para style="s">पतरस क ईशु क मसीह स्वीकार करने</para>
  <para style="r">(<ref loc="MRK 8:27-30">मरकुस 8:27-30</ref>; <ref loc="LUK 9:18-21">लूका 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13"/>ईशु कैसरिया फिलिप्प क परदेश मा आवीन आपसा चेला सी पुछने लाग गियो, “कि लोगहन मानुस क पोर्‍या क काय कहवे?”<verse eid="MAT 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 14:1">मत्ती 14:1</ref>,<ref loc="MAT 14:2">2</ref>; <ref loc="MRK 6:14">मरकुस 6:14</ref>,<ref loc="MRK 6:15">15</ref>; <ref loc="LUK 9:7">लूका 9:7</ref>,<ref loc="LUK 9:8">8</ref></char>
    </note>चेला कयो, “कोय तो यहुन्ना बपतिस्मा देनेवाला कहे आरू कोय एलियाह, आरू कोय यिर्मयाह या कागळिया माईन कोय एक कहवे।”<verse eid="MAT 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15"/>ईशु चेलान क कयो, “बाकुन तुमू मेखे काय कहवो?”<verse eid="MAT 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:16 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 6:68">यहुन्ना 6:68</ref>,<ref loc="JHN 6:69">69</ref></char>
    </note>शमौन पतरस जवाब दियो, “तु जीवता यहोवा–भगवान क पोर्‍यो मसीह छे।”<verse eid="MAT 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17"/>ईशु पतरस क जवाब दियो, “ए शमौन, योना क पोर्‍या, तु सयालो छे; काहकि मास आरू लुहूय यो या नी बाकुन म्हार बास ने जो सोरगदूत मा छे यी वात तुमरे पर देखाड़ियो। <verse eid="MAT 16:17"/><verse number="18" style="v" sid="MAT 16:18"/>आरू हाव भी तुमरे सी कहवो, तु पतरस छे, आरू हाव इना दगड़ा पर म्हारी मंडळी बनावीस आरू नरकन झोपला उना पर काम नी कर सके। <verse eid="MAT 16:18"/><verse number="19" style="v" sid="MAT 16:19"/><note caller="+" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="MAT 18:18">मत्ती 18:18</ref>; <ref loc="JHN 20:23">यहुन्ना 20:23</ref></char></note>हाव तुखे सोरग राजन चाबीया आपीस आरू जो काय तु धरती पर बांधीस, त्यो सोरग मा भी बांधाय जासे, आरू जो काय तु धरती पर खुलीस, त्यो सोरग मा खुल जासे।”<verse eid="MAT 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20"/>तव चेलान क चेतावनी दियो, “कोय सी नी कयनो! कि हाव मसीह छे।”<verse eid="MAT 16:20"/></para>
  <para style="s">ईशु क मरना क बाराम आपसी भविष्यव्दाणी</para>
  <para style="r">(<ref loc="MRK 8:31-9:1">मरकुस 8:31–9:1</ref>; <ref loc="LUK 9:22-27">लूका 9:22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21"/>उना समय सी ईशु आपसा चेला क बतावने लाग गीयो, “मेखे यो जरूरी छे कि यरूशलेम क जावो, आरू डाहडा आरू मुखी पुजारा आरू शास्त्रीया क हाथ सी बैस दुःख उठावो; आरू मार दियो जावो; आरू तीसरे दाहड़े जीव उठो?”<verse eid="MAT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22"/>इना पर पतरस उना क अलग ली जाईन कयनो लागी गियो, “ए पोरबु, यहोवा–भगवान असो नी करे, थार साते असो नी हुये।”<verse eid="MAT 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23"/>ईशु पछु पतरस क कयो, “ए शैतान, म्हार सामने सी दूर हुय जा! तु म्हार करता ठुकर क कारण छे; काहकि तु यहोवा–भगवानन वात नी बाकुन मनुसोन वात पर मन लगाड़।”<verse eid="MAT 16:23"/></para>
  <para style="s">ईशुन पछळ चालनेन मतलब</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:24 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:38">मत्ती 10:38</ref>; <ref loc="LUK 14:27">लूका 14:27</ref></char>
    </note>तव ईशु आपसा चेलान क कयो, “कदाम कोय म्हार पछोळ आवनो चाहे, तो आपसो मानने सी मना करे आरू ओकोत् कुरूस उठावे, आरू म्हार पछोळ हुय लेय। <verse eid="MAT 16:24"/><verse number="25" style="v" sid="MAT 16:25"/><note caller="+" style="x"><char style="xo" closed="false">16:25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">मत्ती 10:39</ref>; <ref loc="LUK 17:33">लूका 17:33</ref>; <ref loc="JHN 12:25">यहुन्ना 12:25</ref></char></note>काहकि जो कोय आपसो जीवन वाचड़नो चाहसे, त्यो उनाक खुय देसे; आरू जो कोय म्हार करता आपसो जीव खुवसे, त्यो उना जुड़सेस। <verse eid="MAT 16:25"/><verse number="26" style="v" sid="MAT 16:26"/>कदाम मानुस सब दूनिया क हात करलेय, आरू आपसा जीव क नुक्शानी झेले, तो उना क काय फायदो हुयसे? या मानुस आपसा जीव क बदलाम काय देयगो। <verse eid="MAT 16:26"/><verse number="27" style="v" sid="MAT 16:27"/><note caller="+" style="x"><char style="xo" closed="false">16:27 </char><char style="xt" closed="false"><ref loc="MAT 25:31">मत्ती 25:31</ref>; </char><char style="xt" closed="false"><ref loc="ROM 2:6">रोमियो 2:6</ref></char></note>मानुस क पोर्‍यो आपसा सोरगदूतों क साथ मा बासन महिमा मा आवसे, आरू उना टेमे ‘त्यो हर एक क उका काम क अनसारे फव आपसे।’ <verse eid="MAT 16:27"/><verse number="28" style="v" sid="MAT 16:28"/>हाव तुमरे सी सच कहवो, कि जो या उबला मानसे छे, ओका माईन कतरा असा छे, कि जव तक मानुस क पोर्‍या क उका राज मा आवतलो नी देख लेये, तव तक मोत क सवाद नी चाखे।”<verse eid="MAT 16:28"/></para>
  <chapter eid="MAT 16"/>
  <chapter number="17" style="c" sid="MAT 17"/>
  <para style="s">ईशु क रूप बदलनो</para>
  <para style="r">(<ref loc="MRK 9:2-13">मरकुस 9:2-13</ref>; <ref loc="LUK 9:28-36">लूका 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1"/>छव दिन क बाद ईशु पतरस आरू याकूब, आरू उका भाईस यहुन्ना क साथ ली गयो, आरू उन लोगहन क एक सुना धरती मा जुर सी बयड़ा पर ली गियो। <verse eid="MAT 17:1"/><verse number="2" style="v" sid="MAT 17:2"/>आरू वा चेलान क सामने ईशुन रूप बदली गियो आरू ओको मुय दाहड़ा क समान चमकियो आरू उका छिंदरा विजाला क समान उजला हुय गिया। <verse eid="MAT 17:2"/><verse number="3" style="v" sid="MAT 17:3"/>आरू मूसा आरू एलियाह क ईशु क साथ मा वात करतला देखाय पड़ियो। <verse eid="MAT 17:3"/><verse number="4" style="v" sid="MAT 17:4"/>इना पर पतरस ईशु सी कयो, “ए पोरबु हामरो या रहवनो वारू छे; कदाम थार मरजी हुय ती हाव या तीन तम्बू बनावीस; एक थार करता, एक मूसा जुगु, आरू एक एलियाह क करता।”<verse eid="MAT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">17:5 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:17">मत्ती 3:17</ref>; <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 1:11">मरकुस 1:11</ref>; <ref loc="LUK 3:22">लूका 3:22</ref></char>
    </note>
    <note caller="+" style="x">
      <char style="xo" closed="false">17:5 </char>
      <char style="xt" closed="false">
        <ref loc="2PE 1:17">2 पतरस 1:17</ref>,<ref loc="2PE 1:18">18</ref></char>
    </note>पतरस यो कहवतो हुतो, कि एक विजालो वादवो उन पर डाक लेदो, आरू उना वादवा मा सी यो शब्द निकलियो, “यो म्हारो मोंगावु पोर्‍यो छे, जिना सी हाव खुश छे: एकी वात सोमवु।”<verse eid="MAT 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6"/>चेला यो सोमवीन मुय क भुरसे गीर गिया आरू बैस बीह गिया। <verse eid="MAT 17:6"/><verse number="7" style="v" sid="MAT 17:7"/>ईशु त्या लोगहन क पास आवीन उन क छिमियो, आरू कयो, “उठो, बीहयो मा।” <verse eid="MAT 17:7"/><verse number="8" style="v" sid="MAT 17:8"/>तव त्या लोगहन आपसा डुवान क उगाड़ीन ईशु क छुड़ीन आरू कोयक नी देखीया।<verse eid="MAT 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9"/>जव त्या बयड़ा सी उतरी रिया हुता तव ईशु चेलान क हुकुम देदो, “जव तक मानुस क पोर्‍यो मरला मा सी जीव नी उठे, तव तक जो काय तुमू देखिया कोयक सी नी कयनो।”<verse eid="MAT 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10"/>आरू उका चेला ओको सी पुछिया, “पछु शास्त्री काय क कहवे, कि एलियाह क पेहले आवनो सच छे?”<verse eid="MAT 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11"/>ईशु जवाब दीदो, “एलियाह सच मा आवसे, आरू सब काय सुधारसे। <verse eid="MAT 17:11"/><verse number="12" style="v" sid="MAT 17:12"/>बाकुन हाव तुमरे सी कहवो, कि एलियाह आवी चुकियो; आरू त्या उको नी पेहचानिया; बाकुन जसो चाहतो हुतो वसोत त्यो करियो। इना रीति सी मानुस क पोर्‍यो भी उन लोगहन क हाथ सी दुःख झेलसे।”<verse eid="MAT 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13"/>तव चेला समझी गिया कि ईशु हामरे साते यहुन्ना बपतिस्मा देनेवालाक बाराम कयो।<verse eid="MAT 17:13"/></para>
  <para style="s">साहळा सी भरायला पोर्‍या क वारू करने</para>
  <para style="r">(<ref loc="MRK 9:4-29">मरकुस 9:4-29</ref>; <ref loc="LUK 9:37-43">लूका 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14"/>जव त्या गर्दी क पास पुग गिया, तो एक मानुस उको पास पुग्यु, आरू घटना टेकीन कयने लाग गियो। <verse eid="MAT 17:14"/><verse number="15" style="v" sid="MAT 17:15"/>“ए पोरबु, म्हार पोर्‍या पर दया कर! काहकि उको मिर्गी आवती रये; आरू बार–बार आगठा मा बार–बार पानी मा पड़ जाय। <verse eid="MAT 17:15"/><verse number="16" style="v" sid="MAT 17:16"/>आरू हाव उको थारा चेला क पास लायो हुतो, पर त्या उना क आरगा नी कर सकिया।”<verse eid="MAT 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17"/>ईशु जवाब दियो, “हे विनभुरसा आरू एक हेठीले लोगहन, हाव कोतार तक तुमरी सहवतो रहवीस? उना पोर्‍या क म्हार साथे लावु।” <verse eid="MAT 17:17"/><verse number="18" style="v" sid="MAT 17:18"/>तव ईशु उनी साहळा क लड़ियो, आरू साहळा उका मा सी निकली; आरू पोर्‍यो उना समय मा आरगाय हुय गिया।<verse eid="MAT 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19"/>तव चेला एखला धरती मा ईशु क पास जाईन कयो, “हामु एको काँ नी निकाल सकिया?”<verse eid="MAT 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20"/>ईशु कयो “तुमरा विश्वास कि कमी स कारण: काहकि हाव तुमरे सी सच कहवो, कदाम तुमरो विश्वास राई क दाना क बराबर भी हुतो, तो इना बयड़ा क कय सको, या सी सरकीन वा जात रया, तो त्यो चली जासे; आरू कोय बात तुमरे करता वातड़ो नी हुये। <verse eid="MAT 17:20"/><verse number="21" style="v" sid="MAT 17:21"/>पर यी जाति बिना प्रार्थना आरू उपवास क नी निकले।”<verse eid="MAT 17:21"/></para>
  <para style="s">आपनो मरन क विषय ईशु की पुन: भविष्यव्दाणी</para>
  <para style="r">(<ref loc="MRK 9:30-32">मरकुस 9:30-32</ref>; <ref loc="LUK 9:4-45">लूका 9:4-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22"/>जव त्या गलील नगर मा हुता, तो ईशु उन लोगहन सी कयो, “मानुस क पोर्‍या क मानुस क हाथ मा धराय दियो जासे। <verse eid="MAT 17:22"/><verse number="23" style="v" sid="MAT 17:23"/>आरू त्या उना क मार न्हाखसे, आरू त्यो तीसरे दाहाड़े जीव उठसे।”</para>
  <para style="p" vid="MAT 17:23">अतरा पर त्या बैस नराज हुयो।<verse eid="MAT 17:23"/></para>
  <para style="s">मंदिर क कर</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24"/>जव त्या कफरनहूम मा पुग गया, तो मंदिर क पास आवीन पुछ्या, “काय तुमरो गुरू मंदिर क फालो लेनेवाला पतरस क जु आवीन पुछा काय तुमरो गुरू मंदिर क फावो नी देय?”<verse eid="MAT 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25"/>त्यो कयो, “होव, देय।”</para>
  <para style="p" vid="MAT 17:25">जव त्यो घर मा आयो, तो ईशु उको पुछने सी पेहले उका सी कयो, “ए शमौन तु काय समझे? धरती क राजा फाळो कुनी सी लेदो? आपसा पोर्‍या सी या दिसरा सी?”<verse eid="MAT 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26"/>“पतरस उन क यो कयो, पराया सी।”</para>
  <para style="p" vid="MAT 17:26">ईशु उका सी कयो, “तो पोर्‍यो वाच गियो। <verse eid="MAT 17:26"/><verse number="27" style="v" sid="MAT 17:27"/>पछु भी हामु उको ठुकर नी खवाड़े, तु नदी क किनारे जाईन जाल न्हाख, आरू जो माछली पेहले निकले, उको ली ले; तो ओको मुय खोलजी उका मा एक सिक्‍को मुवसे, उना क लीन मार आरू थारे बदले ओको दे देजी।”<verse eid="MAT 17:27"/></para>
  <chapter eid="MAT 17"/>
  <chapter number="18" style="c" sid="MAT 18"/>
  <para style="s">स्वर्ग क राज मा मोठ कुन?</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:24">लूका 22:24</ref>
      </char>
    </note>उना समय चेला ईशु क पास आवीन पुचने लाग गिया, “सोरग क राज मा बड़ो कुन छे?”<verse eid="MAT 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2"/>इना पर त्यो एक पोर्‍या क बुलायो ओको वीच मा उबो कर दियो, <verse eid="MAT 18:2"/><verse number="3" style="v" sid="MAT 18:3"/><note caller="+" style="x"><char style="xo" closed="false">18:3 </char><char style="xt" closed="false"><ref loc="MRK 10:15">मरकुस 10:15</ref>; <ref loc="LUK 18:17">लूका 18:17</ref></char></note>आरू कयो, “हाव तुमरे सी सच कहवो, कदाम तुमू नी पछु आरू पोर्‍यान क समान नी बने, तो सोरग राज मा भराय नी सको। <verse eid="MAT 18:3"/><verse number="4" style="v" sid="MAT 18:4"/>आरू जो कोय आपसा क इन पोर्‍या क समान नाना करसे, त्यो सोरग क राज मा बड़ो हुयसे। <verse eid="MAT 18:4"/><verse number="5" style="v" sid="MAT 18:5"/>आरू जु कुई म्हार नाव सी एक असा नानला पोर्‍या क मान्य करे त्यो मेखे मान्य करे।<verse eid="MAT 18:5"/></para>
  <para style="s">पाप करनेन परीक्षा</para>
  <para style="r">(<ref loc="MRK 9:42-48">मरकुस 9:42-48</ref>; <ref loc="LUK 17:1-2">लूका 17:1-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6"/>“पर जु कुई इना माईन जु म्हार पर विश्वास करे है एक क ठुकर खवाड़े, उका करता वारू हुये, कि मटलो चक्‍की क पाट उका गला मा लटकाड़ देदो जाय, आरू त्यो उँडा पानी म न्हाख देदा जाय। <verse eid="MAT 18:6"/><verse number="7" style="v" sid="MAT 18:7"/>ठुकर क कारण दूनिया पर विखो! ठुकर क लगनो सच छे: पर विखु उना मानुस पर जिनान लारे ठुकर लागे।<verse eid="MAT 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:8 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:30">मत्ती 5:30</ref>
      </char>
    </note>“यदि थारो हाथ पाय तुखे ठुकर खवाड़े, तो काटीन न्हाख देय; टुण्डो या लेंगड़ो हुईन जीवन मा भरायनो थारे करता वारू छे, कि दूय हाथ या दूय पाय रहवीन तु जलोम धपनीया आग्ठा मा न्हाख दियो जासे। <verse eid="MAT 18:8"/><verse number="9" style="v" sid="MAT 18:9"/><note caller="+" style="x"><char style="xo" closed="false">18:9 </char><char style="xt" closed="false"><ref loc="MAT 5:29">मत्ती 5:29</ref></char></note>आरू कदाम थारा डुवा तुखे ठुकर खवाड़े तो उको निकालकर न्हाख दे। कांटो हुईन जीवन मा थारे करता इना सी वारू छे, कि दूय डुवा हुयन भी तु नरकन आगठा मा न्हाख दियो जासे।<verse eid="MAT 18:9"/></para>
  <para style="s">खुवायला गाडरान उदाहरण</para>
  <para style="r">(<ref loc="LUK 15:3-7">लूका 15:3-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:10 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 19:10">लूका 19:10</ref>
      </char>
    </note>“देखो, तुमू इना नाना माईन कोयक तुच्छ नी जननो; काहकि हाव तुमरे सी कहवो, कि सोरग मा ओको सोरगदूत म्हार सोरगन बास क मुय हमीसा देखसे छे। <verse eid="MAT 18:10"/><verse number="11" style="v" sid="MAT 18:11"/>काहकि मानुस क पोर्‍या खुवालान क हेरने करीन आवलो छे।<verse eid="MAT 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12"/>“तुमू काय समझो? कदाम कयो मानुस क सौ गाड़ गाडरा हय, आरू उका माईन खुवाय जाय, तो काय निन्यानवे क छुड़ीन, आरू बयड़ा पर जाईन, उना खुवायला गाडरान क नी हेरे?” <verse eid="MAT 18:12"/><verse number="13" style="v" sid="MAT 18:13"/>आरू कदाम असो हय कि उना खुवायला गाडरा क हेर लेय, तो हाव तुमरे सी सच कहवो, कि त्यो रहवला निनयानवे गाडरान क करता जो नी खुवाया हुता अतरो खुश नी हुये, जतरो कि इना खुवालान क मुवने पर करसे। <verse eid="MAT 18:13"/><verse number="14" style="v" sid="MAT 18:14"/>असोत् तुमरो बास की जो सोरग मा छे यी मरजी नी हय, कि इना नान माईन एक भी नाश नी हुय जाय।<verse eid="MAT 18:14"/></para>
  <para style="s">भाई–बहनीन क पाप</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15"/>“कदाम थारो भाई थारा विरोध मा पाप करे, तो जाईन आरू एखला मा वात करीन उको समझाड़ दे; कदाम त्यो थारी सुनी लेय तो तु थारा भाई क पाय लेदो।” <verse eid="MAT 18:15"/><verse number="16" style="v" sid="MAT 18:16"/>आरू कदाम त्यो नी सुने, तो आरू एक जन क थार साथ मा ली जा, कि हर एक वातन दूय या तीन गवाय क मुय सी बनली रये। <verse eid="MAT 18:16"/><verse number="17" style="v" sid="MAT 18:17"/>कदाम त्यो ओकी वात भी नी माने, तो मंडळी सी कय दे, कदाम त्यो मंडळी की भी नी माने, तो तु उको गैरयहुदी आरू फाळो लेनेवाळा क जसो जान।<verse eid="MAT 18:17"/></para>
  <para style="s">हक देना आरू हक ना देना</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:18 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:19">मत्ती 16:19</ref>; <ref loc="JHN 20:23">यहुन्ना 20:23</ref></char>
    </note>“हाव तुमरे सी सच कहवो, जो काय तुमू धरती पर बांधसे, त्यो सोरग मा बांधायसे आरू जो काय तुमू धरती पर खुले, त्यो सोरग मा खुलसे।”<verse eid="MAT 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19"/>पछु हाव रूमरे कहवो कदाम तुमरे माईन दूय जन धरती पर काहय वात क करता त्या मांगे, एक मन क हय, तो म्हार बास की तरप सी जो सोरग मा छे ओका करता हुय जासे। <verse eid="MAT 18:19"/><verse number="20" style="v" sid="MAT 18:20"/>“काहकि जा सारी दूय या तीन जन म्हार नाव सी एखटा हुये वा हाव उका वीच मा रहवो।”<verse eid="MAT 18:20"/></para>
  <para style="s">निर्दयी सेवक क सपनो</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">18:21 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 17:3">लूका 17:3</ref>,<ref loc="LUK 17:4">4</ref></char>
    </note>तव पतरस ईशु क पास आवीन कयो, “ए पोरबु, कदाम म्हार भाई पाप करतो रये, तो हाव कतरी वार उको माफ करो, काय सात वार तक?”<verse eid="MAT 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22"/>ईशु ओको सी कयो “हाव थार सी यो नी कहवो, कि सात बार तक, बाकुन सात बार क सत्तर क सात गुना तक।<verse eid="MAT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23"/>“अतरानकरीन करीन सोरग राजा उना राज क समान छे, जो आपसा दास सी लेखो लेनो चाहे। <verse eid="MAT 18:23"/><verse number="24" style="v" sid="MAT 18:24"/>जव त्यो लेखो लेने लागी गियो, तो एक जन उका सामने लायो गियो जो करोड़ो रूपयान कर्जदार हुतो। <verse eid="MAT 18:24"/><verse number="25" style="v" sid="MAT 18:25"/>जव कि त्योकाड़ने करीन उका पास मा काय नी हुतो, तो ओको मालिक कयो, कि त्यो आरू ओकी घर वाली आरू पोर्‍या पारी आरू जो काय ओको छे सब वेची दियो जाय, आरू वा कर्ज त्योकाड़ी दियो जाय। <verse eid="MAT 18:25"/><verse number="26" style="v" sid="MAT 18:26"/>इना पर त्यो दास मालिक क सामने गीरीन नमस्कार करियो, आरू कयो, ‘ए मालिक, गम राख हाव सब काय भर दिस।’ <verse eid="MAT 18:26"/><verse number="27" style="v" sid="MAT 18:27"/>तव उना दास क मालिक उका पर तरस खाईन छुड़ दीदो, आरू ओको कर्ज माफ कर दियो।<verse eid="MAT 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28"/>“बाकुन जव त्यो दास बाहर निकलियो, तो उका साथी दास माईन एक मिलियो, जो ओको सौ दीनार क कर्जदार हुतो; त्यो उको धरीन गलो दड़पीन कयो, ‘जो काय म्हार सी जो कर्ज लेदला छे पछो आप दे।’ <verse eid="MAT 18:28"/><verse number="29" style="v" sid="MAT 18:29"/>इना पर ओको साथी दास गिरीन, उका सी विनता करीन कयो; गम धर हाव सब भर दिस। <verse eid="MAT 18:29"/><verse number="30" style="v" sid="MAT 18:30"/>त्यो नी मानियो, बाकुन जाईन जेल खाना मा डाल दियो; कि जव तक कर्ज नी भर देय, तव तक वात रहवे। <verse eid="MAT 18:30"/><verse number="31" style="v" sid="MAT 18:31"/>ओको साथी दास जो हुयो हुतो देखीन बैस नराज हुयो, आरू जाईन आपसा मालिक क पूरो हाल कय देदो। <verse eid="MAT 18:31"/><verse number="32" style="v" sid="MAT 18:32"/>तव उको मालिक जेल खाना डालने वाला उना दास क बुलावीन कयो, ‘ए दुष्ट दास, तु जो म्हार सी विनती करियो, तो हाव थारो त्यो पूरो कर्ज माफ करीयो। <verse eid="MAT 18:32"/><verse number="33" style="v" sid="MAT 18:33"/>अतरानकरीन करीन जसो हाव थारे पर दया करियो, वसोत काय तुखे भी थारा साथी दास दया नी करनो हुतो काय?’ <verse eid="MAT 18:33"/><verse number="34" style="v" sid="MAT 18:34"/>आरू ओको मालिक रीस मा आवीन उको दण्ड देने वालान क हाथ मा सौप दियो, कि जव तक त्यो सब कर्ज नी भर देय, तव तक उका हाथ मा रये।<verse eid="MAT 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35"/>“इनी रीति सी कदाम तुमरे माईन हर एक आपसा भाईस मन सी माफ नी करसे, तो म्हार बास जो सोरग मा छे, तुमरे सी भी वसोत करसे।”<verse eid="MAT 18:35"/></para>
  <chapter eid="MAT 18"/>
  <chapter number="19" style="c" sid="MAT 19"/>
  <para style="s">तलाक क बारा ईशु की शिक्षा</para>
  <para style="r">(<ref loc="MRK 10:1-12">मरकुस 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1"/>जव ईशु यी वात कय त्योकियो, तो गलील सी जात रयो; आरू यहूदिया क सिमा जु यरदन नदी पार आयो। <verse eid="MAT 19:1"/><verse number="2" style="v" sid="MAT 19:2"/>आरू मटलो गर्दी ओको पछोळ हुय लेदा, आरू ईशु उन लोगहन क वा सी आरगो करियो।<verse eid="MAT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3"/>तव फरीसि ओकी पारख करने करीन पास आवीन कयनो लाग गिया, “काय हर कारण सी घर वाली क छुड़नो वारू छे?”<verse eid="MAT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4"/>ईशु जवाब दिदो, “काय तुमू नी भणिया, की जो उको बनायो, त्योत् शुरू सी नर आरू नारी करीन बनावीन कयो, <verse eid="MAT 19:4"/><verse number="5" style="v" sid="MAT 19:5"/>‘इना कारण सी मानुस आपसा माय बास सी अलग हुईन आपसी लाड़ी क साथ मा रहवसे आरू त्या दुयू एक डील हुयसे?’ <verse eid="MAT 19:5"/><verse number="6" style="v" sid="MAT 19:6"/>त्या दुय नी, बाकुन एक डील छे अतरानकरीन करीन जिना क यहोवा–भगवान जुड़ियो, मानुस उको अलग नी करनो जुवे।”<verse eid="MAT 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">19:7 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:31">मत्ती 5:31</ref>
      </char>
    </note>त्या ईशु सी कयो, “तव मूसा काय क यी वात टाकियो कि छुड़ने पत्री दीन छुड़ देय?”<verse eid="MAT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8"/>ईशु उन लोगहन सी कयो, “मूसा तुमरा मनन वातड़ी वातन क कारण सी तुमूक तुमरी लाड़ी क छुड़ देने करीन हक दियो, बाकुन शुरू मा असो नी हुतो।” <verse eid="MAT 19:8"/><verse number="9" style="v" sid="MAT 19:9"/><note caller="+" style="x"><char style="xo" closed="false">19:9 </char><char style="xt" closed="false"><ref loc="MAT 5:32">मत्ती 5:32</ref>; <ref loc="1CO 7:10">1 कुरन्थियो 7:10</ref>,<ref loc="1CO 7:11">11</ref></char></note>आरू हाव तुमरे सी कहवो, “कि जो कोय व्यभिचार क छुड़ीन आरू काहय कारण सी आपसी लाड़ी क छुड़ देय, आरू दिसरी सी इहाव करे, त्यो व्यभिचार करे; आरू जो उनी छुटली सी इहाव करे, त्यो भी व्यभिचार करे।”<verse eid="MAT 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10"/>चेला उका सी कयो, “कदाम ओदमी क बाई जात क साथ मा असो सम्बन्ध छे, तो इहाव करनो वारू नी हय।”<verse eid="MAT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11"/>त्यो उका सी कयो, “सब यो वचन नी मान सके, त्योत् मान सके जिनाक यो दान मुवलो छे। <verse eid="MAT 19:11"/><verse number="12" style="v" sid="MAT 19:12"/>काहकि काहय नपुंसक असा छे जो मायन पेट सी असा पैदा हुया; आरू काहय नपुंसक असा छे, जिन क मानुस नपुंसक बनायो: आरू काहय नपुंसक असा छे, जो सोरगदूत राज क करता आपसा क नपुंसक बनाड़े, जो मान सके त्यो माने।”<verse eid="MAT 19:12"/></para>
  <para style="s">पोर्‍या क सय बरकत</para>
  <para style="r">(<ref loc="MRK 10:13-16">मरकुस 10:13-16</ref>; <ref loc="LUK 18:15-17">लूका 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13"/>तव लोगहन पोर्‍या क ओका पास मा लाया, कि ईशु उन पर हाथ मेलीन प्रार्थना करे; पर चेला पोर्‍या क लावने वाला क लड़िया। <verse eid="MAT 19:13"/><verse number="14" style="v" sid="MAT 19:14"/>ईशु कयो, “नानला पोर्‍या क म्हार पास आवने देयो। आरू उना क मना मा करो, काहकि सोरग राज असलान क छे।”<verse eid="MAT 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15"/>आरू ईशु पोर्‍या मुनका पर हाथ मेलीन, वा सी चली गियो।<verse eid="MAT 19:15"/></para>
  <para style="s">जवान धनी मानुस</para>
  <para style="r">(<ref loc="MRK 10:17-31">मरकुस 10:17-31</ref>; <ref loc="LUK 18:18-30">लूका 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16"/>आरू एक मानुस ईशु क पास आवीन कयो, “ए गुरू, हाव काहलो वारलो काम करो, कि अमरकाय जीवन मुवे?” <verse eid="MAT 19:16"/><verse number="17" style="v" sid="MAT 19:17"/>ईशु ओका सी कयो, “तु म्हार सी वारला न बाराम कायको पुछे? भलो तो एकुत छे; पर कदाम तु जीवन मा जानो चाह्यो रियो, तो हुकुम क मानिया कर।”<verse eid="MAT 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18"/>जवान मानुस ईशु कयो, “काहली हुकुम?”</para>
  <para style="p" vid="MAT 19:18">ईशु कयो, “यो कि हत्या नी करनो, व्यभिचार नी करनो, चुरी नी करनो, झुटी गवाय नी देनो; <verse eid="MAT 19:18"/><verse number="19" style="v" sid="MAT 19:19"/>आपसा बास आरू आपसी माय क विजुत करजी, आरू आपसा पड़ोसी सी आपसेन जसो मोंग राखजी।”<verse eid="MAT 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20"/>त्यो जवान कयो, “इनी सब वातन क तो हाव नानलोतीन मानतो आयो अब मार मा काहली वात की कमी छे?”<verse eid="MAT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21"/>ईशु जवान क कयो, “कदाम तु सिद्ध हुयनो चाह्यो रयो; तो जा, थारो सब काय वेचीन गरीब लोगहन क वाट दे; आरू तुखे सोरग मा धन मुवसे; आरू आवीन म्हार पछोळ हुय ले।”<verse eid="MAT 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22"/>यो सोमवीन त्यो जुवान क चेहरो दुःखी हईन जात रयो, काहकि त्यो बैस धन क मालिक हुतो।<verse eid="MAT 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23"/>तव ईशु आपसा चेला सी कयो, “हाव तुमरे सी सच कहवो, कि धनवान क सोरग राज मा भरायनो वातड़ो छे। <verse eid="MAT 19:23"/><verse number="24" style="v" sid="MAT 19:24"/>पछु तुमरे सी कहवो, कि यहोवा–भगवान क राज मा धनवान क भरायने सी उटड़ा क सुवीन गाळा सी निकली जानो सरल छे।”<verse eid="MAT 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25"/>यो सोमवीन, चेला बैस घबराईन कयो, “पछु कुनीन उध्दार हुयसे?”<verse eid="MAT 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26"/>ईशु चेलान क आरू देखीन कयो, “मानसो सी तो नी हुय सके, बाकुन यहोवा–भगवान सी सब काय हुय सके।”<verse eid="MAT 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27"/>इना पर पतरस ईशु सी कयो, “देख, हामु सब काय छुड़ीन थारे पछोळ हुय लेदो तो हामु काय मुवसे?”<verse eid="MAT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28"/>ईशु चेला सी कयो, “हाव तुमरे सी सच कहवो, कि नवली उबजन मा जव मनुसक पोर्‍यो आपसी महिमा क साथ मा राजगाद्दी पर बठसे, तो तुमू भी जो म्हार पछोळ हुय लेदा, बारा राजगाद्दी पर बठीन इस्राएल क बारा वंश क न्याय करसे।” <verse eid="MAT 19:28"/><verse number="29" style="v" sid="MAT 19:29"/>हर एक जन जो मार करता, घर भाई–बहिनीस, माय बास, अवलियाद या खेत क छुड़ देय, उको सौ गुना फव मुवसे, आरू त्यो अमरकाय जीवन क हकदार हुयसे। <verse eid="MAT 19:29"/><verse number="30" style="v" sid="MAT 19:30"/><note caller="+" style="x"><char style="xo" closed="false">19:30 </char><char style="xt" closed="false"><ref loc="MAT 20:16">मत्ती 20:16</ref>; <ref loc="LUK 13:30">लूका 13:30</ref></char></note>बाकुन बैस सब जो पेहला छे, पछला हुसे; आरू जो पछला छे, पेहला हुयसे।<verse eid="MAT 19:30"/></para>
  <chapter eid="MAT 19"/>
  <chapter number="20" style="c" sid="MAT 20"/>
  <para style="s">वाड़ी क दाहड़क्या क सपनो</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1"/>“सोरग क राज कोय क घर धरती क समान छे, जो सन्दारे निकलियो, कि आपसा दाखन वाड़ी मा दाहड़किया क लगाड़या। <verse eid="MAT 20:1"/><verse number="2" style="v" sid="MAT 20:2"/>आरू त्यो दाहड़कियान एक दीनार दाहड़ान क दाड़की पर ठहरावीन, उन लोगहन क आपसी अंगुर न वाड़ी मा भेज दियो।” <verse eid="MAT 20:2"/><verse number="3" style="v" sid="MAT 20:3"/>पछु चु नव बजे बाहर ते निकलीन जातो हुतो, दिसरा लोगहन बजार मा बेकार मा उबा रहला देखीन, <verse eid="MAT 20:3"/><verse number="4" style="v" sid="MAT 20:4"/>आरू दाहड़किया सी कयो, तुमू भी अंगुर न वाड़ी मा जावो, आरू जो काय ठीक छे, तुम क दियोंगा। <verse eid="MAT 20:4"/><verse number="5" style="v" sid="MAT 20:5"/>पछु त्यो निकलीन छटवा आरू नवा घंटा मा नगर–चौक मा गिया आरू असोत् करिया। <verse eid="MAT 20:5"/><verse number="6" style="v" sid="MAT 20:6"/>आरू एक घंटा तक दिन रयो पछु निकलीन दिसरा क उबा देख्यु, आरू उन लोगहन सी कयो, “तुमू काय क या दाहड़ो भरीन बेकार उबरई रिया?” त्या उको कयो, अतरानकरीन करीन कि कोय हामुक दाहड़ की पर नी लगायो। <verse eid="MAT 20:6"/><verse number="7" style="v" sid="MAT 20:7"/>त्यो उन लोगहन क कयो, तुमू भी अंगुर न वाड़ी मा जावो।<verse eid="MAT 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8"/>शाम क अंगुर न वाड़ी क मालिक उका चाकरीया क कयो, “दाहड़कियान क बुलावीन पछला सी लीन पेहलो तक दाहड़की देय दे।” <verse eid="MAT 20:8"/><verse number="9" style="v" sid="MAT 20:9"/>जव चाँ आया, जा घंटा भर दाहाड़काय लागाड़या हता, त्या लोगहन क एक–एक दीनार मुविया। <verse eid="MAT 20:9"/><verse number="10" style="v" sid="MAT 20:10"/>जो पेहल आया, त्या यो समझिया, कि हामुक जादा हक मुवसे; बाकुन त्या लोगहन क भी एक दीनार मुवियो। <verse eid="MAT 20:10"/><verse number="11" style="v" sid="MAT 20:11"/>जव मुवियो, तो त्यो घर क मालिक पर किचवाईन कयनो लाग गिया, <verse eid="MAT 20:11"/><verse number="12" style="v" sid="MAT 20:12"/>बाद मा आवला दाहड़किया एक घंटो काम करिया, आरू तु उन लोगहन क हामरे बराबर कर दियो, आरू जो दाड़ो भरीन भार हाकलिया आरू तप क झेलीया?<verse eid="MAT 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13"/>वाड़ीन मालिक जवाब दियो, “ए भास्यो, हाव थार सी काय अन्याय नी करो; काहकि तुम म्हार सी एक दीनार कि दाडाड़की पर राजी नी हुया?” <verse eid="MAT 20:13"/><verse number="14" style="v" sid="MAT 20:14"/>जो थारो छे, उठाय ले, आरू चला जा; म्हारी मरजी यी छे कि जतरो थारो अतरो दिसरा क भी दीदे। <verse eid="MAT 20:14"/><verse number="15" style="v" sid="MAT 20:15"/>काय यो वारू नी हय कि हाव म्हारा माल सी जो मरजी वोसो करो? काय तु म्हार सी वारू हयने क कारण बुरी नजर सी देखे?<verse eid="MAT 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:16 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 19:30">मत्ती 19:30</ref>; <ref loc="MRK 10:31">मरकुस 10:31</ref>; <ref loc="LUK 13:30">लूका 13:30</ref></char>
    </note>“इनीये रीति सी पेहलो छे, त्यो पेहलो हुय जासे आरू जो पेहलो छे त्यो पछलो हुय जासे।”<verse eid="MAT 20:16"/></para>
  <para style="s">आपनो मरन क विषय ईशु की तीसरी भविष्यव्दाणी</para>
  <para style="r">(<ref loc="MRK 10:32-34">मरकुस 10:32-34</ref>; <ref loc="LUK 18:31-34">लूका 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17"/>ईशु यरूशलेम क जाता समय बाहर चेलान क एखला धरती मा ली गियो, आरू वाटे उन लोगहन सी कयनो लागियो। <verse eid="MAT 20:17"/><verse number="18" style="v" sid="MAT 20:18"/>“देखो, हामु यरूशलेम क जाजे; आरू मानुस क पोर्‍यो मुखी पुजारा आरू शास्त्रीया क हाथ सी धराय जासे आरू त्या उको घात क करता योग्य बनावसे। <verse eid="MAT 20:18"/><verse number="19" style="v" sid="MAT 20:19"/>आरू उको गैरयहुदी क हाथ मा सौप देसे, आरू कुड़ा देसे, आरू कुरूस पर चढ़ावे, आरू त्यो तीसरे दाहड़े मरला माईन जीवितो करियो जासे।”<verse eid="MAT 20:19"/></para>
  <para style="s">माय न विनती</para>
  <para style="r">(<ref loc="MRK 10:35-45">मरकुस 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20"/>जबदी क पोर्‍या माय आपसा पोर्‍या क साथ मा ईशु क पास आवीन नमस्कार करिया, आरू उका सी मांगने लागी।<verse eid="MAT 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21"/>ईशु ओका सी कयो, “तुको काय जुवे?” त्यो उका सी बोली, “यो कय दे, कि म्हार दूय पोर्‍या क थारा राजमा एक थारे जेवड़े आरू एक डासचिया तरफ बठे।”<verse eid="MAT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22"/>ईशु जाव देदो, “तुमू यो नी जानो कि काय मांग रिया। जो दुःख क वाटको हाव पीने पर छे, काय तुमू पी सको?” त्या उका सी कयो,</para>
  <para style="p" vid="MAT 20:22">“पी सकजे।” <verse eid="MAT 20:22"/><verse number="23" style="v" sid="MAT 20:23"/>ईशु उन लोगहन सी कयो, “तुमू म्हारो वाटको पीसो पर मार जेवड़ा आरू डासचिये कोयक बठाड़नो म्हारो काम नी हय, पर जिना क करता म्हार बासन तरफ सी तियार करीयो गयो, उका करता छे।”<verse eid="MAT 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24"/>यो सोमवीन, दसु चेला त्या याकूब आरू यहुन्ना दूय भाईस पर किचवाया। <verse eid="MAT 20:24"/><verse number="25" style="v" sid="MAT 20:25"/><note caller="+" style="x"><char style="xo" closed="false">20:25 </char><char style="xt" closed="false"><ref loc="LUK 22:25">लूका 22:25</ref>,<ref loc="LUK 22:26">26</ref></char></note>ईशु यन लोगहन क पास बुलावीन कयो, “तुमू जानो, कि गैरयहुदी क सरदार भी उना पर राज करे; आरू जो मटला छे त्या उन लोगहन पर हक जतावे। <verse eid="MAT 20:25"/><verse number="26" style="v" sid="MAT 20:26"/><note caller="+" style="x"><char style="xo" closed="false">20:26 </char><char style="xt" closed="false"><ref loc="MAT 23:11">मत्ती 23:11</ref>; <ref loc="MRK 9:35">मरकुस 9:35</ref>; <ref loc="LUK 22:26">लूका 22:26</ref></char></note>बाकुन तुमरे माईन असो कुन हसे; बाकुन जो कोय तुमरे माईन बड़ो हुयनो चाहे, त्यो तुमरो सेवक बने; <verse eid="MAT 20:26"/><verse number="27" style="v" sid="MAT 20:27"/>आरू जो तुमरे मा प्रधान हुयने चाहतु त्यो तुमरो दास बने; <verse eid="MAT 20:27"/><verse number="28" style="v" sid="MAT 20:28"/>जसो कि मानुस क पोर्‍यो, त्यो अतरानकरीन करीन नी आयो कि आपसी सेवा करावे, बाकुन अतरानकरीन करीन आयो सेवा करे आरू बैस जन क छुटकारा क करता आपसो जीव देय।”<verse eid="MAT 20:28"/></para>
  <para style="s">दुय आंधवा क दृष्टिदान</para>
  <para style="r">(<ref loc="MRK 10:46-52">मरकुस 10:46-52</ref>; <ref loc="LUK 18:35-43">लूका 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29"/>जव या यरीहो नगर सी निकली रया हुता, तो एक मटलो गर्दी उका पछोळ हुय लेदा। <verse eid="MAT 20:29"/><verse number="30" style="v" sid="MAT 20:30"/>आरू दूय आंधवा, जो सड़क क धड़े बठिया हुता, यो सोमवीन ईशु जाय रियो, आयड़ीन कयनो लाग गिया, “ए पोरबु दाऊदन अवलियाद, हामरे पर दया कर।”<verse eid="MAT 20:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31"/>लोगहन आंधवा क लड़िया कि चुप रये, पर त्या आरू भी आयड़ता रया, “ए पोरबु दाऊदन अवलियाद हामरे पर दया कर।”<verse eid="MAT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32"/>तव ईशु उबो हईन, आंधवा क बुलायो, आरू कयो, “तुमूक काय जुवे कि हाव तुमरे करता करो?”<verse eid="MAT 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33"/>आंधवा ईशु सी कयो, “ए पोरबु यो कि हामरा डुवा खुल जाय।”<verse eid="MAT 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34"/>ईशु दया करीन ओको डुवा क छिमियो, आरू त्या तत्काल देखने लाग गिया; आरू ईशु क पछोळ हुय लेदो।<verse eid="MAT 20:34"/></para>
  <chapter eid="MAT 20"/>
  <chapter number="21" style="c" sid="MAT 21"/>
  <para style="s">यरूशलेम मा विजय क भरायनो</para>
  <para style="r">(<ref loc="MRK 11:1-11">मरकुस 11:1-11</ref>; <ref loc="LUK 19:28-40">लूका 19:28-40</ref>; <ref loc="JHN 12:12-19">यहुन्ना 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1"/>जव त्या यरूशलेम क पास मा पुगिया आरू जैतुन बयड़ा पर बैतफगे क पास आया, तो ईशु चेलान क यो कहवीन मुकल्यो, <verse eid="MAT 21:1"/><verse number="2" style="v" sid="MAT 21:2"/>“आपने सामने वाला गाँव मा जावो, वा पुगीन एक गदड़ी बांधायली हसे, आरू उका साथ मा पीलो जड़से; उको खुलीन, म्हार पास ली आवो। <verse eid="MAT 21:2"/><verse number="3" style="v" sid="MAT 21:3"/>कदाम तुमरे सी कोय कहवे, तो कहवजो, कि पोरबु क इनको काम छे; तव त्यो तत्काल लावने क हुकुम दि देसे।”<verse eid="MAT 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4"/>यो अतरानकरीन करीन हुयो, कि जो वचन कागळीयान क लारे कयलो हुतो, पूरो हुये:<verse eid="MAT 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5"/>“सिय्योन क पोराय सी कहवो,</para>
  <para style="q2" vid="MAT 21:5">देख, थारो राजा थारे पास आवे;</para>
  <para style="q1" vid="MAT 21:5">त्यो नम्र आरू गदड़ा पर बठलो छे;</para>
  <para style="q2" vid="MAT 21:5">बाकुन गदड़ान पीला पर।”<verse eid="MAT 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6"/>चेला जात रया, आरू जसो ईशु चेलान क कयो हुतो, वसात करिया। <verse eid="MAT 21:6"/><verse number="7" style="v" sid="MAT 21:7"/>आरू गदड़ीन पीला क लावीन, उना पर छिंदरा डाल दिया आरू ईशु उका पर बठी गियो। <verse eid="MAT 21:7"/><verse number="8" style="v" sid="MAT 21:8"/>आरू जो गर्दी माईन कोय लोगहन वाटे पर आपसा छिंदरा बिछाया, आरू लोगहन झाड़कान डावखा काटीन वाटे पर बिछाया। <verse eid="MAT 21:8"/><verse number="9" style="v" sid="MAT 21:9"/>आरू जो गर्दी अगोळ–अगोळ जातली आरू पछोळ–पछोळ जातली गर्दी आयड़ी–आयड़ी कहवती हुती, “दाऊद क अवलियाद क होशान्ना; सयाला छे त्या जो पोरबुन नाम सी आवे, दाऊद न अवलियाद क स्तुती होय।”<verse eid="MAT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10"/>जव त्यो यरूशलेम मा भरायो, तो सब नगर मा हलचल मच गय; आरू लोगहन कयनो लाग गियो, “यो कुन छे?”<verse eid="MAT 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11"/>लोगहन कयो, “यो गलील नासरत क कागळीयो ईशु छे।”<verse eid="MAT 21:11"/></para>
  <para style="s">मंदिर छे व्यापारियो क निकाव देने</para>
  <para style="r">(<ref loc="MRK 11:15-19">मरकुस 11:15-19</ref>; <ref loc="LUK 19:45-48">लूका 19:45-48</ref>; <ref loc="JHN 2:13-22">यहुन्ना 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12"/>ईशु यहोवा–भगवान क मंदिर मा जाईन, उन सब क, जो लेन–देन कर रिया हुता, सब क मंदिर से निकाल दियो; आरू टेबलियान पर पेरवान क वेचने वालान चौकिया उलटाय दियो। <verse eid="MAT 21:12"/><verse number="13" style="v" sid="MAT 21:13"/>आरू उन लोगहन सी कयो, “लिखलो छे, म्हार घर प्रार्थना क घर कहवायसे; बाकुन उको डाकुन खण्ड बनाय रीया।”<verse eid="MAT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14"/>आरू आंधवा आरू लेंगड़ा, मंदिर मा उका पास मा, आरू त्यो उको आरगो करियो। <verse eid="MAT 21:14"/><verse number="15" style="v" sid="MAT 21:15"/>बाकुन जव मुखी पुजारा आरू शास्त्रीया इनु डाहला काम क जो ईशु करीयो, आरू पोर्‍या क मंदिर मा दाऊदन अवलियाद क होशान्ना आयड़ता जाईन देखियो, तो किचवाय गिया, <verse eid="MAT 21:15"/><verse number="16" style="v" sid="MAT 21:16"/>आरू ईशु सी कयनो लाग गिया, “काय तु सनी रीयो कि त्या काय कहवे?” ईशु उन लोगहन सी कयो, “होव; काय तुमू यो कदी नी भणीया; पोर्‍या आरू नानला दूध पीने वाला पोर्‍या सी तु बढ़ाई करायो?”<verse eid="MAT 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17"/>तव ईशु लोगहन क छुड़ीन नगर क बाहर जाती रियो आरू बैतनिया गाँव मा रात काटियो।<verse eid="MAT 21:17"/></para>
  <para style="s">फोव रहित गुलर क झाड़को</para>
  <para style="r">(<ref loc="MRK 11:12-14">मरकुस 11:12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18"/>वेगलु–वेगु क जव नगर तरफ आवतो हुतो, तो उको भुख लागी। <verse eid="MAT 21:18"/><verse number="19" style="v" sid="MAT 21:19"/>आरू अंजीर क झाड़को क किनारो देखीन त्यो उका पास मा गियो, आरू पान्टा क छुड़ीन उका मा आरू कोय नी मुव नी सकियो उका सी कयो, “अब से थारे मा आरू पछु कदी फव नी लागे।” आरू त्यो अंजीर क झाड़को तत्काल सुख गियो।<verse eid="MAT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20"/>यो देखीन चेला घबराय गिया, आरू कयो, “अंजीर क झाड़को जिनाक तु स्राप देदो हुतो, सुख गया छे?”<verse eid="MAT 21:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">21:21 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 17:20">मत्ती 17:20</ref>; <ref loc="1CO 13:2">1 कुरन्थियो 13:2</ref></char>
    </note>ईशु चेलान क जवाब दियो, “हाव तुमरे सी सच कहवो; कदाम तुमू विश्वास राख, आरू संका नी करो; तो तुमू यो नी करो, जो इना अंजीरन झाड़को सी करीयो गयो; बाकुन कदाम इना बयड़ा सी भी कहवसे कि उखड़ जा, आरू दरिया मा जाईन पड़ जा, तो यो हुय जासे। <verse eid="MAT 21:21"/><verse number="22" style="v" sid="MAT 21:22"/>आरू जो काय तुमू प्रार्थना मा विश्वास सी मांगसे त्यो सब तुमूक मुव जासे।”<verse eid="MAT 21:22"/></para>
  <para style="s">ईशु क हक पर सवाल</para>
  <para style="r">(<ref loc="MRK 11:27-33">मरकुस 11:27-33</ref>; <ref loc="LUK 20:1-8">लूका 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23"/>ईशु यरूशलेम मंदिर मा जाईन शिक्षा दी रियो हुतो, कि मुखी पुजारो आरू लोगहन क डाहडा उका पास मा आवीन पुछिया, “तु यो काम काहला हक सी कर रियो? आरू तुको यो हक कुन दियो?”<verse eid="MAT 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24"/>ईशु उन लोगहन क जवाब दियो, “हाव भी तुमरे सी एक वात पुछो; कदाम त्यो मेखे देखाड़से, तो हाव भी तुमको देखाड़ दीस कि यो काम काहला हक सी करो।” <verse eid="MAT 21:24"/><verse number="25" style="v" sid="MAT 21:25"/>यहुन्ना क बपतिस्मा कहना तरफ सी हुतो? “सोरग क तरफ सी या मानुस क तरफ सी हुतो?”</para>
  <para style="p" vid="MAT 21:25">तव त्या एक दिसरा सी विचार करने लाग गिया, कदाम हामु कयजे “सोरग सी, तो त्यो हामरे सी कहवसे की, पछु तुमू उको विश्वास काँ नी करिया?” <verse eid="MAT 21:25"/><verse number="26" style="v" sid="MAT 21:26"/>आरू कदाम कयसु कि मानुस की तरफ सी, तो हामुक गर्दी सी बीक छे, “काहकि त्या सब यहुन्ना क कागळीयो मानता हुता।” <verse eid="MAT 21:26"/><verse number="27" style="v" sid="MAT 21:27"/>असा करीन त्या ईशु क जवाब देदो,</para>
  <para style="p" vid="MAT 21:27">“हामु नी जानजे।” ईशु भी उन लोगहन सी कयो, “तो हाव भी नी देखाड़ो, कि यो काम काहला हक सी करोम।”<verse eid="MAT 21:27"/></para>
  <para style="s">दुय पोर्‍या सपनो</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28"/>तुमू काय समझो? कोय मानुस क दूय पोर्‍या हुता; त्यो पेहला क पास जाईन कयो, “ए बेटा, आज अंगुर न वाड़ी मा काम कर। <verse eid="MAT 21:28"/><verse number="29" style="v" sid="MAT 21:29"/>त्यो पोर्‍यो जवाब दियो ‘हाव नी जावो,’ बाकुन बाद मा पछतावो जाती रयो। <verse eid="MAT 21:29"/><verse number="30" style="v" sid="MAT 21:30"/>पछु दूसरा क पास मा जाईन असोत् कयो, त्यो जवाब दियो, होव हाव जावो, बाकुन नी गियो।” <verse eid="MAT 21:30"/><verse number="31" style="v" sid="MAT 21:31"/>“इना दूय माईन कुन बास कि मरजी पूरी करियो?” त्यो कयो,</para>
  <para style="p" vid="MAT 21:31">त्या कयो “पेहलो करीयो”</para>
  <para style="p" vid="MAT 21:31">ईशु तुमूक सच कहवो, कि फाळो लेनेवाळा आरू वेश्या तुमरे सी पेहले सोरगदूत राज भराये। <verse eid="MAT 21:31"/><verse number="32" style="v" sid="MAT 21:32"/>काहकि यहुन्ना न्यायपन वाटे सी आयो, आरू तुमू उना पर विश्वास नी करिया: बाकुन फाळो लेनेवाळा आरू वेश्या लोगहन उका पर विश्वास करिया: आरू तुम यो देखने क बाद मा भी नी पछतावो करिया कि उको विश्वास करे।<verse eid="MAT 21:32"/></para>
  <para style="s">दुष्ट किरसान क सपनो</para>
  <para style="r">(<ref loc="MRK 12:1-12">मरकुस 12:1-12</ref>; <ref loc="LUK 20:9-19">लूका 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33"/>“एक आरू दृष्टान्त सोमवी लेवु एक घर हुतो, जो अंगुर क वाड़ी लगाड़यो; आरू ओको चार तरफ वाड़ बांध देदो; आरू उका मा रस कुण्डा खुँदीयो; आरू मचान बनायो; आरू किसान लोगहन क उको ठेको आपीन परदेश जाती रयो।” <verse eid="MAT 21:33"/><verse number="34" style="v" sid="MAT 21:34"/>बाकुन जव फव क समय साते आयो, तो मालिक आपसा दास लोगहन क ओको अंगुर क वाड़ी क फव क भाग करीन किसानो क पास मा मोकल्यो। <verse eid="MAT 21:34"/><verse number="35" style="v" sid="MAT 21:35"/>बाकुन किसान लोगहन उका दास लोगहन क धरीन कोय क थापड़ धुमू देदो, आरू कोय क मार न्हाखिया; आरू कोय क उपर दगड़ा देदो। <verse eid="MAT 21:35"/><verse number="36" style="v" sid="MAT 21:36"/>पछु त्यो आरू दास लोगहन क मुकल्यो, जो पेहले हुता; आरू किसान ओको सात मा भी वसात करीया। <verse eid="MAT 21:36"/><verse number="37" style="v" sid="MAT 21:37"/>आखरी मा मालिक आपसा पोर्‍या क किसान क पास मा मुकली देदो, कि त्या उका पोर्‍या क विजुत करसे। <verse eid="MAT 21:37"/><verse number="38" style="v" sid="MAT 21:38"/>बाकुन किरसान क पोर्‍या क देखीन एकु करीन कयो, “यो तो हकदारियो छे, आवो, उको मार न्हाखजे आरू उको हक ली लेजे।” <verse eid="MAT 21:38"/><verse number="39" style="v" sid="MAT 21:39"/>आरू किरसान ओको धर लेदो आरू अंगुर न वाड़ी सी बाहर निकालीन मार न्हाखिया। <figure style="fig" alt="Watchtower in a vineyard" file="hk00105c.tif" size="col" copy="Horace Knowles ©" ref="21:33">अंगुरन वाड़ीक मा मांडवु</figure><verse eid="MAT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40"/>“अतरानकरीन करीन जव अंगुर न वाड़ीन मालिक आवसे, तो उन किरसानिया क साथ मा काय करसे?”<verse eid="MAT 21:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41"/>त्या जवाब दीदा, “मालिक उन बुरा किरसानिया लोगहन क नाश कर देसे, आरू अंगुर न वाड़ी क असा किरसान क पट्टा आपी देसे, जो उनाक सय समय पर वाड़ी माईन फव क दिया करसे।”<verse eid="MAT 21:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42"/>ईशु चेला क कयो, “काय तुमू कदी चुखलो शास्त्र मा यो नी भणिया?”</para>
  <para style="q1" vid="MAT 21:42">“जिना दगड़ा क राज मिस्तरी कामको नी समझिया हुता,</para>
  <para style="q2" vid="MAT 21:42">त्यो लुहूय या क खास दगड़ो नब गियो</para>
  <para style="q1" vid="MAT 21:42">यो पोरबुन तरफ सी हुयो,</para>
  <para style="q2" vid="MAT 21:42">आरू हामरे देखने विछेळीयो छे।”<verse eid="MAT 21:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43"/>“अतरानकरीन करीन हाव तुमरे सी कहवो, कि यहोवा–भगवानन राज तुमरे सी ली लेदो जासे; आरू असी जाति क दे दियो जासे, जो ओको कमाय लावे। <verse eid="MAT 21:43"/><verse number="44" style="v" sid="MAT 21:44"/>जो इना दगड़ा पर पड़से, त्यो चुर हुय जासे: आरू जिना पर त्यो दगड़ो पड़से, उको चिमधी देसे।”<verse eid="MAT 21:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45"/>मुखी पुजारा आरू फरीसि उका उदाहरण क समझ गिया, कि त्यो हामरा बाराम कहवे। <verse eid="MAT 21:45"/><verse number="46" style="v" sid="MAT 21:46"/>आरू त्या उको मुखी पुजारा ईशु क धरने चाह्या, काहकि त्या उनाक कागळीयो मानता हुता।<verse eid="MAT 21:46"/></para>
  <chapter eid="MAT 21"/>
  <chapter number="22" style="c" sid="MAT 22"/>
  <para style="s">वियाव भोज न दाखलो</para>
  <para style="r">(<ref loc="LUK 14:15-24">लूका 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1"/>अतरा पर ईशु पछु उन लोगहन क उदाहरण मा कयने लाग गियो। <verse eid="MAT 22:1"/><verse number="2" style="v" sid="MAT 22:2"/>“सोरग राज उना राजा क समान छे, जो आपसा पोर्‍या क वियाव करियो।” <verse eid="MAT 22:2"/><verse number="3" style="v" sid="MAT 22:3"/>आरू त्यो आपसा दास क मुकल्यो, कि नेवतो आपला लोगहन क खाने पर बुलावे; बाकुन त्या आवने नी करिया। <verse eid="MAT 22:3"/><verse number="4" style="v" sid="MAT 22:4"/>पछु त्यो आरू दासो न क यो कहवीन मुकल्यो, नेवतो आपला लोगहन सी कहवो: देखो, हाव खानो तियार कर लीदो, आरू म्हारा बैल आरू पावला जनवार क मारलो छे आरू सब तियार छे; वियाव क खाना मा आवो। <verse eid="MAT 22:4"/><verse number="5" style="v" sid="MAT 22:5"/>बाकुन त्या वाट जुवीन जाती रिया; कोय आपसा खेत मा कोय आपसा काम पर। <verse eid="MAT 22:5"/><verse number="6" style="v" sid="MAT 22:6"/>दूसरा लोगहन जो वाचला हुता उका दास क दरीन ओको विजुत नी करीया आरू मार न्हाखिया। <verse eid="MAT 22:6"/><verse number="7" style="v" sid="MAT 22:7"/>तव राजा क रीश लागी, आरू त्यो आपसी सेना क भेजीन मारने वाला लोगहन क नाश कर दिया। <verse eid="MAT 22:7"/><verse number="8" style="v" sid="MAT 22:8"/>तव त्यो दासो सी कयो, वियाव क खानो तो तियार छे, बाकुन नेवतो आपला लोगहन क योग्य नी बने। <verse eid="MAT 22:8"/><verse number="9" style="v" sid="MAT 22:9"/>अतरानकरीन करीन अब तुमू चवराया पर जावो आरू वा तुम क जतरा लोगहन मुवे सब क वियावन खाना पर बुलावी लावो। <verse eid="MAT 22:9"/><verse number="10" style="v" sid="MAT 22:10"/>आरू त्या दास लोगहन सड़को पर जाईन काय बुरा, काय वारला, सब लोगहन क एखटा करीया; आरू वियाव क घर पाहंतरिया सी भराय गिया।<verse eid="MAT 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11"/>“जव राजा पाहंतरीया क देखने माहय आयो; तो राजा वा एक मानुस क देखियो, जो वियाव क छिंदरा नी पेहनलो हुतो।” <verse eid="MAT 22:11"/><verse number="12" style="v" sid="MAT 22:12"/>त्यो उका सी पुछियो, ए भाई; तु वियाव क छिंदरा नी पेहनियो, आरू असो काय क आयो? आरू त्यो मानुस चुप हुय गियो। <verse eid="MAT 22:12"/><verse number="13" style="v" sid="MAT 22:13"/>तव राजा सेवक लोगहन क कयो, “एका हाथ पाय बांधीन उना उको बाहर आँधरला मा न्हाख देयो, वा रड़नो, आरू दात पीसनो हुयसे।”<verse eid="MAT 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14"/>“काहकि बुलावला तो बैस छे बाकुन नेवाड़ला कम छे।”<verse eid="MAT 22:14"/></para>
  <para style="s">कैसर क कर आपनो</para>
  <para style="r">(<ref loc="MRK 12:13-17">मरकुस 12:13-17</ref>; <ref loc="LUK 20:20-26">लूका 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15"/>तव फरीसियों जाई एकु करीन विचार करीया, कि उको काहली रीति सी वात मा फसाड़से। <verse eid="MAT 22:15"/><verse number="16" style="v" sid="MAT 22:16"/>ईशु आपसा चेलान क हेरोदिया नक सात मा उका पास यो कयनो मुकल्यो, “ए गुरू, हामु जानजे, कि तु सच छे, आरू यहोवा–भगवान क वाट क बाराम सिखाड़े। आरू कोय क बाराम फिकुर नी करे, काहकि तु मानुस क मुय देखीन वात नी करे। <verse eid="MAT 22:16"/><verse number="17" style="v" sid="MAT 22:17"/>अतरानकरीन करीन हामुक देखाड़ तु काय समझे? कैसर क फाळो देनो वारू छे, कि नी।”<verse eid="MAT 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18"/>ईशु उन लोगहन दुष्टता जानीन कयो, “ए ढोंग करनिया, मेखे काय क पारखी रिया?”<verse eid="MAT 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 22:19"/>“फाळान सिक्‍को मेखे देखाड़ो।” तव त्या उका पास एक दीनार क छापो लावीन देखाड़िया। <verse eid="MAT 22:19"/><verse number="20" style="v" sid="MAT 22:20"/>ईशु त्या लोगहन क पुछियो, “यो छापो आरू नाव कुनीन छे?”<verse eid="MAT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21"/>त्या लोगहन ईशु सी कयो, “कैसर क।” तव ईशु कयो, “जो कैसर क छे, त्यो कैसर क; आरू जो यहोवा–भगवान क छे; त्यो यहोवा–भगवान क देजो।”<verse eid="MAT 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22"/>यो सोमवीनत्या घबराय गिया, आरू उको छुड़ीन जाती रिया।<verse eid="MAT 22:22"/></para>
  <para style="s">पुनरूत्थान आरू वियाव</para>
  <para style="r">(<ref loc="MRK 12:18-27">मरकुस 12:18-27</ref>; <ref loc="LUK 20:27-40">लूका 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:23 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 23:8">प्रेरितन 23:8</ref>
      </char>
    </note>उना दिन सदूकियो जा कयता छे कि मरला क पछो जीवनो नी हय, ईशु क पास आया आरू पुछिया, <verse eid="MAT 22:23"/><verse number="24" style="v" sid="MAT 22:24"/>“ए गुरू, मूसा तो कयो हुतो, कि कदाम कोय बीना अवलियाद क मर जाय, तो ओको भाई ओकी घर वाली सी वियाव कर लेय आरू आपसा भाई क करता अवलियाद पैदा करे। <verse eid="MAT 22:24"/><verse number="25" style="v" sid="MAT 22:25"/>अब हामरे या सात भाईस हुता; पेहलो वियाव करीन विना अवलियाद मर गियो; आरू अवलियाद नी हुयने क कारण आपसी घर वाली क आपसा भाई क करता छुड़ गियो। <verse eid="MAT 22:25"/><verse number="26" style="v" sid="MAT 22:26"/>इनी रीति सी दुसरो आरू तीदरो भी करियो, आरू सात भाईसो तक यो हुयो। <verse eid="MAT 22:26"/><verse number="27" style="v" sid="MAT 22:27"/>सब क बाद मा सेवाट त्या बायर भी मर गयी। <verse eid="MAT 22:27"/><verse number="28" style="v" sid="MAT 22:28"/>हिमी जीव उठने पर त्या बायर सातो माईन कुनीन घर वाली हयसे? काहकि त्या सबन घर वाली बनली हती।”<verse eid="MAT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29"/>ईशु उन लोगहन क जवाब देदो, “तुमू चुखलो शास्त्र आरू यहोवा–भगवानन शक्ति नी जानो; इना कारण सी भुल मा पड़ गया। <verse eid="MAT 22:29"/><verse number="30" style="v" sid="MAT 22:30"/>काहकि जीव उठने क बाद मा इहाव–वियाव नी हये; बाकुन त्या सोरग क मा सोरगदूत समान हुयसे। <verse eid="MAT 22:30"/><verse number="31" style="v" sid="MAT 22:31"/>बाकुन मरला माईन जीव उठने क बारा मा काय तुमू यो वचन नी भणिया जो यहोवा–भगवान तुमरे सी कयो: <verse eid="MAT 22:31"/><verse number="32" style="v" sid="MAT 22:32"/>हाव अब्राहम क यहोवा–भगवान, आरू इसहाक क यहोवा–भगवान, आरू याकूब क यहोवा–भगवान छे? त्यो मरला क नी, बाकुन जीवतलान क यहोवा–भगवान छे।”<verse eid="MAT 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33"/>यो सोमवीन लोगहन शिक्षा सी घबराय गिया।<verse eid="MAT 22:33"/></para>
  <para style="s">आखा सी मोटली हुकुम</para>
  <para style="r">(<ref loc="MRK 12:28-34">मरकुस 12:28-34</ref>; <ref loc="LUK 10:25-28">लूका 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34"/>जव फरीसिया यो सुनिया कि ईशु सदूकियोंयोंन मुय क बंद कर देदो; तो त्या एखटा हुया। <verse eid="MAT 22:34"/><verse number="35" style="v" sid="MAT 22:35"/>आरू उना व्यवस्थापक एक नियम सिकाड़ने वालो ईशु क पारेखने करीन उका सी पुछियो, <verse eid="MAT 22:35"/><verse number="36" style="v" sid="MAT 22:36"/>“हे गुरू, नियम मा कुन सो हुकुम बड़ो छे?” <verse eid="MAT 22:36"/><verse number="37" style="v" sid="MAT 22:37"/>ईशु उका सी कयो, “तु यहोवा–भगवान आपसा पोरबु सी सब मन आरू सारे जीव सी आरू आपसी सारी ओकल क साथ मा मोंग राख। <verse eid="MAT 22:37"/><verse number="38" style="v" sid="MAT 22:38"/>बड़ो आरू खास हुकुम यो छे। <verse eid="MAT 22:38"/><verse number="39" style="v" sid="MAT 22:39"/>आरू उका समान दूसरी भी छे, कि आपसा पड़ोस मा रहवने वाला सी आपसे जसो मोंग राख। <verse eid="MAT 22:39"/><verse number="40" style="v" sid="MAT 22:40"/><note caller="+" style="x"><char style="xo" closed="false">22:40 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">लूका 10:25-28</ref></char></note>यो दूय हुकुम आखा नियम आरू कागळिया क पुरावो छे।”<verse eid="MAT 22:40"/></para>
  <para style="s">मसीह कुनीन पोर्‍य छे?</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41"/>जव फरीसि एखटा हुता, तो ईशु उन लोगहन सी पुछियो,<verse eid="MAT 22:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 22:42"/>“मसीह क बाराम तुमू काय समझो? त्यो कुनीन अवलियाद छे? त्या ओका सी कयो, दाऊद क पोर्‍यो।”<verse eid="MAT 22:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43"/>त्यो उन लोगहन सी पुछियो, “तो दाऊद आत्मा मा हुईन उको पोरबु काय क कहवे?”<verse eid="MAT 22:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44"/>“पोरबु, म्हार पोरबु सी कयो,</para>
  <para style="q2" vid="MAT 22:44">म्हार जेवड़ा तरफ बठ,</para>
  <para style="q2" vid="MAT 22:44">जव तक कि हाव थारा दुस्मन क थारा पाय की चौवकी नी कर देयम्।”<verse eid="MAT 22:44"/></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45"/>“जव, दाऊद उको पोरबु कहवे, तो त्यो उको पोर्‍यो कसो बन्या?”<verse eid="MAT 22:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46"/>उका जवाब मा कोय एक भी वात नी कय सकिया। बाकुन उना दिन सी कोय कि भी ओको सी पुछने करीन हिंमत नी हय।<verse eid="MAT 22:46"/></para>
  <chapter eid="MAT 22"/>
  <chapter number="23" style="c" sid="MAT 23"/>
  <para style="s">शास्त्रीयो आरू फरीसियो छे सावधान</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1"/>तव ईशु गर्दी सी आरू आपसा चेला सी कयो, <verse eid="MAT 23:1"/><verse number="2" style="v" sid="MAT 23:2"/>शास्त्री आरू फरीसि मूसान गाद्दी पर बठला छे; <verse eid="MAT 23:2"/><verse number="3" style="v" sid="MAT 23:3"/>अतरानकरीन करीन त्या तुमरे सी जो कहवे त्यो करनो, आरू माननो, बाकुन उका जसा काम नी करनो; काहकि त्या कहवे तो सचा बाकुन करे नी। <verse eid="MAT 23:3"/><verse number="4" style="v" sid="MAT 23:4"/>त्या एक असो भारी भार क जिनाक उठावनो वातड़ो छे, बांधीन उको मानुस क काँधा पर राखे; बाकुन आपसु उको आपसी आँगवी सी भी सरकावनो नी करे। <verse eid="MAT 23:4"/><verse number="5" style="v" sid="MAT 23:5"/><note caller="+" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="MAT 6:1">मत्ती 6:1</ref></char></note>त्या आपसा सब काम लोगहन क देखाड़ने करीन करे त्या आपसा उनी पट्टी क चवड़ा करे जीना पर चुखलो शास्त्र क वचन लिखे आरू आपसा छिन्दरान झालर क बढ़ावे। <verse eid="MAT 23:5"/><verse number="6" style="v" sid="MAT 23:6"/>दावत मा खास धरती, आरू आराधना घर मा खास जागो, <verse eid="MAT 23:6"/><verse number="7" style="v" sid="MAT 23:7"/>आरू बजार मा नमस्कार आरू मानुस मा गुरू कयनो उन लोगहन क वारू लागे। <verse eid="MAT 23:7"/><verse number="8" style="v" sid="MAT 23:8"/>बाकुन तुमू गुरू झुण बनता, काहकि तुमरो एकुत् गुरू छे: आरू तुमू सब भाईस छे। <verse eid="MAT 23:8"/><verse number="9" style="v" sid="MAT 23:9"/>आरू धरती पर कोय क आपसो बास नी कयनो, काहकि तुमरो एकुत् बास छे, जो सोरगदूत मा छे। <verse eid="MAT 23:9"/><verse number="10" style="v" sid="MAT 23:10"/>आरू मालिक भी नी कयनो, काहकि तुमरो एकुत् मालिक छे, त्यो मसीह। <verse eid="MAT 23:10"/><verse number="11" style="v" sid="MAT 23:11"/><note caller="+" style="x"><char style="xo" closed="false">23:11 </char><char style="xt" closed="false"><ref loc="MAT 20:26">मत्ती 20:26</ref>,<ref loc="MAT 20:27">27</ref>; <ref loc="MRK 9:35">मरकुस 9:35</ref>; <ref loc="MRK 10:43">10:43</ref>,<ref loc="MRK 10:44">44</ref>; <ref loc="LUK 22:26">लूका 22:26</ref></char></note>जो तुमरे मा बड़ो छे, त्यो तुमरो सेवक बने। <verse eid="MAT 23:11"/><verse number="12" style="v" sid="MAT 23:12"/><note caller="+" style="x"><char style="xo" closed="false">23:12 </char><char style="xt" closed="false"><ref loc="LUK 14:11">लूका 14:11</ref>; <ref loc="LUK 18:14">18:14</ref></char></note>जो कोय आपसा क बड़ो बनावसे, त्यो नानो कर दियो जासे: आरू जो कोय आपसा क नानो बनावसे, त्यो बड़ो करीयो जासे।<verse eid="MAT 23:12"/></para>
  <para style="s">ईशु उका पाखंडीन निंदा करतो छे</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13"/>“ए खोट राखने वाला शास्त्री आरू फरीसिया तुमरे पर धिक्‍कार!” तुमू मानुस क विरोध मा सोरगन राज क झपलो बंद करे, नी तो आपसु उका मा भराये आरू नी उका मा भरायने वाला क भरायने देय। <verse eid="MAT 23:13"/><verse number="14" style="v" sid="MAT 23:14"/>ए कपट राखने वाला शास्त्रीया आरू फरीसिया, तुमू पर धिक्‍कार! तुमू रंडायलान क घर क खाय जाय: आरू देखाड़नेन करीन घण देर तक प्रार्थना करता रहवे; अतरानकरीन करीन तुमूक जादा दण्ड मुवसे।<verse eid="MAT 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15"/>“ए कपट राखने वाला शास्त्री आरू फरीसिया तुमू पर धिक्‍कार!” तुमू एक जन क आपसा मत मा लावने करीन सब जल आरू थल मा फिरे, आरू जव त्यो मत मा आवी जाय, तो उको नरकन आगठा क दूय गुना दण्ड झेलने जुगु बनाव देय।<verse eid="MAT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16"/>“ए आंधवा अगळवानिया, तुमरे पर विखु, जो यो सिकाड़े, कदाम कोय मंदिर की कसम खाय तो काय नी, बाकुन कदाम कोय मंदिरन सोना की कसम खाय त्यो उका सी बांधाय जासे।” <verse eid="MAT 23:16"/><verse number="17" style="v" sid="MAT 23:17"/>ए विन अकलाय, आरू आंधवा, कुन बड़ो छे, सोनो या त्यो मंदिर जिना सी सोनो चुखलो हुये? <verse eid="MAT 23:17"/><verse number="18" style="v" sid="MAT 23:18"/>पछु यो कहवो कि कदाम कोय वेदीन कसम खाय तो काय नी, बाकुन जो भेंट उना पर छे, कदाम कोय ओकी कसम खाय तो बांधाय जासे। <verse eid="MAT 23:18"/><verse number="19" style="v" sid="MAT 23:19"/>ए आंधवा, कुन बड़ो छे, भेंट या वेदी जिना सी भेंट चुखलो हुये? <verse eid="MAT 23:19"/><verse number="20" style="v" sid="MAT 23:20"/>अतरानकरीन करीन जो वेदीन कसम खाय, त्यो ओकी, आरू जो काय उना पर छे, ओकी भी कसम खाय। <verse eid="MAT 23:20"/><verse number="21" style="v" sid="MAT 23:21"/>आरू जो मंदिरन कसम खाय, त्यो ओकी आरू उका मा रहवने वालान क कसम खाय। <verse eid="MAT 23:21"/><verse number="22" style="v" sid="MAT 23:22"/><note caller="+" style="x"><char style="xo" closed="false">23:22 </char><char style="xt" closed="false"><ref loc="MAT 5:34">मत्ती 5:34</ref></char></note>आरू जो सोरग कसम खाय, त्यो यहोवा–भगवान क सिंहासन आरू उना पर बठने वालान कसम खाय।<verse eid="MAT 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23"/>“हे कपट राखने वाला शास्त्रीया! आरू फरीसिया, तुमू पर धिक्‍कार! तुमू पोदीन आरू सुप आरू जीरा क दसवो भाग देयो, बाकुन तुम नियम क सची वातन क नियाव आरू दया, आरू विश्वास क छुड़ दिया; तुमू इन क भी करता रहवनो हुतो, आरू उनाक भी नी छुड़नो हुतो।” <verse eid="MAT 23:23"/><verse number="24" style="v" sid="MAT 23:24"/>ए आंधवा अगळवानिया, तुमू चाचवड़ीया क तो झारीन देयु, बाकुन उटड़ा क निगल जाय।<verse eid="MAT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25"/>“ए कपट राखने वाला शास्त्रीया, आरू फरीसिया, तुमू पर धिक्‍कार! तुमू वाटका आरू थावी क ऊपर–ऊपर सी तो मांज देय बाकुन त्या माहय गन्धायला रये। <verse eid="MAT 23:25"/><verse number="26" style="v" sid="MAT 23:26"/>ए आंधवा फरीसि, पेहले कटोरा आरू थाली क माहय सी मांजे बाकुन बाहर सी भी साफ रये।”<verse eid="MAT 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27"/>धिक्‍कार छे तुमरे पर ढोंगी, फरीसियों, शास्त्रीया! तुमू उना बीड़ान समान छे जो बाहर सी वारू बनावे आरू माहय सी मरला मानुस क हाड़का आरू आखी विटळ भातीन रये, <verse eid="MAT 23:27"/><verse number="28" style="v" sid="MAT 23:28"/>तुम भी बाहर सी तो मानुस क न्यायी देखाय पड़े बाकुन तुमरे माहय कपट आरू अन्याय सी भरायला छे।<verse eid="MAT 23:28"/></para>
  <para style="s">शास्त्रीयो आरू फरीसियो पर दण्ड की भविष्यव्दाणी</para>
  <para style="r">(<ref loc="LUK 11:47-51">लूका 11:47-51</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29"/>“हे कपट राखने वाला शास्त्रीया आरू फरीसिया तुमरे पर धिक्‍कार! तुमू कागळीयान आरू न्यायीक बीड़ान क तो वारू बनावे।” <verse eid="MAT 23:29"/><verse number="30" style="v" sid="MAT 23:30"/>आरू कयता रये, “कदाम हामु आपसा डाहडन क दीन मा हुता तो भविष्यवक्ता की मारने मा उका साथ दीदा।” <verse eid="MAT 23:30"/><verse number="31" style="v" sid="MAT 23:31"/>इना सी तो तुमू आपसुत् गवाय देय, कि तुमू कागळीयान क हत्या करने वालान अवलियाद छे। <verse eid="MAT 23:31"/><verse number="32" style="v" sid="MAT 23:32"/>आरू तुमू आपसा डाहड़ान क पापन ढुसरों भर दे। <verse eid="MAT 23:32"/><verse number="33" style="v" sid="MAT 23:33"/><note caller="+" style="x"><char style="xo" closed="false">23:33 </char><char style="xt" closed="false"><ref loc="MAT 3:7">मत्ती 3:7</ref>; <ref loc="MAT 12:34">12:34</ref>; <ref loc="LUK 3:7">लूका 3:7</ref></char></note>ए घड़सा, क पोर्‍या, तुमू नरक क दण्ड से कसा वाचसु? <verse eid="MAT 23:33"/><verse number="34" style="v" sid="MAT 23:34"/>अतरानकरीन करीन, हाव तुमरे पास कागळिया आरू अकलवाला आरू शास्त्रीया क भेजो; आरू तुमू उना मा सी कोय क तो मार न्हाखसे, आरू कुरूस पर चढ़ावसु; आरू कोय क आपसा आराधना घर मा कुड़ा लगाड़ से, आरू एक नगर सी दुसरा नगर मा दवड़ावता पछु सु। <verse eid="MAT 23:34"/><verse number="35" style="v" sid="MAT 23:35"/>जिना न्यायी हाबील सी लगाड़ीन बिरिक्याक पोर्‍यो जकर्‍याह तक, जिनाक तुमू मंदिरन आरू वेदी वीच मा मार न्हाखिया हुता, जतरा न्यायीपन क लुहूय यो धरती पर बस्या, त्यो सब तुमरा माथा पर पड़से। <verse eid="MAT 23:35"/><verse number="36" style="v" sid="MAT 23:36"/>हाव तुमरे सी सच कहवो, यी सब वात इनी पीढ़ी पर आय पड़से।<verse eid="MAT 23:36"/></para>
  <para style="s">यरूशलेम क करता विलाप</para>
  <para style="r">(<ref loc="LUK 13:34-35">लूका 13:34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37"/>“हे यरूशलेम, यरूशलेम! तु जो कागळीयान क मार न्हाखे, आरू जो थारे पास भेजी गिया उना पर दगड़ा मारिया, कतरा वार हाव यो कुशीश करियो कि जसी कुकड़ी आपसा पीलान क आपसा पाखड़ा तले एखटा करे, वसोत हाव भी थारा नानला पोर्‍या क एखटा बाकुन तुमू नी चाहया। <verse eid="MAT 23:37"/><verse number="38" style="v" sid="MAT 23:38"/>देखो, तुमरो घर तुमरे करता विजावो रहवसे। <verse eid="MAT 23:38"/><verse number="39" style="v" sid="MAT 23:39"/>काहकि हाव तुमरे सी कहवो, कि अब सी जव तक तुमू नी कहवो, सयालो छे त्यो, जो पोरबु क नाव सी आवे तव तक मेखे पछु कदी नी देखो।”<verse eid="MAT 23:39"/></para>
  <chapter eid="MAT 23"/>
  <chapter number="24" style="c" sid="MAT 24"/>
  <para style="s">मंदिर क विनाश क भविष्यव्दाणी</para>
  <para style="r">(<ref loc="MRK 13:1-2">मरकुस 13:1-2</ref>; <ref loc="LUK 21:5-6">लूका 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1"/>जव ईशु मंदिर सी नकलीन जाय रयो हुतो, तो उको चेला उको मंदिरन चित्र क बाराम देखाड़ने करीन उको पास आया। <verse eid="MAT 24:1"/><verse number="2" style="v" sid="MAT 24:2"/>त्यो ओको सी कयो, “काय तुमू यो सब नी देखता? हाव तुमरे सी सच कहवो, या सब दगड़ा पर दगड़ो भी नी रये, सब क नाश नी करीया जासे।”<verse eid="MAT 24:2"/></para>
  <para style="s">संकट आरू पीड़ा</para>
  <para style="r">(<ref loc="MRK 13:3-13">मरकुस 13:3-13</ref>; <ref loc="LUK 21:7-19">लूका 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3"/>आरू जव त्या जैतुनन बयड़ा पर बठियो हितो, तो चेला अलग ओको पास आवीन कयो, “हामुक यो देखाड़ कि तियार हुयसे? आरू थारो आवनेन, आरू दुनिया क खतम हुयनेन सहलाणी काय हुयसे?”<verse eid="MAT 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4"/>ईशु चेलान क जवाब दियो, “चौकचौळिया रहवो! कोय तुमूक धोकु नी देय।” <verse eid="MAT 24:4"/><verse number="5" style="v" sid="MAT 24:5"/>काहकि बैस सा असा रवसे जो म्हार नाव सी आवीन कहवसे, हाव मसीह छे, आरू घण सवटा क धोकु देसे। <verse eid="MAT 24:5"/><verse number="6" style="v" sid="MAT 24:6"/>लड़ाय पर लड़ाय क वात तुमरे सोमवने मा आवसे; देखो घबरायनो नी काहकि इन क हुयनो जरूरी छे, बाकुन उना समय आखरी नी हुये। <verse eid="MAT 24:6"/><verse number="7" style="v" sid="MAT 24:7"/>काहकि जाग–जागे, आरू राज्य–राज्य पर चढ़ाई करसे आरू धरती पर अकाल पड़से, आरू भुकंप हुयसे। <verse eid="MAT 24:7"/><verse number="8" style="v" sid="MAT 24:8"/>यी स वात पीड़ा हुयनेन शुरूवात हुयसे।<verse eid="MAT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9"/>तव त्या दुःख देवाड़ने क करता धरावसे, आरू मार न्हाखसे आरू म्हारा नाव क कारण सब गैरयहुदी क लोगहन तुमरे सी दुस्मनी राखसे। <verse eid="MAT 24:9"/><verse number="10" style="v" sid="MAT 24:10"/>आरू ओका टेमे पर सब ठुकर खासे, आरू एक दिसरा क धरवासे आरू एक दिसरा सी दुस्मनी राखसे। <verse eid="MAT 24:10"/><verse number="11" style="v" sid="MAT 24:11"/>बैस सा झुठा कागळिया उठ खड़ा हुयसे, आरू बैस लोगहन क भड़कावसे। <verse eid="MAT 24:11"/><verse number="12" style="v" sid="MAT 24:12"/>आरू अन्यायपन क बढ़ने सी बैस सब क मोंग कम हुय जासे। <verse eid="MAT 24:12"/><verse number="13" style="v" sid="MAT 24:13"/><note caller="+" style="x"><char style="xo" closed="false">24:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">मत्ती 10:22</ref></char></note>बाकुन जो आखरी तक धीर राखसे, उना क छुटकारो हुयसे। <verse eid="MAT 24:13"/><verse number="14" style="v" sid="MAT 24:14"/>आरू राज क यो खबर सब दुनिया मा परचार करतो जासे, कि सब लोगहन पर गवाय आखरी समय आय जासे।<verse eid="MAT 24:14"/></para>
  <para style="s">मोटली पीड़ा क सोरवात</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15"/>“अतरानकरीन जव तुमू चुखलो शास्त्र मा ‘विनाशकारी वस्तु’ उभी होई देखसु, जिनान बारा मा दानियेल कागळीयान लारे हुयली हुती, भणने वाला समझी जाय।” <verse eid="MAT 24:15"/><verse number="16" style="v" sid="MAT 24:16"/>तव जो यहूदि या मा हय त्या बयड़ा पर ढास जाय। <verse eid="MAT 24:16"/><verse number="17" style="v" sid="MAT 24:17"/><note caller="+" style="x"><char style="xo" closed="false">24:17 </char><char style="xt" closed="false"><ref loc="LUK 17:31">लूका 17:31</ref></char></note>जो घरो पर हय, त्यो आपसा घर मा सी समान लेने करीन नी उतरे। <verse eid="MAT 24:17"/><verse number="18" style="v" sid="MAT 24:18"/>आरू जो खेत मा हय त्यो आपसा चादरो लेने करीन पछो नी जाय। <verse eid="MAT 24:18"/><verse number="19" style="v" sid="MAT 24:19"/>“उना क करता हाय दाहड़ा मा जो बाई जात भारपाय सी हय आरू दुध पावने वाली हयसे, ओको करता विखु छे।” <verse eid="MAT 24:19"/><verse number="20" style="v" sid="MAT 24:20"/>आरू प्रार्थना करो; कि तुमूक सीयन दाहड़ा मा या सब्तन क दाहड़े डासनु नी पड़े। <verse eid="MAT 24:20"/><verse number="21" style="v" sid="MAT 24:21"/><note caller="+" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="REV 7:14">प्रकाशितवाक्य 7:14</ref></char></note>काहकि उना दाहड़ा मा असो भारी दुःख हुयसे, जसो धरतीन उबजने सी अब तक हयो, आरू नी कदी हुये। <verse eid="MAT 24:21"/><verse number="22" style="v" sid="MAT 24:22"/>आरू यदि यहोवा–भगवान दाहड़ा घटाड़ नी जाता, त्यो वात कोय तो जनवार नी वाचतो; बाकुन नेवाड़ला क कारण त्या दिन घटाड़े जासे।<verse eid="MAT 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23"/>उन समय कदाम कोय तुमरे सी कहवे, कि देखो, मसीह या छे! या वा छे! तो विश्वास नी करनो। <verse eid="MAT 24:23"/><verse number="24" style="v" sid="MAT 24:24"/>“काहकि झुठा कागळिया उबजी जासे, आरू मटलो सहलानी आरू घण मोटा काम देखाड़से, कि कदाम हुय सके तो नेवाड़लान क लोगहन भी धोकु देसे। <verse eid="MAT 24:24"/><verse number="25" style="v" sid="MAT 24:25"/>देखो, हाव पेहले सी तुमरे सी यी सब वात कय दियो।<verse eid="MAT 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">24:26 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 17:23">लूका 17:23</ref>,<ref loc="LUK 17:24">24</ref></char>
    </note>“अतरानकरीन करीन कदाम त्या तुमरे सी कहवे, देखो, त्यो जंगल मा छे; तो बाहर नी निकलीन नी जानो; देखो त्यो खपड़ी मा छे, तो विश्वास नी करनो।” <verse eid="MAT 24:26"/><verse number="27" style="v" sid="MAT 24:27"/>काहकि जसो दाहाड़ान विजावो पूरब सी निकलीन पश्चिम तक चमकती जाय, वसोत मानुस क पोर्‍या क भी आवनो रहवसे।<verse eid="MAT 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 24:28"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">24:28 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 17:37">लूका 17:37</ref>
      </char>
    </note>जा धड़ रहवे, चाँ घुवड़ भी एखटा हुयसे।<verse eid="MAT 24:28"/></para>
  <para style="s">मानुस क पोर्‍या क पछु: आवनो</para>
  <para style="r">(<ref loc="MRK 13:24-27">मरकुस 13:24-27</ref>; <ref loc="LUK 21:25-28">लूका 21:25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29"/>अचानक “उना दाहड़ा मा दुःख क बाद मा तत्काल दाहड़ो आंधारो हुय जासे, आरू चाँद क विजालो नी रये, आरू तारा आकाश सी गिर पड़से आरू सोरग न ताकत हिलायी जासे।” <verse eid="MAT 24:29"/><verse number="30" style="v" sid="MAT 24:30"/>तव मानसन क पोर्‍यान जाती देखाय पड़से, आरू तव धरती क सब रहवने वाला जातीन लोगहन आपसी छाती पीटसे; आरू मानुस क पोर्‍या क मटलो शक्ति आरू महिमा क साथ मा आकाश क वादवा पर आवतलो देखसे। <verse eid="MAT 24:30"/><verse number="31" style="v" sid="MAT 24:31"/>आरू त्यो भीरा क मटला शब्द क साथ, आरू आपसा सोरगदूत न क भेज देसे आरू त्या सरगन इना धड़े सी उना धड़े तक, चार तरफ सी उका नेवाड़ला लोगहन क एखटा करसे।<verse eid="MAT 24:31"/></para>
  <para style="s">अंजीर क झाड़कान क उदाहरण</para>
  <para style="r">(<ref loc="MRK 13:28-31">मरकुस 13:28-31</ref>; <ref loc="LUK 21:29-33">लूका 21:29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32"/>“अंजीरन झाड़को सी यो उदाहरण सीखो जव ओकी डाली नरम हुय जाय आरू पान्टा निकलने लाग जाय, तो तुम जान लेय, कि ग्रीष्मकाल निकट छे।” <verse eid="MAT 24:32"/><verse number="33" style="v" sid="MAT 24:33"/>इनी रीति सी जव तुमू इनी सब वातन क देखो, तो जान लेय, कि त्यो साते छे, बाकुन झोपलो पर छे। <verse eid="MAT 24:33"/><verse number="34" style="v" sid="MAT 24:34"/>हाव तुमरे सी सच कहवो, कि जव तक यी सब वात पूरी नी हुय जाय, तव तक इनी पीढ़ी क आखरी नी हुये। <verse eid="MAT 24:34"/><verse number="35" style="v" sid="MAT 24:35"/>आकाश आरू धरती टव जासे, बाकुन म्हारा बुल कदी नी टवे।<verse eid="MAT 24:35"/></para>
  <para style="s">अनजानो दाहड़ो आरू टेम</para>
  <para style="r">(<ref loc="MRK 13:32-37">मरकुस 13:32-37</ref>; <ref loc="LUK 17:26-30">लूका 17:26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36"/>पुन “उना दिन आरू उना समय मा कोय नी जाने, नी सोरगदूत, आरू नी पोर्‍यो, बाकुन बास जाने।” <verse eid="MAT 24:36"/><verse number="37" style="v" sid="MAT 24:37"/>जसो नूहा दाहड़ा मा हुतो, वसोत मानुस क पोर्‍या क आवनो भी हुयसे। <verse eid="MAT 24:37"/><verse number="38" style="v" sid="MAT 24:38"/>काहकि जसो पानीन प्रलय आवने क दाहड़ा सी पेहला दाहड़ा मा, जिने दाहड़े तक कि नूहन ढोंड्या पर नी चढ़ियो, उना दाहड़े तक लोगहन खाता–पीता हुता, आरू इहाव वियाव हुयती हुती। <verse eid="MAT 24:38"/><verse number="39" style="v" sid="MAT 24:39"/>आरू जव तक जल प्रलय आवीन ओको सब क उहवाड़ी नी ली गयो, तव तक उन लोगहन क काय भी नी मालोम पड़ियो; वसोत मानुस क पोर्‍या क भी आवनो हुयसे। <verse eid="MAT 24:39"/><verse number="40" style="v" sid="MAT 24:40"/>उना दाहाड़ा मा दूय जन खेत मा काम कर रया हसे, ते एक उठाय लेदो जासे, आरू दिसरा क छुड़ दियो जासे। <verse eid="MAT 24:40"/><verse number="41" style="v" sid="MAT 24:41"/>दूय बायर चक्‍की दळती रहसे, एक एक क उठाय ली जासे, आरू दिसरी छुड़ दि जासे।<verse eid="MAT 24:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42"/>अतरानकरीन जागता रवु, काहकि तुमु नी जागता कि तुमरो पोरबु काहले दिन आवी जासे। <verse eid="MAT 24:42"/><verse number="43" style="v" sid="MAT 24:43"/>बाकुन यो जान लेय कि कदाम घरन मालिक जानतो हय कि चोर काहला टेमे आवसे, तो जागतो रहवसे; आरू आपसे घर मा चोरी नी हुयने देय। <verse eid="MAT 24:43"/><verse number="44" style="v" sid="MAT 24:44"/>अतरानकरीन तुमू भी तियार रहवो, काहकि जिना टेमे ओको आवनेन बाराम तुमू चोकळिया नी हय, उना टेमे मा मानुस क पोर्‍यो भी आय जासे।<verse eid="MAT 24:44"/></para>
  <para style="s">विश्वास योग्य दास आरू दुष्ट दास</para>
  <para style="r">(<ref loc="LUK 12:41-48">लूका 12:41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45"/>“कुन छे त्यो विश्वास योग्य आरू अकल वालो, जो मालिक आपसा दास पर ठेकेदार ठहरायो, की टेम पर उन लोगहन क खानो देय?” <verse eid="MAT 24:45"/><verse number="46" style="v" sid="MAT 24:46"/>सयाळो छे, त्यो दास, जिनाक मालिक आवीन असोत् करतलो देखे। <verse eid="MAT 24:46"/><verse number="47" style="v" sid="MAT 24:47"/>हाव तुमूक सी सच कहवो; मालिक ओको आपसी सब धन पर हकदार बनावसे। <verse eid="MAT 24:47"/><verse number="48" style="v" sid="MAT 24:48"/>बाकुन कदाम त्यो दुष्ट दास यो सोचने लाग गियो, कि म्हार मालिकन आवने मा वार छे। <verse eid="MAT 24:48"/><verse number="49" style="v" sid="MAT 24:49"/>आरू आपसा साथी दासन क देने लाग गिया, आरू पियक्‍कड़ क साथ मा खाय–पीये। <verse eid="MAT 24:49"/><verse number="50" style="v" sid="MAT 24:50"/>ति उना दास क मालिक असला दाहड़ा मा आवसे, जव त्यो ओकी वाट नी देखतो रहवे, आरू असा टेमे कि जिनाक त्यो नी जानतो हय, <verse eid="MAT 24:50"/><verse number="51" style="v" sid="MAT 24:51"/>तव ओको वातड़ी सजा दीन आपीन, आरू उका पापो क कपटी लोगहन क साथ मा गिनसे; वा रड़नो आरू दात पीसनो हुयसे।<verse eid="MAT 24:51"/></para>
  <chapter eid="MAT 24"/>
  <chapter number="25" style="c" sid="MAT 25"/>
  <para style="s">दस छल्ला पोरायन उदाहरण</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">25:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:35">लूका 12:35</ref>
      </char>
    </note>“तव सोरग क राज उन दस छल्ला क समान हुयसे जो आपसी दिया लीन लाड़ा क मेळने करीन निकली।” <verse eid="MAT 25:1"/><verse number="2" style="v" sid="MAT 25:2"/>उका विच मा विन अकलाय आरू पाच हुसियार हुती। <verse eid="MAT 25:2"/><verse number="3" style="v" sid="MAT 25:3"/>विन अकलाय आपसी दिया तो लेदा, बाकुन साथ मा तेल नी लावी। <verse eid="MAT 25:3"/><verse number="4" style="v" sid="MAT 25:4"/>बाकुन हुसियार आपसा चीमनिया क साथ मा डब्बा मा भी तेल भर लेदा। <verse eid="MAT 25:4"/><verse number="5" style="v" sid="MAT 25:5"/>जव लाड़ा क आवनेन समय हुयो, तो त्या सब निंद से उंगायने लाग गय, आरू सुय गय।<verse eid="MAT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6"/>“आदी राती धुम मची, आरू देखो, लाड़ो आवी रयो, उका सी मेळने करी चालो।” <verse eid="MAT 25:6"/><verse number="7" style="v" sid="MAT 25:7"/>तव त्या सब छल्ला पोराय उठीन चीमनिया क तियार करने लाग गिया। <verse eid="MAT 25:7"/><verse number="8" style="v" sid="MAT 25:8"/>आरू विन अकलाय छल्ला हुसियार सी कहवी, “तुमरा तेल मा सी थुड़ोक हामुक भी देय देयो।” <verse eid="MAT 25:8"/><verse number="9" style="v" sid="MAT 25:9"/>बाकुन हुसियार पोराय जवाब देदी, हामरे आरू तुमरे करता पुरो नी हुये; वारलो तो यो छे की तुमू वेचने वाला क पास मा जाईन तेल मेल ली लेय। <verse eid="MAT 25:9"/><verse number="10" style="v" sid="MAT 25:10"/>“जव त्या मुव लेन करीन जाती हुती, तो लाड़ो आय गियो, आरू जो तियार हुती, त्या उका साथ मा वियाव क घर मा चाली गय आरू झोपलो बंद कर दियो गियो।”<verse eid="MAT 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">25:11 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 13:25">लूका 13:25</ref>
      </char>
    </note>एर बाद मा त्या दिसरी छल्ली पोराय भी आवीन कयने लागी, “हे स्वामी, हामरे करता झोपलो खुल दे, आरू हामुक माहय आवने देवु।” <verse eid="MAT 25:11"/><verse number="12" style="v" sid="MAT 25:12"/>ईशु जवाब देदो, कि हाव तुमरे सी सच कहवो, हाव तुमूक नी जानो।<verse eid="MAT 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13"/>अतरानकरीन करीन जागता रहवो, काहकि तुमू नी उना दाहड़ा क जानो, नी उना समय क।<verse eid="MAT 25:13"/></para>
  <para style="s">तीन पाविया क उदाहरण</para>
  <para style="r">(<ref loc="LUK 19:11-27">लूका 19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">25:14 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 19:11-27">लूका 19:11-27</ref>
      </char>
    </note>“काहकि सोरग क राज्य उना मानुस क समान छे, जो दिसरा देश जाते समय आपसा दास क बुलावीन आपसी संपत्ति दास क दी दियो।” <verse eid="MAT 25:14"/><verse number="15" style="v" sid="MAT 25:15"/>त्यो एक क पाच हजार सोना क सिक्‍का, आरू दिसरा क दूय हजार सिक्‍का, आरू तीसरा क एक हजार एक जन क ओकी शक्ति क अनसारे दी दियो, आरू तव आपनी यात्रान करता दिसरा देश मा चली गियो। <verse eid="MAT 25:15"/><verse number="16" style="v" sid="MAT 25:16"/>तव, जिनाक पाच हजार सोनान सिक्‍का मुविया हुता, उनाक तत्काल जाईन उका सी लेनो–देनो करियो, आरू पाच सिक्‍का आरू कमायो। <verse eid="MAT 25:16"/><verse number="17" style="v" sid="MAT 25:17"/>बाकुन जिनाक दूय मुवियो हुतो, त्यो भी दूय हजार सोनान सिक्‍का आरू कमायो। <verse eid="MAT 25:17"/><verse number="18" style="v" sid="MAT 25:18"/>बाकुन जिनाक एक हजार सोनान सिक्‍का मुवियो हुतो, त्यो जाईन धरतीक खुंदियो आरू मालिकन धन गाड़ीन सातीन दियो। <figure style="fig" alt="Talents" file="hk00168c.tif" size="col" copy="Horace Knowles ©" ref="25:15">सोनान सिक्‍का</figure><verse eid="MAT 25:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19"/>“बैस दाहड़ा क बाद मा त्या सेवक न मालिक आवीन उन दास सी हिसाब लेने लाग गया।” <verse eid="MAT 25:19"/><verse number="20" style="v" sid="MAT 25:20"/>जिनाक पाच सिक्‍का जुड़्या हुता, त्यो पाच हजार सोनान सिक्‍का लावीन कयो, “ए मालिक, तु मेखे पाच हजार सोनान सिक्‍का आपलो हुतो, देख हाव पाच हजार सोनान सिक्‍का आरू कमाय लेदु छे।” <verse eid="MAT 25:20"/><verse number="21" style="v" sid="MAT 25:21"/>ओको मालिक उका सी कयो, शाब्बास वारला आरू विश्वास योग्य दास, तु थुड़ाक मा विश्वासयोग्य रयो; हाव तुखे बैस चीजोन हकदार बनावीस। थारा मालिकन खुशी मा मेळाको हय।<verse eid="MAT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22"/>“आरू जिनाक दूय सिक्‍का जड़ला हुतो, त्यो भी आवीन कयो, ए मालिक तु मेखे दूय सिक्‍का जड़ला आपलो हुतो, देख, हाव दूय तुड़ा आरू कमायो।” <verse eid="MAT 25:22"/><verse number="23" style="v" sid="MAT 25:23"/>उको मालिक उका सी कयो, शाब्बास वारला आरू विश्वासयोग्य दास, तु थुड़ाक मा विश्वास योग्य रयो, हाव तुखे बैस चीजोन हकदार बनावीस थारा मालिकन खुशी मा मेळाको हय।<verse eid="MAT 25:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24"/>“तव जिनाक एक हजार सोनान सिक्‍का मुवलो हुतो, त्यो आवीन कयो, ‘ए मालिक हाव जानतो हुतो, कि तु वातड़ो मानुस छे: तु जा नी वेरे वा काटे, आरू जा नी छाटे वा सी एखटा करे।’ <verse eid="MAT 25:24"/><verse number="25" style="v" sid="MAT 25:25"/>अतरानकरीन करीन हाव बीह गियो आरू जाईन थारा तुड़ाक सिक्का धरतीम साती दियो; देख, जो थारो हुतो, त्यो यो छे।”<verse eid="MAT 25:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26"/>उको मालिक उका सी जवाब देदो, कि ए दुष्ट आरू आलसिया दास; जव तु यो जानतो हुतो, कि जा हाव नी वेरो वा सी काँटो; आरू जा हाव नी वेरीया वा सी एखठा कर। <verse eid="MAT 25:26"/><verse number="27" style="v" sid="MAT 25:27"/>तो तुखे तारो धन महायाजक क या जमा करनु हतु। तव हाव वापस आपने पे ब्याज सहित ली लता। <verse eid="MAT 25:27"/><verse number="28" style="v" sid="MAT 25:28"/>अतरानकरीन त्यो एक हजार सोनान सिक्‍का उका सी ली लेदो, आरू जिनाक पास मा दस हजार सोनान सिक्‍का, उको आप देदो। <verse eid="MAT 25:28"/><verse number="29" style="v" sid="MAT 25:29"/><note caller="+" style="x"><char style="xo" closed="false">25:29 </char><char style="xt" closed="false"><ref loc="MAT 13:12">मत्ती 13:12</ref>; <ref loc="MRK 4:25">मरकुस 4:25</ref>; <ref loc="LUK 8:18">लूका 8:18</ref></char></note>काहकि जिना कोय क पास छे, उको आरू भी दे दियो जासे; आरू उका पास बैस हुय जासे; बाकुन जिना पास नी हुय, उका सी त्यो भी जो उका पास छे ली जासे। <verse eid="MAT 25:29"/><verse number="30" style="v" sid="MAT 25:30"/>आरू ओका निक्‍कमा दास क बाहरते आंधारामा न्हाख देवु, जा रड़नु आरू दात पीसनु पड़से।<verse eid="MAT 25:30"/></para>
  <para style="s">आखरी नियाव</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">25:31 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:27">मत्ती 16:27</ref> </char>
      <char style="xt" closed="false">
        <ref loc="MAT 19:28">मत्ती 19:28</ref>
      </char>
    </note>जव मनुसोन पोर्‍या आपसी महिमा मा आवसे, ओवी आखा सोरगदूत हेरे पुठी आवसे ती त्यो हेरी महिमा न पर बोस जासे <verse eid="MAT 25:31"/><verse number="32" style="v" sid="MAT 25:32"/>आरू सब राज्य क सामने एखठा हुयसे; आरू जसा गुवाळियो गाड़ गाडरा आरू बुकड़ा सी अलग कर देय, वसोत त्यो उन क दिसरा सी अलग कर देसे। <verse eid="MAT 25:32"/><verse number="33" style="v" sid="MAT 25:33"/>आरू त्यो गाडरा न क आपसा जेवड़ा तरफ आरू बुकड़ान क डासचिया तरफ उबा करसे। <verse eid="MAT 25:33"/><verse number="34" style="v" sid="MAT 25:34"/>तव राजा आपसे जेवड़ा तरफ वाला सी कहवसे, “ए म्हार बास क सयाला लोगहन, कहवासे, जो कोळ जुग क शुरू सी तुमरे जुगु तियार करलो छे।” <verse eid="MAT 25:34"/><verse number="35" style="v" sid="MAT 25:35"/>काहकि हाव भुखलो हुतो, आरू तुमू मेखे खानो दिया; हाव पिसलो हुतो, आरू तुमू मेखे पानी पिवाड़िया, हाव दूर देश क हुतो, तुमू मेखे तुमरा घर मा मेकलु; <verse eid="MAT 25:35"/><verse number="36" style="v" sid="MAT 25:36"/>“हाव नांगरो हुतो, तुमू मेखे छिंदरा पेहराया; हाव बीमार हुतो, तुमू म्हारी खबर लेदो, हाव जेल खाना मा हुतो, तुमू म्हार सी मेळने आया।”<verse eid="MAT 25:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37"/>तव न्यायी उको जवाब देसे, “ए पोरबु हामु कोतार तुखे भुखलो देखिया आरू खवाड़िया? आरू पोसलो देखिया, आरू पानी पिवाड़िया?” <verse eid="MAT 25:37"/><verse number="38" style="v" sid="MAT 25:38"/>“हामु कोतार तुखे अनजानो देखिया आरू आपसा हामरा घर मा रूकाया या नांगो देखिया, आरू छिंदरा पेहराया? <verse eid="MAT 25:38"/><verse number="39" style="v" sid="MAT 25:39"/>हामु कोतार तुखे बीमार या जेलखाना मा देखिया आरू थार सी मेळने आया?” <verse eid="MAT 25:39"/><verse number="40" style="v" sid="MAT 25:40"/>तव राजा उन लोगहन क जवाब देसे, हाव तुमरे सी सच कहवो, कि तुमू इनु नाना सी नानला भाईस सी कोय एक क साथ मा करिया, त्या तुमू म्हार सात मा करिया।<verse eid="MAT 25:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41"/>“तव त्यो डाखरिया तरफ वालान लोगहन क कहवसे ए श्रापित लोगहन, म्हार सामने सी उका जलोम धपनीया आग्ठा मा जाती रहवो, जो शैतान आरू उका दूत क करता तियार करला छे।” <verse eid="MAT 25:41"/><verse number="42" style="v" sid="MAT 25:42"/>काहकि हाव भुखलो हुतो, आरू तुमू मेखे खानो नी दिया, हाव पिसला हुतो, आरू तुमू मेखे पानी नी पीलायो; <verse eid="MAT 25:42"/><verse number="43" style="v" sid="MAT 25:43"/>हाव बाहर देश क हुतो, आरू तुमू मेखे तुमरा घर मा नी रूकने दीदा; हाव नांगो हुतो, आरू तुमू मेखे छिंदरा नी पेहनाया; हाव बीमार आरू जेल खाना मा हुतो, आरू तुमू म्हारी खबर नी लेदो।<verse eid="MAT 25:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44"/>तव त्या जवाब देसे, “ए पोरबु, हामु तुखे कोतार भुखलो, या पीसलो, या बाहर देश क आरू नागरो, या बीमार, या जेलखाना मा देखिया, आरू थारी सेवा नी करिया?” <verse eid="MAT 25:44"/><verse number="45" style="v" sid="MAT 25:45"/>तव त्यो उन लोगहन क जवाब देसे, हाव तुमरे सी सच कहवो कि तुमू जो इनु नाना सी नानला माईन कोय एक साथ मा नी करिया, त्यो म्हार साथ मा नी करिया। <verse eid="MAT 25:45"/><verse number="46" style="v" sid="MAT 25:46"/>“या सब अमरकायन सजा झेलसे, बाकुन न्यायी अमरकायन जीवन मा भरायसे।”<verse eid="MAT 25:46"/></para>
  <chapter eid="MAT 25"/>
  <chapter number="26" style="c" sid="MAT 26"/>
  <para style="s">ईशु की हत्या करने क योजना बनावनो</para>
  <para style="r">(<ref loc="MRK 14:1-2">मरकुस 14:1-2</ref>; <ref loc="LUK 22:1-2">लूका 22:1-2</ref>; <ref loc="JHN 11:45-53">यहुन्ना 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1"/>जव ईशु यी सब वात कय दियो हुतो, तो आपसा चेलान क कयनो लाग गियो। <verse eid="MAT 26:1"/><verse number="2" style="v" sid="MAT 26:2"/>“तुमू जानो काय, कि दूय दाहड़ा क बाद फसहन तिवार हुयसे; आरू मानुस क पोर्‍या क कुरूस पर चढ़ावनेन करता धरावसे।”<verse eid="MAT 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3"/>तव मुखी पुजारो आरू पुन त्योन डाहडा कैफा नावन मटला पुजारा क आंगना मा एखटा हुया। <verse eid="MAT 26:3"/><verse number="4" style="v" sid="MAT 26:4"/>आरू आपसु मा विचार करने लाग गयो कि ईशु क धोका सी धरीन मार न्हाखजे। <verse eid="MAT 26:4"/><verse number="5" style="v" sid="MAT 26:5"/>बाकुन त्या कयता हुता, “तिहवार क समय मा नी असो नी हुय जाय कि लोगहन मा दंगो हुय जाय।”<verse eid="MAT 26:5"/></para>
  <para style="s">ईशु पर महंगा इत्र क नाखनो</para>
  <para style="r">(<ref loc="MRK 14:3-9">मरकुस 14:3-9</ref>; <ref loc="JHN 12:1-8">यहुन्ना 12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6"/>जव ईशु बैतनियाह मा शमौन कुड़ावा क घर मा हुतो, <verse eid="MAT 26:6"/><verse number="7" style="v" sid="MAT 26:7"/><note caller="+" style="x"><char style="xo" closed="false">26:7 </char><char style="xt" closed="false"><ref loc="LUK 7:37">लूका 7:37</ref>,<ref loc="LUK 7:38">38</ref></char></note>तो एक बायर संगमरमर क ठिकरा मा महोंगो इत्र लीन उका पास आवी, आरू जब त्यो वाटको खानो खाने बठलो हुतो, तो उका माथा पर न्हाख देदी। <verse eid="MAT 26:7"/><verse number="8" style="v" sid="MAT 26:8"/>यो देखीन, उका चेला किचवाय गिया आरू कयने लाग गिया, कि एको बरबाद कर दियो। <verse eid="MAT 26:8"/><verse number="9" style="v" sid="MAT 26:9"/>“यो इत्र ते तीन सौ सोनान सिक्‍का दाम पर वेचाय जातो आरू उका गरीब लोगहन क वाट सकता हुता।”<verse eid="MAT 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10"/>यो जानीन ईशु चेला क कयो, “इनी बायर क काँ सतावु? त्या म्हार साते भलाय करली छे।” <verse eid="MAT 26:10"/><verse number="11" style="v" sid="MAT 26:11"/>गरीब तुमरे साथ मा जलोम रहवे, बाकुन हाव तुमरे साथ मा जलोम नी रोवे सकतु छे। <verse eid="MAT 26:11"/><verse number="12" style="v" sid="MAT 26:12"/>त्या म्हारा डील पर यो इत्र रेड़ी, त्यो मेखे गाड़ ने क करता छे। <verse eid="MAT 26:12"/><verse number="13" style="v" sid="MAT 26:13"/>हाव तुमरे सच कहवो, कि सब दुनिया मा जा काँ यो खुश खबर नी करीयो जाय, वा उका इना बारम भी उको फोम करावसे।<verse eid="MAT 26:13"/></para>
  <para style="s">यहूदा इस्कोरियोती क ईशु क धुखा देनो</para>
  <para style="r">(<ref loc="MRK 14:10-11">मरकुस 14:10-11</ref>; <ref loc="LUK 22:3-6">लूका 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14"/>तव यहूदा इस्करियोती, बारा चेला मा सी एक हुतो, मुखी पुजारा क पास मा जाईन कयो, <verse eid="MAT 26:14"/><verse number="15" style="v" sid="MAT 26:15"/>“कदाम हाव उको तुमरा हाथ मा धराय दियो, तो मेखे काय आपसु?” त्या उको तीस चाँदी क सिक्‍का गिनीन आपी दिया। <verse eid="MAT 26:15"/><verse number="16" style="v" sid="MAT 26:16"/>आरू त्यो उना समय सी ईशु क धरावने क मेखे हेरने लागियो।<verse eid="MAT 26:16"/></para>
  <para style="s">चेला क साथ मा आखरी भोज</para>
  <para style="r">(<ref loc="MRK 14:12-21">मरकुस 14:12-21</ref>; <ref loc="LUK 22:7-13">लूका 22:7-13</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17"/>अखमीरी रोटा क तिहवार क दाहड़े, चेलान ईशु क पास मा आवीन पुछने लाग गिया, “तुखे काँ जुवे कि हामु थार करता फसह खानेन तियारी करजे?”<verse eid="MAT 26:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18"/>ईशु कयो, “नगर मा फलाना क पास मा जाईन उका सी कहवो, के गुरू कहवे छे, म्हार टेम साते आव छे, हाव म्हार चेला क साथ मा थारे या फसह तिवार मनावीस।”<verse eid="MAT 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19"/>ईशु जोसु वेला क आदेश देदु, आरू चेला फसह तियार करिया।<verse eid="MAT 26:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20"/>जव शाम हुयी, तो त्या बारा चेला क साथ मा खाने करीन बठियो। <verse eid="MAT 26:20"/><verse number="21" style="v" sid="MAT 26:21"/>जव त्या खाय रिया हुता, तो चेला सी कयो, “हाव तुमरे सी सच कहवो, कि तुमरे मा सी एक जन मेखे धरवासे।”<verse eid="MAT 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22"/>इना पर त्या बैस नराज हुया, आरू हर एक जन उका सी पुछने लाग गिया, “ए गुरू, काय चु हाव ते नी छे?” <verse eid="MAT 26:22"/><verse number="23" style="v" sid="MAT 26:23"/>ईशु जवाब देदो, “जो मार साथ मा थावी मा हाथ न्हाखलो छे, त्यो मेखे धरवासे। <verse eid="MAT 26:23"/><verse number="24" style="v" sid="MAT 26:24"/>हाव मानुस क पोर्‍यो तो कसो उका बारा मा लिखलो छे, त्यो जाय; बाकुन उना मानुस क करता विखु छे जिनान लारे मानुस क पोर्‍यो धरायसे; नकदाम उना मानुस क जनम नी हयतो तो उका करता वारू हुतो।”<verse eid="MAT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25"/>तव उको धरवाने वालो यहूदा कयो, “हे गुरू! काय त्यो हाव ते नी छे? ईशु उका सी कयो, तु ते खुद कय देदु।”<verse eid="MAT 26:25"/></para>
  <para style="s">पोरबु भोज</para>
  <para style="r">(<ref loc="MRK 14:22-26">मरकुस 14:22-26</ref>; <ref loc="LUK 22:14-20">लूका 22:14-20</ref>; <ref loc="1CO 11:23-25">1 कुरन्थियो 11:23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26"/>“जव त्या रोटा खाय रिया हुता, तो ईशु रोटा लीदो, आरू बरकत मांगीन तुड़ियो, आरू चेला क देखीन कयो, नन लेवु खावो; यो म्हारो डील छे।”<verse eid="MAT 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27"/>पछु ईशु वाटको लीन धन्यवाद करीयो, आरू चेला क आपीन कयो, तुमू सब इना मा सी पीयो, <verse eid="MAT 26:27"/><verse number="28" style="v" sid="MAT 26:28"/>काहकि यी वाचा म्हार त्यो लुहूय छे, जो बैस लोगहन क पापोन माफी क करता उहावड़ियो जाय। <verse eid="MAT 26:28"/><verse number="29" style="v" sid="MAT 26:29"/>“हाव तुमरे सी कहवो, कि अंगुर क रस उना दाहड़े तक कदी नी पीयो जव तक तुमरे साथ म्हार बास क राज मा नवलो नी पीयो।”<verse eid="MAT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30"/>पछु त्या भजन गावीन जैतुन बयड़ा पर गिया।<verse eid="MAT 26:30"/></para>
  <para style="s">पतरस क मना करनेन भविष्यवाणी</para>
  <para style="r">(<ref loc="MRK 14:27-31">मरकुस 14:27-31</ref>; <ref loc="LUK 22:31-34">लूका 22:31-34</ref>; <ref loc="JHN 13:36-38">यहुन्ना 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31"/>तव ईशु चेलान सी कयो, तुमू सब आज रात मा म्हारा बारा मा ठुकर खासु; काहकि लिखलो छे, “हाव गुवाळिया क मारीस; आरू टुळान गाड़ गाडरा वेराय जासे।” <verse eid="MAT 26:31"/><verse number="32" style="v" sid="MAT 26:32"/><note caller="+" style="x"><char style="xo" closed="false">26:32 </char><char style="xt" closed="false"><ref loc="MAT 28:16">मत्ती 28:16</ref></char></note>“बाकुन हाव म्हारा जीव उठने क बाद सी पेहले गलील मा जाईस।”<verse eid="MAT 26:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33"/>इना पर पतरस उका सी कयो, “कदाम सब थार वजह से ठुकर खाय ते खाय, बाकुन हाव कदी नी ठुकर नी खाम।”<verse eid="MAT 26:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34"/>ईशु पतरस सी कयो, “हाव थार सी सच कहवो, कि आज राती कुकड़ा क वाषने सी पेहले, तु तीन बार म्हार मना करीस।”<verse eid="MAT 26:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35"/>ईशु पतरस सी कयो, “कदाम मेखे थार साथ मा मरनो भी हुयसे, तो भी हाव थारो कदी नी मानने सी मना करो।”</para>
  <para style="p" vid="MAT 26:35">आरू असात् सब चेला भी कयो।<verse eid="MAT 26:35"/></para>
  <para style="s">गतसमनीन बगीचा मा प्रार्थना</para>
  <para style="r">(<ref loc="MRK 14:32-42">मरकुस 14:32-42</ref>; <ref loc="LUK 22:39-46">लूका 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36"/>तव ईशु आपसा चेला क साथ गतसमनी मा आयो आरू आपसा चेला सी कयनो लाग गियो “कदाम यात बठी रहवजो, जव तक हाव वा जाईन प्रार्थना करो।” <verse eid="MAT 26:36"/><verse number="37" style="v" sid="MAT 26:37"/>आरू त्यो पतरस याकूब आरू जबदी क साथ मा ली गियो, आरू दुःखी आरू घबरायने लागियो। <verse eid="MAT 26:37"/><verse number="38" style="v" sid="MAT 26:38"/>“तव त्यो चेला सी कयो, म्हार मन बैस नराज छे, या तक कि म्हारो जीव निकलीन जाय रियो। तुमू यात रहवो, आरू म्हार साथ जागता रहवु।”<verse eid="MAT 26:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39"/>“पछु त्यो थुड़ाक आरू अगा बढ़ीन मुयन भूरसे नेचो पड़ीन, आरू यी प्रार्थना करने लाग गियो, तो यो वाटको म्हार सी टळ जाय, पछु भी जसो हाव चाहतो वसोत नी, बाकुन जसो तु चाहे वसोत हुय।”<verse eid="MAT 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40"/>पछु चेला क पास आवीन चेला क सुवतला देखियो, आरू पतरस सी कयो, “काय तुमू म्हार साते एक घंटो भी नी जाग सकता हुता? <verse eid="MAT 26:40"/><verse number="41" style="v" sid="MAT 26:41"/>जागता रहवो, आरू प्रार्थना करता रहवो कि तुमू पारख मा नी पड़ सको! आत्मा तो तियार छे, बाकुन डील कमजोर छे।”<verse eid="MAT 26:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42"/>पछु ईशु दिसरी बार जाईन यी प्रार्थना करियो की, “ए म्हार बास, कदाम यो वाटको मार पीये बीना नी हट सके तो भी थारी मरजी पूरी हुये।” <verse eid="MAT 26:42"/><verse number="43" style="v" sid="MAT 26:43"/>तव ईशु आवीन चेलान क पछु सुवतला देखियो, काहकि उका डुवा मा नींद भराय रया हुती।<verse eid="MAT 26:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44"/>आरू चेला क छुड़ी पछु चली गियो, आरू पछु त्या वात कहवीन तीसरी वार प्रार्थना करियो। <verse eid="MAT 26:44"/><verse number="45" style="v" sid="MAT 26:45"/>पछु तीसरी बार आवीन उनछे कयो, “हिमी सुवता रहवो? आरू आराम करो: देखो समय आय गयलो छे, आरू मानुस क पोर्‍यो पापियान क हाथ मा धरायो जाय छे। <verse eid="MAT 26:45"/><verse number="46" style="v" sid="MAT 26:46"/>उठो, चालीन देखो, म्हारो धरावने वालो नाट आवी गयलो छे।”<verse eid="MAT 26:46"/></para>
  <para style="s">ईशु क धरायनो</para>
  <para style="r">(<ref loc="MRK 14:43-50">मरकुस 14:43-50</ref>; <ref loc="LUK 22:47-53">लूका 22:47-53</ref>; <ref loc="JHN 18:3-12">यहुन्ना 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47"/>त्यो यो कहवतो हुतो, यहूदा जो बारा चेला माईन एक हुतो, आरू उका साथ मा मुखी पुजारा आरू लोगहन क डाहडान तरफ सी खुब गर्दी तलवार आरू लाठिया लीन आया। <verse eid="MAT 26:47"/><verse number="48" style="v" sid="MAT 26:48"/>उको धरावने वालो उन लोगहन क यी सहलानी दियो; “जिनाक हाव त्योम लीस त्योत ईशु छे; उको दर लीदो।”<verse eid="MAT 26:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49"/>आरू तत्काल ईशु क पास आवीन कयो, “ए गुरू नमस्कार, आरू उको बैस चूमियो।”<verse eid="MAT 26:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50"/>ईशु यहुदा सी कयो, “ए दोस्त, जिना काम क करता तु आयो छे, उको पुरो कर ले।” तव ओको जु आवीन ईशु पर हाथ न्हाखिया आरू ओको धर लेदा। <verse eid="MAT 26:50"/><verse number="51" style="v" sid="MAT 26:51"/>तव ईशु क एक साथी आपनी तलवार करीन पुजारान दासन कांटो काट देदो, <verse eid="MAT 26:51"/><verse number="52" style="v" sid="MAT 26:52"/>तव ईशु ओको सी कयो, थारी तलवार मियान मा राख ले काहकि जो तलवार चालाड़े, वे सब तलवार सी नाश करीयो जासे। <verse eid="MAT 26:52"/><verse number="53" style="v" sid="MAT 26:53"/>काहकि तु नी समझियो, कि हाव म्हार बास सी विनती कर सकतो हुतो, आरू त्यो सोरगदूत क बारा सैन्य दल सी जादा मार पास अब भी हजुर कर देसे? <verse eid="MAT 26:53"/><verse number="54" style="v" sid="MAT 26:54"/>“बाकुन चुखला शासतुर न वात कि असो हुयनो जरूरी छे, कसो पूरो हुयसे?”<verse eid="MAT 26:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55"/>उना समय ईशु गर्दी सी कयो, काय तुमू तरवार आरू लाठिया लीन मेखे डाकु क समान धरने करीन आया? हाव हर दाहड़े मंदिर मा बठीन शिक्षा दिया करतो हुतो, आरू तुमू मेखे नी धरिया।<verse eid="MAT 26:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="MAT 26:56"/>“बाकुन यो सब अतरानकरीन करीन हुयो, कि कागळीयान क वचन पूरो हुये।” तव सब चेला उको छुड़ीन ढास गिया।<verse eid="MAT 26:56"/></para>
  <para style="s">महासभा क सामने ईशु</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57"/>आरू ईशु क धरनेवाला उको कैफा नावन पुजारा क पास मा ली गिया, जा शास्त्री आरू डाहडा एखटा हुता। <verse eid="MAT 26:57"/><verse number="58" style="v" sid="MAT 26:58"/>आरू पतरस दूर सी ओको पछोळ–पछोळ जाईन पुजारान आंगना मा तक गियो, आरू माहय जाईन देखने क सिपायो साथ मा बठ गियो, कि ईशुन काय होयसे <verse eid="MAT 26:58"/><verse number="59" style="v" sid="MAT 26:59"/>मुखी पुजारो आरू सारी सभा ईशु क मार न्हाखने क करता उका विरोध मा झुटी गवाय हेरता हुता। <verse eid="MAT 26:59"/><verse number="60" style="v" sid="MAT 26:60"/>बाकुन बैस सब झुठा गवाय वाला क आवने पर भी नी मुवी। आखरी मा दूय जन आया, <verse eid="MAT 26:60"/><verse number="61" style="v" sid="MAT 26:61"/><note caller="+" style="x"><char style="xo" closed="false">26:61 </char><char style="xt" closed="false"><ref loc="JHN 2:19">यहुन्ना 2:19</ref></char></note>आरू ईशु कयो, “यो कयो कि हाव यहोवा–भगवान क मंदिर क ढोवळी सको आरू उको तीन दाहड़ा मा बनाय सको।”<verse eid="MAT 26:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62"/>तव पुजारो उबो हुईन उका सी कयो, “काय तु काहय जवाब नी देय? या लोगहन थारा विरोध मा काय गवाय देय छे?” <verse eid="MAT 26:62"/><verse number="63" style="v" sid="MAT 26:63"/>बाकुन ईशु चुप रियो। तव पुजारो उका सी कयो “हाव तुखे जीवता यहोवाभगवानन शपथ देयो, कि कदाम तु यहोवा–भगवानन पोर्‍यो छे तो हामरे सी कय दे।”<verse eid="MAT 26:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64"/>ईशु उका सी कयो, “तु आपसु कय दियो; आरू हाव तुमरे सी यो भी कहवो, कि अब सी तुमू मानुस क पोर्‍या क यहोवा–भगवानन जेवड़ा तरफ बठलो, आरू सोरग न वादळा पर आवतला देसु। <verse eid="MAT 26:64"/><verse number="65" style="v" sid="MAT 26:65"/>तव पुजारो आपसा छिंदरा फाड़ीन कयो, यो यहोवा–भगवानन निन्दा करियो, अब हामु गवायन काय काम? देखो, तु भी हिमी निंदा सोमव्या!<verse eid="MAT 26:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 26:66"/>“तुमू काय समझो?” त्या जवाब दीदा, “यो मोतन सजा देने जुगु छे।”<verse eid="MAT 26:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67"/>तव त्या ईशु क मुय पर थुप्या आरू उको धुमाट्या, दिसरा थापड़ भी दीन कयो, <verse eid="MAT 26:67"/><verse number="68" style="v" sid="MAT 26:68"/>आरू कयो, “ए मसीह, हामरे सी भविष्यव्दाणी करीन देखाड़ कि कुन तुखे मारसे?”<verse eid="MAT 26:68"/></para>
  <para style="s">पतरसन लारे ईशु क मना करनो</para>
  <para style="r">(<ref loc="MRK 14:66-72">मरकुस 14:66-72</ref>; <ref loc="LUK 22:56-62">लूका 22:56-62</ref>; <ref loc="JHN 18:15-18">यहुन्ना 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69"/>“पतरस बाहर आंगना बठलो हतो कि एक दासी ओको पास मा आवीन कहवी, तु भी ईशु गलीली क साथ मा हुतो।”<verse eid="MAT 26:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70"/>पतरस सब लोगहन क सामने यो कहवीन नकार दियो आरू कयो, “हाव नी जानो कि तु काय कहवी रई।” <verse eid="MAT 26:70"/><verse number="71" style="v" sid="MAT 26:71"/>“जव पतरस बाहर झपला मा जाती रयो, तो दीसरी दासी उको देखीन उन लोगहन क जो वा हुता कहवी, यो भी ईशु नासरी क साथ मा हुतो।”<verse eid="MAT 26:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72"/>पतरस शपथ खाईन पछु मना कर दियो, “हाव उना मानुस क नी जानो।”<verse eid="MAT 26:72"/></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73"/>थुड़ीक वार बाद, जो वा उबा हुता, त्या पतरस क पास आवीन उका सी कयो, “सच तु भी ओको माईन एक छे; काहकि थारी बुली थारा बाराम देखाड़े।”<verse eid="MAT 26:73"/></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74"/>तव त्यो कोसने आरू शपथ खाने लागी गियो, “हाव उना मानुस क नी जानो।”</para>
  <para style="p" vid="MAT 26:74">आरू तत्काळ कुकड़ो वाषने लाग गियो। <verse eid="MAT 26:74"/><verse number="75" style="v" sid="MAT 26:75"/>तव पतरस क ईशुन कहवली वात फोम आवी, “कुकड़ान वाषने सी पेहले तु तीन वार म्हारो मना करीस।” आरू त्यो बाहर जाईन फुटी–फुटीन रड़ने लाग गियो।<verse eid="MAT 26:75"/></para>
  <chapter eid="MAT 26"/>
  <chapter number="27" style="c" sid="MAT 27"/>
  <para style="s">पिलातुसन सामने ईशु</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1"/>जव भोळभाको हुयो, ती सब प्रधानन पुजारा आरू मानसोन वेगला डाहडा ईशु क मार नाखनेन सम्मति करीया। <verse eid="MAT 27:1"/><verse number="2" style="v" sid="MAT 27:2"/>आरू चे तीनाक बांधीन आरू ली जाईन पिलातुस राज्यपालन हात मा सौप दिदा।<verse eid="MAT 27:2"/></para>
  <para style="s">यहूदा इस्करीयोतीन आत्महत्या</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3"/>जव तीनाक धरावनेवावा यहूदा ने देख्य कि दोषी ठराय गया ती वो पछतावो आरू चे डेढ़वीस चाँदीन सिक्‍कान प्रधान पुजारो आरू डाहडा क साथे धर लेदा।<verse eid="MAT 27:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 27:4"/>आरू कयो, “हाव निर्दोषीक मारनेन करीन धरावीन पाप करलो छे?” त्या कयो, “हामु काय? तुत जाने।”<verse eid="MAT 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5"/>तव त्यो उना सिक्‍कान क मंदिर मा न्हाखीन चाली गयो, आरू जाईन आपसुत फांसी लीन मर गयो।<verse eid="MAT 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6"/>प्रधान पुजारो ने तिनु सिक्‍काक लीन काँ, “इनुक, भण्डार मा राखजे वारू नी, काहकि यो लुहूय दाम छे।” <verse eid="MAT 27:6"/><verse number="7" style="v" sid="MAT 27:7"/>तव त्या लोगहन एर बारा मा विचार करिया आरू तिनु सिक्‍का से वाँ वाळा क गाड़ ने करिन कुमायड़ान खेत मुव ली लेदा, <verse eid="MAT 27:7"/><verse number="8" style="v" sid="MAT 27:8"/>यो कारण छे कि आज तक यो लुहूय यो क खेत कवाय।<verse eid="MAT 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9"/>तव जो वचन यिर्मयाह कागळियान् लारे कहलो हुतो पूरो हुयो “त्या लोगहन तीस सिक्‍का मतलब् तिना दाम क जो इस्राएल कि अवलियाद माईन कतरा जन करला तिन दाम मा ली लेदा <verse eid="MAT 27:9"/><verse number="10" style="v" sid="MAT 27:10"/>आरू जसो पोरबु मखे हुकुम दियो हुतो, वसोत उन क कुमायड़ान खेत मोल आप दीदा।”<verse eid="MAT 27:10"/></para>
  <para style="s">पिलातुस क ईशु से सवाल करनो</para>
  <para style="r">(<ref loc="MRK 15:2-5">मरकुस 15:2-5</ref>; <ref loc="LUK 23:3-5">लूका 23:3-5</ref>; <ref loc="JHN 18:33-38">यहुन्ना 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11"/>जव ईशु रोमि आधिकारी क सामने उबो हुतो, तो हक उका सी पुछियो,</para>
  <para style="p" vid="MAT 27:11">“काय तु यहूदि यान राजा छे?” ईशु ओका सी लयो, “तु आपसु कय रयो।” <verse eid="MAT 27:11"/><verse number="12" style="v" sid="MAT 27:12"/>जब मटला पुजारो आरू डाहडा उना पर दोष लगाड़ता हुता, तो त्यो काहय जवाब नी दिदो।<verse eid="MAT 27:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13"/>अतरा पर पिलातुस त्या न क कयो, “काय तु यो नी सुनतो कि यो लोगहन थारा बाराम काय कतरी गवाय दी रया?”<verse eid="MAT 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14"/>बाकुन ईशु उको एक वातन भी जवाब दीदो, या तक कि राज्यपाल घबराय गियो।<verse eid="MAT 27:14"/></para>
  <para style="s">ईशु क छुड़ने मा पिलातुस असफल</para>
  <para style="r">(<ref loc="MRK 15:6-15">मरकुस 15:6-15</ref>; <ref loc="LUK 23:13-25">लूका 23:13-25</ref>; <ref loc="JHN 18:39-19:16">यहुन्ना 18:39–19:16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15"/>आरू रोम आधिकारी यी रीति हुती, कि उना तिहवार मा लोगहन क करता काहला भी एक कैदड़ा क जिनाक छुड़नो चाहे उको छुड़ दिता हुता। <verse eid="MAT 27:15"/><verse number="16" style="v" sid="MAT 27:16"/>तीन समय मा बरअब्बा नाव क तिनु माईन एक नाव सादियो बन्दुओ कैदड़ो हुतो। <verse eid="MAT 27:16"/><verse number="17" style="v" sid="MAT 27:17"/>आरू जव त्या लोगहन एखठा हुया, तो पिलातुस उन लोगहन क कयो, “तुमू कुनीक छुड़नो चाह्यो रिया, कि हाव तुमरे करता छुड़ देयो? बरअब्बा क, या ईशु क जो मसीह कहवाये?” <verse eid="MAT 27:17"/><verse number="18" style="v" sid="MAT 27:18"/>काहकि त्यो जानतो हुतो कि त्या लोगहन उको धुका से धरावला हुता।<verse eid="MAT 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19"/>जव त्यो नियाव नी गाद्दी पर बठलो हुतो तो ओकी घर वाली उको कय मुकली, “तु उना धरमीन मामला मा हाथ झुण डाले; काहकि हाव आज सपना मा उका बाराम बैस दुःख झेलली छे।”<verse eid="MAT 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20"/>डाहलो पुजारो आरू डाहला लोगहन गर्दी क भड़काया, कि त्या बरअब्बा मांगलेय, आरू ईशु क मार देय। <verse eid="MAT 27:20"/><verse number="21" style="v" sid="MAT 27:21"/>रोमन आधिकारिया त्या लोगहन सी पुछियो, “इनु दूय माईन कुनीक चाह्यो रिया कि तुमरे करता छुड़ देयो?”</para>
  <para style="p" vid="MAT 27:21">त्या कयो, “बरअब्बा क।”<verse eid="MAT 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22"/>अतरा पर पिलातुस त्या लोगहन सी पुछियो, “पछु हाव ईशु क जो मसीह कहवाये, काय करो?” आखा ओका सी कयो,</para>
  <para style="p" vid="MAT 27:22">“तेखेक कुरूस पर चढ़ावो।”<verse eid="MAT 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23"/>रोमन आधिकारिया कयो, “काँ त्यो काय गुणू करियो?”</para>
  <para style="p" vid="MAT 27:23">बाकुन त्या आरू भी आयड़ता जाईन कयनो लाग गिया, “त्यान क कुरूस पर चढ़ावो।”<verse eid="MAT 27:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24"/>जब पिलातुस यो देखियो, कि हेका सी काय नी हुतो, आरू लोगहन भड़कता जाय, तो पिलातुस पानी लीन गर्दीन सामने आपसा हाथ धूय लेदो, आरू कयो, “हाव इना न्यायी क लुहूय यो से निर्दोष छे; तुज जाने।”<verse eid="MAT 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25"/>सब लोगहन मेळिन जवा दिदा, “उको लुहूय यो हामरे पर आरू हामरी ओवलियाद पर हुये!”<verse eid="MAT 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26"/>अतरा पर पिलातुस बरअब्बा छुड़ दीदो, आरू ईशु क कुड़ा लगाड़ीन लोगहन क हाथ मा आप दीदो।<verse eid="MAT 27:26"/></para>
  <para style="s">सिपायड़ा न ईशु क विजुत नी करनो</para>
  <para style="r">(<ref loc="MRK 15:16-20">मरकुस 15:16-20</ref>; <ref loc="JHN 19:2-3">यहुन्ना 19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27"/>तव पिलातुस रोमि आधिकारिया ईशु क किला मा ली जाईन सब सैनिक उका चार तरफ एखटा हुया। <verse eid="MAT 27:27"/><verse number="28" style="v" sid="MAT 27:28"/>आरू ईशुन छिंदरा उतारीन उको रातला रंगन छिंदरा पेहराया। <verse eid="MAT 27:28"/><verse number="29" style="v" sid="MAT 27:29"/>आरू काँटान मुकुट गुथीन ईशुन माथा पर मेल दीदा; आरू ओको अगळ घुटना टेकीन ईशुन वायकेड़ा उड़वने लागी गिया, “ए यहूदि यान राजा नमस्कार!” <verse eid="MAT 27:29"/><verse number="30" style="v" sid="MAT 27:30"/>आरू उना पर थुपता; आरू त्यो सरकुण्डा हेका माथा पर देने लाग गिया। <verse eid="MAT 27:30"/><verse number="31" style="v" sid="MAT 27:31"/>जव त्या ओकी वायकेड़ा उड़ाय चुकिया, तो त्यो छिंदरा उका पर सी उतारीन पछु ईशुन उको पेहराया, आरू कुरूस पर चढ़ावने करीन ली गिया।<verse eid="MAT 27:31"/></para>
  <para style="s">ईशु क कुरूस पर चढ़ावनो</para>
  <para style="r">(<ref loc="MRK 15:21-32">मरकुस 15:21-32</ref>; <ref loc="LUK 23:26-43">लूका 23:26-43</ref>; <ref loc="JHN 19:17-27">यहुन्ना 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32"/>बाहर जाता समय त्या लोगहन क शमौन नावन एक कुरेनी मानुस मेळियो, त्या उको धरिया आरू मजबुर करीया की ईशुन कुरूस हाकले चाले। <verse eid="MAT 27:32"/><verse number="33" style="v" sid="MAT 27:33"/>आरू उना धरती पर जो गुलगुता नावन जागु जो खोपड़ीन जागु कहवाये वा पुगीन। <verse eid="MAT 27:33"/><verse number="34" style="v" sid="MAT 27:34"/>त्या पित्त भेसकलो दाखरस ओको पीने करीन दीदा, बाकुन त्यो चाखीन पीनो नी रूकाया।<verse eid="MAT 27:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35"/>तव त्या ईशु क कुरूस पर चढ़ाया; आरू पत्री या न्हाखीन उका छिंदरा वाट लिदा। <verse eid="MAT 27:35"/><verse number="36" style="v" sid="MAT 27:36"/>आरू वा बठीन ओकी राखवाळी करने लागीया। <verse eid="MAT 27:36"/><verse number="37" style="v" sid="MAT 27:37"/>आरू ईशुन गुणान पत्री, उका माथा पर लगाड़या, कि “यो यहूदि यान राजा छे।” <verse eid="MAT 27:37"/><verse number="38" style="v" sid="MAT 27:38"/>तव उका साथ मा दूय डाकू क कुरूस पर चढ़ाया एक जेवड़ा तरफ आरू एक डासचिया तरफ।<verse eid="MAT 27:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39"/>आरू आवने जाने वाला माथो हालवी–हालवीन ओकी वायकेड़ा उड़ावता हुता। <verse eid="MAT 27:39"/><verse number="40" style="v" sid="MAT 27:40"/><note caller="+" style="x"><char style="xo" closed="false">27:40 </char><char style="xt" closed="false"><ref loc="MAT 26:61">मत्ती 26:61</ref>; <ref loc="JHN 2:19">यहुन्ना 2:19</ref></char></note>आरू यो हवता हुता, “ए मंदिर क उदारनेवाला आरू तीन दाहाड़ा मा बनावने वाला, आपसाक तो वाचाड़ कदाम तु यहोवा–भगवान क पोर्‍यो छे, तो कुरूस पर सी उतरीन आव।”<verse eid="MAT 27:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41"/>इनी रीति सी मुखी पुजारो भी शास्त्रीया आरू डाहडान क साथ मेळीन ईशुन वायकेड़ा उड़ावीन कयता हुता, <verse eid="MAT 27:41"/><verse number="42" style="v" sid="MAT 27:42"/>“यो दिसरा क वाचाड़से, आरू आपसा क नी वाचाड़ सकतो। यु ते ‘इस्त्राएलन राजु छे।’ हिमी कुरूस पर रईन उतरी आयु, ते हाव उका पर विश्वास कर्‍या।” <verse eid="MAT 27:42"/><verse number="43" style="v" sid="MAT 27:43"/>त्यो यहोवा–भगवान क विश्वास राखिया, कदाम त्यो चाहतो, तो अब इनाक छुड़ाय ले, “काहकि यो कहवतो हुतो, कि हाव यहोवा–भगवान क पोर्‍यो छे।”<verse eid="MAT 27:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44"/>इने रीति डाकु भी जो उका साथ मा कुरूस पर चढ़ावला हुता ओकी वायकेड़ा यड़ावता हुता।<verse eid="MAT 27:44"/></para>
  <para style="s">ईशु क जीव छुड़नो</para>
  <para style="r">(<ref loc="MRK 15:33-41">मरकुस 15:33-41</ref>; <ref loc="LUK 23:44-49">लूका 23:44-49</ref>; <ref loc="JHN 19:28-30">यहुन्ना 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45"/>बारा बजे रईन ते तीन बजे तक सब धरती पर आंधारो होय गयो। <verse eid="MAT 27:45"/><verse number="46" style="v" sid="MAT 27:46"/>नवा घंटा न टेमे ईशु जुरे सी आयड़ीन कयो, “एली, एली, लमा शबक्तनी?” यो कहवाये, “ए म्हारा यहोवा–भगवान, ए म्हारा यहोवा–भगवान, तु मेखे काह छुड़ दीदो?”<verse eid="MAT 27:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47"/>जो वा उबो हुय रया हुता, उका माईन कोय–कोय यो सोमवीन कयो, “त्यो तो एलियाहक आयड़ी रिया।” <verse eid="MAT 27:47"/><verse number="48" style="v" sid="MAT 27:48"/>उका माईन एक तत्काल दवड़ीयो, आरू एक छिंदरो लेपटायलो लाकड़ो सिरका मा डुबायो आरू सरकुण्डा पर राखीन उको चुसाड़ियो।<verse eid="MAT 27:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 27:49"/>थुड़ाक जना कयो, “रूक जात्यो देखजे एलियाह वाचाड़ने आवे की नी।”<verse eid="MAT 27:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50"/>तव ईशु पछु जुरे क आयड़ीन जीव छुड़ दीदो।<verse eid="MAT 27:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51"/>तव मंदिर क परदो उपर सी नेचो तक फाटीन दूय टुकड़ा हुय गियो: आरू धरती डोल गय आरू दातिया फाट गिया। <verse eid="MAT 27:51"/><verse number="52" style="v" sid="MAT 27:52"/>आरू बीड़ा उगाड़ हुय गिया, आरू सुवला हुता त्या चुखलोलोगहन क धोड़ जाग गिया। <verse eid="MAT 27:52"/><verse number="53" style="v" sid="MAT 27:53"/>आरू उका जीव उठने क बाद मा त्या बीड़ा मा सी निकलीन चुखलो नदर मा गिया, आरू ठण सवटा क देखाय पड़िया।<verse eid="MAT 27:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54"/>तव सुबेदार आरू जो उका साथ मा ईशुन राखवाळी करता हुता, भुकंप आरू जो काय हुयलो हुतो, देखीन बेसका बीह गिया, आरू कयो, “सच यो यहोवा–भगवानन पोर्‍यो हुतो!”<verse eid="MAT 27:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55"/>वा बैस घण सवटी बाई जात जो गलील सी ईशुन सेवा करती हुती ओको साथ मा आवली हुती, दूर सी देखती हुती। <verse eid="MAT 27:55"/><verse number="56" style="v" sid="MAT 27:56"/>उका मा मरियम मगदलीनी आरू याकूब आरू योसेस न माय मरियम आरू जबदी क पोर्‍या माय हुती।<verse eid="MAT 27:56"/></para>
  <para style="s">ईशु क गाड़नो</para>
  <para style="r">(<ref loc="MRK 15:42-47">मरकुस 15:42-47</ref>; <ref loc="LUK 23:50-56">लूका 23:50-56</ref>; <ref loc="JHN 19:38-42">यहुन्ना 19:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57"/>जव शांत हुय ते यूसुफ नावन अरिमतियाह क एक धनी मानुस जो चु भी ईशुन चेला हुतो, चु आयो। <verse eid="MAT 27:57"/><verse number="58" style="v" sid="MAT 27:58"/>चु पिलातुस क पास जाईन ईशु क धड़ मांगीयो। इना पर पिलातुस नी आपनेन हुकुम दीदो। <verse eid="MAT 27:58"/><verse number="59" style="v" sid="MAT 27:59"/>यूसुफ धड़ क लीन उको साफ चादरा मा लेपटी लीदो। <verse eid="MAT 27:59"/><verse number="60" style="v" sid="MAT 27:60"/>आरू उको एका नवला बीड़ा मा राख दीदो, जो यूसुफ आपसे करता बनावलो हुतो, आरू बीड़ान झपला पर बड़ो दगड़ो लुड़काय दीदो। <verse eid="MAT 27:60"/><verse number="61" style="v" sid="MAT 27:61"/>आरू मरियम मगदलीनी आरू दिसरी मरियम वा बीड़ान सामने बठली हुती।<verse eid="MAT 27:61"/></para>
  <para style="s">ईशुन बीड़ा क राखवाली</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62"/>दिसरे दाहड़े जो तियारीन दाहड़ा क बाद क दाहड़ हुतो, डाहला पुजारा आरू फरीसिया पिलातुस क पास एखटा हुयन कयो। <verse eid="MAT 27:62"/><verse number="63" style="v" sid="MAT 27:63"/><note caller="+" style="x"><char style="xo" closed="false">27:63 </char><char style="xt" closed="false"><ref loc="MAT 16:21">मत्ती 16:21</ref>; <ref loc="MAT 17:23">17:23</ref>; <ref loc="MAT 20:19">20:19</ref>; <ref loc="MRK 8:31">मरकुस 8:31</ref>; <ref loc="MRK 9:31">9:31</ref>; <ref loc="MRK 10:33">10:33</ref>,<ref loc="MRK 10:34">34</ref>; <ref loc="LUK 9:22">लूका 9:22</ref>; <ref loc="LUK 18:31-33">18:31-33</ref></char></note>“ए मालिक, हामुक फोम छे, कि त्यो भटकाड़ने वालो जीवतो हुतो तव कयलो हुतो, कि हाव तीन दाहड़ा क बाद जीव उठीस। <verse eid="MAT 27:63"/><verse number="64" style="v" sid="MAT 27:64"/>हामुक हुकुम आप कि तीसरे दाहड़े तक बीड़ो खाली करे, असो नी हुये कि उका चेला आवीन उको त्योरावीन ली जात रहवे, आरू लोगहन सी कहवे, कि त्यो मरला माईन जीव उठियो: तव पछलो धुको पेहला सी बुरो हुयसे।”<verse eid="MAT 27:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65"/>पिलातुस आवीन उन लोगहन सी कयो, “तुमरे पास राखवाळिया तो छे जात्यो, तुमरी समझन अनसारे राखवाळी करो।”<verse eid="MAT 27:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66"/>अळते त्यो राखवाळीया क साथ ली गया, आरू दगड़ा पर छापू लगाड़ीन बीड़ान राखवाली करिया।<verse eid="MAT 27:66"/></para>
  <chapter eid="MAT 27"/>
  <chapter number="28" style="c" sid="MAT 28"/>
  <para style="s">ईशु क जीव उठनो</para>
  <para style="r">(<ref loc="MRK 16:10">मरकुस 16:10</ref>; <ref loc="LUK 24:1-12">लूका 24:1-12</ref>; <ref loc="JHN 20:1-10">यहुन्ना 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1"/>सब्तन दाहाड़ा क बाद सप्ताह पेहला दाहड़ाम भौळभाका मा मरियम मगदलीनी आरू दिसरी मरियम बीड़ा देखने आवी। <verse eid="MAT 28:1"/><verse number="2" style="v" sid="MAT 28:2"/>तव एक मोटोत् भुकंप हुयो, काहकि यहोवा–भगवान क एक सोरगदूत सी उतरीयो, आरू एको पास मा आवीन दगड़ा क ढोवळी दियो, आरू उका पर बठी गियो। <verse eid="MAT 28:2"/><verse number="3" style="v" sid="MAT 28:3"/>हेको रूप बिजळीन समान आरू उका छिंदरा बरफन क विजाळा हुता। <verse eid="MAT 28:3"/><verse number="4" style="v" sid="MAT 28:4"/>ओको बीक सी राखवाळीया बीहने लाग गिया, आरू मरलो जीवतो हुय गियो।<verse eid="MAT 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5"/>सोरगदूत बायरान क कयो। “मा बीहयो हाव जानो कि तुमू ईशु नासरत क, जो कुरूस पर चढ़ाया गया हुता, हेरती होय। <verse eid="MAT 28:5"/><verse number="6" style="v" sid="MAT 28:6"/>त्यो या नी हय, बाकुन जीवतो हूय गियो; आयो, यो जागु देखो, जा परबु क राखला हुता। <verse eid="MAT 28:6"/><verse number="7" style="v" sid="MAT 28:7"/>आरू छाटलोत जाईन उका चेला सी कयो, कि त्यो मरला माईन जीव उठियो; आरू देखो त्यो तुमरे सी पेहल गलील मा जाय जासे, वा उको दर्शन देखसो, देखो, हाव तुमू क संदेश आप देदु छे।”<verse eid="MAT 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8"/>आरू छाटी ची बायर खुशमा मोळवट्याम पर सी पछी जाईन ईशुन चेलान क खबर देदी।<verse eid="MAT 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9"/>तव, ईशु चेलान क मेळीयो आरू कयो; “सुखी रहवो” आरू चेला ईशु क पास मा आवीन उका पाय क धरीन उको वंद्या। <verse eid="MAT 28:9"/><verse number="10" style="v" sid="MAT 28:10"/>तव ईशु वेलान सी कयो, “बीहयो मा; म्हार भाईस्यो क जाईन कहवो, कि गलील मा जाती रहत्यो वा मेखे देखसे।”<verse eid="MAT 28:10"/></para>
  <para style="s">राखवालीयान खबर</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11"/>त्या जाती हुती, कि राखवाळिया माईन घना जन नगर मा आवीन पूरो हाल डाहला पुजारान क कय दीदा। <verse eid="MAT 28:11"/><verse number="12" style="v" sid="MAT 28:12"/>तव त्या डाहडान क साथ मा एखटा हुया, आरू एकु रूकाया, आरू सिपायड़ान क घण सवटो धन देदा। <verse eid="MAT 28:12"/><verse number="13" style="v" sid="MAT 28:13"/>“यो कहवजो कि रात मा जव हामू सूय रिया हुता, तो उका चेला आवीन उको त्योरायली गिया। <verse eid="MAT 28:13"/><verse number="14" style="v" sid="MAT 28:14"/>आरू कदाम यी वात रोमि आदिकारीन कान्टा मा तक पुगी गय, तो हामू उना समझाड़ लेसे आरू तुमूक खतरा सी वाचाड़ लेसे।”<verse eid="MAT 28:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15"/>आरू त्या पोशा लीन जसा सिखिया हुता, वसात करिया; आरू यी वात आज तक यहूदि या मा नाव सादाय छे।<verse eid="MAT 28:15"/></para>
  <para style="s">चेलान क दर्शन आरू ईशु क आखरी हुकुम</para>
  <para style="r">(<ref loc="MRK 16:14-18">मरकुस 16:14-18</ref>; <ref loc="LUK 24:36-49">लूका 24:36-49</ref>; <ref loc="JHN 20:19-23">यहुन्ना 20:19-23</ref>; <ref loc="ACT 1:6-8">प्रेरितन 1:6-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">28:16 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:32">मत्ती 26:32</ref>; <ref loc="MRK 14:28">मरकुस 14:28</ref></char>
    </note>आरू गियारा चेला गलील मा उना बयड़ा पर गिया, जिनाक ईशु उन क देखाड़लो हुतो। <verse eid="MAT 28:16"/><verse number="17" style="v" sid="MAT 28:17"/>आरू चेला ईशु क दर्शन देखीन हेको वंद्या, बाकुन कोय–कुदान क संका हुय। <verse eid="MAT 28:17"/><verse number="18" style="v" sid="MAT 28:18"/>ईशु चेलान क पास मा आवीन कयो, “सोरग आरू धरतीन सब हक मेखे आप्यो गयो छे। <verse eid="MAT 28:18"/><verse number="19" style="v" sid="MAT 28:19"/>अतरानकरीन करिन या से जाईन सब राष्ट्रन लोगहन क म्हारा चेला बनावो आरू त्या लोगहन क बास, बेटा आरू चुखली आत्मान नाव से बपतिस्मा देयो। <verse eid="MAT 28:19"/><verse number="20" style="v" sid="MAT 28:20"/>आरू त्या लोगहन क इन आखा हुकुम क पाळनी करने कि शिक्षा सिखाड़ो, जो हाव तुमको दिया। आरू फोम राखो: कि हाव धरती आखरी तक जलोम तुमरे साथ मा छे”<verse eid="MAT 28:20"/></para>
  <chapter eid="MAT 28"/>
</usx>
