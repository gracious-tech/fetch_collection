<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HEB" style="id">– Dhankavi</book>
  <para style="h">इब्रानियों</para>
  <para style="toc3">इब्रानियों</para>
  <para style="toc2">इब्रानियों</para>
  <para style="toc1">इब्रानियों नी लिखली पत्री</para>
  <para style="mt2">इब्रानियों कि लिखी हुई पत्री</para>
  <para style="mt1">इब्रानियों नी लिखली पत्री</para>
  <para style="imt">परिचय</para>
  <para style="ip">ईशु पुराना नियम क घण सवटी कागळियान वात क पुरो कसो करे यो देखाड़ने वाळी “इब्रानियो क पत्री” यी एक गम आपने वाळी पत्री छे, आरू एक खास काम से यी लिखायली छे। आखी कागळियान वात आरू खास पुजारान क काम क ईशु मसीह पुरो करियो यी वात देखाड़ने वाळी आरू 60 से भी ज्यादा वातन क यी पत्री देखाड़े। अतरानकरीन करीन यी किताब यहूदि लोगहन क जो सी देवाड़ने वाळी किताब करीन मानी गयली छे। आरू यी पत्री एर सी ओगळ इनी वात क देखाड़े की ईशु कसो त्या नियम क पुरो करियो, कि हाय पुजारान क त्यो काम जो नियम अनसारे करता हुता, त्यो करनेन जरूरत नी हय। जो पाप क चढ़ावो पेहले चढ़ावता हुता, त्यो पापोन क चढ़ावो ईशु एक वार मा पूरो कर दिदो। यी किताब हामुक यो समझाड़े की, ईशु मसीह हामुके, यहोवा–भगवान पर विश्वास करने करीन तियार करे। <char style="xt"><ref loc="HEB 12:2">12:2</ref></char> इनिये रीति आज काल क जमानान क विश्वासीयान क करता घण मोटा जुरन वात इनी पत्री मा छे, आरू हामुक एर भुळा पर रहचनो जुवे।</para>
  <para style="ip">इब्रानियोंन की पत्री कुन लिखियो यो हामुके मालम नी हय, पुन काहय जानकार क यो माननो छे कि, यी प्रेरित पौलुस, लूका या बरनबास या यहोवा भगवान क सेवक लिखिया हसे। एको कारण असो छे की यी पत्री ईशु मसीन जनमन ओळते 70 साल पेहल लिखी गय हसे ती भी इनी किताब मा यरूशलेम क बारा मा इनीये रीति देखाड़लो छे कि, त्यो आरू नाश नी हुयो हुतो। आरू यी किताब घण सवटी मंडळी मा भण्या हसे। काहकि यी रोम शहर मा रईन लिखी गय हुती। <char style="xt"><ref loc="HEB 13:24">13:24</ref></char></para>
  <para style="is">रूप रेखा</para>
  <para style="io1">1. इनी पत्री क लिखने वाळो यो देखाड़े कि, ईशु मसीह यहोवा भगवान क आखा कागळिया से मोटो छे। <char style="ior"><ref loc="HEB 1:1-4:13">1:1–4:13</ref></char></para>
  <para style="io1">2. ओळते त्यो यो देखाड़े कि, जो पुजारा यरूशलेम मंदिर मा सेवा करता हुता, ईशु तेखा से भी मोटो छे। <char style="ior"><ref loc="HEB 4:14-7:28">4:14–7:28</ref></char></para>
  <para style="io1">3. मूसा क आपला हुकुमन लारे जो पुरानो नियम यहोवा भगवान उको लोगहन क दियो तेखा से भी ईशु मोटो छे। <char style="ior"><ref loc="HEB 8:1-10:31">8:1–10:31</ref></char></para>
  <para style="io1">4. ईशु आखी वात मा मोटो छे यो पुरावो करने क बाद मा पत्री क लिखने वाळो घण वातन क व्यवहार क बारा मा देखाड़े। <char style="ior"><ref loc="HEB 10:32-13:17">10:32–13:17</ref></char></para>
  <para style="io1">5. आखरी मा लिखने वाळो क जुरदेवाड़तो जाईन आखरी खबर आपीन पत्री क खतम करे। <char style="ior"><ref loc="HEB 13:18-25">13:18-25</ref></char></para>
  <chapter number="1" style="c" sid="HEB 1"/>
  <para style="s">यहोवा–भगवान क वचन, पोर्‍या क लारे</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1"/>पेहला बारा मा यहोवा–भगवान कागळियान क लारे वेगला डाहडा से थुड़ो थुड़ो करीन आरू भाति भातिन वात करियो। <verse eid="HEB 1:1"/><verse number="2" style="v" sid="HEB 1:2"/>इन आखरी दाहड़ा मा हामु छे पोर्‍य क द्वारा वात की, जिनाक त्यो सारी समान क वारीस ठेराया आरू ओकी क द्वारा त्यो सारी सृष्टि की रचना की छे। <verse eid="HEB 1:2"/><verse number="3" style="v" sid="HEB 1:3"/>वो ओकी महिमा क प्रकाश आरू ओका तत्व की छाप छे, आरू सब चीज क आपसी शक्ति क वचन छे संमावतो छे। वो पाप क धुवीन उंचा स्थान पर महामहिमन क डासच्य जाय बठ्या।<verse eid="HEB 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4"/>आरू सोरग छे ओतरा ही वारू ठेराया, जोतरा त्यो उनछे मोटा पद क वारीस हईन वारू नाव देख्या।<verse eid="HEB 1:4"/></para>
  <para style="s">यहोवा–भगवान पोर्‍या की श्रेष्ठता</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 1:5"/>काहकि सोरग मा छे किही काही छे कयो,</para>
  <para style="q1" vid="HEB 1:5">“तु मारो पोर्‍य छे, आज तु म्हार सी पयदा हुयो?”</para>
  <para style="q2" vid="HEB 1:5">आरू “हाव ओको बाप कहवाईस।”<verse eid="HEB 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 1:6"/>आरू जव पेहलौठे क धरती मा पछु लावता छे,</para>
  <para style="q2" vid="HEB 1:6">तो कयता छे,</para>
  <para style="q1" vid="HEB 1:6">“यहोवा–भगवानन सब सोरगदूत ओको दण्डवत् करू।”<verse eid="HEB 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 1:7"/>आरू सोरगदूतन विषय मा यो कयता छे,</para>
  <para style="q2" vid="HEB 1:7">“वो आपने दुतन पवन, आरू आपसा सेवकन धधकती आगठो बनावता छे।”<verse eid="HEB 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 1:8"/>पुन पोर्‍या विषय मा कयता छे,</para>
  <para style="q2" vid="HEB 1:8">“हे यहोवा–भगवान तारा सिंहासन युगानयुग रोवछे: तारा राज्य क राजदण्ड न्याय क राजदण्ड छे।”<verse eid="HEB 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9"/>तु ने न्यायपन छे मोंग अन्याय छे दुस्मनी राख्या;</para>
  <para style="q2" vid="HEB 1:9">इनीये कारण यहोवा–भगवान,</para>
  <para style="q1" vid="HEB 1:9">तारा यहोवा–भगवान ने,</para>
  <para style="q2" vid="HEB 1:9">तारा साथी छे बढ़ीन हर्षरूपी तेल छे तारो अभिषेक कर्‍या।<verse eid="HEB 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 1:10"/>आरू यो कि, “हे पोरबु शुरू मा तु ने धरती की नींव नाखी,</para>
  <para style="q2" vid="HEB 1:10">आरू सोरगदूत तारा हात की कारीगरी छे।<verse eid="HEB 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11"/>वो तो नष्ट होय जाछे, पुन तु बन रोवछे;</para>
  <para style="q2" vid="HEB 1:11">आरू वो सब लुगड़ान समान जुनला होय जाछे।<verse eid="HEB 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12"/>आरू तु तीनुक चादरान समान वेटावछे,</para>
  <para style="q2" vid="HEB 1:12">आरू वो लुगड़ा क समान बदल जाछे: पर तु चो छे आरू तारा साल क आखरी नी होयछे।”<verse eid="HEB 1:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="HEB 1:13"/>आरू सोरगदूत मा छे त्यो काही छे किही कयो,</para>
  <para style="q1" vid="HEB 1:13">“तु मारो डावु बठ्या,</para>
  <para style="q2" vid="HEB 1:13">जव तक की हाव तारे दुस्मनयो क तारे पाय क</para>
  <para style="q1" vid="HEB 1:13">नेचो की पीढ़ी नी कर दीस?”<verse eid="HEB 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14"/>काय वो सब सेवा टहल करनेवाळी आत्मा नी, जो उध्दार देखनेवावान करता सेवा करनेन मुकली जाती छे।<verse eid="HEB 1:14"/></para>
  <chapter eid="HEB 1"/>
  <chapter number="2" style="c" sid="HEB 2"/>
  <para style="s">महान उध्दार</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1"/>इनीये कारण जूवे कि हामु उन वात पर जो हामु सोमवी छे, आरू भी मन लागाड़ या ओसो नी होय कि भड़कीन उन छे दूर चाली जाय। <verse eid="HEB 2:1"/><verse number="2" style="v" sid="HEB 2:2"/>काहकि जो वचन सोरगदूतन द्वारा कयो गया हुता। जव वो स्थिर रया आरू हर एक गुणेहगार आरू हुकुम नी माननेन ठीक बदला मिव्या। <verse eid="HEB 2:2"/><verse number="3" style="v" sid="HEB 2:3"/>तो हामु मानसे ओसा मोटा उध्दार छे निश्चन्त रोवीन कोसो वाच सकता छे? जेरो चर्चा पेहल पोरबुन द्वारा होयी, आरू सोमवनेवावान द्वारा हामु ऐरो छाचो हुयो। <verse eid="HEB 2:3"/><verse number="4" style="v" sid="HEB 2:4"/>आरू साथे ही यहोवा–भगवान भी आपसी मरजी क लारे सहलानी, आरू घण मोटो काम, आरू हरेक प्रकारन सामर्थ्यन काम, आरू चुखलो आत्मान वरदान वाटनेन द्वारा ओकी गवा देता रया।<verse eid="HEB 2:4"/></para>
  <para style="s">हामरा उध्दारकरता</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5"/>त्यो ओको आवनेवाळा जगत क जेरो चर्चा हामु कर रया छे, सोरगदूतन हको तळे नी कर्‍या। <verse eid="HEB 2:5"/><verse number="6" style="v" sid="HEB 2:6"/>वरना काही ने कयी यो गवा देदी छे,</para>
  <para style="q1" vid="HEB 2:6">“मानुस काय छे कि तु ओकी सुधि लेता छे या</para>
  <para style="q2" vid="HEB 2:6">मानुस क पोर्‍या काय छे कि तु ओकी चिंता करता छे?”<verse eid="HEB 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7"/>तु ने ओको सोरगदूत छे काही कम कर्‍या;</para>
  <para style="q2" vid="HEB 2:7">तु ने ओको पर महिमा आरू विजुत क मुकूट राख्या, आरू त्यो आपने हात क काम पर हक दिदा।<verse eid="HEB 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 2:8"/>तु ने सब काही ओको पायन नेचो कर दिदा,</para>
  <para style="q2" vid="HEB 2:8">अतरान करीन जव कि त्यो सब काही ओको हको तळे कर दिदा,</para>
  <para style="q1" vid="HEB 2:8">तो त्यो काही भी राख नी छुड़िया जो ओको हको तळे नी होय।</para>
  <para style="m" vid="HEB 2:8">पर हामु हिमी सब काही ओको हको तळे नी देखता। <verse eid="HEB 2:8"/><verse number="9" style="v" sid="HEB 2:9"/>पर हामु ईशु क जो सोरगदूत छे काही ही काम कर्‍या गया हुता, मरलाक दुःख झेलनेन कारण महिमा आरू विजुत क मुकूट पेहरीन होया देखता छे, ताकि यहोवा–भगवानन फोकटन दया छे वो हर एक मानसोन करता मरला क हवाद चाखे। <verse eid="HEB 2:9"/><verse number="10" style="v" sid="HEB 2:10"/>काहकि ओका करता सब काही छे आरू ओका द्वारा सब काही छे, ओको योही वारलो लागे कि जव वो घोणा छे पोर्‍य क महिमा मा पुचाड्या, ती उध्दारन करता क दुःख उठावने क द्वारा सिध्द करे।<verse eid="HEB 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11"/>काहकि चुखलो करनेवावा आरू जो चुखलो कर्‍या जाता छे, सब एक मूल छे; अतरान करीन कारण वो तीनुक भाईस कयनो छे नी लाजवायता। <verse eid="HEB 2:11"/><verse number="12" style="v" sid="HEB 2:12"/>वो कयता छे,</para>
  <para style="q1" vid="HEB 2:12">“हाव तारो नाव आपने भाईस्योक सोमवावी;</para>
  <para style="q2" vid="HEB 2:12">सभा क विच मा हाव तारो भजन गावीस।”<verse eid="HEB 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 2:13"/>आरू पछु यो, “हाव ओको पर विश्वास राखीस।” आरू पछु यो, “देख हाव उन पोर्‍य सहित जिनाक यहोवा–भगवान ने मखे आपलो।”<verse eid="HEB 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14"/>एरकरीन जव कि पोर्‍य मास आरू लुहूय क भागी छे, तो वो आप भी तींदरा समान ओको सहभागी होय गया, ताकि मरला क द्वारा ओको जिनाक मरला पर शक्ति मिवी होती, मतलब शैतानन निकम्मा कर देय। <verse eid="HEB 2:14"/><verse number="15" style="v" sid="HEB 2:15"/>आरू जोतरा मरलान बीक क मारे जीवन भर दासत्व मा फंछे हुता, तीनुक छुड़ा लेय। <verse eid="HEB 2:15"/><verse number="16" style="v" sid="HEB 2:16"/>काहकि वो तो सोरगदूतन नी वरना अब्राहम न वंश क संभावता छे। <verse eid="HEB 2:16"/><verse number="17" style="v" sid="HEB 2:17"/>अतरान करीन कारण ओको क जुवे हुता, कि सब वात मा आपने भाईस्यो क समान बने; जिनासे वो वात मा जो यहोवा–भगवान छे सम्बन्ध राखती छे, एक दयालु आरू विश्वासयोग्य डाहला पुजारा बने ताकि मानसे क पाप क करता प्राश्चाताप करे। <verse eid="HEB 2:17"/><verse number="18" style="v" sid="HEB 2:18"/>काहकि जव त्यो परीक्षा करी दशा मा दुःख झेलीया, तो वो उनकी भी मदत कर सकता छे जिन्दरी परीक्षा होयती छे।<verse eid="HEB 2:18"/></para>
  <chapter eid="HEB 2"/>
  <chapter number="3" style="c" sid="HEB 3"/>
  <para style="s">ईशु मूसा छे श्रेष्ठ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1"/>अतरान करीन हे चुखलो भाईस्यो, तुमू जो सोरगदूतीय बुलाहट मा भागी होय, ओको प्रेरित आरू डाहला पुजारा ईशु पर जिनाक पछतावो करता छे, ध्यान करू। <verse eid="HEB 3:1"/><verse number="2" style="v" sid="HEB 3:2"/>वो आपने नियुक्त करनेवाळान करता विश्वासयोग्य हुता, जोसो मूसा भी यहोवा–भगवानन सब घर मा हुता। <verse eid="HEB 3:2"/><verse number="3" style="v" sid="HEB 3:3"/>काहकि ईशु मूसा छे ओतरो बढ़ीन महिमान योग्य समझ गया छे, जोतरा घर क बनावनेवावा घर छे बढ़ीन विजुत राखता छे। <verse eid="HEB 3:3"/><verse number="4" style="v" sid="HEB 3:4"/>काहकि हर एक घर क काही नी काही बनावनेवावा हुयसे छे, पर जो सब काही बनाड़े वो यहोवा–भगवान छे। <verse eid="HEB 3:4"/><verse number="5" style="v" sid="HEB 3:5"/>मूसा तो यहोवा–भगवानन सब घर मा सेवकन समान विश्वासयोग्य रया कि जिन वातन वर्णन हुयने वालो हुता, तीन्दरी गवा देय। <verse eid="HEB 3:5"/><verse number="6" style="v" sid="HEB 3:6"/>पुन मसीह पोर्‍या समान यहोवा–भगवान क घर क हक छे; आरू उना क घर हामु छे, यदि हामु साहस पर आरू आपसी आश डाहळाय पर आखरी तक दृढ़ता छे स्थिर रोवे।<verse eid="HEB 3:6"/></para>
  <para style="s">विन भुरसीया क चेतावनी</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7"/>शेवली कावा जोसो चुखलो आत्मा कयता छे,</para>
  <para style="q1" vid="HEB 3:7">“यदि आज तुमू तेरो ओवाज सोमवु।”<verse eid="HEB 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 3:8"/>तो आपसा मन मा वातड़ो नी करो,</para>
  <para style="q2" vid="HEB 3:8">जोसो कि रीस देवाड़ेन टेहाव आरू परीक्षा क दाहडु जंगल मा कर्‍या हुता।<verse eid="HEB 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9"/>वा तुमरे बाबदादा ने मखे हेरीन पारखने आरू</para>
  <para style="q2" vid="HEB 3:9">चावीस साल तक मारा काम देखने।<verse eid="HEB 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10"/>इनीये कारण हाव ओको टेहाव क मानसे छे रीसवाला रया,</para>
  <para style="q2" vid="HEB 3:10">आरू कयो, “इन्दरा मन सदा भटकता रयता छे,</para>
  <para style="q1" vid="HEB 3:10">आरू त्या लोगहन मारो मार्ग क नी उवखता।”<verse eid="HEB 3:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="HEB 3:11"/>तव हाव ने रीस मा आवीन शपथ खादु,</para>
  <para style="q1" vid="HEB 3:11">“वो मारो विश्राम मा भरायने करने नी देखछे।”<verse eid="HEB 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12"/>हे भाईस्यो, चोकचौळीया रवु कि तुमू मा ओसो बुरो आरू विनभुरसा मन होय, जो तुमूक जीवता यहोवा–भगवान छे दूर हटाय ली जाय। <verse eid="HEB 3:12"/><verse number="13" style="v" sid="HEB 3:13"/>वरना जिना दाहड़े तक आज क दाहडु कयो जाता छे, हर दाहड़े एक दिसरा क समझता रया, ओसो नी होय कि तुमू मा छे काही जन पाप क छव मा आवीन वातड़ो होय जाय। <verse eid="HEB 3:13"/><verse number="14" style="v" sid="HEB 3:14"/>काहकि हामु मसीहन भागीदार होया छे, यदि हामु आपनो पेहलो विश्वास पर आखरी तक दृढ़ता छे स्थिर रोवे।<verse eid="HEB 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 3:15"/>जोसो कयो जाता छे,</para>
  <para style="q1" vid="HEB 3:15">“यदि आज तुमू ऐरो ओवाज सोमवु,</para>
  <para style="q2" vid="HEB 3:15">तो आपने मनन वातड़ो नी करू,</para>
  <para style="q1" vid="HEB 3:15">जोसो कि रीस देवाड़ने क टेहाव कर्‍या हुता।”<verse eid="HEB 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16"/>भला कुनीछे मानसे ने सोमवीन भी रीस देवाड्या? काय उन सब ने नी, जो मूसा क द्वारा मिस्र छे निकवता हुता? <verse eid="HEB 3:16"/><verse number="17" style="v" sid="HEB 3:17"/>आरू वो चावीस साल तक काहना मानसे छे रीसवाला रया? काय इनु छे नी जे पाप कर्‍या, आरू इन्दरो शव जंगल मा पड़ी रोवे? <verse eid="HEB 3:17"/><verse number="18" style="v" sid="HEB 3:18"/>आरू त्यो कुनीछे शपथ खादी कि तुमू मारे विश्राम मा भरायने करने नी देखछे? काय केवल इनु सी नी जी हुकुम नी मानी? <verse eid="HEB 3:18"/><verse number="19" style="v" sid="HEB 3:19"/>शेवली कावा हामु देखता छे कि वो विनभुरसा कारण भरायने नी कर सके।<verse eid="HEB 3:19"/></para>
  <chapter eid="HEB 3"/>
  <chapter number="4" style="c" sid="HEB 4"/>
  <para style="s">यहोवा–भगवान क मानसे क विश्राम</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1"/>अतरान करीन जव कि ओका विश्राम मा भरायने करने की प्रतिज्ञा हिमी तक छे, तो हामु घाबरायने जूवे ओसो नी होय कि तुमू मा छे काही जन ओका सी वंचित रया जाय। <verse eid="HEB 4:1"/><verse number="2" style="v" sid="HEB 4:2"/>काहकि हामु इन्दरी तरह खुश खबर सोमवाया गया छे, पर सोमवने होया वचन छे तीनुक काही लाभ नी होया; काहकि सोमवनेवावा क मन मा विश्वास क साथ नी बठ्या। <verse eid="HEB 4:2"/><verse number="3" style="v" sid="HEB 4:3"/>पुन हामु जे विश्वास कर्‍या छे,</para>
  <para style="q1" vid="HEB 4:3">ओको विश्राम मा भरायने करता छे; जोसो त्यो कयो,</para>
  <para style="q2" vid="HEB 4:3">“हाव ने आपने रीस मा शपथ खादी कि वो मारे विश्राम मा भरायने करने नी देखछे।”</para>
  <para style="m" vid="HEB 4:3">यदि धरती की उबजनो क टेहाव छे तेरो काम पूरो होय त्योक्यो होतो। <verse eid="HEB 4:3"/><verse number="4" style="v" sid="HEB 4:4"/>काहकि सातवु दाहडु क विषय मा त्यो कयी यो कयो छे, “यहोवा–भगवान ने सातवे दाहड़े आपसा सब कामक निपटा करीन विश्राम कर्‍या।” <verse eid="HEB 4:4"/><verse number="5" style="v" sid="HEB 4:5"/>आरू इनीये धरती पछु यो कयता छे, “वो मारे विश्राम मा भरायने नी करने देखछे।” <verse eid="HEB 4:5"/><verse number="6" style="v" sid="HEB 4:6"/>तो जव यो वात बाकी छे कि कोतरा आरू छे जो ओको विश्राम मा भरायने करे, आरू जे तेरो खुश खबर पेहल सोमवाय गया तीनुक हुकुम नी माननेन कारण इनुमा भरायने नी कर्‍या। <verse eid="HEB 4:6"/><verse number="7" style="v" sid="HEB 4:7"/>अतरान करीन वो काही विशेष दाहड़ा ठेरावीन ओतरा दाहड़ान बाद दाऊद की किताब मा ओको</para>
  <para style="q1" vid="HEB 4:7">“आज क दाहडु क कयता छे। जोसो पेहल कयो गया यदि आज तुमू ओको ओवाज सोमवीन,</para>
  <para style="q2" vid="HEB 4:7">तो आपनो मन क वातड़ो नी करो।”<verse eid="HEB 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8"/>काहकि यदि यहोशू तीनुक विश्राम मा भरायने कराय लेता, तो तेरे बाद दिसरे दाहड़े की चर्चा नी होयती। <verse eid="HEB 4:8"/><verse number="9" style="v" sid="HEB 4:9"/>शेवली कावा जान लेवु कि यहोवा–भगवान क मानसे क करता आरामन दाहडान विश्राम बाकी छे। <verse eid="HEB 4:9"/><verse number="10" style="v" sid="HEB 4:10"/>काहकि जु तेरो विश्राम मा भरायने कर्‍या छे, त्यो भी यहोवा–भगवानन समान आपसा काम क पूरो करीन विश्राम कर्‍या छे। <verse eid="HEB 4:10"/><verse number="11" style="v" sid="HEB 4:11"/>शेवली कावा हामु ओको विश्राम मा भरायने करने क कोशिष करे, ओसो नी होय कि काही जन उन क समान हुकुम नी मानीन पड़ गया।<verse eid="HEB 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12"/>काहकि यहोवा–भगवान क वचन जीवतो, आरू मजबुत, आरू एक दुधारी तलवार छे भी चोखा छे; आरू जीव आरू आत्मान, आरू गाठ–गाठ आरू गूदा–गूदा क अलग करीन आरू पार छेदता छे आरू मन की भावना आरू विचार क हेरता छे। <verse eid="HEB 4:12"/><verse number="13" style="v" sid="HEB 4:13"/>सृष्टि की काही समान इनु सी डुकाय नी छे वरना जिनुछे हामु काम छे, ओका डुवा क सामने सब चीज उघाड़ली आरू प्रगट छे।<verse eid="HEB 4:13"/></para>
  <para style="s">मोटो डाहला पुजारा</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14"/>अतरान जव आमरो ओसो मोटो डाहला पुजारा छे, जो सोरगदूतो छे हईन गया छे, मतलब यहोवा–भगवानन पोर्‍य ईशु, तो आवु, हामु आपने पछतायो क दृढता छे थाहाव रोवे। <verse eid="HEB 4:14"/><verse number="15" style="v" sid="HEB 4:15"/>काहकि आमरो ओसो डाहला पुजारा नी जो हामरी निर्बलता मा हामरे साथे दुःख नी होय सके; वरना वो सब वात मा हामरे समान पारखता तो गया, तौभी निष्पाप निकवता। <verse eid="HEB 4:15"/><verse number="16" style="v" sid="HEB 4:16"/>अतरान करीन आवु, हामु फोकटन दया क सिंहासन क निकट हियाव बांधीन चाले कि हामु पर दया होय, आरू वो फोकटन दया देखछे जो जरूरत क टेहाव हामरी मदत करे।<verse eid="HEB 4:16"/></para>
  <chapter eid="HEB 4"/>
  <chapter number="5" style="c" sid="HEB 5"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1"/>काहकि हर एक डाहला पुजारा मानुस मा छे लेता जाता छे आरू मानुस ही क करता, उन वात क विषय मा जो यहोवा–भगवान छे सम्बन्ध राखती छे, ठेराया जाता छे कि भेंट आरू पाप बलि चढ़ाया करे। <verse eid="HEB 5:1"/><verse number="2" style="v" sid="HEB 5:2"/>वो विनअकलिया आरू भूले भटको क साथे नर्मी छे व्यवहार कर सकता छे, अतरान करीन कि वो आप भी निर्बलता छे घिरा छे। <verse eid="HEB 5:2"/><verse number="3" style="v" sid="HEB 5:3"/>अतरान करीन ओको जुवे कि जोसा मानसोन वोसो ही आपने करता भी पाप बलि चढ़ाया करू। <verse eid="HEB 5:3"/><verse number="4" style="v" sid="HEB 5:4"/>यो विजुत क पद काही आपने आप क छे नी लेता, जव तक कि हारून क समान यहोवा–भगवान की आरू छे ठराय नी जाय।<verse eid="HEB 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5"/>वोसो ही मसीह ने भी डाहला पुजारा बनने की बढ़ाई आपने आप छे नी लेदी,</para>
  <para style="q1" vid="HEB 5:5">पर ओको तीनी ने देदी, जो ओका सी कयो हुता,</para>
  <para style="q2" vid="HEB 5:5">“तु मारो पोर्‍य छे, आज हाव ही ने तुखे पैदा कर्‍या छे।”<verse eid="HEB 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 5:6"/>इन प्रकार वो दीसरी धरती मा भी कयता छे,</para>
  <para style="q1" vid="HEB 5:6">“तु मेलख़ीत्सेदेक की रीति</para>
  <para style="q2" vid="HEB 5:6">पर सदान करता पुजारा छे।”<verse eid="HEB 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:7 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:36-46">मत्ती 26:36-46</ref>; <ref loc="MRK 14:32-42">मरकुस 14:32-42</ref>; <ref loc="LUK 22:39-46">लूका 22:39-46</ref></char>
    </note>ईशु ने आपसी डील मा रोवने क दाहड़ा मा उंचा ओवाज छे आयड़ीन आरू आसा पाड़ीन ओका सी जो ओको मरला मारयन वाचड़ सकता हुता, प्रार्थना आरू रावन्या करी, आरू भक्ति क कारण ओकी सोमवाय गयी। <verse eid="HEB 5:7"/><verse number="8" style="v" sid="HEB 5:8"/>पोर्‍य हुयने पर भी त्यो दुःख उठाड़ हुकुम मान सखी। <verse eid="HEB 5:8"/><verse number="9" style="v" sid="HEB 5:9"/>आरू सिध्द बनीन, आपने सब हुकुम माननेवावा क करता अमरकाय काव क उध्दार क कारण होय गया। <verse eid="HEB 5:9"/><verse number="10" style="v" sid="HEB 5:10"/>आरू ओको यहोवा–भगवान की आरू छे मेलख़ीत्सेदेक की रीति पर डाहला पुजारा क पद मिव्य।<verse eid="HEB 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11"/>अतरान करीन विषय मा घोणा सी वात कयनो छे, जिन्दरो समझने भी वातड़ो छे, अतरान करीन कि तुमू उंचा सोमवने लागे होय। <verse eid="HEB 5:11"/><verse number="12" style="v" sid="HEB 5:12"/><note caller="+" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="1CO 3:2">1 कुरन्थियो 3:2</ref></char></note>टेहाव क विचार छे तो तुमूक गुरू होय जानो जुवे हुता, तौभी यो छाची होय गया छे कि काही तुमूक यहोवा–भगवानन वचन की शुरू शिक्षा पछु छे सिखाड़। तुमू तो ओसो होय गयो होय कि तुमूक अन क बदल हिमी तक दूध ही जुवे। <verse eid="HEB 5:12"/><verse number="13" style="v" sid="HEB 5:13"/>काहकि दूध पीनेवावा पोर्‍या क तो न्यायपन क वचन की उवख नी होयती, काहकि वो पोर्‍य छे। <verse eid="HEB 5:13"/><verse number="14" style="v" sid="HEB 5:14"/>पुन अन सयानो क करता छे, जिन्दरी ज्ञानेंद्रिया मेहनत करता भले बुरे मा भेद करने मा निपुन होय गयी छे। <figure style="fig" alt="High priest with his priestly clothes and censer" file="hk00267c।tif" size="col" copy="Horace Knowles ©" ref="5:5">महायाजकन छिंदरा आरू धुपदानी</figure><verse eid="HEB 5:14"/></para>
  <chapter eid="HEB 5"/>
  <chapter number="6" style="c" sid="HEB 6"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1"/>अतरान करीन आवु मसीह की शिक्षा की शुरू की वात क छुड़ीन हामु सिध्दता करी आरू ओगव बढ़ता जाय, आरू मरला होया काम छे मन फिरावने, आरू यहोवा–भगवान पर विश्वास करने। <verse eid="HEB 6:1"/><verse number="2" style="v" sid="HEB 6:2"/>आरू बपतिस्मा आरू हात राखने, आरू मरला होया क जीवता उठने, आरू अमरकाय न्याय की शिक्षा रूपी नींव पछु छे नी नाखने। <verse eid="HEB 6:2"/><verse number="3" style="v" sid="HEB 6:3"/>यदि यहोवा–भगवान जूवे तो हामु योही करसे।<verse eid="HEB 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4"/>काहकि जिन्दरो एक बार दिया देख छे, आरू जो सोरगदूतीय वरदान क हवाद चाख त्योक्यो छे आरू चुखलो आत्मान भागी होय गया छे। <verse eid="HEB 6:4"/><verse number="5" style="v" sid="HEB 6:5"/>आरू यहोवा–भगवानन वारू वचन क आरू आवनेवाळा युग की शक्ति क हवाद चाख त्योक्या छे। <verse eid="HEB 6:5"/><verse number="6" style="v" sid="HEB 6:6"/>यदि वो भटक जाय तो तीनुक मन फिरावनेन करता पछु नवलो बनावने काठलो छे; काहकि वो यहोवा–भगवान क पोर्‍य क आपने करता पछु कुरूस पर चढ़ावता छे आरू प्रगट मा उना पर गुणो लागाड़ता छे।<verse eid="HEB 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7"/>काहकि जो धरती सालन क पानी क, जो उना पर बार बार पड़ता छे, पी पीयन जिन मानसोन करता वो जोती वेरी जाती छे इन्दरे कामन सागपात उगाड़ ़े छे, वो यहोवा–भगवान छे बरकत देखती छे। <verse eid="HEB 6:7"/><verse number="8" style="v" sid="HEB 6:8"/>पर यदि वो झाड़काम आरू काटेवसीया उगाड़ती जाती छे, तो निकम्मी आरू स्रापित हुयने पर छे, आरू ऐरो आखरी धपाड्या जाना छे।<verse eid="HEB 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9"/>पर हे मोंगावु, यदि हामु यो वात कयता छे तौभी तुमरे विषय मा हामु ओका सी वारली आरू उध्दारवली वात क विश्वास करता छे। <verse eid="HEB 6:9"/><verse number="10" style="v" sid="HEB 6:10"/>काहकि यहोवा–भगवान अन्यायी नी कि तुमरे काम, आरू ओको मोंग क भूल जाय, जो तुमू ने अतरान करीन नावन करता इनीये रीति छे देखाड्या, कि चुखलो मानसे की सेवा करी आरू कर भी रया होय। <verse eid="HEB 6:10"/><verse number="11" style="v" sid="HEB 6:11"/>पर हामु घोणा जूवता छे कि तुमू मा छे हर एक जन आखरी तक पूरी आश क करता ओसो ही कोशिष करता रया। <verse eid="HEB 6:11"/><verse number="12" style="v" sid="HEB 6:12"/>ताकि तुमू उजग्या नी होय जावु, वरना इन्दरो गती करू जो विश्वास आरू धीरज क द्वारा प्रतिज्ञा क वारीस हुयसे छे।<verse eid="HEB 6:12"/></para>
  <para style="s">यहोवा–भगवान की अटल प्रतिज्ञा</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13"/>यहोवा–भगवान ने अब्राहम छे प्रतिज्ञा करता टेहाव जव शपथ खाने क करता काही क आपने छे मोटो नी देख्या, तो आपसी ही शपथ खायन कयो। <verse eid="HEB 6:13"/><verse number="14" style="v" sid="HEB 6:14"/>“हाव सचमुच तुखे घोणा बरकत दीस, आरू तारी अवलियाद क बढ़ावता जाछे।” <verse eid="HEB 6:14"/><verse number="15" style="v" sid="HEB 6:15"/>आरू इन रीति छे त्यो धीरज धरीन प्रतिज्ञा करी होयी वात हासिल करी। <verse eid="HEB 6:15"/><verse number="16" style="v" sid="HEB 6:16"/>मानुस तो आपने छे काही मोटान शपथ खाया करता छे, आरू इन्दरो हर एक विवाद क फैसला शपथ छे पक्‍का हुयसे छे। <verse eid="HEB 6:16"/><verse number="17" style="v" sid="HEB 6:17"/>अतरान करीन जव यहोवा–भगवान ने प्रतिज्ञा क वारीस पर आरू भी साफ रीति छे प्रगट करनो जूवे कि तेरो उद्देश्य बदल नी सकता, तो शपथ क वीच मा लाया। <verse eid="HEB 6:17"/><verse number="18" style="v" sid="HEB 6:18"/>ताकि दुय बे बदल वात क द्वारा, जिन्दरे विषय मा यहोवा–भगवान क झूठ ठराय काठलो छे, दृढ़ता छे आमरो ढाढ़स बंध जाय, जो शरण लेने क एरकरीन दौवड़े छे कि ओको आश क जो सामने राखी होयी छे हासिल करे। <verse eid="HEB 6:18"/><verse number="19" style="v" sid="HEB 6:19"/>वो आश हामरे जीव क करता ओसो लंगर छे जो स्थिर आरू दृढ़ छे, आरू परदा क माहीय तक पुचाड़ता छे। <verse eid="HEB 6:19"/><verse number="20" style="v" sid="HEB 6:20"/>वा ईशु ने मेलख़ीत्सेदेक की रीति पर सदा काव क डाहला पुजारा बनीन, हामरे करता अगळवानिया क रूप मा भरायने कर्‍या छे।<verse eid="HEB 6:20"/></para>
  <chapter eid="HEB 6"/>
  <chapter number="7" style="c" sid="HEB 7"/>
  <para style="s">मेलख़ीत्सेदेक पुजारा</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1"/>यो मेलख़ीत्सेदेक शालेम क राजा, आरू परमप्रधान यहोवा–भगवान क पुजारा, सर्वदा पुजारा बनाय रयता छे। जव अब्राहम राजा क मारीन पुगीयो जाता हुता, तो इनी ने ओका सी भेंट करीन ओको बरकत दिदो। <verse eid="HEB 7:1"/><verse number="2" style="v" sid="HEB 7:2"/>इनी क अब्राहम ने सब चीज क दसवा अंश भी दिदा। यो पेहल आपने नाव क मतलब लारे, न्यायपन क राजा, आरू पछु शालेम मतलब शांती क राजा छे। <verse eid="HEB 7:2"/><verse number="3" style="v" sid="HEB 7:3"/>जेरो नी बास, नी आश, नी वंशावड़ी छे, जेरा दाहड़ा क नी शुरू छे आरू नी जीवन क आखरी छे; पुन यहोवा–भगवान क पोर्‍य क स्वरूप ठराय कर वो सदा क करता पुजारा बनाय रयता छे।<verse eid="HEB 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4"/>हिमी अतरान करीन पर ध्यान करू कि वो कोसो महान हुता जेरो कुलपति अब्राहम ने लूट क वारला छे वारला माल क दसवा अंश दिदा। <verse eid="HEB 7:4"/><verse number="5" style="v" sid="HEB 7:5"/>लेवी की अवलियाद मा छे जो पुजारा क पद देखता छे, तीनुक हुकुम मिवी छे कि मानछे, मतलब आपसा भाईस्यो छे, जूवे अब्राहम ही की डील छे काय नी जन्हाव होय, व्यवस्था क लारे दसवा अंश लेय। <verse eid="HEB 7:5"/><verse number="6" style="v" sid="HEB 7:6"/>पर त्योने, जो इन्दरी वंशावड़ी मा क भी नी हुता, अब्राहम छे दसवा अंश लेदो, आरू जिनाक प्रतिज्ञा मिवी होती ओको बरकत देदी। <verse eid="HEB 7:6"/><verse number="7" style="v" sid="HEB 7:7"/>इनामा संदेह नी कि नाना मोटा छे बरकत देखता छे। <verse eid="HEB 7:7"/><verse number="8" style="v" sid="HEB 7:8"/>आरू याहा तो मरनहार मानुस दसवा अंश लेता छे, पर वाँ चो लेता छे जिन्दरी गवाय देदी जाती छे कि वो जीवतो छे। <verse eid="HEB 7:8"/><verse number="9" style="v" sid="HEB 7:9"/>तो हामु यो भी कय सकता छे कि लेवी ने भी, जो दसवो अंश लेता छे, अब्राहम क द्वारा दसवो अंश आपियो। <verse eid="HEB 7:9"/><verse number="10" style="v" sid="HEB 7:10"/>काहकि जिना टेहाव मेलख़ीत्सेदेक ने ऐरा बास छे भेंट की, उना टेहाव वो आपने बास की देह मा हुता।<verse eid="HEB 7:10"/></para>
  <para style="s">मेलख़ीत्सेदेक क सदृश दिसरा पुजारा</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11"/>यदि लेवीय पुजारा पदन द्वारा सिध्द हासिल होय सकती ओका सहारे मानसे व्यवस्था मिवी होती तो पछु काय जरूरत होती कि दिसरा पुजारा मेलख़ीत्सेदेक की रीति पर उबा होय, आरू हारून की रीति क नी कवायसे। <verse eid="HEB 7:11"/><verse number="12" style="v" sid="HEB 7:12"/>काहकि जव पुजारा क पद बदलाय जाता छे, तो व्यवस्था क भी बदलने पाको छे। <verse eid="HEB 7:12"/><verse number="13" style="v" sid="HEB 7:13"/>काहकि ओका विषय मा यो वात काही जाती छे कि वो दिसरा अवळियाद क छे, जिनामा छे काही ने वेदी की सेवा नी की। <verse eid="HEB 7:13"/><verse number="14" style="v" sid="HEB 7:14"/>तो प्रगट छे कि आमरो पोरबु यहूदा क अवळियाद मा छे उद्य हुयो छे, आरू इनीये अवळियाद क विषय मा मूसा ने पुजारा पद की काही चर्चा नी की।<verse eid="HEB 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15"/>आमरो दावा आरू भी स्पष्टता छे प्रगट होय जाता छे, जव मेलख़ीत्सेदेक क समान एक आरू पुजारा पैदा होय, जाता छे। <verse eid="HEB 7:15"/><verse number="16" style="v" sid="HEB 7:16"/>जो शारीरिक हुकुमन व्यवस्थान लारे नी, पर अमरकाया जीवनन शक्ति क लारे नियुक्त हुयो होय। <verse eid="HEB 7:16"/><verse number="17" style="v" sid="HEB 7:17"/>काहकि अतरान करीन विषय मा यो गवा देदी गयी छे, “तु मेलख़ीत्सेदेक की पर युगानयुग पुजारा छे।”<verse eid="HEB 7:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18"/>इनीये प्रकार, पेहली हुकुम निर्बल आरू निष्फल हुयने क कारण लोप होय गयी। <verse eid="HEB 7:18"/><verse number="19" style="v" sid="HEB 7:19"/>अतरान करीन कि व्यवस्था ने काही वात की सिध्दि नी करी, आरू अतरान करीन स्थान पर एक ओसी वारू आश राखी गयी छे ओका द्वारा हामु यहोवा–भगवान क समीप जाय सकता छे। <verse eid="HEB 7:19"/><verse number="20" style="v" sid="HEB 7:20"/>मसीहन नियुक्ति विना शपथ नी होयी। <verse eid="HEB 7:20"/><verse number="21" style="v" sid="HEB 7:21"/>काहकि वो तो विना शपथ पुजारा ठराय गया पर यो शपथ क साथे ओकी आरू छे नियुक्ति कर्‍या गया ओका ओको विषय मा कयो,</para>
  <para style="q1" vid="HEB 7:21">“पोरबु ने शपथ खादी,</para>
  <para style="q2" vid="HEB 7:21">आरू वो ओका सी पछु नी पछतावो छे</para>
  <para style="q1" vid="HEB 7:21">कि तु युगानयुग पुजारा छे।”<verse eid="HEB 7:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 7:22"/>इनीये प्रकार ईशु एक वारू वाचा जामिन ठेराया।<verse eid="HEB 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23"/>वो तो घोणा मोटी संख्या मा पुजारा बनतो आयो, ऐरो कारण यो होतो कि मरलो इनुक रोवने नी देती होती। <verse eid="HEB 7:23"/><verse number="24" style="v" sid="HEB 7:24"/>पर यो युगानयुग रोवता छे, इनीये कारण ओको पुजारा पद अटल छे। <verse eid="HEB 7:24"/><verse number="25" style="v" sid="HEB 7:25"/>अतरान करीन करता जो ओको द्वारा यहोवा–भगवान क साथे आवता छे, वो इन्दरो पूरा पूरा उध्दार कर सकता छे, काहकि वो ओको करता रावन्या करने क सर्वदा जीवता छे।<verse eid="HEB 7:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26"/>शेवली कावा ओसो ही पुजारा हामरे योग्य हुता जो चुखलो, आरू निष्कपट, आरू निर्मल, आरू पापी छे अलग, आरू सोरगदूत छे भी उचो कर्‍या होया होय। <verse eid="HEB 7:26"/><verse number="27" style="v" sid="HEB 7:27"/>उन डाहला पुजारा क समान ओको छाची नी कि हर दाहड़े पेहल आपने पाप आरू पछु मानसे क पाप क बलिदान चढ़ाया; काहकि त्यो आपने आप बलिदान चढ़ावीन उको एक ही बार मा पूरा कर दिदा। <verse eid="HEB 7:27"/><verse number="28" style="v" sid="HEB 7:28"/>काहकि व्यवस्था तो निर्बल मानुस क डाहला पुजारा नियुक्त करती छे, पुन ओको शपथ क वचन जो व्यवस्था क बाद खाय गयी, उना पोर्‍या क नियुक्त करता छे जो युगानयुग क करता सिध्द कर्‍या गया छे।<verse eid="HEB 7:28"/></para>
  <chapter eid="HEB 7"/>
  <chapter number="8" style="c" sid="HEB 8"/>
  <para style="s">ईशु आमरो डाहला पुजारा</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1"/>हिमी जो वात हामु कय रया छे उनमा छे सब छे मोटी वात यो छे कि आमरो ओसो डाहला पुजारा छे, जो सोरगदूत पर महामहिमन क सिंहासन क डासच्य कावे जाईन बठ्य छे। <verse eid="HEB 8:1"/><verse number="2" style="v" sid="HEB 8:2"/>आरू चुखलो स्थान आरू ओको सच्चे तम्बू क सेवक होया जिनाक काही मानुस ने नी, वरना पोरबु ने उबा कर्‍या छे।<verse eid="HEB 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3"/>काहकि हर एक डाहला पुजारा भेंट आरू बलिदान चढ़ावने क करता ठेराया जाता छे, इनीये कारण पाको छे कि इनीये पुजारा क साथे भी काही चढ़ावने क करता होय। <verse eid="HEB 8:3"/><verse number="4" style="v" sid="HEB 8:4"/>यदि वो धरती पर हुता तो कदी पुजारा नी हुता, अतरान करीन कि व्यवस्था क लारे भेंट चढ़ावने वावा तो छे। <verse eid="HEB 8:4"/><verse number="5" style="v" sid="HEB 8:5"/>वो सोरग मा की चीज क सारखो रूप आरू प्रतिबिम्ब की सेवा करता छे; जोसो जव मूसा तम्बू बनावने पर हुता, तो ओको यो चेतावनी मिवी, “देख जो नमूना तुखे बयड़ा पर देखाय गया हुता, अतरान करीन लारे सब काही बनावने।” <verse eid="HEB 8:5"/><verse number="6" style="v" sid="HEB 8:6"/>पर पुजारा छे बढ़ीन सेवा ईशु क मिवी काहकि वो आरू भी वारू वाचा क मध्यस्थ ठेराया, जो आरू वारू प्रतिज्ञा क सहारे बांधी गयी छे।<verse eid="HEB 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7"/>काहकि यदि वो पेहल वाचा निर्दोष होयती, तो दीसरी क करता मेखे नी हेर्‍या जाता। <verse eid="HEB 8:7"/><verse number="8" style="v" sid="HEB 8:8"/>पर वो उन पर दोष लागाड़ ने कयता छे, देखु, वो दाहडु आवतु छे कि हाव इस्राएल क लोगहन साथे, आरू यहूदा क घराना क नोवली वाचा बांधीस।<verse eid="HEB 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 8:9"/>यो उना वाचा क समान नी होछे,</para>
  <para style="q1" vid="HEB 8:9">जो हाव ने ओको बास दादा क साथे उना टेहाव बांधी होती,</para>
  <para style="q2" vid="HEB 8:9">जव हाव इन्दरो हात धरीन इनुक मिस्र देश छे निकाव लाया;</para>
  <para style="q1" vid="HEB 8:9">काहकि वो मारी वाचा पर स्थिर नी रावे,</para>
  <para style="q2" vid="HEB 8:9">अतरान करीन हाव ने इन्दरी सुधि नी लेदी योही कयता छे।<verse eid="HEB 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10"/>पछु पोरबु कयता छे, कि जो वाचा हाव उन</para>
  <para style="q2" vid="HEB 8:10">दाहड़ा क बाद इस्राएल क घराने क साथे बांधीस वो</para>
  <para style="q1" vid="HEB 8:10">यो छे कि हाव आपसी व्यवस्था क इन्दरे मनो मा नाखीस,</para>
  <para style="q2" vid="HEB 8:10">आरू ओको इन्दरा दिल पर लिखीस,</para>
  <para style="q1" vid="HEB 8:10">आरू हाव इन्दरो यहोवा–भगवान ठेरायस</para>
  <para style="q2" vid="HEB 8:10">आरू वो मारा मानसे ठेरायछे।<verse eid="HEB 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11"/>आरू हर एक आपसा देशवावा क आरू आपसा भाईस</para>
  <para style="q2" vid="HEB 8:11">क यो शिक्षा नी देय, कि तु पोरबु क उळखने,</para>
  <para style="q1" vid="HEB 8:11">काहकि नानी छे मोटी तक सब मखे जान लेछे।<verse eid="HEB 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12"/>काहकि हाव इन्दरो अन्याय क विषय मा दयावन्त होयछे,</para>
  <para style="q2" vid="HEB 8:12">आरू इन्दरो पाप क पछु स्मरण नी करीस।<verse eid="HEB 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13"/>नोवली वाचा की स्थापना छे त्योने पेहलो वाचा क जुनली ठराय दिदा; आरू जो चीज जुनली आरू जीर्ण होय जाती छे ऐरो मिट जाने छाचो छे।<verse eid="HEB 8:13"/></para>
  <chapter eid="HEB 8"/>
  <chapter number="9" style="c" sid="HEB 9"/>
  <para style="s">पार्थिव तम्बू मा सेवा</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1"/>ओको पेहली वाचा मा भी सेवा क नियम हुता, आरू ओसो चुखलोस्थान हुता जो इनीये धरती क हुता <verse eid="HEB 9:1"/><verse number="2" style="v" sid="HEB 9:2"/>काहकि एक तम्बू बनायो गयो, पेहल तम्बू मा दीवट, आरू हावज, की रूटा हुता; आरू वो चुखलोस्थान कोवायता छे। <verse eid="HEB 9:2"/><verse number="3" style="v" sid="HEB 9:3"/>दिसरा परदा क पछव वो तम्बू होतो, जो यहोवा–भगवानन चुखलोस्थान कोवायता छे। <verse eid="HEB 9:3"/><verse number="4" style="v" sid="HEB 9:4"/>उनमा सोनो की धूपदानी, आरू चार आरू सोनो छे आरू ढावलो वाचा क सन्दुक आरू इनमा मन्ना छे भराय हुयो सोनो क मर्तवान आरू हारून की लाकड़ी जिनमा फुल आय गयो होतो आरू वाचा की पट्टी होती। <verse eid="HEB 9:4"/><verse number="5" style="v" sid="HEB 9:5"/>अतरान करीन ऊपर दुयू तो तेजोमय करूब हुता, जो प्राश्चाताप क ढाकने पर सहावु कर्‍या होया हुता; इन्दरो एक एक करीन वर्णन करने क हिमी मेखे नी छे। <figure style="fig" alt="Interior of tabernacle" file="bk00278c।tif" size="span" copy="Horace Knowles ©" ref="9:2">आराधनालयन महायतलो गावो </figure><verse eid="HEB 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6"/>यो चीज इनीये रीति छे तीयार होय त्योकी। ओको पेहल तम्बू मा पुजारा हर टेहाव भरायने करीन सेवा क काम सम्पन्न करता छे। <verse eid="HEB 9:6"/><verse number="7" style="v" sid="HEB 9:7"/>पर दिसरा मा केवल डाहला पुजारा साल भर मा एक ही बार जाता छे, आरू बिना लुहूय करता नी जाता; जिनाक वो आपने करता आरू मानसे की भूल चूक क करता चढ़ावता छे। <verse eid="HEB 9:7"/><verse number="8" style="v" sid="HEB 9:8"/>इनीये छे चुखलो आत्मा योही देखाडतो छे कि जव तक पेहल तम्बू उबो छे तक चुखलोस्थान क मार्ग प्रगट नी हुयो। <verse eid="HEB 9:8"/><verse number="9" style="v" sid="HEB 9:9"/>यो तम्बू वर्तमान टेहाव क करता एक सपनो छे; जिनमा ओसी भेंट आरू बलिदान चढ़ावने जाता छे, जिनुछे आराधना करनेवावा क विवेक सिध्द नी होय सकता। <verse eid="HEB 9:9"/><verse number="10" style="v" sid="HEB 9:10"/>काहकि वो केवल खाने पीने की चीज आरू भाति की स्नान विधि क आधार पर शारीरिक नियम छे, जो सुधार क टेहाव तक क करता नियुक्त कामो गयो छे।<verse eid="HEB 9:10"/></para>
  <para style="s">यहोवा–भगवान क लुहूय की शक्ति</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11"/>पुन जव मसीह आवनेवावी वारली वारली चीज क डाहला पुजारा हईन आयो, तो त्यो आरू भी मोटो आरू सिध्द तम्बू छे हईन, जो हात क बनायो हुयो नी मतलब इनीये सृष्टि क नी। <verse eid="HEB 9:11"/><verse number="12" style="v" sid="HEB 9:12"/>आरू बुकड़ो आरू केवड्या क लुहूय यो क द्वारा नी पर आपने ही लुहूय यो क द्वारा, एक ही बार चुखलोस्थान मा भरायने कर्‍या आरू अमरकाय छुटकारो हासिल कर्‍या। <verse eid="HEB 9:12"/><verse number="13" style="v" sid="HEB 9:13"/>काहकि जव बुकड़ो आरू बुल्यो क लुहूय यो आरू कलोर क रूखड़ो क विटुळ मानसे पर छाटने सी विटळ डील इनुक चुखलो करे। <verse eid="HEB 9:13"/><verse number="14" style="v" sid="HEB 9:14"/>तो मसीह क लुहूय यो जो आपने आप क अमरकाय आत्मा क द्वारा यहोवा–भगवान क सामने निर्दोष चढ़ावने, तुमरे विवेक क मरला हुयो काम छे काय नी चुखो करसे ताकि तुमू जीवता यहोवा–भगवान की सेवा करू।<verse eid="HEB 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15"/>इनी कारण वो नोवली वाचा क मध्यस्थ छे, ताकि ओकी मरन क द्वारा जो पेहली वाचा क टेहाव क दोष छे छुटकारो देखने क करता होयी छे, बुलाया होया मानसे प्रतिज्ञा क लारे अमरकाय मीरास क करे।<verse eid="HEB 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16"/>काहकि वा वाचा बांधीन गयी छे वाँ वाचा बांधनेवावा की मरन क समझ लेने भी पाको छे। <verse eid="HEB 9:16"/><verse number="17" style="v" sid="HEB 9:17"/>काहकि ओसी वाचा मरना पर पाक्‍की होयती छे, आरू जव तक वाचा बांधनेवावा जीवता रयता छे तव तक वाचा काम की नी होयती। <verse eid="HEB 9:17"/><verse number="18" style="v" sid="HEB 9:18"/>इनी करता पेहली वाचा भी बिना लुहूय क नी बांधीन गयी। <verse eid="HEB 9:18"/><verse number="19" style="v" sid="HEB 9:19"/>काहकि जव मूसा सब मानसे क व्यवस्था की हर एक हुकुम सोमवी त्योक्यो तो त्यो केवड्यो आरू बुकड़ो क लुहूय लीन, पानी आरू रातलो रूई आरू जूफा क साथे, इन किताब पर आरू सब मानसे पर छिड़की दिदा। <verse eid="HEB 9:19"/><verse number="20" style="v" sid="HEB 9:20"/>आरू काँ, “यो उना वाचा लुहूय छे, जेरो हुकुम यहोवा–भगवान ने तुमरे करता देदी छे।” <verse eid="HEB 9:20"/><verse number="21" style="v" sid="HEB 9:21"/>आरू इनी रीति छे त्यो तम्बू आरू सेवा क सब समान पर लुहूय छिड़कीया। <verse eid="HEB 9:21"/><verse number="22" style="v" sid="HEB 9:22"/>सच ती यो छे कि व्यवस्था क लारे प्राय: सब चीज लुहूय क द्वारा चुखो करी जाती छे, आरू बिना लुहूय उहवने न पापन माफ नी।<verse eid="HEB 9:22"/></para>
  <para style="s">मसीह क बलिदान द्वारा पाप माफ</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23"/>अतरान करीन पाको छे कि सोरग मा करी चीज क सारखो रूप इन बलिदान क द्वारा चुखो कर जाय, पर सोरग मा करी चीज स्वय इनु सी वारू बलिदान क द्वारा चुखो करी जाती। <verse eid="HEB 9:23"/><verse number="24" style="v" sid="HEB 9:24"/>काहकि मसीह ने उना हात क बनाय हुयो त्यो चुखलोस्थान मा, जो सच त्यो चुखलो स्थान क नमूना छे, भरायने नी कर्‍या पर सोरग ही मा भरायने कर्‍या, ताकि हामरे करता हिमी यहोवा–भगवान क सामने देखाय देय। <verse eid="HEB 9:24"/><verse number="25" style="v" sid="HEB 9:25"/>यो नी कि वो आपने आप क बार बार चढ़ाय, जोसो कि डाहला पुजारा हर साल दिसरा क लुहूय करता चुखलोस्थान मा भरायने कर्‍या करता छे। <verse eid="HEB 9:25"/><verse number="26" style="v" sid="HEB 9:26"/>नी तो धरती की उबजनो छे लीन ओको बार बार दुःख उठाड़नो पड़तो; पर हिमी युग क आखरी मा वो एक ही बार प्रगट होया छे, ताकि आपने ही बलिदान क द्वारा पाप क दूर कर देय। <verse eid="HEB 9:26"/><verse number="27" style="v" sid="HEB 9:27"/>आरू जोसो मानुस क करता एक बार मरना आरू अतरान करीन बाद न्याय क हुयने नियुक्त छे। <verse eid="HEB 9:27"/><verse number="28" style="v" sid="HEB 9:28"/>तसात् ईशु मसीह भी घण सवटा क पाप क उका पर लेने करीन एक बार बलिदान हयो; आरू जो लोगहन ओकी वाट देखे त्यान क छुटकारा क करता दीसरी बार बिना पाप आपसा पर लेदो हयो देखाय पड़से।<verse eid="HEB 9:28"/></para>
  <chapter eid="HEB 9"/>
  <chapter number="10" style="c" sid="HEB 10"/>
  <para style="s">सिध्द बलिदान</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1"/>काहकि व्यवस्था, जिनमा आवनेवावी वारलो चीज क प्रतिबिम्ब छे पर ओको असली स्वरूप नी, एरकरीन उन एक ही प्रकार क बलिदान क द्वारा जो हर साल लगत चढ़ाय जाता छे, साथे आवनेवाळा क कदी सिध्द नी कर सकती। <verse eid="HEB 10:1"/><verse number="2" style="v" sid="HEB 10:2"/>नी तो ओको चढ़ावने बंद काय नी होय जाता? एरकरीन जव सेवा करनेवावा एक ही बार चुखो होय जाता, तो पछु ओको विवेक तीनुक पापी नी ठराय। <verse eid="HEB 10:2"/><verse number="3" style="v" sid="HEB 10:3"/>पुन ओको द्वारा हर साल पाप क स्मरण होया करता छे। <verse eid="HEB 10:3"/><verse number="4" style="v" sid="HEB 10:4"/>काहकि यो वातड़ो छे कि बुल्यो आरू बुकड़ा क लुहूय पाप क दूर करे।<verse eid="HEB 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5"/>इनी कारण वो धरती मा आवता टेहाव कयता छे,</para>
  <para style="q1" vid="HEB 10:5">“बलिदान आरू भेंट तु ने नी जूवी,</para>
  <para style="q2" vid="HEB 10:5">पर मारे करता एक देह तीयार करी।”<verse eid="HEB 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6"/>होम बलीया आरू पाप बलीया</para>
  <para style="q2" vid="HEB 10:6">छे तु खुश नी होया।<verse eid="HEB 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7"/>तव हाव ने कयो, “देखु हाव आय गयो छे,</para>
  <para style="q2" vid="HEB 10:7">चुखलो शास्त्र मा मारा वाराम मा लिख्या हुयो छे, ताकि छे यहोवा–भगवान, तारी मरजी पूरी करे।”<verse eid="HEB 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 10:8"/>ऊपर तो वो कयता छे, “नी तु ने बलिदान आरू भेंट आरू होम बलीया आरू पाप बलीया क जूवे, नी ओका सी खुश हुयो” यदि यो बलिदान तो व्यवस्था क लारे चढ़ाय जाता छे। <verse eid="HEB 10:8"/><verse number="9" style="v" sid="HEB 10:9"/>पछु यो भी कयता छे, “देखु हाव आय गयो छे, ताकि तारी मरजी पूरी करीस” शेवली कावा वो पेहल क उठाड़ देता छे, ताकि दिसरा क नियुक्त करे। <verse eid="HEB 10:9"/><verse number="10" style="v" sid="HEB 10:10"/>ओकी मरजी छे हामु ईशु मसीह की देह क एक ही बार बलिदान चढ़ावने जाने क द्वारा चुखलो कर गया छे। <figure style="fig" alt="Burnt offering on an altar" file="hk00256c।tif" size="col" copy="Horace Knowles ©" ref="10:10">वेदी पर बलिदान</figure><verse eid="HEB 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11"/>हर पुजारा तो उबा हईन हर दाहड़े सेवा करता छे, आरू एक ही प्रकार क बलिदान क जो पाप क कदी भी दूर नी कर सकता, बार बार चढ़ावता छे। <verse eid="HEB 10:11"/><verse number="12" style="v" sid="HEB 10:12"/>पुन यो व्यक्ति तो पाप क बदले एक ही बलिदान सर्वदा क करता चढ़ावीन यहोवा–भगवान क डासच्य जाय बठ्या। <verse eid="HEB 10:12"/><verse number="13" style="v" sid="HEB 10:13"/>आरू तीनी टेहाव छे इसकी वाट जुय रया छे, कि ओका दुस्मन ओका पाय क नेचो की पीढी बने। <verse eid="HEB 10:13"/><verse number="14" style="v" sid="HEB 10:14"/>काहकि त्यो एक ही चढ़ावने क द्वारा तीनुक जो चुखलो कर्‍या जाता छे, सर्वदा क करता सिध्द कर दिदा छे।<verse eid="HEB 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15"/>आरू चुखलो आत्मा भी हामु योही गवा देता छे: काहकि त्यो पेहल कयो हुता।<verse eid="HEB 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16"/>पोरबु कयता छे कि जो वाचा हाव उन दाहड़ा क</para>
  <para style="q2" vid="HEB 10:16">बाद उनछे बांधीस वो यो छे कि हाव आपने नियम</para>
  <para style="q1" vid="HEB 10:16">क ओको दिल पर लिखीस आरू हाव ओको विचार नाखीस।<verse eid="HEB 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 10:17"/>पछु हाव वो यो कयता छे, “हाव ओको पाप क आरू ओको अन्याय क काम क पछु कदी याद नी करीस।” <verse eid="HEB 10:17"/><verse number="18" style="v" sid="HEB 10:18"/>आरू जव इन्दरी माफी हुय गयी, तो पछु पाप क बलिदान नी रया।<verse eid="HEB 10:18"/></para>
  <para style="s">यहोवा–भगवानन समीप जाय</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19"/>एरकरीन हे भाईस, जव हामु ईशु क लुहूय क द्वारा ओको नवलो आरू जीवतो मार्ग छे चुखलोस्थान मा भरायने करने क हियाव होय गयो छे। <verse eid="HEB 10:19"/><verse number="20" style="v" sid="HEB 10:20"/>जो त्यो परदा मतलब आपसा डील मा छे हईन, हामरे करता अभिषेक कर्‍या छे। <verse eid="HEB 10:20"/><verse number="21" style="v" sid="HEB 10:21"/>आरू एरकरीन कि आमरो ओसो महान पुजारा छे, जो यहोवा–भगवान क घर क हक छे। <verse eid="HEB 10:21"/><verse number="22" style="v" sid="HEB 10:22"/>तो आवु, हामु सचे मन आरू पूरो विश्वास क साथे, आरू विवेक क दोष दूर करने क करता हृदय पर छिड़काव लीन, आरू देह क चुखो जल छे धुवीन यहोवा–भगवान क समीप जाय। <verse eid="HEB 10:22"/><verse number="23" style="v" sid="HEB 10:23"/>आवु हामु आपसी आश क पछतायो क दृढ़ता छे थाहाव रया, काहकि जो प्रतिज्ञा करी छे वो सच छे। <verse eid="HEB 10:23"/><verse number="24" style="v" sid="HEB 10:24"/>आरू मोंग, आरू भले काम मा चढ़ावने क करता हामु एक दिसरा की चिंता कर्‍या करे। <verse eid="HEB 10:24"/><verse number="25" style="v" sid="HEB 10:25"/>आरू एक दिसरा क साथे एखठा हुयने नी छुड़ जोसो कि कोतरा की रीति छे, पर एक दिसरा क समझता रया; आरू जसो–जसो उना दाहड़ाम निकट आवता देखु त्यो त्यो आरू भी सवटो यो कर्‍या करू।<verse eid="HEB 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26"/>काहकि सच की उळखने हासिल करने क बाद यदि हामु जान बुझीन पाप करता रया, तो पाप क करता पछु काही बलिदान बाकी नी। <verse eid="HEB 10:26"/><verse number="27" style="v" sid="HEB 10:27"/>हाव, दण्ड क एक भयानक वाट जोहना आरू आगठा जलन बाकी छे जो विरोधी क भस्म कर देसे। <verse eid="HEB 10:27"/><verse number="28" style="v" sid="HEB 10:28"/>जव मूसा की व्यवस्था क नी माननेवावा, दुय या तीन जना की गवा पर, बिना दया क मार नाखने जाता छे। <verse eid="HEB 10:28"/><verse number="29" style="v" sid="HEB 10:29"/>तो सुच लेवु कि वो कोतरा आरू भी भारी दण्ड क योग्य ठरछे, जो यहोवा–भगवान क पोर्‍य क पाय छे रौंदा आरू वाचा क लुहूय क ओका द्वारा वो चुखलो ठराय गया हुता, विटुळ जानने छे, आरू फोकटन दया क आत्मा क विजुत कर्‍या। <verse eid="HEB 10:29"/><verse number="30" style="v" sid="HEB 10:30"/>काहकि हामु उको जानता छे, हाव जो कयो, “पलटा लेने मारो काम छे, हाव ही बदलाय दीस।” आरू पछु यो, कि “पोरबु आपने मानसे क न्याय करसे।” <verse eid="HEB 10:30"/><verse number="31" style="v" sid="HEB 10:31"/>जीवता यहोवा–भगवान क हात मा पड़ने भयानक वात छे।<verse eid="HEB 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32"/>पुन उन पोछले दाहड़े क स्मरण करू, जिन मा तुमू दिया देखीन दुःख क मोटो संघर्ष मा स्थिर रया। <verse eid="HEB 10:32"/><verse number="33" style="v" sid="HEB 10:33"/>किही किही तो यो कि तुमू निंदा आरू पीड़ा सहता होया तमाशा बने, आरू किही यो कि तुमू ओको साझी होया जिनकी दुर्दशा की जाती होती। <verse eid="HEB 10:33"/><verse number="34" style="v" sid="HEB 10:34"/>काहकि तुमू कैदीयो क दुःख मा भी दुःखी होया, आरू आपसी संपत्ति भी खुशी छे लुटने देदी; यो जानीन कि तुमरे साथे एक आरू भी वारू आरू सर्वदा ठरनेवावी सहमत छे। <verse eid="HEB 10:34"/><verse number="35" style="v" sid="HEB 10:35"/>एरकरीन आपसा हियाव नी छुडू काहकि ओको हर फोव मोटा छे। <verse eid="HEB 10:35"/><verse number="36" style="v" sid="HEB 10:36"/>काहकि तुमू धीरज धरने छाची छे, ताकि यहोवा–भगवान की मरजी क पूरी करीन तुमू प्रतिज्ञा क फोव देखछे।<verse eid="HEB 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="HEB 10:37"/>काहकि हिमी घोणा ही थुड़ा टेहाव रया गया छे,</para>
  <para style="q1" vid="HEB 10:37">जव कि आवनेवाळा</para>
  <para style="q2" vid="HEB 10:37">आवसे आरू देर नी करसे।<verse eid="HEB 10:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38"/>पर मारो छाचाय पर चालने वाळो न्यायीजन विश्वास छे जीवता रोवछे,</para>
  <para style="q2" vid="HEB 10:38">आरू यदि वो पछव हट जाछे</para>
  <para style="q2" vid="HEB 10:38">तो मारो मन उना छे खुश नी होयछे<verse eid="HEB 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 10:39"/>पर हामु हटनेवावा नी कि नाश होय जाय पर विश्वास करनेवावा छे कि जीव क वाचाड़्या।<verse eid="HEB 10:39"/></para>
  <chapter eid="HEB 10"/>
  <chapter number="11" style="c" sid="HEB 11"/>
  <para style="s">विश्वास क उदाहरण</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1"/>हिमी विश्वास आश की होयी चीज क छाचो, आरू विनदेखियो चीज क प्रमाण छे। <verse eid="HEB 11:1"/><verse number="2" style="v" sid="HEB 11:2"/>काहकि इनी क विषय मा डाहडा न वारली गवा देदी गयी।<verse eid="HEB 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:3 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:3">यहुन्ना 1:3</ref>
      </char>
    </note>विश्वास ही छे हामु जान जानता छे कि सारी सृष्टि की रचना यहोवा–भगवान क वचन क द्वारा होयी छे। पर यो नी कि जो काही देखने मा आवतो छे, वो देखी होयी चीज छे बनाय होय।<verse eid="HEB 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4"/>विश्वास ही छे हाबील ने कैन छे वारू बलिदान यहोवा–भगवान क करता चढ़ाया, आरू ओकी क द्वारा ओका न्यायी हुयने की गवा भी देदी गयी, काहकि यहोवा–भगवान ने ओकी भेंट क विषय मा गवा देदी; आरू ओकी क द्वारा वो मरना पर भी हिमी तक वात करता छे।<verse eid="HEB 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5"/>विश्वास ही छे हनोक उठाय लेदा गया कि मरन क नी देखे, आरू ओको पता नी हावव्य काहकि यहोवा–भगवान ने ओको उठाय लेदा हुता, आरू ओका उठाय जाने छे पेहल ओकी यो गवा देदी गयी होती कि त्यो यहोवा–भगवान क खुश कर्‍या छे। <verse eid="HEB 11:5"/><verse number="6" style="v" sid="HEB 11:6"/>आरू विश्वास विना उको खुश करने वातड़ो छे; काहकि यहोवा–भगवान क साथे आवनेवाळा क विश्वास करनो जूवे कि वो छे, आरू आपने हेरनेवावा क हर फोव देता छे।<verse eid="HEB 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7"/>विश्वास ही छे नूह ने उन वातन विषय मा जो उना टेहाव देखाय नी पड़ती होती, चेतावनी देखीन भक्ति क साथे आपने घराने क बचाव क करता ढोंड्या बनाड़े, आरू ओका द्वारा त्यो संसार क दोषी ठेराया; आरू ओको न्यायपन क वारीस होया जो विश्वास छे हुता छे।<verse eid="HEB 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8"/>विश्वास ही छे अब्राहम जव बुलाया गया तो हुकुम मानीन ओसी धरतीम निकवीन गया जिनाक मीरास मा लेनेवावा हुता; आरू यो नी जानता हुता कि हाव काह जाता छे, तोभी निकवी गया। <verse eid="HEB 11:8"/><verse number="9" style="v" sid="HEB 11:9"/>विश्वास ही छे त्यो प्रतिज्ञा कर्‍या होया देश मा, दिसरं देश मा परदेशी क समान, रोवीन इसहाक आरू याकूब सहावत, जो ओका साथे तीनी प्रतिज्ञा क वारीस होतो, तम्बू मा वास कर्‍या। <verse eid="HEB 11:9"/><verse number="10" style="v" sid="HEB 11:10"/>काहकि वो उना स्थिर नींव वावा नगर की वाट जुवता हुता, जेरो रचनेवावा आरू बनावनेवावा यहोवा–भगवान छे।<verse eid="HEB 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11"/>विश्वास छे सारा ने आप डाहली हुयने पर भी कुख धारण करने की शक्ति देखी, काहकि त्यो प्रतिज्ञा करनेवावा क सच जाननो होतो। <verse eid="HEB 11:11"/><verse number="12" style="v" sid="HEB 11:12"/>इनीये कारण एक ही जन छे, जो मरलो हुयो सा होतो, आकाश क तारों आरू दरिया क तीर क बालु क समान अनगिनित वंश पैदा हुयो।<verse eid="HEB 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13"/>यो सब विश्वास ही की दशा मा मरला; आरू त्या प्रतिज्ञा की होयी चीज नी देखी, पर तीनुक दूर छे देखीन खुशी होया आरू मान लेदा कि हामु धरती पर परदेशी आरू बाहरी छे। <verse eid="HEB 11:13"/><verse number="14" style="v" sid="HEB 11:14"/>जो ओसी वात कयता छे, वे प्रगट करता छे, कि स्वदेश की हेर मा छे। <verse eid="HEB 11:14"/><verse number="15" style="v" sid="HEB 11:15"/>आरू जिना देश छे वो निकवी आश हुता यदि उना की सुधि करता तो तीनुक पछो जाने क मेखे होतो। <verse eid="HEB 11:15"/><verse number="16" style="v" sid="HEB 11:16"/>पर वे एक वारू मतलब सोरग देश क लालोच छे; इनी करता यहोवा–भगवान इन्दरो यहोवा–भगवान कवायने मा उनछे नी लाजवातो, काहकि त्यो इन्दरे करता एक एक नगर तीयार कर्‍या छे।<verse eid="HEB 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17"/>विश्वास ही छे अब्राहम ने, पारखी जाने क टेहाव मा, इसहाक क बलिदान चढ़ायो; आरू जो प्रतिज्ञा क सची मान होती। <verse eid="HEB 11:17"/><verse number="18" style="v" sid="HEB 11:18"/>आरू जिनासे यो कयो हुता, “इसहाक छे तारो वंश कवायसे चो आपने एक खुळीया क चढ़ावने लाग्यो।” <verse eid="HEB 11:18"/><verse number="19" style="v" sid="HEB 11:19"/>काहकि त्यो मान लेदो, कि यहोवा–भगवान सामर्थी छे कि उको मरला मा छे जीवाड्यो; शेवली कावा उका मा छे सपनो की रीति पर वो उको पछु मिव।<verse eid="HEB 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20"/>विश्वास ही छे इसहाक ने याकूब आरू एसाव क आवनेवावी वातन विषय मा बरकत आप्यो।<verse eid="HEB 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21"/>विश्वास ही छे याकूब ने मरता टेहाव यूसुफ क दुय पोर्‍या मा छे एक एक क बरकत आपी, आरू आपसी लाठी क सिरे पर सहारा लीन दण्डवत् कर्‍या।<verse eid="HEB 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22"/>विश्वास ही छे यूसुफ ने, जव वो मरना पर होतो, तो इस्राएल की अवलियाद क निकवी जाने की चर्चा करी, आरू आपसी हड्डियो क विषय मा हुकुम देदी।<verse eid="HEB 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23"/>विश्वास ही छे मूसा क आश बास ने ओको, पैदा हुयने क बाद तीन महना तक डुकाड़ राख्या, काहकि त्या देख्या कि पोर्‍य सुन्दर छे, आरू वो राजा की हुकुम सी नी घाबराये।<verse eid="HEB 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24"/>विश्वास ही छे मूसा सयाना हईन फिरौन क पोराय क पोर्‍य कोवायने क नि कयो। <verse eid="HEB 11:24"/><verse number="25" style="v" sid="HEB 11:25"/>एरकरीन कि उको पाप मा थुड़ा दाहड़ाम सुख भोगने छे यहोवा–भगवानन मानसोन साथे दुःख भुगने सवटो वारू लागे। <verse eid="HEB 11:25"/><verse number="26" style="v" sid="HEB 11:26"/>त्यो मसीह क कारण निन्दित हुयने क मिस्र क भण्डार छे मोटो धन समझा, काहकि ओका डुवा फोव देखने की आरू लागी होती।<verse eid="HEB 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27"/>विश्वास से राजा न रीस सी नी बीहिन मिस्र देश क नी छुड़ीयो, काहकि त्यो देखीन भी नी देखला बराबर वातड़ो रयो। <verse eid="HEB 11:27"/><verse number="28" style="v" sid="HEB 11:28"/>विश्वास ही छे ओको ने फसह आरू लुहूय यो छिटनेन की विधि मानी, कि पेहलौठान नाश करनेवावा इस्राएलियों पर हात नी नाखे।<verse eid="HEB 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29"/>विश्वास ही छे वे लाल दरियान पार ओसो उतर गया, जोसो सूखी धरती पर छे; आरू जव मिसरी ने वोसो ही करनो जूवे तो आखा डूब मर्‍या।<verse eid="HEB 11:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30"/>विश्वास ही छे यरीहो की शहरपनाह, जव वो सात दाहड़ा तक ओको चक्‍कर लागाड़ चुक्या, तो वो पड़ गयो। <verse eid="HEB 11:30"/><verse number="31" style="v" sid="HEB 11:31"/>विश्वास ही छे राहाब वेश्या हुकुम नी माननेवावान साथे नष्ट नी होयी, तेरेन करीन कि त्यो भेदियान कुशल छे राख्यो होतो।<verse eid="HEB 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32"/>हिमी आरू काय कहवो? काहकि टेहाव नी रया कि गिदोन क, आरू बाराक, आरू शिमशोन न आरू येफ़्ताह, आरू दाऊद, आरू शमूएल, आरू नबिया, भविष्यवक्तान वर्णन करू। <verse eid="HEB 11:32"/><verse number="33" style="v" sid="HEB 11:33"/>चे विश्वास ही क द्वारा राज्य जीक्या; न्यायपन काम कर्‍या; प्रतिज्ञा करी होयी चीज हासिल करी; नाहरन मुय बंद कर्‍या। <verse eid="HEB 11:33"/><verse number="34" style="v" sid="HEB 11:34"/>आगठा आस छेवो कर्‍या; तलवारन धार छे वाच गया; निर्बलता मा बलवन्त होया; लड़ाई मा वीर निकव्या; विदेसन फौज काजे ढेगाठीन ढासाड्या। <verse eid="HEB 11:34"/><verse number="35" style="v" sid="HEB 11:35"/>लुगाई ने आपने मरला होया पोछा जीवता होया देखी; कोतरा तो मार खाता खाता मर गया आरू छुटकारा नी जूव्या तेरे करीन कि वारू जीव उठनेन भागी होय। <verse eid="HEB 11:35"/><verse number="36" style="v" sid="HEB 11:36"/>काही एक ठट्ठा मा उड़ाय जाने; आरू कोड़े खाने वरना बांध जाने, आरू कैद मा पड़नेन द्वारा पारखाय गया। <verse eid="HEB 11:36"/><verse number="37" style="v" sid="HEB 11:37"/>दगड़ा देदा; आरे छे चीराय गया; इन्दरी परीक्षा की गयी; तलवार छे मार गया; वो गरीब मा आरू पीड़ा मा, आरू दुःख भगता होया भेड़ो आरू बुकड़ा की खालें पांगरला होया, याने वा मारे मारे पुगीयो। <verse eid="HEB 11:37"/><verse number="38" style="v" sid="HEB 11:38"/>आरू जंगल, आरू बयड़ा आरू दोर मा, आरू धरती क दरारों मा भटकता लिकायता संसार ओको वारला जागु नी हुतोँ।<verse eid="HEB 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39"/>विश्वास ही क द्वारा इन सब क विषय मा वारली गवा देदी गयी, तव तीनुक प्रतिज्ञा की होयी चीज नी मिवी। <verse eid="HEB 11:39"/><verse number="40" style="v" sid="HEB 11:40"/>काहकि यहोवा–भगवान ने हामरे करता पेहल छे एक वारू वात ठराय, कि वो हामरे बिना सिध्दता क नी पुचाड़े।<verse eid="HEB 11:40"/></para>
  <chapter eid="HEB 11"/>
  <chapter number="12" style="c" sid="HEB 12"/>
  <para style="s">यहोवा–भगवान बास द्वारा ताड़ना</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1"/>इनीये कारण जव गवा क ओसो मोटो वादवो हामु क घेर होया छे, तो आवु, हर एक रूकनेवावा चीज आरू उलझानेवावा पाप क दूर करीन, वो दौवड़ीन जिनमा हामु दौवने छे धीरज छे दौवड़ने। <verse eid="HEB 12:1"/><verse number="2" style="v" sid="HEB 12:2"/>आरू विश्वास क करता आरू सिध्द करनेवावा ईशु की आरू ताकद रये, जो ओको खुश क करता जो ओका ओगव दरिया हुता, लज्जा की काही चिंता नी करीन कुरूस क दुःख सहा, आरू यहोवा–भगवान क सिंहासन की डासच्य आरू जाईन बठ्यो।<verse eid="HEB 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3"/>एरकरीन ओको पर ध्यान करू, जो आपने विरोध मा पापियो क ओतरा विरोध सह लेदा कि तुमू निराश हईन साहस नी छुड़ देवु। <verse eid="HEB 12:3"/><verse number="4" style="v" sid="HEB 12:4"/>तु ने पाप छे लड़ायतो हुयो ओका सी ओसी मुठभेड़ नी की कि तुमरी लुहूय वयो होय।<verse eid="HEB 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HEB 12:5"/>आरू तु ओको शिक्षा क, जो तु पोर्‍य क समान दिदा जाता छे, भूल गया होय:</para>
  <para style="q2" vid="HEB 12:5">“हे मारा पोर्‍या, पोरबु की ताड़ना क हलकी वात नी जान,</para>
  <para style="q1" vid="HEB 12:5">आरू जव वो तुखे घुड़के तो साहस नी छुड़।”<verse eid="HEB 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6"/>काहकि पोरबु जिनासे मोंग करता छे,</para>
  <para style="q2" vid="HEB 12:6">ओकी ताड़ना भी करता छे, आरू जिनाक पोर्‍य बनाय लेता छे, ओकी कोड़े भी लागता छे।<verse eid="HEB 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7"/>तुमू दुःख क ताड़ना समझीन सह लेवु; यहोवा–भगवान तुमू पोर्‍य जानीन तुमरे साथे बर्ताव करता छे। वो कुन सी पोर्‍य छे जेरी ताड़ना बास नी करता? <verse eid="HEB 12:7"/><verse number="8" style="v" sid="HEB 12:8"/>यदि वो ताड़ना जिन्दरे भागी आखा हुयसे छे, तुमरी नी होयी तो तुमू पोर्‍या नी, पर व्यभिचार की अवलियाद ठेराये। <verse eid="HEB 12:8"/><verse number="9" style="v" sid="HEB 12:9"/>पछु जव कि हामरे शारीरिक बास भी हामरी ताड़ना कर्‍या करता हुता आरू हामु इन्दरो विजुत कर्‍या, तो काय आत्मान बासन आरू भी हको तळे नी रये जिनाछे हामु जीवता रया। <verse eid="HEB 12:9"/><verse number="10" style="v" sid="HEB 12:10"/>वो तो आपसी–आपसी समझ क लारे थुड़ा दाहड़ान करता ताड़ना करता हुता, पर वो तो हामरे लाभन करता छे, कि हामु भी ओकी चुखलान भागी होय जाय। <verse eid="HEB 12:10"/><verse number="11" style="v" sid="HEB 12:11"/>वर्तमान मा हर प्रकार की ताड़ना खुशी की नी, पर शोक ही की वात देखाय पड़ती छे; तौभी जो ओको सहते सहते पक्‍का होय गया छे, बाद मा इनुक शांती क साथ न्यायपन हर फोव मिवता छे।<verse eid="HEB 12:11"/></para>
  <para style="s">शिक्षा आरू चेतावनी</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12"/>तेरे करीन ढीले हात आरू निर्बल मांडा सुधा करू। <verse eid="HEB 12:12"/><verse number="13" style="v" sid="HEB 12:13"/>आरू आपसा पायन करता सुध मार्ग बनावु कि लेंगड़ा भटक नी जाय पर भला वारू होय जाय।<verse eid="HEB 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14"/>सब छे मेलमिलाप राखु, आरू ओको त्योखलोतान हेर होय ओका विना काही पोरबुन कदी नी देखछे। <verse eid="HEB 12:14"/><verse number="15" style="v" sid="HEB 12:15"/>ध्यान छे देखता रवु, ओसो नी होय कि काही यहोवा–भगवानन फोकटन दया छे वंचित रया जाय, या काही कड़वी मुव फूटीन कष्ट देय, आरू अतरान करीन द्वारा घोणा छे मानसे विटळ होय जाय। <verse eid="HEB 12:15"/><verse number="16" style="v" sid="HEB 12:16"/>ओसो नी होय कि काही जन व्यभिचार या एसावन समान अन्यायी होय जु एक बारम खानो बदलीन आपसा पेहलौठा होयनेन पद वेच नाख्य। <verse eid="HEB 12:16"/><verse number="17" style="v" sid="HEB 12:17"/>तुमू जानता होय कि बाद मा जव त्यो बरकत पायो जूवी तो खरो नी गिना गया, आरू आसू पाड़ी पाड़ीन हेरने पर भी मन फिरावनेन मेखे ओको नी मिव्यो।<verse eid="HEB 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18"/>तुमू तो ओको बयड़ा साथे जो धर्‍य जाय सकता होतो, आरू आगठो छे आँधारलो आरू आंझीन साथे। <verse eid="HEB 12:18"/><verse number="19" style="v" sid="HEB 12:19"/>आरू तुरही की ध्वनि, आरू बुलनेवावान ओसो ओवाजान साथे नी आयो, जिनाक सोमवनेवावा ने रावन्या करी कि हिमी हामरे सी आरू वात मा करे। <verse eid="HEB 12:19"/><verse number="20" style="v" sid="HEB 12:20"/>काहकि वो ओको हुकुमन नी सह सके: “यदि काही जनवार भी बयड़ाक धरे तो ओको पर दगड़ा देयो।” <verse eid="HEB 12:20"/><verse number="21" style="v" sid="HEB 12:21"/>आरू वो दर्शन ओसो भयानक होतो कि मूसा ने कयो, “हाव घोणा घाबरायो आरू कापतो छे।”<verse eid="HEB 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22"/>पर तुमू सिय्योनन बयड़ा साथे, आरू जीवता यहोवा–भगवानन नगर, सोरगदूत यरूशलेम न, साथे आरू लाखो सोरगदूत। <verse eid="HEB 12:22"/><verse number="23" style="v" sid="HEB 12:23"/>आरू इनु एकखुळिया न साधारण सभा आरू मंडळी, जिन्दरो नाव सोरगदूत मा लिख्यो छे, आरू आखान न्याय यहोवा–भगवानन साथे आरू सिध्द कर्‍या होया न्यायी की आत्मा। <verse eid="HEB 12:23"/><verse number="24" style="v" sid="HEB 12:24"/>आरू नोवली वाचान मध्यस्थ ईशु आरू छिड़कनेन ओको लुहूय साथे आयो होय जो हाबील न लुहूय छे वारू वात कयता छे।<verse eid="HEB 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25"/>सावधान रवु, आरू ओको कयनेवावा छे मुय नी फेरो, काहकि वो मानसे जव धरती परन चेतावनी देनेवावा छे मुय भाझीन नी वाच सक्या, तो हामु सोरगदूत पर छे चेतावनी देनेवावा छे मुय भाझीन कोसो वाच सकछे। <verse eid="HEB 12:25"/><verse number="26" style="v" sid="HEB 12:26"/>तीन टेहाव तो तेरो ओवाज ने धरती हालाड़ दिदो, पर हिमी त्यो यो प्रतिज्ञा करी छे, “एक बार पछु हाव नी केवल धरती वरना सोरग न भी हालाड़ दीस।” <verse eid="HEB 12:26"/><verse number="27" style="v" sid="HEB 12:27"/>आरू यो वाक्य “एक बार पछु इन वातक प्रगट करता छे कि जो चीजक हालाड़ जाती छे, वो सृजी होयी चीज होयनेन कारण टल जाछे; ताकि जो चीज हाल नी जाती, वो अटल बन रवे।”<verse eid="HEB 12:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28"/>इन कारण हामु इन राज्यम देखीन जो हाल नी सके होय, आरू भक्ति, आरू भय सहित यहोवा–भगवानन ओसी आराधना करू जेरेछे वो खुश होयतो छे। <verse eid="HEB 12:28"/><verse number="29" style="v" sid="HEB 12:29"/>काहकि हामरा यहोवा–भगवान भस्म करनेवावा आगठो छे।<verse eid="HEB 12:29"/></para>
  <chapter eid="HEB 12"/>
  <chapter number="13" style="c" sid="HEB 13"/>
  <para style="s">मसीह जीवन जीवने क निर्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1"/>भाईस लोगहन मा मोंग रये। <verse eid="HEB 13:1"/><verse number="2" style="v" sid="HEB 13:2"/>पाहंनतराय करने नी भूलने, काहकि ओका द्वारा काही मानसे ने अनजाने मा सोरगदूत क विजुत सत्कार कर्‍या छे। <verse eid="HEB 13:2"/><verse number="3" style="v" sid="HEB 13:3"/>कैदीयो की ओसी सुधि लेदी कि मानु ओको साथे तुमू भी कैद होय, आरू जिन्दरे साथे बुरा बर्ताव कर्‍या जाता छे, उनकी भी यो समझीन सुधि लेदा करू कि हामरी भी देह छे।<verse eid="HEB 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4"/>वियाव सब मा विजुत की वात समझी जाय, आरू वियाव बिछौना निष्कलंक रया, काहकि यहोवा–भगवान व्यभिचारी आरू विनलाज्या क न्याय करसे। <verse eid="HEB 13:4"/><verse number="5" style="v" sid="HEB 13:5"/>तुमरा स्वभाव लोभरहित होय, आरू जो तुमरे साथे छे तीनी पर सन्तोष करू काहकि त्यो आप ही कयो छे, “हाव तुखे कदी नी छुड़ीस; आरू नी कदी तुखे त्यागीस।” <verse eid="HEB 13:5"/><verse number="6" style="v" sid="HEB 13:6"/>एरकरीन हामु निडर हईन कयता छे,</para>
  <para style="q1" vid="HEB 13:6">“पोरबु मारो सहायक छे,</para>
  <para style="q2" vid="HEB 13:6">हाव नी घाबराय;</para>
  <para style="q1" vid="HEB 13:6">मानुस मारो काय कर सकता छे।”<verse eid="HEB 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7"/>जो तुमरा ओगवला हुता, आरू जिन्होने तुमूक यहोवा–भगवान क वचन सोमव्या छे, तीनुक स्मरण राखीन; आरू ध्यान छे ओको चाल–चलन क आखरी देखीन ओको विश्वास क गती करू। <verse eid="HEB 13:7"/><verse number="8" style="v" sid="HEB 13:8"/>ईशु मसीह काल आरू आज आरू युगानयुग एक सा छे। <verse eid="HEB 13:8"/><verse number="9" style="v" sid="HEB 13:9"/>हरेक प्रकार क ओसी तोसी शिक्षा छे नी भरमाय जावु, काहकि मन क फोकटन दया छे दृढ रयने भला छे, नी कि उन खाने की चीज छे जिन छे काम राखनेवावा क काही लाभ नी हुयो।<verse eid="HEB 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10"/>हामरी एक ओसी वेदी छे जिना पर छे खाने क हक उन मानसे क नी, जो तम्बू की सेवा करता छे। <verse eid="HEB 13:10"/><verse number="11" style="v" sid="HEB 13:11"/>काहकि जिन ढुरो क लुहूय डाहला पुजारा पाप बलि क करता चुखलोस्थान मा ली जाता छे, उनकी डील छावनी क खयड़े धपाड़ जातो छे। <verse eid="HEB 13:11"/><verse number="12" style="v" sid="HEB 13:12"/>इनी कारण, ईशु ने भी मानसे क आपने ही लुहूय क द्वारा चुखलो करने क करता फाटक क बाहरता दुःख झेलीयो। <verse eid="HEB 13:12"/><verse number="13" style="v" sid="HEB 13:13"/>एरकरीन आवु, उना की निंदा आपने ऊपर लेदा होया छावनी क बाहरता ओका साथे निकवीन चाले। <verse eid="HEB 13:13"/><verse number="14" style="v" sid="HEB 13:14"/>काहकि याहा हामरा काही स्थाई नगर नी, वरना हामु एक आवनेवाळा नगर की हेर मा छे। <verse eid="HEB 13:14"/><verse number="15" style="v" sid="HEB 13:15"/>एरकरीन हामु ओका द्वारा बढ़ाईरूपी बलिदान, मतलब उन हुटड़ा क फोव जो ओका नाव क पछतायो करता छे, यहोवा–भगवान क सर्वदा चढ़ाया करे। <verse eid="HEB 13:15"/><verse number="16" style="v" sid="HEB 13:16"/>भालाई करने आरू मोंग देखाड़ने नी भूल, काहकि यहोवा–भगवान ओसी बलिदान छे खुश होयतो छे।<verse eid="HEB 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17"/>आपने अगळवानिया की हुकुम मानो आरू ओको हको तळे रयो, काहकि वो ओको समान तुमरे जीव क करता जागता रया छे जिन्हे लिखने देनो पड़से; वो यो काम खुशी छे करू, नी कि छेवी हवा ली लेदी, काहकि इनीये दशा मा तुमूक काही लाभ नी।<verse eid="HEB 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18"/>हामरे करता प्रार्थना करता रयो, काहकि हामु विश्वास छे कि हामरा मन चुखो छे: आरू हामु सब वात मा वारली चाल चालने जूवता छे। <verse eid="HEB 13:18"/><verse number="19" style="v" sid="HEB 13:19"/>प्रार्थना करने क करता हाव तुमू आरू भी समझता छे कि हाव शीघ्र तुमरे साथे पछु आय सकु।<verse eid="HEB 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20"/>हिमी शांतीदाता यहोवा–भगवान, जो हामरा पोरबु ईशु क जो गाडरा क महान राखवावी छे अमरकाय वाचा क लुहूय क गुण छे मरला होया मा छे जीवाड़ीन ली आश।<verse eid="HEB 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 13:21"/>तुमू हर एक वारली वात मा सिध्द करू, जिनासे तुमू ओकी मरजी पूरी करू, आरू जो काही ओको भाता छे ओको ईशु मसीह क द्वारा हामु मा पैदा करू। ओकी की महिमा युगानयुग होयती रयी। आमेन।<verse eid="HEB 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22"/>हे भाईस, हाव तुमू छे रावन्या करता छे कि इनीये शिक्षा की वात क सह लोम, काहकि हाव ने तुमूक घोणा संक्षेप मा लिख्यो छे। <verse eid="HEB 13:22"/><verse number="23" style="v" sid="HEB 13:23"/>तुमू यो ज्ञात होय कि तीमुथियुस, हामरा भाईस छुट गया छे आरू यदि वो शीघ्र आय गया तो हाव ओका साथे तुमू छे भेंट करीस।<verse eid="HEB 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24"/>आपने सब अगळवानिया आरू सब चुखलो मानसे क नमस्कार कोवु। इतालिया वाळा उको सयाळा कहे।<verse eid="HEB 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25"/>तुमू सब पर फोकटन दया हुयसे रयो। आमेन।<verse eid="HEB 13:25"/></para>
  <chapter eid="HEB 13"/>
</usx>
