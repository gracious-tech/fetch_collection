<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1TH" style="id">– Dhankavi</book>
  <para style="h">1 थिस्सलुनीकियो</para>
  <para style="toc3">1 थिस्सलुनीकियो</para>
  <para style="toc2">1 थिस्सलुनीकियो</para>
  <para style="toc1">थिस्सलुनीकियो क पौलुसन पेहली पत्री</para>
  <para style="mt2">थिस्सलुनीकियो को पौलुस कि पेहली पत्री</para>
  <para style="mt1">थिस्सलुनीकियो क पौलुसन पेहली पत्री</para>
  <para style="imt">परिचय</para>
  <para style="ip">थिस्सलुनीकियो की यो पेहली पत्री प्रेरित पौलुस ने <char style="xt"><ref loc="1TH 1:1">1:1</ref></char> लिखी होती पेहल चुखलो शास्त्र क भाग बनी आरू मसीह क पैदा क 51 साल बाद लिखी गयी। आरू जव पौलुस ने यो पत्री लिखी तव वो कुरन्थियो शहर मा हुता थिस्सलुनीकियो की मंडळी की जी सकोश वो पत्री लिखता छे वो दुसरी मिशनरी याहा क टेहाव स्थापना करी ओसो देखाड्या गया छे प्रेरितन क काम क पत्री मा ओसो देखाड्या छे कि यो मंडळी यहूदि यो आरू गैरयहुदी कि बनी होती। <char style="xt"><ref loc="ACT 17:1-10">प्रेरितन 17:1-10</ref></char></para>
  <para style="ip">थिस्सलुनीकियो मंडळी इनीये मंडळी की स्थापना करने क बाद पौलुस थिस्सलुनीकियो मा जादा दाहड़ा तक नी रया देख्या एरकरीन पत्री क तीनुक विश्वासिया क जुर देने क करता इनीये पत्री मा घोणा वेश्या की चर्चा करी गयी छे जोसो की मसीह मा कोसो जीवन रहनो जूवे मसीह क दिसरा पछो आवने क बारा मा ही लिखता छे। शायद एरकरीन थिस्सलुनीकियो मंडळी मा रोवनेवावा विश्वासिया क इनीये विषय मा सोमवने मरजी होती पौलुस इनीये विषय क द्वारा मतलब ईशु क दिसरा आवनो क बारा मा लिखीन इनुक ओसो जीवन जीवने क करता बढ़ावु करता छे जीनुसे यहोवा–भगवान संतुष्ट होय। <char style="xt"><ref loc="1TH 5:6-8">5:6-8</ref></char></para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. मंडळी क नमस्कार क धन्यवाद। <char style="ior"><ref loc="1TH 1">1</ref></char></para>
  <para style="io1">2. पौलुस आपने काम क बारा मा आरू तीमोथी मा जो बातमी लावी होती ओको बारा मा चर्चा करता छे। <char style="ior"><ref loc="1TH 2-3">2–3</ref></char></para>
  <para style="io1">3. ईशु क दिसरा सर आवनो की तीयारी करने क करता मसीह मा कोसो जीवन जीवने जूवे। <char style="ior"><ref loc="1TH 4:1-5:15">4:1–5:15</ref></char></para>
  <para style="io1">4. पौलुस क मंडळी क नमस्कार आरू मडली क हरेक ने इनीये पत्री भननो जूवे इनीये विषय क बारा मा पौलुस की रावन्या। <char style="ior"><ref loc="1TH 5:16-28">5:16-28</ref></char></para>
  <chapter number="1" style="c" sid="1TH 1"/>
  <para style="s">नमस्कार</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 17:1">प्रेरितन 17:1</ref>
      </char>
    </note>पौलुस आरू सिलवानुस आरू तीमुथियुस की आरू छे थिस्सलुनीकियों की मंडळी क नाव,</para>
  <para style="pi" vid="1TH 1:1">जो यहोवा–भगवान बास आरू पोरबु ईशु मसीह मा छे:</para>
  <para style="p" vid="1TH 1:1">फुकट दया आरू शांती तुमू मिवती रये।<verse eid="1TH 1:1"/></para>
  <para style="s">थिस्सलुनीकियो क जीवन आरू विश्वास</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2"/>हामु आपसी प्रार्थना मा तुमू स्मरण करता आरू सदा तुमू सब क विषय मा यहोवा–भगवान क धन्यवाद करता छे, <verse eid="1TH 1:2"/><verse number="3" style="v" sid="1TH 1:3"/>आरू आपने यहोवा–भगवान आरू बास क सामने तुमरे विश्वास क काम, आरू मोंग क मेहनत, आरू हामरे पोरबु ईशु मसीह मा आश करी धीरता क लागातार स्मरण करता छे। <verse eid="1TH 1:3"/><verse number="4" style="v" sid="1TH 1:4"/>हे भाईस, आरू बहनीस यहोवा–भगवान क मोंगावु मानसे हामु जानता छे कि तुमू त्योन्या होया होय। <verse eid="1TH 1:4"/><verse number="5" style="v" sid="1TH 1:5"/>काहकि आमरो खुश खबर तुमरे साथे नी केवल ओवाज मात्र ही मा वरना शक्ति, आरू चुखलो आत्मा मा, आरू सच्चाई क पूरी छाचो क साथे पुचाड्या छे; जोसो तुमू जानता होय कि, हामु तुमरे करता तुमरे वीच मा कोसो बन गयो होतो। <verse eid="1TH 1:5"/><verse number="6" style="v" sid="1TH 1:6"/><note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="ACT 17:5-9">प्रेरितन 17:5-9</ref></char></note>तुमू मोट तकलीद मा तौभी, चुखलो आत्मा क खुश क साथे वचन क मानीन हामरी आरू पोरबु कि सी चाल चालने लाग्या। <verse eid="1TH 1:6"/><verse number="7" style="v" sid="1TH 1:7"/>याहा तक मकिदुनिया आरू अखाया क सब विश्वासीया क करता तुमू विजुत राखिया। <verse eid="1TH 1:7"/><verse number="8" style="v" sid="1TH 1:8"/>काहकि तुमरे याहा छे नी केवल मकिदुनिया आरू अखाया मा पोरबु क वचन सोमवाय गयो पर तुमरे विश्वास कि जो यहोवा–भगवान पर छे हर जगमा ओसी चर्चा पछु गयी छे कि हामु कयनो कि जरूरत हिय नी। <verse eid="1TH 1:8"/><verse number="9" style="v" sid="1TH 1:9"/>काहकि वो आप ही हामरे विषय मा कयतो छे कि तुमरे साथे आमरो आवने कोसो हुयो; आरू तुमू कोसो मुर्ती छे कोसो यहोवा–भगवान कि आरू छे पछु ताकि जीवता आरू सच्चा यहोवा–भगवान कि सेवा करू, <verse eid="1TH 1:9"/><verse number="10" style="v" sid="1TH 1:10"/>आरू ओको पोर्‍य क सोरग पर छे आवने कि वाट जूवता रवु जो उना मरलो हुयो मा छे जीवाड्या मतलब ईशु की, जो हामु आवनेवाळा प्रकोप छे वाचाड़े।<verse eid="1TH 1:10"/></para>
  <chapter eid="1TH 1"/>
  <chapter number="2" style="c" sid="1TH 2"/>
  <para style="s">थिस्सलुनीकियो मा पौलुस क खबर काम</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1"/>हे भाईस, आरू बहनीस तुमू आप ही जानता होय कि हामरे तुमरे साथे आवने व्यर्थ नी हुयो, <verse eid="1TH 2:1"/><verse number="2" style="v" sid="1TH 2:2"/><note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="ACT 16:19-24">प्रेरितन 16:19-24</ref>; </char><char style="xt" closed="false"><ref loc="ACT 17:1-9">प्रेरितन 17:1-9</ref></char></note>वरना तुमू आप ही जानता होय क तुमरे साथे आवने पेहल फिलिप्पी गाव मा दुःख हाकलिया आरू झगड़ो करावनो सहने पर भी हामरे यहोवा–भगवान ने ओसो साहस दिदो, कि हामु यहोवा–भगवान क खुश खबर भारी विरोधी क हुयसे हुयो भी तुमू सोमवाया। <verse eid="1TH 2:2"/><verse number="3" style="v" sid="1TH 2:3"/>काहकि हामरा शिक्षा नी भ्रम छे आरू नी विटळ शिक्षा छे, आरू नी चालाक क साथे छे। <verse eid="1TH 2:3"/><verse number="4" style="v" sid="1TH 2:4"/>पर जोसो यहोवा–भगवान ने हामु योग्य ठेराया खुश खबर सौप दिया, हामु ओसो ही कयो करता छे, आरू इनीये मा मानुस क नी, पुन यहोवा–भगवान क, जो हामरे मानो क हेरता छे, खुश करता छे। <verse eid="1TH 2:4"/><verse number="5" style="v" sid="1TH 2:5"/>काहकि तुमू जानता होय कि हामु नी तो कदी चापलूसी करी वात कर्‍या करता हुता आरू नी लोभ क करता वयाड़नु करता हुता, यहोवा–भगवान गवा छे। <verse eid="1TH 2:5"/><verse number="6" style="v" sid="1TH 2:6"/>तभी हामु मानुस छे विजुत नी जूवता हुता, आरू नी तुमू छे, नी आरू काही छे। <verse eid="1TH 2:6"/><verse number="7" style="v" sid="1TH 2:7"/>आरू यद्यपी हामु मसीह क प्रेरित हुयने क कारण तुमू पर बोझ नाखता सकता हुता। पुन जिना तरह आश आपने पोर्‍य क पालन पोषण करती छे। ओसो ही हामु ने भी तुमरे विच मा रयन मोटी कमरता देखाय छे। <verse eid="1TH 2:7"/><verse number="8" style="v" sid="1TH 2:8"/>आरू ओसो ही हामु तुमरी लालस करता होया ने केवल यहोवा–भगवान क खुश खबर पर आपसा–आपसा हामु तुमू मोंगावु करता छे, भी तुमू देने क तीयार हुता एरकरीन कि तुमू हामरे मोंगावु होय गया हुता।<verse eid="1TH 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 2:9"/>काहकी, हे भाईस, आरू बहनीस तुमू हामरे मेहनत आरू कष्ट क स्मरण राखता होय; हामु ने एरकरीन रात दहाडू काम धंदा करता होया, तुमू मा यहोवा–भगवान क खुश खबर कर्‍या कि तुमू छे काही पर भार नी होय।<verse eid="1TH 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 2:10"/>तुमू आप ही गवा होय, आरू यहोवा–भगवान भी ओसो छे, कि तुमू विश्वास क विच मा आमरो व्यवहार कोसो चुखलो आरू सच छे आरू ने निर्दोष रया। <verse eid="1TH 2:10"/><verse number="11" style="v" sid="1TH 2:11"/>तुमू जानता होय कि जोसो आश बास आपने पोर्‍य क साथे व्यवहार करता छे। ओसो ही हामु भी तुमू मा छे हर एक क करता छे। <verse eid="1TH 2:11"/><verse number="12" style="v" sid="1TH 2:12"/>शिक्षा करता आरू शांती देता, आरू समझता हुता कि, तुमरो चाल चलन यहोवा–भगवान क योग्य होय। जो तुमू आपने राज आरू महिमा मा आरू सहभागी हुयने क करीन बुलाया छे।<verse eid="1TH 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13"/>एरकरीन हामु भी यहोवा–भगवान क धन्यवाद निन्तर करता छे की जव हामरे द्वारा यहोवा–भगवान क खुश खबर क वचन तुमरे साथे पुचाड्या तो तुमू ने ओको मानुस क नी पुन यहोवा–भगवान क वचन समझीन आरू सचमुच यो ओसो ही छे। मान्य कर्‍या; आरू वो तुमू विश्वासीया मा जो विश्वास राखता होय, शक्तिशाली छे। <verse eid="1TH 2:13"/><verse number="14" style="v" sid="1TH 2:14"/><note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="ACT 17:5">प्रेरितन 17:5</ref></char></note>एरकरीन तुमू हे भाईस, आरू बहनीस यहोवा–भगवान कि उन मंडळी कि सी चाल चालने लाग्या यहूदि या मा मसीह ईशु मा छे, काहकि तुमू हाव भी आपने मानुस छे ओसो ही छल देखता जोसो त्या यहूदि या छे देखता हुता। <verse eid="1TH 2:14"/><verse number="15" style="v" sid="1TH 2:15"/><note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="ACT 9:23">प्रेरितन 9:23</ref>,<ref loc="ACT 9:29">29</ref>; <ref loc="ACT 13:45">13:45</ref>,<ref loc="ACT 13:50">50</ref>; <ref loc="ACT 14:2">14:2</ref>,<ref loc="ACT 14:5">5</ref>,<ref loc="ACT 14:19">19</ref>; <ref loc="ACT 17:5">17:5</ref>,<ref loc="ACT 17:13">13</ref>; <ref loc="ACT 18:12">18:12</ref></char></note>जिन्होने पोरबु ईशु क आरू भविष्यवक्ता क भी मार नाख्यो आरू हामु क सताया। आरू यहोवा–भगवान उनछे खुश नी, आरू वो सब मानुस क विरोध करता छे। <verse eid="1TH 2:15"/><verse number="16" style="v" sid="1TH 2:16"/>आरू वो गैरयहुदी यो छे ओको यहोवा–भगवान क उध्दार क खुश खबर सोमवाता क करता हामु रूकता छे कि सदा तुमरा पाप क नपुआ भरता होय। पर उन पर यहोवा–भगवान क भयानक प्रकोप आय पुचाड़ छे।<verse eid="1TH 2:16"/></para>
  <para style="s">पौलुस क दुय कावा मंडळी छे मिवने की लालोच</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17"/>हे भाईस, जव हामु थोडी देर क करता, मन मा नी वरना प्रगट मा तुमू छे अलग होय गया हुता, तो हामु ने मोटी लालसा क साथे तुमरे मुय देखने क करता आरू भी सवटो यत्न कर्‍या। <verse eid="1TH 2:17"/><verse number="18" style="v" sid="1TH 2:18"/>एरकरीन हामु ने मतलब मखे पौलुस ने एक बार नी वरना दुय बार तुमरे साथे आवने जूवे, पुन शैतान हामु रूक रयो। <verse eid="1TH 2:18"/><verse number="19" style="v" sid="1TH 2:19"/>भला हामरी आश या खुश या बढ़ाई क मुकूट काय छे? काय हामरे पोरबु ईशु क सम्मुख ओका आवने क टेहाव तुमू ही नी होय छे? <verse eid="1TH 2:19"/><verse number="20" style="v" sid="1TH 2:20"/>हामरी बढ़ाई आरू खुश तुमू ही होय।<verse eid="1TH 2:20"/></para>
  <chapter eid="1TH 2"/>
  <chapter number="3" style="c" sid="1TH 3"/>
  <para style="s">तीमुथियुस क मुकल्यो जाने</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 17:15">प्रेरितन 17:15</ref>
      </char>
    </note>एरकरीन जव हामु छे आरू नी रया गया, तो हामु ने यो ठेराया कि एथेंस शहर मा एखलो रया जाय। <verse eid="1TH 3:1"/><verse number="2" style="v" sid="1TH 3:2"/>आरू हामु ने तीमुथियुस क, जो मसीह क खुश खबर मा आमरो भाईस आरू यहोवा–भगवान क सेवक छे, एरकरीन मुकल्या कि वो तुमू स्थिर कर्‍या आरू तुमरे विश्वास क विषय मा तुमू समझाय। <verse eid="1TH 3:2"/><verse number="3" style="v" sid="1TH 3:3"/>कि काही इन तकलीद क कारण डगमगा नी जाय। काहकि तुमू आप जानता होय कि हामु यो सताव यहोवा–भगवान की मरजी छे ही हामरे करता छे। <verse eid="1TH 3:3"/><verse number="4" style="v" sid="1TH 3:4"/>काहकि पेहल ही जव हामु तुमरे याहा हुता तो तुमू छे कयो करता हुता कि हामु तकलीद झेलनो पड़्यो, आरू ओसो ही हुयो छे, जोसो कि तुमू जानता भी होय। <verse eid="1TH 3:4"/><verse number="5" style="v" sid="1TH 3:5"/>इनीये कारण जव मखे छे आरू नी रया गया, तो तुमरे विश्वास क हाल जानने क करता तीमुथियुस मुकल्या, कि काही ओसो नी होय कि परीक्षा करनेवावा ने तुमरी परीक्षा करी होय, आरू हामरा मेहनत व्यर्थ होय गयो होयस।<verse eid="1TH 3:5"/></para>
  <para style="s">तीमुथियुस द्वारा खबर मिवने</para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6"/>पर हिमी तीमुथियुस ने जो तुमरे साथे छे हामरे याहा आयो छे, तुमरे विश्वास खबर आरू मोंग क खबर सोमवाया आरू इनीये वात क भी सोमवाया कि तुमू सदा प्रेम क साथे हामु स्मरण करता होय, आरू हामरे देखने कि लालस राखता होय, जोसो हामु भी तुमू देखने की। <verse eid="1TH 3:6"/><verse number="7" style="v" sid="1TH 3:7"/>एरकरीन हे भाईस, हामु ने आपने सब दुःख क आरू तकलीद मा तुमरे विश्वास छे तुमरे विषय मा बढ़ावु मिवी। <verse eid="1TH 3:7"/><verse number="8" style="v" sid="1TH 3:8"/>काहकि हिमी यदि तुमू पोरबु मा स्थिर रया तो हामु जीवता छे। <verse eid="1TH 3:8"/><verse number="9" style="v" sid="1TH 3:9"/>आरू जोसो हामु खुश तुमरे कारण आपने यहोवा–भगवान क सामने छे, ओका बदले तुमरे विषय मा हामु काही रीति छे यहोवा–भगवान क धन्यवाद कर्‍या? <verse eid="1TH 3:9"/><verse number="10" style="v" sid="1TH 3:10"/>हामु रात दहाडू खुप ही प्रार्थना करता रयता छे कि तुमरे आमने सामने देखने आरू तुमरे विश्वास कि घटी पुरी कर्‍या।<verse eid="1TH 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11"/>हिमी हामरा यहोवा–भगवान आरू बास आप ही आरू हामरा पोरबु ईशु, तुमरे याहा आवने मा हामरी रस्तो उघाड्यो छे। <verse eid="1TH 3:11"/><verse number="12" style="v" sid="1TH 3:12"/>आरू पोरबु ओसो कर्‍यो कि जोसो हामु तुमू छे मोंग राखता छे, ओसो हिय तुमरो प्रेम भी आपस मा आरू सब मानुस क साथे बढ़े, आरू बढ़ती करता जाय। <verse eid="1TH 3:12"/><verse number="13" style="v" sid="1TH 3:13"/>ताकि वो तुमरो मनो क ओसो स्थिर कर्‍यो कि जव हामु हामरा पोरबु ईशु आपने सब चुखलो मानसे क साथे आयो, तो आप हामरे यहोवा–भगवान आरू बास क सामने निर्दोष ठराय।<verse eid="1TH 3:13"/></para>
  <chapter eid="1TH 3"/>
  <chapter number="4" style="c" sid="1TH 4"/>
  <para style="s">यहोवा–भगवान क खुश करनेवावा जीवन</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1"/>एरकरीन हे भाईस, आरू बहनीस हामु तुमू छे रावन्या करता छे आरू तुमू पोरबु ईशु मा समझाता छे कि जोसो तुमू नी हामु छे योग्य चाल चालने आरू यहोवा–भगवान क खुश करने सिख्या छे, आरू जोसो तुमू चालता भी होय, ओसो ही आरू भी बढ़तो जाय। <verse eid="1TH 4:1"/><verse number="2" style="v" sid="1TH 4:2"/>काहकि तुमू जानता होय कि हामु नी पोरबु ईशु कि आरू छे तुमू कुन कुन सी शिक्षा आपी। <verse eid="1TH 4:2"/><verse number="3" style="v" sid="1TH 4:3"/>काहकि यहोवा–भगवान कि मरजी यो छे कि तुमू चुखलो बन्या; आरू व्यभिचार छे वाच रया, <verse eid="1TH 4:3"/><verse number="4" style="v" sid="1TH 4:4"/>आरू तुमू मा छे हर एक चुखला आरू विजुत क साथे आपने बायर क व्यवहार करनो जूवे। <verse eid="1TH 4:4"/><verse number="5" style="v" sid="1TH 4:5"/>आरू यो काम लालोच छे नी, आरू नी आरू नी उन जाति क समझ जो यहोवा–भगवान क नी जानता <verse eid="1TH 4:5"/><verse number="6" style="v" sid="1TH 4:6"/>आरू ची वात मे कयो वो भाईस्योक नी ठगनो आरू ओका पर यहोवा भगवान सब वातन हिसाब लेनु छे, जोसो कि पेहले से कय रयु होतु। <verse eid="1TH 4:6"/><verse number="7" style="v" sid="1TH 4:7"/>काहकि यहोवा–भगवान ने हामु विटळ जीवने क करता नी, पुन चुखलो हुयने क करता बुलाया छे। <verse eid="1TH 4:7"/><verse number="8" style="v" sid="1TH 4:8"/>इनीये कारण जो इनाक तुच्छ जानता छे वो मानुस क नी पुन यहोवा–भगवान क तुच्छ जानता छे, जो आपसा चुखलो आत्मा तुमू मा देता छे।<verse eid="1TH 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9"/>पुन भाईचारे कि प्रेम क विषय मा यो छाची नी कि हाव तुमरे साथे काही लिख्यो काहकि आपस मा मोंग राखने तुमू ने आप ही यहोवा–भगवान छे सिख्या छे। <verse eid="1TH 4:9"/><verse number="10" style="v" sid="1TH 4:10"/>आरू सब मकिदुनिया क सब भाईस क साथे प्रेम करता भी होय। पुन हे भाईस, आरू बहनीस हामु तुमू समझता छे कि आरू भी बढ़ता जाय। <verse eid="1TH 4:10"/><verse number="11" style="v" sid="1TH 4:11"/>आरू जोसो हामु तुमू क हुकुम देदी छे, ओसो ही त्योपचाप रयने आरू आपनो–आपनो कामाकाज करने आरू आपने–आपने हात छे कमायने क कोशिष करू। <verse eid="1TH 4:11"/><verse number="12" style="v" sid="1TH 4:12"/>ताकि बाहरतावावा छे विजुत हासिल करी आरू तुमू काही समान कि घटी नी होय।<verse eid="1TH 4:12"/></para>
  <para style="s">ईशु क पोछो आवने</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13"/>हे भाईस, आरू बहनीस हामु नी जानता कि तुमू ओको विषय मा जो मरला छे, विनअकलिया रयो; ओसो नी होय कि तुमू दिसरा क सामने शोक कर्‍या जीने आश नी। <verse eid="1TH 4:13"/><verse number="14" style="v" sid="1TH 4:14"/>काहकि यदि हामु विश्वास करता छे कि ईशु मरला आरू जीवीन भी उठाय, तो ओसो ही यहोवा–भगवान तीनुक भी जो ईशु मा मरला गया छे, तीनी क साथे ली आवसे। <verse eid="1TH 4:14"/><verse number="15" style="v" sid="1TH 4:15"/><note caller="+" style="x"><char style="xo" closed="false">4:15 </char><char style="xt" closed="false"><ref loc="1CO 15:51">1 कुरन्थियो 15:51</ref>,<ref loc="1CO 15:52">52</ref></char></note>काहकि हामु पोरबु क वचन क लारे तुमू छे यो कयता छे कि हामु जो जीवता छे आरू पोरबु क आवने तक वाच रये, सुया होया छे कदी अगो नी बडछे। <verse eid="1TH 4:15"/><verse number="16" style="v" sid="1TH 4:16"/>काहकि पोरबु आप ही सोरग छे उतरसे; उना टेहाव ललकार, आरू प्रधान क ओवाज सोमवाय देसे, आरू यहोवा–भगवान कि भेहरी वाजाड़ी जाछे; आरू जो मसीह मा मरला छे, वो पेहल जीवन उठसे। <verse eid="1TH 4:16"/><verse number="17" style="v" sid="1TH 4:17"/>तव हामु जो जीवता आरू वाचा रोवछे ओको साथे वादवा पर उठाय लेदा जाछे कि हवा मा पोरबु छे मिव्यो; आरू इनी रीति छे हामु सदा पोरबु क साथे रोवछे। <verse eid="1TH 4:17"/><verse number="18" style="v" sid="1TH 4:18"/>इनीये प्रकार इन वात छे एक दिसरा क बढ़ावु दिया करो।<verse eid="1TH 4:18"/></para>
  <chapter eid="1TH 4"/>
  <chapter number="5" style="c" sid="1TH 5"/>
  <para style="s">ईशु पोछो आवने क करता तियार रवछे</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1"/>पर हे भाईस, आरू बहनीस इनाक योजना नी की टेहावो आरू काळो विषयमा तुमरे साथे काही लिख्यो जाछे। <verse eid="1TH 5:1"/><verse number="2" style="v" sid="1TH 5:2"/><note caller="+" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="MAT 24:43">मत्ती 24:43</ref>; <ref loc="LUK 12:39">लूका 12:39</ref>; <ref loc="2PE 3:10">2 पतरस 3:10</ref></char></note>काहकि तुमू आप ठीक जानता होय कि जोसो रात क त्योंटा आवता छे, ओसो ही पोरबु क दहाडू आवनेवाळो छे। <verse eid="1TH 5:2"/><verse number="3" style="v" sid="1TH 5:3"/>जव मानसे कयता होयछे, “कुशल छे, आरू काही भय नी, तो उन पर एक एक विनाश आवसे, पड़से जिना प्रकार भारीस पर पीड़ा, आरू वो काही रीति छे नी वाचछे।” <verse eid="1TH 5:3"/><verse number="4" style="v" sid="1TH 5:4"/>पर हे भाईस, आरू बहनीस तुमू तो आंधारला मा नी होय कि वो दहाडू तुमू पर त्योंटा क समान आय पड्यो। <verse eid="1TH 5:4"/><verse number="5" style="v" sid="1TH 5:5"/>काहकि तुमू सब दिवा की अवलियाद आरू दहाडू कि अवलियाद होय; हामु नी रात क छे, नी आंधारला क छे। <verse eid="1TH 5:5"/><verse number="6" style="v" sid="1TH 5:6"/>एरकरीन हामु दिसरा क समान सुवता नी रया पर जागता आरू सावधान रयो। <verse eid="1TH 5:6"/><verse number="7" style="v" sid="1TH 5:7"/>काहकि जो सुवता छे वो रात ही क सुवता छे, आरू जो नश्या करता हुता छे वो रात ही क मतवावा हुयसे छे। <verse eid="1TH 5:7"/><verse number="8" style="v" sid="1TH 5:8"/><note caller="+" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="EPH 6:13-17">इफिसियो 6:13-17</ref></char></note>पर हामु जो दहाडू क छे, विश्वास आरू मोंग कि झिलम पेहरीन आरू उध्दार कि आश क मुकूट पेहरीन सावधान रया। <verse eid="1TH 5:8"/><verse number="9" style="v" sid="1TH 5:9"/>काहकि यहोवा–भगवान ने हामु रीस क करता नी, पुन एरकरीन ठराय छे कि हामु आपने पोरबु ईशु मसीह क द्वारा उध्दार हासिल कर्‍या। <verse eid="1TH 5:9"/><verse number="10" style="v" sid="1TH 5:10"/>ईशु हामरे करता इनीये कारण मर्‍य कि हामु जुवे जीवता होय जुवे मरला होय, सब मिवीन तीनी क साथे जाय। <verse eid="1TH 5:10"/><verse number="11" style="v" sid="1TH 5:11"/>इनीये कारण एक दिसरा क बढ़ावु दिदा आरू एक दिसरा क बढ़ती क कारण बन्या, जोसो कि तुमू करता भी होय।<verse eid="1TH 5:11"/></para>
  <para style="s">मंडळी क शिक्षा</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12"/>हे भाईस, आरू बहनीस हामु तुमू छे रावन्या करता छे कि जो तुमू मा मेहनत करता छे, आरू मसीह जीवन मा तुमरे अगो छे, आरू तुमू शिक्षा देता छे, ओको सन्मान करो। <verse eid="1TH 5:12"/><verse number="13" style="v" sid="1TH 5:13"/>आरू ओको काम क कारण मोंग क साथे उनको खुश ही विजुत क योग्य समझ। आपस मा मेलमिलाप छे रया।<verse eid="1TH 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 5:14"/>हे भाईस, आरू बहनीस हामु तुमू समझता छे, कि जो उजग्यो नी चालता उनको समझाय, कमजोर, क ढाढंस दुय, निर्बल क संभाली, सब की आरू सहनशीलता देखाय। <verse eid="1TH 5:14"/><verse number="15" style="v" sid="1TH 5:15"/>सावधान! काही छे बुराई क बदल बुराई मा आरू सब छे भी सकी एक दिसरा भलाई करू।<verse eid="1TH 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16"/>सदा खुशी रयो। <verse eid="1TH 5:16"/><verse number="17" style="v" sid="1TH 5:17"/>निरन्तर प्रार्थना मा लागे रया। <verse eid="1TH 5:17"/><verse number="18" style="v" sid="1TH 5:18"/>हर वात मा धन्यवाद करू; काहकि तुमरे करता मसीह ईशु मा यहोवा–भगवान की योही मरजी छे।<verse eid="1TH 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19"/>चुखलो आत्मा क नी उलवु। <verse eid="1TH 5:19"/><verse number="20" style="v" sid="1TH 5:20"/>यहोवा–भगवान की आरू आवनेवाळो संदेश क तुच्छ नी जानु। <verse eid="1TH 5:20"/><verse number="21" style="v" sid="1TH 5:21"/>सब वात क पारखने; जो वारली छे ओको धरने रया। <verse eid="1TH 5:21"/><verse number="22" style="v" sid="1TH 5:22"/>सब प्रकार की बुराई छे वाच रवु।<verse eid="1TH 5:22"/></para>
  <para style="s">बरकत</para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23"/>शांती क यहोवा–भगवान आप ही तुमू पूरी रीति छे चुखलो कर्‍या; आरू तुमरी आत्मा आरू जीव आरू डील हामरे पोरबु ईशु मसीह क आवने तक पुरो पुरो आरू निर्दोष सोरक्षित रया। <verse eid="1TH 5:23"/><verse number="24" style="v" sid="1TH 5:24"/>तुमरे बुलनेवावा विश्वास योग्य छे, आरू वो ओसो ही करसे।<verse eid="1TH 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25"/>हे भाईस, हामरे करता प्रार्थना करू।<verse eid="1TH 5:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26"/>सब भाईस क यहोवा–भगवान प्रेम छे नमस्कार करू।<verse eid="1TH 5:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1TH 5:27"/>हाव तुमू पोरबु की शपथ देता छे कि यो पत्री सब भुरसीया भाईस क भनीन सोमवाय जाय।<verse eid="1TH 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28"/>हामरे पोरबु ईशु मसीह क फोकटन दया तुमू पर हुयसे रया।<verse eid="1TH 5:28"/></para>
  <chapter eid="1TH 5"/>
</usx>
