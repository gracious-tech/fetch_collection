<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">– Dhankavi</book>
  <para style="h">फिलेमोन</para>
  <para style="toc3">फिलेमोन</para>
  <para style="toc2">फिलेमोन</para>
  <para style="toc1">फिलेमोन क पौलुसन पत्री</para>
  <para style="mt2">फिलेमोन को पौलुस कि पत्री</para>
  <para style="mt1">फिलेमोन क पौलुसन पत्री</para>
  <para style="imt">परिचय</para>
  <para style="ip">पर मा होतो, जबकि वो इनाक लिख्या हुता, <char style="xt"><ref loc="PHM 1:1">1:1</ref></char> जेरो मतलब छे कि वो शायद यो रोमन छे लिख रया हुता। कदाम त्यो रोमन मा हुता तो यो ईशु मसीहन जन्मान लग–भग 61 सालन बाद लिख्यो गयो छे, तीन टेहाव छे कि वो कुलुस्सियो लिख्यो होयछे।</para>
  <para style="ip">तीनुक यो पत्री फिलेमोन नाव छे एक शख्स लिख्यो। फिलेमोन मंडळी एक सदस्य आरू भी एक दस क मालिक होतो। पौलुसने ओको लिख्या कि वो आपने गुलाम ओनेसिमुस जु फिलेमोन छे ढास गयो होतो सजा नी होयछे पुछनेन करता। द्वारा रोमन का़नुन क मरनान करता ओनेसिमुस डाल हकी होतो पौलुस प्रेरित तर्क क काम मा लावे आरू फिलेमोन बढ़ावु करनेन करता विश्वास भाईस क रूप मा ओनेसिमुस स्वीकार करतो छे आरू भी पतु चालतु छे कि ओनेसिमुस क पौलुस <char style="xt"><ref loc="PHM 1:13-14">1:13-14</ref></char> क साथे सेवा कि हक देदी।</para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. पौलुस मा फिलेमोन नमस्कार <char style="ior"><ref loc="PHM 1:1-3">1:1-3</ref></char></para>
  <para style="io1">2. ती पौलुस ओनेसिमुस कि आरू छे पूछता छे कि फिलेमोन तेरो एक भाई विश्वासी क रूप मा स्वीकार कर छे। <char style="ior"><ref loc="PHM 1:4-21">1:4-21</ref></char></para>
  <para style="io1">3. पौलुस आपने विचार छे यात्रा आरू बधाई मुकलता छे <char style="ior"><ref loc="PHM 1:22-25">1:22-25</ref></char> कि देखाड़ने सी खत्म हुयो।</para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="s">अभिवाद</para>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />पौलुस कि आरू छे जो मसीह ईशु क कैदी छे,</para>
  <para style="p" vid="PHM 1:1">आरू भाईसो तीमुथियुस कि आरू छे हामरे मोंगावु सहकर्मी फिलेमोन।<verse eid="PHM 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHM 1:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:2 </char>
      <char style="xt" closed="false">
        <ref loc="COL 4:17">कुलुस्सियो 4:17</ref>
      </char>
    </note>आरू बहिनीस अफफिया, आरू हामरे साथे योध्दा अर्खिप्पुस आरू फिलेमोन क घर कि मंडळी क नाव।<verse eid="PHM 1:2" /></para>
  <para style="s">मसीह मा आत्मिक बरकत</para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3" />हामरे बास यहोवा–भगवान ईशु मसीह कि आरू छे फोकटन दया आरू शांती तुमूक मिवती रया।<verse eid="PHM 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />हाव सदा यहोवा–भगवान कि धन्यवाद करता छे, आरू आपसी प्रार्थना मा भी तुखे स्मरण करता छे। <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />काहकि हाव तारे उना मोंग आरू विश्वास कि चर्चा सोमवता छे, जो सब चुखलो मानसे क साथे आरू पोरबु ईशु पर छे। <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />हाव प्रार्थना करता छे कि विश्वास मा तारो सहभागी हुयने, तुमरी सारी भलाई कि उळखने मा, मसीह क करता शक्तिशाली होय। <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />काहकि हे भाईसो, मखे तारे मोंग छे खुप खुश आरू शांती मिवती छे, एरकरीन कि तारे द्वारा चुखलो मानसे क खुश होय गया।<verse eid="PHM 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />एरकरीन यद्यपि मखे मसीह मा मोटो साहस छे कि जो वात ठीक छे, ओकी हुकुम तुखे देसे। <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />तवभी मखे डाहला पौलुस क जो हिमी मसीह ईशु क करता कैदी छे यो आरू भी भला जान पड़्या कि मोंग छे विनती करू। <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" /><note caller="+" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="COL 4:9">कुलुस्सियो 4:9</ref></char></note>हाव तुमरा पोर्‍या उनेसिमुस क करता, जो मखे छे मारी कैद मा जनमछे, तुखे छे विनती करता छे।<verse eid="PHM 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PHM 1:11" />वो तो पहेल तारे काही काम क नी हुता, पर हिमी तारे आरू मारे दुयू क मोटा काम क छे।<verse eid="PHM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12" />तीनी क मतलब जो मारे डील क तुकड़ा छे हाव ने तारे साथे पोछु आप देदु। <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />तीनाक हाव आपने ही साथे राखने जुवता हुता कि वो तारी आरू छे इनीये कैद मा जो खुश खबर क कारण छे मारी सेवा करे। <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />पुन हाव ने तारी मरजी विना काही भी करने नी जूवे, कि तारी यो किरपा दबाव छे नी पर खुशी छे होयती।<verse eid="PHM 1:14" /></para>
  <para style="s">पौलुस की प्रार्थना</para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15" />काहकि काय जाने वो तुखे छे काही दहाड़ा तक क करता इना कारण अलग होया कि अमरकाय तारे निकट रया। <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />पुन हिमी छे दास कि तरह नी वरना दास छे भी वारू मतलब भाईस क समान रयो जो मारो तो विशेष मोंगावु छे हिय, पर हिमी डील मा आरू पोरबु मा भी, तारे भी विशेष मोंगावु होय।<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />शेवली कावा यदि तु मखे आपनो सहभागी समजता छे तो उको इनीये प्रकार मान्य कर जोसो मखे। <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />यदि त्यो तारी काही अन्याय करी छे, या उना पर तारो काही आवतो छे, तो मारे नाव पर लिख लेय। <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />हाव पौलुस क आपने हात छे लिखता छे कि हाव आप भर दिस; आरू इनान कयनो कि काही जरूरत नी कि मारो कर्ज जो तुखे पर छे वो तु ही छे। <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />हे भाईस, यो खुश मखे पोरबु मा तारी आरू छे मिव्यो। मसीह मा मारो जीवन क हरो भरो कर दे।<verse eid="PHM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21" />हाव तारे हुकुमकारी हुयने क विश्वास राख्यो तुखे लिखता छे, आरू यो जानता छे कि जो काही हाव कयता छे तु तीना सी काही बढ़ीन करसे। <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />आरू यो भी कि मारे करता ठरने कि धरती तीयार राख। मखे आश छे कि तुमरी प्रार्थना क द्वारा हाव तुमू दे दिया जाईस।<verse eid="PHM 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:23 </char>
      <char style="xt" closed="false">
        <ref loc="COL 1:7">कुलुस्सियो 1:7</ref>; <ref loc="COL 4:12">4:12</ref></char>
    </note>इपफ्रास, जो मसीह ईशु मा मारे साथे कैदी छे। <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" /><note caller="+" style="x"><char style="xo" closed="false">1:24 </char><char style="xt" closed="false"><ref loc="ACT 12:12">प्रेरितन 12:12</ref>,<ref loc="ACT 12:25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref>; <ref loc="COL 4:10">कुलुस्सियो 4:10</ref> </char><char style="xt" closed="false"><ref loc="ACT 19:29">प्रेरितन 19:29</ref>; <ref loc="ACT 27:2">27:2</ref>; <ref loc="COL 4:10">कुलुस्सियो 4:10</ref> </char><char style="xt" closed="false"><ref loc="COL 4:14">कुलुस्सियो 4:14</ref>; <ref loc="2TI 4:10">2 तीमुथियुस 4:10</ref>; </char><char style="xt" closed="false"><ref loc="COL 4:14">कुलुस्सियो 4:14</ref>; <ref loc="2TI 4:11">2 तीमुथियुस 4:11</ref></char></note>आरू मरकुस आरू अरिस्तर्खुसक आरू देमास आरू लूका जो मारे सहकर्मी छे, तीदरो तुखे नमस्कार।<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />हामरे पोरबु ईशु मसीह क फोकटन दया तुमरी आत्मा पर होयतो रये। आमेन।<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>