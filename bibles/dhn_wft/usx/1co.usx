<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CO" style="id">– Dhankavi</book>
  <para style="h">1 कुरन्थियो</para>
  <para style="toc3">1 कुरन्थियो</para>
  <para style="toc2">1 कुरन्थियो</para>
  <para style="toc1">कुरन्थियो क पौलुसन पेहली पत्री</para>
  <para style="mt2">कुरन्थियो को पौलुस कि पेहली पत्री</para>
  <para style="mt1">कुरन्थियो क पौलुसन पेहली पत्री</para>
  <para style="imt">परिचय</para>
  <para style="ip">प्रेरित पौलुस ने यो पत्री ईशु क पैदा क 55 साल बाद लिखा <char style="xt"><ref loc="1CO 1:1">1:1</ref></char> पौलुस ने कुरन्थियो क जो दुय पत्री लिखी उनमा छे यो पेहली पत्री छे। पौलुस की मरजी होती की यो मकिदुनिया जाछे वो जा क पेहल मकिदुनिया जाछे जाता टेहाव आरू पछो आवने टेहाव कुरन्थियो छे मुवाकात करसे मकिदुनिया की यात्रा क पेहल त्यो यो पत्री लिख्यो, तव वो ओको डेरा इफीसुस शहर मा हुता। <char style="xt"><ref loc="1CO 16:5-9">16:5-9</ref></char> पौलुस क कुरन्थियो क मंडळी मा जो अलग अलग समस्या चाल रयी हुती जो रीपोट ओको मिल्यो हुता इनीये रिपोट क जवाब देने क करता पौलुस ने यो पत्री लिखा कुरन्थियो शहर लैगीक क अनैतिकता, काम वासना व्यभिचार क जोसो काम लैगीक वासना क बारा मा परचार हुता एरकरीन यो स्वभाविक ही हुता की ओसी समस्या मंडळी मा भी भरायने कर्‍या। पेहली कुरन्थियो की पत्री मा मोंग विषय मा जो सुप्रसिध्द पाठ छे ओका भी समावेश छे। <char style="xt"><ref loc="1CO 13">13</ref></char></para>
  <para style="is">रूप रेखा</para>
  <para style="io1">1. पौलुस क कुरिन्थिवासियो क नस्कार आरू ओको करता यहोवा–भगवान क धन्यवाद <char style="ior"><ref loc="1CO 1:1-9">1:1-9</ref></char></para>
  <para style="io1">2. जो रीपोट पौलुस ने कुरन्थियो की मंडळी मा आवनेवाळा जवाब <char style="ior"><ref loc="1CO 1:10-4:21">1:10–4:21</ref></char></para>
  <para style="io1">3. अनैतिक व्यभिचार की समस्या आरू एक दिसरा क कोर्ट मा ली जातला इनीये समस्या बारा मा जोवाम आपने <char style="ior"><ref loc="1CO 5-6">5–6</ref></char></para>
  <para style="io1">4. वियाव की समस्या मुर्ती कि चढ़ावने टूवु आराधना आरू आत्मा क दान आरू पुनरूत्थान <char style="ior"><ref loc="1CO 7-15">7–15</ref></char></para>
  <para style="io1">5. व्यवहार आरू व्यक्तिगत मरला क बारा मा पौलुस क ईशु क बारा मा सलाह <char style="ior"><ref loc="1CO 16:1-24">16:1-24</ref></char></para>
  <chapter number="1" style="c" sid="1CO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1"/>पौलुसन चा रयन जो यहोवा–भगवानन मरजी छे ईशु मसीहन प्रेरित छे, हुयने क करता बुलाया गया आरू भाईस सोस्थिनेस की आरू छे, <verse eid="1CO 1:1"/><verse number="2" style="v" sid="1CO 1:2"/><note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ACT 18:1">प्रेरितन 18:1</ref></char></note>यहोवा–भगवान की उना मंडळी क नाव जो कुरिन्थस मा छे, मतलब ओको नाव जो मसीह ईशु मा चुखलो कामो गयो, आरू चुखलो हुयने क करता बुलाया गया छे; आरू उन सब क नाव भी जो हर धरतीम हामरे आरू आपने पोरबु ईशु मसीह क नाव छे प्रार्थना करता छे। <verse eid="1CO 1:2"/><verse number="3" style="v" sid="1CO 1:3"/>आमरो आरू ओको बास यहोवा–भगवान पोरबु ईशु मसीह की आरू छे तुमूक फोकटन दया आरू शांती मिवती रये।<verse eid="1CO 1:3"/></para>
  <para style="s">मसीह मा एक हुयने द्वारा सय बरकत</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4"/>हाव तुमरे विषय मा आपने क धन्यवाद सदा करता छे, एरकरीन कि यहोवा–भगवान क यो फोकटन दया तुमू पर मसीह ईशु मा होया। <verse eid="1CO 1:4"/><verse number="5" style="v" sid="1CO 1:5"/>एरकरीन की तुमू ईशु मसीह मा एक हुयने की वो हर एक वात मा मतलब सब काही बुलने मा आरू संपूर्ण ज्ञान छे हुयो। <verse eid="1CO 1:5"/><verse number="6" style="v" sid="1CO 1:6"/>कि ईशु क बारा मा गवाही तुमू मा स्थापित होय। <verse eid="1CO 1:6"/><verse number="7" style="v" sid="1CO 1:7"/>एरकरीन कि काही वरदान मा तुमू घटी नी, जोसी की तुमू हामरे पोरबु ईशु मसीह क प्रगट हुयने की वाट जुवता रयता होय। <verse eid="1CO 1:7"/><verse number="8" style="v" sid="1CO 1:8"/>वो तुमूक आखरी तक दृढ़ भी करसे एरकरीन कि तुमू हामरे पोरबु ईशु मसीह क पछो आवने दाहड़ो मा निर्दोष ठरछे। <verse eid="1CO 1:8"/><verse number="9" style="v" sid="1CO 1:9"/>यहोवा–भगवान विश्वासयोग्य छे, जो तुमू क ओका पोर्‍या हामरा पोरबु ईशु मसीह की संगति मा बुलाया छे।<verse eid="1CO 1:9"/></para>
  <para style="s">मंडळी मा फूट</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10"/>हे भाईस, हाव तुमू छे हामरे छे हामरे पोरबु ईशु मसीह क नाव छे रावन्या करता छे कि तुमू सब एक ही वात कयो, आरू तुमू मा फूट नी होय, पुन एक ही मन आरू एक ही मा हईन मिवे रयो। <verse eid="1CO 1:10"/><verse number="11" style="v" sid="1CO 1:11"/>हे मारा भाई आरू बहनीस खलोए क घराना क मानसे ने मखे तुमरे विषय मा देखाड्या छे कि तुमू मा झगड़ा होय रया छे। <verse eid="1CO 1:11"/><verse number="12" style="v" sid="1CO 1:12"/><note caller="+" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="ACT 18:24">प्रेरितन 18:24</ref></char></note>मारे कयनो क मतलब यो छे कि तुमू मा छे काही तो आपने आप क “पौलुस क” काही “अपुल्लोस क, काही कैफा क” तो काही “मसीह क चेला” कयता छे। <verse eid="1CO 1:12"/><verse number="13" style="v" sid="1CO 1:13"/>काय मसीह बट गया? काय पौलुस तुमरे करता कुरूस पर चढ़ाया गया? या तुम्हे पौलुस क नाव पर बपतिस्मा मिव्यो? <verse eid="1CO 1:13"/><verse number="14" style="v" sid="1CO 1:14"/><note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="ACT 18:8">प्रेरितन 18:8</ref> </char><char style="xt" closed="false"><ref loc="ACT 19:29">प्रेरितन 19:29</ref>; <ref loc="ROM 16:23">रोमियो 16:23</ref></char></note>हाव यहोवा–भगवान क धन्यावाद करता छे क्रिस्पुस आरू गयुस क छु़ड़ हाव ने तुमू हाव छे काही क भी बपतिस्मा नी दिया। <verse eid="1CO 1:14"/><verse number="15" style="v" sid="1CO 1:15"/>काही ओसो नी होय कि कये कि तुम्हे मारे नाव पर बपतिस्मा मिव्यो। <verse eid="1CO 1:15"/><verse number="16" style="v" sid="1CO 1:16"/><note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="1CO 16:15">1 कुरन्थियो 16:15</ref></char></note>आरू हाव, हाव ने स्तिफनास क घराना क भी बपतिस्मा दिया; इनको छुड़ हाव नी जानता कि हाव ने आरू काही बपतिस्मा दिया। <verse eid="1CO 1:16"/><verse number="17" style="v" sid="1CO 1:17"/>काहकि मसीह ने मखे बपतिस्मा देने क नी, वरना खुश खबर सोमवाने क मुकल्या छे, आरू यो भी मानुस क ज्ञान क लारे नी, आरू ओसो नी होय कि मसीह क कुरूस मरना रिकामो जाय।<verse eid="1CO 1:17"/></para>
  <para style="s">मसीह यहोवा–भगवान क ज्ञान आरू शक्ति छे</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18"/>काहकि कुरूस क बारा मा शिक्षा व्यर्थ छे, पुन हामु उध्दार देखनेवावा क करता यहोवा–भगवान की शक्ति छे, <verse eid="1CO 1:18"/><verse number="19" style="v" sid="1CO 1:19"/>काहकि लिख्या छे, “हाव ज्ञानवावा क ज्ञान क नष्ट करीस, आरू समझदार की समझ क बेकार कर देसे।” <verse eid="1CO 1:19"/><verse number="20" style="v" sid="1CO 1:20"/>कयो रया ज्ञानवान? कयो, रया शास्त्री? कयो रया शास्त्री? संसार क विवादी? काय यहोवा–भगवान ने संसार क ज्ञान क मुर्खता नी ठेराया? <verse eid="1CO 1:20"/><verse number="21" style="v" sid="1CO 1:21"/>काहकि जव यहोवा–भगवान क ज्ञान क लारे संसार ज्ञान छे यहोवा–भगवान क नी जाने, तो यहोवा–भगवान क यो वारलो लाग्या कि इनीये खबर की मुर्खता क द्वारा विश्वास करनेवावा क उध्दार दिदो। <verse eid="1CO 1:21"/><verse number="22" style="v" sid="1CO 1:22"/>यहूदि तो सहलानी जुवता छे, आरू यूनानी ज्ञान की खोज मा छे, <verse eid="1CO 1:22"/><verse number="23" style="v" sid="1CO 1:23"/>पुन हामु तो ओको कुरूस पर चढ़ाया हुया मसीह क खबर करता छे, जो यहूदि क करता ठुकर क कारण आरू गैरयहुदी क करता मुर्खता छे; <verse eid="1CO 1:23"/><verse number="24" style="v" sid="1CO 1:24"/>पुन जो बुलाया हुया छे, काय यहूदि काय यूनानी ओको निकट मसीह यहोवा–भगवान क शक्ति, आरू यहोवा–भगवानन ज्ञान छे। <verse eid="1CO 1:24"/><verse number="25" style="v" sid="1CO 1:25"/>काहकि यहोवा–भगवान की मुर्खता मानुस क बल छे घोणा ताकद वावो छे।<verse eid="1CO 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26"/>हे भाईस, आपने बुलाया जाने क तो सुचू कि नी डील क लारे घोणा ज्ञानवान, आरू नी घोणा सामर्थी, आरू नी कुलीन बुलाया गया। <verse eid="1CO 1:26"/><verse number="27" style="v" sid="1CO 1:27"/>पुन यहोवा–भगवान ने धरतीम क मुर्ख क निवाड़ लेदा छे कि ज्ञानवान क लज्जित करे, आरू यहोवा–भगवान ने धरतीम क निर्बलो क लेदा छे कि ताकद वावो क लज्जित करे; <verse eid="1CO 1:27"/><verse number="28" style="v" sid="1CO 1:28"/>आरू यहोवा–भगवान ने धरतीम क नेचो आरू तुच्छो क, वरना जो छे भी नी उनको भी निवाड़ लेदा कि तीनुक जो छे, व्यर्थ ठेराया। <verse eid="1CO 1:28"/><verse number="29" style="v" sid="1CO 1:29"/>ताकि काही मानुस यहोवा–भगवान ने असो क सामने डाहळाय नी करने देख्या। <verse eid="1CO 1:29"/><verse number="30" style="v" sid="1CO 1:30"/>पुन यहोवा–भगवान ने हामु ईशु मसीह मा एक छे, आरू हामु यहोवा–भगवान क करता हामु ज्ञान बनाड़े छे, मतलब यहोवा–भगवान क समाने हामु न्यायी, आरू चुखलो ठराय; <verse eid="1CO 1:30"/><verse number="31" style="v" sid="1CO 1:31"/>ताकि जोसो लिख्या छे, वोसो ही होय, “जो डाहळाय करे वो पोरबु मा डाहळाय करे।”<verse eid="1CO 1:31"/></para>
  <chapter eid="1CO 1"/>
  <chapter number="2" style="c" sid="1CO 2"/>
  <para style="s">कुरसित मसीह क विषय संदेश</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1"/>हे भाईस, आरू बहनीस जव हाव यहोवा–भगवान क सच्चाई भेद सोमवता हुया तुमरे साथे आश, तो ओवाज या ज्ञान की वारू मा वारू क साथे नी आश। <verse eid="1CO 2:1"/><verse number="2" style="v" sid="1CO 2:2"/>काहकि हाव ने यो ठान लेदा हुता कि तुमरे वीच ईशु मसीह वरना कुरूस पर चढ़ाया हुया मसीह क मरलो छुड़ आरू काही वात क नी जानीस। <verse eid="1CO 2:2"/><verse number="3" style="v" sid="1CO 2:3"/><note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="ACT 18:9">प्रेरितन 18:9</ref></char></note>हाव निर्बलता आरू बीक क साथे, आरू घोणा थरथराता हुया तुमरे साथे आयो; <verse eid="1CO 2:3"/><verse number="4" style="v" sid="1CO 2:4"/>आरू मारो वचन, आरू मारो खबर मा ज्ञान की लुभानेवावी वात नी, यहोवा–भगवान क आत्मा क शक्ति क प्रमाण हुता, <verse eid="1CO 2:4"/><verse number="5" style="v" sid="1CO 2:5"/>एरकरीन कि तुमरा विश्वास मानुस क ज्ञान पर नी, पुन यहोवा–भगवान की शक्ति पर निर्भर होय।<verse eid="1CO 2:5"/></para>
  <para style="s">यहोवा–भगवान क ज्ञान</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6"/>पछु भी सिध्द मानसे मा हामु ज्ञान सोमवता छे; पुन इनीये संसार क आरू इनीये संसार क नाश हुयने वालो सरदार क ज्ञान नी; <verse eid="1CO 2:6"/><verse number="7" style="v" sid="1CO 2:7"/>पुन हामु यहोवा–भगवान क वो सातायलो ज्ञान, भेद की रीति पर देखाड़ता छे, जिनाक यहोवा–भगवान ने जगमा छे पेहल छे हामरी महिमा क करता त्योन्यो। <verse eid="1CO 2:7"/><verse number="8" style="v" sid="1CO 2:8"/>जिनाक इनीये संसार क सरदार मा छे काही ने नी जाने, काहकि यदि वो जानता तो तेजोमय पोरबु क कुरूस पर नी चढ़ावता। <verse eid="1CO 2:8"/><verse number="9" style="v" sid="1CO 2:9"/>पुन जोसो लिख्यो छे, “जो वात डुवा ने नी देखी आरू कान्टा ने नी सोमवी, आरू जो वात मानुस क मन मा नी चढ़ी वो ही छे जो यहोवा–भगवान ने आपने मोंग राखनेवावा क करता तीयार करी छे।”<verse eid="1CO 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 2:10"/>पुन यहोवा–भगवान ने उनको आपने आत्मा क द्वारा हामु पर प्रगट कर्‍या, काहकि आत्मा सब वात वरना यहोवा–भगवान की सातायली वात हेरता छे। <verse eid="1CO 2:10"/><verse number="11" style="v" sid="1CO 2:11"/>मानुस मा छे कुन काही मानुस की वात जानता छे, केवल मानुस की आत्मा जो उको छे? वोसो ही यहोवा–भगवान की वात भी काही नी जानता केवल यहोवा–भगवान क आत्मा। <verse eid="1CO 2:11"/><verse number="12" style="v" sid="1CO 2:12"/>पुन हामु ने संसार की आत्मा नी, पुन वो आत्मा देख्या छे जो यहोवा–भगवान की आरू छे कि हामु उन वात क जाने जो यहोवा–भगवान ने हामु देदी छे। <verse eid="1CO 2:12"/><verse number="13" style="v" sid="1CO 2:13"/>जिनको हामु मानुस क ज्ञान सिखाड़ी होयी वात मा नी, पुन आत्मा की सिखाड़ी होयी वात मा आत्मिक वात आत्मिक वात छे मिवी मिवीन सोमवता छे। <verse eid="1CO 2:13"/><verse number="14" style="v" sid="1CO 2:14"/>पुन जो मनुस यहोवा–भगवान क आत्मा न आत्मिक वात नी माने, काहकि वो ओकी नजर मा मुर्खता की छे, आरू नी वो तीनुक जान सकता छे काहकि उनकी हेरता आत्मिक रीति छे होयती छे। <verse eid="1CO 2:14"/><verse number="15" style="v" sid="1CO 2:15"/>आत्मिक जन सब काय हेरता छे, पुन वो आप काही छे समझ नी जाता। <verse eid="1CO 2:15"/><verse number="16" style="v" sid="1CO 2:16"/>“काहकि पोरबु क मन कोय जाने छे कि ओको सिखाड्या?” पुन हामु मा मसीह क मन छे।<verse eid="1CO 2:16"/></para>
  <chapter eid="1CO 2"/>
  <chapter number="3" style="c" sid="1CO 3"/>
  <para style="s">मंडळी मा दुय भाग</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1"/>हे भाईस, आरू बहनीस, हाव तुमू छे इनीये रीति छे वात नी कर सक्या जोसो आत्मिक मानसे छे, पुन जोसो संसार क मानसे छे, आरू उनछे जो मसीह मा पोर्‍या छे। <verse eid="1CO 3:1"/><verse number="2" style="v" sid="1CO 3:2"/><note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="HEB 5:12">इब्रानियों 5:12</ref>,<ref loc="HEB 5:13">13</ref></char></note>हाव ने तुम्हे दुध पिवाड्या, अन नी खावड़ाया; काहकि तुमू ओको नी खाय सकता हुता; वरन् हिमी तक भी नी खाय सकता होय, <verse eid="1CO 3:2"/><verse number="3" style="v" sid="1CO 3:3"/>काहकि हिमी तक संसार होय। एरकरीन कि जव तुमू मा किचवाय आरू झगड़ा छे, तो काय तुमू संसार क मानसे जोसो नी? आरू काय मानुस की रीति पर नी चालता? <verse eid="1CO 3:3"/><verse number="4" style="v" sid="1CO 3:4"/><note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="1CO 1:12">1 कुरन्थियो 1:12</ref></char></note>काहकि जव एक कयता छे, “हाव पौलुस क छे” आरू दिसरा , “हाव अपुल्लोस क छे” तो काय तुमू जीवो क नी?<verse eid="1CO 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5"/>अपुल्लोस काय छे? आरू पौलुस काय छे? केवल सेवक, जिनके द्वारा तुमू ने विश्वास कर्‍या, जोसो पोरबु ने हर एक क काम करनो जुवे। <verse eid="1CO 3:5"/><verse number="6" style="v" sid="1CO 3:6"/><note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="ACT 18:4-11">प्रेरितन 18:4-11</ref> </char><char style="xt" closed="false"><ref loc="ACT 18:24-28">प्रेरितन 18:24-28</ref></char></note>हाव ने लागाड़ ्या, अपुल्लोस ने पानी नाख्यो, पुन यहोवा–भगवान ने मोट। <verse eid="1CO 3:6"/><verse number="7" style="v" sid="1CO 3:7"/>एरकरीन नी तो लागाड़ने वावा काय छे आरू नी सीचनेवावा, पुन यहोवा–भगवान ही सब काही छे जो बढ़ावनेवावो छे। <verse eid="1CO 3:7"/><verse number="8" style="v" sid="1CO 3:8"/>लागाड़ने वावा आरू सीचनेवावा दुय एक छे; पुन हर एक आपने ही मेहनत क लारे आपसी ही मजदूरी देख्या। <verse eid="1CO 3:8"/><verse number="9" style="v" sid="1CO 3:9"/>काहकि हामु यहोवा–भगवान क सहकर्मी छे; तुमू यहोवा–भगवान की खेत आरू यहोवा–भगवान की रचना होय। <verse eid="1CO 3:9"/><verse number="10" style="v" sid="1CO 3:10"/>यहोवा–भगवान क उना फोकटन दया क लारे जो मखे दिया गया, हाव ने बुध्दिमान राजमिस्त्री क समान नीव नाखी, आरू दिसरा ओको पर रद्दा राखता छे। पुन हर एक मानुस चोकचौळीया रये कि वो ओको पर कोसो रद्दा राखता छे। <verse eid="1CO 3:10"/><verse number="11" style="v" sid="1CO 3:11"/>काहकि ओको नीव क छुड़ जो पड़ी छे, आरू वो ईशु मसीह छे, काही दीसरी नीव नाख सकता। <verse eid="1CO 3:11"/><verse number="12" style="v" sid="1CO 3:12"/>यदि काही इनीये नीव पर सोना चाँदी या महंगा दगड़ा या लाकड़ो या खोड़ो या पुवो क रद्दा राखे, <verse eid="1CO 3:12"/><verse number="13" style="v" sid="1CO 3:13"/>तो हर एक क काम प्रगट होय जाछे; काहकि वो दाहड़ो ओको देखाड्या, एरकरीन कि आगठो क साथे प्रगट होयछे आरू वो आगठो हर एक क काम पारख छे कि कोसी छे। <verse eid="1CO 3:13"/><verse number="14" style="v" sid="1CO 3:14"/>जेरो काम ओको पर बना होया स्थिर रयछे, वो न्याय क दाहड़ो देखछे। <verse eid="1CO 3:14"/><verse number="15" style="v" sid="1CO 3:15"/>यदि काही क काम धप जाछे, तो वो हानि झेलसे पुन वो वाच जाछे धपतो धपतो। <verse eid="1CO 3:15"/><verse number="16" style="v" sid="1CO 3:16"/><note caller="+" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="1CO 6:19">1 कुरन्थियो 6:19</ref>; <ref loc="2CO 6:16">2 कुरन्थियो 6:16</ref></char></note>काय तुमू नी जानता कि तुमू यहोवा–भगवान क मंदिर होय, आरू यहोवा–भगवान क आत्मा तुमू मा निवास करता छे? <verse eid="1CO 3:16"/><verse number="17" style="v" sid="1CO 3:17"/>यदि काही यहोवा–भगवान क मंदिर क नष्ट करसे तो यहोवा–भगवान ओको नष्ट करसे। काहकि यहोवा–भगवान क मंदिर चुखलो छे, आरू वो तुमू होय। <verse eid="1CO 3:17"/><verse number="18" style="v" sid="1CO 3:18"/>काही आपने आप क धुखो नी देय। यदि तुमू मा छे काही इनीये संसार मा आपने आप क ज्ञानी समझे, तो मुर्ख बने कि ज्ञानी होय जाय। <verse eid="1CO 3:18"/><verse number="19" style="v" sid="1CO 3:19"/>काहकि इनीये संसार क ज्ञान यहोवा–भगवान क निकट मुर्खता छे, जोसो लिख्यो छे, “वो ज्ञानियो क उनकी चतराय मा फोस देता छे” <verse eid="1CO 3:19"/><verse number="20" style="v" sid="1CO 3:20"/>आरू पछु, “पोरबु ज्ञानियो क विचार क जानता छे कि वो व्यर्थ छे।” <verse eid="1CO 3:20"/><verse number="21" style="v" sid="1CO 3:21"/>एरकरीन मानुस पर काही डाहळाय नी करे, काहकि सब काही तुमरो छे: <verse eid="1CO 3:21"/><verse number="22" style="v" sid="1CO 3:22"/>काय पौलुस, काय अपुल्लोस, काय कैफा, काय धरतीम, काय जीवन, काय मरण, काय वर्तमान, काय भविष्य, सब काही तुमरो छे, <verse eid="1CO 3:22"/><verse number="23" style="v" sid="1CO 3:23"/>आरू तुमू मसीह क होय, आरू मसीह यहोवा–भगवान क छे।<verse eid="1CO 3:23"/></para>
  <chapter eid="1CO 3"/>
  <chapter number="4" style="c" sid="1CO 4"/>
  <para style="s">मसीह क प्रेरित</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1"/>मानुस हामु मसीह क सेवक आरू यहोवा–भगवान क भेदो क भण्डारी समझे। <verse eid="1CO 4:1"/><verse number="2" style="v" sid="1CO 4:2"/>पछु याहा भण्डारी मा यो वात देख जाती छे कि वो विश्वास योग्य होय। <verse eid="1CO 4:2"/><verse number="3" style="v" sid="1CO 4:3"/>पुन मारी दृष्टि मा यो घोणा नानी वात छे कि तुमू या मानुस क काही न्यायी मखे न्याय, वरना हाव स्वयं आपने आप क नी न्याय नी करता। <verse eid="1CO 4:3"/><verse number="4" style="v" sid="1CO 4:4"/>काहकि मारो मन मखे काही वात क न्याय नी ठेरायता, पुन इनासे हाव निर्दोष नी ठेरायता, काहकि मारा न्याय करनेवावा पोरबु छे। <verse eid="1CO 4:4"/><verse number="5" style="v" sid="1CO 4:5"/>एरकरीन जव तक पोरबु नी आश, टेहाव छे पेहले काही वात क न्याय नी करे: चो आंधारा आरू मनो क मरजी क प्रगट करसे, तव यहोवा–भगवान करी आरू छे हर एक करी वाहवाय होयछे।<verse eid="1CO 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6"/>हे भाईस, हाव ने इन वात मा तुमरे करता आपसी आरू अपुल्लोस की चर्चा दृष्टान्त की रीति पर की छे, एरकरीन कि तुमू हामरे द्वारा यो सीखु कि लिख्या होया छे ओगव नी वदने, आरू एक क पक्ष मा आरू दिसरा क विरोध मा डाहवाय नी करने। <verse eid="1CO 4:6"/><verse number="7" style="v" sid="1CO 4:7"/>तुखे मा आरू दिसरा मा कुन संका करता छे? आरू तारे साथे काय छे जो तु ने यहोवा–भगवान छे नी देख्या? आरू जव कि तु ने यहोवा–भगवान छे देख्या छे, तो ओसो डाहळाय काय करता छे कि मानो नी देख्या?<verse eid="1CO 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8"/>तुमू तो तुप्त त्योक्य, तुमू धनी होय, त्योक्य, तुमू ने हामरे विना राज्य कर्‍या; पुन भला हुयसे कि तुमू राज्य करता कि हामु भी तुमरे साथे राज्य करता। <verse eid="1CO 4:8"/><verse number="9" style="v" sid="1CO 4:9"/>मारी समझ मा यहोवा–भगवान ने हामु प्रेरितन क सब क बाद उन मानसे क समान ठेराया छे, जिनकी मरला की हुकुम होय त्योकी होय; काहकि हामु धरतीम आरू सोरगदूत आरू मानसे क करता एक तमाशा ठेराया छे। <verse eid="1CO 4:9"/><verse number="10" style="v" sid="1CO 4:10"/>हामु मसीह क करता मुर्ख छे; पुन तुमू मसीह मा बुध्दिमान होय; हामु निर्बल छे, पुन तुमू ताकद वावो होय; तुमू विजुत देखता होय, पुन हामु निरदार हुयसे छे। <verse eid="1CO 4:10"/><verse number="11" style="v" sid="1CO 4:11"/>हामु इनीये घड़ी तक भुखला पिसला हामु फाटला लुगड़ा पेहरतला, आरू धुमा खाता रया आरू मारे मारे पुगता छे; <verse eid="1CO 4:11"/><verse number="12" style="v" sid="1CO 4:12"/><note caller="+" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ACT 18:3">प्रेरितन 18:3</ref></char></note>आरू आपने ही हात छे काम करीन मेहनत करता छे। मानसे हामु बुरा कयता छे, हामु बरकत देता छे; वो सताता छे, हामु सहते छे। <verse eid="1CO 4:12"/><verse number="13" style="v" sid="1CO 4:13"/>वो बदनाम करता छे, हामु विनती करता छे। हामु आज तक धरतीम क कूड़ा आरू सब समान की मोयव क समान ठेराया छे।<verse eid="1CO 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14"/>हाव तुम्हे लज्जित करने क करता यो वात नी लिखता, पुन आपने मोंगावु पोर्‍या जानीन तुमूक चिताता छे। <verse eid="1CO 4:14"/><verse number="15" style="v" sid="1CO 4:15"/>काहकि यदि मसीह मा तुमरा सिखाडनेवावा दस हजार भी हुता, तौभी तुमरा बास घोणा छे नी; एरकरीन कि मसीह ईशु मा खुश खबर क द्वारा हाव तुमरा बास होया। <verse eid="1CO 4:15"/><verse number="16" style="v" sid="1CO 4:16"/><note caller="+" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="1CO 11:1">1 कुरन्थियो 11:1</ref>; <ref loc="PHP 3:17">फिलिप्पियो 3:17</ref></char></note>एरकरीन हाव तुमू छे रावन्या करता छे कि मारो गती करो। <verse eid="1CO 4:16"/><verse number="17" style="v" sid="1CO 4:17"/>एरकरीन हाव ने तीमुथियुस क जो पोरबु मा मारो मोंगावु आरू विश्वास योग्य पोर्‍य छे तुमरे साथे मुकल्या छे। तुमू मसीह मा मारो चारित्र स्मरण करावसे, जोसो कि हाव हर धरती हर एक मंडळी मा शिक्षा करता छे। <verse eid="1CO 4:17"/><verse number="18" style="v" sid="1CO 4:18"/>काय तो ओसो फूल गया छे, मानो हाव तुमरे साथे आवने ही क नी। <verse eid="1CO 4:18"/><verse number="19" style="v" sid="1CO 4:19"/>पुन पोरबु ने जुया तो हाव तुमरे साथे शीघ्र ही आवसे, आरू उन फूले हुया की वात क नी, पुन उनकी शक्ति क जान लेछे। <verse eid="1CO 4:19"/><verse number="20" style="v" sid="1CO 4:20"/>काहकि यहोवा–भगवान क राज्य वात मा नी पुन शक्ति मा छे। <verse eid="1CO 4:20"/><verse number="21" style="v" sid="1CO 4:21"/>तुमू काय जुवता होय? काय हाव लाकड़ी लीन तुमरे साथे आवीस, या मोंग आरू नम्रता न आत्मा क साथे?<verse eid="1CO 4:21"/></para>
  <chapter eid="1CO 4"/>
  <chapter number="5" style="c" sid="1CO 5"/>
  <para style="s">मंडळी मा अनतिकता</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1"/>याहा तक सोमवने मा आवता छे कि तुमू मा व्यभिचार हुयसे छे, वरना ओसो व्यभिचार जो गैरयहुदीन मा भी नी कि एक मानुस आपने बास की बायर क राखता छे। <verse eid="1CO 5:1"/><verse number="2" style="v" sid="1CO 5:2"/>आरू तुमू शोक तो नी करता, छे जिनासे ओसो काम करनेवावा तुमरे विच मा छे निकाव जाता, पुन डाहळाय करता होय। <verse eid="1CO 5:2"/><verse number="3" style="v" sid="1CO 5:3"/>हाव तो डील छे दूर हुता, पुन आत्मा छे तुमरे साथे छे। हईन की हजरी करी दशा मा ओसो काम करनेवावा क विषय मा यो हुकुम देय त्योक्या छे। <verse eid="1CO 5:3"/><verse number="4" style="v" sid="1CO 5:4"/>कि जव तुमू आरू मारी आत्मा, हामरे पोरबु ईशु की शक्ति क साथे एखठा होय, तो ओसो मानुस हामरे पोरबु ईशु क नाव छे। <verse eid="1CO 5:4"/><verse number="5" style="v" sid="1CO 5:5"/>डील क विनाश क करता शैतान क सौप जाय, ताकि ओकी आत्मा पोरबु ईशु क दाहड़ा मा उध्दार जुड़से।<verse eid="1CO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:6 </char>
      <char style="xt" closed="false">
        <ref loc="GAL 5:9">गलातिया 5:9</ref>
      </char>
    </note>तुमरा डाहळाय करने वारलो नी; काय तुमू नी जानता कि थुड़ा सा खमीर पूरे गूंधे होया पिठु क खमीर कर देता छे। <verse eid="1CO 5:6"/><verse number="7" style="v" sid="1CO 5:7"/>जुनलो खमीर निकाव कर आपने आप क चुखो करो कि नवलो गूंधा होया पिठु बन जाय! ताकि तुमू अखमीरी होय। काहकि हामरा भी फसह, जो मसीह छे, बलिदान होया छे। <verse eid="1CO 5:7"/><verse number="8" style="v" sid="1CO 5:8"/>एरकरीन आवु, हामु तिवार मा खुशी मनावजे, नी तो जुनलो खमीर छे आरू नी बुराई आरू दुष्टता क खमीर छे, पुन सीधाई आरू सच्चाई की अखमीरी रोटा छे।<verse eid="1CO 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9"/>हाव ने आपसी पत्री मा तुमूक लिख्या छे कि व्यभिचार की सगति नी करने। <verse eid="1CO 5:9"/><verse number="10" style="v" sid="1CO 5:10"/>यो नी कि तुमू बिलकुल इनीये धरतीम क व्यभिचार या लोभियो, या चुरी करनेवावा, या मुर्तिपूजक की सगति नी करो; काहकि इनीये दशा मा तो तुमूक धरतीम मा छे निकाव जाने ही पड़ता। <verse eid="1CO 5:10"/><verse number="11" style="v" sid="1CO 5:11"/>पर मारो कयनो यो छे कि यदि काही भाईस धरती, व्यभिचारी, या लोभी, या मुर्तिपूजक, या गाली देनेवावा, या पियक्‍कड़ या चुरी करनेवावा होय, तो ओकी संगति मा करने; वरना ओसो मानुस क साथे खानो भी नी खानो। <verse eid="1CO 5:11"/><verse number="12" style="v" sid="1CO 5:12"/>काहकि मखे बाहरतावावा क न्याय करने छे काय काम? काय तुमू माहीयवावा क न्याय नी करता? <verse eid="1CO 5:12"/><verse number="13" style="v" sid="1CO 5:13"/>पुन बाहरतावावा क न्याय यहोवा–भगवान करता छे एरकरीन ओको खराब क आपने वीच मा छे निकाव देय।<verse eid="1CO 5:13"/></para>
  <chapter eid="1CO 5"/>
  <chapter number="6" style="c" sid="1CO 6"/>
  <para style="s">मसीहियो मा मुकद्दहावबाजी</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1"/>काय तुमू मा छे काही क यो हियाव छे कि जव दिसरा क साथे झगड़ा होय तो फैसला क करता जो यहोवा–भगवान क नी जाता ओको साथे जाय आरू भुरसा क साथे नी जाय? <verse eid="1CO 6:1"/><verse number="2" style="v" sid="1CO 6:2"/>काय तुमू नी जानता कि विश्वास मानसे धरतीम क न्याय करसे? एरकरीन जव तुमूक धरतीम क न्याय करने छे, तो काय तुमू नानो छे नानो झगड़ा क भी निर्णय करने क योग्य नी? <verse eid="1CO 6:2"/><verse number="3" style="v" sid="1CO 6:3"/>काय तुमू नी जानता कि हामु सोरगदूत क न्याय करसे? तो काय सांसारिक वात क निर्णय नी कर्‍या? <verse eid="1CO 6:3"/><verse number="4" style="v" sid="1CO 6:4"/>यदि तुमू सांसारिक वात क निर्णय करने होय, तो काय तीनी क बठछे जो मंडळी मा काही नी समझ जाता छे? <verse eid="1CO 6:4"/><verse number="5" style="v" sid="1CO 6:5"/>हाव तुमू लज्जित करने क करता यो कयता छे। काय सचमुच तुमू मा एक भी बुध्दिमान नी मिवता, जो आपने भाईस भाईस क निर्णय कर सक्या? <verse eid="1CO 6:5"/><verse number="6" style="v" sid="1CO 6:6"/>तुमू मा भाईस भाईस मा मुकद्दमा हुयसे छे, आरू वो भी विनभुरसीया क सामने।<verse eid="1CO 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7"/>पुन सचमुच तुमू मा मोट दोष तो यो छे कि आपस मा मुकद्दमा करता होय। अन्याय काय नी सहते? आपसी हानि काय नी सहते? <verse eid="1CO 6:7"/><verse number="8" style="v" sid="1CO 6:8"/>पुन तुमू तो स्वयं अन्याय करता आरू हानि पुचाड़ता होय, आरू वो भी भाईस क। <verse eid="1CO 6:8"/><verse number="9" style="v" sid="1CO 6:9"/>काय तुमू नी जानता कि अन्यायी मानसे यहोवा–भगवान क राज्य क वारीस नी होयछे? धूखो नी खावु; नी वेश्यागामी, नी मुर्तिपूजक, नी विनलाज्या काम, नी लुच्चा नी मानुसगामी, <verse eid="1CO 6:9"/><verse number="10" style="v" sid="1CO 6:10"/>नी त्योट्टा, नी लोभी, नी पियक्‍कड़, नी गाली देनेवावा, नी चुरी करनेवावा यहोवा–भगवान क राज्य क वारीस होयछे। <verse eid="1CO 6:10"/><verse number="11" style="v" sid="1CO 6:11"/>आरू तुमू मा छे कोतरा ओसो ही हुता, पुन तुमू पोरबु ईशु मसीह क नाव छे आरू हामरा यहोवा–भगवान क आत्मा छे धुया गया आरू चुखलो होया आरू न्यायी ठेराया।<verse eid="1CO 6:11"/></para>
  <para style="s">देह यहोवा–भगवान की महिमा क करता</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:12 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 10:23">1 कुरन्थियो 10:23</ref>
      </char>
    </note>सब समान मारे करता वारू तो छे, पुन सब समान लाभ की नी; सब समान मारे करता वारू छे, पुन हाव काही वात क हक तळे नी होयछे। <verse eid="1CO 6:12"/><verse number="13" style="v" sid="1CO 6:13"/>भोजन पेट क करता, आरू पेट भोजन क करता छे, पुन यहोवा–भगवान इनीये क आरू ओको क दुय क नष्ट करसे। पुन डील व्यभिचार क करता नी वरना पोरबु क करता छे, आरू पोरबु डील क देख रेख करता छे। <verse eid="1CO 6:13"/><verse number="14" style="v" sid="1CO 6:14"/>यहोवा–भगवान ने आपसी शक्ति छे पोरबु क जीवाड्या, आरू हामु भी जीवाड़छे। <verse eid="1CO 6:14"/><verse number="15" style="v" sid="1CO 6:15"/>काय तुमू नी जानता कि तुमरो डील मसीह क अंग छे? तो काय हाव मसीह क अंग लीन तीनुक वेश्या क अंग बनावु? कदी नी। <verse eid="1CO 6:15"/><verse number="16" style="v" sid="1CO 6:16"/>काय तुमू नी जानता कि जो काही वेश्या छे संगति करता छे, वो ओका साथे एक तन होय जाता छे? काहकि लिख्या छे: “वो दुय एक डील होयछे।” <verse eid="1CO 6:16"/><verse number="17" style="v" sid="1CO 6:17"/>आरू जो पोरबु की सगति मा रयता छे, वो ओका साथे एक आत्मा होय जाता छे। <verse eid="1CO 6:17"/><verse number="18" style="v" sid="1CO 6:18"/>व्याभिचार छे वाच रयो। जोतरा दिसरा पाप मानुस करता छे वो देह क बाहरता छे, पुन व्यभिचार करनेवावा आपसी ही देह क विरोध पाप करता छे। <verse eid="1CO 6:18"/><verse number="19" style="v" sid="1CO 6:19"/><note caller="+" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="1CO 3:16">1 कुरन्थियो 3:16</ref>; <ref loc="2CO 6:16">2 कुरन्थियो 6:16</ref></char></note>काय तुमू नी जानता कि तुमरी देह चुखलो आत्मा क मंदिर छे जो तुमू मा बठला होया छे आरू यहोवा–भगवान की आरू छे मिव्यो छे; आरू तुमू आपने तुमू आपने नी होय? <verse eid="1CO 6:19"/><verse number="20" style="v" sid="1CO 6:20"/>काहकि यहोवा–भगवान तुमूक दाम आपीन छुटकारो करलो छे, एरकरीन आपसा डील न लारे यहोवा–भगवानन महिमा करू।<verse eid="1CO 6:20"/></para>
  <chapter eid="1CO 6"/>
  <chapter number="7" style="c" sid="1CO 7"/>
  <para style="s">वियाव छे सम्बन्धित सवाल</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1"/>उन वात क विषय मा जो तुमू ने लिखी यो वारलो छे कि मानुस बायर क नी धर्‍य। <verse eid="1CO 7:1"/><verse number="2" style="v" sid="1CO 7:2"/>पुन व्यभिचार क घाबराय छे हर एक मानुस की बायर, आरू हर एक बायर क घर वावो होनो जुवे। <verse eid="1CO 7:2"/><verse number="3" style="v" sid="1CO 7:3"/>घर वावो आपसी बायर क हक पूरो कर्‍या; आरू वोसो ही बायर भी आपने घर वावो क <verse eid="1CO 7:3"/><verse number="4" style="v" sid="1CO 7:4"/>बायर क आपसी देह पर हक नी पर ओका घर वावो क हक छे; वोसो ही घर वावो क भी आपसी देह पर हक नी, पुन बायर क छे। <verse eid="1CO 7:4"/><verse number="5" style="v" sid="1CO 7:5"/>तुमू एक दिसरा छे अलग नी रयो; पुन केवल काही टेहाव तक आपस की सम्मति छे कि प्रार्थना क करता छुट्टी मिवे, आरू पछु एक साथे रयो; ओसो नी होय कि तुमरे गम क कारण शैतान तुमू पारखे। <verse eid="1CO 7:5"/><verse number="6" style="v" sid="1CO 7:6"/>पुन हाव जो यो कयता छे वो हक छे नी कि हुकुम। <verse eid="1CO 7:6"/><verse number="7" style="v" sid="1CO 7:7"/>हाव यो जुवता छे कि जोसो हाव छे, वोसो ही सब मानुस होय; पुन हर एक क यहोवा–भगवान की आरू छे विशेष वरदान मिव्या छे; काही क काही प्रकार क, आरू काही क काही आरू प्रकार क।<verse eid="1CO 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8"/>हिमी हाव छल्ला आरू रंडायली क विषय मा कयता छे कि ओको करता ओसो ही रयने वारलो छे, जोसो हाव छे। <verse eid="1CO 7:8"/><verse number="9" style="v" sid="1CO 7:9"/>पुन यदि वो संयम नी कर सक्या, तो वियाव करे; काहकि वियाव करने कामातुर रयने छे भलो छे।<verse eid="1CO 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10"/>जिनका वियाव होय गया छे, उनको हाव नी, वरना पोरबु हुकुम देता छे कि बायर आपने घर वावो छे अलग नी होय। <verse eid="1CO 7:10"/><verse number="11" style="v" sid="1CO 7:11"/>आरू यदि अलग भी होय जाय, तो विन दिसरा वियाव कर रया; या आपने घर वावो छे पछु हावल कर लेय आरू नी घर वावो आपसी बायर क छुड़।<verse eid="1CO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12"/>दिसरा छे पोरबु नी पुन हाव ही कयता छे, यदि काही भाईस की बायर विश्वास नी राखती होय आरू ओका साथे रयने छे खुश होय, तो वो ओको नी छुड़े। <verse eid="1CO 7:12"/><verse number="13" style="v" sid="1CO 7:13"/>जिना बायर क घर वावो विनभुरसियो होय, आरू ओका साथे रयने छे खुश होय; वो घर वावो क नी छुड़े। <verse eid="1CO 7:13"/><verse number="14" style="v" sid="1CO 7:14"/>काहकि ओसो घर वावो जो विनभुरसिया होय, वो बायर क कारण चुखलो ठेराया छे; आरू ओसी बायर जो विश्वास नी राखती, घर वावो क कारण चुखलो ठेरायती छे; नी तो तुमरे पोर्‍या पारी विटळ होयतो, पुन हिमी तो चुखलो छे। <verse eid="1CO 7:14"/><verse number="15" style="v" sid="1CO 7:15"/>पुन जो मानुस विनभुरसीया छे, यदि वो अलग होय तो अलग हुयने देवु, ओसी दशा मा काही भाईस या बहिनीस बन्धन मा नी यहोवा–भगवान ने हामु मेलमिलाप क करता बुलाया छे। <verse eid="1CO 7:15"/><verse number="16" style="v" sid="1CO 7:16"/>काहकि हे बायर, तु काय जानती छे कि तु आपने घर वावा क उध्दार कर लेछे? आरू हे मानुस, तु काय जानता छे कि तु आपसी बायर क उध्दार कर लेछे?<verse eid="1CO 7:16"/></para>
  <para style="s">यहोवा–भगवान की बुलाहट क लारे चालु</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17"/>जोसो पोरबु ने हर एक क वाट्या छे, आरू जोसो यहोवा–भगवान ने हर एक क बुलाया छे, वोसो ही वो चाले। हाव सब मंडळी मा ओसो ही ठेरायता छे। <verse eid="1CO 7:17"/><verse number="18" style="v" sid="1CO 7:18"/>जो खतना कर्‍या होया बुलाया गया होय, वो खतनारहित नी बने। जो खतनारहित बुलाया गया होय, वो खतना नी कराय। <verse eid="1CO 7:18"/><verse number="19" style="v" sid="1CO 7:19"/>नी खतना काही छे आरू नी खतनारहित, पुन यहोवा–भगवान की हुकुम क लारे चालने ही सब काही छे। <verse eid="1CO 7:19"/><verse number="20" style="v" sid="1CO 7:20"/>हर एक जन जिना दशा मा बुलाया गया होय, तीनी मा रये। <verse eid="1CO 7:20"/><verse number="21" style="v" sid="1CO 7:21"/>यदि तु दास की दशा मा बुलाया होय तो चिंता नी कर; पुन यदि तु स्वतंत्र होय सके, तो ओसो ही काम कर। <verse eid="1CO 7:21"/><verse number="22" style="v" sid="1CO 7:22"/>काहकि जो दास की दशा मा पोरबु मा बुलाया गया छे, वो पोरबु क स्वतंत्र कर्‍या होया छे। वोसो ही जो स्वतंत्रता करी दशा मा बुलाया गया छे, वो मसीह क दास छे। <verse eid="1CO 7:22"/><verse number="23" style="v" sid="1CO 7:23"/>यहोवा–भगवान ने तुमू दाम दीन छुड़ाय लेदा गया छे; मानुस क दास नी बन्या। <verse eid="1CO 7:23"/><verse number="24" style="v" sid="1CO 7:24"/>हे भाईस, आरू बहनीस जो काही जिना दशा मा बुलाया गया होय, वो तीनी मा यहोवा–भगवान क साथे रये।<verse eid="1CO 7:24"/></para>
  <para style="s">वियाव आरू रंडायली</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25"/>छल्ली क विषय मा पोरबु की काही हुकुम मखे नी मिवी, पुन विश्वासयोग्य हुयने क करता जोसी दया पोरबु ने मखे पर करी छे, तीनी क लारे सम्माति देता छे। <verse eid="1CO 7:25"/><verse number="26" style="v" sid="1CO 7:26"/>मारी समझ मा यो वारलो छे कि आजकाल पीड़ा क कारण, मानुस जोसो छे वोसो ही रये। <verse eid="1CO 7:26"/><verse number="27" style="v" sid="1CO 7:27"/>यदि तारी बायर छे, तो ओका सी अलग हुयने क यत्न नी कर; आरू यदि तारी बायर नी, तो बायर की खोज नी कर। <verse eid="1CO 7:27"/><verse number="28" style="v" sid="1CO 7:28"/>पुन यदि तु वियाव भी करे, तो पाप नी; आरू यदि छल्ली ब्याही जाय तो काही पाप नी। पुन ओसो क शारीरिक दुःख होयछे, आरू हाव वाचाड़ने जुवता छे। <verse eid="1CO 7:28"/><verse number="29" style="v" sid="1CO 7:29"/>हे भाईस हाव यो कयता छे कि टेहाव कम कर्‍या गया छे, एरकरीन जुवे कि जिन क बायर होय, वो ओसो मानु उन क बायर नी; <verse eid="1CO 7:29"/><verse number="30" style="v" sid="1CO 7:30"/>आरू रड़नेवावा ओसो होय, मानु रड़ता नी; आरू खुशी करनेवावा ओसो होय, मानु खुशी नी करता; ओको साथे काही छे ही नी। <verse eid="1CO 7:30"/><verse number="31" style="v" sid="1CO 7:31"/>आरू इनीये संसार क साथे व्यवहार करनेवावा ओसो होय, कि संसार ही क नी लेय; काहकि इनीये संसार की वात खत्म हुयसे जाता छे। रीति आरू व्यवहार बदलता जाता छे। <verse eid="1CO 7:31"/><verse number="32" style="v" sid="1CO 7:32"/>शेवली कावा हाव यो जुवता छे कि तुमू चिंता नी होय। वियाव मानुस पोरबु की वात की चिंता मा रयता छे कि पोरबु क कोसो खुश राखे। <verse eid="1CO 7:32"/><verse number="33" style="v" sid="1CO 7:33"/>पुन वियाव मानुस संसार की वात करी चिंता मा रयता छे कि आपसी बायर क काही रीति छे खुश राखे। <verse eid="1CO 7:33"/><verse number="34" style="v" sid="1CO 7:34"/>वियाव आरू अवियाव आरू वियाव मा भी भेद छे: वियाव पोरबु की चिंता मा रयती छे कि वो देह आरू आत्मा दुय मा चुखलो होय, पुन वियाव संसार की चिंता मा रयती छे कि आपने घर वावो खुश राखे। <verse eid="1CO 7:34"/><verse number="35" style="v" sid="1CO 7:35"/>हाव यो वात तुमरे ही लाभ क करता कयता छे, नी कि तुमू फंसाने क करता, वरना एरकरीन कि जोसो शोभा देता छे वोसो ही कर्‍या जाय, कि तुमू एक मनीया हईन पोरबु की सेवा मा लाग रयो।<verse eid="1CO 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36"/>यदि काही यो समझे कि हाव आपसी उना छल्ली क हक मार रया छे, जेरी जुवानी ढव रयी छे, आरू जरूरत भी होय, तो जोसो जुवे वोसो करे, इनाम पाप नी, वो ओको वियाव हुयने देय। <verse eid="1CO 7:36"/><verse number="37" style="v" sid="1CO 7:37"/>पुन जो मन मा दृढ़ रयता छे, आरू ओको जरूरत नी वरना आपसी मरजी पर हक राखता होय, आरू आपने मन मा यो वात ठान लेदा से कि वो आपसी छल्ली पोराय क वियाव राखछे, वो वारलो करता छे। <verse eid="1CO 7:37"/><verse number="38" style="v" sid="1CO 7:38"/>एरकरीन जो आपसी छल्ली क वियाव कर देता छे, वो वारलो छे, आरू जो वियाव नी कर देता, वो आरू भी वारलो करता छे। <verse eid="1CO 7:38"/><verse number="39" style="v" sid="1CO 7:39"/>जव तक बायर क घरवाळो जीवता रयता छे, तव तक वो ओका सी बन्धी होयी छे; पुन यदि ओको घर वावो मर जाय तो जिना छे जुवे वियाव कर सकती छे, पुन केवल वो पोरबु मा। <verse eid="1CO 7:39"/><verse number="40" style="v" sid="1CO 7:40"/>पुन जोसी छे यदि वोसी ही रये, तव सवटो खुश तो मारे विचार मा आरू भी धन्य छे; आरू हाव समझता छे कि यहोवा–भगवान क आत्मा मखे मा भी छे।<verse eid="1CO 7:40"/></para>
  <chapter eid="1CO 7"/>
  <chapter number="8" style="c" sid="1CO 8"/>
  <para style="s">मुर्ती क चढ़ाया गया भोजन</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1"/>हिमी मुर्ती क चढ़ाया गया भोजन क विषय मा हामु जानता छे कि हामु सब क ज्ञान छे। ज्ञान डाहळाय पैदा करता, पुन मोंग छे बढ़ती होयती छे। <verse eid="1CO 8:1"/><verse number="2" style="v" sid="1CO 8:2"/>यदि काही समझे कि हाव काही जानता छे, तो जोसो जाननो जुवे वोसो हिमी तक नी जानता। <verse eid="1CO 8:2"/><verse number="3" style="v" sid="1CO 8:3"/>पुन यदि काही यहोवा–भगवान छे मोंग राखता छे, तो यहोवा–भगवान ओको जानता छे। <verse eid="1CO 8:3"/><verse number="4" style="v" sid="1CO 8:4"/>शेवली कावा मुर्ती क सामने बलि की होयी समान क खाने क करता विषय मा हामु जानता छे कि मुर्ती धरतीम मा काही भी नी, आरू एक क छुड़ आरू काही यहोवा–भगवान नी। <verse eid="1CO 8:4"/><verse number="5" style="v" sid="1CO 8:5"/>यदि आकाश मा आरू धरती पर घोणा छे भगवान कवाये छे जोसो कि घोणा छे भगवान आरू घोणा छे पोरबु छे। <verse eid="1CO 8:5"/><verse number="6" style="v" sid="1CO 8:6"/>तौभी हामरे करता तो एक ही यहोवा–भगवान छे: मतलब बास जेरी आरू छे सब समान छे, आरू हामु तीनी क करता छे। आरू एक ही पोरबु छे, मतलब ईशु मसीह ओका द्वारा सब समान होयी, आरू हामु भी तीनी क द्वारा छे।<verse eid="1CO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7"/>पर सब क यो ज्ञान नी, पुन काही तो हिमी तक मुर्ती क काही समझने क कारण मुर्ती क सामने बलि करी होयी समान क काही समझीन खाता छे, आरू ओको विवेक निर्बल हुयने क कारण विटळ होय जाता छे। <verse eid="1CO 8:7"/><verse number="8" style="v" sid="1CO 8:8"/>भोजन हामु यहोवा–भगवान क निकट नी पुचाड़तो। यदि हामु नी खाय तो हामरी काही हानि नी, आरू यदि खाय तो काही लाभ नी। <verse eid="1CO 8:8"/><verse number="9" style="v" sid="1CO 8:9"/>पुन सावधान! ओसो नी होय कि तुमरी यो स्वतंत्रता काही निर्बलो क करता ठुकर क कारण होय जाय। <verse eid="1CO 8:9"/><verse number="10" style="v" sid="1CO 8:10"/>काहकि यदि काही तुखे ज्ञानी क मुर्ती क मंदिर मा भोजन करता देखे आरू वो निर्बल जन होय, तो काय ओका मन क प्रयोग मुर्ती क सामने बलि करी होयी समान खाने क साहस नी होय जाछे। <verse eid="1CO 8:10"/><verse number="11" style="v" sid="1CO 8:11"/>इनीये रीति छे तारे ज्ञान क कारण वो निर्बल भाईस ओका करता मसीह मरीन, नष्ट होय जाछे। <verse eid="1CO 8:11"/><verse number="12" style="v" sid="1CO 8:12"/>इनीये प्रकार भाईस क विरोध गुणेहगार करने छे आरू ओको निर्बल मन क चोट पुचाड़ने छे, तुमू मसीह क विरोध गुणेहगार करता होय। <verse eid="1CO 8:12"/><verse number="13" style="v" sid="1CO 8:13"/>इनीये कारण यदि भोजन मारा भाईस क ठुकर खावड़ाया, तो हाव कदी काही रीति छे मास नी खासे, नी होय कि हाव आपने भाईस क करता ठुकर क कारण बनु।<verse eid="1CO 8:13"/></para>
  <chapter eid="1CO 8"/>
  <chapter number="9" style="c" sid="1CO 9"/>
  <para style="s">प्रेरितन क हक आरू जिम्मेवारी</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1"/>काय हाव छुटक नी हय? काय हाव प्रेरितन नी? काय हाव ने ईशु क जो हामरा पोरबु छे, नी देखे? काय तुमू पोरबु मा मारे बनायो हुयो नी? <verse eid="1CO 9:1"/><verse number="2" style="v" sid="1CO 9:2"/>यदि हाव दिसरा क करता प्रेरित नी, तौभी तुमरे करता तो छे; काहकि तुमू पोरबु मा मारी प्रेरिताई हुयने क निसानी छे। <verse eid="1CO 9:2"/><verse number="3" style="v" sid="1CO 9:3"/>जो मखे हेरता छे, ओको करता योही मारो जवाब छे। <verse eid="1CO 9:3"/><verse number="4" style="v" sid="1CO 9:4"/>काय हामु खाने पीने क हक नी? <verse eid="1CO 9:4"/><verse number="5" style="v" sid="1CO 9:5"/>काय हामुक यो हक नी, कि कोय मसीह बहिनीस क साथ मा वियाव करीन उको लीन फिरजे, जसा दिसरा सेवक आरू पोरबुन भाई आरू कैफा करे? <verse eid="1CO 9:5"/><verse number="6" style="v" sid="1CO 9:6"/>या आरू केवल मखे आरू बरनबास क ही हक नी कि कमाय करने छुड़े। <verse eid="1CO 9:6"/><verse number="7" style="v" sid="1CO 9:7"/>कुन कदी आपसी गिरह छे खाईन सिपाही क काम करता छे? कुन अंगुर की वाड़ी लागाड़ीन ओको फोव नी खाता? कुन हावढरा की राखवावी करने ओको दूध नी पीता? <verse eid="1CO 9:7"/><verse number="8" style="v" sid="1CO 9:8"/>काय हाव यो वात मानुस ही की रीति पर बुलता छे, ओसो नियम शास्त्र नी कयता छे? <verse eid="1CO 9:8"/><verse number="9" style="v" sid="1CO 9:9"/><note caller="+" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="1TI 5:18">1 तीमुथियुस 5:18</ref></char></note>काहकि मूसा की व्यवस्था मा लिख्यो छे, “दांवते टेहाव चालता होया बैल क मुय नी बांधने।” काय यहोवा–भगवान बुल्यो की ही चिंता करता छे? <verse eid="1CO 9:9"/><verse number="10" style="v" sid="1CO 9:10"/>या विशेष करीन हामरे करता कयता छे। हाव, हामरे करता ही लिख्या गया, काहकि वारू छे कि जोतनेवावा आश छे जोते आरू दांवनेवावा भागी हुयने की आश छे दांवनी करे। <verse eid="1CO 9:10"/><verse number="11" style="v" sid="1CO 9:11"/><note caller="+" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="ROM 15:27">रोमियो 15:27</ref></char></note>शेवली कावा जव कि हामु ने तुमरे करता आत्मिक समान बोई, तो काय यो काही मोटी वात छे कि तुमरी शारीरिक समान की कमाय काटे। <verse eid="1CO 9:11"/><verse number="12" style="v" sid="1CO 9:12"/>जव दिसरा क तुमू पर यो हक छे, तो काय हामरा इनासे सवटो नी होयछे? पुन हामु यो हक क काम मा नी लायो; पुन सब काही सहते छे हामरे द्वारा मसीह क खुश खबर मा काही रूकावट नी होय। <verse eid="1CO 9:12"/><verse number="13" style="v" sid="1CO 9:13"/>काय तुमू नी जानता कि जो मंदिर मा सेवा करता छे, वो मंदिर मा छे खाता छे; आरू जो वेदी की सेवा करता छे, वो वेदी पर राख्यो साथे भागी हुयसे छे? <verse eid="1CO 9:13"/><verse number="14" style="v" sid="1CO 9:14"/><note caller="+" style="x"><char style="xo" closed="false">9:14 </char><char style="xt" closed="false"><ref loc="MAT 10:10">मत्ती 10:10</ref>; <ref loc="LUK 10:7">लूका 10:7</ref></char></note>इनी रीति छे पोरबु ने भी ठेराया कि जो मानसे खुश खबर सोमवता छे, उनकी जीविका खुश खबर छे होय। <verse eid="1CO 9:14"/><verse number="15" style="v" sid="1CO 9:15"/>पुन हाव इन मा छे काही भी वात काम मा नी लाया, आरू हाव ने यो वात एरकरीन नी लिखी कि मारे करता ओसो कर्‍या जाय, काहकि इनासे तो मारो मरनो ही भलो छे कि काही मारे डाहळाय क रिकामो ठेराया। <verse eid="1CO 9:15"/><verse number="16" style="v" sid="1CO 9:16"/>यदि हाव खुश खबर सोमवावी, तो मारे करता काही डाहळाय की वात नी; काहकि यो तो मारे करता पाको छे। यदि हाव खुश खबर नी सोमवावी, तो मखे पर हाय! <verse eid="1CO 9:16"/><verse number="17" style="v" sid="1CO 9:17"/>काहकि यदि आपसी मरजी छे, यो करता छे तो दाहडकी मखे मिवती छे, आरू यदि आपसी मरजी छे नी करता तौभी भण्डारीपन मखे आपी गया छे। <verse eid="1CO 9:17"/><verse number="18" style="v" sid="1CO 9:18"/>तो मारी कुन सी दाहडकी छे? यो कि खुश खबर सोमवावने मा हाव मसीह क खुश खबर विना पोशा करता खुशी छे संदेश सोमवाय दीस, याहा तक कि खुश खबर मा जो मारो हक छे ओको भी हाव पूरी रीति छे काम हाव नी लावु। <verse eid="1CO 9:18"/><verse number="19" style="v" sid="1CO 9:19"/>काहकि सब छे स्वतंत्र हुयने पर भी हाव ने आपने आप क सब क बना दिया छे कि सवटो मानसे क खेंची लावु। <verse eid="1CO 9:19"/><verse number="20" style="v" sid="1CO 9:20"/>हाव यहूदि यो क करता यहूदि बना कि यहूदि यो क खेंची लावु। जे मानसे व्यवस्था क हको तळे छे ओको करता हाव व्यवस्था क हको तळे बना कि तीनुक जो व्यवस्था क हको तळे छे, खेंची लावु। <verse eid="1CO 9:20"/><verse number="21" style="v" sid="1CO 9:21"/>व्यवस्था क करता हाव जो यहोवा–भगवान की व्यवस्था छे हीन नी पुन मसीह की व्यवस्था क हको तळे छे व्यवस्थाहीन सा बना कि बाहरजातीयान क खेंची लावु। <verse eid="1CO 9:21"/><verse number="22" style="v" sid="1CO 9:22"/>हाव निर्बलो क करता निर्बल सा बना कि निर्बलो क खेंची लावु। हाव सब मानुस क करता सब काही बना कि काही नी काही रीति छे कयी एक क उध्दार करावु। <verse eid="1CO 9:22"/><verse number="23" style="v" sid="1CO 9:23"/>हाव यो सब काही खुश खबर क करता छे कि दिसरा क साथे ओको भागी होय जावु।<verse eid="1CO 9:23"/></para>
  <para style="s">मसीह दौड़</para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 9:24"/>काय तुमू नी जानता कि दौड़ मा तो दौड़ता सब ही छे, पुन इनाम एक ही ली छे? तुमू वोसो ही दौड़ो कि जीतु। <verse eid="1CO 9:24"/><verse number="25" style="v" sid="1CO 9:25"/>हर एक पेहलवान सब प्रकार क संयम छे; वे तो एक मुरझानेवावा हार क छे जो मुरझाने क नी। <verse eid="1CO 9:25"/><verse number="26" style="v" sid="1CO 9:26"/>एरकरीन हाव तो इनी रीति छे हार छे लड़ायतो छे, पुन उना क समान नी जो वाहवो पेटतो हुयो लड़ायतो छे। <verse eid="1CO 9:26"/><verse number="27" style="v" sid="1CO 9:27"/>पुन हाव आपसी देह क मारतो कूटतो आरू वश मा लावतो छे, ओसो नी होय कि दिसरा क खबर करीन हाव आप ही काही रीति छे निकम्मा ठेहरीस।<verse eid="1CO 9:27"/></para>
  <chapter eid="1CO 9"/>
  <chapter number="10" style="c" sid="1CO 10"/>
  <para style="s">इस्राएल क इतिहास छे चेतावनी</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1"/>हे भाईस आरू बहनीस, हाव नी जुवता कि तुमू इनीये वात छे अनजान रयो कि हामरे सब बाबदादा वादवा क नेचो होतो, आरू सब क दरिया क वीचमा छे पार होय गयो; <verse eid="1CO 10:1"/><verse number="2" style="v" sid="1CO 10:2"/>आरू सब ने वादवा मा आरू दरिया मा, मूसा क बपतिस्मा लेदो; <verse eid="1CO 10:2"/><verse number="3" style="v" sid="1CO 10:3"/>आरू सब ने एक ही आत्मिक भोजन कर्‍या; <verse eid="1CO 10:3"/><verse number="4" style="v" sid="1CO 10:4"/>आरू सब ने एक ही आत्मिक जल पीदा, काहकि वो ओको आत्मिक चट्टान छे पीता हुता जो ओको साथ मा चालती होती, आरू वो चट्टान मसीह होतो। <verse eid="1CO 10:4"/><verse number="5" style="v" sid="1CO 10:5"/>पुन यहोवा–भगवान उनमा छे घोणा छे खुश नी हुयो, एरकरीन वो जंगल मा डील बिसच होय गयो। <verse eid="1CO 10:5"/><verse number="6" style="v" sid="1CO 10:6"/>यो वात हामरे करता सपनो ठेहर्‍य, कि जोसो त्या लालस कर्‍या, वोसो हामु बुरी समान क लालस नी कर्‍या; <verse eid="1CO 10:6"/><verse number="7" style="v" sid="1CO 10:7"/>आरू नी तुमू मुर्तिपूजक बनु जोसो कि उनमा छे कोतरा बन गया हुता, जोसो लिख्या छे, “मानसे खाने पीने बठ्या, आरू खेलने कूदने उठ्या, आरू एक दिसरा साथे कुकर्म करने लाग्या।” <verse eid="1CO 10:7"/><verse number="8" style="v" sid="1CO 10:8"/>आरू नी हामु व्यभिचार कर्‍या, जोसो उनमा छे कोतरा ने कर्‍या; आरू एक दाहड़ा मा तेवीस हजार मर गया। <verse eid="1CO 10:8"/><verse number="9" style="v" sid="1CO 10:9"/>आरू नी हामु पोरबु क पारखे, जोसो उनमा छे कोतरा ने कर्‍या, आरू घड़सो क द्वारा नष्ट कर्‍या गया। <verse eid="1CO 10:9"/><verse number="10" style="v" sid="1CO 10:10"/>आरू नी तुमू कुरकुर करो, जिना रीति छे उन मा छे कोतरा कुरकुर करीन आरू नष्ट करनेवावा क द्वारा नष्ट कर्‍या गया। <verse eid="1CO 10:10"/><verse number="11" style="v" sid="1CO 10:11"/>पुन यो सब वात, जो उन पर पड़ी, सपनो कामो रीति पर होती; आरू वो हामरी चेतावनी क करता जो धरती क आखरी टेहाव मा रयता छे लिखी गयी छे। <verse eid="1CO 10:11"/><verse number="12" style="v" sid="1CO 10:12"/>एरकरीन जो समझता छे, “हाव स्थिर छे” वो चोकचौळीया रये कि कयी गिर नी पड़्या। <verse eid="1CO 10:12"/><verse number="13" style="v" sid="1CO 10:13"/>तुमू काही ओसी परीक्षा मा नी पड़्या, जो मानुस क सहने छे बाहरता छे। यहोवा–भगवान सच्चा छे आरू वो तुम्हे शक्ति छे बाहरता परीक्षा मा नी पड़ने देसे, वरना परीक्षा क साथे निकास भी करसे कि तुमू सह सके।<verse eid="1CO 10:13"/></para>
  <para style="s">मुर्तिपूजक क विरोध चेतावनी</para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14"/>इनीये कारण, हे मारे मोंगावु भाईस बहनीस मुर्तिपूजक छे वाच रयो। <verse eid="1CO 10:14"/><verse number="15" style="v" sid="1CO 10:15"/>हाव बुध्दिमान जानीन तुमू छे कयता छे: जो हाव कयता छे, ओको तुमू पारखु। <verse eid="1CO 10:15"/><verse number="16" style="v" sid="1CO 10:16"/>वो धन्यवाद क वाटको, जिना पर हामु धन्यवाद करता छे; काय मसीह क लुहूय करी सहभागिता नी? वो रोटा जिनाक हामु तुड़ता छे, काय वो मसीह की देह की सहभागिता नी? <verse eid="1CO 10:16"/><verse number="17" style="v" sid="1CO 10:17"/>एरकरीन कि एक ही रोटा छे तो हामु भी जो घोणा छे, एक देह छे: काहकि हामु सब ओकी एक रोटा मा भागी हुयसे छे। <verse eid="1CO 10:17"/><verse number="18" style="v" sid="1CO 10:18"/>जो डील क इस्त्राएली छे, उनको देखु: काही बलिदान क खाने वावा यहोवा–भगवान की वेदी क सहभागी नी? <verse eid="1CO 10:18"/><verse number="19" style="v" sid="1CO 10:19"/>पछु हाव काय कयता छे? काय यो कि मुर्ती पर चढ़ाया गया बलिदान काही छे या मुर्ती काही छे? <verse eid="1CO 10:19"/><verse number="20" style="v" sid="1CO 10:20"/>नी, वरना यो कि गैरयहुदी जो बलिदान करता छे; वे यहोवा–भगवान क करता नी पुन साहळा क करता बलिदान करता छे आरू हाव नी जुवता कि तुमू साहळा क सहभागी होय। <verse eid="1CO 10:20"/><verse number="21" style="v" sid="1CO 10:21"/>तुमू पोरबु क वाटको आरू साहळा क वाटको दुयू मा छे नी पीय सकता। तुमू पोरबु की हावज आरू साहळा की हावज दुयू क साझी नी होय सकता। <verse eid="1CO 10:21"/><verse number="22" style="v" sid="1CO 10:22"/>काय हामु पोरबु क रीस देवाड़ने जुवता छे? काय हामु ओको छे शक्तिमान छे?<verse eid="1CO 10:22"/></para>
  <para style="s">सब काही यहोवा–भगवान की महिमा क करता</para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:23 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 6:12">1 कुरन्थियो 6:12</ref>
      </char>
    </note>काही मानसे कयता, सब समान मारे करता वारू तो छे, पुन सब लाभ करी नी। दिसरा मानसे सब समान मारे करता वारू तो छे, पुन सब समान छे बढ़ती नी। <verse eid="1CO 10:23"/><verse number="24" style="v" sid="1CO 10:24"/>काही आपसी ही भलाई क नी, वरना दिसरा की भलाई क हेरे। <verse eid="1CO 10:24"/><verse number="25" style="v" sid="1CO 10:25"/>जो काही कस्साइयो क याहा वेचायता छे, वो खावु आरू मन मारो खाय नी क कारण काही नी पुछ्या। <verse eid="1CO 10:25"/><verse number="26" style="v" sid="1CO 10:26"/>“काहकि धरती आरू ओको की भरपूरी पोरबु की छे।” <verse eid="1CO 10:26"/><verse number="27" style="v" sid="1CO 10:27"/>यदि विनभुरसीया मा छे काही तुम्हे नेवता देय, आरू तुमू जाने जुवता, तो जो काही तुमरे सामने राख्य जाय चो खावु: आरू मारो मन क कारण काही नी पुछ्या। <verse eid="1CO 10:27"/><verse number="28" style="v" sid="1CO 10:28"/>पुन यदि काही तुमू छे कये, “यो तो मुर्ती क बलि करी होयी समान छे” तो ओकी कोवनेवावा क कारण आरू आमरो मन विवेक क कारण नी खावु। <verse eid="1CO 10:28"/><verse number="29" style="v" sid="1CO 10:29"/>मारो मतलब तारो विवेक नी, पुन ओको दिसरा क। भला, मारी स्वतंत्रता दिसरा क विचार छे काय पारखी जाय? <verse eid="1CO 10:29"/><verse number="30" style="v" sid="1CO 10:30"/>यदि हाव धन्यवाद करीन साझी हुयसे छे, तो जिना पर हाव धन्यवाद करता छे ओका कारण मारी बदनामी काय होयती छे?<verse eid="1CO 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31"/>एरकरीन तुमू जुवे खावु, जुवे पीवु, जुवे जो काही करू, सब काही यहोवा–भगवान की महिमा क करता करू। <verse eid="1CO 10:31"/><verse number="32" style="v" sid="1CO 10:32"/>तुमू नी यहूदि, नी यूनानीयो, आरू नी यहोवा–भगवान की मंडळी क करता ठुकर क कारण बनु। <verse eid="1CO 10:32"/><verse number="33" style="v" sid="1CO 10:33"/>जोसो हाव भी सब बात मा सब क खुश राखता छे, आरू आपसा नी पुन घोणा क लाभ हेरता छे कि वो उध्दार देखछे।<verse eid="1CO 10:33"/></para>
  <chapter eid="1CO 10"/>
  <chapter number="11" style="c" sid="1CO 11"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:1 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 4:16">1 कुरन्थियो 4:16</ref>; <ref loc="PHP 3:17">फिलिप्पियो 3:17</ref></char>
    </note>तुमू मारी सी चाल चालु जोसो हाव मसीह की सी चाल चालता छे।<verse eid="1CO 11:1"/></para>
  <para style="s">आराधना मा मुनक ढाकने</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2"/>हे भाईस, हाव तुमू सराहता छे कि सब वात मा तुमू मखे स्मरण करता होय; आरू जो शिक्षा मा तुमू सौपी छे, ओको पालन करता होय। <verse eid="1CO 11:2"/><verse number="3" style="v" sid="1CO 11:3"/>पुन मा जुवता छे कि तुमू यो जान लेवु कि हर एक मानुस क मुनक मसीह छे, आरू बायर क मुनक मानुस छे, आरू मसीह क मुनक यहोवा–भगवान छे। <verse eid="1CO 11:3"/><verse number="4" style="v" sid="1CO 11:4"/>जो मानुस मुनक ढाकने होया प्रार्थना या यहोवा–भगवान आरू करता छे, वो आपने मुनक क विजुत करता छे। <verse eid="1CO 11:4"/><verse number="5" style="v" sid="1CO 11:5"/>पुन जो बायर उघाड़ मुनक प्रार्थना या यहोवा–भगवान करता छे, वो आपने मुनक क विजुत करती छे, काहकि वो मुण्डी हुयने क बराबर छे। <verse eid="1CO 11:5"/><verse number="6" style="v" sid="1CO 11:6"/>यदि बायर लुगड़ा नी पागरने तो झटा भी काटाड़ लेय; यदि बायर क करता झटा काटने या मुनको बुड़ने करने लाज की वात छे, तो लुगड़ा पागरने। <verse eid="1CO 11:6"/><verse number="7" style="v" sid="1CO 11:7"/>हाव, मानुस क आपनो मुनक ढाकने वारू नी, काहकि वो यहोवा–भगवान क रूप आरू महिमा छे; पुन बायर मानुस की महिमा छे। <verse eid="1CO 11:7"/><verse number="8" style="v" sid="1CO 11:8"/>काहकि मानुस बायर छे नी होया, पुन बायर मानुस छे होयी छे; <verse eid="1CO 11:8"/><verse number="9" style="v" sid="1CO 11:9"/>आरू मानुस बायर क करता नी सिरजा गया, पुन बायर मानुस क करता सिरजा गयी छे। <verse eid="1CO 11:9"/><verse number="10" style="v" sid="1CO 11:10"/>इनी करता सोरगदूत क कारण बायर क वारू छे कि हक क सहलानी समझीन आपसा मुनका पर राखे। <verse eid="1CO 11:10"/><verse number="11" style="v" sid="1CO 11:11"/>तव पोरबु मा नी तो बायर विना मानुस, आरू नी मानुस विना बायर क छे। <verse eid="1CO 11:11"/><verse number="12" style="v" sid="1CO 11:12"/>काहकि जोसो बायर मानुस छे, वोसो ही मानुस बायर क द्वारा छे; पुन सब समान यहोवा–भगवान छे। <verse eid="1CO 11:12"/><verse number="13" style="v" sid="1CO 11:13"/>तुमू आप ही विचार करू, काय बायर क उघाड़ा मुनक यहोवा–भगवान छे प्रार्थना करने शोभा देता छे? <verse eid="1CO 11:13"/><verse number="14" style="v" sid="1CO 11:14"/>काय स्वाभाविक रीति छे भी तुमू नी जानता कि यदि मानुस नाबला झटा राखतो, तो ओका करता विजुत छे। <verse eid="1CO 11:14"/><verse number="15" style="v" sid="1CO 11:15"/>पुन यदि बायर नाबला झटा राखतो तो ओको करता शोभा छे, काहकि झटा उना क लुगड़ा क करता दिया गया छे। <verse eid="1CO 11:15"/><verse number="16" style="v" sid="1CO 11:16"/>पुन यदि काही विवाद करनो जुवे, तो यो जान लेय कि नी हामरी आरू नी यहोवा–भगवान की मंडळी की ओसी रीति छे। <verse eid="1CO 11:16"/><verse number="17" style="v" sid="1CO 11:17"/>पुन यो हुकुम देता हुयो हाव तुमू नी सराहता, एरकरीन कि तुम जव यहोवा–भगवान की आराधना एखठा हुयने छे भलाई नी, पुन हानि होयती छे। <verse eid="1CO 11:17"/><verse number="18" style="v" sid="1CO 11:18"/>काहकि पेहल तो हाव यो सोमवता छे, कि जव तुमू मंडळी मा एखठा हुयसे होय तो तुमू तो तुमू मा फूट होयती छे, आरू हाव इनीये पर काही काही विश्वास भी करता छे। <verse eid="1CO 11:18"/><verse number="19" style="v" sid="1CO 11:19"/>काहकि दलबन्दी भी तुमू मा पाको होयछे, एरकरीन कि जो मानसे तुमू मा सचा छे वो प्रगट होय जाय। <verse eid="1CO 11:19"/><verse number="20" style="v" sid="1CO 11:20"/>शेवली कावा तुमू जो एक धरती मा एखठा हुयसे होय तो यो पोरबु भोज खाने क करता नी, <verse eid="1CO 11:20"/><verse number="21" style="v" sid="1CO 11:21"/>काहकि खाने क टेहाव एक दिसरा छे पेहल आपनो खाय लेदा छे इनीये प्रकार काही तो भूखलो रयतो छे आरू काही तो मतवावा होय जातो छे। <verse eid="1CO 11:21"/><verse number="22" style="v" sid="1CO 11:22"/>काय खाने–पीने क करता तुमरे घर नी? या यहोवा–भगवान की मंडळी क तुच्छ जानता होय, आरू जिनके साथे नी छे तीनुक लज्जित करता होय, हाव तुमू छे काय कयो? काय इनीये वात मा तुमरी बढ़ाई करू? नी, हाव बढ़ाई नी करता।<verse eid="1CO 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23"/>काहकि यो वात मखे पोरबु छे पुच्या, आरू हाव ने तुमू भी पुचाड़ देदी कि पोरबु ईशु ने जिना रात वो धराय गयो, रोटा लेदो, <verse eid="1CO 11:23"/><verse number="24" style="v" sid="1CO 11:24"/>आरू यहोवा–भगवान क धन्यवाद करीन ओको तुड़ीन आरू कयो, “यो मारी देह छे, जो तुमरे करता छे: मारे स्मरण क करता योही कर्‍या करो।” <verse eid="1CO 11:24"/><verse number="25" style="v" sid="1CO 11:25"/>इनी रीति छे त्यो बियारी क पछव गिलास भी लेदा आरू कयो, “यो वाटको मारे लुहूय मा नोवली भोन्या छे: जव कदी पीवो, तो मारे स्मरण क करता योही कर्‍या करो।” <figure style="fig" alt="meal with his disciples Jesus eating the Passover" file="lb00320c।tif" size="span" copy="Horace Knowles ©" ref="11:23">ईशु आपना सेवको साथे सेवली कावा रोटा खादु</figure><verse eid="1CO 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 11:26"/>काहकि जव कदी तुमू यो रोटा खाता आरू इनीये गिलास मा छे पीतो होय, तो पोरबु की मरन क जव तक वो नी आश, खबर करता होय। <verse eid="1CO 11:26"/><verse number="27" style="v" sid="1CO 11:27"/>एरकरीन जो काही गलत रीति छे पोरबु की रोटा खाय या ओका गिलास मा छे पीता, वो पोरबु की देह आरू लुहूय क गुणेगार ठरछे। <verse eid="1CO 11:27"/><verse number="28" style="v" sid="1CO 11:28"/>एरकरीन मानुस आपने आप क हेर लेदा आरू इनी रीति छे रोटा मा खाय, आरू इनीये गिलास मा छे पीदो। <verse eid="1CO 11:28"/><verse number="29" style="v" sid="1CO 11:29"/>काहकि जो खाता पीता समय पोरबु की देह क नी उळखने, वो इनीये खाने आरू पीने छे आपने ऊपर दण्ड लावता छे। <verse eid="1CO 11:29"/><verse number="30" style="v" sid="1CO 11:30"/>इनी कारण तुमू मा घोणा छे निर्बल आरू बीमार छे, आरू घोणा छे सुवी भी गया। <verse eid="1CO 11:30"/><verse number="31" style="v" sid="1CO 11:31"/>यदि हामु आपने आप क हेरता तो यहोवा–भगवान छे हामु दण्ड नी देखता। <verse eid="1CO 11:31"/><verse number="32" style="v" sid="1CO 11:32"/>पुन पोरबु हामु दण्ड दीन हामरी ताड़ना करता छे, एरकरीन कि हामु संसार क साथे दोषी नी ठरछे। <verse eid="1CO 11:32"/><verse number="33" style="v" sid="1CO 11:33"/>एरकरीन, हे मारा भाईस आरू बहनीस जव पोरबु भोज तुमू खाने क करता एखठा हुयसे होय तो एक दिसरा क करता ठेहर्‍या करो। <verse eid="1CO 11:33"/><verse number="34" style="v" sid="1CO 11:34"/>यदि काही भूखलो होय तो आपने घर मा खाय लेय, जिनासे तुमरा एखठा हुयने दण्ड क कारण नी होय। रोवली वात क हाव आवीन ठीक करसे।<verse eid="1CO 11:34"/></para>
  <chapter eid="1CO 11"/>
  <chapter number="12" style="c" sid="1CO 12"/>
  <para style="s">आत्मिक वरदान</para>
  <para style="s">चुखलो आत्मा क वरदान</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1"/>हे भाईस, हाव नी जुवता कि तुमू चुखली आत्मा क वरदान क विषय मा अनजान रयो। <verse eid="1CO 12:1"/><verse number="2" style="v" sid="1CO 12:2"/>तुमू जानता होय कि जव तुमू गैरयहुदी हुता, तो गूंगी मुर्ती क पछव जोसो चालाड्या जातो होतो वोसो चालता हुता। <verse eid="1CO 12:2"/><verse number="3" style="v" sid="1CO 12:3"/>एरकरीन हाव तुमूक चेतावनी देता छे कि जो काही यहोवा–भगवान की आत्मा की अगवाय छे आरू बुलता छे, वो नी कयता कि ईशु स्रापित छे; आरू नी काही चुखलो आत्मा क विना कय सकता छे कि ईशु पोरबु छे।<verse eid="1CO 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:4 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 12:6-8">रोमियो 12:6-8</ref>
      </char>
    </note>वरदान तो काही प्रकार क छे, पुन आत्मा एक ही छे; <verse eid="1CO 12:4"/><verse number="5" style="v" sid="1CO 12:5"/>आरू सेवा भी काही प्रकार की छे, पुन वरदान देनेवावा चुखलो आत्मा एक ही छे; <verse eid="1CO 12:5"/><verse number="6" style="v" sid="1CO 12:6"/>आरू शक्तिशाली काम काही प्रकार क छे, पुन यहोवा–भगवान एक ही छे, जो सब मा हर प्रकार क शक्ति पैदा करता छे। <verse eid="1CO 12:6"/><verse number="7" style="v" sid="1CO 12:7"/>पुन सब क लाभ पुचाडने क करता हर एक क यहोवा–भगवान की चुखलो आत्मा क हर एक दिया जाता छे। <verse eid="1CO 12:7"/><verse number="8" style="v" sid="1CO 12:8"/>काहकि एक क आत्मा क द्वारा बुध्दि की वात देदी जाती छे, आरू दिसरा क ओकी आत्मा क लारे ज्ञान की वात। <verse eid="1CO 12:8"/><verse number="9" style="v" sid="1CO 12:9"/>काही क ओकी आत्मा छे विश्वास, आरू काही क ओकी एक आत्मा छे वारू करने क वरदान दिया जाता छे। <verse eid="1CO 12:9"/><verse number="10" style="v" sid="1CO 12:10"/>पछु कोयक शक्ति क काम करनेन शक्ति, आरू कोयक यहोवा–भगवान क संदेश दान न, आरू कोयक क आत्मा क पारख, आरू कोयक क काहय प्रकार क भाषा, आरू कोयक क भाषा, आरू काहनी भाषा क मतलब कयनो। <verse eid="1CO 12:10"/><verse number="11" style="v" sid="1CO 12:11"/>पुन यो सब शक्तिशाली काम चो एक आत्मा करे छे, आरू जिनाक जो जुवता छे वो वाट देता छे।<verse eid="1CO 12:11"/></para>
  <para style="s">देह एक अंग काहय</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:12 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 12:4">रोमियो 12:4</ref>,<ref loc="ROM 12:5">5</ref></char>
    </note>काहकि जिना प्रकार देह तो एक छे आरू ओको अंग घोणा छे, आरू उना एक देह क सब अंग घोणा हुयने पर भी सब हाववीन एक ही देह छे, ओकी प्रकार मसीह क डील छे। <verse eid="1CO 12:12"/><verse number="13" style="v" sid="1CO 12:13"/>काहकि हामु सब काय यहूदि होय, काय यूनानी, काय दास होय काय स्वतंत्र, एक ही आत्मा क द्वारा एक देह हुयने क करता बपतिस्मा लेदा, आरू हामु सब क एक ही आत्मा पिवाड्या गया।<verse eid="1CO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14"/>एरकरीन की देह मा एक ही अंग नी पुन घोणा छे। <verse eid="1CO 12:14"/><verse number="15" style="v" sid="1CO 12:15"/>यदि पाय कये, “हाव हात नी एरकरीन देह क नी” तो काय वो इनीये कारण देह क नी? <verse eid="1CO 12:15"/><verse number="16" style="v" sid="1CO 12:16"/>आरू यदि कान कये, “हाव डुवा नी, एरकरीन देह क नी” तो काय वो इनीये कारण देह क नी छे? <verse eid="1CO 12:16"/><verse number="17" style="v" sid="1CO 12:17"/>यदि सारी देह डुवा ही होयती तो सोमवने काँ हुता? जव पुरो डिलने सोमवावा ने तव, सुंघनो काँ रया लेदो। <verse eid="1CO 12:17"/><verse number="18" style="v" sid="1CO 12:18"/>पुन खरलो यहोवा–भगवान अंग क आपसी मरजी क लारे एक एक करीन देह मा राखलो छे। <verse eid="1CO 12:18"/><verse number="19" style="v" sid="1CO 12:19"/>यदि वे सब एक ही अंग होयतो, तो देह काँ होयती? <verse eid="1CO 12:19"/><verse number="20" style="v" sid="1CO 12:20"/>पुन हिमी अंग तो घोणा छे, पुन देह एक ही छे। <verse eid="1CO 12:20"/><verse number="21" style="v" sid="1CO 12:21"/>डुवा हात छे नी कय सकती, “मखे तारी जरूरत नी” आरू नी मुनको पाय छे कय सकता छे, “मखे तुमरी जरूरत नी।” <verse eid="1CO 12:21"/><verse number="22" style="v" sid="1CO 12:22"/>पुन देह क वे अंग जो दिसरा छे निर्बल लागता छे, घोणा ही जरूरत छे; <verse eid="1CO 12:22"/><verse number="23" style="v" sid="1CO 12:23"/>आरू डील क जिन डील क हामु विजुत क योग्य नी समझता उका क हामु सवटो विजुत देता छे; आरू हामरे शोभायमान होय जाता छे, <verse eid="1CO 12:23"/><verse number="24" style="v" sid="1CO 12:24"/>पछु भी हामरे शोभायमान डील क इसकी जरूरत नी। पुन यहोवा–भगवान ने डील क ओसो बनाय दिया छे कि जिना डील क विजुत की घटी होती ओकी क आरू भी घोणा विजुत मिव्यो। <verse eid="1CO 12:24"/><verse number="25" style="v" sid="1CO 12:25"/>ताकि देह मा फूट नी पड़े, पुन डील एक दिसरा की बराबर चिंता करसे। <verse eid="1CO 12:25"/><verse number="26" style="v" sid="1CO 12:26"/>एरकरीन यदि एक डील दुःख देखता छे, तो सब डील ओको साथे दुःख देखता छे; आरू यदि एक डील की बढ़ाई होयती छे, तो ओको साथे सब डील खुशी मानता छे।<verse eid="1CO 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27"/>इनी प्रकार तुमू सब हाववीन मसीह की देह होय, आरू अलग अलग ओका डील होय; <verse eid="1CO 12:27"/><verse number="28" style="v" sid="1CO 12:28"/><note caller="+" style="x"><char style="xo" closed="false">12:28 </char><char style="xt" closed="false"><ref loc="EPH 4:11">इफिसियो 4:11</ref></char></note>आरू यहोवा–भगवान ने मंडळी मा अलग अलग मानसे नियुक्त कर्‍या छे: पेहलो प्रेरित, दीसर भविष्यवक्ता, तीसर शिक्षक, पछु शक्ति क काम करनेवावा, पछु वारू करनेवावा, आरू करलो काम करने, आरू तयारी करनेवावा, आरू सब प्रकार की भाषा बुलनेवावा। <verse eid="1CO 12:28"/><verse number="29" style="v" sid="1CO 12:29"/>काय सब प्रेरित छे? काय सब भविष्यवक्ता छे? काय सब शिक्षक छे? काय सब शक्ति क काम करनेवावा छे? <verse eid="1CO 12:29"/><verse number="30" style="v" sid="1CO 12:30"/>काय सब क वारू करने क वरदान मिव्यो छे? काय सब हरेक प्रकार की भाषा बुलता छे? काय सब अनुवाद करता छे <verse eid="1CO 12:30"/><verse number="31" style="v" sid="1CO 12:31"/>काय तुमू मोटा छे मोटा वरदान की धुन मा रयो। पुन हाव तुमू आरू भी सब छे वारू मार्ग देखाडता छे।<verse eid="1CO 12:31"/></para>
  <chapter eid="1CO 12"/>
  <chapter number="13" style="c" sid="1CO 13"/>
  <para style="s">मोंग आखा रया वारू मार्ग</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1"/>यदि हाव मानुस आरू सोरगदूत की बुली बुल्यो आरू मोंग नी राख्यो, तो हाव ठनठन वाजतो हुयो पीतव, आरू झनझन करनाय झांझर छे। <verse eid="1CO 13:1"/><verse number="2" style="v" sid="1CO 13:2"/>यदि यहोवा भगवान संदेश पुचाड़ने वावा आरू सब भेदो आरू सब प्रकार क ज्ञान क समझु, आरू मखे या तक पूरो विश्वास होय कि हाव बयड़ा क हटाय दम, पुन मोंग नी राख्यो, तो हाव काही भी नी। <verse eid="1CO 13:2"/><verse number="3" style="v" sid="1CO 13:3"/>यदि हाव आपसी सम्पूर्ण संपत्ती गरीब क खावाड़ दिदा, या आपसी देह धपाड़ने क करता देय दिदा, आरू मोंग नी राख्यो, तो मखे काही भी लाभ नी।<verse eid="1CO 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4"/>मोंग धीरजवन्त छे, आरू दयावावु छे; मोंग डाह नी करता; मोंग आपसी बढ़ाई नी करता, आरू फूलता नी, <verse eid="1CO 13:4"/><verse number="5" style="v" sid="1CO 13:5"/>वो रीति क छुड़ीन नी चालता, वो आपसी भलाई नी जुवता, झुझलाता नी, दिसरा की बुरी वात नी मानता। <verse eid="1CO 13:5"/><verse number="6" style="v" sid="1CO 13:6"/>अन्याय छे खुश नी हुयसे, पुन सच्चाई छे खुश हुयसे छे। <verse eid="1CO 13:6"/><verse number="7" style="v" sid="1CO 13:7"/>वो सब वात सह लेता छे, सब वात की विश्वास राखता छे, सब वात की आश राखता छे, सब वात मा धीरज धरती छे।<verse eid="1CO 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8"/>मोंग कदी टलता नी; भविष्यवाणी होय, तो समाप्त होय जाछे; भाषा होय, तो हरेक भाषा मा रवछे; ज्ञान होय तो मिट जाछे। <verse eid="1CO 13:8"/><verse number="9" style="v" sid="1CO 13:9"/>काहकि आमरो ज्ञान आधलो छे, आरू यहोवा–भगवान भविष्यद्वाणी आवने आधली; <verse eid="1CO 13:9"/><verse number="10" style="v" sid="1CO 13:10"/>पुन जव यहोवा–भगवान सर्वसिध्द आवसे, तो आधलो हाववीन जाछे। <verse eid="1CO 13:10"/><verse number="11" style="v" sid="1CO 13:11"/>जव हाव पोर्‍य होतो, तो हाव पोर्‍य क समान बुलता हुता, पोर्‍य क सा मन हुता, पोर्‍य की सी समझ होती; पुन जव सियाना होय गया तो पोर्‍या की पेहली वात छुड़ देदी। <verse eid="1CO 13:11"/><verse number="12" style="v" sid="1CO 13:12"/>हिमी हामु आरसा मा धुंधला सा देखाय देता छे, पुन उना टेहाव आमने सामने देखछे; इनीये टेहाव मारो ज्ञान आधलो छे, पुन उना टेहाव ओसी पूरी रीति छे उवखाय गया छे पुन यहोवा–भगवान मखे उवखसे। <verse eid="1CO 13:12"/><verse number="13" style="v" sid="1CO 13:13"/>पर हिमी विश्वास, आश, मोंग यो तीन स्थायी छे, पर इन मा सब छे मोटो मोंग छे।<verse eid="1CO 13:13"/></para>
  <chapter eid="1CO 13"/>
  <chapter number="14" style="c" sid="1CO 14"/>
  <para style="s">चुखलो आत्मा क वरदान की शिक्षा द्वारा</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1"/>मोंग क गती करो, आरू आत्मिक वरदान की भी धुन मा रयो, विशेष करीन यो कि भविष्यव्दाणी करो। <verse eid="1CO 14:1"/><verse number="2" style="v" sid="1CO 14:2"/>काहकि जो दिसरा भाषा मा वात करता छे वो मानुस छे नी पुन यहोवा–भगवान छे वात करता छे; एरकरीन कि ओकी वात काही नी समझता, काहकि यहोवा–भगवान की आरू छे वात आत्मा मा हईन बुलता छे। <verse eid="1CO 14:2"/><verse number="3" style="v" sid="1CO 14:3"/>पुन जो भविष्यव्दाणी करता छे, वो मानुस छे बढ़ती आरू शिक्षा आरू दिलासा की कयता छे। <verse eid="1CO 14:3"/><verse number="4" style="v" sid="1CO 14:4"/>जो ज्ञान की भाषा मा वात करता छे, वो आपसी ही बढ़ती करता छे; पुन जो भविष्यव्दाणी करता छे, वो मंडळी की बढ़ती करता छे। <verse eid="1CO 14:4"/><verse number="5" style="v" sid="1CO 14:5"/>हाव जुवता छे कि तुमू सब ज्ञान की भाषा मा वात करो पुन इनासे सवटो यो जुवता छे कि यहोवा–भगवान की आरू आवने संदेश: काहकि यदि आखी भाषा बुलनेवावा मंडळी की बढ़ती क करता अनुवाद नी करे तो यहोवा–भगवान आरू संदेश देनेवावा ओको बढ़ीन छे।<verse eid="1CO 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 14:6"/>एरकरीन हे भाईस आरू बहनीस यदि हाव तुमरे साथे आवीन आखी भाषा मा वात करसु, आरू प्रकाश या ज्ञान या यहोवा–भगवान की आरू छे संदेश की वात तुमू छे नी कयो तो मखे छे तुमू काय लाभ होयछे? <verse eid="1CO 14:6"/><verse number="7" style="v" sid="1CO 14:7"/>इनी प्रकार यदि निर्जीव समान भी जिनछे ध्वनि निकवती छे, जोसो पाव्वी या बीन, यदि ओको स्वरो मा भेद नी होय तो जो फूकने या वाजाड्यो जाता छे, वो कोसो उवखसे जाछे? <verse eid="1CO 14:7"/><verse number="8" style="v" sid="1CO 14:8"/>आरू यदि तुरही क ओवाज साफ नी होय, तो कुन लड़ाई क करता तीयारी करसे? <verse eid="1CO 14:8"/><verse number="9" style="v" sid="1CO 14:9"/>ओसो ही तुमू भी यदि जीभ साफ साफ वात नी कयो, तो जो काही कयो जाता छे वो कोसो समझ जाछे? तुमू तो हवा छे वात करनेवावा ठरछे। <verse eid="1CO 14:9"/><verse number="10" style="v" sid="1CO 14:10"/>जगमा मा कोतरा ही प्रकार की भाषा काय नी होय, पुन उनमा छे काही भी विना मतलब की नी होयछे। <verse eid="1CO 14:10"/><verse number="11" style="v" sid="1CO 14:11"/>एरकरीन यदि हाव काही भाषा क मतलब नी समझ, तो बुलनेवावा की दृष्टि मा परदेशी ठरछे आरू बुलनेवावा मारी दृष्टि मा परदेशी ठरछे। <verse eid="1CO 14:11"/><verse number="12" style="v" sid="1CO 14:12"/>एरकरीन तुमू भी जव आत्मिक वरदान क धुन मा होय, ते ओसो कोशिस करू कि तुमर वरदान न बढ़ती छे मंडळी न बढ़ती होय। <figure style="fig" alt="musical instruments" file="hk00188c।tif" size="col" copy="Horace Knowles ©" ref="14:7">संगीतन वाजो</figure><verse eid="1CO 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13"/>इनीये कारण जो ज्ञान की भाषा बुलने, वो प्रार्थना करे कि ओका अनुवाद भी करने करता। <verse eid="1CO 14:13"/><verse number="14" style="v" sid="1CO 14:14"/>एरकरीन यदि हाव दिसरा भाषा प्रार्थना करू, तो मारी आत्मा प्रार्थना करती छे पुन मारी बुध्दि काम नी देती। <verse eid="1CO 14:14"/><verse number="15" style="v" sid="1CO 14:15"/>शेवली कावा काय करनो जुवे? हाव आत्मा छे भी प्रार्थना करीस, आरू बुध्दि छे भी प्रार्थना करीस; हाव आत्मा छे गावीस, आरू बुध्दि छे भी गावीस। <verse eid="1CO 14:15"/><verse number="16" style="v" sid="1CO 14:16"/>नी तो यदि तु आत्मा ही छे धन्यवाद करीस, तो पछु मानसे तारो धन्यवाद पर आमेन कोसो कवसे? काहकि वो तो नी जानता कि तु काय छे? <verse eid="1CO 14:16"/><verse number="17" style="v" sid="1CO 14:17"/>तु तो भली भाति धन्यवाद करता छे, पुन दिसरा की बढ़ती नी होयती। <verse eid="1CO 14:17"/><verse number="18" style="v" sid="1CO 14:18"/>हाव आपसा यहोवा–भगवान क धन्यवाद करता छे, कि हाव तुमू सब छे सवटो ज्ञान की भाषा मा बुलता छे। <verse eid="1CO 14:18"/><verse number="19" style="v" sid="1CO 14:19"/>पुन मंडळी मा ज्ञान की सभाषा मा दस हजार वात कयनो छे यो मखे आरू भी वारू जान पड़ता छे, कि दिसरा क सिकाडने क करता बुध्दि छे पाच ही वात कहवो। <verse eid="1CO 14:19"/><verse number="20" style="v" sid="1CO 14:20"/>हे भाईस, बहनीस तुमू समझ मा पोर्‍य नी बनु: बुराई मा तो पोर्‍य रयो, पुन समझ मा सियाने बनु। <verse eid="1CO 14:20"/><verse number="21" style="v" sid="1CO 14:21"/>व्यवस्था किताब मा लिख्यो छे कि पोरबु कयता छे, “हाव अनजानी भाषा बुलनेवावा क द्वारा आरू पराया मुख क द्वारा इन मानसे छे वात करसे तौभी वे मारी नी सोमवने।” <verse eid="1CO 14:21"/><verse number="22" style="v" sid="1CO 14:22"/>एरकरीन ज्ञान की भाषा बुलने क वरदान भुरसीया क करता नी, पुन विनभुरसा क करता सहलानी छे। <verse eid="1CO 14:22"/><verse number="23" style="v" sid="1CO 14:23"/>शेवली कावा यदि मंडळी एक जगमा एखटी होय, आरू सब क सब दिसरा भाषा बुलने, आरू बाहरतावावा या विनभुरसीया मानसे माहीय आय जाय तो काय वे तुमू पागल नी कवीस? <verse eid="1CO 14:23"/><verse number="24" style="v" sid="1CO 14:24"/>पुन यदि सब भविष्यव्दाणी करने लाग्या, आरू काही विनभुरसीया या बाहरतावावा मानसे माहीय आय जाय, तो सब ओको दोषी ठराय देसे आरू पारखी लेछे; <verse eid="1CO 14:24"/><verse number="25" style="v" sid="1CO 14:25"/>आरू मन की डुकाली वात उघडी जाय, आरू तव वो मुय क बुल पाड़ीन यहोवा–भगवान क दण्डवत् करसे, आरू मान लेछे कि सचमुच यहोवा–भगवान तुमरे वीच मा छे। <verse eid="1CO 14:25"/><verse number="26" style="v" sid="1CO 14:26"/>हे भाईस, बहनीस काय करने जुवे? जव तुमू एखठा हुता होय, तो हर एक क हृदय मा भोजन या शिक्षा या दिसरा भाषा या प्रकाश या दिसरा भाषा क मतलब कोवने रयता छे। सब काही आत्मिक बढ़ती क करता हुयने जुवे। <verse eid="1CO 14:26"/><verse number="27" style="v" sid="1CO 14:27"/>यदि दिसरा भाषा मा वात करनो होय, तो दुय या घोणा होय तो तीन जन वाड़ी छे बुलू, आरू एक व्यक्ति अनुवाद करे। <verse eid="1CO 14:27"/><verse number="28" style="v" sid="1CO 14:28"/>पुन यदि अनुवाद करनेवावा नी होय, तो दिसरा भाषा बुलनेवावा मंडळी मा शांत रये, आरू आपने मन छे आरू यहोवा–भगवान छे वात करे। <verse eid="1CO 14:28"/><verse number="29" style="v" sid="1CO 14:29"/>भविष्यवक्ता मा छे दुय या तीन बुलू, आरू शेष मानसे ओको वचन क पारखे। <verse eid="1CO 14:29"/><verse number="30" style="v" sid="1CO 14:30"/>पुन यदि दिसरा पर जो बठ्य छे, काही ईश्वरीय प्रकाश होय, तो पेहला चुप होय जाय। <verse eid="1CO 14:30"/><verse number="31" style="v" sid="1CO 14:31"/>काहकि तुमू सब एक एक कर क भविष्यव्दाणी कर सकता होय, ताकि सब सीखे आरू सब शांती देखछे। <verse eid="1CO 14:31"/><verse number="32" style="v" sid="1CO 14:32"/>आरू भविष्यवक्ता क आत्मा भविष्यवक्ता क वश मा छे। <verse eid="1CO 14:32"/><verse number="33" style="v" sid="1CO 14:33"/>काहकि यहोवा–भगवान गड़बड़ी क नी, पुन शांती क यहोवा–भगवान छे। जोसो चुखलो मानसे की सब मंडळी मा ओसो ही हईन जुवे। <verse eid="1CO 14:33"/><verse number="34" style="v" sid="1CO 14:34"/>बायर मंडळी की सभा मा चुप रये, काहकि तीनुक वात करने की हुकुम नी, पुन हको तळे रयने की हुकुम छे, जोसो व्यवस्था मा लिख्या भी छे। <verse eid="1CO 14:34"/><verse number="35" style="v" sid="1CO 14:35"/>यदि वे काही सिखने जुवे तो घर मा आपने आपने घर वावा छे पुछ, काहकि बायर क मंडळी मा वात करने लाज की वात छे। <verse eid="1CO 14:35"/><verse number="36" style="v" sid="1CO 14:36"/>काय यहोवा–भगवान क वचन तुमू छे निकव्य छे? या केवल तुमू ही तक पुच्या छे। <verse eid="1CO 14:36"/><verse number="37" style="v" sid="1CO 14:37"/>यदि काही मानुस आपने क भविष्यवक्ता या आत्मिक जन समझ, तो यो जान लेय कि जो वात हाव तुमू लिखता छे, वे पोरबु की हुकुम छे। <verse eid="1CO 14:37"/><verse number="38" style="v" sid="1CO 14:38"/>पुन यदि काही यो नी माने, तो ओको भी नी मानु। <verse eid="1CO 14:38"/><verse number="39" style="v" sid="1CO 14:39"/>शेवली कावा हे भाईस, बहनीस भविष्यव्दाणी करने की धुन मा रया आरू दिसरा भाषा बुलने छे मना नी करू; <verse eid="1CO 14:39"/><verse number="40" style="v" sid="1CO 14:40"/>पर सारी वात शालीनता आरू व्यवस्थित रूप छे करी जाय।<verse eid="1CO 14:40"/></para>
  <chapter eid="1CO 14"/>
  <chapter number="15" style="c" sid="1CO 15"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1"/>हे भाईस, बहनीस हिमी हाव तुमू चो खुश खबर देखाड़तो छे जो पेहल सोमवीन त्योक्य छे, जिनाक तुमू ने पछतायो भी कर्‍या हुता आरू जिन मा तुमू स्थिर भी होय। <verse eid="1CO 15:1"/><verse number="2" style="v" sid="1CO 15:2"/>उको क द्वारा तुमरो उध्दार भी होयतो छे, यदि उना खुश खबर क हाव ने तुमू सोमवायो होतो धरायता होय; नी तो तुमरो विश्वास करने व्यर्थ हुयो। <verse eid="1CO 15:2"/><verse number="3" style="v" sid="1CO 15:3"/>इनी कारण हाव ने सब छे पेहल तुमू चो वात पुचाड़ देदी, जो मखे पुचाड़ी होती कि पवित्रशास्त्र क वचन क लारे ईशु मसीह हामरा पाप क करता मर गयो, <verse eid="1CO 15:3"/><verse number="4" style="v" sid="1CO 15:4"/><note caller="+" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="MAT 12:40">मत्ती 12:40</ref>; <ref loc="ACT 2:24-32">प्रेरितन 2:24-32</ref></char></note>आरू गाड़या गयो, आरू पवित्रशास्त्र क लारे तीसरे दाहड़ो जीवीन भी उठ्यो, <verse eid="1CO 15:4"/><verse number="5" style="v" sid="1CO 15:5"/><note caller="+" style="x"><char style="xo" closed="false">15:5 </char><char style="xt" closed="false"><ref loc="LUK 24:34">लूका 24:34</ref> </char><char style="xt" closed="false"><ref loc="MAT 28:16">मत्ती 28:16</ref>,<ref loc="MAT 28:17">17</ref>; <ref loc="MRK 16:14">मरकुस 16:14</ref>; <ref loc="LUK 24:36">लूका 24:36</ref>; <ref loc="JHN 20:19">यहुन्ना 20:19</ref></char></note>आरू कैफा क तव बारा प्रेरित क देखाय दिदो। <verse eid="1CO 15:5"/><verse number="6" style="v" sid="1CO 15:6"/>पछु वो पाच सौ छे सवटो भाईस क एक साथे देखाय दिदो, जिनमा छे घोणा छे हिमी तक जीवतो छे पर काही सुय गयो। <verse eid="1CO 15:6"/><verse number="7" style="v" sid="1CO 15:7"/>पछु वो याकूब क देखाय दिदो तव सब प्रेरितन क देखाय दिदो। <verse eid="1CO 15:7"/><verse number="8" style="v" sid="1CO 15:8"/><note caller="+" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="ACT 9:3-6">प्रेरितन 9:3-6</ref></char></note>सब क बाद मखे क भी देखाय दिदो, जो मानु आधलो दाहड़ो क पैदा हुयो। <verse eid="1CO 15:8"/><verse number="9" style="v" sid="1CO 15:9"/>काहकि हाव चेला मा सब छे नानो छे, वरना प्रेरित कोवायने क योग्य भी नी, काहकि हाव ने यहोवा–भगवान की मंडळी क सताया होतो। <verse eid="1CO 15:9"/><verse number="10" style="v" sid="1CO 15:10"/>पुन हाव जो काही भी छे, यहोवा–भगवान क फोकटन दया छे। ओको फोकटन दया जो मखे पर हुयो, वो व्यर्थ नी हुयो; पुन हाव ने उन सब छे बढ़ीन मेहनत भी कर्‍या: तौभी यो मारी आरू छे नी हुयो पुन यहोवा–भगवान क फोकटन दया छे जो मखे पर होतो। <verse eid="1CO 15:10"/><verse number="11" style="v" sid="1CO 15:11"/>एरकरीन जुवे हाव छे, जुवे वो होय, हामु योही खबर करता छे, आरू इनी पर तुमू ने विश्वास भी कर्‍या। <verse eid="1CO 15:11"/><verse number="12" style="v" sid="1CO 15:12"/>एरकरीन जव कि मसीह क यो खबर कर्‍या जाता छे कि वो मर्‍य हुयो मा छे जीवन उठ्यो, तो तुमू मा छे कोतरा कोसो कयता छे कि मर्‍य हुयो क पुनरूत्थान छे ही नी? <verse eid="1CO 15:12"/><verse number="13" style="v" sid="1CO 15:13"/>यदि मर्‍य हुयो क पुनरूत्थान छे ही नी, तो मसीह भी नी जीव उठने; <verse eid="1CO 15:13"/><verse number="14" style="v" sid="1CO 15:14"/>आरू यदि मसीह नी जीव उठने, तो आमरो खबर करने भी व्यर्थ छे, आरू तुमरो विश्वास भी व्यर्थ छे। <verse eid="1CO 15:14"/><verse number="15" style="v" sid="1CO 15:15"/>वरना हामु यहोवा–भगवान क झुठ गवाय ठराय; काहकि हामु ने यहोवा–भगवान क विषय मा यो गवा देदी कि त्यो मसीह क जीवाड़ दिदो, यदि नी जीवाड्य यदि मर हुयो नी जीवीन उठ्यो। <verse eid="1CO 15:15"/><verse number="16" style="v" sid="1CO 15:16"/>आरू यदि मरला नी जीव उठने, तो मसीह भी नी जीवीन उठ्यो; <verse eid="1CO 15:16"/><verse number="17" style="v" sid="1CO 15:17"/>आरू यदि मसीह नी जीव उठ्यो, तो तुमरो विश्वास व्यर्थ छे, आरू तुमू हिमी तक आपसा पाप मा फोस होय। <verse eid="1CO 15:17"/><verse number="18" style="v" sid="1CO 15:18"/>वरना जो मसीह मा सुय गयो छे, वो भी नष्ट हुयो। <verse eid="1CO 15:18"/><verse number="19" style="v" sid="1CO 15:19"/>यदि हामु केवल इनी जीवन मा मसीह छे आश राखता छे तो हामु सब मानुस छे सवटो खोटो छे। <verse eid="1CO 15:19"/><verse number="20" style="v" sid="1CO 15:20"/>पुन सचमुच मसीह मरला मा छे जीव उठसे, नमस्कार आरू जो मरला होया मा जीवन उठसे छे। <verse eid="1CO 15:20"/><verse number="21" style="v" sid="1CO 15:21"/>काहकि जव मानुस क द्वारा मरन आयो, तो मानुस ही क द्वारा मरलो होया क जीव उठने भी आयो। <verse eid="1CO 15:21"/><verse number="22" style="v" sid="1CO 15:22"/>आरू जोसो आदम ने सब मरन लायो, वोसो ही मसीह जीवन सब जीव जाछे, <verse eid="1CO 15:22"/><verse number="23" style="v" sid="1CO 15:23"/>पुन हर एक आपसी–आपसी वाड़ी छे: पेहल मसीह, पछु मसीह क आवने पर ओका मानछे। <verse eid="1CO 15:23"/><verse number="24" style="v" sid="1CO 15:24"/>ओका बाद आखरी होयछे। उना टेहाव वो प्रधानता, आरू सब हक आरू शक्ति क आखरी करीन राज राखनेवा यहोवा–भगवान बास क हात मा सौप दीस। <verse eid="1CO 15:24"/><verse number="25" style="v" sid="1CO 15:25"/>काहकि जव तक वो आपने दुस्मनयो मसीह क आपने पाय तवे नी लेय आय, तव तक ओको राज करने पाको छे। <verse eid="1CO 15:25"/><verse number="26" style="v" sid="1CO 15:26"/>सब छे आखरी दुस्मन जो नष्ट होय जाछे, वो मरन छे। <verse eid="1CO 15:26"/><verse number="27" style="v" sid="1CO 15:27"/>काहकि “यहोवा–भगवान ने सब काही ओका पाय तवे कर दिदो छे” पुन जव वो कयता छे कि सब काही वो खुद रयो छे तो सामने छे कि जो सब काही उका हको तळे कर दिदो, वो आप अलग रया। <verse eid="1CO 15:27"/><verse number="28" style="v" sid="1CO 15:28"/>आरू जव सब काही ओका हको तळे होय जाछे, तो पोर्‍य आप भी ओका हको तळे होय जाछे, जो सब काही ओका हको तळे कर दिदो, ताकि सब मा यहोवा–भगवान ही सब समान पर पूरा राज करसे। <verse eid="1CO 15:28"/><verse number="29" style="v" sid="1CO 15:29"/>नी तो जो मानसे मर्‍य हुयो क करता बपतिस्मा लेता छे वे काय करसे? यदि मरला जीव उठे ही नी तो पछु काय ओको करता बपतिस्मा लेता छे? <verse eid="1CO 15:29"/><verse number="30" style="v" sid="1CO 15:30"/>आरू हामु भी काय हर घड़ी जोखिम मा पड़ रयता छे? <verse eid="1CO 15:30"/><verse number="31" style="v" sid="1CO 15:31"/>हे भाईस, बहनीस मखे उना डाहळाय की शपथ जो हामरे मसीह ईशु मा हाव तुमरा विषय मा करता छे कि हाव हर दाहाड़े मरता छे। <verse eid="1CO 15:31"/><verse number="32" style="v" sid="1CO 15:32"/>यदि हाव मानुस की रीति पर इफिसुस मा वन मानुस छे लड़ाई तो मखे काय लाभ हुयो? यदि मरला जीवाड्य नी जाछे, “तो आवु, खाय पीय, काहकि काल तो मर ही जाछे।” <verse eid="1CO 15:32"/><verse number="33" style="v" sid="1CO 15:33"/>धुखो नी खानो, “बुरी संगति वारला चरित्र क बिगाड़ देतली छे।” <verse eid="1CO 15:33"/><verse number="34" style="v" sid="1CO 15:34"/>सही विचार करनो सोरू करू आरू पाप क छुड़ देवु; काहकि काही ओसो छे जो यहोवा–भगवान क नी जानता। हाव तुमू लज्जित करने क करता यो कयता छे।<verse eid="1CO 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35"/>हिमी काही यो कवसे, “मरला काही रीति छे जीव उठे छे, आरू कोसी देह क साथे आवता छे?” <verse eid="1CO 15:35"/><verse number="36" style="v" sid="1CO 15:36"/>हे निर्बुध्दि! जो काही तु वेरता छे, जव तक वो नी मरला जीवता नी जाता। <verse eid="1CO 15:36"/><verse number="37" style="v" sid="1CO 15:37"/>आरू जो तु वेरता छे, यो वो डील नी जो पैदा होयनेवावी छे, पुन निरा दाना छे, जुवे गवे क जुवे काही आरू धान क। <verse eid="1CO 15:37"/><verse number="38" style="v" sid="1CO 15:38"/>पुन यहोवा–भगवान आपसी मरजी क लारे ओको देह देता छे, आरू हर एक बीज क ओकी विशेष देह। <verse eid="1CO 15:38"/><verse number="39" style="v" sid="1CO 15:39"/>सब डील एक समान नी: मानुस क डील आरू छे, मानुस क डील आरू छे; चिल्ला क डील आरू छे; मासा क डील आरू छे। <verse eid="1CO 15:39"/><verse number="40" style="v" sid="1CO 15:40"/>सोरगन देह छे आरू पार्थिव देह भी छे। पुन सोरगदूतीय देहो क तेज आरू छे, आरू पार्थिव क आरू। <verse eid="1CO 15:40"/><verse number="41" style="v" sid="1CO 15:41"/>दाहड़ा क तेज आरू छे, चाँद क तेज आरू छे, आरू तारागणो क तेज आरू छे, काहकि एक तारा छे दीसरो तारा क तेज मा जागा छे। <verse eid="1CO 15:41"/><verse number="42" style="v" sid="1CO 15:42"/>मरला क जीव उठने भी ओसो ही छे। डील नाशवान दशा मा वेरलो जातो छे आरू अमरकाया रूप मा जीवीन उठे छे। <verse eid="1CO 15:42"/><verse number="43" style="v" sid="1CO 15:43"/>वो विजुत क साथे वेरलो जातो छे, आरू तेज क साथे जीव उठे छे; निर्बलता क साथे वेरलो जातो छे, शक्ति क साथे जीवीन उठे छे। <verse eid="1CO 15:43"/><verse number="44" style="v" sid="1CO 15:44"/>स्वाभाविक डील गाड़ देय, आरू आत्मिक देह जीव उठे छे: जबकि स्वाभाविक देह छे, तो आत्मिक देह भी छे। <verse eid="1CO 15:44"/><verse number="45" style="v" sid="1CO 15:45"/>ओसो ही लिख्यो भी छे, कि “पेहलो मानुस, मतलब आदम जीवतो मानुस बन्यो” आरू आखरी आदम, जीवनदायक आत्मा छे। <verse eid="1CO 15:45"/><verse number="46" style="v" sid="1CO 15:46"/>पुन पेहल आत्मिक डील नी होतो पर स्वाभिविक डील होतो, ओका बाद आत्मिक डील हुयो। <verse eid="1CO 15:46"/><verse number="47" style="v" sid="1CO 15:47"/>पेहल मानुस धरती न धुळा न हुतो; दीसरो मानुस सोरग न हुतो। <verse eid="1CO 15:47"/><verse number="48" style="v" sid="1CO 15:48"/>जोसो वो धरती क होतो, वोसो ही वे भी छे जो धरती क छे; आरू जोसो वो सोरग छे, वोसो ही वे भी छे जो सोरग छे। <verse eid="1CO 15:48"/><verse number="49" style="v" sid="1CO 15:49"/>आरू जोसो हामु ने ओको डील धारण कर्‍या जो धुवो क होतो वोसो ही उना सोरग क रूप भी धारण करसे। <verse eid="1CO 15:49"/><verse number="50" style="v" sid="1CO 15:50"/>हे भाईस आरू बहनीस हाव यो कयता छे कि मास आरू लुहूय यहोवा–भगवान क राज क हक नी होय सकता, आरू नी नाशवान अमरकाया क हकी होय सकता छे। <verse eid="1CO 15:50"/><verse number="51" style="v" sid="1CO 15:51"/><note caller="+" style="x"><char style="xo" closed="false">15:51 </char><char style="xt" closed="false"><ref loc="1TH 4:15-17">1 थिस्सलुनीकियो 4:15-17</ref></char></note>देखु, हाव तुमू छे भेद कि वात कयता छे: हामु सब नी मर जे, पुन सब बदली जाछे, <verse eid="1CO 15:51"/><verse number="52" style="v" sid="1CO 15:52"/>आरू यो पल भर मा पापन्या पाड़तो ही आखरी तुरही फूंकता ही होयछे। काहकि तुरही फूंकी जाछे आरू मारला अमरकाया दशामा उठ जाछे, आरू हामु बदली जासु। <verse eid="1CO 15:52"/><verse number="53" style="v" sid="1CO 15:53"/>काहकि पाको छे कि यो नाशवान देह अमरकाया डील क पेहरी लेय, आरू यो मरलोहार देह अमरकाय डील क पेहरी लेय। <verse eid="1CO 15:53"/><verse number="54" style="v" sid="1CO 15:54"/>आरू जव नाशवान अमरकाया डील क पेहेरी लेछे, आरू यो मरलोहार देह अमरकाय डील क पेहरी लेछे, तव वो वचन जो लिख्यो छे पूरो होय जाछे: “जय ने मरला क निघल लेदो। <verse eid="1CO 15:54"/><verse number="55" style="v" sid="1CO 15:55"/>हे मरला तारी जय काँ रयी? हे मरला, तारो आहळ क रया?” <verse eid="1CO 15:55"/><verse number="56" style="v" sid="1CO 15:56"/>मरला क डंक पाप छे, आरू पाप क शक्ति व्यवस्था छे। <verse eid="1CO 15:56"/><verse number="57" style="v" sid="1CO 15:57"/>पुन यहोवा–भगवान क धन्यवाद होय, जो हामरे पोरबु ईशु मसीह क द्वारा हामु जयन्त करता छे। <verse eid="1CO 15:57"/><verse number="58" style="v" sid="1CO 15:58"/>एरकरीन हे मारा मोंगावु भाईस, आरू बहनीस दृढ़ आरू अटल रयो, आरू पोरबु क काम मा सर्वदा बढ़ता जाय, काहकि यो जानता होय कि तुमरा मेहनत पोरबु मा व्यर्थ नी छे।<verse eid="1CO 15:58"/></para>
  <chapter eid="1CO 15"/>
  <chapter number="16" style="c" sid="1CO 16"/>
  <para style="s">विश्वासिया क करता दान</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:1 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:25">रोमियो 15:25</ref>,<ref loc="ROM 15:26">26</ref></char>
    </note>हिमी उना चंदा क विषय मा जो चुखलो मानसे क करता कर्‍या जाता छे, जोसी हुकुम मा गलातिया गाव की मंडळी क देदी, वोसो ही तुमू भी करू। <verse eid="1CO 16:1"/><verse number="2" style="v" sid="1CO 16:2"/>हापता क पेहल दहाडू तुमू मा छे हर एक आपसी आमदनी क लारे काही आपने साथे राख्या छुड़ी करे कि मारे आवने पर चंदा नी करने पड़्या। <verse eid="1CO 16:2"/><verse number="3" style="v" sid="1CO 16:3"/>आरू जव हाव आवीस, तो जीवने तुमूक जुवछे तीनुक मा चिठ्ठया आपीन मुकली देसे कि तुमरा दान यरूशलेम मा पुचाडी देसे। <verse eid="1CO 16:3"/><verse number="4" style="v" sid="1CO 16:4"/>यदि मारा भी जाने वारू हुयो, तो वो मारे साथे जाछे।<verse eid="1CO 16:4"/></para>
  <para style="s">पौलुस कि यात्रा क कार्‍यक्रम</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:5 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:21">प्रेरितन 19:21</ref>
      </char>
    </note>हाव मकिदुनिया गाव हईन तुमरे साथे आवीस, काहकि मखे मकिदुनिया गाव हईन जाने ही छे। <verse eid="1CO 16:5"/><verse number="6" style="v" sid="1CO 16:6"/>पुन सम्भव छे कि तुमरे याहा ही ठेहर जावु आरू शरद ऋतु तुमरे याहा काटू तव जिना आरू मारो जाने होय उना आरू तुमू मखे पुचाड देसे। <verse eid="1CO 16:6"/><verse number="7" style="v" sid="1CO 16:7"/>काहकि हाव हिमी मार्ग मा तुमू छे भेंट करने नी जुवता; पुन मखे आश छे कि यदि पोरबु जुवे तो काही टेहाव तक तुमरे साथे रवीस। <verse eid="1CO 16:7"/><verse number="8" style="v" sid="1CO 16:8"/><note caller="+" style="x"><char style="xo" closed="false">16:8 </char><char style="xt" closed="false"><ref loc="ACT 19:8-10">प्रेरितन 19:8-10</ref></char></note>पुन हाव पिन्तेकुस्त तक इफिसुस मा रवीस, <verse eid="1CO 16:8"/><verse number="9" style="v" sid="1CO 16:9"/>काहकि मारे करता वाँ एक मोठो व्दरा कामलागु झोपलो उघाड्यो छे, आरू विरोधी घोणा छे।<verse eid="1CO 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:10 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 4:17">1 कुरन्थियो 4:17</ref>
      </char>
    </note>यदि तीमुथियुस आय जाय, तो देखने कि वो तुमरे याहा निडर रया; काहकि वो मारे समान पोरबु क काम करता छे। <verse eid="1CO 16:10"/><verse number="11" style="v" sid="1CO 16:11"/>एरकरीन काही ओको तुच्छ नी जाने पुन ओको कुशल छे इनीये आरू पुचाड देने कि मारे साथे आय जाय; काहकि हाव ओकी वाट जुवो रया छे कि वो मारा भाईस क साथे आवसे। <verse eid="1CO 16:11"/><verse number="12" style="v" sid="1CO 16:12"/>भाईस अपुल्लोस छे हाव ने घोणा रावन्या करी छे कि तुमरे साथे भाईस क साथे जाय; पुन त्यो इनीये टेहाव जाने कि काही भी मरजी नी करी, पुन जव मेखे देखछे तव आय जाछे।<verse eid="1CO 16:12"/></para>
  <para style="s">पोछली हुकुम आरू नमस्कार</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13"/>जागता रयो, विश्वास मा स्थिर रयो, हिमत करो, ताकदवावो हुयो। <verse eid="1CO 16:13"/><verse number="14" style="v" sid="1CO 16:14"/>जो काही करता होय मोंग छे करो।<verse eid="1CO 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:15 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 1:16">1 कुरन्थियो 1:16</ref>
      </char>
    </note>हे भाईस, तुमू स्तिफनास भाईस क घराना क जानता होय कि वो अखाया क पेहल फोव छे, आरू चुखलो मानसे कि सेवा क करता तियार रयता छे। <verse eid="1CO 16:15"/><verse number="16" style="v" sid="1CO 16:16"/>एरकरीन हाव तुमू छे रावन्या करता छे कि वोसो क हको तळे रयो, वरना हर एक क जो इनीये काम मा मेहनत आरू सहकर्मी छे। <verse eid="1CO 16:16"/><verse number="17" style="v" sid="1CO 16:17"/>हाव स्तिफनास आरू फूरतुनातुस आरू अखीकुश इन भाईस क आवने छे खुशी मा छे, काहकि त्या तुमरी घटी क पूरो कर्‍या छे। <verse eid="1CO 16:17"/><verse number="18" style="v" sid="1CO 16:18"/>त्या मारी आरू तुमरी आत्मा क सुख देदो छे, एरकरीन ओसला क मानु। <verse eid="1CO 16:18"/><verse number="19" style="v" sid="1CO 16:19"/><note caller="+" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="ACT 18:2">प्रेरितन 18:2</ref></char></note>आसिया प्रदेश कि मंडळी कि आरू छे तुमू क नमस्कार; अक्विला आरू प्रिस्किल्ला क आरू ओको घर कि मंडळी क भी तुमू क पोरबु मा घोणा नमस्कार करू! <verse eid="1CO 16:19"/><verse number="20" style="v" sid="1CO 16:20"/>सब भाईस क तुमू क नमस्कार। चुखलो गवे लागाड़ ने छे आपस मा नमस्कार करो।<verse eid="1CO 16:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21"/>मखे पौलुस क आपने हात क लिख्या होया नमस्कार। <verse eid="1CO 16:21"/><verse number="22" style="v" sid="1CO 16:22"/>यदि काही पोरबु छे मोंग नी राखे तो वो उना पर हाय होय। हे हामरा पोरबु, आवो! <verse eid="1CO 16:22"/><verse number="23" style="v" sid="1CO 16:23"/>पोरबु ईशु क फोकटन दया तुमू पर होयतो रये। <verse eid="1CO 16:23"/><verse number="24" style="v" sid="1CO 16:24"/>मारो मोंग मसीह ईशु मा तुमू सब क साथे रयो। आमेन।<verse eid="1CO 16:24"/></para>
  <chapter eid="1CO 16"/>
</usx>
