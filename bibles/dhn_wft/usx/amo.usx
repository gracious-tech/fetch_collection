<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Dhankavi New Testament</book>
  <para style="h">आमोस</para>
  <para style="toc3">आमोस</para>
  <para style="toc2">आमोस</para>
  <para style="toc1">आमोस नी किताब</para>
  <para style="mt2">आमोस नी किताब</para>
  <para style="mt1">आमोस नी किताब</para>
  <para style="is">परिचय</para>
  <para style="ip">इनी किताब मा आमोसन ओगळ हुयने वाळी वातोन खोबोर छे। अमोस एक गुवाळीयो <char style="xt"><ref loc="AMO 1:1">1:1</ref></char> आरु एक किसान <char style="xt"><ref loc="AMO 7:14">7:14</ref></char> हुतो। तव परमेश्वर हेरे सी आपसो कागळीयो बोनने करीन बुलायो। आमोस तोकोआ नावन सोहर सी हुतो, जो यहुदान दोखेवरा मुलको मा हुतो, पुन हेरा जादा सी जादा खबर बोखवरी वावी इसराएल मुलुक जुगु होती। आमोस तेत्यार भोगवानो वोगे गोथी वात करीयो, जोत्यार उज्जियाह यहुदान राजा हुतो। आरु योराबाम इसराएलन दुसरो राजा हुतो। यो आन्‌दास सी ईशु मसीह आवने पेहेल 750 सालो वात छे।</para>
  <para style="ip">आमोस पेहला दुय पाठ मा थुड़ाक मुलकोन विरुद् नियावोन भोगवानो वोगी गोथी वात कोर्‌यो, पुन जादा खोबर इसराएल जुगु होती। यो इसराएल जुगु घोनी वारु वातोन टेम होतो। तेनी वारु वातोम होये परमेश्वर काजे विसरी गोया आरु गोरब्या मानसो सारे भुन्‌डो वेवहार कोर्‌या <char style="xt"><ref loc="AMO 2:6">2:6</ref></char>। ओतरान कोरीन परमेश्वरन नियाव हेनुक गुलाम बोनावीन लीन जानो होतो <char style="xt"><ref loc="AMO 7:17">7:17</ref></char>। ओळी वी परमेश्वर वायदु कोर्‌यु कि होये इसराएलन मानसो काजे हेनु आखा देसो पोर ओळी जिक हात कोरने मा मोदोत् कोरसे जेनु पोर होये पेहले राज कोरला <char style="xt"><ref loc="AMO 9:12">9:12</ref></char>।</para>
  <para style="is">रुपरेखा</para>
  <para style="io1">1. पेहला पद मा आमोस आपसा वाराम देखाड़े।</para>
  <para style="io1">2. ओळी पाठ 1 एने 2 ने दिसरा भाग मा, हुयो घोना मुलको पोर नियाव सोमवाड़े।</para>
  <para style="io1">3. पाठ <char style="ior"><ref loc="AMO 3:9-11">3:9-11</ref></char> इसराएलन नियाव आरु गुलामीन वाराम वात कोरे।</para>
  <para style="io1">4. आखरी पाठ <char style="ior"><ref loc="AMO 9:12-15">9:12-15</ref></char> मा, परमेश्वर वाचला विश्वासी इसराएल मा पोछु लावनेन वायदु कोरे।</para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />तकोआ गांव मा रोवने वावु आमोस जु गाडरा बुकड़ान गुवायाम गोथु होतु, हेरा ये बुले छे जु तेना योहुदान राजा उज्जियाह क, आरु योआसन पुर्यो इसराएलन राजा यरुब्बामन दाहड़ाम, भुकोम गोथु दुस साल पेहले, इसराएलन वाराम दोरसोन देखिन कोवे: <verse eid="AMO 1:1" /><verse number="2" style="v" sid="AMO 1:2" />योहोवा सियोन सी कुराटो देसे, आरु योरुसालेम गोथु आपसो बुल सोमवाड़से; तोत्यार तोत्यार गुवायान चारवाय कोलेपसे, आरु कार्मेलन चोटी चुयनाय जासे।<verse eid="AMO 1:2" /></para>
  <para style="s">इसराएल न पड़ोसी राजन दण्ड</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3" />यहोवा ओसु कोवे : दोमिस्कन ताव तावोन गुनान कोरता हांव हेरो डोन नी छुड़ो; काहकि चे गिलादोन लुहड़ाक होव गेरन्ये कोरीन कुसनी नाखला छे। <verse eid="AMO 1:3" /><verse number="4" style="v" sid="AMO 1:4" />एरकरीन हांव होजाएलन राजान किला मा आगठो लागाड़ीस, आरु हेरेसी बेन्हदोदन राजान बोंगला वी नाश होय जासे। <verse eid="AMO 1:4" /><verse number="5" style="v" sid="AMO 1:5" />हांव दोमिस्कन साकळीयाक तुड़ नाखीस आरु आवेन नावोन घाटिम रोवने वावाक आरु बेतएदेन घोर मा रोवने वावा राजा डोन आपन्या घोरानाक नास कोरीस; आरु अरामन मानसे बान्दवाय होईन कीर जासे, योहोवान योत् बुल छे। <verse eid="AMO 1:5" /><verse number="6" style="v" sid="AMO 1:6" />योहोवा ओसु कोवे: गाजान ताव तावोन गुनान कोरता हांव हेरो डोन नी छुड़ो; काहकि चे आखा मानसे बांदवाय मा कोरीन ली गोया कि हेनुक एदोमोन होकोम कोर देजे। <verse eid="AMO 1:6" /><verse number="7" style="v" sid="AMO 1:7" />एरकरिन हांव गाजान मोटला भितड़ाम आगठो लागाड़ीस आरु हेरेसी हेरा मोटलो किला नास होय जासे। <verse eid="AMO 1:7" /><verse number="8" style="v" sid="AMO 1:8" />हांव ओशदोदोन रोवनेवावाक आरु ओसकोलोनोन राज कोरन्‌या घोरानाक वी नास कोरीस; हांव आपसो हात एक्रोनोन विरुद् चालाड़ीस, आरु वाचला पोलिस्ती मानसे नास होयसे, परमेश्वर योहोवान यो बुल छे। <verse eid="AMO 1:8" /><verse number="9" style="v" sid="AMO 1:9" />योहोवा ओसु कोवे: सोरोन तिन काय पुन च्यार गुनान कोरता हांव डोन आपनो नी छुड़ो; काहकि चे आखा मानसोक बोन्दी बोनावीन एदोमोन होकोम कोर देदा आरु भाइस्योन वायदाक फोम नी कोर्या: <verse eid="AMO 1:9" /><verse number="10" style="v" sid="AMO 1:10" />एरकरीन हांव सोरोन मोटला भितड़ा पोर आगठो लागाड़ीस, आरु हेरेसी हेरो मोटलो घोर वी नास होय जासे।<verse eid="AMO 1:10" /></para>
  <para style="s">एदोम</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />योहोवा ओसु कोवे: एदोमन ताव तावोन गुनान कोरता हांव हेनाक डोन आपने नी छुड़ो; काहकि होयु आपसा भाईस्योक तोलवार लिन मार देदु आरु थुड़ीक वी गिन नी कोर्यु, पुन रिसो सी हेनुक एक पोट्यु फाड़तुत् रोयु, आरु आपसी रिस घोना दाहड़ा जुगु बोनाविन राख्यु। <verse eid="AMO 1:11" /><verse number="12" style="v" sid="AMO 1:12" />एरकरिन हांव तेमान मा आगठो लागाड़ीस, आरु हेरेसी बोसरान मोटलो किला वी नास होय जासे।<verse eid="AMO 1:12" /></para>
  <para style="s">अम्मोन</para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />ओम्मोन योहोवा ओसु कोवे ओम्मोनन ताव तावोन गुनान कोरता हांव हेनाक डोन आपने नी छुड़ो काहकी चे आपसी काकोड़ काजे वोदाड़ने जुगु गिलादोन भारपाये बायरान पेट काजे चिर नाख्या। <verse eid="AMO 1:13" /><verse number="14" style="v" sid="AMO 1:14" />एरकरिन हांव रोब्बा न मोटला भितड़ा मा आगठो लागाड़ीस, आरु हेरेसी मोटलो किला वी नास होय जासे। तेनु लोड़ाईन दाहड़ाम हुहड़ु होयसे, चु आंजी पुन भुत्यान दाहड़ु होयसे; <verse eid="AMO 1:14" /><verse number="15" style="v" sid="AMO 1:15" />आरु हेन्दरु राजा आपसा मुख्या भेव गुलामी मा जासे, योहोवान योत् बुल छे।<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="s">मोआब</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1" />मोआब योहोवा ओसु कोवे: मोआबन ताव तावोन गुनान कोरता, हांव हेरा डोनोक नी छुड़ो, काहाकि होयु एदोमन राजान हाड़का धोपाड़ीन रुखड़ो कोर देदु। <verse eid="AMO 2:1" /><verse number="2" style="v" sid="AMO 2:2" />एरकरीन हांव मोआब मा आगठो लागाड़िस, आरु हेरेसी करियोतोन मोटलो किला वी नास होय जासे; आरु मोआब गोगलु आरु हुहड़ु आरु मोटला फेपारियान बुल होयतात् मोर जासे। <verse eid="AMO 2:2" /><verse number="3" style="v" sid="AMO 2:3" />हांव हेरे इचमा गोथु नियाव कोरन्‌या मुखीन नास कोरीस, आरु पुठि पुठित् हेरा आखा मुखिक वी मार दिस, योहोवान योत् बुल छे।<verse eid="AMO 2:3" /></para>
  <para style="s">यहूदा</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />योहुदा योहोवा ओसु कोवे: योहुदान ताव तावोन गुनान करता, हांव डोन आपनो नी छुड़ो; काहाकि चे योहोवान कायदाक उदुड़ जान्या, आरु मारा नेम काजे नी मान्या; आरु आपसा झुटा देवधानीन कोरता जोतरा हेन्दरा डाहडा चालता होता, चे वी भोटकी गोयला छे। <verse eid="AMO 2:4" /><verse number="5" style="v" sid="AMO 2:5" />एरकरिन हांव योहुदा मा आगठो लागाड़ीस, आरु हेरेसी योरुसालेमोन किला नास होय जासे,<verse eid="AMO 2:5" /></para>
  <para style="s">इसराएलन नियाव</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />योहोवा ओसु कोवे: इसराएलोन ताव तावोन गुनान कोरता, हांव हेरो डोन नि छुड़ो; काहाकि चे विनगुनाका क रुप्या जुगु आरु गोरब्याक एक जुड़ी खासड़ान कोरता वेच नाखला छे। <verse eid="AMO 2:6" /><verse number="7" style="v" sid="AMO 2:7" />चे गोरब्यान मुनका पोरुन धुवान वि हाय कोरे, आरु निचवा मानसोक वाटे गोथा छेटा कोरे; आरु बास-बेटा दुयु एक छल्लीन चा जाय, जेरेसी मारा चुखला नाव क विटोळ कोराया। <verse eid="AMO 2:7" /><verse number="8" style="v" sid="AMO 2:8" />चे आखी बेदीन चा खोन्डला छिन्दरा पोर सुवे, आरु डोनोन रुप्या सी मुले लेदला ओन्गुरोन रोस आपसा परमेश्वरन घोरमा पी लेये। <verse eid="AMO 2:8" /><verse number="9" style="v" sid="AMO 2:9" />हांव हेन्दरे ओगोव एमोरियान क नाश कोरलो हुतो, जेन्दरी नाम्बाय वेला सारकी होती, आरु जेन्दरु दोम ओंजीर झाड़ सारको होतु; तेवी हांव उपोर गोथु हेरो फोळ, आरु नेचु गोथु हेरा मुवे नास कोरलु। <verse eid="AMO 2:9" /><verse number="10" style="v" sid="AMO 2:10" />हांव तुमुक मिसर देस गोथु निकाविन लायु, आरु जोंगोल मा चावीस साल लोगुन लिन फिरतु रोयु, कि तुमु एमोरियान देसोन होकदारिया होय जावु। <verse eid="AMO 2:10" /><verse number="11" style="v" sid="AMO 2:11" />हांव तुमरा पुर्या मा गोथु कागळीया होयने जुगु आरु तुमरा थुड़ाक जुवान मा गोथु नाजीर<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="fq" closed="false">नाजीर </char><char style="ft" closed="false">परमेश्वर काजे चोड़ावलो</char></note> होयने जुगु नेवाड़्यु। ऐ इसराएलिया, काय यो आखो छाचो नी होय? योहोवान यो बुल छे। <verse eid="AMO 2:11" /><verse number="12" style="v" sid="AMO 2:12" />पुन तुमु नाजीर काजे ओन्गुरोन रोस पाव्या, आरु कागळीया काजे हुकुम आप्या की ओगवाती वात नी कोरे। <verse eid="AMO 2:12" /><verse number="13" style="v" sid="AMO 2:13" />देखु, हांव तुमुक ओसु डाबीस, जोसा पुवा सी भोरायली गाड़ी नेचो डाबाय जाय <verse eid="AMO 2:13" /><verse number="14" style="v" sid="AMO 2:14" />एरकरिन जुर्रे दोवोड़नेवावाक ढासने जानेन जागु नी जोड़े, आरु ताकोत वावान ताकोत काहिन काम नी देये; आरु नी जुरो वावु आपसु जिव वाचाड़ सोके; <verse eid="AMO 2:14" /><verse number="15" style="v" sid="AMO 2:15" />धोंदली वावा उबा नी रोय सोके, आरु उतवाया दोवोड़नेवावा नी वाच सोके; सोवार वी आपसे जीव नी वाचाड़ सोके; <verse eid="AMO 2:15" /><verse number="16" style="v" sid="AMO 2:16" />आरु हिमोत वावा मा जु जादा गोम खान्यु होय, चो वी तेने दाहड़े नांगरोत् ढास जासे, योहोवान योत् बुल छे।<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />ऐ इसराएलियो, यो बुल समवु जो यहोवा तुमरे वाराम मोतलोब आखा घोरानान वाराम कोवलो छे जेनको हांव मिसर देस गोथु लावलो छे: <verse eid="AMO 3:1" /><verse number="2" style="v" sid="AMO 3:2" />कोवीन आखा घोरानाम गोथा हांव तुमुक ओतरु गिन कोरलु छे, ओतरान कोरता हांव तुमरा आखा पापोन डोन आपीस।<verse eid="AMO 3:2" /></para>
  <para style="s">कागळ्यान काम</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 3:3" />“कोदाम दुय मानसोन आमी सामी राजी नी हय; ती काय चे एकठा चाल सोकसे?” <verse eid="AMO 3:3" /><verse number="4" style="v" sid="AMO 3:4" />काय नाहार विगुर सिकार हात कोरे जंगल मा गांगेरसे? काय जुवान नाहार विगुर काहिन धोरे आपसा दोरोम डोखारसे? <verse eid="AMO 3:4" /><verse number="5" style="v" sid="AMO 3:5" />काय चिल्‌ला विगुर फांदोन फांदे पोड़से? काय चिल्‌ला धोरनीयो विगुर काहिन फान्‌दे पोड़ला फांद काजे धोरती पोर गोथो आपसी जाव काजे एकठो कोरसे? <verse eid="AMO 3:5" /><verse number="6" style="v" sid="AMO 3:6" />काय काहना सोहरोम मोटला फेपारिया काजे फुकसे ती मानसे थोर-थोर नी कापे? काय योहोवान विगुर मुकले काहना सोहोरोम काहिन पिड़ा पोड़से? <verse eid="AMO 3:6" /><verse number="7" style="v" sid="AMO 3:7" />इने रिते पोरबु योहोवा आपसा दास कागळीया पोर आपसी सातायली वात उजेन्ती कोरे विगुर काहिन वी नी कोरे। <verse eid="AMO 3:7" /><verse number="8" style="v" sid="AMO 3:8" />नाहार गांगेरे; कुन नी बीहये? परमेश्वर योहोवा कोयु: कुन ओगवायती वात नी कोरे?<verse eid="AMO 3:8" /></para>
  <para style="s">सामरिया न विनास</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 3:9" />ओसदोदोन मोटला किला आरु मिसर देसन राजान किलाम पोरचार कोरीन कोवु: सामरियान बोयड़ा पोर एकठा होयीन देखु कि हेरेम कायत् मोटु हुहड़ु आरु हेन्दरे इचमा कायत् वेला पाड़नेन काम होय रोया छे!<verse eid="AMO 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 3:10" />योहोवान यो बुल छे, जे मानसे आपसा मोटला घोरोम लोड़ाय आरु ठोगीन लावलो धोन एकठा कोरीन मेक रोया, चे सुतरो काम कोरनो जाने नी। <verse eid="AMO 3:10" /><verse number="11" style="v" sid="AMO 3:11" />ओतरान कोरीन परमेश्वर योहोवा ओसु कोवे: देसक घेरोवनेवावु वेरी होयसे, आरु हुयो तारा जुर काजे तुड़से, आरु तारा मोटोला किलाक लुट ली जासे।<verse eid="AMO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />योहोवा ओसु कोवे: जिने रिते गुवायु नाहारोन मुयोम गोथु दुय पाय एने कानटान एक टुकड़ु छुड़ावे, तोसात् इसराएली मानसे, जे सामरिया मा आथरुनोन एक खुना एने सुवावी गादी पोर बोठ्या कोरे, चे वी छुड़ाय लेसे। <verse eid="AMO 3:12" /><verse number="13" style="v" sid="AMO 3:13" />सेनाओन परमेश्वर, पोरबु यहोवान यो बुल छे, देखु, आरु याकुबोन घोराना विरुद् मा गोवाय देवु। <verse eid="AMO 3:13" /><verse number="14" style="v" sid="AMO 3:14" /><note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="2KI 23:15">2 राजा 23:15</ref></char></note> जिने टेमे हांव इसराएल काजे हेरा गुनान डोन आपीस तेने टेमे हांव बेतेलोन बेदीया काजे वी डोन आपीस, आरु बेदीन सिंगड़ा टुटिन धोरती पोर हिट पोड़से। <verse eid="AMO 3:14" /><verse number="15" style="v" sid="AMO 3:15" />हांव सेव्वान टेमे घोरो काजे आरु तोपोन टेमेन घोरो काजे दुयोक हिट पाड़ीस; हातिन दातो वेर बोनला घोरे वी नास होयसे, आरु मोटला मोटला घोरे वी नास होय जासे।<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 4:1" />ओ सामरी राज्यन मातभोर बायरा<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="fq" closed="false">मातभोर बायरा </char><char style="ft" closed="false">इबरानी मा खास सोब्दो:- बासानोन गायो</char></note>, यी खबर समळो, जे गोरब्या पोर कुहराय कोरु, आरु जिन्दरे जुळ धोन नी होय तेनुक वेला पाड़ु, तुमु आपसा धेणी क हुकुम आपे, मोंद लाविन आपु ने आमु पीजे तोसे! <verse eid="AMO 4:1" /><verse number="2" style="v" sid="AMO 4:2" />परमेश्वर योहोवा आपसु चुखलु कोरीन आन खाईन कोवे, देखु, तुमरे पोर ओसा दाहड़ा आवनेवावा छे, कि तुमु काटा वेर, आरु तुमरी ओवलियाद माछान गोळी वेर हापकी ली जासे। <verse eid="AMO 4:2" /><verse number="3" style="v" sid="AMO 4:3" />तुमरे माईन हर एक भितड़ा न चिराड़ा माईन सुदी निकवी जासु आरु होरमोन बयड़ा मा नाखाय जासु, योहोवान योत् बुल छे।<verse eid="AMO 4:3" /></para>
  <para style="s">इसराएल नी सुधरे</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 4:4" />बेतेल मा आवीन गुनु कोरु, आरु गिलगाल आवीन बेसका गुना कोरु; आपसी बादा दाहड़ु उगतात्, आरु आपसो दोसमास होर तिसरे दाहड़े लीन आया कोरु। <verse eid="AMO 4:4" /><verse number="5" style="v" sid="AMO 4:5" />धोन्यावोदोन बादा खोमिर भेसकिन चोड़ावु, आरु आपसी मोरजीन बादान वात कोरीन तेरो पोरचार कोरु; काहाकि ऐ इसराएलियो, ओसो कोरनो तुमुक वारु लागे, परमेश्वर योहोवान योत् बुल छे। <verse eid="AMO 4:5" /><verse number="6" style="v" sid="AMO 4:6" />हांव ते तुमरा आखा सोहरो काळ मुकल्‌यु, आरु तुमरा आखा जागा मा रुटान कोमी कोरलु छे, ते वी तुमु मारे भेनी फिरिन नी आवे, योहोवान योत् बुल छे। <verse eid="AMO 4:6" /><verse number="7" style="v" sid="AMO 4:7" />जोत्यार काटनीन तिन मोहना रोय गोया, तोत्यार हांव तुमरे जुगु पानी नी पाड़ो: हांव एक सोहोरोम मा पानी पाड़ीस दिसरा सोहरोम नी पाड़ो; एक खेतोम पानी पाड़ीस, आरु दिसरा खेतोम तेरेम नी पाड़ो, चो सुख गोयो। <verse eid="AMO 4:7" /><verse number="8" style="v" sid="AMO 4:8" />मानसे एक नगर गोथा दिसरे नगर जाने लोगुन पानी जुगु मोर्‌या-मोर्‌या फिर्‌या, ती पुन तिस नी भागी: ते वी तुमु मारे भेनी नी फिरु, योहोवान योत् बुल छे। <verse eid="AMO 4:8" /><verse number="9" style="v" sid="AMO 4:9" />हांव तुमुक गोरमी आरु मोहतान किड़े कोरीन मारलु छे; आरु जोत्यार तुमरी वाड़ी आरु ओन्गुरोन वाड़ी, आरु अंजीर आरु जैतुनोन झाड़ बेसका होय गोया, तोत्यार टिड्या तेनुक खाय गोया; तेवी तुमु मारे भेनी फिरिन नी आया, योहोवान योत् बुल छे <verse eid="AMO 4:9" /><verse number="10" style="v" sid="AMO 4:10" />हांव तुमरे इचमा मिसर देस जोसी माहामारी लागाड़्यु; हांव तुमरा घुल्‌लाक हापकाड़ीन तुमरा जुवान्या काजे तोलवारो वेर माराय देदु; आरु तुमरा पोड़ावान गोंदायनो तुमरेनचा मुकल्यु; ते वी तुमु मारे भेनी फिरिन नी आया, योहोवान योत् बुल छे। <verse eid="AMO 4:10" /><verse number="11" style="v" sid="AMO 4:11" />हांव तुमरे मा गोथु लोकते काजे ओसु उथलाय देदु, जोसु परमेश्वर सोदोम आरु गमोरा काजे उथलाय देदलु, आरु तुमु आगठाम गोथा निकावला लाकड़ा जोसा कोवाया, तेवी तुमु मारे भेनी नी फिरिन आया, योहोवान योत् बुल छे। <verse eid="AMO 4:11" /><verse number="12" style="v" sid="AMO 4:12" />ओतरान कोरीन, ऐ इसराएल, हांव तुसेक ओसुत् कोरीस, आरु एरकरिन हांव तारेम यो काम कोरनेम छे, ए इसराएल, आपसा परमेश्वर ओगोव आवन कोरिन तियार होय जा! <verse eid="AMO 4:12" /><verse number="13" style="v" sid="AMO 4:13" />देख, बोयड़ाक बोनावने वावु आरु वाहवीक घोड़नेवावु, आरु मानसोन मोनोम विचार देखाड़नेवावु आरु सान्तो आन्धारो कोरनेवावु आरु जे धोरतीन उचला जागा पोर चालने वावा छे, तेरो नाव सेनाओन परमेश्वर योहोवा छे!<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s">पश्चातावो करनेन बुलावो</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />ऐ इसराएलोन घोराना, इना दुखोन गीतोन बुल सोमवु जो हांव तुमरे वाराम कोवो <verse eid="AMO 5:1" /><verse number="2" style="v" sid="AMO 5:2" />इसराएल देस कुवारी पुराय छे जी हिट पोड़ी, आरु ओळी उठी नी सोके; होयी आपसीत् जागा पोर हिट पोड़ली छे, आरु उठाड़नेवावो कुदु नी। <verse eid="AMO 5:2" /><verse number="3" style="v" sid="AMO 5:3" />काहकि परमेश्वर योहोवा ओसु कोवे। जिना सोहोरोम गोथा होजार निकेवता होता, तिनाम इसराएलोन घोरानान सोवुत् वाचला रोवसे, आरु जेरेम गोथा सोव निकेवता होता तिनाम दोस वाचला रोवसे।<verse eid="AMO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4" />योहोवा, इसराएलोन घोराना काजे ओसु कोवे, मारी हेर मा लागु, ती जिवतेला रोवसु। <verse eid="AMO 5:4" /><verse number="5" style="v" sid="AMO 5:5" />बेतेलोन हेर मा झुन लागु, नी गिलगाल मा भोरायु, आरु नी बेरसेबा जावु; काहकि गिलगाल छाचिन गुलामी मा जासे, आरु बेतेल सुनलो पोड़से।<verse eid="AMO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 5:6" />योहोवान हेर कोरु, ती जिवतेला रोवसु, नी ते हुयो युसुफन घोराना पोर आगठा सारको भोड़ेकसे, आरु हुयो तिनुक नास कोरसे, आरु बेतेल मा कुदु उलेवने वावो नी रोवसे। <verse eid="AMO 5:6" /><verse number="7" style="v" sid="AMO 5:7" />ऐ नियाव काजे जोहोर वाळी वात मा बोदेलनेवावा आरु छाची नियाव काजे धुवा मा भेसेकनेवावा! <verse eid="AMO 5:7" /><verse number="8" style="v" sid="AMO 5:8" />जे नानला तारा आरु होयनीन सिंगड़ान तोसा चोमेकन्‌या तारा बोनावनेवावु छे, जु बेसका आंधाराक वी सोंदारेन विजावो बोनावे, जु दाहड़ान आंधारो कोरीन रात बोनाय देये, आरु दोरीयान पानी सुकला जागा उपोर उहवाड़ देये, तेरो नाव योहोवा छे। <verse eid="AMO 5:8" /><verse number="9" style="v" sid="AMO 5:9" />हुयो ताकोत वाळान क तेतारुत् नास कोर देये, आरु किला काजे वी आखो नास कोर देये। <verse eid="AMO 5:9" /><verse number="10" style="v" sid="AMO 5:10" />जु नियावोन मिटिंग मा गुनु लागाड़ देये हेरेसी चे घाड़ाय रोवे, आरु वारली वात कोरनेवावा सी कुहराय कोरे। <verse eid="AMO 5:10" /><verse number="11" style="v" sid="AMO 5:11" />तुमु गोरब्या काजे वेला पाड़ु, आरु हेन्दरा ओन पोर फाळु कोरीन मांग लेतला, एरकरिन जे तुमु दोगड़ान घोर बोनावला छे, तिनुम रोय नी सोकु; आरु जो गोंहतो ओन्गुरोन वाड़ी तुमु लागाड़ला छे, तिनु ओन्गिरन रोस नी पी सोकु। <verse eid="AMO 5:11" /><verse number="12" style="v" sid="AMO 5:12" />काहकि हांव जानो कि तुमरा गुना भारी छे कि तुमु वारला मानसो काजे वेला पाड़ु आरु पोस्या मांगु, आरु झोपला पोर गोरब्यान नियाव काजे बिगाड़ु। <verse eid="AMO 5:12" /><verse number="13" style="v" sid="AMO 5:13" />ओतरान कोरता जे समझदार होय, चे एने टेमे हुगा रोवे, काहकि टेम वारु नी होय। <verse eid="AMO 5:13" /><verse number="14" style="v" sid="AMO 5:14" />ऐ मानसो, बुराय नी, भोलाय काजे हेरु, कि तुमु जिवतेला रोवु; आरु सेनाओन परमेश्वर योहोवा छाचिन तुमरेत् पुठी रोवसे, जोसा तुमु कोया कोरत्‌ला। <verse eid="AMO 5:14" /><verse number="15" style="v" sid="AMO 5:15" />बुराय सी सीगी आरु भोलाय सी मोंग राखु, आरु नियावोन मिटिंग काजे एक जागे कोरु; काय जानु सेनाओन परमेश्वर योहोवा युसुफन वाचला पोर गिन कोरे। <verse eid="AMO 5:15" /><verse number="16" style="v" sid="AMO 5:16" />ओतरान कोरता सेनाओन परमेश्वर पोरबु योहोवा ओसु कोवे: “आखा चोवराया मा रोड़नो कोलेपनो होयसे; आरु आखी वाटो मा मानसो हाय, हाय, कोरसे!” चे किरसान्या काजे रोड़ने जुगु, आरु जे मानसे कोलेपने मा पाका छे, तेनुक रोड़ने कोलेपने बुलावसे; <verse eid="AMO 5:16" /><verse number="17" style="v" sid="AMO 5:17" />आरु आखा ओन्गुरोन वाड़ीया मा रोड़नो कोलेपनो होयसे, “काहकि योहोवा ओसु कोवे, हांव तुमरे इचमा गोथु होईन जाइस।”<verse eid="AMO 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="AMO 5:18" />हाय तुमरे पोर, जे योहोवान दाहड़ान होर कोरता होय! योहोवान दाहड़ा तुमरा काय नोफान होयसे? हुयो ते विजावान नी, आन्धारान दाहड़ा होयसे। <verse eid="AMO 5:18" /><verse number="19" style="v" sid="AMO 5:19" />जोसु कुदु नाहार सी ढासे आरु तिनाक रिछड़ो मेवाये; एने घोर मा आविन भितड़ा पोर हात मेके आरु घोड़सु तिनाक ठुनकाय देये। <verse eid="AMO 5:19" /><verse number="20" style="v" sid="AMO 5:20" />काय यो छाचो नी होय कि योहोवान दाहड़ा विजावान नी, पुन आन्धारात् जुन होयसे? हाव, ओसो बेसको आन्धारो जेरेम काय वी चोमके नी। <verse eid="AMO 5:20" /><verse number="21" style="v" sid="AMO 5:21" />हांव तुमरा तिहवार सी सिगी कोरो, हेनुक हांव नी मानो, आरु तुमरी मोटली मिटिंग सी हांव खुस नी। <verse eid="AMO 5:21" /><verse number="22" style="v" sid="AMO 5:22" />चाहाय तुमु मारे जुगु होमबली आरु ओनोन बादा चोड़ावु, तेवी हांव खुस नी होयो, आरु तुमरा पावला ढुरोन बादा भेनी नी भावो। <verse eid="AMO 5:22" /><verse number="23" style="v" sid="AMO 5:23" />आपसा गीतोन गोगलु मारे गोथा छेटा कोरु; तुमरा वाजान सुर हांव नी सोमवो। <verse eid="AMO 5:23" /><verse number="24" style="v" sid="AMO 5:24" />पुन नियाव क नदीन सारको आरु छाचाइन आटे नी ओसला खुदरा सारको उहवने देयु। <verse eid="AMO 5:24" /><verse number="25" style="v" sid="AMO 5:25" />ऐ इसराएलोन घोरान, तुमु जोन्गोल मा चावीस साल लोगुन ढुरोन बादा आरु ओनोन बादा काय मेसेत् काजे चोड़ावता रोया? <verse eid="AMO 5:25" /><verse number="26" style="v" sid="AMO 5:26" />तुमरा ते राजान तम्बाक, आरु तुमरा मुरतिया न पाटला आरु तुमरा परमेश्वर न तारा लिन फिरे। <verse eid="AMO 5:26" /><verse number="27" style="v" sid="AMO 5:27" />इना करण सी हांव तमुक दमिश्क न उना पार गुलामी मा कर दिस, सेनाओन परमेश्वर क योत् वचन छे।<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s">इसराएल न विनाश</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 6:1" />विखू तेनु पोर जे सियोन मा सुके रोवे, आरु तेनु पोर जे सामरियान बोयड़ा पोर बिहये विगुर रोवे, चे जे वारु मुलुकोम नावसादया छे, जिन्दरे जुळ इसराएलोन घोरानो आवे <verse eid="AMO 6:1" /><verse number="2" style="v" sid="AMO 6:2" />कलने सोहोरम जाईन देखु, आरु वां गोथा होमात नावोन मोटला सोहोर मा जावु; ओळी पोलिस्तीयान गोत सोहोर मा जावु। काय ये मुलुक तुमरा दुय मुलुक गोथा वारु छे? काय हेन्दरी काकोड़ तुमरी काकोड़ गोथी मोटी छे? <verse eid="AMO 6:2" /><verse number="3" style="v" sid="AMO 6:3" />तुमु भुन्डला दाहड़ाक छेटा कोर देये, आरु लड़ायीन गादी क धोड़े ली आवतेला।<verse eid="AMO 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 6:4" />तुमु हातिन दातोन खाटला पोर लुटु, आरु आपना आपना आथरुन पोर पाय नांबा कोरीन सुवु, आरु वारु गोंहोवता गाडरा आरु जोबरा आरेग्‌ला वाछड़ा काजे खाय। <verse eid="AMO 6:4" /><verse number="5" style="v" sid="AMO 6:5" />तुमु झुनगा पुठी गीते गावु आरु दाऊद जोसा भाति भातिन वाजान आवाज निकावु; <verse eid="AMO 6:5" /><verse number="6" style="v" sid="AMO 6:6" />आरु कोटेवराम गोथो मोन्‍द पीयु, आरु वारु वारु तेल लागाड़ता होय, पुन युसुफ पोर आवनेवावी पिड़ान वाराम सोमवीन नी घाबरायतेला! <verse eid="AMO 6:6" /><verse number="7" style="v" sid="AMO 6:7" />ओतरान कोरीन चे हेमी देसोम गोथा निकाय देसे, आरु जे पाये खोळवीन सुवता होता, हेन्दरो सुक जातो रोवसे। <verse eid="AMO 6:7" /><verse number="8" style="v" sid="AMO 6:8" />परमेश्वर योहोवा आपसीत् आन खाईन कोवलु छे, जिना पोर याकुब घाड़ाय कोरे, तेरेसी हांव कुहराय, आरु हेरा किला सी सीगी कोरो; आरु हांव इना सोहोर काजे तेनु आखा भेळ जो हेरेम छे, वेरीन होकोम कोर दिस। <verse eid="AMO 6:8" /><verse number="9" style="v" sid="AMO 6:9" />कोदाम काहना घोरोम दोस ओदमी वाचला रोवे, तेवी चे मोर जासे। <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />जोत्यार कुदान काकु, जु तेरु धोपाड़नेवावु होय, हेरा धोड़ काजे घोरोम गोथो निकावने जुगु हुचेलसे, आरु जो घोरोन खुनाम रोवे तिना सी कोवसे, काय तारे जुळ कुदु ओळी छे? तोत्यार हुयो कोवसे, कुदु नी: “तोत्यार हुयो कोवसे” हुग रोव! हामुक योहोवान नाव नी लेनो जुवे। <verse eid="AMO 6:10" /><verse number="11" style="v" sid="AMO 6:11" />काहाकि योहोवान हुकुम सी मोटलो घोर भुकरा भुकरा होय जासे, आरु नानला घोरोम चिसाड़ा होयसे। <verse eid="AMO 6:11" /><verse number="12" style="v" sid="AMO 6:12" />काय घुल्‌ला चाफरिया पोर दोवड़े? काय कुदु ओसा जागा मा बुल्यो काजे जुपे जां तुमु मानसे नियाव काजे जोहोर मा, आरु नियावोन फोळ कोड़वा फोळ मा बोदली नाखलु छे? <verse eid="AMO 6:12" /><verse number="13" style="v" sid="AMO 6:13" />तुमु ओसी चिजोन कोरता खुस्सी होयु जी रिकामी छे; आरु कोवु, हामु आपनात् हेमोत सी ताकोत सी कोरनेम सोहोर काजे जितला छे। <verse eid="AMO 6:13" /><verse number="14" style="v" sid="AMO 6:14" />ओतरान कोरता सेनाओन परमेश्वर यहोवान यो बुल छे, ए इसराएलोन घोराना, देख, हांव तुमरे विरुद् एक ओसो मुलुक उबो कोरीस, जो होमातोन घाटी गोथो लीन ओराबान नोदी लोगुन तुमुक वेला पाड़से।<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s">विनाशन तीन दर्शन</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />विनासोन तिन दोरसोन टिड्या, परमेश्वर योहोवा मेसे यो देखाड़्यु कि त्यो पछळला खड़ान उगने न शुरु मा टिडिया पयदा करीयो; आरु त्यो राजा न फसल काटनेन बाद पछळलो खोड़ोव हुतो। <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />जोत्यार चे खोड़ोव खाय लेदा, तोत्यार हांव कोयु, ऐ परमेश्वर योहोवा, माफ कोर! नी ते याकुब कोसो एक जागे रोय सोकसे? त्यो कतरो कमजुर छे। <verse eid="AMO 7:2" /><verse number="3" style="v" sid="AMO 7:3" />एरा वाराम यहोवा आपसो मोन बोदल्‌यु, आरु त्यो कयो, असी वात हांय नी हुये।<verse eid="AMO 7:3" /></para>
  <para style="s">आग्ठान दर्शन</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />परमेश्वर यहोवा मके देखाड़ियो; आरु काय देखो कि परमेश्वर यहोवा आग्ठान लारे मुकेदमु लोड़ायने कोरीन आयड़्‌यु, आरु तिना आगठा सी मोटलो दोरीयो सुक गोयो, आरु देस वी नास होयने लाग गोयलो। <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />तव हांव कयो, ए परमेश्वर रुक जा नी ते याकुब कसो वातड़ो रय सकसे? त्यो कसो कमजुर छे। <verse eid="AMO 7:5" /><verse number="6" style="v" sid="AMO 7:6" />एरा वाराम बी यहोवा पछतायो आरु परमेश्वर यहोवा कयो, असी वात पछी नी हुयसे। <verse eid="AMO 7:6" /><verse number="7" style="v" sid="AMO 7:7" />त्यो मखे यो बी देखाड़ियो; हांव देखियो कि पोरबु सावळ लगाड़ीन बनावला भीतड़ा पर उबरी रियो आरु हेरा हातोम सावळ छे। <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />यहोवा म्हार सी कयो, ए आमोस तुको काय देखाय पड़े? हांव कयो एक सावळ। तव परमेश्वर कयू, देख हांव म्हारी परजा इसराएल न वीच मा सावळ लगाड़ीस। हेमी हांव हेनुक डोन आपे विगुर नी छुड़ो। <verse eid="AMO 7:8" /><verse number="9" style="v" sid="AMO 7:9" />इसहाकोन उचला जागान उजाड़ आरु इसराएलोन चुखलु जागु सुनसान होय जासे, आरु हांव यरुब्बामोन घोराना पोर तोलवार हापकीलीन चोड़ाय कोरीस।<verse eid="AMO 7:9" /></para>
  <para style="s">आमोस आरु अमस्याह</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />तोत्‌यार बेतेलोन पुजारो ओमस्याह न इसराएलोन राजा यरुब्बामन चां कोय मुकल्‌यु, “आमोस इसराएलोन घोरानान इचमा तारे सी लोड़ाय कोरनेन विचार कोरलु छे; हेरा आखा बुलो काजे देस नी वेठ सोके।” <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />काहाकि आमोस ओसु कोवे, यरुब्बाम तोलवार सी माराय जासे, आरु इसराएल आपसा जागा पोर गोथु छाचिन गुलामी मा जासे। <verse eid="AMO 7:11" /><verse number="12" style="v" sid="AMO 7:12" />तोत्यार ओमस्याह आमोस सी कोयु, ए दोरसोन देखन्या, यां गोथु निकवीन योहुदा मुलुक मा ढास जा, आरु चांत् रुटा खाया कोर, आरु चांत् ओगवाती वात कोर्या कोर, <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />पुन बेतेल मा ओळी कोदी ओगवाती वात झुन कोरे, काहाकि यु राजान चुखलु जागु आरु राजन गढ़ छे। <verse eid="AMO 7:13" /><verse number="14" style="v" sid="AMO 7:14" />आमोस जोपाप आपीन ओमस्याह काजे कोयु, हांव नी ते कागळ्यु होतु, आरु नी कागळीयान पुर्यु; हांव ते ढुरोन गुवायु, आरु गुलोरोन झाड़कान नेवाड़ने वावु होतु, <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />आरु योहोवा मेसे गाडरा बुकड़ान पोछोव-पोछोव फिरने गोथु बुलावीन कोयु, जा मारा मानसे इसराएल जुळ ओगवायती वात कोर। <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />एरकोरिन हिमी तु योहोवान बुल सोमोव, तु कोवे इसराएलोन विरुद् ओगवायती वात झुन कोरे; आरु इसहाकोन घोरानान विरुद् ताव-ताव बुल झुन सोमवाड़े। <verse eid="AMO 7:16" /><verse number="17" style="v" sid="AMO 7:17" />ओतरान कोरीन योहोवा ओसु कोवे: तारी धेन्यारी सोहोर मा छिनावाय होय जासे, आरु तारा पुर्या पुरायटा तोलवार वेर मार नाख्या जासे, आरु तारी जागा दुड़ो मापीन वाट लेसे; आरु तु आपसु विटोळ देस मा मोरीस, आरु इसराएल आपसा जागा पोर गोथा छाचिन गुलामी मा जासे।<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s">फव सी भरायलो खिल्लो</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />परमेश्वर यहोवा मखे यो देखाड़ियो: कि उनाळा दाहड़ा मा फळो सी भरायलो खिल्लो छे। <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />होयु कोयु, ए आमोस, तुसे काय देखा पोड़े? हांव कोयु “उनाळान दाहड़ान फोळ सी भोरायली एक खिल्‌ली।” तोत्‌यार यहोवा मारे सी कोयु, “मारा इसराएली मानसोन चेहलो टेम आय गोयलो छे; हां हेमी हेनुक ओळी नी छुड़ो।” <verse eid="AMO 8:2" /><verse number="3" style="v" sid="AMO 8:3" />परमेश्वर यहोवा न यो बुल छे, उना दाहड़े मन्दिरन भक्तिन गीत विखा ना बदली जासे हांव कोयु, आरु धोड़ोन एक मोटलु ढीग लाग जासे; आरु आखा जागाम चे हुगा-हुगा नाख देसे। खिल्ली<verse eid="AMO 8:3" /></para>
  <para style="s">इसराएलन नाश</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 8:4" />यो सोमवु, तुमु जे गोरीब मानसोक वेला पाड़ने आरु देसोन वेला कोरन्‌या मानसोक नास कोरने चाहाय रोया, <verse eid="AMO 8:4" /><verse number="5" style="v" sid="AMO 8:5" />जो कये, नोवलु चांद कोत्यार वितसे कि हामु ओन वेच सोकजे? आरामोन दाहड़ु कोत्‌यार जासे, कि हामु ओनोन कोंजा उगाड़ीन बाट काजे नानो आरु टाकड़ी काजे भारो कोर देजे, आरु धुका सी ठोगजे। <verse eid="AMO 8:5" /><verse number="6" style="v" sid="AMO 8:6" />कि हामु कमजुर क रिपिया अपीन, आरु गरबीयान क एक जुड़ी खासड़ान भाव मा आरु बिगेड़लो ओन वेच देय। <verse eid="AMO 8:6" /><verse number="7" style="v" sid="AMO 8:7" />योहोवा, याकुबोन मोटाय कोरनो वारु छे, चोत् आपसी आन खाईन कोवे, हांव तुमरा काहना वी कामोक कोदी नी विसरो। <verse eid="AMO 8:7" /><verse number="8" style="v" sid="AMO 8:8" />ती काय इना कारण सी धरती नी कापे? काय हेनु पोरुन सब रयने वाळा दु:ख नी करे? यो देश सब ने सब मिसरन नील नोंदीन सारको छे, जो जादा होये आरु कोम होय जाय। <verse eid="AMO 8:8" /><verse number="9" style="v" sid="AMO 8:9" />परमेश्वर यहोवान यो बुल छे, “तेन टेमे हांव दाहड़ाक सिरानोन टेमे डुबाड़ दीस, आरु इना देस काजे सिरानी वेवात् आंधारो कोर दीस। <verse eid="AMO 8:9" /><verse number="10" style="v" sid="AMO 8:10" />हांव तुमरा तिहवारन खुशी क दु:ख करावीस, आरु तुमरा सब गीत क दूर करीन विखान गीत गवाड़ीस; हांव तुमु सबन कड़ीया मा गंटो बन्‍दाड़ीस, आरु तमु आखान मुनकाक बुड़ाय दीस, आरु ओसो रोड़ावीस जोसो एकखुळ्या जुगु होये, आरु हेरा सोरनो काठला दाहड़ा सारको हुयसे। <verse eid="AMO 8:10" /><verse number="11" style="v" sid="AMO 8:11" />परमेश्वर यहोवा न यो बुल छे, देखो, असला दाहड़ा आय रीया, जव हांव इना देश मा महंगाय करीस; मानसोन भुक ते रोवसे बाखुन ओनो जुगु नी, तिसला ते रोवसे पुन पानी जुगु नी, पुन यहोवान वचन सोमोळने जुन भुख ने पीस हुयसे, <verse eid="AMO 8:11" /><verse number="12" style="v" sid="AMO 8:12" />लोगहन यहोवा न वचनन हेर करीन दोरीये गोथा दोरीये लोगुन आरु बोखेवरे गोथा उगेवने लोगुन मोर्‌या-मोर्‌या फिरसे, पुन हेको हात नी कराये। <verse eid="AMO 8:12" /><verse number="13" style="v" sid="AMO 8:13" />उना टेमा मा जुवानाया छोल्‌ला पोरायटा आरु जुवानिया पोरिया दुयु पीस सी चिमाय जासे। <verse eid="AMO 8:13" /><verse number="14" style="v" sid="AMO 8:14" />जे मानसे सामरियान, दानोन आरु बेरसेबा न पापी देवता आन खाय। चे हिट पोड़से कोदी नी उठे।”<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s">परमेश्वरन नियाव</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />हांव पोरबु काजे बेदी उपोर उबरोवलु देख्यु, आरु होयु कोयु: “खाम्बान बेला पोर दे जेरेसी पोयड़ी हाले, आरु हेनु आखा मानसोन मुनका पोर पाड़ीन टुकड़ा-टुकड़ा कोर; आरु जे नास होयने गोथा वाचे, तेनुक हां तोलवार कोरीन मार दिस; हेनुम गोथो एक वी नी ढासनी निकवसे, आरु जे आपसाक वाचाड़े, चे वाचनो नी जुवे। <verse eid="AMO 9:1" /><verse number="2" style="v" sid="AMO 9:2" />काहाकि चाहाय चे खुंदिन पाताव मा उतरी जाय, ती चां गोथु हांव हात वोदाड़ीन हेनुक लावीस; चाहाय चे वादवा उपोर चोहोड़ जाय, ती चां गोथु हांव तेनुक उतार लावीस। <verse eid="AMO 9:2" /><verse number="3" style="v" sid="AMO 9:3" />चाहाय चे कार्मेल बयड़ान कातर मा डुकाय जाय, पुन चां वी हांव हेनुक हेर हेरीन धोर लीस, आरु चाहाय चे दोरियान तोवे मारी निंगा गोथा आडोव होये, चां वी हांव घोड़सा काजे हेनुक ठुनकावनेन हुकुम आपीस। <verse eid="AMO 9:3" /><verse number="4" style="v" sid="AMO 9:4" />चाहाय वेरी धोरीन गुलामी मा ली जाय, चां वी हांव हुकुम आपीन तोलवार कोरीन हेनुक मारा नाखीस; आरु हांव हेनु पोर भोलाय कोरने कोरीन नी, बुरायत् कोरने जुगु निंगा कोरीस। <verse eid="AMO 9:4" /><verse number="5" style="v" sid="AMO 9:5" />सेनाओन परमेश्वर योहोवाक छिमने से धोरती गोळे, आरु हेरा आखा रोवनेवावा कोलपे; आरु हुये आखा की आखा मिसर देसोन नील नोदी जोसा होय जाय, जी जादा होय जाय आरु कोम होय जाय। <verse eid="AMO 9:5" /><verse number="6" style="v" sid="AMO 9:6" />जे वादवा मा आपसा बोंगलु बोनावे आरु आपसा तारामोन्डळीन निव धोरती पोर नाखे, आरु आपना हुकुम सी दोरियान पानी धोरती पोर उहवाड़ देये, तेरो नाव योहोवा छे। <verse eid="AMO 9:6" /><verse number="7" style="v" sid="AMO 9:7" />ऐ इसराएलियो योहोवान यो बुल छे काय तुमु मारे जुगु कुसियो सारका नी होय? काय हांव इसराएल काजे मिसर देस गोथु आरु पोलिस्ती काजे कोप्तोर गोथु नी निकाव लायु? <verse eid="AMO 9:7" /><verse number="8" style="v" sid="AMO 9:8" />देखु, पोरबु यहोवान निंगा इना पापी मुलुक पोर लागली छे, आरु हांव इनाक धोरती पोर गोथु नास कोरीस; तोत्‌यार वी हांव आखी रीती सी याकुबोन घोरानाक नास नी कोरो,” यहोवान यो बुल छे। <verse eid="AMO 9:8" /><verse number="9" style="v" sid="AMO 9:9" />म्हारा हुकुम सी इसराएलन घरानो आखा मुलुको मा असो जात रयसे जसो ओन चाळनी मा जात रये, पुन हेको एक बी पुसायलो दानु धरती पर नी पड़से। <verse eid="AMO 9:9" /><verse number="10" style="v" sid="AMO 9:10" />म्हारी परजान सब पापी जे कोवे, होयी पीड़ा हामरे पोर नी पोड़े, आरी नी हामुक घेरवे, होये तोलवार वेर माराय जासे।<verse eid="AMO 9:10" /></para>
  <para style="s">इसराएलन ओळी बोननो</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11" />तेन टेमे हांव दाऊदोन पोड़ला खोपड़ा काजे उबो कोरीस, आरु हेरा आखा वाड़ान नाका काजे सुदारीस, आरु हेरा उजाड़ काजे ओळी बोनावीस, आरु जोसो पेहले होतो, तेनाक तोसोत् बोनाय दीस। <verse eid="AMO 9:11" /><verse number="12" style="v" sid="AMO 9:12" />जेरेसी होये वाचला एदोमियों काजे पुन आखा मुलुकोन जे मारा मानसो कोवाये, आपसो होक कोर लेये, यहोवा जो यो काम पुरो कोरे, हेरोत् यो बुल छे। <verse eid="AMO 9:12" /><verse number="13" style="v" sid="AMO 9:13" />योहोवान यो वी बुल छे, देखु, ओसा दाहड़ा आवे, कि होव जुपनेवावा होव गेरनेवावाक आरु ओन्गुर दाख काजे कुस्सनेवावा बिज वेरनेवावा गोथु ओगु नीकवी जासे; आरु बोयड़ाम गोथो नोवलो ओन्गुरोन रोस टोपेकने लागसे, आरु आखा बोयड़ाम गोथो उहुवने लागसे। <verse eid="AMO 9:13" /><verse number="14" style="v" sid="AMO 9:14" />हांव आपसा मानसे इसराएलोन केदड़ाक पोछु ली आवीस, आरु जे उजेड़ला सोहोर काजे ओवी पोछा बोनावीन हेनुम वोस जासे, होये ओंगुरोन वाड़ी लागाडीन ओन्गुरोन रोस पीसे, आरु वाड़ी लागाडीन हेन्दरा फोळ खासे <verse eid="AMO 9:14" /><verse number="15" style="v" sid="AMO 9:15" />हांव हेनुक, हेन्दरा जागा मा वेरीस, आरु चे आपसा जागा मा हेनुक आपला छे, ओळी कोदी नी उखावे, तुमरा परमेश्वर योहोवान योत् बुल छे।<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>