<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">– Dhankavi</book>
  <para style="h">फिलिप्पियो</para>
  <para style="toc3">फिलिप्पियो</para>
  <para style="toc2">फिलिप्पियो</para>
  <para style="toc1">फिलिप्पियो क पौलुसन पत्री</para>
  <para style="mt2">फिलिप्पियो को पौलुस कि पत्री</para>
  <para style="mt1">फिलिप्पियो क पौलुसन पत्री</para>
  <para style="imt">परिचय</para>
  <para style="ip">फिलिप्पियो नी पत्रीक लिखने वाळो प्रेरित पौलुस छे। आरू यी पत्री ईशु मसीह क जनम क बाद 61 साल बाद लिखी गय आरू यी पत्री फिलिप्पियो मा रयने वाळा विश्वासी लिखी गय जव पौलुस रोम जेलखाना मा बंद हुतो <char style="xt"><ref loc="PHP 1:13">1:13</ref></char> यी पत्री उना मंडळी क लिखी गय जो फिलिप्पियो शहर मा हुती आरू फिलिप्पियो न बारा मा हामु प्रेरितन नी पत्री मा थुड़ोक देखजे। आरू मकिदूनिया प्रांतन न फिलिप्पियो शहर न राजधानी हुती आरू यी मंडळी मकिदूनिया न प्रांतन न पेहली मंडळी हुती, इनी मंडळी क पौलुस आरू सिलास दूय मेळीन शुरू करीया जव पौलुस फिलिप्पियो मा हुतो आरू तव उन दुय न क रात भर जेलखाना मा रयनो पड़ियो। <char style="xt"><ref loc="ACT 16">प्रेरितन 16</ref></char></para>
  <para style="ip">पौलुस न यी पत्री घण कामकी हुती, जव पौलुस जेलखाना मा हुतो आरू तव त्या लोगहन उको दान ली मोकलिया ओका जुगु त्यो धन्यवाद करे <char style="xt"><ref loc="PHP 4:10-19">4:10-19</ref></char> जेलखाना मा ओकी हालत कसी छे यो देखाड़ने करीन आरू तीमुथियुस आरू इपफ्रूदीस क बारा मा देखाड़े काहकि त्या ओगा जाईन उन दुय क आव भाव करे आरू त्यान पुढारीपन क मान लेय। <char style="xt"><ref loc="PHP 2:19-30">2:19-30</ref></char></para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. फिलिप्पियो नी मंडळी क नमस्कार करीन पौलुस इनी क शुरू करे। <char style="ior"><ref loc="PHP 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. पौलुस ओकी हालत आरू समस्या न बारा मा देखाड़े। <char style="ior"><ref loc="PHP 1:3-2:30">1:3–2:30</ref></char></para>
  <para style="io1">3. पौलुस विश्वासी जीवन कसो जीवनो आरू कसो चालनो ओका बारा मा देखाड़े। <char style="ior"><ref loc="PHP 3:1-4:9">3:1–4:9</ref></char></para>
  <para style="io1">4. त्यो धन्यवाद दीन इनी पत्री क खतम करे। <char style="ior"><ref loc="PHP 4:10-23">4:10-23</ref></char></para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 16:12">प्रेरितन 16:12</ref>
      </char>
    </note>मसीह ईशु क चाकरीया पौलुस आरू तीमुथियुस क तरप छे,</para>
  <para style="p" vid="PHP 1:1">आखा चुखा लोगहन क नाव जो मसीह ईशु मा हईन फिलिप्पी मा रयता छे, अध्यक्ष आरू सेवको सहावत।<verse eid="PHP 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 1:2" />हामरा बास यहोवा–भगवान आरू पोरबु ईशु मसीह की आरू छे तुमूक फोकटन दया आरू शांती मिवती रये। <figure style="fig" alt="City of Philippi" file="hk00363c।tif" size="span" copy="Horace Knowles ©" ref="1:1">फिलिप्पीन शहर</figure><verse eid="PHP 1:2" /></para>
  <para style="s">पौलुसन प्रार्थना आरू धन्यवाद</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />हाव जव तुमूक फोम करता छे तव आपसा यहोवा–भगवान क धन्यवाद करता छे। <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />आरू जव किही तुमू सब क करता रावन्या करता छे, तो सदा खुशी क साथे रावन्या करता छे। <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />अतरान करीन कि तु पेहल दाहड़ो छे आज तक खुश खबर क पसरावने मा मारो साजलिया रहवला छे। <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />मखे इनी वात क भरसु छे कि जिनुम तुमूक हाव वारलो काम सोरू कामो छे, ईशु मसीह क दाहड़े तक पूरो करसे। <verse eid="PHP 1:6" /><verse number="7" style="v" sid="PHP 1:7" />न्यायी छे कि हाव तुमू सब क करता ओसो ही विचार करीस, काहकि तुमू मारा मन मा आय बस्या होय, आरू मारी कैद मा आरू खुश खबर क करता जवाब आरू प्रमाण देने मा तुमू सब मारे साथे फोकटन दया मा सहभागी होय। <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />इनाम यहोवा–भगवान मारो गवा छे कि हाव मसीह ईशु की सी दया करीन तुमू सब की लालस करता छे।<verse eid="PHP 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 1:9" />हाव यी प्रार्थना करे कि तुमरा मोंग ज्ञान आरू सब प्रकार क विवेक सहित आरू भी बढ़तो जाय। <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />याहा तक कि तुमू वारू छे वारू वात क मोंगावु जानो, आरू मसीह क दाहड़े तक सचा बने रया, आरू ठुकर नी खाय। <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />आरू ओको न्यायपन क फोव छे जो ईशु मसीह क द्वारा हुयसे छे, भरपूर हुयसे जावु जिनुछे यहोवा–भगवान की महिमा आरू बढ़ाई होयती रये।<verse eid="PHP 1:11" /></para>
  <para style="s">पौलुसन कैद छे खुश खबर की बढ़ती</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />हे भाईस, हाव जूवतो छे कि तुमू यो जान लेवु कि मखे पर जो बीता छे, ओका सी खुश खबर ही की बढ़ती होयी। <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" /><note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="ACT 28:30">प्रेरितन 28:30</ref></char></note>याहा तक कि कैसर क किलान की सारी पलटन आरू शेष सब मानसे मा यो प्रगट होय गया छे कि हाव मसीह क करता कैद छे। <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />आरू पोरबु मा जो भाईस छे, इनुमा छे खुब जना मारे कैद होयनेन कारण, हियाव बांधीन यहोवा–भगवान क वचन निधड़क सोमवावने क आरू हेम्मत करतो छे।<verse eid="PHP 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15" />काही तो डाह आरू झगड़ा क कारण मसीह क खबर करतो छे आरू काही वारली मरजी छे। <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />कयी एक तो यो जानीन कि हाव खुश खबर क करता जवाब देने क ठेराया गया छे, मोंग छे खबर करता छे। <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />आरू कयी एक तो सुधी छे नी पर विरोध छे मसीह की कथा सोमवाता छे, यो सुचीन कि मारी कैदी मा मारे करता पीड़ा पैदा करे।<verse eid="PHP 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PHP 1:18" />तो काय हुयो? केवल यो कि हर प्रकार छे, जूवे वजेसे छे जूवे सची छे, मसीहन काहनी सोमवाड़ जाती छे, आरू हाव ओका सी खुशी छे आरू खुशी रोवीस भी।<verse eid="PHP 1:18" /></para>
  <para style="s">जीवतो रोवने मसीह छे</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 1:19" />काहकि हाव जानतु छे तुमरी रावन्या क द्वारा, आरू मसीह की आत्मा क दान क द्वारा, ऐरो हर फोव मारो उध्दार होयछे। <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />हाव तो योही हार्दिक लालस आरू आश राखतो छे कि हाव काही वात मा लज्जित नी हुयो, पुन जोसो मारो मजबुत साहस क कारण मसीह की बढ़ाई मारो डील क द्वारा सदा होयती रयी छे, वोसी ही हिमी भी होय, जूवे हाव जीवतो रोवीस या मर जाईस। <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />काहकि मारे करता जीवतो रोवने मसीह छे, आरू मर जाने लाभ छे। पुन यदि डील मा जीवतो रोवने ही मारो काम क करता लाभदायक छे तो हाव नी जानतु कि कुनीक त्योना। <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />काहकि हाव दुयन वीच मा टागायलु छे; जी तो जूवतो छे कि काही करीन मसीहन साथे जाय रवु, काहकि यो घोणा ही वारलो छे। <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />काहकि हाव दुयून विच विचार मा चस्ठी रयु; जी तु जुवतो छे कि कूच करीन मसीहन साथे जायन रवु, काहकि यो घोणा ही वारलो छे। <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />पुन डील मा रोवने तुमरे कारण आरू भी छाची छे। <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />अतरान करीन कि मखे ऐरो विश्वास छे शेवली कावा हाव जानता छे कि हाव जीवतो रोवीस, वरना तुमू आखा साथे रोवीस जिनाछे तुमू विश्वास मा दृढ़ हुयसे जावु आरू इनुमा खुशी रवु। <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />आरू जो डाहळाय तुमू मारा विषय मा करता होय, वो मारे पछु तुमरे साथे आवने छे मसीह ईशु मा सवटो बढ़ जावु।<verse eid="PHP 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27" />सिर्फ ओतरा करू कि तुमरो चाल–चालने मसीहान खुश खबर क योग्य छे क चाहे कि हाव आवीन तुमूक देखसु, चाहे भी नी जाऊ, तुमरा बारा मा यी सोमव्यु कि तुमु एकुज आत्मा मा स्थिर रवे, आरू एक जागे ध्यान लागाड़े खुश खबर क विश्वासन करता मेहनत करता आरू जीवन जीवता रवजु। <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />आरू काही वात मा विरोध छे भय नी खाता। यो इन्दरे करता विनाश क साप सहलानी छे, पुन तुमरे करता उध्दार क आरू यो यहोवा–भगवानन चा रयन छे। <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />काहकि मसीह क कारण तुमू यो फोकटन दया हुयो कि नी केवल ओको पर विश्वास करू पर ओको करता दुःख भी झेलो। <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" /><note caller="+" style="x"><char style="xo" closed="false">1:30 </char><char style="xt" closed="false"><ref loc="ACT 16:19-40">प्रेरितन 16:19-40</ref></char></note>आरू तुमूक वोसो ही मेहनत करनो छे, जोसो तुमू ने मखे करता देख्या छे, आरू हिमी भी सोमवता होय कि हाव वोसो ही करता छे।<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s">मसीहन दीनता आरू महानता</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />शेवली कावा यदि मसीह मा काही शांती, आरू मोंग छे ढाढ़स, आरू आत्मा की सहभागिता, आरू काही करूणा आरू दया छे। <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />तो मारो याहा खुशी पूरो करू कि एक मन रयो, आरू एक ही मोंग, एक मनीया, आरू एक ही मनसा राखु। <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />विरोध या झुठी बढ़ाईन करता काही नी करू पर दीनता छे एक दिसरा न आपने छे वारलो समझो। <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />हर एक आपने ही हित की नी, वरना दिसरा न हित की भी चिंता करे। <verse eid="PHP 2:4" /><verse number="5" style="v" sid="PHP 2:5" />जोसो मसीह ईशु क स्वाभाव होतो वोसो ही तुमरा भी स्वभाव होय।<verse eid="PHP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6" />जो यहोवा–भगवानन स्वरूप मा हईन भी यहोवा–भगवानन</para>
  <para style="q2" vid="PHP 2:6">तुल्य होयनेन आपने वश मा राखने की चीज नी समझा।<verse eid="PHP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7" />वरना आपने आप क खुद हटाव दिदा,</para>
  <para style="q2" vid="PHP 2:7">आरू दासन स्वरूप धारण कर्‍या,</para>
  <para style="q2" vid="PHP 2:7">आरू मानुस की समानता मा होय गया।<verse eid="PHP 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PHP 2:8" />आरू मानसोन रूप मा प्रगट हईन आपने आप क दीन कर्‍या,</para>
  <para style="q2" vid="PHP 2:8">आरू याहा तक हुकुमकारी रया कि मृत्यु,</para>
  <para style="q1" vid="PHP 2:8">हाव, कुरूस की मृत्यु भी सह ली।<verse eid="PHP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9" />इनीये कारण यहोवा–भगवान ने ओको घण महान भी कर्‍या,</para>
  <para style="q2" vid="PHP 2:9">आरू ओको वो नाव राख्या जो सब नाव मा छेरठ छे।<verse eid="PHP 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10" />कि जो सोरगदूत मा आरू धरती पर आरू धरती क नेचो छे,</para>
  <para style="q2" vid="PHP 2:10">वो सब ईशुन नाव पर माड़ा।<verse eid="PHP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PHP 2:11" />आरू यहोवा–भगवान बाकी महिमान करता</para>
  <para style="q2" vid="PHP 2:11">हर एक जीभ पछतावो कर लेय कि</para>
  <para style="q1" vid="PHP 2:11">ईशु मसीह ही पोरबु छे।<verse eid="PHP 2:11" /></para>
  <para style="s">संसार मा दिया सदृश चमको</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />अतरान करीन मोंगावु, जिना प्रकार तुमू सदा छे हुकुम मानता आश होय, वोसो ही हिमी भी नी केवल मारे साथे रोयता होया पर विशेष करीन हिमी मारे दूर रोवने पर भी बीक राखता जाईन आरू कापता होया आपने उध्दार क काम पूरो करता जावु। <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />काहकि यहोवा–भगवान ही छे जुने आपसी सुइच्छा निमित्त तुमरा मन मा मरजी आरू काम, दुयू वातन करीन शक्ति नाखता छे।<verse eid="PHP 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14" />सब काम कुरकुर नी करता जाईन आरू विना विवाद कर्‍या करू। <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />ताकि तुमू निर्दोष आरू भोले हईन टेढ़ आरू हठीले मानसे क विच यहोवा–भगवानन निष्कलंक अवलियाद बन रया, जिन्दरे विच मा तुमू जीवनन वचन लेदा होय धरती मा धपता दिवान समान देखाड़ देता होय। <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />कि मसीहन दाहड़ा मखे डाहळाय करनेन कारण होय कि नी मारो दौवड़नेन आरू नी मारो मेहनत करने व्यर्थ हुयो।<verse eid="PHP 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 2:17" />यदि मखे तुमरा विश्वास रूपी बलिदान आरू सेवा न साथे आपसा लुहूय भी वयाड़नु पड़े, तवभी हाव खुशी छे आरू तुमू सबन साथे खुशी राखता छे। <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />वोसो ही तुमू भी खुशी होय आरू मारे साथे खुशी करू।<verse eid="PHP 2:18" /></para>
  <para style="s">तीमुथियुस आरू इपफ्रूदीतुस</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />मखे पोरबु ईशु मा आश छे कि हाव तीमुथियुस न तुमरे साथे तत्काल मुकल्या, ताकि तुमरी दशा सोमवीन मखे शांती मिवछे। <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />काहकि मारे साथे ओसो स्वभावन काही नी जो चुखो मन छे तुमरी चिंता करे। <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />काहकि सब आपने स्वार्थ की हेर मा रोयता छे, नी कि ईशु मसीहन। <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />पर तीनाक तो तुमू ने पारखे आरू जान भी लेदा छे कि जोसो पोर्‍य बासन साथे करता छे, वोसो ही त्यो खुश खबर क फैलाने मा मारे साथे मेहनत कर्‍या। <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />अतरान करीन मखे आश छे कि ज्यो ही हावखे जानो पड़से कि मारी काय दशा होछे, त्यो ही, हाव ओको तत्काल मुकली देसे। <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />आरू मखे पोरबु मा विश्वास छे कि हाव आप भी शीघ्र आवीस।<verse eid="PHP 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25" />पर हाव ने इपफ्रुदीतुस क जो मारो भाईस आरू सहकर्मी आरू संगी योध्दा आरू तुमरो, आरू छाची वात मा मारी सेवा टहल करनेवावा छे, तुमरे साथे मुकलने छाची समझा। <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />काहकि तेरो मन तुमू सब मा लाग होया हुता, अतरान करीन कारण वो व्याकुल रोयता हुता काहकि तुमू ने ओको की बीमार क हाल सोमवाय होतो। <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />छाचो ही वो बीमार तो होय होतो याहा तक कि मरना पर होतो, पुन यहोवा–भगवान ने ओको पर दया करी, आरू केवल ओको ही पर नी पर मखे पर भी कि मखे शोक पर शोक नी होय। <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />अतरान करीन हाव ने ओको मुकलने आरू भी यत्न कर्‍या कि तुमू ओका सी पछु भेंट करीन खुशी होय जाय आरू मारी भी शोक घट जाय। <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />अतरान करीन तुमू पोरबु मा ओका सी घोणा खुशीन साथे भेंट करने, आरू ओसो काय विजुत कर्‍या करने। <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />काहकि वो मसीहन कामन करता आपने जीव पर जोखिम उठाड़ीन मरलान निकट आय गयो होतो ताकि जो घटी तुमरी आरू छे मारी सेवा मा होयी ओको पूरो करे।<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s">सची न्यायपन</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />अतरान करीन हे भाईस, पोरबु मा खुशी रवु। वो ही वात तुमूक बार बार लिखने मा मखे तो काही कष्ट नी हुता, आरू इनमा तुमरी कुशलता छे। <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />कुत्रान चोकचौळीया रयो, उन बुरे काम करनेवावा छे चोकस रयो, उन काट कुट करनेवावा छे चोकस रयो। <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />काहकि खतनावावा तो हामु ही छे जो यहोवा–भगवानन आत्मान अगवाय छे उपवास करता छे आरू मसीह ईशु पर डाहळाय करता छे, आरू डील पर विश्वास नी राखता। <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />पर हाव तो डील पर भी विश्वास राख सकतो छे। <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" /><note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="ROM 11:1">रोमियो 11:1</ref> </char><char style="xt" closed="false"><ref loc="ACT 23:6">प्रेरितन 23:6</ref>; <ref loc="ACT 26:5">26:5</ref></char></note>आठवो दाहड़ो मारो खतना हुयो, इस्त्राएलन वंश, आरू बिन्यामीनन क अवळियाद छे; बिन्यामीनन इब्रानी छे; व्यवस्थान विषय मा यदि कयो तो फरीसि छे। <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" /><note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="ACT 8:3">प्रेरितन 8:3</ref>; <ref loc="ACT 22:4">22:4</ref>; <ref loc="ACT 26:9-11">26:9-11</ref></char></note>मरजी विषय मा यदि कयो तो मंडळी सतानेवावान; आरू व्यवस्था की न्यायपन विषय मा यदि कयो तो निर्दोष होतो। <verse eid="PHP 3:6" /><verse number="7" style="v" sid="PHP 3:7" />पुन जो वात मारे लाभ करी होती, उका क हाव ने मसीहन कारण हानि समझ लेदा छे। <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />वरना मा आपने पोरबु मसीह ईशुन उवख करी वारला कारण सब वातन हानि समझता छे ओका कारण हाव ने सब चीज की नुक्सान झेलीयो आरू तीनुक कूड़ा समझता छे, जिनाछे हाव मसीहक हासिल करू। <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />आरू इनाम देखाय जासु; नी कि आपसी ओको न्यायपनन साथे, जो व्यवस्था छे, वरना ओको न्यायपनन साथे जो मसीह पर विश्वास करनेन कारण छे आरू यहोवा–भगवानन चा रयन विश्वास करने पर मिवती छे। <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />ताकि हाव ओको आरू ओका मरलाजनान सामर्थ्यान आरू ओको साथे दुःख मा सहभागी होयनेन मर्मान जानु आरू ओका मरनन समानताक हासिल करू। <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />कि हाव काही भी रीति छे मरला होया मा छे जीवन उठनेन पद तक पुच्या।<verse eid="PHP 3:11" /></para>
  <para style="s">निशानन चा रयन दौवड़ने</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />यो मतलब नी कि हाव देख त्योक्या छे, या सिध्द होय त्योक्या छे; पर उनी चीज क धरनेन करता दौवड़ीन चाल जाता छे, ओका करता मसीह ईशु ने मखे दरिया होतो। <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />हे भाईस, मारी भावना यो नी हाव धर त्योक्य; पुन केवल यो एक काम करता छे कि जो बात पछव रया गयी छे तीनुक वीसरीन कर, ओगव की वातन चा रयन बढ़ता हुयो। <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />निशानोन चा रयन दौवड़ीन चाल जात छे, ताकि वो इनाम देखछे ओका करता यहोवा–भगवान ने मखे मसीह ईशु मा ऊपर बुलायो छे।<verse eid="PHP 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 3:15" />हामु मा छे जोतरा सिध्द छे, योही विचार राख, आरू यदि काही वात मा तुमरो आरू ही विचार होय तो यहोवा–भगवान ओको भी तुमू पर प्रगट कर देसे। <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />अतरान करीन वा तक पुच्या छे, ओको लारे चाले।<verse eid="PHP 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:17 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 4:16">1 कुरन्थियो 4:16</ref>; <ref loc="1CO 11:1">11:1</ref></char>
    </note>हे भाईस्यो, तुमू सब हाववीन मारेसी चाल चालीन, आरू तीनुक उवखी राखु जो इनी रीति पर चालतो छे ओका उदाहरण तुमू हामु मा देखता होय। <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />काहकि घोणा छे ओसी चाल चालता छे, जेरो चर्चा हाव ने तुमू छे बार बार करी छे, आरू हिमी रड़ता जाईन कयता छे कि वो आपसी चाल चालीन छे मसीहन कुरूसन दुस्मन छेे। <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />तींदरा आखरी विनाश छे, तींदरा भगवान पेट छे, वो आपसी लज्जान वात पर डाहळाय करता छे आरू धरती चीज पर मन लागाड़ रोवता छे। <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />पर हामरा स्वदेश सोरगदूत पर छे; आरू हामु एक उध्दारकरता पोरबु ईशु मसीहन वाँ छे आवनेन वाट जुय रया छे। <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />वो आपसी शक्तिन क उना साहळा क अनसारे जिनान लारे त्यो सब चीजन क ओका हक कर सके, हारो दाहड़ीन साहळो बदलीन आपसी महिमा न तसो बनाय देसे।<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />अतरान करीन हे मारा मोंगावु भाईस्यो, जिनमा मारो जीव लागी रोवतो छे, जी मारी खुशी आरू मुकूट होय, हे मोंगावु भाईस्यो, पोरबु मा इन प्रकार स्थिर रयो।<verse eid="PHP 4:1" /></para>
  <para style="s">व्यावहारिक निर्देश</para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />हाव यूओदिया क भी समझाता छे आरू सुन्तुखेन भी, कि वो पोरबु मा एक मन रयो। <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />हे सच सहकर्मी, हाव तुखे छे भी रावन्या करता छे कि तु तीनु बायरन मदत कर, काहकि चे मारे खुश खबर पुगाने मा, क्लेमेंस आरू मारा दिसरा सहकर्मियो सहावत मेहनत कर्‍या, जिन्दरो नाव जीवनन किताब मा लिखलो छे।<verse eid="PHP 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4" />पोरबु मा हहावशा खुश रवु; हाव पछु कयता छे, खुश रवु।<verse eid="PHP 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 4:5" />तुमरी कोमलता सब मानसे पर प्रगट होय। पोरबु निकट छे। <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />काही भी वातन चिंता मा करू; पुन हर एक वात मा तुमरो निवेदन, प्रार्थना आरू रावन्यान द्वारा धन्यवादन साथे यहोवा–भगवानन सम्मुख हजुर होयती जाय। <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />तव यहोवा–भगवानन शांती जो सारी समझ छे बाहर छे, तुमरे दिल आरू तुमरो विचारन मसीह ईशु मा सोरक्षित राखछे।<verse eid="PHP 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8" />अतरान करीन हे भाईस्यो, जी जी वात सच्चाई छे, आरू जी जी वात विजुत बढ़े छे, आरू जी जी वात न्यायी छे, आरू जी जी वात चुखलो छे, आरू जी जी वात मनभावनी छे, मतलब जो भी सद्गुण आरू वाहवाय की वात छे तीनु पर ध्यान लागाड़ ्या करू। <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />जी वात तुमू ने मखे छे सिकली, आरू मान्य करी, आरू सोमवी, आरू मखे मा देख, तीन्दरो पालन कर्‍या करू, तव यहोवा–भगवान जी शांतीन आपे छे जु हामरे साथे रोवसे।<verse eid="PHP 4:9" /></para>
  <para style="s">दानन करीन धन्यावद</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />हाव पोरबु मा घोणा खुशी छे कि हिमी ओतरा दाहड़ान बाद तुमरी चिंता मारे विषय मा पछु जागृत होयी; छाचो तुमू शुरू मा भी ऐरो विचार होतो, पर तुमू मेखे नी मिव्यो। <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />यो नी कि हाव आपसी घटीन कारण यो कयतो छे; काहकि हाव ने यो सिक्यो छे कि जिन दशा मा छे; ओको मा सन्तोष करू। <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />हाव दीन भी होयनो जानतु छे आरू बढ़ने भी जानतु छे; हर एक वात आरू सब दशा मा हाव ने तृप्त हुयने, भूकलो रोवने, आरू वदने घटने सिक्यो छे। <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />जो मखे शक्ति देतो छे तीनामा हाव सब काही कर सकतो छे।<verse eid="PHP 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14" />तवभी तुमू ने भला कर्‍या कि मारो पीड़ा मा मारो भागीदार हुयो। <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />फिलिप्पियो, तुमू आप भी जानता होय कि खुश खबर खबरन शुरू मा, जव हाव मकिदुनिया छे विदा हुयो, तव तुमू छुड़ आरू काही मंडळी ने लेना देनान विषय मा मारी मदत नी करी। <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" />इनीये प्रकार जव हाव थिस्सलुनीके मा होतो, तव भी तुमू ने मारी घटी पूरी करनेन करता एक बार काय वरना दुय बार काही मुकल्या हुता। <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />यो नी कि हाव दान आपने जूवतो छे पुन हाव ओसो फोव आपने जूवतो छे जो तुमरो लाभन करता बढ़तो जाय। <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />मारे साथे सब काही छे, वरना बहुतायत छे भी छे; जो चिज तुमू ने इपफ्रुदीतुस हात छे मुकली होती तीनुक देखीन हाव तृप्त होय गयो छे, वो तो सुखदायक सुगन्ध, मान्य करने योग्य बलिदान छे, जो यहोवा–भगवानन भाता छे। <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />मारो यहोवा–भगवान भी आपसा तिना धनन लारे जो महिमा सहित मसीह ईशु मा छे, तुमरी हर एक कमी घटीक पूरी करसे। <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />हामरा यहोवा–भगवान आरू बासन महिमा युगानयुग हयती रवे। आमेन।<verse eid="PHP 4:20" /></para>
  <para style="s">आखरी नमस्कार</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />हर एक चुखलो जनन, जो ईशु मसीह मा छे नमस्कार कयो। जो भाईस मारे साथे छे, तुमू नमस्कार कयता छे। <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />सब चुखलो मानछे, विशेष करीन जो कैसरन घरानान छे, तुमूक नमस्कार कयता छे।<verse eid="PHP 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23" />हामरा पोरबु ईशु मसीहन फोकटन दया तुमरी आत्मान साथे रोवे।<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>