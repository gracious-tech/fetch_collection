<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">– Dhankavi</book>
  <para style="h">3 यहुन्ना</para>
  <para style="toc3">3 यहुन्ना</para>
  <para style="toc2">3 यहुन्ना</para>
  <para style="toc1">यहुन्ना नी लिखली तीसरी पत्री</para>
  <para style="mt2">यहुन्ना कि लिखी हुई तीसरी किताब</para>
  <para style="mt1">यहुन्ना नी लिखली तीसरी पत्री</para>
  <para style="imt">परिचय</para>
  <para style="ip">3 यहुन्ना क पत्री ईशु मसीहन जन्मान 50 साल बाद आरू 100 साल क वीच मा प्रेरित यहुन्ना ने लिख्यो होतो। यहुन्ना खुद क लेखक रूप मा उवखायतो नी छे, पुन अतरान करीन बजाय खुद क मोटी <char style="xt"><ref loc="3JN 1:1">1:1</ref></char> कयतो छे। यो वो <char style="xt"><ref loc="2JN 1:1">2 यहुन्ना 1:1</ref></char> मा चो करता ओसो मानी जाता छे, कि यहुन्ना क खुश खबर लिख्यो होतो यहुन्ना तीन पत्री न 1 यहुन्ना, 2 यहुन्ना आरू 3 यहुन्ना जबकि इफिसुस मा रयता छे।</para>
  <para style="ip">यहुन्ना गयुस नाम क एक विश्वासी क यो पत्री लिख्यो होतो, चो एक दोस्तन रूप मा गयुस पतु आरू निर्देश आरू विश्वासी भाईस जो क्षेत्र क माध्यम छे यात्रा कर रया छे पाहंनतराय होय।</para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. यहुन्ना परिचय आपनो पत्री <char style="ior"><ref loc="3JN 1:1">1:1</ref></char></para>
  <para style="io1">2. वो तो गयुस क बढ़ावु करता छे आरू तेरा भाईस <char style="ior"><ref loc="3JN 1:2-8">1:2-8</ref></char></para>
  <para style="io1">3. पाहंनतराय क देखाडने क निर्देश देता छे, वो दुय दिसरा मानुस, दियुत्रिफेस आरू दिमेत्रियुस <char style="ior"><ref loc="3JN 1:9-12">1:9-12</ref></char> क बुलता छे।</para>
  <para style="io1">4. आखरी मा वो आपनो पत्री <char style="ior"><ref loc="3JN 1:13-14">1:13-14</ref></char> क समापन।</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:29">प्रेरितन 19:29</ref>; <ref loc="ROM 16:23">रोमियो 16:23</ref>; <ref loc="1CO 1:14">1 कुरन्थियो 1:14</ref></char>
    </note>मखे पुढारी की आरू छे मोंगावु गयुस क नाव,</para>
  <para style="p" vid="3JN 1:1">जिनासे मा सच्चा मोंग राखता छे।<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />हे मोंगावु, मारी यो प्रार्थना छे कि जोसो तु आत्मिक बढ़ती कर रया छे, वोसो ही तु सब वात मा बढ़ती करे आरू भला वारू रया। <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />काहकि जव भाईस ने आवीन तारे उना सच्चाई की गवा देदी, जिना पर तु सचमुच चालता छे, तो मा घोणा ही खुश हुयो। <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />मखे इनासे बढ़ीन आरू काही खुश नी कि हाव सुनू, कि मारे पोर्‍य सच्चाई पर चालता छे।<verse eid="3JN 1:4" /></para>
  <para style="s">गयुस की वाहवाय</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />हे मोंगावु, जो काही तु उन भाईस क साथे करता छे, जो परदेशी छे, ओको तु ईमानदारी छे करता छे। <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />त्या मंडळी क सामने तारे मोंग की गवा देदी छे। यदि तु तीनुक उना प्रकार विदा करसे जिना प्रकार यहोवा–भगवान क मानसे क करता वारू छे तो वारलो करसे। <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />काहकि वो ओको मसीह क नाव क करता निकवता छे, आरू गैरयहुदी छे काही नी लेता। <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />एरकरीन ओसो क स्वागत करने जुवे, जिनासे हामु भी सच्चाई क पक्ष मा ओको सहकर्मी होय।<verse eid="3JN 1:8" /></para>
  <para style="s">दियुत्रिफेस आरू दिहावत्रियुस</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />हाव ने मंडळी क काही लिख्या हुता, पर दियुत्रिफेस जो उनमा मोटो बनने जुवता छे, हामु मान्य नी करता। <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />एरकरीन जव हाव आवीस तो ओका काम की जो वो कर रया छे, याद आपाड़ीस, कि वो हामरे विषय मा बुरी–बुरी वात बकता छे: आरू इनीये पर भी सन्तोष नी करीन आप ही भाईस क मान्य नी करता, आरू तीनुक जो मान्य करने जुवता छे मना करता छे आरू मंडळी छे निकाव देता छे।<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />हे मोंगावु बुराई क नी पर भलाई क साजलिया होय। जो भलाई करता छे, वो यहोवा–भगवान की आरू छे, पर जो बुराई करता छे, त्यो यहोवा–भगवान क नी देख्य।<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />दिहावत्रियुस क विषय मा सब ने, वरना सच्चाई ने भी आप ही गवा देदी; आरू हामु भी गवाय देता छे, आरू तु जानता छे कि हामरी गवा सच्ची छे।<verse eid="3JN 1:12" /></para>
  <para style="s">आखरी नमस्कार</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />मखे तुखे क घोणा काही लिखने तो हुता, पर शाही आरू पेन छे लिखने नी जुवता। <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />पर मखे आश छे कि तुखे छे शीघ्र भेंट करीस, तव हामु आमने सामने वातचीत करसु।<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />तुखे शांती मिवती रये। याहा क दोस्त तुखे नमस्कार कयता छे।</para>
  <para style="p" vid="3JN 1:15">वाँ क दोस्तो छे नाव लेय लीन नमस्कार कय दिदा।<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>