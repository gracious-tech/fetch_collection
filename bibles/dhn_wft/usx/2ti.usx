<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">Dhankavi</book>
  <para style="h">2 तीमुथियुस</para>
  <para style="toc3">2 तीमुथियुस</para>
  <para style="toc2">2 तीमुथियुस</para>
  <para style="toc1">तीमुथियुस क पौलुसन दिसरी पत्री</para>
  <para style="mt2">तीमुथियुस को पौलुस कि दुसरी पत्री</para>
  <para style="mt1">तीमुथियुस क पौलुसन दिसरी पत्री</para>
  <para style="imt">परिचय</para>
  <para style="ip">2 तीमुथियुस कि पत्री मा आपने शिष्य तीमुथियुस क प्रेरित पौलुसन दिसरो पत्री छे। 2 तीमुथियुस पौलुस क जीवन क आखरी साथे लिख्यो गयो होतो। वो इनीये टेहाव <char style="xt"><ref loc="2TI 1:16">1:16</ref></char> क दौरान रोमन मा कैद होया। पौलुस तीमुथियुस साथे रिश्तो होतो आरू अक्सर ओको एक पोर्‍या क रूप मा मुकल्या<char style="xt"><ref loc="PHP 2:22">फिलिप्पियो 2:22</ref></char><char style="xt"><ref loc="1TI 1:2">1 तीमुथियुस 1:2</ref>; <ref loc="1TI 1:18">1:18</ref></char></para>
  <para style="ip">यो पौलुस छे चार अक्सर मा रयन एक छे कि एक मानसोन बजाय एक मंडळी क संबोधित कर रया छे। दिसरा तीन ओसो पत्री छे, 1 तीमुथियुस, तीतुस आरू फिलेमोन। 2 तीमुथियुस लिख्यो गयो छे कि टेहाव क दौरान, रोमन साम्राज्य मा भुरसीया क सताया जाय रया हुता। यो शायद कारण छे कि पौलुस जेल मा होतो आरू तीमुथियुस क वातड़ी मेहनत सहनेन निर्देश होतो। क रूप मा 1 तीमुथियुस, पौलुस क देता छे।</para>
  <para style="ip">तीमुथियुस झूठा मास्तरीया क बारा मा कयी चेतावनी <char style="xt"><ref loc="1TI 1:16-18">1 तीमुथियुस 1:16-18</ref></char> वो भी तीमुथियुस कयता छे कि वाँ मुश्किल टेहाव ओगव <char style="xt"><ref loc="2TI 3:1">3:1</ref></char> होयछे।</para>
  <para style="is">रूप रेखा</para>
  <para style="io1">1. पौलुस तीमुथियुस स्वागत द्वारा चालु हुयनो आरू पछो ओको जुर देवाड़नो। <char style="ior"><ref loc="2TI 1:1-18">1:1-18</ref></char></para>
  <para style="io1">2. तव वो तीमुथियुस क सहने त्यो नौतियो। <char style="ior"><ref loc="2TI 2:1-13">2:1-13</ref></char></para>
  <para style="io1">3. ओगव वो ओको काही साध उपाय देय। <char style="ior"><ref loc="2TI 2:14-26">2:14-26</ref></char></para>
  <para style="io1">4. पछु ओको भविष्य की घटना आरू सही तरीका छे प्रतिक्रिया क बारा मा चेतावनी देता छे। <char style="ior"><ref loc="2TI 3:1-4:8">3:1–4:8</ref></char></para>
  <para style="io1">5. पौलुस तीमुथियुस क करता काही व्यक्तिगत टिप्पणी क साथे खत्म। <char style="ior"><ref loc="2TI 4:19-22">4:19-22</ref></char></para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="s">नमस्कार</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />पौलुसन चा रयन सी जो, ओको जीवन की प्रतिज्ञा क लारे जो मसीह ईशु मा छे, यहोवा–भगवान की मरजी छे मसीह ईशु क प्रेरित छे।<verse eid="2TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TI 1:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:2 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 16:1">प्रेरितन 16:1</ref>
      </char>
    </note>मोंगावु पोर्‍या तीमुथियुस क नाव यहोवा–भगवान बास आरू हामरा पोरबु</para>
  <para style="p" vid="2TI 1:2">मसीह ईशु की आरू छे तुखे फोकटन दया आरू दया आरू शांती मिवती रोवे।<verse eid="2TI 1:2" /></para>
  <para style="s">धन्यवाद आरू बढ़ावु</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />जिना यहोवा–भगवान की सेवा मा आपसा बास दादा की रीति पर चुखो विवेक छे करता छे, तिनान धन्यवाद होय कि हाव आपसी प्रार्थना मा तुखे रातने दाहडु फोम करतो छे। <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />आरू तारा आसा की सुधि कर करीन रात दाहडु तुखे छे भेंट करने की लालस राखता छे कि खुशी छे भर जाय। <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" /><note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="ACT 16:1">प्रेरितन 16:1</ref></char></note>मखे तारे वोखे निष्कपट विश्वास की सुधि आवती छे, जो पेहल तारी नानी लोइस आरू तारी आश यूनीके मा हुता, आरू मखे छाचो छे कि तुखे मा भी छे। <verse eid="2TI 1:5" /><verse number="6" style="v" sid="2TI 1:6" />इनी कारण हाव तुखे याद देवाड़ता छे कि तु यहोवा–भगवान क ओको वरदान क जो मारे हात राखने क तुखे मिव्यो छे प्रज्वलित कर देय। <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />काहकि यहोवा–भगवान हामु क डर नी पुन शक्ति आरू मोंग आरू संयम क आत्मा देदी छे।<verse eid="2TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8" />एरकरीन आमरो पोरबु की गवा छे, आरू मखे छे जो ओको कैदी छे, लज्जित नी होय पर ओको यहोवा–भगवान की शक्ति क लारे खुश खबर क करता मारे साथे दुःख झेलीयो। <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />जो हामरा उध्दार कर्‍यो आरू चुखलो बुलावट छे बुलाया, आरू यो आमरो काम क लारे नी; पर ओका उद्देश्य आरू ओको फोकटन दया क लारे छे जो मसीह ईशु मा अमरकाय छे हामु पर होया छे। <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />पर हिमी हामरा उध्दारकरता मसीह ईशु क प्रगट हुयने क द्वारा प्रकाशित हुयो, जो मरन क नाश कर्‍या आरू जीवन आरू अमरकाय डील क ओको खुश खबर क द्वारा चमकाड़ देदा।<verse eid="2TI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:11 </char>
      <char style="xt" closed="false">
        <ref loc="1TI 2:7">1 तीमुथियुस 2:7</ref>
      </char>
    </note>जिना क करता हाव खबरक, आरू प्रेरित, आरू शिक्षा देने वाळा भी ठराय। <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />इनीये कारण हाव इन दुःख क भी झेलतो रये छे, पर लाज नी काहकि हाव ओको जिना पर हाव ने विश्वास कर्‍या छे, जानता छे; आरू मखे छाचो छे कि वो मारी जवाबदारी की उना दाहड़ा तक राखवावी कर सकता छे। <verse eid="2TI 1:12" /><verse number="13" style="v" sid="2TI 1:13" />जो सची वात तु ने मखे छे सोमवी छे उनको ओको विश्वास आरू मोंग क साथे जो मसीह ईशु मा छे, आपसी विजुत बनावीन राख। <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />आरू चुखलो आत्मा क द्वारा जो हामु मा बस्यो हुयो छे, इनीये वारली धरोहर की राखवावी कर।<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />तु जानता छे कि आसियावाळा सब मखे छे पछु गया छे, जिनमा फूगिलुस आरू हिरमुगिनेस छे। <verse eid="2TI 1:15" /><verse number="16" style="v" sid="2TI 1:16" />उनेसिफुरूस क घराने पर पोरबु दया करे काहकि त्यो घोणा बार मारा जीव क ठंडो कर्‍यो आरू मारी साकव छे लज्जित नी हुयो। <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />पर जव वो रोम मा आश, तो मोटो यत्न छे हेरीन मखे छे भेंट करी। <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />पोरबु करे कि उना दाहड़ाम ओको पर पोरबु की दया होय आरू जो जो सेवा त्यो इफिसुस मा की छे तीनुक तु भली भाति जानता छे।<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s">मसीह ईशु क स्वमिभक्त सैनिक</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />एरकरीन हे मारा पोर्‍या, तु ओको फोकटन दया छे जो मसीह ईशु मा छे, बलवन्त होय जाय। <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />आरू जी वात तु ने घोणा छे गवा क सामने मखे छे सोमवी छे, तीनुक विश्वास मानुस क आपी देय; जो दिसरा क भी सिकाड़ने क योग्य होय।<verse eid="2TI 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3" />मसीह ईशु क वारला योध्दा क समान मारे साथे दुःख उठ्यो। <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />जव काही योध्दा लड़ाई पर जाता छे, तो अतरान करीन कि आपने भरती करनेवावा क खुश करे, आपने आप क संसार क काम मा नी फंसाता। <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />पछु अखाड़ा मा लड़ायनेवावा यदि विधि क लारे नी लड़ाये तो मुकूट नी देखता। <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />जो किरसान मेहनत करता छे, फोव क अंश पेहल ओको मिवने जूवे। <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />जो हाव कयता छे ओको पर ध्यान देय, आरू पोरबु तुखे सब वात की समझ देसे।<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />ईशु मसीह क स्मरण राख, जो दाऊद क वंश छे हुयो आरू मरला होया मा छे जीव उठ्यो, आरू यो मारो खुश खबर क लारे छे। <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />जिदरे करता हाव खराब क समान दुःख झेल छे, याहा तक कि कैद नी; पुन यहोवा–भगवान क वचन कैद भी नी। <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />इनान करीन हाव त्योन्या होया मानसे क करता सब काही सहता छे, कि वो भी ओको उध्दार क जो मसीह ईशु मा छे अमरकाय महिमा क साथे देख्या।<verse eid="2TI 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="2TI 2:11" />यी वात सची छे,</para>
  <para style="q2" vid="2TI 2:11">कि यदि हामु ओका साथे मर गया छे,</para>
  <para style="q1" vid="2TI 2:11">तो ओको साथे जीवसु भी।<verse eid="2TI 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:12 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:33">मत्ती 10:33</ref>; <ref loc="LUK 12:9">लूका 12:9</ref></char>
    </note>तव हामु धीरज छे सहता रोवसु,</para>
  <para style="q2" vid="2TI 2:12">तो ओको साथे राज भी करसु;</para>
  <para style="q1" vid="2TI 2:12">जेतार हामु ओका मना करसु,</para>
  <para style="q2" vid="2TI 2:12">तो वो भी आमरो मना करसे।<verse eid="2TI 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13" />जेतार हामु विनभुरसीया भी होय,</para>
  <para style="q2" vid="2TI 2:13">तौभी वो विश्वासयोग्य बन रयतो छे,</para>
  <para style="q1" vid="2TI 2:13">काहकि वो आप आपसा मना नी कर सकतो।<verse eid="2TI 2:13" /></para>
  <para style="s">वारू कारीगर</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />इन वात की याद तीनुक दिला आरू पोरबु क सामने चिंता देय कि ओवाज पर सोच–विचार नी कर्‍या करे, जिनु छे काही लाभ नी हुयसे वरना सोमवनेवावा नाश होय जाय। <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />आपने आप क यहोवा–भगवान क मान्ययोग्य आरू ओसो काम करनेवावा ठराय क कोशिष कर, जो लज्जित हुयने नी देखे, आरू जो सच्चाई क वचन क ठीक रीति छे काम मा लावता होय। <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />पर विटळ बकवाद छे वाच रया, काहकि ओसा मानसे आरू भी ढोंगी भक्ति मा बढ़ता जाय। <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />आरू जिन्दरो वचन सड़े घाव की तरह पसरती जाछे। हुमिनयुस आरू फिलेतुस तीनु मा छे। <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />जो यो कयीन कि पुनरूत्थान होय चुक्या छे सच्चाई सी भटक गया छे, आरू कोतरा क भुरसा क उलटो पालटो कर देता छे। <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />तव भी यहोवा–भगवान की पाक्‍की नींव बनी रयती छे, आरू ओको पर यो छाप लागी छे: “पोरबु आपनो क उवखता छे” आरू काही पोरबु क नाव लेता छे, वो अन्याय छे वाच रया।<verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />मोटा घर मा नी केवल सोनो चाँदी ही क, पर लाकड़ान आरू धरती क ठाहरू भी होयतो छे; काही काही विजुत, आरू काही काही विजुत क करता। <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />कदाम कोय आपसा क इनु सी चुखो करसे, तो त्यो विजुत क ठाहरा बनसे; आरू मालिक क काम मा आवसे आरू आखा वारला काम क करता तियार रयसे। <verse eid="2TI 2:21" /><verse number="22" style="v" sid="2TI 2:22" />जुवानी की लालोच छे भाग, आरू चुखलो मन छे पोरबु क नाव लेता छे तींदरा साथे न्यायपन, आरू विश्वास, आरू मोंग आरू मेलमिलाप क पछव पोड़ू। <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />पुन मुर्खता आरू गलत क विवादो छे दुर रोव, काहकि तु जानता छे कि इनु सी झगड़ु पैदा होयतो छे। <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />पोरबु क दास क झगड़ावु नी होयनो जूवे, पर वो सब क साथे कमर आरू शिक्षा मा निपुन आरू सहनशील होय। <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />वो विरोध क नम्रता छे समझायो, काय जाने यहोवा–भगवान तीनुक मन फिराव क मन देय कि वो भी सच्चाई क जनो। <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />आरू ऐरा द्वारा ओकी मरजी पूरी करने क करता सचेत हईन शैतान क फंदाम छे छूट जाछे।<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s">आखरी दाहड़ा मा अन्याय</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />पुन यो फोम राख कि आखरी दाहड़ा मा वातड़ो टेहाव आवसे। <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />काहकि मानुस स्वार्थी, धन को लालची, डीगमार, डाहवाळा, निन्दा, माय बास की हुकुम टावनेवाव, विटुळ। <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />मोंग नी करनेवावा, माफ नी करनेवावा, दोष लागाड़ने वावा, कुमनीयो वातड़ो, भले क दुस्मन। <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />विश्वासघाती, एक हेट्यो, डाहवाळा, आरू यहोवा–भगवान को मोंग नी वरना सुखवास ही क जूवनेवावा होछे। <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />वो भक्ति क ढोग तो करसे, पर ओकी शक्ति क नी मानछे; ओसो छे पोरा रोवनो। <verse eid="2TI 3:5" /><verse number="6" style="v" sid="2TI 3:6" />इन्ही मा छे वो मानसे छे जो घर मा डाबाय पाय आवता छे, आरू तीनुक कमजोर बायर क वश मा कर लेता छे जो पाप छे डाबाय आरू हर प्रकार की लालोच क वश मा छे। <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />आरू सदा सीखती तो रयती छे पर सचाय निजाने। <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />जोसो यन्नेस आरू यम्ब्रेस ने मूसा क विरोध कर्‍यो होतो, वोसो ही यो भी सही क विरोध करता छे; यो ओसो मानुस छे, जिन्दरी बुध्दि भ्रष्ट होय गयी छे आरू वो सच्चाईन बारा मा बिगड़ी ज्या। <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />पुन वो इन्दरे ओगव नी बढ़ सकता, काहकि जोसो इन्दरी विनअकल सब मानसे पर प्रगट होय गयी होती, वोसो ही इन्दरे भी होय जाछे।<verse eid="2TI 3:9" /></para>
  <para style="s">तीमुथियुस क विशेष निर्देष</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />काहकि तु ने शिक्षा, चाल–चालन, मनसा, विश्वास, सहनशीलता, मोंग, धीरज, आरू सताय जाने, आरू दुःख उठावने मा मारो साथ दिदा। <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" /><note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="ACT 13:14-52">प्रेरितन 13:14-52</ref> </char><char style="xt" closed="false"><ref loc="ACT 14:1-7">प्रेरितन 14:1-7</ref>; </char><char style="xt" closed="false"><ref loc="ACT 14:8-20">प्रेरितन 14:8-20</ref></char></note>आरू ओसो दुःख मा भी जो अन्ताकिया आरू इकुनियुम आरू लुस्त्रा मा मखे पर पड्यो होतो, आरू दिसरा दुःख मा भी जो हाव झेलीयो छे; काहकि पोरबु ने मखे तीनू सब छे छुड़वी लेदु। <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />पुन जोतरा मसीह ईशु मा भक्ति क साथे जीवन देखड्या जूवता छे चे आखा सताया जाछे। <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />काहकि दुष्ट आरू भड़कावने वावु धोखा देता होया आरू धोखा खाता होया, बिगड़ता चाली जाछे। <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />पुन तु तिनी वात पर जो तु ने सीखी छे आरू विश्वास कर्‍या छे, यो जानीन वातड़ा बन रया कि तु ने तीनुक किन मानछे छे सीख्यो छे। <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />आरू बचपन छे चुखलो शास्त्र तारो जानो हुयो छे, जो तुखे मसीह पर विश्वास करने छे उध्दार हासिल करने क करता बुध्दिमान बन सकता छे। <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />सम्पूर्ण चुखलो शास्त्र यहोवा–भगवान की अगवायन लारे रची गयी छे आरू शिक्षा, आरू समझने, आरू सुधारने, न्यायपन की शिक्षा क करता लाभदायक छे। <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />ताकि यहोवा–भगवान क जन सिध्द बन, आरू हर एक वारला काम क करता तत्पर होय जाय।<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />यहोवा–भगवान आरू मसीह ईशु क गवा करीन, जो जीवतान आरू मरला होया क न्याय करसे, आरू ओको प्रगट हुयने आरू राज की देवाड़ी हाव तुखे हुकुम देता छे। <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />कि तु वचन क खबर कर, टेहाव आरू असमय तीयार रया, सब प्रकार की सहनशील आरू शिक्षान साथ मा सुधार करीन आरू लड़िया आरू समझाड़। <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />काहकि ओसो टेहाव आवसे जव मानसे सचा शिक्षा नी सह सकछे, पुन कान्टा की खुजलीन कारण आपसी लालोच क लारे आपने करता घोणा छे शिक्षा देने वाळा एखठा कर लेछे। <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />आरू आपसा कान्टा सच्चाई छे पुगीन कथा काहनी पर लागाड़ छे। <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />पुन तु सब वात मा सावधान रया, दुःख उठाड़, खुश खबर खबरन क काम कर, आरू आपसी सेवा क पूरी कर।<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />काहकि हिमी हाव पानी रेड़ाये तसो हुयतो जाय रीयो, आरू म्हारो जानेन टेम आय गयलो छे। <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />हाव वारली कुश्ती लड़ त्योक्यो छे, हाव ने आपसी दौड़ पूरी कर लेदी छे, हाव ने विश्वास की राखवावी करी छे। <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />भविष्य मा मारे करता न्यायी क वो मुकूट राख्यो होया छे, जीनाक पोरबु जो धरमी आरू न्यायी छे, मखे उना दाहड़ा आपसे, आरू मखे ही नी वरना उन सब क भी जो ओका प्रगट हुयने क मोंगावु जानता छे।<verse eid="2TI 4:8" /></para>
  <para style="s">व्यक्तिगत संदेश</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />मारे साथे छाटोत आवने क कोशिष कर। <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" /><note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="COL 4:14">कुलुस्सियो 4:14</ref>; <ref loc="PHM 1:24">फिलेमोन 1:24</ref>; </char><char style="xt" closed="false"><ref loc="2CO 8:23">2 कुरन्थियो 8:23</ref>; <ref loc="GAL 2:3">गलातिया 2:3</ref>; <ref loc="TIT 1:4">तितुस 1:4</ref></char></note>काहकि देमास ने इनीये संसार क मोंगावु जानीन मखे छुड़ दिदा छे आरू थिस्सलुनीके क चाली गयो छे। क्रेसकेंस गलातिया क आरू तीतुस दलमतिया क चाली गयो छे। <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" /><note caller="+" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="COL 4:14">कुलुस्सियो 4:14</ref>; <ref loc="PHM 1:24">फिलेमोन 1:24</ref>; </char><char style="xt" closed="false"><ref loc="ACT 12:12">प्रेरितन 12:12</ref>,<ref loc="ACT 12:25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref>; <ref loc="COL 4:10">कुलुस्सियो 4:10</ref>; <ref loc="PHM 1:24">फिलेमोन 1:24</ref></char></note>केवल लूका मारे साथे छे। मरकुस क लीन चालीन आव; काहकि सेवा क करता वो मारो घोणा काम क छे। <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" /><note caller="+" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ACT 20:4">प्रेरितन 20:4</ref>; <ref loc="EPH 6:21">इफिसियो 6:21</ref>,<ref loc="EPH 6:22">22</ref>; <ref loc="COL 4:7">कुलुस्सियो 4:7</ref>,<ref loc="COL 4:8">8</ref></char></note>तुखिकुस क हाव ने इफिसुस मुकल्या छे। <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" /><note caller="+" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="ACT 20:6">प्रेरितन 20:6</ref></char></note>जो बागा हाव त्रोआस मा करपुस क याहा छुड़ आश छे, जव आश तो ओको आरू किताब विशेष करीन चर्मपत्रो क लेता आवु। <figure style="fig" alt="Scrolls standing by ink well" file="hk00153c।tif" size="col" copy="Horace Knowles ©" ref="4:13">साय करीन वारू लिखलो गुंडावलो पत्री</figure><verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:14 </char>
      <char style="xt" closed="false">
        <ref loc="1TI 1:20">1 तीमुथियुस 1:20</ref> </char>
      <char style="xt" closed="false">
        <ref loc="ROM 2:6">रोमियो 2:6</ref>
      </char>
    </note>अलेक्जेन्द्रिया ठठेरे ने मखे छे घोणा बुराइयां करी छे; पोरबु ओको तेरे कामन लारे बदल आपसे। <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />तु भी ओका सी सावधान रया, काहकि त्यो हामरी वात क घोणा ही विरोध कर्‍या छे।<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />मारे पेहल जवाब क टेहाव काही ने भी मारो साथ नी दिदा, वरना सब ने मखे छुड़ दिदा हुता। भलो होय कि ऐरा तीदरा लेखो देनो नी पड़े! <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />पुन पोरबु मारो सहायक रया आरू मखे शक्ति देदी, ताकि मारे द्वारा पूरा पूरा खबर होय आरू सब गैरयहुदी सोमवी ले। हाव नाहरन मुय छे छुड़ दिदा। <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />आरू पोरबु हर एक बुरो काम छे छुड़वसे, आरू आपसा सोरगदूतीय राज मा सोरक्षित पुच जाछे। ओकी की महिमा युगानयुग होयती रोवे। आमेन।<verse eid="2TI 4:18" /></para>
  <para style="s">आखरी नमस्कार</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:19 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:2">प्रेरितन 18:2</ref> </char>
      <char style="xt" closed="false">
        <ref loc="2TI 1:16">2 तीमुथियुस 1:16</ref>,<ref loc="2TI 1:17">17</ref></char>
    </note>प्रिस्किल्ला आरू अक्विला क आरू उनेसिफुरूस क घराना क नमस्कार। <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" /><note caller="+" style="x"><char style="xo" closed="false">4:20 </char><char style="xt" closed="false"><ref loc="ACT 19:22">प्रेरितन 19:22</ref>; <ref loc="ROM 16:23">रोमियो 16:23</ref>; </char><char style="xt" closed="false"><ref loc="ACT 20:4">प्रेरितन 20:4</ref>; <ref loc="ACT 21:29">21:29</ref></char></note>इरास्तुसन कुरिन्थस मा रया गया,</para>
  <para style="p" vid="2TI 4:20">आरू त्रफिमुस क हाव ने मीलेतुस मा बीमार छुड़िया छे। <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />जाड़े छे पेहल चालीन आवने क कोशिष कर। यूबुस, आरू पूदेंस, आरू लीनुस आरू क्लौदिया, आरू सब भाईस आरू बहनीस तुखे नमस्कार।<verse eid="2TI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />पोरबु तारी आत्मा क साथे रवे।</para>
  <para style="p" vid="2TI 4:22">तुमू पर यहोवा–भगवान फोकटन दया हयतो रवे।<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>