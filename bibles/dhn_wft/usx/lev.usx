<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LEV" style="id">- Dhankavi</book>
  <para style="h">लैव्यव्यवस्था</para>
  <para style="toc3">लैव्यव्यवस्था नी किताब</para>
  <para style="toc2">लैव्यव्यवस्था नी किताब</para>
  <para style="toc1">लैव्यव्यवस्था नी किताब</para>
  <para style="mt2">लैव्यव्यवस्था की किताब</para>
  <para style="mt1">लैव्यव्यवस्था नी किताब</para>
  <para style="imt">पुरावो</para>
  <para style="ip">लैव्यव्यवस्था न किताब उना कानून सी बनली छे जिनीक परमेश्वर मूसा न लारे इस्राएलीया न क आपलो हुतो। याँ कानून बलिदान चढ़ावने आरू मिलाप वाळा तम्बू मा पूजा न नियम ठायको करने सी जुड़ायलो छे। लैव्यव्यवस्था न मतलब छे लैविया सी जुड़ली जो इस्राएल न त्यो गोत्र जिनाक परमेश्वर पुजारा बनने आरू मंदिर न देख भाळ करने करीन नेवाड़लो हुतो। रीतिभातिन रूप सी अकोल वाळा न माननो छे कि लैव्यव्यवस्था न किताब, आरू पांच ग्रंथन दिसरी किताबीया (उत्पत्ति, निर्गमन, गिनती आरू व्यवस्थाविवरण) मूसा कागळीयान लारे लिखी हुती। असो मालम पड़े कि यो ग्रंत बी इनी वात क सार देखाड़े, काहकी <char style="xt"><ref loc="LEV 1:1">लैव्यव्यवस्था 1:1</ref></char> मा लिकलो छे कि परमेश्वर यी वात मूसा सी कयलो हुतो। काहय गिनवानोन यो बी माननो छे कि यी किताब वेगला वारान लिखला चापड़ा सी हुयीन 5 वी या 6 वी शताब्दी ईशू मसीह आनेन पेहले बाबुल मा तियार हुयली हुती।</para>
  <para style="ip">लैव्यव्यवस्था न किताब मा हामू भणजे कि परमेश्वर पुजारान क काहय भाँतिन बलिदान चहढ़ावनेन हुकुम आपीयो।इनु मायीन काहय बलिदान लोगहन क पापन करता चहढ़ावता हुता। दिसरो बलिदान मरजी सी, काहलो मनुसन परमेश्वरन करता चहढ़ाय सकता हुता। हर हालोत मा यो छाको हुतो कि भेंट चुखी आरू आरगो हुयनो जुळे, कि त्यो मनुसन तरफ सी वारू सी वारू हय। यो उजेन्‍तो परमेश्वरन चुखापन क देखाड़तो हुतो। किताबन आखरी भाग मा यो समझाड़ मेलोयो, कि इस्राएली आरू पुजारा कसा चुखा रय सके या कसा विटुळ सी चुखा हुय सके। इनी किताबन खास वात यी छे कि परमेश्वर चुखलो छे, आरू इनी किताब मा आपला सारा नियमन पाळन करीन एस्राएली परमेशवरन हजुवरी मा रय सकता हुता।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. लग अलग बलिदान चढ़ावनेन नियमन हुकूम आपलो छे। <char style="ior"><ref loc="LEV 1-7">1–7</ref> </char></para>
  <para style="io1">2. हारून आरू हेका पोर्यान क ठानुक आपनेन पुरावो छे। <char style="ior"><ref loc="LEV 8-10">8–10</ref></char></para>
  <para style="io1">3. चुखलो आरू विटुळ खानान आरू बिमारियान वारा मा नियम आपलो छे। <char style="ior"><ref loc="LEV 11-16">11–16</ref> </char></para>
  <para style="io1">4. खानो, तिहवार वारू आव भाव आरू आरामन सालोन वारा मा अलग अलग हुकूम देखाड़ छान्‍डियो। <char style="ior"><ref loc="LEV 17-27">17–27</ref></char></para>
  <chapter number="1" style="c" sid="LEV 1" />
  <para style="s">होम बलि न नियम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 1:1" />योहोवा न मूसा क मिलाप वाळा तम्बू मा सी बुलावीन हेका सी कयो, <verse eid="LEV 1:1" /><verse number="2" style="v" sid="LEV 1:2" />इसराएलीयो सी कय कि कदाम तुमरे मा सी कोय मनुस यहोवा क लियन पशुन चढ़ावो चढ़ावे, ती पाळनिया पशु गाडरा- बुकड़ा माईन एक हुयनो जुवे। <verse eid="LEV 1:2" /><verse number="3" style="v" sid="LEV 1:3" />कदाम त्यो पाळनीया पशु मा सी होमबली करे, ती ओका मा काहय बी पाप नी हय उको मिलाप वाळा तम्बून झपला पर चढ़ावे कि योहोवा हेको मान लेय।<verse eid="LEV 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 1:4" />त्यो आपसा हाथ को होमबलि क पशुन मूनका पर मेले, आरू त्यो हेका लियन पछतावो करने करीन मान लेसे। <verse eid="LEV 1:4" /><verse number="5" style="v" sid="LEV 1:5" />तव त्यो उना केवड़िया को योहोवा भगवान क सामने बलि करे; आरू हारून क पोर्या जो पुजारो छे त्या लुहूय को साते ली जाईन उनी वेदी न च्यारो मेर छिड़क देय जो मिलाप वाळा तम्बून झपला पर छे। <verse eid="LEV 1:5" /><verse number="6" style="v" sid="LEV 1:6" />ओळते त्यो खाल निकाळीन उना पशुन टुकड़ा-टुकड़ा करे; <verse eid="LEV 1:6" /><verse number="7" style="v" sid="LEV 1:7" />तव हारून पुजारान वेदी पर आग्ठी मेले, आरू आग्ठा पर लाकड़ा जावीन मेले; <verse eid="LEV 1:7" /><verse number="8" style="v" sid="LEV 1:8" />आरू हारून क पोर्या जो पुजारा छे त्या मूनका आरू चरबी क सात मा पशुन टुकड़ा क उनी लाकड़ी पर वेदीन आग्ठी पर हसे उको सजावीन मेले; <verse eid="LEV 1:8" /><verse number="9" style="v" sid="LEV 1:9" />आरू त्यो ओका आतड़ा आरू पाय को पानी सी धुवे। तव पुजारो सब को वेदी पर धपाड़ देय कि त्यो होमबलि योहोवा भगवान क लियन वारू गंधायने वाळो बलिदान बने। <verse eid="LEV 1:9" /><verse number="10" style="v" sid="LEV 1:10" />कदाम त्यो गाडरो या बुकड़ान होमबलि चढ़ावे, त्यो पूरो आरेगलो नर पशु हय उको चढ़ावे। <verse eid="LEV 1:10" /><verse number="11" style="v" sid="LEV 1:11" />आरू त्यो उको योहोवा न ओगळ वेदी पर उत्तर न तरफ बलि करे; आरू हारून क पोर्या जो पुजारा छे पशु क लुहूय को वेदीन चारो मेर छिड़की देय। <verse eid="LEV 1:11" /><verse number="12" style="v" sid="LEV 1:12" />आरू त्यो मूनका आरू चरबी क सात मा ओका टुकड़ा-टुकड़ा करे, आरू पुजारो ईनु आखान क उनी लाकड़ी पर सजावीन मेले जो वेदी रहवसे; <verse eid="LEV 1:12" /><verse number="13" style="v" sid="LEV 1:13" />त्यो ओका आतड़ा आरू पाय को पानी सी धुवे। आरू पुजारो वेदी पर धपाड़े कि‍ त्यो होमबलि हुय जाय आरू योहोवा भगवान जुगु गंधायने वाळो बलिदान बने। <verse eid="LEV 1:13" /><verse number="14" style="v" sid="LEV 1:14" />“कदाम त्यो यहोवा क लियन चिल्लान होमबलि चढ़ावे, ती हुली नीते पेरवान क चढ़ावो चढ़ावे। <verse eid="LEV 1:14" /><verse number="15" style="v" sid="LEV 1:15" />पुजारो ओको वेदी क साते ली जाईन हेका गळा क मुयड़ीन मूनको धड़ सी अलग करे, आरू वेदी पर धपाड़े; आरू उका सारा लुहूय को उनी वेदी क धड़े पाड़ देय; <verse eid="LEV 1:15" /><verse number="16" style="v" sid="LEV 1:16" />आरू त्यो ओकी गळान थयली को पाखड़न क सात निकाळीन वेदी क पूरबन तरप रुखड़ो न्हाकनेन जागा पर न्हाक देय; <verse eid="LEV 1:16" /><verse number="17" style="v" sid="LEV 1:17" />आरू त्यो ओका पाखड़ान वीच मा सी फाड़ देय, पुन अलग-अलग नी करे। तव पुजारो उको वेदी पर उनी लाकड़ीन उपर मेलीन जो आग्ठा पर हसे उको धपाड़े कि‍ त्यो होमबलि आरू यहोवा क लियन गंधायने वाळो बलिदान बने।<verse eid="LEV 1:17" /></para>
  <chapter eid="LEV 1" />
  <chapter number="2" style="c" sid="LEV 2" />
  <para style="s">अनाज भेंट कि विधि</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 2:1" />“जव कोय यहोवान करता अन्नबलि क चढ़ावो चढ़ावने चाहे, त्या मैदा चढ़ावे; आरू हेका पर तेल न्‍हाखीन हेके उपर लोबान राखे <verse eid="LEV 2:1" /><verse number="2" style="v" sid="LEV 2:2" />आरू चा उकान हारून क पोर्‍या क जु याजक छे, लावे। आरू चा अनाज भेंटन तेल भेसकलो मैदा मा सी ओका गत आपनी भरीन निकाळे कि सब लोबान उकामा आय जाय; आरू याजक हेको फोम आपने वाळा भाग क करता वेदी पर धोपाड़्या कि या योहोवा क करता सुखदायक सुगन्धित भेंट हुयसे। <verse eid="LEV 2:2" /><verse number="3" style="v" sid="LEV 2:3" />आरू अनाज भेंट मा सी जो वाचला रवे चा हारून आरू उकान पोर्‍या क ठरसे; या योहोवा क भेंट मा सी घण चुखो वाटो छे।<verse eid="LEV 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 2:4" />“जव तु अन्नबलि न करता तन्दूर मा रांदलो चढ़ावु चढ़ाया, ते चा तेल सी झारली अखमीरी चांतीक होय। <verse eid="LEV 2:4" /><verse number="5" style="v" sid="LEV 2:5" />आरू कदाम तार चढ़ावु तवा पर रांदलो अन्नबलि होय, ते चो तेल करीन झारलो अखमीरी मयदान होसे; <verse eid="LEV 2:5" /><verse number="6" style="v" sid="LEV 2:6" />हेका टुकड़ा टुकड़ा करीन हेका पर तेल न्‍हाकजो, तव त्यो अनाज भेंट हुय जासे। <verse eid="LEV 2:6" /><verse number="7" style="v" sid="LEV 2:7" />आरू कदाम थारो चढ़ावो कढ़ाई मा तोवलो अनाज भेंट हय, ती त्यो मयदा सी तेल मा बनावनो जुळे। <verse eid="LEV 2:7" /><verse number="8" style="v" sid="LEV 2:8" />आरू जु अनाज भेंट ओका चीज मा सी काहनी होय उका योहोवा क सामने ली जानु; आरू जव चु याजक क जु लाया जासे, तव याजक उका वेदी क सामने ली जाय। <verse eid="LEV 2:8" /><verse number="9" style="v" sid="LEV 2:9" />आरू याजक अनाज भेंट मा रयी फोम करावने वाळो भाग निकाळीन वेदी पर धोपाड़े की त्यो योहोवान करता सुखदायक सुगन्धवाळो भेंट ठरसे; <verse eid="LEV 2:9" /><verse number="10" style="v" sid="LEV 2:10" />आरू अन्नबलि मा सी जो वाचलो रवे चो हारून आरू उकान पोर्‍यो न ठरसे; चो योहोवा क भेंट मा घण चुखु वाटु हुयसे।<verse eid="LEV 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 2:11" />“काहलो अनाज भेट जेको तुमु यहोवान करता चढ़ावु, खमीर भेस्किन झुण बनावता; तुमु कदी आग्ठान भेंट मा यहोवान करता, खमीर आरू माहळ झुण धोपाड़जु। <verse eid="LEV 2:11" /><verse number="12" style="v" sid="LEV 2:12" />तुमु हेको पेहली फसलन चढ़ावु करीन यहोवान करता चढ़ावा, पर चा सुखदायक सुगन्ध क करता वेदीन आग्ठी पर झुन चढ़ावु। <verse eid="LEV 2:12" /><verse number="13" style="v" sid="LEV 2:13" />पछा आपना सब अनाजन भेंट क नमकीन बनावनु; आरू आपना कुई अनाजन भेंट आपना परमेश्वरन साथ मा बाँधली वाचा क नोन सी रहित होयने नी देनु; आपना सब चढ़ावा साथे नोन भी चढ़ावनु।<verse eid="LEV 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 2:14" />“कदाम तु योहोवा क करता पेहली फसलन अनाजन भेट चढ़ावु, ते आपनी पेहली कमायन अनाजन करता आग्ठा मा भुंजली निळ्ळी-निळ्ळी उम्बीया , मतलब निळ्ळी-निळ्ळी उम्बीयाक मसळीन निकाळ लेनु, तव अनाज भेंट चढ़ावनु। <verse eid="LEV 2:14" /><verse number="15" style="v" sid="LEV 2:15" />आरू उका मा तेल नाखनु, आरू उकान उपर लोबान राखनु; तव चा अनाज भेंट हुय जासे। <verse eid="LEV 2:15" /><verse number="16" style="v" sid="LEV 2:16" />आरू याजक मसळीन निकावलो अन्ना क, आरू तेल क, आरू सब लोबान क फोम करवानेवाळो भाग करीन धोपाड़ दे; त्यो यहोवा क करता वेदी की आग ठरसे।<verse eid="LEV 2:16" /></para>
  <chapter eid="LEV 2" />
  <chapter number="3" style="c" sid="LEV 3" />
  <para style="s">मेलमिलाप बलि न विधि</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 3:1" />“कदाम उकान चढ़ावु मेलबलि क होय, आरू कदाम चा केवड़ी-बुयल मा सी काहना क चढ़ावे, चाहे चा पशु नर होय या मादा, ते जु पूरो आरगो हय हेकेक त्यो यहोवान अगोळ चढ़ावे। <verse eid="LEV 3:1" /><verse number="2" style="v" sid="LEV 3:2" />आरू चा आपसो हाथ आपसा चढ़ावान करता पशु न मुनका पर मेले आरू हेको मिलापवाळा तम्बून झपला पर बलि करे; आरू हारून क पोर्‍यो जो पुजारो छे त्यो हेको लुहूय क वेदीन च्यारू मेर छिड़के। <verse eid="LEV 3:2" /><verse number="3" style="v" sid="LEV 3:3" />आरू त्यो मेलमिलापन बलि मा रयीन यहोवान करता वेदी की आग्ठी मा चढ़ावे, मतलब जीनी चरबी सी आतड़ा ढाकयला रये, आरू जो झाळ हेना मा लेपटाय रये ची भी, <verse eid="LEV 3:3" /><verse number="4" style="v" sid="LEV 3:4" />आरू दुयु गुर्दा आरू हेके उपर वाळी चरबी जो कमर क जु रवती छे, आरू गुर्दान क सात मा काळजा न उपर झाळी, इनु सबन क त्यो अलग करे। <verse eid="LEV 3:4" /><verse number="5" style="v" sid="LEV 3:5" />तव हारून क पोर्यो हेनको वेदी पर होमबलि पर धोपाड़े, जो हेनू लाकड़ा पर हसे जो आग्ठान उपर छे कि यो यहोवान करता सुखदायक सुगन्धवाळा भेट रयसे।<verse eid="LEV 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 3:6" />“कदाम यहोवा न मेलमिलाप न बलिन करता हेको चढ़ावो पालतु पशु मा सी होय, ते चाहे त्यो नर हय या मादा, पर जो पूरा डिलोम आरगो हय हेको चढ़ावे। <verse eid="LEV 3:6" /><verse number="7" style="v" sid="LEV 3:7" />कदाम त्यो गाडरान पीलो चढ़ावतो हय, ती हेको यहोवान क सामने चढ़ावे, <verse eid="LEV 3:7" /><verse number="8" style="v" sid="LEV 3:8" />आरू चा आपनु चढ़ावान पशु न मुनका पर हाथ मेके आरू हेको मिलापवाळा तम्बू न अगोळ बलि करे; आरू हारून क पोर्यो हेको लुहूय वेदीन च्यारो तरफ छिड़के। <verse eid="LEV 3:8" /><verse number="9" style="v" sid="LEV 3:9" />तब मेलबलि मा सी चरबा क योहोवा क करता हवन करे, मतलब ओकान चरबी भरली मोटली सेमटी क चा रीढ़न जुळ सी अलग करे, आरू जेकी चरबी सी आतड़्या ढ़ाकला रये, आरू जी चरबो उना मा चिपकली रवती छे, <verse eid="LEV 3:9" /><verse number="10" style="v" sid="LEV 3:10" />आरू दुयु गुर्दा, आरू जो चरबो उकान उपर कमर क जु रवती छे, आरू गुर्दा समेत कावजा क उपरली झिल्ली, इना सभा क चा अलग करे। <verse eid="LEV 3:10" /><verse number="11" style="v" sid="LEV 3:11" />आरू याजक ओका वेदी पर धोपाड़े; या योहोवा क करता भेंट रूपी भोजन ठरसे।<verse eid="LEV 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 3:12" />“कदाम चा बुकड़ी चढ़ावे ती हेको योहोवा क सामने चढ़ाया। <verse eid="LEV 3:12" /><verse number="13" style="v" sid="LEV 3:13" />आरू चा आपना हाथ उकान मुनका पर मेके, आरू उकाह मिलापवाळा तम्बू क ओगव बलि करे; आरू हारून क पोर्‍या उकान लुहूय क वेदी क चार तरफ छिड़कु। <verse eid="LEV 3:13" /><verse number="14" style="v" sid="LEV 3:14" />तव चा उकामा सी आपनो चढ़ावो योहोवा क करता वेदी की आग पर चढ़ावे, मतलब जीन चरबी सी आतड़ा ढाकायला रये छे, आरू जो चरबी हेकाम चिपकली रये त्यो भी, <verse eid="LEV 3:14" /><verse number="15" style="v" sid="LEV 3:15" />आरू दुयु गुर्दा आरू जो चरबो उकान उपर कमर क जु रवती छे, आरू गुर्दा समेत काळजान क उपर वाळी जाळी, इनु सबन क त्यो अलग करे। <verse eid="LEV 3:15" /><verse number="16" style="v" sid="LEV 3:16" />आरू याजक ओका वेदी पर धोपाड़्या; यो हवन रूपी भोजन छे जो सुखदायक सुगन्ध क करता हतलो छे; काहकी सब चरबी यहोवान छे। <verse eid="LEV 3:16" /><verse number="17" style="v" sid="LEV 3:17" />यो तुमरी रयने जागा मा तुमरी पीढ़ी पीढ़ी क करता हमेशान विधि रयसे कि तुमु चरबी आरू लुहूय कदी नी खावु।”<verse eid="LEV 3:17" /></para>
  <chapter eid="LEV 3" />
  <chapter number="4" style="c" sid="LEV 4" />
  <para style="s">पापबलि न नियम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 4:1" />पछो यहोवा न मूसा सी कयो, <verse eid="LEV 4:1" /><verse number="2" style="v" sid="LEV 4:2" />इस्राएलिया सी यो कोय कि कदाम कोय मनुस उना कामो मा सी जीनाक यहोवा मना करलो छे, काहना काम क विसरीन करीन पापी होय जाए; <verse eid="LEV 4:2" /><verse number="3" style="v" sid="LEV 4:3" />आरू कदाम अभिषिक्त याजक ओसो पाप करे जेका सी प्रजा दोषी ठरसे, ते आपना पापन कारण चु एक पूरो आरेगलो बयल्यो योहोवा क पापबलि करीन चढ़ाया। <verse eid="LEV 4:3" /><verse number="4" style="v" sid="LEV 4:4" />त्यो उना बयल्यान क मिलापवाळा तम्बू न झोपला पर योहोवा क ओगव ली जाईन उकान मुनका पर हाथ मेके, आरू उका बयल्यान क योहोवा क सामने बलि करे। <verse eid="LEV 4:4" /><verse number="5" style="v" sid="LEV 4:5" />आ रू अभिषिक्त पुजारो बयलशयान क लुहूय मा सी काहय लीन मिलापवाळा तम्बू मा ली जाय; <verse eid="LEV 4:5" /><verse number="6" style="v" sid="LEV 4:6" />आरू पुजारो आपसी आंगळी लुहू मा डुबाड़ी-डुबाड़ीन आरू हेकामा सी काहय लीन चुखला जागान वीच माहयला परदान क ओगळ यहोवान सामने सात वार छिड़के। <verse eid="LEV 4:6" /><verse number="7" style="v" sid="LEV 4:7" />आरू पुजारो हेका लुहूय मा सी लीन वारू गंधायने वाळा धुपन वेदीन क सिंगड़ा पर जो मिलापवाळा तम्बू मा छे यहोवान क सामने लगाड़े; ओळी बयल्यान क सब लुहूय वेदीन क पाया पर जो मिलापवाळा तम्बून झपला पर छे रेड़ देय। <verse eid="LEV 4:7" /><verse number="8" style="v" sid="LEV 4:8" />पछु चु पापबलि क बयल्यान क सब चरबी हेका सी अलग करे, आरू जीनी चरबी सी आतड़ा ढाकायला रवता छे, आरू जोतरो चरबो उना मा चिपकली रवती छे, <verse eid="LEV 4:8" /><verse number="9" style="v" sid="LEV 4:9" />आरू दुयु गुर्दा आरू उना क उपर क चरबो जो कमर क जु रवती छे, आरू गुर्दा समेत कावजा ऊपर ली जाळी, इना सभा क अलग करे, <verse eid="LEV 4:9" /><verse number="10" style="v" sid="LEV 4:10" />जोसो मेलमिलापन बलिवाळा चढ़ावा क बयल्या सी अलग कर्‍या जाता छे, आरू याजक इनुक होमबलि कर्‍या वेदी पर धोपाड़ीयो। <verse eid="LEV 4:10" /><verse number="11" style="v" sid="LEV 4:11" />पुन उना केवड़ा क खाल, पाये, मुनको, आतड़ा, गुबर, <verse eid="LEV 4:11" /><verse number="12" style="v" sid="LEV 4:12" />आरू सब मांस, मतलब पूरो बयल्यो पड़ाव सी बाहरते चुखला जागा मा, जा रूखड़ो नाखे, ली जाईन लाकड़ा पर मेलीन आग्ठा सी धोपाड़़े; जा रूखड़ो न्‍हाखे तेखे व्हा धपाड़े। <verse eid="LEV 4:12" /><verse number="13" style="v" sid="LEV 4:13" />“कदाम इस्राएल क सब मण्डली अज्ञानतान कारण पाप करे आरू ची वात मण्डली क डुवा सी धोपाय छे, आरू चा योहोवा क काहनी हुकुम क विरूध्द काहय करीन दोषी ठर्‍या छे; <verse eid="LEV 4:13" /><verse number="14" style="v" sid="LEV 4:14" />ते जव उकान करीन पाप प्रगट होय जाय तव मण्डली एक केवड़ा क पापबलि करीन चढ़ाया। चा उका मिलापवाळा तम्बू क ओगव ली जाय, <verse eid="LEV 4:14" /><verse number="15" style="v" sid="LEV 4:15" />आरू मण्डळीन डाहला लोगहन आपना आपना हाथ क योहोवा भगवान क ओगळ बयल्या क मुनका पर मेके, आरू चो बयल्या क योहोवा भगवान क सामने बलि कर्‍या जासे। <verse eid="LEV 4:15" /><verse number="16" style="v" sid="LEV 4:16" />तव अभिषिक्त याजक बयल्यान ज लुहूय मा सी मिलापवाळा तम्बू मा ली जासे; <verse eid="LEV 4:16" /><verse number="17" style="v" sid="LEV 4:17" />आरू याजक आपनी आंगुळ लुहूय मा डुबाड़ीन हेका वीचमाहयला परदा क ओगव सात वार योहोवा क सामने छिड़के। <verse eid="LEV 4:17" /><verse number="18" style="v" sid="LEV 4:18" />आरू हेका लुहूय मा सी वेदीन सिंगड़ा पर जो यहोवान ओगळ मिलापवाळा तम्बू मा छे लगाड़े; आरू वाचला सब लुहूय होमबलि न वेदी क पाया पर जो मिलापवाळा तम्बू क झोपला पर छे रेड़ देय। <verse eid="LEV 4:18" /><verse number="19" style="v" sid="LEV 4:19" />आरू त्यो बयल्यान सब चरबी निकाळीन वेदी पर धपाड़ देय। <verse eid="LEV 4:19" /><verse number="20" style="v" sid="LEV 4:20" />जसो पापबलिन बयल्या सी करला हुता तसोज हेका सी भी करे; इनीये रीतिये पुजारो इस्राएलियान पाप क ढाके, तव उनाक चो पाप माप करलु जासे। <verse eid="LEV 4:20" /><verse number="21" style="v" sid="LEV 4:21" />आरू चा बयल्यान क पड़ाव सी बाहरो ली जाईन इनिये रीतिये धपाड़े जसो पेहला बयल्यान क धोपाड़यो हतो; यी मण्डलीन करता पापबलि हुयसे।<verse eid="LEV 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 4:22" />“जव कुई मुखि मानुस पाप करीन आपना परमेश्वरन योहोवा क काहनी हुकुम क विरूध्द मा विसर भूले सी काहय करीन दोषी होय जासे, <verse eid="LEV 4:22" /><verse number="23" style="v" sid="LEV 4:23" />आरू उकान पाप उका पर प्रगट होय जासे, ते वा एक निर्दोष बुकड़ो बलिदान करने क करीन ली आया; <verse eid="LEV 4:23" /><verse number="24" style="v" sid="LEV 4:24" />आरू बुकड़ा क मुनका पर आपना हाथ धरे, आरू बुकड़ा क उका जागा पर बलि करे जा होमबलि योहोवा भगवान क ओगव बलि कर्‍या जाता छे; या पापबलि ठरसे। <verse eid="LEV 4:24" /><verse number="25" style="v" sid="LEV 4:25" />तव पुजारो आपनी आंगुव सी पापबलि क लुहूय मा सी काहय लीन होमबलि क वेदी क सिंगड़ा पर लागाड़े, आरू उकान लुहूय होमबलि क वेदी क पाय पर नाख दे। <verse eid="LEV 4:25" /><verse number="26" style="v" sid="LEV 4:26" />आरू चा उकान कुल चरबा क मेलबलि क समान वेदी पर धोपाड़े; आरू याजक उकान पाप क विषय मा पश्चाताप कर, तव चु माप कर्‍यु जासे।<verse eid="LEV 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 4:27" />“कदाम साधारण लोगहन मा सी कुई विनअकल सी पाप करे, हेनू काम क जिनू सी योहोवा भगवान मना कर्‍यु हेके करे ती त्यो दोषी हुयसे, <verse eid="LEV 4:27" /><verse number="28" style="v" sid="LEV 4:28" />ते चा उका पाप क कारण एक निर्दोष बुकड़ी बलिदान क करता ली आया; <verse eid="LEV 4:28" /><verse number="29" style="v" sid="LEV 4:29" />आरू चु आपना हाथ पापबलिपशु क मुनका पर मेके, आरू होमबलि क जागा पर पापबलिपशु क बलिदान करे। <verse eid="LEV 4:29" /><verse number="30" style="v" sid="LEV 4:30" />आरू याजक उकान लुहूय मा सी आपनी आंगुव सी काहय लीन होमबलि क वेदी क सींगड़ा पर लागाड़े, आरू उकान सब लुहूय क उका वेदी क पाय पर माख दे। <verse eid="LEV 4:30" /><verse number="31" style="v" sid="LEV 4:31" />आरू ची उकान सब चरबा क मेलमिलाप बलिपशुन चरबीन क सारको अलग करे, तव याजक ओका वेदी पर योहोवा क करता सुखदायक सुगन्ध क करता धोपाड़े; आरू ओका प्रकार याजक करता पश्चाताप करे, तव उका मापी जोड़से।<verse eid="LEV 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 4:32" />“कदाम चु पापबलि क करता एक गाडरीन पीलो ली आयो, ते चु पूरो आरेगलो मादा होय, <verse eid="LEV 4:32" /><verse number="33" style="v" sid="LEV 4:33" />आरू चु आपना हाथ पापबलि क मुनका पर मेके, आरू उकान पापबलि क करता चोज बलिदान करे जा होमबलिपशु बलि कर्‍या जाता छे। <verse eid="LEV 4:33" /><verse number="34" style="v" sid="LEV 4:34" />तव याजक आपनी आंगुळ सी पापबलिन लुहूय मा सी काहय लीन होमबलि क वेदी क पाय पर नाख दे। <verse eid="LEV 4:34" /><verse number="35" style="v" sid="LEV 4:35" />आरू त्यो हेकी सब चरबी क मेलबलिवाळा गाडरान पीलान चरबी समान अलग करे, आरू याजक उका वेदी पर योहोवा क हवन क ऊपर धोपाड़े; आरू ओका प्रकारन याजक उकान पाप क करता पश्चाताप करे, आरू तिनाक माप कर दे जासे।<verse eid="LEV 4:35" /></para>
  <chapter eid="LEV 4" />
  <chapter number="5" style="c" sid="LEV 5" />
  <para style="s">पापबलि क कारण</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 5:1" />“कदाम कोय गवा हुयीन सो पाप करे कि कसम खावड़ावीन पुछने पर भी कि काय तु यो समळ्यू नीते जाने, आरू ची वात उजेन्‍ती नी करे, ते ओका आपना गुणान भार झेलनो पड़से। <verse eid="LEV 5:1" /><verse number="2" style="v" sid="LEV 5:2" />कदाम कोय विटुळ चीज क भुल चुक सी हाथ लगाड़े, ते चाहे चु अशुद्ध बनैल पशु क, चाहे शुद्ध घर माहयला पशु क, चाहे अशुद्ध रेंगनेवाळा जीव-जन्तु न धड़ हय, ती त्यो विटुळ हुयीन गुणाको ठरसे। <verse eid="LEV 5:2" /><verse number="3" style="v" sid="LEV 5:3" />निते कदाम कुई मानुस काहनी अशुद्ध चीज क भुल चुक सी हाथ ले, चाहे चु अशुद्ध चीज काहनी भी प्रकार करे काह नी होय जेका सी मानसे अशुद्ध होय जाता छे, ते जव चु उका वात क जाव लेसे तव चु दोषी ठरसे। <verse eid="LEV 5:3" /><verse number="4" style="v" sid="LEV 5:4" />कदाम कुई बुरो या भलो करने क बिना सोचे समझे शपथ खादा, चाहे काहना प्रकारन वात बिना-विचारे शपथ खाईन कोया, ते ओसी वात मा चु दोषी उका टेमे ठरसे जव उका मालुम होय जासे। <verse eid="LEV 5:4" /><verse number="5" style="v" sid="LEV 5:5" />आरू जव त्यो इनी वातो मा सी काहनी भी वात मा गुणेगार हय, तव जेका विषय मा ओको पाप कर्‍या होय चु ओकाह मान ले, <verse eid="LEV 5:5" /><verse number="6" style="v" sid="LEV 5:6" />आरू चु योहोवा क सामने आपनो दोषबलि ली आया, मतलब उका पाप क कारण चा एक गाडरा या बुकड़ा पापबलि करने क करता ली आया; तव याजक उका पाप क विषय पश्चाताप करे।<verse eid="LEV 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 5:7" />“पुन कदाम उका गाडरा या बुकड़ी आपने क सामर्थ्य नी होय, ते आपना पाप क कारण दुय पण्डुक या कबूतरी क दुय पिल्ला दोषबलि चढ़ावनेन करता योहोवा क साथे ली आया, उनामा सी एक ते पापबलि क करता आरू दिसरा होमबलि क करता लावे। <verse eid="LEV 5:7" /><verse number="8" style="v" sid="LEV 5:8" />चा ओकान याजक क जु ली आया, आरू उकान मुनका गवा सी पिव्वी नाखे, पुन अलग नी करे, <verse eid="LEV 5:8" /><verse number="9" style="v" sid="LEV 5:9" />आरू चु पापबलिपशु क लुहूय मा सी वेदी क बाजु पर छिड़के, आरू जो लुहूय शेष रवे ची वेदी क पाय पर पाड्या जासे; चो पापबलि ठरसे। <verse eid="LEV 5:9" /><verse number="10" style="v" sid="LEV 5:10" />तव दिसरा चिल्ला क ची विधि क अनसारे होमबलि करे, आरू याजक ओकान पाप क पश्चाताप करे, आरू तव चा माप कर्‍या जासे।<verse eid="LEV 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 5:11" />“पुन कदाम चा दुय पण्डुक या कबूतरी क दुय पिल्ला भी नी आप सके, ते चो आपना पाप क कारण आपना चढ़ावु एपा क दसवु भाग मयदा पापबलि करीन ली आया; उका पर नी ते चा तेल नाख्या, आरू नी लोबान मेक्या, काहकी चो पापबलि होयसे। <verse eid="LEV 5:11" /><verse number="12" style="v" sid="LEV 5:12" />चु उकाह याजक क जु ली जावु, आरू याजक उकामा सी आपनी मुठ भरीन फोम आपावनेवाळा भाग जानीन वेदी पर योहोवा क हवनो क ऊपर धोपाड्या; चो पापबलि ठरसे। <verse eid="LEV 5:12" /><verse number="13" style="v" sid="LEV 5:13" />आरू इनी वात मा सी काहनी भी वात क विषय मा को कुई पाप करे, याजक ओकान पश्चाताप करे, आरू तव चु पाप माप कर्‍या जासे। आरू ओका पापबलि क शेष अन्नबलि क शेष क समान याजक क ठरसे।”<verse eid="LEV 5:13" /></para>
  <para style="s">दोषबलि क विधि</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 5:14" />पछा योहोवा मूसा सी कयो, <verse eid="LEV 5:14" /><verse number="15" style="v" sid="LEV 5:15" />कदाम कुई योहोवा क चुखी करली चीजन वारा मा गलती सी विश्वासघात करे आरू पापी ठरसे, ते चु योहोवा क जु एक निर्दोष गाडरा दोषबलि क क करता ली आया; ओकान किमत पवित्रस्थान क शेकेल<note caller="+" style="f"><char style="fr" closed="false">5:15 </char><char style="fq" closed="false">शेकेल </char><char style="ft" closed="false">12 ग्राम</char></note> क अनसारे ओतरा ज शेकेल चाँदीन होय जोतरो याजक ठरसे। <verse eid="LEV 5:15" /><verse number="16" style="v" sid="LEV 5:16" />आरू जेका चुखली चीज क विषय उको पाप कर्‍या होय, उकामा चु पाचवु भाग आरू बढ़ावीन याजक क आप; आरू याजक दोषबलि क गाडरो चढावीन उकान पाप क ढाँके, तब उकान पाप माप कर्‍या जासे। <verse eid="LEV 5:16" /><verse number="17" style="v" sid="LEV 5:17" />“कदाम कुई ओसो पाप करे के उना कामो मा सी जेका योहोवा भगवान मना कर्‍यो छे काहना काम करे, ते चाहे चु हेको आपसा गुणान भार उठावनु पड़से। <verse eid="LEV 5:17" /><verse number="18" style="v" sid="LEV 5:18" />एरकरता चु एक निर्दोष गाडरा दोषबलि करीन याजक क जु ली आया, चा ओतरीज किमत क होय जोतरा याजक ठराया, आरू याजक उकान करता ओकान ओकी भूल क जा ओकाह अनजावना मा करी होई पश्चाताप करे, आरू चु माप कर्‍यु जासे। <verse eid="LEV 5:18" /><verse number="19" style="v" sid="LEV 5:19" />यी दोषबलि ठरसे; काहकी चु मानुस पाक्को योहोवा क सम्मुख दोषी ठरसे।”<verse eid="LEV 5:19" /></para>
  <chapter eid="LEV 5" />
  <chapter number="6" style="c" sid="LEV 6" />
  <para style="p">
    <verse number="1" style="v" sid="LEV 6:1" />पछु योहोवा मूसा सी कयो, <verse eid="LEV 6:1" /><verse number="2" style="v" sid="LEV 6:2" />“कदाम कोय यहोवा सी विश्वासघात करीन पापी ठरसे, जोसो कि धरोहर, या लेनदेन, या लूट क विषय मा आपना भाईस्यक साथे कपट करे, या ओका पर आंधारो करे, <verse eid="LEV 6:2" /><verse number="3" style="v" sid="LEV 6:3" />या पड़ रयली चीज जड़े ती हेका वारा मा झूठ बुले आरू झूठी कसम बी खाय; ओसी कुई भी वात काह नी होय जेको करीन मानुस पापी ठरतु छे, <verse eid="LEV 6:3" /><verse number="4" style="v" sid="LEV 6:4" />ते जव चु ओसो काम करीन दोषी होय जाय, तव जु भी चीज ओको लुट्यो, या आंधारो करीन, या धरोहर, या खुवायली चीज जो हेको जोड़ली हय ; <verse eid="LEV 6:4" /><verse number="5" style="v" sid="LEV 6:5" />चाहे काहनी भी चीज काह नी होय जेका विषय मा उको झूठी शपथ खादली होसे; ते ची उको सब वापस कर दे, आरू पाचवु भाग भी बढ़ावीन भर दे, जेके दाहड़े यो मालुम होसे कि चु दोषी छे उके दाहड़े चु उका चीज क ओका स्वामी क वापस कर दे। <verse eid="LEV 6:5" /><verse number="6" style="v" sid="LEV 6:6" />आरू चु योहोवा क सामने आपना दोषबलि भी ली आया, मतलब एक पूरो आरेगलो गाडरा दोषबलि क करता याजक क जु ली आया, चा ओतरी किमत होय जोतरो याजक ठरावसे। <verse eid="LEV 6:6" /><verse number="7" style="v" sid="LEV 6:7" />ओका प्रकार क याजक उकान करता योहोवा क सामने पश्चाताप करे, आरू जेका काम क करीन चु दोषी होय गया छे उकाह मापी जोड़से।”<verse eid="LEV 6:7" /></para>
  <para style="s1">भाँति-भाँति न बलिदान क विधि</para>
  <para style="ms">होमबलि</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 6:8" />आरू यहोवा मूसा सी कयो, <verse eid="LEV 6:8" /><verse number="9" style="v" sid="LEV 6:9" />“हारून आरू ओकान पोर्‍या क हुकुम आपीन यो कयो कि होमबलि क व्यवस्था यी छे: होमबलि भाट्टीन ऊपर रात भर भोर तक वेदी पर पवड़ा रवे, आरू वेदी क आगठो वेदी पर धोपती रवे। <verse eid="LEV 6:9" /><verse number="10" style="v" sid="LEV 6:10" />आरू याजक आपना सनी क छिंदरा आरू आपना डील पर आपनी झारली जाँघिया पेहरीन होमबलि क मेक, जी आग्ठा सी भस्म करने सी वेदी पर रय जाय, ओका उठावीन वेदीन धड़े मेक दे। <verse eid="LEV 6:10" /><verse number="11" style="v" sid="LEV 6:11" />तव चु आपना छिंदरा उतारीन दिसरा छिंदरा पेहरीन रूखड़ा क पड़ाव सी बाहरते काहना शुद्ध स्थान पर ली जाय। <verse eid="LEV 6:11" /><verse number="12" style="v" sid="LEV 6:12" />वेदी पर आगठो धोपतो रवे, आरू कभी उलवायने नी जुवे; आरू याजक हर एक दाहड़े पहाटे उका पर लाकड़ा धोपाड़ीन होमबलि क टुकड़ा क ओकान ऊपर सजाड़ीन धर दे, आरू ओकान ऊपर मेलबलिया क चरबा क धोपाड्या करे। <verse eid="LEV 6:12" /><verse number="13" style="v" sid="LEV 6:13" />वेदी पर आगठो लगातार धोपतो रवे; चो कभी बुझायनो नी जुवे।<verse eid="LEV 6:13" /></para>
  <para style="s">अन्न भेंट</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 6:14" />“अन्नबलि क व्यवस्था इना गत छे: हारून क पोर्‍यो ओकाह वेदी क सामने योहोवा क सामने ली आया। <verse eid="LEV 6:14" /><verse number="15" style="v" sid="LEV 6:15" />आरू चु अन्नबलि क तेल भेस्कायलो मयदा मा सी मुठ भरीन आरू उका परलो सब लोबान उठावीन अन्नबलि क यादन ओका भाग क योहोवा क सामने सुखदायक सुगन्ध क करता वेदी पर धोपाड़े। <verse eid="LEV 6:15" /><verse number="16" style="v" sid="LEV 6:16" />आरू ओका मा सी जो शेष रय जाय ओका हारून आरू ओकान पोर्‍या खाय; चु बिना खमीर चुखलीजागा मा खाया जासे, मतलब चा मिलापवाळा तम्बू क आंगना मा उका खाये। <verse eid="LEV 6:16" /><verse number="17" style="v" sid="LEV 6:17" />चो खमीर क साथे रांदनो नी; काहकी हाव आपना हव्य मा सी उकाह ओकान निज भाग होयने क करता हेका देदा छे; एरकरता जोसो पापबलि आरू दोषबलि घण चुखो छे, तोसोज चो भी छे। <verse eid="LEV 6:17" /><verse number="18" style="v" sid="LEV 6:18" />हारून क वंश क सब मानुस उका मा सी खाय सकता छे, तुमरी पीढ़ी मा योहोवा भगवान क हवन मा सी यो उकान भाग हमेशा बवनो रवसे; जु कुई उना हवनो क हाथ लागाड़े चु चुखलु ठरसे।” <verse eid="LEV 6:18" /><verse number="19" style="v" sid="LEV 6:19" />पछु योहोवा मूसा सी कयो, <verse eid="LEV 6:19" /><verse number="20" style="v" sid="LEV 6:20" />“जेके दाहड़े हारून क अभिषेक होसे उके दाहड़े चु आपना पोर्‍या क साथे योहोवा क यो चढ़ावु चढ़ायु; मतलब एपा क दसवु भाग मयदो नित्य अन्नबलि मा चढ़ाया, उका मा सी आर्धे पहाटे आरू आर्धे सांतेन टेमे चढ़ाया। <verse eid="LEV 6:20" /><verse number="21" style="v" sid="LEV 6:21" />चो तवा पर तेल क साथे रांदलो जासे; जव चो तेल सी तरी होय जाय तव उका ली आवनो, ओका अन्नबलि न चुल्लो टुकड़ो योहोवा भगवान क सुखदायक सुगन्ध करता चढ़ावनो। <verse eid="LEV 6:21" /><verse number="22" style="v" sid="LEV 6:22" />हारून क पोर्‍या मा सी जु भी उका याजक पद पर अभिषिक्त होसे, वी विधि हमेशा क करता छे। कि योहोवा क सामने चो सब‍ चढ़ावो धोपाड्यो जासे। <verse eid="LEV 6:22" /><verse number="23" style="v" sid="LEV 6:23" />याजक क सब अन्नबलि भी सब धोपाड्या जासे; चो कभी नी खातो जासे।”<verse eid="LEV 6:23" /></para>
  <para style="s">पापबलि</para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 6:24" />आरू योहोवा भगवान मूसा सी कयो, <verse eid="LEV 6:24" /><verse number="25" style="v" sid="LEV 6:25" />“हारून आरू उकान पोर्‍या सी यो कयो कि पापबलि की नियम यो छे: जेका जागा मा होमबलिपशु क बलि कर्‍या जाता छे उका मा पापबलिपशु भी योहोवा भगवान क सामने बलि कर्‍या जासे; चु परमपवित्र छे।” <verse eid="LEV 6:25" /><verse number="26" style="v" sid="LEV 6:26" />जु याजक पापबलि चढ़ावु चु ओका खाये; चु पवित्रस्थान मा, मतलब मिलापवाळा तम्बू क आंगना मा काया जासे। <verse eid="LEV 6:26" /><verse number="27" style="v" sid="LEV 6:27" />जो काहय उकान मांस सी हाथ लागाड़े जासे, चु पवित्र ठरसे; आरू कदाम उकान लुहूय क छिटळा एकदा छिंदरा पर पड़ जाय, ते उकाह काहना चुखला जागा मा धुव देदु। <verse eid="LEV 6:27" /><verse number="28" style="v" sid="LEV 6:28" />आरू त्यो धुळान ठिकरा मा त्यो पाकाळलो गयो तुड़ दि जासे; कदाम चु पितवन पात्रा मा उबाळ्यो गयो छे, ते चो उजाळीन, आरू पाणी सी धुव देल्लो जासे। <verse eid="LEV 6:28" /><verse number="29" style="v" sid="LEV 6:29" />याजक मा सी सब मानसे उकाह खाय सकता छे; चु परमपवित्र चीज छे। <verse eid="LEV 6:29" /><verse number="30" style="v" sid="LEV 6:30" />पुन जेका पापबलिपशु क लुहूय मा सी काहय भी लुहूय मिलपवाळा तम्बू क माहयता चुखलो जागा मा पश्चाताप करने क पुगाड्या जासे, उकान मांस कभी नी खाय जासे; चो आग्ठा मा धोपाड़ दे जासे।<verse eid="LEV 6:30" /></para>
  <chapter eid="LEV 6" />
  <chapter number="7" style="c" sid="LEV 7" />
  <para style="s">दोषबलि</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 7:1" />यी दोष-बलिन व्यवस्था छे: ची घण चुखो छे। <verse eid="LEV 7:1" /><verse number="2" style="v" sid="LEV 7:2" />जिना जागा मा आग्ठा क बलि क पशु क वध करता छे, हेका स्थान मा दोष-बलि लीन पशु क वध कर्‍यो जासे, आरू उकान लुहूय वेदीक चार तरफ छिड़की जासे। <verse eid="LEV 7:2" /><verse number="3" style="v" sid="LEV 7:3" />उकान माइन सब चरबी क चढ़ावे: हेका चरबो भारी चरबी वाळी सेमटी, आतड्याक ढ़ाकने वाळो चरबो बी, <verse eid="LEV 7:3" /><verse number="4" style="v" sid="LEV 7:4" />दुयु गुर्दा आरू चो चरबो जो उकान ऊपर आरू कमर क जु रवती छे, आरू गुर्दा क साथ मा काळजान ऊपरली जाळी इनु सब कहो अलग करे । <verse eid="LEV 7:4" /><verse number="5" style="v" sid="LEV 7:5" />पुजारो हेको वेदी पर धोपाड़े। चु पोरबु क आग्ठा मा अर्पित गुणानन-बलि छे। <verse eid="LEV 7:5" /><verse number="6" style="v" sid="LEV 7:6" />याजक मायीन सब मानुस ओकामा सी खाय सके; चा काहना चुखलास्थान मा खाया जासे; काहकी चु घण चुखो छे। <verse eid="LEV 7:6" /><verse number="7" style="v" sid="LEV 7:7" />जोसो पापबलि छे तोसोज दोषबलि भी छे, हेनु दुयन एकुज व्यवस्था छे; जो पुजारा हेनु बलिक चढ़ावीन पाप ढाकीन करे त्यात् हेनु चीजक लेये। <verse eid="LEV 7:7" /><verse number="8" style="v" sid="LEV 7:8" />आरू जु याजक काहना क करता होमबलि क चढ़ावे उनी होमबलि पशुन खाल क त्यो पुजारो ली लेय। <verse eid="LEV 7:8" /><verse number="9" style="v" sid="LEV 7:9" />आरू भट्टी मा, या कढ़ाया मा, या तवा पर चुढ़लो सब अन्नबलि उनात् याजकन हुयसे जो हेको चड़ावे। <verse eid="LEV 7:9" /><verse number="10" style="v" sid="LEV 7:10" />आरू सब अन्नबलि, जो चाहे तेल करीन झारलो चाहे सुकलो हय, चा हारून क सब पोर्‍यान क एक समान जोड्या।<verse eid="LEV 7:10" /></para>
  <para style="s">मेलमिलापबलि</para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 7:11" />“मेलबलि क, जेका कुई योहोवा क करता चढ़ावे व्यवस्था यी छे: <verse eid="LEV 7:11" /><verse number="12" style="v" sid="LEV 7:12" />कदाम चा उका धन्यवाद क करता चढ़ाया, ते धन्यवादबलि क साथे तेल करीन चुड़ली अखमीरी पुड़ी, आरू तेल सी चुपड़ली अखमीरी रोटा, आरू तेल करीन चुड़ला मयदान क पुड़ी तेल सी भेसकला चढ़ावे। <verse eid="LEV 7:12" /><verse number="13" style="v" sid="LEV 7:13" />आरू चो आपनो धन्यवादवाळा मेलबलि क साथ खमीरी रोटा भी चढ़ाया। <verse eid="LEV 7:13" /><verse number="14" style="v" sid="LEV 7:14" />आरू ओसो एक एक चढ़ावा मा सी चा एक एक रोटो योहोवा क भेंट करीन चढ़ाया; चा मेलमिलापबलि न लुहूय क छिड़कनेवाळा पुजारान हुयसे। <verse eid="LEV 7:14" /><verse number="15" style="v" sid="LEV 7:15" />आरू उका धन्यवादवाळा मेलबलि क मांस बलिदान चढ़ावने क दाहड़े खादा जासे; उकामा सी काहय भी भोर तक शेष नी रया जासे। <verse eid="LEV 7:15" /><verse number="16" style="v" sid="LEV 7:16" />पुन कदाम बलिदान क चढ़ावो मन्नत क के स्वेच्छा क होय, ते उका बलिदन क जेके दाहड़े चो चढ़ाया जासे उके दाहड़े चो खादा जासे, आरू उका मा सी जा शेष रय जासे चो दीसरे दाहड़े भी खादा जासे। <verse eid="LEV 7:16" /><verse number="17" style="v" sid="LEV 7:17" />पुन जु काहय बलिदान क मांस मा सी तीसरे दाहड़े तक रय जासे तेनाक आग्ठा मा धोपाड़े जासे। <verse eid="LEV 7:17" /><verse number="18" style="v" sid="LEV 7:18" />आरू उकान मेलबलि क मांस मा सी कदाम काहय भी तीसरे दाहड़े खादा जासे, ते चा ग्रहण नी कर्‍या जासे, आरू नी उकान हित मा गिनियो जासे; चो घाड़्च्या काम समझा जासे, आरू जु कुई उकामा सी खादा ओधोरोम उका क मुनका पर पड़से।<verse eid="LEV 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 7:19" />“ओळतेन जो मांस काहना अशुद्ध चीज हाथ लागाड़े जासे चो नी खाया जासे। ओळतेन मेलबलि क मांस जोतरा शुद्ध होय चाज खाए, <verse eid="LEV 7:19" /><verse number="20" style="v" sid="LEV 7:20" />पुन जु अशुद्ध होईन योहोवा क मेलबलि क मांस मा सी काहय खाए चा आपना लोगहन मा सी नाश कर्‍या जासे। <verse eid="LEV 7:20" /><verse number="21" style="v" sid="LEV 7:21" />आरू कदाम कुई अशुद्ध चीज क हाथ लागाड़ीन योहोवा क मेलबलिपशु क मांस मा सी खाए, चा भी आपना लोगहन मा सी नाश कर्‍या जासे, चाहे चु मानुस क कुई अशुद्ध चीज या अशुद्ध पशु या कुई भी अशुद्ध आरू घाड़्च्या चीज होसे।”<verse eid="LEV 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 7:22" />ओळतेन योहोवा मूसा सी कयो, <verse eid="LEV 7:22" /><verse number="23" style="v" sid="LEV 7:23" />“इस्राएलिया सी इनीये रीतिये कय: तुमु लोगहन नी ते बुयल क काहय चरबो खानो आरू नी गाडरा निते बुकड़ी क। <verse eid="LEV 7:23" /><verse number="24" style="v" sid="LEV 7:24" />आरू जु पशु खुद मर जाए, आरू जु दीसरा पशु सी फाड़े जासे, ओकान चरबो दीसरा काम मा लेनो, पुन उका काहना प्रकारण सी खानो नी। <verse eid="LEV 7:24" /><verse number="25" style="v" sid="LEV 7:25" />जु कुई ओसो पशु क चरबो खासे जेरामा सी लोगहन काहय योहोवा क करता बलिदान करीन चढ़ाया करता छे, चो खानेवाळो आपना लोगहन मा सी नाश कर्‍या जासे। <verse eid="LEV 7:25" /><verse number="26" style="v" sid="LEV 7:26" />आरू तुमु आपना घर मा काहना भाँतिन क लुहूय, चाहे चिल्ला क चाहे पशु क होय, नी खानो। <verse eid="LEV 7:26" /><verse number="27" style="v" sid="LEV 7:27" />हर एक प्राणी जौ काहनी भाँतिन लुहूय खासे चो आपना लोगहन मा सी नाश कर्‍या जासे।” <verse eid="LEV 7:27" /><verse number="28" style="v" sid="LEV 7:28" />ओळतेन योहोवा मूसा सी कयो, <verse eid="LEV 7:28" /><verse number="29" style="v" sid="LEV 7:29" />“इस्राएलिया सी ओका प्रकार कयो: जो योहोवा क करता मेलबलि चढ़ाया ची उको मेलबलि मा सी योहोवा क जु भेंट ली आया; <verse eid="LEV 7:29" /><verse number="30" style="v" sid="LEV 7:30" />चा आपनाज हाथ सी योहोवा क हव्य क, मतलब छाती समेत चरबो क ली आया कि छाती हालावने क भेंट करीन योहोवा क सामने हालाया जासे। <verse eid="LEV 7:30" /><verse number="31" style="v" sid="LEV 7:31" />आरू याजक चरबा क ते वेदी पर धोपाड़्या, पुन छाती हारून आरू ओकान पोर्‍या क होसे। <verse eid="LEV 7:31" /><verse number="32" style="v" sid="LEV 7:32" />आरू तुमु आपना मेलबलि मा सी डाखर्‍यु जाँग क भी उठावने क भेंट करीन याजक क आपनु; <verse eid="LEV 7:32" /><verse number="33" style="v" sid="LEV 7:33" />हारून क पोर्‍या मा सी जो मेलबलि क लुहूय आरू चरबा क चढ़ाया डाखर्‍यु जाँग उका क भाग होसे। <verse eid="LEV 7:33" /><verse number="34" style="v" sid="LEV 7:34" />काहकी इस्राएलिया क मेलमिलापबलि मा सी हालावने क भेंट क छाती आरू उठावने क भेंट क जाँग क लीन हाव ते याजक हारून आरू उकान पोर्‍योक आप्या छे कि यो हमेशा इस्राएलिया क तरफ सी उनाक हक बवनो रया।<verse eid="LEV 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 7:35" />“जिन दाहड़े हारून आरू ओकान पोर्‍याक योहोवा क समीप याजक पद क करता लाया जासे ओकी दाहड़े योहोवा क बलिदान मा सी उनाक यी अभिषिक्त भाग ठराया गोया; <verse eid="LEV 7:35" /><verse number="36" style="v" sid="LEV 7:36" />मतलब जिन दाहड़े योहोवा उनाक अभिषेक कर्‍या उके दाहड़े ओका हुकुम देदो कि उनाक इस्राएलिया क तरफ सी या भाग नित्य जोड़े कर्‍या; उनाक पीढ़ी पीढ़ी क करता उनाक यो हक जड़ीयो गोया।” <verse eid="LEV 7:36" /><verse number="37" style="v" sid="LEV 7:37" />होमबलि, अन्नबलि, पापबलि, दोषबलि, याजक क संस्कार बलि, आरू मेलबलि क व्यवस्था यी छे; <verse eid="LEV 7:37" /><verse number="38" style="v" sid="LEV 7:38" />जव योहोवा सीनाय बोयड़ा क उजाड़ी जागा मा मूसा क हुकुम देदा कि इस्राएली मार करता काय काय चढ़ावो चढ़ायो, तव ओको उनाक यी व्यवस्था देदी हती।<verse eid="LEV 7:38" /></para>
  <chapter eid="LEV 7" />
  <chapter number="8" style="c" sid="LEV 8" />
  <para style="s">हारून आरू ओकान पोर्‍या क अभिषेक</para>
  <para style="r">(<ref loc="EXO 29:1-37">निर्गमन 29:1-37</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 8:1" />ओळतेन योहोवा मूसा सी कयो <verse eid="LEV 8:1" /><verse number="2" style="v" sid="LEV 8:2" />“तू हारून आरू ओकान पोर्‍या क छिंदरा, आरू अभिषेक क तेल, आरू पापबलि क केवड़ा, आरू दुयु गाडरा, आरू अखमीरी रूटो क टुकरा क <verse eid="LEV 8:2" /><verse number="3" style="v" sid="LEV 8:3" />मिलापवाळा तम्बू क झोपला पर ली आया, आरू चान सब मण्डली क इकठा कर।”<verse eid="LEV 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 8:4" />योहोवा क ओका हुकुम क अनसारे मूसा कर्‍या मण्डली मिलापवाळा तम्बू क झोपला पर इकठा होया। <verse eid="LEV 8:4" /><verse number="5" style="v" sid="LEV 8:5" />तव मूसु मण्डली सी कोया, “जो काम करनेक हुकुम योहोवा आप ददो छे चो यो छे।”<verse eid="LEV 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 8:6" />ओळतेन मूसा हारून आरू हेका पोर्यान क साते ली जाईन पानी सी उंगवाळ्यो। <verse eid="LEV 8:6" /><verse number="7" style="v" sid="LEV 8:7" />तव ओको उनाक चौगला पेहरायो, आरू पट्टो लेपट्यो आरू धंगड़ो पांगरायो, आरू एपोद लागाड़ीन एपोद क काढ़ा होया पट्टा सी याजकन छिंदरा क बाँधीन कस देदा। <verse eid="LEV 8:7" /><verse number="8" style="v" sid="LEV 8:8" />आरू उका सिनाबंद लागाड़ीन सिनाबंद मा ऊरीम आरू तुम्मीम मेक देदा। <verse eid="LEV 8:8" /><verse number="9" style="v" sid="LEV 8:9" />तव ओको ओकान मुनका पर पागड़ी बाँधीन पागड़ी क सामने सोनान पट्टी क, मतलब पवित्र मुकुट क लागाड्या, जेका प्रकार योहोवा मूसा क हुकुम देदी हती।<verse eid="LEV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 8:10" />तव मूसु अभिषेक क तेल लीन निवास आरू जो काहय ओकामा हतो उना सब क भी अभिषेक करीन हेका चुखलो कर्‍या। <verse eid="LEV 8:10" /><verse number="11" style="v" sid="LEV 8:11" />आरू उका तेल मा सी काहय उनी वेदी पर सात वार छिड़कीयो, आरू आखा समान क साथ वेदी क आरू हेका ठिकरा चुखो करियो। <verse eid="LEV 8:11" /><verse number="12" style="v" sid="LEV 8:12" />आरू ओको अभिषेक क तेल मा सी काहय हारूनन मुनका पर न्हाखिन ओकान अभिषेक करीन ओकाह चुखलो कर्‍या। <verse eid="LEV 8:12" /><verse number="13" style="v" sid="LEV 8:13" />ओळतेन मूसु हारून पोर्‍याक सामने ली आवीन, अंगरखा पेरावीन, कड़ीयाम पट्टो बाँधिन ओकान मुनका पर टुपी मेक देदा, जेका प्रकार योहोवा मूसा क हुकुम देदी हती। <verse eid="LEV 8:13" /><verse number="14" style="v" sid="LEV 8:14" />तव त्यो पापबलिन केवड़ा क सामने ली गोया; आरू हारून आरू ओकान पोर्‍यो आपना आपना हाथ पापबलि क केवड़ा क मुनका पर मेक्या। <verse eid="LEV 8:14" /><verse number="15" style="v" sid="LEV 8:15" />तव चा बलि कर्‍या गोया, आरू मूसु लुहूय लीन आंगवी करीन वेदीक च्यारू सिंगळा पर लागाड़ीन चुखलो कर्‍यो, आरू लुहूय वेदी क पाय पर उंडेल देदो, आरू ओकान करता पश्चाताप करीन ओकाह चुखलो कर्‍या। <verse eid="LEV 8:15" /><verse number="16" style="v" sid="LEV 8:16" />आरू मूसा आतड़ा परली सब चरबी, आरू काळजा परली चरबी, आरू चरबीन क सात मा दुयु गुर्दान क लीन वेदी पर धपाड़ियो। <verse eid="LEV 8:16" /><verse number="17" style="v" sid="LEV 8:17" />पुन केवड़ा मा सी जो काहय वाच गयो हेको, गुबरन सात हेकी खाल आरू मांस क ओको पड़ाव सी बाहरते आग्ठा मा धोपाड़ दिदो, जेका तरह योहोवा मूसा क हुकुम देदो हतो।<verse eid="LEV 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 8:18" />ओळतेन चा होमबलि क गाडरा क सामने ली गोया, आरू हारून आरू ओकान पोर्‍यो आपना आपना हाथ गाडरा क मुनका पर मेक्या। <verse eid="LEV 8:18" /><verse number="19" style="v" sid="LEV 8:19" />तव चा बलि कर्‍या गोया, आरू मूसु ओकान लुहूय वेदी पर चार तरफ छिड़क्या। <verse eid="LEV 8:19" /><verse number="20" style="v" sid="LEV 8:20" />तव गाडरा क टुकड़ा टुकड़ा कर्‍या गोयो, आरू मूसा मुनको आरू चरबीन क सात टुकड़ा क धोपाड़ दिदो। <verse eid="LEV 8:20" /><verse number="21" style="v" sid="LEV 8:21" />तव आतड्या आरू पाय पाणी करीन धुव्या गोया, आरू मूसु पुरा गाडराक वेदी पर धोपाड्या, आरू चा सुखदायक सुगन्ध आपने क करता होमबलि आरू योहोवा क करता बलिदान होय गोया, जेका तरह योहोवा मूसा क हुकुम देदो हतो।<verse eid="LEV 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 8:22" />ओळतेन चा दीसरा गाडरा क जो अभिषकन भेंट क गाडरो हुतो सामने ली गयो, आरू हारून आरू हेका पोर्या आपसा-आपसा हाथ गाडरा क मुनका पर मेक्यो। <verse eid="LEV 8:22" /><verse number="23" style="v" sid="LEV 8:23" />तव चो बलि कर्‍यो गोया आरू मूसु ओकान लुहूय मा सी काहय लीन हारून डाखरे कान क मुनका पर आरू ओकान डाखरे हाथ आरू डाखरे पाय क ऊमठा पर लागाड्या। <verse eid="LEV 8:23" /><verse number="24" style="v" sid="LEV 8:24" />आरू चु हारून क पोर्‍याक सामने ली गोयो, आरू लुहूय मा सी काहय एक एक डाखर्‍या कान क मुनका पर आरू डाखर्‍या हाथ आरू डाखर्‍या पाय क ऊमठा पर लागाड्या; आरू मूसु लुहूय क वेदी पर चार तरफ छिड़क्या। <verse eid="LEV 8:24" /><verse number="25" style="v" sid="LEV 8:25" />आरू ओको चरबो, आरू चरबीदार शेमटी, आरू आतड्या परली सब चरबो, आरू कावजा परली झिल्ली समेत दुयु गुर्दा, आरू डाखर्‍या जाँग, या सब लीन अलग मेके; <verse eid="LEV 8:25" /><verse number="26" style="v" sid="LEV 8:26" />आरू अखमीरी रूटा क टुकरो जो योहोवा क ओगव मेकला हता ओकाम माहयलो एक रूटो, आरू तेल करीन झारलो मयदा क एक पुरी, आरू एक रूटो लीन चरबो आरू डाखर्‍या जाँग पर मेक देदा; <verse eid="LEV 8:26" /><verse number="27" style="v" sid="LEV 8:27" />आरू या सब चीज हारून आरू ओकान पोर्‍या क हाथ पर धर देदी गई, आरू हिलान क भेट क करता योहोवा क ओगव हालाया गोया। <verse eid="LEV 8:27" /><verse number="28" style="v" sid="LEV 8:28" />तव मूसा हेकेक हेनका हाथ पर सी मा लीन हेका वेदी पर होमबलि क ऊपर धोपाड्या, यो सुखदायक सुगन्द आरू यहोवान क लियन आग्ठान भेट हुती। <verse eid="LEV 8:28" /><verse number="29" style="v" sid="LEV 8:29" />तव मूसु छाती क लीन हिलाने क भेट क करता योहोवा क ओगव हालव्या; आरू संस्कार क गाडरा मा सी मूसा क भाग यो होयो जोसो योहोवा मूसा क हुकुम देदी हती।<verse eid="LEV 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 8:30" />तव मूसु अभिषेक क तेल आरू वेदी पर लुहूय, दुयु मा सी काहय लीन हारून आरू ओकान छिंदरा पर, आरू ओकान पोर्‍याक आरू उनाक छिंदरा पर भी छिड़क्या; आरू ओकान छिंदरा समेत हारून क भी चुखलो कर्‍या।<verse eid="LEV 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 8:31" />तव मुसू हारून आरू ओकान पोर्‍या सी कयो, “मांस क मिलापवाळा तम्बू क झोपला पर रांदु, आरू उका रूटा कजो संस्कार क टुकरा मा छे चो खाऊ, जोसो हाव हुकुम देदी छे कि हारून आरू ओकान पोर्‍यो ओकाह खाएँ। <verse eid="LEV 8:31" /><verse number="32" style="v" sid="LEV 8:32" />आरू मांस आरू रूटा मा सी जो शेष रय जाए ओका मा धोपाड़ देनु। <verse eid="LEV 8:32" /><verse number="33" style="v" sid="LEV 8:33" />जव तक तुमरा संस्कार क दाहड़ा पुरो नी होय तव तक, मतलब सात दाहड़े तक मिलापवाळा तम्बू क झोपला क बाहरते जानु, काहकी वा सात दाहड़े तक तुमरो संस्कार करतो रवसे। <verse eid="LEV 8:33" /><verse number="34" style="v" sid="LEV 8:34" />जेका प्रकार आज कर्‍या गोया छे तोसाज करने क हुकुम योहोवा देदो छे, जेका सी तुमरो पाप ढाकाय जासे। <verse eid="LEV 8:34" /><verse number="35" style="v" sid="LEV 8:35" />एरकरता तुमु मिलापवाळा तम्बू क झोपला पर सात दाहड़े तक ठहरे रयनु, आरू योहोवा क हुकुम क मामनु, ताकि तुमु मर नी जावु; काहकी ओसोज हुकुम मखे आपी गई छे।” <verse eid="LEV 8:35" /><verse number="36" style="v" sid="LEV 8:36" />तव योहोवा क इनाक सब हुकुम क अनसारे जो ओको मूसा क द्वारा देदी हती, हारून आरू ओकान पोर्‍यो कर्‍यो।<verse eid="LEV 8:36" /></para>
  <chapter eid="LEV 8" />
  <chapter number="9" style="c" sid="LEV 9" />
  <para style="s">हारून द्वारा बलि-अर्पण</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 9:1" />आठवे दाहड़े मूसु हारून आरू ओकान पोर्‍या क आरू इस्राएली पुरानिया क बुलावीन हारून सी कयो, <verse eid="LEV 9:1" /><verse number="2" style="v" sid="LEV 9:2" />“पापबलि क करता एक निर्दोष गाडरा लीन योहोवा क सामने भेट चढ़ा। <verse eid="LEV 9:2" /><verse number="3" style="v" sid="LEV 9:3" />आरू इस्राएली सी यो कोय, तुमु पापबलि क करता एक बुकड़ो, आरू होमबलि क करता एक केवड़ो आरू एक गाडरा क बच्चो लेवु, जो एक सालन होय आरू निर्दोष होसे, <verse eid="LEV 9:3" /><verse number="4" style="v" sid="LEV 9:4" />आरू मेलबलि क करता योहोवा क सामने चढ़ावने क करता एक बुयल आरू एक गाडरो, आरू तेल करीन झारलो होयो मयदा क एक अनाज भेंट भी ली लेवु; काहकी आज योहोवा तुमु क दर्शन देसे।” <verse eid="LEV 9:4" /><verse number="5" style="v" sid="LEV 9:5" />आरू जेका जेका चीज क हुकुम मूसु देदु उना सब क चा मिलापवाळा तम्बू क ओगव ली आया; आरू सब मण्डली सामने जाईन योहोवा क सामने उबा होया। <verse eid="LEV 9:5" /><verse number="6" style="v" sid="LEV 9:6" />तव मूसु कयो, “यो काम छे जेका करने क करता योहोवा हुकुम देदो छे कि तुमु उकाह करू; आरू योहोवान महिमा तुमु क दुखाई पड़से।” <verse eid="LEV 9:6" /><verse number="7" style="v" sid="LEV 9:7" />तव मूसु हारून सी कयो, “योहोवा क हुकुम क अनसारे वेदी क सामने जाईन आपना पापबलि आरू होमबलि क चढ़ावीन आपना आरू सब जनता क करता पश्चाताप कर; आरू जनता क चढ़ावा क भी चढ़ावीन उनाक करता पश्चाताप कर।”<verse eid="LEV 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 9:8" />एरकरता हारून वेदीक सामने जाईन आपना पापबलि क केवड़ा क बलिदान कर्‍या। <verse eid="LEV 9:8" /><verse number="9" style="v" sid="LEV 9:9" />आरू हारून क पोर्‍यो लुहूय क ओकान जु ली गोया, तव ओको आपनी आंगवी क लुहूय मा डुबाड़ीन वेदी क सिंगड़ा पर लुहूय क लागाड्या,अ आरू शेष लुहूय क वेदी क पाय पर उंडेल देदा; <verse eid="LEV 9:9" /><verse number="10" style="v" sid="LEV 9:10" />आरू पापबलि माहयली चरबो आरू गुर्दो आरू कावजा परली झिल्ली क ओकान वेदी पर धोपाड्या, जोसो योहोवा मूसा क हुकुम देदी हती। <verse eid="LEV 9:10" /><verse number="11" style="v" sid="LEV 9:11" />आरू मांस आरू खाल क ओकान पड़ाव सी बाहरते आग्ठा मा धोपाड्या।<verse eid="LEV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 9:12" />तव होमबलिपशु क बलिदान कर्‍या; आरू हारून क पोर्‍या क लुहूय क ओकान हाथ मा आप्या, आरू ओको उकाह वेदी पर चार तरफ छिड़की देदा। <verse eid="LEV 9:12" /><verse number="13" style="v" sid="LEV 9:13" />तव हेका होमबलिपशु क टुकड़ा टुकड़ा करीन मुनका सहित ओकान हाथ मा आप देदा आरू ओकान उनाक वेदी पर धोपाड़ देदा। <verse eid="LEV 9:13" /><verse number="14" style="v" sid="LEV 9:14" />आरू ओकान आतड़िया आरू पायोक धुवीन वेदी पर होमबलि क ऊपर धोपाड्या।<verse eid="LEV 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 9:15" />तव ओका लोगहन क चढ़ावा क ओगव लीन आरू ओका पापबलि क बुकड़ा क जा उनाक करता हता लीन ओकान बलिदान कर्‍या, आरू पेहेल समान उकाह भी पापबलि करीन चढ़ाया। <verse eid="LEV 9:15" /><verse number="16" style="v" sid="LEV 9:16" />आरू ओको होमबलि क भी सामने ली जाईन विधि क अनसारे चढ़ाया। <verse eid="LEV 9:16" /><verse number="17" style="v" sid="LEV 9:17" />आरू अन्नबलि क भी सामने ली जाईन ओकामा सी मुठ भरीन वेदी पर धोपाड्या, यो भोर क होमबलि क बिना चढ़ायो गोयो।<verse eid="LEV 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 9:18" />बयल्यो आरू गाडरा, मतलब जु मेलबलिपशु, जनता क करता हता चा भी बलि कर्‍या गोया; आरू हारूनक पोर्‍यो लुहूय क ओकान हाथ मा आप देदा, आरू उको उकाह वेदी पर चार तरफ छिड़की देदो; <verse eid="LEV 9:18" /><verse number="19" style="v" sid="LEV 9:19" />आरू हेका बुयल क चरबा क, आरू गाडरा मा सी चरबीदार सेमटी क, आरू जेका चरबा सी आतड़िया ढाकली रवती छे ओकान, आरू गुर्दो समेत कावजा परली झिल्ली क भी ओकान हाथ मा आप्या; <verse eid="LEV 9:19" /><verse number="20" style="v" sid="LEV 9:20" />आरू हेका चरबा क छाती पर मेक्या; आरू ओको चो चरबो पर धोपाड्या, <verse eid="LEV 9:20" /><verse number="21" style="v" sid="LEV 9:21" />पुन छाति आरू डाखर्‍यो जाँघ क हारून मूसा क हुकुम क अनसारे हिलाने क भेट क करता योहोवा क सामने हिलाया।<verse eid="LEV 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 9:22" />तव हारून क लोगहन क तरफ हाथ बढ़ावीन हेका सय बरकत देदा; आरू पापबलि, होमबलि, आरू मेलबलि क चढ़ावीन चो नेड़ो उतरी आयो। <verse eid="LEV 9:22" /><verse number="23" style="v" sid="LEV 9:23" />तव मूसु आरू हारून मिलापवाळा तम्बू मा गोया, आरू निकाळीन लोगहन क सय बरकत देदा; तव योहोवा न महिमा सब जनता क दिखाय देदो। <verse eid="LEV 9:23" /><verse number="24" style="v" sid="LEV 9:24" />आरू योहोवा क सामने सी आगठो निकळे आरू चरबा समेत होमबलि क वेदी पर भस्म कर देदा; ओका देखिन जनता जय जयकार क नारा लागाड्या आरू आपना आपना मुहय क बुरसे पड़ीन दण्डवत् प्रणाम कर्‍या।<verse eid="LEV 9:24" /></para>
  <chapter eid="LEV 9" />
  <chapter number="10" style="c" sid="LEV 10" />
  <para style="s">नादाब आरू अबीहू क पाप</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 10:1" />तव नादाब आरू अबीहु नावन हारून क दुय पोर्‍या आपना आपना धूपदान लिदा, आरू उनामा आगठो भर्‍या, आरू हेका मा धूप न्हाखिन हेको ऊपर वाळी आग्ठी यहोवाक अर्पित करीया जेको हुकुम यहोवा आप लोन हुतो। <verse eid="LEV 10:1" /><verse number="2" style="v" sid="LEV 10:2" />तव योहोवा क सामने आगठो निकळे आरू उना दुयोक भस्म कर देदो, आरू चा योहोवा क सामने मर गोया। <verse eid="LEV 10:2" /><verse number="3" style="v" sid="LEV 10:3" />तव मूसु हारून सी कयो, “यी वात छे जेका योहोवा कयो हतो कि जो मार सामने आवे, नक्‍की छे कि चो मखे चुखलो जाने, आरू सब लोगहन क सामने म्हारी महिमा करे।” आरू हारून चुप रयो।<verse eid="LEV 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 10:4" />तव मूसा हारूनन काका उज्जीएल न पोर्या, मीशाएल आरू एलसाफान क बुलायो। त्यो हेनको कयो, साते आवो, आरू तुमरा भतेरजास क चुखला जागान सामने सी हाकलीन पड़ावन बाहर ली जावो। <verse eid="LEV 10:4" /><verse number="5" style="v" sid="LEV 10:5" />मूसा क उकाह हुकुम क अनसारे चा नाट जाईन उनाक चौगलान सात मा हाकलीन पड़ावन बाहर ली गिया। <verse eid="LEV 10:5" /><verse number="6" style="v" sid="LEV 10:6" />तव मूसु हारून सी आरू ओकान पोर्‍या एलीआजार आरू ईतामार सी कयो, “तुमु लोगहन आपना मुनका झोठा मा वेरू, आरू मा आपना छिंदरा क फाडु, ओसो नी होय कि तुमु भी मर जावु, आरू इस्राएल क कुल घराना क लोगहन जा तुमरे भाईबन्धु छे योहोवान क लागाड़ली आग्ठी सी मर गिया हेनू पर विखाम रड़े। <verse eid="LEV 10:6" /><verse number="7" style="v" sid="LEV 10:7" />आरू तुमु लोगहन मिलापवाळा तम्बू क झोपला क बाहरते नी जानु, ओसो नी होय कि तुमु मर जावु; काहकी योहोवा ख अभिषेक क तेल तुमु पर लागाड्या छे।” मूसा क ओका वचन क अनसारे हेका कर्‍या।<verse eid="LEV 10:7" /></para>
  <para style="s">याजक क करता नियम</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 10:8" />ओळतेन योहोवा हारून सी कयो, <verse eid="LEV 10:8" /><verse number="9" style="v" sid="LEV 10:9" />“जव जव तू या तारा पोर्या मिलापवाळा तम्बू मा आया तव तव तुमरे मा रयीन कोय बी मोंद आरू नी काहला भातिन क शराब, के ओसो नी होय कि तुमु मर जावु; तुमरी पीढ़ी मा यी विधि चालती रये, <verse eid="LEV 10:9" /><verse number="10" style="v" sid="LEV 10:10" />जेका सी तुमु चुखला आरू विटुळ मा, आरू वारला आरू भुंडला न पारक कर सके, <verse eid="LEV 10:10" /><verse number="11" style="v" sid="LEV 10:11" />आरू इस्राएलिया क उना सब विधिया क सिखाड़ सके जेका योहोवा मूसा क द्वारा उनाक देखाड़लो छे”<verse eid="LEV 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 10:12" />ओळतेन मूसु हारून सी आरू ओकान वाचला दुयु पोर्‍या ईतामार आरू एलीआजार सी भी कयो, “योहोवा क हव्य मा सी जो अन्नबलि वाचला छे उका लीन वेदी क जु बिना खमीर खाऊ, काहकी चो घण चुखी छे; <verse eid="LEV 10:12" /><verse number="13" style="v" sid="LEV 10:13" />आरू तुमु उका काहना पवित्रजागा मा खाऊ, चा योहोवा क हव्य मा सी तारो आरू तारा पोर्‍या क हक छे; काहकी हाव ओसोज हुकुम जोडी छे। <verse eid="LEV 10:13" /><verse number="14" style="v" sid="LEV 10:14" />पुन हिलाई ओसली भेट क छाती आरू उठावळी ओसी भेट क जाँघ क तुमु लोगहन, मतलब तू आरू तारा पोर्‍या-पोराय क सब काहनी शुद्ध जागा मा खाऊल काहकी चा इस्राएलिया क मेलबलि मा सी तुखे आरू तारा बच्चा क हक ठराव देदी गई छे। <verse eid="LEV 10:14" /><verse number="15" style="v" sid="LEV 10:15" />चरबा क हव्या समेत जी उठाई ओसी जाँग आरू हिलाई होई छाती योहोवा क सामने हिलाने क करता आव्या करसे, या भाग योहोवा क हुकुम क अनसारे हमेशा विधि क व्यवस्था सी तार जु बच्चा क करता छे।”<verse eid="LEV 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 10:16" />ओळतेन मूसु पापबलि क बुकड़ा क खोजबीन कर्‍या, ते काय जोड्यो कि चो धोपाड्यो गोयो छे। एरकरता एलीआजार आरू ईतामार जु हारून क पोर्‍यो वाचला हता उना सी चा रीस मा आवीन कयने लाग्या, <verse eid="LEV 10:16" /><verse number="17" style="v" sid="LEV 10:17" />पापबलि जो घण चुखी छे आरू जेका योहोवा तुमुक एरकरता देदा छे कि तुमु मण्डली क ओधोरोम क भार आपसु उठावीन उनाक करता योहोवा क सामने पश्चाताप करे, तुमु ओकान मांस चुखलोजागा मा काह नी खादो? <verse eid="LEV 10:17" /><verse number="18" style="v" sid="LEV 10:18" />देखु, ओकान लुहूय चुखलोजागा क माहयता ते लाव्या नी गोया, पाक्को यो वारलो हुयतो कि तुमु मारा हुकुम क अनसारे ओकान मांस क चुखलाजागा मा खादा।? <verse eid="LEV 10:18" /><verse number="19" style="v" sid="LEV 10:19" />ओका जवाब हारून मूसा क ओका प्रकार देख्या, देख, आजुज हेका आपना पापबलि आरू होमबलि क योहोवा क सामने चढ़ाया; ओळतेन मखे पर ओसो गोरा आय पड़यो छे! एरकरता कदाम हाव आज पापबलि क मांस खाता ते काय ती वात योहोवा क सामने वारलो रवतो? <verse eid="LEV 10:19" /><verse number="20" style="v" sid="LEV 10:20" />जव मूसु यो सोमव्यु तव उका संतुष्ट होयु।<verse eid="LEV 10:20" /></para>
  <chapter eid="LEV 10" />
  <chapter number="11" style="c" sid="LEV 11" />
  <para style="s">शुद्ध आरू अशुद्ध पशु</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 11:1" />ओळतेन योहोवा मूसु आरू हारून सी कयो, <verse eid="LEV 11:1" /><verse number="2" style="v" sid="LEV 11:2" />इस्राएली लोगहन सी कोय: जोतरा पशु धरती पर छे उना सभा मा सी तुमु इना जीवधारिया क मांस खाय सकता छे। <verse eid="LEV 11:2" /><verse number="3" style="v" sid="LEV 11:3" />पशु मा सी जोतरा चिरायला या फाटला खुर्‍या क होतला छे आरू पागुर करता छे, हेका खाय सकता छे। <verse eid="LEV 11:3" /><verse number="4" style="v" sid="LEV 11:4" />पुन पागुर करनेवाळा या फाटला खुर्‍यावाळा मा सी इना पशु क नी खानु, मतलब ऊटळो, जो पागुर ते करता छे पुन चिरायला खुर्‍या क नी हता, एरकरता चा तुमरे करता अशुद्ध ठरता छे। <verse eid="LEV 11:4" /><verse number="5" style="v" sid="LEV 11:5" />आरू मुरचीतो, जो वेगलतो ते रये पुन चिरायला खुर्‍या क नी हता, चो भी तुमरे करता विटळ छे। <verse eid="LEV 11:5" /><verse number="6" style="v" sid="LEV 11:6" />आरू खरहा, जु पागुर ते करता छे पुन चिरायला खुर्‍या क मी हता, एरकरता चु भी तुमरे करता विटळ छे। <verse eid="LEV 11:6" /><verse number="7" style="v" sid="LEV 11:7" />आरू सुवर्‍यो, जो चिरायलो मतलब फाटलो खुर्‍या क रवतो ते छे पुन पागुर नी करता, एरकरता चो तुमरे करता विटळ छे। <verse eid="LEV 11:7" /><verse number="8" style="v" sid="LEV 11:8" />इना मांस मा सी काहय नी खानु, आरू इनाक लोथ क हाथ भी नीलागाड़नु; यो ते तुमरे करता अशुद्ध छे <verse eid="LEV 11:8" /><verse number="9" style="v" sid="LEV 11:9" />ओळतेन जोतरा जलजन्तु छे उनामा सी तुमु ओका खाय सकता छे, मतलब दरिया या नदिया क जलजन्तु मा सी जोतरा क फाकळा आरू खिलपड़ा रये हेको खाय सकता छे। <verse eid="LEV 11:9" /><verse number="10" style="v" sid="LEV 11:10" />आरू पानी मा चरने वाला प्राणी मा सी जोतरा जीवधारि बिना फाखड़ा आरू खिलपड़ान क दरिया या नदी मा रयता छे चा सब तुमरे करता घाड़्च्या छे। <verse eid="LEV 11:10" /><verse number="11" style="v" sid="LEV 11:11" />त्यो तुमरे करता भुण्डलो रयसे; तुमु हेका मांस मा सी काहय बी नी खानो, आरू उना धड़ क विटुळ जानजो। <verse eid="LEV 11:11" /><verse number="12" style="v" sid="LEV 11:12" />जल मा जेका काहना जन्तु क फाखड़ा आरू चोंयेटे नी होता चा तुमरे करता अशुद्ध छे। <verse eid="LEV 11:12" /><verse number="13" style="v" sid="LEV 11:13" />“ओळतेन चिल्ला मा सी इनाक अशुद्ध जाननु, या अशुद्ध होयनेन कारण खाए नी खाएँ, मतलब घुवड, हवाटीयो, वागळो, <verse eid="LEV 11:13" /><verse number="14" style="v" sid="LEV 11:14" />गुवड़ो, आरू भाँति-भाँति क हेवाटिया, <verse eid="LEV 11:14" /><verse number="15" style="v" sid="LEV 11:15" />आरू भाँति-भाँति क सब हाड़गाळा, <verse eid="LEV 11:15" /><verse number="16" style="v" sid="LEV 11:16" />घुबड़ीया, शुतुर्मुग, पानकुकड़ी, आरू भाँति भाँतिन शिकरे, <verse eid="LEV 11:16" /><verse number="17" style="v" sid="LEV 11:17" />साहळी, कागनघारो, भचकीड़ियो, <verse eid="LEV 11:17" /><verse number="18" style="v" sid="LEV 11:18" />बगलियो, पानकुकड़ी, घुवड़, <verse eid="LEV 11:18" /><verse number="19" style="v" sid="LEV 11:19" />सारस, भाँति-भाँतिन क भोगल्या, टिटवड़ी आरू वागळा।<verse eid="LEV 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 11:20" />“जोतरा फाखड़ावाळा कीड़ा चार पायन भुरसा पर चालता छे चा सब तुमरे करता अशुद्ध छे। <verse eid="LEV 11:20" /><verse number="21" style="v" sid="LEV 11:21" />पुन रेंगनेवाळा आरू फाखड़ा वाळा जा चार पायन भुरसा पर चाले, जेका धरती पर कूदने फाँदने क पांय रवता छे उनाक ते खाय सकता छे, <verse eid="LEV 11:21" /><verse number="22" style="v" sid="LEV 11:22" />चा या छे, मतलब भाँति भाँतिन टिड्या, भाँति भाँतिन माकनीया भाँति भाँतिन सांडीया, आरू भाँति भाँतिन टिड्या। <verse eid="LEV 11:22" /><verse number="23" style="v" sid="LEV 11:23" />पुन आरू सब रंगनेवाळा फाखळावाळा कीड़ा जा चार पायवाळा रवता छे चा तुमरे करता अशुद्ध छे।<verse eid="LEV 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 11:24" />“इनाक कारण तुमु अशुद्ध ठरसे; जेका काहना सी इनाक लोथ क हाथ लागाड़े चो सांते तक अशुद्ध ठरसे। <verse eid="LEV 11:24" /><verse number="25" style="v" sid="LEV 11:25" />आरू जु कुई इनाक लोथ माहयन काहय भी हाकलिया चो आपना छिंदरा धुवे आरू सांते तक अशुद्ध रवे। <verse eid="LEV 11:25" /><verse number="26" style="v" sid="LEV 11:26" />ओळतेन जोतरा पशु चिरायला खुर्‍या क रवता छे पुन नी ते पुरा फाटला खुर्‍या आरू नी पागुर करनेवाळा छे चा तुमरे करता अशुद्ध छे; जु कुई हेका हाथ लागाड़े चा अशुद्ध ठरसे। <verse eid="LEV 11:26" /><verse number="27" style="v" sid="LEV 11:27" />आरू चार पाय पर चालनेवाळा मा सी जोतरा पंजा पर चालने वाळा छे चा तुमरे करता अशुद्ध छे; जा कुई उनाक लोथ हाथ लागाड़े सांते तक अशुद्ध रया। <verse eid="LEV 11:27" /><verse number="28" style="v" sid="LEV 11:28" />आरू जु कुई उनाक लोथ हाकलिया चा आपना छिंदरा धुव्या आरू सांते तक अशुद्ध रया; काहकी चा तुमरे करता अशुद्ध छे।<verse eid="LEV 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 11:29" />“जु धरती पर रेंगता छे उनामा सी या रंगनेवाळा तुमरे करता अशुद्ध छे, मतलब अनीर, उंदरो, आरू भाँति-भाँतिन क गुरफड़ो, <verse eid="LEV 11:29" /><verse number="30" style="v" sid="LEV 11:30" />आरू मांदेवड़ियो, मगर, गिरवाळी, चांदनगुटीयो, आरू सेवड़ियान। <verse eid="LEV 11:30" /><verse number="31" style="v" sid="LEV 11:31" />सब रेंगनेवाळा मा सी याज तुमरे करता अशुद्ध छे; जा कुई इनाक लोथ क हाथ लागाड़े चा सांते तक अशुद्ध रवे। <verse eid="LEV 11:31" /><verse number="32" style="v" sid="LEV 11:32" />आरू इना मा सी काहना लोथ जा काहना चीज पर पड़ जाए ते चो भी अशुद्ध ठरसे, चाहे चो काठ क कुई पात्र होसे, चाहे छिंदरा, चाहे खाल, चाहे काहनो काम क कोसो भी पात्र आदि काह नी होय; तेनाल जल मा न्हाखे जासे, आरू सांते तक अशुद्ध रवे, तव शुद्ध समझे जासे। <verse eid="LEV 11:32" /><verse number="33" style="v" sid="LEV 11:33" />आरू कदाम धुवा क कुई पात्र होसे जेकामा इना जन्तु मा सी कुई पड़े, ते उका पात्रा मा जो काहय होसे चो अशुद्ध ठरसे, आरू पात्रा क तुमु तुड़ न्हाखजु। <verse eid="LEV 11:33" /><verse number="34" style="v" sid="LEV 11:34" />ओकामा जो खाने क योग्य खानो होये, जेकामा पाणी क छिमिया होय चा सब अशुद्ध ठरसे; ओळतेन कदाम ओसो पात्रा मा पानी क करता काहय होय ते चो भी अशुद्ध ठरसे। <verse eid="LEV 11:34" /><verse number="35" style="v" sid="LEV 11:35" />आरू कदाम इनाक लोथ मा काहय तंदुर या चूल्हा पर पड़े ते चा भी अशुद्ध ठरसे, आरू तुड़ न्हाखजे; काहकी चो अशुद्ध होय जासे, चो तुमरे करता भी अशुद्ध ठरसे। <verse eid="LEV 11:35" /><verse number="36" style="v" sid="LEV 11:36" />पुन सोता या तवाव जेकामा पाणी एकठो होये चो ते शुद्ध रवे; पुन जो कुई इनाक लोथ क हाथ लागाड़े ते चो अशुद्ध ठरसे। <verse eid="LEV 11:36" /><verse number="37" style="v" sid="LEV 11:37" />आरू कदाम इनाक लोथ मा काहय काहना प्रकार क बीज पर जा वेरने क करता से पड़ला, ते चा बीज शुद्ध रवे; <verse eid="LEV 11:37" /><verse number="38" style="v" sid="LEV 11:38" />पुन कदाम बीज पर पाणी न्हाखला होसे आरू पछव लोथ माहयलो काहय उका पर पड़ जाए, त <verse eid="LEV 11:38" /><verse number="39" style="v" sid="LEV 11:39" />ते जु कुई उनाक लोथ क हाथ लागाड़े ते चो सांते तक अशुद्ध रवे। <verse eid="LEV 11:39" /><verse number="40" style="v" sid="LEV 11:40" />आरू ओकान लोथ मा सी जु कुई काहय खाए चु आपना छिंदरा धुवे आरू सांते तक अशुद्ध रवे; आरू जु कुई ओकान लोथ उठावे तेनाक भी आपना छिंदरा धुवे आरू सांते तक अशुद्ध रवे।<verse eid="LEV 11:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LEV 11:41" />“सब प्रकार क धरती पर रेंगनेवाळा जन्तु घिनौना छे; चा खादो नी जासे। <verse eid="LEV 11:41" /><verse number="42" style="v" sid="LEV 11:42" />धरती पर सब रेंगनेवाळा मा सी जोतरा पेट या चार पाय पर चालता छे, या जास्ती पायवाळा रवता छे, हेका तुमु नी खानु; काहकी चा घिनौना छे। <verse eid="LEV 11:42" /><verse number="43" style="v" sid="LEV 11:43" />तुमु काहना प्रकार क रेंगनेवाळा जन्तु क द्वारा आपने आपसु क घिनौनो काम नी करनु; आरू नी ओकान द्वारा क अशुद्ध करीन विटुळ ठरनु। <verse eid="LEV 11:43" /><verse number="44" style="v" sid="LEV 11:44" />काहकी हाव तुमरू परमेश्वर योहोवा छेव; ओका कारण आपनु क शुद्ध करीन चुखला बवना रवु, काहकी हाव चुखलु छे। एरकरता तुमु काहना प्रकार क रेंगनेवाळा जन्तु क द्वारा जा धरती पर चालता छे आपने आपसु क अशुद्ध नी करनु। <verse eid="LEV 11:44" /><verse number="45" style="v" sid="LEV 11:45" />काहकी हाव चु योहोवा छेव जु तुमुक मिस्र देश सी एरकरता निकाळीन ली आयु छे, कि तुमरू परमेश्वर कहवायो; एरकरता तुमु चुखा बनु, काहकी हाव चुखो छे।”<verse eid="LEV 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 11:46" />पशु, क चिल्ला, आरू सब जलचर प्राणी, आरू धरती पर सब रेंगनेवाळा प्राणी क बारा मा यी व्यवस्था छे, <verse eid="LEV 11:46" /><verse number="47" style="v" sid="LEV 11:47" />के शुद्ध अशुद्ध आरू भक्ष्य आरू अभक्ष्य जीवधारिया मा भेद कर्‍या जासे।<verse eid="LEV 11:47" /></para>
  <chapter eid="LEV 11" />
  <chapter number="12" style="c" sid="LEV 12" />
  <para style="s">प्रसूता क शुद्धिकरण करने क विधि</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 12:1" />पछु योहोवा भगवान मूसा सी कयो, <verse eid="LEV 12:1" /><verse number="2" style="v" sid="LEV 12:2" />“इस्राएलिया सी कोया: जी बायर पेट सी होईन पोर्‍याक जन्म देती छे ते ची सात दाहड़े तक अशुद्ध रवसे; जोसो ची ऋतुमती होईन अशुद्ध रया करती। <verse eid="LEV 12:2" /><verse number="3" style="v" sid="LEV 12:3" />आरू आठवे दाहड़े पोर्‍या क चामड़ी काटी चुखो करे। <verse eid="LEV 12:3" /><verse number="4" style="v" sid="LEV 12:4" />पछी ची बायर आपना शुद्ध करनेवाळा रूधिर मा तैतीस दाहड़ा रवे; आरू जव तक उकाह शुद्ध होयनेन दाहड़ा पुरा नी होय तव तक ची नीते काहनी चुखली चीजक हाथ लागाड़े, आरू नी चुखली जागा मा जाया करे। <verse eid="LEV 12:4" /><verse number="5" style="v" sid="LEV 12:5" />आरू कदाम हेकी पोराय पयदा होई, ते उकाह ऋतुमती क सी अशुद्ध चोवदे दाहड़ान लागी; आरू पछा छियासठ दाहड़ा तक आपना शुद्ध करनेवाळा रूधिर मा रया।<verse eid="LEV 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 12:6" />“जव हेकी शुद्ध होय जानेन दाहड़ा पूरा होय, तव चाहे हेकी पोर्‍यो होय या पोराय, चो होमबलि करता एक साल क गाडरा क बच्चो, आरू पापबलि क करता कबूतरी क एक पिल्लो, या पण्डुकी मिलापवाळा तम्बू क झोपला पर याजक क जु लाया। <verse eid="LEV 12:6" /><verse number="7" style="v" sid="LEV 12:7" />तव याजक उकाह योहोवा क सामने भेंट चढ़ावीन उकान करता पश्चाताप करे; आरू चा आपना रूधिर क वहयनेन अशुद्धता सी छुड़ीन शुद्ध ठरसे। जीन बायरन पोर्‍यो या पोराय पयदा होय उकान करता यी व्यवस्था छे। <verse eid="LEV 12:7" /><verse number="8" style="v" sid="LEV 12:8" />आरू कदाम उकान जु गाडरो या बुकड़ी आपनेन पुंजी नी होय, ते आप पण्डुकी या कबूतरी क दुय पिल्ला, एक ते होमबलि आरू दिसरा पापबलि क करता आप; आरू याजक उकान करता पश्चाताप करे, तव ची शुद्ध ठरसे।”<verse eid="LEV 12:8" /></para>
  <chapter eid="LEV 12" />
  <chapter number="13" style="c" sid="LEV 13" />
  <para style="s">कुष्‍ठ रोग सी सम्बन्धित नियम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 13:1" />ओळतेन योहोवा मूसु आरू हारून सी कोया, <verse eid="LEV 13:1" /><verse number="2" style="v" sid="LEV 13:2" />“जव काहना मानुस क डिल क चामड़ा मा सूजलो या फुलो या दाग होसे, आरू ओका हारूनसी ओका चामड़ा मा कोढ़ क जु या ओकान पोर्‍यो जो याजक छे उना मा सी काहना क जु ली जाएँ। <verse eid="LEV 13:2" /><verse number="3" style="v" sid="LEV 13:3" />जव याजक उकान चामड़ा क दाग क देख्या, आरू कदाम उका व्‍याधि क जागे रयने आरू कुड़ सी घण जादा देख पड़े, ती त्यो जान जाय कि कुढ़न टेम छे आरू पुजारो हेको देखीन विटुळ बना। <verse eid="LEV 13:3" /><verse number="4" style="v" sid="LEV 13:4" />पुन कदाम चो दाग उकान चामड़ा मा उजव्यो ते होसे, पुन चामड़ा सी उंडो नी देख पड़े, आरू नी चा वाळा रोवड़ा विजावो होय गोया छे, ते याजक ओकाम सात दाहड़े तक बन्द कर देदा; <verse eid="LEV 13:4" /><verse number="5" style="v" sid="LEV 13:5" />आरू सातवे दाहड़े याजक ओकाह देख्या, आरू कदाम ची दाग जोसी तोसी बोवनी रवे आरू ओकान चामड़ा मा नी पसरी छे, ते याजक ओकाह आरू भी सात दाहड़े तक बन्द कर देदा; <verse eid="LEV 13:5" /><verse number="6" style="v" sid="LEV 13:6" />आरू सातवे दाहड़े याजक ओकाह ओळतेन देख्या, आरू कदाम देख पड़े कि दाग क चमक कम छे आरू दाग क चामड़ा पर पसरी नी होसे, ते याजक ओकाह शुद्ध ठरावे; काहकी ओकाह ते चामड़ा मा पापड़ी छे; आरू चा आपना छिंदरा धुवीन शुद्ध होय जाए। <verse eid="LEV 13:6" /><verse number="7" style="v" sid="LEV 13:7" />पुन कदाम याजक क उका जाँचन बाद जेकामा चो शुद्ध ठरायो होयो हतो, ची फुलो उकान चामड़ा पर बैस पसरी गोया, ते पछा चा याजक क देखाड़े जासे; <verse eid="LEV 13:7" /><verse number="8" style="v" sid="LEV 13:8" />आरू कदाम याजक क देख पड़े कि पापड़ी चामड़ा मा पसरी गई छे, ते चा ओकान अशुद्ध ठराया; काहकी चो कुढुज छे।<verse eid="LEV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 13:9" />“कदाम कोढ़ क सी दाग काहनु मानुस क होसे, ते चो याजक क जु पुगाड्या जासे; <verse eid="LEV 13:9" /><verse number="10" style="v" sid="LEV 13:10" />आरू याजक ओका देख्यु, आरू कदाम ची सूजन ओकान चामड़ा मा उजवी होसे, आरू ओकान कारण रोवड़ा भी विजावो होय गोयो होसे, आरू उका सूजन मा बिना चामड़ा क मांस होसे, <verse eid="LEV 13:10" /><verse number="11" style="v" sid="LEV 13:11" />ते याजक जाने कि ओकाह चामड़ा मा जुन्लो कोढ़ छे, एरकरता चो ओकाह अशुद्ध ठराया; आरू बन्द नी राख्या, काहकी चो अशुद्ध छे। <verse eid="LEV 13:11" /><verse number="12" style="v" sid="LEV 13:12" />आरू कदाम कोढ़ काहना क चामड़ा सी फूटीन या तक पसरी जाएँ, कि जा का याजक देख्या रोगी क मुनका सी पाय तवे तक कोढ़ नी सब चामड़ो पुरो कर लेदा होसे, <verse eid="LEV 13:12" /><verse number="13" style="v" sid="LEV 13:13" />ते याजक ध्यान सी देखे, आरू कदाम कोढ़ ओका सब डिलक क पर पसरी गयो होसे, ते यो ओका मानसक शुद्ध ठराया; आरू ओकान डिल जो बिलकुल विजावो होय गोयो छे चा शुद्ध ठहरे छे। <verse eid="LEV 13:13" /><verse number="14" style="v" sid="LEV 13:14" />पुन जव ओकामा चामड़ाम मांस देख पड़े, तव चो अशुद्ध ठरसे। <verse eid="LEV 13:14" /><verse number="15" style="v" sid="LEV 13:15" />आरू याजक चामड़ा मांस क देखिन ओकाह अशुद्ध ठरे; काहकी तोसो चामड़ा मांस अशुद्ध रवतो छे; चो कोढ़ छे। <verse eid="LEV 13:15" /><verse number="16" style="v" sid="LEV 13:16" />पुन कदाम चो चामड़ो मांस ओळता विजावो होय जासे, ते चु मानुस याजक क जु जाए, <verse eid="LEV 13:16" /><verse number="17" style="v" sid="LEV 13:17" />आरू याजक ओकाह देखे, आरू कदाम चो दाग ओळता विजावो होय गोयो छे, ते याजक रोगी क शुद्ध जाने; चो शुद्ध छे।<verse eid="LEV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 13:18" />“ओळतेन कदाम काहना चामड़ा मा फुड़ा होईन वारला होय गोया छे, <verse eid="LEV 13:18" /><verse number="19" style="v" sid="LEV 13:19" />आरू फुड़ा क जागा मा विजावा सी सूजलो या लाली करता विजावो दाग होसे, ते चो याजक क देखाड़े जासे; <verse eid="LEV 13:19" /><verse number="20" style="v" sid="LEV 13:20" />आरू याजक ओका सुजला क देखे, आरू चा चामड़ा सी उंडो देखाय पड़े, आरू ओकान रोड़े भी विजावा हो गोया छे, ते याजक यो जानीन उका मानसक अशुद्ध ठराया; काहकी चो कोढ़ क दाग छे फुड़ा मा सी फुटिन निकळी छे। <verse eid="LEV 13:20" /><verse number="21" style="v" sid="LEV 13:21" />पुन कदाम याजक देखे कि उकामा विजावा रोया नी छे, आरू चो चामड़ा सी उंडो नी, आरू ओकान चमक कम होई छे, ते याजक उका मानसक सात दाहड़े तक बनन्द कर राखे; <verse eid="LEV 13:21" /><verse number="22" style="v" sid="LEV 13:22" />आरू कदाम त्यो दाग उके टेमे तक चमड़ा मा सचमुच पसरी जाए, ते याजक उका मानस क अशुद्ध ठरसे; काहकी त्यो कोढ़ क दाग छे। <verse eid="LEV 13:22" /><verse number="23" style="v" sid="LEV 13:23" />पुन कदाम त्या दाग नी पसरे आपना जागा पर बोवना रया, ते त्या फुड़ाक दाग छे; याजक उका मानस क शुद्ध ठरसे।<verse eid="LEV 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 13:24" />“ओळता कदाम काहना क चामड़ा मा धोपड़ेन घाव होसे, आरू उका धोपला घाव मा चामड़ा बिना दाग लाली करता होया विजावो या विजावोज होय जाए, <verse eid="LEV 13:24" /><verse number="25" style="v" sid="LEV 13:25" />ते याजक ओकाह देखे, आरू कदाम उका दाग मा रोया विजवा होय गोया होसे आरू त्यो चामड़ा सी जादी देखाय पड़े, ते चा कोढ़ छे; जो उकाह धोपला दाग मा सी फूट निकळ्या छे; याजक उका मानस क अशुद्ध ठराया; काहकी ओका मा कोढ़ क व्‍याधि छे। <verse eid="LEV 13:25" /><verse number="26" style="v" sid="LEV 13:26" />पुन कदाम याजक देखे कि दाग मा विजावा दाग रोया नी आरू नी त्या चामड़ा सी काहय उंडा छे, आरू उकान चमक मक होई छे, ते त्यो ओकाह सात दाहड़े तक बन्द कर राखे, <verse eid="LEV 13:26" /><verse number="27" style="v" sid="LEV 13:27" />आरू सातवे दाहड़े याजक क ओको देख्या, आरू कदाम चो चामड़ा मा पसरी गई होसे, ते चो उका मानस क अशुद्ध ठराया; काहकी ओकाह कोढ़ क दाग छे। <verse eid="LEV 13:27" /><verse number="28" style="v" sid="LEV 13:28" />पुन कदाम चा दाग चामड़ा मा नी पसर्‍या आरू आपना जागा परूज जा का ताह बवनो होसे, आरू ओकान चमक कम होई होसे, ते चो धोपाय जाने क कारण सूजलो छे, याजक उका मानस क शुद्ध ठराया; काहकी चो दाग धोपने क कारण सी छे।<verse eid="LEV 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 13:29" />“ओळतेन कदाम काहना मानुस या बायर क मुनका पर, या मानस क दाढ़ी मा दाग होसे, <verse eid="LEV 13:29" /><verse number="30" style="v" sid="LEV 13:30" />ते याजक दाग क देख्या, आरू कदाम चप चामड़ा सी उंडो देखाय पड़े, आरू उकामा भूरला-भूरला पातवा झोठा होसे, ते याजक उका मानस क अशुद्ध ठराया; चो दाग सी खवड़ु, मतलब मुनका या दाढ़ी क कोढ़ छे। <verse eid="LEV 13:30" /><verse number="31" style="v" sid="LEV 13:31" />आरू कदाम याजक सी होयतो व्‍याधि क देखे कि चो चामड़ा सी उंडो नी छे आरू उकामा काळ्ळा-काळ्ळा झोठा नी छे, ते चा सेंहुआ बेमार्‍या क सात दाहड़े तक बन्द कर राख्या, <verse eid="LEV 13:31" /><verse number="32" style="v" sid="LEV 13:32" />आरू सातवे दाहड़े याजक दाग क देख, तव कदाम चा सेंहुआ पसर्‍यो नी होसे, आरू उकामा भूरला-भूरला झोठा नी होसे, आरू सेंहुआ चामड़ा सी उंडो नी देख पड़े, <verse eid="LEV 13:32" /><verse number="33" style="v" sid="LEV 13:33" />ते यो मानुस मूँड़ाय ते जासे; पुन जा सेंहुआ होसे चा नी मूँड़ाय ते जासे; आरू याजक उका सेंहुआवाळा क आरू भी सात दाहड़े तक बन्द करे; <verse eid="LEV 13:33" /><verse number="34" style="v" sid="LEV 13:34" />आरू सातवे दाहड़े याजक सेंहुआ क देखे, आरू कदाम चा सेंहुआ चामड़ा मा पसर्‍यु नी होसे आरू चामड़ा सी उंडा नी देखाय पड़े, ते याजक उका मानस क शुद्ध ठराया; आरू चा आपना छिंदरा धुवीन शुद्ध ठरसे। <verse eid="LEV 13:34" /><verse number="35" style="v" sid="LEV 13:35" />पुन कदाम ओकान शुद्ध ठरने क पश्चाताप सेंहुआ चामड़ा मा काहय भी पसरे, <verse eid="LEV 13:35" /><verse number="36" style="v" sid="LEV 13:36" />ते याजक ओका देखे, आरू कदाम चा‍मड़ा मा पसर्‍यो होसे, ते याजक भूरला झोठा नी हेरे; काहकी चो मानुस अशुद्ध छे। <verse eid="LEV 13:36" /><verse number="37" style="v" sid="LEV 13:37" />पुन कदाम ओकान नजर मा चा सेंहुआ जोसाज तोसो बवनो होसे, आरू ओकामा काळ्ळा झोठा जमला होसे, ते चा जाने कि सेंहुआ वारला होय गोया छे, आरू चो मानुस शुद्ध छे; याजक उकाह शुद्ध ठरजे।<verse eid="LEV 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LEV 13:38" />“औळतेन कदाम काहना मानस क या बायर क चामड़ा मा उजला दाग होसे, <verse eid="LEV 13:38" /><verse number="39" style="v" sid="LEV 13:39" />ते याजक देखे, आरू कदाम ओकान चामड़ा मा चा दाग कम उजला होसे, ते चा जाने क ओकान चामड़ा मा निकळली दाद छे; चो मानुस शुद्ध ठरजे।<verse eid="LEV 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LEV 13:40" />“ओळतेन जेका मुनका क झोठा झड़ गोया छे, ते जाननु कि चो ते टकलो ते छे पुन शुद्ध छे। <verse eid="LEV 13:40" /><verse number="41" style="v" sid="LEV 13:41" />आरू जेका मुनका क ओगला झोठा झड़ गोया छे, ते चो निंडावा क चन्दुला ते छे पुन शुद्ध छे। <verse eid="LEV 13:41" /><verse number="42" style="v" sid="LEV 13:42" />पुन कदाम चन्दुला मुनका पर या चन्दुला निंडावा पर लाली लीन उजली दाग होसे, ते जाननु कि चा उकान चन्दुला मुनका या चन्दुला निंडावा पर निकळयो होयो कोढ़ छे। <verse eid="LEV 13:42" /><verse number="43" style="v" sid="LEV 13:43" />एरकरता याजक ओका देख्या, आरू कदाम दाग क सूजन ओकान टकलो मुनको या निंडावा पर ओसी लाली करता उजली होसे जोसो चामड़ा क कोढ़ मा हतला छे, <verse eid="LEV 13:43" /><verse number="44" style="v" sid="LEV 13:44" />ते चु मानुस कढ़ावाळो छे आरू अशुद्ध छे; आरू याजक ओकान नक्की अशुद्ध ठराया; काहकी ची दाग ओकान मुनका पर छे।<verse eid="LEV 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LEV 13:45" />“जेका मा ची दाग होसे उका कोढ़ा क छिंदरा फाटला आरू मुनका क झोठा सुटला रया, आरू चा आपना ऊपरवाळा उठ क ढापीन अशुद्ध, अशुद्ध आयड्या करे। <verse eid="LEV 13:45" /><verse number="46" style="v" sid="LEV 13:46" />जोतरा दाहड़ा तक चा दाग ओका मा रया ओतरा दाहड़ा तक चा अशुद्ध ठरला रया; एरकरता चु एकलु रया करे, ओकान निवास स्थान क छावनी क बाहरता छे।<verse eid="LEV 13:46" /></para>
  <para style="s">छिंदरा या चामड़ा क चीज क कोढ़</para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 13:47" />“ओळतेन जेका छिंदरा मा कोढ़ क दाग होसे, चाहे चा छिंदरा रूई क होसे चाहे झारली क, <verse eid="LEV 13:47" /><verse number="48" style="v" sid="LEV 13:48" />ची दाग चाहे उका झारली या ऊनन छिंदरा क सिवलो मा हय चाहे गुथलो हय, या त्यो दाग चामड़ा मा या चामड़ा क बोवनी काहनी चीज मा हय, <verse eid="LEV 13:48" /><verse number="49" style="v" sid="LEV 13:49" />कदाम त्यो दाग काहला छिंदराम चाहे सिवला मा चाहे गुथला मा, या चामड़ा मा या चामड़ान काहली चीज मा निव्ळो हय या लाल सी हय, ती जानजी कि त्यो दाग छे आरू त्यो पुजारान जक देखाड़े। <verse eid="LEV 13:49" /><verse number="50" style="v" sid="LEV 13:50" />आरू याजक क देख, आरू दागवाळी चीज क सात दाहड़ान करता बन्द करे; <verse eid="LEV 13:50" /><verse number="51" style="v" sid="LEV 13:51" />आरू सातवे दाहड़े चु उका दाग क देखे, आरू कदाम चा छिंदरा क चाहे ताने मा चाहे बाने मा, या चामड़ा मा या चामड़ा क बवनी काहनी चीज मा पसरी गई होसे, ते जाननु कि दाग क गलति कोढ़ छे, एरकरता ची चीज, चाहे काहनी काम मा काह नी आवती होसे, तेभी अशुद्ध ठरसे। <verse eid="LEV 13:51" /><verse number="52" style="v" sid="LEV 13:52" />चु उका छिंदरा क ताने या बाने मा ची दाग होसे, चाहे चा ऊनन क होसे चाहे सनी क, या चामड़ा क होसे; उकाह धोपाड़ दे, ची दाग गळनियो कुढ़न छे; हेनी चीज क आग्ठा मा धोपाड़ देनो जुळे।<verse eid="LEV 13:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LEV 13:53" />“कदाम याजक देखे कि त्यो दाग उना छिंदरान कुना मा या वीच मा, या चामड़ान क उनी चीज मा नी पसरी, <verse eid="LEV 13:53" /><verse number="54" style="v" sid="LEV 13:54" />ते जेका चीज मा दाग होसे ओकान धोने क आदेश आप, तव उका आरू भी सात दाहड़े बन्द कर राखे; <verse eid="LEV 13:54" /><verse number="55" style="v" sid="LEV 13:55" />आरू उकाह धोने क बाद याजक ओकाह देखे, आरू कदाम दाग क नी ते रंग बदल्यो होसे, आरू नी दाग पसरी होसे, ते जाननु कि चो अशुद्ध छे; उकाह आग्ठा मा धोपाळनु, काहकी चाहे चा दाग माहयता चाहे ऊपरली होसे तेभी ची खाने वाळी दाग छे। <verse eid="LEV 13:55" /><verse number="56" style="v" sid="LEV 13:56" />पुन कदाम याजक देखे कि ओकाह धोने क बाद दाग क चमक कम होय जासे, ते चा उकाह छिंदरा क चाहे ताने चाहे बाने मा सी, या चामड़ा मा सी फाड़ीन निकळे; <verse eid="LEV 13:56" /><verse number="57" style="v" sid="LEV 13:57" />आरू कदाम ची दाग तव भी उका छिंदरा क ताने या बाने मा, या चामड़ा क उका चीज मा देखाय पड़े, ते जाननु कि ची फुटीन निकळी दाग छे; आरू जेका मा ची दाग होसे ओका आग्ठा मा धोपाड़नु। <verse eid="LEV 13:57" /><verse number="58" style="v" sid="LEV 13:58" />कदाम हेका छिंदरा या चामड़ान काहय बी चीज हय जेको छुवने सी दाग जात रये, ती त्यो दिसरी वार धुळायीन चुको हये।” <verse eid="LEV 13:58" /><verse number="59" style="v" sid="LEV 13:59" />ऊनन या सुवाळा छिंदरान कुना मा या काहा बी या चामड़ान काहली बी चीज मा जो कुढ़न दाग हय हेको चुखो करनेन योत् नियम छे।<verse eid="LEV 13:59" /></para>
  <chapter eid="LEV 13" />
  <chapter number="14" style="c" sid="LEV 14" />
  <para style="s">कोढ़ सी शुद्ध ठराया जानु</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 14:1" />ओळतेन योहोवा मूसा सी कयो, <verse eid="LEV 14:1" /><verse number="2" style="v" sid="LEV 14:2" />कोढ़ क चुखो करनेन नियम यो छे। त्यो पुजारान याँ जाय; <verse eid="LEV 14:2" /><verse number="3" style="v" sid="LEV 14:3" />आरू पुजारो छावनी क बाहरते जासे, आरू याजक उका कोढ़ क देखे, आरू कदाम उका कोढ़ क दाग वारली होई होसे, <verse eid="LEV 14:3" /><verse number="4" style="v" sid="LEV 14:4" />ते याजक आदेश देदो कि शुद्ध ठरावनेवाळा क करता दुय शुद्ध आरू जीवता चिल्ला, देवदारू क लाकड़ी, आरू लाल रंग क छिंदरा आरू जूफा या सब क करता जासे; <verse eid="LEV 14:4" /><verse number="5" style="v" sid="LEV 14:5" />आरू याजक आदेश आप कि एक चिल्ला वोहयता पाणी क ऊपर धुवा क ठिकरा मा बलि कर्‍या जासे। <verse eid="LEV 14:5" /><verse number="6" style="v" sid="LEV 14:6" />तव चो जीवतो चिल्ला क देवदारू क लाकड़ो आरू रंग क छिंदरा आरू जूफान इना सब क लीन एक संग उका चिल्ला क लुहूय मा जो वोहयतो पाणी क ऊपर बलि करे; <verse eid="LEV 14:6" /><verse number="7" style="v" sid="LEV 14:7" />आरू कोढ़ सी शुद्ध ठरावनेवाळा पर सात वार छिड़कीन ओकाह शुद्ध ठराया, तव उका जीवता चिल्ला क मैदान मा छुड़ दे। <verse eid="LEV 14:7" /><verse number="8" style="v" sid="LEV 14:8" />आरू शुद्ध ठरावनेवाळा आपना छिंदरा क धुवे, आरू सब झोठा काडाळीन पाणी सी उंगव्या उंगळी लेय, तव चा शुद्ध ठरसे; आरू ओकान बाद चा पड़ावा मा आवनु जुवे, पुन सात दाहड़े तक आपना डेरा सी बाहरते रया। <verse eid="LEV 14:8" /><verse number="9" style="v" sid="LEV 14:9" />आरू सातवे दाहड़े त्यो मुनको, दाढ़ी आरू काखेन सब झोठा बुड़ाय देय, आरू सब अंग काडाड्या, आरू आपना छिंदरा क धुव्या, आरू पाणी सी उंगवी करे, तव चा शुद्ध ठरसे।<verse eid="LEV 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 14:10" />आठवें दाहड़े त्या दुय निर्दोष गाडरा क बच्चें, आरू अन्नबलिन करता तेल करीन झारलो एपा पाँच किलो मैदा, आरू आधा लिटर तेल लावे। <verse eid="LEV 14:10" /><verse number="11" style="v" sid="LEV 14:11" />आरू शुद्ध ठरावनेवाळा याजक इना चीज क समेत उका शुद्ध होयनेवाळा मानस क योहोवा क सामने मिलापवाळा तम्बू क झोपला पर उबा करे। <verse eid="LEV 14:11" /><verse number="12" style="v" sid="LEV 14:12" />तव याजक एक गाडरा क बच्चा लीन दोषबलि क करता उका आरू लोज भर तेल क सामने लाया, आरू इना दुयु क हालावने क भेंट क करता योहोवा क सामने हालाया; <verse eid="LEV 14:12" /><verse number="13" style="v" sid="LEV 14:13" />आरू चा उका गाडरा क बच्चा क उका जागा मा जा चा पापबलि आरू होमबलि पशु क बलिदान कर्‍या करसु, मतलब चुकलास्थान मा बलिदान करे; काहकी जोसा पापबलि याजक क निज भाग होसे जोसाज दोषबलि भी उका जियोन भाग ठरसे; चो परमपवित्र छे। <verse eid="LEV 14:13" /><verse number="14" style="v" sid="LEV 14:14" />तव याजक दोषबलि क लुहूय मा सी काहय लीन शुद्ध ठरावनेवाळा क डाखर्‍या कान क मुनका पर, आरू ओकान डाखर्‍या हाथ आरू डाखर्‍या पाय क आंगठा पर लाया। <verse eid="LEV 14:14" /><verse number="15" style="v" sid="LEV 14:15" />तव याजक उका लोज भर तेल मा सी कहाय आपना जेवड़ा हाथ क थोवती पर न्हाखे, <verse eid="LEV 14:15" /><verse number="16" style="v" sid="LEV 14:16" />आरू याजक आपना डाखर्‍या हाथ क आंगवी क आपनी जेवड़ी थोवती परली तेल मा डुबाड़ीन उका तेल मा सी काहय आपनी आंगवी करीन योहोवा क सामने सात वार छिड़के। <verse eid="LEV 14:16" /><verse number="17" style="v" sid="LEV 14:17" />आरू जो तेल उकान थोवती पर रय जासे याजक ओकामा सी काहय शुद्ध होयनेवाळा क डाखर्‍या कान क मुनका पर आरू ओकान डाखर्‍या हाथ आरू डाखर्‍या पाय क आंगठा पर दोषबलि लीन लुहूय क ऊपर लागाड्या; <verse eid="LEV 14:17" /><verse number="18" style="v" sid="LEV 14:18" />आरू जो तेल याजक क थोवती पर रय जाए ओकान चो शुद्ध होयनेवाळा क मुनका न्हाख दे। आरू याजक ओकान करता योहोवा क सामने पश्चाताप करे। <verse eid="LEV 14:18" /><verse number="19" style="v" sid="LEV 14:19" />याजक पापबलि क भी चढ़ावीन करता जा आपनी अशुद्धता सी शुद्ध होयनेवाळा पशु क बलिदान करीन: <verse eid="LEV 14:19" /><verse number="20" style="v" sid="LEV 14:20" />अन्नबलि समेत वेदी पर चढ़ाया: आरू याजक ओकान करता पश्चाताप करे, आरू चा शुद्ध ठरसे।<verse eid="LEV 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 14:21" />पुन कदाम चो दारिद्र होसे आरू ओतरो लावने क करता ओका जु पूंजी नी होसे, ते चा आपना पश्चाताप करावने क करता, हालावने क करता गाडरा क बच्च दोषबलि क करता, आरू तेल सी झारला एपा क एक किलो मैदा अन्नबलि करीन, आरू 300 ग्राम तेल लावे; <verse eid="LEV 14:21" /><verse number="22" style="v" sid="LEV 14:22" />आरू दुय हुली, या पेरवान दुय पीला लावे, जा चा लाय सक्या; आरू इनामा सी एक ते पापबलि क करता आरू दीसरा होमबलि क करता होसे। <verse eid="LEV 14:22" /><verse number="23" style="v" sid="LEV 14:23" />आरू आठवे दाहड़े चा इना सभां क आपना शुद्ध ठरावने क करता मिलापवळा तम्बू क झोपला पर योहोवा क सामने, याजक क जु ली आया; <verse eid="LEV 14:23" /><verse number="24" style="v" sid="LEV 14:24" />तव याजक उका लोज भर तेल आरू दोषबलि गाडरा क बच्चा क लीन हालावने क भेंट क करता योहोवा क सामने हालाया। <verse eid="LEV 14:24" /><verse number="25" style="v" sid="LEV 14:25" />ओळता दोषबलि क गाडरा क बच्चा क बलिदान कर्‍या जासे; आरू याजक ओकान लुहूय मा सी काहय लीन शुद्ध ठरावनेवाळा क डाखर्‍या कान क मुनका पर, आरू ओकान डाखर्‍या हाथ आरू डाखर्‍या पाय क आंगठा पर लागाड्या। <verse eid="LEV 14:25" /><verse number="26" style="v" sid="LEV 14:26" />ओळता याजक उका तेल मा सी काहय आपना जेवड़ा हाथ क थोवती पर न्हाखिन, <verse eid="LEV 14:26" /><verse number="27" style="v" sid="LEV 14:27" />आपना डाखर्‍या हाथ क आंगवी सी आपनी जेवड़ी थोवती पर तेल मा सी काहय योहोवा क सामने सात वार छिड़के; <verse eid="LEV 14:27" /><verse number="28" style="v" sid="LEV 14:28" />ओळता याजक आपनी थोवती पर तेल मा सी काहय शुद्ध ठरावनेवाळा क डाखर्‍या कान क मुनका पर, आरू ओकान डाखर्‍या हाथ आरू पाय क आंगठा पर, दोषबलि क लुहूय क जागा पर लागाड्या; <verse eid="LEV 14:28" /><verse number="29" style="v" sid="LEV 14:29" />आरू जो तेल याजक क थोवती पर रय जाए उका चा शुद्ध ठरावनेवाळा क करता योहोवा क सामने पश्चाताप करने क उकान मुनका पर न्हाख दे। <verse eid="LEV 14:29" /><verse number="30" style="v" sid="LEV 14:30" />तव चा पंडुक या बच्चा मा सी जो चु लाय सक्या होसे एक क चढ़ाया,<verse eid="LEV 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 14:31" />जो चिल्लोन कत्यो लाय सके, उनामा सी एक क पापबलिन करता आरू अन्नबलि समेत दीसरा क होमबलिन करता चढ़ाया; ओका रीति सी याजक शुद्ध ठरावनेवाळा क करता योहोवा क सामने पश्चाताप करे। <verse eid="LEV 14:31" /><verse number="32" style="v" sid="LEV 14:32" />जेका कोढ़ क व्‍याधि होई होसे, आरू ओकान ओतरी पूंजी नी होसे कि चा शुद्ध ठरावनेवाळा क करता योहोवा क सामने पश्चाताप करने क ओकान मुनका पर न्हाख दे।<verse eid="LEV 14:32" /></para>
  <para style="s">भवन क कोढ़</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 14:33" />ओळता योहोवा मूसु आरू हारून सी कयो, <verse eid="LEV 14:33" /><verse number="34" style="v" sid="LEV 14:34" />“जव तुमु लोगहन कनान देश मा पुगु, जेका हाव तुमरी निज धरती होयने क करता तुमुक आपता छे, उका टेमे कदाम हाव कोढ़ क दाग तुमरा हक क काहना घर मा देखाडो, <verse eid="LEV 14:34" /><verse number="35" style="v" sid="LEV 14:35" />ते जेका चो घर होसे चा आवीन याजक क कोय दे कि मखे ओसो देखाड़ पड़ता छे कि घर मा मानु काहनो दाग छे। <verse eid="LEV 14:35" /><verse number="36" style="v" sid="LEV 14:36" />तव याजक आदेश देदो कि उका घर मा दाग देखने क करता म्हार जाने क पेहेल उका खाली करो, के ओसो नी होय कि जो काहय घर मा होसे चो सब अशुद्ध ठरसे; आरू पछव याजक घर देखने क करता माहयता जाए। <verse eid="LEV 14:36" /><verse number="37" style="v" sid="LEV 14:37" />तव चो उकाह दाग क देखे; आरू कदाम ची दाग घर क भितड़ा पर निळ्ळा-निळ्ळा या लाल लाल मानु कुरलो ओसो लकीरे क रूप मा होसे, आरू या लकीरे भितड़ा मा उंडी देखाय पड़ती होसे, <verse eid="LEV 14:37" /><verse number="38" style="v" sid="LEV 14:38" />ते याजक घर सी बाहरते झोपला पर जाईन घर क सात दाहड़े तक बन्द कर राखे। <verse eid="LEV 14:38" /><verse number="39" style="v" sid="LEV 14:39" />आरू सातवे दाहड़े याजक देखे; आरू कदाम चो दाग घर क भितड़ा पर पसरी गई होसे, <verse eid="LEV 14:39" /><verse number="40" style="v" sid="LEV 14:40" />आरू चा घर सी बाहरते काहना अशुद्ध स्थान मा न्हाख दे; <verse eid="LEV 14:40" /><verse number="41" style="v" sid="LEV 14:41" />आरू चा घर क माहयता चार तरफ खुरचवाए, आरू ची खुरचन क धुवा नगर सी बाहरते काहना स्थान मा न्हाखे जासे; <verse eid="LEV 14:41" /><verse number="42" style="v" sid="LEV 14:42" />आरू उना दगड़ा क जागा मा आरू दीसरा दगड़ा लीन लगाड़े आरू त्या ताजा गारा लीन घरन जुड़ाई करे।<verse eid="LEV 14:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LEV 14:43" />“कदाम दगड़ा क निकाळने आरू घर क खुरचने आरू गारा जुड़ाई आरू लिपायन बाद चा दाग ओळता घर मा फुट निकळे, <verse eid="LEV 14:43" /><verse number="44" style="v" sid="LEV 14:44" />ते याजक आवीन देख; आरू कदाम ची दाग घर मा पसरी गई होसे, ते चा जान लेवु कि घर मा गलति कोढ़ छे; चो अशुद्ध छे। <verse eid="LEV 14:44" /><verse number="45" style="v" sid="LEV 14:45" />आरू चा सब गारे समेत दगड़ा, लाकड़ा आरू घर क खोंदाड़ीन पड़ दे; आरू उना सब चीज क उठावीन नगर सी बाहरते काहना अशुद्ध जागा पर न्हखड़ दे। <verse eid="LEV 14:45" /><verse number="46" style="v" sid="LEV 14:46" />आरू जव तक चो घर बन्द रये आरू कदाम कुई उका मा जाए ते चे सांतो तक रये; <verse eid="LEV 14:46" /><verse number="47" style="v" sid="LEV 14:47" />आरू जो कुई उका घर मा सुवे चो आपना छिंदरा क धुवे; आरू जु कुई उका घर मा खानो खादा चु भी आपना छिंदरा धवे।<verse eid="LEV 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LEV 14:48" />“पुन कदाम पुजारो आवीन देखे कि जव सी घर लेसला गोया छे तव सी उकामा दाग नी पसरे छे, ते यो जानीन कि ची दाग सेठी होय गोय छे, घर क शुद्ध ठराया। <verse eid="LEV 14:48" /><verse number="49" style="v" sid="LEV 14:49" />आरू उका घर क चुखलो करने क करता दुय चिल्ला, देवदारू क लाकड़ी, लाल रंग क छिंदरा आरू जूफा लाया, <verse eid="LEV 14:49" /><verse number="50" style="v" sid="LEV 14:50" />आरू एक चिल्लो वोहयतो वोहयता पाणीन ऊपर धुळान ठिकरा मा बलिदान करे, <verse eid="LEV 14:50" /><verse number="51" style="v" sid="LEV 14:51" />तव चो देवदारू क लाकड़ी, लाल रंग क छिंदरा आरू जूफा आरू जीवता चिल्ला इना सभा क लीन बलिदान करला चिल्ला क लुहूय मा आरू उहवता पाणी मा बुड़ाळ देदा, आरू उका घर पर सात वार छिड़क्या। <verse eid="LEV 14:51" /><verse number="52" style="v" sid="LEV 14:52" />ओका प्रकार चा चिल्लो लुहूय, आरू वोहयतो पाणी, आरू जीवता चिल्ला, आरू देवदारू क लाकड़ी, आरू जूफा आरू लाल रंग क छिंदरा क झोपला क घर क चुखलो करे; <verse eid="LEV 14:52" /><verse number="53" style="v" sid="LEV 14:53" />तव चा जीवता चिल्ला क नगर सी बाहरता मैदान मा छुड़ देदा; ओका रीति सी चो घर क करता पश्चाताप करे, तव चो शुद्ध ठरसे।”<verse eid="LEV 14:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="LEV 14:54" />सब भाँति क कोढ़ क दाग, आरू सेंहुए, <verse eid="LEV 14:54" /><verse number="55" style="v" sid="LEV 14:55" />आरू छिंदरा, आरू घर क कोढ़ <verse eid="LEV 14:55" /><verse number="56" style="v" sid="LEV 14:56" />आरू सूजलो, आरू खुलसा, आरू दाग क विषय मा, <verse eid="LEV 14:56" /><verse number="57" style="v" sid="LEV 14:57" />शुद्ध आरू अशुद्ध ठरने क शिक्षा आपनेक व्यवस्था यी छे। सब प्रकार क कोढ़ क नियम यी छे।<verse eid="LEV 14:57" /></para>
  <chapter eid="LEV 14" />
  <chapter number="15" style="c" sid="LEV 15" />
  <para style="s">शरीर क अशुद्ध स्राव</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 15:1" />ओळतेन योहोवा मूसु आरू हारून सी कोयु, <verse eid="LEV 15:1" /><verse number="2" style="v" sid="LEV 15:2" />“इस्राएलिया सी कयु कि जेका जेका ओदमीन सफेद पानी जातो होसे, ते चो प्रमेह कारण अशुद्ध ठरसे। <verse eid="LEV 15:2" /><verse number="3" style="v" sid="LEV 15:3" />चो चाहे वोहयतो रये, चाहे वोहयनु बन्द भी होसे, तेभी उकान अशुद्धता बनी रवसे। <verse eid="LEV 15:3" /><verse number="4" style="v" sid="LEV 15:4" />जेकान प्रमेह होसे चो जेका जेका खाटला पर लुटे चु अशुद्ध ठरसे, आरू जेका जेका चीज पर चु बठे भीत्यो अशुद्ध ठरसे। <verse eid="LEV 15:4" /><verse number="5" style="v" sid="LEV 15:5" />आरू जु कुई हेका खाटला क हाथ लागाड़े त्यो आपसा छिंदरा धुवीन पाणी सी उंगव्या करे, आरू सांतो तक विटळ रये। <verse eid="LEV 15:5" /><verse number="6" style="v" sid="LEV 15:6" />आरू जेको प्रमेह होय आरू चा जीन चीज पर बठला छे, उका पर जा कुई बठला चा आपना छिंदरा क धुवीन पाणी सी उंगव्या करे, आरू सांजु तक अशुद्ध ठरला रये। <verse eid="LEV 15:6" /><verse number="7" style="v" sid="LEV 15:7" />आरू जेकान प्रमेह होय उका सी जु कुई हाथ लागाड़े जासे चा आपना छिंदरा क धुवीन पाणी सी उंगव्या करे आरू सांतो लग विटळ रये। <verse eid="LEV 15:7" /><verse number="8" style="v" sid="LEV 15:8" />आरू जेका प्रमेह होय कदाम चा काहना शुद्ध छिंदरा क धुवीन पाणी सी उंगव्या करे, आरू सांतो तक विटळ रये। <verse eid="LEV 15:8" /><verse number="9" style="v" sid="LEV 15:9" />आरू जेका न प्रमेह होय ची सवारी क जेका चीज पर बोठ्या चो विटळ ठरे। <verse eid="LEV 15:9" /><verse number="10" style="v" sid="LEV 15:10" />आरू जु कुई काहनी चीज क जो उकान नेड़ा रया होसे हाथ लागाड़े, चो सांते तक अशुद्ध रये; आरू जो कुई ओसी काहनी चीज क उठावे चु आपना छिंदरा क धुवीन पाणी सी उंगव्या करे, आरू सांतो लग विटळ रये। <verse eid="LEV 15:10" /><verse number="11" style="v" sid="LEV 15:11" />आरू जेका क प्रमेह होय चु जा काहना क बिना धुवीन हाथ लागाड़े चु आपना छिंदरा क धुवीन पाणी सी उंगव्या करे, आरू सांतो लग विटळ रये। <verse eid="LEV 15:11" /><verse number="12" style="v" sid="LEV 15:12" />आरू जेका क प्रमेह होय चो धुवान जेका काहना पात्रा क हाथ लागाड़े तेनाक तुड़ न्हाख्या जासे, आरू काठ क सब प्रकार क पात्रा पाणी सी धुव्या जासे।<verse eid="LEV 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 15:13" />“ओळता जेका क प्रमेह होय तेनाक जव आपना रोग सी आरगाय होय जाय, तव सी शुद्ध ठरने क सात दाहड़ा गिन लेवु, आरू उनाक वीतने पर आपना छिंदरा क धुवीन वोहयता पाणी सी उंगव्या करे; तव चो शुद्ध ठरसे। <verse eid="LEV 15:13" /><verse number="14" style="v" sid="LEV 15:14" />आरू आठवे दाहड़े ची दुय हुली या पेरवान दुय पीला लीन मिलापवाळा तम्बू क झोपला पर योहोवा क सामने जाईन हेका पुजारा क आपे। <verse eid="LEV 15:14" /><verse number="15" style="v" sid="LEV 15:15" />तव याजक उना मा सी एक क पापबलि, आरू दीसरा क होमबलि क करता भेंट चढ़ाया; आरू याजक उकान करता उकान प्रमेह क कारण योहोवा क सामने पश्चाताप करे।<verse eid="LEV 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 15:16" />“ओळता कदाम काहना मानस क वीर्य स्खलित होय जासे, ते चा आपना सब शरीर क पाणी सी धुवे, आरू सांतो लग विटळ रये। <verse eid="LEV 15:16" /><verse number="17" style="v" sid="LEV 15:17" />आरू जेका काहना छिंदरा या चामड़ा पर चा वीर्य पड़े तेनाक पाणी सी धुव्या जासे, आरू सांजु तक विटळ रये। <verse eid="LEV 15:17" /><verse number="18" style="v" sid="LEV 15:18" />जव कुई मानुस बायर सी सहवास करे, ते चा दुयु पाणी सी उंगव्या करे, आरू सांतो लग विटळ रये।<verse eid="LEV 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 15:19" />“ओळता जव कुई बायर‌ मासिकधरम रये, ते चो सात दाहड़े तक अशुद्ध ठरलो रये, आरू जु कुई ओका हाथ लागाड़े त्यो सांतो तक विटळ रये। <verse eid="LEV 15:19" /><verse number="20" style="v" sid="LEV 15:20" />आरू जव तक चो अशुद्ध रये तव तक जेका जेका चीज पर चा लुटे, आरू जेका जेका चीज पर बोठे चा सब विटळ ठरसे। <verse eid="LEV 15:20" /><verse number="21" style="v" sid="LEV 15:21" />आरू जु कुई ओकान खाटला क हाथ लागाड़े चु आपना छिंदरा धुवीन पाणी सी उंगव्या करे, आरू सांतो तक विटळ रये। <verse eid="LEV 15:21" /><verse number="22" style="v" sid="LEV 15:22" />आरू जु कुई काहनी चीज क हाथ लागाड़े जेका पर ची बोठी होसे चा आपना छिंदरा धुवीन पाणी सी उंगव्या करे, आरू सांतो तक विटळ रये। <verse eid="LEV 15:22" /><verse number="23" style="v" sid="LEV 15:23" />आरू कदाम खाटलो या दीसरो काहना चीज पर जेका पर ची बोठी होसे हाथ लागाड़नेन टेमे ओकान रुधिर लागाड़ होसे, ते सुनेहरो सांतो तक विटळ रये। <verse eid="LEV 15:23" /><verse number="24" style="v" sid="LEV 15:24" />आरू कदाम कुई मानुस उका सी प्रसंग करे, आरू ओकान रुधिर ओकाह लाग जाए, ते चु मानुस सात दाहडे तक अशुद्ध रये, आरू जेका जेका खाटला पर चु लुट्यु चा सब विटळ ठरसे।<verse eid="LEV 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 15:25" />“ओळता कदाम काहनी बायरक आपना नावनीन टेम सी जादा दाहड़ा तक लुहूय वोहयतो रवे, या उका नेमला टेम सी जास्ती टेमे तक मासिकधर्म रवे, ते जव तक चो ओसी दशा मा रवे तव तक चो विटळ रये। <verse eid="LEV 15:25" /><verse number="26" style="v" sid="LEV 15:26" />उकान मासिक धर्म रवनेक सब दाहड़ा मा जेका जेका खाटला पर चो लुटे चा सब उकान मासिक धर्मान खाटलान समान ठरसे; आरू जेकी चीज पर चा बोठे चा भी उकान मासिक धर्म रयनेक दाहड़ान सारकी विटळ रये। <verse eid="LEV 15:26" /><verse number="27" style="v" sid="LEV 15:27" />आरू जु कुई उना चीजक हाथ लागाड़े चो विटळ ठरसे, एरकरता चो आपना छिंदरा क धुवीन पानी सी उंगव्या करे, आरू सांतो तक विटळ रवे। <verse eid="LEV 15:27" /><verse number="28" style="v" sid="LEV 15:28" />पुन जव ची बायर आपना मासिक धर्म सी चुखी हुय जासे, तव सी चा सात दाहड़ा गिन ले, आरू उना दाहड़ाक जाने पर ची चुखी हुसे। <verse eid="LEV 15:28" /><verse number="29" style="v" sid="LEV 15:29" />पछा आठवे दाहड़े चा दुय पंडुक या कबुतरा क दुय पीला लिन मिलापवाळा तम्बू क झोपला पर पुजारा जुळ जाय। <verse eid="LEV 15:29" /><verse number="30" style="v" sid="LEV 15:30" />तव याजक एक क पापबलि आरू दिसरान होमबलिक करता चढ़ाया; आरू याजक करता मासिक धर्मान विटळ हुयनेन कारण यहोवान सामने पछतावु करे।<verse eid="LEV 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 15:31" />“ओका गत तुमु इस्राएलियाक उनाक विटळ हुयने सी अलग मेक्या करे, का ओसो नी होए कि चा योहोवाक निवास क जा उकान वीचमा छे अशुद्ध करीन आपनी विटुळ हुयनेन कारण मर जाय।”<verse eid="LEV 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 15:32" />जेकान प्रमेह होय आरू जा मानसे वीर्य स्खलित होयने सी विटळ रये; <verse eid="LEV 15:32" /><verse number="33" style="v" sid="LEV 15:33" />आरू जी बायर मासिक धर्म सी हय; आरू काय मानसे काय बायर अशुद्ध बायर सी प्रसंग सी करे, इना सभा क करता यी नियम छे।<verse eid="LEV 15:33" /></para>
  <chapter eid="LEV 15" />
  <chapter number="16" style="c" sid="LEV 16" />
  <para style="s">पश्चातापन दाहड़ा</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 16:1" />जव हारून न दुय पोर्‍या योहोवान सामने जाईन मर गीया, हेको बाद यहोवा मूसा सी वातु कर्यो; <verse eid="LEV 16:1" /><verse number="2" style="v" sid="LEV 16:2" />आरू यहोवा मूसा सी कयो, थारा भाईस हारून सी कय कि पेटारा न ऊपर पश्चातापवाळा ढाकनान अगोळ, वीचमाहायला परदान माहायता, चुखला जागा मा हर टेमे नी प्रवेश करे, नी ते मर जासे; काहकी हाव पश्चातापवाळा ढाकनेक ऊपर बादल मा दिखाई देसे। <verse eid="LEV 16:2" /><verse number="3" style="v" sid="LEV 16:3" />जव हारून चुखलास्थान मा प्रवेश करे तव ओका रीति सी प्रवेश करे, मतलब पापबलिन करता एक केवड़ाक आरू होमबलिन करता एक गाडराक लीन आया। <verse eid="LEV 16:3" /><verse number="4" style="v" sid="LEV 16:4" />ची सनीन छिंदराक चुखलो चोगला, आरू आपना डील परला छिंदरान चड्डी पेहरीन, आरू सनन छिंदराक कटिबन्द, आरू सनीक छिंदरान पागड़ी भी पाणी सी ऊंगव्या करीन हेका पेहरे। <verse eid="LEV 16:4" /><verse number="5" style="v" sid="LEV 16:5" />पछा चा इस्राएलियान मण्डलिन जु सी पापबलिन करता दुय बुकड़ा आरू होमबलिन करता एक गाडरो लेदा। <verse eid="LEV 16:5" /><verse number="6" style="v" sid="LEV 16:6" />तोत्यार हारून आपसा पापोन बादा चोड़ावसे एने आपसा ओळी आपसा घोराना जुगू पोसतावू कोरसे। <verse eid="LEV 16:6" /><verse number="7" style="v" sid="LEV 16:7" />ओळतेन हारून दुय बुकड़ा लीन भोगवानो ओगोव मिलापवावा तम्बू पोर उबू कोरसे। <verse eid="LEV 16:7" /><verse number="8" style="v" sid="LEV 16:8" />हारून एनू दुयु बुकड़ा जुगु चि़ट्ठी नाखसे। एक योहोवा भोगवान जुगु दिसरी ओजाजेल देवो जुगु। <verse eid="LEV 16:8" /><verse number="9" style="v" sid="LEV 16:9" />आरू जिना बुकड़ पोर योहोवा भोगवानोन चिट्ठी निकळे तिनाक हारून पापोन बादा जुगु चोड़ावसे। <verse eid="LEV 16:9" /><verse number="10" style="v" sid="LEV 16:10" />पुन जिना बुकड़ा पोर ओजाजेलो जुगु चिट्ठी निकळे चो योहोवा भोगवानो ओगोळ जिवत्लो उबो कोरसे की तेरे पोर पोसतावू कोरे आरू तिनाक उजाड़ी मुलुक मा ओजाजेलोन जा मुकली देय तोसे। <verse eid="LEV 16:10" /><verse number="11" style="v" sid="LEV 16:11" />हारून तिना पापोन बादान गाडरा काजे जो हेरेत् जुगु होयसे चो धोड़े ली आवे , आरू तिनाक बादा चोड़ावीन आपसा आरू आपसा घोराना जुगु पोसतावू कोरे तोसे। <verse eid="LEV 16:11" /><verse number="12" style="v" sid="LEV 16:12" />आरू जो बेदी योहोवा भोगवानो ओगोव छे तेर पोरून धोपत्ला कुयला सी भोरला धुपोन टाहरा काजे लीन, आरू आपसा दुयु मुठो मा कुटला गोंदायन्या धुपो सी भोरीन, इचमा वावा पोरदा धोड़े ली आवीन <verse eid="LEV 16:12" /><verse number="13" style="v" sid="LEV 16:13" />तीना धुप काजे योहोवा भोगवानो ओगोव आगठा मा मेकजी, जेरेसी धुपोन धुवाडू गोवान चिट्ठी पोर पोसतावान ढाकना उपोर छावाय जाय, नी ते हुयो मोर जासे; <verse eid="LEV 16:13" /><verse number="14" style="v" sid="LEV 16:14" />तोत्यार हुयो गाडरान लुहुय मा गोथो इतरोक लुहुय लीन उगेनलेछ्ये पोसतावान ढाकनान उपोर आपसी आंगवी सी छाट देसे, आरू ओली तेना लुहुय मा गोथो इतरोक आपसी आंगवी सी तेना ढाकना ओगोव वी सात कावा छाट देजी। <verse eid="LEV 16:14" /><verse number="15" style="v" sid="LEV 16:15" />ओळी हारून मानसोन कोरता पापोन बादान बुकड़ाक चोड़ावसे चो हेरा लुहयोन इचमा वावा पोरदान धोड़े ली आवे, आरू जिने रिते बुकड़ान लुहयो पुठी कोर्यू तोसुत् कोरसे, तिना लुहयोक गिनोन पाटड़ी उपोर एने हेरे ओगोव छाट देसे। <verse eid="LEV 16:15" /><verse number="16" style="v" sid="LEV 16:16" />आरू हुयो इसराएलीन भाति भातिन विटोळ, आरू गुना, आरू हेंदरा आखा पापोन कोरता चुखला जागा जुगु पोसतावू कोरसे; आरू मिलापवावा तम्बू जो हेरे भेव हेनाक भाति भातिन विटोवोन इचमा रोवे हेरे जुगू वी हुयो तोसोत् कोरे। <verse eid="LEV 16:16" /><verse number="17" style="v" sid="LEV 16:17" />जोत्यार हारून पोसतावा जुगु चुखला जागाम भोरायसे आरू जोत्यार लोगुन हुयू आपसा, आपसा घोरल्या एने आखा इसराएली मानसे जुगु पोसतावू कोरीन खोयड़े नी निकवे, ती लोगुन मिलाप वावा तम्बू मा कुदु वी मानुस उबु नी रोवे। <verse eid="LEV 16:17" /><verse number="18" style="v" sid="LEV 16:18" />हुयु भोगवानो ओगोव वावी वेदीन चा खोयड़े आवसे आरू हेरे जुगु पोसतावू कोरसे। हुयु गाडरा एने बुकड़ान थुड़ोक लुहुय लीन वेदीन च्यारू मेर सिंगड़ा पोर लुहयोक लागाड़से। <verse eid="LEV 16:18" /><verse number="19" style="v" sid="LEV 16:19" />आरू उना लुहुय मा सी आंगळीये करीन सात वार लुहुय छाटसे। ओस कोरीन हुयु इसराएली मानसोन विटोळ गोथु वारु एने चुखा झोन कोरसे।<verse eid="LEV 16:19" /></para>
  <para style="s">बलिन बकड़ो</para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 16:20" />जोत्यार हुयो चुखलाजागान आरू मिलापवावा तम्बू आरू बेदी जुगु पछतावो कर लेये, ती जिवतला बुकड़ाक ओगा ली आवजु; <verse eid="LEV 16:20" /><verse number="21" style="v" sid="LEV 16:21" />हुयो आपसु दुयु हात जिवतेला बुकड़ान मुनका पोर मेसे, आरू इसरारली सोमाजोन आखा भुण्डला काम, आरू आखा पापन क मान लेये। हुयो हेनुक बुकड़ान बुनका पोर नाख देसे, आरू तिना मानसोन हाते कोरीन, जु इना काम जुगु नेवाड़लु होयसे, बुकड़ाक उजाड़ी जागा मुकली छुड़ देसे। <verse eid="LEV 16:21" /><verse number="22" style="v" sid="LEV 16:22" />बुकड़ु हेन्दरा आखा भुन्डला कामोक आपसे उपोर हुचलिन सुनसान जागा मा ली जासे। चो मानुस बुकड़ाक उजाड़ी मुलुकोम छुड़ देसे। <verse eid="LEV 16:22" /><verse number="23" style="v" sid="LEV 16:23" />तोत्यार हारून मिलापवावा तम्बू मा आवसे। हुयो तेनु आखा सुतिन छिन्दराक निकावीन चां मेक एसे जे हुयो चुखला जागाम भोरायते टेमे पेहलु होतु। <verse eid="LEV 16:23" /><verse number="24" style="v" sid="LEV 16:24" />हुयो चुखला जागाम पानीम उंगेवसे आरू आपसा छिन्दरा पेहरीन खोयड़े आवसे। तोत्यार हुयो आपसे एने मानसोन आगठान बादा चोड़ावसे आरू आपसे एने मानसो जुगु पोच्छाताप कोरसे। <verse eid="LEV 16:24" /><verse number="25" style="v" sid="LEV 16:25" />हुयो पापोन बादान वावा ढुरोन चोरबी बेदी पोर धोपाड़से। <verse eid="LEV 16:25" /><verse number="26" style="v" sid="LEV 16:26" />ओजाजेलोन चा बुकड़ाक ली जानेवावु मानुस आपसा छिन्दरा छुवसे आरू पानीम उंगेवसे। ओळतेनुत् चु पोड़ाव मा माहाय भोराय सोकसे। <verse eid="LEV 16:26" /><verse number="27" style="v" sid="LEV 16:27" />पाप बादान वाछड़ो एने पाप बादान बुकड़ो, जेरो लुहुय पोच्छाताप जुगु चुखला जागाम लावला होता, पोड़ावोन खोयड़े ली आवसे आरू चा हेन्दरा खालड़ा, मास आरू गुबोर आगठाम धोपाड़ देसे। <verse eid="LEV 16:27" /><verse number="28" style="v" sid="LEV 16:28" />हेनुक धोपाड़नेवावु ओदमी आपसा छिन्दरा धुवसे आरू पानीम उंगेवसे। ओळतेनुत चु पोड़ाव मा भोराय सोकसे।<verse eid="LEV 16:28" /></para>
  <para style="s">पोच्‌छातापोन दाहड़ाक माननो</para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 16:29" />तुमु मानसो जुगु यी जोलोमोन रिती होयसे कि सातवे मोहनेन दोसवे दाहड़े तुमु आपसा-आपसा जिव काजे उपास राखिन दुख देजु, तेने दाहड़े कुदु वी मानुस चाहाय चु यांत् वावु होय तेने तुमरे विच मा रोवने वावु होय, काम नी कोरनो जुवे; <verse eid="LEV 16:29" /><verse number="30" style="v" sid="LEV 16:30" />काहकि इने दाहड़े तुमरे जुगु, तुमुक चुखा कोरने कोरिन पोसतावु कोर्यु जासे। तुमु योहोवा ओगोव आपसा आखा पापो सी चुखा होय जासु। <verse eid="LEV 16:30" /><verse number="31" style="v" sid="LEV 16:31" />यो तुमरे जुगु बेसकु आरामोन दाहड़ु छे। तुमु आपसा काजे उपासोन लारे दु:ख देजो। यी जलोमन रिति छे। <verse eid="LEV 16:31" /><verse number="32" style="v" sid="LEV 16:32" />आरू जु पुजारू, आपसा बासोन जागा पोर पुजारान जागा जुगु अभिषेक आरू चुखो कोरनेन रिति कोरे, चु पुजारू पोसतावु कोर्या कोरे, एने चु चुखला सुतीन छिन्दरा पेहरिया कोरोसे। <verse eid="LEV 16:32" /><verse number="33" style="v" sid="LEV 16:33" />होयु बेसका चुखला जागा, मिलापवावा तम्बू आरू बेदी जुगु पोसतावु कोरसे। हुयो पुजारा एने आखा मोन्डळीन मानसो जुगु वी पछतावो करे। <verse eid="LEV 16:33" /><verse number="34" style="v" sid="LEV 16:34" />यी तुमरे जोलोम जुगु रिति छे कि इसराएली मानसे आखा पापोन कोरता हेन्दरे जुगु सालोम एक वार पोसतावु कोरे। जोसु योहोवा मुसाक हुकुम आपलु होतु, हारून वी तोसुत कोर्यु।<verse eid="LEV 16:34" /></para>
  <chapter eid="LEV 16" />
  <chapter number="17" style="c" sid="LEV 17" />
  <para style="s">लुहू क पवित्रता</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 17:1" />पछु योहोवा भगवान मूसा सी कयो, <verse eid="LEV 17:1" /><verse number="2" style="v" sid="LEV 17:2" />“हारून पोर्‍या सी आरू सब इस्राएलिया सी कयो कि योहोवा भगवान यी हुकुम आपली छे: <verse eid="LEV 17:2" /><verse number="3" style="v" sid="LEV 17:3" />इस्राएलिया क घराना मा सी कुई मानुस होय जु बुयल या गाडरा क बच्चा, या बुकड़ी क, चाहे छावनी मा चाहे छावनी सी बाहरते घात करीन <verse eid="LEV 17:3" /><verse number="4" style="v" sid="LEV 17:4" />मिलापवाळा तम्बू क झोपला पर, योहोवा भगवान क रयनेन सामने योहोवा क चढ़ावनेन बाहना सी नी ली जाय, ते उका मानसक लुहूय वयावने क दोष लागसे; आरू चु मानुस जु लुहूय वयावने वाळा ठरसे, चा आपना लोगहन क वीच मा सी खतम कर्‍यो जाय। <verse eid="LEV 17:4" /><verse number="5" style="v" sid="LEV 17:5" />इनी विधि न यो कारण छे कि इस्राएली आपसो बलिदान जिनाख त्यो खुल्ला मैदान मा वध करता छे, चा हेका मिलापवाळा तम्बू क झोपला पर याजक क जु, योहोवाक करता ली जाईन उकान करता मेलबलि करीन बलिदान कर्‍या करे; <verse eid="LEV 17:5" /><verse number="6" style="v" sid="LEV 17:6" />आरू याजक लुहूय क मिलापवाळा तम्बू क झोपला पर योहोवा क वेदी क ऊपर छिड़क्या, आरू चरबा क उकान सुखदायक सुगन्ध क करता धोपाड्या। <verse eid="LEV 17:6" /><verse number="7" style="v" sid="LEV 17:7" />चा जा बुकड़ा पुजणीयो हुयी बी व्यभिचार करे, त्यो आपना बलिपशु क ओकान करता बलिदान नी करे। तुमरी पीढ़ीया क करता यो हमेशा क विधि होसे।<verse eid="LEV 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 17:8" />“तु उकाह कयो कि इस्राएल क घराना क लोगहन मा सी या उनाक वीच रयनेवाळा परदेशिया मा सी कुई मानुस काह नी होय जा होमबलि या मेलबलि चढ़ाया, <verse eid="LEV 17:8" /><verse number="9" style="v" sid="LEV 17:9" />आरू उकाह मिलापवाळा तम्बू क झोपला पर योहोवा क करता चढ़ावने नी लावे; चु मानुस आपना लोगहन मा सी खतम कर्‍या जासे।<verse eid="LEV 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 17:10" />“पछा इस्राएल क घराना क लोगहन मा सी या उनाक वीच रयनेवाळा परदेशिया मा सी कुई मानुस काह नी होय जो काहना प्रकार लुहूय खाय, हाव उकान लुहूय खानेवाळा क विरूध होईन उकाह उकान लोगहन क वीच मा सी खतम कर न्हाखिस। <verse eid="LEV 17:10" /><verse number="11" style="v" sid="LEV 17:11" />काहकी शरिर क जीव लुहूय मा रवतु छे; आरू उकान हाव तुमु लोगहन क वेदी पर चढ़ावने करता आपला छे कि तुमरा जीवन करता लुहूय करता पश्चाताप कर्‍यो जासे; काहकी जीव क करता लुहूय सी पश्चाताप हुये। <verse eid="LEV 17:11" /><verse number="12" style="v" sid="LEV 17:12" />ओका कारण हाव इस्राएलिया सी कयता छे कि तुमु मा सी कुई जीव लुहूय नी खाय, आरू जु परदेशी तुमरे वीच मा रवता छे चु भी लुहूय कभी नी खाय।<verse eid="LEV 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 17:13" />“इस्राएलिया मा सी या उकान वीच रयनेवाळा परदेशिया मा सी कुई मानुस काह नी होय जु अहेर करिन खाने क योग्य पशु या चिल्ला क धर्‍या; चा ओकान लुहूय क न्हाखिन धुवा सी ढाक देदा। <verse eid="LEV 17:13" /><verse number="14" style="v" sid="LEV 17:14" />काहकी शरिर क जीव जु छे चु उकान लुहूज छे जो उकान जीव क साथे एक छे; ओका करता हाव इस्राएलिया सी कयता छे कि काहना प्रकारन क जनावर क लुहूय क तुमु नी खानु, काहकी सब जनावर क जीव उकान लुहूय छे; जु कुई ओकान खासे चु खतम कर्‍या जासे। <verse eid="LEV 17:14" /><verse number="15" style="v" sid="LEV 17:15" />आरू चाहे चु देशी होय या परदेशी होय, जु कुई काहना लोथ या फाड़ला पशु का मांस खाय चा आपना छिंदरा क धुवीन पाणी सी उंगवीन करे, आरू सांजु तक अशुद्ध रवे; तव चो शुद्ध होसे। <verse eid="LEV 17:15" /><verse number="16" style="v" sid="LEV 17:16" />कदाम चु उका नी धुवे आरू नी उंगव्या करे, ते उकाह आपना ओधोरोम क भार खुद उठावनो पड़से।”<verse eid="LEV 17:16" /></para>
  <chapter eid="LEV 17" />
  <chapter number="18" style="c" sid="LEV 18" />
  <para style="s">सहवासन वारा मा नियम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 18:1" />पछु योहोवा मूसा सी कयो, <verse eid="LEV 18:1" /><verse number="2" style="v" sid="LEV 18:2" />इस्त्राएलिया सी कयो कि हाव तुमरू परमेश्वर योहोवा छेव। <verse eid="LEV 18:2" /><verse number="3" style="v" sid="LEV 18:3" />तुमु मिस्र देशन कामन अनसारे, जेकामा तुमु रयता हता, नी करनु; आरू कनान देशम कामक अनसारे भी, जा हाव तुमुक लीन जाव, नी करनु; आरू नी ते हेनू देशन नियम पर चालनो। <verse eid="LEV 18:3" /><verse number="4" style="v" sid="LEV 18:4" />माराज नियमक मानजो, आरू म्हारीज विधिक मानता उना पर चालनु। हाव तुमरू परमेश्वर योहोवा छेव। <verse eid="LEV 18:4" /><verse number="5" style="v" sid="LEV 18:5" />एरकरता तुमु मार नियम आरू मारी विधिक उनाक हमेशा माननु; जु मानुस उनाक माने चु उकान कारन जीवतु रवसे। हाव योहोवा छेव।<verse eid="LEV 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 18:6" />तुमु मा सी कुई आपनी काहनी नाट वाळी परिवार वाळीक डिल उघाड़नेक उकान जु नी जाए। हाव योहोवा छेव। <verse eid="LEV 18:6" /><verse number="7" style="v" sid="LEV 18:7" />आपसी आईस न डिल, जो तुमरा बास न डिल छे, नी उघाड़नु; ची ते तुमरी आया छे, एरकरता तुमु उकान डिल नी उघाड़नु। <verse eid="LEV 18:7" /><verse number="8" style="v" sid="LEV 18:8" />आपनी दिसरी आयान भी डिल नी उघाड़नु; चो ते तुमरा बासनुज ते छे। <verse eid="LEV 18:8" /><verse number="9" style="v" sid="LEV 18:9" />आपनी बोहनी चाहे एकुज आयान रवे कि दिसरी आयान होसे, चाहे ची घरमा पयदा होई होसे चाहे बाहरते, उकिन डिल नी उघाड़नु। <verse eid="LEV 18:9" /><verse number="10" style="v" sid="LEV 18:10" />आपसा पोर्यान पोराय पुतनी या नातनीन भी डिल नी उघाड़नु, उकिन डिल ते मानु तुमरो छे। <verse eid="LEV 18:10" /><verse number="11" style="v" sid="LEV 18:11" />तुमरी सौतेली बोहनी जी तुमरा बास सी पयदा हुई, ची तुमरी बोहनी छे, ओका कारन उकान डिल नी उघाड़नु।<verse eid="LEV 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 18:12" />आपनी फुईन डिल नी उघाड़नु; ची ते तुमरा बासन नाट बयणी छे। <verse eid="LEV 18:12" /><verse number="13" style="v" sid="LEV 18:13" />आपनी मावसीन डिल नी उघाड़नु; काहकी ची तुमरी आयान कुटुंबन नाट वाळी छे। <verse eid="LEV 18:13" /><verse number="14" style="v" sid="LEV 18:14" />आपना काकान डिल उगाड़नु, मतलब उकान बायरक साते नी जानु; ची ते ओकान काकी छे। <verse eid="LEV 18:14" /><verse number="15" style="v" sid="LEV 18:15" />आपनी वोवड़िस डिल नी उगाड़नु; ची ते तुमरा पोर्‍याक लाड़ी छे, ओका कारण तुमू ओकान डिल नी उगाड़नु। <verse eid="LEV 18:15" /><verse number="16" style="v" sid="LEV 18:16" />आपनी भाभीन डिल नी उगाड़नु; चो ते तुमरा भाईसक डिल छे। <verse eid="LEV 18:16" /><verse number="17" style="v" sid="LEV 18:17" />एकदी बायर आरू हेकी पोरायक डिल नी उगाड़नु, आरू हेकी पुतनीक या हेकी नातनीक आपनी बायर समजीन हेकी डिल नी उगाड़नु, ची ते नाट कुटुम्ब वाळी छे; ओसो करनु महापाप छे। <verse eid="LEV 18:17" /><verse number="18" style="v" sid="LEV 18:18" />आरू आपनी बायरक भोहनीक आपनी बायर समजीन हेकी बोयंडळ नी बनावनु काहकी पेहली जीविता रयता रयता हेकी डिल भी उगाड़े।<verse eid="LEV 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 18:19" />पछु जव तक एकदी बायर आपना ऋतुन कारन अशुद्ध रया तव तक ओकान जु ओकान डिल उगाड़ने क नी जानु। <verse eid="LEV 18:19" /><verse number="20" style="v" sid="LEV 18:20" />पछा आपना भाईबन्धुक बायर सी कुकर्म करीन अशुद्ध नी होय जानु। <verse eid="LEV 18:20" /><verse number="21" style="v" sid="LEV 18:21" />आपना सन्तान मा सी काहनाक मोलेकक करता होम करीन नी चढ़ावनु, आरू नी आपना परमेश्वरक नावक विटुळ ठरावनु; हाव योहोवा छेव। <verse eid="LEV 18:21" /><verse number="22" style="v" sid="LEV 18:22" />स्त्रीगमनक रीति सी पुरूषगमन नी करनु; चो ते घिनौनो काम छे। <verse eid="LEV 18:22" /><verse number="23" style="v" sid="LEV 18:23" />एकदि जातिन पशुक साथे पशुगमन करीन अशुद्ध नी होय जानु, आरू नी एकदि बायर पशुक सामने एरकरता उभी होए के उकान साथे कुकर्म करे; यी ते उलटी वात छे।<verse eid="LEV 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 18:24" />ओसलो-ओसलो कुई भी काम करीन अशुद्ध नी होय जानु, काहकी जिन जातियाक हाव तुमरे ओगव सी जाने पर छेव चा ओसा ओसा काम करीन अशुद्ध होय गयो छे; <verse eid="LEV 18:24" /><verse number="25" style="v" sid="LEV 18:25" />आरू उकान देश भी अशुद्ध होय गयो छे, ओका कारन हाव उका पर उकान अधर्मक दण्ड आपतु छेव, आरू चा देश आपना निवासियाक उगल देतु छे। <verse eid="LEV 18:25" /><verse number="26" style="v" sid="LEV 18:26" />ओका कारण तुमु लोगहन मारी विधिया आरू नियमोक निरन्तर माननु, आरू चाहे देशी तुमरे वीचमा रयनेवाळा परदेशी होसे, तुमु मा सी एकदि भी ओसो घिनौनो काम नी करे; <verse eid="LEV 18:26" /><verse number="27" style="v" sid="LEV 18:27" />काहकी ओसो सब विनलागीया काम क उना देशन मानसे ज जो तुमरे सी पेहले रयता हुता, ओका सी चो देश विटळ हुय होय गयलो छे। <verse eid="LEV 18:27" /><verse number="28" style="v" sid="LEV 18:28" />हिमी ओसो नी होए कि जोसी रीति सी जी जाति तुमू सी पेहेल उका देश मा रयती हती ओकाह उकान उगल देदा, ओकी रीति जव तुमु ओकान अशुद्ध करू, ते चो तुमुक भी उगल देसे। <verse eid="LEV 18:28" /><verse number="29" style="v" sid="LEV 18:29" />जु कोय असो विनलाजीयो काम करे असला सब लोगहन आपसा मा सी नष्ट कर्‍या जासे। <verse eid="LEV 18:29" /><verse number="30" style="v" sid="LEV 18:30" />यो आदेश जो हाव तुमरे माननेक देदी छे उकाह तुमु माननु, आरू जो घिनौनी रीति तुमु सी पेहेल प्रचलित छे उनामा सी काहना पर नी चालनु, आरू नी उनाक कारन अशुद्ध होय जानु। हाव तुमरू परमेश्वर योहोवा भगवान छेव।<verse eid="LEV 18:30" /></para>
  <chapter eid="LEV 18" />
  <chapter number="19" style="c" sid="LEV 19" />
  <para style="s">पवित्रता आरू आचरणक नियम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 19:1" />पछु योहोवा भगवान मूसा सी कयो, <verse eid="LEV 19:1" /><verse number="2" style="v" sid="LEV 19:2" />इस्राएलियाक सब मण्डली सी कईन तुमु चुखला बोवना रयु; काहकी हाव तुमरो परमेश्वर योहोवा पवित्र छेव। <verse eid="LEV 19:2" /><verse number="3" style="v" sid="LEV 19:3" />तुमु आपनी आपनी आयाक आरू आपना आपना बासक भीख माननु, आरू मारा आरामक दाहड़ाक माननु; हाव तुमरू परमेश्वर योहोवा छेव। <verse eid="LEV 19:3" /><verse number="4" style="v" sid="LEV 19:4" />तुमु मुर्तिक तरफ नी फिरनु, आरू देवतान फुटा न्हाखिन नी बनाव लेनु; हाव तुमरू परमेश्वर योहोवा छे।<verse eid="LEV 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 19:5" />जव तुमु योहोवाक करता मेलबलि करू, तव ओसो बलिदान करनु जेका सी तुमु सी खुश होय जाऊ। <verse eid="LEV 19:5" /><verse number="6" style="v" sid="LEV 19:6" />उकान मांस बलिदानक दाहड़े आरू दिसरे दाहड़े खाए जासे, पुन तीसरे दाहड़े तक जा रय जाए चा आग्ठा मा धोपाड़ देय जासे। <verse eid="LEV 19:6" /><verse number="7" style="v" sid="LEV 19:7" />कदाम उकामा सी काहय भी तीसरे दाहड़े खाए जासे, ते यो घाड़्च्या ठरसे, आरू ग्रहण नी कर्‍या जासे, <verse eid="LEV 19:7" /><verse number="8" style="v" sid="LEV 19:8" />आरू उकान खानेवाळा योहोवाक पवित्र चीजक विटुळ ठरावता छे, एरकरता उकान आपना अधर्मक भार खुद उठावनु पड़से; आरू चो प्राणी आपना लोगहन मा सी नष्ट करे जासे।<verse eid="LEV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 19:9" />पछा तुमु आपना देश क खेत काटो तव आपना खेतक कुपरे तक पुरो नी कादनु, आरू काटला खेतक पड़ली ओसला झोठाक नी नेवाड़नु। <verse eid="LEV 19:9" /><verse number="10" style="v" sid="LEV 19:10" />आरू आपनी दाखक वाड़ीक दाना दानान तुड़ लेनु, आरू आपनी दाखक वाड़ीक झोड़ला अंगुरक नी चुटनु; हेका दाहड़े आरू परदेशी लोगहन क करता छुड़ देनु; हाव तुमरू परमेश्वर योहोवा छेव।<verse eid="LEV 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 19:11" />तुमु चुरी नी करनु, आरू एक दिसरा सी नी ते कपट करनु, आरू नी झुठ बुलनु। <verse eid="LEV 19:11" /><verse number="12" style="v" sid="LEV 19:12" />तुमु मारा नावक झुठी शपथ खाईन आपना परमेश्वरक नाव विटुळ नी करनो; हाव योहोवा छेव।<verse eid="LEV 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 19:13" />एक दिसरा पर आन्धारो नी करनु, आरू नी एक दिसराक लुट लेनु। मजदुरन मजदुरी तार जु आखी रात सोंदारे तक नी रय सके। <verse eid="LEV 19:13" /><verse number="14" style="v" sid="LEV 19:14" />बोयराक शाप नी देनु, आरू आंधवाक ओगव ठुकर राखनु; आरू आपना परमेशवरक भीख माननु; हाव योहोवा छेव।<verse eid="LEV 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 19:15" />न्याय मा कुटिलता नी करनु; आरू नी ते कंगालक पक्ष करनु आरू नी मोटला मानसक मुहय देखनु विचार करनु; एक दिसराक न्याय धर्म सी करनु। <verse eid="LEV 19:15" /><verse number="16" style="v" sid="LEV 19:16" />लुतरा बनीन आपना लोगहन मा नी फिर्‍या करनु, आरू एक दिसराक लुहुय वोहयनेन युक्ति नी बांधनु; हाव योहोवा भगवान छेव।<verse eid="LEV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 19:17" />आपना मन मा एक दिसराक प्रति खत नी मेकनु; आपने नाट घर वाळाक नक्कि डाडनु, नी ते उकान पापक भार तुखेक उठावनु पड़से। <verse eid="LEV 19:17" /><verse number="18" style="v" sid="LEV 19:18" />बदलो नी लेनु, आरू नी आपसा लोगहन सी खत राखनु, पुन एक दिसरा सी आपने समान मोंग राखनु; हाव योहोवा भगवान छेव।<verse eid="LEV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 19:19" />तुमु म्हारा नियम जलोमका मान। आपजो तमरा पाळनिया जनवार क दिसरी जातिन जनवार सी प्रजनन झुन करने देनु; आपना खेत मा दुय प्रकारक बीजा एकठा नी वेरनु; आरू झारीन आरू ऊनान मिलावट सी बोवना होया छिंदरा नी पेहरनु।<verse eid="LEV 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 19:20" />“पछी एकदी बायर दासी होसे, आरू उकान इहाव एकदा मानसक सी होई होसे, पुन चो नीते दाम सी आरू नी सेंतमेंत स्वाधीन करी गई होसे; उकासी कदाम कुई कुकर्म करे, ते उना दुय दाहड़ाक दण्ड ते जोड़े, पुन उका बायरक स्वाधीन नी होयनेक कारण चा दुयु मार नी न्हाखे जासे। <verse eid="LEV 19:20" /><verse number="21" style="v" sid="LEV 19:21" />पुन चो मानुस मिलापवाळा तम्बूक झोपला पर योहोवाक जु एक गाडरो दोषबलिक कारण ली आया। <verse eid="LEV 19:21" /><verse number="22" style="v" sid="LEV 19:22" />आरू याजक ओकान कर्‍या होया पापन कारण दोषबलिक गाडराक द्वारा ओकान करता योहोवाक सामने पश्चाताप करे; तव ओकान कर्‍या होया पापक माप कर्‍या जासे।<verse eid="LEV 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 19:23" />“पछा जव तुमु कनान देश मा पुगीन काहना प्रकारक फोव झाड़को लागाडु, ते ओकान फोव तुमरे करता मानु खतनारहित ठरला रवे; एरकरता उनामा सी काहय नी खादा जासे। <verse eid="LEV 19:23" /><verse number="24" style="v" sid="LEV 19:24" />आरू चौथा साल मा ओकान सब फोव योहोवाक स्तुति करनेक करता पवित्र ठरसे। <verse eid="LEV 19:24" /><verse number="25" style="v" sid="LEV 19:25" />तव पाचवा साल मा तुमु ओकान फोव खानु, एरकरता के उकासी तुमुक बैस फोव जोड्या; हाव तुमरा परमेश्वर योहोवा छेव।<verse eid="LEV 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 19:26" />“तुमु लुहुय लागाड़लो ओसलो मांस नी खानु। आरू नी जादु टोनु करनु, आरू नी शुभ या अशुभ मुहूर्तोक माननु। <verse eid="LEV 19:26" /><verse number="27" style="v" sid="LEV 19:27" />आपना मानुका मा घेरा मेकिन नी काडनु, आरू नी आपना गालक झोठाक काडनु। <verse eid="LEV 19:27" /><verse number="28" style="v" sid="LEV 19:28" />मरला धोड़न कारण आपना डिलक बिलकुल नी चीरनु, आरू नी उकमा छाप लागाड़नु; हाव योहोवा छेव।<verse eid="LEV 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 19:29" />“आपनी पोरायक वेश्या बनावीन विटुळ नी करनु, ओसो नी होय कि देश वेश्यागमनक कारण महापाप सी भर जासे। <verse eid="LEV 19:29" /><verse number="30" style="v" sid="LEV 19:30" />मारा आरामक दाहड़ाक मान्या करनु, आरू मारा पवित्रस्थानक डर हमेशा माननु; हाव योहोवा छेव।<verse eid="LEV 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 19:31" />“ओझाओं आरू भुतड़ा साधनेवाळाक तरफ नी फिरनु, आरू ओसोज खोज करीन उनाक अशुद्ध नी होय जानु; हाव तुमरू परमेश्वर योहोवा छेव।<verse eid="LEV 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 19:32" />“डाहला लोगहन क सामने उभरय जानु, आरू डाहयलाक आदरमान करनु, आरू परमेश्वरक डर हमेशा माननु; हाव योहोवा छेव।<verse eid="LEV 19:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 19:33" />“कदाम एकदु परदेशी तुमरा देश मा तुमरे साथे रये, ते ओकाह दु:ख नी देनु। <verse eid="LEV 19:33" /><verse number="34" style="v" sid="LEV 19:34" />जा परदेशी तुमरे साथे रये चा तुमरे करता आपना देशन समान रवसे, आरू ओकासी आपने समान मोंग राखता; काहकी तुमु भी मिस्र देश मा परदेशी हता; हाव तुमरू परमेश्वर योहोवा छेव।<verse eid="LEV 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 19:35" />“तुमु न्याय मा, आरू परिणाम मा, आरू तौल मा, आरू नाप मा कुटिलता नी करनु। <verse eid="LEV 19:35" /><verse number="36" style="v" sid="LEV 19:36" />सच्ची ताकड़ी, धर्मक बटखरे, सच्चु एपा, आरू धर्माक हीन तुमरे जु रये; हाव तुमरू चु परमेश्वर योहोवा छेव जो तुमुक मिस्र देश सी निकाळ ली आया। <verse eid="LEV 19:36" /><verse number="37" style="v" sid="LEV 19:37" />एरकरता तुमु मारी सब विधिया आरू सब नियमक मानता जाईन हमेशा पालन करू; हाव योहोवा छेव।”<verse eid="LEV 19:37" /></para>
  <chapter eid="LEV 19" />
  <chapter number="20" style="c" sid="LEV 20" />
  <para style="s">हुकुम सजा टाळनेन सजा</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 20:1" />पछु योहोवा मूसा सी कयो, <verse eid="LEV 20:1" /><verse number="2" style="v" sid="LEV 20:2" />इस्राएलिया सी कया कि इस्राएलियाक विच मा रयनेवाळा परदेशिया मा सी, एकदो काह नी होसे जी आपनी एकदी सन्तान मोलेक<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="fq" closed="false">मोलेक </char><char style="ft" closed="false">कनानी लोगहन न लारे पुजने वाळो देव</char></note> बलिदान करे, चो नक्कि माराय जासे; आरू जनता उका पर पथराव करे। <verse eid="LEV 20:2" /><verse number="3" style="v" sid="LEV 20:3" />हाव भी उका मानसक विरूद्ध होईन ओकाक उका लोगहन मा सी ओका कारण खतम करसु कि ओको आपनी सन्तान मोलेकक आपीन मार पवित्रस्थानक अशुद्ध कर्‍या, आरू मार पवित्र नावक विटुळ ठरायो। <verse eid="LEV 20:3" /><verse number="4" style="v" sid="LEV 20:4" />आरू कदाम एकदो आपनी सन्तान मोलेक बलिदान करे, आरू जनता ओकान विषय मा आनाकानी करे आरू ओकाह मार नी न्हाख्ये, <verse eid="LEV 20:4" /><verse number="5" style="v" sid="LEV 20:5" />तव ते हाव खुद ओका मानसक आरू ओकान घरानाक विरूद्ध होईन ओकान आरू जोतरा ओकान पछव होईन मोलेक साथ व्यभिचार करे उना सभाक भी उनाक लोगहनक वीच मा सी खतम करसु।<verse eid="LEV 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 20:6" />पछा जु प्राणी ओझाओ या भूतसाधनेवाळाक तरफ फिरीन, आरू उनाक पछव होईन व्यभिचारी बन्या, ते हाव प्राणीक विरूद्ध होईन ओकाक ओकान लोगहनक विच मा सी खतम कर दिस। <verse eid="LEV 20:6" /><verse number="7" style="v" sid="LEV 20:7" />एरकरता तुमु आपने आपसु पवित्र करू; आरू पवित्र बवना रयु; काहकी हाव तुमरू परमेश्वर योहोवा छे। <verse eid="LEV 20:7" /><verse number="8" style="v" sid="LEV 20:8" />आरू तुमु मार विधियाक मानजु, आरू ओकान पालन भी करनु; काहकी हाव तुमरो पवित्र करनेवाळो योहोवा छे। <verse eid="LEV 20:8" /><verse number="9" style="v" sid="LEV 20:9" />एकदो काह नी होसे जु आपना बासक या आयाक शाप आपे तिनाक नक्कि मार न्हाखे जासे; ओको आपना बासक या आयाक शाप देदा छे, ओका कारण ओकान खून ओका मुनका पर पड़से।<verse eid="LEV 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 20:10" />पछा कदाम एकदो पराई बायरक साथे व्यभिचार करे, ते जोतरी एकदी दिसरी बायरक साथे व्यभिचार करे होसे ते चो व्यभिवारी आरू ची व्यभिचारणी दुयु नक्कि मार न्हाखे जासे। <verse eid="LEV 20:10" /><verse number="11" style="v" sid="LEV 20:11" />कदाम एकदो आपनी सौतली आईस पुठी सुवे, चो आपना बासक डिल उघाड़नेवाळो ठरसे; एरकरता चा दुयु नक्कि मार न्हाखे जासे, ओकान लूहुय हेका मुनका पर पड़से। <verse eid="LEV 20:11" /><verse number="12" style="v" sid="LEV 20:12" />कदाम एकदो आपनी पतोहूक साथे सुवे, ते चा दुयु नक्कि मार न्हाखे जासे; काहकी चा उलटो काम करनेवाळा ठरसे, आरू ओकान लूहुय हेका मुनका पर पड़से। <verse eid="LEV 20:12" /><verse number="13" style="v" sid="LEV 20:13" />कदाम एकदो जेकी रीति बायर सी उनी रीति मानुस सी प्रसंग करे, ते चा दुयु घिनौनो काम करनेवाळा हुयसे; ओका कारण चा नक्कि मार न्हाखे जासे, ओकान लूहुय हेका मुनका पर पड़से। <verse eid="LEV 20:13" /><verse number="14" style="v" sid="LEV 20:14" />कदाम एकदो आपनी लाड़ीक आरू आपनी सासुक दुयुक राखे, ते यो महापाप छे; एरकरता चो मानुस आरू ची बायर तीनुन तीनुक आग्ठा मा धोपाड़े जासे, जेकी तुमरे वीचमा महापाप नी होसे। <verse eid="LEV 20:14" /><verse number="15" style="v" sid="LEV 20:15" />पछा कदाम एकदो मानुस पशुगामी होसे, ते मानुस आरू पशु दुयु नक्कि मार न्हाखे जासे। <verse eid="LEV 20:15" /><verse number="16" style="v" sid="LEV 20:16" />कदाम एकदी बायर पशुक जु जाईन ओकान संग कुकर्म करे, ते तू ओकी बायर आरू पशु दुयोक घात करनु; चा नक्कि मार न्हाखे, ओकान लूहुय हेका मुनका पर पड़से।<verse eid="LEV 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 20:17" />कदाम एकदो आपनी सौतली बोहनीसक, चाहे ओकान सगी बोहनी होसे चाहे सौतली, ओकीम बिना छिंदराक डिल देखे, ते यो निन्दित वात छे, चा दुयु आपना जातीन भाईसक डुवान सामने खतम करे जासे; काहकी जु आपनी बोहनीस डिल उघाड़नेवाळा ठरसे ओकाह आपना अधर्मन भार खुद उठावनु पड़से। <verse eid="LEV 20:17" /><verse number="18" style="v" sid="LEV 20:18" />पछा कदाम एकदो मानुस काहना ऋतुमती बायरक संग सुवीन ओकान तन उघाड़े, ते चो मानुस ओकान रूधिरक सोतेक उघाड़नेवाळा ठरसे, आरू ची बायर रूधिरक सोतेक उघाड़नेवाळा ठरसे; ओका कारण चा दुयु आपना लोगहनक वीच मा सी खतम कर्‍या जासे। <verse eid="LEV 20:18" /><verse number="19" style="v" sid="LEV 20:19" />आपनी जीजी या फुईक डिल नी उघाड़नु, काहकी जु ओका उघाड़े चु आपने साथे कुटुम्बिनीक नगो करता छे; एरकरता उना दुयुक आपना अधर्मन भार उठावनु पड़से। <verse eid="LEV 20:19" /><verse number="20" style="v" sid="LEV 20:20" />कदाम एकदो आपनी काकीन साथे सुवे, ते चो आपना काकान डिल उघाड़नेवाळो ठरसे; एरकरता चा दुयु आपना पापक भार क उठावीन निर्वश मर जासे। <verse eid="LEV 20:20" /><verse number="21" style="v" sid="LEV 20:21" />कदाम एकदो आपनी वोवड़ीस या भयाहू क आपनी लाड़ी बनावे, ते ओका घिनौनो काम जाननु; आरू आपना भाईसक डिल उघाड़नेवाळा ठरसे, ओका करण चा दुयु निर्वश रवसे।<verse eid="LEV 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 20:22" />तुमु मारी सब विधिया आरू मारा सब नियमोक समझक साथे माननु; जेका सी यो नी होसे कि जेका देश मा हाव तुमुक लीन जाय रयु छे चु तुमुक उगल देसे। <verse eid="LEV 20:22" /><verse number="23" style="v" sid="LEV 20:23" />आरू जेकी जातीन लोगहनक हाव तुमरे ओगव सी निकाळता छे उकान रीति रस्म पर नी चालनु; काहकी उना लोगहन नी जो यो सब कुकर्म करे छे ओका कारण मखे उना सी घृणा होय गई छे। <verse eid="LEV 20:23" /><verse number="24" style="v" sid="LEV 20:24" />पुन हाव तुमु लोगहन सी कयतु छे कि तुमु ते ओकान धरतीन आधिकारी होसे, आरू हाव ओका देश क जेका मा दूध आरू मोवन धारा वोहयता छे तुमरा हक मा कर दिस; हाव तुमरो परमेश्वर योहोवा छे जु तुमुक दिसरा देशक लोगहन सी अलग कर्‍यो छे। <verse eid="LEV 20:24" /><verse number="25" style="v" sid="LEV 20:25" />ओका कारण तुमु शुद्ध आरू अशुद्ध पशु मा, आरू शुद्ध आरू अशुद्ध चिल्ला मा भेद करनु; आरू एकदो पशु या चिल्लो या काहनो प्रकारन धरती पर रेंगनेवाळा जीवजन्तु काह नी होसे, जेका हाव तुमरे करता अशुद्ध ठरावीन वर्जित कर्‍या छे, ओका सी आपने आप क अशुद्ध नी करनु। <verse eid="LEV 20:25" /><verse number="26" style="v" sid="LEV 20:26" />तुमु मार करता पवित्र बवना रयु; काहकी हाव योहोवा खुद पवित्र छे, आरू हाव तुमु क आरू देशक लोगहन सी एरकरता अलग कर्‍या छे कि तुमु निरन्तर माराज बवना रवु।<verse eid="LEV 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 20:27" />कदाम एकदो मानुस या बायर ओझाई अथवा भूतज साधना करे, ते चो नक्कि मार न्हाखे जासे; ओसा पर पथराव कर्‍या जासे, ओकान लूहुय हेकाक मुनका पर पड़से।<verse eid="LEV 20:27" /></para>
  <chapter eid="LEV 20" />
  <chapter number="21" style="c" sid="LEV 21" />
  <para style="s">याजकन पवित्रता</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 21:1" />पछु योहोवा मूसा सी कयो, “हारूनक पोर्‍यो जु याजक छे ओका सी कया कि तुमरे लोगहन मा सी कोय भी मरे, ते ओकान कारण तुमु मा सी कुई आपसाक अशुद्ध नी करे; <verse eid="LEV 21:1" /><verse number="2" style="v" sid="LEV 21:2" />आपने निकट कुटुम्बिया, मतलब आपनी आया, या बासक, या पोर्‍या, या पोराय, या भाईसक करता, <verse eid="LEV 21:2" /><verse number="3" style="v" sid="LEV 21:3" />या आपनी कुवारी बोहनीस जेका हियाव नी होयो छे, जेका निकटन सम्बन्ध छे; उनाक करता चो आपनाक अशुद्ध कर सकता छे। <verse eid="LEV 21:3" /><verse number="4" style="v" sid="LEV 21:4" />पुन याजक होयने नाता चो आपना लोगहन मा प्रधान छे, एरकरता चो आपनुक ओसो अशुद्ध नी करे कि विटुळ होय जाए। <verse eid="LEV 21:4" /><verse number="5" style="v" sid="LEV 21:5" />चा नी ते आपना मुनकान झोठा काढ़ाया, आरू नी आपना गालक झोठाक काढ़ाया, आरू नी आपना शरीर चीरे। <verse eid="LEV 21:5" /><verse number="6" style="v" sid="LEV 21:6" />चा आपना परमेश्वरन करता पवित्र बवना रवु, आरू आपना परमेश्वरक नाव विटुळ नी करे; काहकी चा योहोवाक हव्य क जो ओकान परमेश्वरन खानो छे, चढ़ावो करता छे; कारण चा पवित्र बवना रवे। <verse eid="LEV 21:6" /><verse number="7" style="v" sid="LEV 21:7" />चा वेश्या या भ्रष्टा सी हियाव नी करे, आरू नी त्यागी होई सी हियाव करे; काहकी याजक आपना परमेश्वरन करता पवित्र होयता छे। <verse eid="LEV 21:7" /><verse number="8" style="v" sid="LEV 21:8" />एरकरता तु याजक पवित्र जाननु, काहकी चो तुमरा परमेश्वरम खानो चढ़ायो करता छे; एरकरता चो तारी नजर मा पवित्र ठरे; काहकी हाव योहोवा, जो तुमुक पवित्र करता छे, पवित्र छे। <verse eid="LEV 21:8" /><verse number="9" style="v" sid="LEV 21:9" />आरू कदाम याजकन पोराय वेश्या बनावीन आपने आपसुक विटुळ करे, ते चो आपना बासक विटुळ ठरावती छे; ची आग्ठा मा धोपाड्यो जासे।<verse eid="LEV 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 21:10" />“जु आपना भाईसक मा महायाजक होसे जेका मुनका पर अभिषेक तेल न्हाख्या गया होसे, आरू जेका पवित्र छिंदराक पेहरनेन करता संस्कार होयो होसे चो आपना मुनकाक झोठा वेरायने नी देनु, आरू नी आपना छिंदरा फाड़े; <verse eid="LEV 21:10" /><verse number="11" style="v" sid="LEV 21:11" />आरू नी चो काहना लोथ क जु जाए, आरू नी आपना बास या आयाक कारण आपनुक अशुद्ध करे; <verse eid="LEV 21:11" /><verse number="12" style="v" sid="LEV 21:12" />आरू चो पवित्रस्थानक पवित्रस्थान सी बाहरता भी नी निकळे, आरू नी आपना परमेश्वरक पवित्रस्थानक विटुळ ठरायो; काहकी चो आपना परमेश्वरक अभिषेक तेलरूपी मुकुट धारण कर्‍या होया छे; हाव योहोवा छे। <verse eid="LEV 21:12" /><verse number="13" style="v" sid="LEV 21:13" />आरू ची कुवारी बायर सी हियाव करे। <verse eid="LEV 21:13" /><verse number="14" style="v" sid="LEV 21:14" />जी विधवा, या त्यागी होई, या भ्रष्ट, या वेश्या होसे, ओसी काहना सी ची हियाव नी करे, चा आपनाज लोगहन वीच माहयला काहनी कुवारी पोराय सी हियाव करे। <verse eid="LEV 21:14" /><verse number="15" style="v" sid="LEV 21:15" />आरू ची आपनी संतानक आपना लोगहन मा विटुळ नी करे; काहकी हाव ओकान पवित्र करनेवाळा योहोवा छे।”<verse eid="LEV 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 21:16" />पछु योहोवा मूसा सी कयो, <verse eid="LEV 21:16" /><verse number="17" style="v" sid="LEV 21:17" />“हारून सी कय कि तार साथे वंश पीढ़ी पीढ़ी मा जेका काहनाक कुई भी दोष होसे चो आपना परमेश्वरम खानो चढ़ावनेक करता सामने नी आया। <verse eid="LEV 21:17" /><verse number="18" style="v" sid="LEV 21:18" />एकदो काह नी होसे जेका मा दोष होसे वो सामने नी आया, चाहे चो आंधवो होसे, चाहे लेंगड़ा, चाहे नकटपटा होसे, चाहे ओकान काहय सवटो अंग होसे, <verse eid="LEV 21:18" /><verse number="19" style="v" sid="LEV 21:19" />या ओकान पाय, या हाथ टूटे होसे, <verse eid="LEV 21:19" /><verse number="20" style="v" sid="LEV 21:20" />या चो कुबड़ा, या बौना होसे, या ओकान डुवा मा दोष होसे, या उका मानसक चाई या खुजली होसे, या ओकान आंडा पिचका होसे; <verse eid="LEV 21:20" /><verse number="21" style="v" sid="LEV 21:21" />हारून याजकन वंश मा सी जेका काहना मा एकदो भी दोष होसे चो योहोवाक हव्य चढ़ावने करता सामने नी आया; चो जो दोषयुक्त छे कभी भी आपना परमेश्वरन खानो चढ़ावनेक करता सामने नी आया। <verse eid="LEV 21:21" /><verse number="22" style="v" sid="LEV 21:22" />चो आपना परमेश्वरन पवित्र आरू घण चुखो दुयु प्रकारन भोजनक खाये, <verse eid="LEV 21:22" /><verse number="23" style="v" sid="LEV 21:23" />पुन ओकान दोषन कारण चो नी ते वीचमाहयला पड़दान माहयता आया आरू नी वेदीक सामने, जेका सी ओसा नी होसे कि चो मारो पवित्रस्थानक विटुळ करे; काहकी हाव ओकान पवित्र करनेवाळा योहोवा छे।” <verse eid="LEV 21:23" /><verse number="24" style="v" sid="LEV 21:24" />एरकरता मूसु हारून आरू ओकान पोर्‍याक तथा सब इस्राएलियाक या वातु कय सुनाई।<verse eid="LEV 21:24" /></para>
  <chapter eid="LEV 21" />
  <chapter number="22" style="c" sid="LEV 22" />
  <para style="s">चढ़ावान पवित्रता</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 22:1" />पछु योहोवा मूसा सी कया, <verse eid="LEV 22:1" /><verse number="2" style="v" sid="LEV 22:2" />हारून आरू ओकान पोर्‍या सी कया कि इस्राएलियाक पवित्रन होई चीज सी जेका चो मार करता पवित्र करता छे अलग रया, आरू मारा पवित्र नावन विटुळ नी करे; हाव योहोवा छे। <verse eid="LEV 22:2" /><verse number="3" style="v" sid="LEV 22:3" />आरू उना सी कय कि तुमरी पीढ़ी पीढ़ी मा तुमरे सब वंश मा सी जो कुई आपनी अशुद्धता कि दशा मा उना पवित्र होई चीजक जु जाए, जेका इस्राएली योहोवाक पवित्र करता छे, चो प्राणी मार सामने सी नाश कर्‍या जासे; हाव योहोवा छे।<verse eid="LEV 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 22:4" />हारूनक वंश मा सी कुई काह नी होसे जो कोढ़ी होसे, या ओकान सफेदपाणी होसे, चो मानुस जव तक शुद्ध नी होसे जाए तव तक पवित्र होई चीज मा सी काहय नी खाए। जो लोथक कारण अशुद्ध होसे, या जेका वीर्य स्खलित होयो होसे, ओसो मानुसक जो कुई हाथ लागाड़े, <verse eid="LEV 22:4" /><verse number="5" style="v" sid="LEV 22:5" />आरू जो कुई काहनी ओसो रेंगनेहारे जन्तुक हाथ लागाड़े जेका सी लोगहन अशुद्ध होय सकता छे, या काहना ओसा मनुस क हाथ लागाड़े जेका मा काहना प्रकारन अशुद्धता होसे जो ओकाह भी लाग सकती छे <verse eid="LEV 22:5" /><verse number="6" style="v" sid="LEV 22:6" />ते चो प्राणी जो इनामा सी काहनाक हाथ लागाड़े सांजु तक अशुद्ध ठरल रवे, आरू जव तक जल सी स्नान नी करले तव तक पवित्र चीज मा सी काहय नी खाए। <verse eid="LEV 22:6" /><verse number="7" style="v" sid="LEV 22:7" />तव दाहड़ो बुडनेक होयने पर चो शुद्ध ठरसे; आरू तव चो पवित्र चीज मा सी खाय सक छे, काहकी ओकान खानो चो छे। <verse eid="LEV 22:7" /><verse number="8" style="v" sid="LEV 22:8" />जो जनावर आपने आपसु सी मरलो होसे या हिंसक पशु सी फावड़ो गयो होसे उका खाईन चो आपने आपसुक अशुद्ध नी करे; हाव योहोवा छे। <verse eid="LEV 22:8" /><verse number="9" style="v" sid="LEV 22:9" />एरकरता याजक लोगहन म्हारा आपला नियमनमन पालन करे, ओसो नी होय कि चा उनाक विटुळ करीन पापन भार उठायो, आरू ओका कारण मर भी जाए; हाव ओकान पवित्र करनेवाळु योहोवा छे।<verse eid="LEV 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 22:10" />“पराया कुलक जन काहना पवित्र चीजक नी खानु जुवे, चाहे चु याजक क पाहनत्रो होसे या मजदुर होसे, तौभी चा कुई पवित्र चीज नी खाए। <verse eid="LEV 22:10" /><verse number="11" style="v" sid="LEV 22:11" />कदाम याजक काहना प्राणी ओकामा सी खाय सकता छे; आरू जु याजकक घर मा पयदा होये होसे चा भी ओकान खाना मा सी खाए। <verse eid="LEV 22:11" /><verse number="12" style="v" sid="LEV 22:12" />कदाम याजकक पोराय पराया कुलक काहना मानसो सी हियाव वाळी होसे, ते ची भेंटक होई पवित्र चीज मा सी नी खाए। <verse eid="LEV 22:12" /><verse number="13" style="v" sid="LEV 22:13" />कदाम याजकक पोराय विधवा या त्यागी होई होसे, आरू ओकान सन्तान नी होसे, आरू ची आपनी बाल्यावस्थाक रीतीक अनसारे आपना बासक घर मा रयती होसे, ते ची आपना बासन खाना मा सी खाए; पुन पराया कुलक एकदो ओकामा सी नी खाय नी सके। <verse eid="LEV 22:13" /><verse number="14" style="v" sid="LEV 22:14" />आरू कदाम एकदो मानुस काहना पवित्र चीज मा सी कहाय विसरीन काय जासे, ते चो ओकान पाचवो भाग बढ़ावीन उका याजक क भर दे। <verse eid="LEV 22:14" /><verse number="15" style="v" sid="LEV 22:15" />चा इस्राएलियाक पवित्र करली होई चीजक, जेका चा योहोवाक करता चढ़ाया, विटुळ नी करे। <verse eid="LEV 22:15" /><verse number="16" style="v" sid="LEV 22:16" />चा ओका आपनी पवित्र चीज मा सी खावाढ़ीन ओका सी अपराधक दोष नी उठाड्या; हाव ओकान पवित्र करनेवाळु योहोवा छे।”<verse eid="LEV 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 22:17" />पछु योहोवा मूसा सी कयो, <verse eid="LEV 22:17" /><verse number="18" style="v" sid="LEV 22:18" />“हारून आरू ओकान पोर्‍या सी आरू इस्राएलिया सी समझाळीन कया कि इस्राएलक घराना या इस्राएल मा रयनेवाळा परदशिया मा सी एकदो काह नी होए जु मन्नत या स्वेच्छाबलि करनेक करता योहोवाक कुई होमबलि चढ़ाया, <verse eid="LEV 22:18" /><verse number="19" style="v" sid="LEV 22:19" />ते आपना निमित्त ग्रहणयोग्य ठरनेक करता बुयल या गाडरा या बुकड़ा मा सी निर्दोष नर चढ़ायो जासे। <verse eid="LEV 22:19" /><verse number="20" style="v" sid="LEV 22:20" />जेका मा कुई भी दोष होय हेको नी चढ़ावनो; काहकी त्यो तुमरे जुगू मानने सारको नी रयसे। <verse eid="LEV 22:20" /><verse number="21" style="v" sid="LEV 22:21" />आरू जु कुई बुयल या गाडरा-बुकड़ा मा सी स्वेच्छाबलिन करता योहोवाक मेलबलि चढ़ाया, ते ग्रहण होयनेन करता पाको छे कि चो निर्दोष होय, ओकामा कुई भी दोष नी होय। <verse eid="LEV 22:21" /><verse number="22" style="v" sid="LEV 22:22" />जु आंधवो या डिलन टुटलो या लुल्लो होसे, अथवा ओकमा रसौली या खवड़ा या खुजली होसे, ओसाक योहोवाक करता नी चढ़ावनु, ओकाक वेदी पर योहोवान करता हव्य नी चढ़ावनु। <verse eid="LEV 22:22" /><verse number="23" style="v" sid="LEV 22:23" />जेका काहनो बुयल या गाडराक कुई डिल जास्ती या कम मोटलो होसे ओकाह स्वेच्छाबलिन करता चढ़ाव सकता छे, पुन मन्नत पूरी करनेन करता चो ग्रहण नी होयसे। <verse eid="LEV 22:23" /><verse number="24" style="v" sid="LEV 22:24" />जेका आंडा दाबायला या कुचनाया या टूटला या काटला गया होसे ओका योहोवाक करता नी चढ़ावनु, आरू आपना देश मा भी ओसो काम नी करनु। <verse eid="LEV 22:24" /><verse number="25" style="v" sid="LEV 22:25" />इकामा सी काहनाक तुमु आपनो परमेश्वरन खानो जानीन एकदा परदेशी सी लीन नी चढ़ावु; काहकी ओकामा ओकान दोष छे, ओकामा दोष छे, एरकरता चो तुमरे निमित्त ग्रहण नी होसे।”<verse eid="LEV 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 22:26" />पछु योहोवा मूसा सी कयो, <verse eid="LEV 22:26" /><verse number="27" style="v" sid="LEV 22:27" />“जव केवढ़ाक या गाडराक या बुकड़ान बच्चा सी पयदा होय, ते चो सात दाहड़े तक आपनी आयाक साथे रये; पछा आठवे दाहड़े सी ओगव चो योहोवाक हव्यन करता ग्रहणयोग्य ठरसे। <verse eid="LEV 22:27" /><verse number="28" style="v" sid="LEV 22:28" />चाहे केवढ़ी, चाहे गाडरा या बुकड़ा होये, ओकाक आरू बच्चाक एकुज दाहड़ा मा बलि नी करनु। <verse eid="LEV 22:28" /><verse number="29" style="v" sid="LEV 22:29" />आरू जव तुमु योहोवान करता धन्यवादन मेलबलि चढ़ावु, ते उनी रीति सी करनु जेका सी चो ग्रहणयोग्य ठरसे। <verse eid="LEV 22:29" /><verse number="30" style="v" sid="LEV 22:30" />चा ओके दाहड़े खाये जासे, ओकामा सी काहय भी सोंदारे तक रयनु नी जुवे; हाव योहोवा छे।<verse eid="LEV 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 22:31" />“एरकरता तुमु मारी हुकुमोन माननु आरू ओकान पालन करनु; हाव योहोवा छे। <verse eid="LEV 22:31" /><verse number="32" style="v" sid="LEV 22:32" />आरू मारा पवित्र नाव विटुळ नी ठरनु, काहकी हाव इस्राएलियाक वीच मा पाको पवित्र माने जासे; काहकी हाव तुमरो पवित्र करनेवाळु योहोवा छे, <verse eid="LEV 22:32" /><verse number="33" style="v" sid="LEV 22:33" />जा तुमुक मिस्र देश सी निकाळ लाया, जेका सी तुमरो परमेश्वर बवनु रवे; हाव योहोवा छे।”<verse eid="LEV 22:33" /></para>
  <chapter eid="LEV 22" />
  <chapter number="23" style="c" sid="LEV 23" />
  <para style="s">पर्वोंक विधि</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 23:1" />पछा यहोवु मूसा सी कयो, <verse eid="LEV 23:1" /><verse number="2" style="v" sid="LEV 23:2" />“इस्राएलिया सी कया कि योहोवान तिवार जेकान तुमुक पवित्र सभा एकठी करनेक करता नेमला टेमो पर प्रचार करनु पड़से, मारा या तिवार या छे। <verse eid="LEV 23:2" /><verse number="3" style="v" sid="LEV 23:3" />छव: दाहड़ा काम-काज कर्‍या जासे, पुन सातवे दाहड़े परमआरामम तरफ पवित्र सभान दाहड़ु छे; ओकामा काहना प्रकारन काम-काज नी कर्‍या जासे; चा तुमरा सब घर मा योहोवाक आरामन दाहड़ा ठरसे।<verse eid="LEV 23:3" /></para>
  <para style="s">फसह आरू अखमीरी रोटान तिवार</para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 23:4" />“पछा योहोवान तिवार जेकामा सी एकेकान ठराया होए टेमो मा तुमुक पवित्र टुळु करनेन करता प्रचार करनो पड़से चा या छे। <verse eid="LEV 23:4" /><verse number="5" style="v" sid="LEV 23:5" />पेहले महिनान चौदवे दाहड़े शान्‍तीन टेमे योहोवान फसह होया करे। <verse eid="LEV 23:5" /><verse number="6" style="v" sid="LEV 23:6" />आरू उके महिनान पंद्रावे दाहड़े योहोवान करता अखमीरी रोटान तिवार होया करे; ओकामा तुमु सात दाहड़े तक अखमीरी रोटा खाया करनु। <verse eid="LEV 23:6" /><verse number="7" style="v" sid="LEV 23:7" />ओकामा पेहलो दाहड़ो तुमरी पवित्र सभा होसे; आरू उके दाहड़े मेहनतन कुई काम नी करनु। <verse eid="LEV 23:7" /><verse number="8" style="v" sid="LEV 23:8" />पुन सातु दाहड़े तुमु योहोवान हव्य चढ़ाया करनु; आरू सातवे दाहड़े पवित्र सभा होसे; उके दाहड़े मेहनतन कुई काम नी करनु।”<verse eid="LEV 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 23:9" />पछा योहोवा मूसा सी कयो, <verse eid="LEV 23:9" /><verse number="10" style="v" sid="LEV 23:10" />“इस्राएलिया सी कया कि जव तुमु उका देश मा प्रवेश करहत जेका योहोवा तुमुक आपतु छे आरू ओकामा खेत काटु, तव आपना आपना पाकला खेतन पेहली कमाईन पूला याजकन जु ली आया करनु; <verse eid="LEV 23:10" /><verse number="11" style="v" sid="LEV 23:11" />आरू चु उका पूलाक योहोवान सामने हालाड्या, कि चो तुमरे निमित्त ग्रहण कर्‍या जासे; चो उका आरामन दाहड़े दिसरे दाहड़े हालाड्या। <verse eid="LEV 23:11" /><verse number="12" style="v" sid="LEV 23:12" />आरू जेके दाहड़े तुमु पूला हालाड़े उके दाहड़े एक सालन निर्दोष गाडरान बच्चा योहोवान करता होमबलि चढ़ाना। <verse eid="LEV 23:12" /><verse number="13" style="v" sid="LEV 23:13" />आरू ओकान साथेन अन्नबलि एपान दुय दसवो अंश तेल सी झारीन मैदान होसे, चो सुखदायक सुगन्धान करता योहोवान हव्य होसे; आरू ओकान साथेन दूय लीटर भरीन पीने वाळो दाखरस चढ़ावाए । <verse eid="LEV 23:13" /><verse number="14" style="v" sid="LEV 23:14" />आरू जव तक तुमु ओका चढ़ावाक आपना परमेश्वरक जु नी ली जावु, उके दाहड़े तक नोवला खेत मा सी नी ते रोटो खानु आरू नी भूजलो अन आरू नी हरी बाले; यी तुमरी पीढ़ी पीढ़ी मा तुमरा सब घराना मा हमेशान विधि ठरसे।<verse eid="LEV 23:14" /></para>
  <para style="s">काटनेन पर्व</para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 23:15" />“पछा उका आरामन दाहड़ान दिसरे दाहड़ा सी, मतलब जेके दाहड़े तुमु हिलाड्या जानेवाळी भेंटन पूलेक लावसु, उका दाहड़ा सी पूरा सात आरामन दाहड़े गिन लेनु; <verse eid="LEV 23:15" /><verse number="16" style="v" sid="LEV 23:16" />सातवा आरामन दाहड़ान दिसरे दाहड़े तक पचास दाहड़ा गिन्नु, आरू पचावे दाहड़े योहोवान करता नोवला अन्नबलि चढ़ावनु। <verse eid="LEV 23:16" /><verse number="17" style="v" sid="LEV 23:17" />तुमु आपना घरो मा सी एपा क दुय दसवु अंश मैदान दुय रोटा हालावनेक भेंटन करता ली आवनु; चा खमीरन साथे रांदायनु जुवे, आरू योहोवान करता पेहली कमाय ठरसे। <verse eid="LEV 23:17" /><verse number="18" style="v" sid="LEV 23:18" />आरू उका रोटान संग एक एक सालन सात निर्दोष गाडरान बच्चा, आरू एक बछड़ो, आरू मेंढा चढ़ावनु; चा आपना आपना साथे वाळा अन्नबलि आरू अर्घ समेत योहोवान करता होमबलिन समान चढ़ावनु जासे, मतलब चा योहोवान करता सुखदायक सुगन्ध आपनेवाळा हव्य ठरसे। <verse eid="LEV 23:18" /><verse number="19" style="v" sid="LEV 23:19" />पछा पापबलिन करता एक बुकड़ो, आरू मेलबलिन करता एक एक सालन दुय गाडरान बच्चा चढ़ावनु। <verse eid="LEV 23:19" /><verse number="20" style="v" sid="LEV 23:20" />तव याजक उकाह पेहली कमाईन रोटा समेत योहोवान सामने हालावनेक भेंटन करता हालाड्या, आरू इना रोटान संग चा दुय गाडराक बच्चा भी हालाड्या जासे; चा योहोवान करता पवित्र, आरू याजकन भाग ठरसे। <verse eid="LEV 23:20" /><verse number="21" style="v" sid="LEV 23:21" />आरू तुमु उके दाहड़े यो प्रचार करनु कि आज हामरी एक पवित्र सभा होसे; आरू मेहनतन कुई काम नी करनु; यो तुमरा सब घराना मा तुमरी पीढ़ी पीढ़ी मा हमेशान विधि ठरसे।<verse eid="LEV 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 23:22" />“जव तुमु आपना देश मा खेत काटु, तव आपना खेत न कानोक पुरी रीती सी नी काटनु, आरू खेत मा पड़ला होया झोठाक नी एकठा करनु; उका दीनहीन आरू परदेशीन करता छुड़ देनु; हाव तुमरो परमेश्वर योहोवा छे।”<verse eid="LEV 23:22" /></para>
  <para style="s">नोवा-सालन</para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 23:23" />भोगवान मुसा काजे कोयु, <verse eid="LEV 23:23" /><verse number="24" style="v" sid="LEV 23:24" />तु इसरायली काजे यो कोव: सातवे मोहनान पेहले दाहड़े बेस चुखलु दाहड़ु वावजु। एनाक फोम कोरावने जुगु मोटला फेपारीया वाजाड़जु, आरू एक चुखली मिटिंग एकठी होयनो जुवे। <verse eid="LEV 23:24" /><verse number="25" style="v" sid="LEV 23:25" />तुमु काहने वी भातीन मेहनोतोन काम झुन कोरता। तुमु योहोवा जुगु आगठान बादा चोड़ावजु।<verse eid="LEV 23:25" /></para>
  <para style="s">पोसतावान दाहड़ु</para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 23:26" />पोरबु मुसा काजे कोयु, <verse eid="LEV 23:26" /><verse number="27" style="v" sid="LEV 23:27" />इना सातवा मोहनान दोसवे दाहड़े पोसतावान दाहड़ु छे। हुयो तुमरे जुगु चुखला तिहवारोन टेम होयसे। तेने दाहड़े तुमु आपसाक उपास राखिन दुख आपजु आरू पोरबुक आगठान बादा चोड़ावजु। <verse eid="LEV 23:27" /><verse number="28" style="v" sid="LEV 23:28" />तुमु इने दाहड़े काहने वी भातिन काम झुनी कोरता; काहकि यु योहोवा परमेश्वर ओगोव तुमरा पोसतावु कोरने जुगु पोसतावान दाहड़ु छे। <verse eid="LEV 23:28" /><verse number="29" style="v" sid="LEV 23:29" />जु मानुस इना दाहड़े आपसाक उपार राखिन दुख नी देय, चु आपसा मानसो मा नास कोर देयो जासे। <verse eid="LEV 23:29" /><verse number="30" style="v" sid="LEV 23:30" />जे मानुस इने दाहड़े काहने वी भातिन काम कोरसे, तेना मानुस काजे हांव मानसोन इचमा गोथु मिटाय नाखीस। <verse eid="LEV 23:30" /><verse number="31" style="v" sid="LEV 23:31" />तुमु काहने वी भातिन कामु झुनी कोरता। यी तुमरा आखा रोवनेन जागा मा पीढ़ी गोथा पीढ़ी लोगुन जोलोम नेम कोवायसे। <verse eid="LEV 23:31" /><verse number="32" style="v" sid="LEV 23:32" />चु दाहड़ु तुमरे जुगु बेस चुखलु दाहड़ु होयसे। तेने दाहड़े तुमु आपसाक उपार राखिन दुख देजु। तुमु तेने मोहनेन नोवनवे दाहड़े सान्ता गोथा दिसरे दाहड़ेन सान्तु लोगुन आरामोन दाहड़ु मानता रोवजु।<verse eid="LEV 23:32" /></para>
  <para style="s">झोपाट्यान तिहवार</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 23:33" />योहोवा मुसा काजे कोयु, <verse eid="LEV 23:33" /><verse number="34" style="v" sid="LEV 23:34" />तु इसराएली मानसो काजे कोव: इना मोहनान पोन्दरोवे दाहड़े गोथा सात दाहड़ा लोगुन पोरबु जुगु झोपाट्यान तिहवार वावजु। <verse eid="LEV 23:34" /><verse number="35" style="v" sid="LEV 23:35" />पेहले दाहड़े चुखली मिटिंग रोवे। उना दाहड़े तुमु काहने वी भातिन मेहनोतोन काम झुन कोरता। <verse eid="LEV 23:35" /><verse number="36" style="v" sid="LEV 23:36" />तुमु सात दाहड़ा लोगुन पोरबु काजे आगठान बादा चोड़ावजु। आठवे दाहड़े चुखली मिटिंग राखजु, आरू पोरबु काजे आगठान बादा चोड़ावजु। यी खास मिटिंग छे। एने तेने दाहड़े तुमु काहने वी भातिन काठलो काम झुन कोरता।<verse eid="LEV 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 23:37" />यो पोरबुन टाकलु तिहवार छे, जेरेम चुखली मिटिंग राखनेन खोबोर कोरजु। यु तिहवार पोरबु काजे आगठा मा बादा चोड़ावने, आगठान बादा, ओनोन बादा, ढुरोन बादा आरू पेय बादा हेरा टाकला दाहड़ा पोर चोड़ावने जुगु छे। <verse eid="LEV 23:37" /><verse number="38" style="v" sid="LEV 23:38" />यो आखा गोथो जादा योहोवान आरामोन दाहड़ा काजे मानु, आरू आखी भेट, मानता आरू मोरजी से चोड़ावली बादाक छुड़ीन दिसरो छे, जो तुमु पोरबु काजे चोड़ाया कोरजु।<verse eid="LEV 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 23:39" />सातवे मोहनेन पोन्दरोवे दाहड़े, जोत्यार तुमु खेतोन मेर एकठी कोरसु तोत्यार पोरबु जुगु सात दाहड़ा लोगुन तिहवार वावजु। पेहले दाहड़े बेसकु चुखलु दाहड़ु होयसे; आठवु दाहड़ु वी बेस चुखलु दाहड़ु होयसे। <verse eid="LEV 23:39" /><verse number="40" style="v" sid="LEV 23:40" />पेहले दाहड़े तुमु वारू सी वारू झाड़ोन फोव, खजूरन झाड़ोन डाळ्या, पान्टा वावा झाड़ोन डाळ्या आरू खुदरा मायीन दोंळान डाळ्या लिन आपना पोरबु परमेश्वर ओगोव सात दाहड़ा लोगु खुस रोवजु। <verse eid="LEV 23:40" /><verse number="41" style="v" sid="LEV 23:41" />तुमु विरसि सात दाहड़ा लोगुन पोरबु जुगु तेनी जातरान तिहवार वावजु। यी तुमरी पीढ़ी गोथी पीढ़ी लोगुन जोलोम रिती कोवाये। तुमु तिहवार काजे सातवे मोहने वावजु। <verse eid="LEV 23:41" /><verse number="42" style="v" sid="LEV 23:42" />तुमु सात दाहड़ा लोगुन छोपाट्या मा रोवजु, एसराएलोन आखा गांवल्या झोपाट्या मा रोवजु, <verse eid="LEV 23:42" /><verse number="43" style="v" sid="LEV 23:43" />जेरेसी तुमरी पीढ़ी-पीढ़ी काजे फोम रोवे कि जोत्यार हांव इसराएली मानसो काजे मिसर मुलुक गोथु खोयड़े निकावळु तोत्यार हेनुक झोपट्या मा आसरू आपलु। हांव तुमरू परमेश्वर योहोवा छे।</para>
  <para style="p" vid="LEV 23:43">ओस कोरीन मुसा इसराएली मानसो काजे पोरबुन टाकला तिहवार देखाड़्यु। <verse eid="LEV 23:43" /><verse number="44" style="v" sid="LEV 23:44" />आरू मुसा इसराएली मानसो काजे यहोवा भोगवानोन तिहवारोन टेम कोवीन सोमवाड़्यु<verse eid="LEV 23:44" /></para>
  <chapter eid="LEV 23" />
  <chapter number="24" style="c" sid="LEV 24" />
  <para style="s">चुखला दिवा काजे घाटाळा कोरनो</para>
  <para style="pi">
    <verse number="1" style="v" sid="LEV 24:1" />ओळी योहोवा मूसा सी कोयू, <verse eid="LEV 24:1" /><verse number="2" style="v" sid="LEV 24:2" />इसराएली मानसो काजे यो हुकुम आप कि मारेन्चा विजावो कोरने कोरीन कुट सी निकोवलो जेतुन झाड़कान वारलो तेल लीन आवजू कि दिव एक पोट्यू धोपतू रोवे। <verse eid="LEV 24:2" /><verse number="3" style="v" sid="LEV 24:3" />हारून तिनाक, मिलाप वावा तम्बू मा, पोरदान खोयड़े सान्तु गोथु सोन्दारे लोगुन पोरबु ओगोच एक सारकु सोजावीन राखसे। यी तुमरी पीढ़ी जुगु जोलोम रिती कोवाये। <verse eid="LEV 24:3" /><verse number="4" style="v" sid="LEV 24:4" />हुयो चुखला सोनान भीतड़ा पोर योहोवा ओगोव दिवु एक पोट्यु सोजावीन राखसे।<verse eid="LEV 24:4" /></para>
  <para style="s">भेटोन रूटा</para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 24:5" />“तुमु मेदा काजे कुसनीन तेरा बारे रूटा बोनावजु। एक एक रूटु दुय किलान बोननो जुवे। <verse eid="LEV 24:5" /><verse number="6" style="v" sid="LEV 24:6" />तुमु रूटाक दुय चोव मा योहोवा ओगोव चुखला सोनाना पाटला पोर मेकजु। एक चोव मा छोव रूटा मेकजु। <verse eid="LEV 24:6" /><verse number="7" style="v" sid="LEV 24:7" />तुमु आखी चोव मा चुखलो लोबान पुठी मेकजु जेरेसी चे रूटा भेळ फोम देवाड़े वावी चिज बोनिन योहोवा काजे आगठा मा चोहोड़ जाय तोसे। <verse eid="LEV 24:7" /><verse number="8" style="v" sid="LEV 24:8" />हारून आखा आरामोन दाहड़े इसराएली मानसो ओगे गोथु वायदान रुपोमा योहोवा ओगोव एक सारका नोवला रूटा चोवेन चोव मेक्या कोरसे। <verse eid="LEV 24:8" /><verse number="9" style="v" sid="LEV 24:9" />ये रूटा हारून आरू हेरा पुर्यान होयसे। चे तिनुक चुखला जागाम खासे; काहकि योहोवा काजे आगठा मा चोड़ावली बादा मा गोथो यो हेन्दरू बेस चुखलु वाटु छे। इना पोर हेन्दरो होक छे।”<verse eid="LEV 24:9" /></para>
  <para style="s">नियाव पूर्ण सारका डण्डन पुरावो</para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 24:10" />एक वार काहनी इसराएली बायरोन पुर्यु तेरू बास मिसर देस मा रोवने वावु होतु, इसराएली मानसोन इचमा गोयु। चा पोड़ाव मा चु होतु एने एक इसराएली मानसे आपसात् लोड़ायने लाग्या। <verse eid="LEV 24:10" /><verse number="11" style="v" sid="LEV 24:11" />इसराएली बायरोन पुर्यु योहोवा भोगवानोव नावोक भुन्डा बुले कोयु आरू वायकेड़ा उड़ायु। मानसे तिनाक मुसान चा लाया। तेरी आयस्युन नाव सलोमित होतो, जे दान घोरानान दिबरीन पुराय होती। <verse eid="LEV 24:11" /><verse number="12" style="v" sid="LEV 24:12" />चे मानसे इसराएली बायोरोन पुर्याक तेने टेमे लोगुन कुंडवाड़ाम राख्या जोत्यार लोगुन योहोवा भोगवानोन बुल तिनाक वारू रीते पोतु नी होय जाय।<verse eid="LEV 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 24:13" />योहोवा मुसा काजे कोयु, <verse eid="LEV 24:13" /><verse number="14" style="v" sid="LEV 24:14" />तुमु मनख्या तेना वायकेड़ा उड़ावने वावान पोड़ाव मा गोथा खोयड़े लीयावु; आरू जोतरा मानसे वायकेड़ा उड़ातेला सोमया होय चे आखा आपना आपना हात हेरा मुनका पोर मेकु, तोत्यार आखा मोन्डळीन मानसे तिनाक दोगड़ाटने लाग्या। <verse eid="LEV 24:14" /><verse number="15" style="v" sid="LEV 24:15" />तु इसराएली मानसो काजे यो वी कोवजी: जु मानुस आपसा भोगवान काजे भुन्डा बुल बुलसे, चु आपसा पापोन भार आपसुत छेलसे। <verse eid="LEV 24:15" /><verse number="16" style="v" sid="LEV 24:16" />भोगवानोन नावोन वायकेड़ा उड़ावसे तिनाक मोतोन डोन जोड़से। आखा मोन्डळीन मानसे तिनाक दोगड़ाटसे। जोत्यार कुदु मानुस चु गांवल्यु होत तेने पारकु होय, योहोवा भोगवानोन वायकेड़ा उड़ावसे तिनाक मोतोन डोन जोड़से। <verse eid="LEV 24:16" /><verse number="17" style="v" sid="LEV 24:17" />जु मानुस कुदा मानसोक मार देये तिनाक मोतोन डोन जोड़से। <verse eid="LEV 24:17" /><verse number="18" style="v" sid="LEV 24:18" />ढुरोक मारने वावु मानुस तेरी नुकसानी आपसु झेलसे तेना ढुरोन बोदलाम ढुर आपे। <verse eid="LEV 24:18" /><verse number="19" style="v" sid="LEV 24:19" />कोदाम कुदु मानुस आपसा काहना गांवल्या भास्योन एने बोहोनस्यान चोट लागाड़े ती हेरे पुठी वी तोसोत् होयसे; <verse eid="LEV 24:19" /><verse number="20" style="v" sid="LEV 24:20" />चोटोन बोदलाम चोट, डुवान बोदलाम डुवु, दातोन बोदलाम दात। जोसु चु दिसरा मनुसन नुकसानी कोरे, तोसोत् तेरे पुठी होयसे। <verse eid="LEV 24:20" /><verse number="21" style="v" sid="LEV 24:21" />ढुरोक मारने वावा मनुसन नुकसानी चु झेलसे; पुन मानसोक मारने वावा मानसोक मोतोन डोन जोड़से। <verse eid="LEV 24:21" /><verse number="22" style="v" sid="LEV 24:22" />पारका एने गांवल्या मानसो जुगु एकुत नियोवोन कायदु होयसे; काहकि हांव योहोवा, तुमु भोगवान छे। <verse eid="LEV 24:22" /><verse number="23" style="v" sid="LEV 24:23" />मुसा इसराएली मानसो काजे यी वात कोयु। चे भोगवानोन वायकेड़ा उड़ान्याक खोयड़े ली गोया। चां चे तिनाक दोगड़ाटीन मार नाख्या। ओस कोरीन जोसु योहोवा भोगवान मुसा काजे हुकुम आपलु होतु तोसात् इसराएली कोर्या।<verse eid="LEV 24:23" /></para>
  <chapter eid="LEV 24" />
  <chapter number="25" style="c" sid="LEV 25" />
  <para style="s">सातवो साल, आरामोन साल</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 25:1" />योहोवा भोगवान मुसा काजे सिनाय बोयड़ा पोर कोयु, <verse eid="LEV 25:1" /><verse number="2" style="v" sid="LEV 25:2" />तु इसराएली मानसो काजे कोवजी; तु तेनु काजे ओसु कोवजी: जोत्यार तुमु तेना मुलुक मा जासु जो हांव तुमुक आप रोयु, तोत्यार तेना मुलुकोन जागु वी योहोवा भोगवान जुगु आराम कोरसे। <verse eid="LEV 25:2" /><verse number="3" style="v" sid="LEV 25:3" />तुमु छव साल तक तुमरो खेत वेरीया करजो, आरू छवु साल आपसी आपसी खेतीन वाड़ी न छाटी छाटीन खेतन फसल एखटी करीया करजो। <verse eid="LEV 25:3" /><verse number="4" style="v" sid="LEV 25:4" />पुन सातवा सालोम खेतीक वी बेसको आराम जोड़से: योहोवा भोगवानोन आरामोन साल। तुमु तेने साल नी ते आपसा खेतेम वेरू आरू नी आपसा ओंगुरोन वाड़ी मा काटनो कोरजु। <verse eid="LEV 25:4" /><verse number="5" style="v" sid="LEV 25:5" />जो काहिन तुमरा काटला खेतोन आपसुत् उगे तिनाक झुन काटता, आरू नी चुटला ओंगुरोन वेलाम गोथा तुड़जु; काहकि इना जागा जुगु बेसकु आरामोन साल होयसे। <verse eid="LEV 25:5" /><verse number="6" style="v" sid="LEV 25:6" />पुन खेती आपना आरामोन सालो मा तुमरी, तुमरा चाखरीया, दाहाड़क्या आरू तुमरा विच मा रोहवने वावा पारका मानसो जुगु खानो जोड़्या कोरसे। <verse eid="LEV 25:6" /><verse number="7" style="v" sid="LEV 25:7" />आरू तुमरा मुलकोन जतरा बी जनवार हय हेनको वाटे खाणो बी धरतीन आखी मेर मा रयीन रोयसे।<verse eid="LEV 25:7" /></para>
  <para style="s">59 वा सालन क मनावनो</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 25:8" />तुमु सात आरामोन साल मोतलोब सात गुना सात वोरीस गिनजु, सात आरामोन सालोन यो टेम चावीस ने नोव सालोन रोवसे। <verse eid="LEV 25:8" /><verse number="9" style="v" sid="LEV 25:9" />तोत्यार तुमु सातवा मोहनान दोसवे दाहड़े आखा जागा पोर मटलाबुलन भिरा फुकजु। पोसतावान दाहड़े तुमत आपसा मुलुकोन आखा जागा पोर मोटला फेपारीया फुकजु। <verse eid="LEV 25:9" /><verse number="10" style="v" sid="LEV 25:10" />आरू तुमु पोचास साल काजे चुखलु मानजु, आरू मुलुकोन आखा रोवन्या काजे छुटकारान पोरचार कोरजु, यो जुबली वाळो साल कोवायसे। इने साल आखा मानसे आपसा बासोन धोन पोछा हात कोरसे। आखा मानसे आपसा घोरलीयान जा पोछा जात रोवसे। <verse eid="LEV 25:10" /><verse number="11" style="v" sid="LEV 25:11" />तुमरे जुगु पोचासवु साल जुबली वावु साल होयसे। तुमु तेन साल बेरता झनी, आरू जो काहीन आपसुत उगसे, तिनाक झुन कटता, आरू जे ओंगुर नी चुटाया तेनु ओंगुरोन वेलाक झुन तुड़ता; <verse eid="LEV 25:11" /><verse number="12" style="v" sid="LEV 25:12" />काहाकि चु जुबली वावु साल होयसे। चु तुमरे जुगु चुखलु साल कोवायसे। जो खेतोम उगसे, तुमु चोत् खाजु।<verse eid="LEV 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 25:13" />इना जुबली वावा साल मा आखा मानसे आपसा बासोन धोन काजे पोछा हात कोरसे। <verse eid="LEV 25:13" /><verse number="14" style="v" sid="LEV 25:14" />कोदाम तुमु आपना काहना मुलकोन भाइस क काहिन वेचसु एने तेरा हातोम रोइन काहिन लेसु, ती एक दिसरा पोर आंधारो झुन कोरता। <verse eid="LEV 25:14" /><verse number="15" style="v" sid="LEV 25:15" />पेहेला जुबली वावा सालोन ओवतेन जोतरा साल वीते तेर ओनसारे गिनिन तुमु आपसा मुलुक वावा भास्यो एने बोहोनस्या जुळ मुले लेजु; मेरोन वाचाला सालोन गिनतीन ओनसारे चे तुमुक वेचसे। <verse eid="LEV 25:15" /><verse number="16" style="v" sid="LEV 25:16" />कोदाम जादा साल वाचे, ती तुमु भाव बोड़ावजु; पुन कोदाम कोम साल वाचला होय, ती भाव कोम कोरजु; काहाकि जो हुये वेचे, चो मेरोन गिनतिन ओनसारे वेचे। <verse eid="LEV 25:16" /><verse number="17" style="v" sid="LEV 25:17" />तुमु एक दिसरा पोर कुहराय झुन कोरता पुन आपसा भोगवानोन बिक मानजु; काहकि हांव तुमरू योहोवा भोगवान छे।<verse eid="LEV 25:17" /></para>
  <para style="s">सातवा सालोन वेला</para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 25:18" />तुमु मारी रिती काजे मानजु, आरू मारा नेम कायदा पोर सोमजी जानीन चालजु; काहकि ओसो कोरने सी तुमु तिना मुलुक मा विगुर बिहये वोसला रोवसु। <verse eid="LEV 25:18" /><verse number="19" style="v" sid="LEV 25:19" />धोरती तुमुक मेर पाकाड़ीन आपसे, आरू तुमु पेट भोरीन खाया कोरसु, आरू तिना मुलुक मा बेफिकरिया वोस रोवसु। <verse eid="LEV 25:19" /><verse number="20" style="v" sid="LEV 25:20" />आरू कोदाम तुमु कोवु कि सातवा सालोम हामु काय खासु, नी ते हामु वेरजे नी आपना खेतोन मेर काजे एकठी कोरसु? <verse eid="LEV 25:20" /><verse number="21" style="v" sid="LEV 25:21" />ती जान लेवु की हांव तुमुक छोटवा सालोम ओसी बोरकोत आपीस, कि धोरतीन मेर तीन वोरीस लोगुन काम आवसे। <verse eid="LEV 25:21" /><verse number="22" style="v" sid="LEV 25:22" />तुमु आठवा सालोन मेर जोत्यार लोगुन नी पाके ती लोगुन तुमु जुनली मेरोम गोथा खाता रोवसु।<verse eid="LEV 25:22" /></para>
  <para style="s">जागा छुड़ावनेन नियम</para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 25:23" />जागा काजे जोलोम जुगु नी वेचाये, काहकि जागा मारी छे; आरू हेरेम तुमु पारका आरू बाहारला कोवायसु। <verse eid="LEV 25:23" /><verse number="24" style="v" sid="LEV 25:24" />बाखुन तुमु आपसा वाटान आखा मुलुकोन जागाक छुड़वने देजु। <verse eid="LEV 25:24" /><verse number="25" style="v" sid="LEV 25:25" />कोदाम तुमरू कुदु भाय बोन्यु गोरब्यु होयीन आपसी जागामा गोथु थुड़ोक वेच देये, ती तेरा घोराना मा गोथु जो आखा गोथो धोड़े होय चु आवीन आपसा भायबोन्यान वेचलु वाटु छुड़वी लेय। <verse eid="LEV 25:25" /><verse number="26" style="v" sid="LEV 25:26" />कोदाम कुदु मानुसो जुगु कुदु छुड़ावनेवावो नी होय, आरू तेर जु ओतरो धोन होय कि आपसुत् आपसा वाटाक छुड़वी ली सोके, <verse eid="LEV 25:26" /><verse number="27" style="v" sid="LEV 25:27" />ती चु एइना सालोन ओनसारे गिन लेय, जिने साल होयु तिनाक वेचलु, तेर हिसाबे तिनाक दाम आपसे। तोत्यार तेरो धोन पोछो तेरोत् होय जासे। <verse eid="LEV 25:27" /><verse number="28" style="v" sid="LEV 25:28" />कोदाम तेरे जुव आपसो वाटु पोछु छुड़ेवने जुगु धोन नी होय, ती जागु लेनेवावान हातोम जुबली वावे साल लोगुन रोवसे। जुबली वावा साल मा जागु आपसुत् छुट जासे आरू वेचने वावान पोछु होकम होय जासे।<verse eid="LEV 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 25:29" />ओळी कोदाम कुदु मानुस मोटला भितड़ा वावा सोहरोम रोवने जुगु घोर वेचे, ती चु वेचनेन ओळतेन साल भोर मा तिनाक छुड़वी कोरे, कोवे ती आखु साल भोरीन तिना मानुस काजे छुड़ोवनेन होक रोवसे। <verse eid="LEV 25:29" /><verse number="30" style="v" sid="LEV 25:30" />पुन कोदाम साल भोरीन नी छुटे, ती चो घोर जो मोटला भितड़ा वावा सोहरोम छे मुले लेने जुगु बोनलो रोवे, आरू पीढ़ी-पीढ़ी लोगुन तेरात् ओवलियाद जुगु बोनलो रोवे, आरू जुबली वावा सालोम वी नी छुटे। <verse eid="LEV 25:30" /><verse number="31" style="v" sid="LEV 25:31" />पुन विगुर मोटला भितड़ा वावा गांवोम वावा घोर ते देसोन खेतो जोसा गिनाये; जिन्दरो छुड़ेवनो वी होय सोके, आरू चे जुबली वावा साल मा छुट जासे। <verse eid="LEV 25:31" /><verse number="32" style="v" sid="LEV 25:32" />ओळी वी लेवी मानसोन आपसा वाटान सोहरोन जे घोरे छे तेनुक लेवी मानसो जोत्यार मोरजी पोड़े तोत्यार छुड़वी लेय। <verse eid="LEV 25:32" /><verse number="33" style="v" sid="LEV 25:33" />आरू कोदाम लेवी मानुस आपसु वाटु नी छुड़वे, ती चो वेचलो घोर जे हेरा वाटान सोहोरोम जुबली वावा सालोम छुट जाय; काहकि इसरारली मानसोन इचमा लेवी मानसोन वाटु हेन्दरा सोहरोम चे घोरूत् छे। <verse eid="LEV 25:33" /><verse number="34" style="v" sid="LEV 25:34" />पुन तिन्दरा गावोन च्यारू मेर ढुरोक चारनेन जागु नी वेचाये; काहकि चु जोलोम जुगु तेन्दरु वाटु कोवाये।<verse eid="LEV 25:34" /></para>
  <para style="s">गोरब्या काजे उदार आपनो</para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 25:35" />कोदाम तारू भाय बोन्यु गोरीब होय जाय, आरू तेरे पोर तुसेक गीन आवे ओसो होय, ती तु तिनाक सोमावजी; चु पारका एने वाट चाला जोसु रोवे। <verse eid="LEV 25:35" /><verse number="36" style="v" sid="LEV 25:36" />तेरे जुळ इयाज एने वोदु पोस्या झुन लेये; भोगवानोन बिक मानजी; जेरेसी तारू भाय बोन्यु तारे पुठी जिवतु रोय सोके। <verse eid="LEV 25:36" /><verse number="37" style="v" sid="LEV 25:37" />तिनाक इयाजता रूप्या झुन आपे, आरू नी काय खानेन सोमान नोफु कोमायने कोरीन आपे। <verse eid="LEV 25:37" /><verse number="38" style="v" sid="LEV 25:38" />हांव तुमरू योहोवा भोगवान छे; हांव तुमुक कोनान मुलुक आपने जुगु आरू तुमरू भोगवान रोवीस ओस कोरीन तुमुक मिसर मुलुक गोथु निकाव लावलु छे।<verse eid="LEV 25:38" /></para>
  <para style="s">पावरीया काजे छुड़ावने नेम</para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 25:39" />कोदाम तारू भायबोन्यु तारे ओगोव गोरब्यु होयीन आपसा काजे तारा हातोम वेच देय, ती तेरेसी पावोर जोसु काम झुन कोरावतु। <verse eid="LEV 25:39" /><verse number="40" style="v" sid="LEV 25:40" />चु तार पुठी दाहड़क्यु एने वाट चालु जोसु रोवे, आरू जुबली वावा साल लोगुन पुठी रोवी चाखरी कोरतु रोवे; <verse eid="LEV 25:40" /><verse number="41" style="v" sid="LEV 25:41" />तोत्यार चु बाळ-बच्चा भेळ तारेनचा गोथु जात रोवे, आरू आपसा घोरल्या मा आरू आपसा बासोन वाटा मा पोछु जात रोवे। <verse eid="LEV 25:41" /><verse number="42" style="v" sid="LEV 25:42" />काहकि चे मारा पावरीया छे, जेनुक हांव मिसर मुलुक गोथु निकाय लावलु छे; एरकरीन चे दासन रीतीये नी वेचनो। <verse eid="LEV 25:42" /><verse number="43" style="v" sid="LEV 25:43" />तेर पोर ओनाड़ु बोनीन होक झुन कोरतु; आपसा भोगवानोन बिक मानतु रोवजी। <verse eid="LEV 25:43" /><verse number="44" style="v" sid="LEV 25:44" />तारा जे पावोर-पावेरनिया होय चे तुमरा च्यारू मेरोन जातिम गोथा रोवे, आरू पावरीया आरू पावेरनिया तेनुम गोथा मुले लेजु। <verse eid="LEV 25:44" /><verse number="45" style="v" sid="LEV 25:45" />जे वाट चाला तुमरे इचमा पारका बोनीन रोवसे, तेनुम गोथा आरू तेन्दरा घोरानाम गोथा वी जे तुमरे आड़े धोड़े होय, आरू तुमरा मुलुक मा पोयदा होया होय, तेनुम गोथा पावोर आरू पावेरनिया मुले लेजु; आरू चे तुमरोत् धोन कोवायसे। <verse eid="LEV 25:45" /><verse number="46" style="v" sid="LEV 25:46" />तुमु आपसा पुर्याक वी जे तुमरे ओळतेन होयसे तिन्दरा हकोम कोर सोकु, आरू त्या हेनको वाटो कहवायसे; हेनुम गोथा तुमु जलोम आपसे जुगु पावोर लिया कोरजु, पुन तुमरा भायबोन्या जे इसराएली होय हेनु पोर तुमरो होक ओनाड़ा बनीन झुन कोरता।<verse eid="LEV 25:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 25:47" />कोदाम तुमरे पुठी रोवने वावु पारकु एने वाट चाला मा मातभोर होय जाय, आरू तेरे ओगोव तारू भाइस गोरीब होयीन आपसा काजे तारे ओगोव पारकु एने वाट चसलु एने आपसी ओवलियाद काजे वेज देय, <verse eid="LEV 25:47" /><verse number="48" style="v" sid="LEV 25:48" />ती तेरे वेचायनेन ओळतेन चु ओळी पोछु छुट सोके; तेरा भास्यो मा गोथु कुदु वी छुड़वी सोके, <verse eid="LEV 25:48" /><verse number="49" style="v" sid="LEV 25:49" />तेरू काकु, कुदु भाईस, आरू तेरा घोराना मा कुदु वी जु तेरे साते वावु छे छुड़वी सोके; निन्ते कोदाम चु मातभोर होय जाय, ती आपसाक वी छुड़वी सोके। <verse eid="LEV 25:49" /><verse number="50" style="v" sid="LEV 25:50" />चु आपसाक मुले लेनेवावा पुठी आपसा वेचायनेन साल गोथु जुबली वावा साल लोगुन हिसाब कोरे, आरू तेरा वेचायनेन किमोत जोतरा सालोन गिनतीन ओनसारे होय, मोतलोब जु दाम दाहाड़क्यान दाहड़ान जोसु रोवसे। <verse eid="LEV 25:50" /><verse number="51" style="v" sid="LEV 25:51" />कोदाम जुबली वावु साल आवने घोना साल रोवे, ती जोतरा रूप्यान चु वेचायलु होतु, तेरेम गोथु चु आपसाक छुड़ोवनेन दाम तोतरा सालोन ओनसारे आप देय। <verse eid="LEV 25:51" /><verse number="52" style="v" sid="LEV 25:52" />कोदाम जुबली वावु साल आवने थुड़ाक साल रोया होय, ते वी आपसा मालीक पुठी हिसाब कोरीन आपसा छुड़ावने दाम तोतरात् सालोन ओनसारे आप देय। <verse eid="LEV 25:52" /><verse number="53" style="v" sid="LEV 25:53" />चु आपसा मालीक पुठी तेना दाहाड़क्या जोसु रोवे जोसु वोरीसदाय दाहाड़की नोक्खी कोरली होय; आरू तेरू मालीक तेरे पोर तार ओगोव वातड़ु बोनीन होक नी कोरनो जुवे। <verse eid="LEV 25:53" /><verse number="54" style="v" sid="LEV 25:54" />आरू कोदाम चु इनु रिती सी नी छुटे, ती चु जुबली वावा सालोम आपसा बाळ-बच्चा भेळ छुट जाय। <verse eid="LEV 25:54" /><verse number="55" style="v" sid="LEV 25:55" />काहकि इसराएली मारात् चाखरीया छे; चे मिसर मुलुक गोथा मारात् निकावला चाखरीया छे; हांव तुमरू योहोवा भोगवान छे।<verse eid="LEV 25:55" /></para>
  <chapter eid="LEV 25" />
  <chapter number="26" style="c" sid="LEV 26" />
  <para style="s">नेम पाळनेन फोव</para>
  <para style="r">(<ref loc="DEU 7:12-24">व्यवस्थाविवरण 7:12-24</ref>; <ref loc="DEU 28:1-14">28:1-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 26:1" />तुमु आपसा जुगु मुरती झुन बोनावता, आरू नी काहनी खुन्दली मुरती आरू खाम्बा काजे उबु कोरू, आरू नी आपसा मुलुकोम वांदने कोरीन दोगड़ाक घोड़ीन उबु कोरू; काहकि हांव तुमरू योहोवा भोगवान छे। <verse eid="LEV 26:1" /><verse number="2" style="v" sid="LEV 26:2" />तुमु मारा आरामोन दाहड़ान पाळनी पावजु आरू मारा चुखला जागान बीक राखजु; हांव योहोवा भोगवान छे।<verse eid="LEV 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 26:3" />कोदाम तुमु मारा कायदा पोर चालु आरू मारा हुकुम काजे मानीन तेनुन पाळनी पाळजु, <verse eid="LEV 26:3" /><verse number="4" style="v" sid="LEV 26:4" />ती हांव तुमरे जुगु टेम टेम पानी पाड़ीस, आरू धोरती आपसी मेर उगाड़से, आरू खोयड़ान झाड़का पोर आपसो आपसो फोव फोळसे; <verse eid="LEV 26:4" /><verse number="5" style="v" sid="LEV 26:5" />यां लोगुन कि तुमु ओंगुर तुड़नेन टेमे दावनी कोरता रोवसु, आरू वेरनीन टेम पोर वी पेट भोरीन खाया कोरसु, आरू तुमुक गोंहोवता रूटा खाया कोरसु, आरू आपसा मुलुकोम बेफिकरीया रोया कोरसु। <verse eid="LEV 26:5" /><verse number="6" style="v" sid="LEV 26:6" />आरू हांव तुमरा मुलुकोम सुक शान्ति आपीस, आरू तुमु सुवसू आरू तुमुक बिहाड़नेवावो नी रोवे; आरू हांव तुमरा देसोम जोंगली जोनवारे जे मानसोन नुकासानी कोरे तेनुक रोवने नी देयो, आरू काहनो वी मुलकेम वावा तुमरे भुने तोलवार नी चालाड़े। <verse eid="LEV 26:6" /><verse number="7" style="v" sid="LEV 26:7" />आरू तुमु आपसा वेरी काजे कुटिन ढासाड़ देसु, आरू चे तुमरी तोलवार सी हिट पोड़से। <verse eid="LEV 26:7" /><verse number="8" style="v" sid="LEV 26:8" />तुमरेम पाच मानसे सोव जोनाक आरू सोव मानसे होजार जोनाक नी बोदे; आरू तुमरा वेरी तुमरे ओगोव हिट पोड़से; <verse eid="LEV 26:8" /><verse number="9" style="v" sid="LEV 26:9" />आरू हांव तुमरे भेनी गिनोन निंगा राखीस आरू तुमुक बोरकोत आपीस आरू गिनाये नी ओसा होय जासु, आरू तुमरे पुठी मारू वायदु पुरू कोरीस। <verse eid="LEV 26:9" /><verse number="10" style="v" sid="LEV 26:10" />आरू तुमु मेकला जुनला ओनो काजे खाया कोरसु, आरू नोवलो ओन रोवसे ते वी जुनलो ओन खासु। <verse eid="LEV 26:10" /><verse number="11" style="v" sid="LEV 26:11" />हांव तुमरे विच मा रोया कोरीस, आरू मारो जीव तुमरे सी घाड़ाय नी कोरे। <verse eid="LEV 26:11" /><verse number="12" style="v" sid="LEV 26:12" />आरू हांव तुमरे विच मा चाल्या फिर्या कोरीस, आरू तुमरू भोगवान रोवीस, आरू तुमु मारा मानसे बोना रोवसु। <verse eid="LEV 26:12" /><verse number="13" style="v" sid="LEV 26:13" />हांव योहोवा, तुमरू परमेश्वर छे। हांव तुमुक मिसर मुलकोम गोथु निकाय लावलु कि तुमु मिसर वावान पावरीया बोनला नी रोवु; आरू हांव तुमरा जुड़ाक तुड़ नाख्यु, ततरू तुमु सुदु उबु कोरीन चालाड़्यु।<verse eid="LEV 26:13" /></para>
  <para style="s">हुकुम नी माननेन डोन</para>
  <para style="r">(<ref loc="DEU 28:15-68">व्यवस्थाविवरण 28:15-68</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 26:14" />कोदाम तुमु मारी नी सोमवु, आरू एनू आखा हुकुम काजे नी मानसु, <verse eid="LEV 26:14" /><verse number="15" style="v" sid="LEV 26:15" />आरू मारा कायदा काजे उदुड़ जानसु, आरू तुमरो जीव मारा नियाव सी घाड़ाय कोरू, आरू तुमु मारा आखा हुकुमोन पाळोन नी कोरसु, पुन मारा वायदाक तुड़सु, <verse eid="LEV 26:15" /><verse number="16" style="v" sid="LEV 26:16" />ती हांव तुमरे सी ओसु कोरीस; मोतलोब हांव तुमरे सी डोगाय जाईस, आरू टीवीन बिमारी आरू सेरी सी मांदु पाड़ीस, आरू जेरेसी तुमरा डुळा धुंदवाय जासे, आरू तुमरे मोन धोनो घाबराय जासे। आरू तुमरा बिज बिगड़ी जासे, काहकि तुमरा वेरी तुमरी मेर खाय जासे; <verse eid="LEV 26:16" /><verse number="17" style="v" sid="LEV 26:17" />हांव तुमरे भेनी गोथु आड़ु भाय लिस, जेरेसी तुमु आपसा वेरी ओगोव हार जासु। जिनुसी तुमु घाड़ाय कोरे, चेत् तुमरे पोर होक कोरसे। तुमरे पोछोळ कुदु नी पोड़े, तीवी तुमु ढासता रोवसु। <verse eid="LEV 26:17" /><verse number="18" style="v" sid="LEV 26:18" />आरू कोदाम तुमु इनी वातोन ओळतेन वी मारी नी सोमवु, ती हांव तुमरा पापोन कोरता तुमुक सातगुना वेला आपीस, <verse eid="LEV 26:18" /><verse number="19" style="v" sid="LEV 26:19" />आरू हांव तुमरा ताकोतोन घाड़ाय काजे तुड़ दीस, आरू तुमरे जुगु वादवा काजे लुहड़ा जोसु वातड़ु, आरू धोरती काजे पीतवो जोसु बोनाय दीस की पानी नी पोड़से। <verse eid="LEV 26:19" /><verse number="20" style="v" sid="LEV 26:20" />तो्यार धोरती पोर तुमरी आखी मेहनोत वायबार होय जासे; काहकि धोरतीन मेर नी उगे आरू खोयड़ान झाड़े फोव नी फोवे।<verse eid="LEV 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 26:21" />कोदाम तुमु मारे विरूद् चालतात् रोवसु, आरू मारो कोवनो नी मानु, ती हांव तुमरा पापोन ओनसारे तुमरे पोर आरू सातगुना वेला आपीस। <verse eid="LEV 26:21" /><verse number="22" style="v" sid="LEV 26:22" />आरू हांव तुमरे विच जोंगली जोनवारे मुकलीस, जे तुमरा पुर्याक तुमरेनचा गोथा चुटलीन जात रोवसे, आरू तुमरा घोरून ढुरोक फाड़ खासे, आरू तुमरी गिनती कोम होय जासे, , जेरेसी तुमरी सोयड़ोक सुनी पोड़ जासे।<verse eid="LEV 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 26:23" />"ओळी कोदाम तुमु एनू वातो पोर वी मारी आपली गरा सी नी सुदरू, आरू मारे विरुद् चालतात् रोवसू, <verse eid="LEV 26:23" /><verse number="24" style="v" sid="LEV 26:24" />ती हांव वी तुमरे विरुदच चालीस, आरू तुमरा पापोन कोरता हांव आपसुत् तुमुक सातगुना दीस। <verse eid="LEV 26:24" /><verse number="25" style="v" sid="LEV 26:25" />हांव तुमरे पोर वेरीन होमलु कोरावीस, जु वायदु तुड़नेन पुरून पुरू बोदलु लेसे; आरू जो्त्यार तुमु आपसा सोहरोम एकठा होयसु ती हांव तुमुरे पोर काळ मुकलीस आरू तुमु वेरीन हातोम धोराय जासु। <verse eid="LEV 26:25" /><verse number="26" style="v" sid="LEV 26:26" />जोत्यार हांव तुमरे जुगु खानेन ओन तुमरे जुळ गोथु छेटु कोर दीस, तोत्यार दोस बायरा एकुत तोवा पोर रूटा बोनावसे, आरू चे तुमुक रूटा तुली तुलीन आपसे, आरू तुमु रूटा खासु ती वी नी आफरू।<verse eid="LEV 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 26:27" />ओळी कोदाम तुमु एनी वातोन ओळतेन वी मारी नी सोमवु, आरू मारे विरुद् चालता रोवसु, <verse eid="LEV 26:27" /><verse number="28" style="v" sid="LEV 26:28" />ती हांव मारो नियाव तुमरे विरुद् चालीस, आरू तुमरा पापोन कोरता तुमुक सातगुना लोगुन वेला ओवी जादा आपीस। <verse eid="LEV 26:28" /><verse number="29" style="v" sid="LEV 26:29" />आरू तुमुक आपसा पुर्या आरू पुरायटान मास खानो पोड़से। <verse eid="LEV 26:29" /><verse number="30" style="v" sid="LEV 26:30" />आरू हांव तुमरा डाहडान पुजा कोरनेन उचला जागाक उदार दीस, आरू तुमरी धुपोन वेदी काजे नास कोर दिस। तुमरा देवता काजे उदेरला मुरतिया पोर तुमरा धोड़ नाखीस। आरू मारू जीव तुमरे सी सीगी कोरसे। <verse eid="LEV 26:30" /><verse number="31" style="v" sid="LEV 26:31" />आरू हांव तुमरा सोहरोक उजाड़ दिस, आरू तुमरा चुखला जागाक उजाड़ दिस, आरू तुमरा सुकोन गोंदायन्या काजे नी सुंगो। <verse eid="LEV 26:31" /><verse number="32" style="v" sid="LEV 26:32" />आरू हांव तुमरा मुलुक काजे सुनलो कोर दिस, आरू तुमरा वेरी जे जां रोवे चे इनी वातोन कोरता ओका बोकी होय जासे। <verse eid="LEV 26:32" /><verse number="33" style="v" sid="LEV 26:33" />आरू हांव तुमुक बेसका मुलकोम रिवन्या तिवन्या कोरीस, आरू तुमरे विरूद् आपसुत् तोलवार काजे निकाव लीस। तुमरो मुलुक सुनलो होय जासे। तुमरो सोहोर उजाड़ होय जासे।<verse eid="LEV 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LEV 26:34" />जोत्यार लोगुन तुमु आपसा वेरीन मुलकोम रोवसु आरू तुमरी जागा सुनली पोड़ रोवसे, तोत्यार लोगुन धोरती आरामोन सालोन खुसी सी पाळनी पाळसे। धोरती आराम कोरसे आरू आरामोन सालोन खुसी सी पाळनी कोरसे। <verse eid="LEV 26:34" /><verse number="35" style="v" sid="LEV 26:35" />जोतरा दाहडा हुयो सुनलो पोड़ रोवसे तोतरा दाहड़ा तिनाक आराम रोवसे, मोतलोब जो आराम तुमरे होंया रोवते तुमरा आरामोन टेम मा नी जोड़्यो होसे चो तव जोड़से। <verse eid="LEV 26:35" /><verse number="36" style="v" sid="LEV 26:36" />आरू तुमरे मा गोथो जे वाचला रोवसे आरू आपसा वेरी मुलकोम होसे तिन्दरा मोनोम बिक बोसाड़ दीस; आरू चे पान्टा खोकेड़से ती वी ढास जासे, आरू चे ओसा ढाससे जोसा तोलवार सी वाचने ढासे, आरू कुदु पोछोव नी पोड़े ती वी चे झोटवायता ने पोड़ता जासे। <verse eid="LEV 26:36" /><verse number="37" style="v" sid="LEV 26:37" />जोत्यार कुदु पोछोव नी आवे ती वी ओसा जासे जोसा तोलवारोन बीके एक दिसरान आफठायीन पोड़ जासे, आरू तुमरेम आपसा वेरी ओगोव उबरोवने हेमो नी रोवसे। <verse eid="LEV 26:37" /><verse number="38" style="v" sid="LEV 26:38" />तोत्यार तुमु मुलको मा पुगीन नास होय जासु, आरू तुमरा वेरीन जागा तुमुक खाय जासे। (तोत्यार तुमु मुलको मा पुगीन मोर जासु, तुमरा वेरीन जागा मा गाड़ाय जासु) <verse eid="LEV 26:38" /><verse number="39" style="v" sid="LEV 26:39" />आरू तुमरेम गोथा वाचला रोवसे चे आपसा वेरीन मुलकोम आपसा गुनान कोरता गोळ जासे; आरू आपसा डाहडान गुनान कामोन कोरता वी चे तिन्दरेन्द तोसा गोळ जासे।<verse eid="LEV 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LEV 26:40" />पुन कोदाम चे आपसा आरू आपसा बासोन गुनाक मान लेय, मोतलोब जे मारे साते धुकु कोरीन आरू मारा कोयान नी चाल्या। <verse eid="LEV 26:40" /><verse number="41" style="v" sid="LEV 26:41" />ओतरान कोरता हांव हेन्दरे विरुद् चाल्यु, आरू हेनुक वेरीन मुलकोम ली आवलु, कोदाम चे आपसा वातड़ा जीयोक निचवो कोरसे, आपसा गुनान डोन काजे मान लेसे। <verse eid="LEV 26:41" /><verse number="42" style="v" sid="LEV 26:42" />ती हांव याकुब, इसहाक आरू ओबराहाम पुठी वायदु बांदलु चु फोम कोरीस, हांव तुमरा जागा काजे फोम कोरीस। <verse eid="LEV 26:42" /><verse number="43" style="v" sid="LEV 26:43" />पुन चो देस हेन्दरे गोथो पेहेल सुनलो होयीन पोड़लो रोवसे, आरू हेन्दरे विगुर रोवीन वी आपसा आरामोन टेम काजे मानतो रोवे; आरू चे मानसे आपसा गुनान डोन काजे मानसे, ओतरान कोरता कि हुये मारा हुकुम काजे नी मान्या, आरू हेन्दरा जीयो काजे मारा नेम सी घाड़ाय होती। <verse eid="LEV 26:43" /><verse number="44" style="v" sid="LEV 26:44" />ओतरा पोर वी जोत्यार चे आपसा वेरीन मुलकोम होसे तोत्यार हांव तेनुक ओस कोरीन नी छुड़ो, आरू नी हेनुसी ओसु सिगी कोरो कि हेन्दरो नास कोर नाखो आरू आपसा वायदा काजे तुड़ दोम जो हांव हेनुसी वायदु कोरलु होतु; काहकि हांव हेन्दरू योहोवा भोगवान छे; <verse eid="LEV 26:44" /><verse number="45" style="v" sid="LEV 26:45" />पुन हांव हेन्दरी भोलाय जुगु हेन्दरा बासो सी बान्दला वायदा काजे फोम कोरीस; जेनुक हांव आड़जात्यान डुळा ओगोव मिसर मुलकोम गोथु निकावीन लायु कि हांव हेन्दरु भोगवान कोवायो; हांव योहोवा भोगवान छे।<verse eid="LEV 26:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 26:46" />जे-जे नेम कायदा आरू नेम आरू हुकुम योहोवा भोगवान आपसे वोगे गोथु इसराएली मानसो जुगु सिनाय बोयड़ा पोर मुसान लारे कोयु चे येत् छे।<verse eid="LEV 26:46" /></para>
  <chapter eid="LEV 26" />
  <chapter number="27" style="c" sid="LEV 27" />
  <para style="s">मानतान नेम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 27:1" />योहोवा भोगवान मुसा काजे कोयु, <verse eid="LEV 27:1" /><verse number="2" style="v" sid="LEV 27:2" />“ इसराएली मानसो काजे ओसु कोवजी कि जोत्यार खास मानता माने, ती मानता कोरला जीव तारे कोवनेन ओनसारे योहोवा भोगवानोन होयसे; <verse eid="LEV 27:2" /><verse number="3" style="v" sid="LEV 27:3" />एरकरीन कोदाम चु वीस सालोन नीते हेरेसी जादा आरू तीन वीस साल गोथु कोम उमोरोन ओदमी होय, ती तेरे जुगु चुखला जागान चांदीन सिक्कान ओनसारे पोचास सिक्का कोवाये। <verse eid="LEV 27:3" /><verse number="4" style="v" sid="LEV 27:4" />कोदाम ची बायोर होय, ती तीस चांदीन सिक्का रोवसे। <verse eid="LEV 27:4" /><verse number="5" style="v" sid="LEV 27:5" />ओळी कोदाम तेरी उमोर पाच साल नीते तेरेसी जादा आरू वीस साल गोथा कोमोन होय, ती पुर्या जुगु वीस सिक्का, आरू पुराय जुगु दोस सिक्का। <verse eid="LEV 27:5" /><verse number="6" style="v" sid="LEV 27:6" />कोदाम तेन्दरी उमोर एक मोहनान नीते तेरेसी जादा आरू पाच साल गोथी कोम होय , ती पुर्या जुगु पाच सिक्का आरू पुर्या जुगु तीन सिक्का कोवाये। <verse eid="LEV 27:6" /><verse number="7" style="v" sid="LEV 27:7" />ओळी कोदाम तेरी उमोर तीन वीस साल होय नीते तेरेसी जादा होय, चु ओदमी होय ती तेर जुगु पोन्दरे सिक्का, आरू बायोर जुगु दोस सिक्का कोवाये। <verse eid="LEV 27:7" /><verse number="8" style="v" sid="LEV 27:8" />पुन कोदाम कुदु ओतरू गोरीन होय कि पुजारान आकलो दाम आपी नी सोके, ती तिनाक पुजारा ओगोव उबु कोरजु, आरू पुजारू तेर जुगु टोका आकसे, मोतलोब जोतरी मानता कोरनेवा सी होय सोके, पुजारू तेरेत हिसावे मेकसे।<verse eid="LEV 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 27:9" />“ओळतेन जेनु ढुरोम गोथा योहोवा भोगवान काजे चोड़ावु, कोदाम ओसी काहनी मानता होय, ती जु ढुर कुदु योहोवा भोगवाग काजे आपे चो चुखलो कोवायसे। <verse eid="LEV 27:9" /><verse number="10" style="v" sid="LEV 27:10" />मानता चोड़ावने वावु काहने वी भातीन नी बोदले, नी ते चु बुरान बोदले वारू, आरू नी वारलान बोदलाम भुन्डो आपे; आरू कोदाम चु तेना ढुरोन बोदलाम दिसरो ढुर आपे, ती चो आरू हेरू बोदलु दुयु चुखला कोवायसे। <verse eid="LEV 27:10" /><verse number="11" style="v" sid="LEV 27:11" />कोदाम चो ढुर विटोळ होय, जिनाक योहोवा भोगवान काजे चोड़ावा मा नी चोड़ाया होय, ती मानता राकने वावु मानुस ओसु ढुर पुजारा ओगोव उबराखसे। <verse eid="LEV 27:11" /><verse number="12" style="v" sid="LEV 27:12" />पुजारू ढुरोक पारेखसे की चो वारू होय की नी। जोसो पुजारा काजे पारोखने मा मालुम पोड़े , तोसोत् मानसे। <verse eid="LEV 27:12" /><verse number="13" style="v" sid="LEV 27:13" />पुन कोदाम मानता राखने वावु तिनाक काहने रिते छुड़ावने हिन्डे, ती जु दाम पुजारू कोवसे तेरेम पाचवु वाटु आरू जुड़ीन आपसे।<verse eid="LEV 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 27:14" />“ओळी कोदाम कुदु मानुस आपसा घोरो जुगु मानता मानतु होय कि हेरो घोर मारा पोरबु जुगु चुखो रोवे, ती पुजारू तेरा वाराम विचारीन कि वारू छे की भुन्डो छे; आरू जोतरो पुजारू कोवे तेर हिसाबे दाम होतरोत रोवसे। <verse eid="LEV 27:14" /><verse number="15" style="v" sid="LEV 27:15" />आरू कोदाम घोरोक चुखो कोरावने वावु तिनाक छुड़ेवने हिन्डे, ती जोतरा रूप्या पुजारू तेरो दाम कोयु होय तेरेम रोईन पाचवु वाटु आरू बोड़ावीन आपे, ती चो घोर तेरोत रोवसे।<verse eid="LEV 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 27:16" />“कोदाम कुदु मानुस आदसी जागान वाटु योहोवा भोगवान जुगु चुखी कोरावने चाहाय, ती हेरो दाम ऐर ओनसारे होयसे कि तिना खेतोम कोतरो बिज पोड़से; जोतरा जागामा कांगनी भोरीन जोव गोंहोव पोड़े तोतरा जुन दाम पोचास चांदीन सिक्का कोवायसे। <verse eid="LEV 27:16" /><verse number="17" style="v" sid="LEV 27:17" />कोदाम चु जुबली वावा सालोम चुखो कोरावे, ती तेरो दाम तार कोवले होयनो जुवे। <verse eid="LEV 27:17" /><verse number="18" style="v" sid="LEV 27:18" />पुन कोदाम चु जुबली वावा सालोन ओळतेन आपसा खेतोन मानता मानसे, ती जोतरा साल आवने वावा जुबली वावा साल वाच रोवसे, तेर हिसाबे पुजारू खेतोन हिसाब लागाड़से, आरू तुमरे हिसाबो मा सी कोम होये। <verse eid="LEV 27:18" /><verse number="19" style="v" sid="LEV 27:19" />आरू कोदाम खेतोन चुखो कोरावने वावु तिनाक छुड़वी लेनो चाहाय, ती जो दाम पुजारू कोवलु तेरेम गोथो पाचवु वाटु आरू वोदाड़ीन आपसे, ती खेत तेरोत रोवसे। <verse eid="LEV 27:19" /><verse number="20" style="v" sid="LEV 27:20" />पुन कोदाम चु खेत काजे छुड़ेवने नी चाहाय, कोदाम चु आपसा खेतोक दिसरा मानसोक वेच देसे ती पोछो छुड़ाय नी सोके। <verse eid="LEV 27:20" /><verse number="21" style="v" sid="LEV 27:21" />पुन जोत्यार चु खेत जुबली वावा सालोम छुटे, तोत्यार पुरी रिती सी चोड़ावला खेतो जोसो योहोवा भोगवान जुगु चुखलो कोवाये, चु पुजारान आपसु जागु होय जासे। <verse eid="LEV 27:21" /><verse number="22" style="v" sid="LEV 27:22" />ओली कोदाम कुदु आपसो मुले लेदला खेत, जु आपसु वाटान खेतोन नी रोवे, योहोवा जुगु चुखलो कोवायसे। <verse eid="LEV 27:22" /><verse number="23" style="v" sid="LEV 27:23" />ती पुजारू जुबली वावा साल लोगुन हिसाव कोरीन तिना मानुस जुगु जोतरो कोवे तोतरोत् चु योहोवा जुगु चुखो जानीन तेनेत् दाहड़े आप देय। <verse eid="LEV 27:23" /><verse number="24" style="v" sid="LEV 27:24" />जुबली वावा साल मा चु खेती तेरेत् होकोम जेरेसी चु मुले लेदु होय ओळी आय जाय, जेरू खास वाटु छे तेरूत् पोछु होय जाय। <verse eid="LEV 27:24" /><verse number="25" style="v" sid="LEV 27:25" />आखो हिसाब चुखला जागान तुलो मा होयसे। चांदीन एक सिक्कु बारे गोरामोन होयसे।<verse eid="LEV 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 27:26" />“पुन पावन्या ढुरोन पेहलो वाछड़ो, जो पेहलो होयने कोरता योहोवा भोगवानोन कोवाये, तिनाक कुदु मानता नी मानसे; चाहय चो वाछड़ो होय, चाहाय गाडरो बुकड़ीन गिदल्यो, चो योहोवा भोगवानोन छे। <verse eid="LEV 27:26" /><verse number="27" style="v" sid="LEV 27:27" />बाखुन कोदाम चो विटोळ ढुरोन होय, ती तिनाक चुखो कोवाड़नेवावु तिनाक पुजारान कोवला दामोन ओनसारे तेरु पाचवु वाटु आरू वोदाड़ीन छुड़ाय सोके; आरू कोदाम चु नी छुड़ावे, ती पुजारान कोवला दामोन ओनसारे वेचाय जाय।<verse eid="LEV 27:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 27:28" />“बाखुन आपसी आखी चिजोम गोथो थुड़ोक कुदु योहोवा भोगवान जुगु चोड़ाया कोरे, चाहाय मानुस होय चाहाय ढुर, चाहाय आपसा वाटान खेत होय, ओसी काहनी चोड़ावली चिज नी वेचाये आरू नी छुड़वे; जो काहिन चोड़ावलो छे चो योहोवा जुगु बेसको चुखलो कोवाये। <verse eid="LEV 27:28" /><verse number="29" style="v" sid="LEV 27:29" />मनुस मा गोथो जो काहिन मोतोन डोन जुगु चोड़ावलो होय छुड़वी नी सोके; पाको चो मार नाख्यो जाय।<verse eid="LEV 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 27:30" />“ ओळी खेतीन मेरोन दोसवु वाटु, चाहाय चु खेतीन बिज होय चाहाय झाड़ोन फोव, चो योहोवा भोगवानोन छे; चो योहोवा जुगु चुखलो कोवाये। <verse eid="LEV 27:30" /><verse number="31" style="v" sid="LEV 27:31" />कोदाम कुदु आपसा दोसवा वाटाम गोथु काहिन छुड़ेवने चाहाय, ती पाचवु वाटु वोदाड़ीन तिनाक छुड़ावे। <verse eid="LEV 27:31" /><verse number="32" style="v" sid="LEV 27:32" />आरू गाय-बुईल, आरू गाडरा-बुकड़ा, जे-जे ढुरे गिनने जुगु लाकुड़ोन नेचा सी निकवी जाने वावा छे तेरो दोसवु वाटु, दोस दोस पोछोव एक एक ढुर योहोवा जुगु चुखलो कोवाये। <verse eid="LEV 27:32" /><verse number="33" style="v" sid="LEV 27:33" />कुदु वारू भुन्डान पारोख नी कोरे, आरू नी तेर बोदलाम; आरू कोदाम कुदु तेर बोदले वी लेये, ती चो आरू तेरे बोदले वावो दुयु चुखला कोवाये; आरू चो कोदी नी छुड़ावसे।”<verse eid="LEV 27:33" /></para>
  <para style="pi">
    <verse number="34" style="v" sid="LEV 27:34" />जो हुकुम योहोवा भोगवान इसराएली मानसो जुगु सिनाय बोयड़ा पोर मुसा काजे आपलु होतु चे येत् छे।<verse eid="LEV 27:34" /></para>
  <chapter eid="LEV 27" />
</usx>