<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TH" style="id">– Dhankavi</book>
  <para style="h">2 थिस्सलुनीकियो</para>
  <para style="toc3">2 थिस्सलुनीकियो</para>
  <para style="toc2">2 थिस्सलुनीकियो</para>
  <para style="toc1">थिस्सलुनीकियो क पौलुसन दिसरी पत्री</para>
  <para style="mt2">थिस्सलुनीकियो को पौलुस कि दूसरी पत्री</para>
  <para style="mt1">थिस्सलुनीकियो क पौलुसन दिसरी पत्री</para>
  <para style="imt">परिचय</para>
  <para style="ip">पत्री यो थिस्सलुनीकियो लिखी गयी प्रेरित पौलुस ने लिखी होती <char style="xt"><ref loc="2TH 1:1">1:1</ref></char> पेहली पत्री लिखने क बाद यो पत्री करी बन मसीह क पचास ने एक साल बाद त्यो यो पत्री लिखी जव त्यो यो पत्री लिखी तव वो कुरीन्थ शहर मा हुता यो पत्री थिस्सलुनीकियो मंडळी क लिखी गयी यो मंडळी पौलुस ने आपने दिसरा मिशनरी यात्रा क लारे स्थापित कर्‍या। <char style="xt"><ref loc="ACT 17:1-10">प्रेरितन 17:1-10</ref></char></para>
  <para style="ip">प्रेरितन क काम मा यो लिख्या छे यो मंडळी काही यहूदि आरू काही गैरयहुदी बनला हुता यो मंडळी क मानसे आखरी टेहाव आरू पोरबु क दिसरा आवनो क बारा मा यो थिस्सलुनीकियो क मानसे जानने क करता घोणा मरजी होती एरकरीन आपसी दुय पत्री मा चर्चा करता छे थिस्सलुनीकियो पत्री क करीबन आधा हिस्सा आखरी टेहाव क बारा छे यो पौलुस जो आलसी छे उनको की चेतावनी करता छे। आरू यो कयता छे कि हरेक ओदमी खुद क पेट भरने क करता काम करे। <char style="xt"><ref loc="2TH 3:6-10">3:6-10</ref></char></para>
  <para style="is">रूप रेखा</para>
  <para style="io1">1. पौलुस खुद क आरू आपने साथीयो क परिचय करता छे। <char style="ior"><ref loc="2TH 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. पौलुस क यहोवा–भगवान क थस्सलुनीकियो की मंडळी क करता धन्यावद करता छे आरू ओको करता प्रार्थना करता छे। <char style="ior"><ref loc="2TH 1:3-12">1:3-12</ref></char></para>
  <para style="io1">3. आखरी टेहाव क बारा मा सुचना चर्चा <char style="ior"><ref loc="2TH 2">2</ref></char></para>
  <para style="io1">4. उजग्या विरोध आरू हावहनत क बारा पौलुस की शिक्षा। <char style="ior"><ref loc="2TH 3:1-15">3:1-15</ref></char></para>
  <para style="io1">5. पौलुस क मंडळी क पछु नमस्कार <char style="ior"><ref loc="2TH 3:16-18">3:16-18</ref></char></para>
  <chapter number="1" style="c" sid="2TH 1"/>
  <para style="s">नमस्कार</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 17:1">प्रेरितन 17:1</ref>
      </char>
    </note>पौलुस आरू सिलवानुस आरू तीमुथियुस</para>
  <para style="p" vid="2TH 1:1">कि आरू छे चिठ्ठी लिखी छे थिस्सलुनीकियों कि मंडळी क नाव, जो हामरे बास यहोवा–भगवान आरू पोरबु ईशु मसीह मा छे।<verse eid="2TH 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2"/>हामरे बास यहोवा–भगवान आरू पोरबु ईशु मसीह कि आरू छे तुमू फोकटन दया आरू शांती मिवती रवे।<verse eid="2TH 1:2"/></para>
  <para style="s">न्याय क दहाडू</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3"/>हे भाईस, आरू बहनीस तुमरे विषय मा हर टेहाव यहोवा–भगवान क धन्यवाद करने जुवे, आरू यो वारू भी छे एरकरीन कि तुमरा विश्वास खुप बढ़ता जाता छे आरू तुमू सब क मोंग आपस मा खुप ही बढ़तो जातो छे। <verse eid="2TH 1:3"/><verse number="4" style="v" sid="2TH 1:4"/>याहा तक कि हामु आप यहोवा–भगवान कि मंडळी मा तुमरो विषय मा डाहळाय करता छे की यात्रा झगड़ो करावनो आरू तकलीद तुमू सहित होय, उन सब मा तुमरो धीरज आरू विश्वास प्रगट हुयसे छे।<verse eid="2TH 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5"/>यो यहोवा–भगवान क सच्चा न्याय क स्पष्ट प्रमाण छे कि तुमू यहोवा–भगवान क राज्य क योग्य ठहराया, ओका करता तुमू दुःख भी हाकलिया होय। <verse eid="2TH 1:5"/><verse number="6" style="v" sid="2TH 1:6"/>काहकि यहोवा–भगवान क निकट यो न्याय छे कि जो तुमू तकलीद देता छे, तीनुक बदलने मा तकलीद देय। <verse eid="2TH 1:6"/><verse number="7" style="v" sid="2TH 1:7"/>आरू तुमू जो तकलीद देता होय, हामरे साथे हुक देय, ओका टेहाव जव कि पोरबु ईशु आपसा ताकत वाळा दूतोन क साथे धधकती होय अगो मा सोरग छे प्रगट होयछे। <verse eid="2TH 1:7"/><verse number="8" style="v" sid="2TH 1:8"/>आरू जो यहोवा–भगवान कि नी उवखता आरू हामरे पोरबु ईशु क खुश खबर क नी मानता उनछे पलटा लेछे। <verse eid="2TH 1:8"/><verse number="9" style="v" sid="2TH 1:9"/>वो पोरबु क सामने छे आरू ओकी शक्ति क तेज छे दूर हईन अमरकाय विनाश क दंड देखछे। <verse eid="2TH 1:9"/><verse number="10" style="v" sid="2TH 1:10"/>यो उना दाहड़ा मा हुयसे, जव चुखलो लोगहन मा महिमा लेने, आरू सब विश्वास करने वाळा उना दाहड़ा मा मोटो काम करसे, काहकि तुमू ने हामरी गवा पर विश्वास कर्‍या।<verse eid="2TH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11"/>एरकरीन हामु सदा तुमरे करता प्रार्थना भी करता छे कि हामरा यहोवा–भगवान तुमू इनीये बुलाहट क योग्य समझे, आरू भलाई की हर एक मरजी आरू विश्वास क हर एक काम क शक्ति सहित पूरो कर्‍या। <verse eid="2TH 1:11"/><verse number="12" style="v" sid="2TH 1:12"/>ताकि हामरे यहोवा–भगवान आरू पोरबु ईशु मसीह क फोकटन दया क लारे हामरे पोरबु ईशु मसीह क नाव तुमू मा महिमा देख्या, आरू तुमू उना मा।<verse eid="2TH 1:12"/></para>
  <chapter eid="2TH 1"/>
  <chapter number="2" style="c" sid="2TH 2"/>
  <para style="s">दुष्ट मानुस</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:1 </char>
      <char style="xt" closed="false">
        <ref loc="1TH 4:15-17">1 थिस्सलुनीकियो 4:15-17</ref>
      </char>
    </note>हे भाईस, आरू बहनीस हिमी हामु आपसा पोरबु ईशु मसीह क आवने, आरू ओका साथे आपने एखठा हुयने क विषय मा तुमू छे रावन्या करता छे। <verse eid="2TH 2:1"/><verse number="2" style="v" sid="2TH 2:2"/>कि काही आत्मा, या पत्री क द्वारा, जो कि मानु हामरी तरफ छे होय, यो समझीन कि पोरबु क दहाडू आय गयु छे, तुमर मन उचकाळुन कमजोर नी होय जाय आरू नी तुमू घबरायो। <verse eid="2TH 2:2"/><verse number="3" style="v" sid="2TH 2:3"/>काही रीति छे काही क धोखा मा नी आवने, काहकि पोरबु क दहाडू नी आवसे जव तक हड़ताळ चालसे, आरू दुष्ट मानुस प्रगट होयछे आरू ओको नरक नाखछे। <verse eid="2TH 2:3"/><verse number="4" style="v" sid="2TH 2:4"/>जो विरोध करता छे, आरू हर छे एक जो भगवान या पूज्य कवाये छे। आपने आप क मोटा ठेराया छे, याहा तक कि वो यहोवा–भगवान क मंदिर मा बठीन तुमरा आप क भगवान ठेराया छे।<verse eid="2TH 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5"/>काय तुमू स्मरण नी कि जव हाव तुमरे साथे हुता, तो तुमू छे यो वाद कयता करता हुता? <verse eid="2TH 2:5"/><verse number="6" style="v" sid="2TH 2:6"/>तुमू उना वात क जानता होय, जो उको हिमी रूक रया छे की दुष्ट मानुस तुमरा हिय टेहाव मा प्रगट होय। <verse eid="2TH 2:6"/><verse number="7" style="v" sid="2TH 2:7"/>काहकि अन्याय क भेद हिमी भी काम करता जाता छे, पर हिमी भी एक रूकनेवावा छे, आरू जव तक वो दूर नी जाय वो रूकने रवछे। <verse eid="2TH 2:7"/><verse number="8" style="v" sid="2TH 2:8"/>तव वो दुष्ट मानुस प्रगट होयछे, जिनाक पोरबु ईशु तुमरा मुय कि फूक छे मार देसे, आरू तुमरा आवनो क तेज छे भस्म करसे। <verse eid="2TH 2:8"/><verse number="9" style="v" sid="2TH 2:9"/><note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="MAT 24:24">मत्ती 24:24</ref></char></note>उना दुष्ट मनुष्य क आवने शैतान क काम क लारे सब प्रकार कि झूठी शक्ति, आरू सहलानी, आरू घण मोटा काम क साथे नी होयछे। <verse eid="2TH 2:9"/><verse number="10" style="v" sid="2TH 2:10"/>आरू नाश हुयने वालान करता अन्याय क सब भातिन क धोखा क साथ मा हुयसे; काहकि त्या सच्चाई छे मोंग नी कर्‍या एरसे इन्दरो उध्दार हुये। <verse eid="2TH 2:10"/><verse number="11" style="v" sid="2TH 2:11"/>इनीये कारण यहोवा–भगवान उनमा एक भटका देनेवावा शक्ति क मुकल्यो की वो झुठ कि भुरसो कर्‍या। <verse eid="2TH 2:11"/><verse number="12" style="v" sid="2TH 2:12"/>ताकि मानसे सच्चाई कि भुरसो नी करता, वरना अनैतिकता छे खुश हुयसे छे वो सब दंड मिवछे।<verse eid="2TH 2:12"/></para>
  <para style="s">दृढ बन रया</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13"/>हे भाईस, आरू पोरबु क मोंगावु मानछे, जुवे कि हामु तुमरे विषय मा सदा यहोवा–भगवान क धन्यावाद करता रया, काहकि यहोवा–भगवान ने शुरू छे तुमू चुन लेदा कि चुखलो आत्मा क द्वारा चुखलो बने, आरू सच्चाई कि भुरसो करीन उध्दार देख्या। <verse eid="2TH 2:13"/><verse number="14" style="v" sid="2TH 2:14"/>जिना क करता उनछे तुमू क जव खुश खबर सोमवाया क द्वारा बुलाया, कि तुमू हामरे पोरबु ईशु मसीह कि महिमा क सहभागी होय सके। <verse eid="2TH 2:14"/><verse number="15" style="v" sid="2TH 2:15"/>एरकरीन हे भाईस, आरू बहनीस स्थिर रयो; आरू जो जो शिक्षा तुमू ने जूवे वचन या पत्री क द्वारा हामु छे सिख्या छे, तीनुक थाम रयो।<verse eid="2TH 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16"/>आमरो पोरबु ईशु मसीह आप ही, आरू हामरा बास यहोवा–भगवान, जो हामु छे मोंग राख्यो आरू फोकटन दया छे अमरकाय बढ़ावु आरू खरी आश देदी छे। <verse eid="2TH 2:16"/><verse number="17" style="v" sid="2TH 2:17"/>तुमरे मन मा शांती देय आरू तुमरे हर एक वारला काम आरू वचन मा दृढ कर्‍या।<verse eid="2TH 2:17"/></para>
  <chapter eid="2TH 2"/>
  <chapter number="3" style="c" sid="2TH 3"/>
  <para style="s">प्रार्थना करने क अगवाय</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1"/>अळते मा हे भाईस, आरू बहनीस हामरे करता प्रार्थना कर्‍या कर की पोरबु क वचन ओसो शीघ्र पुगीयो आरू महिमा देख्या, जोसो तुमू मा हुयो। <verse eid="2TH 3:1"/><verse number="2" style="v" sid="2TH 3:2"/>आरू हामु वाकलो आरू दुष्ट मानुस छे वाच रया काहकि हर एक काम मा विश्वास नी।<verse eid="2TH 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 3:3"/>पुन पोरबु सच्चा छे; वो तुमू दृढ़ता छे स्थिर करसे आरू उना शैतान छे सोरक्षित राखछे, <verse eid="2TH 3:3"/><verse number="4" style="v" sid="2TH 3:4"/>हामु पोरबु मा तुमरे ऊपर विश्वास छे कि जो जो हुकुम मा हामु तुमू देता छे, तीनुक तुमू मानता होय, आरू मानता भी रवछे।<verse eid="2TH 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 3:5"/>यहोवा–भगवान क मोंग आरू मसीह क धीरज कि आरू छे पोरबु तुमरे मन की अगवाय करे।<verse eid="2TH 3:5"/></para>
  <para style="s">काम करने क जिमेवारी</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6"/>हे भाईस, आरू बहनीस हामु तुमू मा आपने पोरबु ईशु मसीह क नाव छे हुकुम देता छे, कि तुमू हर एक ओसो विश्वास भाईस छे अलग रया जो गलत चाल चालता आरू जो शिक्षा त्यो हामु छे देख्या ओका लारे नी करता। <verse eid="2TH 3:6"/><verse number="7" style="v" sid="2TH 3:7"/>काहकि तुमू आप जानता होय कि काही रीति छे हामरी जोसी चाल चालने जुवे, काहकि हामु तुमरे विच मा गलत चाल नी चाल्यो। <verse eid="2TH 3:7"/><verse number="8" style="v" sid="2TH 3:8"/>आरू काही कि रोटा मुक्त मा नी खाय; पर मेहनत आरू कष्ट छे रात दहाडू काम धंदा करता हुता कि तुमू मा छे काही पर भार नी होय। <verse eid="2TH 3:8"/><verse number="9" style="v" sid="2TH 3:9"/>यो नी कि हामु हक नी, पर एरकरीन कि तुमरा आप क तुमरे करता विजुत राखनीया बन्या कि तुमू हामरी जोसी चाल चाल्या। <verse eid="2TH 3:9"/><verse number="10" style="v" sid="2TH 3:10"/>काहकि जव हामु तुमरे याहा हुता, तव भी याहा हुकुम तुमू देता हुता की यदि काही काम करने नी जूवे तो खाने भी नी देख्या।<verse eid="2TH 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11"/>हामु सोमवता छे कि काही मानसे तुमरे विच मा गलत चाल चालता छे, आरू काही काम नी करता छे, पर दिसरा क काम मा हात नाख्या करता छे। <verse eid="2TH 3:11"/><verse number="12" style="v" sid="2TH 3:12"/>ओसी क हामु पोरबु ईशु मसीह मा हुकुम देता आरू समझता छे कि चुपचाप काम करीन आपसी ही रोटा खाया करू।<verse eid="2TH 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 3:13"/>तुमू, हे भाईस, आरू बहनीस भलाई करने मा साहस नी छुड़िया।<verse eid="2TH 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TH 3:14"/>यदि काही हामरे इनीये पत्री क वात क नी मान तो उना पर दृष्टी राख, आरू ओकी संगति नी कर्‍या, जिनासे वो लज्जित होय। <verse eid="2TH 3:14"/><verse number="15" style="v" sid="2TH 3:15"/>तौभी त्यो दुस्मन मत समझ, पर भाईस्यो साथी जानीन ओको समझावु।<verse eid="2TH 3:15"/></para>
  <para style="s">आखरी नमस्कार</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16"/>हिमी पोरबु जो शांती क सुवता छे आप ही तुमू सदा आरू हर प्रकार छे शांती देय। पोरबु तुमू सब क साथे रये।<verse eid="2TH 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17"/>हाव, पौलुस, आपने हात छे नमस्कार लिखता छे। हर पत्री मा मारो याहा योही सहलानी छे; हाव इनीये प्रकार छे लिखता छे।<verse eid="2TH 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18"/>हामरे पोरबु ईशु मसीह क फोकटन दया तुमू सब पर हुयसे रया।<verse eid="2TH 3:18"/></para>
  <chapter eid="2TH 3"/>
</usx>
