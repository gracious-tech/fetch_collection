<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">– Dhankavi</book>
  <para style="h">मरकुस</para>
  <para style="toc3">मरकुस</para>
  <para style="toc2">मरकुस</para>
  <para style="toc1">मरकुस नी किताब</para>
  <para style="mt2">मरकुस कि किताब</para>
  <para style="mt1">मरकुस नी किताब</para>
  <para style="imt">परिचय</para>
  <para style="ip">ईशु क जीवन क वर्णन करने वावी चार पत्री मा से एक पत्री मतलब मरकूस रचीत खुश खबर था “चार पत्री ईशु क खुश खबर सोमवने से।”</para>
  <para style="ip">ईशु क मृत्यु क बाद यो चार खुश खबर मत्ती, मरकुस, लूका वो यहुन्ना क हातेन लिख्यो गयो से यो चार पत्री मा से मरकुस खुश खबर आखा सी नानी पत्री से, काय तज्ञ कि मान्यता से कि मरकुस रचीत खुश खबर आखा सी पेहल लिख्यो गयो, बाकि क तीन खुश खबर ईशु क जनमक 65 से 70 साल क बाद लिख्यो गयो वो लिखने क कारण मतलब रोम शहर की मसीह मासा क मनोबल बड़ावने वो बढ़ावु करने क करता लिख्यो गया हुता।</para>
  <para style="ip">यो मरकुस कुन? प्रेरित पौलुस वो बरनबास इनाक यो जवान सहककर्मी हुता, यहुन्ना मतलब मरकुस रचीत खुश खबर क लेखक मरकुस ओका साथ पेहले मिशनरी यात्रा से वीच मा ही छुड़ीन चाली जाने से ओकी मान मर्‍यादा क ठेस पुची <char style="xt"><ref loc="ACT 13:13">प्रेरितन 13:13</ref></char> बाद मा याहा मरकुस बरनबास क साथ सेवाकार्‍य मा सामिल हुता देख्या <char style="xt"><ref loc="ACT 15:37-39">प्रेरितन 15:37-39</ref> </char> लारे मरकुस पतरस क साथे क साथी हुता। <char style="xt"><ref loc="1PE 5:13">1 पतरस 5:13</ref>, </char> तज्ञ की ओसी मान्यता हे की जत्यार की मरकुस ने ईशु क जीवन वो सेवाकार्‍य आमने सामने देखी नी हुती ती पतरस क गवा क आधार पर उसने ओको खुश खबर लिख्या। याहा मरकुस क खुश खबर क आधार की वात से।</para>
  <para style="ip">मरकुस रचीत क दुई विषय मतलब ईशु क सचा चेला बनने वो आखरी क भविष्य मा ईशु क द्बारा दी गय शिक्षा।</para>
  <para style="ip">मरकुस रचीत खुश खबर मा ईशु क नम्र दास वो आपने बास कि मरजी पुरी करने मा सदा तीयार, ओसो यहोवा भगवान क मोंगावु पोर्‍यो याहा दुई रूप मा दशीया से वोसो ही मरकुस ने ईशु क द्बारा कर्‍या गया चमत्कार क विषय मा ज्यादा से ज्यादा लिख्या गया से। याहा खुश खबर क समापन ईशु क चेला क दिया गया महान हुकुम कर्‍या गया से।</para>
  <para style="iot">रूप रेखा:</para>
  <para style="io1">1. बपतिस्मा देनेवावा यहुन्ना वो ईशु क बपतिस्मा <char style="ior"><ref loc="MRK 1:1-13">1:1-13</ref></char></para>
  <para style="io1">2. ईशु क द्बारा गलील प्रदेश वो क्षेत्र मा कर्‍या गया चमत्कार <char style="ior"><ref loc="MRK 1:14-9:50">1:14–9:50</ref></char></para>
  <para style="io1">3. गलील सी यरूशलेम तक की ईशु न यात्रा वो मंदिर मा आवनो<char style="ior"><ref loc="MRK 10:1-12:44">10:1–12:44</ref></char></para>
  <para style="io1">4. ईशु क द्बारा भविष्य क विषय मा दिया गया संदेश <char style="ior"><ref loc="MRK 13:1-37">13:1-37</ref></char></para>
  <para style="io1">5. ईशु क मरना वो आवी जीवीन उठने वो मरन हुकुम <char style="ior"><ref loc="MRK 14:1-16:20">14:1–16:20</ref></char></para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">यहुन्ना बपतिस्मा देनेवावा क प्रचार</para>
  <para style="r">(<ref loc="MAT 3:1-12">मत्ती 3:1-12</ref>; <ref loc="LUK 3:1-18">लूका 3:1-18</ref>; <ref loc="JHN 1:19-28">यहुन्ना 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />यहोवा भगवान क पोर्‍या ईशु मसीह की खुश खबर की शुरूम। <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />जसो यशायाह कागळिया क पत्री मा लिखलो छे।</para>
  <para style="q1" vid="MRK 1:2">यहोवा भगवान कहवे देख हाव म्हारा खुश खबर देने वाळा क तुमरे अगोळ मोकलू,</para>
  <para style="q2" vid="MRK 1:2">जो थारे जुगू वाट सुधारसे।<verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />यशायाह कागळियान “जंगल मा एक आयड़ने वावान बुल समवाय रया छे</para>
  <para style="q2" vid="MRK 1:3">की पोरबु क वाट तीयार करू,</para>
  <para style="q2" vid="MRK 1:3">आरू हेकी वाट सुदी करो।”<verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />यहुन्ना बपतिस्मा देनेवालो आयो, जो जंगल मा बपतिस्मा देतो हतो, आरू पाप माफी क मन फिरावने क आरू बपतिस्मा लेने क खबर करतो हतो। <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />आखा यहूदिया देश क आरू यरूशलेम शहर मा सब रवने वावा निकवीन ओको पास गया, आरू आपसा पाप क मानीन यरदन नदी मा यहुन्ना सी बपतिस्मा लेदा।<verse eid="MRK 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6" />बपतिस्मा देनेवावु यहुन्ना उटड़ान झटा क बनलो छिंदरो पेहरलु आरू हेकी कमर मा चामड़ान पट्टो बांधी रयो हुतो आरू टिड्डिया आरू बयड़ान माहव खाया करतो हुतो, <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />आरू यी करता यहुन्ना बपतिस्मा देनेवावो खबर करतो हुतो कि मार बाद मा त्यो आवने वावो छे, जो मार से भी जादा जानकार छे; हाव ते ओका पाय मा झुकीन खासड़ा निकावने जुगु भी नी होय। <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />हाव ते तुमूक पानी से बपतिस्मा दि रयो बाकि वो तुमूक चुखली आत्मा से बपतिस्मा आपसे<verse eid="MRK 1:8" /></para>
  <para style="s">ईशु क बपतिस्मा आरू परिक्षा</para>
  <para style="r">(<ref loc="MAT 3:13-4:11">मत्ती 3:13–4:11</ref>; <ref loc="LUK 3:21-22">लूका 3:21-22</ref>; <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />तिनु दाहड़ा मा ईशु गलील क नासरत शहर से आवीन, यरदन नदी मा यहुन्ना से बपतिस्मा लेदो। <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />आरू ईशु बपतिस्मा लीन पानीम रईन निकवीन बाहर आयो, तो तत्काल ईशु सोरग क खुलतो आरू चुखली आत्मा क पेरवान सारकी ओका उपर उतरता देख्यो। <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" /><note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="MAT 3:17">मत्ती 3:17</ref>; <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 9:7">मरकुस 9:7</ref>; <ref loc="LUK 3:22">लूका 3:22</ref></char></note>आरू हेको सोरग से यी अवाज समवाई देदी, कि तु म्हारो मोंगावु पोर्‍यो छे, “थारे से हाव खुश छे।”<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />तत्यार आत्मा तत्काल ईशु क जंगल मा मोकली। <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />जंगलमा चावीस दाहड़ा तक शैतान हेकी परीक्षा लिदो; आरू वो जंगली जनवार क साथ मा रयो, आरू सोरगदूत ओकी सेवा करता रया।<verse eid="MRK 1:13" /></para>
  <para style="s">ईशु क सेवान काम क सोरू करनो</para>
  <para style="r">(<ref loc="MAT 4:12-17">मत्ती 4:12-17</ref>; <ref loc="LUK 4:14-15">लूका 4:14-15</ref>; <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />बपतिस्मा देनेवावो यहुन्ना क धराय जाने क बाद ईशु गलील मा आवीन यहोवा भगवान क राजन वारली खबरन परचार करियो, <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" /><note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="MAT 3:2">मत्ती 3:2</ref></char></note>आरू कयो, “टेम पुरो हयो, आरू यहोवा भगवान क राज नाट आय गयो; पापो से मन फिरावु आरू खुश खबर पर विश्वास करो।”<verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />ज्यार ईशु गलील दरियो क धड़े–धड़े जातो हतो, ती ईशु शमौन आरू ओका भाईस अन्द्रियास क दरियो जाव नाखता देख्यो; काहकि चे माछा मारन्या हुता। <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />ईशु तिनुक कयो, मार पछव आवु, “हाव तुमूक मानुस क यहोवा भगवान राज्यमा लावनेवावा बनावीस।” <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />चे तत्काल जाव छुड़ीन ईशु पछव होय लेदा।<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />थुड़ोक ओगव जाईन ईशु जबदी क पोर्‍या याकूब आरू यहुन्ना क ढोंड्यो पर जाव सुदारता देख्यो। सुधारता <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />ईशु तत्काल तिनुक बुलयो आरू चे तिन्दरा बास जबदीक दाहड़कियान क साथ मा ढोंड्यो पर छुड़ीन, ईशु क पछव चाल देदा।<verse eid="MRK 1:20" /></para>
  <para style="s">साहळा से भरायलो मानुस क वारू करनो</para>
  <para style="r">(<ref loc="MAT 4:12-22">मत्ती 4:12-22</ref>; <ref loc="LUK 4:14-15">लूका 4:14-15</ref>; <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />तत्यार चे कफरनहूम नगर मा गया, आरू वो तत्काल आराम क दाहड़े यहूदि यान प्रार्थना घर मा जाईन वारली खबर करने लाग्यो। <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" /><note caller="+" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="MAT 7:28">मत्ती 7:28</ref>,<ref loc="MAT 7:29">29</ref></char></note>आरू लोगहन ओकी वारली खबर से अका बाकी होय गया, काहकि ईशु हिनुक शास्त्री मानुस क सारको नी, पुन हक क साथ मा वारली वात देखाड़तो हतो।<verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />आरू तिना तेम मा, तिन्दरा प्रार्थना क घर मा एक मानुस हुतो जिनाम एक विटळ आत्मा हुती। <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />साहळा आयड़ीन कयी, हे ईशु नासरत, थारो हामरे साते थारो काय काम? काय तु हामुक नाश करने आवलो छे? हाव तुखे जानो, तु कुन से? “तु यहोवा भगवान क चुखलो मानुस से!”<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />“ईशु साहळा क लड़िन कयो, हुग रया; आरू हेकाम से बाहर निकवी जा।”<verse eid="MRK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26" />तत्यार साहळा ओको मुयड़तीजाईन, आरू मोटात् बुल से आयड़ीन ओको मा से निकली गयी। <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />अतरा पर जतरा लोगहन हेको देख रया हता चे आखा घबराय गिया आरू एक दिसरा क कयनो लागिया “यो काय छे? काय यो काहय भाती क नवलो सिखापन ते नी हय कि हेका पास साहळा क निकवने क हक छे आरू ची आत्मा ओको हुकुम माने।”<verse eid="MRK 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28" />आरू ओको नाव छाटत गलील क आखा प्रदेश मा बढ़तो गयो।<verse eid="MRK 1:28" /></para>
  <para style="s">ईशु घण बेमार मानसे क आरगा कर्‍या</para>
  <para style="r">(<ref loc="MAT 8:14-17">मत्ती 8:14-17</ref>; <ref loc="LUK 4:38-41">लूका 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />ईशु छाटत प्रार्थना घर मा से निकवीन, याकूब आरू यहुन्ना क सात मा शमौन आरू अन्द्रियास क घर गयो। <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />शमौन की सासु जादा सेरी हयने से खाटला मा पड़ रयी हुती, आरू चे छाटात हेका बाराम हेके कयो। <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />तत्यार त्यो तिन्दरे सात मा जाईन हेको हात धरीन क हेके उठाड़ियो; आरू हेको ज्वर उतरी गयो, आरू ची ईशुन सेवा करने लागी।<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />दाहड़ो डुबने आरू शान्तो हयने क बाद मा लोगहन ईशु क त्या लोगहन क पास लाया आखा मांदला आरू साहळा से भरायलान क ओका पास लाया। <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />आरू आखा नगर क मानसे झोपला पर एखटा हुया। <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />आरू ईशु घणा जन क जो भातीभातीन बेमारी से दुखी हुता, तिनुक आरगा करियो; आरू घण सवटी साहळा क लोगहन मा से निकालियो; आरू दृष्टात्मान क बोलने नी दिदो, काहकि ची आत्मा ईशु जानती हती।<verse eid="MRK 1:34" /></para>
  <para style="s">सुनसान मा ईशु क प्रार्थना करने</para>
  <para style="r">(<ref loc="LUK 4:42-44">लूका 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />संदारे दाहडु निकव्यु छे घोणा पेहल, ईशु उठीन निकव्य, आरू एक बयड़ा उपर गयो आरू वा प्रार्थना करने लाग्यो। <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />तत्यार शमौन आरू ओको साथी ओको हेरने करीन गया। <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />जत्यार ईशु मेव गयो, ती ओको कयो; “सब लोगहन तुखे हेर रया।”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />ईशु तिनुक कयो, “आवो हामु अळी काहय दिसरा गावोम जाजे, कि हाव त्या भी खुश खबर कयनु छे, काहकि हाव अतरान करीन आवलो छे।”<verse eid="MRK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:39 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:23">मत्ती 4:23</ref>; <ref loc="MAT 9:35">9:35</ref></char>
    </note>आरू चे आखा गलील नगर मा आरू सभागृह मा खबर करतो आरू साहळा क निकावतो रयो।<verse eid="MRK 1:39" /></para>
  <para style="s">ईशु क एक कुड़ावा मानुस क आरगो करनों</para>
  <para style="r">(<ref loc="MAT 8:1-4">मत्ती 8:1-4</ref>; <ref loc="LUK 5:12-16">लूका 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />कुड़ावो लागली बीमारी क एक मानुस ईशु क पास आयो, ओका विनती करने लाग्यु, आरू ईशु अगळ घुटना टेकीन कयो, कदाम थार मरजी हय ती मखे वारू कर दे।<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />ईशु ओको पर दया करीन हात बढ़ायो, आरू ओको छिमीन कयो, “हाव यो चाहो कि तु वारू हय जा।” <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />आरू छाटलो ओकी कुड़ की बीमारी जात रया, आरू चो वारू होय गयो। <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />तत्यार ईशु ओका चकचवळयो करीन मकली दिदो। <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />आरू ओको कयो, “देख, कुदाक कोय भी नी कयनो, पुन जाईन पुजारा क देखाड़् कि थार सात मा काय हयो, आरू थारो वारू हुयने क बारामा जो काय नियम मूसा टाकलो छे तेरो चढ़ावो चढ़ाव।”<verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />पुन चो मानुस बाहरो जात रयो आरू इनी वात की खबर फैलावने लाग्यो, कि बाद मा ईशु क उजेन्तो गाव मा नी जाय सक्यो, पुन बाहरो जंगल मा रयो; च्यार तरफ से लोगहन ओको पास आवता रया खुब देखड़तो रयो आरू या तक फिरने लाग्यो कि ईशु पछु खुल्लाम खुल्लु नगर मा नी जा सक्य, पुन बारतो जंगली स्थान मा रया; आरू चार तरफ से मानसे ओको आवता रया।<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">लखवा बीमारी वारू करने</para>
  <para style="r">(<ref loc="MAT 9:1-8">मत्ती 9:1-8</ref>; <ref loc="LUK 5:17-26">लूका 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />काही डाहादडान बाद ईशु कफरनहूम गाँव मा पछु आयु आरू सोमवायो, कि त्यो घर मा छे। <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />ती ओतरा सोवटा मानसे एखटा हुया, कि झोपला मा भी जागो नी हतो; आरू ईशु तिनुक वचन सोमवाडतु हतो। <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />आरू मानसे एक लखवा सी बीमार क चार मानसे ओको हुकलीन ईशुन साथे ली आश। <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />पुन जोत्यार चाँ गर्दीन कारण ईशुन चाँ नी पुचाय सक्यो, ती चे घर क उपर तिनान घरन नेड़ु ईशु हतु, खुल दिदा आरू चे इनाक उधार दिदा, ती खाटला पर लखवान बीमार पड़ रयु हतु, तीनाक लटकाड़ दिदा। <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />ईशु तेरू विश्वास देखीन तीन लखवा वावा कयो “ए पोर्‍या तारू पाप माफ होय गयु”<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />तव कोय शास्त्री चाँ बठ रया हता आपसा–आपसा मनमा विचार करणे लाग्या, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“यु मानुस काँ ओसो कयतो हतु? यु ते यहोवा भगवानन बुरा विचार करता छे! यहोवा भगवान क छुड़ीन आरू कुन पाप माफ कर सकता छे?”<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />ईशु तत्काल आपसी आत्मा मा जान लेदु, कि वो आपसा–आपसा मनमा विचार करने लाग्या, आरू तिनुक कयो, “तुमू आपसा–आपसा मनमा काँ विचार कर रया? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />सहज काय छे? काय लखवा क बीमार छे यो कयनो कि थार पाप माप हयो, यो कयनो कि उठ आपसी खाटली हुचल आरू चाल पछु? <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />पुन तुमू ईशु क जान लेवु कि मानुस क पोर्‍या क धरती पर पाप माफ करने क भी हक छे।” त्यो लखवा क बीमार छे कयो, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />“हाव तखो कयो, उठ, थार खाटली हुचलीन थारे घर जाती रोवे।”<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />त्यो उठयो, आरू तत्काल खाटली हुचलीन आखान क सामने चालीन जात रयो; इना पर आखा क आखा–बाकी हय गया, आरू यहोवा भगवान क बढ़ाई करीन कयनो लाग्यो, “हामु ओसो नी देख्या।”<verse eid="MRK 2:12" /></para>
  <para style="s">ईशु लेवी क बुलायु</para>
  <para style="r">(<ref loc="MAT 9:9-13">मत्ती 9:9-13</ref>; <ref loc="LUK 5:27-32">लूका 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />ईशु निकवीन नदीन क धोड़े गयो, आरू आखी गर्दी ओको साथे आवी, आरू त्यो तिनुक वारली–वारली वात कवे। <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />“जातो हयो ईशु क हलफई क पोर्‍यो क लेवी की आंगना मा फाळान चौकी पर बठलो देख्यो, आरू तीनाक कयो” मारे पोछल चाल। आरू त्यो उठीन ईशुन पछव गयो।<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />जव यु ओका घर मा रोटलो खाने बठया, तव फाळो लेनेवाळा आरू पापी, ईशु ओका चेला क साथे रोटलु खाने बठ्या; काहकि चे सोवटा हता, आरू ओको तेर पछव हुता। <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />शास्त्री आरू फरीसिया यो देखीन, कि वो तो पापी व्याज लेनेवावु क साथे रोटलु खाने बठ्या हतो, तेरा चेला कयो, “वो तो व्याज लेनेवावु आरू पापी क साथे खाता पीता छे!”<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />ईशु ने यो सोमवीन ओको कयो, “भलो व्याजवालो क मुवा–बुटी क नी, पुन बीमार क छे: हाव न्यायी क नी, पुन पापी क बुलावने आवलु छे।”<verse eid="MRK 2:17" /></para>
  <para style="s">उपवासन क बारामा सवाल</para>
  <para style="r">(<ref loc="MAT 9:14-17">मत्ती 9:14-17</ref>; <ref loc="LUK 5:33-39">लूका 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />बपतिस्मा देनेवावो यहुन्ना क चेला, आरू फरीसि उपवास करता हतो; शेवली कावा: त्या आवीन ईशु क कयो; “यहुन्ना क चेला आरू फरीसियो क चेला काय उपवास राख्या छे? पुन थारा चेला उपवास नी राख्या?”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />ईशु तिनुक कयो, “जव तक लाड़ो वरात्यान क साथे रया छे, काय वो उपवास कर सकता छे? शेवली कावा जव तक लाड़ो तिनरे साथे छे, तव तक वो उपवास नी कर सकता। <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />पुन त्यो दाहडु आवसे जव लाड़ो तिनरे साथे रईन अलग होय जाछे; तिन टेहाव वो उपवास करसे।<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />“नवला छिंदरा क ठिगवने जुनला छिंदरो पर कोय नी लागाड़ता; नी तो वो ठिगवने तिनाम छे काय खेचाय जाय, मतलब नवला, जुनला छे, आरू वो पेहले छे जादा फाट जाछे। <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />नवलो अंगुरन रस क चामड़ान जुनली थैलो मा काही नी राखता नी तो अंगुरन रस क थैलो फाड़ देसे, आरू अंगुरन रस आरू थैलो दुयू सचाब होय जाछे; पुन नवल अंगुरन रस चामड़ान नोवली थैलो मा भराय जाय छे।” <figure style="fig" alt="Wineskin bag" file="lb00145c.tif" size="col" copy="Horace Knowles ©" ref="2:22">अंगुरन रस मेकनेन चामड़ान थैलो</figure><verse eid="MRK 2:22" /></para>
  <para style="s">आराम क पोरबु</para>
  <para style="r">(<ref loc="MAT 12:1-8">मत्ती 12:1-8</ref>; <ref loc="LUK 6:1-5">लूका 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />उका समय ईशु आरामन दिन खेतो मा सी हुयन जातो हुतो, आरू ओका चेला चालता हता गवन उंब्या तुड़ने लाग्या। <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />तव फरीसिया ओको कयो, “देख; यो आराम क दाहडु वो काम काय काँ करता छे जो वारू नी?”<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />त्यो ओका सी कयो, काय तुमू क यो कदी नी भोन्या कि जव दाऊद आरू वो ओका साथी भुकला हुया आरू तीनु साथे खाने काही नी तव दाऊद काय कर्‍या हतो? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />त्यो कोसा अबियातार डाहला पुजारा क टेहाव, यहोवा भगवान क घर मा जाईन भेंटन क रटलो खादा, ओको खानो पुजारा क छुड़ीन आरू कोयक क भी वारू नी, आरू आपसा साथी क भी दिदो?<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />तव त्यो तिनुक कयो, आराम क दाहडु लोगहन क करता बनाड़े गया छे, नी कि लोगहन आराम क दाहड़ान करता। <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />“एरकरीन लोगहन क पोर्‍या आराम क दाहडु क भी भगवान छे।”<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">ईशु सुकला हातवावो लोगहन क वारू करने</para>
  <para style="r">(<ref loc="MAT 12:9-14">मत्ती 12:9-14</ref>; <ref loc="LUK 6:6-11">लूका 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />ईशु पछु प्रार्थना घर मा गयु; चाँ एक मानुस तेरू सुखलु हाथ हतु, <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />आरू वो तीना पर त्योगली लागाड़ ने क करता ओकी घात मा लाग्या हया हुतो, कि देख, वो आराम क दाहड़े मा भी ओको वारू करतो छे कि नी। <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />ईशु कयो कि सुखला हातवावा मानुस काजे “वीच मा उभु रहने कयो।”<verse eid="MRK 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 3:4" />आरू तीनाक कयो, “काय आराम क दाहाड़े वारलो करनेन वारू छे यो बुरो करने, जीव क वाचावने या मारीने?” पर वो चुप रया। <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />“आरू त्यो तिनुक मनम क रिस होईन ओथुन–अथु भावीन तीनु मानसक कयो, आपनु हाथ ओगु करू।” आरू त्यो कर्‍यु, आरू तेरू हाथ सुधरी गयो। <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />तव फरीसिया बाहरता जाईन तत्काल हेरोदयो न क साथे ओका विरोध मा विचार करने लाग्या, कि ओको कसा करीन इनुक सारने।<verse eid="MRK 3:6" /></para>
  <para style="s">गर्दी क ईशुन पछव चालने</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />ईशु उका चेलाहन क साथ गलील दरिया क चाल देदु; आरू गलील क यहूदिन एक मोटी गर्दी ओको पछव होय गयो; <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />आरू यहूदि या, आरू यरूशलेम, आरू इदूमिया, आरू यरदन नदी क पार, आरू सोर हामरे सीदोन क आस–पास छे एक मोटित गर्दी यो सोमवीन कि वो कोसो भोंगलाय गयो आरू काम करता छे, ओको साथे आवी। <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" /><note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="MRK 4:1">मरकुस 4:1</ref>; <ref loc="LUK 5:1-3">लूका 5:1-3</ref></char></note>आरू त्यो आपसा चेला काजे कयो, “गर्दीन कारण एक नानलो ढोंड्यो मार वाटु तैयार करू ताकि वो मखे दबाय नी सके।” <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />काहकि ईशु वार सोवटा जणा वारू करलो हतु, काहकि एरकरीन जोतरा लोगहन बीमार हता, ईशु छिमनेन करीन ओको पर पड़्या। <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />विटळ आत्मा भी, जव ईशु क देखतली, त्योतार तेर ओगव पड़ जातली, आरू आयड़ीन कयतीली कि तु यहोवा–भगवान पोर्‍यो छे;<verse eid="MRK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12" />आरू ईशु द्रूष्ट आत्मा क कयो, कि तु मखे प्रकट नी कर सके।<verse eid="MRK 3:12" /></para>
  <para style="s">ईशु बारा चेला क नेवाड़्यु</para>
  <para style="r">(<ref loc="MAT 10:1-4">मत्ती 10:1-4</ref>; <ref loc="LUK 6:12-16">लूका 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />ईशु बयड़ा पर चड़ गयो, आरू जीनुक वो पसंद करतो हतो तिनुक आपने साथे बुलावीन; आरू वो ओको साथे माय। <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />तव वो बारा लोगहन क त्यो नेवाड़्यु क चे ईशुन साथे रवे, आरू वो तिनुक मुकले कि चे खबर करे। <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />आरू साहळा क बाहरता निकावनेन क हक छे।<verse eid="MRK 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16" />ईशु बारा जनाम रईन शमौन न ओको एक ओवी नाव मेलमिलाप्यु पतरस। <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />आरू जबदी क पोर्‍या याकूब आरू याकूब क भाई यहुन्ना, ओको नाव त्यो बुअनरगिस मतलब गाजनो क पोर्‍या रख्यो, <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />आरू अन्द्रियास, आरू फिलिप्पुस, आरू बरतुल्मै, आरू मत्ती, आरू थोमा, आरू हलफई क पोर्‍या याकूब, आरू तध्य आरू शमौन कनानी यो रोमि सरकार विरोध। <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />आरू यहूदा इस्करियोती त्यो ईशु क धराय भी दिदो।<verse eid="MRK 3:19" /></para>
  <para style="s">ईशु आरू बालजबुल</para>
  <para style="r">(<ref loc="MAT 12:46-50">मत्ती 12:46-50</ref>; <ref loc="LUK 8:19-21">लूका 8:19-21</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />तव ईशु घर मा आयो; आरू ओसी गर्दी एखटी होई कि वो रटलो भी नी खाय सक्यो। <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />जव ओको घरानो यो सुन्यु, चे ओको धरनेन क करीन निकव्या; काहकि चाँ कयतला हतो, कि ओका सुध–बुध ठिकाना पर नी छे।<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:22 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:34">मत्ती 9:34</ref>; <ref loc="MAT 10:25">10:25</ref></char>
    </note>शास्त्री भी जा यरूशलेम रईन आश, यो कयता हता, “कि ईशुन माहय बालजबुल छे” आरू यो भी “ईशु दृष्टात्मान सरदार छे मदत से साहळा क निकावतो छे”<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />एरकरीन ईशु तिनुक पास बुलावीन तिनुक दृष्टान्त क कयो, “शैतान क शैतान कोसो निकाव सके?” <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />जर कदी एकदा जिना राज्य मा फूट पड़ी, ते चो राज्य कोसो एक जागे रोवे छे? <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />आरू जर कदी एकदा घर मा फूट पड़्यो ते चो घर कोसो एक जागे रोवे छे? <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />एरकरीन जर कभी शैतान आपसेत विरोध मा लड़ाई मा जाय, ते चे कोसा बन्यो रोवे सकता छे? ओको तो राज्य सर जासे।<verse eid="MRK 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27" />“पुन एकदु जुरवार मानुसन क घर मा भराइन ओको माल नी लूट सकता, जव तक वो जोरवार क बांध नी लेय; आरू तव ओको घर क लूट लेस।”<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />हाव तुमू क सच कयो छे, कि लोगहन की अवलियाद क आखान पाप आरू वायकेड़ा उड़ावे, माफ कर दे से, <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" /><note caller="+" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="LUK 12:10">लूका 12:10</ref></char></note>पुन जो एकदु चुखलो आत्मा क बुरा निन्दा करे वो कदी भी माफ नी हवे: त्यो अमरकाय पापन गुणागार बनसु। <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />काहकि वो कयता कि तिनाम विटळ आत्मा छे।<verse eid="MRK 3:30" /></para>
  <para style="s">ईशु क माय आरू भाई</para>
  <para style="r">(<ref loc="MAT 12:46-50">मत्ती 12:46-50</ref>; <ref loc="LUK 8:19-21">लूका 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />तव ईशु की माय आरू ओका भाई, आरू बाहरता उबा हता आरू ईशु क ओको बुलावने मुकल्या। <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />गर्दी ओकान आस–पास बठी हती, आरू त्यो तिनुक कयो, “देखु, तारी बहिनीस आरू माय आरू तारू भाई बाहरता तुखे हेरने छे।”<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />ईशु तिनुक कयो, “कि मारी माय आरू मारा भाई कुन छे?” <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />आरू ओको पर जा तिनान आस–पास बठ्ला हता, तिनुक देखीन ईशु कयो, “कि देखु, मारी माय आरू मारा भाई यो छे। <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />काहकि जो कुन यहोवा–भगवान क मरजी पर चाले, चे मारा भाई, आरू बहिनीस आरू माय छे।”<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">बीज वेरने वावा क बाराम देखाड़नो</para>
  <para style="r">(<ref loc="MAT 13:1-9">मत्ती 13:1-9</ref>; <ref loc="LUK 8:4-8">लूका 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 5:1-3">लूका 5:1-3</ref>
      </char>
    </note>ईशु पछु दरिया क धड़े परचार करने लाग्या: आरू ओसी मोटी गर्दी ओको साथे एखठी होय गयी कि वो दरिया मा एक ढोंड्या पर चढ़ीन बठ्या गया, आरू सारी गर्दी धरती पर दरिया क धड़े उभी रयी। <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />आरू वो तीनुक दृष्टान्त मा घोणा सी वात सिकाड़ने लाग्या, आरू परचार मा उनछे कयो,<verse eid="MRK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3" />धियान करीन “समवो! एक वेरनेवावो बीज वेरने करीन निकलियो। <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />वेरने टेहाव मा काही मार्ग धड़े पड़्या आरू चिल्ला ने आवीन उको खाय लेदा। <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />काही दगड़ाटया धरती पर पड़्या वा ओको क घोणा धुवो नी मुवयो आरू वारू धुवो नी मुव्यो क कारण छाटो उगी गया। <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />आरू जव दाहड़ो निकव्या तो धपी गया, आरू मुवे नी धरने क कारण सूखी गया। <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />आरू काही ते झाड़का पड़ गिया आरू झाड़किया मोटा हईन तिनु बिज क दबाई दिदा, आरू चे फव नी लाया। <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />पुन काही वारू धरती पर पड़्या, आरू वो उग्यो आरू मोट फलवंत हुयो; आरू काही तीस गुणा, आरू काही एक सौ गुणो फोव लाया।”<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />तव त्यो कयो, “जेरे साथे सोमवने क करता कान्टा होय, वो सोमवी लेय।”<verse eid="MRK 4:9" /></para>
  <para style="s">सपनो क उद्देश्य</para>
  <para style="r">(<ref loc="MAT 13:10-17">मत्ती 13:10-17</ref>; <ref loc="LUK 8:9-10">लूका 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />जव ईशु ऐखलो रया गयो, तो ओका साथी ने उन बारा सहावत ओका सी इन सपनो क विषय मा पुछया। <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />त्यो उनछे कयो, “तुमू क तो यहोवा–भगवान क राज्य क भेद की समझ दी गय छे, पुन बाहरतावावा क करता सब वात दृष्टान्त मा होयती छे।”<verse eid="MRK 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MRK 4:12" />एरकरीन कि “वो देखता हुया देख्य</para>
  <para style="q2" vid="MRK 4:12">आरू तीनुक सुझाई नी पड़े</para>
  <para style="q1" vid="MRK 4:12">आरू सोमवता सोमव्या</para>
  <para style="q2" vid="MRK 4:12">भी आरू नी समझे।</para>
  <para style="q1" vid="MRK 4:12">ओसो नी हुये कि त्यो पोरबु भेणी पछो आवे,</para>
  <para style="q2" vid="MRK 4:12">आरू माफ करी जाय।”<verse eid="MRK 4:12" /></para>
  <para style="s">बीज वेरने वावान सपनो की पुरावो</para>
  <para style="r">(<ref loc="MAT 13:18-23">मत्ती 13:18-23</ref>; <ref loc="LUK 8:11-15">लूका 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />पछु ओका सी उनछे कयो, काय तुमू यो सपनो नी समझते? तो पछु आरू सब सपनो क कोसो समझोगे? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />वेरनेवावा वचन वेरयो छे। <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />जो वाट क धड़े क छे वा वचन वेराय जाय यो वो छे कि जव त्या सोमव्या, तो शैतान तत्काल आवीन वचन क उनमा बोया गया हुता, उठाय ली जाता छे। <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />जोसो ही जो दगड़ाळी धरती पर वेरलो जाय छे, यो वो छे जो वचन क सोमवीन तत्काल खुशी छे मान्य कर लेय छे। <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />पुन आपने माहीय मुवन भार नी राखने क कारण वो थुड़ा ही दाहड़ा क करता रयते छे; ओको बाद जव वचन क कारण उन पर पीड़ा यो झगड़ो करावनो हुयसे छे, तो वो तत्काल ठोकर खाय छे। <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />जो झाड़का मा वेराय गयो यो वो छे, जिन्होने वचन सोमव्या, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />आरू संसार की चिंता, आरू धन क धोखा, आरू दिसरो समान क लोभ ओका समाकर वचन क दाबाय देता छे आरू वो निष्फल रया जाता छे। <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />“आरू जो वारली धरती मा वेराय गयो, यो वो छे जो यहोवा–भगवान क वचन सोमवीन मान्य करतो आरू फव लायो छे: तीस गुणा, काही साठ गुणो आरू काही सौ गुणो।”<verse eid="MRK 4:20" /></para>
  <para style="s">दिवा क सपनो</para>
  <para style="r">(<ref loc="LUK 8:16-18">लूका 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:21 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:15">मत्ती 5:15</ref>; <ref loc="LUK 11:33">लूका 11:33</ref></char>
    </note>ईशु ने उनछे कयो, “काय दिया एरकरीन लावता छे कि कागनी यो खाटलो क नेचो राख जाय? काय एरकरीन नी कि दीवट पर राख देने? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" /><note caller="+" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="MAT 10:26">मत्ती 10:26</ref>; <ref loc="LUK 12:2">लूका 12:2</ref></char></note>काहकि यहोवा–भगवान क राज्य काही वात साताय नी, पुन एरकरीन छे कि प्रगट होय जाए; आरू नी काय सातायलो छे, पर एरकरीन छे कि प्रगट होय जाय। <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />यदि काही क सोमवने क कान्टा हुयो, तो वो सोमवी लेय!”<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:24 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:2">मत्ती 7:2</ref>; <ref loc="LUK 6:38">लूका 6:38</ref></char>
    </note>पछु ईशु ओका कयो, “सावधान रयो कि जो काय तुमू सोमवता छे। जा नाप छे तुमू नापता छे ओको से तुमू क करता नापाय से, आरू तुमू क सवटो आपसे जाछे। <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" /><note caller="+" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="MAT 13:12">मत्ती 13:12</ref>; <ref loc="MAT 25:29">25:29</ref>; <ref loc="LUK 19:26">लूका 19:26</ref></char></note>काहकि जेका साथे छे, ओको दीया जाछे; आरू ओका साथे नी छे, ओका सी वो भी जो ओको साथे छे, लेय लीया जाछे”<verse eid="MRK 4:25" /></para>
  <para style="s">उगत हुयो बीज क सपनो</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />पछु ईशु ने कयो, “यहोवा–भगवान क राज्य ओसो छे, जोसो काही मानुस धरती पर बीज वेरे, <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />आरू रात क सुयो आरू दाहड़ा मा जाग्या, आरू वो बीज ओसो उगे आरू मोठे कि वो नी जानो। <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />धरती आप छे आप धान लावती छे, पेहले अंकुर, तव उम्बीया, आरू झटा मा तीयार दाना। <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />पुन जव दाना पाक जाय छे, तव वो तत्काल दातवा क दार लागाड़ता छे, काहकि काटनी आय पुगी छे।”<verse eid="MRK 4:29" /></para>
  <para style="s">राई क दानो क सपनो</para>
  <para style="r">(<ref loc="MAT 13:31">मत्ती 13:31</ref>,<ref loc="MAT 13:32">32</ref>,<ref loc="MAT 13:34">34</ref>; <ref loc="LUK 13:18-19">लूका 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />पछु ईशु ने कयो, “हामु यहोवा–भगवान क राज्य की बराबरी कुनी सी देंय, आरू काही सपनो छे ओका वर्णन कर्‍यो? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />वो राई क दाना क समान छे: जव धरती मा वेराय जाय छे तो धरती क सब बीजों नानो होय छे, <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />पुन जव वेरने गया, तो उगीन सब सागपात छे मोटा होय जाता छे, आरू ओकी ओसी मोटी डावखा निकवता छे कि क चिल्ला ओकी साहवामा पांजरू कर सकता छे”<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />वो तिनुक इनीये प्रकार क घोणा छे सपनो आपीन ओकान समझ क लारे वचन सोमवता हुता, <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />आरू बिना सपनो कये वो उनछे काही भी निही कयता हुता; पुन सुनला मा वो आपने निज चेला क सब वात क मतलब समजाड़तो हुता।<verse eid="MRK 4:34" /></para>
  <para style="s">वाहवाक क बंद करने</para>
  <para style="r">(<ref loc="MAT 8:23-27">मत्ती 8:23-27</ref>; <ref loc="LUK 8:22-25">लूका 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />तीनी दाहड़ा जव शांत हुयी, तो ईशु ने चेला छे कयो, “आवु, हामु पार चल्या।” <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />आरू वो गर्दी क छुड़ीन जोसो वो हुता, वोसो ही ओको ढोंड्या पर साथे ली चाल्या; आरू ओको साथे आरू भी ढोंड्या हुती। <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />उचकाळुन मोट वाहवा आयो, आरू झेलक ढोंड्या पर याहा तक लागी कि वो पानी छे भराय जाती हुती। <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />पर वो आप पोछल भाग मा ताक्यो पर सुय रया हुता। तव त्या ओको जाईन ओका सी कयो, “हे गुरू, काय तुखे चिंता नी कि हामु नष्ट हुय जाय छे?”<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />तव त्यो उठीन वादुन क धमकाय, आरू पानी छे कयो, “शांत रया, थाम जा!” आरू वादुन थाम गयो आरू मोटा चैन होय गया; <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />आरू उनछे कयो, “तुमू काय घाबराय होय? काय तुमू हिमी तक विश्वास नी?”<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />वो घणा ही बिही गया, आरू आपसु मा बुल्या, “यो कुन छे कि वादुन आरू पानी भी ओकी हुकुम मानता छे?”<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">द्रूष्टात्माग्रस्त–लोगहन क वारू करने</para>
  <para style="r">(<ref loc="MAT 8:28-34">मत्ती 8:28-34</ref>; <ref loc="LUK 8:26-39">लूका 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />ईशु दरियो क पार गिरासेनियो क देश मा पुच्या, <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />ईशु जव वो ढोंड्या पर रईन उतरियो तो तत्काल एक मानसन जिनामा विटळ आत्मा हती, मोळवट्या मा रईन आवीन ईशु क देखाई। <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />काहकि वो बीड़ाम रयतो हतो आरू कोय तीनाक साकव करीन बांध भी नी सकता हता, <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />काहकि वो बार–बार साकव करीन बांधता हता, पुन त्यो साकव क तुड़ दिदो आरू साकव क टुकड़ा–टुकड़ा कर दिदो हतो, आरू कोय ओको मानाळी भी नी सकता। <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />वो लगातार रात–दाहड़ो मोड़वाट्याम आरू बयड़ाम आयड़े, आरू वो दगड़ा छे ठुकरायतो हतो।<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />वो ईशु क दुर रईन देखीन दौड़ीन ईशु क बुलाड़े, <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />आरू जुरे से ओवाज मा आयड़ीन कयो, “हे ईशु, महान यहोवा–भगवान क पोर्‍या, मखे तुखे छे काय काम छे? हाव तुखे यहोवा–भगवान क शपथ खाम की मखे पीड़ा मा आपे।” <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />काहकि ईशु ओको कयो, हतो “हे विटळ आत्मा इन मानुस मा रईन निकवी जा।”<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />ईशु ओका पुछु, “थारो नाव काय छे?”</para>
  <para style="p" vid="MRK 5:9">त्यो ईशु कयो, “मारो नाव सेना छे; काहकि हामु घणा सोवटा छे!” <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />आरू त्यो ईशु क विनती करने लाग्या, “हामु क इन प्रदेश रईन बाहर मा मुकले।”<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />वो बयड़ा पर सुहर्‍या क टुवु चर रया हता। <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />त्यो ईशु क विनती करीन कयो, कि “हामु इनु सुहर्‍या मा मुकली दे कि हामु ओको साथे जासु।” <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />शेवली कावा ईशु ने हुकुम दिदो आरू विटळ आत्मा निकवीन सुहर्‍या क धोड़े गयु त्यो आरू टुवु दुइ हजार क हतो, बयड़ा धड़े रईन दौड़ीन गया आरू दरिया मा जाईन आरू डूब मर्‍या।<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />ओका चारनेवावा ढ़ासाड़ीन नगर आरू गाव मा खबर सोमवाळ्या, आरू जो हयो हतो, लोगहन ओको देखने आया। <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />ईशुन क साथे आवीन वो ओको जी साहळा समाई हती, छिंदरा पेहरने आरू विचार करीन देखीन घबराय गया। <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />देखनेवावा ने ओकाम साहळा हती, आरू सुहर्‍या क पुरा हाल ओको क कय सोमवाळ्यो।<verse eid="MRK 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 5:17" />तव वो ओको रावन्या करीन कयनो लाग्यो कि हामरी सिवम रईन जात रया।<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />जव वो ढोंड्या पर चढ़ने लाग्यो ते वो जिनमा पेहल साहळा हती, तीनाक रावन्या करने लाग्यो, “मखे तारे साथे रयने दे।”<verse eid="MRK 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 5:19" />पुन ईशु ओको आवने नी दिदो, आरू तीनाक कयो, “आपने घर जाईन आपसा लोगहन क कयजी कि तख पर दया करियो, ईशु क थारे करता कोसो मोठ काम करियो छे।”<verse eid="MRK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 5:20" />वो जाईन दिकापुलिस नगर मा इन वात क खबर करने लाग्यो कि ईशु मख करता कोसो मोठ काम कर्‍या; आरू आखा लोगहन भोंगलाय गयो हतो।<verse eid="MRK 5:20" /></para>
  <para style="s">याईर क मरली पोराय आरू एक बीमार बायर</para>
  <para style="r">(<ref loc="MAT 9:18-26">मत्ती 9:18-26</ref>; <ref loc="LUK 8:40-56">लूका 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />जव ईशु पछु ढोंड्या पर बठीन पल धोड़े गयो, ते एक मोटी गर्दी ओको साथे एखठी होय गय। वो तलाव क धोड़े हतो कि <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />याईर नाव क प्रार्थना घर क सरदार मा रईन एक आयो, ओको नाव याइराईस हतो, चाँ आयु यो देखी वो कुन छे, ओको पाय पड़्या, <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />आरू यो रावन्या करने लाग्या कि, मारी “नानली पोराय मरना क होय रई ईशु आवीन तेर पर हाथ राखीन ते ची आरगी होईन जीवती रवे।”<verse eid="MRK 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24" />तव ईशु ओका साथे चाल्यो; आरू ओको पछल मोटी गर्दी होई, आरू ईशुन पछल चाल पड़ी आरू ईशु पर पड़ने लाग्या।<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />एक बायर हती, ओका बारा साल होय तक ओका लुहूय यो उहवनेन बीमारी हती। <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />ची घोणा मुवा–बुटीवावा क देखाड़ी पुन काहय चो दुःख वारू नी हयो, आरू ओको धन भी सच्च करीन भी ओको कोय फायदु नी हयो, पुन आरू ची बीमारी मा रई। <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />वो ईशु क वात सोमवीन गर्दी मा आवी ओको पछव रईन आवीन आरू ईशुन क छिंदरा क हाथ लागाड़ी, <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />काहकि ची कयती हती, “कदी हाव ओका ईशुन छिंदरो छिमलीस ते हाव आरगी होय जाईस।”<verse eid="MRK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29" />तत्काल ओको लुहूय यो बंद होय गयो, आरू ची आपसा डील मा जान लेदी कि हाव वो बीमारी रईन वारू होय गय। <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />ईशु तत्काल आपसा मन मा जान लेदु कि मारी शक्ति निकवीन, आरू गर्दीन पछव फिरीन कयो, कि “मारा छिंदरा क कुन हाथ लागाड़यो?”<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />ईशुन चेलाक ओको कयो, कि “तु देखतु छे आरू गर्दी तख पर पड़े आरू तु कयो कि कुन मख हाथ लागाड़यो?”<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />तव ईशु देखने करीन क जो हाथ लाग्याड़या ओको। चारो तरफ देखने लाग्यो। <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />तव वो बायर यो जाने की ईशु क साथे, बीहती–बीहती ओको पायमा पड़ी आरू आखी सच्चाई कयी। <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />ईशु तीनी बायर काजे कयो, “पोराय, थारो विश्वास ने तखं वारू करियो, खुसमा जा आरू बीमार से वाचीन रोवे?”<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />वो यो कयनो बाज रयो हतो कि प्रार्थना घर क सरदार घर रईन लोगहन आवीन कया, “थारी पोराय ते मर गय, हिमी गुरू क काँ दुःख देता से?”<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />“ईशु यो सोमव्यु कि यहूदियान प्रार्थना घर मा सरदार कयो मा बिहु विश्वास राखो।” <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />आरू ईशु ने पतरस आरू याकूब क भाई यहुन्ना क छुड़ीन, आरू दिसरा क नी आवने देतो। <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />प्रार्थना घरन क सरदार क घर पुग गयो, ईशु लोगहन क रोड़ता आरू आयड़ता देख्या। <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />तव ईशु ओको पास जाईन कयो, “तुमू काँ रड़ु पोराय मरी नी पुन सुव रया।”<verse eid="MRK 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40" />चे ईशु क हासने लाग्या तेत्योर ईशु सबहन क बाहर निकाल्यो पोराय माय–बास क आरू ओको साथी पास गयो, जा चाँ पोराय पड़ रया हती। <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />आरू पोराय क हात धरीन ओको कयो, “ललीता कुमी” ओको मतलब, “हे पोराय, हाव तखं कयो तु उठ!”<verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />आरू पोराय तत्काल उठीन चालने आरू फिरने लागी; काहकि ची पोराय बारा साल क हती। ओको पर लोगहन भोंगलाय गया। <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />ईशु उन लोगहन क कयो, कि यी घटना क बारामा कय क खबर नी चाले, आरू पछु ओको कयो, “वो पोराय क काहय खाने आप देवु।”<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">नासरत मा ईशु क विजुत नी करनो</para>
  <para style="r">(<ref loc="MAT 13:53-58">मत्ती 13:53-58</ref>; <ref loc="LUK 4:16-30">लूका 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />वाँ से निकलीन ईशु आपने देश मा नासरत आयो, आरू ओको चेला भी ओको पछव गया। <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />सब्त क दाहडू वो प्रार्थना घर मा प्रचार करने लाग्या, आरू खुब से मानसे सोमवीन चकित हुये आरू कयनो लाग्या, “इनीये क यी वात कयो से आय गय? यो कुन से ज्ञान से जो ओको दिया गया से? कोसो शक्ति क काम ओको हात से प्रगट होयते से?” <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />काय यो वो सुतार नी, जो मरियम क पोर्‍यो आरू याकूब, योसेस, यहूदा, आरू शमौन क भाई से? काय ओकी बहिनीस याहा हामरे वीच मा नी रयती? अतरान करीन त्या ओको विषय मा ठोकर खाय।<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:4 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 4:44">यहुन्ना 4:44</ref>
      </char>
    </note>ईशु ने उनछे कयो, “कागळीयान क आपने देश, आरू आपने घरानो, आरू आपने घर क छुड़ीन आरू कयी भी आपमान काहनी नी हुता”<verse eid="MRK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5" />वो वाँ काही शक्ति क काम नी कर सक्या, केवल थुड़े–से बेमार पर हात राखीन तीनुक वारू कर्‍या।<verse eid="MRK 6:5" /></para>
  <para style="s">बारतो प्रेरितन क मुकल्या गया</para>
  <para style="r">(<ref loc="MAT 10:5-15">मत्ती 10:5-15</ref>; <ref loc="LUK 9:1-6">लूका 9:1-6</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 6:6" />आरू ईशु क ओको विनभुरसा पर विछेळीयो हुयो, आरू वो चार आरू क गाव मा प्रचार करता फिर्‍यो। <verse eid="MRK 6:6" /><verse number="7" style="v" sid="MRK 6:7" />ईशु ओका बारा चेलाक क आपने साथे बुलायु आरू तीनुक दुय करीन मोकलने लाग्या; आरू तीनुक साहळा पर हक दियो। <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />ईशु ओका आदेश देदो, “मार्ग क करता लाठी छुड़ीन आरू काही नी ली जानु; ते रोटा, नी झुली बटुए मा पोशा, <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />पुन खासड़ा पेहरीन आरू दुई सुटरे नी पेहरीन।” <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />आरू ईशु ओका कयो, “वा कयी तुमू काही घर मा उतरो, ते जत्यार तक वाँ से वाट लागाड़्या नी होय तत्यार तक तीनी घर मा रूकाय रयो। <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />जिना स्थान मानसे तुमूक मान्य नी करे आरू तुमरी नी सोमवे, वाँ से चालता ही आपने तलवों की धुवो झाड़को नाखो कि उन पर गवा होय”<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />तत्यार त्या जाईन प्रचार कर्‍या कि पाप सुडो मन फिरावो, <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />आरू घण सवटा साहळा क निकाळ्या, आरू घण सवटा न बेमारी पर तेल लगाड़ियो आरू तीनुक वारू कर्‍यो।<verse eid="MRK 6:13" /></para>
  <para style="s">यहुन्ना बपतिस्मा देने वावा की हत्या</para>
  <para style="r">(<ref loc="MAT 14:1-12">मत्ती 14:1-12</ref>; <ref loc="LUK 9:7-9">लूका 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />हेरोदेस राजा ने भी ईशु की चर्चा सोमवी, काहकि ओको नाव फैल गया हुता, आरू उसने कयो, “यहुन्ना बपतिस्मा देनेवावा मरला मा से, जीव उठ्यो इनी करता ओका सी यो शक्ति क काम प्रगट होयते से”<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />दिसरा मानसे ने कयो, “यो एलियाह से।” पुन काही दिसरा ने कयो, “भविष्यव्दक्ता या भविष्यवक्ता मा से काही एक क समान से”<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />हेरोदेस ने यो सोमवीन कयो, “जिना यहुन्ना क मुनका मा ने कटाड़ीया हुता, चो जीव उठ्यो।” <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />हेरोदेस ने आपने भाई फिलिप्पुस कि लुगाई हेरोदेस क कारण, जिना उसने वियाव कर लेदा हुता, मानसे क मुकलीन यहुन्ना क धराया जेल मा नाख दिया हुता; <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />काहकि यहुन्ना ने हेरोदेस से कयो हुता, “आपने भाई कि लुगाई क राखने वारू नी”<verse eid="MRK 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19" />अतरान करीन हेरोदेस ओका सी बैर राखती हुती आरू यो चाहती हुती ओका सी मारीन नाखने; पुन ओसो नी होय सके, <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />काहकि हेरोदेस यहुन्ना क न्यायी आरू चुखलो पुरूष जाईन ओको घाबराय हुतो, आरू ओको वाचाड्य राखता हुता, आरू ओकी वात सोमवीन खुब घाबराया हुता, पर खुशी से सोमव्या हुता।<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />ठीक मेखे आया जत्यार हेरोदेस ने आपने जनम दाहड़ा मा आपने प्रधान, आरू सेनापती, आरू गलील क मटे मानसे क करता खानो कर्‍या। <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />तो हेरोदेस की पोराय माहीय आवीन, आरू नाचीन हेरोदेस क आरू ओका साथे बोठनेवावा क खुश कर्‍या। तत्यार राजा ने पोराय से कयो, “तुखे जो जुवे मखे से मांग मे तुखे आपीस।” <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />आरू ओका सी शपथ खाई, “मे आपने आधा राज्य तक जो काय तु मारे से मांगीस मे तुखे आपीस”<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />वो बारतो जाईन आपसी माता से पुछा, मे काय मांग? वो बुली, यहुन्ना बपतिस्मा देनेवावा क मुनको।<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />वो छाटत राजा क साथे माहीय आवी आरू ओका सी विनती करी, “मे जुवे से कि तु हीमी यहुन्ना बपतिस्मा देनेवावा क मुनको एक थाली मा मखे मांगाळ दे।”<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />तत्यार राजा खुब नराज हुया, पुन आपसी शपथ क कारण आरू साथे बोठनेवावा क कारण ओका सी टावने नी चाह्या। <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />अळते: राजा ने छाटत एक शिपाई क हुकुम देकर मुकल्यो कि ओको मुनक काटीन लाया। <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />उसने जेलखाना मा जाईन ओको मुनक काटीन, आरू एक थावी मा राखीन लाया आरू पोराय क दिया, आरू पोराय ने आपसी आया क दिया। <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />यो सोमवीन यहुन्ना क चेला आया, आरू ओका धड़ क ली गया आरू गाड़ देदा।<verse eid="MRK 6:29" /></para>
  <para style="s">प्रेरितन न पछो आवनो</para>
  <para style="r">(<ref loc="MAT 14:13-21">मत्ती 14:13-21</ref>; <ref loc="LUK 9:10-17">लूका 9:10-17</ref>; <ref loc="JHN 6:1-14">यहुन्ना 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />प्रेरितन ईशु क साथे एखठा हईन, जो काय त्या कर्‍या आरू सिकाड्या हुता, सब ओको कयो। <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />उसने उनछे कयो, “तुमू आप अलग काही सुनला स्थान मा चालीन थुड़ा आराम करो।” काहकि खुब मानसे आवता जाता हुता, आरू तीनुकं खाने क मेखे भी नी मिवता हुता। <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />अतरान करीन वो ढोंड्या पर चढ़ीन सुनसान धरती मा अलग चालीन गया।<verse eid="MRK 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33" />खुब ने तीनुकं जाता देखीन उवखता हुता, आरू सब नगर से एखटा हुयने वो पाये दोवड़ीन आरू उनको पेहल जाय पुग्या। <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" /><note caller="+" style="x"><char style="xo" closed="false">6:34 </char><char style="xt" closed="false"><ref loc="MAT 9:36">मत्ती 9:36</ref></char></note>उसने उतरीन मोटी गर्दी देखीन, आरू उन पर तरस खाया, काहकि वो उन गाडरा क समान हुते, जेका काही राखनेवावा नी होय; आरू वो तीनुक खुब सी वात सिखाडने लाग्या। <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />जत्यार दाहडू खुब ढव गयो, तत्यार चेला ईशु क साथे आवीन कयनो लाग्या, “यो सुनसान धरती मा से, आरू दाहडू खुब ढल गयो से। <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />तीनुक विदा करीन की चार आरू क गाव आरू वस्ती मा जाईन, आपने करता काही खाने क मुवे लेदा”<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />उसने ने जवाब दिया, “तुमू ही तीनुक खाने क आपो।” त्या ओको कयो, “काय हामु दुय सौ दीनार दुय सौ काहकि दाहड़ा की दाहडकी रूटा मुवे ली तीनुकं खावड़ाया?”<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />उसने उनछे कयो, “जाईन देखा तुमरे साथे कतरा रूटा से?” त्या मालम करीन कयो, “पाच रूटा आरू दुई मासा भी”<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />तत्यार उसने तीनुकं हुकुम देदी की सब क खोड़ो पर पंगात–पंगात से बट्या दे। <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />वो सौव आरू पचास–पचास करीन पंगात–पंगात बट्या गया। <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />उसने उन पाच रूटा करीन आरू दुई मासा क लेदा, आरू सोरग क तरफ देखीन धन्यवाद कर्‍यो, आरू रूटा कर चेला क देता गया की वो मानसे क पुरसे, आरू वो दुई मासा भी उन सब मा वाट दीया। <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />सब खाईन तुप्त होय गया, <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />आरू त्या तुकड़ा से बारा मसका भरीन हाकल्या, आरू काय मासा से भी। <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />रूटा खानेवाला, मानसे पाच हजार हुता।<verse eid="MRK 6:44" /></para>
  <para style="s">ईशु क पानी पर चालने</para>
  <para style="r">(<ref loc="MAT 14:22-33">मत्ती 14:22-33</ref>; <ref loc="JHN 6:15-21">यहुन्ना 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />तत्यार ईशु ने छाटत आपसा चेला क ढोंड्या पर चढ़ने क करता मजबुर कर्‍यो कि वो उनछे पेहल उना पार कफरनहूम क चालीन जाय, जत्यार तक कि वा मानसे क वाट लागाड़्या कर्‍यो। <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />तीनुक वाट लागाड़ीन मग वो बयड़ा पर प्रार्थना क गया। <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />जत्यार शांत हुयी, ती ढोंड्यो दरिया क वीच मा हुती, आरू वो एखलो धरती पर हुता। <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />जत्यार उसने देखा कि वो खेते घबराय गया से, काहकि वाहवा ओको विरोध हुती, तो रात क चौथे पहर निकट वो दरिया पर चालतो हुतो ओको साथे आया; आरू उनछे अगोळ निकवी जाने जुवता हुता। <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />पुन त्या ओका सी दरिया पर चालता देखीन समझ्या कि भूत से, आरू आयड़ीन उठ्या।<verse eid="MRK 6:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 6:50" />काहकि सब ओका सी देखीन घाबराय गया हुता। पर उसने छाटत उनछे वात कि आरू कयो, “ढाढ़स बांधो: मे से बीहु मा।” <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />तत्यार वो ओको साथे ढोंड्यो पर आया, आरू वाहवो रूक गयो: आरू वो खुप ही आश्‍चर्‍य करने लाग्या। <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />वो उन रूटा क विषय मा नी समझ्या हुता, काहकि ओको मन वातड़ो होय गया हुता।<verse eid="MRK 6:52" /></para>
  <para style="s">गन्नेसरत मा बेमार क वारू करने</para>
  <para style="r">(<ref loc="MAT 14:34-36">मत्ती 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />ईशु पार उतरीन गन्नेसरत मा पुच्या, आरू ढोंड्यो घाट पर लागाड़या। <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />जत्यार वो ढोंड्यो पर से उतरियो, तो मानसे छाटत ओको उवख कर्‍यो, <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />आस पास क आखा देश मा दोवड़्या, आरू बेमार क खाटला पर नाखीन, वा–वा खबर सोमव्या कि वो से, वाँ–वाँ करता फिरीया। <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />आरू वा कयी वो गाव, नगर, या वस्ती मा जाता हुता, मानसे बेमारी क हाट मा राखीन ओका सी विनती करता हुते कि वो तीनुकं आपने छिंदरा क छेवड़ा ही क हात लागाड़ लेने दे: आरू जोतरा ओका सी हात लागाड़ हुते, सब वारू होय जाय हुते।<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">रीति पावनेन सवाल</para>
  <para style="r">(<ref loc="MAT 15:1-9">मत्ती 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />तव फरीसि आरू काही शास्त्री जो यरूशलेम छे आश हुते, ईशु क साथे एखठा हुया, <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />आरू त्या ओको काही चेला क विटळ मतलब बिना धुया हात छे रूटा खाय देख्या<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />काहकि फरीसि आरू सब यहूदि, डाहडान कि रीति पर चालता छे आरू जव तक भली भाति हात नी धुय लेता तव तक नी खाय; <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />आरू बजार मा आवीन, जव तक स्नान नी कर लेता, तव तक नी खाय; आरू घोणा सी दिसरी वात छे, जो ओको साथे मानने क करता पुच्याया गय छे, जोसो वाटको, आरू कोवषो आरू तांबान ठाहरा क धुवनु।<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />एरकरीन उन फरीसियों आरू शास्त्रीया ने ओको पुछा, “थारा चेला कयो डाहडा की रीति ने पर नी पर चालता, आरू बिना धुये हात छे रूटा खाया हुता?”<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />त्यो उनछे कयो, “यशायाह ने तुमू कपटियों क विषय मा घोणा ठीक भविष्यव्दाणी की; जोसो लिख्या छे।”</para>
  <para style="q1" vid="MRK 7:6">यो मानसे हुठड़ा छे तो मारो विजुत करता छे,</para>
  <para style="q2" vid="MRK 7:6">पर ओको मन मखे छे दूर रयता छे।<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />“यो व्यर्थ मारी आराधना करता छे,</para>
  <para style="q2" vid="MRK 7:7">काहकि मानुस की हुकुम क न्याय ोउपदेश करीन सिकाड़ता छे</para>
  <para style="q2" vid="MRK 7:7">त्या विचार करे कि यो यहोवा–भगवान क नियम छे।”<verse eid="MRK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8" />“काहकि तुमू यहोवा–भगवान की हुकुम क टावीन मानुस की रीति क मानता छे।”<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />त्यो उनछे कयो, “तुमू आपसी रीति क मानने क करता यहोवा–भगवान की हुकुम कोसी वारली तरह टावने देता होय! <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />काहकि मूसा ने कयो छे, आपने बास आरू आपसी माय क विजुत कर आरू जो काही बास वो माय क बुरा कये वो पाको मार नाखीन जाने।” <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />“पुन तुमू कयता होय की यदि काही आपने बास वो माय छे कये, जो काय तुखे मखे छे लाभ पुग सकता हुता, वो कुरबान मतलब संकल्प होय चुक्यो।” <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />तो तुमू ओको ओका बास वो ओकी माय की काय सेवा करने नी दिदा। <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />“इनीये प्रकार तुमू आपसी रीति छे, जिन्हे तुमू ने ठहराया छे, यहोवा–भगवान क वचन टावने देद होय; आरू ओसो घोणा छे काम करता होय।”<verse eid="MRK 7:13" /></para>
  <para style="s">मानुस क विटळ करने वावी वात</para>
  <para style="r">(<ref loc="MAT 15:10-20">मत्ती 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />तव ईशु ने मानसे क आपने साथे बुलावीन उनछे कयो, “तुमू आखा मारी सोमवु, आरू समझु। <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />ओसी काही समान नी जो मानुस मा बाहरता छे समाकर ओको विटळ कर्‍यो; पुन जो समान मानुस क माहाय छे निकवती छे वो ही ओको विटळ करती छे। <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />यदि काही क समवने क कान्टा छे तो समवने लेय”<verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />जव वाँ गर्दी क साथे छे घर मा गया, ती ओको चेला ने इनीये सपनो क विषय मा उना छे पुछा। <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />ईशु उनछे कयो, “काय तुमू भी ओसो नीसमझ होय? काय तुमू नी समझते कि समान बाहरता छे मानुस क माहीय जाती छे, वो उको विटळ नी, कर सकती? <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />काहकि वो ओका मन मा नी पुन पेट मा जाती छे आरू शौच मा निकवती जाती छे?” यो कयकर त्यो सब खाने समान क चुखो ठहराया।<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />पछु त्यो कयो, “जो मानुस मा छे निकवता छे, चो मानुस क विटळ करता छे। <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />काहकि माहीय छे, मतलब मानुस क मन छे, बुरो विचार व्यभिचार, चुरी, हत्या, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />लोभी, दुष्टता, छल, लुचपन, कुदिष्ट, निन्दा, दाहवाय, आरू मुर्खता निकवती छे। <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />यो सब बुरी वात माहीय ही छे निकवती छे आरू मानुस क विटळ करती छे”<verse eid="MRK 7:23" /></para>
  <para style="s">सोरूफिनीकी जाति की बायर क विश्वास</para>
  <para style="r">(<ref loc="MAT 15:21-28">मत्ती 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />पछु ईशु वाँ छे उठीन सोर आरू सीदोन क देश मा आश; आरू एक घर मा गया आरू जुवे था कि काही नी जाने; पुन वो साताय नी सक्या। <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />आरू तत्काल एक बायर जेरी नानली पोराय मा साहळा हुती, ओकी चर्चा सोमवीन कर आवी आरू ओका पाय पर पड़ी। <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />यो युनानी आरू सुरूफ‍िनिकी काहली जाति कि हुती। त्यो ओको विनती करी की मारी पोराय मा छे साहळा निकाव दे। <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />त्यो ओको कयो, “पेहल पोर्‍या क तुप्त हुयने दे, काहकि पोर्‍या क रोटा लीन कुत्रा क ओगव नाख्या वारू नी छे”<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />त्यो ओको जवाब दिया, “सच छे पोरबु; तव कुत्रा भी तो हावज क नेड़ो पोर्‍या क रोटा क चूर–चार खाय लेता छे”<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />ईशु ओको कयो, “इन वात क कारण शांती मा चाली जाय; साहळा तारी पोराय मा छे निकवी गय छे”<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />त्यो आपने घर आवीन देख्य कि पोराय खाटला पर पड़ी छे, आरू साहळा निकवी गय छे।<verse eid="MRK 7:30" /></para>
  <para style="s">बेहरा आरू गुंगा क वारू करने</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />पछु ईशु सोर आरू सीदोन क देश छे निकवीन दिकापुलिस छे हुता हुया गलील की ढोंड्या पर पुच्या। <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />तो मानसे ने एक बेहरा क जो हक्ला भी हुता, ओको साथे लावीन ओका सी रावन्या करी कि आपसा हात ओको राखे। <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />तव वो ओको गर्दी छे अलग ली गया, आरू आपसी आंगवी ओका कान्टा मा नाख्या आरू थुपीन ओकी जीभ क दरिया; <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />आरू सोरगदूत की आरू देखीन दम भरी, आरू उना छे कयो, “इप्फत्तह!” मतलब “उघड़ जा!”<verse eid="MRK 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35" />ओका कान्टा उघड़ी गया, आरू उना की जीभ की गाठ भी उगड़ी गय आरू वो सच–सच बुलने लाग्या। <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />तव त्यो तीनुक चिताया की काही छे नी कयनो; पुन जोतरा त्यो तीनुक चिताया ओतरा ही वो आरू खबर करने लाग्या। <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />वो घोणा ही घबरायीन मा हईन कयनो लाग्या, “त्यो जो काय कर्‍या सब वारू कर्‍या छे; वो बेहरा क सोमवने की, आरू गूंगा क बुलने की शक्ति देता छे!”<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">ईशु चार हजार मानसक क खावड़ाया</para>
  <para style="r">(<ref loc="MAT 15:32-39">मत्ती 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />इनु दाहड़ा मा जव पछु मोटी गर्दी एखठी होय, आरू ओको साथ काय खाने क नी हुता, तो ईशु आपने चेला क साथे बुलावीन त्यो कयो, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />हावखे इनीये गर्दी पर तरस आवता छे, काहकि यो तीन दाहड़ा छे मारे साथे छे, आरू ओको साथे काय भी खाने क नी। <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />“कदाम हांव उन लोगहन क भुखला घर मुकली दिस, तो वाट्ये घबराय पड़से; काहकि ओका मा सी कोय–कोय दुर सी आवला छे।”<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />ईशु क चेला ओको जवाब दिया, “याहा जंगल मा ओतरा रूटा काय कयो छे लावने कि यो तुप्त होय?”<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />ईशु ओको पुछा, “तुमरे साथे कतरा रूटा छे?”</para>
  <para style="p" vid="MRK 8:5">त्या कयो, “सात।”<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />तव त्यो मानसे क धरती पर बट्या की हुकुम दिदा, आरू वो सात रोटा लेदा आरू धन्यवाद करीन तुड़ीन आरू आपने चेला क देता गया कि ओको अगळ राखे, आरू त्या मानसे क अगळ परोस दिया। <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />ओको साथे थुड़ी सी नानी मासी भी हुती; त्यो यहोवा–भगवान धन्यवाद करीन तीनुक भी मानसे क अगळ रखने की हुकुम दी। <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />वो खाय तुप्त होय गया आरू चेला ने शेष तुकड़ा क सात खिल्ला भरीन हाकलिया। <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />आरू मानसे चार हजार क लग भग हुता; तव त्यो ओका वाट लागाड़्या, <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />आरू वो तत्काल आपसा चेला क साथे ढोंड्या पर चढ़ीन दलमनूता प्रदेश क चहड़ीन गया।<verse eid="MRK 8:10" /></para>
  <para style="s">फरीसियो द्वारा सोरगदूतीय सहलानी की मांगछे</para>
  <para style="r">(<ref loc="MAT 12:38-42">मत्ती 12:38-42</ref>; <ref loc="MAT 16:1-4">16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:11 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:38">मत्ती 12:38</ref>; <ref loc="LUK 11:16">लूका 11:16</ref></char>
    </note>पछु फरीसियो आवीन ईशु छे वाद–विवाद करने लाग्या, आरू उको जांचने क लेदा ओका सी काही सोरगदूतीय सहलानी मांगने। <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" /><note caller="+" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 12:39">मत्ती 12:39</ref>; <ref loc="LUK 11:29">लूका 11:29</ref></char></note>त्यो आपसी आत्मा मा दम भरकर कयो, “इन टेहाव क मानसे काय सहलानी हेरता छे? हाव तुमू छे सच कयता छे कि इन टेहाव क मानसे क काही सहलानी नी दिया जाछे”<verse eid="MRK 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 8:13" />आरू वो तीनुक छुड़ीन पछु ढोंड्या पर चढ़ीन गया आरू पार चालीन गया।<verse eid="MRK 8:13" /></para>
  <para style="s">फरीसियों ने ईशु क चमत्कार करने क कहा</para>
  <para style="r">(<ref loc="MAT 16:5-12">मत्ती 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />चेला रूटा लेने भूल गया हुते, आरू ढोंड्या मा ओको साथे एक ही रोटा हुती। <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" /><note caller="+" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="LUK 12:1">लूका 12:1</ref></char></note>ईशु ने तीनुक चिताया, “देखा, फरीसियों क खमीर आरू हेरोदेस क खमीर छे सावधान रयो”<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />वो आपस मा विचार करीन कयनो लाग्या, “हामरे साथे रोटा नी छे”<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />यो जानीन ईशु ने उनछे कयो, “तुमू काय आपस मा यो विचार करीन रया होय कि हामरे साथे रोटा नी? काय हिमी तक नी जानता आरू नी समझ्या? काय तुमरा मन वातड़ो होय गया छे?” <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" /><note caller="+" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="MRK 4:12">मरकुस 4:12</ref></char></note>काय डुवा राखते हुया भी नी देखता, आरू कान्टा राखते हुया भी नी सोमवते? आरू काय तुमू स्मरण नी?<verse eid="MRK 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 8:19" />कि जव हाव ने पाच हजार क करता पाच रोटा तुड़ी हुती तुमू ने तुकड़ा कर्‍यो कोतरी मसका भरीन हाकलिया हुते त्या ओको कयो, “बारा मसका”<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />“आरू जव चार हजार क करता सात रोटा हुती ती तुमू तुकड़ा क कोतरा खिल्ला भरीन हाकलिया हुता?”</para>
  <para style="p" vid="MRK 8:20">त्या उनछे कयो, “सात मसका”<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />पर ईशु ओका क कयो, “काय तुमू हिमी तक नी समझ्या?”<verse eid="MRK 8:21" /></para>
  <para style="s">ईशु बैतसैदा गाव मा एक आंधवा क वारू कामो</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />वो बैतसैदा मा आश।</para>
  <para style="p" vid="MRK 8:22">आरू मानसे एक आंधवा क ओका साथे ली आश आरू ईशु क रावन्या करी कि ओको धर्‍यो। <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />वो उना आंधवा क हात धरीन ओको गाव क खयड़े ली गया, आरू ओका डुवा मा थुपीन उना पर हात राख्य, आरू ओका सी पुछा, “काय तु काही देखता छे?”<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />त्यो डुवा उचा करीन कयो, “मा मानुस क देखता छे; वो मखे चालता हुये झाड़को जोसो देखाय दिदा छे”<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />तव त्यो दुई कावा ओकी डुवा पर हात राख्य, आरू सब आंधवा ने ध्यान छे देख्य। वो वारू होय गयो, आरू सब सच–सच देखने लाग्या। <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />त्यो ओको यो कयकर घर मुकल्या, “इन गाव क माहीय पाय भी नी राखने”<verse eid="MRK 8:26" /></para>
  <para style="s">ईशु जो यहोवा–भगवान नेवाड़लो तारणारो छे</para>
  <para style="r">(<ref loc="MAT 16:13-20">मत्ती 16:13-20</ref>; <ref loc="LUK 9:18-31">लूका 9:18-31</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />ईशु आरू ओका चेला कैसरिया फिलिप्पी क आस पास गाव मा चाली गया। मार्ग मा त्यो आपने चेला छे पुछा, “मानसे मखे काय कये छे कि हाव कुन छे?”<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:28 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 6:14">मरकुस 6:14</ref>,<ref loc="MRK 6:15">15</ref>; <ref loc="LUK 9:7">लूका 9:7</ref>,<ref loc="LUK 9:8">8</ref></char>
    </note>त्या दियो, “यहुन्ना बपतिस्मा देनेवावा काही–काही एलियाह आरू काही–काही भविष्यवक्ता मा छे एक भी कये छे”<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:29 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 6:68">यहुन्ना 6:68</ref>,<ref loc="JHN 6:69">69</ref></char>
    </note>त्यो उनछे पुछा, “पुन तुमू मखे काय कये होय?”</para>
  <para style="p" vid="MRK 8:29">त्यो ओकाक पुछियो, “पुन तु मखे काय कयतु छे?” पतरस ने उका जवाब दिया, “तु मसीह छे”<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />तव त्यो तीनुक चितावीन कयो कि मारे विषय मा यो काही छे नी कयनो।<verse eid="MRK 8:30" /></para>
  <para style="s">आपसी मृत्यु क विषय की भविष्यव्दाणी</para>
  <para style="r">(<ref loc="MAT 16:21-28">मत्ती 16:21-28</ref>; <ref loc="LUK 9:22-27">लूका 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />तव ईशु तीनुक सिकाड़ने लाग्या कि मानुस क पोर्‍या मतलब मखे करता पाको छे कि वो घोणा दुःख हाकलिया, आरू सब डाहला पुजारा, आरू शास्त्री उको तुच्छ समझकर मार नाखे, आरू वो तीन दाहड़ा क बाद मर्‍या हुया मा छे जीवन उठ्यो छे। <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />त्यो यी वात त्यो सच–सच कय दीया। इन पर पतरस उको अलग ले जाईन दटावु लाग्या। <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />पुन त्यो पुगीन आपसा चेला क देख्या, आरू पतरस क लड़िया आरू कयो “हे शैतान मारे सामने छे दुर होय; काहकि तु यहोवा–भगवान की वात पर नी, पुन मानुस की वात पर मन लागाड़ छे!”<verse eid="MRK 8:33" /></para>
  <para style="s">ईशु क पछव चालने क मतलब</para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:34 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:38">मत्ती 10:38</ref>; <ref loc="LUK 14:27">लूका 14:27</ref></char>
    </note>ईशु ने गर्दी क आपने चेला सहावत साथे बुलावीन ओका सी कयो, “जो काही मारे पछव आवने जुवे, वो आपने आप छे मना करो आरू आपसो कुरूस हुचलीन मारे पछव होय ले। <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" /><note caller="+" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="MAT 10:39">मत्ती 10:39</ref>; <ref loc="LUK 17:33">लूका 17:33</ref>; <ref loc="JHN 12:25">यहुन्ना 12:25</ref></char></note>काहकि जो कुई आपसो जीव वाचावने जुवे चो उको खुवसे, पर जो कुई मखे आरू खुश खबर क करता आपसो जीव क खुवसे, वो उको वाचाड़से। <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />यदि मानुस जगमा क हासिल करे आरू आपने जीव क हानी झेलसे, तो उको काय लाभ होयछे? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />मानुस आपसा जीव क बदले काय आपसे? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />जो काही इन व्यभिचार आरू पापी जाति मखे छे आरू मारी वात छे लाजवाय, ते मानुस क पोर्‍या मतलब मखे भी जव वो सोरगदूत क साथे ओका बास क महिमा क साथे आवसे, तव उना छे भी लाजवायछे”<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />ईशु उनछे कयो, “हाव तुमूछे सच कयता छे कि जो याहा उबा छे, ओका छे काही–काही ओसो छे, कि जव तक यहोवा–भगवान क राज्य क शक्ति सहीत आश हुया नी देख लेय, तव तक मृत्यु क हवाद कदी नी चाखसे”<verse eid="MRK 9:1" /></para>
  <para style="s">ईशु क रूपान्तर</para>
  <para style="r">(<ref loc="MAT 17:1-13">मत्ती 17:1-13</ref>; <ref loc="LUK 9:28-36">लूका 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />छव: दाहडु कि अळतेन ईशु पतरस आरू याकूब आरू यहुन्ना क साथे लेदा, आरू सुनला मा काही उचा बयड़ा पर ली गया। वाँ ओको सामने ओका रूप बदल गया, <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />आरू ओका छिंदरा ओसो चमकने लाग्या आरू याहा तक धव्य हुया, कि धरती पर काही धोबी भी वोसो धव्य नी कर सकता। <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />आरू तीनुक मूसा क साथे एलियाह देखाय दिया; वो ईशु क साथे वात करता हुते। <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />इन पर पतरस ने ईशु छे कयो, “हे गुरू, हामरे याहा रयने वारू छे: अतरान करीन हामु तीन मण्डप बनाड़े; एक तारे करता एक मूसा क करता, आरू एलियाह क करता।” <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />काहकि पतरस यो नी जानता हुता की काय जवाब देय, अतरान करीन की वो खुप घाबराय गया हुते।<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />तव एक बादल ने तीनुक छा लेदा, आरू उना बादल मा छे यो ओवाज निकव्य, “यो मारा मोंगावु पोर्‍या छे, हेकी सुनो।” <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />तव त्या एकदम चार आरू दूष्टि की, आरू ईशु यहोवा–भगवान क छुड़ीन आपने साथे आरू काही क नी देख्या।<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />बयड़ा छे उतरला टेहाव त्यो तीनुक हुकुम दी की जव तक मानुस क पोर्‍या मतलब मखे मरना बाद पछो जीवतो होय नी तव काय तुमू ने देख्या छे वाँ काय छे नी कयनो।<verse eid="MRK 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10" />त्यो ओकी वात क मान्य; आरू आपस मा वाद विवाद करने लाग्या, “मर्‍यो हुयो मा छे जीवन उठने क काय मतलब छे।” <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" /><note caller="+" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="MAT 11:14">मत्ती 11:14</ref></char></note>आरू त्या ओको पुछा, “शास्त्री काय कये छे कि एलियाह क पेहले आवने पाको छे?”<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />त्यो तीनुक जवाब दीया, “एलियाह सचमुच पेहले आवीन सब काय सधारछे, पुन मानुस क पोर्‍या मतलब मखे क विषय यो काय लिख्या छे कि वो घोणा दुख झेलसे, आरू तुच्छ नकार जाछे? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />पुन मा तुमू छे कयता छे, कि एलियाह तो आय चुक्यो छे, आरू जोसो ओको शास्त्र मा लिख्या हुता, त्या जो काय जुवे ओको साथे कर्‍यो”<verse eid="MRK 9:13" /></para>
  <para style="s">दृष्टात्माग्रस्त पोर्‍या क वारू करने</para>
  <para style="r">(<ref loc="MAT 17:14-21">मत्ती 17:14-21</ref>; <ref loc="LUK 9:37-43">लूका 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />जव ईशु चेला क साथे आश, ती देख्या कि ओको चार आरू मोटी गर्दी लागी छे आरू शास्त्री ओको विवाद कर रया छे। <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />ओको देखता ही सुब घण घबरायीन करने लाग्या, आरू ओकी आरू दोवड़ीन ओको नमस्कार कर्‍यो। <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />त्यो उनछे पुछा, “तुमू इन छे काय विवाद कर रयो होय?”<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />गर्दी मा छे एक ने ओको जवाब दिया, “हे गुरू, हाव आपने पोर्‍या क, जिनाम विटळ आत्मा छे वो ओको बुलने नी देती अतरान करीन तारे साथे लावने हुतो। <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />वा कयी वो ओको धरायती छे, चो पटक देती छे: आरू वो मुय मा फेसटु भरीन लाता, आरू दात पीसता, आरू सूखता जाता छे। हाव ने तारा चेला छे कयो कि वो निकवीन दे, पुन वो निकवीन नी सके”<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />यो सोमवीन त्यो उनछे जवाब दिन कयो, “हे विनभुरसीया मानछे, हाव किही तक तुमरे साथे रयीस? आरू किही तक तुमरी रयीस? हाव किही तक तुमरे सहन करीस? ओको मारे साथे लावु!”<verse eid="MRK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 9:20" />तव वो ओको ओका साथे ली आश: आरू जव त्यो ओको देख्या, तो उनी विटळ आत्मा ने तत्काल उको मरोड़ा; आरू वो धरती पर पड्यो, आरू मुय छे फेसटु बयाते हुये धरतीपर घसड़ने लाग्या।<verse eid="MRK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21" />ईशु ओको बाबो छे कहा, इसकी यो दशा किही छे। त्यो कयो, “बचपन छे। <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />दृष्ट आत्मा इनाक नष्ट करने क करता कदी आगठा आरू कदी पानी मा पाड़्या; पुन यदि तु काही कर सक्य, ती हामु पर तरस खाईन हामरी मदत कर!”<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />ईशु ने ओका सी कयो, “यदि तु काय कर सकता छे? यो काय वात छे! विश्वास करने वावा क करता सुब काही होय सकता छे”<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />पोर्‍या क बास ने तत्काल रड़ीरड़ीन कयो, “हे पोरबु हाव विश्वास करता छे, मार विनभुरसा क वदाड़ने बढावने क मदत कर!”<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />“जव ईशु ने देख्या कि मानसे दोड़ीन गर्दी लागी रये छे कयो, ती उनी विटळ आत्मा क तुखे हुकुम दम छे, ओका मा सी छे निकवीन आय, आरू उको पुगनेन कदी भरायने नी करने!”<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />तव वो आयड़ीन आरू उको घोणा मरोड़ कर निकळी आवी; पोर्‍या मर्‍यो हुतो ओसो हुय गयो, याहा तक की घोणा मानसे कयनो लाग्या कि वो मरी गयो। <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />पुन ईशु ने ओको हात धरीन उको उठाड़ियो, आरू वो उबो होय गया।<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />जव वो घर मा आयो, ती ओका चेला ने सुनला मा उको पूछा, “हामु ओको दृष्ट आत्मा क बाहरता काय नी निकाव सक्य?”<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />ईशु उनछे कयो, “यो जाति बिना प्रार्थना काही आरू उपाय छे नी निकवीन सकती”<verse eid="MRK 9:29" /></para>
  <para style="s">आपसी मृत्यु क विषय ईशु की पुन: भविष्यव्दाणी</para>
  <para style="r">(<ref loc="MAT 17:22-23">मत्ती 17:22-23</ref>; <ref loc="LUK 9:43-45">लूका 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />पछु ईशु वाँ छे चाल्या, आरू गलील मा हईन जाय रया हुता। वो नी जुवे हुता कि काही जाने, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />काहकि ईशु आपने चेला क शिक्षा दिदा आरू उनछे कयता हुता, “मानुस क पोर्‍या मतलब मखे मानुस क हात मा धराया जाछे, आरू वो उको मार नाखने; आरू वो मरना क तीन दाहड़ा बाद जीवन उठसे”<verse eid="MRK 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32" />पर यो वात उन क समझ मा नी आवी, आरू वो ईशु क पुछने से घाबराया हुता।<verse eid="MRK 9:32" /></para>
  <para style="s">आखान मोटु कुन?</para>
  <para style="r">(<ref loc="MAT 18:1-5">मत्ती 18:1-5</ref>; <ref loc="LUK 9:46-48">लूका 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />पछु ईशु कफरनहूम मा आश; आरू घर मा आवीन ईशु ओखे पुछा, “वाट मा तुमू काय वात पर विवाद कर रया हुते?”<verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />वो चुप रया, काहकि मार्गा मा त्या आपस मा यो वाद–विवाद कर्‍यो हुता कि हामु मा छे मोठु कुन छे। <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" /><note caller="+" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 20:26">मत्ती 20:26</ref>,<ref loc="MAT 20:27">27</ref>; <ref loc="MAT 23:11">23:11</ref>; <ref loc="MRK 10:43">मरकुस 10:43</ref>,<ref loc="MRK 10:44">44</ref>; <ref loc="LUK 22:26">लूका 22:26</ref></char></note>तव त्यो बठीन बारा चेला क बुलायो आरू ओका कयो, “यदि काही मोठ हुयने जुवे, ती सुब छे नानो आरू सब सेवक बने।” <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />आरू त्यो एक पोर्‍या क लीन ओको वीच मा उबो कर्‍यो, आरू उको खुवाम मा लीन उनछे कयो, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />“जु कुई मार नाव छे ओसो पोर्‍या मा छे काही एक क भी मान्य करता छे, चु मखे मान्य करता छे; आरू जु कुई मखे मान्य करता, वो मखे नी, वरना मखे मुकलने वावा क मान्य करतो छे”<verse eid="MRK 9:37" /></para>
  <para style="s">जो विरोध मा नी, वो पक्ष मा</para>
  <para style="r">(<ref loc="LUK 9:49-50">लूका 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />तव यहुन्ना ने ईशु छे कयो, “हे गुरू हामु ने एक मानुस क तारे नाव छे साहळा क निकावता देख्या आरू हामु उको मना करने लाग्या, काहकि वो हामु हाव छे काही नी हुता”<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />ईशु कयो, “उना क मा मना करू; काहकि ओसो काय नी जो नाव शक्ति काम करे, आरू तत्काल मखे वात कय सक्य, <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" /><note caller="+" style="x"><char style="xo" closed="false">9:40 </char><char style="xt" closed="false"><ref loc="MAT 12:30">मत्ती 12:30</ref>; <ref loc="LUK 11:23">लूका 11:23</ref></char></note>काहकि जो हामरे विरोध मा नी, वो हामरी तरफ छे। <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />जु कुई एक वाटको पानी तुमूक एरकरीन पावने कि तु मसीह क होय ती हाव तुमू छे सच कयता छे कि वो आपसो हर फोव काही रीति छे नी खुवसे।”<verse eid="MRK 9:41" /></para>
  <para style="s">ठुकर क कारण बनने वावा क इसारो</para>
  <para style="r">(<ref loc="MAT 18:6-9">मत्ती 18:6-9</ref>; <ref loc="LUK 17:1-2">लूका 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />“जो काही इन नानो मा छे जो मखे पर विश्वास करता छे, काही क ठुकर खावड़ाने ती ओको करता वारू यो छे कि मोटी चक्‍की क पाट ओका गवाम बांधीन जाय आरू वो दरिया मा नाख दिया जाय।” <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" /><note caller="+" style="x"><char style="xo" closed="false">9:43 </char><char style="xt" closed="false"><ref loc="MAT 5:30">मत्ती 5:30</ref></char></note>यदि तारे हात तुखे ठुकर खावड़ाने तो उको काटने नाखने। टुण्डा हईन जीवन मा भरायने करने तारे करता इनासे वारू छे कि दुई हात रयते हुये नरक कि आगठा मा नाखने जाने जो कदी बुझने की नी। <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />वा किड़ा नी मरता आरू आगठी नी बुझती। <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />यदि तारा पाय तुखे ठुकर खावड़ाया ती उको काटने नाखने। भागड़ा हुयने जीवन मा भरायने करने तारे करता इनासे भला छे कि दुई पाय रयते हुयो नरक मा नाखने जाने। <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />वा ओको कीड़ा नी मरता आरू आगठी नी उलायती। <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />यदि तेरी डुळा तुझे ठोकर खवाड़े तो उको निकाल डाल। काना होकर यहोवा–भगवान क राज्य भरायने करनो तेरे करता इनासे भला है कि दो डुळा रहते हुए तु नरक हाव डाला जाए। <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />वा ओको किड़ा नी मरता आरू आगठी नी उलायती।<verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />काहकि हर एक जन आगठी सी नमकीन कर्‍यो जाछे।<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:50 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:13">मत्ती 5:13</ref>; <ref loc="LUK 14:34">लूका 14:34</ref>,<ref loc="LUK 14:35">35</ref></char>
    </note>“नमक वारू छे, पर यदि नमक क हवाद जात रयो, ती उको काय छे नमकीन करसे? आपने मा नमक राख्या, आरू आपस मा मेलमिलाप वारूस छे रयो।”<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">तलाक क विषय ईशु की शिक्षा</para>
  <para style="r">(<ref loc="MAT 19:1-12">मत्ती 19:1-12</ref>; <ref loc="LUK 16:18">लूका 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />पछु ईशु वाँ छे उठीन यहूदिया कि सीमा मा आरू यरदन नदी क पार आश। गर्दी ओका साथे पछु एखटी होय गया, आरू वो आपसी रीति क लारे तीनुक पछु सिकाड़ने लाग्यो।<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />तव फरीसि ने ओको साथे आवीन ओकी परीक्षा करने क ओको पुछ, “काय यो वारू छे कि मानुस आपसी बायर क छुड़ने?”<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />त्यो ओको जवाब दिया, “मूसा ने हुकुम काय नियम दिदो छे?”<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:4 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:31">मत्ती 5:31</ref>
      </char>
    </note>त्या कयो, “मूसा ने त्याग पत्री लिखने आरू त्यागने की हुकुम देदी छे”<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />ईशु ने उनछे कयो, “तुमरे मन की वातड़ो हुयने क कारण उनछे तुमरे करता यो हुकुम लिखी। <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />पर सूष्टि क शुरू छे यहोवा–भगवान ने नर आरू नारी करीन तीनुक बनाड़े छे। <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />इनीये कारण मानुस आपसा माय बास छे अलग हुयने आपसी बायर क साथे रयछे, <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />आरू वो दुयु डील एकुत होयछे; एरकरीन वो हिमी दुई निही पर एकुत छे। <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />अतरानकरीन जिनाक यहोवा–भगवान ने जुड़ा छे उको मानुस अलग नी करने”<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />घर मा चेला ने ओका विषय मा ओको पछु पुछा। <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" /><note caller="+" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="MAT 5:32">मत्ती 5:32</ref>; <ref loc="1CO 7:10">1 कुरन्थियो 7:10</ref>,<ref loc="1CO 7:11">11</ref></char></note>त्यो उनछे कयो, “जो काही आपसी बायर क त्यागकर दीसरी छे वियाव करे तो वो उना पेहली क विरोध मा व्यभिचार करता छे; <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />आरू यदि बायर आपने घरवाळा क छुड़ीन दिसरा छे वियाव करे तो वो व्यभिचार करती छे”<verse eid="MRK 10:12" /></para>
  <para style="s">ईशु नानलो पोर्‍या क सय बरकत कर्‍यो</para>
  <para style="r">(<ref loc="MAT 19:13">मत्ती 19:13</ref>; <ref loc="LUK 18:15-17">लूका 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />पछु मानसे पोर्‍या क ईशु क साथे लावने लाग्या की वो उन पर हात राखने, पर चेला ने तीनुक लड़िया। <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />ईशु ने यो देखीन रीस हईन उनछे कयो, “पोर्‍या क मारे साथे आवने दो आरू तीनुक मना नी करो, काहकि यहोवा–भगवान क राज्य ओसो ही क छे। <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" /><note caller="+" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 18:3">मत्ती 18:3</ref></char></note>हाव तुमू छे सच कयता छे की जो काही यहोवा–भगवान क राज्य क पोर्‍या क समान मान्य नी करे, वो उको कदी भरायने करने नी देख सके।” <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />आरू त्यो तीनुक खुवाम मा लेदो, आरू ओको मुनका पर हात राखीन तीनुक सय बरकत देद।<verse eid="MRK 10:16" /></para>
  <para style="s">धनवान मानुस आरू अमरकाय जीवन छे</para>
  <para style="r">(<ref loc="MAT 19:16-30">मत्ती 19:16-30</ref>; <ref loc="LUK 18:18-30">लूका 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />जव ईशु वाँ छे निकवीन मार्गा मा जा रया हुता, ती एक मानुस ओका साथे दोवड़ता हुया आश, आरू ओका ओगव घुटना टेकीन उको पुछा, “हे वारला गुरू, अमरकाय जीवन क हक हुयने क करता हाव काय करीस?”<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />ईशु ने उनछे कयो, “तु मखे वारला काय कयता छे? काही खरो नी, केवल एक मतलब यहोवा–भगवान। <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />तु हुकुम क ती जानता छे: ‘हत्या नी करने, व्यभिचार नी करने चुरी नी करने, झुठी गवा नी देने, छल नी करने, आपने बास आरू आपसी माय क विजुत करने’”<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />त्यो उनछे कयो, “हे गुरू, इन सबको हाव लड़कपन छे मानता आयु छे”<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />ईशु ने उना नजर करीन ओका सी मोंग कर्‍यो, आरू ओको कयो, “तुखे हाव एक वात कि घटी छे। जा, जो काय तारे छे उको वेचीन गरीब क दे, आरू तुखे सोरग मा धन हाववछे, आरू आवीन मारे पछव होय लेय” <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />इन वात छे ओका जुवान क चेहरो उदास होय गयो आरू वो शोक करता हुया जात रयो, काहकि वो घोणा धनवान हुता।<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />ईशु ने चार आरू देखीन आपसा चेला छे कयो, “धनवान क यहोवा–भगवान क राज्य मा भरायने करनो कोतरो वातड़ो छे!”<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />चेला ओकी वात छे घबराय हुया। अतरा पर ईशु ने पछु उनछे कयो, “हे पोर्‍या, जो धन पर भरोसा राखते छे, ओको करता यहोवा–भगवान क राज्य मा भरायने करने कोसो वातड़ो छे! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />यहोवा–भगवान क राज्य मा धनवान भरायने करने छे उटड़ान क सुवी क गाळा मा छे निकाव जाने सहज छे” <figure style="fig" alt="Merchant leading a camel outside a city wall and gate" file="hk00041c।tif" size="col" copy="Horace Knowles ©" ref="10:25">शहरन भितड़ा आरू बाहरते बेपारी उटळा क अगुवाई कर रयु छे</figure><verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />चेला घोणा ही चकित हईन आपस मा कयनो लाग्या, “ती पछु कायका उध्दार होय सकता छे?”<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />ईशु उनकी आरू देखीन कयो, “यो मानुस क करता काटो सकता, पुन यहोवा–भगवान छे होय सकता छे; काहकि यहोवा–भगवान छे सब काही होय सकता छे”<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />पतरस ईशु क कयनो लाग्या, “देख, हामु तो सब काही छुड़ीन तारे पछव होय करता छे”<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />ईशु ने कयो, “हाव तुमू छे सच कयता छे कि ओसो काही नी, जो मारे कारण आरू खुश खबर क कारण करता घर आव भाई आव बहिनीस आव माय आव बास आव झोठा पोर्‍या खेत क छुड़ीन दीया होय, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />आरू हिमी इन टेहाव सौ गुणा नी जुड़े, घर आरू भाई आरू बहिनीस आरू माय आरू झोठा पोर्‍या आरू खेतमा क, पर सताव क साथे आरू आवने वावा जगमा अमरकाय जीवन देखछे। <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" /><note caller="+" style="x"><char style="xo" closed="false">10:31 </char><char style="xt" closed="false"><ref loc="MAT 20:16">मत्ती 20:16</ref>; <ref loc="LUK 13:30">लूका 13:30</ref></char></note>पर खुप छे जो पेहले छे, पछव होयछे; आरू जो पेहले होयछे”<verse eid="MRK 10:31" /></para>
  <para style="s">आपसी मृत्यु क विषय ईशु की तीसरी भविष्यव्दाणी</para>
  <para style="r">(<ref loc="MAT 20:17-19">मत्ती 20:17-19</ref>; <ref loc="LUK 18:31-34">लूका 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />ईशु आरू ओका चेला यरूशलेम क जाते हुय मार्ग मा हुत, आरू ईशु उन क ओगव जाय रयो हुता: चेला घबराय हुते आरू जो ओका पछव चालता हुते वो घाबराय हुये हुते। तव वो पछु उन बारा क लीन उनछे वो वात कयनो लाग्यो, जो उना पर आवनेवावी हुती, <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />देख, हामु यरूशलेम क जाते छे, आरू मानुस क पोर्‍या मतलब मखे डाहला पुजारा आरू शास्त्री क हात धराया जाछे, आरू वो ओको घात क योग्य ठरावछे, आरू गैरयहुदी क हात मा सौप देसे। <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />“वो ओको ठठ्ठा मा उड़ावसे उना पर थुपछे, उना कोड़े मारछे आरू उको घात करसे, आरू तीन दाहाड़ा क बाद वो जीवीन उठसे”<verse eid="MRK 10:34" /></para>
  <para style="s">याकूब आरू यहुन्ना क रावन्या</para>
  <para style="r">(<ref loc="MAT 20:20-28">मत्ती 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />तव जबदी क पोर्‍या याकूब आरू यहुन्ना ईशु क साथे आवीन कयो, “हे गुरू हामु जुवता छे की जो काही हामु तुखे मांगने, वो तु हामरे करता कर्‍यो”<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />ईशु ओका सी कयो, “तुमू काय जुवता होय की हाव तुमरे करता करीस?”<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />त्या ओको कयो, “हामु यो दे कि तारी महिमा मा हामु मा छे एक तारी जेवड़े आरू दिसरा तारे बाई बठ्या”<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:38 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:50">लूका 12:50</ref>
      </char>
    </note>ईशु ने ओक कयो, “तुमू नी जानछे की काय मांगता होय? जो वाटका मा पानी पर छे, काय तुमू पीय सकता हुता? आरू जो बपतिस्मा मा लेने पर छे, काय तुमू लेय सकता होय?”<verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />त्या उनछे कयो, “हामु छे होय सकता छे”</para>
  <para style="p" vid="MRK 10:39">ईशु ने उनछे कयो, “जो वाटको मा पानी पर छे तुमू पीनो छे; आरू जो बपतिस्मा मा लेने पर छे, उको मानछे। <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />पर जिनके करता तीयार कर्‍या गया छे, तिनुक छुड़ीन आरू काही क आपने जेवड़े आरू आपने बाई बठाडने मारो काम नी”<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />यो सोमवीन दस याकूब आरू यहुन्ना पर रिसियाने लाग्या। <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" /><note caller="+" style="x"><char style="xo" closed="false">10:42 </char><char style="xt" closed="false"><ref loc="LUK 22:25">लूका 22:25</ref>,<ref loc="LUK 22:26">26</ref></char></note>ती ईशु ने उनको साथे बुलावीन उनछे कयो, “तुमू जानछे होय की जो गैरयहुदी क सरदार समझे जाय छे, वो उन पर पोरबुता करता छे; आरू उनमा जो मोठ छे, ओका पर हक जताते छे। <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />पर तुमू मा ओसो नी छे वरना जो काही तुमू मा मोठ हुयने जुवे वो तुमरा सेवक बनछे; <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />आरू जो काही तुमू मा प्रधान हुयने चाहतु से चो सब क दास बनछे। <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />काहकि मानुस क पोर्‍या मतलब मखे इनीये करता नी आश की ओकी सेवा टहल की जाय, पर अतरान करीन आश की सेवा टहल करे, आरू घोणा क छुटकारा क करता आपसो जीव आपे”<verse eid="MRK 10:45" /></para>
  <para style="s">आंधवा बरतिमाई क द्रूष्टिदान</para>
  <para style="r">(<ref loc="MAT 20:29-34">मत्ती 20:29-34</ref>; <ref loc="LUK 18:35-43">लूका 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />ईशु यरीहो नगर मा आय, आरू जव वो आरू ओका चेला, आरू एक मोटी गर्दी यरीहो छे निकवती हुती, तव तिमाई क पोर्‍या बरतिमाई, दूय आंधवा भिखारी, सड़क क धोड़े बठ्या हुतो। <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />वो यो सोमवीन की ईशु नासरत छे, आयड़ी कयनो लाग्या, “हे दाऊद की अवलियाद, ईशु हामरे पर दया कर”<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />घोणा ने उको लड़िया की चुप रये, पर वो आरू भी आयड़ने लाग्यो, “हे दाऊद की अवलियाद हामरे पर दया कर”<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />तव ईशु ने ठहरकर कयो, “उको बुलाया”</para>
  <para style="p" vid="MRK 10:49">आरू मानसे ने उना आंधवा क बुलावीन ओको कयो, “ढाढ़स बांध! उठ वो तुखे बुलाता छे”<verse eid="MRK 10:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50" />वो आपसा छिंदरा नाखी शीघ्र उठ्यो, आरू ईशु क साथे आयो।<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />इन पर ईशु ने ओको कयो, “तु काय जुवे छे की हाव तारे करता करीस?”</para>
  <para style="p" vid="MRK 10:51">आंधवा ने ओको कयो, “हे रब्बी, यो की हाव देखने लीस”<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />ईशु ने ओको कयो, “चालीन जा, तारे विश्वास ने तुखे वारू कर दिया छे”</para>
  <para style="p" vid="MRK 10:52">वो तत्काल देखने लाग्यो, आरू मार्गा मा ओको पछव चाल देदो।<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">यरूशलेम मा विजय क भरायनो</para>
  <para style="r">(<ref loc="MAT 21:1-11">मत्ती 21:1-11</ref>; <ref loc="LUK 19:28-40">लूका 19:28-40</ref>; <ref loc="JHN 12:12-19">यहुन्ना 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />जव वो यरूशलेम क निकट, जैतुन बयड़ा पर बैतफगे आरू बैतनिया क साथे आय तो ईशु ने आपसा चेला मा छे दुई क यो कयकर मुकल्या, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />सामने क गाव मा जावु, आरू उना मा पुगेती ही एक गदड़ा क पीलो, जिना पर कदी काही नी बठ्य, बांधाय हुयो तुमू मीवछे। उको छुड़ लावु। <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />यदि तुमू छे काही पुछ, “यो काय करता होय? ती कयनो, पोरबु क इनीये क योजना छे, आरू वो शीघ्र उको याहा मुकली देसे।”<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />त्या जाईन उना पीलो क बाहरता झोपला क साथे चौक मा बांधिया हुया देख्या, आरू छुड़ने लाग्या। <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />ओका छे जो वाँ उबो हुता काही–काही कयनो लाग्या, “यो काय करता होय, गदड़ी क पीलो क काय छुड़ने होय?”<verse eid="MRK 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6" />जोसो ईशु कयो हुता, वोसो ही त्या ओको कय; तव मानसे ने तीनुक जाने दीया। <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />त्या पीलो क ईशु क साथे लावीन उना वो उना पर छिंदरा नाखीन आरू वो ओको पर बस गयो। <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />तव घोणा ने आपसा छिंदरा मार्गा मा आथरिया दिसरा खेत मा सी डावखा काटी–काटी कर आथरी दीया। <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />ओका ओगव–ओगव जाते आरू पछव चाल्या आवता हुता, आयड़ीन–आयड़ीन कर कये जाते हुते, “यहोवा–भगवान की महिमा होय धन्य छे वो जो पोरबु क नाव छे आवता छे! <verse eid="MRK 11:9" /><verse number="10" style="v" sid="MRK 11:10" />हामरे बास दाऊद क राज्य जो आय रया छे; धन्य छे! आकाश मा महिमा होय!”<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />वो यरूशलेम पुगीन मंदिर मा आयो, आरू चार आरू सब समान क देखीन बारा क साथे बैतनिया गया, काहकि शांत होय गयो हुती।<verse eid="MRK 11:11" /></para>
  <para style="s">ईशु गुलर क झाड़को क साप दिदो</para>
  <para style="r">(<ref loc="MAT 21:18-19">मत्ती 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />दीसर दाहड़ा जव वो बैतनिया छे निकवीन तो ईशु क भुख लागी। <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />वो दुर छे अंजीर क झाड़को क किनारो देखीन त्यो उका पास मा गियो कि काय जाने उको काही देख्या: पर पान्टा क छुड़ीन काही नी देख्या; काहकि फव क टेहाव नी हुता।<verse eid="MRK 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 11:14" />इन पर त्यो ओको कयो, “हिमी छे काही तारे फव कदी नी खाय!” आरू ओका चेला सोमवीन रया हुता।<verse eid="MRK 11:14" /></para>
  <para style="s">मंदिर छे व्यापारी क निकावने जाने</para>
  <para style="r">(<ref loc="MAT 21:12-17">मत्ती 21:12-17</ref>; <ref loc="LUK 19:45-48">लूका 19:45-48</ref>; <ref loc="JHN 2:13-22">यहुन्ना 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />पछु ईशु यरूशलेम मा आय, आरू वो मंदिर मा गया; आरू वाँ जो लेन–देन कर रया हुता तीनुक खयड़े निकवीन लाग्या, आरू सराफों क पीढ़े आरू पेरवा वेचने वावा की चौकियां उलटाय देदी, <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />आरू मंदिर मा छे काही क ठाहरा लीन आवने जाने नी दीया। <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />आरू खबर करीन उनछे कयो, “काय यो नी लिख्या छे कि मार घर सुब जाती क करता प्रार्थना क घर कवायसे? पर तुमू ने इने डाकु की खुय बनाय दी छे”<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />यो सोमवीन डाहला पुजारा आरू शास्त्री ओका नाश करने क मेखे हेरने लाग्या; काहकि वो ओका सी घाबराय हुते।<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />शांत होयते ही वो नगर छे खयड़े चालीन गया।<verse eid="MRK 11:19" /></para>
  <para style="s">सुकलो गुलर क झाड़को छे शिक्षा</para>
  <para style="r">(<ref loc="MAT 21:20-22">मत्ती 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />पछु भोर क जव वो उधर छे जाते हुते तो त्या उना गुलर क झाड़का क मुवे तक सूखा हुया देख्या। <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />पतरस क वो वात याद आवी, आरू त्यो ओको कयो, “हे गुरू, देख! यो अंजीर क झाड़को जिनाक तु स्राप देदो हुतो, सुख गया छे!”<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />ईशु ने ओको जवाब दीया, “यहोवा–भगवान पर विश्वास राख। <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />हाव तुमू छे सच कयता छे कि जो काही इन बयड़ा छे कये तु उखड़ जा आरू दरिया मा जाय पड़, आरू थार मन मा संका नी करे वरना भुरसो करे कि जो कयता छे वो होय जाछे, तो ओका करता चो होयछे। <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />एरकरीन हाव तुमू छे कयता छे की जो काही तुमू प्रार्थना करीन मांगू, ती भुरसो कर ले कि तुमू मीवछे गया, आरू तुमरे करता होय जाछे। <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" /><note caller="+" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="MAT 6:14">मत्ती 6:14</ref>,<ref loc="MAT 6:15">15</ref></char></note>आरू जव कदी तुमू उबो हुया प्रार्थना करता होय तो यदि तुमरा मन मा काही क हर काय विरोध होय, तो गुणा क माफ करू: <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />आरू यदि तुमू समा नी करो ती तुमरा बास भी जो सोरग मा छे, तुमरा गुणा क माफ नी करसे”<verse eid="MRK 11:26" /></para>
  <para style="s">ईशु क हक पर सवाल</para>
  <para style="r">(<ref loc="MAT 21:23-27">मत्ती 21:23-27</ref>; <ref loc="LUK 20:1-8">लूका 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />वो पछु यरूशलेम मा आयो, आरू जव ईशु मंदिर मा टहल रया हुता ती डाहला पुजारा आरू शास्त्री आरू प्राचीन ओको साथे आवीन पुछने लाग्या, <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />“तु यो काम काय हक छे करता छे? आरू यो हक तुखे काय ने दिया छे कि तु यो काम करे?”<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />ईशु ने ओको कयो, “हाव भी तुमू एक वात पूछता छे; मखे जवाब दो तो तुमू कयो की यो काम काय हक छे करता छे। <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />यहुन्ना क बपतिस्मा काय सोरग की तरफ छे हुतो या मानुस की तरफ छे हुता। मखे जवाब दे”<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />तव वो आपस मा विवाद करने लाग्या क “यदि हामु कये सोरग कि तरफ छे, तो वो कयसे, ‘पछु तुमू ओकी भुरसो काह नी कर्‍या?’ <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />आरू यदि हामु कये, मानुस की आरू छे, तो मानसे क घाबराय छे, काहकि सब जानता छे कि यहुन्ना सचसच भविष्यवक्ता हुता।”<verse eid="MRK 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 11:33" />शेवली कावा तीनुक ईशु क जवाब देदो, “हामु नी जानता।” ईशु ने उनछे कयो, “हाव भी तुमू क नी कयो की यो काम हाव काय हक छे करता छे”<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">दुष्ट किरसान क सपनो</para>
  <para style="r">(<ref loc="MAT 21:33-46">मत्ती 21:33-46</ref>; <ref loc="LUK 20:9-19">लूका 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />पछु ईशु सपनो मा ओका सी वात करने लागी: “काही मानुस ने अंगुर क वाड़ी लागाड़, आरू ओको चार आरू वाड़ बांधिया, आरू रास क कुण्डा खुद्या, आरू गुम्मट बनाड़े; आरू किरसान क ओको ठेका देकर परदेश चाली गया।” <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />पछु फव क टेम आयो त्यो किरसान क साथे एक चाकरीयो क मुकल्यो, कि किरसान छे अंगुर क वाड़ी क फव क भाग ले। <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />पर त्या ओको धरीन कुट्या आरू खाली हात फिर दीया। <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />पछु त्यो एक आरू चाकरीयो क ओको साथे मुकल्या; त्या ओका मुनका फुड़ देदो आरू ओकी विजुत नी कर्‍यो। <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />पछु मालकने एक आरू क मुकल्या; त्या उको मार नाख्या। तव त्यो आरू खुप क मुकल्या; उको छे त्या काही कुट्या, आरू काही क मार नाख्या। <verse eid="MRK 12:5" /><verse number="6" style="v" sid="MRK 12:6" />हिमी एक ही रया गया हुता, जो ओका मोंगावु पोर्‍या हुता; आखरी मा त्यो उको भी ओको साथे यो सुचीन मुकल्या कि वो मारा पोर्‍या क विजुत करसे। <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" />पर उन किरसान ने आपस मा कयो, “यो तो वारीस छे; आवु, हामु उको मार नाखने, तव मीरास हामरी होय जाछे।” <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />आरू तीनुक ओको धरीन मार दिया, आरू अंगुर न वाड़ी सी बाहर निकालीन मार न्हाखिया।<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />एरकरीन अंगुर क वाड़ी क भगवान काय करसे?<verse eid="MRK 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 12:10" />काय तुमू ने चुखलो शास्त्र मा यो वचन नी भोन्या।</para>
  <para style="p" vid="MRK 12:10">जिना दगड़ा क राजमिस्त्री ने निकम्मा ठहराया हुता, चो कुपरा क सिरा होय गया।<verse eid="MRK 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 12:11" />“यो पोरबु कि आरू छे हुया आरू हामरी दूष्टि मा घण मोटो छे!”<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />तव त्या शास्त्री आरू मुखी पुजारा ईशु क धरने चाह्या; काहकि समझी गया हुत की त्यो हामरे विरोध मा यो सपनो कयो छे। पर वो मानसे छे घाबराय, आरू उको छुड़ीन जात रयो।<verse eid="MRK 12:12" /></para>
  <para style="s">कैसर क कर देने</para>
  <para style="r">(<ref loc="MAT 22:15-22">मत्ती 22:15-22</ref>; <ref loc="LUK 20:20-26">लूका 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />तव त्या ईशु क वात मा फंसाने क करता काही फरीसियो आरू हेरोदियो क ओको साथे मुकल्या। <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />त्या आविन ओको कयो, “हे गुरू हामु जानता छे, कि तु सच छे, आरू काही की परवाह नी करता; काहकि तु मानुस क मुय देखीन वात नी करता, पुन यहोवा–भगवान क मार्ग सच छे देखाड़ छे। ती काय कैसर क कर देने वारू छे यो नी?”<verse eid="MRK 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15" />“हामु दे, यो नी दे?” त्यो ओको कपट जानीन उनछे कयो, “मखे काय पारखते होय? एक दीनार मारे साथे लावु कि हाव ओको देखा”<verse eid="MRK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16" />वो ली आय, आरू त्यो उनछे कयो, “यो छाप आरू नाव कायका छे?”</para>
  <para style="p" vid="MRK 12:16">त्या कयो, “कैसर क।”<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />ईशु ने ओको कयो, “जो कैसर क छे वो कैसर क, आरू जो यहोवा–भगवान क छे यहोवा–भगवान क दो।”</para>
  <para style="p" vid="MRK 12:17">तव वो उना पर खुप भोंगलाय गयो करने लाग्या।<verse eid="MRK 12:17" /></para>
  <para style="s">पुनरूत्थान आरू वियाव</para>
  <para style="r">(<ref loc="MAT 22:23-33">मत्ती 22:23-33</ref>; <ref loc="LUK 20:27-40">लूका 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:18 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 23:8">प्रेरितन 23:8</ref>
      </char>
    </note>पछु सदूकियो ने भी, जो कये छे कि मरे हुयो क जीव उठने छे ही नी, ईशु साथे आवीन उना छे पुछा, <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />“हे गुरू मूसा ने हामरे करता लिख्या छे कि यदि काही क भाई बिना अवलियाद मर जाय आरू उना कि बायर रया जाय, ती ओको भाई ओकी बायर छे वियाव कर लेय आरू आपने भाई क करता अवलियाद पैदा कर्‍यो। <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />सात भाई हुता। पेहला भाई वियाव बिना अवलियाद मर गया। <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />तव दीसर भाई ने उनी बायर छे वियाव कर लेदा आरू बिना अवलियाद मर; आरू वोसो ही तीसरे ने भी कर्‍यो। <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />आरू सात छे अवलियाद नी हुय सब क पछव वो बायर भी मर गया। <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />शेवली कावा जीव उठने पर वो उको छे कुनीन बायर हयसे? काहकि वो सात क बायर होय चुकी हती”<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />ईशु ने उनछे कयो, “काय तुमू इन कारण छे भुल मा नी पड़्या होय कि तुमू नी ती चुखलो शास्त्र ही क जानता होय, आरू नी ही यहोवा–भगवान क शक्ति क?” <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />काहकि जव वो मर्‍यो हुया मा छे जीवन उठसे, तो वो नी वियाव करसे आरू नी वियाव मा दिया जाछे, पुन सोरगदूतन क समान होयछे। <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />मर्‍यो हुया क जीव उठने क विषय मा काय तुमू ने मूसा की किताब मा झाड़ी की काहनी मा नी भोन्या काय यहोवा–भगवान ने ओको कयो, “हाव अब्राहम क यहोवा–भगवान, आरू इसहाक क यहोवा–भगवान, आरू याकूब क यहोवा–भगवान, छे? <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />यहोवा–भगवान मर्‍यो हुया क नी वरना जीवतलान क यहोवा–भगवान छे; शेवली कावा तुमू मोटी भुल मा पड़्या होय!”<verse eid="MRK 12:27" /></para>
  <para style="s">आखान मोटली हुकुम</para>
  <para style="r">(<ref loc="MAT 22:34-40">मत्ती 22:34-40</ref>; <ref loc="LUK 10:25-28">लूका 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />शास्त्रीयो मा छे एक ने आवीन तीनुक विवाद करता सोमव्या, आरू यो जाईन कि ईशु ने तिनुक वारू रीति छे जवाब देदो, ओको पुछा, “सब छे मुखी हुकुम काहनी छे?”<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />ईशु ने ओको जवाब देदो, “सब हुकुम मा छे यो मुखी छे: ‘छे इस्राएल सोमव्य! पोरबु हामरे यहोवा–भगवान एक ही पोरबु छे, <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />आरू तु पोरबु आपसा यहोवा–भगवान सी थारा सब मन सी, आरू थारा सब जीव सी, आरू थारी सारी ओकल सी, आरू थारी सारी ताकत सी मोंग राख।’ <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />आरू दिसरा यो छे, ‘तु थार साथेवावा सी आपसे मोंग।’ इनासे मोटी आरू काही हुकुम नी।”<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />शास्त्री ने ओको कयो, “हे गुरू घोणा ठीक! तु ने सच कयो कि वो एक ही छे, आरू ओको छुड़ीन आरू काही नी। <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />आरू ओको सब मन, आरू सारी बुध्दी आरू सब जीव, आरू सारी शक्ति क साथ मोंग राखने; आरू साथेवावा छे आपने समान मोंग राखने, सब होमबली आरू बलिदान छे बढ़ीन छे।” <verse eid="MRK 12:33" /><verse number="34" style="v" sid="MRK 12:34" /><note caller="+" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">लूका 10:25-28</ref></char></note>जव ईशु ने देख्या कि त्यो समझ छे जवाब ददो, तो ओको कयो, “तु यहोवा–भगवान क राज्य छे दूर नी।”</para>
  <para style="p" vid="MRK 12:34">आरू काही क पछु ओको काय पुछने क साहस नी हुया।<verse eid="MRK 12:34" /></para>
  <para style="s">मसीह कुनीन पोर्‍यो छे?</para>
  <para style="r">(<ref loc="MAT 22:41-46">मत्ती 22:41-46</ref>; <ref loc="LUK 20:41-44">लूका 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />पछु ईशु ने मंदिर मा खबर करता हुये यो कयो, “शास्त्री कोसो कये छे की मसीह दाऊद क पोर्‍यो छे?”<verse eid="MRK 12:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="MRK 12:36" />दाऊद ने आप ही चुखलो आत्मा मा हईन कयो छे:</para>
  <para style="q2" vid="MRK 12:36">पोरबु ने मारे छे कयो, “मारे जेवड़े बठ्य, जव तक कि हाव तारी दुस्मन क तारे पाय कि पीढ़ी नी कर दिदा।”<verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />“दाऊद ते आपसु ओको पोरबु कयता छे, पछु वो ओको पोर्‍यो कयो छे ठहरा?”</para>
  <para style="p" vid="MRK 12:37">आरू गर्दी क मानसे ओकी खुशी छे सोमवते हुते।<verse eid="MRK 12:37" /></para>
  <para style="s">शास्त्रीया छे सावधान</para>
  <para style="r">(<ref loc="MAT 23:1-36">मत्ती 23:1-36</ref>; <ref loc="LUK 20:45-47">लूका 20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />ईशु ने आपसी खबर मा उनछे कयो, “शास्त्रीयो छे चोकचौळीया रयो, जो नांबा–नांबा चोगला पेहरीन हुये पुगनेन आरू बजारो मा नमस्कार, <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />आरू प्रार्थना घर मा मुखी–मुखी आसन आरू भोज मा मुखी–मुखी स्थान भी जुवता छे। <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />वो रंडायली क घर क खाय जातो छे, आरू देखाड़ने क करता मोटी मोटी प्रार्थना करता छे। सवटो दण्ड जुड़से।”<verse eid="MRK 12:40" /></para>
  <para style="s">गरीब रंडायली क दान</para>
  <para style="r">(<ref loc="MAT 23:1-36">मत्ती 23:1-36</ref>; <ref loc="LUK 20:45-47">लूका 20:45-47</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />ईशु मंदिर क भण्डार क सामने बठीन देख रया हुता कि मानसे मंदिर क भण्डार मा काय प्रकार दान नाखता छे; आरू खुप छे धनवान खुप काय नाख्या। <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />ओतरा मा एक गरीब रंडायली ने आवीन दुई दमडिया, जो एक आधला क बराबर होयती छे नाखी। <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />तव ईशु आपसा चेला क साथे बुलावीन उका कयो, “हाव तुमू छे सच कयता छे मंदिर क भण्डार मा नाखने वावा छे इन गरीब रंडायली सब जादा नाख्या छे; <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />काहकि सब आपसा धन क जादा मा छे नाख्या छे, पुन यो आपसी घोट मा छे जो काही ओको हुता, मतलब आपसी सारी जीविका नाख देदी छे।”<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">मंदिर क विनाश की भविष्यव्दाणी</para>
  <para style="r">(<ref loc="MAT 24:1-2">मत्ती 24:1-2</ref>; <ref loc="LUK 21:5-6">लूका 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />जव ईशु मंदिर छे निकवी रया हुता। तो ओका चेला मा छे एक ने ओको कयो, “हे गुरू, देख कोसो विशाल दगड़ आरू कोसो भव्य भवन छे।”<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />ईशु ने ओको कयो, “काय तुमू यो मोटा–मोटा भवन देखता होय: याहा दगड़ पर दगड़ भी वाच्या रयछे जो ढाया नी जाछे।”<verse eid="MRK 13:2" /></para>
  <para style="s">संकट आरू पीड़ा</para>
  <para style="r">(<ref loc="MAT 24:3-14">मत्ती 24:3-14</ref>; <ref loc="LUK 21:7-19">लूका 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />जव ईशु जैतुन क बयड़ा पर मंदिर क सामने बट्या हुता, तो पतरस आरू याकूब आरू यहुन्ना आरू अन्द्रियास ने अलग जाईन ओको पुछा, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“हामु कयो की यी वात किही होयछे? आरू जव यो सब वात पुरी हुयने पर होयछे उना टेहाव क काय सहलानी होयछे?”<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />ईशु उनछे कयनो लाग्यो, “चोकचौळीया रयो कि काही तुम्हें नी भरमाछे। <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />घोणा तारे मारे नाव छे आवीन कयसे, ‘हाव चो छे’ आरू घोणा क भरमाछे। <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />जव तुमू लड़ाई, आरू लड़ाई की चर्चा सोमवु, तो घाबराय; काहकि इन्दरो होयनो पाको छे, पुन उना टेहाव आखरी नी होयछे। <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />काहकि जाति पर जाति, आरू राज्य पर राज्य चढ़ाई करसे। हर कयी भुकंप होयछे, आरू अकाल पड़से। यो तो पीड़ा क शुरू ही होयछे।”<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:9 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:17-20">मत्ती 10:17-20</ref>; <ref loc="LUK 12:11">लूका 12:11</ref>,<ref loc="LUK 12:12">12</ref></char>
    </note>“पुन तुमू आपने विषय मा चौकचोळिया रहवो; काहकि मानसे तुमू महासभा मा सपछे आरू तुमू पंचायत मा कुटीन जाछे, आरू मारे कारण सरदार आरू राजा क ओगव उबो कर जाछे, ताकि ओको करता गवा होयछे। <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />पर पाको छे कि पेहले खुश खबर सब जाति मा खबर कर्‍यो जाछे।” <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />जव वो धरावीन तुमू ली जाय रया हता, ती पेहले चिंता नी करनो कि हामु काय कयसु; पर जु काय तुमू ओकी घड़ी देखाड़्या जाछे चा कयनो; काहकि बुलने वावा तुमू नी होय, पुन चुखलो आत्मा छे। <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />भाई आपसा भाई क आरू बास आपसा पोर्‍या घात क करता सपछे, आरू पोर्‍या माय बास क विरोध मा उठीन तीनुक माराय नाखे। <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" /><note caller="+" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">मत्ती 10:22</ref></char></note>आरू मारे नाव क कारण सब मानसे तुमू छे बैर करसे पर जो आखरी तक धीरज धर रयछे, तीनान उध्दार होयछे।<verse eid="MRK 13:13" /></para>
  <para style="s">मोटली पीड़ा काव</para>
  <para style="r">(<ref loc="MAT 24:15-28">मत्ती 24:15-28</ref>; <ref loc="LUK 21:20-24">लूका 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />“शेवली कावा चुखलो शास्त्र मा विनाशकारी वस्तु उभी होई देखसु, भंनेवावा समझी लेय तव जो यहूदिया मा होय, वो बयड़ा पर ढास जाछे।” <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" /><note caller="+" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="LUK 17:31">लूका 17:31</ref></char></note>जो छत पर होय, वो आपने घर छे काय लेने नेचो नी उतरे आरू नी माहाय जाछे; <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />आरू जो खेत मा होय, वो आपसा चादरो लेने क करता पछव नी आवे। <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />इनु दाहड़ा मा भारीस आरू दुध पावनाय होयछे ओको करता हाय! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />आरू प्रार्थना कर्‍या करो कि यो जाड़े मा नी होय। <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" /><note caller="+" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="REV 7:14">प्रकाशितवाक्य 7:14</ref></char></note>काहकि वो दाहडु ओसो पीड़ा क होयछे कि सूष्टि क शुरू छे, जो यहोवा–भगवान ने सूजी छे, हिमी तक नी तो हुय आरू नी पछु किही होयछे। <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />यदि पोरबु इनु दाहड़ा क नी घटाड़तो, ती काही जनवार भी नी वाचता; पुन उन त्योने हुया क कारण जिनको त्यो त्योना छे, उन दाहाड़ा क घटाड्या।<verse eid="MRK 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21" />“उना समय कदाम कोय तुमरे सी कये, देखो मसीह याहा छे, ‘यो देखो, वाँ छे’ तो भुरसो नी करने। <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />काहकि झुठा मसीह आरू झुठा भविष्यवक्ता उठ उबो होयछे, आरू सहलानी आरू घण मोटो काम देखाड़छे कि यदि होय सके तो त्योन्य हुया क भी भरमा दे। <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />पर तुमू चोकचौळीया रयो; देखो, हाव ने तुमू सब वात पेहले ही छे कय दी छे।”<verse eid="MRK 13:23" /></para>
  <para style="s">ईशु मानुस क पोर्‍या मतलब मखे क पुनरूत्थान</para>
  <para style="r">(<ref loc="MAT 24:29-31">मत्ती 24:29-31</ref>; <ref loc="LUK 21:25-28">लूका 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:24 </char>
      <char style="xt" closed="false">
        <ref loc="REV 6:12">प्रकाशितवाक्य 6:12</ref>
      </char>
    </note>“उन दाहड़ा मा, उना पीड़ा क बाद दाहाडु आंधारो होय जाछे, आरू चाँद विजाव नी हुयो <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" /><note caller="+" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="REV 6:13">प्रकाशितवाक्य 6:13</ref></char></note>आरू आकाश छे तारागण पड़ने लागछे; आरू आकाश कि शक्ति हाल जाछे। <verse eid="MRK 13:25" /><verse number="26" style="v" sid="MRK 13:26" /><note caller="+" style="x"><char style="xo" closed="false">13:26 </char><char style="xt" closed="false"><ref loc="REV 1:7">प्रकाशितवाक्य 1:7</ref></char></note>तव मानसे मानुस क पोर्‍या मतलब मखे मोटी शक्ति आरू महिमा क साथ बादल मा आवता देखछे। <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />उना टेहाव वो आपने सोरगदूत क मुकलकर, धरती क इनीये छोर छे आकाश क उना छोर तक, चार दिशा छे आपने त्योन्य हुय मानसे क एखठा करसे।<verse eid="MRK 13:27" /></para>
  <para style="s">गुलर क झाड़को क उदाहरण</para>
  <para style="r">(<ref loc="MAT 24:32-35">मत्ती 24:32-35</ref>; <ref loc="LUK 21:29-33">लूका 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />“अंजीर क झाड़को छे यो सपनो सीकु: जव ओकी डावखा नरम होय जाय, आरू पान्टा निकवने लागता छे; ती तुमू जान लेता होय कि ग्रीष्मकाल निकट छे। <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />इनी प्रकार जव तुमू इन वात क होते देखो, ती जान लेय कि वो निकट छे वरना झोपला ही पर छे। <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />हाव तुमू छे सच कयता छे की जव तक यो सब वात नी होय लेछे, तव तक यो मानसे जाय नी रयछे। <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />आकाश आरू धरती टल जाछे, पुन मारी वात कदी नी टळसे।<verse eid="MRK 13:31" /></para>
  <para style="s">जागता रयो</para>
  <para style="r">(<ref loc="MAT 24:36-44">मत्ती 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:32 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:36">मत्ती 24:36</ref>
      </char>
    </note>“उना दाहाड़ा यो घड़ी क विषय मा काही नी जानता, नी सोरगदूत आरू नी पोर्‍यो: पुन केवल बास। <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />देखो, जानता आरू प्रार्थना करता रयो; काहकि तुमू नी जानता की वो टेहाव किही आवसे। <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" /><note caller="+" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="LUK 12:36-38">लूका 12:36-38</ref></char></note>यो उना मानुस की सी दशा छे, जो परदेश जाते टेहाव आपसा घर क छुड़ीन जाय, आरू आपसा दास क हक देय; आरू हर एक क ओका काम कय देय, आरू व्दारपाल क जागता रयने की हुकुम देय। <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />एरकरीन जागता रयो, काहकि तुमू नी जानता की घर क भगवान किही आवसे, शांत क या आदली राती क, या कुकड़ा क वाषने देने क टेहाव या भोर क। <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />ओसो नी होय की वो उचकाळुन आवीन तुमू सुवता रयछे। <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />आरू जो हाव तुमू छे कयता छे, चो सब छे कयता छे: जागता रयो!”<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">ईशु क विरोध षड्यन्त्र</para>
  <para style="r">(<ref loc="MAT 26:1-5">मत्ती 26:1-5</ref>; <ref loc="LUK 22:1-2">लूका 22:1-2</ref>; <ref loc="JHN 11:45-53">यहुन्ना 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />दुई दाहड़ा क बाद फसह आरू अखमीरी रोटा क पर्व हुयने वावा हुता। डाहला पुजारा आरू शास्त्री इन वात की खोज मा हुत की ईशु क कोसो छल छे धर कर मार नाखने; <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />पुन कये हुते, “पर्व क दाहडू नी, कयी ओसो नी होय की मानसे मा बलवा मच्या।”<verse eid="MRK 14:2" /></para>
  <para style="s">बैतनिया मा ईशु क अभिषेक</para>
  <para style="r">(<ref loc="MAT 26:6-13">मत्ती 26:6-13</ref>; <ref loc="JHN 12:1-8">यहुन्ना 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">14:3 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 7:37">लूका 7:37</ref>,<ref loc="LUK 7:38">38</ref></char>
    </note>जव ईशु बैतनिया मा शमौन कुड़ावा क घर खाने क बट्या हुया हुता, तव एक बायर संगमरमर क ठाहरा मा जटामासी क मोहंगलो चुखो इत्र लीन आवी: आरू पात्र तुड़ीन इत्र क ओको मुनक पर नाखीन। <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />पुन काही आपने मन मा रिसियाने कयनो लाग्या, “इन इत्र क काय सच्चाईानाश कर्‍या गया? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />काहकि यो इत्र तो तीन सौ सोनान सिक्‍का सवटो मूल्य मा वेचिया जाय कर गरीब मा वाट्या जाय सकता हुता।” आरू वो ओको झाटकने लाग्या। <figure style="fig" alt="Jars with spikenard" file="hk00117c।tif" size="col" copy="Horace Knowles ©" ref="14:3">बाटली मा इस्तरन तेल</figure><verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />ईशु ने कयो, “उको छुड़ी दो; उको काय सताते होय? उना ने तो मारे साथे भलाई करी छे। <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />गरीब तुमरे साथ मा जलोम रहवे, आरू तुमू जब जुवे तव उनछे भलाई कर सकते होय; पर हाव तुमरे साथे जलोम नी रहवे। <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />जो काय वो कर सकी, त्यो कर्‍यो; त्यो मारे गाड़ने जाने की तीयारी मा पेहले छे मारी देह पर इत्र लागाड़ी छे। <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />हाव तुमू छे सच कयता छे की सब धरतीम मा वा कयी खुश खबर कर्‍या जाछे, वाँ ओका इनीये काम की चर्चा भी ओको फोम की जाछे।”<verse eid="MRK 14:9" /></para>
  <para style="s">यहूदा क विश्वास घात</para>
  <para style="r">(<ref loc="MAT 26:14-16">मत्ती 26:14-16</ref>; <ref loc="LUK 22:3-6">लूका 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />तव यहूदा इस्करियोती जो बारा चेला मा रयन एक हुता, डाहला पुजारा क साथे गया की ईशु क ओको हात धरीन देय। <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />वो यो सोमवीन खुश हुयो; आरू ओको पोशा आपने वायदो कर्‍यो; आरू वो मेखे हेरने लाग्या की ओको काही प्रकार धरीन देय।<verse eid="MRK 14:11" /></para>
  <para style="s">ईशु चेला क साथे फसह क पछव खानो</para>
  <para style="r">(<ref loc="MAT 26:17-25">मत्ती 26:17-25</ref>; <ref loc="LUK 22:7-14">लूका 22:7-14</ref>,<ref loc="LUK 22:21">21</ref>,<ref loc="LUK 22:23">23</ref>; <ref loc="JHN 13:21-30">यहुन्ना 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />अखमीरी रोटा क पर्व क पेहले दाहडु, जिनमा वो फसह क बलिदान करता हुते, ईशु क चेला ने उको पुछा, “तु कयो जुवे छे की हामु जाईन तारे करता फसह खाने की तीयारी कर्‍या?”<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />त्यो ओका चेला मा सी दुय क यो कयीन मुकल्यो, “नगर मा जावु, आरू एक मानुस पानी क हाण्डो हाकलीन हुया तुमू मीवछे, ओका पछव होय लेन: <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />आरू वो जिना घर मा जाय, उना घर क भगवान छे कयनो, ‘गुरू कयता छे की मारी पाहंनतराय शाला जिनमा आपसा चेला क साथे फसह खावु कयो छे?’ <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />वो तुमू एक सजी–सजावळी, आरू तीयार करी हुयी मोटी कमरो देखाय देसे, वो हामरे करता तीयार करू।”<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />चेला निकवीन नगर मा आश, आरू जोसो त्यो उनछे कयो हुता, वोसो ही देख्या; आरू फसह तीयार कर्‍या।<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />जव शाम हुयी, तो वो बारा क साथे आयु। <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />जव वो बठ्या खाने क रया हुते, तो ईशु ने कयो, “हाव तुमू छे सच कयता छे की तुमू मा छे एक, जो मारे साथे खाने क रया छे मखे धरावछे।”<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />चेला उदास होय गयो आरू एक करीन ओको पुछने लाग्या, “काय चु हाव ते नी छे?”<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />त्यो उनछे कयो, “वो बारा मा छे एक छे, जो मारे साथे थावी मा हात नाखता छे। <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />काहकि मानुस क पोर्‍या मतलब मखे तो जोसो ओको विषय मा लिख्या छे, जाता ही छे; पुन उना मानुस पर हाय ओका द्वारा मानुस क पोर्‍या मतलब मखे धराया जाय छे! यदि उना मानुस क जनम नी हुता तो ओको करता भलो होयतो।”<verse eid="MRK 14:21" /></para>
  <para style="s">पोरबु–भोजन</para>
  <para style="r">(<ref loc="MAT 26:26-30">मत्ती 26:26-30</ref>; <ref loc="LUK 22:14-20">लूका 22:14-20</ref>; <ref loc="1CO 11:23-25">1 कुरन्थियो 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />जव वो खाय ही रया हुते, ईशु ने रोटा लीन, आरू सय बरकत मांगीन तुड़ी तीनुक दी, आरू कयो, “ले, यो मारी देह छे।”<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />पछु त्यो वाटको लीन धन्यवाद कर्‍या, आरू तीनुक दिया; आरू उन सब ने उको छे पीया। <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />आरू त्यो कयो, “यो भोनु की मारो लुहूय यो छे, जो खुप क करता वयाड़े जा छे। <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />हाव तुमू छे सच कयता छे की अंगुर क रस उना दाहड़े तक पछु कदी नी पीस, जव तक यहोवा–भगवान क राज्य मा नयो नी पीस।”<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />पछु वो भजन गावीन बाहरता जैतुन क बयड़ा पर गया।<verse eid="MRK 14:26" /></para>
  <para style="s">पतरस क मना की भविष्यव्दाणी</para>
  <para style="r">(<ref loc="MAT 26:31-35">मत्ती 26:31-35</ref>; <ref loc="LUK 22:31-34">लूका 22:31-34</ref>; <ref loc="JHN 13:36-38">यहुन्ना 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />तव ईशु ने उनछे कयो, “तुमू सब ठुकर खासे, काहकि लिख्या छे: ‘हाव गुवाळ क मारीस, आरू गाडरा इदीर तितर–बितर होय जाछे।’ <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" /><note caller="+" style="x"><char style="xo" closed="false">14:28 </char><char style="xt" closed="false"><ref loc="MAT 28:16">मत्ती 28:16</ref></char></note>पुन हाव म्हार जीव उठने क बाद मा तुमरे सी पेहल गलील मा जाईस।”<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />पतरस ने ओको कयो, “यदि सब ठुकर खाय तो खाय, पर हाव ठुकर नी खाम।”<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />ईशु पतरस सी कयो, “हाव तुखे छे सच कयता छे की आज ही इनी रात क कुकड़ा क दुई कावा वाषने देने छे पेहले, तु तीन कावा मखे छे मुकर जाछे।”<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />पर त्यो आरू भी जो सी दीन कयो, “यदि मखे तारे साथे मरना भी पड़े तीभी तारे मना कदी नी करीस।”</para>
  <para style="p" vid="MRK 14:31">इनी प्रकार आरू सब ने भी कयो।<verse eid="MRK 14:31" /></para>
  <para style="s">गतसमनी मा प्रार्थना</para>
  <para style="r">(<ref loc="MAT 26:36-46">मत्ती 26:36-46</ref>; <ref loc="LUK 22:39-46">लूका 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />पछु वो गतसमनी नावन एक धरती मा आश, आरू ईशु ने आपसा चेला छे कयो, “याहा बठ्या रयो, जव तक हाव प्रार्थना करीस।” <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />आरू वो पतरस आरू याकूब आरू यहुन्ना क आपने साथे लेय गया; आरू खुप ही कमजोर आरू घबरायने हुयने लाग्या, <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />आरू त्यो कयो, “मारो मन खुप नराज छे याहा तक कि हाव मरना पर छे: तुमू याहा तक रूकु आरू जागता रयो।”<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />पछु वो थुड़ा अगळ ओगस आरू धरती पर टेकीन प्रार्थना करने लाग्यो की यदि होय सके तो यो घड़ी मखे पर छे टल जाय, <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />आरू कयो, “हे बाप, मखे छे सब काय होय सकता छे; इनीये वाटका क मारे साथे छे हटाय लेय: तव जोसो हाव जुवता छे वोसो नी, पर जो तु जुवता छे चो होय।”<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />पछु वो आश आरू तीनुक सुवता देखीन पतरस छे कयो, “हे शमौन, तु सुई रया छे? काय तु एक घड़ी भी नी जाग सके? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />जागता आरू प्रार्थना करता रयो की तुमू परीक्षा मा नी पडु। आत्मा तो तीयार छे, पर शरीर दुर्बल छे।”<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />आरू वो पछु चालीन गया आरू तीनुक ओवाज मा प्रार्थना करी। <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />पछु आवीन तीनुक सुवता देख्या, काहकि ओकी डुवा नींद छे भर्‍या हुता; आरू नी जानता हुते की ओको काय जवाब देय।<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />पछु तीसरी बार आवीन उनछे कयो, “हिमी सुवता रयो आरू आराम करो, बस घड़ी आय पुच्या; देखो मानुस क पोर्‍या मतलब मखे क पापी क हात धराया जाता छे। <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />उठु चालु! देखो, मखे धरावने वावा नाट आय गयो छे।”<verse eid="MRK 14:42" /></para>
  <para style="s">ईशु क धोखा छे धरीन जाने</para>
  <para style="r">(<ref loc="MAT 26:47-56">मत्ती 26:47-56</ref>; <ref loc="LUK 22:47-53">लूका 22:47-53</ref>; <ref loc="JHN 18:3-12">यहुन्ना 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />ईशु यो कय ही रया हुता की यहूदा जो बारा मा छे एक हुता, आपने साथे डाहला पुजारा आरू शास्त्री आरू पुरनियो की आरू छे एक मोटी गर्दी लीन तत्काल आय पुच्या, जो तलवार आरू ड़ेगा लीन हुता। <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />ओको धरावने वावा ने तीनुक यो पता दीया हुता की जिनाक हाव गुवू चो छे, उको धरीन यत्न छे ली जाने।<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />वो आश, आरू तत्काल ओको साथे जाईन कयो, “हे गुरू!” आरू ओको घोणा चूमा। <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />तव लोगहन ईशु पर हात नाखीन आरू उको धर लेदा। <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />उन मा छे जो साथे उबो हुतो एक ने तलवार हापक कर पुजारा क दास पर चालाड़ी, आरू ओका कांटो तुड़ देदो। <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />ईशु ने उनछे कयो, “काय तुमू डाकू जानीन मखे धरने क करता तलवार आरू ड़ेगा लीन निकव्या होय? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" /><note caller="+" style="x"><char style="xo" closed="false">14:49 </char><char style="xt" closed="false"><ref loc="LUK 19:47">लूका 19:47</ref>; <ref loc="LUK 21:37">21:37</ref></char></note>हाव तो हर दाहड़े मंदिर मा तुमरे साथे रयन खबर दिया करतो हुतो, आरू तव तुमू ने मखे नी दरिया: पुन यो एरकरीन हुयो छे की चुखलो शास्त्र की वात पुरी होयछे।”<verse eid="MRK 14:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50" />इनीये पर सब चेला ओको छुड़ीन ढास गया।<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />एक जुवान आपसी उघाड़ा डील पर चादर पांगरी हुयो ओको पछव होय लेदा; आरू मानसे ने ओको दरिया। <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />पर वो चादर छुड़ीन उघाड़ा ढ़ास गया।<verse eid="MRK 14:52" /></para>
  <para style="s">महासभा क सामने ईशु</para>
  <para style="r">(<ref loc="MAT 26:57">मत्ती 26:57</ref>,<ref loc="MAT 26:68">68</ref>; <ref loc="LUK 22:54-55">लूका 22:54-55</ref>,<ref loc="LUK 22:63">63</ref>,<ref loc="LUK 22:71">71</ref>; <ref loc="JHN 18:13">यहुन्ना 18:13</ref>,<ref loc="JHN 18:14">14</ref>,<ref loc="JHN 18:19">19</ref>,<ref loc="JHN 18:24">24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />पछु वो ईशु क डाहला पुजारा क साथे ली गया; आरू सब प्रधान पुजारा आरू पुरनिय आरू शास्त्री ओका याहा एखठा होय गया। <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />पतरस दुर ही दुर ओको पोछव–पछव डाहला पुजारा क आंगना मा माहाय तक गया, आरू प्यादो साथे बठीन आगठी तापने लाग्या। <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />मुखी पुजारा आरू सारी महासभा ईशु क मार नाखने क करता ओको विरोध मा गवा की खोज मा हुते, पर नी मिवी। <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />काहकि घोणा छे ओको विरोध मा झुठ गवा दे रया हुते, पर ओकान गवा एक ओसी नी हुती।<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />तव काय मानसे ने उठीन ओको क विरोध यो झुठ गवा देदी, <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" /><note caller="+" style="x"><char style="xo" closed="false">14:58 </char><char style="xt" closed="false"><ref loc="JHN 2:19">यहुन्ना 2:19</ref></char></note>“हामु इना ओसो कये सोमव्या छे, हाव इन हाथ क बनायू होय मंदिर क उदार दीस, आरू तीन दहाड़ा मा दिसरा बनाय दिस, जो हाथ छे नी बने होय।” <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />इनीये पर भी उनकी गवा एक ओसी नी निकवी।<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />तव डाहला पुजारा ने वीच मा उबो हईन ईशु छे पुछा, “तु काही जवाब नी देतो?”<verse eid="MRK 14:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61" />पुन वो चुप रियो, आरू काय जवाब नी दिया। डाहला पुजारा ने ओका सी पछु पुछा, “काय तु उना सयाळा धन्य क पोर्‍यो मसीह छे?”<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />ईशु ने कयो, “हाव छे: आरू तुमू मानुस क पोर्‍यो क ताकत वाळा यहोवा–भगवानन क जेवड़े तरफ बठ्या, आरू वादळा साथे आवता देखछे।”<verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />तव डाहला पुजारा आपसा छिंदरा फाड़ीन कयो, “हिमी हामु गवा क आरू काय योजना छे?”<verse eid="MRK 14:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MRK 14:64" />तुमू ने यो निन्दा सोमवीन। तुमरी काय राय छे? <verse eid="MRK 14:64" /><verse number="65" style="v" sid="MRK 14:65" />तव काही तो ओका पर थुप्या, आरू काही ओका मुय ढांकने आरू उको धुमाट्या,</para>
  <para style="p" vid="MRK 14:65">आरू ओको कयनो लाग्या, “भविष्यव्दाणी कर!” आरू पौलुसने ओको धरीन थापुड़ मारा।<verse eid="MRK 14:65" /></para>
  <para style="s">पतरस क मना</para>
  <para style="r">(<ref loc="MAT 26:69-75">मत्ती 26:69-75</ref>; <ref loc="LUK 22:56-62">लूका 22:56-62</ref>; <ref loc="JHN 18:15">यहुन्ना 18:15</ref>,<ref loc="JHN 18:18">18</ref>,<ref loc="JHN 18:25">25</ref>,<ref loc="JHN 18:27">27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />जव पतरस नेचो आंगना मा हुता, तो डाहला पुजारा की दासीयो मा छे एक वाँ आवी, <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />आरू पतरस क आगठो तापता देख्या उको टकटकी लागाड़ ़ी देख्या आरू कयनो लाग्या, “तु भी तो उना नासरत ईशु क साथे हुता।”<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />वो मुकर गया, आरू कयो, “हाव नी जानता आरू नी समझता छे कि तु काय कय रयी छे।” पछु वो बाहरता डेवढ़ी मा गया; आरू कुकड़ा वाषा।<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />वो दासी उको देखीन उनछे जो साथे उबो हुतो, पछु कयनो लागी, “यो उनमा छे एक छे।”<verse eid="MRK 14:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MRK 14:70" />पुन वो पछु मुकर गया। थुड़ी वार बाद त्या जो साथे उबो हुत पछु पतरस छे कयो, “छाचो तु उनमा छे एक छे: काहकि तु गलीली भी छे।”<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />तव वो धिक्‍कारने आरू शपथ खाने लाग्या, “हाव उना मानुस क जेरी तुमू चर्चा करता होय, ओखे नी जानता।”<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />“तव तत्काल दूसरी बार कुकड़ो वाषो।” पतरस क वो वात जो ईशु ने ओका सी कयी हुती फोम आवी: “कुकड़ा दुई कावा वाषा ने छे पेहले तु तीन कावा मना करीस।” आरू वो इन वात क सुचीन रड़णे लाग्या।<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">पिलातुस क सामने ईशु</para>
  <para style="r">(<ref loc="MAT 27:1">मत्ती 27:1</ref>,<ref loc="MAT 27:2">2</ref>,<ref loc="MAT 27:11">11</ref>,<ref loc="MAT 27:14">14</ref>; <ref loc="LUK 23:1-5">लूका 23:1-5</ref>; <ref loc="JHN 18:28-38">यहुन्ना 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />भोर होयते ही तत्काल डाहला पुजारा, पुरनियो, आरू शास्त्रीयो ने वरना सारी महासभा ने सलाह करीन ईशु क बांधाड़या आरू ओको ली जाय पिलातुस क हाते सौप दीया। <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />पिलातुस ने ओको पुछा, “काय तु यहूदि यो क राजा छे?”</para>
  <para style="p" vid="MRK 15:2">“त्यो ओको क जवाब दीया; कि तु आप ही कय रया छे।”<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />डाहला पुजारा ओको पर खुप वात क दोष लागाड़ रया हुता। <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />पिलातुस ने ओको पछु, “काय तु काहय जवाब नी देतो, देख यो तुखे पर कोतरी वात क दोष लागाड़ रया छे?”<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />ईशु ने पछु काय जवाब नी दीया; याहा तक की पिलातुस क मोटा घबरायीन हुयो,<verse eid="MRK 15:5" /></para>
  <para style="s">मृत्यु दण्ड़ की हुकुम</para>
  <para style="r">(<ref loc="MAT 27:15-26">मत्ती 27:15-26</ref>; <ref loc="LUK 23:13-25">लूका 23:13-25</ref>; <ref loc="JHN 18:39-19:16">यहुन्ना 18:39–19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />पिलातुस उना पर्व मा काही एक बन्दी क जिना वो जुवता हुता, ओको करता छुड़ी दीया करता हुता। <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />बरअब्बा नाव क मानुस उन बुलवाया क साथे बन्दी हुता, जा राजद्रोह टेमे मार्‍या हता। <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />आरू गर्दी ऊपर जाईन ओको रावन्या करने लागी, कि जोसो तु हामरे करता आश छे वोसो ही कर। <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />पिलातुस ने उनको जवाब दीया, “काय तुमू जुवता होय कि हाव तुमरे करता यहूदि यो क राजा क छुड़ दम?” <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />काहकि वो जानता हुता कि डाहला पुजारा ने उको डाह छे धराया हुता।<verse eid="MRK 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11" />पुन डाहला पुजारा मानसक क जुर देवाड़ीया कि बरअब्बा क ओको करता छुड़ देय। <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />यो सोमवी पिलातुस ने उनछे पछु पुछा, “तो जिनाक तुमू यहूदि यो क राजा कयता होय, ओको हाव काय करीस?”<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />वो पछु आयड़ीन, “ओको कुरूस पर चढ़ाय देय!”<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />पिलातुस ने ओको कयो, “काय, यो बुराय करी छे?” पुन वो आरू भी आयड़ीन, “ओको कुरूस पर चढ़ाय देय!”<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />तव पिलातुस ने गर्दी क खुश करने कि मरजी छे, बरअब्बा क ओको करता छुड़ दीया, आरू ईशु क लागाड़ ़ी सौप दीया कि कुरूस पर चढ़ाय जाय।<verse eid="MRK 15:15" /></para>
  <para style="s">सैनिक द्वारा ईशु क विजुत नी करनो</para>
  <para style="r">(<ref loc="MAT 27:27">मत्ती 27:27</ref>,<ref loc="MAT 27:31">31</ref>; <ref loc="JHN 9:2-3">यहुन्ना 9:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />सैनिक ईशु क किलान माहाय क आंगना मा ली गया जो प्रीटोरियुम कहवाये छे, आरू सारी पलटन क किला मा बुलाय लाया। <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />तव त्या ओको बैंजनी छिंदरा पेहराया आरू काटान मुकट गुथीन ओका मुनका पर राख्या, <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />आरू यो कयन ओको नमस्कार करने लाग्या, “हे यहूदियो क राजा, नमस्कार!” <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />वो ओका मुनका पर सरकण्डे देता आरू ओको पर थुपता, आरू घटना टेकड़ीन ओको नमस्कार करावता रये। <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />ठजव वो ओको ठट्टा कर चुक्या, तो उना पर छे बैंजनी छिंदरा उतारीन तीनी छिंदरा पेहराया; आरू तव ओको कुरूस पर चढ़ावने क करता बाहरता ली गया।<verse eid="MRK 15:20" /></para>
  <para style="s">ईशु क कुरूस पर चढ़ावने जाने</para>
  <para style="r">(<ref loc="MAT 27:32-44">मत्ती 27:32-44</ref>; <ref loc="LUK 23:26-43">लूका 23:26-43</ref>; <ref loc="JHN 19:17-27">यहुन्ना 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">15:21 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 16:13">रोमियो 16:13</ref>
      </char>
    </note>ईशु साथे दुय ड़ाखु कुरूस पर अलेक्जेन्द्रिया आरू रूफुस क बास शमौन, एक कुरेनी मानुस, जो गाव छे आय रयो हुतो उधर छे निकव्यो; त्या ओको अमथो मा दरिया कि ईशु क कुरूस हुचलीन ली चाल्या। <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />वो ईशु क गुलगुता नावन धरती पर, जिना क मतलब खोपड़ी की धरती छे, लायो। <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />वाँ उको गंधरस मिव्यो हुया अंगुरन रस देने लाग्या, पुन ओका नी लेदो। <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />तव त्या उको कुरूस पर चढ़ाया आरू ओका लुगड़ा पर चिठ्ठया नाखीन कि काही क काय मीवछे, तीनुक वाट लेदो। <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />आरू एक पहर दाहडु चढ़ी आश हुता, जव त्या ओको कुरूस पर चढ़ाया। <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />आरू ओको दोषपत्र लिखीन ओका ऊपर लागाड़ दीया गया कि यहूदि यो क राजा। <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />त्या ओको साथे दुई डाकू, एक ओकी जेवड़ा आरू एक ओकी डावू आरू कुरूस पर चढ़ाया। <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />तव चुखलो शास्त्र क वो वचन कि वो गुणेगार क साथ मा गिनाय गयो, त्यो पूरो हुयो।<verse eid="MRK 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29" />
    <note caller="+" style="x">
      <char style="xo" closed="false">15:29 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 14:58">मरकुस 14:58</ref>; <ref loc="JHN 2:19">यहुन्ना 2:19</ref></char>
    </note>आरू मार्ग मा जानेवावा मुनक हालवीन आरू यो कयकर ओकी वायकेड़ा उड़ावता हुता, “वाहा! मंदिर क उदारने, आरू तीन दाहड़ा मा बनावने! <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />कुरूस पर छे उतरीन आपने आप क वाचाड़ लेय।”<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />इनी रीति छे डाहला पुजारा भी, शास्त्रीयो सहावत, आपस मा ठट्टा छे कये हुते, “इनीये ने दिसरा क वाचाड़ सकता।”<verse eid="MRK 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 15:32" />“इस्राएल क राजा, मसीह, हिमी कुरूस पर रयन उतरीन आव कि हामु देखीन विश्वास करसु।” आरू जो ओको साथे कुरूस पर चढ़ाय गया, वो भी ओकी निंदा करता हुता।<verse eid="MRK 15:32" /></para>
  <para style="s">ईशु क जीव त्यागना</para>
  <para style="r">(<ref loc="MAT 27:45-56">मत्ती 27:45-56</ref>; <ref loc="LUK 23:44-49">लूका 23:44-49</ref>; <ref loc="JHN 19:28-30">यहुन्ना 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />सिरान हुयने पर सब धरती पर आंधारो होय गयो, आरू तीसरे पहर तक रया। <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />तीसरे पहर ईशु ने मोटो जुरे छे आयड़ीन कर कयो, “इलोई, इलोई लमा शबक्तनी?” जिनानस मतलब यो छे, “हे मारा यहोवा–भगवान, हे मारा यहोवा–भगवान, तु ने मखे काय छुड़ दीया?”<verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />जो साथे उबो हुतो, ओका छे काय ने यो सोमवीन कयो, “देखो, वो एलियाह क पुकारता छे।” <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />आरू एक ने दोड़ीन छिंदरो लेपटायलो लाकड़ो सिरका मा डुबायो, आरू सरकण्डे पर राखीन ओको चुसाया आरू कयो, “ठहर जाय, देखा, एलियाह ओको उतारने क करता आवता छे कि नी।”<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />तव ईशु ने मोटा ओवाज मा आयड़ीन जीव छुड़ी दिया।<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />आरू मंदिर क परदो उपर सी नेड़ो तक फाटीन दुई तुकड़ा होय गया। <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />जो सुबेदार ओको सामने उबो होतो, जव उको यु आयड़ीन जीव छुड़ता हुयो देख्या, तो चु कयो, “सच यो मानुस, यहोवा–भगवान क पोर्‍या हुता।”<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />
    <note caller="+" style="x">
      <char style="xo" closed="false">15:40 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 8:2">लूका 8:2</ref>,<ref loc="LUK 8:3">3</ref></char>
    </note>काही बायर भी दुर छे देख रयी हूती: उनमा मरियम मगदलीनी, नानू याकूब आरू यो योसेस की माय मरीयम, आरू सलोमी हुती। <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />जव वो गलील मा हुता तो यो ओको पछव होय लेती हूती आरू ओकी सेवा टहल कर्‍या करती हुती; आरू दिसरी घण सवटी बायर भी हुती, जो ओका साथ मा यरूशलेम मा आवली हुती।<verse eid="MRK 15:41" /></para>
  <para style="s">ईशु क गाड़ ़ीन जाने</para>
  <para style="r">(<ref loc="MAT 27:57-61">मत्ती 27:57-61</ref>; <ref loc="LUK 23:50-56">लूका 23:50-56</ref>; <ref loc="JHN 19:38-42">यहुन्ना 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />जव शांत होय गयो तो अतरान करीन की तियार क दाहडु हुता, जो आराम क एक दाहड़ु पेहेल हुये, <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />अरिमतियाह क रयनेवावा यूसुफ आयो, जो महासभा क सदस्य हुता आरू आप भी यहोवा–भगवान क राज्य की वाट जोहता हुता। वो हियाव करीन पिलातुस क साथे गया आरू ईशु क धोङ मांग्या। <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />पिलातुस क घबरायीन हुया की वो ओतरा शीघ्र मर गया; आरू त्यो सुबेदार क बुलावीन पुछा, “काय ओको मरा हुयो वार हुयी?” <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />जव त्यो सुबेदार क द्वारा हाल जान लेदा, तो धड़ यूसुफ क देवाड़ दिया। <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />तव त्यो सुवावी की एक चादर मूले लीन, आरू धड़ क उतारीन उना चादर मा लेपटीन, आरू एक झपला मा जो चट्टान मा खुदीन गयी हूती राख्या, आरू मोळवट्याम क दरवाज पर एक दगड़ ढाक दीया। <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />मरियम मगदलीनी आरू योसेस की माय मरियम देख रयी हुती कि वो काँ राख गया छे।<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">ईशु क नवलोजीवन</para>
  <para style="r">(<ref loc="MAT 28:1-8">मत्ती 28:1-8</ref>; <ref loc="LUK 24:1-12">लूका 24:1-12</ref>; <ref loc="JHN 20:1-10">यहुन्ना 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />जव आराम क दाहडु वीत गयो तो मरीयम मगदलीनी, आरू याकूब की माय मरियम, आरू सलोमी ने सुगन्ध इत्र समान मुवे लीन की आवीन ईशु क डील पर लागाड़या। <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />हापतान क पेहलो दाहडु मोटो सदारे जव दाहडु निकव्यु ही हुती, वो मोड़वाट्या पर आवी, <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />आरू आपस मा कयती हुती, “हामरे करता मोळवट्याम क झपला पर छे दगडू कुन धकल्यो?” <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />जव त्या डुवा उघाडीन, तो देख्या की दगडू धकल्यो हुया छे वो खुप ही मोटा हुता। <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />मोड़वाट्या क माहीय जाईन त्या एक जुवान क धव्व्या डोगला पेहरीन हुयो जेवड़ा तरफ बठ्या देख्या, आरू खुप भोंगलाय हुयी।<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />त्यो उनछे कयो, “चकित मत होय, तुमू ईशु नासरत क, जो कुरूस पर चढ़ाया गया हुता, हेरती होय। वो जीव उठ्यो छे, याहा नी छे; देख, यी वो स्थान छे, वा त्या ओको राख्या हुता।” <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" /><note caller="+" style="x"><char style="xo" closed="false">16:7 </char><char style="xt" closed="false"><ref loc="MAT 26:32">मत्ती 26:32</ref>; <ref loc="MRK 14:28">मरकुस 14:28</ref></char></note>“पुन तुमू जायन, आरू ओका चेला आरू पतरस छे कयो की वो तुमू छे पेहल गलील क जाछे। जोसो ओका तुमु क कयो हतो, तुमु चाँ ओका हेरजु।”<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />आरू ची मोळवट्याम बाहरते निकलीन ढास गयो; काहकि कापती आरू घाबराई उका पर छा गयो; आरू त्या कुदाक काहय नी कयी काहकि ची बीहिती हुती।<verse eid="MRK 16:8" /></para>
  <para style="s">मरीयम मगदलीनी क ईशु क देखाय देने</para>
  <para style="r">(<ref loc="LUK 24:13-35">लूका 24:13-35</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />यो आयते जुनला नियम नी देखाय गयी हापतान क पेहल दाहडु सदारे होते ही ईशु जीवीन उठीन पेहल मरियम मगदलीनी क जिनमा छे त्यो सात साहळा निकावी हुती, देखाय दिया। <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />त्यो जाईन ईशु क साथी क शोक मा डूबे हुयो हुते आरू रड़ रयो हुते, खबर देदो। <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />त्या यो सोमवीन की वो जीवतो छे आरू त्यो देख्या छे, काहकि त्या पर ओका विश्वास नी हता।<verse eid="MRK 16:11" /></para>
  <para style="s">दुई चेला क ईशु क देखाय देने</para>
  <para style="r">(<ref loc="LUK 24:13-35">लूका 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />ओका बाद ईशु दिसरा रूप मा उनमा छे दुई क जव वो गाव की आरू जाय रया हुता, देखाय दीया। <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />त्या भी जाईन दिसरा क खबर दीया, पुन त्या उनकी भी भुरसो नी करी।<verse eid="MRK 16:13" /></para>
  <para style="s">ज्यारे क ईशु क देखाय देने</para>
  <para style="r">(<ref loc="MAT 28:16-20">मत्ती 28:16-20</ref>; <ref loc="LUK 24:36-49">लूका 24:36-49</ref>; <ref loc="JHN 20:19-23">यहुन्ना 20:19-23</ref>; <ref loc="ACT 1:6-8">प्रेरितन 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />पछव ईशु उन ज्यारे क भी, जव वो रोटा खाने बठ्या हुता देखाय दीया, आरू उन लोगहन क विनभुरसा आरू मन की वातड़ो हुयने पर उलाहना दीया, काहकि जिन्होने ओको जीव उठने क बाद ओको देख्या हुता, या उनकी भुरसो नी करी हुती। <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" /><note caller="+" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="ACT 1:8">प्रेरितन 1:8</ref></char></note>आरू त्यो ओका कयो, “तुमू सब जगमा जाईन सब धरती पर मानसक क यी खुश खबर सोमवाड़ु। <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />जो विश्वास करसे आरू बपतिस्मा लेछे तीनी क उध्दार होयछे, पुन जो विश्वास नी करसे वो दोषी ठहराय जाछे; <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />जो विश्वास करनेवावा मा यो सहलानी होयछे की वो मारे नाव छे साहळा क निकावछे नोवली भाषा बुलछे, <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />घड़सा क उठाय लेछे, आरू यदि वो प्राणनाशक समान भी पी जाय तीभी उनकी काय हानी नी होयछे; वो बीमार पर हात राखछे, आरू वो वारू होय जाछे।”<verse eid="MRK 16:18" /></para>
  <para style="s">ईशु क सोरगदूतारोहण</para>
  <para style="r">(<ref loc="LUK 24:50-53">लूका 24:50-53</ref>; <ref loc="ACT 1:9-11">प्रेरितन 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:19 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 1:9-11">प्रेरितन 1:9-11</ref>
      </char>
    </note>पोरबु ईशु ओका सी वात करने क बाद सोरग पर उठाय लेदो गयो, आरू यहोवा–भगवान की जेवड़े; तरफ बठ् गयो।<verse eid="MRK 16:19" /></para>
  <para style="ms">दिसरी पुरानी खतम</para>
  <para style="mr">(<ref loc="LUK 16:9-10">लूका 16:9-10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 16:20" />आरू त्या निकवीन हर जागु खबर कर्‍या, आरू पोरबु ओको साथे काम करता रया, आरू उनी सहलानी क लारे वो जो साथ हुयती हुती, वचन क हेरता रया। आमेन)<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>