<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="COL" style="id">– Dhankavi</book>
  <para style="h">कुलुस्सियो</para>
  <para style="toc3">कुलुस्सियो</para>
  <para style="toc2">कुलुस्सियो</para>
  <para style="toc1">कुलुस्सियो क पौलुसन पत्री</para>
  <para style="mt2">कुलुस्सियो को पौलुस कि पत्री</para>
  <para style="mt1">कुलुस्सियो क पौलुसन पत्री</para>
  <para style="imt">परिचय</para>
  <para style="ip">कुलुस्सियो नी पत्री प्रेरित पौलुस न लारे लिखी गय। <char style="xt"><ref loc="COL 1:1">1:1</ref></char> आरू यी पत्री ईशु मसीह क जनम क बाद 60 साल बाद मा लिखी गय। आरू पत्री तव लिखी गय जव पौलुस रोम मा जेल खाना मा बंद हुतो आरू कुलुस्सियो, इफिसियो आरू फिलेमोन इनी पत्री क पौलुस जेल खाना मा सी लिखियो अतरान करीन इनी पत्री क जेल पत्री भी कये।</para>
  <para style="ip">पौलुस इनी पत्री क कुलुस्सियो न शहर मा रयने वाळा विश्वासी लोगहन क लिखीयो, कुलुस्सियो नी मंडळी क पौलुस शुर नी करीयो काहकि त्यो <char style="xt"><ref loc="COL 2:1">2:1</ref></char> मा वात क देखाड़ पुन ओका करता काहय जिम्मेदारी क जानियो हुतो आरू यो देखाड़े की इनी मंडळी क इपुफ्रास चालु करलो काहकि त्यो कुलुस्सियो मा हुतो। पौलुस कुलुस्सियो न काहय गलत शिक्षा क जानियो आरू त्यो इनी किताब क लिखने मा घण खर्चो करीयो हुय सके कि वा यहूदि विश्वासी न एक समूह रयो हसे जो पुराना नियम सी यहूदि जातीन नियम क पाळने करीन दिसरा विश्वासी क मजबुर करता हुता खास करीन खतना क बाराम। पौलुस खास करीन लिखे कि मसीह क यहोवा भगवान न लारे मानने करीन <char style="xt"><ref loc="COL 1:15-20">1:15-20</ref></char> ईशु मसीह क छुड़ीन काय भी नी हय आरू नी कुदान जरूर नी हय आरू मानुस न रीति पर शिक्षा बेकार छे। <char style="xt"><ref loc="COL 2:8">2:8</ref></char></para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. पौलुस कुलुस्सिया मा मंडळी क नमस्कार करीन पत्री क शुरू करे। <char style="ior"><ref loc="COL 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. पौलुस ईशु मसीह क मोटा काम क बारा मा लिखे आरू झुठी शिक्षा क बारा मा जवाब लिखे। <char style="ior"><ref loc="COL 1:3-3:4">1:3–3:4</ref></char></para>
  <para style="io1">3. पौलुस विश्वासी जीवन मा वारलो जीवन क जीवने करीन थुड़ीक वात क लिखे। <char style="ior"><ref loc="COL 3:5-4:6">3:5–4:6</ref></char></para>
  <para style="io1">4. पौलुस दिसरी मंडळी मा पत्री क भणियो जाने न वात देखाड़ीन आरू धन्यवाद देय। <char style="ior"><ref loc="COL 4:7-18">4:7-18</ref></char></para>
  <chapter number="1" style="c" sid="COL 1"/>
  <para style="s">नमस्कार</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1"/>पौलुस की आरू सी, जो यहोवा–भगवान की मरजी छे मसीह ईशु क प्रेरित छे, आरू भाईस तीमुथियुस की आरू छे।<verse eid="COL 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="COL 1:2"/>मसीह मा उन चुखलो आरू विश्वास भाईस क नाव जो कुलुस्से मा रयता छे:</para>
  <para style="p" vid="COL 1:2">हामरा बास यहोवा–भगवान की आरू छे तुमूक फोकटन दया आरू शांती मुवती रया।<verse eid="COL 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3"/>हामु तुमरे करता नित्य प्रार्थना करीन आपसा पोरबु ईशु मसीह क बास मतलब यहोवा–भगवान क धन्यवाद करता छे। <verse eid="COL 1:3"/><verse number="4" style="v" sid="COL 1:4"/>काहकि हामु ने सोमव्या छे कि मसीह ईशु पर तुमरा विश्वास छे, आरू सब चुखलो मानसे छे तुमू मोंग राखता होय। <verse eid="COL 1:4"/><verse number="5" style="v" sid="COL 1:5"/>ओको आश की होयी समान क कारण जो तुमरे करता सोरग मा राखी छे, जेरो वर्णन तुमू ओको खुश खबर क सच्चाई मा वचन सोमवी त्योक्यो होय। <verse eid="COL 1:5"/><verse number="6" style="v" sid="COL 1:6"/>जो तुमरा साथे पुगीयो छे, आरू धरती मा भी फैल जाय आरू बढ़ता जाता छे, वोसो ही जिना दाहड़ा छे तुमू ने ओको सोमव्या आरू सच्चाई छे यहोवा–भगवान क फोकटन दया उवखता छे, तुमू मा भी ओसो ही करता छे। <verse eid="COL 1:6"/><verse number="7" style="v" sid="COL 1:7"/><note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="COL 4:12">कुलुस्सियो 4:12</ref>; <ref loc="PHM 1:23">फिलेमोन 1:23</ref></char></note>तीनी की शिक्षा तुमू ने हामरा मोंगावु सहकर्मी इपफ्रास छे देखी, करता मसीह क विश्वासयोग्य दास छे। <verse eid="COL 1:7"/><verse number="8" style="v" sid="COL 1:8"/>तीनी ने तुमरा मोंग क जो आत्मा मा छे हामु पर प्रगट कर्‍या।<verse eid="COL 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9"/>इनी करता जिना दाहड़ा छे यो सोमव्या छे, हामु भी तुमरा करता यो प्रार्थना आरू रावन्या करने नी छुड़ता कि तुमू सब आत्मिक ज्ञान आरू समझ सहित यहोवा–भगवान की मरजी की उवख मा पाका होय जावु। <verse eid="COL 1:9"/><verse number="10" style="v" sid="COL 1:10"/>ताकि तुमरी चाल चालने पोरबु क योग्य होय, आरू वो सब प्रकार छे खुश होय, आरू तुमू मा हर प्रकार क वारला काम क फोव लाग्या, आरू तुमू यहोवा–भगवान की उवख मा बढ़त जावु। <verse eid="COL 1:10"/><verse number="11" style="v" sid="COL 1:11"/>ओकी महिमा की शक्ति नको लारे सब प्रकार करी शक्ति छे बलवन्त होयतो जावु, याहा तक खुशी क साथे हर प्रकार छे धीरज आरू सहनशील ता देखाय सक्यो। <verse eid="COL 1:11"/><verse number="12" style="v" sid="COL 1:12"/>आरू बास क धन्यवाद करता रयो, जो हामु इनीये योग्य बनाय कि दिवा मा चुखलो मानसे क साथे मीरास मा सहभागी होय। <verse eid="COL 1:12"/><verse number="13" style="v" sid="COL 1:13"/>तीनी ने हामु आंधारला क वश छे छुड़ीन आपसा मोंग पोर्‍या क राज मा भरायने कराया। <verse eid="COL 1:13"/><verse number="14" style="v" sid="COL 1:14"/><note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="EPH 1:7">इफिसियो 1:7</ref></char></note>जिना मा हामु छुटकारू मतलब पाप की माफ हासिल होयती छे।<verse eid="COL 1:14"/></para>
  <para style="s">मसीह की स्रेष्ठता आरू ओका काम</para>
  <para style="p">
    <verse number="15" style="v" sid="COL 1:15"/>वो तो विन देखिया यहोवा–भगवान क सारखो रूप आरू सारी सृष्टि मा पेहलू कोवषो छे। <verse eid="COL 1:15"/><verse number="16" style="v" sid="COL 1:16"/>काहकि तीनी मा सब समान की सृष्टि होयी, सोरग करी होय धरती की, देखी या विनदेखियो, काय सिहासन, काय पोरबुता काय प्रधानता, काय हक, सब समान तीनी क द्वारा आरू तीनी क करता सृजी गयी छे। <verse eid="COL 1:16"/><verse number="17" style="v" sid="COL 1:17"/>चो सब समान मा पेहलो छे, आरू सब समान तीनी मा स्थिर रयती छे। <verse eid="COL 1:17"/><verse number="18" style="v" sid="COL 1:18"/><note caller="+" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="EPH 1:22">इफिसियो 1:22</ref>,<ref loc="EPH 1:23">23</ref></char></note>चो देह, मतलब मंडळी क मुनको; चो शुरू छे, आरू मरला होया मा छे उठनेवावा मा पेहला कोवषा कि सब वात मा चो प्रधान ठेराया। <verse eid="COL 1:18"/><verse number="19" style="v" sid="COL 1:19"/>काहकि बास की खुशी इनी मा छे कि ओकामा सारी परिपूर्णता वास करे। <verse eid="COL 1:19"/><verse number="20" style="v" sid="COL 1:20"/><note caller="+" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="EPH 2:16">इफिसियो 2:16</ref></char></note>आरू उना क कुरूस पर वहय होया लुहूय क द्वारा भेटाव करीन, सब समान क तीनी क द्वारा छे आपने साथे मेल कर लेन जूवे वो धरती पर की होय या सोरग माईन।<verse eid="COL 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 1:21"/>तुमू जो पेहल निकायो हुयो होतो आरू बुरा काम क कारण मन दुस्मन होतो। <verse eid="COL 1:21"/><verse number="22" style="v" sid="COL 1:22"/>त्यो हिमी ओकी शारीरिक देह मा मरन क द्वारा तुमरा भी भेटाव कर लेदो ताकि तुमूक आपने सम्मुख चुखलो आरू निष्कलंक, आरू निर्दोष बनावीन हजुर करू। <verse eid="COL 1:22"/><verse number="23" style="v" sid="COL 1:23"/>यदि तुमू विश्वास की नींव पर दृढ़ बन रयो आरू ओको खुश खबर की आश क जिनाक तुमू ने नेचा की सारी सृष्टि मा कर्‍या गया, आरू जेरो हाव, पौलुस, सेवक बन्यो।<verse eid="COL 1:23"/></para>
  <para style="s">मंडळी क सेवक पौलुस</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24"/>हिमी हाव उन दुःख क कारण खुशी करता करो, जो तुमरे करता झेलो आरू मसीह क दुःखो नी घटी ओका डील क करता, मतलब मंडळी क करता, म्हारा डील मा पूरी करो। <verse eid="COL 1:24"/><verse number="25" style="v" sid="COL 1:25"/>जेरी हाव यहोवा–भगवान क ओको तयारी क लारे सेवक बन जो तुमरे करता मखे आपी गया, ताकि हाव यहोवा–भगवान क वचन लोगहन वारलान करता पुगाड़ो। <verse eid="COL 1:25"/><verse number="26" style="v" sid="COL 1:26"/>मतलब पीढी छे सातायलो रया, पुन हिमी ओका उन प्रगट होया छे। <verse eid="COL 1:26"/><verse number="27" style="v" sid="COL 1:27"/>जिन पर यहोवा–भगवान ने प्रगट करने जूवे कि तीनुक ज्ञात होय कि गैरयहुदी मा ओको भेद की महिमा क मूल्य काय छे, आरू वो यो कि मसीह जो महिमा की आश छे तुमू मा रयता छे। <verse eid="COL 1:27"/><verse number="28" style="v" sid="COL 1:28"/>जेरो खबर करीन हामु हर एक मानुस क सिखाड़ता छे, कि हामु हर एक मानुस क मसीह मा सिध्द करीन हजुर करे। <verse eid="COL 1:28"/><verse number="29" style="v" sid="COL 1:29"/>इनी क करता हाव ओकी ओको शक्ति क लारे जो मखे मा शक्ति क साथे शक्ति नाखती छे, तन मन लागाड़ ़ी मेहनत भी करता छे।<verse eid="COL 1:29"/></para>
  <chapter eid="COL 1"/>
  <chapter number="2" style="c" sid="COL 2"/>
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1"/>हाव जूवता छे कि तुमू जान लेवु कि तुमरा आरू ओको करता जो लौदीकिया हाव छे, आरू उन सब क करता जे मारा शारीरिक मुय नी देख, हाव कोसो मेहनत करता छे। <verse eid="COL 2:1"/><verse number="2" style="v" sid="COL 2:2"/>ताकि ओको मन मा होय आरू वो मोंग छे आपस मा बाधाय रया, आरू वो पूरी समझ क सब धन हासिल करू आरू यहोवा–भगवान बास क भेद क मतलब मसीह क उवखी लेय। <verse eid="COL 2:2"/><verse number="3" style="v" sid="COL 2:3"/>जिनमा बुध्दि आरू ज्ञान क सब भण्डार डुकाय होया छे।<verse eid="COL 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="COL 2:4"/>यो हाव एरकरीन कयता छे कि काही मानुस तुमूक लोभाड़ने वावी वात छे धोखु नी देय। <verse eid="COL 2:4"/><verse number="5" style="v" sid="COL 2:5"/>यद्दयपि हाव डील क भाव छे तुमू छे दूर छे, तवभी आत्मिक भाव छे तुमरे निकट छे, आरू तुमरा व्यवस्थित जीवन क आरू तुमरा विश्वास की, जो मसीह मा छे, दृढ़ता देखीन खुश होयतो छे।<verse eid="COL 2:5"/></para>
  <para style="s">मसीह मा जीवन की भरपूरी</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6"/>शेवली कावा जोसो तुमू ने मसीह ईशु क पोरबु करीन मान्य कर लेदा छे, वोसो ही तीनी मा चालतो रयो। <verse eid="COL 2:6"/><verse number="7" style="v" sid="COL 2:7"/>आरू तीनी मा मुव धरती आरू बढ़ता जावु; आरू जोसो तुमू सिकाड़ गया वोसा ही विश्वास मा दृढ होयतो जाय, आरू खुब सी खुब धन्यवाद करता रया।<verse eid="COL 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8"/>चोकचौळीया रयो कि काही तुमूक ओको तत्व ज्ञान आरू व्यर्थ धोखु द्वारा आपनो अहर नी बनाय लेय, जो मानुस की रीति आरू संसार की शुरू शिक्षा क लारे तो छे, पर मसीह क लारे नी। <verse eid="COL 2:8"/><verse number="9" style="v" sid="COL 2:9"/>काहकि ओकामा ईश्वरत्व की आखी खोरली वात जोलोम रोहे। <verse eid="COL 2:9"/><verse number="10" style="v" sid="COL 2:10"/>आरू तुमू ओकी मा भरपूर होय जो सारी प्रधानता आरू हक क शिरोमणि छे<verse eid="COL 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="COL 2:11"/>तीनी मा तुमरो ओसो खतना होया छे जो हात छे नी होयतो, मतलब मसीह क खतना, जिनासे शारीरिक देह उतार देदी जाती छे। <verse eid="COL 2:11"/><verse number="12" style="v" sid="COL 2:12"/><note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="ROM 6:4">रोमियो 6:4</ref></char></note>आरू तीनी क साथे बपतिस्मा मा गाड़ ़े गया आरू तीनी मा यहोवा–भगवान की शक्ति पर विश्वास करीन जो ओको मरला होया मा छे जीवाडड्यो ओका साथे जीवन भी उठ्यो। <verse eid="COL 2:12"/><verse number="13" style="v" sid="COL 2:13"/><note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="EPH 2:1-5">इफिसियो 2:1-5</ref></char></note>त्यो तुमूक भी, जो आपने गुणेहगार आरू डील की खतनारहित दशा मा मरला हुता, ओका साथे जीवाड्यो, आरू हामरा सब गुणेहगार क माफ कर्‍या। <verse eid="COL 2:13"/><verse number="14" style="v" sid="COL 2:14"/><note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="EPH 2:15">इफिसियो 2:15</ref></char></note>आरू विधियो क वो लेख जो हामरे नाव पर आरू हामरा विरोध मा हुता मिटा नाख्या, आरू ओको कुरूस पर खिलो छे मुवकर सामने छे हटाय दिदा छे। <verse eid="COL 2:14"/><verse number="15" style="v" sid="COL 2:15"/>आरू त्यो प्रधानता आरू हक क ऊपर छे उतारीन ओको खुल्लाम खुल्लु तमाशा बनाड़े आरू कुरूस क द्वारा उन पर जय जयकार की ध्वनि सोमवाय।<verse eid="COL 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:16 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 14:1-6">रोमियो 14:1-6</ref>
      </char>
    </note>एरकरीन खाने पीने या पर्व या नवलो चाँद या आराम क विषय मा तुमरा काही फैसला नी करे। <verse eid="COL 2:16"/><verse number="17" style="v" sid="COL 2:17"/>काहकि यी सब आवनेवाली वात क साव्वु छे, “सच्चु मसीह छे” <verse eid="COL 2:17"/><verse number="18" style="v" sid="COL 2:18"/>आरू ओको शिरोमणि क धरने नी रयता जिनासे सारी देह जुडू आरू पट्टा क द्वारा पावीन पुछीन देखीन आरू एक साथे गठकर, यहोवा–भगवान की आरू छे बढ़ती जाती छे। <verse eid="COL 2:18"/><verse number="19" style="v" sid="COL 2:19"/><note caller="+" style="x"><char style="xo" closed="false">2:19 </char><char style="xt" closed="false"><ref loc="EPH 4:16">इफिसियो 4:16</ref></char></note>ए घर वाळा आपसी–सआपसी घर वाळी सी मोंग राखो, आरू ओका सी वातड़ो व्यवहार मा करो।<verse eid="COL 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20"/>जव कि तुमू मसीह क साथे संसार की शुरू शिक्षा की आरू छे मर गया होय, तो पछु काय ओको समान जो संसार क छे जीवन देखाड़ता होय? <verse eid="COL 2:20"/><verse number="21" style="v" sid="COL 2:21"/>यो सब समान काम मा लावता लावता नष्ट होय जाछे काहकि यो मानुस की हुकुम आरू शिक्षा क लारे <verse eid="COL 2:21"/><verse number="22" style="v" sid="COL 2:22"/>यो सब समान काम मा लावता लावता नष्ट होय जाछे काहकि यो मानुस की हुकुम <verse eid="COL 2:22"/><verse number="23" style="v" sid="COL 2:23"/>इन विधि मा आपसी मरजी क लारे बनावली होयी भक्ति की रीति, आरू आत्मा मा नरमाय, आरू डील क गुण भाव सी ज्ञान क नाव तो छे, पुन डीलन लालसा क रूकने मा इनु सी काही भी लाभ नी होयतो।<verse eid="COL 2:23"/></para>
  <chapter eid="COL 2"/>
  <chapter number="3" style="c" sid="COL 3"/>
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1"/>शेवली कावा जव तुमू मसीह क सा थे जीवाड्या गया, तो सोरगदूतीय समान की हेर मा रया, वा मसीह विद्यमान छे आरू यहोवा–भगवान क डासच्या कावे बठ्या छे। <verse eid="COL 3:1"/><verse number="2" style="v" sid="COL 3:2"/>धरती पर की नी पुन सोरगदूतीय समान पर धीयान लागाड़ ु। <verse eid="COL 3:2"/><verse number="3" style="v" sid="COL 3:3"/>काहकि तुमू तो मर गया आरू तुमरा जीवन मसीह क साथे यहोवा–भगवान मा डुकायो हुयो छे। <verse eid="COL 3:3"/><verse number="4" style="v" sid="COL 3:4"/>जव मसीह जो हामरा जीवन छे, प्रगट होयछे, तव तुमू भी ओका साथे महिमा सहित प्रगट कर्‍या जासु।<verse eid="COL 3:4"/></para>
  <para style="s">जुनलो जीवन आरू नवलो जीवन</para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5"/>एरकरीन आपने उन डील क मार नाखु जो धरती पर छे, मतलब व्यभिचार, विटळ, दुष्कमना, बुरी लालस आरू लोभ क जो मुर्तिपूजक क बराबर छे। <verse eid="COL 3:5"/><verse number="6" style="v" sid="COL 3:6"/>इन ही क कारण यहोवा–भगवान क प्रकोप हुकुम नी माननेवावा पर पड़ती छे। <verse eid="COL 3:6"/><verse number="7" style="v" sid="COL 3:7"/>आरू तुमू भी, जव इन बुराइयो मा जीवन देखाड़ता हुता तो इन्ही क लारे चालता हुता।<verse eid="COL 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 3:8"/>पर हिमी तुमू भी इन सब क, मतलब रीस, दोष, बैरभाव, निन्दा आरू मुय छे लोड़ने बोकने यो सब वात छुड़ देवु। <verse eid="COL 3:8"/><verse number="9" style="v" sid="COL 3:9"/><note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="EPH 4:22">इफिसियो 4:22</ref></char></note>एक दिसरा छे झूठ मा बुलू, काहकि तुमू ने जुनला मानुस क ओका काम सहावत उतार नाख्या छे। <verse eid="COL 3:9"/><verse number="10" style="v" sid="COL 3:10"/><note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="EPH 4:24">इफिसियो 4:24</ref></char></note>आरू नवलो मानुस क पेहर लेदा छे, जो आपने सृहाहार क स्वरूप क लारे ज्ञान हासिल करने क करता नवलो बनतो जातो छे। <verse eid="COL 3:10"/><verse number="11" style="v" sid="COL 3:11"/>आरू उका परिणाम यो छे कि त्यो यूनानी आरू नी ते यहूदि मा कोय माहय नी रवतु छे, आरू नी ते काहना खतना करला होया आरू खतना रहीत मा, आरू नी काहना वारलु मानसु आरू वारलु मानसु मा दास नी छु़ला मानुस मा पुन मसीह ज सब जागे छे, आरू सब मा ओको गाव छे।<verse eid="COL 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:12 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 4:2">इफिसियो 4:2</ref>
      </char>
    </note>एरकरीन यहोवा–भगवान क त्योन्या होया क समान जो चुखलो आरू मोंगावु छे, मोटी दया, आरू भलाई, आरू दीनता, आरू नम्रता, आरू सहनशीलता धारण करू। <verse eid="COL 3:12"/><verse number="13" style="v" sid="COL 3:13"/><note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="EPH 4:32">इफिसियो 4:32</ref></char></note>आरू यदि काही क काही पर दोष देने क कारण होय, तो एक दिसरा की सह लेवु आरू एक दिसरा क गुणेहगार माफ करू; जोसो पोरबु ने तुमरा गुणेहगार माफ कर्यो, वोसो ही तुमू भी करू। <verse eid="COL 3:13"/><verse number="14" style="v" sid="COL 3:14"/>इन सब क ऊपर मोंग क जो सिध्दता क पट्टो बांध लेवु। <verse eid="COL 3:14"/><verse number="15" style="v" sid="COL 3:15"/>मसीह की शांती ओका करता तुमू एक देह हईन बुलाया भी गया होय तुमरा दिल मा राज करे; आरू तुमू धन्यवाद बन रवु। <verse eid="COL 3:15"/><verse number="16" style="v" sid="COL 3:16"/><note caller="+" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="EPH 5:19">इफिसियो 5:19</ref>,<ref loc="EPH 5:20">20</ref></char></note>मसीह क वचन क आपसा दिल मा खुबुत् बठने देवु, आरू सिध्द ज्ञान सहित एक दिसरा क सिकाड़ने आरू चिंता, आरू आपसा–आपसा मन मा फोकटन दया क साथे यहोवा–भगवान क करता भजन आरू बढ़ाईगान आरू आत्मिक गीत गावु। <verse eid="COL 3:16"/><verse number="17" style="v" sid="COL 3:17"/>वचन मा या काम जो काही भी करू सब पोरबु ईशु क नाव छे करू, आरू ओका द्वारा यहोवा–भगवान बास क धन्यवाद करू।<verse eid="COL 3:17"/></para>
  <para style="s">नवलो जीवन क पारिवारिक नियम</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:18 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:22">इफिसियो 5:22</ref>; <ref loc="1PE 3:1">1 पतरस 3:1</ref></char>
    </note>हे लुगाई, जोसो पोरबु मा वारू छे, वोसो ही आपसा–आपसा घर वावा क हको तळे रवु।<verse eid="COL 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="COL 3:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:19 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:25">इफिसियो 5:25</ref>; <ref loc="1PE 3:7">1 पतरस 3:7</ref></char>
    </note>हे घर वावा आपसी–आपसी लुगाई, छे मोंग राखु, आरू उनछे वातड़ो हुयने नी करनो।<verse eid="COL 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 3:20"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:20 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:1">इफिसियो 6:1</ref>
      </char>
    </note>हे पोर्‍या, सब वात मा आपसा–आपसा आश बास की हुकुम क पालन करू, काहकि पोरबु इनीये छे खुश होयतो छे।<verse eid="COL 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 3:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:21 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:4">इफिसियो 6:4</ref>
      </char>
    </note>हे पोर्‍यावावा, आपसा पोर्‍या क तंग नी करनो, नी होय कि ओको साहस टूट जाय।<verse eid="COL 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="COL 3:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:22 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:5-8">इफिसियो 6:5-8</ref>
      </char>
    </note>हे सेवको, जो डील लारे तुमरा भगवान छे, सब वात मा उनकी हुकुम क पालन करू, मानुस क खुश करनेवावा क समान देखाड़ने क लिय नी, पुन मन की सिधाई आरू यहोवा–भगवान क बीक राखे। <verse eid="COL 3:22"/><verse number="23" style="v" sid="COL 3:23"/>जो काही तुमू करता होय, तन मन छे करू, यो समझीन कि मानुस क करता नी पुन पोरबु क होय। <verse eid="COL 3:23"/><verse number="24" style="v" sid="COL 3:24"/>काहकि तुमू जानता होय कि तुमू इन क बदलने पोरबु छे मीरास मिवछे; तुमू पोरबु मसीह की सेवा करता होय। <verse eid="COL 3:24"/><verse number="25" style="v" sid="COL 3:25"/><note caller="+" style="x"><char style="xo" closed="false">3:25 </char><char style="xt" closed="false"><ref loc="EPH 6:9">इफिसियो 6:9</ref></char></note>काहकि जो अन्याय करता छे वो आपसी बुराई क फोव देखछे, वाहा काही क भेदभाव नी<verse eid="COL 3:25"/></para>
  <chapter eid="COL 3"/>
  <chapter number="4" style="c" sid="COL 4"/>
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:1 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:9">इफिसियो 6:9</ref>
      </char>
    </note>हे स्वामियो, आपने दास क साथे न्याय आरू वारू व्यवहार करू, यो समझीन कि सोरग मा वतुमरा भी एक भगवान छे।<verse eid="COL 4:1"/></para>
  <para style="s">काही व्यावहारिक सलाह</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2"/>प्रार्थना मा लागी रयो, आरू धन्यवाद क साथे उना मा जागृत रयो। <verse eid="COL 4:2"/><verse number="3" style="v" sid="COL 4:3"/>आरू ओका साथे ही साथे हामरे करता भी प्रार्थना करता रवु कि यहोवा–भगवान हामरे करता वचन सोमवावने क ओसो झोपलो उघाड़ दिदो, कि हामु मसीह क उना भेद क वर्णन कर सक्या ओका कारण हाव कैद मा छे। <verse eid="COL 4:3"/><verse number="4" style="v" sid="COL 4:4"/>आरू ओको ओसो प्रगट करू, जोसो मखे करने वारू छे।<verse eid="COL 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 4:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:5 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:16">इफिसियो 5:16</ref>
      </char>
    </note>मेखे क मोंगलो समझीन बाहरतावावा क साथे बुध्दिमान छे व्यवहार करू। <verse eid="COL 4:5"/><verse number="6" style="v" sid="COL 4:6"/>तुमरा वचन सदा फोकटन दया सहित आरू सलोना होय कि तुमूक हर मानुस क वारू रीति छे जवाब देनो आय जाय।<verse eid="COL 4:6"/></para>
  <para style="s">आखरी नमस्कार</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:7 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 20:4">प्रेरितन 20:4</ref>; <ref loc="2TI 4:12">2 तीमुथियुस 4:12</ref></char>
    </note>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:7 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:21">इफिसियो 6:21</ref>,<ref loc="EPH 6:22">22</ref></char>
    </note>मोंगावु भाईस आरू विश्वासयोग्य दास, तुखिकुस, जो पोरबु मा मारो सहकर्मी छे, मारी सब वात तुमूक कय दीस। <verse eid="COL 4:7"/><verse number="8" style="v" sid="COL 4:8"/>उको मा ने एरकरीन तुमरे साथे मुकल्या छे कि तुमू हामरी दशा मालम होय जाय आरू वो तुमरा दिल क शांती देय। <verse eid="COL 4:8"/><verse number="9" style="v" sid="COL 4:9"/><note caller="+" style="x"><char style="xo" closed="false">4:9 </char><char style="xt" closed="false"><ref loc="PHM 1:10-12">फिलेमोन 1:10-12</ref></char></note>ओको साथे हाव ने उनेसिमुस क भी मुकल्यो छे जो विश्वासयोग्य आरू मोंगावु भाईस तुमू ही मा छे; यो तुमू याहा की सारी वात कय देसे।<verse eid="COL 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="COL 4:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:10 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:29">प्रेरितन 19:29</ref>; <ref loc="ACT 27:2">27:2</ref>; <ref loc="PHM 1:24">फिलेमोन 1:24</ref> </char>
      <char style="xt" closed="false">
        <ref loc="ACT 12:12">प्रेरितन 12:12</ref>,<ref loc="ACT 12:25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref></char>
    </note>अरिस्तर्खुसक, जो मारे साथे कैदी छे, आरू मरकुस जो बरनबास क भाईस लागतो छे ओका विषय मा तुमू ने हुकुम देखी होती कि यदि वो तुमरे साथे आयो तो ओका सी वारली तरह व्यवहार करनो। <verse eid="COL 4:10"/><verse number="11" style="v" sid="COL 4:11"/>आरू ईशु जो यूस्तुस कोवायतो छे, तुमू नमस्कार कयता छे। खतना कर्‍या होया मानसे मा छे केवल यो ही यहोवा–भगवान क राज क करता मारो सहकर्मी आरू मारी शांती क कारण रया छे।<verse eid="COL 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 4:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">4:12 </char>
      <char style="xt" closed="false">
        <ref loc="COL 1:7">कुलुस्सियो 1:7</ref>; <ref loc="PHM 1:23">फिलेमोन 1:23</ref></char>
    </note>इपफ्रास, जो तुमू मा छे आरू मसीह ईशु क दास छे, तुमू नमस्कार कयता छे आरू सदा तुमरे करता प्रार्थना मा कोशिष करता छे, ताकि तुमू सिध्द हईन पूरो विश्वास क साथे यहोवा–भगवान की मरजी पर स्थिर रयो। <verse eid="COL 4:12"/><verse number="13" style="v" sid="COL 4:13"/>हाव ओको गवाय छे कि वो तुमरे करता आरू लौदीकिया आरू हियरापुलिसवावा क करता मोटो मेहनत करता रयता छे। <verse eid="COL 4:13"/><verse number="14" style="v" sid="COL 4:14"/><note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="2TI 4:11">2 तीमुथियुस 4:11</ref>; <ref loc="PHM 1:24">फिलेमोन 1:24</ref> </char><char style="xt" closed="false"><ref loc="2TI 4:10">2 तीमुथियुस 4:10</ref>; <ref loc="PHM 1:24">फिलेमोन 1:24</ref></char></note>मोंगावु वैद्य लूका आरू देमास क तुमू नमस्कार।<verse eid="COL 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 4:15"/>लौदीकिया ते निम्फा भाईस क, आरू न आरू ओको घर की मंडळी क नमस्कार कोवनो। <verse eid="COL 4:15"/><verse number="16" style="v" sid="COL 4:16"/>जव यो पत्री तुमरे याहा भन्न लेदा जाय तो ओसो करनो कि लौदीकिया की मंडळी मा भी भन्न जाय, आरू वो पत्री जो लौदीकिया छे आय ओको तुमू भी भन्नु। <verse eid="COL 4:16"/><verse number="17" style="v" sid="COL 4:17"/><note caller="+" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="PHM 1:2">फिलेमोन 1:2</ref></char></note>आरू अर्खिप्पुस छे कोवनो कि जो सेवा पोरबु मा तुखे सौंपी गयी छे, ओको सावधान क साथे पूरी करने।<verse eid="COL 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18"/>मखे पौलुस क आपने हात छे लिख्यो हुयो नमस्कार। मारी जंजीरो क स्मरण राखने।</para>
  <para style="p" vid="COL 4:18">तुमू पर फोकटन दया हुयसे रया। आमेन।<verse eid="COL 4:18"/></para>
  <chapter eid="COL 4"/>
</usx>
