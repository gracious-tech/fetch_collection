<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LUK" style="id">– Dhankavi</book>
  <para style="h">लूका</para>
  <para style="toc3">लूका</para>
  <para style="toc2">लूका</para>
  <para style="toc1">लूका नी किताब</para>
  <para style="mt2">लूका कि किताब</para>
  <para style="mt1">लूका नी किताब</para>
  <para style="imt">परिचय</para>
  <para style="ip">लूका रचीत खुश खबर नया नियम हाव कि उन चार पत्री ो मा सी एक है जीनाक ईशु क जीवन क वर्णन है हर एक किताब क “खुश खबर” कये है ईशु क मृत्यु क बाद मत्ती, मरकुस, लूका आरू यहुन्ना ने यह किताब लिखी लूका ने सिर्फ ईशु क जीवन कि कहानी ही नही लिखी बल्की, ओका मृत्यु क बाद ओका चेलो क कामो क बारा हाव भी लिखा। “प्रेरितन क काम नामक किताब हाव इन्दरे बारा हाव भणने क मिलता है।” लूका क खुश खबर कहा आरू लिखा गया ओका बारा हाव निश्चीत जानकारी नही है पुन जादातर ज्ञानवान यह मानते है कि लूका क खुश खबर ईशु क जनमक लग–भग सत्तर साल क बाद लिखा गया होगा</para>
  <para style="ip">इनीये किताब क लेखक खुद लूका छे, जो एक वैद्य हतु। ओका लिखने कि शैली आरू भाषा छे यह मालुम पड़तो छे, कि लूका एक सुशिक्षीत मानुस हतु। लूका चाहतु हतु कि ईशु क जीवन क सही वर्णन लिखलो जाए, आरू घटना जोसी होई ठिक तोसली लिखी जाए ताकी ओको बाराम हाव भणीन फायदा हुये <char style="xt"><ref loc="LUK 1:1-3">1:1-3</ref></char> लूका यहूदि नी हतु <char style="xt"><ref loc="COL 4:10-14">कुलुस्सियो 4:10-14</ref> </char>त्यो इनीये तरह छे लिखलो छे कि गैरयहुदी भी ओको लिखलो आसानी सी समज सके जोसो यहूदि रिती रीवाजो क बारा मा पुरावो देखाड़लो छे।</para>
  <para style="ip">काफी मात्रा हाव लूका क खुश खबर मत्ती आरू मरकुस कि किताब जोसो छे। तीनी किताब क हाव तीनी घटना न पुरावो एक सारको करलो छे। पुन लूका न किताब हाव बपतिस्मा करने वालो यहुन्ना क जनमक बारा हाव सबछे सवटो जानकारी जुड़ती छे। लूका “माफ क विषय हाव सबछे जादा लिखलो छे।” <char style="xt"><ref loc="LUK 3:3">3:3</ref></char> <char style="xt"><ref loc="LUK 11:4">11:4</ref></char> <char style="xt"><ref loc="LUK 17:3-4">17:3-4</ref></char> <char style="xt"><ref loc="LUK 23:34">23:34</ref></char> <char style="xt"><ref loc="LUK 24:47">24:47</ref></char> प्रार्थना क विषय हाव भी सबछे जादा लिखलो छे <char style="xt"><ref loc="LUK 3:21">3:21</ref></char> <char style="xt"><ref loc="LUK 5:16">5:16</ref></char> <char style="xt"><ref loc="LUK 6:12">6:12</ref></char> <char style="xt"><ref loc="LUK 17:1-12">17:1-12</ref></char> <char style="xt"><ref loc="LUK 22:32">22:32</ref></char></para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. लूका खुश खबर कि प्रस्ताव आरू लिखनेन क कारण कयता छे<char style="ior"><ref loc="LUK 1:1-4">1:1-4</ref></char></para>
  <para style="io1">2. ओकान बाद ईशु क जनम आरू सेवकाई क तयारी क विषय मा हाव लिखलो छे, <char style="ior"><ref loc="LUK 1:5-4:13">1:5–4:13</ref></char></para>
  <para style="io1">3. किताब क बाकी क मटलो भाग <char style="ior"><ref loc="LUK 4:14-21:38">4:14–21:38</ref></char> लूका ने ईशु क काम क बारा हाव खास करीन चमत्कार आरू सिखाड़ली वात क बारा हाव।</para>
  <para style="io1">4. किताब क आखरी तीन पाठ <char style="ior"><ref loc="LUK 22:24">22:24</ref></char> ईशु कि मृत्यु कि दफन क्रिया तथा पछु जी उठने क बारा हाव कयता छे।</para>
  <chapter number="1" style="c" sid="LUK 1"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1"/>घण सवटा उनी वात क जो हामरे वीच मा हुयली छे उको लिखने मा हाथ लगाड़िया। <verse eid="LUK 1:1"/><verse number="2" style="v" sid="LUK 1:2"/>जोसो कि त्या जो पेहले ही छे इन वात क देखने वावा आरू खुश खबर क सेवक हुतो, हामु तक पुचाड्या। <verse eid="LUK 1:2"/><verse number="3" style="v" sid="LUK 1:3"/>एरकरीन, मखे भी या हाथियुफिलुस वारू मालम हुया कि उन सब वात क सम्पूर्ण हाल शुरू छे ठीक–ठीक जांच करीन, तीनुक तारे करता एक एक लिखू <verse eid="LUK 1:3"/><verse number="4" style="v" sid="LUK 1:4"/>ताकि तु यो जानलीन कि वो वात जिनकी तुने शिक्षा देखी छे, कोसी अटल छे।<verse eid="LUK 1:4"/></para>
  <para style="s">यहुन्ना क जनम क बारा मा उजन्तो करनो</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5"/>यहूदि या क राजा हेरोदेस टेहाव अबिय्याह क दल मा जकर्‍याह नाव क एक पुजारा हुतो, आरू ओकी बायर हारून क वंश की होती जेरो नाव इलीशिबा हुता। <verse eid="LUK 1:5"/><verse number="6" style="v" sid="LUK 1:6"/>वो दुय यहोवा–भगवान क सामने न्यायी हुता, आरू पोरबु की सब हुकुम आरू विधियों पर निर्दोष चालनेवावा होतो। <verse eid="LUK 1:6"/><verse number="7" style="v" sid="LUK 1:7"/>ओको काही भी अवलियाद नी होती, काहकि इलीशिबा वांझी होती, आरू वो दुयू ढाहला हुता।<verse eid="LUK 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8"/>जव जकर्‍याह आपने दल की पारी पर यहोवा–भगवान क सामने पुजारा क काम करतो हुतो, <verse eid="LUK 1:8"/><verse number="9" style="v" sid="LUK 1:9"/>तो पुजारा की रीति क लारे ओको नाव पर चि़ठ्ठी निकवी कि पोरबु क मंदिर मा जाईन धुप लागाड़ ्य। <verse eid="LUK 1:9"/><verse number="10" style="v" sid="LUK 1:10"/>धुप लागाड़ ने क टेहाव मानसे की सारी मंडळी बारती प्रार्थना कर रयी होती।<verse eid="LUK 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11"/>उना टेहाव पोरबु क एक सोरगदूत धुप की वेदी की डासच्या आरू उबा हुया ओको देखाय दिया। <verse eid="LUK 1:11"/><verse number="12" style="v" sid="LUK 1:12"/>जकर्‍याह देखीन घाबराय आरू उना पर मोठा बीक भराय गय। <verse eid="LUK 1:12"/><verse number="13" style="v" sid="LUK 1:13"/>पुन सोरगदूत ने ओको कयो, “हे जकर्‍याह, भयभीत नी होय, काहकि तारी प्रार्थना सोमवी लेदी आरू तु गयी छे; आरू तारी बायर ओका इलीशिबा छे तारे करता एक पोर्‍य पैदा होयछे, आरू तु ओका नाव यहुन्ना मेकला। <verse eid="LUK 1:13"/><verse number="14" style="v" sid="LUK 1:14"/>तुखे खुशी आरू हर्ष होयछे; आरू घोणा मानसे ओका जनमक कारण खुश होयछे, <verse eid="LUK 1:14"/><verse number="15" style="v" sid="LUK 1:15"/>काहकि वाँ पोरबु क सामने महान होयछे; आरू अंगुर क रस आरू मंदिर कदी पीछे; आरू आपसी आप क कुख ही छे चुखलो आत्मा छे भरायला होय जाछे; <verse eid="LUK 1:15"/><verse number="16" style="v" sid="LUK 1:16"/>आरू इस्राएल मा सी घण सवटा क ओको पोरबु यहोवा–भगवान की आरू पछु। <verse eid="LUK 1:16"/><verse number="17" style="v" sid="LUK 1:17"/>वो एलियाह सारखो आत्मा आरू शक्ति मा होय कर ओको ओगव–ओगव चालसे कि पितरों क मन पोर्‍या–पारी की आरू फेर दे; आरू हुकुम नी मानने वावा क न्यायीयो की समझ पर लाया; आरू पोरबु क करता एक योग्य प्रजा तीयार कर्‍या।”<verse eid="LUK 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18"/>जकर्‍याह ने सोरगदूत छे पूछा, “यो हाव कोसो जानीस? काहकि हाव तो डावु छे; आरू मारी बायर भी डावी होय गयी छे।”<verse eid="LUK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19"/>सोरगदूत ने ओको जवाब दिया, “हाव जिब्राईल छे जो यहोवा–भगवान क सामने उबा रयता छे; आरू हाव तुखे छे वात करने आरू तुखे यो खुश खबर सोमवने क मुकल्या गया छे। <verse eid="LUK 1:19"/><verse number="20" style="v" sid="LUK 1:20"/>देख जिना दाहड़े तक यो वात पूरी नी होय, उना दाहड़े तक तु मन रयछे आरू बोल नी सकछे, एरकरीन कि तु मारी वात की जो आपने टेहाव पर पूरी होयछे, प्रतिति नी की।”<verse eid="LUK 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21"/>मानसे जकर्‍याह की वाट देखता रया आरू भोंगलाय गयो करने लाग्या कि उको मंदिर मा ओतरी वार काय लागी। <verse eid="LUK 1:21"/><verse number="22" style="v" sid="LUK 1:22"/>जव वो बाहरता आयो, तो उनछे बुल नी सक्यो: शेवली कावा वो जान गया कि त्यो मंदिर मा काही दर्शन देख्या छे; आरू वो उनछे संकेत करता रया, आरू गुंगो रया गयो।<verse eid="LUK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23"/>जव ओकी मंदिरक सेवा क दाहड़ो पूरो हुयो, तो वो आपने घर चाली गया। <verse eid="LUK 1:23"/><verse number="24" style="v" sid="LUK 1:24"/>इन दाहड़ा क बाद ओकी बायर इलीशिबा भारीस हयी; आरू पाच महना तक आपने आप क यो कय क डुकाड़ी राख्या, <verse eid="LUK 1:24"/><verse number="25" style="v" sid="LUK 1:25"/>“ची कोछे कि, मानुस मा मारो विजुत दूर करने क करता, पोरबुने इन दाहड़ा मा किरपा करीन मारे करता ओसो कर्‍या छे।”<verse eid="LUK 1:25"/></para>
  <para style="s">ईशु क जनमक बारा मा देखाड़नो</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26"/>इलीशिबाना छोव महना मा यहोवा–भगवान की आरू छे जिब्राईल सोरगदूत, गलील क नासरत नगर मा, <verse eid="LUK 1:26"/><verse number="27" style="v" sid="LUK 1:27"/><note caller="+" style="x"><char style="xo" closed="false">1:27 </char><char style="xt" closed="false"><ref loc="MAT 1:18">मत्ती 1:18</ref></char></note>एक छल्ली क साथे मुकल्या जेरी मांगनी यूसुफ नाव क दाऊद क घराने क एक मानुस छे होयी होती: उना छल्ली क नाव मरियम हुता। <verse eid="LUK 1:27"/><verse number="28" style="v" sid="LUK 1:28"/>सोरगदूत ने ओको साथे माही आवीन कयो, “मरीयम, खुशी आरू धन्य तारी होय जिना पर यहोवा–भगवान क फोकटन दया हुयो छे! पोरबु तारे साथे छे!”<verse eid="LUK 1:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29"/>वो उना वचन छे घोणा घाबराय गयी, आरू सुचीन लागी कि यो काय प्रकार नमस्कार छे? <verse eid="LUK 1:29"/><verse number="30" style="v" sid="LUK 1:30"/>सोरगदूत ने ओका सी कयो “हे मरियम, भयभीत नी होय, काहकि यहोवा–भगवान क फोकटन दया तुखे पर हुयो छे। <verse eid="LUK 1:30"/><verse number="31" style="v" sid="LUK 1:31"/><note caller="+" style="x"><char style="xo" closed="false">1:31 </char><char style="xt" closed="false"><ref loc="MAT 1:21">मत्ती 1:21</ref></char></note>देख, तु भारीस होयीस, आरू तारे एक पोर्‍या पैदा होयछे; तु ओका नाव ईशु राखने। <verse eid="LUK 1:31"/><verse number="32" style="v" sid="LUK 1:32"/>वो महान होयछे आरू यहोवा–भगवान क पोर्‍या कवायसे; आरू पोरबु यहोवा–भगवान ओको बास दाऊद क सिंहासन ओको देसे, <verse eid="LUK 1:32"/><verse number="33" style="v" sid="LUK 1:33"/>आरू वो याकूब क घराना पर सदा राज करसे; आरू ओको राज्य क आखरी नी होयछे।”<verse eid="LUK 1:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34"/>मरियम ने सोरगदूत छे कयो, “यो कोसो होयछे। हाव तो मानुस क जानती ही नी।”<verse eid="LUK 1:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35"/>सोरगदूत ने ओको जवाब दिया, “चुखलो आत्मा तुखे पर उतरसे, आरू यहोवा–भगवान जो शक्ति की तुखे पर आवती रयसे; चुखलो जो पैदा हुयने वालो छे, यहोवा–भगवान क पोर्‍या कवायसे। <verse eid="LUK 1:35"/><verse number="36" style="v" sid="LUK 1:36"/>आरू देख, तारी घराना माईन इलीशिबा क भी डाहला मा पोर्‍य होयनेवावो छे, यो ओको, जो वांझी कवायती होती छोव महना छे। <verse eid="LUK 1:36"/><verse number="37" style="v" sid="LUK 1:37"/>काहकि जो वचन यहोवा–भगवान की आरू छे हुता छे वो शक्ति नी हुता।”<verse eid="LUK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38"/>मरियम ने कयो, “पोरबु की दासी छे, मखे तारे वचन क लारे होय।” तव सोरगदूत ओको साथे चालीन गया।<verse eid="LUK 1:38"/></para>
  <para style="s">मरीयम अलीशिबा क भेवाय</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39"/>उन दाहड़ा मा मरियम उठीन शीघ्र ही दाहड़ी देश मा यहूदा क एक नगर गयी, <verse eid="LUK 1:39"/><verse number="40" style="v" sid="LUK 1:40"/>आरू जकर्‍याह क घर मा जाईन मरियम इलीशिबा क नमस्कार करी। <verse eid="LUK 1:40"/><verse number="41" style="v" sid="LUK 1:41"/>जोही इलीशिबाने मरियम क नमस्कार सोमव्या त्योही पोर्‍य ओको पेट मा उछळीयो आरू इलीशिबा चुखलो आत्मा छे भरायला होय गयी। <verse eid="LUK 1:41"/><verse number="42" style="v" sid="LUK 1:42"/>आरू त्यो मोटा ओवाज छे कयो, “तु बायर मा धन्य छे, आरू तारे पेट क पोर्‍य धन्य छे! <verse eid="LUK 1:42"/><verse number="43" style="v" sid="LUK 1:43"/>यो फोकटन दया मखे कयो छे हुया कि मारे पोरबु की माय साथे आवी? <verse eid="LUK 1:43"/><verse number="44" style="v" sid="LUK 1:44"/>ज्योंही तारे नमस्कार क ओवाज मारा कान्टा मा पड्यो, त्योंही पोर्‍य मा खुशी छे उछल पड्यो। <verse eid="LUK 1:44"/><verse number="45" style="v" sid="LUK 1:45"/>धन्य छे वो जो विश्वास कर्‍या कि जो वात पोरबु आरू छे ओका सी कर्‍या गयी, वो पुरी होयछे।”<verse eid="LUK 1:45"/></para>
  <para style="s">मरीयम क बढ़ाई गीत</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46"/>तव मरियम ने कयो, “मारो जीव पोरबु की बढ़ाई करता छे”<verse eid="LUK 1:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="LUK 1:47"/>आरू मारी आत्मा मारे उध्दार करनेवावा यहोवा–भगवान छे खुश होयी,<verse eid="LUK 1:47"/></para>
  <para style="q2">
    <verse number="48" style="v" sid="LUK 1:48"/>काहकि त्यो आपसी दासी की दीनता पर दृष्टि की छे;</para>
  <para style="q1" vid="LUK 1:48">एरकरीन देखु, हिमी छे आरामना दाहडो युग–युग क मानसे मखे धन्य कवसे,<verse eid="LUK 1:48"/></para>
  <para style="q2">
    <verse number="49" style="v" sid="LUK 1:49"/>काहकि उना शक्तिमान यहोवा–भगवानने मारे करता मोटा–मोटा काम कर्‍यो छे।</para>
  <para style="q1" vid="LUK 1:49">ओका नाव चुखलो छे,<verse eid="LUK 1:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50"/>आरू ओकी दया उन पर जो ओको सी बीक राखे, पीढी छे तक बनी रयता छे।</para>
  <para style="q2" vid="LUK 1:50">जो यहोवा भगवान न विजुत करीया त्यो उका पर दया करियो<verse eid="LUK 1:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51"/>त्यो आपसा भुजबल देखाड्या</para>
  <para style="q2" vid="LUK 1:51">जो आपने आप क मन मा डाहळाय करता हता, तिनुक तितर बितर कर्‍यो।<verse eid="LUK 1:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52"/>त्यो राजा उनको ओको सिंहासन छे पाड़ दिया;</para>
  <para style="q2" vid="LUK 1:52">आरू नम्र मानसे क उंचा कर्‍यो।<verse eid="LUK 1:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53"/>त्यो भुजला क वारली वात छे तुप्त कर्‍यो,</para>
  <para style="q2" vid="LUK 1:53">आरू धनवान क खाली हात निकावीन दिया।<verse eid="LUK 1:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54"/>त्यो आपने सेवक इस्राएल क सोमाव केदा की आपसी उना दया क स्मरण कर्‍यो,</para>
  <para style="q2" vid="LUK 1:54">आरू ओका दास इसरायल क मदत करियो।<verse eid="LUK 1:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55"/>“जव अब्राहम आरू ओका वंश पर सदा रवछे,</para>
  <para style="q2" vid="LUK 1:55">जोसो त्यो हामरा डाहडा सी कयलो हुतो।”<verse eid="LUK 1:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56"/>मरियम लग–भग तीन महना अलीशिबा क साथे रवीन आपने घर पछु गयी।<verse eid="LUK 1:56"/></para>
  <para style="s">यहुन्ना बपतिस्मा देनेवावा क जनम</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57"/>तव इलीशिबा क प्रसव क टेहाव पूरो हुयो, आरू त्यो पोर्‍या क जनम देदो। <verse eid="LUK 1:57"/><verse number="58" style="v" sid="LUK 1:58"/>ओका धड़ेवावा आरू घरानो ने यो सोमवीन कर कि पोरबुने उना पर मोटी दया करी छे, ओका साथे खुशी मनाया,<verse eid="LUK 1:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 1:59"/>आरू ओसो हुयो कि आठवा दाहड़ा मा वो पोर्‍या क खतना करने आये आरू ओको नाव ओका बास क नाव पर जकर्‍याह राखने लाग्या। <verse eid="LUK 1:59"/><verse number="60" style="v" sid="LUK 1:60"/>इनीये पर ओकी माय जवाब देदी, “नी; वरना ओको नाव यहुन्ना राख्य जाय।”<verse eid="LUK 1:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 1:61"/>त्या ओका सी कयो, “तारो घराना मा काही क यो नाव नी।” <verse eid="LUK 1:61"/><verse number="62" style="v" sid="LUK 1:62"/>तव त्या ओका बास छे संकेत करीन पुछ कि तु ओका नाव काय राखने जुवे छे?<verse eid="LUK 1:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 1:63"/>त्यो लिखने की पट्टी मांगीन लिख दिया, “ओका नाव यहुन्ना छे” आरू सभो क घबरायीन हुया। <verse eid="LUK 1:63"/><verse number="64" style="v" sid="LUK 1:64"/>तव ओको मुय आरू जीभ तत्काल उघड़ी गय; आरू वो बुलने आरू यहोवा–भगवान क धन्यवाद करने लाग्या। <verse eid="LUK 1:64"/><verse number="65" style="v" sid="LUK 1:65"/>ओका आस पास क सब रयनेवावा पर बीक भराय गय; आरू उन सब वात की चर्चा यहूदि या क सब बयड़ा देश मा फैल गयी, <verse eid="LUK 1:65"/><verse number="66" style="v" sid="LUK 1:66"/>आरू सब सोमवनेवावा ने आपने–आपने मन मा विचार करीन कयो, “यो पोर्‍या कोसो होयछे?” काहकि पोरबु क हात ओका साथ हुता।<verse eid="LUK 1:66"/></para>
  <para style="s">जकर्‍याह क बढ़ाई–गान</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67"/>ओका बास जकर्‍याह चुखलो आत्मा छे भरायला होय गया, आरू भविष्यव्दाणी करने लाग्या:<verse eid="LUK 1:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68"/>पोरबु इस्राएल क यहोवा–भगवान धन्य होय,</para>
  <para style="q2" vid="LUK 1:68">काहकि त्यो आपने मानसे पर दूष्टि करी आरू ओको छुटकारो छे,<verse eid="LUK 1:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69"/>आरू आपने सेवक दाऊद क घराना मा</para>
  <para style="q2" vid="LUK 1:69">हामरे करता एक उध्दार क सींग निकाव्या,<verse eid="LUK 1:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70"/>जोसो त्यो आपने चुखलो भविष्यवक्ता क द्वारा</para>
  <para style="q2" vid="LUK 1:70">जो जग क शुरू छे हुता आश छे कयो हुता,<verse eid="LUK 1:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71"/>मतलब आमरो दुस्मन छे,</para>
  <para style="q2" vid="LUK 1:71">आरू हामरा सब दुस्मन क हात छे आमरो उध्दार कर्‍यो छे,<verse eid="LUK 1:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72"/>कि हामरा बाबदादा पर दया करीन आपसी</para>
  <para style="q2" vid="LUK 1:72">चुखलो वाचा क स्मरण कर्‍यो,<verse eid="LUK 1:72"/></para>
  <para style="q1">
    <verse number="73" style="v" sid="LUK 1:73"/>आरू वो शपथ जो त्यो</para>
  <para style="q2" vid="LUK 1:73">हामरा बास अब्राहम छे खाय होती,<verse eid="LUK 1:73"/></para>
  <para style="q1">
    <verse number="74" style="v" sid="LUK 1:74"/>कि वो हामु यो देसे</para>
  <para style="q2" vid="LUK 1:74">कि हामु आपने दुस्मन क हात छे छुड़ीन,<verse eid="LUK 1:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="LUK 1:75"/>ओका सामने चुखला आरू न्यायपन छे</para>
  <para style="q2" vid="LUK 1:75">जीवन भर निडर रहकर ओकी सेवा करता रया।<verse eid="LUK 1:75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76"/>आरू तु हे पोर्‍या परमप्रधान क भविष्यवक्ता कवायसे,</para>
  <para style="q2" vid="LUK 1:76">काहकि तु पोरबु क मार्ग तीयार करने क करता ओका ओगव–ओगव चालसे,<verse eid="LUK 1:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77"/>कि ओका मानसे क उध्दार क न्याय देय,</para>
  <para style="q2" vid="LUK 1:77">जो ओको पाप की माफ छे हासिल हुयसे छे।<verse eid="LUK 1:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78"/>यो हामरा यहोवा–भगवान की तीनी मोटी दया छे होयछे;</para>
  <para style="q2" vid="LUK 1:78">ओका कारण उपर छे हामु पर भोर क प्रकाश उग होयछे,<verse eid="LUK 1:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79"/>कि आंधारो मरन की सावला मा बोटनेवावा क ज्योति देय,</para>
  <para style="q2" vid="LUK 1:79">“आरू हामरे पाय क कुशल क मार्ग मा सीधा चालाड़से।”<verse eid="LUK 1:79"/></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80"/>आरू वो नानलो ईशु बढ़तो गयो आरू आत्मा मा ताकद वावो हुयता गयो। आरू वा इस्राएल पर प्रगट हुयने क दाहड़े तक वस्तीमा रया।<verse eid="LUK 1:80"/></para>
  <chapter eid="LUK 1"/>
  <chapter number="2" style="c" sid="LUK 2"/>
  <para style="s">ईशु क जनम</para>
  <para style="r">(<ref loc="MAT 1:18-25">मत्ती 1:18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1"/>उन दाहड़ा मा औगुस्तुस कैसर की तरफ छे हुकुम निकावी कि सब रोम साम्राज्य धरती क मानसे क नाव लिख्या जाय। <verse eid="LUK 2:1"/><verse number="2" style="v" sid="LUK 2:2"/>याहा पेहली नाव लिखिन उना टेहाव हुयो, जव क्विरिनियुस सीरिया क सरदार हुता। <verse eid="LUK 2:2"/><verse number="3" style="v" sid="LUK 2:3"/>सब मानसे नाव लिखवाने क करता नगर क गया।<verse eid="LUK 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4"/>शेवली कावा यूसुफ भी एरकरीन कि वाँ दाऊद क घरानो आरू वंश क हुता गलील क नासरत नगर छे यहूदि या मा दाऊद क नगर बैतलहम क गया, <verse eid="LUK 2:4"/><verse number="5" style="v" sid="LUK 2:5"/>कि आपसी मंगेतर मरियम क साथे जो भारपाय होती नाव लिखायछे। <verse eid="LUK 2:5"/><verse number="6" style="v" sid="LUK 2:6"/>ओको वाँ रयता हुया ओका पोखडायने क दाहड़ा पूरा होया, <verse eid="LUK 2:6"/><verse number="7" style="v" sid="LUK 2:7"/>आरू वाँ आपसा पहिलौठा पोर्‍यो पोखड़ाय आरू ओको लुगड़ा मा लेपटीन चरनी मा राख्या काहकि ओको करता सराय मा जगहनी होती।<verse eid="LUK 2:7"/></para>
  <para style="s">सोरगदूतदुत क गुवाळिया क संदेश</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8"/>आरू ओका देश मा कोतरा गाडरा गुवाळिया हुता जो रात क मैदान मा रयन आपने टुळान क गुळावी कोरता हुता। <verse eid="LUK 2:8"/><verse number="9" style="v" sid="LUK 2:9"/>तव यहोवा–भगवान क सोरगदूत ओको साथे आश उबा हुया, आरू पोरबु क तेज ओको चार आरू चमका, आरू वो घोणा बीह गया। <verse eid="LUK 2:9"/><verse number="10" style="v" sid="LUK 2:10"/>तव सोरगदूतने उनछे कयो, “मा घाबराय; काहकि हाव तुमूक मोट खुशी क खुश खबर सोमवाय छे जो सब मानसे क करता होयछे, <verse eid="LUK 2:10"/><verse number="11" style="v" sid="LUK 2:11"/>ती ही कि आज दाऊद क नगर तुमरे करता उध्दार र्कोन्यू जन्माम छे योही मसीह पोरबु छे। <verse eid="LUK 2:11"/><verse number="12" style="v" sid="LUK 2:12"/>आरू इनाक तुमरे करता याहा निशानी छे कि तुमू पोर्‍या क लुगड़ा मा लेपटीन हुया आरू चरनी मा पड्यो देखछे।”<verse eid="LUK 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13"/>तव एकदम ओको सोरगदूत क दल यहोवा–भगवान की बढ़ाई करता हुया आरू याहा कयता देखाय दिया,<verse eid="LUK 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14"/>“आकाश मा यहोवा–भगवान की महिमा</para>
  <para style="q2" vid="LUK 2:14">आरू धरती पर उन मानस मा जिनछे वाँ खुश छे, शांती होय।”<verse eid="LUK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15"/>जव सोरगदूत ओको साथे छे सोरगदूत मा चाली गया, तो गुवाळ्यु आपस मा कयो, “आवु हामु बैतलहम जाईन यो वात जो होयी छे, आरू जिनाक पोरबुने हामु देखाड्या छे, देखछे।”<verse eid="LUK 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16"/>आरू त्या छाटात जाईन मरियम आरू यूसुफ क, आरू चरनी मा ओका पोर्‍या क सोने देख्या। <verse eid="LUK 2:16"/><verse number="17" style="v" sid="LUK 2:17"/>इनुक देखीन गुवाळिया वो वात जो पोर्‍या क विषय मा ओको काही गयी होती, प्रगट करी, <verse eid="LUK 2:17"/><verse number="18" style="v" sid="LUK 2:18"/>आरू सब सोमवने वावा उन वात छे जो गुवाळिया उनछे देवदुत क कयी घबरायीन कर्‍या। <verse eid="LUK 2:18"/><verse number="19" style="v" sid="LUK 2:19"/>पुन मरियम यो सब वात आपने मन मा राखीन मन मा सुचती रयी। <verse eid="LUK 2:19"/><verse number="20" style="v" sid="LUK 2:20"/>आरू सोरग ने गुवाळ्यु जोसो उनछे कयो गया हुता, जोसो ही सब सोमवीन आरू देखीन यहोवा–भगवान की महिमा आरू बढ़ाई करता हुया पोछा पछु गया।<verse eid="LUK 2:20"/></para>
  <para style="s">ईशु क नावकरण</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:21 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 1:31">लूका 1:31</ref>
      </char>
    </note>जव आगठा दाहड़ा पुरा होय आरू ओका खतने क टेहाव आयो, तो ओका नाव ईशु राख्य गयो जो सोरगदूतने ओका पेट मा आवने छे पेहल कयो हुता।<verse eid="LUK 2:21"/></para>
  <para style="s">मंदिर मा ईशु क अर्पण</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 2:22"/>जव मूसा की व्यवस्था क लारे यूसुफ आरू मरीयम क चुखो हुयने क दाहड़ा पुरा हुया, तो वो ओको यरूशलेम मा ली गया की पोरबु क ओगव लाया, <verse eid="LUK 2:22"/><verse number="23" style="v" sid="LUK 2:23"/>जोसो कि पोरबु की व्यवस्था मा लिख्यो छे: “हर एक पहिलौठा चुखलो पोर्‍या पोरबु क करता निवाडीयो ठरछे।” <verse eid="LUK 2:23"/><verse number="24" style="v" sid="LUK 2:24"/>आरू पोरबु की व्यवस्था क वचन क लारे चे: “पंडुको क एक जुड़ो या पेरवा क दुय पीला” लावीन बलिदान कर्‍या।<verse eid="LUK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25"/>यरूशलेम मा शमौन नावको एक मानुस न्यायी आरू भक्त हुतो; आरू इस्राएल की वाचाड़ने वावा की वाट जुवे रया हुता, आरू चुखलो आत्मा ओको पर होती। <verse eid="LUK 2:25"/><verse number="26" style="v" sid="LUK 2:26"/>आरू चुखलो आत्मा द्वारा ओको पर प्रगट हुयो हुतो कि जव तक वो पोरबु क मसीह क देख नी लेछे, तव तक मरन क नी देखछे। <verse eid="LUK 2:26"/><verse number="27" style="v" sid="LUK 2:27"/>शमौन चुखलो आत्मा क सिखाड़ने छे मंदिर मा आश; आरू जव माय बास उना पोर्‍या ईशु क माहीय लावीन, कि ओका करता व्यवस्था कि रीति क लारे कर्‍या, <verse eid="LUK 2:27"/><verse number="28" style="v" sid="LUK 2:28"/>शमौन त्यो ओको आपसा खुवामा लेदु आरू यहोवा–भगवान धन्यवाद करीन कयो:<verse eid="LUK 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29"/>“हे भगवान, हिमी तु आपने दास क</para>
  <para style="q2" vid="LUK 2:29">वचन क लारे शांती छे मरना दे,<verse eid="LUK 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30"/>काहकि मारा डुवा क तारे उध्दार क देख लेदा छे,<verse eid="LUK 2:30"/></para>
  <para style="q2">
    <verse number="31" style="v" sid="LUK 2:31"/>जिनाक तुने सब देश क मानसे क सामने तीयार कर्‍या छे।<verse eid="LUK 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32"/>कि वो गैरयहुदी क प्रकाश देने क करता दिया</para>
  <para style="q2" vid="LUK 2:32">आरू तारे निज मानसे इस्राएल कि महिमा होय।”<verse eid="LUK 2:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33"/>ओको बास आरू ओकी माय इन वात छे जो ओको विषय मा शमौन ने कयी जाती होती, घबरायीन करता हुता। <verse eid="LUK 2:33"/><verse number="34" style="v" sid="LUK 2:34"/>तव शमौनने उनको बरकत दियो, ओकी माय मरियम छे कयो, वो तो इस्राएल मा घोणा क पड़ने, आरू उठने क करता, आरू एक ओसो सहलानी हुयने क करता ठेराया गया छे, ओका विरोध मा वात करी जाछे <verse eid="LUK 2:34"/><verse number="35" style="v" sid="LUK 2:35"/>“वरना तारो जीव भी तलवार छे वार पार चिर जाछे इनासे घोणा हद्यो क विचार प्रगट होयछे।”<verse eid="LUK 2:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36"/>आशेर क अवळियाद मा छे हन्नह नावको फनूएल की पोराय एक भविष्यव्दक्तिन होती। वो घोणा डाहली होती आरू वियाव सात सालबाद ओको घरवाळा मर गयो। <verse eid="LUK 2:36"/><verse number="37" style="v" sid="LUK 2:37"/>वो चारविसु ने चार साल छे रंडायली होती: आरू मंदिर क नी छुड़ती होती, पर उपवास आरू प्रार्थना कर करीन रात दाहडु उपवास कर्‍या करती होती। <verse eid="LUK 2:37"/><verse number="38" style="v" sid="LUK 2:38"/>आरू वो उना घड़ी वाँ आवीन पोरबु क धन्यवाद करने लागी, आरू उन सभो छे, जो मानसे यरूशलेम क छुटकारो की वाट जुवता हुता, उना पोर्‍या क विषय मा वात करने लागी।<verse eid="LUK 2:38"/></para>
  <para style="s">नासरत क पछो पुगनेन</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:39 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 2:23">मत्ती 2:23</ref>
      </char>
    </note>जव वो पोरबु की व्यवस्था क लारे सब काय पुरा कर त्योक्या तो गलील मा आपने नगर नासरत क पोछा पुगीन चाली गया। <verse eid="LUK 2:39"/><verse number="40" style="v" sid="LUK 2:40"/>आरू नानलो ईशु मोटो होय गयो, आरू बलवन्त होयतो आरू बुध्दि छे भरायला होयतो गयो; आरू यहोवा–भगवान क दया ओको पर हती।<verse eid="LUK 2:40"/></para>
  <para style="s">ईशु मंदिर मा</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41"/>ओकी माय बास हर साल फसह क पर्व मा यरूशलेम करता हुता। <verse eid="LUK 2:41"/><verse number="42" style="v" sid="LUK 2:42"/>जव ईशु बारा साल क हुयो, तो वो पर्व की रीति क लारे यरूशलेम क गयो। <verse eid="LUK 2:42"/><verse number="43" style="v" sid="LUK 2:43"/>जव वो उन दाहड़ा क पुरा करीन पुगनेन लाग्या, तो पोर्‍या ईशु यरूशलेम मा रया गया; आरू यो ओकी माय बास नी जानता हुता। <verse eid="LUK 2:43"/><verse number="44" style="v" sid="LUK 2:44"/>वो यो समझीन कि वो दिसरा यात्रियो क साथे होयछे, एक दाहड़ क पड़ाव निकाव गया: आरू ओको आपने घराना आरू जान पेहचान वावा मा हेरने लाग्या। <verse eid="LUK 2:44"/><verse number="45" style="v" sid="LUK 2:45"/>पर जव नी जुड़यो तो हेरता यरूशलेम क पछव पछु गया, <verse eid="LUK 2:45"/><verse number="46" style="v" sid="LUK 2:46"/>आरू तीन दाहड़ा क बाद त्या ओको मंदिर मा शिक्षा क वीच मा बठीन, उनकी सोमवता आरू उनछे सवाल करतलो हुयो देख्या। <verse eid="LUK 2:46"/><verse number="47" style="v" sid="LUK 2:47"/>जोतरा ओकी सोमवीन रया हुता वो सब ओकी समझ आरू ओका जवाब छे चकित हुता। <verse eid="LUK 2:47"/><verse number="48" style="v" sid="LUK 2:48"/>“तव वो ओको देखीन चकित हुया आरू ओकी माय हामु छे काय ओसो व्यवहार कर्‍या? पोर्‍या, तारो बास आरू हाव कुरकुर करता जाईन तुखे हेरता हुता?” <figure style="fig" alt="Temple in Jerusalem" file="lb00250c।tif" size="span" copy="Horace Knowles ©" ref="2:41">यरूशलेम मा मंदिर</figure><verse eid="LUK 2:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49"/>त्यो उनछे कयो, “तु मखे काय हेरता हुता कि मखे आपसा बास क भवन मा हुयने पाको छे?” <verse eid="LUK 2:49"/><verse number="50" style="v" sid="LUK 2:50"/>पुन जो वात त्यो कयी, त्या ओको नी समझी।<verse eid="LUK 2:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51"/>तव वो ओको साथे गया, आरू नासरत मा आश, आरू ओको वंश मा रया; आरू ओकी माय यो सब वात आपसा मन राखी। <verse eid="LUK 2:51"/><verse number="52" style="v" sid="LUK 2:52"/>आरू ईशु बुध्दि आरू डील–डौल मा, आरू यहोवा–भगवान आरू मानसे क दया मा बढ़ता गयो।<verse eid="LUK 2:52"/></para>
  <chapter eid="LUK 2"/>
  <chapter number="3" style="c" sid="LUK 3"/>
  <para style="s">यहुन्ना बपतिस्मा देनेवावा क संदेश</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1"/>तिबिरियुस कैसर क राज्य क पंदरा साल मा जव पुन्तियुस पिलातुस यहूदि या क सरदार हुत, आरू गलील मा हेरोदेस, इतुरैया आरू त्रखोनीतिस मा ओका भाई स फिलिप्पुस, आरू अबिलेने मा लिसानियास, चौथाई क राजा हुता, <verse eid="LUK 3:1"/><verse number="2" style="v" sid="LUK 3:2"/>आरू जव हन्न आरू कैफा डाहला पुजारा हुतो, उना टेहाव यहोवा–भगवान क वचन जंगल मा जकर्‍याह क पोर्‍या यहुन्ना क साथे पुच्चा। <verse eid="LUK 3:2"/><verse number="3" style="v" sid="LUK 3:3"/>यहुन्ना बपतिस्मा देनेवालो यरदन नदी क साथे क सब जंगल मा जाईन, पाप माफ क करता मन फिरावने क बपतिस्मा लेदा, आरू यहोवा–भगवान तुमरा पापको माफ करे क खबर करने लाग्या।<verse eid="LUK 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 3:4"/>जोसो यशायाह कागळियान क कयो हुयो वचन की किताब मा लिख्यो छे:</para>
  <para style="q1" vid="LUK 3:4">“जंगल मा एक आयड़ने वावा क ओवाज होय रया छे कि,</para>
  <para style="q2" vid="LUK 3:4">पोरबु क मार्ग तीयार करो</para>
  <para style="q2" vid="LUK 3:4">ओकी सड़के सुधी बनावु।”<verse eid="LUK 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5"/>हर एक घाटी भर देय जाछे,</para>
  <para style="q2" vid="LUK 3:5">आरू हर एक बयड़ा आरू टीला नेचा कर्‍या जाछे;</para>
  <para style="q1" vid="LUK 3:5">आरू जो वाकड़ी वाट छे सुधी,</para>
  <para style="q2" vid="LUK 3:5">आरू जो उचो नेचो छे वो चौरस मार्ग बनावछे।<verse eid="LUK 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6"/>“आरू हर मानवप्राणी यहोवा–भगवान क उध्दार क देखछे।”<verse eid="LUK 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:7 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:34">मत्ती 12:34</ref>; <ref loc="MAT 23:33">23:33</ref></char>
    </note>जो गर्दी की गर्दी ओका सी बपतिस्मा लेने करता आपने साथे निकव कर आवती होती, उनछे वो कयता हुता, “हे घड़साक पोर्‍या, तुखे कुण चेतावनी दिया कि आवनेवाळा रीस छे ढाछे। <verse eid="LUK 3:7"/><verse number="8" style="v" sid="LUK 3:8"/><note caller="+" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="JHN 8:33">यहुन्ना 8:33</ref></char></note>शेवली कावा मन फिराव क योग्य वारू करो, आरू मन मा याहा नी सुचिया कि आमरो बास अब्राहम छे; काहकि हाव तुमू छे कयता छे कि यहोवा–भगवान इनु दगड़ा सी अब्राहम क करता संतान पैदा कर सकता छे। <verse eid="LUK 3:8"/><verse number="9" style="v" sid="LUK 3:9"/><note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="MAT 7:19">मत्ती 7:19</ref></char></note>हिमी कुराड़ झाड़को की मुव पर धरा छे, एरकरीन जो झाड़को वारू फोव नी लायो, त्यो काट्यो आरू आगठो मा न्हाख दियो जासे?”<verse eid="LUK 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10"/>तव मानछेने ओका सी पुछ्या, “तो हामु काय करजे?”<verse eid="LUK 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11"/>त्यो तीनुक जवाब दिया, “ओका साथे दुय सुटर होय, वो ओको साथे ओका साथे नी छे वाट लेय आरू ओका साथे रोटा होय वो भी ओसो ही कर्‍या।”<verse eid="LUK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:12 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 7:29">लूका 7:29</ref>
      </char>
    </note>“फाळो लेनेवाळा भी बपतिस्मा लेने आश, आरू ओका सी पुछ्या, हे गुरू हामु काय करजे?”<verse eid="LUK 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13"/>त्यो उनछे कयो, “जो तुमरे करता ठेराया गया छे, ओको छे सवटो नी लेने।”<verse eid="LUK 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 3:14"/>“सिपाईने भी ओका सी यो पुछ्या, हामु काय करजे?”</para>
  <para style="p" vid="LUK 3:14">त्यो उनछे कयो, “काही पर झगड़ो करावनो नी करने आरू नी झुट दोष लागाड़ ने, आपने पगार पर खुस करने।”<verse eid="LUK 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15"/>जव मानसे आस लागाड़या हुया हुता, आरू सब आपसा मन यहुन्ना क विषय मा विचार कर रया हुता, कि काय युत मसीह तो नी छे, <verse eid="LUK 3:15"/><verse number="16" style="v" sid="LUK 3:16"/>तो यहुन्ना बपतिस्मा देनेवावो उन सब छे कयो, “हाव तो तुमूक पानी छे बपतिस्मा देतो छे, पुन वो आवनेवाळा छे जो मखे छे शक्तिमान छे; हाव तो इनीये योग्य भी नी कि ओका खासड़ा क दुरू छुड़ सको; वो तुमूक चुखली आत्मा छे बपतिस्मा देसे। <verse eid="LUK 3:16"/><verse number="17" style="v" sid="LUK 3:17"/>ओको सूप, ओका हात मा छे; आरू वो आपने खलिहान वारली तरह छे साफ करसे; आरू गवे क आपने कुठार मा एखठा करसे; पुन भुसा क उना आगठो मा जो बुझने की नी धोप छे।”<verse eid="LUK 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 3:18"/>शेवली कावा वो घोणा सी शिक्षा दे दीन मानसे क खुश खबर सोमवता रया। <verse eid="LUK 3:18"/><verse number="19" style="v" sid="LUK 3:19"/><note caller="+" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="MAT 14:3">मत्ती 14:3</ref>,<ref loc="MAT 14:4">4</ref>; <ref loc="MRK 6:17">मरकुस 6:17</ref>,<ref loc="MRK 6:18">18</ref></char></note>पुन जव त्यो चौथाई देश क राजा हेरोदेस क ओको भाईस फिलिप्पुस की बायर हेरोदेस क विषय आरू सब भुण्डला काम क विषय मा जो त्यो कर्‍या हुता, उलाहना दिया, <verse eid="LUK 3:19"/><verse number="20" style="v" sid="LUK 3:20"/>तो हेरोदेसने उन सब छे बठीन यो कुकर्म भी कर्‍या कि यहुन्ना क जेल मा नाख दिया।<verse eid="LUK 3:20"/></para>
  <para style="s">ईशु क बपतिस्मा</para>
  <para style="r">(<ref loc="MAT 3:13-17">मत्ती 3:13-17</ref>; <ref loc="MRK 1:9-11">मरकुस 1:9-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21"/>जव सब मानछेने बपतिस्मा लेदा आरू ईशु भी बपतिस्मा लीन प्रार्थना कर रयो हुतो, तो सोरग उघड़ी गया, <verse eid="LUK 3:21"/><verse number="22" style="v" sid="LUK 3:22"/><note caller="+" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="MAT 3:17">मत्ती 3:17</ref>; <ref loc="MRK 1:11">मरकुस 1:11</ref>; <ref loc="LUK 9:35">लूका 9:35</ref></char></note>“आरू चुखलो आत्मा डीलोन रूप मा पेरवाक समान उना पर उतरियो, आरू यो सोरगवाणी होयी: तु मारो मोंगावु पोर्‍यो छे, हाव खुश छे।”<verse eid="LUK 3:22"/></para>
  <para style="s">ईशु कि वंशावड़ी</para>
  <para style="r">(<ref loc="MAT 1:1-17">मत्ती 1:1-17</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23"/>जव ईशु आप शिक्षा करने लाग्या, तो लग—भग डेढ़वीस साल की साल क हुतो आरू (जोसो समझा जातो हुतो) यूसुफ क पोर्‍या हुतो; आरू वो एली क, <verse eid="LUK 3:23"/><verse number="24" style="v" sid="LUK 3:24"/>आरू वो मत्ताथा क, आरू वो लेवी क, आरू वो मलकी क, आरू वो यन्ना क, आरू वो यूसुफ क, <verse eid="LUK 3:24"/><verse number="25" style="v" sid="LUK 3:25"/>आरू वो मत्तित्याह क आरू वो आमोस क, आरू वो नहूम क, आरू त्यो असलीया क, आरू वो नोगह क, <verse eid="LUK 3:25"/><verse number="26" style="v" sid="LUK 3:26"/>आरू वो मात क, आरू वो मत्तित्याह क आरू वो आरू शिमी क, आरू वो योसेस क, आरू वो योदाह क, <verse eid="LUK 3:26"/><verse number="27" style="v" sid="LUK 3:27"/>आरू वो यहुन्ना क, आरू वो रेसा क, आरू वो जरूब्बाबेल क, आरू वो शालतियेल क, आरू वो नेरी क, <verse eid="LUK 3:27"/><verse number="28" style="v" sid="LUK 3:28"/>आरू वो मलकी क, आरू वो अद्दी क, आरू वो कोसाम क, आरू वो इलमोदाम क, आरू वो एर क, <verse eid="LUK 3:28"/><verse number="29" style="v" sid="LUK 3:29"/>आरू वो ईशु क, आरू वो इलजार क, आरू वो योरीम क, आरू मत्ताथा क, आरू वो लेवी क, <verse eid="LUK 3:29"/><verse number="30" style="v" sid="LUK 3:30"/>आरू वो शमौन क, आरू वो यहूदा क, आरू वो यूसुफ क आरू वो योनान क आरू वो एलयाकीम क, <verse eid="LUK 3:30"/><verse number="31" style="v" sid="LUK 3:31"/>आरू वो मेलिया क आरू वो मिन्नाह क, आरू वो मत्ताथा क, आरू वो नातान क, आरू वो दाऊद क, <verse eid="LUK 3:31"/><verse number="32" style="v" sid="LUK 3:32"/>आरू वो यिशै क आरू वो ओबेद क, आरू वो बोआज क, आरू वो सलमोन क, आरू वो नहशोन क, <verse eid="LUK 3:32"/><verse number="33" style="v" sid="LUK 3:33"/>आरू वो अम्मीनादाब क, आरू वो अरनी क, आरू वो हिस्रोन क, आरू वो पेरेस क आरू वो यहूदा क, <verse eid="LUK 3:33"/><verse number="34" style="v" sid="LUK 3:34"/>आरू वो याकूब क, आरू वो इसहाक क, आरू वो अब्राहम क, आरू वो तिरह क आरू वो नाहोर क, <verse eid="LUK 3:34"/><verse number="35" style="v" sid="LUK 3:35"/>आरू वो सरूग क, आरू वो रऊ क, आरू वो फिलिग क, आरू वो एबिर क आरू वो शिलह क, <verse eid="LUK 3:35"/><verse number="36" style="v" sid="LUK 3:36"/>आरू वो केनान क आरू वो अरफशद क, आरू वो शेम क, आरू वो नूह क, आरू वा लामेख लेमेक‍ क, <verse eid="LUK 3:36"/><verse number="37" style="v" sid="LUK 3:37"/>आरू वो मथूशिलह क आरू वो हनोक क, आरू वो यारेत क, आरू वो महललेल क, आरू वो केनान क <verse eid="LUK 3:37"/><verse number="38" style="v" sid="LUK 3:38"/>आरू वो एनोश क, आरू वो शेत क, आरू वो आदम क, आरू वो यहोवा–भगवान क, पोर्‍या हुतो।<verse eid="LUK 3:38"/></para>
  <chapter eid="LUK 3"/>
  <chapter number="4" style="c" sid="LUK 4"/>
  <para style="s">ईशु की परीक्षा</para>
  <para style="r">(<ref loc="MAT 4:1-11">मत्ती 4:1-11</ref>; <ref loc="MRK 1:12-13">मरकुस 1:12-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1"/>पछु ईशु चुखलो आत्मा छे भर्‍या हुयो, यरदन छे पुगीन; आरू चावीस दाहड़ा तक आत्मा क सिखाड़ने छे जंगल मा पुगता रया; <verse eid="LUK 4:1"/><verse number="2" style="v" sid="LUK 4:2"/>आरू शैतान परीक्षा करतो रयो। उन दाहड़ा मा त्यो काय नी खाय, आरू जव वो दाहड़ा पुरा होय गया तो ओको भुख लागी।<verse eid="LUK 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3"/>तव शैतानने ओका सी कयो, “यदि तु यहोवा–भगवान क पोर्‍या छे, तो इनीये दगड़ा छे कय, कि रोटा बन जाय।”<verse eid="LUK 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4"/>ईशु ओको जवाब दिया, “लिख्यो छे: मानुस केवल रोटा छे जीवतो नी रवछे।”<verse eid="LUK 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5"/>तव शैतान ओको उचा बयड़ा पर ली गयो आरू ओको पल भर मा जगत क सब राज्य देखाड्या, <verse eid="LUK 4:5"/><verse number="6" style="v" sid="LUK 4:6"/>आरू शैतान ओका सी कयो, “हाव यो सब हक, आरू इन्दरो वैभव तुखे आपीस, काहकि वो मखे सौप्य गयो छे: आरू जिनाक जुवता छे तीनी क दी देता छे। <verse eid="LUK 4:6"/><verse number="7" style="v" sid="LUK 4:7"/>एरकरीन यदि तु मखे भक्ती करे, तो यो सब तारे होय जाछे।”<verse eid="LUK 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8"/>ईशु ओका जवाब दिया, है शैतान दूर होय जा, “लिख्यो छे: ‘तु पोरबु आपसा यहोवा–भगवान क भक्ती कर; आरू केवल तीनान भक्ति कर।’”<verse eid="LUK 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9"/>तव त्यो ओको यरूशलेम मा ली जाईन मंदिर क कातर पर उबो कर्‍यो, आरू ओका सी कयो, “यदि तु यहोवा–भगवान क पोर्‍या छे, तो आपने आप क याहा छे नेचो कूद जा। <verse eid="LUK 4:9"/><verse number="10" style="v" sid="LUK 4:10"/>काहकि शास्त्रमा लिख्यो छे: ‘वो तारे विषय मा आपने सोरगदूत क हुकुम देसे, कि वो तारी रक्षा करे।’ <verse eid="LUK 4:10"/><verse number="11" style="v" sid="LUK 4:11"/>आरू ओसो ही कयो छे ‘वो तुखे हात उठाय लेछे, ओसो नी होय कि तारे पाय मा दगड़ा छे ठेस लागे।’”<verse eid="LUK 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12"/>ईशु ओको जवाब दिया, “यो भी कयो गया छे: तु पोरबु तारा यहोवा–भगवान की परीक्षा नी करने।”<verse eid="LUK 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13"/>जव शैतान सब परीक्षा कर चुक्यो, तव काय टेहाव क करता ओको साथे जात रयी।<verse eid="LUK 4:13"/></para>
  <para style="s">ईशु गालील मा ओका सेवा काम सुरू कर्‍यो</para>
  <para style="r">(<ref loc="MAT 13:53-58">मत्ती 13:53-58</ref>; <ref loc="MRK 6:1-6">मरकुस 6:1-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14"/>पछु ईशु आत्मा की शक्ति छे भराय हुयो गलील मा आवीन आरू ओकी परचार आस पास क सब देश मा फैल गई। <verse eid="LUK 4:14"/><verse number="15" style="v" sid="LUK 4:15"/>वो ओको सभागृह मा शिक्षा करता रया, आरू सब ओकी बढ़ाई करता हुता।<verse eid="LUK 4:15"/></para>
  <para style="s">नासरत मा ईशु क विजुत नी करनो</para>
  <para style="r">(<ref loc="MAT 13:53-58">मत्ती 13:53-58</ref>; <ref loc="MRK 6:1-6">मरकुस 6:1-6</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16"/>पछु वो नासरत मा आश, वा पावीन पुछा गयो हुतो; आरू आपसी रीति क लारे आरामन दाहडो क दाहड़े आराधना घर मा जाईन भन्ने क करता उबा हुयो। <verse eid="LUK 4:16"/><verse number="17" style="v" sid="LUK 4:17"/>यशायाह भविष्यवक्ता की किताब ओको दी गयी, आरू त्यो किताब उघडीन, वो धरती निकावी वा यो लिख्यो हुतो: <figure style="fig" alt="Scroll" file="hk00150c।tif" size="col" copy="Horace Knowles ©" ref="4:16">लाकड़ीमा गुंडावलो पत्री</figure><verse eid="LUK 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18"/>“पोरबु क आत्मा मखे पर छे</para>
  <para style="q2" vid="LUK 4:18">एरकरीन कि त्यो गरीब क खुश खबर</para>
  <para style="q1" vid="LUK 4:18">सोमवने क करता मारे अभिषेक कर्‍या छे,</para>
  <para style="q2" vid="LUK 4:18">कि बन्दियो क छुटकारा क</para>
  <para style="q1" vid="LUK 4:18">आरू आंधवा क दूष्टि देखने क खुश करो आरू कुचळायला हुयो क छुड़ाया,<verse eid="LUK 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LUK 4:19"/>आरू पोरबु क खुश रयने क साल क</para>
  <para style="q2" vid="LUK 4:19">खबर करो।”<verse eid="LUK 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20"/>तव त्यो किताब बंद करीन सेवक क हात मा दे दी आरू बठ गया; आरू आराधना घर क सब मानसे की डुवा उना पर लाग्या हुता। <verse eid="LUK 4:20"/><verse number="21" style="v" sid="LUK 4:21"/>तव वो उनछे कयनो लाग्या, “आज ही यो लेख तुमरे सामने पूरो हुयो छे।”<verse eid="LUK 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22"/>सबने ओको सराह, आरू जो फोकटन दया की वात ओका मुय छे निकवती होती, उनछे घबराय हुय; आरू कयनो लाग्या, “काय यो यूसुफ क पोर्‍या नी?”<verse eid="LUK 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23"/>त्यो उनछे कयो, “तुमू म्हार पर यी वात पाकी कहवसो कि दाक्तर पेहल थारो इलाज करले! जो काय हामु ने सोमवने छे कि कफरनहूम मा कर्‍या गया छे, ओको याहा थार देश मा भी कर।” <verse eid="LUK 4:23"/><verse number="24" style="v" sid="LUK 4:24"/>आरू त्यो कयो, “हाव तुमू छे सच कयता छे काही कागळीयान आपसा देश मा मान सम्मान नी जुड़से।”<verse eid="LUK 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 4:25"/>हाव सच कयता छे कि एलियाह क दाहड़ा मा जव साढ़े तीन साल तक सोरग बंद रया, याहा तक कि सब देश मा मोठ अकाल पड्यो, तो इस्राएल मा घोणा सी रंडायली होती। <verse eid="LUK 4:25"/><verse number="26" style="v" sid="LUK 4:26"/>पर एलियाह उन मा छे काही क साथे नी मुकल्य गयो, केवल सैदा क सारफत मा एक रंडायली क साथे। <verse eid="LUK 4:26"/><verse number="27" style="v" sid="LUK 4:27"/>“आरू एलीशा भविष्यवक्ता क टेहाव इस्राएल मा घोणा छे कुड़ावा हूता, पर सीरियावासी नामान क छुड़ उनमा छे काही चुखो नी कर्‍या गया।”<verse eid="LUK 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28"/>यो वात सोमवने ही जोतरा आराधना घर मा हुतो, सब रीस छे भर गयो, <verse eid="LUK 4:28"/><verse number="29" style="v" sid="LUK 4:29"/>आरू उठीन ओको नगर छे बाहरता निकाव्या, आरू जिना बयड़ा पर ओको नगर बशा हुयो हुतो, ओकी चोटी पर ली चाल्या कि ओको वाँ छे नेचो नाखने गयो। <verse eid="LUK 4:29"/><verse number="30" style="v" sid="LUK 4:30"/>पुन वो ओको वीच मा छे निकावीन चाली गया।<verse eid="LUK 4:30"/></para>
  <para style="s">दुष्टाआत्मा होयलो मानुस</para>
  <para style="r">(<ref loc="MRK 1:21-28">मरकुस 1:21-28</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31"/>पछु वो गलील क कफरनहूम नगर क गया; आरू आराम क दाहडो क दाहड़े मानसे क शिक्षा देय रया हुता। <verse eid="LUK 4:31"/><verse number="32" style="v" sid="LUK 4:32"/><note caller="+" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="MAT 7:28">मत्ती 7:28</ref>,<ref loc="MAT 7:29">29</ref></char></note>आरू लोगहन ओकी शिक्षा सोमवीन चकित होय गयो, काहकि ओको वचन हक साथे बुलतो हुतो। <verse eid="LUK 4:32"/><verse number="33" style="v" sid="LUK 4:33"/>आराधना घर मा एक मानुस हुतो, जिनामा विटळ आत्मा हुती। वो उंचा स्वर छे आयड़ी उठ्या, <verse eid="LUK 4:33"/><verse number="34" style="v" sid="LUK 4:34"/>“हे ईशु नासरत, हामुक तु छे काय काम? काय तु हामु नष्ट करने आयो छे? हाव तुखे जानता छे तु कुन छे? यहोवा–भगवान क चुखलो जन छे।”<verse eid="LUK 4:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35"/>ईशु ओको लड़िन कयो, “चुप रया, आरू ओका मा सी निकवी जा।” तव साहळा ओको वीच मा पटककर बिना हानि पुचाड्य उनमा छे निकवी गयी।<verse eid="LUK 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36"/>इनीये पर सब क भोंगलाय गयो हुयो, आरू वो आपस मा वात करीन कयनो लाग्या, “यो कोसी वात छे? काहकि वो हक आरू शैतान क साथे साहळा क हुकुम देता छे, आरू वो निकली जाती छे।” <verse eid="LUK 4:36"/><verse number="37" style="v" sid="LUK 4:37"/>इनीये प्रकार चार आरू हर जागेह ओकी चर्चा हुयने लागी।<verse eid="LUK 4:37"/></para>
  <para style="s">ईशु घण सवटा मानसे क वारू करे</para>
  <para style="r">(<ref loc="MAT 8:14-17">मत्ती 8:14-17</ref>; <ref loc="MRK 1:29-34">मरकुस 1:29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38"/>वो आराधना घर मा छे उठीन शमौन न क घर मा गया। शमौन की सासु क ज्वर चढ़ियो हुयो हुतो, आरू त्या ओका करता ओका सी रावन्या करी। <verse eid="LUK 4:38"/><verse number="39" style="v" sid="LUK 4:39"/>ईशु ओका निकट उबो हईन ज्वर क लड़यो आरू ज्वर उतर गयो, आरू वो तत्काल उठीन ओकी सेवा टहल करने लागी।<verse eid="LUK 4:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40"/>दाहडु बुड़ टेहाव, जिन क याहा मानसे नाना प्रकार की बीमारी मा पड़्यो हुय हुत, वो आरामना दाहडो तीनुक ओका साथे ली आश, आरू त्यो एक पर हात राखीन तीनुक वारू कर्‍या। <verse eid="LUK 4:40"/><verse number="41" style="v" sid="LUK 4:41"/>“आरू साहळा भी आयड़ती आरू यो कयती होयी कि, तु यहोवा–भगवान क पोर्‍या छे” घोणा मा छे निकवी गयी।</para>
  <para style="p" vid="LUK 4:41">पर वो तीनुक लड़िन आरू बुलने नी देता हुता, काहकि वो जानती होती कि वो उध्दारकरता मसीह छे।<verse eid="LUK 4:41"/></para>
  <para style="s">ईशु क आराधना घर मा परचार करनो</para>
  <para style="r">(<ref loc="MRK 1:35-39">मरकुस 1:35-39</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42"/>जव दाहडु निकव्यु छे घोणा पेहल, ईशु उठीन निकव्य, आरू गर्दी की गर्दी उको हेरती होयी ओका साथे आवी, आरू उको रोकने लागी कि वो ओको साथे छे नी जाय। <verse eid="LUK 4:42"/><verse number="43" style="v" sid="LUK 4:43"/>पुन ईशु कयो, “मखे दिसरा नगर मा भी यहोवा–भगवान क राज्य क खुश खबर कयनु छे, काहकि हाव एरकरीन मुकल्या गयो छे।”<verse eid="LUK 4:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 4:44"/>आरू वो यहूदि या क सब सभागृह मा खबर करता रया।<verse eid="LUK 4:44"/></para>
  <chapter eid="LUK 4"/>
  <chapter number="5" style="c" sid="LUK 5"/>
  <para style="s">पेहलो चेला क बुलाया जाना</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:1">मत्ती 13:1</ref>,<ref loc="MAT 13:2">2</ref>; <ref loc="MRK 3:9">मरकुस 3:9</ref>,<ref loc="MRK 3:10">10</ref>; <ref loc="MRK 4:1">4:1</ref></char>
    </note>जव गर्दी यहोवा–भगवान क वचन सोमवने क करता उना पर पड़ गयी होती, आरू वो गन्नेसरत की दरिया क धोड़े पर उबो हुतो, तो ओसो हुयो, <verse eid="LUK 5:1"/><verse number="2" style="v" sid="LUK 5:2"/>कि त्यो दरिया क धोड़े दुय नाव लागी होयी देखी, आरू मासा धरन्या उन पर छे उतरीन जाव धो रये हुतो। <verse eid="LUK 5:2"/><verse number="3" style="v" sid="LUK 5:3"/>उन ढोंड्या मा छे एक पर जो शमौन की होती, चढ़ीन त्यो उका छे विनती की धोड़े छे थुडक धोड़े हट लेय चाल्या। तव वो बठीन मानसे क ढोंड्या पर छे शिक्षा देने लाग्या।<verse eid="LUK 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4"/>जव वो वात कर त्योक्या तो शमौन छे कयो, “गहरे मा लेय चल, आरू मासा धरने क करता आपसी जाव नाख्या।” <figure style="fig" alt="Fishermen in boat and catch fish" file="hk00208c।tif" size="span" copy="Horace Knowles ©" ref="5:4">ढोंड्या मा चढ़िन मासा मारनारा मासा मार्‍या</figure><verse eid="LUK 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">5:5 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 21:3">यहुन्ना 21:3</ref>
      </char>
    </note>शमौन ने ओको जवाब दिया, “हे भगवान, हामु सारी रात मेहनत की आरू काय नी दरिया तौभी तारे कयनो छे जाव नाखछे।” <verse eid="LUK 5:5"/><verse number="6" style="v" sid="LUK 5:6"/><note caller="+" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="JHN 21:6">यहुन्ना 21:6</ref></char></note>जव त्या ओसो कर्‍या, तो घोणा मासा धर लाया, आरू ओको जाव फाटने लागी। <verse eid="LUK 5:6"/><verse number="7" style="v" sid="LUK 5:7"/>इनीये पर त्या आपसा साथी क जो दीसरी पर हुतो, संकेत कर्‍या कि आवीन हामरी मदत करो, आरू त्या आवीन दुय ढोंड्या याहा तक भर लीय कि वो डुबने लागी। <verse eid="LUK 5:7"/><verse number="8" style="v" sid="LUK 5:8"/>यो देखीन शमौन पतरस ईशु क पाया पोड्य आरू कयो, “हे पोरबु, मारे साथे छे जा काहकि हाव पापी मानुस छे।”<verse eid="LUK 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 5:9"/>काहकि ओतरा मासा क धराय जाछे ओको आरू ओका साथी क घोणा भोंगलाय गयो हुयो, <verse eid="LUK 5:9"/><verse number="10" style="v" sid="LUK 5:10"/>आरू वोसो ही जबदी क पोर्‍या याकूब आरू यहुन्ना क भी, जो शमौन क सहभागी हुतो, भोंगलाय गयो हुयो। तव ईशु शमौन छे कयो, “मत घाबराय हिमी छे तु मानुस क यहोवा भगवान राज्यमा लावनेवावा बनावीस।”<verse eid="LUK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 5:11"/>आरू वो ढोंड्या क धोड़े पर लगाड़ देदा तेतार चा सब काय छुड़ीन ईशु पछव होय लेदा।<verse eid="LUK 5:11"/></para>
  <para style="s">कुड़ावा क बीमार वारू करने</para>
  <para style="r">(<ref loc="MAT 8:1-4">मत्ती 8:1-4</ref>; <ref loc="MRK 1:40-45">मरकुस 1:40-45</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12"/>जव चु काही नगर मा हुता, ते वा कुड़ावा छे भरा हुयो एक मानुस आश; आरू वा ईशु क देखीन मुय क बल पोड्य आरू रावन्या करी, “हे पोरबु, यदि तु जुवे ते मखे वारू कर सकतो छे।”<verse eid="LUK 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13"/>ईशु हात ओगव उको दरिया आरू कयो, “हाव जुवता छे, तु वारू होय जाय।” आरू ओको हाथ लागाड़ीन कुड़ावो क तत्काल जातो रया। <verse eid="LUK 5:13"/><verse number="14" style="v" sid="LUK 5:14"/>तव ईशु उको चिताया, “कुदाक काय छे नी कयनो, पुन क आपने आप क पुजारा देख्या, आरू आपने वारू हुयने क विषय मा जो काय मूसाने चढ़ावलो ठेराया छे ओको चढ़ा कि उन पर गवा होय।”<verse eid="LUK 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15"/>पुन ओकी चर्चा आरू भी फैलती गयी, आरू गर्दी करी गर्दी ओकी सोमवने क करता आरू आपसी बीमारी छे वारू हुयने क करता एखठी होयी। <verse eid="LUK 5:15"/><verse number="16" style="v" sid="LUK 5:16"/>पुन वो जंगल मा अलग जाईन प्रार्थना कर्‍या करता हुता।<verse eid="LUK 5:16"/></para>
  <para style="s">लखवा क बीमार क वारू करने</para>
  <para style="r">(<ref loc="MAT 9:1-8">मत्ती 9:1-8</ref>; <ref loc="MRK 2:1-12">मरकुस 2:1-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17"/>एक दाहड़ो ओसो हुयो कि ईशु शिक्षा देय रया हुता, आरू फरीसि आरू व्यवस्थापक वाँ बठ्या हुया हुता जो गलील आरू यहूदिया क हर गाँव छे आरू यरूशलेम छे आश हुता, आरू वारू करने क करता पोरबु की शक्ति ईशु क साथे होती। <verse eid="LUK 5:17"/><verse number="18" style="v" sid="LUK 5:18"/>उना टेहाव कर्‍या मानसे एक मानुस क जो लखवा सी बीमार हुतो, खाटलो पर लाया, आरू वो उको माहीय लेय जाने आरू ईशु क सामने राखने क उपाय हेर हुता। <verse eid="LUK 5:18"/><verse number="19" style="v" sid="LUK 5:19"/>पर जव गर्दी क कारण उको माहीय नी लेय जा सक्या तो त्या छत पर चढ़ीन आरू खपरैल हटाकर, उको खाट्लो सहावत वीच मा ईशु क सामने उतार दिया। <verse eid="LUK 5:19"/><verse number="20" style="v" sid="LUK 5:20"/>जो लीन आश त्यो ओको विश्वास देखीन ओका सी कयो, “हे मानुस, तारे पाप माफ होयी।”<verse eid="LUK 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21"/>तव शास्त्री आरू फरीसि विवाद करने लाग्या, “यो कुन छे जो यहोवा–भगवान की निन्दा करता छे? यहोवा–भगवान क छुड़ीन आरू कुन पाप क माफ कर सकता छे!”<verse eid="LUK 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22"/>ईशु ओको मन की वात जानीन, उनछे कयो, “तुमू आपसा मन मा काय विवाद कर रयो होय? <verse eid="LUK 5:22"/><verse number="23" style="v" sid="LUK 5:23"/>सहज काय छे? काय यो कयनो कि तारे पाप माफ हुय, या यो कयनो कि उठ आरू चाल पछु? <verse eid="LUK 5:23"/><verse number="24" style="v" sid="LUK 5:24"/>पुन एरकरीन कि तुमू जानो कि, मानुस क भी पोर्‍या क धरती पर पाप माफ करने क भी हक छे।” त्यो उना लखवा क बीमार छे वारू कयो, “हाव तुखे छे कयता छे, उठ आरू आपनो खाट्लो हुचली आपने घर चाली जा।”<verse eid="LUK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 5:25"/>वो तत्काल ओको सामने उठीन, आरू जिना पर वो पड़्यो हुता उको उठाड़ीन, यहोवा–भगवान की बढ़ाई करता हुयो आपने घर चाल गया। <verse eid="LUK 5:25"/><verse number="26" style="v" sid="LUK 5:26"/>तव सब बीह गया आरू यहोवा–भगवान की बढ़ाई करने लागी आरू घोणा घाबराय कयनो लाग्या, “आज हामु कोसली वात देखी छे!”<verse eid="LUK 5:26"/></para>
  <para style="s">ईशु लेवी क बुलायो</para>
  <para style="r">(<ref loc="MAT 9:9-13">मत्ती 9:9-13</ref>; <ref loc="MRK 2:13-17">मरकुस 2:13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27"/>ओका बाद ईशु बाहरता गया आरू लेवी नावन एक फाळो लेनेवाळा क फाळान चौकी पर बठ्या देख्या, आरू ओका सी कयो, “मारे पछव होय लेय।” <verse eid="LUK 5:27"/><verse number="28" style="v" sid="LUK 5:28"/>तव लेवी सब काय छुड़ीन उठ्या, आरू ओका पछव होय गया।<verse eid="LUK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29"/>तव लेवी ओका घर मा ओका करता एक मोट भोजन दिया; आरू फाळो लेनेवाळा की आरू दिसरा मानसे की ओका साथे रूटा खाने बठ्या हुता, एक मोटी गर्दी होती। <verse eid="LUK 5:29"/><verse number="30" style="v" sid="LUK 5:30"/><note caller="+" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="LUK 15:1">लूका 15:1</ref>,<ref loc="LUK 15:2">2</ref></char></note>इनीये पर फरीसि आरू ओको शास्त्री उना क चेला छे यो कयीन कुरकुर करने लाग्या, “तुमू फाळो लेनेवाळा आरू पापी क साथे काय खाता पीता होय?”<verse eid="LUK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31"/>ईशु उनको जवाब दिया, “वैद्य भले वारू क करता नी, पुन बीमार क करता छाची छे। <verse eid="LUK 5:31"/><verse number="32" style="v" sid="LUK 5:32"/>हाव न्यायी क नी, पुन पापी क मन फिरावने क करता बुलावने आश छे।”<verse eid="LUK 5:32"/></para>
  <para style="s">उपवास क सवाल</para>
  <para style="r">(<ref loc="MAT 9:14-17">मत्ती 9:14-17</ref>; <ref loc="MRK 2:18-22">मरकुस 2:18-22</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33"/>त्या ओका सी कयो, “बपतिस्मा देनेवावो यहुन्ना क चेला तो बराबर उपवास राखता आरू प्रार्थना कर्‍या करता छे, आरू वोसो ही फरीसि क चेला भी, पुन तारा चेला तो खाता पीता छे।”<verse eid="LUK 5:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34"/>ईशु उनछे कयो, “काय तुमू वरात्यान छे, जव तक लाड़ो ओको साथे रये, उपवास कराय सकते होय? <verse eid="LUK 5:34"/><verse number="35" style="v" sid="LUK 5:35"/>पुन वो दाहड़ो आवसे जिनमा लाड़ो उनछे अलग कर्‍या जाछे, तव वो उन दाहड़ा मा उपवास करसे।”<verse eid="LUK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36"/>त्यो एक आरू दृष्टान्त भी उनछे कयो: “काही मानुस नोवला लुगड़ा मा छे फाड़ीन मसको छिंदरा मा पैवन्द नी लागता नी तो नवलो फाटी जाछे आरू वो पैवन्द मशका मा मेलमिलाप भी नी खासे। <verse eid="LUK 5:36"/><verse number="37" style="v" sid="LUK 5:37"/>आरू काही नवलो अंगुरन रस मसको भरीन राखे नी वोसो मसको फाड़ीन रस वहय जा छे, आरू मसको भी फाट होय जाछे। <verse eid="LUK 5:37"/><verse number="38" style="v" sid="LUK 5:38"/>पुन नवलो अंगुरन रस नयी मसको मा भरन जुवे। <verse eid="LUK 5:38"/><verse number="39" style="v" sid="LUK 5:39"/>काही मानुस जुनला अंगुरन रस पीन नोवला नी जुवता काहकि वो कयता छे, कि जुनला क वारला छे।”<verse eid="LUK 5:39"/></para>
  <chapter eid="LUK 5"/>
  <chapter number="6" style="c" sid="LUK 6"/>
  <para style="s">आराम क दाहड़ा क सवाल</para>
  <para style="r">(<ref loc="MAT 12:1-8">मत्ती 12:1-8</ref>; <ref loc="MRK 2:23-28">मरकुस 2:23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1"/>पछु आरामना दाहडो क वो खेत मा छे हईन जाय रया हुतो, आरू ओका चेला उम्बीया तुड़ीन आरू हात छे मलीन खाता जाय रया हुता। <verse eid="LUK 6:1"/><verse number="2" style="v" sid="LUK 6:2"/>तव फरीसिया मा छे काय कयनो लाग्या, “तुमू वो काम काय करता होय जो आरामना दाहड़े क करने वारू नी?”<verse eid="LUK 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3"/>ईशु ओका जवाब देदा, “काय तुमूने यो नी भोन्ने कि दाऊदने, जव वो आरू ओको साथी भुखला हुता तो काय कर्‍या? <verse eid="LUK 6:3"/><verse number="4" style="v" sid="LUK 6:4"/>वो कोसो यहोवा–भगवान क घर मा गया, आरू भेंट करी रोटा लीन खाय जिनाक खाने पुजारा क छुड़ीन आरू काही क वारू नी, आरू आपसा साथी क भी देदी”<verse eid="LUK 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 6:5"/>आरू त्यो कयो, “मानुस क पोर्‍या आरामना दाहडो क दाहड़ा क भी पोरबु छे।”<verse eid="LUK 6:5"/></para>
  <para style="s">सुखला हात वावा मानुस क वारू करने</para>
  <para style="r">(<ref loc="MAT 12:9-14">मत्ती 12:9-14</ref>; <ref loc="MRK 3:1-6">मरकुस 3:1-6</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6"/>ओसो हुयो कि काही आरू आराम नो दाहडो क ईशु आराधना घर मा जाईन शिक्षा करने लाग्या; आरू वाँ एक मानुस हुतो जेरो डासच्य हात सुखलो हुता। <verse eid="LUK 6:6"/><verse number="7" style="v" sid="LUK 6:7"/>शास्त्री आरू फरीसि उना पर दोष लागाड़ ने क मेखे देखने की ताक मा हुता़ कि देखछे वो आराम क दाहडो क वारू करता छे कि नी। <verse eid="LUK 6:7"/><verse number="8" style="v" sid="LUK 6:8"/>पुन वो ओको विचार जानता हुता; एरकरीन त्यो सुखलो हातवावा मानुस छे कयो, “उठ वीच मा उबो होय।” वो उठ्यो उबो हुयो। <verse eid="LUK 6:8"/><verse number="9" style="v" sid="LUK 6:9"/>ईशु ने ओको कयो, “हाव तुमूक यो पूछतु छे कि आपसो नियमन क नुसार आरामन दाहाड़ा क काय वारू छे, भलो करने या बुर करने; जीव क वाचाड़ने या नाश करने?” <verse eid="LUK 6:9"/><verse number="10" style="v" sid="LUK 6:10"/>तव त्यो चार आरू उन सभो क देखीन उना मानुस छे कयो, “आपसा हात सुधो कर।” त्यो ओसो ही कर्‍या, आरू ओको हात पछु वारू होय गया।<verse eid="LUK 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 6:11"/>पुन वो तुमू छे बाहरता हईन आपस मा विवाद करने लाग्या कि, “हामु ईशु क साथे काय कर्‍या?”<verse eid="LUK 6:11"/></para>
  <para style="s">बारा प्रेरितन की नेवाड़्यो</para>
  <para style="r">(<ref loc="MAT 10:1-4">मत्ती 10:1-4</ref>; <ref loc="MRK 3:13-19">मरकुस 3:13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12"/>उन दाहड़ा मा ईशु बयड़ा पर प्रार्थना करने गया, आरू यहोवा–भगवान छे प्रार्थना करने मा सारी रात विती। <verse eid="LUK 6:12"/><verse number="13" style="v" sid="LUK 6:13"/>जव दाहड़ो हुयो तो त्यो आपसा चेला क बुलावीन उनमा छे बारा निवाड़ लेदा, आरू उनको प्रेरितन कयो; <verse eid="LUK 6:13"/><verse number="14" style="v" sid="LUK 6:14"/>आरू वो छे: शमौन जेरो नाव त्यो पतरस भी राख्या, आरू ओको भाईस, आरू याकूब, आरू यहुन्ना, आरू फिलिप्पुस, आरू बरतुल्मै, अन्द्रियास <verse eid="LUK 6:14"/><verse number="15" style="v" sid="LUK 6:15"/>आरू मत्ती, आरू थोमा, आरू हलफई क पोर्‍या याकूब, आरू शमौन जो जेलोतेस कवाये छे, <verse eid="LUK 6:15"/><verse number="16" style="v" sid="LUK 6:16"/>आरू याकूब क पोर्‍य यहूदा, आरू यहूदा इस्करियोती जो ओको धरावनेवावा बन्य।<verse eid="LUK 6:16"/></para>
  <para style="s">शिक्षा देने आरू वारू करने</para>
  <para style="r">(<ref loc="MAT 4:23-25">मत्ती 4:23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17"/>तव ईशु ओको साथे उतरीन चौरस धरती मा उबा हुया, आरू ओका चेलान मोटी गर्दी आरू सब यहूदि या, यरूशलेम, आरू सोर आरू सीदोन क दरिया क धोड़े छे घोणा मानछे आया, <verse eid="LUK 6:17"/><verse number="18" style="v" sid="LUK 6:18"/>जो ओका सोमवने आरू आपसी बीमारी छे वारू हुयने क करता ओको साथे आश हुता, वाँ हुता। आरू साहळा क सताया हुया मानसे भी वारला कर्‍या जाता हुता। <verse eid="LUK 6:18"/><verse number="19" style="v" sid="LUK 6:19"/>सब ओको हात लागाड़ ने जुवता हुता, काहकि उको छे शक्ति निकावीन सब क वारू करती होती।<verse eid="LUK 6:19"/></para>
  <para style="s">सय बरकत आरू शोक क वचन</para>
  <para style="r">(<ref loc="MAT 5:1-12">मत्ती 5:1-12</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20"/>तव त्यो आपसा चेला की आरू देखीन कयो,</para>
  <para style="q1" vid="LUK 6:20">“धन्य होय तुमू जो गरीब होय,</para>
  <para style="q2" vid="LUK 6:20">काहकि यहोवा–भगवान क राज्य तुमरो छे।”<verse eid="LUK 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21"/>“धन्य होय तुमू जो हिमी भुखलो होय,</para>
  <para style="q2" vid="LUK 6:21">काहकि तुप्त कर्‍या जाछे।”</para>
  <para style="q1" vid="LUK 6:21">“धन्य होय तुमू जो हिमी रड़ता होय;</para>
  <para style="q2" vid="LUK 6:21">काहकि त्या हास से।”<verse eid="LUK 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 6:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:22 </char>
      <char style="xt" closed="false">
        <ref loc="1PE 4:14">1 पतरस 4:14</ref>
      </char>
    </note>धन्य होय तुमू जव मानुस क पोर्‍या क कारण मानसे तुमू छे बैर करसे, आरू तुमूक निकाव देसे आरू तुमरी निंदा करसे आरू तुमरो नाव बुरो जानीन काट देसे। <verse eid="LUK 6:22"/><verse number="23" style="v" sid="LUK 6:23"/><note caller="+" style="x"><char style="xo" closed="false">6:23 </char><char style="xt" closed="false"><ref loc="ACT 7:52">प्रेरितन 7:52</ref></char></note>“उना दाहड़े खुश हईन उछलनो, काहकि देखु, तुमरे करता सोरग मा मोटा हर फोव छे; ओको बास दादाने भविष्यवक्ता क साथे भी वोसो ही कर्‍या करता हुता।”<verse eid="LUK 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24"/>“पुन हाय तुमू पर जो धनवान होय,</para>
  <para style="q2" vid="LUK 6:24">काहकि तुमू पर आपसी शांती देख त्योक्या।”<verse eid="LUK 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25"/>“हाय तुमू पर जो हिमी तुप्त होय!</para>
  <para style="q2" vid="LUK 6:25">काहकि भुखला होयछे।”</para>
  <para style="q1" vid="LUK 6:25">“हाय तुमू पर जो हिमी हासता होय,</para>
  <para style="q2" vid="LUK 6:25">काहकि शोक करसे आरू रयछे।<verse eid="LUK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 6:26"/>“हाय तुमू पर सब मानसे तुमू भलो कयो, काहकि ओको बास दादा झुठा भविष्यवक्ता क साथे भी ओसो ही कर्‍या करता हुता।<verse eid="LUK 6:26"/></para>
  <para style="s">दुस्मन छे मोंग</para>
  <para style="r">(<ref loc="MAT 5:38-48">मत्ती 5:38-48</ref>; <ref loc="MAT 7:12">7:12</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27"/>“पुन हाव तुमू सोमवनेवावा छे कयता छे कि आपसा दुस्मन छे मोंग राख्या; जो तुमू छे बैर कर्‍या, ओको भलो कर्‍या। <verse eid="LUK 6:27"/><verse number="28" style="v" sid="LUK 6:28"/>जो तुमू स्राप देय, उनको बरकत दुय; जो तुमरो विजुत कर्‍या, ओको करता प्रार्थना कर्‍या। <verse eid="LUK 6:28"/><verse number="29" style="v" sid="LUK 6:29"/>जो तारे एक गाल पर थप्पड मारे ओकी आरू दिसरा भी फेर देय; आरू जो तारी दोयर लेय, ओको सुटर लेने छे भी नी रूकाया। <verse eid="LUK 6:29"/><verse number="30" style="v" sid="LUK 6:30"/>जो काही तुखे छे मांगछे, ओको देया कर; जो तारी समान छिन लेय, ओका सी पछु नी मांगछे। <verse eid="LUK 6:30"/><verse number="31" style="v" sid="LUK 6:31"/><note caller="+" style="x"><char style="xo" closed="false">6:31 </char><char style="xt" closed="false"><ref loc="MAT 7:12">मत्ती 7:12</ref></char></note>ओसो तुमू जुवता होय कि मानसे तुमरे साथे जोसा व्यवहार कर्‍या, तुमू भी ओको साथे वोसो ही व्यवहार कर्‍या काहकि शास्त्र मा आरू नबिया क मा यी शिक्षा छे।<verse eid="LUK 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32"/>“यदि तुमू तुमरे साथ मोंग राखनेवावा क साथे मोंग राख्या, तो तुमरी काय बढ़ाई? काहकि पापी भी आपनो मोंग राखनेवावा क साथे मोंग राखता छे। <verse eid="LUK 6:32"/><verse number="33" style="v" sid="LUK 6:33"/>यदि तुमू थार भलो करनेवावा ही क साथे भलो करता होय, तो तुमरी काय बढ़ाई? काहकि पापी भी ओसो ही करता छे। <verse eid="LUK 6:33"/><verse number="34" style="v" sid="LUK 6:34"/>यदि तुमू तीनुक उधार आपे जिनछे पछु देखने कि आश राखता होय, तो तुमरी काय बढ़ाई? काहकि पापी पापीको उधार देता छे कि ओतरा ही पछु देखछे। <verse eid="LUK 6:34"/><verse number="35" style="v" sid="LUK 6:35"/>बाकुन तुमु तुमरा दुस्मन सी भी मोंग राखो आरू भलो करो, आरू पछु देखने कि आश नी राखीन उधार दुय; आरू तुमरे करता मोठ फव होयछे, आरू तुमू परमप्रधान क अवलियाद ठरछे, काहकि वो उन पर जो धन्यवाद नी करता आरू बुरो पर भी दयालु छे। <verse eid="LUK 6:35"/><verse number="36" style="v" sid="LUK 6:36"/>जोसो तुमरा सोरगदूत क बास दयावन्त छे, जोसो ही तुमू भी दयावन्त बनछे।<verse eid="LUK 6:36"/></para>
  <para style="s">दोष नी लागाड़ ने</para>
  <para style="r">(<ref loc="MAT 7:1-5">मत्ती 7:1-5</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37"/>“दोष मा लागाड़ु दिसरा पर ते तुमू पर भी दोष नी कुन लागाड़े। दोषी नी ठरछे, जाछे। माफ करसे, ते तुमू भी माफ कर्‍या जाछे। <verse eid="LUK 6:37"/><verse number="38" style="v" sid="LUK 6:38"/>आप्या करू, आरू यहोवा–भगवान तुमू भी आपु। मानुस पूरा नाप दाबी–दाबीन आरू हालवी–हालवीन आरू जु भरीन तुमरा खुवा मा नाखछे, काहकि जा नाप करीन तुमू नापता होय, तीनी छे तुमरे करता भी नापाय जाछे।”<verse eid="LUK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">6:39 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 15:14">मत्ती 15:14</ref>
      </char>
    </note>पछु ईशुने उनछे एक दृष्टान्त कयो: “काय आँधवो, आंधवा क देखाड़ सके? काय दुय खाड्डा मा नी पड़ जाय? <verse eid="LUK 6:39"/><verse number="40" style="v" sid="LUK 6:40"/><note caller="+" style="x"><char style="xo" closed="false">6:40 </char><char style="xt" closed="false"><ref loc="MAT 10:24">मत्ती 10:24</ref>,<ref loc="MAT 10:25">25</ref>; <ref loc="JHN 13:16">यहुन्ना 13:16</ref>; <ref loc="JHN 15:20">15:20</ref></char></note>चेला आपने गुरू छे मटो नी, पुन जो काही सिध्द होयछे, वो आपने गुरू क समान होयछे।”<verse eid="LUK 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41"/>तु थारा भाई क डुवा न तिनको काय देखे, जव थारात् डुळान लकड़ो तुखे नी पतु नी होय? <verse eid="LUK 6:41"/><verse number="42" style="v" sid="LUK 6:42"/>जव तु आपसी ही डुवा क लठ्ठा नी देखता, तो आपने भाईस छे कोसो कय सकता छे भाईस; ठरछे जा तारा डुवा छे तिनके क निकावीन देसे? हे कपटी, पेहले आपसा डुवा छे लठ्ठा निकाव, तव जो तिनका तारो भाईस की डुवा मा छे, ओको भोली भौति देखीन निकाव सकछे।<verse eid="LUK 6:42"/></para>
  <para style="s">जोसो झाडको तोसो फोव</para>
  <para style="r">(<ref loc="MAT 7:16-20">मत्ती 7:16-20</ref>; <ref loc="MAT 12:23-35">12:23-35</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43"/>“काही वारलो झाड़को क नी जी निकम्मा फव लाया, आरू नी तो काही निकम्मा झाड़का छे जो वारलो फव लायो। <verse eid="LUK 6:43"/><verse number="44" style="v" sid="LUK 6:44"/><note caller="+" style="x"><char style="xo" closed="false">6:44 </char><char style="xt" closed="false"><ref loc="MAT 12:33">मत्ती 12:33</ref></char></note>हर एक झाड़का थार फव छे पेहचान जाता छे; काहकि मानसे झाड़का छे अंजीर नी तुडता आरू नी झड़बेरी छे अंगुर। <verse eid="LUK 6:44"/><verse number="45" style="v" sid="LUK 6:45"/><note caller="+" style="x"><char style="xo" closed="false">6:45 </char><char style="xt" closed="false"><ref loc="MAT 12:34">मत्ती 12:34</ref></char></note>भलो मानुस आपने मन क वारला भण्डार छे भली वात निकावता छे; काहकि जो मन मा भरा छे चो ओका मुय पर आवता छे। आरू बुरा मानुस आपने मन क बुरे भण्डार छे बुरी वात निकावता छे;<verse eid="LUK 6:45"/></para>
  <para style="s">घर बनावने वावा दुय मानसे</para>
  <para style="r">(<ref loc="MAT 7:24-27">मत्ती 7:24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46"/>“जव तुमू मारो कयनो नी मानता तो काय मखे ‘हे पोरबु, हे पोरबु’ कयता होय? <verse eid="LUK 6:46"/><verse number="47" style="v" sid="LUK 6:47"/>जो काही मारे साथे आवता छे आरू मारी वात सोमवीन तीनुक मानता छे, हाव तुमू देखाड़ो कि वो कुनीन समान छे: <verse eid="LUK 6:47"/><verse number="48" style="v" sid="LUK 6:48"/>वो उना मानुस क समान छे, जो घर बनावता टेहाव धरती गहरी खुदीन चठ्ठान पर नींव नाखी, आरू जव बाढ़ आवी तो धारो उना घर पर लागी पुन उको हिला नी सकी; काहकि वो पक्‍का बन्य हुता। <verse eid="LUK 6:48"/><verse number="49" style="v" sid="LUK 6:49"/>पुन जो सोमवीन नी मानता वो उना मानुस क समान छे, जो धरती पर बिना नीव क घर बनाड़े, जव उना पर धारा लागी तो वो तत्काल पड़्यो आरू आयड़ी ओको सच्चाई नाश होय गयो।”<verse eid="LUK 6:49"/></para>
  <chapter eid="LUK 6"/>
  <chapter number="7" style="c" sid="LUK 7"/>
  <para style="s">एक सूबेदार क विश्वास</para>
  <para style="r">(<ref loc="MAT 8:5-13">मत्ती 8:5-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1"/>जव ईशु मानसक यो सब वात कय त्योक्य तो कफरनहूम नगर मा आश। <verse eid="LUK 7:1"/><verse number="2" style="v" sid="LUK 7:2"/>वाँ काही रोमन सरदार क एक दास जो ओको मोंगावु हुता, बीमारी छे मरना पर हुता, <verse eid="LUK 7:2"/><verse number="3" style="v" sid="LUK 7:3"/>त्यो ईशु क चर्चा सोमवीन यहूदियो क काहय डाहडा ओका सी यी विनती करने क ओका साथे मुकल्या कि, आवीन मारे दास क वारू करे, आरू उका जीवन वाचाड़्यु। <verse eid="LUK 7:3"/><verse number="4" style="v" sid="LUK 7:4"/>वो ईशु क आश, आरू ओका सी मोटी रावन्या करीन लाग्या, “वो इनीये योग्य छे कि तु ओको करता यो कर्‍या, <verse eid="LUK 7:4"/><verse number="5" style="v" sid="LUK 7:5"/>काहकि वो हामरी मानसे छे मोंग राखता छे, आरू तीनी ने हामरे आराधना घर क बनाड़े छे।”<verse eid="LUK 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 7:6"/>ईशु ओको साथे गया, पर जव वो घर छे दूर नी हुता, तो सरदार ने ओको कर्‍या दोस्तो क द्वारा कय मुकल्या, “हे पोरबु दुःख नी उठ्या, काहकि हाव इनीये लायक नी कि तु मारी छत क तवे आश। <verse eid="LUK 7:6"/><verse number="7" style="v" sid="LUK 7:7"/>इनी कारण हाव ने आपने आप क इनीये लायक भी नी समझ्या कि तारे साथे आवीन, पर ओवाज ही कय देय तो मारो सेवक वारू होय जाछे। <verse eid="LUK 7:7"/><verse number="8" style="v" sid="LUK 7:8"/>हाव भी एक सरदार क नेचलो मानुस छे, आरू सिपायड़ा म्हार हको तळे छे; आरू जव एक सी कहवो ‘जा’ तो वो जाय; आरू दिसरा सी कहवो, ‘आव’ तो आवे; आरू म्हारा दास ‘यो कर’ कहवो तो वो ओको करे।”<verse eid="LUK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9"/>यो सोमवीन ईशु क भोंगलाय गयो हुयो आरू त्यो मुय फेरकर उना गर्दी छे जो ओको पछव आय रयी होती, कयो, “हाव तुमू छे कयता छे कि हावने इस्राएल मा भी ओसो विश्वास नी देख्या।”<verse eid="LUK 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 7:10"/>आरू मुकल्या हुया मानसे ने घर पुगीन उना दास क वारू देख्या।<verse eid="LUK 7:10"/></para>
  <para style="s">रंडायली क पोर्‍या क जीवन दान</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11"/>थुडो दाहड़ा बाद ईशु नाईन नाव क एक नगर क गया। ओका चेला आरू मोटी गर्दी ओको साथे जाय रयी होती। <verse eid="LUK 7:11"/><verse number="12" style="v" sid="LUK 7:12"/>जव वो नगर क फाटक क साथे पुच्या, तो देख्य, मानसे एक मोरलाक क गाड़ ने क बाहरता करता जाय रया हुता; जो आपसी माय क एक खुळिया पोर्‍य हुतो, आरू वो रंडायली होती; आरू नगर क घोणा छे मानसे ओको साथे हुता। <verse eid="LUK 7:12"/><verse number="13" style="v" sid="LUK 7:13"/>उको देख कर पोरबु क तरस आश, आरू ओका सी कयो, “मारड़े।” <verse eid="LUK 7:13"/><verse number="14" style="v" sid="LUK 7:14"/>तव त्यो आवीन सीवड़ा क दरिया, आरू उठाड़नेवावा ठहर गया। तव त्यो कयो, “हे जवान, हाव तुखे छे कयता छे, उठ्या।” <verse eid="LUK 7:14"/><verse number="15" style="v" sid="LUK 7:15"/>तव वो मोरल पोर्‍य उठीन बठ्य, आरू बुलने लाग्या। ईशु उको ओकी माय क साप दिया।<verse eid="LUK 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16"/>इनासे सब पर बीक भराय गय, आरू वो यहोवा–भगवान की बढ़ाई करीन कयनो लाग्या, “हामरे वीच मा एक मोठ भविष्यवक्ता उठ्या छे, आरू यहोवा–भगवान ओका लोगहन पर दया न नजर करसे।”<verse eid="LUK 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 7:17"/>आरू ओको विषय मा यो वात सब यहूदिया आरू आस क सब देश मा पछु गयी।<verse eid="LUK 7:17"/></para>
  <para style="s">यहुन्ना बपतिस्मा देनेवावा क परचार</para>
  <para style="r">(<ref loc="MAT 11:2-19">मत्ती 11:2-19</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18"/>यहुन्ना क ओका चेला ने इन सब वात क खबर देदा। <verse eid="LUK 7:18"/><verse number="19" style="v" sid="LUK 7:19"/>तव यहुन्नो आपसा चेला मा छे दुय क बुलावीन पोरबु क साथे यो पूछने क करता मुकल्या, “काय आवनेवाळा तु ही छे, या हामु काय आरू वाट देख्या?”<verse eid="LUK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20"/>त्या ओको साथे आवीन कयो, “यहुन्ना बपतिस्मा देनेवावा ने हामु तारे साथे यो पूछने क मुकल्या छे कि, काय आवनेवाळा तु ही छे, या हामु काही दिसरान वाट देख्या?”<verse eid="LUK 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21"/>तीनी घड़ी त्यो घोणा क बीमार आरू पीड़ा आरू विटळ आत्मा छे छुड़ाया; आरू घोणा छे आंधवा क डुवा दियो; <verse eid="LUK 7:21"/><verse number="22" style="v" sid="LUK 7:22"/>आरू त्यो मुकल्या हुया क कयो, “जो काय तुमू ने देख्या आरू सोमव्या छे जाईन यहुन्ना छे कय दुय: कि आंधवा देखतो छे, लेंगड़ा चालता पुगता छे, कुड़ावा वारू कर्‍या जाता छे, बेहरा सोमवता छे, मोरला जीवता हुये, आरू गरीब क खुश खबर सोमवाय जाता छे। <verse eid="LUK 7:22"/><verse number="23" style="v" sid="LUK 7:23"/>धन्य छे वो जो मारे विषय मा ठुकर नी खाय।”<verse eid="LUK 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24"/>जव यहुन्ना क मुकल्या हुया लोगहन जात रया ते ईशु यहुन्ना क बारा मा लोगहन सी कयनो लाग्या, “तुमू जंगल मा काय देखने गया हुता? काय वाहवा छे हालतो हुय डाखलिया क? <verse eid="LUK 7:24"/><verse number="25" style="v" sid="LUK 7:25"/>ते पछु तुमू काय देखने गया हुता? काय कमर क छिन्दरा पेहर्‍या हुय मानुस क? देख्या, जो भड़कीला छिंदरा पेहर्‍या आरू सुख विलास छे रयता छे, वो राजभवन मा रयता छे। <verse eid="LUK 7:25"/><verse number="26" style="v" sid="LUK 7:26"/>तो पछु काय देकने गया हुता? काय काही कागळीयान क? हाव, हाव तुमू छे कयता छे, वरना कागळीयान छे भी डाहला क। <verse eid="LUK 7:26"/><verse number="27" style="v" sid="LUK 7:27"/>यो त्योत् छे, जिनान बाराम शास्त्र मा लिखलो छे: ‘यहोवा–भगवान बोल्यो, हाव म्हार दूत क थारे ओगळ–ओगळ मोकलीस, जो थारे ओगळ वाट क सुधार से।’ <verse eid="LUK 7:27"/><verse number="28" style="v" sid="LUK 7:28"/>हाव तुमू छे कयता छे कि, बायर छे जनमछे, उनमा छे यहुन्ना बपतिस्मा देनेवाला छे मोट काही नी: पर जो यहोवा–भगवान क राज्य मा नाना छे नाना छे, वो ओका सी भी मोठ छे।”<verse eid="LUK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29"/>आरू सब साधारण मानसे ने सोमवीन आरू फाळो लेनेवाळा ने भी यहुन्ना क बपतिस्मा लीन यहोवा–भगवान क मार्ग सच्चा मान लेदा। <verse eid="LUK 7:29"/><verse number="30" style="v" sid="LUK 7:30"/>पुन फरीसि आरू व्यवस्थापक ने यहुन्ना छे बपतिस्मा नी लीन यहोवा–भगवान क मेहनत क आपने विषय मा टाल दिया।<verse eid="LUK 7:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31"/>ईशु बुलतो रयो, “शेवली कावा हाव इनीये युग क मानसे की बराबरी कुनी सी दम कि वो कुनीन समान छे? <verse eid="LUK 7:31"/><verse number="32" style="v" sid="LUK 7:32"/>वो उन पोर्‍या क समान छे जो बजार मा बठ्या हुय एक दिसरा छे आयड़ीन कयता छे, ‘हामु ने तुमरे करता पाव्वी वाजाड़ी, आरू तुमू नी नाचे; हामु विलाप क गीत गाया, आरू तुमू नी रोय’ <verse eid="LUK 7:32"/><verse number="33" style="v" sid="LUK 7:33"/>काहकि यहुन्ना बपतिस्मा देनेवावा नी रोटा खाता आश, पितो नी माय, आरू तुमू कयता होय, ‘उका मा साहळा छे।’ <verse eid="LUK 7:33"/><verse number="34" style="v" sid="LUK 7:34"/>मानुस क पोर्‍य खातो पीतो आयो छे, आरू तुम कयता होय, ‘देखु पेटू आरू साकट्य छे आरू तुमू फाळो लेनेवाळा क आरू पापी क दोस्त।’ <verse eid="LUK 7:34"/><verse number="35" style="v" sid="LUK 7:35"/>पर यहोवा–भगवान क ज्ञान स्विकारता छे वो यो देखाडता छे वो ज्ञान सच छे।”<verse eid="LUK 7:35"/></para>
  <para style="s">ईशु पापी बायर क माफ करसे</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36"/>पछु एक फरीसि ने ओका सी विनती करी कि वो ओका साथे शेवली कावा वो उना फरीसि क घर मा जाईन रोटा खाने बठ्या। <verse eid="LUK 7:36"/><verse number="37" style="v" sid="LUK 7:37"/><note caller="+" style="x"><char style="xo" closed="false">7:37 </char><char style="xt" closed="false"><ref loc="MAT 26:7">मत्ती 26:7</ref>; <ref loc="MRK 14:3">मरकुस 14:3</ref>; <ref loc="JHN 12:3">यहुन्ना 12:3</ref></char></note>उना नगर की एक पापी बायर यो जानीन कि वो फरीसि क घर मा रोटा खाने बठ्या छे, एक बायर संगमरमर क वाटको मा इत्र लावी, <verse eid="LUK 7:37"/><verse number="38" style="v" sid="LUK 7:38"/>आरू ओका पाय क साथे, पछव उभी हईन, रडती होयी ओका पाय क आसू भिगाड़ी आरू आपसा मुनकान झटा छे नुछने लागी, आरू ओका पाय चूमकर उन पर इत्र लागाड़ी। <verse eid="LUK 7:38"/><verse number="39" style="v" sid="LUK 7:39"/>“यो देखीन वो फरीसि जो ओको बुलाया हुता, आपसा मन मा सुचने लाग्या, यदि यो भविष्यवक्ता हुता तो जान जाता कि यो जो ओको दरिया रयी छे वो कुन आरू कोसी बायर छे काहकि वो तो पापी छे।”<verse eid="LUK 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40"/>ईशु ओको जवाब मा कयो,</para>
  <para style="p" vid="LUK 7:40">“हे शमौन, मखे तुखे छे काय कयनो छे।” वो बुल,</para>
  <para style="p" vid="LUK 7:40">शमौन कयो “ए गुरू काय।”<verse eid="LUK 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41"/>ईशु कयो, “काही महाजन क दुय देनदार हुता, एक पाच सौ आरू दीसर पचास दीनार क देनदार हुता। <verse eid="LUK 7:41"/><verse number="42" style="v" sid="LUK 7:42"/>जव ओको साथे पछो आपने क कायनी रया, तो त्यो दुय क माफ कर दिया। एरकरीन ओका छे कुन ओका सी सवटो मोंग राखछे?”<verse eid="LUK 7:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43"/>शमौन ने जवाब दिया, “मारी समझ्या मा वो जेरो त्यो सवटो छुड़ दिया।”</para>
  <para style="p" vid="LUK 7:43">ईशु ओका सी कयो, “तु सय कयो।” <verse eid="LUK 7:43"/><verse number="44" style="v" sid="LUK 7:44"/>आरू उना बायर की आरू पुगीन त्यो शमौन छे कयो, “काय तु इनीये बायर क देखता छे? हाव तारे घर मा आश पुन तुने मारा पाय धुवने क करता पानी नी देदा, पर यो मारे पाय आसू छे भिजवने आरू आपने झटा छे नुछया। <verse eid="LUK 7:44"/><verse number="45" style="v" sid="LUK 7:45"/>तुने मखे स्वागत चूमा नी दिया, पर जव छे हाव आश छे तव छे यो मारा पाय क चूमना नी छुड़िया। <verse eid="LUK 7:45"/><verse number="46" style="v" sid="LUK 7:46"/>तुने मारा मुनका पर तेल नी लागाड़या, पर यो मारे पाय पर इत्र लागाड़या छे। <verse eid="LUK 7:46"/><verse number="47" style="v" sid="LUK 7:47"/>एरकरीन हाव तुखे छे कयता छे कि ओका पाप जो घोणा हुता, माफ हुय, काहकि यो घोणा मोंग कर्‍या; पर जेरो थुड़ा माफ छे, वो थुड़ा मोंग करता छे।”<verse eid="LUK 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48"/>आरू त्यो बायर छे कयो, “तारे पाप माफ हुय।”<verse eid="LUK 7:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49"/>तव जो मानसे ओका साथे रोटा खाने बठ्या हुता, वो आपने मन मा सुचने लाग्या, “यो कुन छे जो पाप क भी माफ करता छे?”<verse eid="LUK 7:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50"/>पर बायर छे कयो, “तारे विश्वास ने तुखे वाचड़ लेदा छेन कुशल छे चाली जा।”<verse eid="LUK 7:50"/></para>
  <chapter eid="LUK 7"/>
  <chapter number="8" style="c" sid="LUK 8"/>
  <para style="s">ईशु क सेवा करनाय बायर</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1"/>ओका बाद ईशु नगर आरू गाव खबर करता हुया, आरू यहोवा–भगवान क राज्य क खुश खबर सोमवता हुया पुगनेन लाग्या, आरू वो बारा ओको साथे हुता, <verse eid="LUK 8:1"/><verse number="2" style="v" sid="LUK 8:2"/><note caller="+" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="MAT 27:55">मत्ती 27:55</ref>,<ref loc="MAT 27:56">56</ref>; <ref loc="MRK 15:40">मरकुस 15:40</ref>,<ref loc="MRK 15:41">41</ref>; <ref loc="LUK 23:49">लूका 23:49</ref></char></note>आरू काही बायर भी होती जो विटळ आत्मा निकावी होती, आरू बीमारी छे छुड़ाय गयी होती आरू वो यो छे; मरियम जो मगदलीनी कवायती होती, जीनमा छे सात दुष्टत्मा नीकावती होती। <verse eid="LUK 8:2"/><verse number="3" style="v" sid="LUK 8:3"/>आरू हेरोदेस क भण्डारी खुजा की बायर यहुन्ना, आरू सूसन्नाह, आरू घोणा सी दिसरा बायर। यो आपसी सम्पत्ति छे ओकी सेवा करती होती।<verse eid="LUK 8:3"/></para>
  <para style="s">वेरनेवावा क दृष्टान्त</para>
  <para style="r">(<ref loc="MAT 13:1-9">मत्ती 13:1-9</ref>; <ref loc="MRK 4:1-9">मरकुस 4:1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4"/>जव मोटी गर्दी एखटी होयी आरू नगर क मानसे ओको साथे चाली आवता हुता, तो त्यो सपना मा कयो:<verse eid="LUK 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 8:5"/>“एक वेरनेवावा बीज वेरने निकव्य। वेरता हुयो काही मार्ग क धोड़े पड़्यो, आरू रौंदा गया, आरू वादळा क चिल्ला ने खाय गया। <verse eid="LUK 8:5"/><verse number="6" style="v" sid="LUK 8:6"/>काही चठ्ठा पर पड़्या, आरू उगियो, पुन तारी नी मिवने छे सूख गया। <verse eid="LUK 8:6"/><verse number="7" style="v" sid="LUK 8:7"/>काही बिज काटाक क वीच मा पड़्या, आरू झाड़का ने साथे बढ़ीन ओको दाब दिया। <verse eid="LUK 8:7"/><verse number="8" style="v" sid="LUK 8:8"/>काही वारली धरती पर पड़्या, आरू उगीन सौ गुणा फव लाया।”</para>
  <para style="p" vid="LUK 8:8">यो कयीन त्यो उचा ओवाज छे कयो, “ओका सोमवने क कान्टा होय वो सोमवने लेय।”<verse eid="LUK 8:8"/></para>
  <para style="s">दाखला क मतलब</para>
  <para style="r">(<ref loc="MAT 13:10-17">मत्ती 13:10-17</ref>; <ref loc="MRK 4:10-20">मरकुस 4:10-20</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9"/>ईशु क चेला ने ओका सी पुछ्या कि इनीये उदाहरण क मतलब काय छे? <verse eid="LUK 8:9"/><verse number="10" style="v" sid="LUK 8:10"/>त्यो कयो, “तुमूब क यहोवा–भगवान क राज्य क भेदो की समझ देदी गयी छे, पर दिसरा क दृष्टान्त मा सोमवाया जाता छे, एरकरीन वो देखता हुया भी नी देख्या, आरू सोमवता हुया भी नी समझ्या।”<verse eid="LUK 8:10"/></para>
  <para style="s">बीज वेरने वाळा क दाखलो समझड़नो</para>
  <para style="r">(<ref loc="MAT 13:18-23">मत्ती 13:18-23</ref>; <ref loc="MRK 4:13-20">मरकुस 4:13-20</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11"/>“दृष्टान्त क मतलब यो छे: बीज यहोवा–भगवान क वचन छे।” <verse eid="LUK 8:11"/><verse number="12" style="v" sid="LUK 8:12"/>मार्ग क धोड़े क वो छे, जिन्होने; सोमव्या तव शैतान आवीन ओको मन मा छे वचन उठ्या लेय जाता छे कि कयी ओसो नी होय कि वो विश्वास करीन उध्दार देख्या। <verse eid="LUK 8:12"/><verse number="13" style="v" sid="LUK 8:13"/>दगड़ा पर पड़लं बीज क चा मानसे छे जव सोमवता छे, तो खुशी छे वचन क मान्य तो करता छे, पुन मुव नी दरिया छे वो थुड़ी देर तक विश्वास राखता छे आरू परीक्षा क टेहाव भड़की जाता छे। <verse eid="LUK 8:13"/><verse number="14" style="v" sid="LUK 8:14"/>जो झाड़का मा पड़्या, यो वो छे जो सोमवता छे, पर ओगव चालीन चिंता, आरू धन आरू जीवन क सुखविलास मा फंस जाता छे आरू उनको फव नी पाकता। <verse eid="LUK 8:14"/><verse number="15" style="v" sid="LUK 8:15"/>पर वारली धरती मा क वो छे, जो वचन सोमवीन भले आरू वारू मन मा सम्भाले रयता छे, आरू धीरज छे फव लावतो छे।<verse eid="LUK 8:15"/></para>
  <para style="s">दीवो क दृष्टान्त</para>
  <para style="r">(<ref loc="MAT 4:21-25">मत्ती 4:21-25</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:16 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:15">मत्ती 5:15</ref>; <ref loc="LUK 11:33">लूका 11:33</ref></char>
    </note>“काही दिया धपाड़्या क कागुन छे नाही ढांकता, आरू नी खाटला क नेचा राखता छे पुन दीवट पर राखता छे कि माहीय आवनेवाळा प्रकाश देख्या।”<verse eid="LUK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 8:17"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">8:17 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:26">मत्ती 10:26</ref>; <ref loc="LUK 12:2">लूका 12:2</ref></char>
    </note>काही डुका नी जो प्रगट नी होय, आरू नी काही सातायलो छे जो जाने नी जाय आरू प्रगट नी होय।<verse eid="LUK 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 8:18"/>“एरकरीन चोकचौळीया रयो कि तुमू काय रीति छे सोमवता होय? काहकि ओका साथे छे ओको दिया जाछे, आरू ओका साथे नी छे ओका सी वो भी ली लेदा जाछे, जिनाक त्यो ओको समझे।”<verse eid="LUK 8:18"/></para>
  <para style="s">ईशु क माय आरू भाईस</para>
  <para style="r">(<ref loc="MAT 12:46-50">मत्ती 12:46-50</ref>; <ref loc="MRK 3:31-35">मरकुस 3:31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19"/>ईशु कि माय आरू ओका भाईस ओको साथे आश, पर गर्दी क कारण उना भेंट नी कर सक्या। <verse eid="LUK 8:19"/><verse number="20" style="v" sid="LUK 8:20"/>ओका सी कयो गया, “तारी माय आरू तारो भाईस बाहरता उबो हुया तुखे छे मिवने जुवता छे।”<verse eid="LUK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21"/>ईशु ओका जवाब मा उनछे कयो, “मारी माय आरू मारो भाईस योही छे, जो यहोवा–भगवान क वचन सोमवता आरू मानता छे।”<verse eid="LUK 8:21"/></para>
  <para style="s">आंझी क शांत करने</para>
  <para style="r">(<ref loc="MAT 8:23-27">मत्ती 8:23-27</ref>; <ref loc="MRK 4:35-41">मरकुस 4:35-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22"/>पछु एक दाहड़ो वो आरू ईशु क चेला ढोंड्या पर चढ़िया, आरू त्यो उनछे कयो, “आवु, दरिया क पार चाल्या।” शेवली कावा त्या ढोंड्या उघाड दिया आरू निकवी गया। <verse eid="LUK 8:22"/><verse number="23" style="v" sid="LUK 8:23"/>पर जव ढोंड्या चाल रयी होती, तो ईशु सूय गया: आरू ढोंड्या पर वादुन आयो, आरू ढोंड्या पानी छे भरायने लागी आरू वो जोखिम मा हुता। <verse eid="LUK 8:23"/><verse number="24" style="v" sid="LUK 8:24"/>तव त्या साथे आवीन ओको धरती, आरू कयो, “भगवान! भगवान! हामु नाश हुया जाता छे।”</para>
  <para style="p" vid="LUK 8:24">तव त्यो उठीन वादुन क आरू पानी की लहरो क उबराख्य आरू वो रूक गया आरू चैन होय गया। <verse eid="LUK 8:24"/><verse number="25" style="v" sid="LUK 8:25"/>तव त्यो उनछे कयो, “तुमरा विश्वास क छे?”</para>
  <para style="p" vid="LUK 8:25">पर वो घाबराय गया आरू घबराय हईन आपस मा कयनो लाग्या, “यो कुन छे जो वादुन आरू पानी क भी हुकुम देता छे, आरू वो ओकी मानता छे?”<verse eid="LUK 8:25"/></para>
  <para style="s">दृष्टात्माग्रस्त मानुस क वारू करने</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26"/>पछु ईशु आरू ओका चेला गिरासेनियो क देश मा पुच्या, दरिया क उना पार गलील क सामने छे। <verse eid="LUK 8:26"/><verse number="27" style="v" sid="LUK 8:27"/>जव वो धोड़े पर उतरीया तो उना नगर क एक मानुस उको मिव्यो जिनामा साहळा होती। वो घोणा दाहड़ा छे नी लुगड़ा पेहरतो हुतो आरू नी घर मा रयता हुता वरना बीड़ा मा रया करतो हुतो। <verse eid="LUK 8:27"/><verse number="28" style="v" sid="LUK 8:28"/>वो ईशु क देखीन आयड़ीया आरू ओको सामने जिरेत मोटेत ओवाज छे कयो, “हे सयाळा प्रधान यहोवा–भगवान क पोर्‍या ईशु! मखेछे तुखे छे काय काम? हाव तुखे छे रावन्या करता छे, मखे शिक्षा नी देय।” <verse eid="LUK 8:28"/><verse number="29" style="v" sid="LUK 8:29"/>काहकि वो उना साहळा क उना मानुस मा छे निकावने की हुकुम देय रया हुता, एरकरीन कि वो उना पर घड़ी मजबुत होयती होती। यद्यपि मानसे ओको साकव आरू बेड़ी छे बांधता हुता, तौभी वो बांधने क तुडीन नाखता हुता, आरू दूष्टात्मा ओको जंगल मा ढासाडीन फिरती होती।<verse eid="LUK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30"/>“ईशु ओका सी पुछु थारो काय नाव छे?”</para>
  <para style="p" vid="LUK 8:30">त्यो कयो, “सेना” काहकि मानसक घोणा साहळा शैतान उको भराय गया हता। <verse eid="LUK 8:30"/><verse number="31" style="v" sid="LUK 8:31"/>ईशु ओका अनुनय रावन्या करने लाग्यो कि हामु आंधारा कुण्ड मा जानेन हुकुम मा देय।<verse eid="LUK 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32"/>वा बयड़ा पर सुहर्‍या क एक मोटा हाववो चर रयो हुतो, एरकरीन वो ने ओको तीनुक जाने दिया। <verse eid="LUK 8:32"/><verse number="33" style="v" sid="LUK 8:33"/>तव साहळा उना मानुस मा छे निकवीन सुहर्‍या मा गयी आरू त्यो झुण्ड टेकड़ा पर सी पर झापटाय न गलील दरिया मा जाय पड़्या आरू डूबीन मर गयो।<verse eid="LUK 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34"/>चारनेवावा यो जो हुया हुता देखीन ढासा, आरू नगर मा आरू गाँव मा जाईन ओको खबर दिया। <verse eid="LUK 8:34"/><verse number="35" style="v" sid="LUK 8:35"/>मानसे यो जो हुयो हुतो ओको देखने क निकव्या, आरू ईशु क साथे आवीन जिना मानुस छे साहळा निकावी होती, ओको ईशु क पाय क साथे लुगड़ा पेहरने आरू सचेत बठ्या हुया देखीन घाबराय गयो; <verse eid="LUK 8:35"/><verse number="36" style="v" sid="LUK 8:36"/>आरू देखनेवावा ने उन मानसे क कयो कि वो साहळा क सताया हुया मानुस काही प्रकार वारू हुया। <verse eid="LUK 8:36"/><verse number="37" style="v" sid="LUK 8:37"/>तव गिरासेनियो क सब मानसे ने ईशु छे विनती करीन काहकि, हामरे या छे चाली जा, काहकि उन पर घणी बीक भराय गय हुता। अळते वो ढोंड्या पर चढ़ीन पछु गया। <verse eid="LUK 8:37"/><verse number="38" style="v" sid="LUK 8:38"/>जिना मानुस मा छे साहळा निकावी होती वो ओका सी रावन्या करने लाग्या कि मखे आपने साथे रयने देय,</para>
  <para style="p" vid="LUK 8:38">पुन ईशु ओको वाट लागाड़ी कयो, <verse eid="LUK 8:38"/><verse number="39" style="v" sid="LUK 8:39"/>“आपने घर क पछो जाय आरू मानसे छे कयो कि यहोवा–भगवान ने तारे करता कोसो मोठ काम कामो छे। वो ने तारे करता कोसो मोठ काम कर्‍या छे।”</para>
  <para style="p" vid="LUK 8:39">वो जाईन सब नगर मा खबर करने लाग्या कि ईशु मारे करता कोसो मोठ काम कामो।<verse eid="LUK 8:39"/></para>
  <para style="s">याईर मरली पोराय आरू बीमार बायर</para>
  <para style="r">(<ref loc="MAT 9:18-26">मत्ती 9:18-26</ref>; <ref loc="MRK 5:21-43">मरकुस 5:21-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40"/>जव ईशु पछो आयो तो मानसे ओका खुशी क साथे मिव्य, काहकि वो सब ओकी वाट जुय रया हुता। <verse eid="LUK 8:40"/><verse number="41" style="v" sid="LUK 8:41"/>ओतरा मा याईर नाव क एक मानुस जो यहूदि यो आराधना घर क सरदार हुतो, आश आरू ईशु क पाय पर पड़्यो क ओका सी रावन्या करने लाग्या कि मारे घर चाल, <verse eid="LUK 8:41"/><verse number="42" style="v" sid="LUK 8:42"/>काहकि ओको बारा साल की एकुत पोराय होती, आरू वो मरना पर पड़ जी ही</para>
  <para style="p" vid="LUK 8:42">तव ईशु जाय रयो हुतो तव मानसे ओको पर गिर पड़ता हुता। <verse eid="LUK 8:42"/><verse number="43" style="v" sid="LUK 8:43"/>एक बायर ने जिना क बारा साल छे लुहूय यो बहनीन क बीमार हुतो, आरू जो आपसी सारी जीविका वैद्यो क पछव व्यय कर त्योकी होती, तवभी काही क छे हात फावो नी होय सकी होती, <verse eid="LUK 8:43"/><verse number="44" style="v" sid="LUK 8:44"/>पछव छे आवीन ओका छिंदरा क छेवड़ा क हाथ लागाड़ताज, आरू तत्काल ओका लुहूय यो उहवनो बंद होय गया। <verse eid="LUK 8:44"/><verse number="45" style="v" sid="LUK 8:45"/>इनीये पर ईशु कयो, “मखे कुन धर्‍य?” जव सब मुकरने लाग्या, ते पतरस क कयो,</para>
  <para style="p" vid="LUK 8:45">“हे गुरू, तुखे ते गर्दी दाबाय रयी छे आरू तुखे पर पड़ पड़ती छे।”<verse eid="LUK 8:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46"/>पुन ईशु कयो, “कोय मखे छिमियो, काहकि हाव ने जान लेदो छे कि मखे मा छे शक्ति निकावी छे।” <verse eid="LUK 8:46"/><verse number="47" style="v" sid="LUK 8:47"/>जव पोराय देखी कि ची डुकाय नी सकती, तव कापती होयी आवी आरू ओका पाय पड़ीन सब मानसे क सामने देखाड्या कि त्यो काही कारण छे ओको दरिया, आरू कोसो तत्काल वारू होय गयी। <verse eid="LUK 8:47"/><verse number="48" style="v" sid="LUK 8:48"/>त्यो ओका सी कयो, “पोराय, थारो विश्वास ने तुखे वारू कर्‍या छे, शांती छे जात रय।”<verse eid="LUK 8:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49"/>वो यो कय रया हुता कि कोय यहूदि यो आराधना घर क सरदार क या से एक मानुस आवीन कयो, “तारी पोराय मर गयी: गुरू क दुःख नी देता।”<verse eid="LUK 8:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50"/>ईशु यो सोमवीन ईशु क जवाब देदो, “नी घाबराय मा। केवल विश्वास राख, ते वो वारू होय जाछे।”<verse eid="LUK 8:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51"/>घर मा आवीन त्यो पतरस, यहुन्ना याकूब, आरू पोराय क आय बास क छुड़ीन दिसरा काही क आपने साथे माहीय आवने नी दिया। <verse eid="LUK 8:51"/><verse number="52" style="v" sid="LUK 8:52"/>सब ओका करता रड़ पीट रया हुता, पुन ईशु कयो, “रडु मा पोराय मरी नी पुन सुय रयी छे।”<verse eid="LUK 8:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53"/>वो यो जानीन कि मर गयी छे ओकी हासी करने लाग्या। <verse eid="LUK 8:53"/><verse number="54" style="v" sid="LUK 8:54"/>पुन त्यो ओको हात दरिया, आरू आयड़ने कयो, “हे पोराय उठ।” <verse eid="LUK 8:54"/><verse number="55" style="v" sid="LUK 8:55"/>तव ओको जीव पछु वापस आयो आरू पोराय तत्काल उठी बठी। पछु ईशु हुकुम देदी कि ओको काय खाने क काय आपसु। <verse eid="LUK 8:55"/><verse number="56" style="v" sid="LUK 8:56"/>ओका माय बास चकित हुया, पुन त्यो तीनुक चिताया कि यो जो हयो छे काही छे नी कयनो।<verse eid="LUK 8:56"/></para>
  <chapter eid="LUK 8"/>
  <chapter number="9" style="c" sid="LUK 9"/>
  <para style="s">बारा प्रेरितन क मुकल्या जान</para>
  <para style="r">(<ref loc="MAT 10:5-15">मत्ती 10:5-15</ref>; <ref loc="MRK 6:7-13">मरकुस 6:7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1"/>पछु ईशु बारा चेला क बुलावीन तीनुक सब साहळा आरू बीमारी क दूर करने की शक्ति आरू हक दिया, <verse eid="LUK 9:1"/><verse number="2" style="v" sid="LUK 9:2"/>आरू त्यो तीनुक यहोवा–भगवान क राज्य क खबर करने आरू बीमार क वारलो करने क करता मुकल्या। <verse eid="LUK 9:2"/><verse number="3" style="v" sid="LUK 9:3"/>ईशु ओका कयो, “मार्ग क करता काही नी ते लाकड़ी, नी झुली, नी रोटा, नी पोशा आरू नी दुय सुटर। <verse eid="LUK 9:3"/><verse number="4" style="v" sid="LUK 9:4"/>जा काही घर मा तुमू उतरीया, चो रवु, आरू चा रयन वाट लागाड़ देदा। <verse eid="LUK 9:4"/><verse number="5" style="v" sid="LUK 9:5"/><note caller="+" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="ACT 13:51">प्रेरितन 13:51</ref></char></note><note caller="+" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">लूका 10:4-11</ref></char></note>जो काही तुमू मान्य नी करे, उना नगर छे निकवता हुया आपने पाय की धुवो बाहरी नाख्या कि उन पर गवा होय।”<verse eid="LUK 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 9:6"/>अळते वो निकावीन गाँव खुश खबर सोमवाता, आरू हर कयी मानसे क वारू करता हुया पुगता छे।<verse eid="LUK 9:6"/></para>
  <para style="s">हेरोदेसे की उलझन</para>
  <para style="r">(<ref loc="MAT 14:1-12">मत्ती 14:1-12</ref>; <ref loc="MRK 6:14-29">मरकुस 6:14-29</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:7 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:14">मत्ती 16:14</ref>; <ref loc="MRK 8:28">मरकुस 8:28</ref>; <ref loc="LUK 9:19">लूका 9:19</ref></char>
    </note>देश क चौथाई क राजा हेरोदेस यो सब सोनवीन घाबराय गयो, काहकि काही ने कयो कि बपतिस्मा करनेवावा यहुन्ना मरलो हुया मा जीव उठ्यो छे, <verse eid="LUK 9:7"/><verse number="8" style="v" sid="LUK 9:8"/>आरू काही ने यो कि एलियाह देखाय दिदो छे, आरू दिसरा ने यो कि जुनलो भविष्यवक्ता मा छे काही जीव उठ्यो छे। <verse eid="LUK 9:8"/><verse number="9" style="v" sid="LUK 9:9"/>पुन हेरोदेस ने कयो, “यहुन्ना क तो हाव ने मुनको कटाड़ीयो, हिमी यो कुन छे ओका विषय मा ओसी वात सोमवता छे?” आरू त्यो ओको देखने की मरजी करी।<verse eid="LUK 9:9"/></para>
  <para style="s">ईशु पाच हजार मानसे क खावड़ायो</para>
  <para style="r">(<ref loc="MAT 14:13-21">मत्ती 14:13-21</ref>; <ref loc="MRK 6:30-44">मरकुस 6:30-44</ref>; <ref loc="JHN 6:1-14">यहुन्ना 6:1-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10"/>पछु प्रेरितन पुगीन जो काही त्या कर्‍या हुता, ओको देखाड़ दिया; आरू वो तीनुक अलग करीन बैतसैदा ढोंड्या नगर क ली गया। <verse eid="LUK 9:10"/><verse number="11" style="v" sid="LUK 9:11"/>यो जानीन गर्दी ओको पछव होय गयी, आरू वो खुशी क साथे उनछे मिव्य, आरू उनछे यहोवा–भगवान क राज्य की वात करने लाग्या, आरू जो वारू हुयने जुवता हुता तीनुक वारू कर्‍या।<verse eid="LUK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12"/>जव दाहडु ढवने लाग्या तो ईशुन बारा चेला ने आवीन ओका सी कयो, “गर्दी क वाट लागाड़ीन चार तरफ गाँव आरू वस्तीमा मा जाईन टिके आरू खानो क उपाय करे, काहकि हामु या सुनसान जागामा छे।”<verse eid="LUK 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13"/>त्यो उनछे कयो, “तुमू ही तीनुक खाने क आपो।”</para>
  <para style="p" vid="LUK 9:13">त्या कयो, “हामरे साथे पाच रूटा आरू दुय मासा क छुड़ीन आरू काही नी; पुन हाव यदि हामु जाईन इन सब मानसे क करता खानो मुवे लेदा, तो होय सकता छे।” वो मानसे तो पाच हजार मानसे लग–भग हुता। <verse eid="LUK 9:13"/><verse number="14" style="v" sid="LUK 9:14"/>“काहकि वा सारी पाच हजार लोगहन हुता”</para>
  <para style="p" vid="LUK 9:14">आरू त्यो आपसा चेला सी कयो, उन लोगहन क बठाड़ देयो।<verse eid="LUK 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 9:15"/>त्या ओसो ही कर्‍या, आरू सब क बठाड़ दिया। <verse eid="LUK 9:15"/><verse number="16" style="v" sid="LUK 9:16"/>तव त्यो वो पाच रूटा आरू मासा लावी, आरू सोरगदूत की आरू देखीन यहोवा–भगवान क धन्यवाद कर्‍या, आरू तुड़ी तुड़ीन चेला क देता गया कि मानसे क पुरछे। <verse eid="LUK 9:16"/><verse number="17" style="v" sid="LUK 9:17"/>तव सब खाईन तुप्त हुया, आरू चेला ने वाच्या हुया तुकड़ा छे बारा खिल्ला भरीन हाकलिया।<verse eid="LUK 9:17"/></para>
  <para style="s">पतरस क ईशु क मसीह स्वीकार करने</para>
  <para style="r">(<ref loc="MAT 16:13-19">मत्ती 16:13-19</ref>; <ref loc="MRK 8:27-29">मरकुस 8:27-29</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18"/>जव वो एखला मा प्रार्थना कर रया हुता आरू चेला ओको साथे हुता, तो त्यो उनछे पुछ्या, “मानसे मखे काय कयता छे?”<verse eid="LUK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:19 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 14:1">मत्ती 14:1</ref>,<ref loc="MAT 14:2">2</ref>; <ref loc="MRK 6:14">मरकुस 6:14</ref>,<ref loc="MRK 6:15">15</ref>; <ref loc="LUK 9:7">लूका 9:7</ref>,<ref loc="LUK 9:8">8</ref></char>
    </note>त्या जवाब दिया, “यहुन्ना बपतिस्मा देनेवावा, आरू काही एलियाह, आरू काही यो कि जुनला भविष्यवक्ता मा छे काही जीवीन उठ्या छे।”<verse eid="LUK 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:20 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 6:68">यहुन्ना 6:68</ref>,<ref loc="JHN 6:69">69</ref></char>
    </note>त्यो उनछे पुछ्या, “पुन तुमू मखे काय कयता होय?”</para>
  <para style="p" vid="LUK 9:20">पतरस ने उनछे जवाब दिया, “यहोवा–भगवान ने मुकलनेवावा मसीह छे।”<verse eid="LUK 9:20"/></para>
  <para style="s">आपने मरना क विषयमा ईशु कि भविष्यव्दाणी</para>
  <para style="r">(<ref loc="MAT 16:20-28">मत्ती 16:20-28</ref>; <ref loc="MRK 8:30-9:1">मरकुस 8:30–9:1</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21"/>तव त्यो तीनुक आयड़ीन कयो कि यो काही छे नी कयनो। <verse eid="LUK 9:21"/><verse number="22" style="v" sid="LUK 9:22"/>पछु ईशु कयो, “मानुस क पोर्‍या क करता पाको छे कि वो घोणा दुःख झेलीया, आरू डाहडा आरू मुखी पुजारा आरू शास्त्री ओको तुच्छ समझीन मार नाखने, आरू वो तीसरो दाहड़े जीव उठ्यो।”<verse eid="LUK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:23 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:38">मत्ती 10:38</ref>; <ref loc="LUK 14:27">लूका 14:27</ref></char>
    </note>त्यो सब छे कयो, “यदि काही मारे पछव आवने जुवे, तो आपने आप छे मना करे आरू हर दाहाड़े आपसो कुरूस हाकलिया हुया मारे पछव होय लेदा। <verse eid="LUK 9:23"/><verse number="24" style="v" sid="LUK 9:24"/>काहकि जो काही आपसा जीव क वाचाड़से वो ओको खुवसे, पुन जो काय म्हारेन करता आपसा जीव क खुवसे त्योत् उको वाचाड़छे। <verse eid="LUK 9:24"/><verse number="25" style="v" sid="LUK 9:25"/>यदि मानुस सब जग क हासिल कामो आरू आपसा जीव खुय देय या ओकी हानि उठाय, तो ओको काय लाभ होयछे? <verse eid="LUK 9:25"/><verse number="26" style="v" sid="LUK 9:26"/>जो काही मखे छे आरू मारी वात छे लाजवायछे, मानुस क पोर्‍य भी, जव आपसी आरू आपसा बास की आरू चुखलो सोरगदूतो क महिमा साथे आवसे, तो ओका सी लाजवायछे। <verse eid="LUK 9:26"/><verse number="27" style="v" sid="LUK 9:27"/>हाव तुमूछे सच कयता छे, कि जो याहा उबा छे, उनमा छे काही ओसा छे कि जव तक यहोवा–भगवान क राज्य नी देख लेय, तव तक मरना क हवाद चुखछे।”<verse eid="LUK 9:27"/></para>
  <para style="s">ईशु क रूपान्तर</para>
  <para style="r">(<ref loc="MAT 17:1-8">मत्ती 17:1-8</ref>; <ref loc="MRK 9:2-8">मरकुस 9:2-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28"/>इन वात क काही आगठा दाहड़ा बाद वो पतरस, यहुन्ना आरू याकूब क साथे लीन प्रार्थना करने क करता बयड़ा पर गया। <verse eid="LUK 9:28"/><verse number="29" style="v" sid="LUK 9:29"/>जव ईशु प्रार्थना कर ही रया हुता, तो ओका चेहरा क रूप बदलाय गयो, आरू ओका छिन्दरा श्वेत हईन चमकने लाग्या। <verse eid="LUK 9:29"/><verse number="30" style="v" sid="LUK 9:30"/>आरू उचकाळुन मूसा आरू एलियाह, यो दुय मानसे ओको साथे वात कर रया हुता। <verse eid="LUK 9:30"/><verse number="31" style="v" sid="LUK 9:31"/>यो महिमा साथे देखाय दिया आरू ईशु क मरना की चर्चा कर रया हुता, जो यरूशलेम मा हुयने वालो हुता। <verse eid="LUK 9:31"/><verse number="32" style="v" sid="LUK 9:32"/>पतरस आरू ओका साथी नीद छे भर्‍या हुता, आरू जव वारली तरह सचेत हुया, तो ओकी महिमा आरू उन दुय मानसे क, जो ओको साथे उबा हुता, देख्या। <verse eid="LUK 9:32"/><verse number="33" style="v" sid="LUK 9:33"/>जव वो ओको साथे छे जाने लाग्या, तो पतरस ने ईशु छे कयो, “हे भगवान, हामरा याहा रयने खुशी छे: शेवली कावा हामु तीन मण्डप बनावसु, एक तारे करता, एक मूसा क करता, आरू एक एलियाह क करता।” वो जानता नी हुता कि काय कय रया छे।<verse eid="LUK 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34"/>वो यो कय ही रया हुता कि एक वादवो ने आवीन तीनुक छा लेदो, आरू जव वो ओको वादवा छे घिरने लाग्या तो घाबराय गया। <verse eid="LUK 9:34"/><verse number="35" style="v" sid="LUK 9:35"/><note caller="+" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 3:17">मत्ती 3:17</ref>; <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 1:11">मरकुस 1:11</ref>; <ref loc="LUK 3:22">लूका 3:22</ref></char></note><note caller="+" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="2PE 1:17">2 पतरस 1:17</ref>,<ref loc="2PE 1:18">18</ref></char></note>तव उना वादवो मा छे यो ओवाज निकव्य, “यो मारो पोर्‍य आरू मारो निवाड़या हुयो छे, ओकी सोमवु।”<verse eid="LUK 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 9:36"/>यो ओवाज होत ही ईशु ऐखलो देखाय गयो; आरू वो चुप रयो, आरू जो काय देखाय हुतो ओकी काही वात उन दाहड़ा मा काही छे नी कयी।<verse eid="LUK 9:36"/></para>
  <para style="s">दृष्टात्माग्रस्त पोर्‍या क वारू करने</para>
  <para style="r">(<ref loc="MAT 17:14-18">मत्ती 17:14-18</ref>; <ref loc="MRK 9:14-27">मरकुस 9:14-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37"/>दिसरे दाहड़े जव ईशु आरू तीन चेला बयड़ा छे उतरियो तो एक मोटी गर्दी ओको छे आय मिवी। <verse eid="LUK 9:37"/><verse number="38" style="v" sid="LUK 9:38"/>आरू देखो, गर्दी मा छे एक मानुस ने आयडी कयो, “हे पोरबु, हाव तुखे छे रावन्या करता छे कि मारा पोर्‍या पर किरपा कर; काहकि वो मारो एक खुळिया पोर्‍या छे। <verse eid="LUK 9:38"/><verse number="39" style="v" sid="LUK 9:39"/>आरू देख, एक साहळा ओको धरती छे, आरू वो एकदम आयडी उठे; आरू वो ओको ओसो मरोड़ती छे कि वो मुय मा जीभ भर लावता छे; आरू ओको कुचळीन वातड़ी मेहनत छुड़ती छे। <verse eid="LUK 9:39"/><verse number="40" style="v" sid="LUK 9:40"/>हाव ने तारे चेला छे रावन्या करी कि साहळा निकाव, पुन वो नी निकाव सक्या।”<verse eid="LUK 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41"/>ईशु उनको जवाब दिया, “हे विनभुरसीया आरू हठीले मानछे, हाव किही तक तुमरे साथे रवीस आरू तुमरी सकछे? आपने पोर्‍या क याहा ली आय।”<verse eid="LUK 9:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42"/>वो पोर्‍या आय ही रया हुता कि साहळा ने ओको नाखीन मरोड़ा, पुन ईशु साहळा क लड़िया आरू पोर्‍या क वारू करीन ओका बास क आपी दिया <verse eid="LUK 9:42"/><verse number="43" style="v" sid="LUK 9:43"/>तव सब मानसे यहोवा–भगवान क महाशक्ति छे चकित हुया।</para>
  <para style="s" vid="LUK 9:43">दुसरी बार आपने मरना क विषयमा ईशु कि भविष्यवाणी</para>
  <para style="r" vid="LUK 9:43">(<ref loc="MAT 18:1-5">मत्ती 18:1-5</ref>; <ref loc="MRK 9:33-37">मरकुस 9:33-37</ref>)</para>
  <para style="p" vid="LUK 9:43">पुन जव सब मानसे उन सब काम छे जो वो करता हुता घबराय हुता, तो त्यो आपने चेला छे कयो, <verse eid="LUK 9:43"/><verse number="44" style="v" sid="LUK 9:44"/>“तुमू इन वात पर कान्टा देवु, काहकि मानुस क पोर्‍या मानुस क हातमा सौप दिया जाछे।” <verse eid="LUK 9:44"/><verse number="45" style="v" sid="LUK 9:45"/>पुन वो इन वात क नी जानने यो वात क नी सझता हुता, आरू उनछे डुकाय रयी कि वो ओको जानने नी देख्या; होती; आरू वो वात क विषय मा ईशु छे पुछा छे घाबराय हुता।<verse eid="LUK 9:45"/></para>
  <para style="s">आखा रया मोट कुन?</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">9:46 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:24">लूका 22:24</ref>
      </char>
    </note>पछु चेलामा यो विवाद हुयने लाग्यो कि हामु मा छे मोटो कुन छे। <verse eid="LUK 9:46"/><verse number="47" style="v" sid="LUK 9:47"/>पर ईशु ओको मनको विचार जान लेदो, आरू एक पोर्‍या क लीन आपने साथे उबा कर्‍या, <verse eid="LUK 9:47"/><verse number="48" style="v" sid="LUK 9:48"/><note caller="+" style="x"><char style="xo" closed="false">9:48 </char><char style="xt" closed="false"><ref loc="MAT 10:40">मत्ती 10:40</ref>; <ref loc="LUK 10:16">लूका 10:16</ref>; <ref loc="JHN 13:20">यहुन्ना 13:20</ref></char></note>आरू चेला छे कयो, “जु कुई मार नाव छे इन पोर्‍या क मान्य करता छे, चु मखे मान्य करतो छे; आरू जु कुई मखे मान्य करता छे, चु मखे मुकलनेवावा क मान्य करतो छे, काहकि जु तुमू मा सब छे नाना छे नाना छे, चु मोटो छे।”<verse eid="LUK 9:48"/></para>
  <para style="s">जो विरोध मा नी वो हामरा पक्ष मा छे</para>
  <para style="r">(<ref loc="MRK 9:38-40">मरकुस 9:38-40</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49"/>तव यहुन्ना ने कयो, “हे भगवान, हामु ने एक माणुस क तारे नाव साहळा क निकावता देख्या, आरू हामु ओको मना कर्‍या, काहकि वो हामरे साथे हईन तारे पछव नी होय लेता।”<verse eid="LUK 9:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50"/>ईशु ओका सी कयो, “ओको मना मा करू; काहकि जो तुमरे विरोध मा नी, वो तुमरी तरफ छे।”<verse eid="LUK 9:50"/></para>
  <para style="s">सामरिया द्वारा ईशु क विरोध</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51"/>जव ओको ऊपर उठाय जाने क दाहड़ा पूरा हुयने पर हुता, तो त्यो यरूशलेम जाने क विचार दृढ कर्‍या। <verse eid="LUK 9:51"/><verse number="52" style="v" sid="LUK 9:52"/>त्यो आपने ओगव मुकल्या। वो सामरिया क एक गाँव मा गया कि ओका करता धरती तीयार कर्‍या। <verse eid="LUK 9:52"/><verse number="53" style="v" sid="LUK 9:53"/>पुन उन मानसे ने ओको उतरने नी दिया, काहकि वो यरूशलेम जाय रया हुता। <verse eid="LUK 9:53"/><verse number="54" style="v" sid="LUK 9:54"/>यो देखीन ओका चेला याकूब आरू यहुन्ना ने कयो, “हे पोरबु, काय तु जुवता छे कि हामु हुकुम देय, कि आकाश छे आगठो पड़ीन तीनुक भस्म कर देय?”<verse eid="LUK 9:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 9:55"/>पुन त्यो पुगीन तीनुक लड़िया आरू कयो, “तुमू नी जानता कि तुमू कोसी आत्मा क होय। काहकि मानुस क पोर्‍या मानसे क जीव क नाश करने नी वरना वाचाड़ने क करता आश छे।” <verse eid="LUK 9:55"/><verse number="56" style="v" sid="LUK 9:56"/>आरू ईशु काही दिसरा गाव मा चाली गया।<verse eid="LUK 9:56"/></para>
  <para style="s">ईशु क चेला बनने क किमत</para>
  <para style="r">(<ref loc="MAT 8:19-22">मत्ती 8:19-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57"/>जव वो मार्गमा जाय रया हुता, तो कोय ने ओका सी कयो, “जा तु जाछे, हाव तारे पछव चालीस।”<verse eid="LUK 9:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58"/>ईशु ने ओका सी कयो, “कुल्या क धर आरू वादळा क चिल्ला क पांजरो हुतो छे, पर माणुस क पोर्‍या क मुनको हावकने भी धरती नी।” <figure style="fig" alt="Fox with kits in a hole" file="bk00051c।tif" size="col" copy="Horace Knowles ©" ref="9:58">धरोमा पिल्ला क साथे कुल्यो</figure><verse eid="LUK 9:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59"/>त्यो दिसराछे कयो, “मारे पछव होय लेय।” त्यो कयो,</para>
  <para style="p" vid="LUK 9:59">“हे पोरबु, मखे पेहले जाने दे कि आपसा बासक गाड़ देसे।”<verse eid="LUK 9:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60"/>ईशु ओका सी कयो, “मरलो हुयो क आपने मरला गाड़ ने दे, पर तु जाईन यहोवा–भगवान क राज्य कि कथा सोमवाय।”<verse eid="LUK 9:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61"/>एक आरू ने भी कयो, “हे पोरबु, हाव तारे पछव होय आवीस; पर पेहले मखे जाने दे कि आपने घरको मानसे जानेन आदेश लेवु।”<verse eid="LUK 9:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62"/>ईशु ओका सी कयो, “कायी आपसा हात हल पर राखीन पछव देखता छे, वो यहोवा–भगवान क राज्य काम करने योग्य नी।”<verse eid="LUK 9:62"/></para>
  <chapter eid="LUK 9"/>
  <chapter number="10" style="c" sid="LUK 10"/>
  <para style="s">तीनवीसु दस दुय चेला मुकल्या जाय</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1"/>इन वात क बाद पोरबुने तीनवीसु दस दुय आरू माणुस नियुक्त कर्‍या, आरू जीना–जीना नगर आरू धरती क वो आप जाने पर हुता, वाँ तीनुक दुय करीन आपने ओगव मुकल्या। <verse eid="LUK 10:1"/><verse number="2" style="v" sid="LUK 10:2"/><note caller="+" style="x"><char style="xo" closed="false">10:2 </char><char style="xt" closed="false"><ref loc="MAT 9:37">मत्ती 9:37</ref>,<ref loc="MAT 9:38">38</ref></char></note>ईशु आपसा चेला क कयो, पक्का खेत घोणा छे, पुन दाहाड़क्या कम छे; अतरानकरीन खेत क भगवान छे विनता कर्‍या कि चु आपने खेत काटने क दाहडक्या मुकल्या छे। <verse eid="LUK 10:2"/><verse number="3" style="v" sid="LUK 10:3"/><note caller="+" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="MAT 10:16">मत्ती 10:16</ref></char></note>जावु; हाव तुमूक गा़डरा क समान लेन्डीया क विचमा मुकल्या छे। <verse eid="LUK 10:3"/><verse number="4" style="v" sid="LUK 10:4"/>अतरानकरीन नी बटवो, नी झुली, नी खासड़ा ले; आरू नी मार्गमा काही क नमस्कार कर्‍या। <verse eid="LUK 10:4"/><verse number="5" style="v" sid="LUK 10:5"/>जा काही घर मा जावु, पेहले कयो, “इनीये घर पर भलो होय।” <verse eid="LUK 10:5"/><verse number="6" style="v" sid="LUK 10:6"/>यदि वाँ घर क मानसे काही भलो क योग्य होयछे, तो तुमरा भलो उना पर ठरछे, नी तो तुमरे साथे पुगीन आवसे। <verse eid="LUK 10:6"/><verse number="7" style="v" sid="LUK 10:7"/><note caller="+" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="1CO 9:14">1 कुरन्थियो 9:14</ref>; <ref loc="1TI 5:18">1 तीमुथियुस 5:18</ref></char></note>तीना घर मा रयो, आरू जो काय त्यो मिव्य, चो खाऊ, पीऊ, काहकि दाहडक्या क आपसी दाहड़की जोडने जुवे; घर–घर नी पुगनेन। <verse eid="LUK 10:7"/><verse number="8" style="v" sid="LUK 10:8"/>जीस नगरमा जावु आरू वाँ क मानसे तुम्हे हावक्या, तो जो काय तुमरे सामने राख्या जाय चो खाऊ। <verse eid="LUK 10:8"/><verse number="9" style="v" sid="LUK 10:9"/>वाँ क बीमारी क वारू कर्‍या आरू ओका कयो, “यहोवा–भगवान क राज्य तुमरे नाट आय पुग्यो छे।” <verse eid="LUK 10:9"/><verse number="10" style="v" sid="LUK 10:10"/><note caller="+" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="ACT 13:51">प्रेरितन 13:51</ref></char></note>पुन जीस नगरमा तुम जावु, आरू वाहा क मानसे तुम्हे मान्य नी कर्‍या, तो ओका बजारमा जाईन कयो, <verse eid="LUK 10:10"/><verse number="11" style="v" sid="LUK 10:11"/><note caller="+" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="MAT 10:7-14">मत्ती 10:7-14</ref>; <ref loc="MRK 6:8-11">मरकुस 6:8-11</ref>; <ref loc="LUK 9:3-5">लूका 9:3-5</ref></char></note>तुमरे नगर कि धरती भी, जो हामरे पायमा लागी छे, हामु तुमरे सामने बाहरने देता छे; तोभी यो जान लेय कि यहोवा–भगवान क राज्य तुमरे नाट आय पुच्चो। <verse eid="LUK 10:11"/><verse number="12" style="v" sid="LUK 10:12"/><note caller="+" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="MAT 11:24">मत्ती 11:24</ref>; </char><char style="xt" closed="false"><ref loc="MAT 10:15">मत्ती 10:15</ref></char></note>हाव तुमूछे कयता छे कि उना न्याय क दहाडे उना नगर कि दशा छे सदोम कि दशा सवटो सहने योग्य होयछे।<verse eid="LUK 10:12"/></para>
  <para style="s">विनभुरसीया नगर क धिक्कार</para>
  <para style="r">(<ref loc="MAT 11:20-24">मत्ती 11:20-24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13"/>“हाय खुराजीन! हाय बैतसैदा! जो शक्ति क काम तुमूमा कर्‍या गया, यदि वो सोर आरू सीदोन हाव कर्‍या जातो तो गंटो पांगरीन आरू रूखडामा बठीन वो किही क मन फिराय लेये।” <verse eid="LUK 10:13"/><verse number="14" style="v" sid="LUK 10:14"/>पुन न्याय क दाहडो तुमरी दशा छे सोर आरू सीदोन कि दशा सवटो सहने योग्य होयछे। <verse eid="LUK 10:14"/><verse number="15" style="v" sid="LUK 10:15"/>आरू हे कफरनहूम, काय तु सोरग तक उँचा कर्‍या जासे? तु तो नरक तक सुधो नेचो जाछे।<verse eid="LUK 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:16 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:40">मत्ती 10:40</ref>; <ref loc="MRK 9:37">मरकुस 9:37</ref>; <ref loc="LUK 9:48">लूका 9:48</ref>; <ref loc="JHN 13:20">यहुन्ना 13:20</ref></char>
    </note>ईशुने आपने चेला छे कयो, “जो तुमरी सोमवता छे, वो मारी सोमवता छे; आरू जो तुमूक तुच्छ जानता छे, वो मखे तुच्छ जानता छे; आरू जो मखे तुच्छ जानता छे, वो मारे मुकलनेवावा क तुच्छ जानता छे।”<verse eid="LUK 10:16"/></para>
  <para style="s">तीनवीसु दस दुय चेला पोछा पुगता</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17"/>वो तीनवीसु दस दुय खुशी करता हुया पोछा पुगता आरू कयनो लाग्या, “हे पोरबु, तारे नाव छे साहळा हामरे हुकुम मानता छे।”<verse eid="LUK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18"/>त्यो ओका सी कयो, “हाव शैतान क बिजली क समान सोरग छे पड़्या हुया देख रया हुता। <verse eid="LUK 10:18"/><verse number="19" style="v" sid="LUK 10:19"/>हाव ने तुम्हे घड़सा आरू विसु क उबा रयने क, आरू दुस्मन कि सारी शक्ति पर हक पाने की; आरू काही समान छे तुम्हे काय अन्याय नी होयछे। <verse eid="LUK 10:19"/><verse number="20" style="v" sid="LUK 10:20"/>तोभी इनासे खुश मा होय कि साहळा तुमरे हुकुम मानता छे, पुन इनासे खुश होय कि तुमरे नाव सोरगदूत मा लिख्यो छे।”<verse eid="LUK 10:20"/></para>
  <para style="s">ईशु खुश हुयो</para>
  <para style="r">(<ref loc="MAT 11:25-27">मत्ती 11:25-27</ref>; <ref loc="MAT 13:16-17">13:16-17</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21"/>तीनी घड़ी वो चुखलो आत्मा मा हुयने खुशी छे भर गया, आरू कयो, “हे बास, सोरग आरू धरती क पोरबु, हाव तारे धन्यवाद करता छे कि तु ने इन वात क ज्ञानी आरू समझदार छे डुकाय राख्या, आरू पोर्‍या पर प्रगट कर्‍या। हाव, हे बास, काहकि तुखे यो वारू लाग्यो।”<verse eid="LUK 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:22 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 3:35">यहुन्ना 3:35</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="JHN 10:15">यहुन्ना 10:15</ref>
      </char>
    </note>“म्हार बास मेखे सब आप देदलो छे; आरू काही नी जानता कि पोर्‍य कुन छे केवल बास, आरू बास कुन छे यो भी काही नी जानता केवल पोर्‍या क आरू वो जिना पर पोर्‍या ओको प्रगट करनो जुवे।”<verse eid="LUK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23"/>तव चेला की आरू मुड़कर ऐखलो मा कयो, “धन्य छे वो डुवा, जो यो वात जो तुमू देखता होय देखती छे। <verse eid="LUK 10:23"/><verse number="24" style="v" sid="LUK 10:24"/>काहकि हाव तुमू छे कयता छे कि, घोणा छे भविष्यवक्ता आरू राजा ने जुया कि जो वात तुमू देखता होय देख्या पर नी देखी, आरू जो वात तुमू सोमवता होय सोमव्या पर नी सोमवी।”<verse eid="LUK 10:24"/></para>
  <para style="s">दयाडु सामरिया क दृष्टांत</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:25 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 22:35-40">मत्ती 22:35-40</ref>; <ref loc="MRK 12:28-34">मरकुस 12:28-34</ref></char>
    </note>आरू एक व्यवस्थापक उठ्यो आरू यो कयीन ओकी परीक्षा करने लाग्या, “हे गुरू, अमरकाय जीवन क वारीस हुयने क करता हाव काय करीस?”<verse eid="LUK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26"/>त्यो ओका सी कयो, “मूसा क व्यवस्था मा काय लिख्या छे? तु कोसो भणता छे?”<verse eid="LUK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27"/>त्यो उको जवाब देदो, “तु पोरबु आपने यहोवा–भगवान छे आपने सब मन आरू आपने सब जीव आरू आपसी सारी शक्ति आरू आपसी सारी बुध्दी क साथे मोंग राख्यो आरू आपने धडे वावा छे आपने समान मोंग राख्यो।”<verse eid="LUK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28"/>ईशु ओका सी कयो, “तु ने ठीक जवाब देदो, या कर तो तु जीवतो रवछे।”<verse eid="LUK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29"/>पुन त्यो आपने आप क न्यायी ठहराने की मरजी छे ईशु छे पुच्छा, “तो मारो धडेवावा कुण छे?”<verse eid="LUK 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30"/>ईशु जवाब दिया, “एक माणुस यरूशलेम छे यरीहो क जाय रया हुता कि डाकु ने घेरकर ओका लुगड़ा उतारीन करता, आरू मारपीट कर उको आदमरतो छुड़ीन चाली गया।” <verse eid="LUK 10:30"/><verse number="31" style="v" sid="LUK 10:31"/>आरू असो हुया कि तीनी मार्ग छे एक पुजारा जाय रया हुता, पुन ओको देख क जाती रयो। <verse eid="LUK 10:31"/><verse number="32" style="v" sid="LUK 10:32"/>इनी रीति छे एक लेवी उना धरती पर आयो, वो भी उको देखीन दिसरे वाट चाली जाय रया हुता। <verse eid="LUK 10:32"/><verse number="33" style="v" sid="LUK 10:33"/>पुन एक सामरि यात्री वाँ आयो आरू उको देखीन तरस खायो। <verse eid="LUK 10:33"/><verse number="34" style="v" sid="LUK 10:34"/>त्यो ओको साथे आवीन ओका घाव पर तेल आरू अंगुर क रस नाखीन पाटू बांधीन, आरू आपसी सवारी पर चढ़ावीन सराय मा ली गया, आरू ओकी सेवा करी। <verse eid="LUK 10:34"/><verse number="35" style="v" sid="LUK 10:35"/>दिसरे दाहडे त्यो दुयी चाँदी क दीनार निकावीन सराय क मालीक क दिया, आरू कयो, “इसकी सेवा करनो, आरू जो काय तारे आरू लागछे, वो हाव पुगीन पर तुके भर देसे।”<verse eid="LUK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36"/>ईशु ओका सी पुछो, “हिमी तारी समज मा जो डाकु मा घिर गया हुता, इन तीन मा छे ओका धडेवावा कुण ठहराया?”<verse eid="LUK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37"/>त्यो कयो, “वा जीसने ओको पर दया करी।”</para>
  <para style="p" vid="LUK 10:37">ईशु ओका सी कयो, “जा, तु भी ओसो ही कर।”<verse eid="LUK 10:37"/></para>
  <para style="s">ईशु मार्था आरू मरीयम क घर</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">10:38 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 11:1">यहुन्ना 11:1</ref>
      </char>
    </note>जव ईशु आरू ओका चेला जा रया हुता तो वो एक गाँव मा गया, आरू मार्था नावकी एक बायर ने ओको आपने घर मा बठाडी। <verse eid="LUK 10:38"/><verse number="39" style="v" sid="LUK 10:39"/>मरीयम नाव कि ओकी एक बहिनीस होती। वो पोरबु क चरनो मा बठीन ओका वचन सोमवती होती। <verse eid="LUK 10:39"/><verse number="40" style="v" sid="LUK 10:40"/>पुन मार्था सेवा करती नोराज होती, आरू ओको साथे आवीन कयनो लागी, “हे पोरबु, काय तुखे काय भी चिंता नी कि मारी बहिनीस ने मोखे सेवा करने क करता एखली हिय छुड़ दिया छे? अतरान करीन ओका सी कय कि मारी सहायता कर।”<verse eid="LUK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41"/>पोरबुने ओको जवाब दिया, “मार्था, हे मार्था; तु घोणा वात क करता चिंता करती आरू दुःखी छे। <verse eid="LUK 10:41"/><verse number="42" style="v" sid="LUK 10:42"/>पुन एक वात नक्‍की छे, आरू ओको वारलो भाग मरियम क निवाड़ लेदो छे; जो ओका सी छिना नी जाछे।”<verse eid="LUK 10:42"/></para>
  <chapter eid="LUK 10"/>
  <chapter number="11" style="c" sid="LUK 11"/>
  <para style="s">पोरबु क प्रार्थना</para>
  <para style="r">(<ref loc="MAT 6:9-13">मत्ती 6:9-13</ref>; <ref loc="MAT 7:7-11">7:7-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1"/>वो काही धरती प्रार्थना कर रया हुता। जव वो प्रार्थना कर त्योक्या, तो ओका चेला मा छे एक ने ओको कयो, “हे पोरबु, जोसो यहुन्ना ने आपने चेला क प्रार्थना करनो सिखाड्या वोसो ही हामु भी तु सिखाड दे।”<verse eid="LUK 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2"/>त्यो उनछे कयो, “जव तुमू प्रार्थना कर्‍या तो कयो:”</para>
  <para style="q1" vid="LUK 11:2">“हे बास,</para>
  <para style="q2" vid="LUK 11:2">तारे नाव चुखलो मान्य जाय,</para>
  <para style="q2" vid="LUK 11:2">तारे राज्य आये।”<verse eid="LUK 11:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="LUK 11:3"/>“हामरा दाहडु भर कि रूटा हर दाहडे हामु आप्या कर्‍या”<verse eid="LUK 11:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="LUK 11:4"/>“आरू हामरे पाप क माफ कर,</para>
  <para style="q2" vid="LUK 11:4">जोसो हामु भी आपने हर एक गुणेगार क माफ करता छे</para>
  <para style="q2" vid="LUK 11:4">आरू हामु परीक्षा मा नी लेय।”<verse eid="LUK 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5"/>तव त्यो उनछे कयो, “तुमू मा छे कुन छे कि ओका दोस्त होय, आरू वो आधली रात क ओको साथे जाईन ओको जाईन कये, दोस्त; मखे तीन रोटा दे।” <verse eid="LUK 11:5"/><verse number="6" style="v" sid="LUK 11:6"/>काहकि एक यात्री दोस्त मारे साथे आश छे, आरू ओको ओगव राखने क करता मारे साथे काय नी छे। <verse eid="LUK 11:6"/><verse number="7" style="v" sid="LUK 11:7"/>आरू वो माहीय छे जवाब देय, मखे परेशान नी देय; हिमी तो झोपलो बंद छे आरू मारो पोर्‍या साथे बिछौने पर छे, एरकरीन हाव उठीन तुखे देय नी सकता? <verse eid="LUK 11:7"/><verse number="8" style="v" sid="LUK 11:8"/>हाव तुमू छे कयता छे, यदि ओका दोस्त हुयने पर भी ओको उठीन नी देय, तौभी ओका लज्जा छुड़ीन मांगने क कारण ओको जोतरी छचो होय ओतरी उठीन देसे।<verse eid="LUK 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9"/>आरू हाव तुमूक कयता छे कि, मांगछे, तो तुमूक आपसे; हेरने, वो तो तुमू जुड़से; खटखटा, तो तुमरे करता उगाड़े जाछे। <verse eid="LUK 11:9"/><verse number="10" style="v" sid="LUK 11:10"/>काहकि जो काही मांगता छे, ओको मिवता छे; आरू जो हेरता छे, वो देखता छे; आरू जो खटखटाता छे, ओको करता खुलाय जाछे। <verse eid="LUK 11:10"/><verse number="11" style="v" sid="LUK 11:11"/><note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="ft" closed="false">यो वचन काही शास्त्रमा लिख्यो नी</char></note>तुमू मा छे ओसो कुन बास होयछे, कि जव ओका पोर्‍या रोटा मांगछे तो ओको दगड़ा देय; या मासा मांगछे, तो मासा क बदलने ओको गोड़सु आपसे? <verse eid="LUK 11:11"/><verse number="12" style="v" sid="LUK 11:12"/>या आण्डा मांगे तो ओको विसो आपे? <verse eid="LUK 11:12"/><verse number="13" style="v" sid="LUK 11:13"/>“अळते जव तुमू बुरे हुयने आपने पोर्‍या क वारली समान देने जानता होय, तो सोरगन बास आपने मांगनेवावा क चुखलो आत्मा कोसो नी देसे।”<verse eid="LUK 11:13"/></para>
  <para style="s">ईशु आरू बालजबुल</para>
  <para style="r">(<ref loc="MAT 12:22-30">मत्ती 12:22-30</ref>; <ref loc="MRK 3:20-27">मरकुस 3:20-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14"/>पछु ईशु एक साहळा क निकाव्या जो उना माणुस क मुका करतो हतो। जव साहळा निकाव गयी ते मुका माणुस बुलने लाग्या; आरू क भोंगलाय गयो हुया। <verse eid="LUK 11:14"/><verse number="15" style="v" sid="LUK 11:15"/><note caller="+" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="MAT 9:34">मत्ती 9:34</ref>; <ref loc="MAT 10:25">10:25</ref></char></note>पुन ओका छे काय ने कयो, “यो तो नावको साहळा क बालजबुल की मदत छे साहळा क निकवता छे।”<verse eid="LUK 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 11:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:16 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:38">मत्ती 12:38</ref>; <ref loc="MAT 16:1">16:1</ref>; <ref loc="MRK 8:11">मरकुस 8:11</ref></char>
    </note>दिसरा ने ओकी परीक्षा करने क करता ओका सी आकाश यहोवा–भगवान क आरू छे एक सहलानी मांगने लाग्यो। <verse eid="LUK 11:16"/><verse number="17" style="v" sid="LUK 11:17"/>पुन त्यो ओको मन की वात जानीन, त्यो कयो, “जिना राज्य मा फूट पड़ी, वो राज्य वीजावो जातो छे; आरू जिना घर मा फूट होयती छे, वो नष्ट होय जाता छे।” <verse eid="LUK 11:17"/><verse number="18" style="v" sid="LUK 11:18"/>यदि बालजबुल आपसा ही विरोधी होय जाय, तो ओको राज्य कोसो बन्य रवछे? काहकि तुमू मारे विषय मा तो कयता होय की बालजबुल की मदत छे साहळा निकावता छे। <verse eid="LUK 11:18"/><verse number="19" style="v" sid="LUK 11:19"/>भला यदि हाव बालजबुल की मदत छे साहळा क निकावता छे, तो तुमरी चेला क कायकी मदत छे निकवता छे? एरकरीन वो ही तुमरा न्याय त्योकछे। <verse eid="LUK 11:19"/><verse number="20" style="v" sid="LUK 11:20"/>पुन यदि हाव यहोवा–भगवान की शक्ति छे साहळा क निकालो, तो यहोवा–भगवान क राज्य तुमरे साथे आय पुच्चा छे।<verse eid="LUK 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21"/>“जव बलवन्त मानुस हथियार बांध्या हुया आपने घर की राखवावी करता छे, तो ओकी संपत्ती वाच रयती छे।” <verse eid="LUK 11:21"/><verse number="22" style="v" sid="LUK 11:22"/>पर जव ओका सी मोट काही आरू बलवन्त चढ़ाय करीन उको जीत लेता छे, तो ओका वो हथियार जिन पर ओको भरोसा हुता, छिन लेता छे। आरू ओकी संपत्ती लुटीन वाट देता छे।<verse eid="LUK 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:23 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:40">मरकुस 9:40</ref>
      </char>
    </note>जो मारे साथे नी वो मारे विरोध मा छे, आरू जो मारे साथे नी बटोरता वो बिखेरता छे।<verse eid="LUK 11:23"/></para>
  <para style="s">साहळा कि पोछो आवने</para>
  <para style="r">(<ref loc="MAT 12:43-45">मत्ती 12:43-45</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24"/>“जव साहळा मानुस मा छे निकाव जाती छे तो सूखी धरती मा विसराम हेरती पुगती छे, आरू जव नी देखती तो कयती छे, आपने तीनी घर मा वा छे निकावी होती पुगीन जाछे। <verse eid="LUK 11:24"/><verse number="25" style="v" sid="LUK 11:25"/>आरू आवीन ओको झाड़ा बुहारा आरू सजा सजाया देखती छे। <verse eid="LUK 11:25"/><verse number="26" style="v" sid="LUK 11:26"/>तव वो जाईन आपने छे बुरी सात आरू विटळ आत्मा क आपने साथे लेय आवती छे, आरू वो ओका मा पैठकर वास करती छे, आरू ओको मानुस की पोछली दशा पेहल छे भी बुरी होय जाती छे।”<verse eid="LUK 11:26"/></para>
  <para style="s">वारलो खुशी</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27"/>जव ईशु यो वात कय ही रया हुता तो गर्दी मा काही बायर ने उंचा ओवाज छे कयो, “धन्य छे वो कुख जिनामा तु रया आरू वो स्तन जो तु ने चूछे।”<verse eid="LUK 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28"/>त्यो कयो, “हाव; पुन धन्य वो छे जो यहोवा–भगवान क वचन आरू सोमवता आरू मानता छे।”<verse eid="LUK 11:28"/></para>
  <para style="s">यहोवा–भगवान कि आरू छे सहलानी कि मांगने</para>
  <para style="r">(<ref loc="MAT 12:38-42">मत्ती 12:38-42</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:29 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:4">मत्ती 16:4</ref>; <ref loc="MRK 8:12">मरकुस 8:12</ref></char>
    </note>जव मोटी गर्दी एखटी होयती जाती होती तो वो कयनो लाग्यो, “इनीये युग क मानसे बुरे छे; वो सहलनी हेरता छे पर योना क सहलानी क छुड़ कायी आरू सहलनी तीनुक नी दिया जाछे।” <verse eid="LUK 11:29"/><verse number="30" style="v" sid="LUK 11:30"/>जोसो योना नीनवे क मानसे क करता सहलानी ठेहराया, वोसो हिय माणुस क पोर्‍य दि इनीये युग क मानसे क करता ठेहरछे। <verse eid="LUK 11:30"/><verse number="31" style="v" sid="LUK 11:31"/>दक्षिण रानी न्याय दहाडो इनीये टेहाव क माणुस क साथे उठीन तीनुक दोषी ठेहरछे, काहकि वो सुलैमान क ज्ञान सोमवने क धरती कि छोर क आवी, आरू याहा वो छे जो सुलैमान छे भी मोटो छे। <verse eid="LUK 11:31"/><verse number="32" style="v" sid="LUK 11:32"/>नीनवे क मानसे न्याय क दहाडो इनीये टेहाव क मानसे क साथे उबा हईन, तीनुक दोषी ठेहराछे, काहकि त्या योना क खबर सोमवीन मन फिराया, आरू देख, या वा छे जो यहुन्ना छे भी मोटो छे।<verse eid="LUK 11:32"/></para>
  <para style="s">डिल क दिया</para>
  <para style="r">(<ref loc="MAT 5:15">मत्ती 5:15</ref>; <ref loc="MAT 6:22-23">6:22-23</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:33 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:15">मत्ती 5:15</ref>; <ref loc="MRK 4:21">मरकुस 4:21</ref>; <ref loc="LUK 8:16">लूका 8:16</ref></char>
    </note>कायी माणुस दिया धपाडयो क डुकायने कि धरती मा या ठाहारा क नेचो नी राखता, पुन दीवट पर राखता छे कि माहय आवनेवाळा विजावो देखाये। <verse eid="LUK 11:33"/><verse number="34" style="v" sid="LUK 11:34"/>तारे डिल क दिवु तारो डुवो छे, एरकरीन जव तारो डुवो वारलो छे, ते तारा सब डिल भी विजावो छे। पुन जव चो खराब होय जासे, ते तारे डिल मा भी आंधारो होय छे। <verse eid="LUK 11:34"/><verse number="35" style="v" sid="LUK 11:35"/>अतरान करीन चोकचौळीया रयने कि जो विजावो तुम मा छे आंधारो नी होयी जाछे। <verse eid="LUK 11:35"/><verse number="36" style="v" sid="LUK 11:36"/>“अतरान करीन यदि तारे सब डील विजावो होय आरू ओको कायी भाग आंधारो नी रये तो सब क सब ओसो विजावो होयछे, जोसो ओको टेहाव हुता छे जव दिया आपसी चमक छे तुखे विजावो देता छे।”<verse eid="LUK 11:36"/></para>
  <para style="s">मार्था आरू मरीयम क घर ईशु</para>
  <para style="r">(<ref loc="MAT 23:1-36">मत्ती 23:1-36</ref>; <ref loc="MRK 12:38-40">मरकुस 12:38-40</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37"/>जव ईशु वात करनो बंद कर्‍या तो कायी फरीसि ने ओका सी विनती करी कि मारे याहा भोजन कर। वो माही जाईन भोजन करने बठयो। <verse eid="LUK 11:37"/><verse number="38" style="v" sid="LUK 11:38"/>फरीसि क यो देखीन भोंगलाय गयो हुया कि त्यो भोजन करने छे पहेल यहूदि ओको नियम नुसार हात धुया नी। <verse eid="LUK 11:38"/><verse number="39" style="v" sid="LUK 11:39"/>पोरबुने ओका सी कयो, “हे फरीसियो, तुमो वाटका आरू थावी क उपर छे मांढता होय, पुन तुमरे माहीय आंधारो आरू दुष्टता भरी छे।” <verse eid="LUK 11:39"/><verse number="40" style="v" sid="LUK 11:40"/>हे निर्बुदीयो, जो बाहरता क भाग बनाड़े काय, त्यो माही क भाग नी बनाड़े? <verse eid="LUK 11:40"/><verse number="41" style="v" sid="LUK 11:41"/>पुन जो तुमरे साथ छे वो गरीबो क वाट देवो, तो देखु सब कायी तुमरे करता चुखो होय जाछे।<verse eid="LUK 11:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42"/>पर हे फरीसियो, तुमो बार हायी! तुमू पुदीने आरू सुदाब क आरू सब भाति क सागपात क दसवो अंश देता होय, पुन न्याय क आरू यहोवा–भगवान क मोंग क टाल देता होय; जुवे तो हुता कि इनुक भी करता रयता आरू तीनुक भी नी छुड़ता।<verse eid="LUK 11:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43"/>हे फरीसियो, तुमू पर हाय! तुमू आराधना घर मा मुखी आसान आरू बजार मा नमस्कार आरू मोंग जुवतो छे। <verse eid="LUK 11:43"/><verse number="44" style="v" sid="LUK 11:44"/>“धिक्‍कार तुमू पर! काहकि तुमू उन मोड़वाट्या क सारखा होय, जिन पर मानसे चालता छे पुन नी जानता।”<verse eid="LUK 11:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45"/>तव एक व्यवस्थापक ने ओको जवाब दिया, “हे गुरू, इन वात क कयनो छे तु हामरी निंदा करता छे।”<verse eid="LUK 11:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46"/>ईशु कयो, “हे व्यवस्थापक, तुमू पर भी हाय! तुमू ओसो बोझ जिनको हाकलिया वातड़ो छे, मानुस पर लादता होय पुन तुमू आप उन बोझ क आपसी एक आँगवी छे भी नी छुते।” <verse eid="LUK 11:46"/><verse number="47" style="v" sid="LUK 11:47"/>हे कपट राखने वाला शास्त्रीया आरू फरीसिया तुमरे पर धिक्‍कार! तुमू उन भविष्यवक्ता की मोड़वाट्या बनावता होय, जिना तुमरा बाब दादा क मार नाख्या हुता। <verse eid="LUK 11:47"/><verse number="48" style="v" sid="LUK 11:48"/>शेवली कावा तुमू गवा होय, आरू आपने बास दादा क काम छे सहमत होय; काहकि त्या तीनुक मार नाख्या आरू तुमू ओकान मोट्ट्या बनावता होय। <verse eid="LUK 11:48"/><verse number="49" style="v" sid="LUK 11:49"/>“एरकरीन यहोवा–भगवान की बुध्दि ने भी कयो छे, हाव ओको साथे भविष्यवक्ता आरू प्रेरितन क मुकलीस, आरू वो ओका छे काय क मारे नाखछे, आरू काय क सताया।” <verse eid="LUK 11:49"/><verse number="50" style="v" sid="LUK 11:50"/>ताकि जोतरा भविष्यवक्ता क लुहूय यो धरती की उत्पत्ती छे वयाड़े गया छे, सब क लेखो इनीये युग क मानसे छे ली जाय: <verse eid="LUK 11:50"/><verse number="51" style="v" sid="LUK 11:51"/>हाबील की हत्या छे लीन जकर्‍याह की हत्या तक, जो वेदी आरू मंदिर क वीच मा घात कर्‍या जाय। हाव तुमू छे सच कयता छे, इन सब क लेखो इनी टेहाव क मानसे छे ली जाछे।<verse eid="LUK 11:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52"/>हाय तुमू फरीसिया शास्त्री पर धिक्‍कार! तुमू ने ज्ञान की चाबी लेय तो ली, पुन तुमू ने आप ही भरायने नी कर्‍या, आरू भरायने करनेवावा क भी रूकी दिया।<verse eid="LUK 11:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53"/>जव वो वाँ छे निकव्या, तो शास्त्री आरू फरीसि बुरी तरह ओका पछव पड़ गया आरू छेड़ने लाग्या कि वो घोणा सी वात की चर्चा कर्‍या, <verse eid="LUK 11:53"/><verse number="54" style="v" sid="LUK 11:54"/>आरू घात मा लाग्या रया कि ओका मुय की काही वात दरिया।<verse eid="LUK 11:54"/></para>
  <chapter eid="LUK 11"/>
  <chapter number="12" style="c" sid="LUK 12"/>
  <para style="s">कपटी क विरोध चेतावनी</para>
  <para style="r">(<ref loc="MAT 10:26-27">मत्ती 10:26-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:6">मत्ती 16:6</ref>; <ref loc="MRK 8:15">मरकुस 8:15</ref></char>
    </note>ओतरा मा जव हजारो की गर्दी लागी गयी, याहा तक कि वे एक दिसरा पर गिर पड़ता हुता, तो वो सब छे पेहल आपने चेला छे कयनो लाग्या, “फरीसियों क कपट राखनीया न सखमीर सी चोकचौळीया रयने।” <verse eid="LUK 12:1"/><verse number="2" style="v" sid="LUK 12:2"/><note caller="+" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="MRK 4:22">मरकुस 4:22</ref>; <ref loc="LUK 8:17">लूका 8:17</ref></char></note>काय ढाक्य नी, जो उघडी नी जाछे; आरू नी काय डुकाय छे, जो जाने नी जाछे। <verse eid="LUK 12:2"/><verse number="3" style="v" sid="LUK 12:3"/>एरकरीन जो काय तुमू ने आंधारो मा कयो छे, वो विजावो मा सोमवाय जाछे; आरू जो तुमू ने कोठरियो मा कांटो कयो छे, वो छत पर छे खबर कर्‍या जाछे।<verse eid="LUK 12:3"/></para>
  <para style="s">काही छे घबराये</para>
  <para style="r">(<ref loc="MAT 10:28-31">मत्ती 10:28-31</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4"/>“हाव तुमू मारे दोस्त होय कयता छे कि जो डील क घात करता छे पुन ओको पछळ आरू काय नी कर सकता, उका मा घाबराये।” <verse eid="LUK 12:4"/><verse number="5" style="v" sid="LUK 12:5"/>हाव तुमूक चितावो छे कि तुमूक कुनी घबरायना जुवे, घात करने क बाद जिनाक नरक मा नाखने क हक छे, तीनी यहोवा–भगवान छे घाबराय; हाव तुमू छे कयतु छे, तीनी छे घाबरया।<verse eid="LUK 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 12:6"/>काय दुय पयसिया क पाच चिल्ला नी वेचाये? तोभी यहोवा–भगवान ओका छे एक क भी नी भुलता। <verse eid="LUK 12:6"/><verse number="7" style="v" sid="LUK 12:7"/>तुमरे मुनका क सब झोठा भी गीन्या हुया छे, अतरान करीन घाबराय नी, तुमू बैस चिल्ला छे मोटो होय।<verse eid="LUK 12:7"/></para>
  <para style="s">ईशु क स्विकार किही नकार करने</para>
  <para style="r">(<ref loc="MAT 10:32-33">मत्ती 10:32-33</ref>; <ref loc="MAT 12:32">12:32</ref>; <ref loc="MAT 10:19-20">10:19-20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8"/>“हाव तुमू छे कयता छे जो काही मानुस क सामने मखे मान लेछे ओको मानुस क पोर्‍या भी यहोवा–भगवान क सोरगदूतो बासन सामने मान लेछे।” <verse eid="LUK 12:8"/><verse number="9" style="v" sid="LUK 12:9"/>पुन जो मानुस क सामने मखे मना करे ओको यहोवा–भगवान क सोरगदूत क सामने मना कर्‍या जाछे।<verse eid="LUK 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 12:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:10 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:32">मत्ती 12:32</ref>; <ref loc="MRK 3:29">मरकुस 3:29</ref></char>
    </note>जो काही मानुस क पोर्‍या क विरोध मा काही वात कये, ओको वो गुणेहगार माफ कर्‍या जाछे, पुन जो चुखलो आत्मा की नींदा कर्‍या ओको गुणेहगार माफ नी कर्‍या जाछे।<verse eid="LUK 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:11 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:19">मत्ती 10:19</ref>,<ref loc="MAT 10:20">20</ref>; <ref loc="MRK 13:11">मरकुस 13:11</ref>; <ref loc="LUK 21:14">लूका 21:14</ref>,<ref loc="LUK 21:15">15</ref></char>
    </note>जव मानसे तुम्हे सभा आरू हाकिम आरू आधिकारी क सामने लेय जाछे, तो चिंता नी करनो की हामु काही रीति छे या काय जवाब देय, या काय कयो। <verse eid="LUK 12:11"/><verse number="12" style="v" sid="LUK 12:12"/>काहकि चुखलो आत्मा तीनी घड़ी तुम्हे सिखाड़ देसे की काय कयनो जुवे।<verse eid="LUK 12:12"/></para>
  <para style="s">धनवान मुर्ख क दृष्टांत</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13"/>पछी गर्दी मा छे एक ने उको कयो, “हे गुरू मारे भाईस छे कय की बास की सम्पती हामु विरासत मा मिवी छे वो मारे साथे वाट लेय।”<verse eid="LUK 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14"/>त्यो ओका सी कयो, “हे मानुस कुन मखे तुमरा न्यायी या पाच पंचु नीयुक्त कर्‍या छे?” <verse eid="LUK 12:14"/><verse number="15" style="v" sid="LUK 12:15"/>आरू त्यो उनछे कयो, “चोकचौळीया रया, आरू हर प्रकार क लोभ छे आपने आप क वाचाड़्यो राख्यो काहकि काही क जीवन ओकी सम्पती की देखाड़ी छे नी हुयसे।”<verse eid="LUK 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16"/>त्यो उनछे एक दृष्टान्त कयो: “काही धनवान की धरती मा मोटी उपज होयी।” <verse eid="LUK 12:16"/><verse number="17" style="v" sid="LUK 12:17"/>तव वो आपने मन मा विचार करने लाग्या, “हाव काय करीस? काहकि मारे या धरती नी जहा आपसी उपज आरू काय राखीस।” <verse eid="LUK 12:17"/><verse number="18" style="v" sid="LUK 12:18"/>आरू त्यो कयो, “हाव यो करसे: हाव आपसी बखारिया तुड़ीन उनछे मोटी बनावीस; आरू कुठार मा आपसा सब अन आरू संपत्ती रवछे; <verse eid="LUK 12:18"/><verse number="19" style="v" sid="LUK 12:19"/>आरू आपने जीव छे कयसे कि जीव तारे साथे घोणा साल क करता घोणा संपत्ती राखी छे चैन कर खाय, पी, सुख छे रेयछे।” <verse eid="LUK 12:19"/><verse number="20" style="v" sid="LUK 12:20"/>पुन यहोवा–भगवान ने ओका सी कयो, “हे मुर्ख, इनी रात तारे जीव तुखे से ली जाछे तव जो काही तुने एखठा कर्‍या छे वो कुनीन होय छे?”<verse eid="LUK 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21"/>“ओसो ही वो माणुस भी छे जो आपने करता धन भराता छे पुन यहोवा–भगवान कि दृष्टीमा धनी नी।”<verse eid="LUK 12:21"/></para>
  <para style="s">यहोवा–भगवान क उपर विश्वास राखो</para>
  <para style="r">(<ref loc="MAT 6:25-34">मत्ती 6:25-34</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22"/>पछु त्यो आपने चेला क कयो, “अतरान करीन हाव तुमू कयतो छे आपनो जीव क चिंता नी करू कि हामु काय खासु, नी आपने डील क काय पेहरसु।” <verse eid="LUK 12:22"/><verse number="23" style="v" sid="LUK 12:23"/>काहकि भोजन छे जीव आरू लुगड़ा छे डिल बडीन छे। <verse eid="LUK 12:23"/><verse number="24" style="v" sid="LUK 12:24"/>हा़डगाळा पर ध्यान देवु, वो नी वेरतो छे नी काटतो नी ओको भंडार आरू नी कुठार हुता छे तो भी यहोवा–भगवान तिनुक देखतो छे, तुमरा किमत चिल्ला छे कयी सवटो छे। <verse eid="LUK 12:24"/><verse number="25" style="v" sid="LUK 12:25"/>तुमू मा छे, ओसो कुण छे जो चिंता करसे आपने उमर थुड़ीक वार बढ़ाव आरू मोटी कर सकता छे? <verse eid="LUK 12:25"/><verse number="26" style="v" sid="LUK 12:26"/>अतरान करीन यदि तुमो सपछे नाना काम भी नी कर सकता तो आरू वात क करता काय चिंता करता होय? <verse eid="LUK 12:26"/><verse number="27" style="v" sid="LUK 12:27"/>जंगल क फुल क देख्या करो कि वो कसो मोटो होयतो छे वो नी हावहनत करता नी काटतो छे तो भी हाव तुमछे कयता छे की सुलैमान भी आपने सब वैभव मा उनमा छे काही एक क समान लुगड़ो पेहरला नी हुता। <verse eid="LUK 12:27"/><verse number="28" style="v" sid="LUK 12:28"/>अतरान करीन यदि यहोवा–भगवान मैदान कि खोड़ो क जो आज छे आरू काल आगठा झोकी जाछे, ओसो पेहर्‍या छे तो हे विनभुरसीया वो तुम्हे काय नी पेहर छे?<verse eid="LUK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 12:29"/>आरू तुमू इनीये वात कि खोज मा नी रया कि काय खासे आरू काय पीछे आरू नी संदेह करो। <verse eid="LUK 12:29"/><verse number="30" style="v" sid="LUK 12:30"/>काय कि संसार कि मानसे इन सब समान कि खोज मा रहती छे आरू तुमरा बास जानता छे कि तुम्हे इन समान कि छचो छे। <verse eid="LUK 12:30"/><verse number="31" style="v" sid="LUK 12:31"/>पुन ओका राज्य कि खोज मा रया तो यो समान भी तुमूक मिव जाछे।<verse eid="LUK 12:31"/></para>
  <para style="s">सोरग मा धनी बननो</para>
  <para style="r">(<ref loc="MAT 6:19-21">मत्ती 6:19-21</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32"/>मारो नाना टुळा मानसे मत घाबराय काहकि तुमरे बास क वो भाया छे कि तुम्हे राज्य देय। <verse eid="LUK 12:32"/><verse number="33" style="v" sid="LUK 12:33"/>आपने संपत्ती वेचीन गरीब क दान कर दियो आरू आपने करता ओसो थैली बनायो जो जुनला नी हुयसे मतलब सोरग क ओसो धन एखठा कर्‍या जो घटता नी आरू जीसके नीकट चुर नी जाता छे आरू किड़ा नी बिगड़ता। <verse eid="LUK 12:33"/><verse number="34" style="v" sid="LUK 12:34"/>काहकि वा तारो धन छे, चा तारो मन भी लागी रोवसे।<verse eid="LUK 12:34"/></para>
  <para style="s">जागता रयो</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">12:35 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 25:1-13">मत्ती 25:1-13</ref>
      </char>
    </note>तुमरी कड़ीया बांधीन रया आरू तुमरे दिया धपतो रयो। <verse eid="LUK 12:35"/><verse number="36" style="v" sid="LUK 12:36"/><note caller="+" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="MRK 13:34-36">मरकुस 13:34-36</ref></char></note>आरू तुमू उन माणुस क समान बन्या जो आपने भगवान कि वाट देखता रया होय कि वो वियाव छे किही पछु कि जव वो आवीन दरवाजा खटखटये तो तत्काल ओका करता उघाड दे। <verse eid="LUK 12:36"/><verse number="37" style="v" sid="LUK 12:37"/>धन्य छे वो दास जिन्हे भगवान आवीन जागता देख्यो हाव तुमू छे सच कयता छे कि कड़ीया बांधीन कर तीनुक भोजन करने क बठ्या आरू साथे आवीन उनकी सेवा करसे। <verse eid="LUK 12:37"/><verse number="38" style="v" sid="LUK 12:38"/>यदि वो रात क दुसरा पहेर्‍या या तीसरा पहेर्‍यामा आवीन तीनुक जागता देख्या तो वो धन्य छे। <verse eid="LUK 12:38"/><verse number="39" style="v" sid="LUK 12:39"/><note caller="+" style="x"><char style="xo" closed="false">12:39 </char><char style="xt" closed="false"><ref loc="MAT 24:43">मत्ती 24:43</ref>,<ref loc="MAT 24:44">44</ref></char></note>पुन तुमू यह जान राख्या कि यदि घरको सामने जानता कि चोर कि काय घड़ी आवसे तो जागता रयता आरू आपने घर मा डुचो नी लागने देता। <verse eid="LUK 12:39"/><verse number="40" style="v" sid="LUK 12:40"/>तुमो भी तियार रयो काहकि जिना घड़ी तुमो चोकळिया भी नी तीनी घड़ी माणुस क पोर्‍य आय जाछे।<verse eid="LUK 12:40"/></para>
  <para style="s">विश्वास योग्य या विनभुरसीया दास</para>
  <para style="r">(<ref loc="MAT 24:45-51">मत्ती 24:45-51</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41"/>तव पतरस ने कयो, “हे पोरबु काय यो दृष्टान्त तु हामु ही छे या सब छे कयता छे।”<verse eid="LUK 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42"/>पोरबु न कयो, “वो विश्वास योग्य आरू बुध्दिमान भण्डारी कुन छे, जेरो मालिक ओको नौकर चाकर पर सरदार ठेराया कि तीनुक टेहाव पर भोजन सामग्री देय।” <verse eid="LUK 12:42"/><verse number="43" style="v" sid="LUK 12:43"/>धन्य छे वो दास, जिनाक ओको भगवान आवीन ओसो ही करता देख्या <verse eid="LUK 12:43"/><verse number="44" style="v" sid="LUK 12:44"/>हाव तुमू छे सच कयता छे वो ओको आपसी सब धन पर हकदार ठरछे। <verse eid="LUK 12:44"/><verse number="45" style="v" sid="LUK 12:45"/>पुन यदि वो दास विचार करने लाग्या कि मारो भगवान आवने मा वार कर रया छे, आरू खाने पीने आरू दासियो क मारने पीटने लाग्या, आरू खाने पीने आरू साकिन हुयने लाग्या। <verse eid="LUK 12:45"/><verse number="46" style="v" sid="LUK 12:46"/>तो उना दास क भगवान ओसो दाहड़ो, जव वो ओकी वाट जुवता नी रया, आरू ओसी घड़ी जिनाक वो जानता नी होय, आवसे आरू उको भारी दण्ड दीन ओको भाग विनभुरसीया क साथे ठरसे।<verse eid="LUK 12:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47"/>वो दास जो आपने भगवान की मरजी जानता हुता, आरू तीयार नी रया आरू नी ओकी मरजी क नुसार चाल, घोणा मार खासे। <verse eid="LUK 12:47"/><verse number="48" style="v" sid="LUK 12:48"/>पुन जो नी जाईन मार खाने क योग्य काम करे वो थुड़ी मार खासे। एरकरीन जिनाक घोणा दिया गया छे, ओका सी घोणा मांगने जाछे आरू जिनाक घोणा सौप गया छे, ओका सी घोणा ली जाछे।<verse eid="LUK 12:48"/></para>
  <para style="s">ईशु क आवनो क परीणाम</para>
  <para style="r">(<ref loc="MAT 10:34-36">मत्ती 10:34-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49"/>हाव धरती पर आगठो लागाड़ ने आश छे; आरू काय जुवता छे केवल यो कि हिमी सुलग जाती। <verse eid="LUK 12:49"/><verse number="50" style="v" sid="LUK 12:50"/><note caller="+" style="x"><char style="xo" closed="false">12:50 </char><char style="xt" closed="false"><ref loc="MRK 10:38">मरकुस 10:38</ref></char></note>मखे तो एक बपतिस्मा लेने छे, आरू जव तक वो नी होय लेय तव तक हाव कोसी व्यथा मा रवीस! <verse eid="LUK 12:50"/><verse number="51" style="v" sid="LUK 12:51"/>काय तुमू समझता होय कि हाव धरती पर मिलाप करावने आयु छे? हाव तमुक कयतु छे: नी, अलग करने आयु छे। <verse eid="LUK 12:51"/><verse number="52" style="v" sid="LUK 12:52"/>काहकि हिमी छे एक घर मा पाच जना आपस मा विरोध राखछे, तीन दुय छे आरू दुय तीन छे। <verse eid="LUK 12:52"/><verse number="53" style="v" sid="LUK 12:53"/>बास पोर्‍या छे, आरू पोर्‍या बास छे विरोध राखछे; आश पोराय छे, आरू पोराय आश छे, सासु उहडीस छे, आरू उहडीस सासु छे विरोध राखछे।<verse eid="LUK 12:53"/></para>
  <para style="s">टेहाव क लक्षण</para>
  <para style="r">(<ref loc="MAT 16:2-3">मत्ती 16:2-3</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54"/>त्यो गर्दी छे भी कयो, “जव वादवो क पश्चिम छे उठतला देखीन तत्काल कयता होय कि साल होयछे, आरू ओसो ही हुयसे छे; <verse eid="LUK 12:54"/><verse number="55" style="v" sid="LUK 12:55"/>आरू जव दक्षिण वाहवो चालती देखता होयतो कयता होय लहू चालसे, आरू ओसो हिय हुयसे छे। <verse eid="LUK 12:55"/><verse number="56" style="v" sid="LUK 12:56"/>हे कपटीयो, धरती आरू आकाश क रूपरंगमा भेद करता छे होय पुन इनीये युग क विषयमा काय भेद करने नी जानता?”<verse eid="LUK 12:56"/></para>
  <para style="s">आपने गुणु लगाड़ने वावा छे समजोता</para>
  <para style="r">(<ref loc="MAT 5:25-26">मत्ती 5:25-26</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57"/>तुमू आप ही न्याय काय नी कर लेता कि वात काय छे? <verse eid="LUK 12:57"/><verse number="58" style="v" sid="LUK 12:58"/>जव तु आपने मुद्दे क साथ सरदार क साथे जाईन रया छे तो मार्ग हिय मा ओका सी छुटने क यत्न कर ले, ओसो नी होय कि वो तुखे न्यायी क साथे खेच लेय जाय, आरू न्यायी तुखे शिपाई क सौपे आरू शिपाई तुखे जेलमा नाक देय। <verse eid="LUK 12:58"/><verse number="59" style="v" sid="LUK 12:59"/>हाव तुमछे कयता छे कि जब तक तु दमडी भर नी देसे तव तक वा छे छुटने नी पाये गा।<verse eid="LUK 12:59"/></para>
  <chapter eid="LUK 12"/>
  <chapter number="13" style="c" sid="LUK 13"/>
  <para style="s">मन फिरावो या नाश होय</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1"/>उना टेहाव कायी मानसे आय उचा आरू ओका सी उसने गलीलीयो कि चर्चा करने लाग्या जिनका लुहूय यो पिलातुसने ओका क बलिदान क साथ मिवाया हुता <verse eid="LUK 13:1"/><verse number="2" style="v" sid="LUK 13:2"/>यो सोमवीन ईशु ओका सी जवाब मा यो कयो, “काय तुमू समजता होय कि यो गलीली आरू सब गालीलीयो सी सवटो पापी हुता कि उन पर ओसी संकट पड़ी?” <verse eid="LUK 13:2"/><verse number="3" style="v" sid="LUK 13:3"/>हाव तुमूछे कयता छे कि नी पुन यदि तुमू मन नी फिरावसे तो तुमू सब भी इनी रीति छे नष्ट होय छे। <verse eid="LUK 13:3"/><verse number="4" style="v" sid="LUK 13:4"/>या काय तुमू समजता होय कि वो अठारे जन जिन पर शीलोह क गुम्मट पड़्या आरू वो दबाईन मर गयो, यरूशलेमको आरू सब रहनेवावा छे सवटो गुणेहगार हुता। <verse eid="LUK 13:4"/><verse number="5" style="v" sid="LUK 13:5"/>हाव तुमछे कयता छे, कि नी पुन यदि तुमू मन नी फिरावसे तो तुमू सब भी इनी रीति छे नष्ट होय।<verse eid="LUK 13:5"/></para>
  <para style="s">फोव–रहित अंजीर क झाड़का क दृष्टान्त</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6"/>पछु त्यो यह दृष्टांत भी कयो काही कि अंगुर कि वाड़ी मा एक अंजीर क झाड़को क लाग्यो हुयो हुतो वो ओकामा फवो हेरता आश पुन नी देखाय। <verse eid="LUK 13:6"/><verse number="7" style="v" sid="LUK 13:7"/>तव त्यो वाड़ी क राखनेवावा कयो देख तीन साल छे हाव इनीये अंजीर क झाड़का मा फवो हेरता आवता छे पुन नी देखता इनाक काटीन नाखने कि यो धरती क भी काय रूक गया। <verse eid="LUK 13:7"/><verse number="8" style="v" sid="LUK 13:8"/>त्यो ओको जवाब दिया, हे भगवान इनाक इनीये साल आरू कयने दे कि हाव ओका चार आरू खुंदीन खत नाख्यो। <verse eid="LUK 13:8"/><verse number="9" style="v" sid="LUK 13:9"/>यदि अगोळ क फवो नी तो ओको काट नाखे।<verse eid="LUK 13:9"/></para>
  <para style="s">हापता क दाहड़े वाकली बायर क वारू करने</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10"/>विश्राम क दहाडो वो एक आराधना घर शिक्षा कर रया हुता। <verse eid="LUK 13:10"/><verse number="11" style="v" sid="LUK 13:11"/>वाँ एक बायर हुती जिनाक अठारे साल छे एक कमजोर करनेवाळी साहळा लागी होती आरू वो कुभडी होय गयी होती आरू काही रीति सिधी नी होयी सकती होती। <verse eid="LUK 13:11"/><verse number="12" style="v" sid="LUK 13:12"/>ईशु ओको देखीन बुलाया आरू कयो, “हे नारी तु आपसी कमजोरी छे छुट गयी। <verse eid="LUK 13:12"/><verse number="13" style="v" sid="LUK 13:13"/>तव त्यो ओको पर हार राखीन आरू वो छाटोत सुधो वा गयी आरू यहोवा–भगवान कि बढ़ाई करने लागी।”<verse eid="LUK 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14"/>अतरान करीन कि ईशु विश्राम क दहाडो ओको वारू कर्‍या हुता आराधना घर क सरदार चिताकर मानसेछे कयने लाग्या, “छो, दहाडो छे जीनमा काम करने जुवे आखरी उन ही दहाडे मा आवी वारू होय पुन विश्राम दहाडो मा नी।”<verse eid="LUK 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15"/>यो सोमवीन पोरबुने जवाब दिया हे कपटी, काय विश्राम क दहाडो तुमू मा छे हर एक आपने बैल या गदड़ा क स्थान छे उघाडीन पानी पावने नी ली जाता छे? <verse eid="LUK 13:15"/><verse number="16" style="v" sid="LUK 13:16"/>तो काय वारू नी हुता कि यो बायर जो अब्राहम कि बेटी छे जीनाक शैतान क अठारे साल छे बांधीन राख्या हुता विश्राम क दहाडो इनीये बंधनछे छुड़ायो जारी? <verse eid="LUK 13:16"/><verse number="17" style="v" sid="LUK 13:17"/>जी त्यो यो वात कयी तो ओका सब विरोधी लज्जित हो गया आरू सारी गर्दी उन महिमा क काम छे जो वो करता हुता खुश हयी<verse eid="LUK 13:17"/></para>
  <para style="s">राई क दाना क दृष्टान्त</para>
  <para style="r">(<ref loc="MAT 13:31-32">मत्ती 13:31-32</ref>; <ref loc="MRK 4:30-32">मरकुस 4:30-32</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18"/>पछु त्यो कयो यहोवा–भगवान क राज्य काय क समान छे? आरू मा ओकी बराबरी कुनी सी देसे। <verse eid="LUK 13:18"/><verse number="19" style="v" sid="LUK 13:19"/>वो राई क एक दानो क समान छे जीनाक कायी माणुस ने लीन आपसी खेत मा वेर्‍या आरू वो मोटो झाड़को होयी गया आरू आकाश क चिल्ला ने ओका डावखा पर पांजरो कर्‍या।<verse eid="LUK 13:19"/></para>
  <para style="s">खमीर क दृष्टान्त</para>
  <para style="r">(<ref loc="MAT 13:33">मत्ती 13:33</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20"/>त्यो पछु कयो, हाव यहोवा–भगवान क राज्य कि बराबरी कुनी सी देसे? <verse eid="LUK 13:20"/><verse number="21" style="v" sid="LUK 13:21"/>वो खमीर क समान छे जीसको कोय बायर लीन तीन पासरी पिठु मा मिलावी आरू धीरो–धीरो सब पिठु खमीर हुय गयो।<verse eid="LUK 13:21"/></para>
  <para style="s">सकेत व्दरा</para>
  <para style="r">(<ref loc="MAT 7:13-14">मत्ती 7:13-14</ref>; <ref loc="MAT 21-23">21–23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22"/>वो नगर आरू गाव हईन शिक्षा करता हुया यरूशलेम कि आरू जाय रया हुता। <verse eid="LUK 13:22"/><verse number="23" style="v" sid="LUK 13:23"/>तो कोय ओका सी पुछा, “हे पोरबु काय उध्दार देखनेवावा थुडा छे?”</para>
  <para style="p" vid="LUK 13:23">त्यो ओका सी कयो, <verse eid="LUK 13:23"/><verse number="24" style="v" sid="LUK 13:24"/>“संकेत झोपला छे भरायने करने क यत्न करो काय कि हाव तुमू छे कयता छे कि घोणा छे भरायने करने जुवे आरू नी कर सक्या।” <verse eid="LUK 13:24"/><verse number="25" style="v" sid="LUK 13:25"/>जी घर क भगवान उठीन झोपलो बंद कर त्योक्यो होय आरू तुमू बाहरता उबा हुया दरवाजो खटखटावीन कयनो लाग्या हे पोरबु हामरे करता उघाड दे आरू वो जवाब दिदो, “हाव तुम्हे नी जानता तुमू कयो क होयी?” <verse eid="LUK 13:25"/><verse number="26" style="v" sid="LUK 13:26"/>तव तुमू कयनो लाग्या, “हामु तारे सामने खाया, पीया आरू तु ने हामरे बजारमा शिक्षा कर्‍या।” <verse eid="LUK 13:26"/><verse number="27" style="v" sid="LUK 13:27"/>पुन वो कवसे हाव तुमूछे कयता छे, हाव नी जानता तुमू कयो छे होय हे अन्याय करनेवावा तुमू सब मखे छे दुर होय। <verse eid="LUK 13:27"/><verse number="28" style="v" sid="LUK 13:28"/>वाँ रड़नु आरू दात रगड़ने होयछे जव तुमू अब्राहम आरू इसहाक आरू याकोब आरू सब भविष्यवक्ता क यहोवा–भगवान को राज्यमा बठ्या आरू आपने आप क बाहरता निकावता होया देखछे। <verse eid="LUK 13:28"/><verse number="29" style="v" sid="LUK 13:29"/>आरू पुरब आरू पक्षिम, जवाब आरू दक्षिण छे मानसे आवी यहोवा–भगवान क राज्य क भोज मा भागी होयछे। <verse eid="LUK 13:29"/><verse number="30" style="v" sid="LUK 13:30"/><note caller="+" style="x"><char style="xo" closed="false">13:30 </char><char style="xt" closed="false"><ref loc="MAT 19:30">मत्ती 19:30</ref>; <ref loc="MAT 20:16">20:16</ref>; <ref loc="MRK 10:31">मरकुस 10:31</ref></char></note>आरू काय पछो छे वो पेहेल होय छे आरू काय जो पेहल छे वो पछो होयछे।<verse eid="LUK 13:30"/></para>
  <para style="s">यरूशलेम क जुगु ईशु क मोंग</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31"/>तीनी घड़ी काही फरीसियो ने आवीन ओका सी कयो, “या छे निकाव चाल जा काहकि हेरोदेस तुखे मारने जुवता छे।”<verse eid="LUK 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32"/>त्यो ओका सी कयो, “जाईन ओको कुल्या छे कयी दे कि देख हाव आज आरू काल साहळा निकावता आरू बीमारी क वारू करता छे आरू तिसरे दहाडे आपसा काम पुरो करसे।” <verse eid="LUK 13:32"/><verse number="33" style="v" sid="LUK 13:33"/>तो भी मखे आज आरू काल आरू पंदहाडे चालने पाको छे काहकि होय नी होय सकता कि काही भविष्यवक्ता यरूशलेम क बाहरता मारा जाय<verse eid="LUK 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34"/>हे यरूशलेम! हे यरूशलेम! तु जो भविष्यवक्ता क मार नाकता छे आरू जो तारे साथे मुकल्या गया ओका पर दगड़ा देय; कोतरी ही बार मा ने यो जुवा कि जोसो कुकड़ो आपने पिला क आपसो पोखड़ा क नेचो एखठा करता छे वोसो ही हाव भी तारे पोर्‍या क करीस पर तुमू ने यो नी जुवा। <verse eid="LUK 13:34"/><verse number="35" style="v" sid="LUK 13:35"/>देखु तुमरा घर तुमरे करता विजावो छुड़िया जाता छे आरू ने तुमू छे कयता छे जव धन्य छे वो जो पोरबु क नाव छे आवता छे तव तक तुमू मखे पछु कदी नी देखछे।<verse eid="LUK 13:35"/></para>
  <chapter eid="LUK 13"/>
  <chapter number="14" style="c" sid="LUK 14"/>
  <para style="s">फरीसि क घर मा ईशु</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1"/>पछु वो विश्राम क दाहड़ो फरीसियो क सरदार मा छे काही क घर रोटा खाने गया; आरू वो ओकी घात मा हुता। <verse eid="LUK 14:1"/><verse number="2" style="v" sid="LUK 14:2"/>वाँ एक मानुस ओको सामने हुता, जिनाक जलन्धर क बीमार हुता। <verse eid="LUK 14:2"/><verse number="3" style="v" sid="LUK 14:3"/>इनीये पर ईशु व्यवस्थापक आरू फरीसियो छे कयो, “विश्राम क दाहड़ा वारलो करने वारू छे या नी?”<verse eid="LUK 14:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 14:4"/>पुन वो त्योपचाप रया। तव त्यो ओको धरीन वारू कर्‍या आरू जाने दिया। <verse eid="LUK 14:4"/><verse number="5" style="v" sid="LUK 14:5"/>आरू त्यो कयो, “तुमू हाव छे ओसो कुन छे, जेरो गाडरो या बैल कुवा मा पड़ जाय आरू वो विश्राम क दाहड़े ओको तत्काल बाहरता नी निकाव्य?”<verse eid="LUK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 14:6"/>वो इन वात क काही जवाब नी देय सक्या।<verse eid="LUK 14:6"/></para>
  <para style="s">नम्रता आरू पाहंनतराय–सत्कर</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7"/>जव त्यो देखा की नेवतो लेदला मानसे कोसो मुखी धरती निवाड़ लेदा छे तो एक दृष्टान्त देकर ओका सी कयो, <verse eid="LUK 14:7"/><verse number="8" style="v" sid="LUK 14:8"/>“जव काही तुखे वियाव मा बुलाया, तो मुखी धरती मा नी बठने, कयी ओसो नी होय कि त्यो तुखे छे भी काही मोटा क नेवतो दिया होय,” <verse eid="LUK 14:8"/><verse number="9" style="v" sid="LUK 14:9"/>आरू जो तुखे आरू ओको दुयी क नेवता दिया छे आवी थार सी कये इनाक जागो आप, आरू तव तुखे लज्जित होयीन सबछे नेची धरती मा बेठने पड़्या। <verse eid="LUK 14:9"/><verse number="10" style="v" sid="LUK 14:10"/>पर जव तु बुलाया जाय तो सबछे नेची धरती जाय बठ्या कि जव वो जीसने तुखे नेवतो दिया छे आश तो तुखे छे कये, “हे दोस्त ओगोव बेठीन बठ्या तव तारे साते बठनेवावा क सामने तारी बढ़ाई होयछे।” <verse eid="LUK 14:10"/><verse number="11" style="v" sid="LUK 14:11"/><note caller="+" style="x"><char style="xo" closed="false">14:11 </char><char style="xt" closed="false"><ref loc="MAT 23:12">मत्ती 23:12</ref>; <ref loc="LUK 18:14">लूका 18:14</ref></char></note>काहकि जो काही आपने आपको मोटो बनाड़े वो नानो कर्‍या आरू जो काही आपने आपको नानो बनावोछे वो मोटो कर्‍या जाछे।<verse eid="LUK 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12"/>तव त्यो आपने नेवतो देनेवावा छे भी कयो जव तु दहाडो क या रात क भोज कर्‍या क आपने दोस्त या भाईसो या घराना या धनवान धडेवावा क नी बुलाव कही ओसो नी होय कि वो भी तुखे नेवता देय आरू तारे बदला होय जाय। <verse eid="LUK 14:12"/><verse number="13" style="v" sid="LUK 14:13"/>पुन जव भोज कर्‍या तो गरीब, टुण्डो, लेंगड़ा आरू आंधवा क बुलाया। <verse eid="LUK 14:13"/><verse number="14" style="v" sid="LUK 14:14"/>तव तु धन्य होयछे काहकि ओको साथे तुखे बदला देने क काही नी पुन तुखे न्यायी क जी उठने पर इनीये क हर फोव मिवो छे।<verse eid="LUK 14:14"/></para>
  <para style="s">मोट भोज क दृष्टान्त</para>
  <para style="r">(<ref loc="MAT 22:1-10">मत्ती 22:1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15"/>ओका साथ भोजन करनेवावा मा छे एक ने यह वात सोमवीन ओका सी कयो, “धन्य छे वो जो यहोवा–भगवान क राज्य रोटा खासे।”<verse eid="LUK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16"/>ईशु ओका सी कयो, “कुई लोगहन क मोटो भोज देदा आरू घोणा क बुलाया।” <verse eid="LUK 14:16"/><verse number="17" style="v" sid="LUK 14:17"/>जव भोजन तियार होय गया तो त्यो आपने दास क हाथ नेवतो मानसे क कय मुकल्या, “आवु हिमी भोजन तियार छे।” <verse eid="LUK 14:17"/><verse number="18" style="v" sid="LUK 14:18"/>पर वो सब क सब माफ मांगने लाग्या पहेल ओका सी कयो, “हाव खेत गिरवे करता छे आरू छाचो छे कि ओको देखछे हाव तुखे विनती करतु छे मखे माफ कर दे।” <verse eid="LUK 14:18"/><verse number="19" style="v" sid="LUK 14:19"/>दिसरा ने कयो, “हाव पाच जुड बैल गिरवे करततो छे, आरू उन लोगहन क पुछने जाता छे, हाव तुखे विनती करता छे मखे माफ कर दे।” <verse eid="LUK 14:19"/><verse number="20" style="v" sid="LUK 14:20"/>एक आरू ने कयो, “हाव या कर्‍या छे अतरान करीन हाव नी आय सकता।”<verse eid="LUK 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21"/>उना दास ने आवीन आपने भगवान क यो वात कय सोमवाया। तव घरको भगवान ने रीसमा आवीन आपने दासछे कयो, “नगर क बजार आरू गलिया माछे छाटोत जाईन गरीब टुण्डो, लेंगड़ा आरू आंधवा वो या ली आवु।” <verse eid="LUK 14:21"/><verse number="22" style="v" sid="LUK 14:22"/>दासने पछु कयो, “हे भगवान जोसो तुने कयो हुता वोसो ही कर्‍या गया छे आरू पछु भी धरती छे।” <verse eid="LUK 14:22"/><verse number="23" style="v" sid="LUK 14:23"/>भगवान दासक कयो, “सडको पर आरू बजार क तरफ आरू जाय आरू मानसे क मजबुर करीन ली आश ताकी मारे घर भर जाय।” <verse eid="LUK 14:23"/><verse number="24" style="v" sid="LUK 14:24"/>“काहकि तुमछे कयता छे कि ओको नेवतो मानसे मा काही मारे भोज क नी चाकसे।”<verse eid="LUK 14:24"/></para>
  <para style="s">चेला बनने क किमत</para>
  <para style="r">(<ref loc="MAT 10:37-38">मत्ती 10:37-38</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25"/>जव मोटो गर्दी ओका साथ जाई रयी होती तो ईशु पोछो पुगीन ओका सी कयो, <verse eid="LUK 14:25"/><verse number="26" style="v" sid="LUK 14:26"/><note caller="+" style="x"><char style="xo" closed="false">14:26 </char><char style="xt" closed="false"><ref loc="MAT 10:37">मत्ती 10:37</ref></char></note>“यदि कुई मारे साथे आवे आरू आपने बास आरू आश आरू बायर आरू पोर्‍या आरू भाईसो आरू बहिनीस वरना आपने जीव क भी मोंगवाळो नी न जाने ते वो मार चेलो नी होय सकतो। <verse eid="LUK 14:26"/><verse number="27" style="v" sid="LUK 14:27"/><note caller="+" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="MAT 10:38">मत्ती 10:38</ref>; <ref loc="MAT 16:24">16:24</ref>; <ref loc="MRK 8:34">मरकुस 8:34</ref>; <ref loc="LUK 9:23">लूका 9:23</ref></char></note>आरू जो काही मरना जानेनी तियार होयतो नी हुता आरू मारे पोछो नी आवे वो भी मार चेलो नी होय सकतो।<verse eid="LUK 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28"/>“तुमू मा छे कुण छे जो गढ़ बनाड़े जुवता होय आरू पहेले बठीन सच्चनी जुड़या क पुरा करने कि शक्ति मारे साथे छे कि नी?” <verse eid="LUK 14:28"/><verse number="29" style="v" sid="LUK 14:29"/>कोय ओसो होय कि, जव वो निव नाक ले पर तियार नी कर सक्या, वो सब देखनेवावा यो कयीन ओको ठट्टामा उड़ावने लाग्या। <verse eid="LUK 14:29"/><verse number="30" style="v" sid="LUK 14:30"/>“यो माणुस बनावने तो लाग्या पर तियार नी कर सक्य।”<verse eid="LUK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31"/>या कुण ओसो राजा छे जो दिसरा राजा छे युध्द करनो जाता होय आरू पहेले बठीन विचार नी करला कि जो विस हजार लीन मखे पर चढ़ा पर आवता छे काय हाव दस हजार लीन ओको सामना कर सकता छे या नी? <verse eid="LUK 14:31"/><verse number="32" style="v" sid="LUK 14:32"/>नी तो ओका दुर रयता ही वो दुतो क मुकलीन विलाप करने जुवे। <verse eid="LUK 14:32"/><verse number="33" style="v" sid="LUK 14:33"/>इनी रीति छे तुमू मा छे जो काही आपसा सब काही त्याग नी दे वो मारो चेला नी होय सकता।<verse eid="LUK 14:33"/></para>
  <para style="s">नी हवाद क नोन</para>
  <para style="r">(<ref loc="MAT 5:13">मत्ती 5:13</ref>; <ref loc="MRK 9:50">मरकुस 9:50</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34"/>नोन तो वारलो छे पुन यदि नोन क हवाद बिगड़ जाय तो वो कायी समान छे नोन कि कर्‍या जाछे। <verse eid="LUK 14:34"/><verse number="35" style="v" sid="LUK 14:35"/>वो नी तो धरती क आरू नी खत क करता काम मा आवता छे ओको तो मानसे बाहरता फेक दिया छे। ओका सोमवने क कांटो होयी वो सोमवी लेय।<verse eid="LUK 14:35"/></para>
  <chapter eid="LUK 14"/>
  <chapter number="15" style="c" sid="LUK 15"/>
  <para style="s">खुवायली गाडरा क दृष्टान्त</para>
  <para style="r">(<ref loc="MAT 18:12-14">मत्ती 18:12-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">15:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 5:29">लूका 5:29</ref>,<ref loc="LUK 5:30">30</ref></char>
    </note>सब फाळो लेनेवाळा आरू पापी ओका साथे आश करता हुता ताकी ईशु क सोमवने। <verse eid="LUK 15:1"/><verse number="2" style="v" sid="LUK 15:2"/>फरीसि आरू शास्त्री कुरकुर कयने लाग्या, “यो माणुस पापी छे मीवता छे आरू ओको साथे खाता भी छे।” <verse eid="LUK 15:2"/><verse number="3" style="v" sid="LUK 15:3"/>तव त्यो उनछे यो दृष्टांत कयो,<verse eid="LUK 15:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 15:4"/>“तुमू मा छे कुण छे जेरा सौ गाडरा होय, आरू उनमा छे एक खुवाय जाय तो चारविसु नोव क जंगलमा छुड़ीन ओको खुवायली हुये क जव तक मीवी नी जाय खुवता नी रया?” <verse eid="LUK 15:4"/><verse number="5" style="v" sid="LUK 15:5"/>आरू जव मिवी जाती छे तव वो मोटा खुशी छे ओको खांदा पर लीन जाता छे। <verse eid="LUK 15:5"/><verse number="6" style="v" sid="LUK 15:6"/>आरू घर मा आवीन दोस्त आरू धडेवावा क एखठा करीन कयता छे, “मारे साथे खुशी करो, काहकि मारी खुवायला होयी गाडरा जड़ गयला छे।” <verse eid="LUK 15:6"/><verse number="7" style="v" sid="LUK 15:7"/>हाव तुमछे कयता छे कि इनी रीति छे एक मण फिरावने वावा पापी क विषयमा भी सोरगमा ओत्रा ही खुशी होय छे जोत्रा कि चारविसु नोव ओसो न्यायीन क विषय नी हुयसे जीने पाप कयनो छुड़ दिया कि छचो नी।<verse eid="LUK 15:7"/></para>
  <para style="s">खुवाय होया सिक्‍का क दृष्टान्त</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8"/>या कुण ओसी बायर होयछे जीसके साथे दस सिक्‍का होय आरू उनमा छे एक खुवाय जाय तो वो दिया धपाडीन हेरती आरू घर मा बाहरी झाटकीन जव तक मिव नी जाय जी लगाड़ीन हेरती नी रयी? <verse eid="LUK 15:8"/><verse number="9" style="v" sid="LUK 15:9"/>आरू जव मिव जाता छे तो वो सख्या आरू धडेवावा क एखठा करीन कयती छे मारे साथे खुशी करो काहकि मारा खुवायला होया शिक्‍का मिव गया छे। <verse eid="LUK 15:9"/><verse number="10" style="v" sid="LUK 15:10"/>हाव तुमछे कयता छे की इनी रीति छे एक पाप छे मन फीरावणे वावा पापी क विषय मा यहोवा–भगवान क सोरगदूत क सामने खुश हुयसे छे।<verse eid="LUK 15:10"/></para>
  <para style="s">खुवायला पोर्‍या क दृष्टान्त</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11"/>पछु ईशु कयो, “काही मानुस क दूय पोर्‍या हुता।” <verse eid="LUK 15:11"/><verse number="12" style="v" sid="LUK 15:12"/>उनमा छे नाना ने बास छे कयो, “हे बास धन मा छे जो भाग मारो होय वो मखे देय दिजीये। त्यो उनको आपसी धन वाट देदी।” <verse eid="LUK 15:12"/><verse number="13" style="v" sid="LUK 15:13"/>घोणा दाहाड़ा नी वीत्या हुता क नाना पोर्‍या सब काय एखठा करीन दुर देस क चाली गया आरू वा कुकर्म मा आपसी सम्पती उड़ाय दीया। <verse eid="LUK 15:13"/><verse number="14" style="v" sid="LUK 15:14"/>जव वो सब काय सच्च कर चूक्या तो ओको देसमा मोटा अकाल पड़्या आरू वो गरीब होय गया। <verse eid="LUK 15:14"/><verse number="15" style="v" sid="LUK 15:15"/>अतरान करीन वो ओको देस क नीवासियो मा छे एक क याहा काम हरने क गया। त्यो ओको छे आपने खेतो मा सुहर्‍या चारने क करता मोकल्या। <verse eid="LUK 15:15"/><verse number="16" style="v" sid="LUK 15:16"/>आरू वो जुवता हुता की फलीया छे जीनुक सुहर्‍या खाता हुता आपसा पेट भर, आरू उको काही काय खाना नी देता हुता। <verse eid="LUK 15:16"/><verse number="17" style="v" sid="LUK 15:17"/>जव वो आपने आप मा आश तव कयनो लाग्या, “मारा बास क कोतरा हिय दाहड़क्या क भोजन छे खुबुत् रोटा मीवतो छे आरू हाव या भुकलो मर रया छे।” <verse eid="LUK 15:17"/><verse number="18" style="v" sid="LUK 15:18"/>हाव हिमी उठीन आपने बास क साते जाइस आरू उको कवीस की बाबजी हाव ने यहोवा–भगवान (सोरग) क विरोध मा आरू तारी दृष्टी मा पाप कर्‍या छे। <verse eid="LUK 15:18"/><verse number="19" style="v" sid="LUK 15:19"/>हिमी इनीये योग्य नी रया की तारे पोर्‍या कोवाइस मखे आपने एक दाहड़क्या क समान राख लेय। <verse eid="LUK 15:19"/><verse number="20" style="v" sid="LUK 15:20"/>तव वो उठीन आपने बास क साथे चाली:</para>
  <para style="p" vid="LUK 15:20">वो अब दुर ही हुता की ओका बास ने ओको देखीन दवडीन आयो आरू दवडीन ओको गले लगाड़या आरू घोणा त्योम्मा। <verse eid="LUK 15:20"/><verse number="21" style="v" sid="LUK 15:21"/>पोर्‍या ने उको कयो, “बास जी हाव ने यहोवा–भगवान (सोरग) क विरोध मा आरू तारी दृष्टी मा पाप कर्‍या छे आरू हिमी इनीये योग्य नी रया की तारे पोर्‍या कोवाइस।” <verse eid="LUK 15:21"/><verse number="22" style="v" sid="LUK 15:22"/>पुन बास ने तुमरा दास छे कयो, “झट वारला छे वारला छिंदरा नीकावीन ओको पेहराया आरू ओका हात मा मुंद्या, आरू पायमा खासड़ा पेहराया।” <verse eid="LUK 15:22"/><verse number="23" style="v" sid="LUK 15:23"/>आरू पला बुकड़ो लावीन मारा ताकी हामु खासे आरू खुश मनाया। <verse eid="LUK 15:23"/><verse number="24" style="v" sid="LUK 15:24"/>काहकि मारे या पोर्‍या मर गया हुता, पछु जीव गया छे: खुवाय गया हुता हिमी मिव गया छे आरू वो खुश करने लाग्या।<verse eid="LUK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25"/>पुन ओको जेठा पोर्‍या खेत मा हुता। जव वो आवता हूया घर क नीकट पुच्चा तो त्यो गीते गावने आरू नाचने क ओवाज सोमव्या। <verse eid="LUK 15:25"/><verse number="26" style="v" sid="LUK 15:26"/>शेवली कावा त्यो एक दास क बुलावीन पुछा, “हय काय होय रया छे?” <verse eid="LUK 15:26"/><verse number="27" style="v" sid="LUK 15:27"/>त्यो उनछे कुवा तारो भाई आयो छे आरू तारो बास ने पला हुया बुकड़ो कटाड़ीया छे। अतरान करीन ओको भला वारलो देख्या छे।<verse eid="LUK 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28"/>यो सोमवीन वो रीस छे भर गया आरू माहीय जाने नी जुवता, पुन ओको बास बाहरता आवीन ओको मानने लाग्या। <verse eid="LUK 15:28"/><verse number="29" style="v" sid="LUK 15:29"/>त्यो बास क जवाब दिया देख हावने ओतरा साल छे तारी सेवा कर रया छे आरू कदी भी तारी हुकुम ने नी टाली, तो भी तु ने मखे कदी एक नानो बुकड़ा क पिल्लो भी नी दीया की हाव आपने दोस्तो क साथे खुश करता। <verse eid="LUK 15:29"/><verse number="30" style="v" sid="LUK 15:30"/>पुन जव तारे यो पोर्‍या जीसने तारी धन वेची आयो मा उड़ाय दियो छे आश तो ओका करता तु ने पला हुया बुकड़ो कटाड़ीयो। <verse eid="LUK 15:30"/><verse number="31" style="v" sid="LUK 15:31"/>त्यो ओका सी कयो, “पोर्‍या तु सर्वदा मारे साथे छे; आरू जो काय मारो छे वो सब तारे ही छे। <verse eid="LUK 15:31"/><verse number="32" style="v" sid="LUK 15:32"/>1 पुन हिमी खुश करने आरू मगन हुयने जुवे काहकि यो तारो भाईस मर गया हुता, पछु जीवतु होई गुयो; खुवाया हुता हिमी मिव गया छे।”<verse eid="LUK 15:32"/></para>
  <chapter eid="LUK 15"/>
  <chapter number="16" style="c" sid="LUK 16"/>
  <para style="s">चतरावो भण्डारी</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1"/>पछु त्यो चेला छे भी कयो, “काही धनवान क भण्डारी हुता, आरू मानसे ने ओका सामने ओको पर यो दोषी लागाड़ ्या कि वो तारी संपत्ती उड़ाय देता छे।” <verse eid="LUK 16:1"/><verse number="2" style="v" sid="LUK 16:2"/>शेवली कावा त्यो ओको बुलावीन कयो, “यो काय छे जो हाव तारे विषय मा सोमवाय रया छे? आपने भण्डारी क पद लिख दिया, काहकि तु ओगव क भण्डारी नी रया सकता।” <verse eid="LUK 16:2"/><verse number="3" style="v" sid="LUK 16:3"/>तव भण्डारी सुचने लाग्या, “हिमी हाव काय करीस? काहकि मारो भगवान हिमी भण्डारी क काम मखे छे छिन रया छे। धरती तो मखे छे खोदी नी जाती; आरू भीख मांगने मा मखे लाज आवती छे।” <verse eid="LUK 16:3"/><verse number="4" style="v" sid="LUK 16:4"/>हाव समझ गया की काय करीस, ताकि जव हाव भण्डारी क काम छे छुड़ाया जाछे तो मानसे मखे आपने घर मा लेय।<verse eid="LUK 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5"/>“तव त्यो आपने भगवान क देनदा़र क एक करीन बुलाया आरू पेहले छे पूछा तुखे पर मारे भगवान क कोतरा कर्ज छे?” <verse eid="LUK 16:5"/><verse number="6" style="v" sid="LUK 16:6"/>त्यो कयो, “सौ मन तेल, तव त्यो ओका सी कयो, आपसा खाता वहय लेय आरू बठीन तत्काल पचास लिख देय।” <verse eid="LUK 16:6"/><verse number="7" style="v" sid="LUK 16:7"/>पछु त्यो दिसरा छे पुछा, “तुखे पर कतरो कर्ज छे? त्यो कयो, सौ मन गवे, तव त्यो ओका सी कयो, आपसा खत वेरने लीन चारविसु लिख देय।”<verse eid="LUK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 16:8"/>“भगवान ने ओको अन्यायी भण्डारी क सराहा कि त्यो चालाक छे काम कर्‍या छे। काहकि इनीये संसार क मानसे आपने टेहाव क मानसे क साथे रीति व्यवहार मा प्रकाश क मानसे छे सवटो त्योरावा छे।”<verse eid="LUK 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 16:9"/>आरू हाव तुमू छे कयता छे कि अन्याय क धन छे आपने करता दोस्त बन लेवु, ताकि जव वो जाता रया तो वो तुम्हे अमरकाय जागू मा ली लेय। <verse eid="LUK 16:9"/><verse number="10" style="v" sid="LUK 16:10"/>जो थुड़ा छे मा विश्वास छे वो घोणा मा भी विश्वास छे: आरू जो थुड़ा छे थुड़ा मा अन्यायी, वो घोणा मा भी अन्यायी। <verse eid="LUK 16:10"/><verse number="11" style="v" sid="LUK 16:11"/>एरकरीन जव तुमू अन्याय क धन मा विश्वास नी ठेराया, तो सच्च धन तुम्हे कुन सपछे? <verse eid="LUK 16:11"/><verse number="12" style="v" sid="LUK 16:12"/>आरू यदि तुमू पोराया धन मा सच्च नी ठेराया तो जो तुमरा छे, ओको तुम्हे कुन देसे?<verse eid="LUK 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:13 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 6:24">मत्ती 6:24</ref>
      </char>
    </note>काही दास दुय यहोवा–भगवान क सेवा नी कर सकता: काहकि वो तो एक सी बैर आरू दिसरा छे मोंग राखसे: या एक सी ईमानदार रोवछे आरू दिसरा क तुच्छ जानछे। तुमू यहोवा–भगवान आरू धन दुयन सेवा नी कर सकता।<verse eid="LUK 16:13"/></para>
  <para style="s">ईशु क काय शिक्षा</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14"/>फरीसियो जो धन को लालची हुता यो सब वात सोमवीन उना थठ्ठा मा उड़ावने लाग्या। <verse eid="LUK 16:14"/><verse number="15" style="v" sid="LUK 16:15"/>ईशु उनछे कयो, “तुमू तो माणुस क सामने आपने आपको न्यायी ठेहराया होय, पुन यहोवा–भगवान तुमरे मन क जानता छे काय कि जो समान माणुस कि दृष्टी मा सच छे वो यहोवा–भगवान क निकट गलत छे।<verse eid="LUK 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">16:16 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 11:12">मत्ती 11:12</ref>,<ref loc="MAT 11:13">13</ref></char>
    </note>“मूसा कि व्यवस्था आरू भविष्यवक्ता यहुन्ना बपतिस्मा देनेवालान तक रया; उना टेहाव छे यहोवा–भगवान क राज्य क खुश खबर सोमवाया जाय रया छे आरू हर काही उना मा उशारी छे भरायने करता छे। <verse eid="LUK 16:16"/><verse number="17" style="v" sid="LUK 16:17"/><note caller="+" style="x"><char style="xo" closed="false">16:17 </char><char style="xt" closed="false"><ref loc="MAT 5:18">मत्ती 5:18</ref></char></note>आकाश आरू धरती क गायप होय जाने व्यवस्था क एक बिंदु क मीट जाने सी सहज छे।<verse eid="LUK 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18"/>“जो काही आपसी बायर क सोडीन दुसरी छे ईहाव करता छे वो व्यभिचार करता छे आरू जो काही ओसी सुडीन होयी बायर छे ईहाव करता छे वो भी व्यभिचार करता छे।”<verse eid="LUK 16:18"/></para>
  <para style="s">धनवान मानुस आरू गरीब लाज़र</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19"/>“एक धनवान माणुस हुता बैंजनी छिंदरा आरू मलमल क पेहरता आरू हर दहाडो सुख विलास आरू धुम धाम क साथे रयता हुता।” <verse eid="LUK 16:19"/><verse number="20" style="v" sid="LUK 16:20"/>लाज़र नामको एक गरीब घावो छे भरा हुया ओकी आंगना मा पर छुड़ दिया जाता हुता। <verse eid="LUK 16:20"/><verse number="21" style="v" sid="LUK 16:21"/>आरू वो जुवता हुता कि धनवान कि हावज पर पड्यो हुयो खानो छे उष्टो छे आपसा पेठ भरे; या तक कि कुत्रा भी आवीन ओका घाव क चाटता हुता।<verse eid="LUK 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22"/>ओसो हुया कि वो गरीब मर गया आरू सोरगदूत ने ओको लीन अब्राहम क धड़े मा पुचाड्या। वो धनवान भी मरा आरू गाड़या गया, <verse eid="LUK 16:22"/><verse number="23" style="v" sid="LUK 16:23"/>आरू नरक मानसे मा त्यो पीड़ा मा पड़्या हुया आपसी डुवा उठाय आरू दुर छे अब्राहम क धड़े मा लाजर क देख्या। <verse eid="LUK 16:23"/><verse number="24" style="v" sid="LUK 16:24"/>तव त्यो आयड़ीन कयो, “हे बास, अब्राहम मखे पर दया कर लाज़र स क मुकली दे ताकी वो आपसी आंगवी क टोक पानी मा बुडावीन मारी जीभ छेवी कर, काहकि हाव इनीये ज्वाला मा तडप रया छे।”<verse eid="LUK 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25"/>पुन अब्राहम ने कयो, “हे पोर्‍या स्मरण कि तु आपने जीवन मा वारलो समान ले त्योक्या छे आरू ओसो ही लाज़र बुरी समान पुन हिमी वो याहा सुख देख रया छे आरू तु तडप रया छे।” <verse eid="LUK 16:25"/><verse number="26" style="v" sid="LUK 16:26"/>इन वात क छुड़ीन हामरे आरू तुमरे विच मा एक भारी खाडु ठेहराया गया छे कि जो या छे ओको पार तुमरे साथे जाने जुवे वो नी जाय सक्या आरू नी कायी वा छे इनीये पार हामरे साथे आये सक्या। <verse eid="LUK 16:26"/><verse number="27" style="v" sid="LUK 16:27"/>उना धनवान मानुस ने कयो, “तो हे बास अब्राहम, हाव तुखे छे विनती करता छे कि तु लाज़र क मारे बास क घर मुकल्या।” <verse eid="LUK 16:27"/><verse number="28" style="v" sid="LUK 16:28"/>“काहकि वा मारे पाच भाई छे वो ओको सामने इन वात कि देखाड़ दे ओसो नी होय कि वो भी इनीये पीड़ा कि धरती मा आवी।”<verse eid="LUK 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29"/>अब्राहम ओका सी कयो, “ओको साथे मूसा क नियम आरू भविष्यवक्ता कि किताब छे वो उन क चेतावनी दे।” <verse eid="LUK 16:29"/><verse number="30" style="v" sid="LUK 16:30"/>धनवान मानुस कयो नी हे बास अब्राहम, पर यदि काय मारे हुया मा छे उठीन ओको साथे जाईन तो वो पापो छे मन फिराव छे। <verse eid="LUK 16:30"/><verse number="31" style="v" sid="LUK 16:31"/>अब्राहम ओका सी कयो, “जव वो मूसा आरू भविष्यवक्ता किही नी सोमवता तो यदि मारा हुया मा छे कायी जी भी उठीन जाय तो भी ओकी नी मानोय।”<verse eid="LUK 16:31"/></para>
  <chapter eid="LUK 16"/>
  <chapter number="17" style="c" sid="LUK 17"/>
  <para style="s">पाप</para>
  <para style="r">(<ref loc="MAT 18:6-7">मत्ती 18:6-7</ref>; <ref loc="MAT 21-22">21–22</ref>; <ref loc="MRK 9:42">मरकुस 9:42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1"/>पछु ईशु आपने चेला छे कयो, “होय नी सकता कि पाप मा डालता नी लागे पुन हाव ओको माणुस पर जिना क कारण वो आवती छे!” <verse eid="LUK 17:1"/><verse number="2" style="v" sid="LUK 17:2"/>जो इन नानो मा छे काही एक क पाप मा डालता छे ओका करता यो भला हुयसे कि चक्‍की क पुड ओका गवा मा लटकावीन जाता आरू वो दरियामा नाक दिया जाता। <verse eid="LUK 17:2"/><verse number="3" style="v" sid="LUK 17:3"/><note caller="+" style="x"><char style="xo" closed="false">17:3 </char><char style="xt" closed="false"><ref loc="MAT 18:15">मत्ती 18:15</ref></char></note>सचेत रयो;</para>
  <para style="p" vid="LUK 17:3">यदि तारे भाईस पाप कर्‍या तो उको सुधारे आरू यदि पछातावो तो ओको माफ कर। <verse eid="LUK 17:3"/><verse number="4" style="v" sid="LUK 17:4"/>यदि दाहड़ा भर मा वो सात बार तारे विरोध मा पाप करे आरू सात वार तारे साथे पछु आवीन कयो, “हाव पछातावो छे, तो ओको माफ कर।”<verse eid="LUK 17:4"/></para>
  <para style="s">विश्वास</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5"/>तव प्रेरितने पोरबु छे कयो, “आमरो विश्वास बढ़ाव।”<verse eid="LUK 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6"/>पोरबुने कयो, “यदि तुमू कायी राई क दानो क बराबर भी विश्वास हुयसे, तो तुमू इनीये तुत्तु क झाड़को क छे कयता कि जड़ छे उखड़ीन आपने आप दरिया मा लाग जा, तो वो तुमरी हुकुम मान लेता।”<verse eid="LUK 17:6"/></para>
  <para style="s">एक दास क जिम्मेवारी</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7"/>“यदि तुमू मा छे ओसो कुण छे जेको दास हल जोतीन या गाडरा चारता होय आरू जव वो खेत छे आश तो ओका सी कयो छाटो दावीन भोजन करने बठ्या, बिलकुल नी!” <verse eid="LUK 17:7"/><verse number="8" style="v" sid="LUK 17:8"/>आरू यो नी कयो, “मारो खानो तीयार कर आरू जव तक हाव खाय, पीय तव तक कमर बांधीन मारी सेवा कर ओका बाद तु भी खाय, पीय ले।” <verse eid="LUK 17:8"/><verse number="9" style="v" sid="LUK 17:9"/>काय वो उना दास क करलो काम एहसान मान छे कि त्यो वो ही काम कर्‍या जीसकी दीही गयी होती। <verse eid="LUK 17:9"/><verse number="10" style="v" sid="LUK 17:10"/>इनी रीति छे तुमू भी जव उन सब काम क कर त्योक्या जीसकी तुम्हे दि गयी होती, तो कहु, “हामु फालता दास छे; जो हामु करने जुया हुता हामु ने केवल वा कर्‍या छे।”<verse eid="LUK 17:10"/></para>
  <para style="s">ईशु न एक मानुस क वारू करनो</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11"/>ओसो हुया क ईशु यरूशलेम जाता हुया सामरिया आरू गलील क बीच मा छे होयीन जाय रया हुता। <verse eid="LUK 17:11"/><verse number="12" style="v" sid="LUK 17:12"/>काही गाँव मा भरायने करता टेहाव ओको दस कुड़ावा मिव्या जो दुर उबा हुता। <verse eid="LUK 17:12"/><verse number="13" style="v" sid="LUK 17:13"/>त्या जोरदीन ओवाज छे कयो, “हे ईशु भगवान हामु पर दया कर!”<verse eid="LUK 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14"/>त्यो तीनुक देखीन कयो, “जावो आरू आपने आपको पुजारा क देखाडु”</para>
  <para style="p" vid="LUK 17:14">आरू जाता ही जाते वो चुखो होयी गया। <verse eid="LUK 17:14"/><verse number="15" style="v" sid="LUK 17:15"/>तव उनमा छे एक यह देखीन कि हाव वारू हुयी गया छे उंची ओवाज छे यहोवा–भगवान कि बढ़ाई करता हुया पछो आयो। <verse eid="LUK 17:15"/><verse number="16" style="v" sid="LUK 17:16"/>आरू ईशु क पाय पर मुयी क बल पाड़ी उना क धन्यवाद करने लाग्या; आरू वो सामरिया हुता। <verse eid="LUK 17:16"/><verse number="17" style="v" sid="LUK 17:17"/>इनीये पर ईशु कयो, “कायी दस चुखो नी हुया तो पछु वो नोव कहा छे। <verse eid="LUK 17:17"/><verse number="18" style="v" sid="LUK 17:18"/>काय इनीये परदेश क छुड़ीन आरू नी निकव्या जो यहोवा–भगवान कि बढ़ाई करता?” <verse eid="LUK 17:18"/><verse number="19" style="v" sid="LUK 17:19"/>तव ईशु ओका सी कयो, “उठीन चाली जा; तारे विश्वास तुखे वारू कर्‍या छे।”<verse eid="LUK 17:19"/></para>
  <para style="s">यहोवा–भगवान क राज्य क आवनो</para>
  <para style="r">(<ref loc="MAT 24:23-28">मत्ती 24:23-28</ref>,<ref loc="MAT 24:37-41">37-41</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20"/>जव फरीसियो ने उनछे पुछा, यहोवा–भगवान क राज्य किही आवसे तो त्यो उनको जवाब दिया, “यहोवा–भगवान क राज्य दृश्य रूप मा नी आवता।” <verse eid="LUK 17:20"/><verse number="21" style="v" sid="LUK 17:21"/>आरू मानसे यो नी कवसे, “या छे या वा छे काहकि यहोवा–भगवान क राज्य तुमरे विच मा छे।”<verse eid="LUK 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22"/>पछु त्यो चेला छे कयो, “वो दहाडो आवसे जीनमा तुमू माणुस क पोर्‍या क दहाडो मा छे एक दहाडो देखनो जुवे आरू नी देखने देख्या। <verse eid="LUK 17:22"/><verse number="23" style="v" sid="LUK 17:23"/>मानसे तुमछे कवसे, ‘वा छे’ या ‘देखो या छे’ पुन तुमू चाली नी जाने, आरू नी ओको पछव चाल देदा। <verse eid="LUK 17:23"/><verse number="24" style="v" sid="LUK 17:24"/>काहकि जोसो विजवी आकाश क एक छोर निकवीन इन टेके कर तीन टेके चमकती छे, वोसो ही माणुस क पोर्‍य भी आपने दाहाड़ा मा प्रकट होय छे। <verse eid="LUK 17:24"/><verse number="25" style="v" sid="LUK 17:25"/>पुन पहेले छाचो छे कि वो घोणा दुःख हाकलिया आरू इनीये युग क मानसे ओको तुच्छ ठेहराया।” <verse eid="LUK 17:25"/><verse number="26" style="v" sid="LUK 17:26"/>जोसो नूहा क दाहड़ा मा हुया हुता वोसो ही माणुस क पोर्‍या क दाहड़ा मा भी हुयसे। <verse eid="LUK 17:26"/><verse number="27" style="v" sid="LUK 17:27"/>जिना दहाडे तक नूह ढोंड्या पर नी चढया उना दिन तक मानसे खाता, लोगहन खाता–पीता हुता, आरू इहाव वियाव हुयती हुती। तव जलप्रलय ने आवीन उन सब क नष्ट कर्‍या। <verse eid="LUK 17:27"/><verse number="28" style="v" sid="LUK 17:28"/>आरू जोसो लुत क दाहाड़ा मा हुया हुता कि मानसे खाता, पिता लेना, देना करता, झाड़का लगाड़ ता आरू घर बनावता हुता। <verse eid="LUK 17:28"/><verse number="29" style="v" sid="LUK 17:29"/>पुन जिना दहाड़े लुत सदोम छे निकव्या उना दहाड़े आगठो आरू गंधक आकाश छे बरसी आरू सबको नष्ट कर दिया। <verse eid="LUK 17:29"/><verse number="30" style="v" sid="LUK 17:30"/>माणस क पोर्‍य क प्रकट हुयने क दहाडो भी ओसो ही होयछे।<verse eid="LUK 17:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 17:31"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">17:31 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:17">मत्ती 24:17</ref>,<ref loc="MAT 24:18">18</ref>; <ref loc="MRK 13:15">मरकुस 13:15</ref>,<ref loc="MRK 13:16">16</ref></char>
    </note>उना दाहाड़ा जो छत पर होय आरू ओको चादरो घर मा होय वो ओको लेने क नी उतरीया। वोसो ही जो खेत मा होय वो पछो नी पुगीयो। <verse eid="LUK 17:31"/><verse number="32" style="v" sid="LUK 17:32"/>लुत कि बायर क स्मरण रख्या! <verse eid="LUK 17:32"/><verse number="33" style="v" sid="LUK 17:33"/>जो कुई आपसा जीव वाचाडनो चाहे चो ओको खुवसे आरू जो कुई ओको खुवे चो ओको वाचाड़ राखे <verse eid="LUK 17:33"/><verse number="34" style="v" sid="LUK 17:34"/>हाव तुमू छे कयता छे, उना रात दुय मानसे एक खाटला पर सुया होय छे; एक उठाव ली जासे आरू दिसरा छुड़ देय जासे। <verse eid="LUK 17:34"/><verse number="35" style="v" sid="LUK 17:35"/>दुय बायर एक साथे मा चक्‍की दवायती होती, एक उठाव ली जासे, आरू दिसरी छुड़ देय जासे। <verse eid="LUK 17:35"/><verse number="36" style="v" sid="LUK 17:36"/><note caller="+" style="f"><char style="fr" closed="false">17:36 </char><char style="ft" closed="false">यो वचन जुनो शास्त्रलेख मा नी छे</char></note> दुय जन खेत मा होय छे एक आरू दिसरा छुड़ देय जासे।<verse eid="LUK 17:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37"/>यो सोमवीन ईशु पुछा, “हे पोरबु यो क होयछे?”</para>
  <para style="p" vid="LUK 17:37">ईशु उनछे कयो, “जहा धड़ छे वाँ घुवड़ एखठा होयछे।”<verse eid="LUK 17:37"/></para>
  <chapter eid="LUK 17"/>
  <chapter number="18" style="c" sid="LUK 18"/>
  <para style="s">अन्यायी न्यायाधीश आरू रंडायली क दृष्टान्त</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1"/>ईशु ओका विषय मा कि नीत्य प्रार्थना करने आरू हीयाव नी छुड़ने जुवे त्यो यो दृष्टान्त क द्वारा सिकाड्या। <verse eid="LUK 18:1"/><verse number="2" style="v" sid="LUK 18:2"/>काही नगर मा एक न्यायी रयता हुता जो नी यहोवा–भगवान सी बीक राखता हुता आरू नी काही मानुस की परवा करता हुता। <verse eid="LUK 18:2"/><verse number="3" style="v" sid="LUK 18:3"/>तीनी नगर मा एक रंडायली भी रयती होती जो ओका साथे आय आवीन कयो करती होती, “मारे न्यायी चुकाकर मखे मुद्दई छे वाचाड़।” <verse eid="LUK 18:3"/><verse number="4" style="v" sid="LUK 18:4"/>काही टेहाव तक तो वो नी मान पुन आखरी मा मन मा विचार कर कयो, “यदि हाव नी यहोवा–भगवान सी बीक राखता हुता आरू नी मानुस की काही परवाह करता छे।” <verse eid="LUK 18:4"/><verse number="5" style="v" sid="LUK 18:5"/>तौभी यो रंडायली मखे सताती रयती छे, अतरान करीन हाव ओको न्याय चुकाड़ता, कयी ओसो नी हाव की घड़ी–घड़ी आवीन आखरी क मारे नाक मा दम कर्‍या।<verse eid="LUK 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6"/>पोरबु ने कयो, “सोमवु यो अन्यायी न्यायी काय कयता छे?” <verse eid="LUK 18:6"/><verse number="7" style="v" sid="LUK 18:7"/>अतरान करीन काय यहोवा–भगवान आपने नेवाड़ला हुया क न्याय नी चुकाड़से, जो रात–दाहडो ओकी मदत क करता रड़ता मदत क करता आयड़ता रया छे? काय वो ओको विषय मा देर करसे। <verse eid="LUK 18:7"/><verse number="8" style="v" sid="LUK 18:8"/>हाव तुमछे कयता छे, वो छाटोत ओको न्याय चूकाड़छे। तौभी मानुस क पोर्‍या जव आवसे तो काय वो धरती पर विश्वास देखछे?<verse eid="LUK 18:8"/></para>
  <para style="s">फरीसि आरू व्याज लेनेवावा क दृष्टान्त</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9"/>त्यो उनछे जो आपने उपर विश्वास राखता छे कि हामु न्यायी सी आरू दिसरा क तुच्छ जानता हुता यो दृष्टान्त कयो: <verse eid="LUK 18:9"/><verse number="10" style="v" sid="LUK 18:10"/>दुय मानुस मंदिर मा प्रार्थना करने क करता गया एक फरीसि हुता आरू दीसर व्याज लेनेवावा।<verse eid="LUK 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 18:11"/>फरीसि उबो हईन आपने मन मा यो प्रार्थना करने लाग्या, “हे यहोवा–भगवान, हाव तारो धन्यवाद करता छे की हाव दिसरा मानुस क समान लोभी, बेईमान आरू व्यभिचारी नी, आरू नी इनीये व्याज लेनेवावा क समान छे।” <verse eid="LUK 18:11"/><verse number="12" style="v" sid="LUK 18:12"/>हाव सप्ताह हाव दुय बार उपवास राखता छे; हाव आपसी सब कमाय क दसवो अंश भी देता छे।<verse eid="LUK 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13"/>“पुन फाळो लेनेवाळा ने दुर उबा हईन सोरग की आरू आपसा डुवा उठाड़ीन भी नी जुया वरना आपसी छाती ठुक–ठुकीन कयो, हे यहोवा–भगवान, मखे पापी पर दया कर!” <verse eid="LUK 18:13"/><verse number="14" style="v" sid="LUK 18:14"/><note caller="+" style="x"><char style="xo" closed="false">18:14 </char><char style="xt" closed="false"><ref loc="MAT 23:12">मत्ती 23:12</ref>; <ref loc="LUK 14:11">लूका 14:11</ref></char></note>हाव तुमू छे कयता छे की वो दिसरा नी, पुन योही मानुस न्यायी ठेराया जाय आपने घर गया; काहकि जो काही आपने आपको मोटो बनावछे, वो नम्र कयो जाछे; आरू जो आपने आपको नम्र बनावछे, वो मोटो कर्‍या जाछे।<verse eid="LUK 18:14"/></para>
  <para style="s">नानो पोर्‍या आरू ईशु</para>
  <para style="r">(<ref loc="MAT 19:16-30">मत्ती 19:16-30</ref>; <ref loc="MRK 10:17-31">मरकुस 10:17-31</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15"/>पछु मानसे आपने पोर्‍या क भी ओका साथे लावने लाग्या की वो उन पर हाथ राख्य: पुन चेला ने देखीन तीनुक लड़िया। <verse eid="LUK 18:15"/><verse number="16" style="v" sid="LUK 18:16"/>ईशु ने पोर्‍या क साथे बुलावीन कयो, “पोर्‍या क मारे साथे आवने देवु आरू तीनुक मना नी करू: काहकि यहोवा–भगवान क राज्य ओसो ही क छे।” <verse eid="LUK 18:16"/><verse number="17" style="v" sid="LUK 18:17"/>हाव तुम छे सच कयता छे कि जो काही यहोवा–भगवान क राज्य क पोर्‍या क समान मान्य नी करसे वो उको कदी भरायने करने नी देखे।<verse eid="LUK 18:17"/></para>
  <para style="s">धनवान माणुस आरू अमरकाय जीवन</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18"/>काही यहूदि सरदार ने उको पुच्छा, “हे खरला गुरू, अमरकाय जीवन क हक हुयने क करता हाव काय करीस?”<verse eid="LUK 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19"/>ईशु ने उको कयो, “तु मखे खरला काय कयता छे? काही खरलो नी, केवल एक, मतलब यहोवा–भगवान।” <verse eid="LUK 18:19"/><verse number="20" style="v" sid="LUK 18:20"/>तु हुकुम क तो जानता छे: व्यभिचार नी करने हत्या, नी करने आरू चोरी नी करने, काही कि झुठी गवा नी देने, आपने बास आरू आपसी आश क विजुत करने।<verse eid="LUK 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21"/>यहूदि सरदार कयो, “हाव तो इन सब क लड़कपन छे मनता आवलो छे।”<verse eid="LUK 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22"/>यो समवीन ईशु ने ओका सी कयो, “तुखे हिमी भी एक वात करने छे, आपसा सब काय वेचीन गरीबो मा वाट देय; आरू तुखे सोरग मा धन मिवछे, आरू आवीन मारे पछळ होय ले।” <verse eid="LUK 18:22"/><verse number="23" style="v" sid="LUK 18:23"/>वो यो समवीन जुवान क चेहरो नराज हुयो, काहकि वो मोटो धनी हुता।<verse eid="LUK 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 18:24"/>ईशु ने ओको देखीन कयो, “धनवान क यहोवा–भगवान क राज्य मा भरायने करने कतरा वातड़ो छे! <verse eid="LUK 18:24"/><verse number="25" style="v" sid="LUK 18:25"/>यहोवा–भगवान क राज्य मा धनवान क भरायने करने वातड़ो छे, लीन उटड़ान क सुवी क गाळा मा छे नीकाव जने छे सहज छे।”<verse eid="LUK 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26"/>इनीये पर समवने वावा ने पुछा, “तो पछु कुनीन उध्दार हुयसे छे?”<verse eid="LUK 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27"/>ईशु कयो, “जो मानुस छे नी होय सकता, वो यहोवा–भगवान छे होय सकता छे।”<verse eid="LUK 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28"/>पतरस ईशु क कयो, “हामु तो घर–बार छुड़ीन तारे पछळ जाय लेदा छे।”<verse eid="LUK 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29"/>त्यो ओका सी कयो, “हाव तुमछे सच कयता छे की ओसो काही नी जीसने यहोवा–भगवान क राज्य क करता घर, या बायर, या भाईस, या आश–बास, या पोर्‍या क छुड़ दीया होय:”<verse eid="LUK 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 18:30"/>“आरू इनीये टेहाव कयी गुना ज्यादा नी देख्या आरू आवने वावा युग मा अमरकाय जीवन।”<verse eid="LUK 18:30"/></para>
  <para style="s">आपसी मृत्यु क विषय ईशु की तीसरी भविष्यव्दाणी</para>
  <para style="r">(<ref loc="MAT 20:17-19">मत्ती 20:17-19</ref>; <ref loc="MRK 10:32-34">मरकुस 10:32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31"/>पछु त्यो बारा क साथे लीन जाईन उनछे कयो, “देखो हामु यरूशलेम क जाता छे आरू जोतरी वात मानुस क पोर्‍या क करता भविष्यवक्ता क द्बारा लिखी गयी छे, वो सब पुरी होयछे। <verse eid="LUK 18:31"/><verse number="32" style="v" sid="LUK 18:32"/>काहकि वो गैरयहुदी क हाथ मा सौप देसे, आरू वो उको ठट्ठा मा उड़ावने; आरू ओको विजुत करने, आरू उना पर थूपने, <verse eid="LUK 18:32"/><verse number="33" style="v" sid="LUK 18:33"/>आरू उको कोड़ मारने, आरू घात करने: आरू वो तीसरे दाहडे जीवीन उठसे।”<verse eid="LUK 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34"/>पर चेलोने इन वात मा छे काय वात नी समझा: आरू यो वात उनछे डुकाडीन रयी, आरू ईशु जो कयो गया हुता वो चेलो कि समझ मा नी आश।<verse eid="LUK 18:34"/></para>
  <para style="s">आँधवो भिखारी क दृष्टीदान</para>
  <para style="r">(<ref loc="MAT 20:29-34">मत्ती 20:29-34</ref>; <ref loc="MRK 10:46-52">मरकुस 10:46-52</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35"/>जव ईशु यरीहो नगर क नाट पुच्चा, ते दूय आंदवो सडक क धोड़े बठयो हुयो भीख मांग रया हुता। <verse eid="LUK 18:35"/><verse number="36" style="v" sid="LUK 18:36"/>वो गर्दी क चालने की आवाज सोमवीन पुछने लाग्या, “यो काय होय रया छे?”<verse eid="LUK 18:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 18:37"/>त्या ओको देखाड्या, “ईशु नासरत नगर जाय रया छे।”<verse eid="LUK 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38"/>तव त्यो आयडी क कयो, “हे ईशु, दाऊद कि अवलियाद, हामरे पर दया कर!”<verse eid="LUK 18:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39"/>जो ओगोव–ओगोव जाय रया हुता, वो ओको लड़ायने लाग्या की चुप रया: पुन वो आरू भी आयड़ने लाग्यो, “हे दाऊद की अवलियाद, मखे पर दया कर!”<verse eid="LUK 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40"/>तव ईशु ने उबा हईन हुकुम देदी की ओको मारे साथे लावु, आरू जव वो आंधवो नीकट आयो ते त्यो ओका सी पुछा, <verse eid="LUK 18:40"/><verse number="41" style="v" sid="LUK 18:41"/>“तु काय जुवता छे की हाव तारे करता करीस?”</para>
  <para style="p" vid="LUK 18:41">त्यो कयो, “हे पोरबु, यो की हाव देखने लाग्यो।”<verse eid="LUK 18:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42"/>ईशु ने उको कयो, “देखने लाग्या; तारे विश्वास ने तुखे वारू कर दीया छे।”<verse eid="LUK 18:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 18:43"/>तव वो छाटोत देखने लाग्यो आरू यहोवा–भगवान की बढ़ाई करता हुया ओका पछव होय लेदा; आरू सब मानसे ने देखिन यहोवा–भगवान कि बढ़ाई कर्‍या।<verse eid="LUK 18:43"/></para>
  <chapter eid="LUK 18"/>
  <chapter number="19" style="c" sid="LUK 19"/>
  <para style="s">फावो लेनेवावा जक्‍कई</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1"/>वो यरीहो मा भरायने करीन जाय रया हुता। <verse eid="LUK 19:1"/><verse number="2" style="v" sid="LUK 19:2"/>वाँ जक्‍कयो नावको मानुस हुता जो फावो लेनेवावा क सरदार हुता आरू धनी हुता। <verse eid="LUK 19:2"/><verse number="3" style="v" sid="LUK 19:3"/>वो ईशु क देखने जुवता हुता कि वो कुन सा छे। पुन गर्दी क कारण देख नी सकता हुता, काहकि वो बटक्या हुता। <verse eid="LUK 19:3"/><verse number="4" style="v" sid="LUK 19:4"/>तव ओको देखने क करता वो ओगव दौडीन एक गुलर क झाड़का पर चढ़ गया, काहकि ईशु तीनेत मार्ग छे जानेवावा हुता। <verse eid="LUK 19:4"/><verse number="5" style="v" sid="LUK 19:5"/>जव ईशु उना धरती पुच्चा तो ऊपर दृष्टि करीन ओका सी कयो, “हे जक्‍कयो, छाटो उतर आव; काहकि आज मखे तारे घर मा रयने पाको छे।”<verse eid="LUK 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 19:6"/>वो तत्काल उतरीन खुशी छे उको आपने घर ली गया। <verse eid="LUK 19:6"/><verse number="7" style="v" sid="LUK 19:7"/>यो देखीन सब मानसे कुरकुर करने लाग्या, “वो तो एक पापी मानुस क याहा जाय उतरियो छे।”<verse eid="LUK 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8"/>जक्‍कयो ने उबा हईन पोरबु छे कयो, “हे पोरबु, देख हाव आपसी आधी सम्पती गरीबो क देता छे, आरू यदि काही क भी अन्याय करीन लेदा छे तो उको चोवगुना फेर देता छे।”<verse eid="LUK 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9"/>तव ईशु ने ओका सी कयो, “आज इनीये घर मा उध्दार आश छे, अतरान करीन कि यो भी अब्राहम क एक पोर्‍या छे। <verse eid="LUK 19:9"/><verse number="10" style="v" sid="LUK 19:10"/><note caller="+" style="x"><char style="xo" closed="false">19:10 </char><char style="xt" closed="false"><ref loc="MAT 18:11">मत्ती 18:11</ref></char></note>काहकि मानुस क पोर्‍या खुवायो हुयो क हेरने आरू ओको उध्दार करने आश छे।”<verse eid="LUK 19:10"/></para>
  <para style="s">दस मुहारो क दृष्टान्त</para>
  <para style="r">(<ref loc="MAT 25:14-30">मत्ती 25:14-30</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11"/>जव वो यो वात सोमवी रया हुता, तो त्यो एक दृष्टांत कयो, अतरान करीन कि वो यरूशलेम क नीकट हुता, आरू वो समझता हुता कि यहोवा–भगवान क राज्य अब प्रगट हुयने वावा छे। <verse eid="LUK 19:11"/><verse number="12" style="v" sid="LUK 19:12"/>शेवली कावा त्यो कयो, “एक धनि मानुस दुर देस क चाली ताकी राज्य क पद देख्या पछा फीरीन आश।” <verse eid="LUK 19:12"/><verse number="13" style="v" sid="LUK 19:13"/>त्यो तुमरा दासो मा छे दस क बुलावीन तीनुक दस मुहर दिदा आरू उनछे कयो, “मारे पछव फिरीन आवने तक लेन–देन करने।” <verse eid="LUK 19:13"/><verse number="14" style="v" sid="LUK 19:14"/>पुन ओका नगर क रयने वावा ओका सी बैर रखता हुता, आरू ओका पछळ दुत क द्बारा कहवाये मुकल्या, “हामु नी जुवता कि यो हामु पर राज्य करे।”<verse eid="LUK 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15"/>जव वो राज्य क पद जुड़यो तव वा पछा पुगीयो, तो ओसो हुया कि त्यो आपने दासो क जीनुक रोकड दि होती, आपने साथे बुलाया ताकि मालम कर्‍या की त्या लेन–देन छे काय–काय कमाया। <verse eid="LUK 19:15"/><verse number="16" style="v" sid="LUK 19:16"/>तव पेहले ने आवीन कयो, “हे भगवान, तारी मुहर छे दस आरू मुहर कमाया छे।” <verse eid="LUK 19:16"/><verse number="17" style="v" sid="LUK 19:17"/>त्यो ओका सी कयो, “वारला आरू सयाळा दास! तु घोणा ही थुडा मा छे विश्वास योग्य नीकाव्या हिमी दस नगर पर हक राख।” <verse eid="LUK 19:17"/><verse number="18" style="v" sid="LUK 19:18"/>दिसरा आवीन कयो, “हे स्वामी, तारा सिक्‍का छे पाच आरू सिक्‍का कमाया छे।” <verse eid="LUK 19:18"/><verse number="19" style="v" sid="LUK 19:19"/>त्यो ओका सी भी कयो, “तु भी पाच नगर क सरदार क शासक बनजी।”<verse eid="LUK 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 19:20"/>दिसरा आवीन कयो, “हे भगवान, देख सोनान सिक्‍का यो छे, जीनाक हाव ने पुतल्या मा बांधीन राख्या हुता। <verse eid="LUK 19:20"/><verse number="21" style="v" sid="LUK 19:21"/>काहकि हाव तुखे छे घबरायता हुता, अतरानकरीन कि तु ठुकर मानुस छे: जो तुने नी राख्या उको उठा लेता छे, आरू जो तुने जव वेर्‍या, उको काटतो छे।” <verse eid="LUK 19:21"/><verse number="22" style="v" sid="LUK 19:22"/>त्यो ओका सी कयो, “हे दृष्ट दास, हाव तारी मुह छे तुखे दोषी ठेहराया छे। तु मखे जानता हुता की ठुकर मानुस छे, जो हाव ने नी राख्या छे उठाय लेता, आरू जो हावने नी वेर्‍या उको काटतो छे; <verse eid="LUK 19:22"/><verse number="23" style="v" sid="LUK 19:23"/>तो तुने मारा धन सराफो क साथे काय नी राख्या दीया की हाव आवीन व्याज सहावत लेय लेता?”<verse eid="LUK 19:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 19:24"/>आरू जो मानसे उबा हुता, त्यो उनछे कयो, “वो सोनान सिक्‍का ओका सी लेय ले, आरू जेका साथे दस सोनान सिक्‍का छे उको दे दो।” <verse eid="LUK 19:24"/><verse number="25" style="v" sid="LUK 19:25"/>त्या ओका सी कयो, “हे भगवान, ओका साथे दस सोनान सिक्‍का ते छे।” <verse eid="LUK 19:25"/><verse number="26" style="v" sid="LUK 19:26"/>“हाव तुमछे कयतु छे की जेका साथे छे, उको दीया जाछे; आरू जेका साथे नी छे, उको वो भी जो ओका साथे छे ले लेदा जाछे।” <verse eid="LUK 19:26"/><verse number="27" style="v" sid="LUK 19:27"/><note caller="+" style="x"><char style="xo" closed="false">19:27 </char><char style="xt" closed="false"><ref loc="MAT 25:14-30">मत्ती 25:14-30</ref></char></note>“पुन मारे उन दुस्मनयो क जो नी जुवता हुता की हाव उन पर राज्य करीस, उनको या लावीन मारे सामने घात करीस।”<verse eid="LUK 19:27"/></para>
  <para style="s">यरूशलेम मा विजय भरायने</para>
  <para style="r">(<ref loc="MAT 21:1-11">मत्ती 21:1-11</ref>; <ref loc="MRK 11:1-11">मरकुस 11:1-11</ref>; <ref loc="JHN 12:12-19">यहुन्ना 12:12-19</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28"/>यो वात कयीन वो यरूशलेम की आरू ओको अगळ–अगळ चाल्या। <verse eid="LUK 19:28"/><verse number="29" style="v" sid="LUK 19:29"/>जव वो जैतुन नाव क बयड़ा पर बैतफगे आरू बैतनिया क साथे पुच्चा, तो त्यो तुमरा चेला मा छे दुय क यो कयीन मुकल्या, <verse eid="LUK 19:29"/><verse number="30" style="v" sid="LUK 19:30"/>“सामने क गाव मा जावु; आरू उको पुचता ही एक गदड़ी क पीलो जीस पर कदी कोय सवार नीहि हुया, बांधियो हुया तुम्हे मीवछे, ओको छुड़ीन लेय आवु। <verse eid="LUK 19:30"/><verse number="31" style="v" sid="LUK 19:31"/>यदि काही तुमू छे पुछ्या की काय छुड़ता होय, तो यह कय देना कि पोरबु क इनाक जरूरत छे।”<verse eid="LUK 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32"/>जो मुकल्यया गया हुता, त्या जायन जसो ईशु उनछे कयो हुता, वोसो ही देख्या। <verse eid="LUK 19:32"/><verse number="33" style="v" sid="LUK 19:33"/>जव वो गदडा क पिल्लो क छुड़ता रया हुता तो गदडा क मालीक ने त्यो पुछा, “इनीये पीला क काय छुड़ता होय?”<verse eid="LUK 19:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34"/>त्या कयो, “पोरबु क इनाक जरूरत छे।” <verse eid="LUK 19:34"/><verse number="35" style="v" sid="LUK 19:35"/>वो ओको ईशु क साथे ले आश, आरू आपने लुगड़ा उना पीला पर नाखीन ईशु क उना पर बठाड दिया। <verse eid="LUK 19:35"/><verse number="36" style="v" sid="LUK 19:36"/>जव वो जाय रया हुता, तो वो आपने लुगड़ा मार्ग मा आथरता जाता हुता। <figure style="fig" alt="Jesus’ Triumphant entry to Jerusalem" file="lb00315c।tif" size="span" copy="Horace Knowles ©" ref="19:36">यरूशलेम मा ईशु न विजय प्रवेश</figure><verse eid="LUK 19:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37"/>नीकट आवता हुया जव वो जैतुन बयड़ा की ढलान पर पुच्चा, तो चेला कि सारी मंडळी उन सब शक्ति क काम क कारण जो तीनुक देख्या हुता, खुश हईन मोटा ओवाज छे यहोवा–भगवान की बढ़ाई करने लाग्या: <verse eid="LUK 19:37"/><verse number="38" style="v" sid="LUK 19:38"/>“धन्य छे वो राजा, जो पोरबु क नाव छे आवता छे! सोरग मा शांती आरू आकाश मण्डल मा महिमा होय!”<verse eid="LUK 19:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39"/>तव गर्दी मा छे काय फरीसि उको कयनो लाग्या, “हे गुरू, आपसा चेला क लड़िया।”<verse eid="LUK 19:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40"/>त्यो जवाब दीय, “हाव तुमछे कयता छे, यदि यो चुप रया तो दगड़ा आयड़ने उठसे।”<verse eid="LUK 19:40"/></para>
  <para style="s">ईशु यरूशलेम क देखीन रड्या</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41"/>जव वा नीकट आश तो नगर क देखिन उना पर रड्या। <verse eid="LUK 19:41"/><verse number="42" style="v" sid="LUK 19:42"/>आरू यरूशलेम क देखीन कयो, “काय ही भला हुयसे की तु, हाव, तु ही, इने दाहडे हाव कुशल की वात जानता, पुन वो तारा डुवा छे डुकाय गयी छे। <verse eid="LUK 19:42"/><verse number="43" style="v" sid="LUK 19:43"/>काहकि वो दाहडो तुखे पर आवसे कि तारे दुस्मन मोरचा बांधिन तुखे घेर लेछे, आरू च्यारो तरफ छे तुखे दाब देसे; <verse eid="LUK 19:43"/><verse number="44" style="v" sid="LUK 19:44"/>आरू तुखे आरू तारा पोर्‍या क जो तुखे मा छे, धरती मा मिववछे, आरू तुखे मा दगड़ा पर दगड़ा भी नी छुड़से; काहकि उना मेखे क जव यहोवा–भगवान तुखे बचाने क था तुने उको नी पेहचान।”<verse eid="LUK 19:44"/></para>
  <para style="s">मंदिर छे व्यापारी क निकावी जाने</para>
  <para style="r">(<ref loc="MAT 21:12-17">मत्ती 21:12-17</ref>; <ref loc="MRK 11:15-19">मरकुस 11:15-19</ref>; <ref loc="JHN 2:13-22">यहुन्ना 2:13-22</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45"/>तव ईशु मंदिर मा जाईन वेचने वावा क बारथा नीकावणे लाग्या, <verse eid="LUK 19:45"/><verse number="46" style="v" sid="LUK 19:46"/>आरू उनछे कयो, शास्त्र मा लिख्या छे, यहोवा–भगवान कयता छे “मारो घर प्रार्थना क घर होयछे पुन तुमू ने उको डाकु कि खोह बनाड़ देदो छे।”<verse eid="LUK 19:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">19:47 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 21:37">लूका 21:37</ref>
      </char>
    </note>वो हर दाहडे मंदिर मा शिक्षा करता हुता; आरू मुखी पुजारा आरू शास्त्री आरू मानसे क मुखिया उको मारना क मेखे हेरता हुता। <verse eid="LUK 19:47"/><verse number="48" style="v" sid="LUK 19:48"/>पुन काही उपाय नी नीकाव सक्या की यो काही प्रकार कर्‍या, काहकि सब मानसे मोटि चाह छे ओकी सोमवता हुता।<verse eid="LUK 19:48"/></para>
  <chapter eid="LUK 19"/>
  <chapter number="20" style="c" sid="LUK 20"/>
  <para style="s">ईशु क हक पर सवाल</para>
  <para style="r">(<ref loc="MAT 21:23-27">मत्ती 21:23-27</ref>; <ref loc="MRK 11:27-33">मरकुस 11:27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1"/>एक दाहड़े ओसो कि जव ईशु यरूशलेम मंदिर मा जाईन शिक्षा दी रियो हुतो आरू खुश खबर सोमवी रया हुता, तो मुखी पुजारा आरू शास्त्री, डाहडा क साथे धड़े आवीन उबा हुया; <verse eid="LUK 20:1"/><verse number="2" style="v" sid="LUK 20:2"/>आरू कयनो लाग्या, “हामु देखाड़ तु इन काम कि काही हक छे करता छे, आरू वो कुन छे। जो तुखे यो हक दिया छे?”<verse eid="LUK 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3"/>ईशु ओका जवाब देदो, “हाव भी तुमू छे एक सवाल पुछता छे; मखे देखाडु <verse eid="LUK 20:3"/><verse number="4" style="v" sid="LUK 20:4"/>यहुन्ना क बपतिस्मा करने क हक सोरग कि तरफ छे हुता या मानसक क तरफ छे हुता?”<verse eid="LUK 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5"/>तव वो आपस मा कयनो लाग्या, “हामु काय जवाब देय, हामु कये सोरग कि तरफ छे, तो वो कवसे, पछु तुमू ने ओकी प्रतिति काय नी करी?” <verse eid="LUK 20:5"/><verse number="6" style="v" sid="LUK 20:6"/>आरू यदि हामु कये, “मानुस कि आरू छे, तो सब मानसे हामु पर दगड़ा देसे, काहकि वो सचमुच जानता छे कि यहुन्ना क कागळीयो मानता हुता।” <verse eid="LUK 20:6"/><verse number="7" style="v" sid="LUK 20:7"/>शेवली कावा त्या जवाब देदो, “हामु नी जानता कि वो काही की आरू छे हुता।”<verse eid="LUK 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8"/>ईशु ने उनछे कयो, “तो हाव भी तुम क नी देखाडता कि हाव यो काम काय हक छे करता छे।”<verse eid="LUK 20:8"/></para>
  <para style="s">दृष्ट किरसान क दृष्टान्त</para>
  <para style="r">(<ref loc="MAT 21:33-34">मत्ती 21:33-34</ref>; <ref loc="MRK 12:1-12">मरकुस 12:1-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9"/>तव वो मानसे छे यो दृष्टान्त कयनो लाग्या: “काही मानुस ने अंगुर क वाड़ी लगाया, आरू ठेका दे देदा आरू घोणा दाहाड़ा क करता परदेश जात रया।” <verse eid="LUK 20:9"/><verse number="10" style="v" sid="LUK 20:10"/>जव अंगुर क टेहाव आश तो त्यो किसान क साथे एक दास क मुकल्या की वा अंगुर की वाड़ी क काही फोव क भाग उको देय पर किसान ने उको पिटाकर खाली हाथ पछा पुगाड़ दिया। <verse eid="LUK 20:10"/><verse number="11" style="v" sid="LUK 20:11"/>पछु त्यो एक आरू दास क मुकल्या, आरू त्या उको भी पिटाकर आरू ओको विजुत करीन खाली हाथ पछा फीराय दीया। <verse eid="LUK 20:11"/><verse number="12" style="v" sid="LUK 20:12"/>पछी त्यो तीसरा मुकल्या, आरू त्या उको भी घायल करीन बाहरता नीकाव दीया। <verse eid="LUK 20:12"/><verse number="13" style="v" sid="LUK 20:13"/>तव अंगुर की वाड़ी क भगवान ने कयो, “हाव काय करीस? हाव आपने मोंगावु पोर्‍या क मुकलीस, सम्भव छे पोर्‍या क विजुत करसे।” <verse eid="LUK 20:13"/><verse number="14" style="v" sid="LUK 20:14"/>जव किसान ने उको देखा तो आपस मा विचार करने लाग्या, “यो तो वारीस; आवु, हामु इनाक मार नाख्या की मीरास हामरी होय जाछे।” <verse eid="LUK 20:14"/><verse number="15" style="v" sid="LUK 20:15"/>आरू त्या उको अंगुर न वाड़ी सी बाहर निकालीन मार न्हाखिया।</para>
  <para style="p" vid="LUK 20:15">अतरान करीन अंगुर क वाड़ी क भगवान ओको साथे काय करसे? <verse eid="LUK 20:15"/><verse number="16" style="v" sid="LUK 20:16"/>“वो आवीन उन किसान क नष्ट करसे, आरू अंगुर की वाड़ी दिसरा क सोप्या।”</para>
  <para style="p" vid="LUK 20:16">यो सोमवीन त्या कयो, “यहोवा–भगवान करे असो नी होय।”<verse eid="LUK 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17"/>ईशु ओको आरू देखिन कयो, “पछु यो काय लिख्या छे:</para>
  <para style="q1" vid="LUK 20:17">“जिन दगड़ा क राजमिस्त्री ने निकम्मा ठेराया हुता,</para>
  <para style="q2" vid="LUK 20:17">वो ही कुपरा क सीरा होय गया।”<verse eid="LUK 20:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="LUK 20:18"/>जो काही उना दगड़ा पर पड़से वो तुकड़ा होय जाछे, आरू जिना पर त्यो दगड़ो पड़से, उको चिमधी देसे।<verse eid="LUK 20:18"/></para>
  <para style="s">कैसर क कर देने क सवाल</para>
  <para style="r">(<ref loc="MAT 22:15-22">मत्ती 22:15-22</ref>; <ref loc="MRK 12:13-17">मरकुस 12:13-17</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19"/>तीनी घड़ी शास्त्री आरू मुखी पुजारा ईशु क धरने चाह्या, काहकि वो समझ गया हुता कि त्यो हामु पर यो दृष्टान्त कयो, “पुन वो मानसे छे घाबराया। <verse eid="LUK 20:19"/><verse number="20" style="v" sid="LUK 20:20"/>आरू वो ओकी ताकत मा लाग्या आरू मुकल्या की न्यायी क भेष धरीन ईशु क काही नी काही सवालो मा धरने, ताकी उको रोमन शासक क हात आरू हक मा सोप देदा।” <verse eid="LUK 20:20"/><verse number="21" style="v" sid="LUK 20:21"/>त्या ईशु छे पुछा, “हे गुरू, हामु जानता छे कि तु ठीक कयता आरू सिखाडता भी छे, आरू काही पक्ष पता नी करता, वरना यहोवा–भगवान क सच्चाई छे बताता छे। <verse eid="LUK 20:21"/><verse number="22" style="v" sid="LUK 20:22"/>काय हामु कैसर रोमि सम्राट क फाळु आपनो वारू छे या नी?”<verse eid="LUK 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23"/>ईशु ओकान चालाकसे क ताड़कर उन छे कयो, <verse eid="LUK 20:23"/><verse number="24" style="v" sid="LUK 20:24"/>“एक चाँदी क दीनार मखे देखाड़। इनीये पर काही की छाप आरू नाव छे?”</para>
  <para style="p" vid="LUK 20:24">त्या कयो, “कैसर रोमि सम्राट क।”<verse eid="LUK 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25"/>ईशु उन लोगहन सी कयो, “तो जो कैसर रोमि सम्राट क छे, वो कैसर रोमि सम्राट क देवु; आरू जो यहोवा–भगवान क वो यहोवा–भगवान क देवु।”<verse eid="LUK 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26"/>वो मानसे क सामने इनीये वात मा उको दरिया नी सक्या, वरना ओका जवाब छे घबराय हईन चुप रया गया।<verse eid="LUK 20:26"/></para>
  <para style="s">पुनरूत्थान आरू वियाव</para>
  <para style="r">(<ref loc="MAT 22:23-33">मत्ती 22:23-33</ref>; <ref loc="MRK 12:18-27">मरकुस 12:18-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">20:27 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 23:8">प्रेरितन 23:8</ref>
      </char>
    </note>पछु, सदूकियो जो कयता छे कि मारला हुया क जीवाड़ी झेलीया छे ही नी, ओका छे काही ने ओका साथे आवीन पूछा, <verse eid="LUK 20:27"/><verse number="28" style="v" sid="LUK 20:28"/>“हे गुरू मूसा ने हामरे करता यो नियम लिख्या छे: यदि काही क भाईस आपसी बायर क रयता हुया विना अवलियाद मर जाय, तो ओको भाईस ओकी बायर छे वियाव कर लेय, आरू आपने भाईस क करता अवलियाद पैदा करे। <verse eid="LUK 20:28"/><verse number="29" style="v" sid="LUK 20:29"/>सात भाईस हुता, पेहला भाईस वियाव करीन विना अवलियाद मर गया। <verse eid="LUK 20:29"/><verse number="30" style="v" sid="LUK 20:30"/>पछु दिसरा, <verse eid="LUK 20:30"/><verse number="31" style="v" sid="LUK 20:31"/>आरू तीसरे ने भी उना बायर छे वियाव कर लेदो। इनी रीति छे सात विना अवलियाद मर गया। <verse eid="LUK 20:31"/><verse number="32" style="v" sid="LUK 20:32"/>आखरी मा वो बायर भी मर गयी। <verse eid="LUK 20:32"/><verse number="33" style="v" sid="LUK 20:33"/>एरकरीन जीवीन उठने पर वो ओका छे काही की बायर होयछे? काहकि वो सात ने ओका सी वियाव होयी होती।”<verse eid="LUK 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34"/>ईशु उनछे कयो, “इनीये युग की मानसे मा तो वियाव हुयसे छे, <verse eid="LUK 20:34"/><verse number="35" style="v" sid="LUK 20:35"/>पर जो मानसे इनीये योग्य ठरछे कि उना युग क आरू मर्‍या हुया मा छे जीवीन उठने क हासिल करे, वो नी वियाव करसे आरू नी वियाव मा दिया जाछे।” <verse eid="LUK 20:35"/><verse number="36" style="v" sid="LUK 20:36"/>वो पछु मरना क भी नी; काही वो सोरगदूत क समान होयछे, आरू मरे मा छे जीव उठने क अवलियाद हुयने छे यहोवा–भगवान कि भी अवलियाद होय छे। <verse eid="LUK 20:36"/><verse number="37" style="v" sid="LUK 20:37"/>पुन इनीये वात क कि मरे हुया जीव उठ्या छे, मूसा ने भी धपतो झाड़ी कि कथा मा प्रकट करी छे कि वो पोरबु क अब्राहम क यहोवा–भगवान, आरू इसहाक क यहोवा–भगवान, आरू याकोब क यहोवा–भगवान कयता छे। <verse eid="LUK 20:37"/><verse number="38" style="v" sid="LUK 20:38"/>यहोवा–भगवान क मरला क नी पुन जीवता क यहोवा–भगवान छे काहकि ओका नीकट सब जीवता छे।<verse eid="LUK 20:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39"/>तव यो सोमवीन शास्त्री मा छे थुड़ांक यो कयो, “हे गुरू तु वारू कयो।” <verse eid="LUK 20:39"/><verse number="40" style="v" sid="LUK 20:40"/>आरू त्यो पछु ओका सी काय आरू पुछने क हिंमत नी हुया।<verse eid="LUK 20:40"/></para>
  <para style="s">मसीह कुनी पोर्‍य छे?</para>
  <para style="r">(<ref loc="MAT 22:41-46">मत्ती 22:41-46</ref>; <ref loc="MRK 12:35-37">मरकुस 12:35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41"/>पछु ईशु उनछे पुछा, “मसीह क दाऊद कि अवलियाद कसो कयता छे? <verse eid="LUK 20:41"/><verse number="42" style="v" sid="LUK 20:42"/>दाऊद आप भजन सहिंता कि किताब मा कयता छे:</para>
  <para style="q1" vid="LUK 20:42">“पोरबुने मारे पोरबुछे कयो,</para>
  <para style="q2" vid="LUK 20:42">मारे दायीन बठ्या,<verse eid="LUK 20:42"/></para>
  <para style="q2">
    <verse number="43" style="v" sid="LUK 20:43"/>जब तक कि हाव तारे दुस्मनया क तारे पाय क तोवे नी कर देसे।<verse eid="LUK 20:43"/></para>
  <para style="m">
    <verse number="44" style="v" sid="LUK 20:44"/>दाऊद तो उको पोरबु, पोरबु कयता छे; तो पछु वो ओकी पोर्‍यो कसो ठेहराया?”<verse eid="LUK 20:44"/></para>
  <para style="s">शास्त्रीयो क बारा मा इसारो</para>
  <para style="r">(<ref loc="MAT 23:1-26">मत्ती 23:1-26</ref>; <ref loc="MRK 12:38-40">मरकुस 12:38-40</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45"/>जव सब मानसे सोमवी रया हुता तो ईशु आपने चेलो छे कयो, <verse eid="LUK 20:45"/><verse number="46" style="v" sid="LUK 20:46"/>शास्त्रीयो छे चोकचौळीया रया, जीनको नाम्बा चोगला पेहर्‍या हुया पुगनेन वारला लागता छे, आरू जीने बजारमा नमस्कार आरू आराधना घरो मुखी आसन आरू भोज मा मुखी स्थान मोंगावु लागता छे। <verse eid="LUK 20:46"/><verse number="47" style="v" sid="LUK 20:47"/>वो रंडायली क घर खाये जाता छे आरू ओको गैर फायदा लेता छे आरू देखाने क करता मोटी–मोटी प्रार्थना करता रयता छे: यो घोणा ही दण्ड जोड़से।<verse eid="LUK 20:47"/></para>
  <chapter eid="LUK 20"/>
  <chapter number="21" style="c" sid="LUK 21"/>
  <para style="s">गरीब रंडायली क दान</para>
  <para style="r">(<ref loc="MRK 12:41-44">मरकुस 12:41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1"/>पछु ईशु डुवा उचा करीन धनवान क आपने मंदिर क दान भण्डार मा नाखता देख्या। <verse eid="LUK 21:1"/><verse number="2" style="v" sid="LUK 21:2"/>त्यो एक गरीब रंडायली क भी उको तांब क दुय दमड़ीया नाखता। <verse eid="LUK 21:2"/><verse number="3" style="v" sid="LUK 21:3"/>तव ईशु कयो, “हाव तुमू छे सच कयता छे कि इनीये गरीब रंडायली ने सब छे जादा नाख्या छे। <verse eid="LUK 21:3"/><verse number="4" style="v" sid="LUK 21:4"/>काहकि उन सब आपसी बढ़ती मा छे दान माहय काय नाखता छे, पुन यो आपसी घटी मा छे आपसी सब जीविका नाख देदी छे।”<verse eid="LUK 21:4"/></para>
  <para style="s">मंदिर विनाश की भविष्यव्दाणी</para>
  <para style="r">(<ref loc="MAT 24:1-2">मत्ती 24:1-2</ref>; <ref loc="MRK 13:1-2">मरकुस 13:1-2</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5"/>जव काय मानसे मंदिर क विषय मा चेलो हाव छे कायी ने कय रया हुता कि वो कोसो घाटळो दगड़ो आरू यहोवा–भगवान क दिये भेंट छे संबारा गया छे, तो ईशु कयो, <verse eid="LUK 21:5"/><verse number="6" style="v" sid="LUK 21:6"/>“वो दाहड़ो आवसे, जिनहाव यो सब जो तुमू देखता होय, ओका छे याहा काही दगड़ा पर दागड़ा भी नी छुटसे जो ढाया नी जाछे।”<verse eid="LUK 21:6"/></para>
  <para style="s">संकट आरू पीड़ा</para>
  <para style="r">(<ref loc="MAT 24:3-14">मत्ती 24:3-14</ref>; <ref loc="MRK 13:3-13">मरकुस 13:3-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7"/>ईशु ओका सी पुछा, “हे गुरू, यो सब काह होयछे? आरू यो वात जव पुरी हुयने पर होयछे, तो उना टेहाव क काय सहलानी होयछे?”<verse eid="LUK 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8"/>ईशु कयो, चोकचौळीया रयो भरमाय नी जावु, काहकि घोणा छे मारे नाव छे आवीन कयसे, “हाव ची छे, आरू यो भी कि, टेहाव निकट आय पुच्चा छे तुमू ओको पछव नी चाल्या जाने।” <verse eid="LUK 21:8"/><verse number="9" style="v" sid="LUK 21:9"/>“जव तुमू लड़ाइयो आरू बलवों की चर्चा सोमवु तो घबराय नी जाने, काहकि इन्दरो पेहले हुयने पाको; पुन उना टेहाव तत्काल आखरी होयछे।”<verse eid="LUK 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10"/>तव त्यो उनछे कयो, “देश पर देश आरू राज्य पर राज्य लड़ाई करसे, <verse eid="LUK 21:10"/><verse number="11" style="v" sid="LUK 21:11"/>आरू मोटा भूकप होयछे, आरू धरती अकाल आरू महामारिया पड़से, आरू आकाश छे भयंकर वात आरू मोटी सहलानी प्रगट होयछे। <verse eid="LUK 21:11"/><verse number="12" style="v" sid="LUK 21:12"/>पुन इन सब वात छे पेहले वो मारे नाव क कारण तुमू पर पड़से, आरू सतावछे, आरू पचायतो मा सौपछे, आरू जेल मा नाखछे, आरू राजा आरू सरदार क सामने ली जाछे। <verse eid="LUK 21:12"/><verse number="13" style="v" sid="LUK 21:13"/>पर यो तुमरे करता खुश खबर कि गवा देने क मेखे हो जाछे। <verse eid="LUK 21:13"/><verse number="14" style="v" sid="LUK 21:14"/>एरकरीन मन मा ठान राख्या कि आपने खुद क कोसो वाचाड़ने क करता पेहले छे चिंता नी करसे। <verse eid="LUK 21:14"/><verse number="15" style="v" sid="LUK 21:15"/>काहकि हाव तुम्हे ओसो बुल आरू बुध्दि देसे कि तुमरे सब विरोधी सामना या खण्डन नी कर सकछे। <verse eid="LUK 21:15"/><verse number="16" style="v" sid="LUK 21:16"/>तुमरे आश बास, आरू भाईस, आरू रिश्तेदार, आरू दोस्त भी तुमूक धरावसे; या तक कि तुमू मा छे काय क माराय नाखछे। <verse eid="LUK 21:16"/><verse number="17" style="v" sid="LUK 21:17"/>मारा नाव सी सब मानसे तुमू छे बैर करसे। <verse eid="LUK 21:17"/><verse number="18" style="v" sid="LUK 21:18"/>पुन तुमरे मुनका क झटा भी वाका नी होयछे। <verse eid="LUK 21:18"/><verse number="19" style="v" sid="LUK 21:19"/>आपने धीरज छे तुमू आपने जीव क वाचाड़ी राखछे।<verse eid="LUK 21:19"/></para>
  <para style="s">ईशु यरूशलेम क विनाश क बारा मा बुल्यो</para>
  <para style="r">(<ref loc="MAT 24:15-21">मत्ती 24:15-21</ref>; <ref loc="MRK 13:14-19">मरकुस 13:14-19</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20"/>“जव तुमू यरूशलेम क छेना छे घिरा हुया देखो, जान लेय कि ओको उजाड़ जाने नाट छे। <verse eid="LUK 21:20"/><verse number="21" style="v" sid="LUK 21:21"/>तव जो यहूदि या मा होय वो बयड़ा पर ढास जाय; आरू जो यरूशलेम क माहीय होय वो बाहरता निकवी जाय; आरू जो गाँव मा होय वो उना शहरो माहीय नी जाय। <verse eid="LUK 21:21"/><verse number="22" style="v" sid="LUK 21:22"/>काहकि यो बदला लेने क ओसो दाहड़ो होयछे, जिन वचन मा लिखी हुयी सब वात पूरी होय जाछे। <verse eid="LUK 21:22"/><verse number="23" style="v" sid="LUK 21:23"/>उन दाहड़ा मा जो भारीस आरू दूध पिवाड़ती होयछे, ओको करता हाय, हाय! काहकि धरती पर मोट पीड़ा आरू इन मानसे पर मोट प्रकोप होयछे। <verse eid="LUK 21:23"/><verse number="24" style="v" sid="LUK 21:24"/>वो तलवार छे मार देय जाछे, आरू सब देश क मानसे मा बंद हईन पुचाड़े जाछे; आरू जव तक गैर यहूदि क टेहाव पूरा नी होय तव तक यरूशलेम गैरयहुदी छे रौंदा जाछे।<verse eid="LUK 21:24"/></para>
  <para style="s">मानुस क पोर्‍या मतलब ईशु क पुनरूत्थान</para>
  <para style="r">(<ref loc="MAT 24:29-31">मत्ती 24:29-31</ref>; <ref loc="MRK 13:24-27">मरकुस 13:24-27</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">21:25 </char>
      <char style="xt" closed="false">
        <ref loc="REV 6:12">प्रकाशितवाक्य 6:12</ref>,<ref loc="REV 6:13">13</ref></char>
    </note>“दाहडु आरू चाँद, आरू तारे मा सहलानी देखाय देसे; आरू धरती पर देश क मानसे क सकट होयछे, काहकि वो दरिया क गरजने आरू लहरा क कोलाहल छे घाबराय जाछे। <verse eid="LUK 21:25"/><verse number="26" style="v" sid="LUK 21:26"/>बीक क कारण आरू संसार पर आवनेवावी घटना की वाट देखता मानसे क जीव मा जीव नी रवछे, काहकि आकाश की शक्ति हाल जाछे। <verse eid="LUK 21:26"/><verse number="27" style="v" sid="LUK 21:27"/><note caller="+" style="x"><char style="xo" closed="false">21:27 </char><char style="xt" closed="false"><ref loc="REV 1:7">प्रकाशितवाक्य 1:7</ref></char></note>तव वो मानुस क पोर्‍या क शक्ति आरू मोटी महिमा क साथे वादवा पर आवता देखछे। <verse eid="LUK 21:27"/><verse number="28" style="v" sid="LUK 21:28"/>जव यो वात हुयने लागी, तो सुध उबा हईन आपने मुनका ऊपर हाकलने; काहकि तुमरा छुटकारा निकट होयछे।”<verse eid="LUK 21:28"/></para>
  <para style="s">अंजीर क झाड़का क उदाहरण</para>
  <para style="r">(<ref loc="MAT 24:32-35">मत्ती 24:32-35</ref>; <ref loc="MRK 13:28-31">मरकुस 13:28-31</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29"/>ईशु उनछे एक दृष्टान्त भी कयो: “अंजीर क झाड़को आरू सब झाड़का क देख्या। <verse eid="LUK 21:29"/><verse number="30" style="v" sid="LUK 21:30"/>ज्योही ओका कोपले निकावती छे, तो तुमू देखीन आप ही जान लेता कि ग्रीष्मकाल निकट छे।” <verse eid="LUK 21:30"/><verse number="31" style="v" sid="LUK 21:31"/>इनी रीति छे जव तुमू यो वात हुयसे देखु, तव जान ले कि यहोवा–भगवान क राज्य निकट छे।<verse eid="LUK 21:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32"/>हाव तुमू छे सच कयता छे कि जव तक यो सब वात नी होय लेय, तव तक इनीये पीढ़ी क कदी आखरी नी होयछे। <verse eid="LUK 21:32"/><verse number="33" style="v" sid="LUK 21:33"/>आकाश आरू धरती टवे जाछे, पुन मारी वात कदी नी टळसे।<verse eid="LUK 21:33"/></para>
  <para style="s">जागता रयो</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34"/>एरकरीन सावधान रयो, ओसो नी होय कि तुमरे मन खुमार, आरू मतवालेपन, आरू इनीये जीवन की चिंता छे सुस्त होय जाय, आरू वो दाहड़े तुमू पर फंदान क समान उचकाळुन आय पड़्या। <verse eid="LUK 21:34"/><verse number="35" style="v" sid="LUK 21:35"/>काहकि वो सारी धरती क सब रयनेवावा पर इनी प्रकार आय पड़से। <verse eid="LUK 21:35"/><verse number="36" style="v" sid="LUK 21:36"/>“एरकरीन जागता रयो कि तुमू इन सब हर टेमे प्रार्थना करता रवु, आवनेवाळा घटना छे वाचाड़ने आरू मानुस क पोर्‍या क सामने उबा हुयने क योग्य बनु।”<verse eid="LUK 21:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">21:37 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 19:47">लूका 19:47</ref>
      </char>
    </note>वो दाहड़ा मा क मंदिर मा सिखाडता हुता, आरू रात क बाहरता जाईन जैतुन नावको बयड़ा पर रया करता हुता; <verse eid="LUK 21:37"/><verse number="38" style="v" sid="LUK 21:38"/>आरू रोज भोर क जलदी सब मानसे ओकी सोमवने क करता मंदिर मा ओका साथे आवी करता हुता।<verse eid="LUK 21:38"/></para>
  <chapter eid="LUK 21"/>
  <chapter number="22" style="c" sid="LUK 22"/>
  <para style="s">ईशु क विरोध षड्यन्त्र</para>
  <para style="r">(<ref loc="MAT 26:1-5">मत्ती 26:1-5</ref>; <ref loc="MRK 14:1-2">मरकुस 14:1-2</ref>; <ref loc="JHN 11:45-53">यहुन्ना 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1"/>अखमीरी रूटा क पर्व जो फसह छे, निकट हुता; <verse eid="LUK 22:1"/><verse number="2" style="v" sid="LUK 22:2"/>आरू मुखी पुजारा आरू शास्त्री इनीये वात की खोज मा हुता की ओको कोसो मार नाखीस, पर वो मानसे छे घाबरायता हुता।<verse eid="LUK 22:2"/></para>
  <para style="s">यहूदा क विश्वासघाती</para>
  <para style="r">(<ref loc="MAT 26:14-16">मत्ती 26:14-16</ref>; <ref loc="MRK 14:10-11">मरकुस 14:10-11</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 22:3"/>तव शैतान यहूदा मा समाया, जो इस्करियोती कवाये आरू बारा चेला मा गिने जाता हुता। <verse eid="LUK 22:3"/><verse number="4" style="v" sid="LUK 22:4"/>यहूदाने जाईन मुखी पुजारा आरू मंदिर क पहरू क सरदार क साथे वातचीत करी कि ओको काही प्रकार ओको हात धराया। <verse eid="LUK 22:4"/><verse number="5" style="v" sid="LUK 22:5"/>वो खुश हुया, आरू उको पोशा देने क वचन दिया। <verse eid="LUK 22:5"/><verse number="6" style="v" sid="LUK 22:6"/>त्यो मान लेदा, आरू मेखे हेरने लाग्या कि जव गर्दी नी होय तो ओको हात धराय दिदा।<verse eid="LUK 22:6"/></para>
  <para style="s">चेला क साथे फसह क आखरी भोज</para>
  <para style="r">(<ref loc="MAT 26:17-25">मत्ती 26:17-25</ref>; <ref loc="MRK 14:12-21">मरकुस 14:12-21</ref>; <ref loc="JHN 13:21-30">यहुन्ना 13:21-30</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7"/>तव अखमीरी रूटा क पर्व क दाहाड़े आयो, जिनामा फसह क हाव गाडरान बलि चढ़ावता छे, <verse eid="LUK 22:7"/><verse number="8" style="v" sid="LUK 22:8"/>“ईशु पतरस आरू यहुन्ना क यो कोईन मुकल्या: जाईन हामरे खाने क करता फसह तीयार करू।”<verse eid="LUK 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 22:9"/>त्या ओका सी पूछा, “तु कयो, जुवता छे कि हामु इनाक तीयार करू?”<verse eid="LUK 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 22:10"/>त्यो ओका सी कयो, “देखु, नगर मा भरायने करता ही एक मानुस पानी क वटवो उठाय हुया तुमूक मिवछे; जिना घर मा वो जाय तुमू ओका पछव चालने” <verse eid="LUK 22:10"/><verse number="11" style="v" sid="LUK 22:11"/>आरू उना घर क भगवान छे कयनो: “गुरू तुखे छे कयता छे कि वो पाहंतराय करने क घर कयो छे जिना मा आपने चेला क साथे तीवार खावु?” <verse eid="LUK 22:11"/><verse number="12" style="v" sid="LUK 22:12"/>वो तुमूक एक सजी–सजावळी मोटी उपर कि कमरो देखाय देसे; वो हामरे करता तीयार करू।<verse eid="LUK 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 22:13"/>त्या जाईन, जोसो त्यो उनछे कयो हुता, वोसो ही देख्या आरू तीवार तीयार कर्‍या।<verse eid="LUK 22:13"/></para>
  <para style="s">पोरबु भोज</para>
  <para style="r">(<ref loc="MAT 26:26-30">मत्ती 26:26-30</ref>; <ref loc="MRK 14:22-26">मरकुस 14:22-26</ref>; <ref loc="1CO 11:23-25">1 कुरन्थियो 11:23-25</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14"/>जव घड़ी आय पुच्चा, तो वो प्रेरितन क साथे भोजन करने बठ्या। <verse eid="LUK 22:14"/><verse number="15" style="v" sid="LUK 22:15"/>आरू त्यो उनछे कयो, “मखे मोटी लालस होती कि दुःख भोगने छे पहले यो तीवार तुमरे साथे खासे। <verse eid="LUK 22:15"/><verse number="16" style="v" sid="LUK 22:16"/>काहकि हाव तुमछे कयता छे की जव तक वो यहोवा–भगवान क राज्य मा पुरा नि होय तव तक हाव उको कदी नी खाइस।”<verse eid="LUK 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 22:17"/>तव त्यो वाटको लीन धन्यवाद कर्‍या आरू कयो, “इनीये क ले आरू आपस मा वाट लेवु। <verse eid="LUK 22:17"/><verse number="18" style="v" sid="LUK 22:18"/>काहकि हाव तुमछे कयता छे कि जव तक यहोवा–भगवान क राज्य नी आवे तव तक हाव अंगुर क रस हिमी छे कदी नी देखीस।”<verse eid="LUK 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19"/>पछु त्यो रूटा लीन आरू धन्यवाद करीन तुडीन आरू उनको यो कयता हुया आपियो, “यो मारी देह छे जो तुमरे करता देदी जाती छे: मारे स्मरण क करता योही कर्‍या करो।” <verse eid="LUK 22:19"/><verse number="20" style="v" sid="LUK 22:20"/>इनी रीति छे त्यो भोजन क वाटको भी यो कयता हुया दिया, “यो वाटको मारे उना लुहूय यो मा जी तुमरे करता वेर्‍या जाता छे नयी वाचा छे।”<verse eid="LUK 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 22:21"/>पर देखु, मखे धरावने वावा क हाथ मारे साथे हावज पर छे। <verse eid="LUK 22:21"/><verse number="22" style="v" sid="LUK 22:22"/>“काहकि मानुस क पोर्‍या तो जोसो ओका करता ठेराया गया जाता ही छे, पर हाय उना मानुस पर जेका द्बारा वो धराया जाता छे!”<verse eid="LUK 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 22:23"/>तव आपस मा पुछताछ करने लाग्या कि हामु मा छे कुन छे, यो काम करसे।<verse eid="LUK 22:23"/></para>
  <para style="s">आखा रया मोट कुन</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">22:24 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 18:1">मत्ती 18:1</ref>; <ref loc="MRK 9:34">मरकुस 9:34</ref>; <ref loc="LUK 9:46">लूका 9:46</ref></char>
    </note>ओका यो वाद विवाद भी हुया की उन मा छे कुन मोटो समझ जाता छे। <verse eid="LUK 22:24"/><verse number="25" style="v" sid="LUK 22:25"/>त्यो ओका सी कयो, “गैरयहुदी क राजा उन पर पोरबुता करता छे; आरू जो उन पर हक राखता छे, वो करलो काम कोवायता छे।” <verse eid="LUK 22:25"/><verse number="26" style="v" sid="LUK 22:26"/>पुन ओसो नी हुयने वरना जो तुमू मा मोटा छे वो नानो क समान आरू जो प्रधान छे, वो सेवक क समान बने। <verse eid="LUK 22:26"/><verse number="27" style="v" sid="LUK 22:27"/><note caller="+" style="x"><char style="xo" closed="false">22:27 </char><char style="xt" closed="false"><ref loc="JHN 13:12-15">यहुन्ना 13:12-15</ref></char></note>काहकि मोटो कुन छे, जो भोजन करने बठ्या छे, या वो जो सेवा करता छे? काय वो नीहि जो भोजन करने बठ्या छे? पुन हाव तुमरे वीचमा सेवक क समान छे।<verse eid="LUK 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 22:28"/>“तुमू चाज से, जो मारी परीक्षा मा लगातार मारे साथ रोया; <verse eid="LUK 22:28"/><verse number="29" style="v" sid="LUK 22:29"/>आरू जसो मारे बास ने मारे करता जो हक मारे क राज्य करने देदा छे, वोसो ही हाव भी तुमरे क हक देतो छे, <verse eid="LUK 22:29"/><verse number="30" style="v" sid="LUK 22:30"/>ताकि तुमू मारा राज्य मा मारी हावज पर खावु पिवु, वरना राजगाद्दी पर बठीन इस्राएल क बारा वंश क न्याय करू।<verse eid="LUK 22:30"/></para>
  <para style="s">पतरस क बारा मा भविष्यव्दाणी</para>
  <para style="r">(<ref loc="MAT 26:31-35">मत्ती 26:31-35</ref>; <ref loc="MRK 14:27-31">मरकुस 14:27-31</ref>; <ref loc="JHN 13:36-38">यहुन्ना 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31"/>“शमौन, हे शमौन! सुन, शैतान ने तुमू सब क पारखने क करता मांग लेदा छे कि बुरे मा छे वारू क अलग करता छे जोसो किसान गवे क भुसो मा छे अलग करता छे, <verse eid="LUK 22:31"/><verse number="32" style="v" sid="LUK 22:32"/>पुन हाव थारे करता प्रार्थना करीयो की थारो विश्वास कम नी हुये; आरू जव तु पछो आवे, ती थारा विश्वासी भाईस क पाका करजी।”<verse eid="LUK 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33"/>पतरस ओका सी कयो, “हे पोरबु, हाव तारे साथे जेल जाने, आरू मरना क भी तीयार छे।”<verse eid="LUK 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34"/>ईशु पतरस सी कयो, “हे पतरस, हाव तुखे छे कयता छे कि आज कुकड़ा वाषने नी तव तक तु तीन बार मारो मना नी कर लीस कि तु मखे नी जानता।”<verse eid="LUK 22:34"/></para>
  <para style="s">बटुवो, झुलो, आरू तलवार</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35"/>पछु ईशु ओका सी कयो, “जव हाव ने तुम्हे बटुवो, झुली, आरू खासड़ा विना मुकल्या हुता, तो काय तुमू क काही सामान की घटी हुयी होती?”</para>
  <para style="p" vid="LUK 22:35">त्या कयो, “काही सामान की नी।”<verse eid="LUK 22:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36"/>त्यो ओका सी कयो, पुन हिमी ओका साथे बटुवो होय वो उको ली आरू वोसो ही झुली भी आरू ओका साथे तलवार नी होय वो आपसा लुगड़ा वेचीन एक मुवे लेय। <verse eid="LUK 22:36"/><verse number="37" style="v" sid="LUK 22:37"/>काहकि हाव तुमू छे कयता छे, कि यो जो लिखा छे: “वो गुणेगार क साथे गिना गया, ओको मखे मा पूरा हुयने पाको छे; काहकि मारा विषय मा लिखी वात पूरी हुयने पर छे।”<verse eid="LUK 22:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38"/>त्या कयो, “हे पोरबु, याहा दुय तलवार छे!” त्यो उनछे कयो, “घोणा छे।”<verse eid="LUK 22:38"/></para>
  <para style="s">जैतुन क बयड़ा पर ईशु की प्रार्थना</para>
  <para style="r">(<ref loc="MAT 26:36-46">मत्ती 26:36-46</ref>; <ref loc="MRK 14:32-42">मरकुस 14:32-42</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39"/>तव वो बारा निकवीन आपसी रीति क लारे जैतुन क बयड़ा पर गया, आरू चेला ओका पछव चाल देदा। <verse eid="LUK 22:39"/><verse number="40" style="v" sid="LUK 22:40"/>उना धरती पुच्चा त्यो उनछे कयो, “प्रार्थना करू कि तुमू परीक्षा मा नी पड़्या।”<verse eid="LUK 22:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 22:41"/>आरू वो आप उनछे अलग एक ढेला फेकना कि दूरी भर गया, आरू घुटना टेकीन प्रार्थना करने लाग्या, <verse eid="LUK 22:41"/><verse number="42" style="v" sid="LUK 22:42"/>“हे पिता, यदि तु जुवे तो इनीये दुःख क वाटको क मारे साथे छे हटा लेय, तौभी मारी नी पुन तारी ही मरजी पूरी होय।” <verse eid="LUK 22:42"/><verse number="43" style="v" sid="LUK 22:43"/>तव सोरग छे एक ओको देखाय दिया जो उको शक्ति देता हुता <verse eid="LUK 22:43"/><verse number="44" style="v" sid="LUK 22:44"/>वो घण व्याकुल हईन आरू भी हार्दिक वेदना छे प्रार्थना करने लाग्यो; आरू ओको गाम लुहूयन बूंदो क समान धरती पर पड़ रया हुता।<verse eid="LUK 22:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45"/>तव वो प्रार्थना छे उठ्यो आरू आपने चेला क साथे आवीन तीनुक शोक कि उदासी क मारे सुवता देख्या <verse eid="LUK 22:45"/><verse number="46" style="v" sid="LUK 22:46"/>आरू उनछे कयो, “काय सुवता होय? उठो, प्रार्थना करो कि तुमू परीक्षा मा नी पडु।”<verse eid="LUK 22:46"/></para>
  <para style="s">ईशु क धोखे छे धराय जाने</para>
  <para style="r">(<ref loc="MAT 26:47-56">मत्ती 26:47-56</ref>; <ref loc="MRK 14:43-50">मरकुस 14:43-50</ref>; <ref loc="JHN 18:3-11">यहुन्ना 18:3-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47"/>ईशु यो कय ही रया कि एक गर्दी आवी, आरू उन बारा मा छे एक जेरो नाव यहूदा हुता ओको ओगव आय रया हुता। वो ईशु क साथे आश कि ओको गुवो लेदो। <verse eid="LUK 22:47"/><verse number="48" style="v" sid="LUK 22:48"/>ईशु ओका सी कयो, “यहूदा, काय तु चुमलीन मानुस क पोर्‍या क धराय देता छे?”<verse eid="LUK 22:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49"/>ओका चेलो ने जव देख्या कि काय हुयने वालो छे, वो कयो, “हे पोरबु, काय हामु तलवार चालाड़जे?” <verse eid="LUK 22:49"/><verse number="50" style="v" sid="LUK 22:50"/>आरू उनमा छे एक डाहला पुजारा क दास पर तलवार चालाड्या ओको डावु कांटो तुड़ देदो।<verse eid="LUK 22:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51"/>इनीये पर ईशु कयो, “हिमी बस कर।” आरू ओको कांटो छूकर ओको वारू कर्‍या।<verse eid="LUK 22:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52"/>तव ईशु मुखी पुजारा आरू मंदिर क पहरू क सरदार आरू डाहडा छे, जो उना पर चढ़ आश हुता, कयो, “काय तुमू मखे डाकू जानीन तलवार आरू ड़ेगा लेदा निकाव होय?” <verse eid="LUK 22:52"/><verse number="53" style="v" sid="LUK 22:53"/><note caller="+" style="x"><char style="xo" closed="false">22:53 </char><char style="xt" closed="false"><ref loc="LUK 19:47">लूका 19:47</ref>; <ref loc="LUK 21:37">21:37</ref></char></note>जव हाव मंदिरमा हर दहाडे तुमरे साथे हुता, तो तुमू ने मखे पर हात नी नाख्या, पर यो तुमरी घड़ी छे, आरू आंधारला क हक छे।<verse eid="LUK 22:53"/></para>
  <para style="s">पतरस क मना</para>
  <para style="r">(<ref loc="MAT 26:57-58">मत्ती 26:57-58</ref>,<ref loc="MAT 26:69-75">69-75</ref>; <ref loc="MRK 14:53-54">मरकुस 14:53-54</ref>,<ref loc="MRK 14:66-72">66-72</ref>; <ref loc="JHN 18:12-18">यहुन्ना 18:12-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54"/>पछु वो ईशु क धरीन ली चाल्या आरू महा पुजारा क घर मा लाया। पतरस दुर ही दुर ओका पछो चालता हुता। <verse eid="LUK 22:54"/><verse number="55" style="v" sid="LUK 22:55"/>आरू जव वो आंगना मा आगठो धपाडीन एखठा बठ्या, तो पतरस भी ओको विच मा बठ्या गया। <verse eid="LUK 22:55"/><verse number="56" style="v" sid="LUK 22:56"/>तव एक दासी उको आगठो क विजावो मा बठ्या देखीन आरू ओकी आरू ताककर कयनो लागी, “यो भी तो ईशु क साथे हुता।”<verse eid="LUK 22:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57"/>पुण पतरस यो कयीन मानने सी मना कर्‍या, “हे नारी हाव उको नी जानता।”<verse eid="LUK 22:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58"/>थुडी देर बाद काही आरू ने उको देखीन कयो, “तु भी तो तीनी मा छे है”</para>
  <para style="p" vid="LUK 22:58">पतरस ने कयो, “हे माणुस, हाव नी छे।”<verse eid="LUK 22:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59"/>काही घंटे पर क बाद एक आरू माणुस यकीन छे कहने लाग्या, “छाचो यो भी तो ओका साथे हुता, काहकि यो गलीली छे।”<verse eid="LUK 22:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60"/>पतरस कयो, “हे माणुस हाव नी जानता कि तु काय कयता छे।”</para>
  <para style="p" vid="LUK 22:60">वो कयीन रया कि छाटोत कुकड़ा ने वाषने लाग्यो। <verse eid="LUK 22:60"/><verse number="61" style="v" sid="LUK 22:61"/>तव पोरबु ने पछो पुगीन पतरस कि आरू देख्या, आरू पतरस क पोरबु नी वो वात फोम आवी जो पोरबु क कयी होती, “आज सोनदारे कुकड़ा क वाषने देने छे पेहले तु तीन बार मारे छे मानने सी मना करीस।” <verse eid="LUK 22:61"/><verse number="62" style="v" sid="LUK 22:62"/>आरू वो बाहरता नीकवीन खुप रोड्या।<verse eid="LUK 22:62"/></para>
  <para style="s">ईशु क विजुत</para>
  <para style="r">(<ref loc="MAT 26:67-68">मत्ती 26:67-68</ref>; <ref loc="MRK 14:65">मरकुस 14:65</ref>)</para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63"/>जो माणुस ईशु क धरायो हुयो होतो वो उको ठट्टा मा उड़ावीन धुमाट्या लाग्या <verse eid="LUK 22:63"/><verse number="64" style="v" sid="LUK 22:64"/>आरू ओका डुवा ढाकीन ओका सी पुछ्या, “भविष्यवाणी करीन देखाड्या कि तुखे कुण मार्‍या छे!” <verse eid="LUK 22:64"/><verse number="65" style="v" sid="LUK 22:65"/>आरू त्या घोणा सी भी निंदा कि वात ओका विरोध मा कयी।<verse eid="LUK 22:65"/></para>
  <para style="s">डाहला पुजारा आरू शास्त्री क सामने ईशु</para>
  <para style="r">(<ref loc="MAT 26:59-66">मत्ती 26:59-66</ref>; <ref loc="MRK 14:55-64">मरकुस 14:55-64</ref>; <ref loc="JHN 18:19-24">यहुन्ना 18:19-24</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66"/>जव दाहाड़ा हुया तो मानसे क डाहडा, मुखी पुजारा आरू शास्त्री एखठा हुया आरू ईशु क आपसी महासभा मा लायो। <verse eid="LUK 22:66"/><verse number="67" style="v" sid="LUK 22:67"/>आरू पुछो, “यदि तु मसीहा छे तो हामु छे कय दे”</para>
  <para style="p" vid="LUK 22:67">त्यो उनछे कयो, “यदि हाव तुमू छे कहवो तो तुमू विश्वास नी करसे; <verse eid="LUK 22:67"/><verse number="68" style="v" sid="LUK 22:68"/>आरू यदि हाव सवाल पुछो तुमू तो जवाब नी देसे <verse eid="LUK 22:68"/><verse number="69" style="v" sid="LUK 22:69"/>पुन हिमी छे माणुस क पोर्‍य सर्व शक्तिमान यहोवा–भगवान क जेवड़े तरफ बठ्से।”<verse eid="LUK 22:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70"/>इना पर सब कयो, “ते काय तु यहोवा–भगवान क पोर्‍या छे?”</para>
  <para style="p" vid="LUK 22:70">ईशु उनछे कयो, “तुमू आप ही कयता होय की हाव छे।”<verse eid="LUK 22:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71"/>“तव त्या कयो, हिमी हामु गवा कि काय जरूरत छे; काहकि हामु आप ही ओका मुय छे सोमवी लेदा छे।”<verse eid="LUK 22:71"/></para>
  <chapter eid="LUK 22"/>
  <chapter number="23" style="c" sid="LUK 23"/>
  <para style="s">पिलातुस क सामने ईशु</para>
  <para style="r">(<ref loc="MAT 27:1-2">मत्ती 27:1-2</ref>; <ref loc="MAT 11-14">11–14</ref>; <ref loc="MRK 15:1-5">मरकुस 15:1-5</ref>; <ref loc="JHN 18:28-38">यहुन्ना 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1"/>तव सब सभा उठीन ईशु क पिलातुस क साथे ली गयी। <verse eid="LUK 23:1"/><verse number="2" style="v" sid="LUK 23:2"/>वो यो धरती उना पर दोष लागाड़ ने लाग्या: “हामु इनाक मानसे क भड़कावता, आरू कैसर<note caller="+" style="f"><char style="fr" closed="false">23:2 </char><char style="fq" closed="false">कैसर </char><char style="ft" closed="false">रोमन सम्राट</char></note> क फाळु आपने सी मना करता, आरू आपने आप क मसीह, एक राजा कयता हुया सोमव्या छे।”<verse eid="LUK 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3"/>पिलातुस ने ओका सी पुछ्या, “काय तु यहूदि यो क राजा छे?”</para>
  <para style="p" vid="LUK 23:3">त्यो उको जवाब दिया, “तु आप आपसुत् कय रया छे।”<verse eid="LUK 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4"/>तव पिलातुस ने मुखी पुजारा आरू गर्दी छे कयो, “हाव इनीये मानुस मा काही दोष नी देखता छे।”<verse eid="LUK 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 23:5"/>पर वो आरू भी यकीन छे कयनो लाग्या, “यो गलील छे लीन याहा तक, सब यहूदि या मा शिक्षा दे दीन मानसे क भड़कावता छे।”<verse eid="LUK 23:5"/></para>
  <para style="s">ईशु क हेरोदेस राजा न या मुकलनो</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6"/>यो सोमवीन पिलातुस ने पुछ्या, “काय यो मानुस गलीली छे?” <verse eid="LUK 23:6"/><verse number="7" style="v" sid="LUK 23:7"/>आरू यो जानीन की वो हेरोदेस की रीयासत क छे, उको हेरोदेस क साथे मुकली दीया, काहकि उन दाहाड़ा मा वो भी यरूशलेम मा हुता।<verse eid="LUK 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8"/>हेरोदेस ने ईशु क देख क घोणा ही खुश हुया, काहकि वो घोणा दाहाड़ा छे ओको देखने जुवता हुता; एरकरीन कि ओका विषय मा सोमवता हुता, आरू ओका सी काही चमत्कार देखने की आश राखता हुता। <verse eid="LUK 23:8"/><verse number="9" style="v" sid="LUK 23:9"/>वो ओका सी घोणा सी वात पुछता रया, पर त्यो ओको काय भी जवाब नी दीया। <verse eid="LUK 23:9"/><verse number="10" style="v" sid="LUK 23:10"/>मुखी पुजारा आरू शास्त्री उबा हुया उना पर वातड़ो दोष लागाड़ ता रया। <verse eid="LUK 23:10"/><verse number="11" style="v" sid="LUK 23:11"/>तव हेरोदेस ने आपने सिपायड़ा क साथे ओको विजुत करीन ठट्ठा मा उड़ाया आरू वारला छिंदरा पेराया उको पिलातुस क साथे मुकली दिदा। <verse eid="LUK 23:11"/><verse number="12" style="v" sid="LUK 23:12"/>तीनी दाहाड़ा पिलातुस आरू हरोदेस दोस्त होय गया; ओका पेहले वो एक–दिसरा क दुस्मन हुता।<verse eid="LUK 23:12"/></para>
  <para style="s">पिलातुस द्बारा ईशु क मृत्यु दण्ड</para>
  <para style="r">(<ref loc="MAT 27:15-26">मत्ती 27:15-26</ref>; <ref loc="MRK 15:6-15">मरकुस 15:6-15</ref>; <ref loc="JHN 18:39-19:16">यहुन्ना 18:39–19:16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13"/>पिलातुस ने मुखी पुजारा क आरू सरदार आरू मानसे क बुलायो <verse eid="LUK 23:13"/><verse number="14" style="v" sid="LUK 23:14"/>आरू उनछे कयो, “तुमू इनीये मानसे क भड़कावने वावा ठरावीन मारे साथे लाया होय, आरू देखो, हाव ने तुमरे सामने ओकी पुछताछ की, पर जिन वात क तुमू उना पर दोष लागाड़ ता होय उन वात क विषय मा हाव ने उको काय भी दोष नि देख्या छे; <verse eid="LUK 23:14"/><verse number="15" style="v" sid="LUK 23:15"/>नी हेरोदेस ने, काहकि त्यो उको हामरे साथे मुकली दीया छे: आरू देखो, त्यो ओसो काय नी कर्‍या की वो मृत्यु क दण्ड क योग्य ठेराया जाछे। <verse eid="LUK 23:15"/><verse number="16" style="v" sid="LUK 23:16"/>एरकरीन हाव फटका मारीन छुड़ दिदा छे।” <verse eid="LUK 23:16"/><verse number="17" style="v" sid="LUK 23:17"/><note caller="+" style="f"><char style="fr" closed="false">23:17 </char><char style="ft" closed="false">यो वचन पुराने शास्त्र मा मिवतो नी</char></note>पिलातुस पर्व क टेहाव ओको करता एक बन्दि क छुड़ने पर मजबुर हुता।<verse eid="LUK 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18"/>तव सब मिवीन आयडी उठ्या, “इनीये क मार नाखु, आरू हामरे करता बरअब्बा क छुड़ देवु!” <verse eid="LUK 23:18"/><verse number="19" style="v" sid="LUK 23:19"/>वो काही दंगाप्रसाद क कारण जो नगर मा हुया हुता, आरू हत्या क कारण जेल मा नाख दिया हुता।<verse eid="LUK 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20"/>पर पिलातुस ने ईशु क छुड़ने की मरजी छे मानसे क पछु समझाया, <verse eid="LUK 23:20"/><verse number="21" style="v" sid="LUK 23:21"/>पुन त्या लगातर आयड़ी कयो, “उको कुरूस पर चढ़ाय! कुरूस पर चढ़ाय!”<verse eid="LUK 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22"/>त्यो तीसरी बार उनछे कयो, “काय त्यो कुनसा गुणेहगार कर्‍या छे? हाव ने उको मृत्यु क योग्य काही वात नी देखी। एरकरीन हाव उको फटका मारीन छुड़ देता छे।”<verse eid="LUK 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23"/>पुन वो आयड़ी पछव पड़ गया कि वो क कुरूस पर चढ़ा जाय, आरू ओको आयड़ने सफल होया। <verse eid="LUK 23:23"/><verse number="24" style="v" sid="LUK 23:24"/>अळते पिलातुस ने हुकुम देदी कि ओकान विनती क लारे करता जाय। <verse eid="LUK 23:24"/><verse number="25" style="v" sid="LUK 23:25"/>त्यो उना मानुस क जो दंगे आरू हत्या क कारण जेल मा नाख दिया हुता उको वो मांगता हुता, ओको छुड़ दिया; आरू ईशु क उनकी मरजी क लारे ओको हात मा सौप दिया।<verse eid="LUK 23:25"/></para>
  <para style="s">ईशु क कुरूस पर चढ़ाया जाने</para>
  <para style="r">(<ref loc="MAT 27:32-44">मत्ती 27:32-44</ref>; <ref loc="MRK 15:21-32">मरकुस 15:21-32</ref>; <ref loc="JHN 19:17-27">यहुन्ना 19:17-27</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26"/>जव वो ईशु करता जाय रया हुता, तो त्या शमौन नाव क एक कुरेनी क जो शहर छे आय रया हुता, धरीन उना पर कुरूस लाद दिया कि उको ईशु क पछव ली चाल्या।<verse eid="LUK 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 23:27"/>मानसे की मोटी गर्दी ओका पछव चाल देदा आरू उको घोणा सी बायर भी होती जो ओका करता छाती ठुकता आरू विलाप करती होती। <verse eid="LUK 23:27"/><verse number="28" style="v" sid="LUK 23:28"/>ईशु उनकी आरू पुगीन कयो, “हे यरूशलेम क पोराय, मारे करता मा रडु; पुन आपने आरू आपने पोर्‍या क करता रडु। <verse eid="LUK 23:28"/><verse number="29" style="v" sid="LUK 23:29"/>काहकि वो दाहड़ा आवता छे, जिनहाव मानसे कयसे, ‘धन्य छे वो जो बांझ छे आरू वो कुख जो नी पोखड़ा आरू वो स्तन जिन्होने दूध नी पिवाड्या। <verse eid="LUK 23:29"/><verse number="30" style="v" sid="LUK 23:30"/><note caller="+" style="x"><char style="xo" closed="false">23:30 </char><char style="xt" closed="false"><ref loc="REV 6:16">प्रकाशितवाक्य 6:16</ref></char></note>उना टेहाव वो बयड़ा छे कयनो लागछे कि हामु पर पड़्या, आरू टेकड़ी छे कि हामु ढांप लेवु।’ <verse eid="LUK 23:30"/><verse number="31" style="v" sid="LUK 23:31"/>यदि जव वो नीवो झाड़का क साथे ओसो करता छे, तो सुखला क साथे काय काही नी कर्‍या जाछे?”<verse eid="LUK 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32"/>वो दिसरा दुय मानुस क भी जो गुणेगार हुता ओका घात करने क ली चाल्या। <verse eid="LUK 23:32"/><verse number="33" style="v" sid="LUK 23:33"/>जव वो उना धरतीम जिनाक खोपड़ी कयता छे पुच्चा, तो त्या वाँ उको आरू उन गुणेगार क भी, एक क जेवड़ा आरू दिसरा क बाई आरू कुरूस पर चढ़ाया। <verse eid="LUK 23:33"/><verse number="34" style="v" sid="LUK 23:34"/>तव ईशु कयो, “हे बास, इनुक माफ कर, काहकि यो जानता नी कि काय कर रया छे।”</para>
  <para style="p" vid="LUK 23:34">आरू त्या चिठ्ठया नाखीन ओका छिंदरा वाट लेदा। <verse eid="LUK 23:34"/><verse number="35" style="v" sid="LUK 23:35"/>मानसे उबा देख रया हुता, आरू यहूदि हकी भी ठठ्ठा कर करीन कयता हुता: “त्यो दीसरो क वाचाड्या यदि यो यहोवा–भगवान क मसीह छे, आरू ओको चुना होया सरदार सारखा छे, तो आपने आप क वाचाड़ लेय।”<verse eid="LUK 23:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 23:36"/>सिपायड़ा क साथे आवीन आरू सिरका देईन ओको थठ्ठा करीन कयता हुता, <verse eid="LUK 23:36"/><verse number="37" style="v" sid="LUK 23:37"/>“यदि तु यहूदियो क राजा छे, तो आपने आप क वाचाड़!”<verse eid="LUK 23:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38"/>आरू ओका ऊपर एक दोष पत्री भी लाग्यो हुता: “यो यहूदियो क राजा छे।”<verse eid="LUK 23:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39"/>जो गुणेगार वो लटकाय गया हुता, ओका छे एक ने ईशु नी वायकेड़ा उड़ावीन कयो, “काय तु मसीह छे नी? तो पछु आपने आप क आरू हामु वाचाड्य!”<verse eid="LUK 23:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40"/>इनीये पर दिसरे गुणेगार उको निंदा करीन कयो, “काय तु यहोवा–भगवान छे भी नी घाबराय? तु भी तो वो दण्ड भोग रयो छे, <verse eid="LUK 23:40"/><verse number="41" style="v" sid="LUK 23:41"/>हामु तो न्याय नुसार दण्ड भोग रया छे, काहकि हामु आपने काम क ठीक फवो देख रया छे; पर यो काही गलत काम नी कर्‍या।” <verse eid="LUK 23:41"/><verse number="42" style="v" sid="LUK 23:42"/>तव त्यो कयो, “हे ईशु, जव तु आपने राज्यधिकार मा आश, तो मारी याद राखजी।”<verse eid="LUK 23:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43"/>त्यो ओका सी कयो, “हाव तुखे छे सच कयता कि आज ही तु मारे साथे सुख मानसे मा होयस।”<verse eid="LUK 23:43"/></para>
  <para style="s">ईशु क मरन</para>
  <para style="r">(<ref loc="MAT 27:45-56">मत्ती 27:45-56</ref>; <ref loc="MRK 15:33-41">मरकुस 15:33-41</ref>; <ref loc="JHN 19:28-30">यहुन्ना 19:28-30</ref>)</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44"/>लग–भग सीरान बारा वाजे छे तीन वाजे तक सब धरती पर आंधारो होय गयो, <verse eid="LUK 23:44"/><verse number="45" style="v" sid="LUK 23:45"/>आरू सुर्‍या क विजावो जाता रया, आरू मंदिर क परदो वीच मा छे फाट गया, <verse eid="LUK 23:45"/><verse number="46" style="v" sid="LUK 23:46"/>आरू ईशु मोटा ओवाज छे आयड़ी कयो, “हे बास हाव आपसी आत्मा तारे हात मा सौपता छे।” आरू यो धरती मर गया।<verse eid="LUK 23:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47"/>शिपायक क सुबेदार जो काय हुता देखीन यहोवा–भगवान की बढ़ाई करी, आरू कयो, “छाचो यो मानुस न्यायी होतो।”<verse eid="LUK 23:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 23:48"/>आरू गर्दी जो यो देखने क एखठी हुयी होती, इनीये घटना क देखीन छाती ठुकीन हुयी पोछी पछु गयी। <verse eid="LUK 23:48"/><verse number="49" style="v" sid="LUK 23:49"/>पर ईशु क सब जान पेहचान वालो, आरू जो बायर गलील छे ओका पछव आवी होती, दूर उभी हुयी यो सब देख रयी होती।<verse eid="LUK 23:49"/></para>
  <para style="s">ईशु क गाड़ ़ा जाना</para>
  <para style="r">(<ref loc="MAT 27:57-61">मत्ती 27:57-61</ref>; <ref loc="MRK 15:42-47">मरकुस 15:42-47</ref>; <ref loc="JHN 19:38-42">यहुन्ना 19:38-42</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50"/>वा यूसुफ नाव जो यहूदियो क नगरमा आरिमतिया गाव क हुता, वो महासभा क एक सदस्य हुता जो वारलो आरू न्यायी पुरूष हुता <verse eid="LUK 23:50"/><verse number="51" style="v" sid="LUK 23:51"/>आरू तीनरा विचार आरू तीनरा इना कामम खुश नी हुता; आरू त्यो यहूदिन नगर अरिमतियाह क रयनेवावान आरू यहोवा–भगवान क राजन वाट देखनेवावु होतु। <verse eid="LUK 23:51"/><verse number="52" style="v" sid="LUK 23:52"/>चु पिलातुस क साथे जाईन ईशु क शव मांग्या; <verse eid="LUK 23:52"/><verse number="53" style="v" sid="LUK 23:53"/>तव त्यो वो शव क उतारीन मलमल की लुगड़ा मा लेपटीन, आरू एक बीड़ा मा राख्या, जो चट्टान मा खुंदीन हुयी होती; आरू उको काही कदी नी राख्या गया हुता। <verse eid="LUK 23:53"/><verse number="54" style="v" sid="LUK 23:54"/>चु तियार हुयने क दाहडो हतो, आरू विश्राम क दाहड़ो शुरू हुयने पर हुता।<verse eid="LUK 23:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55"/>उन बायर ने जो ईशु क साथे गलील छे आवी होती, वो यूसुफ क पोछव–पछव उना मोड़वाट्या क देख्या, आरू यो भी कि ओको शव काही रीति छे राख लेदा छे। <verse eid="LUK 23:55"/><verse number="56" style="v" sid="LUK 23:56"/>तव त्या पोछा पुगीन घर जाईन इत्र ओसली चीजन सारखो आरू मसालो तीयार कर्‍या;</para>
  <para style="p" vid="LUK 23:56">आरू विश्राम क दाहडो त्या हुकुम क लारे आराम कर्‍या।<verse eid="LUK 23:56"/></para>
  <chapter eid="LUK 23"/>
  <chapter number="24" style="c" sid="LUK 24"/>
  <para style="s">ईशु क जीवतो हुयनो</para>
  <para style="r">(<ref loc="MAT 28:1-10">मत्ती 28:1-10</ref>; <ref loc="MRK 16:1-8">मरकुस 16:1-8</ref>; <ref loc="JHN 20:1-10">यहुन्ना 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1"/>पुन हापतान क पेहले दाहड़ मोट भोर क वो उन सुगन्ध चीजन सारखो जो चाँ तीयार करी होती, लेय बीड़ा पर आवी। <verse eid="LUK 24:1"/><verse number="2" style="v" sid="LUK 24:2"/>त्या दगड़ा क जो मोड़वाट्या दरवाजा पर ढाकलो होतो उको लुड़काय हुया देख्या, <verse eid="LUK 24:2"/><verse number="3" style="v" sid="LUK 24:3"/>पुन चो माहीय जाईन पोरबु ईशु क धड़ नी जोड़यो। <verse eid="LUK 24:3"/><verse number="4" style="v" sid="LUK 24:4"/>जव वो इनीये वात छे भौचक्‍की होय रयी होती तो देख, दुय मानसे धोव्या झलकता लुगड़ा पेहरीन हुया ओको साथे आवी उबा हुया। <verse eid="LUK 24:4"/><verse number="5" style="v" sid="LUK 24:5"/>जव वो घाबराय गयी आरू धरती क तरफ मुन झुकाड़ी रयी। ते त्या मानसे ओका कयो, “तुमू जीवता क मरला हुया मा काय हेरती होय? <verse eid="LUK 24:5"/><verse number="6" style="v" sid="LUK 24:6"/><note caller="+" style="x"><char style="xo" closed="false">24:6 </char><char style="xt" closed="false"><ref loc="MAT 16:21">मत्ती 16:21</ref>; <ref loc="MAT 17:22">17:22</ref>,<ref loc="MAT 17:23">23</ref>; <ref loc="MAT 20:18">20:18</ref>,<ref loc="MAT 20:19">19</ref>; <ref loc="MRK 8:31">मरकुस 8:31</ref>; <ref loc="MRK 9:31">9:31</ref>; <ref loc="MRK 10:33">10:33</ref>,<ref loc="MRK 10:34">34</ref>; <ref loc="LUK 9:22">लूका 9:22</ref>; <ref loc="LUK 18:31-33">18:31-33</ref></char></note>वो या नी, पुन जीव उठ्यो छे। फोम करू कि त्यो गलील मा रयता हुया तुमू छे कयो हुता, <verse eid="LUK 24:6"/><verse number="7" style="v" sid="LUK 24:7"/>पाको छे कि मानुस क पोर्‍या हाव पापी क हात मा धराया जाय, आरू कुरूस पर चढ़ाया जाय, आरू तीसरे दाहड़े जीवीन उठ्यो।”<verse eid="LUK 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 24:8"/>तव ओकी वात उनको स्मरण आवी, <verse eid="LUK 24:8"/><verse number="9" style="v" sid="LUK 24:9"/>आरू मोड़वाट्याम रयन पछा आवीन त्या उन ग्यारा क प्रेरित, आरू दिसरा सब चेला क, यी सब वात कय सोमवाय। <verse eid="LUK 24:9"/><verse number="10" style="v" sid="LUK 24:10"/>जु प्रेरितन छे यी वात कयी, चा मरीयम मगदलीनी, आरू यहुन्ना, आरू याकूब क आश मरियम आरू ओको साथे दिसरा बायरा भी हता। <verse eid="LUK 24:10"/><verse number="11" style="v" sid="LUK 24:11"/>पुन ओकी वातन तीनुक काहानी छे जान पड़ी, आरू त्या ओका न विश्वास नी करी। <verse eid="LUK 24:11"/><verse number="12" style="v" sid="LUK 24:12"/>तव पतरस उठीन मोळवट्याम तरफ दौड़ी गयो, आरू जाईन देख्यु केवल छिंदरान पड़्या आरू वा भी काहय नी हुतो ओका सी भोंगलाय गयो आरू वापस आय लाग्यो।<verse eid="LUK 24:12"/></para>
  <para style="s">इम्माऊस क मार्ग पर चेला क साथे</para>
  <para style="r">(<ref loc="MRK 16:12-13">मरकुस 16:12-13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13"/>तीनी दाहड़े ओका छे दुय जना इम्माऊस नावको एक गाँव क जाय रयो हुतो, जो यरूशलेम छे काही ग्यारे किलो मीटर की दूरी पर हुता। <verse eid="LUK 24:13"/><verse number="14" style="v" sid="LUK 24:14"/>वो इन सब वात पर जो होयी होती, आपस मा वातचीत करता जाय रया हुता, <verse eid="LUK 24:14"/><verse number="15" style="v" sid="LUK 24:15"/>आरू जव वो आपस मा वातचीत आरू पूछताछ कर रया हुता, तो ईशु आप साथे आवीन ओको साथे होय लेदा। <verse eid="LUK 24:15"/><verse number="16" style="v" sid="LUK 24:16"/>पुन ओको डुवा ओसी बंद कर देदी गयी होती कि ओको पेहचान नी सक्या। <verse eid="LUK 24:16"/><verse number="17" style="v" sid="LUK 24:17"/>ईशु उन छे पुछ्या, “यो काय वात छे, जो तुमू चाली आपस मा करता होय?”</para>
  <para style="p" vid="LUK 24:17">सससवो नराज छे उबा रया गया। <verse eid="LUK 24:17"/><verse number="18" style="v" sid="LUK 24:18"/>यो सोमवीन उनमा छे क्लियोपास नाव क एक मानुस कयो, “काय तु यरूशलेम मा एखलूत परदेशी छे, जो नी जानता कि इन दाहड़ा मा ओका काय हुयो छे?”<verse eid="LUK 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19"/>त्यो उनछे पुछ्या, “कुन नी वात?” त्या ओको छे कयो, ईशु नासरत क विषय मा जो यहोवा–भगवान आरू सब मानसे क निकट काम आरू वचन मा सामर्थी भविष्यवक्ता हुता, <verse eid="LUK 24:19"/><verse number="20" style="v" sid="LUK 24:20"/>मुखी पुजारा आरू हामरे सरदारने ओको धराया दिया कि ओको पर मरन की हुकुम देदी जाय; आरू ओको कुरूस पर चढ़ाया। <verse eid="LUK 24:20"/><verse number="21" style="v" sid="LUK 24:21"/>पुन हामुक आशा हती कि यो इस्राएल क छुटकारो देसे। “हे परबु काय तु इने टेहाव इस्राएल न राज क पछो बोठाड़ीस?” <verse eid="LUK 24:21"/><verse number="22" style="v" sid="LUK 24:22"/>आरू हामु मा छे कयी बायर ने भी हामु घबरायीन मा नाख दिया छे, जो भोर क मोळवट्याम पर गयी होती; <verse eid="LUK 24:22"/><verse number="23" style="v" sid="LUK 24:23"/>आरू जव ओका शव नी देख्या तो यो कयती होयी आवी कि हामु सोरगदूत क दर्शन देख्या, जा कया कि वो जीवतो छे। <verse eid="LUK 24:23"/><verse number="24" style="v" sid="LUK 24:24"/>तव हामरे साथी मा छे कयी एक मोळवट्याम पर गयी, आरू जोसो बायर ने कयो कि हुता वोसो ही देख्या; पुन उनको नी देखछे।<verse eid="LUK 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25"/>तव ईशु उनछे कयो, “हे निर्बुध्दियो आरू भविष्यवक्ता की सब वात पर विश्वास करने मा छे कमजोर होय!” <verse eid="LUK 24:25"/><verse number="26" style="v" sid="LUK 24:26"/>काय जरूरी नी हुता कि मसीह यो दुःख झेलीयो आपसी महिमा भरायने करसे? <verse eid="LUK 24:26"/><verse number="27" style="v" sid="LUK 24:27"/>तव त्यो मूसा छे आरू सब भविष्यवक्ता छे शुरू करीन सब पवित्रशास्त्र मा छे आपने विषय मा लिखी वात क मतलब, तीनुक समझाय दिया।<verse eid="LUK 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28"/>ओतरा मा वो उना गाँव क साथे पुच्य वा वो जाय रया हुता, आरू ओका ढंग छे ओसो जान पड़्या कि वो ओगोव जाने जुवता छे। <verse eid="LUK 24:28"/><verse number="29" style="v" sid="LUK 24:29"/>पुन त्या यो कयनो उको रावन्या करी, “हामरे साथे रया काहकि शांत होय लाग्यो छे आरू दाहड़ो हिमी घोणा ढल गया छे।” तव वो ओको साथे रयने क करता माहीय गया। <verse eid="LUK 24:29"/><verse number="30" style="v" sid="LUK 24:30"/>जव वो साथे भोजन करने बठ्या, तो त्यो रोटा लीन यहोवा–भगवान क धन्यवाद कर्‍या आरू उको तुड़ीन उनको देने लाग्या। <verse eid="LUK 24:30"/><verse number="31" style="v" sid="LUK 24:31"/>तव ओको डुवा उघड़ी गया; आरू त्या उको पेहचान लेदा, “आरू वो ओको डुवा छे विनदेखियो होय गया।” <verse eid="LUK 24:31"/><verse number="32" style="v" sid="LUK 24:32"/>त्या आपस मा कयो, “जव वो मार्ग मा हामु छे वात करता हुता आरू चुखलो शास्त्र क मतलब हामु समझता हुता, तो काय हामरे मन मा मरजी नी पैदा हुयी?”<verse eid="LUK 24:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 24:33"/>वो तीनी घड़ी उठीन यरूशलेम क पछु गया, आरू उन ग्यारे आरू ओको साथी क एखठा देख्या। <verse eid="LUK 24:33"/><verse number="34" style="v" sid="LUK 24:34"/>वो कयता हुता, “पोरबु सचमुच जीव उठ्यो छे, आरू शमौन पतरस क देखाय दिया छे!”<verse eid="LUK 24:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 24:35"/>तव उन दुय ने मार्ग की वात तीनुक देखाड देदी आरू यो भी कि त्या उको रोटा तुडीन टेहाव पोरबु क कसो पुछने।<verse eid="LUK 24:35"/></para>
  <para style="s">ईशु आपने चेला क देखाय देने</para>
  <para style="r">(<ref loc="MAT 28:16-20">मत्ती 28:16-20</ref>; <ref loc="MRK 16:14-18">मरकुस 16:14-18</ref>; <ref loc="JHN 20:19-23">यहुन्ना 20:19-23</ref>; <ref loc="ACT 1:6-8">प्रेरितन 1:6-8</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36"/>वो यो वात कय रया हुता कि चु खुद ओको वीचमा आईन उबा हुया, आरू ओका कयो, “तुमूक शांती जोड़े।”<verse eid="LUK 24:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37"/>पुन वो घाबराय गयो आरू बीह गया, आरू समझे की हामु एक भुत क देख रया छे। <verse eid="LUK 24:37"/><verse number="38" style="v" sid="LUK 24:38"/>ईशु उनछे कयो, “काय घबरायता होय? आरू तुमरे मन मा काय संदेह उठे छे? <verse eid="LUK 24:38"/><verse number="39" style="v" sid="LUK 24:39"/>मारो हात आरू मारो पाय क देखो, कि हाव चो छे। मखे धरीन देख, काहकि आत्मा क हड्डी मास नी हुयसे जोसो मखे मा देखता होय।”<verse eid="LUK 24:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 24:40"/>यो धरती त्यो तीनुक आपने हात पाय देखाड्या। <verse eid="LUK 24:40"/><verse number="41" style="v" sid="LUK 24:41"/>जव खुशी क मारे उनको हिमी भी विश्वास नी हुयी, आरू घबरायीन करता हुता, तो त्यो उनछे पुछ्या, “काय याहा तुमरे साथे काय भोजन?” <verse eid="LUK 24:41"/><verse number="42" style="v" sid="LUK 24:42"/>त्या ओको भुनी हुयी मासा क तुकड़ा दिदा। <verse eid="LUK 24:42"/><verse number="43" style="v" sid="LUK 24:43"/>त्यो लीन ओको सामने खाया।<verse eid="LUK 24:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44"/>पछु त्यो उनछे कयो, “यो मारी वो वात छे, जो हाव ने तुमरे साथे रयता हुया तुमू छे कयी होती कि पाको छे कि जितनी वात मूसा की व्यवस्था आरू भविष्यव्दाक्ता आरू भजन सहिंता की किताब मा मारे विषय मा लिखी छे, सब पूरी होय।”<verse eid="LUK 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45"/>तव ओको ने पवित्रशास्त्र जानने क करता उनकी बुध्दी खुल देदी, <verse eid="LUK 24:45"/><verse number="46" style="v" sid="LUK 24:46"/>आरू त्यो कयो, “यो लिख्या छे कि मसीह दुःख झेलसे, आरू तीसरे दाहड़े मरलो हुयो मा रयन जीवीन उठसे, <verse eid="LUK 24:46"/><verse number="47" style="v" sid="LUK 24:47"/>आरू यरूशलेम रयन ते सब भाषा क मानसे मा फिराव कर्‍या आरू यहोवा–भगवान ओकान पाप की माफ करसे ओसो खबर करो, तीना क नाव छे कर्‍या जाछे। <verse eid="LUK 24:47"/><verse number="48" style="v" sid="LUK 24:48"/>तुमू इन सब वात क गवा होय। <verse eid="LUK 24:48"/><verse number="49" style="v" sid="LUK 24:49"/><note caller="+" style="x"><char style="xo" closed="false">24:49 </char><char style="xt" closed="false"><ref loc="ACT 1:4">प्रेरितन 1:4</ref></char></note>आरू जो इनाम देने क प्रतिज्ञा मारो बास छे, हाव ओको तुमरे पर उतारीस आरू जव तक सोरग छे शक्ति नी देख्या, तव तक तुमू इनी नगर मा उबा रवजु।”<verse eid="LUK 24:49"/></para>
  <para style="s">ईशु क सोरग मा जानो</para>
  <para style="r">(<ref loc="MRK 16:19-20">मरकुस 16:19-20</ref>; <ref loc="ACT 1:9-11">प्रेरितन 1:9-11</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">24:50 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 1:9-11">प्रेरितन 1:9-11</ref>
      </char>
    </note>तव ईशु तीनुक बैतनिया गाँव तक बाहरता ली गया जहा जैतुन क बयड़ा हुता, आरू आपने हात उठाड़ी तीनुक सय बरकत दिदो; <verse eid="LUK 24:50"/><verse number="51" style="v" sid="LUK 24:51"/>आरू ईशु ओका सी वात करने क बाद सोरग पर उठाय लेदो, आरू यहोवा–भगवान क जेवड़े तरफ बठ् गयो। <verse eid="LUK 24:51"/><verse number="52" style="v" sid="LUK 24:52"/>तव वो ओको दण्डवत करीन मोट खुशी छे यरूशलेम क पोछा पुगीयो गया; <verse eid="LUK 24:52"/><verse number="53" style="v" sid="LUK 24:53"/>आरू वो लगातार मंदिर मा हजुर हईन यहोवा–भगवान की बढ़ाई कर्‍या करता हुता।<verse eid="LUK 24:53"/></para>
  <chapter eid="LUK 24"/>
</usx>
