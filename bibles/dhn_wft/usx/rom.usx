<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ROM" style="id">– Dhankavi</book>
  <para style="h">रोमियो</para>
  <para style="toc3">रोमियो</para>
  <para style="toc2">रोमियो</para>
  <para style="toc1">रोमियो क नाम पौलुसन पत्री</para>
  <para style="mt2">रोमियो को पौलुस की पत्री</para>
  <para style="mt1">रोमियो क नाम पौलुसन पत्री</para>
  <para style="imt">परिचय</para>
  <para style="ip">रोमियोन पत्री अंदाज प्रेरित पौलुस 54-58 साल क विच मा ईशु मसीह जन्मन पछल लिखलु हतु। पौलुस हिमी तक रोम पुग्यु हतु, तेर करता चु यो पत्री रोम वाला भुरसा वाळा लोगहन मुकल्यु हतु। यहुदि आरू गैरयहुदी दुयन करता कुरन्थियो नगर मा रईन लिखलु हतु, जा चु तीनी टेम मा रयतु हतु। पौलुस लिखलु काहकि सब देश <char style="xt"><ref loc="ROM 16:26">16:26</ref></char> पर भुरसु आरू पालन कर सके।</para>
  <para style="ip">रोमियो क पत्री सब जागे सब टेमन भुरस्यान करता खास पत्री छे, काहकि साफ सुत्र वारलो समजाडलो छे कि आपु ईशु मसीहन सुटकारान बाराम कय सकता छे। पौलुस ईशु मसीहन वारली खबर जुन्नला नियम साथे जुड़लो छे। कितरा जानकारण मान्नो से काय पत्री मा गीत <char style="xt"><ref loc="ROM 1:16">1:16</ref></char> से जु कये, वारली खबर सोमवावने काय लाय नी होय, “काहकि यो सबन सुटकारान करता यहोवा भगवानन ताकद छे, चो माने” पेहल यहुदिन करता पछल गैरयहुदीन करता। रोमियोन पेहली पत्री<char style="xt"><ref loc="ROM 1:12">1:12</ref> </char> दिसरो भाग <char style="xt"><ref loc="ROM 13:14">13:14</ref></char> भाग मा विश्वासी जीवनन करता बैस कयलो छे।</para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. पौलुस खास करीन तीनान पेहचान आपीन तीनान पत्रीन सुरवात करीन कयतु कि चु यो पत्री कुनीक लिखसे। <char style="ior"><ref loc="ROM 1:1-15">1:1-15</ref></char></para>
  <para style="io1">2. तेर पछव चु ईशु मसीह बाराम देखाड़ीन लोगहन जातीन दशा आरू सुटकारान बाराम लिखे। <char style="ior"><ref loc="ROM 1:16-11:36">1:16–11:36</ref></char></para>
  <para style="io1">3. तेर पछव पौलुस विश्वासी जीवनन करता सिख आपलु से। <char style="ior"><ref loc="ROM 12:1-15:13">12:1–15:13</ref></char></para>
  <para style="io1">4. चु रोम वाळान मंडळी न विश्वासी लोगहन धन्यवाद देनो आरू वात खतम करनो। <char style="ior"><ref loc="ROM 16">16</ref></char></para>
  <chapter number="1" style="c" sid="ROM 1"/>
  <para style="s">नमस्कार</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1"/>पौलुसन तरफ छे जु ईशु मसीहन दास छे, आरू जिनाक प्रेरित हुयने करता बुलाया हुता, आरू यहोवा–भगवानन काजे ओको खुश खबर करता अलग कर्‍या गया छे। <verse eid="ROM 1:1"/><verse number="2" style="v" sid="ROM 1:2"/>जिनान चु पेहले सी कहवलो आपसा भविष्यवक्ता द्वारा चुखलो शास्त्र मा। <verse eid="ROM 1:2"/><verse number="3" style="v" sid="ROM 1:3"/>चाँ ओको पोर्‍याक हामरा पोरबु ईशु मसीहन विषयमा उजन्तो करली होती; त्यो शरीर क भाव से ते दाऊदन अवळियाद छे पैदा हुयो। <verse eid="ROM 1:3"/><verse number="4" style="v" sid="ROM 1:4"/>आरू चुखलोता आत्मान भाव छे मरलाम रईन जीव उठनेन कारण शक्ति साथे यहोवा–भगवानन पोर्‍य उबो छे, चु ईशु मसीह आमरू पोरबु छे। <verse eid="ROM 1:4"/><verse number="5" style="v" sid="ROM 1:5"/>उको द्वारा हामुक फोकटन दया आरू प्रेरिताई मीवी कि उका नामन कारण सुब जातीयान मानसो काजे विश्वास करीन ओको द्बारा यहोवा–भगवान गैरयहुदी ओको नाव पर विश्वास करे आरू हुकुम करे। <verse eid="ROM 1:5"/><verse number="6" style="v" sid="ROM 1:6"/>जिनामा तुमूक भी सामील होय जाऊ जिनामा ईशु मसीहन होयनेन करता बुलावला गया छे।<verse eid="ROM 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7"/>तीन ओका सबन नाव जो रोम मा यहोवा–भगवानन मोंगावु रईन आरू चुखलो करनेन करता बुलावला छे: आमरू बास यहोवा–भगवान आरू पोरबु ईशु मसीह तरफ छे फोकटन दया आरू शांती जुड़ती रोवे।<verse eid="ROM 1:7"/></para>
  <para style="s">धन्यवादन प्रार्थना</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8"/>पेहल मा हाव सबन करीन ईशु मसीहन द्वारा आपसो यहोवा–भगवानन धन्यवाद करो, काहकि तुमरा विश्वासन चर्चा सब जगमा चाल रयी छे। <verse eid="ROM 1:8"/><verse number="9" style="v" sid="ROM 1:9"/>यहोवा–भगवान जेरी सेवा मा आपसी आत्मा छे उका पोर्‍याक काजे खुश खबर विषय मा करतु छे, चु मार गवाय छे कि हाव तुमूक कसु करीन एकदम फोम कर रयु छे, <verse eid="ROM 1:9"/><verse number="10" style="v" sid="ROM 1:10"/>आरू नित्य आपसी प्रार्थना मा विनती करतु छे, कि काहनी रीति रईन हिमी भी तुमरे जु आवनेन मारू रस्तु खुल्लु छे। <verse eid="ROM 1:10"/><verse number="11" style="v" sid="ROM 1:11"/>काहकि हाव तुखे मिवनेन मरजी कर रयु छे, कि हाव तुमूक काजे एकदुक आत्मिक वरदान आपो तिनान करता तुमूक एक जागे रवु; <verse eid="ROM 1:11"/><verse number="12" style="v" sid="ROM 1:12"/>मतलब यो कि हाव तुमरे विच मा रईन तुमरे साथ चु विश्वासन द्वारा जो मारमा आरू तुमूक मा छे, एक दिसराक हिम्मत जड़से। <verse eid="ROM 1:12"/><verse number="13" style="v" sid="ROM 1:13"/><note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="ACT 19:21">प्रेरितन 19:21</ref></char></note>आरू हे भाईस्यो, हाव नी चाहतु कि तु इनाक रईन गैरयहुदी रया कि हाव ताव–ताव तार जु आवने चाहे, कि जोसो मखे बाहर जाती मा भुरसान फव जुड़यो, तोसोज तुमूक मा भी जुड़यो, पुन मखे हिमी तक रूकलो हतो। <verse eid="ROM 1:13"/><verse number="14" style="v" sid="ROM 1:14"/>हाव सब मानसन कर्जदार छे, यूनानीयो आरू गैर यूनानी, आरू बुध्दिमानोन आरू निर्बुध्दियोन कर्जदार छे। <verse eid="ROM 1:14"/><verse number="15" style="v" sid="ROM 1:15"/>अतरान करीन हाव तुमूक भी चाँ रोम मा रोवता छे, खुश खबर सोंभावने भरसक तयार छे।<verse eid="ROM 1:15"/></para>
  <para style="s">खुश खबर शक्ति</para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">1:16 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 8:38">मरकुस 8:38</ref>
      </char>
    </note>काहकि हाव खुश खबर छे नी आवे लाज, इनान करीन कि त्यो हर एक विश्वास करनेवालान करता, पेहल ते यहूदि मग यूनानीन करीन, उध्दारन निमित्त यहोवा–भगवानन शक्ति छे। <verse eid="ROM 1:16"/><verse number="17" style="v" sid="ROM 1:17"/>काहकि खुश खबर ओसो प्रकट करता छे कि यहोवा–भगवान मानसो काजे आपने सारखु बनावतु छे, चु पेहल रईन शेवाट तक भुरसा पर छे, जोसो शास्त्र मा लिखलो छे। “जु न्यायी मानुस छे चु भुरसा पर जीवतु रवसे।”<verse eid="ROM 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18"/>यहोवा–भगवान न रीस त्या लोगहन क सब अभक्ती आरू अन्याय पर सोरग पर से हुयसे, जो सत्य क छाचाय क दाबीब राखसे। <verse eid="ROM 1:18"/><verse number="19" style="v" sid="ROM 1:19"/>एरकरीन कि यहोवा–भगवानन विषय क ज्ञान ओको मन मा प्रकट होतलु छे, काहकि यहोवा–भगवान तिनु पर प्रकट करलो छे। <verse eid="ROM 1:19"/><verse number="20" style="v" sid="ROM 1:20"/>ओकान विनदेखियो गुण, मतलब उका सनातन शक्ति आरू यहोवा–भगवानत्व, जगन सृष्टिन टेहाव छे उका कमों द्वारा देखनेम आवतला छे, यो तक कि त्यो अमरकाय छे। <verse eid="ROM 1:20"/><verse number="21" style="v" sid="ROM 1:21"/><note caller="+" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="EPH 4:17">इफिसियो 4:17</ref>,<ref loc="EPH 4:18">18</ref></char></note>एर कारण कि यहोवा–भगवान जावनेन पर भी त्या यहोवा–भगवानन योग्य बढ़ाई आरू धन्यवाद नि कर्‍या, पुन व्यर्थ वात विचार करने लाग्या, यो तक कि ओकान निर्बुध्दि मनमा आंधारो होय गयो। <verse eid="ROM 1:21"/><verse number="22" style="v" sid="ROM 1:22"/>चाँ आपने आपसु बुध्दिमान सोमजीन मुर्ख बन गया, <verse eid="ROM 1:22"/><verse number="23" style="v" sid="ROM 1:23"/>आरू अमरकाया यहोवा–भगवानन महिम नाशवान मानुस, आरू चिल्ला, आरू चार पायवाला, घिसढ़ायने वाला जतुन मुरतीन समानता मा चाँ बदली देदो।<verse eid="ROM 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24"/>एर कारण यहोवा–भगवान ने तीनू मनन लालोच न लारे विटळता करीन सुड़ देदु, कारण चाँ आपसु मा ओका शरीरन विजुत करू। <verse eid="ROM 1:24"/><verse number="25" style="v" sid="ROM 1:25"/>काहकि चु यहोवा–भगवानन सच्चाई काजे बदलीन झूठ बनाव देदा, आरू बनावली वस्तुन भक्ती आरू सेवा कर्‍या, नी कि तीनु बनावनेवाला क जु सदा धन्य छे। आमेन।<verse eid="ROM 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26"/>एरकरीन यहोवा–भगवान तीनुक नीच इच्छान वश मा सुड़ देदु; या तक कि तीनुन बाई लोगहन भी स्वभाविक व्यवहार तीनुछे जो स्वभावन विरोध छे, बदली देदु। <verse eid="ROM 1:26"/><verse number="27" style="v" sid="ROM 1:27"/>तोसाच मानसे भी बाई लोगहन साथे स्वभाविक व्यवहार छुड़ीन आपसेमा कामातुर होईन जलने लाग्या, आरू मानसे भी मानसो साथे लाज आवे ओसो काम करीन आपसा भ्रमन वारलो फव देख्यु।<verse eid="ROM 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28"/>आरू जेतार तिनुक यहोवा–भगवानो काजे वोखने नी चाहे, एरकरीन यहोवा–भगवान भी तिनुक काजे तिनरा निकम्मा मन पर छुड़ देदु कि चाँ गलत काम करने लाग्या जा तिनुक नी करनो जुवे। <verse eid="ROM 1:28"/><verse number="29" style="v" sid="ROM 1:29"/>चाँ सब भाति–भातिन अन्याय, आरू द्दष्टता, आरू लालुच, आरू भेद–भाव मा भर गया; आरू डाह, आरू हत्या, आरू झगड़ा, आरू छल, आरू किचवन छे भरपुर होय गयो, आरू चुगल्यु, <verse eid="ROM 1:29"/><verse number="30" style="v" sid="ROM 1:30"/>यहोवा–भगवान निंदा करनेवावा, आरू एक दिसरान बुराई बदनाम करनेवाला, मुजा मारनीया, डाहवाळा, कुमनीयो, बुराई करनेन करता काहय रस्ता देखावनेवावा, आरू आश–बासन वात नी माननारा, <verse eid="ROM 1:30"/><verse number="31" style="v" sid="ROM 1:31"/>उल्टा विचार, निर्दयी, आपसी आपली जबान तुवड़ेवावा आरू एक दिसरा पर द्या नी देखावनेवावा, आरू एक दिसरान करता विचार नी करनो। <verse eid="ROM 1:31"/><verse number="32" style="v" sid="ROM 1:32"/>चाँ ते जानता छे, यहोवा–भगवानन यो नियम काय कयतु छे, जा मानसे इना रस्ता पर चालता छे, चाँ मरनेन दण्डन योग्य छे, तीभी ने सिरप चाँ मानसे सच्चा काम करनेवाला काजे मदत करता छे।<verse eid="ROM 1:32"/></para>
  <chapter eid="ROM 1"/>
  <chapter number="2" style="c" sid="ROM 2"/>
  <para style="s">यहोवा–भगवानन न्याय</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">2:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:1">मत्ती 7:1</ref>; <ref loc="LUK 6:37">लूका 6:37</ref></char>
    </note>हे दोष लगावनेवावा, तु कोय काँ नी होय, तु निरूत्तर छे; काहकि जिनी वातमा तु दिसरा पर दोष लागाड़ छे, तिनी वातम हाव आपने आप काजे भी दोषी ठरावतु छे, अतरान करीन कि तु जु दोष लागाड़ छे खुद चु चो काम करतलु छे। <verse eid="ROM 2:1"/><verse number="2" style="v" sid="ROM 2:2"/>आरू हामु जानता छे कि ओसला–ओसला काम करनेवावा पर यहोवा–भगवान तरफ छे सच्चाईन न्याय करता छे। <verse eid="ROM 2:2"/><verse number="3" style="v" sid="ROM 2:3"/>हे मानव, तु जो ओसला–ओसला काम करनेवावा पर दोष लागाड़ छे, आरू चु खुद चो काम करतु छे; काँ यो समझे छे कि तु यहोवा–भगवानन न्याय रईन बच जाछे? <verse eid="ROM 2:3"/><verse number="4" style="v" sid="ROM 2:4"/>काय तु ओको किरपा, आरू सहनशीलता, आरू धीरजरूपी धन क तुच्छ जानतु छे? आरू काहय यो नी समझता कि यहोवा–भगवान की भलाई तारो मन फिराव करने काजे सिकाड़ती छे? <verse eid="ROM 2:4"/><verse number="5" style="v" sid="ROM 2:5"/>पुन तु आपसी कोठोरता आरू हठीला मनन कारन ओको रीसन दाहड़ान करता, जिनामा यहोवा–भगवानन सच्चु न्याय प्रकट होयसे, आपने उपर दण्ड लाय रयु छे। <verse eid="ROM 2:5"/><verse number="6" style="v" sid="ROM 2:6"/>यहोवा–भगवान आपो सब काजे कामोन पर फव आपसे। <verse eid="ROM 2:6"/><verse number="7" style="v" sid="ROM 2:7"/>जु मानुस वारला काम मा स्थिर रोवीन, महिमा आरू विजुत करसे तिनुक यहोवा–भगवान अमरकाय जीवन आपसे; <verse eid="ROM 2:7"/><verse number="8" style="v" sid="ROM 2:8"/>पुन जा मानसे स्वार्थी छे आरू सच्चाई काजे नाकार करता छे, ओसा मानसे अन्याय काजे मानता छे, तिनुक पर यहोवा–भगवान आपनु गुस्सु आरू रीस करसे। <verse eid="ROM 2:8"/><verse number="9" style="v" sid="ROM 2:9"/>आरू पीड़ा आरू संकट हर एक मानसन जीव पर बुराई करे आवसे, पेहल यहूदि पर बाद मा यूनानी पर; <verse eid="ROM 2:9"/><verse number="10" style="v" sid="ROM 2:10"/>पुन यहोवा–भगवान हर एक काजे जा वारला काम करता छे, तिनुक महिमा, विजुत, शांती आरू भला करता छे, पेहल यहूदि बाद मा यूनानी पर; <verse eid="ROM 2:10"/><verse number="11" style="v" sid="ROM 2:11"/>काहकि यहोवा–भगवान भेदभाव नी करता सबन न्याय करतु छे। <verse eid="ROM 2:11"/><verse number="12" style="v" sid="ROM 2:12"/>गैरयहुदी न जु मूसान नियम नी होय, आरू हेके पापन न्याय भी बिना व्यवस्थान होय जाछे; यहूदि यान जु मूसान नियम छे, आरू हेकेन पापन न्याय नियमन अनसारे होयछे; <verse eid="ROM 2:12"/><verse number="13" style="v" sid="ROM 2:13"/>काहकि यहोवा–भगवानन या व्यवस्थाक सोंबावनेवाला न्यायी नी, पुन व्यवस्था पर चालनेवाला न्यायी ठहरावला जाछे। <verse eid="ROM 2:13"/><verse number="14" style="v" sid="ROM 2:14"/>पछु जव गैरयहुदी मानसे तीनरे जु व्यवस्था नी छे, स्वभाव पर व्यवस्थान वात पर चालता छे, ते मूसान व्यवस्था ओकान जु नी होय तरी भी त्या आपनु करता खुद मा व्यवस्था छे। <verse eid="ROM 2:14"/><verse number="15" style="v" sid="ROM 2:15"/>ओकान चाल–चलन देखाड़ता छे, कि व्यवस्था ओको दिल मा लिखली छे, आरू ओकान विचार भी कयता छे कि सही छे, आरू इनाक लिन ओकान मनन विचार निर्दुष ठरतु छे। <verse eid="ROM 2:15"/><verse number="16" style="v" sid="ROM 2:16"/>जिन दाहाड़े यहोवा–भगवान मारा खुश खबर लारे ईशु मसीह क द्वारा माणसन सातायलो विचारन न्याय करसे। <verse eid="ROM 2:16"/><verse number="17" style="v" sid="ROM 2:17"/>यदि तु आपसा काजे यहूदि कयतु छे, आरू व्यवस्था पर भरसु राखतु छे, आरू यहोवा–भगवानन विषयमा डाहळाय करतु छे, <verse eid="ROM 2:17"/><verse number="18" style="v" sid="ROM 2:18"/>आरू तुखे मालुम छे यहोवा–भगवान तुखे काय करवानो चाहतु छे, आरू काहली वात वारली छे, आरू वारली वात तु नियम शास्त्रमा रईन सिखलु छे; <verse eid="ROM 2:18"/><verse number="19" style="v" sid="ROM 2:19"/>आरू आपने आपसु पर भरसु राखतु छे, कि हाव आंधवान अगळवाण्यु, आरू आंधारलाम पौड़ान विजावो छव। <verse eid="ROM 2:19"/><verse number="20" style="v" sid="ROM 2:20"/>मुर्ख काजे हुकुम देनारू, आरू साधा–बुवान मानसन मास्तर छे, आरू तु पक्‍क छे कि जो नियम शास्त्र तार जु छे, ओकामा पुरी सच्चाई आरू ज्ञानन समायलु छे। <verse eid="ROM 2:20"/><verse number="21" style="v" sid="ROM 2:21"/>मतलब जो तु जो दिसरा काजे सिकाड़े छे, आपने आपसु नी सिकाड़े? काँ तु जु चुरी करनेन शिक्षा आपे छे, चु आपसु खुद चुरी करतु छे? <verse eid="ROM 2:21"/><verse number="22" style="v" sid="ROM 2:22"/>तु जो कयतु छे, “व्यभिचार नी करनो” काय आपसु व्यभिचार करतु छे? तु जु मरला काजे नफरत करतु छे, काय तुमूक मंदिर काजे लुटता छे? <verse eid="ROM 2:22"/><verse number="23" style="v" sid="ROM 2:23"/>तु जु व्यवस्था क विषय मा डाहळाय करतु छे, काय व्यवस्था नी मानीन, यहोवा–भगवानन विजुत करतु छे? <verse eid="ROM 2:23"/><verse number="24" style="v" sid="ROM 2:24"/>“काहकि तुमरे कारण गैरयहुदी मा यहोवा–भगवानन नावन निन्दा करता छे” तोसो शास्त्र मा लिखलो भी छे।<verse eid="ROM 2:24"/></para>
  <para style="s">खतनान फायदु नी हुयो</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25"/>यदि तु व्यवस्था पर चाल छे, ते खतना रईन भी फायदु छे, पुन तु व्यवस्था काजे नी माने, ते तुखे खतना बिन खतनान दशा ठहरावसे। <verse eid="ROM 2:25"/><verse number="26" style="v" sid="ROM 2:26"/>आरू गैरयहुदी जिनान खतना नी हुयो छे, पछा भी नियम पालन करता छे, ते काय हेकान खतना हुयने पर भी खतना नी गिनियो जाय? <verse eid="ROM 2:26"/><verse number="27" style="v" sid="ROM 2:27"/>आरू जो यहूदि क आरू गैरयहुदियोंन द्वारे गुणेगार बनायों जाछे जी भी तुमरे जुळ लिखला नियम आरू चामड़ी काटायली छे, बाकुन गैरयहुदी मानसे नियमन पाळन करे जिनाक चामड़ो नी काटयलों होय। <verse eid="ROM 2:27"/><verse number="28" style="v" sid="ROM 2:28"/>एक सच यहूदि कुन छे, जिनाक सचाकोर चामड़ो काटयलो छे चौ यहूदि जिनाक चामड़ो बाहरो काटायलो छे, सच्च यहूदि यो नी होय जो सचं चामड़ो काटयलो बाहरा रूप मा लेदला छे। <verse eid="ROM 2:28"/><verse number="29" style="v" sid="ROM 2:29"/>सच यहूदि चाँ छे जो मन मा छे; आरू खतना चो छे जु दिल क आरू आत्मा मा छे नी कि लेखक क; जिना काळजान पर चामड़ी काटायली छे जो माहय छे यहूदि है जिना काळजा छे चामड़ी काटयलो छे आरू यो यहोवा–भगवानन काम छे नी कि लिखला नियमन! असा मानसे यहोवा–भगवानन तरफ छे वारू कहवाये छे। नी की मानसोन तरफ छे।<verse eid="ROM 2:29"/></para>
  <chapter eid="ROM 2"/>
  <chapter number="3" style="c" sid="ROM 3"/>
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1"/>गैरयहुदी न सामने तुमरा यहूदि न काय लाभ छे, तुमूक आरू तुमरा खतनान काय लाभ? <verse eid="ROM 3:1"/><verse number="2" style="v" sid="ROM 3:2"/>वार बातन वारू काही लाभ छे, पेहल ते यो कि यहोवा–भगवानन वचन ओको यहूदि काजे सोपला गया। <verse eid="ROM 3:2"/><verse number="3" style="v" sid="ROM 3:3"/>यदि बाकी विश्वासघाती निकवे भी ते काय हुयो? काय तीनरा विश्‍वासघाती हुयने रईन यहोवा–भगवानन सच्चाई व्यर्थ ठहरावछे? <verse eid="ROM 3:3"/><verse number="4" style="v" sid="ROM 3:4"/>कदी भी नी। वरना यहोवा–भगवान सच आरू हर मानसु झुठ ठरछे, जोसो लिखलो छे, “जिनासे तु आपसी बातो हाव न्यायी ठरसे आरू न्याय करता टेहाव तु जय जड़से।” <verse eid="ROM 3:4"/><verse number="5" style="v" sid="ROM 3:5"/>एरकरीन यदि आपनो अन्याय आपसी न्यायीपन ठराव देता छे, ते हामु काय कोवजे? काय यो यहोवा–भगवान जू रीस करतु छे अन्यायी छे? यो ते हाव यहोवा–भगवानन रीति पर कोवतु छे। <verse eid="ROM 3:5"/><verse number="6" style="v" sid="ROM 3:6"/>कदी भी नी। नी ते यहोवा–भगवान कोसो जगन न्याय करसे? <verse eid="ROM 3:6"/><verse number="7" style="v" sid="ROM 3:7"/>यदि मार झूठन कारण यहोवा–भगवानन सच्चाई तेर महिमान करता, जादा करीन प्रकट होई ते पछु काँ पापीन समान हाव दण्डन योग्य ठहराया जाता छे? <verse eid="ROM 3:7"/><verse number="8" style="v" sid="ROM 3:8"/>“हामु काय निन्दा करजे कि वारली वात निकले?” जोसलो हामु पर भी यो दोष लागाड़ भी जातला छे, आरू काहय कयता छे कि हिनरो यो कोवनु छे। पुन ओसला काजे दोषी ठहरावनु वारू छे।<verse eid="ROM 3:8"/></para>
  <para style="s">कोय न्यायी नी छे</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9"/>ते मग काय हुयो? काय हामु तेर रईन वारला छे? कदी भी नी; काहकि हामु यहूदि यो आरू यूनानी दुयो पर यु दोष लागाड़ देदा छे कि चाँ सुब क सुब पापन वश मा छे। <verse eid="ROM 3:9"/><verse number="10" style="v" sid="ROM 3:10"/>जोसो लिखलो छे: “कोय न्यायी नी होय, एक भी नी। <verse eid="ROM 3:10"/><verse number="11" style="v" sid="ROM 3:11"/>कोय समझदार नी छे; कोय यहोवा–भगवान काजे देखनेवाला नी?” <verse eid="ROM 3:11"/><verse number="12" style="v" sid="ROM 3:12"/>सब भटक गया छे, सब जन निकम्मा बन गया छे; कोय भलाई करने वावा नी, एक भी नी। <verse eid="ROM 3:12"/><verse number="13" style="v" sid="ROM 3:13"/>इन्दरो गवो खुली हुई बीड़ा छे: तिनुक आपसी जीभों रईन छल कर्‍या छे: तिनरा हुटड़ीया मा घड़सान जहर छे। <verse eid="ROM 3:13"/><verse number="14" style="v" sid="ROM 3:14"/>आरू तिनरा मुय श्राप आरू कड़वजेर से भर गयो छे। <verse eid="ROM 3:14"/><verse number="15" style="v" sid="ROM 3:15"/>तिनरा पायो लुहूय वहय क फुर्तीले छे, <verse eid="ROM 3:15"/><verse number="16" style="v" sid="ROM 3:16"/>तिनरा रस्ता मा नाश आरू पीड़ा छे, <verse eid="ROM 3:16"/><verse number="17" style="v" sid="ROM 3:17"/>चे शांतीन वाट नी जानता छे। <verse eid="ROM 3:17"/><verse number="18" style="v" sid="ROM 3:18"/>तिनरे डूवान सामने यहोवा–भगवानन बीक नी छे। <verse eid="ROM 3:18"/><verse number="19" style="v" sid="ROM 3:19"/>हामु जाणता छे, कि व्यवस्था जो काहय कयती छे, ओकात कयती छे, जु व्यवस्थान हको तळे छे; एरकरीन कि हर एकान मुहय बंद कर जाए, आरू ओका संसार यहोवा–भगवानन दण्डन योग्य ठरसे; <verse eid="ROM 3:19"/><verse number="20" style="v" sid="ROM 3:20"/><note caller="+" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="GAL 2:16">गलातिया 2:16</ref></char></note>काहकि व्यवस्थान काम छे कोय मानुस तेर सामने न्यायी नी ठरसे, एरकरीन कि व्यवस्थान व्दरा पापन पेहचान होतली छे।<verse eid="ROM 3:20"/></para>
  <para style="s">विश्वासन द्बारा न्यायीपन</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21"/>पुन हिमी व्यवस्था छे अलग यहोवा–भगवान न्यायीपन प्रकट होयली छे, जेरी गवाय मूसान व्यवस्था आरू भविष्यवक्ता आपे छे, <verse eid="ROM 3:21"/><verse number="22" style="v" sid="ROM 3:22"/><note caller="+" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="GAL 2:16">गलातिया 2:16</ref></char></note>मतलब यहोवा–भगवान की ची न्यायीपन, जी ईशु मसीह पर विश्वास करने छे सुब विश्वास करनेवाला करता छे। काहकि कोसलोज भेद नी होय; <verse eid="ROM 3:22"/><verse number="23" style="v" sid="ROM 3:23"/>एरकरीन कि सब पाप करला छे आरू यहोवा–भगवानन महिमा छे, <verse eid="ROM 3:23"/><verse number="24" style="v" sid="ROM 3:24"/>पुन ओकान फोकटन दया रईन ओकान छुटकारान द्बारा जु मसीह ईशु मा छे, न्यायी ठहराए जातु छे। <verse eid="ROM 3:24"/><verse number="25" style="v" sid="ROM 3:25"/>तीनाक यहोवा–भगवानन तेर लुहूयन कारण एक ओसलो पछतावान बली ठहरावसे, जु विश्वास करने से काम होयतु छे, कि जु पाप पेहल करलो गयलु, आरू जिनु पर यहोवा–भगवान आपसी सहनशीलता रईन ध्यान नी देदु; ओकान विषय मा आपसी न्यायीपन प्रकट करे। <verse eid="ROM 3:25"/><verse number="26" style="v" sid="ROM 3:26"/>वरना इन टेमे तिनान न्यायीपन प्रकट हुयो कि जिनाछे वा खुद न्यायी ठहरसे, आरू जु ईशु पर विश्वास करे तिनरो भी न्यायी ठहरानेवाला रोवसे। <verse eid="ROM 3:26"/><verse number="27" style="v" sid="ROM 3:27"/>ते डाहळाय करनेन कारण काय छे? ते हेकान पालन करनो काय काम छे, काहनी व्यवस्थान कारण? काय कामो व्यवस्था छे? नी, वरना विश्वास आरू व्यवस्थान कारण। <verse eid="ROM 3:27"/><verse number="28" style="v" sid="ROM 3:28"/>मानुस यहोवा–भगवान पर विश्वासन द्बारा न्यायी ठहरतु छे, एरकरीन हामु इन परिणाम पर पुगता छे, कि मानुस व्यवस्थान कामन बिना भुरसान व्दरा न्यायी ठहरावतु छे। <verse eid="ROM 3:28"/><verse number="29" style="v" sid="ROM 3:29"/>काय यहोवा–भगवान सिर्फ यहूदि योन छे? काय चु गैरयहुदीया काय नी छे? हमकास चु गैरयहुदियोंन भी यहोवा–भगवान छे। <verse eid="ROM 3:29"/><verse number="30" style="v" sid="ROM 3:30"/><note caller="+" style="x"><char style="xo" closed="false">3:30 </char><char style="xt" closed="false"><ref loc="GAL 3:20">गलातिया 3:20</ref></char></note>काहकि एकुज यहोवा–भगवान छे, जु खतनावावान विश्वास छे आरू खतनारहितों क भी विश्वासन व्दरा न्यायी ठहरावछे। <verse eid="ROM 3:30"/><verse number="31" style="v" sid="ROM 3:31"/>ते काय हामु व्यवस्था क भुरसान द्वारा व्यर्थ ठरावतला छे? कदी भी नी। वरना व्यवस्था क एक जागे करता छे।<verse eid="ROM 3:31"/></para>
  <chapter eid="ROM 3"/>
  <chapter number="4" style="c" sid="ROM 4"/>
  <para style="s">अब्राहम क उदाहरण</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1"/>ते हामु काय कयजे, हामरा डाहायलान बास अब्राहम काजे काय सापड़लो? <verse eid="ROM 4:1"/><verse number="2" style="v" sid="ROM 4:2"/>काहकि यदि अब्राहम कामन रईन न्यायी ठरलु जातु ते, तीनाक डाहळाय करनेन जागु रोवतु, पुन यहोवा–भगवानन साथे नी। <verse eid="ROM 4:2"/><verse number="3" style="v" sid="ROM 4:3"/><note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="GAL 3:6">गलातिया 3:6</ref></char></note>चुखलो शास्त्र काय कयतो छे? यो कि “अब्राहम यहोवा–भगवान पर विश्वास करलो, आरू या तिनान करता न्यायीपन गिनाय गया।” <verse eid="ROM 4:3"/><verse number="4" style="v" sid="ROM 4:4"/>काम करनेवाळान दाहाड़की आपणु दान नी रोवे, पुन हक समझी जातो छे। <verse eid="ROM 4:4"/><verse number="5" style="v" sid="ROM 4:5"/>पुन जु विश्वास पर जेलाईन नी पुन कामो पर आरू यहोवा–भगवान पर विश्वास करता छे आरू जु यहोवा–भगवान पर ढोंगी भक्ति न काम बनावतु छे। हेकान यो यहोवा–भगवान पर विश्वास छे यहोवा–भगवान हेके न्यायी ठहरावता छे। <verse eid="ROM 4:5"/><verse number="6" style="v" sid="ROM 4:6"/>दाऊद क यो मतलब होतो कि ज्योत्यार चाँ उका मानसन क खुश होईन कयो छे जिनाक यहोवा–भगवान न्यायपन मानततु हतु, जो काहय भी करतु छे। <verse eid="ROM 4:6"/><verse number="7" style="v" sid="ROM 4:7"/>“धन्य छे चाँ जिनान अन्याय माफ होया, आरू जिनरा पाप ढाकला गया।” <verse eid="ROM 4:7"/><verse number="8" style="v" sid="ROM 4:8"/>“धन्य छे चाँ मानसे जिनाक यहोवा–भगवान पापी नी ठरावे।” <verse eid="ROM 4:8"/><verse number="9" style="v" sid="ROM 4:9"/>ते यो धन्य वचन, काय खतनावालोंन करता छे, खतनारहितोंन भी करता? हामु यो कयता छे, “अब्राहम न करता तिनान विश्वास न्यायीपन गिना गया।” <verse eid="ROM 4:9"/><verse number="10" style="v" sid="ROM 4:10"/>ते चाँ कोतार हुयो? काय ज्योत्यार हेकान खतना होय गयलो होतो। क बिना खतनान होतु। नी खतना होयनेन बाद नी बल्की खतना होयनेन पेहल ओसो हुयो। <verse eid="ROM 4:10"/><verse number="11" style="v" sid="ROM 4:11"/>आरू हेकान खतना होयतो ते एक सहलानी बनाव ताकि दर्शाव सके, कि यहोवा–भगवान उका खतना होयनेन पेहलुज विश्वासन द्बारा न्यायी स्विकार कर्‍यु! आरू अब्राहम सब विश्वासन आत्मिक बास बोन्यु हिमी चाँ बिना खतनान छे, पुन विश्वासीन छे, एरेन करता चाँ भी विश्वासी रूकाय जाछे; <verse eid="ROM 4:11"/><verse number="12" style="v" sid="ROM 4:12"/>चु तिनरू भी बास छे जिनरो खतना होयलो छे। ताकि काहकि चाँ मानसे खतना होयलाज हुता, बल्की आमरू बास अब्राहम विश्वासन पद सहलानी पर चालनेवालु होतु, चु अब्राहम जु खतना हुयने पेहल पर चाललु। विश्वास क द्वारा यहोवा–भगवान की प्रतिज्ञा क मिलना <verse eid="ROM 4:12"/><verse number="13" style="v" sid="ROM 4:13"/>ज्योत्यार यहोवा–भगवान अब्राहम छे आरू ओको पिढी छे प्रतिज्ञा करलो कि तुमू संसारन हकदार होयछे, यी प्रतिज्ञा अब्राहम काजे व्यवस्थान पालन करने छे नी मिवी पुन उका पर विश्वास कर्‍यु आरू यहोवा–भगवानन द्वारे न्याय स्विकार कर्‍या गया एरकारण छे मिवी। <verse eid="ROM 4:13"/><verse number="14" style="v" sid="ROM 4:14"/><note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="GAL 3:18">गलातिया 3:18</ref></char></note>ऐरकरता यदि मानते छे कि, यहोवा–भगवान आपली ची प्रतिज्ञा यी व्यवस्थान कारण पालन करनेवावा काजे मिवी, ते तुमरू विश्वास व्यर्थ छे, आरू यहोवा–भगवानन प्रतिज्ञा रिकामी होय जाती छे। <verse eid="ROM 4:14"/><verse number="15" style="v" sid="ROM 4:15"/>व्यवस्था रईन रीस प्रकट होयती छे, पुन जा व्यवस्था नी छे, चाँ व्यवस्थान नियम कोय नी तुड़तलो। <verse eid="ROM 4:15"/><verse number="16" style="v" sid="ROM 4:16"/>आरू यो यहोवा–भगवान भेटावनी छे, सब अब्राहम न वंश काजे भेटावनी छे, यो सिर्फ व्यवस्थान पालन करनेवालाज नी जा विश्वास करता छे, जो अब्राहम करलो काहकि अब्राहम हामु सबन आत्मिक बास छे। <verse eid="ROM 4:16"/><verse number="17" style="v" sid="ROM 4:17"/>जोसो लिखलो छे, “हाव तुखे बैस राष्ट्रान बास ठरावलु छे” काहकि यी वात यहोवा–भगवानन सामने वारली लागली छे। जु यहोवा–भगवान मरला माईन लोगहन क जीवता करलो छे, जु यहोवा–भगवान रूप रहित वातन आपसी हुकुमन रूप मा लावलु होतु। विश्वास करला, आरू जु मरला काजे जीवाड़े छे, आरू जी वात छे नी, तिनरा नाव ओसा लेता छे कि माने चाँ छे। <verse eid="ROM 4:17"/><verse number="18" style="v" sid="ROM 4:18"/>जसो वचन मा लिखलो छे, तु घण सवटी जातीन बास होयछे, आरू तारी पिढ़ी तारान सारकी होयछे। इनी वात पर आश राखनेन काय कारण नी हतों, तेबी अब्राहम विश्वास आरू आश राखिया। <verse eid="ROM 4:18"/><verse number="19" style="v" sid="ROM 4:19"/>काहकि चू सौ सालोन धोड़ तुमरा मरे होय शरीर आरू सारा क कुख क मरली होई क सी दशा जानीन भी विश्वास मा निर्बल नी हुयो, <verse eid="ROM 4:19"/><verse number="20" style="v" sid="ROM 4:20"/>आरू नी विनभुरसीया होईन यहोवा–भगवानन प्रतिज्ञा पर संका करे, पुन विश्वासमा द्दुढ़ होईन यहोवा–भगवानन महिमा करे; <verse eid="ROM 4:20"/><verse number="21" style="v" sid="ROM 4:21"/>आरू पाको जाना कि जिन वातन चु प्रतिज्ञा करली छे, वा तीनाक पुरो करनेमा भी समर्थ छे। <verse eid="ROM 4:21"/><verse number="22" style="v" sid="ROM 4:22"/>एर कारण, यहोवा–भगवान अब्राहम क ओका विश्वासन लारे हेके न्यायी मान लेदु। <verse eid="ROM 4:22"/><verse number="23" style="v" sid="ROM 4:23"/>आरू यो वचन, “विश्वास द्वारे न्यायी मान लेनो” सिर्फ तिना एखलान लोगहन जुगु नीं लिखी गयो हतो। <verse eid="ROM 4:23"/><verse number="24" style="v" sid="ROM 4:24"/>यो कि हामरे जुगु भी लिखी गय जो हामु न्यायी बनाड़े गया आरू जो हामु ईशु हामरा पोरबु जो मोतो माईन जीवतु हयु तिना पर विश्वास करजे। <verse eid="ROM 4:24"/><verse number="25" style="v" sid="ROM 4:25"/>चु हामरा पापोन कारण मोत जुगु आपाय गयु आरू हामुक यहोवा–भगवानन साते न्यायी बनावीन मरलाम माईन जीव उठ्यु।<verse eid="ROM 4:25"/></para>
  <chapter eid="ROM 4"/>
  <chapter number="5" style="c" sid="ROM 5"/>
  <para style="s">यहोवा–भगवान छे हावल</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1"/>काहकि हामु भुरसान कारण न्यायी होय गया छे, ते आपणा पोरबु ईशु मसीहन द्वारा यहोवा–भगवानन साथे हावल राखे, <verse eid="ROM 5:1"/><verse number="2" style="v" sid="ROM 5:2"/>आरू हिमी हेको द्बारा भुरसान कारण हामु यहोवा–भगवान क फुकट दया पारख लेता छे, आरू जीवन जीवता छे, आरू हामु हेको भुरसा पर डाहळाय करता छे, जी भुरसो यहोवा–भगवान महिमा साथे भागीदारी करली छे। <verse eid="ROM 5:2"/><verse number="3" style="v" sid="ROM 5:3"/>ओतरो नी हामरी अड़चन पर भी डाहळाय करता छे, काहकि हामु मालुम छे हामरी अड़चन धीरज तयार करतो छे। <verse eid="ROM 5:3"/><verse number="4" style="v" sid="ROM 5:4"/>आरू भागे रईन पारखीन चरित्र बनतो छे, आरू वाढ़तो ओसो चरित्र रईन आश पैदा होतली छे। <verse eid="ROM 5:4"/><verse number="5" style="v" sid="ROM 5:5"/>आरू यु आश हामुक निराश नीं करे काहकि यहोवा भगवान हेको मोंग हामरा दिल मा नाखलो छे मतलब चुखली आत्मा जी यहोवा–भगवानन भेंट छे। <verse eid="ROM 5:5"/><verse number="6" style="v" sid="ROM 5:6"/>काहकि ज्योत्यार हामु मा विश्वास नी होतु, ती मसीह सही टेम पर हामु भक्तीहीनोन करता मसीह बलिदान करलो छे। <verse eid="ROM 5:6"/><verse number="7" style="v" sid="ROM 5:7"/>कुदान न्यायी जनन करता कोय मरे, यो ते दुर्लभ छे; पुन काय जान सके कि एकदो वारलो मानसन करता कोय मरनेन भी साहस देखाड़े। <verse eid="ROM 5:7"/><verse number="8" style="v" sid="ROM 5:8"/>पुन यहोवा–भगवान हामु पर आपणा मोंगन, भलाई ओसली रीति मा प्रकट करता छे, कि जेतार हामु पापीच हुता तेतार मसीह आपणे करता मरलु। <verse eid="ROM 5:8"/><verse number="9" style="v" sid="ROM 5:9"/>अतरान करीन जब कि हामु एवी तेर लुहूय कारण न्यायी ठरहे, ते तेर द्वारा यहोवा–भगवानन रीस छे काँ नी बचाड़से? <verse eid="ROM 5:9"/><verse number="10" style="v" sid="ROM 5:10"/>हामु यहोवा–भगवानन हता दुस्मनी हता, पुन यहोवा–भगवान हेका पोर्‍यान मरने द्वारे हामरे साथे मेलमिलाप करायु, हिमी हामु यहोवा–भगवान क दोस्त छे, ते मसीहन द्बारा बैस जास्ती हामरा उध्दार काँ नी जुड़से।<verse eid="ROM 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 5:11"/>केवल यो नी, पुन हामु आपना पोरबु ईशु मसीहन द्वारा, जेको द्वारा आमरू हावल होयलु छे, यहोवा–भगवान मा खुश रोवता छे।<verse eid="ROM 5:11"/></para>
  <para style="s">आदम द्वारा मरनु–मसीह द्वारा जीवन</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12"/>एरकरीन जोसो एक मानुसन द्वारा पाप जगमा आवलो, आरू पापन द्वारा मरन आवलो, आरू इनी रीति छे मरनु सब मानसो मा पसरी गय, काहकि सब पाप करला। <verse eid="ROM 5:12"/><verse number="13" style="v" sid="ROM 5:13"/>नियम आवने छे पेहेल भी पाप हतों बाकीन पाप गिनायतों नीं हतों तव नियम नी हतों <verse eid="ROM 5:13"/><verse number="14" style="v" sid="ROM 5:14"/>पुन तेबी आदम गथु लीन मूसा तक पापन शासक हतों तेबी आदमन तसो चे लोगहन यहोवा–भगवानन वात नी टाळिया आरू आदम आवने वाळान सोहलानी बन्या। <verse eid="ROM 5:14"/><verse number="15" style="v" sid="ROM 5:15"/>यहोवा–भगवानन वरदान नी जो एक मानुसन पापोन रूप मा आयो तसोत् भेटावनी वरदान नी। काहकि जव एक मानुस क गुणा से बैस लोगहन मर गया ते भी यहोवा–भगवान क वरदान एक मानुस क द्बारा एणे ईशु मसीह क फोकटन दया क द्बारा सब क बैस वरदान जुड़से। <verse eid="ROM 5:15"/><verse number="16" style="v" sid="ROM 5:16"/>आरू यहोवा–भगवानन भेंट आरू एक मानुसन पाप, इनु दूयो मा फरक छे, ओळी एक पापोन कारण दोषन न्याय त्यो पुन घणा सवटा पापोन ओळते निर्दोष होयनेन जेका हामु कामका नी हता ची भेंट आवी ती हामु बिगुर पापोन होय गया। <verse eid="ROM 5:16"/><verse number="17" style="v" sid="ROM 5:17"/>काहकि जेतार एक मानसन गुणा कारण ओसलो मृत्यु ओको न द्वारा राज्य करलो, ते जा मानसे फोकटन दया आरू न्याय वरदान बहुतायत रईन पाते छे चाँ एक मानसोन, मतलब ईशु मसीह क द्वारा पाको ही अमरकाय जीवन मा राज्य करसु। <verse eid="ROM 5:17"/><verse number="18" style="v" sid="ROM 5:18"/>एरकरीन जोसो एक गुणा सब लोगहन मुक्त करता छे, पुन हुकुमन कारण ओको, एक लोगहन क काम भी सब लोगहन क मुक्त करता छे, आरू जीवनन करता न्यायी ठहरनेन कारण होयु। <verse eid="ROM 5:18"/><verse number="19" style="v" sid="ROM 5:19"/>काहकि जोसो एक मानुस हुकुम नी माननेन रईन घोणा मानसे पापी ठरसे, ओसो एक मानसन हुकुम मानने रईन घोणा मानसे न्यायी ठरहता जासे। <verse eid="ROM 5:19"/><verse number="20" style="v" sid="ROM 5:20"/>नियम छे परिचित हुयने छे पाप बढ़ गयो, पुन जा सारी पाप बढ़ियों चाँ सारी यहोवा–भगवानन दया ओळी भी जादा बढ़ी। <verse eid="ROM 5:20"/><verse number="21" style="v" sid="ROM 5:21"/>कि जोसो पाप मृत्यु फैलावतु राज्य कर्‍यु, तोसो आमरू पोरबु ईशु मसीहन द्वारा फोकटन दया भी अमरकाय जीवनन करता न्यायी ठरावता राज करसे।<verse eid="ROM 5:21"/></para>
  <chapter eid="ROM 5"/>
  <chapter number="6" style="c" sid="ROM 6"/>
  <para style="s">पापन करता मरनु: मसीहमा जीवन</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1"/>ते हामु काय कयजे? काय हामु पाप करता रोवजे कि फोकटन दया घोणा हुयो? <verse eid="ROM 6:1"/><verse number="2" style="v" sid="ROM 6:2"/>कदी भी नी। हामु ज्योत्यार पापन करता मर गया ते पछा ओगव तीनाम कोसो जीवन जाय? <verse eid="ROM 6:2"/><verse number="3" style="v" sid="ROM 6:3"/>काय तुमू नी जानता कि हामु सब ओको मसीह ईशु मा बपतिस्मा लेदा, उको मृत्यु मा बपतिस्मा लेदा। <verse eid="ROM 6:3"/><verse number="4" style="v" sid="ROM 6:4"/><note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="COL 2:12">कुलुस्सियो 2:12</ref></char></note>एरकरीन ओको न मृत्युन बपतिस्मा जुड़ने छे हामुक ओको साथे गाड़ीया, ताकि जोसो मसीह बासन महिमा क द्वारा मरला मा रईन जीवाल्लो गयो, तोसोज हामु भी नवलो जीवनन अनसारे चाल चाले। <verse eid="ROM 6:4"/><verse number="5" style="v" sid="ROM 6:5"/>काहकि यदि हामु उको मृत्युन समानता मा उको साथे जुड़ गया छे, ते नक्‍की उको जीव उठनेन समानता मा भी जुड़ जाछे। <verse eid="ROM 6:5"/><verse number="6" style="v" sid="ROM 6:6"/>काहकि हामु काजे जानता छे कि हामरा पुरानो मानुसकी उको साथे कुरूस पर चढ़ाव गया ताकि पापन शरीर नाश होय जाय, ताकि हामु ओगव पापन क पापन हको तळे मा नी रोवे। <verse eid="ROM 6:6"/><verse number="7" style="v" sid="ROM 6:7"/>काहकि जु मर गयु, जु पाप रईन मुक्त होय गयु। <verse eid="ROM 6:7"/><verse number="8" style="v" sid="ROM 6:8"/>एरकरीन यदि हामु मसीह साथे मर गया, ते आमरू विश्वास यो छे कि ओको साथे जीवसु भी। <verse eid="ROM 6:8"/><verse number="9" style="v" sid="ROM 6:9"/>काहकि यो जानतु छे कि मसीह मरला मा रईन जीव उठ्यु आरू पछु कदी नी मरनु। ओको पर पछु मृत्यु ओको पर पोरबुता नी करती। <verse eid="ROM 6:9"/><verse number="10" style="v" sid="ROM 6:10"/>काहकि आरू जु मर गयु पापन करता एकुज पुन जु नी जीवतु छे, चु यहोवा–भगवानन करता जीवतु छे। <verse eid="ROM 6:10"/><verse number="11" style="v" sid="ROM 6:11"/>ओसो तुमू भी आपने–आपसु पापन करता ते मर चुक्यो छे, पुन यहोवा–भगवानन करता मसीह ईशु मा जीवतु समझु। <verse eid="ROM 6:11"/><verse number="12" style="v" sid="ROM 6:12"/>अतरान करीन पाप तुमूक नश्वर शरीर मा राज नी करे, कि तुमूक उको लालुच हको तळे रोवु; <verse eid="ROM 6:12"/><verse number="13" style="v" sid="ROM 6:13"/>आरू ने आपणा अंगोंन अन्यायन हथियार होयनेन करता पाप क सोपु, पुन खुद आपसु मरे हुओं मा छे जीवतो उठनेन समान होईन जानीन यहोवा–भगवान हवाले कर देवु। <verse eid="ROM 6:13"/><verse number="14" style="v" sid="ROM 6:14"/>तेतार तुमु पर पापन पोरबुता नी हुयो, काहकि तुमूक व्यवस्थान हको तळे नी वरना फुकट दया तळे होय।<verse eid="ROM 6:14"/></para>
  <para style="s">न्यायपन क दास</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15"/>ते काय हुयो? काय एरकरीन हामु पाप करजे कि हामु व्यवस्थान हको तळे नी वरना फुकट दया तळे छे? कदी भी नी। <verse eid="ROM 6:15"/><verse number="16" style="v" sid="ROM 6:16"/>काय तुमूक नी जानतला कि जेरी हुकुम मानने करता तु खुद आपसु दासों क समान सौप देदा। ते ओकान दास छे: चाहे पाप क, जेरो आखरीम मृत्यु छे, चाहे हुकुमन करता। जेरो आखरी न्यायीपन छे? <verse eid="ROM 6:16"/><verse number="17" style="v" sid="ROM 6:17"/>पुन यहोवा–भगवानन धन्यवाद होय, कि तुमू जु पापन दास हुता हिमी मन रईन ओको शिक्षा माननेवाला होय गया, जिनान साँचामा नाखला गया हुता। <verse eid="ROM 6:17"/><verse number="18" style="v" sid="ROM 6:18"/>आरू पाप छुड़ावु जाईन न्यायपनन दास होय गया। <verse eid="ROM 6:18"/><verse number="19" style="v" sid="ROM 6:19"/>हाव उको शारीरिक दुर्बलतान कारण मानसोन रीति पर कोवतु छे। जोसो तुमूक आपना अंगोह खराब कामो क करता विटळ आरू खराब कामो न दास करीन सौपलु होतु, ओसोज हिमी आपना अंगोह चुखलोतान करता न्यायपन दास करीन सौप देवु। <verse eid="ROM 6:19"/><verse number="20" style="v" sid="ROM 6:20"/>ज्योत्यार तुमू पापन दास हुता, ते न्यायीपन छे स्वतंत्र हता। <verse eid="ROM 6:20"/><verse number="21" style="v" sid="ROM 6:21"/>जीन वातन करता तुमू लज्जित होय रया हता, ओको तिन टेहाव तुमू काय फव देख्या? काहकि ओको न आखरी ते रईन मृत्यु छे। <verse eid="ROM 6:21"/><verse number="22" style="v" sid="ROM 6:22"/>पुन पाप छे स्वतंत्र होईन आरू यहोवा–भगवानन दास बनीन तुमू फव जुवड़ो ओको चुखलोता हासिल होतली छे, आरू ओको आखरी अमरकाय जीवन छे। <verse eid="ROM 6:22"/><verse number="23" style="v" sid="ROM 6:23"/>काहकि पापन दाहाड़की ते मृत्यु छे, पुन यहोवा–भगवानन वरदान हामरा पोरबु मसीह ईशु मा अमरकाय जीवन छे।<verse eid="ROM 6:23"/></para>
  <chapter eid="ROM 6"/>
  <chapter number="7" style="c" sid="ROM 7"/>
  <para style="s">साकन बाद जीवनन उदाहरण</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1"/>हे भाईयो, काय तुमू नी जानता हाव व्यवस्था जावनेवावा काजे कय गयु छे कि ज्योत्यार तोत्यार मानुस जीवतु रोवतु छे, तोत्यार तक ओको पर व्यवस्थान पोरबुता रवती छे? <verse eid="ROM 7:1"/><verse number="2" style="v" sid="ROM 7:2"/>उदारणन करता एक वियाव वाली बाई नियम न द्वारे ताह तक बांधली छे, ज्योत्यार तक ची जीवती छे, पुन यदि हेको घर वावु मर जातु छे, ती तेर नाता मा नियम रईन सुट जाती छे। <verse eid="ROM 7:2"/><verse number="3" style="v" sid="ROM 7:3"/>एरकरीन यदि घर वावु जीवतु रवे तेबी कोय दिसरा मानसन होय जाये, ते व्यभिचारिणी कहवासे, पुन यदि घर वावु मर जाये, ते चाँ ओको व्यवस्था रईन छुट गय, यो तक कि यदि कोय दिसरा मानसन होय जाय तौभी व्यभिचारिणी नी ठहरछे। <verse eid="ROM 7:3"/><verse number="4" style="v" sid="ROM 7:4"/>ते हे मार भाईस्यो, तुमू भी मसीहान देहन द्वारा व्यवस्थान करता मरला बन गया, कि ओको दिसरा काजे होय जावु, जु मरलाम रईन जीव उठलु: ताकि हामु यहोवा–भगवानन करता फव लावजे। <verse eid="ROM 7:4"/><verse number="5" style="v" sid="ROM 7:5"/>काहकि ज्योत्यार हामु शारीरिक हुता, ते पापन लालसा जी व्यवस्थान द्वारा होती, मृत्युन फव पैदा करनेन करता हामरा अंगों मा काम करती होती। <verse eid="ROM 7:5"/><verse number="6" style="v" sid="ROM 7:6"/>पुन जीनान बन्धन मा हामु हुता ओको करता हिमी मरीन, हिमी व्यवस्था छे ओसा छुट गए, कि लिखल जुनली रीति पर नी, वरना आत्मान नवली रीति पर सेवा करता छे।<verse eid="ROM 7:6"/></para>
  <para style="s">व्यवस्था आरू पाप</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7"/>ते हामु काय कयजे? काय व्यवस्था पाप छे? कदी भी नी। वरना बिना व्यवस्थान हाव पाप काजे नी वोकतु व्यवस्था यदि नी कयती, “लालुच मा करे” ते हाव काजे नी जानतु। <verse eid="ROM 7:7"/><verse number="8" style="v" sid="ROM 7:8"/>पुन पाप काजे मकु देखीन हुकुमन द्वारा मखे मा सब प्रकारन लालस पैदा कर्‍यु, काहकि बिना व्यवस्थान पाप मरलु छे। <verse eid="ROM 7:8"/><verse number="9" style="v" sid="ROM 7:9"/>हाव ते व्यवस्थान बिना पेहल जीवतु होतु, पुन हुकुम आवी, ते पाप जीव गयु, आरू हाव मर गयु। <verse eid="ROM 7:9"/><verse number="10" style="v" sid="ROM 7:10"/>आरू ची हुकुम जी जीवनन करता होती, मार करता मृत्युन कारण ठरली। <verse eid="ROM 7:10"/><verse number="11" style="v" sid="ROM 7:11"/>काहकि पाप मकु देखीन हुकुमन द्वारा मखे भड़कायु, आरू ओको न द्वारा मखे मार भी देदु। <verse eid="ROM 7:11"/><verse number="12" style="v" sid="ROM 7:12"/><note caller="+" style="f"><char style="fr" closed="false">7:12 </char><char style="ft" closed="false">पेहला शास्त्र मा लेखला हतो कि जो जोड़तो नी हतो</char></note>एरकरीन व्यवस्था चुखलो छे, आरू हुकुम चुखलो, न्यायी, आरू वारली छे। <verse eid="ROM 7:12"/><verse number="13" style="v" sid="ROM 7:13"/>ते काय ची जी वारली होती, मार करता मोत ठरली? कदी भी नी। पुन पाप तिन वारली वस्तुन द्वारा मार करता मोत पैदा करनेवावा होया कि ओको न पाप होयना प्रकट हुयो, आरू हुकुमन द्वारा पाप घोणा पापमय ठहरसे।<verse eid="ROM 7:13"/></para>
  <para style="s">माहयतला झगड़ा</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14"/>काहकि हामु जानता छे कि व्यवस्था ते आत्मिक छे, पुन हाव शारीरिक छे आरू पापन हातन वेचलु होतु छे। <verse eid="ROM 7:14"/><verse number="15" style="v" sid="ROM 7:15"/><note caller="+" style="x"><char style="xo" closed="false">7:15 </char><char style="xt" closed="false"><ref loc="GAL 5:17">गलातिया 5:17</ref></char></note>आरू जु हाव करतु छे ओको नी जानतु; काहकि जो हाव चाहतु छे चो नी करता, आरू जेका मखे घीन आवती छे, चो करतु छे। <verse eid="ROM 7:15"/><verse number="16" style="v" sid="ROM 7:16"/>यदि जो हाव नी चाहतु चोज करतु छे, ते हाव मान लेतु छे कि व्यवस्था वारू छे। <verse eid="ROM 7:16"/><verse number="17" style="v" sid="ROM 7:17"/>ती ओसी दशा मा ओको न करनेवाला हाव नी, वरना पाप छे जु मार मा बठ रोयु छे। <verse eid="ROM 7:17"/><verse number="18" style="v" sid="ROM 7:18"/>काहकि हाव जानतु छे, कि मखे मा मतलब मारा शरीर मा कोय वारली वस्तु वास नी करतली, मरजी ते मखे मा छे, पुन वारला काम मखे बन नी पड़े। <verse eid="ROM 7:18"/><verse number="19" style="v" sid="ROM 7:19"/>काहकि जीन वारला कामन हाव मरजी करतु छे, चाँ ते नी करे, पुन जीन बुराईन मरजी नी करतु, चो कर्‍या करतु छे। <verse eid="ROM 7:19"/><verse number="20" style="v" sid="ROM 7:20"/>पुन यदि हाव चो करतु छे जिनान मरजी नी करे, ते ओको न करनेवावा हाव नी रवो, पुन पाप जु मखे मा बठलु छे। <verse eid="ROM 7:20"/><verse number="21" style="v" sid="ROM 7:21"/>ते हाव यो व्यवस्था देखो कि ज्योत्यार भलाई करनेन मरजी करतु छे, ते बुराई मार जु आवती छे। <verse eid="ROM 7:21"/><verse number="22" style="v" sid="ROM 7:22"/>काहकि हाव माहयतली आत्मा से ते यहोवा–भगवानन व्यवस्था छे बैस खुश रवता छे। <verse eid="ROM 7:22"/><verse number="23" style="v" sid="ROM 7:23"/>पुन मखे आपना अंगो मा दिसरा प्रकारन व्यवस्था देखाय पड़ती छे, जी मारी ओकलन व्यवस्था रईन लड़ती छे आरू मखे पापन व्यवस्थान बन्धन मा नाखती छे जी मार अंगो मा छे। <verse eid="ROM 7:23"/><verse number="24" style="v" sid="ROM 7:24"/>हाव कोसु अभागु मानसु छे! मखे इन मृत्युन देह रईन कुन छुड़ावसे छे? <verse eid="ROM 7:24"/><verse number="25" style="v" sid="ROM 7:25"/>आमरू पोरबु ईशु मसीहन द्वारा मखे छुटकारो जुड़से एरकरीन हाव तुमू यहोवा–भगवानन धन्यवाद करतु छे, पुन शरीर छव पापन व्यवस्थान सेवा करतु छे।<verse eid="ROM 7:25"/></para>
  <chapter eid="ROM 7"/>
  <chapter number="8" style="c" sid="ROM 8"/>
  <para style="s">चुखलो आत्मान द्वारा जीवन</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1"/>जु मसीह ईशु मा जीवन जीवतु छे, उको पर दण्डन हुकुम नी। <verse eid="ROM 8:1"/><verse number="2" style="v" sid="ROM 8:2"/>काहकि जीवन क आत्मान व्यवस्था मसीह ईशु मा मखे पाप रईन मृत्युन व्यवस्था छे छुड़ देदा। <verse eid="ROM 8:2"/><verse number="3" style="v" sid="ROM 8:3"/>काहकि जो काम व्यवस्था शरीरन कारण कमजोर होईन नी कर सके, ओको काजे यहोवा–भगवान कर्‍यु, मतलब आपना पोर्‍या काजे पापमय शरीरन समानता मा आरू पापनबलि होयनेन करता मोकलीन, शरीर मा पाप पर दण्डन हुकुम देदा। <verse eid="ROM 8:3"/><verse number="4" style="v" sid="ROM 8:4"/>अतरान करीन व्यवस्थान विधि हामु मा जो शरीर क लारे नी वरना आत्मान लारे चालता छे, पुरी कर जाए। <verse eid="ROM 8:4"/><verse number="5" style="v" sid="ROM 8:5"/>काहकि शारीरिक मानसन शरीरन वात पर मन लागाड़ ़े छे; पुन जा आत्मिकता मा जीवता छे, आत्मान वात पर मन लागाड़ता छे। <verse eid="ROM 8:5"/><verse number="6" style="v" sid="ROM 8:6"/>शरीर पर मन लागाड़नु ते मरन छे, पुन आत्मा पर मन लागाड़ जीवन आरू शांती छे; <verse eid="ROM 8:6"/><verse number="7" style="v" sid="ROM 8:7"/>काहकि शरीर पर मन लागावने ते यहोवा–भगवान छे दुस्मनी हावकनु छे, काहकि नी ते यहोवा–भगवान कि व्यवस्थान हको तळे छे आरू नी होय सके छे; <verse eid="ROM 8:7"/><verse number="8" style="v" sid="ROM 8:8"/>आरू जु शरीरन हको तळे मा छे, चाँ यहोवा–भगवान काजे खुश नी कर सके। <verse eid="ROM 8:8"/><verse number="9" style="v" sid="ROM 8:9"/>पुन जेतार यहोवा–भगवानन आत्मा तुखे मा बठती छे, ते तुमूक मानसन स्वभाव मा नी, पुन आत्मिक हालत मा छे। यदि एकदामा मसीहन आत्मा नी ते चो ओका नी। <verse eid="ROM 8:9"/><verse number="10" style="v" sid="ROM 8:10"/>यदि मसीह तुखे मा छे, ते धोङ पापन कारण मर गयो छे; पुन आत्मा न्यायीपनन कारण जीवतलो छे। <verse eid="ROM 8:10"/><verse number="11" style="v" sid="ROM 8:11"/><note caller="+" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="1CO 3:16">1 कुरन्थियो 3:16</ref></char></note>यदि ओका आत्मा जिना छे ईशु मरलाम रईन जीवाड़्यु थारे मा बठ्यु छे; ते जु मसीह काजे मरलाम रईन जीवाल्लु, चो तुमरो मरल शरीर क भी आपना आत्मान द्वारा जो तुखे मा बठलो छे जीवाड़छे। <verse eid="ROM 8:11"/><verse number="12" style="v" sid="ROM 8:12"/>अतरान करीन हे भाइयो, हामु शरीरन कर्जदार नी, क शरीरन लारे दाहड़ा काटे। <verse eid="ROM 8:12"/><verse number="13" style="v" sid="ROM 8:13"/>हामु बहुतेक शरीरन लारे जीवन काटसु ते कर्ज छे, पुन इनान मतलब यो नी क हामु बहुतेक स्वभाव रईन जीवजे। <verse eid="ROM 8:13"/><verse number="14" style="v" sid="ROM 8:14"/>अतरान करीन जोतरा लोगहन यहोवा–भगवानन आत्मा छे चलावड़े चालता छे, चास ते यहोवा–भगवानन पोर्‍या छे। <verse eid="ROM 8:14"/><verse number="15" style="v" sid="ROM 8:15"/><note caller="+" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="GAL 4:5-7">गलातिया 4:5-7</ref></char></note><note caller="+" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="MRK 14:36">मरकुस 14:36</ref>; <ref loc="GAL 4:6">गलातिया 4:6</ref></char></note>काहकि तुमूक दासत्वन आत्मा नी जुड़ी क पछा बीह गया, पुन लेपालकपन की आत्मा जुड़ी छे, जेरछे हामु छे अब्बा, हे बाप करीन आयड़े छे। <verse eid="ROM 8:15"/><verse number="16" style="v" sid="ROM 8:16"/>चुखलो आत्मा आपसु हामरी आत्मा साथे गवाही देदा छे, कि हामु यहोवा–भगवानन पोर्‍या छे; <verse eid="ROM 8:16"/><verse number="17" style="v" sid="ROM 8:17"/>आरू यदि पोर्‍या छे ते वारीस भी, वरना यहोवा–भगवानन वारीस आरू मसीह क साथे छे, क हामु ओका साथे दुःख उठावे ते उको साथे महिमा भी जुड़से।<verse eid="ROM 8:17"/></para>
  <para style="s">भविष्य मा प्रगट होयनेवावी महिमा</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18"/>काहकि हाव समझतु छे, कि इन टेमे दुःख आरू पीड़ा उको महिमा न सामने, जी हामु पर प्रगट होयनेवावी छे, काहय भी नी छे। <verse eid="ROM 8:18"/><verse number="19" style="v" sid="ROM 8:19"/>काहकि सृष्टि मोटली भुरसा सी भरायली नजर सी यहोवा–भगवान न अवळियाद उजन्तो हुयसे। <verse eid="ROM 8:19"/><verse number="20" style="v" sid="ROM 8:20"/>काहकि सृष्टि आपसी मरजी छे नी पुन हक तळे करनेवावा रईन छे, व्यर्थतान तळे एर आश सी करी। <verse eid="ROM 8:20"/><verse number="21" style="v" sid="ROM 8:21"/>कि सृष्टि भी आपसु विनाशन दासत्व रईन छुटकारा जोड़ताज, यहोवा–भगवानन पोर्‍यान महिमा न छुटकारो हासील करसे। <verse eid="ROM 8:21"/><verse number="22" style="v" sid="ROM 8:22"/>काहकि हामु जानता छे, कि सब सृष्टि हिमी तक भेवायती करती आरू पीड़ा मा पड़ीन तड़पावती छे; <verse eid="ROM 8:22"/><verse number="23" style="v" sid="ROM 8:23"/><note caller="+" style="x"><char style="xo" closed="false">8:23 </char><char style="xt" closed="false"><ref loc="2CO 5:2-4">2 कुरन्थियो 5:2-4</ref></char></note>आरू सिर्फ चु नी पुन हामु भी जिनाक जु आत्मा क पेहलो फव छे, आपसु जु करहाये; आरू लेपालक होयनेन, मतलब आपना शरीरन छुटकारान वाट देख रया छे। <verse eid="ROM 8:23"/><verse number="24" style="v" sid="ROM 8:24"/>भुरसान द्बारा ते आमरू छुटकारो होयलु छे, पुन जिन वस्तु क भुरसो करती जाती छे, जब चाँ देखने मा आवे ते पछी भुरसो क रवी? काहकि जिन चीजो क कोय देख रयु छे, ओकी आश काय करसे। <verse eid="ROM 8:24"/><verse number="25" style="v" sid="ROM 8:25"/>पुन जिन वस्तु काजे हामु नी देखता, यदि ओको पर भुरसो राखता छे, ते भागेज करीन उको वाट देखता भी छे। <verse eid="ROM 8:25"/><verse number="26" style="v" sid="ROM 8:26"/>ओसली रीति रईन आत्मा भी आपणी दुर्बलता मा मदत करता छे: काहकि हामु नी जानता कि प्रार्थना कोसली रीति रईन करनो जुवे, पुन आत्मा आपनु आपसुज ओसली दम भर भरीन, जु बयानन बाहर छे, हामरे करता रावन्या करता छे; <verse eid="ROM 8:26"/><verse number="27" style="v" sid="ROM 8:27"/>आरू मन क यहोवा–भगवान जानतु छे, कि चुखलो आत्मान मनमा काय छे? काहकि चु चुखलो मानसो करता यहोवा–भगवानन इच्छान लारे रावन्या करतो छे। <verse eid="ROM 8:27"/><verse number="28" style="v" sid="ROM 8:28"/>आरू हामु जानता छे, कि जा लोगहन यहोवा–भगवान रईन मोंग राखता छे, उको करता सब वातु मिवीन भलाई ही काजे पैदा करता छे; मतलब उको करता जी मरजी लारे बुलावला छे। <verse eid="ROM 8:28"/><verse number="29" style="v" sid="ROM 8:29"/>काहकि जिनुक उको पेहल छे जानलु छे तिनुक पेहल ठहरावलु भी छे कि उको पोर्‍या क स्वरूप मा छे ताकि चु घोणा भाईस्यो मा पहिलौठा ठरसे। <verse eid="ROM 8:29"/><verse number="30" style="v" sid="ROM 8:30"/>पछु तिनुक उको पेहल छे ठरावला, तिनुक बुलावला भी; आरू जिनाक बुलावला, तिनुक न्यायी भी ठहरावला छे; आरू तिनुक न्यायी ठरावला, तिनुक महिमा भी देदा छे।<verse eid="ROM 8:30"/></para>
  <para style="s">यहोवा–भगवानन प्रेम</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31"/>छेवली कावा हामु इनी वात विषय मा काय कोवजे? यदि यहोवा–भगवान हामरी वोगे छे, ते हामरा विरोधी कुन रोव सेकता छे? <verse eid="ROM 8:31"/><verse number="32" style="v" sid="ROM 8:32"/>जु आपना खुदन पोर्‍या काजे भी नी राखीन छु़ड़यु, पुन उको हामु सबन करता आप देदा, तिनाक उको साथे हामुक आरू फुकट मा सब काय कोसो नी आपसे? <verse eid="ROM 8:32"/><verse number="33" style="v" sid="ROM 8:33"/>यहोवा–भगवानन नेवाड़ला पर गुणू कुन लागाड़ छे? यहोवा–भगवानूज जु छे उको न्यायी ठहरावनेवावु छे। <verse eid="ROM 8:33"/><verse number="34" style="v" sid="ROM 8:34"/>मग कुन छे जु दण्डन हुकुम देसे? मसीह चु छे जु मर गयु वरना मरलाम रईन भी जीव उठलु, आरू यहोवा–भगवानन डाखरे बाजु छे, आरू हामरे करता भानगाड़ाईन भी करतु छे। <verse eid="ROM 8:34"/><verse number="35" style="v" sid="ROM 8:35"/>कुन हामु काजे मसीहान मोंग रईन अलग कर छे? काय पीड़ा, या संकट, या अकाल, या गरीब, या नंगाई, या जोखिम, या तलवार? <verse eid="ROM 8:35"/><verse number="36" style="v" sid="ROM 8:36"/>जोसो शास्त्र लिखलो छे, “तार करता हामु दाहड़ु भर घात करता जाता छे; हामु वध होयनेवाला गाडरा न समान गिन्ला गया छे” <verse eid="ROM 8:36"/><verse number="37" style="v" sid="ROM 8:37"/>पुन इन सब वात मा हामु उको द्वारा जु हामु काजे मोंग करलो छे, विजेता रईन बढ़ीन छे। <verse eid="ROM 8:37"/><verse number="38" style="v" sid="ROM 8:38"/>काहकि हाव नक्‍की जानतु छे कि नी मृत्यु, नी जीवन, नी सोरगदूत, नी प्रधानता, नी वर्तमान, नी भविष्य, नी शक्ति, नी ऊचो, <verse eid="ROM 8:38"/><verse number="39" style="v" sid="ROM 8:39"/>नी धरती उंडो, नी धरतीन उचाई, आरू नी सृष्टि हामु यहोवा–भगवानन मोंग रईन, जो आमरू पोरबु ईशु मा छे, अलग कर सके।<verse eid="ROM 8:39"/></para>
  <chapter eid="ROM 8"/>
  <chapter number="9" style="c" sid="ROM 9"/>
  <para style="s">यहोवा–भगवान आरू ओका निवाड़्ला मानसे</para>
  <para style="m">
    <verse number="1" style="v" sid="ROM 9:1"/>हाव मसीह मा सच कयतु छे, हाव झुठ नी बुल रयु आरू मारू मन भी चुखलो आत्मा मा गवाही देदा छे, <verse eid="ROM 9:1"/><verse number="2" style="v" sid="ROM 9:2"/>कि मखे मो़टो शोक छे, आरू मारो मन मा दाहड़ीन दुःखतो रवतो छे, <verse eid="ROM 9:2"/><verse number="3" style="v" sid="ROM 9:3"/>काहकि हाव या तक चाहतु हतु, कि आपना भाईस्यो करता जो शरीरन भाव रईन मारो घरानो वालो छे, खुद मसीह मा शापित होय जाछे। <verse eid="ROM 9:3"/><verse number="4" style="v" sid="ROM 9:4"/>चु इस्त्राएली छे, आरू लेपालकपन हक्‍क, महिमा, आरू वाचा, व्यवस्थान उपहार, यहोवा–भगवान क भक्ति, आरू प्रतिज्ञाऍ ओका छे। <verse eid="ROM 9:4"/><verse number="5" style="v" sid="ROM 9:5"/>पुर्वज भी ओका छे, आरू मसीह भी शरीरन भाव रईन छुटकारो होयलु, सबन ऊपर सयाळा यहोवा–भगवान युगानुयुग धन्य छे। आमेन। <verse eid="ROM 9:5"/><verse number="6" style="v" sid="ROM 9:6"/>पुन यो नी कि यहोवा–भगवानन वचन टव गयो, अतरान करीन कि जो इस्‍त्राएलन वंश छे, चाँ सब इस्त्राएली नी; <verse eid="ROM 9:6"/><verse number="7" style="v" sid="ROM 9:7"/>आरू नी अब्राहमन वंश होयनेन कारण सब ओका पोर्‍या ठरसे, पुन लिखलो छे “इसहाक हिय रईनज तारो वंश कहवासे।” <verse eid="ROM 9:7"/><verse number="8" style="v" sid="ROM 9:8"/>मतलब शरीरन पोर्‍या यहोवा–भगवानन पोर्‍या नी, पुन प्रतिज्ञान पोर्‍यान वंश गिनियो जातो छे। <verse eid="ROM 9:8"/><verse number="9" style="v" sid="ROM 9:9"/>काहकि प्रतिज्ञान वचन यो छे: “हाव इन टेहावन लारे आवी, आरू सारान पोर्‍या रोवछे।” <verse eid="ROM 9:9"/><verse number="10" style="v" sid="ROM 9:10"/>आरू सिर्फ यो नी, पुन जेतार रिबका भी एक छे मतलब आमरू बास इसहाक रईनी भारपाय होती, त्योतार रिबका क दुय पोर्‍या होयला। <verse eid="ROM 9:10"/><verse number="11" style="v" sid="ROM 9:11"/>आरू हिमी तक नी ते पोर्‍यो जनम हतो, आरू नी उको काय भलो या भुरो करता हता; अतरान करीन कि यहोवा–भगवानन मनमा जी उको निवाड़ लेनेन लारे छे, काम कारण नी, पुन बुलावनेवाले पर बवनी रवे। <verse eid="ROM 9:11"/><verse number="12" style="v" sid="ROM 9:12"/>उको कयो, “मोटलु नानलान दास रवछे।” <verse eid="ROM 9:12"/><verse number="13" style="v" sid="ROM 9:13"/>जोसो लिखलो छे, “हाव याकूब काजे मोंग करलो, पुन एसाव क मोंग नी कर्‍यु।” <verse eid="ROM 9:13"/><verse number="14" style="v" sid="ROM 9:14"/>ते हामु काय कयजे? काय यहोवा–भगवानन यो अन्याय छे? कदी भी नी। <verse eid="ROM 9:14"/><verse number="15" style="v" sid="ROM 9:15"/>काहकि चु मूसा क कयतु छे, “हाव जेका कोय पर दया करने चाह्यु तिना पर द्या करीस, आरू जेका कोय पर किरपा करने चाह्यु ओको पर किरपा करीस।” <verse eid="ROM 9:15"/><verse number="16" style="v" sid="ROM 9:16"/>ऐरकरता यो नी ते चाहनेवालान, नी दौड़नेवावान पुन दया करनेवावा यहोवा–भगवानन भुरसे छे। <verse eid="ROM 9:16"/><verse number="17" style="v" sid="ROM 9:17"/><note caller="+" style="f"><char style="fr" closed="false">9:17 </char><char style="ft" closed="false">निर्भर </char></note>काहकि चुखलो शास्त्र मा फिरौन छे कयलो गयलो, “हाव तुखे अतरान करीन उभु करलो छे, कि तुखे मा आपनो शक्ति देखाड़ो, आरू मारो नावन प्रचार सब धरती पर होयछे।” <verse eid="ROM 9:17"/><verse number="18" style="v" sid="ROM 9:18"/>ते पछु, चु जेका पर चाहता छे, उको पर दया करतु छे, आरू जेका चाहतु छे उको मजबुत कर देतु छे।<verse eid="ROM 9:18"/></para>
  <para style="s">यहोवा–भगवानन रीस आरू ओकी दया</para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19"/>पछु तु मखे कयसे, “चु पछु कोसो दोष लागाड़ ़े छे? कुन ओका इच्छान सामना करतु छे?” <verse eid="ROM 9:19"/><verse number="20" style="v" sid="ROM 9:20"/>हे मानव, भला तु कुन छे, जु यहोवा–भगवानन सामना करतु छे? काय बनावली वस्तु बनावने वाला काजे कय सकता छे, “तु मखे ओसलु काँ बनावलु छे?” <verse eid="ROM 9:20"/><verse number="21" style="v" sid="ROM 9:21"/>काय कुमायड़ा क धुवा पर हक्‍क नी, कि एकुज गुंडाम रईन एक ठाहरो विजुतन करता, आरू दिसरा विन विजुतन करता बनावे? <verse eid="ROM 9:21"/><verse number="22" style="v" sid="ROM 9:22"/>कि यहोवा–भगवान आपनु रीस देखावने आरू आपनी शक्ति प्रगट करनेन मरजी रईन रीसन ठाहरा काजे, जा विनाशन करता तयार करला गयला छे, धीर रईन छे। <verse eid="ROM 9:22"/><verse number="23" style="v" sid="ROM 9:23"/>आरू दयान ठाहरा पर, जिनाक महिमान करता पेहल तयार करलो, आपसा महिमान धन काजे प्रगट करनेन मरजी कर्‍या। <verse eid="ROM 9:23"/><verse number="24" style="v" sid="ROM 9:24"/>मतलब हामु पर जीनुक उको नी सिर्फ यहूदियों मा रईन, वरना गैरयहुदी मा रईन बुलावलु। <verse eid="ROM 9:24"/><verse number="25" style="v" sid="ROM 9:25"/>जोसो चो होशे क किताब मा भी कयतु छे, “जी मारी प्रजा नी होती, उको हाव आपनी प्रजा कयीस, आरू जु मोंगावु नी होतु, उको मोंगावु कोइस; <verse eid="ROM 9:25"/><verse number="26" style="v" sid="ROM 9:26"/>आरू ओसो होयछे कि जिन जागामा उको यो कयलो गयलो हतो, क तुमू मार प्रजा नी होय, तिनाज जागे चाँ जीवता यहोवा–भगवानन पोर्‍या कहवासे” <verse eid="ROM 9:26"/><verse number="27" style="v" sid="ROM 9:27"/>आरू यशायाह इस्त्राएलन विषयमा आयड़ीन कयता छे, “लागे ते इस्त्राएलन पोर्‍यान गिनती दरियान रेतान बराबर रवे, तेभी तिनाम रईनी थुड़ाक वाचछे। <verse eid="ROM 9:27"/><verse number="28" style="v" sid="ROM 9:28"/>काहकि पोरबु आपना वचन धरती पर पुरा करीन, न्यायीपन रईन साठु–साठु उको सिद्ध करसे।”<verse eid="ROM 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ROM 9:29"/>जोसो यशायाह ने पेहल भी कयलु हतु,</para>
  <para style="pi" vid="ROM 9:29">“यदि सैनीकन पोरबु हामरे करता काहय वंश नी छुड़तु”</para>
  <para style="p" vid="ROM 9:29">ते हामु सदोमन समान होय जाता,</para>
  <para style="p" vid="ROM 9:29">“आरू गमोरान सरीखे ठरता।”<verse eid="ROM 9:29"/></para>
  <para style="s">इस्त्राएलन बिनभुरस्या</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30"/>ते हामु काय कयजे? यो कि गैरयहुदी ने जा न्यायीपन क खोज नी करता हता, न्यायीपन हासिल करीन मतलब उको न्यायीपन क जु विश्वास रईन छे; <verse eid="ROM 9:30"/><verse number="31" style="v" sid="ROM 9:31"/>पुन इस्त्राएली; जी न्यायीपन व्यवस्थान खोज करता–करता उको व्यवस्था तक नी पुगी। <verse eid="ROM 9:31"/><verse number="32" style="v" sid="ROM 9:32"/>काय करने? अतरान करीन ओको विश्वास रईनी नी, पुन मानु कामो रईनी उको खोज करता हता; हेका उको दंगड़ा पर ठुकर खाई। <verse eid="ROM 9:32"/><verse number="33" style="v" sid="ROM 9:33"/>जोसो लिखलो छे,</para>
  <para style="p" vid="ROM 9:33">“देखु, हाव सिय्योन मा एक ठेस लागनेन दगड़ो, आरू ठुकर खानेन दगड़ु राखतु छे, आरू जु उको पर विश्वास करसे, चु लज्जित नी हुये।”<verse eid="ROM 9:33"/></para>
  <chapter eid="ROM 9"/>
  <chapter number="10" style="c" sid="ROM 10"/>
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1"/>हे भाईस्यो, मार मनन लालुच आरू उको करता यहोवा–भगवान क मारी प्रार्थना छे, कि तिनुक उध्दार जुड़से। <verse eid="ROM 10:1"/><verse number="2" style="v" sid="ROM 10:2"/>काहकि हाव ओकान गवाही देता छे, कि उको यहोवा–भगवानन करता धुन रवती छे, पुन बुध्दिमानी क साथे नी। <verse eid="ROM 10:2"/><verse number="3" style="v" sid="ROM 10:3"/>काहकि चाँ यहोवा–भगवानन न्यायीपन रईन अनजान होईन, आरू आपनी न्यायीपन स्थापित करनेन यत्न करीन, यहोवा–भगवानन न्यायीपन क हको तळे रहवने सी मना करीया। <verse eid="ROM 10:3"/><verse number="4" style="v" sid="ROM 10:4"/>काहकि हर एक विश्वास करनेवाळान करता न्यायीपन क निमित्त मसीह व्यवस्थान आखरी छे अतरान करीन जु कोय विश्वास राखतु छे, जु यहोवा–भगवानन सही संबंध मा आवतु छे।<verse eid="ROM 10:4"/></para>
  <para style="s">उध्दार सुबन करता</para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5"/>काहकि मुसू यो लिखलु छे कि जु मानुस उको न्यायीपन पर जु व्यवस्था रईनी जुड़नेवावु न्यायीपन छे, चु ओकान वर्णन मुसू ओसो करसे करतु छे, जु कोय व्यवस्थान हुकुम मानता छे। <verse eid="ROM 10:5"/><verse number="6" style="v" sid="ROM 10:6"/>पुन जु न्यायीपन विश्वास से छे, चाँ यो कयती छे, “तु आपना मन मा यो कयनो कि मतलब मसीह उतार लावनेन करता, सोरग पर कुन चढ़से?” <verse eid="ROM 10:6"/><verse number="7" style="v" sid="ROM 10:7"/>“या नरक मा मसीह क उतार लावनेन करता, कुन उतार छे?” मतलब मसीह क मरलाम रईन जीवाड़ीन ऊपर लावनेन करता! <verse eid="ROM 10:7"/><verse number="8" style="v" sid="ROM 10:8"/>पुन शास्त्र काय कये छे? यो कि, “वचन तारे साथे छे, तार मुय मा आरू तारा मन मा छे” यु चुज भुरसान वचन छे, जो हामु प्रचार करता छे, <verse eid="ROM 10:8"/><verse number="9" style="v" sid="ROM 10:9"/>कि यदि तु आपना मुय रईन ईशु क पोरबु जानीन अंगीकर करे आरू आपने मन रईन विश्वास करे, कि यहोवा–भगवान उको मरलाम रईन जीवाड़े, ते तुखे नक्‍कि उध्दार जुड़से। <verse eid="ROM 10:9"/><verse number="10" style="v" sid="ROM 10:10"/>विश्वास करने से आपनु यहोवा–भगवान क साथे सही संबंध मा आवता छे, ते विश्वास करने से खुद मुय करीन कोतारलीन छुटकारो जुड़तो छे। <verse eid="ROM 10:10"/><verse number="11" style="v" sid="ROM 10:11"/>काहकि चुखलो शास्त्र यो कयतो छे, “जु कोय उको पर विश्वास करसे, चु लज्जित नी हुये।” <verse eid="ROM 10:11"/><verse number="12" style="v" sid="ROM 10:12"/>यहूदियों आरू यूनानीयो मा कोय भेद नी, अतरान करीन कि चो सब पोरबुन छे; आरू आपना सब नाम लेनेवावा करता बहुताए से बरकत जुड़से। <verse eid="ROM 10:12"/><verse number="13" style="v" sid="ROM 10:13"/>काहकि शास्त्र कयतु छे, “जु कुन भी पोरबुन मदतन करता नाव लेछे, ओको उध्दार जड़से।” <verse eid="ROM 10:13"/><verse number="14" style="v" sid="ROM 10:14"/>पुन पछु जेका पर उको पर विश्वास नी करे, चाँ ओको न नाव कोसो लेछे? आरू जेको नी सोंबड़ी उको पर कोसो विश्वास करे? आरू प्रचारन बिना कोसो सोंबड़े? <verse eid="ROM 10:14"/><verse number="15" style="v" sid="ROM 10:15"/>आरू यदि संदेश सोंबवनेवावा मकले नी जाए, ते कोसो प्रचार करे? जोसो लिखलो छे, “ओको न पाय काय या सुहावने छे, जु वारली वातन खुश खबर सोंमबाड़े छे।” <verse eid="ROM 10:15"/><verse number="16" style="v" sid="ROM 10:16"/>पुन सब ने खुश खबर पर कान्टा नी लागाड़या, भविष्यवक्तो यशायाह कयतो छे, “हे पोरबु, कुन आपना खबर पर विश्वास करला छे?” <verse eid="ROM 10:16"/><verse number="17" style="v" sid="ROM 10:17"/>अतरान करीन विश्वास संदेश सोंबवने से, आरू सोंबवने मसीहन वचन से हतो छे। <verse eid="ROM 10:17"/><verse number="18" style="v" sid="ROM 10:18"/>पुन हाव कयतु छे, काय ओको नी सोंब्या? सोंब्या ते खरी छे; काहकि लिखलो छे, “ओकान स्वर सुब धरती पर, आरू ओकान वचन जगतन छोर तक पुग गया छे।” <verse eid="ROM 10:18"/><verse number="19" style="v" sid="ROM 10:19"/>पछु हाव कयतु छे, काय इस्त्राएली नी जानता हता? पेहल ते मुसू कयतु छे, “हाव ओकान द्वारा जी लोगहन नी, तुमरे मन मा जलन उगाड़से; हाव एक मुर्ख लोगहन द्वारा तुमूक रिस आपाड़ दिसु।” <verse eid="ROM 10:19"/><verse number="20" style="v" sid="ROM 10:20"/>पछु यशायाह बड़े हियाव साथे कयतु छे, “जु मखे नी देखतो हतु, ओको मखे हासील कर लेदा; आरू जु मोखे पुछता भी नी हता, ओको पर हाव प्रगट होय गयु।” <verse eid="ROM 10:20"/><verse number="21" style="v" sid="ROM 10:21"/>पुन इस्राएल न विषय मा चाँ यो कयता छे, “हाव आखु दाहाड़ु आपना हाथ एक हुकुम नी माननेवावी आरू विवाद करनेवाळी प्रजा तरफ पसारे रये।”<verse eid="ROM 10:21"/></para>
  <chapter eid="ROM 10"/>
  <chapter number="11" style="c" sid="ROM 11"/>
  <para style="s">इस्राएल पर यहोवा–भगवान कि द्या</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">11:1 </char>
      <char style="xt" closed="false">
        <ref loc="PHP 3:5">फिलिप्पियो 3:5</ref>
      </char>
    </note>अतरान करीन हाव कयतु छे, काय यहोवा–भगवान आपनी प्रजा क त्याग देदु? कदी भी नी! हाव भी ते इस्त्राएली छे; अब्राहमन वंश आरू बिन्यामीनन अवळियाद मा छे हुं। <verse eid="ROM 11:1"/><verse number="2" style="v" sid="ROM 11:2"/>यहोवा–भगवान आपनी ओकी प्रजा काजे नी नाकारे, जिनाक उको पेहल छे हिय निवाड़ली; काय तुमू नी जानता, कि चुखलोशास्‍त्र एलियाह क काहनी मा काय कयतु छे, कि जब इस्राएल क विरोध मा यहोवा–भगवान रावन्या करता छे? <verse eid="ROM 11:2"/><verse number="3" style="v" sid="ROM 11:3"/>“हे पोरबु, उको तारो भविष्यवक्ता क मार नाख्या, आरू तारो वेदी क ढा देदा छे; आरू हाव एखलु बच रयु छे, आरू चाँ मखे मारने काजे देख रयु छे।” <verse eid="ROM 11:3"/><verse number="4" style="v" sid="ROM 11:4"/>पुन यहोवा–भगवान से उको काय जवाब जुड़से? “हाव आपना करता सात हजार लोगहन रख छुवड़ा छे जिनाक बाल क ओगव मांडा नी टेकलु छे।” <verse eid="ROM 11:4"/><verse number="5" style="v" sid="ROM 11:5"/>ओसली रीति से इन टेहाव भी, फोकटन दया से नेवाड़ला थुड़ाक मानसे बाकी छे। <verse eid="ROM 11:5"/><verse number="6" style="v" sid="ROM 11:6"/>यदि यो फोकटन दया से होयलो छे, ते पछा काम से नी, नी ते फोकटन दया पछ फोकटन दया नी रवे। <verse eid="ROM 11:6"/><verse number="7" style="v" sid="ROM 11:7"/>पछु परिणाम काय होयलो? यो कि इस्त्राएली ओकान खोज मा हुता, चु ओको नी जुड़यो; पुन नेवाड़ला काजे जुड़यो, आरू शेष मानसे वातड़ो करता गया छे। <verse eid="ROM 11:7"/><verse number="8" style="v" sid="ROM 11:8"/>जोसो लिखलो मा छे, “यहोवा–भगवान उको आजेन दाहाड़े तक भारी नींदन आत्मा मा नाखली छे, आरू ओसला डुवा आपलो जा नी देखे आरू ओसला कान्टा जा नी सोंब्या” <verse eid="ROM 11:8"/><verse number="9" style="v" sid="ROM 11:9"/>आरू दाऊद कयतु छे, “ओको न खानो ओखन करता जाव, आरू फासु, आरू ताकि ठुकर, आरू दण्डन जुड़े। <verse eid="ROM 11:9"/><verse number="10" style="v" sid="ROM 11:10"/>ओको न डुवा पर अन्धारो पड़ जाये ताकि नी देखे, आरू हमेशा ओको वा क झुकाड़ीन राख।” <verse eid="ROM 11:10"/><verse number="11" style="v" sid="ROM 11:11"/>ते हाव कयतु छे काय उको अतरान करीन ठुकर खासे, क पड़ जासे? कदी भी नी पुन उको पड़नेन कारण गैरयहुदीया क उध्दार जोड़से, कि उको जलन होय। <verse eid="ROM 11:11"/><verse number="12" style="v" sid="ROM 11:12"/>यदि ओको पड़नु जगतन करता धन आरू उको घटी गैरयहुदी क करता संपत्तीन कारण होयलो, ते ओको भरपूरी से कतरू बरकत जुड़से।<verse eid="ROM 11:12"/></para>
  <para style="s">गैरयहुदीयान उद्दार</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13"/>हाव तुमूक गैरयहुदीयो छे यी वातु कयतु छे। जब कि हाव गैरयहुदीयो क करता प्रेरित छे, ते हाव आपनी सेवान बढ़ाई करतु छे, <verse eid="ROM 11:13"/><verse number="14" style="v" sid="ROM 11:14"/>ताकि कोसली रीति छे हाव तुमरा घरानो मा जलन पैदा करावीन उको से कोय एकन उध्दार करावु। <verse eid="ROM 11:14"/><verse number="15" style="v" sid="ROM 11:15"/>काहकि जब यदि उको खोज करनो त्याग देनु जगतन मिलापन कारण होयलो, ते काय ओकान मान्य करता जानु मरलाम रईन जीव उठनेन बराबर नी हुयो? <verse eid="ROM 11:15"/><verse number="16" style="v" sid="ROM 11:16"/>जब भेटन पेहल पेड़ा चुखलो ठरसे, ते पूरा कुसनला पिठु भी चुखलो छे; आरू जब मुव चुखलो ठरसे, ते डावखा भी ओसलाज छे। <verse eid="ROM 11:16"/><verse number="17" style="v" sid="ROM 11:17"/>आरू यदि कोय एक दि डाव तुड़ देदा ते, आरू तु जंगली जैतुन होईन ओकामा साट दिया गया, आरू जैतुनन मुवन चिकनाई क भागी होयलु छे, <verse eid="ROM 11:17"/><verse number="18" style="v" sid="ROM 11:18"/>ते डावखा पर डाहळाय नी करनो; आरू यदि तु डाहळाय करे, ते जान ले, कि तु मुव काजे नी पुन मुव तुखे सम्भालती छे। <verse eid="ROM 11:18"/><verse number="19" style="v" sid="ROM 11:19"/>पछु तु कयसे, “डावखा अतरान करीन तुवड़ा गया कि हाव साट जाऊ।” <verse eid="ROM 11:19"/><verse number="20" style="v" sid="ROM 11:20"/>भला, चाँ ते विश्वासन कारण तुवड़ा गया, पुन तु विश्वास छे बवनु रवतु छे अतरान करीन डाहवाळा मा हुये, पुन डर क मानजी, <verse eid="ROM 11:20"/><verse number="21" style="v" sid="ROM 11:21"/>काहकि जब यहोवा–भगवान स्वभाविक डावो काजे नी छुड़ियु ते तुखे भी नी छुड़से। <verse eid="ROM 11:21"/><verse number="22" style="v" sid="ROM 11:22"/>अतरान करीन यहोवा–भगवानन किरपा आरू कड़ाई काजे देख! जा पड़ गया, ओको पर कड़ाई, पुन तुखे पर किरपा, यदि तु ओको मा बवनु रवे, तु भी काटाय जाछे। <verse eid="ROM 11:22"/><verse number="23" style="v" sid="ROM 11:23"/>आरू यहुदि भी विनभुरसा मा नी रवे, ते झाड़का साथे जुड़ाय जासे काहकि यहोवा–भगवान उको पछु जुड़ सकतु छे। <verse eid="ROM 11:23"/><verse number="24" style="v" sid="ROM 11:24"/>काहकि यदि तु उको जैतुन से, जु स्वभाव से जंगली छे, काटाय गयु आरू स्वभावन विरोध वारला जैतुन मा हाव साटाय गयु, ते या स्वभाविक डावे छे, आपना जैतुन मा काँ नी साटाय जाछे।<verse eid="ROM 11:24"/></para>
  <para style="s">सब इस्त्राएलन उध्दार</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25"/>हे भाईस्‍यो, कि ओसो नी हये, कि तु आपने आपसु बुध्दिमान समजे; अतरान करीन हाव नी चाहतु कि तुमू इन भेद रईन अनजान रोवु, कि जेतार तक गैरयहुदी पूरी रीति रईन भरायने नी कर लेय, त्योतार तक इस्त्राएली एक भाग ओसोज वातड़ो रयछे। <verse eid="ROM 11:25"/><verse number="26" style="v" sid="ROM 11:26"/>आरू इन रीति रईन सब इस्राएल काजे उध्दार जड़से; जोसो शास्त्र मा लिखलो छे, “छुड़ावने वावु सिय्योन बयड़ा पर रईन आवसे, आरू अभक्ति याकूब रईन छेठो करावसे; <verse eid="ROM 11:26"/><verse number="27" style="v" sid="ROM 11:27"/>आरू उको साथे मारी वाचा त्योतार होयसे, जब कि हाव उको पापोन काजे दुर कर देसु।” <verse eid="ROM 11:27"/><verse number="28" style="v" sid="ROM 11:28"/>चाँ खुश खबर नी भाव से ते तुमूक करता चाँ यहोवा–भगवानन दुस्मनी छे, पुन नेवाड़ लेदा जानीन भाव से बाबदादा कारण मोंगावा छे। <verse eid="ROM 11:28"/><verse number="29" style="v" sid="ROM 11:29"/>काहकि यहोवा–भगवानन कदी भी नी बदले आपना वरदान से, आरू बुलाहट से कदी भी पछल नी वसर्‍यु छे। <verse eid="ROM 11:29"/><verse number="30" style="v" sid="ROM 11:30"/>काहकि जोसा तुमूक गैरयहुदी पेहल यहोवा–भगवानन हुकुम नी मान्या, पुन हिमी उको हुकुम नी मानने छे तुमूक पर दया होइली; <verse eid="ROM 11:30"/><verse number="31" style="v" sid="ROM 11:31"/>तोसोज यहूदि उको भी हिमी हुकुम नी मान्या, कि तुमूक पर जी दया होइली छे इना करीन ओको पर भी द्या होय। <verse eid="ROM 11:31"/><verse number="32" style="v" sid="ROM 11:32"/>काहकि यहोवा–भगवान सुबक हुकुम नी माननेन कारण बंद करीन मेकजी ताकि चाँ सुब पर दया करे।<verse eid="ROM 11:32"/></para>
  <para style="s">यहोवा–भगवानन बढ़ाई</para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33"/>आहा! यहोवा–भगवानन धन आरू बुध्दि आरू ज्ञान काय यो वातड़ो छे! उको विचार कोसा विछेळीयो, आरू उको मार्ग कोसो अगम छे! <verse eid="ROM 11:33"/><verse number="34" style="v" sid="ROM 11:34"/>शास्त्र मा लिखलो छे, “पोरबु क ओकलन कुन जानसे? आरू उके कुन सलाह आप सकता छे? <verse eid="ROM 11:34"/><verse number="35" style="v" sid="ROM 11:35"/>या यहोवा–भगवान क कुन पेहल उको काहय आपला छे, जेको चु पछु ओको वापस आपे?” <verse eid="ROM 11:35"/><verse number="36" style="v" sid="ROM 11:36"/><note caller="+" style="x"><char style="xo" closed="false">11:36 </char><char style="xt" closed="false"><ref loc="1CO 8:6">1 कुरन्थियो 8:6</ref></char></note>काहकि उको क तरफ छे, आरू उको क द्वारा, आरू ओकान करता सब काय बनावली गय छे; ओकान महिमा युगानयुग होयती रवे। आमेन।<verse eid="ROM 11:36"/></para>
  <chapter eid="ROM 11"/>
  <chapter number="12" style="c" sid="ROM 12"/>
  <para style="s">यहोवा–भगवानन सेवान जीवन</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1"/>अतरान करीन हे भाईहो, हाव तुमू काजे यहोवा–भगवानन द्या फोम करावीन रावन्या करतु छे, कि आपना शरीरक जीवतो, आरू चुखलो, आरू यहोवा–भगवानह भावता करता बलिदान करीन चढ़ाऊ; यी तुमरी आत्मिक सेवा छे। <verse eid="ROM 12:1"/><verse number="2" style="v" sid="ROM 12:2"/>आरू इन संसार क सदृश नी बने; पुन तुमरी बुद्धि क नवलो होय जाने छे तुमरो चाल–चलन भी बदलतो जाये, जिना से यहोवा–भगवान क वारलो, आरू भावती, आरू सिद्ध मरजी पारख से मालुम करता रवु। <verse eid="ROM 12:2"/><verse number="3" style="v" sid="ROM 12:3"/>काहकि हाव उको फुकट दया कारण जो मोखे मिवी छे, तुमू मा रईन हर एक से कयतु छे, कि जोसो समझनु जुवतो, उको बढ़िन कोय भी आपने आपसु मा नी समझे; पुन यहोवा–भगवान हर एक भुरसान परिणामन लारे वाट देदो छे, तोसलीज सुबुध्दि क साथे आपनु काजे समझे। <verse eid="ROM 12:3"/><verse number="4" style="v" sid="ROM 12:4"/><note caller="+" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="1CO 12:12">1 कुरन्थियो 12:12</ref></char></note>काहकि जोसो आपना एक देह मा बैस छे अंग छे, आरू सब अंगोन एक जोसो काम नी; <verse eid="ROM 12:4"/><verse number="5" style="v" sid="ROM 12:5"/>तोसो हामु बैस छे, मसीह मा एक देह होईन आपसो मा एक दिसरान अंग छे। <verse eid="ROM 12:5"/><verse number="6" style="v" sid="ROM 12:6"/><note caller="+" style="x"><char style="xo" closed="false">12:6 </char><char style="xt" closed="false"><ref loc="1CO 12:4-11">1 कुरन्थियो 12:4-11</ref></char></note>आरू जब कि उको फुकट दया लारे जो हामुक आपलो गयो छे, हामुक अलग–अलग वरदान मिवी छे, ते उको भविष्यवाणीन दान मिवी छे, चो विश्वासन परिणामन लारे भविष्यवाणी करे; <verse eid="ROM 12:6"/><verse number="7" style="v" sid="ROM 12:7"/>यदि सेवा करनेन दान मिवी छे, ते सेवा मा लाग रवे; यदि कोय सिकावनेवावा हुयो, ते सिकावनेमा लाग रवे; <verse eid="ROM 12:7"/><verse number="8" style="v" sid="ROM 12:8"/>जु शिक्षा देने वाळा हो, चु शिक्षा देने मा लाग रोवे; दान आपनेवावा पुरे छे दे, जु अगवाय करे, चु जुर छे करे, जो दया करे, चु हर्ष करे। <verse eid="ROM 12:8"/><verse number="9" style="v" sid="ROM 12:9"/>मोंग निष्कपट रोवे; बुराई छे घीन करे; वारला काम मा लाग रोवे। <verse eid="ROM 12:9"/><verse number="10" style="v" sid="ROM 12:10"/>भाईचारे क मोंग छे एक दिसरा रईन स्नेह हावको; परस्पर विजुत करने मा एक दिसरा रईन बढ़ीन चालु <verse eid="ROM 12:10"/><verse number="11" style="v" sid="ROM 12:11"/>कोशिष करने मा उजगाय नी करे; आत्मिक उन्माद मा भरला रोवे; पोरबुन सेवा करता रोवु। <verse eid="ROM 12:11"/><verse number="12" style="v" sid="ROM 12:12"/>आश मा खुश रवु; पीड़ा मा स्थिर रवु; प्रार्थना मा नित्य लागला रवु। <verse eid="ROM 12:12"/><verse number="13" style="v" sid="ROM 12:13"/>चुखलो मानसो काजे जो काय जरूरी हो, तिनामा उको मदत करसु; पाहंनतराय करनेमा लाग रोवु। <verse eid="ROM 12:13"/><verse number="14" style="v" sid="ROM 12:14"/><note caller="+" style="x"><char style="xo" closed="false">12:14 </char><char style="xt" closed="false"><ref loc="MAT 5:44">मत्ती 5:44</ref>; <ref loc="LUK 6:28">लूका 6:28</ref></char></note>आपनु सतावनेवावा काजे बरकत हामु; बरकत हामु स्राप मा देवु। <verse eid="ROM 12:14"/><verse number="15" style="v" sid="ROM 12:15"/>खुशी करनेवाला क साथ खुशी करू, आरू रोड़नेवावा साथे रोडु़। <verse eid="ROM 12:15"/><verse number="16" style="v" sid="ROM 12:16"/>आपसु मा एक जोसो मन राखु; डाहवाळा मा हयो, पुन दाहाड़ा साथे संगति राखु; आपनी दृष्टि मा बुध्दिमान मा हयो। <verse eid="ROM 12:16"/><verse number="17" style="v" sid="ROM 12:17"/>बुराईन बदले कुणीन बुराई मा करू; जी वातु सब मानसो साथे वारली छे, ओकान चिंता कर्‍या करू। <verse eid="ROM 12:17"/><verse number="18" style="v" sid="ROM 12:18"/>जा तक होय सके, तुमूक सब मानसो साथे मेलमिलाप राखु। <verse eid="ROM 12:18"/><verse number="19" style="v" sid="ROM 12:19"/>हे मोंगावु आपनु बदलु नी लेनु; पुन यहोवा–भगवानन रीस काजे मोकु आपनु, काहकि शास्त्र मा लिखलो छे, “बदलु लेनु मारो काम छे, पोरबु कोवतु छे कि हाव बदलाव दिस।” <verse eid="ROM 12:19"/><verse number="20" style="v" sid="ROM 12:20"/>पुन “यदि तेरा दुस्मन भुखलो छे ते उको खानो खावाड़, यदि पीसलो होय, ते उको काजे पानी पिवाड़; काहकि ओसो करने पर चु खुदुज तुखे रईन ओको लाज आवसे।” <verse eid="ROM 12:20"/><verse number="21" style="v" sid="ROM 12:21"/>बुराई से मा हारो, पुन भलाई रईन बुराई काजे जीत लेवु।<verse eid="ROM 12:21"/></para>
  <chapter eid="ROM 12"/>
  <chapter number="13" style="c" sid="ROM 13"/>
  <para style="s">राज्यन हकदार क काम</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1"/>हर एक व्यक्ति शासकीय हको तळे रोवे, काहकि काहलोज हक ओसो नी जो यहोवा–भगवान कि आरू छे नी होय; आरू जु हक छे, चाँ यहोवा–भगवानन ठहरावला छे। <verse eid="ROM 13:1"/><verse number="2" style="v" sid="ROM 13:2"/>एरकरीन जु कुन हकन विरोध करतु छे, चु यहोवा–भगवानन विधिन सामना करतु छे, आरू सामना करनेवावा दण्ड जड़से। <verse eid="ROM 13:2"/><verse number="3" style="v" sid="ROM 13:3"/>काहकि सरदार वारला कामन नी, पुन बुरा कामोन करता बीक क कारण छे; शेवली कावा यदि तु सरदार छे निडर रोवने कोवतु छे, ते वारलो काम कर, आरू ओको रईन छे तारी सराहना होयछे; <verse eid="ROM 13:3"/><verse number="4" style="v" sid="ROM 13:4"/>काहकि चाँ तारी भलाई न करता यहोवा–भगवानन सेवक छे। पुन यदि तु बुराई करसे, ते डर, काहकि चाँ तलवार व्यर्थ लेदा मिदा नी; आरू यहोवा–भगवानन सेवक छे कि ओको रीसन लारे बुरे काम करनेवाला काजे दण्ड आपसु। <verse eid="ROM 13:4"/><verse number="5" style="v" sid="ROM 13:5"/>एरकरीन हको तळे रोवनु नी केवल ओको रीसन डर रईन छाची छे, वरना विवेक भी यी गवाय आपे छे। <verse eid="ROM 13:5"/><verse number="6" style="v" sid="ROM 13:6"/><note caller="+" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="MAT 22:21">मत्ती 22:21</ref>; <ref loc="MRK 12:17">मरकुस 12:17</ref>; <ref loc="LUK 20:25">लूका 20:25</ref></char></note>एरकरीन फाळु भी आपनु, काहकि शासन करनेवावा यहोवा–भगवानन सेवक छे, आरू हमेशा एर काममा लाग रवता छे। <verse eid="ROM 13:6"/><verse number="7" style="v" sid="ROM 13:7"/>एरकरीन हर एकन हक चुकाड़ देदु करू; जिनाक काजे कर जुवे, ओको महसुल जुवछे, ओको फाळु आपो; जिनाक बीक हुयनो जुवे, जेरो विजुत करनो जुवे, ओकान विजुत करू।<verse eid="ROM 13:7"/></para>
  <para style="s">एक–दिसरान हर प्रेम</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8"/>आपसेमा मोंग क छुड़ीन आरू कोसली वात मा कुणीन कर्जदार नी होय; काहकि जु दिसरा साथे प्रेम हावकतु छे, ओको नी व्यवस्था पूरी करलो छे। <verse eid="ROM 13:8"/><verse number="9" style="v" sid="ROM 13:9"/>काहकि यदि कि “व्यभिचार नी करनो, हत्या नी करनो, चुरी नी करनो, लालस नी करनो” आरू इनुक काजे छुड़ीन आरू कोय भी हुकुम मा देखायता जाता छे, “ओका पड़ोसी साथे आपने समान मोंग हावक।” <verse eid="ROM 13:9"/><verse number="10" style="v" sid="ROM 13:10"/>मोंग पड़ोसीन काजे कोय बुराई नी करे, एरकरीन मोंग राखनेन व्यवस्था क पालन करनो छे। <verse eid="ROM 13:10"/><verse number="11" style="v" sid="ROM 13:11"/>टेहाव काजे पेहचानीन ओसोज करू, एरकरीन कि एवी तुमूक करता नींद रईन जाग उठनेन घड़ी आव लागी छे; काहकि कि जीन टेहाव हामु विश्वास करला हुता, तिन टेमन विचार रईन एवी आमरू उध्दार नाट छे। <verse eid="ROM 13:11"/><verse number="12" style="v" sid="ROM 13:12"/>रात बैस जात रयी छे, आरू दाहाडु निकवने पर छे; एरकरीन हामु आंधारला कामोंन त्याग करीन ज्योतिन हथियार बांध ले। <verse eid="ROM 13:12"/><verse number="13" style="v" sid="ROM 13:13"/>जोसो दिसु होभा आपे छे, योसोज हामु सिधी चाल चालु, नी कि लीला–क्रीडा आरू पियक्‍कड़पन मा, नी व्यभिचार आरू लुचपन मा, आरू नी झगड़े आरू किचवाय मा। <verse eid="ROM 13:13"/><verse number="14" style="v" sid="ROM 13:14"/>वरना पोरबु ईशु मसीह काजे पहिन ले, आरू शरीर कि लालुच काजे पूरो करनेन उपाय नी करो।<verse eid="ROM 13:14"/></para>
  <chapter eid="ROM 13"/>
  <chapter number="14" style="c" sid="ROM 14"/>
  <para style="s">एक दिसरा पर दोष मा लागाड़ ़े</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">14:1 </char>
      <char style="xt" closed="false">
        <ref loc="COL 2:16">कुलुस्सियो 2:16</ref>
      </char>
    </note>जु विश्वास मा निर्बल छे, ओको आपसी संगति मा ली लेवु, पुन ओका मतों पर विचार करनेन करता नी। <verse eid="ROM 14:1"/><verse number="2" style="v" sid="ROM 14:2"/>एको काजे विश्वास छे कि सब काय खानु वारू छे, पुन जु विश्वास मा निर्बल छे, साग–पात ही खाता छे। <verse eid="ROM 14:2"/><verse number="3" style="v" sid="ROM 14:3"/>खाने वावु न–खाने वाला काजे तुच्छ नी जाने, आरू न–खाने वावु खाना वाला पर दोष नी लागावे; काहकि यहोवा–भगवान ओको मानीया करलो छे। <verse eid="ROM 14:3"/><verse number="4" style="v" sid="ROM 14:4"/>तु कुण छे जु दिसरान सेवक पर दोष लागाड़ तु छे? ओकान स्थिर रोवनु क गिर पौवनु ओको भगवान ही रईन सम्बन्ध हावकतु चे; वरना चाँ स्थिरूच कर देदो जायछे, काहकि पोरबु ओको स्थिर हावक देदो छे। च <verse eid="ROM 14:4"/><verse number="5" style="v" sid="ROM 14:5"/>कोय ते एक दाहाडु ते दिसरा छे। आरू कोय सब दाहाड़ान एक समान मानता छे। हर एक आपनाच मन मा पाको कर ले। <verse eid="ROM 14:5"/><verse number="6" style="v" sid="ROM 14:6"/>जु एकदा दाहाड़ा काजे मानतु छे, चाँ पोरबुन करता मानता छे। जो खातलु छे, चाँ पोरबुन करता खातु छे, काहकि चाँ यहोवा–भगवानन धन्यवाद करतु छे। <verse eid="ROM 14:6"/><verse number="7" style="v" sid="ROM 14:7"/>काहकि हामु मा रईन नी ते कोय आपने करता जीवतु छे आरू नी कोय आपने करता मरता छे। <verse eid="ROM 14:7"/><verse number="8" style="v" sid="ROM 14:8"/>यदि हामु जीवित छे, ते पोरबुन करता जीवित छे, ते पोरबुन करता मरता छे; शेवली कावा हामु जीवजे या मरें, हामु पोरबुच छे। <verse eid="ROM 14:8"/><verse number="9" style="v" sid="ROM 14:9"/>काहकि मसीह एरकरीन मरलु आरू जीव भी उठलु कि चाँ मरलाम रईन आरू जीवितों दुयोन पोरबु <verse eid="ROM 14:9"/><verse number="10" style="v" sid="ROM 14:10"/><note caller="+" style="x"><char style="xo" closed="false">14:10 </char><char style="xt" closed="false"><ref loc="2CO 5:10">2 कुरन्थियो 5:10</ref></char></note>तु आपसा भाईस पर कोसो दोष लागाड़से? या तु पछु कोसो आपसा भाईस काजे तुच्छ जानतु छे। आपो सब क सब यहोवा–भगवानन नियाव नी गाद्दी सामने उभु होयछे। <verse eid="ROM 14:10"/><verse number="11" style="v" sid="ROM 14:11"/>काहकि लिखलो छे, “पोरबु कोवतु छे, मारा जीवनन सोगुन कि हर एक घुटना मारा सामने टिकछे, आरू हर एक जीभ यहोवा–भगवान काजे अंगीकार करसे।” <verse eid="ROM 14:11"/><verse number="12" style="v" sid="ROM 14:12"/>एरकरीन आपो मा रईन हर एक यहोवा–भगवान काजे आपसा–आपसा लेखो आपसे।<verse eid="ROM 14:12"/></para>
  <para style="s">आपसा भाईसन ठुकर क कारण मा बनु</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13"/>शेवली कावा ओगव हामु एक दिसरा पर दोष नी लागाड़े, पर तुमू यो ठान लेवु कि कोय आपसा भाई क सामने ठुकर खाईन पाप मा पड़नेन कारण मा बने। <verse eid="ROM 14:13"/><verse number="14" style="v" sid="ROM 14:14"/>आरू पोरबु ईशु मा एक होयनेन कारण मोखे मा हाव जानतु छे, कि कोय वस्तु आपने आप रईन विटळ नी, पुन जु ओको विटळ समझतु छे ओका करता विटळ छे। <verse eid="ROM 14:14"/><verse number="15" style="v" sid="ROM 14:15"/>यदि तार भाईस या बोहनीस खानेन कारण नाराज होयतु छे, ते पछु तु मोंग न रीतिन रईन नी चालतु; जेर करता मसीह मरलु, ओको तु आपसा खानेन द्वारा नष्ट नी करे। <verse eid="ROM 14:15"/><verse number="16" style="v" sid="ROM 14:16"/>जिनाक तुमु वारू मानता छे ओका कोय क निन्दा नी कयनो देनु। <verse eid="ROM 14:16"/><verse number="17" style="v" sid="ROM 14:17"/>काहकि यहोवा–भगवानन राज्य खानु–पिनु नी, पुन न्यायीपन आरू हावल–मिलाप आरू चाँ खुशी छे जी चुखलो आत्मा से हुता छे। <verse eid="ROM 14:17"/><verse number="18" style="v" sid="ROM 14:18"/>जु इन रीति रईन मसीहान सेवा करता छे, चाँ यहोवा–भगवान काजे भाता छे आरू मानसो मा मान्य योग्य ठहरता छे। <verse eid="ROM 14:18"/><verse number="19" style="v" sid="ROM 14:19"/>एरकरीन आपो ओको वात मा लाग रोवे जिनाछे हावल–मिलाप आरू एक दिसरान बढ़ती होय। <verse eid="ROM 14:19"/><verse number="20" style="v" sid="ROM 14:20"/>भोजनन करता यहोवा–भगवानन नाव कोसो बिगाड़। सब काय चुखो छे, पुन ओको मानसन करता वात छे जिनाक ओका भोजन छे ठुकर लागती छे। <verse eid="ROM 14:20"/><verse number="21" style="v" sid="ROM 14:21"/>वारू ते यो छे कि तु नी मास खा, आरू नी दारू पी, नी आरू काय ओसलो करे तार विश्वासी भाईस ठुकर खाए। <verse eid="ROM 14:21"/><verse number="22" style="v" sid="ROM 14:22"/>तारू जु विश्वास हुयो, ओको यहोवा–भगवानन सामने आपनाच मन मा हावक। धन्य छे चाँ ओको वात मा, जिनाक चु ठीक समझतु छे, आपने आपसु दोषी नी ठरावतु। <verse eid="ROM 14:22"/><verse number="23" style="v" sid="ROM 14:23"/>पुन जु संका करीन खातु छे चु दण्डन योग्य ठहर त्यो कयो, काहकि चाँ विश्वास छे नी, चु पाप छे।<verse eid="ROM 14:23"/></para>
  <chapter eid="ROM 14"/>
  <chapter number="15" style="c" sid="ROM 15"/>
  <para style="s">दिसरान बढ़ती करू</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1"/>शेवली कावा हामु बलवान क काजे जुवछे कि निर्बलोंन निर्बलताओं क सहें, नि क आपने आपसु खुश करे। <verse eid="ROM 15:1"/><verse number="2" style="v" sid="ROM 15:2"/>हामरेम रईन हर एक पड़ोसी काजे आपसी भलाई न करता खुश करे काहकि हिनरी प्रगती हुयो। <verse eid="ROM 15:2"/><verse number="3" style="v" sid="ROM 15:3"/>काहकि मसीह ने आपनु आपसु खुश नी कर्‍यु, पुन जोसो लिखलो छे: “तार निंदकन निंदा मोखे पर आव पड़ी।” <verse eid="ROM 15:3"/><verse number="4" style="v" sid="ROM 15:4"/>जोतरी वात पेहल लिखली गय, ची आपसी शिक्षान करता लिखली गय छे कि हामरी धीरज आरू चुखलोशास्‍त्रन बढ़ावु द्वारा आश हावकजे। <verse eid="ROM 15:4"/><verse number="5" style="v" sid="ROM 15:5"/>धीरज आरू शांतीन दाता यहोवा–भगवान तुमूक यो वरदान आपे कि मसीह ईशुन लारे आपसु मा एक मन रवु। <verse eid="ROM 15:5"/><verse number="6" style="v" sid="ROM 15:6"/>ताकि तुमूक एक मन आरू एक स्वर मा हामरू पोरबु ईशु मसीहन बास यहोवा–भगवानन बढ़ाई करू।<verse eid="ROM 15:6"/></para>
  <para style="s">सुबन करता खुश खबर</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7"/>एरकरीन, जोसो मसीह यहोवा–भगवानन महिमान करता तुमूक मान्य करतु छे, ओसोज तुमूक भी एक दिसरा काजे मान्य करू। <verse eid="ROM 15:7"/><verse number="8" style="v" sid="ROM 15:8"/>एरकरीन हाव कोवतु छे कि जी प्रतिज्ञाऍ बाबदादा काजे आपी गय होती ओको द्दुढ़ करनेन करता मसीह, यहोवा–भगवानन सच्चाई क प्रमाण आपनेन करता, यहुदि मानसोन सेवक बना: <verse eid="ROM 15:8"/><verse number="9" style="v" sid="ROM 15:9"/>आरू गैरयहुदी भी दयान कारण यहोवा–भगवानन बढ़ाई करे; जोसो लिखलो छे, “एरकरीन हाव जाति–जाति मा तारो धन्यवाद करसु, आरू तार नावन भोजन गावसु।” <verse eid="ROM 15:9"/><verse number="10" style="v" sid="ROM 15:10"/>पछु क छे, “हे गैरयहुदी यो क सुब मानसो, ओका प्रजा क साथे खुशी करो।” <verse eid="ROM 15:10"/><verse number="11" style="v" sid="ROM 15:11"/>आरू पछु, “हे गैरयहुदी यो सुब मानसो, पोरबु कि बढ़ाई करू; आरू हे राज्य राज्यन सब मानसो, ओको सराहो।” <verse eid="ROM 15:11"/><verse number="12" style="v" sid="ROM 15:12"/>आरू पछु यशायाह कोवतु छे, “यिशै कि एक वंश प्रगट होय छे, आरू गैरयहुदी यो क सरदार होयनेन करता एक उठसे, ओको पर आश हावकछे।” <verse eid="ROM 15:12"/><verse number="13" style="v" sid="ROM 15:13"/>यहोवा–भगवान जु आश दाता छे तुमूक विश्वास करने मा सुब भातीन खुशी आरू शांती रईन सब पुरो–करे, कि चुखलो आत्मा की शक्ति रईनी तुमरी आश बढ़ती जाए।<verse eid="ROM 15:13"/></para>
  <para style="s">साहस रईन लिखनेन कारण</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14"/>हे मार भाईसो, हाव खुद तुमरा विषय मा पाको जानता छे कि तु भी आप ही भलाई छे भरे आरू ईश्वरीय ज्ञान छे भरपूर छे, आरू एक दिसरा काजे समझाड़ सकता छे, <verse eid="ROM 15:14"/><verse number="15" style="v" sid="ROM 15:15"/>तेभी हाव भी काहरी–काहरी याद देवाड़नेन करता तुमूक जु घोणा हिंमत करीन लिखा। यो ओको फुकट दया कारण होयलो जो यहोवा–भगवान मोखे आपलो छे, <verse eid="ROM 15:15"/><verse number="16" style="v" sid="ROM 15:16"/>कि हाव गैरयहुदी करता मसीह ईशुन सेवक होईन यहोवा–भगवानन खुश खबर न सेवा पुजारान समान करजे, जिनान गैरयहुदीन मानो चढ़ाया जाना, चुखलो आत्मा रईन चुखलो बनीन मान लेय। <verse eid="ROM 15:16"/><verse number="17" style="v" sid="ROM 15:17"/>एरकरीन ओकान वातन विषय मा जो यहोवा–भगवान छे सम्बन्ध राखती छे, हाव मसीह ईशु मा बढ़ाई कर सकतलु छे। <verse eid="ROM 15:17"/><verse number="18" style="v" sid="ROM 15:18"/>काहकि ओको वात काजे सुड़ीन मोखे आरू कोसली वातन विषय मा कोवने मा साहस नी, जु मसीह गैरयहुदीन हको तळे वचन, आरू काम, <verse eid="ROM 15:18"/><verse number="19" style="v" sid="ROM 15:19"/>आरू सहलानी, आरू विनछळ्यो कामोंन शक्ति रईन, आरू चुखलो आत्मान शक्ति रईन मार द्वारा करला; यो तक कि हाव ने यरूशलेम रईन लिन चार तरफ इल्लुरिकुम तक मसीहन खुश खबर पुरी–पुरी खबर कर्‍या। <verse eid="ROM 15:19"/><verse number="20" style="v" sid="ROM 15:20"/>पर मार मनन मरजी या छे कि जाहरी मसीहन नाव नी लिदा, चा खुश खबर सोंबाडजे ओसो नी होय कि दिसरान नींव पर घर बनावजे। <verse eid="ROM 15:20"/><verse number="21" style="v" sid="ROM 15:21"/>पुन जोसो लिखलो छे तोसोज हुयो, “जिनाक ओका खुश खबर नी पुगी, चाज देखछे आरू जा नी सोंब्या चाज समझसे।”<verse eid="ROM 15:21"/></para>
  <para style="s">रोम जात्रान पौलुसन योजना</para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">15:22 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 1:13">रोमियो 1:13</ref>
      </char>
    </note>अतरान करीन हाव तुमरे जु आवने रईन बार बार रूकलो रोवे। <verse eid="ROM 15:22"/><verse number="23" style="v" sid="ROM 15:23"/>पुन एवी इन देशों मा मार कामन करता आरू जागु नी रोवी, आरू घोणा साल रईन मोखे तुमरे जु आवनेन लालुच छे। <verse eid="ROM 15:23"/><verse number="24" style="v" sid="ROM 15:24"/>एरकरीन जब हाव स्पेन काजे जाईस ते तुमरे साथे होयतुस करे जासु, काहकि मोखे आश छे कि ओको जात्रा मा तुमूक रईन भेंट होयछे, आरू अब तुमरी संगति रईन मारो जी काय भर जाए ते तुमूक मोखे काय दुर अगळ पुगाड़ देजु। <verse eid="ROM 15:24"/><verse number="25" style="v" sid="ROM 15:25"/><note caller="+" style="x"><char style="xo" closed="false">15:25 </char><char style="xt" closed="false"><ref loc="1CO 16:1-4">1 कुरन्थियो 16:1-4</ref></char></note>पुन अब हाव चुखलो मानसो काजे सेवा करनेन करता यरूशलेम मा जातु छे। <verse eid="ROM 15:25"/><verse number="26" style="v" sid="ROM 15:26"/>काहकि मकिदुनिया आरू अखाया न मानसो काजे यो वारलो लागे कि यरूशलेमन चुखलो मानसो मा निर्धनोंन करता काय चन्दा करे। <verse eid="ROM 15:26"/><verse number="27" style="v" sid="ROM 15:27"/>ओको वारलो ते लागे, पुन चाँ ओका कर्जदार भी छे, काहकि यदि गैरयहुदी ओका आत्मिक वातु मा भागी हुए, ते ओको भी वारू छे कि शारीरिक वात मा ओका सेवा करे। <verse eid="ROM 15:27"/><verse number="28" style="v" sid="ROM 15:28"/>एरकरीन हाव यो काम पूरो करीन आरू ओका यो चन्दा सौपिन तुमरे जु होईन स्पेन काजे जाईस। <verse eid="ROM 15:28"/><verse number="29" style="v" sid="ROM 15:29"/>आरू हाव जानतु छे कि जब हाव तुमरे जु आवीस, ते मसीहन पूरी बरकत साथे आवसु। <verse eid="ROM 15:29"/><verse number="30" style="v" sid="ROM 15:30"/>हे भाईहो, आमरू पोरबु ईशु मसीहन आरू चुखलो आत्मान मोंग स्मरण दिला कर हाव तुमू रईन रावन्या करता छे, कि मार करता यहोवा–भगवान रईन प्रार्थना करने मा मारे साथे मिवीन लौलीन रवु <verse eid="ROM 15:30"/><verse number="31" style="v" sid="ROM 15:31"/>कि हाव यहूदियान विनभुरसीया रईन बच रवु, आरू मारो चाँ सेवा जी यरूशलेम न करता छे, चुखलो मानसो काजे स्वीकार हुयो; <verse eid="ROM 15:31"/><verse number="32" style="v" sid="ROM 15:32"/>आरू हाव यहोवा–भगवानन मरजी रईन तुमरे जु खुशी न साथे आवीन तुमरे साथे जु विस्राम पाऊं। <verse eid="ROM 15:32"/><verse number="33" style="v" sid="ROM 15:33"/>शांतीन यहोवा–भगवान तुमू सुबन साथ रोवे। आमेन।<verse eid="ROM 15:33"/></para>
  <chapter eid="ROM 15"/>
  <chapter number="16" style="c" sid="ROM 16"/>
  <para style="s">व्यक्तिगत नमस्कार</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1"/>हाव तार छे फीबेन करता जु हामरी बहिनीस काजे आरू किंख्रिया की मंडळी सेविका छे, रावन्या करता हुं <verse eid="ROM 16:1"/><verse number="2" style="v" sid="ROM 16:2"/>कि तुखे, जोसो कि चुखलो मानसोंकाजे जुवछे, ओको पोरबु मा मान्य करू; आरू जीन कुणीन वात मा ओकान तुमरी जरूरत रोवे, ओकान साहायता करू, काहकि चाँ भी बेसक की वरना मारी भी करलो काम करनेवाली रोवी छे। <verse eid="ROM 16:2"/><verse number="3" style="v" sid="ROM 16:3"/><note caller="+" style="x"><char style="xo" closed="false">16:3 </char><char style="xt" closed="false"><ref loc="ACT 18:2">प्रेरितन 18:2</ref></char></note>प्रिस्किल्ला आरू अक्विला काजे जु मसीह ईशु मा मारा पुठी काम कोरन्या छे, नमस्कार। <verse eid="ROM 16:3"/><verse number="4" style="v" sid="ROM 16:4"/>चाँ मारा जीवन करता आपनोज जीवन जोखिम मा नाक देदा छे; आरू केवल हाव नी, वरना गैरयहुदीन सुब मंडळी भी ओकान धन्यवाद करती छे। <verse eid="ROM 16:4"/><verse number="5" style="v" sid="ROM 16:5"/>ओको मंडळी काजे भी नमस्कार जु ओका घर मा छे। मारा मोंगावु इपैनितुस काजे, जु मसीहन करता आसियान पेहलो फोव छे, नमस्कार। <verse eid="ROM 16:5"/><verse number="6" style="v" sid="ROM 16:6"/>मरियम काजे, जा तुमरे करता बैस मेहनत कर्‍या, नमस्कार। <verse eid="ROM 16:6"/><verse number="7" style="v" sid="ROM 16:7"/>अन्द्रुनीकुस आरू युनियास जा मारा घरानो छे, आरू मार साथ कैद होयला हुता आरू प्रेरितन मा नामी छे, आरू मोखे रईन पेहल मसीह होयला हुता, नमस्कार। <verse eid="ROM 16:7"/><verse number="8" style="v" sid="ROM 16:8"/>अम्पलियातुस काजे, जु पोरबु मा मारू मोंगावु छे, नमस्कार। <verse eid="ROM 16:8"/><verse number="9" style="v" sid="ROM 16:9"/>उरबानुस काजे जु मसीह मा आमरू पुठी काम कोरन्या छे, आरू मारा मोंगावु इस्तखुस काजे नमस्कार। <verse eid="ROM 16:9"/><verse number="10" style="v" sid="ROM 16:10"/>अपिल्लेस काजे जु मसीह मा सचू निकवु, नमस्कार। अरिस्तुबुलुसन घराना काजे नमस्कार। <verse eid="ROM 16:10"/><verse number="11" style="v" sid="ROM 16:11"/>मार घरानो हेरोदियोन काजे नमस्कार। नरकिस्सुसन घरानान जा मानसे पोरबु मा छे, ओका नमस्कार।<verse eid="ROM 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 16:12"/>त्रूफेना आरू त्रूफोसा काजे पोरबु मा मेहनत करती छे, नमस्कार। मोंगावु पिरसिस काजे जु पोरबु मा बैस मेहनत कर्‍या, नमस्कार। <verse eid="ROM 16:12"/><verse number="13" style="v" sid="ROM 16:13"/><note caller="+" style="x"><char style="xo" closed="false">16:13 </char><char style="xt" closed="false"><ref loc="MRK 15:21">मरकुस 15:21</ref></char></note>रूफुस काजे जु पोरबु मा नेवाड़ला छे आरू ओका माता क जु मारी भी छे, दुयो काजे नमस्कार। <verse eid="ROM 16:13"/><verse number="14" style="v" sid="ROM 16:14"/>असुंक्रितुस आरू फिलगोन आरू हिर्मोस आरू पत्रूबास आरू हिर्मास आरू ओको साथ भाईस्यो काजे नमस्कार। <verse eid="ROM 16:14"/><verse number="15" style="v" sid="ROM 16:15"/>फिलुलुगुस आरू युलिया आरू नेर्‍युस आरू ओकी बहिनीस, आरू उलुम्पास आरू ओको साथे सुब चुखलो मानसो काजे नमस्कार। <verse eid="ROM 16:15"/><verse number="16" style="v" sid="ROM 16:16"/>आपसु मा चुखलो चुम्बन छे नमस्कार करू। तुमूक मसीहन सुब मंडळीया रईन भी नमस्कार।<verse eid="ROM 16:16"/></para>
  <para style="s">आखरी निर्देश</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17"/>हिमी हे भाईहो, हाव तुमूक रावन्या करता छे, कि जा मानसे शिक्षान विपरीत, जो तुमूक जुवड़ो छे, फूट नाखनेन आरू ठोकर खावाड़नेन कारण रोवता छे, ओको काजे ताड़ लिदा करू आरू ओको छे छेटा रोवजु। <verse eid="ROM 16:17"/><verse number="18" style="v" sid="ROM 16:18"/>काहकि ओसला मानसे हामरा पोरबु मसीहन नी, पुन ओका पेटन सेवा करता छे; आरू वारली–वारली वातु रईन सीधे–सादे मनन मानसो काजे बड़काव देता छे। <verse eid="ROM 16:18"/><verse number="19" style="v" sid="ROM 16:19"/>तुमरी हुकुम मानने की चर्चा सुब मानसो मा फैल गय छे, एरकरीन हाव तुमरे विषय मा खुशी करतु छे, पुन हाव यो चाहतु छे कि तुमू भलाई न करता बुध्दिमान पुन बुराईन करता भोला बोवना रवु। <verse eid="ROM 16:19"/><verse number="20" style="v" sid="ROM 16:20"/>शांती क यहोवा–भगवान शैतान काजे तुमरे पायो करीन शीघ्र कुचली दे। आपसा पोरबु ईशु मसीह काजे फोकटन दया तुमूक पर हुयती रोवे। <verse eid="ROM 16:20"/><verse number="21" style="v" sid="ROM 16:21"/><note caller="+" style="x"><char style="xo" closed="false">16:21 </char><char style="xt" closed="false"><ref loc="ACT 16:1">प्रेरितन 16:1</ref></char></note>मारा सहकर्मी तीमुथियुस न, आरू मारा घराना लूकियुस आरू यासोन आरू सोसिपत्रुस काजे तुमूक नमस्कार। <verse eid="ROM 16:21"/><verse number="22" style="v" sid="ROM 16:22"/>मोखे पत्री क लिखनेवावा तिरतियुसन, पोरबु मा तुमूक नमस्कार। <verse eid="ROM 16:22"/><verse number="23" style="v" sid="ROM 16:23"/><note caller="+" style="x"><char style="xo" closed="false">16:23 </char><char style="xt" closed="false"><ref loc="ACT 19:29">प्रेरितन 19:29</ref>; <ref loc="1CO 1:14">1 कुरन्थियो 1:14</ref> </char><char style="xt" closed="false"><ref loc="2TI 4:20">2 तीमुथियुस 4:20</ref></char></note>गयुस जी मारी आरू मंडळी पहुनाई करनेवाळु छे, ओकान तुमूक नमस्कार। इरास्तुस जु नगरन भण्डारी छे, आरू भाई क्वारतुस काजे तुमूक नमस्कार। <verse eid="ROM 16:23"/><verse number="24" style="v" sid="ROM 16:24"/>आमरू पोरबु ईशु मसीहन फोकटन दया तुमु पर होयतु रोवे। आमेन।<verse eid="ROM 16:24"/></para>
  <para style="s">यहोवा–भगवानन बढ़ाई</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25"/>हिमी जा तुमू काजे मारा खुश खबर मतलब ईशु मसीहन संदेशन खबरन लारे स्थिर कर सकता छे, ओको भेदन प्रकाशन लारे जा अमरकाय काजे धोपाय रोवला, <verse eid="ROM 16:25"/><verse number="26" style="v" sid="ROM 16:26"/>पुन हिमी प्रगट होईन अमरकाय यहोवा–भगवानन हुकुम रईन भविष्यवक्तान किताब क द्वारा सुब जातियक काजे कोवनु छे कि चाँ विश्वास रईन हुकुम माननेवावा होय जाऍ, <verse eid="ROM 16:26"/><verse number="27" style="v" sid="ROM 16:27"/>ओका एकुत् बुध्दिमान यहोवा–भगवान कि ईशु मसीहन द्वारा युगानयुग महिमा होयती रोवे। आमेन।<verse eid="ROM 16:27"/></para>
  <chapter eid="ROM 16"/>
</usx>
