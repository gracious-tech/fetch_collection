<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">– Dhankavi</book>
  <para style="h">2 यहुन्ना</para>
  <para style="toc3">2 यहुन्ना</para>
  <para style="toc2">2 यहुन्ना</para>
  <para style="toc1">यहुन्ना नी लिखली दिसरी पत्री</para>
  <para style="mt2">यहुन्ना कि लिखी हुई दुसरी पत्री</para>
  <para style="mt1">यहुन्ना नी लिखली दिसरी पत्री</para>
  <para style="imt">परिचय</para>
  <para style="ip">यहुन्ना नी दिसरी पत्री प्रेरित यहुन्ना लिखियो आरू यी किताब ईशु मसीह क जनम क बाद 50 सी 100 साल न वीच मा लिखी गय हुती इनी पत्री क लिखने वाळो यहुन्ना आपसा क लिखने नी कये पुन डाहलो माने। यहुन्ना क कयनेन लारे खुश खबर मा जड़ली चीज क बाराम 2 यहुन्ना न वात आरू चीजो सी मेळ खाय यो ती खास छे की जिनिये रीति सी त्या एक दिसरा सी मोंग राखने मा ईशु क हुकुम पर जुर देवाड़े ओको पाळन आरू मोंग करनो छे। <char style="xt"><ref loc="2JN 1:5-6">1:5-6</ref></char> <char style="xt"><ref loc="JHN 15:9-10">यहुन्ना 15:9-10</ref></char> असो मानीयो जाय कि प्रेरित यहुन्ना ओकी खुश खबर न लिखली किताब यहुन्ना खुश खबर क अनसारे लिखलो छे। आरू इफिसियों मा रयीन यी तीन किताब क लिखियो 1 यहुन्ना 2 यहुन्ना 3 यहुन्ना छे।</para>
  <para style="ip">यहुन्ना इनी पत्री मा सी थुड़ी नेवाड़ली बयणी आरू पोर्‍या क देखाड़ीयो। हुय सके त्यो एक मंडळी क देखाड़तो हय। इनी पत्री क लिखने न मकसद यहुन्ना क यो हुतो कि मंडळी क जुर देवाड़े आरू झुठा मास्तरीया सी चोक चौळीया करे।</para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. यहुन्ना यो देखाड़े कि यी पत्री क करता छे आरू लेने वाळा क धन्यवाद करे। <char style="ior"><ref loc="2JN 1:1-3">1:1-3</ref></char></para>
  <para style="io1">2. मंडळी क जुर देवाड़नो आरू डाहला हुकुम क मानने करीन फोम देवाड़नो। <char style="ior"><ref loc="2JN 1:4-6">1:4-6</ref></char></para>
  <para style="io1">3. हर टेमे झुठा मास्तरीया सी चेतावनी देतो रयो। <char style="ior"><ref loc="2JN 1:7-11">1:7-11</ref></char></para>
  <para style="io1">4. यहुन्ना मंडळी क बधाई आपीन ओकी पत्री क पूरी करे। <char style="ior"><ref loc="2JN 1:12-13">1:12-13</ref></char></para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="s">नमस्कार</para>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />मखे पुढारी कि आरू छे उना त्योनी होयी बायर आरू ओका पोर्‍या क नाव, जिनासे हाव सच्चा मोंग राखता छे,</para>
  <para style="p" vid="2JN 1:1">आरू केवल हाव ही नी वरना वा सब भी मोंग राखता छे जो सच्चाई क जानता छे। <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />वो सच्चाई जो हामु मा स्थिर रवता छे, आरू सर्वदा हामरे साथे अटल रोवछे।<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />यहोवा–भगवान बास आरू बास क पोर्‍या ईशु मसीह कि आरू छे फोकटन दया आरू दया आरू शांती, सच्चाई आरू मोंग सहित हामरे साथे रोवछे।<verse eid="2JN 1:3" /></para>
  <para style="s">सच्चाई आरू मोंग</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />हाव घोणा खुश हुयो कि हावने तारे काही पोर्‍या क उना हुकुम क लारे, जो हामु बास कि आरू छे मिवती होती, सच्चाई पर चालता होया देख्या। <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />हिमी हे बायर, हाव तुखे काही नवलो हुकुम नी, पर वा जो शुरू छे हामरे साथे छे लिखता छे; आरू तुखे छे विनती करता छे कि हामु एक दिसरा छे मोंग राख्यो। <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />आरू मोंग याहा छे कि हामु यहोवा–भगवान की हुकुम क लारे चाल; यो वा हुकुम छे जो तुमू ने शुरू छे सोमवी छे, आरू तुमू इनीये पर चालने भी जूवे।<verse eid="2JN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />काहकि खुप छे ओसो भरमानेवावा जगत मा निकव्या आश छे, जो यो नी मानता कि ईशु मसीह डील मा हईन आयो; भरमानेवावा आरू मसीह विरोधी योही छे। <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />आपने विषय मा चोकचौळीया रयो, कि जो मेहनत हामु ने कर्‍या छे ओको तुमू गवा नी दुय वरना ओको पूरा हर फोव देख्या।<verse eid="2JN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9" />जो काही मसीह कि शिक्षा छे ओगो बढ़तो जातो छे आरू ओकामा बन्या नी रवता, ओका साथे यहोवा–भगवान नी; जो काही ओकी शिक्षा मा स्थिर रयता छे, ओका साथे बास भी छे आरू पोर्‍या भी। <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />यदि काही तुमरे साथे आवे आरू योही शिक्षा नी देय, उको नी तो घर मा आवने दुय आरू नी नमस्कार कर्‍या। <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />काहकि जो काही ओसो जन क नमस्कार करता छे वो ओका बुरे कामो मा सहभागी होयती छे।<verse eid="2JN 1:11" /></para>
  <para style="s">आखरी नमस्कार</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />मखे खुप सी वात तुमू लिखने छे, पर कागद आरू शाही छे लिखने नी जुवता, पर आश छे कि हाव तुमरे साथे आवीस आरू आमने सामने वात चीत करीस, जिनासे तुमरो खुशी पूरो होय।<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />तारी त्योनी होय बहिनीस क पोर्‍या तुखे नमस्कार करता छे।<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>