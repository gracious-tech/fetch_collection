<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LUK" style="id">- Biblica® Open Gbagyi Contemporary Bible (Gbagyi Nyizeyenya Baibwulu: Shekwoyi Ɓədagbma)</book>
