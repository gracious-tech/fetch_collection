<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Biblica® Open Gbagyi Contemporary Bible (Gbagyi Nyizeyenya Baibwulu: Shekwoyi Ɓədagbma)</book>
  <para style="rem">Copyright © 1997, 2025 by Biblica, Inc.</para>
  <para style="h">Yohana</para>
  <para style="toc1">Yohana</para>
  <para style="toc2">Yohana</para>
  <para style="toc3">Yoh</para>
  <para style="mt1">Yohana</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s1">Ɓədagbma ɓə la zè nayi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />Ń ayayaba ɓədagbma ɓə nyi, Ɓədagbma yi ɓə kwnusnu n Shekwoyii nu, jesnu Ɓədagbma yi ɓə zhni Shekwoyi nu. <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />Wo ɓə kwnusnu n Shekwoyii nu ń ayayaba. <verse eid="JHN 1:2" /><verse number="3" style="v" sid="JHN 1:3" />N əwoi nu ń a ɓə zhni anya vnyanya; ntna wo, a to ɓə myi a zhni nyahonyahoi ń a ɓə kwu zhni nyi m. <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />Dna n wo nu n wyewyeyi ɓə nyi, jesnu wyewyeyi yi nu ɓə zhni bwuznagna azanyikwoci nya. <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />Bwuznagna fnu dna n wyegbma, jesnu wyegbma too myi n əkwo əsnugyi m.<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />Əza ɓə nyi ń Shekwoyi ɓə tnu n woi ai yi wo nge Yohana. <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />Wo ɓə ɓe n zhni ɓəgbmiyi nu, wá daɓo tu n bwuznagna yi tukwo, nabai nge dna n wo zokwo nu ń aza vnyanya ɓa myi ɓa ga gaiciya. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />Əwo nu to ɓə zhni bwuznagna n əwohni m; wo ɓə ɓe n ɓwa bwuznagna yi ɓəgbmiyi nu zhni.<verse eid="JHN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 1:9" />Bwuznagna hnihnii n kwo ga zahozahoyi bwuznagna nyi, kwo ɓə gnyi kwoi lo ɓe anyì nu. <verse eid="JHN 1:9" /><verse number="10" style="v" sid="JHN 1:10" />Wo ɓə dna ń anyì, kwo shikwonyi a ɓə zhni anyì n əwoi nu, ama anyì to ɓə kpe wo əye m. <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />Wa ɓe əɓa aba ń ɓa ɓə zhni əwo anya nyi, ama əwo anya to ɓə gwo wo m. <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />Dudulonu əɓa vnyanya ń ɓa ɓə la wo gwo, aza yi ń ɓa ɓə kwu gaiciyaga dna n əwo əye, wa ga ɓa ikwo ɓá kwu zhni Shekwoyi aɓyi; <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />aɓyi ń a to ɓə ma ɓa fyi n nayi zokwo, kwo n zanugbayi ɓəye m, ama a ɓə ma ɓa fyi n Shekwoyi nu.<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />Ɓədagbma kwo ɓə la zè nayi jesnu waa dna n əyi atasni. Yi kwu əwo latu gyewye, latu Nugwnu ɓyigba nya, ń wo ɓə gbmi n Dada aba, n nunui n shebmyashii ɓədo n gaiciyanunuii.<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />(Yohana wa gbmi əɓo tu n əwo tukwo. Wa dnawyi, woi gna, “Əza nu nyi n mi ɓə daɓo tu n əwo tukwo əsa n mi ɓə gna, ‘Əza n wo ɓe lo n əmi avnu nyi, wo du mi lo ntuge wo ɓə gyi n əmi abye.’ ”) <verse eid="JHN 1:15" /><verse number="16" style="v" sid="JHN 1:16" />Dna n əwo shebmyashi nunui nu, n əyi vnyanya yi kwu anabəlika ɓwa kpeaje. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />Ntuge a ɓə ga owa n Mwusa akwnu nu; shebmyashi n gaiciyanunui, ɓa ɓe dna n Yeisu Kirisiti akwnu. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />Əzaho to lo ń wó shni Shekwoyi wyegye m, akpəge Nugwnu ɓyigba gbmanyi, ń wo zhni Shekwoyi nu n əwohni nyi, əwo nu gna wó lo vyivyiwyi n Dadai, əwo nu n kwu Dada wu yi.<verse eid="JHN 1:18" /></para>
  <para style="s1">Yohana batizimazhniyi to zhni Masifu nu m</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />Nsaiye, dəye nu ɓə zhni Yohana ɓəgbmi she Ayahudiyi atukwoda fyi n Urishelima ɓə tnu apirisiti ɓədo n Alevyiyi ɓa lo ɓəə nya wo əɓo əza pya ń wo ɓə zhni. <verse eid="JHN 1:19" /><verse number="20" style="v" sid="JHN 1:20" />Wo to ɓə ná ɓəgbmi əɓo m, ama wa daɓo n əgbei la, “Əmi nu to zhni Kirisiti m.”<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />Ɓa nya wo əɓo, “To, ho zhni nyika nu a?</para>
  <para style="p" vid="JHN 1:21">“Ho zhni Iliya nu?” Wa gna, “Mi to zhni əwo nu m.”</para>
  <para style="p" vid="JHN 1:21">“Əho nu zhni Sheɓəgwognayi?”</para>
  <para style="p" vid="JHN 1:21">Wa dnaɓəgbe, “Aawo.”<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />N kpmasnu ɓa gna, “Ho zhni nyikanu a? Dna yi ɓəgbe ya lo aza ncei ń ɓa tnuyi nyi. Ho da knyiɓei nu tu n əhohni tukwo a?”<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />Yohana wa dnaɓəgbe dna n Ishaya sheɓəgwognayi aɓədagbma, “Əmi nu zhni bəgye n wo dnawyi dna n zhabwikawu, ‘La zokwo tace ga Dagayi.’ ”<verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />Nsayi Afarisiyi ń a ɓə tnu ɓa tnutnu nyi <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />ɓa nya wo əɓo, “To knyiyi nu zhni hoi zhni batizima n ho to zhni Kirisiti nu m, kwo Iliya, kwo Sheɓəgwognayi ma?”<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />Yohana wa dnaɓəgbe, “Mi zhni batizima n nuwnai nu, ama ń əfye atasni əza gnyiagnyi gnyilo ń fye ta kpe wo əye lo m. <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />Əwo nu zhni əza ń wo ɓə ɓe n əmi avnu, əwo abwada abma mi to kwnuce lo ma loya m.”<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />A ɓə zhni aɓo ye vnyanya fyi n Byetani nu n Urudu səpa dəyi aba n Yohana ɓə dna woi zhni batizima nyi.<verse eid="JHN 1:28" /></para>
  <para style="s1">Yohana ɓəgbmi tu n Yeisu tukwo</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />Əfye kwa gyi zhi, Yohana wa gye Yeisu woi ɓe da wo jesnu wa gna, “Fye gye, Shekwoyi Kwugyasnáyi, n wo kwú aleifyi anyì nya ya! <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />Əza nu nyi n mi ɓə da wo əɓo əsa n mi ɓə gna, ‘Əza n wo ɓe lo n mi avnu nyi, wo du mi lo ntuge wo ɓə gyi n əmi abye.’ <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />Mi to ɓə kpe əwo əye n mihnii nu m, ama əɓo n kwo ɓə zhni ma ɓe mii zhni batizima n nuwnai nyi, əkwo nu nge a gbmi wo wu ga Israila.”<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />Nlonu Yohana wa gbmi əɓo ye: “Ma gye Zafnu kwoi shnizhi ɓe n əshemi ngye lukpe, jesnu kwaa kpetu n əwo. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />Njesnu əmi, mi to ɓə kpe wo əye m, ama əza n wo ɓə tnu mi ma zhni batizima n nuwnai nyi, wa gna mi, ‘Əza n ha gye Zafnu kwoi shnizhi ɓe jesnu kwoi kpetu n wo nyi, əwo nu zhni əza ń wo ɓə zhni batizima n Zafnu Gyigyiyi.’ <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />Mi kwu gyewye jesnu mi la ɓəgbmi nge əza ye nu zhni Shekwoyi Əza Knyiknyiyi.”<verse eid="JHN 1:34" /></para>
  <para style="s1">Yohana amwutuyi vyi Yeisu</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />Əfye kwa gyi zhi, Yohana ɓə gnyi n abaayi ɓədo n əwo amwutuyii ngwnu-aba. <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />Shi wo ɓə gye Yeisu woi duya, wa gna, “Fye gyewye, Shekwoyi Kwugyasnáyi wo lo nu!”<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />Shi amwutuyi ngwnu-aba ye ɓə wo woi da ɓəye, ɓa vyi Yeisu. <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />Yeisu wa bmyawye wa gye ɓa ɓai vyi wo, wa nya ɓa əɓo, “Fye ye knyiyi nu a?”</para>
  <para style="p" vid="JHN 1:38">Ɓa gna, “Rabyi” (n kwo nu gyi “Nyawuyi”), “Ho dnalo ń nanu a?”<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />Wa dnaɓəgbe, “Fye ɓe jesnu fye ɓa gyewye” Ntulonu ɓa lo ɓa gye aba n wo ɓə dna. Əsa ɓə gnyi ngye snukna ngwnu-anyi nu n nyipyeii, ntucenu ɓa kwu zo nyipyei yi fyi n kwnusnu n woi.<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />Anduru, Sima Byitusu zado, wo ɓə dna n aza ngwnu-aba ń ɓa ɓə kwu ɓəda wo n Yohana ɓəə kwu da nyi, jesnu n wo ɓə la vyi Yeisu nyi. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />Ənya kpmisnuyi n Anduru ɓə zhni, əkwo nu nge, wa zna əwo ədo shni Sima wa gna wo, “Yi kwu gye Masifu” (n kwo nu gyi, Kirisiti nyi). <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />Jesnu wa ɓe n woi n Yeisu aba.</para>
  <para style="p" vid="JHN 1:42">Yeisu wa shi wo awye wa gna, “Əho nu zhni Sima Yohana nugwnu. A ɓa yi ho ge Kefas” (n a pmyi əkwo nu bma nge Byitusu).<verse eid="JHN 1:42" /></para>
  <para style="s1">Yeisu yi Fyilibwus n Nataninyai</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />Əfye kwa gyi zhi Yeisu wa dnabwugba nge wo ɓa lo Gəlili. She wo ɓə gye Fyilibwus əwye, wa gna wo, “Vyi mi.”<verse eid="JHN 1:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 1:44" />Fyilibwus, Anduru n Byitusui, ɓa ɓə kwnu n Betsaida əzhimi nu. <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />Fyilibwus wa gye Nataninya əwye wa gna wo, “Yi kwu gye əza n Mwusa ɓə kwu anya ka tu n əwo əɓo dna n owa nyi, jesnu əza n sheɓəgwognayi ɓə kwu anya ka tu n əwo ɓo nyi; Yeisu Nazeretiyi, Yusufu nugwnu.”<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />Nataninya wa nyaɓo, “Nazereti! Nyaho manai ɓa gbmiɓe ń ɓo o?” Fyilibwus wa gna, “Ɓe ha gye.”<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />She Yeisu ɓə gye Nataninya əwye woi ɓe, wa gna wo, “Israilayi hnihnii nu nyi, əza n kwocedna to dna n wo m.”<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />Nataninya wa nyaɓo, “Ha kpe mi əye n wuna?”</para>
  <para style="p" vid="JHN 1:48">Yeisu wa dna wo ɓəgbe, “Ma kwu gye ho hoi ye shi n gbaayi shnuwnata to Fyilibwus woi yi ho m.”<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />Nlonu Nataninya wa gna, “Rabyi, ho zhni Shekwoyi Nugwnu nu; əho nu zhni əsu Israila nya.”<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />Yeisu wa gna, “Ho ga gaiciya ntuge ma gna ho ge, ma kwu gye ho shi n gbaayita nu. Ai ho ɓa gye aɓo əwye n ɓa gna adəye dulo.” <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />Wa je ɓəda ɓe, “Ɓəhnihni əmi nu gna ho, ho ɓə gye əshemi n gwuya gnyi, jesnu Shekwoyi amaləka ɓai gwnulo jesnu ɓai shnizhi kpe n Əza Nugwnu.”<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s1">Yeisu la nuwna shnado kwo la zè anamnuwna</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />N nyipyei taayii, a pa amwula n Kana dna n Gəlili. Yeisu əya ɓə nyi ń ɓo, <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />a ɓə kwu amwula ye pa Yeisu ɓədo n əwo amwutuyii ce. <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />She anamnuwna ɓə kwu zo, Yeisu əya wa gna wo, “Anamnuwna kwu ɓa zo.”<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />Yeisu wa dnaɓəgbe, “Nyikwoza, knyiyi nu zhni hoi la mi dna n ɓəye a? Əmi əsa to si kpa m.”<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />Əwo əya wa gna atnutnuyi, “Fye zhni ɓəhoɓəhoi n wa gna fye.”<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />Akwuta-nyikwnu nuwnanya ngwnu-tnanyi ɓə zhi ń wo vyivyiwyi; dəhodəhoi kwoi shi agəluwa shiiba kwoi lo shiita, ado ń Ayahudiyi zhniapma ncei ntu n kwnunu anyazhna ɓo.<verse eid="JHN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 2:7" />Yeisu wa gna atnutnuyi, “Fye nu anyikwnu ye n nuwnai” Ntulonu ɓa kwu anyikwnu yi nu knaaknà.<verse eid="JHN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 2:8" />Nlonu wa gna ɓa, “Nsaiye fye tò kwo fya lo awyefna tukwoda ncei.”</para>
  <para style="p" vid="JHN 2:8">Ɓa kwo tò ɓa lo wo ncei, <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />nlonu awyefna tukwoda wa tó nuwna yi wo n kwo ɓə la shnado kwo la zè anamnuwna nyi. Wo to ɓə kpe aba əye n kwo ɓə gbmi m, kwo shikwonyi atnutnuyi ń ɓa ɓə tó nuwna nyi, ɓa ɓə kpe aba əye n kwo ɓə gbmi. Nlonu wa yì mwulaɓa gnyi n gnagna, <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />wa gna, “Zahozahoyi ga anamnuwna manai nu n abye, jesnu əsa n azhiɓeyi ɓá kwu sni n mwa, wa kpe ɓe n tnadayii; ama əho da ho la manai nu soshi nya nsaiye.”<verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />Ənya n Yeisu ɓə zhni ń Kana dna n Gəlili nyi, əkwo nu ɓə zhni əznù kpmisnui n kwo ɓə gbmi əwo latu wu; jesnu əwo amwutuyi ɓa kwu gaiciyaga fyi n wo.<verse eid="JHN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />N dəye avnu, wa shnilo Kapanam n əwo əyai jesnu n azajei ɓədo n əwo amwutuyii. Ɓa kwu anyipyei ɓwa fyi n ɓo fyewyi.<verse eid="JHN 2:12" /></para>
  <para style="s1">Yeisu nya agnyikwognyiyi ya n Dagayipwuwa ashilagyí</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />She Ayahudiyi Gnanaznu awyefna əsa ɓə la wo vyivyiwyi, Yeisu wa gwnulo Urishelima. <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />Dna n Dagayipwuwa ashilagyí wa gye aza fyi ɓai kwnu anakwo, aknyi, n alukpei, jesnu azaje n sase kpe n agyiwye shnayí atebwul. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />Ntulonu wa pmyi knalufnyi n awnui, wa nya aza ya vnyanya n Dagayipwuwa ashilagyí, aknyi, n anakwoi; waa agyiwye zhnana shnayí gnamyi jesnu wa kwu əɓa atebwul knyianyikwnu. <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />Wa gna aza yi n ɓa ɓə kwnú alukpe nyi, “Fye kwnuya ń ya! Fye to zè əmi Dada pwuwa, agnyikwognyi aba m!” <verse eid="JHN 2:16" /><verse number="17" style="v" sid="JHN 2:17" />Əwo amwutuyi ɓa pa nge a ncei kafyilo: “Wyenyi ntu n əho pwuwa ɓo, əkwo nu ɓa gyi mi tukwo.”<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />Ayahudiyi ɓa dna wo ɓəgbe, “Knyi əznùi nu n ho ɓa wu yi, kwa wu əho ikwo n aɓo ye vnyanya n ho zhni nyi a?”<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />Yeisu wa dna ɓa ɓəgbe, “Mi ɓaa Dagayipwuwa ye myiya, ma mi kwo jesnu dna n anyipyei ngwnu-ata.”<verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />Ɓa dnaɓəgbe, “Kwo ɓə lá aye shinyi-ceitnanyi nu a mi Dagayipwuwa ye, honyi gna ho ɓa mi kwo dna ń anyipyei ngwnu-ata a?” <verse eid="JHN 2:20" /><verse number="21" style="v" sid="JHN 2:21" />Ama Dagayipwuwa n wo ɓə da əkwo ɓo nyi, əwo nayi nu ɓəi. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />Shi a ɓə la wo laka n əfyi, əwo amwutuyi ɓa pa əɓo ɓo n wo ɓəə kwu da. Nlonu ɓa kwu gaiciyaga n nyakagyigyiyi n aɓədagbmai ń Yeisu ɓəə kwu da nyi.<verse eid="JHN 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />Woi ye dna n Urishelima n Gnanaznu Awyefna əsa, bəgyé ɓa gye aznù n wo ɓə gnyi woi zhni nyi, ɓa kwu gaiciyaga fyi n əwo əye. <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />Ama Yeisu to ɓə n əwohni kpema n ɓa m, ntuge wo ɓə kpe aza əye vnyanya. <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />Wo to ɓə n zanyikwoci dəhodəhoi ɓəgbmi apmai m, ntuge wo ɓə kpe ənya əye n kwo ɓə dna n zahozahoyi.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s1">Nikwodimwus gwo nyawu n Yeisu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />Nsayii Farisiyi ho ɓə nyi, ai yi wo nge Nikwodimwus. Wo ɓə dna ń Ayahudiyibwokwnu abegyiyi. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />Wa ɓe Yeisu aba n sukwoi wa gna, “Rabyi, yi kpəlo nge ho zhni nyawuyi nu n wo gbmi n Shekwoyi aba. Ntuge zaho to lo n wo ɓa myi wa zhni aznù ye n ho gnyi hoi zhni nyi m, akpəge Shekwoyii kwnusnu lo n woi.”<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />Yeisu wa dnaɓəgbe, “Ɓəhnihni mi gna ho, əza to lo ń wo ɓə gye Shekwoyi əbemi əwye m, akpəge a la wo shnama.”<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />Nikwodimwus wa nyaɓo, “A ɓa shna əza ma n wunanu woi la kwo a? Ɓəhnihnii wo taa je lodna n əwo əya nubwo a shna wo ma m!”<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />Yeisu wa dnaɓəgbe, “Ɓəhnihni mi gna ho, əza to lo ń wo ɓə lodna ń Shekwoyi əbemi m, akpəge a la wo shnama n nuwnai ɓədo n Zafnui. <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />Nayi ma nayi nu, ama Zafnu nu ma zafnu. <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />Əmi ɓədada əɓo to wo ho m, nge, ‘Ɓəshishi nu a shna ho ma.’ <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />Əse ci lo n əɓwai nu n kwo da kwo. Ho wo əkwo aɓəci, ama ho ta kpe aba n kwo kwnu, kwo aba n kwo lo m. N ɓwasnu nlonu ń əzahozahoyi aba, ń a ma wo dna n Zafnu.”<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />Nikwodimwus wa nyaɓo, “Dəye ɓa yezhni n wuna a?”<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />Yeisu wa gna, “Ho zhni Israila nyawuyi nu, ho nyi to n aɓo ye awyegai lo m?” <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />“Ɓəhnihni mi gna ho gaiciya, yi da əɓo nu n yi kpeye lo, jesnu yii gbmiɓo tu n əɓo nu n yi kwu gyewye, ama dudulonu əfye aza ta gwo əyi ɓəgbmi lo m. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />Mi kwu aɓo da ho n ɓa nyì n anyì, honyi too ga gaiciya m; to, ho ɓa ga gaiciya n wuna, əsa n ma da ho əshemi aɓo a? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />Əza to lo n wo shni lodna n əshemi m, akpəge Əza Nugwnu n wo ɓə gbmiɓe n əshemi nyi. <verse eid="JHN 3:13" /><verse number="14" style="v" sid="JHN 3:14" />N ɓwasnu shi Mwusa ɓə kwu owa gyikpe n kwnuyi ń zhabwikawu, ntulonu kwo zhni ɓəshishi nu ai la Əza Nugwnu gyitu, <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />nabai əzahozahoyi n wa ga gaiciya, n wo ɓa myi wa ɓwa wyewyeyi nyalonyalo nya dna n əwo.”<verse eid="JHN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16" />Ntuge Shekwoyi ɓə ye n anyìi n mwa, kwa zhni wo waa əwo Nugwnu mamai ɓyigba ga, nabai əzadəhodəhoyi n wo ga wo gaiciya, n wo to ɓə ɓwu m, ama woi ɓwa wyewyeyi nyalonyalo nya. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />Ntuge Shekwoyi to ɓə tnu n əwo Nugwnui dna n anyì, wa da anyì owa nu m, ama wa gnyi anyì dna ń əwo. <verse eid="JHN 3:17" /><verse number="18" style="v" sid="JHN 3:18" />Əzadəhodəhoyi n wa ga wo gaiciya, wo to n knyiznui lo m, ama əza n wo to ga wo gaiciya m, a la wo lu knyiznu ntuge wo too ga gaiciya dna n Shekwoyi Nugwnu ɓyigba gbmanyi kəto əye m. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />Dəye nu zhni owaznuya: Bwuznagna kwo la lo ɓe anyì, ama aza gná wyegbma nu ye lo, a fa bwuznagna, ntuge əɓa atnutnu zhni anukwoi nu. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />Əzahozahoyi n wo zhni tnagaiciya, wo zhni bwuznagna nuwnuyi nu, jesnu wo taa lodna n bwuznagna m, ntuge wo wodna nge əwo atnutnu ɓaa kpmiyawu. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />Ama əzadəhodəhoyi n wo gyianyì dna n gaiciyanunui, wo lodna n bwuznagna, nabai n a ɓa gye kwo pəipəi nge əɓo n wo kwu zhni nyi, wa zhni kwo dna n Shekwoyi nu.<verse eid="JHN 3:21" /></para>
  <para style="s1">Yohana gbmiɓo tu n Yeisu tukwo njesnu</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />Ń dəye avnu, Yeisu n əwo amwutuyii ɓa kwnuya ɓa lofyi n Yahudiya əzhigba, aba n wo ɓə la snu əsa dna n kwnusnu n ɓai, jesnu woi zhni ɓa batizima. <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />Nsayii Yohana ɓə dna woi zhni batizima cè, dna n Ayenon, n wo vyivyiwyi n Salimii, ntuge nuwna ɓə fyi n ɓo n mwa, jesnu aza ɓai ɓe ai zhni ɓa Batizima. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />(A to ɓəə dna Yohana n zhalu m.) <verse eid="JHN 3:24" /><verse number="25" style="v" sid="JHN 3:25" />Aɓənakpeaje ɓa laka dna n Yohana amwutuyi atasni n Yahudiyi hoi, ntu anyazhna kwnunu ɓo. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />Ɓa ɓe da Yohana ɓa gna wo, “Rabyi, əza yi n wo ɓə kwnugnyi n hoi n Urudu əkpma dəyi nyi; əza n ho ɓə gbmi wo əɓo nyi; shiawye, wo zhni batizima lo, jesnu əzahozahoyi lo da wo nu.”<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />Yohana wa dnaɓəgbe, “Əza ɓa ɓwa ənya nu gwo n a ga wo n əshemi. <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />Əfye n fyehni, fye ɓa gbmi mi əɓo nge mi kwu gna, ‘Əmi nu to zhni Kirisiti m, ama mi zhni əza nu n a tnu n mii n gyi n əwo abye.’ <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />Mwulanyikwo zhni mwulaɓa nya nu. Mwulaɓa nugwnudo n wo zhni mwulaɓa tnutnu, wo zhni wa pmi jesnu wa kna wo tnubwa, waa nu n agbmadai əsa n wo wó mwulaɓa bəgye. Agbmada yi zhni əmi nya nu, jesnu nsaiye kwo nunui lo. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />Ɓəshishi nu wa gna yaakwo zezè; əmihni ce ɓəshishi nu ma gna gbàgbà.”<verse eid="JHN 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />Əza n wo gbmiɓe n əshe, wo du aza lo vnyanya; əza n wo gbmi n anyì, wo zhni anyì nya nu, jesnu wo daɓo ngye əza nu n wo gbmi n anyì. Əza n wo gbmiɓe n əshemi, wo nu du aza lo vnyanya. <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />Wo gbmi əɓo nu n wo kwu gyewye jesnu woi wo, ama əzaho to lo n wo gwo əwo ɓəgbmi m. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />Əzadəhodəhoyi n wo la kwo gwo, wo lá əɓwa tu nu nge Shekwoyi zhni gaiciyanunuyi nu. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />Ntuge əza n Shekwoyi wo la tnu ncei nyi, wo da Shekwoyi aɓədagbma nu, ntuge Shekwoyi ga wo Zafnu ntna əgnatui. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />Dada ye Nugwnu lo, jesnu wo kwu nyahonyahoi fa fyi n əwo akwnu. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />Əzadəhodəhoyi ń wo ga gaiciya dna n Nugwnu, wo n wyewyeyi nyalonyalo nyai lo, ama əzadəhodəhoyi ń wo na Nugwnu aɓo, wo to ɓə gye wyewyeyi m, ntuge Shekwoyi minagyi napyei kpetu lo ń wo.<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s1">Yeisu daɓo n Samariyayi nyikwoi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />Nsayi kwa kwu lo Yeisu atnubwa nge Afarisiyi ɓa kwu wo nge wo ɓwa aza lo ɓai yeabwi jesnu woi zhni amwutuyi batizima n du Yohana; <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />kwo shikwonyi Yeisu nu to ɓə dna woi zhni batizima m, ama əwo amwutuyi nu. <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />Ntulonu wa fa Yahudiya, wa jezelo Gəlili njesnu.<verse eid="JHN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 4:4" />Nsayii kwaa wo zhni ɓəshishi nu wa duya ń Samariya. <verse eid="JHN 4:4" /><verse number="5" style="v" sid="JHN 4:5" />Ntulonu wa ɓe əzhimi ń a yi kwo nge Sika n dna ń Samariya əknyi, n wo vyivyiwyi n əknyi-gnágnai ń Yakwuɓwu ɓə la ga Yusufu əwo nugwnu. <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />Yakwuɓwu lizhiya ɓə gnyi n abaayi, a ɓəə la Yeisu ɓe ntu n əzna ɓo, waa sase ma lizhiya. Nyipyei ɓə la ga atukwogwnu.<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />She Samariyayi nyikwo ɓə ɓe nuwna to, Yeisu wa gna wo, “Ho ɓa ga mi nuwna ma sni i?” <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />(Əwo amwutuyi ɓə ɓwu n əzhimi ɓəə si nyagyi.)<verse eid="JHN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />Samariyayi nyikwo wa gna wo, “Ho zhni Yahudiyi nu, ma zhni Samariyayi nyikwo. Kwo zè n wunanu hoi nya mi nuwna snisniyi ɓo a?” (Ntuge nyaho to ɓə n Ayahudiyi yeɓədo n Asamariyayi m.)<verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />Yeisu wa dna wo ɓəgbe, “Ho ɓəə gna ho kpe Shekwoyi nyaga əye lo jesnu əza n wo gnyi woi nya ho nuwna snisniyi ɓo nyi, ho ɓəə ɓa nya wo nuwna wyewyeyi nyaɓo, jesnu wo ɓə ɓa ga ho.”<verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />Nyikwoza yi wa gna, “Haamwasa, ho to n nuwna to nyai shilo m, jesnu lizhiya ye n loloi lo. Ho ye ha ɓwa nuwna wyewyeyi nya n nanu a? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />Ho du əyi dada Yakwuɓwu lo nu, n wo ɓə ga yi lizhiya ye jesnu wa kwu kwo sni n əwohni, shi əwo anugwnu n əwo anyakpai ɓə sní ce nyi?”<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />Yeisu wa dnaɓəgbe, “Əzahozahoyi n wa sni nuwna ye, wo ɓa je nuwna myikwnu wo, <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />ama əzadəhodəhoyi n wa sni nuwna n mi ɓa ga wo nyi, wo taa je nuwna myikwnu wo m nanyinanyi. Ɓəhnihni, nuwna n mi ɓa ga wo nyi, kwo ɓə la zè yaɓwo dna n wo, kwoi zhe nuwna wyewyeyi nyalonyalo nya.”<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />Nyikwoza yi wa gna wo, “Haamwasa, ga mi nuwna ye nabai ń mi taa je nuwna myikwnu wo m, jesnu ń mi taa ɓe ya ciici mii to nuwna m.”<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />Wa gna wo, “Lo ho yi əho əɓa ɓə ncei n ya.”<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />Wa dnaɓəgbe, “Mi to n əɓai lo m.”</para>
  <para style="p" vid="JHN 4:17">Yeisu wa gna wo, “Ho kwu gaiciya da, shi ha gna nge ho to n əɓai lo m. <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />Əɓo tukwo nu nyi, ho kwu so anu ngwnu-atnu, jesnu ənu n ho dna n woi nsaiye nyi, wo to zhni əho əɓa nu m. Əɓo n ho ye ɓwa da nyi, kwo zhni gaiciya nu.”<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />Nyikwoza yi wa gna, “Haamwasa, mi kwu gye nge ho zhni sheɓəgwognayi nu. <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />Əyi azakwoi ɓə zhni ɓai ga mwamwa kpe n əpe ye nu, ama əfye Ayahudiyi gna nge, Urishelima nu zhni aba n kwo zhni ɓəshishi ya ga mwamwa.”<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />Yeisu wa dnaɓəgbe, “Nyikwoza, ga mi gaiciya, əsa ɓe lo n fye ɓə ga Dada mwamwa toge kpe n əpe kwo dna n Urishelima m. <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />Əfye Asamariyayi fye ga ənya nu mwamwa n fye ta kpe əkwo əye lo m, ama yi ga ənya nu mwamwa n yi kpeye, ntuge gnyignyi gbmi n Ayahudiyi nu. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />Dudulonu əsa ɓe lo jesnu kwo nsaiye kwo la ɓe, əsa n amwamwagayi agaiciyada ɓa ga Dada mwamwa dna n Zafnu jesnu dna n gaiciyanunui, ntuge amwamwagayi ye pya nu ń Dada znashni. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />Shekwoyi zhni Zafnu nu, jesnu ɓəshishi nu əwo amwamwagayi ɓa ga wo mwamwa dna n Zafnu ɓədo dna n gaiciyanunui.”<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />Nyikwoza yi wa gna, “Mi kpəlo nge Masifu (n a yi Kirisiti nyi) wo ɓe lo. Shi wo ɓə ɓe, wo ɓə kna yi ɓəhoɓəhoi awyeya.”<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />Nlonu Yeisu wa gna wo, “Əmi, n mi gnyi mii daɓo n hoi nyi; əmi nu zhni əwo.”<verse eid="JHN 4:26" /></para>
  <para style="s1">Amwutuyi ɓa zhi da Yeisu</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />N ɓwasnu nsayii, əwo amwutuyi ɓa jezeɓe. Ca wo ɓa shi ɓa ɓə gye wo gnyi woi daɓo n nyikwozai. Ama əzaho to ɓə nyaɓo, “Ho ye knyiyi nu a?” Kwo “Ho da knyiɓei nu n woi a?”<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />Nlonu, nyikwoza yi wa ya əwo nuwnato shakwnu shi, wa jezelo əzhimi wa gna aza, <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />“Fye ɓe, fya gye əza n wo kwu ɓəhoɓəhoi gna mi, n mi kwu shni zhnizhni. Kwo a ɓa gna Kirisiti nu gnyi a?” <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />Ɓa kwnuɓe n əzhimi, ɓa wna zokwo lo əwo aba.<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />Aɓwazhilo əwo amwutuyi ɓa zhni n woi, “Rabyi, gyi nyagyi.”<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />Ama wa gna ɓa, “Mi n nyagyii lo ma gyi ń fye ta kpe əkwo əɓo əye lo m.”<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />Nlonu əwo amwutuyi ɓa daɓo n ajei, “Kwo əzaho la ɓe wo n nyagyii nu a?”<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />Yeisu wa gna, “Əmi nyagyi nu nyi, ma zhni əza ɓəmwi n wa tnu n mii nyi, jesnu ma kwu əwo tnutnu zozhni. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />Fye n ɓədai shiɓwa lo fyei da nge, ‘Apya ye celo ngwnu-anyi a kpe afwanyakwu.’ Mi gna fye, fye kpe əfye awyeya fya shi afwa awye! Ɓa kwu ɓyi jesnu ɓa kwu ye dò. <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />Kwo nsaiye əza n wo dò afwanyakwu wo gwo gyiba jesnu woi dò afwanyakwu ntu n wyewyeyi nyalonyalo nya ɓo, nabai n nyabyeyi n afwanyakwuyii, ɓa ɓə nya agbmada n kwnusnu. <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />Ntulonu ɓəda n a da nyi, kwo la zè gaiciya, ‘Əzaho bye ənya, əzado wa dò.’ <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />Mi ɓə tnu n fyei fya dò, ənya nu n əfye nu to ɓə zhni kwo tnutnu m. Azaje ɓa kwu tnutnu yaakwo zhni, jesnu fye gyi gyiba əɓa tnutnu nya nu.”<verse eid="JHN 4:38" /></para>
  <para style="s1">Asamariyayi bəgyé ga gaiciya</para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />Asamariyayi bəgyé fyi n əzhi yi ɓa kwu gaiciyaga dna n wo, ntu n nyikwoza yi ɓəgbmi ɓo, “Wo kwu ɓəhoɓəhoi gna mi n mi kwu shni zhnizhni.” <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />Ntulonu she Asamariyayi ɓə ɓe da wo, ɓa zhni n woi nabai waa dna n ɓai, nlonu waa dna n ɓai anyipyei ngwnu-aba. <verse eid="JHN 4:40" /><verse number="41" style="v" sid="JHN 4:41" />Jesnu ntu n əwo aɓədagbma ɓo, aza bəgyé ɓa kwu zè agaiciyagayi.<verse eid="JHN 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 4:42" />Ɓa gna nyikwoza yi, “Yi to ye ga gaiciya, n ɓwasnu ntu əɓo ɓo nu n ha gna yi nyi m: nsayi yi kwu wo n əyihnii, jesnu yi kwu kpe ge, əza ye nu kwu anyì Gnyiyi zhni.”<verse eid="JHN 4:42" /></para>
  <para style="s1">Yeisu ga tukwoda ho nugwnu kágna</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />Ń anyipyei aba avnu, wa laka wa lo Gəlili. <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />(Nsayii Yeisu n wohnii wo ɓəə kwu wu nge sheɓəgwognayi to n mwamwai lo dna n əwohni əknyi m.) <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />She wo ɓə lodna n Gəlili, Agəliliyi ɓa gwo wo. Ɓa ɓəə kwu gye aɓo vnyanya n wo ɓəə kwu zhni n Urishelima dna n Gnanaznu awyefna, ntuge ɓa ɓə zhi n abaayi cè.<verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />Njesnu wa lo Kana dna n Gəlili, aba n wo ɓə shna nuwna ədo kwaa zè anamnuwna nyi. Tukwoda ho nugwnu n əbefyè ɓə shi n nyasnai n Kapanam. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />She əza ye ɓə wo nge Yeisu wo la lodna n Gəlili woi gbmi n Yahudiya, wa lo da wo wa ɓà wo nge wo ɓe waa əwo nugwnu kágna, n wo ɓə shi n əfyi əgbe nyi.<verse eid="JHN 4:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 4:48" />Yeisu wa gna wo, “Akpəge fya gye əznù aɓoawowoi nya, fye taa ga gaiciya m nanyinanyi.”<verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />Tukwoda yi əbefyè nya wa gna, “Haamwasa, shnizhi ɓe ya lo, to əmi əɓyii fyi m.”<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />Yeisu wa dnaɓəgbe, “Lo, əho nugwnu ɓa pwo.”</para>
  <para style="p" vid="JHN 4:50">Əza yi wa ga Yeisu ɓədagbma gaiciya, wa laka. <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />Woi ye lo n zokwo, əwo atnutnuyi ɓa shegwnu wo n anabagyii nge, əwo nugwnu wo la kágna ɓwa. <verse eid="JHN 4:51" /><verse number="52" style="v" sid="JHN 4:52" />She wo ɓe nya əsa ɓo n əwo nugwnu ɓə ɓwa kágna ncei, ɓa gna wo, “Nayinapye fai wo nsu nu, snukna gbmanyi n nyipyei.”<verse eid="JHN 4:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 4:53" />Nlonu dada yi wa kpe nge əsa nu cimcim n Yeisu gnai wo, “Əho nugwnu ɓa pwo.” Ntulonu əwo ɓədo n əwo pwuwai vnyanya ɓa kwu gaiciyaga.<verse eid="JHN 4:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54" />Dəye nu ɓə zhni əznù baayi n Yeisu ɓə zhni, shi wo ɓə fa Yahudiya wa lo Gəlili.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s1">Kágna shi n nuwna-znudna aba</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />N dəye avnu, Yeisu wa gwnulo Urishelima ntu n Ayahudiyi awyefna ho ɓo. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />Nsayii, nuwnaznudna ɓə dna n Urishelima n wó vyivyiwyi ń Akwugya Aduba, n a yi n Aramyiyii nge Betsaida ń kwo shekna n azhigwo ashilagyí ngwnu-atnu. <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />N abaye, anyasnayi bəgyé ɓə zhni ɓai zhi n ɓo: awyebwayi, azabmazhi, anayi fyifyiyida [ɓai pmi nuwna-znudna yi kwa bwu. <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />Ntuge Dagayi maləka ɓə zhni woi ɓe n əsa-əsai, wa bwu nuwna-znudna yi. Əza n wa kpmi pita dna n nuwna yi, wa gwo kágna.] <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />Əza ɓə shi n nyasnai n ɓo, woi kwu aye ɓwa shiita-ceinyimwanyimwa. <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />She Yeisu ɓə gye wo ń yashi n abaayi, wa kwu kpe nge əsa kwo la wo mwa shi ɓo dna n azhnìgye ye, wa nya wo əɓo, “Ho ncei pmalo ha ɓwa kágna a?”<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />Əzabmazhi wa dnaɓəgbe, “Haamwasa, mi to n əzai lo n wo ɓa bma mi zhni ma lodna n nuwnaznudna, əsa n nuwna shnashna ncei m. Əsa n mi ye ma lodna, əzaho waa lodna n əmi abye.”<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />Nlonu Yeisu wa gna wo, “Laka gnyiagnyi! Kwu əho apəce, ha znazna.” <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />N əsagbmanyii əza yi wa ɓwa kágna; wa kwu əwo pəce wa znazna.</para>
  <para style="p" vid="JHN 5:9">Əwyi ń wo ɓə ɓwa kágna nyi, Sibyiwyi nu ɓəi, <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />ntulonu Ayahudiyi atukwoda ɓa gna əza n a ɓə ka wo gna nyi, “Sibyiwyi nu gnyi; owa to ncei ye lo ha kwu əho pəce m.”<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />Ama wa dnaɓəgbe, “Əza n wa ka mi gna nyi, əwo nu na gna mi, ‘Kwu əho pəce, ha znazna.’ ”<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />Ntulonu ɓa nya wo əɓo, “Nyika nu n əza yei n wa gna ho nge ho kwu əho pəce ha znazna nyi a?”<verse eid="JHN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13" />Əza yi n wo ɓə gwo kágna nyi, wo to ɓə kpe əza yi əye m, ntuge Yeisu ɓə la lodna n deeji atasni n kwo ɓə zhi n abaayi nyi.<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />Əsa fyewyi Yeisu wa gye wo əwye n dna n Dagayipwuwa wa gna wo, “Gyewye, she ho la lafyiya ɓwa nyi, la fa leifyi zhni ɓo, ntolonu m, ɓənukwoi n du dəye kwa ɓwa ho.” <verse eid="JHN 5:14" /><verse number="15" style="v" sid="JHN 5:15" />Əza ye wa jezelo wa gna Ayahudiyi atukwoda nge, Yeisu nu ɓə ká wo gna.<verse eid="JHN 5:15" /></para>
  <para style="s1">Ikwo Nugwnu nya</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 5:16" />Ntuge Yeisu ɓə gnyi woi zhni aɓo ye n Sibyiwyii nu, Ayahudiyi atukwoda ɓa ya wo wyenashe. <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />Yeisu wa gna ɓa, “Əmi Dada zhni əwo tnutnu lo ciici nya n naiye, əmihni ce, mi zhni tnutnu lo.” <verse eid="JHN 5:17" /><verse number="18" style="v" sid="JHN 5:18" />Ntu n ɓəye ɓo, ɓa gna aɓo znaznashni nu nabai ɓa wu wo; ntuge wo to ɓə ɓwa Sibyiwyi owa nu bmaya m, ama woi yi Shekwoyi nge əwohni Dada, woi zè əwohni nsnu dəidəi n Shekwoyii.<verse eid="JHN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />Yeisu wa dna ɓa ɓəgbe nlai: “Ɓəhnihni mi gna fye, Nugwnu taa myi wa zhni ɓəhoɓəhoi n əwohni tukwoi m; wo ɓa ɓwa myi wa zhni əɓo nu n wa gye əwo Dada woi zhni, ntuge ɓəhoɓəhoi n Dada zhni, Nugwnu zhni əkwo nu cè. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />Ntuge Dada ye Nugwnu lo, woi wu wo ɓəhoɓəhoi n wo zhni. Əə, wo ɓa gwodu wa wu wo atnutnu n ɓa du adəye, nabai ca wo fye. <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />Ntuge n ɓwasnu shi Dada kwú azafyí kala n əfyi, woi ga ɓa wyewyeyi nyi, nlonu n Nugwnu ga zahozahoyi wyewyeyi n kwa da wo, nge wo ga wo. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />Ntuge Dada ta da zaho owa m, ama wo kwu owada vnyanya yafyi n Nugwnu akwnu, <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />nabai aza vnyanya ɓa ga Nugwnu mwamwa ngye shi ɓa ga Dada mwamwa nyi. Əzadəhodəhoyi n wo to ga Nugwnu mwamwa m, wo too ga Dada mwamwa n wo ɓə tnu n woi nyi m.<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />“Ɓəhnihni əmi nu gna fye, əza n wa wo əmi ɓədagbma jesnu waa gaiciyaga n wo, ń wo ɓə tnu n mii nyi, wo n wyewyeyi nyalonyalo nyai lo, jesnu a to ɓə da wo owa m, ama wo la gbmi n əfyi lo wyewyeyi. <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />Ɓəhnihni əmi nu gna fye, əsa ɓe lo jesnu nsaiye kwo la ɓe, əsa n afyífyiyi ɓə wo Shekwoyi Nugwnu bəgye; aza n ɓá wo, ɓa ɓə ɓwa wyewyeyi. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />Ntuge shi Dada n wyewyeyii lo dna n əwohni nyi, nlonu, wo la kwo ga Nugwnu cè wa ɓwa wyewyeyi dna n əwohni. <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />Njesnu wo la ikwo ga wo, wa da owa ntuge əwo nu zhni Əza Nugwnu.<verse eid="JHN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 5:28" />“Dəye to wo fye m, ntuge əsa ɓe lo n aza vnyanya ń ɓa fyilo n əɓa avnyigwo, n ɓa ɓə wo əwo bəgye, <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />jesnu ɓai kwnuɓe; aza yi n ɓa ɓə kwú əɓo manai zhni, ɓa ɓə kwuka ɓa lofyi n wyewyeyi; aza yi n ɓa ɓə zhni əɓo nukwoi, ɓa ɓə kwuka, ai znu ɓa əknyi. <verse eid="JHN 5:29" /><verse number="30" style="v" sid="JHN 5:30" />Əmi n əmihni tukwoi, mi taa myi n ɓəho zhni m; mi ɓwa owa da shi mi wo nu, jesnu əmi owada zhni gaiciya nu, ntuge mi ta zna ɓədá nu shni ga əmihni m, ama əwo n wo ɓə tnu n mii nyi.<verse eid="JHN 5:30" /></para>
  <para style="s1">Ɓəgbmi tu n Yeisu tukwo</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />“Ngye əmi nu gbmi əmihni əɓo, əmi ɓəgbmi to zhni gaiciya nu m. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />Əzado lo n wo gbmi əmi əɓo; mi kpəlo nge əwo ɓəgbmi, tu n əmi tukwo, kwo zhni gaiciya nu.<verse eid="JHN 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 5:33" />“Fye ɓə lá tnutnu tnu lo ncei n Yohana aba, jesnu wo la ɓəgbmi tu n gaiciyanunui tukwo. <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />Kwo to lo nge mi gwo zanyikwoci ɓəgbmi nu m; ama mi sa əkwo əye nabai fya myi fya pwo nu. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />Yohana ɓə zhni pyitila nu, n ənái wna kwoi ga bwuznagna, jesnu fya kwu ye, dna ń əsa fyewyi, fya ɓwa agbmada, əwo bwuznagna nya.<verse eid="JHN 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 5:36" />“Mi n ɓəgbmii lo n du Yohana nya ń shnawo. Ntuge atnutnu ń Dada wo kwu ga mi ma zozhni nyi; atnutnu ń mi gnyi mii zhni nyi, ɓa gbmiɓo lo nge Dada nu naa tnu n mii. <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />Jesnu Dada n wo nu ɓə tnu n mii nyi, əwo n əwohni tukwoi, wo la ɓəgbmi tu n əmi tukwo. Fye too shni əwo bəgye wo kwo fya gye shi wo wu m, <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />ai gna nge əwo ɓədagbma kwa dna n fye m, ntuge fye ta ga gaiciya lo n əza n wo ɓə tnu n woi nyi m. <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />Fye pmi Anyakagyigyiyi n wyenyii ntuge fye zhninubwo nge dna n əkwo nu, n fye ɓa ɓwa wyewyeyi nyalonyalo nya. Anyakagyigyiyi ye nu n kwo nyi, n kwo gbmiɓo tu n əmi tukwo, <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />dudulonu fye la əmi aɓəna, n fye ɓa ɓe əmi aba nabai fya ɓwa wyewyeyi nyi.<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />“Mi ta gwo latu n kwo kwnu n azanyikwoci aba m, <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />ama mi kpe fye əye lo. Mi kpəlo nge fye to n Shekwoyi yeyei fyilo n əfye adu m. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />Mi la ɓe dna n əmi Dada əye, to fyenyi gwo mi m; ama ń əzado gbowo, n wa ɓe dna n əwohni əye, fye ɓa gwo wo. <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />Kwo ɓa yezhni n wunanu, fya ga gaiciya fyei gnyi fyei gwo latu n aje aba, ama to fyei zna latu shni n kwo gbmi n Shekwoyi aba ma a?<verse eid="JHN 5:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 5:45" />“Ama fye to zhninubwo nge, mi ɓa kpe fye aɓo nu n Dada abye m. Əfye ɓətuyi nu zhni Mwusa; n fye n awyetui tu n əwo nu nyi. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />Ngye fye ɓə la gaiciya ga Mwusa, fye ɓa ga mi gaiciya ce, ntuge wo ɓə kwu nyaka ntu n əmi ɓo.<verse eid="JHN 5:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 5:47" />“Ama shikwonyi fye ta ga gaiciya lo əɓo n wo ɓə ka nyi m, fye ɓa ga gaiciya n wuna n əɓo n mi da nyi a?”<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s1">Yeisu ga aza dugwu-atnu nyagyi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />Dna n əsa ho n dəye avnu, Yeisu wa piyalo Gəlili Shikwo əkpma ń kpaai (əkwo nu zhni, Tiberiyas Shikwo), <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />deeji yaakwo kwa vyi wo ntuge ɓa ɓə kwu aznù anyasnayi kágna nya gyewye n wo ɓəə kwu zhni nyi. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />Nlonu Yeisu wa gwnulo əpe waa sasetu n kwnusnu n əwo amwutuyii. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />Ayahudiyi awyefna Gnanaznu nya ɓə la wo vyivyiwyi.<verse eid="JHN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 6:5" />She Yeisu ɓə kpewyewu, wa gye deeji yaakwo kwoi ɓe da wo. Wa gna Fyilibwus, “Yi ɓa si nyagyi n nanu ntu n aza ye ɓo, ɓa gyi a?” <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />Wo ɓə nyaɓo ye nabai wa mwi wo nu, ntuge wo ɓə kpe əɓo əye n wo ɓə ncei dna n bwugba wa zhni.<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />Fyilibwus wa dna wo ɓəgbe, “Kwo ɓa lá gyiwye n du əye tokwnu tnutnu gyiwye ya, ya myi ya si nyagyi kwa kwnu zahozahoyi towo!”<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />Əwo mwutuyi ho, Anduru, Sima Byitusu zado wa daɓo, <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />“Əɓyinugbai ho gnyi nyi n biledi aknanai shi ngwnu-atnu n abmya aɓyii ngwnu-aba, ama kwo ɓa si knyiɓwai nu fyi ń bəgyé ye a?”<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />Yeisu wa gna, “Fye gna aza ɓa kwu sase.” Agbegbe-pwutu ɓə nyi n abaayi, jesnu ɓa kwu sase zhi (azanugbai ngye adugwu ngwnu-atnu nu ɓə zhi n ɓo). <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />Nlonu Yeisu wa kwu biledi aknana yii, wa sa Shekwoyi ami, jesnu wa gná kwo ya ga aza yi n ɓa ɓə sase zhi nyi, shi ɓa ɓə ɓá shni gyi. Wa je abmya gná ya nlonu ga ɓa.<verse eid="JHN 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 6:12" />She ɓa ɓə kwu gyi, nubwo kwa kwu ɓa fwu, wa gna əwo amwutuyi, “Fye ye awyiwoi zhi n ɓa ce nyi. Fye to ye nyaho nge kwo zhniagbma m.” <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />Ntulonu ɓa ye biledi awyiwoi zhi, n aza yi ɓə gyi kwa ce nyi, kwa kwu nu acekwnu ngwnu-awoceaba.<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />Shi aza ɓə gye əznù n Yeisu ɓə zhni nyi, ɓa ya ɓəda, “Ɓəhnihni əza ye nu zhni Sheɓəgwognayi n wo ɓa ɓe dna n anyì nyi.” <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />Yeisu, woi kpe nge ɓa n bwugbai dnalo ɓa dna wo əbe n akalá, wa wyiya lo əpe əwo gbmanyi.<verse eid="JHN 6:15" /></para>
  <para style="s1">Yeisu znazna tu n nuwna</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />She wyeshe ɓə shé, əwo amwutuyi ɓa shnilo nuwna-znudna, <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />aba n ɓa ɓə lofyi n əya nuwnanya ɓa pi nuwna-znudna ya lo Kapanam. N əsayii wyegbma ɓə la dna, to Yeisu woi jezeɓe da ɓa m. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />Əse ɓə gnyi kwoi ci n kalái, nuwna kwaa cenya. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />She ɓa ɓə dna əya ngye amyalu ngwnu-ata kwo ngwnu-anyi, ɓa gye Yeisu woi ɓe da əya nuwnanya, woi znazna tu ń nuwna; ədna kwa wo ɓa, ɓa fyiakwu. <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />Ama wa gna ɓa, “Əmi nu; ədna to wo fye m.” <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />Nlonu ɓa kwu ye ɓa gwo wo dna n əya nuwnanya, n əsagbmanyii əya kwa si nuwnagbe aba n ɓa ɓə lo nyi.<verse eid="JHN 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />Shi əfye ɓə gyi zhi deeji n kwo ɓə zhi n nuwna-znudna əkpma dəyi nyi, kwa kwu kpe nge əya gbmanyi nu ɓə ɓwa ceshi n ɓo, jesnu nge Yeisu to ɓe lo kwo n kwnusnu n əwo amwutuyii m, ama nge ɓa ɓə kwuka ɓahniɓahni nu. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />Nlonu aya nuwnanya ho ɓai kwnu n Tiberiyas ɓa kpezhi vyivyiwyi n abaayii n aza ɓə gyi biledi n Dagayi ɓə sa Shekwoyi ami nyi. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />Shi deeji ɓə kwu kpe nge Yeisu kwo əwo amwutuyi to ɓə zhi n ɓo m, ɓa lofyi n aya nuwnanya ɓa lo Kapanam ɓai zna Yeisu shni.<verse eid="JHN 6:24" /></para>
  <para style="s1">Yeisu nu zhni biledi wyewyeyi nya</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />Shi ɓa ɓə gye wo tu n nuwna-znudna əkpma dəyi, ɓa nya wo əɓo, “Rabyi, ha si n ya n knyisai nu a?”<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />Yeisu wa dnaɓəgbe, “Ɓəhnihni əmi nu gna fye, fye ta zna mi shni, ntuge fye gyei aznù nu n mi zhnii nyi m, ama ntuge fye kwui biledi gyi nu, nubwo kwa kwui fye fu. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />Fye to zhni tnutnu ntu n nyagyi ɓo n kwo wnuya m, ama ntu n nyagyi ɓo n kwo ta wnuya m, n kwo ga wyewyeyi nyalonyalo nya, ədo ń Əza Nugwnu ɓa ga fye nyi. Ntuge n əwo nu n Shekwoyi Dada wo la əwo əznù gwogwoyi əɓwa tu.”<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />Nlonu ɓa nya wo əɓo, “Knyi ɓəshishi nu lo ń yi ɓa zhni, nabai ya zhni atnutnu n Shekwoyi ncei znutu a?”<verse eid="JHN 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29" />Yeisu wa dnaɓəgbe, “Shekwoyi tnutnu nu nyi: fye ga gaiciya n əza n wo la tnu ncei nyi.”<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />Ntulonu ɓa nya wo əɓo, “To, knyi əznùi nu n ho ɓa wu, nabai ya gye kwo jesnu ya ga ho gaiciya a? Knyiɓei nu n ho ɓa zhni a? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />Əyi azakwoi ɓə kwu manna gyi fyi n zhabwikawu; ngye shi a ncei kafyilo: ‘Wa ga ɓa biledi n kwo gbmi n əshemi nyi, ɓá gyi.’ ”<verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />Yeisu wa gna ɓa, “Ɓəhnihni əmi nu gna fye, Mwusa nu to ɓəə ga fye biledi n kwo gbmi n əshemi nyi m, ama əmi Dada nu ga fye biledi gaiciya nya, n kwa gbmi n əshemi nyi. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />Ntuge Shekwoyi biledi zhni nyagyi nu n kwa gbmi shnizhi n əshemi, kwoi ga wyewyeyi dna n anyì.”<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />Ɓa gna, “Haamwasa, zhni ha ga yi biledi ye ciici.”<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />Nlonu Yeisu wa znu ɓəda ya, “Əmi nu zhni biledi wyewyeyi nya. Əzadəhodəhoyi n wa ɓe əmi aba, myikwnu taa je wo gwnu m, kpeekpe, jesnu əzadəhodəhoyi n wa ga gaiciya n mi, nuwna myikwnu taa je wo wo m, nanyinanyi. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />Ama ngye shi mi ɓə gna fye nyi, fye kwu gye mi əwye, dudulonu fye too ga gaiciya m. <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />Aza yi vnyanya ń Dada ga mi, ɓa ɓá ɓe da mi, jesnu əzadəhodəhoyi n wa ɓe da mi, mi taa nya wo ya m, nanyinanyi. <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />Ntuge mi to gbmi shnizhi n əshemi, ma zhni əmihni ɓəye nu m, ama ma zhni əza ɓəye n wo ɓə tnu n mii nyi. <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />Njesnu əza yi ɓəye nu nyi n wa tnu n mii nyi, nabai to ma ɓwu zahozahoyi nuwna n wo kwu ɓa ga mi nyi m, ama mi ɓə kwu ɓa kala, n nyipyei kpmaknayii. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />Ntuge əmi Dada ɓəye nu ge, əzahozahoyi n wo tuwye n Nugwnu nu jesnu woi ga gaiciya dna n wo, wo ɓə ɓwa wyewyeyi nyalonyalo nya; jesnu mi ɓə lá wo kala n nyipyei kpmaknayi.”<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />N ɓəyei, Ayahudiyi ń ɓa ɓə zhi n abaayi, ɓa ya gwunugwunu da tu n əwo tukwo ntuge wo ɓə gna, “Əmi nu zhni biledi n kwa gbmi shnizhi n əshemi.” <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />Ɓa gna, “Yeisu nu to gnyi nyi, Yusufu nugwnu, əza n yi kpe əwo dada əye lo, n əwo əyai m? Kwo ɓa zè n wunanu nsaiye wa gna, ‘Ma gbmi shnizhi n əshemi nu a’?”<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />Yeisu wa dnaɓəgbe, “Fye kwu fa gwnunugwnunu daɓo fyehnifyehni. <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />Zaho to lo ń wo ɓa ɓe da mi m, akpəge Dada ń wo ɓə tnu n mii nyi, wa gnyi wo ɓe ncei, jesnu mi ɓə la wo kala gnyi n nyipyei kpmaknayii. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />A ncei kafyilo dna n Sheɓəgwognayi nyaka: ‘Əɓa vnyanya, Shekwoyi nu ɓəə wu ɓa əwo ɓəda.’ Əzahozahoyi n wo kwu wo n Dada əgbe jesnu wonyi lá tumwi n wo, wo ɓa ɓe da mi. <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />Əzaho too lo n wo shni Dada wyegye m, akpəge əza n wo gbmi n Shekwoyi aba nyi; əwo nu ɓwasnu n wo kwu Dada gyewye. <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />Ɓəhnihni əmi nu gna fye, əza n wo ga gaiciya, wo n wyewyeyi nyalonyalo nyai lo. <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />Əmi nu zhni biledi wyewyeyi nya. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />Əfye azakwoi ɓə kwu manna gyi fyi n zhabwikawu, dudulonu ɓa kwu fyí. <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />Ama biledi nu gnyi nyi, n kwa gbmi shnizhi n əshemi, ədo n zahozahoyi ɓa myi wa gyi to wa fyí m. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />Əmi nu zhni biledi wyewyeyi nya n kwa gbmi shnizhi n əshemi. Əzadəhodəhoyi n wo gyi biledi ye, wo ɓa ɓwa wyewyeyi nyalonyalo. Əmi nayi nu zhni biledi ye, ədo n mi ɓə ga ntu anyì wyewyeyi ɓwa ɓo.”<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />Nlonu Ayahudiyi ɓa ya aɓənakpeaje n əwyei bmyibmyiyi, “Kwo ɓa zè n wunanu əza ye wa ga yi əwo nayi nge yi gyi a?”<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />Yeisu wa gna ɓa, “Ɓəhnihni əmi nu gna fye, akpəge əza wa gyi Əza Nugwnu nayi jesnu waa sni əwo ami, wo too n wyewyeyii dnalo n əwo mi m. <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />Əzadəhodəhoyi n wa gyi əmi nayi, waa sni əmi ami, wo n wyewyeyi nyalonyalo nyai lo jesnu mi ɓə la wo kala n nyipyei kpmaknayii. <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />Ntuge əmi nayi zhni nyagyi hnihnii nu jesnu əmi ami zhni nyasnisnii hnihnii nu. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />Əzadəhodəhoyi n wa gyi əmi nayi jesnu wa sni əmi ami, wo dnalo n əmi, əmihni ce mi dnalo n wo. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />N ɓwasnu shi Dada wyewyeyida ɓə tnu mi tnutnu jesnu minyi gyianyì ntu n Dada ɓo nyi, ntulonu əza n wa gyi əmi nayi, wo ɓa gyianyì ntu n əmi ɓo. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />Dəye nu zhni biledi n kwa gbmi shnizhi n əshemi. Əfye azakwoyi ɓə gyi manna jesnu ɓa kwu fyí, ama əza n wa gyi biledi ye wo ɓa gyianyì nyalonyalo.”<verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />Wo ɓə da ɓəye woi gnyi woi wunya nu dna n Ayahudiyibwokwnu n Kapanam.<verse eid="JHN 6:59" /></para>
  <para style="s1">Amwutuyi bəgyé ɓaa bwusi n Yeisu aba</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />She ɓa ɓə wo ɓəye, əwo amwutuyi n mwa bəgyé ɓa gna, “Nyawu ye dnaɓo lo. Nyikanu ɓa gwo kwo a?”<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />Woi kpe nge əwo amwutuyi da gwnunugwnunu lo tu n ɓəye, Yeisu wa gna ɓa, “Dəye kwo la fye bwu nu? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />Nlonu, ngye fya gna fya gye Əza Nugwnu woi gwnulo aba n wo ɓə shni dna nu ma! <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />Zafnu nu ga wyewyeyi; nayi to n apmai m. Aɓədagbma n mi kwu gna fye nyi; ɓa nunui lo n Zafnui jesnu n wyewyeyii. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />Dudulonu azaho lo n fye, n ɓa too n gaiciyai ga lo m.” Ntuge Yeisu ɓə kpe, n aɓoyaba, əza n ɓa, n wo to n gaiciyai ga lo m, jesnu n əzai n wo ɓa ɓwu wo. <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />Wa gwodu wa gna, “Dəye nu zhni mii gna fye nge zahozahoyi to lo n wo ɓa ɓe da mi m, akpəge n Dada wa bma wo zhnii.”<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />Ənya n kwo laka nsayii, əwo amwutuyi bəgyé ɓa pmyiavnu wu wo, to ɓa je wo vyii m.<verse eid="JHN 6:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="JHN 6:67" />Yeisu wa nya Awoceaba yi, “Fye to ncei pmalo fya fa əmi vyi ɓo m, kwo fye ɓa lo ce a?”<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />Sima Byitusu wa dna wo ɓəgbe, “Dagayi, ya lo da nyika a? Əho nu n aɓədagbma wyewyeyi nyalonyalo nyai lo. <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />Nsaiye yi kwu gaiciyaga, jesnu yi kpəlo nge əho nu zhni Gyigyiyi Shekwoyi nya.”<verse eid="JHN 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70" />Nsayi Yeisu wa dnaɓəgbe, “Əmi nu to ɓə knyí fye, əfye Awoceaba m? Dudulonu zagbmanyi n fye, wo zhni Shetam nu!”<verse eid="JHN 6:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="JHN 6:71" />(Wo ɓə da Yahuda nu ɓo, Sima Iskariyoti nugwnu, əza, kwo shikwonyi wo ɓə zhni gbmanyi nu n Awoceaba yi, əwo nu ɓə ye wa ɓwu wo.)<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s1">Yeisu lo Dagayilubwi awyefnaba.</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />N dəye avnu, Yeisu wa zna laɓa dna n Gəlili. Wo to ɓə ye wa zna laɓa dna n Yahudiya m, ntuge Ayahudiyi atukwoda n əknyi yi, ɓə zhi ɓai zna zokwo shni ɓa wu wo. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />Nsayii shi əsa Alubwikpe Awyefna Yahudiyi nya ɓə la wo vyivyiwyi,<verse eid="JHN 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 7:3" />Yeisu amaje ɓa gna wo, “Fa Gəlili ha lo Yahudiya, nabai n əho amwutuyi n ɓa fyilo n abaayi ɓə gye atnutnu n ho zhni nyi. <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />Əza to lo n wo ye a kpe wo əye, n wo zhni aɓo n ɓwuɓwu m. Shikwonyi ho zhni aɓo ye lo nyi, lo ho kwu əhohni wu n anyì.” <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />Ntuge kwo əwo amaje to ɓə n gaiciyai ga n wo m.<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />Ntucenu Yeisu wa gna ɓa, “Əmi əsa too si kpa m; ama n əfye aba əsahosahoi n fyei bmyabmyalo. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />Anyì taa wnunu n fyei m, ama kwo wnunu lo n mii, ntuge mi gbmiɓo nge əkwo atnutnu zhni anukwoi nu. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />Əfye, fye lo awyefnaba. Mi ta lo awyefnaba yi lo m, ntuge əmi əsa too zo nu m.” <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />She wo ɓə la pwo ɓəda ye daɓo, waa dna n Gəlili.<verse eid="JHN 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />Shi əwo amaje ɓə kwu lo awyefnaba, waa lo ce, toge pəipəi m, ama n ɓwuɓwu. <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />Nsayi ń awyefnaba Ayahudiyi atukwoda ɓə zhi ɓai zna wo shni jesnu ɓa nyaɓo, “Wo gnyi ń na a?”<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />Aɓəsnaanya da ɓə la lapwi laɓa fyi n deeji ntu n əwo ɓo. Azaho gna, “Wo zhni əza manai nu.”</para>
  <para style="p" vid="JHN 7:12">Azaje ɓa dnaɓəgbe, “Aawo, wo fyi aza kwoce nu.” <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />Ama zahozahoyi to ɓə da ɓəhoɓəhoi pəipəi tu n əwo tukwo m, ntuge aza ɓə wo atukwoda ədna.<verse eid="JHN 7:13" /></para>
  <para style="s1">Yeisu wunya gnyi n awyefnaba</para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />Yeisu ɓə fa awyefna, ɓaa du ajegna ya, wa kpe Dagayipwuwa ashilagyí lo wa ya nyawu. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />Ca wo Ayahudiyi n ɓa ɓə fyi n abaayi nyi jesnu ɓa nyaɓo, “Əza ye wa ɓwa ɓəyekpe ye pya n wunanu, to woi ɓwa nyawu m ma a?”<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />Yeisu wa dnaɓəgbe, “Əmi nyawu to zhni əmi nya nu m, kwo gbmi n əza aba nu n wo ɓə tnu n mii nyi. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />Zahozahoyi n wa knyí wa zhni Shekwoyi ɓəmwi, wo ɓa kpe kwo əmi nyawu gbmi n Shekwoyi aba nu, kwo mi da əmihni ɓəda nu. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />Əza n wa da əwohni ɓəda, wo da kwo nabai wa ɓwa əwohni latu nu, ama əza n wo zna əza yi latu shni n wa tnu n woi nyi, wo zhni əza gaiciyanunui da nu; kwocedna dəhodəhoi to dnalo n wo m. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />Mwusa to ɓə la owa ga fye m? Dudulonu zaho to lo n fye n wo shi owa ɓwa lo m. Knyiyi nu zhni fyenyi ncei pma fya wu mi a?”<verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />Deeji kwa dnaɓəgbe, “Ho nunui lo n asei. Nyika nu pma wa wu ho a?”<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />Yeisu wa gna ɓa, “Ma zhni tuzè gbmanyi, əfye vnyanya fyenyi zhi n ɓəwowoi. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />Dudulonu, ntuge Mwusa ɓə ga fye nyaznu (kwo shikwonyi kwo to ɓə gbmi n Mwusa nu m, ama ń adada-azakwoi), fye znu əɓyinugbai ənya n Sibyiwyii. <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />Nsaiye ngye a ɓaa əɓyinugbai znunya n Sibyiwyii nabai to a znu Mwusa owa gna m, knyiyi nu zhni fyei gyi minagyi n mii, ntuge mi la əza nayi vnyanya kágna n Sibyiwyii a? <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />Fyè kwu fa owada ɓo ń əza awyesa, ama n əkwoɓwi, fyè da owa n cefyé.”<verse eid="JHN 7:24" /></para>
  <para style="s1">Ajegna ntu əza pya ɓo n Yeisu zhni</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />Nsayii dna n Urishelima azaho ɓa ya ɓənya, “Əza ye nu to gnyi nyi n aza ye ɓa wu wo nyi m? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />Wo gnyi nyi ń ya, woi daɓo n aza awye, jesnu ɓa ta da ɓədagbma ho lo n woi m. Atukwoda ɓa la əɓo znuya nu nge əwo nu zhni Kirisiti? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />Ama yi kpe aba əye lo n əza ye gbmi; əsa n Kirisiti ɓəə ɓe ncei, əzaho to ɓə kpe aba əye n wo gbmi m.”<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />Nlonu Yeisu, wo ye dna woi wunya n Dagayipwuwa ashilagyí, wa sáwyi, “Əə, fye kpe mi əye lo jesnu aba n mi gbmi. Mi to gnyi n ya n əmihni ikwoi nu m, ama əza ń wo ɓə tnu n mii nyi, wo zhni gaiciyada nu. Fye ta kpe əwo əye lo m, <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />ama mi kpe əwo əye lo ntuge mi gbmiɓe n əwo aba nu, əwo nu ɓə tnu n mii.”<verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />Ntu dəye ɓo, ɓa ye ɓa wna wo, ama zahozahoyi to ɓə wna wo m, ntuge əwo əsa to ɓə si kpa m. <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />Dudulonu, bəgyé fyi n deeji ɓə kwu gaiciyai ga n wo. Ɓa gna, “Əsa n Kirisiti ɓə ɓe ncei, wo ɓə zhni aznù n du əza ye?”<verse eid="JHN 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />Afarisiyi ɓa wo deeji kwoi da aɓəsnaanya da ye pya ntu n wo ɓo. Nlonu apirisiti tukwoda ɓədo n Afarisiyii ɓa tnu Dagayipwuwa abagwuyi nge ɓa wna wo.<verse eid="JHN 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 7:33" />Yeisu wa gna, “Mi ɓwa kwnugnyi n fyei əsa fyewyi nu, nlonu mii jezelo da əza n wo ɓə tnu n mii nyi. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />Fye ɓə zna mi shni, ama fye to ɓə gye mi əwye m; jesnu aba n mi dna nyi, fye taa myi fya ɓe m.”<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />Ayahudiyi ɓa gna aje, “Əza ye ncei pma wa lo ń nanu, ń yi taa gye wo əwye m ma? Wo ye wa lo əyi aza nyawu nu n ɓa gnamyi fyilo n Agirikiyi atasni nyii? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />Wo ɓə zhni knyiɓei nu nubwo əsa n wo ɓə gna, ‘Fye ɓə zna mi shni, ama fye to ɓə gye mi əwye m,’ jesnu ‘Aba n mi dna nyi, fye taa myi fya ɓe m’?”<verse eid="JHN 7:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />Ń awyefna nyipyei kpmasnuii, nyipyei yaakwo duduyi awyefna nya, Yeisu wa laka gnyi wa daɓo n bəgyei lawu, “Fa zahozahoyi ń nuwna myikwnu wó wo lo, wa ɓe əmi aba jesnu wa sni. <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />Əzadəhodəhoyi n wa ga gaiciya dna n mi, ngye shi Nyakagyigyiyi ncei da lo; àlà nuwna wyewyeyi nya ɓa zhe n əwo əmi.” <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />Wo ɓə gnyi woi daɓo ntu n Zafnu ɓo nu, n a ɓə ye a ga aza yi n ɓa kwu gaiciyaga fyi n wo nyi. Nya əsa yi, a to ɓə ga Zafnu m, shikwonyi a to ɓəə lá Yeisu tu kpa m.<verse eid="JHN 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />She ɓa ɓə wo əwo aɓədagbma, azaho ɓa gna, “Ɓəhnihnii əza ye zhni Sheɓəgwognayi nu.”<verse eid="JHN 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41" />Azaje ɓa gna, “Wo zhni Kirisiti nu.”</para>
  <para style="p" vid="JHN 7:41">Aza ho ɓa dudu ɓa nyaɓo, “Kwo ɓa zè n wunanu Kirisiti wa gbmiɓe n Gəlili a? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />Nyakagyigyiyi to gna nge Kirisiti ɓə gbmi n Dawuda əfye nu, jesnu woi gbmi n Baitalamyi, əzhi n Dawuda ɓə dna nyi m?” <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />Dəye kwa zhni aza ɓaa gnaje ntu n Yeisu ɓo. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />Azaho ɓə ncei pma ɓa wna wo, ama zahozahoyi to ɓə to wo əɓwa m.<verse eid="JHN 7:44" /></para>
  <para style="s1">Ayahudiyi atukwoda tna-gaiciyaga</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />N kpmasnu Dagayipwuwa abagwuyi ɓa jezelo da apirisiti atukwoda n Afarisiyii, ɓa nya ɓa əɓo, “Knyiyi nu naa zhni to fyenyi wna wo ɓe ncei m ma?”<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />Abagwuyii ɓa dnaɓəgbe, “Əza to lo n wo kwu ɓəda shnida, ngye shi əza ye da lo nyi m.”<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />Afarisiyi ɓa dnaɓəgbe, “Fye gna nge wo la fye dnakwoce nu cè? <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />Əzaho lo ń abegyiyi kwo ń Afarisiyi n wo la gaiciyaga n wo? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />Aawo! Akpəge agyikicizhniyi ye n ɓa ta kpe owa əye lo nyi m; knyìtu, n tu lo ń ɓa.”<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />Nikwodimwus, n wo ɓə la lo da Yeisu n shnisnu nyi, jesnu ń wo ɓə dna ń əɓa okwu nyi, wa nyaɓo,<verse eid="JHN 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 7:51" />“Əyi owa znu əza əknyi to ai wo əwo ɓəda kpa kwo a kpe ənya əye n wo zhni m?”<verse eid="JHN 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52" />Ɓa dnaɓəgbe, “Ho gbmi n Gəlili nu cee? Dna owa əwye, jesnu ho ɓa gye nge sheɓəgwognayi too lo woi gbmi n Gəlili m.”</para>
  <para style="p" vid="JHN 7:52">[<verse eid="JHN 7:52" /><verse number="53" style="v" sid="JHN 7:53" />Nlonu əɓa vnyanya, ɓa lo apyi.<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="nb">
    <verse number="1" style="v" sid="JHN 8:1" />Ama Yeisu wa gwnutu lo Zaitu Əpe.<verse eid="JHN 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 8:2" />Njesnu n labmii wa kpeyagnyi dna n Dagayipwuwa ashilagyí aba ń aza vnyanya ɓə shekna wo; wa sasetu wa wunya. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />Owa anyawuyii n Afarisiyii, ɓa ɓe n nyikwoza hoi n a ɓə wna wo dna n anagbái. Ɓaa wo gnyiagnyi gnyi n deeji abye <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />ɓa gna Yeisu, “Nyawuyi, a wna nyikwo ye dna woi zhni anagbái nu. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />Dna n Owa, Mwusa ɓə la əgbe ga yi, nge a knyi nyikwo ye pya akwuta. Nsaiye ho gna nge nanu a?” <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />Ɓa ɓə zhni apma n ɓənya yei ngye agbúlu nu, nabai ɓa ɓwa əɓo n ɓa ɓá tu wo.</para>
  <para style="p" vid="JHN 8:6">Ama Yeisu wa yakwnu wa ya nyaka zhi n əknyi n əwo ɓwanyii. <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />Shi ɓa ɓə gwodu n wo aɓənyai, wa kpebye gnyi wa gna ɓa, “Fa əzaho n fye atasni, n wo to n leifyii lo m, waa zhni əza kpmisnuii, ń wo ɓá she wo kwuta.” <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />Njesnu wa je yakwnu wa ka ənya zhi n əknyi.<verse eid="JHN 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 8:9" />N dəyei, aza yi n ɓa ɓə kwu əɓoi wo, ɓa ya gaya gbmanyigbmanyi, azakwoi nu ɓə kpmi kwuka, nya əsa n Yeisu nu ɓə ɓwa cegnyi ɓədo ń nyikwoza yii, n ye gnyiagnyi gnyi ń ɓo. <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />Yeisu wa kpebye gnyi wa nya wo əɓo, “Nyikwoza, ɓa zhi ń na a? Zahozahoyi too znu ho əknyi m?”<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />Wa gna “Haamwasa, zaho too znu mi əknyi m.” Yeisu wa gna, “Nlonu, əmihni ce taa znu ho əknyi m. Lo ho nya haa fa leifyizhni ɓo.”]<verse eid="JHN 8:11" /></para>
  <para style="s1">Aɓənakpeaje ntu Yeisu ɓəgbmi ɓo</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />She Yeisu ɓə je ɓəda n azai, wa gna, “Əmi nu zhni bwuznagna anyì nya. Əza n wa vyi mi, wo taa znazna dna n wyegbma m, nanyinanyi, ama wo ɓa ɓwa bwuznagna wyewyeyi nya.”<verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />Afarisiyi ɓa ce wo əɓo, “Ho gnyi nyi, hoi gbmi əhohni əɓo; əho ɓəgbmi to wnashi lo m.”<verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />Yeisu wa dnaɓəgbe, “Kwo n ma gbmi əmihni əɓo, əmi ɓəgbmi wnashi lo, ntuge mi kpe aba əye lo n ma gbmi jesnu aba n mi lo. Ama fye to n awyegai lo aba n ma gbmi kwo aba n mi lo m. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />Fye da owa n zanyikwoci aɓəknawnai nu; mi ta da zahozahoyi owa m. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />Ama kwo n ma da owa, əmi ɓəznu zhni gaiciya nu, ntuge mi to gnyi n əmi gbmanyi nu m. Mi kwnugnyi ɓədo n Dadai nu, əwo n wo ɓə tnu ń mii nyi. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />Dna n əfye Owa, a cei kafyilo nge ɓəgbmi aza ngwnu-aba nya, kwo zhni gaiciya nu. <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />Əmi nu zhni əmihni ɓəgbmiyi; əmi Dada n wo ɓə tnu n əmii nyi, əwo nu zhni əmi ɓəgbmiyi baayi.”<verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />Nlonu ɓa nya wo əɓo, “Əho Dada gnyi ń nanu a?”</para>
  <para style="p" vid="JHN 8:19">Yeisu wa dnaɓəgbe, “Fye ta kpe mi əye lo kwo əmi Dada m. Fye ɓə gna fye kpé mi əye lo, fye ye kpé əmi Dada əye lo ce.” <verse eid="JHN 8:19" /><verse number="20" style="v" sid="JHN 8:20" />Wo ɓə da aɓo ye woi ye gnyi woi wunya nu dna n Dagayipwuwa ashilagyí, n wo vyivyiwyi n anyaga yafyi abai. Dudulonu to zaho wa wna wo m, ntuge əwo əsa to ɓə si kpa m.<verse eid="JHN 8:20" /></para>
  <para style="s1">Aɓənakpeaje ntu əza pya ɓo n Yeisu zhni</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />Njesnu Yeisu wa je ɓa gna, “Mi laka nu mii lo, fye ɓə zna mi shni, jesnu fye ɓə kwu fyí, fyi n əfye aleifyi. Aba n mi lo nyi, fye taa myi fya ɓe ɓo m.”<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />Dəye kwa zhni Ayahudiyi ɓa nyaɓo, “Wo ye wa wu əwohni nu u? Əcenu zhni woi gna, ‘Aba n mi lo nyi, fye taa myi fya ɓe n ɓo m’?”<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />Ama wa gwodu, “Fye kwnu ń əknyi nu; mi gbmi ń əshe nu. Fye zhni anyì ye nya nu; mi to zhni anyì ye nya nu m. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />Mi kwu gna fye nge fye ɓa kwu fyí, fyi n əfye aleifyi; ń fye to ga gaiciya nge əmi nu zhni əwo m, fye ɓa kwu fyí, fyi n əfye aleifyi.”<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />Ɓa nyaɓo, “Ho zhni nyika nu a?”</para>
  <para style="p" vid="JHN 8:25">Yeisu wa dnaɓəgbe, “N ɓwasnu shi mi gna fye lo ciici, ənya n kwo ɓə ya ń ayayaba nyi. <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />Mi n aɓoi lo n mwa bəgyé ma da dna n əfye owada. Ama əza n wo ɓə tnu n mii nyi, wo kwnukpema lo jesnu əɓo ń mi kwu wo n wo, əkwo nu n mi gna anyì.”<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />To ɓa ɓwa əkwo awyega, nge wo ɓə gnyi woi gna ɓa əwo Dada əɓo nu m. <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />Nlonu Yeisu wa gna ɓa, “She fye ɓə la Əza Nugwnu lawu, n əsayii nu n fye ɓə kpe nge əmi nu zhni əwo, jesnu nge mi ta zhni ɓəhoɓəhoi n əmihnii nu m, ama mi ɓwa əɓo nu da n əmi Dada wo kwu wu mi. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />Əza n wo ɓə tnu n mii nyi, wo kwnusnu lo n mii; wo too fa mi gnyi n əmi gbmanyi m, ntuge mi zhni əɓo lo ń kwo da wo n sahosahoii.” <verse eid="JHN 8:29" /><verse number="30" style="v" sid="JHN 8:30" />Kwo shi wo ɓə daɓo, aza n mwa bəgyé ɓa kwu gaiciyaga n wo.<verse eid="JHN 8:30" /></para>
  <para style="s1">Ɓənakpaeje ntu əza n Yeisu anuwnuyi aɓyi zhni</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />Yeisu wa gna Ayahudiyi n ɓa ɓəə kwu gaiciyaga dna n wo nyi, “N fya kwu əmi nyawu shiɓwa, fye kwu zhni əmi amwutuyi hnihnii. <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />Nlonu n fye ɓə kpe gaiciyanunui əye jesnu gaiciyanunui ɓə la fye loya.”<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />Ɓa dna wo ɓəgbe, “Yi zhni Ibrahim ayawyi nu, yi too shni afyenu zhni fyi n zahozahoyi akwnu m. Kwo zè n wunanu hoi gna nge a ɓə la yi loya a?”<verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />Yeisu wa dnaɓəgbe, “Ɓəhnihni nu n mi gna fye, əzahozahoyi n wo zhni leifyi, wo zhni leifyi fyenu nu. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />Njesnu fyenu to ń abai lo dna n pwuwa nyalonyalo m, ama nugwnu zhni pwuwa yi nya nu nyalonyalo. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />Ntulonu ngye n Nugwnu ɓa lo əfye ya, fye ɓə kwu zè aloloiya ɓəhnihnii nya. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />Mi kpəlo nge fye zhni Ibrahim ayawyi nu. Dudulonu fye zna zokwo shnilo nabai fya wu mi, ntuge fye to n abai lo ntu n əmi ɓədagbma ɓo m. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />Mi gna fye əɓo nu n mi kwu gye n əmi Dada aba, əfyehni ce, fye zhni aɓo nu n fye kwu wo n əfye dada.”<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />Ɓa dnaɓəgbe, “Ibrahim nu zhni əyi Dada.”</para>
  <para style="p" vid="JHN 8:39">Yeisu wa gna, “Ngye fye ɓəə zhni Ibrahim aɓyi nu, akpəge fye ɓa zhni əɓo n Ibrahim ɓə zhni. <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />Ngye shi kwo lo nyi, fye zna zokwo shnilo nabai fya wu mi, əza n wo kwu gaiciyanunui gna fye, n mi kwu wo n Shekwoyi nyi. Ibrahim to ɓə zhni aɓo ye pya m. <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />Fye zhni əfyehni dada atnutnu nu.”</para>
  <para style="p" vid="JHN 8:41">Ɓa ceawyi, “Yi to zhni anagbái aɓyi nu m, Əda gbmanyi n yi ncei ɓwasnu lo, əwo nu zhni Shekwoyi n əwohnii.”<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />Yeisu wa gna ɓa, “Ngye Shekwoyi ɓəə zhni əfye Dada nu, fye ɓə ɓa ye mi, ntuge ma gbmiɓe n Shekwoyi aba nu. Əmi nu to ɓe n əmihnii m; Shekwoyi nu ɓə tnu n mii. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />Knyiyi nu zhni to fyei ɓwa əmi ɓəda awyega m ma? Ntuge fye ta myilo fyei wo əɓo n mi da m. <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />Fye zhni əfye dada anya nu, Shetam, jesnu fye ncei pma fya zhni əfye dada ɓəmwi nu. Wo ɓə zhni zawuyi nu n kpmisnuyi, to woi shi gaiciyanunui ɓwa m, ntuge gaiciyanunui to dnalo n wo m. She wo ceakata, wo da əwo əbemi əbyé nu, ntuge wo zhni katáceyi nu, jesnu akataceyi dada. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />Dudulonu ntuge mi gna fye gaiciyanunui, fye ta ga mi gaiciya lo m! <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />Zaho lo ń fye ń wo ɓa gbmiɓe n əmi leifyi ɓəgyii? Ngye n mi gna fye gaiciyanunui nu, knyi nu zhni to fyei ga mi gaiciya m, ma a? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />Əzadəhodəhoyi n wo zhni Shekwoyi nya nu, wo wo əɓo n Shekwoyi da. Əɓo n kwo zhni to fyei wo nyi m, əkwo nu nge, fye to zhni Shekwoyi anya nu m.”<verse eid="JHN 8:47" /></para>
  <para style="s1">Əɓo Yeisu da ntu əwohni ɓo</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />Ayahudiyi ɓa dna wo ɓəgbe, “Yi to fyilo n zokwo, shi yi da nge ho zhni Samariyai nu, jesnu ge ho nunui lo n asei m?”<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />Yeisu wa gna, “Mi to nunui lo n asei m, ama mi ga əmi Dada mwamwa, ama fyei ci mi wyegba. <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />Mi ta zna latu shni lo ga əmihni m; ama əza lo n wo zna kwo shni, jesnu əwo nu zhni owadayi. <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />Ɓəhnihni əmi nu gna fye, əzadəhodəhoyi n wo vyi əmi ɓədagbma wo taa gye əfyi m nanyinanyi.”<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />N dəyei, ɓa sáwyi, “Nsaiye yi kwu kpe nge ho nunui lo n asei! Ibrahim ɓə la fyí, nlonu sheɓəgwognayi ce, dudulonu ho gna nge əzadəhodəhoyi n wo vyi əho ɓədagbma wo taa to əfyi wo m nanyinanyi. <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />Ho du əyi dada Ibrahim lo nu? Wo ɓə lá fyí, nlonu sheaɓəgwognayi ce. Ho gye nge ho zhni nyika nu gnyi a?”<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />Yeisu wa dnaɓəgbe, “Ngye mi lá əmihni tu lo, əmi latu to zhni nyaho nu m. Əmi Dada, n fye gna wo zhni əfye Shekwoyi nyi, əwo nu ga mi latu. <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />Kwo shikwonyi fye ta kpe wo əye lo m, əmihnii da kpe wo əye lo. Ngye ma gna ge mi ta kpe wo əye lo m, mi ɓaa zè katáceyi ngye əfye, ama mi kpe wo əye lo jesnu mi ga əwo ɓədagbma mwamwa. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />Əfye Dada Ibrahim ɓə nyagbmada dna n ɓənubwozhni nge wo kwu gye əmi nyipyei; wo ɓə kwu kwo gyewye, jesnu a kwu wo da.”<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />Ɓa gna wo, “Ho too ló aye shiitnu m, ho nyi n kwu Ibrahim gyewye!”<verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />Yeisu wa dnaɓəgbe, “Ɓəhnihni əmi nu gna fye, a ɓə snu ń a ma Ibrahim, mii gnyi gnyi!” <verse eid="JHN 8:58" /><verse number="59" style="v" sid="JHN 8:59" />N dəyei, ɓa kwu akwuta nge ɓa knyi wo, ama Yeisu wa əwohni ɓwi, wa wyiya fyaa n Dagayipwuwa ashilagyí.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s1">Yeisu ga əza kágna ń a ɓə ma wo wyebwayi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />Shi wo ɓəlo n zokwo, wa gye əza n a ɓə ma wo n awyei bwabwai. <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />Əwo amwutuyi ɓa nya wo əɓo, “Rabyi, nyika nu ɓə zhni leifyi a, əza ye nu kwo əwo azamayi nu ɓə zhni a ma wo n awyei bwabwai a?”<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />Yeisu wa gna, “Əza ye nu to ɓə zhni leifyi kwo əwo azamayi m, ama dəye ɓə zhni nabai a wu Shekwoyi kalá tnutnu nu dna n əwo. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />Ɓəshishi nu ya zhni əza tnutnu n wo ɓə tnu n mii nyi; nyipyei ye gnyi. Sukwo ɓe lo, əsa n əza to ɓə myi wa zhni tnutnu m. <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />Shi mi ye dnalo n anyì nyi, əmi nu zhni bwuznagna anyì nya.”<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />Shi wo ɓə kwu ɓəye da, wa fu əwnu n əwo aknyii zhi n əknyi, jesnu wa pmya əza yi kwo n awye. <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />Wa gna wo, “Lo, ho wnuawye n Silowam nuwnaznudna” (ɓədagbma ye nu gyi ge “Tnuncei”). Ntulonu əza ye wa lo wa wnuawye jesnu wa zhi apyi woi gyewyeba.<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />Əwo akwnuzhiyi n aza yii n ɓa ɓəə kwu wo gyewye n sapa woi ɓanya nyi, ɓa nyaɓo, “Əza nu to nyi n wo ɓə zhni woi sase shi woi ɓanya nyi m?” <verse eid="JHN 9:8" /><verse number="9" style="v" sid="JHN 9:9" />Azaho ɓa gna nge əwo nu. Azaje ɓa gna, “Aawo, wo gbe wo gbegbe nu.” Ama əwo n wohnii waa gyitu, “Əmi nu gnyi.”<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />Ɓa nyaɓo, “A zhni n wunanu ho nyi gnyi hoi gyewyeba a?”<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />Wa dnaɓəgbe, “Əza n ɓa yi wo ge Yeisu nyi, əwo nu na fu əwnu wonyi pmya mi n awye. Wonyi gna mi ge mi lo Silowam nuwna mii wnuawye. Ntulonu maa lo, ma wnuawye, minyi gyewyeba.”<verse eid="JHN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12" />Ɓa nya wo əɓo, “Əza ye gnyi ń na a?”</para>
  <para style="p" vid="JHN 9:12">Wa gna, “Mi ta kpəlo m.”<verse eid="JHN 9:12" /></para>
  <para style="s1">Afarisiyi əɓopmigye tu n wyebwayi kágna ɓo</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />Ɓa ɓe Afarisiyi n əza yii ń awye ɓə n woi bwabwai nyi. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />Əwyi n Yeisu ɓə fu əwnu wa pmya n əza yi awye ɓa kpe wo ya nyi, kwo ɓə zhni Sibyiwyi nu. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />Ntucenu Afarisiyi ce ɓa nya wo əɓo, shi wo ɓə gwo əwo wyebagye n wu. Əza yi wa dnaɓəgbe, “Wo ɓə pmya əwnu nu n əmi awye, ma wnuawye nsaiye mi gyewyeba lo.”<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />Afarisiyi ho ɓa gna, “Əza ye ta gbmi n Shekwoyi aba nu m, ntuge wo ta shi owa Sibyiwyi nya əɓwa lo m.” Ama azaje ɓa nyaɓo, “Kwo ɓá kpezhni n wunanu leifyizhniyi wa zhni aznù ye pya?” Ntulonu ɓaa gnaje.<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />Nlonu ɓa je pmyi da wyebwayi, “Ho n knyiɓei nu lo ha da ntu n əwo əɓo a? Əho awye nu n wa gwuya.” Əza yi wa dnaɓəgbe, “Wo zhni sheɓəgwognayi nu.”<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />To ɓa du ɓa ga gaiciya nge wo ɓə zhni wyebwayi nu jesnu nge wa gwo wyebagye gwogwo nu m, sai əsa n ɓa ɓə tnu əza yi azamayi ɓo. <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />Ɓa nyaɓo, “Əfye nugwnu nu gnyi n əza yei? Əza nu nyi n fye gna nge a ɓə ma wo n awyei bwabwai? Kwa zè n wunanu nsaiye woi gyewyeba a?”<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />Əwo azamayi ɓa dnaɓəgbe, “Yi kpəlo nge wo zhni əyi nugwnu nu, jesnu yi kpəlo nge a ɓə ma wo n awyei bwabwai nu. <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />Ama shi wa zhni wonyi gyewyeba nsaiye, kwo əza n wa kpe wo awye ya nyi, yi ta kpəlo m. Fye nya wo əɓo. Wo la gbmiza; wo ɓa daɓo n əwohnii.” <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />Əwo azamayi ɓə da əɓo ye ntuge ɓa ɓə zhi n Ayahudiyi atukwoda ədnawoi nu, n ɓa ɓəə kwu lu da nge əza n wa da nge Yeisu zhni Kirisiti nu, a ɓaa wo nyaya n Ayahudiyibwokwnu. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />Cenu ɓə zhni əwo azamayi ɓa gna, “Wo la gbmiza; fye nya wo əɓo.”<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />Ɓa je əza yi yì əɓwa baayi n wo ɓə zhni wyebwayi nyi, ɓa gna, “La Shekwoyi tu ha da gaiciya. Yi kpəlo nge əza ye zhni leifyizhniyi nu.”<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />Wa dnaɓəgbe, “Kwo wo zhni leifyizhniyi nu, kwo nlonu to m, mi ta kpəlo m. Əɓo gbmanyi nu n mi kpəlo, mi ɓə zhni wyebwayi nu, ama nsaiye mi gyewyeba lo!”<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />Nlonu ɓa nya wo əɓo, “Wo ɓə zhni ho knyiɓei nu a? Wo ɓə kpé əho awyeya n wunanu a?”<verse eid="JHN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27" />Wa dnaɓəgbe, “Mi kwu gna fye n shnisnu, ama fye too kna tnubwa m. Ntu knyiɓei nu n fye ye fya je ce wo a? Fye ye fya kwu zè əwo amwutuyi nu cè?”<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />Nlonu ɓa knyi wo akpmi ɓa gna, “Ho zhni əza ye mwutuyi nu! Əyii da, zhni Mwusa amwutuyi nu! <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />Yi kpəlo nge Shekwoyi ɓə kwu əɓo da n Mwusai, ama əza ye n wo nyi, yi ta kpe aba lo n wo gbmi m kpeekpe.”<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />Əza yi wa dnaɓəgbe, “Nsaiye dəye zhni əɓo wowoi nu! Fye ta kpe aba lo n wo gbmi m, dudulonu wo la əmi awye kpeya. <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />Yi kpəlo nge Shekwoyi ta kna aleifyizhniyi tnubwa m. Wo kna Shekwodnawoyi nu tnubwa n wo zhni əwo ɓəye nyi. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />She anyì ɓə ya, əzaho too shni wo nge a la wyebwayi kpeawyeya n a ɓə ma wo n awyei bwabwai m. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />Ngye əza ye to ɓə gna ge wo gbmi n Shekwoyi aba nu m, wo taa myi n ɓəho zhni m.”<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />Ntu n dəye ɓo, ɓa dnaɓəgbe, “Əho n a ɓə ma ho n nunui dna n leifyi; kwo ɓa zhni n wunanu əho nu ha ga yi nyawu a!” Ɓa gbmi wo ya gnyi n əbmyi.<verse eid="JHN 9:34" /></para>
  <para style="s1">Awyebwa zafnu nya</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />Yeisu wa wo nge ɓa la wo gbmiya n Ayahudiyibwokwnu, shi wo ɓə gye wo əwye, wa gna, “Ho la gaiciyaga dna n Əza Nugwnu?”<verse eid="JHN 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36" />Əza yi wa nyaɓo, “Haamwasa, nyika nu n woi a? Gna mi nabai ma ga wo gaiciya.”<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />Yeisu wa gna, “Ho kwu wo gyewye nsaiye; ɓəhnihni, əwo nu gnyi woi daɓo n hoi.”<verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />Nlonu əza yi wa gna, “Dagayi, mi la gaiciyaga,” nlonu, wa ga wo mwamwa.<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />Yeisu wa gna, “Ntu n owada ɓo nu n mi la lo ɓe anyì ye, nabai nge awyebwayi ɓa gyewyeba, jesnu aza yi n ɓa gyewyeba lo nyi, ɓa kwu zè awyebwayi.”<verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />Afarisiyi ho n ɓa ɓə kwnuzhi n woi ɓa kwu wo woi da ɓəye jesnu ɓa nyaɓo, “Nge naa? Yi zhni awyebwayi nu cè?”<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />Yeisu wa gna, “Ngye fye ɓəə zhni awyebwayi nu, to fye ye n leifyi ɓəgyii lo m; ama nsaiye shi fye gyewyeba lo nyi, əfye ɓəgyi kwo la myitu n fye.<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s1">Knyiknayi manai n əwo aknyii</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />“Ɓəhnihni əmi nu gna fye Afarisiyi, zahozahoyi n wo to lodna ń aknyigbe ń abwokwnumi m, ama wa gwnugyi wa lodna n zokwodo, wo zhni əvyì nu jesnu zokwojei. <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />Əza n wo lodna lo ń abwokwnumi, əwo nu zhni aknyiknayi. <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />Abwokwnumi gwuyi gwú kpakwo ya ga wo, jesnu aknyi ɓa knà əwo bəgye tnubwa. Wo yi əwo aknyi n əɓa ayei, jesnu wa sabye lo n ɓai n əbmyi. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />She wo la əwo anya kwnuya zhi vnyanya, wa sabye n ɓai, jesnu əwo aknyi vyi wo ntuge ɓa kwu əwo bəgye kpeye. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />Ama ɓa taa vyi zhiɓeyi m, nanyinanyi; ɓəhnihnii ɓa ɓá bwusi n əwo aba, ntuge ɓa too shni zhiɓeyi bəgye wo m.” <verse eid="JHN 10:5" /><verse number="6" style="v" sid="JHN 10:6" />Yeisu wa zhni apma n ɓəda bmapmyi yei, ama to Afarisiyi ɓa ɓwa əɓo awyega n wo ɓə gnyi woi da ɓa m.<verse eid="JHN 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />Ntucenu Yeisu wa je gna, “Ɓəhnihni əmi nu gna fye, əmi nu zhni abwokwnumi aknyi nya. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />Aza vnyanya n ɓa ɓə kwu ɓe n əmi abye, ɓa zhni avyì nu, n azajeyii, ama aknyi too kna ɓa tnubwa m. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />Əmi nu zhni abwokwnumi; əza n wa lodna n abwokwnumi ye, wo ɓaa pwo. Ɓa ɓá lo ɓe, ɓa je kwnuya, jesnu ɓa ɓwa anyagyigyiba. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />Əvyì ɓwa ɓe nabai wa wyi ənya nu, wa wu jesnu wa zhniagbma; ma ɓe nabai ɓa ɓwa wyewyeyi nu, jesnu ɓa ɓwa kwo n nunui.<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />“Əmi nu zhni knyiknayi manai. Knyiknayi manai ga əwo wyewyeyi ntu n aknyi ɓo. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />Gwodogwoyi wo to zhni knyiknayi nu m, jesnu aknyi to zhni əwo anya nu m. Ntulonu shi wo gye camcam kwoi ɓe, wa ya aknyi zhi wa bwusi. Nlonu camcam kwa ya aknyi wna n gəluce jesnu kwaa ɓa gnamyi. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />Əza ye bwusi ntuge wo zhni gwodogwo tnutnuzhniyi nu, jesnu wo ta gye əwo anuwna n aknyi yi m.<verse eid="JHN 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 10:14" />“Əmi nu zhni Knyiknayi manai; mi kpe əmi aknyi əye lo, jesnu əmi aknyi ɓa kpe mi əye; <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />n ɓwasnu shi Dada kpe mi əye nyi, əmihni ce kpe Dada əye lo; jesnu mi ga əmi wyewyeyi ntu n aknyi ɓo. <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />Mi n aknyi ajei lo n ɓa to fyilo n aknyigbe ye m. Ɓəshishi nu ma ɓe n ɓai ce. Əɓahni ce ɓa ɓə wo əmi bəgye, ɓa ɓə kwu zè gəluce gbmanyi jesnu n əknyiknayii gbmanyi. <verse eid="JHN 10:16" /><verse number="17" style="v" sid="JHN 10:17" />Əɓo n kwo zhni əmi Dada woi ye mi nyi, əkwo nu ge, mi la əmi wyewyeyi ya ga, mii je kwo lá njesnu. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />Əzaho taa gwo kwo n mi m, ama əmi nu ya kwo ga n əmihni ɓəyei. Mi n ikwoi lo ma ya kwo ga, mii n ikwoi lo ma gwo kwo njesnu. Ma gwo ɓəgbetu ye n əmi Dada nu.”<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />Ayahudiyi n ɓa ɓə wo aɓədagbma ye nyi, ɓaa je ajegna njesnu. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />Bəgyé n ɓa, ɓa gna, “Wo n asei fyilo jesnu wo da nyace ɓəda nu. Knyiyi nu zhni fyei kna wo tnubwa a?”<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />Ama azaje ɓa gna, “Aɓəda ye to zhni ase nya nu m. Ase ɓa myi ɓa kpe wyebwayi awyeya?”<verse eid="JHN 10:21" /></para>
  <para style="s1">Aɓənakpeaje ntu n əza ɓo n Yeisu gna nge wo zhni.</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />Nlonu Awyefna Gbegyishi nya kwa ɓe dna n Urishelima. Vnyinyikwo əsa nu ɓə gnyi, <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />Yeisu ɓə dna n Dagayipwuwa ashilagyí woi znazna dna n Sulemanu azhigwo ofye. <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />Ayahudiyi ɓə yezhi n ɓo n shekna wo zhi, ɓai gna, “Nya knyisai nu n ho ɓa fa yi fyi n jeje n anyiɓəyeɓwi a? Ngye əho nu zhni Kirisiti, gna yi n səsəiya.”<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />Yeisu wa dnaɓəgbe, “Mi kwu gna fye, ama fye too ga mi gaiciya m. Atnutnu n mi zhni dna n əmi Dada əye nyi, kwo gbmi mi əɓo lo, <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />ama fye ta ga gaiciya lo m, ntuge fye to zhni əmi aknyi nu m. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />Əmi aknyi kna əmi bəgye tnubwa; mi kpe ɓa əye lo, jesnu ɓa vyi mi. <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />Mi ga ɓa wyewyeyi nyalonyalo nya, ɓa to ɓə fyí m, nanyinanyi; əzaho taa myi wa fna ɓa n əmi akwnu m. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />Əmi Dada, n wo kwu ɓa ga mi nyi, wo du aza vnyanya lo n ikwo; əzaho taa myi wa fwna ɓa n əmi Dada akwnu m. <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />Əmi n əmi Dadai yi zhni gbmanyi nu.”<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />Njesnu əwo anuwnui, Ayahudiyi, ɓa kwu akwuta nabai ɓa knyi wo, <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />ama Yeisu wa gna ɓa, “Mi kwu atnutnu amanai wu fye ń ɓa kwnu n Dada aba. Ntu n knyidei ɓo nu ń fye ye fya knyi mi akwuta a?”<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />Ɓa dnaɓəgbe, “Yi ta ye ya knyi ho akwuta ntu ń tnutnu manai ho ɓo nu m, ama ntu ń atukwopmi ɓo nu, ntuge əho, zanyikwoci azanga, ho gna nge ho zhni Shekwoyi nu.”<verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />Yeisu wa dna ɓa ɓəgbe, “Kwo to kafyilo ń fye Owa, ‘Mi kwu gna nge fye zhni “ashekwoyi” nu m’? <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />Ngye wo ɓə yi ɓa nge ‘ashekwoyi’ nu, aza n Shekwoyi ɓədagbma ɓə ɓe da ɓa nyi, shikwonyi a taa Nyakagyigyiyi pmyima m; <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />to a ɓa gna nge nanu, ntu ń əza ɓo n Dada ɓə knyishi nge əwohni nya, jesnu wa tnu n woi dna n anyì a? Knyiyi nu zhni fyei tu mi atukwopmi əɓo, ntuge ma gna, ‘mi zhni Shekwoyi Nugwnu nu a’?<verse eid="JHN 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 10:37" />“Fye to ga mi gaiciya m, akpəge ngye mi zhni əmi Dada tnutnu nu. <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />Ama ngye əɓa nu n mi zhni, kwo shikwonyi fye ta ga mi gaiciya lo m, fye ga atnutnu gaiciya, nabai n fye ɓa myi fya kpe jesnu fya ɓwa awyega nge Dada dnalo n mi, əmihni ce mi dnalo n Dada.” <verse eid="JHN 10:38" /><verse number="39" style="v" sid="JHN 10:39" />Njesnu ɓa zhnatna nabai ɓa wna wo, ama waa waya n əɓa akwnu.<verse eid="JHN 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />Ntucenu Yeisu wa jezelo Urudu kpma, aba n Yohana ɓəə dna woi zhni batizima n anyipyei sapa nyai nyi. Wa dna n abaayi <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />jesnu aza n mwa bəgyé ɓa ɓe da wo. Ba gna, “Kwo shikwonyi Yohana to ɓə zhni əznù m, aɓo vnyanya n Yohana ɓə da tu n əza ye tukwo nyi, ɓa zhni gaiciya nu.” <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />Njesnu gnyi n abaayi nu aza bəgyé ɓa kwu gaiciyaga fyi n Yeisu.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s1">Liyazuru əfyi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />Əzaho ɓə nyi ai yi wo ge Liyazuru, nyasna kwa sna wo. Wo ɓə gbmi n Byetani nu, Mariyamwu əzhi n əwo zadoi Mata. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />(Mariyamwu ye, n əwo mapwi Liyazuru ɓə shi n nyasnai nyi, əwo nu ɓə zè əmisnidaí kpe Dagayi jesnu wa wnu əwo apita ya n əwo tukwoyii.) <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />Ntulonu əwo amapwi ɓa tnu tnutnu ga Yeisu, “Dagayi əza n ho ye wo nyi, nyasna sna wo lo.”<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />Shi wo ɓə wo nlonu, Yeisu wa gna, “Nyasna ye to zhni əfyi nya nu m. Aawo, kwo shi ntu n Shekwoyi latu ɓo nu, nabai n Shekwoyi Nugwnu ɓa ɓwa latu tu n əkwo ɓo.” <verse eid="JHN 11:4" /><verse number="5" style="v" sid="JHN 11:5" />Yeisu ɓə ye n Matai n əwo zadoi Liyazuru. <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />Ntulonu shi wo ɓə wo nge nyasna sna Liyazuru lo, wa kwu anyipyei ɓwaɓe ngwnu-aba dna n aba n wo ɓəə dna nyi, <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />nlonu wa gna əwo amwutuyi, “Fye ɓe ya jezelo Yahudiya.”<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />Ɓa gna, “Ama Rabyi əsa too mwa n Ayahudiyi ɓə ye ɓa knyi ho akwuta n abaayi m, ho nyi ye ha dudu ha jezelo ń ɓo?”<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />Yeisu wa dnaɓəgbe, “Asnukna too lo awoceaba nu n nyipyei bwuznagna nya m? Zahozahoyi n wo znazna dna n nyipyei bwuznagna wo taa cebwonyi m, ntuge wo ɓa gyewyeba n anyì ye bwuznagnai. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />Əsa nu n əzaa znazna dna n sukwo ń wo cebwonyi, ntuge wo to n bwuznagnai lo m.”<verse eid="JHN 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 11:11" />Shi wo ɓə kwu əɓo ye da, wa gwodu wa gna ɓa, “Əyi nugwnudo Liyazuru wo la wnagye; ama mi ɓa lo abaayi mii zhni wa kwnúagyewyi.”<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />Əwo amwutuyi ɓa dnaɓəgbe, “Dagayi, ngye wo wnagye nu, a gye wo ɓə laka n kágna nu.” <verse eid="JHN 11:12" /><verse number="13" style="v" sid="JHN 11:13" />Yeisu ɓə da Liyazuru əfyi nu ɓo, ama əwo amwutuyi ɓə gye ngye gyewna gəm nya nu.<verse eid="JHN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 11:14" />Ntucenu wa gna ɓa n səsəiya, “Liyazuru wo la fyí, <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />jesnu ntu n fye əɓo mi n agbmadai lo, ntuge mi to ɓə gnyi n abaayi m, nabai n fye ɓa kwu gaiciyaga. Ama fye ɓe ya lo əwo aba.”<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />Nlonu Toma (ń a je wo yi nge Didimwus nyi) wa gnà amwutuyi aje, “Fye ɓe ya lo ce, nabai yi kwnu fyí n woi.”<verse eid="JHN 11:16" /></para>
  <para style="s1">Yeisu zhni Liyazuru amapwi atna</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />Shi wo ɓə si abaayi, Yeisu wa gye a ɓəə la Liyazuru lu byidna n vnyigwo anyipyei ngwnu-anyi. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />Nsayii Byetani ɓə ɓwasnu ngye amyalu ngwnu-aba nu n taya gnyi n Urishelimai, <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />jesnu Ayahudiyi bəgyé ɓəə kwu ɓe da Mata n Mariyamwui nabai ɓa zhni ɓa atna, əɓa mapwi əfyi nya. <verse eid="JHN 11:19" /><verse number="20" style="v" sid="JHN 11:20" />Əsa n Mata ɓə wo nge Yeisu ɓe lo, wa gbmiya lo wo shegwnu wo, ama Mariyamwu waa dna n apyi.<verse eid="JHN 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 11:21" />Mata wa gna Yeisu, “Dagayi, ho ɓə gna ho gnyi n ya, əmi mapwi to ɓə ɓa fyí m. <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />Ama mi kpəlo nge, kwo nsaiye Shekwoyi ɓa ga ho nyahonyahoi n ha nyaɓo.”<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />Yeisu wa gna wo, “Əho mapwi ɓa je kala la.”<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />Mata wa gna wo, “Mi kpəlo nge wo ɓə laka dna ń əfyikalakwu, n nyipyei kpmaknaii.”<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />Yeisu wa gna wo, “Əmi nu zhni əfyikalakwu n wyewyeyii. Əza ń wa ga mi gaiciya, wo ɓa ɓwa wyewyeyi, kwo n wa fyí nu; <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />jesnu əzadəhodəhoyi n wa gyianyì woi ga gaiciya dna n mi, wo to ɓə fyí m, nanyinanyi. Ho la gaiciyaga dəye?”<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />Wa dnaɓəgbe, “Əə, Dagayi, mi la gaiciyaga nge əho nu zhni Kirisiti, Shekwoyi Nugwnu, n wo ɓa ɓe anyì nyi.”<verse eid="JHN 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />Shi wo ɓəə kwu ɓəda ye da, wa jezelo wa yì əwo mado Mariyamwu gnyi n gnagna. Wa gna, “Nyawuyi la ɓe, jesnu wo nya ho əɓo lo.” <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />She Mariyamwu ɓə wo lonu, wa laka n pye wa lo da wo. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />Nsayii Yeisu to ɓəə lo ɓe əzhi m, ama wo ɓə ye gnyi ń aba nu n Mata ɓə shegwnu wo nyi. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />She Ayahudiyi n ɓa ɓə fyi n Mariyamwu pwuwa ɓai zhni wo atna nyi, ɓə gye shi wo ɓə laka n pyepyei wa gbmiya, ɓa vyi wo; ɓa ɓə gye ngye wo lo vnyigwo nu wo zhni bwugbazhii n ɓo.<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />She Mariyamwu ɓə si aba n Yeisu ɓə gnyi nyi, wa gye wo, wa yashi n əwo apitaba wa gna, “Dagayi, ho ɓə gna ho gnyi n ya, əmi mapwi to ɓəə ɓa fyí m.”<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />Shi Yeisu ɓə gye woi ciɓwi, ɓədo n Ayahudiyii n ɓa ɓə kwnu ɓe n woi ɓai ciɓwi ce, əwo zafnu kwaa woshna dəidəi jesnu bwugba kwaa wo wnu. <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />Wa nyaɓo, “Fye woi byi shi n nanu a?” Ɓa dnaɓəgbe, “Ɓe ha gye, Dagayi.”<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />Yeisu wa ciɓwi.<verse eid="JHN 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 11:36" />Nlonu Ayahudiyi ɓa gna, “Gyewye, shi wo ɓə ye wo nsnu!”<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />Ama azaho ɓa gna, “Əwo n wo ɓə la wyebwayi kpeawyeya nyi, wo to ɓə ɓa myi wa kpma əza ye əfyi m?”<verse eid="JHN 11:37" /></para>
  <para style="s1">Yeisu lá Liyazuru kala n əfyi</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />Yeisu n bwugba shnawo yaakwoi, wa ɓe vnyigwo. Kwo ɓə zhni əbmi nu n kwutai fa n əkwo əgbe.<verse eid="JHN 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 11:39" />Wa gna, “Fye kpe kwuta ya,” Mata, zafyi mapwi, wa gna, “Ama, Dagayi, nsaiye a ɓa gye kwo la ceasni, ntuge wo kwu anyipyei ɓwa ngwnu-anyi nu dna n ɓo.”<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />Nlonu Yeisu wa gna, “Mi to kwu gna ho nge n ha ga gaiciya, ho ɓa gye latu Shekwoyi nya m?”<verse eid="JHN 11:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 11:41" />Ntulonu ɓa kpe kwuta ya. Yeisu wa kpé awye wu əshe wa gna, “Dada, mi sa ho ami lo nge ho la tnubwakna mi. <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />Mi kpəlo nge ho wo mi lo ciici, ama mi da dəye ntu n aza apma ɓo nu, n ɓa gnyiagnyi zhi n ya nyi, nabai ɓa ga gaiciya nge əho nu ɓə tnu n mii.”<verse eid="JHN 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 11:43" />Shi wo ɓə kwu dəye da, Yeisu wa yì n bəgyei latu, “Liyazuru, gbmiɓe!” <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />Zafyi wa gbmiɓe, əwo aɓwa n apitai n papai n əfyi ajei, ɓədo n jebwoi wna n əwo awyeba.</para>
  <para style="p" vid="JHN 11:44">Yeisu wa gna ɓa, “Fye kpma wo vnyigwo aje ya, fya fa wo wa lo.”<verse eid="JHN 11:44" /></para>
  <para style="s1">Kwúlupa a wu Yeisu</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />Ntucenu Ayahudiyi bəgyé n ɓa ɓə lo Mariyamwu gnaɓyi nyi, ɓa kwu gye əɓo n Yeisu ɓə zhni, ɓa kwu gaiciyaga n wo. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />Ama azaho n ɓa, ɓa lo da Afarisiyi ɓa gna ɓa əɓo n Yeisu ɓə kwu zhni. <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />Nlonu apirisiti atukwoda n Afarisiyii ɓaa Sahindiri yezhi.</para>
  <para style="p" vid="JHN 11:47">Ɓa nyaɓo, “Yi la knyi abyegyii nu ɓwa a? Gye shi əza ye gnyi woi zhni aznù n mwa bəgyé. <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />N ya fa waa gwodu nlai, zahozahoyi ɓaa gaiciyaga wo, nlonu Aromayi ɓə ɓe ɓai gwo əyi Dagayipwuwa ɓədo n əyi əknyii.”<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />Nlonu znaknayi n ɓa ai yi wo nge Kayafas, n əwo nu ɓə zhni pirisiti dnagbmai dna n əyeí nyi, wa daɓo, “Fye ta kpe ɓəho ye lo, kwo fyewyi m! <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />Fye ta kpəlo nge kwo fyei gnabmya lo zaknayi wa fyi ntu n aza ɓo, a fa ədo n əbyé vnyanya kwo ɓa ɓwu nyi m?”<verse eid="JHN 11:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 11:51" />Wo to ɓə da ɓəyé n əwohni ayei nu m, ama ngye Pirisiti dnagbmai əyeí nya, wo ɓə da sheɓəgwogna nu nge Yeisu ɓə fyí ntu n Ayahudiyi əbyé ɓo, <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />jesnu toge n ɓwasnu ntu ń əknyi yi ɓo nu m, ama ntu n Shekwoyi aɓyi ɓo ń ɓa gnamyi fyi laɓa nyi, nge a ɓa ye ɓa zhi jesnu ɓa kwu zè gbmanyi. <verse eid="JHN 11:52" /><verse number="53" style="v" sid="JHN 11:53" />Ntulonu ənya n kwo laka n əwyi yi kwoi lo n abyei, ɓa pakwúlu nabai ɓa wu wo.<verse eid="JHN 11:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 11:54" />Ntucenu to Yeisu wa shna zna laɓa pəipəi dna ń Yahudiya aza atasni m. Nkwoɓwi waa gbmi wa lo əknyi n kwo wo vyivyiwyi n zhabwii, wa lo əzhi n a yi kwo ge Ifraimwu nyi, aba n wo ɓə dna ɓədo n əwo amwutuyii.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />She Ayahudiyi Gnanaznu awyefna sa ɓə la wo vyivyiwyi, bəgyé kwa gwnulo Urishelima ɓai kwnu ń azhigba ntu n pmyapmya ɓo, to Gnanaznu awyefna əsa kwoi si m. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />Ɓa kwu zhi ɓai zna Yeisu shni, shi ɓa ɓə gnyiagnyi fyi n Dagayipwuwa ɓa nya aje, “Fye zhninubwo lo n wunanu a? Wo ta ɓe awyefnaba ye lo nu m, kpeekpe?” <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />Ama apirisiti atukwoda n Afarisiyii ɓa ga ɓəgbetu nge zahozahoyi n wo kpe aba əye lo n Yeisu dna, wa da nabai ɓəə wna wo.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s1">A la Yeisu pmya n Byetani</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />Gnanaznu awyefna kwoi ce anyipyei tnanyi, Yeisu wa ɓe Byetani, aba n Liyazuru ɓə dna, n Yeisu ɓə la wo kala n əfyi nyi. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />N abaayi a kwu wyeshe nyagyi zhni ntu ń Yeisu ɓo, Mata wa gná nyagyi, jesnu Liyazuru ɓə dna n aza, n ɓa ɓə kwnu asese kpe n Yeisui n tebwul. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />Nlonu Mariyamwu wa la nardi əmisnidaí tnadodnai nakwoi, ngye lita gbmanyi; wa zè kwo kpe n Yeisu apita, wa wnu kwo ya n əwo tukwoyii. Pwuwa yi kwaa gwugnyi n əmisnidaí asnii.<verse eid="JHN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 12:4" />Ama zaknayi n əwo amwutuyi, Yahuda Iskariyoti, n əwo nu ɓə ye wa ɓwu wo ń abyeɓwa nyi, to wa ye m, <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />“Knyiyi nu na zhni to a kwnu əmisnidaí ye jesnu a ga awyekwoyi gyiwye ma a? Kwo gbmi gwodogwo əye ɓwugyi gyiwye lo.” <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />Wo to ɓə da ɓəye ntuge wo ɓə ye n awyekwoyii nu m, ama ntuge wo ɓə zhni əvyì nu; shi wo nu ɓə zhni gyiwye shiyi nyi, wo ɓə zhni wa dnaɓwa wa bma əwohni zhni n ənyai n kwo dnalo n lagyiita.<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />Yeisu wa dnaɓəgbe, “La wo fa. A ɓə zhni əmisnidaí ye nge waa kwo soshi nu ntu ń əmi byibyi nyipyei ɓo. <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />Awyekwoyii kwnusnu lo n fyei nsahosahoi, ama fye taa ɓwa əmi ciici m.”<verse eid="JHN 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />Aɓwazhilo Ayahudiyi deeji yaakwo ɓa kwu kpe nge Yeisu gnyilo n abaayi, ɓa ɓe toge n ɓwasnu ntu ń əwo ɓo nu m, ama ɓa gye Liyazuru cè, n wo ɓəə la wo laka n əfyi nyi. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />Ntulonu apirisiti atukwoda ɓa pyiɓo nabai aa Liyazuru wu ɓədo, <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />ntu n əwo əɓo, Ayahudiyi bəgyé ɓə gnyi ɓai lo da Yeisu ɓai ga gaiciya n wo.<verse eid="JHN 12:11" /></para>
  <para style="s1">Yeisu lo ɓe Urishelima ngye əsu</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />Əfye kwa gyi zhi, deeji yaakwo n ɓa ɓəə kwu ɓe awyefna nyi, ɓa wo nge Yeisu ɓe lo n zokwo woi ɓe Urishelima. <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />Ɓa kwu abalá afnyitolo ɓa kwnuya lo ɓəə shegwnu wo, ɓai ɓəwyi,</para>
  <para style="q1" vid="JHN 12:13">“Hosana!”</para>
  <para style="b" vid="JHN 12:13" />
  <para style="q1" vid="JHN 12:13">“Anabəlikada nu n əzai n wo ɓe dna n Dagayi əye!”</para>
  <para style="b" vid="JHN 12:13" />
  <para style="q1" vid="JHN 12:13">“Anabəlikada nu n əsui Israila nya!”<verse eid="JHN 12:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="JHN 12:14" />Yeisu wa gye zhagawyi snáyi wa sasetu n kwo, ngye shi kwo kafyilo:<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />“To wodna m, Siyona Nyigwnu;</para>
  <para style="q2" vid="JHN 12:15">gye, əho əsu ɓe lo,</para>
  <para style="q2" vid="JHN 12:15">n sasetu n zhagawyi snáyi.”<verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />N kpmisnu, əwo amwutuyi to ɓə ɓwa aɓo ye vnyanya awyega m. N ɓwasnu she a ɓə la Yeisu latu nu, n ɓa ɓə kpe nge aɓo ye kafyilo da əwo əɓo jesnu nge a kwu aɓo ye zhni kpe wo.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />Nsayii deeji n kwo ɓə kwnusnu n woi əsa ń wo ɓə yi Liyazuru dna n vnyigwo, wa la wo kala n əfyi nyi, ɓa gwodu n ɓədagbma lapwii. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />Aza bəgyé, ntuge ɓa ɓəə kwu wo nge wo kwu əznù ye wu, ɓa kwnuya lo ɓəə shegwnu wo. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />Ntulonu Afarisiyi ɓa gna aje, “Yi gyewye, dəye taa lo n yii ń ɓwaho m. Fye gye shi anyì vnyanya lo ɓai vyi wo!”<verse eid="JHN 12:19" /></para>
  <para style="s1">Yeisu pma əwo əfyi əɓo da</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />Nsayii Agirikiyi ho ɓə fyi n aza yi n ɓa ɓə lo mwamwaga dna n awyefna əsa nyi. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />Ɓa ɓe da Fyilibwus, n wo ɓə gbmi n Betsaida dna n Gəlili n ɓənyai. Ɓa gna, “Haamwasa, yi ncei pmalo ya gye Yeisu əwye.” <verse eid="JHN 12:21" /><verse number="22" style="v" sid="JHN 12:22" />Fyilibwus wa lo wa gna Anduru; Anduru n Fyilibwusii ɓa lo ɓa gna Yeisu.<verse eid="JHN 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 12:23" />Yeisu wa dnaɓəgbe, “Əsa kwo la si ń Əza Nugwnu ɓa ɓwa latu. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />Ɓəhnihni nu n mi gna fye, akpəge alikama byegye kwa kaya dna n əknyi kwaa fyí, kwo ɓwasnu byegye gbmanyi nu. Ama n kwaa fyí, kwo ga alikama abyegye n mwa bəgyé. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />Əza n wo ye əwohni wyewyeyi, wo ɓə ɓwu kwo nuwna, jesnu əza n wo wnu əwohni wyewyeyi aɓo dna n anyì ye, wo ɓə la kwo shiɓwa nya wyewyeyi nyalonyalo. <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />Əzadəhodəhoyi n wo zhni əmi tnutnu, ɓəshishi nu wa vyi mi, jesnu aba n mi dna nyi, əmi tnutnuyi ɓə dna n abaayi ce. Əmi Dada ɓa ga əza mwamwa n wo zhni əmi tnutnu.<verse eid="JHN 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />“Ńsayi əmi wyewyeyi dnalo n azhnìgye, jesnu mi ɓa gna nge nanu a? ‘Dada, gnyi mi ya ń əsa ye’? Aawo, ntu n əɓətukwo ye nu n ma ɓe dna n əsa ye. <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />Dada, la əho əye latu!”</para>
  <para style="p" vid="JHN 12:28">Nlonu bəgye kwa gbmi n əshemi, “Mi la kwo latu, jesnu mi ɓa je kwo latu.” <verse eid="JHN 12:28" /><verse number="29" style="v" sid="JHN 12:29" />Deeji n kwo ɓə zhi ń abaayi, kwaa wo ce nyi, kwa gna, əgbma la əwyisa; azaje ɓa gna maləka kwu əɓo da n woi.<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />Yeisu wa gna, “Bəgye ye, kwa ɓe ntu n əfye bmazhni əɓo nu, toge əmi nya m. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />Nsaiye nu zhni anyì ye owada əsa; nsaiye a ɓa nya anyì ye əsuɓyi ya. <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />Jesnu əsa ń a ɓə la mi lágwnu tu ń əknyi əshe, mi ɓə gnyi aza vnyanya ga əmihni.” <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />Wo ɓə da ɓəye nabai wa wu əfyi pya nu əɓo n kwo ɓə wna wo.<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />Deeji kwa daɓo, “Yi kwu wo n owa nge Kirisiti ɓə la gnyi nyalonyalo, nlonu ho ɓa gna n wunanu ge, ‘Ɓəshishi nu a la Əza Nugwnu gwnu’? Nyikanu zhni, ‘Əza Nugwnu a’?”<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />Nlonu Yeisu wa gna ɓa, “Fye ɓa ɓwa bwuznagna kwa ɓwasnu n əsai fyewyi nu. Fye znazna fye yee n bwuznagnai, ntuge əsa ɓə lo n wyegbma ɓə la lapwi fye. Əzadəhodəhoyi ń wa znazna dna ń wyegbma wo ta kpe aba əye lo ń wo lo m. <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />Fye la gaiciya ga dna n bwuznagna, fyei ye n əsai ɓwa, nabai n fye ɓa kwu zè bwuznagna aɓyi.” Shi Yeisu ɓə kwu ɓəda ye zo da, wa laka waa əwohni so, to ɓa gye wo əwye m.<verse eid="JHN 12:36" /></para>
  <para style="s1">Gaiciyaga ɓədo n tnagaiciyagai fyi n Ayahudiyi</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />Kwo n aznù bəgye avnu n Yeisu ɓəə kwu wu n əɓa awyeba nyi, dudulonu ɓa to ɓə ga gaiciya dna ń wo m. <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />Dəye ɓə ye kwa nu ɓədatnu nu n sheɓəgwognayi Ishaya ɓə da:</para>
  <para style="q1" vid="JHN 12:38">“Dagayi, nyikanu n la gaiciya ga n əyi ɓədatnu a,</para>
  <para style="q2" vid="JHN 12:38">jesnu n nyika aba nu n Dagayi ɓwagbma kwo la kpeyawu a?”<verse eid="JHN 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />Ntu n ɓəye ɓo, to ɓa ga gaiciya m, ngye shi Ishaya ncei da lo dna n abaho:<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />“Wo kwu awye ɓwu ɓa</para>
  <para style="q2" vid="JHN 12:40">jesnu wo kwu əɓa adu kpakalá,</para>
  <para style="q1" vid="JHN 12:40">nabai to ɓa gyewye n əɓa awyei m,</para>
  <para style="q2" vid="JHN 12:40">kwo ɓa kpəgənyi n əɓa adui m,</para>
  <para style="q2" vid="JHN 12:40">kwo ɓa pmyiɓe jesnu ma ka ɓa gna.”<verse eid="JHN 12:40" /></para>
  <para style="m">
    <verse number="41" style="v" sid="JHN 12:41" />Ishaya ɓə da əɓo ye ntuge wo ɓə kwu Yeisu latu gyewye nu jesnu wa daɓo ntu n əwo əɓo.<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />Dudulonu dna n əsa yi bəgyé fyi n atukwoda ɓa kwu gaiciya ga n wo. Ama ntu n Afarisiyi ɓo, to ɓa ye ɓa wu əɓa gaiciyaganunui pəipəi m, ntuge ɓa ɓə zhi n ədnai nge a ɓa nya ɓa ya n Ayahudiyibwokwnu; <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />ntuge ɓa ɓə ye zanyikwoci cici, n du cici n kwo gbmi n Shekwoyi aba.<verse eid="JHN 12:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />Nlonu Yeisu wa dnawyi, “Əzadəhodəhoyi n wo ga gaiciya dna ń mi, wo to ɓwa gaiciyaga n əmi nu m, ama dna n əza n wo ɓə tnu n mii nyi. <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />Əza n wo shi mi awye lo, wo gye əza nu lo, n wo ɓə tnu n mii nyi. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />Mi la lo ɓe anyì n zhni bwuznagna, nabai n a taa ɓwa əza, n wo n gaiciyai ga n mi, n wo ɓaa dna n wyegbma m.<verse eid="JHN 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 12:47" />“Zahozahoyi n wo wo əmi aɓədagbma, ama to wa shi əɓa ɓwa m, mi taa da əza yi owa m. Ntuge mi to ɓə ɓe ma da anyì owa nu m, ama ma gnyi anyì. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />Owadayi lo, ntu n əza ɓo n wa na əmi aɓo, jesnu to woi gwo əmi aɓədagbma m; aɓədagbma ye n mi kwu da nyi, əɓa nu ɓə znu wo əknyi dna n nyipyei kpmaknai. <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />Ntuge mi to ɓə da əmihni ɓəda nu m, ama Dada n wo nu ɓə tnu n mii nyi, əwo nu ɓə ga mi ɓəgbetu nge mi da aɓo vnyanya, n mi kwu da nyi. <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />Mi kpəlo nge əwo ɓəgbetu kwo lo n əzai n wyewyeyi nyalonyalo nya nu. Ntulonu, ɓəhoɓəhoi n ma da, əkwo nu ɓwa əɓo zhni n Dada wa gna mi nge mi da.”<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s1">Yeisu zhna əwo amwutuyi apitabwada</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />Gnanaznu awyefna anyipyei ɓai ɓwace fyewyi kwa si, Yeisu woi kwu kpe nge əsa ɓəə la si n wo ɓa fa anyì ye, wa jezelo Dada aba. Shi wo ɓə kwu yeye wu əwo aza n ɓa ɓə fyi n anyì nyi, wa yé n ɓai nya azozo ba.<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />Ɓai kpe ɓai gyi wyeshe nyagyi jesnu Shetam woi la kwo ludna n Yahuda, Sima Iskariyot nugwnu, nge wo ɓwu Yeisu. <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />Yeisu ɓə kpe nge Dada wo kwu anya vnyanya fa fyi n əwo aɓwa, jesnu nge wo ɓə gbmi n Shekwoyi aba nu, jesnu woi jezelo Shekwoyi aba; <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />ntulonu wa laka gnyi n anyagyi gyi aba, wa kpma əwo aje əbmyi nya jesnu wa kwu tawali pa n əwo əshni. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />N dəye avnu, wa ze nuwna fyi n wyewnubwe, wa ya woi zhna əwo amwutuyi apita jesnu woi wnu ɓa ya n tawalii, n wo ɓə ncei pa n əwo əshni nyi.<verse eid="JHN 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 13:6" />Wa ɓe Sima Byitusu aba, Byitusu wa gna wo, “Dagayi, ho ye ha zhna əmi apita nu?”<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />Yeisu wa dnaɓəgbe, “Ho ta kpe əɓo əye lo n mi zhni nsaiye m, ama n abye dəye ho ɓə ɓwa əkwo awyega.”<verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />Byitusu wa gna, “Aawo, ho taa zhna mi apitabwada m nanyinanyi.” Yeisu wa dnaɓəgbe, “Akpəge ma zhna əho apita, a gye nyaho to n hoi todo lo n mii m.”<verse eid="JHN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9" />Sima Byitusu wa dnaɓəgbe, “Ngye nlonu nu, Dagayi, akpəge toge əmi apitabwada nu gbmanyi m, ama əmi aɓwa jesnu n əmi tukwoi ɓədo!”<verse eid="JHN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10" />Yeisu wa dnaɓəgbe, “Aza n ɓa la nuwna fu, ɓa ɓwa gwo ɓa zhna əɓa apitabwada nu; əɓa nayi vnyanya kwo gyigyii lo. Jesnu fye gyigyii lo, kwo shikwonyi əfye vnyanya nu to gyigyiyi lo m.” <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />Ntuge wo ɓəi kpe əza əye n wo ɓə ye wa ɓwu wo, cenu ɓə zhni wa gna nge əɓa vnyanya nu to gyigyii lo m.<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />She wo ɓəə la pwo əɓa apita zhna ɓo, wa kpe əwo aje wa jezelo əwo aseseba njesnu. Wa nya ɓa əɓo, “Fye kwu əɓo awyega ɓwa n mi kwu zhni fye nyi?” <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />“Fye yi mi ‘Nyawuyi’ n ‘Dagayii,’ gaiciya nu n kwoi, ntuge əza nu n mi zhni. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />Nsaiye əmi, n mi zhni əfye Dagayi n Nyawuyii nyi, mi la əfye apitabwada zhna, əfyehni ce, kwo gwo fya zhna aje apitabwada. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />Mi la ofye wu fye fya vyi, nabai fya zhni ngye shi ma zhni fye nyi. <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />Ɓəhnihni əmi nu gna fye, fyenu too lo n wo du əwo Dagayi m, kwo tnutnudayi n du əza n wa tnu wo tnutnu nyi m. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />Nsaiye shi fye kwu aɓo ye kpeye nyi, anabəlikada nu n fyei n fya zhni ɓa.<verse eid="JHN 13:17" /></para>
  <para style="s1">Yeisu pma əwo ɓwuɓwu əɓo da</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />“Mi ta daɓo n əfyei nu vnyanya m; mi kpe aza əye lo n mi la knyí. Ama dəye, ye kwa nu nyakaɓala nu n nyakagyigyiyi: ‘Əza n wo kwnu biledi gyi n mii nyi, wo la pmyitu mi.’ <verse eid="JHN 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 13:19" />“Mi pma fye gna nu nsaiye to kwoi zhni m, nabai shi kwo ɓə zhni, fye ɓe kwu gaiciya ga nge mi zhni əza nu n mi zhni. <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />Ɓəhnihni əmi nu gna fye, əzadəhodəhoyi n wa gwo əza n ma tnu n woi, wo la mi gwo; jesnu əzadəhodəhoyi n wa gwo mi, wo la əza gwo n wo ɓə tnu n mii nyi.”<verse eid="JHN 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />Shi Yeisu ɓə kwu ɓəye da, bwugba kwaa wnu wo dna n zafnu, wa gbmiɓo ge, “Ɓəhnihni əmi nu gna fye, zaknayi n fye, wo ye wa ɓwu mi nu.”<verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />Əwo amwutuyi ɓa shi aje awye n ɓəyeɓwui, nabai ɓa kpe əza əye n a da əwo ɓo. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />Zaknayi n əɓa mwutuyi, n Yeisu ɓə zhni woi ye wo nyi, wo ɓə sasetu n ma wo. <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />Sima Byitusu wa daɓo n mwutuyi yi n əɓwai, “Nya wo əza n wo da əwo əɓo.”<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />N myima n Yeisu agwu, wa nya wo əɓo, “Dagayi, nyika nu a?”<verse eid="JHN 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26" />Yeisu wa dnaɓəgbe, “Əza nu n mi ɓa ga wo biledi pisai ye, əsa mi ɓə la kwo dna n bwoɓyi nyi.” Nlonu, she wo ɓə da biledi dna, wa ga Yahuda kwo, Sima Iskariyot nugwnu. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />She Yahuda ɓə zè n biledi gwogwoi, Shetam wa lodna n wo.</para>
  <para style="p" vid="JHN 13:27">Ntulonu Yeisu wa gna wo, “Əɓo n ho ye ha zhni nyi, zhni kwo n pyepyei.” <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />Ama tu n nyagyi gyi abaayi, zahozahoyi to ɓə ɓwa awyega əɓo n kwo ɓə zhni Yeisu wa daɓo n woi nlonu m. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />Shikwonyi Yahuda nu ɓə zhni əɓa gyiwye shiyi, ɓa ɓə zhninubwo ge Yeisu gna wo nge wo si anya nu n a ɓə ye ntu awyefna ɓo, kwo nge wo ga asnayi nyaho. <verse eid="JHN 13:29" /><verse number="30" style="v" sid="JHN 13:30" />She Yahuda ɓə pwo biledi gyi ɓo, wa gbmiya lo. Njesnu sukwo ɓəə la zhni.<verse eid="JHN 13:30" /></para>
  <para style="s1">Yeisu pma Byitusu aɓəna ɓo da</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />Shi Yahuda Iskariyoti ɓə la gbmiya lo, Yeisu wa gna, “Nsaiye Əza Nugwnu wo la latu ɓwa, jesnu Shekwoyi wo la latu ɓwa dna n Nugwnu. <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />Ngye Shekwoyi wo la latu ɓwa dna n əwo, Shekwoyi ɓa la Nugwnu tu dna n əwohni, jesnu wo ɓaa wo latu n əsagbmanyii.<verse eid="JHN 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 13:33" />“Əmi aɓyi, mi ɓa kwnusnu n fyei n ɓwasnu əsa fyewyi nu. Fye ɓə zna mi shni, ama n ɓwasnu shi mi ɓə gna Ayahudiyi nyi, nlonu n mi gna fye nsaiye: Aba n mi lo nyi, fye taa myi fya ɓe m.<verse eid="JHN 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 13:34" />“Ɓəgbetu woiwoyi nu n mi ga fye: Fye ye n ajei. Ntulonu ɓəshishi nu fya ye n ajei, ngye shi mi kwu ye n fyei nyi, <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />N dəyei nu n zahozahoyi ɓa kpe nge fye zhni əmi amwutuyi nu, n fya yé n ajei.”<verse eid="JHN 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />Sima Byitusu wa nya wo əɓo, “Dagayi, ho lo n nanu a?” Yeisu wa dnaɓəgbe, “Aba n mi lo nyi, fye taa myi fya vyi mi nsaiye m, ama fye ɓə vyi ɓe nsahoi.”<verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />Byitusu wa nyaɓo, “Dagayi, knyi nu zhni minyi taa myi ma vyi ho nsaiye ma? Mi ɓa ga əmi wyewyeyi ntu əho əɓo.”<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />Nlonu Yeisu wa dnaɓəgbe, “Ɓəhnihnii ho ɓa ga əho wyewyeyi ntu mi əɓo? Ɓəhnihnii əmi nu gna ho, Pisenugba ɓə snu n kwo cekwu, hoi la əmi yekpé əɓo na aɓwa ngwnu-ata!”<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s1">Yeisu zhni əwo amwutuyi atna</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />“Fye to fa əfye adu ɓa wnu fye m. Fye kwu gaiciyaga n Shekwoyi; jesnu fye kwu gaiciyaga fyi n mi cè. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />Əmi Dada pwuwa n anyakwnui lo n mwa bəgyé; ngye kwo to ɓə nyi nlonu m, mi ɓə ɓa gna fye nge mi lo mii zhniaba aba nu ga fye? <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />Jesnu n ma lo maa aba zhniaba ga fye, mi ɓə jezeɓe ma kwú fye, fyei kwu kwnusnu n mii, nabai əfyehni ce, fyei kwu fyi ń aba n mi dna. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />Fye kpe zokwo əye lo n kwo lo aba n mi lo nyi.”<verse eid="JHN 14:4" /></para>
  <para style="s1">Yeisu nu zhni zokwo n kwo lo Dada aba</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />Toma wa gna wo, “Dagayi, yi ta kpe aba əye lo n ho lo nyi m, to, yi ɓa kpe zokwo n wuna a?”<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />Yeisu wa dnaɓəgbe, “Əmi nu zhni zokwo jesnu gaiciyanunui n wyewyeyii. Zaho taa myi wa ɓe Dada aba m, akpəge dna n əmi. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />Ngye fye kwu mi kpeye, fye ɓa kpe əmi Dada əye ce. Ənya n kwo laka nsaiye, fye kwu wo kpeye jesnu fye kwu wo gyewye.”<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />Fyilibwus wa gna, “Dagayi, wu yi Dada, jesnu kwo ɓa kwu yi kwnuawye.”<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />Yeisu wa dnaɓəgbe: “Ho ta kpe mi əye lo m, Fyilibwus, əsa n kwo la mwa mii kwnusnu n fyei nyi? Zahozahoyi n wo kwu mi gyewye wo kwu əmi Dada gyewye. Knyiyi nu ɓa zhni ha gna, ‘Wu yi Dada a’? <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />Fye too ga gaiciya nge mi dnalo n Dada, jesnu nge Dada dnalo n mi m? Aɓədagbma n mi gna fye nyi, mi ta da ɓa ń əmihni ikwoi nu m. Ama, Dada nu, n wo dna n mi nyi, əwo nu zhni əwohni tnutnu. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />Ga mi gaiciya əsa ń ma gna nge mi dnalo n Dada jesnu nge Dada dnalo n mi; kwo n wunanu, ga gaiciya ń aɓəgbmi atnutnu n fye kwu gye mii zhni ɓa əmihni nyi. <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />Ɓəhnihni əmi nu gna fye, əzadəhodəhoyi n wa ga gaiciya n mi, wo ɓa zhni atnutnu ń mi zhni nyi, jesnu wo ɓə zhni atnutnu ayaakwo n du adəye, ntuge mi lo da Dada nu. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />Njesnu mi ɓa zhni ɓəhoɓəhoi n fya nyaɓo dna n əmi əye, nabai n Dada ɓa ɓwa latu dna n Nugwnu. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />Fye ɓə myi fya nya nyahonyahoi əɓo dna n əmi əye, jesnu mi ɓə zhni kwo ga əfye.<verse eid="JHN 14:14" /></para>
  <para style="s1">Yeisu shi ɓəgbeshi wa tnu n Zafnu Gyigyiyi</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />“Ngye fye ye mi lo, fye shi əmi aɓəgbetu əɓwa. <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />Njesnu mi ɓa nya Dada əɓo, wo ɓə ga fye bmazhniyi ədo, woi bma fye zhni, woi kwnusnu n fyei nyalonyalo; <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />əwo nu zhni Zafnu gaiciyanunui nya. Anyì taa gwo əwo m, ntuge ɓa too shni wo wyegye, kwo ɓa kpe wo əye m. Ama fye kpe wo əye lo, ntuge wo kwnusnu lo n fyei jesnu wo ɓə la dna n fye. <verse eid="JHN 14:17" /><verse number="18" style="v" sid="JHN 14:18" />Mi taa fa fye ngye akwuwyi m; mi ɓa ɓe da fye. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />Ntna əsa mwai, anyì taa je mi wyegye m kpeekpe, ama fye ɓə gye mi əwye. Ntuge mi n wyewyeyi lo, əfyehni ce fye ɓa ɓwa wyewyeyi. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />Dna n əwyi yi nu n fye ɓə la kwo wnashi nge mi dnalo n Dada, jesnu nge fye fyilo n mi, əmihni dnalo n fye. <verse eid="JHN 14:20" /><verse number="21" style="v" sid="JHN 14:21" />Əzadəhodəhoyi n wo n əmi aɓəgbetui shi, jesnu woi shi ɓa əɓwa, wo zhni əza nu n wo ye mi. Əza n wo ye mi, əmi Dada ɓa ye wo, jesnu əmihni ce ɓa ye wo, ma wu əmihni n əwo aba.”<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />Nsayi Yahuda (toge Yahuda Iskariyoti m) wa gna, “Ama, Dagayi, knyiyi nu zhni ho nyi ye ha wu yi əhohni, ama toge ha wu əhohni n anyì ma?”<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />Yeisu wa dnaɓəgbe, “Zahozahoyi n wo ye mi wo ɓa vyi əmi nyawu. Əmi Dada ɓa ye wo, jesnu yi ɓə ɓe əwo aba, yi la wo zè əyi pwuwa. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />Zahozahoyi n wo ta ye mi lo m, wo taa vyi əmi nyawu m. Aɓədagbma ye n fye wo nyi, ɓa to zhni əmi anya nu m; ɓa zhni Dada anya nu n wo ɓə tnu n mii nyi.<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />“Aɓo ye vnyanya mi kwu ɓa da fye mii ye kwnusnu n fyei. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />Ama bmazhniyi, Zafnu Gyigyiyi, n Dada ɓə tnu woi dna n əmi əye nyi, wo ɓə wu fye aɓo vnyanya jesnu woi pá fye ɓəhoɓəhoi n mi kwu gna fye. <verse eid="JHN 14:26" /><verse number="27" style="v" sid="JHN 14:27" />Mi fa fye zhi n bwugbafui nu; mi ga fye əmi bwugbafu. Mi ta ga fye shi anyì ga nu nyi m. Fye to ye əfye adu ɓa wnu fye m, jesnu fye to wodna m.<verse eid="JHN 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 14:28" />“Fye ɓə kwú wo mii gna, ‘Mi gnyi mii laka nu, jesnu mi ɓe jezeɓe da fye.’ Ngye fye ye mi lo, fye ɓa dagbma nge mi lo da Dada nu, ntuge Dada wo du mi lo. <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />Mi kwu aɓo ye pma fye gna to ɓai zhni kpa m, nabai əsa n kwo ɓə zhni ncei, fyei kwu gaiciyaga. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />Mi taa je ɓəda da n fyei n duya ya m, ntuge əbeɓyi anyì nya ɓe lo. Wo to n nyahoi lo wa shi mi ɓwa ncei m, <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />ama wo ɓe nabai n anyì ɓa kpe nu nge mi ye Dada lo, jesnu mi ɓwa əɓo nu zhni n əmi Dada ɓə tu mi əgbe nge mi zhni. Fye kwukala ɓe, ya lo.<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s1">Wnunùi-gnayi ń əkwo aɓwalai</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />“Əmi nu zhni anamwnunùi-gnayi hnihnii, jesnu əmi Dada nu zhni əkna fwanuyi. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />Wo znu ɓwala dəhodəhoi ya n kwo kpegyi n mi n kwo ta ga gyigyi lo m, ama ɓwala dəhodəhoi n kwo ga gyigyi wo zhni kwo aba nabai n kwo ɓa gna gyigyiga n dudu. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />Fye pma wu lo n gyigyii ntu n ɓədagbma ɓo n mi kwu da ga əfye nyi. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />Fye kwu kpefyi ń mi, ngye shi əmihni ce mi kpedna lo n əfye nyi. Ɓwala ho to lo n kwo ɓa ga gyigyi n əkwohnii m; ɓəshishi nu kwaa kpegyi n anamwnunùi-gnayi. Kwo əfyehni ce, fye taa ga gyigyi m, akpəge fya kwu kpefyi n mi.<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />“Əmi nu zhni anamwnunùi-gnayi; əfye nu zhni aɓwala. N fya kwu kpefyi n mi, əmihni ce dna n fye, fye ɓa ga gyigyi n mwa; ntna mi, fye taa myi fya zhni ɓəhoɓəhoi m. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />N fye to kwu kpefyi n mi m, fye wulo ngye ɓwala nu n a lá kwo sheya kwoi ɓwá; a kwu aɓwala ye pya nu, a sheɓaya fyi n əná, jesnu ɓa gyina. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />N fya kwu kpefyi n mi jesnu əmi aɓədagbma ɓaa kwu kpefyi n fye, fye ɓa nya nyahonyahoi əɓo n fye mwi, jesnu a ɓa zhni kwo ga fye. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />Dəye nu ɓe əmi Dada n latui, nge fye ga gyigyi lo n mwa, fyei wu nge fye zhni əmi amwutuyi nu.<verse eid="JHN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 15:9" />“Ngye shi Dada wo kwu yeye wu mi nyi, nlonu nu n mi kwu yeye wu fye. Nsaiye fye kwu kpefyi n əmi yeye. <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />N fya shi əmi aɓəgbetu əɓwa, fye ɓa kwu kpefyi n əmi yeye, n ɓwasnu shi mi kwu əmi Dada aɓəgbetu shiɓwa jesnu minyi la kpedna n əwo yeye nyi. <verse eid="JHN 15:10" /><verse number="11" style="v" sid="JHN 15:11" />Mi gna fye dəye nabai əmi agbmada ɓa kwu kwnusnu n fyei nu jesnu nabai əfye agbmada ɓa kwu nu. <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />Əmi ɓəgbetu nu nyi: Fye wu aje yeye ngye shi mi kwu yeye wu fye nyi. <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />Əzaho to n yeye yaakwo ədoi lo n du dəye m: əza waa əwo wyewyeyi yashi ntu əwo anugwnudo ɓo m. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />Fye zhni əmi anugwnudo nu, n fya zhni əɓo n ma tu fye əgbe. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />Mi to ye yi fye lo nge atnutnuyi m, ntuge tnutnuyi ta kpe əɓo əye n əwo Dagayi zhni m. N əkwoɓwi, mi yi fye ge anugwnudo nu, ntuge nyahonyahoi n mi la tumwi n əmi Dada, mi kwu kwo wu fye. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />Əfye nu to ɓə knyí mi m, ama əmi nu ɓə knyí fye jesnu ma kwu fye fyi n tnutnu nabai fya lo fye ga gyigyi; gyigyi n kwo ɓa mwasa; jesnu nabai nge nyahonyahoi n fye ɓa nyaɓo dna n əmi əye, n Dada ɓa ga fye kwo. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />Dəye nu zhni əmi ɓəgbetu: Fye wu aje yeye.<verse eid="JHN 15:17" /></para>
  <para style="s1">Anyì wnunu n amwutuyi</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />“Ngye anyì wnunu lo n fyei, fye kwu kpe ge ɓa ɓə kpmi əmi nu nuwnu. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />Fye ɓəə gna fye zhni anyì nya nu, kwo ɓə ɓa wu fye yeye nge fye zhni əkwo nya nu. Ngye shikwo gnyi nyi, fye to zhni anyì nya nu m, ama əmi nu la fye knyí zhi fyi n anyì. Cenuzhni anyì ɓai wnunu n fyei. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />Fye pá əɓo ɓo n mi ɓə gna fye nyi: ‘Tnutnuyi to lo n wo du əwo Dagayi m.’ Ngye ɓa ɓəi kwu mi shewyena, ɓa ɓə kwu fye shewyena ce. Ngye ɓa ɓəi kwu əmi nyawu shiɓwa, ɓa ɓə kwu əfye nyawu shiɓwa ce. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />Ɓa ɓə zhni fye aɓo ń lai ntu n əmi əye ɓo nu, ntuge ɓa ta kpe əza əye lo n wa tnu n mii m. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />Mì to ɓəə gna mi la ɓe ma daɓo n ɓai m, to ɓa ye n leifyi ɓəgyii lo m; ama nsaiye ɓa to n agbmakwnui lo, ntu n əɓa leifyi əɓo m. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />Əzadəhodəhoyi n wo wnunu n mii, wo wnunu n əmi Dadai nu cè. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />Mi to ɓəə gna mi kwu atnutnu ye zhni fyi n əɓa atasni n əzaho too shni zhni m, ɓa to ɓə ɓa ɓwa leifyi ɓəgyi m. Ngye shikwo gnyi nyi, ɓa kwu gye, dudulonu ɓa kwu mi wnunu ɓədo n əmi Dadai. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />Ama dəye, ye kwa nu əɓo nu n kwo kafyilo n Owa: ‘Ɓa wnunu n mii ntna ɓətukwo.’<verse eid="JHN 15:25" /></para>
  <para style="s1">Zafnu Gyigyiyi tnutnu</para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />“She Bmazhniyi ɓə ɓe, əwo n mi ɓə tnu fye n woi nyi, wo gbmi n Dada aba nu; Zafnu gaiciyanunui nya n wo gbmi n Dada aba nu nyi; wo ɓə gbmiɓo tu n əmi tukwo. <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />Njesnu ɓəshishi nu əfyehni ce, fyei gbmi mi əɓo, ntuge fye kwu kwnusnu n əmii tunyi ayayaba.<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />“Mi kwu aɓo ye gna fye vnyanya nabai to fyei myiya m. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />Ɓa ɓə la fye kwnuya n ayahudiyibwokwnu; ɓəhnihnii, əsa ɓe lo n zahozahoyi n wa wnunu n fyei, wo ɓə zhninubwo nge wo zhni Shekwoyi tnutnu nu. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />Ɓa ɓə zhni aɓo ye pya ntuge ɓa too kpe Dada əye kwo əmi m. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />Mi kwu dəye gna fye, nabai nge əsa n aɓo ye əsa ɓə si ncei, fyei pa nge mi ɓə la fye kwnù. Mi to ɓə gna fye aɓo ye n ayayaba m, ntuge mi ɓə kwnusnu n fyei, <verse eid="JHN 16:4" /><verse number="5" style="v" sid="JHN 16:5" />ama nsaiye, mi gnyi mii lo da əwo nu n wo ɓə tnu n mii nyi. Əzaho to lo n fye n wo nya mi əɓo lo ge, ‘Ho lo n nanu a?’ <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />Fye zezè, fye kwu nu zhi n bwugbawnui nu ntuge mi kwu aɓo ye gna fye. <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />Ama ɓəhnihni əmi nu gna fye, kwo bmyalo n əfye aba ge, mi gnyi mii lo. Akpəge ma lo, əfye Bmazhniyi taa ɓe da fye m; ama n ma lo, mi ɓə tnu fye n woi. <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />She wo ɓə ɓe, wo ɓə wu nge anyì dnalo ń abaɓwi ntu leifyi ɓo, ɓədo n ɓəfyecezhnii n owadai: <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />ntu leifyi ɓo, ntuge aza ta ga mi gaiciya lo m; <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />ntu ɓəfyecezhni əɓo, ntuge mi ye ma lo Dada aba nu, aba n fye taa je mi əwyegye m; <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />jesnu ntu n owada ɓo, ntuge a la anyì ye əsuɓyi znuknyi.<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />“Mi ye n aɓəda ajei lo n mwa ma gna fye, n du she fye ɓa shni ɓa əɓwashi nsaiye. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />Ama əsa n əwo, Zafnu gaiciyanunui nya ɓə ɓe, wo ɓə dna fye n ofye zokwo gaiciyanunui nya vnyanya. Wo to ɓə da əwohni ɓəda m; wo ɓə ɓwa əɓo nu da n wa wo, jesnu wo ɓə gna fye aɓo ń ɓa ɓe lo n abye. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />Wo ɓə la mi latu, ntuge wo ɓə gwo əɓo n əmi aba nu n wo ɓə wu fye kwo awyega. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />Anya vnyanya n ɓa zhni Dada anya, ɓa zhni əmi anya nu. Cenuzhni mii gna ge Zafnu ɓə gwo n əmi nu, əɓo n wo ɓə wu fye kwo awyega nyi.”<verse eid="JHN 16:15" /></para>
  <para style="s1">Amwutuyi bwugbawnu kwo ɓə la zè bwugbada</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />Yeisu wa gwodu wa gna, “Əsa fyewyi fye taa je mi wyegye m kpeekpe, ama jesnu n əsa fyewyi kwa duya, fye ɓə gye mi əwye.”<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />She wo ɓə da ɓəye, əwo amwutuyi ho ɓa gna aje nge, “Knyiɓei nu n wo zhninubwo woi gna nge, ‘Dna n əsa fyewyi fye taa je mi wyegye m kpeekpe, jesnu n əsa fyewyi n kwa duya, fye ɓə gye mi əwye a’? Jesnu, ‘Ntuge mi gnyi mii lo Dada aba nu a’?” <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />Ɓa gwodu n ɓənyai, “Wo zhninubwo n wunanu nge, ‘əsa fyewyi a’? Yi too ɓwa awyega əɓo n wo gnyi woi da m.”<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />Yeisu wa kwu gyewye ge ɓa ye lo ɓa nya wo ɓəye əɓo, ntulonu wa gna ɓa, “Fye nya aje əɓo nu əɓo n mi zhninubwo əsa n ma gna, ‘Əsa fyewyi fye taa je mi wyegye m kpeekpe, jesnu n əsa fyewyi kwa duya fye ɓə gye mi əwye a’? <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />Ɓəhnihni əmi nu gna fye, fye ɓə ciɓwi jesnu fyei wnubwugba, ama anyì ɓə nya agbmada. Fye ɓə wnubwugba, ama əfye bwugbawnu ɓə la zè bwugbada. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />Əsa n nyikwoza shi n əɓyima nyasnai, wo zhni wa wo snasna ntuge əwo əɓyima əsa nu gnyi; ama shi wo la kágna, wo zhni wa əwo snasna əɓo zamwi, ntu n əwo bwugbada ɓo nge wo la əɓyi ma dna n anyì. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />Kwo ɓwasnu lo nlonu nu n fyei: Nsaiye əkwo nu zhni əfye bwugbawnu əsa, ama mi ɓə je fye əwyegye, fye ɓə dagbma, jesnu əzaho to ɓə gwo əfye bwugbada ya m. <verse eid="JHN 16:22" /><verse number="23" style="v" sid="JHN 16:23" />Dna n əwyi yi, fye to ɓə je mi ɓəhoɓəhoi nya m. Ɓəhnihni əmi nu gna fye, əmi Dada ɓə ga fye nyahonyahoi n fya nya əkwo əɓo dna n əmi əye. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />Nya əsa ye, fye too nyá nyaho əɓo dna n əmi əye m. Fye nyaɓo fye ɓa gwo, jesnu əfye bwugbada ɓa kwu nu knaaknà.<verse eid="JHN 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />“Kwo shikwonyi mi daɓo lo n fyei n anyìɓəsisi nu, əsa ɓe lo n mi to ɓə je apmazhni n aɓədaye pyai m, ama mi ɓə gna fye əmi Dada əɓo n səsəiya. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />Dna n əwyi yi, fye ɓə nya anya əɓo dna n əmi əye. Mi ta gna ge mi ɓə nya Dada əɓo nu n əfye əɓwi m. <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />Aawo, Dada ye fye lo n əwohnii, ntuge fye kwu yeye wu mi jesnu fye kwu gaiciyaga nge mi ɓe gbmiɓe n Shekwoyi aba nu. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />Mi ɓə gbmiɓe n Dada aba nu, ma lodna n anyì; nsaiye mi gnyi mii fa anyì nu, ma jezelo da Dada.”<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />Nlonu Yeisu amwutuyi ɓa gna, “Nsaiye ho daɓo lo səsəiya toge n aɓəda anyìɓəsisi nyai m. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />Nsaiye yi kwu gyewye ge, ho kpe aɓo ye lo vnyanya jesnu kwo to ye n apmai lo əza wa nya ho əɓo m. Dəye kwo kwu zhni yii ga gaiciya nge ho ɓə gbmiɓe n Shekwoyi aba nu.”<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />Yeisu wa dnaɓəgbe, “Fye kwu gaiciyaga nsayi? <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />Əsa ɓe lo jesnu ɓəhnihni kwo la ɓe, əsa n a ɓə la fye gnámyi, zahozahoyi woi lo əwo pwuwa. Fye ɓə la mi fa gnyi n əmi gbmanyi. Dudulonu mi to gnyi əmi gbmanyi nu m, ntuge əmi Dada kwnusnu lo n mii.<verse eid="JHN 16:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 16:33" />“Mi kwu aɓo ye gna fye, nabai nge dna n əmi nu n fye ɓa ɓwa bwugbafu. Dna n anyì ye, fye ɓa ɓwa bwugbawnu. Ama fye la bwugba dna kalá! Mi kwu nasala gyi tu n anyì tukwo.”<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s1">Yeisu zhniaduwa ntu əwo latu ɓo</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />Shi Yeisu ɓə da ɓəye, wa kpe awye wu n əshe wa zhniaduwa:</para>
  <para style="pm" vid="JHN 17:1">“Dada, əsa kwo la si. La əho Nugwnu latu, nabai n əho Nugwnu wo ɓa myi wa la ho tu. <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />Ntuge əho nu ɓə ga wo ikwo tu n aza vnyanya, nabai n wo ɓa myi wa ga aza vnyanya wyewyeyi nyalonyalo nya, n ho kwu ɓa ga wo nyi. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />Nsaiye dəye nu zhni wyewyeyi nyalonyalo: nge ɓa kpe əho əye, əho nu ɓwa Shekwoyi gaiciyada zhni, jesnu Yeisu Kirisiti, n ho ɓə tnu n woi nyi. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />Mi la ɓe ho n latui dna n əknyi, ntu n tnutnu ɓo n mi kwu zozhni; n ho ɓə ga mi nge mi zhni nyi. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />Nsaiye, Dada la mi latu n əho abye, n latui n mi ɓəə ncei n kwnusnu n hoi nyi, to ai shi anyì m.<verse eid="JHN 17:5" /></para>
  <para style="s1">Yeisu zhniaduwa ntu əwo amwutuyi ɓo</para>
  <para style="pm">
    <verse number="6" style="v" sid="JHN 17:6" />“Mi la ho kpeyawu ga aza yi n ho ɓə kwnu ɓa ga mi fyi n anyì nyi. Ɓa ɓə zhni əho anya nu; ha kwu ɓa ga mi jesnu ɓa kwu əho ɓədagbma shiɓwa. <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />Nsaiye ɓa kpəlo nge nyahonyahoi n ho la ga mi, kwo gbmi n əho aba nu. <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />Ntuge mi ɓə kwu aɓədagbma gna ɓa, n ho ɓə ga mi nyi jesnu ɓaa ɓa gwò. Ɓa kpəlo, to n kpmakpmai m, nge mi ɓə gbmiɓe n əho aba nu, jesnu ɓa kwu gaiciyaga nge əho nu ɓə tnu n Mii. <verse eid="JHN 17:8" /><verse number="9" style="v" sid="JHN 17:9" />Mi zhniaduwa ntu əɓa ɓo nu. Mi ta zhniaduwa ga anyì nu m, ama ntu n aza yi ɓo nu n ho kwu ɓa ga mi nyi, ntuge ɓa zhni əho anya nu. <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />Nyahonyahoi n mi ncei lo, kwo zhni əho nya nu, jesnu əho anya vnyanya n ho ncei lo, ɓa zhni əmi anya nu. Njesnu latu kwo la ɓe da mi ntu əɓa ɓo. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />Mi to ɓə ye gwodu ma dna n anyì m, ama ɓa ye fyilo n anyì, jesnu mi gnyi mii ɓe əho aba nu. Dada Gyigyiyi, kna ɓa n əho əye kalá yi; əye n ho ɓə ga mi, nabai ń ɓa ɓə myi ɓa kwu zè gbmanyi ngye shi yi zhni gbmanyi nu nyi. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />Mii ye kwnusnu n ɓai, mì ɓə la ɓa kna, ma kwu ɓa shi n laafyiyai n əye yii n ho ɓə ga mi nyi. Əzaho too ɓwu m, akpəge əza n a la wo znuknyi ntu agbmazhni ɓo, nabai n Nyakagyigyiyi ye ɓa kwu nu.<verse eid="JHN 17:12" /></para>
  <para style="pm">
    <verse number="13" style="v" sid="JHN 17:13" />“Mi gnyi mii ɓe əho aba nu nsaiye, ama mi da aɓo ye mii ye dna n anyì nu, nabai nge ɓa myi ɓa ɓwa əmi agbmada nunui fyi n əɓa əmi. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />Mi kwu əho ɓədagbma ga ɓa jesnu anyì n kwu ɓa wnunu, ntuge ɓa to ye zhni anyìmi nya nu n shnasnu m, shi mi to zhni anyìmi nya nu nyi m. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />Əmi aduwazhni to nyi nge ho la ɓa kwnu n anyì nu m, ama nge ho knà ɓa ń əzanukwoyi. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />Ɓa to zhni anyì nya nu m, n ɓwasnu shi mi to zhni əkwo nya nu nyi m. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />Pmya ɓa n gaiciyanunui; əho ɓədagbma zhni gaiciyanunui nu. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />Shi ho ɓə tnu n mii dna n anyì nyi, mi kwu tnu n ɓai fyi n anyì. <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />Ntu n əɓa ɓo, mi la əmihni pmya, nabai n əɓa ce n ɓa ɓá myi ɓa kwu zhni apmyapmyaiya hnihnii.<verse eid="JHN 17:19" /></para>
  <para style="s1">Yeisu zhniaduwa ntu avyiyi vnyanya ɓo</para>
  <para style="pm">
    <verse number="20" style="v" sid="JHN 17:20" />“Əmi aduwazhni to ɓwasnu ntu n əɓa ɓo nu gbmanyi m. Mi zhniaduwa ntu n aza yi ɓo nu ce n ɓa ɓəə ga gaiciya ntu n əɓa ɓəda ɓo nyi, <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />nabai əɓa vnyanya ɓai kwu zè gbmanyi. Dada, n ɓwasnu shi ho dnalo n mi, əmihni ce n dna ń ho nyi, fa ɓa kwu fyi ce n yi, nabai anyìmi ɓa ga gaiciya ge əho nu ɓə tnu n mii. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />Latu ń ho ɓə ga mi nyi, mi la ga ɓa, nabai ɓa kwu zè gbmanyi ngye shi yi zhni gbmanyi nu nyi; <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />Əmi n dna ń ɓa, jesnu əho ń dna əmi; nabai n ɓa ɓə kwu lofyi n gbedogwnu nunui. Nlonu n anyì ɓə kpe nge əho nu ɓə tnu n mii, jesnu ho kwu yeye wu ɓai n ɓwasnu shi ho kwu yeye wu mi nyi.<verse eid="JHN 17:23" /></para>
  <para style="pm">
    <verse number="24" style="v" sid="JHN 17:24" />“Dada, mi ye aza yi n ho kwu ɓa ga mi nyi, ɓai kwu kwnusnu n mii n aba n mi dna nyi, jesnu ɓai gye əmi latu əwye, latu n ho la ga mi nyi ntuge ho ɓə kwu yeye wu mii to ai shi anyì m.<verse eid="JHN 17:24" /></para>
  <para style="pm">
    <verse number="25" style="v" sid="JHN 17:25" />“Dada Ɓəfyeceyi, kwo shikwonyi anyì ta kpe ho əye lo m, mi kpe ho əye lo, jesnu ɓa kpəlo nge əho nu ɓə tnu n mii. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />Mi kwu zhni ɓa kwu ho kpeye, jesnu mi ɓə ye gwodu ma zhni ɓa kpe ho əye nabai yeye n ho ncei lo ga əmi nyi, kwaa dna n əɓa mi; nabai əmi n mihni maa dna n ɓa.”<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s1">A lá Yeisu wna</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />She wo ɓə la pwo aduwazhni ɓo, Yeisu n kwnusnu n əwo amwutuyii ɓa kwuka ɓa piyalo Kidiron Bminu. Tu n əkpma dəyi, əkna ɓə dna n abaayi, Yeisu n əwo amwutuyii ɓa lofyi n kwo.<verse eid="JHN 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 18:2" />Nsayi Yahuda, n wo ɓə ɓwu wo nyi, wo ɓə kpe abaayi aba, ntuge Yeisu n əwo amwutuyii ɓə zhni ɓai yezhi ciici n abaayi. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />Ntulonu Yahuda wa ɓe əkna yi, woi wu akwnuyi əkwu zokwo ɓədo n atukwoda hoi ɓai kwnu n apirisiti atukwoda aba n Afarisiyii. Ɓa ɓe n abwusii shi n apyitilai ɓədo n anyagalai.<verse eid="JHN 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 18:4" />Yeisu, woi kpé əɓo ye vnyanya n kwo ye kwa snú wo, wa gbmilo wa nya ɓa əɓo, “Nyika nu n fye ye a?”<verse eid="JHN 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5" />Ɓa dnaɓəgbe, “Yeisu Nazeretiyi.”</para>
  <para style="p" vid="JHN 18:5">Yeisu wa gna, “Əmi nu gnyi nyi.” (Jesnu Yeisu ɓwuyí Yahuda ɓə gnyi n abaayi n kwnusnu n ɓai.) <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />She Yeisu ɓə gna, “Əmi nu gnyi nyi,” ɓa jeze n avnui jesnu ɓa myiya zhi n əknyi.<verse eid="JHN 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 18:7" />Njesnu wa nya ɓa əɓo, “Fye ye nyika nu a?”</para>
  <para style="p" vid="JHN 18:7">Ɓa gna, “Yeisu Nazeretiyi.”<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />Yeisu wa dnaɓəgbe, “Mi kwu gna fye ge əmi nu gnyi nyi. Ngye fye zna əmi nu shni, akpəge fye fa aza ye ɓa lo.” <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />Dəye ɓə zhni nabai aɓədagbma n wo ɓəə kwu da nyi, n ɓa ɓá kwu nu: “Mi too ɓwu əzaho nuwna n aza yi n ho ɓə ga mi nyi m.”<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />Nlonu Sima Byitusu, n wo ɓə n əbeyaakwoi shi nyi, wà wa kwo jesnu wa znu pirisiti dnagbmai tnutnuyi kwo, wa ka əwo tnubwa ɓwaizhe nya ya. (Tnutnuyi yi əwo əye ɓə nyi ge Malkwus nu.)<verse eid="JHN 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 18:11" />Yeisu wa tu Byitusu əgbe, “La əho əbeyaakwo fye n əkwo apwi! Mi taa sni bwoɓyi n Dada wo la ga mi nyi m?”<verse eid="JHN 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />Nlonu akwnuyi okwu ɓədo n okwu yi tukwodai jesnu n Ayahudiyi atukwodai ɓa wna Yeisu. Ɓaa wo pa, <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />jesnu ɓa ɓe n woi n kpmisnu n Anas aba Kayafas yézhi; əwo nu ɓə zhni pirisiti dnagbmai əye yi nya. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />Kayafas nu ɓə zhni əza n wo ɓə ga Ayahudiyi atukwoda shaula nge kwo ɓaa du zaknayi wa fyí ntu n aza ɓo.<verse eid="JHN 18:14" /></para>
  <para style="s1">Byitusu aɓəna kpmisnuyi</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />Sima Byitusu n mwutuyi dəhoi ɓa vyi Yeisu lo. Ntuge pirisiti dnagbmai ɓə kpe mwutuyi ye əye, wa kwnu lodna n Yeisui n pirisiti yaakwo ashilagyí, <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />ama Byitusu waa pmignyi n abwokwnumi. Mwutuyi dəyi n pirisiti dnagbmai ɓə kpe wo əye nyi, wa jezeɓe, wa daɓo n ɓyinyikwoi tnutnuyi n abaayi dna n əwo atnutnu aba, jesnu wa lo ɓe n Byitusui.<verse eid="JHN 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 18:17" />Wa nya Byitusu əɓo, “Ho to zhni əza ye mwutuyi nu m, kwo ho dnalo n əɓa nu a?”</para>
  <para style="p" vid="JHN 18:17">Wa dnaɓəgbe, “Mi to dnalo n ɓa m.”<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />Əse ɓə fu, jesnu atnutnuyi n atukwodai ɓə zhi n shegwnu ɓai wyena n ɓa ɓə ncei fnyizhi ɓai wo gwugwurugwu nyi. Byitusu ɓə gnyi n kwnusnu n ɓai, woi wyena ce.<verse eid="JHN 18:18" /></para>
  <para style="s1">Pirisiti dnagbmai nya Yeisu aɓo</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />Əsa fyewyi, pirisiti dnagbmai wa nya Yeisu aɓo ntu n əwo amwutuyi ɓo jesnu n əwo nyawui.<verse eid="JHN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 18:20" />Yeisu wa dnaɓəgbe, “Mi kwu aɓo da pəipəi ga anyì. Mi ɓə kwu nyawu ciici dna n Ayahudiyibwokwnu kwo dna n Dagayipwuwa, aba n Ayahudiyi yezhi vnyanya. Mi to ɓə da ɓəhoɓəhoi n ɓwuɓwu m. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />Knyiyi nu zhni hoi nya mi əɓo a? Nya aza yi n ɓa ɓə kwu wo mi nyi. Ɓəhnihni ɓa kpe əɓo əye lo n mi ɓəə da.”<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />She Yeisu ɓə da ɓəye, tukwoda ho n wo ɓə gnyi vyivyiwyi n woi, wa dna wo əpmi n awyeba. Wa nyaɓo, “Ho ɓa dna Pirisiti yaakwo ɓəgbe n wu nlai nu?”<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />Yeisu wa dnaɓəgbe, “Ngye mi kwu əɓo nukwoi da akpəge ho gbmi əɓo nukwoi ɓe ncei n mi kwu da nyi. Ama ngye gaiciyanunui nu n ma da, knyiyi nu zhni ho nyi dna mi əpmi a?” <verse eid="JHN 18:23" /><verse number="24" style="v" sid="JHN 18:24" />Nlonu Anas wa tnu n woi n papai lo Kayafas pirisiti dnagbmai aba.<verse eid="JHN 18:24" /></para>
  <para style="s1">Byitusu aɓəna əɓwa baayi n taayii</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />Aɓwazhilo, Sima Byitusu woi ye gnyi n abaayi woi wyena. Ntulonu ɓa nya wo əɓo, “Ho zhni əwo mwutuyi nu cee?” Waa əkwo aɓo na, woi gna, “Əmi nu to m.”<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />Zaknayi n pirisiti dnagbmai atnutnuyi, n wo ɓə todo n əzai n Byitusu ɓə ka wo tnubwa ya nyi, wa cewo awye wa nyaɓo, “Mi to ɓə kwu ho gyewye n kwnusnu n woi dna n əkna m?” <verse eid="JHN 18:26" /><verse number="27" style="v" sid="JHN 18:27" />Njesnu Byitusu wa na əkwo aɓo, n əsayii pisenugba kwa ya əkwuce.<verse eid="JHN 18:27" /></para>
  <para style="s1">Yeisu gnyi n Byilatusu abye</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />Nlonu Ayahudiyi tukwoda ɓa gbmi Yeisu n Kayafas aba ɓa lo n woi n Aromayi gwomna galukwo. Əsa n kwo ɓə gnyi nyi, laabmi nu ɓə gnyi, jesnu nabai to ɓa kwu zè aza acegyeda m, to ɓa lofyi n galukwo m, ntuge ɓa ɓə ncei pma ɓa gyi Gnanaznu nyagyi. <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />Ntulonu Byilatusu wa gbmiɓe da ɓa wa nyaɓo, “Aknyiɓəi nu n fye wna əza ye ncei a?”<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />Ɓa dnaɓəgbe, “Wo to ɓəə gna nge wo zhni akalákpeyi nu m; yi to ɓəə ɓaa wo taya ga ho m.”<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />Byilatusu wa gna, “Fye lo n woi fye da wo owa n əfyehni owai.”</para>
  <para style="p" vid="JHN 18:31">Ɓa naɓo, “Ama yi to n ikwoi lo ya wu zahozahoyi m.” <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />Dəye ɓə zhni nabai əɓo n Yeisu ɓə da ntu n əfyi pya ɓo nu, n wo ɓə ye wa fyí nyi, nabai kwa nu.<verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />Nlonu Byilatusu wa jezelo wa lodna n galukwo, wa tnu Yeisu ɓo, wa nya wo əɓo, “Əho nu zhni Ayahudiyi əsu?”<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />Yeisu wa nyaɓo, “Dəye nu zhni əhohni ɓənubwozhni, kwo azaje nu n kwu əɓo da n hoi n əmi ɓo a?”<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />Byilatusu wa dnaɓəgbe “Mi zhni Yahudiyi nu? Əho aza n apirisiti atukwodai nu n la ho dna n əmi akwnu. Ho kwu knyiɓei nu zhni a?”<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />Yeisu wa gna, “Əmi əbemi to zhni anyì ye nya nu m. Kwo ɓəə gna ge kwo zhni əkwo nya nu, əmi atnutnuyi ɓəə ɓa snugwu to ɓa ye Ayahudiyi atukwoda ɓa wna mi m. Ama nsaiye əmi əbemi kwo gbmi n abado nu.”<verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />Byilatusu wa gna, “A gye ho zhni əsu nu!” Yeisu wa dnaɓəgbe, “Ho kwu da nge mi zhni əsu nu. Ɓəhnihni, əɓo n kwo ɓə zhni a ma mi dna n anyì nyi, əkwo nu ge, ma gbmiɓo tu n gaiciyanunui tukwo. Zahozahoyi n wo ma n gaiciyanunui səpa, wo ɓa kna mi tnubwa.”<verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />Byilatusu wa nyaɓo, “Knyiyi nu zhni gaiciyanunui a?” N dəyei wa gbmiya lo da Ayahudiyi n ɓa ɓə yezhi nyi wa gna ɓa, “Mi too gye ɓəho tu n əwo tukwo m. <verse eid="JHN 18:38" /><verse number="39" style="v" sid="JHN 18:39" />Ama dəye nu zhni əfye kwnunu, nge ma lo zhaluda ho ya ga fye n Gnanaznu sa yi. Fye ye ma lo ‘Ayahudiyi əsu nu ya’?”<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />Ɓa ɓəwyi kpe wo, “Aawo, toge əwo m! Ga yi Barabas nu!” Nsayii Barabas ɓə n əɓwai dna n gyikici ɓo.<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="s1">Owa znunya Yeisu znuznudu nya</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />Nlonu Byilatusu wa la Yeisu ga nge a la wo gyinaya. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />Akwnuyi ɓa pmyi fnunyi aknawui nya ɓaa kwo kwnu wo n tukwo. Ɓa kpe wo əje-kpadalai jeɓwada, <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />jesnu ɓa lo da wo ɓai bmakpe-bmakpe, ɓai gna, “Haamwasa, Ayahudiyi əsu!” Njesnu ɓa ce wo əpmi n awyeba.<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />Byilatusu wa je gbmiya ɓe wa gna Ayahudiyi n ɓa ɓə yezhi n abaayi nyi wa gna, “Fye gyewye, mi gbmi wo ɓe fye ncei nu, nabai fya kwu kpe nge mi too ɓwa ɓəgyi ho tu n əwo tukwo m.” <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />She Yeisu ɓə gbmiɓe n fnunyi aknawui nyai kwnu jesnu n əje-kpadalai jeɓwadai kpe, Byilatusu wa gna ɓa, “To, əza ye gnyi nyi!”<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />Shi apirisiti atukwoda n əɓa abyegyiyii ɓə zè n əwo wyegyei, ɓa ɓəwyi, “A la wo znudu! A la wo znudu!”</para>
  <para style="p" vid="JHN 19:6">Ama Byilatusu wa dnaɓəgbe, “Fye la wo la fyee la wo znudu! Ama əmi, mi too ɓwa ɓəgyi ho tu n əwo tukwo m.”<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />Ayahudiyi atukwoda ɓa kwu gyima, “Yi n owai lo jesnu owa kwa gna ɓəshishi nu wa fyí, ntuge wo yi əwohni nge wo zhni Shekwoyi Nugwnu nu.”<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />She Byilatusu ɓə wo əɓo ye, ədna kwa gna wo wowo, <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />jesnu wa jezelo galukwo əmi. Wa nya Yeisu əɓo, “Ho gbmi ń nanu a?” Ama to Yeisu wa dna wo ɓəgbe m. <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />Byilatusu wa gna, “Ho ta ye lo ha dna mi ɓəgbe m? Ho ta kpəlo nge mi n ikwoi lo maa ho loya kwo ma znu ho du m?”<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />Yeisu wa dnaɓəgbe, “Ho taa ɓwa ikwo tu n əmi to ai ga ho kwo n əshemi nu m. Ntucenu əza n wa dna mi n əho akwnu nyi, əwo nu n ɓəgyi leifyi yaakwo gnadui lo.”<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />Ənya n kwo laka nsayii kwoi lo n abyei, Byilatusu wa zhnatna nge wa lo Yeisu ya, ama Ayahudiyi atukwoda ɓa gwodu n wyiɓei, “N ha fa əza ye waa lo, a gye ho to zhni Kaisa nugwnudo nu m. Əza n wa gna wo zhni əsu nu, wo gnyiapaapa n Kaisa nu.”<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />She Byilatusu ɓə wo ɓəye, wa gbmi Yeisu ɓe ncei jesnu wa sasetu n owada shnikpegye n aba n a yi nge Kwuta Patai nyi (n Aramyiyii yi nge Gabbata). <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />Əwyi yi ɓə zhni nyipyei nu n a vyi anya ɓo zhi ntu n Gnanaznu ɓo; nyipyei atukwogwnu əsa nu ɓə gnyi.</para>
  <para style="p" vid="JHN 19:14">Byilatusu wa gna Ayahudiyi, “Əfye əsu n əfyei gnyi nyi.”<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />Ama ɓa ɓəwyi, “A lo n woi! A lo n woi! Ə la wo znudu!” Byilatusu wa nyaɓo, “Mi la əfye əsu znudu?” Apirisiti atukwoda ɓa dnaɓəgbe, “Yi to n əsui lo m, akpəge Kaisa.”<verse eid="JHN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16" />N kpmasnu Byilatusu wa wo taya ga ɓa, a lo ə la wo znudu.</para>
  <para style="s1" vid="JHN 19:16">Yeisu znuznudu</para>
  <para style="p" vid="JHN 19:16">Ntulonu akwnuyi ɓa gwo Yeisu dna n əɓa akwnu.<verse eid="JHN 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17" />Yeisu wa gbmilo Atukwobwe aba (n Aramyiyii yi ge Gwolgwota nyi) n əwohni znudui shi. <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />N abaayi nu n ɓa ɓə la wo znudu, jesnu azaje ɓə nyi ngwnu-aba; gbmanyi n əwo ɓwaizhe, gbmanyi n əwo ɓwapmi, n Yeisui dna n əɓa atasni.<verse eid="JHN 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 19:19" />Byilatusu wa kwu ɓəgyinyáka ka waa kwo gyitu n znudu. Əkwo nu nyi:</para>
  <para style="pc" vid="JHN 19:19">Yeisu Nazeretiyi, Ayahudiyi Əsu.<verse eid="JHN 19:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="JHN 19:20" />Ayahudiyi bəgyé ɓə la əznù ye ba, ntuge aba n a ɓə n Yeisui znudu tu nyi, kwo ɓə wo vyivyiwyi n əzhiyaakwoi, jesnu a ɓə n əznù yei ka shi n Aramyiyi nu, Latin ɓədo n Girik abyei. <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />Ayahudiyi apirisiti atukwoda ɓa kwukazhi da Byilatusu ɓa gna, “To kakpe ge, ‘Ayahudiyi əsu m,’ ama nge, əza ye yi əwohni nge əwo nu zhni Ayahudiyi əsu.”<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />Byilatusu wa dnaɓəgbe, “Ənya n mi kwu ka, mi kwu ka.”<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />She akwnuyi ɓə lá Yeisu znudu, ɓa kwu əwo aje, ɓa gna ɓa akwu ngwnu-anyi, okwu gbmanyi ntu n əzahozahoyi ɓo, n əje əmìnyai cezhi. Əje ye to ɓə cicii n ɓwaho m, n lului shi gbmanyi kwoi ya ń əshe lo snuta.<verse eid="JHN 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 19:24" />Ɓa gna aje, “Yi to sa kwo ya m. Fa ya knyi əza n əbashei n wo ɓa ɓwa kwo.”</para>
  <para style="p" vid="JHN 19:24">Dəye ɓə zhni nabai kwa nu nyakagyigyiyi nu n kwo gna,</para>
  <para style="q1" vid="JHN 19:24">“Ɓa ɓə la əmi ajekpe gnaya ga əɓahni</para>
  <para style="q1" vid="JHN 19:24">njesnu ntu əmi əje-kpadalai ɓo ɓa she əba.”</para>
  <para style="m" vid="JHN 19:24">Ntulonu əɓo nu nyi n akwnuyi ɓə zhni.<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />Yeisu əya, n əwo əya zadoi, Mariyamwu Kleyopas nyikwo n Mariyamwu Magadalayii, ɓa ɓə zhi n wo vyivyiwyi n Yeisu znudu abai. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />She Yeisu ɓə gye əwo əya gnyi n ɓo, jesnu n mwutuyii n wo ɓə zhni woi ye wo nyi, n gnyi vyivyiwyi n ɓo, wa gna wo, “Nyikwoza, əho nugwnu nu gnyi nyi,” <verse eid="JHN 19:26" /><verse number="27" style="v" sid="JHN 19:27" />jesnu wa gna mwutuyi yi, “Əho əya nu gnyi nyi.” Ənya n kwo ɓə laka nsayii, mwutuyi yi wa lo n Yeisu əyai n əwo pwuwa.<verse eid="JHN 19:27" /></para>
  <para style="s1">Yeisu fyífyi</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />Əsa fyewyi, woi kwu kpe nge ɓəhoɓəhoi kwo kwu zozhni, jesnu nabai nge Shekwoyi nyakagyigyiyi kwa kwu nu, Yeisu wa gna, “Nuwna myikwnu wo mi lo.” <verse eid="JHN 19:28" /><verse number="29" style="v" sid="JHN 19:29" />Nyikwnu anamnuwna mamai ɓə shi n abaayi, ntulonu ɓa da sooso fyi n kwo, ɓa kwu sooso yi gyi n bwusi, ɓa la kwo wulo ncei n Yeisu əgbe. <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />She wo ɓə la anamnuwna mamai towo, Yeisu wa gna, “A kwu zozhni.” N dəyei, wa shni əwo tukwo kwnu jesnu wa dna əsnu.<verse eid="JHN 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />Əwyi yi ɓə zhni nyipyei aɓozhnizhi nya nu ń əkwo fyegyi ɓə zhni Sibyiwyii knyiknyii. Ntuge Ayahudiyi atukwoda to ɓə ncei ye a ya nayi tu n znudu n Sibyiwyi m, ɓa nya Byilatusu nge a bma əɓa apita ya, jesnu aa əɓa anayi kazhi. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />Ntucenu akwnuyi ɓa ɓe, ɓa bma əza kpmisnuyi apita ya, n a ɓə n woi znudu tu n kwnusnu n Yeisui nyi, jesnu n əzabaayi nyai. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />Ama she ɓa ɓə ɓe da Yeisu, ɓa gye wo la lu fyí, to ɓa bma əwo apita ya m. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />N əkwoɓwi, zagbmanyi n akwnuyi wa fnyi Yeisu əshabwusi n abmayi, kwa zhni ami ɓa cepwo n nuwnai. <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />Əza n wo ɓə kwu dəye gyewye, wo la əkwo ɓəgbmi, jesnu əwo ɓəgbmi zhni ɓəhnihni nu. Wo kpəlo nge wo da gaiciyanunui nu, jesnu wo gbmiɓo nabai əhohni ce n ho ɓa myi ha ga gaiciya nu. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />Aɓo ye ɓə zhni nabai nge nyakagyigyiyi kwa nú nu: “A taa bma əwo snúkwnu gbmanyi ho ya m,” <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />jesnu, ngye shi nyakashi ədo ncei da, “Ɓa ɓə shi əza awye n ɓa ɓə fnyi wo ənya nyi.”<verse eid="JHN 19:37" /></para>
  <para style="s1">Yeisu byibyi</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />Əsa fyewyi, Yusufu Arimatiyai wa nya Yeisu nayi ɓo n Byilatusu aba. Yusufu ɓə zhni Yeisu mwutuyi nu, ama n ɓwiɓwi ntu n ədna Ayahudiyi atukwoda ɓo. She Byilatusu ɓə ga əgbe, wa ɓe, wa la nayi lo ncei. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />Ɓa ɓə kwnusnu n Nikwodimwusii nu, əza n wo ɓə lo Yeisu aba n sukwoi nyi. Nikwodimwus wa ɓe n myirii n gbmiaje n aloyii, n əkwo əshnawo ɓə nyi ngye akilo shiita-ceatnu nu. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />Əɓa ngwnu-aba ɓa shni Yeisu nayi ɓa pa kwo, n anyasnidaii, dna n aje luweluweii. Dəye ɓə vyi Ayahudiyi əzabyi kwnunu nu. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />Aba n a ɓə znu Yeisu du nyi, ashnuwnazhni ɓə gnyi n ɓo, jesnu dna n ashnuwnazhni vnyigwo woiwoyi ɓə dna n abaayi, n a to ɓə shni əza byidna n kwo m. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />Ntuge kwo ɓə zhni Ayahudiyi nyipyei aɓəzhnizhi nya nu jesnu shikwonyi vnyigwo ɓə wo vyivyiwyi n abaayii, ɓaa Yeisu byidna n abaayi.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s1">Yeisu nayi to ye dnalo n vnyigwo m</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />N labmilabmii, n nyipyei kpmisnui laadi yi nya, to ənyai kwoi zo knaya m, Mariyamwu Magadalayi wa lo vnyigwo, wa gye a la kwuta pmyiya n vnyigwogbe. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />Ntulonu wa ɓe woi bwusi lo da Sima Byitusu n mwutuyi dəyii, əza n Yeisu ɓə zhni woi ye wo nyi, wa gna, “Ɓa la Dagayi nayi gbmi n vnyigwo jesnu yi ta kpe aba əye lo n ɓa n woi shi m!”<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />Ntulonu Byitusu n mwutuyi dəyii ɓa kwuka lo vnyigwo. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />Əɓa ngwnu-aba ɓai bwusi, ama mwutuyi dəyii waa du Byitusu ya jesnu waa si vnyigwo n əwo abye. <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />Wa ya awyeshi wa gye azafyí aje aluweluwei n ajebwei yakpe n abaayi, ama to wa lodna m. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />Nlonu Sima Byitusu wa kpma ɓe n avnu wa lodna ceewo n vnyigwo. Wa gye aje aluweluwei ajebwe n yakpe n abaayi, <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />ɓədo n əjebwei n a ɓə ncei pa n Yeisu tukwo nyi. Əje yi ɓə ye yakpe n əkwo aba, n kpe n əkwo ɓwai, n aluweluwei nyai əkwo ɓwai ce. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />N kpmasnu mwutuyi dəyii, n wo ɓə la si vnyigwo n abye nyi, wa lodna ce. Wa kwu gyewye jesnu waa gaiciyaga. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />(Ba to ɓə du ɓa ɓwa awyega n Nyakagyigyiyi nge Yeisu ɓə ɓa laka n əfyi m.) <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />Nlonu amwutuyi ɓa jezelo aba n ɓa ɓə fyi nyi.<verse eid="JHN 20:10" /></para>
  <para style="s1">Yeisu wo kpeya da Mariyamwu Magadalayi</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />Nsayi, Mariyamwu ɓə gnyi n əbmyi n vnyigwo aba woi ciɓwi. Shi wo ɓə ciɓwi, wa yami, wa yawyeshi n vnyigwo, <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />wa gye amaləka ngwnu-aba n aje abwuibwui kpe, n sase kpe n aba n Yeisu nayi ɓə shi nyi, gbmanyi n tukwo ɓwa jesnu baayi n apita ɓwa.<verse eid="JHN 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 20:13" />Ɓa nya wo əɓo, “Nyikwoza, knyiyi nu zhni hoi ciɓwi a?”</para>
  <para style="p" vid="JHN 20:13">Wa gna, “Ɓa la əmi Dagayi la, jesnu mi ta kpe aba əye lo n ɓa n woi shi m.” <verse eid="JHN 20:13" /><verse number="14" style="v" sid="JHN 20:14" />N ɓəda yei, wa pmyiawye nlonu wa gye Yeisu n gnyiagnyi gnyi n abaayi, ama to wa kpəge Yeisu nu gnyi m.<verse eid="JHN 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 20:15" />Nlonu Yeisu wa nya wo əɓo, “Nyikwoza, knyiyi nu zhni hoi ciɓwi a? Nyika nu n ho znashni a?” Woi zhninubwo nge əwo nu zhni əkna ofwayi, wa gna, “Haamwasa, ngye ho la wo la nu, wu mi aba n ho n woi shi, ma lo mii la wo.”<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />Yeisu wa gna wo, “Mariyamwu,” Wa pmyiawye wu n əwo əɓwa, jesnu wa sakwu n Aramyiyii, “Rabboni!” (N əkwo nu gyi “Nyawuyi”).<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />Yeisu wa gna, “Too to əmi əɓwa m, ntuge mi too gwnulo Dada aba kpa m. N əkwoɓwi, lo da əmi azaje, ho gna ɓa, ‘Mi gwnulo da əmi Dada aba nu, jesnu n əfye Dadai, da əmi Shekwoyi n əfye Shekwoyii.’ ”<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />Mariyamwu Magadalayi wa lo da amwutuyi n nabagyi manai yei: “Mi la gye Dagayi!” Nlonu wa gna ɓa nge wo kwu aɓo ye gna wo.<verse eid="JHN 20:18" /></para>
  <para style="s1">Yeisu wo kpeya da amwutuyi</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />N wyesheɓwai, n nyipyei kpmisnui laadi yi nya, əsa n amwutuyi ɓə fyi n aba gbmanyi, n əɓa akpakwoi gwu ntu n ədnawo Ayahudiyi atukwoda nya ɓo, Yeisu wa ɓe jesnu wa gnyiagnyi dna n əɓa atasni wa gna, “Bwugbafu kwo kwnusnu n fyei!” <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />Shi wo ɓə kwu ɓəye da, wa wu ɓa əwo aɓwa n abmayii. Əsa n amwutuyi ɓə gye Dagayi əwye ɓa dagbma n mwa.<verse eid="JHN 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 20:21" />Njesnu Yeisu wa gna, “Bwugbafu kwo kwnusnu n fyei! Ngye shi Dada ɓə tnu n mii nyi, mi gnyi nnu mii tnu n fyei.” <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />N ɓəda yei, wa ya əsnu kpe ɓa jesnu wa gna, “Fye gwo Zafnu Gyigyiyi. <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />N fya zo zahozahoyi əwo aleifyi, a kwu əɓa aleifyi zo; n fye to zo əɓa aleifyi m, əɓa aleifyi too zo m.”<verse eid="JHN 20:23" /></para>
  <para style="s1">Yeisu wo kpeya da Toma</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />Nsayi Toma (n a je wo yi nge Didimwus nyi), zaknayi n awoceaba, wo to ɓə kwnusnu n amwutuyii əsa n Yeisu ɓə ɓe nyi m. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />Ntulonu amwutuyi aje ɓa gna wo, “Yi kwu gye Dagayi əwye!” Ama wa gna ɓa, “Akpəge ma gye akwusa acigwusa əwye n əwo aɓwa, jesnu ma dna əmi ɓwanyi aba n akwusa ɓə fyi nyi, jesnu ma dna əmi əɓwa n əwo abmayi əciɓwi, mi taa ga gaiciya m.”<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />Ń laadi gbmanyi avnu, əwo amwutuyi ɓə je fyi n pwuwa jesnu Toma ɓə kwnusnu n ɓai. Kwo shikwonyi akpakwo ɓə gwugwuyi, Yeisu wa ɓe wa gnyiagnyi dna n əɓa atasni jesnu wa gna ɓa, “Bwugbafu kwo kwnusnu n fyei!” <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />Nlonu wa gna Toma, “Dna əho ɓwanyi n ya; gye əmi aɓwa əwye. Ta əho əɓwa ya, ha dna kwo n əmi abmayi. La fa abwugba-aba fyi ɓo jesnu ha ga gaiciya.”<verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />Toma wa gna wo, “Əmi Dagayi jesnu əmi Shekwoyii!”<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />Nlonu Yeisu wa gna wo, “Ntuge ho la gye mi əwye nu, ho nyi ga gaiciya; anabəlikada nu n aza yii n ɓa too gye mi əwye m, dudulonu ɓa kwu gaiciyaga.”<verse eid="JHN 20:29" /></para>
  <para style="s1">Ɓətukwo Yohana nabagyi manai nya</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />Yeisu wa wu aznù bəgyé n əwo amwutuyi awye, n ɓa to kafyilo n pafyi ye m. <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />Ama aɓo ye n kafyi nabai fya ga gaiciya nge Yeisu nu zhni Kirisiti, Shekwoyi Nugwnu, jesnu nge n gaiciyagai nu dna n əwo əye n fye ɓa ɓwa wyewyeyi.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s1">Yeisu n abmyawna ɓəwowoi nyai</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />N dəye avnu Yeisu wa kpeya da əwo amwutuyi, n ma n Gəlili Shikwo. Kwo ɓə zhni nlai nu: <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />Sima Byitusu, Toma (n a je wo yi nge Didimwus nyi), Nataninya n wo gbmi n Kana n Gəlili nyi, Zebədi anugwnu jesnu n amwutuyi ajei ngwnu-aba n ɓa ɓə kwnusnu n ajei nyi. <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />Sima Byitusu wa gna ɓa, “Mi lo abmyawna nu,” ɓa gna cè, “Yi ɓa kwnulo n hoi.” Ntulonu ɓa kwnuya lo ɓa lofyi n əya nuwnanya, ama dna n sukwo yi, to ɓa wna nyaho m.<verse eid="JHN 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 21:4" />N labmilabmii, Yeisu waa gnyi n dnagbe, ama amwutuyi to ɓə kpəge Yeisu nu m.<verse eid="JHN 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 21:5" />Wa yì ɓa, “Anugwnudo, fye too wna əbmya ho m?”</para>
  <para style="p" vid="JHN 21:5">Ɓa dnaɓəgbe, “Aawo.”<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />Wa gna, “Fye she əsa fyi n əya nuwnanya ɓwaizhe ɓwa, fye ɓa wna adəho,” Shi ɓa ɓə she əsa fyi, to ɓa myi n ɓa gnyi əsa m, ntuge abmya ɓə fyi n mwa bəgyé.<verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />Nlonu mwutuyi n Yeisu ye wo nyi, wa gna Byitusu, “Dagayi nu gnyi!” Shi Sima Byitusu ɓə shni wowo woi gna, “Dagayi nu gnyi” wa pa əwo əje əkpma nya shegwnu əwohni (ntuge wo ɓəə la kwo kpmaya) jesnu wa gyeagna dna n nuwna. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />Amwutuyi aje ɓa vyi lo n əyai, ɓai gnyì əsa n nunui n abmyai, ntuge ɓa to ɓə mwakpa n ədnagbei m, ngye amyita tagyi nu ɓəi. <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />Əsa n ɓa ɓə si əkpma, ɓa gye anakna əná əwye n zhi n abaayi, n əbmyai tu n kwo, ɓədo n biledii.<verse eid="JHN 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 21:10" />Yeisu wa gna ɓa, “Fye ɓe n abmya hoi n fye ye ɓwa wna nyi.” <verse eid="JHN 21:10" /><verse number="11" style="v" sid="JHN 21:11" />Nlonu Sima Byitusu wa jezelo dna n əya jesnu wa kwnu əsa ya kpe n əkpma. Kwo ɓə nunui n abmyai n mwa bəgyé, 153, ama, kwo n əɓa bəgyéi, to əsa kwa gbeya m. <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />Yeisu wa gna ɓa, “Fye ɓe ya gyi labminyagyi.” To mwutuyi dəhodəhoi wa myi wa nya wo əɓo, “Ho zhni nyika na a?” Ɓa ɓə kwu kpe nge Dagayi nu gnyi. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />Yeisu wa ɓe, wa la biledi wa ga ɓa kwo jesnu wa ga ɓa abmya. <verse eid="JHN 21:13" /><verse number="14" style="v" sid="JHN 21:14" />Əɓwa taayi nu nyi n Yeisu ɓə kpeya da əwo amwutuyi shi a ɓə la wo kala n əfyi.<verse eid="JHN 21:14" /></para>
  <para style="s1">Yeisu je Byitusu zhnidna n amwutuyi</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />She ɓa ɓə kwu pwo nyagyi gyi ɓo, Yeisu wa gna Byitusu, Sima Yohana nugwnu, “Ho ye mi lo n du anya ye?” Wa gna, “Əə, Dagayi ho kpəlo nge mi ye ho lo.” Yeisu wa gna, “Kpa əmi akwugyasnáyi.”<verse eid="JHN 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 21:16" />Njesnu Yeisu wa gna, “Sima Yohana nugwnu, ho ye mi lo?” Wa dnaɓəgbe, “Əə, Dagayi, ho kpəlo nge mi ye ho lo.”</para>
  <para style="p" vid="JHN 21:16">Yeisu wa gna wo, “Kna əmi aknyi.”<verse eid="JHN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 21:17" />Əɓwa taayi wa gna wo, “Sima Yohana nugwnu, ho ye mi lo?”</para>
  <para style="p" vid="JHN 21:17">Kwaa Byitusu knyibwugba ntuge Yeisu ɓə nya wo əɓo əɓwa taayi nu, “Ho ye mi lo?” Wa gna, “Dagayi, ho kpe aɓo əye lo vnyanya; ho kpəlo nge mi ye ho lo.”</para>
  <para style="p" vid="JHN 21:17">Yeisu wa gna wo, “Ga əmi aknyi nyagyi. <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />Ɓəhnihni nu n mi gna ho, əsa n ho ɓə ye zhni ɓyikasa, ho ɓə zhni hoi kpe aje n əhohnii, ha lo aba n ho ncei pma; ama əsa n ho ɓə la kwo, ho ɓə ta əho əɓwa ya, əzaho nu ɓə kpe ho aje, jesnu woi lo n hoi n aba n ho to ɓə ncei pma ha lo m.” <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />Yeisu ɓə da ɓəye kwa wu əfyi pya nu n kwo ɓə wna Byitusu, kwoi ɓe Shekwoyi n latui. Nlonu wa gna wo, “Vyi mi!”<verse eid="JHN 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />Byitusu wa pmyi wa gye mwutuyi n Yeisu ɓə ye wo nyi, woi vyi ɓa. (Əza ye nu ɓə zhni woi myima n Yeisu agwu n wyeshenyagyi əsai nyi, jesnu wa gna, “Dagayi, nyika nu ye wa kwnu ho a?”) <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />She Byitusu ɓə gye wo əwye, wa nyaɓo, “Dagayi, əwo ce ma?”<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />Yeisu wa dnaɓəgbe, “Ngye mi ncei pmalo waa gnyi n wyewyeyii nya əmi jezeɓe əsa, kwo zhni knyiyi nu n əho aba a? Ɓəshishi nu ha vyi mi.” <verse eid="JHN 21:22" /><verse number="23" style="v" sid="JHN 21:23" />Ntu ɓəye ɓo, gwnunugwnunu kwaa gna lapwi fyi n avyiyi atasni, nge mwutuyi ye to ɓə fyí m. Ama Yeisu to ɓə da nge wo to ɓə fyí m; wo ɓə ɓwa da nu, “Ngye mi ncei pmalo waa gnyi n wyewyeyii nya əmi jezeɓe əsa, kwo zhni knyiyi nu n əho aba a?”<verse eid="JHN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />Mwutuyi yi nu nyi, n wo gbmi əɓo tu n aɓo ye nyi, jesnu əwo nu n kwu ɓa kakpe. Yi kpəlo nge əwo ɓəgbmi zhni ɓəhnihni nu.<verse eid="JHN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />Yeisu ɓə kwu aɓoaje bəgyé zhni ce. A ɓə gna a kwu ɓəhoɓəhoi nu kazhi, mi zhninubwo lo nge, kwo anyì vnyanya taa ɓwa nyakwnu n a ɓa ya apafyi ye fyi m.<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>