<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Oyda New Testament</book>
  <para style="h">2 ጢሞትዮሳ</para>
  <para style="toc1">ጳዉሎሳ ጢሞቶሳስ ጻፍደ ላምእን ኪታ</para>
  <para style="toc2">2 ጢሞትዮሳ</para>
  <para style="toc3">2 ጢሞ.</para>
  <para style="mt1">ጳዉሎሳ ጢሞትዮሳስ</para>
  <para style="mt2">ጻፍደ ላምእን ኪታ</para>
  <para style="imt1">ገለ</para>
  <para style="ip">ጳዉሎሳ ጢሞትዮሳስ ጻፍደ ላምእን ኪታ፥ ጳዉሎሳራ ዎላ ኦችዛያን ጳዉሎሳ ካለ ማድዘ ናአይ ጢሞትዮሳ ዞርደ ዞርቶ አይክዳ። ይና ዞርትስ ኣፈ ቆፍታ፥ «ዳንዳአራ ምንጎደስ ቤዛነ» ጋዛኖ። ጢሞትዮሳ ዞርተራ ምን ቃላ ኤክደ፥ የሱስ ክርስቶሳ ባዝ ቱርቶ ማርክደ ፋና ዎንገለ ቃላን ጋልአ ጫቆ ትምርትቶ ምን አይኮደ ፋናን ማን እጻን ጋንግኮን ታማርስተራን ዎንገለ ሳባኬራ ምንጎደ ፋና።</para>
  <para style="ip">ጢሞትዮሳ ጨር ቦዛት ላሌፓ Ꮉኮደ ፋና ዱማ ምን ዞረ ኤስ እንግንትዳ። ይኒ ፋና ኦህዘ አሱንና ብሳነ ፋትን አኮን ማዶስ።</para>
  <para style="ip">ይና ኡባነ ጢሞትዮሳ ቆፖደስ ቤዝዘ፥ ጳዉሎሳ Ꮉንቶን ኤ የስቶ ይናን፥ ኤ አማንቶ፥ ኤ ገንጭቶ፥ ኤ ሲቅቶ፥ ኤ ዳንዳእቶን ኤዛ የልደ ማቶ አዝዘ ማህ ካሎዳኖ። ጳዉሎሳ ይና ኪቶ ጻፍዳና፥ ኤ ፋ ዎቶ Ꮉሲ Ꮉይቆስ ጊግንትደ ዎድተ።</para>
  <para style="iot">ኣፈ ቆፉን</para>
  <para style="io1">ገለ ቆፋ <char style="ior"><ref loc="2TI 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">ጢሞትዮሳስ እንግንትደ ዞረ <char style="ior"><ref loc="2TI 1:3-2:13">1:3—2:13</ref> </char></para>
  <para style="io1">ዉርሱ ዎደባዝ <char style="ior"><ref loc="2TI 2:14-4:5">2:14—4:5</ref> </char></para>
  <para style="io1">ጳዉሎሳ Ꮉኒ የዘ የስ <char style="ior"><ref loc="2TI 4:6-18">4:6-18</ref> </char></para>
  <para style="io1">ጻ ቆፋ <char style="ior"><ref loc="2TI 4:19-22">4:19-22</ref> </char></para>
  <chapter number="1" style="c" sid="2TI 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1"/>ጾዘ ቆፋ፥ የሱስ ክርስቶሳራ የዘ ኡፋይስ እንግደ ባጋራ የሱሳ ክርስቶሳ ሐዋረ ማቅደ ጳዉሎሳፓ ኪትንትደ፥ <verse eid="2TI 1:1"/><verse number="2" style="v" sid="2TI 1:2"/>ታ ካዽዘ ናአይ ጢሞትዮሳስ።</para>
  <para style="p" vid="2TI 1:2">ጾዘ አዳይፓን ኑ ላ ክርስቶሳ የሱሳፓ አ ኬሃት፥ ማሮትን ሳሮት ኔስ ማቀ።<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ACT 16:1">ሐዋ. 16:1</ref></char></note><verse eid="2TI 1:2"/></para>
  <para style="s1">ጢሞትዮሳስ እንግንትደ ዞረ</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3"/>ታኒ፥ ታ ዎስተ ቃማን አዋራ ነና ቆፓነ። ታኒ ዎስዘ ዎደ ታ አዱን ጾዛን ታኒ ሎኦ ዎዝናራ ማድዘ ጾዛ ነ ግሾ ጋላታነ። <verse eid="2TI 1:3"/><verse number="4" style="v" sid="2TI 1:4"/>ታኒ ነ አፉቶ ቆፓነ፤ ነና ብእ ኡፋይቶደስ ጋማ አሙዳ።<verse eid="2TI 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TI 1:5"/>ማህ ኔስ የዘ ቱሪ አማኖ ኤራነ። ይኒ ፋና አማንታ ዛጋ ነ ኣፍቲ ሎይድራን ነ እንት ኤዉንቀራ የዘ አማንት ፋና። <verse eid="2TI 1:5"/><verse number="6" style="v" sid="2TI 1:6"/>ይኒ ግሾ፥ ታኒ ታ ኩሽቶ ኔላ አፋ ጋድደ ዎደ ጾዚ ኔስ እንግደ እሞ ኔኒ ማህ ኤደ ዎይ ደንደ ፋና ቆፍዛነ።<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="ACT 16:1">ሐዋ. 16:1</ref></char></note> <verse eid="2TI 1:6"/><verse number="7" style="v" sid="2TI 1:7"/>አኮስ ጋይኮ፥ ጾዚ ኑስ ዎልቃ፥ ሲቆን ኑ ኦምቶ አህዘ አያና እንጋነ ፋትን ዣሽትዘ አያና እንግካያ።<verse eid="2TI 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8"/>ይኬ፥ ኑ ላስ ማርክደስ ዬልፐ፤ ማህ ኤ ግሾ አጭንትደ ታ ግዳን ዣሽትፐ። የዝን ጾዚ ኔስ እንግዘ ዎልቂተ ዎንገለ ግሾ ታራ ማ ኤኮ። <verse eid="2TI 1:8"/><verse number="9" style="v" sid="2TI 1:9"/>ጾዘ ፋ ቆፍቶን ፋ አ ኬሃትራ ኑና አሺ፥ ፋ ጌሽ ዎርዣ ማሆደስ ኑና ዶርዳ ፋትን ኑኒ ኦችደ ኦቻ ግሾ ባያ። ይና አ ከሃትታ ክርስቶሳ የሱሳ ባጋራ አላመ መንቶዳንፓ ቲኖ ኑስ እንግንትዳ። <verse eid="2TI 1:9"/><verse number="10" style="v" sid="2TI 1:10"/>Ꮉተ Ꮉይ አ ኬሃትዘ ኑና አሽዘ ክርስቶሳ የሱሳ የእተ ቆንጭዳ። ኤ Ꮉይቆ ዎልቃ ብሲ፥ ዎንገለ ባጋራ ቦሰ ደኦ ኑስ ቆንጭዝዳ።<verse eid="2TI 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11"/>ታኒ ዎንገለ ሳባክዘ፥ ሐዋረን አስታማረ ማቆደ ጋር ጾዚ ታና ዶርዳ። <verse eid="2TI 1:11"/><verse number="12" style="v" sid="2TI 1:12"/>ታኒ ይኒ ግሾ Ꮉና ማቶ ኤካነ፤ የዝን ታ አማንዘ ኦና የዛኮ ኤርዘ ግሾ ዬልኦስ። ታስ እንግንትደ Ꮉዳርቶ ይና ክርስቶሳ የኤ ቃማ የሎደስ ኤ ናጎደስ ዳንዳእዛኖ ኤራነ።<note caller="-" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="1TI 2:7">1 ጢሞ. 2:7</ref></char></note><verse eid="2TI 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 1:13"/>ታኒ ነና ታማርስደ ቱሪ ቃላ አዝዘ ማህ አይኪ ክርስቶሳ የሱሳ ባጋራ የዘ አማንተን ሲቅተ የዞ። <verse eid="2TI 1:13"/><verse number="14" style="v" sid="2TI 1:14"/>ኑ ግዳ የዘ ጌሽ አያና ዎልቃራ ኔስ እንግንትደ ሎኦ Ꮉዳርቶ ናጎ።<verse eid="2TI 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15"/>እስያ አዉራጃ የዘ ኡቡን ታፓ Ꮉክዳኖ ኤራነ፤ ኡን ግዳ ፍገሉሳን ሄርሞገኔሳ የነ።<verse eid="2TI 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 1:16"/>አነስፎራ ታና ጋማ ዎደ ምንደ ግሾ ላ ኤ ካራ አሱንስ ይቅስንቶ። ታ አጭንትንን ኤ ዬልካያ። <verse eid="2TI 1:16"/><verse number="17" style="v" sid="2TI 1:17"/>ይንላ አፋ ኤ ሮመ ካታማ ይእደ ጋር ታና ምን ኮይ ደንግዳ። <verse eid="2TI 1:17"/><verse number="18" style="v" sid="2TI 1:18"/>ዉርሱ ቃምተ ላ ይቅስንቶደ ፋና ታኒ ላ ዎሳነ። ኤፈሶነ ካታማ ኤ ታና አኮ ጋር ማደዛኮ ነ ሎይ ኤራነ።<verse eid="2TI 1:18"/></para>
  <chapter eid="2TI 1"/>
  <chapter number="2" style="c" sid="2TI 2"/>
  <para style="s1">አማንንትደ ክርስቶሳ ዎታዳረ ማቀ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1"/>ይኬ፥ ታ ናአዮ፥ ክርስቶሳ የሱሳ ግዳ የዘ አ ኬሃትተ ምንጎ። <verse eid="2TI 2:1"/><verse number="2" style="v" sid="2TI 2:2"/>ጋማ ማርኩን ቲኖ ታኒ ነና ታማርስደ ትምርትቶ፥ መሉንና ታማርሶደስ ዳንዳእዘ አማንንትደ አሱንስ Ꮉዳራ እንጎ።<verse eid="2TI 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3"/>የሱስ ክርስቶሳ ሎኦ ዎታዳረ ማቂ ታራ ማ ኤኮ። <verse eid="2TI 2:3"/><verse number="4" style="v" sid="2TI 2:4"/>ኦላ ዎታዳረ ፋ Ꮉላቅዛ ኡፋይሶደስ ጊግንታነ ፋትን መለ ኦቻላ ፋና ፌሾስ። <verse eid="2TI 2:4"/><verse number="5" style="v" sid="2TI 2:5"/>ይኒ ጋራ፥ ጋልጋደ ዎጽዘ ኦንን ቤዝዘ ኦገራ ዎጻንጽኮ ዎይቶ ኤኮስ። <verse eid="2TI 2:5"/><verse number="6" style="v" sid="2TI 2:6"/>ዎታራ ላቢዘ ጋደ አዳይ ፋ ላቢዳን ኣፍትፓ ሙእዘ ቲኖ አስ ማቃደስ ቤዛነ። <verse eid="2TI 2:6"/><verse number="7" style="v" sid="2TI 2:7"/>ላ ኔስ ኡባ ባዛ አካኬ እንግዘ ግሾ ታ ኔስ ኦህዛኖ ነ ዎዝንተ ናጎ።<verse eid="2TI 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8"/>ታኒ ማርክዘ ዎንገለ ፋና Ꮉይቆፓ ደንድደ፥ ዳዉተ ኮች ማቅደ የሱስ ክርስቶሳ ቆፖ። <verse eid="2TI 2:8"/><verse number="9" style="v" sid="2TI 2:9"/>ታኒ ዎንገለ ኦህዘ ግሾ ኢታ ባዝ ኦችደ አስ ፋና፥ አጭንቲ ማ ኤክዳ። የዝን ጾዘ ቃላ አጭንቶስ። <verse eid="2TI 2:9"/><verse number="10" style="v" sid="2TI 2:10"/>ይኒ ግሾ፥ ጾዘ ዶርደ አሱን ክርስቶስ የሱሳ ግዳ የዘ አቶት ባጋራ መዽና ቦንቾ ኤኮደ ፋና ኡን ግሾ ኡባ ባዛ ምንጋነ።<verse eid="2TI 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 2:11"/>Ꮉንፋና ያጋዘ ቱሪ ቃላ የነ፤</para>
  <para style="q1" vid="2TI 2:11">«ኑ ኤራ Ꮉይቅኮ፥</para>
  <para style="q2" vid="2TI 2:11">ኤራ ዎላ የሳዳ።<verse eid="2TI 2:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="2TI 2:12"/>ኑ ገንጭኮ፥</para>
  <para style="q2" vid="2TI 2:12">ኤራ ዎላ ካእቶዳ።</para>
  <para style="q2" vid="2TI 2:12">ኑ ኤዛ ካድኮ፥</para>
  <para style="q2" vid="2TI 2:12">ኤ ኑና ካዶዳ።<verse eid="2TI 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13"/>ኑ አማንንታንጽኮን፥<note caller="-" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="MAT 10:33">ማቶ. 10:33</ref>፤ <ref loc="LUK 12:9">ሉቃ. 12:9</ref></char></note></para>
  <para style="q2" vid="2TI 2:13">ኤ አማንንትዳያ ማቂ የሳዳ።</para>
  <para style="q2" vid="2TI 2:13">አኮስ ጋይኮ፥ ኤ ፋና</para>
  <para style="q2" vid="2TI 2:13">ካዶደስ ዳንዳኦስ» ያጋይዳ።<verse eid="2TI 2:13"/></para>
  <para style="s1">ምን ኦቻንቾ</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14"/>ኔኒ ኡንታና Ꮉኖ ቲርዞ፤ ኡን ቃላ ግሾ ላላመ ፋና፥ ጾዘ ቲኖ ኡንታና ዞሮ። ይና ስእዙንና ብሳነ ፋትን አኮን ማዶስ። <verse eid="2TI 2:14"/><verse number="15" style="v" sid="2TI 2:15"/>ኔኒ ቱሪ ቃላ ሉለራ ታማርስዛን ዬሊዞሰ ኦቻንቾ ማቂ፥ ጾዘ ቲኒ ኡፋይስዘ አስ ፋና፥ ነናትቶ ኤስ ሺሾደስ ምንጎ። <verse eid="2TI 2:15"/><verse number="16" style="v" sid="2TI 2:16"/>የዝን Ꮉና አላምትስ ጊግዘ ማዶሰ ኦሄፓ Ꮉኮ። ይኒ ፋና ኦህዘ አስ ጾዛፓ Ꮉክዛነ። <verse eid="2TI 2:16"/><verse number="17" style="v" sid="2TI 2:17"/>ይኒ ፋና ትምርተ ጋላ ሙእ Ꮉስዘ ፋጾሰ ጭቶ Ꮉርገ ፋና። ይኒ ፋና ኦሄ ኦህንትዙን ግዳ ፋ ሄመነዮሳን ፍልጾሳ የነ። <verse eid="2TI 2:17"/><verse number="18" style="v" sid="2TI 2:18"/>Ꮉን አሱን ቱሪ ኦገ አሺ፥ «Ꮉይቂደ አሱን Ꮉይቆፓ ዛጋ ደንድዳ» ያጋእ ኤራ አሱን አማንቶ ብስዳ።<verse eid="2TI 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 2:19"/>ማቆ የዝን፥ ጾዚ ምን ባሳ ዪጺ ማታመ የዘ ኤንእንቶደስ ዳንዳኦስ። እዝላን አፋ፥ «ላ ፋ አሱንና ኤራነ። ላ ሱንቶ ጼግዘ ኦንን ኢታ ኦቻፓ Ꮉኮ» ያጋዘ ቃላ ጻፍንትዳ።<verse eid="2TI 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20"/>ፈቲ ዳማ ኬ ዎርቃፓ ዎይ ብራፓ ኦችንትደ ሚሸ ጻላላ ባይዝን ምንጻፓ ዎይ ሎቃፓ ኦችንትደ ሚሸ የነ። የንሳፓ ባጉን ቦንቾስ፥ ማህ ባጉን ቦርንትደ ኦቻስ ፌዣነ።<note caller="-" style="x"><char style="xo" closed="false">2:20 </char><char style="xt" closed="false"><ref loc="NUM 16:5">ፋይዶ 16:5</ref></char></note> <verse eid="2TI 2:20"/><verse number="21" style="v" sid="2TI 2:21"/>ይኒ ግሾ፥ ኦንን ኢታ ኡባ አሺ ፋና ጌሽኮ፥ ቦንቾ ኦቻስ ማቅዘ ሚሸ ማቃዳ። ኡን ደእተ ጌሽን ላ ኡፋይስዘ ኦቻ ኡባ ኦቾደስ ዳንዳእዙንና ማቃዳ።<verse eid="2TI 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22"/>ናእቱሞ ኢታ አሞፓ Ꮉኮ። ጌሽ ዎዝናራ ላ ጼግዘ አሱንራ ዎላ፥ ጽሎት፥ አማኖ፥ ሲቆን ሳሮት ካሎ።<verse eid="2TI 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2TI 2:23"/>የዝን ካች መዛ ኤሪ ቦዛትን ማደ ባይዘ ላለፓ Ꮉኮ። <verse eid="2TI 2:23"/><verse number="24" style="v" sid="2TI 2:24"/>ላ ኦቻንቾ አስ ኡባስ ኬሃ፥ ሎኦ ታማርስዛን ዳንዳአንቾ ማቃደስ ቤዛነ ፋትን ካጭንቶደስ ቤዞስ። <verse eid="2TI 2:24"/><verse number="25" style="v" sid="2TI 2:25"/>ኤ ፋራ ኤቅንትዙንና ኬሃትራ ሴርዛ ማቃደስ ቤዛነ። ኡን ፋ ናጋርትፓ ማቂ ቱሮ ኤሮደ ፋና ጾዚ ኦቾድየዛኮ ኦደ ኤርዘ። <verse eid="2TI 2:25"/><verse number="26" style="v" sid="2TI 2:26"/>ኡን ፋ ዎዝናጎ ማቂ ፋ ቆፋ ኦቾደ ፋና ኡንታና አይክደ ጻላሄ ጽኬፓ ኬሲ ኤኮዳ።<verse eid="2TI 2:26"/></para>
  <chapter eid="2TI 2"/>
  <chapter number="3" style="c" sid="2TI 3"/>
  <para style="s1">ዎደ ዉርሱ ቃማስ ማላ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1"/>ዉርሱ ቃማ ኡንእዘ ዎደ ዮኦዳኖ ኤሮ። <verse eid="2TI 3:1"/><verse number="2" style="v" sid="2TI 3:2"/>አሱን ፋና ካዙንና፥ ሚሸ ሲቅዙንና፥ ጬቅንትዙንና፥ ኡቱርዙንና፥ ጫዥዙንና፥ ፋና የልዱንስ ኪትንቶሱንና፥ ጋላቶሱንና፥ ጌሻት ባይዙንና፥ <verse eid="2TI 3:2"/><verse number="3" style="v" sid="2TI 3:3"/>ሲቆ ባይዙንና፥ ማሮት ኦቾሱንና፥ ዝግርዙንና፥ ፋና አሆሱንና፥ ይቅስንትሞ ባይዙንና፥ ሎኦ ካኦሱንና፥ <verse eid="2TI 3:3"/><verse number="4" style="v" sid="2TI 3:4"/>ሞርከስ አ እንግዙንና፥ ቆፋ ባይዙንና፥ ኡቱራራ ኩምዱንና፥ ጾዛፓ አ አሾ ኡፋይሶደስ ካዙንና ማቃዳ። <verse eid="2TI 3:4"/><verse number="5" style="v" sid="2TI 3:5"/>ኡን አማንዘ አስ አዛነ ፋትን ጾዘ ዎልቃ ካድዳ፤ ነ የን ፋና የዘ አሱንፓ Ꮉኮ።<verse eid="2TI 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 3:6"/>ኡንታፓ ፈተ ፈተ አስ ኬ ገሊ ናጋራራ አይክንትዱንና ዱማ ዱማ አሞራ አይክንትደ አማኖ ላፋ ማቹንና አይካነ። <verse eid="2TI 3:6"/><verse number="7" style="v" sid="2TI 3:7"/>የን ማቹን ኡባ ዎደ ታማራነ፥ የዝን ቱሮ ኤሮደስ ዳንዳኦስ። <verse eid="2TI 3:7"/><verse number="8" style="v" sid="2TI 3:8"/>ያነሳን ያምባሬሳ ሙሴራ ኤቅንትዳን ፋና Ꮉን አሱን ዎዝና ኦቾሱንናን አማኖራ ጎልእደ አሱንና ማቅደ ግሾ ቱርራ ኤቅንታነ። <verse eid="2TI 3:8"/><verse number="9" style="v" sid="2TI 3:9"/>የዝን ያነሳን ያምባሬሳ ኤያትታ ቆንጭዳን ጋር ኡን ኤያትታ አስ ኡባ ቲኖ ቆንጮደ ግሾ ኡንትስ Ꮉኖስ።<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="EXO 7:11">ከዘ 7:11</ref></char></note><verse eid="2TI 3:9"/></para>
  <para style="s1">ዉርሱ ዞረ</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10"/>የዝን ነ ታ ትምርትቶ፥ ታ የስቶ፥ ታ ቆፍቶ፥ ታ አማንቶ፥ ታ ዳንዳእቶ፥ ታ ሲቅቶ፥ ታ ገንጭቶ፥ <verse eid="2TI 3:10"/><verse number="11" style="v" sid="2TI 3:11"/>ታ ባይእንቶ ታ ዋይቶ ኤራነ። አንጾክያ፥ እቆንዮነ፥ ልስጥራ ካታማ ታና የልደ ባዝን ታ ዳንዳእደ ዋይቶ ኤራነ፤ ላ ታና ይና ኡባንፓ አሽዳ። <verse eid="2TI 3:11"/><verse number="12" style="v" sid="2TI 3:12"/>ክርስቶስ የሱሳ ግዳ ጾዛ ኡፋይስዘ የስ የሳደስ ኮይዘ ኡቡን ባይእንቶዳ።<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="ACT 13:14-52">ሐዋ. 13:14-52</ref>፤ <ref loc="ACT 14:1-20">14:1-20</ref></char></note> <verse eid="2TI 3:12"/><verse number="13" style="v" sid="2TI 3:13"/>ኢታ አሱንን ባልዙን ፋስ ባልንትተራ መሉንና ባልተራ ቲኖስትፓ ኢቲ ኢቲ Ꮉንጎዳ።<verse eid="2TI 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 3:14"/>የዝን ነ ታማርዳነን ነ አማንደ ቱርተ ኤቆ። ነ ኦደፓ ታማረዛኮ ኤራነ። <verse eid="2TI 3:14"/><verse number="15" style="v" sid="2TI 3:15"/>ኔኒ ነ ናአትፓ ዳን ክርስቶስ የሱሳ አማኒ አቶት በንትዘ ጭንጫት እንጎደስ ዳንዳእዘ ጌሽ ማጻፈ ኤርዳ። <verse eid="2TI 3:15"/><verse number="16" style="v" sid="2TI 3:16"/>ጌሽ ማጻፈ ኡባ ጾዘ አያና ካልን ጻፍንትደ ቃላ። የ ማጻፍዘ ቱሮ ታማርሶደስ፥ ባልዱንና ሴሮደስ፥ ሉልሳደስን ጽሎት የስ ኮሽዘ ዞረ እንጎደስ ማዳነ። <verse eid="2TI 3:16"/><verse number="17" style="v" sid="2TI 3:17"/>ጾዘ አስ ፎሎን ሎኦ ኦቻ ኡባስ ጊግዳያ ማቃደ ፋና ማዳነ።<verse eid="2TI 3:17"/></para>
  <chapter eid="2TI 3"/>
  <chapter number="4" style="c" sid="2TI 4"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1"/>ታኒ ነና ጾዘ ቲኖን፥ ካት ማቂ አሆደስ ቆንጭዘ ዎደ ፋጹንናን Ꮉይቂዱንና ፍርዶደስ የዘ ክርስቶስ የሱሳ ቲኖ ዞራነ። <verse eid="2TI 4:1"/><verse number="2" style="v" sid="2TI 4:2"/>ቃላ ኦሆ፤ ዎደ ጊግን ጊጋንጽን ምን ኦሆ። ጋማ ዳንዳአራን ታማርሰራ አሱንና ዞሮ፥ ሴርተራ ምን። <verse eid="2TI 4:2"/><verse number="3" style="v" sid="2TI 4:3"/>አሱን ቱሪ ትምርተ ስአንጾደ ዎደ ዮኦዳ። ኡን ፋ አሞት ካሊ፥ ፋስ ስኦደስ ኡፋይስዘ ባዝ ኦህዘ አስታማሩንና ሺሻነ። <verse eid="2TI 4:3"/><verse number="4" style="v" sid="2TI 4:4"/>ኡን ቱርባዝ ኦህዘ ትምርተ አሺ፥ ቱሮ ማቆሰ ቶሴ ስኦደስ ፋ Ꮉይቶ ማሀነ። <verse eid="2TI 4:4"/><verse number="5" style="v" sid="2TI 4:5"/>የዝን ኔኒ ኡባ ባዛራ ነና አሆ። ማ ዳንዳኦ። ዎንገለ ማርካት ኦችቶ ኦቾ። ኔስ እንግንትደ ጾዘ ኦችቶ ኡባ ፎሎ።<verse eid="2TI 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6"/>ታኒ ዣርሾ ፋና ዣርሽንቶደ ዎደ የልዳ፤ Ꮉና አላምቶ አሺ ቅትዘ ዎደ ኡክዳ። <verse eid="2TI 4:6"/><verse number="7" style="v" sid="2TI 4:7"/>ታኒ ሎኦ ኦላ ኦልንትዳ፤ ዎቶ Ꮉስዳ፤ አማኖ ናግዳ። <verse eid="2TI 4:7"/><verse number="8" style="v" sid="2TI 4:8"/>ቲኖፓ ጽሎት ዎርቃ ዛዉደ<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="fk" closed="false">ጽሎት ዎርቃ ዛዉደ፦ </char><char style="ft" closed="false">ጽሎት ደኦ ግሾ ታ ኤኮደ ዎርቃ ዛዉደ። ጽሎትቶ ታስ ዎርቃ ዛዉደ ማህ እንጋነ ጋኤ።</char></note> ታና ናጋነ። ይኖ ጽሎ ፍርዳ ፍርድዘ ላ ይኖ ላምእን የኤ ቃምተ ታስ እንጎዳ። ይኖ ታ ጻላላስ ባይዝን ኤ ቆንጭቶ አሙዘ ኡቡንስ እንጎዳ።<verse eid="2TI 4:8"/></para>
  <para style="s1">ጳዉሎሳ ፋ ኦማ ኪታ</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9"/>ኤልሲ ይእ ታና ቦኦ። <verse eid="2TI 4:9"/><verse number="10" style="v" sid="2TI 4:10"/>ዴማሳ Ꮉና አላምተ የዘ ባዝ ካ፥ ታና አሺ፥ ተሰሎንቄ ካታማ ቅትዳ። ቀርቅሳ ጋላትያ ሳአ፥ ማህ ትቶ ድልማጠ ሳአ ቅትዳ። <verse eid="2TI 4:10"/><verse number="11" style="v" sid="2TI 4:11"/>ሉቃሳ ጻላላ ታራ የነ። ማርቆሳ ጾዘ ኦቻ ታና ማዶደስ ዳንዳእዘ ግሾ ኔራ ኤኪ ዮኦ።<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="COL 4:14">ቆላ. 4:14</ref>፤ <ref loc="PHM 1:24">ፍልሞ. 24</ref>፤ <ref loc="2CO 8:23">2 ቆሮ. 8:23</ref>፤ <ref loc="GAL 2:3">ጋላ. 2:3</ref>፤ <ref loc="TIT 1:4">ትቶ 1:4</ref></char></note> <verse eid="2TI 4:11"/><verse number="12" style="v" sid="2TI 4:12"/>ታኒ ትክቆሳ ኤፈሶነ ካታማ ዳክዳ።<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="COL 4:14">ቆላ. 4:14</ref>፤ <ref loc="PHM 1:24">ፍልሞ. 24</ref>፤ <ref loc="ACT 12:12">ሐዋ. 12:12</ref>፥ <ref loc="ACT 12:25">25</ref>፤ <ref loc="ACT 13:13">13:13</ref>፤ <ref loc="ACT 15:37-39">15:37-39</ref>፤ <ref loc="COL 4:10">ቆላ. 4:10</ref></char></note> <verse eid="2TI 4:12"/><verse number="13" style="v" sid="2TI 4:13"/>ኔኒ ይእተር፥ ጢሮአዳ ካታማ ካርፖሳ ካለ አሺ ይእደ ታ ኮትዛን ማጻፍቶ ታስ ኤኪ ዮኦ። ኡባፓ አ ቆለራ ጻፍንትደ ማጻፍቶ ኤክካይዛራ ይእፐ።<note caller="-" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="ACT 20:4">ሐዋ. 20:4</ref>፤ <ref loc="EPH 6:21-22">ኤፈ. 6:21-22</ref>፤ <ref loc="COL 4:7-8">ቆላ. 4:7-8</ref></char></note><verse eid="2TI 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14"/>መቆ ቆጽዘ እስክንድረ ታና ጋማ ቆህዳ፤ ላ ኤ ኦችት ፋና ኤስ ማሆዳ። <verse eid="2TI 4:14"/><verse number="15" style="v" sid="2TI 4:15"/>ኤ ኑ ትምርትቶ ጋማ እጽዘ ግሾ ኤፓ ነና ናጎ።<note caller="-" style="x"><char style="xo" closed="false">4:15 </char><char style="xt" closed="false"><ref loc="1TI 1:20">1 ጢሞ. 1:20</ref>፤ <ref loc="PSA 62:12">ማዝ. 62:12</ref>፤ <ref loc="ROM 2:6">ሮመ 2:6</ref></char></note><verse eid="2TI 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16"/>ቲኖ ታ ሞትንትዘ ዎደ ኡባና አሺ ቅትዳ ፋትን ኦንን ታና ማድካያ። ጾዚ ይና ባልቶ ኡንትስ ፋይድፐ። <verse eid="2TI 4:16"/><verse number="17" style="v" sid="2TI 4:17"/>የዝን ታኒ ሙሎ ኪታ አይሁደ ማቆሰ አሱን ኡቡንስ ማርክን፥ ኡን ስኦደ ፋና ላ ታ ካለ ኤቂ ታስ ዎልቃ እንግዳ። ማህ ጋሞ ፋና ዶና ሻቅንግደ Ꮉይቆፓ ታና አሽዳ። <verse eid="2TI 4:17"/><verse number="18" style="v" sid="2TI 4:18"/>ላ ታና ኢታ ኡባፓ አሺ ፋ ሳሎ ካእቱሞ ሳሮራ የልዳ። ኤስ መናፓ መዽና የሎደስ ቦንቾ ማቀ። አምንኤ።<verse eid="2TI 4:18"/></para>
  <para style="s1">ዉርሱ ሳር</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19"/>ጵርስቅላስ፥ አቂላስን አነስፎራ ካራ አሱንስ ታ ሳሮትቶ ኦሆ። <verse eid="2TI 4:19"/><verse number="20" style="v" sid="2TI 4:20"/>ኤራስጾሳ ቆሮንቶሳ ካታማ አትዳ። ጥሮፍሞሳ Ꮉርግንትደ ግሾ ምሊጠ ካታማ አሽዳ።<note caller="-" style="x"><char style="xo" closed="false">4:20 </char><char style="xt" closed="false"><ref loc="ACT 18:2">ሐዋ. 18:2</ref>፤ <ref loc="2TI 1:16-17">2 ጢሞ. 1:16-17</ref></char></note> <verse eid="2TI 4:20"/><verse number="21" style="v" sid="2TI 4:21"/>ባርጎ ገሎደፓ ቲኒ ኤልሲ ዮኦ።<note caller="-" style="x"><char style="xo" closed="false">4:21 </char><char style="xt" closed="false"><ref loc="ACT 19:22">ሐዋ. 19:22</ref>፤ <ref loc="ROM 16:23">ሮመ 16:23</ref>፤ <ref loc="ACT 20:4">ሐዋ. 20:4</ref>፤ <ref loc="ACT 21:29">21:29</ref></char></note></para>
  <para style="p" vid="2TI 4:21">ኤዉቡሉሳ፥ ጱዴሳ፥ ልኑሳ፥ ቅላደያን መለ አማንዘ አሱን ኡቡን ነና ሳሮ ሳሮ ጋነ።<verse eid="2TI 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22"/>ላ የሱስ ክርስቶሳ ኔራ ማቀ።</para>
  <para style="p" vid="2TI 4:22">ጾዘ ማሮትታ ይን ኡቡንራ ማቀ።<verse eid="2TI 4:22"/></para>
  <chapter eid="2TI 4"/>
</usx>
