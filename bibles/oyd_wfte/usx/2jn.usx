<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Oyda New Testament</book>
  <para style="h">2 ዋሐንሳ</para>
  <para style="toc1">ዋሐንሳ ጻፍደ ላምእን ኪታ</para>
  <para style="toc2">2 ዋሐንሳ</para>
  <para style="toc3">2 ዋሐ.</para>
  <para style="mt1">ዋሐንሳ ጻፍደ</para>
  <para style="mt2">ላምእን ኪታ</para>
  <para style="imt1">ገለ</para>
  <para style="ip">ዋሐንሳ ጻፍደ ላምእን ኪታ፥ የሱሳ ሐዋረ ማቅደ ጭምዘ፥ ዋሐንሳ ጻፍዳ። ጻፍንትዳናን ዶርንትደ እንትስን እ ናኡንስ። ኦደ ኤርደ፥ ይናን ፈቲ ዎሳ ኬስን እዘ ጎይንዘ አሱንስ ማቃንጽ አቶስ። Ꮉይ Ꮉታ ኪትዘ ጻፍንትደ፥ ኡን ፈታይ ፈታይራ ሲቅንቶደ ፋና ቆፍሳደስን ዎርዶ አስታማሩንፓን ኡን ትምርተፓ ናግንቶደ ፋና ቆፍሳደስ።</para>
  <para style="iot">ኣፈ ቆፉን</para>
  <para style="io1">ሳር <char style="ior"><ref loc="2JN 1:1-3">1-3</ref> </char></para>
  <para style="io1">ሲቆ ኡባፓ ዳማ <char style="ior"><ref loc="2JN 1:4-6">4-6</ref> </char></para>
  <para style="io1">ዎርዶ ትምርተፓ ናግንተ <char style="ior"><ref loc="2JN 1:7-11">7-11</ref> </char></para>
  <para style="io1">ጻ ቆፋ <char style="ior"><ref loc="2JN 1:12-13">12-13</ref> </char></para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1"/>ታ ጭምዘ ዶርንትደ ካራ እንትስን እ ናኡንስ ኪትንትደ ኪታ። ታ ጻላላ ባይዝን ቱርቶ ኤርዘ ኡቡን ካነ። <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>የ ቱርዘ ኑራ የዘ ግሾን መዽና ኑራ የሳደ ግሾ ታኒ ይንታና ቱሮ ካነ።<verse eid="2JN 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3"/>ጾዘ ኑ አዳይ ኤ ናአይ የሱስ ክርስቶሳ አ ከሃትታ፥ ማሮትታን ሳሮትታን ቱርራን ሲቆራን ዎላ ኑራ ማቀ።<verse eid="2JN 1:3"/></para>
  <para style="s1">ቱሮን ሲቆን</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>አዳይ ኑና ኪትዳን ፋና፥ ነ ናኡንፓ ባጉን፥ ቱርስ ኪትንትዛኖ ብእ ታኒ ጋማ ኡፋይትዳ። <verse eid="2JN 1:4"/><verse number="5" style="v" sid="2JN 1:5"/>ካራ እንተ፥ Ꮉተን ኑኒ ኡባ ፈተ ፈታያ ሲቆደ ጋር ታኒ ነና ዎሳነ። የ ኪትዘ ቲኖፓ ኑራ የዘ ኪታ ፋትን ታኒ ኔስ ክለ ኪታ ጻፎስ። <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>ቱሪ ሲቆ ኑ ጾዘ ኪታ ናጊ የሳዳኖ። ማህ ቲኖፓ ይን ስእዳን ፋና ኤ ኪታ፥ ይን ኡቡን «ሲቆራ የዞተ» ጋዛኖ።<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዋሐ. 13:34</ref>፤ <ref loc="JHN 15:12">15:12</ref>፥ <ref loc="JHN 15:17">17</ref></char></note><verse eid="2JN 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7"/>የሱስ ክርስቶሳ አስ ማቂ ይእዳኖ አማኖሰ፥ ጋማ ባልዘ አሱን፥ አላምተ ደንድዳ። ይኒ ጋርዘ አስ ኦንን ባልዛን ክርስቶሳ እጽዛን። <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>ይን ኦችደ ኩሙ ዋግቶ ኤኮደስ ምንጎተ። ይን ኦችዳና ባመ ፋና ናግንቶተ።<verse eid="2JN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9"/>ክርስቶሳ ትምርትተ ሚንግ የዞሰስን ኤ ትምርትትፓ Ꮉኪ የዘ አስ ጾዚ ባያ። ክርስቶሳ ትምርትተ የዘ አስ አዳይን ናአይን የነ። <verse eid="2JN 1:9"/><verse number="10" style="v" sid="2JN 1:10"/>ኦንን ይንታጎ ይእተራ Ꮉና ትምርትቶ ኤክካይዛር ይእኮ፥ ይን ካራ ገልፐተ፤ ሳሮን ጋይፐተ። <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>ኤዛ ሳሮ ጋዘ ኦንን ኤ ኢታ ኦችተ ኤራ ሻክንታነ።<verse eid="2JN 1:11"/></para>
  <para style="s1">ዉርሱ ሳር</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>ታኒ ይንትስ ጻፎደስ ኮይደ ጋማ ባዝ የነ፥ የዝን ዎርቃተራን ቃላመራ ጻፎደስ ኮዮስ። ኑ ኡፋይስታ ፎልንቶደ ፋና ይንታራ ስኖ የልንት ኦህንቶደስ ይንታጎ Ꮉማዳ ጋእ ቆፓነ።<verse eid="2JN 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13"/>ጾዚ ዶርደ ነ ምሽት ናኡን ነና ሳሮ ጋነ።<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
