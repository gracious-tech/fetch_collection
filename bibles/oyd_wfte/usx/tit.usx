<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="TIT" style="id">- Oyda New Testament</book>
  <para style="h">ትቶ</para>
  <para style="toc1">ጳዉሎሳ ትቶስ ጻፍደ ኪታ</para>
  <para style="toc2">ትቶ</para>
  <para style="toc3">ትቶ</para>
  <para style="mt1">ጳዉሎሳ ትቶስ</para>
  <para style="mt2">ጻፍደ ኪታ</para>
  <para style="imt1">ገለ</para>
  <para style="ip">ትቶ አይሁደ ማቆሰ አስ፥ የዝን ሱባፓ አማኒ፥ ጳዉሎሳ ዎንገለ ኪታ ኦቻ ኦችዘ ዎደ ካለ ኤዛ ማድደ አስ። የ ዎደ ትቶ፥ ዎሳ ኬ በአደስን ናጎደስ ቃርጼሰ ሳአ አትዳ። Ꮉይ ኪትዘ Ꮉይ ኣፈ ቆፋ አይክዳ።</para>
  <para style="ip">1. ዎሳ ኬ አህዘ አሱን፥ ኢታ የስ የዘ ቃርጼሰ አሱን ካለ አኮ ፋና ሎኦ የስ የሳደስ ቤዝዛኮ ትቶ ቆፍዛነ።</para>
  <para style="ip">2. ዎሳ ኬ ግዳ የዘ ዱማ ዱማ ታግንትደ፥ ይናን፥ ጭማ አሱንና፥ ይ ራንና አሩንና ዋይዝ ታማርሶደስ ቤዝዛኮ ትቶ ዞራነ።</para>
  <para style="ip">3. አማንዘ አሱን አማኖ የስት ባዝ፥ ይናን፥ ሳሮትን ሲቆራ የሳደባዝ፥ ዎሳ ኬፓ ካችን፥ ላለን ሻክንተ Ꮉሶደ ፋና ትቶስ ዞረ እንጋነ።</para>
  <para style="iot">ኣፈ ቆፉን</para>
  <para style="io1">ገለ ቆፋ <char style="ior"><ref loc="TIT 1:1-4">1:1-4</ref> </char></para>
  <para style="io1">ዎሳ ኬ ካልዘ አሱንና <char style="ior"><ref loc="TIT 1:5-16">1:5-16</ref> </char></para>
  <para style="io1">ዎሳ ኬ ዱማ ዱማ ታግንትዱን ግሾ ኦቻ <char style="ior"><ref loc="TIT 2:1-15">2:1-15</ref> </char></para>
  <para style="io1">ዞረን ናግዘ <char style="ior"><ref loc="TIT 3:1-11">3:1-11</ref> </char></para>
  <para style="io1">ጻ ቆፋ <char style="ior"><ref loc="TIT 3:12-15">3:12-15</ref> </char></para>
  <chapter number="1" style="c" sid="TIT 1"/>
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1"/>የሱስ ክርስቶሳ ሐዋረን ጾዘ አሮ፥ ጳዉሎሳ፥ ጻፍደ ኪታ። ጾዚ ዶርደ አሱን አማኖ ድቾደ ጋራን ቱሪ አያና ደኦ ዋይዝ የሳደ የዛኮ ቱሪ ኤራጎ ኡንታና ካልደስ ታ ኪትንትዳ። <verse eid="TIT 1:1"/><verse number="2" style="v" sid="TIT 1:2"/>ይና አማንታን ኤራትታ መዽና ደኦ ኡፋይሳላ አፋ ካትዳ። ይኖ ጋማ ዎደፓ ቲኖ ዎርዶ ኦሆሰ ጾዘ ኑስ እንጎዳ ጋእ ቃላ ገልዳ። <verse eid="TIT 1:2"/><verse number="3" style="v" sid="TIT 1:3"/>ኑና አሽዘ ጾዘ ፋ ዎድተ Ꮉኖ ኪቶ ኦሆደ ፋና ታስ Ꮉዳራ እንግ ፋ ቃልቶ ቆንጭዝዳ።<verse eid="TIT 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="TIT 1:4"/>ኑ ኮ አማኖ ታ ቱሪ ናአ ማቅደ ትቶ፥</para>
  <para style="p" vid="TIT 1:4">ጾዚ አዳይፓ ኑና አሽዘ የሱስ ክርስቶሳፓ አ ኬሃት፥ ማሮትን ሳሮት ኔስ ማቀ።<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="2CO 8:23">2 ቆሮ. 8:23</ref>፤ <ref loc="GAL 2:3">ጋላ. 2:3</ref>፤ <ref loc="2TI 4:10">2 ጢሞ. 4:10</ref></char></note><verse eid="TIT 1:4"/></para>
  <para style="s1">ትቶ ቃርጼሰ ኦችደ ኦቻ</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5"/>ታኒ ነና ቃርጼሰ አሺ ይእዳና፥ ነ አትደባዝ ጊግሳደ ፋናን ታኒ ኪትዳን ፋና ካታማ ኡባነ ዎሳ ኬ ጭሙንና ዶሮደ ፋና። <verse eid="TIT 1:5"/><verse number="6" style="v" sid="TIT 1:6"/>ዎሳ ኬ ጭማ ቦርንቶሳ፥ ፈቲ ማች አዝን፥ ዎጋ ባለራ ዎይ ኪትንታንጸራ አስ ቦሮሰ አማንዘ ናኡን የዘ አስ ማቃደስ ቤዛነ። <verse eid="TIT 1:6"/><verse number="7" style="v" sid="TIT 1:7"/>ዎሳ ኬ ጭማ ጾዘ ኦቻ Ꮉዳራ ኤክደ ግሾ ቦርንቶሳ፥ ኡቱርቶሳ፥ ኤልስ ዥልሳ፥ ማንቶሳ፥ ኦሄ መሳ፥ ቤዞሰ ባዝስ ዳፍንቶሳ ማቆደስ ቤዛነ።<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="1TI 3:2-7">1 ጢሞ. 3:2-7</ref></char></note> <verse eid="TIT 1:7"/><verse number="8" style="v" sid="TIT 1:8"/>የዝን ዛቆ ሞክዛ፥ ሎኦ ባዝ ኡባ ካዛ፥ ቆፋራ የዛያ፥ ጽሎ፥ ጌሽን ፋና አህዛያ ማቃደስ ቤዛነ። <verse eid="TIT 1:8"/><verse number="9" style="v" sid="TIT 1:9"/>መሉንና ቱሪ ትምርተራ ምንደስን ይና ትምርትቶ እጽዙንና ማሆደስ ፋ ታማርደ አማንዘ ቃልተ ሚንግ ኤቆደስ ቤዛነ።<verse eid="TIT 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10"/>ኪትንቶሱን፥ ፋሰ ኦሄ ኦህንትዙን፥ ጭምዙን አ ጋራዝንተ ዎጋ ናግዘ ጋማ አሱን የነ። <verse eid="TIT 1:10"/><verse number="11" style="v" sid="TIT 1:11"/>ኡን ቤዞሰ ኦገራ ሚሸ ደንጎደስ ኮይ፥ ታማርሶደስ ቤዞሰ ባዝ ታማርስተራ ካራ አሱንና ኡባ ኢስዘ ግሾ ኡን ትምርትቶ ተቆደስ ቤዛነ። <verse eid="TIT 1:11"/><verse number="12" style="v" sid="TIT 1:12"/>ኡን ናቡንፓ ፈታይ፥ «ቃርጼሰ አሱን ኡባ ዎደ ዎርዶ ኦህንታነ፤ ኢታ ጾንና፥ አዛልአ ዥምባራ»<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">ይኖ ያጋእ ኦህደ ናብዘ ኤጵመንደሳ ጋእንታነ።</char></note> ያጋይዳ። <verse eid="TIT 1:12"/><verse number="13" style="v" sid="TIT 1:13"/>Ꮉና ማርካትታ ቱሪ ማርካት። ይኒ ግሾ፥ ኡንትስ ቱሪ አማኖ የሳደ ፋና ኡንታና ሴሮ። <verse eid="TIT 1:13"/><verse number="14" style="v" sid="TIT 1:14"/>ቱሮ እጽዘ አሱን ትምርትቶን አይሁዱን ፋሰ ቶሴ ስአመ ፋና ኡንታና ሴሮ። <verse eid="TIT 1:14"/><verse number="15" style="v" sid="TIT 1:15"/>ጌሹንስ ኡባና ጌሽ፥ የዝን ቱኑንስን አማኖሱንስ ኡን ቆፍታን ዎዝንታ ቱንደ ግሾ ኡንትስ አኮን ጌሽ ማቆስ። <verse eid="TIT 1:15"/><verse number="16" style="v" sid="TIT 1:16"/>ኡን ኑ ጾዝ ኤራነ ጋእነ፥ የዝን ፋ ኦችተ ኤዛ ካዳነ። ኡን እጽንትዱንና፥ ኪትንቶሱንናን ሎኦ ኦቻ ኡባስ ማቆሱንና።<verse eid="TIT 1:16"/></para>
  <chapter eid="TIT 1"/>
  <chapter number="2" style="c" sid="TIT 2"/>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1"/>የዝን ኔኒ ሉለ ትምርተ ታማርሶደስ ቤዛነ። <verse eid="TIT 2:1"/><verse number="2" style="v" sid="TIT 2:2"/>ጭማ ራን ፋና አህዙንና፥ ዎፑ ጋይዱንና፥ ቦንችንትዱንና፥ አማኖራ፥ ሲቆራን ዳንዳአራ፥ ምን ማቃደ ፋና ዞሮ። <verse eid="TIT 2:2"/><verse number="3" style="v" sid="TIT 2:3"/>ይኒ ጋራን፥ ጭማ ማቹን ፋ የስተ ጌሹንና፥ ዙዝንጎሱንና፥ ኡሽ አሞት ባይዙንና ሎኦ ባዝ ታማርስዙንና ማቃደ ፋና ታማርሶ። <verse eid="TIT 2:3"/><verse number="4" style="v" sid="TIT 2:4"/>ኡን ይኒ ፋና Ꮉንኮ ናአት ማቹን ፋ አዝኑንናን ፋ ናኡንና ሲቆደ ፋና ታማርሶደስ ቤዛነ። <verse eid="TIT 2:4"/><verse number="5" style="v" sid="TIT 2:5"/>ጾዘ ቃላ ቦሩንታመ ጋር ፋና አህዙንና፥ ጌሹንና፥ ፋ ካራ ኦችዙንና፥ ካራ ፋ አዝኑንስ ኪትንትዙንና ማቃደ ፋና ናአት ማቹንና ታማርሶ ዞሮ።<verse eid="TIT 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6"/>ይኒ ጋር፥ ይ ራን ፋ ኦምቶ አሆደ ፋና ዞሮ። <verse eid="TIT 2:6"/><verse number="7" style="v" sid="TIT 2:7"/>ኔኒ ነ ኦምተ ሎኦ ኦቻ ኡባነ ኡንትስ አዝዘ ማቆ። ኔኒ ነ ትምርትተ ቱሮን አማንንትዳያ ማቆ። <verse eid="TIT 2:7"/><verse number="8" style="v" sid="TIT 2:8"/>ኑ ሞርኩን ኑና ዝግሮደስ ምክናተ ማቅዘ ባዝ ኡንትስ ብን ኡን ዬልደ ፋና ነ ቦሩንቶሰ ሎኦ ኦሄ ኦህንቶ።<verse eid="TIT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9"/>አሩን ኡባ ባዛ ፋ ላንስ ኪትንቶደ ፋና፥ ኡንታና ኡፋይሶደ ፋናን ኡንታራ ላላመ ፋና ዞሮ። <verse eid="TIT 2:9"/><verse number="10" style="v" sid="TIT 2:10"/>ኡን ፋ ላንፓ ሚሸ ካይስትፐ። ይናን፥ ኑና አሽዘ ጾዘ ትምርተ፥ ኡባ ኦገራ ካንትዳያ ማቃደ ፋና ፋ ኦችዘ ኦችተ አምንንትዱንና ማቅዛኖ ቤዞደ ፋና ኡንታና ዞሮ።<verse eid="TIT 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11"/>አስ ኡባ አሽዘ ጾዘ አ ኬሃት ቆንጭዳ። <verse eid="TIT 2:11"/><verse number="12" style="v" sid="TIT 2:12"/>የ አ ኬሃትዘ፥ ኑ ናጋርቶን Ꮉና አላመ አሙቶ አሺ፥ Ꮉና ዎድተ ኑ ኦምቶ ናጊ፥ ቱሪ አያና የሳራን ጽሎትራ የሳደ ፋና ኑና ታማርሳነ። <verse eid="TIT 2:12"/><verse number="13" style="v" sid="TIT 2:13"/>ይኒ ፋና ኑኒ አንጅንትደ ኡፋይስ ማቅደ ዳማ ጾዛን ኑና አሽዘ የሱስ ክርስቶሳ ቦንቾ ቆንጭቶ ናጋነ። <verse eid="TIT 2:13"/><verse number="14" style="v" sid="TIT 2:14"/>ኢታ ኦቻ ኡባፓ ኑና ዎዞደስን ሎኦ ባዝ ኦቾደስ አሙዘ ፋ ጌሽ አስ ኬሶደስ ኑ ግሾ ፋና አ እንግዳ።<verse eid="TIT 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15"/>ኔኒ Ꮉኖ ታማርሶ፤ ኩሙ አደት ወልቃራ ዞሮ፥ ሴሮ፤ ኦደን ነና ለቂፐ።<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="PSA 130:8">ማዝ. 130:8</ref>፤ <ref loc="EXO 19:5">ከዘ 19:5</ref>፤ <ref loc="DEU 4:20">ማሄ 4:20</ref>፤ <ref loc="DEU 7:6">7:6</ref>፤ <ref loc="DEU 14:2">14:2</ref>፤ <ref loc="1PE 2:9">1 ጴጥ. 2:9</ref></char></note><verse eid="TIT 2:15"/></para>
  <chapter eid="TIT 2"/>
  <chapter number="3" style="c" sid="TIT 3"/>
  <para style="s1">አማንዘ አስ ኦቻ</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1"/>አሱን ዎርዣ አህዙንስ፥ አደት ዎልቃ የዙንስ አዳትራ ኪትንቶደ ፋና፥ ሎኦ ኦቻ ኡባ ኦቾደስ ጊግንትዱንና ማቃደ ፋና ቆፕዞ። <verse eid="TIT 3:1"/><verse number="2" style="v" sid="TIT 3:2"/>ማህን ኡን ኦደላን ኢታ ኦህንታመ ፋና፥ ሳሮ አስ ማቃደ ፋና፥ ዳልጋን አስ ኡባስ አዳ ማቃደ ፋና ዞሮ። <verse eid="TIT 3:2"/><verse number="3" style="v" sid="TIT 3:3"/>ኑ ዛጋ ኤዩንና፥ ኪትንቶሱንና፥ ባልንትዙንና፥ ዱማ ዱማ አሾ ኡፋይስስን አሞስ አሮ ፋና ማቅዱንና። ኑ ኢታትራን ቅናተራ ኩምዱንና፤ ኑኒ አስ እጽዙንና፥ አስን ኑና እጽዙንና። <verse eid="TIT 3:3"/><verse number="4" style="v" sid="TIT 3:4"/>የዝን አሽዘ ጾዘ ኬሃትን ሲቆ ቆንጭደ ዎደ <verse eid="TIT 3:4"/><verse number="5" style="v" sid="TIT 3:5"/>ኑ ኦችደ ጽሎ ኦቻ ግሾ ባይዝን ፋ ማሮትት ግሾ ኑና አሽዳ። ኑና ኤ አሽዳና፥ ላምእን የልንተ ሜጭንተራን ጌሽ አያና ባጋራ እንግደ ክለ ደኦር። <verse eid="TIT 3:5"/><verse number="6" style="v" sid="TIT 3:6"/>የ አያንዛ፥ ጾዚ ኑና አሽዘ የሱስ ክርስቶሳ ባጋራ ኑላ አፋ ጋን ጉስዳ። <verse eid="TIT 3:6"/><verse number="7" style="v" sid="TIT 3:7"/>ፋ አ ኬሃትት ባጋራ ኑና ጽልዚ መዽና ደኦ ላታ ኡፋይስ አይኮደ ፋና ይኖ ኦችዳ። <verse eid="TIT 3:7"/><verse number="8" style="v" sid="TIT 3:8"/>Ꮉይ ቃልዘ አምንንትደ ቃላ። ጾዛ አማንዙን ሎኦ ኦቻ ኦቾደስ ጊግዱንና ማቃደ ፋና ነ Ꮉና ቃልቶ ምን ኦሆደ ፋና ታ ኮያነ። Ꮉንስ አስ ኡባስ ሎኦን ማድዘ ባዝ። <verse eid="TIT 3:8"/><verse number="9" style="v" sid="TIT 3:9"/>የዝን ኤያት ላለፓን፥ ኮች ፋይደፓ፥ ካቻፋን ህገ ምክናተራ ደንድዘ ላለፓ ናግንቶ። ይና ማደን ትርፈ ባይዘ ባዝ። <verse eid="TIT 3:9"/><verse number="10" style="v" sid="TIT 3:10"/>ሻክንተ መዘ አ ቲኖ ዞሮ፤ ላምእን ካጮ ይንፓ ሱባ ኤፓ Ꮉኮ። <verse eid="TIT 3:10"/><verse number="11" style="v" sid="TIT 3:11"/>ይኒ ጋርዘ አስ ዎቦን ናጋራንቾ፤ ኤ ፋላ አፋ ፍርድዛኖ ኤሮ።<verse eid="TIT 3:11"/></para>
  <para style="s1">ዉርሱ ዞረ</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12"/>ታኒ ስላ የይጋ ኣደስ ቆፕደ ግሾ አርጤማሳ ዎይ ትክቆሳ ኔጎ ኪትዘ ዎደ ነ ታጎ ንቆጵልዮና ካታማ ዮኦደስ ኤልሶ። <verse eid="TIT 3:12"/><verse number="13" style="v" sid="TIT 3:13"/>ህገ ኤራንቻ ዜናሳን አጵሎሳ ኦገ Ꮉንግዘ ዎደ ኡንትስ ኮሽዘ ባዝ ፋጫመ ፋና ኡንታና ማዶ።<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="ACT 20:4">ሐዋ. 20:4</ref>፤ <ref loc="EPH 6:21-22">ኤፈ. 6:21-22</ref>፤ <ref loc="COL 4:7-8">ቆላ. 4:7-8</ref>፤ <ref loc="2TI 4:12">2 ጢሞ. 4:12</ref></char></note> <verse eid="TIT 3:13"/><verse number="14" style="v" sid="TIT 3:14"/>ኑ አሱንን ፋሰ አስ ማቂ አታመ ፋና ፋስ ኮሽዘ ባዝ ደንጎደ ፋና ሎኦ ኦቻ ኦቾደስ ሚንግ ታማሮ።<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="ACT 18:24">ሐዋ. 18:24</ref>፤ <ref loc="1CO 16:12">1 ቆሮ. 16:12</ref></char></note><verse eid="TIT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15"/>ታራ የዘ ኡቡን ነና ሳሮ ጋነ፤ አማኖራ ኑና ሲቅዘ አሱንና ሳሮ ጋኦ።</para>
  <para style="p" vid="TIT 3:15">ጾዘ አ ከሃትታ ይን ኡቡንራ ማቀ። አምንኤ።<verse eid="TIT 3:15"/></para>
  <chapter eid="TIT 3"/>
</usx>
