<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Oyda New Testament</book>
  <para style="h">1 ዋሐንሳ</para>
  <para style="toc1">ዋሐንሳ ጻፍደ ቲኖ ኪታ</para>
  <para style="toc2">1 ዋሐንሳ</para>
  <para style="toc3">1 ዋሐ.</para>
  <para style="mt1">ዋሐንሳ ጻፍደ</para>
  <para style="mt2">ቲኖ ኪታ</para>
  <para style="imt1">ገለ</para>
  <para style="ip">ሐዋረ ዋሐንሳ ጻፍደ ቲኖ ኪታ፥ ላምእ ኣፈ ቆፋ አይካነ። ይናን ናባብዙን ጾዛራን ኤ ናአይ የሱስ ክርስቶሳራ ፈተት የሳደ ፋና ምንደስን ይና ፈተትቶ ብስዘ ዎርዶ ትምርተፓ Ꮉኮደ ፋና ኡንታና ቆፍሳደስ። የ ዎደ ደንድደ ዎርዶ ትምርተ፥ «ጾዚ በንቶሰ አያናራ አላመ መዳ። Ꮉና በንትዘ አላምቶን ኑ ጋልቶ ጾዚ መካይዘ ግሾ ኢታ። ማህ Ꮉና በንትዘ አላምታን ኑ ጋልታ ኑ አያንዛ ቆሆደስን ቱንሳደስ ዳንዳኦስ» ያጋእ ታማርሳነ። ይኖ ጋዛና፥ ቲኖ፥ የሱሳ አስ ማቂ ይእካያ። ላምእን፥ ፈቲ አስ ፋ አያና ቱንዝካይዛራ ፋ አሾራ ናጋራ ኦቾደስ ዳንዳአነ ያጋኤ።</para>
  <para style="ip">ይኒ ግሾ፥ ዋሐንሳ ፋ ኪተ፥ የሱሳ አስ ማቂ ይእዳኖ ካድዘ ኦንን ጾዘ ናአ ማቆስ (4:2-3)። ማህ ጾዛፓ የልንትደ ኦንን ኡባ ዎደ ናጋራራ የዞስ (3:6) ያጋእ ጻፍዳ።</para>
  <para style="ip">የ ዎርዶ አስታማሩን፥ «አቶት ጋዛና፥ Ꮉና አላመ የሲስ ኡንእንተፓ ኬዚ ዋሎ ማቂ የዘ» ያጋነ። ይንላ አፋ ጉጂ፥ «ኢታን ሎኦ ሻኪ አይፎ ማቅን፥ ማህ መለ አስ ሲቆ ማቅን አቶትራ አኮን የልንትዘባዝ ባያ» ያጋነ።</para>
  <para style="ip">ጻፍዘ ይና ትምርትቶ እጺ፥ «የሱስ ክርስቶሳ ፎሎ አስ። የሱሳ አማንዙንን ጾዛ ሲቅዙን ኡባ ፋ ግዳ ፈታይ ፈታይራ ሲቅንቶደስ ቤዛነ» ያጋእ ኦህዳ።</para>
  <para style="iot">ኣፈ ቆፉን</para>
  <para style="io1">ገለ ቆፋ <char style="ior"><ref loc="1JN 1:1-4">1:1-4</ref> </char></para>
  <para style="io1">ፎኦን ማን <char style="ior"><ref loc="1JN 1:5-2:29">1:5—2:29</ref> </char></para>
  <para style="io1">ጾዘ ናኡንናን ጻላሄ ናኡንና <char style="ior"><ref loc="1JN 3:1-24">3:1-24</ref> </char></para>
  <para style="io1">ቱሮን ዎርዶ <char style="ior"><ref loc="1JN 4:1-6">4:1-6</ref> </char></para>
  <para style="io1">ሲቆ ኦቻ <char style="ior"><ref loc="1JN 4:7-21">4:7-21</ref> </char></para>
  <para style="io1">ጋምዘ አማኖ <char style="ior"><ref loc="1JN 5:1-21">5:1-21</ref> </char></para>
  <chapter number="1" style="c" sid="1JN 1"/>
  <para style="s1">ደኦ እንግዘ ቃላ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1"/>ኑ ቲኖፓ ደን የዘ፥ ኑ Ꮉይትራ ስእዳ፥ ኣፍተ ብእዳ፥ ኑ ኩሽተ ቦችዳ አንጆ ቃላባዝ ይንትስ ጻፋነ። <verse eid="1JN 1:1"/><verse number="2" style="v" sid="1JN 1:2"/>ይና ደኦ እንግዘ ቆንጭን፥ ኑኒ ኤዛ ብእ፥ ኤ ባዝ ማርክነ። አዳይ ካለ የዘ ኑስ ቆንጭን፥ መዽና ደኦባዝ ይንትስ አዋጃነ።<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="JHN 1:1">ዋሐ. 1:1</ref></char></note> <verse eid="1JN 1:2"/><verse number="3" style="v" sid="1JN 1:3"/>ኑራ ይንትስ ፈተት የሳደ ፋና ኑ ብእዳኖን ስእዳኖ ይንትስ ኦህነ። ኑስ ፈተት የዛን ፋና አዳይራን ኤ ናአ የሱስ ክርስቶሳራ ፈተት የነ።<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="JHN 1:14">ዋሐ. 1:14</ref></char></note> <verse eid="1JN 1:3"/><verse number="4" style="v" sid="1JN 1:4"/>ኑ ኡፋይስታ ሙሎ ማቃደ ፋና ይኖ ይንትስ ጻፎዳ።<verse eid="1JN 1:4"/></para>
  <para style="s1">ጾዚ ፎኦ</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5"/>ኑኒ ኤፓ ስእደ፥ ይንትስ ኦህዘ ኪታ Ꮉኖ፦ «ጾዚ ፎኦ፤ ኤ ግዳ ማ ባያ» ጋዛኖ። <verse eid="1JN 1:5"/><verse number="6" style="v" sid="1JN 1:6"/>ኑ ኤራ ፈተት የነ ያጋእተራ ማ የዝኮ፥ ኑ ኦህተን ኑ ኦችተ ዋርድነ ቱረት ባያ። <verse eid="1JN 1:6"/><verse number="7" style="v" sid="1JN 1:7"/>የዝን ፎኦ ኤ ማቅዳን ፋና፥ ኑንን ፎኦ የዝኮ፥ ኑስ ዎል ግዳ ፈተት የነ። ኤ ናአይ፥ የሱስ ሱታ ናጋራ ኡባፓ ኑና ጌሻነ።<verse eid="1JN 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8"/>ኑኒ፥ ኑራ ናጋራ ባያ ጋይኮ ኑ ኑና ጭማነ፤ ኑራ ቱረት ባያ። <verse eid="1JN 1:8"/><verse number="9" style="v" sid="1JN 1:9"/>የዝን ጾዝስ ኑ ናጋርቶ ቡጽኮ፥ ኤ ኑ ናጋርቶ አቶ ጋዉደስን ኑ ባላ ኦቻ ኡባንፓ ኑና ጌሾደስ፥ አማንንትዳያን ጽሎን። <verse eid="1JN 1:9"/><verse number="10" style="v" sid="1JN 1:10"/>ኑኒ ናጋራ ኦችካያ ጋይኮ ጾዛ ዎርዶ ማህነ፤ ኤ ቃልታን ኑ ግዳ ባያ።<verse eid="1JN 1:10"/></para>
  <chapter eid="1JN 1"/>
  <chapter number="2" style="c" sid="1JN 2"/>
  <para style="s1">ክርስቶሳ ኑስ ጻባቀ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1"/>ታ ናኡን፥ ናጋራ ይን ኦቻመ ፋና ታኒ Ꮉኖ ይንትስ ጻፋነ። የዝን ኦንን ናጋራ ኦችኮ አደ ካለ ኑስ ጻባቀ ጽሎ የሱስ ክርስቶሳ የነ። <verse eid="1JN 2:1"/><verse number="2" style="v" sid="1JN 2:2"/>ኑ ናጋርታ ክርስቶሳ ባጋራ አቶ ጋእንትዳ። ኤ ኑ ናጋርት ጻላላስ ባይዝን አስ ኡባ ናጋራስ።<verse eid="1JN 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3"/>ኑኒ ጾዘ ኪታ ፎልኮ፥ ሶኤ ባይ፥ ቱሮ ኑ ኤዛ ኤራነ። <verse eid="1JN 2:3"/><verse number="4" style="v" sid="1JN 2:4"/>ኦንን፥ «ታ ኤዛ ኤራነ» ጋእተራ፥ ኤ ኪቶ ፎላንጽኮ የ አ ዎርዶ፤ ቱረት ኤ ግዳ ባያ። <verse eid="1JN 2:4"/><verse number="5" style="v" sid="1JN 2:5"/>የዝን ኤ ቃልትስ ኦንን ኪትንትዘባዝ ማቅኮ የ አ ጾዘ ሲቅታ ኤ ግዳ ፎሎ ማቃነ። ኑኒ ጾዛራ የዛንስ ይና ፋ ኦምተ ቱሪ ማርካ። <verse eid="1JN 2:5"/><verse number="6" style="v" sid="1JN 2:6"/>ታኒ፥ «ጾዛር የነ» ያጋዘ ኦንን ክርስቶሳ የዝዳን ፋና የሳደስ ቤዛነ።<verse eid="1JN 2:6"/></para>
  <para style="s1">ክለ ኪታ</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7"/>ታ ሲቆ እሹን፥ ታኒ ይንትስ ቲኖፓ የዘ ጋልአ ኪታ ጻፋነ ፋትን ክለ ኪታ ጻፎስ። ይናን ይን ስእደ ጋልአ ኪታ። <verse eid="1JN 2:7"/><verse number="8" style="v" sid="1JN 2:8"/>ማቅኮን፥ ክርስቶሳ ግዳን ይን ግዳን ቱሮ ማቂ የዘ፥ ክለ ኪታ ጻፋነ። ማ አን፥ Ꮉተ ቱሪ ፎኦ ፎአነ።<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዋሐ. 13:34</ref></char></note><verse eid="1JN 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9"/>«ፎኦ የነ» ጋእተራ ፋ እሻያ እጽዘ ኦንን፥ Ꮉተን ማ የነ። <verse eid="1JN 2:9"/><verse number="10" style="v" sid="1JN 2:10"/>ፋ እሻያ ካዽዘ ኦደን ፎኦ የነ። የ አ መለ ኤዛ ብዘ ባዝ ባያ። <verse eid="1JN 2:10"/><verse number="11" style="v" sid="1JN 2:11"/>የዝን ፋ እሻያ እጽዘ ኦደን ማ የነ፤ ማ Ꮉንታነ። ማ ኤ ኣፍቶ ጎዝደ ግሾ አባ Ꮉንግዛኮን ኤሮስ።<verse eid="1JN 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12"/>ታ ናኡን፥ ክርስቶሳ ሱንት ባጋራ ይን ናጋርታ ማሮት ደንግደ ግሾ ታኒ ይንትስ ጻፋነ። <verse eid="1JN 2:12"/><verse number="13" style="v" sid="1JN 2:13"/>አዱን፥ ቲኖፓ የዘ፥ ኤዛ ይን ኤርደ ግሾ ይንትስ ጻፋነ። ናአትን፥ ጻላሄ ይን ጋምደ ግሾ ይንትስ ጻፋነ። <verse eid="1JN 2:13"/><verse number="14" style="v" sid="1JN 2:14"/>ናኡን፥ ጾዛ ይን ኤርደ ግሾ ይንትስ ጻፋነ። አዱን፥ ቲኖፓ የዘ ኤዛ ይን ኤርደ ግሾ ይንትስ ጻፋነ። ናአትን፥ ይን ጎባ ማቅደ ግሾ ጾዘ ቃላ ይንታራ የዘ ግሾን ጻላሄ ይን ጋምደ ግሾ ይንትስ ጻፋነ።<verse eid="1JN 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15"/>አላመ ዎይ አላመ የዘ ባዝ ካፐተ። አላመ ካዽዘ ኦንን ጾዘ አዳያ ካኦስ። <verse eid="1JN 2:15"/><verse number="16" style="v" sid="1JN 2:16"/>አላመ የዘ ኡባና፥ አሾ አሞት፥ ኣፈ ብእ አሙዘ ባዝን ሚሸራ ጬቅንተ አላመ ባዝ ፋትን ጾዛፓ ባያ። <verse eid="1JN 2:16"/><verse number="17" style="v" sid="1JN 2:17"/>አላመን አላመ አስ አሞ ኡባ አዳ፥ የዝን ጾዘ ቆፋ ኦችዘ ኦደን መዽና የሳዳ።<verse eid="1JN 2:17"/></para>
  <para style="s1">ክርስቶሳ እጽዙንፓ ናግንተ</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18"/>ታ ናኡን፥ ዎደ ዉርሱታ ኡክዳ። ክርስቶሳ እጽዘ ቲኖፓ ዮኦዳኖ ይን ስእዳን ፋና መለ አቶ የዝን፥ Ꮉተን ኤ ሞርኩን ጋሙን ደንድዳ። ይኒ ግሾ፥ ዎደ ዉርሱታ ኡክዳኖ ኑኒ ይነ ኤራነ። <verse eid="1JN 2:18"/><verse number="19" style="v" sid="1JN 2:19"/>የን ሞርኩን ኑ ባጋ ማቆሰ ግሾ ኑ ግዳፓ ከዝዳ። ኡን ኑ ባጋ የዛኮ ኑ ግዳ የሳዳ፥ የዝን ኡንታፓ ኦንን ኑ ባጋ ማቆሳና ኤርንቶደ ፋና ኑ ግዳፓ ከዝዳ።<verse eid="1JN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20"/>የዝን ክርስቶሳ ይንታላ አፋ ጌሽ አያና ጉስዳ፤ ማህ ይን ኡቡን ቱርቶ ኤራነ። <verse eid="1JN 2:20"/><verse number="21" style="v" sid="1JN 2:21"/>ቱርቶ ይን ኤርዘ ግሾን ቱሪ ግዳ አኮን ዎርዶ ባይዛኖ ይን ኤርዘ ግሾ ታኒ ይንትስ ጻፋነ ፋትን ቱርቶ ይን ኤሮሰ ግሾ ባያ።<verse eid="1JN 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22"/>የሱሳ፥ ጾዚ ትዥዳያ ባያ ጋእ ካድዘ አሱንፓ መለ ዎርዶ ኦህዘ ኦደ? ኤዚ ክርስቶሳ እጽዛ። ኤ ናአያ ካድኮ አዳያን ካዳነ። <verse eid="1JN 2:22"/><verse number="23" style="v" sid="1JN 2:23"/>ናአያ ካድዘ ኦደስን አዳይ ባያ፤ ማህ ናአይስ ማርክዘ ኦደስን አዳይ የነ።<verse eid="1JN 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24"/>ይኒ ግሾ፥ ቲኖ ይን ስእዘ ቃልቶ ይን ዎዝንተ ምን ናጎተ። ቲኖ ስእዳኖ ይን ናግኮ ይንትስ ናአይራን አዳይራን ፈተት የሳዳ። <verse eid="1JN 2:24"/><verse number="25" style="v" sid="1JN 2:25"/>ይናን ክርስቶሳ እንግደ መዽና ደኦ።<verse eid="1JN 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26"/>ይንታና ባልስዘ አሱን ግሾ ታኒ Ꮉኖ ይንትስ ጻፍዳ። <verse eid="1JN 2:26"/><verse number="27" style="v" sid="1JN 2:27"/>የዝን ክርስቶሳፓ ኤክደ አያና ይን ግዳ የዘ ግሾ መለ አስታማረ ኮሾስ፥ ኤ ኡባ ባዝ ታማርሶዳ፥ ታማርስዛናን ቱሮ ፋትን ዎርዶ ባያ። ይኒ ግሾ ጌሽ አያና ይንታራ የዘ ግሾ ኦንን ይንታና ታማርሰ ቤዞስ። የዝን ኤ አያና ትዠ ኡባ ባዝ ይንታና ታማርስዛን ፋና ቱሮ ፋትን ዎርዶ ባያ። ይኒ ግሾ ጌሽ አያና ይንታና ታማርስዳን ፋና ክርስቶሳ ግዳ የዞተ።<verse eid="1JN 2:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28"/>ይኬ፥ ታ ናኡን፥ ኤ ቆንጭዘ ዎደ ኑኒ ዣሽሞ ባይ ኤ የእዘ ቃማ ኤ ቲኖ ኑ ዬላራ አችንታመ ፋና ኤር የዞተ። <verse eid="1JN 2:28"/><verse number="29" style="v" sid="1JN 2:29"/>ክርስቶሳ ጽሎ ማቅዛኖ ይን ኤርኮ ጽሎ ኦችዘ ኡባ ጾዘ ናአ ማቅዛኖ ኤሮተ።<verse eid="1JN 2:29"/></para>
  <chapter eid="1JN 2"/>
  <chapter number="3" style="c" sid="1JN 3"/>
  <para style="s1">ጾዘ ናኡንና</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1"/>ኑ ጾዘ ናኡንና ጋእንት ጼግንቶደ ፋና ጾዚ ኑና አኮ ፋና ካዛኮ ቦኦተ። ኑ ቱሮ ጾዘ ናኡንና። Ꮉና አላምታ ጾዛ ኤሮሰ ግሾ ኑናን ኤሮስ። <verse eid="1JN 3:1"/><verse number="2" style="v" sid="1JN 3:2"/>ታ ሲቁን፥ Ꮉተ ኑ ጾዘ ናአ፤ ኑ ዋያድየዛኮ Ꮉጋ ኤርንትካያ። የዝን ክርስቶሳ ቆንጭዘ ዎደ ኑ ኤ ፋና Ꮉኖዳኖ ኤራነ። ኤ ቱርታ የዛኖ ኑኒ በአዳ።<note caller="-" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="JHN 1:12">ዋሐ. 1:12</ref></char></note> <verse eid="1JN 3:2"/><verse number="3" style="v" sid="1JN 3:3"/>ክርስቶሳ በአዳ ጋእ ኡፋይሳር ናግዘ ኦንን፥ ክርስቶሳ ጌሽ ማቅዛንፋና ፋ ኦምቶ ጌሻነ።<verse eid="1JN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4"/>ናጋራ ህገ ላለ ማቅዘ ግሾ ናጋራ ኦችዘ ኡባ ጾዘ ህግቶ ላላነ። <verse eid="1JN 3:4"/><verse number="5" style="v" sid="1JN 3:5"/>ክርስቶሳ አስ ናጋራ ብሶደስ ቆንጭዳኖ ይን ኤራነ፤ ኤዛራ ናጋራ ባያ። <verse eid="1JN 3:5"/><verse number="6" style="v" sid="1JN 3:6"/>ክርስቶሳ የዘ ኦንን ናጋራራ የዞስ። ማህ ናጋራራ የዘ ኦንን ኤዛ ብእካያ ዎይ ኤርካያ።<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="JHN 1:29">ዋሐ. 1:29</ref></char></note><verse eid="1JN 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7"/>ታ ናኡን፥ ይንታና ኦንን ባልፐ። ክርስቶሳ ጽሎ ማቅዳን ፋና ጽሎ ኦችዘ ኦንን ጽሎ። <verse eid="1JN 3:7"/><verse number="8" style="v" sid="1JN 3:8"/>ጻላሄ ቲኖፓ ናጋራ ኦችዘ ግሾ ናጋራ ኡባ ዎደ ኦችዘ ኦንን ጻላሄ እግና። ይኒ ግሾ፥ ጾዘ ናአይ ጻላሄ ኦቻ ብሶደስ ቆንጭዳ። <verse eid="1JN 3:8"/><verse number="9" style="v" sid="1JN 3:9"/>ጾዘ ናኡንና ማቅደ ኦንን ጾዘ አያና ኤዛር የዘ ግሾ ኤ ኡባ ዎደ ናጋራራ የዞስ። ጾዚ ኤስ አደ ማቅደ ግሾ ናጋራራ የዞስ። <verse eid="1JN 3:9"/><verse number="10" style="v" sid="1JN 3:10"/>ጾዘ ናኡንን ጻላሄ ናኡን ዱማተታ Ꮉነ ኤርንታነ፤ ጽሎ ኦቾሰ አስ ዎይ ፋ እሻያ ካኦሰ አስ ጾዘ ናአ ማቆስ።<verse eid="1JN 3:10"/></para>
  <para style="s1">ፈታይ ፈታያ ካተ</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11"/>ቲኖፓ ይን ስእደ ኪታ፥ «ፈተ ፈታያ ካደስ ቤዛነ» ጋዘ ኪታ። <verse eid="1JN 3:11"/><verse number="12" style="v" sid="1JN 3:12"/>ኑኒ ቃኤላ ፋና ማቆደስ ቤዞስ። ቃኤላ ጻላሄ እግና ማቂ ፋ እሻያ ዎዳ። ኤ ፋ እሻያ አኮስ ዎዶ? ኤ ኦችታ ኢታ ማቅደ ግሾን ኤ እሻይ ኦችታ ሎኦ ማቅደ ግሾ ዎዳ።<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዋሐ. 13:34</ref></char></note><verse eid="1JN 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13"/>ታ እሹን፥ Ꮉና አላመ አሱን ይንታና እጽኮ ጋማ ቆፕፐተ።<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="GEN 4:8">መ 4:8</ref></char></note> <verse eid="1JN 3:13"/><verse number="14" style="v" sid="1JN 3:14"/>ኑኒ ኑ እሹንና ሲቅዘ ግሾ Ꮉይቆፓ ደኦ ፊንግዳኖ ኤራነ። ፋ እሻያ ካኦሰ ኦንን Ꮉይቆ ዳሾ ግዳ የዛነ። <verse eid="1JN 3:14"/><verse number="15" style="v" sid="1JN 3:15"/>ፋ እሻያ እጽዘ ኦንን ሸምፖ ዎዛያ። ማህ ሸምፖ ዎዘ ኦደስን መዽና ደኦ ባይዛኖ ይን ኤራነ።<note caller="-" style="x"><char style="xo" closed="false">3:15 </char><char style="xt" closed="false"><ref loc="JHN 5:24">ዋሐ. 5:24</ref></char></note> <verse eid="1JN 3:15"/><verse number="16" style="v" sid="1JN 3:16"/>ክርስቶሳ ፋ ሸምፕቶ ኑ ግሾ አ እንግዳነ ሲቆ አኮ የዛኮ ኑ ኤርዳ። ኑንን ኑ እሹን ግሾ ኑ ሸምፕቶ አ እንጎደስ ቤዛነ። <verse eid="1JN 3:16"/><verse number="17" style="v" sid="1JN 3:17"/>የዝን Ꮉና አላምተ ቆሎ የዘ ኦንን ማዛ ብእተራ፥ ኤስ ይቅስንታንጽኮ ፋ ዎዝንተ ጾዘ ሲቆ የነ ጋዉደስ ዋይዝ ዳንዳኦደ? <verse eid="1JN 3:17"/><verse number="18" style="v" sid="1JN 3:18"/>ታ ናኡን፥ ኑ ኦቻራን ቱረትራ ኑ ሲቅቶ ቆንጭሳደስ ቤዛነ ፋትን Ꮉሪ ኦሄ ጻላላራ ዎይ ዶና ጻላላራ ሲቅንቶደስ ቤዞስ።<verse eid="1JN 3:18"/></para>
  <para style="s1">ጾዛላ የዘ አማንንተ</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19"/>ኑኒ ፈተ ፈታያ ሲቅኮ፥ ይነ ኑኒ ቱሪ ባጋ ማቅዛኖ ኤራነ፤ ይንስ ጾዘ ቲኖ ዬልስ። <verse eid="1JN 3:19"/><verse number="20" style="v" sid="1JN 3:20"/>ኑ ዎዝንታ ኑላ አፋ ፍርድዛ ማቅኮ፥ ጾዘ ኑ ዎዝንትፓ ዳማ ማቅዛኖ ኤራነ፤ ኤ ኡባ ባዝ ኤራነ።<verse eid="1JN 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 3:21"/>ታ ሲቁን፥ ኑ ዎዝንታ ኑላ አፋ ፍርድዛ ማቅኮ ኑኒ ጾዘ ቲኖ ዣሽቶስ። <verse eid="1JN 3:21"/><verse number="22" style="v" sid="1JN 3:22"/>ኑኒ ኤ ኪቶ ናግዘ ግሾን ኤዛ ኡፋይስዘ ባዝ ኦችዘ ግሾ ዎስዘ ባዝ ኡባ ኤፓ ኤካነ። <verse eid="1JN 3:22"/><verse number="23" style="v" sid="1JN 3:23"/>ክርስቶሳ ኑና ኪትዳን ፋና ጾዘ ናአያ የሱስ ክርስቶሳ አማኖደ ጋራን ፈተ ፈታያ ሲቆደ ፋና ጾዚ ኑና ኪትዳ። <verse eid="1JN 3:23"/><verse number="24" style="v" sid="1JN 3:24"/>ጾዘ ኪታ ናግዘ ኦንን ጾዛራ የነ፤ ጾዝን ኤራ የነ። ጾዚ ኑስ እንግደ ጌሽ አያና ባጋራ ኤ ኑራ የዛኖ ኤራነ።<note caller="-" style="x"><char style="xo" closed="false">3:24 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዋሐ. 13:34</ref>፤ <ref loc="JHN 15:12">15:12</ref>፥ <ref loc="JHN 15:17">17</ref></char></note><verse eid="1JN 3:24"/></para>
  <chapter eid="1JN 3"/>
  <chapter number="4" style="c" sid="1JN 4"/>
  <para style="s1">አያና ሻኪ ኤሮተ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1"/>ታ ሲቁን፥ አያና ኡባ አማንፐተ፥ የዝን ኡን ጾዛፓ የዛኮ ቁርች ቦኦተ። አኮስ ጋይኮ፥ ጋማ ዎርዶ ናቡን አላመላ ደንድዳ። <verse eid="1JN 4:1"/><verse number="2" style="v" sid="1JN 4:2"/>የሱስ ክርስቶሳ አስ ማቂ ይእዳኖ አማንዘ አስ ኡባ ጾዘ አያና፤ ጾዘ አያና ማቅዛኖ ይን ይነ ኤሮዳ። <verse eid="1JN 4:2"/><verse number="3" style="v" sid="1JN 4:3"/>ክርስቶሳ አስ ማቂ ይእዳኖ አማኖሰ አስ ግዳ ጾዘ አያና ባያ። የይኒ ክርስቶሳ እጽዘ አያና። ይን የ አያንዘ የኦዳኖ ቲኖ ስእዳ፤ ኤ መለ አቶ የዝን Ꮉተን አላመ የነ።<verse eid="1JN 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4"/>ታ ናኡን፥ ይን ጾዝስ። ይን ግዳ የዘ ጌሽ አያና አላመ የዘ አያናፓ ዳማ ዎልቃማ ማቅደ ግሾ ዎርዶ ናቡንና ይን ጋምዳ። <verse eid="1JN 4:4"/><verse number="5" style="v" sid="1JN 4:5"/>ኡን Ꮉና አላምት አስ ማቅደ ግሾ Ꮉና አላምትባዝ ኦህነ፤ Ꮉና አላምት አስ ኡን ኦህቶ ስእነ። <verse eid="1JN 4:5"/><verse number="6" style="v" sid="1JN 4:6"/>ኑኒ ጾዛፓ፤ ጾዛ ኤርዘ ኦንን ኑና ስእነ። ጾዛ ኤሮሰ ኦንን ኑና ስኦስ። ኑኒ ቱሪ አያናን ዎርዶ አያና ይነ ሻካነ።<verse eid="1JN 4:6"/></para>
  <para style="s1">ጾዚ ሲቆ</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7"/>ታ ሲቁን፥ ሲቆ ጾዛፓ ይእዘ ግሾ አነ ፈታይ ፈታይራ ሲቅንቶተ። ሲቅዘ ኦንን ጾዘ ናአ፤ ኤ ጾዛ ኤራነ። <verse eid="1JN 4:7"/><verse number="8" style="v" sid="1JN 4:8"/>ጾዚ ሲቆ ማቅዘ ግሾ ሲቆሰ ኦንን ጾዛ ኤሮስ። <verse eid="1JN 4:8"/><verse number="9" style="v" sid="1JN 4:9"/>ኑኒ ክርስቶሳ ባጋራ ደኦ ደንጎደ ፋና ጾዚ ፋ ፈቲ ናአያ Ꮉና አላምተ ኪትዳ። ጾዚ ኑና ፋ ሲቅቶ ይነ ቤዝዳ። <verse eid="1JN 4:9"/><verse number="10" style="v" sid="1JN 4:10"/>ቱሪ ሲቆ ጋዛና ይኬ፦ ኑኒ ጾዛ ሲቅደ ግሾ ባይዝን ጾዚ ኑና ሲቅደ ግሾን ኑ ናጋርት ግሾ ዣርሽንት ኑና ማሮደስ ፋ ናአያ ኪትደ ግሾ።<verse eid="1JN 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11"/>ታ ሲቁን፥ ጾዚ ኑና Ꮉኒ ጋር ሲቅኮ፥ ኑንን ፈተ ፈታያ ሲቆደስ ቤዛነ። <verse eid="1JN 4:11"/><verse number="12" style="v" sid="1JN 4:12"/>ጾዛ ብእደ ኦንን ባያ። ኑ ፈተ ፈታያ ሲቅኮ ጾዚ ኑራ የነ፤ ኤ ሲቅታን ኑላ ፎሎ ማቃነ።<verse eid="1JN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">4:13 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:18">ዋሐ. 1:18</ref>
      </char>
    </note>ጾዚ ፋ ጌሽ አያና ኑስ እንግደ ግሾ ኑኒ ጾዛራ የዛኖን ኤዝን ኑራ የዛኖ ኤራነ። <verse eid="1JN 4:13"/><verse number="14" style="v" sid="1JN 4:14"/>አዳይ ፋ ናአያ፥ Ꮉና አላምቶ አሾደ ፋና ኪትዳኖ ኑኒ ብእ ማርክነ። <verse eid="1JN 4:14"/><verse number="15" style="v" sid="1JN 4:15"/>የሱሳ ጾዘ ናአ ማቅዛኖ አማኒ ማርክዘ ኦደራን ጾዚ የነ፤ ኤዝን ጾዛራ የነ። <verse eid="1JN 4:15"/><verse number="16" style="v" sid="1JN 4:16"/>ጾዚ ኑና ሲቅዛኖ ኑኒ ኤራነን አማናነ።</para>
  <para style="p" vid="1JN 4:16">ጾዚ ሲቆ። ሲቆ የዘ ኦንን ጾዛራ የነ፤ ጾዝን ኤራ የነ። <verse eid="1JN 4:16"/><verse number="17" style="v" sid="1JN 4:17"/>ኑ የስታ Ꮉና አላምተ ክርስቶሳ የዝዳን ፋና ማቅዘ ግሾ ፍርዳ ቃማ ዣሽትካይዛራ ኤ ቲኖ ሺቆደስ ኤ ሲቅታ ኑ ግዳ ፎሎ ማቃነ። <verse eid="1JN 4:17"/><verse number="18" style="v" sid="1JN 4:18"/>ሲቆ ግዳ ዣሽሞ ባያ፥ ቱሪ ሲቆ ዣሽሞ ኬሲ ኦላነ። ዣሽሞ ሴርራ ዎላ Ꮉንግዘ ግሾ ዣሽትዘ አ ሲቅታ ፎሎ ማቆስ።<verse eid="1JN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19"/>ጾዚ ቲኖ ኑና ሲቅደ ግሾ ኑንን ሲቃነ። <verse eid="1JN 4:19"/><verse number="20" style="v" sid="1JN 4:20"/>ኦንን፥ «ጾዛ ሲቃነ» ጋእትራ ፋ እሻያ እጽኮ፥ ኤ ዎርዶ። አኮስ ጋይኮ፥ በእዘ ፋ እሻያ ሲቆሰ ኦንን ብእካይዘ ጾዛ ሲቆደስ ዋይዝ ዳንዳኤ? <verse eid="1JN 4:20"/><verse number="21" style="v" sid="1JN 4:21"/>ክርስቶሳ ኑስ እንግደ ኪታ Ꮉኖ፤ «ጾዛ ሲቅዘ ኦንን ፋ እሻያ ሲቆደስ ቤዛነ» ጋዛኖ።<verse eid="1JN 4:21"/></para>
  <chapter eid="1JN 4"/>
  <chapter number="5" style="c" sid="1JN 5"/>
  <para style="s1">አላመ አማኖራ ጋመ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1"/>የሱሳ፥ ኤ ክርስቶሳ ጋእ፥ አማንዘ ኦንን ጾዘ ናአ። አዳያ ሲቅዘ ኦንን ኤ ናአያን ሲቃነ። <verse eid="1JN 5:1"/><verse number="2" style="v" sid="1JN 5:2"/>ኑኒ ጾዛ ሲቅዘ ግሾን ኤ ኪቶ ናግዘ ግሾ ጾዘ ናኡንና ሲቅዛኖ ይነ ኤራነ። <verse eid="1JN 5:2"/><verse number="3" style="v" sid="1JN 5:3"/>ኑኒ ጾዛ ሲቅኮ፥ ኤ ኪቶ ናገነ። ኤ ኪታ ዴጽዘባዝ ባያ። <verse eid="1JN 5:3"/><verse number="4" style="v" sid="1JN 5:4"/>አኮስ ጋይኮ፥ ጾዘ ናአ ማቅደ ኦንን Ꮉና አላምቶ ጋሞደስ ዳንዳአነ። ኑኒ Ꮉና አላምቶ ጋሞዳና አማኖራ።<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="JHN 14:15">ዋሐ. 14:15</ref></char></note> <verse eid="1JN 5:4"/><verse number="5" style="v" sid="1JN 5:5"/>አላመ ጋሞደስ ዳንዳእዘ ኦደ? የሱሳ ጾዘ ናአ ማቅዳኖ አማንዘ አስ ጻላላ ጋሞዳ።<verse eid="1JN 5:5"/></para>
  <para style="s1">ክርስቶሳስ እንግንትደ ማርካት</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6"/>የሱስ ክርስቶሳ ጽንቃተ ቤዝዘ Ꮉራን Ꮉይቆ ቤዝዘ ሱራ ይእዳ። ኤ፥ Ꮉራን ሱራ ይእዳ ፋትን Ꮉ ጻላላራ ይእካያ። ጌሽ አያና ቱሮ ማቅደ ግሾ ይና ቱሮ ማቅዛኖ ማርክነ። <verse eid="1JN 5:6"/><verse number="7" style="v" sid="1JN 5:7"/>Ꮉይ ማርኩን የነ። <verse eid="1JN 5:7"/><verse number="8" style="v" sid="1JN 5:8"/>የንስ፥ ጌሽ አያና፥ Ꮉን ሱ። Ꮉን Ꮉይን ማርካትታ ፈቶ። <verse eid="1JN 5:8"/><verse number="9" style="v" sid="1JN 5:9"/>ኑ አስ ማርክዛኖ ኤካነ። የዝን ጾዘ ማርካትታ አሳንፓ ጋማ አነ። ጾዚ ፋ ናአይስ ማርክዳና Ꮉኖ። <verse eid="1JN 5:9"/><verse number="10" style="v" sid="1JN 5:10"/>ጾዘ ናአያ አማንዘ አ ዎዝንተ Ꮉና ማርካትታ የነ። ጾዛ አማኖሰ ኦንን ጾዘ ፋ ናአይስ ማርክደ ማርካትቶ አማንካይዘ ግሾ ጾዛ ዎርዶ ማህነ።<verse eid="1JN 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 5:11"/>ይኬ፥ ማርካትታ Ꮉኖ፤ ጾዚ ኑስ መዽና ደኦ እንግዳ፤ ይና ደእታን ኤ ናአይራ የነ። <verse eid="1JN 5:11"/><verse number="12" style="v" sid="1JN 5:12"/>ጾዘ ናአይ የዘ ኦደስን ደኦ የነ። ጾዘ ናአይ ባይዘ ኦደስን ደኦ ባያ።<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="JHN 3:36">ዋሐ. 3:36</ref></char></note><verse eid="1JN 5:12"/></para>
  <para style="s1">መዽና ደኦ</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13"/>ጾዘ ናአ አማንዘ ይንትስ መዽና ደኦ የዛኖ ይን ኤሮደ ፋና Ꮉኖ ይንትስ ጻፍዳ። <verse eid="1JN 5:13"/><verse number="14" style="v" sid="1JN 5:14"/>ጾዘ ቆፋ ጋር አኮ ባዝን ኤዛ ዎስኮ፥ ኤ ስእዛኖ ኑኒ ኤርዘ ግሾ ኤዛ አማንንታነ። <verse eid="1JN 5:14"/><verse number="15" style="v" sid="1JN 5:15"/>ኑኒ ዎስደባዝ ኡባ ኤ ስእዛኖ ኤርኮ፥ ኑኒ ዎስዘ ባዝ ኡባ ኤ እንጎዳኖ ኤራነ።<verse eid="1JN 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16"/>ኦንን ፋ እሻያ Ꮉይቆ ቤዞሰ ናጋራ ኦችዝን ብእኮ፥ ጾዝ ኤስ ዎሶደስ ቤዛነ። Ꮉይቆ ቤዞሰ ናጋራ ኦችዱንስ ጾዚ ደኦ እንጋነ። Ꮉይቆ ቤዝዘ ናጋራ የነ። ታኒ ይንታና ይንስ ጾዝ ዎሶተ ጋኦስ። <verse eid="1JN 5:16"/><verse number="17" style="v" sid="1JN 5:17"/>ኢታ ኦቻ ኡባ ናጋራ፥ የዝን Ꮉይቆ ቤዞሰ ናጋራ የነ።<verse eid="1JN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18"/>ጾዘ ናአይ ኡንታና ናግዘ ግሾ ጾዘ ናኡና ማቅደ ኦንን ናጋራ ኦቾሳኖ ኑኒ ኤራነ። ጻላሄ ኡንታና ቆሆደስ ዳንዳኦስ። <verse eid="1JN 5:18"/><verse number="19" style="v" sid="1JN 5:19"/>ኑኒ ጾዝስ ማቅዳኖ Ꮉና ኩሙ አላምታ ጻላሄስ አቅዛኖ ኤራነ።<verse eid="1JN 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20"/>ኑኒ ቱሪ ጾዛ ኤሮደ ፋና ጾዘ ናአይ ይእዳኖን ኑስ ቆፕዘ ዎዝና እንግዳኖ ኤራነ። ኑኒ ኤ ናአ፥ የሱስ ክርስቶሳ ባጋራ ቱሪ ጾዛራ የነ። ኑኒ ቱሪ ጾዛራን ናአይ የሱስ ክርስቶሳራ ፈተት የነ።<verse eid="1JN 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21"/>ታ ናኡን፥ ኤቁንፓ Ꮉኮተ።<verse eid="1JN 5:21"/></para>
  <chapter eid="1JN 5"/>
</usx>
