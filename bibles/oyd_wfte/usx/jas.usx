<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Oyda New Testament</book>
  <para style="h">ያይቆባ</para>
  <para style="toc1">ያይቆባ ጻፍደ ኪታ</para>
  <para style="toc2">ያይቆባ</para>
  <para style="toc3">ያይ.</para>
  <para style="mt1">ያይቆባ ጻፍደ ኪታ</para>
  <para style="imt1">ገለ</para>
  <para style="ip">ያይቆባ ኪታ፥ አማንዘ አሱን ፋ የዘ የስተ ካሎደስ በዝዘ ቆፍቶ አይክዳ። Ꮉና ኪታ ጻፍንትዳና፥ ሳአ ኡባነ ላልንትደ ታጶ ላምእ አይሁደ ዛሩንስ። Ꮉይ ማጻፍዘ ጻፍዘ፥ ጭንጫት ኑ ኦቻላ ፌሽዘ ኦገ፥ አማንዘ አስ ሞክዘ ባዝን ሎኦ ዎጋ ኦገ ቤዝዘ ኦህቶ ምስለ ጋር ቆንጭዛነ።</para>
  <para style="ip">ያይቆባ ኪታ፥ ዳሃትባዝ፥ ዱረትባዝ፥ ፋታናባዝ፥ ሎኦ ዎጋባዝ፥ ቃናትዘባዝ፥ አማኖባዝ፥ ሎኦ ኦቻባዝ፥ እልአን Ꮉርዘባዝ፥ ጭንጭቱሞባዝ፥ ፈተ ፈተራ ካጭንትዘባዝ፥ ኡቱራባዝ፥ አሽከትባዝ፥ መለ አሳላ አፋ ፍርድዘባዝ፥ ጬቅንትዘባዝ፥ ዳንዳአባዝ፥ ዎሳ ባዝን አማንዘ አስ ኦቾደስ ኮሽዘባዝ ኡባ ብሊ ጻፍዳ።</para>
  <para style="ip">ያይቆባ ኪታ፥ አማኖ የሳ አማኖ ኦቻላ ፌሽዘ Ꮉኖት ቆንጭዝ ቤዛነ።</para>
  <para style="iot">ኣፈ ቆፉን</para>
  <para style="io1">ሳር <char style="ior"><ref loc="JAS 1:1">1:1</ref> </char></para>
  <para style="io1">አማኖን ጭንጫት <char style="ior"><ref loc="JAS 1:2-8">1:2-8</ref> </char></para>
  <para style="io1">ዳህቱሞን ዱርቱሞን <char style="ior"><ref loc="JAS 1:9-11">1:9-11</ref> </char></para>
  <para style="io1">ፋታና <char style="ior"><ref loc="JAS 1:12-18">1:12-18</ref> </char></para>
  <para style="io1">ጾዘ ቃላ ስስን ኦቻላ ፌሸ <char style="ior"><ref loc="JAS 1:19-27">1:19-27</ref> </char></para>
  <para style="io1">አስ አሳፓ ዱሙዘ ኮሾሳኖ <char style="ior"><ref loc="JAS 2:1-13">2:1-13</ref> </char></para>
  <para style="io1">አማኖን ኦቻ <char style="ior"><ref loc="JAS 2:14-26">2:14-26</ref> </char></para>
  <para style="io1">እልአን ናገባዝ <char style="ior"><ref loc="JAS 3:1-18">3:1-18</ref> </char></para>
  <para style="io1">አማንዘ አስን Ꮉና አላምቶ <char style="ior"><ref loc="JAS 4:1-5:6">4:1—5:6</ref> </char></para>
  <para style="io1">ዱማ ዱማ ዞረ <char style="ior"><ref loc="JAS 5:7-20">5:7-20</ref> </char></para>
  <chapter number="1" style="c" sid="JAS 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1"/>ጾዘን ላ የሱስ ክርስቶሳ አሮ፥ ያይቆባ፥ ሳአ ኡባ ላልንትደ ታጶ ላምእ ኮቹንስ ኪትደ ኪታ።<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="MAT 13:55">ማቶ. 13:55</ref>፤ <ref loc="MRK 6:3">ማር. 6:3</ref>፤ <ref loc="ACT 15:13">ሐዋ. 15:13</ref>፤ <ref loc="GAL 1:19">ጋላ. 1:19</ref></char></note></para>
  <para style="p" vid="JAS 1:1">ሳሮ ይንትስ ማቀ።<verse eid="JAS 1:1"/></para>
  <para style="s1">አማኖን ጭንጫትን</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2"/>ታ እሹን፥ ይንታና ዱማ ዱማ ፋታና የልዘ ዎደ ይን ሎኦ ባዝ ደንግደ ፋና ኩሙ ኡፋይሳራ ኤኮተ። <verse eid="JAS 1:2"/><verse number="3" style="v" sid="JAS 1:3"/>ይን አማንቶ ፋታንዛና ዳንዳአ ይንትስ እንግዛኖ ኤራነ። <verse eid="JAS 1:3"/><verse number="4" style="v" sid="JAS 1:4"/>ይን ዉርሱ የሎደስ ዳንዳእኮ አኮ ፋጨ ባይዝን ፎሎን ኩሙ ማቃደ ፋና ኦችዛ ማቀ። <verse eid="JAS 1:4"/><verse number="5" style="v" sid="JAS 1:5"/>ይንታፓ ኦደስን ጭንጫት ብኮ ጾዝ ዎሶ። ኤስ እንግንቶዳ። ጾዚ ኦደን ቦርካይዛራ ኡቡንስ ኬሃትራ እንግዘ ጾዚ። <verse eid="JAS 1:5"/><verse number="6" style="v" sid="JAS 1:6"/>የዝን ኤ ዎስዘ ዎደ ሶእካይዛራ አማኖራ ጾዝ ዎሶ። ሶእዘ ኦደን ባቆ ኡርቂን ኤንእዘ አባ ጋር። <verse eid="JAS 1:6"/><verse number="7-8" style="v" sid="JAS 1:7-8"/>ላምእ ቆፋ የዘን ፋ ኦግተ ኤቆሰ ኦደን ላፓ አኮን ደንጎዳ ጋእ ቆፕፐ።<verse eid="JAS 1:7-8"/></para>
  <para style="s1">ዳሃ አስን ዱረ አስ</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9"/>አማንዘ ዳሁን፥ ጾዚ ኡንታና ቅ ኦችዘ ዎደ ኡፋይቶ። <verse eid="JAS 1:9"/><verse number="10" style="v" sid="JAS 1:10"/>ማህ አማንዘ ዱሩን ጾዚ ኡንታና ዝቂ ኦችዘ ዎደ ኡፋይቶ። ዱረ አሱን ፉ ፋና ቦዳ።<note caller="-" style="x"><char style="xo" closed="false">1:10-11 </char><char style="xt" closed="false"><ref loc="ISA 40:6-7">ኢሳ. 40:6-7</ref></char></note> <verse eid="JAS 1:10"/><verse number="11" style="v" sid="JAS 1:11"/>አዋ ፋ ምሻራ ከዛነ ማቶ መልዛነ፥ ፉታን ጉፋነ፤ ኤ ሎኦትታን ባነ። ይኒ ፋና፥ ዱረ አሱን ፋ ኦችተ ጨር ላልተራ ቦዳ።<verse eid="JAS 1:11"/></para>
  <para style="s1">አስ የልዘ ፋታና</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12"/>ማ ጋሚ ኣዳንፕ ሱባ፥ ጾዚ ፋና ሲቅዙንስ እንጎዳ ጋእ ቃላ ገልደ ደኦ ዎርቃ ዛዉደ ኤኮደ ግሾ ማተ ገንጭዘ አስ አንጅንትዳያ። <verse eid="JAS 1:12"/><verse number="13" style="v" sid="JAS 1:13"/>ኦደን ፋታንንትዘ ዎደ «ታና ጾዚ ፋታናነ» ጋይፐ። ጾዚ ኢታራ ፋታኖስ፤ ማህ ኤ ኦደን ፋታኖስ። <verse eid="JAS 1:13"/><verse number="14" style="v" sid="JAS 1:14"/>የዝን ፈቲ ፈቲ አስ ፋ ኢታ አሞራ ጎችንትዘ ዎደን ጭምንትዘ ዎደ ፋታንንታነ። <verse eid="JAS 1:14"/><verse number="15" style="v" sid="JAS 1:15"/>ይንፓ ሱባ፥ አሞት ዎዳጺ ናጋራ የላነ፤ ማህ ናጋራ ድጪ Ꮉይቆ የላነ።<verse eid="JAS 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16"/>ታ ሲቆ እሹን፥ ጭምንትፐተ። <verse eid="JAS 1:16"/><verse number="17" style="v" sid="JAS 1:17"/>ሎኦ እሞን ኩሙ አንጆ ኡባ ሳሎፓን ሳሎ ፎእቶ መደ ጾዘ አደፓ የእነ። ጾዚ ዳሾ ፋና ኡባ ዎደ ላምንቶስ። <verse eid="JAS 1:17"/><verse number="18" style="v" sid="JAS 1:18"/>ኑኒ፥ ኤ መደ ባዝስ አንግስ ማቃደ ፋና ኑና ቱሪ ቃላራ ቆፒ የልዳ።<verse eid="JAS 1:18"/></para>
  <para style="s1">ስስን ኦቻን</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19"/>ታ ሲቆ እሹን፥ Ꮉኖ ቆፖተ። አስ ኡባ ስኦደስ ኤልሶ፥ የዝን ኦሆደስን Ꮉንቆደስ ኤልስፐ። <verse eid="JAS 1:19"/><verse number="20" style="v" sid="JAS 1:20"/>አስ Ꮉንቆ ጾዘ ኮይዘ ጽሎት ኮኦስ። <verse eid="JAS 1:20"/><verse number="21" style="v" sid="JAS 1:21"/>ይኒ ግሾ፥ ቱና ኦቻን ኢታ ባዝ ኡባ Ꮉሲ፥ ጾዚ ይን ዎዝንተ ቱክደ ይን ሸምፕቶ አሾደስ ዳንዳእዘ ቃላ አዳትራ ኤኮተ።<verse eid="JAS 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22"/>የዝን ጾዘ ቃላ ኦቻላ ፌሾተፕ አትን ይን ኦምተ ባልንትተራ ስእዙንና ጻላላ ማቅፈተ። <verse eid="JAS 1:22"/><verse number="23" style="v" sid="JAS 1:23"/>ቃላ ስእ ኦቾሰ አስ፥ ኤ ፋ ስንቶ ማስቶተራ በእዘ አ ፋና። <verse eid="JAS 1:23"/><verse number="24" style="v" sid="JAS 1:24"/>ኤ ፋ ስንቶ ብእ ቅታነ፥ የዝን ኤ አኮ አዝዛኮ ኤልሲ ቦታነ። <verse eid="JAS 1:24"/><verse number="25" style="v" sid="JAS 1:25"/>የዝን ኦደን ናጋራ አሮትፓ ኬስዘ ፎሎ ህገ ቆፒ ብእ፥ ሚንግ ኤቅዘ፥ ስእዳኖ ቦትካይዛራ ኦቻላ ፌሽዘ አይ፥ ፋ ኦቻ ኡባነ አንጅንቶዳ።<verse eid="JAS 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26"/>ፋ እልአንቶ ናግካይዛራ ጎይናነ ጋዘ አይ ፋና ጭማነ፤ ኤ ጎይንታ Ꮉሪ። <verse eid="JAS 1:26"/><verse number="27" style="v" sid="JAS 1:27"/>ጾዘ አዳይ ቲኖ ቦረ ባይዘ ጌሽ ጎይኖ Ꮉኖ፦ እንዳን አደን ባይዘ ናኡንናን አዝኒ ባይዙና ኡን ማተ ማደን አላመ ቱናፓ ፋና ናገ።<verse eid="JAS 1:27"/></para>
  <chapter eid="JAS 1"/>
  <chapter number="2" style="c" sid="JAS 2"/>
  <para style="s1">አስ ሻክፐ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1"/>ታ እሹን፥ ይን ኑ ቦንቾ ላ የሱስ ክርስቶሳ አማንዘባዝ ማቅኮ፥ አስ ስኖ ብእ አስ ቦንችፐተ። <verse eid="JAS 2:1"/><verse number="2" style="v" sid="JAS 2:2"/>አዝዘስ፥ ዎርቃ ምግዶ አ፥ ሎኦ ማኦ ማእደ ዱረ አስ ይን ሺቅተ ይእዳ። ማህ ጩርቃ ማኦ ማእደ ዳሃ አስን ይእዳ። <verse eid="JAS 2:2"/><verse number="3" style="v" sid="JAS 2:3"/>ሎኦ ማኦ ማእደ አ ይን አ ቦንቺ፥ «ነ Ꮉነ ሎእዘ ኦይዳላ በቶ» ጋእ፥ ማህ ዳሃ አ፥ «ነ የይጋ ኤቆ ዎይ Ꮉነ ታ ቶህት ካለ ሳእተ በቶ» ጋነ። <verse eid="JAS 2:3"/><verse number="4" style="v" sid="JAS 2:4"/>ዬዝን፥ ይን፥ ይን ግዳ ሻኮ መዙንና ኢታ ቆፋራ የዘ ዳይኑን ፋና ባነ?<verse eid="JAS 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5"/>ታ ሲቆ እሹን፥ ስኦተ። አማኖራ ዱረ ማቃደ ፋናን ፋና ሲቅዙንስ እንጎዳ ጋይደ ሳሎ ካእቱሞ ላቶደ ጋር Ꮉና ሳእተ የዘ ዳሁንና ጾዚ ዶርካነ? <verse eid="JAS 2:5"/><verse number="6" style="v" sid="JAS 2:6"/>የዝን ይን ዳሁንና ቶቻነ። ይንታና ኡንእዙንን ፍርዳ ኬ ጎችዙን ዱሩንና ባነ? ይንታና ዳይና ቲኖ ጎችዙን ኡንታና ባነ? <verse eid="JAS 2:6"/><verse number="7" style="v" sid="JAS 2:7"/>ይን ጼግንትዘ ይና ሎኦ ሱንቶ ጫዥዙን ኡንታና ባነ?<verse eid="JAS 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8"/>የዝን ጌሽ ማጻፍተ፥ «አስ ኡባ ነና ነ ካዛን ጋራ ካ» ጋእንት ጻፍንትደ ጾዘ ካእቱሞ ህግቶ ይን ፎልኮ ሎኦ ኦቻነ።<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ሌዌ 19:18</ref></char></note> <verse eid="JAS 2:8"/><verse number="9" style="v" sid="JAS 2:9"/>የዝን ይን አስ ስኖ ብእ ቦንችኮ፥ ናጋራ ኦቻነ፤ ማህ ህገን ይንታና ህገ መንደ አስ ፋና ፍርዶዳ። <verse eid="JAS 2:9"/><verse number="10" style="v" sid="JAS 2:10"/>ኦደን ጾዘ ህገ ኡባፓ ፈታ መን፥ አትዳኖ ኡባ ናግኮ ኡባኖ መንደ ፋና ፋይድንታነ። <verse eid="JAS 2:10"/><verse number="11" style="v" sid="JAS 2:11"/>«ላምፐ» ጋይደ ላ፥ ማህ «ዎፐ» ጋይዳ። የዝን ነ ላማንጽ አሺ ዎደ ባዝ ማቅኮ፥ ህገ መንዳ።<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="EXO 20:13-14">ከዘ 20:13-14</ref>፤ <ref loc="DEU 5:17-18">ማሄ 5:17-18</ref></char></note> <verse eid="JAS 2:11"/><verse number="12" style="v" sid="JAS 2:12"/>አሮትፓ ኬስዘ ህገ ቲኖ ፍርዳ ኤኮደስ የዘ አስ ፋና ኦህንቶተን ኦቾተ። <verse eid="JAS 2:12"/><verse number="13" style="v" sid="JAS 2:13"/>አስ ማሮሳ ኦናን ጾዚ ማርካይዛራ ፍርዶዳ። የዝን ማሮት ፍርዳ ጋማነ።<verse eid="JAS 2:13"/></para>
  <para style="s1">አማኖን ኦቻ</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14"/>ታ እሹን፥ ይንታፓ ፈቲ አስ ታስ አማኖ የነ ጋእ፥ ፋ አማንቶ ኦቻራ ቤዛንጽኮ ኤዛ አኮ ማዶደ? ኤ አማንታ ኤዛ አሾደስ ዳንዳአነ? <verse eid="JAS 2:14"/><verse number="15" style="v" sid="JAS 2:15"/>አዝዘስ ፈቲ እሻይ ዎይ ፈቲ ምሽታ ካልኮን ኡንትስ ሙእዘባዝ ብኮ፥ <verse eid="JAS 2:15"/><verse number="16" style="v" sid="JAS 2:16"/>ይንታፓ ፈቲ አስ ኡንታጎ፥ «ሳሮ ቅቶተ! ይንታና ታማ ካዦተ! ምዦተ!» ጋእ፥ ኮሽዘ ባዝ ኡንትስ እንጋንጽኮ ኡንታና አኮ ማደ? <verse eid="JAS 2:16"/><verse number="17" style="v" sid="JAS 2:17"/>ይኒ ግሾ፥ ኦቻ ባይዘ አማኖ ፋ ኦምተ Ꮉይቂዳያ።<verse eid="JAS 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18"/>የዝን ፈቲ አስ፥ «ኔስ አማኖ የነ፤ ማህ ታስ ኦቻ የነ። ኔኒ ነ አማንቶ ነ ኦችትፓ ሻጊ ታና ቤዞ፤ ታንን ታ አማንቶ ታ ኦችተ ነና ቤሳዳ» ጋዉዳ። <verse eid="JAS 2:18"/><verse number="19" style="v" sid="JAS 2:19"/>ኔኒ፥ ፈቲ ጾዚ የዛኖ አማናነ፤ ይና ሎኦ። ቱና አያኑንን አማናነ፤ ዣሽሞራ ጎቃነ። <verse eid="JAS 2:19"/><verse number="20" style="v" sid="JAS 2:20"/>ናተ ቦዛዮ! አማኖ ኦቻፓ ሻክንት ማዶሳኖ ኤሮደስ ኮያነ? <verse eid="JAS 2:20"/><verse number="21" style="v" sid="JAS 2:21"/>ኑ አዳይ አብራሃማ፥ ፋ ናአ ይሳቃ ዣርሾ በሳላ ጋድደ ዎደ ፋ ኦችትራ ጽልካነ?<note caller="-" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">መ 22:1-14</ref></char></note> <verse eid="JAS 2:21"/><verse number="22" style="v" sid="JAS 2:22"/>ኤ አማንታን ኤ ኦችታ ዎላ ትምንትዳኖ ቦኦሳ? ኤ አማንታ ኤ ኦችተ ፎልንትዳ። <verse eid="JAS 2:22"/><verse number="23" style="v" sid="JAS 2:23"/>ጌሽ ማጻፍታ፥ «አብራሃማ ጾዝ አማንዳ። ጾዚ ይኖ ኤስ ጽሎት ማህ ፋይድዳ» ጋይዳና ፎልንትዳ። ማህ ኤ ጾዘ እግና ጋእንት ጼግንትዳ።<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="GEN 15:6">መ 15:6</ref>፤ <ref loc="2CH 20:7">2 ዜና 20:7</ref>፤ <ref loc="ISA 41:8">ኢሳ. 41:8</ref></char></note> <verse eid="JAS 2:23"/><verse number="24" style="v" sid="JAS 2:24"/>አስ አማኖ ጻላላራ ማቅካይዝን ኦቻራ ጽልዛኖ በእነ።<verse eid="JAS 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25"/>ይኒ ፋና፥ ኦላለ Ꮉንትዘ ረአባ እስራኤለፓ ኪትንትዱንና ሞኪ መለ ኦገራ ኡንታና ሞይዝደ ዎደ ፋ ኦችተ ጽልካነ?<note caller="-" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="JOS 2:1-21">ኢያ. 2:1-21</ref></char></note><verse eid="JAS 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26"/>ሸምፖ ሻክንትደ አሾ Ꮉይቆ ማቅዛንፋና፥ ኦቻ ሻክንትደ አማኖን Ꮉይቆ።<verse eid="JAS 2:26"/></para>
  <chapter eid="JAS 2"/>
  <chapter number="3" style="c" sid="JAS 3"/>
  <para style="s1">እልአን ናገ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1"/>ታ እሹን፥ ይንታፓ ጋሙን አስታማረ ማቅፈ። ኑ፥ አስታማሩን መሉንፓ አዘ ፍርዳ ኤኮዳኖ ይን ኤራነ። <verse eid="JAS 3:1"/><verse number="2" style="v" sid="JAS 3:2"/>ኑ ኡባና ጋማ ባዛራ ባልንታነ። ፋ ኦህተ ባልንቶሰ ኦደን ፋናትቶ ናጎደስ ዳንዳእዘ ፎሎ አስ። <verse eid="JAS 3:2"/><verse number="3" style="v" sid="JAS 3:3"/>ፋራዚ ኑስ ኪትንቶደ ፋና ሉጋመ ባርሲ ኑ ኮይዘ በሳ ኡባ ካንታነ። <verse eid="JAS 3:3"/><verse number="4" style="v" sid="JAS 3:4"/>ማርካበ አኮ ፋና ዳማ ማቂ ዳማ ባቆራ ኡርቂንትኮን፥ ኤዛ እዥዘ አ ፋ ኮይዘ ዛላ ማህ ኤራ እዥዘ ባዛራ እዢ ቅታነ። <verse eid="JAS 3:4"/><verse number="5" style="v" sid="JAS 3:5"/>ይኒ ፋና እልአን ጋላ ግዳፓ ኤራ ማቅኮን ጋማ ዳማ ባዛ ጬቅንታነ።</para>
  <para style="p" vid="JAS 3:5">ኤራ ታማ ዳማ ጉርደ ምቻነ። <verse eid="JAS 3:5"/><verse number="6" style="v" sid="JAS 3:6"/>እልአን ታማ ፋና። እልአን ኑ አሽቲ ግዳ ኢታራ ኩምደ አላመ፤ ጋላ ኡባ ቱንዛነ። ጋናመፓ ከዝዘ ታማ ጋር ኑ ደኦ የስቶ ኡባ ምቻነ። ፋ ኦምትስን ጋናመ ምችንቶዳ። <verse eid="JAS 3:6"/><verse number="7" style="v" sid="JAS 3:7"/>ጾን ላንዳን፥ ሳዛር ጎቹንትዙንን አባ የዘ መንትደ ባዝ ኡባ አስ Ꮉራነ፤ ኡንትን Ꮉርንታነ። <verse eid="JAS 3:7"/><verse number="8" style="v" sid="JAS 3:8"/>የዝን ኦደን እልአን Ꮉሮደስ ዳንዳእካያ። እልአን ዎዘ ማርዘ ኩምደ አቆሰ ኢታ መ። <verse eid="JAS 3:8"/><verse number="9" style="v" sid="JAS 3:9"/>ኑ እልአንተ፥ ኑ፥ ላን አደ ማቅደ ኑ ጾዛ ጋላታነ። ማህ እራ ጾዝ አዚ መንትደ አስ ባዳነ። <verse eid="JAS 3:9"/><verse number="10" style="v" sid="JAS 3:10"/>ፈቲ ዶናፓ ጋላታን ባድን ከዛነ። ታ እሹን፥ ይኒ ጋራ ይአደስ ቤዞስ።<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="GEN 1:26">መ 1:26</ref></char></note> <verse eid="JAS 3:10"/><verse number="11" style="v" sid="JAS 3:11"/>Ꮉ ኣፈ ፈቲ ዶቻፓ ማልእዘ Ꮉን ጫንግዘ Ꮉ ከሳደስ ዳንዳአነ? <verse eid="JAS 3:11"/><verse number="12" style="v" sid="JAS 3:12"/>ታ እሹን፥ በለሰ ምንጻፓ ሻማሄ አፎደስ ዳንዳአነ? ዎይ ዎይነ ምንጻ በለሰ ምንጻ ኣፈ አፎደስ ዳንዳአነ? ጫሞ Ꮉ ኣፈፓ ማልኦ Ꮉ ኬሳደስ ዳንዳኦስ።<verse eid="JAS 3:12"/></para>
  <para style="s1">ሳሎ ጭንጫትን ሳአ ጭንጫትን</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13"/>ይን ግዳ ጭንጫን አካክዘ ኦደ? ፋ ሎኦ የስቶ፥ አሽከትራን ጭንጫትራን የዚ ቤዞ። <verse eid="JAS 3:13"/><verse number="14" style="v" sid="JAS 3:14"/>የዝን ይን ዎዝንተ ጫሞ ቃናተን ፋና ካዘባዝ የዝኮ ይና ጭንጫትተ ጬቅንትፐተ፤ ቱርላ አፋ ዎርድፐተ። <verse eid="JAS 3:14"/><verse number="15" style="v" sid="JAS 3:15"/>ይኒ ጋርዘ ጭንጫት ሳሎፓ ይእደባዝ ማቅካይዝን ይና አሳፓ፥ አላመፓ፥ ጻላሄፓ። <verse eid="JAS 3:15"/><verse number="16" style="v" sid="JAS 3:16"/>ቃናተን ፋና ካዘባዝ የዘ በሳ ካችን ኢታ ኦቻ ኡባ የነ። <verse eid="JAS 3:16"/><verse number="17" style="v" sid="JAS 3:17"/>የዝን ሳሎፓ የእዘ ጭንጫት ኡባፓ ቲኖ ጌሽ። ማህ ሳሮት፥ ሎኦት፥ ኪትንተ፥ አስ ማረ፥ ሎኦ ኣፈ ኩምዳያ፥ አስ ሻጎሳን ጩቦት ባይዛያ። <verse eid="JAS 3:17"/><verse number="18" style="v" sid="JAS 3:18"/>ሳሮት ካዙን ሳሮት ቡድ ጽሎት ኣፈ ማጻነ።<verse eid="JAS 3:18"/></para>
  <chapter eid="JAS 3"/>
  <chapter number="4" style="c" sid="JAS 4"/>
  <para style="s1">Ꮉና አላምቶ ካፐተ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1"/>ኦላን ካች ይን ግዳ አባፓ የኤ? ኡን የእዛና ይን አሽቶ Ꮉሮደስ ኦልንትዘ ይን አሾ አሞፓ ባነ? <verse eid="JAS 4:1"/><verse number="2" style="v" sid="JAS 4:2"/>ይን አሙነ፥ የዝን ደንጎስ፤ ይኒ ግሾ፥ አስ ዎነ። ምን ኮያነ፥ የዝን ደንጎደስ ዳንዳኦስ፤ ይኒ ግሾ፥ ካጭንታነን ኦልንታነ። ይን ጾዝ ዎሶሰ ግሾ ኮይዘ ባዝ ደንጎስ። <verse eid="JAS 4:2"/><verse number="3" style="v" sid="JAS 4:3"/>ይን ዎሳነ፥ የዝን ደንጎስ። ይን አሾ አሙቶ ፎሎደስ ዎቦ ኦገ ዎስዘ ግሾ ደንጎስ። <verse eid="JAS 4:3"/><verse number="4" style="v" sid="JAS 4:4"/>ይን፥ አማንንቶሱን! Ꮉና አላምቶ ካዽዘ ጾዛራ ሞርከ ማቅዛኖ ኤሮሳ? Ꮉና አላምትራ እግንደስ ኮይዘ ኦደን ጾዛራ ሞርከ። <verse eid="JAS 4:4"/><verse number="5" style="v" sid="JAS 4:5"/>ጌሽ ማጻፍተ፥ «ጾዚ ኑ ግዳ የሳደ ፋና ጋድደ አያንዘ፥ ኑ ኤስ ቡዞ ማቃደ ፋና ዳማ አሙነ» ጋይዳና ጨር ጋይደባዝ አዛነ? <verse eid="JAS 4:5"/><verse number="6" style="v" sid="JAS 4:6"/>የዝን ጌሽ ማጻፍተ፥ «ጾዚ ኡቱርትዙንና እጻነ፥ የዝን ፋና ቶችዙንስ አ ኬሃት እንጋነ» ያጋዘ ግሾ ጾዚ አ ኬሃት ጋን እንጋነ።<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PRO 3:34">አዝዜ 3:34</ref></char></note><verse eid="JAS 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7"/>ይኒ ግሾ፥ ጾዝስ አቆተ፤ ጻላሄራ እጽንቶተ፤ ኤ ይንታፓ Ꮉኮዳ። <verse eid="JAS 4:7"/><verse number="8" style="v" sid="JAS 4:8"/>ጾዛጎ ሺቆተ፤ ኤ ይንታጎ ሺቆዳ። ይን፥ ናጋራንቹን፥ ይን ኩሽቶ ሜጮተ፤ ላምእ ቆፋ የዙን፥ ይን ዎዝንቶ ጌሾተ። <verse eid="JAS 4:8"/><verse number="9" style="v" sid="JAS 4:9"/>አዛኖተ፥ ዬኮተን አፉጾተ። ይን ሚችታ ዬፎራ፥ ይን ኡፋይስታ አዛኖራ ላምንቶ። <verse eid="JAS 4:9"/><verse number="10" style="v" sid="JAS 4:10"/>ላ ቲኖ ይንታናትቶ ዝቂ ዪዞተ፤ ኤ ይንታና ቅ ቅ ዪሳዳ።<verse eid="JAS 4:10"/></para>
  <para style="s1">ፍርድፐተ</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11"/>ታ እሹን፥ ፈታይ ፈታያ ጫዥፐን ዝግርፐተ። ፋ እሻ ዝግርዛይ ኤላ አፋ ፍርድዘ ህገ ዝግራነን ህገላ አፋ ፍርዳነ። ነ ህገላ አፋ ፍርድኮ ህገላ አፋ ፍርድዛያ ማቃነፕ አትን ህገ ፎልዛያ ማቆስ። <verse eid="JAS 4:11"/><verse number="12" style="v" sid="JAS 4:12"/>ህገ እንግዘን ፍርድዘ ጾዛ ጻላላ። አሾደስን ብሶደስ ዳንዳእዘ ኤዛ። ዬዝን፥ አሳላ አፋ ፍርድዛይ ነ ኦደ?<verse eid="JAS 4:12"/></para>
  <para style="s1">ጬቅንትፐተ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13"/>ይን፥ «ኑ Ꮉይኖ ዎይ ዎንታ ሰኮ ካታማ ዎይ Ꮉንኮ ካታማ ቅቶዳ፤ እዘ ፈቲ በረ ጋምኦዳ፤ ዛልእ ትርፍሳዳ» ያጋእዙን፥ ስኦተ።<note caller="-" style="x"><char style="xo" closed="false">4:13-14 </char><char style="xt" closed="false"><ref loc="PRO 27:1">አዝዜ 27:1</ref></char></note> <verse eid="JAS 4:13"/><verse number="14" style="v" sid="JAS 4:14"/>ዎንታ አኮ Ꮉኖድ የዛኮ ይን ኤሮስ። ይን ደእታ ዋያድ የዛኮ ኤርዘ ኦደ? ይን ኤራ ዎደ በንቲ ብዘ ቃይቃዮ ፋና። <verse eid="JAS 4:14"/><verse number="15" style="v" sid="JAS 4:15"/>ይኖ አሺ፥ «ላ ጋይኮ ኑኒ የሳዳ፤ Ꮉኖ ዎይ ይኖ ኦቾዳ» ጋዉደስ ቤዛነ። <verse eid="JAS 4:15"/><verse number="16" style="v" sid="JAS 4:16"/>የዝን ይን Ꮉተ ኡቱራነን ጬቅንታነ። ይኒ ጋርዘ ጬቆ ኡባ ኢታ።<verse eid="JAS 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17"/>ይኒ ግሾ፥ ሎኦ ባዝ ኦቾደስ ኤሪተ ኦቾሰ አስ ይና ናጋራ።<verse eid="JAS 4:17"/></para>
  <chapter eid="JAS 4"/>
  <chapter number="5" style="c" sid="JAS 5"/>
  <para style="s1">ዱሩንስ እንግንትደ ዞረ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1"/>ይን፥ ዱሩን፥ ይንታላ አፋ ኢታ ማ የእዘ ግሾ ኡኮተን ዬኮተን። <verse eid="JAS 5:1"/><verse number="2" style="v" sid="JAS 5:2"/>ይን ቆልታ ቡቂዳ፤ ይን አፉልታን ብላራ ሙእንትዳ።<note caller="-" style="x"><char style="xo" closed="false">5:2-3 </char><char style="xt" closed="false"><ref loc="MAT 6:19">ማቶ. 6:19</ref></char></note> <verse eid="JAS 5:2"/><verse number="3" style="v" sid="JAS 5:3"/>ይን ዎርቅታን ይን ብርታ ብርዳ። ይና ብርዳና ይንታላ አፋ ማርካ ማቃዳ። ኤ ይን አሽቶ ታማ ጋር ምቾዳ። ይን Ꮉና Ꮉልእደ ቃምተ ይንትስ ቆሎ ሺሽዳ። <verse eid="JAS 5:3"/><verse number="4" style="v" sid="JAS 5:4"/>ይን ጋድተ ኦቺ ፌዥደ አሱን ክራ ብርቶ ጭግካያ። ይና ይንታላ አፋ ኡካነ። የን ካ ማጽዘ አሱን ኡክትታ ዎልቃራ የዘ ላ Ꮉይተ ስንትዳ።<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="DEU 24:14-15">ማሄ 24:14-15</ref></char></note> <verse eid="JAS 5:4"/><verse number="5" style="v" sid="JAS 5:5"/>Ꮉና ሳእተ ይን ሳዛ ጻላላስ ቆፒ፥ ጊግን የዝዳ። ሹፎስ ጊግንትደ Ꮉርስፋና ይንታና ክዳ። <verse eid="JAS 5:5"/><verse number="6" style="v" sid="JAS 5:6"/>ይንታራ ኤቅንቶደስ ዳንዳኦሰ ጽሎ አሳላ አፋ ፍርዳነ፤ ኤዛን ዎዳ።<verse eid="JAS 5:6"/></para>
  <para style="s1">ገንጨን ዎሳን</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7"/>ታ እሹን፥ ላ ዮኦደ ዎንስ ገንጮተ። ሳአ ኦችዘ ቶርቼ እራን ሴተ እራ ዮኦደ ዎንስ ገንጭ አልኦ ካ ናጊ ዋይዝ የል ኤክዛኮ ቆፖተ። <verse eid="JAS 5:7"/><verse number="8" style="v" sid="JAS 5:8"/>የ ሳአ ኦችዛይ ፋና ይንትን ገንጮተ። ላ የእታ ኡክደ ግሾ ኡፋይሳራ ናጎተ።<verse eid="JAS 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9"/>ታ እሹን፥ ጾዚ ይንታላ አፋ ፍርዳመ ጋር ፈታይ ፈተላ አፋ ዙዝንግፐተ። ፍርድዛይ ፉር ኤቅዳ። <verse eid="JAS 5:9"/><verse number="10" style="v" sid="JAS 5:10"/>ታ እሹን፥ ላ ሱንተ ኦህደ ናቡን ማ ዳንዳአራ ኤኪ አዝዘ ማቅዱንና ቦኦተ። <verse eid="JAS 5:10"/><verse number="11" style="v" sid="JAS 5:11"/>ዳንዳአራ ገንጭዱንና ኑኒ አንጅንትዱንና ጋነ። እዮባ ዋይዝ ገንጨዛኮ ይን ስእዳ። ላ ዉርሱተ ኤዛ ዋይዝ ማደዛኮን ብእዳ። ኤ ማሮትን ይቅስሞ ኩምደ ላ ማቅደ ግሾ ይኖ ኦችዳ።<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="JOB 1:21-22">ኢዮ. 1:21-22</ref>፤ <ref loc="JOB 2:10">2:10</ref>፤ <ref loc="PSA 103:8">ማዝ. 103:8</ref></char></note><verse eid="JAS 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12"/>የዝን ኡባፓ ቲኖ፥ ታ እሹን፥ ሳሎራን ማቅን ዎይ ሳአራን ማቅን ዎይ መለ አኮ ባዛራን ጫቂፐተ። ጾዘ ፍርዳ ይን ገላመ ፋና ይን ኦህታ ዬ ማቅኮ፥ «ዬ» ጋኦተ፤ አደ ማቅኮ፥ «አደ» ጋኦተ።<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="MAT 5:34-37">ማቶ. 5:34-37</ref></char></note><verse eid="JAS 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13"/>ይን ግዳ ማ ኤክዘ ኦደን የዝኮ ጾዝ ዎሶ። ኡፋይትዘ ኦደን የዝኮ ጋላታራ የጾ። <verse eid="JAS 5:13"/><verse number="14" style="v" sid="JAS 5:14"/>ይንታፓ Ꮉርግንትዘ ኦደን የዝኮ ዎሳ ኬ ጭሙንና ጼጎ። ኡን ላ ሱንተ ዛይተ ትዢ ኤስ ጾዝ ዎሶ።<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="MAT 5:34-37">ማቶ. 5:34-37</ref></char></note> <verse eid="JAS 5:14"/><verse number="15" style="v" sid="JAS 5:15"/>አማኖራ ዎስደ ዎስታ Ꮉርግንትዛ ፋዳ። ላ ኤዛ፥ Ꮉርግትፓ ደንዳ፤ ኤ ናጋራ ኦችደባዝ ማቅኮን ላ ኤዛ ማሮዳ። <verse eid="JAS 5:15"/><verse number="16" style="v" sid="JAS 5:16"/>ይኒ ግሾ፥ ይን ፋጾደ ጋር ይን ናጋርቶ ፈታይ ፈተስ ፋጾተን ፈተ ፈተስ ዎሶተ። ጽሎ አስ ዎስታ ዳማን ዎልቃማ ኦቻ ኦቻነ። <verse eid="JAS 5:16"/><verse number="17" style="v" sid="JAS 5:17"/>ኤልያሳ ኑ ፋና አስ። እራ ሳአላ ቡካመ ጋር ምን ጾዝ ዎስን Ꮉይ በረን እዝፑን አግና ሳአላ እራ ቡክካያ።<note caller="-" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 ካት 17:1</ref>፤ <ref loc="1KI 18:1">18:1</ref></char></note> <verse eid="JAS 5:17"/><verse number="18" style="v" sid="JAS 5:18"/>ማህ ኤ ጾዝ ዎስን ሳሎፓ እራ ቡክዳ፤ ሳእታን ካ እንግዳ።<note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="1KI 18:42-45">1 ካት 18:42-45</ref></char></note><verse eid="JAS 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19"/>ታ እሹን፥ ይንታፓ ኦደን ቱሪ ኦገፓ ባልንትኮ፥ መለ አስ ኤዛ ቱርጎ ማህኮ፥ <verse eid="JAS 5:19"/><verse number="20" style="v" sid="JAS 5:20"/>ናጋራንችዛ ኤ ኢታ ኦግትፓ ማህዘ ኦደን፥ ኤ ሸምፕቶ Ꮉይቆፓ አሽዛያን ኤ ጋማ ናጋርትስ ማሮት እንግዛኖ ኤሮ።<note caller="-" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="PRO 10:12">አዝዜ 10:12</ref>፤ <ref loc="1PE 4:8">1 ጴጥ. 4:8</ref></char></note><verse eid="JAS 5:20"/></para>
  <chapter eid="JAS 5"/>
</usx>
